<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EST" style="id" />
  <para style="toc1">एस्तेर नाओं री कताब</para>
  <para style="toc2">एस्तेर</para>
  <para style="toc3">एस्ते.</para>
  <para style="mt">एस्तेर</para>
  <para style="mt2">एस्तेर नाओं री कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">एस्तेरा नाओं रिया कताबा दे लिखिया दिया सारिया कटणा एक यहूदी जवाणस जेसारा नाओं एस्तेर था, रे चऊँ कनारे ई कुमोईया। आपणियां ईमती साथे ओर आपणियां इस्राएली जातिया रे प्रति प्यारो रिया बजा ते तेसे सेयो तिना रे दुश्मणा रे आथो ते पुरिया तरआ ते नाश ऊणे ते बचाए। ये कटणा फारसो रे राजे रे ठण्डी रे बखते तेसरे कअरे ऊई थी। ये कताब पूरीम नाओं रे यहूदी त्योआरो रे बारे दे ओर तेतेरे मतलबो खे समजयाओई।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">एस्तेरा रा पटराणी बणना <char style="ior"><ref loc="EST 1:1-2:23">1:1-2:23</ref></char></para>
  <para style="io1">हामानो री चलाकी <char style="ior"><ref loc="EST 3:1-5:14">3:1-5:14</ref></char></para>
  <para style="io1">हामानो खे मौता री सजा <char style="ior"><ref loc="EST 6:1-7:10">6:1-7:10</ref></char></para>
  <para style="io1">यहूदिया री आपणे दुश्मणा पाँदे जीत <char style="ior"><ref loc="EST 8:1-10:3">8:1-10:3</ref></char></para>
  <chapter number="1" style="c" sid="EST 1" />
  <para style="s">राजे रा बड़ी पाट्टी देणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 1:1" />क्षयर्ष नाओं रे राजे रे दिना दे यो गल्ला ऊईया, ये सेई क्षयर्ष ए, जो 127 राजा पाँदे, मतलब हिन्दूस्तानो ते लई की कूश देशो तक राज करो था। <verse eid="EST 1:1" /><verse number="2" style="v" sid="EST 1:2" />तिना दिना देई जेबे क्षयर्ष राजा आपणी तेसा राजगद्दिया पाँदे विराजमान था जो शूशन नाओं रे राजगढ़ो दे थी। <verse eid="EST 1:2" /><verse number="3" style="v" sid="EST 1:3" />तेती तिने आपणे राज्य रे तीजे साले आपणे सारे काम करने वाल़ेया खे ओर परदाना खे पाट्टी दित्ती। फारस ओर मादै रे सेनापति ओर राज्य-राज्य रे परदान ओर हाकिम तेसगे आए। <verse eid="EST 1:3" /><verse number="4" style="v" sid="EST 1:4" />से तिना खे बऊत दिना तक बल्कि 180 दिना तक आपणे राजमईलो रा वैभव ओर आपणे कीमती पदार्थ दखांदा रया।<verse eid="EST 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 1:5" />इतणे दिन बीतणे पाँदे राजे क्या छोटे, क्या बड़े तिना सबी खे बी जो शूशन नाओं रे राजगढ़ो दे कट्ठे ऊए थे, राजमईलो रे बगीचे दे खुली जगा दे साता दिना तक पाट्टी दित्ती। <verse eid="EST 1:5" /><verse number="6" style="v" sid="EST 1:6" />तेथो रे पड़दे सफेद ओर नीले सूतो रे थे ओर रेशम ओर बैंगणी रंगो री डोरिये की चाँदिए रे छल्लेया दे संगमरमरो रे खम्बेया दे लगी रे थे ओर तेथो री चौकिया सूईने-चाँदिए रिया थिया ओर लाल, सफेद, पिऊँल़े ओर काल़े संगमरमरो रे बणे दे मारबल मेल्ले दे बछाई राखे थे। <verse eid="EST 1:6" /><verse number="7" style="v" sid="EST 1:7" />राजे रे मईमाना खे सूईने रे ग्लासा दे शराब देई जाओई थी। यो ग्लास लग-लग प्रकारा रे ओ थे। राजा बऊत उदार सबाओ रा था ओर से तिना खे बऊत शराब पल़्याओ था। <verse eid="EST 1:7" /><verse number="8" style="v" sid="EST 1:8" />पीणा तो नियमो रे मुताबिक ओ था, केसी खे जबरदस्ती नि पल़्याया जाओ था, कऊँकि राजे तो आपणे मईलो रे सबी पण्डारिया खे आज्ञा देई राखी थी कि मईमाना री इच्छा ओ तेस साथे तेड़ा ई बर्ताओ करना। <verse eid="EST 1:8" /><verse number="9" style="v" sid="EST 1:9" />तेस ई बखते वशती राणिये बी राजा क्षयर्षो रे मईलो दे जवाणसा खे पाट्टी दित्ती।<verse eid="EST 1:9" /></para>
  <para style="s">वशती राणिया रा पटराणिया रे पदो ते टाणा</para>
  <para style="p">
    <verse number="10" style="v" sid="EST 1:10" />सातुए दिने जेबे राजे रा मन शराबो दे मगन था, तेबे तिने महूमान, बिजता, हर्बोना, बिगता, अबगता, जेतेर ओर कर्कस नाओं रे सातो खुसरेया खे जो क्षयर्ष राजे सामणे सेवा-टईल करेया करो थे, आज्ञा दित्ती, <verse eid="EST 1:10" /><verse number="11" style="v" sid="EST 1:11" />वशती राणिया खे राजमुकुट धारण करी की राजे रे सामणे ली आओ, जेते कि देशो-देशो रे लोका ओर परदाना रे सामणे तेसा री सुन्दरता सामणे आओ, कऊँकि से देखणे दे बऊत बांकी थी। <verse eid="EST 1:11" /><verse number="12" style="v" sid="EST 1:12" />जेबे वशती राणिया खे खुसरेया रे जरीये राजे री ये आज्ञा मिली तो तेसे आऊणे ते ना करी ती। ये सुणी की राजे खे बऊत गुस्सा आया।<verse eid="EST 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 1:13" />तेबे राजे बखतो रा पेत जाणने वाल़े पण्डता ते पूछेया (राजा तो निती ओर न्याय रे सबी ज्ञानिया साथे एड़ा ई करेया करो था। <verse eid="EST 1:13" /><verse number="14" style="v" sid="EST 1:14" />तेसगे कर्शना, शेतार, अदमाता, तर्शीश, मेरेस, मर्सना, ओर ममूकान नाओं रे फारस ओर मादै रे सात सेनापति थे, जो राजे रा दर्शण करी की खास-खास पदा पाँदे नियुक्त करी राखे थे।) <verse eid="EST 1:14" /><verse number="15" style="v" sid="EST 1:15" />राजे तिना लोका ते पूछेया, “वशती राणिये राजा क्षयर्षो री खुसरेया रे जरीये दित्ती री आज्ञा नि मानी, तो नियमो रे मुताबिक तेसा साथे क्या करना चाईयो?” <verse eid="EST 1:15" /><verse number="16" style="v" sid="EST 1:16" />तेबे ममूकाने राजा ओर परदाना री मौजुदगिया दे ज्वाब दित्तेया, “वशती राणिये जो गल़त काम करी राखेया, तेसे ना बस राजे साथे बल्कि सबी परदाना साथे ओर तिना सबी देशा रे लोका साथे बी जो राजा क्षयर्षो रे सबी राजा दे रओए। <verse eid="EST 1:16" /><verse number="17" style="v" sid="EST 1:17" />कऊँकि राणिया रे एस कामो री चर्चा सबी जवाणसा बीचे ऊणी ओर जेबे ये बोलेया जाणा कि राजा क्षयर्षे वशती राणिया खे आपू सामणे ल्याऊणे री आज्ञा दित्ती, पर से नि आई, तेबे तिना बी आपणे-आपणे लाड़े तुच्छ जाणने। <verse eid="EST 1:17" /><verse number="18" style="v" sid="EST 1:18" />तेबे आजके दिन फारसी ओर मादी परदाना रिया जवाणसा जिने राणिया री ये गल्ल सुणी राखी, तो तिना बी राजे रे सबी परदाना खे एड़ा ई बोलणा; इजी बजा ते बऊत ई नफरत ओर रोष पैदा ऊणा। <verse eid="EST 1:18" /><verse number="19" style="v" sid="EST 1:19" />अगर राजे खे अच्छा लगो, तो ये आज्ञा निकयाल़ो ओर फारसी ओर मादिया रे कानूनो दे लिखी बी जाओ, जेते खे कदी बदली नि सको कि वशती राणी क्षयर्ष राजे सामणे फेर कदी नि आओ ओर राजा पटराणिया रा पद केसी दूजिया खे देई देयो, जो तेसा ते ठीक ओ। <verse eid="EST 1:19" /><verse number="20" style="v" sid="EST 1:20" />तेबे जेबे राजे री ये आज्ञा तेसरे सारे राज्य दे सुणाई जाणी, तेबे तिना सबी जवाणसा छोटे, बड़े आपणे-आपणे लाड़ेया री इज्जत करेया करनी।” <verse eid="EST 1:20" /><verse number="21" style="v" sid="EST 1:21" />ये गल्ल राजा ओर परदाना खे पसन्द आई ओर राजे ममूकानो री सलाह् मानी ली ओर एते गल्ला पाँदे फैंसला लया। <verse eid="EST 1:21" /><verse number="22" style="v" sid="EST 1:22" />तेबे राजे हर राज्य रे अक्षरा रे ओर हर जातिया री पाषा रे पर्चिया पेजिया कि सब मर्द आपणे-आपणे कअरो ओर बच्चेया पाँदे पूरा अक्क चलाओ ओर आपणी जातिया री पाषा बोलेया करो।<verse eid="EST 1:22" /></para>
  <chapter eid="EST 1" />
  <chapter number="2" style="c" sid="EST 2" />
  <para style="s">एस्तेरा रा पटराणी बणाया जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 2:1" />कुछ बखतो ते बाद जेबे राजा क्षयर्षो रा गुस्सा ठंडा ऊआ, तेबे तिने वशती राणिया री ओर जो काम तेसे कित्तेया था ओर जो तेसा रे बारे दे आज्ञा निकल़ी थी तेतेरी बी सम्बाल़ लई। <verse eid="EST 2:1" /><verse number="2" style="v" sid="EST 2:2" />तेबे राजे रे आपणे सेवक तेसखे बोलणे लगे, “राजे खे बांकी ओर जवान कुआँरी बेटिया खे टोल़ो। <verse eid="EST 2:2" /><verse number="3" style="v" sid="EST 2:3" />ओर राजे आपणे राज्य रे सबी जगा दे लोक इजी खे नियुक्त कित्ते, ताकि सेयो सबी बांकी जवान कुआँरिया बेटिया खे शूशन गढ़ो रे रनवासो दे कट्ठा करो ओर जवाणसा रे रखवाल़े हेगे खे जो राजे रा खुसरा था, सम्बाल़ी देयो ओर तिना खे शुद्ध करने जोगिया चीजा दित्तिया जाओ। <verse eid="EST 2:3" /><verse number="4" style="v" sid="EST 2:4" />तेबे तिना बीचा ते जो कुआँरी राजे खे ठीक लगो, से वशती राणिया री जगा दे पटराणी बणाई जाओ। ये गल्ल राजे खे ठीक लगी ओर तिने एड़ा ई कित्तेया। <verse eid="EST 2:4" /><verse number="5" style="v" sid="EST 2:5" />तेस बखते शूशन शईरो रे गढ़ो दे मोर्दकै नाओं रा एक यहूदी रओ था, जो कीश नाओं रे एक बिन्यामीनिये रा पड़पोता, शिमीए रा पोता ओर याईरो रा पाऊ था। <verse eid="EST 2:5" /><verse number="6" style="v" sid="EST 2:6" />कुछ साल पईले से तिना गुलामा साथे यरूशलेम शईरो ते गुलामिया दे गया था, जिना खे बाबेलो रा राजा नबूकदनेस्सर, यहूदा रे राजा यकोन्याह साथे गुलाम करी की लईगा था। <verse eid="EST 2:6" /><verse number="7" style="v" sid="EST 2:7" />तिने आपणी हदास्सा नाओं री चचेरी बईण, जेसा खे एस्तेर बी बोलो थे पाल़ी थी, कऊँकि तेसा रे माये-बाओ नि थे ओर से बऊत बांकी ओर रूपवती थी ओर जेबे तेसा रे माये-बाओ मरी गे, तेबे मोर्दकैए से आपणी बेटी मानी की पाल़ी।”<verse eid="EST 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 2:8" />जेबे राजे री आज्ञा ओर नियम सुणाए ओर बऊत सारी कुआँरी जवान बेटिया, शूशन गढ़ो दे हेगे गे कट्ठिया कित्तिया, तेबे एस्तेर बी राजमईलो री जवाणसा रे रखवाल़े हेगे गे सम्बाल़ी। <verse eid="EST 2:8" /><verse number="9" style="v" sid="EST 2:9" />से बेटी हेगे खे प्यारी लगी ओर से तेसा ते खुश ऊआ, तेबे तिने बिना देरी कित्ते तेसा खे राजमईलो ते शुद्ध करने रिया चीजा ओर रोटी ओर तेसा खे चुणिया रिया सात सेलिया बी दित्तिया ओर तेसा खे ओर तेसा री सेलिया खे रनवासो दे सबी ते अच्छी रणे री जगा दित्ती। <verse eid="EST 2:9" /><verse number="10" style="v" sid="EST 2:10" />मोर्दकैए तेती जाणे ते पईले एस्तेरा खे समजयाई की बोली राखेया था कि तैं तिना खे ये नि बताणा की तूँ यहूदी ए। इजी बजा ते तेसे ना तो आपणी जाति बताई ओर ना ई आपणा कुल केसी गे बताया। <verse eid="EST 2:10" /><verse number="11" style="v" sid="EST 2:11" />मोर्दकै तो हर रोज रनवासो रे आँगणो सामणे कूमणे आया करो था, ताकि जाणो कि एस्तेर ठीक ए कि नि ओर तेसा साथे क्या ऊणे लगी रा?<verse eid="EST 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 2:12" />जेबे बी केसी बेटिया री बारी आओ थी कि से क्षयर्ष राजे गे रात कटणे खे जाओ तो तेसा खे से सब करना ओ ओर ठराए रे नियमो रे मुताबिक बारा मीन्ने तक त्यार ऊणा पड़ो था मतलब तिना रे शुद्ध करने रे दिन ईंयाँ बीते कि छे मीन्ने तक गन्धरसो रा तेल लगाया जाओ था ओर छे मीन्ने तक खुशबूदार इत्र ओर जवाणसा खे शुद्ध करने रा ओर सामान लगाया जाओ था। <verse eid="EST 2:12" /><verse number="13" style="v" sid="EST 2:13" />ईंयाँ जेबे सेयो बेटिया राजे गे जाओ थिया, तेबे जो कुछ सेयो चाओ थिया कि रनवासो ते राजमईलो दे लई जाओ, से तेसा खे देयो थे। <verse eid="EST 2:13" /><verse number="14" style="v" sid="EST 2:14" />साँजा खे तो सेयो जाओ थिया ओर प्यागा वापस ऊई की रनवासो रे दूजे कअरे जाई की रखैला रे रखवाल़े राजे रे खुसरे शाशगजो रे कब्जे दे ऊई जाओ थिया ओर राजे गे फेर नि जाओ थिया। ओर जे राजा तिना ते खुश ऊई जाओ था, तेबे से तेसा खे नाओं लई की बुलाओ था। <verse eid="EST 2:14" /><verse number="15" style="v" sid="EST 2:15" />जेबे मोर्दकै रे चाचा अबीहैलो री बेटी एस्तेर, जो मोर्दकै बेटी मानी की राखी थी, तेसा री बारी आई कि राजे गे जाओ, जेबे जो कुछ जवाणसा रे रखवाल़े राजे रे खुसरे हेगे तेसा रिया तँईं ठराया था, तिजी ते जादा तेसे ओर कुछ नि मांगेया ओर जितणेया एस्तेर देखी, सेयो सब तेसा ते खुश ऊए।<verse eid="EST 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 2:16" />ईंयाँ एस्तेर राजमईलो दे राजा क्षयर्षो गे तेसरे राज्य रे सातुए सालो रे तेबेत नाओं रे दसुए मीन्ने दे पऊँचाई। <verse eid="EST 2:16" /><verse number="17" style="v" sid="EST 2:17" />ओर राजे एस्तेरा खे सबी जवाणसा ते जादा प्यार कित्तेया ओर सबी कुआँरिया ते जादा तेसरे अनुग्रहो री दया-दृष्टि तेसा पाँदे ई ऊई, इजी बजा ते तिने तेसा रे सिरो पाँदे राजमुकुट राखेया ओर से वशती राणिया री जगा पाँदे राणी बणाई। <verse eid="EST 2:17" /><verse number="18" style="v" sid="EST 2:18" />तेबे राजे आपणे सारे परदाना ओर कर्मचारिया खे बड़ी पाट्टी कित्ती ओर तिजी खे एस्तेरा री पाट्टी बोलेया ओर राज्य दे छुट्टी<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="fq" closed="false">छुट्टी </char><char style="ft" closed="false">कर नि लया </char></note> दित्ती ओर आपणी उदारता बताणे रिया तँईं ईनाम बी बांडे।<verse eid="EST 2:18" /></para>
  <para style="s">मोर्दकैए रा राजे रे प्राण बचाणा</para>
  <para style="p">
    <verse number="19" style="v" sid="EST 2:19" />कुछ बखतो ते बाद जेबे कुआँरिया छोट्टिया दूजी बार कट्ठिया कित्तिया, तेबे मोर्दकै राजमईलो रे बड़े द्वारो गे काम करेया करो था। <verse eid="EST 2:19" /><verse number="20" style="v" sid="EST 2:20" />एस्तेरे आपणी जाति ओर कुलो रे बारे दे नि बताई राखेया था, कऊँकि मोर्दकै तेसा खे एड़ी आज्ञा देई राखी थी कि बताया नि ओर एस्तेर मोर्दकै री गल्ल एड़ी मानो थी, जेड़ी तेसगे आपणे पाल़ने रे बखते मानो थी।<verse eid="EST 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 2:21" />तिना दिना दे जेबे मोर्दकै राजे रे राजमईलो रे बड़े द्वारो गे काम करने लगी रा था, तेबे राजे रे खुसरे जो द्वारपाल बी थे, तिना बीचा ते बिगतान ओर तेरेश नाओं रे दूई जणेया राजा क्षयर्षो ते नराज ऊई की तेसखे नुकशाण पऊँचाणे री साजिश कित्ती। <verse eid="EST 2:21" /><verse number="22" style="v" sid="EST 2:22" />ये गल्ल मोर्दकै खे पता लगी गी ओर तिने एस्तेर राणिया खे ये गल्ल बताई ओर एस्तेरे मोर्दकै रा नाओं लई की राजे गे दशेया। <verse eid="EST 2:22" /><verse number="23" style="v" sid="EST 2:23" />तेबे खोजबीन करी की ये गल्ल सच निकल़ी ओर सेयो दोनो डाल़ो पाँदे लटकाईते ओर ये वृतांत राजे सामणे इतियासो री कताबा दे लिखेया।<verse eid="EST 2:23" /></para>
  <chapter eid="EST 2" />
  <chapter number="3" style="c" sid="EST 3" />
  <para style="s">हामानो री यहूदिया खे काणे री योजना</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 3:1" />कुछ साल बाद क्षयर्ष राजे अगागी हम्मदातो रे पाऊ हामानो खे सबी ते बड़े परदानो रा पद दित्तेया ओर तेसखे जादा इज्जत देई की तेसखे तेसरे साथी परदाना रे सिंहासना ते ऊच्चा सिंहासन ठराया। <verse eid="EST 3:1" /><verse number="2" style="v" sid="EST 3:2" />तेबे राजे रे सब कर्मचारी जो राजमईलो रे बड़े द्वारो दे रओ थे, सेयो हामानो सामणे चूकी की माथा टेकेया करो थे, कऊँकि राजे तेसरे बारे दे एड़ी ई आज्ञा देई राखी थी, पर मोर्दकै ना तो चुको था ओर ना तेसगे माथा टेको था। <verse eid="EST 3:2" /><verse number="3" style="v" sid="EST 3:3" />तेबे राजे रे कर्मचारी जो राजमईलो रे बड़े द्वारो गे रया करो थे, तिने मोर्दकै ते पूछेया, “तूँ राजे री आज्ञा खे कऊँ नि मानदा?” <verse eid="EST 3:3" /><verse number="4" style="v" sid="EST 3:4" />जेबे सेयो हर रोज तेसखे एड़ा ई बोलदे रये ओर तिने तिना री एक नि मानी, तेबे तिने ये देखणे री इच्छा ते कि मोर्दकै री ये गल्ल चलणी कि नई, हामानो गे बताईता; तिने तो तिना गे बताईता था कि आऊँ यहूदी ए। <verse eid="EST 3:4" /><verse number="5" style="v" sid="EST 3:5" />जेबे हामाने देखेया कि मोर्दकै नपदा नि ओर ना मांगे माथा टेकदा, तेबे हामान बऊत गुस्से ऊआ। <verse eid="EST 3:5" /><verse number="6" style="v" sid="EST 3:6" />तिने बस मोर्दकै पाँदे आथ चलाणा आपणी मर्यादा रे खलाफ समजेया। कऊँकि तिने हामानो खे ये बताईता था कि मोर्दकै केसा जातिया राए, तेबे हामाने क्षयर्ष राजे रे साम्राज दे रणे वाल़े सारे यहूदिया खे बी मोर्दकै री जाति जाणी की नाश करने री साजिश कित्ती। <verse eid="EST 3:6" /><verse number="7" style="v" sid="EST 3:7" />राजा क्षयर्षो रे बारूए सालो रे नीसान नाओं रे पईले मीन्ने दे, हामाने अदार नाओं रे बारूए मीन्ने तक रे एक-एक दिन ओर एक-एक मीन्ने खे चिट्ठी आपू सामणे पाई। <verse eid="EST 3:7" /><verse number="8" style="v" sid="EST 3:8" />तेबे हामाने राजा क्षयर्षो खे बोलेया, “तेरे राज्य रे सब जगा दे रणे वाल़े देशो-देशो रे लोका बीचे तित्तर-बित्तर ऊई की रणे वाल़ी एक जाति ए, जेसा रे नियम ओरी सबी लोका रे नियमो ते लग ए ओर सेयो राजे रे कानूनो पाँदे नि चलदे, इजी री खातर सेयो राखणे राजे खे फायदेमंद नि ए। <verse eid="EST 3:8" /><verse number="9" style="v" sid="EST 3:9" />जे राजे खे ठीक लगो तो तिना खे नाश करने री आज्ञा लिखी जाओ ओर आऊँ राजे रे पण्डारिया रे आथो रे राजपण्डारो दे पऊँचाणे खे, लगभग 340,000 किलो चाँदी देऊँगा।”<verse eid="EST 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 3:10" />तेबे राजे आपणी छाप आपणे आथो ते निकयाल़ी की अगागी हम्मदातो रे पाऊ हामानो खे, जो यहूदिया रा बैरी था देईती। <verse eid="EST 3:10" /><verse number="11" style="v" sid="EST 3:11" />ओर राजे हामानो खे बोलेया, “से चाँदी ताखे देईती री ओर सेयो लोक बी, ताकि तूँ तिना साथे जेड़ा तूँ चाए, तेड़ा ई बर्ताओ कर।” <verse eid="EST 3:11" /><verse number="12" style="v" sid="EST 3:12" />ईंयाँ तेस पईले मीन्ने रे तेरूए दिने राजे रे लेखक बुलाए ओर हामानो री आज्ञा रे मुताबिक राजे रे सब परदान, ओर सब राज्य रे परदान ओर देशो-देशो रे राज्यपाला खे पर्चिया, एक-एक राज्य रे अक्षरा दे ओर एक-एक देशो रे लोका री पाषा दे क्षयर्ष राजे रे नाओं ते लिखिया ओर तिना दे राजे री छापा री मोहर लगाई। <verse eid="EST 3:12" /><verse number="13" style="v" sid="EST 3:13" />तेबे राज्य रे सबी जगा दे ये लिखी की पर्चिया हर डाकिये रे जरीये पेजिया कि एक ई दिनो दे, मतलब अदार नाओं रे बारूए मीन्ने रे तेरूए दिने, क्या, जवान, क्या स्याणे, क्या जवाणस, क्या बाल़क, सारे यहूदी काई देयो ओर तिना री तअन-सम्पत्ति लूटी लणी। <verse eid="EST 3:13" /><verse number="14" style="v" sid="EST 3:14" />तेसा आज्ञा रे लेखो री नकल सबी जगा दे खुली दी पेजी ताकि सब देशो रे लोक तेस दिनो खे त्यार ऊई जाओ। <verse eid="EST 3:14" /><verse number="15" style="v" sid="EST 3:15" />ये आज्ञा शूशन गढ़ो दे दित्ती ओर डाकिये राजे री आज्ञा ते फटाफट निकल़ी गे। तेबे राजा ओर हामान शराब पीणे बैठीगे, पर शूशन शईरो दे डर फैलीगा।<verse eid="EST 3:15" /></para>
  <chapter eid="EST 3" />
  <chapter number="4" style="c" sid="EST 4" />
  <para style="s">मोर्दकैए रा एस्तेरा ते यहूदिया रिया तँईं मताद मांगणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 4:1" />जेबे मोर्दकैए खे तेते पर्चिया रे बारे दे पता लगी गा, तेबे मोर्दकैए टाल्ले फाड़ी की, टाट पईनी की, स्वा मल़ी की, शईरो बीचे गया ओर दु:खी ऊई की जोरे-जोरे की रोणे लगेया। <verse eid="EST 4:1" /><verse number="2" style="v" sid="EST 4:2" />तेबे से राजमईलो रे बड़े द्वारो गे पऊँचेया, पर टाट पईनी की राजमईलो रे बड़े द्वारो ते पीतरे जाणे री केसी खे आज्ञा नि थी। <verse eid="EST 4:2" /><verse number="3" style="v" sid="EST 4:3" />तेबे एक-एक राज्य दे, जेती-जेती राजे री आज्ञा ओर नियम पऊँचेया, तेती-तेती यहूदी बड़े दु:खी ऊई की बअरत करने लगे ओर रोणे पीटणे लगे, बल्कि बऊत जणे टाट पईनी की ओर स्वा मल़ी की पड़े दे रये।<verse eid="EST 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 4:4" />तेबे एस्तेर राणिया री सेलिये ओर खुसरेया जाई की तेसा गे बताईता, तेबे राणी दु:खी ऊई गी ओर मोर्दकैए गे टाल्ले पेजी की ये सन्देस पेजेया कि टाट उतारी की इना खे पईनी लो, पर तिने सेयो नि लये। <verse eid="EST 4:4" /><verse number="5" style="v" sid="EST 4:5" />जेबे एस्तेरे ये सब सुणेया तेबे तेसे राजे रे खुसरेया बीचा ते हताको खे जो राजे तेसा री देखपाल़ करने खे ठराया था, बुलाई की आज्ञा दित्ती कि मोर्दकैए गे जाई की पता लगा कि क्या गल्ल ए ओर इजी री बजा क्या ए। <verse eid="EST 4:5" /><verse number="6" style="v" sid="EST 4:6" />तेबे हताक शईरो रे तेस चौको रे, जो राजमईलो रे बड़े द्वारो रे सामणे था, मोर्दकैए गे गया। <verse eid="EST 4:6" /><verse number="7" style="v" sid="EST 4:7" />मोर्दकैए तेसगे सब कुछ बताईता कि मां पाँदे क्या-क्या बीतेया ओर हामाने यहूदिया खे नाश करने री आज्ञा पाणे खे राजपण्डारो दे बऊत चाँदी परने रा वादा करी राखेया, ये बी ठीक-ठीक बताईता। <verse eid="EST 4:7" /><verse number="8" style="v" sid="EST 4:8" />तेबे यहूदिया खे नाश करने री जो आज्ञा शूशनो दे दित्ती थी, तेतेरी एक नकल बी तिने हताको रे आथो दे, एस्तेरा खे दखाणे खे दित्ती ओर तेसा खे सारा आल बताणे ओर ये आज्ञा देणे खे बोलेया कि पीतरे राजे गे जाई की आपणे लोका रिया तँईं गिड़गिड़ाई की प्रार्थना कर। <verse eid="EST 4:8" /><verse number="9" style="v" sid="EST 4:9" />तेबे हताके एस्तेरा गे जाई की मोर्दकैए रिया गल्ला सुणाईयां। <verse eid="EST 4:9" /><verse number="10" style="v" sid="EST 4:10" />तेबे एस्तेरे हताको गे मोर्दकैए खे ये बोलणे री आज्ञा दित्ती, <verse eid="EST 4:10" /><verse number="11" style="v" sid="EST 4:11" />“राजे रे सारे कर्मचारिया, बल्कि राजे रे राज्य रे सारे लोका खे बी पता ए कि क्या जवाणस, क्या मर्द, कोई कऊँ ना ओ, जो आज्ञा ते बिना आँगणो दे राजे साथे मिलणे खे जाओगा, तेसखे काणे री आज्ञा ए; बस से जेसरी तरफा खे राजा सूईने रा राजदण्ड बढ़ाओ, सेई बचोआ। पर ती दिन ऊईगे दे आऊँ राजे गे नि बुलाई राखी।” <verse eid="EST 4:11" /><verse number="12" style="v" sid="EST 4:12" />एस्तेरा रिया यो गल्ला मोर्दकैए गे सुणाईयां। <verse eid="EST 4:12" /><verse number="13" style="v" sid="EST 4:13" />तेबे मोर्दकै एस्तेरा गे ये सन्देसा पेजेया, “तूँ मन ई मन ये नि सोच कि आऊँ ई राजमईलो रे रणे रिया बजा ते बाकी सबी यहूदिया बीचे बची री रणी। <verse eid="EST 4:13" /><verse number="14" style="v" sid="EST 4:14" />कऊँकि जो तूँ एस बखते चुपचाप रएगी, तो ओर केसी ना केसी उपाय ते यहूदिया रा छुटकारा ओर उद्धार ऊई जाणा, पर तूँ आपणे बाओ रे कराने समेत नाश ऊई जाणी। तेबे क्या पता ताखे एड़े कठण बखतो खे ई राजपद मिली रा ओ।” <verse eid="EST 4:14" /><verse number="15" style="v" sid="EST 4:15" />तेबे एस्तेरे मोर्दकैए गे ये सन्देस पेजेया, <verse eid="EST 4:15" /><verse number="16" style="v" sid="EST 4:16" />“तूँ जाई की शूशनो रे सारे यहूदिया खे कट्ठा कर ओर तुसे सब मेरिया तँईं बअरत करो, तीन दिन-रात कुछ नि खाओ-पियो ओर मां बी आपणी सेलिया साथे ईंयाँ बअरत करना। ओर एड़ी ई दशा दे मां नियमो रे खलाफ राजे गे पीतरे जाणा; तो अगर नाश ऊई गी तो ऊई गी।” <verse eid="EST 4:16" /><verse number="17" style="v" sid="EST 4:17" />तेबे मोर्दकै चली गा ओर एस्तेरा री आज्ञा रे मुताबिक ई तिने सब कुछ कित्तेया।<verse eid="EST 4:17" /></para>
  <chapter eid="EST 4" />
  <chapter number="5" style="c" sid="EST 5" />
  <para style="s">एस्तेरा रा पाट्टी त्यार करना</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 5:1" />इजी ते बाद तीजे दिने एस्तेर आपणे राजकीय टाल्ले पईनी की राजमईलो रे पीतरले आँगणो दे जाई की राजमईलो रे सामणे खड़ी ऊई गी। राजा तो राजमईलो दे राजगद्दिया पाँदे मईलो रे द्वारो सामणे बैठी रा था; <verse eid="EST 5:1" /><verse number="2" style="v" sid="EST 5:2" />ओर जेबे राजे एस्तेर राणी आँगणो दे खड़ी दी देखी, तेबे तेसा ते खुश ऊई की सूईने रा राजदण्ड जो तेसरे आथो दे था, तेसा रिया तरफा खे आगे कित्तेया। तेबे एस्तेरे नेड़े जाई की राजदण्डो रा मूरा छूँआ। <verse eid="EST 5:2" /><verse number="3" style="v" sid="EST 5:3" />तेबे राजे तेसा ते पूछेया, “ओ एस्तेर राणी, ताखे क्या चाईयो? ओर तू क्या माँगेई? माँग ओर ताखे आदा राज्य तक देया जाणा।”<verse eid="EST 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 5:4" />एस्तेरे बोलेया, “अगर राजे खे ठीक लगो, तो आज हामानो खे साथे लई की तेसा पाट्टिया रे आओ, जो मैं राजे खे त्यार करी राखी।” <verse eid="EST 5:4" /><verse number="5" style="v" sid="EST 5:5" />तेबे राजे आज्ञा दित्ती, “हामानो खे फटाफट ली आओ, ताकि एस्तेर जो चाओई तिजी खे पूरा करिए।” तेबे राजा ओर हामान एस्तेरा री बणाई दी पाट्टिया दे आए। <verse eid="EST 5:5" /><verse number="6" style="v" sid="EST 5:6" />खाणे रे बखते जेबे सेयो शराब पीणे लगी रे थे, तेबे राजे एस्तेरा खे बोलेया, “तेरी क्या प्रार्थना ए? से पूरी कित्ती जाणी। ओर तूँ क्या माँगेई? माँग ओर आदा राज्य तक ताखे देया जाणा।”<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">मर. 6:23</char></note> <verse eid="EST 5:6" /><verse number="7" style="v" sid="EST 5:7" />एस्तेरे ज्वाब दित्तेया, “मेरी प्रार्थना ओर जो आऊँ माँगुंई से ये ए, <verse eid="EST 5:7" /><verse number="8" style="v" sid="EST 5:8" />कि जे राजा मांते खुश ए ओर मेरी प्रार्थना सुणना ओर जो वरदान आऊँ मांगू सेई राजे खे देणा ठीक ओ, तेबे राजा ओर हामान काल तेसा पाट्टिया दे आओ, जो मां तिना खे करनी ओर काल मां राजे रे एस वचनो रे मुताबिक करना।”<verse eid="EST 5:8" /></para>
  <para style="s">हामानो रा मोर्दकैए खे काणे री योजना बनाणा</para>
  <para style="p">
    <verse number="9" style="v" sid="EST 5:9" />पाट्टिया ते बाद तेस ई दिने हामान मनो रे बऊत खुश ऊई की बारे गया। पर जेबे तिने मोर्दकै राजमईलो रे बड़े द्वारो रे देखेया कि से तेस सामणे ना तो खड़ा ऊआ ओर ना सामणे ते आटेया, तेबे से मोर्दकैए रे खलाफ गुस्से ते परी गा। <verse eid="EST 5:9" /><verse number="10" style="v" sid="EST 5:10" />तेबे बी हामान आपू खे रोकी की आपणे कअरे गया; ओर आपणे सारे दोस्त ओर आपणी जवाणस जेरेशा खे बुलावा पेजेया। <verse eid="EST 5:10" /><verse number="11" style="v" sid="EST 5:11" />तेबे हामाने तिना ते आपणे तअनो रा वैभव ओर आपणे बाल-बच्चेया री बढ़ोतरी ओर राजे से किंयाँ-किंयाँ बढ़ाया ओर सारे परदान ओर आपणे सारे कर्मचारिया बीचे ऊच्चा पद दित्तेया था, से सब कुछ बताया। <verse eid="EST 5:11" /><verse number="12" style="v" sid="EST 5:12" />हामाने ये बी बोलेया कि एस्तेर राणिये बी माखे छाडी की ओर केसी खे राजे साथे आपणी कित्ती री पाट्टिया रे आऊणे नि दित्तेया ओर काल बी तेसे राजे साथे आऊँ ई बुलाई राखेया। <verse eid="EST 5:12" /><verse number="13" style="v" sid="EST 5:13" />पर तेबे बी जेबे-जेबे माखे से यहूदी मोर्दकै राजमईलो रे बड़े द्वारो रे बैठेया रा दिशोआ, तेबे-तेबे ये सब कुछ माखे बेकार लगोआ। <verse eid="EST 5:13" /><verse number="14" style="v" sid="EST 5:14" />तेसरी लाड़ी जेरेशे ओर तेसरे सारे दोस्ते तेसखे बोलेया, “पंजा आथ ऊच्चा एक फाँसिया रा खम्बा बनाणा ओर प्यागा राजे खे बोलणा कि तेते पाँदे मोर्दकै लटकाया जाओ; तेबे राजे साथे मजे रे पाट्टिया खे जाया।” एते गल्ला ते खुश ऊई की हामाने तेड़ा ई फाँसिया रा एक खम्बा बणवाया।<verse eid="EST 5:14" /></para>
  <chapter eid="EST 5" />
  <chapter number="6" style="c" sid="EST 6" />
  <para style="s">राजे रे जरिये मोर्दकैए री प्रतिष्ठा</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 6:1" />तेसा राती राजे खे नींज नि आई, इजी री खातर तेसरिया आज्ञा ते इतियासो री कताब ल्याई ओर पढ़ी की राजे गे सुणाई। <verse eid="EST 6:1" /><verse number="2" style="v" sid="EST 6:2" />तिदे ये लिखेया रा मिलेया कि जेबे राजा क्षयर्षो रे परदान जो द्वारपाल बी थे, तिना बीचा ते बिगताना ओर तेरेश नाओं रे दो जणेया तेस पाँदे अमला करने री साजिश कित्ती थी, ये गल्ल मोर्दकैए सामणे ल्याई थी। <verse eid="EST 6:2" /><verse number="3" style="v" sid="EST 6:3" />तेबे राजे पूछेया, “इजी रे बदले मोर्दकैए री क्या प्रतिष्ठा ओर तारीफ कित्ती?” राजे रे जो सेवक तेसरी सेवा करो थे, तिने तेसखे ज्वाब दित्तेया, “तेसखे कुछ पनि कित्तेया।”<verse eid="EST 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 6:4" />तेबे राजे पूछेया, “आँगणो दे बारे कुण ए?” तेस बखते तो हामान राजे रे मईलो रे आँगणो दे एड़ी इच्छा ते आया था कि जो खम्बा तिने मोर्दकैए खे त्यार कराई राखेया था, तेते पाँदे तेसखे लटकाणे री चर्चा राजे साथे करो। <verse eid="EST 6:4" /><verse number="5" style="v" sid="EST 6:5" />तेबे राजे रे सेवके तेसखे बोलेया, “आँगणो दे तो हामान खड़ी रा।” राजे बोलेया, “तेसखे पीतरे बुलाई की ली आओ।” <verse eid="EST 6:5" /><verse number="6" style="v" sid="EST 6:6" />जेबे हामान पीतरे आया तेबे राजे तेसते पूछेया, “जेस माणूंए री प्रतिष्ठा राजा करना चाओ, तो तेसखे क्या करना ठीक ए?” हामाने ये सोची की कि मांते जादा राजा केसरी प्रतिष्ठा करना चाओगा? <verse eid="EST 6:6" /><verse number="7" style="v" sid="EST 6:7" />तिने राजे खे ज्वाब दित्तेया, “जेस माणूंए री प्रतिष्ठा राजा करना चाओ, <verse eid="EST 6:7" /><verse number="8" style="v" sid="EST 6:8" />तेसखे राजकीय टाल्ले ल्याये जाओ, जो राजा पईनोआ ओर एक कोड़ा बी, जेस पाँदे राजा बैठोआ ओर तेसरे सिरो पाँदे जो राजमुकुट राखेया जाओआ, से बी ल्याया जाओ। <verse eid="EST 6:8" /><verse number="9" style="v" sid="EST 6:9" />तेबे सेयो टाल्ले ओर से कोड़ा राजे रे केसी बड़े परदानो गे सम्बाल़ेया जाओ ओर जेसरी प्रतिष्ठा राजा करना चाओ, तेसखे से टाल्ले पन्याओ ओर तेस माणूंए खे कोड़े पाँदे सवार करी की, शईरो रे चौको दे तेसखे कूमाया जाओ ओर तेसते आगे-आगे ये प्रचार कराया जाओ कि जेसरी प्रतिष्ठा राजा करना चाओआ तेस साथे एड़ा ई करेया जाणा।”<verse eid="EST 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 6:10" />राजे हामानो खे बोलेया, “फटाफट करी की आपणे बोलो रे मुताबिक तिना टाल्लेया खे ओर तेस कोड़े खे लई की, तेस यहूदी मोर्दकैए साथे जो राजमईलो रे बड़े द्वारो दे बैठेया करोआ, तेड़ा ई कर, जेड़ा तैं बोलेया, तिदे कोई बी कमी नि ऊणी चाईयो।” <verse eid="EST 6:10" /><verse number="11" style="v" sid="EST 6:11" />तेबे हामाने सेयो टाल्ले ओर तेस कोड़े खे लई की मोर्दकैए खे पन्याए ओर से कोड़े पाँदे चढ़ाई की, शईरो रे चौको दे ईंयाँ आका पाँदा ऊआ कूमाया, “जेसरी प्रतिष्ठा राजा करना चाओआ, तेस साथे एड़ा ई करेया जाणा।” <verse eid="EST 6:11" /><verse number="12" style="v" sid="EST 6:12" />तेबे मोर्दकै तो राजमईलो रे बड़े द्वारो गे वापस ऊईगा, पर हामान दु:ख करदा ऊआ ओर आपणा मूँ लकोई की फटाफट आपणे कअरो खे चली गा।<verse eid="EST 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 6:13" />तेबे हामाने आपणी लाड़ी जेरेश ओर आपणे सबी दोस्ता गे सब कुछ जो तेस पाँदे बीतेया था दशेया। तेबे तेसरे अक्लमंद दोस्ते ओर तेसरी लाड़िए तेसखे बोलेया, “मोर्दकै जेसखे तूँ अराणा चाए था, जे से यहूदिया रे कुलो राए, तो तूँ तेसखे कदी नि अराई सकदा तेसते पूरी तरअ ते अरी जाणा।” <verse eid="EST 6:13" /><verse number="14" style="v" sid="EST 6:14" />सेयो तेस साथे गल्ला करने ई लगी रे थे कि राजे रे खुसरे आई की हामानो खे एस्तेरा री कित्ती री पाट्टिया दे फटाफट बुलाई की लईगे।<verse eid="EST 6:14" /></para>
  <chapter eid="EST 6" />
  <chapter number="7" style="c" sid="EST 7" />
  <para style="s">एस्तेरा रा हामानो री योजना सामणे ल्याऊणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 7:1" />तेबे राजा ओर हामान एस्तेर राणिया री पाट्टिया रे आए। <verse eid="EST 7:1" /><verse number="2" style="v" sid="EST 7:2" />ओर राजे दूजे दिने शराब पींदे-पींदे एस्तेरा ते फेर पूछेया, “ओ एस्तेर राणी! तेरी क्या प्रार्थना ए से पूरी करी जाओ ओर तूँ क्या माँगणा चाएयी? माँग ओर आदे राज्य तक ताखे देया जाणा।”<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">मर. 6:23</char></note> <verse eid="EST 7:2" /><verse number="3" style="v" sid="EST 7:3" />एस्तेर राणिये ज्वाब दित्तेया, “ओ राजा! जे तूँ मांते खुश ए ओर राजे खे ये ठीक लगो, तो मेरी‍ प्रार्थना ते माखे ओर मेरे माँगणे ते मेरे लोका खे प्राणो रा दान मिलो। <verse eid="EST 7:3" /><verse number="4" style="v" sid="EST 7:4" />कऊँकि आऊँ ओर मेरी जातिया रे लोक बेचीते रे ओर आसे काये जाणे वाल़े ए बल्कि सब नाश ऊणे वाल़े ए, जे आसा खे बस दास-दासिया ऊणे खे बेचदे, तो आऊँ चुप रंदी, ओर आऊँ इतणी छोटी जी गल्ला रिया बजा ते राजे खे दु:ख नि देंदी।”<verse eid="EST 7:4" /></para>
  <para style="s">हामानो खे मोर्दकैए रिया जगा पाँदे लटकाणा</para>
  <para style="p">
    <verse number="5" style="v" sid="EST 7:5" />तेबे राजा क्षयर्षे एस्तेर राणिया ते पूछेया, “से कुण ए? ओर केई ए जिने एड़ा करने री इच्छा करी राखी?” <verse eid="EST 7:5" /><verse number="6" style="v" sid="EST 7:6" />एस्तेरे ज्वाब दित्तेया, “से बिरोदी ओर दुश्मण येई दुष्ट हामान ए।” तेबे हामान राजा-राणिया सामणे डरीगा। <verse eid="EST 7:6" /><verse number="7" style="v" sid="EST 7:7" />राजा गुस्से दे आई की शराब छाडी की, राजमईलो रे बगीचे दे निकल़ी गा ओर हामाने ये सोची की कि राजे मेरा नुकशाण सोची राखेया ऊणा, एस्तेर राणिया ते प्राणो रा दान माँगणे खे खड़ा ऊआ। <verse eid="EST 7:7" /><verse number="8" style="v" sid="EST 7:8" />जेबे राजा राजमईलो रे बगीचे ते शराब पीणे री जगा दे वापस आया तेबे क्या देखेया कि हामान तेसा चौकिया पाँदे ई जेते पाँदे एस्तेर बैठी री नपणे लगी रा ओर राजे बोलेया, “क्या ये कअरे ई मां सामणे राणिया साथे जबरदस्ती करना चाओआ?” राजे रे मुंए ते ये गल्ल निकल़ी थी कि सेवके हामानो रा मूँ टखी ता। <verse eid="EST 7:8" /><verse number="9" style="v" sid="EST 7:9" />तेबे राजे सामणे आजीर रणे वाल़े खुसरेया बीचा ते हर्बोना नाओं रे एकी जणे राजे खे बोलेया, “हामानो रे एती पंजा आथ ऊच्चा फाँसिया रा एक खम्बा खड़ा ए, जो तिने मोर्दकैए खे बणाया था, जिने राजे रे कल्याणो री गल्ल बोली थी।” राजे बोलेया, “एसखे इजी पाँदे ई लटकाई देयो।” <verse eid="EST 7:9" /><verse number="10" style="v" sid="EST 7:10" />तेबे हामान तेस खम्बे पाँदे ई जो तिने मोर्दकैए खे बणाया था, लटकाई ता। तेबे राजे रा रोष ठण्डा ऊईगा।<verse eid="EST 7:10" /></para>
  <chapter eid="EST 7" />
  <chapter number="8" style="c" sid="EST 8" />
  <para style="s">एस्तेरा रे जरिये यहूदिया रा बचणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 8:1" />बादो ते तेसी दिने क्षयर्ष राजे यहूदिया रे बिरोदी हामानो रा कअर बार एस्तेर राणिया खे देईता। तेबे मोर्दकै राजे रे सामणे आया, कऊँकि एस्तेरे राजे गे बताईता था कि तेस साथे तेसा रा क्या रिश्ता था। <verse eid="EST 8:1" /><verse number="2" style="v" sid="EST 8:2" />तेबे राजे आपणी से छाप जो तिने हामानो ते लई ली थी, खोली की, मोर्दकैए खे देईती ओर एस्तेरे मोर्दकैए खे हामानो रे कअरो पाँदे अधिकारी नियुक्त करी ता। <verse eid="EST 8:2" /><verse number="3" style="v" sid="EST 8:3" />तेबे एस्तेरे दूजी बार राजे खे बोलेया ओर तेसरे पैरा पाँदे पड़ी की, आसू सेटी-सेटी की तेसते गिड़गिड़ाई की प्रार्थना कित्ती कि अगागी हामानो री बुराई ओर यहूदिया रे नुकशाणो री तेसरी साजिश निष्फल करी दे। <verse eid="EST 8:3" /><verse number="4" style="v" sid="EST 8:4" />तेबे राजे एस्तेरा रिया तरफा खे सूईने रा राजदण्ड बढ़ाया।<verse eid="EST 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 8:5" />तेबे एस्तेर उठी की राजे रे सामणे खड़ी ऊई ओर बोलणे लगी, “जे राजे खे ठीक लगो ओर से मांते खुश ए ओर ए गल्ल तेसखे ठीक लगो ओर आऊँ बी तेसखे अच्छी लगूँई, तो जो पर्चिया हम्मदाता अगागीए रे पाऊ हामाने राजे रे सबी राजा दे यहूदिया खे नाश करने री साजिश करी की लिखाईया थिया, तिना बदलणे खे लिखेया जाओ। <verse eid="EST 8:5" /><verse number="6" style="v" sid="EST 8:6" />कऊँकि आऊँ आपणी जातिया पाँदे पड़ने वाल़ी तेसा मुसीबता खे किंयाँ देखी सकूँई? ओर आऊँ आपणे टब्बरो रा नाश किंयाँ देखी सकूँई?” <verse eid="EST 8:6" /><verse number="7" style="v" sid="EST 8:7" />तेबे क्षयर्ष राजे एस्तेर राणी ओर मोर्दकै यहूदिये खे बोलेया, “आऊँ हामानो रा कअर बार तो एस्तेरा खे देई चुकेया रा ओर से फाँसिया रे खम्बे पाँदे लटकाई ता रा, इजी खे कऊँकि तिने यहूदिया रा बुरा करने री सोची राखी थी। <verse eid="EST 8:7" /><verse number="8" style="v" sid="EST 8:8" />तो तुसे आपणी समजा रे मुताबिक राजे रे नाओं ते यहूदिया रे नाओं पाँदे लिखो ओर राजे री छापा री मोहर बी लगाओ; कऊँकि जो चिट्ठी राजे रे नाओं ते लिखी जाओई ओर तेते पाँदे राजे री छाप लगाई जाओई, तिजी खे कोई बी पल्टी नि सकदा।” <verse eid="EST 8:8" /><verse number="9" style="v" sid="EST 8:9" />तेस ई बखते मतलब सीवान नाओं रे तीजे मीन्ने रे तेईए दिने राजे रे लेखक बुलाए ओर जेसा-जेसा गल्ला री आज्ञा मोर्दकैए तिना खे दित्ती थी से यहूदिये ओर राज्यपाले हिन्दूस्तानो ते लई की कूशो तक, जो 127 राज्य थे, तिना सबी रे परदान ओर परदाना खे एक-एक राज्य रे अक्षरो दे ओर एक-एक देशो रे लोका री पाषा दे ओर यहूदिया खे तिना रे अक्षरा दे ओर पाषा दे लिखिया।<verse eid="EST 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 8:10" />तेबे मोर्दकैए क्षयर्ष राजे रे नाओं ते पर्चिया लिखाई की ओर तिना पाँदे राजे री छापा री मोहर लगाई की, तेज चलणे वाल़े सरकारी कोड़े, खच्चर ओर साँड़णिया पाँदे सवार ऊई की डाक डाकिये रे आथो रे पेजी ती। <verse eid="EST 8:10" /><verse number="11" style="v" sid="EST 8:11" />इना पर्चिया दे सारे शईरा रे यहूदिया खे राजे री तरफा ते ये आज्ञा दित्ती कि सेयो कट्ठे ओ ओर आपणा-आपणा प्राण बचाणे खे त्यार ऊई की, जेसा जातिया रे या राज्य रे लोक अन्याय करी की तिना खे या तिना री जवाणसा खे ओर बाल़का खे दु:ख देणा चाओगे, तिना खे नाश करो ओर तिना री तअन-सम्पत्ति लूटी लो। <verse eid="EST 8:11" /><verse number="12" style="v" sid="EST 8:12" />ओर ये क्षयर्ष राजे रे राजा दे एक ई दिने कित्तेया जाओ, मतलब अदार नाओं रे बारूए मीन्ने रे तेरूए दिने।<verse eid="EST 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 8:13" />एसा आज्ञा रे लेखो री नकला, सारे राज्यो रे सबी देशो रे लोका गे खुली रिया पेजिया; ताकि यहूदी तेस दिने आपणे दुश्मणा ते बदला लणे खे त्यार रओ। <verse eid="EST 8:13" /><verse number="14" style="v" sid="EST 8:14" />तेस ई बखते डाकिये तेज चलणे वाल़े सरकारी कोड़ेया पाँदे सवार ऊई की, राजे री आज्ञा ते फुर्ती करी की फटाफट चली गे ओर ये आज्ञा शूशन राजगढ़ो दे दित्ती थी।<verse eid="EST 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 8:15" />तेबे मोर्दकै नीले ओर सफेद रंगो रे मईलो रे टाल्ले पईनी की ओर सिरो पाँदे सूईने रा बड़ा मुकुट राखी की ओर छोटे रेशम ओर बैंगणी रंगो रा चोगा पईनी की, राजे रे सामणे ते निकल़ेया ओर शूशन शईरो रे लोक खुशिया रे मारे गर्व करने लगे। <verse eid="EST 8:15" /><verse number="16" style="v" sid="EST 8:16" />ओर यहूदिया खे आनंद ओर खुशी ऊई ओर तिना री बड़ी प्रतिष्ठा ऊई। <verse eid="EST 8:16" /><verse number="17" style="v" sid="EST 8:17" />ओर जेस-जेस राज्य दे ओर जेस-जेस शईरो दे, जेती केथी राजे री आज्ञा ओर नियम पऊँचे, तेती-तेती यहूदिया खे बड़ी पारी खुशी ऊई ओर तिने पाट्टी करी की से दिन खुशिया रा दिन मानेया। ओर तेस देशो रे लोका बीचा ते बऊत लोक यहूदी बणी गे, कऊँकि तिना रे मनो दे यहूदिया रा डर समाई गा था।<verse eid="EST 8:17" /></para>
  <chapter eid="EST 8" />
  <chapter number="9" style="c" sid="EST 9" />
  <para style="s">यहूदिया रा आपणे दुश्मणा खे नाश करना</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 9:1" />अदान नाओं रे बारूए मीन्ने रे तेरूए दिने, जेस दिने राजे री आज्ञा ओर नियम पूरे ऊणे वाल़े थे ओर यहूदिया रे दुश्मण तिना पाँदे प्रबल ऊणे री उम्मीद राखो थे, पर इजी रे उल्टे यहूदी आपणे बैरिया पाँदे प्रबल ऊए; तेस दिने, <verse eid="EST 9:1" /><verse number="2" style="v" sid="EST 9:2" />यहूदी लोक राजा क्षयर्षो रे सबी राज्य दे आपणे-आपणे शईरो दे कट्ठे ऊए, ताकि जो तिना रा नुकशाण करने री कोशिश करो, ओर तिना पाँदे अमला करो। पर कोई तिना रा सामणा नि करी सकेया, कऊँकि तिना रा डर देशो-देशो रे सबी लोका रे मनो रे समाई गा था। <verse eid="EST 9:2" /><verse number="3" style="v" sid="EST 9:3" />बल्कि राज्य रे सारे हाकिम, ओर राज्यपाल, ओर राजे रे कर्मचारिये यहूदिया री मताद कित्ती, कऊँकि तिना रे मनो रे मोर्दकैए रा डर समाई गा था। <verse eid="EST 9:3" /><verse number="4" style="v" sid="EST 9:4" />मोर्दकै तो राजे गे बऊत इज्जतदार था ओर तेसरी कीर्ति सबी जगा दे फैली गी; ओर मोर्दकैए तागतबर ऊँदा चली गा। <verse eid="EST 9:4" /><verse number="5" style="v" sid="EST 9:5" />तेबे यहूदिये आपणे सारे दुश्मण तलवारी साथे काई की ओर कायल करी की नाश करीते ओर आपणे बैरिया साथे आपणी इच्छा रे मुताबिक बर्ताव कित्तेया।<verse eid="EST 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 9:6" />शूशन शईरो रे गढ़ो दे यहूदिये 500 माणूं काई की नाश करीते। <verse eid="EST 9:6" /><verse number="7" style="v" sid="EST 9:7" />तिने यहूदिया रे दुश्मण हामान हम्मदातो रे दसो पाऊ काईते जिना रे नाओं ये ए: पर्शन्दाता, दल्पोन, अस्पाता, <verse eid="EST 9:7" /><verse number="8" style="v" sid="EST 9:8" />पोराता, अदल्या, अरीदाता, <verse eid="EST 9:8" /><verse number="9" style="v" sid="EST 9:9" />पर्मशता, अरीसै, अरीदै ओर वैजाता, <verse eid="EST 9:9" /><verse number="10" style="v" sid="EST 9:10" />तिने हामान हम्मदातो रे दसो पाऊ जो यहूदिया रे दुश्मण थे काईते; पर तिने हामानो रा तअन नि लूटेया। <verse eid="EST 9:10" /><verse number="11" style="v" sid="EST 9:11" />तेस दिने शूशन शईरो रे गढ़ो दे काये दे माणूंआ री गिणती राजे गे सुणाई। <verse eid="EST 9:11" /><verse number="12" style="v" sid="EST 9:12" />तेबे राजे एस्तेर राणिया खे बोलेया, “यहूदिये शूशन राजगढ़ो देई 500 माणूं ओर हामानो रे दस पाऊ बी काई की नाश करीते; तेबे राज्य दे ओरी-ओरी जगा दे तिने क्या पता क्या-क्या कित्तेया ऊणा! एबे इजी ते जादा तेरी क्या प्रार्थना ए? से बी पूरी करेया जाणी ओर तूँ क्या माँगेई? से बी ताखे दित्तेया जाणा।” <verse eid="EST 9:12" /><verse number="13" style="v" sid="EST 9:13" />एस्तेरे बोलेया, “जे राजे खे ठीक लगो तो शूशनो रे यहूदिया खे आज की जेड़ी काल बी आज्ञा दित्ती जाओ ओर हामानो रे दसो पाऊ फाँसिया रे खम्बेया पाँदे लटकाए जाओ।” <verse eid="EST 9:13" /><verse number="14" style="v" sid="EST 9:14" />राजे आपणे परदाना खे बोलेया, “एड़ा ई करेया जाओ;” तेबे ये आज्ञा शूशनो दे दित्ती ओर हामानो रे दसो पाऊ लटकाईते। <verse eid="EST 9:14" /><verse number="15" style="v" sid="EST 9:15" />दूजे दिने तेबे शूशन शईरो दे यहूदिये अदार मीन्ने रे चौदुए दिने बी कट्ठे ऊई की शूशनो दे 300 माणूं काये, पर तअन नि लूटेया। <verse eid="EST 9:15" /><verse number="16" style="v" sid="EST 9:16" />राज्य री ओरी जगा दे यहूदी कट्ठे ऊई की आपणा-आपणा प्राण बचाणे खे खड़े ऊए ओर आपणे दुश्मणा बीचा ते 75,000 माणूं काई की आपणे दुश्मणा ते राम पाया; पर तिना रा तअन नि लूटेया। <verse eid="EST 9:16" /><verse number="17" style="v" sid="EST 9:17" />ये अदार मीन्ने रे तेरूए दिने कित्तेया ओर चौदुए दिने तिने राम करी की पाट्टी कित्ती ओर खुशिया रा दिन ठराया।<verse eid="EST 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EST 9:18" />पर शूशनो रे यहूदी अदार मीन्ने रे तेरूए दिने ओर तेस मीन्ने रेई चौदुए दिने कट्ठे ऊए ओर आपणे दुश्मण काये ओर तेस मीन्ने रेई पन्द्रुए दिने तिने राम करी की पाट्टिया रा ओर खुशिया रा दिन ठराया। <verse eid="EST 9:18" /><verse number="19" style="v" sid="EST 9:19" />इजी बजा ते गाँवो रे यहूदी जो बिना दवाला री बस्तिया दे रओ थे, सेयो अदार मीन्ने रे चौदुए दिने खुशी ओर पाट्टी ओर आपू बीचे खाणे पीणे रिया चीजा पेजणे रा दिन नियुक्त करी की मनांदे रये।<verse eid="EST 9:19" /></para>
  <para style="s">यहूदिया रा पूरीम त्यार मनाणा</para>
  <para style="p">
    <verse number="20" style="v" sid="EST 9:20" />इना गल्ला रे बारे दे लिखी की, मोर्दकै राजा क्षयर्षो रे सबी राज्य दे, क्या नेड़े, क्या दूर रणे वाल़े सारे यहूदिया खे पर्चिया पेजिया, <verse eid="EST 9:20" /><verse number="21" style="v" sid="EST 9:21" />ओर ये आज्ञा दित्ती कि अदार मीन्ने रा चौदुआ ओर पन्द्रुआ दिन हर साल मनाया करो। <verse eid="EST 9:21" /><verse number="22" style="v" sid="EST 9:22" />जिना बीचे यहूदिया खे आपणे दुश्मणा ते राम मिलेया ओर ये मीन्ना जिदे शोग आनंदो दे ओर दु:ख खुशिया दे बदली गा; मानेया करो ओर तिना खे पाट्टी ओर खुशी ओर एकी-दूजे गे खाणे पीणे रिया चीजा पेजणे ओर कंगाल़ा खे दान देणे रे दिन मानो। <verse eid="EST 9:22" /><verse number="23" style="v" sid="EST 9:23" />तेबे यहूदिये जेड़ा शुरू कित्तेया था ओर जेड़ा मोर्दकै तिना खे लिखेया, हर साल तेड़ा ई करने रा निश्चा करी ला। <verse eid="EST 9:23" /><verse number="24" style="v" sid="EST 9:24" />कऊँकि हम्मदाता अगागीए रा पाऊ हामान जो सबी यहूदिया रा बिरोदी था, तिने यहूदिया खे नाश करने री साजिश कित्ती ओर तिना खे मिटाणे ओर नाश करने री पर्चिया पाईया थिया। <verse eid="EST 9:24" /><verse number="25" style="v" sid="EST 9:25" />पर जेबे राजे खे ये पता लगी गा, तेबे तिने आज्ञा दित्ती ओर चिट्ठिया दे लिखवाया कि जो दुष्ट साजिश हामाने यहूदिया रे खलाफ कित्ती थी, से तेसरे ई सिरो पाँदे वापस आओ, तेबे से ओर तेसरे पाऊ फाँसिया रे खम्बेया पाँदे लटकाए। <verse eid="EST 9:25" /><verse number="26" style="v" sid="EST 9:26" />इजी बजा ते तिना दिना रा नाओं पूर शब्दो ते पूरीम राखेया, एसा पर्चिया रिया सबी गल्ला रिया बजा ते ओर जो कुछ तिने इजी रे बारे दे देखेया ओर जो कुछ तिना पाँदे बीतेया था, तिजी री बजा ते बी, <verse eid="EST 9:26" /><verse number="27" style="v" sid="EST 9:27" />यहूदिये आपू-आपू खे ओर आपणी-आपणी ल्वादा खे ओर तिना सबी खे बी जो तिना साथे मिली गे थे ये अटल़ आज्ञा कित्ती कि तेस लेखो रे मुताबिक हर साल तेसरे ठराए रे बखतो दे सेयो इना दो दिना खे मानो।<verse eid="EST 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EST 9:28" />तेबे हर पीढ़ी, हर कुल, हर राज्य, हर शईरो दे ये दिन याद करने ओर माने जाणे ओर पूरीम नाओं रे दिन यहूदिया दे कदी नि मिटणे ओर तिना री याद तिना रे कुलो ते नि जाणी। <verse eid="EST 9:28" /><verse number="29" style="v" sid="EST 9:29" />तेबे अबीहैलो री बेटी एस्तेर राणी ओर मोर्दकै यहूदिये, पूरीमो रे बारे दे दूजी पर्ची बड़े अक्को साथे लिखी। <verse eid="EST 9:29" /><verse number="30" style="v" sid="EST 9:30" />इजी चिट्ठिया री नकला मोर्दकै क्षयर्ष राजे रे, 127 राज्य रे सबी यहूदिया गे शान्ति देणे वाल़े ओर सच्ची गल्ला साथे ये लिखी की पेजिया, <verse eid="EST 9:30" /><verse number="31" style="v" sid="EST 9:31" />कि पूरीमो रे तिना दिना रे खास ठराए रे बखतो दे मोर्दकै यहूदी ओर एस्तेर राणिया री आज्ञा रे मुताबिक ओर जो यहूदिये आपणे ओर आपणी ल्वादा खे ठाणी ला था, तिजी रे मुताबिक बी बअरत ओर दु:ख करेया करो। <verse eid="EST 9:31" /><verse number="32" style="v" sid="EST 9:32" />पूरीमो रा ये नियम एस्तेर राणिया री आज्ञा ते बी स्थिर कित्तेया ओर तिना रे बारे दे कानूनो री कताबा दे लिखेया।<verse eid="EST 9:32" /></para>
  <chapter eid="EST 9" />
  <chapter number="10" style="c" sid="EST 10" />
  <para style="s">क्षयर्ष राजा ओर मोर्दकैए री महानता</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 10:1" />क्षयर्ष राजे देश ओर समुद्रो रे टापूए दे रणे वाल़ेया पाँदे कर लगाया। <verse eid="EST 10:1" /><verse number="2" style="v" sid="EST 10:2" />तेसरी महानता ओर पराक्रमो रे काम ओर मोर्दकैए री तेसा प्रतिष्ठा रा पूरा ब्योरा, जो राजे तेसरी कित्ती थी, से मादै ओर फारसो रे राजेया रे इतिआसो री कताबा दे लिखी राखेया, <verse eid="EST 10:2" /><verse number="3" style="v" sid="EST 10:3" />यहूदी मोर्दकै, क्षयर्ष राजे निठे ई था ओर यहूदिया री नजरा दे बड़ा था ओर तेसरे सारे पाई तेसते खुश थे, कऊँकि से आपणे यहूदी पाईया री पलाईया री टोल़ा दे रओ था ओर आपणे सबी लोका खे शान्तिया रिया गल्ला बोलेया करो था।<verse eid="EST 10:3" /></para>
  <chapter eid="EST 10" />
</usx>