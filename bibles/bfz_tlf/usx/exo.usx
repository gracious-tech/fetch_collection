  <book code="EXO" style="id" />
  <para style="ide">UTF -8</para>
  <para style="rem">Copyright Information: Creative Commons Attribution -ShareAlike 4.0 License</para>
  <para style="h">निर्गमन</para>
  <para style="toc1">गुलामिया ते छुटकारा</para>
  <para style="toc2">निर्गमन</para>
  <para style="toc3">निर्ग.</para>
  <para style="mt">निर्गमन</para>
  <para style="mt2">गुलामिया ते छुटकारा</para>
  <para style="is">भूमिका</para>
  <para style="ip">निर्गमन नाओं रा मतलब हांडणा या चली जाणा ए। ये इस्राएलो रे इतियासो री खास गल्ला खे बताओआ, जेतेरे बारे दे एते कताबा रे बताई राखेया मतलब इस्राएली लोका रा मिस्रो रे जेती थे तेथा ते चली जाणा ए। एते कताबा रे खास तीन इस्से ए</para>
  <para style="ili">इस्राएली लोका रा गुलामिया ते छुटकारा पाणा ओर सीनै रे पाह्ड़ो तक यात्रा करना।</para>
  <para style="ili">सीनै रे पाह्ड़ो पाँदे परमेशरो रा आपणे लोका साथे वादा करना, जेतेरे जरीये तिना खे जिन्दगी बिताणे रे नैतिक, समाजिक ओर तार्मिक नियम मिले।</para>
  <para style="ili">इस्राएली लोका खे आराधना करने री जगा खे बनाणा ओर सजाणा ओर पुरोईत ओर परमेशरो री आराधना ते जुड़े रे नियम मिलणा।</para>
  <para style="ip">खास करी की एते कताबा रे ये बताई राखेया कि परमेशरे क्या कित्तेया, जेड़ा की तिने आपणे लोक गुलामिया ते छुड़ाए ओर आऊणे वाल़े बखतो री उम्मीद करी की एक जातिया रे सेयो कट्ठे कित्ते।</para>
  <para style="ip">एते कताबा रा खास माणूं मूसा ए, जेसखे परमेशरे इजी री खातर चूणी राखेया था ताकि से आपणे लोका खे मिस्रो ते निकयाल़ी की ल्याओ। एते कताबा रा खास इस्सा 20 वें पाठो रे दित्ती री दस आज्ञा ए।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">इस्राएलिया रा मिस्र देशो ते निकल़ना <char style="ior"><ref loc="EXO 1:1-15:21">1:1-15:21</ref> </char></para>
  <para style="io1">मिस्रो रे दास <char style="ior"><ref loc="EXO 1:1-22">1:1-22</ref> </char></para>
  <para style="io1">मूसे रा जमणा ओर शुरूओ री जिन्दगी <char style="ior"><ref loc="EXO 2:1-4:31">2:1-4:31</ref> </char></para>
  <para style="io1">मूसा ओर हारूण मिस्रो रे राजे सामणे <char style="ior"><ref loc="EXO 5:1-11:10">5:1-11:10</ref> </char></para>
  <para style="io1">फसह ओर मिस्रो ते चलणा <char style="ior"><ref loc="EXO 12:1-15:21">12:1-15:21</ref> </char></para>
  <para style="io1">लाल समुद्रो ते सीनै रे पाह्ड़ो तक <char style="ior"><ref loc="EXO 15:22-18:27">15:22-18:27</ref> </char></para>
  <para style="io1">व्यवस्था ओर वादा <char style="ior"><ref loc="EXO 19:1-24:18">19:1-24:18</ref> </char></para>
  <para style="io1">मिलणे वाल़ा तम्बू ओर आराधना करने रे नियम <char style="ior"><ref loc="EXO 25:1-40:38">25:1-40:38</ref> </char></para>
  <chapter number="1" style="c" sid="EXO 1" />
  <para style="s">मिस्रो रे इस्राएलिया री दुर्दशा</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 1:1" />इस्राएलो रे पाऊआ रे नाओं, जो आपणे-आपणे कराने खे लई की याकूबो साथे मिस्र देशो रे आए, यो ए <verse eid="EXO 1:1" /><verse number="2" style="v" sid="EXO 1:2" />मतलब रूबेन, शिमोन, लेवी, यहूदा, <verse eid="EXO 1:2" /><verse number="3" style="v" sid="EXO 1:3" />इस्साकार, जबूलून, बिन्यामीन, <verse eid="EXO 1:3" /><verse number="4" style="v" sid="EXO 1:4" />दान, नप्ताली, गाद ओर आशेर। <verse eid="EXO 1:4" /><verse number="5" style="v" sid="EXO 1:5" />यूसुफ तो मिस्र देशो रे पईले ई आईगा था। याकूबो रे आपणे वंशो रे जो पैदा ऊए सेयो सारे 70 लोक थे।<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">प्रेरित 7:14</char></note><verse eid="EXO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 1:6" />यूसुफ ओर तेसरे सब पाई ओर तेसा पीढ़िया रे सब माणूं मरीगे।<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">प्रेरित 7:15</char></note> <verse eid="EXO 1:6" /><verse number="7" style="v" sid="EXO 1:7" />पर इस्राएलो री ल्वाद बढ़ने लगी ओर सेयो बऊत सामर्थी ऊँदे गये ओर सेयो इतना बढ़ीगे कि तिना साथे सारा देश परी गा।<verse eid="EXO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 1:8" />बऊत साला ते बाद मिस्रो रे दूजा राजा गद्दिया पाँदे राज करने खे बैठेया जो यूसुफो खे नि जाणो था।<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">प्रेरित 7:15</char></note> <verse eid="EXO 1:8" /><verse number="9" style="v" sid="EXO 1:9" />ओर राजे आपणी प्रजा रे लोका खे बोलेया, “देखो, इस्राएली लोक आसा ते गिणतिया रे बऊत जादा ओर सामर्था रे तागतबर ऊईगे रे। <verse eid="EXO 1:9" /><verse number="10" style="v" sid="EXO 1:10" />इजी खे आओ, आसे चलाकिया साथे तिना साथे बर्ताव करिए केथी एड़ा नि ओ कि सेयो बऊत बढ़ी जाओ ओर युद्धो रे बखते आसा रे खलाफ आसा रेया दुश्मणा ते मिली की आसा ते लड़ो ओर एस देशो ते निकल़ी जाओ।” <verse eid="EXO 1:10" /><verse number="11" style="v" sid="EXO 1:11" />इजी री खातर तिने तिना पाँदे मजदूरी कराणे वाल़े परदान ठराए, ताकि सेयो तिना पाँदे कामो रा बोज पाई-पाई की तिना खे दु:ख देया करो। तेबे तिने फिरौनो खे पितोम ओर रामसेस नाओं रे पण्डार वाल़े शईर बणाए। <verse eid="EXO 1:11" /><verse number="12" style="v" sid="EXO 1:12" />पर जिंयाँ-जिंयाँ सेयो मिस्रो रे लोक इस्राएलिया खे दु:ख देंदे गये, तिंयाँ-तिंयाँ सेयो बढ़दे ओर फैलदे गये, इजी री खातर सेयो इस्राएलिया ते बऊत डरीगे। <verse eid="EXO 1:12" /><verse number="13" style="v" sid="EXO 1:13" />तेबे बी मिस्रिए इस्राएलिया ते सख्तिया साथे काम करवाया <verse eid="EXO 1:13" /><verse number="14" style="v" sid="EXO 1:14" />ओर तिना री जिन्दगी गारे, ईट ओर जिम्मीदारे रे कई प्रकारा रे कामो री कठण सेवा साथे दु:खी करवाई ती; जेस केसी कामो रे सेयो तिना ते सेवा करवाओ थे, सेयो तिना साथे सख्त बर्ताव करो थे।<verse eid="EXO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 1:15" />शिप्रा ओर पूआ नाओं रिया दो इब्री दाईया खे मिस्रो रे राजे आज्ञा दित्ती, <verse eid="EXO 1:15" /><verse number="16" style="v" sid="EXO 1:16" />“जेबे तुसे इब्री जवाणसा खे बच्चा पैदा करदे बखते जमाणे रे पात्थरो पाँदे बैठी रिया देखो, तेबे जे पाऊ ओ तो से कायी देणा ओर जे बेटी ओ तो जिऊँदी राखी देणी।” <verse eid="EXO 1:16" /><verse number="17" style="v" sid="EXO 1:17" />पर सेयो दाईया परमेशरो रा डर मानो थिया ओर सेयो मिस्रो रे राजे री आज्ञा ना मानी की माठेया खे बी जिऊँदा राखी देओ थिया। <verse eid="EXO 1:17" /><verse number="18" style="v" sid="EXO 1:18" />तेबे मिस्रो रे राजे तिना खे बुलाई की पूछेया, “तुसे जो तिना पाऊआ खे जिऊँदा छाडी देओईया, तो एड़ा कऊँ करोईया?”<note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="ft" closed="false">प्रेरित 7:19</char></note> <verse eid="EXO 1:18" /><verse number="19" style="v" sid="EXO 1:19" />दाईये फिरौनो खे जबाब दित्तेया, “इब्रिया रिया जवाणसा मिस्रिया रिया जवाणसा जेड़िया निए, सेयो एड़िया फुर्तिलिया ए कि दाईया रे पऊँचणे ते पईले ई तिना रे बच्चा पैदा ऊई जाओआ।” <verse eid="EXO 1:19" /><verse number="20" style="v" sid="EXO 1:20" />इजी री खातर परमेशरे दाईया साथे पलाई कित्ती ओर सेयो इस्राएली लोक गिणतिया रे बढ़ी की बऊत सामर्थी ऊईगे। <verse eid="EXO 1:20" /><verse number="21" style="v" sid="EXO 1:21" />कऊँकि सेयो दाईया परमेशरो रा डर मानो थिया, इजी खे परमेशरे तिना खे ल्वाद दित्ती ओर तिना रे कअर बसाए<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="fq" closed="false">कअर बसाए </char><char style="ft" closed="false">मतलब तिने दाईये ईब्री मर्दा साथे ब्या कित्तेया ओर इस्राएलो री आम्मा बणिया</char></note>। <verse eid="EXO 1:21" /><verse number="22" style="v" sid="EXO 1:22" />तेबे फिरौने आपणी सारी प्रजा रे लोका खे आज्ञा दित्ती, “इब्रिया रे जितणे पाऊ पैदा ओ, तिना सबी खे तुसे नील नदिया रे सेटी देओ पर सब बेटिया जिऊँदिया छाडी देणियां।”<note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">प्रेरित 7:19</char></note><verse eid="EXO 1:22" /></para>
  <chapter eid="EXO 1" />
  <chapter number="2" style="c" sid="EXO 2" />
  <para style="s">मूसे रा जन्म</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 2:1" />तिना दिना रे लेविए रे कराने रे एकी मर्दे एक लेवी वंशो री बेटिया साथे ब्या करी ला।<verse eid="EXO 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 2:2" />कुछ बखतो ते बाद से जवाणस गर्भवती ऊई ओर तेसा रे एक पाऊ पैदा ऊआ ओर ये देखी की कि ये बाल़क बऊत सुन्दर ए, तीन मीन्ने तक लकोई की राखेया।<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">प्रेरित 7:20, इब्रानी 11:23</char></note> <verse eid="EXO 2:2" /><verse number="3" style="v" sid="EXO 2:3" />जेबे से तेसखे ओर लकोई नि सकी, तेबे तेसखे नंगल़ो री एक टोकरी लई ली, तेते पाँदे चिकणी माट्टी ओर राल़ लगाई की, तिदे बाल़क राखी की नील नदिया रे कनारे पाँदे जाड़ो बीचे छाडीता। <verse eid="EXO 2:3" /><verse number="4" style="v" sid="EXO 2:4" />तेस बाल़को री बईण तेसते थोड़ी जी दूर खड़ी री रयी, ताकि देखूँ कि एसरा क्या आल ऊणा।<verse eid="EXO 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 2:5" />तेबे फिरौनो री बेटी नाह्णे खे नदिया रे कनारे आयी, तेसा रिया दासिया नील नदिया रे कनारे कूमणे लगिया; तेबे तेसे जाड़ो बीचे टोकरी देखी की आपणी दासिया खे तिजी खे ल्याऊणे खे बोलेया।<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">प्रेरित 7:21</char></note> <verse eid="EXO 2:5" /><verse number="6" style="v" sid="EXO 2:6" />तेबे तेसे तिजी खे खोली की देखेया कि एक रोंदा ऊआ बाल़क ए; तेसखे देखी की तेसा खे तरस आया ओर तेसे बोलेया, “ये तो केसी इब्रिया रा बाल़क ऊणा।”<verse eid="EXO 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 2:7" />तेबे बाल़को री बईणे फिरौनो री बेटिया खे बोलेया, “क्या आऊँ जाई की इब्री जवाणसा बीचा ते केसी दूद पल्याणे वाल़िया खे तांगे बुलाई की ली आऊँ, जो तेरिया तँईं बाल़को खे दूद पल़्याया करो?”<verse eid="EXO 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 2:8" />फिरौनो री बेटिये तेसा खे बोलेया, “जा।” तेबे बेटी जाई की बाल़को रिया माया खे बुलाई की ली आई। <verse eid="EXO 2:8" /><verse number="9" style="v" sid="EXO 2:9" />फिरौनो री बेटिये तेसा खे बोलेया, “तूँ एस बाल़को खे लई जाई की मेरिया तँईं दूद पल्याया कर ओर मां ताखे त्याड़ी देणी।”</para>
  <para style="p" vid="EXO 2:9">तेबे से जवाणस बाल़को खे लई जायी की दूद पल्याणे लगी। <verse eid="EXO 2:9" /><verse number="10" style="v" sid="EXO 2:10" />जेबे बाल़क थोड़ा बड़ा ऊईगा, तेबे से तेसखे फिरौनो री बेटिया गे लईगी ओर से तेसा रा पाऊ ठईरेया ओर तेसे ये बोली की तेसरा नाओं मूसा राखेया कि मैं ये पाणिए ते निकयाल़ेया था।<verse eid="EXO 2:10" /></para>
  <para style="s">मूसे रा मिस्र देशो ते मिद्यान देशो खे नठणा</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 2:11" />तिना दिना रे एड़ा ऊआ कि जेबे मूसा जवान ऊआ ओर बारे जाई की आपणे पाई बंदुआ गे जाई की तिना रे दु:खो पाँदे त्यान करने लगेया; तेबे तिने देखेया कि कोई मिस्री माणूं मेरे एक इब्री पाईए खे कुटणे लगी रा। <verse eid="EXO 2:11" /><verse number="12" style="v" sid="EXO 2:12" />जेबे तिने चऊँ कनारे देखेया की कोई निए, तेबे तिने से मिस्री कायी ता ओर से बालूए रे लकोईता।<verse eid="EXO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 2:13" />फेर मूसे दूजे दिने बारे जाई की देखेया कि दो इब्री मर्द आपू बीचे कुठणे लगी रे थे; तिने पापिए खे बोलेया, “आपणे पाईए खे कऊँ लगी रा कुटणे?” <verse eid="EXO 2:13" /><verse number="14" style="v" sid="EXO 2:14" />तिने बोलेया, “तूँ किने आसा पाँदे हाकिम ओर न्यायी ठराई राखेया? जिंयाँ तैं मिस्री माणूं काया क्या माखे बी तिंयाँ ई काणा चाएया?” मूसा ये सुणी की डरीगा ओर तिने ये सोचेया कि पक्का एसा गल्ला रा सबी खे पता लगी गा रा। <verse eid="EXO 2:14" /><verse number="15" style="v" sid="EXO 2:15" />जेबे फिरौने ये गल्ल सुणी तेबे से मूसे खे काणे री साजिश करने लगेया। तेबे मूसा तेथा ते नठी की मिद्यान देशो रे जाई की रणे लगेया ओर जेबे से मिद्यान देशो रे पऊँचणे ते बाद तेती एकी कुएँ गे बैठी रा था। <verse eid="EXO 2:15" /><verse number="16" style="v" sid="EXO 2:16" />तेस बखते मिद्यानो रे एकी पुरोईतो रिया सात बेटिया तेती आयी की खुरलिया रे पाणी परने लगिया कि आपणे बाओ रिया पेड़ा-बाकरिया खे पल़याओ। <verse eid="EXO 2:16" /><verse number="17" style="v" sid="EXO 2:17" />तेबे गवाल़े आयी की तिना खे टाणे लगे, ये देखी की मूसे खड़े ऊई की तिना री मताद कित्ती ओर पेडा-बाकरिया खे पाणी पल़्याया। <verse eid="EXO 2:17" /><verse number="18" style="v" sid="EXO 2:18" />जेबे सेयो आपणे बाओ रूएलो<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="fq" closed="false">रूएल</char><char style="ft" closed="false">एते नाओं रा मतलब ए परमेशरो रा दोस्त </char></note> गे फेर आईया, तेबे तिने तिना ते पूछेया, क्या बजअ ए जो तुसे आज इतणी चट आई गिया?<verse eid="EXO 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 2:19" />तिने बोलेया, “एक मिस्री माणूंए आसे गवाल़े रे आथो ते छुड़ाईया ओर आसा रिया तँईं बऊत पाणी परी की पेडा-बाकरिया खे पल़्याया।”<verse eid="EXO 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 2:20" />तेबे तिने आपणी बेटिया खे बोलेया, “केयी आ से माणूं? तुसे तेसखे कऊँ छाडी आईया? तेसखे बुलाई की ली आओ, ताकि से रोटी खाई लओ।”<verse eid="EXO 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 2:21" />तेबे मूसा तेस माणूंए रे कअरे आया ओर तिना साथे रणे खे खुश ऊईगा, रूएले मूसे साथे आपणी बेटी सिप्पोरा रा ब्या करी ता। <verse eid="EXO 2:21" /><verse number="22" style="v" sid="EXO 2:22" />तेबे तिना रे एक पाऊ जम्मेया, मूसे ये बोली की कि आऊँ दूजे देशो रे अणजाण ए, तेसरा नाओं गेर्शोम<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="fq" closed="false">गेर्शोम </char><char style="ft" closed="false">एते रा मतलब ए आँऊ एती परदेशी ए</char></note> राखेया।<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">प्रेरित 7:29, प्रेरित 7:6</char></note><verse eid="EXO 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 2:23" />बऊत साला ते बाद मिस्रो रा राजा मरीगा ओर इस्राएली कठण सेवा रिया बजअ ते लाम्बा-लाम्बा साआ लई की आखी परने लगे ओर आका पाणे लगे; तिना री दुहाई जो कठण सेवा रिया बजअ ते ऊई, परमेशरो तक पऊँची। <verse eid="EXO 2:23" /><verse number="24" style="v" sid="EXO 2:24" />परमेशरे तिना रा जोरो रा रोणा सुणी की आपणी वाचा, जो तिने अब्राहम, इसहाक ओर याकूबो साथे बानी थी, याद कित्ती।<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="ft" closed="false">प्रेरित 7:34</char></note> <verse eid="EXO 2:24" /><verse number="25" style="v" sid="EXO 2:25" />ओर परमेशरे इस्राएलिया खे देखी की तिना री सम्माल़ लई।<verse eid="EXO 2:25" /></para>
  <chapter eid="EXO 2" />
  <chapter number="3" style="c" sid="EXO 3" />
  <para style="s">मूसा ओर बल़ेया रा जाड़</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 3:1" />एकी दिने मूसा आपणे सऊरे यित्रो जेसरा नाओं रूएल ए ओर जो मिद्यानो रा पुरोईत था तेसरिया पेडा-बाकरिया चराणे लगी रा था ओर से तिना खे सुनसाण जगा री पच्छमा री तरफा खे होरेब नाओं रे परमेशरो रे सीनै नाओं रे पाह्ड़ो रे नेड़े लईगा। <verse eid="EXO 3:1" /><verse number="2" style="v" sid="EXO 3:2" />तेबे यहोवे रे दूते मूसे खे एक कांडे वाल़े फुखदे ऊए जाड़ो बीचे आगी री लूपिया रे दर्शण दित्तेया ओर तिने नजर करी की देखेया कि जाड़ फूखणे लगी रा, पर स्वा नि ऊणे लगी रा।<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">मरक 12:26, लूक 20:37</char></note> <verse eid="EXO 3:2" /><verse number="3" style="v" sid="EXO 3:3" />तेबे मूसे सोचेया, “मां तेती जाई कि ये अचम्बे रा काम देखणा कि एते कांडे वाल़े जाड़ो रे आग तो लगी री पर ये जाड़ फूखणे कऊँ नि लगी रा।”<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">प्रेरित 7:30,31</char></note><verse eid="EXO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 3:4" />जेबे यहोवे देखेया कि मूसा मुड़ी की देखणे आऊणे लगी रा, तेबे परमेशरे तेसखे कांडे वाल़े जाड़ो बीचा ते आका पाईया, “ओ मूसा, ओ मूसा!” मूसे बोलेया, “हाँजी, आँऊ एती ए।”<verse eid="EXO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 3:5" />तेबे परमेशरे बोलेया, “एते नेड़े नि आओ ओर आपणे पैरा ते जोड़े खोली दे, कऊँकि जेते जगा रे तूँ खड़ी रा, से पवित्र जगा ए।”<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">प्रेरित 7:33</char></note> <verse eid="EXO 3:5" /><verse number="6" style="v" sid="EXO 3:6" />फेर परमेशरे बोलेया, “आऊँ तेरे बाओ-दादे, अब्राहम, इसहाक ओर याकूबो रा परमेशर ए।” तेबे मूसा जो परमेशरो रिया तरफा खे देखणे ते डरने लगी रा था, तिने आपणा मूँ टखी ता।<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">मत्ती 22:32, मरक 12:26, लूक 20:37</char></note><verse eid="EXO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 3:7" />फेर यहोवे बोलेया, “मैं आपणी प्रजा रे लोक, जो मिस्रो रे ए, तिना रे दु:ख पक्का देखी राखे ओर तिना रा चींगणा जो मईणत करवाणे वाल़े रिया बजअ ते ओआ, से बी मैं सुणी राखेया ओर तिना रे दु:खो पाँदे मैं त्यान लगाई राखेया। <verse eid="EXO 3:7" /><verse number="8" style="v" sid="EXO 3:8" />इजी री खातर एबे आऊँ उतरी की आईगा रा ताकि तिना खे मिस्रिया रे वशो ते छुड़ाऊँ ओर तेते देशो ते निकयाल़ी की केसी तुरे ओर बड़े देशो रे जो सच्चो खेई बऊत ई पजणे वाल़ा देश ए, मतलब कनानी, हित्ती, एमोरी, परिज्जी, हिब्बी ओर यबूसी लोका रिया जगा रे पऊँचाई देऊँआ। <verse eid="EXO 3:8" /><verse number="9" style="v" sid="EXO 3:9" />इजी रिया तँईं एबे सुण, इस्राएलिया रा चींगणा माखे सुणी रा ओर मिस्रिया रा तिना पाँदे अन्देर करना बी माखे दिशी रा। <verse eid="EXO 3:9" /><verse number="10" style="v" sid="EXO 3:10" />इजी री खातर आओ, आऊँ ताखे फिरौनो गे पेजुँआ, ताकि तूँ मेरे इस्राएली लोका खे मिस्रो ते निकयाल़ी की ल्याओ।”<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">प्रेरित 7:34</char></note><verse eid="EXO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 3:11" />तेबे मूसे परमेशरो खे बोलेया, “आऊँ कुण ए जो फिरौनो गे जाऊँ ओर इस्राएलिया खे मिस्र देशो ते निकयाल़ी की ल्याऊँ?” <verse eid="EXO 3:11" /><verse number="12" style="v" sid="EXO 3:12" />तेबे परमेशरे बोलेया, “पक्का मां तां साथे रणा ओर इजी गल्ला रा कि ताखे पेजणे वाल़ा आऊँ ए, एक चिह्न ऊणा, जेबे तूँ तिना लोका खे मिस्रो ते निकयाल़ी चुकोगा तेबे तुसा एस ई पाह्ड़ो पाँदे परमेशरो री पूजा करनी।”<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">प्रेरित 7:7</char></note> <verse eid="EXO 3:12" /><verse number="13" style="v" sid="EXO 3:13" />मूसे परमेशरो खे बोलेया, “जेबे आऊँ इस्राएलिया गे जाई की तिना खे ये बोलूँ कि तुसा रे पितरा रे परमेशरे आऊँ तुसा गे पेजी राखेया, तेबे जे सेयो मांते पूछो कि तेसरा नाओं क्या ए, तेबे आऊँ तिना खे क्या बताऊँगा?” <verse eid="EXO 3:13" /><verse number="14" style="v" sid="EXO 3:14" />परमेशरे मूसे खे बोलेया, “आऊँ जो अए से अए।” दुबारा ते परमेशरे तेसखे बोलेया, तैं इस्राएलिया खे ये बोलणा कि जेसरा नाओं आऊँ ए तिने ई आऊँ तुसा गे पेजी राखेया।<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">प्रकाशित 1:4,8, प्रकाशित 4:8, प्रकाशित 11:17</char></note> <verse eid="EXO 3:14" /><verse number="15" style="v" sid="EXO 3:15" />परमेशरे मूसे खे ये बी बोलेया, “तैं इस्राएलिया खे ये बोलणा कि तुसा रे पितरा रा परमेशर मतलब अब्राहम, इसहाक ओर याकूबो रा परमेशर यहोवा ए, तिने ई आऊँ तुसा गे पेजी राखेया। देख, सदा तक मेरा नाओं येई रणा ओर पीढ़िया ते पीढ़िया तक मेरी याद इजी नाओं तेई ऊणी।<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">मत्ती 22:32, मरक 12:26</char></note> <verse eid="EXO 3:15" /><verse number="16" style="v" sid="EXO 3:16" />इजी री खातर एबे जाई की इस्राएलिया रे स्याणेया खे कट्ठा कर ओर तिना खे बोल कि तुसा रे बुजुर्ग अब्राहम, इसहाक, ओर याकूबो रे परमेशर यहोवा माखे दर्शण देई की ये बोली राखेया कि मैं तुसा पाँदे ओर तुसा साथे जो बर्ताव मिस्रो रे कित्तेया जाओआ तेते पाँदे बी त्यान लगाई राखेया <verse eid="EXO 3:16" /><verse number="17" style="v" sid="EXO 3:17" />ओर मैं ठाणी ला रा कि मां तुसे मिस्रो रे दु:खो ते निकयाल़ी की कनानी, हित्ती, एमोरी, परिज्जी, हिब्बी ओर यबूसी देशो रे लोका बीचे लई चलणे, जो एड़ा देश ए जो सच्चो खेई बऊत ई पजणे वाल़ा ए। <verse eid="EXO 3:17" /><verse number="18" style="v" sid="EXO 3:18" />तेबे तिना तेरी ई गल्ल सुणनी ओर तैं इस्राएलिया रे स्याणेया खे साथे लई की मिस्रो रे राजे गे जाई की तेसखे एड़ा बोलणा कि इब्रिया रे परमेशर यहोवे साथे म्हारी मुलाकात ऊई री, इजी री खातर आसा खे एबे तिंऊँ दिना रिया बाटा दे सुनसाण जगा दे जाणे दे, ताकि आसे आपणे परमेशर यहोवे खे बलिदान चढ़ाऊँ। <verse eid="EXO 3:18" /><verse number="19" style="v" sid="EXO 3:19" />आऊँ जाणूंआ कि मिस्रो रे राजे तुसे नि पेजणे बल्कि बड़े जोरो साथे दबाव पाई की पनि जाणे देणे।<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">निर्ग. 5:2</char></note> <verse eid="EXO 3:19" /><verse number="20" style="v" sid="EXO 3:20" />इजी री खातर मां आपणा आथ बढ़ाई की मिस्र देशो रे सारे अचम्बे रे काम करने ओर तिना खे सजा देणी तेबे तिजी ते बाद तेस तुसे जाणे देणे। <verse eid="EXO 3:20" /><verse number="21" style="v" sid="EXO 3:21" />तेबे मां मिस्रिया ते आपणी एसा प्रजा पाँदे दया करवाणी ओर जेबे तुसे निकल़ने तेबे खाली आथ नि निकल़ने। <verse eid="EXO 3:21" /><verse number="22" style="v" sid="EXO 3:22" />बल्कि तुसा रिया सबी जवाणसा आपणियां-आपणियां मिस्री पड़ोसणी ते सूईने चाँदिए रे गईणे ओर टाल्ले मांगी लणे ओर तुसे सेयो आपणे माठे-बेटिया खे पन्याणे ओर ईंयाँ तुसा मिस्री लुटणे।”<verse eid="EXO 3:22" /></para>
  <chapter eid="EXO 3" />
  <chapter number="4" style="c" sid="EXO 4" />
  <para style="s">मूसे खे परमेशरो ते नौखी सामर्थ मिलणी</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 4:1" />तेबे मूसे जबाब दित्तेया, “इस्राएलिया मेरा विश्वास नि करना ओर ना तिना मेरी सुणनी ओर बोलणा कि यहोवे ताखे दर्शण निए दित्तेया रा।” <verse eid="EXO 4:1" /><verse number="2" style="v" sid="EXO 4:2" />यहोवे तेसखे बोलेया, “तेरे आथो रे ये क्या ए?” तिने बोलेया, “ये एक सोठी<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="fq" closed="false">सोठी </char><char style="ft" closed="false">मतलब गवाल़े री सोठी</char></note> ए।”<verse eid="EXO 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 4:3" />तेबे परमेशर यहोवा तेसखे बोलेया, “इजी खे जमीना पाँदे राखी दे।” जेबे तिने से सोठी जमीना पाँदे राखी तेबे से साप बणीगी ओर मूसा तेसरे सामणे ते नठीगा। <verse eid="EXO 4:3" /><verse number="4" style="v" sid="EXO 4:4" />यहोवे मूसे खे बोलेया, “आथ बढ़ा ओर तेसरी पूँछ पकड़ी लो। तिने आथ बढ़ाई की से पकड़ेया तेबे से तेसरे आथो रे फेर सोठी बणीगी। <verse eid="EXO 4:4" /><verse number="5" style="v" sid="EXO 4:5" />ताकि सेयो लोक तेरा विश्वास करो कि तुसा रे पितर अब्राहम, इसहाक ओर याकूबो रे परमेशर यहोवा ताखे दर्शण दित्ते।”<verse eid="EXO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 4:6" />तेबे यहोवे मूसे खे दुबारा बोलेया, “आपणा आथ छातिया पाँदे राखी की टकी दे।” तेबे तिने आपणा आथ छातिया पाँदे राखी की टकी ता; फेर जेबे तिने से निकयाल़ेया तेबे देखेया कि तेसरा आथ कोढ़ो साथे बर्फा जेड़ा सफेद ऊईगा था।<verse eid="EXO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 4:7" />तेबे यहोवे फेर बोलेया, “तूँ आपणा आथ छातिया पाँदे फेर राखी की टकी दे।” तेबे तिने आपणा आथ छातिया पाँदे राखी की टकी ता ओर जेबे तिने से छातिया पाँदो ते टाया तेबे तिने देखेया कि से तो फेर सारे शरीरो जेड़ा ऊईगा।<verse eid="EXO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 4:8" />फेर यहोवे बोलेया, “जे सेयो लोक तेरिया गल्ला पाँदे फेर बी विश्वास नि करोगे ओर पईले चिह्नो खे नि मानो, तेबे तिना दूजे चिह्नो पाँदे विश्वास करना। <verse eid="EXO 4:8" /><verse number="9" style="v" sid="EXO 4:9" />ओर जे सेयो इना दुँईं चिह्ना रा बी विश्वास नि करोगे ओर तेरी गल्ला खे नि मानो, तेबे तैं नील नदिया ते थोड़ा जा पाणी लणा ओर सूकी जमीना पाँदे सेटी देणा ओर जो पाणी तां नदिया ते निकयाल़ना से सूकी जमीना पाँदे खून बणी जाणा।” <note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">निर्ग. 7:19</char></note><verse eid="EXO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 4:10" />मूसे यहोवे खे बोलेया, “ओ मेरे यहोवा, आऊँ बोलणे रे काबिल निए, ना पईले था ओर ना जदुओ ते तूँ आपणे दासो साथे जपणे लगेया, मेरी जबान तोतल़ी ए ओर मेरे बोल कमजोर ए।”<verse eid="EXO 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 4:11" />यहोवे तेसखे बोलेया, “माणूंआ रा मूँ किने बणाई राखेया ओर माणूंआ खे गूँगा या टऊणा ओर देखणे वाल़ा ओर अन्दा, मां यहोवे खे छाडी की कुण बणाई सकोआ? <verse eid="EXO 4:11" /><verse number="12" style="v" sid="EXO 4:12" />एबे जा, मां तेरे मुंए साथे ऊई की जो तां बोलणा ओगा से ताखे सखांदे जाणा।”<verse eid="EXO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 4:13" />मूसे बोलेया, “ओ मेरे यहोवा, मईरबानी करी की तूँ केसी ओरी माणूंए खे पेज।” <verse eid="EXO 4:13" /><verse number="14" style="v" sid="EXO 4:14" />तेबे यहोवे रा कोप मूसे पाँदे पड़केया ओर तिने बोलेया, “क्या तेरा पाई लेवी गोत्रो रा हारूण निए? माखे तो निश्चा ए कि से बोलणे रे काबिल ए ओर से मिलणे खे बी आऊणे लगी रा ओर ताखे देखी की मनो रे खुश ऊणा। <verse eid="EXO 4:14" /><verse number="15" style="v" sid="EXO 4:15" />इजी री खातर तूँ तेसखे इना गल्ला सिखाया ओर मां तेसरे मुंए साथे ओर तेरे मुंए साथे ऊई की जो कुछ तुसा करना ओगा ओर से तुसा खे सखांदे जाणा। <verse eid="EXO 4:15" /><verse number="16" style="v" sid="EXO 4:16" />तेस तेरिया तरफा ते लोका साथे गल्ला करेया करनिया; ओर तूँ तेसखे परमेशरो जेड़ा रणा। <verse eid="EXO 4:16" /><verse number="17" style="v" sid="EXO 4:17" />ओर तू एसा सोठिया खे आथो रे लई जा ओर इजी साथे ई यो चिह्न दखाणे।”<verse eid="EXO 4:17" /></para>
  <para style="s">मूसे रा मिस्र देशो खे वापस आऊणा</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 4:18" />एकी दिने मूसा आपणे सऊरे यित्रो गे गया ओर तेसखे बोलेया, “माखे मईरबानी करी की जाणे दे कि आऊँ मिस्रो रे रणे वाल़े आपणे पाईया गे जाई की देखूँ कि सेयो जिऊँदे कि नई।” तेबे यित्रे बोलेया, “ठीक ए, मजे साथे जा।”<verse eid="EXO 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 4:19" />ओर एड़ा ऊआ जेबे मूसा मिद्यान देशो रे था तेबे यहोवे तेसखे बोलेया, “मिस्रो खे वापस ऊई जा, कऊँकि जो माणूं तेरे प्राण लणा चाओ थे सेयो सब मरीगे रे।”<note caller="+" style="f"><char style="fr" closed="false">4:19 </char><char style="ft" closed="false">मत्ती 2:20</char></note> <verse eid="EXO 4:19" /><verse number="20" style="v" sid="EXO 4:20" />तेबे मूसा परमेशरो री सोठिया खे आथो रे लई की आपणी लाड़िया खे ओर बच्चेया खे गह्देया पाँदे चढ़ाई की मिस्र देशो रिया तरफा खे वापस ऊआ।<verse eid="EXO 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 4:21" />यहोवे मूसे खे बोलेया, “जेबे तूँ मिस्रो रे आए तेबे सावधान ऊई जाया, ओर जो अचम्बे रे काम करने री सामर्थ मैं ताखे देई राखी तिजी की सेयो सब फिरौनो गे दखाणे; पर मां तेसरा मन टीठ करना ओर तेस मेरी प्रजा जाणे नि देणी।<note caller="+" style="f"><char style="fr" closed="false">4:21 </char><char style="ft" closed="false">रोमी 9:18</char></note> <verse eid="EXO 4:21" /><verse number="22" style="v" sid="EXO 4:22" />तेबे तैं फिरौनो खे बोलणा, ‘यहोवा ईंयाँ बोलोआ कि इस्राएलो रे लोक मेरे जेठे पाऊए जेड़े ए <verse eid="EXO 4:22" /><verse number="23" style="v" sid="EXO 4:23" />ओर आऊँ जो ताखे बोली चुकेया रा कि मेरे पाऊए खे जाणे दे, ताकि से मेरी सेवा करो ओर तैं से एबुए तक जाणे नि दित्तेया, इजी बजअ ते मां एबे तेरा जेठा पाऊ कायी देणा।’ ”<verse eid="EXO 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 4:24" />तेबे एड़ा ऊआ कि बाटा रे संरायी रे यहोवा मूसे खे मिलेया ओर तिने से काणा चाया। <verse eid="EXO 4:24" /><verse number="25" style="v" sid="EXO 4:25" />तेबे सिप्पोरे एक पैना पात्थर लई की आपणे पाऊए रा खतना कित्तेया ओर बाडी री चामड़ी मूसे रे पैरा पाँदे ये बोली की सेटी ती कि पक्का तूँ खून बाह्णे वाल़ा मेरा लाड़ा ए। <verse eid="EXO 4:25" /><verse number="26" style="v" sid="EXO 4:26" />तेबे परमेशरे से छाडीता ओर तेस ई बखते खतने रिया बजअ ते तेसे बोलेया, “तूँ खून बाह्णे वाल़ा लाड़ा ए।”<verse eid="EXO 4:26" /></para>
  <para style="s">मूसा ओर हारूणो रा मिलणा</para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 4:27" />तेबे यहोवे हारूणो खे बोलेया, “मूसे खे मिलणे सुनसाण जगा रे जा।” तेबे से चली गा ओर परमेशरो रे पाह्ड़ो रे तेसखे मिलेया ओर तेसरे गल़े लगेया। <verse eid="EXO 4:27" /><verse number="28" style="v" sid="EXO 4:28" />तेबे मूसे हारूणो खे ये बताया कि यहोवे क्या-क्या गल्ला बोली की से पेजी राखेया ओर कुण-कुण चिह्न दखाणे री आज्ञा तेसखे देई राखी। <verse eid="EXO 4:28" /><verse number="29" style="v" sid="EXO 4:29" />तेबे मूसे ओर हारूणे जाई की इस्राएलिया रे सारे स्याणे कट्ठे कित्ते। <verse eid="EXO 4:29" /><verse number="30" style="v" sid="EXO 4:30" />ओर जितणिया गल्ला यहोवे मूसे साथे कित्तिया थिया, सेयो सब हारूणे तिना खे सुणाईयां ओर लोका सामणे सेयो चिह्न बी दखाए। <verse eid="EXO 4:30" /><verse number="31" style="v" sid="EXO 4:31" />तेबे लोके तिना पाँदे विश्वास कित्तेया ओर ये सुणी की कि परमेशरे इस्राएलिया री सम्बाल़ लई ओर तिना रे दु:ख देखी राखे, तिने सिर थाले करी की माथा तेकेया। <note caller="+" style="f"><char style="fr" closed="false">4:31 </char><char style="ft" closed="false">निर्ग. 3:15,18</char></note><verse eid="EXO 4:31" /></para>
  <chapter eid="EXO 4" />
  <chapter number="5" style="c" sid="EXO 5" />
  <para style="s">फिरौनो रे सामणे मूसा ओर हारूण</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 5:1" />इजी ते बाद मूसा ओर हारूण फिरौनो गे आए ओर तिने तेसखे बोलेया, “इस्राएलो रा परमेशर यहोवा ईंयाँ बोलोआ कि मेरे लोका खे जाणे देओ, ताकि सेयो सुनसाण जगा रे मेरिया तँईं त्योआर करो।”<verse eid="EXO 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 5:2" />ये गल्ल सुणी की फिरौने ईंयाँ बोलेया, “ये यहोवा अया कुण कि आऊँ तेसरा वचन मानी की इस्राएलिया खे जाणे देऊँ? आऊँ यहोवे खे नि जाणदा ओर मां इस्राएली लोक पनि जाणे देणे।”<verse eid="EXO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 5:3" />तिने बोलेया, “इब्रिया रा परमेशर आसा खे मिलेया। इजी री खातर आसा खे सुनसाण जगा रे तिंऊँ दिना रे सफरो रे आपणे परमेशर यहोवे खे बलिदान चढ़ाणे खे जाणे दे, एड़ा नि ओ कि से आसा पाँदे मरी फैलाओ या तलवार चलवाओ।”<verse eid="EXO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 5:4" />तेबे मिस्रो रे राजे तिना खे बोलेया, “ओ मूसा, ओ हारूण, तुसे कऊँ माणूंआ ते काम छुड़ाणा चाओए? तुसे जाई की आपणे बेकारो रे कामो रे लगी जाओ।” <verse eid="EXO 5:4" /><verse number="5" style="v" sid="EXO 5:5" />फेर फिरौने बोलेया, “सुणो, एते देशो रे सेयो लोक बऊत ऊईगे रे, तेबेई तो तुसे तिना री मईणता ते राम दलाणा चाओए!”<verse eid="EXO 5:5" /></para>
  <para style="s">फिरौनो रे जरीये लोका खे सजा</para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 5:6" />फिरौने तेसी दिने तिना मईणत करने वाल़ेया खे ओर तिना रे सरदारा खे ये आज्ञा दित्ती, <verse eid="EXO 5:6" /><verse number="7" style="v" sid="EXO 5:7" />“तुसे जो एबुओ तक ईटा बनाणे खे माणूंआ खे पराल़ देया करो थे, से आगे नि देणा; सेयो आपू ई जाई की आपू खे पराल़ कट्ठा करो। <verse eid="EXO 5:7" /><verse number="8" style="v" sid="EXO 5:8" />तेबे बी तिना खे जितणिया ईटा एबुओ तक बनाणियां पड़ो थिया तिथणिया ई आगे बी तिना ते बनवाणियां, ईटा री गिणती कटाणी नि, कऊँकि सेयो आल़सी ए, इजी बजअ ते सेयो ये बोली की चिंगोए, ‘आसे जाई की आपणे परमेशरो खे बलिदान चढ़ाऊँए।’ <verse eid="EXO 5:8" /><verse number="9" style="v" sid="EXO 5:9" />तिना माणूंआ ते ओर बी कठण काम कराओ, ताकि सेयो तिदे मईणत करदे रओ ओर चूठी गल्ला पाँदे त्यान नि देओ।”<verse eid="EXO 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 5:10" />तेबे लोका ते मईणत करवाणे वाल़ेया ओर सरदारे बारे जाई की इस्राएलिया खे बोलेया, “फिरौन ईंयाँ बोलोआ कि मां तुसा खे पराल़ नि देणा। <verse eid="EXO 5:10" /><verse number="11" style="v" sid="EXO 5:11" />तुसेई जाई की जेती केथी बी पराल़ मिलो तेथा ते कट्ठा करी की ली आओ, पर तुसा रा काम बिल्कुल पनि कटाया जाणा।”<verse eid="EXO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 5:12" />इजी री खातर सेयो लोक सारे मिस्र देशो रे ओरे-पोरे ऊईगे, ताकि पराल़ो रे बदले कानी कट्ठी करो। <verse eid="EXO 5:12" /><verse number="13" style="v" sid="EXO 5:13" />मईणत करवाणे वाल़े ये बोली-बोली की तिना साथे जल्दबाजी करदे रये कि जिंयाँ तुसे पराल़ ऊँदे ऊए बी काम करेया करो थे तिंयाँ ई आपणा रोजका काम एबे बी पूरा करो। <verse eid="EXO 5:13" /><verse number="14" style="v" sid="EXO 5:14" />इतणा ई नि जो इस्राएली फिरौनो रे मईणत कराने वाल़ेया तिना लोका पाँदे सरदार ठराए थे, सेयो मिस्रो रे मईणत करवाणे वाल़ेया कूटे बी ओर तिना ते पूछेया, “क्या बजअ कि तुसे आपणी ठराई री ईटा रिया गिणतिया रे मुताबिक पईले जेड़ी काल ओर आज पूरी नि कित्ती?”<verse eid="EXO 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 5:15" />तेबे इस्राएलिया रे सरदारे जाई की फिरौनो गे आथ जोड़ी की बोलेया, “तूँ आपणे दासो साथे एड़ा बर्ताव कऊँ लगी रा करने? <verse eid="EXO 5:15" /><verse number="16" style="v" sid="EXO 5:16" />तेरे दासा खे पराल़ तो देंदे ई नि ओर सेयो आसा खे बोलदे रओए कि ईटा बणाओ, ईटा बणाओ, एड़ा बोली की तेरे दासा खे कुटणे लगी रे; पर देखेया जाओ तो दोष तेरे ई लोका राए।”<verse eid="EXO 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 5:17" />पर फिरौने बोलेया, “तुसे आल़सी ए, पूरे आल़सी; इजी बजअ ते बोलोए कि आसा खे यहोवे खे बलिदान करने खे जाणे दे। <verse eid="EXO 5:17" /><verse number="18" style="v" sid="EXO 5:18" />एबे जाई की आपणा काम करो ओर तुसा खे कोई पराल़ नि मिलणा, पर ईटा री गिणती पूरी करनी पड़नी।”<verse eid="EXO 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 5:19" />जेबे इस्राएलिया रे सरदारे ये गल्ल सुणी कि तिना री ईटा री गिणती नि कटणी ओर हर रोज तिथणा ई काम करना पड़ना, तेबे तिना खे पता लगेया कि तिना रे मुसीबता रे दिन आईगे रे। <verse eid="EXO 5:19" /><verse number="20" style="v" sid="EXO 5:20" />जेबे सेयो फिरौनो रे सामणे ते बारे निकल़ी की आईगे, तेबे मूसा ओर हारूण, जो तिना ते मिलणे खे खड़ी रे थे, तिना खे मिले। <verse eid="EXO 5:20" /><verse number="21" style="v" sid="EXO 5:21" />तेबे तिने मूसा ओर हारूणो खे बोलेया, “यहोवा तुसा पाँदे नजर करी की न्याय करो, कऊँकि तुसे आसे फिरौनो रिया ओर तेसरे काम करने वाल़ेया रिया नजरा रे बुरे ठराई की आसा खे मरवाणे खे तिना रे आथो रे तलवार देई राखी।”<verse eid="EXO 5:21" /></para>
  <para style="s">मूसे री परमेशरो ते शकाईत</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 5:22" />तेबे मूसे यहोवे गे वापस जाई की बोलेया, “ओ यहोवा, तैं इना लोका साथे एड़ी बुराई कऊँ कित्ती ओर तैं आऊँ एती कऊँ पेजेया? <verse eid="EXO 5:22" /><verse number="23" style="v" sid="EXO 5:23" />जदुओ ते आऊँ तेरे नाओं ते फिरौनो गे गल्ला करने खे गया तदुओ ते तिने इना लोका साथे बुरा ई बर्ताव करी राखेया ओर तैं आपणे लोका रा कोई छुटकारा बी नि कित्तेया।”<verse eid="EXO 5:23" /></para>
  <chapter eid="EXO 5" />
  <chapter number="6" style="c" sid="EXO 6" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 6:1" />तेबे यहोवे मूसे खे बोलेया, “एबे तां देखणा कि मां फिरौनो री तरफा खे आपणा सामर्थी आथ बढ़ाणा ओर तिजी सामर्थी आथो री बजअ ते से इस्राएलिया खे आपणे देशो ते निकाल़ने खे मजबूर ऊई जाणा।”<verse eid="EXO 6:1" /></para>
  <para style="s">मूसे रा बुलाया जाणा</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 6:2" />परमेशरे मूसे खे बोलेया, “आऊँ यहोवा ए; <verse eid="EXO 6:2" /><verse number="3" style="v" sid="EXO 6:3" />आऊँ सर्वशक्तिमान परमेशरो रे नाओं ते तेरे पितर अब्राहम, इसहाक ओर याकूबो खे दर्शण देऊँ था पर यहोवे रे नाओं ते आऊँ तिना सामणे नि आया। <verse eid="EXO 6:3" /><verse number="4" style="v" sid="EXO 6:4" />ओर मैं तिना साथे एक वाचा पक्की कित्ती कि कनान देशो रे जेती सेयो परदेशी बणी की रओ थे, से तिना खे देई देऊँ। <verse eid="EXO 6:4" /><verse number="5" style="v" sid="EXO 6:5" />इतणा ई नि इस्राएली लोक जिना खे मिस्र देशो रे माणूं गुलामिया रे राखो थे, आँऊ तिना रे दु:खो रा कणना सुणी की आपणी वाचा रे मुताबिक तिना री मताद करूँआ। <verse eid="EXO 6:5" /><verse number="6" style="v" sid="EXO 6:6" />इजी री बजअ ते तूँ इस्राएलिया खे बोल कि आऊँ यहोवा ए ओर मां तुसे मिस्रिया रे बोजो निठा ते निकयाल़ने ओर मां आपणा आथ बढ़ाई की ओर तिना पाँदे सामर्था रे कामो रे जरीये सजा देई की तुसे तिना री गुलामिया ते छुड़ाणे<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">प्रेरित 13:17</char></note> <verse eid="EXO 6:6" /><verse number="7" style="v" sid="EXO 6:7" />ओर मां तुसे आपणी प्रजा बनाणे खे अपनाई लणे ओर आऊँ तुसा रा परमेशर ठईरना ओर तुसा जाणी लणा कि आऊँ तुसा रा परमेशर यहोवा ए, जो तुसा खे मिस्रिया रे बोजो निठा ते निकयाल़ी की ली आयी रा। <verse eid="EXO 6:7" /><verse number="8" style="v" sid="EXO 6:8" />ओर जेते देशो खे देणे रा वादा मैं अब्राहम, इसहाक ओर याकूबो साथे कित्तेया था, मां तुसे तिदे ई पऊँचाई देणे ओर मां तुसे तेतेरे अक्कदार बणाई देणे। आऊँ तो यहोवा ए।”<verse eid="EXO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 6:9" />यो गल्ला मूसे इस्राएलिया खे बोलिया, पर तिने मनो री बेचैनी ओर गुलामिया री क्रूरता रिया बजअ ते तिना री नि सुणी। <verse eid="EXO 6:9" /><verse number="10" style="v" sid="EXO 6:10" />तेबे यहोवे मूसे खे बोलेया, <verse eid="EXO 6:10" /><verse number="11" style="v" sid="EXO 6:11" />“तूँ जाई की मिस्रो रे राजा फिरौनो खे बोल कि इस्राएलिया खे आपणे देशो ते निकल़ने दे।” <verse eid="EXO 6:11" /><verse number="12" style="v" sid="EXO 6:12" />ओर मूसे यहोवे खे बोलेया, “देख इस्राएलिए ई मेरी नि सुणी; तेबे फिरौनो मेरी किंयाँ सुणनी कऊँकि आऊँ बोलणे रे बी तोतल़ा ए।” <verse eid="EXO 6:12" /><verse number="13" style="v" sid="EXO 6:13" />तेबे यहोवे मूसा ओर हारूणो खे इस्राएलिया ओर मिस्रो रे राजा फिरौनो रिया तँईं आज्ञा इजी बजअ ते दित्ती कि सेयो इस्राएलिया खे मिस्र देशो ते निकयाल़ी की लई जाओ।<verse eid="EXO 6:13" /></para>
  <para style="s">मूसा ओर हारूणो रा खानदान</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 6:14" />तिना रे पितरा रे कराने रे खास माणूं यो ए इस्राएलो रा जेठा रूबेनो रे पाऊ हनोक, पल्लू, हेस्रोन ओर कर्मी थे, इना ते रूबेनो रे कुल निकल़े। <verse eid="EXO 6:14" /><verse number="15" style="v" sid="EXO 6:15" />शिमोनो रे पाऊ यमूएल, यामीन, ओहद, याकीन ओर सोहर थे ओर एक कनानी जवाणसा रा पाऊ शाऊल बीए इना ते शिमोनो रा कुल निकल़ेया। <verse eid="EXO 6:15" /><verse number="16" style="v" sid="EXO 6:16" />लेविए रे पाऊ जिना ते तिना रा खानदान चली रा तिना रे नाओं यो ए मतलब गेर्शोन, कहात ओर मरारी, ओर लेवी 137 साला तक जिऊँदा रया। <verse eid="EXO 6:16" /><verse number="17" style="v" sid="EXO 6:17" />गेर्शोनो रे पाऊ जिना ते तिना रा कुल चली रा सेयो लिब्नी ओर शिमी थे। <verse eid="EXO 6:17" /><verse number="18" style="v" sid="EXO 6:18" />कहातो रे पाऊ अम्राम, यिसहार, हेब्रोन ओर उज्जीएल ए ओर कहातो री सारी उम्र 133 साला री ऊई। <verse eid="EXO 6:18" /><verse number="19" style="v" sid="EXO 6:19" />मरारी रे पाऊ महली ओर मूशी थे। येई लेविए रा कुल था जिना ते तेसरा खानदान चलेया। <verse eid="EXO 6:19" /><verse number="20" style="v" sid="EXO 6:20" />अम्रामे आपणी बुआ योकेबेदा<note caller="+" style="f"><char style="fr" closed="false">6:20 </char><char style="fq" closed="false">योकेबेदा </char><char style="ft" closed="false">एते नाओं रा मतलब ए यहोवे री महिमा </char></note> साथे ब्या करी ता ओर तेसा ते हारूण ओर मूसा जम्मे ओर अम्राम एक सौ सैंती साला तक जिऊँदा रया। <verse eid="EXO 6:20" /><verse number="21" style="v" sid="EXO 6:21" />यिसहार रे पाऊ कोरह, नेपेग, जिक्री थे। <verse eid="EXO 6:21" /><verse number="22" style="v" sid="EXO 6:22" />उज्जीएलो रे पाऊ मीशाएल, एलसाफान ओर सित्री थे। <verse eid="EXO 6:22" /><verse number="23" style="v" sid="EXO 6:23" />हारूण अम्मीनादाबा री बेटी ओर नहशोनो री बईण एलीशेबा खे ब्यायी की ली आया ओर तेसा ते नादाब, अबीहू, एलीआजार ओर ईतामार जम्मे।<verse eid="EXO 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 6:24" />कोरह रे पाऊ अस्सीर, एलकाना, अबीआसाफ ए ओर इना ते कोरहिया रे कुल निकल़े। <verse eid="EXO 6:24" /><verse number="25" style="v" sid="EXO 6:25" />हारूणो रे पाऊ एलीआजारे पूतीएलो री एकी बेट्टिया साथे ब्या करी ला ओर तेसा ते पीनहास जम्मेया। जिना ते तिना रा कुल चलेया। लेविया रे पितरो रे कराने रे खास माणूं यो ईए। <verse eid="EXO 6:25" /><verse number="26" style="v" sid="EXO 6:26" />हारूण ओर मूसा सेयो ईए जिना खे यहोवे ये आज्ञा दित्ती, “इस्राएलिया खे चूण्ड-चूण्ड करी की तिना रे जत्थेया रे मुताबिक मिस्र देशो ते निकयाल़ी की ली आओ।” <verse eid="EXO 6:26" /><verse number="27" style="v" sid="EXO 6:27" />ये सेयो ई मूसा ओर हारूण ए जिने मिस्रो रे राजा फिरौनो खे बोलेया कि आसा इस्राएली मिस्रो ते निकयाल़ी की लई जाणे।<verse eid="EXO 6:27" /></para>
  <para style="s">हारूण ओर मूसे खे परमेशरो री आज्ञा</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 6:28" />जेबे यहोवे मिस्र देशो रे मूसे ते ये गल्ल बोली कि, <verse eid="EXO 6:28" /><verse number="29" style="v" sid="EXO 6:29" />“आऊँ तो यहोवा ए, इजी री खातर आऊँ तुसा खे जो कुछ बोलूँगा, से सब मिस्रो रे राजा फिरौनो खे बोलणा।”<verse eid="EXO 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 6:30" />पर मूसे यहोवे खे जबाब दित्तेया, “आऊँ तो बोलणे रे बी तोतल़ा ए, फिरौनो मेरी बिल्कुल पनि सुणनी?”<verse eid="EXO 6:30" /></para>
  <chapter eid="EXO 6" />
  <chapter number="7" style="c" sid="EXO 7" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 7:1" />तेबे यहोवे मूसे खे बोलेया, “देख, आऊँ ताखे फिरौनो रिया तँईं परमेशरो जेड़ा ठराऊँआ ओर तेरा पाई हारूण तेरिया तँईं बोलणे वाल़ा ठईरना। <verse eid="EXO 7:1" /><verse number="2" style="v" sid="EXO 7:2" />जो-जो आज्ञा आऊँ ताखे देऊँ, सेई तैं बोलणा ओर हारूणो सेयो फिरौनो गे बोलणिया, ताकि से इस्राएलिया खे मिस्र देशो ते निकल़ने देओ। <verse eid="EXO 7:2" /><verse number="3" style="v" sid="EXO 7:3" />पर मां आपणे चिह्न ओर अचम्बे रे काम मिस्र देशो रे बऊत दखाणे फेर बी मां फिरौनो रा मन काठा करी देणा।<note caller="+" style="f"><char style="fr" closed="false">7:3 </char><char style="ft" closed="false">प्रेरित 7:36</char></note> <verse eid="EXO 7:3" /><verse number="4" style="v" sid="EXO 7:4" />तेबे बी फिरौनो तुसा री नि सुणनी ओर मां मिस्र देशो रे आपणा आथ बढ़ाई की मिस्रिया खे पारी सजा देई की आपणी सेना, मतलब आपणे इस्राएली लोक मिस्र देशो ते निकयाल़ी लणे। <verse eid="EXO 7:4" /><verse number="5" style="v" sid="EXO 7:5" />जेबे मां मिस्रो पाँदे आथ बढ़ाई की इस्राएली तिना बीचा ते निकयाल़ने, तेबे मिस्रिया जाणी लणा कि आऊँ यहोवा ए।”<verse eid="EXO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 7:6" />तेबे मूसे ओर हारूणे यहोवे रिया आज्ञा रे मुताबिक ई कित्तेया। <verse eid="EXO 7:6" /><verse number="7" style="v" sid="EXO 7:7" />मूसा ओर हारूण जेबे फिरौनो साथे गल्ला करने लगे, तेबे मूसा तो 80 साला रा था ओर हारूण 83 साला रा था।<verse eid="EXO 7:7" /></para>
  <para style="s">हारूणो री चमत्कारी सोठी</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 7:8" />तेबे यहोवे मूसा ओर हारूणो खे ईंयाँ बोलेया, <verse eid="EXO 7:8" /><verse number="9" style="v" sid="EXO 7:9" />“जेबे फिरौन तुसा खे बोलो कि आपणा अचम्बे रा कोई एड़ा काम दखाओ जेते कि पता चली सको कि तुसे यहोवे मांगे पेजी राखे, तेबे तैं हारूणो खे बोलणा, ‘आपणी सोठी लई की फिरौनो सामणे सेटी दे, ताकि से साप बणी जाओ।’ ”<verse eid="EXO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 7:10" />तेबे मूसे ओर हारूणे फिरौनो गे जाई की यहोवे री आज्ञा रे मुताबिक कित्तेया ओर जेबे हारूणे आपणी सोठी फिरौन ओर तेसरे काम करने वाले़या सामणे राखी ती, तेबे से साप बणीगी। <verse eid="EXO 7:10" /><verse number="11" style="v" sid="EXO 7:11" />तेबे फिरौने पण्डत ओर जादू-टोणा करने वाल़े बुलाए ओर मिस्रो रे जादूगरे आई की आपणे-आपणे तंत्र-मंत्रो साथे तेड़ा ई कित्तेया। <verse eid="EXO 7:11" /><verse number="12" style="v" sid="EXO 7:12" />तिने बी आपणी-आपणी सोठी राखी ती ओर सेयो बी साप बणीगिया। पर हारूणो री सोठी तिना सबी री जादूए रिया सोठिया खे खाईगी। <verse eid="EXO 7:12" /><verse number="13" style="v" sid="EXO 7:13" />फेर बी फिरौनो रा मन ओर बी टीठ ऊईगा ओर यहोवे रे वचनो रे मुताबिक तिने मूसा ओर हारूणो रिया गल्ला नि मानिया।<verse eid="EXO 7:13" /></para>
  <para style="s">मिस्रिया पाँदे दस पारी मुसीबता पड़ने रा बखाण</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 7:14" />तेबे यहोवे मूसे खे बोलेया, “फिरौनो रा मन काठा ऊईगा रा ओर तेस ये लोक जाणे नि देणे। <verse eid="EXO 7:14" /><verse number="15" style="v" sid="EXO 7:15" />इजी री खातर प्यागा रे बखते फिरौनो गे जा, से नदिया री तरफा खे बारे आऊणा ओर जो सोठी साप बणीगी थी, तिजी खे तैं आथो रे लई की नील नदिया रे कनारे तेस साथे मिलणे खे खड़े रणा <verse eid="EXO 7:15" /><verse number="16" style="v" sid="EXO 7:16" />ओर तैं फिरौनो खे ईंयाँ बोलणा, ‘इब्रिया रे परमेशर यहोवा आऊँ ये बोलणे खे तांगे पेजी राखेया कि तूँ मेरी प्रजा रे लोका खे जाणे दे, ताकि सेयो सुनसाण जगा रे मेरी आराधना करो, पर एबुए तक तैं मेरा कईणा नि मानेया।’ ”<verse eid="EXO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 7:17" />यहोवा ईंयाँ बोलोआ कि इजी ते तां जाणी लणा कि आऊँ यहोवा ई परमेशर ए; देख, मां आपणी सोठी नील नदिया रे पाणिए पाँदे बाणी ओर पाणी खून बणी जाणा <verse eid="EXO 7:17" /><verse number="18" style="v" sid="EXO 7:18" />ओर जो मछलिया नील नदिया रे ए, सेयो मरी जाणिया ओर नील नदिया रे सड़यान आऊणे लगी जाणी ओर नील नदिया रा पाणी पीणे खे मिस्रिया रा जिऊ नि बोलणा। <verse eid="EXO 7:18" /><verse number="19" style="v" sid="EXO 7:19" />फेर यहोवे मूसे खे बोलेया, “हारूणो खे बोल कि आपणी सोठी लई की मिस्र देशो रे जितणी पाणिए री नदिया, नईरा, झीला ओर बांयी ए, तिना सबी पाँदे आपणा आथ बढ़ा, ताकि तिना रा पाणी खून बणी जाओ ओर सारे मिस्र देशो रे काठ ओर पात्थर दुँईं प्रकारा रे पाणिए रे पांडेया रे खून ई खून ऊई जाओ।”<note caller="+" style="f"><char style="fr" closed="false">7:19 </char><char style="ft" closed="false">प्रकाशित 8:8, प्रकाशित 11:6</char></note><verse eid="EXO 7:19" /></para>
  <para style="s">पईली मुसीबत-नील नदिया रे पाणिए रा खून बणना</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 7:20" />तेबे मूसे ओर हारूणे यहोवे रिया आज्ञा रेई मुताबिक कित्तेया, मतलब तिने सोठी चकी की फिरौन ओर तेसरे काम करने वाले़या सामणे नील नदिया पाँदे बायी ओर नदिया रा सारा पाणी खून बणीगा <verse eid="EXO 7:20" /><verse number="21" style="v" sid="EXO 7:21" />ओर नील नदिया रे जो मछलिया थिया सेयो मरी गिया ओर नदिया ते सड़यान आऊणे लगी ओर मिस्री लोक नदिया रा पाणी नि पी सके ओर सारे मिस्र देशो रे सबी जगा खून ई खून दिखणे लगेया।<note caller="+" style="f"><char style="fr" closed="false">7:21 </char><char style="ft" closed="false">प्रकाशित 16:3</char></note> <verse eid="EXO 7:21" /><verse number="22" style="v" sid="EXO 7:22" />तेबे मिस्रो रे जादूगरे आपणे तंत्र-मंत्रो साथे तेड़ा ई कित्तेया, तेबे बी फिरौनो रा मन टीठ ऊईगा ओर पईले जेड़ी यहोवे रे कईणे रे मुताबिक तिने मूसे ओर हारूणो री नि मानी। <verse eid="EXO 7:22" /><verse number="23" style="v" sid="EXO 7:23" />फिरौने इजी पाँदे बी त्यान नि दित्तेया ओर मूँ फेरी की आपणे मईलो खे चलीगा। <verse eid="EXO 7:23" /><verse number="24" style="v" sid="EXO 7:24" />ओर बऊत सारे मिस्री लोक पीणे रे पाणिए खे नील नदिया रे नेड़े-तेड़े खणने लगे, कऊँकि सेयो नदिया रा पाणी नि पी सको थे। <verse eid="EXO 7:24" /><verse number="25" style="v" sid="EXO 7:25" />जदुओ ते यहोवे नील नदिया रे पाणिए खे खून बणाया, तदुओ ते सात दिन ऊई चुके थे।<verse eid="EXO 7:25" /></para>
  <chapter eid="EXO 7" />
  <chapter number="8" style="c" sid="EXO 8" />
  <para style="s">दूजी मुसीबत–मिनकेया रा अमला</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 8:1" />तेबे यहोवे फेर मूसे खे बोलेया, “फिरौनो गे जाई की बोल कि यहोवा तुसा खे ईंयाँ बोलोआ कि मेरिया प्रजा रे माणूंआ खे जाणे देओ, ताकि सेयो मेरी आराधना करो। <verse eid="EXO 8:1" /><verse number="2" style="v" sid="EXO 8:2" />पर जे तूँ तिना खे जाणे नि देओगा तो देख, आऊँ मिनकेया पेजी की तेरे सारे देशो खे नुकशाण पऊँचाणे वाल़ा ए। <verse eid="EXO 8:2" /><verse number="3" style="v" sid="EXO 8:3" />ओर नील नदी मिनकेया साथे परी जाणी ओर सेयो तेरे भवनो रे ओर तेरे कमरे ओर माँजे पाँदे ओर काम करने वाल़ेया रे कअरे ओर तेरिया प्रजा पाँदे बल्कि तेरे तन्दूर ओर तेरे रोटी बनाणे रे पांडेया रे बी चढ़ी जाणे। <verse eid="EXO 8:3" /><verse number="4" style="v" sid="EXO 8:4" />ओर तां पाँदे, तेरिया प्रजा, ओर तेरे काम करने वाल़ेया ओर सबी पाँदे मिनके चढ़ी जाणे।”<verse eid="EXO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 8:5" />फेर यहोवे मूसे खे आज्ञा दित्ती, “हारूणो खे बोली दे कि नदिया, नईरा, ओर झीला पाँदे सोठिया साथे आपणा आथ बढ़ाई की मिनकेया खे मिस्रो प्रदेशो रे पेजी दे।” <verse eid="EXO 8:5" /><verse number="6" style="v" sid="EXO 8:6" />तेबे हारूणे मिस्रो रे पाणिए पाँदे आपणा आथ बढ़ाया ओर पूरा मिस्र देश मिनकेया साथे परी गा। <verse eid="EXO 8:6" /><verse number="7" style="v" sid="EXO 8:7" />ओर जादूगरे बी आपणे तंत्र-मंत्रो ते तिंयाँ ई मिस्र देशो पाँदे मिनके पेजी ते। <verse eid="EXO 8:7" /><verse number="8" style="v" sid="EXO 8:8" />तेबे फिरौने मूसे ओर हारूणो खे बुलाई की बोलेया, “यहोवे ते प्रार्थना करो कि तिना मिनकेया खे मांते ओर मेरिया प्रजा रे लोका ते दूर लई जाओ ओर मां इस्राएलिया रे माणूं जाणे देणे ताकि सेयो यहोवे खे बलिदान करो।”<verse eid="EXO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 8:9" />तेबे मूसे फिरौनो खे बोलेया, “इतणिया गल्ला खे तूँ माखे आज्ञा दे कि एबे आऊँ ताखे ओर तेरे काम करने वाल़ेया, ओर प्रजा रिया तँईं कदी प्रार्थना करुँ ताकि यहोवा तांगा ते ओर तेरे कअरो ते मिनके दूर करो ओर सेयो बस नील नदिया रेई रओ।” <verse eid="EXO 8:9" /><verse number="10" style="v" sid="EXO 8:10" />तेबे फिरौने बोलेया, “काल।” तो मूसे बोलेया, “तेरे वचनो रे मुताबिक ऊणा, जेते कि ताखे ये पता लगी जाओ कि म्हारे परमेशर यहोवे जेड़ा कोई दूजा परमेशर अया ई नि। <verse eid="EXO 8:10" /><verse number="11" style="v" sid="EXO 8:11" />ओर मिनके तांगा ते, तेरे कअरो ते, तेरे काम करने वाल़ेया गे ते ओर तेरी प्रजा ते दूर ऊई की बस नील नदिया रे रणे।”<verse eid="EXO 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 8:12" />इजी ते बाद मूसा ओर हारूण फिरौनो गे ते निकल़ी गे ओर मूसे तिना मिनकेया रे बारे दे यहोवे ते प्रार्थना कित्ती, जो तिने फिरौनो पाँदे पेजे थे। <verse eid="EXO 8:12" /><verse number="13" style="v" sid="EXO 8:13" />ओर यहोवे मूसे रे कईणे रे मुताबिक कित्तेया ओर मिनके तिना रे कअर, आँगण ओर डोरूआ रे मरीगे। <verse eid="EXO 8:13" /><verse number="14" style="v" sid="EXO 8:14" />ओर लोके कट्ठे करी की तिना रे टेर लगाई ते ओर सारा देश सड़यानी साथे परी गा। <verse eid="EXO 8:14" /><verse number="15" style="v" sid="EXO 8:15" />पर जेबे फिरौने देखेया कि एबे मुसीबत टल़ीगी री, तेबे यहोवे रे कईणे रे मुताबिक फेर तिने आपणा मन काठा करी ता ओर मूसा ओर हारूणो री नि सुणी।<verse eid="EXO 8:15" /></para>
  <para style="s">तीजी मुसीबत–पऊँरी रे चूण्ड</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 8:16" />फेर यहोवे मूसे खे बोलेया, “हारूणो खे आज्ञा दे कि तूँ आपणी सोठी बढ़ाई की तरतिया री तूड़ा पाँदे बा, जेते कि से तूड़ सारे मिस्र देशो रे पऊँरो बणी जाओ।” <verse eid="EXO 8:16" /><verse number="17" style="v" sid="EXO 8:17" />तेबे तिने तेड़ा ई कित्तेया; मतलब हारूणे सोठी आथो रे लई की बढ़ाई ओर जमीना री तूड़ा पाँदे बाई, तेबे माणूं ओर डांगरा दुँईं पाँदे पऊँरो ऊईगिया, बल्कि सारे मिस्र देशो रे जमीना री तूड़ पऊँरो बणीगी। <verse eid="EXO 8:17" /><verse number="18" style="v" sid="EXO 8:18" />तेबे जादूगरे चाया कि आपणे तंत्रो-मंत्रो रिया तागती पाँदे पऊँरो लई आऊँए, पर तिना ते ये ऊई नि सकेया ओर माणूं ओर डांगर दुँईं पाँदे पऊँरो बणी री रईया।<verse eid="EXO 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 8:19" />तेबे जादूगरे फिरौनो खे बोलेया, “ये तो परमेशरो रे आथो रा काम ए।” तेबे बी यहोवे रे कईणे रे मुताबिक फिरौनो रा मन काठा ऊँदा गया ओर तिने मूसे ओर हारूणो री गल्ल नि मानी।<verse eid="EXO 8:19" /></para>
  <para style="s">चौथी मुसीबत–माखा रा चूण्ड</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 8:20" />फेर यहोवे मूसे खे बोलेया, “प्यागा उठी की फिरौनो सामणे खड़े ऊणा, से तो नदिया रिया तरफा खे आऊणा ओर तेसखे बोलणा कि यहोवा ताखे ईंयाँ बोलोआ कि मेरी प्रजा रे लोका खे जाणे दे, ताकि सेयो मेरी आराधना करो। <verse eid="EXO 8:20" /><verse number="21" style="v" sid="EXO 8:21" />जे तैं मेरी प्रजा रे लोक जाणे नि दित्ते तो देख, मां तां पाँदे, तेरे काम करने वाल़ेया पाँदे, तेरी प्रजा पाँदे ओर तेरे कअरे चूण्डा रे चूण्ड़ माखा रे पेजणे ओर मिस्रिया रे कअर ओर जमीन बी माखा साथे परी जाणी। <verse eid="EXO 8:21" /><verse number="22" style="v" sid="EXO 8:22" />तेस दिने मां गोशेन प्रदेश जिदे मेरे लोक रओए, लग करने ओर तिदे माखा रे चूण्ड नि ऊणे, जेते कि तूँ जाणी लओ कि तरतिया पाँदे आऊँ ई यहोवा ए। <verse eid="EXO 8:22" /><verse number="23" style="v" sid="EXO 8:23" />ओर मां आपणी प्रजा रे लोका ओर तेरी प्रजा रे लोका बीचे फर्क ठराणा। ये चिह्न काल ऊणा।”<verse eid="EXO 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 8:24" />ओर यहोवे तेड़ा ई कित्तेया जेड़ा मूसे फिरौनो ते बोलेया था कि फिरौनो रे भवन, तेसरे काम करने वाल़ेया रे कअरो रे ओर सारे मिस्र देशो रे माखा रे चूण्डा रे चूण्ड परी गे ओर तिने की सारा देश नाश ऊईगा। <verse eid="EXO 8:24" /><verse number="25" style="v" sid="EXO 8:25" />तेबे फिरौने मूसा ओर हारूणो खे बुलाई की बोलेया, “तुसे जाई की आपणे परमेशरो खे एस ई देशो रे बलिदान करो।”<verse eid="EXO 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 8:26" />पर मूसे बोलेया, “एड़ा करना ठीक निए, कऊँकि आसे जो आपणे परमेशर यहोवे खे बलिदान चढ़ाऊँए, तिना डांगरा रे बलिदानो ते मिस्री लोक कृणा करोए ओर जे आसे तिना सामणे तिना रिया नफरता वाल़िया चीजा बलिदान करूँगे, तो क्या तिना आसा खे पात्थर नि बाणे? <verse eid="EXO 8:26" /><verse number="27" style="v" sid="EXO 8:27" />आसा सुनसाण जगा रे तिंऊँ दिना रे सफरो रे जाई की आपणे परमेशर यहोवे खे जेड़ा से आसा खे बोलोगा, तेड़ा ई बलिदान करना।”<verse eid="EXO 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 8:28" />फिरौने बोलेया, “मां तुसे सुनसाण जगा रे जाणे देणे ताकि तुसे आपणे परमेशर यहोवे खे बलिदान करो, बस बऊत दूर नि जाणा ओर एबे माखे बिनती करो।” <verse eid="EXO 8:28" /><verse number="29" style="v" sid="EXO 8:29" />तेबे मूसे बोलेया, “देख, मां एथा ते बारे जाई की यहोवे ते बिनती करनी कि माखा रे चूण्ड तेरे ओर तेरे काम करने वाल़ेया ओर तेरी प्रजा रे लोका गे ते काल ई दूर ऊई जाओ; पर फिरौन आगो खे कपट करी की आसा खे यहोवे रिया तँईं बलिदान करने खे जाणे खे ना नि करो।”<verse eid="EXO 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 8:30" />इजी खे मूसे मिस्रो रे राजा फिरौनो गे ते बारे जाई की यहोवे ते बिनती कित्ती। <verse eid="EXO 8:30" /><verse number="31" style="v" sid="EXO 8:31" />ओर यहोवे मूसे री बिनतिया रे मुताबिक माखा रे चूण्ड फिरौन, तेसरे काम करने वाल़ेया ओर तेसरी प्रजा रे लोका गे ते एड़े दूर करीते, एथो तक कि तेती एक पनि रया। <verse eid="EXO 8:31" /><verse number="32" style="v" sid="EXO 8:32" />पर फिरौने एस बार बी आपणा मन काठा कित्तेया ओर सेयो लोक जाणे नि दित्ते।<verse eid="EXO 8:32" /></para>
  <chapter eid="EXO 8" />
  <chapter number="9" style="c" sid="EXO 9" />
  <para style="s">पाँजी मुसीबत–डांगरा री मौत</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 9:1" />तेबे यहोवे मूसे खे बोलेया, “फिरौनो गे जाई की बोल कि इस्राएलिया रा परमेशर यहोवा तुसा खे ईंयाँ बोलोआ कि मेरिया प्रजा रे माणूंआ खे जाणे दे, ताकि सेयो मेरी आराधना करो <verse eid="EXO 9:1" /><verse number="2" style="v" sid="EXO 9:2" />ओर जे तूँ तिना खे जाणे नि देगा ओर एबे बी पकड़ी की राखेगा <verse eid="EXO 9:2" /><verse number="3" style="v" sid="EXO 9:3" />तेबे तूँ सुण, तेरे जो कोड़े, गह्दे, ऊँट, गाय-बल़द, पेडा-बाकरिया बगैरा मैदानो रे ए, तिना पाँदे यहोवे रा आथ एड़ा पड़ना कि एक खतरनाक डांगरा री बमारी फैलणी। <verse eid="EXO 9:3" /><verse number="4" style="v" sid="EXO 9:4" />पर यहोवे इस्राएलिया रे डांगरा बीचे ओर मिस्रिया रे डांगरा बीचे एड़ा फर्क करना कि जो इस्राएलिया रे डांगर ए, तिना बीचा ते कोई पनि मरना।” <verse eid="EXO 9:4" /><verse number="5" style="v" sid="EXO 9:5" />फेर यहोवे ये बोली की एक बखत ठराया, “मां ये काम एते देशो रे काल करना।”<verse eid="EXO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 9:6" />दूजे दिने यहोवे एड़ा ई कित्तेया ओर मिस्री लोका रे तो सारे डांगर मरीगे, पर इस्राएलिया रा एक बी डांगर नि मरेया। <verse eid="EXO 9:6" /><verse number="7" style="v" sid="EXO 9:7" />ओर फिरौने लोक पेजी की पता लगाई ला था कि इस्राएलिया रे डांगरा बीचा ते एक पनि मरी रा था। तेबे बी फिरौनो रा मन काठा ऊईगा ओर तिने सेयो लोक जाणे नि दित्ते।<verse eid="EXO 9:7" /></para>
  <para style="s">छठी मुसीबत–फल़फे ओर फोड़ेया रा निकल़ना</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 9:8" />तेबे यहोवे मूसा ओर हारूणो खे बोलेया, “तुसे दोनो पट्ठिया बीचा ते एक-एक मुट्ठी स्वाई री लई लो ओर मूसा तिजी खे फिरौनो सामणे सर्गो खे ऊड़ाई देओ। <verse eid="EXO 9:8" /><verse number="9" style="v" sid="EXO 9:9" />तेबे से छोटी-छोटी तूड़ ऊई की सारे मिस्र देशो रे माणूं ओर डांगर दुँईं रेया बदनो पाँदे फल़फे ओर फोड़े बणी जाणे।”<verse eid="EXO 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 9:10" />इजी खे सेयो पट्ठिया री स्वा लई की फिरौनो सामणे खड़े ऊईगे ओर मूसे से सर्गो रिया तरफा खे उड़ाईती ओर से माणूं ओर डांगर दुँईं पाँदे फल़फे ओर फोड़े बणीगे। <verse eid="EXO 9:10" /><verse number="11" style="v" sid="EXO 9:11" />तिना फोड़ेया रिया बजअ ते जादूगर मूसे सामणे खड़े नि रयी सके, कऊँकि सेयो फोड़े जेड़े मिस्रिया रे तेड़े ई जादूगरा रे बी निकल़े थे। <verse eid="EXO 9:11" /><verse number="12" style="v" sid="EXO 9:12" />तेबे यहोवे फिरौनो रा मन काठा करी ता ओर जेड़ा यहोवे मूसे खे बोलेया था, तिने तेसरी नि सुणी।<note caller="+" style="f"><char style="fr" closed="false">9:12 </char><char style="ft" closed="false">रोमी 9:18</char></note><verse eid="EXO 9:12" /></para>
  <para style="s">साती मुसीबत–ओल़ेया री बर्खा</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 9:13" />तेबे यहोवे मूसे खे बोलेया, “प्यागा उठी की फिरौनो रे सामणे खड़ा ऊई जा ओर तेसखे बोल, ‘इब्रिया रा परमेशर यहोवा ईंयाँ बोलोआ कि मेरी प्रजा रे लोका खे जाणे दे, ताकि सेयो मेरी आराधना करो। <verse eid="EXO 9:13" /><verse number="14" style="v" sid="EXO 9:14" />नई तो एबकी बार मां तां पाँदे, तेरे काम करने वाल़ेया पाँदे ओर तेरी प्रजा पाँदे सब प्रकारा रिया मुसीबता पाणिया, जेते की तां जाणी लणा कि सारी तरतिया पाँदे मां जेड़ा दूजा कोई निए। <verse eid="EXO 9:14" /><verse number="15" style="v" sid="EXO 9:15" />एबुए तक तो मां आपणा आथ बढ़ाई की तूँ ओर तेरी प्रजा महारिया साथे काई देणी थी ओर तूँ तरतिया पाँदा ते नाश ऊई जाणा था, <verse eid="EXO 9:15" /><verse number="16" style="v" sid="EXO 9:16" />पर मैं सच्ची तूँ इजी बजअ ते जिऊँदा राखेया ताकि आऊँ ताखे आपणी सामर्थ दखाऊँ जेते कि मेरे नाओं रा प्रचार सारी तरतिया रे ओ।<note caller="+" style="f"><char style="fr" closed="false">9:16 </char><char style="ft" closed="false">प्रकाशित 9:17</char></note> <verse eid="EXO 9:16" /><verse number="17" style="v" sid="EXO 9:17" />क्या तूँ एबे बी मेरी प्रजा रे लोका सामणे आपणे आपू खे कमण्ड करी की बड़ा समजेया ओर तिना खे जाणे नि देंदा? <verse eid="EXO 9:17" /><verse number="18" style="v" sid="EXO 9:18" />इजी खे देख, काल मां एस ई बखते एड़े पारी-पारी ओल़े बरसाणे कि तिना जेड़े मिस्र देशो रे शुरूओ ते लई की एबुए तक कदी नि पड़े ओगे। <verse eid="EXO 9:18" /><verse number="19" style="v" sid="EXO 9:19" />इजी री खातर एबे लोका खे पेजी की आपणे डांगर ओर मैदानो रे जो कुछ तेरा ए सबी खे फुर्तिया रे लकोई दे, नई तो जितणे डांगर या माणूं मैदानो रे रणे ओर कअरे कट्ठे नि करो, तो तिना पाँदे ओल़े पड़ने ओर सेयो मरी जाणे।’ ” <verse eid="EXO 9:19" /><verse number="20" style="v" sid="EXO 9:20" />तेबे फिरौनो रे काम करने वाल़ेया बीचा ते जो लोक यहोवे रे वचनो रा डर मानो थे, तिने आपणे-आपणे नौकर ओर डांगर कअरे समाल़ी की राखी ते। <verse eid="EXO 9:20" /><verse number="21" style="v" sid="EXO 9:21" />पर जिने यहोवे रे वचन नि माने, तिने आपणे नौकर ओर डांगर मैदानो रेई रणी ते।<verse eid="EXO 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 9:22" />तेबे यहोवे मूसे खे बोलेया, “आपणा आथ सर्गो रिया तरफा खे बढ़ा, ताकि सारे मिस्र देशो रे माणूं, डांगर ओर डोरूआ री सारी फसला पाँदे ओल़े पड़ो।” <verse eid="EXO 9:22" /><verse number="23" style="v" sid="EXO 9:23" />तेबे मूसे आपणी सोठी सर्गो रिया तरफा खे चकी ओर यहोवे रिया सामर्था साथे बादल़ गिड़ने लगे ओर ओल़े बरसणे लगे ओर आग तरतिया तक आऊँदी रयी। ईंयाँ यहोवे मिस्र देशो रे ओल़े बरसाए। <verse eid="EXO 9:23" /><verse number="24" style="v" sid="EXO 9:24" />जो ओल़े पड़ो थे तिना साथे आग बी ओरे-पोरे चमकणे लगी री थी ओर सेयो ओल़े इतणे खतरनाक थे कि जदुओ ते मिस्र देश बसेया था, तदुओ ते पूरे मिस्र प्रदेशो रे एड़े ओल़े कदी नि पड़े थे।<note caller="+" style="f"><char style="fr" closed="false">9:24 </char><char style="ft" closed="false">प्रकाशित 8:7, प्रकाशित 11:19</char></note> <verse eid="EXO 9:24" /><verse number="25" style="v" sid="EXO 9:25" />तेबे पूरे मिस्र देशो रे डोरूआ रे, क्या माणूं, क्या डांगर, जितणे बी थे सब ओल़ेया साथे मरीगे ओर ओल़ेया साथे डोरूआ री सारी फसल खराब ऊईगी ओर मैदानो रे सारे डाल़ टूटी गे। <verse eid="EXO 9:25" /><verse number="26" style="v" sid="EXO 9:26" />पर गोशेन देशो रे जेती इस्राएली रओ थे ओल़े नि पड़े।<verse eid="EXO 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 9:27" />तेबे फिरौने मूसा ओर हारूण बुलाए ओर तिना खे बोलेया, “एस बार मैं पाप करी राखेया, यहोवा तर्मी ए, आऊँ ओर मेरी प्रजा पापी ए। <verse eid="EXO 9:27" /><verse number="28" style="v" sid="EXO 9:28" />बादल़ा रा गिड़ना ओर ओल़ेया रा बरसणा बऊत ऊईगा, एबे परमेशरो ते बिनती करो, तेबे मां तुसे जाणे देणे ओर आगो खे तुसे मां नि रोकणे।” <verse eid="EXO 9:28" /><verse number="29" style="v" sid="EXO 9:29" />मूसे फिरौनो खे बोलेया, “शईरो ते निकल़ी की मां यहोवे री तरफा खे आथ फैलाणे तेबे बादल़ा रा गिड़ना बन्द ऊई जाणा ओर ओल़े फेर नि पड़ने। इजी ते तां जाणी लणा कि तरती यहोवे री ए। <verse eid="EXO 9:29" /><verse number="30" style="v" sid="EXO 9:30" />तेबे बी आऊँ जाणूंआ कि ना तो तां ओर ना तेरे काम करने वाल़ेया यहोवा, परमेशरो रा डर मानणा।”<verse eid="EXO 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 9:31" />अल़सी ओर जौ तो ओल़ेया साथे खत्म ऊईगे, कऊँकि जौ रे सिल्ले निकल़ी गे थे ओर अल़सिया रे फूल लगी रे थे। <verse eid="EXO 9:31" /><verse number="32" style="v" sid="EXO 9:32" />पर कणक ओर लाल रंगो री कणक जो बढ़ी नि रये थे, इजी बजअ ते सेयो खत्म नि ऊए।<verse eid="EXO 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 9:33" />जेबे मूसे फिरौनो गे ते शईरो ते बारे निकल़ी की यहोवे रिया तरफा खे आथ फैलाए, तेबे बादल़ा रा गिड़ना ओर ओल़ेया रा बरसणा बन्द ऊईगा ओर तेबे तरतिया पाँदे बर्खा बी बन्द ऊईगी। <verse eid="EXO 9:33" /><verse number="34" style="v" sid="EXO 9:34" />जेबे फिरौने ये देखेया कि बर्खा, ओल़े ओर बादल़ा रा गिड़ना बन्द ऊईगा तेबे तिने ओर तेसरे काम करने वाल़ेया फेर आपणा मन काठा करी की पाप कित्तेया। <verse eid="EXO 9:34" /><verse number="35" style="v" sid="EXO 9:35" />ईंयाँ फिरौनो रा मन टीठ ऊँदा गया ओर तिने इस्राएली जाणे नि दित्ते, जेड़ा कि यहोवे मूसे रे जरीये बुलवाया था।<verse eid="EXO 9:35" /></para>
  <chapter eid="EXO 9" />
  <chapter number="10" style="c" sid="EXO 10" />
  <para style="s">आठी मुसीबत–टिड्डिया रा अमला</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 10:1" />फेर जिंयाँ ई ओल़े बरसणे बन्द ऊईगे तेबे यहोवे मूसे खे बोलेया, “फिरौनो गे जा, कऊँकि मैं ई तेसरा ओर तेसरे काम करने वाले़या रा मन इजी री खातर काठा करी राखेया ताकि आपणे नऊखे-नऊखे चिह्न तिना बीचे दखाऊँ <verse eid="EXO 10:1" /><verse number="2" style="v" sid="EXO 10:2" />ओर तुसे लोक आपणे माठेया ओर पोतेया गे इजी रे बारे दे बताओ कि मैं यहोवे मिस्रिया साथे कोई प्यार नि दखाया ओर आपणे क्या-क्या नऊखे चिह्न तिना बीचे कित्ते, जेते साथे तुसा ये जाणी लणा कि आऊँ ई यहोवा ए।” <verse eid="EXO 10:2" /><verse number="3" style="v" sid="EXO 10:3" />तेबे मूसे ओर हारूणे फिरौनो गे जाई की ये बोलेया, “इस्राएलिया रा परमेशर यहोवा ताखे ईंयाँ बोलोआ कि तां कदुओ तक मेरी गल्ल मानणे ते ना करनी? मेरी प्रजा रे लोका खे जाणे दे, ताकि सेयो मेरी आराधना करो। <verse eid="EXO 10:3" /><verse number="4" style="v" sid="EXO 10:4" />जे तूँ मेरी प्रजा खे जाणे नि देगा तो देख, काल मां तेरे देशो रे टिड्डिया ली आऊणियां। <verse eid="EXO 10:4" /><verse number="5" style="v" sid="EXO 10:5" />सेयो तरतिया पाँदे इतणियां आई जाणिया कि तिने की तरती नि दिशणी ओर तुसा रा जो कुछ ओल़ेया साथे बची गा रा, से तिना खाई जाणा ओर तुसा रे जितणे डाल़ मैदानो रे लगी रे ओर डोरूआ रे जो कुछ ऊगी रा से सब बी तिना खाई देणा। <verse eid="EXO 10:5" /><verse number="6" style="v" sid="EXO 10:6" />सेयो तेरे ओर तेरे सारे काम करने वाल़ेया रे ओर एथो तक कि सारे मिस्रिया रे कअरा रे परी जाणिया; इतणियां टिड्डिया तेरे बाओ-दादेया ओर तिना रे बुजुर्गे जदुओ ते तरतिया पाँदे जम्मे तदुओ ते आजो तक कदी नि देखिया ऊगिया।” ये गल्ल बोली की से मूँ फेरी की फिरौनो रे सामणे ते बारे निकल़ी गा <verse eid="EXO 10:6" /><verse number="7" style="v" sid="EXO 10:7" />तेबे फिरौनो रे काम करने वाल़े तेसखे बोलणे लगे, “से माणूं कदुओ तक आसा खे फन्दा बणेया रा रणा? तिना माणूंआ खे जाणे दे, ताकि सेयो आपणे परमेशर यहोवे री आराधना करो, क्या ताखे एबुए तक पता नि लगेया कि सारा मिस्र नाश ऊईगा रा?” <verse eid="EXO 10:7" /><verse number="8" style="v" sid="EXO 10:8" />तेबे मूसा ओर हारूण फिरौनो गे फेर बुलाए ओर फिरौने तिना खे बोलेया, “चली जाओ, आपणे परमेशर यहोवे री आराधना करो, पर जो जाणे वाल़े ए, सेयो कुण-कुण ए?” <verse eid="EXO 10:8" /><verse number="9" style="v" sid="EXO 10:9" />तेबे मूसे बोलेया, “आसे तो माठे-बेटिया, पेडा बाकरिया, गाय-बल़द, बल्कि बच्चेया ते लई की स्याणेया तक सब जाणे, कऊँकि आसा यहोवे खे त्योआर मनाणा।” <verse eid="EXO 10:9" /><verse number="10" style="v" sid="EXO 10:10" />फिरौने तिना खे ईंयाँ बोलेया, “यहोवा तुसा साथे रओ जबकि आऊँ तुसा खे बच्चेया समेत जाणे देणे लगी रा, देखो, तुसा रे मनो रे बुराई ए। <verse eid="EXO 10:10" /><verse number="11" style="v" sid="EXO 10:11" />कदी, एड़ा नि ऊई सकदा, तुसे मर्द ई जाई की यहोवे री आराधना करो, तुसे येई तो चाओ थे।” तेबे फिरौने मूसा ओर हारूण आपणे सामणे ते निकयाल़ी ते। <verse eid="EXO 10:11" /><verse number="12" style="v" sid="EXO 10:12" />तेबे यहोवे मूसे खे बोलेया, “मिस्र देशो पाँदे आपणा आथ बढ़ा ताकि टिड्डिया मिस्र देशो रे चढ़ी की जमीना पाँदे जितणा नज्ज बगैरा ओल़ेया ते बची गा रा सब खाई जाओ।” <verse eid="EXO 10:12" /><verse number="13" style="v" sid="EXO 10:13" />तेबे मूसे आपणी सोठी लई की मिस्र देशो पाँदे ऊबे चकी, तेबे यहोवे पूरा दिन ओर पूरी रात देशो रे पूर्वो री तरफा ते अवा चलाई ओर प्याग ऊणे तक तेते अवा साथे टिड्डिया आईया। <verse eid="EXO 10:13" /><verse number="14" style="v" sid="EXO 10:14" />ओर टिड्डिये अमला करी की मिस्र देशो रे सारी जगा रे बसेरा करी ता, तिना रा चूण्ड बड़ा पारी था, बल्कि ना तो तिना ते पईले इतणिया टिड्डिया आईया थिया ओर ना ई तिना ते बाद इतणिया आऊणियां। <verse eid="EXO 10:14" /><verse number="15" style="v" sid="EXO 10:15" />सेयो तो पूरी तरतिया पाँदे फैली गिया, एथो तक कि देशो रे न्हेरा ऊईगा ओर तिना रा पूरा नज्ज बगैरा ओर डाल़ा रे सारे फल, मतलब जो कुछ ओल़ेया ते बची रा था, सब तिने खाई ला। एथो तक कि पूरे मिस्र देशो रे ना तो केसी डाल़ो रे कोई अरयाली रयी ओर ना ई डोरूआ रे नज्ज रया। <verse eid="EXO 10:15" /><verse number="16" style="v" sid="EXO 10:16" />तेबे फिरौने फटाफट मूसा ओर हारूण बुलाए ओर तिना खे बोलेया, “मैं तो तुसा रे परमेशर यहोवे रा ओर तुसा रा बी पाप करी राखेया। <verse eid="EXO 10:16" /><verse number="17" style="v" sid="EXO 10:17" />इजी री खातर एस बार मेरा ये पाप माफ करो ओर आपणे परमेशर यहोवे ते बिनती करो कि से बस मां पाँदा ते एसा मौता री सजा खे दूर करो।” <verse eid="EXO 10:17" /><verse number="18" style="v" sid="EXO 10:18" />तेबे मूसे फिरौनो गे ते निकल़ी की यहोवे ते बिनती कित्ती। <verse eid="EXO 10:18" /><verse number="19" style="v" sid="EXO 10:19" />तेबे यहोवे बऊत तेज पच्छमा री तरफा ते अवा चलाई की टिड्डिया ऊड़ाई की लाल समुद्रो रे सेटी तिया ओर मिस्रो रे केसी बी जगा रे एक बी टिड्डी नि बची। <verse eid="EXO 10:19" /><verse number="20" style="v" sid="EXO 10:20" />पर यहोवे फिरौनो रा मन काठा करी ता, जेते की तिने इस्राएली जाणे नि दित्ते।<verse eid="EXO 10:20" /></para>
  <para style="s">नवीं मुसीबत–न्हेरा</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 10:21" />फेर यहोवे मूसे खे बोलेया, “आपणा आथ सर्गो रिया तरफा खे बढ़ा ताकि मिस्र देशो पाँदे न्हेरा छाई जाओ, एड़ा न्हेरा कि लोक तोपणे लगो।”<verse eid="EXO 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 10:22" />तेबे मूसे आपणा आथ सर्गो रिया तरफा खे बढ़ाया ओर सारे मिस्र देशो रे तिंऊँ दिना तक अन्दकूप न्हेरा रया। <verse eid="EXO 10:22" /><verse number="23" style="v" sid="EXO 10:23" />मिस्री लोके तिंऊँ दिना तक ना तो कोई देखेया ओर ना कोई आपणी जगा ते उठेया; पर सारे इस्राएलिया रे कअरे प्रयासा रया।<verse eid="EXO 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 10:24" />तेबे फिरौने मूसे खे बुलाई की बोलेया, “तुसे लोक जाओ; यहोवे री आराधना करो; आपणी जवाणसा ओर बाल-बच्चेया खे बी साथे लई जाओ, बस आपणियां पेडा-बाकरिया ओर गायी बल़दा खे छाडी जाओ।”<verse eid="EXO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 10:25" />मूसे बोलेया, “ना! ताखे आसा खे मेलबलिया खे ओर होमबलिया खे डांगर बी देणे पड़ने, जिना खे आसे आपणे परमेशर यहोवे खे चढ़ाऊँ। <verse eid="EXO 10:25" /><verse number="26" style="v" sid="EXO 10:26" />इजी री खातर म्हारे डांगर बी आसा साथे जाणे, तिना रा एक खुर तक नि रणा, कऊँकि तिना बीचा तेई आसा खे आपणे परमेशर यहोवे री उपासना रा समान लणा पड़ना ओर आसे जदुओ तक तेती नि पऊँचो, तदुओ तक नि जाणदे कि क्या-क्या लई की यहोवे री आराधना करनी पड़नी।”<verse eid="EXO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 10:27" />पर यहोवे फिरौनो रा मन टीठ करी ता, जेते की तिने सेयो जाणे नि दित्ते।<verse eid="EXO 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 10:28" />तेबे फिरौने मूसे खे बोलेया, “तूँ मेरे सामणे ते चली जा ओर चौकस रओ, माखे आपणा मूँ फेर कदी नि दखाणा; कऊँकि जेस दिने तां आपणा मूँ माखे दखाणा, तेस ई दिने तूँ मारेया जाणा।”<verse eid="EXO 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 10:29" />मूसे बोलेया, “तैं ठीक बोलेया; मां तेरा मूँ फेर कदी नि देखणा।”<verse eid="EXO 10:29" /></para>
  <chapter eid="EXO 10" />
  <chapter number="11" style="c" sid="EXO 11" />
  <para style="s">जेठे बच्चेया री मौता री चेतावणी</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 11:1" />फेर यहोवे मूसे खे बोलेया, “एक आखरी मुसीबत मां फिरौन ओर मिस्र देशो पाँदे पाणी; तिजी ते बाद तेस तुसे एथा ते जाणे देणे ओर जेबे तेस जाणे देणे, तेबे तेस तुसे सब पक्का निकयाल़ी देणे। <verse eid="EXO 11:1" /><verse number="2" style="v" sid="EXO 11:2" />मेरी प्रजा खे मेरी ये आज्ञा सुणा कि एक-एक मर्द आपणे पड़ोसी ओर एक-एक जवाणस आपणियां पड़ोसणी ते सूईने चाँदिए रे गईणे मांगी लो।” <verse eid="EXO 11:2" /><verse number="3" style="v" sid="EXO 11:3" />यहोवे मिस्री लोका ते आपणी प्रजा रे लोका ते आदर दलाया ओर इजी ते जादा से मर्द मूसा मिस्र देशो रे फिरौनो रे काम करने वाले़या बीचे ओर आम माणूंआ री नजरा रे बऊत महान् था।<verse eid="EXO 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 11:4" />तेबे मूसे बोलेया, “यहोवा ईंयाँ बोलोआ कि आदिया राती रे करीब मां मिस्र देशो बीचे चलणा। <verse eid="EXO 11:4" /><verse number="5" style="v" sid="EXO 11:5" />तेबे मिस्रो री राजगद्दिया पाँदे बैठणे वाल़े फिरौनो ते लई की चाक्की पीसणे वाल़ी दासिया तको रे हरेक परिवारो रे जेठे बच्चे; बल्कि डांगरा रे बी पईले बच्चे मरी जाणे। <verse eid="EXO 11:5" /><verse number="6" style="v" sid="EXO 11:6" />तेबे सारे मिस्र देशो रे बऊत ई जोरो ते रोणा सुणना, एथो तक कि तेड़ा ना कदी ऊआ ओर ना फेर ऊणा। <verse eid="EXO 11:6" /><verse number="7" style="v" sid="EXO 11:7" />पर इस्राएलिया रे खलाफ, क्या माणूं, क्या डांगर, केसी पाँदे बी कोई कुत्ता नि पूकणा<note caller="+" style="f"><char style="fr" closed="false">11:7 </char><char style="fq" closed="false">कुत्ता नि पूकणा </char><char style="ft" closed="false">मतलब अचाणक कोई मुसीबत नि आऊणी</char></note>, जेते की तुसा जाणी लणा कि मिस्री ओर इस्राएलिया बीचे यहोवा फर्क करोआ। <verse eid="EXO 11:7" /><verse number="8" style="v" sid="EXO 11:8" />तेबे तेरे सब काम करने वाल़ेया मांगे आयी की मांगे माथा टेकी की माखे ये बोलणा, ‘मईरबानी करी की आपणे सबी लोका समेत निकल़ी जा।’ तिजी ते बाद मां निकल़ी जाणा।” ये बोली की मूसा बड़े गुस्से रे ऊई की फिरौनो गे ते निकल़ी गा।<verse eid="EXO 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 11:9" />यहोवे मूसे खे बोली ता था कि फिरौनो तुसा री नि सुणनी, कऊँकि मेरी इच्छा ए कि मिस्र देशो रे बऊत सारे अचम्बे रे काम करुँ।<verse eid="EXO 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 11:10" />मूसे ओर हारूणे फिरौनो सामणे यो सब अचम्बे रे काम कित्ते; पर यहोवे फिरौनो रा मन ओर काठा करी ता, तेबेई तो तिने इस्राएली आपणे देशो ते जाणे नि दित्ते।<verse eid="EXO 11:10" /></para>
  <chapter eid="EXO 11" />
  <chapter number="12" style="c" sid="EXO 12" />
  <para style="s">फसह रा त्योआर</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 12:1" />तेबे यहोवे मिस्र देशो दे मूसा ओर हारूणो खे बोलेया, <verse eid="EXO 12:1" /><verse number="2" style="v" sid="EXO 12:2" />“ये मीन्ना तुसा माणूंआ खे शुरूओ रा ठईरो, मतलब सालो रा पईला मीन्ना येई ठईरो। <verse eid="EXO 12:2" /><verse number="3" style="v" sid="EXO 12:3" />इस्राएलो रिया सारी मण्डल़िया खे ईंयाँ बोलो कि इजी मीन्ने रे दसुए दिने तुसे सब आपणे-आपणे पितरो रे कराने रे मुताबिक, एकी कराने खे एक मिन्टू लई राखो <verse eid="EXO 12:3" /><verse number="4" style="v" sid="EXO 12:4" />ओर जे केसी रे करानेया रे एक मिन्टू खाणे खे माणूं कम ओ, तो सेयो आपणे सबी ते नेड़े रणे वाल़े पड़ोसिया साथे तिना री गिणतिया रे मुताबिक एक मिन्टू लई राखो ओर तुसे हर एकी रे खाणे रे मुताबिक मिन्टूआ रा साब करना। <verse eid="EXO 12:4" /><verse number="5" style="v" sid="EXO 12:5" />तुसा रा मिन्टू बिना नुक्शो रा ओर पईले सालो रा नर ओ ओर से चाए पेडा बीचा ते लणा, चाए बाकरिया बीचा ते। <verse eid="EXO 12:5" /><verse number="6" style="v" sid="EXO 12:6" />ओर तुसे एते मीन्ने रे चौदुए दिनो तक से राखी की छाडी देणा ओर तेस दिने सूरजो रे छिपणे रे बखते, इस्राएलो री सारिया मण्डल़िया रे लोक तेसखे बलिदान करो। <verse eid="EXO 12:6" /><verse number="7" style="v" sid="EXO 12:7" />तेबे सेयो तेसरे खूनो ते कुछ लई की जिना कअरो रे मिन्टू खाणा, तिना रे द्धारो री साखा ओर पाँदली चौखटा रे सिरे पाँदे लगाओ। <verse eid="EXO 12:7" /><verse number="8" style="v" sid="EXO 12:8" />ओर सेयो तेसरे मासो खे तेसी ई राती आगी रे पूजी की बिना सजेड़े रिया रोटिया साथे ओर कड़ुए सागो साथे खाओ। <verse eid="EXO 12:8" /><verse number="9" style="v" sid="EXO 12:9" />से सिर, पैर, ओर आंतड़िया साथे आगी रे पूजी की खाणा, काच्चा या पाणिए बीचे कुछ बी पकाई की नि खाणा। <verse eid="EXO 12:9" /><verse number="10" style="v" sid="EXO 12:10" />तेते बीचा ते प्यागा खे कुछ नि राखणा ओर जे प्यागा खे कुछ बची बी जाओ, तो से आगी बीचे फूकी देणा। <verse eid="EXO 12:10" /><verse number="11" style="v" sid="EXO 12:11" />ओर तिजी खे खाणे रा तरीका ये ए कि लक बानी की, पैरो रे जोड़े पईनी की ओर आथो रे सोठी लई की से फटाफट खाणा; से तो यहोवे रा फसह रा त्योआर ऊणा। <verse eid="EXO 12:11" /><verse number="12" style="v" sid="EXO 12:12" />कऊँकि तेसा राती रे मां मिस्र देशो रे बिछिए ऊई की जाणा ओर मिस्र देशो रे माणूं, डांगर, सबी रे जेठे बच्चे मारने ओर मिस्रो रे सारे देवतेया खे बी मां सजा देणी; कऊँकि आऊँ यहोवा ए। <verse eid="EXO 12:12" /><verse number="13" style="v" sid="EXO 12:13" />ओर जिना कअरा रे तुसे रणे तिना पाँदे से खून तुसा रिया तँईं चिह्न ठईरना; मतलब मां से खून देखी की तुसे छाडी देणे ओर जेबे मां मिस्र देशो रे माणूं मारने, तेबे से मुसीबत तुसा पाँदे नि पड़नी ओर तुसे खत्म नि ऊणे। <verse eid="EXO 12:13" /><verse number="14" style="v" sid="EXO 12:14" />ओर से दिन तुसा खे याद दलाणे वाल़ा दिन ऊणा, तुसे से यहोवे खे त्योआर करी की मनाणा; ओर से दिन तुसा री पीढ़िया खे सदा री रवाज जाणी की त्योआर मानेया जाओ।<verse eid="EXO 12:14" /></para>
  <para style="s">बिना सजेड़े री रोटी</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 12:15" />“साता दिना तक बिना सजेड़े रिया रोटिया खाया करनिया, तिना बीचा ते पईले दिने आपणे-आपणे कअरो ते सजेड़ा चकी देणा, बल्कि जो पईले दिनो ते लई की सातुए दिनो तक कोई सजेड़ी रोटी खाओ, से माणूं इस्राएलिया बीचा ते निकाल़ेया जाओ। <verse eid="EXO 12:15" /><verse number="16" style="v" sid="EXO 12:16" />त्योआरो रे पईले दिने यहोवे री आराधना खे एक पवित्र सभा ओर सातुए दिने बी एक पवित्र सभा करनी ओर तिना दुँईं दिना रे कोई काम नि करना, सिर्फ माणूंआ खे रोटी बणाओ बस इतना ई काम करी सकोए। <verse eid="EXO 12:16" /><verse number="17" style="v" sid="EXO 12:17" />इजी रिया तँईं तुसे बिना सजेड़े रिया रोटिया रा त्योआर मानणा, कऊँकि तेस ई दिने मानो मैं तुसे चूण्ड-चूण्ड करी की मिस्र देशो ते निकयाल़ी राखे, इजी बजअ ते से दिन तुसा रिया पीढ़िया रे सदा री रवाज जाणी की मानेया जाओ। <verse eid="EXO 12:17" /><verse number="18" style="v" sid="EXO 12:18" />पईले मीन्ने रे चौदुए दिनो री साँजा ते लई की इक्खिये दिनो री साँजा तक तुसे बिना सजेड़े रिया रोटिया खाया करनिया। <verse eid="EXO 12:18" /><verse number="19" style="v" sid="EXO 12:19" />साता दिना तक तुसा रे कअरे कुछ बी सजेड़ा ना रओ, बल्कि जो कोई बी सजेड़ी रोटी खाओगा, चाए से देसी ओ चाए परदेशी, से माणूं इस्राएलिया री मण्डल़िया ते निकाल़ेया जाणा। <verse eid="EXO 12:19" /><verse number="20" style="v" sid="EXO 12:20" />कोई सजेड़ी चीज नि खाणी; सबी आपणे कअरे बिना सजेड़े रिया रोटिया खाया करनिया।”<verse eid="EXO 12:20" /></para>
  <para style="s">पईला फसह रा त्योआर</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 12:21" />तेबे मूसे इस्राएलिया रे सब स्याणेया खे बुलाई की बोलेया, “तुसे आपणे कुला रे मुताबिक एक-एक मिन्टू तिना रे चूण्डो बीचा ते लग करी की राखी देओ ओर फसह रे दिने से बलि करना <verse eid="EXO 12:21" /><verse number="22" style="v" sid="EXO 12:22" />ओर तेसरा खून जो तसले बीचे ऊणा, तिदे जूबा रा एक गुच्छा डबोई की तेसी तसले रे खूने की द्धारो री चौखटा रे सिरे पाँदे ओर दुँईं तरफा री साखा पाँदे कुछ लगाणा; ओर प्यागा तक तुसा बीचा ते कोई बी कअरो ते बारे नि निकल़ो। <verse eid="EXO 12:22" /><verse number="23" style="v" sid="EXO 12:23" />कऊँकि यहोवा देशो रे बीचे ऊई की मिस्रिया खे मारदा ऊआ जाणा; मतलब जेती-जेती से चौखटा रे सिरे ओर दुँईं तरफा री साखा पाँदे खून देखोगा, तेती-तेती तेस से द्धार छाडी देणा ओर खत्म करने वाल़े तुसा रे कअरे मारने खे जाणे नि देणे। <verse eid="EXO 12:23" /><verse number="24" style="v" sid="EXO 12:24" />तेबे तुसे ये बिदी आपू खे ओर आपणे वंशो खे सदा री रवाज जाणी की मानेया करनी। <verse eid="EXO 12:24" /><verse number="25" style="v" sid="EXO 12:25" />जेबे तुसे तेस देशो दे जो यहोवे आपणे कईणे रे मुताबिक तुसा खे देणा, तेबे तुसे तिदे जांदे बखते एसा रवाजा खे मनाया करेयो। <verse eid="EXO 12:25" /><verse number="26" style="v" sid="EXO 12:26" />ओर जेबे तुसा रे बाल-बच्चे तुसा ते पूछो, ‘एते त्योआरो रा क्या मतलब ए?’ <verse eid="EXO 12:26" /><verse number="27" style="v" sid="EXO 12:27" />तेबे तुसे तिना खे ये जबाब देणा, यहोवे जो मिस्रिया खे काणे रे बखते मिस्रो रे रणे वाल़े आसा इस्राएलिया रे कअरो खे छाडी की आसा रे कअर बचाए, इजी बजअ ते यहोवे री महिमा खे फसह रा ये बलिदान कित्तेया जाओआ।” तेबे लोके चूकी की माथा तेकेया। <verse eid="EXO 12:27" /><verse number="28" style="v" sid="EXO 12:28" />तेबे जो आज्ञा यहोवे मूसे ओर हारूणो खे दित्ती थी, इस्राएलिये जाई की तेड़ा ई कित्तेया।<verse eid="EXO 12:28" /></para>
  <para style="s">दसी मुसीबत–जेठे बच्चेया री मौत</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 12:29" />एड़ा ऊआ कि आदिया राती यहोवे मिस्र देशो रिया राजगद्दिया पाँदे बैठणे वाल़े फिरौनो ते लई की, जेला रे पड़े रे बंदुआ तक, सबी रे पईले बच्चे, बल्कि डांगरा तको रे सबी रे पईले बच्चे काई ते।<verse eid="EXO 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 12:30" />ओर फिरौन राती ई उठी की बैठेया ओर तेसरे सब काम करने वाल़े, बल्कि सारे मिस्री उठे ओर मिस्रो रे बऊत पारी आल्ला-गोला ऊणे लगेया, कऊँकि एक बी एड़ा कअर नि था जिदे कोई मरेया नि ओ। <verse eid="EXO 12:30" /><verse number="31" style="v" sid="EXO 12:31" />तेबे फिरौने राती ई राती मूसा ओर हारूणो खे बुलाई की बोलेया, “तुसे इस्राएलिया समेत मेरेया लोका बीचा ते निकल़ी जाओ ओर आपणे कईणे रे मुताबिक जाई की यहोवे री पूजा करो। <verse eid="EXO 12:31" /><verse number="32" style="v" sid="EXO 12:32" />आपणे कईणे रे मुताबिक आपणी पेडा-बाकरिया ओर गाय-बल़दा खे साथे लई जाओ ओर माखे बी आशीर्वाद देई की जाओ।” <verse eid="EXO 12:32" /><verse number="33" style="v" sid="EXO 12:33" />ओर मिस्री लोके इस्राएली लोका पाँदे दबाओ पाई की बोलेया, “एते देशो ते फटाफट निकल़ी जाओ।” नई तो आसे सब मरी जाणे। <verse eid="EXO 12:33" /><verse number="34" style="v" sid="EXO 12:34" />तेबे तिने आपणा गूँदा-गूँदाया रा आटा बिना सजेड़े रा ई पण्डारो समेत टाल्लेया रे बानी की आपणियां-आपणियां कांदा पाँदे पाईता। <verse eid="EXO 12:34" /><verse number="35" style="v" sid="EXO 12:35" />इस्राएलिये मूसे रे कईणे रे मुताबिक मिस्रिया ते सूईने-चाँदिए रे गईणे ओर टाल्ले मांगी ले। <verse eid="EXO 12:35" /><verse number="36" style="v" sid="EXO 12:36" />ओर यहोवे मिस्री लोक आपणियां प्रजा पाँदे एड़े दयावान बणाए कि तिने जो-जो मांगेया से सब तिना खे दित्तेया। ईंयाँ इस्राएलिये मिस्री लूटी ले।<verse eid="EXO 12:36" /></para>
  <para style="s">इस्राएलिया रा मिस्र देश छाडणा</para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 12:37" />तेबे इस्राएली लोक रामसेस शईरो ते चली की सुक्कोत शईरो खे चले ओर बाल-बच्चेया खे छाडी की सेयो कोई 6 लाख पैदल चलणे वाल़े मर्द थे। <verse eid="EXO 12:37" /><verse number="38" style="v" sid="EXO 12:38" />तिना साथे मिली-जुली एक पीड़ गयी ओर पेडा-बाकरिया, गाय-बल़द बऊत सारे डांगर बी साथे गये। <verse eid="EXO 12:38" /><verse number="39" style="v" sid="EXO 12:39" />ओर जो गूँनेया रा आटा सेयो मिस्रो ते साथे लईगे तिजी रिया तिने बिना सजेड़े रिया रोटिया बणाईया, कऊँकि सेयो मिस्रो ते एड़े जबरदस्ती निकयाल़े कि तिना खे मोका नि मिलेया कि बाटा खे कुछ खाणे खे पकाई सको, इजी बजअ ते से गूँदेया रा आटा बिना सजेड़े रा था। <verse eid="EXO 12:39" /><verse number="40" style="v" sid="EXO 12:40" />मिस्रो रे बसे रे इस्राएलिया खे 430 साल ऊईगे थे। <verse eid="EXO 12:40" /><verse number="41" style="v" sid="EXO 12:41" />तिना 430 साला रे बीतणे पाँदे, ठीक तेसी ई दिने, यहोवे री सारी प्रजा मिस्र देशो ते निकल़ी गी। <verse eid="EXO 12:41" /><verse number="42" style="v" sid="EXO 12:42" />यहोवा इस्राएलिया खे मिस्र देशो ते निकयाल़ी की ली आया, इजी बजअ ते से रात, यहोवे री महिमा खे मानणे जोगी ए; ये यहोवे री सेई रात ए, जेतेरा पीढ़िया-पीढ़िया तक मानणा इस्राएलिया खे बऊत जरूरी ए।<verse eid="EXO 12:42" /></para>
  <para style="s">फसह रे त्योआरो री बिधि</para>
  <para style="p">
    <verse number="43" style="v" sid="EXO 12:43" />तेबे यहोवे मूसा ओर हारूणो खे बोलेया, “फसह रे त्योआरो री बिधि ये ए; कोई परदेशी तिजी ते नि खाओ; <verse eid="EXO 12:43" /><verse number="44" style="v" sid="EXO 12:44" />पर जो केसी रा मोलो रा दास ए ओर तुसे तेसरा खतना करी राखेया ओ, से तो तिजी बीचा ते खाई सकोआ। <verse eid="EXO 12:44" /><verse number="45" style="v" sid="EXO 12:45" />पर परदेशी ओर मजदूर तिजी बीचा ते नि खाओ। <verse eid="EXO 12:45" /><verse number="46" style="v" sid="EXO 12:46" />तेसरा खाणा एक ई कअरो रे ओ; मतलब तुसे तिजी रे मासो बीचा ते कुछ बी बारे नि निणा ओर बलिया रे डांगरो री कोई बी आड्डी नि तोड़नी। <verse eid="EXO 12:46" /><verse number="47" style="v" sid="EXO 12:47" />फसह रा त्योआरो खे मानणा इस्राएलिया री सारी मण्डल़िया रा फर्ज ए। <verse eid="EXO 12:47" /><verse number="48" style="v" sid="EXO 12:48" />ओर जे कोई परदेशी तुसा साथे रयी की, यहोवे खे फसह रा त्योआर मनाणा चाओ, तो से आपणे कअरो रे सबी मर्दा रा खतना कराओ, तेबे से नेड़े आई की तिजी खे मनाओ ओर से देसी माणूंए जेड़ा ठईरना। पर कोई बिना खतना करे रा माणूं तिजी बीचा ते नि खाओ। <verse eid="EXO 12:48" /><verse number="49" style="v" sid="EXO 12:49" />तिजी रा बिधि-बिधान देसी ओर तुसा बीचे रणे वाल़े परदेशी दुँईं खे एक ई ओ।” <verse eid="EXO 12:49" /><verse number="50" style="v" sid="EXO 12:50" />ये आज्ञा जो यहोवे मूसे ओर हारूणो खे दित्ती तिजी रे मुताबिक सारे इस्राएलिये कित्तेया। <verse eid="EXO 12:50" /><verse number="51" style="v" sid="EXO 12:51" />ओर ठीक तेसी ई दिने यहोवा इस्राएलिया खे मिस्र देशो ते चूण्ड-चूण्ड करी की निकयाल़ी की लईगा।<verse eid="EXO 12:51" /></para>
  <chapter eid="EXO 12" />
  <chapter number="13" style="c" sid="EXO 13" />
  <para style="s">पईले बच्चेया रा चढ़ावा</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 13:1" />तेबे यहोवे मूसे खे बोलेया, <verse eid="EXO 13:1" /><verse number="2" style="v" sid="EXO 13:2" />“तुसे क्या इस्राएली माणूंआ रे ओर क्या डांगरा रे जितणे बी आपणियां-आपणियां माया रे पईले बच्चे नर ओ सेयो माखे पवित्र मानणे; से तो मेरे ईए।”<verse eid="EXO 13:2" /></para>
  <para style="s">बिना सजेड़े री रोटिया रा त्योआर</para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 13:3" />तेबे मूसे माणूंआ खे बोलेया, “ये दिन याद राखो, जिदे तुसे माणूं गुलामिया रे देश, मतलब मिस्रो ते निकल़ी की आयी रे, यहोवा तो तुसा खे तेथा ते आपणे सामर्थी आथा री तागती साथे निकयाल़ी की ल्याया; इदे सजेड़ी रोटी नि खाई जाओ। <verse eid="EXO 13:3" /><verse number="4" style="v" sid="EXO 13:4" />आबीबो रे मीन्ने रे आजके दिनो रे मिस्रो ते तुसे निकल़ी रे। <verse eid="EXO 13:4" /><verse number="5" style="v" sid="EXO 13:5" />इजी री खातर जेबे यहोवा तुसा खे कनानी, हित्ती, एमोरी, हिब्बी ओर यबूसी माणूंआ रे देशो दे जो सच्चो खेई बऊत ई पजणे वाल़ा ए पऊँचाओ, जेतेखे देणे री यहोवे तुसा रे बुजुर्गा ते कसम खाई थी, तेबे तुसे एते मीन्ने रे एस कामो खे याद करदे ऊए ये त्योआर मनाणा। <verse eid="EXO 13:5" /><verse number="6" style="v" sid="EXO 13:6" />साता दिना तक बिना सजेड़े रिया रोटिया खाया करनिया ओर सातुए दिने यहोवे रिया तँईं आदर देणे खे त्योआर मनाणा। <verse eid="EXO 13:6" /><verse number="7" style="v" sid="EXO 13:7" />इना साता दिना रे बिना सजेड़े रिया रोटिया खाया करनिया, मतलब तुसा री पूरी जमीना रे इस्से दे ना सजेड़ी रोटी, ना सजेड़ा तुसा गे देखणे खे आओ। <verse eid="EXO 13:7" /><verse number="8" style="v" sid="EXO 13:8" />ओर तेस दिने तुसे आपणे-आपणे बच्चे ये बोली की समजयाई देणे कि ये तो आसे तेसी कामो री बजअ ते करूँए जो यहोवे आसा रे मिस्रो ते निकल़ी की आऊणे रे बखते आसा खे कित्तेया था। <verse eid="EXO 13:8" /><verse number="9" style="v" sid="EXO 13:9" />फेर ये तुसा खे तुसा रे आथो रे ओर तुसा रे माथे पाँदे तुसा रिया आखी बीचे याद राखणे वाल़ा चिह्न ठईरो; जेते की यहोवे री बिदिया तुसा रे मुंए रे रओ, कऊँकि यहोवे तुसे आपणे तागतबर आथो साथे मिस्रो ते निकयाल़े। <verse eid="EXO 13:9" /><verse number="10" style="v" sid="EXO 13:10" />इजी बजअ ते तुसे ये रवाज हर साल ठराए रे बखतो पाँदे मानेया करनी।”<verse eid="EXO 13:10" /></para>
  <para style="s">पईले बच्चे रे नियम</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 13:11" />फेर जेबे यहोवा तेते कसमा रे मुताबिक, जो तिने तुसा रे बुजुर्गा ते ओर तुसा ते खाई राखी, तुसा खे कनानिया रे देशो रे पऊँचाई की, से तुसा खे देई देओगा। <verse eid="EXO 13:11" /><verse number="12" style="v" sid="EXO 13:12" />तेबे तुसा बीचा ते जितणे आपणी-आपणी माया रे पईले बच्चे ओ, सेयो यहोवे खे चढ़ाणे ओर तुसा रे डांगरा रे पईले नर बच्चे बी यहोवे रेईए। <verse eid="EXO 13:12" /><verse number="13" style="v" sid="EXO 13:13" />गह्दिया रे हर एक पईले बच्चे खे मिन्टू देई की से छुड़ाई लणा ओर जे तुसे तेसखे छुड़ाणा नि चाओ तो तेसरी क्याड़ी तोड़ी देणी। पर आपणे सब जेठे माणूंआ खे बदला देई की छुड़ाई लएओ <verse eid="EXO 13:13" /><verse number="14" style="v" sid="EXO 13:14" />ओर आऊणे वाल़े दिनो रे जेबे तुसा रे पाऊ तुसा ते पूछो कि ये क्या ए? तो तिना खे बोलणा, “यहोवा आसा माणूंआ खे गुलामिया रे मिस्र देशो ते आपणे सामर्थी आथो री तागती साथे निकयाल़ी की ल्याई राखेया। <verse eid="EXO 13:14" /><verse number="15" style="v" sid="EXO 13:15" />तेस बखते जेबे फिरौने सख्त ऊई की आसे पेजणा नि चाए, तेबे यहोवे मिस्र देशो रे माणूंआ ते लई की डांगरा तक सबी रे पईले बच्चे काईते। इजी बजअ ते डांगरा बीचा ते जितणे आपणी माया रे पईले नर बच्चे ए, तिना खे आसे यहोवे खे बलि करूँए, पर आपणे सारे जेठे पाऊ बदला देई की छुड़ाई लऊँए। <verse eid="EXO 13:15" /><verse number="16" style="v" sid="EXO 13:16" />ये तुसा रे आथो रे एक चिह्न ओर तुसा रे माथे पाँदे प्रियूँआ बीचे टीका जा ठईरो; कऊँकि यहोवा आसा लोका खे मिस्रो ते आपणे सामर्थी आथो रिया तागती साथे निकयाल़ी की ल्याया।”<verse eid="EXO 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 13:17" />जेबे फिरौने लोका खे जाणे री आज्ञा देईती, तेबे परमेशर ये सोची की तिना खे पलिश्तिया रे देशो रे ऊई की जाणे वाल़ी बाटा रिये जो नेड़े थी तीसिए नि लईगा कि केथी एड़ा नि ओ कि जेबे यो लोक लड़ाई देखो, तेबे सेयो आपणा मन बदली की मिस्रो खे वापस आई जाओ।<verse eid="EXO 13:17" /></para>
  <para style="s">सुनसाण जगा री बाट</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 13:18" />इजी री खातर परमेशर तिना खे चक्कर लगाई की लाल समुद्रो री तरफा खे सुनसाण जगा रिया बाटा ते लई चलेया। तेबे इस्राएली लोक मिस्रो ते पंग्ति बणाई की सेना जेड़े निकल़ी गे। <verse eid="EXO 13:18" /><verse number="19" style="v" sid="EXO 13:19" />ओर मूसा यूसुफो री आड्डिया खे साथे ली आया, कऊँकि यूसुफे इस्राएलिया खे ये बोली की कि परमेशरो पक्का तुसा री सम्बाल़ लणी, तिना खे इजी रे बारे दे पक्की कसम खुल़ाई थी कि सेयो तेसरी आड्डिया खे आपू साथे एथा ते लई जाओगे। <verse eid="EXO 13:19" /><verse number="20" style="v" sid="EXO 13:20" />तेबे तिने सुक्कोतो ते चली की सुनसाण जगा रे कनारे पाँदे एताम नाओं री जगा रे डेरा कित्तेया।<verse eid="EXO 13:20" /></para>
  <para style="s">बादल़ो रा खम्बा ओर आगी रा खम्बा</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 13:21" />ओर यहोवे तिना खे दिनो खे बाट दखाणे खे बादल़ो रे खम्बे रे ओर राती प्रयासा देणे खे आगी रे खम्बे रे ऊई की तिना ते आगे-आगे चलेया करो था, ताकि सेयो रात ओर दिन दुँईं बखते चली सको। <verse eid="EXO 13:21" /><verse number="22" style="v" sid="EXO 13:22" />तिने ना तो बादल़ो रा खम्बा दिने ओर ना आगी रा खम्बा राती लोका रे आगे-आगे जाणे ते टाया।<verse eid="EXO 13:22" /></para>
  <chapter eid="EXO 13" />
  <chapter number="14" style="c" sid="EXO 14" />
  <para style="s">इस्राएलिया रा लाल समुद्र पार करना</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 14:1" />यहोवे मूसे खे बोलेया, <verse eid="EXO 14:1" /><verse number="2" style="v" sid="EXO 14:2" />“इस्राएलिया खे आज्ञा दे कि सेयो वापस ऊई की मिग्दोल शईर ओर समुद्रो बीचे पीहहीरोत शईरो रे सामणे, बालसपोनो रे सामणे आपणे डेरे खड़े करो, तुसे समुद्रो रे कनारे पाँदे आपणे डेरे खड़े करो। <verse eid="EXO 14:2" /><verse number="3" style="v" sid="EXO 14:3" />तेबे फिरौनो इस्राएलिया रे बारे दे सोचणा कि सेयो अणजाण देशो रे पटकी की कबराई गे रे ओर सुनसाण जगा रे फसी गे रे। <verse eid="EXO 14:3" /><verse number="4" style="v" sid="EXO 14:4" />तेबे मां फिरौनो रा मन काठा करी देणा ओर तेस तिना रा पीछा करना, तेबे फिरौन ओर तेसरी सारी सेना रे जरीये मेरी महिमा ऊणी ओर मिस्र देशो रे लोका जाणी लणा कि आऊँ ई एक सच्चा यहोवा ए।” तेबे तिने तेड़ा ई कित्तेया।<verse eid="EXO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 14:5" />जेबे मिस्रो रे राजे खे ये समाचार मिलेया कि सेयो निकल़ी गे रे, तेबे फिरौन ओर तेसरे काम करने वाल़ेया रा मन बदली की तिना रे खलाफ ऊईगा ओर सेयो एकी दूजे ते बोलणे लगे, “आसे ये क्या कित्तेया कि इस्राएलिया खे आपणी गुलामिया ते छुटकारा देई की सेयो जाणे दित्ते?” <verse eid="EXO 14:5" /><verse number="6" style="v" sid="EXO 14:6" />तेबे तिने आपणा रथ त्यार करवाया ओर आपणी सेना साथे लई। <verse eid="EXO 14:6" /><verse number="7" style="v" sid="EXO 14:7" />तिने ओरी रथा साथे 600 मिस्रो रे अच्छे ते अच्छे रथ लये ओर तिना सबी पाँदे सरदार बठयाल़ी की चली पड़ेया। <verse eid="EXO 14:7" /><verse number="8" style="v" sid="EXO 14:8" />ओर यहोवे मिस्रो रे राजा फिरौनो रा मन काठा करी ता। इजी रिया तँईं तिने इस्राएलिया रा पीछा कित्तेया; पर इस्राएली इम्मती साथे निकल़ी की जाणे लगी रे थे। <verse eid="EXO 14:8" /><verse number="9" style="v" sid="EXO 14:9" />पर फिरौनो रे सारे कोड़े, रथ ओर सवारा समेत मिस्री सेना इस्राएली लोका रा पीछा करी की तिना गे पीहहीरोतो गे पऊँची गे, जिने बालसपोनो रे सामणे समुद्रो रे कनारे आपणा डेरा लगाई राखेया था।<verse eid="EXO 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 14:10" />जेबे इस्राएली लोके देखेया कि फिरौन नेड़े आईगा ओर तेस पीछे मिस्री लोक म्हारा पीछा करने खे आऊणे लगी रे; तेबे सेयो बऊत जादा डरी गे ओर तड़फदे ऊए की यहोवे ते मतादा रिया तँईं अर्ज करने लगे। <verse eid="EXO 14:10" /><verse number="11" style="v" sid="EXO 14:11" />फेर सेयो मूसे खे बोलणे लगे, “क्या मिस्रो रे कब्रा री कमी थी, जो तूँ आसा खे तेथा ते मरने खे सुनसाण जगा रे ली आयी रा? तूँ आसा खे मिस्रो ते निकयाल़ी की कऊँ ली आया? <verse eid="EXO 14:11" /><verse number="12" style="v" sid="EXO 14:12" />क्या आसे मिस्रो रे तांते येई गल्ल नि करदे रये कि आसा खे रणी दे ताकि आसे मिस्रिया री सेवा करुँ? आसा खे सुनसाण जगा रे मरने ते मिस्रिया री सेवा करनी अच्छी थी।”<verse eid="EXO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 14:13" />तेबे मूसे लोका खे बोलेया, “डरो नि, खड़े रओ ओर से उद्धारो रा काम देखो, जो यहोवे तुसा खे आज करना, कऊँकि जिना मिस्रिया खे तुसे आज देखणे लगी रे, सेयो फेर कदी नि देखणे। <verse eid="EXO 14:13" /><verse number="14" style="v" sid="EXO 14:14" />यहोवा आपू ई तुसा रिया तँईं लड़ना, इजी री खातर तुसे चुपचाप रओ।”<verse eid="EXO 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 14:15" />तेबे परमेशरे मूसे खे बोलेया, “तूँ कऊँ मेरे सामणे रोणे लगी रा? इस्राएलिया खे आज्ञा दे कि आपणा चीखणा-चिल्लाणा बन्द करो ओर एथा ते आपणा डेरा चकी की चली पड़ो। <verse eid="EXO 14:15" /><verse number="16" style="v" sid="EXO 14:16" />ओर तूँ आपणे आथो रे सोठी चकी की समुद्रो री तरफा खे बढ़ा ताकि तिजी रे दो पाअग ऊई जाओ ओर इस्राएली लोक समुद्रो बीचे ऊई की सूकिया जमीना पाँदे चली सको। <verse eid="EXO 14:16" /><verse number="17" style="v" sid="EXO 14:17" />ओर सुण, आऊँ आपू मिस्रिया रा मन टीठ करूँआ ओर सेयो तिना रा पीछा करने खे समुद्रो रे कूसी जाणे, तेबे फिरौन, तेसरी सेना, तेसरे रथ ओर सवारा रे जरीये मेरी महिमा ऊणी। <verse eid="EXO 14:17" /><verse number="18" style="v" sid="EXO 14:18" />ओर जेबे फिरौन, तेसरे रथ ओर तेसरे सवारा रे जरीये मेरी महिमा ऊणी, तेबे मिस्रिया जाणी लणा कि आऊँ ई यहोवा ए।”<verse eid="EXO 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 14:19" />तेबे परमेशरो रा दूत जो इस्राएली सेना ते आगे-आगे चलेया करो था से जाई की तिना पीछे खड़ा ऊईगा ओर तिंयाँ ई बादल़ो रा खम्बा तिना रे आगे ते अटी की तिना पीछे जाई की ठईरी गा। <verse eid="EXO 14:19" /><verse number="20" style="v" sid="EXO 14:20" />ईंयाँ से मिस्री सेना ओर इस्राएली सेना बीचे आईगा ओर से बादल़ पुरिया राती एकी तरफा खे न्हेरा ओर दूजिया तरफा खे प्रयासा देंदा रया; इजी खे सेयो पुरिया राती एकी-दूजे गे नि जाई सके।<verse eid="EXO 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 14:21" />तेबे मूसे आपणा आथ समुद्रो पाँदे बढ़ाया ओर यहोवे पूरी रात प्रचण्ड पूर्वी अवा चलाई ओर समुद्रो रे दो पाअग करी की पाणी एड़ा टाईता, जेते की तिजी बीचे सूकी जमीन ऊईगी। <verse eid="EXO 14:21" /><verse number="22" style="v" sid="EXO 14:22" />तेबे इस्राएली लोक समुद्रो बीचे सुकी जमीना दे चले ओर पाणी तिना रे दाँणे ओर खूँजी तरफा खे दवाला जेड़ा बणी की खड़ी रा था।<verse eid="EXO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 14:23" />तेबे मिस्री, मतलब फिरौनो रे सारे कोड़े, रथ ओर सवार तिना रा पीछा करदे ऊए समुद्रो बीचे चली गे।<verse eid="EXO 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 14:24" />ओर राती रे आखरी पईरो रे यहोवे आगी ओर बादल़ो रे खम्बे बीचा ते मिस्रिया री सेना खे देखी की सेयो डराईते। <verse eid="EXO 14:24" /><verse number="25" style="v" sid="EXO 14:25" />ओर तिने तिना रे रथो रे पहिये निकयाल़ी ते, जेते की तिना रा चलणा कठण ऊईगा; तेबे मिस्री आपू बीचे बोलणे लगे, “आओ, आसे इस्राएलिया सामणे ते नठी जाऊँए, कऊँकि यहोवा तिना रिया तँईं आसा मिस्रिया रे खलाफ लड़ने लगी रा।”<verse eid="EXO 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 14:26" />तेबे यहोवे मूसे खे बोलेया, “आपणा आथ समुद्रो पाँदे बढ़ा, ताकि पाणी मिस्रिया पाँदे, तिना रे रथो पाँदे ओर सवारा पाँदे फेर बह्यीणे लगो।”<verse eid="EXO 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 14:27" />तेबे मूसे आपणा आथ समुद्रो पाँदे बढ़ाया ओर प्याग ऊँदे-ऊँदे ई समुद्र जिंयाँ का तिंयाँ आईगा ओर मिस्री उल्टे नठणे लगे, पर यहोवे सेयो समुद्रो बीचे ई हड़ाई ते। <verse eid="EXO 14:27" /><verse number="28" style="v" sid="EXO 14:28" />ओर पाणिए रे पलटणे ते जितणे रथ ओर सवार इस्राएलिया पीछे आए थे, सेयो सब बल्कि मिस्रो<note caller="+" style="f"><char style="fr" closed="false">14:28 </char><char style="fq" closed="false">मिस्रो </char><char style="ft" closed="false">फिरौन</char></note> री सारी सेना तिदे डूबी गी ओर तिना बीचा ते एक पनि बचेया। <verse eid="EXO 14:28" /><verse number="29" style="v" sid="EXO 14:29" />पर इस्राएली समुद्रो बीचे सूकिया जमीना दे ऊई की चली गे ओर पाणी तिना रे दाँणे ओर खूँजे कनारे दवाला जेड़ा खड़ेया रा रया।<verse eid="EXO 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 14:30" />ईंयाँ यहोवे तेस दिने इस्राएली मिस्रिया रे वशो ते छुड़ाए ओर इस्राएलिये मिस्री समुद्रो रे कनारे मरे रे देखे। <verse eid="EXO 14:30" /><verse number="31" style="v" sid="EXO 14:31" />ओर जेबे इस्राएलिये मिस्रिया रे खलाफ यहोवे री महान सामर्था रा काम देखेया; तेबे तिने यहोवे रा डर मानेया ओर यहोवा ओर तेसरे दास मूसे पाँदे विश्वास कित्तेया।<verse eid="EXO 14:31" /></para>
  <chapter eid="EXO 14" />
  <chapter number="15" style="c" sid="EXO 15" />
  <para style="s">मूसे रा जीतणे रा गीत</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 15:1" />मिस्रो रे लोका रा समुद्रो रे डूबणे ते बाद मूसे ओर इस्राएली लोके यहोवे खे ये गीत गाया। तिने बोलेया,</para>
  <para style="q" vid="EXO 15:1">“मां यहोवे रिया तँईं गीत गाणा,</para>
  <para style="q" vid="EXO 15:1">कऊँकि तिने नऊखे तरीके ते जीत पाई राखी;</para>
  <para style="q" vid="EXO 15:1">तिने कोड़ेया समेत सवार समुद्रो रे पाईते रे।<verse eid="EXO 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="EXO 15:2" />यहोवा मेरी तागत ओर सामर्थ ए,</para>
  <para style="q" vid="EXO 15:2">सेई माखे बचाणे वाल़ा ए,</para>
  <para style="q" vid="EXO 15:2">मेरा परमेशर सेईए,</para>
  <para style="q" vid="EXO 15:2">मां तेसरी तारीफ करनी,</para>
  <para style="q" vid="EXO 15:2">मेरे बुजुर्गो रा परमेशर सेईए,</para>
  <para style="q" vid="EXO 15:2">मां तेसरी सराईणा करनी।<verse eid="EXO 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="EXO 15:3" />यहोवा सेई योद्धा ए जिने आँऊ</para>
  <para style="q" vid="EXO 15:3">मिस्रिया ते बचाया;</para>
  <para style="q" vid="EXO 15:3">तेसरा नाओं यहोवा ए।<verse eid="EXO 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="EXO 15:4" />फिरौनो रे रथ ओर तेसरी सेना यहोवे समुद्रो रे डबोई ती;</para>
  <para style="q" vid="EXO 15:4">ओर तेसरे खरे ते खरे रथी लाल समुद्रो रे डूबी गे।<verse eid="EXO 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="EXO 15:5" />डूगे पाणिए सेयो टखी ते;</para>
  <para style="q" vid="EXO 15:5">सेयो पात्थरो जेड़े डूगे पाणिए रे डूबदे ऊए चलीगे।<verse eid="EXO 15:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="EXO 15:6" />ओ यहोवा, तेरा दाँणा आथ तागता रे महान ए,</para>
  <para style="q" vid="EXO 15:6">ओ यहोवा, तेरा दाँणा आथ दुश्मणा खे चकनाचूर करी देओआ।<verse eid="EXO 15:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="EXO 15:7" />तूँ आपणे बरोदिया खे, आपणी महानता री सामर्था ते रूड़ाई देया,</para>
  <para style="q" vid="EXO 15:7">तैं आपणा कोप पड़काया ओर सेयो पूओ जेड़े स्वा ऊई जाओए।<verse eid="EXO 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="EXO 15:8" />तेरे गुस्से रे परे नासा रे साओ ते पाणी कट्ठा ऊईगा,</para>
  <para style="q" vid="EXO 15:8">ओर पाणिए री ताअरा दवाला जेड़िया एखी जगा खड़ी गिया,</para>
  <para style="q" vid="EXO 15:8">ओर समुद्रो बीचे डूगा पाणी जम्मी गा।<verse eid="EXO 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="EXO 15:9" />दुश्मणे बोलेया था कि</para>
  <para style="q" vid="EXO 15:9">मां पीछा करना, मां जाई की पकड़ने,</para>
  <para style="q" vid="EXO 15:9">मां तिना रा माल लूटी की बांडी लणा,</para>
  <para style="q" vid="EXO 15:9">तिना साथे मेरा जिऊ परी जाणा,</para>
  <para style="q" vid="EXO 15:9">मां आपणी तलवार खींजी की सेयो नाश करी देणे।<verse eid="EXO 15:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="EXO 15:10" />पर तैं आपणे साओ री अवा चलाई, तेबे समुद्रे सेयो डबोई ते,</para>
  <para style="q" vid="EXO 15:10">सेयो समुद्रो रे शीशे जेड़े डूबी गे।<verse eid="EXO 15:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="EXO 15:11" />ओ यहोवा, कोई बी देवता तेरे बराबर निए;</para>
  <para style="q" vid="EXO 15:11">तूँ तो पवित्रता रिया बजअ ते महिमा ते परेया रा</para>
  <para style="q" vid="EXO 15:11">ओर आपणी स्तुति करने वाल़ेया खे डरो जोगा;</para>
  <para style="q" vid="EXO 15:11">ओर अचम्बे रे काम करने वाल़ा ए।<verse eid="EXO 15:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="EXO 15:12" />तैं आपणा दाँणा आथ बढ़ाया,</para>
  <para style="q" vid="EXO 15:12">ओर तरतिये आसा रे दुश्मण निगल़ी ले।<verse eid="EXO 15:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="EXO 15:13" />आपणी करूणा साथे तैं आपणी छुड़ाई री प्रजा री अगुवाई करी राखी,</para>
  <para style="q" vid="EXO 15:13">आपणियां तागती ते तूँ तेसा खे आपणे पवित्र रणे री जगा रे लई चली रा।<verse eid="EXO 15:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="EXO 15:14" />देशो-देशो री जातिया रे लोक ये गल्ल सुणी की थरथराईगे;</para>
  <para style="q" vid="EXO 15:14">पलिश्ती देशो रे रणे वाल़े लोका खे जमणे री जी पीड़ा ऊणे लगिया।<verse eid="EXO 15:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="EXO 15:15" />एदोमो रे परदान बेचैन ऊणे,</para>
  <para style="q" vid="EXO 15:15">मोआब देशो रे पईलवाण<note caller="+" style="f"><char style="fr" closed="false">15:15 </char><char style="fq" closed="false">पईलवाण </char><char style="ft" closed="false">मोआब देशो रे अगुवे बड़े डील-डौल ओर तागतबर थे</char></note> थरथराणे,</para>
  <para style="q" vid="EXO 15:15">सब कनान देशो रे लोका रे दिल डरो रे मारे टूटी जाणे।<verse eid="EXO 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="EXO 15:16" />ओ यहोवा, जदुओ तक तेरी प्रजा रे लोक जो तैं मोले लई राखे,</para>
  <para style="q" vid="EXO 15:16">कनान देशो तक पार नि निकल़ी गे,</para>
  <para style="q" vid="EXO 15:16">तदुओ तक तिना रे पीतरे डर बणेया रा रया;</para>
  <para style="q" vid="EXO 15:16">तेरे आथो रिया सामर्था ते सेयो पात्थरो जेड़े गूँगे बणे रे रये।<verse eid="EXO 15:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="EXO 15:17" />ओ यहोवा, तां सेयो आपणे तेस पाह्ड़ो पाँदे, आपणी तेसा जगा पाँदे,</para>
  <para style="q" vid="EXO 15:17">जो तैं आपणे रणे खे बणाई राखी पऊँचाई देणे।</para>
  <para style="q" vid="EXO 15:17">ओ यहोवा, ये सेई पवित्र जगा ए,</para>
  <para style="q" vid="EXO 15:17">जो तैं आपणे आथे की बणाई राखी।<verse eid="EXO 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="EXO 15:18" />यहोवा सदा सर्वदा राज करदे रणा।”<verse eid="EXO 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 15:19" />जेबे फिरौनो रे कोड़े, रथ ओर सवारा समेत समुद्रो बीचे चलीगे तेबे यहोवे तिना पाँदे समुद्रो रा पाणी वापस ल्याई ता; पर इस्राएली लोक समुद्रो बीचे सुकी जमीना पाँदे ऊई की चलीगे। इजी खे तिने ये गीत गायी राखेया।<verse eid="EXO 15:19" /></para>
  <para style="s">मरियमा रा जीतणे रा गीत</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 15:20" />तेबे हारूणो री बईण मरियम नाओं री नबिया<note caller="+" style="f"><char style="fr" closed="false">15:20 </char><char style="fq" closed="false">नबिया </char><char style="ft" closed="false">एते रा मतलब ये ए कि परमेशरो री सामर्था ते पवित्र आत्मा रे जरीये आऊणे वाल़े बखतो रे बारे दे बताणा</char></note>, तेसे आथो रे खंजरी लई ओर सब जवाणसा आथो रे खंजरी लई की नाचदिया ऊईया तेसा पीछे चली पड़िया।<verse eid="EXO 15:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="EXO 15:21" />ओर मरियम तिना साथे ये गांदी गई,</para>
  <para style="q" vid="EXO 15:21">“यहोवे रिया तँईं गीत गाओ, कऊँकि से सामर्थी ए;</para>
  <para style="q" vid="EXO 15:21">कोड़ेया समेत तिने सवार समुद्रो रे डबोई ते।”<verse eid="EXO 15:21" /></para>
  <para style="s">कड़ुए पाणिए खे मीठा करना</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 15:22" />तेबे मूसा इस्राएलिया खे लाल समुद्रो ते आगे शूर नाओं री सुनसाण जगा रे लईगा ओर तिंऊँ दिना तक सुनसाण जगा रे चलदे ऊए तिना खे पाणिए री सूबल़ नि मिली।<verse eid="EXO 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 15:23" />जेबे सेयो मारा नाओं री एकी जगा रे पऊँचे, तेबे सेयो तेथो रा पाणी पी नि सके कऊँकि से पाणी कड़ुआ था, इजी बजअ ते तेथो रा नाओं “मारा” पड़ेया। <verse eid="EXO 15:23" /><verse number="24" style="v" sid="EXO 15:24" />तेबे इस्राएली लोक ये बोली की मूसे रे खलाफ बकबक करने लगे, “आसे क्या पियूँ?”<verse eid="EXO 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 15:25" />तेबे मूसे यहोवा पुकारेया ओर यहोवे तेसखे एक लकड़िया रा टुकड़ा बताया। जेबे तिने से पाणिए दे पाया तेबे से पाणी मीठा ऊईगा। तेथी यहोवे तिना खे एक बिदी-बिधान बणाया ओर तेथी तिने ये बोली की तिना री परीक्षा लई कि, <verse eid="EXO 15:25" /><verse number="26" style="v" sid="EXO 15:26" />“जे तूँ आपणे परमेशर यहोवे रा वचन तन मनो ते सुणे ओर जो तेसरी नजरा रे ठीक ए, सेई करे, तेसरी आज्ञा पाँदे त्यान देओ ओर तेसरी सब बिदिया खे माने, तो जितणे रोग मैं मिस्रिया पाँदे पेजे, तिना बीचा ते एक बी तां पाँदे नि पेजणा, कऊँकि आऊँ तुसा खे चंगा करने वाल़ा यहोवा ए।” <verse eid="EXO 15:26" /><verse number="27" style="v" sid="EXO 15:27" />तेबे सेयो एलीम नाओं री जगा रे आए, जेती पाणिए रिया बारा सूबल़ा ओर सत्तर खजूरा रे डाल़ थे ओर तेती तिने पाणिए रे नेड़े डेरे खड़े कित्ते।<verse eid="EXO 15:27" /></para>
  <chapter eid="EXO 15" />
  <chapter number="16" style="c" sid="EXO 16" />
  <para style="s">मन्ना ओर तित्तर</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 16:1" />फेर इस्राएलिया री सारी मण्डल़ी एलीम देशो ते आपणा डेरा चकी की सीन नाओं री सुनसाण जगा रे पऊँचे जो एलीम नाओं री जगा ओर सीनै पाह्ड़ो रे बीचे ए। सेयो तेती मिस्र देशो ते निकल़ने ते बाद, दूजे मीन्ने रे पंद्रुए दिने पऊँचे। <verse eid="EXO 16:1" /><verse number="2" style="v" sid="EXO 16:2" />सुनसाण जगा रे इस्राएलिया री सारी मण्डल़ी मूसा ओर हारूणो रे खलाफ बकबक करने लगी। <verse eid="EXO 16:2" /><verse number="3" style="v" sid="EXO 16:3" />ओर इस्राएली तिना खे बोलणे लगे, “जेबे आसे मिस्र देशो रे मासो री आँडिया गे बैठी की मनमाना खाणा खाऊँ थे, तेबे जे आसे यहोवे रे आथो ते मारे बी जांदे, तो खरा सेई था, पर तुसे आसे एती सुनसाण जगा रे पूखा मारने खे ल्याई राखे।”<verse eid="EXO 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 16:4" />तेबे यहोवे मूसे खे बोलेया, “देखो, मां सर्गो ते तुसा खे खाणे री चीज बरसाणी ओर इना लोका हर रोज बारे जाई की हर एक दिनो खे जरूरता रे मुताबिक खाणे खे कट्ठा करना, ईंयाँ मां तिना री परीक्षा करनी कि यो मेरे बिदिया पाँदे चलणे कि नई। <verse eid="EXO 16:4" /><verse number="5" style="v" sid="EXO 16:5" />ओर एड़ा ऊणा चाईयो कि छठे दिने से आपणी खाणे री चीज ओरी दिना ते दुगणी कट्ठी करो ओर से तिजी खे त्यार करी की बी राखो।”<verse eid="EXO 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 16:6" />तेबे मूसे ओर हारूणे सारे इस्राएलिया खे बोलेया, “आज साँजा तक तुसा जाणी लणा कि जो तुसा खे मिस्र देशो ते निकयाल़ी की ल्याई राखेया, से यहोवा ए। <verse eid="EXO 16:6" /><verse number="7" style="v" sid="EXO 16:7" />ओर प्यागा तुसा खे यहोवे रा तेज दिशणा, कऊँकि यहोवे आपणे खलाफ तुसा रा बड़बड़ाणा सुणी ला रा। आसे क्या ए जो तुसे आसा रे खलाफ बड़बड़ाओए?” <verse eid="EXO 16:7" /><verse number="8" style="v" sid="EXO 16:8" />फेर मूसे बोलेया, “ये तेबे ऊणा जेबे साँजा यहोवे तुसा खे खाणे खे मास ओर प्यागा मनमानी रोटी देणी; कऊँकि तुसे जो तेसरे खलाफ बड़बड़ाओए, से तिने सुणी ला रा ओर आसे कुण ए? तुसा रा बड़बड़ाणा आसा रे खलाफ नि पर यहोवे रेई खलाफ ए।” <verse eid="EXO 16:8" /><verse number="9" style="v" sid="EXO 16:9" />तेबे मूसे हारूणो खे बोलेया, “इस्राएलिया री सारी मण्डल़िया खे आज्ञा दे कि यहोवे सामणे बल्कि तेसरे नेड़े आओ, कऊँकि तिने तिना रा बड़बड़ाणा सुणी राखेया।” <verse eid="EXO 16:9" /><verse number="10" style="v" sid="EXO 16:10" />ओर एड़ा ऊआ कि जेबे हारूण इस्राएलिया री सारी मण्डल़िया साथे एड़िया गल्ला करने ई लगी रा था, तेबे तिने सुनसाण जगा री तरफा खे नजर करी की देखेया ओर तिना खे यहोवे रा तेज बादल़ो पाँदे दिशेया।<verse eid="EXO 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 16:11" />तेबे यहोवे मूसे खे बोलेया, <verse eid="EXO 16:11" /><verse number="12" style="v" sid="EXO 16:12" />“इस्राएली लोका रा बड़बड़ाणा मैं सुणी राखेया; इजी खे तूँ तिना खे बोली दे कि सूरज डूबणे रे बखते तुसा मास खाणा ओर प्यागा खे तुसे रोटिया साथे रज्जाए जाणे ओर तुसा खे पता लगी जाणा कि आऊँ तुसा रा परमेशर यहोवा ए।” <verse eid="EXO 16:12" /><verse number="13" style="v" sid="EXO 16:13" />तेबे एड़ा ऊआ कि साँजा खे तितर आईकि सारे डेरेया पाँदे बैठीगे ओर प्यागा डेरे रे चऊँ कनारे पाल़ा पड़ीगा। <verse eid="EXO 16:13" /><verse number="14" style="v" sid="EXO 16:14" />जेबे पाल़ा सूकीगा तेबे तिने देखेया कि सुनसाण जगा री जमीना पाँदे छोटे-छोटे छिलके पाल़े रे टिप्पेया जेड़े पड़ी रे। <verse eid="EXO 16:14" /><verse number="15" style="v" sid="EXO 16:15" />जेबे इस्राएली लोके ये देखेया तो सेयो आपू बीचे एकी दूजे ते बोलणे लगे कि ये क्या चीज ए? कऊँकि सेयो नि जाणो थे कि ये क्या ए? तेबे मूसे तिना खे बोलेया, “ये तो सेई खाणे री चीज ए जो यहोवे तुसा खे खाणे खे देई राखी। <verse eid="EXO 16:15" /><verse number="16" style="v" sid="EXO 16:16" />यहोवे जो आज्ञा देई राखी से ए कि तुसे आपणी जरूरती रे मुताबिक खाणे जोगी कट्ठी करेया करो। आपणे डेरे रे जितणे माणूं ए तिना सबी खे हर माणूंए रे पीछे दो किलो कट्ठा करेया करना।” <verse eid="EXO 16:16" /><verse number="17" style="v" sid="EXO 16:17" />ओर इस्राएलिये तेड़ा ई कित्तेया ओर किने जादा ओर किने कम कट्ठा कित्तेया। <verse eid="EXO 16:17" /><verse number="18" style="v" sid="EXO 16:18" />जेबे तिने नापणे रे पांडे ते नापेया, तेबे जिने बऊत कट्ठा कित्तेया तेसगे कुछ जादा नि निकल़ेया ओर जिने थोड़ा कट्ठा कित्तेया था तिना गे जरूरती ते कम नि निकल़ेया कऊँकि एकी-एकी माणूंए आपणे खाणे जोगा कट्ठा करी राखेया था।<verse eid="EXO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 16:19" />तेबे मूसे तिना खे बोलेया, “कोई बी इजी बीचा ते प्यागा खे नि राखो।”<verse eid="EXO 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 16:20" />तेबे बी तिना बीचा ते कुछ माणूंए मूसे री गल्ल नि मानी; जेबे कुछ माणूंए तेते बीचा ते प्यागा खे राखेया तो तिदे कीड़े पड़ी गे ओर बास आऊणे लगी; तेबे मूसा तिना पाँदे रोषे ऊईगा। <verse eid="EXO 16:20" /><verse number="21" style="v" sid="EXO 16:21" />सेयो प्यागा-प्यागा हर रोज आपणे-आपणे खाणे जोगा कट्ठा करी लओ थे ओर जेबे तूप तेज ओ थी तेबे से गल़ी जाओ था <verse eid="EXO 16:21" /><verse number="22" style="v" sid="EXO 16:22" />तेबे एड़ा ऊआ की छठे दिने तिने दुगणा मतलब हर एक माणूंआ रे पीछे चार किलो कट्ठा कित्तेया ओर इस्राएली मण्डल़िया रे सबी परदाने आई की मूसे खे बताईता<verse eid="EXO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 16:23" />तेबे मूसे तिना खे बोलेया, “ये तो सेई गल्ल ए जो यहोवे बोली थी कऊँकि काल पवित्र रामो रा दिन मतलब यहोवे खे पवित्र रामो रा दिन ऊणा; इजी री खातर तुसा खे जो तन्दूरो रे पकाणा ओ से पकाओ, जो ऊबाल़ना ओ से उबाल़ो ओर इजी बीचा ते जितणा बचो से प्यागा खे राखी देओ।”<verse eid="EXO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 16:24" />जेबे तिने तिजी खे मूसे री आज्ञा रे मुताबिक प्यागा तक राखी ता तेबे ना तिदे बास आई ओर ना तिदे कीड़े पडे़। <verse eid="EXO 16:24" /><verse number="25" style="v" sid="EXO 16:25" />रामो रे दिने मूसे बोलेया, “काल जो तुसे बचाई की राखी राखेया था आज सेई खाओ, कऊँकि आज यहोवे रा रामो रा दिन ए; इजी खे आज तुसा खे मैदानो रे कुछ नि मिलणा। <verse eid="EXO 16:25" /><verse number="26" style="v" sid="EXO 16:26" />छे दिना तक तो तुसे तिजी खे कट्ठा करी सकोए; पर सातुआ दिन तो रामो रा दिन ए; तेस दिने तुसा खे कुछ नि मिलणा।”<verse eid="EXO 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 16:27" />तेबे बी माणूंआ बीचा ते कोई-कोई माणूं सातुए दिने बी कट्ठा करने खे बारे गये पर तिना खे कुछ नि मिलेया।<verse eid="EXO 16:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 16:28" />तेबे यहोवे मूसे खे बोलेया, “तुसे लोक मेरी आज्ञा ओर व्यवस्था खे कदुओ तक नि मानोगे? <verse eid="EXO 16:28" /><verse number="29" style="v" sid="EXO 16:29" />देखो, यहोवे जो तुसा खे रामो रा दिन देई राखेया इजी री बजअ ते से तुसा खे छठे दिनो खे दो दिना रा खाणा देणे लगी रा; इजी री खातर तुसे आपणे-आपणे एती बैठे रे रणा ओर सातुए दिने केसी बी आपणी जगा खे छाडी की बारे नि जाणा।”<verse eid="EXO 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 16:30" />इजी खे माणूंए सातुए दिने राम कित्तेया।<verse eid="EXO 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 16:31" />इस्राएली लोके तेते खाणे री चीजा रा नाओं मन्ना राखेया ओर से बेणो जेड़ा छोटा ओर सफेद था, ओर तिजी रा स्वाद सईतो रे बणे रे मालपुड़ेया जेड़ा था।<verse eid="EXO 16:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 16:32" />तेबे मूसे बोलेया, “यहोवे येई आज्ञा देई राखी कि इजी बीचा ते दो किलो परी की आपणे कुलो रिया पीढ़िया-पीढ़िया खे देखणे खे राखी देओ, ताकि तिना खे पता लगी जाओ कि यहोवा आसा खे मिस्र देशो ते निकयाल़ी की सुनसाण जगा रे केड़ी रोटी खुल़ाओ था।” <verse eid="EXO 16:32" /><verse number="33" style="v" sid="EXO 16:33" />तेबे मूसे हारूणो खे बोलेया, “एक पांडा लई की तिदे दो किलो मन्ना परी की से यहोवे रे आगे राखी दे, ताकि से तुसा आऊणे वाल़ी पीढ़िया खे राखेया रा रओ।”<verse eid="EXO 16:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 16:34" />जेड़ी आज्ञा यहोवे मूसे खे दित्ती थी, तिजी रे मुताबिक हारूणे से गवाईया रे सन्दूको रे आगे राखी ता ताकि से तेती सई सलामत रओ।<verse eid="EXO 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 16:35" />इस्राएली लोक जदुए तक बसे रे देशो रे नि पऊँचे तदुए तक मतलब चाल़िया साला तक मन्ने खे खांदे रए; सेयो जदुए तक कनान देशो री सीमा तक नि पऊँचे तदुए तक मन्ना खांदे रए।<verse eid="EXO 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 16:36" />एक ओमेरो<note caller="+" style="f"><char style="fr" closed="false">16:36 </char><char style="ft" closed="false">एक ओमेर मतलब दो किलो</char></note> रा नाप तो एपा<note caller="+" style="f"><char style="fr" closed="false">16:36 </char><char style="ft" closed="false">एपा मतलब बीई किलो</char></note> रा दसुआ पाअग ओआ<verse eid="EXO 16:36" /></para>
  <chapter eid="EXO 16" />
  <chapter number="17" style="c" sid="EXO 17" />
  <para style="s">चट्टानी ते पाणी निकयाल़ना</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 17:1" />तेबे इस्राएलिया री सारी मण्डल़ी सीन नाओं री सुनसाण जगा ते निकल़ी गी ओर यहोवे री आज्ञा रे मुताबिक तेथा ते चली की रपीदीमो<note caller="+" style="f"><char style="fr" closed="false">17:1 </char><char style="fq" closed="false">रपीदीमो </char><char style="ft" closed="false">मतलब राम करने री जगा</char></note> रे तिने आपणे डेरे खड़े कित्ते; तेती तिना माणूंआ खे पीणे खे पाणी नि मिलेया।<verse eid="EXO 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 17:2" />तो सेयो लोक मूसे साथे बईस करी की बोलणे लगे, “आसा खे पीणे रा पाणी दे।” मूसे तिना खे बोलेया, “तुसे मां साथे कऊँ बईस करने लगी रे ओर यहोवे री परीक्षा कऊँ करोए?” <verse eid="EXO 17:2" /><verse number="3" style="v" sid="EXO 17:3" />पर तेती माणूंआ खे बऊत त्याये लगी ओर सेयो ये बोली की मूसे पाँदे बड़बड़ाणे लगे, “ये क्या ए? क्या तूँ आसा खे बाल-बच्चे ओर डांगरा साथे त्याये मारने खे मिस्र देशो ते ल्याया।”<verse eid="EXO 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 17:4" />तेबे मूसे यहोवे ते मतादा रिया तँईं प्रार्थना कित्ती ओर बोलेया, “इना माणूंआ साथे आऊँ क्या करुँ? ये सब तो माखे पात्थर बाणे खे त्यार ए।”<verse eid="EXO 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 17:5" />यहोवे मूसे खे जबाब दित्तेया, “इस्राएलिया रे स्याणे माणूंआ बीचा ते कुछ लोका खे आपू साथे लई लो ओर जेते सोठिए की तैं नील नदिया पाँदे बाया था, तिजी खे बी आपणे आथो रे लई की माणूंआ रे आगे लई की चल। <verse eid="EXO 17:5" /><verse number="6" style="v" sid="EXO 17:6" />देख आऊँ तांते आगे चली की होरेब पाह्ड़ो रिया एक चट्टानी पाँदे खड़े रा रऊँगा; ओर तैं तेसा चट्टानी पाँदे बाणी, तेबे तिजी बीचा ते जो पाणी निकल़ना से एसा सारिया मण्डल़िया पीणा।” तेबे मूसे इस्राएलो रे स्याणे माणूंआ री नजरा रे सामणे तेड़ा ई कित्तेया। <verse eid="EXO 17:6" /><verse number="7" style="v" sid="EXO 17:7" />ओर मूसे तेसा जगा रा नाओं मस्सा<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="fq" closed="false">मस्सा </char><char style="ft" closed="false">मतलब परख</char></note> ओर मरीबा<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="fq" closed="false">मरीबा </char><char style="ft" closed="false">मतलब शकाईत</char></note> राखेया; कऊँकि इस्राएलिये तेती मूसे साथे बईस कित्ती थी ओर यहोवे री परीक्षा ये बोली की कित्ती कि क्या यहोवा आसा बीचे अया कि नई?<verse eid="EXO 17:7" /></para>
  <para style="s">अमालेकिया ते जीतणा</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 17:8" />तिजी ते बाद अमालेकी आई की रपीदीमो रे इस्राएलिया रे खलाफ लड़ने लगे।<verse eid="EXO 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 17:9" />तेबे मूसे यहोशूए खे बोलेया, “आसा खे कई मर्दा खे चूणी की छाँटी लओ ओर बारे जाई की अमालेकिया रे खलाफ लड़ ओर मां काल परमेशरो री सोठी आथो रे लई की पाह्ड़ो री चूँडिया पाँदे खड़ना।”<verse eid="EXO 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 17:10" />जेड़ी मूसे आज्ञा दित्ती ई तिजी रे मुताबिक यहोशू अमालेकिया रे खलाफ लड़ने लगेया ओर मूसा, हारूण ओर हूर पाह्ड़ो रिया चूँडिया पाँदे चढ़ीगे <verse eid="EXO 17:10" /><verse number="11" style="v" sid="EXO 17:11" />ओर जदुओ तक मूसा आपणे आथ ऊबे चकी राखो था तदुओ तक तो इस्राएली जीतदे रओ थे; पर जेबे-जेबे से आपणा आथ थाले करो था तेबे-तेबे अमालेकी जीती जाओ थे। <verse eid="EXO 17:11" /><verse number="12" style="v" sid="EXO 17:12" />जेबे मूसे रिया बांयी थकी गिया, तेबे हारूणे ओर हूरे एक पात्थर लई की मूसे रे थाले राखी ता ओर से तेते पाँदे बैठीगा, ओर हारूण ओर हूरे एकी-एकी तरफा ते तेसरी बांयी समाल़ी की राखिया ताकि तेसरे आथ सूरज डूबणे तक उठे रे रओ।<verse eid="EXO 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 17:13" />तेबे यहोशूए आपणे सैनिका साथे मिली की अमालेकी तलवारी साथे युद्ध करी की अराई ते।<verse eid="EXO 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 17:14" />एसा लड़ाईया ते बाद यहोवे मूसे खे बोलेया, “याद करी की अमालेकिया ते जीतणे री एसा गल्ला खे कताबा रे लिखी दे ओर यहोशूए खे सुणाई दे कि मां अमालेकी तरतिया पाँदा ते पुरिया तरअ ते नाश करी देणे।”<verse eid="EXO 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 17:15" />तेबे मूसे एक बेदी बणाई की तेसा रा नाओं यहोवा निस्सी<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="ft" closed="false">यहोवा निस्सी मतलब यहोवा मेरा झंडा ए</char></note> राखेया; <verse eid="EXO 17:15" /><verse number="16" style="v" sid="EXO 17:16" />फेर तिने बोलेया, “यहोवे वादा करी राखेया कि यहोवा अमालेकिया साथे पीढ़िया तक लड़दा रणा।”<verse eid="EXO 17:16" /></para>
  <chapter eid="EXO 17" />
  <chapter number="18" style="c" sid="EXO 18" />
  <para style="s">मूसे रा आपणे सऊरे ते मिलणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 18:1" />जेबे मिद्यान देशो रे पुरोईते यित्रो जो मूसे रा सऊरा था ये सुणेया कि परमेशरे मूसा ओर आपणी प्रजा इस्राएलिया खे क्या-क्या करी राखेया ओर किंयाँ यहोवे इस्राएली मिस्रो ते निकयाल़ी की ल्याये। <verse eid="EXO 18:1" /><verse number="2" style="v" sid="EXO 18:2" />तेबे मूसे रा सऊरा यित्रो मूसे री लाड़ी सिप्पोरा खे, जो मूसे पईले ई आपणे बाओ रे करो खे पेजी री थी, <verse eid="EXO 18:2" /><verse number="3" style="v" sid="EXO 18:3" />ओर तेसा रे दुँईं पाऊआ खे बी ली आया; इना बीचा ते एकी पाऊए रा नाओं मूसे ये बोली की गेर्शोम<note caller="+" style="f"><char style="fr" closed="false">18:3 </char><char style="fq" closed="false">गेर्शोम </char><char style="ft" closed="false">मतलब परदेशी</char></note> राखेया, “आऊँ दूजे देशो रे परदेशी ऊई रा।” <verse eid="EXO 18:3" /><verse number="4" style="v" sid="EXO 18:4" />ओर दूजे पाऊए रा नाओं तिने ये बोली की एलीएजेर<note caller="+" style="f"><char style="fr" closed="false">18:4 </char><char style="fq" closed="false">एलीएजेर </char><char style="ft" closed="false">मतलब मेरा परमेशर मेरा मददगार ए</char></note> राखेया, “मेरे बाओ रे परमेशरे मेरा मतदगार ऊई की आऊँ फिरौनो री सेना ते काणे ते बचाया।”<verse eid="EXO 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 18:5" />जेती सुनसाण जगा रे परमेशरो रे पाह्ड़ो रे नेड़े मूसे ओर इस्राएली लोके डेरा पायी राखेया था तेती मूसे रा सऊरा यित्रो तेसरी लाड़ी ओर तेसरे दुँईं माठेया खे ली आया। <verse eid="EXO 18:5" /><verse number="6" style="v" sid="EXO 18:6" />ओर तिने मूसे गे एक माणूं पेजी की सन्देशा पेजेया, “आऊँ तेरा सऊरा यित्रो ए ओर तेरे दुँईं माठेया ओर तेरी लाड़िया खे तांगे ली आई रा।”<verse eid="EXO 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 18:7" />मूसा ये खबर सुणी की आपणे सऊरे साथे मिलणे खे डेरे ते बारे निकल़ेया ओर तेसगे माथा टेकी की तेसरे गल़े लगेया ओर सेयो आपू बीचे सुख-साँद पूछदे ऊए डेरे गे आए। <verse eid="EXO 18:7" /><verse number="8" style="v" sid="EXO 18:8" />तेती मूसे आपणे सऊरे गे कि यहोवे इस्राएलिया रिया तँईं फिरौन ओर मिस्रिया साथे क्या-क्या कित्तेया ओर इस्राएलिया खे बाटा रे क्या-क्या कष्ट ऊए, तेबे यहोवा तिना खे किंयाँ-किंयाँ छुड़ांदा आई रा, यो सब गल्ला बताईया।<verse eid="EXO 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 18:9" />यहोवे री तेसा पलाईया री गल्ल सुणी की कि तिने इस्राएली मिस्रिया रे वशो ते छुड़ाए, यित्रो खुश ऊईगा ओर बोलेया, <verse eid="EXO 18:9" /><verse number="10" style="v" sid="EXO 18:10" />“तन्य ए यहोवा, जिने तुसे मिस्रो रे राजा फिरौनो रे वशो ते छुड़ाए ओर जिने तुसे मिस्रिया री गुलामिया ते छुड़ाए। <verse eid="EXO 18:10" /><verse number="11" style="v" sid="EXO 18:11" />एबे मैं जाणी ला रा कि यहोवा सबी देवतेया ते महान् ए; बल्कि तिजी रे बारे दे बी जिदे मिस्रिए इस्राएलिया ते कमण्ड करी की बर्ताओ कित्तेया था।” <verse eid="EXO 18:11" /><verse number="12" style="v" sid="EXO 18:12" />तेबे मूसे रे सऊरे परमेशरो खे होमबलि ओर मेलबलि चढ़ाए, तेबे हारूण इस्राएलिया रे सबी स्याणेया समेत मूसे रे सऊरे यित्रो साथे परमेशरो रे आगे रोटी खाणे खे आया।<verse eid="EXO 18:12" /></para>
  <para style="s">मूसे खे तेसरे सऊरे री सलाह्</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 18:13" />दूजे दिने मूसा लोका रा न्याय करने खे बैठेया ओर प्यागा ते साँजा तक लोक मूसे रे नेड़े-तेड़े खड़े रे रये। <verse eid="EXO 18:13" /><verse number="14" style="v" sid="EXO 18:14" />ये देखी की कि मूसा लोका खे क्या-क्या करोआ, तेसरे सऊरे बोलेया, “ये क्या काम ए जो तूँ लोका खे करेया? क्या बजअ ए कि तूँ कल्ला एक न्याय करने वाल़े जेड़ा बैठेया रा रएया ओर लोक प्यागा ते साँजा तक तेरे नेड़े-तेड़े खड़े रे रओए?”<verse eid="EXO 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 18:15" />तो मूसे आपणे सऊरे खे बोलेया, “लोक मांगे परमेशरो री इच्छा जाणने खे आओए। <verse eid="EXO 18:15" /><verse number="16" style="v" sid="EXO 18:16" />ओर जेबे कदी तिना बीचे चगड़ा ओआ, तेबे सेयो मांगे आओए ओर आऊँ तिना बीचे न्याय करूँआ ओर परमेशरो रे बिदी-बिधान तिना खे समजयाऊँआ?”<verse eid="EXO 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 18:17" />तेबे मूसे रे सऊरे तेसखे बोलेया, “तूँ जो काम करने लगी रा, से अच्छा निया। <verse eid="EXO 18:17" /><verse number="18" style="v" sid="EXO 18:18" />कऊँकि इजी ते तूँ ओर यो लोक बी जो तां साथे ए पक्का थकी जाणे ओर ईंयाँ बी ये काम ताखे बऊत पारी ए; तूँ इजी खे कल्ला नि करी सकदा। <verse eid="EXO 18:18" /><verse number="19" style="v" sid="EXO 18:19" />इजी री खातर एबे मेरी सुणी लओ, आऊँ ताखे सलाह देऊँआ ओर परमेशर तां साथे रओ। तूँ तो इना लोका रिया तँईं परमेशरो सामणे जाया कर ओर इना रे मकद्दमेया खे परमेशरो गे पऊँचाया कर। <verse eid="EXO 18:19" /><verse number="20" style="v" sid="EXO 18:20" />इना खे परमेशरो रे बिदी-बिधान बताई-बताई की, जेते बाटा रे इना खे चलणा ए ओर जो-जो काम इना करने ओ, तिना इना खे समजयाई देया कर। <verse eid="EXO 18:20" /><verse number="21" style="v" sid="EXO 18:21" />पर पईले तूँ इना सबी इस्राएली मर्दा बीचे एड़े मर्दा खे छाँटी लो, जो कामयाब, परमेशरो रा डर मानणे वाल़े, सच्चे ओर अन्याय ते नफरत करने वाल़े ओ ओर इना खे ह्जार-ह्जार, 50-50 ओर 10-10 माणूंआ पाँदे परदान ठराई दे। <verse eid="EXO 18:21" /><verse number="22" style="v" sid="EXO 18:22" />यो सब इना लोका रा न्याय करेया करोगे ओर सब मुश्किल गल्ला खे तो तांगे ल्याया करो ओर छोटिया-छोटिया गल्ला रा न्याय आपू ई करेया करो कऊँकि ये बोज तिना बी तां साथे चकणा, तेबे तेरा बोज अल्का ऊणा। <verse eid="EXO 18:22" /><verse number="23" style="v" sid="EXO 18:23" />जे तूँ ये उपाय करे ओर परमेशर ताखे एड़ी आज्ञा देओ, तेबे तूँ एते दबाव ते बची सकेया ओर यो लोक शान्तिया रे आपणी जगा रे पऊँची सकणे।”<verse eid="EXO 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 18:24" />तेबे तिने आपणे सऊरे री ये सलाह मानी की तेसरी गल्ला रे मुताबिक कित्तेया। <verse eid="EXO 18:24" /><verse number="25" style="v" sid="EXO 18:25" />ईंयाँ मूसे इस्राएली लोका बीचा ते कामयाब माणूं चूणे ओर सेयो लोका रे मुखिया बणाए। सेयो ह्जार-ह्जार, 100-100, 50-50 ओर 10-10 लोका पाँदे परदान ठराए।<verse eid="EXO 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 18:26" />तेबे सेयो सब लोका रा हर बखत न्याय करने लगे; ओर जो गल्ला कठण ओ थिया, तिजी खे सेयो मूसे गे ली आओ थे ओर सबी छोटी-छोटी गल्ला रा न्याय सेयो आपू ई करेया करो थे। <verse eid="EXO 18:26" /><verse number="27" style="v" sid="EXO 18:27" />तेबे मूसे आपणा सऊरा बिदा कित्तेया ओर से आपणे देशो खे चलीगा।<verse eid="EXO 18:27" /></para>
  <chapter eid="EXO 18" />
  <chapter number="19" style="c" sid="EXO 19" />
  <para style="s">सीनै रे पाह्ड़ो पाँदे यहोवे रा दर्शण देणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 19:1" />इस्राएली लोक मिस्र देशो ते निकल़ने रे तीजे मीन्ने रे पईले दिने सीनै पाह्ड़ो री सुनसाण जगा रे आए। <verse eid="EXO 19:1" /><verse number="2" style="v" sid="EXO 19:2" />जेबे इस्राएली रपीदीमो ते निकल़ी की सीनै पाह्ड़ो री सुनसाण जगा खे आए, तेबे तेथी तिने सुनसाण जगा रे सीनै पाह्ड़ो रे सामणे डेरे लगाए।<verse eid="EXO 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 19:3" />तेबे मूसा पाह्ड़ो पाँदे परमेशर यहोवे गे गल्ला करने खे चढ़ीगा ओर परमेशर यहोवा तेसखे पाह्ड़ो ते आका पाई की बोलेया, “याकूबो रे कराने खे मेरा ये वचन सुणा ओर जो गल्ला इस्राएलिया खे बोलणिया सेयो ये ए, <verse eid="EXO 19:3" /><verse number="4" style="v" sid="EXO 19:4" />‘तुसे आपू देखी राखेया कि मैं मिस्रो रे लोका साथे क्या-क्या कित्तेया, तुसा खे मानो उकाब पंछिये रे पंखो पाँदे चढ़ाई की आपू गे ली आया। <verse eid="EXO 19:4" /><verse number="5" style="v" sid="EXO 19:5" />एबे जे तुसे त्यानो साथे मेरी गल्ल सुणोगे ओर मेरी वाचा खे मानेया करोगे, तो तुसे सबी जातिया बीचे मेरी आपणी जायदात ठईरने, कऊँकि सारी तरती तो मेरी ए। <verse eid="EXO 19:5" /><verse number="6" style="v" sid="EXO 19:6" />मेरी नजरा रे तुसे एक पुरोईता रा समाज ओर पवित्र लोक ठईरने। जो गल्ला तां इस्राएलिया खे बोलणिया सेयो यो ईए।’ ” <verse eid="EXO 19:6" /><verse number="7" style="v" sid="EXO 19:7" />तेबे मूसे थाले आई की लोका रे स्याणे बुलाए ओर यो सब गल्ला तिना रे जरीये लोका तक पऊँचाणे खे समजयाई तिया, जिना खे बोलणे री आज्ञा यहोवे तेसखे दित्ती थी।<verse eid="EXO 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 19:8" />सबी लोके मिली की उत्तर दित्तेया, “जो कुछ यहोवे बोली राखेया से सब आसा करना।” तेबे लोका रिया यो गल्ला मूसे यहोवे गे सुणाईयां।<verse eid="EXO 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 19:9" />तेबे यहोवे मूसे खे बोलेया, “सुण, आऊँ गईरे न्हेरे बादल़ो रे ऊई की तांगे आऊँगा ताकि जेबे आऊँ तां साथे गल्ला करुँ, तेबे सेयो लोक सुणो ओर सदा तां पाँदे विश्वास करो।” तेबे मूसे लोका रिया गल्ला यहोवे गे सुणाईया। <verse eid="EXO 19:9" /><verse number="10" style="v" sid="EXO 19:10" />तेबे यहोवे फेर मूसे खे बोलेया, “तूँ लोका गे जा ओर सेयो आज ओर काल आपणे आपू खे परमेशरो रिया तँईं पवित्र करो ओर सेयो आपणे टाल्ले तोई लो <verse eid="EXO 19:10" /><verse number="11" style="v" sid="EXO 19:11" />ओर सेयो तीजे दिनो खे त्यार ऊई जाओ, कऊँकि तीजे दिने मां सबी लोका रे सामणे सीनै पाह्ड़ो पाँदे उतरी की आऊणा। <verse eid="EXO 19:11" /><verse number="12" style="v" sid="EXO 19:12" />इजी खे तैं लोका रिया तँईं चऊँ कनारे बाड़ा बानी लणा ओर तिना खे बोलणा, ‘तुसे चौकस रएयो कि पाह्ड़ो पाँदे नि चढ़ेयो ओर तिजी रे बन्ने खे पनि छूँएओ कऊँकि जो कोई माणूं पाह्ड़ो खे छूँओगा, से पक्का कायी देणा। <verse eid="EXO 19:12" /><verse number="13" style="v" sid="EXO 19:13" />जेबे कोई पाह्ड़ो खे छूँओ तेबे तेसखे कोई आथ नि लगाओ, पर से पात्थर या तीरो साथे काया जाओ; से चाए डांगर ओ, चाए माणूं से जिऊँदा नि बचो।’ जेबे रड़सिंगा बजाणे री आवाज बऊत देरा तक सुणो, तेबे लोक पाह्ड़ो गे आई सकोए।”<verse eid="EXO 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 19:14" />तेबे मूसे पाह्ड़ो ते उतरी की लोका गे आई की सेयो परमेशरो खे पवित्र कराए; फेर तिने आपणे टाल्ले तोई ले। <verse eid="EXO 19:14" /><verse number="15" style="v" sid="EXO 19:15" />ओर तिने लोका खे बोलेया, “तीजे दिनो तक त्यारी करदे रओ ओर लाड़िया गे नि जाणा।”<verse eid="EXO 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 19:16" />जेबे तीजा दिन आया तेबे प्याग ऊँदे ई बादल़ गरजणे लगे ओर बिजल़ी चमकणे लगी ओर पाह्ड़ो पाँदे काल़े बादल़ छाई गे ओर रड़सिंगे री आवाज बऊत जोरे साथे ऊई ओर डेरे रे जितणे बी लोक थे सब डरो रे मारे थरथराईगे।<verse eid="EXO 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 19:17" />तेबे मूसा लोका खे परमेशरो साथे मिलाणे रिया तँईं डेरे ते निकयाल़ी की लईगा ओर सेयो पाह्ड़ो निठे खड़े ऊईगे। <verse eid="EXO 19:17" /><verse number="18" style="v" sid="EXO 19:18" />ओर यहोवा जो आगी रे ऊई की सीनै पाह्ड़ो पाँदे उतरी रा था, इजी बजअ ते सारा पाह्ड़ तुएँ साथे परी गा ओर तिजी रा तुआँ पट्ठिया जेड़ा उठणे लगी रा था ओर सारा पाह्ड़ बऊत थरथराणे लगी रा था। <verse eid="EXO 19:18" /><verse number="19" style="v" sid="EXO 19:19" />ओर जेबे रड़सिंगे री आवाज बढ़दी ओर बऊत जादा ऊईगी, तेबे मूसे बोलेया ओर परमेशरे तेसरी आवाज सुणी कि जबाब दित्तेया।<verse eid="EXO 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 19:20" />तेबे यहोवा सीनै पाह्ड़ो री चूँडिया पाँदे उतरेया ओर मूसा पाह्ड़ो री चूँडिया पाँदे ऊबे शादेया। तेबे मूसा ऊबे चढ़ीगा। <verse eid="EXO 19:20" /><verse number="21" style="v" sid="EXO 19:21" />तेबे यहोवे मूसे खे बोलेया, “थाले उतरी की लोका खे चतौणी दे, केथी एड़ा नि ओ कि सेयो बाड़ा तोड़ी कि मां यहोवे खे देखणे खे पीतरे आओ ओर तिना बीचा ते बऊत नाश ऊई जाओ <verse eid="EXO 19:21" /><verse number="22" style="v" sid="EXO 19:22" />ओर पुरोईत बी जो यहोवे रे नेड़े आया करोए सेयो बी आपणे आपू खे परमेशरो रिया तँईं पवित्र ओर शुद्ध करो, केथी एड़ा नि ओ कि आँऊ यहोवा तिना खे बऊत पारी सजा देऊँ।”<verse eid="EXO 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 19:23" />पर मूसे यहोवे खे बोलेया, “सेयो लोक सीनै पाह्ड़ो पाँदे नि चढ़ी सकदे; कऊँकि तैं तो आपू ई बोली की आसे समजयाई राखे कि पाह्ड़ो रे चऊँ कनारे बाड़ा बानी की तिजी खे पवित्र राखो।”<verse eid="EXO 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 19:24" />यहोवे तेसखे बोलेया, “एबे तूँ ऊँदे जा ओर हारूणो साथे तूँ ऊबे आओ, पर पुरोईत ओर, ओर माणूं बाड़ा तोड़ी की मांगे नि आओ, केथी एड़ा नि ओ कि आँऊ यहोवा तिना खे बऊत पारी सजा देऊँ।” <verse eid="EXO 19:24" /><verse number="25" style="v" sid="EXO 19:25" />तेबे यो गल्ला मूसे लोका गे उतरी की सुणाईयां।<verse eid="EXO 19:25" /></para>
  <chapter eid="EXO 19" />
  <chapter number="20" style="c" sid="EXO 20" />
  <para style="s">दस आज्ञा</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 20:1" />तेबे परमेशरे ये सब वचन बोले, <verse eid="EXO 20:1" /><verse number="2" style="v" sid="EXO 20:2" />“आऊँ तेरा परमेशर यहोवा ए, जो ताखे मिस्र प्रदेशो ते गुलामिया ते निकयाल़ी की ल्याया। <verse eid="EXO 20:2" /><verse number="3" style="v" sid="EXO 20:3" />तैं माखे छाडी की कोई ओर परमेशर करी की नि मानणा। <verse eid="EXO 20:3" /><verse number="4" style="v" sid="EXO 20:4" />तूँ आपू खे जो सर्गो रे ए या तरतिया रे ए या तरतिया रे पाणिए रे ए, केसी बी चीजा री मूर्ति खणी की नि बणाया। <verse eid="EXO 20:4" /><verse number="5" style="v" sid="EXO 20:5" />तैं तिना गे माथा नि टेकणा ओर ना ई तिना री पूजा करनी; कऊँकि आऊँ तेरा परमेशर यहोवा जल़न राखणे वाल़ा परमेशर ए ओर जो मां साथे बैर राखोए आऊँ तिना रे माठेया, पोतेया ओर पड़पोतेया खे पितरा री सजा देऊँआ, <verse eid="EXO 20:5" /><verse number="6" style="v" sid="EXO 20:6" />पर जो कोई मां साथे प्यार राखोआ ओर मेरी आज्ञा खे मानोआ तिना री ह्जारा पीढ़िया पाँदे आऊँ दया करेया करूँआ। <verse eid="EXO 20:6" /><verse number="7" style="v" sid="EXO 20:7" />तैं आपणे परमेशरो रा नाओं बेकार नि लणा; कऊँकि जो यहोवे रा नाओं बेकार लओगा सेयो यहोवे निर्दोष नि ठराणे। <verse eid="EXO 20:7" /><verse number="8" style="v" sid="EXO 20:8" />तूँ रामो रे दिनो खे पवित्र मानणे खे याद राखेया। <verse eid="EXO 20:8" /><verse number="9" style="v" sid="EXO 20:9" />छे दिन तो तैं मईणत करी की आपणा सारा काम-काज करना; <verse eid="EXO 20:9" /><verse number="10" style="v" sid="EXO 20:10" />पर सातुआ दिन तेरे परमेशर यहोवे खे रामो रा दिन ए। तिदे ना तो तैं कोई काम-काज करना, ना तेरे पाऊ, ना तेरी मुन्नी, ना तेरे दास, ना तेरी दासी, ना तेरे डांगर ओर ना कोई परदेशी जो तेरे समाजो रे ए, कोई बी केसी बी किस्मा रा काम नि करो।<verse eid="EXO 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 20:11" />“कऊँकि छे दिना रे यहोवे सर्ग बणाया, तरती, समुद्र ओर जो कुछ तिदे ए सब बणाए ओर सातुए दिने राम कित्तेया; इजी बजअ ते यहोवे रामो रे दिनो खे आशीष दित्ती ओर से पवित्र ठराया। <verse eid="EXO 20:11" /><verse number="12" style="v" sid="EXO 20:12" />तैं आपणे माये बाओ री इज्जत करनी ताकि जो देश तेरा परमेशर यहोवा ताखे देओआ, तेते देशो रे तूँ बऊत दिनो तक जिऊँदा रई सके। <verse eid="EXO 20:12" /><verse number="13" style="v" sid="EXO 20:13" />तैं अत्या नि करनी। <verse eid="EXO 20:13" /><verse number="14" style="v" sid="EXO 20:14" />तैं व्याभिचार नि करना। <verse eid="EXO 20:14" /><verse number="15" style="v" sid="EXO 20:15" />तैं चोरी नि करनी। <verse eid="EXO 20:15" /><verse number="16" style="v" sid="EXO 20:16" />तैं केसी रे खलाफ चूठी गवाई नि देणी। <verse eid="EXO 20:16" /><verse number="17" style="v" sid="EXO 20:17" />तैं केसी रे कअरो री चीजा रा लाल़च नि करना; ना तो केसी री जवाणसा रा लाल़च करना ओर ना केसी रे दास-दासिया रा ओर ना गह्दे, बल़दा रा, ना केसी री किजी बी चीजा रा लाल़च करना।”<verse eid="EXO 20:17" /></para>
  <para style="s">परमेशरो री मौजुदगिया रे इस्राएली लोका रा डरना</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 20:18" />जेबे लोके बादल़ा रा गरजणा, बिजल़िया रा चमकणा ओर रड़सिंगे री आवाज सुणी ओर पाह्ड़ो ते तुआँ उठदे ऊए देखेया तेबे सेयो ये देखी की डरो रे मारे थरथरांदे ऊए दूर खड़े ऊईगे। <verse eid="EXO 20:18" /><verse number="19" style="v" sid="EXO 20:19" />ओर सेयो मूसे खे बोलणे लगे, “तूँई आसा साथे गल्ला कर, तेबे तो आसे सुणी सकूँए, पर परमेशर आसा साथे गल्ला नि करो, एड़ा नि ओ कि आसे मरी जाऊँ।”<verse eid="EXO 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 20:20" />मूसे लोका खे बोलेया, “डरो नि; कऊँकि परमेशर इजी खे आयी रा कि से तुसा री परीक्षा करो ओर तेसरा डर तुसा रे मनो रे बणेया रा रओ, ताकि तुसे पाप नि करो।” <verse eid="EXO 20:20" /><verse number="21" style="v" sid="EXO 20:21" />ओर सेयो लोक दूर ई खड़े रे रये, पर मूसा तेस अन्दकूप न्हेरे रे नेड़े गया जेती परमेशर था।<verse eid="EXO 20:21" /></para>
  <para style="s">मूसे खे बताए रे यहोवे रे बिधि-बिधान</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 20:22" />तेबे यहोवे मूसे खे बोलेया, “तूँ इस्राएलिया खे मेरे ये वचन सुणा कि तुसे लोके आपू देखी राखेया कि मैं तुसा साथे सर्गो ते गल्ला करी राखिया। <verse eid="EXO 20:22" /><verse number="23" style="v" sid="EXO 20:23" />तुसे सूईने या चाँदिए रे देवते नि बनाणे केथी एड़ा नि ओ कि तुसे माखे पूली की तिना मूर्तिया री पूजा शुरू करी देओ। <verse eid="EXO 20:23" /><verse number="24" style="v" sid="EXO 20:24" />मेरिया तँईं माट्टिया री एक बेदी बनाणी की तिजी पाँदे आपणी पेडा-बाकरिया री ओर गाय-बल़दा री होमबलि ओर मेलबलि चढ़ाणी, जेती-जेती आऊँ आपणे नाओं री याद कराऊँ, तेती-तेती आयी की मां तुसा खे आशीष देणी। <verse eid="EXO 20:24" /><verse number="25" style="v" sid="EXO 20:25" />ओर जे तुसे माखे पात्थरो री बेदी बणाओगे, तो कडे़ रे पात्थरो री नि बनाणा, कऊँकि जेती तुसे तेते पाँदे आपणा ज्वार लगाई की कोई कारीगरी कित्ती तेती तुसा से अशुद्ध करी देणी <verse eid="EXO 20:25" /><verse number="26" style="v" sid="EXO 20:26" />ओर मेरी बेदिया पाँदे संगाओ साथे कदी नि चढ़ना, केथी एड़ा नि ओ कि तेरा तन तेते पाँदे नांगा दिशो।”<verse eid="EXO 20:26" /></para>
  <chapter eid="EXO 20" />
  <chapter number="21" style="c" sid="EXO 21" />
  <para style="s">इब्री गुलामा साथे ठीक टंगो रा बर्ताव करने रे नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 21:1" />ओर जो बिधान तां इस्राएली लोका खे समजयाणे से यो ए। <verse eid="EXO 21:1" /><verse number="2" style="v" sid="EXO 21:2" />“जे तुसे कोई इब्रानी जातिया रा दास खरीदी राखेया ओ, तेबे से छे साला तक सेवा करदा रओ पर सातुए साले बिना कीमत चुकाए आजाद ऊई की चली जाओ। <verse eid="EXO 21:2" /><verse number="3" style="v" sid="EXO 21:3" />जे से आपणे मालको गे कल्ला आया ओ, तो कल्ला ई चली जाओ; पर जे लाड़िया साथे आया ओ, तो तेस साथे तेसरी लाड़ी बी चली जाओ। <verse eid="EXO 21:3" /><verse number="4" style="v" sid="EXO 21:4" />जे तेसरे मालके तेसखे लाड़ी देई राखी ओ ओर तेसा रे माठे-बेटिया जम्मी रे ओ तो तेसरी लाड़ी ओर बाल़क तेस मालको रे रओ ओर से कल्ला ई चली जाओ। <verse eid="EXO 21:4" /><verse number="5" style="v" sid="EXO 21:5" />पर जे से दास मजबूतिया साथे बोलो, ‘आऊँ आपणे मालक ओर आपणी लाड़ी ओर पाऊआ खे प्यार करूँआ इजी री खातर मां आजाद ऊई की नि जाणा;’ <verse eid="EXO 21:5" /><verse number="6" style="v" sid="EXO 21:6" />तो तेसरा मालक तेसखे परमेशरो रे सामणे लई चलो; तेबे तेसखे द्धारो रे फल़े या साखा गे लई जाई की तेसरे कानो रे सूए साथे छेद करो; तेबे से सदा तेसरी सेवा करदा रओ।”<verse eid="EXO 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 21:7" />जे कोई आपणी बेटिया खे दासी ऊणे खे बेची देओ, तो से दासी, मर्द दासो जेड़ी आजाद ऊई की नि जाई सकदी। <verse eid="EXO 21:7" /><verse number="8" style="v" sid="EXO 21:8" />जे तेसा रा मालक तेसा खे आपणी लाड़ी बणाओ ओर तेबे तेसा ते खुश नि रओ, तो से तेसा रा मोल लई कि जाणे देओ ओर तेसा खे तिने तोखा दित्तेया; इजी खे तेसा खे परदेशी लोका रे आथो रे बेचणे रा अक्क तेसखे नि ऊणा। <verse eid="EXO 21:8" /><verse number="9" style="v" sid="EXO 21:9" />जे तिने से आपणे माठे खे ब्यायी ती ओ, तो तेसा साथे बेटिया जेड़ा बर्ताव करो। <verse eid="EXO 21:9" /><verse number="10" style="v" sid="EXO 21:10" />जे से दूजी लाड़ी करी लो, तेबे बी से तेसा री रोटी, टाल्ले ओर तेसा साथले सम्बन्द कम नि करो। <verse eid="EXO 21:10" /><verse number="11" style="v" sid="EXO 21:11" />ओर जे से इना तिंऊँ गल्ला दे कमी करो, तो से जवाणस बिना मोल दित्ते आजाद ऊई की चली जाओ।<verse eid="EXO 21:11" /></para>
  <para style="s">खून-खराबे रिया तँईं नियम</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 21:12" />जे कोई केसी माणूंए खे एड़ा बाओ कि से मरी जाओ, तो से बी पक्का काई देणा चाईयो। <verse eid="EXO 21:12" /><verse number="13" style="v" sid="EXO 21:13" />जे तिने तेसखे मारने रिया तँईं योजना नि बणाई राखी ओ ओर मां परमेशरो रिया इच्छा ते या अणजाणे रे से तेसरे आथे की मरी जाओ तो एड़े काणे वाल़े खे नठणे रिया तँईं आऊँ एक जगा ठराऊँगा जेती से नठी जाओ। <verse eid="EXO 21:13" /><verse number="14" style="v" sid="EXO 21:14" />पर जे कोई जाणी बूजी की केसी खे छल करी की काओ तो से काणे वाल़ा माणूं एक बचणे वाल़ी जगा रे मेरी बेदिया ते बी कसिटी की मारने खे दूर लई जाणा।<verse eid="EXO 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 21:15" />जे कोई आपणे माया बाओ खे कूटो से बी पक्का काई देणा चाईयो।<verse eid="EXO 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 21:16" />जे कोई केसी माणूंए खे चोरो, चाए से तेसखे बेची देओ, चाए से तेसगे ई मिलो, तेबे से बी जरूर काई देणा चाईयो।<verse eid="EXO 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 21:17" />जे कोई आपणे माया-बाओ खे स्राप देओ से बी जरूर काई देणा चाईयो।<verse eid="EXO 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 21:18" />जे माणूं आपू बीचे लड़ो ओर एक दूजे खे पात्थर या मुक्के एड़े बाओ की से मरो नि पर काईल ऊई की बछौणे दे पड़ी जाओ, <verse eid="EXO 21:18" /><verse number="19" style="v" sid="EXO 21:19" />पर बादो ते जे से उठी की सोठिया रे साअरे ते बारे चलणे-फिरने लगो, तेबे से बाणे वाल़ा तेते दशा रे तेसरे पड़े रणे रे बखतो ते लई की ठीक ऊणे तक तेसरा नकसवाण परी देओ ओर तेसरा लाज बी कराओ तेबे से सजा ते आजाद ऊई सकोआ।<verse eid="EXO 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 21:20" />जे कोई मालक आपणे दास-दासिया खे सोठे कि एड़ी बाओ की से मरी जाओ तेबे तेसखे जरूर सजा देणी। <verse eid="EXO 21:20" /><verse number="21" style="v" sid="EXO 21:21" />पर जे से दास या दासी एक या दो दिना रे ठीक ऊई जाओ तो तेसरे मालको खे सजा नि देणी कऊँकि से दास तेसरा तअन ए।<verse eid="EXO 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 21:22" />जे माणूं आपू बीचे मार-पीट करी की केसी गर्भवती जवाणस खे बाई देओ ओर तेसा रे टाल़ चली जाओ ओर कोई नकसवाण नि ओ तो मारने वाल़े ते तिथणा ई मोल लओ जितणा तेसा रा लाड़ा पंचा रिया रजामंदिया ते ठराओ। <verse eid="EXO 21:22" /><verse number="23" style="v" sid="EXO 21:23" />पर जे से मार-पीट करदे बखते मरी जाओ तो प्राणो रे बदले प्राण लया जाओ,<verse eid="EXO 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 21:24" />ओर आखी रे बदले आख ओर दाँदो रे बदले दाँद ओर आथो रे बदले आथ ओर पईरो रे बदला पईरो ते लया जाओ, <verse eid="EXO 21:24" /><verse number="25" style="v" sid="EXO 21:25" />ओर दागो रे बदले दाग ओर जख्मो रे बदले जख्म ओर कुटणे रे बदले कुटणे री सजा देणी।<verse eid="EXO 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 21:26" />जेबे कोई मालक आपणे दास-दासिया री आखी खे एड़ी बाओ की से फूटी जाओ तो से मालक तेसा आखी रे बदले तिना खे आजाद ऊई की जाणे देओ।<verse eid="EXO 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 21:27" />ओर जे मालक आपणे दास-दासिया खे बाई की तिना रा दाँद तोड़ी देओ तो से मालक तेस दाँदो रे बदले तिना खे आजाद ऊई की जाणे देओ।<verse eid="EXO 21:27" /></para>
  <para style="s">डांगरा खे समाल़ी की राखणे री जिम्मेबारी</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 21:28" />जे बल़द केसी माणूंआ या जवाणसा खे एड़ा सींग बाओ की से मरी जाओ तो से बल़द पक्का ई पात्थर बाई की काई देणा ओर तेसरा मास नि खाणा पर बल़दो रा मालक तेस नुकशाणो रा जिम्मेबार ठईरो। <verse eid="EXO 21:28" /><verse number="29" style="v" sid="EXO 21:29" />पर जे तेस बल़दो खे पईले तेई सींग बाणे रा प्यास ओ ओर तेसरे मालको खे पता ऊँदे ऊए बी से बानी नि राखेया ओ ओर से केसी माणूं या जवाणसा खे काई देओ, तेबे तो तेस बल़दो पाँदे पात्थर बाए जाओ ओर तेसरा मालक बी काई देणा चाईयो। <verse eid="EXO 21:29" /><verse number="30" style="v" sid="EXO 21:30" />जे तेस मरे रे माणूंए रे बदले तेस बल़दो रे मालको पाँदे अरजाना ठराई राखेया ओ, तो प्राण छुड़ाणे खे जो कुछ तेसखे ठराया जाओ, तेसखे तिथणा ई देणा पड़ना। <verse eid="EXO 21:30" /><verse number="31" style="v" sid="EXO 21:31" />चाए बल़दे कोई माठा या बेटी कायी राखे ओ, तेबे बी एस नियमो रे मुताबिक तेस मालको साथे बर्ताव कित्तेया जाओ। <verse eid="EXO 21:31" /><verse number="32" style="v" sid="EXO 21:32" />जे बल़दे केसी दास या दासिया खे सींग बायी राखेया ओ, तो बल़दो रा मालक तेस दासो रे मालको खे तीई शेकेल चाँदी<note caller="+" style="f"><char style="fr" closed="false">21:32 </char><char style="fq" closed="false">तीई शेकेल चाँदी </char><char style="ft" closed="false">मतलब आदा किलो चाँदी</char></note> देओ ओर तेस बल़दो खे पात्थर बाए जाओ।<verse eid="EXO 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 21:33" />जे कोई माणूं गड्डा खणी की तिजी खे नि टखो ओर तिदे केसी रा बल़द या गह्दा रूड़ी जाओ, <verse eid="EXO 21:33" /><verse number="34" style="v" sid="EXO 21:34" />तो जेसरा से गड्डा ओ से तेस नुकशाणो खे परी देओ, से डांगरो रे मालको खे तेसरा पैसा देओ पर लोथ गड्डे वाल़े री ठईरो।<verse eid="EXO 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 21:35" />जे केसी रा बल़द केसी ओरी रे बल़दो खे एड़ा काओ कि से मरी जाओ, तो सेयो दोनो माणूं जिऊँदे बल़दो खे बेची की तेसरा पैसा आपू बीचे आदी-आदी बांडी लओ ओर लोथ बी तेड़ी ई बांडी लो। <verse eid="EXO 21:35" /><verse number="36" style="v" sid="EXO 21:36" />जे ये पता सबी लोका खे ओ कि तेस बल़दो खे पईले तेई सींग बाणे री आदत थी, पर तेसरे मालके से बानी नि राखेया था, तो पक्का से बल़दो रे बदले बल़द परी देओ, पर लोथ तेसरी ई ठईरो।<verse eid="EXO 21:36" /></para>
  <chapter eid="EXO 21" />
  <chapter number="22" style="c" sid="EXO 22" />
  <para style="s">डांगरा रे हरजाने रे बारे दे नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 22:1" />जे कोई माणूं बल़द, पेड या बाकरी चोरी की कायी देओ या बेची देओ, तो से बल़दो रे बदले पाँज बल़द ओर पेडा-बाकरिया रे बदले चार पेडा बाकरिया परी देओ। <verse eid="EXO 22:1" /><verse number="2" style="v" sid="EXO 22:2" />जे चोर राती रे बखते चोरी करदे ऊए पकड़ेया जाओ ओर तेस पाँदे एड़ी मार पड़ो कि से मरी जाओ, तो तेसरे खूनो रा दोष काणे वाल़े पाँदे नि लगणा। <verse eid="EXO 22:2" /><verse number="3" style="v" sid="EXO 22:3" />ओर जे सूरज निकल़ी चुको ओर से मारेया जाओ तो तेसरे खूनो रा दोष लगणा; पर जे से तेस बखते मारेया नि जाओ तो जरूरी ए कि से नुकशाणो खे परी देओ पर जे तेसगे चोरिया रा नुकशाण परने खे कुछ नि ओ, तो से चोरिया रिया बजअ ते बेचेया जाओ। <verse eid="EXO 22:3" /><verse number="4" style="v" sid="EXO 22:4" />जे चोरेया रा बल़द या गह्दा या पेड-बाकरी चोरो गे जिऊँदी मिलो, तो से तिजी रा दुगणा परी देओ।<verse eid="EXO 22:4" /></para>
  <para style="s">फसल बचाणे रे नियम</para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 22:5" />जे कोई आपणे डांगरो ते केसी रा डोरू या बगीचा चराओ, मतलब आपणे डांगरा खे एड़ा छाडी देओ कि से ओरी रे डोरूआ खे चरी देओ, तो से आपणे डोरूआ ते ओर आपणे अंगूरा रे बगीचे ते खरिया ते खरी फसला बीचा ते तेस नुकशाणो खे परी देओ।<verse eid="EXO 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 22:6" />जे कोई आग बाल़ो ओर से कांडेया रे लगी जाओ ओर पूल़ेया रे टेर, नज्ज या खड़िया फसला रा डोरू फूकी जाओ, तो जिने आग बाल़ी राखी ओ, से तेस नुकशाणो खे जरूर परी देओ।<verse eid="EXO 22:6" /></para>
  <para style="s">आपणी जायदाता रे नियम</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 22:7" />जे कोई आपणे पड़ोसिये गे पैसे या कोई ओर चीज सम्माल़ने खे छाडो पर से तेसरे कअरो ते चोरी ऊई जाओ ओर जे चोर पकड़ेया जाओ, तो दुगणा तेसखे ई परना पड़ना। <verse eid="EXO 22:7" /><verse number="8" style="v" sid="EXO 22:8" />ओर जे चोर नि पकड़ेया जाओ, तो कअरो रा मालक परमेशरो सामणे, न्याय करने वाल़ेया गे ल्याया जाओ ताकि निश्चा ऊई जाओ कि तिने आपणे पाई-बन्दुओ रे पैसे या चीज चोरी करी राखी कि नई।<verse eid="EXO 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 22:9" />चाए बल़द, गह्दा, पेड, बाकरी, टाल्ले चाए कोई बी एड़ी राची री चीजा रे बारे दे दोष कऊँ नि लगाया जाओ, जेतेखे दो जणे आपणी-आपणी बोलोए, तो दुँईं रा मकद्दमा परमेशरो सामणे, न्याय करने वाल़ेया गे ल्याया जाओ ओर जेसखे न्यायी दोषी ठराओ, से दूजे खे दुगणा परी देओ।<verse eid="EXO 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 22:10" />जे कोई आपणे पड़ोसिये गे आपणा गह्दा, पेड, बाकरी या कोई बल़द सम्माल़ने खे राखो ओर केसी रे बिना देखे‍ से मरी जाओ या तेसरे बुड़ी जाओ या कोई तिजी खे लई जाओ कऊँकि तेती देखणे वाल़ा कोई नि था, <verse eid="EXO 22:10" /><verse number="11" style="v" sid="EXO 22:11" />तेबे से पड़ोसी जेसगे से जानवर समाल़ी राखे थे यहोवे रे नाओं री कसम खाओ कि मैं एसरी जायदात नि चोरी; तेबे जायदाता रा मालक इजी खे सच्च मानो ओर दूजे खे तेसखे कुछ पनि देणा पड़ना। <verse eid="EXO 22:11" /><verse number="12" style="v" sid="EXO 22:12" />पर जे से डांगर पड़ोसिये रे कअरो तेई चोरी राखेया ओ, तो से तेसरे मालको खे तिजी री कीमत परी देओ। <verse eid="EXO 22:12" /><verse number="13" style="v" sid="EXO 22:13" />ओर जे तेस डांगरो रे किने जंगल़ी जानवरे टुकड़े-टुकड़े करीते ओ, तो से माणूं फाड़े रे सबूतो खे ली आओ, तेबे तेसखे तिजी रा नुकशाण नि परना पड़ना।<verse eid="EXO 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 22:14" />फेर जे कोई माणूं आपणे पड़ोसिये ते डांगर मांगी की ली आओ ओर तेसरा मालक साथे नि ओ ओर तेसरे बूड़ी जाओ या से मरी जाओ, तो से पक्का तेसरा नुकशाण परी देओ। <verse eid="EXO 22:14" /><verse number="15" style="v" sid="EXO 22:15" />पर जे तेस डांगरो रा मालक साथे ओ, तो दूजे माणूंए खे तेसरा नुकशाण नि परना पड़ना ओर जे से कराये पाँदे लई राखेया ओ तो तेसरा नुकशाण तेसरे कराये रे आईगा।<verse eid="EXO 22:15" /></para>
  <para style="s">चाल-चलण ओर तर्मो रे नियम</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 22:16" />जे कोई मर्द केसी जवान बेटिया खे जेसा रे ब्याओ री गल्ल नि लगी री ओ बईकाई की तेसा साथे गल़त काम करो, तो से जरूर तेसा री कीमत देई की तेसा साथे ब्या करी लो ओर से तेसरी लाड़ी ऊणी। <verse eid="EXO 22:16" /><verse number="17" style="v" sid="EXO 22:17" />पर जे तेसा रा बाओ तेसा खे देणे खे बिल्कुल ना करी देओ, तो गल़त काम करने वाल़ा तेसा बेटिया री कीमता रे मुताबिक पैसे तोली की देई देओ।<verse eid="EXO 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 22:18" />तैं डाग-डगुमा करने वाल़ी जवाणस जिऊँदी नि राखणी।<verse eid="EXO 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 22:19" />जो कोई पशुआ साथे गल़त काम करो से पक्का काया जाओ।<verse eid="EXO 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 22:20" />जो कोई यहोवे खे छाडी की केसी ओरी देवते खे बलि करो, तेसरा सत्यानाश कित्तेया जाओ।<verse eid="EXO 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 22:21" />तुसे परदेशिया खे नि सताएयो ओर ना ई तेस पाँदे अन्देर करना, कऊँकि मिस्र देशो रे तुसे बी परदेशी थे।<verse eid="EXO 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 22:22" />केसी बिदुआ या अनाथ बाल़को ते नाजाईज फाईदा नि लणा। <verse eid="EXO 22:22" /><verse number="23" style="v" sid="EXO 22:23" />जे तुसे एड़ेया ते नाजाईज फाईदा लओ ओर सेयो कोई बी मांगे पुकार करो, तो मां जरूर तिना री पुकार सुणनी; <verse eid="EXO 22:23" /><verse number="24" style="v" sid="EXO 22:24" />तेबे मेरा रोष पड़कणा ओर मां तुसे तलवारी साथे मरवाणे ओर तुसा री लाड़िया बिदुआ ओर तुसा रे बच्चे अनाथ ऊई जाणे।<verse eid="EXO 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 22:25" />जे तूँ मेरी प्रजा बीचा ते केसी शरीफो खे जो तांगे रओआ पैसे रा त्वार दे, तो तेसते महाजनो जेड़ा ब्याज नि लणा ओर तेसरे त्वारो रा फाईदा लंदे ऊए तेसखे कर्जदार नि बणाओ।<verse eid="EXO 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 22:26" />जे तूँ कदी आपणे पाई-बन्दुआ रे टाल्ले बन्दक बणाई की राखी बी लओ, तो सूरजो रे छिपणे ते पईले तेसखे वापस करी देया; <verse eid="EXO 22:26" /><verse number="27" style="v" sid="EXO 22:27" />कऊँकि से तेसगे एक ई टखणे खे ए, तेसरे शरीरो रा से एक ई टाल्ला ऊणा; तेबे से क्या टखी की सऊणा? ओर जेबे से मांगे पुकार करोगा, तेबे मां तेसरी पुकार सुणनी, कऊँकि आऊँ तो दया करने वाल़ा ए।<verse eid="EXO 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 22:28" />परमेशरो रा बेज्जती नि करना ओर ना ई आपणे लोका रे परदानो खे स्राप देणा।<verse eid="EXO 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 22:29" />आपणे डोरूआ री फसल ओर फल़ा रे रसो बीचा ते माखे देणे रे देरी नि करनी। आपणे माठेया बीचा ते जेठा बच्चा माखे देणा।<verse eid="EXO 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 22:30" />तिंयाँ ई आपणी गायी ओर पेडा-बाकरिया रे जेठे बच्चे बी माखे देणे; सात दिन तक तो बच्चा आपणी माया गे रओ ओर आठुए दिने से माखे देई देणा।<verse eid="EXO 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 22:31" />तुसे मेरिया तँईं पवित्र माणूं बणेयो, इजी बजअ ते जो डांगर मैदानो रे फाड़ेया रा मिलो तेसरा मास नि खाणा, से कुत्तेया सामणे सेटी देणा।<verse eid="EXO 22:31" /></para>
  <chapter eid="EXO 22" />
  <chapter number="23" style="c" sid="EXO 23" />
  <para style="s">न्याय ओर निष्पक्षता</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 23:1" />तूँ चूठिया गल्ला नि फैलाया। चूट्ठा गवाह् बणी की दुष्टो रा साथ नि देणा। <verse eid="EXO 23:1" /><verse number="2" style="v" sid="EXO 23:2" />जेती बऊत जणे केसी री बुराई करने खे कट्ठे ऊई रे ओ, तिना पीछे नि जाणा ओर ना तिना पीछे चली की मकद्दमा बिगाड़ने खे चूठी गवाई देणी<verse eid="EXO 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 23:3" />ओर गरीबो रे मकद्दमे रे पक्षपात नि करयो।<verse eid="EXO 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 23:4" />जे तेरे दुश्मणो रा बल़द या गह्दा पटकदा ऊआ ताखे मिलो, तो से तेसरे मालको गे जरूर वापस लई जाणा।<verse eid="EXO 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 23:5" />फेर जे तूँ आपणे दुश्मणो रे गह्दे खे बोजो साथे दबी की रूड़ेया रा देखो, तो चाए तेसखे तेसरे मालको खे छुड़ाणे रा तेरा मन नि करो, तेबे बी जरूर मालको रा साथ देई की तेस गह्दे री मताद करनी।<verse eid="EXO 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 23:6" />तेरे लोका बीचे जो गरीब ओ, तेसखे आपणी कचरिया रे न्याय दलाणे रे पीछे नि आटणा।<verse eid="EXO 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 23:7" />चूठे मकद्दमे ते दूर रणा ओर निर्दोष ओर तर्मी नि काणे, कऊँकि एड़े दुष्ट मां माफ नि करने।<verse eid="EXO 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 23:8" />रिश्वत नि लणी, कऊँकि रिश्वत देखणे वाल़े माणूंआ खे बी अन्दा करी देओई ओर तर्मिया रिया गल्ला बदली देओई।<verse eid="EXO 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 23:9" />परदेसिये पाँदे अन्देर नि करना; कऊँकि तुसे बी मिस्र देशो रे परदेशी थे इजी खे तुसे जाणोए कि एक परदेशी ऊई की रणा क्या ओआ।<verse eid="EXO 23:9" /></para>
  <para style="s">सातुआ साल ओर सातुआ दिन</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 23:10" />छे साला तक तो आपणी जमीन बाणी ओर तिजी री फसल कट्ठी करनी; <verse eid="EXO 23:10" /><verse number="11" style="v" sid="EXO 23:11" />पर सातुए साले से जमीन ईंयाँ ई पड़ी री राखणी ओर तिंयाँ ई छाडी देणी, ताकि तेरे पाई-बन्दुआ रे गरीब लोक तिजी ते खाई सको ओर जो कुछ तिना ते बी बचो, से बणो रे डांगरा रे खाणे रे कामे आओ ओर आपणे अंगूरा ओर जैतूना रे बगीचे रे बी एड़ा ई करना।<verse eid="EXO 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 23:12" />छे दिना तक तो आपणा काम-काज करना पर सातुए दिने राम करना ताकि तेरे बल़द ओर गह्दे सुस्ताओ ओर तेरी दासिया रे पाऊ ओर परदेशी बी जो तुसा बीचे जिऊँणे लगी रे राम करी सको।<verse eid="EXO 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 23:13" />चौकस रओ, जो कुछ मैं यहोवे तुसा खे बोली राखेया तिदे सम्मल़ी की रणा ओर दूजे देवतेया रे नाओं री गल्ल तक नि करनी ओर ना ई तिना रे नाओं तुसा रे मुंए ते निकल़ो बल्कि तुसा बीचे सुणने पनि चाईयो।<verse eid="EXO 23:13" /></para>
  <para style="s">तीन खास त्योआर</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 23:14" />हर साल तीन बार माखे त्योआर मनाणा। <verse eid="EXO 23:14" /><verse number="15" style="v" sid="EXO 23:15" />बिना सजेड़े रिया रोटिया रा त्योआर मनाणा; तिदे जिंयाँ मैं तुसा खे आज्ञा देई राखी तिजी रे मुताबिक आबीब मीन्ने<note caller="+" style="f"><char style="fr" closed="false">23:15 </char><char style="fq" closed="false">आबीब मीन्ने </char><char style="ft" closed="false">मतलब चैत्र मीन्ना या 15 मार्चो ते 15 अप्रैलो तक ए</char></note> रे ठीक बखतो पाँदे, साता दिना तक बिना सजेड़े री रोटी खाया करनी, कऊँकि तेस मीन्ने रेई तुसे मिस्र देशो ते निकल़ी की आए थे इजी खे तेस बखते कोई बी खाली आथे मां सामणे नि आओ बल्कि आपू साथे कुछ पेंट लई की आऊणा।<verse eid="EXO 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 23:16" />ओर जेबे तेरी बायी री फसला री पईली फसल त्यार ओ, तेबे बडाईया रा त्योआर मनाणा; फेर पूरी फसल कट्ठी करने ते बाद सालो रे आखरी रे फसल कट्ठी करने रा त्योआर मनाणा।<verse eid="EXO 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 23:17" />हर साल तीनो बार इस्राएलिया रे सारे मर्द परमेशर यहोवे री मौजुदगिया रे कट्ठा ओ।<verse eid="EXO 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 23:18" />मेरे बलिया रे डांगरो रा खून सजेड़ी रोटिया साथे नि चढ़ाणा ओर ना मेरे त्योआरो री चर्बिया बीचा ते कुछ प्यागा तक राखणी।<verse eid="EXO 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 23:19" />आपणी जमीना री पईली फसला रा पईला पाअग आपणे परमेशर यहोवे रे भवनो रे ली आऊणा। बाकरिया रा बच्चा तेसरी माया रे दूदो रे नि पकाणा।<verse eid="EXO 23:19" /></para>
  <para style="s">वादे ओर चेतावणी</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 23:20" />सुण, आऊँ एक दूत तांते आगे-आगे पेजुँआ, जिना बाटा रे तेरी रक्षा करनी ओर जो जगा मैं त्यार करी राखी, तिदे तूँ पऊँचाणा। <verse eid="EXO 23:20" /><verse number="21" style="v" sid="EXO 23:21" />तेस सामणे सम्मल़ी की रणा ओर तेसरी गल्ला मानणियां ओर तेसरी गल्ला रा बरोद नि करना, कऊँकि तेस तेरा पाप माफ नि करना; से इजी खे कि तेसदे मेरा नाओं रओआ। <verse eid="EXO 23:21" /><verse number="22" style="v" sid="EXO 23:22" />पर जे तूँ सच्ची तेसरी माने ओर जो कुछ आऊँ बोलूँ से करे, तो मां तेरे दुश्मणा रा दुश्मण ओर तेरे बरोदिये रा बरोदी बणी जाणा। <verse eid="EXO 23:22" /><verse number="23" style="v" sid="EXO 23:23" />ईंयाँ ई मेरे दूतो तांते आगे-आगे चली की तूँ एमोरी, हित्ती, परिज्जी, कनानी, हिब्बी ओर यबूसी लोका रे देशो रे पऊँचाणा ओर मां तिना रा सत्यानाश करी देणा।<verse eid="EXO 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 23:24" />तिना रे देवतेया गे माथा नि टेकणा ओर ना तिना री पूजा करनी ओर ना ई तिना जेड़े काम करने, बल्कि सेयो मूर्तिया पूरी तरअ ते नाश करी देणियां ओर तिना रे पूजा रे खम्बेया रे टुकड़े-टुकड़े करी देणे।<verse eid="EXO 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 23:25" />तैं आपणे परमेशर यहोवे री पूजा करनी, तेबे तेस तेरे नज्जो-पाणिए पाँदे आशीष देणी ओर मां तेरी बमारिया दूर करनिया।<verse eid="EXO 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 23:26" />तेरे देशो रे ना तो केसी री टाल़ जाणी ओर ना कोई बांझ ऊणी ओर मां ताखे लाम्बी उम्र देणी। <verse eid="EXO 23:26" /><verse number="27" style="v" sid="EXO 23:27" />जितणे लोका बीचे तूँ जाणा तिना सबी रे मनो रे मां पईले तेई आपणा डर एड़ा समायी देणा कि सेयो बेचैन ऊई जाणे ओर तेरे सारे दुश्मण तां सामणे ते मुड़ी की नठी जाणे। <verse eid="EXO 23:27" /><verse number="28" style="v" sid="EXO 23:28" />मां तांते पईले तिना पाँदे महामारी पेजणी, जेसा हिब्बी, कनानी ओर हित्ती लोक तेरे सामणे ते नठाई की दूर करी देणे। <verse eid="EXO 23:28" /><verse number="29" style="v" sid="EXO 23:29" />पर मां सेयो तेरे सामणे ते एक ई सालो रे तो नि निकयाल़ने, एड़ा नि ओ कि देश सुनसाण ऊई जाओ ओर बणो रे डांगर बढ़ी की तेरा नुकशाण करने लगो। <verse eid="EXO 23:29" /><verse number="30" style="v" sid="EXO 23:30" />जदुओ तक तूँ फल़ी-फूली की देशो खे आपणे अक्को रे नि करी लएगा, तदुओ तक मां सेयो तेरे सामणे ते थोड़े-थोड़े निकयाल़दे रणे। <verse eid="EXO 23:30" /><verse number="31" style="v" sid="EXO 23:31" />मां लाल समुद्रो ते लई की पलिश्तिया रे समुद्रो तक ओर सुनसाण जगा ते लई की फरात नदिया तको रे देश तेरे वशो रे करी देणे; मां तेस देशो रे रणे वाल़े बी तेरे वशो रे करी देणे ओर तां सेयो आपू सामणे ते जबरदस्ती निकयाल़ी देणे।<verse eid="EXO 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 23:32" />तैं ना तो तिना साथे ओर ना ई तिना रे देवतेया साथे कोई वाचा बानणी। <verse eid="EXO 23:32" /><verse number="33" style="v" sid="EXO 23:33" />तिना खे आपणे देशो रे रणे नि देओ, कऊँकि तिना मेरे खलाफ तांते पाप करवाणा; जे तूँ तिना रे देवतेया री पूजा करेगा, तो ये ताखे फन्दा बणना।<verse eid="EXO 23:33" /></para>
  <chapter eid="EXO 23" />
  <chapter number="24" style="c" sid="EXO 24" />
  <para style="s">यहोवा ओर इस्राएलिया बीचे वाचा बानणे रा बखाण</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 24:1" />फेर यहोवे मूसे खे इस्राएली लोका रिया तँईं बिधि-बिधान देणे ते बाद बोलेया, “तैं हारूण, नादाब, अबीहू ओर इस्राएलिया रे 70 स्याणेया समेत मांगे पाह्ड़ो पाँदे ऊबे आई की दूरो ते माथा टेकणा। <verse eid="EXO 24:1" /><verse number="2" style="v" sid="EXO 24:2" />जेबे सेयो दूरो ते माथा टेकणे लगी रे ओ तेबे बस मूसा यहोवे रे नेड़े आओ; पर सेयो लोक तेस साथे ऊबे नि आओ।”<verse eid="EXO 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 24:3" />तेबे मूसे लोका गे जाई की यहोवे रे जरीये सखाई रिया सारिया गल्ला ओर नियम सुणाई ते; तेबे सबी लोके मिली की बोलेया, “जितणिया गल्ला यहोवे बोली राखिया, सेयो सब गल्ला आसा मानणियां।” <verse eid="EXO 24:3" /><verse number="4" style="v" sid="EXO 24:4" />तेबे मूसे यहोवे रे जरीये बोले रे सारे वचन लिखी की राखी ते ओर तिने दूजे दिने प्यागा उठी की पाह्ड़ो निठे इस्राएलो रे बारा गोत्रा रे मुताबिक बारा खम्बे खड़े करी की एक बेदी बणाई। <verse eid="EXO 24:4" /><verse number="5" style="v" sid="EXO 24:5" />तेबे मूसे कई इस्राएली जवान पेजे, जिने यहोवे खे होमबलि ओर बाच्छूआ री मेलबलि चढ़ाई।<verse eid="EXO 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 24:6" />ओर मूसे आदा खून तो लई की कटोरे रे राखेया ओर आदा बेदिया पाँदे छिड़की ता। <verse eid="EXO 24:6" /><verse number="7" style="v" sid="EXO 24:7" />तेबे तिने वाचा री कताब लई की इस्राएली लोका गे पढ़ी की सुणाई; तिजी खे सुणी की लोके बोलेया, “जो कुछ यहोवे बोली राखेया से सब आसा करना ओर तेसरी आज्ञा मानणी।” <verse eid="EXO 24:7" /><verse number="8" style="v" sid="EXO 24:8" />तेबे मूसे कटोरे बीचा ते खून लई की लोका पाँदे छिड़की ता ओर तिना खे बोलेया, “देखो, ये तेसा वाचा रा खून ए, जो यहोवे इना सबी वचना रे आधारो पाँदे तुसा साथे बानी राखी।” <verse eid="EXO 24:8" /><verse number="9" style="v" sid="EXO 24:9" />तेबे मूसा ओर तेसरा पाई हारूण ओर हारूणो रे दोनो पाऊ नादाब ओर अबीहू ओर इस्राएलिया रे 70 स्याणे पाह्ड़ो पाँदे गये। <verse eid="EXO 24:9" /><verse number="10" style="v" sid="EXO 24:10" />ओर तिने तेती इस्राएलो रा परमेशर देखेया; ओर तेसरे पैरा निठे नीलमणिया रा चबूतरा जा था, जो नीले सर्गो जेड़ा साफ-सुथरा था। <verse eid="EXO 24:10" /><verse number="11" style="v" sid="EXO 24:11" />पर सेयो इस्राएलिया रे परमेशरो खे देखी की बी नाश नि ऊए ओर तिने परमेशरो री मौजुदगिया रे रोटी खाई।<verse eid="EXO 24:11" /></para>
  <para style="s">मूसे रा सीनै पाह्ड़ो पाँदे चढ़ना</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 24:12" />तेबे यहोवे मूसे खे बोलेया, “पाह्ड़ो पाँदे चढ़ी की मांगे आओ ओर तेती रओ ओर मां ताखे पात्थरो री तख़्तिया ओर आपणा लिखेया रा बिधि-बिधान ओर आज्ञा देणियां, ताकि तूँ तिना खे सिखाओ।”<verse eid="EXO 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 24:13" />तेबे मूसा यहोशू नाओं रे आपू साथे मताद करने वाल़े खे लई की परमेशरो रे पाह्ड़ो पाँदे चढ़ीगा। <verse eid="EXO 24:13" /><verse number="14" style="v" sid="EXO 24:14" />ओर मूसा पाह्ड़ो पाँदे चढ़ने ते पईले इस्राएलो रे स्याणेया खे ये बोली गा कि जदुओ तक आसे तुसा गे फेर नि आऊँगे, तदुओ तक तुसे एथी आसा खे न्याल़दे रओ ओर सुणो, हारूण ओर हूर तुसा साथे ए; इजी खे जे केसी रा कोई मकद्दमा ऊल़जी रा ओ तो तिना दुँईं गेई जाणा। <verse eid="EXO 24:14" /><verse number="15" style="v" sid="EXO 24:15" />तेबे मूसा पाह्ड़ो पाँदे चढ़ीगा ओर बादल़ पाह्ड़ो पाँदे छाई गे।<verse eid="EXO 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 24:16" />ओर यहोवे रा तेज सीनै पाह्ड़ो पाँदे आया ओर से बादल़ पाह्ड़ो पाँदे छे दिना तक छाया रा रया ओर सातुए दिने यहोवे मूसे खे बादल़ो बीचा ते आका पाईया। <verse eid="EXO 24:16" /><verse number="17" style="v" sid="EXO 24:17" />ओर इस्राएली लोका खे यहोवे रा तेज पाह्ड़ो री चूँडिया पाँदे प्रचण्ड आगी जेड़ा दिशो था। <verse eid="EXO 24:17" /><verse number="18" style="v" sid="EXO 24:18" />तेबे मूसा बादल़ो बीचे जाई की पाह्ड़ो पाँदे चढ़ीगा ओर मूसा पाह्ड़ो पाँदे चाल़ी दिन ओर चाल़ी रात रया।<verse eid="EXO 24:18" /></para>
  <chapter eid="EXO 24" />
  <chapter number="25" style="c" sid="EXO 25" />
  <para style="s">पवित्र जगा रिया तँईं पेंट</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 25:1" />यहोवे मूसे खे बोलेया, <verse eid="EXO 25:1" /><verse number="2" style="v" sid="EXO 25:2" />“इस्राएली लोका खे ये बोलणा कि मेरिया तँईं पेंट ल्याओ; जितणे बी आपणियां इच्छा रे मुताबिक देणा चाओए तिना सबी ते मेरी पेंट लणी। <verse eid="EXO 25:2" /><verse number="3" style="v" sid="EXO 25:3" />ओर जिना चीजा री पेंट तिना ते लणी से यो ए मतलब सूईना, चाँदी, पीतल़, <verse eid="EXO 25:3" /><verse number="4" style="v" sid="EXO 25:4" />नीले, बैंगणी ओर लाल रंगो रे टाल्ले, पतल़ा लीलणो रा टाल्ला, बाकरिया रे बाल़ <verse eid="EXO 25:4" /><verse number="5" style="v" sid="EXO 25:5" />लाल रंगो रे रंगी री खाडूए री खाल, बाकरेया री खाल, बबूल नाओं रे डाल़ो री लकड़ी, <verse eid="EXO 25:5" /><verse number="6" style="v" sid="EXO 25:6" />दिऊए बाल़ने खे जैतूनो रा तेल, अभिषेको रे तेलो खे खुशबूदार द्रव्य ओर खुशबूदार तूप, <verse eid="EXO 25:6" /><verse number="7" style="v" sid="EXO 25:7" />सुलैमानी पात्थर ओर मणिया खे जो बड़ा पुरोईत आपणी छातिया पाँदे पईनोआ से झिलम ओर एपोदो पाँदे जड़ने। <verse eid="EXO 25:7" /><verse number="8" style="v" sid="EXO 25:8" />फेर तिजी ते बाद सेयो माखे एक पवित्र रणे री जगा बणाओ कि आऊँ तिना बीचे रऊँ। <verse eid="EXO 25:8" /><verse number="9" style="v" sid="EXO 25:9" />जो कुछ आऊँ तुसा खे दखाऊँआ मतलब रणे री जगा ओर तिजी री सारी चीजा रा नमूना, तिजी रेई मुताबिक तुसे से बनाणा।”<verse eid="EXO 25:9" /></para>
  <para style="s">वाचा रा सन्दूक</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 25:10" />लोका खे एड़ा बोलो कि बबूल नाओं रे डाल़ो रिया लकड़िया रा एक सन्दूक बणाया, तिजी री लम्बाई टाई आथ, चौड़ाई डेढ़ आथ ओर ऊचाई डेढी आथो री थी। <verse eid="EXO 25:10" /><verse number="11" style="v" sid="EXO 25:11" />ओर तिदे पीतरा-बारा ते शुद्ध सूईने री परत चढ़ाणी ओर सन्दूको पाँदे चऊँ कनारेया ते सूईने री पट्टी लगाणी। <verse eid="EXO 25:11" /><verse number="12" style="v" sid="EXO 25:12" />ओर तैं तिजी रे चऊँ पावेया पाँदे सूईने रे चार कड़े बणवाई की दो कड़े एकी कनारे ओर दो कड़े दूजे कनारे लगाणे। <verse eid="EXO 25:12" /><verse number="13" style="v" sid="EXO 25:13" />तेबे बबूलो रिया लकड़िया रे डण्डे बनवाणे ओर सेयो बी सूईने साथे मढ़ने। <verse eid="EXO 25:13" /><verse number="14" style="v" sid="EXO 25:14" />ओर डण्डे सन्दूको रे दुँईं कनारेया रे कड़ेया रे पाणे ताकि तिना रे साअरे साथे सन्दूक चकेया जाओ। <verse eid="EXO 25:14" /><verse number="15" style="v" sid="EXO 25:15" />सेयो डण्डे सन्दूको रे कड़ेया रे लगे रे रओ ओर तिजी ते लग नि करने। <verse eid="EXO 25:15" /><verse number="16" style="v" sid="EXO 25:16" />फेर जो आज्ञा रिया पात्थरो रिया तख़्तिया मां ताखे देणियां से तिजी ई गवाईया रे सन्दूको दे राखणिया।<verse eid="EXO 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 25:17" />फेर शुद्ध सूईने रा एक दया रा आसण बनाणा तिजी री लम्बाई टाई आथ ओर चौड़ाई डेढ़ आथ ओ। <verse eid="EXO 25:17" /><verse number="18" style="v" sid="EXO 25:18" />ओर सूईना कअड़ी की दो करूब बणाई की दया रे आसणो रे दुँईं कनारेया रे लगाणे। <verse eid="EXO 25:18" /><verse number="19" style="v" sid="EXO 25:19" />एक करूब एकी कनारे पाँदे ओर दूजा करूब दूजे कनारे पाँदे लगाणा मतलब एकी ई टुकड़ेया ते तिना करूबा खे दया रे आसणो रे दुँईं कनारेया पाँदे लगवाई की बनाणा। <verse eid="EXO 25:19" /><verse number="20" style="v" sid="EXO 25:20" />ओर तिना करूबा रे पंख पाँदा ते एड़े फैले रे बणो कि दया रा आसण तिना साथे टखेया रा रओ ओर तिना रे मूँ आमणे-सामणे ओर दया रे आसणो रे कनारो खे रओ <verse eid="EXO 25:20" /><verse number="21" style="v" sid="EXO 25:21" />ओर दया रा आसण सन्दूको पाँदे लगाणा ओर जो आज्ञा रिया पात्थरो रिया तख़्तिया मां ताखे देणियां से गवाईया रे सन्दूको रे पीतरे राखणिया। <verse eid="EXO 25:21" /><verse number="22" style="v" sid="EXO 25:22" />ओर मां तेस पाँदे रई की ताखे मिलेया करना ओर इस्राएलिया खे जितणी आज्ञा मां ताखे देणियां ऊगिया तिना सबी रे बारे दे मां दया रे आसणो पाँदे ओर तिना करूबा बीचा ते जो आज्ञा रिया पात्थरो रिया तख़्तिया रे गवाईया रे सन्दूको पाँदे ऊणे, तां साथे गल्ला करेया करूँगा।<verse eid="EXO 25:22" /></para>
  <para style="s">पवित्र मेज</para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 25:23" />“फेर बबूलो रिया लकड़िया रा एक मेज बनाणा तिजी री लम्बाई दो आथ चौड़ाई एक आथ ओर ऊचाई डेढ़ आथो री ओ। <verse eid="EXO 25:23" /><verse number="24" style="v" sid="EXO 25:24" />से शुद्ध सूईने साथे मढ़वाई की तिजी रे चऊँ कनारे सूईने री पट्टी बनवाणी। <verse eid="EXO 25:24" /><verse number="25" style="v" sid="EXO 25:25" />ओर तिजी रे चऊँ कनारे चार आऊँगल़ चौड़ी एक चौखट बनवाणी ओर इजी चौखटा रे चऊँ कनारे सूईने री एक पट्टी बनवाणी <verse eid="EXO 25:25" /><verse number="26" style="v" sid="EXO 25:26" />ओर मेजो खे सूईने रे चार कड़े कअड़ी की तिना चऊँ कूणेया रे लगाणे, जो तिजी रे चऊँ पावेया रे ऊणे। <verse eid="EXO 25:26" /><verse number="27" style="v" sid="EXO 25:27" />सेयो कड़े चौखटा गे लगाणे ताकि तिना कड़ेया रे डण्डे पाई की मेज सानिया रे चखी जाओ। <verse eid="EXO 25:27" /><verse number="28" style="v" sid="EXO 25:28" />ओर बबूलो री लकड़िया रे डण्डे बणाई की सूईने साथे मढ़ने ओर मेज तिना तेई चकेया करना। <verse eid="EXO 25:28" /><verse number="29" style="v" sid="EXO 25:29" />ओर तेसरी परात ओर तूपदान, चमचे, लटणे रे कटोरे सब शुद्ध सूईने रे बनाणे। <verse eid="EXO 25:29" /><verse number="30" style="v" sid="EXO 25:30" />ओर मेजो पाँदे मेरे आगे पेंटा री रोटिया रोज राखेया करनिया।”<verse eid="EXO 25:30" /></para>
  <para style="s">सूईने री फट्टी</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 25:31" />“फेर शुद्ध सूईने री एक दिऊए राखणे री फट्टी बनाणी। सूईना कअड़ी की से दिऊए राखणे री फट्टी पावे ओर डण्डिया पाँदे तिजी रे फूला रिया डाल़िया, गाठ ओर फूल सब एक ई टुकड़े रे बणो <verse eid="EXO 25:31" /><verse number="32" style="v" sid="EXO 25:32" />ओर तिजी रे कनारेया ते छे डाल़िया निकल़ी री ओ। तीन डाल़िया तो दिऊए राखणे री फट्टिया रे एकी कनारे ते ओर तीन डाल़िया दूजे कनारे ते निकल़ी रिया ओ। <verse eid="EXO 25:32" /><verse number="33" style="v" sid="EXO 25:33" />एकी-एकी डाल़िया रे बदामो रे फूला जेड़े तीन-तीन फूल राखणे रिया कऊलिया, एक-एक गाठ ओर एक-एक फूल ओ, दिऊए राखणे री फट्टिया ते निकल़ी री इना छे डाल़िया रे एड़ा ई सब कुछ ओ। <verse eid="EXO 25:33" /><verse number="34" style="v" sid="EXO 25:34" />ओर फट्टिया री डण्डिया पाँदे बदामो रे फूलो जेड़ी गाठ ओर फूलो समेत चार फूल राखणे रिया कऊलिया जेड़िया बणी री ओ; <verse eid="EXO 25:34" /><verse number="35" style="v" sid="EXO 25:35" />ओर दिऊए राखणे री फट्टिया ते निकल़ी रिया छे डाल़िया बीचा ते दो-दो डाल़िया निठे एक-एक गाठ फट्टिया साथे एक ई टुकड़े ते बणे रे ओ। <verse eid="EXO 25:35" /><verse number="36" style="v" sid="EXO 25:36" />तिजी री गाठ ओर डाल़िया, सब दिऊए राखणे री फट्टिया समेत शुद्ध सूईना टल़ाई की पूरी दिऊए राखणे री फट्टी एकी टुकड़े कअड़ी की बनवाणी। <verse eid="EXO 25:36" /><verse number="37" style="v" sid="EXO 25:37" />तेबे सात दिऊए बनाणे ओर सेयो दिऊए, दिऊए राखणे री फट्टिया पाँदे बाल़े जाओ कि सेयो दिऊए राखणे री फट्टिया रे सामणे प्रयासा देओ। <verse eid="EXO 25:37" /><verse number="38" style="v" sid="EXO 25:38" />ओर तिजी रे चिमटे ओर आग चकणे रे पांडे सब शुद्ध सूईने रे ओ। <verse eid="EXO 25:38" /><verse number="39" style="v" sid="EXO 25:39" />दिऊए राखणे री फट्टी सब इना सारी चीजा समेत पैंती किलो शुद्ध सूईने रा बणो। <verse eid="EXO 25:39" /><verse number="40" style="v" sid="EXO 25:40" />चौकस रई की यो सब चीजा तेस नमूने जेड़िया बनाणियां, जो मैं ताखे एते पाह्ड़ो रे दखाई राखिया।”<verse eid="EXO 25:40" /></para>
  <chapter eid="EXO 25" />
  <chapter number="26" style="c" sid="EXO 26" />
  <para style="s">पवित्र तम्बू</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 26:1" />फेर मिलणे वाल़ा तम्बू दस पड़देया साथे बनवाणा; ये पड़दे नीले, बैंगणी ओर लाल रंगो रे टाल्लेया पाँदे कढ़ाई कराई की करूबो रे चित्रा साथे बनवाणे। <verse eid="EXO 26:1" /><verse number="2" style="v" sid="EXO 26:2" />एकी-एकी पड़दे री लम्बाई 28 आथ ओर चौड़ाई चऊँ आथा री ओ; सारे पड़दे एक जेड़े नापो रे ओ। <verse eid="EXO 26:2" /><verse number="3" style="v" sid="EXO 26:3" />पाँज पड़दे एकी-दूजे साथे सिली की जुड़े रे ऊणे चाईयो ओर जो पाँज पड़दे रणे सेयो बी एकी-दूजे साथे सिली की जुड़े रे ऊणे चाईयो। <verse eid="EXO 26:3" /><verse number="4" style="v" sid="EXO 26:4" />ओर जेती यो दोनो पड़दे सिली की जोड़े जाओ, तेती दुँईं कूणेया पाँदे नीले-नीले छल्ले लगवाणे। <verse eid="EXO 26:4" /><verse number="5" style="v" sid="EXO 26:5" />पड़देया रे दुँईं कूणेया पाँदे एक जेड़े आमणे-सामणे पंजा-पंजा छल्ले लगवाणे।<verse eid="EXO 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 26:6" />फेर सूईने रिया पंजा ऊका बनाणियां ओर पड़देया रे छल्ले ऊका रे जरीये एकी-दूजे साथे एड़े जुड़वाणे कि मिलणे वाल़ा तम्बू मिली की एक ई ऊई जाओ।<verse eid="EXO 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 26:7" />मिलणे वाल़े तम्बूए खे पांदा ते टकणे खे बाकरिया रे बाल़ो रे ग्यारा पड़दे बणाए जाओ। <verse eid="EXO 26:7" /><verse number="8" style="v" sid="EXO 26:8" />एकी-एकी पड़दे री लम्बाई 30 आथ ओर चौड़ाई चऊँ आथो री ओ, ग्यारा पड़दे एक जेड़े नापो रे ऊणे चाईयो। <verse eid="EXO 26:8" /><verse number="9" style="v" sid="EXO 26:9" />ओर पाँज पड़दे लग ओर छे पड़दे लग सिलाणे ओर छठा पर्दा मिलणे वाल़े तम्बूए सामणे मोड़ी की दोरा करी देणा।<verse eid="EXO 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 26:10" />ओर तैं पंजा कड़े तेस पड़दे रे कूणे रे जो बारा ते मलाया जाणा ओर पंजा ई कड़े दूजी तरफा रे पड़दे रे कूणे रे बनवाणे, जो बारा ते मलाया जाणा।<verse eid="EXO 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 26:11" />फेर पीतल़ी रे पंजा कड़े बनवाणे ओर कड़े छल्लेया रे लगाई की तम्बू एड़ा जुड़वाणा कि से मिली की एक ई ऊई जाओ।<verse eid="EXO 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 26:12" />ओर मिलणे वाल़े तम्बूए रे पड़देया रा लटकेया रा इस्सा, मतलब जो आदा बचेया रा टाल्ला रणा, से तम्बूए री पिछली तरफा खे लटकेया रा रओ। <verse eid="EXO 26:12" /><verse number="13" style="v" sid="EXO 26:13" />ओर मिलणे वाल़े तम्बूए रे पड़देया री लम्बाईया बीचा ते आथ परी ओरे ओर आथ परी पोरे तम्बूए खे टखणे खे तिजी रे दुँईं कनारे लटकेया रा रओ।<verse eid="EXO 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 26:14" />तेबे मिलणे वाल़े तम्बूए खे लाल रंगो रे रंगी की खाडूआ री खाला रा एक टखण बनाणा ओर तिजी पाँदे बाकरेया री खाला रा बी एक टखण बनाणा।<verse eid="EXO 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 26:15" />तेबे मिलणे वाल़े तम्बूए खे खड़ा करने खे बबूल नाओं रे डाल़ो री लकड़िया रे तख़्ते बनवाणे। <verse eid="EXO 26:15" /><verse number="16" style="v" sid="EXO 26:16" />एक-एक तख़्ते री लम्बाई दस आथ ओर चौड़ाई डेढ़ आथो री ऊणी चाईयो।<verse eid="EXO 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 26:17" />एकी-एकी तख़्ते रे एकी-दूजे साथे जुड़ी री दो-दो चूल़ा ओ; मिलणे वाल़े तम्बूए रे सारे तख़्ते ईंयाँ ई बनवाणे। <verse eid="EXO 26:17" /><verse number="18" style="v" sid="EXO 26:18" />ओर मिलणे वाल़े तम्बूए खे जो तख़्ते तां बनवाणे तिना बीचा ते 20 तख़्ते तो दक्खणा रिया तरफा खे ऊणे चाईयो <verse eid="EXO 26:18" /><verse number="19" style="v" sid="EXO 26:19" />ओर तिना तख़्तेया निठे चाँदिए रे 40 पावे बनवाणे, मतलब एक-एक तख़्ते निठे तिना रे चूल़ेया खे दो-दो पावे।<verse eid="EXO 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 26:20" />ओर मिलणे वाल़े तम्बूए री दूजी तरफा खे मतलब उत्तरो रिया तरफा खे 20 तख़्ते बनवाणे। <verse eid="EXO 26:20" /><verse number="21" style="v" sid="EXO 26:21" />तिना तख़्तेया खे बी 40 पावे बनवाणे मतलब एक-एक तख़्ते निठे दो-दो पावे ऊणे चाईयो।<verse eid="EXO 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 26:22" />ओर मिलणे वाल़े तम्बूए रे पिछली तरफा खे मतलब पश्चिमा रिया तरफा खे बी छे तख़्ते बनवाणे। <verse eid="EXO 26:22" /><verse number="23" style="v" sid="EXO 26:23" />पिछले इस्से रे मिलणे वाल़े तम्बूए खे दो तख़्ते बनवाणे <verse eid="EXO 26:23" /><verse number="24" style="v" sid="EXO 26:24" />इना दुँईं कूणेया खे बणाए रे दुँईं तख़्तेया रा नाप थाला ते पाँदले सिरे तक एक बराबर ओ ओर एकी कड़े रे लगाए रे ओ, तिना दुँईं तख़्तेया रा आकार एड़ा ई बनाणा ओ। <verse eid="EXO 26:24" /><verse number="25" style="v" sid="EXO 26:25" />आठ तख़्ते ओर ऊणे चाईयो ओर तिना रे चाँदिए रे 16 पावे ऊणे चाईयो मतलब एक-एक तख़्ते ते निठे दो-दो पावे ऊणे चाईयो।<verse eid="EXO 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 26:26" />बबूलो रिया लकड़िया रे डण्डे बनवाणे, मतलब मिलणे वाल़े तम्बूए रे एक तरफा रे पाँज तख़्ते, <verse eid="EXO 26:26" /><verse number="27" style="v" sid="EXO 26:27" />ईंयाँ मिलणे वाल़े तम्बूए री दूजी बगला रे तख़्ते खे पाँज डण्डे ओर मिलणे वाल़े तम्बूए री पश्चिमा री तरफा खे जो पिछले इस्से रे ऊणा तिजी खे बी पाँज डण्डे बनवाणे। <verse eid="EXO 26:27" /><verse number="28" style="v" sid="EXO 26:28" />बीचली कात जो तख़्ते रे बीचे ऊणी से तम्बूए रे एक सिरे ते दूजे सिरे तक पऊँचो।<verse eid="EXO 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 26:29" />फेर तख़्ते सूईने साथे मढ़वाणे ओर तिना रे कड़े जिना बीचे डण्डे लगाणे सेयो बी सूईने साथे मढ़वाणे।<verse eid="EXO 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 26:30" />तूँ मिलणे वाल़े तम्बूए खे ईंयाँ खड़ा कर जेड़ा एते पाह्ड़ो पाँदे ताखे दखाई राखेया।<verse eid="EXO 26:30" /></para>
  <para style="s">मिलणे वाल़े तम्बूए रा पितरला इस्सा</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 26:31" />फेर नीले, बैंगणी ओर लाल रंगो रे तागेया साथे बूणे रे लीलणो रे टाल्ले पाँदे कढ़ाई कराई की करूबो रे चित्रा साथे एक बीचला पड़दा बनवाणा। <verse eid="EXO 26:31" /><verse number="32" style="v" sid="EXO 26:32" />ओर तिजी खे सूईने साथे मढ़े रे बबूलो री लकड़िया रे चऊँ खम्बेया पाँदे लटकाणा। इना रे छल्ले बी सूईने रे ओ ओर ये चाँदिए रे चऊँ पावेया पाँदे खड़े रे रओ। <verse eid="EXO 26:32" /><verse number="33" style="v" sid="EXO 26:33" />ओर बीचला पड़दा छल्लेया निठे लटकाई की गवाईया रा सन्दूक तेस पड़दे पीछे पीतरे लई जाणा; इजी खे बीचला पड़दा तुसा खे पवित्र जगा खे परम पवित्र जगा ते लग करो। <verse eid="EXO 26:33" /><verse number="34" style="v" sid="EXO 26:34" />तेबे परम पवित्र जगा रे गवाईया रे सन्दूको पाँदे दया रे आसणो रा टकणा राखणा। <verse eid="EXO 26:34" /><verse number="35" style="v" sid="EXO 26:35" />तेस पड़दे ते बारे मिलणे वाल़े तम्बूए रे उत्तरो रिया तरफा खे पवित्र रोटिया खे मेज राखणी ओर तिजी री दक्खणा री तरफा खे मेजो रे सामणे दिऊए राखणे री फट्टी राखणी।<verse eid="EXO 26:35" /></para>
  <para style="s">मिलणे वाल़े तम्बूए रा मुख्य दरवाजा</para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 26:36" />तेबे मिलणे वाल़े तम्बूए रे द्धारो खे नीले, बैंगणी ओर लाल रंगो रे तागेया ते बूणे रे लीलणो रे टाल्लेया रे कढ़ाईया रा काम कित्ते रा एक पड़दा बनवाणा <verse eid="EXO 26:36" /><verse number="37" style="v" sid="EXO 26:37" />ओर एस पड़दे खे लगाणे खे बबूलो री लकड़िया रे पाँज खम्बे बनवाणे; सेयो सूईने साथे मढ़वाणे; तिना रे कड़े सूईने रे ओ ओर तिना खे पीतल़ी रे पाँज पावे बनवाणे।<verse eid="EXO 26:37" /></para>
  <chapter eid="EXO 26" />
  <chapter number="27" style="c" sid="EXO 27" />
  <para style="s">होमबलिया री बेदी</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 27:1" />फेर बेदी बबूलो री लकड़िया री पाँज आथ लाम्बी ओर पाँज आथ चौड़ी बनवाणी; बेदी चौरस ऊणी चाईयो ओर से तीन आथ ऊच्ची ऊणी चाईयो। <verse eid="EXO 27:1" /><verse number="2" style="v" sid="EXO 27:2" />ओर तिजी रे चारो कूणेया पाँदे चार सींग बनवाणे; ताकि सेयो सींग ओर बेदी एक ई लकड़िया रे टुकड़े रे बणो ओर से पीतल़ी साथे मढ़वाणे।<verse eid="EXO 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 27:3" />ओर तेतेरी स्वा चकणे खे पांडे फरूए, छिड़कणे खे कटोरे, मास निकाल़ने खे कांडे ओर गीठिया बनवाणियां; तिजी रा सारा समान पीतल़ी रा बनवाणा।<verse eid="EXO 27:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 27:4" />ओर तिजी रे पीतल़ी री जाल़िया री एक छानणी बनवाणी ओर तिजी रे चऊँ सिरेया पाँदे पीतल़ी रे चार कड़े लगवाणे। <verse eid="EXO 27:4" /><verse number="5" style="v" sid="EXO 27:5" />ओर से जाल़ी बेदिया रे चऊँ कनारली कंगणिया निठे एड़ी लगवाणी कि से बेदिया री ऊचाईया रे बीचे रओ।<verse eid="EXO 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 27:6" />बेदिया खे बबूलो री लकड़िया रे डण्डे बनवाणे ओर सेयो पीतल़ी साथे मढ़वाणे। <verse eid="EXO 27:6" /><verse number="7" style="v" sid="EXO 27:7" />ओर डण्डे कड़ेया रे पाये जाओ ताकि जेबे बेदी चकी जाओ तेबे सेयो तिजी खे दुँईं कनारेया ते पकड़ी सको। <verse eid="EXO 27:7" /><verse number="8" style="v" sid="EXO 27:8" />बेदी तख़्तेया साथे खोखली बनवाणी; जेड़ी से ताखे पाह्ड़ो पाँदे दखाई राखी।<verse eid="EXO 27:8" /></para>
  <para style="s">मिलणे वाल़ी जगा रा आँगण</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 27:9" />फेर मिलणे वाल़े तम्बूए री जगा रे आँगणो खे बणाओ। आँगणो री दक्खणा री तरफा खे लीलणो रे टाल्लेया रे बणे रे पड़दे ऊणे चाईयो ओर तिना री लम्बाई एकी तरफा खे 100 आथो री ऊणी चाईयो।<verse eid="EXO 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 27:10" />तिना रे 20 खम्बे ओर इना खे पीतल़ी रे 20 पावे बणो। पर खम्बेया रे कुण्डे ओर तिना खे जोड़ने वाल़ी पट्टिया चाँदिए रिया ऊणिया चाईयो।<verse eid="EXO 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 27:11" />ओर तेड़े ई आँगणो रे उत्तरो रिया तरफा री लम्बाईया रे बी 100 आथ लाम्बे पड़दे ऊणे चाईयो ओर तिना रे बी 20 खम्बे ओर इना खे बी पीतल़ी रे बीई पावे ऊणे चाईयो ओर तिना खम्बेया रे कुण्डे ओर पट्टिया चाँदिए रिया ओ।<verse eid="EXO 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 27:12" />तेबे आँगणो री चौड़ाईया रे पश्चिमो रिया तरफा खे 50 आथो रे पड़दे ऊणे चाईयो, तिना रे खम्बे 10 ओर पावे बी 10 ऊणे चाईयो।<verse eid="EXO 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 27:13" />पूर्वो रिया तरफा खे बी आँगणो री चौड़ाई 50 आथो री ओ। <verse eid="EXO 27:13" /><verse number="14" style="v" sid="EXO 27:14" />ओर आँगणो रे द्धारो रे एकी तरफा खे पंद्रा आथो रे पड़दे ऊणे चाईयो ओर तिजी रे तीन खम्बे ओर तीन पावे ऊणे चाईयो। <verse eid="EXO 27:14" /><verse number="15" style="v" sid="EXO 27:15" />आँगणो रे द्धारो री दूजी तरफा खे बी पंद्रा आथो रे पड़दे बणे रे ओ ओर तिना खे तीन खम्बे ओर तीन पावे ऊणे चाईयो।<verse eid="EXO 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 27:16" />आँगणो रे द्धारो खे एक पर्दा बनवाणा, जो नीले, बैंगणी ओर लाल रंगो रे तागेया ते लीलणो रे टाल्ले पाँदे बेल-बूटे री कढ़ाई कित्ते रा 20 आथो रा ऊणा चाईयो। तिजी रे खम्बे चार ओर पावे बी चार ऊणे चाईयो। <verse eid="EXO 27:16" /><verse number="17" style="v" sid="EXO 27:17" />आँगणो रे चऊँ कनारेया रे खम्बे चाँदिए री पट्टिया साथे जुड़े रे ऊणे चाईयो, तिना रे कुण्डे चाँदिए रे ओर पावे पीतल़ी रे ऊणे चाईयो। <verse eid="EXO 27:17" /><verse number="18" style="v" sid="EXO 27:18" />आँगणो री लम्बाई 100 आथो री ओर चौड़ाई बराबर 50 आथो री ओर पड़दे पाँज आथ ऊच्चे लीलणो रे टाल्लेया रे बणे रे ओ ओर खम्बेया रे पावे पीतल़ी रे ऊणे चाईयो। <verse eid="EXO 27:18" /><verse number="19" style="v" sid="EXO 27:19" />मिलणे वाल़े तम्बूए रे इस्तेमाल ऊणे वाल़े सबी प्रकारा रे पांडे, सारा समान, तम्बू गडणे रे सब खूँडे ओर आँगणो रे बी सारे खूँडे पीतल़ी रेई ऊणे चाईयो।<verse eid="EXO 27:19" /></para>
  <para style="s">दिऊए खे तेल</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 27:20" />तेबे तैं इस्राएलिया खे आज्ञा देणी कि मांगे दिऊए खे बाल़ने खे कोलूए रे पड़यायी की निकयाल़े रा जैतूनो रा साफ तेल लई आऊणा, ताकि दिऊआ सदा बल़दा रओ।<verse eid="EXO 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 27:21" />मिलणे वाल़े तम्बूए रे, तेस बीचले पड़दे ते बारे जो गवाईया रे सन्दूको ते आगे ऊणा, हारूण ओर तेसरे पाऊ दिऊए खे साँजा ते प्यागा तक परमेशरो सामणे बाल़ी की राखो। ये रवाज इस्राएलिया री पीढ़िया खे सदा बणी री रणी।<verse eid="EXO 27:21" /></para>
  <chapter eid="EXO 27" />
  <chapter number="28" style="c" sid="EXO 28" />
  <para style="s">पुरोईता रे टाल्ले</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 28:1" />तेबे परमेशर यहोवा मूसे खे एड़ी आज्ञा दित्ती कि तूँ आपणे पाई हारूण ओर तेसरे पाऊ नादाब, अबीहू, एलीआजार ओर ईतामारो खे इस्राएलिया बीचा ते आपू गे बुलाई लओ, ताकि सेयो मेरिया तँईं पुरोईतो रा काम करो। <verse eid="EXO 28:1" /><verse number="2" style="v" sid="EXO 28:2" />ओर तैं आपणे पाई हारूणो खे बांके ओर मान-सम्मानो जोगे पवित्र टाल्ले बनवाणे। <verse eid="EXO 28:2" /><verse number="3" style="v" sid="EXO 28:3" />ओर जितणे मैं एड़ा काम करने खे बुद्धि देणे वाल़ी आत्मा साथे परी राखे, तिना खे तूँ हारूणो रे टाल्ले बनवाणे री आज्ञा दे ताकि से मेरिया तँईं पुरोईतो रा काम करने खे पवित्र बणो। <verse eid="EXO 28:3" /><verse number="4" style="v" sid="EXO 28:4" />ओर जो टाल्ले तिना बनवाणे सेयो यो ए, मतलब छातिया पाँदली पट्टी, एपोद ओर बागा, चऊँ खानेया वाल़ा बुणेया रा चोगा, पुरोईतो री पगड़ी ओर कमरबंद, यो ई पवित्र टाल्ले तेरे पाई हारूणो खे ओर तेसरे पाऊआ खे बणवाए जाओ, ताकि सेयो मेरिया तँईं पुरोईतो रा काम करी सको। <verse eid="EXO 28:4" /><verse number="5" style="v" sid="EXO 28:5" />ओर सेयो सूईने, नीले, बैंगणी ओर लाल रंगो रे लीलणो रे टाल्ले लओ।<verse eid="EXO 28:5" /></para>
  <para style="s">एपोद ओर पटका</para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 28:6" />सेयो एपोद सूईने रा ओर नीले, बैंगणी ओर लाल रंगो रे तागेया ते लीलण नाओं रे टाल्लेया रा बणाओ। जेते पाँदे बूटेदार कढ़ाईया रा काम कित्ते रा ओ। <verse eid="EXO 28:6" /><verse number="7" style="v" sid="EXO 28:7" />ओर से ईंयाँ जोड़ेया जाओ कि तिजी रे दोनो फरकुआ रे सिरे आपू बीचे आगे-पीछे ते मिले रे ओ। <verse eid="EXO 28:7" /><verse number="8" style="v" sid="EXO 28:8" />ओर एपोदो पाँदे जो कढ़ाई कित्तेया रा पटका ऊणा तिजी री बुणाई तिजी जेड़ी ओ ओर सेयो दोनो बिना जोड़ो रे ओ ओर जो सूईने, नीले, बैंगणी ओर लाल रंगो रे तागेया ते बुणेया रा लीलणो रे टाल्लेया रा ओ।<verse eid="EXO 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 28:9" />फेर दो सुलैमानी पात्थरा री मणिया लई की तिना पाँदे इस्राएलो रे पाऊआ रे नाओं छापणे, <verse eid="EXO 28:9" /><verse number="10" style="v" sid="EXO 28:10" />तिना इस्राएलो रे पाऊआ रे नाओं जन्मो रे मुताबिक बड़े ते लई की छोटे तक छे तो एकी मणिया पाँदे ओर बाकि छे नाओं दूजी मणिया पाँदे खुदवाणे।<verse eid="EXO 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 28:11" />जिंयाँ एक सन्यार मणिया पाँदे छापा खोदोआ, तिंयाँ ई तिना दोनो मणिया पाँदे इस्राएलो रे पाऊआ रे नाओं कारीगरा ते खुदवाणे ओर सेयो सूईने रे खाँचेया रे जड़वाणे। <verse eid="EXO 28:11" /><verse number="12" style="v" sid="EXO 28:12" />ओर दोनो मणिया एपोदो रे फरकुआ पाँदे लगवाणिया, सेयो इस्राएलिया खे याद दलाणे वाल़िया मणिया ठईरनियां; मतलब हारूण तिना रे नाओं यहोवे रे आगे आपणे दुँईं फरकुआ पाँदे याद करने खे लगाई की राखो।<verse eid="EXO 28:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 28:13" />तेबे सूईने रे खांचे बनवाणे।<verse eid="EXO 28:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 28:14" />ओर तैं रस्सिया जेड़ी बाटी री शुद्ध सूईने रिया दो माल़ा बनवाणियां ओर सेयो रस्सिया जेड़ी बाटी री सूईने रिया माल़ा तिना खाँचेया रे जड़वाई देणियां।<verse eid="EXO 28:14" /></para>
  <para style="s">छातिया पाँदे पईनणे वाल़ा झिलम</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 28:15" />एक सई फैंसला लणे वाल़ा छातिया पाँदे पईनणे वाल़ी झिलम बी कारीगरो रे आथो ते कढ़ाई करी की बनवाणा; ये एपोदो जेड़ा सूईने, नीले, बैंगणी ओर लाल रंगो रे तागेया रा ठीक टंगो ते बुणेया रा लीलणो रे टाल्लेया रा बनवाणा।<verse eid="EXO 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 28:16" />से चकोर ओर दोरी ऊणी चाईयो तिजी री लम्बाई ओर चौड़ाई नौ-नौ गिर्ठ ऊणी चाईयो।<verse eid="EXO 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 28:17" />ओर तिदे चार पाल़िया मणिया री लगाणियां। पईली पाल़िया रे तो माणिक्य, पुखराज ओर लालड़ी ऊणी चाईयो।<verse eid="EXO 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 28:18" />दूजी पाल़िया रे मरकत, नीलमणि ओर ईरा;<verse eid="EXO 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 28:19" />तीजी पाल़िया रे लशम, सूर्यकांत ओर नीलम;<verse eid="EXO 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 28:20" />ओर चौथी पाल़िया रे फिरोजा, सुलैमानी पात्थरा री मणि ओर यशब ऊणे चाईयो; यो सब सूईने रे खाँचेया रे लगाए जाओ।<verse eid="EXO 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 28:21" />ओर इस्राएलो रे पाऊआ रे बारा गोत्रा रे नाओं री गिणतिया रे मुताबिक बारा मणिया पाँदे एकी-एकी रे नाओं एकी-एकी छापा दे खुदवाणे।<verse eid="EXO 28:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 28:22" />तेबे छातिया पाँदे पईनणे वाल़ी झिलमा पाँदे रस्सिया जेड़ी बाटी री शुद्ध सूईने री माल़ा लगवाणी। <verse eid="EXO 28:22" /><verse number="23" style="v" sid="EXO 28:23" />ओर छातिया पाँदे पईनणे वाल़े झिलमो रे सूईने रे दो कड़े लगवाणे ओर दोनो कड़े छातिया पाँदे पईनणे वाल़ी झिलमा रे दुँईं सिरेया पाँदे लगवाणे। <verse eid="EXO 28:23" /><verse number="24" style="v" sid="EXO 28:24" />फेर सूईने री दोनो रस्सिया जेड़ी बाटी रिया माल़ा छातिया पाँदे पईनणे वाल़े झिलमो वाल़ी झिलमा रे तिना दुँईं कड़ेया रे लगवाणिया; <verse eid="EXO 28:24" /><verse number="25" style="v" sid="EXO 28:25" />ओर सूईने री दुँईं जंजीरा रे दोनो सिरे एपोदो रे सामणे दुँईं कान्दा रे बन्दनो पाँदे लगवाणे। <verse eid="EXO 28:25" /><verse number="26" style="v" sid="EXO 28:26" />फेर सूईने रे दो ओर कड़े बणवाई की छातिया पाँदे पईनणे वाल़े झिलमो रे दुँईं सिरे पाँदे एपोदो रे पीतरली तरफा खे लगवाए। <verse eid="EXO 28:26" /><verse number="27" style="v" sid="EXO 28:27" />फेर सूईने रे ओर दो कड़े बणाए ओर एपोदो री दुँईं कान्दा रे बन्दनो पाँदे थाला ते एपोदो रे सामणे ओर जोड़ो गे, एपोदो रे कढ़ाई कित्ते रे पट्टके पाँदे लगवाणे।<verse eid="EXO 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 28:28" />ओर छातिया पाँदे पईनणे वाल़ी झिलम तिजी रे कड़ेया रे जरीये एपोदो रे कड़ेया रे नीली डोरिया साथे एड़ा बानेया कि से एपोदो रे पट्टके पाँदे रओ ओर छातिया पाँदे पईनणे वाल़ी झिलम एपोदो ते लग नि ऊई सको।<verse eid="EXO 28:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 28:29" />जेबे-जेबे हारूण पवित्र जगा रे जाओ, तेबे-तेबे से यहोवे रे सामणे आपणे दिलो पाँदे इस्राएलो रे पाऊआ रे नाओं खे सई फैंसला लणे वाल़ा छातिया पाँदे पईनणे वाल़ा झिलम लगाई की राखो, जेते की यहोवे रे सामणे तिना री याद हमेशा रओ। <verse eid="EXO 28:29" /><verse number="30" style="v" sid="EXO 28:30" />तिजी साथे तैं ऊरीम ओर तुम्मीम<note caller="+" style="f"><char style="fr" closed="false">28:30 </char><char style="fq" closed="false">ऊरीम ओर तुम्मीम </char><char style="ft" closed="false">ये मिस्र देशो ते ल्याये रे कीमती पात्थर थे ओर तिना रे जरीये परमेशरो री इच्छा प्रकट ओ थी</char></note> सई फैंसला लणे वाल़ा छातिया पाँदे पईनणे वाल़े झिलमो पाँदे लगाई की राखणे ताकि जेबे-जेबे हारूण यहोवे रे सामणे आओ, तेबे-तेबे सेयो तेसरे दिलो पाँदे ओ; ईंयाँ हारूण इस्राएलिया रिया तँईं आपणे दिलो पाँदे यहोवे रे सामणे सई फैंसला लंदा रणा।<verse eid="EXO 28:30" /></para>
  <para style="s">ओर पुरोईतो रे टाल्ले</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 28:31" />फेर एपोदो रा चोगा पूरे नीले रंगो रे तागेया रा बनाणा। <verse eid="EXO 28:31" /><verse number="32" style="v" sid="EXO 28:32" />तिजी बीचे सिर पाणे खे छेद ओ ओर तेते छेदो रे चऊँ कनारे बख्तरो रे छेदो जेड़ा एक गोटा लगाओ ताकि ये फटी नि सको। <verse eid="EXO 28:32" /><verse number="33" style="v" sid="EXO 28:33" />ओर तेते टाल्ले रे थालले केरे रे चऊँ कनारे नीले, बैंगणी ओर लाल रंगो रे तागेया ते अनार बनवाणे ओर तिना बीचे चऊँ कनारे सूईने रिया कंटिया लगवाणिया, <verse eid="EXO 28:33" /><verse number="34" style="v" sid="EXO 28:34" />मतलब एक सूईने री कंटी ओर एक अनार, फेर एक सूईने री कंटी ओर एक अनार, ईंयाँ ई चोगे रे थालले केरे रे चऊँ कनारे एड़ा ई करना।<verse eid="EXO 28:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 28:35" />ओर हारूण तेस चोगे खे सेवा-टईल करदे बखते पईनेया करो, ताकि जेबे-जेबे से पवित्र जगा रे पीतरे यहोवे रे सामणे जाओ या बारे निकल़ो, तेबे-तेबे तेते कंटिया री आवाज सुणो, नई तो से मरी जाणा।<verse eid="EXO 28:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 28:36" />तेबे शुद्ध सूईने री दो आऊँगल़ चौड़ी पट्टी बनवाणी; जेते पाँदे छापे रे ये अक्षर खुदवाणे, कि यहोवे खे पवित्र। <verse eid="EXO 28:36" /><verse number="37" style="v" sid="EXO 28:37" />तिजी खे नीली डोरिया साथे पगड़िया दे बानणा ओर से पगड़िया रे सामणे वाल़े इस्से दे रओ। <verse eid="EXO 28:37" /><verse number="38" style="v" sid="EXO 28:38" />से हारूणो रे माथे पाँदे रओ, ताकि इस्राएली जो कुछ पवित्र ठराओ, मतलब जितणिया पवित्र चीजा पेंटा रे चढ़ाओ तेबे तिना पवित्र चीजा रा दोष हारूणो आपू पाँदे लणा ओर से हमेशा तेसरे माथे पाँदे रओ ताकि यहोवा तिना ते खुश रओ।<verse eid="EXO 28:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="EXO 28:39" />चोगा लीलणो रे टाल्ले रा चार खाने वाल़ा बुणवाणा ओर एक पगड़ी बी लीलणो रे टाल्ले री बनवाणी ओर पटका तो ठीक टंगो रे कढ़ाई करी की बेल-बूटे वाल़ा बनवाणा।<verse eid="EXO 28:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 28:40" />तेबे हारूणो रे पाऊआ खे बी लीलणो रे चोगे, पटके ओर टोपिया बनवाणियां ताकि तिना रे टाल्लेया रे तिना रा वैभव ओर आदर बणेया दा रओ। <verse eid="EXO 28:40" /><verse number="41" style="v" sid="EXO 28:41" />आपणे पाई हारूण ओर तेसरे पाऊआ खे यो ई टाल्ले पन्याई की तिना रा अभिषेक करना। फेर सेयो मेरिया तँईं पुरोईतो रा काम करने खे पवित्र करने।<verse eid="EXO 28:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 28:42" />तिंयाँ ई तिना खे लीलणो रे टाल्लेया रिया निकरा बनवाणियां जेते कि तिना रा लको ते जानूआ तक तन टखेया रा रओ। <verse eid="EXO 28:42" /><verse number="43" style="v" sid="EXO 28:43" />जेबे-जेबे हारूण ओर तेसरे पाऊ मिलणे वाल़े तम्बूए रे जाई की पवित्र जगा रे सेवा-टईल करने री बेदिया गे जाओ, तेबे-तेबे सेयो तिना निकरा खे पईनी की राखो, नई तो सेयो दोषी ठईरने ओर मरी जाणे। ये हारूणो खे ओर तेसते बाद तेसरे वंशो खे बी सदा री रवाज ठईरो।<verse eid="EXO 28:43" /></para>
  <chapter eid="EXO 28" />
  <chapter number="29" style="c" sid="EXO 29" />
  <para style="s">पुरोईतो रे पदो खे अभिषेक</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 29:1" />तूँ हारूण ओर तेसरे पाऊआ खे पवित्र करने खे ये काम करना जेते कि सेयो मेरिया तँईं पुरोईतो रा काम करो; से ये ए कि तैं एक बिना नुक्शो रा बाच्छू ओर दो बिना नुक्शो रे खाडू लणे, <verse eid="EXO 29:1" /><verse number="2" style="v" sid="EXO 29:2" />कणका रे मैदे ते बणी री बिना सजेड़े रिया रोटिया, जैतूनो रे तेलो साथे गूने रे मैदे रे बिना सजेड़े रे फुलके ओर जैतूनो रे तेलो साथे चोपड़ी री बिना सजेड़े रिया पापड़िया बी लणियां। <verse eid="EXO 29:2" /><verse number="3" style="v" sid="EXO 29:3" />इना खे एक टोकरिया रे राखी की तेसा टोकरिया खे तेस बाच्छूए ओर तिना दुँईं खाडूआ समेत मां नेड़े ल्याऊणा।<verse eid="EXO 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 29:4" />फेर हारूण ओर तेसरे पाऊ मिलणे वाल़े तम्बूए रे द्धारो रे नेड़े आयी की पाणिए साथे नुल़ाणे। <verse eid="EXO 29:4" /><verse number="5" style="v" sid="EXO 29:5" />तेबे सेयो टाल्ले लई की हारूणो खे चोगा पन्याणा ओर एपोदो साथे पईनी जाणे वाल़ी पगड़ी, एपोदो ओर छातिया पाँदे पईनणे वाल़ी झिलम बानणी ओर एपोदो रा कढ़ाई कित्तेया रा पटका बी बानणा; <verse eid="EXO 29:5" /><verse number="6" style="v" sid="EXO 29:6" />तेसरे सिरो पाँदे पगड़ी राखणी ओर पगड़िया पाँदे सूईने रा पवित्र मुकुट राखणा। <verse eid="EXO 29:6" /><verse number="7" style="v" sid="EXO 29:7" />फेर अभिषेको रा तेल लई की तेसरे सिरो पाँदे पाई की तेसरा अभिषेक करना।<verse eid="EXO 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 29:8" />फेर तेसरे पाऊ नेड़े ल्याई की तिना खे चोगे पन्याणे <verse eid="EXO 29:8" /><verse number="9" style="v" sid="EXO 29:9" />हारूण ओर तेसरे पाऊआ रे लक पटके की बानणे ओर तिना रे सिरो पाँदे टोपिया राखणियां; जेते की पुरोईतो रे पद तिना खे सदा री रवाज ठईरो। ईंयाँ तैं हारूण ओर तेसरे पाऊआ रा पुरोईतो रे पदो रिया तँईं अभिषेक करना।<verse eid="EXO 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 29:10" />तेबे बाच्छू मिलणे वाल़े तम्बूए रे नेड़े ली आऊणा। हारूण ओर तेसरे पाऊ बाच्छूए रे सिरो पाँदे आपणे आथ राखो। <verse eid="EXO 29:10" /><verse number="11" style="v" sid="EXO 29:11" />तेबे तेस बाच्छूए खे यहोवे रे सामणे मिलणे वाल़े तम्बूए रे द्धारो पाँदे बलिदान करना, <verse eid="EXO 29:11" /><verse number="12" style="v" sid="EXO 29:12" />फेर तेस बाच्छूए रे खूनो बीचा ते कुछ लई की आपणी गूठिया साथे बेदिया रे सींगो पाँदे लगाणा ओर बाकि सारा खून बेदिया रे पावेया पाँदे लटी देणा। <verse eid="EXO 29:12" /><verse number="13" style="v" sid="EXO 29:13" />तूँ तेते चर्बिया खे जेते की आंतड़िया टकी रिया रओईया ओर जो झिल्ली कल़ेजे पाँदे ओई ओर चर्बिया समेत दोनो गुर्दे लई की सब बेदिया पाँदे फूकणे।<verse eid="EXO 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 29:14" />पर बाच्छूए रा मांस, खाल ओर गोबर लोका रे डेरे री जगा ते बारे आगी रे फूकी देणे, कऊँकि ये पापबलि ऊणा।<verse eid="EXO 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 29:15" />तेबे एक खाडू लणा ओर हारूण ओर तेसरे पाऊ तेस खाडूए रे सिरो पाँदे आपणे-आपणे आथ राखो, <verse eid="EXO 29:15" /><verse number="16" style="v" sid="EXO 29:16" />तेबे से खाडू बलि करना ओर तेसरा खून लई की बेदिया रे चऊँ कनारे छिड़कणा। <verse eid="EXO 29:16" /><verse number="17" style="v" sid="EXO 29:17" />से खाडू टुकड़े-टुकड़े करी की बाडणा ओर तेसरी आंतड़िया ओर खुर तोयी की तिना रे टुकड़े करी की तेसरे सिरो पाँदे राखणे। <verse eid="EXO 29:17" /><verse number="18" style="v" sid="EXO 29:18" />फेर से पूरा खाडू बेदिया पाँदे फूकणा; से तो यहोवे खे होमबलि ऊणी; से सुख देणे वाल़ा खुशबूदार ओर यहोवे खे अवन ऊणा।<verse eid="EXO 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 29:19" />तिजी ते बाद दूजा खाडू लणा फेर हारूण ओर तेसरे पाऊ तेसरे सिरो पाँदे आपणे-आपणे आथ राखो, <verse eid="EXO 29:19" /><verse number="20" style="v" sid="EXO 29:20" />तेबे से खाडू बलि करना ओर तेसरे खूनो बीचा ते थोड़ा जा लई की हारूण ओर तेसरे पाऊआ रे दाँणे कानो रे सिरे पाँदे, तिना रे दाँणे आथो रे गूठे रे ओर दाँणे पैरो रे गूठे रे लगाणा ओर बाकि खून बेदिया रे चऊँ कनारिये छिड़की देणा। <verse eid="EXO 29:20" /><verse number="21" style="v" sid="EXO 29:21" />तेबे बेदिया पाँदला खून ओर अभिषेको रा तेल, इना दुँईं बीचा ते थोड़ा-थोड़ा लई की हारूण ओर तेसरे टाल्लेया पाँदे ओर तेसरे पाऊ ओर तिना रे टाल्लेया पाँदे छिड़की देणा, तेबे हारूण ओर तेसरे पाऊ आपणे-आपणे टाल्लेया समेत पवित्र ऊई जाणे।<verse eid="EXO 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 29:22" />तेबे खाडूआ खे पुरोईतो रे संस्कारो रा समजी की तिजी बीचा ते चर्बी ओर मोटी पूँछ, ओर आंजा पाँदली सारी चर्बी जो कल़ेजे पाँदली झिल्लिया समेत दोनो गुर्देया पाँदे रओई ओर दाँणी खुटी, यो सब लई की लग राखणे।<verse eid="EXO 29:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 29:23" />यहोवे रे सामणे राखी री बिना सजेड़े रिया रोटिया री टोकरिया बीचा ते तेलो साथे गूँने रे मैदे रा एक फुलका ओर एक पापड़ी लई की, <verse eid="EXO 29:23" /><verse number="24" style="v" sid="EXO 29:24" />यो सब हारूण ओर तेसरे पाऊआ रे आथो रे राखी की ईलाई जाणे री पेंट ठराई की यहोवे रे सामणे ईलाई जाओ। <verse eid="EXO 29:24" /><verse number="25" style="v" sid="EXO 29:25" />तेबे से मास ओर रोटिया तिना रे आथो ते लई की होमबलिया री बेदिया पाँदे फूकी देणियां, जेते कि से यहोवे खे सुख देणे वाल़ी खुशबू ठईरो, ये तो यहोवे खे आगी रे चढ़ाई री बलि ऊणी। <verse eid="EXO 29:25" /><verse number="26" style="v" sid="EXO 29:26" />फेर हारूणो रे संस्कार करने रिया तँईं ठराया रा जो खाडू ऊणा तेसरी छाती लई की ईलाई जाणे री पेंट जेड़ी यहोवे रे सामणे इलाणी; फेर से तेरा पाअग ठईरना। <verse eid="EXO 29:26" /><verse number="27" style="v" sid="EXO 29:27" />ओर हारूण ओर तेसरे पाऊआ रे संस्कारो रे खाडूए री छाती ओर पाट जो ईलाई जाणे री पेंट ए, यो दोनो पवित्र ठराणे। <verse eid="EXO 29:27" /><verse number="28" style="v" sid="EXO 29:28" />ओर ये इस्राएलिया री तरफा ते हारूण ओर तेसरे पाऊआ रा सदा री बिदिया रा यहोवे रे सामणे चकणे वाल़ी पेंटा वाल़ा पाअग ठईरो, कऊँकि ये इस्राएलिया री तरफा ते तिना री मेलबलिया बीचा ते ऊणी।<verse eid="EXO 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 29:29" />हारूणो रे पवित्र टाल्ले तेसरी मौता ते बाद तेसरे माठेया, पोतेया बगैरा खे पुरोईतो रे पदो खे मिलदे रओ, ताकि तिना टाल्लेया खे पईनी की सेयो अभिषेक पाओ ओर पुरोईतो रे पदो खे ठराए जाओ। <verse eid="EXO 29:29" /><verse number="30" style="v" sid="EXO 29:30" />तेसरा पाऊ जो तेसरी जगा पाँदे पुरोईत ऊणा, से जेबे पवित्र जगा रे सेवा-टईल करने खे मिलणे वाल़े तम्बूए रे पईले आओ, तेबे तिना टाल्लेया खे साता दिना तक पईनी की राखो।<verse eid="EXO 29:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 29:31" />फेर पुरोईतो रे संस्कार करने रा जो खाडू ऊणा से लई की तेसरा मास केथी पवित्र जगा रे पकाणा। <verse eid="EXO 29:31" /><verse number="32" style="v" sid="EXO 29:32" />तेबे हारूण आपणे पाऊआ समेत तेस खाडूए रा मास ओर टोकरिया री रोटी, दुँईं खे मिलणे वाल़े तम्बूए रे द्धारो पाँदे खाओ।<verse eid="EXO 29:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 29:33" />जिना चीजा साथे तिना रा अभिषेक ओर तिना खे पवित्र करने खे प्राश्चित करेया जाणा तिना खे तो सेयो खाओ, पर पराये कुलो रा कोई बी तिना खे नि खाओ, कऊँकि सेयो पवित्र ऊणे। <verse eid="EXO 29:33" /><verse number="34" style="v" sid="EXO 29:34" />ओर जे संस्कारो वाल़े मासो बीचा ते ओर रोटिया बीचा ते कुछ प्यागा खे बची जाओ, तो से बचेया रा आगी रे फूकी देणा, से नि खाणा, कऊँकि से पवित्र ऊणा। <verse eid="EXO 29:34" /><verse number="35" style="v" sid="EXO 29:35" />मैं ताखे जो-जो आज्ञा देई राखिया, तिना सबी रे मुताबिक तैं हारूण ओर तेसरे पाऊआ साथे करना ओर सात दिन तक तिना रा अभिषेक करदे रणा, <verse eid="EXO 29:35" /><verse number="36" style="v" sid="EXO 29:36" />पापबलिया रा एक बाच्छू प्राश्चित करने खे हर रोज चढ़ाणा ओर बेदी बी प्राश्चित करने रे बखते शुद्ध करनी ओर तिजी खे पवित्र करने खे तिजी रा अभिषेक करना। <verse eid="EXO 29:36" /><verse number="37" style="v" sid="EXO 29:37" />साता दिना तक बेदिया खे प्राश्चित करी की से पवित्र करनी; तेबे बेदी परम पवित्र ठईरनी ओर जो कुछ तेसा साथे छवांणा से बी पवित्र ऊई जाणा।<verse eid="EXO 29:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="EXO 29:38" />जो ताखे बेदिया पाँदे हर रोज चढ़ाणा से ये ए; मतलब हर रोज एकी-एकी सालो रे दो पेडा रे मिन्टू। <verse eid="EXO 29:38" /><verse number="39" style="v" sid="EXO 29:39" />एक मिन्टू तो प्यागा रे बखते ओर दूजा मिन्टू साँजके बखते चढ़ाणा। <verse eid="EXO 29:39" /><verse number="40" style="v" sid="EXO 29:40" />एकी पेडा रे मिन्टूए साथे एक किलो मैदा, एक लीटर जैतूनो रा कूटी की निकयाल़े रा तेल ओर एक लीटर अंगूरा रा रस देणा। <verse eid="EXO 29:40" /><verse number="41" style="v" sid="EXO 29:41" />ओर दूजा पेडा रा मिन्टू साँजके बखते पेंट चढ़ाणा ओर तेस साथे प्यागा री रीतिया रे मुताबिक नज्जो री होमबलि ओर अर्घ दोनो देणे, जेते कि से सुखदायक खुशबू ओर यहोवे खे अवन ठईरो। <verse eid="EXO 29:41" /><verse number="42" style="v" sid="EXO 29:42" />तुसा री पीढ़िया ते पीढ़िया तक यहोवे रे सामणे मिलणे वाल़े तम्बूए रे द्धारो पाँदे हमेशा एड़ी ई होमबलि ओया करो, ये से जगा ए जिदे आऊँ तुसा लोका साथे मिलेया करूँगा ताकि तुसा लोका साथे गल्ला करुँ। <verse eid="EXO 29:42" /><verse number="43" style="v" sid="EXO 29:43" />तेती बी मां इस्राएलिया साथे तेथी मिलेया करना ओर से मिलणे वाल़ा तम्बू मेरे तेजो साथे पवित्र करेया जाणा।<verse eid="EXO 29:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="EXO 29:44" />ईंयाँ मां मिलणे वाल़ा तम्बू ओर बेदी पवित्र करने ओर हारूण ओर तेसरे पाऊ बी पवित्र करने ताकि सेयो मेरिया तँईं पुरोईतो रा काम करो।<verse eid="EXO 29:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="EXO 29:45" />तेबे मां इस्राएलिया बीचे रणा ओर तिना रा परमेशर ठईरूँगा। <verse eid="EXO 29:45" /><verse number="46" style="v" sid="EXO 29:46" />तेबे तिना खे पता लगी जाणा कि आऊँ यहोवा तिना रा परमेशर ए, जो तिना खे मिस्र देशो ते इजी खे निकयाल़ी की ल्याया, ताकि आँऊ तिना बीचे रऊँ; आऊँ ई तिना रा परमेशर यहोवा ए।<verse eid="EXO 29:46" /></para>
  <chapter eid="EXO 29" />
  <chapter number="30" style="c" sid="EXO 30" />
  <para style="s">तूप बाल़ने री बेदी</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 30:1" />यहोवे मूसे ते गल्ला करदे ऊए बोलेया, “तैं बबूलो री लकड़िया री तूपबेदी बी बनाणी। <verse eid="EXO 30:1" /><verse number="2" style="v" sid="EXO 30:2" />तिजी री लम्बाई ओर चौड़ाई एक-एक आथो री ओ ओर से चौरस ऊणी चाईयो, से दो आथ ऊच्ची ओ ओर तिजी रे सींग बी तिजी रे टुकड़े की बणाए जाओ। <verse eid="EXO 30:2" /><verse number="3" style="v" sid="EXO 30:3" />ओर तूप बेदिया पाँदले पल्ले, चऊँ तरफा रे कुणे ओर सींगो समेत से बेदी शुद्ध सूईने साथे मढ़वाणे, इजी रे चारो कनारे सूईने री एक बाड़ बनाणा। <verse eid="EXO 30:3" /><verse number="4" style="v" sid="EXO 30:4" />ओर एते बेदिया री बाड़ा ते थाले एतेरे आमणे-सामणे रे दुँईं पल्लेया रे सूईने रे दो-दो कड़े बणाई की लगाणे ताकि तिना कड़ेया रे डण्डे लगाई की बेदिया खे चकी सको।”<verse eid="EXO 30:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 30:5" />बबूलो री लकड़िया ते डण्डे बणाई की सेयो सूईने ते मढ़ने। <verse eid="EXO 30:5" /><verse number="6" style="v" sid="EXO 30:6" />तैं से तूपबेदी पड़दे रे आगे राखणी जेती वाचा रे सन्दूक ओर दया रा आसण ए, मतलब प्राश्चित वाल़े टकणे रे आगे जो गवाईया रे सन्दूको पाँदे ए, मां ताखे तेथी मिलेया करना।<verse eid="EXO 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 30:7" />हारूण हर रोज प्यागा रे बखते जेबे से दिऊए खे ठीक करो तेबे खुशबूदार तूप बेदिया पाँदे बाल़ेया करो। <verse eid="EXO 30:7" /><verse number="8" style="v" sid="EXO 30:8" />साँजा रे बखते जेबे हारूण दिऊए खे बाल़ो तेबे खुशबूदार तूप बाल़ेया करो ताकि तूप यहोवे रे सामणे तुसा री पीढ़िया-पीढ़िया तक हमेशा बाल़ेया जाओ। <verse eid="EXO 30:8" /><verse number="9" style="v" sid="EXO 30:9" />तेते बेदिया पाँदे तुसे ओरी चीजा रा तूप नि बाल़ना ओर ना तेते पाँदे होमबलि ओर नज्जो री बलि पेंट चढ़ाणी; ओर ना ई तेते पाँदे अर्घ देणा। <verse eid="EXO 30:9" /><verse number="10" style="v" sid="EXO 30:10" />सालो रे एक बार हारूण प्राश्चितो री पापबलिया रे खूने की बेदिया रे सींगो पाँदे खून लटी की लोका रिया तँईं प्राश्चित करो ओर तुसा री पीढ़िया-पीढ़िया रे सालो रे एक बार प्राश्चित करेया जाओ, ये यहोवे खे परम पवित्र ए।<verse eid="EXO 30:10" /></para>
  <para style="s">प्राणो रे प्राश्चितो रा रपईया</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 30:11" />ओर तेबे यहोवे मूसे खे बोलेया, <verse eid="EXO 30:11" /><verse number="12" style="v" sid="EXO 30:12" />“जेबे तूँ इस्राएलिया री गिणती करने लगो, तेबे तेरे गिणने रे बखते जिना री गिणती ऊईगी ओ आपणे-आपणे प्राणो रिया तँईं यहोवे रे सामणे प्राश्चित देओ, जेते कि जेबे तूँ तिना री गिणती करने लगी रा, तेस बखते कोई मुसीबत तिना पाँदे नि आओ। <verse eid="EXO 30:12" /><verse number="13" style="v" sid="EXO 30:13" />जितणे लोक गिणे जाओ सेयो पवित्र जगा रे शेकेलो रे मुताबिक आदा शेकेल देओ ये शेकेल बीई गेरा रा ओआ, यहोवे री पेंट साढे पाँज ग्राम ओ।”<verse eid="EXO 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 30:14" />बी साला रे या तिजी ते जादा उम्रा रे जितणे गिणे जाओ तिना बीचा ते एक-एक जणा यहोवे री पेंट देओ। <verse eid="EXO 30:14" /><verse number="15" style="v" sid="EXO 30:15" />जेबे तुसा रे प्राणो रे प्राश्चिता रिया तँईं यहोवे री पेंट चढ़ाई जाओ, तेबे ना तो अमीर लोक साढे पाँज ग्रामो ते जादा देओ ओर ना गरीब लोक तिजी ते कम देओ। <verse eid="EXO 30:15" /><verse number="16" style="v" sid="EXO 30:16" />तैं इस्राएलिया ते प्राश्चित करने रा पैसा लई की मिलणे वाल़े तम्बूए रे कामो रे लगाणा; जेते कि से यहोवे रे सामणे इस्राएलिया खे याद करने खे चिह्न ठईरो ओर प्राणो रा प्राश्चित बी ओ।<verse eid="EXO 30:16" /></para>
  <para style="s">पीतल़ी री अऊदी</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 30:17" />यहोवे मूसे खे बोलेया, <verse eid="EXO 30:17" /><verse number="18" style="v" sid="EXO 30:18" />“तैं आथ-पैर तोणे खे पीतल़ी री अऊदी बनाणी ओर तिजी रा पावा बी पीतल़ी रा बनाणा ओर से मिलणे वाल़े तम्बू ओर बेदिया बीचे राखी की तिदे पाणी परी देणा। <verse eid="EXO 30:18" /><verse number="19" style="v" sid="EXO 30:19" />ओर तिदे हारूण ओर तेसरे पाऊ आपणे-आपणे आथ पैर तोया करो। <verse eid="EXO 30:19" /><verse number="20" style="v" sid="EXO 30:20" />जेबे सेयो मिलणे वाल़े तम्बूए रे आओ, तेबे सेयो आपणे आथ-पैर तेते पाणिए साथे तोया करो ताकि सेयो मरी नि जाओ ओर जेबे सेयो बेदिया गे सेवा-टईल करो, मतलब यहोवे खे आगी रे चढ़ाई री बलि बाल़ने खे आओ, तेबे बी सेयो आथ-पैर तोओ ताकि सेयो मरी नि जाओ। <verse eid="EXO 30:20" /><verse number="21" style="v" sid="EXO 30:21" />हारूण ओर तेसरे वंशो खे आऊणे वाल़ी पीढ़िया-पीढ़िया तक ये सदा री बिदी ठईरो।”<verse eid="EXO 30:21" /></para>
  <para style="s">अभिषेको रा तेल</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 30:22" />फेर यहोवे मूसे खे बोलेया, <verse eid="EXO 30:22" /><verse number="23" style="v" sid="EXO 30:23" />“तैं खरे ते खरे खुशबूदार मसाले लणे, मतलब पवित्र जगा दे शेकेलो रे मुताबिक पाँज सौ शेकेल आपणे आपू निकल़ेया रा जैतूनो रा तेल ओर तिजी रा आदा मतलब टाई सौ शेकेल खुशबूदार दाल़चीनी ओर टाई सौ शेकेल बलसान नाओं रा खुशबूदार अगर, <verse eid="EXO 30:23" /><verse number="24" style="v" sid="EXO 30:24" />ओर पाँज सौ शेकेल खुशबूदार तेजपता ओर चार लीटर जैतूनो रा तेल लई की <verse eid="EXO 30:24" /><verse number="25" style="v" sid="EXO 30:25" />तिना सबी खे मिलाई की अभिषेको रा पवित्र तेल बणाओ, जेतेरी गन्धो री रीतिया ते त्यार कित्तेया रा खुशबूदार तेल बणो, ये अभिषेको रा पवित्र तेल ठईरो। <verse eid="EXO 30:25" /><verse number="26" style="v" sid="EXO 30:26" />फेर तेस खुशबूदार तेलो साथे मिलणे वाल़े तम्बूए रा ओर गवाईया रे सन्दूको रा, <verse eid="EXO 30:26" /><verse number="27" style="v" sid="EXO 30:27" />ओर मेज ओर तिजी रे सारे समानो समेत ओर समानो साथे दिऊए रा ओर तूपो री बेदिया रा, <verse eid="EXO 30:27" /><verse number="28" style="v" sid="EXO 30:28" />ओर सारे समानो समेत होमबलिया री बेदिया रा ओर तीजी रे सारे पांडेया रा ओर अऊदी ओर तिजी खे खड़ा करने वाल़े पावेया रा अभिषेक करना। <verse eid="EXO 30:28" /><verse number="29" style="v" sid="EXO 30:29" />तैं सेयो पवित्र करनिया, जेते कि सेयो परम पवित्र ठईरो ताकि जो कुछ तिना साथे छवांओगा, से बी पवित्र ऊई जाणा।”<verse eid="EXO 30:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 30:30" />तैं हारूण ओर तेसरे पाऊआ रा अभिषेक करना ताकि सेयो मेरिया तँईं पवित्र ऊई की पुरोईतो रा काम करी सको।<verse eid="EXO 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 30:31" />ओर इस्राएलिया खे मेरी ये आज्ञा सुनाणी कि ये तेल तुसा री पीढ़िया ते पीढ़िया तक मेरिया तँईं पवित्र अभिषेको रा तेल ऊणा। <verse eid="EXO 30:31" /><verse number="32" style="v" sid="EXO 30:32" />ये खुशबूदार तेल केसी ओरी माणूंआ रे शरीरो रे नि लगाणा; इजी खे तुसे बी ये पवित्र मानणा कऊँकि ये तेल पवित्र ठराई राखेया ओर मिलावटा खे तिजी जेड़ा ओर कुछ नि बनाणा। <verse eid="EXO 30:32" /><verse number="33" style="v" sid="EXO 30:33" />जो कोई तेस जेड़ा ओर कुछ खुशबूदार तेल बणाओगा या पुरोईतो ते अलावा तिजी बीचा ते पराये कुलो रे आदमिए पाँदे लगाओ तो से माणूं आपणे लोका बीचा ते निकाल़ी देणा चाईयो।<verse eid="EXO 30:33" /></para>
  <para style="s">पवित्र खुशबूदार मसाले</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 30:34" />तेबे यहोवे मूसे खे बोलेया, “तैं गंधरस, नखी ओर कुन्दरू, ये खुशबूदार मसाले साफ लोबानो समेत ली आऊणे, यो सब एक बराबर ऊणे चाईयो, <verse eid="EXO 30:34" /><verse number="35" style="v" sid="EXO 30:35" />ओर इना चीजा रा जिंयाँ एक गन्धी इत्र बणोआ तिंयाँ इदे लूण मलाई की खुशबूदार तूप बनाणा जो शुद्ध ओर पवित्र ओ। <verse eid="EXO 30:35" /><verse number="36" style="v" sid="EXO 30:36" />तुसे तिजी बीचा ते कुछ पीसी की बरिक करी की मिलणे वाल़े तम्बूए रे, गवाईया रे सन्दूको ते आगे, जेती मां ताखे मिलेया करना तेती राखणा; ये तुसा खे बऊत पवित्र ऊणा। <verse eid="EXO 30:36" /><verse number="37" style="v" sid="EXO 30:37" />ओर जो तूप तां बनवाणा, एते खुशबूदार तूपो रे मलाऊट करी की तिजी जेड़ा तुसे आपू खे कुछ नि बनाणा; तुसे ये यहोवे खे पवित्र राखणा। <verse eid="EXO 30:37" /><verse number="38" style="v" sid="EXO 30:38" />जो कोई सिंगणे खे मजे रिया तँईं तिजी जेड़ा तूप बणाओगा, से आपणे लोका बीचा ते निकाल़ी देणा चाईयो।”<verse eid="EXO 30:38" /></para>
  <chapter eid="EXO 30" />
  <chapter number="31" style="c" sid="EXO 31" />
  <para style="s">बसलेल ओर ओहोलीआब</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 31:1" />तेबे यहोवे मूसे खे बोलेया, <verse eid="EXO 31:1" /><verse number="2" style="v" sid="EXO 31:2" />“देख, मैं ऊरीए रा पाऊ बसलेल<note caller="+" style="f"><char style="fr" closed="false">31:2 </char><char style="fq" closed="false">बसलेल </char><char style="ft" closed="false">मतलब परमेशरो री छाया</char></note> नाओं लई की चूणी राखेया, से यहूदा रे गोत्रो रा हूरो रा पोता ए। <verse eid="EXO 31:2" /><verse number="3" style="v" sid="EXO 31:3" />मैं बसलेल आपणी आत्मा, बुद्धि, समज, परविणता, ज्ञान<note caller="+" style="f"><char style="fr" closed="false">31:3 </char><char style="fq" closed="false">बुद्धि, समज, परविणता, ज्ञान </char><char style="ft" closed="false">मतलब हर गल्ला रे सई परख</char></note> ओर सब प्रकारा री कारीगरिया री समज देणे वाल़ी आत्मा ते परी राखेया। <verse eid="EXO 31:3" /><verse number="4" style="v" sid="EXO 31:4" />जेते कि से एते बुद्धिया ते परी की सूईने, चाँदी ओर पीतल़ी रे कारीगरिया रे काम करी सको <verse eid="EXO 31:4" /><verse number="5" style="v" sid="EXO 31:5" />ओर मणि कटणे रे ओर लकड़िया री कारीगरिया रे ओर सबी किस्मा रे काम करने रे ऊशियार ए।<verse eid="EXO 31:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 31:6" />“ओर देख, आऊँ दानो रे गोत्रो रे जम्मे रे अहीसामाको रे पाऊ ओहोलीआबो खे तेस साथे करी देऊँआ; बल्कि मैं ओरी अक्लमंद माणूंआ रे दिल बी बुद्धिया साथे परी ते रे कि सेयो तिना सबी चीजा खे बणाओ जितणी चीजा री आज्ञा मैं ताखे देई राखी, <verse eid="EXO 31:6" /><verse number="7" style="v" sid="EXO 31:7" />मतलब मिलणे वाल़े तम्बू, वाचा रा सन्दूक, तेस पाँदला दया-आसण ओर तेस तम्बूए रा सारा समान, <verse eid="EXO 31:7" /><verse number="8" style="v" sid="EXO 31:8" />मेज ओर तिजी पाँदले खाणे रे पांडे, शुद्ध सूईने री बणी री दिऊए राखणे री फट्टी ओर तिजी रा समान ओर तूप बाल़ने री बेदी, <verse eid="EXO 31:8" /><verse number="9" style="v" sid="EXO 31:9" />ओर सारे समानो समेत होमबलिया री बेदी ओर पावे समेत अऊदी, <verse eid="EXO 31:9" /><verse number="10" style="v" sid="EXO 31:10" />ओर कढ़ाई कित्ते रे टाल्ले ओर हारूण ओर तेसरे पाऊआ रे पुरोईतो रा काम करने रे पवित्र टाल्ले, <verse eid="EXO 31:10" /><verse number="11" style="v" sid="EXO 31:11" />ओर पवित्र जगा खे अभिषेको रा तेल ओर खुशबूदार तूप, इना सबी खे सेयो तिना सबी आज्ञा रे मुताबिक बणाओ, जो मैं ताखे देई राखी।”<verse eid="EXO 31:11" /></para>
  <para style="s">रामो रा दिन</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 31:12" />तेबे यहोवे मूसे खे बोलेया, <verse eid="EXO 31:12" /><verse number="13" style="v" sid="EXO 31:13" />“तैं इस्राएली लोका खे ये बी बोलणा कि तुसे जरूर मेरे रामो रे दिन मानणे, कऊँकि तुसा री पीढ़िया ते पीढ़िया तक मां ओर तुसा लोका बीचे ये एक चिह्न ठईरना, जेते कि तुसे ये गल्ल जाणी लो कि यहोवा म्हारा परमेशर पवित्र करने वाल़ा ए। <verse eid="EXO 31:13" /><verse number="14" style="v" sid="EXO 31:14" />इजी बजअ ते तुसे रामो रा दिन मानणा, कऊँकि से तुसा खे पवित्र ठईरी रा; ओर जो तेस दिनो खे अपवित्र करोगा, से जरूर काया जाणा; जो कोई तेस दिने कोई काम काज करोगा, से प्राणी आपणे लोका बीचा ते निकाल़ेया जाणा। <verse eid="EXO 31:14" /><verse number="15" style="v" sid="EXO 31:15" />छे दिना तक तो काम काज करेया करना, पर सातुआ दिन पवित्र रामो रा दिन ओर यहोवे खे पवित्र ए; इजी री खातर जो कोई रामो रे दिने कोई काम करो से पक्का काया जाणा। <verse eid="EXO 31:15" /><verse number="16" style="v" sid="EXO 31:16" />इजी री खातर इस्राएली लोक रामो रा दिन मानेया करो, बल्कि पीढ़िया ते पीढ़िया तक से सदा खे वाचा रा विषय जाणी की मानेया करना। <verse eid="EXO 31:16" /><verse number="17" style="v" sid="EXO 31:17" />से मां ओर इस्राएली लोका बीचे सदा रा एक चिह्न रणा, कऊँकि छे दिना रे यहोवे सर्ग ओर तरती बणाई ओर सातुए दिने राम करी की आपणा जिऊ ठण्डा कित्तेया।”<verse eid="EXO 31:17" /></para>
  <para style="s">पात्थरो रिया दो तख़्तिया</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 31:18" />जेबे परमेशर मूसे साथे सीनै रे पाह्ड़ो पाँदे एड़िया गल्ला करी चुकेया, तेबे परमेशरे तेसखे आपणी गूठिया साथे लिखी री गवाई देणे वाल़िया पात्थरो रिया दोनो तख़्तिया दित्तिया।<verse eid="EXO 31:18" /></para>
  <chapter eid="EXO 31" />
  <chapter number="32" style="c" sid="EXO 32" />
  <para style="s">सूईने रा बाच्छू</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 32:1" />जेबे लोका खे लगेया कि मूसे खे पाह्ड़ो ते उतरने खे देर ऊईगी री, तेबे सेयो हारूणो गे कट्ठे ऊई की बोलणे लगे, “चल, एबे आसा खे देवता बणा, जो आसा रे आगे-आगे चलो; कऊँकि से माणूं मूसा जो आसा खे मिस्र देशो ते निकयाल़ी की ल्याया, आसे नि जाणदे कि एसखे क्या ऊआ?”<verse eid="EXO 32:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 32:2" />हारूणे तिना खे बोलेया, “तुसा री जवाणसा ओर माठे-बेटिया रे कानो रे सूईने रिया जो बाल़िया ए तिना खे खोली की मांगे ल्याओ।” <verse eid="EXO 32:2" /><verse number="3" style="v" sid="EXO 32:3" />तेबे सबी लोके आपणे कानो ते सूईने रिया बाल़िया खोलिया ओर हारूणो गे ली आये। <verse eid="EXO 32:3" /><verse number="4" style="v" sid="EXO 32:4" />ओर हारूणे सेयो सूईने रे गईणे तिना रे आथो ते लई ले ओर साँचे रे पाई की सूईना टाल़ी की एक बाच्छूए री मूर्ति कअड़ी की बणाई। तेबे सेयो बोलणे लगे, “ओ इस्राएलो रे लोको येईए तेरा परमेशर जो ताखे मिस्र देशो ते छुड़ाई की ली आयी रा।” <verse eid="EXO 32:4" /><verse number="5" style="v" sid="EXO 32:5" />ये देखी की हारूणे तेसरे आगे एक बेदी बणाई ओर ये प्रचार कित्तेया, “काल यहोवे खे त्योआर मनाणा।” <verse eid="EXO 32:5" /><verse number="6" style="v" sid="EXO 32:6" />ओर दूजे दिने लोके प्यागा उठी की होमबलि चढ़ाई ओर मेलबलि ली आये; तेबे तिजी ते बाद तिने बैठी की खाया पिया ओर उठी की व्याभिचारो री अरकता करने लगे।<verse eid="EXO 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 32:7" />तेबे यहोवे मूसे खे बोलेया, “थाले उतरी जा, कऊँकि तेरिया प्रजा रे लोक, जिना खे तूँ मिस्र देशो ते निकयाल़ी की ली आयी रा सेयो बिगड़ी गे रे; <verse eid="EXO 32:7" /><verse number="8" style="v" sid="EXO 32:8" />जेते बाटा रे चलणे री आज्ञा मैं तिना खे दित्ती थी तेसा खे फटाफट छाडी की तिने एक बाच्छूए री मूर्ति कअड़ी की बणाई ली, तेबे तेसा गे माथा तेकेया ओर तिजी खे बलिदान चढ़ाई की ये बोली राखेया, ओ इस्राएलियो तुसा रा परमेशर जो तुसा खे मिस्र देशो ते छुड़ाई की ली आयी रा से येईए।” <verse eid="EXO 32:8" /><verse number="9" style="v" sid="EXO 32:9" />तेबे यहोवे मूसे खे बोलेया, “आँऊ इना लोका खे जाणी गा रा ए, ओर सुण, सेयो टीठ ए <verse eid="EXO 32:9" /><verse number="10" style="v" sid="EXO 32:10" />मेरा रोष तिना पाँदे पड़की रा, जेते की मां सेयो फूकी देणे एबे तूँ माखे नि रोक; तिजी ते बाद मां तांते एक बड़ी जातिया रा देश बनवाणा।”<verse eid="EXO 32:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 32:11" />पर मूसा आपणे परमेशर यहोवे खे ये बोली की मनाणे लगेया, “ओ यहोवा, तेरा रोष आपणियां प्रजा पाँदे कऊँ पड़की रा जिना खे तूँ बड़ी सामर्थ ओर तागतबर आथो रे जरीये मिस्र देशो ते निकयाल़ी की ली आयी रा?” <verse eid="EXO 32:11" /><verse number="12" style="v" sid="EXO 32:12" />एड़ा नि ऊणे दे कि मिस्री लोक ईंयाँ बोली सको कि से तिना खे बुरे इरादे ते पाह्ड़ो रे काई की तरतिया पाँदा ते खत्म करने री इच्छा ते निकयाल़ी की लईगा? तूँ आपणे पड़के रे रोषो खे शांत कर ओर आपणियां प्रजा रे लोका खे एड़ा नुकशाण पऊँचाणे ते मन बदली लओ। <verse eid="EXO 32:12" /><verse number="13" style="v" sid="EXO 32:13" />आपणे दास अब्राहम, इसहाक ओर याकूबो खे याद कर, जिना ते तैं आपणी ई कसम खाई की ये बोलेया था, “मां तुसा रा वंश सर्गो रे तारेया जेड़ा बऊत करना ओर ये सारा देश जेतेरे बारे दे मैं तेरे वंशो खे देणे रा वादा करी राखेया कि सेयो तेतेरे अक्कदार सदा बणे रे रओ।” <verse eid="EXO 32:13" /><verse number="14" style="v" sid="EXO 32:14" />तेबे यहोवे आपणी प्रजा इस्राएलिया रा नुकशाण करने खे जो तिने करने खे बोलेया था मन बदली ता। <verse eid="EXO 32:14" /><verse number="15" style="v" sid="EXO 32:15" />तेबे मूसा फिरी की वाचा रिया लिखी री दुँईं तख़्तिया खे आथो रे लई की पाह्ड़ो ते उतरी गा। तिना तख़्तिया रे दुँईं कनारे लिखी राखेया था। <verse eid="EXO 32:15" /><verse number="16" style="v" sid="EXO 32:16" />ओर सेयो तख़्तिया परमेशरो रिया बणाई रिया थिया ओर तिना पाँदे परमेशरे आपणे आथे की लिखेया रा था।<verse eid="EXO 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 32:17" />जेबे यहोशूए खे लोका रा आल्ला सुणेया तेबे तिने मूसे खे बोलेया, “डेरे ते लड़ाईया री जी आवाज सुणने लगी री।”<verse eid="EXO 32:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 32:18" />तेबे मूसे बोलेया, “ये जो आवाज सुणने लगी री से ना तो जीतणे वाल़ेया री ए ओर ना आरने वाल़ेया री, पर माखे तो गाणे री आवाज सुणने लगी री।” <verse eid="EXO 32:18" /><verse number="19" style="v" sid="EXO 32:19" />जेबे मूसा डेरे रे नेड़े आया तो तिने से बाच्छूए री मूर्ति देखी ओर तिना रा नाचणा देखेया तेबे मूसे रा रोष पड़की गा ओर तिने वाचा री तख़्तिया आपणे आथो साथे पाह्ड़ो रे थाले पटकी-पटकी की तोड़ी तिया। <verse eid="EXO 32:19" /><verse number="20" style="v" sid="EXO 32:20" />तेबे तिने तिना रे बणाए रे बाच्छूए री मूर्ति लई की आगी बीचे पाई की फूकी ती; फेर तिजी खे पीसी की चूरा-चूरा बणाईता ओर पाणिए पाँदे सेटी ता ओर इस्राएली लोका खे से पल़्याई ता।<verse eid="EXO 32:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 32:21" />तेबे मूसा हारूणो ते पूछणे लगेया, “तिने लोके तां साथे क्या कित्तेया कि तैं सेयो इतणे बड़े पापो रे फसाई ते?”<verse eid="EXO 32:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 32:22" />हारूणे जबाब दित्तेया, “मेरे यहोवे रा रोष नि पड़को; तूँ तो तिना लोका खे जाणेया कि सेयो बुराईया रे मन लगाई राखोए।” <verse eid="EXO 32:22" /><verse number="23" style="v" sid="EXO 32:23" />ओर तेबे तिने माखे बोलेया, “आसा खे देवता बणा जो आसा रे आगे-आगे चलो; कऊँकि से माणूं मूसा जो आसा खे मिस्र देशो ते निकयाल़ी की ल्याया, आसे नि जाणदे कि एसखे क्या ऊआ?” <verse eid="EXO 32:23" /><verse number="24" style="v" sid="EXO 32:24" />तेबे मैं तिना खे बोलेया, “जेस-जेस गे सूईने रे गईणे ए सेयो तिना खे खोली की ल्याओ ओर जेबे तिने माखे दित्ते, मैं सेयो आगी बीचे पाई ते, तेबे से बाच्छूए री मूर्ति निकल़ी गी।” <verse eid="EXO 32:24" /><verse number="25" style="v" sid="EXO 32:25" />मूसे देखेया था कि हारूणे तिना लोका खे आपणी मनमानी करने दित्ती थी ओर सेयो लोक एड़े मजबूर करी ते थे कि सेयो आपणे विरोदिया बीचे मजाक बणीगे। <verse eid="EXO 32:25" /><verse number="26" style="v" sid="EXO 32:26" />फेर मूसे सबी रे डेरे रे सामणे खड़े ऊई की तिना खे बोलेया, “जो कोई यहोवे रिया तरफा खे ओ से मांगे आओ;” तेबे सारे लेवीय तेसगे कट्ठे ऊईगे। <verse eid="EXO 32:26" /><verse number="27" style="v" sid="EXO 32:27" />तेबे तिने तिना लोका खे बोलेया, “इस्राएलिया रा परमेशर यहोवा ईंयाँ बोलोआ कि आपणी-आपणी जाँघा पाँदे तलवार लटकाई की डेरे रे एकी कूणे ते दूजे कूणे तक कूमी-कूमी की आपणे-आपणे पाईया खे, आपणे साथिया खे ओर आपणे पड़ोसिया खे मारी देओ।” <verse eid="EXO 32:27" /><verse number="28" style="v" sid="EXO 32:28" />मूसे रे एड़ा बोलदे ई लेविये से कित्तेया ओर तेस दिने 3 ह्जारा रे तकरीबन लोक मारी ते।<verse eid="EXO 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 32:29" />तेबे मूसे बोलेया, “आजका दिन तुसे यहोवे रिया तँईं लग करी राखे कऊँकि तुसे आपणे पाऊआ ओर पाईया रे खलाफ बी ऊईगे इजी बजअ ते आज यहोवा तुसा खे आशीष देओ।” <verse eid="EXO 32:29" /><verse number="30" style="v" sid="EXO 32:30" />दूजे दिने मूसे लोका खे बोलेया, “तुसे बड़ा ई पारी पाप करी राखेया। पर एबे मां यहोवे गे चढ़ी जाणा, ऊई सकोआ कि आऊँ तुसा रे पापो रा प्राश्चित करी सकूँ।” <verse eid="EXO 32:30" /><verse number="31" style="v" sid="EXO 32:31" />तेबे मूसा यहोवे गे जाई की बोलणे लगेया, “हाय, हाय, इने लोके बड़ा ई पारी पाप करी राखेया! इने आपू खे सूईने रा देवता बणाई ला रा। <verse eid="EXO 32:31" /><verse number="32" style="v" sid="EXO 32:32" />तेबे बी एबे तूँ तिना रा पाप माफ कर, नई तो आपणी लिखी री कताबा बीचा ते मेरा नाओं कटी दे।”<verse eid="EXO 32:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 32:33" />यहोवे मूसे खे बोलेया, “जिने मेरे खलाफ पाप करी राखेया तेसरा नाओं ई मां आपणी कताबा ते कटी देणा। <verse eid="EXO 32:33" /><verse number="34" style="v" sid="EXO 32:34" />एबे तो तूँ जाई की तिना लोका खे तेते जगा रे लई जा जेतेरे बारे दे मैं ताखे बताया था; देख, मेरा दूत तांते आगे-आगे चलणा। पर जेस दिने मां दण्ड देणे लगणा तेस दिने तिना खे एते पापो री सजा बी देणी।” <verse eid="EXO 32:34" /><verse number="35" style="v" sid="EXO 32:35" />इजी खे यहोवे तिना लोका पाँदे बऊत बड़ी महामारी पाई, कऊँकि हारूणो री बणाई री बाच्छूए री मूर्तिया री सेवा तिने ई कित्ती थी।<verse eid="EXO 32:35" /></para>
  <chapter eid="EXO 32" />
  <chapter number="33" style="c" sid="EXO 33" />
  <para style="s">सीनै पाह्ड़ो ते चलणे री आज्ञा</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 33:1" />तेबे यहोवे मूसे खे बोलेया, “तूँ तिना लोका खे जिना खे मिस्र प्रदेशो ते निकयाल़ी की ली आयी रा, तिना खे साथे लई की तेस देशो रे जा, जेतेरे बारे दे मैं अब्राहम, इसहाक ओर याकूबो साथे कसम खाई की बोलेया था, ‘मां से प्रदेश तुसा रे वंशो खे देणा’ <verse eid="EXO 33:1" /><verse number="2" style="v" sid="EXO 33:2" />ओर मां तांते आगे-आगे एक संदेशा देणे वाल़ा दूत पेजणा ओर कनानी, एमोरी, हित्ती, परिज्जी, हिब्बी ओर यबूसी जातिया रे लोक जबरदस्ती निकयाल़ी देणे। <verse eid="EXO 33:2" /><verse number="3" style="v" sid="EXO 33:3" />तुसे लोक तेते देशो रे जाओ जो सच्चो खेई बऊत ई पजणे वाल़ा ए; पर तुसे टीठ ए, इजी बजअ ते मां तुसा बीचे ऊई की नि चलणा, एड़ा नि ओ कि आऊँ बाटा रेई तुसा रा अन्त करी देऊँ।” <verse eid="EXO 33:3" /><verse number="4" style="v" sid="EXO 33:4" />ये बुरी खबर सुणी की सेयो लोक दु:खी ऊणे लगे ओर किने बी आपणे गईणे नि पईने। <verse eid="EXO 33:4" /><verse number="5" style="v" sid="EXO 33:5" />कऊँकि यहोवे मूसे खे बोलेया था, “इस्राएली लोका खे ये बोल कि तुसे लोक तो टीठ ए; जे आऊँ तुसा बीचे ऊई की थोड़ी जी देरा खे बी चलूँगा, तो आँऊ तुसा रा अन्त करी सकूँआ। इजी री खातर एबे आपणे-आपणे गईणे आपणे अंगो ते उतारी देओ, ताकि आऊँ जाणूं कि तुसा साथे क्या करना चाईयो।” <verse eid="EXO 33:5" /><verse number="6" style="v" sid="EXO 33:6" />तेबे इस्राएली लोक होरेब पाह्ड़ो गे आपणे गईणे उतारी की आगे चलणे लगे।<verse eid="EXO 33:6" /></para>
  <para style="s">मिलणे वाल़ा तम्बू</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 33:7" />एबे मूसा तम्बूए खे डेरे ते बारे बल्कि थोड़ी दूर खड़ा करेया करो था ओर तिजी खे मिलणे वाल़ा तम्बू बोलो था ओर जो कोई यहोवे खे टोल़ो था से डेरे ते बारे मिलणे वाल़े तम्बूए गे चली जाओ था।<verse eid="EXO 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 33:8" />जेबे-जेबे मूसा तम्बूए गे जाओ था, तेबे-तेबे सब लोक उठी की आपणे-आपणे डेरे रे द्धारो पाँदे खड़े ऊई जाओ थे ओर जदुओ तक मूसा तेते तम्बूए दे नि चली जाओ था, तदुओ तक तेसखे देखदे रओ थे। <verse eid="EXO 33:8" /><verse number="9" style="v" sid="EXO 33:9" />जेबे मूसा तेते तम्बूए रे जाओ था, तेबे एक एड़ा बादल़ जेतेरा आकार खम्बे जेड़ा था उतरी की तम्बूए रे द्धारो पाँदे ठईरी जाओ था ओर यहोवा मूसे साथे गल्ला करने लगी जाओ था। <verse eid="EXO 33:9" /><verse number="10" style="v" sid="EXO 33:10" />ओर जेबे कदी लोक बादल़ो रे खम्बे खे तम्बूए रे द्धारो पाँदे रूकेया रा देखो थे, तेबे सब लोक उठी की आपणे-आपणे डेरे रे द्धारो पाँदा ते माथा टेको थे। <verse eid="EXO 33:10" /><verse number="11" style="v" sid="EXO 33:11" />ओर यहोवा मूसे साथे ईंयाँ आमणे-सामणे गल्ला करो था, जिंयाँ कोई आपणे गईरे दोस्तो साथे गल्ला करोआ। तिजी ते बाद मूसा डेरे रे फेर वापस ऊई जाओ था, पर यहोशू नाओं रा एक जवान, जो नूनो रा पाऊ ओर मूसे रा सेवक था, से तम्बूए ते नि निकल़ो था।<verse eid="EXO 33:11" /></para>
  <para style="s">मूसे खे यहोवे री महिमा रा दर्शण</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 33:12" />ओर मूसे यहोवे खे बोलेया, “सुण, तैं माखे बोलेया कि इना लोका खे लई चल, पर एड़ा नि बताया कि तां मां साथे कुण पेजणा। तेबे बी तैं बोली राखेया, ‘आँऊ ताखे ठीक टंगो ते जाणूंआ ओर तां पाँदे मेरी दया-दृष्टि ए।’ <verse eid="EXO 33:12" /><verse number="13" style="v" sid="EXO 33:13" />ओर एबे जे तेरी दया री दृष्टि मां पाँदे ओ, तो माखे आपणी बाट समजयाई दे, जेते कि आँऊ जाणी सकूँ, ईंयाँ आगो खे तेरी दया-दृष्टि मां पाँदे बणी री रओ ओर एते प्रदेशो रे लोक जो तेरे लोक ए तिना री बी सम्माल़ लओ।”<verse eid="EXO 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 33:14" />यहोवे बोलेया, “मां आपू तां साथे चलणा ओर ताखे राम देणा।”<verse eid="EXO 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 33:15" />तेबे मूसे यहोवे खे बोलेया, “जे तूँ आसा साथे मौजूद नि रओगा, तो आसे एथा ते आगे नि निणे। <verse eid="EXO 33:15" /><verse number="16" style="v" sid="EXO 33:16" />कोई बी ये किंयाँ जाणी सकोआ कि तेरी दया-दृष्टि मां पाँदे ओर तेरे लोका पाँदे अए जदुओ तक तूँ आसा साथे नि चलो? ओर क्या चीज ए जेते कि आऊँ ओर तेरी प्रजा रे लोक पूरी तरतिया रे सबी लोका ते लग ठईरो?”<verse eid="EXO 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 33:17" />तेबे यहोवे मूसे खे बोलेया, “मां सेई करना जो तैं माखे बोली राखेया; कऊँकि मेरी दया-दृष्टि तां पाँदे ए ओर आँऊ ताखे ठीक टंगो ते जाणूंआ।”<verse eid="EXO 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 33:18" />तेबे मूसे परमेशरो खे बोलेया, “एबे माखे आपणा तेज दखाई दे।” <verse eid="EXO 33:18" /><verse number="19" style="v" sid="EXO 33:19" />तेबे परमेशरे उतर दित्तेया, “मां तां सामणे ऊई की चलदे ऊए ताखे आपणी सारी पलाई दखाणी ओर तां सामणे आपणा यहोवे रे नाओं रा प्रचार करना ओर जेस पाँदे आऊँ दया करना चाऊँ, तेस पाँदे दया करनी ओर जेस पाँदे कृपा करना चाऊँ तेस पाँदे कृपा करनी।” <verse eid="EXO 33:19" /><verse number="20" style="v" sid="EXO 33:20" />फेर तिने बोलेया, “तूँ मेरे मुंए रा दर्शण नि करी सकदा; कऊँकि माणूं मेरे मुंए रा दर्शण करी की जिऊँदा नि रयी सकदा।” <verse eid="EXO 33:20" /><verse number="21" style="v" sid="EXO 33:21" />ओर यहोवे बोलेया, “देख, मांगे एक जगा ए, तूँ तेते चट्टानी पाँदे खड़ा ऊई जा <verse eid="EXO 33:21" /><verse number="22" style="v" sid="EXO 33:22" />ओर जदुओ तक मेरा तेज तां सामणे ऊई की चलदा रओगा, तदुओ तक मां तूँ चट्टानी री दरारी रे राखणा ओर जदुओ तक आऊँ तेरे सामणे ते नि निकल़ी जाऊँगा, तदुओ तक मां तूँ आपू आथो साथे टकी की राखणा। <verse eid="EXO 33:22" /><verse number="23" style="v" sid="EXO 33:23" />फेर मां आपणा आथ चकी लणा, तेबे तूँ मेरिया पीठी रा दर्शण तो करी सकेया, पर मेरे मुंए रा दर्शण नि करी सकदा।”<verse eid="EXO 33:23" /></para>
  <chapter eid="EXO 33" />
  <chapter number="34" style="c" sid="EXO 34" />
  <para style="s">पात्थरो री दो नवींया तख़्तिया</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 34:1" />तेबे यहोवे मूसे खे बोलेया, “पईलकिया तख़्तिया जेड़िया दो ओर तख़्तिया कअड़ी लो; तेबे जो वचन तिना पईलकिया तख़्तिया पाँदे लिखी राखे थे, जो तैं तोड़ी तिया, सेयो ई वचन मां तिना तख़्तिया पाँदे बी लिखणे। <verse eid="EXO 34:1" /><verse number="2" style="v" sid="EXO 34:2" />प्यागा त्यार रएया ओर सीनै पाह्ड़ो पाँदे चढ़ी की तिजी री चूँडिया पाँदे मां सामणे खड़े ऊणा। <verse eid="EXO 34:2" /><verse number="3" style="v" sid="EXO 34:3" />तां साथे ओर कोई नि चढ़ना चाईयो, बल्कि पूरे पाह्ड़ो पाँदे कोई बी माणूं दिखणा नि चाईयो ओर ना ई पेड-बाकरी ओर ना ई गाय-बल़दा रे चूण्ड पाह्ड़ो रे नेड़े-तेड़े चरदे ऊए दिखणे चाईयो।”<verse eid="EXO 34:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 34:4" />तेबे मूसे पईलकिया तख़्तिया जेड़िया दो ओर तख़्तिया कअड़िया ओर प्यागा तड़के उठी की आपणे आथो रे सेयो दोनो तख़्तिया लई की यहोवे रिया आज्ञा रे मुताबिक सीनै पाह्ड़ो पाँदे चढ़ीगा।<verse eid="EXO 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 34:5" />तेबे यहोवे बादल़ो रे उतरी कि मूसे साथे तेती खड़े ऊई कि आपणे ई नाओं री महिमा प्रकट कित्ती। <verse eid="EXO 34:5" /><verse number="6" style="v" sid="EXO 34:6" />ओर यहोवा तेसरे सामणे ऊई की ये प्रचार करदा ऊआ चलेया, “आँऊ परमेशर यहोवा, दयालु ओर अनुग्रह करने वाल़ा, रोष करने रे सब्रखोर ओर बऊत ई करूणामयी ओर सच्चा परमेशर ए, <verse eid="EXO 34:6" /><verse number="7" style="v" sid="EXO 34:7" />ह्जारा पीढ़िया तक लगातार करूणा करने वाल़ा, बुरे काम, पाप ओर पाप माफ करने वाल़ा ए, फेर बी दोषी किंयाँ बी मां निर्दोष नि ठराणे, बल्कि तिना रे पितरो रे पापो री सजा तिना रे माठेया खे ओर तिना रे पोतेया ओर पड़पोतेया खे बी देणे वाल़ा ए।”<verse eid="EXO 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 34:8" />मूसे फटाफट जमीना पाँदे चूकी की माथा तेकेया। <verse eid="EXO 34:8" /><verse number="9" style="v" sid="EXO 34:9" />ओर तिने बोलेया, “ओ यहोवा, जे तेरी दया-दृष्टि मां पाँदे ओ तो यहोवा, आसा लोका बीचे ऊई की चल, यो लोक टीठ तो अए, तेबे बी म्हारे पाप ओर बुरे काम माफ कर ओर आसा खे आपणे लोक मानी की ग्रहण कर।”<verse eid="EXO 34:9" /></para>
  <para style="s">वाचा खे दुराया जाणा</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 34:10" />तेबे यहोवे बोलेया, “देख, आऊँ तुसा साथे एक वाचा बानूँआ ओर मां तेरे सबी लोका सामणे एड़े अचम्बे रे काम करने, जेड़े तरतिया पाँदे ओर सबी जातिया रे देशा बीचे कदी नि ऊए ओर सेयो सारे देशो रे लोक जिना बीचे तूँ रएया, तिना यहोवे रे काम देखणे, कऊँकि जो आऊँ तुसा लोका साथे करने वाल़ा ए, से डर पैदा करने वाल़ा काम ए। <verse eid="EXO 34:10" /><verse number="11" style="v" sid="EXO 34:11" />देखो, आऊँ तुसा रे आगा ते एमोरी, कनानी, हित्ती, परिज्जी, हिब्बी ओर यबूसी लोका खे निकयाल़ूँआ पर आज आऊँ जो आज्ञा तुसा खे देऊँआ, से तुसे लोका मानणी। <verse eid="EXO 34:11" /><verse number="12" style="v" sid="EXO 34:12" />इजी री खातर सम्बल़ी की रएया कि जेते देशो रे तूँ जाणे वाल़ा ए, तेथो रे रणे वाल़ेया साथे वाचा नि बानणी, केथी एड़ा नि ओ कि से ताखे फन्दा ठईरो। <verse eid="EXO 34:12" /><verse number="13" style="v" sid="EXO 34:13" />इजी खे तिना री मूर्तिया री बेदिया टाल़ी देणियां ओर तिना री अशेरा नाओं रिया मूर्तिया बाडी देणियां; <verse eid="EXO 34:13" /><verse number="14" style="v" sid="EXO 34:14" />कऊँकि तुसा खे केसी ओरी खे परमेशर करी की मानणा ओर तेसगे माथा टेकणे री आज्ञा निए, कऊँकि यहोवा जेसरा नाओं जलनशील ए, से जल़ने वाल़ा परमेशर ए, <verse eid="EXO 34:14" /><verse number="15" style="v" sid="EXO 34:15" />एड़ा नि ओ कि तूँ तेस देशो रे रणे वाल़ेया साथे वाचा बानो ओर सेयो आपणे देवतेया पीछे ऊणे रा व्याभिचार करो ओर तिना खे बलिदान बी करो ओर कोई ताखे निऊँदा देओ ओर तूँ बी बलि कित्ते रे डांगरो रा प्रसाद खाओ, <verse eid="EXO 34:15" /><verse number="16" style="v" sid="EXO 34:16" />ओर तूँ तिना रिया बेटिया खे ब्याई की आपणे माठेया खे ल्याओ ओर तिना रिया बेटिया जो आपू आपणे देवतेया पीछे चलणे रा व्याभिचार करोईया, तेरे माठेया ते बी आपणे देवतेया पीछे चलणे रा व्याभिचार कराओ।<verse eid="EXO 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 34:17" />“तुसे देवतेया रिया मूर्तिया कअड़ी की नि बनाणियां।<verse eid="EXO 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 34:18" />“बिना सजेड़े रिया रोटिया रा त्योआर मनाणा। सात दिना तक जिंयाँ मैं आज्ञा दित्ती थी आबीब मीन्ने रे सई बखतो पाँदे बिना सजेड़े री रोटी खाया करनी, कऊँकि ये तेस बखतो री याद ए जेबे तूँ मिस्र देशो ते आबीब मीन्ने रे निकल़ी की आया था। <verse eid="EXO 34:18" /><verse number="19" style="v" sid="EXO 34:19" />हर एक जेठा बच्चा मेरा ए ओर क्या गायी रा बाच्छू, क्या मिन्टू, तेरे डांगरा बीचे जो नर जेठा बच्चा ओ, सेयो सब मेरे ए। <verse eid="EXO 34:19" /><verse number="20" style="v" sid="EXO 34:20" />गह्दिया रे पईले बच्चे रे बदले मिन्टू देई की से छुड़ाई लणा, पर जे तूँ तेसखे छुड़ाणा नि चाए, तो तेसरी क्याड़ी तोड़ी देणी। पर आपणे सारे जेठे माठे बदला देई की छुड़ाई लणे। माखे कोई खाली आथे आपणा मूँ नि दखाओ।<verse eid="EXO 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 34:21" />“छे दिना तक तो काम करना, पर सातुए दिने राम करना; ईंयाँ अल़ बाणे ओर बाडणे रे बखते बी राम करना।<verse eid="EXO 34:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 34:22" />“ओर कणका री पईली फसला रे बखते तैं अफ़्तेया रा त्योआर मानणा ओर सालो रे आखरी रे बी फसल कट्ठी करने रा त्योआर मानणा।<verse eid="EXO 34:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 34:23" />“सालो रे तीन बार तेरे सब मर्द इस्राएलो रे परमेशर यहोवा यहोवे खे आपणा मूँ दखाओ। <verse eid="EXO 34:23" /><verse number="24" style="v" sid="EXO 34:24" />तेबे मां देशो री जातिया तेरे सामणे ते निकयाल़ी की, तेरे बन्ने बढ़ाणे ओर जेबे तूँ आपणे परमेशर यहोवे खे सालो रे तीन बार आपणा मूँ दखाणे आओ, तेबे केसी बी तेरी जमीना रा लाल़च नि करना।<verse eid="EXO 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 34:25" />“मेरे बलिया रे डांगरो रा खून सजेड़ी रोटिया साथे नि चढ़ाणा ओर ना फसह रे त्योआरो रे बलिदानो बीचा ते कुछ प्यागा तक राखणा <verse eid="EXO 34:25" /><verse number="26" style="v" sid="EXO 34:26" />तैं आपणी जमीना री पईली फसला रा पईला पाअग आपणे परमेशर यहोवे रे भवनो रे ली आऊणा। बाकरिया रा बच्चा तेसरी माया रे दूदो रे नि पकाणा।”<verse eid="EXO 34:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 34:27" />तेबे यहोवे मूसे खे बोलेया, “इना वचना खे लिखी लो, कऊँकि इना वचना रेई मुताबिक आँऊ तां साथे ओर इस्राएलिया साथे वाचा बानूँआ।”<verse eid="EXO 34:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 34:28" />मूसा तो तेती यहोवे साथे बिना रोटी-पाणी खाए-पिये चाल़ी दिन ओर चाल़ी राती रया ओर तेबे तिने तिना पात्थरो रिया तख़्तिया पाँदे वाचा रे वचन मतलब दस आज्ञा लिखी तिया। <verse eid="EXO 34:28" /><verse number="29" style="v" sid="EXO 34:29" />जेबे मूसा गवाईया रिया दोनो तख़्तिया आथो रे लई की सीनै रे पाह्ड़ो ते उतरी की आऊणे लगी रा था, तेबे यहोवे साथे गल्ला करने रिया बजअ ते तेसरे मुंए पाँदा ते चमकीली किरणा निकल़ने लगी रिया थिया, पर से नि जाणो था कि तेसरे मुंए पाँदा ते चमकीली किरणा निकल़ने लगी रिया। <verse eid="EXO 34:29" /><verse number="30" style="v" sid="EXO 34:30" />जेबे हारूण ओर सबी इस्राएलिये मूसा देखेया कि तेसरे मुंए पाँदा ते किरणा निकल़ने लगी रिया, तेबे सेयो तेसगे जाणे ते डरीगे। <verse eid="EXO 34:30" /><verse number="31" style="v" sid="EXO 34:31" />पर जेबे मूसे सेयो आपू गे बुलाए तो हारूण इस्राएली मण्डल़िया रे सारे परदाना साथे तेसगे आया ओर मूसा तिना साथे गल्ला करने लगेया। <verse eid="EXO 34:31" /><verse number="32" style="v" sid="EXO 34:32" />इजी ते बाद सब इस्राएली नेड़े आए ओर जितणिया आज्ञा यहोवे सीनै रे पाह्ड़ो पाँदे मूसे साथे गल्ला करने रे बखते दित्तिया थिया, सेयो सब तिने तिना खे बताईया।<verse eid="EXO 34:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 34:33" />जदुओ तक मूसा तिना साथे गल्ला नि करी चुकेया, तदुओ तक तिने आपणे मुंए पाँदे कुण्डा पाया रा राखेया। <verse eid="EXO 34:33" /><verse number="34" style="v" sid="EXO 34:34" />ओर जेबे-जेबे मूसा पीतरे यहोवे साथे गल्ला करने खे यहोवे सामणे जाओ था, तेबे-तेबे मूसा तेस कुण्डे खे बारे निकल़ने रे बखतो तक उतारी की राखो था ओर तेबे बारे आयी की जो-जो आज्ञा तेसखे मिलो थिया, तिना खे इस्राएली लोका खे बताई देओ था। <verse eid="EXO 34:34" /><verse number="35" style="v" sid="EXO 34:35" />इस्राएली लोके देखेया की मूसे रे मुंए ते चमकीली किरणा निकल़दिया रओ थिया तेबे मूसा जदुओ तक यहोवे साथे गल्ला करने खे पीतरे नि जाओ था, तदुओ तक तेस कुण्डे खे पाई की राखो था।<verse eid="EXO 34:35" /></para>
  <chapter eid="EXO 34" />
  <chapter number="35" style="c" sid="EXO 35" />
  <para style="s">रामो रा दिन मनाणे रा नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 35:1" />मूसे इस्राएलिया री सारी मण्डल़ी कट्ठी करी की तिना खे बोलेया, “यहोवे जिना कामा खे करने री आज्ञा देई राखी सेयो यो ए। <verse eid="EXO 35:1" /><verse number="2" style="v" sid="EXO 35:2" />छे दिना तक तो काम काज करेया करना, पर सातुआ दिन तुसा खे पवित्र ओर यहोवे खे पवित्र रामो रा दिन ठईरो, तेस दिने जो कोई माणूं काम काज करो से जरूर काया जाणा; <verse eid="EXO 35:2" /><verse number="3" style="v" sid="EXO 35:3" />बल्कि रामो रे दिने तुसे आपणे-आपणे कअरो रे आग तक नि बाल़नी।”<verse eid="EXO 35:3" /></para>
  <para style="s">पवित्र तम्बूए खे पेंट</para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 35:4" />तेबे मूसे इस्राएलिया री सारी मण्डल़िया खे बोलेया, “जेसा गल्ला री आज्ञा यहोवे देई राखी से ये ए। <verse eid="EXO 35:4" /><verse number="5" style="v" sid="EXO 35:5" />तुसा गे जो कुछ बी अए तिजी बीचा ते यहोवे खे पेंट लई जाओ। हर कोई जो आपणी इच्छा ते देणा चाओ, सेयो यहोवे री पेंट करी की इना चीजा खे मतलब सूईना, चाँदी, पीतल़ ली आओ, <verse eid="EXO 35:5" /><verse number="6" style="v" sid="EXO 35:6" />नीले, बैंगणी ओर लाल रंगो रा टाल्ला ओर लीलणो रे टाल्ले ओर बाकरिया रे बाल़, <verse eid="EXO 35:6" /><verse number="7" style="v" sid="EXO 35:7" />लाल रंगो रे रंगी रिया खाडूआ री खाला, बाकरेया री खाला ओर बबूल नाओं रे डाल़ो री लकड़ी,<verse eid="EXO 35:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 35:8" />“प्रयासा देणे खे जैतूनो रा तेल, अभिषेको रा तेल बनाणे खे चीजा ओर तूपो खे खुशबूदार चीजा,<verse eid="EXO 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 35:9" />“तेबे छातिया पाँदे पईनणे वाल़ी झिलम ओर एपोदो पाँदे लगाणे खे सुलैमानी पात्थरा री मणि ओर दूजी किमती मणि। <verse eid="EXO 35:9" /><verse number="10" style="v" sid="EXO 35:10" />तुसा सबी बीचा ते जितणे बी काम करने रे कारीगर ए सेयो सारे आयी की जिना-जिना चीजा री आज्ञा यहोवे देई राखी तिना सबी खे बणाओ।”<verse eid="EXO 35:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 35:11" />मतलब मिलणे वाल़ा तम्बू, तम्बूए पाँदला टक्कण, तिजी री खूँडी, तख़्ते, डण्डे, खम्बे ओर पावे;<verse eid="EXO 35:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 35:12" />फेर वाचा रा सन्दूक, डण्डेया समेत दया रा आसण ओर तिजी पाँदे टकणे वाल़ा बीचला पर्दा,<verse eid="EXO 35:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 35:13" />मेज ओर तिजी रे डण्डेया समेत सारा समान ओर पेंटा रिया रोटिया;<verse eid="EXO 35:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 35:14" />प्रयासा देणे वाल़े दिऊए समेत तिजी खे राखणे री फट्टी ओर प्रयासा देणे खे तेल।<verse eid="EXO 35:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 35:15" />डण्डेया समेत तूपबेदी, अभिषेको रा तेल, खुशबूदार तूप ओर मिलणे वाल़े तम्बूए रे द्धारो रा पर्दा;<verse eid="EXO 35:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 35:16" />डण्‍डे समेत होमबलिया री बेदी, पीतल़ी री छानणी ओर पावे समेत पीतल़ी री अऊदी;<verse eid="EXO 35:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 35:17" />आँगणो रे पड़दे ओर तिना रे खम्बेया समेत पावे ओर आँगणो रे द्धारो रे पड़दे;<verse eid="EXO 35:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 35:18" />मिलणे वाल़े तम्बूए खे ओर तिजी रे आँगण दुँईं रे खूँडे ओर तिजी खे बानणे वाल़िया रस्सिया;<verse eid="EXO 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 35:19" />पवित्र जगा रे सेवा-टईल करने खे बेल-बूटे कढ़ाई कित्ते रे टाल्ले ओर पुरोईतो रा काम करने खे हारूण पुरोईतो रे पवित्र टाल्ले ओर तेसरे पाऊआ रे टाल्ले बी जेबे सेयो पुरोईतो रा काम करने लगो।<verse eid="EXO 35:19" /></para>
  <para style="s">इस्राएली लोका रे जरीये पेंट ल्याऊणी</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 35:20" />तेबे मूसे रे ये सब बोलणे ते बाद इस्राएलिया री सारी मण्डल़ी मूसे रे सामणे ते आपणे डेरे रे चली गी। <verse eid="EXO 35:20" /><verse number="21" style="v" sid="EXO 35:21" />ओर जितणेया री ईम्मत ऊई ओर जितणेया रे मनो रे एड़ी इच्छा जागी थी, सेयो सब मिलणे वाल़े तम्बूए रे काम करने ओर तिजी री सारी सेवकाई ओर पवित्र टाल्ले बनाणे खे यहोवे री पेंट ल्याऊणे लगे। <verse eid="EXO 35:21" /><verse number="22" style="v" sid="EXO 35:22" />क्या जवाणस, क्या मर्द, जितणेया रे मनो रे एड़ी इच्छा जागी सेयो सारे जुगनू, कोका, बाल़िया, छाप ओर बांगा बगैरा सूईने रे गईणे ल्याऊणे लगे, ईंयाँ जितणे माणूं यहोवे खे सूईने री एड़ी पेंट देणे वाल़े थे सेयो सारे तिना खे लईगे।<verse eid="EXO 35:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 35:23" />ओर जेस-जेस मर्दो गे नीले, बैंगणी ओर लाल रंगो रे टाल्ले, लीलणो रा टाल्ला, बाकरिया रे बाल़, लाल रंगो रे रंगी री खाडूआ री खाल या बाकरेया री खाल थी सेयो तिना खे ली आए।<verse eid="EXO 35:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 35:24" />फेर जितणे चाँदी या पीतल़ी री पेंट देणे वाल़े थे सेयो यहोवे खे तेड़ी ई पेंट ली आए ओर जेस-जेस गे बबूलो री लकड़ी कोई कामो री थी, सेयो तिजी खे ली आए।<verse eid="EXO 35:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 35:25" />ओर जितणिया जवाणसा बुणने री कारीगरी जाणो थिया सेयो आपणे आथो साथे नीले, बैंगणी ओर लाल रंगो रे तागेया ते ओर अच्छे लीलणो रे तागेया ते टाल्ले बुणी की ली आईया। <verse eid="EXO 35:25" /><verse number="26" style="v" sid="EXO 35:26" />ओर जितणी जवाणसा बुणाई करने रे अक्लमंद ओर काम करने रे खुश थिया, तिने बाकरिया रे बाल़ बी काते।<verse eid="EXO 35:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 35:27" />ओर इस्राएली मण्डल़िया रे सारे परदान लोक पुरोईतो रा पईनणे वाल़ा एपोद ओर छातिया पाँदे पईनणे वाल़ी झिलमा पाँदे लगाणे खे सुलैमानी पात्थरा री मणि ओर दूजी किमती मणि ली आए। <verse eid="EXO 35:27" /><verse number="28" style="v" sid="EXO 35:28" />सेयो प्रयासा देणे खे जैतूनो रा तेल ओर तूपो री खुशबूदार समग्री ओर अभिषेको रे तेलो रे मिलाणे खे खुशबूदार चीजा ली आए। <verse eid="EXO 35:28" /><verse number="29" style="v" sid="EXO 35:29" />जिना-जिना चीजा खे बनाणे री आज्ञा यहोवे मूसे रे जरीये दित्ती थी, तिजी खे जो कुछ जरूरी था, से सेयो सारे मर्द ओर जवाणसा ली आईया, जिना रे मनो रे एड़ी ई इच्छा जागी थी। ईंयाँ इस्राएली यहोवे खे आपणी-आपणी इच्छा ते पेंट ली आए।<verse eid="EXO 35:29" /></para>
  <para style="s">पवित्र तम्बू बनाणा</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 35:30" />तेबे मूसे इस्राएलिया खे बोलेया, “सुणो, यहोवे यहूदा रे गोत्रो वाल़े बसलेल नाओं रे माणूंए खे चूणी राखेया, जो ऊरीए रा पाऊ ओर हूरो रा पोता ए। <verse eid="EXO 35:30" /><verse number="31" style="v" sid="EXO 35:31" />ओर से परमेशरो री बुद्धि, समज, परविणता, ज्ञान ओर सब प्रकारा री कारीगरिया री समज देणे वाल़ी आत्मा ते परिपूर्ण करी राखेया। <verse eid="EXO 35:31" /><verse number="32" style="v" sid="EXO 35:32" />कि से एते बुद्धिया ते परी की सूईने, चाँदी ओर पीतल़ी रे कारीगरिया रे काम करी सको। <verse eid="EXO 35:32" /><verse number="33" style="v" sid="EXO 35:33" />तेसरी कारीगरी मणि कटणे रे ओर लकड़िया पाँदे नक्काशी करने रे, बल्कि सब केड़िया चीजा पाँदे कलाकारी करने री थी।”<verse eid="EXO 35:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 35:34" />यहोवे तेसखे ओर दानो रे गोत्रो रे अहीसामाको रे पाऊ ओहोलीआब नाओं रे माणूंए खे बी एड़ी समज देई राखी की से ओरी खे बी शिक्षा देई सको। <verse eid="EXO 35:34" /><verse number="35" style="v" sid="EXO 35:35" />यहोवे इना दुँईं रा मन एड़ी अक्ला साथे परीता कि सेयो नक्काशी करने, कढ़ने, ओर नीले, बैंगणी ओर लाल रंगो रे तागेया ते ओर लीलणो रे टाल्लेया रे कढ़ाई करने खे बल्कि सब केड़ी बणावटा रे कारीगर ओर दमाको साथे काम निकयाल़ने रे, सब केड़े काम करो।<verse eid="EXO 35:35" /></para>
  <chapter eid="EXO 35" />
  <chapter number="36" style="c" sid="EXO 36" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 36:1" />तेबे मूसे बोलेया, “बसलेल, ओहोलीआब ओर सबी किस्मा री कारीगरी जाणने वाल़े जिना खे यहोवे एड़ी योग्यता ओर समज देई राखी ओ कि सेयो यहोवे री सारी आज्ञा रे मुताबिक पवित्र जगा री सेवकाईया रे सब प्रकारा रा काम करना जाणो कि से सब काम किंयाँ करना।”<verse eid="EXO 36:1" /></para>
  <para style="s">इस्राएली लोका रा जरूरती ते जादा पेंट देणा</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 36:2" />तेबे मूसे बसलेल, ओहोलीआब ओर सबी किस्मा री कारीगरी जाणने वाल़े, जिना खे यहोवे एड़ी कारीगरी ओर समज देई राखी जो आयी की काम करना चाओ थे सेयो सारे बुलाए।<verse eid="EXO 36:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 36:3" />फेर तिने लोके मूसे रे आथो ते सेयो सब चीजा लईया जिना खे इस्राएली लोक पवित्र जगा री सेवकाईया रे काम ओर तिजी खे बनाणे खे पेंट ली आए थे। हर रोज प्यागा सब लोक मूसे गे आपणी इच्छा ते पेंट ल्यायो थे। <verse eid="EXO 36:3" /><verse number="4" style="v" sid="EXO 36:4" />ओर पवित्र जगा रे काम करने वाल़े सब कारीगरी लोक आपणा-आपणा काम छाडी की मूसे गे आये <verse eid="EXO 36:4" /><verse number="5" style="v" sid="EXO 36:5" />ओर मूसे खे बोलणे लगे, “यहोवे री आज्ञा रे मुताबिक एस कामो खे करने खे जितणा समान चाईयो तिजी ते जादा सेयो लोक ल्याऊणे लगी रे।” <verse eid="EXO 36:5" /><verse number="6" style="v" sid="EXO 36:6" />तेबे मूसे तिना रे सारे डेरे रे ये आज्ञा देई की गल्ल पऊँचाई कि हर कोई मर्द या जवाणस पवित्र जगा खे ओर पेंट नि ल्याओ। ईंयाँ लोक ओर पेंट ल्याऊणे ते रोकी ते। <verse eid="EXO 36:6" /><verse number="7" style="v" sid="EXO 36:7" />कऊँकि सारे कामो खे जितणा समान जरूरी था तिथणा बल्कि तिजी ते जादा बनाणे वाल़ेया गे आयी चुकेया था।<verse eid="EXO 36:7" /></para>
  <para style="s">रणे री जगा खे बनाणा</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 36:8" />ओर काम करने वाल़े जितणे कारीगर अक्लमंद थे तिने मिलणे वाल़े तम्बूए खे दस पड़दे बणाए ओर तिना पाँदे लीलणो रे टाल्ले ओर नीले, बैंगणी ओर लाल रंगो रे तागेया ते कढ़ाई करी की करूब बणाए। <verse eid="EXO 36:8" /><verse number="9" style="v" sid="EXO 36:9" />एकी-एकी पड़दे री लम्बाई 28 आथ ओर चौड़ाई चऊँ आथा री ऊई, सारे पड़दे एक जेड़े नापो रे बणी रे थे। <verse eid="EXO 36:9" /><verse number="10" style="v" sid="EXO 36:10" />तिने पाँज पड़दे एकी-दूजे साथे जोड़ी ते ओर फेर दूजे पाँज पड़दे बी एकी-दूजे साथे जोड़ी ते। <verse eid="EXO 36:10" /><verse number="11" style="v" sid="EXO 36:11" />ओर पईले जोड़े रे पाँज पड़देया रे दुँईं कूणेया पाँदे बसलेले नीले-नीले छल्ले लगाए। तिंयाँ ई दूजे जोड़े रे पाँज पड़देया रे दुँईं कूणेया पाँदे बी तिने नीले-नीले छल्ले लगाए। <verse eid="EXO 36:11" /><verse number="12" style="v" sid="EXO 36:12" />तिने पईले जुड़े रे दुँईं कूणेया पाँदे एक जेड़े आमणे-सामणे 50-50 ऊक लगवाए। <verse eid="EXO 36:12" /><verse number="13" style="v" sid="EXO 36:13" />फेर तिने सूईने रे 50 कड़े बणाए ओर तिना रे जरीये दूई कनारले पड़दे एकी-दूजे साथे एड़े जोड़े कि मिलणे वाल़ा तम्बू मिली की एक ऊईगा।<verse eid="EXO 36:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 36:14" />फेर तिने मिलणे वाल़े तम्बूए खे पाँदा ते टकणे खे बाकरिया रे बाल़ो रे ग्यारा पड़दे बणाए। <verse eid="EXO 36:14" /><verse number="15" style="v" sid="EXO 36:15" />तिना एकी-एकी पड़दे री लम्बाई 30 आथ ओर चौड़ाई चऊँ आथो री थी, सेयो ग्यारा पड़दे एक जेड़े नापो रे थे। <verse eid="EXO 36:15" /><verse number="16" style="v" sid="EXO 36:16" />फेर तिने इना बीचा ते पाँज पड़दे लग ओर छे पड़दे लग जोड़ी ते। <verse eid="EXO 36:16" /><verse number="17" style="v" sid="EXO 36:17" />फेर तिने पईले जुड़े रे पड़दे रे कूणे पाँदे 50 ऊक लगाए ओर ईंयाँ ई दूजे जुड़े रे पड़दे रे कूणे पाँदे बी 50 ऊक एड़े लगाए <verse eid="EXO 36:17" /><verse number="18" style="v" sid="EXO 36:18" />ओर तिजी ते बाद तिने तम्बूए खे जोड़ने खे पीतल़ी रे 50 कड़े बी बणाए जेते साथे से एक ऊई जाओ। <verse eid="EXO 36:18" /><verse number="19" style="v" sid="EXO 36:19" />फेर तिने तम्बूए खे लाल रंगो रे रंगी रिया खाडूआ रिया खाला रा एक टखण ओर तिजी पाँदो खे बाकरेया री खाला रा बी एक टकणा बणाया। <verse eid="EXO 36:19" /><verse number="20" style="v" sid="EXO 36:20" />तेबे तिने मिलणे वाल़े तम्बूए खे खड़े करने खे बबूलो री लकड़िया रे तख़्ते बणाए। <verse eid="EXO 36:20" /><verse number="21" style="v" sid="EXO 36:21" />एक-एक तख़्ते री लम्बाई दस आथ ओर चौड़ाई डेढ़ आथो री ऊई। <verse eid="EXO 36:21" /><verse number="22" style="v" sid="EXO 36:22" />तिना तख़्तेया खे एकी-दूजे साथे जोड़ने खे दो-दो चूल़ा बणाईया, मिलणे वाल़े तम्बूए रे सारे तख़्ते तिने ईंयाँ ई बणाए। <verse eid="EXO 36:22" /><verse number="23" style="v" sid="EXO 36:23" />फेर तिने मिलणे वाल़े तम्बूए रे तख़्ते ईंयाँ बणाए कि दक्खणा रिया तरफा खे 20 तख़्ते लगे। <verse eid="EXO 36:23" /><verse number="24" style="v" sid="EXO 36:24" />ओर इना 20 तख़्तेया निठे चाँदिए रे 40 पावे, मतलब एक-एक तख़्ते निठे तिना रे चूल़ेया खे दो-दो पावे लगाए। <verse eid="EXO 36:24" /><verse number="25" style="v" sid="EXO 36:25" />ओर मिलणे वाल़े तम्बूए री दूजी तरफा खे, मतलब उत्तरो रिया तरफा खे बी तिने 20 तख़्ते बणाए। <verse eid="EXO 36:25" /><verse number="26" style="v" sid="EXO 36:26" />ओर इना खे बी तिने चाँदिए रे 40 पावे, मतलब एक-एक तख़्ते निठे दो-दो पावे लगाए। <verse eid="EXO 36:26" /><verse number="27" style="v" sid="EXO 36:27" />ओर मिलणे वाल़े तम्बूए री पिछली तरफा खे, मतलब पश्चिमो रिया तरफा खे तिने छे तख़्ते बणाए। <verse eid="EXO 36:27" /><verse number="28" style="v" sid="EXO 36:28" />ओर मिलणे वाल़े तम्बूए रे पिछले इस्से रे कूणेया खे तिने दो तख़्ते बणाए। <verse eid="EXO 36:28" /><verse number="29" style="v" sid="EXO 36:29" />इना दुँईं कूणेया खे बणाए रे दुँईं तख़्तेया रा नाप थाला ते पाँदले सिरे तक एक बराबर था ओर एकी कड़े रे लगाए, तिने दुँईं तख़्तेया रा आकार एड़ा ई बणाया। <verse eid="EXO 36:29" /><verse number="30" style="v" sid="EXO 36:30" />ईंयाँ 8 तख़्ते ऊए ओर तिना रे चाँदिए रे 16 पावे ऊए, मतलब एक-एक तख़्ते निठे दो-दो पावे ऊए। <verse eid="EXO 36:30" /><verse number="31" style="v" sid="EXO 36:31" />तेबे तिने बबूलो रिया लकड़िया रिया कड़िया बणाईया, मतलब मिलणे वाल़े तम्बूए री एक तरफा रे तख़्तेया खे पाँज कड़िया <verse eid="EXO 36:31" /><verse number="32" style="v" sid="EXO 36:32" />ओर मिलणे वाल़े तम्बूए री दूजी तरफा रे तख़्तेया खे पाँज कड़िया ओर मिलणे वाल़े तम्बूए रे पश्चिमा रिया तरफा खे पिछले इस्से खे बी पाँज कड़िया बणाईया। <verse eid="EXO 36:32" /><verse number="33" style="v" sid="EXO 36:33" />ओर बसलेले बीचली कात तख़्तेया रे बीचो-बिछिए एड़ी बणायी कि से तम्बूए रे एक सिरे ते दूजे सिरे तक पऊँची गी। <verse eid="EXO 36:33" /><verse number="34" style="v" sid="EXO 36:34" />ओर तिने तख़्ते सूईने साथे मढ़े ओर डण्डेया रे कड़े बी सूईने रे बणाए ओर डण्डे बी सूईने साथे मढ़े। <verse eid="EXO 36:34" /><verse number="35" style="v" sid="EXO 36:35" />फेर तिने लीलणो रे अच्छे टाल्लेया साथे नीले, बैंगणी ओर लाल रंगो रे टाल्लेया ते बीचला पर्दा बणाया, तिने तिजी पाँदे कढ़ाई करी की करूब बणाए। <verse eid="EXO 36:35" /><verse number="36" style="v" sid="EXO 36:36" />ओर तिने तिजी खे बबूलो री लकड़िया रे चार खम्बे बणाए ओर सेयो सूईने साथे मढ़े ओर तिना रे कड़े सूईने रे बणाए ओर तिने तिजी खे चाँदिए रे चार पावे बणाए। <verse eid="EXO 36:36" /><verse number="37" style="v" sid="EXO 36:37" />तिने तम्बूए रे द्धारो खे लीलणो रे टाल्लेया रा नीले, बैंगणी ओर लाल रंगो रे तागेया ते बेल-बूटे री कढ़ाई कित्ते रा पर्दा बणाया। <verse eid="EXO 36:37" /><verse number="38" style="v" sid="EXO 36:38" />ओर तिने कड़ेया समेत तिजी रे पाँज खम्बे बी बणाए ओर खम्बेया रे सिरे ओर तिना खे जोड़ने खे बी सूईने री पट्टी बणाई ओर तिना रे पाँज पावे पीतल़ी रे बणाए।<verse eid="EXO 36:38" /></para>
  <chapter eid="EXO 36" />
  <chapter number="37" style="c" sid="EXO 37" />
  <para style="s">वाचा रा सन्दूक बनाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 37:1" />तेबे बसलेल ओर तेस साथे काम करने वाल़ेया बबूलो री लकड़िया रा एक सन्दूक बणाया, तिजी री लम्बाई टाई आथ, चौड़ाई डेढ़ आथ ओर ऊचाई डेढी आथो री थी। <verse eid="EXO 37:1" /><verse number="2" style="v" sid="EXO 37:2" />तिने से बारे पीतरे शुद्ध सूईने साथे मढ़ेया ओर तिदे चऊँ कनारे सूईने री बाड़ बणाई। <verse eid="EXO 37:2" /><verse number="3" style="v" sid="EXO 37:3" />ओर तिजी रे चऊँ पावेया पाँदे सूईने रे चार कड़े बणवाई की दो कड़े एकी कनारे ओर दो कड़े दूजे कनारे लगाए। <verse eid="EXO 37:3" /><verse number="4" style="v" sid="EXO 37:4" />तेबे तिने बबूलो री लकड़िया रे डण्डे बणाए ओर सेयो सूईने साथे मढ़े। <verse eid="EXO 37:4" /><verse number="5" style="v" sid="EXO 37:5" />तिने सेयो सन्दूको रे दुँईं कनारेया रे कड़ेया रे पाए ताकि तिना रे साअरे साथे सन्दूक चकेया जाओ। <verse eid="EXO 37:5" /><verse number="6" style="v" sid="EXO 37:6" />तेबे तिने शुद्ध सूईने रा दया रा आसण बणाया, तिजी री लम्बाई टाई आथ ओर चौड़ाई डेढी आथो री थी। <verse eid="EXO 37:6" /><verse number="7" style="v" sid="EXO 37:7" />तिने सूईना कअड़ी की दो करूब दया रे आसणो रे दुँईं सिरेया पाँदे बणाए; <verse eid="EXO 37:7" /><verse number="8" style="v" sid="EXO 37:8" />तिने एक करूब एकी कनारे पाँदे ओर दूजा करूब दूजे कनारे पाँदे बणाया, तिने सेयो दया आसणो रे टकणे साथे एक ई टुकड़े रे दुँईं सिरेया पाँदे बणाए। <verse eid="EXO 37:8" /><verse number="9" style="v" sid="EXO 37:9" />ओर तिना करूबा रे पंख पाँदा ते एड़े फैले रे बणो कि दया रा आसण तिना साथे टखेया रा रओ ओर तिना रे मूँ आमणे-सामणे ओर दया रे आसणो रे कनारो खे कित्ते रे बणाए।<verse eid="EXO 37:9" /></para>
  <para style="s">पवित्र मेज बनाणी</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 37:10" />तेबे तिने बबूलो रिया लकड़िया रा एक मेज बणाया, तिजी री लम्बाई दो आथ, चौड़ाई एक आथ ओर ऊचाई डेढ़ आथ थी। <verse eid="EXO 37:10" /><verse number="11" style="v" sid="EXO 37:11" />फेर तिने से शुद्ध सूईने साथे मढ़ेया ओर तिदे चऊँ कनारे सूईने री पट्टी बणाई। <verse eid="EXO 37:11" /><verse number="12" style="v" sid="EXO 37:12" />ओर तिने तिजी खे चार आऊँगल़ चौड़ी एक चौखट ओर इजी चौखटा खे चऊँ कनारे सूईने री एक पट्टी बणाई। <verse eid="EXO 37:12" /><verse number="13" style="v" sid="EXO 37:13" />ओर तिने मेजो खे सूईने रे चार कड़े कअड़ी की तिना चऊँ कूणेया रे लगाए, जो तिजी रे चऊँ पावेया रे थे। <verse eid="EXO 37:13" /><verse number="14" style="v" sid="EXO 37:14" />सेयो कड़े चौखटा रे लगाए ताकि तिना कड़ेया रे डण्डे पाई की मेज सानिया रे चखी जाओ। <verse eid="EXO 37:14" /><verse number="15" style="v" sid="EXO 37:15" />तिने मेज चकणे खे बबूलो री लकड़िया रे डण्डे बणाए ओर फेर सेयो सूईने साथे मढ़े। <verse eid="EXO 37:15" /><verse number="16" style="v" sid="EXO 37:16" />ओर तिने मेजो पाँदला समान, मतलब परात ओर तूपदान, चमचे, लटणे रे कटोरे सब शुद्ध सूईने रे बणाए।<verse eid="EXO 37:16" /></para>
  <para style="s">सूईने री दिऊए राखणे री फट्टी बनाणी</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 37:17" />तेबे तिने शुद्ध सूईना कअड़ी की डण्डिया समेत दिऊए राखणे री फट्टी बणाई; तिजी रे फूल राखणे री कऊली, गाठ ओर फूल सारे एक ई टुकड़े रे बणे। <verse eid="EXO 37:17" /><verse number="18" style="v" sid="EXO 37:18" />ओर तिजी रे कनारेया ते छे डाल़िया निकल़ी री बणिया। तीन डाल़िया तो दिऊए राखणे री फट्टिया रे एकी कनारे ते ओर तीन डाल़िया दूजे कनारे ते निकल़ी रिया बणिया। <verse eid="EXO 37:18" /><verse number="19" style="v" sid="EXO 37:19" />एकी-एकी डाल़िया रे बदामो रे फूला जेड़े तीन-तीन फूल राखणे रिया कऊलिया, एक-एक गाठ ओर एक-एक फूल बणेया, दिऊए राखणे री फट्टिया ते निकल़ी री इना छे डाल़िया रे एड़ा ई सब कुछ था। <verse eid="EXO 37:19" /><verse number="20" style="v" sid="EXO 37:20" />ओर फट्टिया री डण्डिया पाँदे बदामो रे फूलो जेड़ी गाठ ओर फूलो समेत चार फूल राखणे रिया कऊलिया जेड़िया बणी री थिया।<verse eid="EXO 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 37:21" />ओर फट्टिया ते निकल़ी रिया छे डाल़िया बीचा ते दो-दो डाल़िया निठे एक-एक गाठ फट्टिया साथे एक ई टुकड़े रिया बणिया। <verse eid="EXO 37:21" /><verse number="22" style="v" sid="EXO 37:22" />गाठी ओर डाल़िया, सब दिऊए राखणे री फट्टिया समेत शुद्ध सूईना कअड़ी की पूरी दिऊए राखणे री फट्टी एकी टुकड़े कअड़ी की बणिया।<verse eid="EXO 37:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 37:23" />ओर तिने शुद्ध सूईने री फट्टिया रे सातो दिऊए, चिमटे ओर आग चकणे रे पांडे बणाए। <verse eid="EXO 37:23" /><verse number="24" style="v" sid="EXO 37:24" />तिने पैंती किलो शुद्ध सूईने री दिऊए राखणे री फट्टी सारे समानो समेत बणाई।<verse eid="EXO 37:24" /></para>
  <para style="s">तूपबेदी बनाणी</para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 37:25" />फेर बसलेल ओर तेस साथे काम करने वाल़ेया बबूलो री लकड़िया री तूपबेदी बी बणाई, तिजी री लम्बाई एक आथ ओर चौड़ाई एक आथ थी, से चौरस बणी ओर तिजी री ऊचाई दो आथ थी ओर तेतेरे सींग तिजी साथे एकी टुकड़े रे बणे थे। <verse eid="EXO 37:25" /><verse number="26" style="v" sid="EXO 37:26" />तिने तिजी रे पाँदले पल्ले, चऊँ तरफा रे कुणे ओर सींगो समेत से बेदी शुद्ध सूईने साथे मढ़ी ओर तिजी रे चऊँ कनारे सूईने री एक बाड़ बणाई। <verse eid="EXO 37:26" /><verse number="27" style="v" sid="EXO 37:27" />ओर तेते बाड़ा निठे तिजी रे दुँईं पल्लेया पाँदे तिने सूईने रे दो-दो कड़े बणाई की लगाए ताकि तिना कड़ेया रे डण्डे लगाई की बेदिया खे चकी सको। <verse eid="EXO 37:27" /><verse number="28" style="v" sid="EXO 37:28" />ओर तिने डण्डे बबूलो री लकड़िया रे बणाए ओर सेयो सूईने साथे मढ़े।<verse eid="EXO 37:28" /></para>
  <para style="s">अभिषेको रा पवित्र तेल बनाणा</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 37:29" />ओर तिने अभिषेको रा पवित्र तेल ओर खुशबूदार चीजा रा तूप गन्धो री रीतिया रे मुताबिक बणाया।<verse eid="EXO 37:29" /></para>
  <chapter eid="EXO 37" />
  <chapter number="38" style="c" sid="EXO 38" />
  <para style="s">होमबलिया री बेदी बनाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 38:1" />तेबे बसलेल ओर तेस साथे काम करने वाल़ेया होमबलिया खे बबूलो री लकड़िया री बेदी बी बणाई, तिजी री लम्बाई ओर चौड़ाई पाँज-पाँज आथ ओर ऊचाई तीन आथ थी; ईंयाँ से चौरस बणी।<verse eid="EXO 38:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 38:2" />ओर तिने तिजी रे चारो कूणेया पाँदे चार सींग एकी ई टुकड़े रे बिना जोड़ो रे बणाए ओर सेयो पीतल़ी साथे मढ़वाए। <verse eid="EXO 38:2" /><verse number="3" style="v" sid="EXO 38:3" />ओर तिने बेदिया रा सारा समान पीतल़ी रा बणाया, मतलब तिजी री आँडिया, फरूए, खून छिड़कणे रे कटोरे, मास निकाल़ने खे कांडे ओर स्वा चकणे खे गिट्ठिया बणाईया। <verse eid="EXO 38:3" /><verse number="4" style="v" sid="EXO 38:4" />ओर बेदिया रे थालले इस्से रे तिजी रे चऊँ कनारे तिने पीतल़ी री जाल़िया री एक छानणी बणाई, से बेदिया बीचे लगी री थी। <verse eid="EXO 38:4" /><verse number="5" style="v" sid="EXO 38:5" />ओर तिने पीतल़ी री छानणिया रे चारो कूणेया खे चार कड़े बणाए, ताकि तिना रे डण्डे लगाई की तिजी खे चकी सको।<verse eid="EXO 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 38:6" />तेबे बसलेल ओर तेस साथे काम करने वाल़ेया बबूलो री लकड़िया रे डण्‍डे बणाए ओर सेयो पीतल़ी साथे मढ़वाए। <verse eid="EXO 38:6" /><verse number="7" style="v" sid="EXO 38:7" />फेर तिने डण्डे बेदिया रे कड़ेया रे बेदिया खे चकणे खे पाईते। तिने बेदी तख़्तेया साथे जोड़ी की खोखली बणाई।<verse eid="EXO 38:7" /></para>
  <para style="s">पीतल़ी री अऊदी</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 38:8" />बसलेल ओर तेस साथे काम करने वाल़ेया अऊदी ओर तिजी रा पावा दोनो पीतल़ी रे बणाए, ये मिलणे वाल़े तम्बूए रे द्धारो पाँदे सेवा करने वाल़िया जवाणसा री दित्ती री पेंटे की पीतल़ी रे शीशे की बणाए।<verse eid="EXO 38:8" /></para>
  <para style="s">रणे री जगा रा आँगण बनाणा</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 38:9" />तेबे तिने आँगण बणाया; तेते आँगणो री दक्खणा री तरफा खे 100 आथ लाम्बे लीलणो रे टाल्ले रे पड़दे बणाए; <verse eid="EXO 38:9" /><verse number="10" style="v" sid="EXO 38:10" />तिना खे 20 खम्बे ओर इना रे पीतल़ी रे 20 पावे बणे; पर खम्बेया रे कड़े ओर तिना खे जोड़ने वाल़ी पत्तिया चाँदिए रिया थिया। <verse eid="EXO 38:10" /><verse number="11" style="v" sid="EXO 38:11" />ओर उत्तरो रिया तरफा खे बी 100 आथ लाम्बे पड़दे बणे ओर तिना खे 20 खम्बे ओर इना रे पीतल़ी रे 20 पावे बणे; पर खम्बेया रे कड़े ओर तिना खे जोड़ने वाल़ी पत्तिया चाँदिए रिया थिया। <verse eid="EXO 38:11" /><verse number="12" style="v" sid="EXO 38:12" />ओर पश्चिमो रिया तरफा खे सारे पड़दे मलाई की 50 आथो रे थे तिना खे दस खम्बे ओर दस तिना रे पावे थे; पर खम्बेया रे कड़े ओर तिना खे जोड़ने वाल़ी पत्तिया चाँदिए री थिया। <verse eid="EXO 38:12" /><verse number="13" style="v" sid="EXO 38:13" />ओर आँगणो री पूर्वो रिया तरफा खे बी 50 आथ लाम्बे पड़दे थे। <verse eid="EXO 38:13" /><verse number="14" style="v" sid="EXO 38:14" />आँगणो रे द्धारो रे एकी तरफा खे पंद्रा आथो रे पड़दे बणे; तिजी रे तीन खम्बे ओर तीन पावे थे। <verse eid="EXO 38:14" /><verse number="15" style="v" sid="EXO 38:15" />ओर आँगणो रे द्धारो री दूजी तरफा खे बी पंद्रा आथो रे पड़दे बणे थे ओर तिना खे तीन खम्बे ओर तीन पावे थे। <verse eid="EXO 38:15" /><verse number="16" style="v" sid="EXO 38:16" />आँगणो रे चऊँ कनारले सारे पड़दे अच्छे ते बूणे रे लीलणो रे कपड़े रे बणे रे थे। <verse eid="EXO 38:16" /><verse number="17" style="v" sid="EXO 38:17" />ओर खम्बेया रे पावे पीतल़ी रे थे पर खम्बे पाँदे टांगणे रे ऊक ओर तिना खे जोड़ने वाल़िया पत्तिया चाँदिए री बणिया ओर तिना रे सिरे चाँदिए साथे मढ़े, ईंयाँ आँगणो रे सारे खम्बे चाँदिए री पत्तिया साथे जोड़ी राखे थे। <verse eid="EXO 38:17" /><verse number="18" style="v" sid="EXO 38:18" />आँगणो रे द्धारो रा पड़दा नीले, बैंगणी ओर लाल रंगो रे तागेया साथे बेल-बूटे री कढ़ाई कित्तेया रा लीलणो रे टाल्लेया रा बणेया रा था ओर तिना री लम्बाई 20 आथ, ऊचाई आँगणो रे पड़देया री चौड़ाईया जेड़ी पाँज आथ बणी री थी। <verse eid="EXO 38:18" /><verse number="19" style="v" sid="EXO 38:19" />ओर तिना खे चार खम्बे ओर चऊँ खम्बेया रे चार ई पावे पीतल़ी रे बणे थे, तिना खम्बेया पाँदे टांगणे रे ऊक ओर तिजी खे जोड़ने वाल़िया पत्तिया चाँदिए रिया बणिया ओर तिना रे सिरे चाँदिए साथे मढ़े रे थे। <verse eid="EXO 38:19" /><verse number="20" style="v" sid="EXO 38:20" />मिलणे वाल़े तम्बूए रे ओर आँगणो रे चऊँ कनारले सारे खूँडे पीतल़ी रे बणी रे थे।<verse eid="EXO 38:20" /></para>
  <para style="s">पवित्र जगा रे इस्तेमाल ऊणे वाल़े समानो रा ब्यौरा</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 38:21" />मिलणे वाल़ा तम्बू जिदे गवाईया री चिट्ठिया रा सन्दूक राखी राखेया तेतेखे बनाणे री जगा रा समान जो लेविया री सेवकाईया खे बणेया ओर जेतेरी गिणती हारूण पुरोईतो रे पाऊ ईतामारो रे जरीये मूसे रे कईणे ते ऊई थी, तिजी रा जिकर ये ए।<verse eid="EXO 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 38:22" />जेस-जेस चीजा खे बनाणे री आज्ञा यहोवे मूसे खे दित्ती थी, से यहूदा रे गोत्रो वाल़े बसलेले, जो हूरो रा पोता ओर ऊरीए रा पाऊ था, बणाई तिया। <verse eid="EXO 38:22" /><verse number="23" style="v" sid="EXO 38:23" />तेस साथे दानो रे गोत्रो रा, अहीसामाको रा पाऊ ओहोलीआब था, जो बढ़िया कारीगर ओर कढ़ाई करने वाल़ा ओर नीले, बैंगणी ओर लाल रंगो रे तागेया ते लीलणो रे टाल्लेया रे कढ़ाई करने वाल़ा अच्छा कारीगर था।<verse eid="EXO 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 38:24" />पवित्र जगा रे सारे कामो रे जो दित्ती री पेंटा रा सूईना लगेया, से पवित्र जगा रे शेकेल रे साबो ते 995 किलो ओर 730 शेकेल था। <verse eid="EXO 38:24" /><verse number="25" style="v" sid="EXO 38:25" />ओर मण्डल़िया रे गिणे रे लोका री दित्ती री पेंटा री चाँदी 3 ह्जार 500 किलो ओर पवित्र जगा रे शेकेल रे साबो ते 1 ह्जार 775 शेकेल थी। <verse eid="EXO 38:25" /><verse number="26" style="v" sid="EXO 38:26" />मतलब जितणे 20 साला रे ओर तिजी ते जादा उम्रा रे गिणे थे, सेयो 6 लाख 3 ह्जार 550 मर्द थे ओर एक-एक जणे रिया तरफा ते पवित्र जगा रे शेकेल रे मुताबिक आदा शेकेल, जो एक बेका मतलब 6 ग्राम ओआ मिलेया।<verse eid="EXO 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 38:27" />ओर से 3 ह्जार 500 किलो चाँदी पवित्र जगा रे बीचले तख़्ते खे ओर पड़दे रे पावे बनाणे रे लगी गी, 3 ह्जार 500 किलो चाँदिए ते 100 पावे बणे, एक-एक पावा 35 किलो रा बणेया। <verse eid="EXO 38:27" /><verse number="28" style="v" sid="EXO 38:28" />ओर 1 ह्जार 775 शेकेल जो बची गा तिजी साथे खम्बे रे कड़े बणाए, फेर खम्बेया रे सिरे मढ़े ओर तिना रे डण्डे बी बणाए। <verse eid="EXO 38:28" /><verse number="29" style="v" sid="EXO 38:29" />ओर पेंटा रा पीतल़ 2 ह्जार 450 किलो ओर 2 ह्जार 400 शेकेल था।<verse eid="EXO 38:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 38:30" />तिजी साथे मिलणे वाल़े तम्बूए रे पावे, पीतल़ी री बेदी, पीतल़ी री छानणी ओर बेदिया रा सारा समान बणाया; <verse eid="EXO 38:30" /><verse number="31" style="v" sid="EXO 38:31" />ओर आँगणो रे चऊँ कनारले पावे ओर तिजी रे द्धारो रे पावे, मिलणे वाल़े तम्बू ओर आँगणो रे चऊँ कनारले खूँडे बी बणाए।<verse eid="EXO 38:31" /></para>
  <chapter eid="EXO 38" />
  <chapter number="39" style="c" sid="EXO 39" />
  <para style="s">पुरोईता रे टाल्ले बनाणे</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 39:1" />तेबे तिने नीले, बैंगणी ओर लाल रंगो रे तागेया ते कढ़ाई कित्ते रे टाल्ले पवित्र जगा री सेवकाईया खे बणाए ओर ईंयाँ ई हारूणो खे बी पवित्र टाल्ले बणाए, जिंयाँ यहोवे मूसे खे आज्ञा दित्ती थी।<verse eid="EXO 39:1" /></para>
  <para style="s">एपोद बनाणा</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 39:2" />ओर तिने सूईने रा एपोद, नीले, बैंगणी ओर लाल रंगो रे तागेया रा ओर अच्छे ते बूणे रे लीलणो रे टाल्लेया रा बणाया। <verse eid="EXO 39:2" /><verse number="3" style="v" sid="EXO 39:3" />ओर तिने सूईना कूटी-कूटी की तिजी रे पत्तर बणाए, तेबे पत्तरेया खे कटी-कटी की डोरी बणाई ओर तिना डोरिया रे जरीये नीले, बैंगणी ओर लाल रंगो रे तागेया ते ओर लीलणो रे टाल्लेया रे कढ़ाईया करी की मलाई ते।<verse eid="EXO 39:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 39:4" />एपोदो खे जोड़ने खे तिने तिजी रे कान्दा पाँदे बन्दन बणाए ताकि तिना दुँईं सिरेया खे जोड़ी सको <verse eid="EXO 39:4" /><verse number="5" style="v" sid="EXO 39:5" />एपोदो पाँदे जो कढ़ाई कित्तेया रा पटका था तिजी री बुणाई तिजी जेड़ी बणाई ओर सेयो दोनो बिना जोड़ो रे बणाए ओर जो सूईने, नीले, बैंगणी ओर लाल रंगो रे तागेया ते बुणेया रा लीलणो रे टाल्लेया रा बणेया, जेड़ा यहोवे मूसे खे बोलेया तेड़ा तिने कित्तेया। <verse eid="EXO 39:5" /><verse number="6" style="v" sid="EXO 39:6" />ओर तिदे तिने सुलैमानी पात्थरा री मणि कटी की तिना रे इस्राएलो रे पाऊआ रे नाओं जिंयाँ छापा खुदवाया जाओआ तिंयाँ ई खुदवाणे ओर सूईने रे खाँचेया रे जड़ी ते। <verse eid="EXO 39:6" /><verse number="7" style="v" sid="EXO 39:7" />फेर तिने सेयो एपोदो री कान्दा रे बन्दना पाँदे लगाए, ताकि सेयो इस्राएलिया खे याद करने वाल़े मणि ठईरो, जेड़ी यहोवे मूसे खे आज्ञा दित्ती थी।<verse eid="EXO 39:7" /></para>
  <para style="s">छातिया पाँदे पईनणे वाल़ी झिलम</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 39:8" />बसलेल ओर तेस साथे काम करने वाल़ेया छातिया पाँदे पईनणे वाल़ी झिलम बी एपोदो जेड़ी सूईने साथे नीले, बैंगणी ओर लाल रंगो रे तागेया ओर ठीक टंगो रे बूणे रे लीलणो रे टाल्लेया रे बेल-बूटे रा काम कित्ते री बणाई। <verse eid="EXO 39:8" /><verse number="9" style="v" sid="EXO 39:9" />छातिया पाँदे पईनणे वाल़ी झिलम तो चौरस बणी ओर तिने से दोरी बणाई ओर से दोरी ऊई की से एक गिर्ठ लाम्बी ओर एक गिर्ठ चौड़ी बणाई।<verse eid="EXO 39:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 39:10" />ओर तिने चऊँ पाल़िया रे मणि लगाए। पईली पाल़िया रे माणिक्य, पुखराज ओर लालड़ी लगाए; <verse eid="EXO 39:10" /><verse number="11" style="v" sid="EXO 39:11" />ओर दूजी पाल़िया रे मरकत, नीलमणि ओर ईरा लगाया; <verse eid="EXO 39:11" /><verse number="12" style="v" sid="EXO 39:12" />ओर तीजी पाल़िया रे लशम, सूर्यकांत ओर नीलम लगाए; <verse eid="EXO 39:12" /><verse number="13" style="v" sid="EXO 39:13" />ओर चौथी पाल़िया रे फिरोजा, सुलैमानी पात्थरा री मणि ओर यशब लगाए; यो सारे लग-लग सूईने रे खाँचेया रे लगाए।<verse eid="EXO 39:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 39:14" />ओर यो मणिया इस्राएलो रे पाऊआ रे नाओं री गिणतिया रे मुताबिक बारा थिया; बारा गोत्रा बीचा ते एकी-एकी रा नाओं तिना पाँदे खुदवाई राखेया था।<verse eid="EXO 39:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 39:15" />ओर तिने छातिया पाँदे पईनणे वाल़ी झिलमा पाँदे रस्सिया जेड़ी बाटी री शुद्ध सूईने री माल़ा बणाई की लगाई; <verse eid="EXO 39:15" /><verse number="16" style="v" sid="EXO 39:16" />तेबे तिने सूईने रे दो खांचे ओर सूईने रे दो कड़े बणाई की दोनो कड़े छातिया पाँदे पईनणे वाल़ी झिलमा रे दुँईं सिरेया पाँदे लगाए। <verse eid="EXO 39:16" /><verse number="17" style="v" sid="EXO 39:17" />फेर तिने तिना दुँईं कड़ेया रे रस्सिया जेड़ी गूँदी री सूईने री जंजीर छातिया पाँदे पईनणे वाल़ी झिलमा रे सिरेया पाँदे लगाई। <verse eid="EXO 39:17" /><verse number="18" style="v" sid="EXO 39:18" />ओर दुँईं जंजीरा रे दोनो सिरे तिने एपोदो रे सामणे दुँईं कान्दा रे बन्दनो पाँदे लगाए। <verse eid="EXO 39:18" /><verse number="19" style="v" sid="EXO 39:19" />ओर तिने सूईने रे दो ओर कड़े बणवाई की छातिया पाँदे पईनणे वाल़े झिलमो रे दुँईं सिरेया पाँदे एपोदो रे पीतरली तरफा खे लगाए। <verse eid="EXO 39:19" /><verse number="20" style="v" sid="EXO 39:20" />ओर तिने सूईने रे ओर दो कड़े बणाए ओर एपोदो री दुँईं कान्दा रे बन्दनो पाँदे थाला ते एपोदो रे सामणे ओर जोड़ो गे, एपोदो रे कढ़ाई कित्ते रे पट्टके पाँदे लगाए। <verse eid="EXO 39:20" /><verse number="21" style="v" sid="EXO 39:21" />तेबे तिने छातिया पाँदे पईनणे वाल़ी झिलम तिजी रे कड़ेया रे जरीये एपोदो रे कड़ेया रे नीली डोरिया साथे एड़ा बानेया कि से एपोदो रे पट्टके पाँदे रओ ओर छातिया पाँदे पईनणे वाल़ी झिलम एपोदो ते लग नि ऊई सको; जेड़ी यहोवे मूसे खे आज्ञा दित्ती थी।<verse eid="EXO 39:21" /></para>
  <para style="s">पुरोईता रे ओर टाल्ले बनाणे</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 39:22" />तेबे एपोदो रा पूरा चोगा नीले रंगो रे तागेया साथे बूणे रे टाल्ले ते बणाया। <verse eid="EXO 39:22" /><verse number="23" style="v" sid="EXO 39:23" />ओर से एड़ा बणेया कि तिजी रे गल़े रे एक छेद था ओर छेदो रे चऊँ कनारे बूणी री एक पट्टी थी जेते कि से फटी नि सको। <verse eid="EXO 39:23" /><verse number="24" style="v" sid="EXO 39:24" />ओर तिने तिजी रे थालले केरे रे नीले, बैंगणी ओर लाल रंगो रे तागेया ते लीलणो रे टाल्ले रे अनार बणाए। <verse eid="EXO 39:24" /><verse number="25" style="v" sid="EXO 39:25" />ओर तिने शुद्ध सूईने रिया कंटिया बी बणाई की चोगे रे थालले केरे रे चऊँ कनारे अनारा रे बीचो-बिछिए लगाईया। <verse eid="EXO 39:25" /><verse number="26" style="v" sid="EXO 39:26" />मतलब तेते चोगे रे थालले केरे रे चऊँ कनारे एक सूईने री कंटी ओर अनार लगाया, फेर एक सूईने री कंटी ओर अनार लगाया ताकि तिना खे पईनी की सेवा-टईल करो, जेड़ी यहोवे मूसे खे आज्ञा दित्ती थी।<verse eid="EXO 39:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 39:27" />तेबे तिने हारूण ओर तेसरे पाऊआ खे ठीक टंगो रे बूणी की लीलणो रे टाल्ले बणाए, <verse eid="EXO 39:27" /><verse number="28" style="v" sid="EXO 39:28" />ओर ठीक टंगो रे बूणे रे लीलणो रे टाल्ले री पगड़ी, टोपिया ओर निकरा <verse eid="EXO 39:28" /><verse number="29" style="v" sid="EXO 39:29" />जेड़ी यहोवे मूसे खे आज्ञा दित्ती थी तेड़ा ई पटका बी ठीक टंगो ते बुणेया रा लीलणो रे टाल्ले रे नीले, बैंगणी ओर लाल रंगो रे तागेया ते बूटेदार कढ़ाई कित्ते रा बणाया।<verse eid="EXO 39:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 39:30" />तेबे तिने पवित्र मुकुटो री पट्टी शुद्ध सूईने री पत्तिया री बणाई ओर तिदे यो अक्षर खुदवाई की छापे यहोवे खे पवित्र। <verse eid="EXO 39:30" /><verse number="31" style="v" sid="EXO 39:31" />ओर तिने तिदे नीली डोरी लगाई, जेते कि से ऊबे पगड़िया पाँदे रओ, जेड़ी यहोवे मूसे खे आज्ञा दित्ती थी।<verse eid="EXO 39:31" /></para>
  <para style="s">कामा रा पूरा ऊणा</para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 39:32" />ईंयाँ मिलणे वाल़े तम्बूए रा सारा काम खत्म ऊआ ओर जेस-जेस कामो री आज्ञा यहोवे मूसे खे दित्ती थी, इस्राएलिये तिजी रे मुताबिक ई कित्तेया। <verse eid="EXO 39:32" /><verse number="33" style="v" sid="EXO 39:33" />तेबे सेयो मिलणे वाल़े तम्बूए खे ओर तिजी रे सारे समानो खे मूसे गे ली आए, मतलब तिजी री खूँडी, तख़्ते, डण्डे, खम्बे, पावे बगैरा सारे समानो समेत तम्बू; <verse eid="EXO 39:33" /><verse number="34" style="v" sid="EXO 39:34" />ओर लाल रंगो रे रंगी री खाडूआ री खाला रा टकणा, बाकरेया री खाला रा टकणा ओर बीचला पर्दा, <verse eid="EXO 39:34" /><verse number="35" style="v" sid="EXO 39:35" />डण्डेया समेत गवाईया रा सन्दूक ओर दया रा आसण; <verse eid="EXO 39:35" /><verse number="36" style="v" sid="EXO 39:36" />सारे समानो समेत मेज ओर पेंटा री रोटिया, <verse eid="EXO 39:36" /><verse number="37" style="v" sid="EXO 39:37" />शुद्ध सूईने री दिऊए राखणे री फट्टी, तिजी रे दिऊए ओर प्रयासा देणे खे तेल; <verse eid="EXO 39:37" /><verse number="38" style="v" sid="EXO 39:38" />सूईने री बेदी, अभिषेको रा तेल, खुशबूदार तूप ओर मिलणे वाल़े तम्बूए रे द्धारो रा पड़दा; <verse eid="EXO 39:38" /><verse number="39" style="v" sid="EXO 39:39" />पीतल़ी री छानणी ओर तिजी रे डण्डे ओर सारे समानो समेत पीतल़ी री बेदी ओर पावे समेत अऊदी। <verse eid="EXO 39:39" /><verse number="40" style="v" sid="EXO 39:40" />आँगणो रे पड़दे, खम्बे ओर पावेया समेत ओर आँगणो रे द्धारो रा पड़दा, रस्सिया, खूँडे ओर मिलणे वाल़े तम्बूए री सेवकाईया रा समान; <verse eid="EXO 39:40" /><verse number="41" style="v" sid="EXO 39:41" />पवित्र जगा रे सेवा-टईल करने खे बूणे रे बेल-बूटे री कढ़ाई कित्ते रे टाल्ले, जो हारूण पुरोईतो रे पवित्र टाल्ले ओर तेसरे पाऊआ रे टाल्ले जिना खे पईनी की तिना पुरोईतो रा काम करना था। <verse eid="EXO 39:41" /><verse number="42" style="v" sid="EXO 39:42" />यहोवे जो आज्ञा मूसे खे दित्ती थी तिजी रेई मुताबिक इस्राएलिये सारे काम कित्ते। <verse eid="EXO 39:42" /><verse number="43" style="v" sid="EXO 39:43" />तेबे मूसे सारे कामो री जाँच करी की देखेया कि तिने यहोवे री आज्ञा रे मुताबिक सब कुछ करी राखेया। तेबे मूसे तिना खे आशीर्वाद दित्तेया।<verse eid="EXO 39:43" /></para>
  <chapter eid="EXO 39" />
  <chapter number="40" style="c" sid="EXO 40" />
  <para style="s">मिलणे वाल़े तम्बूए खे खड़ा करने री आज्ञा</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 40:1" />तेबे यहोवे मूसे खे बोलेया, <verse eid="EXO 40:1" /><verse number="2" style="v" sid="EXO 40:2" />“नए सालो रे पईले मीन्ने रे पईले दिने तैं मिलणे वाल़ा तम्बू खड़ा करी देणा। <verse eid="EXO 40:2" /><verse number="3" style="v" sid="EXO 40:3" />तिदे वाचा रा सन्दूक राखी की बीचले पड़दे पीछे राखी देणा। <verse eid="EXO 40:3" /><verse number="4" style="v" sid="EXO 40:4" />ओर मेज पीतरे लई जायी की जो कुछ तिदे सजाणा ओगा से सजाई देणा; तेबे दिऊए राखणे री फट्टी पीतरे लई जायी की तिजी रे दिऊए बाल़ी देणे। <verse eid="EXO 40:4" /><verse number="5" style="v" sid="EXO 40:5" />फेर सूईने री तूपो री बेदी वाचा रे सन्दूको सामणे राखणी ओर मिलणे वाल़े तम्बूए रे द्धारो रे पड़दे लगाई देणे। <verse eid="EXO 40:5" /><verse number="6" style="v" sid="EXO 40:6" />ओर मिलणे वाल़े तम्बूए रे द्धारो रे सामणे होमबलिया री बेदी राखणी। <verse eid="EXO 40:6" /><verse number="7" style="v" sid="EXO 40:7" />ओर मिलणे वाल़े तम्बू ओर बेदिया बीचे अऊदी राखी की तिदे पाणी परना। <verse eid="EXO 40:7" /><verse number="8" style="v" sid="EXO 40:8" />ओर चऊँ तरफा रे आँगणो री कनात खड़ी करनी ओर तेस आँगणो रे द्धारो पाँदे पड़दे लटकाई देणे। <verse eid="EXO 40:8" /><verse number="9" style="v" sid="EXO 40:9" />ओर अभिषेको रा तेल लई की मिलणे वाल़े तम्बूए खे ओर जो कुछ तिदे ऊणा सबी रा अभिषेक करना ओर सारे समानो समेत से पवित्र करना, तेबे से पवित्र ठईरना। <verse eid="EXO 40:9" /><verse number="10" style="v" sid="EXO 40:10" />फेर सारे समानो समेत होमबलिया री बेदिया रा अभिषेक करी की से पवित्र करनी; तेबे से परम पवित्र ठईरनी। <verse eid="EXO 40:10" /><verse number="11" style="v" sid="EXO 40:11" />पावे समेत अऊदिया रा बी अभिषेक करी की से पवित्र करनी। <verse eid="EXO 40:11" /><verse number="12" style="v" sid="EXO 40:12" />तेबे हारूण ओर तेसरे पाऊ मिलणे वाल़े तम्बूए रे द्धारो पाँदे लई जायी की पाणिए साथे नुल़ाणे। <verse eid="EXO 40:12" /><verse number="13" style="v" sid="EXO 40:13" />फेर हारूणो खे पवित्र टाल्ले पन्याई की तेसरा अभिषेक करी की से पवित्र करना, ताकि से मेरिया तँईं पुरोईतो रा काम करो। <verse eid="EXO 40:13" /><verse number="14" style="v" sid="EXO 40:14" />ओर तेसरे पाऊ लई जायी की तिना खे टाल्ले पन्याणे। <verse eid="EXO 40:14" /><verse number="15" style="v" sid="EXO 40:15" />ओर जिंयाँ तैं तिना रे बाओ रा अभिषेक कित्तेया तिंयाँ ई तिना रा बी अभिषेक करना, ताकि सेयो मेरिया तँईं पुरोईतो रा काम करो ओर तिना रा अभिषेक तिना री पीढ़िया-पीढ़िया खे सदा पुरोईतो रे पदो रा चिह्न ठईरना।”<verse eid="EXO 40:15" /></para>
  <para style="s">मिलणे वाल़े तम्बूए खे खड़ा करना</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 40:16" />मूसे जो-जो आज्ञा यहोवे दित्ती तिजी रेई मुताबिक कित्तेया। <verse eid="EXO 40:16" /><verse number="17" style="v" sid="EXO 40:17" />ओर दूजे सालो रे पईले मीन्ने रे पईले दिने तम्बू खड़ा कित्तेया। <verse eid="EXO 40:17" /><verse number="18" style="v" sid="EXO 40:18" />जेबे मूसे मिलणे वाल़ा तम्बू खड़ा करवाया तेबे तिने तेतेरे हर तख़्ते रे पावे लगाई की तिना रे बिंडे पाए ओर तिना रे खम्बे खड़े कित्ते। <verse eid="EXO 40:18" /><verse number="19" style="v" sid="EXO 40:19" />फेर तिने मिलणे वाल़े तम्बूए पाँदे तम्बू फैलाया ओर तिने तम्बूए पाँदे टकणा लगाया, जिंयाँ यहोवे मूसे खे आज्ञा दित्ती थी। <verse eid="EXO 40:19" /><verse number="20" style="v" sid="EXO 40:20" />मूसे गवाईया री चिट्ठी लई की वाचा रे सन्दूको रे राखिया ओर सन्दूको रे डण्डे लगाई की तिजी पाँदे दया आसण राखी ता; <verse eid="EXO 40:20" /><verse number="21" style="v" sid="EXO 40:21" />फेर तेबे मूसे वाचा रा सन्दूक मिलणे वाल़े तम्बूए रे पऊँचाया ओर बीचला पड़दा लटकवाई की गवाईया रा सन्दूक तेतेरे पीतरे राखेया, जिंयाँ यहोवे मूसे खे आज्ञा दित्ती थी। <verse eid="EXO 40:21" /><verse number="22" style="v" sid="EXO 40:22" />ओर तिने मिलणे वाल़े तम्बूए री जगा रे उत्तरो रिया तरफा खे बीचले पड़दे ते बारे मेज लगवाई। <verse eid="EXO 40:22" /><verse number="23" style="v" sid="EXO 40:23" />ओर तिजी पाँदे तिने यहोवे रे सामणे रोटी सजायी की राखी, जिंयाँ यहोवे मूसे खे आज्ञा दित्ती थी। <verse eid="EXO 40:23" /><verse number="24" style="v" sid="EXO 40:24" />फेर मूसे रे काम करने वाल़ेया मिलणे वाल़े तम्बूए रे मेजो रे सामणे दक्खणो रिया तरफा खे दिऊए राखणे री फट्टी राखी। <verse eid="EXO 40:24" /><verse number="25" style="v" sid="EXO 40:25" />ओर तेबे तिने दिऊए यहोवे रे सामणे बाल़ी ते जिंयाँ यहोवे मूसे खे आज्ञा दित्ती थी। <verse eid="EXO 40:25" /><verse number="26" style="v" sid="EXO 40:26" />मूसे मिलणे वाल़े तम्बूए रे बीचले पड़दे रे सामणे सूईने री बेदी राखी <verse eid="EXO 40:26" /><verse number="27" style="v" sid="EXO 40:27" />ओर तिने तिजी पाँदे खुशबूदार तूप बाल़ेया, जिंयाँ यहोवे मूसे खे आज्ञा दित्ती थी। <verse eid="EXO 40:27" /><verse number="28" style="v" sid="EXO 40:28" />फेर तिने मिलणे वाल़े तम्बूए रे द्धारो पाँदे पड़दे लगाए। <verse eid="EXO 40:28" /><verse number="29" style="v" sid="EXO 40:29" />फेर तिने मिलणे वाल़े तम्बूए रे द्धारो पाँदे होमबलि राखी की तिजी पाँदे होमबलि ओर नज्जो री बलिया री पेंट चढ़ाई; जिंयाँ यहोवे मूसे खे आज्ञा दित्ती थी। <verse eid="EXO 40:29" /><verse number="30" style="v" sid="EXO 40:30" />ओर तिने मिलणे वाल़े तम्बू ओर बेदिया बीचे अऊदी राखी ओर तिदे तोणे खे पाणी पाया, <verse eid="EXO 40:30" /><verse number="31" style="v" sid="EXO 40:31" />ओर तेबे मूसे, हारूणे ओर तेसरे पाऊए तिदे आपणे-आपणे आथ पैर तोये; <verse eid="EXO 40:31" /><verse number="32" style="v" sid="EXO 40:32" />जेबे-जेबे सेयो मिलणे वाल़े तम्बूए गे या बेदिया गे जाओ थे, तेबे-तेबे सेयो आथ-पैर तोओ थे; जिंयाँ यहोवे मूसे खे आज्ञा दित्ती थी। <verse eid="EXO 40:32" /><verse number="33" style="v" sid="EXO 40:33" />फेर मूसे मिलणे वाल़े तम्बूए रे चऊँ कनारे ओर बेदिया रे नेड़े-तेड़े आँगणो रे पड़दे लगवाए ओर आँगणो रे द्धारो रा पड़दा लटकाई ता। ईंयाँ मूसे सारा काम पूरा करी ता।<verse eid="EXO 40:33" /></para>
  <para style="s">मिलणे वाल़े तम्बूए पाँदे यहोवे री महिमा</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 40:34" />तेबे बादल़ मिलणे वाल़े तम्बूए पाँदे छाईगा ओर यहोवे रा तेज मिलणे वाल़े तम्बूए रे परी गा। <verse eid="EXO 40:34" /><verse number="35" style="v" sid="EXO 40:35" />ओर जो बादल़ मिलणे वाल़े तम्बूए पाँदे ठईरी गा ओर यहोवे रा तेज मिलणे वाल़े तम्बूए रे परी गा, इजी बजअ ते मूसा तिदे जाई नि सकेया। <verse eid="EXO 40:35" /><verse number="36" style="v" sid="EXO 40:36" />इस्राएलिया री सारी यात्रा रे एड़ा ओ था कि जेबे-जेबे बादल़ तम्बूए पाँदा ते उठी जाओ था तेबे-तेबे इस्राएली चली पड़ो थे <verse eid="EXO 40:36" /><verse number="37" style="v" sid="EXO 40:37" />ओर जेस दिने से बादल़ नि उठो था, तो जदुओ तक से नि उठो था तदुओ तक सेयो नि जाओ थे। <verse eid="EXO 40:37" /><verse number="38" style="v" sid="EXO 40:38" />ईंयाँ इस्राएलो रे सारे कराने री यात्रा रे दिनो खे तो यहोवे रा बादल़ मिलणे वाल़े तम्बूए पाँदे रओ था ओर राती तेस ई बादल़ो रे तिना सबी खे आग दिखो थी।<verse eid="EXO 40:38" /></para>
  <chapter eid="EXO 40" />
</usx>