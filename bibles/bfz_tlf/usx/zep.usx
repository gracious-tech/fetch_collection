<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ZEP" style="id" />
  <para style="h">सपन्याह</para>
  <para style="toc1">सपन्याह नबीए रे जरिये लिखी री कताब</para>
  <para style="toc2">सपन्याह</para>
  <para style="toc3">सप.</para>
  <para style="mt">सपन्याह</para>
  <para style="mt2">सपन्याह नबीए रे जरिये लिखी री कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">नबी सपन्याहे ई. पू. 700 साला रे उत्तरो दे, लगभग ई. पू. 621 दे कित्ते दे राजा योशिय्याह रे तार्मिक सुदारा ते पईले प्रचार करने रा काम कित्तेया था। एते कताबा दे जाणे पछयाणे भविष्य रे चिह्ना रे बारे दे शामिल ए : विनाश ओर प्रलय रे संकटो रा एक दिन, जेबे दूजे देवी-देवतेया री पूजा करने रिया बजा ते यहूदा खे सजा दित्ती जाणी। परमेशरो दूजी जातिया रे लोका खे बी सजा देणी। जेबे कि यरूशलेमो खे सजा री आज्ञा देई चूकी रे ए, फेर बी बखत आऊणे पाँदे शईर फेर बसाया जाणा, जेते दे नम्र ओर तर्मी लोक रया करने।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">परमेशरो रे न्याय रा दिन <char style="ior"><ref loc="ZEP 1:1-2:3">1:1-2:3</ref></char></para>
  <para style="io1">इस्राएलो रे पड़ोसी राज्या रा नाश <char style="ior"><ref loc="ZEP 2:4-15">2:4-15</ref></char></para>
  <para style="io1">यरूशलेमो रा नाश ओर छुटकारा <char style="ior"><ref loc="ZEP 3:1-20">3:1-20</ref></char></para>
  <chapter number="1" style="c" sid="ZEP 1" />
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />ये यहोवे रा सन्देश ए जो तिने कूशीए रे पाऊ सपन्याह खे दित्तेया। कूशीए रा बाओ गदल्याह था। गदल्याह रा बाओ अमर्याह था, अमर्याह रा बाओ हिजकिय्याह था। यहोवे ये सन्देश सपन्याह खे तेबे दित्तेया जेबे योशिय्याह राजा था। योशिय्याह आमोनो रा पाऊ था, जो यहूदा रा राजा था।<verse eid="ZEP 1:1" /></para>
  <para style="s">परमेशरो रे न्याय रा दिन</para>
  <para style="p">
    <verse number="2" style="v" sid="ZEP 1:2" />यहोवा बोलोआ, “मां तरतिया पाँदे रणे वाल़े सबी रा अन्त करी देणा, यहोवे री येई बाणी ए। <verse eid="ZEP 1:2" /><verse number="3" style="v" sid="ZEP 1:3" />मां माणूं ओर डांगर ओर जानवर सबी रा अन्त करी देणा, मां सर्गो रे पंछी ओर समुद्रो री मछलिया रा ओर दुष्टा समेत तिना री राखी री ठोकरा रिया बजा रा बी अन्त करी देणा, मां माणूंआ री जाति बी तरतिया पाँदा ते नाश करी देणी,” यहोवे री येई बाणी ए। <verse eid="ZEP 1:3" /><verse number="4" style="v" sid="ZEP 1:4" />“मां यहूदा पाँदे ओर यरूशलेमो रे सब रणे वाल़ेया सजा देणी ओर एते जगा रे बाल देवते रे बचे रे पुरोईता समेत देवतेया रे पुजारिया रे नाओं नाश करी देणे। <verse eid="ZEP 1:4" /><verse number="5" style="v" sid="ZEP 1:5" />कऊँकि सेयो लोक आपणे-आपणे कअरो रे छतो पाँदे चढ़ोए ओर सूरज, चाँद ओर सर्गो रे तारेया री आराधना करोए। सेयो यहोवे री आज्ञा खे मानणे रा वादा करेया करोए, फेर बी सेयो मोलेक देवते री पूजा करदे रओए। <verse eid="ZEP 1:5" /><verse number="6" style="v" sid="ZEP 1:6" />ओर मां सेयो लोक नाश करी देणे जो पईले मेरी आराधना करो थे एबे नि करदे। सेयो एबे यहोवे री आज्ञा खे नि मानदे।”<verse eid="ZEP 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEP 1:7" />परमेशर यहोवे सामणे चुपचाप खड़े रओ, कऊँकि यहोवे रे न्याय रा दिन नेड़े ए। यहोवे आपणी प्रजा बड़े बलिदानो खे त्यार करी राखे ए तिने आपणे पराऊणे शुद्ध करी राखे। <verse eid="ZEP 1:7" /><verse number="8" style="v" sid="ZEP 1:8" />जेबे यहोवा बलिदान चढ़ाणे खे त्यार ऊणा, मां अधिकारिया ओर राजे रे माठेया खे सजा देणी। मां तिना सबी रा बी न्याय करना जो ओरी देशा रे रीति रवाजा खे मानोए। <verse eid="ZEP 1:8" /><verse number="9" style="v" sid="ZEP 1:9" />तेस दिने मां तिना सबी खे सजा देणी जो देऊल़ी खे लाँगोए ओर जो आपणे स्वामिए रे कअरो खे छल ओर चगड़े ते कट्ठे कित्ते रे तअनो ते परोए। <verse eid="ZEP 1:9" /><verse number="10" style="v" sid="ZEP 1:10" />यहोवे री ये बाणी ए, “तेस दिने, लोक यरूशलेमो रे मछलिया रे फाटको गे चींगणे। लोका शईरो रे नवें इस्से गे रोणा, ओर लोका पाह्ड़िया गे कअरा रे रूड़ने रिया आवाजा सुणनिया।”<verse eid="ZEP 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEP 1:11" />ओ मक्तेश<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="fq" closed="false">मक्तेश </char><char style="ft" closed="false">शईरो रा ऊँदला इस्सा जेती बपार ओ था। </char></note> जगा दे रणे वाल़ेयो लोको, तुसे चींगणे। कऊँ? कऊँकि अमीर ओर बपारी नाश करी देणे, जिना गे बऊत चाँदी आ। <verse eid="ZEP 1:11" /><verse number="12" style="v" sid="ZEP 1:12" />तेस दिने मां दिऊआ लई की यरूशलेमो दे खोजबीन करनी ओर जो लोक आपणे पापा दे बेफिकर ऊई की बैठी रे, तिना खे सजा देणे खे। सेयो सोचोए कि यहोवे तिना साथे कुछ नि करना, चाए खरा ओ या बुरा। <verse eid="ZEP 1:12" /><verse number="13" style="v" sid="ZEP 1:13" />तेबे तिना रे दुश्मणा तिना री तअन-सम्पत्ति लूटी देणी ओर तिना रे कअर उजाड़ ऊणे, तिना कअर तो बनाणे, पर तिना दे रयी नि सकणे ओर तिना अंगूरा रे बगीचे तो लगाणे, पर तिना रा शराब नि पी सकणे।<verse eid="ZEP 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEP 1:14" />परमेशरो रा डराऊणा दिन नेड़े ए, से फटाफट नेड़े आऊणे लगी रा, ये एड़ा बखत ऊणा जेबे लोका ईंकी-ईंकी की रोणा, एड़ा बखत ऊणा जेबे तागतबर सिपाईया बी जोरे-जोरे की रोणा, <verse eid="ZEP 1:14" /><verse number="15" style="v" sid="ZEP 1:15" />से रोषो रा दिन, से मुसीबता रा ओर परेशानिया रा दिन, से उजाड़ ओर नाशो रा दिन, से अन्देर ओर अन्दकूप न्हेरे रा दिन ऊणा, ये बऊत ई न्हेरे वाल़ा दिन ऊणा, बऊत ई काल़ा ओर बादल़ा रे परेया रा दिन ऊणा। <verse eid="ZEP 1:15" /><verse number="16" style="v" sid="ZEP 1:16" />रड़सिंगे री आवाज ओर लड़ाईया रे नारे सुणने। सिपाईया तिना शईरा पाँदे अमला करना जिना दे किले ओर गुम्मट ए। <verse eid="ZEP 1:16" /><verse number="17" style="v" sid="ZEP 1:17" />मां सबी माणूंआ पाँदे मुसीबत ल्याऊणी। इजी री खातर तिना अन्देया लोका जेड़े बाट टोल़नी। तिने यहोवे रे खलाफ पाप करी राखेया ए। तिना रा खून तूड़ा जेड़ा बाह्ई देणा। तिना रिया लाशा जमीना पाँदे सड़ी जाणिया। <verse eid="ZEP 1:17" /><verse number="18" style="v" sid="ZEP 1:18" />परमेशरो रे रोषो रे दिने, ना तो चाँदी तिना खे बचायी सकोआ ओर ना सूईना, कऊँकि तेसरी जल़ना री आगी साथे सारी तरती फूकी जाणी, अचाणक तेस तरतिया रे रणे वाल़े सबी रा अन्त करी देणा।<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" sid="ZEP 2" />
  <para style="s">परमेशरो रिया तरफा खे फिरना</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 2:1" />ओ यहूदा रे लोको, जो आपणे बुरेया कामा ते नि शर्मांदे, कट्ठे ऊई जाओ! <verse eid="ZEP 2:1" /><verse number="2" style="v" sid="ZEP 2:2" />परमेशरो रा न्याय आऊणे ते पईले कट्ठे ऊई जाओ। परमेशरो रे न्याय रा दिन अवा रे ड्वाए दे पूए जेड़ा उडी जाणा। छोड़ ई प्रभुए रा महान गुस्सा तुसारे खलाफ आऊणा। तेसरे गुस्से रा दिन तुसारे खलाफ आऊणा। <verse eid="ZEP 2:2" /><verse number="3" style="v" sid="ZEP 2:3" />ओ तरतिया रे सब शरीफ लोको, ओ परमेशरो रे बिधानो खे मानणे वाल़ेयो, तेसखे टोल़दे रओ, तर्मो साथे टोल़ो, नम्र ऊई की टोल़ो, जे तुसे एड़ा करोगे तो परमेशरो रे न्याय रे दिने तेस तुसा री रक्षा करनी। <verse eid="ZEP 2:3" /><verse number="4" style="v" sid="ZEP 2:4" />कऊँकि गाजा शईर ओर अश्कलोन शईर उजाड़ ऊई जाणे, अशदोद शईरो दे रणे वाल़े दिने-दपईरे निकयाल़ी देणे ओर एक्रोन शईर पट्टी देणा।<verse eid="ZEP 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEP 2:5" />समुद्रो रे कनारे रणे वाल़ेया पाँदे लाणत ए, करेती जातिया पाँदे लाणत ए, ओ कनान, ओ पलिश्तिया रे देश, परमेशरो रा वचन तेरे खलाफ बोलणे लगी रा ए ओर मां तूँ एड़ा नाश करना कि तांदे कोई नि बचणा। <verse eid="ZEP 2:5" /><verse number="6" style="v" sid="ZEP 2:6" />तेस समुद्रो रे कनारे ई ग्वाल़ेया रे कअर ऊणे ओर पेडा रिया गवाईणी समेत चराईया ई चराईया ऊणिया। <verse eid="ZEP 2:6" /><verse number="7" style="v" sid="ZEP 2:7" />मतलब सेई समुद्रो रा कनारा यहूदा रे कराने रे बचे रे लोका खे मिलणा, तेती तिना खे काओ रे मदान मिलणे। तिना अश्कलोनो रे कअरा पाँदे कब्जा करी लणा ओर तिना दे रणे। तिना रे परमेशरो तिना री देखपाल़ करनी। तेस तिना खे फेर सफल ऊणे रा आर्शीवाद देणा।<verse eid="ZEP 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEP 2:8" />सेना रा यहोवा, इस्राएलो रा परमेशर बोलोआ, “आऊँ जाणूंआ कि मोआब ओर अम्मोनिये लोके क्या कित्तेया! तिने लोके आसा रे लोका री बेज्जती कित्ती। तिने लोके आपणे देशो खे ओर जादा बढ़ाणे खे तिना री जमीन लई।” <verse eid="ZEP 2:8" /><verse number="9" style="v" sid="ZEP 2:9" />इजी बजा ते इस्राएलो रा परमेशर, सेना रे परमेशर यहोवे री ये बाणी ए, “मेरी जिन्दगिया री कसम, पक्का मोआब ओर अम्मोन नाश ऊई जाणे, सदोम ओर गमोरा जेड़े शईर पूरी तरआ ते नाश ऊई जाणे। तिना री जमीन चींआ रे डाल़ा, लूणो री खानी, ओर हमेशा उजाड़ रणे वाल़ी जगा बणी जाणी। मेरे लोका बीचा ते बचे रे लोका सेयो लूटी लणे ओर तिना री जमीन लई लणी।” <verse eid="ZEP 2:9" /><verse number="10" style="v" sid="ZEP 2:10" />ये तिना रे कमण्डो रा बदला ऊणा, कऊँकि तिने सेना रे यहोवे री प्रजा री बेज्जती कित्ती ओर तिना रा मजाक उडाया।<verse eid="ZEP 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEP 2:11" />यहोवे सेयो डराई देणे कऊँकि तेस देशो रे सब देवता नाश करी देणे। तेबे सारी दुनिया रे देश सबी आपणे-आपणे देशो दे यहोवे री आराधना करनी। <verse eid="ZEP 2:11" /><verse number="12" style="v" sid="ZEP 2:12" />ओ कूशो रे लोको, तुसे बी मां आपणियां तलवारी की कायी देणे। <verse eid="ZEP 2:12" /><verse number="13" style="v" sid="ZEP 2:13" />यहोवे आसा रे उत्तर-पूर्बा दे बसे दे अश्शूरो खे सजा देणी ओर नाश करी देणा। तेस इजी री राजधानी नीनवे ऊजड़ ओर बेकार करी देणी, एक एड़ी जगा जो रेगिस्तानो जेड़ी सूकी ऊणी। <verse eid="ZEP 2:13" /><verse number="14" style="v" sid="ZEP 2:14" />तेबे सिर्फ बणो रे जानवरा रे चूण्ड तेस बर्बाद शईरो दे रणे। उल्लू ओर काओ तिना खम्बेया पाँदे बैठणे जो खड़े छाडीते दे ए। तिना री आवाज दवारिया ते आऊँदी सुणने लगणी। काओ द्वारा री पैड़िया पाँदे बैठणे। तिना लोका रे खाली कअरा दे काल़े पंछी बैठणे। <verse eid="ZEP 2:14" /><verse number="15" style="v" sid="ZEP 2:15" />येई तेस शईरो साथे ऊणा जो आपणी तागती पाँदे इतणा परोसा करोआ ओर सोचोआ की आऊँ बचेया दा ए। सेयो बोलोए कि कोई बी दूजा शईर आसा बराबर नि ए ये पूरी तरआ ते खंडहर बणी जाणे, बणो रे जानवरा इना दे बसणा। जो कोई बी इना शईरा रिये जाणा तेस इना रा मजाक ड्वाणा ओर इना ते कृणा करनी।<verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" sid="ZEP 3" />
  <para style="s">यरूशलेमो रा पाप ओर छुटकारा</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 3:1" />यरूशलेम शईरो खे लाणत ए! एसरे लोक ओरी खे केसोए। सेयो परमेशरो री आज्ञा खे मानणे ते ना करोए ओर सेयो अशुद्ध ए, <verse eid="ZEP 3:1" /><verse number="2" style="v" sid="ZEP 3:2" />सेयो केसी री गल्ल नि मानदे। सेयो यहोवे री चतौणिया खे नि मानदे। सेयो एस पाँदे परोसा नि करदे। सेयो आपणे परमेशरो ते मताद नि मांगदे। <verse eid="ZEP 3:2" /><verse number="3" style="v" sid="ZEP 3:3" />यरूशलेमो रे परदान दहाड़ने वाल़े शेर ए। तेसरे राजा भेड़िये ए जो सांजा खे शकार करोए, जो प्यागा खे आड्डी पनि छाडदे। <verse eid="ZEP 3:3" /><verse number="4" style="v" sid="ZEP 3:4" />तेसा रे भविष्यबक्ता तोखा देणे वाल़े ओर विश्वासघाती ए, तेसा रे पुरोईते पवित्र जगा अशुद्ध कित्ती ओर मूसे रे बिधानो रे खलाफ काम करी राखेया। <verse eid="ZEP 3:4" /><verse number="5" style="v" sid="ZEP 3:5" />परमेशर जो तेसा बीचे ए, से तर्मी ए, तेस बुराई नि करनी, से लोका साथे न्याय करोआ। पर बुरे लोका खे आपणे कित्ते रे बुरे कामा रिया बजा ते शर्म नि आऊँदी।<verse eid="ZEP 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEP 3:6" />मैं दूजी जातिया एथो तक नाश कित्तिया कि तिना रे कुणे वाल़े गुम्मट ऊजड़ी गे, मैं तिना रिया सड़का एथो तक सूनिया कित्तिया कि कोई तिना दे नि चलदा, तिना रे शईर एथो तक नाश ऊए कि तिना दे कोई माणूं बल्कि कोई बी प्राणी नि रया। <verse eid="ZEP 3:6" /><verse number="7" style="v" sid="ZEP 3:7" />परमेशरे बोलेया, “एबे तां मेरा डर मानणा ओर मेरी बकणा मानणा, जेते कि तेसा दे रणे री जगा, जो ठराई राखेया तिजी रे मुताबिक नाश नि ओ। पर सेयो सारे बुरे लोक तेड़े ई बुरे काम ओर जादा करना चाओए जो तिने पईले करी राखे।” <verse eid="ZEP 3:7" /><verse number="8" style="v" sid="ZEP 3:8" />इजी बजा ते परमेशरो री ये बाणी ए, “एबे तूँ तेस दिनो रा इंतजार कर, जेबे आऊँ तेरे खलाफ आपू गवा रे रूपो दे खड़ा ऊणा। मैं ये फैंसला कित्तेया ए: मां देश कट्ठे करने, मां राज्य कट्ठे करने; मां तिना पाँदे आपणा गुस्सा पड़काणा; तिना पाँदे आपणे गुस्से री आग बरसाणी। मेरे जल़नी री आगी ते सारी तरती पस्म ऊई जाणी।”<verse eid="ZEP 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEP 3:9" />तेस बखते मां जातिया-जातिया री पाषा बदली देणी। मां तिना खे शुद्ध बोली प्रदान करनी। लोका मां यहोवे रा नाओं पुकारना, ओर मिली-जुली की मेरी सेवा करनी। <verse eid="ZEP 3:9" /><verse number="10" style="v" sid="ZEP 3:10" />मेरे तित्तर-बित्तर ऊए दे लोक कूशो री नदिया ते पारा ते मांगे आऊणे। तिना मेरी आराधना करनी। तिना माखे पेंट ल्याऊणी। <verse eid="ZEP 3:10" /><verse number="11" style="v" sid="ZEP 3:11" />तेस बखते तुसा, मेरे लोका खे एबे शर्मिंदा ऊणे री जरूरत नि ऊणी कि तुसे मेरे खलाफ बिद्रोह कित्तेया। मां सेयो सब लोक टाई देणे जो कमण्डी ए, ओर तुसा फेर मेरे पवित्र पाह्ड़ो पाँदे मेरे खलाफ बिद्रोह नि करना। <verse eid="ZEP 3:11" /><verse number="12" style="v" sid="ZEP 3:12" />कऊँकि मां तां बीचे एक दीन ओर नम्र लोका रा दल बचायी की राखणा ओर तिना यहोवे रे नाओं री शरण लणी। <verse eid="ZEP 3:12" /><verse number="13" style="v" sid="ZEP 3:13" />इस्राएलो रे बचे रे लोका ना तो बुराई करनी ओर ना चूठ बोलणा ओर ना तिना रे मुंए ते छलो री गल्ल निकल़नी। सेयो खाणा ओर राम करना ओर तिना खे डराणे वाल़ा कोई नि ऊणा।<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">प्रका. 14:5 </char></note><verse eid="ZEP 3:13" /></para>
  <para style="s">खुशिया रा गाणा</para>
  <para style="p">
    <verse number="14" style="v" sid="ZEP 3:14" />ओ सिय्योन, जोरे की गा, ओ इस्राएल, जयजयकार कर! ओ यरूशलेम, आपणे पूरे दिलो ते खुशी मना ओर तुसा रा मन खुशिया रे परी जाओ। <verse eid="ZEP 3:14" /><verse number="15" style="v" sid="ZEP 3:15" />कऊँकि यहोवे आपणा न्याय करने वाल़ा आथ टाई लणा, ओर तेरे दुश्मणा री सेना ओरे-पोरे करी देणी। ओर इस्राएलो रे राजा यहोवे आपू तां बीचे रया करना! अन्तो दे तेरे कष्ट दूर ऊई जाणे, ओर तूँ फेर कदी बी बिपदा ते नि डरना। <verse eid="ZEP 3:15" /><verse number="16" style="v" sid="ZEP 3:16" />तेस बखते यरूशलेमो खे ये बोलेया जाणा, “ओ सिय्योन डर नि, ओर कमजोर नि पड़।” <verse eid="ZEP 3:16" /><verse number="17" style="v" sid="ZEP 3:17" />तेरा परमेशर यहोवा तां बीचे रओआ, से उद्धार करने दे पराक्रमी ए, से तेरी बजा ते खुश ऊणे ते मगन ऊणा, से आपणे प्यारो रिया बजा ते चुप रणा, तेस गाणा, कऊँकि से तुसा रिया तँईं बऊत खुश ए! <verse eid="ZEP 3:17" /><verse number="18" style="v" sid="ZEP 3:18" />यहोवा बोलोआ, “तुसे लोक इजी री खातर उदास ओर बेज्जत थे कऊँकि तुसे आपणे तार्मिक त्योआरा दे शामिल नि ऊई सके पर मां तुसे फेर बेज्जत नि ऊणे देणे। <verse eid="ZEP 3:18" /><verse number="19" style="v" sid="ZEP 3:19" />तेस बखते मां तिना सबी ते जो ताखे दु:ख देओए, अन्त करी देणा ओर मां लंगड़े ठीक करने ओर जिना री बेज्जतिया री चर्चा सारी तरतिया दे फैली री, तिना री तारीफ ओर कीर्ति सब जगा दे फैलाणी। <verse eid="ZEP 3:19" /><verse number="20" style="v" sid="ZEP 3:20" />मां तेस बखते ई तुसे लई जाणे ओर तेस बखते ई तुसे कट्ठे करने ओर जेबे मां तुसा सामणे तुसा रे बन्दी लोक वापस ल्याऊणे, सबी लोका तुसा री तारीफ करनी। ये तेबे ऊणा जेबे मां तुसा रिया आखी रे सामणे तुसा रे गुलाम वापस ल्याऊणे!” यहोवे ये सब बोली राखेया।<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>