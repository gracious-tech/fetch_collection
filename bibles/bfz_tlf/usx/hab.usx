<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAB" style="id" />
  <para style="h">हबक्कूक</para>
  <para style="toc1">हबक्कूक नबीए रे जरिये लिखी री कताब</para>
  <para style="toc2">हबक्कूक</para>
  <para style="toc3">हब.</para>
  <para style="mt">हबक्कूक</para>
  <para style="mt2">हबक्कूक नबीए रे जरिये लिखी री कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">ई. पू. 700 साला रे लगभग अन्तो दे नबी हबक्कूको रे वचन तेस बखते लिखे थे जेबे बेबीलोनो रा राज था। इना टीठ लोका रे चगड़े सेयो बुरी तरआ ते ईलाई दित्ते थे, इजी री खातर तिने परमेशरो ते पूछेया, “फेर तूँ विश्वासघातिया खे कऊँ देखदा रएआ, ओर जेबे दुष्ट बेकसूरो खे दबाओआ, तेबे तूँ कऊँ चुपचाप रएआ?” <char style="xt"><ref loc="HAB 1:3">1:3</ref></char> परमेशरो रा ज्वाब था कि तेस आपणे ठराए रे बखते काम करना ओर इजी बीचे तर्मी आपणे विश्वासो रे जरीये जिऊँदा रणा। <char style="xt"><ref loc="HAB 2:4">2:4</ref> </char></para>
  <para style="ip">कताबा रे बाकी इस्से दे दुष्टा रे नाशो री भविष्यबाणी करी राखी ए, ओर अन्तो दे परमेशरो री महानता ओर लिखणे वाल़े रे पक्के परोसे रा गुणगाण करी राखेया ए।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">हबक्कूको री शकाईता ओर परमेशरो रा ज्वाब <char style="ior"><ref loc="HAB 1:1-2:4">1:1-2:4</ref> </char></para>
  <para style="io1">दुष्टो रा नाश <char style="ior"><ref loc="HAB 2:5-20">2:5-20</ref></char></para>
  <para style="io1">हबक्कूको री प्रार्थना <char style="ior"><ref loc="HAB 3:1-19">3:1-19</ref> </char></para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />ये से सन्देस ए जो नबी हबक्कूके एकी दर्शणो रे जरीये देखेया था।<verse eid="HAB 1:1" /></para>
  <para style="s">हबक्कूको री शकाईत</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 1:2" />मैं बोलेया, “ओ यहोवा, मां कदुओ तक तांते प्रार्थना करदे रणा ओर तां नि सुणना? आऊँ तांते मतादा रिया तँईं बिनती करूँआ ओर बोलूँआ कि लोक हर जगा लड़ाई चगड़ा करने लगी रे, पर तूँ आसा खे नि बचांदा। <verse eid="HAB 1:2" /><verse number="3" style="v" sid="HAB 1:3" />तूँ माखे अनर्थ काम कऊँ दखाएया? क्या बजा ए कि तूँ उत्पाद देखदा ई रएया? मां सामणे लूट-पाट ओर उपद्रव ऊँदे रओए ओर चगड़ा ऊँदा रओआ ओर बईस बढ़दी जाओई। <verse eid="HAB 1:3" /><verse number="4" style="v" sid="HAB 1:4" />इजी री खातर बिधान कमजोर ऊईगा रा ओर न्याय कदी बी दिशदा नि ए। दुष्ट लोक तर्मिया खे केरी लओए, इजी री खातर बिधान एबे निष्पक्ष नि रईगा दा ए।”<verse eid="HAB 1:4" /></para>
  <para style="s">परमेशर ज्वाब देओआ</para>
  <para style="p">
    <verse number="5" style="v" sid="HAB 1:5" />तुसे सब लोक दूजे देशा खे त्यानो साथे देखो। जो कुछ ऊणे लगी रा तिजी खे देखी की तुसे बऊत हैरान ऊई जाणे। जदुए तक तुसे जिऊँदे ए, मां एक बऊत ई अचम्बे रा काम करना। जे कोई तुसा खे बताओ बी तो तुसा परोसा नि करना। <verse eid="HAB 1:5" /><verse number="6" style="v" sid="HAB 1:6" />देखो, आऊँ कसदिया खे उभारने वाल़ा ए, सेयो गुस्से वाल़े ओर जल्दबाजी करने वाल़ी जाति ए, जो ओरी री रणे री जगा रे अधिकारी ऊणे खे पूरी तरतिया दे फैली गे रे। <verse eid="HAB 1:6" /><verse number="7" style="v" sid="HAB 1:7" />सेयो खतरनाक ओर डराऊणे ए, सेयो आपू ई आपणे न्याय री बडयाई ओर तारीफा री बजा ए। <verse eid="HAB 1:7" /><verse number="8" style="v" sid="HAB 1:8" />तिना रे कोड़े चीतेया ते बी जादा तेज चलणे वाल़े ए ओर साँजा खे शिकार करने वाल़े भेड़िये ते बी जादा गुस्से वाल़े ए, तिना रे सवार दूर-दूर उटकदे ऊए आओए। आ, सेयो दूरो ते आओए ओर शिकारो पाँदे चाफ बाणे वाल़े उकाबो जेड़ी चाफ बाओए। <verse eid="HAB 1:8" /><verse number="9" style="v" sid="HAB 1:9" />सेयो सारे के सारे दूजेया खे नाश करने रिया तँईं त्यार ऊई की बैठी रे। तिना री बड़ी सेना रेगिस्तानो ते आऊणे वाल़ी अवा जेड़ी आगे बढ़ोई। सेयो कैदिया खे बालूए रिया कणियां जेड़े कट्ठा करोए। <verse eid="HAB 1:9" /><verse number="10" style="v" sid="HAB 1:10" />सेयो राजेया रा मजाक उडाओए ओर परदाना रा मजाक करोए, सेयो सबी मजबूत किलेया पाँदे आसोए, कऊँकि सेयो किलाबंदी बानी की तिना खे जीती लओए। <verse eid="HAB 1:10" /><verse number="11" style="v" sid="HAB 1:11" />तेबे सेयो अवा जेड़े एकदम निकल़ी जाओए ओर आगे चली जाओए सेयो दोषी ए। सेयो आपणी तागती रे देवते री पूजा करोए।<verse eid="HAB 1:11" /></para>
  <para style="s">हबक्कूको रा फेर दशा बताणा</para>
  <para style="p">
    <verse number="12" style="v" sid="HAB 1:12" />ओ परमेशर यहोवा, ओ मेरे पवित्र परमेशर, क्या तूँ शुरूए ते ई नि ए? इजी बजा ते आसे लोक नि मरने। ओ यहोवा, तैं सेयो न्याय रिया तँईं ठराई राखे, ओर ओ चट्टान, तैं यो बकणे रिया तँईं बठयाल़ी राखे। <verse eid="HAB 1:12" /><verse number="13" style="v" sid="HAB 1:13" />तेरी आखी एड़िया शुद्ध ए कि तूँ बुराईया खे देखी नि सकदा ओर उत्पादो खे देखी की चुप नि रयी सकदा, तेबे तूँ विश्वासघातिया खे कऊँ देखदा रएया ओर जेबे दुष्ट निर्दोषो खे निगल़ी जाओआ, तेबे तूँ कऊँ चुप रएया? <verse eid="HAB 1:13" /><verse number="14" style="v" sid="HAB 1:14" />तूँ माणूंआ खे समुद्रो री मछलिया जेड़ा ओर लूरने वाल़े जन्तुआ जेड़ा बणाएया, जिना पाँदे कोई राज करने वाल़ा नि ए? <verse eid="HAB 1:14" /><verse number="15" style="v" sid="HAB 1:15" />दुष्ट माणूं तिना सबी खे ऊका साथे पकड़ी की चकी लओआ, से तिना खे आपणे जाल़ो दे फसाई लओआ, से आपणे तेस जाल़ो दे कट्ठा करी लओआ, ओर ईंयाँ से खुश ओर मगन ओआ। <verse eid="HAB 1:15" /><verse number="16" style="v" sid="HAB 1:16" />सेयो आपणे तिना जाल़ा री पूजा करोए, जिना रे जरीये तिने आसे पकड़े थे, ओर तिना बढ़ेया जाल़ा रे आगे बलि चढ़ाणी ओर तिना रे सामणे तूप बाल़ना। तिना बोलणा, “तिना जाल़ा रिया बजा ते आसे अमीर बणी रे ओर मईंगा खाणा खाणे लाईक बणीगे दे। <verse eid="HAB 1:16" /><verse number="17" style="v" sid="HAB 1:17" />क्या तां तिना खे एड़ा करने देंदे रणा? क्या तिना आपणे जाल़ो दे जितणी बार चाओ मछलिया परदे रणा? क्या तिना दूजे देशा खे नाश करदे रणा ओर रूकणा नि?”<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 2:1" />मां आपणे पईरेदारा रे गुम्मटो पाँदे चढ़ी जाणा ओर आपणे पईरेदारा रिया जगा दे खड़े ऊई जाणा। तेती मां ये देखणे खे इंतजार करदे रणा कि यहोवा क्या बोलोआ ओर तेस मेरी शकाईता रा क्या ज्वाब देणा।<verse eid="HAB 2:1" /></para>
  <para style="s">हबक्कूको खे यहोवे रा दुबारा ज्वाब</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2" />यहोवे माखे बोलेया, “दर्शणो रिया गल्ला लिखी दे, बल्कि फटिया दे साफ-साफ लिखी दे, ताकि कोई बी माणूं इजी खे सानिया दे पढ़ी सको। ओर से सन्देश ओरी लोका खे बी दशी सकोआ। <verse eid="HAB 2:2" /><verse number="3" style="v" sid="HAB 2:3" />कऊँकि एस दर्शणो री गल्ल ठराए रे बखतो दे पूरी ऊणे वाल़ी ए, से बखत जो मैं राखी राखेया ए। ये आऊणे वाल़े बखत ए, पर ये पक्का ऊणा, जेड़ा मैं बोली राखेया ए। ये बऊत छोड़ नि ऊई सकदा, पर तुसा खे ईम्मत राखणी चाईयो। मां जो तुसा खे दखाणा से पक्का सई बखतो पाँदे पूरा ऊणा, इजी री खातर इजी रा इंतजार करो।” <verse eid="HAB 2:3" /><verse number="4" style="v" sid="HAB 2:4" />एस सन्देशो तिना लोका री मताद नि करी पाणी जो इजी पाँदे त्यान देणे ते ना करोए। पर समजदार लोका एते सन्देशो पाँदे परोसा करना ओर आपणे परोसे रिया बजा ते तर्मी जिऊँदा रणा। <verse eid="HAB 2:4" /><verse number="5" style="v" sid="HAB 2:5" />शराबो ते तोखा ओआ, कमण्डी माणूं कअरे नि रंदा ओर तेसरी इच्छा अधलोको जेड़ी पूरी नि ऊँदी ओर मौता जेड़ा तेसरा पेट नि फरदा। से सबी जातिया खे आपू गे खींजी लओआ ओर सबी देशो रे लोका खे आपू गे कट्ठा करी की राखोआ। <verse eid="HAB 2:5" /><verse number="6" style="v" sid="HAB 2:6" />पक्का ई, इना लोका तेसरा मजाक करदे ऊए बोलणा, “तेस पाँदे लाणत ए जो इतणे दिना तक लूटणे लगी रा ए। जो एड़िया तिना चीजा खे लूटणे लगी रा ए जो तेसरिया नि थिया! जो कितणे ई लोका खे आपणे कर्जे रे बोजो थाले दबाणे लगी रा ए।”<verse eid="HAB 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HAB 2:7" />अचाणक, तेरे देणदारा तेरे खलाफ काम करना। तिना तां पाँदे अमला करना ओर तेरा सब कुछ छुड़ाई लणा, जेबे कि तूँ कांबदा ओर बेसारा खड़ेया दा रणा। <verse eid="HAB 2:7" /><verse number="8" style="v" sid="HAB 2:8" />कऊँकि तैं बऊत सारे देश लूटी राखे, एबे सबी बचे दे लोका तूँ लूटणा। तैं सारे देशो दे अत्या करी राखिया ओर शईरा दे लड़ाई चगड़े फलाई राखे। <verse eid="HAB 2:8" /><verse number="9" style="v" sid="HAB 2:9" />लाणत ए तेस पाँदे, जो माणूं बुरे काम करने रिया बजा ते अमीर बणोआ, तेसरा ये अमीर बणना तेसखे ई बऊत बुरा ऊणा। एड़ा माणूं बची की रणे रिया तँईं एड़े काम करोआ। से सोचोआ कि से तेसरी चीजा खे चोरी करने ते दूजेया लोका खे रोकी सकोआ। पर तेस पाँदे बुरिया गल्ला पड़निया ई ए। <verse eid="HAB 2:9" /><verse number="10" style="v" sid="HAB 2:10" />तैं बऊत जे लोक नाश करी की आपणे कअरो खे शर्म ऊणे जोगी योजना कित्ती ओर आपणे ई प्राणो रा दोषी ठईरी रा। <verse eid="HAB 2:10" /><verse number="11" style="v" sid="HAB 2:11" />कअरो रिया कांदा रे पात्थर बी तुसा रे खलाफ चींगणे लगी रे, एथो तक की तेरे आपणे कअरो रे छतो रिया कड़िया ये मानणे लगी रिया कि तूँ बुरा ए।<verse eid="HAB 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HAB 2:12" />लाणत ए तेस पाँदे, जो माणूं अत्या करी की शईर बणाओआ ओर बुरे काम करी की आपणे किले खे मजबूत करोआ। <verse eid="HAB 2:12" /><verse number="13" style="v" sid="HAB 2:13" />देखो, क्या सेना रे यहोवे रिया तरफा ते ये नि ऊँदा कि दूजे देशा रे लोक काम तो करोए, पर सेयो आगी दे फूकी जाओए ओर राज्य-राज्य रे लोका रा काम बेकार ठईरोआ। <verse eid="HAB 2:13" /><verse number="14" style="v" sid="HAB 2:14" />कऊँकि तरती परमेशरो रे महिमा रे ज्ञानो ते एड़ी परी जाणी, जेड़ा समुद्र पाणिए की परी जाओआ। <verse eid="HAB 2:14" /><verse number="15" style="v" sid="HAB 2:15" />लाणत ए तेस पाँदे, जो आपणे पड़ोसिये खे शराब पल़्याओआ ओर तिदे जईर मलायी की नशेड़ी करी देयोआ, ताकि से आपणे ओश खोई देयो ओर तूँ तेसखे नांगा देखे। <verse eid="HAB 2:15" /><verse number="16" style="v" sid="HAB 2:16" />पर तैं आपणे आपू खे बेज्जतिया जोगा करी ला दा ए। ये से महिमा नि ए जो तूँ चाए ई। इजी री खातर तां यहोवे रे दाणे आथो रे कटोरे ते पीणा। से तेसरे रोषो ते परेया दा ए। पी लो, ओर लोका तूँ नांगा देखणा। तेरी महिमा बेज्जतिया दे बदली जाणी।<verse eid="HAB 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HAB 2:17" />तुसे लबानोनो रे बण बाडी राखे; एबे तुसे बी बाडे जाणे। तुसे तेतेरे जानवर कायी राखे; एबे जानवरा तुसे डराणे। ये तिना अत्या रिया बजा ते ऊणा जो तुसे करी राखिया ओर जो तुसे दुनिया रे लोका ओर तिना शईरा रे खलाफ लड़ाई चगड़ा करी राखेया। <verse eid="HAB 2:17" /><verse number="18" style="v" sid="HAB 2:18" />कअड़ी रिया मूर्तिया रा क्या काम ए? ये सिर्फ एकी माणूंए रे जरीये बणाई दी चीज ए, ओर ये सिर्फ तुसा खे चूठ ई दशोई। इजी खे बनाणे खे इजी पाँदे परोसा करने ते क्या फाईदा ऊणा, एक एड़ा देवता जो बोली पनि सकदा! <verse eid="HAB 2:18" /><verse number="19" style="v" sid="HAB 2:19" />लाणत ए तेस पाँदे, जो लकड़िया रिया मूर्तिया खे बोलोआ, जाग या तेस पात्थरो ते जो बोली नि सकदा, उठ! क्या तेस सिखाणा? देखो, से सूईने चाँदिए साथे मढ़ी राखेया, पर तिदे प्राण नि ए।<note caller="+" style="f"><char style="fr" closed="false">2:19 </char><char style="ft" closed="false">1 कुरि. 12:2 </char></note> <verse eid="HAB 2:19" /><verse number="20" style="v" sid="HAB 2:20" />पर परमेशर आपणे पवित्र मन्दरो दे ए, सारी तरती तेस सामणे शान्त रओ।<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="s">हबक्कूको रा यहोवे ते प्रार्थना करना</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 3:1" />हबक्कूक नबीए री प्रार्थना। <verse eid="HAB 3:1" /><verse number="2" style="v" sid="HAB 3:2" />ओ परमेशर, आऊँ तेरे बारे दे ओर तेरे कामो रे बारे दे सुणी की डरीगा। ओ परमेशर, एस युगो दे आपणे काम पूरे कर, एस युगो देई तूँ तिना खे पूरा कर, पर जेबे तूँ जोशो दे परी जाए तेबे बी तूँ आसा पाँदे दया खे बताणा याद राख। <verse eid="HAB 3:2" /><verse number="3" style="v" sid="HAB 3:3" />परमेशर तेमानो ते आया, पवित्र परमेशरो खे पारान पाह्ड़ो ते आऊँदे ऊए देखूँआ। तेसरी महिमा रा तेज सर्गो दे परीगा दा ए, ओर तरती तेसरिया स्तुतिया ते परीगी री ए। <verse eid="HAB 3:3" /><verse number="4" style="v" sid="HAB 3:4" />तेसरी जोति सूरजो रे प्रयासे जेड़ी थी, तेसरे आथो ते जोतिया रिया किरणा निकल़ने लगी रिया ए ओर तेसरे आथो दे तेसरी तागत छिपी री ए। <verse eid="HAB 3:4" /><verse number="5" style="v" sid="HAB 3:5" />तेसते आगे-आगे मरी फैलदी गयी ओर बमारी तेसते पीछे-पीछे चली।<verse eid="HAB 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 3:6" />जेबे से खड़ा ऊआ, तो तरती ईल्ली गी। जेबे तिने देश देखे, सेयो डरो रे मारे कांबणे लगे। सेयो पाह्ड़ टूटी-टूटी की रूड़ने लगे ओर चूर-चूर ऊईगे। पुराणे, बऊत पुराणे पाह्ड़ बी टल़ी गे। पर से हमेशा आगे बढ़दा रओआ। <verse eid="HAB 3:6" /><verse number="7" style="v" sid="HAB 3:7" />माखे कूशान शईरो रे तम्बूए दे रणे वाल़े लोक दु:खो साथे दबे दे दिशे ओर मिधान देशो रे डेरे डगमगाई गे। <verse eid="HAB 3:7" /><verse number="8" style="v" sid="HAB 3:8" />ओ यहोवा, क्या तैं रोषो दे आई की नदिया पाँदे बाई ओर समुद्रो खे दूई इस्सेया दे बाँडीता? क्या तूँ तिना ते खुश नि था? ना, तूँ तो आपणे उद्धारो रे कोड़ेया रे रथ पेजणे लगी रा था, <verse eid="HAB 3:8" /><verse number="9" style="v" sid="HAB 3:9" />एड़ा जेड़े तैं आपणा धनुष खोलेया, आपणे तरकशो ते तीर निकाल़े ओर तिना खे चलाणे खे त्यार ऊईगा। सेला। फेर बिजल़िया ते तैं तरती चीरी ती ओर नदिया निकल़ने लगिया। <verse eid="HAB 3:9" /><verse number="10" style="v" sid="HAB 3:10" />पाह्ड़ ताखे देखी की काँबी गे, तूफान ओर जलप्रलय निकल़ी गे, गईरा समुद्र बोलणे लगेया ओर आपणियां लईरा ऊबे चकिया।<verse eid="HAB 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HAB 3:11" />तेरे उडणे वाल़े तीरो री चमका ते, तेरे चमकीले भाल़े री चमका रे प्रयासे ते सूरज कूमणा पुलीगा; ओर चाँद आपणी जगा दे ठईरी गा। <verse eid="HAB 3:11" /><verse number="12" style="v" sid="HAB 3:12" />तूँ रोषो दे आई की तरतिया पाँदे चलणे लगेया, तैं देशा खे सजा दित्ती। <verse eid="HAB 3:12" /><verse number="13" style="v" sid="HAB 3:13" />तूँ आपणे चूणे दे लोका खे बचाणे निकल़ेया, आपणे अभिषिक्ता खे बचाणे निकल़ेया। तैं दुष्टा रे सिर केसी ते ओर सिरो ते लई की पैरा तक तिना रिया आड्डिया तोड़ी तिया। <verse eid="HAB 3:13" /><verse number="14" style="v" sid="HAB 3:14" />तैं तिना रे शूरवीरा रे सिर तिना रे ई बड़छे साथे छेदी राखे, ओर तैं तिना री सेना नाश करिती। जेबे तिना रे सिपाई आसा पाँदे अमला करने खे आगे आए तो सेयो आसणे लगी रे थे। तिने सोचेया कि सेयो आसा ते सानिया ते जीती जाणे, मानो आसे गरीब, कमजोर लोक ए। <verse eid="HAB 3:14" /><verse number="15" style="v" sid="HAB 3:15" />तैं आपणे कोड़ेया पाँदे सवार ऊई की समुद्रो रे उफणदे पाणिये खे आपणे कोड़ेया रे पैरा ते केसी ता। <verse eid="HAB 3:15" /><verse number="16" style="v" sid="HAB 3:16" />ये सब सुणी की मेरा काल़जा काँबीगा ओर मेरे ओठ थरथराणे लगे, मेरे पैर लड़खड़ाणे लगे ओर आऊँ बऊत डरीगा। मां चुपचाप तेस दिनो रा इंतजार करना जेबे आसा पाँदे अमला करने वाल़ेया पाँदे मुसीबत आऊणी। <verse eid="HAB 3:16" /><verse number="17" style="v" sid="HAB 3:17" />दाऊगल़ेया रे डाल़ चाए दाऊगल़े नि लगो, अंगूरा रिया बेली दे चाए अंगूर नि लगो, डाल़ा दे चाए जैतून नि मिलो ओर चाए ये डोरू नज्ज पैदा नि करो, बाड़ेया दे चाए पेडा नि जाओ ओर गवाईणी दे गाय बल़द नि ओ, <verse eid="HAB 3:17" /><verse number="18" style="v" sid="HAB 3:18" />तेबे बी मां परमेशरो रिया बजा ते खुश ओर मगन रणा ओर आपणे उद्धारकर्ता परमेशरो रिया बजा ते बऊत खुश रणा। <verse eid="HAB 3:18" /><verse number="19" style="v" sid="HAB 3:19" />परमेशर यहोवा मेरी तागती रा मूल़ ए, से मेरे पैर ईरणो रे पैरा जेड़े बणाई देयोआ, से माखे मेरी ऊच्ची जगा पाँदे चलाओआ।<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>