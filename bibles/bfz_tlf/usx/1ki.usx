<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1KI" style="id" />
  <para style="h">1 राजा</para>
  <para style="toc1">राजेया रे बारे दे पईली कताब</para>
  <para style="toc2">1 राजा</para>
  <para style="toc3">1 राज.</para>
  <para style="mt">1 राजा</para>
  <para style="mt2">राजेया रे बारे दे पईली कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">सेमुएलो रिया कताबा दे इस्राएलो रे राज्य रे इतिआसो रे बारे दे जो शुरू ऊआ था, से राजेया रिया कताबा रे पईले इस्से दे बी जारी रओआ। एसा कताबा खे बी तीऊँ इस्सेया दे बांडी सकोए :</para>
  <para style="ili">(1) इस्राएल ओर यहूदा रे राजेया रे रूपो दे सुलैमानो रा राजा बणना ओर तेसरे बाओ दाऊदो रा मरना।</para>
  <para style="ili">(2) सुलैमानो रा राज ओर तेसरे महान काम। यरूशलेम शईरो दे मन्दरो रा बनाणा खास तरीके दे त्यान देणे जोगा ए।</para>
  <para style="ili">(3) देशो रा उत्तर ओर दक्खणा रे राज्य दे बाँडणा, ओर तिना राजेया रे बारे दे जानकारी जिने नौवी शताब्दी ई. पू. रे बीचो तक तिना पाँदे राज कित्तेया।</para>
  <para style="ip">राजेया रिया दूनी कताबा दे हर एक राजे खे परमेशरो रे प्रति परोसे जोगा ऊणे रिया नजरा ते परखेया गया ए, ओर देशो रिया सफलता खे एते परोसे पाँदे आधारित मानेया जाओआ। दूजे कनारे मूर्तिपूजा ओर आज्ञा खे ना मानणा एक घोर संकटो री बजा ठईरोआ। उत्तरो रिया तरफा रा कोई बी राजा परोसे जोगा नि ऊआ जबकि यहूदा रे राजेया दे दुँईं तरआ रे राजेया रे बारे दे लिखेया दा मिलोआ।</para>
  <para style="ip">राजेया रिया कताबा रे पईले इस्से दे परमेशरो रे भविष्यबक्तेया री खास जगा ए। ये भविष्यबक्ते परमेशरो रे इम्मती साथे बोलणे वाल़े थे, जिने लोका खे मूर्तिपूजा करने ओर परमेशरो री आज्ञा ना मानणे रे खलाफ चतौणी दित्ती थी।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">दाऊदो रे राज्य रा खत्म ऊणा <char style="ior"><ref loc="1KI 1:1-2:12">1:1-2:12</ref></char></para>
  <para style="io1">सुलैमानो रा राजा बणना <char style="ior"><ref loc="1KI 2:13-46">2:13-46</ref></char></para>
  <para style="io1">सुलैमानो रा राज्य <char style="ior"><ref loc="1KI 3:1-11:43">3:1-11:43</ref></char></para>
  <para style="io1">राज्य रा दो फाड़ ऊणा <char style="ior"><ref loc="1KI 12:1-22:53">12:1-22:53</ref></char></para>
  <chapter number="1" style="c" sid="1KI 1" />
  <para style="s">राजा दाऊद आपणिया स्याणदिया अवस्था दे</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 1:1" />एस बखते दाऊद राजा स्याणा ओर तेसरी उम्र बऊत ऊईगी थी; तेसखे गर्म टाल्ले टखाये जाओ थे पर तेबे बी से गर्म नि ओ था। <verse eid="1KI 1:1" /><verse number="2" style="v" sid="1KI 1:2" />तेबे तेसरे कर्मचारिये तेसखे बोलेया, “म्हारे प्रभु राजे खे कोई जवान कुआँरी छोट्टी टोल़ी जाओ, जो राजे सामणे रई की तेसरी सेवा करेया करो ओर तांगे लेटेया करो ताकि म्हारे प्रभु राजे खे गर्मी पऊँचो।” <verse eid="1KI 1:2" /><verse number="3" style="v" sid="1KI 1:3" />तेबे तिना खे सारे इस्राएल देशो दे सुन्दर कुआँरी टोल़दे-टोल़दे अबीशग नाओं री एक शूनेमिन छोट्टी मिली ओर सेयो तेसा खे राजे गे ली आए। <verse eid="1KI 1:3" /><verse number="4" style="v" sid="1KI 1:4" />से छोट्टी सच्चो खे ई बऊत ई बांकी थी; ओर से राजे री दासी बणी की तेसरी सेवा करदी रई; पर राजे रा तेसा साथे कोई बी शारीरिक रिश्ता नि ऊआ।<verse eid="1KI 1:4" /></para>
  <para style="s">अदोनिय्याह रा राजद्रोह</para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 1:5" />तेबे राजा दाऊदो री लाड़ी हग्गीता रा पाऊ अदोनिय्याह<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">अदोनिय्याह </char><char style="ft" closed="false">ये दाऊदो रा चौथा पाऊ था ओर तेसरा जन्म तेबे ऊआ था जेबे दाऊद हेब्रोनो ते राज करो था। तेसरे तीन बड़े पाईया रे मरने ते बाद एबे सेई सबी ते बड़ा था। </char></note> आगे आई की बोलणे लगेया, “मां नवां राजा बणना।” तेबे तिने रथ ओर सवार ओर आपू ते आगे-आगे दौड़ने खे पंजा आदमी राखी ते। <verse eid="1KI 1:5" /><verse number="6" style="v" sid="1KI 1:6" />ये इजी बजा ते ऊआ कि तेसरे बाओए जन्मो ते लई की तेसखे कदी बी ये बोली की उदास नि कित्तेया था, “तैं एड़ा कऊँ कित्तेया।” से बऊत बांका था ओर अबशालोमो ते बाद से जम्मेया था। <verse eid="1KI 1:6" /><verse number="7" style="v" sid="1KI 1:7" />अदोनिय्याहे सरूयाह रे पाऊ योआबो ते ओर एब्यातार पुरोईतो साथे गल्ल बात कित्ती ओर तिने तेस पीछे ऊई की तेसरी मताद कित्ती। <verse eid="1KI 1:7" /><verse number="8" style="v" sid="1KI 1:8" />पर सादोक पुरोईत यहोयादा रा पाऊ बनायाह, नातान नबी, शिमी, रेई ओर दाऊदो रे शूरवीरे अदोनिय्याह रा साथ नि दित्तेया। <verse eid="1KI 1:8" /><verse number="9" style="v" sid="1KI 1:9" />तेबे अदोनिय्याहे जोहेलेत नाओं रे पात्थरो गे जो एनरोगेलो रे नेड़े ए, पेड बल़द ओर त्यार कित्ते रे डांगर बलि कित्ते ओर आपणे पाई सारे राजकुमार ओर राजे रे सारे यहूदी कर्मचारी बुलाई ले। <verse eid="1KI 1:9" /><verse number="10" style="v" sid="1KI 1:10" />पर तिने नातान नबी, बनायाह, राजे रे शूरवीर ओर आपणा पाई सुलैमान नि बुलाया। <verse eid="1KI 1:10" /><verse number="11" style="v" sid="1KI 1:11" />नाताने जेबे ये सुणेया तेबे तिने सुलैमानो री माये बतशेबा खे बोलेया, “क्या तैं सुणी राखेया कि हग्गीता रा पाऊ अदोनिय्याह राजा बणी की बैठी रा ओर म्हारा प्रभु दाऊद इजी रे बारे दे नि जाणदा?” <verse eid="1KI 1:11" /><verse number="12" style="v" sid="1KI 1:12" />इजी री खातर एबे आओ, आऊँ ताखे एड़ी सला देऊँआ, जेते कि तूँ आपणे ओर आपणे पाऊ सुलैमानो रे प्राण बचाई सकोई। <verse eid="1KI 1:12" /><verse number="13" style="v" sid="1KI 1:13" />तूँ दाऊद राजे गे जाई की तेसते ईंयाँ पूछ, “ओ मेरे प्रभु! ओ राजा! तैं कसम खाई की आपणी दासिया खे ये बोलेया था कि तेरा पाऊ सुलैमान मांते बाद राजा ऊणा ओर से मेरी राजगद्दिया पाँदे बैठणा। तेबे अदोनिय्याह राजा बणी की कऊँ बैठी रा?” <verse eid="1KI 1:13" /><verse number="14" style="v" sid="1KI 1:14" />ओर जेबे तां तेती राजे साथे एड़िया गल्ला बताणिया, तेबे मां पीछा ते आई की जो कुछ ऊई रा तेतेरे बारे दे राजे खे बताणा। इजी ते ये गल्ल पक्की ऊई जाणी की जो कुछ तैं बोलेया से सब सच ए।<verse eid="1KI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 1:15" />तेबे बतशेबा राजे गे कमरे दे गई; राजा तो बऊत स्याणा था ओर तेसरी सेवा-टईल शूनेमिन अबीशग करो थी। <verse eid="1KI 1:15" /><verse number="16" style="v" sid="1KI 1:16" />तेबे बतशेबे चूकी की राजे गे माथा टेकेया ओर राजे पूछेया, “तूँ क्या चाए ई?” <verse eid="1KI 1:16" /><verse number="17" style="v" sid="1KI 1:17" />तेसे ज्वाब दित्तेया, “ओ मेरे प्रभु तैं तो आपणे परमेशर यहोवे री कसम खाई की आपणी दासिया खे बोलेया था, तेरा पाऊ सुलैमान मांते बाद राजा ऊणा ओर से मेरी राजगद्दिया पाँदे बैठणा। <verse eid="1KI 1:17" /><verse number="18" style="v" sid="1KI 1:18" />एबे देख अदोनिय्याह राजा बणी की बैठी रा, पर यबुओ तक मेरा प्रभु राजा इजी रे बारे दे नि जाणदा। <verse eid="1KI 1:18" /><verse number="19" style="v" sid="1KI 1:19" />तिने बऊत सारे बल़द त्यार कित्ते, डांगर ओर पेडा बलि कित्ते ओर सारे राजकुमारा खे ओर एब्यातार पुरोईत ओर योआब सेनापति बुलाया, पर तेरा दास सुलैमान नि बुलाया। <verse eid="1KI 1:19" /><verse number="20" style="v" sid="1KI 1:20" />ओ मेरे प्रभु! ओ राजा! सारे इस्राएली ताखे ताकणे लगी रे कि तूँ तिना खे बोले कि म्हारे प्रभु राजे री गद्दिया पाँदे तांते बाद कुण बैठणा। <verse eid="1KI 1:20" /><verse number="21" style="v" sid="1KI 1:21" />नई तो जिंयाँ ई म्हारा प्रभु राजा आपणे पीतरा साथे मिली जाणा, तिंयाँ ई तिना मां साथे ओर मेरे पाऊ सुलैमानो साथे अपराधिया जेड़ा बर्ताओ करना।” <verse eid="1KI 1:21" /><verse number="22" style="v" sid="1KI 1:22" />ईंयाँ बतशेबा राजे साथे गल्ला करने ई लगी री थी कि नातान नबी बी आईगा। <verse eid="1KI 1:22" /><verse number="23" style="v" sid="1KI 1:23" />तेबे राजे खे बोलेया, “नातान नबी आजीर ए” तेबे से राजे सामणे आया ओर मुंए रे पारे पड़ी की राजे गे माथा टेकेया। <verse eid="1KI 1:23" /><verse number="24" style="v" sid="1KI 1:24" />तेबे नातान बोलणे लगेया, “ओ मेरे प्रभु, ओ राजा! क्या तैं बोली राखेया कि अदोनिय्याह मांते बाद राजा ऊणा ओर से मेरी गद्दिया पाँदे बैठणा?” <verse eid="1KI 1:24" /><verse number="25" style="v" sid="1KI 1:25" />देख, तिने आज ऊँदे जाई की बऊत सारे बल़द, त्यार कित्ते रे डांगर ओर पेडा बलि करी राखिया ओर सारे राजकुमार, सेनापति ओर एब्यातार पुरोईत बी बुलाई ला रा ओर सेयो तेस सामणे खांदे-पींदे ऊए बोलणे लगी रे, अदोनिय्याह राजा जिऊँदा रओ। <verse eid="1KI 1:25" /><verse number="26" style="v" sid="1KI 1:26" />पर तिने आऊँ तेरा दास, ओर सादोक पुरोईत ओर यहोयादा रा पाऊ बनायाह ओर तेरा पाऊ सुलैमान पनि बुलाया। <verse eid="1KI 1:26" /><verse number="27" style="v" sid="1KI 1:27" />क्या ये मेरे प्रभु राजे रिया तरफा ते ऊआ? तैं तो आपणे दासो गे ये नि बताया था कि प्रभु राजे री गद्दिया पाँदे तेसते बाद कुण बैठणा।<verse eid="1KI 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 1:28" />दाऊद राजे बोलेया, “बतशेबा खे मांगे बुलाई की ल्याओ।” तेबे से राजे गे आई की तेस सामणे खड़ी ऊई। <verse eid="1KI 1:28" /><verse number="29" style="v" sid="1KI 1:29" />राजे कसम खाई की बोलेया, “यहोवा जो मेरे प्राण सारे जोखिमा ते बचांदा आई रा, <verse eid="1KI 1:29" /><verse number="30" style="v" sid="1KI 1:30" />तेसरी जिन्दगिया री कसम, जेड़ा मैं ताखे इस्राएलो रे परमेशर यहोवे री कसम खाई की बोलेया था, कि तेरा पाऊ सुलैमान मांते बाद राजा ऊणा ओर से मांते बाद मेरी गद्दिया पाँदे बैठणा, तेड़ा ई पक्का आजके दिने मां करना।”<verse eid="1KI 1:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 1:31" />तेबे बतशेबे जमीना दे पड़ी की राजे गे माथा टेकी की बोलेया, “मेरा प्रभु राजा दाऊद सदा तक जिऊँदा रओ!” <verse eid="1KI 1:31" /><verse number="32" style="v" sid="1KI 1:32" />तेबे दाऊद राजे बोलेया, “मांगे सादोक पुरोईत, नातान नबी ओर यहोयादा रे पाऊ बनायाहो खे बुलाई की ल्याओ।” तेबे सेयो राजे सामणे आए। <verse eid="1KI 1:32" /><verse number="33" style="v" sid="1KI 1:33" />राजे तिना खे बोलेया, “आपणे प्रभुए रे कर्मचारिया खे साथे लई की मेरे पाऊ सुलैमानो खे मेरी खच्चरा पाँदे चढ़ाओ ओर गीहोनो खे लई जाओ; <verse eid="1KI 1:33" /><verse number="34" style="v" sid="1KI 1:34" />ओर तेती सादोक पुरोईत ओर नातान नबी इस्राएलो रा राजा ऊणे खे तेसरा अभिषेक करो; तेबे तुसे नरसिंगा बजाणा ओर बोलणा, ‘राजा सुलैमान जिऊँदा रओ।’ <verse eid="1KI 1:34" /><verse number="35" style="v" sid="1KI 1:35" />ओर तुसे तेस पीछे-पीछे एती आऊणा ओर से आई की मेरे सिंहासनो पाँदे बैठो, कऊँकि मेरे बदले से ई राजा ऊणा ओर मैं सेई इस्राएल ओर यहूदा रा परदान ऊणे खे ठराई राखेया।” <verse eid="1KI 1:35" /><verse number="36" style="v" sid="1KI 1:36" />तेबे यहोयादा रे पाऊ बनायाहे बोलेया, “आमीन्! मेरे प्रभु राजे रा यहोवा परमेशर बी एड़ा ई बोलो। <verse eid="1KI 1:36" /><verse number="37" style="v" sid="1KI 1:37" />जिया यहोवा मेरे प्रभु राजे साथे रया, तिंयाँ से सुलैमानो साथे बी रओ ओर तेसरा राज्य मेरे प्रभु दाऊद राजे ते बी जादा बढ़ाओ।”<verse eid="1KI 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 1:38" />तेबे सादोक पुरोईत ओर नातान नबी ओर यहोयादो रा पाऊ बनायाह करेती ओर पलेतिया खे साथे लई की ऊँदे गये ओर सुलैमानो खे राजा दाऊदो री खच्चरा पाँदे चढ़ाई की गीहोनो खे लई चले। <verse eid="1KI 1:38" /><verse number="39" style="v" sid="1KI 1:39" />तेबे सादोक पुरोईते यहोवे रे तम्बूए ते तेल परेया रा सींग काडेया ओर सुलैमानो रा राज्याभिषेक कित्तेया। ओर सेयो रड़सिंगे बजाणे लगे; ओर सारे लोक बोलणे लगे, “राजा सुलैमान जिऊँदा रओ।” <verse eid="1KI 1:39" /><verse number="40" style="v" sid="1KI 1:40" />तेबे सारे लोक तेस पीछे बंसरी बजांदे ऊए इतणे मजे करदे ऊए ऊबे गये कि तिना री आवाजा साथे तरती ईलणे लगी। <verse eid="1KI 1:40" /><verse number="41" style="v" sid="1KI 1:41" />जेबे अदोनिय्याह ओर तेसरे सारे निऊँदे वाल़े लोक खाई चुके थे, तेबे तिना खे ये आवाज सुणी ओर योआबे रड़सिंगे री आवाज सुणी की पूछेया, “शईरो दे अलचल ओर चींगणे री आवाज कऊँ ऊणे लगी री?” <verse eid="1KI 1:41" /><verse number="42" style="v" sid="1KI 1:42" />से ईंयाँ बोलणे ई लगी रा था कि एब्यातार पुरोईतो रा पाऊ योनातान आया ओर अदोनिय्याहे तेसखे बोलेया, “पीतरे आओ; तूँ तो खरा माणूं ए ओर खरा सन्देश बी ल्याया ऊणा।” <verse eid="1KI 1:42" /><verse number="43" style="v" sid="1KI 1:43" />योनाताने अदोनिय्याहो खे बोलेया, “सच्ची म्हारे प्रभु राजा दाऊदे सुलैमान राजा बणाईता। <verse eid="1KI 1:43" /><verse number="44" style="v" sid="1KI 1:44" />ओर राजे सादोक पुरोईत, नातान नबी ओर यहोयादा रा पाऊ बनायाह ओर करेती ओर पलेती तेस साथे पेजी ते ओर तिने से राजे री खच्चरा पाँदे चढ़ाई राखेया। <verse eid="1KI 1:44" /><verse number="45" style="v" sid="1KI 1:45" />ओर सादोक पुरोईते ओर नातान नबीए गीहोनो दे राजा ऊणे खे तेसरा अभिषेक कित्तेया; ओर सेयो तेथा ते एड़े मजे करदे ऊए ऊबो खे गये कि शईरो रे अलचल मची गी ओर जो आवाज तुसा खे सुणने लगी री ये सेईए।” <verse eid="1KI 1:45" /><verse number="46" style="v" sid="1KI 1:46" />सुलैमान गद्दिया पाँदे बैठणे बी लगी रा। <verse eid="1KI 1:46" /><verse number="47" style="v" sid="1KI 1:47" />तेबे राजे रे कर्मचारी म्हारे प्रभु दाऊद राजे खे ये बोली की तन्य बोलणे आए, तेरा परमेशर, सुलैमानो रा नाओं, तेरे नाओं ते बी महान करो ओर तेसरा राज्य तेरे राज्य ते बी जादा बढ़ाओ; ओर राजे आपणे माँजे पाँदे माथा टेकेया ओर यहोवे री आराधना कित्ती। <verse eid="1KI 1:47" /><verse number="48" style="v" sid="1KI 1:48" />फेर राजे ये बी बोलेया, “इस्राएलो रा यहोवा परमेशर तन्य ए, जिने आज मां सामणे मेरिया ल्वादा बीचा ते मेरी गद्दिया पाँदे एक जणा बठयाल़ेया।”<verse eid="1KI 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="1KI 1:49" />तेबे जितणे निऊँदे वाल़े अदोनिय्याह साथे थे सेयो सारे थरथराईगे ओर उठी की आपणी-आपणी बाटा रे गये। <verse eid="1KI 1:49" /><verse number="50" style="v" sid="1KI 1:50" />ओर अदोनिय्याह सुलैमानो ते डरीगा ओर जाई की बेदिया रे सींग पकड़ी ले। <verse eid="1KI 1:50" /><verse number="51" style="v" sid="1KI 1:51" />तेबे सुलैमानो खे ये सन्देश मिलेया, “अदोनिय्याह सुलैमानो ते एड़ा डरीगा दा ए कि तिने बेदिया रे सींग ये बोली की पकड़ी ते रे कि आज राजा सुलैमान कसम खाओ कि आपणा दास तलवारी साथे नि काणा।” <verse eid="1KI 1:51" /><verse number="52" style="v" sid="1KI 1:52" />सुलैमाने बोलेया, “अगर से खरायी दखाओ तो तेसरा एक बी बाल़ जमीना दे नि पड़ना, पर जे तेसरे जिऊए दे बईमानी ओ, तो से काया जाणा।” <verse eid="1KI 1:52" /><verse number="53" style="v" sid="1KI 1:53" />तेबे राजा सुलैमाने लोक पेजी ते जो तेसखे बेदिया ते उतारी की ली आए तेबे तिने आई की राजा सुलैमानो गे माथा टेकेया ओर सुलैमाने तेसखे बोलेया, “आपणे कअरे चली जा।”<verse eid="1KI 1:53" /></para>
  <chapter eid="1KI 1" />
  <chapter number="2" style="c" sid="1KI 2" />
  <para style="s">दाऊदो री मौत ओर सुलैमानो रे राज्य री शुरूआत</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 2:1" />दाऊद जाणो था कि तेसरे मरने रा बखत नेड़े आई गा रा ए, तेबे तिने आपणे पाऊ सुलैमानो खे सारी जिम्मेबारी देंदे ऊए बोलेया, <verse eid="1KI 2:1" /><verse number="2" style="v" sid="1KI 2:2" />“आऊँ दुनिया छाडी की जाणे वाल़ा ए जेती सबी खे एक दिन जाणा पड़ोआ, इजी री खातर तूँ याओ बानी की काम कर। <verse eid="1KI 2:2" /><verse number="3" style="v" sid="1KI 2:3" />ओर जो कुछ तेरे यहोवा परमेशरे तांगे सम्बाल़ी राखेया, तेतेरी रक्षा करी की तेसरी बाटा दे चलेया करना ओर जेड़ा मूसे रे बिधानो दे लिखी राखेया, तेड़ा ई तेसरी बिधि, आज्ञा, नियम ओर आज्ञा रा समजदारिया ते पालण करदे रणा; जेते कि जो कुछ तूँ करे ओर जेती केथी तूँ जाए, तिदे तूँ सफल ओए; <verse eid="1KI 2:3" /><verse number="4" style="v" sid="1KI 2:4" />ओर यहोवा आपणा से वादा पूरा करो जो तिने मेरे बारे दे बोलेया था, जे तेरी ल्वाद आपणी चाला रे बारे दे एड़ी सावधान रओ कि आपणे सारे मन ओर आपणे सारे प्राणो ते सच्चाईया साथे हमेशा मां सामणे चलदे रओ तेबे तो इस्राएलो री राजगद्दिया पाँदे बैठणे वाल़े री, तेरे कुल परिवारो दे कमी कदी नि ऊणी। <verse eid="1KI 2:4" /><verse number="5" style="v" sid="1KI 2:5" />तेबे तूँ आपू जाणेया कि सरूयाह रे पाऊ योआबे मां साथे क्या-क्या कित्तेया! मतलब तिने नेरो रे पाऊ अब्नेर ओर येतेरो रे पाऊ अमासा, इस्राएलो रे इना दुँईं सेनापतिया साथे क्या-क्या कित्तेया। तिने यो दोनो काये ओर मेलो रे बखते युद्धो रा खून बाह्यी की तिजी साथे आपणे लको रा कमरबंद ओर आपणे पैरा रे जोड़े सेड़ी ते। <verse eid="1KI 2:5" /><verse number="6" style="v" sid="1KI 2:6" />इजी री खातर तूँ आपणी बुद्धिया साथे काम लया ओर से सफेद बाल़ा वाल़ा अधलोको दे शान्तिया साथे उतरने नि देणा। <verse eid="1KI 2:6" /><verse number="7" style="v" sid="1KI 2:7" />फेर गिलाद इलाके रे बर्जिल्लै रे पाऊआ पाँदे दया राखणी ओर सेयो तेरी मेजा पाँदे खाणे वाल़े रओ, कऊँकि जेबे आऊँ तेरे पाई अबशालोमो रे सामणे ते नठी गा था, तेबे तिने मांगे आई की तेड़ा ई कित्तेया था। <verse eid="1KI 2:7" /><verse number="8" style="v" sid="1KI 2:8" />तेबे सुण, तांगे बिन्यामीनी गेरो रा पाऊ बहूरीम शईरो रा शिमी रओआ, जेस दिने आऊँ महनैम शईरो खे गया था तेस दिने तिने माखे कड़काईया साथे स्राप दित्तेया था, पर जेबे से माखे मिलणे यरदन नदिया गे आया, तेबे मैं तेस साथे यहोवे री ये कसम खाई कि मां तूँ तलवारी साथे नि काणा। <verse eid="1KI 2:8" /><verse number="9" style="v" sid="1KI 2:9" />पर एबे तैं से निर्दोष नि ठईराणा, तूँ तो अक्लमंद मर्द ए; ताखे पता ऊणा कि तेस साथे क्या करना चाईयो ओर तेस सफेद बाल़ो वाल़े रा खून बाह्यी की से अधलोको दे उतारी देणा।” <verse eid="1KI 2:9" /><verse number="10" style="v" sid="1KI 2:10" />तेबे दाऊद मरीगा ओर तेसखे दाऊदो रे शईरो दे माट्टी दित्ती। <verse eid="1KI 2:10" /><verse number="11" style="v" sid="1KI 2:11" />दाऊदे इस्राएलो दे चाल़िया साला तक राज कित्तेया, सात साल तो तिने हेब्रोनो दे ओर तेत्ती साल यरूशलेम शईरो दे राज कित्तेया था।<verse eid="1KI 2:11" /></para>
  <para style="s">सुलैमानो रा राज्य</para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 2:12" />तेबे सुलैमान आपणे बाओ दाऊदो री गद्दिया पाँदे बैठेया ओर तेसरा राज्य बऊत मजबूत ऊआ।<verse eid="1KI 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 2:13" />एक दिन हग्गीतो रा पाऊ अदोनिय्याह, सुलैमानो री माये बतशेबा रे नेड़े आया, बतशेबे पूछेया, “क्या तूँ मेल-जोल करने रे नाते आई रा?” <verse eid="1KI 2:13" /><verse number="14" style="v" sid="1KI 2:14" />तिने ज्वाब दित्तेया, “आ, दोस्तिया रे नाते ते आई रा!” तेबे से बोलणे लगेया, “मां ताखे एक गल्ल बोलणी।” तेसे बोलेया, “बोल!” <verse eid="1KI 2:14" /><verse number="15" style="v" sid="1KI 2:15" />तिने बोलेया, “ताखे तो पता ए कि राज्य मेरा ऊईगा था ओर सारे इस्राएली मां कनारो खे ऊईगे थे कि आऊँ राज करुँ; पर एबे राज्य बदली की मेरे पाईए रा ऊईगा रा, कऊँकि से तेसखे यहोवे रिया तरफा ते मिली रा। <verse eid="1KI 2:15" /><verse number="16" style="v" sid="1KI 2:16" />इजी री खातर आऊँ एबे तांते एक चीज माँगुआ, माखे ना नि करनी।” तेसे बोलेया, “बोलदा रओ।” <verse eid="1KI 2:16" /><verse number="17" style="v" sid="1KI 2:17" />तिने बोलेया, “सुलैमान राजे ताखे ना नि करनी; इजी खातर तेसखे बोल कि से मां साथे शूनेमिन शईरो री अबीशगो रा ब्या करवाई देयो।” <verse eid="1KI 2:17" /><verse number="18" style="v" sid="1KI 2:18" />बतशेबे बोलेया, “अच्छा, आऊँ तेरिया तँईं राजे गे बोलूँगी।” <verse eid="1KI 2:18" /><verse number="19" style="v" sid="1KI 2:19" />तेबे बतशेबा अदोनिय्याह रिया खातर राजा सुलैमानो साथे गल्ल बात करने खे गई ओर राजा तेसा साथे मिलणे खे उठेया ओर तेसा गे माथा टेकी की आपणे सिंहासनो पाँदे बैठी गा, तेबे राजे आपणी माया खे एक सिंहासन राखी ता ओर से तेसरी दाँणी तरफा खे बैठी गी। <verse eid="1KI 2:19" /><verse number="20" style="v" sid="1KI 2:20" />तेबे से बोलणे लगी, “आऊँ तांते एक छोटा जा वरदान मांगू ई इजी री खातर माखे ना नि करनी” राजे बोलेया, “ओ आम्मा, माँग; मां ताखे ना नि करनी।” <verse eid="1KI 2:20" /><verse number="21" style="v" sid="1KI 2:21" />तेसे बोलेया, “तेसा शूनेमिन अबीशगा रा ब्या तेरे पाई अदोनिय्याह साथे कराई दे।” <verse eid="1KI 2:21" /><verse number="22" style="v" sid="1KI 2:22" />सुलैमान राजे आपणी माया खे ज्वाब दित्तेया, “तूँ अदोनिय्याह खे शूनेमिन अबीशगा खे ई कऊँ माँगणे लगी री? तेसरिया तँईं राज्य बी माँग, कऊँकि से तो मेरा बड़ा पाई ए ओर तेसखे ई क्या! एब्यातार पुरोईत ओर सरूयाह रे पाऊ योआबो खे बी माँग।” <verse eid="1KI 2:22" /><verse number="23" style="v" sid="1KI 2:23" />ओर सुलैमान राजे यहोवे री कसम खाई की बोलेया, “जे अदोनिय्याहे ये गल्ल आपणे प्राणो पाँदे खेली की नि बोली ओ तो परमेशर मां साथे तेड़ा ई बल्कि तिजी ते बी जादा करो। <verse eid="1KI 2:23" /><verse number="24" style="v" sid="1KI 2:24" />एबे यहोवे जिने आऊँ स्थिर करी राखेया ओर मेरे बाओ दाऊदो री राजगद्दिया पाँदे बठयाल़ी राखेया ओर आपणे वादे रे मुताबिक मेरा कअर बसाई राखेया, तेसरी जिन्दगिया री कसम अदोनिय्याह आज ई काया जाणा।” <verse eid="1KI 2:24" /><verse number="25" style="v" sid="1KI 2:25" />तेबे सुलैमान राजे यहोयादा रा पाऊ बनायाह पेजीता ओर तिने से जाई की एड़ा काया कि से मरी गा।<verse eid="1KI 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 2:26" />तेबे एब्यातार पुरोईतो खे सुलैमान राजे बोलेया, “अनातोत शईरो दे आपणी जमीना खे जा, कऊँकि तूँ बी मौता री सजा जोगा ए, आजके दिने मां तूँ नि काणा, कऊँकि तूँ मेरे बाओ दाऊदो रे सामणे प्रभु यहोवे रा सन्दूक चकेया करो था; ओर तिना सारे दु:खो रे जो मेरे बाओ पाँदे पड़े थे, तूँ बी दु:खी था।” <verse eid="1KI 2:26" /><verse number="27" style="v" sid="1KI 2:27" />तेबे सुलैमान राजे एब्यातारो खे यहोवे रे पुरोईत ऊणे रे पदो ते टाईता इजी खे जो वचन यहोवे एलीए रे कुलो रे बारे दे शीलो दे बोलेया था, से पूरा ऊईगा।<verse eid="1KI 2:27" /></para>
  <para style="s">योआबो खे काणा</para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 2:28" />इजी रे बारे दे जेबे योआबो खे पता लगेया; योआब अबशालोमो पीछे तो नि गया था, पर अदोनिय्याह पीछे ऊईगा था। तेबे योआब यहोवे रे तम्बूए खे नठी गा ओर बेदिया रे सींग पकड़ी ते। <verse eid="1KI 2:28" /><verse number="29" style="v" sid="1KI 2:29" />जेबे सुलैमान राजे खे ये सन्देश मिलेया, “योआब यहोवे रे तम्बूए खे नठी गा रा ओर से बेदिया गे ए, तेबे सुलैमाने यहोयादो रे पाऊ बनायाहो खे ये बोली की पेजीता कि तूँ जाई की तेसखे कायी दे।” <verse eid="1KI 2:29" /><verse number="30" style="v" sid="1KI 2:30" />तेबे बनायाहे यहोवे रे तम्बूए गे जाई की तेसखे बोलेया, “राजे री ये आज्ञा ए कि निकल़ी की आओ।” तिने बोलेया, “ना, मां एथी मरी जाणा।” तेबे बनायाहे वापस ऊई की ये सन्देश राजे खे दित्तेया, “योआबे माखे एड़ा बोलेया।” <verse eid="1KI 2:30" /><verse number="31" style="v" sid="1KI 2:31" />राजे तेसखे बोलेया, “तेसरे कईणे रे मुताबिक तेसखे कायी दे ओर तेसखे माट्टी दे; एड़ा करी की निर्दोषो रा जो खून योआबे करी राखेया, तिजी रा दोष तां मां पाँदा ते ओर मेरे बाओ रे कराने पाँदा ते दूर करना। <verse eid="1KI 2:31" /><verse number="32" style="v" sid="1KI 2:32" />ओर यहोवे तेसरे सिरो पाँदे से खून वापस करी देणा, कऊँकि तिने मेरे बाओ दाऊदो ते बिना पूछे आपू ते जादा तर्मी ओर पले दो मर्दा पाँदे, मतलब इस्राएलो रा परदान सेनापति अब्नेर ओर यहूदा रा परदान सेनापति येतेरो रे पाऊ अमासा तलवारी साथे कायी ते थे। <verse eid="1KI 2:32" /><verse number="33" style="v" sid="1KI 2:33" />ईंयाँ योआबो रे सिरो पाँदे ओर तेसरी ल्वादा रे सिरो पाँदे खून सदा तक रणा, पर दाऊद ओर तेसरे कुल ओर तेसरे कराने ओर तेसरे सिंहासनो पाँदे यहोवे रिया तरफा ते शान्ति सदा तक रणी।” <verse eid="1KI 2:33" /><verse number="34" style="v" sid="1KI 2:34" />तेबे यहोयादा रे पाऊ बनायाहे जाई की योआब कायी ता ओर तेसखे उजाड़ जगा दे तेसरे ई कअरे माट्टी दित्ती।<verse eid="1KI 2:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1KI 2:35" />तेबे राजे तेसरी जगा पाँदे यहोयादा रा पाऊ बनायाह परदान सेनापति ठराया ओर एब्यातारो री जगा पाँदे सादोक पुरोईत ठराया। <verse eid="1KI 2:35" /><verse number="36" style="v" sid="1KI 2:36" />तेबे राजे शिमिये खे सन्देशा पेजेया ओर तेसखे बोलेया, “तैं यरूशलेम शईरो रे आपणा कअर बणाई की तेथी रणा ओर शईरो ते बारे केथी नि जाणा। <verse eid="1KI 2:36" /><verse number="37" style="v" sid="1KI 2:37" />तूँ पक्का जाणी लो कि जेस दिने तूँ निकल़ी की किद्रोन नाल़े ते पार उतरेया, तेस दिने तूँ पक्का काया जाणा ओर तेरा खून तेरे ई सिरो पाँदे पड़ना।” <verse eid="1KI 2:37" /><verse number="38" style="v" sid="1KI 2:38" />शिमिये राजे खे बोलेया, “गल्ल ठीक ए; जेड़ा मेरे प्रभु राजे बोली राखेया, तेड़ा ई तेरे दासो करना।” तेबे शिमी बऊत दिना तक यरूशलेम शईरो दे रया।<verse eid="1KI 2:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1KI 2:39" />तीन साल बीतणे ते बाद शिमिये रे दो दास, गत शईरो रे राजा माका रे पाऊ आकीशो गे नठीगे ओर शिमिये खे ये सन्देश मिलेया, “तेरे दास गत शईरो दे ए।” <verse eid="1KI 2:39" /><verse number="40" style="v" sid="1KI 2:40" />तेबे शिमी उठी की आपणे गह्दे पाँदे काठी गूड़ी की, आपणे दासा खे टोल़ने खे गतो रे आकीशो गे गया ओर आपणे दासा खे गतो ते ली आया। <verse eid="1KI 2:40" /><verse number="41" style="v" sid="1KI 2:41" />जेबे सुलैमान राजे खे ऐतेरा सन्देश मिलेया, “शिमी यरूशलेम शईरो ते गतो खे गया ओर फेर वापस आई गा रा,” <verse eid="1KI 2:41" /><verse number="42" style="v" sid="1KI 2:42" />तेबे राजे शिमिये खे सन्देशा पेजेया, ओर तेसखे बोलेया, “क्या मैं ताखे यहोवे री कसम नि खुल़ाई थी? ओर ताखे चिताई की नि बोलेया था कि तूँ पक्का जाणी लो कि जेस दिने तूँ निकल़ी की केथी चली जाए, तेस दिने पक्का काया जाणा?” ओर क्या तैं माखे नि बोलेया था, “जो गल्ल मैं सुणी से ठीक ए?” <verse eid="1KI 2:42" /><verse number="43" style="v" sid="1KI 2:43" />तेबे तैं यहोवे री कसम ओर मेरी पक्की आज्ञा कऊँ नि मानी? <verse eid="1KI 2:43" /><verse number="44" style="v" sid="1KI 2:44" />तेबे राजे शिमिये खे बोलेया, “तूँ आपू ई आपणे मनो रे से सारी दुष्टता जाणेया, जो तैं मेरे बाओ दाऊदो साथे कित्ती थी? इजी री खातर यहोवे तेसरे सिरो पाँदे तेरी दुष्टता वापस करी देणी। <verse eid="1KI 2:44" /><verse number="45" style="v" sid="1KI 2:45" />पर सुलैमान राजा तन्य रणा ओर दाऊदो रा सिंहासन यहोवे रे सामणे सदा बेकसूर रणा।” <verse eid="1KI 2:45" /><verse number="46" style="v" sid="1KI 2:46" />तेबे राजे यहोयादा रे पाऊ बनायाहो खे आज्ञा दित्ती ओर तिने बारे जाई कि से एड़ा मारेया कि से मरीगा ओर इजी बजअ ते सुलैमानो रे आथो दे राज्य मजबूत ऊईगा।<verse eid="1KI 2:46" /></para>
  <chapter eid="1KI 2" />
  <chapter number="3" style="c" sid="1KI 3" />
  <para style="s">बुद्धिया रिया तँईं सुलैमानो री प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 3:1" />सुलैमान राजे मिस्रो रे राजा फिरौनो साथे दोस्ती कित्ती ओर तेसरिया बेटिया साथे ब्या करी ता। से यरूशलेम शईरो दे दाऊदपुर जगा दे तदुए तक रई जदुए तक कि मईल, यहोवे रा मन्दर, ओर यरूशलेम शईरो रे चऊँ कनारली दवाल बनाणे रा काम पूरा नि ऊई गा। <verse eid="1KI 3:1" /><verse number="2" style="v" sid="1KI 3:2" />तेस बखते यहोवे रा मन्दर बणी की त्यार नि ऊई रा था, इजी री खातर इस्राएलो रे लोक एबु बी ऊच्ची जगा देई डांगरा खे बलि करेया करो थे। <verse eid="1KI 3:2" /><verse number="3" style="v" sid="1KI 3:3" />सुलैमान यहोवे ते प्यार करो था ओर आपणे बाओ दाऊदो री बिदिया पाँदे चलदा तो रया, पर से ऊच्ची जगा पाँदे बी बलि चढ़ाओ था ओर तूप बाल़ो था। <verse eid="1KI 3:3" /><verse number="4" style="v" sid="1KI 3:4" />तेबे राजा गिबोन शईरो दे बलि चढ़ाणे खे गया, कऊँकि मुख्य ऊच्ची जगा सेई थी, तेबे तेथो री बेदिया पाँदे सुलैमाने 1,000 आगी दे होमबलि चढ़ाए।<verse eid="1KI 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 3:5" />जेबे सुलैमान गिबोनो दे था, तेबे यहोवे राती सुफने रे जरीये तेसखे दर्शण देई की बोलेया, “जो कुछ तूँ चाएआ कि आऊँ ताखे देऊँ, से मांते माँग।” <verse eid="1KI 3:5" /><verse number="6" style="v" sid="1KI 3:6" />सुलैमाने बोलेया, “तूँ आपणे दास मेरे बाओ दाऊदो पाँदे बड़ी कृपा करदा रया, कऊँकि से आपू खे तां सामणे जाणी की तां साथे सच्चा, वफादार ओर ईमानदार था। तैं तेस पाँदे एथो तक करूणा कित्ती थी कि तेसखे तेसरी गद्दिया पाँदे बैठणे वाल़ा एक पाऊ देई राखेया, जेड़ा कि आज सामणे ए। <verse eid="1KI 3:6" /><verse number="7" style="v" sid="1KI 3:7" />ओर एबे ओ मेरे यहोवा परमेशर! तैं आपणे दास मेरे बाओ दाऊदो री जगा पाँदे राजा बणाई राखेया, पर आऊँ छोटे पाऊए जेड़ा ए जो एसा जिम्मेदारिया खे निबाणा नि जाणदा। <verse eid="1KI 3:7" /><verse number="8" style="v" sid="1KI 3:8" />पर तेरा दास तेरी चूणी री प्रजा रे बऊत लोका बीचे ए, जिना री गिणती बऊत जादा ऊणे रिया बजअ ते नि ऊई सकदी। <verse eid="1KI 3:8" /><verse number="9" style="v" sid="1KI 3:9" />तूँ आपणे दासो खे आपणी प्रजा रा न्याय करने खे समजणे खे एड़ी शक्ति दे कि आऊँ खरे-बुरे खे परखी सकूँ, कऊँकि एड़ा कुण ए जो तेरी इतणी बड़ी प्रजा रा न्याय करी सको?” <verse eid="1KI 3:9" /><verse number="10" style="v" sid="1KI 3:10" />एते गल्ला ते परमेशर बऊत खुश ऊआ कि सुलैमाने एड़ा वरदान मांगेया। <verse eid="1KI 3:10" /><verse number="11" style="v" sid="1KI 3:11" />तेबे परमेशरे तेसखे बोलेया, “कऊँकि तैं एड़ा वरदान मांगी राखेया ओर ना तो लाम्बी उम्र, ना पैसा ओर ना आपणे दुश्मणा रा नाश मांगेया, पर समजणे खे विवेको रा वरदान मांगी राखेया, इजी री खातर सुण, <verse eid="1KI 3:11" /><verse number="12" style="v" sid="1KI 3:12" />आऊँ तेरे मांगणे रे मुताबिक करूँआ, ताखे अक्ल ओर विवेको साथे परेया रा मन देऊँआ, एथो तक कि तां जेड़ा ना तो तांते पईले कोई ऊआ ओर ना बादो ते कोई कदी ऊणा। <verse eid="1KI 3:12" /><verse number="13" style="v" sid="1KI 3:13" />फेर जो तैं नि मांगेया, मतलब पैसा ओर महिमा, से बी आऊँ ताखे एथो तक देऊँआ कि तेरी पूरी जिन्दगी तां जेड़ा कोई राजा नि ऊणा। <verse eid="1KI 3:13" /><verse number="14" style="v" sid="1KI 3:14" />तेबे जे तूँ आपणे बाओ दाऊदो जेड़ा मेरी बाटा दे चलदा ऊआ, मेरी बिदिया खे ओर आज्ञा खे मानदा रएगा, तो मां तेरी उम्र बढ़ाणी।”<verse eid="1KI 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 3:15" />तेबे सुलैमान जागी की उठेया ओर देखेया कि ये तो सुफना था। तेबे से यरूशलेम शईरो खे गया ओर यहोवे रे वाचा रे सन्दूको सामणे खड़ा ऊई की, होमबलि ओर मेलबलि चढ़ाए ओर आपणे सारे कर्मचारिया खे पाट्टिया कित्तिया। <verse eid="1KI 3:15" /><verse number="16" style="v" sid="1KI 3:16" />एक दिन दो वेश्या राजे गे आई की तेस सामणे खड़ी गिया। <verse eid="1KI 3:16" /><verse number="17" style="v" sid="1KI 3:17" />तिना बीचा ते एक जवाणस बोलणे लगी, “ओ मेरे प्रभु! आऊँ ओर ये जवाणस दोनो एक ई कअरे रऊँईया ओर एसा साथे कअरे रंदे ऊए मेरे एक बच्चा ऊआ। <verse eid="1KI 3:17" /><verse number="18" style="v" sid="1KI 3:18" />तेबे मेरे बच्चा ऊणे ते तीन दिन बाद एसा जवाणसा रे बी बच्चा ऊआ; आसे दोनो साथे-साथे थिया, आसा दुँईं खे छाडी की कअरे ओर कोई माणूं नि था। <verse eid="1KI 3:18" /><verse number="19" style="v" sid="1KI 3:19" />ओर राथियो खे एसा जवाणसा रा बच्चा एसा निठे दबी की मरी गा। <verse eid="1KI 3:19" /><verse number="20" style="v" sid="1KI 3:20" />तेबे एसे आदिया राती उठी की, जेबे तेरी दासी सई दी थी, तेबे मेरा बच्चा मांगा गे ते लई की आपणी छातिया पाँदे राखी ता ओर आपणा मरेया रा बच्चा मेरी छातिया गे लटयाल़ी ता। <verse eid="1KI 3:20" /><verse number="21" style="v" sid="1KI 3:21" />प्यागा जेबे आऊँ आपणे बच्चे खे दूद पल्याणे खे उठी, तेबे से मरेया रा मिलेया; पर प्यागा मैं से त्यानो ते देखेया कि से मेरा पाऊ नि ए।” <verse eid="1KI 3:21" /><verse number="22" style="v" sid="1KI 3:22" />तेबे दूजी जवाणसे बोलेया, “ना, जिऊँदा पाऊ मेरा ए ओर मरेया रा पाऊ तेरा ए। पर से बोलदी रयी, ना, मरेया रा तेरा ए ओर जिऊँदा पाऊ मेरा ए, ईंयाँ सेयो राजे सामणे बईस करदिया रईया।” <verse eid="1KI 3:22" /><verse number="23" style="v" sid="1KI 3:23" />राजे बोलेया, “एक तो बोलोई कि जो जिऊँदा ए, सेई मेरा पाऊ ए ओर मरेया रा पाऊ तेरा ए ओर दूजी बोलोई कि ना, जो मरेया राए, से तेरा ए ओर जो जिऊँदा ए, से मेरा पाऊ ए।” <verse eid="1KI 3:23" /><verse number="24" style="v" sid="1KI 3:24" />तेबे राजे बोलेया, “मांगे तलवार ल्याओ;” तेबे एक तलवार राजे गे ल्याई। <verse eid="1KI 3:24" /><verse number="25" style="v" sid="1KI 3:25" />तेबे राजे बोलेया, “जिऊँदे बच्चे रे दो टुकड़े करी की आदा एसा जवाणसा खे देई दो आदा दूजिया जवाणसा खे देई दो।” <verse eid="1KI 3:25" /><verse number="26" style="v" sid="1KI 3:26" />तेबे जिऊँदे पाऊए री माया रा मन आपणे पाऊए रे प्यारो ते परी गा ओर तेसे राजे खे बोलेया, “ओ मेरे प्रभु! जिऊँदा पाऊ एसा खे देई दे; पर एसखे नि मारो।” दूजी जवाणसे बोलेया, “से ना तो मेरा ऊणा चाईयो, ना तेरा, एसरे दो टुकड़े करी देयो।” <verse eid="1KI 3:26" /><verse number="27" style="v" sid="1KI 3:27" />तेबे राजे न्याय करदे ऊए ईंयाँ बोलेया, “पईलिया जवाणसा खे जिऊँदा बच्चा देई दो; ये नि काणा; कऊँकि एसरी माये ये ईए।” <verse eid="1KI 3:27" /><verse number="28" style="v" sid="1KI 3:28" />जो न्याय राजे कित्तेया था, तेतेरा सन्देश सारे इस्राएलो खे मिलेया ओर तिने राजे रा डर मानेया, कऊँकि तिने ये देखेया कि तेसरे मनो दे न्याय करने खे परमेशरो री बुद्धि ए।<verse eid="1KI 3:28" /></para>
  <chapter eid="1KI 3" />
  <chapter number="4" style="c" sid="1KI 4" />
  <para style="s">राजा सुलैमानो रे बड़े अधिकारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 4:1" />राजा सुलैमान तो सारे इस्राएल देशो पाँदे राजा बणी गा था<verse eid="1KI 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1KI 4:2" />ओर तेसरे दरबारो दे परदान यो थे, मतलब सादोको रा पाऊ अजर्याह पुरोईत, <verse eid="1KI 4:2" /><verse number="3" style="v" sid="1KI 4:3" />ओर शीशो रा पाऊ एलीहोरोप ओर अहिय्याह परदान मंत्री थे। अहीलूदो रा पाऊ यहोशापात, इतिआसो रा लिखणे वाल़ा था। <verse eid="1KI 4:3" /><verse number="4" style="v" sid="1KI 4:4" />तेबे यहोयादा रा पाऊ बनायाह परदान सेनापति था ओर सादोक ओर एब्यातार पुरोईत थे। <verse eid="1KI 4:4" /><verse number="5" style="v" sid="1KI 4:5" />नातानो रा एक पाऊ अजर्याह पण्डारिया पाँदे अधिकारी था ओर नातानो रा दूजा पाऊ जाबूद पुरोईत ओर राजे रा सला देणे वाल़ा बी था। <verse eid="1KI 4:5" /><verse number="6" style="v" sid="1KI 4:6" />अहीशार राजपरिवारो पाँदे मुखिया था ओर अब्दा रा पाऊ अदोनीराम बेगारो पाँदे मुखिया था।<verse eid="1KI 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 4:7" />ओर राजा सुलैमानो रे बारा पण्डारी थे, जो सारे इस्राएली लोका रे अधिकारी ऊई की राजा ओर तेसरे करानेया खे खाणे-पीणे रा इन्तजाम करो थे। एक-एक मर्द हर साल आपणे-आपणे ठराए रे मीन्ने दे इन्तजाम करो था। <verse eid="1KI 4:7" /><verse number="8" style="v" sid="1KI 4:8" />तिना रे नाओं यो थे, मतलब एप्रैमो रे पाह्ड़ी इलाके दे बेन्हूर, <verse eid="1KI 4:8" /><verse number="9" style="v" sid="1KI 4:9" />ओर माकस, शाल्बीम ओर बेतशेमेश ओर एलोन-बेतानानो दे बेन्देकेर था। <verse eid="1KI 4:9" /><verse number="10" style="v" sid="1KI 4:10" />अरूब्बोत शईरो दे बेन्हेसेद जेसरे कब्जे दे सोक शईर ओर हेपेर शईरो रा सारा देश था। <verse eid="1KI 4:10" /><verse number="11" style="v" sid="1KI 4:11" />दोरो रे सारे ऊच्चे देशो रे बेन-अबीनादाब जेसरी लाड़ी सुलैमानो री बेटी तापत थी। <verse eid="1KI 4:11" /><verse number="12" style="v" sid="1KI 4:12" />अहीलूदो रा पाऊ बाना जेसरे अक्को रे तानाक, मगिद्दो शईर ओर बेतशान शईर रा से सारा देश था, जो सारतान शईरो रे नेड़े ओर यिज्रेलो रे थाले ओर बेतशान शईरो ते लई की आबेल-महोला शईरो तक मतलब योकमाम शईरो रे पोरले कनारे तक आ।<verse eid="1KI 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 4:13" />ओर गिलाद इलाके रे रामोत शईरो दे बेनगेबेर था, जेसरे अक्को दे मनश्शेई याईरो रे गिलाद इलाके रे गाँवो थे, मतलब एतेरे ई अक्को दे बाशान इलाके रे अर्गोबो रा देश था, जिदे दवाल ओर पीतल़ी रे बेड़े वाल़े साठ बड़े-बड़े शईर थे।<verse eid="1KI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 4:14" />इद्दो रे पाऊ अहीनादाबो रे आथो दे महनैम शईर था।<verse eid="1KI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 4:15" />नप्ताली गोत्रो दे अहीमास था, जिने सुलैमानो री बसामत नाओं री बेटिया साथे ब्या करी ला था।<verse eid="1KI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 4:16" />आशेर ओर आलोतो दे हूशै रा पाऊ बाना, <verse eid="1KI 4:16" /><verse number="17" style="v" sid="1KI 4:17" />इस्साकार गोत्रो रे पारूह रा पाऊ यहोशापात, <verse eid="1KI 4:17" /><verse number="18" style="v" sid="1KI 4:18" />ओर बिन्यामीन गोत्रो रे एला रा पाऊ शिमी था। <verse eid="1KI 4:18" /><verse number="19" style="v" sid="1KI 4:19" />ऊरीए रा पाऊ गेबेर गिलादो रे मतलब एमोरिया रे राजा सिहोन ओर बाशानो रे राजा ओगो रे देशो दे था, एस सारे देशो दे सेई पण्डारी था।<verse eid="1KI 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 4:20" />यहूदा ओर इस्राएलो रे लोक बऊत थे, सेयो समुद्रो रे कनारे पाँदले बालूए री कणियां जेड़े बऊत थे ओर खांदे-पींदे ओर मजे करदे रओ थे। <verse eid="1KI 4:20" /><verse number="21" style="v" sid="1KI 4:21" />सुलैमान तो फरात नदिया ते लई की पलिश्तिया रे देश, ओर मिस्रो रे बन्ने तक रे सारे राज्य पाँदे राज करो था ओर तिना रे लोक सुलैमानो खे पूरी जिन्दगी पेंट ल्याओ थे ओर तेसरे वशो दे रओ थे।<verse eid="1KI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 4:22" />सुलैमानो री एक दिनो रिया रसोई दे इतणा लगो था, मतलब लगभग 600 किलो मैदा ओर लगभग 1,200 किलो आटा, <verse eid="1KI 4:22" /><verse number="23" style="v" sid="1KI 4:23" />दस त्यार कित्ते रे बल़द, ओर चरने वाल़े बीइ बल़द, सौ पेडा-बाकरिया ओर इना खे छाडी की ईरण, बारासींगे, यखमूर ओर त्यार कित्ते दे पंछी। <verse eid="1KI 4:23" /><verse number="24" style="v" sid="1KI 4:24" />सुलैमान फरात नदिया रिया पच्छमा रिया जगा दे सारे देशो पाँदे, मतलब तिप्साह ते लई की गाजा तक जितणे राजा थे, तिना सारेया पाँदे सुलैमान राज करो था ओर आपणे चऊँ कनारे रणे वाल़ेया साथे मेल-मिलाप राखो था। <verse eid="1KI 4:24" /><verse number="25" style="v" sid="1KI 4:25" />ओर उतर दिशा दे दानो रे इलाके ते लई की दक्खणा दे बेर्शेबा शईरो तक रे सारे यहूदी ओर इस्राएली आपणी-आपणी अंगूरा री बेला ओर दाऊगल़े रे डाल़ो निठे सुलैमानो री पूरी जिन्दगी बिना डरे रओ थे। <verse eid="1KI 4:25" /><verse number="26" style="v" sid="1KI 4:26" />राजा सुलैमानो गे तेसरे रथा खे 40,000 कोड़ेया रिया गवाईणी थिया ओर तेसरे 12,000 कोड़ सवार थे। <verse eid="1KI 4:26" /><verse number="27" style="v" sid="1KI 4:27" />ओर सेयो पण्डारी आपणे-आपणे मीन्ने दे राजा सुलैमानो खे ओर जितणे तेसरी मेजा पाँदे खाणे खे आओ थे, तिना सारेया खे खाणे रा इन्तजाम सेयो ई करो थे, तेती केसी चीजा री कमी नि ओ थी। <verse eid="1KI 4:27" /><verse number="28" style="v" sid="1KI 4:28" />कोड़े ओर तेज चलणे वाल़े कोड़ेया खे जौ ओर पराल़ जेती जरूरत पड़ो थी तेती आज्ञा रे मुताबिक एक-एक जणा पऊँचाया करो था।<verse eid="1KI 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 4:29" />ओर परमेशरे सुलैमानो खे बुद्धि दित्ती ओर तेसरी समज बऊत ई बढ़ाई ओर तेसरा ज्ञान समुद्रो कनारले बालूए रिया कणियां ते बी जादा बढ़ाया। <verse eid="1KI 4:29" /><verse number="30" style="v" sid="1KI 4:30" />ओर सुलैमानो री बुद्धि पूर्व देशो दे रणे वाल़े ओर मिस्रिया री बी बुद्धिया ते बढ़ी की थी। <verse eid="1KI 4:30" /><verse number="31" style="v" sid="1KI 4:31" />से तो तरतिया रे सारेया माणूंआ ते बी जादा अक्लमंद था बल्कि, एतान, एज्रेही ओर हेमान ओर माहोलो रे पाऊ कलकोल ओर दर्दा ते बी जादा अक्लमंद था ओर तेसरी कीर्ति चऊँ तरफा रिया सबी जातिया दे फैली गी।<verse eid="1KI 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1KI 4:32" />तिने 3,000 नसीअता रिया गल्ला बोले ओर तेसरे 1,005 गीत बी ए। <verse eid="1KI 4:32" /><verse number="33" style="v" sid="1KI 4:33" />तेबे तिने लबानोनो रे देवदारा ते लई की पीतो दे जमणे वाल़ी जूबा तक री सारे डाल़ा री चर्चा ओर पंछी-डांगर ओर लूरने वाल़े जन्तु ओर मछलिया री चर्चा कित्ती। <verse eid="1KI 4:33" /><verse number="34" style="v" sid="1KI 4:34" />ओर देशो-देशो रे लोक तरतिया रे सारे राजेया री तरफा ते जिने सुलैमानो री बुद्धिया री कीर्ति सुणी थी, तेसरी बुद्धिया री गल्ला सुणने खे आया करो थे।<verse eid="1KI 4:34" /></para>
  <chapter eid="1KI 4" />
  <chapter number="5" style="c" sid="1KI 5" />
  <para style="s">मन्दर बनाणे री त्यारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 5:1" />सोर शईरो रे हीराम राजे आपणे दूत सुलैमानो गे पेजे, कऊँकि तिने सुणेया था कि से अभिषिक्त ऊई की आपणे बाओ री जगा पाँदे राजा बणी गा दा ओर दाऊदो री पूरी जिन्दगिया दे हीराम तेसरा दोस्त बणेया दा रया। <verse eid="1KI 5:1" /><verse number="2" style="v" sid="1KI 5:2" />सुलैमाने हीरामो गे तेसरे सन्देशो रा ये ज्वाब पेजेया, “ताखे पता ए, <verse eid="1KI 5:2" /><verse number="3" style="v" sid="1KI 5:3" />कि मेरा बाओ दाऊद आपणे परमेशर यहोवे रे नाओं रा एक मन्दर इजी खे नि बणाई सकेया कि से चऊँ कनारे रिया लड़ाईया दे एड़ा फसेया दा रया, जदुओ तक यहोवे तेसरे दुश्मण तेसरे पैरा निठे नि करी ते।” <verse eid="1KI 5:3" /><verse number="4" style="v" sid="1KI 5:4" />पर एबे मेरे यहोवा परमेशरे मेरे देशो खे चऊँ तरफा ते राम देई राखेया। एबे मेरा कोई दुश्मण नि ए। मेरे लोक केसी बी खतरे दे नि ए। <verse eid="1KI 5:4" /><verse number="5" style="v" sid="1KI 5:5" />मैं आपणे परमेशर यहोवे रे नाओं रा एक मन्दर बनाणे री ठाणी राखी, मतलब तेसा गल्ला रे मुताबिक जो यहोवे मेरे बाओ दाऊदो खे बोली थी, “तेरा पाऊ जो मां तेरी जगा दे गद्दिया पाँदे बठयाल़ना, तेस ई मेरे नाओं रा मन्दर बनवाणा।” <verse eid="1KI 5:5" /><verse number="6" style="v" sid="1KI 5:6" />इजी री खातर एबे तूँ माखे लबानोनो पाँदा ते देवदार बाडणे री आज्ञा दे ओर मेरे दास तेरे दासा साथे रणे ओर जो कुछ मजदूरी तां ठराणी, सेई मां ताखे ओर तेरे दासा खे देणी, ताखे पता तो आए कि सीदोन शईरो रे बराबर लकड़ी बाडणे रा पेत आसा लोका बीचा ते कोई नि जाणदा। <verse eid="1KI 5:6" /><verse number="7" style="v" sid="1KI 5:7" />सुलैमान राजे रिया इना गल्ला खे सुणी की हीराम राजा बऊत खुश ऊईगा ओर तिने बोलेया, “आज यहोवा तन्य ए, जिने दाऊदो खे तेसा बड़ी जातिया पाँदे राज करने खे एक अक्लमंद पाऊ दित्तेया।”<verse eid="1KI 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 5:8" />तेबे हीराम राजे सुलैमान राजे खे ये सन्देशा पेजेया, “जो तैं माखे सन्देशा पेजी राखेया से मेरी समजा दे आई गा, देवदार ओर केली री लकड़िया रे बारे दे जो कुछ तूँ चाए, मां सेई करना। <verse eid="1KI 5:8" /><verse number="9" style="v" sid="1KI 5:9" />मेरे दासा लकड़ी लबानोनो ते समुद्रो तक पऊँचाणी, तेबे मां तिना रे बेड़े बणाई की जो जगा तूँ ठराएगा, तेथी समुद्रो रिया बाटा रिये सेयो पऊँचाई देणे, तेती मां सेयो खोली की राखी देणे ओर तैं सेयो लई लणे ओर तैं मेरे परिवारो खे रोटी देई की मेरी बी इच्छा पूरी करनी।” <verse eid="1KI 5:9" /><verse number="10" style="v" sid="1KI 5:10" />ईंयाँ हीराम राजा सुलैमान राजे री इच्छा रे मुताबिक तेसखे देवदार ओर केली री लकड़ी देणे लगेया। <verse eid="1KI 5:10" /><verse number="11" style="v" sid="1KI 5:11" />ओर सुलैमान राजे हीराम राजे रे परिवारो रे खाणे खे 2,000 टन कणक ओर 440,000 लीटर शुद्ध जैतूनो रा तेल दित्तेया; ईंयाँ सुलैमान राजा हीराम राजे रे परिवारो खे हर साल देया करो था।<verse eid="1KI 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 5:12" />यहोवे सुलैमानो खे आपणे वादे रे मुताबिक बुद्धि दित्ती ओर हीराम राजा ओर सुलैमान राजे बीचे मेल बणेया रा रया, बल्कि तिने दुँईं आपू बीचे वाचा बी बानी ती। <verse eid="1KI 5:12" /><verse number="13" style="v" sid="1KI 5:13" />सुलैमान राजे पूरे इस्राएलो रे 30,000 लोक कामो दे लगाए, <verse eid="1KI 5:13" /><verse number="14" style="v" sid="1KI 5:14" />ओर से तिना खे लबानोन पाहड़ो पाँदे बारी-बारी करी की मीन्ने रे मीन्ने 10,000 पेजेया करो था ओर एक मीन्ना सेयो लबानोनो पाँदे ओर दो मीन्ने कअरे रया करो थे; ओर कामो वाल़ेया पाँदे अदोनीराम ठराया। <verse eid="1KI 5:14" /><verse number="15" style="v" sid="1KI 5:15" />सुलैमानो रे 70,000 बोजा टोणे वाल़े ओर पाह्ड़ो पाँदे 80,000 डाल़ बाडणे वाल़े ओर पात्थर काडणे वाल़े थे। <verse eid="1KI 5:15" /><verse number="16" style="v" sid="1KI 5:16" />इना खे छाडी की सुलैमानो रे 3,300 मुखिया थे, जो काम करने वाल़ेया पाँदे अधिकारी थे। <verse eid="1KI 5:16" /><verse number="17" style="v" sid="1KI 5:17" />तेबे राजे री आज्ञा ते बड़े-बड़े कीमती पात्थर इजी रिया तँईं खणी की निकयाल़े, ताकि मन्दरो री निऊँ, कअड़े रे पात्थरा साथे पाई जाओ। <verse eid="1KI 5:17" /><verse number="18" style="v" sid="1KI 5:18" />सुलैमानो रे कारीगर ओर हीरामो रे कारीगर ओर गबाली शईरो रे लोके सेयो पात्थर कअड़े ओर मन्दरो खे बनाणे खे लकड़ी ओर पात्थर त्यार कित्ते।<verse eid="1KI 5:18" /></para>
  <chapter eid="1KI 5" />
  <chapter number="6" style="c" sid="1KI 6" />
  <para style="s">मन्दरो रा काम</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 6:1" />इस्राएली लोका रे मिस्र देशो ते निकल़ने रे 480 साल बाद जो सुलैमानो रा इस्राएलो पाँदे राज करने रा चौथा साल था, तेसरे जीव<note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="fq" closed="false">जीव </char><char style="ft" closed="false">ईब्री मइना, बशाख मइना </char></note> नाओं रे दूजे मीन्ने दे से यहोवे रा मन्दर बनाणे लगेया। <verse eid="1KI 6:1" /><verse number="2" style="v" sid="1KI 6:2" />जो मन्दर सुलैमान राजे यहोवे खे बणाया से नब्बे फुट<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fq" closed="false">नब्बे फुट </char><char style="ft" closed="false">एक आथ लगभग 18 ईंच, या डेढ़ फूट </char></note> लाम्बा, ती फुट चौड़ा ओर पैंताल़ी फुट ऊच्चा था।<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">प्रेरि. 7:47 </char></note> <verse eid="1KI 6:2" /><verse number="3" style="v" sid="1KI 6:3" />ओर मन्दरो रे सामणे रा आँगण ती फुट लाम्बा था, मतलब मन्दरो री चौड़ाईया रे बराबर था ओर बरांडे री चौड़ाई जो मन्दरो रे सामणे था, से पन्द्रा फुट थी। <verse eid="1KI 6:3" /><verse number="4" style="v" sid="1KI 6:4" />तेबे तिने मन्दरो दे चौखटा समेत जाल़िया वाल़िया दवारिया बणाईया। <verse eid="1KI 6:4" /><verse number="5" style="v" sid="1KI 6:5" />ओर तिने मन्दरो रे नेड़े-तेड़े रे पीता साथे लगे रे, मतलब मन्दर ओर दर्शण करने री जगा, दुँईं पीता रे नेड़े-तेड़े तिने मञ्जला ओर कमरे बणाए। <verse eid="1KI 6:5" /><verse number="6" style="v" sid="1KI 6:6" />सारे ते थालली मञ्जल साडे सात फुट चौड़ी, ओर बीचली नौ फुट ओर पाँदली साडे दस फुट चौड़ी थी, कऊँकि तिने मन्दरो रे नेड़े-तेड़े रे पीत बारलिया तरफा खे कुर्सीदार बणाए थे, इजी खे ताकि कड़िया मन्दरो री दवाला री पकड़ा रे ना ओ। <verse eid="1KI 6:6" /><verse number="7" style="v" sid="1KI 6:7" />बणांदे बखते मन्दर एड़े पात्थरा साथे बणाया गया, जो तेती ल्याऊणे ते पईले कअड़ी की ठीक कित्ते थे ओर मन्दरो रे बणदे बखते, थौड़ा, छीणी या ओर कोई लोए रे औजारो री आवाज नि सुणी। <verse eid="1KI 6:7" /><verse number="8" style="v" sid="1KI 6:8" />बारले बीचले कमरे रा द्वार मन्दरो रे दाँणी तरफा खे था ओर लोक चक्करदार पईड़िया रिये ऊई की बीचली मञ्जला खे जाओ थे ओर तिना ते ई पाँदली मञ्जला खे जाया करो थे। <verse eid="1KI 6:8" /><verse number="9" style="v" sid="1KI 6:9" />तिने मन्दर बणाई की पूरा कित्तेया ओर तेतेरी छत देवदारो री लकड़ी ओर तख़्तेया साथे बणी री थी। <verse eid="1KI 6:9" /><verse number="10" style="v" sid="1KI 6:10" />ओर पूरे मन्दरो साथे लगी री जो मञ्जला तिने बणाईया सेयो साडे सात फुट ऊच्चिया थिया ओर सेयो देवदारो री लकड़िया रे जरीये मन्दरो साथे मलाईया री थिया।<verse eid="1KI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 6:11" />तेबे यहोवे रा ये वचन सुलैमानो गे पऊँचेया, <verse eid="1KI 6:11" /><verse number="12" style="v" sid="1KI 6:12" />“ये मन्दर जो तूँ बनाणे लगी रा, जे तूँ मेरी बिदिया पाँदे चलेगा ओर मेरे नियम मानोगा ओर मेरी सारी आज्ञा पाँदे चलदा ऊआ तिना रा पालण करदा रएगा, तो जो वचन मैं तेरे बारे दे तेरे बाओ दाऊदो गे दित्तेया था से मां पूरा करना। <verse eid="1KI 6:12" /><verse number="13" style="v" sid="1KI 6:13" />ओर मां इस्राएली लोका बीचे रणा ओर आपणी इस्राएली प्रजा नि छाडणी।” <verse eid="1KI 6:13" /><verse number="14" style="v" sid="1KI 6:14" />तेबे सुलैमाने यहोवे रा मन्दर बणाई की पूरा कित्तेया।<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">प्रेरि. 7:47 </char></note> <verse eid="1KI 6:14" /><verse number="15" style="v" sid="1KI 6:15" />तिने मन्दरो री कांदा दे पीतरा ते देवदारो रे तख़्तेया साथे बन्द कित्तिया ओर मन्दरो रे मेल्ले ते छतो तक री कांदा दे पीतरे लकड़िया रे तख़्ते ओर मन्दरो रा मेल्ला तिने केली रे तख़्तेया साथे बणाया।<verse eid="1KI 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 6:16" />ओर मन्दरो रे पिछले कनारे बी तिने ती फुटो री दूरिया पाँदे मेल्ले ते लई की पीतो पाँदो तक देवदारो रिया तख़्तिया लगाईया, ईंयाँ तिने परम पवित्र जगा खे मन्दरो री एक पीतरली कोठरी बणाई। <verse eid="1KI 6:16" /><verse number="17" style="v" sid="1KI 6:17" />तिजी रे सामणे रा कमरा साठ फुट लाम्बा था।<verse eid="1KI 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 6:18" />मन्दरो री कांदा पाँदे पीतरा ते देवदारो री लकड़िया साथे तख़्ताबंदी कित्ती थी ओर तिदे कलिया ओर खिले रे फूला री कडाई करी राखी थी, सारा देवदार ई था, कोई बी पात्थर नि दिशो था।<verse eid="1KI 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 6:19" />मन्दरो ते पीतरे तिने एक पवित्र जगा दे यहोवे रे वादे रा सन्दूक राखणे खे त्यार कित्ती। <verse eid="1KI 6:19" /><verse number="20" style="v" sid="1KI 6:20" />ओर तेसा पवित्र जगा री लम्बाई, चौड़ाई ओर ऊचाई ती-ती फुट थी ओर तिने तेते पाँदे शुद्ध सूईना मढ़ेया ओर बेदिया री तख़्ताबंदी देवदारो साथे कित्ती। <verse eid="1KI 6:20" /><verse number="21" style="v" sid="1KI 6:21" />तेबे सुलैमाने मन्दर पीतरा ते शुद्ध सूईने साथे मढ़ाया ओर पवित्र जगा सामणे सूईने रिया साँगल़िया लगाईया ओर से बी सूईने साथे मढ़ाईया। <verse eid="1KI 6:21" /><verse number="22" style="v" sid="1KI 6:22" />ओर तिने पूरा मन्दर सूईने साथे मढ़ाई की तेतेरा पूरा काम निपटाई ता। ओर पवित्र जगा री पूरी बेदी बी तिने सूईने साथे मढ़ाई।<verse eid="1KI 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 6:23" />पवित्र जगा दे तिने पन्द्रा-पन्द्रा फुट ऊच्चे जैतूनो री लकड़िया रे करूब बणाए। <verse eid="1KI 6:23" /><verse number="24" style="v" sid="1KI 6:24" />एकी करूबो रा एक पंख साडे सात फुट था ओर तेतेरा दूजा पंख बी साडे सात फुट था, एक पंखो रे सिरे ते दूजे पंखो रे सिरे तक लम्बाई पन्द्रा फुट थी। <verse eid="1KI 6:24" /><verse number="25" style="v" sid="1KI 6:25" />दूजा करूब बी पन्द्रा फुटा रा था; दोनो करूब एक ई नापो रे ओर एक ई आकारो रे थे। <verse eid="1KI 6:25" /><verse number="26" style="v" sid="1KI 6:26" />एकी करूबो री ऊचाई पन्द्रा फुटो री ओर दूजे री बी इतणी ई थी। <verse eid="1KI 6:26" /><verse number="27" style="v" sid="1KI 6:27" />तिने करूब पीतरली जगा दे रखवाई ते ओर करूबो रे पंख एड़े फैले थे कि एकी करूबो रा एक पंख, एक कांदा ते ओर दूजे रा दूजा पंख, दूजी कांदा साथे लगेया रा था, तेबे तिना रे दो पंख मन्दरो बीचे एकी-दूजे साथे लगे रे थे। <verse eid="1KI 6:27" /><verse number="28" style="v" sid="1KI 6:28" />तिने करूब सूईने की मढ़वाए। <verse eid="1KI 6:28" /><verse number="29" style="v" sid="1KI 6:29" />तिने मन्दरो री कांदा दे बारे ओर पीतरे चऊँ कनारे करूब, खजूर ओर खिले रे फूला री कडाई कराई राखी थी। <verse eid="1KI 6:29" /><verse number="30" style="v" sid="1KI 6:30" />मन्दरो रे पीतरले ओर बारले मेल्ले तिने सूईने की मढ़वाए। <verse eid="1KI 6:30" /><verse number="31" style="v" sid="1KI 6:31" />पवित्र जगा रे द्वारो पाँदे तिने जैतूनो री लकड़िया रे दरवाजे लगवाए ओर दरवाजे रे सिरे रा आकार पांजा कूणेया वाल़ा बणवाया। <verse eid="1KI 6:31" /><verse number="32" style="v" sid="1KI 6:32" />दोनो फल़े जैतूनो री लकड़िया रे थे ओर तिने तिना दे करूब, खजूरी रे डाल़ ओर खिले रे फूला री कडाई कराई ओर सूईने साथे मढ़े रे ओर करूब ओर खजूरा पाँदे बी सूईना मढ़वाया ओर कडाई करवाई।<verse eid="1KI 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 6:33" />ईंयाँ तिने मन्दरो रे द्वारो खे बी जैतूनो री लकड़िया रे दरवाजे रे कनारे बणाए ओर से मन्दरो री चौड़ाईया रा चौथा इस्सा था। <verse eid="1KI 6:33" /><verse number="34" style="v" sid="1KI 6:34" />दोनो फल़े केली री लकड़िया रे थे, जिना बीचा ते एकी फल़े रे दो पल्ले थे ओर दूजे फल़े रे दो पल्ले थे जो पल़टी की दोरे ऊई जाओ थे।<verse eid="1KI 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1KI 6:35" />तिना पाँदे बी तिने करूब ओर खजूरी रे डाल़ ओर खिले रे फूला री कडाई कराई ओर खुदे रे कामो पाँदे तिने सूईना मढ़वाया।<verse eid="1KI 6:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 6:36" />तिने पीतरले आँगणो रा केरा कअड़े रे पात्थरा रे तीन रद्दे ओर एक परत देवदारो री कड़िया लगाई की बणाया। <verse eid="1KI 6:36" /><verse number="37" style="v" sid="1KI 6:37" />सुलैमानो रे राजा बणने रे चौथे सालो रे जीव नाओं रे मीन्ने दे यहोवे रे मन्दरो री निऊँ पाई। <verse eid="1KI 6:37" /><verse number="38" style="v" sid="1KI 6:38" />ओर ग्यारुए सालो रे बूल नाओं रे आठुए मीन्ने दे मन्दर बनाणे रा काम पूरा ऊआ। ईंयाँ सुलैमानो खे तिजी खे बनाणे खे सात साल लगे। ओर से तिंयाँ ई बणाई की पूरा कित्तेया जेड़ी योजना तिने बणाई राखी थी।<verse eid="1KI 6:38" /></para>
  <chapter eid="1KI 6" />
  <chapter number="7" style="c" sid="1KI 7" />
  <para style="s">सुलैमानो रे ओर काम</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 7:1" />तेबे सुलैमाने आपणा मईल बी बणाया ओर तिजी खे पूरा करने दे तेरा साल लगे। <verse eid="1KI 7:1" /><verse number="2" style="v" sid="1KI 7:2" />तिने लबानोनो रा वन नाओं रा एक ओर मईल बणाया जेतेरी लम्बाई 150 फुट, चौड़ाई पचयात्तर फुट ओर ऊचाई पैंताल़ी फुट थी; इदे देवदारो रे खम्बेया रिया तीन लाईनी थिया जेते पाँदे तेतेरी छत टीकी री थी। एकी लाईनी दे पन्द्रा खम्बे थे, हर एकी खम्बे पाँदे देवदारो री कड़िया रा मूरा था। <verse eid="1KI 7:2" /><verse number="3" style="v" sid="1KI 7:3" />ओर पैंताल़ी खम्बेया पाँदे देवदारो रिया लकड़िया री छत थी, जेते खे साअरा देणे खे कड़िया थिया, जो खम्बेया खे एकी दूजे ते जोड़ो थिया। <verse eid="1KI 7:3" /><verse number="4" style="v" sid="1KI 7:4" />तीऊँ लाईनी दे कड़िया लगाईया ओर तीऊँ रिया दवारिया आमणे-सामणे बणिया। <verse eid="1KI 7:4" /><verse number="5" style="v" sid="1KI 7:5" />ओर सारे द्वार ओर दवारिया रिया कड़िया चौरस थिया ओर तीऊँ मईला रिया दवारिया आमणे-सामणे बणिया। <verse eid="1KI 7:5" /><verse number="6" style="v" sid="1KI 7:6" />तिने एक खम्बे वाल़ा बरांडा बी बणाया जेतेरी लम्बाई पचयात्तर फुट, ओर चौड़ाई पैंताल़ी फुट थी। बरांडे रे सामणे खम्बे ओर एक छज्जा था। <verse eid="1KI 7:6" /><verse number="7" style="v" sid="1KI 7:7" />तेबे तिने लोका रा न्याय करने खे न्याय रे सिंहासनो खे बी एक बरांडा बणाया, जेतेखे न्याय रा बरांडा बोलेया गया ओर तिने एक मेल्ले ते दूजे मेल्ले तक देवदारो रे तख़्ते लगाए।<verse eid="1KI 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 7:8" />तेसरे रणे रा मईल जो तेस बरांडे रे पीतरे एकी तरफा खे आँगणो दे बणेया, से बी तेते टंगो रा ई बणेया। तेबे तेस बरांडे जेड़ा सुलैमाने फिरौनो री बेटिया खे जो तिने ब्यायी ली थी, एक ओर मईल बणाया।<verse eid="1KI 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 7:9" />यो सारे कअर बारे पीतरे निऊँआ ते लई की छतो तक एड़े कीमती ओर कअड़े रे पात्थरा साथे बणे जो नापी की ओर आरेया साथे चीरी की त्यार कित्ते थे ओर बारले आँगणो ते लई की पीतरले आँगणो तक लगाए। <verse eid="1KI 7:9" /><verse number="10" style="v" sid="1KI 7:10" />तेतेरी निऊँ तो बड़े कीमती बड़े-बड़े मतलब पन्द्रा-पन्द्रा ओर बारा-बारा फुट लाम्बे पात्थरा री पाई थी। <verse eid="1KI 7:10" /><verse number="11" style="v" sid="1KI 7:11" />ओर ऊबे बी बड़े कीमती पात्थर थे, जो नापी की कअड़े रे पात्थर थे ओर देवदारो री लकड़ी बी थी। <verse eid="1KI 7:11" /><verse number="12" style="v" sid="1KI 7:12" />बड़े आँगणो रे चऊँ कनारले केरे कअड़े रे पात्थरा रे तीन रद्दे ओर देवदारो री लकड़िया री एक परत थी, जेड़ा कि यहोवे रे मन्दरो रे पीतरले आँगण ओर मईलो रे बरांडे रे लगी रे थे।<verse eid="1KI 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 7:13" />तेबे सुलैमान राजे दूत पेजी की सोर देशो ते हूराम बुलाया। <verse eid="1KI 7:13" /><verse number="14" style="v" sid="1KI 7:14" />से नप्ताली गोत्रो री केसी बिदुआ रा पाऊ था ओर तेसरा बाओ एक सोर जगा दे रणे वाल़ा ताँबे बगैरा रे पांडे बनाणे वाल़ा था, ओर हूराम बी पीतल़ी री कारीगरिया दे पूरी बुद्धि, निपुणता ओर समज राखो था। तेबे से सुलैमान राजे गे आई की तेसरा सारा काम करने लगेया। <verse eid="1KI 7:14" /><verse number="15" style="v" sid="1KI 7:15" />हीरामे पीतल़ गल़ाई की सताई फूट ऊच्चे दो खम्बे बणाए ओर एकी-एकी खम्बे रा केरा ठारा फूट था। यो पितरा ते खोखले थे, ओर एते धातुआ री मोटाई तीन ईंच थी। <verse eid="1KI 7:15" /><verse number="16" style="v" sid="1KI 7:16" />तिने खम्बेया रे सिरे पाँदे लगाणे खे पीतल़ गल़ाई की दो टकणियां बणाईया; एकी-एकी टकणियां री ऊचाई, साडे सात फुट थी। <verse eid="1KI 7:16" /><verse number="17" style="v" sid="1KI 7:17" />खम्बेया रे सिरो पाँदली टकणियां खे चार खाने रिया सात-सात जाल़िया ओर साँगल़ा रिया सात-सात चालरा बणिया। <verse eid="1KI 7:17" /><verse number="18" style="v" sid="1KI 7:18" />तिने खम्बे बी ईंयाँ बणाए कि खम्बेया रे सिरो पाँदली एक-एक टखणियां खे टखणे खे चऊँ कनारे जाल़िया री एक-एक चालरा पाँदे अनारा री दो पाल़िया थिया। <verse eid="1KI 7:18" /><verse number="19" style="v" sid="1KI 7:19" />जो टकणियां बरांडे रे खम्बेया रे सिरेया पाँदे बणिया, तिना दे छे-छे फुट ऊच्चे सोसणो रे फूल बणे दे थे। <verse eid="1KI 7:19" /><verse number="20" style="v" sid="1KI 7:20" />ओर एकी-एकी खम्बे रे सिरे पाँदे, तेसा गोल़ाईया गे जो जाल़िया साथे लगी री थी, एक ओर टकणी बणी ओर एकी-एकी टकणियां पाँदे जो अनार चऊँ तरफा खे पाल़िया-पाल़िया दे बणे थे, सेयो 200 थे। <verse eid="1KI 7:20" /><verse number="21" style="v" sid="1KI 7:21" />तिने सेयो खम्बे मन्दरो रे बरांडे दे खड़े कित्ते। तेबे तिने दाँणी तरफा खे खम्बा खड़ा करी की तेतेरा नाओं याकीन राखेया; तेबे खूँजे कनारे खम्बा खड़ा करी की तेतेरा नाओं बोअज राखेया। <verse eid="1KI 7:21" /><verse number="22" style="v" sid="1KI 7:22" />ओर खम्बेया रे सिरेया पाँदे सोसणो रे फूलो रा काम ऊआ, खम्बेया रा काम ईंयाँ ई पूरा ऊआ।<verse eid="1KI 7:22" /></para>
  <para style="s">पीतल़ी रा कुण्ड</para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 7:23" />इजी ते बाद हूरामे पीतल़ी रा एक बड़ा कुण्ड बणाया, जो एक कूणे ते लई की दूजे कूणे तक पन्द्रा फुट चौड़ा था, तेतेरा आकार गोल़ था ओर तेतेरी ऊचाई साडे सात फुट थी ओर तेतेरे चऊँ कनारला केरा पैंताल़ी फुट था। <verse eid="1KI 7:23" /><verse number="24" style="v" sid="1KI 7:24" />ओर तेतेरे चऊँ कनारे कूणेया ते निठे डेड-डेड फुटो दे दस-दस कलिया बणिया, जो कुण्डो रे चऊँ कनारे थिया; जेबे से बणाया; तेबे यो कलिया बी दो पाल़िया दे बणाईया। <verse eid="1KI 7:24" /><verse number="25" style="v" sid="1KI 7:25" />ओर से औद बारा बणाए रे बल़दा पाँदे राखेया, जिना बीचा ते तीन उत्तर, तीन पच्छम, तीन दक्खण ओर तीऊँ पूर्वो रिया तरफा खे मूँ करी राखेया था ओर तिना ई पाँदे कुण्ड था ओर तिना सारेया रा पिछला इस्सा पीतरली तरफा खे था। <verse eid="1KI 7:25" /><verse number="26" style="v" sid="1KI 7:26" />तेतेरी मोटाई चार ईंच थी ओर तेतेरा कनारा कटोरे रे सिरे जेड़ा सोसणो रे फूलो जेड़ा बणेया था ओर तिदे 40,000 लीटर पाणी बी आओ था।<verse eid="1KI 7:26" /></para>
  <para style="s">पीतल़ी रे पावे</para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 7:27" />तेबे हूरामे पीतल़ी रे दस पावे बणाए, एकी-एकी पावे री लम्बाई छे फुट, चौड़ाई छे फुट ओर ऊचाई साडे चार फुट थी। <verse eid="1KI 7:27" /><verse number="28" style="v" sid="1KI 7:28" />तिना पावेया री बणाऊट एड़ी थी; तिना दे फटिया थिया ओर फटिया रे बीचे जोड़ बी थे। <verse eid="1KI 7:28" /><verse number="29" style="v" sid="1KI 7:29" />ओर जोड़ा रे बीछीए री फटिया दे शेर, बल़द ओर करूब बणी रे थे ओर जोड़ा पाँदे बी एक-एक पावा बणेया ओर शेर ओर बल़दा निठे लटकदे ऊए चालरा बणी रिया थिया। <verse eid="1KI 7:29" /><verse number="30" style="v" sid="1KI 7:30" />एक-एक ठेले खे पीतल़ी रे चार टईर ओर पीतल़ी रिया धुरिया बणिया ओर एकी-एकी रे चारो कूणेया ते लगे रे आधार बी कअड़ी की बणाए जो अऊदिया निठो तक पऊँचो थे ओर एकी-एकी आधारो गे चालरा बणी रिया थिया। <verse eid="1KI 7:30" /><verse number="31" style="v" sid="1KI 7:31" />अऊदिया रा मूरा जो ठेले री काँगणिया रे पीतरे ओर पाँदे बी था से डेड फुट ऊच्चा था ओर पावे रा मूरा जेतेरी चौड़ाई टाई फुट थी, से पावे री बणाऊटी जेड़ा गोल़ बणेया; ओर पावे रे तेस मुरे पाँदे बी कुछ खुदेया दा काम था, ओर तिना री फटिया गोल़ नि, चौरस थिया। <verse eid="1KI 7:31" /><verse number="32" style="v" sid="1KI 7:32" />ओर चारो टईर फटिया निठे थे ओर एक-एक पावे री धुरिया बी थिया ओर एक-एक टईरो री ऊचाई टाई फुट थी। <verse eid="1KI 7:32" /><verse number="33" style="v" sid="1KI 7:33" />टईरा री बणाऊट, रथो रे टईरो जेड़ी थी ओर तिना री तारिया, चक्र, आरे ओर नाभे सारे पीतल़ गाल़ी की बणाई राखे थे। <verse eid="1KI 7:33" /><verse number="34" style="v" sid="1KI 7:34" />ओर एक-एक ठेले रे चऊँ कूणेया पाँदे चार आधार थे ओर आधार ओर ठेले दोनो एक ई टुकड़े दे बणी रे थे। <verse eid="1KI 7:34" /><verse number="35" style="v" sid="1KI 7:35" />ओर एक-एक ठेले रे सिरे पाँदे एक फुट ऊच्ची चऊँ कनारे गोल़ाई थी ओर ठेले रे सिरो पाँदले साअरे खे फटे ओर फटिया ठेले साथे जुड़े रे एक ई टुकड़े दे बणी रे थे। <verse eid="1KI 7:35" /><verse number="36" style="v" sid="1KI 7:36" />ओर साअरे रे पाटड़े ओर फटिया पाँदे जितणी जगा जेस पाँदे थी तिदे तिने करूब, शेर ओर खजूरी रे डाल़ खणी की परी ते ओर चऊँ कनारे चालर बी बणाए। <verse eid="1KI 7:36" /><verse number="37" style="v" sid="1KI 7:37" />ईंयाँ तिने दस ठेले बणाए; सारेया रा एक ई साँचा ओर एक ई नाप ओर एक ई आकार था। <verse eid="1KI 7:37" /><verse number="38" style="v" sid="1KI 7:38" />तिने पीतल़ी रिया दस अऊदिया बणाईया। एक-एक अऊदिया दे लगभग 800 लीटर पाणी समाई जाओ था ओर एक-एक औदी छे-छे फुट चौड़ी थी ओर दस ठेलेया बीचे एकी-एकी पाँदे, एक-एक अऊदी थी। <verse eid="1KI 7:38" /><verse number="39" style="v" sid="1KI 7:39" />तिने पाँज अऊदिया दक्खणा रिया तरफा खे ओर पाँज अऊदिया उत्तरो रिया तरफा खे राखी तिया ओर कुण्ड मन्दरो रे दाँणे कनारे, मतलब दक्खण-पूर्वो रिया तरफा खे राखी ता। <verse eid="1KI 7:39" /><verse number="40" style="v" sid="1KI 7:40" />हूरामे अऊदिया, फरूए ओर कटोरे बी बणाए। तेबे हूरामे सुलैमान राजे रे परमेशर यहोवे रे मन्दरो खे जितणा काम करना था, से सारा पूरा करिता, <verse eid="1KI 7:40" /><verse number="41" style="v" sid="1KI 7:41" />मतलब दो खम्बे ओर तिना टकणियां री गोल़ाई जो दुँईं खम्बेया रे सिरे पाँदे थी ओर दुँईं खम्बेया रे सिरे पाँदली गोल़ाईया खे टखणे खे दो-दो जाल़िया ओर दुँईं जाल़िया खे 400-400 अनार, <verse eid="1KI 7:41" /><verse number="42" style="v" sid="1KI 7:42" />मतलब खम्बेया रे सिरेया पाँदे जो गोल़ाईया थी, तिना खे टकणे खे एक-एक जाल़िया खे अनारा री दो-दो पाल़िया; <verse eid="1KI 7:42" /><verse number="43" style="v" sid="1KI 7:43" />दस ठेले ओर इना पाँदलिया दस अऊदिया, <verse eid="1KI 7:43" /><verse number="44" style="v" sid="1KI 7:44" />एक कुण्ड ओर तेते निठले बारा बल़दा रिया बारा मूर्तिया ओर आँडिया, फरूए, <verse eid="1KI 7:44" /><verse number="45" style="v" sid="1KI 7:45" />ओर कटोरे बणे। ये सारे नग जो हूरामे यहोवे रिया तँईं सुलैमान राजे खे बणाए, सेयो चमकाये रे पीतल़ी रे बणाए। <verse eid="1KI 7:45" /><verse number="46" style="v" sid="1KI 7:46" />राजे सेयो यरदन नदिया री तराईया दे मतलब सुक्कोत शईर ओर सारतान जगा रे बीचे चिकणी माट्टिया दे बनाणे खे दित्ती। <verse eid="1KI 7:46" /><verse number="47" style="v" sid="1KI 7:47" />ओर सुलैमाने सारे नग बऊत जादा ऊणे रिया बजअ ते बिना तोले छाडी ते, जेतेरिया बजा ते पीतल़ी रा बजन पता नि लगी सकेया। <verse eid="1KI 7:47" /><verse number="48" style="v" sid="1KI 7:48" />यहोवे रे मन्दरो दे जितणे नग थे सुलैमाने सारे बणाए, मतलब सूईने री बेदी ओर सूईने री से मेज जेते पाँदे चढ़ाणे री रोटी राखी जाओ थी, <verse eid="1KI 7:48" /><verse number="49" style="v" sid="1KI 7:49" />ओर शुद्ध सूईने रिया दीवटा जो पीतरले छोटे कमरे ते आगे पाँज दक्खणा रिया तरफा खे ओर पाँज उत्तरो रिया तरफा खे थिया राखी रिया ओर सूईने रे फूल, <verse eid="1KI 7:49" /><verse number="50" style="v" sid="1KI 7:50" />दिऊए ओर चिमटे ओर शुद्ध सूईने रे तसले, कैंचिया, कटोरे, तूपदान, कड़छे ओर पितरला मन्दर जेतेखे परम पवित्र जगा बोलो थे ओर मईल जेतेखे मन्दर बोलो थे, दुँईं रे दरवाजेया खे सूईने रे कब्जे बणे। <verse eid="1KI 7:50" /><verse number="51" style="v" sid="1KI 7:51" />ईंयाँ जो-जो काम सुलैमान राजे यहोवे रे मन्दरो खे कित्ते, से सारा पूरा करी ता। तेबे सुलैमाने आपणे बाओ दाऊदो रे जरिये पवित्र कित्ते रे सूईने-चाँदी ओर नग पीतरे पऊँचाई की यहोवे रे मन्दरो रे पण्डारो रे राखी ते।<verse eid="1KI 7:51" /></para>
  <chapter eid="1KI 7" />
  <chapter number="8" style="c" sid="1KI 8" />
  <para style="s">सन्दूको री प्रतिष्ठा</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 8:1" />तेबे राजा सुलैमाने इस्राएली लोका रे बुजुर्ग लोक ओर गोत्रा रे सारे खास मर्द जो इस्राएली लोका रे बुजुर्गा रे करानेया रे परदान थे, सेयो बी यरूशलेम शईरो दे आपू गे एते इच्छा ते कट्ठे कित्ते, ताकि सेयो यहोवे री वाचा रा सन्दूक दाऊदो रे शईरो ते मतलब सिय्योनो ते ऊबे लई आओ।<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="ft" closed="false">प्रका. 11:19 </char></note> <verse eid="1KI 8:1" /><verse number="2" style="v" sid="1KI 8:2" />तेबे सारे इस्राएली लोक एतानीम सातुए मीन्ने दे त्योआरो रे बखते सुलैमान राजे गे कट्ठे ऊए। <verse eid="1KI 8:2" /><verse number="3" style="v" sid="1KI 8:3" />जेबे सारे इस्राएली बुजुर्ग आए, तेबे पुरोईते सन्दूक चकी ता। <verse eid="1KI 8:3" /><verse number="4" style="v" sid="1KI 8:4" />ओर यहोवे री वाचा रा सन्दूक, ओर मिलणे वाल़ा तम्बू ओर जितणे पवित्र पांडे तेते शईरो दे थे, तिना सारेया खे लेवी ओर पुरोईत लोक ऊबे लईगे। <verse eid="1KI 8:4" /><verse number="5" style="v" sid="1KI 8:5" />ओर सुलैमान राजा ओर सारी इस्राएली मण्डल़ी, जो तेसगे कट्ठी ऊई थी, सेयो सारे सन्दूको सामणे इतणिया पेडा ओर बल़द बलि करने लगी रे थे, जिना री गिणती किंयाँ पनि ऊई सको थी। <verse eid="1KI 8:5" /><verse number="6" style="v" sid="1KI 8:6" />तेबे पुरोईते यहोवे री वाचा रा सन्दूक तेसरी जगा खे मतलब मन्दरो दे पवित्र जगा दे, जो परम पवित्र जगा ए, पऊँचाई की करूबा निठे राखी ता। <verse eid="1KI 8:6" /><verse number="7" style="v" sid="1KI 8:7" />करूबे तो सन्दूको री जगा पाँदे पंख एड़े फैलाई राखे थे कि तिने पाँदा ते सन्दूक ओर तेतेरे डण्डे टकी राखे थे। <verse eid="1KI 8:7" /><verse number="8" style="v" sid="1KI 8:8" />सेयो डण्डे तो इतणे लाम्बे थे कि तिना रे सिरे तेसा परम पवित्र जगा रे सामणे ते दिशी जाओ थे, पर ओर केथा ते नि दिशो थे। ओर तदुए ते सेयो तेथी ए। <verse eid="1KI 8:8" /><verse number="9" style="v" sid="1KI 8:9" />सन्दूको दे कुछ नि था, तिना दुँईं पात्थरो रिया पट्टिया खे छाडी की जो मूसे होरेबो दे तेतेरे पीतरे तेस बखते राखिया, जेबे यहोवे इस्राएली लोका रे मिस्रो ते निकल़ने रे बखते तिना साथे वाचा बानी थी।<verse eid="1KI 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 8:10" />जेबे पुरोईत पवित्र जगा ते निकल़े, तेबे यहोवे रा मन्दर बादल़ो साथे परीगा था। <verse eid="1KI 8:10" /><verse number="11" style="v" sid="1KI 8:11" />ओर बादल़ो रिया बजअ ते पुरोईत सेवा-टईल करने खे खड़े नि रयी सके, कऊँकि यहोवे री महिमा रा तेज यहोवे रे मन्दरो दे परी गा था।<verse eid="1KI 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 8:12" />तेबे सुलैमान प्रार्थना करने लगेया, “यहोवे बोलेया था कि मां अन्दकूप न्हेरे वाल़े बादल़ो दे वास करना। <verse eid="1KI 8:12" /><verse number="13" style="v" sid="1KI 8:13" />सच्ची मैं ताखे एक रणे खे जगा, बल्कि एड़ी मजबूत जगा बणाई, जिदे तूँ जुगो-जुगो तक बणेया दा रये।” <verse eid="1KI 8:13" /><verse number="14" style="v" sid="1KI 8:14" />तेबे राजे इस्राएलो री पूरी सभा री तरफा खे मूँ फेरी की तिना खे आशीर्वाद दित्तेया; ओर पूरी सभा खड़ी रई। <verse eid="1KI 8:14" /><verse number="15" style="v" sid="1KI 8:15" />ओर तिने बोलेया, “तन्य ए इस्राएलो रा यहोवा परमेशर! जिने आपणे मुंए ते मेरे बाओ दाऊदो खे ये वचन दित्तेया था ओर आपणे आथो साथे से पूरा कित्तेया, <verse eid="1KI 8:15" /><verse number="16" style="v" sid="1KI 8:16" />‘जेस दिनो ते आऊँ आपणी इस्राएल प्रजा खे मिस्रो ते निकयाल़ी की ल्याया, तदुओ ते मैं केसी इस्राएल गोत्रो रा कोई शईर नि चूणेया, जिदे मेरे नाओं रे रणे खे मन्दर बणाया जाओ; पर मैं दाऊद चूणी ला, ताकि से मेरी इस्राएल प्रजा रा अधिकारी ओ।’ <verse eid="1KI 8:16" /><verse number="17" style="v" sid="1KI 8:17" />मेरे बाओ दाऊदो री ये इच्छा तो थी कि इस्राएलो रे परमेशर यहोवे रे नाओं रा एक मन्दर बणाओ। <verse eid="1KI 8:17" /><verse number="18" style="v" sid="1KI 8:18" />पर यहोवे मेरे बाओ दाऊदो खे बोलेया, ‘ये जो तेरी इच्छा ए कि मेरे नाओं री महिमा करने रिया तँईं एक मन्दर बणाए, एड़ी इच्छा करी की तैं खरा कित्तेया; <verse eid="1KI 8:18" /><verse number="19" style="v" sid="1KI 8:19" />तेबे बी तां से मन्दर नि बनाणा; तेरा जो आपणा पाऊ ऊणा, तेस ई मेरे नाओं रा मन्दर बनाणा।’ <verse eid="1KI 8:19" /><verse number="20" style="v" sid="1KI 8:20" />ये जो वचन यहोवे बोलेया था, तिने से पूरा बी कित्तेया ओर आऊँ आपणे बाओ दाऊदो री जगा पाँदे उठी की, यहोवे रे वचनो रे मुताबिक इस्राएलो री गद्दिया पाँदे विराजमान ए ओर इस्राएलो रे परमेशर यहोवे रे नाओं ते ये मन्दर बणाई राखेया। <verse eid="1KI 8:20" /><verse number="21" style="v" sid="1KI 8:21" />ओर इदे मैं एक जगा तेस सन्दूको खे बणाई राखी, जिदे यहोवे री से वाचा ए, जो तिने म्हारे बुजुर्गा खे मिस्र देशो ते काडणे रे बखते तिना साथे बानी थी।”<verse eid="1KI 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 8:22" />तेबे सुलैमान इस्राएलो री पूरी सभा सामणे यहोवे री बेदिया सामणे खड़ा ऊआ ओर आपणे आथ स्वर्गो रिया तरफा खे फैलाई की बोलेया, “ओ यहोवा! <verse eid="1KI 8:22" /><verse number="23" style="v" sid="1KI 8:23" />ओ इस्राएलो रे परमेशर! तां जेड़ा ना तो ऊबे स्वर्गो दे ओर ना थाले तरतिया पाँदे कोई परमेशर ए, तेरे जो दास आपणे पूरे मनो ते आपू खे तां सामणे जाणी की हांडोए, तिना खे तूँ आपणी वाचा पूरी करेया ओर करूणा करदा रएया।” <verse eid="1KI 8:23" /><verse number="24" style="v" sid="1KI 8:24" />जो वचन तैं मेरे बाओ दाऊदो खे दित्तेया था, तेतेरा तैं पालण करी राखेया, जेड़ा तैं आपणे मुंए ते बोलेया था, तेड़ा ई से आपणे आथो साथे पूरा कित्तेया, जेड़ा कि आज ए। <verse eid="1KI 8:24" /><verse number="25" style="v" sid="1KI 8:25" />इजी री खातर एबे ओ इस्राएलो रे यहोवा परमेशर! एस वचनो खे बी पूरा कर, जो तैं आपणे दास मेरे बाओ दाऊदो खे दित्तेया था, तेरे कुलो दे, मां सामणे इस्राएलो री गद्दिया पाँदे बैठणे वाल़े सदा बणे दे रणे, इतणा ओ कि जिंयाँ तूँ आपू खे मां सामणे जाणी की चलदा रया, तिंयाँ ई तेरे कुलो रे लोक आपणे चाल चलणो दे एड़ी चौकसी करो। <verse eid="1KI 8:25" /><verse number="26" style="v" sid="1KI 8:26" />इजी री खातर एबे ओ इस्राएलो रे परमेशर आपणा जो वचन तैं आपणे परोसे जोगे दास मेरे बाओ दाऊदो खे दित्तेया था तेतेखे सच्चा सिद्ध कर।<verse eid="1KI 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 8:27" />क्या परमेशरो सच्ची तरतिया पाँदे वास करना, सर्गो दे, बल्कि ऊबे स्वर्गो दे बी तूँ नि समांदा, तेबे मेरे बणाए रे एस मन्दरो दे किंयाँ समाणा? <verse eid="1KI 8:27" /><verse number="28" style="v" sid="1KI 8:28" />तेबे बी ओ मेरे यहोवा परमेशर! आपणे दासो री प्रार्थना ओर गिड़गिड़ाणे रिया तरफा खे कान लगा, मेरा चींगणा ओर ये प्रार्थना सुण! जो आज आऊँ तां सामणे करने लगी रा; <verse eid="1KI 8:28" /><verse number="29" style="v" sid="1KI 8:29" />तेरी आख एस मन्दरो रिया तरफा खे रात दिन खुली दी रओ जेते जगा रे बारे दे बोलेया, “मेरा नाओं तेथी रणा,” ताकि जो प्रार्थना तेरा दास एसा जगा रिया तरफा खे करो, तिजी खे तूँ सुणी लो। <verse eid="1KI 8:29" /><verse number="30" style="v" sid="1KI 8:30" />ओर तूँ आपणे दास ओर आपणी इस्राएली प्रजा री प्रार्थना जेतेखे सेयो एसा जगा रिया तरफा खे गिड़गिड़ाई की करो से सुणनी, बल्कि स्वर्गो ते जो तेरी रणे री जगा ए सुणी लया ओर सुणी की माफ करना। <verse eid="1KI 8:30" /><verse number="31" style="v" sid="1KI 8:31" />जेबे कोई माणूं केसी दूजे माणूंए रा अपराध करो ओर तेसखे कसम खुल़ाई जाओ ओर से आई की एस मन्दरो दे तेरी बेदिया सामणे कसम खाओ, <verse eid="1KI 8:31" /><verse number="32" style="v" sid="1KI 8:32" />तेबे तूँ स्वर्गो ते सुणी की, मतलब आपणे दासो रा न्याय करी की दुष्टो खे दुष्ट ठईरा ओर तेसरी चाल तेसरे ई सिरो पाँदे वापस करी दे ओर निर्दोषो खे निर्दोष ठराई की, तेसरे तर्मो रे मुताबिक तेसखे फल देणा। <verse eid="1KI 8:32" /><verse number="33" style="v" sid="1KI 8:33" />तेबे जेबे तेरी प्रजा इस्राएल तेरे खलाफ पाप करने रिया बजअ ते आपणे दुश्मणा ते आरी जाओ ओर तेरी तरफा खे फिरी की तेरा नाओं लओ ओर एते मन्दरो दे आई की तांते गिड़गिड़ाई की प्रार्थना करो, <verse eid="1KI 8:33" /><verse number="34" style="v" sid="1KI 8:34" />तेबे तैं स्वर्गो ते सुणी की आपणी इस्राएली प्रजा रा पाप माफ करना: ओर सेयो एते देशो दे वापस लई आऊणे, जो तैं तिना रे बुजुर्गा खे दित्तेया था। <verse eid="1KI 8:34" /><verse number="35" style="v" sid="1KI 8:35" />फेर जेबे सेयो तेरे खलाफ पाप करो ओर इजी बजअ ते सर्ग बन्द ऊई जाओ, ताकि बर्खा नि ओ, एड़े बखते जे सेयो एसा जगा रिया तरफा खे प्रार्थना करी की तेरे नाओं खे मानो जेबे तूँ तिना खे दु:ख देया ओर सेयो पापो ते फिरो, तो तैं स्वर्गो दे सुणी की माफ करना, <verse eid="1KI 8:35" /><verse number="36" style="v" sid="1KI 8:36" />ओर आपणे दासा खे, आपणी इस्राएली प्रजा रा पाप माफ करना; तूँ जो तिना खे खरी बाट दखाएया, जेते पाँदे तिना खे चलणा चाईयो, इजी री खातर आपणे एस देशो पाँदे, जो तैं आपणी प्रजा रा इस्सा करी ता रा, पाणी बरसायी देया। <verse eid="1KI 8:36" /><verse number="37" style="v" sid="1KI 8:37" />जेबे एते देशो दे अकाल़, मरी, झुलस ओ या गेरुई या टिड्डिया या कीड़े लगो या तिना रे दुश्मण तिना रे देशो रे बड़े द्वारो गे तिना खे केरी देयो या कोई बमारी या मुसीबत कऊँ नि ओ, <verse eid="1KI 8:37" /><verse number="38" style="v" sid="1KI 8:38" />तेबे जे कोई माणूं या तेरी इस्राएली प्रजा रे लोक ये जाणी की कि तिने पाप करी राखेया, सेयो तेरे मन्दरो रिया तरफा खे आथ चको ओर गिड़गिड़ाई की प्रार्थना करो, <verse eid="1KI 8:38" /><verse number="39" style="v" sid="1KI 8:39" />तो तैं आपणे स्वर्गो दे रणे रिया जगा ते सुणी की माफ करना ओर एड़ा करना कि एकी-एकी रे मनो खे जाणी की तेसरी सारी चाला रे मुताबिक तेसखे फल देणा। तूँ ई तो सारे माणूंआ रे मनो रा पेत जाणने वाल़ा ए। <verse eid="1KI 8:39" /><verse number="40" style="v" sid="1KI 8:40" />तेबे सेयो जितणे दिन तक एते देशो दे रओ, जो तैं तिना रे बुजुर्गा खे दित्तेया था, तितणे दिना तक तेरा डर मानदे रओ। <verse eid="1KI 8:40" /><verse number="41" style="v" sid="1KI 8:41" />फेर परदेशी बी जो तेरी प्रजा इस्राएलो रा नि ओ, जेबे से तेरा नाओं सुणी की दूर देशो ते आओ, <verse eid="1KI 8:41" /><verse number="42" style="v" sid="1KI 8:42" />से तो तेरे बड़े नाओं, ओर तेरी सामर्थ ओर तेरी तागती रे बारे दे सुणी की; इजी री खातर जेबे एड़ा कोई आई की एस मन्दरो रिया तरफा खे प्रार्थना करो, <verse eid="1KI 8:42" /><verse number="43" style="v" sid="1KI 8:43" />तेबे तैं आपणे स्वर्गो दे रणे रिया जगा ते सुणना ओर जेसा गल्ला खे एड़ा परदेशी ताखे आका पाओ, तेतेरे ई मुताबिक बर्ताओ करना जेते कि तरतिया रे सारे देशो रे लोक तेरा नाओं जाणी की तेरी इस्राएली प्रजा जेड़े तेरा डर मानो ओर पक्का जाणी लो कि ये मन्दर जो मैं बणाई राखेया, से तेरा ईए। <verse eid="1KI 8:43" /><verse number="44" style="v" sid="1KI 8:44" />जेबे तेरी प्रजा रे लोक जेती केथी तूँ तिना खे पेजे, तेथी आपणे दुश्मणा साथे लड़ाई करने खे निकल़ो ओर एस शईरो रिया तरफा खे, जो तैं चूणी राखेया, जो मैं तेरे नाओं पाँदे बणाई राखेया, यहोवे ते प्रार्थना करो, <verse eid="1KI 8:44" /><verse number="45" style="v" sid="1KI 8:45" />तेबे तैं स्वर्गो ते तिना री प्रार्थना ओर गिड़गिड़ाणा सुणी की तिना रा न्याय करना। <verse eid="1KI 8:45" /><verse number="46" style="v" sid="1KI 8:46" />निष्पाप कोई माणूं नि ए, जे यो बी तेरे खलाफ पाप करो ओर तूँ तिना पाँदे कोप करी की तिना खे दुश्मणा रे आथो रे करी दे ओर सेयो तिना खे बन्दी बणाई की आपणे देशो खे चाए से दूर ओ, चाए नेड़े लई जाओ, <verse eid="1KI 8:46" /><verse number="47" style="v" sid="1KI 8:47" />ओर जे सेयो गुलामिया रे देशो दे सोच-बिचार करो ओर फिरी की आपणे गुलामिया रे देशो दे गिड़गिड़ाई की बोलो, आसे पाप करी राखेया ओर बुराई ओर दुष्टता करी राखी; <verse eid="1KI 8:47" /><verse number="48" style="v" sid="1KI 8:48" />ओर जे सेयो आपणे तिना दुश्मणा रे देशो दे जो तिना खे बन्दी बणाई की लईगे ओ, आपणे पूरे मन ओर पूरे प्राणो साथे तेरी तरफा खे फिरो ओर आपणे एस देशो रिया तरफा खे जो तैं तिना रे बुजुर्गा खे दित्तेया था ओर एस शईरो रिया तरफा खे जो तैं चूणी राखेया ओर एस मन्दरो रिया तरफा खे जो मैं तेरे नाओं रा बणाई राखेया, तांते प्रार्थना करो, <verse eid="1KI 8:48" /><verse number="49" style="v" sid="1KI 8:49" />तेबे तैं आपणे स्वर्गो दे रणे रिया जगा ते तिना री प्रार्थना ओर गिड़गिड़ाणा सुणना; ओर तिना रा न्याय करना, <verse eid="1KI 8:49" /><verse number="50" style="v" sid="1KI 8:50" />आपणे लोका रे सबी पापा खे माफ करी दे ओर तूँ आपणे खलाफो दे ऊए दे पापा खे माफ करी की तिना रे दुश्मणा खे तिना रिया तँईं दयालु बणा। <verse eid="1KI 8:50" /><verse number="51" style="v" sid="1KI 8:51" />कऊँकि सेयो तेरे आपणे नीज पाअग ओर तेरे आपणे लोक ए जिना खे तूँ मानो लोए री पट्ठिया बीचा ते, मतलब मिस्र देशो ते निकयाल़ी की ल्याई राखेया। <verse eid="1KI 8:51" /><verse number="52" style="v" sid="1KI 8:52" />इजी री खातर तेरिया आखी तेरे दासो रे गिड़गिड़ाणे ओर तेरी प्रजा इस्राएलो रे गिड़गिड़ाणे रिया तरफा खे खुली रिया रओ, ताकि जेबे-जेबे सेयो ताखे आका पाओ, तेबे-तेबे तूँ तिना री सुणी लो। <verse eid="1KI 8:52" /><verse number="53" style="v" sid="1KI 8:53" />कऊँकि तूँ ओ प्रभु यहोवा आपणे तेस वचनो रे मुताबिक, जो तैं म्हारे बुजुर्गा खे मिस्रो ते काडणे रे बखते आपणे दास मूसे रे जरीये दित्तेया था, तैं इना लोका खे आपणा निज इस्सा ऊणे खे तरतिया री सारी जातिया ते लग करी राखेया।<verse eid="1KI 8:53" /></para>
  <para style="s">सुलैमानो रा आशीर्वाद</para>
  <para style="p">
    <verse number="54" style="v" sid="1KI 8:54" />सुलैमान आपणे जानूआ रे पारे यहोवे रे सामणे ऊआ ओर आथ स्वर्गो रिया तरफा खे चकी की प्रार्थना कित्ती। प्रार्थना करने ते बाद सुलैमान खड़ा ऊआ, <verse eid="1KI 8:54" /><verse number="55" style="v" sid="1KI 8:55" />ओर खड़े ऊई की सारी इस्राएली सभा खे ऊच्ची आवाजा दे ये बोली की आशीर्वाद दित्तेया, <verse eid="1KI 8:55" /><verse number="56" style="v" sid="1KI 8:56" />“तन्य ए यहोवा, जिने ठीक आपणे कईणे रे मुताबिक आपणी इस्राएली प्रजा खे राम दित्तेया, जितणी पलाईया रिया गल्ला तिने आपणे दास मूसे रे जरीये बोलिया थिया, तिना बीचा ते एक बी गल्ल बिना पूरी ऊए नि रई। <verse eid="1KI 8:56" /><verse number="57" style="v" sid="1KI 8:57" />म्हारा यहोवा परमेशर जिंयाँ म्हारे बुजुर्गा साथे रओ था, तिंयाँ ई आसा साथे बी रओ, से आसा खे छाडो नि ओर ना ई आसा खे त्यागो। <verse eid="1KI 8:57" /><verse number="58" style="v" sid="1KI 8:58" />से म्हारे मन आपणी तरफा खे एड़े फिराओ कि आसे तेसरी सारी बाटा दे चलदे रऊँ ओर तेसरी आज्ञा ओर बिदिया ओर नियम जो तिने म्हारे बुजुर्गा खे दित्ते थे, सदा मानेया करुँ। <verse eid="1KI 8:58" /><verse number="59" style="v" sid="1KI 8:59" />ओर मेरिया यो गल्ला जिना री मैं यहोवे रे सामणे बिनती करी राखी, सेयो रात-दिन म्हारे परमेशर यहोवे रे मनो रे बणिया रिया रओ ओर जेड़ी हर दिन जरूरत ओ, तेड़ा ई से आपणे दासो रा ओर आपणी प्रजा इस्राएलो रा बी न्याय करेया करो, <verse eid="1KI 8:59" /><verse number="60" style="v" sid="1KI 8:60" />ओर इजी ते तरतिया रिया सारिया जातिया ये जाणी लओ कि यहोवा ई परमेशर ए; ओर कोई दूजा नि ए। <verse eid="1KI 8:60" /><verse number="61" style="v" sid="1KI 8:61" />तो तुसा रा मन म्हारे परमेशर यहोवे दे एड़ा पूरी रीतिया ते लगेया रा रओ, ताकि जेड़े आज तेसरी बिदिया ओर आज्ञा पाँदे हांडोए, तेड़े ई बादो ते बी मानदे रओ।”<verse eid="1KI 8:61" /></para>
  <para style="s">मन्दरो री प्रतिष्ठा</para>
  <para style="p">
    <verse number="62" style="v" sid="1KI 8:62" />तेबे राजा सारे इस्राएली लोका समेत यहोवे रे सामणे मेलबलि चढ़ाणे लगेया। <verse eid="1KI 8:62" /><verse number="63" style="v" sid="1KI 8:63" />ओर सुलैमाने जो डांगर यहोवे खे मेलबलि करी की चढ़ाए, सेयो 22,000 बल़द ओर 120,000 पेडा थिया। ईंयाँ राजे सारे इस्राएली लोका समेत यहोवे रे मन्दरो री प्रतिष्ठा कित्ती। <verse eid="1KI 8:63" /><verse number="64" style="v" sid="1KI 8:64" />तेस दिने राजे यहोवे रे मन्दरो रे सामणे वाल़े आँगणो बीचे बी एक जगा पवित्र कित्ती ओर होमबलि ओर नज्जो री बलि ओर मेलबलिया री चर्बी तेथी चढ़ाई; कऊँकि जो पीतल़ी री बेदी यहोवे सामणे थी, से तिना खे छोटी थी। <verse eid="1KI 8:64" /><verse number="65" style="v" sid="1KI 8:65" />सुलैमाने ओर तेस साथे सारे इस्राएलो री एक बड़ी सभा ते बाद साता दिना तक चूँगड़िया रा त्यार बणाया जेतेरिया तँईं उत्तर दिशा दे हमातो रिया काट्टिया ते लई की दक्खणा दे मिस्रो रे नाल़े तक रे सारे देशो ते कट्ठी ऊई थी, दो अफ़्ते तक, मतलब चौदा दिन तक म्हारे परमेशर यहोवे सामणे त्योआर मनाया। <verse eid="1KI 8:65" /><verse number="66" style="v" sid="1KI 8:66" />तेबे आगले दिने तिने प्रजा रे लोक बिदा कित्ते ओर सेयो राजे खे तन्य, तन्य, बोली की तेसा सारी पलाईया रिया बजअ ते जो यहोवे आपणे दास दाऊदो साथे ओर आपणी प्रजा इस्राएलो साथे कित्ती थी, खुश ओर मगन ऊई की आपणे-आपणे डेरेया खे चली गे।<verse eid="1KI 8:66" /></para>
  <chapter eid="1KI 8" />
  <chapter number="9" style="c" sid="1KI 9" />
  <para style="s">सुलैमानो खे यहोवे रा दूजा दर्शण</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 9:1" />जेबे सुलैमान यहोवे रे मन्दर ओर राजमईलो खे बणाई चुकेया ओर जो कुछ से करना चाओ था, तिजी खे पूरा करी चुकेया, <verse eid="1KI 9:1" /><verse number="2" style="v" sid="1KI 9:2" />तेबे यहोवे जिंयाँ तेसखे गिबोन जगा दे दर्शण दित्तेया था, तिंयाँ ई दूजी बार बी तेसखे दर्शण दित्तेया। <verse eid="1KI 9:2" /><verse number="3" style="v" sid="1KI 9:3" />ओर यहोवे तेसखे बोलेया, “जो प्रार्थना तैं गिड़गिड़ाई की मांते कित्ती थी, से मैं सुणी, ये मन्दर जो तैं बणाई राखेया, तिदे मैं आपणा नाओं सदा खे राखी की से पवित्र करी राखेया ओर मेरिया आखी ओर मेरा मन सदा तेथी लगेया दा रणा। <verse eid="1KI 9:3" /><verse number="4" style="v" sid="1KI 9:4" />ओर जे तूँ आपणे बाओ दाऊदो जेड़ा मनो री सच्चाईया ओर सीदे सबाओ ते आपू खे मां सामणे जाणी की चलदा रये ओर मेरी सारी आज्ञा रे मुताबिक करेया करे ओर मेरी बिदिया ओर नियम मानदा रये, तो मां तेरा राज्य इस्राएलो पाँदे सदा बणाई की राखणा; <verse eid="1KI 9:4" /><verse number="5" style="v" sid="1KI 9:5" />जेड़ा कि मैं तेरे बाओ दाऊदो खे वचन दित्तेया था, ‘तेरे कुलो दे इस्राएलो री गद्दिया पाँदे विराजणे वाल़े सदा बणे दे रणे।’ <verse eid="1KI 9:5" /><verse number="6" style="v" sid="1KI 9:6" />पर जे तुसे लोक ओर तुसा रे कुलो रे लोक मां पीछे चलणा छाडी देयो ओर मेरी तिना आज्ञा ओर नियमा खे जो मैं तुसा खे देई राखे, मानो नि ओर जाई की पराये देवतेया री आराधना करो ओर तिना गे माथा टेकणे लगो, <verse eid="1KI 9:6" /><verse number="7" style="v" sid="1KI 9:7" />तो मां इस्राएल तेस देशो ते जो मैं तिना खे देई राखेया, बाडी देणे ओर ये मन्दर जो मैं आपणे नाओं खे पवित्र करी राखेया, आपणी नजरा ते गिराई देणा ओर सारे देशा रे लोका बीचे इस्राएलो री उपमा देया करनी ओर उदारण बोलेया करना। <verse eid="1KI 9:7" /><verse number="8" style="v" sid="1KI 9:8" />ओर ये मन्दर जो ऊच्चे पाँदे रणा, तो जो कोई एतेरे नेड़े चलेया करोगा, से हैरान ऊणा ओर चाड़िया बजाणियां ओर तिना पूछणा, ‘यहोवे एस देशो साथे ओर मन्दरो साथे एड़ा कऊँ कित्तेया;’ <verse eid="1KI 9:8" /><verse number="9" style="v" sid="1KI 9:9" />तेबे लोका बोलणा कि तिने आपणे परमेशर यहोवे खे जिने तिना रे बुजुर्ग मिस्र देशो ते निकयाल़ी की ल्याये थे, त्यागी की पराये देवते पकड़ी ले ओर तिना गे माथा टेकेया ओर तिना री आराधना कित्ती, इजी बजअ ते यहोवे ये सारी मुसीबत तिना पाँदे ल्याई।”<verse eid="1KI 9:9" /></para>
  <para style="s">सुलैमानो रा हीरामो साथे समजौता</para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 9:10" />सुलैमानो खे तो यहोवे रे मन्दर ओर राजमईल बनाणे खे बीइ साल लगी गे। <verse eid="1KI 9:10" /><verse number="11" style="v" sid="1KI 9:11" />तेबे सुलैमाने सोर देशो रे राजा हीरामो खे जिने तेसखे मनमाने देवदार ओर केली री लकड़ी ओर सूईना दित्तेया था, गलील देशो दे बीइ शईर दित्ते। <verse eid="1KI 9:11" /><verse number="12" style="v" sid="1KI 9:12" />जेबे हीरामे सोरो ते जाई की सेयो शईर देखे, जो सुलैमाने तेसखे दित्ते थे, तेबे सेयो तेसखे ठीक नि लगे। <verse eid="1KI 9:12" /><verse number="13" style="v" sid="1KI 9:13" />तेबे हीरामे सुलैमानो खे बोलेया, “ओ मेरे पाई, यो केड़े शईर तैं माखे देई राखे?” ओर तिने तिना शईरा रा नाओं कबूल<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="fq" closed="false">कबूल </char><char style="ft" closed="false">बेकार </char></note> देश राखेया ओर ये ई नाओं आजके दिन तक पड़ेया राए। <verse eid="1KI 9:13" /><verse number="14" style="v" sid="1KI 9:14" />तेबे हीरामे राजे गे लगभग 4,000 किलो<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="fq" closed="false">4,000 किलो </char><char style="ft" closed="false">120 किक्कार </char></note> सूईना पेजेया था।<verse eid="1KI 9:14" /></para>
  <para style="s">सुलैमानो रे ओर काम</para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 9:15" />राजा सुलैमाने तिना लोका खे जो काम करने खे राखे थे, तिजी रा मतलब ये था कि सेयो यहोवे रा ओर राजा सुलैमानो रा मईल बणाओ ओर मिल्लो शईर ओर यरूशलेम शईरो री दवाल ओर हासोर, मगिद्दो ओर गेजेर शईरा खे मजबूत करो। <verse eid="1KI 9:15" /><verse number="16" style="v" sid="1KI 9:16" />गेजेर शईरो पाँदे मिस्रो रे राजे फिरौने अमला करी की से लई ला ओर आग लगाई की फूकी ता ओर तेस शईरो दे रणे वाल़े कनानी लोक काईते, ओर तिने से शईर आपणी बेटी जो सुलैमानो री लाड़ी थी, तेसा रा निज इस्सा करी की दित्तेया था, <verse eid="1KI 9:16" /><verse number="17" style="v" sid="1KI 9:17" />तेबे सुलैमाने गेजेर ओर थालला बेथोरोन, <verse eid="1KI 9:17" /><verse number="18" style="v" sid="1KI 9:18" />बालात ओर तदमोर शईर जो यहूदा प्रदेशो रिया उजाड़ जगा दे ए, मजबूत कित्ते, यो तो तिना रे ई देशो दे ए। <verse eid="1KI 9:18" /><verse number="19" style="v" sid="1KI 9:19" />सुलैमान राजे सेयो शईर बी बणाए जेती से कई ओर चीजा खे पण्डार बणाई सको था ओर तिने आपणे रथा ओर कोड़ेया खे बी जगा बणाई। सुलैमाने ओर बी बऊत जिया चीजा बणाईया जिना खे से यरूशलेम शईरो दे, लबानोन ओर आपणे कब्जे वाल़े तिना सबी जगा दे चाओ था। <verse eid="1KI 9:19" /><verse number="20" style="v" sid="1KI 9:20" />देशो दे एड़े लोक बी थे जो इस्राएली नि थे पर इस्राएलो दे रओ थे। सेयो एमोरी, हित्ती, परिज्जी, हिब्बी ओर यबूसी जातिया रे लोक थे, <verse eid="1KI 9:20" /><verse number="21" style="v" sid="1KI 9:21" />पर तिना रे कुल जो तिना ते बाद देशो दे रयी गे ओर जिना खे इस्राएली नाश नि करी सके, सेयो सुलैमाने दास बणाई की सेवा रे कामो पाँदे राखी ते ओर आजो तक तिना री सेई दशा ए। <verse eid="1KI 9:21" /><verse number="22" style="v" sid="1KI 9:22" />पर इस्राएली लोका बीचा ते सुलैमाने कोई बी दास नि बणाया; सेयो तो योद्धा ओर तेसरे कर्मचारी, तेसरे परदान, तेसरे सरदार ओर तेसरे रथ ओर सवारा रे परदान थे।<verse eid="1KI 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 9:23" />जो खास बड़े परदान सुलैमानो रे कामो पाँदे रयी की काम करने वाल़ेया पाँदे राज करो थे, सेयो 550 थे।<verse eid="1KI 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 9:24" />जेबे फिरौनो री बेटी दाऊदो रे शईरो ते आपणे तेस मईलो खे आईगी, जो सुलैमाने तेसा खे बणाया था तेबे तिने मिल्लो बणाया। <verse eid="1KI 9:24" /><verse number="25" style="v" sid="1KI 9:25" />सुलैमान तेसा बेदिया पाँदे जो तिने यहोवे खे बणाई थी, हर साल तीन बार होमबलि ओर मेलबलि चढ़ाया करो था ओर साथे ई तेसा बेदिया पाँदे जो यहोवे सामणे थी, तूप बाल़ेया करो था, ईंयाँ तिने से मन्दर बणाई की त्यार कित्तेया। <verse eid="1KI 9:25" /><verse number="26" style="v" sid="1KI 9:26" />तेबे सुलैमान राजे एस्योनगेबेर शईरो दे जो एदोम देशो रे लाल समुद्रो रे कनारे एलोत शईरो रे नेड़े ए, बऊत जे जाह्ज बणाए। <verse eid="1KI 9:26" /><verse number="27" style="v" sid="1KI 9:27" />ओर जाह्जा दे राजा हीरामे आपणे मल्लाह खे, जो समुद्रो री जानकारी राखो थे, सुलैमानो रे सेवका साथे पेजी ते। <verse eid="1KI 9:27" /><verse number="28" style="v" sid="1KI 9:28" />तिने ओपीर शईरो खे जाई की तेथा ते लगभग 16,000 किलो सूईना,<note caller="+" style="f"><char style="fr" closed="false">9:28 </char><char style="ft" closed="false">420 किक्कार सूईना </char></note> सुलैमान राजे खे ल्याई की दित्तेया।<verse eid="1KI 9:28" /></para>
  <chapter eid="1KI 9" />
  <chapter number="10" style="c" sid="1KI 10" />
  <para style="s">शेबा री राणिया रे जरिये सुलैमानो री तारीफ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 10:1" />जेबे शेबा देशो री राणिये यहोवे रे नाओं रे बारे दे ओर सुलैमानो री कीर्ति सुणी, तेबे से कठण-कठण प्रश्ना ते तेसरी परीक्षा करने यरूशलेम शईरो खे चली पड़ी। <verse eid="1KI 10:1" /><verse number="2" style="v" sid="1KI 10:2" />से तो बऊत पारी दला साथे मसाला, ओर बऊत सूईना ओर मणिया साथे लदे रे ऊँट साथे लई की यरूशलेम शईरो खे आई ओर सुलैमानो गे पऊँची की आपणे मनो री सारिया गल्ला रे बारे दे तेस साथे गल्ला करने लगी। <verse eid="1KI 10:2" /><verse number="3" style="v" sid="1KI 10:3" />सुलैमान राजे तेसा रे सारे प्रश्ना रे ज्वाब दित्ते, तेसा रा एड़ा कोई बी प्रश्न नि था जेतेरा ज्वाब सुलैमाने तेसा खे नि दित्तेया ओ।<verse eid="1KI 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 10:4" />जेबे शेबा री राणिये सुलैमानो री सारी अक्लमंदी, ओर तेसरा बणाया रा मईल ओर तेसरे मेजो पाँदला खाणा देखेया, <verse eid="1KI 10:4" /><verse number="5" style="v" sid="1KI 10:5" />ओर तेसे ये बी देखेया कि तेसरे कर्मचारी मिली की रओए। तेसे मईलो दे तेसरे सेवा-टईल करने वाल़े ओर तिना रे बांके टाल्ले जो तिने पईनी राखे थे, सेयो बी देखे। तेसे तेसरा खाणे-पीणे रा तरीका ओर यहोवे रे मन्दरो दे चढ़ावे ओर बलि बी देखे ओर किंयाँ सेयो ऊबे चढ़ाई चढ़ी की मन्दरो दे जाओए देखेया। इना सबी खे देखी कि से बऊत ई हैरान ऊईगी। <verse eid="1KI 10:5" /><verse number="6" style="v" sid="1KI 10:6" />तेबे तेसे राजे खे बोलेया, “तेरे काम ओर अक्ला री जो कीर्ति मैं आपणे देशो रे सुणी थी से सच्च ए। <verse eid="1KI 10:6" /><verse number="7" style="v" sid="1KI 10:7" />पर जदुओ तक मैं आपू ई आपणिया आखी साथे नि देखेया, तदुओ तक मैं तिना गल्ला पाँदे परोसा नि कित्तेया, बल्कि एत्तेरा आदा बी मांगे नि बताया था; तेरी बुद्धि ओर कल्याण तेसा कीर्तिया ते बी बढ़ी की ए, जो मैं सुणी थी। <verse eid="1KI 10:7" /><verse number="8" style="v" sid="1KI 10:8" />तन्य ए तेरे माणूं! तन्य ए तेरे यो सेवक! जो हर रोज तां सामणे आजीर रयी की तेरी बुद्धिया रिया गल्ला सुणोए। <verse eid="1KI 10:8" /><verse number="9" style="v" sid="1KI 10:9" />तन्य ए तेरा यहोवा परमेशर! जो तांते एड़ा खुश ऊआ कि तूँ इस्राएलो री राजगद्दिया पाँदे बठयाल़ेया, यहोवा इस्राएलो साथे सदा प्यार राखोआ, इजी बजअ ते तिने तूँ न्याय ओर तर्म करने खे राजा बणाया।”<verse eid="1KI 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 10:10" />तेबे तेसे राजे खे लगभग 4,000 किलो सूईना, बऊत सारा खुशबूदार द्रव्य ओर मणि दित्ते; जितणा खुशबूदार द्रव्य शेबा री राणिये सुलैमान राजे खे दित्तेया, तीतणा फेर कदी नि आया।<verse eid="1KI 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 10:11" />तेबे हीरामो रे जाह्ज बी जो ओपीरो ते सूईना ल्याओ थे, सेयो बऊत सारी चन्दनो री लकड़ी ओर मणि बी ल्याये। <verse eid="1KI 10:11" /><verse number="12" style="v" sid="1KI 10:12" />ओर राजे चन्दनो री लकड़िया ते यहोवे रा मन्दर ओर राजमईलो रे खम्बे ओर गाणेवाल़ेया खे बीणा ओर सारंगिया बणवाईया; एड़ी चन्दनो री लकड़ी आजो तक फेर कदी नि आई ओर ना ई दिखी।<verse eid="1KI 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 10:13" />शेबा री राणिये जो कुछ चाया, सेई सुलैमान राजे तेसा री इच्छा रे मुताबिक तेसा खे दित्तेया, फेर सुलैमान राजे तेसा खे आपणी उदारता ते बऊत कुछ दित्तेया, तेबे से आपणे माणूंआ समेत आपणे देशो खे वापस ऊई गी।<verse eid="1KI 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 10:14" />जो सूईना हर साल सुलैमानो गे पऊँचेया करो था, तेतेरा बजन 25,000 किलो<note caller="+" style="f"><char style="fr" closed="false">10:14 </char><char style="fq" closed="false">25,000 किलो </char><char style="ft" closed="false">666 किक्कार </char></note> था। <verse eid="1KI 10:14" /><verse number="15" style="v" sid="1KI 10:15" />इजी ते जादा सौदागरा ते ओर बपारिया रे लेण-देणो ते ओर अरब देशो रे सारे राजा ओर आपणे देशो रे राज्यपालो ते बी बऊत कुछ मिलो था। <verse eid="1KI 10:15" /><verse number="16" style="v" sid="1KI 10:16" />सुलैमान राजे सूईना कअड़ी की 200 बड़ी-बड़ी ढाला बणवाईया, एकी-एकी ढाली दे लगभग सात-सात किलो सूईना लगेया। <verse eid="1KI 10:16" /><verse number="17" style="v" sid="1KI 10:17" />तेबे तिने सूईना कअड़ी की 300 छोटी ढाला बी बणवाईया, एक-एक छोटी ढाला दे लगभग 1,700 ग्राम<note caller="+" style="f"><char style="fr" closed="false">10:17 </char><char style="fq" closed="false">1,700 ग्राम </char><char style="ft" closed="false">तीन माने </char></note> सूईना लगेया ओर राजे सेयो लबानोनो रा वन नाओं रे मईलो दे रखवाई तिया। <verse eid="1KI 10:17" /><verse number="18" style="v" sid="1KI 10:18" />राजे आथी दाँदो रा एक बड़ा सिंहासन बणवाया ओर खरे कुन्दनो साथे मढ़वाया। <verse eid="1KI 10:18" /><verse number="19" style="v" sid="1KI 10:19" />तेते सिंहासनो दे छे पईड़िया थिया ओर सिंहासनो रा सरयाणा पिछलिया तरफा खे गोल़ था ओर बैठणे री जगा री दोनो तरफा खे टासणा लगी रा था ओर दुँईं टासणे गे एक-एक शेर खड़ेया रा बणी रा था। <verse eid="1KI 10:19" /><verse number="20" style="v" sid="1KI 10:20" />ओर छे पईड़िया रे दुँईं कनारे एक-एक शेर खड़ेया रा बणी रा था, कुल बारा शेर बणी रे थे। केसी राज्य दे एड़ा सिंहासन कदी नि बणेया। <verse eid="1KI 10:20" /><verse number="21" style="v" sid="1KI 10:21" />सुलैमान राजे रे पीणे रे सारे पांडे सूईने रे बणी रे थे ओर लबानोनो रा वन नाओं रे मईलो रे सारे पांडे बी शुद्ध सूईने रे बणी रे थे, चाँदिए रा कोई बी पांडा नि था। सुलैमानो रे दिना दे तिजी री कोई कीमत नि थी। <verse eid="1KI 10:21" /><verse number="22" style="v" sid="1KI 10:22" />कऊँकि समुद्रो दे हीरामो रे जाह्जा साथे राजा बी तर्शीशो दे जाह्ज राखो था ओर तीऊँ-तीऊँ साला तक तर्शीशो रे जाह्ज सूईना, चाँदी, आथी दाँद, बान्दर ओर मोर लई की आओ थे।<verse eid="1KI 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 10:23" />ईंयाँ सुलैमान राजा, तअन ओर बुद्धिया दे तरतिया रे सारे राजेया ते बढ़ी की ऊईगा। <verse eid="1KI 10:23" /><verse number="24" style="v" sid="1KI 10:24" />ओर सारी तरतिया रे लोक तेसरी बुद्धिया री गल्ला सुणने खे जो परमेशरे तेसरे मनो दे पैदा कित्ती थी, सुलैमानो रा दर्शण करना चाओ थे। <verse eid="1KI 10:24" /><verse number="25" style="v" sid="1KI 10:25" />ओर सेयो हर साल आपणी-आपणी पेंट, मतलब चाँदी ओर सूईने रे पांडे, टाल्ले, शस्त्र, खुशबूदार द्रव्य, कोड़े ओर खच्चरा ली आओ थे। <verse eid="1KI 10:25" /><verse number="26" style="v" sid="1KI 10:26" />तेबे सुलैमाने रथ ओर सवार कट्ठे करी ले, तो तेसरे 1,400 रथ ओर 12,000 सवार ऊए, ओर तिने सेयो रथा रे शईरा दे ओर यरूशलेम शईरो दे राजे गे ठराईते। <verse eid="1KI 10:26" /><verse number="27" style="v" sid="1KI 10:27" />सुलैमान राजे चाँदी बऊत ऊणे रिया बजअ ते यरूशलेम शईरो दे एड़ा करी ता जेड़े पात्थर, ओर देवदारो री लकड़ी बऊत ऊणे रिया बजा ते तेतेरी कीमत थालले देशो रे गूलरो री लकड़िया जेड़ी करिती।<verse eid="1KI 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 10:28" />ओर जो कोड़े सुलैमान राखो था, सेयो मिस्रो ते आओ थे ओर राजे रे बपारी तिना खे चूण्ड-चूण्ड करी की ठराए रे दामो रे मुताबिक लया करो थे। <verse eid="1KI 10:28" /><verse number="29" style="v" sid="1KI 10:29" />मिस्र देशो ते एकी रथो री कीमत 600 चाँदिए रे सिक्के ओर एकी कोड़े री कीमत 150 चाँदिए रे सिक्के थी। एस ई दामो रे सेयो हित्ती ओर अरामो रे सारे राजेया खे बी बपारिया रे जरीये आओ थे।<verse eid="1KI 10:29" /></para>
  <chapter eid="1KI 10" />
  <chapter number="11" style="c" sid="1KI 11" />
  <para style="s">सुलैमानो रा पापो दे फसणा</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 11:1" />पर सुलैमान राजा फिरौनो री बेटी ओर कई ओरी परायी जवाणसा साथे, जो मोआबी, अम्मोनी, एदोमी, सीदोनी ओर हित्ती थिया, प्यार करने लगेया। <verse eid="1KI 11:1" /><verse number="2" style="v" sid="1KI 11:2" />पर सेयो तिना जातिया री थिया जिना रे बारे दे यहोवे इस्राएली लोका खे बोलेया था, “तुसे इना बीचे नि जाणा ओर ना ई सेयो तुसा बीचे आओ, तिना तुसा रा मन आपणे देवतेया रिया तरफा खे पक्का फेरना;” तिना रेई प्यारो दे सुलैमान मस्त ऊईगा। <verse eid="1KI 11:2" /><verse number="3" style="v" sid="1KI 11:3" />सुलैमानो रिया 700 राणिया ओर 300 रखैलिया ऊईगिया थिया ओर इने जवाणसे तेसरा मन बह्ईकायी ता। <verse eid="1KI 11:3" /><verse number="4" style="v" sid="1KI 11:4" />तेबे जेबे सुलैमान स्याणा ऊईगा, तेबे तेसरी जवाणसे तेसरा मन पराये देवतेया रिया तरफा खे बह्ईकायी ता ओर जेड़ा सुलैमानो रे बाओ दाऊदो रा मन परमेशर यहोवे रिया तँईं परोसे जोगा था तेड़ा तेसरा मन नि था।<verse eid="1KI 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 11:5" />सुलैमान तो सिदोनो रे लोका री अश्तोरेत नाओं री देवी ओर अम्मोनी जातिया रे मिल्कोम नाओं रे घृणित देवतेया पीछे चलणे लगेया। <verse eid="1KI 11:5" /><verse number="6" style="v" sid="1KI 11:6" />तेबे सुलैमाने से कित्तेया जो यहोवे री नजरा दे बुरा था। तिने आपणे बाओ दाऊदो जेड़ी यहोवे री आज्ञा पूरी तरआ ते नि मानी। <verse eid="1KI 11:6" /><verse number="7" style="v" sid="1KI 11:7" />तिना दिना दे सुलैमाने यरूशलेम शईरो सामणे रे पाह्ड़ो पाँदे मोआबिया रे कमोश नाओं रे घृणित देवते खे ओर अम्मोनिया रे मोलेक नाओं रे घृणित देवते खे एक-एक ऊच्ची जगा बणाई। <verse eid="1KI 11:7" /><verse number="8" style="v" sid="1KI 11:8" />ओर आपणिया सारिया परायी जवाणसा खे बी जो आपणे-आपणे देवतेया खे तूप बाल़ो थिया ओर बलिदान करो थिया, तिने एड़ा ई कित्तेया।<verse eid="1KI 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 11:9" />तेबे यहोवे खे सुलैमानो पाँदे रोष आई गा, कऊँकि तेसरा मन इस्राएलो रे परमेशर यहोवे ते दूर ऊईगा था जिने दो बार तेसखे दर्शण दित्तेया था। <verse eid="1KI 11:9" /><verse number="10" style="v" sid="1KI 11:10" />ओर तिने एसा ई गल्ला रे बारे दे आज्ञा दित्ती थी कि पराये देवतेया पीछे नि चलणा, तेबे बी तिने यहोवे री आज्ञा नि मानी। <verse eid="1KI 11:10" /><verse number="11" style="v" sid="1KI 11:11" />इजी खे यहोवे सुलैमानो खे बोलेया, “तांते जो एड़ा काम ऊई रा ओर मेरी बानी दी वाचा ओर मेरी दित्ती री बिधि तैं पूरी नि कित्ती, इजी बजअ ते मां तेरा राज तांते पक्का छीनी की तेरे एक कर्मचारिये खे देई देणा। <verse eid="1KI 11:11" /><verse number="12" style="v" sid="1KI 11:12" />पर आऊँ तेरे बाओ दाऊदो ते प्यार करुँ था। इजी री खातर जदुए तक तूँ जिऊँदा ए मां तेरा राज्य नि लणा। तेरे मरने ते बाद मां तेरे पाऊए खे सारे राज्य पाँदे राज नि करने देणा। <verse eid="1KI 11:12" /><verse number="13" style="v" sid="1KI 11:13" />तेबे बी मां पूरा राज्य नि छुड़ाणा, पर आपणे दास दाऊदो रिया बजअ ते ओर आपणे चूणे दे यरूशलेम शईरो रिया बजअ ते, मां तेरे पाऊए रे आथो दे एक गोत्र<note caller="+" style="f"><char style="fr" closed="false">11:13 </char><char style="fq" closed="false">एक गोत्र </char><char style="ft" closed="false">यहूदा </char></note> छाडी देणा।”<verse eid="1KI 11:13" /></para>
  <para style="s">सुलैमानो रे दुश्मण</para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 11:14" />तेबे यहोवे सुलैमानो रा एक दुश्मण बणाईता। तेसरा नाओं हदद था जो एदोमी राजवंशो रा था। <verse eid="1KI 11:14" /><verse number="15" style="v" sid="1KI 11:15" />कऊँकि जेबे दाऊद एदोमो दे था ओर योआब सेनापति काये रेया खे माट्टी देणे गया, <verse eid="1KI 11:15" /><verse number="16" style="v" sid="1KI 11:16" />(योआब तो तेती सारे इस्राएली लोका समेत छे मीन्ने तक रया, जदुओ तक कि तिने एदोमो रे सारे मर्द नाश नि करी ते) <verse eid="1KI 11:16" /><verse number="17" style="v" sid="1KI 11:17" />तेस बखते जेबे हदद जो छोटा पाऊ था, आपणे बाओ रे कई एक एदोमी सेवका साथे मिस्रो दे जाणे री इच्छा ते नठी गा। <verse eid="1KI 11:17" /><verse number="18" style="v" sid="1KI 11:18" />ओर सेयो मिद्यान इलाके ते ऊई की पारानो रे रेगिस्तानो खे आए ओर पारानो ते कई मर्दा खे साथे लई की मिस्रो रे फिरौन राजे गे गये ओर फिरौने तेसखे कअर दित्तेया ओर तेसखे रोटी-पाणिये रा इन्तजाम कित्तेया ओर कुछ जमीन बी दित्ती।<verse eid="1KI 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 11:19" />ओर हददो पाँदे फिरौनो री बड़ी दया-दृष्टि ऊई ओर तिने तेसखे आपणी साल़ी मतलब तहपनेस राणिया री बईण ब्यायी ती। <verse eid="1KI 11:19" /><verse number="20" style="v" sid="1KI 11:20" />ओर तहपनेसा री बईणा ते गनूबत पैदा ऊआ ओर एसरा दूद तहपनेसे फरौनो रे मईलो दे छुड़ाया; तेबे गनूबत फिरौनो रे मईलो दे तेसरे ई पाऊआ साथे रओ था। <verse eid="1KI 11:20" /><verse number="21" style="v" sid="1KI 11:21" />जेबे हददे मिस्रो दे रंदे ऊए ये सुणेया कि दाऊद राजा मरीगा ओर योआब सेनापति बी मरीगा, तेबे तिने फिरौनो खे बोलेया, “माखे आज्ञा दे कि आऊँ आपणे देशो खे जाऊँ!” <verse eid="1KI 11:21" /><verse number="22" style="v" sid="1KI 11:22" />फिरौने बोलेया, “कऊँ? मांगे एती ताखे क्या कमी ऊई कि तूँ आपणे देशो खे जाणा चाएया?” तिने ज्वाब दित्तेया, “कोई कमी नि ऊई, तेबे बी माखे जरूर जाणे दे।”<verse eid="1KI 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 11:23" />तेबे परमेशरे राजा सुलैमानो रा एक ओर दुश्मण बणाईता, मतलब एल्यादा रा पाऊ रजोन, से तो आपणे स्वामी सोबा रे राजा हदादेजेरो गे ते नठेया था; <verse eid="1KI 11:23" /><verse number="24" style="v" sid="1KI 11:24" />ओर जेबे राजा दाऊदे सोबा रे माणूं काये, तेबे रजोने आपू गे कई मर्द कट्ठे कित्ते ओर तिना रा परदान बणी गा ओर से दमिश्क शईरो खे जाई की तेथी रणे ओर राज करने लगेया। <verse eid="1KI 11:24" /><verse number="25" style="v" sid="1KI 11:25" />तेस नुकशाणो खे छाडी की जो हददे कित्तेया, रजोन बी, सुलैमानो रा पूरी जिन्दगी दुश्मण बणेया दा रया ओर से इस्राएलो ते नफरत करदा ऊआ अरामो पाँदे राज करो था।<verse eid="1KI 11:25" /></para>
  <para style="s">यारोबामो रा बिद्रोह</para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 11:26" />तेबे नबातो रा पाऊ यारोबाम नाओ रा एक माणूं राजा सुलैमानो रे खलाफ ऊईगा, से सरूयाह नाओं री बिदुआ रा पाऊ था। से एप्रैमी सरेदा शईरो दे रणे वाल़ा था। जो सुलैमानो रा कर्मचारी बी था। <verse eid="1KI 11:26" /><verse number="27" style="v" sid="1KI 11:27" />तेसरा राजे रे खलाफ ऊणे री बजअ ये थी कि सुलैमान मिल्लो खे बनाणे लगी रा था ओर आपणे बाओ दाऊदो रे शईरो री दवाला रिया खीड़ा बन्द करने लगी रा था। <verse eid="1KI 11:27" /><verse number="28" style="v" sid="1KI 11:28" />यारोबाम बड़ा शूरवीर था ओर जेबे सुलैमाने से जवान देखेया कि ये मईणती ए; तेबे तिने से यूसुफो रे कराने रे सारे कामा पाँदे मुखिया ठराया। <verse eid="1KI 11:28" /><verse number="29" style="v" sid="1KI 11:29" />एक दिन यारोबाम यरूशलेम शईरो ते निकल़ी की जाणे लगी रा था कि शीलो शईरो रा रणे वाल़ा अहिय्याह नबी, नवीं चाद्दर टखी की बाटा दे तेसते मिलेया ओर बस सेयो ई दोनो मैदानो दे थे। <verse eid="1KI 11:29" /><verse number="30" style="v" sid="1KI 11:30" />ओर अहिय्याहे आपणी से नवीं चाद्दर लई ली ओर तेसा फाड़ी की बारा टुकड़े करी ते। <verse eid="1KI 11:30" /><verse number="31" style="v" sid="1KI 11:31" />तेबे तिने यारोबामो खे बोलेया, दस टुकड़े लई लो; कऊँकि इस्राएलो रा यहोवा परमेशर ईंयाँ बोलोआ, “सुण, आऊँ राज्य खे सुलैमानो रे आथो ते छीनी की दस गोत्र तेरे आथो दे करी देऊँआ। <verse eid="1KI 11:31" /><verse number="32" style="v" sid="1KI 11:32" />पर मेरे दास दाऊदो रिया बजअ ते ओर यरूशलेम शईरो रिया बजअ ते जो मैं इस्राएलो रे सारे गोत्रा बीचे चूणी राखे, तेसरा एक गोत्र बणेया दा रणा।” <verse eid="1KI 11:32" /><verse number="33" style="v" sid="1KI 11:33" />इजी री बजअ ये कि तिने आऊँ त्यागी की सीदोनिया री देवी अश्तोरेता गे ओर मोआबिया रे देवता कमोशो गे ओर अम्मोनिया रे देवता मिल्कोमो गे माथा टेकेया ओर मेरी बाटा दे नि चलेया ओर जो मेरी नजरा दे ठीक ए, से नि कित्तेया ओर मेरी बिदिया ओर मेरे नियम नि माने, जेड़ा कि तेसरे बाओ दाऊदे कित्तेया। <verse eid="1KI 11:33" /><verse number="34" style="v" sid="1KI 11:34" />तेबे बी मां तेसरे आथो ते पूरा राज्य नि लणा, पर मेरा चूणेया रा दास दाऊद जो मेरी आज्ञा ओर बिदिया मानदा रया, तिजी री बजअ ते मां से पूरी जिन्दगी परदान बणाया दा राखणा। <verse eid="1KI 11:34" /><verse number="35" style="v" sid="1KI 11:35" />पर तेसरे पाऊए रे आथो ते मां राज्य, मतलब दस गोत्र ताखे देई देणे। <verse eid="1KI 11:35" /><verse number="36" style="v" sid="1KI 11:36" />ओर तेसरे पाऊए खे मां एक गोत्र<note caller="+" style="f"><char style="fr" closed="false">11:36 </char><char style="fq" closed="false">एक गोत्र </char><char style="ft" closed="false">यहूदा </char></note> देणा, कऊँकि यरूशलेम मतलब तेस शईरो दे जो आपणा नाओं राखणे खे मैं चूणी राखेया, मेरे दास दाऊदो रा दिऊआ सदा मां सामणे बणेया रा रओ। <verse eid="1KI 11:36" /><verse number="37" style="v" sid="1KI 11:37" />पर मां ताखे तिना सबी पाँदे राज करने देणा जिना खे तूँ चाएया। तां सारे इस्राएल देशो पाँदे राज करना। <verse eid="1KI 11:37" /><verse number="38" style="v" sid="1KI 11:38" />जे तूँ मेरे दास दाऊदो जेड़ा सच्चा-पक्का ओर परोसे वाल़ा बणी की मेरी सारी आज्ञा खे माने ओर मेरी बाटा दे चले ओर जो काम मेरी नजरा दे ठीक ए, सेई करे ओर मेरी बिदिया ओर आज्ञा मानदा रये, तो मां तां साथे रणा ओर जिंयाँ मैं दाऊदो रा कराना बणाई की राखेया, तेड़ा ई तेरा कराना बी बणाई राखूँगा ओर तेरे आथो दे इस्राएलो खे देऊँगा। <verse eid="1KI 11:38" /><verse number="39" style="v" sid="1KI 11:39" />एस पापो रिया बजअ ते मां दाऊदो रे कराने खे सजा देणी, तेबे बी सदा तक नि देणी। <verse eid="1KI 11:39" /><verse number="40" style="v" sid="1KI 11:40" />तेबे सुलैमाने यारोबाम काणा चाया, पर से मिस्रो रे राजा शीशको गे नठी गा ओर सुलैमानो रे मरने तक तेथी रया।<verse eid="1KI 11:40" /></para>
  <para style="s">सुलैमानो री मौत</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 11:41" />सुलैमानो रिया ओर सब गल्ला ओर तेसरे सारे काम ओर तेसरी बुद्धिया रा वर्णन सुलैमानो री इतिआसो री कताबा दे लिखी राखे। <verse eid="1KI 11:41" /><verse number="42" style="v" sid="1KI 11:42" />सुलैमानो खे यरूशलेम शईरो रे सारे इस्राएलो पाँदे राज करदे ऊए चाल़ी साल बीतीगे। <verse eid="1KI 11:42" /><verse number="43" style="v" sid="1KI 11:43" />तेबे सुलैमान मरीगा ओर से तेसरे बाओ दाऊदो रे शईरो रे दबाईता, जेती तेरे बुजुर्ग दबाई राखे थे। ओर तेसरा पाऊ रहूबियाम तेसरी जगा पाँदे राजा बणी गा।<verse eid="1KI 11:43" /></para>
  <chapter eid="1KI 11" />
  <chapter number="12" style="c" sid="1KI 12" />
  <para style="s">इस्राएल राज्य रे दो इस्से ऊई जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 12:1" />रहूबियाम शकेमो खे गया, कऊँकि सारे इस्राएली तेसखे राजा बनाणे खे तेथी गये थे। <verse eid="1KI 12:1" /><verse number="2" style="v" sid="1KI 12:2" />जेबे नबातो रे पाऊ यारोबामे ये सुणेया, जो यबुओ तक मिस्रो दे रओ था, कऊँकि यारोबाम राजा सुलैमानो रे डरो रे मारे तेती नठी की मिस्रो दे चली गा था। <verse eid="1KI 12:2" /><verse number="3" style="v" sid="1KI 12:3" />तो तिने लोके से आपू गे बुलाया, तेबे यारोबाम ओर इस्राएलो री सारी सभा रहूबियामो गे जाई की ईंयाँ बोलणे लगी, <verse eid="1KI 12:3" /><verse number="4" style="v" sid="1KI 12:4" />“तेरे बाओए तो आसा पाँदे पारी बोज राखी राखेया था, तो तूँ आपणे बाओ री कठण सेवा रे कामो खे ओर तेस पारी बोजो खे जो तिने आसा पाँदे राखी राखेया, कुछ अल़्का कर; तेबे आसा तेरे वशो दे ऊई जाणा।”<verse eid="1KI 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 12:5" />तिने इस्राएली लोका खे बोलेया, “यबु तो तुसे जाओ ओर तीन दिन बाद मांगे फेर आऊणा।” तेबे सेयो सब चलीगे। <verse eid="1KI 12:5" /><verse number="6" style="v" sid="1KI 12:6" />तेबे राजा रहूबियामे तिना स्याणेया ते जो तेसरे बाओ सुलैमानो री पूरी जिन्दगी तेस सामणे आजीर रओ थे सला लई, “एसा प्रजा खे केड़ा ज्वाब देणा ठीक ए, इदे तुसे क्या बोलोए?”<verse eid="1KI 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 12:7" />तिने तेसखे ये ज्वाब दित्तेया, “जे तूँ यबु प्रजा रे लोका रा दास बणी की ओर तिना रे वशो दे ऊई की तिना साथे मीठिया गल्ला बोले, तो तिना सदा तेरे वशो दे ऊई की तेरी सेवा करनी।” <verse eid="1KI 12:7" /><verse number="8" style="v" sid="1KI 12:8" />रहूबियामे से सला छाडी ती, जो स्याणेया तेसखे दित्ती थी ओर तिना जवाना ते सला लई जो तेस साथे बड़े ऊए थे ओर तेस सामणे आजीर रया करो थे। <verse eid="1KI 12:8" /><verse number="9" style="v" sid="1KI 12:9" />तिना ते तिने पूछेया, “आऊँ प्रजा रे लोका खे केड़ा ज्वाब देऊँ? तिदे तुसे क्या सला देओए? तिने तो माखे बोली राखेया कि जो बोज तेरे बाओए आसा पाँदे राखी राखेया, तेतेखे तूँ अल़्का कर।” <verse eid="1KI 12:9" /><verse number="10" style="v" sid="1KI 12:10" />तेसरे जवान दोस्ते तेसखे ये ज्वाब दित्तेया, “जिने लोके ताखे बोली राखेया कि तेरे बाओए आसा रिया कांदा पाँदे पारी बोज पाई राखेया था। तूँ तिजी खे आसा रिया तँईं अल़्का कर, तैं तिना खे ईंयाँ बोलणा, जे मेरा बाओ शेर था तो आऊँ सवा शेर ए। <verse eid="1KI 12:10" /><verse number="11" style="v" sid="1KI 12:11" />मेरे बाओए जो तुसा पाँदे पारी बोज राखेया था, से मां ओर बी पारी करना; मेरा बाओ तो तुसा खे कोड़ेया साथे सजा देयो था, पर मां कांडे वाल़े कोड़ेया साथे सजा देणी।” <verse eid="1KI 12:11" /><verse number="12" style="v" sid="1KI 12:12" />तीजे दिने जेड़ा राजे ठराया था कि तीजे दिने फेर मांगे आऊणा, तिंयाँ ई यारोबाम ओर सारी प्रजा रे लोक रहूबियामो गे कट्ठे ऊए। <verse eid="1KI 12:12" /><verse number="13" style="v" sid="1KI 12:13" />तेबे राजे प्रजा साथे कड़क गल्ला कित्तिया, <verse eid="1KI 12:13" /><verse number="14" style="v" sid="1KI 12:14" />ओर स्याणेया री दित्ती री सला छाडी की, जवाना री दित्ती री सला रे मुताबिक तिना खे बोलेया, “मेरे बाओए तो तुसा रा बोज पारी करी ता, पर मां से ओर बी पारी करी देणा, मेरे बाओए तो कोड़ेया साथे तुसा खे सजा दित्ती, पर मां तुसा खे कांडे वाल़े कोड़ेया साथे सजा देणी।”<verse eid="1KI 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 12:15" />इजी बजा ते राजे प्रजा री गल्ल नि मानी, इजी री बजअ ये कि जो वचन यहोवे शीलो दे रणे वाल़े नबी अहिय्याह रे जरीये नबातो रे पाऊ यारोबामो खे बोलेया था, तेतेखे पूरा करने खे तिने एड़ा ठराया था। <verse eid="1KI 12:15" /><verse number="16" style="v" sid="1KI 12:16" />जेबे सारे इस्राएलिये देखेया कि राजा म्हारी नि मानदा, तेबे तिने बोलेया, “दाऊदो रे राज्य दे म्हारा कोई इस्सा नि ए। म्हारा तो यिशै रे पाऊए दे कोई इस्सा नि ए! ओ इस्राएलियो आपणे-आपणे डेरे खे चली जाओ, एबे ओ दाऊद, आपणे ई कराने री फिकर कर।” <verse eid="1KI 12:16" /><verse number="17" style="v" sid="1KI 12:17" />पर रहूबियाम फेर बी तिना इस्राएली लोका पाँदे राज करदा रया, जो यहूदा रे शईरा दे रओ थे। <verse eid="1KI 12:17" /><verse number="18" style="v" sid="1KI 12:18" />तेबे राजे रहूबियामे अदोरामो खे जो सारे काम करने वाल़ेया पाँदे अधिकारी था पेजीता ओर सारे इस्राएलिये तेसखे पात्थर बाये ओर से मरी गा, तेबे रहूबियाम फटाफट आपणे रथो रे चढ़ी की यरूशलेम शईरो खे नठी गा। <verse eid="1KI 12:18" /><verse number="19" style="v" sid="1KI 12:19" />इजी बजअ ते इस्राएली लोक दाऊदो रे कराने ते फिरी गे ओर आजो तक तेसरे खलाफ ए। <verse eid="1KI 12:19" /><verse number="20" style="v" sid="1KI 12:20" />ये सुणी की कि यारोबाम वापस आई गा रा, सारे इस्राएलिये से मण्डल़िया दे बुलाया ओर से पूरे इस्राएली लोका पाँदे राजा नियुक्त कित्तेया ओर यहूदा रे गोत्रो खे छाडी की दाऊदो रे कराने ते कोई मिलेया दा नि रया।<verse eid="1KI 12:20" /></para>
  <para style="s">शमायाह री भविष्यबाणी</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 12:21" />जेबे रहूबियाम यरूशलेम शईरो दे आया, तेबे तिने यहूदा रे पूरे कराने खे ओर बिन्यामीनो रे गोत्रो खे, जो मिलाई की 180,000 अच्छे योद्धा थे, कट्ठे कित्ते, ताकि सेयो इस्राएलो रे कराने साथे लड़ी की सुलैमानो रे पाऊ रहूबियामो रे वशो दे फेर राज्य करो। <verse eid="1KI 12:21" /><verse number="22" style="v" sid="1KI 12:22" />तेबे परमेशरो रा ये वचन परमेशरो रे माणूं शमायाह गे पऊँचेया, यहूदा रे राजा सुलैमानो रे पाऊ रहूबियामो ते, <verse eid="1KI 12:22" /><verse number="23" style="v" sid="1KI 12:23" />ओर यहूदा रे राजा ओर बिन्यामीनो रे सारे कराने ते ओर सारे लोका खे बोल कि यहोवा ईंयाँ बोलोआ, <verse eid="1KI 12:23" /><verse number="24" style="v" sid="1KI 12:24" />“कि आपणे पाई इस्राएलो पाँदे अमला करी की युद्ध नि करो; तुसे आपणे-आपणे कअरो खे वापस ऊई जाओ, कऊँकि ये गल्ल मेरी ई तरफा ते ऊई री।” यहोवे रा ये वचन मानी की सेयो तेसरे मुताबिक वापस जाणे खे आपणी-आपणी बाटा दे गये।<verse eid="1KI 12:24" /></para>
  <para style="s">यारोबामो रा मूर्तिपूजा कराणा</para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 12:25" />तेबे यारोबाम एप्रैमो रे पाह्ड़ी इलाके रे शकेम शईरो खे मजबूत करी की तिदे रणे लगेया, तेबे तेथा ते निकल़ी की पनूएलो खे बी मजबूत कित्तेया। <verse eid="1KI 12:25" /><verse number="26" style="v" sid="1KI 12:26" />तेबे यारोबाम सोचणे लगेया, “एबे राज्य दाऊदो रे कराने रा ऊई जाणा। <verse eid="1KI 12:26" /><verse number="27" style="v" sid="1KI 12:27" />जे प्रजा रे लोक यरूशलेम शईरो दे यहोवे खे बलिदान करने खे जाओ, तो तिना रा मन आपणे स्वामी यहूदा रे राजे रिया तरफा खे फिरी जाणा ओर तिना आऊँ काई देणा ओर सेयो यहूदा रे राजा रहूबियामो रे ऊई जाणे।” <verse eid="1KI 12:27" /><verse number="28" style="v" sid="1KI 12:28" />तेबे यारोबाम राजे सला लई की सूईने रिया दो बाच्छूए री मूर्तिया बणाईया ओर लोका खे बोलेया, “यरूशलेम शईरो खे जाणा तुसा रे वशो ते बारे ए, इजी री खातर ओ इस्राएल आपणे देवतेया खे देखो, जो तुसा खे मिस्र देशो ते निकयाल़ी की ल्याये।” <verse eid="1KI 12:28" /><verse number="29" style="v" sid="1KI 12:29" />तेबे तिने एक बाच्छू बेतेल ओर दूजा दानो रे स्थापित कित्तेया। <verse eid="1KI 12:29" /><verse number="30" style="v" sid="1KI 12:30" />पर ये बऊत बड़ा पाप था, कऊँकि इस्राएलो रे लोके बेतेल ओर दान शईरा री यात्रा बाच्छूआ री पूजा करने रिया तँईं कित्ती। <verse eid="1KI 12:30" /><verse number="31" style="v" sid="1KI 12:31" />तेबे तिने ऊच्ची जगा दे मन्दर बणाए ओर सारे प्रकारा रे लोका बीचे जो लेविया रे कुलो रे नि थे, पुरोईत ठराए। <verse eid="1KI 12:31" /><verse number="32" style="v" sid="1KI 12:32" />तेबे यारोबामे आठुए मीन्ने रे पन्द्रुए दिने यहूदा दे त्योआरो जेड़ा, एक त्योआर ठराईता ओर बेदिया पाँदे बलि चढ़ाणे लगेया; ईंयाँ तिने बेतेलो दे आपणे बणाए रे बाच्छूए री मूर्तिया खे बेदिया पाँदे बलि कित्तेया ओर आपणे बणायी री ऊच्ची जगा रे पुरोईतो खे बेतेलो दे ठराईते। <verse eid="1KI 12:32" /><verse number="33" style="v" sid="1KI 12:33" />जेते मीन्ने रे बारे दे तिने सोचेया था, मतलब आठुए मीन्ने रे पन्द्रुए दिने से बेतेलो दे आपणी बणाई री बेदिया पाँदे चढ़ीगा। तिने इस्राएली लोका खे एक त्योआर ठराईता ओर तूप बाल़ने खे बेदिया गे चढ़ीगा।<verse eid="1KI 12:33" /></para>
  <chapter eid="1KI 12" />
  <chapter number="13" style="c" sid="1KI 13" />
  <para style="s">परमेशरो रे दासो रा सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 13:1" />जेबे यारोबाम बेतेलो री बेदिया पाँदे पेंट चढ़ाणे खे खड़ा ऊआ था, तेबे यहोवे रे वचनो ते आज्ञा पाई की यहूदा प्रदेशो ते परमेशरो रा एक माणूं तेती आया। <verse eid="1KI 13:1" /><verse number="2" style="v" sid="1KI 13:2" />तिने माणूंए यहोवे ते वचन पाई की बेदिया रे खलाफ आका पाई की बोलेया, “बेदी, ओ बेदी! यहोवा ईंयाँ बोलोआ कि सुण, दाऊदो रे कराने दे योशिय्याह नाओं रा एक पाऊ पैदा ऊणा, तेस सेयो ऊच्ची जगा रे पुरोईत जो तांगे तूप बाल़ोए, तां पाँदे बलि करी देणे ओर तां पाँदे माणूंआ री आड्डिया फूकिया जाणिया।” <verse eid="1KI 13:2" /><verse number="3" style="v" sid="1KI 13:3" />ओर तिने तेस ई दिने ये बोली की तेसा गल्ला रा नशाण बी बताया, “ये वचन जो यहोवे बोली राखेया, तेतेरा नशाण ये कि ये बेदी फटी जाणी ओर एते पाँदली स्वा खींडी जाणी।”<verse eid="1KI 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 13:4" />तेबे एड़ा ऊआ कि परमेशरो रे माणूंए रा ये वचन सुणी की जो तिने बेतेलो री वेदिया रे खलाफ आका पाई की बोलेया, राजा यारोबामे वेदिया ते आथ बढ़ाई की बोलेया, “एसखे पकड़ो!” तेबे तेसरा आथ जो तिने तेसरी तरफा खे बढ़ाया था, सूकीगा ओर से तेसखे आपणी तरफा खे खींजी नि सकेया। <verse eid="1KI 13:4" /><verse number="5" style="v" sid="1KI 13:5" />तेबे बेदी फटी गी ओर तेतेरी स्वा खींडी गी; तेबे से नशाण पूरा ऊआ, जो परमेशरो रे माणूंए यहोवे ते वचन पाई की बोलेया था। <verse eid="1KI 13:5" /><verse number="6" style="v" sid="1KI 13:6" />तेबे राजे परमेशरो रे माणूंए ते बोलेया, “आपणे परमेशर यहोवे खे मना ओर मेरिया तँईं प्रार्थना कर कि मेरा आथ जेड़ा था तेड़ा ई ऊई जाओ।” तेबे परमेशरो रे माणूंए यहोवा मनाया ओर राजे रा आथ जेड़ा का तेड़ा ऊईगा। <verse eid="1KI 13:6" /><verse number="7" style="v" sid="1KI 13:7" />तेबे राजे परमेशरो रे माणूंए खे बोलेया, “मां साथे कअरे चली की आपणा जियू ठण्डा कर ओर मां ताखे दान बी देणा।”<verse eid="1KI 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 13:8" />परमेशरो रे माणूंए राजे खे बोलेया, “चाए तूँ माखे आपणा आदा कअर बी दे, तेबे बी मां तेरे कअरे नि जाणा ओर एते जगा रे मां ना तो रोटी खाणी ओर ना पाणी पीणा। <verse eid="1KI 13:8" /><verse number="9" style="v" sid="1KI 13:9" />कऊँकि यहोवे रे वचनो रे जरीये माखे एड़ी आज्ञा मिली री कि ना तो रोटी खाणी ओर ना पाणी पीणा ओर ना तेसा बाटा रिये वापस आऊणा जेते रिये तूँ जाणा।” <verse eid="1KI 13:9" /><verse number="10" style="v" sid="1KI 13:10" />इजी री खातर से तेसा बाटा दे जिदे बेतेल गया था वापस ऊई की दूजी बाटा रिये चली गा।<verse eid="1KI 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 13:11" />बेतेलो दे एक स्याणा नबी रओ था ओर तेसरे माठे आई की तेसते तिना सारे कामो रा वर्णन कित्तेया जो परमेशरो रे माणूंए तेस दिने बेतेलो दे कित्ते थे; ओर जो गल्ला तिने राजे साथे कित्तिया थिया, सेयो बी तिने आपणे बाओ गे बताईया। <verse eid="1KI 13:11" /><verse number="12" style="v" sid="1KI 13:12" />तेसरे माठेया तो ये देखेया था कि परमेशरो रा से माणूं जो यहूदा ते आया था, कुणजी बाटा दे गया, तो तिना रे बाओए तिना ते पूछेया, “से कुणजी बाटा दे गया?” <verse eid="1KI 13:12" /><verse number="13" style="v" sid="1KI 13:13" />तेबे तिने आपणे माठेया खे बोलेया, “मेरिया तँईं गह्दे खे त्यार करो;” तेबे तिने गह्दे पाँदे काठी बानी ओर से तेस पाँदे चढ़ेया, <verse eid="1KI 13:13" /><verse number="14" style="v" sid="1KI 13:14" />ओर परमेशरो रे माणूंए पीछे गया ओर तेसखे से बड़े डाल़ो निठे बैठेया रा मिलेया; तेबे तिने तेसते पूछेया, “परमेशरो रा जो माणूं यहूदा ते आया था, क्या तूँ सेईए?” <verse eid="1KI 13:14" /><verse number="15" style="v" sid="1KI 13:15" />तिने बोलेया, “आ, आऊँ सेईए।” तिने तेसखे बोलेया, “मां साथे कअरे चली की रोटी खा।” <verse eid="1KI 13:15" /><verse number="16" style="v" sid="1KI 13:16" />तिने तेसखे बोलेया, “आऊँ ना तो तां साथे वापस ऊई सकदा ओर ना ई तेरे कअरे जाई सकदा ओर ना ई एते जगा दे तां साथे रोटी खाणी ओर ना पाणी पीणा। <verse eid="1KI 13:16" /><verse number="17" style="v" sid="1KI 13:17" />कऊँकि यहोवे रे वचनो रे जरीये माखे ये आज्ञा मिली री कि तेती ना तो रोटी खाणी ओर ना पाणी पीणा ओर जेते बाटा रिये तूँ जाएगा, तेते रिये फेर वापस नि आऊणा।”<verse eid="1KI 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 13:18" />तिने स्याणे नबीए बोलेया, “जेड़ा तूँ नबी ए तेड़ा ई आऊँ बी नबी ए; ओर मांते एकी दूते यहोवे रा वचन पाई की बोलेया कि तेस माणूंए खे आपू साथे आपणे कअरे वापस ली आओ, ताकि से रोटी खाओ ओर पाणी पियो।” तिने तेसते ये चूठ बोलेया। <verse eid="1KI 13:18" /><verse number="19" style="v" sid="1KI 13:19" />तेबे से तेस साथे वापस ऊईगा ओर तेसरे कअरे रोटी खाई ओर पाणी पिया।<verse eid="1KI 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 13:20" />जेबे सेयो रोटी खाई की मेजो पाँदे बैठे ई थे कि यहोवे रा वचन तेस नबीए गे पऊँचेया, जो दूजे खे वापस ली आया था। <verse eid="1KI 13:20" /><verse number="21" style="v" sid="1KI 13:21" />तिने परमेशरो रे माणूंए खे जो यहूदा ते आया था आका पाई की बोलेया, “यहोवा ईंयाँ बोलोआ कि तैं यहोवे रा वचन नि मानेया ओर जो आज्ञा तेरे यहोवा परमेशरे ताखे दित्ती थी से पनि मानी, <verse eid="1KI 13:21" /><verse number="22" style="v" sid="1KI 13:22" />पर जेसा जगा रे बारे दे परमेशरे ताखे बोलेया था कि तिदे ना तो रोटी खाणी ओर ना पाणी पीणा, तिदे ई तैं वापस आई की रोटी खाई ओर पाणी बी पिया, इजी बजअ ते तूँ तेरे बुजुर्गा रे कब्रिस्तानो दे नि दबाया जाणा।” <verse eid="1KI 13:22" /><verse number="23" style="v" sid="1KI 13:23" />जेबे से खाई-पी चुकेया, तेबे तिने नबीए परमेशरो रे तेस माणूंए खे जेसखे से वापस ली आया था गह्दे पाँदे काठी बणाई। <verse eid="1KI 13:23" /><verse number="24" style="v" sid="1KI 13:24" />जेबे से बाटा दे चलणे लगी रा था तेबे एक शेर तेसखे मिलेया ओर से काई ता ओर तेसरी लोथ बाटा देई पड़ी दी रई ओर गह्दा तेसगे खड़ा रया ओर शेर बी लाशा गे खड़ेया दा रया। <verse eid="1KI 13:24" /><verse number="25" style="v" sid="1KI 13:25" />जो लोक तिसिये चली की आऊणे लगी रे थे ये देखी की कि बाटा दे एक लोथ पड़ी री ओर तेसगे एक शेर खड़ी रा, तेस शईरो दे जाई की जेती स्याणा नबी रओ था ये सन्देश सुणाया। <verse eid="1KI 13:25" /><verse number="26" style="v" sid="1KI 13:26" />ये सुणी की तिने नबीए जो तेसखे बाटा ते वापस ली आया था, बोलेया, “परमेशरो रा सेई माणूं ऊणा, जिने यहोवे रे वचनो रे खलाफ कित्तेया था, इजी बजअ ते यहोवे से शेरो रे पंजे दे पड़ने दित्तेया ओर यहोवे रे तेस वचनो रे मुताबिक जो तिने तेसखे बोलेया था, शेरे से फाड़ी की कायी ता ऊणा।” <verse eid="1KI 13:26" /><verse number="27" style="v" sid="1KI 13:27" />तेबे तिने आपणे माठेया खे बोलेया, “मेरिया तँईं गह्दे पाँदे काठी बानो”, जेबे तिने काठी बानी, <verse eid="1KI 13:27" /><verse number="28" style="v" sid="1KI 13:28" />तेबे तिने बाटा दे तेस माणूंए री लोथ पड़ी दी ओर गह्दा ओर शेर दोनो लाशा गे खड़े दे देखे ओर ये बी कि शेरे ना तो लोथ खाई ओर ना गह्दा फाड़ेया। <verse eid="1KI 13:28" /><verse number="29" style="v" sid="1KI 13:29" />तेबे तिने स्याणे नबीए परमेशरो रे माणूंए री लोथ चकी की गह्दे पाँदे लादी ती ओर तेसरिया तँईं छाती पीटणे लगेया ओर तेसखे दबाणे खे आपणे शईरो दे वापस लईगा। <verse eid="1KI 13:29" /><verse number="30" style="v" sid="1KI 13:30" />ओर तिने तेसरी लोथ आपणे कब्रिस्तानो दे राखी ओर तेसरे माठे, “हाय, मेरे पाई!” आसे तेरिया तँईं बऊत दु:खी ए, ये बोली की छातिया पाँदे बाणे लगे। <verse eid="1KI 13:30" /><verse number="31" style="v" sid="1KI 13:31" />तेबे तिने तेसखे माट्टी देई की आपणे माठेया खे बोलेया, “जेबे आऊँ मरी जाऊँगा तेबे एते कब्रिस्तानो रे राखणा, जिदे परमेशरो रा ये माणूं राखी राखेया ओर मेरी आड्डिया तेसरी ई आड्डिया साथे राखी देणियां। <verse eid="1KI 13:31" /><verse number="32" style="v" sid="1KI 13:32" />कऊँकि जो वचन तिने यहोवे ते पाई की बेतेलो री बेदी ओर सामरिया शईरो रे सारे ऊच्ची जगा रे मन्दरो रे खलाफ आका पाई की बोलेया था, से पक्का पूरा ऊई जाणा।”<verse eid="1KI 13:32" /></para>
  <para style="s">यारोबामो रा नाश ऊणा</para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 13:33" />यारोबाम नि बदलेया, से सारे बुरे काम करदा रया। तिने फेर सब प्रकारा रे लोका बीचा ते ऊच्ची जगा रे पुरोईत बणाए, बल्कि जो कोई चाओ था, तेसरा संस्कार करी की, से तेसखे ऊच्ची जगा रा पुरोईत बणाई देयो था। <verse eid="1KI 13:33" /><verse number="34" style="v" sid="1KI 13:34" />तेबे ये गल्ल यारोबामो रे कराने खे पाप ठईरी, इजी बजअ ते तेसरा नाश ऊईगा ओर से तरतिया पाँदा ते नाश करी ता।<verse eid="1KI 13:34" /></para>
  <chapter eid="1KI 13" />
  <chapter number="14" style="c" sid="1KI 14" />
  <para style="s">यारोबामो रे पाऊए री मौत</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 14:1" />तेस बखते यारोबामो रा पाऊ अबिय्याह बऊत बमार ऊईगा। <verse eid="1KI 14:1" /><verse number="2" style="v" sid="1KI 14:2" />तेबे यारोबामे आपणी लाड़िया खे बोलेया, “एड़ा पेष बणा कि कोई ताखे पछयाणी नि सको कि ये यारोबामो री लाड़ी ए ओर शीलो खे चली जा, तेती अहिय्याह नबी रओआ जिने माखे बोलेया था, ‘तूँ एसा प्रजा रा राजा बणी जाणा।’ <verse eid="1KI 14:2" /><verse number="3" style="v" sid="1KI 14:3" />तूँ तेसगे दस रोटिया, टिक्किया ओर एक कुप्पी सयीतो री लई जा ओर तेस ताखे बताणा कि पाऊए खे क्या ऊणा।” <verse eid="1KI 14:3" /><verse number="4" style="v" sid="1KI 14:4" />यारोबामो री लाड़िए तेड़ा ई कित्तेया ओर चली की शीलो दे पऊँची गी ओर अहिय्याह रे कअरे आई, अहिय्याहो खे तो कुछ बी दिशणे नि लगी रा था, कऊँकि स्याणा ऊणे रिया बजअ ते तेसरिया आखी तुँदल़िया पड़ी गिया थिया। <verse eid="1KI 14:4" /><verse number="5" style="v" sid="1KI 14:5" />तेबे यहोवे अहिय्याह खे बोलेया, “सुण, यारोबामो री लाड़ी तांते आपणे पाऊए रे बारे दे जो बमार ए कुछ पूछणे खे आऊणे लगी री, तैं तेसा खे यो-यो गल्ला बोलणिया; तेसा आई की तांगे आपू खे ओर ई जवाणस बताणा।”<verse eid="1KI 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 14:6" />जेबे अहिय्याहे द्वारो पाँदे आऊँदे ऊए तेसा रे पैरो री आवाज सुणी ओर बोलेया, “ओ यारोबाम री लाड़ी! पीतरे आईजा, तूँ आपू खे दूजी जवाणस कऊँ बताणे लगी री? माखे तेरिया तँईं बुरा सन्देशा मिली रा। <verse eid="1KI 14:6" /><verse number="7" style="v" sid="1KI 14:7" />तूँ जाई की यारोबामो खे बोल कि इस्राएलो रा यहोवा परमेशर ताखे ईंयाँ बोलोआ, ‘मैं तो तूँ प्रजा बीचा ते बढ़ाई की आपणी प्रजा इस्राएलो पाँदे परदान बणाया, <verse eid="1KI 14:7" /><verse number="8" style="v" sid="1KI 14:8" />ओर दाऊदो रे कराने ते राज्य छीनी की ताखे देईता, पर तूँ मेरे दास दाऊदो जेड़ा नि ऊआ जो मेरी आज्ञा खे मानो था ओर आपणे पूरे मनो ते सच्चा-पक्का ऊई की मां पीछे-पीछे चलो था ओर बस सेई करो था जो मेरी नजरा दे ठीक था। <verse eid="1KI 14:8" /><verse number="9" style="v" sid="1KI 14:9" />तैं तिना सारेया ते बढ़ी की जो तांते पईले थे, बुराई कित्ती ओर जाई की पराये देवतेया री आराधना कित्ती ओर मूर्तिया बणाईया, जेते कि आऊँ रोषे करी ता ओर आऊँ तो पीठी पीछे सेटी ता रा। <verse eid="1KI 14:9" /><verse number="10" style="v" sid="1KI 14:10" />इजी बजअ ते, यारोबाम, मां तेरे परिवारो पाँदे मुसीबत पाणी। मां तेरे परिवारो रे सारे मर्द काई देणे। मां तेरा परिवार इस्राएलो बीचा ते एड़ा नाश करी देणा जेड़े आग गोईटुआ खे नाश करी देओई। <verse eid="1KI 14:10" /><verse number="11" style="v" sid="1KI 14:11" />यारोबामो रे कराने रा जो कोई शईरो दे मरी जाओ, से कुत्ते खाणा ओर जो मैदानो दे मरोगा, से सर्गो रे पंछिया खाई जाणा; कऊँकि यहोवे ये बोली राखेया।’ <verse eid="1KI 14:11" /><verse number="12" style="v" sid="1KI 14:12" />इजी री खातर तूँ उठ ओर आपणे कअरो खे चली जा ओर शईरो रे पीतरे तेरे पैर राखदे ई से पाऊ मरी जाणा। <verse eid="1KI 14:12" /><verse number="13" style="v" sid="1KI 14:13" />सारे इस्राएल प्रदेशो रे लोका तेसरिया तँईं शोक करना। तेबे से कब्रा दे दबाणा। यारोबामो रे परिवारो रा सिर्फ ये ई पाऊ बिधि-बिधानो साथे कब्रा दे दबाया जाणा, ओर कोई नि, कऊँकि इस्राएलो रे यहोवा परमेशरे यारोबामो रे परिवारो दे सिर्फ एसदे ई अच्छाई देखी राखी। <verse eid="1KI 14:13" /><verse number="14" style="v" sid="1KI 14:14" />यहोवे इस्राएलो दे एक एड़ा राजा खड़ा करना जेस यारोबामो रा सारा परिवार नाश करी देणा। ये सब बऊत छोड़ ऊणा। <verse eid="1KI 14:14" /><verse number="15" style="v" sid="1KI 14:15" />तेबे यहोवे इस्राएली लोक काईल करने। इस्राएलो रे लोक बऊत डरी जाणे सेयो एड़े कांबणे जेड़े बह्ईंदे पाणिये दे नंगल़ इलदा रओआ। यहोवे इस्राएली लोक एसा अच्छी जमीना ते बारे करी देणे। ये सेई जमीन ए जो तिने तिना रे बुजुर्गा खे दित्ती थी। तेस सेयो फरात नदिया ते पार दूजे कनारे बखेरी देणे। ये इजी बजा ते ऊणा कऊँकि यहोवा इना लोका ते बऊत गुस्से दे आ। कऊँकि इने लोके अशेरा नाओं रिया मूर्तिया आपू खे बणवाई की ओर तिना री पूजा करी की यहोवे खे रोष दलाई राखेया। <verse eid="1KI 14:15" /><verse number="16" style="v" sid="1KI 14:16" />ओर तिना पापा रिया बजअ ते जो यारोबामे कित्ते ओर इस्राएलो रे लोका ते कराये थे, यहोवे इस्राएल त्यागी देणा।”<verse eid="1KI 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 14:17" />तेबे यारोबामो री लाड़ी बिदा ऊई की तिर्सा शईरो खे चली गी ओर से कअरो रिया देऊल़ी गे जिंयाँ ई पऊँची, से बाल़क मरी गा। <verse eid="1KI 14:17" /><verse number="18" style="v" sid="1KI 14:18" />तेबे यहोवे रे वचनो रे मुताबिक जो तिने आपणे दास अहिय्याह नबीए ते बुलाया था, सारे इस्राएलिये तेसखे दबाई की तेसखे शोग कित्तेया। <verse eid="1KI 14:18" /><verse number="19" style="v" sid="1KI 14:19" />यारोबामो रे ओर काम मतलब तिने केड़ा-केड़ा युद्ध कित्तेया ओर केड़ा राज्य कित्तेया, ये सारा इस्राएलो रे राजेया रे इतिआसो री कताबा रे लिखी राखेया। <verse eid="1KI 14:19" /><verse number="20" style="v" sid="1KI 14:20" />यारोबाम बाईया साला तक राज करने ते बाद मरीगा ओर नादाब नाओं रा तेसरा पाऊ तेसरी जगा पाँदे नवां राजा बणेया।<verse eid="1KI 14:20" /></para>
  <para style="s">रहूबियामो रा राज्य</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 14:21" />तेबे सुलैमानो रा पाऊ रहूबियाम यहूदा दे राज करने लगेया। रहूबियाम अकताल़ी साला रा ऊई की राज करने लगेया ओर यरूशलेम जो यहोवे सारे इस्राएली गोत्रो बीचा ते आपणा नाओं राखणे खे चूणी ला था, तेस शईरो दे से सतारा साला तक राज करदा रया ओर तेसरी माया रा नाओं नामाह था जो अम्मोनी जवाणस थी। <verse eid="1KI 14:21" /><verse number="22" style="v" sid="1KI 14:22" />यहूदी लोके यहोवे रे खलाफ पाप कित्तेया, ओर तेसखे गुस्सा दलाणे रिया तँईं आपणे सबी बुजुर्गा ते जादा बुरे काम कित्ते थे। <verse eid="1KI 14:22" /><verse number="23" style="v" sid="1KI 14:23" />तिने सारे ऊच्चे टीलेया पाँदे ओर सारे डाल़ा निठे, ऊच्चिया जगा, लक्कड़ ओर अशेरा नाओं रिया मूर्तिया बणाई लिया। <verse eid="1KI 14:23" /><verse number="24" style="v" sid="1KI 14:24" />ओर तिना रे देशो रे मर्द एकी-दूजे साथे बुरा काम करो थे, बल्कि सेयो तिना जातिया रे जे सारे घिनौने काम करो थे, जो यहोवे इस्राएली लोका सामणे ते निकयाल़ी ते थे।<verse eid="1KI 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 14:25" />राजा रहूबियामो रे पाँजुए सालो दे मिस्रो रा राजा शीशक, यरूशलेम शईरो पाँदे अमला करी की, <verse eid="1KI 14:25" /><verse number="26" style="v" sid="1KI 14:26" />यहोवे रे मन्दरो रिया कीमती चीजा ओर राजमईलो रिया कीमती चीजा खे लईगा ओर सूईने रिया जो ढाला सुलैमाने बणाईया थिया से सारेया खे लईगा। <verse eid="1KI 14:26" /><verse number="27" style="v" sid="1KI 14:27" />इजी री खातर राजा रहूबियामे तिना रे बदले पीतल़ी रिया ढाला बणवाईया ओर सेयो पईरेदारा रे परदाना रे आथो दे सम्बाल़ी तिया, जो राजमईलो रे द्वारो री रखवाल़ी करो थे। <verse eid="1KI 14:27" /><verse number="28" style="v" sid="1KI 14:28" />तेबे जेबे-जेबे राजा यहोवे रे मन्दरो दे जाओ था तेबे-तेबे पईरेदार तिना खे चकी की लई चलो थे ओर फेर आपणी कमरे दे वापस राखी देयो थे। <verse eid="1KI 14:28" /><verse number="29" style="v" sid="1KI 14:29" />राजा रहूबियामो रे ओर सारे काम जो तिने कित्ते से यहूदा रे राजेया री इतिआसो री कताबा दे लिखी राखे। <verse eid="1KI 14:29" /><verse number="30" style="v" sid="1KI 14:30" />रहूबियाम ओर यारोबामो बीचे सदा लड़ाई ऊँदी रयी। <verse eid="1KI 14:30" /><verse number="31" style="v" sid="1KI 14:31" />ओर रहूबियाम जेसरी माये नामाह नाओं री एक अम्मोनी जवाणस थी, से मरी की आपणे बुजुर्गा साथे मिलीगा ओर तिना गेई दाऊदो रे शईरो गे से दबाईता ओर तेसरा पाऊ अबिय्याम तेसरी जगा पाँदे राज करने लगेया।<verse eid="1KI 14:31" /></para>
  <chapter eid="1KI 14" />
  <chapter number="15" style="c" sid="1KI 15" />
  <para style="s">यहूदा दे अबिय्यामो रा राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 15:1" />नबातो रे पाऊ यारोबामो रे राज करने रे ठारूए सालो रे अबिय्याम यहूदा पाँदे राज करने लगेया। <verse eid="1KI 15:1" /><verse number="2" style="v" sid="1KI 15:2" />ओर से तीऊँ साला तक यरूशलेम शईरो पाँदे राज करदा रया। तेसरी माया रा नाओं माका था जो अबशालोमो री बेटी थी। <verse eid="1KI 15:2" /><verse number="3" style="v" sid="1KI 15:3" />तिने सेयो ई पाप कित्ते जो तेसरे बाओए तेसते पईले कित्ते थे। अबिय्याह आपणे पड़दादे दाऊदो जेड़ा परमेशर यहोवे खे मानणे वाल़ा नि था। <verse eid="1KI 15:3" /><verse number="4" style="v" sid="1KI 15:4" />यहोवा दाऊदो ते प्यार करो था। तेतेरिया बजा ते ई यहोवे अबिय्याह खे यरूशलेम शईरो दे राज करने दित्तेया ओर यहोवे तेसखे एक पाऊ दित्तेया। यहोवे यरूशलेम बचाई की राखेया। ये तिने दाऊदो रिया तँईं कित्तेया। <verse eid="1KI 15:4" /><verse number="5" style="v" sid="1KI 15:5" />कऊँकि दाऊद ईमानदारिया ते से ई काम करेया करो था जो यहोवे री नजरा दे ठीक था ओर हित्ती ऊरिय्याह री गल्ला रे सिवाये ओर केसी गल्ला दे यहोवे री केसी आज्ञा ते पूरी जिन्दगी नि मुड़ेया। <verse eid="1KI 15:5" /><verse number="6" style="v" sid="1KI 15:6" />रहूबियामो री पूरी जिन्दगी तो तेसरे ओर यारोबामो बीचे लड़ाई ऊँदी रयी। <verse eid="1KI 15:6" /><verse number="7" style="v" sid="1KI 15:7" />अबिय्यामो रे ओर सारे काम जो तिने कित्ते, सेयो यहूदा रे राजेया रे इतिआसो री कताबा दे लिखी राखे। ओर अबिय्यामो री यारोबामो साथे लड़ाई ऊँदी रयी। <verse eid="1KI 15:7" /><verse number="8" style="v" sid="1KI 15:8" />तेबे अबिय्याम मरीगा ओर से दाऊदो रे शईरो दे दबाईता। तेबे तेसरा पाऊ आसा तेसरी जगा पाँदे राज करने लगेया।<verse eid="1KI 15:8" /></para>
  <para style="s">यहूदा दे आसा रा राज्य</para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 15:9" />इस्राएलो दे राजा यारोबामो रे राज्य रे बिऊए सालो रे आसा यहूदा पाँदे राज करने लगेया; <verse eid="1KI 15:9" /><verse number="10" style="v" sid="1KI 15:10" />ओर यरूशलेम शईरो पाँदे अकताल़ी साला तक राज करदा रया ओर तेसरी माये अबशालोमो री बेटी माका थी। <verse eid="1KI 15:10" /><verse number="11" style="v" sid="1KI 15:11" />ओर राजा आसे आपणे मूलमर्द दाऊदो जेड़ा तेड़ा ई कित्तेया जो यहोवे री नजरा दे ठीक ओर सई था। <verse eid="1KI 15:11" /><verse number="12" style="v" sid="1KI 15:12" />तिने तो पुरूषगामी देशो ते निकयाल़ी ते ओर जितणिया मूर्तिया तेसरे बुजुर्गे बणाईया थिया सेयो सारिया तिने दूर करी तिया। <verse eid="1KI 15:12" /><verse number="13" style="v" sid="1KI 15:13" />बल्कि तेसरी दादी माका जेसे अशेरा रिया तँईं एक घिनौनी मूर्ति बणाई थी तिने से राजमाता रे पदो ते टाईती ओर आसे तेसा री मूर्ति बाडी की किद्रोनो रे नाल़े रे फूकी ती। <verse eid="1KI 15:13" /><verse number="14" style="v" sid="1KI 15:14" />पर ऊच्ची जगा नि टाल़ी गईया, तेबे बी आसा रा मन पूरी जिन्दगी यहोवे रिया तरफा खे लगेया दा रया। <verse eid="1KI 15:14" /><verse number="15" style="v" sid="1KI 15:15" />ओर जो सूईना चाँदी ओर पांडे तेसरे बाओए चढ़ाए थे ओर जो तिने आपू चढ़ाए थे, सेयो सारे तिने यहोवे रे मन्दरो दे पऊँचाई ते। <verse eid="1KI 15:15" /><verse number="16" style="v" sid="1KI 15:16" />आसा ओर इस्राएलो रे राजा बाशा बीचे तिना री पूरी जिन्दगी युद्ध ऊँदा रया। <verse eid="1KI 15:16" /><verse number="17" style="v" sid="1KI 15:17" />तेबे इस्राएलो रे राजा बाशे यहूदा पाँदे अमला कित्तेया ओर रामा शईर इजी रिया तँईं मजबूत कित्तेया, ताकि कोई यहूदा रे राजा आसा गे आई-जाई नि सको। <verse eid="1KI 15:17" /><verse number="18" style="v" sid="1KI 15:18" />तेबे आसे जितणा सूईना चाँदी यहोवे रे मन्दरो ओर राजमईलो रे पण्डारो दे रयी गा था से सारा काडी की आपणे कर्मचारिया रे आथो दे सम्बाल़ी की, दमिश्को दे रणे वाल़ा अरामो रे राजा बेन्हददो गे जो हेज्योनो रा पोता ओर तब्रिम्मोनो रा पाऊ था पेजी की ये बोलेया, <verse eid="1KI 15:18" /><verse number="19" style="v" sid="1KI 15:19" />“जेड़ी मेरे ओर तेरे बाओ बीचे शान्तिया रा समजौता था तेड़ा ई मां ओर तां बीचे बी शान्तिया रा समजौता ऊणा चाईयो, देख, आऊँ तांगे सूईने चाँदिए री पेंट पेजुँआ, इजी री खातर आओ, इस्राएलो रे राजा बाशा साथे कित्ते रे आपणे शान्तिया रे समजौते खे तोड़ी दे, ताकि से ओर तेसरी सेना मांगा गे ते चली जाओ।” <verse eid="1KI 15:19" /><verse number="20" style="v" sid="1KI 15:20" />आसा राजे री ये गल्ल मानी की बेहन्ददे आपणे दला रे परदाना साथे इस्राएली जगा पाँदे अमला करवाई की इय्योन, दान, आबेल्वेत्माका ओर सारा किन्नेरेत शईर, ओर नप्तालिया रा सारा देश जीती ला। <verse eid="1KI 15:20" /><verse number="21" style="v" sid="1KI 15:21" />ये सुणी की राजा बाशे रामा शईर पक्का करना छाडीता ओर तिर्सा दे रणे लगेया। <verse eid="1KI 15:21" /><verse number="22" style="v" sid="1KI 15:22" />तेबे आसा राजे सारे यहूदा दे ये प्रचार करवाया कोई बिना सुणे नि रया, तेबे सेयो रामा शईरो ते पात्थर ओर लकड़ी जिना साथे बाशा तेतेखे पक्का करो था चकी की लईगे ओर तिना साथे आसा राजे बिन्यामीनो रा गेबा ओर मिस्पा शईर पक्का कित्तेया। <verse eid="1KI 15:22" /><verse number="23" style="v" sid="1KI 15:23" />आसा रे ओर काम ओर तेसरी वीरता ओर जो कुछ तिने कित्तेया ओर जो शईर तिने पक्के कित्ते, ये सारे यहूदा रे राजेया रे इतिआसो री कताबा दे लिखी राखे। पर जेबे से स्याणा ऊआ तेबे तेसखे पैरो दे बमारी लगी गी। <verse eid="1KI 15:23" /><verse number="24" style="v" sid="1KI 15:24" />आसा मरीगा ओर से तेसरे मूलमर्द दाऊदो रे शईरो दे तेसरे बुजुर्गा रे नेड़े दबाईता। ओर तेसरा पाऊ यहोशापात तेसरी जगा पाँदे राज करने लगेया।<verse eid="1KI 15:24" /></para>
  <para style="s">इस्राएलो दे नादाबो रा राज्य</para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 15:25" />यहूदा रे राजा आसा रे राजो रे दूजे साले यारोबामो रा पाऊ नादाब इस्राएलो पाँदे राज करने लगेया; ओर से दो साल तक राज करदा रया। <verse eid="1KI 15:25" /><verse number="26" style="v" sid="1KI 15:26" />तिने से काम कित्तेया जो यहोवे री नजरा दे बुरा था ओर आपणे बाओ री बाटा दे सेई पाप करदा ऊआ चलदा रया जो तिने इस्राएलो ते करवाया था। <verse eid="1KI 15:26" /><verse number="27" style="v" sid="1KI 15:27" />बाशा इस्साकारो रे गोत्रो रे अहिय्याह रा पाऊ था, बाशे नादाबो खे काणे री योजना बणाई। नादाबे सारे इस्राएली लोका समेत पलिश्तिया रे देशो रा गिब्बतोन शईर केरी राखेया था। तेबे बाशे गिब्बतोनो रे नेड़े से काई ता।<verse eid="1KI 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 15:28" />ओर यहूदा रे राजा आसा रे तीजे साले बाशे नादाब काई ता ओर तेसरी जगा पाँदे राजा बणी गा। <verse eid="1KI 15:28" /><verse number="29" style="v" sid="1KI 15:29" />राजा बणदे ई बाशे यारोबामो रा सारा कराना काई ता; तिने यारोबामो रा कराना एथो तक नाश करी ता कि तिदे एक बी जिऊँदा नि रया, ये सारा यहोवे रे तेस वचनो रे मुताबिक ऊआ जो तिने आपणे दास शीलो रे रणे वाल़े अहिय्याह ते बुलवाया था। <verse eid="1KI 15:29" /><verse number="30" style="v" sid="1KI 15:30" />ये इजी बजअ ते ऊआ कि यारोबामे आपू पाप कित्ते ओर इस्राएलो ते बी करवाए थे ओर तिने इस्राएलो रे परमेशर यहोवे खे रोष दलाया था। <verse eid="1KI 15:30" /><verse number="31" style="v" sid="1KI 15:31" />नादाबो रे ओर सारे काम जो तिने कित्ते थे, सेयो सब इस्राएलो रे राजेया रे इतिआसो री कताबा दे लिखी राखे। <verse eid="1KI 15:31" /><verse number="32" style="v" sid="1KI 15:32" />यहूदा रे राजा आसा ओर इस्राएलो रा राजा बाशा दोनों जदुए तक जिऊँदे रये आपू बीचे लड़ाई करदे रये।<verse eid="1KI 15:32" /></para>
  <para style="s">इस्राएलो दे बाशा रा राज्य</para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 15:33" />यहूदा रे राजा आसा रे तीजे सालो रे अहिय्याह रा पाऊ बाशा, तिर्सा रे सारे इस्राएली लोका पाँदे राज करने लगेया ओर चौबी साल तक राज करदा रया। <verse eid="1KI 15:33" /><verse number="34" style="v" sid="1KI 15:34" />ओर तिने से कित्तेया जो यहोवे री नजरा दे बुरा था ओर यारोबामो री बाटा दे चली की सेई पाप करदा रया जो तिने इस्राएलो ते करवाया था।<verse eid="1KI 15:34" /></para>
  <chapter eid="1KI 15" />
  <chapter number="16" style="c" sid="1KI 16" />
  <para style="p">
    <verse number="1" style="v" sid="1KI 16:1" />जेबे बाशा राजा इस्राएलो पाँदे राज करो था, तेबे राजा बाशा रे बारे दे हनानीए रे पाऊ येहूए राजा बाशा खे ये सन्देश दित्तेया जो यहोवे तेसगे बोलेया था, <verse eid="1KI 16:1" /><verse number="2" style="v" sid="1KI 16:2" />“मैं तूँ एक खास माणूं बणाया, ओर आपणी इस्राएली प्रजा रा परदान बणाया, पर तूँ यारोबामो जेड़ी चाल चलदा ओर मेरी इस्राएली प्रजा ते एड़े पाप करांदा आई रा जिना साथे सेयो माखे रोष चढ़ाओए। <verse eid="1KI 16:2" /><verse number="3" style="v" sid="1KI 16:3" />इजी री खातर बाशा, मां तूँ ओर तेरा सारा परिवार नाश करी देणे। मां तां साथे तेड़ा ई करना जेड़ा मैं नबातो रे पाऊ यारोबामो रे परिवारो साथे कित्तेया था। <verse eid="1KI 16:3" /><verse number="4" style="v" sid="1KI 16:4" />बाशा रे कअरो रा जो कोई शईरो दे मरी जाओ, से कुत्ते खाई देणा ओर तेसरा जो कोई मैदानो दे मरोगा, से सर्गो रे पंछिया खाई देणा।” <verse eid="1KI 16:4" /><verse number="5" style="v" sid="1KI 16:5" />राजा बाशा रे ओर सारे काम जो तिने कित्ते ओर तेसरी वीरता रे काम ये सारे इस्राएलो रे राजेया रे इतिआसो री कताबा दे लिखी राखे। <verse eid="1KI 16:5" /><verse number="6" style="v" sid="1KI 16:6" />तेबे राजा बाशा मरीगा ओर से तिर्सा शईरो दे दबाईता। तेसते बाद तेसरा पाऊ एला तेसरी जगा पाँदे राज करने लगेया। <verse eid="1KI 16:6" /><verse number="7" style="v" sid="1KI 16:7" />यहोवे रा जो वचन नबी हनानीए रे पाऊ येहूए रे जरीये बाशा ओर तेसरे कराने रे खलाफ आया, से बस तिना ई बुराईया रिया बजअ ते नि आया जो तिने यारोबामो रे कराने जेड़ा ऊई की यहोवे री नजरा दे कित्तेया था ओर आपणे कामा रे जरीये तेसखे रोष दलाया। यहोवा इजी बजा ते बी रोषे था कि बाशा राजे यारोबामो रा सारा परिवार काईता था।<verse eid="1KI 16:7" /></para>
  <para style="s">इस्राएलो दे एला रा राज्य</para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 16:8" />यहूदा रे राजा आसा रे राजो रे छब्बिए साले बाशा राजे रा पाऊ राजा एला तिर्सा दे इस्राएली लोका पाँदे राज करने लगेया ओर दो साल तक राज करदा रया। <verse eid="1KI 16:8" /><verse number="9" style="v" sid="1KI 16:9" />जेबे से तिर्सा रे अर्सा नाओं रे पण्डारिये रे कअरे जो तेसरे तिर्सा वाल़े मईलो रा परदान था, शराब पी की मतवाल़ा ऊईगा था, तेबे तेसरे जिम्री नाओं रे एक कर्मचारिये जो तेसरे आदे रथा रा परदान था, तिने राजा एला खे काणे री स्कीम बणाई। <verse eid="1KI 16:9" /><verse number="10" style="v" sid="1KI 16:10" />जिम्री तेस कअरो दे गया ओर तिने राजा एला काईता। ये तेबे ऊआ था जेबे यहूदा प्रदेशो दे राजा आसा खे राज करदे ऊए सताईया साल लगी रा था। ईंयाँ इस्राएलो दे एला ते बाद जिम्री नवां राजा बणेया। <verse eid="1KI 16:10" /><verse number="11" style="v" sid="1KI 16:11" />ओर जेबे से राज करने लगेया, तेबे सिंहासनो पाँदे बैठदे ई तिने बाशा रा पूरा कराना कायी ता, बल्कि तिने ना तो तेसरे टब्बरो वाल़े ओर ना तेसरे दोस्ता रे पाऊआ बीचा ते कोई बी जिऊँदा छाडेया। <verse eid="1KI 16:11" /><verse number="12" style="v" sid="1KI 16:12" />ईंयाँ यहोवे रे तेस वचनो रे मुताबिक जो तिने येहू नबीए रे जरीये बाशा रे खलाफ बोलेया था, जिम्रिए बाशा रा सारा टब्बर नाश करी ता। <verse eid="1KI 16:12" /><verse number="13" style="v" sid="1KI 16:13" />इजी री बजअ बाशा रे सारे पाप ओर तेसरे पाऊ एला रे बी पाप थे, जो तिने मूर्तिपूजा आपू करी की ओर इस्राएलो ते बी करवाई की इस्राएलो रे परमेशर यहोवे खे बेकारो दे रोष दलाया था। <verse eid="1KI 16:13" /><verse number="14" style="v" sid="1KI 16:14" />राजा एला रे ओर सारे काम जो तिने कित्ते थे, सेयो इस्राएलो रे राजेया रे इतिआसो री कताबा दे लिखी राखे।<verse eid="1KI 16:14" /></para>
  <para style="s">इस्राएलो दे जिम्रिए रा राज्य</para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 16:15" />यहूदा रे राजा आसा रे सताईये साले जिम्री तिर्सा शईरो दे राज करने लगेया ओर तिर्सा दे सात दिन तक राज करदा रया। तेस बखते लोके पलिश्तिया रे शईर गिब्बतोनो रे खलाफ डेरे लगाई राखे थे। <verse eid="1KI 16:15" /><verse number="16" style="v" sid="1KI 16:16" />तेबे जेबे तिने डेरे लगाए रे इस्राएली लोके सुणेया कि जिम्रिए राजद्रोह री सभा करी की राजा कायी ता, तेबे तेस ई दिने सारे इस्राएलिये ओम्री नाओं रा परदान सेनापति डेरे दे इस्राएलो रा राजा बणाया। <verse eid="1KI 16:16" /><verse number="17" style="v" sid="1KI 16:17" />तेबे ओम्रीये सारे इस्राएलो खे साथे लई की गिब्बतोन छाडेया ओर तिर्सा केरी ता। <verse eid="1KI 16:17" /><verse number="18" style="v" sid="1KI 16:18" />जेबे जिम्रिए देखेया कि दुश्मणे शईर आपणे कब्जे दे लई ला रा, तेबे तिने राजमईलो रे गुम्मटो दे जाई की राजमईलो दे आग लगाईती ओर तिदे ई आपू बी फूकी की मरी गा। <verse eid="1KI 16:18" /><verse number="19" style="v" sid="1KI 16:19" />ये तेसरे पापो रिया बजअ ते ऊआ, कऊँकि तिने से कित्तेया जो यहोवे री नजरा दे बुरा था, कऊँकि से यारोबामो री जी चाल ओर तेसरे कित्ते रे ओर इस्राएलो ते करवाये रे पापो रिया बाटा दे चलेया। <verse eid="1KI 16:19" /><verse number="20" style="v" sid="1KI 16:20" />जिम्रिए रे ओर काम ओर जो राजद्रोह री सभा तिने कित्ती, ये सारे काम इस्राएलो रे राजेया रे इतिआसो री कताबा दे लिखी राखे।<verse eid="1KI 16:20" /></para>
  <para style="s">इस्राएलो दे ओम्रीये रा राज्य</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 16:21" />तेबे इस्राएली प्रजा दो इस्से दे ऊईगी, प्रजा रे आदे लोक तो तिब्नी नाओं रे गीनतो रे पाऊए खे राजा बनाणे खे तेस ई पीछे ऊईगे ओर आदे ओम्रीये पीछे ऊईगे। <verse eid="1KI 16:21" /><verse number="22" style="v" sid="1KI 16:22" />बादो ते जो लोक ओम्रीये पीछे ऊए थे सेयो तिना पाँदे प्रबल ऊए जो गीनतो रे पाऊ तिब्निये पीछे ऊईगे थे, इजी बजअ ते तिब्नी कायी ता ओर ओम्री राजा बणी गा। <verse eid="1KI 16:22" /><verse number="23" style="v" sid="1KI 16:23" />यहूदा रे राजा आसा रे कत्थिये सालो दे ओम्री इस्राएलो पाँदे राज करने लगेया ओर बारा साल तक राज करदा रया; तिने छे साला तक तो तिर्सा दे राज कित्तेया। <verse eid="1KI 16:23" /><verse number="24" style="v" sid="1KI 16:24" />ओर तिने शेमेरो ते सामरिया पाह्ड़ सत्तर किलो चाँदिए दे<note caller="+" style="f"><char style="fr" closed="false">16:24 </char><char style="fq" closed="false">सत्तर किलो चाँदिए दे </char><char style="ft" closed="false">दो किक्कार चाँदिए </char></note> मोले लई की, तिदे एक शईर बसाया ओर तिने आपणे बसाए रे शईरो रा नाओं पाह्ड़ो रे मालक शेमेरो रे नाओं पाँदे सामरिया राखेया। <verse eid="1KI 16:24" /><verse number="25" style="v" sid="1KI 16:25" />ओम्रीये से कित्तेया जो यहोवे री नजरा दे बुरा था, बल्कि तिना सारेया ते बी जादा बुरा कित्तेया जो तेसते पईले राजा ऊए थे। <verse eid="1KI 16:25" /><verse number="26" style="v" sid="1KI 16:26" />तिने नबातो रे पाऊ यारोबामो जेड़ी चाल चली ओर तेसरे सारे पापो रे मुताबिक जो तिने इस्राएलो ते करवाए थे जिना रिया बजअ ते तिने इस्राएलो रे परमेशर यहोवे खे आपणे बेकारो रे काम मूर्तिपूजा रिया बजअ ते रोष दलाया था। <verse eid="1KI 16:26" /><verse number="27" style="v" sid="1KI 16:27" />ओम्रीये रे ओर काम जो तिने कित्ते थे ओर जो वीरता तिने दखाई, ये सारे इस्राएलो रे राजेया रे इतिआसो री कताबा दे लिखी राखे। <verse eid="1KI 16:27" /><verse number="28" style="v" sid="1KI 16:28" />तेबे ओम्री मरीगा से तेसरे बुजुर्गा साथे सामरिया दे दबाईता। तेबे तेसरा पाऊ अहाब तेसरी जगा पाँदे राज करने लगेया।<verse eid="1KI 16:28" /></para>
  <para style="s">इस्राएलो दे अहाबो रे राज्य री शुरूआत</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 16:29" />यहूदा रे राजा आसा रे राजो रे ठथिये साले ओम्रीये रा पाऊ अहाब इस्राएलो पाँदे राज करने लगेया ओर इस्राएलो पाँदे सामरिया दे बाईया साला तक राज करदा रया। <verse eid="1KI 16:29" /><verse number="30" style="v" sid="1KI 16:30" />ओर ओम्रीये रे पाऊ अहाबे तिना सारे ते जादा जो तेसते पईले राजा उए थे, सेयो काम कित्ते जो यहोवे री नजरा दे बुरे थे। <verse eid="1KI 16:30" /><verse number="31" style="v" sid="1KI 16:31" />तिने तो नबातो रे पाऊ यारोबामो रे पापो दे चलणा अल़्की जी गल्ल जाणी की, सीदोनिया रे राजा एतबालो री बेटी ईजेबेला साथे ब्या करी की बाल देवतेया री आराधना कित्ती ओर तेसगे माथा टेकेया।<note caller="+" style="f"><char style="fr" closed="false">16:31 </char><char style="ft" closed="false">(प्रका. 2:20)</char></note> <verse eid="1KI 16:31" /><verse number="32" style="v" sid="1KI 16:32" />तिने बाल देवते रा एक मन्दर सामरिया दे बणाई की तिदे बाल देवते री एक बेदी बणाई। <verse eid="1KI 16:32" /><verse number="33" style="v" sid="1KI 16:33" />ओर अहाबे एक अशेरा री मूर्ति बी बणाई, बल्कि तिने तिना सारे इस्राएली राजेया ते बढ़ी की जो तेसते पईले थे इस्राएलो रे परमेशर यहोवे खे रोष दलाणे रा काम कित्तेया। <verse eid="1KI 16:33" /><verse number="34" style="v" sid="1KI 16:34" />तेसरे बखतो दे बेतेलो दे रणे वाल़े हीएले यरीहो खे फेर बसाया; जेबे तिने तेतेरी निऊँ पाई तेबे तेसरा जेठा पाऊ अबीराम मरी गा ओर जेबे तिने तेतेरे बड़े द्वार खड़े कित्ते तेबे तेसरा छोटा पाऊ सगूब मरी गा, ये यहोवे रे तेस वचनो रे मुताबिक ऊआ, जो तिने नूनो रे पाऊ यहोशूए रे जरीये बुलवाया था। <note caller="+" style="f"><char style="fr" closed="false">16:34 </char><char style="ft" closed="false">(यहो. 6:26)</char></note><verse eid="1KI 16:34" /></para>
  <chapter eid="1KI 16" />
  <chapter number="17" style="c" sid="1KI 17" />
  <para style="s">एलिय्याह रे कामा री शुरूआत</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 17:1" />एलिय्याह नाओं रा एक नबी था, जो गिलाद इलाके रे तिशबी शईरो दे रणे वाल़ा था तिने इस्राएलो रे राजा अहाबो खे बोलेया, “इस्राएलो रा यहोवा परमेशर जेस सामणे आऊँ आजीर रऊँआ, तेसरी जिन्दगिया री कसम इना साला दे मेरे बिना बोले, ना तो बर्खा ऊणी ओर ना ई पाल़ा पड़ना।”<note caller="+" style="f"><char style="fr" closed="false">17:1 </char><char style="ft" closed="false">लूक. 4:25, याकू. 5:17, प्रका. 11:6</char></note><verse eid="1KI 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1KI 17:2" />तेबे यहोवे रा ये वचन तेसगे पऊँचेया, <verse eid="1KI 17:2" /><verse number="3" style="v" sid="1KI 17:3" />“एथा ते चली की पूर्वो रिया तरफा खे जा ओर करीत नाओं रे नाल़े रे जो यरदनो सामणे ए लूकी जा। <verse eid="1KI 17:3" /><verse number="4" style="v" sid="1KI 17:4" />तेस ई नाल़े रा पाणी पिया करना ओर मैं कावा खे आज्ञा देई राखी कि सेयो ताखे तेती खुल़ाओ।”<verse eid="1KI 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 17:5" />यहोवे रा ये वचन मानी की से यरदनो ते पूर्वो रे करीत नाओं रे नाल़े दे जाई की लूकेया रा रया। <verse eid="1KI 17:5" /><verse number="6" style="v" sid="1KI 17:6" />ओर प्यागा-साँजा काओ तेसगे रोटी ओर मास ल्याया करो थे ओर से नाल़े रा पाणी पिया करो था। <verse eid="1KI 17:6" /><verse number="7" style="v" sid="1KI 17:7" />कुछ दिना ते बाद तेते देशो रे बर्खा ना ऊणे रिया बजअ ते से नाल़ा सुकी गा।<verse eid="1KI 17:7" /></para>
  <para style="s">एलिय्याह ओर सारफतो री बिदुआ</para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 17:8" />तेबे यहोवे रा ये वचन एलिय्याह गे पऊँचेया, <verse eid="1KI 17:8" /><verse number="9" style="v" sid="1KI 17:9" />“चली की सिदोनो रे सारफत शईरो रे जाई की तेथी रओ, सुण मैं तेथो री एक बिदुआ खे ताखे खुलाणे री आज्ञा देई राखी।”<note caller="+" style="f"><char style="fr" closed="false">17:9 </char><char style="ft" closed="false">लूक. 4:26</char></note> <verse eid="1KI 17:9" /><verse number="10" style="v" sid="1KI 17:10" />तेबे से तेथा ते चली की सारफतो खे गया; शईरो रे बड़े द्वारो गे पऊँची की तिने क्या देखेया कि एक बिदुआ लकड़ू चुगणे लगी री, तेसा खे बुलाई की तिने बोलेया, “माखे केसी पांडे रे पीणे खे थोड़ा जा पाणी ली आओ।” <verse eid="1KI 17:10" /><verse number="11" style="v" sid="1KI 17:11" />जेबे से ल्याऊणे खे जाणे लगी तेबे तिने आका पाई की बोलेया, “आपणे आथो रे एक टुकड़ा रोटिया रा बी लंदी आओ।” <verse eid="1KI 17:11" /><verse number="12" style="v" sid="1KI 17:12" />तेसे बोलेया, “तेरे परमेशर यहोवे री जिन्दगिया री कसम, मांगे एक बी रोटी नि ए बस कड़े रे एक मुट्ठी पर आटा ओर कुप्पिया रे थोड़ा जा तेल ए ओर आऊँ एक-दो लकड़ू चूगी की लई चली री कि आपू खे ओर आपणे पाऊए खे तिजी खे पकाऊँ ओर आसे तिजी खे खाऊँ, तेबे मरी जाऊँ।” <verse eid="1KI 17:12" /><verse number="13" style="v" sid="1KI 17:13" />एलिय्याहे तेसा खे बोलेया, “डर नि, जाई की आपणी गल्ला रे मुताबिक कर, पर पईले माखे एक छोटी जी रोटी बणाई की ली आओ, तेबे इजी ते बाद आपू खे ओर आपणे पाऊए खे बणाया। <verse eid="1KI 17:13" /><verse number="14" style="v" sid="1KI 17:14" />कऊँकि इस्राएलो रा यहोवा परमेशर ईंयाँ बोलोआ कि जदुओ तक यहोवा जमीना दे बर्खा नि करोगा, तदुओ तक ना तो तेस कड़े रा आटा खत्म ऊणा ओर ना तेसा कुप्पिया रा तेल कम ऊणा।” <verse eid="1KI 17:14" /><verse number="15" style="v" sid="1KI 17:15" />तेबे से चली गी ओर एलिय्याहो रे कईणे रे मुताबिक कित्तेया, तदुओ ते से ओर जवाणस ओर तेसा रा कराना कई दिना तक खांदे रये। <verse eid="1KI 17:15" /><verse number="16" style="v" sid="1KI 17:16" />यहोवे रे तेस वचनो रे मुताबिक जो तिने एलिय्याह रे जरीये बोलेया था, ना तो तेस कड़े रा आटा खत्म ऊआ ओर ना ई तेसा कुप्पिया रा तेल कम ऊआ।<verse eid="1KI 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 17:17" />कुछ दिना ते बाद तेसा जवाणसा रा पाऊ जो कअरो री मालकण थी, बमार ऊआ ओर तेसरी बमारी इतणी बढ़ी गी कि तेसरा साआ लणा बन्द ऊईगा। <verse eid="1KI 17:17" /><verse number="18" style="v" sid="1KI 17:18" />तेबे से एलिय्याह खे बोलणे लगी, “ओ परमेशरो रे माणूं! माखे तांते क्या काम ए? क्या तूँ इजी खे मेरे कअरे आया कि मेरे पाऊए री मौता री बजअ बणे ओर मेरे पाप याद दलाए?” <verse eid="1KI 17:18" /><verse number="19" style="v" sid="1KI 17:19" />तिने जवाणसा खे बोलेया, “आपणा पाऊ मांगे दे;” तेबे से तेसखे तेसा री गोदा ते लई की तेस पाँदले कमरे दे गया जेती से आपू रओ था ओर आपणे माँजे पाँदे लटयाल़ी ता। <verse eid="1KI 17:19" /><verse number="20" style="v" sid="1KI 17:20" />तेबे तिने यहोवे खे आका पाई की बोलेया, “ओ मेरे यहोवा परमेशर! क्या तूँ एसा बिदुआ रा पाऊ कायी की जेसा रे कअरे आऊँ रूकी रा, एसा पाँदे बी मुसीबत ली आई रा?” <verse eid="1KI 17:20" /><verse number="21" style="v" sid="1KI 17:21" />तेबे से पाऊए पाँदे तीन बार लेटेया ओर यहोवे खे आका पाई-पाई की बोलेया, “ओ मेरे यहोवा परमेशर! एस बाल़को रा प्राण एसदे फेर पाई दे।” <verse eid="1KI 17:21" /><verse number="22" style="v" sid="1KI 17:22" />एलिय्याह नबीए री ये गल्ल यहोवे सुणी ली ओर बाल़को रा प्राण तेसदे फेर आई गा ओर से जिऊँदा ऊईगा। <verse eid="1KI 17:22" /><verse number="23" style="v" sid="1KI 17:23" />तेबे एलिय्याह बाल़को खे पाँदले कमरे ते फेर थाले लईगा ओर एलिय्याहे ये बोली की तेसरी माया रे आथो दे सम्बाल़ी ता, “देख तेरा पाऊ जिऊँदा ए।”<note caller="+" style="f"><char style="fr" closed="false">17:23 </char><char style="ft" closed="false">प्रेरि. 20:10</char></note> <verse eid="1KI 17:23" /><verse number="24" style="v" sid="1KI 17:24" />जवाणसे एलिय्याह खे बोलेया, “एबे माखे निश्चा ऊईगा कि तूँ परमेशरो रा माणूं ए ओर यहोवे रा जो वचन तेरे मुंए ते निकल़ोआ, से सच्च ओआ।”<verse eid="1KI 17:24" /></para>
  <chapter eid="1KI 17" />
  <chapter number="18" style="c" sid="1KI 18" />
  <para style="s">एलिय्याह ओर बाल देवते रे नबी</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 18:1" />बऊत दिना ते बाद, तीजे साले यहोवे रा ये वचन एलिय्याह गे पऊँचेया, “जाई की आपणे आपू खे अहाबो खे दखा ओर मां जमीना दे बर्खा करी देणी।” <verse eid="1KI 18:1" /><verse number="2" style="v" sid="1KI 18:2" />तेबे एलिय्याह आपणे आपू खे अहाबो गे दखाणे खे गया। तेस बखते सामरिया दे बड़ा पारी अकाल़ पड़ी रा था। <verse eid="1KI 18:2" /><verse number="3" style="v" sid="1KI 18:3" />इजी री खातर अहाबे ओबद्याह खे जो यहोवे रा पग्त था ओर तेसरे कराने रा अधिकारी था, आपू गे बुलाया। <verse eid="1KI 18:3" /><verse number="4" style="v" sid="1KI 18:4" />ओबद्याह तो यहोवे रा डर इतणा मानो था कि जेबे ईजेबेल यहोवे रे नबिया खे नाश करो थी, तेबे ओबद्याह 100 नबिया खे लई की 50-50 करी की गुफा रे लकोई ते ओर खाणा-पीणा देई की तिना रा पालण-पोषण करो था।<verse eid="1KI 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 18:5" />ओर अहाबे ओबद्याह खे बोलेया, “देशो दे पाणिए रिया सारिया सूबल़ा ओर सारी नदिया गे जा, बस इतणा काआ मिली जाओ कि आसे कोड़ेया खे ओर खच्चरा खे जिऊँदा बचायी सकिये ओर म्हारे सारे डांगर नि मरी जाओ।” <verse eid="1KI 18:5" /><verse number="6" style="v" sid="1KI 18:6" />तेबे तिने आपू बीचे देश बांडेया कि आसे तिदे ऊई की चलूँए; एकी तरफा खे अहाब ओर दूजी तरफा खे ओबद्याह चलेया। <verse eid="1KI 18:6" /><verse number="7" style="v" sid="1KI 18:7" />ओबद्याह बाटा दे था कि एलिय्याह तेसखे मिलेया; तेसखे पछयाणी की से मुंए रे पारे थाले पड़ेया ओर बोलेया, “ओ मेरे प्रभु एलिय्याह, क्या तूँ ए?” <verse eid="1KI 18:7" /><verse number="8" style="v" sid="1KI 18:8" />तिने बोलेया, “आ आऊँ ईए, जाई की आपणे स्वामिए खे बोल कि एलिय्याह मिलेया।” <verse eid="1KI 18:8" /><verse number="9" style="v" sid="1KI 18:9" />तिने बोलेया, “मैं एड़ा क्या पाप करी राखेया कि तूँ माखे मरवाणे खे अहाबो रे आथो रे करना चाएया? <verse eid="1KI 18:9" /><verse number="10" style="v" sid="1KI 18:10" />तेरे परमेशर यहोवे री जिन्दगिया री कसम कोई एड़ी जाति या जगा नि ए, जिदे मेरे स्वामिए तूँ नि टोल़ेया ओ ओर जेबे तिने लोके बोलेया कि से एती नि ए, तेबे तिने तेसा जाति ओर जगा खे एतेरी कसम खुल़ाई कि एलिय्याह नि मिलेया। <verse eid="1KI 18:10" /><verse number="11" style="v" sid="1KI 18:11" />ओर एबे तूँ बोलेया कि जाई की आपणे स्वामिए खे बोल कि एलिय्याह एती ए। <verse eid="1KI 18:11" /><verse number="12" style="v" sid="1KI 18:12" />तेबे जिंयाँ ई आऊँ तांगा गे ते चली जाणा, तिंयाँ ई यहोवे रे आत्मे तूँ ना जाणे केथो खे चकी की लई जाणा, तो जेबे आऊँ जाई की अहाबो गे बताऊँगा ओर जे तूँ तेसखे नि मिलेया, तेबे तेस आऊँ कायी देणा; पर आऊँ तेरा दास बचपनो ते ई यहोवे रा डर मानदा आई रा! <verse eid="1KI 18:12" /><verse number="13" style="v" sid="1KI 18:13" />क्या मेरे प्रभुए खे ये नि बताई राखेया कि जेबे ईजेबेल राणी यहोवे रे नबिया खे काओ थी तेबे मैं क्या कित्तेया कि यहोवे रे नबिया बीचा ते 100 लई की 50-50 करी की गुफा रे लकोई की राखे ओर तिना खे खाणा-पीणा देई की पाल़दा रया। <verse eid="1KI 18:13" /><verse number="14" style="v" sid="1KI 18:14" />तेबे तूँ बोलेया कि जाई की आपणे स्वामिए खे बोल कि एलिय्याह मिलेया! तेबे तेस आऊँ कायी देणा।”<verse eid="1KI 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 18:15" />एलिय्याहे बोलेया, “सेना रा यहोवा जेस सामणे आऊँ रऊँआ, तेसरी जिन्दगिया री कसम आज मां आपणे आपू खे तेसगे दखाणा।” <verse eid="1KI 18:15" /><verse number="16" style="v" sid="1KI 18:16" />तेबे ओबद्याह अहाबो खे मिलणे गया ओर तेसगे दसीता की एलिय्याह केईया; तो अहाब एलिय्याह ते मिलणे चलेया। <verse eid="1KI 18:16" /><verse number="17" style="v" sid="1KI 18:17" />एलिय्याह खे देखदे ई अहाबे बोलेया, “ओ इस्राएलो खे सताणे वाल़े, क्या तूँई ए?”<note caller="+" style="f"><char style="fr" closed="false">18:17 </char><char style="ft" closed="false">प्रेरि. 16:20</char></note> <verse eid="1KI 18:17" /><verse number="18" style="v" sid="1KI 18:18" />तिने बोलेया, “मैं इस्राएलो खे कोई कष्ट नि दित्तेया, पर तैं ओर तेरे बाओ रे कराने दित्तेया; कऊँकि तुसे यहोवे री आज्ञा टाल़ी की बाल देवतेया री आराधना करने लगे। <verse eid="1KI 18:18" /><verse number="19" style="v" sid="1KI 18:19" />एबे दूत पेजी की सारे इस्राएलो खे ओर बालो रे 450 नबिया ओर अशेरा रे 400 नबिया खे जो ईजेबेला रे मेजो पाँदे खाओए, मांगे कर्मेल पाह्ड़ो पाँदे कट्ठे करी दे।” <verse eid="1KI 18:19" /><verse number="20" style="v" sid="1KI 18:20" />तेबे अहाबे सारे इस्राएली लोका खे बुलावा पेजेया ओर नबी लोक कर्मेल पाह्ड़ो पाँदे कट्ठे कित्ते। <verse eid="1KI 18:20" /><verse number="21" style="v" sid="1KI 18:21" />ओर एलिय्याह सारे लोका गे आई की बोलणे लगेया, “तुसे कदुओ तक दुँईं बिचारा दे फसे दे रणे, जे यहोवा परमेशर ओ, तो तेस पीछे ऊई जाओ ओर जे बाल परमेशर ए ओ, तो तेस पीछे ऊई जाओ।” लोके तेसरे ज्वाबो दे एक बी गल्ल नि बोली। <verse eid="1KI 18:21" /><verse number="22" style="v" sid="1KI 18:22" />तेबे एलिय्याहे लोका खे बोलेया, “यहोवे रे नबिया बीचा ते बस आऊँ ई रयी गा रा ओर बालो रे नबी 450 माणूं ए। <verse eid="1KI 18:22" /><verse number="23" style="v" sid="1KI 18:23" />इजी री खातर दो बाच्छू ल्याई की आसा गे देयो ओर सेयो एक बाच्छू आपू खे छाँटी की टुकड़े-टुकड़े करी की लकड़िया पाँदे राखो ओर कोई आग नि लगाओ ओर मां दूजा बाच्छू त्यार करी की लकड़िया पाँदे राखणा ओर कोई आग नि लगाणी। <verse eid="1KI 18:23" /><verse number="24" style="v" sid="1KI 18:24" />तेबे तुसे आपणे देवते ते प्रार्थना करो ओर मां यहोवे ते प्रार्थना करनी ओर जो आग सेटी की ज्वाब देयो सेई परमेशर ठईरो।” तेबे सारे लोके बोलेया, “अच्छी गल्ल ए।” <verse eid="1KI 18:24" /><verse number="25" style="v" sid="1KI 18:25" />ओर एलिय्याहे बालो रे नबिया खे बोलेया, “पईले तुसे छाँटी की एक बाच्छू त्यार करी लो, कऊँकि तुसे तो बऊत ए; तेबे आपणे देवते ते प्रार्थना करो, पर आग नि लगाणी।” <verse eid="1KI 18:25" /><verse number="26" style="v" sid="1KI 18:26" />तेबे तिने से बाच्छू जो तिना खे दित्तेया था लई की त्यार कित्तेया ओर प्यागा ते लई की त्याड़िया तक सेयो ये बोली की बालो ते प्रार्थना करदे रये, “ओ बाल म्हारी सुण, ओ बाल म्हारी सुण!” पर ना कोई आवाज ऊई ओर ना कोई ज्वाब देणे वाल़ा ऊआ। तेबे सेयो आपणी बणाई रिया बेदिया पाँदे नाचणे लगे। <verse eid="1KI 18:26" /><verse number="27" style="v" sid="1KI 18:27" />त्याड़िया एलिय्याहे ये बोली की तिना रा मजाक कित्तेया, “जोरे की आका पाओ, से तो देवता ए; तिने तो त्यान ऊणा लगाया रा या केथी गया ऊणा या यात्रा रे ऊणा, या ऊई सकोआ कि सऊणे लगी रा ऊगा ओर से जगाणा चाईयो।” <verse eid="1KI 18:27" /><verse number="28" style="v" sid="1KI 18:28" />ओर तिने जोरे-जोरे की आका पाई-पाई की आपणी रवाजा रे मुताबिक छुरी ओर बड़छेया साथे आपू खे एड़ा कायल कित्तेया कि खून ई खून ऊईगा। <verse eid="1KI 18:28" /><verse number="29" style="v" sid="1KI 18:29" />सेयो त्याड़िया तक ई क्या, बल्कि सांजा री पेंट चढ़ाणे रे बखतो तक भविष्यबाणी करदे रये, पर कोई आवाज नि सुणी ओर ना ई किने ज्वाब दित्तेया ओर ना किने त्यान दित्तेया।<note caller="+" style="f"><char style="fr" closed="false">18:29 </char><char style="ft" closed="false">प्रका. 13:13</char></note><verse eid="1KI 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1KI 18:30" />तेबे एलिय्याहे सारे लोका खे बोलेया, “मां नेड़े आओ; ओर सारे लोक तेस नेड़े आईगे। तेबे तिने यहोवे री बेदिया री जो टाल़ी ती थी मरम्मत कित्ती।” <verse eid="1KI 18:30" /><verse number="31" style="v" sid="1KI 18:31" />तेबे एलिय्याहे याकूबो रे पाऊआ रे मुताबिक जेसगे यहोवे रा ये वचन आया था, “तेरा नाओं इस्राएल ऊणा,” बारा पात्थर छाँटे, <verse eid="1KI 18:31" /><verse number="32" style="v" sid="1KI 18:32" />ओर तिना पात्थरा साथे यहोवे रे नाओं री एक बेदी बणाई जो पईले टाल़ी ती दी थी, ओर तेतेरे चऊँ कनारे इतणा बड़ा गड्डा खणी ता कि तिदे लगभग चौदा लीटर समायी सको। <verse eid="1KI 18:32" /><verse number="33" style="v" sid="1KI 18:33" />तेबे तिने बेदिया पाँदे लकड़िया सजाईया ओर बाच्छूए रे टुकड़े-टुकड़े करी की लकड़िया पाँदे राखी ते ओर बोलेया, “चार पाणिए रे कअड़े परी की होमबलिया रे डांगर ओर लकड़िया पाँदे सेटी देयो।” <verse eid="1KI 18:33" /><verse number="34" style="v" sid="1KI 18:34" />तेबे तिने बोलेया, “दूजी बार एड़ा ई करो।” तेबे लोके दूजी बार तेड़ा ई कित्तेया। फेर तिने बोलेया, “तीजी बार करो।” तेबे लोके तीजी बार बी तेड़ा ई कित्तेया। <verse eid="1KI 18:34" /><verse number="35" style="v" sid="1KI 18:35" />ओर पाणी बेदिया रे चऊँ कनारिये बह्यी गा ओर पाणिए साथे गड्डा बी परी गा। <verse eid="1KI 18:35" /><verse number="36" style="v" sid="1KI 18:36" />तेबे पेंट चढ़ाणे रे बखते एलिय्याह नबी नेड़े जाई की बोलणे लगेया, “ओ अब्राहम, इसहाक ओर इस्राएलो रे यहोवा परमेशर! आज ये दशी दे कि इस्राएलो दे तूँ ई परमेशर ए ओर आऊँ तेरा दास ए ओर मैं यो सारे काम तांते वचन पाई की करी राखे। <verse eid="1KI 18:36" /><verse number="37" style="v" sid="1KI 18:37" />ओ यहोवा! मेरी सुण, मेरी सुण, ताकि यो लोक जाणी लो कि ओ यहोवा, तूँ ई परमेशर ए ओर तूँ तिना रा मन वापस ल्याएया।”<verse eid="1KI 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 18:38" />तेबे यहोवे री आग सर्गो ते थाले आई ओर होमबलि, लकड़ी ओर पात्थरा ओर तूड़ा समेत फूकी ते ओर गड्डे रा पाणी बी सुकाईता। <verse eid="1KI 18:38" /><verse number="39" style="v" sid="1KI 18:39" />ये देखी की सारे लोक मुंए रे पारे थाले पड़ी की बोलणे लगे, “यहोवा ई परमेशर ए, यहोवा ई परमेशर ए;” <verse eid="1KI 18:39" /><verse number="40" style="v" sid="1KI 18:40" />एलिय्याहे तिना खे बोलेया, “बालो रे नबिया खे पकड़ी लो, तिना बीचा ते एक बी बची की नि जाओ;” तेबे तिने सेयो पकड़ी ले ओर एलिय्याहे सेयो थाले लई जाई की कीशोन नाल़े दे कायी ते।<verse eid="1KI 18:40" /></para>
  <para style="s">देशो रा सूका खत्म ऊणा</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 18:41" />तेबे एलिय्याहे अहाबो खे बोलेया, “उठी की खा-पी, कऊँकि पारी बर्खा ऊणे री आवाज आऊणे लगी री।” <verse eid="1KI 18:41" /><verse number="42" style="v" sid="1KI 18:42" />तेबे अहाब खाणे-पीणे चली गा ओर एलिय्याह कर्मेल पाह्ड़ो री चूँडिया पाँदे चढ़ीगा ओर जमीना दे पड़ी की आपणा मूँ जानूआ बीचे करी ता। <verse eid="1KI 18:42" /><verse number="43" style="v" sid="1KI 18:43" />ओर तिने आपणे सेवको खे बोलेया, “चढ़ी की समुद्रो रिया तरफा खे नजर करी की देख,” तेबे तिने चढ़ी की देखेया ओर वापस ऊई की बोलेया, “कुछ नि दिशदा।” एलिय्याहे बोलेया, “फेर सात बार जा।” <verse eid="1KI 18:43" /><verse number="44" style="v" sid="1KI 18:44" />साती बार तिने बोलेया, “देख, समुद्रो बीचा ते माणूंए रे आथो रा जा एक छोटा बादल़ उठणे लगी रा।” एलिय्याहे बोलेया, “अहाबो गे जाई की बोल कि रथो पाँदे चढ़ी की थाले जा, केथी एड़ा नि ओ कि तूँ बर्खा रिया बजअ ते एथी रूकी जाए।” <verse eid="1KI 18:44" /><verse number="45" style="v" sid="1KI 18:45" />थोड़ी जी देर बाद ई सर्ग अवा साथे उडाई री पऊण ओर तूफानो साथे काल़ा ऊईगा ओर पारी बर्खा ऊणे लगी ओर अहाब रथो पाँदे चढ़ी की यिज्रेलो खे गया।<note caller="+" style="f"><char style="fr" closed="false">18:45 </char><char style="ft" closed="false">याकू. 5:18</char></note> <verse eid="1KI 18:45" /><verse number="46" style="v" sid="1KI 18:46" />तेबे यहोवे री शक्ति एलिय्याह पाँदे एड़ी ऊई कि से लक बानी की अहाबो ते आगे-आगे यिज्रेल शईरो तक दौड़दा चली गा।<note caller="+" style="f"><char style="fr" closed="false">18:46 </char><char style="ft" closed="false">लूक. 12:35 </char></note><verse eid="1KI 18:46" /></para>
  <chapter eid="1KI 18" />
  <chapter number="19" style="c" sid="1KI 19" />
  <para style="s">एलिय्याह रा सीनै पाह्ड़ो पाँदे नठणा</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 19:1" />तेबे राजा अहाबे आपणी लाड़ी ईजेबेला खे एलिय्याह रे सारे कामा रे बारे दे दशेया कि तिने सारे बाल देवते रे नबी तलवारी साथे किंयाँ काये। <verse eid="1KI 19:1" /><verse number="2" style="v" sid="1KI 19:2" />तेबे ईजेबेले एलिय्याहो गे एक दूत पेजी की सन्देशा पेजेया, “जे आऊँ काल एस ई बखते तेरे प्राण तिना नबीया जेड़े नि करी देऊँ तो देवता मां साथे तेड़ा ई बल्कि तेसते बी जादा करो।” <verse eid="1KI 19:2" /><verse number="3" style="v" sid="1KI 19:3" />ये सुणी की एलिय्याह आपणे प्राण बचाणे खे नठी गा ओर यहूदा प्रदेशो रे बेर्शेबा जगा दे पऊँची की आपणा सेवक तेथी छाडीता। <verse eid="1KI 19:3" /><verse number="4" style="v" sid="1KI 19:4" />ओर आपू जंगल़ो दे एकी दिनो रिया बाटा दे जाई की एक झाऊए रे डाल़ो निठे बैठी गा, तेती तिने ये बोली की आपणी मौत मांगी, “ओ यहोवा बस कर, एबे मेरे प्राण लई लो, कऊँकि आऊँ आपणे बुजुर्गा ते ठीक नि ए।” <verse eid="1KI 19:4" /><verse number="5" style="v" sid="1KI 19:5" />से झाऊए रे डाल़ो निठे लेटी की सयी गा ओर देखो, एकी दूते तेसखे छुँईं की बोलेया, “उठी की खा।” <verse eid="1KI 19:5" /><verse number="6" style="v" sid="1KI 19:6" />तिने नजर करी की क्या देखेया कि मेरे सरयाणे दे पात्थरो पाँदे पक्की री एक रोटी ओर एक कड़ा पाणिए रा राखी राखेया। तेबे तिने खाया-पिया ओर फेर लेटीगा। <verse eid="1KI 19:6" /><verse number="7" style="v" sid="1KI 19:7" />दूजी बार यहोवे रा दूत आया ओर तेसखे छुँईं की बोलेया, “उठी की खा, कऊँकि ताखे एबु बड़ा दूर चलणा ए।” <verse eid="1KI 19:7" /><verse number="8" style="v" sid="1KI 19:8" />तेबे तिने उठी की खाया-पिया ओर तेसा ई रोटिया साथे तागत पायी की चाल़ी दिन-रात चलदे-चलदे परमेशरो रे पाह्ड़ होरेबो दे पऊँचेया।<verse eid="1KI 19:8" /></para>
  <para style="s">परमेशरो रा एलिय्याह खे दर्शण देणा</para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 19:9" />तेथी से एकी गुफा दे जाई की रूकेया ओर यहोवे रा ये वचन तेसगे पऊँचेया, “ओ एलिय्याह तूँ एथी क्या करने लगी रा?” <verse eid="1KI 19:9" /><verse number="10" style="v" sid="1KI 19:10" />तिने ज्वाब दित्तेया, “सेना रे परमेशर यहोवे रिया तँईं माखे बऊत जल़न ऊई, कऊँकि इस्राएली लोक तेरी वाचा खे पूली गे दे, तेरी बेदिया टाल़ी तिया ओर तेरे भविष्यबक्ता तलवारी साथे काई ते ओर आऊँ ई कल्ला बची गा ओर सेयो मेरे प्राण बी लयी लणा चाओए।” <verse eid="1KI 19:10" /><verse number="11" style="v" sid="1KI 19:11" />तेबे यहोवे एलिय्याह खे बोलेया, “एता ते निकल़ी की एस पाह्ड़ो पाँदे मां सामणे खड़ा ओ।” मां तेरे नेड़ो रिये ऊई की जाणा। तेबे एक प्रचण्ड तूफान चलेया। जेतेरिया बजा ते पाह्ड़ फटणे लगे, ओर पात्थर टुटणे लगे, तेबे तूफानो ते बाद भूकम्प ऊआ। पर इना दुँईं जगा दे यहोवा तिना बीचे नि था। <verse eid="1KI 19:11" /><verse number="12" style="v" sid="1KI 19:12" />तेबे भूकम्पो ते बाद आग दिशी, तेबे बी यहोवा तेसा आगी दे नि था; तेबे आगी ते बाद एक दबी री जी आवाज सुणी। <verse eid="1KI 19:12" /><verse number="13" style="v" sid="1KI 19:13" />ये आवाज सुणदे ई एलिय्याहे आपणा मूँ चाद्दरी साथे टकी ता ओर बारे जाई की गुफा रे द्वारो पाँदे खड़ा ऊआ। तेबे तेसखे एक आवाज सुणी, “ओ एलिय्याह तूँ एती क्या करने लगी रा?” <verse eid="1KI 19:13" /><verse number="14" style="v" sid="1KI 19:14" />तिने ज्वाब दित्तेया, “माखे सेना रे परमेशर यहोवे रिया तँईं बऊत जल़न ऊई, कऊँकि इस्राएली लोक तेरी वाचा खे पूली गे दे, ओर तेरी बेदिया टाल़ी तिया ओर तेरे नबी तलवारी साथे काई ते ओर आऊँ ई कल्ला रयी गा दा ओर सेयो माखे बी काणे खे टोल़ने लगी रे।”<note caller="+" style="f"><char style="fr" closed="false">19:14 </char><char style="ft" closed="false">रोम. 11:3</char></note> <verse eid="1KI 19:14" /><verse number="15" style="v" sid="1KI 19:15" />यहोवे तेसखे बोलेया, “वापस ऊई की दमिश्को रे जंगल़ो खे जा ओर तेती पऊँची की अरामो रा राजा ऊणे खे, हजाएलो रा अभिषेक कर, <verse eid="1KI 19:15" /><verse number="16" style="v" sid="1KI 19:16" />ओर इस्राएलो रा राजा ऊणे खे निमशीए रे पोते येहूए रा ओर आपणी जगा पाँदे नबी ऊणे खे आबेल-महोला रे शापातो रे पाऊ एलीशा रा अभिषेक करना। <verse eid="1KI 19:16" /><verse number="17" style="v" sid="1KI 19:17" />ओर हजाएलो री तलवारी साथे जो कोई बची जाओ से यहूए कायी देणे ओर जो कोई येहूए री तलवारी ते बची जाओगे, से एलीशा नबीए काई देणे। <verse eid="1KI 19:17" /><verse number="18" style="v" sid="1KI 19:18" />तेबे बी मां 7,000 मर्द बचाई की राखणे। यो सेयो ए, जो ना तो बाल देवते रे आगे कुटणे टेके ओर ना ई तिने तेसरी आराधना कित्ती।”<verse eid="1KI 19:18" /></para>
  <para style="s">एलीशा रा नबी बणना</para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 19:19" />तेबे से तेथा ते चली गा ओर शापातो रा पाऊ एलीशा तेसखे मिलेया जिने आपू ते आगे बल़दा रिया बारा जोड़िया करी की आपू बारी जोड़िया साथे अल़ बाणे लगी रा था। तेसगे जाई की एलिय्याहे आपणी चाद्दर तेसखे टखाई ती। <verse eid="1KI 19:19" /><verse number="20" style="v" sid="1KI 19:20" />तेबे से बल़दा खे छाडी की एलिय्याह पीछे दौड़ेया ओर बोलणे लगेया, “माखे आपणे माया-बाओ खे चूमणे दे, तेबे मां तां पीछे चलणा।” तिने बोलेया, “वापस चली जा, मैं तां साथे क्या करी राखेया?”<note caller="+" style="f"><char style="fr" closed="false">19:20 </char><char style="ft" closed="false">मत्ती 8:21, लूक. 9:61</char></note> <verse eid="1KI 19:20" /><verse number="21" style="v" sid="1KI 19:21" />तेबे से तेसगे ते वापस चली गा ओर बल़दा री एक जोड़ी लई की बलि कित्ते ओर बल़दा रा समान फूकी की मास पकाई की आपणे लोका खे दित्तेया ओर तिने खाया; तेबे से लक बानी की एलिय्याह पीछे चलेया ओर तेसरी सेवा-टईल करने लगेया।<verse eid="1KI 19:21" /></para>
  <chapter eid="1KI 19" />
  <chapter number="20" style="c" sid="1KI 20" />
  <para style="s">सीरिया री सेना रा इस्राएलो पाँदे अमला करना</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 20:1" />अरामो रे राजे बेन्हददे आपणी सारी सेना कट्ठी कित्ती ओर तेस साथे बत्ती राजा, कोड़े ओर रथ थे; तिना खे साथे लई की तिने सामरिया पाँदे अमला कित्तेया ओर तेसखे केरी की तेसरे खलाफ लड़ेया। <verse eid="1KI 20:1" /><verse number="2" style="v" sid="1KI 20:2" />ओर तिने शईरो दे इस्राएलो रे राजा अहाबो गे दूत ये बोलणे खे पेजे, “बेन्हदद ताखे ईंयाँ बोलोआ, <verse eid="1KI 20:2" /><verse number="3" style="v" sid="1KI 20:3" />तेरा सूईना चाँदी मेरा ए ओर तेरिया जवाणसा ओर बच्चेया बीचा ते जो ठीक-ठीक ए सेयो बी सारे मेरे ए।”<verse eid="1KI 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 20:4" />इस्राएलो रे राजे तेसखे सन्देशा पेजेया, “ओ मेरे प्रभु! ओ राजा! तेरे वचनो रे मुताबिक आऊँ ओर जो कुछ मेरा ए, सारा तेरा ए।” <verse eid="1KI 20:4" /><verse number="5" style="v" sid="1KI 20:5" />तिने ई दूते फेर आई की बोलेया, “बेन्हदद ताखे ईंयाँ बी बोलोआ कि मैं ताखे ये सन्देश पेजेया था कि ताखे आपणा सूईना, चाँदी, जवाणसा ओर बच्चे बी माखे देणे पड़ने। <verse eid="1KI 20:5" /><verse number="6" style="v" sid="1KI 20:6" />इजी री खातर काल एस ई बखते मां आपणे कर्मचारी तांगे पेजणे ओर तिना तेरे ओर तेरे कर्मचारिया रे कअरे टोल़-टाल़ करनी ओर तेरिया जो अच्छिया चीजा तिना काडणिया तिना सेयो आपू साथे ली आऊणियां।” <verse eid="1KI 20:6" /><verse number="7" style="v" sid="1KI 20:7" />तेबे इस्राएलो रे राजे सारे बुजुर्गा खे बुलाई की बोलेया, “सोच-बिचार करो कि से माणूं आसा रा नुकशाण ई चाओआ; तिने मांते मेरी जवाणसा, बाल़क, सूईना, चाँदी मँगवाई राखेया ओर मैं ना नि कित्ती।” <verse eid="1KI 20:7" /><verse number="8" style="v" sid="1KI 20:8" />तेबे सारे बुजुर्गे ओर आम माणूंए तेसखे बोलेया, “तेसरी नि सुणनी ओर ना मानणी।” <verse eid="1KI 20:8" /><verse number="9" style="v" sid="1KI 20:9" />तेबे राजे बेन्हददो रे दूता खे बोलेया, “मेरे प्रभु राजे खे मेरी तरफा ते बोलो कि जो कुछ तैं पईले आपणे दासो ते चाया था, से तो मां करना, पर ये मांते नि ऊणा।” तेबे बेन्हददो रे दूते जाई की तेसखे ये ज्वाब सुणाई ता। <verse eid="1KI 20:9" /><verse number="10" style="v" sid="1KI 20:10" />तेबे बेन्हददे राजा अहाबो गे सन्देशा पेजेया, “जे सामरिया दे इतणी तूड़ निकल़ो कि मां पीछे चलणे वाल़ेया री मुट्ठी परी जाओ तो देवता मां साथे एड़ा ई बल्कि इजी ते बी जादा करो।”<note caller="+" style="f"><char style="fr" closed="false">20:10 </char><char style="ft" closed="false">मत्ती 12:42, लूक. 11:31</char></note> <verse eid="1KI 20:10" /><verse number="11" style="v" sid="1KI 20:11" />इस्राएलो रे राजे ज्वाब देई की बोलेया, “तेसखे बोलो कि जो अथियार बानोआ से तेस जेड़ा नि फूलो जो तिना खे उतारोआ।” <verse eid="1KI 20:11" /><verse number="12" style="v" sid="1KI 20:12" />ये वचन सुणदे ई से जो ओरी राजेया समेत डेरेया दे पीणे लगी रा था, तिने आपणे कर्मचारिया खे बोलेया, “अथियार बानो,” तेबे तिने शईरो रे खलाफ अथियार बाने।<verse eid="1KI 20:12" /></para>
  <para style="s">अहाबो रा जीतणा</para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 20:13" />तेबे एक नबीए इस्राएलो रे राजा अहाबो गे जाई की बोलेया, “यहोवा ताखे ईंयाँ बोलोआ कि ये बड़ी पीड़ जो तैं देखी राखी, से सारी मां आज तेरे आथो दे करी देणी, इजी ते तां जाणी लणा कि आऊँ यहोवा ए।” <verse eid="1KI 20:13" /><verse number="14" style="v" sid="1KI 20:14" />अहाबे पूछेया, “केसरे जरीये?” तिने बोलेया, “यहोवा ईंयाँ बोलोआ कि प्रदेशो रे परदाना रे जरीये!” फेर तिने पूछेया, “युद्ध केस शुरू करना?” तिने ज्वाब दित्तेया, “तां ई करना।” <verse eid="1KI 20:14" /><verse number="15" style="v" sid="1KI 20:15" />तेबे तिने प्रदेशो रे परदाना री गिणती लई ओर सेयो 232 निकल़े ओर तिना ते बाद तिने सारे इस्राएली लोका री गिणती लई ओर सेयो 7,000 निकल़े। <verse eid="1KI 20:15" /><verse number="16" style="v" sid="1KI 20:16" />यो त्याड़िया निकल़ी गे, तेस बखते बेन्हदद आपणे मतदगार बत्ती राजेया साथे डेरेया दे शराब पी की मतवाल़ा ऊई रा था।<verse eid="1KI 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 20:17" />जो प्रदेशो रे परदान थे तिना रे सेवक पईले निकल़ी गे। तेबे बेन्हददे दूत पेजे ओर तिने तेसखे बोलेया, “सामरिया ते कुछ माणूं आऊणे लगी रे।” <verse eid="1KI 20:17" /><verse number="18" style="v" sid="1KI 20:18" />तिने बोलेया, “चाए सेयो मेल करने खे निकल़े ओ, चाए लड़ने खे, तेबे बी तिना खे जिऊँदे ई पकड़ी की ल्याओ।” <verse eid="1KI 20:18" /><verse number="19" style="v" sid="1KI 20:19" />तेबे प्रदेशो रे परदाना रे सेवक ओर तिना ते पिछली सेना रे सिपाई शईरो ते निकल़े। <verse eid="1KI 20:19" /><verse number="20" style="v" sid="1KI 20:20" />ओर सेयो आपू सामणे रे मर्दा खे काणे लगे ओर अरामी नठीगे ओर इस्राएलिये तिना रा पीछा कित्तेया ओर अरामो रा राजा बेन्हदद, सवारा साथे कोड़ेया पाँदे चढ़ेया ओर नठी की बचीगा। <verse eid="1KI 20:20" /><verse number="21" style="v" sid="1KI 20:21" />राजा अहाब आपणी इस्राएलो री सारी सेना खे लई की आगे चलेया ओर तिने अरामो री सेना रे सारे कोड़े ओर रथ आपणे कब्जे दे करी ले। ईंयाँ राजा अहाबे अरामी सेना बुरे तरीके ते अराई। <verse eid="1KI 20:21" /><verse number="22" style="v" sid="1KI 20:22" />तेबे तिने नबीए इस्राएलो रे राजे गे जाई की बोलेया, “जाई की लड़ाई करने खे आपू खे मजबूत कर ओर सचेत ऊई की सोच कि क्या करना चाईयो, कऊँकि नवां साल ऊँदे ई अरामो रे राजे तां पाँदे फेर अमला करना।”<verse eid="1KI 20:22" /></para>
  <para style="s">बेन्हददो रा दूजी बार फेर अमला करना</para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 20:23" />तेबे अरामो रे राजे रे कर्मचारिये तेसखे बोलेया, “तिना लोका रा देवता पाह्ड़ी देवता ए, इजी बजअ ते सेयो आसा पाँदे प्रबल ऊए; इजी री खातर जे आसे तिना साथे मैदानी जगा दे लड़ूँगे तो आसे पक्का तिना पाँदे प्रबल ऊई जाणे। <verse eid="1KI 20:23" /><verse number="24" style="v" sid="1KI 20:24" />ओर ये काम बी कर, मतलब सबी राजेया रा पद लई लो ओर तिना री जगा पाँदे सेनापतिया खे ठराई दे। <verse eid="1KI 20:24" /><verse number="25" style="v" sid="1KI 20:25" />फेर एक ओर सेना जो तेरी तेसा सेना रे बराबर ओ जो खत्म ऊई गी री, कोड़े रे बदले कोड़ा ओर रथो रे बदले रथ, आपणिया तँईं गिणी लो; तेबे आसा तिना साथे सवीं जगा दे लड़ना ओर आसे तिना पाँदे पक्का जीती जाणे।” तिना री ये सला मानी की बेन्हददे तेड़ा ई कित्तेया। <verse eid="1KI 20:25" /><verse number="26" style="v" sid="1KI 20:26" />ओर नवां साल लगदे ई बेन्हददे अरामी लोक कट्ठे कित्ते ओर इस्राएली लोका साथे लड़ने खे अपेक शईरो खे गया।<verse eid="1KI 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 20:27" />ओर इस्राएली बी कट्ठे कित्ते ओर तिना खे खाणे री त्यारी ऊई; तेबे सेयो तिना रा सामणा करने खे गये ओर इस्राएली तिना सामणे डेरे लगाई की बाकरिया रे दो चूण्डो जेड़े दिखो थे, पर अरामिया साथे देश परी गा।<verse eid="1KI 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 20:28" />तेबे परमेशरो रे तिने माणूंए इस्राएलो रे राजे गे जाई की बोलेया, “यहोवा ईंयाँ बोलोआ कि अरामिये ये बोली राखेया कि यहोवा पाह्ड़ी देवता ए, पर मैदानी जगा रा नि ए, इजी बजअ ते मां से बड़ी पीड़ तेरे आथो दे करी देणी, तेबे तुसा खे पता लगी जाणा कि आऊँ यहोवा ए।” <verse eid="1KI 20:28" /><verse number="29" style="v" sid="1KI 20:29" />ओर तिने सात दिन तक आमणे-सामणे डेरे लगाई की राखे; तेबे सातुए दिने लड़ाई छिड़ी गी ओर एकी दिनो दे इस्राएलिये 100,000 अरामी सिपाई कायी ते।<verse eid="1KI 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1KI 20:30" />जो बची गे सेयो अपेको खे नठी की शईरो दे कूसी गे ओर तेती तिना बचे रे लोका बीचा ते 27,000 सिपाई शईरो री दवाल टल़ने ते दबी की मरी गे। बेन्हदद बी नठी गा ओर शईरो दे एकी पीतरले कमरे दे चली गा।<verse eid="1KI 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 20:31" />तेबे तेसरे कर्मचारिये तेसखे बोलेया, “सुण, आसे तो सुणी राखेया कि इस्राएलो रे कराने दे दया करने वाल़े राजा ओए, इजी री खातर आसा खे लको दे टाट बानी की ओर सिरो पाँदे रस्सिया बानी की इस्राएलो रे राजे गे जाणे दे, क्या पता से तेरे प्राण बचाई देयो।” <verse eid="1KI 20:31" /><verse number="32" style="v" sid="1KI 20:32" />तेबे सेयो लको दे खसरा टाल्ला ओर सिरो दे रस्सिया बानी की इस्राएलो रे राजे गे जाई की बोलणे लगे, “तेरा दास बेन्हदद ताखे बोलोआ कि कृपा करी की माखे जिऊँदा रणी दे।” राजे ज्वाब दित्तेया, “क्या से एबुए तक जिऊँदा ए? से तो मेरा पाई ए।”<verse eid="1KI 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 20:33" />तिने लोके ये शुभ शकुन जाणी की, फटाफट बूजणे री कोशिश कित्ती कि ये एसरे मनो री गल्ल ए कि नि, ओर तिने बोलेया, “आ, तेरा पाई बेन्हदद।” राजे बोलेया, “जाई की तेसखे ली आओ।” तेबे बेन्हदद तेसगे आया ओर तिने से आपणे रथो पाँदे चढ़ाईता। <verse eid="1KI 20:33" /><verse number="34" style="v" sid="1KI 20:34" />तेबे बेन्हददे तेसखे बोलेया, “जो शईर मेरे बाओए तेरे बाओ ते लई ले थे, सेयो मां वापस करी देणे ओर जेड़ी मेरे बाओए सामरिया दे आपू खे सड़का बणाईया, तेड़िया ई तूँ दमिश्को दे सड़का बणवाया।” अहाब राजे बोलेया, “आऊँ एसा गल्ला रिया बजा ते ताखे छाडी देऊँआ” तेबे तिने तेस साथे वादा करी की से आजाद करी ता। <verse eid="1KI 20:34" /><verse number="35" style="v" sid="1KI 20:35" />इजी ते बाद नबिया रे दलो बीचा ते एकी जणे यहोवे रा वचन पाई की आपणे साथिये खे बोलेया, “माखे बा,” जेबे तिने माणूंए तेसखे बाणे खे ना करी ती, <verse eid="1KI 20:35" /><verse number="36" style="v" sid="1KI 20:36" />तेबे तिने तेसखे बोलेया, “तैं यहोवे रा वचन नि मानेया, इजी बजअ ते सुण, जिंयाँ ई तूँ एथा ते चली जाणा, तिंयाँ ई शेरो तूँ काई देणा।” तेबे जिंयाँ से तेसगे ते चली गा, तिंयाँ ई तेसखे एक शेर मिलेया ओर से काई ता। <verse eid="1KI 20:36" /><verse number="37" style="v" sid="1KI 20:37" />तेबे तेसखे दूजा माणूं मिलेया ओर तेसखे बी तिने बोलेया, “माखे काईदे।” तेबे तिने तेसरे एड़ी बाई कि से कायल ऊईगा।<verse eid="1KI 20:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 20:38" />तेबे से नबी चली गा ओर आखी पगड़िया साथे टखी की राजे खे बाटा रे न्याल़दा ऊआ खड़ा रया। <verse eid="1KI 20:38" /><verse number="39" style="v" sid="1KI 20:39" />जेबे अहाब राजा नेड़े ऊई की जाणे लगी रा था, तेबे तिने तेसरी दुहाई देई की बोलेया कि जेबे तेरा दास युद्धो रे मैदानो रे गया था तेबे कोई माणूं मेरी तरफा खे मुड़ेया ओर केसी माणूंए खे मांगे ली आया ओर माखे बोलेया, “एस माणूंए री चौकसी कर; जे ये किंयाँ बी छूटी जाओ, तो एसरे प्राणो रे बदले ताखे आपणा प्राण देणा पड़ना, नई तो पैंती किलो चाँदी देणा पड़ना। <verse eid="1KI 20:39" /><verse number="40" style="v" sid="1KI 20:40" />तिजी ते बाद तेरा दास ओरे-पोरे कामो रे फसी गा, तेबे से नि मिलेया।” इस्राएलो रे राजे तेसखे बोलेया, “तेरा एड़ा ई न्याय ऊणा; तैं आपू आपणा न्याय करी राखेया।” <verse eid="1KI 20:40" /><verse number="41" style="v" sid="1KI 20:41" />नबीए फटाफट आपणिया आखी ते पगड़ी टाई, तेबे इस्राएलो रे राजे से पछयाणी ला कि से कोई नबी ए। <verse eid="1KI 20:41" /><verse number="42" style="v" sid="1KI 20:42" />तेबे तिने राजे खे बोलेया, “यहोवा ताखे ईंयाँ बोलोआ इजी खे कि तैं आपणे आथो ते एक एड़ा माणूं जाणे दित्तेया, जो मैं नाश ऊणे खे ठराया था, ताखे तेसरे प्राणो रे बदले आपणा प्राण ओर तेसरी प्रजा रे बदले आपणी प्रजा देणी पड़नी।” <verse eid="1KI 20:42" /><verse number="43" style="v" sid="1KI 20:43" />तेबे इस्राएलो रा राजा उदास ओर दु:खी ऊई की सामरिया दे आपणे कअरो खे आया।<verse eid="1KI 20:43" /></para>
  <chapter eid="1KI 20" />
  <chapter number="21" style="c" sid="1KI 21" />
  <para style="s">नाबोतो री अत्या ओर परमेशरो रा गुस्सा</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 21:1" />नाबोत नाओं रा एक माणूं था जो यिज्रेल शईरो रा रणे वाल़ा था। तेसगे एक अंगूरा रा बगीचा था जो सामरिया रे राजा अहाबो रे मईलो रे नेड़े यिज्रेल शईरो दे था। <verse eid="1KI 21:1" /><verse number="2" style="v" sid="1KI 21:2" />इना गल्ला ते बाद अहाबे नाबोतो खे बोलेया, “तेरे अंगूरा रा बगीचा मेरे कअरो रे नेड़े ए, तूँ तेस माखे देई दे, ताकि आऊँ तिदे साग-पातो रा बगीचा लगाऊँ ओर मां तिजी रे बदले ताखे एक अच्छा बगीचा देणा, नई तो जे तेरी इच्छा ओ तो मां ताखे तिजी री कीमत देई देणी।”<verse eid="1KI 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 21:3" />नाबोते अहाबो खे बोलेया, “यहोवा नि करो कि आऊँ आपणे बुजुर्गा रा इस्सा ताखे देऊँ।” <verse eid="1KI 21:3" /><verse number="4" style="v" sid="1KI 21:4" />यिज्रेली नाबोतो रे एसा गल्ला रिया बजअ ते कि मां ताखे आपणे बुजुर्गा रा निज इस्सा नि देणा, अहाब उदास ओर दु:खी ऊई की आपणे कअरो खे चली गा ओर टखणो पाँदे लेटीगा ओर मूँ फेरी ला ओर कोई रोटी नि खाई। <verse eid="1KI 21:4" /><verse number="5" style="v" sid="1KI 21:5" />तेबे तेसरी लाड़ी ईजेबेले तेसगे आई की पूछेया, “तेरा मन एड़ा उदास कऊँ ए कि तूँ कुछ खाया नि करदा?” <verse eid="1KI 21:5" /><verse number="6" style="v" sid="1KI 21:6" />तिने बोलेया, “बजअ ये कि मैं यिज्रेली नाबोतो खे बोलेया कि पैसा लई की माखे आपणा अंगूरा रा बगीचा देई दे, नई तो अगर तूँ चाए तो आऊँ ताखे तिजी रे बदले दूजा अंगूरा रा बगीचा देई देऊँगा ओर तिने बोलेया कि मां ताखे आपणा अंगूरा रा बगीचा नि देणा।” <verse eid="1KI 21:6" /><verse number="7" style="v" sid="1KI 21:7" />तेबे तेसरी लाड़िए तेसखे बोलेया, “क्या तूँ इस्राएलो पाँदे राज करेया कि नई? उठी की रोटी खा ओर तेरा मन खुश ओ; यिज्रेली नाबोतो रा अंगूरा रा बगीचा मां ताखे दलाई देणा।”<verse eid="1KI 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 21:8" />तेबे तेसे अहाबो रे नाओं री चिट्ठी लिखी की तेसरी गूठिया री छाप लगाई की तिना बुजुर्गा ओर अमीरा गे पेजी ती जो तेस शईरो दे नाबोतो रे पड़ोसो दे रओ थे। <verse eid="1KI 21:8" /><verse number="9" style="v" sid="1KI 21:9" />तेते पर्चिया दे तेसे ईंयाँ लिखेया, “बअरतो रा प्रचार करो ओर नाबोत तेसरे लोका सामणे ऊच्ची जगा दे बठयाल़ना। <verse eid="1KI 21:9" /><verse number="10" style="v" sid="1KI 21:10" />तेबे दो नीच माणूं तेस सामणे बठयाल़ने जो चूठी गवाई देई की तेसखे बोलो कि तैं परमेशर ओर राजा दुँईं री बेज्जती करी राखी। तेबे तुसे से बारे निणा ओर तेस पाँदे पात्थर बाणे कि से मरी जाओ।” <verse eid="1KI 21:10" /><verse number="11" style="v" sid="1KI 21:11" />ईजेबेला री पर्चिया री आज्ञा रे मुताबिक शईरो दे रणे वाल़े बुजुर्गे ओर अमीरे बअरतो रा प्रचार कित्तेया, <verse eid="1KI 21:11" /><verse number="12" style="v" sid="1KI 21:12" />ओर नाबोत लोका सामणे ऊच्ची जगा दे बठयाल़ेया। <verse eid="1KI 21:12" /><verse number="13" style="v" sid="1KI 21:13" />तेबे दो नीच माणूं आई की तेस सामणे बैठीगे ओर तिने नीच माणूंए लोका सामणे नाबोतो रे खलाफ ये चूठी गवाई दित्ती कि इने परमेशर ओर राजा दुँईं री निन्दा करी राखी। तेबे तिने से शईरो ते बारे निया ओर तेसखे पात्थर बाए ओर से मरी गा। <verse eid="1KI 21:13" /><verse number="14" style="v" sid="1KI 21:14" />तेबे तिने ईजेबेला गे ये सन्देशा पेजेया कि नाबोत पत्थराव करी की काई ता रा। <verse eid="1KI 21:14" /><verse number="15" style="v" sid="1KI 21:15" />ये सुणदे ई कि नाबोत पत्थराव करी की काई ता रा, ईजेबेले अहाब राजे खे बोलेया, “उठी की यिज्रेली नाबोतो रा अंगूरा रा बगीचा जेतेखे तिने पैसा लई की बी ताखे देणे ते ना करी ती थी आपणे कब्जे दे लई लो, कऊँकि नाबोत जिऊँदा नि ए।”<verse eid="1KI 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 21:16" />यिज्रेली नाबोतो री मौता रा सन्देश मिलदे ई अहाब तेसरा अंगूरा रा बगीचा आपणे अक्को रे लणे खे जाणे खे उठी की खड़ा ऊआ। <verse eid="1KI 21:16" /><verse number="17" style="v" sid="1KI 21:17" />तेबे यहोवे रा ये वचन तिशबी एलिय्याह नबीए गे पऊँचेया, <verse eid="1KI 21:17" /><verse number="18" style="v" sid="1KI 21:18" />“चल, सामरिया रे रणे वाल़े इस्राएलो रे राजा अहाबो साथे मिलणे खे जा; से तो नाबोतो रे अंगूरा रे बगीचे रे तेतेखे आपणे अक्को रे लणे खे से तेती जाई रा। <verse eid="1KI 21:18" /><verse number="19" style="v" sid="1KI 21:19" />ओर तेसखे ईंयाँ बोलणा कि यहोवा ईंयाँ बोलोआ कि क्या तैं से नि काया ओर अधिकारी बी बणी की बैठी गा? तेबे तैं तेसखे ये बी बोलणा कि यहोवा ईंयाँ बी बोलोआ कि जेते जगा रे कुत्तेया नाबोतो रा खून चाटेया, तेते जगा रे कुत्तेया तेरा बी खून चाटणा।” <verse eid="1KI 21:19" /><verse number="20" style="v" sid="1KI 21:20" />एलिय्याह खे देखी की अहाबे बोलेया, “ओ मेरे दुश्मण! क्या तैं मेरा पता लगाई राखेया?” तिने बोलेया, “आ, लगाई तो राखेया ओर इजी री बजअ ये कि जो यहोवे री नजरा रे बुरा ए, तेतेखे करने खे तैं आपू खे बेचीता रा।” <verse eid="1KI 21:20" /><verse number="21" style="v" sid="1KI 21:21" />मां तां पाँदे एड़ी मुसीबत पाणी कि तूँ पूरी तरअ ते मिटाई देणा ओर अहाबो रे कअरो रा एक-एक पाऊ ओर क्या गुलाम, क्या आजाद, इस्राएलो दे हर रणे वाल़ा बी नाश करी देणा। <verse eid="1KI 21:21" /><verse number="22" style="v" sid="1KI 21:22" />ओर मां तेरा कराना नबातो रे पाऊ यारोबाम ओर अहिय्याह रे पाऊ बाशा रा जा करी देणा; इजी खे कऊँकि तैं माखे रोष चढ़ाई राखेया ओर इस्राएलो ते पाप करवाई राखेया। <verse eid="1KI 21:22" /><verse number="23" style="v" sid="1KI 21:23" />ओर यहोवा ईंयाँ बी बोलोआ, “तेरी लाड़ी ईजेबेला री लाश यिज्रेल शईरो रे कुत्तेया खाणी।” <verse eid="1KI 21:23" /><verse number="24" style="v" sid="1KI 21:24" />अहाबो रे शईरो रा जो कोई मरी जाओगा, से कुत्तेया खाणा ओर जो कोई मैदानो दे मरना से सर्गो रे पंछिया खाई देणा। <verse eid="1KI 21:24" /><verse number="25" style="v" sid="1KI 21:25" />सच्ची अहाबो जेड़ा ओर कोई नि था जिने आपणी लाड़ी ईजेबेला रे सकेल़ने पाँदे सेयो काम करने खे जो यहोवे री नजरा दे बुरे ए, आपू खे बेचीता था। <verse eid="1KI 21:25" /><verse number="26" style="v" sid="1KI 21:26" />से तो तिना एमोरिया जेड़ा ए जो यहोवे इस्राएली लोका रे सामणे देशो ते काडे थे कऊँकि सेयो बऊत ई बुरे काम करो थे, मतलब मूर्तिया री आराधना करो थे। अहाब बी तेड़े ई काम करने लगेया था जो यहोवे रे खलाफ था। <verse eid="1KI 21:26" /><verse number="27" style="v" sid="1KI 21:27" />एलिय्याह रे इना वचना खे सुणी की अहाबे आपणे टाल्ले फाड़े ओर आपणे शरीरो दे टाट लपेटी की बअरत करने लगेया ओर टाट ई पईनी की रणे लगेया ओर नांगे पैरे चलणे लगेया। <verse eid="1KI 21:27" /><verse number="28" style="v" sid="1KI 21:28" />तेबे यहोवे रा ये वचन तिशबी एलिय्याह गे पऊँचेया, <verse eid="1KI 21:28" /><verse number="29" style="v" sid="1KI 21:29" />क्या तैं देखेया कि अहाब मां सामणे नम्र बणी गा रा? इजी बजअ ते कि से मां सामणे नम्र बणी गा रा, मां से मुसीबत तेसरे जिऊँदे जियूए तेस पाँदे नि पाणी, पर तेसरे पाऊआ रे दिना दे मां तेसरे टब्बरो पाँदे मुसीबत पेजणी।<verse eid="1KI 21:29" /></para>
  <chapter eid="1KI 21" />
  <chapter number="22" style="c" sid="1KI 22" />
  <para style="s">मीकायाह नबीए रे जरीये अहाबो खे चतौणी</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 22:1" />लगभग तीऊँ साला तक अरामी ओर इस्राएलो बीचे कोई युद्ध नि ऊआ। <verse eid="1KI 22:1" /><verse number="2" style="v" sid="1KI 22:2" />तीजे सालो दे यहूदा रा राजा यहोशापात इस्राएलो रे राजे गे गया। <verse eid="1KI 22:2" /><verse number="3" style="v" sid="1KI 22:3" />तेबे इस्राएलो रे राजे आपणे कर्मचारिया खे बोलेया, “क्या तुसा खे पता ए कि गिलाद इलाके रा रामोत शईर म्हारा ए? तेबे आसे चुपचाप कऊँ रऊँए ओर तेस रामोत शईरो खे अरामो रे राजे रे आथो ते कऊँ नि छुड़ाई लंदे?” <verse eid="1KI 22:3" /><verse number="4" style="v" sid="1KI 22:4" />ओर तिने यहोशापातो ते पूछेया, “क्या तूँ मां साथे गिलाद इलाके रा रामोत शईरो दे लड़ने खे जाणा?” यहोशापाते इस्राएलो रे राजे खे ज्वाब दित्तेया, “जेड़ा तूँ ए तेड़ा ई आऊँ बीए। जेड़ी तेरी प्रजा ए तेड़ी मेरी प्रजा बीए ओर जेड़े तेरे कोड़े ए तेड़े मेरे बी कोड़े ए।” <verse eid="1KI 22:4" /><verse number="5" style="v" sid="1KI 22:5" />तेबे यहोशापाते इस्राएलो रे राजे खे बोलेया, “आज यहोवे री इच्छा पता करी लो।” <verse eid="1KI 22:5" /><verse number="6" style="v" sid="1KI 22:6" />तेबे इस्राएलो रे राजे नबिया खे जो कोई 400 मर्द थे कट्ठे करी की तिना ते पूछेया, “क्या आऊँ गिलाद इलाके रे रामोत शईरो साथे युद्ध करने खे अमला करुँ या रूकेया रा रऊँ?” तिने ज्वाब दित्तेया, “अमला कर, कऊँकि प्रभुए से राजे रे आथो दे करी देणा।” <verse eid="1KI 22:6" /><verse number="7" style="v" sid="1KI 22:7" />पर यहोशापाते पूछेया, “क्या एती यहोवे रा ओर बी कोई नबी ए जेसते आसे पूछूँ?” <verse eid="1KI 22:7" /><verse number="8" style="v" sid="1KI 22:8" />इस्राएलो रे राजे यहोशापातो ते बोलेया, “आ, यिम्ला रा पाऊ मीकायाह एक मर्द ओर ए जेसरे जरीये आसे यहोवे ते पूछी सकूँए। पर आऊँ तेसते नफरत करूँआ, कऊँकि से मेरे बारे दे पलाईया री नि, बल्कि नुकशाणो री ई भविष्यबाणी करोआ।” <verse eid="1KI 22:8" /><verse number="9" style="v" sid="1KI 22:9" />यहोशापाते बोलेया, “राजा एड़ा नि बोलो।” तेबे इस्राएलो रे राजे एक परदानो खे बुलाई की बोलेया, “यिम्ला रे पाऊ मीकायाह खे फटाफट ली आओ।” <verse eid="1KI 22:9" /><verse number="10" style="v" sid="1KI 22:10" />इस्राएलो रा राजा ओर यहूदा रा राजा यहोशापात, आपणे-आपणे राजेया रे टाल्ले पईनी की सामरिया रे बड़े द्वारो गे एक खुली जगा दे खल्याणो दे आपणे-आपणे सिंहासनो पाँदे बैठी रे थे ओर सारे भविष्यबक्ता तिना सामणे भविष्यबाणी करने लगी रे थे। <verse eid="1KI 22:10" /><verse number="11" style="v" sid="1KI 22:11" />तेबे कनाना रे पाऊ सिदकिय्याहे लोए रे सींग बणाई की बोलेया, “यहोवा ईंयाँ बोलोआ कि इना साथे तां अरामी सिपाई काई-काई की नाश करी देणे।” <verse eid="1KI 22:11" /><verse number="12" style="v" sid="1KI 22:12" />ओर सारे नबीए एतेरे बारे दे भविष्यबाणी करी की बोलेया, “गिलाद इलाके रे रामोत शईरो पाँदे अमला कर ओर तूँ सफल ऊणा; कऊँकि यहोवे से राजे रे आथो दे करी देणा।” <verse eid="1KI 22:12" /><verse number="13" style="v" sid="1KI 22:13" />ओर जो दूत मीकायाह खे बुलाणे खे गया था तिने बोलेया, “सुण, सारे भविष्यबक्ता एक ई मुंए ते राजे रे बारे दे शुभ वचन बोलोए तो तेरी गल्ल तिना जेड़ी ओ, तैं बी शुभ वचन बोलणे।” <verse eid="1KI 22:13" /><verse number="14" style="v" sid="1KI 22:14" />मीकायाहे बोलेया, “यहोवे री जिन्दगिया री कसम जो कुछ यहोवा माखे बोलो, मां से ई बोलणा।” <verse eid="1KI 22:14" /><verse number="15" style="v" sid="1KI 22:15" />जेबे से राजे गे आया तेबे राजे तेसते पूछेया, “ओ मीकायाह! क्या आसे गिलाद इलाके रे रामोत शईरो ते युद्ध करने खे जाऊँ या ना जाऊँ?” तिने तेसखे ज्वाब दित्तेया, “आ, अमला कर ओर तूँ सफल ओ ओर यहोवा तेसखे राजे रे आथो दे करी देयो।” <verse eid="1KI 22:15" /><verse number="16" style="v" sid="1KI 22:16" />राजे तेसखे बोलेया, “माखे कितणी बार ताखे कसम खुल़ाई की समजयाणा पड़ना कि तूँ यहोवे खे याद करी की मांगे सच ई बोल।” <verse eid="1KI 22:16" /><verse number="17" style="v" sid="1KI 22:17" />मीकायाहे बोलेया, “माखे सारा इस्राएल बिना गवाल़े री पेडा-बाकरिया जेड़ा पाह्ड़ो पाँदे तित्तर-बित्तर दिशेया ओर यहोवे रा ये वचन आया, तिना खे कोई चराणे वाल़ा नि ए; इजी री खातर सेओ आपणे-आपणे कअरे रामो दे वापस ऊई जाओ।”<note caller="+" style="f"><char style="fr" closed="false">22:17 </char><char style="ft" closed="false">मत्ती 9:36, मर. 6:34</char></note> <verse eid="1KI 22:17" /><verse number="18" style="v" sid="1KI 22:18" />तेबे इस्राएलो रे अहाब राजे यहोशापातो खे बोलेया, “क्या मैं ताखे बोलेया नि था कि तेस मेरे बारे दे पलाईया री नि, पर नुकशाणो री ई भविष्यबाणी करनी।” <verse eid="1KI 22:18" /><verse number="19" style="v" sid="1KI 22:19" />मीकायाहे बोलेया, “इजी बजअ ते तूँ यहोवे रा ये वचन सुण माखे सिंहासनो पाँदे बैठेया रा यहोवा ओर तेसरे दाँणे-खूँजे खड़ी री तेसरी स्वर्गो री सारी सेना दिशी री।”<note caller="+" style="f"><char style="fr" closed="false">22:19 </char><char style="ft" closed="false">प्रका. 4:2, प्रका. 4:9,10, प्रका. 5:1,7,13 प्रका. 6:16, प्रका. 7:10, प्रका. 7:15, प्रका. 19:4, प्रका. 21:5</char></note> <verse eid="1KI 22:19" /><verse number="20" style="v" sid="1KI 22:20" />तेबे यहोवे पूछेया, “अहाब केस एड़ा बईकाणा कि से गिलाद इलाके रे रामोत शईरो पाँदे अमला करी की डोरूआ खे आओ?” तेबे किने कुछ ओर किने कुछ बोलेया। <verse eid="1KI 22:20" /><verse number="21" style="v" sid="1KI 22:21" />अन्तो दे एक बुरी आत्मा नेड़े आई की यहोवे रे सामणे खड़ी ऊई ओर बोलणे लगी, “मां से बईकेरना” यहोवे पूछेया, “किंयाँ?” <verse eid="1KI 22:21" /><verse number="22" style="v" sid="1KI 22:22" />तेसे बुरी आत्मे बोलेया, “मां जाई की तेसरे सारे भविष्यबक्ता दे समाई की तिना ते चूठ बुलाणा।” यहोवे बोलेया, “तेरा तेसखे बईकेरना सफल ऊणा, जाई की एड़ा ई कर।” <verse eid="1KI 22:22" /><verse number="23" style="v" sid="1KI 22:23" />तो एबे सुण, यहोवे तेरे इना सारेया भविष्यबक्तेया रे मुंए दे एक चूठ बोलणे वाल़ी आत्मा बठयाल़ी राखी ओर यहोवे तेरा नुकशाण करने रा फैंसला करी ला दा ए। <verse eid="1KI 22:23" /><verse number="24" style="v" sid="1KI 22:24" />तेबे कनानो रे पाऊ सिदकिय्याहे मीकायाह रे नेड़े जाई की तेसरी खाखा पाँदे थप्पड़ बाई की पूछेया, “यहोवे रा आत्मा माखे छाडी की तां साथे गल्ला करने खे केई गया?” <verse eid="1KI 22:24" /><verse number="25" style="v" sid="1KI 22:25" />मीकायाहे बोलेया, “जेस दिने तूँ लूकणे खे एकी कमरे ते दूजे कमरे दे नठणा तेस दिने ताखे पता लगणा।” <verse eid="1KI 22:25" /><verse number="26" style="v" sid="1KI 22:26" />तेबे इस्राएलो रे राजा अहाबे आपणे अधिकारिया बीचा ते एकी खे मीकायाह खे पकड़ने रा उक्म दित्तेया। तेबे इस्राएलो रे राजा अहाबे आपणे अधिकारिया खे बोलेया, “एसखे कैद करी लो ओर शईरो रे परदान आमोन ओर योआश राजकुमारो गे लई जा; <verse eid="1KI 22:26" /><verse number="27" style="v" sid="1KI 22:27" />ओर तिना खे बोल कि राजा ईंयाँ बोलोआ कि एसखे जेला दे पाई देयो ओर जदुओ तक आऊँ सई-सलामत नि आऊँ, तदुओ तक एसखे दु:खो री रोटी-पाणी देया करो।”<note caller="+" style="f"><char style="fr" closed="false">22:27 </char><char style="ft" closed="false">इब्रा. 11:36</char></note> <verse eid="1KI 22:27" /><verse number="28" style="v" sid="1KI 22:28" />मीकायाहे बोलेया, “जे तूँ युद्धो ते सई-सलामत वापस आए तो जाणी लया कि यहोवे मेरे जरीये नि बोलेया।” तेबे मीकायाहे बोलेया, “ओ लोको, तुसे सारे के सारे बी सुणी लो।”<verse eid="1KI 22:28" /></para>
  <para style="s">अहाबो री मौत</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 22:29" />तेबे इस्राएलो रा राजा ओर यहूदा रा राजा यहोशापात दुँईं गिलाद इलाके रे रामोत शईरो पाँदे अमला करने खे गये। <verse eid="1KI 22:29" /><verse number="30" style="v" sid="1KI 22:30" />तेबे इस्राएलो रे राजे यहोशापातो खे बोलेया, “मां तो पेष बदली की लड़ने खे जाणा, पर तैं आपणे ई टाल्ले पईनी की राखणे।” तेबे इस्राएलो रा राजा पेष बदली की लड़ने खे गया। <verse eid="1KI 22:30" /><verse number="31" style="v" sid="1KI 22:31" />अरामो रे राजे आपणे बत्ती रथा रे परदाना खे आज्ञा देई राखी थी, “ना तो छोटेया साथे ना बड़ेया साथे लड़ो बस इस्राएलो रे राजे साथे लड़ाई करो।” <verse eid="1KI 22:31" /><verse number="32" style="v" sid="1KI 22:32" />तो जेबे रथो रे परदाने यहोशापात देखेया तेबे बोलेया, “पक्का इस्राएलो रा राजा सेईए।” ओर सेयो तेस साथे युद्ध करने खे मुड़े तेबे यहोशापात चींगणे लगेया, <verse eid="1KI 22:32" /><verse number="33" style="v" sid="1KI 22:33" />ये देखी की कि से इस्राएलो रा राजा नि ए, रथो रे परदान तेसरा पीछा छाडी की वापस ऊईगे। <verse eid="1KI 22:33" /><verse number="34" style="v" sid="1KI 22:34" />पर एकी सिपाईए आपणा तीर चलाया। से नि जाणो था कि तिने तीर केसरिया तरफा खे चलाया। से तीर इस्राएलो रे राजे री झिलम ओर थालले टाल्लेया रे बीचे जाई की कूसी गा। राजे आपणे सारथिये खे बोलेया, “आऊँ काईल ऊईगा रा इजी री खातर रथो खे कुमाई की माखे सेना बीचा ते बारे काडी की लई चल।” <verse eid="1KI 22:34" /><verse number="35" style="v" sid="1KI 22:35" />ओर तेस दिने युद्ध बढ़दा गया ओर राजा आपणे रथो दे ओरी रे साअरे अरामिया सामणे खड़ेया दा रया ओर साँजा खे मरी गा ओर तेसरे जख़्मो रा खून बह्यी की रथो रे पायदानो दे परी गा। <verse eid="1KI 22:35" /><verse number="36" style="v" sid="1KI 22:36" />सूरज डूबदे ई सेना दे ये आका पड़िया, “लड़ाई खत्म ऊईगी ए, एबे सब आपणे शईर ओर आपणे देशो खे वापस ऊई जाओ।” <verse eid="1KI 22:36" /><verse number="37" style="v" sid="1KI 22:37" />जेबे अहाब राजा मरी गा, तेबे से सामरिया दे पऊँचाया ओर से तेथी माट्टिया दे दबाईता। <verse eid="1KI 22:37" /><verse number="38" style="v" sid="1KI 22:38" />तेबे यहोवे रे वचनो रे मुताबिक जेबे तेसरा रथ सामरिया रे खाबड़े दे तोया, तेबे कुत्तेया तेसरा खून चाटेया ओर वेश्या तेती नाह्ओ थिया। <verse eid="1KI 22:38" /><verse number="39" style="v" sid="1KI 22:39" />अहाबो रे ओर सारे काम जो तिने कित्ते थे ओर आथिया रे दाँदा रा जो मईल तिने बणाया ओर जो-जो शईर तिने बसाए थे, ये सारे काम इस्राएली राजेया रे इतिआसो री कताबा दे लिखी राखे। <verse eid="1KI 22:39" /><verse number="40" style="v" sid="1KI 22:40" />तेबे अहाब मरीगा ओर आपणे बुजुर्गा नेड़े दबाईता। तेसते बाद तेसरा पाऊ अहज्याह तेसरी जगा पाँदे राज करने लगेया।<verse eid="1KI 22:40" /></para>
  <para style="s">यहूदा दे यहोशापातो रा राज्य</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 22:41" />इस्राएलो रे राजा अहाबो रे राजो रे चौथे सालो दे आसा रा पाऊ यहोशापात यहूदा पाँदे राज करने लगेया। <verse eid="1KI 22:41" /><verse number="42" style="v" sid="1KI 22:42" />जेबे यहोशापात राज करने लगेया, तेबे से पैंतीया साला रा था ओर पच्चीया साला तक यरूशलेम शईरो दे राज करदा रया। ओर तेसरी माया रा नाओं अजूबा था, जो शिल्ही री बेटी थी। <verse eid="1KI 22:42" /><verse number="43" style="v" sid="1KI 22:43" />ओर तेसरी चाल सारी तरफा ते तेसरे बाओ आसा जेड़ी तर्मी थी, मतलब जो यहोवे री नजरा दे ठीक ए, से सेई करदा रया ओर तिना कामा खे करने ते बिल्कुल नि मुड़ेया। तेबे बी ऊच्ची जगा नि टाल़िया, प्रजा रे लोक तेस बखते बी ऊच्ची जगा दे बलि करेया करो थे ओर तूप बी बाल़ेया करो थे। <verse eid="1KI 22:43" /><verse number="44" style="v" sid="1KI 22:44" />यहोशापाते इस्राएलो रे राजे साथे मेल कित्तेया। <verse eid="1KI 22:44" /><verse number="45" style="v" sid="1KI 22:45" />यहोशापातो रे काम ओर जो वीरता तिने दखाई ओर तिने जो-जो लड़ाईया कित्तिया, ये सारे काम यहूदा रे राजेया रे इतिआसो री कताबा दे लिखी राखे। <verse eid="1KI 22:45" /><verse number="46" style="v" sid="1KI 22:46" />पुरूषगामिया बीचा ते जो तेसरे बाओ आसा रे दिना दे रई गे थे, तिने सेयो देशो ते नाश करी ते। <verse eid="1KI 22:46" /><verse number="47" style="v" sid="1KI 22:47" />तेस बखते एदोम देशो दे आपणा कोई राजा नि था। यहूदा रे राजे तेती आपणा एक अधिकारी राजकाजो रा काम करने खे राखेया था। <verse eid="1KI 22:47" /><verse number="48" style="v" sid="1KI 22:48" />तेबे राजा यहोशापाते तर्शीशो दे जाह्ज सूईना ल्याऊणे खे ओपीर प्रदेशो दे जाणे खे बणवाई ते, पर सेयो एस्योनगेबेरो दे जाईकी टूटी गे, इजी बजअ ते तेथी नि जाई सके। <verse eid="1KI 22:48" /><verse number="49" style="v" sid="1KI 22:49" />तेबे अहाबो रे पाऊ अहज्याहे यहोशापातो खे बोलेया, “मेरे जाह्जिया खे आपणे जाह्जिया साथे, जाह्जो दे जाणे दे;” पर यहोशापाते ना करी ती। <verse eid="1KI 22:49" /><verse number="50" style="v" sid="1KI 22:50" />तेबे यहोशापात मरीगा ओर से तेसरे बुजुर्गा साथे तेसरे मूलमर्द दाऊदो रे शईरो दे दबाईता। ओर तेसरा पाऊ यहोराम तेसरी जगा पाँदे राज करने लगेया।<verse eid="1KI 22:50" /></para>
  <para style="s">इस्राएलो दे अहज्याह रा राज्य</para>
  <para style="p">
    <verse number="51" style="v" sid="1KI 22:51" />यहूदा रे राजा यहोशापातो रे सतारूए सालो दे अहाबो रा पाऊ अहज्याह सामरिया दे इस्राएलो पाँदे राज करने लगेया ओर दो साल तक इस्राएलो पाँदे राज करदा रया। <verse eid="1KI 22:51" /><verse number="52" style="v" sid="1KI 22:52" />ओर तिने से कित्तेया, जो यहोवे री नजरा दे बुरा था ओर तेसरी चाल तेसरे माये-बाओ ओर नबातो रे पाऊ यारोबामो जेड़ी थी जिने इस्राएलो ते मूर्तिया री पूजा कराई की पाप करवाया था। <verse eid="1KI 22:52" /><verse number="53" style="v" sid="1KI 22:53" />जिंयाँ तेसरा बाओ बाल देवतेया री आराधना ओर माथा टेकणे ते इस्राएलो रे परमेशर यहोवे खे रोष करांदा रया तेड़ा ई अहज्याह बी करो था।<verse eid="1KI 22:53" /></para>
  <chapter eid="1KI 22" />
</usx>