  <para style="h">स्याणेया रा ज्ञान</para>
  <para style="toc1">स्याणेया रे ज्ञानो रिया गल्ला</para>
  <para style="toc2">स्याणेया रा ज्ञान</para>
  <para style="toc3">स्याणे.</para>
  <para style="mt">स्याणेया रा ज्ञान</para>
  <para style="mt2">स्याणेया रे ज्ञानो रिया गल्ला</para>
  <para style="is">भूमिका</para>
  <para style="ip">स्याणेया रे ज्ञानो री कताब सई रितिया दे लेखको रे बारे दे नि बतांदी। <char style="xt"><ref loc="ECC 1:1">स्याणे. 1:1</ref></char> दे लेखक आपणे बारे दे बताओआ उपदेशक (इब्रानिया पाषा दे कोहेलेथ) आपू खे दाऊदो रा पाऊ बोलोआ जो यरूशलेमो रा राजा था ओर तेसते पईले यरूशलेमो दे सारे राज करने वाल़ेया ते जादा अक्ला वाल़ा ऊईगा था ओर तिने कई नसीअता रिया गल्ला कट्ठे करी राखे थे। <char style="xt"><ref loc="ECC 1:1">स्याणे. 1:1</ref>,<ref loc="ECC 1:16">16</ref>; <ref loc="ECC 2:9">2:9</ref></char> सुलैमान दाऊदो ते बाद सिंहासनो पाँदे बैठेया से दाऊदो रा एक ई पाऊ था, जिने यरूशलेमो रे शईरो ते ई सारे इस्राएल देशो पाँदे राज कित्तेया था। <char style="xt"><ref loc="ECC 1:12">1:12</ref></char> बऊत सारे पद दखाओए कि एते कताबा रा लिखणे वाल़ा सुलैमान ए। एते कताबा दे कुछ एड़े बी संदर्भ ए जो ये बताओए कि सुलैमानो रे मरने ते कई साल बाद किने ओरी ये कताब लिखी राखी थी। स्याणेया रा ज्ञानो री कताब सुलैमानो रे राज्य रे अन्तो दे, यरूशलेमो दे लिखी दी लगोई।</para>
  <para style="ip">ये कताब आसा खे स्पष्ट चतौणी ए। परमेशरो रे डर ओर लक्ष्य ते बगैर जिन्दगी बेकार ए। से अवा पकड़ने रे बराबर ए। आसे चाए सुख-भोग, तअन-दौल़त, कल्ला, अक्ल, या बस मजे लणे री कोशिश करदे रइए तेबे बी आसे आपणियां जिन्दगिया रे अन्तो दे एई देखूँए कि मारा जिऊणा ई बेकार ए। जिन्दगिया रा मतलब परमेशरो देई बणे दे रई कि मिलोआ।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">प्रस्तावना <char style="ior"><ref loc="ECC 1:1-11">1:1-11</ref></char></para>
  <para style="io1">जिन्दगिया रे लग-लग इस्सा बेकार ए <char style="ior"><ref loc="ECC 1:12-5:7">1:12-5:7</ref></char></para>
  <para style="io1">परमेशरो रा डर <char style="ior"><ref loc="ECC 5:8-12:8">5:8-12:8</ref> </char></para>
  <para style="io1">उपसंहार <char style="ior"><ref loc="ECC 12:9-14">12:9-14</ref></char></para>
  <chapter number="1" style="c" sid="ECC 1" />
  <para style="s">सब बेकार ए</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1" />ये वचन राजा दाऊदो रे पाऊ सुलैमानो रे ए, जिने यरूशलेमो ते राज कित्तेया ओर उपदेशक ए:<verse eid="ECC 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 1:2" />तिने बोलेया, “बेकार ई बेकार, बेकार ई बेकार! जिन्दगी ई बेकार ए।”<verse eid="ECC 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 1:3" />सेयो सब मईणत करने वाल़े लोक जो तरतिया पाँदे काम करोए, तिजी ते तिना खे कोई फायदा नि ऊँदा।<verse eid="ECC 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 1:4" />एक पीढ़ी जाओई ओर दूजी पीढ़ी आओई,<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">लोक मरोए ओर जम्मोए</char></note> पर तरती सदा तेड़ी ई बणी री रओई।<verse eid="ECC 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 1:5" />सूरज निकल़ी की डूबी बी जाओआ ओर आपणे निकल़ने री दिशा खे चट चली जाओआ।<verse eid="ECC 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 1:6" />अवा दखणा रिया तरफा खे बह्ओई ओर उत्तरा रिया तरफा खे कूमदी जाओई, से कूमदी ओर बह्यींदी रओई ओर आपणे चक्करो रे गोल़-गोल़ कूमदी रओई।<verse eid="ECC 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 1:7" />सारिया नदिया समुद्रो रे जाई की मिली जाओईया, तेबे बी समुद्र परदा नि, जेते जगा ते नदिया निकल़ोईया, तेथो खे सेयो फेर फिरी जाओईया।<verse eid="ECC 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 1:8" />जिन्दगी आसा खे थकाई देओई जेतेरे बारे दे कोई माणूं पनि बताई सकदा, ना तो आखी देखी की रज्जदिया ओर ना कान सुणी की परोए।<verse eid="ECC 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 1:9" />जो कुछ ऊआ था, सेई फेर ऊणा ओर जो कुछ बणी चूकी रा, सेई फेर बणाया जाणा ओर तरतिया पाँदे सब गल्ला पुराणिया ई अईया।<verse eid="ECC 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 1:10" />बऊत माणूं एड़ा बोली सकोए, “एती नवीं गल्ल ऊई री!” पर नई, से गल्ल बी पईले बखतो दे ऊई गी थी जेबे आसे जमीं पनि रये थे।<verse eid="ECC 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 1:11" />लोका खे पुराणिया गल्ला री कोई याद नि ए, ओर आऊणे वाल़े बखतो दे लोका खे याद पनि रणा कि एबे आसे क्या करने लगी रे।<verse eid="ECC 1:11" /></para>
  <para style="s">उपदेश देणे वाल़े रा अनुभव</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12" />मैं उपदेश देणे वाल़े यो गल्ला तेबे बोलिया थिया, जेबे आऊँ यरूशलेमो दे रऊँ था ओर आऊँ तेबे इस्राएल देशो रा राजा था।<verse eid="ECC 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 1:13" />मैं आपणी सारिया अक्ला ते इना गल्ला खे समजणे री कोशिश कित्ती कि तरतिया दे क्या-क्या ओआ। तेबे माखे पता लगेया कि परमेशरे माणूंआ खे बऊत ई दु:ख देणे वाल़ा काम करने खे देई राखेया।<verse eid="ECC 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 1:14" />मैं सेयो सारे काम देखे, जो तरतिया पाँदे कित्ते जाओए; ओर देखो, सेयो बेकार ओर मानो अवा खे पकड़ने<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">अव्वा‍ खे ईलाणा</char></note> जेड़े ए।<verse eid="ECC 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 1:15" />जो टेडा ए, से सीदा नि ऊई सकदा ओर जितणिया चीजा अईया ई नि, सेयो गिणिया नि जाई सकदिया।<verse eid="ECC 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16" />फेर आऊँ आपणे आपू ते एड़ा बोलणे लगेया, “आऊँ बऊत जाणा-मानेया दा माणूंआ, जितणे राजेया मांते पईले यरूशलेमो ते राज कित्तेया, आऊँ तिना सबी ते जादा बुद्धिमान ऊआ, माखे पता ए कि बुद्धि ओर ज्ञान असली दे क्या ए।”<verse eid="ECC 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 1:17" />मैं ज्ञान ओर मूर्खता, बुद्धि ओर इस्सालपनो बीचला अंतर सिखणे री ठाणी ली थी। पर माखे पता लगेया कि ये बी अवा रे पीछे दौड़ने जेड़ा ए। <verse eid="ECC 1:17" /><verse number="18" style="v" sid="ECC 1:18" />आऊँ जितणा जादा बुद्धिमान बणेया, तिथणा ई जादा आऊँ परेशान बी ऊआ। जितणिया जादा चीजा री जानकारी मैं लई, तिथणा ई जादा आऊँ दु:खी ऊआ।<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" sid="ECC 2" />
  <para style="s">बेकारो रा सुख</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1" />तेबे मैं आपणे आपू ते बोलेया, “ठीक ए, मां से सब कुछ करने री कोशिश करनी, जेतेते माखे मजा आओआ। मां पता करना कि क्या आऊँ तिना कामा करने ते जिना ते माखे मजा आओआ माखे खुश करी सकोए।” पर माखे पता लगी गा कि एड़ा करना बी बेकार था।<verse eid="ECC 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 2:2" />मैं एड़ा देखेया कि आसी-मजाक करना मूर्खता ए ओर आनन्द करी कि कुछ बी पला नि ऊँदा।<verse eid="ECC 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 2:3" />मैं आपू बऊत जादा शराब पीणे री कोशिश कित्ती, जितणा जादा पी सकूँ था तीतणा पिया, ओर साथे ई समजदार बणे दे रणे री कोशिश कित्ती। मैं ये जाणने री कोशिश करने लगी रा था कि क्या ये काम माणूंए खे आपणे जीवनो दे करने फाईदेमंद ऊणे।<verse eid="ECC 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 2:4" />मैं बड़े-बड़े काम कित्ते, मैं आपू खे कअर बणवाए ओर आपू खे अंगूरा रे बगीचे लगवाए।<verse eid="ECC 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 2:5" />मैं आपू खे बाग-बगीचे लगवाई ते ओर तिना रे कई प्रकारा रे फल देणे वाल़े डाल़ लगवाए। <verse eid="ECC 2:5" /><verse number="6" style="v" sid="ECC 2:6" />मैं आपू खे पाणिए खे कुएँ खणाई ले, ताकि से जगा सींजी जाओ जिदे डाल़ लगाओ थे। <verse eid="ECC 2:6" /><verse number="7" style="v" sid="ECC 2:7" />मैं दास-दासिया खरीदे ओर मेरे कअरे दास बी पैदा ऊए ओर जितणे मांते पईले यरूशलेमो रे थे, तिना ते केथी जादा मांगे गाय-बल़द ओर पेडा-बाकरिया थिया। <verse eid="ECC 2:7" /><verse number="8" style="v" sid="ECC 2:8" />मैं सूईना, चाँदी, राजा ओर राज्या रिया कीमती चीजा बी कट्ठिया कित्तिया। मैं आपू खे गाणे वाल़े ओर गाणे वाल़िया राखिया ओर बऊत सारिया रखैलिया बी, जिना ते माणूंआ खे सुख मिलोआ, आपणियां बणाई तिया।<verse eid="ECC 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 2:9" />ईंयाँ मांते पईले जितणे बी यरूशलेमो दे रओ थे, आऊँ तिना सबी ते महान ओर जादा बुद्धिमान ऊआ।<verse eid="ECC 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 2:10" />जो कुछ बी आऊँ करना चाऊँ था मैं कित्तेया। मैं आपू खे केसी बी खुशिया ते ना नि कित्ती। जो कुछ बी आऊँ करी सकेया तिजी ते आऊँ खुश था ओर जो आनन्द माखे तिजी ते मिलो था से माखे ईनाम था।<verse eid="ECC 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 2:11" />फेर मैं तेते मईणता रे बारे दे सोचेया जो मैं तिना चीजा खे पाणे रिया तँईं कित्ती थी ओर तिना बीचा ते केसी बी चीजा ते माखे बड़ा फाईदा नि ऊआ से सब अवा खे पकड़ने रे जेड़ा था। ये बी बेकार ए।<verse eid="ECC 2:11" /></para>
  <para style="s">बुद्धिमान ओर मूर्खो रा अंत</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 2:12" />आऊँ आपणे आपू ते पूछणे लगेया, “मांते बाद जो माणूं राजा बणना, से एड़ा क्या करोगा जो आऊँ नि करी सकेया?” फेर मैं फैंसला कित्तेया कि बुद्धि ओर मूर्खता खे इस्सालपनो साथे मलाऊँ।<verse eid="ECC 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 2:13" />तेबे मैं देखेया कि जितणा प्रयासा न्हेरे ते खरा ए, तिथणा ई बुद्धि बी मूर्खता ते खरी ए।<verse eid="ECC 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 2:14" />एक अक्लमंद माणूं देखोआ कि केत्ते कनारो खे जाणे लगी रा। पर जेबे एक मूर्ख माणूं चलोआ तेबे से आखी बंद करी लओआ। पर तिना रे जीवनो रा अन्त एक जेड़ा ई ओआ।<verse eid="ECC 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 2:15" />तेबे आऊँ आपू ई सोचणे लगेया, “मूर्खा साथे जो ऊणे वाल़ा ए सेई मां साथे बी ऊणे वाल़ा ए। तो मेरा इतणा समजदार ऊणे रा क्या फाईदा ए?” “कुछ पनि,” तेबे मैं मनो रे सोचेया, “ये बी बेकार ईए।”<verse eid="ECC 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 2:16" />अक्लमंद माणूंए रे ओर मूर्ख माणूंए रे मरने ते बाद लोक सबी खे पूली जाओए। एथो तक कि अक्लमंद माणूं किंयाँ मूर्ख माणूंए जेड़ा मरोआ!<verse eid="ECC 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17" />तेबे माखे आपणी जिन्दगिया ते नफरत ऊई गी, कऊँकि जो काम संसारो रे कित्तेया जाओआ से माखे बुरा लगेया; कऊँकि सब कुछ बेकार ओर अवा खे पकड़ना ईए।<verse eid="ECC 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 2:18" />आऊँ आपणे सारेया कामा ते नफरत करने लगेया जो मैं तरतिया पाँदे कित्ते थे, कऊँकि जो कुछ मैं कट्ठा कित्तेया था से सब कुछ तेस माणूंए खे मिलणा जो मांते बाद राजा ऊणा।<verse eid="ECC 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ECC 2:19" />एड़ा कोई नि जाणदा कि आऊणे वाल़ा माणूं अक्लमंद ऊणा या मूर्ख? तेबे बी तरतिया पाँदे जितणी मईणत मैं कित्ती ओर तअन कमाणे खे बुद्धिया रा इस्तेमाल कित्तेया, तिजी सबी रा अक्कदार सेई ऊणा। ये बी बेकार ईए।<verse eid="ECC 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 2:20" />तेबे आऊँ मनो रे तेसा सारी मईणता रे बारे रे जो मैं तरतिया पाँदे कित्ती सोची की उदास ऊईगा।<verse eid="ECC 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ECC 2:21" />आसे कमाणे रिया तँईं सारी अक्ल, ज्ञान ओर बऊत योजना खे बणाऊँए! अन्तो दे से कमाई आसा खे एड़े माणूंए खे छाडणी पड़ोई जिने तिजी खे कमाणे खे कुछ बी मईणत नि कित्ती ओ! ओर ये गल्ल बी बऊत ई बेकार ओर बुरी ए।<verse eid="ECC 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ECC 2:22" />माणूं जो तरतिया पाँदे मन लगाई-लगाई की मईणत करदा रओआ, तेसखे तिजी ते कोई बी फाईदा नि ऊँदा।<verse eid="ECC 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 2:23" />तेसरे सारे दिन तो दु:खो साथे परे रओए ओर तेसरा काम बी दु:खो साथे ओआ, तेसरे मनो खे राती बी चैन नि मिलदा। ये बी बेकार ईए।<verse eid="ECC 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24" />माणूंए खे खाणे-पीणे ओर मईणत करदे ऊए आपणे प्राणो खे सुखी राखणे ते सिवाए ओर कुछ बी ठीक नि ए। मैं जाणेया कि ये बी परमेशरो रिया तरफा ते ई मिलोआ।<verse eid="ECC 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ECC 2:25" />परमेशरो रिया मतादा ते बिना, केसी गे बी खाणे-पीणे खे पूरा खाणा नि ऊई सकदा। ओर कोई बी खुश नि ऊई सकदा। <verse eid="ECC 2:25" /><verse number="26" style="v" sid="ECC 2:26" />परमेशर जेस माणूंए ते खुश ओआ, तेसखे से समज, ज्ञान ओर खुशी देयोआ, पर पापिया माणूंआ खे से कमाणे, कट्ठा करने ओर पण्डारो दे परने रा काम कराओआ, ताकि से तिना लोका खे देई सको जिना ते खुश ए। ये बी बेकार ओर अवा खे पकड़ने जेड़ा ए।<verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" sid="ECC 3" />
  <para style="s">हर काम करने रा एक बखत</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 3:1" />जो कुछ आसे एते दुनिया दे करूँए तिजी खे एक बखत ओआ।<verse eid="ECC 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ECC 3:2" />जम्मणे रा बखत, ओर मरने रा बी एक बखत ओआ,</para>
  <para style="q" vid="ECC 3:2">बाणे रा बखत ओर बाए रे खे बाडणे रा बी एक बखत ओआ।<verse eid="ECC 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ECC 3:3" />युद्धो दे काणे रा ओर ठीक करने रा बी बखत ओआ,</para>
  <para style="q" vid="ECC 3:3">ओर कुछ चीजा रा टाल़ने रा ओर बनाणे रा बी बखत ओआ।<verse eid="ECC 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ECC 3:4" />दु:खो दे रोणे रा ओर खुशिया दे आसणे रा बी एक बखत ओआ,</para>
  <para style="q" vid="ECC 3:4">शोक करने रा ओर नाचणे रा बी एक बखत ओआ।<verse eid="ECC 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ECC 3:5" />पात्थर सेटणे रा ओर पात्थर कट्ठे करने रा बी बखत ओआ,</para>
  <para style="q" vid="ECC 3:5">ओर गल़े लगाणे रा ओर गल़े लगाणे ते रूकणे रा बी एक बखत ओआ।<verse eid="ECC 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ECC 3:6" />टोल़ने रा ओर रचाणे रा बी एक बखत ओआ,</para>
  <para style="q" vid="ECC 3:6">ओर बचाई की राखणे रा ओर सेटणे रा बखत ओआ;<verse eid="ECC 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ECC 3:7" />फाड़ने रा ओर सीऊँणे रा बी बखत ओआ,</para>
  <para style="q" vid="ECC 3:7">चुप रणे रा ओर बोलणे रा बी एक बखत ओआ।<verse eid="ECC 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ECC 3:8" />प्यार करने रा ओर दुश्मणी करने रा बी बखत ओआ,</para>
  <para style="q" vid="ECC 3:8">ओर लड़ाई करने रा ओर मिलणे रा बी एक बखत ओआ।<verse eid="ECC 3:8" /></para>
  <para style="s">परमेशरो रे जरिये दित्तेया रा काम</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9" />जो लोक मईणता रा काम करोए तिजी ते तिना खे कोई फाईदा नि मिलदा।<verse eid="ECC 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 3:10" />मैं से दु:खो साथे परेया रा काम देखी राखेया, जो परमेशरे माणूंआ खे ठराई राखेया, ताकि सेयो तिदे लगे रे रओ। <verse eid="ECC 3:10" /><verse number="11" style="v" sid="ECC 3:11" />परमेशर सब कुछ सई बखतो पाँदे करोआ। फेर बी आसा बिचा ते कोई बी पुरिया तरआ ते तेसरे कामा खे समजी नि सकदा, ओर से आऊणे वाल़े बखतो रे बारे दे म्हारे मनो दे सवाल पाई देओआ। एड़ा बणाया जो आपणे-आपणे बखतो रे सुन्दर ओआ, तेबे तिने माणूंआ रे मनो रे शुरू ओर अन्तो रा ज्ञान परेया। पर परमेशरे जो कुछ बणाया, माणूं तिजी खे शुरूओ ते लई की अन्तो तक समजी नि सकदा।<verse eid="ECC 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 3:12" />माखे पता लगी गा रा कि माणूंआ खे मजे करने ओर पूरी जिन्दगी पलाई करने ते सिवाए ओर कुछ बी ठीक नि ए। <verse eid="ECC 3:12" /><verse number="13" style="v" sid="ECC 3:13" />ओर आऊँ ये बी जाणूंआ कि हर केसी माणूंए खे खाणा-पीणा चाईयो, ओर तिना रे जरिये कित्ते जाणे वाल़े कामा रा मजा लणा चाईयो। से चीजा ए जो परमेशर आसा खे देओआ।<verse eid="ECC 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 3:14" />माखे पता ए कि जो कुछ परमेशर करोआ, से सदा स्थिर रणा, ना तो तिदे कुछ बढ़ाई सकदे ओर ना ई कुछ कटाई सकदे, परमेशर एड़ा इजी खे करोआ, ताकि लोक तेसरा डर मानो। <verse eid="ECC 3:14" /><verse number="15" style="v" sid="ECC 3:15" />जो कुछ ऊआ से इजी ते पईले बी ऊई चूकी रा, जो ऊणे वाल़ा ए, से बी ऊई चूकी रा ओर परमेशर सेई काम बार-बार करोआ।<verse eid="ECC 3:15" /></para>
  <para style="s">संसारो रे अन्याय</para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16" />फेर मैं तरतिया पाँदे न्याय ओर पलाईया रिया जगा पाँदे बुरे ई काम देखे,<verse eid="ECC 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 3:17" />मैं आपणे मनो रे बोलेया, “परमेशरो बुरे माणूंए रा ओर तर्मी माणूंए रा न्याय करना, कऊँकि तेसरे कअरे हर एक गल्ला रा ओर हर एक कामो रा बखत ओआ।”<verse eid="ECC 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 3:18" />मैं आपणे आपू ते बोलेया, “परमेशर माणूंआ खे परखो कि माणूं देखी सको कि सेयो डांगरा ते बड़ी की नि ए। <verse eid="ECC 3:18" /><verse number="19" style="v" sid="ECC 3:19" />कऊँकि जेड़ी डांगरा री, तेड़ी ई माणूंआ री बी दशा ओई, जेड़ा एक मरोआ, तेड़ा ई दूजा बी मरोआ। सबी दे एक जेड़ा ई साआ ओआ ओर माणूं डांगरा जेड़ा ईए, सब कुछ बेकार ईए।” <verse eid="ECC 3:19" /><verse number="20" style="v" sid="ECC 3:20" />सब जिऊँदे जीब एक ई जगा रे जाओए माट्टिया दे, सारे माट्टिया ते ई बणी रे ओर सारे बादो ते माट्टिया रेई मिली जाओए। <verse eid="ECC 3:20" /><verse number="21" style="v" sid="ECC 3:21" />पक्का ये कोई नि जाणदा कि मरने ते बाद माणूंआ रा प्राण परमेशरो रिया तरफा खे जाओआ ओर डांगरा रा प्राण थालो खे मरेया रिया जगा खे जाओआ। <verse eid="ECC 3:21" /><verse number="22" style="v" sid="ECC 3:22" />माखे एड़ा लगोआ कि सबी ते खरी गल्ल माणूंआ खे एड़ी ए कि आसे आपणे कामा दे लगे दे रणे चाईयो, तिजी ते अलावा आसे कुछ पनि करी सकदे। इजी गल्ला रा पता केसी बी गल्ला ते नि लगाई सकदे कि मारे मरने ते बाद आगे क्या ऊणा।<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" sid="ECC 4" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1" />तेबे मैं से सारा अन्देर देखेया, जो एते तरतिया पाँदे ओआ। तेबे मैं‍ क्या देखेया कि अन्देर सयीणे वाल़ेया रे आसू छूटणे लगी रे ओर तिना खे कोई शान्ति देणे वाल़ा नि ए। अन्देर करने वाल़े तागतबर थे, पर अन्देर सईणे वाल़ेया खे कोई मताद करने वाल़ा नि था। <verse eid="ECC 4:1" /><verse number="2" style="v" sid="ECC 4:2" />तेबे मैं आपणे आपू ते बोलेया कि जो मरे दे ए, सेयो जिऊँदे लोका ते तन्य ए। <verse eid="ECC 4:2" /><verse number="3" style="v" sid="ECC 4:3" />बल्कि तिना दुँईं ते जादा भाग्यशाली सेईए, जो एबुए तक पैदा ई नि ऊआ, ओर ना ई तिने यो बुरे काम देखे जो संसारो रे ओए।<verse eid="ECC 4:3" /></para>
  <para style="s">स्वार्थी मईणता रा बेकार ऊणा</para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4" />तेबे मैं एड़ा देखेया कि लोक पड़ोसिया रिया जल़नी ते बऊत मईणत करोए आपू खे सफल बनाणे रिया तँईं! ये गल्ल बी माखे बेकार ई लगी; जिंयाँ अवा पकड़ने खे मईणत करना बेकार ओआ।<verse eid="ECC 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 4:5" />मूर्ख माणूं काम करने खे ना करोए सेयो छातिया पाँदे आपणे आथ मोड़ी की खाली बैठे दे रओए ईंयाँ सेयो आपणा ई नाश करोए।<verse eid="ECC 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 4:6" />इजी री खातर मैं बोलेया, “जादा पैसा ना ऊणे ते बी संतुष्ट रणा खरा ए, इजी रे बदले की जादा पैसा पाणे रिया तँईं मईणत करना, जो की अवा खे पकड़ने जेड़ा ए।”<verse eid="ECC 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7" />तेबे मैं तरतिया पाँदे ये बी बेकार गल्ल देखी।<verse eid="ECC 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 4:8" />कई लोक दुनिया दे कल्ले ओए; तिना रे ना बालबच्चे ओए, ना पाई-बईण! तेबे बी सेयो बऊत जादा काम करदे रओए, सेयो कदी बी पैसेया ते किंयाँ बी रजदे नि! सेयो एड़ा पनि सोचदे,? आसे केसरिया तँईं पैसा कट्ठा करने लगी रे? एड़ा करना बी बेकार ए ओर बिना मतलबो रा दु:खी जीवन ए।<verse eid="ECC 4:8" /></para>
  <para style="s">दोस्तो री कीमत</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 4:9" />कले रणे ते दो माणूं साथे रणे अच्छे ए, कऊँकि सेयो एकी दूजे री मताद करी सकोए सफल ऊणे रिया तँईं। <verse eid="ECC 4:9" /><verse number="10" style="v" sid="ECC 4:10" />कऊँकि जे तिना बीचा ते कोई एक जणा रूड़ो, तो दूजे से चकणा, पर हाय तेस पाँदे, जो कल्ला ऊई की रूड़ो ओर तेसखे कोई चकणे वाल़ा नि ओ। <verse eid="ECC 4:10" /><verse number="11" style="v" sid="ECC 4:11" />जेबे दो जणे कट्ठे सऊणे, तो सेयो गर्म रणे, पर कल्ला माणूं किंयाँ आपू खे गर्म राखी सकोआ? <verse eid="ECC 4:11" /><verse number="12" style="v" sid="ECC 4:12" />जे कोई कल्ले पाँदे अमला करो तो करो, पर दो जणे तेसरा सामणा करी सकोए। जो डोरी तीऊँ तागेया साथे बाटी री ओ से चट नि टूटदी।<verse eid="ECC 4:12" /></para>
  <para style="s">लोका बीचे तालमेलो रा कम ऊणा</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13" />अक्लमंद जवान पाऊ गरीब ऊँदे ऊए बी एड़े स्याणे ओर मूर्ख राजे ते जादा अच्छा ए, जो सलाई खे नि मानदा। <verse eid="ECC 4:13" /><verse number="14" style="v" sid="ECC 4:14" />ये सम्भव ए कि चाए से बिना दौलता ते ओ या तेसरे माए-बाओ गरीब थे या से जेला दे कुछ बखतो तक कैद रया ओ एक दिन राजा बणी जाओ। <verse eid="ECC 4:14" /><verse number="15" style="v" sid="ECC 4:15" />पर फेर कोई ओर जवान माणूं राजा बणीगा ओर सब लोक तेसते खुश थे। <verse eid="ECC 4:15" /><verse number="16" style="v" sid="ECC 4:16" />सेयो सारे लोक अणगिणत थे जिना पाँदे से परदान था, तेबे बी बादो ते ऊणे वाल़े लोक तेसरी बजा ते खुश नि ऊणे। पक्का ये बी बेकार ओर अवा खे पकड़ने जेड़ा ए।<verse eid="ECC 4:16" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" sid="ECC 5" />
  <para style="s">परमेशरो रा डर मानणा ओर वादा पूरा करना</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1" />जेबे तूँ परमेशरो रे पवित्र मईलो दे जाए तो नम्र ओर सम्बल़ी की जाणा। तूँ तेती परमेशरो रा वचन सुणने खे जाया, मूर्खो जेड़ा बलिदान नि चढ़ाणा जेसखे पता ई नि ऊँदा कि क्या खरा क्या बुरा ए! <verse eid="ECC 5:1" /><verse number="2" style="v" sid="ECC 5:2" />गल्ला करने रे जल्दबाजी नि करना ओर ना कोई आपणे मनो री गल्ल परमेशरो सामणे जल्दबाजिया दे बोलणी, कऊँकि परमेशर स्वर्गो रे ए ओर तूँ तरतिया पाँदे। इजी री खातर बोलणे ते पईले ठीक-टंगो रे सोचणा। <verse eid="ECC 5:2" /><verse number="3" style="v" sid="ECC 5:3" />जे तुसे आपणियां परेशानिया रे बारे दे बऊत जादा सोचोगे तो तुसा बुरिया चीजा रे सुफने देखणे लगणे। जे तुसे बऊत जादा गल्ला करोगे तो तुसा मूर्खा जेड़िया गल्ला करनिया। <verse eid="ECC 5:3" /><verse number="4" style="v" sid="ECC 5:4" />जेबे तूँ परमेशरो रे सामणे जाईकी मान्नत मांगे, तेबे तिजी खे पूरी करने रे देरी नि करनी, कऊँकि से मूर्खो ते खुश नि ऊँदा, इजी री खातर जो मान्नत तैं मानी राखी से तैं पक्का पूरी करनी। <verse eid="ECC 5:4" /><verse number="5" style="v" sid="ECC 5:5" />मान्नत मानी की पूरी ना करने ते अच्छा ए कि तू कोई मान्नत ई ना माने। <verse eid="ECC 5:5" /><verse number="6" style="v" sid="ECC 5:6" />सिर्फ एड़िया ई गल्ला बोलणिया जो सच्च ए। तुसे परमेशरो रे दूतो खे ये नि बोलणा चाईयो, “मैं जो वादा कित्तेया था, से गल़ती थी, जेते कि परमेशर नराज ऊई जाओए। परमेशर तिना सबी चीजा खे नाश करी सकोआ जिना रिया तँईं तुसे मईणत करी राखी ए, <verse eid="ECC 5:6" /><verse number="7" style="v" sid="ECC 5:7" />केसी कामो खे करने रा वादा करना ओर फेर तेड़ा ई नि करना एक सुफने जेड़ा ए जेतेरी कोई कीमत नि ए। एतेरे बजाये, परमेशरो रा आदर करो।”<verse eid="ECC 5:7" /></para>
  <para style="s">जिन्दगी बेकार ए</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8" />जे तूँ केसी गरीबो रे अक्को खे सरकारा रे जरिये न्याय बिगाड़ी दे ओर तिना पाँदे अन्देर ऊँदा ऊआ देखे, तो इजी ते हैरान नि ऊणा, कऊँकि एकी अधिकारिए ते बड़ा दूजा ओआ, जेसखे इना सबी गल्ला रे बारे दे पता ओआ ओर तिना ते बी बड़ा एक ओर अधिकारी ओआ।<verse eid="ECC 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 5:9" />जमीना री उपज तो सबी खे ओई बल्कि राजे खे बी तिजी ते फाईदा ओआ,<verse eid="ECC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 5:10" />जो पैसेया साथे प्यार करोआ, तेसखे पैसेया साथे तसल्ली नि ऊणी ओर ना तेसखे जो जादा तअन-दौलता ते प्यार राखोआ तेतेरे फायदे ते। ये बी बेकार ए। <verse eid="ECC 5:10" /><verse number="11" style="v" sid="ECC 5:11" />जेबे तअन-दौलत बढ़ोई, तो तेबे तिजी खे खाणे वाल़े बी बढ़ोए, तेबे तेसरे मालको खे तिजी खे छाडी की ओर क्या फायदा ओआ कि तेसा तअन-दौलता खे आपणियां आखी साथे देखो? <verse eid="ECC 5:11" /><verse number="12" style="v" sid="ECC 5:12" />मईणत करने वाल़ा माणूं चाए थोड़ा खाओ या बऊत, तेबे बी तेसखे सुखो साथे नींज आओई। पर अमीर माणूंए रे तअन बढ़ने ते तेसखे नींज नि आऊँदी।<verse eid="ECC 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 5:13" />मैं एते तरतिया पाँदे एक बड़ी बुरी गल्ल देखी राखी, लोक पैसेया रे मालक तो ऊईगे पर तिजी ते तिना खे कोई बी फाईदा नि ऊँदा, <verse eid="ECC 5:13" /><verse number="14" style="v" sid="ECC 5:14" />सेयो अचाणक आपणा सब कुछ बपारो रे एकी गल़त फैंसले रिया बजा ते खोई देओए, फेर मरने ते बाद आपणे बच्चेया खे कुछ पनि छाडी जांदे। <verse eid="ECC 5:14" /><verse number="15" style="v" sid="ECC 5:15" />जिंयाँ से माया रे पेटो ते नांगा ई निकल़ेया, तिंयाँ ई से मरी बी जाणा; जेड़ा आया था ओर तेसखे आपणी मईणता रे बदले कुछ नि मिलणा, जेतेखे से आपणे आथो रे लई जाई सको।<note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="ft" closed="false">1 तीमुथि 6:7</char></note> <verse eid="ECC 5:15" /><verse number="16" style="v" sid="ECC 5:16" />ये बी एक बड़ी बला ए कि जेड़ा से आया, ठीक तेड़ा ई से जाणा, तेसखे तेते मईणता ते कोई बी फाईदा नि ऊँदा। <verse eid="ECC 5:16" /><verse number="17" style="v" sid="ECC 5:17" />आसा खे न्हेरा ओर दु:ख, चिन्ता, गुस्सा ओर बमारिया देई पूरा जीवन जिऊँणे खे मिलोआ।<verse eid="ECC 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18" />सुण, जो खरी गल्ल मैं परखी की देखी जो ठीक बी ए, से ये कि माणूं खाओ-पियो ओर आपणी मईणता साथे जो से तरतिया पाँदे करदा रओआ, आपणी पूरी जिन्दगी, जो परमेशरे तेसखे देई राखी, सुखी रओ, कऊँकि तेसरा इस्सा ये ईए। <verse eid="ECC 5:18" /><verse number="19" style="v" sid="ECC 5:19" />इजी रा मतलब ए कि हर एक माणूं जेसखे परमेशरे तअन-सम्पत्ति देई राखी ओ ओर तेसखे मजे लणे ओर तिजी बीचा ते आपणा इस्सा लणे ओर काम करदे ऊए मजे करने खे शक्ति बी देई राखी ओ, तो इजी खे आपणा इसा मानी कि ए समजी लओ कि ये परमेशरो रिया तरफा ते आशीष ए। <verse eid="ECC 5:19" /><verse number="20" style="v" sid="ECC 5:20" />एड़े लोक आपणे जीवनो दे हर गल्ला रे बारे दे चिन्ता नि करदे, कऊँकि परमेशर तिना खे सब कुछ करदे बखते खुश रणे दे सक्षम बणाओआ।<verse eid="ECC 5:20" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" sid="ECC 6" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1" />आऊँ देखूँआ कि तरतिया पाँदे एक घोर अन्याय करने लगी रे। <verse eid="ECC 6:1" /><verse number="2" style="v" sid="ECC 6:2" />केसी माणूंए खे परमेशर तअन-सम्पत्ति ओर मान-सम्मान इतणा देयोआ कि जो कुछ तेसरा मन चाओआ, तिना चीजा री तेसखे कोई कमी नि ऊँदी, पर तेबे बी परमेशर तेसखे तिना बीचा ते कुछ बी खाणे नि देंदा, बल्कि कोई दूजा ई तेसखे खाओआ, ये बेकार ओर डराऊणा दु:ख ए।<verse eid="ECC 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 6:3" />जे केसी माणूंए रे सौ पाऊ ओ ओर से बऊत साला तक जिऊँदा बी रओ ओर तेसरी उम्र बढ़ी जाओ, पर ना से खुश ओ ओर ना तेसरी अन्तिम क्रिया करो, तो आऊँ बोलूँआ कि एड़े माणूंए ते आदे बखतो दे जम्मणे ते बाद मरने वाल़ा बच्चा ठीक ए। <verse eid="ECC 6:3" /><verse number="4" style="v" sid="ECC 6:4" />एड़े बाल़को रे जमणे रा कोई फाईदा नि ए; ना ई तेसरा कोई नाओं ए। से सीदा ई तेते जगा खे जाओआ जेती अन्दकूप न्हेरा ए। <verse eid="ECC 6:4" /><verse number="5" style="v" sid="ECC 6:5" />से सूरजो खे देखणे या कुछ बी पता करने रिया तँईं जिऊँदा नि रई सकेया। पर ये जिऊँदेया अमीर लोका ते जादा सुखी रओआ। <verse eid="ECC 6:5" /><verse number="6" style="v" sid="ECC 6:6" />चाए माणूं दो ह्जार साला तक जिऊँदा रओ जे से सारी उम्र सुखी नि था तो तेसखे कोई फाईदा नि ओर सब लोक मरने ते बाद एक ई जगा दे जाणे।<verse eid="ECC 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 6:7" />आसे सारी मईणत इजी रिया तँईं करूँए कि कुछ खाणे खे मिली जाओ, पर आसे लोक कदी बी रजदे नि, <verse eid="ECC 6:7" /><verse number="8" style="v" sid="ECC 6:8" />अक्लमंद माणूं मूर्ख माणूंए ते केसा गल्ला रे बढ़ी की ए? ओर गरीब माणूं जो ये जाणोआ कि एते दुनिया दे किंयाँ जिऊँदे रणा चाईयो, से बी केसा गल्ला दे तेसते बढ़ी की ए? <verse eid="ECC 6:8" /><verse number="9" style="v" sid="ECC 6:9" />तिना चीजा रा मजा लणा खरा ए जो आसा गे पईले ते ई ए, इजी रे बदले कि लगातार जादा चीजा खे चाँदे रणा; एड़ी इच्छा करना मूर्खता ए, जेड़ा अवा रा पीछा करना।<verse eid="ECC 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 6:10" />जो कुछ पैदा करी राखेया तिजी रा नाओं दुनिया री शुरूआता ते राखी राखेया, ओर आसे जाणूंए कि माणूं केड़ा ओआ, इजी री खातर आसे आपू ते जादा तागतबर माणूंए साथे लड़ी नि सकदे। <verse eid="ECC 6:10" /><verse number="11" style="v" sid="ECC 6:11" />जितणा जादा आसे लोक गल्ला करूँगे तिथणा ई जादा आसा बेकार गल्ला बोलणिया, इजी री खातर आसा खे जादा गल्ला करने ते कोई फाईदा नि ए। <verse eid="ECC 6:11" /><verse number="12" style="v" sid="ECC 6:12" />कऊँकि माणूंए री थोड़ी जी जिन्दगी जो से परछाईया जेड़ा बिताओआ कुण जाणोआ कि तेसखे क्या अच्छा ए? कऊँकि माणूंए खे कुण बताई सकोआ कि तेसरे मरने ते बाद एते तरतिया दे क्या ऊणा?<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" sid="ECC 7" />
  <para style="s">लोका खे क्या अच्छा ए</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 7:1" />जाणे-मानेया रा नाओं कीमती इत्रो ते खरा ए, ओर जम्मणे रे दिनो ते खरा ए मरने रा दिन।<verse eid="ECC 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 7:2" />जेते कअरो दे त्यार ऊणे लगी रा तिदे जाणे ते खरा ए तेते कअरो दे जाणा जेते कअरो दे मरने रा शोक चली रा, कऊँकि सबी माणूंआ रा अन्त येई ए ओर जो जिऊँदा ए तेस इजी रे बारे मन लगाई की सोचणा।<verse eid="ECC 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 7:3" />आसणे ते खरा ए दु:खी रणा, आसे बऊत गल्ला आपणे जीवनो रे बारे दे सीखूँए जेबे आसे दु:खी ऊँए।<verse eid="ECC 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 7:4" />एक अक्लमंद माणूं मरने रे बारे दे सोचोआ। पर एक मूर्ख माणूं ये सोचोआ कि किंयाँ आपणे जीवनो दे मजा करी सकूँए।<verse eid="ECC 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 7:5" />मूर्खो रे गाणे सुणने ते अक्लमंदो रा थिड़कणा सुणना खरा ए।<verse eid="ECC 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 7:6" />कऊँकि मूर्खो री आस्सी आँडिया निठे आगी दे बल़दे ऊए कांडेया री चड़चड़ाहटा जेड़ी ओई, ये बी बेकार ए।<verse eid="ECC 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 7:7" />अक्लमंद माणूं बी अन्देरो रिया बजा ते पक्का पागल ऊई जाओआ ओर रिश्वत बुद्धिया खे बी नाश करी देओई।<verse eid="ECC 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 7:8" />केसी कामो री शुरूआता ते तिजी रा अन्त देखणा मनो खे खरा लगोआ ओर सब्रखोर माणूं कमण्डी माणूंए ते खरा ए।<verse eid="ECC 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 7:9" />जल्दबाजिया रे रोष नि करो, मूर्ख एड़ा ई करोए। तिना बुरेया कामा खे पूलणे री कोशिश करो जो लोके तुसा साथे करी राखे।<note caller="+" style="f"><char style="fr" closed="false">7:9 </char><char style="ft" closed="false">याकूब 1:19</char></note><verse eid="ECC 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 7:10" />ये नि बोलणा कि आजो रे दिनो ते बितेया रा दिन ठीक था, कऊँकि एड़ा बोलणा अक्ला री गल्ल नि ऊँदी।<verse eid="ECC 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 7:11" />बुद्धि बाओ रिया जायदाता ते अच्छी ओई, बल्कि जिऊँदे रणे वाल़ेया खे बऊत फायदेमंद ए। <verse eid="ECC 7:11" /><verse number="12" style="v" sid="ECC 7:12" />बुद्धिया पैसेया जेड़ी तुसा री रक्षा करनी; ज्ञानो साथे समजा तुसे आपणे जीवनो रिया तरफा खे लई जाणे।<verse eid="ECC 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 7:13" />परमेशरे रे कामो खे देख, जो चीज तिने टेडी बणाई राखी, तिजी खे कोई बी सीदा नि करी सकदा। <verse eid="ECC 7:13" /><verse number="14" style="v" sid="ECC 7:14" />सुखो रे दिना दे मजे करो ओर जेबे दु:ख आओ; तेस बखते से गल्ल याद राखणी कि परमेशर ई सुख ओर दु:खो रा कारण ए, ओर माणूंआ खे कदी बी पता नि चलणा कि आगे क्या ऊणे वाल़ा ए।<verse eid="ECC 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15" />आपणियां बेकार जिन्दगिया रे मैं ये सब कुछ ऊँदे ऊए देखी राखेया, कि कोई तार्मिक माणूं आपणे तार्मिकता रे काम करदे ऊए नाश ऊई जाओआ ओर बुरा माणूं बुरे काम करोआ तेबे बी तेसरी उम्र बढ़दी जाओई। <verse eid="ECC 7:15" /><verse number="16" style="v" sid="ECC 7:16" />इजी री खातर ये नि सोचो कि तुसे बऊत तर्मी ए ओर ये बी नि सोचो कि तुसे बऊत समजदार ए, कऊँकि जे तुसे तिना चीजा खे सोचोए, तो तुसे आपू खे नाश करोए। <verse eid="ECC 7:16" /><verse number="17" style="v" sid="ECC 7:17" />ना तो जादा दुष्ट बण ओर ना ई मूर्ख बण, नई तो तूँ आपणे बखतो ते पईले ई मरी जाणा। <verse eid="ECC 7:17" /><verse number="18" style="v" sid="ECC 7:18" />लगातार बुराई करने ओर मूर्ख बणने ते बचो; परमेशरो रा सदा आदर करी की तिना दूई चीजा खे करने ते बचो।<verse eid="ECC 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ECC 7:19" />एक अक्लमंद माणूं शईरो रे दसा परदाना ते जादा तागतबर ओआ।<verse eid="ECC 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 7:20" />तरतिया पाँदे पक्का कोई एड़ा तर्मी माणूं नि ए जो बस पलाई ई करो ओर जेसते कोई बी पाप नि ऊई रा ओ।<note caller="+" style="f"><char style="fr" closed="false">7:20 </char><char style="ft" closed="false">रोमी 3:10</char></note><verse eid="ECC 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ECC 7:21" />जितणिया गल्ला बोलिया जाओईया तिना सबी पाँदे त्यान नि देणा, एड़ा नि ओ कि तूँ सुणे कि तेसरा दास ताखे ई स्राप देयोआ। <verse eid="ECC 7:21" /><verse number="22" style="v" sid="ECC 7:22" />कऊँकि तूँ आपू जाणेया कि तैं बी कई बार ओरी खे स्राप देई राखेया।<verse eid="ECC 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23" />मैं आपणे आपू ते बोलेया, “आऊँ उशयार ऊई जाणा ओर इना सबी गल्ला खे समजणे री कोशिश करनी,” पर ये माखे बऊत कठण था। <verse eid="ECC 7:23" /><verse number="24" style="v" sid="ECC 7:24" />बुद्धि मांते बऊत दूर लगोई; कोई नि ए जो सच्चो खे ई सब कुछ समजी सकोआ। <verse eid="ECC 7:24" /><verse number="25" style="v" sid="ECC 7:25" />इजी री खातर मैं जितणा ऊई सको से सब सिखणे रा फैंसला कित्तेया ताकि आऊँ बुद्धिमान ऊई की जीवनो रे बारे दे सब कुछ समजी सकूँ। ओर ये बी समजणा चाऊँ था कि मूर्ख बणना बेवकुफी कऊँ ए,<verse eid="ECC 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ECC 7:26" />ओर मैं मौता ते बी जादा एक दु:ख देणे वाल़ी चीज देखी, मतलब से जवाणस जेसा रा मन फन्दा ओर जाल़ ए ओर जेसा रे आथ अथकड़िया ए जेस माणूंए ते परमेशर खुश ए सेई तेसा ते बचणा, पर पापी माणूं तेसा रा शिकार ऊणा। <verse eid="ECC 7:26" /><verse number="27" style="v" sid="ECC 7:27" />ये सेई आ जो मैं सिखी राखेया ए; मैं चीजा रे बारे दे जादा ते जादा जाणने री कोशिश कित्ती ताकि सबी किजी री बजा जाणने री कोशिश करी सकी ए, <verse eid="ECC 7:27" /><verse number="28" style="v" sid="ECC 7:28" />ओर आऊँ जादा जाणने री कोशिश करदा रया, पर आऊँ सबी खे टोल़णे लगी रा था नई मिलेया। पर एक गल्ल जो माखे पता चली से ये थी कि एक ह्जार लोका दे माखे एक तर्मी माणूं मिलेया, पर माखे एक बी तर्मी जवाणस नि मिली। <verse eid="ECC 7:28" /><verse number="29" style="v" sid="ECC 7:29" />पर मैं एक गल्ल सीखी; जेबे परमेशरे लोका खे बणाया, तो सेयो तर्मी थे, पर तिने बुरे काम करने रे कई तरीके टोल़े।<verse eid="ECC 7:29" /></para>
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" sid="ECC 8" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 8:1" />अक्लमंद माणूंए खे ई एते गल्ला रे बारे दे पता ओआ कि केत्ते गल्ला रा सई मतलब ऊणा चाईयो। बुद्धि तिना रिया सकला खे चमकाओ ई ओर नराजगिया खे दूर करोई।<verse eid="ECC 8:1" /></para>
  <para style="s">राजे री आज्ञा खे मानो</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2" />जेड़ा राजा बोलोआ: तेड़ा ई करना, ना जल्दबाजिया दे परमेशरो ते कोई कसम खाणी।<verse eid="ECC 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 8:3" />राजे खे ना करने खे जल्दबाजी नि करनी। ओर तिना लोका साथे नि मिलणा जो तेसरे खलाफ बिद्रोह करना चाओए, कऊँकि से जो कुछ करना चाओआ, से तेड़ा ई करोआ।<verse eid="ECC 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 8:4" />कऊँकि राजे रिया गल्ला रे तागत ओई ओर तेसखे कोई नि बोली सकदा कि तूँ क्या करने लगी रा?<verse eid="ECC 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 8:5" />जे राजे री आज्ञा खे मानोगे तो तुसे मुसीबता दे नि पड़ने, इजी री खातर उशयार रओ ओर ये जाणो कि क्या करना ए ओर कदी करना ए।<verse eid="ECC 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 8:6" />जबकि लोका खे कईया परेशानिया रा अनुभव ओआ, चीजा खे करने रा सई बखत ओर सई तरीका ओआ।<verse eid="ECC 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 8:7" />आऊणे वाल़ेया दिना दे क्या ऊणे वाल़ा ए तेतेरे बारे दे कोई नि बताई सकदा?<verse eid="ECC 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 8:8" />कोई बी माणूं मौता ते नि बची सकदा, ये एक एड़ा युद्ध ए जेसखे कोई तोखा देई कि बची नि सकदा।<verse eid="ECC 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9" />जितणे काम तरतिया पाँदे कित्ते जाओए, तिना सबी खे त्यानो ते देखणे दे मैं ये सब कुछ देखेया ओर ये बी देखेया कि एक माणूं दूजे माणूंए पाँदे अधिकारी ऊई की आपू पाँदे नुकशाण ल्याओआ।<verse eid="ECC 8:9" /></para>
  <para style="s">पापी ओर तर्मी</para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 8:10" />मैं ये बी देखेया कि कई बार बुरेया माणूंआ रे मरने ते बाद, सेयो तिना शईरा दे लोका रे जरिये तिना रे आखरी संस्कारो दे बड़ा पारी आदर पाओए जेती तिने बुरे काम करी राखे थे। एड़ा लगो था कि एड़ा कऊँ ओआ। ये सब बेकार ए।<verse eid="ECC 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 8:11" />बुरे काम करने वाल़ेया खे सजा री आज्ञा फटाफट नि देंदे; इजी बजा ते माणूंआ रा मन बुरे काम करने रिया इच्छा ते परेया रा रओआ।<verse eid="ECC 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 8:12" />चाए पापी माणूं सौ बार पाप करी की आपणी उम्र बी बढ़ाओ, तेबे बी माखे निश्चा ए कि जो परमेशरो ते डरोए ओर तेसखे आपू सामणे जाणी की तेसरी इच्छा ते चलोए, तिना रा पला ई ऊणा।<verse eid="ECC 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 8:13" />पर दुष्ट माणूंए रा पला नि ऊई सकदा ओर ना तेसरी उम्र बढ़ी सकदी, कऊँकि से परमेशरो ना डर नि मानदा।<verse eid="ECC 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14" />एक ओर बेकार गल्ल तरतिया पाँदे ओई, मतलब एड़े तर्मी ए जिना री तेड़ी दशा ओई जेड़ी दुष्टो री ऊणी चाईयो ओर एड़े दुष्ट ए जिना री एड़ी दशा ओई, जो तर्मिया री ऊणी चाईयो। आऊँ तो बोलूँआ कि ये बी बेकार ई ए।<verse eid="ECC 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 8:15" />इजी री खातर माखे पक्का पता ए कि आसा खे मजा करना चाईयो, कऊँकि एते दुनिया दे माणूंआ खे खाणे-पीणे ओर मजा करने ते अलावा कुछ बी ठीक नि ए। आसे कम से कम ये तो करी ई सकूँए जेबे आसे एते जीवनो दे मईणत करूँए जो परमेशरे आसा खे देई राखेया ए।<verse eid="ECC 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16" />जेबे मैं बुद्धि लणे ओर सारे काम देखणे खे जो तरतिया पाँदे करोए, आपणा मन लगाया कि माणूं किंयाँ दिन-रात जागदे रओए;<verse eid="ECC 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 8:17" />तेबे मैं परमेशरो रा सारा काम देखेया, जो तरतिया पाँदे कित्तेया जाओआ, तिजी री गईराई माणूं नि पाई सकदा। चाए माणूं तिजी री टोल़ा रे कितणी बी मईणत करो तेबे बी तेसखे नि जाणी सकदा; ओर अक्लमंद बोलो बी कि मां से समजणा, तेबे बी से तिजी खे जाणी नि सकदा।<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" sid="ECC 9" />
  <para style="s">सबी रा मरना पक्का ए</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1" />मैं तिना चीजा रे बारे दे सोचेया, ओर मैं देखेया कि परमेशर आपणे कब्जे दे राखोआ कि हर एकी साथे क्या ऊणा, चाए से माणूं अक्लमंद ए या तर्मी। कोई नि जाणदा कि दूजे तिना साथे प्यार करोए या नफरत।<verse eid="ECC 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 9:2" />सबी रा आल एक जेड़ा ई ओआ, तर्मी ओ या दुष्ट, खरे-बुरे, शुद्ध या अशुद्ध, यज्ञ करने वाल़े या ना करने वाल़े, सबी री दशा एक जेड़ी ओई। जेड़ी खरे माणूंए री दशा, तेड़ी ई पापिए री दशा ओई, जेड़ी कसम खाणे वाल़े री दशा, तेड़ी ई तेसरी जो कसम खाणे ते डरोआ ओई।<verse eid="ECC 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 9:3" />जो कुछ तरतिया पाँदे कित्तेया जाओआ तिदे एक ये दोष ए कि सबी लोका री एक ई दशा ओई ओर माणूंआ रे मनो रे बुराई परी री ए, ओर जदुओ तक सेयो जिऊँदे रओए, सेयो मूर्खता रे काम करोए, फेर सेयो अचाणक मरी जाओए।<verse eid="ECC 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 9:4" />पर जो जिऊँदा माणूं ए तेसखे एक उम्मीद ए, कऊँकि जिऊँदा कुत्ता मरे रे शेरो ते बढ़ी की ए।<verse eid="ECC 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 9:5" />कऊँकि जिऊँदे माणूं इतणा तो जाणोए कि सेयो मरने, पर मरे रे माणूं कदी बी ना तो कुछ जाणदे ओर ना तिना खे कोई ओर ईनाम मिलणा, ओर कोई बी तिना खे याद नि करदा।<verse eid="ECC 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 9:6" />तिना रा प्यार ओर जल़न ओर तिना री जीद नाश ऊई चूकी री ओर एबे जो कुछ तरतिया पाँदे कित्तेया जाओआ, तिदे सदा खे तिना रा ओर कोई इस्सा नि ऊणा।<verse eid="ECC 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7" />आपणियां बाटा रिये चली जा, आपणी रोटी खुशिया रे खाया कर ओर मनो रे सुख मानी की आपणा अंगूरा रा रस पिया कर, कऊँकि परमेशर ए ई चाओआ।<verse eid="ECC 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 9:8" />तेरे टाल्ले सदा चमकदार ओर साफ ओ ओर तेरे सिरो रे हमेशा तेल लगेया दा रओ।<verse eid="ECC 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 9:9" />एते तरतिया पाँदे तुसा रा जीवन थोड़ा जा ई रणा ओर ये कठण बी ऊणा। पर तुसे आपणियां लाड़िया ते प्यार करोए, ईंयाँ मिली की तुसे आपणे जीवनो दे मजे करो। एई तरतिया पाँदे रणे रा तरीका ए। <verse eid="ECC 9:9" /><verse number="10" style="v" sid="ECC 9:10" />इजी री खातर जो कुछ तुसे करी सकोए से पूरिया शक्तिया ते करो, कऊँकि मरने ते बाद तुसे कुछ पनि करी सकदे जेड़ा कि सोचोए, केसी चीजा खे टोल़ना या समजदार ऊणा।<verse eid="ECC 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11" />तेबे मैं तरतिया पाँदे देखेया कि ना तो दौड़ा रे तेज दौड़ने वाल़े ओर ना युद्धो रे शूरवीर जीतदे, ना अक्लमंद लोका खे रोटी मिलदी, ना समजदारा खे तअन ओर ना ज्ञानिया पाँदे दया ऊँदी, सेयो सब संयोग ओर बखतो रे वशो रे ए। <verse eid="ECC 9:11" /><verse number="12" style="v" sid="ECC 9:12" />माणूं नि जाणी सकदा कि बुरा बखत कदी आऊणा,<note caller="+" style="f"><char style="fr" closed="false">9:12 </char><char style="ft" closed="false">मरने रा दिन</char></note> जिंयाँ मछलिया दु:ख देणे वाल़े जाल़ो रे फसोईया ओर चिड़िया फन्दे रे फसोईया, तिंयाँ ई माणूं बी दु:खो रे बखतो रे जो तिना पाँदे अचाणक आओआ, फसी जाओए।<verse eid="ECC 9:12" /></para>
  <para style="s">अक्लमंद ओर मूर्खो रे बिचार</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13" />मैं तरतिया पाँदे अक्लमंद माणूंए खे कुछ करदे देखेया, जिना गल्ला ते मां पाँदे बऊत असर पड़ेया।<verse eid="ECC 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 9:14" />एक छोटा जा शईर था, जिदे बऊत ई कम लोक थे, तेबे किनी बड़े राजे तेते शईरो पाँदे चढ़ाई करी की से केरी ता ओर तिजी रे चऊँ कनारे सैनिक खड़े करीते।<verse eid="ECC 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 9:15" />पर तिदे एक गरीब अक्लमंद माणूं था ओर तिने से शईर आपणियां बुद्धिया रे जरिए बचाया, तेबे बी लोक तेस गरीब माणूंए खे पूली गे।<verse eid="ECC 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 9:16" />तेबे माखे ये पता लगेया कि अक्लमंद ऊणा तागतबर ऊणे ते खरा ए, फेर बी जे तुसे गरीब ए, तो केसी बी तुसा री तारीफ नि करनी, ओर लोक जल्दी ई पूली जाणे जो तुसे बोलेया था।<verse eid="ECC 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 9:17" />मूर्खा रिया सबा दे राजे रे जोरे की बोलणे ते जादा अच्छा ए केसी अक्लमंद माणूंए रिया शांत गल्ला खे सुणना।<verse eid="ECC 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 9:18" />लड़ाईया रे अथियारा ते बुद्धि खरी ए, पर एक पापी बऊत पलाईया खे नाश करी देओआ।<verse eid="ECC 9:18" /></para>
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" sid="ECC 10" />
  <para style="s">ज्ञानो री ओर मूर्खता री तागत</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 10:1" />जिंयाँ मरी रिया माक्खिया रिया बजा ते गन्धो रा तेल सड़ने लगोआ ओर तिदे बास आऊणे लगोई, तियाँ ई थोड़ी जी मूर्खता बुद्धि ओर प्रतिष्ठा खे खराब करी देओई।<verse eid="ECC 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 10:2" />अक्लमंदो रा मन खरी गल्ला रिया तरफा खे लगेया रा रओआ, पर मूर्खो रा मन तिजी ते उल्टा चलोआ।<verse eid="ECC 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 10:3" />मूर्ख आपणे जिऊँणे रे तरीके रे जरिये आपणी मूर्खता दखाओआ, ओर सानिया ते पता चली जाओआ कि तिना दे कोई समज नि ए।<verse eid="ECC 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 10:4" />जेबे परदानो रा गुस्सा तां पाँदे पड़को, तेबे तैं आपणा काम नि छाडणा, कऊँकि जे तूँ सब्र राखेगा तो तेरे बड़े-बड़े पाप बी माफ ऊई सकोए।<verse eid="ECC 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 10:5" />एक बुराई ए जो मैं तरतिया पाँदे देखी, एते बुराईया रा जिम्मेबार से परदान ई ए।<verse eid="ECC 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 10:6" />मूर्खो खे बड़ी ओर ऊच्ची जगा मिलोई ओर अमीर लोका खे थाले ई बैठणा पढ़ोआ।<verse eid="ECC 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 10:7" />मैं दासा खे कोड़ेया पाँदे चढ़े दे ओर परदाना खे दासो जेड़े जमीना दे पैदल चलदे ऊए देखेया।<verse eid="ECC 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 10:8" />जो कोई गड्डा खणो आ से तिदे ई रूड़ना ओर जो बाड़ तोड़ो से सापो कटणा।<verse eid="ECC 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 10:9" />जो माणूं पात्थर तोड़ो से तिना ते ई कायल ऊणा, ओर जो लकड़ू बाडोगा, तेसखे तिजी ते ई काओ ऊणा।<verse eid="ECC 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 10:10" />जे क्वाड़ी खूँडी ओ ओर माणूं तिजी खे पैना नि करो, तो जादा तागत लगाणी पड़नी, पर सफल ऊणे खे अक्लमंद ऊणा जरूरी ए।<verse eid="ECC 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 10:11" />जे मंत्रो ते पईले साप डसो, तो मंत्र पढ़ने वाल़े खे कोई फायदा नि ए।<verse eid="ECC 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 10:12" />अक्लमंद माणूंए रिया गल्ला रिया बजा ते दया ओई, पर मूर्ख माणूं आपणे ई मुंए ते निकल़ी रिया गल्ला ते नाश ओआ।<verse eid="ECC 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 10:13" />मूर्खो रिया गल्ला री शुरूआत मूर्खता ते ओर अन्त दु:ख देणे वाल़ा पागलपन ओआ।<verse eid="ECC 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 10:14" />मूर्ख माणूं बऊत गल्ला बढ़ाई की बोलोआ, तेबे बी आसा बिचा ते कोई नि जाणदा कि मरने ते बाद क्या ऊणा?<verse eid="ECC 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 10:15" />मूर्ख काम करदा ऊआ इतणा थकी जाओआ कि से नि जाणदा कि आपणे शईरो खे किंयाँ जाओ।<verse eid="ECC 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 10:16" />ओ देशो रे लोको, तुसा पाँदे हाय, जेबे तुसा रा राजा बाल़क ई ए ओर तुसा रे परदान प्यागा ते ई रोटी खाणे लगी जाओए!<verse eid="ECC 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 10:17" />ओ देश, तूँ तन्य ए, जेबे तेरा राजा कुलीन ए ओर तेरे परदान बखतो पाँदे रोटी खाओए ओर से बी मतवाल़े ऊणे खे नि, पर तागत बढ़ाणे खे!<verse eid="ECC 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 10:18" />कुछ लोक इतणे आल़सी ओए ओर सेयो आपणे करो री मरम्मत नि करदे, ओर पाणी लगणे ते तिजी रिया कड़िया कमजोर ऊई जाओईया इजी बजा ते छत कमजोर ऊई की टल़ी जाओई।<verse eid="ECC 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ECC 10:19" />पाट्टिया खुशिया दे कित्तिया जाओईया ओर अंगूरा रे रसो ते जिन्दगिया खे मजे मिलोए ओर पैसेया ते सब कुछ मिलोआ।<verse eid="ECC 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 10:20" />राजे खे मनो दे बी स्राप नि देणा, ना अमीरो खे आपणे सऊणे रे कमरे दे स्राप देणा, कऊँकि सर्गो रे केसी पंछिये तेरी बाणी लई जाणी ओर केसी उडने वाल़े जन्तुए तेरी से गल्ल बताई देणी।<verse eid="ECC 10:20" /></para>
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" sid="ECC 11" />
  <para style="s">मईणता री कीमत</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 11:1" />आपणी रोटी पाणिए पाँदे पाई दे, कऊँकि से ताखे बऊत दिना ते बाद फेर मिली जाणी।<note caller="+" style="f"><char style="fr" closed="false">11:1 </char><char style="ft" closed="false">मतलब आपणा पैसा जो तैं कमाई राखेया तेस दूर देशो दे बपारो दे लगाई दे तो से ताखे फेर मिली जाणा।</char></note><verse eid="ECC 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 11:2" />तूँ आपणा पैसा सात नि बल्कि आठा जणेया खे बांडी दे, कऊँकि तूँ नि जाणदा कि तरतिया पाँदे मुसीबत कदी बी आई सकोई। एड़िया जरूरती रे बखते देणे ते तेरिया मुसीबता रे बखते तिना तेरी मताद करनी।<verse eid="ECC 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 11:3" />ये हमेशा सच्च ओआ कि जेबे बादल़ पाणिए साथे परोए, तेबे सेयो आपू ई तरतिया पाँदे बरसी जाओए ओर ईंयाँ ई डाल़ जेते तरफा खे पड़ना तेथी पड़ेया रा रणा।<verse eid="ECC 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 11:4" />जो अवा खे देखदा रओआ, से बेजा नि बाई सकदा, जो बादल़ा खे देखदा रओआ, से फसल बाडी नि सकदा।<verse eid="ECC 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 11:5" />जिंयाँ तूँ अवा रे चलणे री बाट नि जाणदा ओर गर्भवतिया रे पेटो रे बच्चे रिया आड्डिया किंयाँ बढ़ोईया नई जाणदा, तिंयाँ ई तूँ परमेशरो रा काम पनि जाणदा, जिने सब कुछ बणाई राखेया।<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false">यूह. 3:8</char></note><verse eid="ECC 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 11:6" />प्यागा ऊट्ठी की आपणा बेजा बा ओर साँजा बी आपणा काम करदे रणा, कऊँकि तूँ नि जाणदा कि कुण जा बीज सफल ऊणा, ये या से या दोनो के दोनो अच्छे निकल़ने।<verse eid="ECC 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 11:7" />दिनो रा प्रयासा देखणा कितणी खुशिया री गल्ल ओई। जिऊँदा रणा बऊत ई अचम्बा ए।<verse eid="ECC 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 11:8" />पले ई लोक कईया साला तक जिऊँदे रओ, पर तिना खे ये नि पुलणा चाईयो कि कदी सेयो बी मरने ओर फेर तिना बी कदी प्रयासा नि देखणा, ओर आसे नि जाणदे कि मारे मरने ते बाद आसा साथे क्या ऊणा।<verse eid="ECC 11:8" /></para>
  <para style="s">जवान लोका खे सलाह्</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 11:9" />ओ जवान, आपणियां जवानिया दे मौज कर ओर आपणी जवानिया रे दिनो रे मगन रओ; आपणी मनमानी कर ओर आपणियां आखी रिया इच्छा रे मुताबिक चल, पर ये जाणी लया कि इना सबी गल्ला रे बारे दे परमेशरो तेरा न्याय करना।<verse eid="ECC 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 11:10" />आपणे आपू खे सबी चिन्ता ओर दु:ख दर्दो ते दूर राख, कऊँकि जवानिया रे लक्षण बऊत ई छोड़ राची जाओए।<verse eid="ECC 11:10" /></para>
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" sid="ECC 12" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 12:1" />इजी ते पईले की मुसीबता रे दिन ओर सेयो साल आओ, जिना रे तूँ बोले कि मेरा मन इना गल्ला रे नि लगदा। आपणी जवानिया रे दिनो रे आपू खे बनाणे वाल़े खे याद राख,<verse eid="ECC 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 12:2" />जेबे तूँ स्याणा ऊई जाए तेबे ताखे सूरज ओर प्रयासा चाँद ओर तारे तुँदल़े दिखणे लगणे, ओर सर्गो दे काल़े बादल़ छाई जाणे!<verse eid="ECC 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 12:3" />तेस बखते कअरो खे बचाणे वाल़े पईरेदार थरथराणे, ओर तागतबरा री तागत कअटी जाणी ओर पीसणे वाल़िया थोड़िया जिया रणे रिया बजा ते काम करना छाडी देणा, ओर द्वारिया रिये चाँकणे वाल़िया अन्दिया ऊई जाणिया।<verse eid="ECC 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 12:4" />सड़का रिया तरफा रे द्वार बन्द ऊई जाणे ओर चाक्की पीसणे री आवाज आऊल़ी ऊई जाणी ओर तड़के चिड़िया रे बोलदे ई एक उठी जाणा ओर सब गाणे वाल़िया री आवाज आऊल़ी ऊई जाणी।<verse eid="ECC 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 12:5" />तेबे जो ऊच्चा ओ, तेसते डर ऊणा ओर बाटा रे डराऊणी चीजा मानणियां; बदामो रा डाल़ फूलणा, टिड्डी बी पारी लगणी ओर पूख बढ़ाणे वाल़े फल़ो फेर काम नि देणा, कऊँकि माणूं आपणे सदा रे कअरो खे जाणा ओर रोणे-पीटणे वाल़े सड़का रे फिरने।<verse eid="ECC 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 12:6" />तेस बखते चाँदिए रिया तारा रे दो टुकड़े ऊणे ओर सूईने रा कटोरा टुटणा ओर सूबल़ा गे कअड़ा फूटणा ओर कुण्डो गे चाक्का टूटी जाणा। तुसे आपणे बनाणे वाल़े परमेशरो खे याद राखणा,<verse eid="ECC 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 12:7" />तेबे म्हारी देह माट्टिया दे मिली जाणी, ओर आत्मा परमेशरो गे जिने से देई राखी वापस ऊई जाणी।<verse eid="ECC 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 12:8" />उपदेश देणे वाल़ा बोलोआ, “सब बेकार ई बेकार ए; सब कुछ बेकार ए।”<verse eid="ECC 12:8" /></para>
  <para style="s">सारिया गल्ला रा निचोड़</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9" />आऊँ एक अक्लमंद सखाणे वाल़ा था, ओर मैं बऊत चीजा देखिया, मैं सेयो सारे नसीअता रिया गल्ला लिखी ले जो मैं सिखे थे।<verse eid="ECC 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 12:10" />मैं सई शब्दा री खोजबीन कित्ती, ओर मैं जो गल्ला लिखिया सेयो परोसे जोगिया ओर सच्चिया ए।<verse eid="ECC 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 12:11" />अक्लमंदो रे वचन कांडेया जेड़े पैने ओए ओर सभा दे परदानो रे वचन लगाई दी कीला जेड़े ओए, कऊँकि यो एक ई परमेशरो रिया तरफा ते मिलोए।<note caller="+" style="f"><char style="fr" closed="false">12:11 </char><char style="ft" closed="false">परमेशर</char></note><verse eid="ECC 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 12:12" />ओ मेरे पाऊ, इना गल्ला रेई चौकसी कर, बऊत सारिया कताबा री रचना रा अन्त नि ऊँदा ओर बऊत पढ़ना शरीरो खे थकाई देओआ।<verse eid="ECC 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 12:13" />जो बी मैं तुसा खे बताया, तिजी रा निचोड़ बस इतना ई आ कि तुसे परमेशरो रा डर मानो ओर तेसरी सुणो जेड़ा से बोलोआ, कऊँकि आसे माणूं इजी खे ई बणाई राखे ओर एड़ा करना म्हारा फर्ज ए।<verse eid="ECC 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 12:14" />कऊँकि परमेशर सबी कामा खे ओर सब गुप्त गल्ला खे, चाए सेयो खरिया ए, चाए सेयो बुरिया, न्याय करोआ।<note caller="+" style="f"><char style="fr" closed="false">12:14 </char><char style="ft" closed="false">2 कुरिन्थ 5:10</char></note><verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>