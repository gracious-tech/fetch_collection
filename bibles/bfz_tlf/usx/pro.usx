  <para style="h">नसीअता</para>
  <para style="toc1">नसीअता रिया गल्ला</para>
  <para style="toc2">नसीअता</para>
  <para style="toc3">नसी.</para>
  <para style="mt">नसीअता</para>
  <para style="mt2">नसीअता रिया गल्ला</para>
  <para style="is">भूमिका</para>
  <para style="ip">राजा सुलेमान नसीअता रा लिखणे वाल़ा था। <char style="xt"><ref loc="PRO 1:1">1:1</ref>; <ref loc="PRO 10:1">10:1</ref>; <ref loc="PRO 25:1">25:1</ref></char> दे सुलेमानो रा नाओं प्रगट आ। जो ओर बी इजी खे लिखणे वाल़े ए तिना रे चूण्डो खे “अक्लमंद” बोलो थे, आगूर ओर राजा लमूएल ए। बाकि बाईबला रे ओर नसीअता परमेशरो रे उद्धारो री योजना कनारो खे इशारा करोए, पर बऊत ई गराइया ते। एते कताबा दे इस्राएलिया खे परमेशरो रिया बाटा दे चलणे रा सई तरीका दखाई राखेया। ये सई ए कि परमेशरे सुलेमानो खे प्रेरित कित्तेया कि से तिना अक्लमंदिया रिया गल्ला रे आधारो पाँदे इना खे लिखो जो तिने आपणियां पुरिया जिन्दगिया दे सीखे थे।</para>
  <para style="ip">सुलेमान राजे रे राज्यकालो दे इस्राएलो दे, नसीअत कई ह्जार साल पईले लिखी राखे थे। एसरिया अक्लमंदा रिया गल्ला केसी बी संस्कृतिया दे ओर केसी बी बखते इस्तेमाल ऊई सकोईया।</para>
  <para style="ip">नसीअता रिया कताबा दे सुलेमान उच्चे ओर सबी ते खरे ओर सादारण ओर आपणे रोजके जीवनो दे परमेशरो री इच्छा खे प्रगट करोआ। एड़ा लगोआ कि सुलेमान राजे रिया नजरा दे ओर कोई बी गल्ल नि बची। आपणा व्यक्तिगत सम्बन्द, यौन सम्बन्द, बपार, तअन-दौलत, दान, इच्छा, अनुशासन, कर्ज, पालण-पोषण, चरित्र, नशाखोरी, राजनीति, बदला लणा ओर परमेशरो री पगती करना आदि कईया अक्लमंदिया रिया गल्ला पाँदे एते कताबा दे सोच-विचार करी राखेया ए।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">अक्ला रे अच्छे गुण <char style="ior"><ref loc="PRO 1:1-9:18">1:1-9:18</ref></char></para>
  <para style="io1">सुलेमानो रे नसीअत <char style="ior"><ref loc="PRO 10:1-22:16">10:1-22:16</ref></char></para>
  <para style="io1">अक्लमंदा रिया गल्ला <char style="ior"><ref loc="PRO 22:17-29:27">22:17-29:27</ref></char></para>
  <para style="io1">आगूरो रिया गल्ला <char style="ior"><ref loc="PRO 30:1-31">30:1-31</ref></char></para>
  <para style="io1">लमूएलो रिया गल्ला <char style="ior"><ref loc="PRO 31:1-31">31:1-31</ref></char></para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s">समजदार ऊणे री शुरूआत</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />इस्राएलो रे राजा सुलैमानो रे जो दाऊदो रा पाऊ ए तेसरे जरिये लिखे दे समजा रे वचन:<verse eid="PRO 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 1:2" />इना वचना खे पढ़ने वाल़ेया खे समज ओर शिक्षा मिलो,</para>
  <para style="q" vid="PRO 1:2">ओर सई-गल़त, सच्च ओर चूठो दे फर्क समजो,<verse eid="PRO 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 1:3" />इना वचना रे जरिये तुसा आपणे जीवनो दे अनुशासन ओर काबू पाणा सिखणा, आपणा जीवन जीऊणा ओर सेओ काम करने जो सई ओर न्याय रे ओ।<verse eid="PRO 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 1:4" />ताकि जो माणूं पोल़ा-पाल़ा ए समजौतिया रिया गल्ला खे पढ़ी की उशयार बणो,</para>
  <para style="q" vid="PRO 1:4">ओर जवाना खे ज्ञान ओर विवेक मिलो;<verse eid="PRO 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 1:5" />ताकि अक्लमंद इना वचना खे सुणी की आपणी बिद्या बढ़ाओ</para>
  <para style="q" vid="PRO 1:5">ओर समजदार माणूं अक्ला री शिक्षा पाओ,<verse eid="PRO 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 1:6" />जेतेरे जरिए माणूं नसीअत ओर उदारणा रा मतलब समजो,</para>
  <para style="q" vid="PRO 1:6">ओर अक्लमंद माणूंए रिया गल्ला ओर तिना रिया गईरिया गल्ला खे समजो।<verse eid="PRO 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 1:7" />यहोवे रा आदर करना बुद्धिया रा मूल़ ए,</para>
  <para style="q" vid="PRO 1:7">बुद्धि ओर शिक्षा खे मूर्ख लोक ई तुच्छ जाणोए।<verse eid="PRO 1:7" /></para>
  <para style="s">बुरिया सलाई ते बचणा</para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 1:8" />ओ मेरे पाऊआ, आपणे बाओ रिया शिक्षा खे त्यानो साथे सुणेया,</para>
  <para style="q" vid="PRO 1:8">ओर देखेया, आपणियां माया री दित्ती री शिक्षा खे छाडदा;<verse eid="PRO 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 1:9" />तिना री शिक्षा मानो तेरे सिरो रिया तँईं बांका मुकुट,</para>
  <para style="q" vid="PRO 1:9">ओर तेरे गल़े खे माल़ा जेड़ी ऊणी।<verse eid="PRO 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 1:10" />ओ मेरे पाऊ, जे पापी लोक ताखे बईकाओ,</para>
  <para style="q" vid="PRO 1:10">तो तूँ तिना रिया गल्ला खे नि मानेया।<verse eid="PRO 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 1:11" />जे सेयो ताखे एड़ा बोलो, “आसा साथे आईजा,</para>
  <para style="q" vid="PRO 1:11">ताकि आसे अत्या करने रिया ताका रे जाऊँए,</para>
  <para style="q" vid="PRO 1:11">आसे निर्दोष माणूंए पाँदे अमला करूँए;<verse eid="PRO 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 1:12" />आओ, आसे अधलोको जेड़ा तिना खे जिऊँदे ई निगल़ी जाऊँए,</para>
  <para style="q" vid="PRO 1:12">ओर तिना खे कब्रा रे पड़े रे मरेया जेड़े बणाई देऊँए।<verse eid="PRO 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 1:13" />आसा तिना रिया नेका-प्रकारा रिया कीमती चीजा लड़ाईया दे लूटी लणियां,</para>
  <para style="q" vid="PRO 1:13">ओर आसा आपणे कअर तिना री लूटा रे समानो साथे परी देणे;<verse eid="PRO 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 1:14" />इजी खे तूँ आसा साथे साजी ऊई जा,</para>
  <para style="q" vid="PRO 1:14">आसा सबी जणेया से लूट आपू बीचे बांडी लणी।”<verse eid="PRO 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 1:15" />तो, ओ मेरे पाऊआ, तूँ तिना रे जे काम नि करेया,</para>
  <para style="q" vid="PRO 1:15">बल्कि तिना रिया बाटा रे पैर पनि राखणा;<verse eid="PRO 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 1:16" />कऊँकि सेयो बुराई करने खेई दौड़ोए,</para>
  <para style="q" vid="PRO 1:16">ओर अत्या करने खे फुर्ती करोए।<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">रोमी 3:15-17</char></note><verse eid="PRO 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 1:17" />जेबे पंछी देखणे लगी रा ओ तेबे जाल़ बछाणा बेकार ओआ;<verse eid="PRO 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 1:18" />ओर यो लोक तो आपणी ई अत्या करने रिया तँईं घात लगाई राखोए,</para>
  <para style="q" vid="PRO 1:18">ओर आपणे ई प्राण लणे रिया ताका रे लूकी रओए।<verse eid="PRO 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 1:19" />सारे लाल़ची माणूंआ रा लोब ई तिना रिया मौता री बजा बणना;</para>
  <para style="q" vid="PRO 1:19">तिना रे प्राण लाल़चो रिया बजा ते नाश ऊई जाणे।<verse eid="PRO 1:19" /></para>
  <para style="s">समजा री पुकार</para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 1:20" />बुद्धि सड़का दे जोरे की बोलोई;</para>
  <para style="q" vid="PRO 1:20">ओर चौका बीचे प्रचार करोई;<verse eid="PRO 1:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 1:21" />से बजारा रिया पीड़ा बीचे जोरे की आका पाओई;</para>
  <para style="q" vid="PRO 1:21">से शईरो रे प्रवेश द्वारो पाँदे खड़ी ऊई की इना गल्ला खे बोलोई,<verse eid="PRO 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 1:22" />“ओ शरीफ लोको, तुसा कदुए तक शरीफताईया साथे प्यार राखणा?</para>
  <para style="q" vid="PRO 1:22">ओर ओ ज्ञानो रा मजाक ड्वाणे वाल़ेयो, तुसा कदुए तक ज्ञानो रा मजाक ड्वांदे रणा?</para>
  <para style="q" vid="PRO 1:22">ओर ओ मूर्खो, तुसा कदुए तक ज्ञानो ते बैर राखणा?<verse eid="PRO 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 1:23" />सुणो जेबे आऊँ तुसा खे बकुँई, आऊँ तुसा खे अच्छी सलाह देऊँगी ओर आपणे ज्ञानो खे तुसा साथे बाँडुंगी”<verse eid="PRO 1:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 1:24" />मैं तो आका पाईया, पर तुसे मेरी गल्ल मानणे ते ना करिती,</para>
  <para style="q" vid="PRO 1:24">ओर मैं तुसा खे बुलाणे खे आपणे आथ ईलाए, पर तुसा बीचा ते किने बी त्यान नि दित्तेया,<verse eid="PRO 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 1:25" />बल्कि तुसे मेरी सलाह अणसुणी करिती,</para>
  <para style="q" vid="PRO 1:25">ओर मेरी डाँट-फटकारा री कीमत नि जाणी;<verse eid="PRO 1:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 1:26" />इजी री खातर तुसा री मुसीबता पाँदे मां बी आसणा,</para>
  <para style="q" vid="PRO 1:26">ओर जेबे तुसा पाँदे डर आऊणा, तेबे मां मजाक उडाणा।<verse eid="PRO 1:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 1:27" />बल्कि तूफानो जेड़ा तुसा पाँदे डर आऊणा,</para>
  <para style="q" vid="PRO 1:27">ओर मुसीबत तुसा पाँदे प्रचण्ड अवा जेड़ी आऊणी</para>
  <para style="q" vid="PRO 1:27">ओर तुसे संकट ओर कष्टो रे फसणे,</para>
  <para style="q" vid="PRO 1:27">तेबे मां तुसा रा मजाक ड्वाणा।<verse eid="PRO 1:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 1:28" />तेस बखते तिना आऊँ आपणियां मतादा खे बुलाणी, पर तेस बखते मां तिना री नि सुणनी।</para>
  <para style="q" vid="PRO 1:28">तिना माखे टोल़ने री कोशिश तो करनी, पर आऊँ तिना खे मिलणी नि।<verse eid="PRO 1:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 1:29" />कऊँकि तिने ज्ञानो रिया गल्ला मानणे ते ना कित्ती,</para>
  <para style="q" vid="PRO 1:29">ओर तिने यहोवे रा डर ना मानणे रा फैंसला कित्तेया।<verse eid="PRO 1:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 1:30" />तिने मेरी सलाह लणी नि चायी,</para>
  <para style="q" vid="PRO 1:30">बल्कि तिने मेरा बोलणा-बकणा बेकार समजेया।<verse eid="PRO 1:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 1:31" />इजी री खातर तिना खे बुरेया कामा रा नतीजा पुगतणा पड़ना,</para>
  <para style="q" vid="PRO 1:31">ओर जो तुसे करी राखेया, तिजी ते तुसा खे ई आफत ऊणी।<verse eid="PRO 1:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 1:32" />बिना जानकारीया ते माणूं मरी जाओए कऊँकि सेओ समजा खे नि मानदे,</para>
  <para style="q" vid="PRO 1:32">मूर्ख माणूं बी बर्बाद ऊई जाओए कऊँकि सेओ बेफिक्र ऊई कि बैठे दे रओए।<verse eid="PRO 1:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 1:33" />पर जो माणूं मेरी गल्ल सुणोगा, से बिना डरे बसेया रा रणा,</para>
  <para style="q" vid="PRO 1:33">ओर मुसीबता ते बेफिकर ऊई की सुखो रे रणा।<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s">ज्ञानो री कीमत</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 2:1" />ओ मेरे बच्चेयो, जे तुसे मेरिया गल्ला खे मानो</para>
  <para style="q" vid="PRO 2:1">ओर मेरी आज्ञा खे आपणे मनो दे राखो,<verse eid="PRO 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 2:2" />ओर अक्ला रिया गल्ला त्यानो साथे सुणे,</para>
  <para style="q" vid="PRO 2:2">ओर समजा री गल्ल मन लगाई की सोचे;<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">नीति 23:12</char></note><verse eid="PRO 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 2:3" />ओर जे तूँ ओशियारी ओर समजा खे बऊत कोशिशा ते आका पाई की बुलाए,<verse eid="PRO 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 2:4" />ओर जे तूँ तिजी खे चाँदिए रिया खानी जेड़ा टोल़ो,</para>
  <para style="q" vid="PRO 2:4">ओर गुप्त खजाने जेड़ा तिजी खे टोल़दा रये;<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">मत्ती 13:44</char></note><verse eid="PRO 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 2:5" />तेबे तां यहोवे रा डर समजणा,</para>
  <para style="q" vid="PRO 2:5">ओर परमेशरो रा ज्ञान ताखे मिलणा।<verse eid="PRO 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 2:6" />कऊँकि यहोवा ई बुद्धि देओआ,</para>
  <para style="q" vid="PRO 2:6">ओर तेसरे मुंए तेई ज्ञान ओर समजा रिया गल्ला निकल़ोईया।<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">याकूब 1:5</char></note><verse eid="PRO 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 2:7" />से सीदे लोका खे खरी बुद्धि देओआ;</para>
  <para style="q" vid="PRO 2:7">जिना रा चाल-चलण खरा ओआ, तिना रा से रक्षक बणोआ।<verse eid="PRO 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 2:8" />से न्याय रिया बाटा दे चलणे वाल़ेया री देख-पाल़ करोआ,</para>
  <para style="q" vid="PRO 2:8">ओर आपणे विश्वासो जोगे रणे वाल़ेया रिया बाटा री रक्षा करोआ।<verse eid="PRO 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 2:9" />जे तू मेरिया गल्ला खे सुणे, तो ताखे पता लगी जाणा कि क्या ठीक, न्याय ओर बिना पक्ष-पातो ते ए।</para>
  <para style="q" vid="PRO 2:9">ताखे पता लगी जाणा कि ताखे क्या करना चाईयो।<verse eid="PRO 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 2:10" />कऊँकि बुद्धि तो तेरे मनो रे आऊणी,</para>
  <para style="q" vid="PRO 2:10">ओर ज्ञान ताखे सुख देणे वाल़ा लगणा;<verse eid="PRO 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 2:11" />विवेको तेरी निगरानी राखणी,</para>
  <para style="q" vid="PRO 2:11">ओर समजा तू सम्बाल़ी की राखणी,<verse eid="PRO 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 2:12" />ताकि यो वरदान ताखे बुराईया रिया बाटा ते,</para>
  <para style="q" vid="PRO 2:12">ओर उल्टिया-फुल्टिया गल्ला करने वाल़ेया ते बचाओ,<verse eid="PRO 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 2:13" />जो सच्चाईया री बाटा खे छाडी देओए,</para>
  <para style="q" vid="PRO 2:13">ताकि बुरिया बाटा दे चलो।<verse eid="PRO 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 2:14" />सेयो बुराई करने ते खुश ओए,</para>
  <para style="q" vid="PRO 2:14">ओर दुष्ट माणूंए री उल्ट फेरो रिया गल्ला ते खुश रओए;<verse eid="PRO 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 2:15" />तिना लोका रा चाल-चलण ठीक नि ए,</para>
  <para style="q" vid="PRO 2:15">ओर तिना रिया बाटा प्रष्ट ऊई गी रिया।<verse eid="PRO 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 2:16" />बुद्धि ओर विवेक ग्रईण करने ते तूँ पराई जवाणसा ते बी बचणा,</para>
  <para style="q" vid="PRO 2:16">जो मीठिया-मीठिया गल्ला बोली की फसाई देओई,<verse eid="PRO 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 2:17" />से आपणे जवानिया रे लाड़े खे छाडी देओई;</para>
  <para style="q" vid="PRO 2:17">ओर आपणे परमेशरो सामणे कित्ती री वाचा खे पूली जाओई।<verse eid="PRO 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 2:18" />एड़िया जवाणसा रे कअरो रिया तरफा खे जाणा तेड़ा ई ए जेड़ा मौता रिया बाटा दे जाणा,</para>
  <para style="q" vid="PRO 2:18">तेती जाणा नरको रिया तरफा खे जाणे रे बराबर ए;<verse eid="PRO 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 2:19" />जो तेसा गे जाओए, तिना बीचा ते कोई बी वापस नि आऊँदा;</para>
  <para style="q" vid="PRO 2:19">ओर ना ई फेर तिना खे जिन्दगिया री बाट मिलदी।<verse eid="PRO 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 2:20" />इजी रिया तँईं तूँ खरे माणूंआ रिया बाटा दे चल,</para>
  <para style="q" vid="PRO 2:20">ओर तर्मिया री बाटा खे पकड़ी की राख।<verse eid="PRO 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 2:21" />कऊँकि सीदे लोक देशो दे बसे दे रणे,</para>
  <para style="q" vid="PRO 2:21">ओर खराईया साथे चलणे वाल़े लोक ई तिदे टिके दे रणे।<verse eid="PRO 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 2:22" />पर दुष्ट लोक तेस देशो बीचा ते नाश ऊणे,</para>
  <para style="q" vid="PRO 2:22">ओर विश्वासघाती तेथा ते बारे करी देणे।<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s">नौजवाना खे सलाह</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 3:1" />ओ मेरे बच्चेयो, मेरिया शिक्षा खे नि पूलेयो,</para>
  <para style="q" vid="PRO 3:1">आपणे दिलो दे मेरिया आज्ञा खे याद राखेयो;<verse eid="PRO 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 3:2" />कऊँकि एड़ा करने ते तेरी उम्र बढ़नी,</para>
  <para style="q" vid="PRO 3:2">ओर तूँ जादा शान्तिया साथे रणा।<verse eid="PRO 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 3:3" />दया ओर सच्चाई तांते लग नि ओ,</para>
  <para style="q" vid="PRO 3:3">बल्कि सेयो आपणे गल़े रे आरो जेड़िया बनाणियां,</para>
  <para style="q" vid="PRO 3:3">ओर आपणे दिलो री पट्टिया पाँदे लिखी देणियां।<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">2 कुरिन्थ 3:3</char></note><verse eid="PRO 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 3:4" />जे तू एड़ा करे तो तां परमेशर ओर माणूं दुँईं री दया पाणी,</para>
  <para style="q" vid="PRO 3:4">तूँ बऊत अक्लमंद ऊणा।<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">लूक 2:52, रोमी 12:17, 2 कुरिन्थ 8:21</char></note><verse eid="PRO 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 3:5" />तैं आपणियां समजा रा साअरा नि लणा,</para>
  <para style="q" vid="PRO 3:5">बल्कि पूरे मनो ते यहोवे पाँदे परोसा राखणा।<verse eid="PRO 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 3:6" />तुसे जो कुछ बी करोए तिदे यहोवे खे याद राखो,</para>
  <para style="q" vid="PRO 3:6">ओर तेस तुसा खे सई बाट दखाणी।<verse eid="PRO 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 3:7" />तैं आपू खे आपणियां नजरा रे अक्लमंद नि समजणा,</para>
  <para style="q" vid="PRO 3:7">यहोवे रा डर मानणा, ओर बुराईया ते लग रणा।<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">रोमी 12:16</char></note><verse eid="PRO 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 3:8" />जे तू एड़ा करेगा, तो ये एक अच्छी दवा रे जेड़ा ऊणा,</para>
  <para style="q" vid="PRO 3:8">तेरे काओ ठीक ऊणे ओर तेरिया दर्दा खत्म ऊणिया।<verse eid="PRO 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 3:9" />आपणी तअन-दौलता ते यहोवे री महिमा करनी,</para>
  <para style="q" vid="PRO 3:9">ओर तैं आपणियां जमीना री फसला रा पईला फल़ देई कि यहोवे रा आदर करना।<verse eid="PRO 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 3:10" />जे तू एड़ा करे तो तेरे पण्डार नज्जे की परे दे रणे,</para>
  <para style="q" vid="PRO 3:10">ओर तेरे रसकुण्डो दे नया अंगूरा रा रस बह्यींदा रणा।<verse eid="PRO 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 3:11" />ओ मेरे पाऊ, यहोवे री शिक्षा ते मूँ नि फेरना,</para>
  <para style="q" vid="PRO 3:11">ओर जेबे से ताखे बको, तेबे तैं बुरा नि मानणा,<verse eid="PRO 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 3:12" />कऊँकि यहोवा जेसते प्यार करोआ, तेसखे बकोआ,</para>
  <para style="q" vid="PRO 3:12">जेड़ा कि बाओ, तेस माठे खे जेसखे से जादा प्यार करोआ।<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">इफिसि 6:4, इब्रानी 12:5-7</char></note><verse eid="PRO 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 3:13" />भाग्यशाली ए से माणूं जो यहोवे रिया आशिषा ते बुद्धि ओर समजा खे पाओआ,<verse eid="PRO 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 3:14" />कऊँकि बुद्धिया खे पाणा चाँदिए खे पाणे ते बढ़ी की ए,</para>
  <para style="q" vid="PRO 3:14">ओर तिजी रा फाईदा शुद्ध सूईने रे फाईदे ते बी खरा ए।<verse eid="PRO 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 3:15" />बुद्धि मूँगे ते बी जादा कीमती ए</para>
  <para style="q" vid="PRO 3:15">ओर जितणिया चीजा री तूँ इच्छा करेया, तिना बीचे कोई बी बुद्धिया जेड़ी नि ठईरनी।<verse eid="PRO 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 3:16" />तेसरे दाँणे आथो रे लाम्बी उम्र,</para>
  <para style="q" vid="PRO 3:16">ओर तेसरे खूँजे आथो रे तअन-दौलत ओर महिमा ए।<verse eid="PRO 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 3:17" />बुद्धि तेरिया जिंदगिया खे सुखी बणाई सकोई,</para>
  <para style="q" vid="PRO 3:17">ओर ताखे सई तरआ ते सम्बाल़ी की शान्तिया साथे राखोई।<verse eid="PRO 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 3:18" />जो माणूं बुद्धिया खे ग्रईण करी लओए, तिना खे से जिन्दगी देणे वाल़ी बणोई,</para>
  <para style="q" vid="PRO 3:18">ओर जो तिजी रे मुताबिक हांडोए सेयो बऊत ई भाग्यशाली ओए।<verse eid="PRO 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 3:19" />यहोवे आपणियां समजा साथे तरतिया री निऊँ पाई,</para>
  <para style="q" vid="PRO 3:19">ओर सर्ग आपणे ज्ञानो ते सई जगा दे राखेया।<verse eid="PRO 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 3:20" />तेसरिया ई समजदारिया ते डूगे समुद्र फूटी की निकल़े,</para>
  <para style="q" vid="PRO 3:20">ओर सर्गो ते पाल़ा पड़ोआ।<verse eid="PRO 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 3:21" />ओ मेरे पाऊआ, तूँ खरी बुद्धि ओर विवेक आपू गे राख,</para>
  <para style="q" vid="PRO 3:21">इना खे आपणियां नजरा रे सामणे ते जाणे नि देआ,<verse eid="PRO 3:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 3:22" />तेबे इना ते ताखे अनन्तकालो री जिन्दगी मिलणी,</para>
  <para style="q" vid="PRO 3:22">ओर यो ताखे तेरे गल़े रे आरो जेड़िया बणनियां।<verse eid="PRO 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 3:23" />तेबे तूँ आपणियां जिन्दगिया रिया बाटा रे बिना डरे ऊई की चलणा,</para>
  <para style="q" vid="PRO 3:23">ओर ना तेरे पैरा रे किजी चीजा ते ठोकर लगणी।<verse eid="PRO 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 3:24" />जेबे तूँ लेटणा, तेबे ताखे डर नि लगणा,</para>
  <para style="q" vid="PRO 3:24">ओर तूँ सुखो रिया नींजा साथे सऊणा।<verse eid="PRO 3:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 3:25" />अचाणक आऊणे वाल़े डरो ते नि डरना,</para>
  <para style="q" vid="PRO 3:25">ओर ना तेबे कबराणा, जेबे बुरेया लोका पाँदे मुसीबत आओ;<verse eid="PRO 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 3:26" />कऊँकि यहोवे ताखे साअरा देआ करना,</para>
  <para style="q" vid="PRO 3:26">ओर तेरे पैर फन्दे रे फसणे ते बचाई देणे।<verse eid="PRO 3:26" /></para>
  <para style="s">काम ओर पलाई करो</para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 3:27" />जे तांदे पला करने री तागत ए तो</para>
  <para style="q" vid="PRO 3:27">तिना रा पला जरूर करना, जो पलाई करने जोगे ओ।<verse eid="PRO 3:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 3:28" />जे तांगे आपणे पड़ोसिये खे देणे खे कुछ अए,</para>
  <para style="q" vid="PRO 3:28">तो तेसखे ये नि बोलणा कि जा काल आया, आऊँ ताखे काल देऊँगा।<note caller="+" style="f"><char style="fr" closed="false">3:28 </char><char style="ft" closed="false">2 कुरिन्थ 8:12</char></note><verse eid="PRO 3:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 3:29" />आपणे पड़ोसिये रे खलाफ बुरा करने रे बारे दे नि सोचणा,</para>
  <para style="q" vid="PRO 3:29">कऊँकि से तां पाँदे परोसा करी की तेरे पड़ोसो दे रओआ।<verse eid="PRO 3:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 3:30" />जिने माणूंए तां साथे बुरा बर्ताव नि करी राखेया ओ,</para>
  <para style="q" vid="PRO 3:30">तेस साथे बिना मतलबो रा मकद्दमा खड़ा नि करना।<verse eid="PRO 3:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 3:31" />हुड़दंग मचाणे वाल़े माणूंए रे बारे ईर्ष्या नि करनी,</para>
  <para style="q" vid="PRO 3:31">ना ई तेस जेड़ी चाल चलणा;<verse eid="PRO 3:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 3:32" />कऊँकि यहोवा बुरे माणूंआ ते नफरत करोआ,</para>
  <para style="q" vid="PRO 3:32">पर से आपणा पेत तर्मी लोका पाँदे खोलोआ।<verse eid="PRO 3:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 3:33" />दुष्ट लोका रे कअरे यहोवे रा स्राप</para>
  <para style="q" vid="PRO 3:33">ओर तर्मिया रे कअरो पाँदे तेसरी आशीष ओई।<verse eid="PRO 3:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 3:34" />दूजेया रा मजाक ड्वाणे वाल़ेया रा यहोवा पक्का मजाक ड्वाओआ,</para>
  <para style="q" vid="PRO 3:34">पर नम्र ओर खरेया लोका पाँदे यहोवा दया करोआ।<note caller="+" style="f"><char style="fr" closed="false">3:34 </char><char style="ft" closed="false">याकूब 4:6, 1 पत 5:5</char></note><verse eid="PRO 3:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 3:35" />अक्लमंद माणूंए रा तो मान-सम्मान बढ़दा रणा,</para>
  <para style="q" vid="PRO 3:35">पर मूर्खा री हर जगा बेज्जती ई ऊँदी रणी।<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s">अक्ला रे फाईदे</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 4:1" />ओ मेरे बच्चेयो, आपणे बाओ रिया शिक्षा खे त्यानो साथे सुणो,</para>
  <para style="q" vid="PRO 4:1">ओर मन लगाई की समजो।<verse eid="PRO 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 4:2" />कऊँकि मैं तुसा खे खरी शिक्षा देई राखी;</para>
  <para style="q" vid="PRO 4:2">मेरिया शिक्षा खे नि पुलणा।<verse eid="PRO 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 4:3" />सुणो, आऊँ बी आपणे बाओ रा छोटा पाऊ था,</para>
  <para style="q" vid="PRO 4:3">ओर माया रा कल्ला छोटा प्यारा पाऊ था,<verse eid="PRO 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 4:4" />ओर मेरा बाओ माखे ये बोली की सिखांदा रओ था,</para>
  <para style="q" vid="PRO 4:4">“तेरा मन मेरिया गल्ला पाँदे लगेया रा रओ;</para>
  <para style="q" vid="PRO 4:4">तूँ मेरिया आज्ञा खे मानदा ऊआ आपणा जीवन बितांदा रओ।<verse eid="PRO 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 4:5" />बुद्धिया खे प्राप्त कर, समजा खे बी प्राप्त कर;</para>
  <para style="q" vid="PRO 4:5">सेयो पूलणिया नि, ना मेरिया गल्ला मानणियां छाडणिया।<verse eid="PRO 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 4:6" />बुद्धिया खे नि छाड तेसा तेरी रक्षा करनी;</para>
  <para style="q" vid="PRO 4:6">तेसा साथे प्यार राख तेसा तेरा पईरा देणा।<verse eid="PRO 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 4:7" />बुद्धि महान् ए इजी री खातर तिजी खे पाणे री कोशिश कर;</para>
  <para style="q" vid="PRO 4:7">पर समजा खे हर किमती पाँदे आसिल करी लओ।<verse eid="PRO 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 4:8" />बुद्धिया ते प्रेम राख, तेसा तूँ बढ़ाणा;</para>
  <para style="q" vid="PRO 4:8">जेबे तूँ तेसा साथे लिपटी जाए, तेबे तेसा तेरी इज्जत बढ़ाणी।<verse eid="PRO 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 4:9" />तेसा तेरे सिरो रे शोभा वाल़े गईणे बानणे;</para>
  <para style="q" vid="PRO 4:9">ओर ताखे सुन्दर मुकुट देणा।”<verse eid="PRO 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 4:10" />ओ मेरे बच्चेयो, मेरिया गल्ला सुणी की मानया करो,</para>
  <para style="q" vid="PRO 4:10">तेबे तुसे बऊत साला तक जिऊँदे रणे।<verse eid="PRO 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 4:11" />मैं ताखे बुद्धिया साथे चलणा बताई राखेया;</para>
  <para style="q" vid="PRO 4:11">ओर सच्चाईया रिया बाटा रे चलाई राखेया।<verse eid="PRO 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 4:12" />जिदे चलणे रे ताखे कोई रोक-टोक नि ऊणी,</para>
  <para style="q" vid="PRO 4:12">ओर चाए तूँ दौड़े, तेबे बी तांदे किजी ते बी ठोकर नि लगणी।<verse eid="PRO 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 4:13" />जो कुछ बी मैं ताखे सखाई राखेया, तिजी खे हमेशा याद राख;</para>
  <para style="q" vid="PRO 4:13">इना दे बणेया रा रओ, कऊँकि येई तेरिया जिन्दगिया रा मकसद आ।<verse eid="PRO 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 4:14" />दुष्ट लोका रिया बाटा रे पैर पनि राखणा,</para>
  <para style="q" vid="PRO 4:14">ओर ना ई बुरेया लोका रिया बाटा रे चलणा।<verse eid="PRO 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 4:15" />तिजी खे छाडी दे, तिजी ते दूर ई रणा,</para>
  <para style="q" vid="PRO 4:15">तिजी ते दूर ई रई की आगे निकल़ी जा।<verse eid="PRO 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 4:16" />कऊँकि बुरे लोक जे केसी री बुराई नि करो,</para>
  <para style="q" vid="PRO 4:16">तो तिना खे नींज नि आऊँदी ओर जदुए तक सेयो केसी खे नुकशाण नि पऊँचाओ,</para>
  <para style="q" vid="PRO 4:16">तदुए तक तिना खे चैन नि मिलदा।<verse eid="PRO 4:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 4:17" />बुराई ओर उड़दंग तिना खे खाणे-पीणे जेड़ा ए।<verse eid="PRO 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 4:18" />पर तर्मिया री चाल मानो प्यागा रे प्रयासे जेड़ी ए,</para>
  <para style="q" vid="PRO 4:18">जेतेरी चमक त्याड़िया तक जादा-जादा बढ़दी रओई।<verse eid="PRO 4:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 4:19" />बुरेया लोका री बाट अन्दकूप न्हेरा ए;</para>
  <para style="q" vid="PRO 4:19">सेयो नि जाणदे कि सेयो किजी साथे ठोकर खाओए।<verse eid="PRO 4:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 4:20" />ओ मेरे बच्चेयो, मेरिया गल्ला त्यानो साथे सुण,</para>
  <para style="q" vid="PRO 4:20">ओर आपणा कान मेरिया गल्ला पाँदे लगा।<verse eid="PRO 4:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 4:21" />इना खे आपणी आखी ते दूर नि ऊणे दे,</para>
  <para style="q" vid="PRO 4:21">बल्कि आपणे मनो रे सम्बाल़ी की राख।<verse eid="PRO 4:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 4:22" />कऊँकि जिना खे सेयो मिलोईया, सेयो तिना रे जिऊँदे रणे रा,</para>
  <para style="q" vid="PRO 4:22">ओर तिना रे सारे शरीरो रे ठीक ऊणे री बजा ओईया।<verse eid="PRO 4:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 4:23" />सबी ते जादा आपणे मनो री रक्षा कर,</para>
  <para style="q" vid="PRO 4:23">कऊँकि जिन्दगिया रा मूल़ स्रोत सेईए।<verse eid="PRO 4:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 4:24" />टेडिया गल्ला तेरे मुंए ते नि निकल़ो,</para>
  <para style="q" vid="PRO 4:24">ओर चालबाजिया री गल्ल बोलणी तांते दूर रओ।<verse eid="PRO 4:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 4:25" />तेरिया आखी सामणे रिया तरफा खे ई लगी रिया रओ,</para>
  <para style="q" vid="PRO 4:25">ओर तेरिया आखी रिया पलका आगो खे ई खुलिया रओ।<verse eid="PRO 4:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 4:26" />जो बी तुसे करो, त्यानो साथे सोची की करो,</para>
  <para style="q" vid="PRO 4:26">तो जो बी तुसा करना से सब सफल ऊणा।<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false">इब्रानी 12:13</char></note><verse eid="PRO 4:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 4:27" />ना तो दाँणी तरफा के मुड़ना, ओर ना ई खूँजी तरफा खे;</para>
  <para style="q" vid="PRO 4:27">आपणे पैर बुराईया री बाटा पाँदे चलणे ते टाई लओ।<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s">व्याभिचारो रे खलाफ चतौणी</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 5:1" />ओ मेरे पाऊ, मेरिया अक्ला रिया गल्ला पाँदे त्यान दे,</para>
  <para style="q" vid="PRO 5:1">मेरिया गल्ला समजणे रिया तँईं आपणे कान लगा;<verse eid="PRO 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 5:2" />तेबे ताखे पता लगी जाणा कि ठीक बर्ताओ किंयाँ कित्तेया जाओआ,</para>
  <para style="q" vid="PRO 5:2">ओर तेरे शब्दा ते पता लगी जाणा कि तुँ समजदार ए।<verse eid="PRO 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 5:3" />कऊँकि बगानी जवाणसा रे ओठा ते सईत टपकोआ;</para>
  <para style="q" vid="PRO 5:3">ओर तेसा रिया गल्ला तेलो ते बी जादा चिकणिया ओईया;<verse eid="PRO 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 5:4" />पर तेसा रे प्यारो रा नतीजा नागदौणे जैरो जेड़ा कऊड़ा</para>
  <para style="q" vid="PRO 5:4">ओर दो ताअर वाल़ी तलवारी जेड़ा पैना ओआ।<verse eid="PRO 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 5:5" />तेसा तुसे मरेया रिया दुनिया दे लई जाणे,</para>
  <para style="q" vid="PRO 5:5">से बाट जेथो खे जाओई से मौता री बाट ए।<verse eid="PRO 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 5:6" />तेबेई तो से जिन्दगिया रे बारे दे नि सोचदी,</para>
  <para style="q" vid="PRO 5:6">तेसा रा चाल-चलण ठीक नि ए,</para>
  <para style="q" vid="PRO 5:6">पर तिजी रे बारे से आपू पनि जाणदी।<verse eid="PRO 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 5:7" />इजी री खातर एबे ओ मेरे बच्चेयो, मेरी सुणो,</para>
  <para style="q" vid="PRO 5:7">मेरे मुंए ते निकल़िया रिया गल्ला सुणी की मूँ नि मोड़ो।<verse eid="PRO 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 5:8" />बगानी जवाणसा ते दूर ई रएयो,</para>
  <para style="q" vid="PRO 5:8">ओर तेसा रे कअरो री देऊल़ी पाँदे आपणे कदम पनि राखेयो;<verse eid="PRO 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 5:9" />केथी एड़ा नि ओ कि तूँ आपणी महिमा खोई दे जो तेरा तेरेया लोका बीचे आ,</para>
  <para style="q" vid="PRO 5:9">ओर आपणी जवानिया देई निर्दयी माणूंए रे आथे मरी जाए;<verse eid="PRO 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 5:10" />या एड़ा नि ओ कि बगाने तेरिया कमाईया साथे आपणा पेट परो,</para>
  <para style="q" vid="PRO 5:10">ओर ईंयाँ तेरी मईणती री कमाई परदेशिया रे कअरे चली जाओ;<verse eid="PRO 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 5:11" />ओर तूँ आपणी जिन्दगिया रे आखरी बखतो रे</para>
  <para style="q" vid="PRO 5:11">जेबे तेरे शरीरो री तागत खत्म ऊई जाओ ओर तूँ रोन्दा रई जाए,<verse eid="PRO 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 5:12" />तेबे ता एड़ा बोलणा, “मैं ये सबक कऊँ नि सिखेया?</para>
  <para style="q" vid="PRO 5:12">ओर जिने आऊँ समजाया तेसरी मैं केड़ी बेज्जती कित्ती!<verse eid="PRO 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 5:13" />मैं आपणे गुरूआ री शिक्षा नि सुणी</para>
  <para style="q" vid="PRO 5:13">ओर आपणे सिखाणे वाल़ेया रे उपदेशा पाँदे त्यान नि दित्तेया।<verse eid="PRO 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 5:14" />एबे आऊँ सभा ओर मण्डल़िया बीचे</para>
  <para style="q" vid="PRO 5:14">हमेशा बुराईया रे जाई की पड़ेया।”<verse eid="PRO 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 5:15" />सिर्फ आपणे ई कुएँ रा पाणी पिया करना।</para>
  <para style="q" vid="PRO 5:15">ओर प्यार सिर्फ आपणियां ई लाड़िया साथे करना।<verse eid="PRO 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 5:16" />जो ल्वाद तुसा खे बगानिया जवाणसा ते मिलणी,</para>
  <para style="q" vid="PRO 5:16">तिजी ते तुसा खे नुकशाण ई ऊणा।<verse eid="PRO 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 5:17" />आपणियां लाड़िया साथे ई मिले दे रणा,</para>
  <para style="q" vid="PRO 5:17">बगानिया जवाणसा साथे नि।<verse eid="PRO 5:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 5:18" />तूँ आपणियां जवानिया री लाड़िया साथे तन्य ओ,</para>
  <para style="q" vid="PRO 5:18">जेसा साथे तैं जवानिया दे ब्या करी राखेया,<verse eid="PRO 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 5:19" />से तेरिया तँईं प्यारी ईरणी ओर बांकी सांभरनिया जेड़ी ठईरो,</para>
  <para style="q" vid="PRO 5:19">तेसा रे स्तन हमेशा ताखे संतुष्ट राखो,</para>
  <para style="q" vid="PRO 5:19">ओर तूँ तेसा रे प्यारो दे सदा डूबेया रा रओ।<verse eid="PRO 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 5:20" />ओ मेरे पाऊ, तुँ व्याभिचार करने वाल़ी जवाणसा पाँदे कऊँ मोईत ओ,</para>
  <para style="q" vid="PRO 5:20">ओर बगानी जवाणस तेरिया छातिया साथे कऊँ लगो?<verse eid="PRO 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 5:21" />कऊँकि माणूंआ रे सारे चाल-चलणो पाँदे यहोवे री नजर रओई,</para>
  <para style="q" vid="PRO 5:21">ओर से तिना रिया सारिया बाटा खे देखदा रओआ।<verse eid="PRO 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 5:22" />बुरा माणूं आपणे ई बुरेया कामा रे जाल़ो दे फसणा,</para>
  <para style="q" vid="PRO 5:22">ओर आपणे ई पापो दे फसेया रा रणा।<verse eid="PRO 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 5:23" />से शिक्षा खे ना मानणे रिया बजा ते मरी जाणा,</para>
  <para style="q" vid="PRO 5:23">ओर आपणियां मूर्खता रिया बजा ते ओरे-पोरे पटकदा रणा।<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s">ओर चतौणिया</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 6:1" />ओ मेरे बच्चेयो, क्या तुसे आपणे पड़ोसिये ओर परदेशिये रे कर्जे रिया तँईं</para>
  <para style="q" vid="PRO 6:1">जमानत देणे रा वादा तो नि करी राखेया,<verse eid="PRO 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 6:2" />तो तूँ आपणे मुंए रे वचनो तेई फसी जाणा,</para>
  <para style="q" vid="PRO 6:2">ओर आपणे मुंए रिया गल्ला ते पकड़ेया जाणा।<verse eid="PRO 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 6:3" />इजी री खातर ओ मेरे बच्चेयो, आपू खे बचाणे रिया तँईं एक काम करो,</para>
  <para style="q" vid="PRO 6:3">तुसे आपणे पड़ोसिये रे आथो दे पड़ी चुके रे, तो जाओ,</para>
  <para style="q" vid="PRO 6:3">ओर तेसरे पैरा पाँदे पड़ी की तेसखे मनाई लओ।<verse eid="PRO 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 6:4" />तुसे ना तो आपणियां आखी रे नींज आऊणे देओ,</para>
  <para style="q" vid="PRO 6:4">ओर ना आपणियां पलका मीछणे देओ;<verse eid="PRO 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 6:5" />जिंयाँ ईरणी शकारिये रे आथो ते</para>
  <para style="q" vid="PRO 6:5">ओर चिड़िया चिड़िमारो रे जाल़ो ते आपू खे छुड़ाई लओई</para>
  <para style="q" vid="PRO 6:5">तिंयाँ ई तुसे बी आपणे पड़ोसिये ते आपू खे बचाई लओ।<verse eid="PRO 6:5" /></para>
  <para style="s">आल़सी ऊणे ते बचणा</para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 6:6" />ओ आल़सी, मकोड़िया गे जा;</para>
  <para style="q" vid="PRO 6:6">तिना रे कामो पाँदे त्यान देई की बचार कर,</para>
  <para style="q" vid="PRO 6:6">तेबे तूँ अक्लमंद बणी जाणा।<verse eid="PRO 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 6:7" />तिना रा ना तो कोई न्याय करने वाल़ा ओआ,</para>
  <para style="q" vid="PRO 6:7">ना परदान ओर ना तिना पाँदे कोई राज करने वाल़ा ओआ,<verse eid="PRO 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 6:8" />तेबे बी सेयो आपणे खाणे रिया चीजा तूपा पाँदे,</para>
  <para style="q" vid="PRO 6:8">ओर फसल बाडणे रे बखते कट्ठिया करोईया।<verse eid="PRO 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 6:9" />ओ आल़सी, तूँ कदुए तक सऊँदे रणा?</para>
  <para style="q" vid="PRO 6:9">तूँ आपणियां नींजा ते कदी जागणा?<verse eid="PRO 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 6:10" />थोड़ा जा ओर सुती लओ, थोड़ा जा नींजा रा एक ओर टमका लई लओ,</para>
  <para style="q" vid="PRO 6:10">ओर छातिया पाँदे आथ राखी की लेटेया रा रया,<verse eid="PRO 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 6:11" />तेबे तेरी गरीबी बाटा रे लुटेरेया जेड़ी</para>
  <para style="q" vid="PRO 6:11">ओर तेरी कमी अथियारबन्दो जेड़ी आऊणी।<verse eid="PRO 6:11" /></para>
  <para style="s">दुष्ट माणूं</para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 6:12" />ओछेया खे ओर बुरे काम करने वाल़े माणूंए खे देखो,</para>
  <para style="q" vid="PRO 6:12">से आपणे मुंए ते उल्टिया-उल्टिया गल्ला बकदा फिरोआ,<verse eid="PRO 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 6:13" />से आपणियां आखी ते ओर पैर ईलाई की</para>
  <para style="q" vid="PRO 6:13">ओर आपणा आथ ईलाई की साअरा करोआ, से चाओआ कि माणूं चूठो पाँदे परोसा करो।<verse eid="PRO 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 6:14" />से आपणे मनो रे उल्ट फेरो रिया गल्ला बणांदा रओआ,</para>
  <para style="q" vid="PRO 6:14">से लगातार बुरा सोचोआ ओर लड़ाई-चगड़ा पैदा करोआ।<verse eid="PRO 6:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 6:15" />इजी बजा ते तेस पाँदे मुसीबत अचाणक आऊणी,</para>
  <para style="q" vid="PRO 6:15">से पला बीचे ई एड़ा नाश ऊई जाणा कि तेसरे बचणे री कोई उम्मीद नि रणी।<verse eid="PRO 6:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 6:16" />छे चीजा ते यहोवा बैर राखोआ,</para>
  <para style="q" vid="PRO 6:16">बल्कि सात ए जिना ते से कृणा करोआ;<verse eid="PRO 6:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 6:17" />कमण्डो ते चढ़ी रिया आखी, चूठ बोलणे वाल़ी जीब,</para>
  <para style="q" vid="PRO 6:17">ओर जो माणूं निर्दोषो खे काई देओए।<verse eid="PRO 6:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 6:18" />जो माणूं बुरे काम करने रे बारे दे सोचोए,</para>
  <para style="q" vid="PRO 6:18">सेओ माणूं जो बुरा करने खे तेज दौड़ने वाल़े ए,<verse eid="PRO 6:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 6:19" />चूठ बोलणे वाल़ा गवाह् ओर पाईया बीचे चगड़ा पैदा करने वाल़ा माणूं।<verse eid="PRO 6:19" /></para>
  <para style="s">व्यभिचारो रे खलाफ चतौणी</para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 6:20" />ओ मेरे बच्चेयो, आपणे बाओ रिया आज्ञा खे मानी लओ,</para>
  <para style="q" vid="PRO 6:20">ओर आपणियां माया री दित्ती रिया शिक्षा खे नि छाडेयो।<verse eid="PRO 6:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 6:21" />तूँ इना गल्ला खे आपणियां गाठी दे बानी की दिलो दे राख;</para>
  <para style="q" vid="PRO 6:21">ओर इना गल्ला खे आपणे गल़े रे आरो जेड़िया बणाई लओ।<verse eid="PRO 6:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 6:22" />इना गल्ला तेरे चलणे रे तेरी अगुवाई करनी,</para>
  <para style="q" vid="PRO 6:22">ओर सऊँदे बखते तेरी रक्षा</para>
  <para style="q" vid="PRO 6:22">ओर जागदे बखते तां साथे ज्ञानो रिया गल्ला करनिया।<verse eid="PRO 6:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 6:23" />कऊँकि परमेशरो री आज्ञा तो बाटा रे दिऊए जेड़िया ए,</para>
  <para style="q" vid="PRO 6:23">ओर माया री शिक्षा जिन्दगिया री जोतिया जेड़ी ए,</para>
  <para style="q" vid="PRO 6:23">ओर सखाणे वाल़े रा बकणा जिन्दगिया री बाट ए।<verse eid="PRO 6:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 6:24" />इना तूँ बुरिया जवाणसा ते,</para>
  <para style="q" vid="PRO 6:24">ओर बगानी जवाणसा रिया चिकणी चुपड़िया गल्ला ते बचाणा।<verse eid="PRO 6:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 6:25" />तेसा रा बांकापण देखी की आपणे मनो रे तेसा खे पाणे री इच्छा नि कर,</para>
  <para style="q" vid="PRO 6:25">से ताखे आपणी तिरछी नजरा ते फसाई नि सको;<verse eid="PRO 6:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 6:26" />कऊँकि जो माणूं वेश्या रे चकरो दे फसोआ से रोटिया रे टुकड़ेया खे बी तरसोआ,</para>
  <para style="q" vid="PRO 6:26">पर गंदे काम करने वाल़ी जवाणस तेस मर्दो</para>
  <para style="q" vid="PRO 6:26">ओर तेसरिया लाड़िया री किमती जिन्दगी बी नाश करी देओई।<verse eid="PRO 6:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 6:27" />क्या ऊई सकोआ कि कोई आपणी छातिया पाँदे आग राखी लओ;</para>
  <para style="q" vid="PRO 6:27">ओर तेसरे टाल्ले नि फूखो?<verse eid="PRO 6:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 6:28" />क्या ऊई सकोआ कि कोई बल़दे फेऊआ पाँदे चलो,</para>
  <para style="q" vid="PRO 6:28">ओर तेसरे पैर नि फूखो?<verse eid="PRO 6:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 6:29" />जो कोई मर्द बगानी जवाणसा गे जाओआ, तेसरी दशा बी एड़ी ऊणी;</para>
  <para style="q" vid="PRO 6:29">बल्कि जो कोई तेसा खे छूँओगा, तेसखे जरूर सजा मिलणी।<verse eid="PRO 6:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 6:30" />जेबे चोर पूखा रे मारे आपणा पेट परने खे चोरी करो,</para>
  <para style="q" vid="PRO 6:30">तेबे तेसखे तो लोक नबाग नि जाणदे;<verse eid="PRO 6:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 6:31" />तेबे बी जे से पकड़ेया जाओ, तो तेसखे सातगुणा देणा पड़ना;</para>
  <para style="q" vid="PRO 6:31">बल्कि आपणे कअरो री सारी सम्पत्ति देणी पड़नी।<verse eid="PRO 6:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 6:32" />पर जो बगानी जवाणसा साथे गल़त काम करोआ, से बिल्कुल मूर्ख आ;</para>
  <para style="q" vid="PRO 6:32">एड़ा माणूं आपणा नाश करोआ।<verse eid="PRO 6:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 6:33" />तेसखे काईल ओर बेज्जत ऊणा पड़ना,</para>
  <para style="q" vid="PRO 6:33">ओर तेसरी बदनामी कदी नि मिटणी।<verse eid="PRO 6:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 6:34" />कऊँकि जल़ना रे मारे मर्द बऊत ई गुस्से ऊई जाओआ,</para>
  <para style="q" vid="PRO 6:34">ओर जेबे तेस बदला लणा तेबे तेस कोई दया नि दखाणी।<verse eid="PRO 6:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 6:35" />तेस रिश्वता कनारो खे देखणा पनि,</para>
  <para style="q" vid="PRO 6:35">ओर चाए तूँ तेसखे बऊत कुछ दे, तेबे बी से नि मानणा।<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s">वेश्या रा चाल-चलण</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 7:1" />ओ मेरे बच्चेयो, मेरिया गल्ला खे मानेया करो,</para>
  <para style="q" vid="PRO 7:1">ओर मेरिया आज्ञा आपणे मनो दे राखणिया।<verse eid="PRO 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 7:2" />जे तुसे मेरिया आज्ञा खे मानेया करोगे तो तुसे जिऊँदे रणे,</para>
  <para style="q" vid="PRO 7:2">ओर आपणियां आखी रिया पूतल़िया जेड़िया मेरिया शिक्षा खे किमती जाणेयो;<verse eid="PRO 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 7:3" />तिना खे छापा जेड़िया आपणियां गूठिया रे पईनी लओ;</para>
  <para style="q" vid="PRO 7:3">ओर तिना खे आपणे दिलो री पट्टिया पाँदे लिखी लओ।<verse eid="PRO 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 7:4" />ओर बुद्धिया खे ये बोल, “तूँ मेरी बईण ए,”</para>
  <para style="q" vid="PRO 7:4">ओर समजा खे आपणे टब्बरो री समजी की बुलाई लओ;<verse eid="PRO 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 7:5" />तेबे तूँ बगानी जवाणसा ते बचणा,</para>
  <para style="q" vid="PRO 7:5">जो चिकणी चुपड़ी गल्ला करी की फसाओईया।<verse eid="PRO 7:5" /></para>
  <para style="s">एक उदारण</para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 7:6" />मैं एक दिन आपणे कअरो री दवारिया ते,</para>
  <para style="q" vid="PRO 7:6">मतलब आपणे चरोखे ते चाँकी कि बारे देखेया,<verse eid="PRO 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 7:7" />तेबे मैं सीदे-सादे लोका री पीड़ा बीचे</para>
  <para style="q" vid="PRO 7:7">एक नासमज जवान देखेया;<verse eid="PRO 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 7:8" />से तेसा सड़का रिये गया जो तेसा जवाणसा रे कअरो रे नेड़े रिये जाओ थी,</para>
  <para style="q" vid="PRO 7:8">ओर से तेसा रे कअरो रिया बाटा रिये गया।<verse eid="PRO 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 7:9" />तेस बखते त्याड़ा छपी गा था ओर साँज ऊई गी थी,</para>
  <para style="q" vid="PRO 7:9">बल्कि राती रा अन्दकूप न्हेरा ऊईगा रा था।<verse eid="PRO 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 7:10" />ओर मैं देखेया कि तेसखे बाटा रे एक जवाणस मिली,</para>
  <para style="q" vid="PRO 7:10">जेसा रा पेष वेश्या जेड़ा था ओर से बऊत चलाक थी।<verse eid="PRO 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 7:11" />से जोरे कि गल्ला करने वाल़ी जवाणस थी, जो बरोद करो थी,</para>
  <para style="q" vid="PRO 7:11">ओर से आपणे कअरे नि टीको थी;<verse eid="PRO 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 7:12" />कदी से सड़का रे, कदी चौको रे मिलो थी</para>
  <para style="q" vid="PRO 7:12">ओर से हर मोड़ो पाँदे आपणे शकारो री ताका रे बैठी री रओ थी।<verse eid="PRO 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 7:13" />तेबे तेसे से जवान पकड़ी की चूम्मेया,</para>
  <para style="q" vid="PRO 7:13">ओर बेशर्म ऊई की तेस जवानो खे बोलेया,<verse eid="PRO 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 7:14" />“मैं आज ई मेलबलि चढ़ाई राखी,</para>
  <para style="q" vid="PRO 7:14">ओर आपणियां मान्नता आज ई पुरिया करी राखिया;<verse eid="PRO 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 7:15" />इजी बजा ते आऊँ तां साथे मिलणे खे निकल़ी,</para>
  <para style="q" vid="PRO 7:15">आऊँ ताखे टोल़ू थी ओर तूँ माखे एबु मिली रा।<verse eid="PRO 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 7:16" />मैं आपणे बछौणे सजाई राखे,</para>
  <para style="q" vid="PRO 7:16">तिजी पाँदे मिस्र देशो रे बेलबूटे री कढ़ाईया कित्ती री रेशमो री चादर बछयाई राखी;<verse eid="PRO 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 7:17" />मैं आपणे बछौणे पाँदे गन्धरस,</para>
  <para style="q" vid="PRO 7:17">अगर ओर दाल़चीनी खुशबुदार चीजा छिड़की राखिया।<verse eid="PRO 7:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 7:18" />इजी री खातर एबे चल आसे प्यारो साथे प्यागा तक जिऊ बह्यीलाऊँए,</para>
  <para style="q" vid="PRO 7:18">आसे आपू बीचले प्यारो ते एकी-दूजे खे खुश करिए।<verse eid="PRO 7:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 7:19" />कऊँकि मेरा लाड़ा कअरे नि ए,</para>
  <para style="q" vid="PRO 7:19">से दूर देशो रे बऊत दिना री यात्रा रे जाई रा।<verse eid="PRO 7:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 7:20" />से आपू साथे बऊत पैसे लईगा रा ए;</para>
  <para style="q" vid="PRO 7:20">ओर से दूई अफ़्तेया तक वापस नि आऊणा।”<verse eid="PRO 7:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 7:21" />एड़िया ई गल्ला बोली-बोली की तेसे जवाणसे से मर्द फसाईता रा;</para>
  <para style="q" vid="PRO 7:21">ओर आपणियां मीठिया-मीठिया गल्ला करी की से आपणे वशो रे करिता रा।<verse eid="PRO 7:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 7:22" />से फटाफट तेसा पीछे चली पड़ेया,</para>
  <para style="q" vid="PRO 7:22">जिंयाँ बल़द कसाई-खाने दे या बेड़िया पईने रे कोई मूर्ख मार खाणे खे जाओआ।<verse eid="PRO 7:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 7:23" />अन्तो रे तेस जवानो रा काल़जा तीरो साथे ऊजेया जाणा,</para>
  <para style="q" vid="PRO 7:23">से तेसा चिड़िया जेड़ा ए जो फन्दे रिया तरफा खे तेज उडोई</para>
  <para style="q" vid="PRO 7:23">ओर जाणदी नि कि तिदे मेरे प्राण चली जाणे।<verse eid="PRO 7:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 7:24" />एबे ओ मेरे बच्चेयो, सुणो,</para>
  <para style="q" vid="PRO 7:24">ओर मेरिया गल्ला पाँदे त्यान देओ।<verse eid="PRO 7:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 7:25" />तेरा मन एड़िया जवाणसा रिया गल्ला कनारो खे नि फिरो,</para>
  <para style="q" vid="PRO 7:25">ओर तेसा रिया बाटा रे पूली की पनि जाणा;<verse eid="PRO 7:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 7:26" />कऊँकि तेसे जवाणसे बऊत लोक काईते रे,</para>
  <para style="q" vid="PRO 7:26">तेसा रे जरिये काये रे लोका री गिणती बऊत जादा ए।<verse eid="PRO 7:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 7:27" />जे तुसे एड़िया जवाणसा रे कअरे जाओए, तो तुसे मरेया रेया री दुनिया रिया बाटा दे जाओए।</para>
  <para style="q" vid="PRO 7:27">ये बऊत ई जल्दी मौता रिया तरफा खे जाणे वाल़ी बाट ए।<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s">बुद्धिया री तारीफ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 8:1" />सुण, बुद्धि ताखे आका पाणे लगी री,</para>
  <para style="q" vid="PRO 8:1">समज जोरे-जोरे की ताखे बुलाणे लगी री।<verse eid="PRO 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 8:2" />बुद्धि तो बाटा रे चबाटे बीचे ऊच्चिया जगा रे खड़ी ओई;<verse eid="PRO 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 8:3" />शईरो रे प्रवेश द्वारो रे नेड़े,</para>
  <para style="q" vid="PRO 8:3">ओर दरवाजे पाँदे खड़े ऊई की से जोरे की बोलोई,<verse eid="PRO 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 8:4" />“ओ माणूंओ, आऊँ तुसा खे आका पाऊँई,</para>
  <para style="q" vid="PRO 8:4">ओर मेरिया गल्ला सबी माणूंआ खेई आ।”<verse eid="PRO 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 8:5" />जे तुसे पोल़े ए तो उशयार ऊणा सीखो;</para>
  <para style="q" vid="PRO 8:5">ओर जे तुसे नासमज ए, तो समजदार ऊणा सीखो,<verse eid="PRO 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 8:6" />मेरी गल्ल सुणो, कऊँकि मां तुसा ते खरिया गल्ला बोलणिया,</para>
  <para style="q" vid="PRO 8:6">ओर मेरे मुंए ते सीदिया ई गल्ला निकल़निया;<verse eid="PRO 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 8:7" />कऊँकि आऊँ जो बोलूँई से सच्च ए;</para>
  <para style="q" vid="PRO 8:7">चूठो रिया गल्ला ते आऊँ कृणा करूँई।<verse eid="PRO 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 8:8" />आऊँ जो कुछ बी बोलूँई से सच्च ए;</para>
  <para style="q" vid="PRO 8:8">तिना बीचा ते कुछ बी गल़त या पटकाणे वाल़ी गल्ल नि ए।<verse eid="PRO 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 8:9" />समजदार माणूंए खे सेयो सब सान,</para>
  <para style="q" vid="PRO 8:9">ओर ज्ञान पाणे वाल़ेया रिया तँईं बऊत सीदिया ए।<verse eid="PRO 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 8:10" />चाँदिए रे बदले मेरिया शिक्षा खेई ग्रईण करी लओ,</para>
  <para style="q" vid="PRO 8:10">ओर खरे सूईने रे बदले मेरे ज्ञानो खे ग्रईण करो।<verse eid="PRO 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 8:11" />कऊँकि आऊँ बुद्धि, किमती रत्ना ते बी अच्छी ए;</para>
  <para style="q" vid="PRO 8:11">ओर तुसा रे मनो खे अच्छी लगणे वाल़िया सारिया चीजा बीचा ते कोई बी मेरे जेड़ी नि ए।<verse eid="PRO 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 8:12" />आऊँ जो बुद्धि ए, मांदे बऊत जादा समज ए,</para>
  <para style="q" vid="PRO 8:12">ओर मांगे ज्ञान ओर विवेक बी ए।<verse eid="PRO 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 8:13" />बुराईया ते कृणा करनी ई यहोवे री पग्ति करने रे बराबर ए;</para>
  <para style="q" vid="PRO 8:13">कमण्ड, गर्व ओर बुरी चाला ते ओर उल्ट फेरो रिया गल्ला ते बी आऊँ बैर राखूँई।<verse eid="PRO 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 8:14" />आऊँ ई सलाह ओर आऊँ ई खरी बुद्धि ए,</para>
  <para style="q" vid="PRO 8:14">आऊँ तो समज ए ओर तागत बी मेरी ईए।<verse eid="PRO 8:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 8:15" />मां बुद्धिया रे जरिए ई राजे लोक राज करोए,</para>
  <para style="q" vid="PRO 8:15">ओर मेरिया मतादा तेई अधिकारी न्याय साथे फैंसला करोए;<note caller="+" style="f"><char style="fr" closed="false">8:15 </char><char style="ft" closed="false">रोमी 13:1</char></note><verse eid="PRO 8:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 8:16" />मेरे ई जरिए शासक, परदान,</para>
  <para style="q" vid="PRO 8:16">ओर तरतिया रे सब न्यायी ईमानदारिया ते राज करोए।<verse eid="PRO 8:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 8:17" />जो मांते प्यार राखोए, आऊँ बी तिना साथे प्यार राखूँई,</para>
  <para style="q" vid="PRO 8:17">ओर जो माखे मईणता साथे तड़के उठी की टोल़ोए, सेयो माखे पाओए।<verse eid="PRO 8:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 8:18" />मांगे देणे खे पैसा ओर मान-मर्यादा ए,</para>
  <para style="q" vid="PRO 8:18">ओर सदा रणे वाल़ा पैसा ओर तार्मिकता बी ए।<verse eid="PRO 8:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 8:19" />जो तुसा खे मांते मिलणा से शुद्ध सूईने ते बी खरा ए,</para>
  <para style="q" vid="PRO 8:19">ओर खरे चाँदिए ते बी अच्छा ए।<verse eid="PRO 8:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 8:20" />आऊँ तार्मिकता रिया बाटा दे,</para>
  <para style="q" vid="PRO 8:20">ओर न्याय रिया बाटा दे चलूँई,<verse eid="PRO 8:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 8:21" />जेते कि आऊँ आपणे प्यार करने वाल़ेया खे तअन-दौलता रा इस्सेदार बणाऊँ,</para>
  <para style="q" vid="PRO 8:21">ओर तिना रे पण्डारा खे परी देऊँ।<verse eid="PRO 8:21" /></para>
  <para style="s">बुद्धिया रा सृष्टि बनाणे दे आसरा</para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 8:22" />यहोवे आऊँ आपणे सारे सृष्टिया रे काम करने री शुरूआता देई,</para>
  <para style="q" vid="PRO 8:22">बल्कि पुराणे बखतो रे कामा ते बी पईले ई पैदा कित्ती।<verse eid="PRO 8:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 8:23" />आऊँ सदा ते बल्कि शुरूए तेई तरतिया री रचना ते पईले ई ठराई राखी।<verse eid="PRO 8:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 8:24" />जेबे ना तो डूगा समुद्र बणी रा था,</para>
  <para style="q" vid="PRO 8:24">ओर ना पाणिए रिया सूबल़ा निकल़ी रिया थिया, तदुए तेई आऊँ पैदा ऊई।<verse eid="PRO 8:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 8:25" />जेबे पाह्ड़ ओर पाह्ड़िया रा नाओं-नशाण नि था,</para>
  <para style="q" vid="PRO 8:25">तदुए तेई आऊँ पैदा ऊई गी थी।<note caller="+" style="f"><char style="fr" closed="false">8:25 </char><char style="ft" closed="false">यूह. 1:1,2, यूह. 17:24, कुलु. 1:17</char></note><verse eid="PRO 8:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 8:26" />जेबे यहोवे ना तो तरती</para>
  <para style="q" vid="PRO 8:26">ओर ना मैदान, ना दुनिया री तूड़ा रे कण बणाई राखे थे,</para>
  <para style="q" vid="PRO 8:26">इना ते पईले आऊँ पैदा ऊई गी थी।<verse eid="PRO 8:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 8:27" />जेबे परमेशरे सर्ग बणाया, तेबे आऊँ तेती थी,</para>
  <para style="q" vid="PRO 8:27">जेबे तिने डूगे पाणिए पाँदे सर्ग बणाया, तेबे बी आऊँ तेती थी।<verse eid="PRO 8:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 8:28" />जेबे तिने सर्ग पाँदे ठराया,</para>
  <para style="q" vid="PRO 8:28">ओर डूगे पाणिए रिया सूबल़ा निकल़ने लगिया,<verse eid="PRO 8:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 8:29" />जेबे तिने समुद्रो खे एक बन्ना ठराया,</para>
  <para style="q" vid="PRO 8:29">ताकि पाणी तेसरिया आज्ञा रा उल्लंघन करी की तेस बन्ने खे पार नि करी सको,</para>
  <para style="q" vid="PRO 8:29">ओर जेबे से तरतिया री निऊँआ रे डोरी लगाओ था,<verse eid="PRO 8:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 8:30" />तेबे आऊँ एक परदान कारीगरो जेड़ी तेसरे नेड़े ई थी;</para>
  <para style="q" vid="PRO 8:30">ओर हर रोज आऊँ तेसखे खुश करेया करुँ थी,</para>
  <para style="q" vid="PRO 8:30">ओर हर बखत तेस सामणे खुश रऊँ थी।<verse eid="PRO 8:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 8:31" />आऊँ तेसरे जरिए बणाई री तरतिया ते खुश थी</para>
  <para style="q" vid="PRO 8:31">ओर मेरा सुख माणूंआ रिया संगतिया ते ओ था।<verse eid="PRO 8:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 8:32" />इजी री खातर एबे ओ मेरे पाऊए, मेरी सुणी लओ;</para>
  <para style="q" vid="PRO 8:32">जिंयाँ आऊँ बोलूँई तिंयाँ ई करो, ओर तुसे खुश रणे।<verse eid="PRO 8:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 8:33" />शिक्षा रिया गल्ला सुणो ओर अक्लमंद ऊई जाओ,</para>
  <para style="q" vid="PRO 8:33">तिजी खे अणसुणी नि करो।<verse eid="PRO 8:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 8:34" />मेरिया गल्ला खे सुणने वाल़ा माणूं बऊत ई भाग्यशाली ए,</para>
  <para style="q" vid="PRO 8:34">बल्कि से मेरिया देऊल़ी पाँदे हर रोज आस लगाई की खड़ेया रा रओआ,</para>
  <para style="q" vid="PRO 8:34">से मेरे इन्तजारो दे दरवाजे गे नजर लगाई की राखोआ।<verse eid="PRO 8:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 8:35" />कऊँकि जो माखे पाई लओआ, से जिन्दगिया खे पाओआ;</para>
  <para style="q" vid="PRO 8:35">ओर यहोवे री दया तेस पाँदे सदा बणी री रओई।<verse eid="PRO 8:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PRO 8:36" />पर जो माखे पाणे रे चूकी जाओआ, से आपू पाँदे आपू ई मुसीबत ल्याओआ;</para>
  <para style="q" vid="PRO 8:36">जितणे मांते कृणा करोए, सेयो मौता साथे प्यार राखोए।<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s">ज्ञानो री बाट</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 9:1" />बुद्धिए सातो खम्बे खड़े करी की</para>
  <para style="q" vid="PRO 9:1">आपणा कअर बणाया।<verse eid="PRO 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 9:2" />तेसे आपणे खाणे खे आपणे डांगर फाटे,</para>
  <para style="q" vid="PRO 9:2">ओर आपणे अंगूरा रे रसो दे मसाला मलाया</para>
  <para style="q" vid="PRO 9:2">ओर आपणी खाणे री मेज लगाई।<verse eid="PRO 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 9:3" />तेसे आपणियां दासिया सबी खे बुलाणे खे पेजिया,</para>
  <para style="q" vid="PRO 9:3">सेयो शईरो री ऊच्चिया जगा रे चूँडिया पाँदे जाईकी आका पाओईया,<verse eid="PRO 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 9:4" />“जो कोई सीदा-सादा ए, से मुड़ी की मेरे कअरो रे पीतरे आओ!”</para>
  <para style="q" vid="PRO 9:4">जो मूर्ख ए, तेसखे से बोलोई,<verse eid="PRO 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 9:5" />“आओ ओर मेरी रोटी खाओ,</para>
  <para style="q" vid="PRO 9:5">ओर मसाला मिलेया रा अंगूरा रा रस पियो।<verse eid="PRO 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 9:6" />बुरेया लोका री संगत छाडो, ओर जिऊँदे रओ,</para>
  <para style="q" vid="PRO 9:6">ज्ञानो रिया बाटा दे चलो।”<verse eid="PRO 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 9:7" />जो माणूं मजाक करने वाल़ेया खे शिक्षा देओआ, से बेज्जत ओआ,</para>
  <para style="q" vid="PRO 9:7">ओर जो दुष्टो खे बकोआ, से कलंकित ओआ।<verse eid="PRO 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 9:8" />मजाक ड्वाणे वाल़े खे नि बक, एड़ा नि ओ कि से तां साथे बैर राखो,</para>
  <para style="q" vid="PRO 9:8">बल्कि अक्लमंदो खे तेसरी पूला रिया तँईं बक, तेस तां साथे प्यार राखणा।<verse eid="PRO 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 9:9" />अक्लमंदो खे शिक्षा दे, तो से ओर बी जादा अक्लमंद ऊई जाणा;</para>
  <para style="q" vid="PRO 9:9">तार्मिक माणूंए खे चतौणी दे, तो तेस आपणी बिद्या बढ़ाणी।<verse eid="PRO 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 9:10" />यहोवे रा आदर करना बुद्धिया री शुरूआत ए,</para>
  <para style="q" vid="PRO 9:10">ओर परम पवित्र परमेशरो खे जाणना ई समज ए।<verse eid="PRO 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 9:11" />मां बुद्धिया रे जरिए ई तेरी उम्र बढ़नी,</para>
  <para style="q" vid="PRO 9:11">ओर तूँ बऊत साला तक जिऊँदा रणा।<verse eid="PRO 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 9:12" />जे तुसे समजा खे अपनाओंगे तो तुसा खे ई फाईदा ऊणा,</para>
  <para style="q" vid="PRO 9:12">ओर जे तुसे तिजी खे नि अपनाओंगे तो तुसा खे ई कष्ट ऊणा।<verse eid="PRO 9:12" /></para>
  <para style="s">मूर्खता री बाट</para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 9:13" />मूर्ख जवाणस तेसा जवाणस जेड़ी ए; जो बक-बक करोई;</para>
  <para style="q" vid="PRO 9:13">से तो निर्बुद्धि ए ओर कुछ नि जाणदी।<verse eid="PRO 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 9:14" />से आपणे कअरो रे द्वारो पाँदे,</para>
  <para style="q" vid="PRO 9:14">ओर शईरो री ऊच्चिया जगा दे आसण लगाई की बैठी री।<verse eid="PRO 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 9:15" />से तिना लोका खे जो आपणियां-आपणियां बाटा रे सीदे जाओए,</para>
  <para style="q" vid="PRO 9:15">तिना खे से ये बोली-बोली की आका पाओई,<verse eid="PRO 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 9:16" />“जो कोई सीदा-सादा ओ, से मुड़ी की मेरे कअरो रे पीतरे आओ;”</para>
  <para style="q" vid="PRO 9:16">जो नासमज ए, तेसखे मूर्खता ये बोलोई,<verse eid="PRO 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 9:17" />“चोरिया रा पाणी मीठा ओआ</para>
  <para style="q" vid="PRO 9:17">ओर लूकी-छिपी की रोटी खाणी अच्छी लगोई।”<verse eid="PRO 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 9:18" />तेसा रेया दुखिया खे पता नि ए कि लोक मरी जाओए जो तेसा जवाणसा रे कअरे जाओए,</para>
  <para style="q" vid="PRO 9:18">कि जो लोक पईले तेती जाई चूकी रे, सेओ एबे मरेया रेया दुनिया दे डुबी गे रे।<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s">सुलेमानो रिया ज्ञानो रिया गल्ला</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 10:1" />बच्चेया रा अक्लमंद ऊणे ते तिना रे बाओ खे खुशी मिलोई,</para>
  <para style="q" vid="PRO 10:1">पर मूर्ख बच्चेया रिया बजा ते तिना रिया माया खे दु:ख ओआ।<verse eid="PRO 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 10:2" />बेईमानिया ते कट्ठा कित्ते रे तअनो ते केसी खे कोई फायदा नि ऊँदा,</para>
  <para style="q" vid="PRO 10:2">पर ईमानदारी माणूंए खे मौता ते बचाई सकोई।<verse eid="PRO 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 10:3" />तार्मिक माणूंए खे यहोवा पूखा नि मरने देंदा,</para>
  <para style="q" vid="PRO 10:3">पर दुष्ट लोका री इच्छा से पूरी नि ऊणे देंदा।<verse eid="PRO 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 10:4" />जो काम करने ते आल़स करोआ, से गरीब ऊई जाओआ,</para>
  <para style="q" vid="PRO 10:4">पर बऊत जादा मईणती रा काम करने ते गरीब माणूं बी अमीर ऊई जाओए।<verse eid="PRO 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 10:5" />जो पाऊ बाडणे रे बखते फसल कट्ठी करोआ, से बुद्धिया साथे काम करने वाल़ा ए,</para>
  <para style="q" vid="PRO 10:5">पर जो पाऊ फसल बाडणे रे बखते बड़ी पारी नींजा रे पड़ी रओआ, से शरमा री बजा ओई।<verse eid="PRO 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 10:6" />तर्मिया माणूंआ खे बऊत आशीर्वाद मिलोए,</para>
  <para style="q" vid="PRO 10:6">पर बुरेया लोका रे शब्द तिना रे उड़दंगो वाल़े सबाओ खे टकी देओए।<verse eid="PRO 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 10:7" />जेबे एक तर्मी माणूं मरी जाओआ, तेबे खरे लोक तेसखे याद करोए ओर खुश ओए,</para>
  <para style="q" vid="PRO 10:7">पर जेबे बुरा माणूं मरोआ तेबे लोक तेसखे छोड़ ई पूली जाओए।<verse eid="PRO 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 10:8" />जो अक्लमंद ए, से सबी आज्ञा खे मानोआ,</para>
  <para style="q" vid="PRO 10:8">पर जो बक-बक करोआ ओर मूर्ख ए, से आपणा ई नाश करी देओआ।<verse eid="PRO 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 10:9" />ईमानदार लोक तो सई-सलामत रणे,</para>
  <para style="q" vid="PRO 10:9">पर बेईमान लोक पकड़े जाणे।<note caller="+" style="f"><char style="fr" closed="false">10:9 </char><char style="ft" closed="false">प्रेरित 13:10</char></note><verse eid="PRO 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 10:10" />जो माणूं सच्च बोलणे खे मूँ नि खोलदा से ओरी खे बी परेशानिया दे पाई देओआ;</para>
  <para style="q" vid="PRO 10:10">पर जो मूर्ख माणूं बक-बक करोआ, से आपू खे बर्बाद करोआ।<verse eid="PRO 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 10:11" />एक खरे माणूंए रे मुंए ते जिन्दगिया रिया गल्ला निकल़ोईया,</para>
  <para style="q" vid="PRO 10:11">पर दुष्टो रे मुंए रिया गल्ला तेसरे उड़दंगो रे सबाओ खे टकी देओईया।<verse eid="PRO 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 10:12" />बैर राखणे ते तो चगड़े ई पैदा ओए,</para>
  <para style="q" vid="PRO 10:12">पर प्यारो साथे गल्ला करने ते सारे पाप टखी जाओए।<note caller="+" style="f"><char style="fr" closed="false">10:12 </char><char style="ft" closed="false">1 कुरिन्थ 13:7, याकूब 5:20, 1 पत 4:8</char></note><verse eid="PRO 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 10:13" />समजदारा रिया गल्ला रे बुद्धि ओई,</para>
  <para style="q" vid="PRO 10:13">पर उल्टिया-उल्टिया गल्ला करने वाल़े माणूंए खे सजा देणे री जरूरत ए।<verse eid="PRO 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 10:14" />अक्लमंद लोक जितणा ऊई सको तिथणा सीखदे रओए,</para>
  <para style="q" vid="PRO 10:14">पर जेबे मूर्ख बोलोआ तेबे परेशानी ऊई जाओई।<verse eid="PRO 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 10:15" />जिंयाँ एक शईर तीजिरिया दवाला ते पक्का ओआ, तिंयाँ ई अमीर माणूंए रा पैसा तेसरी रक्षा करोआ,</para>
  <para style="q" vid="PRO 10:15">पर गरीबिया रिया बजा ते गरीब माणूं नाश ऊई जाओए।<verse eid="PRO 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 10:16" />तर्मी मईणत करी की जिन्दगिया खे कमाओआ,</para>
  <para style="q" vid="PRO 10:16">पर बुरेया लोका रे फायदे ते पाप ई बढ़ोआ।<verse eid="PRO 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 10:17" />शिक्षा पाँदे चलणा ई जिन्दगी ए,</para>
  <para style="q" vid="PRO 10:17">पर जो माणूं चिड़कणे ते मूँ मोड़ोआ, से पटकदा ई जाओआ।<verse eid="PRO 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 10:18" />चूठ बोलणे वाल़े माणूंए रे मनो दे बैर रओआ,</para>
  <para style="q" vid="PRO 10:18">ओर जो चूठिया गल्ला फैलाओआ, से मूर्खता रा काम करोआ।<verse eid="PRO 10:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 10:19" />बऊत गल्ला ऊणे रिया बजा ते पाप बी ओआ,</para>
  <para style="q" vid="PRO 10:19">पर जो आपणे मुंए खे बंद राखोआ, से अक्ला वाल़ा माणूं गिणेया जाओआ।<verse eid="PRO 10:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 10:20" />तर्मिये रे वचन तो खरे चाँदिए जेड़े ए,</para>
  <para style="q" vid="PRO 10:20">पर बुरेया लोका रा मन बऊत अल़्का ओआ।<verse eid="PRO 10:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 10:21" />तर्मिये रे वचनो ते बऊता रा पाल़न-पोषण ओआ,</para>
  <para style="q" vid="PRO 10:21">पर मूर्ख लोक आपणियां ई मूर्खता री बजा ते मरी जाओए।<verse eid="PRO 10:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 10:22" />जो पैसा यहोवे रिया आशीषा ते मिलोआ,</para>
  <para style="q" vid="PRO 10:22">तिदे से दु:ख नि मलांदा।<verse eid="PRO 10:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 10:23" />मूर्खो खे पाप करना एकी खेलो जेड़ा लगोआ,</para>
  <para style="q" vid="PRO 10:23">पर समजदार माणूंआ खे बुद्धिया रिया गल्ला ते मजा आओआ।<verse eid="PRO 10:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 10:24" />दुष्ट माणूं जेते मुसीबता ते डरोआ, से ई तेस पाँदे पड़ी जाओई,</para>
  <para style="q" vid="PRO 10:24">पर तर्मी जो कुछ सोचोआ से पूरा ऊई जाओआ।<verse eid="PRO 10:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 10:25" />प्रचण्ड अवा रे आऊणे ते दुष्ट माणूं नाश ऊई जाओए,</para>
  <para style="q" vid="PRO 10:25">पर तर्मी सदा बणेया रा रओआ।<verse eid="PRO 10:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 10:26" />जिंयाँ दाँदा खे सिरका ओर आखी खे तुआँ बुरा लगोआ,</para>
  <para style="q" vid="PRO 10:26">तिंयाँ ई आल़सी माणूं तिना माणूंआ खे बुरा लगोआ, जो तेसखे केथी कामो खे पेजोए ओर से नि करदा।<verse eid="PRO 10:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 10:27" />यहोवे रा डर मानणे ते माणूंए री उम्र बढ़ोई,</para>
  <para style="q" vid="PRO 10:27">पर बुरा करने वाल़ेया लोका री जिन्दगी थोड़े ई दिना री ओई।<verse eid="PRO 10:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 10:28" />तर्मिया खे उम्मीद राखणे ते खुशी मिलोई,</para>
  <para style="q" vid="PRO 10:28">पर बुरेया लोका री उम्मीद टूटी जाओई।<verse eid="PRO 10:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 10:29" />यहोवा ईमानदारिया ते चलणे वाल़े माणूंए रा उद्धार करोआ,</para>
  <para style="q" vid="PRO 10:29">पर बुरे काम करने वाल़ेया खे से नाश करोआ।<verse eid="PRO 10:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 10:30" />तर्मी माणूं सदा बणेया दा रणा,</para>
  <para style="q" vid="PRO 10:30">पर दुष्ट तरतिया पाँदे बसी नि सकणा।<verse eid="PRO 10:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 10:31" />तर्मिये रे मुंए ते बुद्धिया रिया गल्ला निकल़ोईया,</para>
  <para style="q" vid="PRO 10:31">पर उल्ट फेरो री गल्ल बोलणे वाल़े री जीब रोकी देणी।<verse eid="PRO 10:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 10:32" />तर्मी ग्रहण योग्य गल्ला खे समजी की बोलोआ,</para>
  <para style="q" vid="PRO 10:32">पर दुष्टो रे मुंए ते उल्ट फेरो रिया गल्ला निकल़ोईया।<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 11:1" />छल करने वाल़ेया ते यहोवा नफरत करोआ जो कम तोलोए,</para>
  <para style="q" vid="PRO 11:1">पर से पूरा नापणे वाल़ेया ते खुश ओआ।<verse eid="PRO 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 11:2" />जेबे कमण्ड ओआ, तेबे बेज्जती बी ओई,</para>
  <para style="q" vid="PRO 11:2">पर बुद्धिमान लोक सब्रखोर ओए।<verse eid="PRO 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 11:3" />सीदेया लोका रा चलणा ई तिना रा आगे बढ़ना ए,</para>
  <para style="q" vid="PRO 11:3">पर विश्वासघाती आपणियां बुरिया चाला ते नाश ऊई जाओए।<verse eid="PRO 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 11:4" />जेस दिने परमेशर गुस्से ओआ, तेस दिने पैसा बी कामे नि आऊँदा,</para>
  <para style="q" vid="PRO 11:4">पर ईमानदारी मौता ते बी बचाओई।<verse eid="PRO 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 11:5" />ईमानदारिया ते खरे माणूंए री जिंदगी आसान ऊई जाओई,</para>
  <para style="q" vid="PRO 11:5">पर दुष्टा रा नाश तिना रिया बुराईया रिया बजा ते ऊई जाणा।<verse eid="PRO 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 11:6" />सीदे लोका रा बचाव तिना रिया तार्मिकता रिया बजा ते ओआ,</para>
  <para style="q" vid="PRO 11:6">पर विश्वासघाती लोक आपणे ई लाल़चो रिया बजा ते फसोए।<verse eid="PRO 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 11:7" />जेबे दुष्ट माणूं मरोआ, तेबे तेसरी आशा टूटी जाओई,</para>
  <para style="q" vid="PRO 11:7">ओर पापिए रा परोसा टुटी जाओआ।<verse eid="PRO 11:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 11:8" />तर्मी मुसीबता ते तो छूटी जाओआ,</para>
  <para style="q" vid="PRO 11:8">पर दुष्ट तेसा ई मुसीबता रे पड़ी जाओआ।<verse eid="PRO 11:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 11:9" />जो यहोवे खे नि मानदा, से आपणे पड़ोसिये खे आपणे मुंए रिया गल्ला ते बिगाड़ोआ,</para>
  <para style="q" vid="PRO 11:9">पर तर्मी लोक ज्ञानो रे जरिए बची जाओए।<verse eid="PRO 11:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 11:10" />जेबे तर्मिया रा कल्याण ओआ, तेबे शईरो रे लोक खुश ओए,</para>
  <para style="q" vid="PRO 11:10">पर जेबे दुष्ट नाश ओए, तेबे शईरो दे जयजयकार ओई।<verse eid="PRO 11:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 11:11" />तर्मी लोका रे आशीर्वादो ते शईरो री बढ़ोतरी ओई,</para>
  <para style="q" vid="PRO 11:11">पर बुरेया लोका री गल्ला ते से टाल़ेया जाओआ।<verse eid="PRO 11:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 11:12" />से मूर्ख माणूं ए, जो आपणे पड़ोसिये खे तुच्छ जाणोआ,</para>
  <para style="q" vid="PRO 11:12">पर समजदार माणूं चुपचाप रओआ।<verse eid="PRO 11:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 11:13" />जो आपणे पड़ोसिये री चुगली करदा रओआ, से पेतो रिया गल्ला बताओआ,</para>
  <para style="q" vid="PRO 11:13">पर परोसा करने जोगा माणूं गल्ल लकोई राखोआ।<verse eid="PRO 11:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 11:14" />जेते देशो दे अक्लमंद परदान नि ऊँदा, तेथो री प्रजा मुसीबता रे पड़ी जाओई,</para>
  <para style="q" vid="PRO 11:14">पर सई सलाह देणे वाल़ेया रिया बजा ते तेते शईरो रा बचाव ओआ।<verse eid="PRO 11:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 11:15" />जो परदेशिये री जिम्मेबारी लओआ, तेसखे बऊत दु:ख ओआ,</para>
  <para style="q" vid="PRO 11:15">पर जो जिम्मेवारिया ते नफरत करोआ, से डरदा नि।<verse eid="PRO 11:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 11:16" />दया करने वाल़ी जवाणस मान-मर्यादा नि खोंदी,</para>
  <para style="q" vid="PRO 11:16">ओर हुड़दंगी लोक पैसे खे नि खोंदे।<verse eid="PRO 11:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 11:17" />दया करने वाल़ा माणूं आपणा ई पला करोआ,</para>
  <para style="q" vid="PRO 11:17">पर जो क्रूर ए, से आपणे ई शरीरो खे दु:ख देओआ।<verse eid="PRO 11:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 11:18" />दुष्ट माणूंआ खे सच्चो खे ई कुछ पनि मिलदा,</para>
  <para style="q" vid="PRO 11:18">पर सई काम करने वाल़ेया खे पक्का फल मिलोआ।<verse eid="PRO 11:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 11:19" />जिने किने बी सई काम करने रा मन बणाई ला रा ए से जिऊँदा रणा,</para>
  <para style="q" vid="PRO 11:19">पर जो बुराईया रा पीछा करोआ, से मरी जाणा।<verse eid="PRO 11:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 11:20" />यहोवा तिना ते नफरत करोआ जो मनो रे टेडे ए,</para>
  <para style="q" vid="PRO 11:20">पर जिना रा चाल-चलण तर्मो रा ए, से तिना ते खुश रओआ।<verse eid="PRO 11:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 11:21" />आऊँ मजबूतिया साथे बोलूँआ, बुरा माणूं निर्दोष नि ठईरना,</para>
  <para style="q" vid="PRO 11:21">पर तर्मिये रा कुल बचाया जाणा।<verse eid="PRO 11:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 11:22" />जो सुन्दर जवाणस समज नि राखदी,</para>
  <para style="q" vid="PRO 11:22">से नाको रे सूईने रा बाल़ू पईनी की सूंरिया जेड़ी ए।<verse eid="PRO 11:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 11:23" />तर्मिये री इच्छा तो बस पलाईया री ई ओई,</para>
  <para style="q" vid="PRO 11:23">पर बुरेया लोका री उम्मीदा रा फल परमेशरो रा गुस्सा ई ओआ।<verse eid="PRO 11:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 11:24" />एड़े ए, जो बखेरी देओए, तेबे बी तिना री बढ़ोतरी ओई;</para>
  <para style="q" vid="PRO 11:24">ओर एड़े बीए जो सामर्था ते कम देओए ओर इजी ते तिना खे कमी ई ओई।<note caller="+" style="f"><char style="fr" closed="false">11:24 </char><char style="ft" closed="false">2 कुरिन्थ 9:6</char></note><verse eid="PRO 11:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 11:25" />खुले दिलो ते देणे वाल़ा माणूं खरा ओआ,</para>
  <para style="q" vid="PRO 11:25">ओर जो ओरी रा पला करोआ, तेसरा बी पला ई ऊणा।<verse eid="PRO 11:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 11:26" />जो माणूं जरूरती से जादा नज्जो खे आपू गे लकोई की राखोआ, तेसखे लोक स्राप देओए,</para>
  <para style="q" vid="PRO 11:26">पर जो तिजी खे बेची देओआ, तेसखे आशीर्वाद दित्तेया जाओआ।<verse eid="PRO 11:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 11:27" />जो जिऊए ते पलाई करोआ, से ओरी री खुशी टोल़ोआ,</para>
  <para style="q" vid="PRO 11:27">पर जो दूजे दे बुराईया खे टोल़ोआ, तेस पाँदे ई बुराई आई जाओई।<verse eid="PRO 11:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 11:28" />जो आपणे पैसे पाँदे परोसा राखोआ, से सूकेया पत्तेया जेड़ा गिरी जाओआ,</para>
  <para style="q" vid="PRO 11:28">पर तर्मी माणूं नये पत्ते जेड़े लईरांदे रओए।<verse eid="PRO 11:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 11:29" />जो माणूं आपणे कराने खे तोड़ी की दु:ख देओआ, तेसरे इस्से दे कुछ नि आऊणा,</para>
  <para style="q" vid="PRO 11:29">ओर मूर्ख माणूं अक्लमंदो रा दास ऊई जाओआ।<verse eid="PRO 11:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 11:30" />तर्मिये रा फल जिन्दगिया रा डाल़ ओआ,</para>
  <para style="q" vid="PRO 11:30">ओर अक्लमंद माणूं, ओरी माणूंआ रा मन जीती लओआ।<verse eid="PRO 11:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 11:31" />देख, तर्मी माणूंए खे तरतिया पाँदे आशीष मिलणी,</para>
  <para style="q" vid="PRO 11:31">तो पक्का ए कि दुष्ट ओर पापिया खे बी तिना रे पापो री सजा मिलणी।<note caller="+" style="f"><char style="fr" closed="false">11:31 </char><char style="ft" closed="false">1 पत 4:18</char></note><verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 12:1" />जो शिक्षा रिया गल्ला खे मानोआ, से ज्ञानो रिया गल्ला ते बी प्यार राखोआ,</para>
  <para style="q" vid="PRO 12:1">पर जो चिड़कणे ते बैर राखोआ, से डांगरो जेड़ा मूर्ख ए।<verse eid="PRO 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 12:2" />खरे माणूं तो यहोवे रा अनुग्रह पाओए,</para>
  <para style="q" vid="PRO 12:2">पर बुरी साजिश करने वाल़ेया खे से दोषी ठईराओआ।<verse eid="PRO 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 12:3" />कोई माणूं बुराईया रिया बजा ते बणेया रा नि रंदा,</para>
  <para style="q" vid="PRO 12:3">पर तर्मी माणूं बणे रे रणे।<verse eid="PRO 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 12:4" />खरे सबाओ री जवाणस आपणे लाड़े रे सिरो रा मुकुट ओई,</para>
  <para style="q" vid="PRO 12:4">पर जो शरमा जोगे काम करोई, तेसा रिया बजा ते तेसा रे लाड़े रिया आड्डिया तक सड़ी जाओईया।<verse eid="PRO 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 12:5" />तर्मिया री योजना न्याय री ओई,</para>
  <para style="q" vid="PRO 12:5">पर दुष्ट छल ई सोचोआ।<verse eid="PRO 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 12:6" />बुरेया लोका रिया गल्ला अत्या करने खे ताक लगाणे रे बारे रे ओईया,</para>
  <para style="q" vid="PRO 12:6">पर तर्मी लोका रिया बजा ते खतरे दे पड़े दे लोक बी बचणे।<verse eid="PRO 12:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 12:7" />जेबे बुरेया लोका ते बदला लया जाओआ, तेबे सेयो रंदे ई नि,</para>
  <para style="q" vid="PRO 12:7">पर तर्मिया रा कराना हमेशा बणेया रा रओआ।<verse eid="PRO 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 12:8" />माणूंए री बुद्धिया रे मुताबिक तेसरी तारीफ ओई,</para>
  <para style="q" vid="PRO 12:8">पर बुरा माणूं नबाग जाणेया जाओआ।<verse eid="PRO 12:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 12:9" />जो बडयाईया करोआ पर तेसगे खाणे खे रोटिया पनि ए,</para>
  <para style="q" vid="PRO 12:9">तेसते दास राखणे वाल़ा तुच्छ माणूं बी खरा ए।<verse eid="PRO 12:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 12:10" />तर्मी आपणे डांगरा रे प्राणो री बी सम्बाल़ लओआ,</para>
  <para style="q" vid="PRO 12:10">पर बुरेया लोका री दया बी निर्दयता ए।<verse eid="PRO 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 12:11" />जो आपणी जमीना दे बीज बाओआ, से पेट परी की खाओआ,</para>
  <para style="q" vid="PRO 12:11">पर जो नकम्मेया री संगत करोआ, से मूर्ख ठईरोआ।<verse eid="PRO 12:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 12:12" />दुष्ट लोक बुरे लोका रे लुटे रे समानो री इच्छा करोए,</para>
  <para style="q" vid="PRO 12:12">पर परमेशर खरेया लोका खे कमाणे रा तरीका देओआ।<verse eid="PRO 12:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 12:13" />बुरा माणूं आपणे मुंए रिया बुरिया गल्ला रिया बजा ते फन्दे रे फसोआ,</para>
  <para style="q" vid="PRO 12:13">पर तर्मी मुसीबता ते बारे निकल़ोआ।<verse eid="PRO 12:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 12:14" />सजण माणूं आपणे मुंए रिया गल्ला रे फलो रे जरिए पलाईया साथे परेया रा ओआ,</para>
  <para style="q" vid="PRO 12:14">ओर जेड़ा जो करोआ, तेड़ा ई तेस परना।<verse eid="PRO 12:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 12:15" />मूर्खो खे हमेशा आपणी ई चाल ठीक लगोई,</para>
  <para style="q" vid="PRO 12:15">पर जो दूजेया रिया दित्तिया रिया सलाई खे मानोआ, से अक्लमंद ए।<verse eid="PRO 12:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 12:16" />जेबे कोई मूर्ख नराज ऊई जाओआ, तेबे से छोड़ आपणी नराजगी दखाई देओआ,</para>
  <para style="q" vid="PRO 12:16">पर समजदार बेज्जतिया खे पुलाई देओआ।<verse eid="PRO 12:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 12:17" />एक ईमानदार गवा सच्च बोलोआ,</para>
  <para style="q" vid="PRO 12:17">पर एक चूठा गवा चूठ बोलोआ।<verse eid="PRO 12:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 12:18" />एड़े लोक बी ए जिना रा बिना सोचे समजे बोलणा तलवारी जेड़ा चूबोआ,</para>
  <para style="q" vid="PRO 12:18">पर अक्लमंद माणूंए रे बोलणे ते लोक ठीक ऊई जाओए।<verse eid="PRO 12:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 12:19" />मुंए ते निकल़ी दी सच्चाई सदा बणी री रणी,</para>
  <para style="q" vid="PRO 12:19">पर चूठो रे पैर नि ऊँदे।<verse eid="PRO 12:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 12:20" />बुरी साजिश करने वाल़ेया रे मनो दे छल रओआ,</para>
  <para style="q" vid="PRO 12:20">पर मेल-मलापो री योजना करने वाल़ेया खे शान्ति ओई।<verse eid="PRO 12:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 12:21" />तर्मी माणूंए खे कोई नुकशाण नि ऊँदा,</para>
  <para style="q" vid="PRO 12:21">पर दुष्ट लोक सारी मुसीबता रे फसी जाओए।<verse eid="PRO 12:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 12:22" />चूठ बोलणे वाल़ेया ते यहोवा नफरत करोआ,</para>
  <para style="q" vid="PRO 12:22">पर जो विश्वासो साथे काम करोए, तिना ते से खुश ओआ।<verse eid="PRO 12:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 12:23" />समजदार माणूं ज्ञानो खे प्रगट नि करदे;</para>
  <para style="q" vid="PRO 12:23">पर मूर्ख आपणे मनो री मूर्खता जोरे की प्रचार करोआ।<verse eid="PRO 12:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 12:24" />कामकाजी लोक राज करोए,</para>
  <para style="q" vid="PRO 12:24">पर आल़सी गुलामिया दे पड़ी जाओए।<verse eid="PRO 12:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 12:25" />चिन्ता तुसा रिया खुशिया खे लूटी लओई,</para>
  <para style="q" vid="PRO 12:25">पर पली गल्ला ते से खुश ओई।<verse eid="PRO 12:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 12:26" />तर्मी माणूं आपणे पड़ोसिये री अगुवाई करोआ,</para>
  <para style="q" vid="PRO 12:26">पर दुष्ट माणूं आपणी ई चाला रिया बजा ते पटकी जाओआ।<verse eid="PRO 12:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 12:27" />आल़सी कदी बी आपणे कामो खे पूरा नि करदा,</para>
  <para style="q" vid="PRO 12:27">पर मईणत करने वाल़े माणूंए खे कीमती चीजा मिलोईया।<verse eid="PRO 12:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 12:28" />तार्मिकता रिया बाटा रे जिन्दगी मिलोई,</para>
  <para style="q" vid="PRO 12:28">ओर बुराईया रिया बाटा रे मौत मिलोई।<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 13:1" />अक्लमंद पाऊ आपणे बाओ रिया शिक्षा त्यान देई की सुणोआ,</para>
  <para style="q" vid="PRO 13:1">पर मजाक करने वाल़ा पाऊ थिड़कणे ते बाद पनि सुणदा।<verse eid="PRO 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 13:2" />सजण माणूं आपणियां खरिया गल्ला रे जरिए बड़िया चीजा पाओआ,</para>
  <para style="q" vid="PRO 13:2">पर तोखा देणे वाल़े लोका रा पेट बुरिया गल्ला साथे परोआ।<verse eid="PRO 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 13:3" />जो माणूं सोची-समजी की बोलोआ, से आपणे प्राणा खे बचाओआ,</para>
  <para style="q" vid="PRO 13:3">पर जो माणूं बिना सोचे-समजे बोलोआ, तेसरा नाश ऊई जाओआ।<verse eid="PRO 13:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 13:4" />आल़सी माणूं इच्छा तो बड़ी पारी करोआ,</para>
  <para style="q" vid="PRO 13:4">पर तेसखे कुछ पनि मिलदा,</para>
  <para style="q" vid="PRO 13:4">पर काम करने वाल़े माणूं तगड़े ऊई जाओए।<verse eid="PRO 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 13:5" />तर्मी माणूं चूठिया गल्ला ते बैर राखोआ,</para>
  <para style="q" vid="PRO 13:5">पर दुष्ट माणूंए रा सारा काम शर्मा जोगा ओआ ओर बेज्जती कराओआ।<verse eid="PRO 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 13:6" />तार्मिकता खरी चाल चलणे वाल़ेया री रक्षा करोई,</para>
  <para style="q" vid="PRO 13:6">पर पापी आपणी बुराईया रिया बजा ते नाश ऊई जाओआ।<verse eid="PRO 13:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 13:7" />कोई तो पैसा कट्टा करोआ, पर तेसगे कुछ नि रंदा,</para>
  <para style="q" vid="PRO 13:7">ओर कोई पैसा उडाई देओआ, तेबे बी तेसगे बऊत रओआ।<verse eid="PRO 13:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 13:8" />अमीर माणूं आपणे प्राण बचाणे रिया तँईं पैसे रा इस्तेमाल करोए,</para>
  <para style="q" vid="PRO 13:8">पर गरीब माणूं इना गल्ला रिया तरफा खे कोई त्यान पनि देंदा।<verse eid="PRO 13:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 13:9" />तर्मी माणूं तेस दिऊए जेड़ा ए जो हमेशा चमकेया दा रओआ,</para>
  <para style="q" vid="PRO 13:9">पर दुष्ट माणूं तेस दिऊए जेड़ा ए जो बिजणे वाल़ा ए।<verse eid="PRO 13:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 13:10" />लड़ाई-चगड़े बस कमण्डो ते ई ओए,</para>
  <para style="q" vid="PRO 13:10">पर जो लोक सलाह मानोए, तिना गे बुद्धि रओई।<verse eid="PRO 13:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 13:11" />तोखे की कमाया रा तअन छोड़ ई खत्म ऊई जाओआ,</para>
  <para style="q" vid="PRO 13:11">पर जो मईणत करोआ, तेसरी बढ़ोतरी ओई।<verse eid="PRO 13:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 13:12" />जेबे उम्मीद पूरी ऊणे रे देर ओई, तो मन दु:खी ओआ,</para>
  <para style="q" vid="PRO 13:12">पर जेबे इच्छा पूरी ओई, तेबे बऊत खुशी मिलोई।<verse eid="PRO 13:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 13:13" />जो माणूं परमेशरो रे वचनो खे तुच्छ जाणोआ, से आपू खे नाश करोआ,</para>
  <para style="q" vid="PRO 13:13">पर यहोवे री आज्ञा मानणे वाल़ेया खे अच्छा फल मिलोआ।<verse eid="PRO 13:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 13:14" />अक्लमंदो री शिक्षा जिन्दगिया रे बराबर ए,</para>
  <para style="q" vid="PRO 13:14">ओर तिजी रे जरिए लोक मौता रे फन्दे ते बची सकोए।<verse eid="PRO 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 13:15" />अच्छी बुद्धिया ते माणूं लोका रा साथ पाओआ,</para>
  <para style="q" vid="PRO 13:15">पर विश्वासघातिया री बाट कठण ओई।<verse eid="PRO 13:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 13:16" />समजदार तो समजदारिया साथे काम करोआ,</para>
  <para style="q" vid="PRO 13:16">पर मूर्ख आपणी मूर्खता फैलाओआ।<verse eid="PRO 13:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 13:17" />दुष्ट सन्देशा देणे वाल़ा दूत बुराईया रे फसी जाओआ,</para>
  <para style="q" vid="PRO 13:17">पर परोसे जोगा दूत अच्छा समाचार लयाओआ।<verse eid="PRO 13:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 13:18" />जो शिक्षा खे सुणी-अणसुणी करोआ, से गरीब ऊई जाओआ ओर तेसरी बेज्जती ओई,</para>
  <para style="q" vid="PRO 13:18">पर जो चिड़कणे खे मानोआ, तेसरी इज्जत ओई।<verse eid="PRO 13:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 13:19" />इच्छा रा पूरा ऊणा तो मनो खे शान्ति देओआ,</para>
  <para style="q" vid="PRO 13:19">पर मूर्ख लोक बुराईया ते आटणे ते ना करोए।,<verse eid="PRO 13:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 13:20" />अक्लमंदो री संगति कर, तेबे तूँ बी अक्लमंद ऊई जाणा,</para>
  <para style="q" vid="PRO 13:20">पर मूर्खो साथे चलणे वाल़ा माणूं नाश ऊई जाणा।<verse eid="PRO 13:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 13:21" />मुसीबता तो पापिया पीछे पड़िया दिया ई रओईया,</para>
  <para style="q" vid="PRO 13:21">पर तर्मिया खे अच्छा फल मिलणा।<verse eid="PRO 13:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 13:22" />खरा माणूं आपणे पोते-दोईतेया खे सम्पतिया रा इस्सा छाडी जाओआ,</para>
  <para style="q" vid="PRO 13:22">पर पापिए री सम्पत्ति तर्मिया खे मिली जाओई।<verse eid="PRO 13:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 13:23" />गरीब माणूंआ खे जिम्मीदारे ते बऊत खाणे रिया चीजा मिलोईया,</para>
  <para style="q" vid="PRO 13:23">पर बुरे लोक अन्याय करी की तिजी खे लूटी लओए।<verse eid="PRO 13:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 13:24" />जो बाओ आपणे बच्चेया खे खरी शिक्षा नि देंदा, से आपणे बच्चेया रा बैरी ए,</para>
  <para style="q" vid="PRO 13:24">पर जो तेस साथे प्यार राखोआ, से जिऊए ते तेसखे शिक्षा देओआ।<verse eid="PRO 13:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 13:25" />तर्मी पेट परी की खाओआ,</para>
  <para style="q" vid="PRO 13:25">पर दुष्ट पूखे ई रओए।<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 14:1" />हर अक्लमंद जवाणस आपणे कअरो खे बड़िया बणाओई,</para>
  <para style="q" vid="PRO 14:1">पर मूर्ख जवाणस तिजी खे आपणे ई आथे की टाल़ी देओई।<verse eid="PRO 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 14:2" />जो सच्चाईया साथे चलोआ, से यहोवे रा आदर करने वाल़ा ए,</para>
  <para style="q" vid="PRO 14:2">पर जो टेडी चाल चलोआ, से तेसखे तुच्छ जाणने वाल़ा ठईरोआ।<verse eid="PRO 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 14:3" />मूर्ख लोक जो बोलोए तिजी रिया बजा ते तिना खे सजा मिलणी,</para>
  <para style="q" vid="PRO 14:3">पर अक्लमंद लोक आपणियां समजा रे जरिए आपणी रक्षा करोए।<verse eid="PRO 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 14:4" />जेती बाणे खे तागतबर बल़द नि ए, तेती डोरू बिना फसला ते ई रोए,</para>
  <para style="q" vid="PRO 14:4">पर बल़दो रे बलबूते पाँदे बऊत नज्ज ओआ।<verse eid="PRO 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 14:5" />सच्चा गवाह् चूठ नि बोलदा,</para>
  <para style="q" vid="PRO 14:5">पर चूठा गवाह् चूठिया गल्ला ई बोलोआ।<verse eid="PRO 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 14:6" />मजाक करने वाल़ा कदी बी अक्लमंद नि बणी सकदा,</para>
  <para style="q" vid="PRO 14:6">पर समजदारा खे ज्ञान सानिया ते मिली जाओआ।<note caller="+" style="f"><char style="fr" closed="false">14:6 </char><char style="ft" closed="false">नीति 17:24</char></note><verse eid="PRO 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 14:7" />मूर्खो रा साथ छाडी दे, ताखे तेस साथे रई की ज्ञानो रिया गल्ला नि मिलणिया।<verse eid="PRO 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 14:8" />समजदार माणूं आपणे आचरणो पाँदे नजर राखोआ,</para>
  <para style="q" vid="PRO 14:8">पर मूर्ख आपणियां मूर्खता ते छल करोआ।<verse eid="PRO 14:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 14:9" />मूर्ख लोक आपणे पापो खे मानणे खे मजाक जाणोए,</para>
  <para style="q" vid="PRO 14:9">पर सीदे लोक आशीर्वाद पाणा चाओए।<verse eid="PRO 14:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 14:10" />मन आपू ई आपणा दु:ख जाणोआ,</para>
  <para style="q" vid="PRO 14:10">ओर परदेशी तेसरी खुशिया रे आपणा आथ नि पाई सकदा।<verse eid="PRO 14:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 14:11" />बुरेया लोका रे कअर नाश ऊई जाओए,</para>
  <para style="q" vid="PRO 14:11">पर सीदे लोका रे तम्बूए रे आबादी ओई।<verse eid="PRO 14:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 14:12" />एड़ी बाट ए, जो माणूंआ खे ठीक लगोई,</para>
  <para style="q" vid="PRO 14:12">पर तिजी रे अन्तो रे मौत ई मिलोई।<verse eid="PRO 14:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 14:13" />आसिया रे बखते बी मन उदास ऊई सकोआ,</para>
  <para style="q" vid="PRO 14:13">ओर खुशिया रे अन्तो रे दु:ख ओआ।<verse eid="PRO 14:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 14:14" />बेईमान माणूं आपणे बुरे चाल-चलणो रा फल पुगतोआ,</para>
  <para style="q" vid="PRO 14:14">पर पला माणूं आपणे पले कामो रिया बजा ते सन्तुष्ट ओआ।<verse eid="PRO 14:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 14:15" />शरीफ माणूं तो हर एक गल्ला खे सच्च मानोआ,</para>
  <para style="q" vid="PRO 14:15">पर चलाक माणूं सोची-समजी की चलोआ।<verse eid="PRO 14:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 14:16" />अक्लमंद डरी की बुराईया ते आटोआ,</para>
  <para style="q" vid="PRO 14:16">पर मूर्ख टीठ ऊई की चतौणिया खे पनि मानदा।<verse eid="PRO 14:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 14:17" />जो माणूं चट गुस्सा करोआ, तेस मूर्खता रा काम बी करना,</para>
  <para style="q" vid="PRO 14:17">ओर जो बुरी साजिशा निकयाल़ोआ, तेसते लोक कृणा करोए।<verse eid="PRO 14:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 14:18" />शरीफा रा पाअग मूर्खता ई ओआ,</para>
  <para style="q" vid="PRO 14:18">पर समजदार माणूंआ खे ज्ञानो रा मुकुट मिलणा।<verse eid="PRO 14:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 14:19" />बुरे लोक खरेया माणूंआ रे सामणे चुकोए,</para>
  <para style="q" vid="PRO 14:19">ओर दुष्ट लोक तर्मिया रे द्वारो गे माथा टेकोए।<verse eid="PRO 14:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 14:20" />गरीबो रा पड़ोसी बी तेसते नफरत करोआ,</para>
  <para style="q" vid="PRO 14:20">पर अमीरो रे बऊत दोस्त ओए।<verse eid="PRO 14:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 14:21" />जो आपणे पड़ोसिये खे नबाग जाणोआ, से पाप करोआ,</para>
  <para style="q" vid="PRO 14:21">पर जो गरीब लोका पाँदे दया करोआ, से तअन्य ओआ।<verse eid="PRO 14:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 14:22" />जो बुरी साजिश निकयाल़ोए, क्या सेयो बईमो रे नि पड़दे?</para>
  <para style="q" vid="PRO 14:22">पर खरी योजना निकयाल़ने वाल़ेया साथे करूणा ओर सच्चाईया रा बर्ताव करोए।<verse eid="PRO 14:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 14:23" />मईणत करने ते सदा फायदा ई ओआ,</para>
  <para style="q" vid="PRO 14:23">पर सिर्फ गल्ला करने ते सदा कमी ई ओई।<verse eid="PRO 14:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 14:24" />अक्लमंदा रा तअन ई तिना रा मुकुट ठईरोआ,</para>
  <para style="q" vid="PRO 14:24">पर मूर्खो री मूर्खता खाली मूर्खता ए।<verse eid="PRO 14:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 14:25" />जेबे कोई सच्च बोलोआ तो से बऊत जणेया री जान बचाओआ,</para>
  <para style="q" vid="PRO 14:25">पर जो चूठिया गल्ला करोआ, तेसते तोखा ई ओआ।<verse eid="PRO 14:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 14:26" />यहोवे रा डर मानणे ते मजबूत परोसा ओआ,</para>
  <para style="q" vid="PRO 14:26">ओर तेसरे बच्चेया खे शरण लणे खे जगा मिलोई।<verse eid="PRO 14:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 14:27" />यहोवे रा आदर करना जिन्दगी देणे वाल़े चरने जेड़ा ए,</para>
  <para style="q" vid="PRO 14:27">ओर तिजी रे जरिए लोक मौता रे फन्दे ते बची जाओए।<verse eid="PRO 14:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 14:28" />राजे री महिमा जादा प्रजा ऊणे ते ओई,</para>
  <para style="q" vid="PRO 14:28">पर जेती प्रजा नि ए, तेती परदान नाश ऊई जाओआ।<verse eid="PRO 14:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 14:29" />जो देरा ते गुस्सा करने वाल़ा ए, से बऊत समजदार ए,</para>
  <para style="q" vid="PRO 14:29">पर जो जल्दबाजी करने वाल़ा ए, से मूर्खता खे बढ़ावा देओआ।<verse eid="PRO 14:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 14:30" />शान्त मन, शरीरो खे ठीक राखोआ,</para>
  <para style="q" vid="PRO 14:30">पर मनो रे जल़ने ते आड्डिया बी फूकी जाओईया।<verse eid="PRO 14:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 14:31" />जो गरीबा पाँदे अन्देर करोआ, से यहोवे री निंदा करोआ,</para>
  <para style="q" vid="PRO 14:31">पर जो गरीबो पाँदे दया करोआ, से यहोवे री महिमा करोआ।<verse eid="PRO 14:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 14:32" />दुष्ट माणूं बुराई करदा ऊआ नाश ऊई जाओआ,</para>
  <para style="q" vid="PRO 14:32">पर तर्मिये खे मौता रे बखते बी शरण मिलोई।<verse eid="PRO 14:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 14:33" />समजदारो रे मनो रे बुद्धि वास करोई, पर मूर्खो रे अन्तो रे बखते जो कुछ ए से सामणे आई जाओआ।<verse eid="PRO 14:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 14:34" />लोक तार्मिकता रिया बजा ते बढ़ोए,</para>
  <para style="q" vid="PRO 14:34">पर पापो ते देशो रे लोका री बेज्जती ओई।<verse eid="PRO 14:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 14:35" />जो कर्मचारी<note caller="+" style="f"><char style="fr" closed="false">14:35 </char><char style="ft" closed="false">नौकर</char></note> समजा ते काम करोआ, तेसते राजा खुश ओआ,</para>
  <para style="q" vid="PRO 14:35">पर जो शर्मनाक काम करोआ, तेस पाँदे से गुस्सा करोआ।<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 15:1" />सोबटा ज्वाब सुणने ते जल़न ठण्डी ओई,</para>
  <para style="q" vid="PRO 15:1">पर कड़क शब्द सुणी की गुस्सा पड़की जाओआ।<verse eid="PRO 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 15:2" />अक्लमंद माणूंए रे मुंए ते ज्ञानो रिया गल्ला निकल़ोईया,</para>
  <para style="q" vid="PRO 15:2">पर मूर्ख माणूं बुरिया ई गल्ला करोआ।<verse eid="PRO 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 15:3" />यहोवे रिया आखी सबी जगा रे लगी री रओईया,</para>
  <para style="q" vid="PRO 15:3">सेयो खरे ओर बुरे दुँईं किस्मा रे माणूंआ खे देखदिया रओईया।<verse eid="PRO 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 15:4" />शान्ति देणे वाल़ी गल्ल जिन्दगिया जेड़ा ए,</para>
  <para style="q" vid="PRO 15:4">पर उल्ट फेरो री गल्ला ते आत्मा बी दु:खी ओई।<verse eid="PRO 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 15:5" />मूर्ख पाऊ आपणे बाओ रिया शिक्षा रा तिरस्कार करोआ,</para>
  <para style="q" vid="PRO 15:5">पर जो चिड़कणे खे मानोआ, से समजदार ऊई जाओआ।<verse eid="PRO 15:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 15:6" />तर्मी माणूंए रे कअरे बऊत तअन रओआ,</para>
  <para style="q" vid="PRO 15:6">पर दुष्ट माणूं बुरा बखत आऊणे ते पईले ई तेसखे खोई देओआ।<verse eid="PRO 15:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 15:7" />अक्लमंद लोक गल्ला करने ते ज्ञानो खे फैलाओए,</para>
  <para style="q" vid="PRO 15:7">पर मूर्खा रा जिऊ ठीक नि रंदा।<verse eid="PRO 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 15:8" />बुरे लोका रे बलिदान चढ़ाणे<note caller="+" style="f"><char style="fr" closed="false">15:8 </char><char style="ft" closed="false">प्रार्थना करना</char></note> ते बी यहोवा खुश नि ऊँदा,</para>
  <para style="q" vid="PRO 15:8">पर से सीदे मन वाल़े लोका री प्रार्थना ते खुश ओआ।<verse eid="PRO 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 15:9" />यहोवा बुरेया लोका रे कामा ते नफरत करोआ,</para>
  <para style="q" vid="PRO 15:9">पर से तर्मो रिया गल्ला मानणे वाल़ेया ते प्यार करोआ।<verse eid="PRO 15:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 15:10" />जो माणूं गल़त काम करोए तिना खे कठण सजा मिलणी,</para>
  <para style="q" vid="PRO 15:10">ओर जो चिड़कणे ते बैर राखोआ, से मरे रे माणूंए जेड़ा ए।<verse eid="PRO 15:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 15:11" />जेबे जो अधलोक ओर विनाशलोक दोनों यहोवे रे सामणे खुले रे रओए,</para>
  <para style="q" vid="PRO 15:11">तो माणूंए रा मन तेसते कियाँ छिपी सकोआ।<verse eid="PRO 15:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 15:12" />मजाक करने वाल़ा माणूं चिड़कणे ते खुश नि ऊँदा,</para>
  <para style="q" vid="PRO 15:12">ओर ना ई से अक्लमंद माणूंए गे सलाह लणे खे जाओआ।<verse eid="PRO 15:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 15:13" />माणूंआ रे खुश रणे ते तिना रे मुंए पाँदे खुशी छाई दी दिशोई,</para>
  <para style="q" vid="PRO 15:13">पर तिना रे दु:खी रणे ते तिना रे मुंए पाँदे उदासी दिशोई।<verse eid="PRO 15:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 15:14" />समजदार माणूं जादा ते जादा सिखणा चाओए,</para>
  <para style="q" vid="PRO 15:14">पर मूर्ख लोक मूर्खता रिया गल्ला ते ई खुश रओए।<verse eid="PRO 15:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 15:15" />गरीब माणूंआ री जिन्दगी दु:खो देई रओई,</para>
  <para style="q" vid="PRO 15:15">पर जेस माणूंए रा मन खुश रओआ, से मानो हर रोज पाट्टी खाणे जाओआ।<verse eid="PRO 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 15:16" />अमीर ऊई कि मुश्किला दे पड़ने ते अच्छा ए,</para>
  <para style="q" vid="PRO 15:16">कि गरीब रई कि यहोवे रा डर मानो।<verse eid="PRO 15:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 15:17" />प्यारो वाल़े कअरो रे साग पातो रा खाणा,</para>
  <para style="q" vid="PRO 15:17">बैर राखणे वाल़े कअरो रे उत्तम खाणे ते खरा ए।<verse eid="PRO 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 15:18" />गुस्सा करने वाल़ा मर्द चगड़ा करोआ,</para>
  <para style="q" vid="PRO 15:18">पर जो देरा ते गुस्सा करोआ, से चगड़े खे दबाई देओआ।<verse eid="PRO 15:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 15:19" />आल़सी माणूंए खे हर जगा मुश्किल ई ओई,</para>
  <para style="q" vid="PRO 15:19">पर सच्चे माणूंआ खे कोई मुश्किल नि ऊँदी।<verse eid="PRO 15:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 15:20" />अक्लमंद पाऊए ते तेसरे माए-बाओ खुश ओए।</para>
  <para style="q" vid="PRO 15:20">पर मूर्ख माणूं आपणे माए-बाओ खे तुच्छ जाणोआ।<verse eid="PRO 15:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 15:21" />जेस माणूं खे समज नि ऊँदी तेसखे मूर्खता ते खुशी ओई,</para>
  <para style="q" vid="PRO 15:21">पर समजदार माणूं सीदी चाल चलोआ।<verse eid="PRO 15:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 15:22" />बिना सलाई ते कित्ती रिया इच्छा निष्फल ओईया,</para>
  <para style="q" vid="PRO 15:22">पर बऊत सारे मन्त्रिया रिया सलाई ते कामयाबी मिलोई।<verse eid="PRO 15:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 15:23" />सई बखतो पाँदे सई ज्वाब देणे ते सब खुश ओए।</para>
  <para style="q" vid="PRO 15:23">ओर मोके पाँदे बोली री गल्ल कितणी खरी ओई।<verse eid="PRO 15:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 15:24" />अक्लमंद माणूंए री जिन्दगिया री बाट ऊबो खे जाओई,</para>
  <para style="q" vid="PRO 15:24">इजी बजा ते से अधलोको रे पड़ने ते बची जाओआ।<verse eid="PRO 15:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 15:25" />यहोवा कमण्डिया रा कअर टाल़ी देओआ,</para>
  <para style="q" vid="PRO 15:25">पर बिदुआ रे कअरो खे बचाई की राखोआ।<verse eid="PRO 15:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 15:26" />बुरी साजिश करने वाल़ेया माणूंआ ते यहोवा नफरत करोआ,</para>
  <para style="q" vid="PRO 15:26">पर शुद्ध मनो वाल़े रे वचन मनो खे अच्छे लगणे वाल़े ए।<verse eid="PRO 15:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 15:27" />तअनो रा लाल़ची माणूं आपणे कराने खे दु:ख देओआ,</para>
  <para style="q" vid="PRO 15:27">पर तोखे रिया कमाईया ते नफरत करने वाल़ा माणूं जिऊँदा रओआ।<verse eid="PRO 15:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 15:28" />तर्मी जबाव देणे ते पईले मनो रे सोचोआ कि क्या जबाव देऊँ,</para>
  <para style="q" vid="PRO 15:28">पर बुरेया लोका रे मुंए ते बुरिया गल्ला निकल़ोईया।<verse eid="PRO 15:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 15:29" />यहोवा बुरेया लोका ते दूर रओआ,</para>
  <para style="q" vid="PRO 15:29">पर तर्मी माणूंआ री प्रार्थना पक्का सुणोआ।<verse eid="PRO 15:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 15:30" />आसदी ऊई सकल तुसा खे खुश करी देओई,</para>
  <para style="q" vid="PRO 15:30">ओर अच्छी खबर तुसा खे खरा महसूस कराओई।<verse eid="PRO 15:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 15:31" />जो जीवन देणे वाल़िया गल्ला खे कान लगाई की सुणोआ,</para>
  <para style="q" vid="PRO 15:31">से अक्लमंद माणूंआ साथे ठकाणा पाओआ।<verse eid="PRO 15:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 15:32" />जो माणूं खरिया शिक्षा खे सुणी-अणसुणी करोआ, से आपणे प्राणो खे तुच्छ जाणोआ,</para>
  <para style="q" vid="PRO 15:32">पर जो बकणा सुणोआ, तेसखे बुद्धि मिलोई।<verse eid="PRO 15:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 15:33" />यहोवे रा आदर करने ते ज्ञानो रिया गल्ला सिखणे खे मिलोईया,</para>
  <para style="q" vid="PRO 15:33">ओर महिमा ते पईले नम्रता ओई।<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 16:1" />माणूं आपणे मनो दे बऊत योजना बणाओआ,</para>
  <para style="q" vid="PRO 16:1">पर यहोवा से आ जो ये पक्का करोआ कि क्या ऊणा चाईयो।<verse eid="PRO 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 16:2" />माणूंए रा सारा चाल-चलण तेसरिया आपणी नजरा रे पवित्र ठईरोआ,</para>
  <para style="q" vid="PRO 16:2">पर यहोवा माणूंए रे मनो खे परखोआ।<verse eid="PRO 16:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 16:3" />आपणे सारे कामा खे यहोवे गे देई दे,</para>
  <para style="q" vid="PRO 16:3">इजी ते तेरिया इच्छा पुरिया ऊणिया।<verse eid="PRO 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 16:4" />यहोवे हर एक चीज खास मकसदो साथे बणाई राखी,</para>
  <para style="q" vid="PRO 16:4">बल्कि दुष्ट बी मुसीबत पुगतणे खे बणाई राखेया।<note caller="+" style="f"><char style="fr" closed="false">16:4 </char><char style="ft" closed="false">कुलु. 1:16</char></note><verse eid="PRO 16:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 16:5" />जिना रे मनो रे कमण्ड ओआ, तिना सबी ते यहोवा नफरत करोआ,</para>
  <para style="q" vid="PRO 16:5">आऊँ पक्का ऊई की बोलूँआ कि एड़ेया लोका खे तेस पक्का सजा देणी।<verse eid="PRO 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 16:6" />पापो रा प्राश्चित कृपा ओर सच्चाईया साथे ओआ,</para>
  <para style="q" vid="PRO 16:6">ओर यहोवे रा आदर करने ते माणूं बुराई करने ते बची जाओआ।<verse eid="PRO 16:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 16:7" />जेबे यहोवा केसी माणूंए रे चाल-चलणो ते खुश ओआ,</para>
  <para style="q" vid="PRO 16:7">तेबे से तेसरे दुश्मणा खे बी तेसरे दोस्त बणाई देओआ।<verse eid="PRO 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 16:8" />अन्याय रे जरिये कमाए रे तन्नो रे बड़े फायदे ते,</para>
  <para style="q" vid="PRO 16:8">न्याय ते थोड़ा जा तन्न मिलणा खरा ए।<verse eid="PRO 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 16:9" />माणूं आपणी योजना बणाओए,</para>
  <para style="q" vid="PRO 16:9">पर यहोवा पक्का करोआ कि आसा केई जाणा।<verse eid="PRO 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 16:10" />राजे रे मुंए ते देववाणी निकल़ोई,</para>
  <para style="q" vid="PRO 16:10">इजी खे तेसते पूली की बी अन्याय नि ऊँदा।<verse eid="PRO 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 16:11" />यहोवा चाओआ कि माणूं केसी बी चीजा रा बजन करने दे ईमानदार रओ,</para>
  <para style="q" vid="PRO 16:11">ओर से चाओआ कि माणूं ईमानदारिया ते नापो। माणूं हर कामो दे ईमानदार ऊणे चाईयो।<verse eid="PRO 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 16:12" />बुरे काम करना राजेया खे घृणित लगोआ,</para>
  <para style="q" vid="PRO 16:12">कऊँकि तिना री गद्दी न्याय, तर्मो साथे ई बणी दी रओई।<verse eid="PRO 16:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 16:13" />एक राजा सच्च सुणने ते खुश ओआ,</para>
  <para style="q" vid="PRO 16:13">ओर जो लोक सच्च बोलोए राजा तिना ते प्यार करोआ।<verse eid="PRO 16:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 16:14" />जेबे राजा बऊत गुस्से रे ऊई जाओ तो पक्का केसी री मौत ऊई सकोई,</para>
  <para style="q" vid="PRO 16:14">पर अक्लमंद माणूं आपणियां गल्ला ते तेसरे गुस्से खे ठण्डा करोआ।<verse eid="PRO 16:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 16:15" />जेबे राजा खुश ओआ तो तेबे से केसी खे बी जीवनदान देई सकोआ,</para>
  <para style="q" vid="PRO 16:15">ये बादल़ो जेड़ा ओआ जो बसन्त ऋतुआ री बरखा देओआ।<verse eid="PRO 16:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 16:16" />बुद्धिया रा मिलणा शुद्ध सूईने खे मिलणे ते खरा ए,</para>
  <para style="q" vid="PRO 16:16">ओर समजदार बणना चाँदिए रे मिलणे ते बऊत खरा ए।<verse eid="PRO 16:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 16:17" />तर्मी लोक बुरिया बाटा ते दूर रओए,</para>
  <para style="q" vid="PRO 16:17">ओर इजी रे बारे दे सोचोए कि सेओ कुण जिया बाटा दे चलणे लगी रे।<verse eid="PRO 16:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 16:18" />माणूं नाशो ते पईले गर्व ओर ठोकर खाणे ते पईले कमण्ड करोआ।<verse eid="PRO 16:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 16:19" />कमण्डिया साथे लूट बांडणे ते, गरीब लोका साथे नम्र सबाओ ते रणा खरा ए।<verse eid="PRO 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 16:20" />जो माणूं वचन सुणने खे मन लगाओआ, तेसरा कल्याण ओआ,</para>
  <para style="q" vid="PRO 16:20">ओर जो यहोवे पाँदे परोसा राखोआ, से तअन्य ओआ।<verse eid="PRO 16:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 16:21" />जेसरे मनो रे बुद्धि ए, तेसखे समजदार बोलेया जाओआ,</para>
  <para style="q" vid="PRO 16:21">ओर मीठा बोलणे ते ज्ञान बढ़ोआ।<verse eid="PRO 16:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 16:22" />जेसगे बुद्धि ए, तेसखे से जिन्दगिया रे बराबर ए,</para>
  <para style="q" vid="PRO 16:22">पर मूर्खा खे शिक्षा देणा मूर्खता ईए।<verse eid="PRO 16:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 16:23" />अक्लमंद माणूंए रे मुंए दे बी अक्ला रिया गल्ला रओईया,</para>
  <para style="q" vid="PRO 16:23">ओर तेसरिया गल्ला रे शिक्षा रओई।<verse eid="PRO 16:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 16:24" />मनो खे अच्छे लगणे वाल़े वचन, सईतो जेड़े प्राणो खे मिठे लगोए,</para>
  <para style="q" vid="PRO 16:24">ओर आड्डिया खे मजबूत करी देओए।<verse eid="PRO 16:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 16:25" />एड़ी बी बाट ए, जो माणूंआ खे सीदी लगोई,</para>
  <para style="q" vid="PRO 16:25">पर तेतेरे अन्तो रे मौत ई मिलोई।<verse eid="PRO 16:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 16:26" />एक मजदुरो री पूख तेसते ओर मईणत कराओई,</para>
  <para style="q" vid="PRO 16:26">कऊँकि से आपणी पूख मिटाणा चाओआ।<verse eid="PRO 16:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 16:27" />अधर्मी माणूं बुराई करने रे बारे दे सोचदा रओआ,</para>
  <para style="q" vid="PRO 16:27">ओर तेसरिये गल्ले की आग लगी जाओई।<verse eid="PRO 16:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 16:28" />बुरा माणूं बऊत चगड़े करोआ,</para>
  <para style="q" vid="PRO 16:28">ओर चूगली करने वाल़ा पक्के दोस्ता बीचे बी फूट पाई देओआ।<verse eid="PRO 16:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 16:29" />उड़दंगी माणूं आपणे पड़ोसिया खे बईकाई देओआ,</para>
  <para style="q" vid="PRO 16:29">ओर तेसखे गल़त बाटा रिये लई चलोआ।<verse eid="PRO 16:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 16:30" />माणूं आखी ते साअरे करी की दूजेया रा नुकसान करने रे बारे दे सोचोआ,</para>
  <para style="q" vid="PRO 16:30">ओर ओठ चबाणे वाल़ा बुराई करोआ।<verse eid="PRO 16:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 16:31" />सफेद बाल़ तर्मी माणूंए रा मुकुट ए,</para>
  <para style="q" vid="PRO 16:31">सेयो तर्मो रिया बाटा दे चलणे ते मिलोआ।<verse eid="PRO 16:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 16:32" />देरा ते गुस्सा करना वीरता ए,</para>
  <para style="q" vid="PRO 16:32">ओर आपणे मनो खे वशो रे राखणा शईरो खे जीतणे ते खरा ए।<verse eid="PRO 16:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 16:33" />न्याय करने रिया तँईं चिट्ठी पाई तो जाओई,</para>
  <para style="q" vid="PRO 16:33">पर तिजी रा निकल़ना यहोवे रिया तरफा ते ओआ।<note caller="+" style="f"><char style="fr" closed="false">16:33 </char><char style="ft" closed="false">प्रेरित. 1:26</char></note><verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 17:1" />चैनी साथे रोटिया रा सूका टुकड़ा, तेस कअरो ते खरा ए,</para>
  <para style="q" vid="PRO 17:1">जेते कअरो दे बड़ी पाट्टी बी सुखो साथे नि खाई सकदे।<verse eid="PRO 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 17:2" />जो ल्वाद आपणे माए-बाओ री बेज्जती कराओई, तेसा ल्वादा पाँदे तेते कअरो रे दासो राज करना जो बुद्धिया साथे चलणे वाल़ा ए,</para>
  <para style="q" vid="PRO 17:2">ओर से दास आपणे मालको रे कराने बीचे इस्सेदार ऊई जाणा।<verse eid="PRO 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 17:3" />जिंयाँ चाँदिए खे परखणे खे कुठाल़ी ओर सूईने खे परखणे खे पट्ठी ओई,</para>
  <para style="q" vid="PRO 17:3">तियाँ ई मनो खे यहोवा परखोआ।<note caller="+" style="f"><char style="fr" closed="false">17:3 </char><char style="ft" closed="false">1 पत 1:17 </char></note><verse eid="PRO 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 17:4" />बुरे काम करने वाल़ा बुरिया गल्ला खे त्यानो साथे सुणोआ,</para>
  <para style="q" vid="PRO 17:4">ओर चूठा माणूं बुरिया गल्ला रिया तरफा खे कान लगाओआ।<verse eid="PRO 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 17:5" />जो माणूं गरीबो रा मजाक उडाओआ,</para>
  <para style="q" vid="PRO 17:5">से तेसरे बनाणे वाल़े परमेशरो री निंदा करोआ,</para>
  <para style="q" vid="PRO 17:5">ओर जो कोई केसी दूजे रे दु:खो पाँदे आसोआ, तेसखे पक्का सजा मिलणी।<verse eid="PRO 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 17:6" />स्याणेया री शोभा तिना रे पोते-दोईतेया ते ओई,</para>
  <para style="q" vid="PRO 17:6">ओर बाल-बच्चेया री शोभा तिना रे माये-बाओ ए।<verse eid="PRO 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 17:7" />मूर्खा रे मुंए ते खरिया गल्ला ठीक नि लगदिया,</para>
  <para style="q" vid="PRO 17:7">ओर जादा करी की चूठिया गल्ला परदानो रे मुंए ते ठीक नि लगदिया।<verse eid="PRO 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 17:8" />कुछ लोका खे लगोआ कि रिश्वत केसी मणिया जेड़ी ए,</para>
  <para style="q" vid="PRO 17:8">तिना रा ये मानणा ए कि इजी ते सारे काम सानिया दे ऊई सकोए।<verse eid="PRO 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 17:9" />जो दूजे रे पापा खे माफ करी देओआ, से प्यारो खे टोल़ने वाल़ा ओआ,</para>
  <para style="q" vid="PRO 17:9">पर जो दूजेया रिया गल्ला री चर्चा ओरे-पोरे करोआ, से पक्के दोस्ता बीचे बी फूट पाई देओआ।<verse eid="PRO 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 17:10" />एक समजदार माणूं थिड़कणे ते जितणा सिखोआ,</para>
  <para style="q" vid="PRO 17:10">तिथणा ई सौ बार मार खाणा मूर्खो रे मनो रे असर नि करदा।<verse eid="PRO 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 17:11" />बुरा माणूं दंगे री ई कोशिश करोआ,</para>
  <para style="q" vid="PRO 17:11">तेबेई तो तेसगे कठोर मनो वाल़ा दूत सजा देणे खे पेजेया जाणा।<verse eid="PRO 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 17:12" />मूर्खता रे डूबे रे मूर्ख माणूंए साथे मिलणे ते खरा ए,</para>
  <para style="q" vid="PRO 17:12">जेसा रीछणिया रा बच्चा राची रा ओ तेसा रा सामणा करना।<verse eid="PRO 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 17:13" />जो कोई माणूं पले कामा रे बदले बुरे काम करोआ,</para>
  <para style="q" vid="PRO 17:13">तेसरे कअरो ते बुराई कदी बी दूर नि ऊणी।<verse eid="PRO 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 17:14" />चगड़े री शुरूआत पाणिए ते परे डईमो दे छेद ऊणे जेड़ी ए,</para>
  <para style="q" vid="PRO 17:14">चगड़ा बढ़ने ते पईले तिजी खे छाडणा खरा ए।<verse eid="PRO 17:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 17:15" />यहोवा एड़ेया माणूंआ ते नफरत करोआ जो माणूं दोषिये खे निर्दोष,</para>
  <para style="q" vid="PRO 17:15">ओर जो निर्दोषो खे दोषी ठराओए।<verse eid="PRO 17:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 17:16" />मूर्ख माणूंए रिया पढ़ाईया पाँदे खर्चा करने रा कोई फाईदा नि ए,</para>
  <para style="q" vid="PRO 17:16">कऊँकि तेसगे समज ई नि ए।<verse eid="PRO 17:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 17:17" />सच्चा दोस्त हर बखत प्यार राखोआ,</para>
  <para style="q" vid="PRO 17:17">ओर मुसीबता रे बखते पाई बणी जाओआ।<verse eid="PRO 17:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 17:18" />मूर्ख माणूं आथो पाँदे आथ मारोआ,</para>
  <para style="q" vid="PRO 17:18">ओर आपणे पड़ोसिये सामणे तेसरा कर्जदार ओआ।<verse eid="PRO 17:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 17:19" />जेसखे लड़ाई-चगड़ा करना अच्छा लगोआ,</para>
  <para style="q" vid="PRO 17:19">तेसखे पाप करना बी अच्छा लगोआ,</para>
  <para style="q" vid="PRO 17:19">जे तुसे हर बखत आपणी बढ़ाई करदे रओए, तो तुसे आपणियां तँईं विपत्तिया खे बुलाओए।<verse eid="PRO 17:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 17:20" />जेस माणूंए रे मनो रे बुरे बचार ओए, तेसरा पल्ला नि ऊँदा,</para>
  <para style="q" vid="PRO 17:20">ओर जो माणूं उल्ट फेरो रिया गल्ला करोआ से मुसीबता रे पड़ोआ।<verse eid="PRO 17:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 17:21" />जो माए-बाओ मूर्खो खे जन्म देओए तिना खे तेसते दु:ख ई मिलोआ;</para>
  <para style="q" vid="PRO 17:21">ओर मूर्खो रे बाओ खे आपणियां ल्वादा ते कदी बी खुशी नि मिलदी।<verse eid="PRO 17:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 17:22" />मनो री खुशी ई सबी ते बड़ी दवा ए, पर जेबे मन टूटोआ तेबे आड्डिया बी सूकी जाओईया।<verse eid="PRO 17:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 17:23" />दुष्ट माणूं न्याय बिगाड़ने खे, आपणियां जेबा दे रिश्वत परोआ।<verse eid="PRO 17:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 17:24" />बुद्धि समजदार माणूंआ रे सामणे ई रओई,</para>
  <para style="q" vid="PRO 17:24">पर मूर्खा रिया आखी तरतिया रे दूर-दूर देशो रे लगी रिया रओईया।<verse eid="PRO 17:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 17:25" />मूर्ख पाऊए रिया बजा ते बाओ उदास रओआ,</para>
  <para style="q" vid="PRO 17:25">ओर तेसरिया माया खे दु:ख ओआ।<verse eid="PRO 17:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 17:26" />ये दोनो ई काम ठीक नि ए कि बेकसुर माणूंए खे सजा देणी,</para>
  <para style="q" vid="PRO 17:26">ओर परदाना खे तिना रिया सिधाईया री बजा ते कूटाणा।<verse eid="PRO 17:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 17:27" />जो माणूं सोची-समजी की ओर कम बोलोआ, से ज्ञानी ठईरोआ;</para>
  <para style="q" vid="PRO 17:27">ओर जो आपणे मनो खे शान्त राखोआ, सेई समजदार माणूं ठईरोआ।<verse eid="PRO 17:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 17:28" />मूर्ख बी जेबे चुप रओआ, तेबे अक्लमंद गिणेया जाओआ,</para>
  <para style="q" vid="PRO 17:28">ओर जो आपणा मूँ बन्द राखोआ, से समजदार गिणेया जाओआ।<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 18:1" />जो माणूं ओरी ते मिली की नि रंदा, से आपणी ई इच्छा पूरी करने खे एड़ा करोआ,</para>
  <para style="q" vid="PRO 18:1">जो गल्ला ओरी सबी खे ठीक लगोईया तिना खे से सुणने खे बी ना करी देओआ।<verse eid="PRO 18:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 18:2" />मूर्ख माणूंए रा मन समजा रिया गल्ला रे नि लगदा, से बस आपणे ई मनो री गल्ल बताणा चाओआ।<verse eid="PRO 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 18:3" />जेती बुरिया गल्ला ओईया तेती बेज्जती बी ओई ओर नरादर ओर निंदा बी ओई।<verse eid="PRO 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 18:4" />बुद्धिमान माणूंए रे मुंए रिया गल्ला समुद्रो रे डूगे पाणिए जेड़िया गईरिया ओईया,</para>
  <para style="q" vid="PRO 18:4">ओर बुद्धिया री सूबल बह्यींदिया नदिया जेड़ी ओई।<verse eid="PRO 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 18:5" />दुष्टो कनारो खे ऊणा ओर तर्मिये साथे अन्याय करना, ठीक नि ए;<verse eid="PRO 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 18:6" />मूर्खो रिया गल्ला मुकद्दमा खड़ा करने वाल़िया ओईया,</para>
  <para style="q" vid="PRO 18:6">ओर से आपू खे मार खाणे जोगा करी देओआ।<verse eid="PRO 18:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 18:7" />मूर्खो रा नाश तेसरी आपणियां गल्ला ते ई ओआ,</para>
  <para style="q" vid="PRO 18:7">ओर तेसरिया गल्ला ई तेसरे प्राणो खे फन्दा बणोईया।<verse eid="PRO 18:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 18:8" />चूगली करने वाल़े रिया गल्ला स्वाद खाणे जेड़िया लगोईया;</para>
  <para style="q" vid="PRO 18:8">सेयो पेटो दे पची जाओईया।<verse eid="PRO 18:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 18:9" />जो काम करने रे आल़स करोआ, से चीजा खे नाश करने वाल़े रा पाई ठईरोआ।<verse eid="PRO 18:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 18:10" />यहोवे रा नाओं मजबूत गढ़ो जेड़ा ए;</para>
  <para style="q" vid="PRO 18:10">तर्मी तिजी रे नठी की सारिया बुराईया ते बचोआ।<verse eid="PRO 18:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 18:11" />अमीर माणूं ये सोचोआ कि तेसरा पैसा शईरो रे चऊँ कनारे रिया ऊच्चिया दवाला रे जेड़ा तेसरी रक्षा करोगा।<verse eid="PRO 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 18:12" />कमण्डी माणूं नाश ऊई जाओआ,</para>
  <para style="q" vid="PRO 18:12">ओर नम्र सबाओ रे माणूंए खे महिमा मिलोई।<verse eid="PRO 18:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 18:13" />मूर्ख माणूं बिना गल्ल सुणे जबाव देओआ,</para>
  <para style="q" vid="PRO 18:13">ओर तेसरी बेईजती बी ओई।<verse eid="PRO 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 18:14" />बमारिया रे माणूं आपणियां ईम्मती ते सम्बाल़ूँआ,</para>
  <para style="q" vid="PRO 18:14">पर जेबे से ईम्मत ई आरी जाओ तो तेसखे मरने रा ई इन्तजार करना चाईयो।<verse eid="PRO 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 18:15" />अक्लमंद माणूं जादा ते जादा सिखणा चाओए,</para>
  <para style="q" vid="PRO 18:15">एड़े लोक जिना गल्ला खे पईले ते जाणोए तिना ते तृप्त नि ऊँदे।<verse eid="PRO 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 18:16" />जेबे तुसे केसी बड़े माणूंए खे कोई तोफा देओए,</para>
  <para style="q" vid="PRO 18:16">तो से तुसा खे तेसते गल्ला करने खे बाट खोली देओआ।<verse eid="PRO 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 18:17" />मकद्दमे रे जो पईले बोलोआ, सेई तर्मी लगोआ,</para>
  <para style="q" vid="PRO 18:17">पर बादो ते दूजे पक्षो रा आई की जेबे बोलोआ तेबे से परखेया जाओआ कि से सच्च बोलोआ कि नई।<verse eid="PRO 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 18:18" />न्याय रिया तँईं चिट्ठी पाणे ते चगड़े बंद ओए,</para>
  <para style="q" vid="PRO 18:18">ओर तागतवरा री लड़ाईया रा अन्त ऊई जाओआ।<verse eid="PRO 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 18:19" />नराज ऊए रे पाईए खे मनाणा मजबूत शईरो रे लणे ते कठण ओआ,</para>
  <para style="q" vid="PRO 18:19">ओर चगड़े राजमईलो रे फाटको जेड़े ए।<verse eid="PRO 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 18:20" />माणूंए रा पेट मुंए रिया गल्ला रे फलो ते परोआ,</para>
  <para style="q" vid="PRO 18:20">ओर बोलणे ते जो कुछ मिलोआ, तिजी ते से रज्जोआ।<verse eid="PRO 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 18:21" />तुसे जो बोलोए से जिन्दगिया खे बचाई या नाश करी सकोआ,</para>
  <para style="q" vid="PRO 18:21">इजी खे तुसा खे आपणियां गल्ला रे परिणामो खे मानणा चाईयो।।<verse eid="PRO 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 18:22" />जिने जवाणस ब्यायी ली, तिने किमती चीज पाई ली,</para>
  <para style="q" vid="PRO 18:22">ओर यहोवे री आशीष तेस पाँदे ऊई री।<verse eid="PRO 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 18:23" />गरीब गिड़गिड़ाई की बोलोआ,</para>
  <para style="q" vid="PRO 18:23">पर अमीर सीदे मुंए गल्ल नि करदा।<verse eid="PRO 18:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 18:24" />कुछ दोस्ती लाम्बे बखतो तक नि चलदी,</para>
  <para style="q" vid="PRO 18:24">पर एड़ा दोस्त बी ओआ, जो पाईया ते बी जादा मिली की रओआ।<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 19:1" />जो गरीब सच्चाईया साथे चलोआ,</para>
  <para style="q" vid="PRO 19:1">से तेस मूर्खो ते खरा ए, जो उल्टिया गल्ला बोलोआ।<verse eid="PRO 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 19:2" />माणूंए रा बिना ज्ञानो ते रणा ठीक नि ए,</para>
  <para style="q" vid="PRO 19:2">ओर जो बिना सोचे-समजे दौड़ोआ से गल़त बाटा रिये चली जाओआ।<verse eid="PRO 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 19:3" />मूर्खता रिया बजा ते माणूं आपणे काम बिगाड़ी देओआ,</para>
  <para style="q" vid="PRO 19:3">ओर से मन ई मन यहोवे पाँदे दोष लगाणे लगी जाओआ।<verse eid="PRO 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 19:4" />अमीरो रे तो बऊत दोस्त ऊई जाओए,</para>
  <para style="q" vid="PRO 19:4">पर गरीबो रे दोस्त तेसते लग ऊई जाओए।<verse eid="PRO 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 19:5" />चूठा गवाह् निर्दोष नि ठईरदा ओर जो चूठ बोलोआ, से सजा पाणे ते नि बचणा।<verse eid="PRO 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 19:6" />उदार माणूंए खे बऊत माणूं मनाई लओए ओर दलेर माणूंए रा दोस्त हर कोई बणी जाओआ।<verse eid="PRO 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 19:7" />जे तुसे गरीब ए तो तुसा रे आपणे रिश्तेदार तुसा ते दूर ऊई जाणे,</para>
  <para style="q" vid="PRO 19:7">तो पक्का ए कि तुसा रे दोस्त बी तुसाते दूर ऊणे।</para>
  <para style="q" vid="PRO 19:7">जेबे तुसा खे तिना री जरूरत ऊणी तेबे सेओ तुसा खे नि मिलणे।<verse eid="PRO 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 19:8" />जेसखे बुद्धि मिलोई, से मानो आपणे प्राणो खे प्यार करने वाल़ा ओआ,</para>
  <para style="q" vid="PRO 19:8">ओर समजा वाल़े माणूंए रा हमेशा कल्याण ओआ।<verse eid="PRO 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 19:9" />चूठा गवाह् पक्का सजा पाओआ,</para>
  <para style="q" vid="PRO 19:9">ओर जो चूठ बोलोआ, से नाश ओआ।<verse eid="PRO 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 19:10" />ये ठीक नि ए कि एक मूर्ख माणूं सुखो दे रओ,</para>
  <para style="q" vid="PRO 19:10">या ये बी ठीक नि ए कि हाकिमा पाँदे एक गुलाम राजा बणी की राज करो।<verse eid="PRO 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 19:11" />जो माणूं बुद्धिया ते काम करोआ, से देरा ते गुस्सा करोआ,</para>
  <para style="q" vid="PRO 19:11">ओर दूजेया रे पापो खे पूलणा तेसखे शोभा देओआ।<verse eid="PRO 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 19:12" />राजे रा गुस्सा जवान शेरो रे दहाड़ने जेड़ा ए,</para>
  <para style="q" vid="PRO 19:12">पर तेसरी खुशी काओ पाँदे पड़े रे पाल़े जेड़ी ओई।<verse eid="PRO 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 19:13" />मूर्ख पाऊ आपणे बाओ खे मुसीबत ठईरोआ,</para>
  <para style="q" vid="PRO 19:13">ओर लाड़िया रे लड़ाई-चगड़े सदा छानी ते चूड़ने वाल़े पाणिए जेड़े ए।<verse eid="PRO 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 19:14" />कअर ओर पैसा बुजुर्गा रे इस्से ते मिलोआ, पर अक्लमंद लाड़ी यहोवे रिया तरफा ते मिलोई।<verse eid="PRO 19:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 19:15" />आल़स करने ते पारी नींज आई जाओई,</para>
  <para style="q" vid="PRO 19:15">ओर जो माणूं काम करने रे आल़स करोआ, तेसरा पेट कदी नि परदा।<verse eid="PRO 19:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 19:16" />जो माणूं यहोवे री आज्ञा खे मानोआ, से आपणे प्राणो खे बचाओआ,</para>
  <para style="q" vid="PRO 19:16">पर जो आपणे चाल-चलणो रे जरिये वचना खे नि मानदा, से मरे जेड़ा ए।<verse eid="PRO 19:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 19:17" />जो माणूं गरीबो पाँदे दया करोआ, से यहोवे खे त्वार देओआ,</para>
  <para style="q" vid="PRO 19:17">ओर तेस आपणे एस कामो रा प्रतिफल पाणा।<note caller="+" style="f"><char style="fr" closed="false">19:17 </char><char style="ft" closed="false">मत्ती 25:40</char></note><verse eid="PRO 19:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 19:18" />जदुए तक ताखे उम्मीद ए, तदुए तक आपणे पाऊए खे बक,</para>
  <para style="q" vid="PRO 19:18">तेसखे ना बकणे रा मतलब तेसखे जानी ते मारने जेड़ा ए।<verse eid="PRO 19:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 19:19" />जो जादा गुस्सा करने वाल़ा ए, तेसखे सजा ऊणे दे,</para>
  <para style="q" vid="PRO 19:19">कऊँकि जे तूँ तेसखे बचाएगा, तो से बारबार बचाणा पड़ना।<verse eid="PRO 19:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 19:20" />जे तुसे सलाई खे सुणोगे ओर सीखणे खे त्यार ए,</para>
  <para style="q" vid="PRO 19:20">तो पक्का एक दिन तुसे समजदार ऊई जाणे।<verse eid="PRO 19:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 19:21" />माणूंए रे मनो रे बऊत सारिया इच्छा ओईया,</para>
  <para style="q" vid="PRO 19:21">पर जो योजना यहोवा करोआ, सेई बणी दी रओई।<verse eid="PRO 19:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 19:22" />माणूंए री दया सबी ते बड़ा गुण ए,</para>
  <para style="q" vid="PRO 19:22">ओर गरीब माणूं चूठ बोलणे वाल़े माणूंए ते खरा ए।<verse eid="PRO 19:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 19:23" />यहोवे रा आदर करने ते उम्र बढ़ोई,</para>
  <para style="q" vid="PRO 19:23">ओर तेसरा आदर करने वाल़ा ठकाणा पाई की सुखी रओआ;</para>
  <para style="q" vid="PRO 19:23">तेस पाँदे मुसीबत नि आऊँदी।<verse eid="PRO 19:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 19:24" />आल़सी माणूं आपणा आथ थाल़िया रे पाओआ,</para>
  <para style="q" vid="PRO 19:24">पर आपणे मुंए तक ग्रा नि चकदा।<verse eid="PRO 19:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 19:25" />मजाक करने वाल़े खे सजा दे, इजी ते शरीफ माणूं समजदार ऊई जाणा;</para>
  <para style="q" vid="PRO 19:25">ओर समजदारो खे बकणे ते, तेसखे ओर बी जादा ज्ञान मिलणा।<verse eid="PRO 19:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 19:26" />जो पाऊ आपणे बाओ साथे सीदे मुंए ते गल्ल नि करदा,</para>
  <para style="q" vid="PRO 19:26">ओर आपणियां माया खे कअरो ते नठाई देओआ,</para>
  <para style="q" vid="PRO 19:26">से सारे लोका बीचे बेज्जती ओर शर्मा री बजा ऊणा।<verse eid="PRO 19:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 19:27" />ओ मेरे पाऊ, जे तूँ सिखणा छाडी दे,</para>
  <para style="q" vid="PRO 19:27">तो तुँ छोड़ ई पईले सिखी रिया ज्ञानो रिया गल्ला खे पूली जाणा।<verse eid="PRO 19:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 19:28" />अदाल़ती दे चूठे गवाह् न्यायधीशा रा मजाक ड्वाओए,</para>
  <para style="q" vid="PRO 19:28">ओर बेकार लोक बुरे काम करने रा मजा लओए।<verse eid="PRO 19:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 19:29" />परमेशर तिना खे सजा देणे खे त्यार ए जो तेसरा मजाक उडाओए,</para>
  <para style="q" vid="PRO 19:29">ओर जो लोक मूर्खता रे काम करोए तिना खे कोड़े मारणे चाईयो।<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 20:1" />बऊत जादा मसाला मिला ऊआ अंगूरा का रस पीणे ते माणूंआ बीचे लड़ाई-चगड़ा ऊई जाओआ,</para>
  <para style="q" vid="PRO 20:1">नशे दे रणा अक्लमंदी नि ए।<verse eid="PRO 20:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 20:2" />राजे रा गुस्सा जवान शेरो रे गरजणे जेड़ा खतरनाक ए;</para>
  <para style="q" vid="PRO 20:2">जो तेसखे गुस्सा दिलाओआ, से आपणे प्राणो रा पापी ओआ।<verse eid="PRO 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 20:3" />लड़ाई-चगड़े ते पीछे आटणा, मर्दो री महिमा ठईरोई;</para>
  <para style="q" vid="PRO 20:3">पर सारे मूर्ख लोक लड़ने खे त्यार रओए।<verse eid="PRO 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 20:4" />आल़सी माणूं ठीक बखतो पाँदे ठण्डी रिया बजा ते अल़ नि बांदा;</para>
  <para style="q" vid="PRO 20:4">इजी री खातर बडाईया रे बखते तेसखे मांगणे ते बी कुछ नि मिलदा।<verse eid="PRO 20:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 20:5" />माणूंए रे मनो रे बऊत योजना तो ओईया,</para>
  <para style="q" vid="PRO 20:5">तेबे बी समजदार माणूं तिजी खे निकयाल़ी देओआ।<verse eid="PRO 20:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 20:6" />बऊत सारे माणूं आपणी कृपा रा टंडोरा पिटोए;</para>
  <para style="q" vid="PRO 20:6">पर सच्चा माणूं मिलणा बऊत ई कठण ए।<verse eid="PRO 20:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 20:7" />तर्मी जो खराईया ते चलदा रओआ,</para>
  <para style="q" vid="PRO 20:7">तेसते बाद तेसरे बाल-बच्चे भाग्यशाली ओए।<verse eid="PRO 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 20:8" />राजा जो न्याय री गद्दिया पाँदे बैठेया करोआ,</para>
  <para style="q" vid="PRO 20:8">से आपणी नजरा तेई सारी बुराईया खे जाणी लओआ।<verse eid="PRO 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 20:9" />कोई नि बोली सकदा कि मैं आपणा मन शुद्ध करिता रा;</para>
  <para style="q" vid="PRO 20:9">या आऊँ पापो ते शुद्ध ऊईगा रा?<verse eid="PRO 20:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 20:10" />यहोवा एड़ेया माणूंआ ते नफरत करोआ जो गल़त बट्टेया रा ओर गल़त नापो रा इस्तेमाल करोए।<verse eid="PRO 20:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 20:11" />बच्चे बी आपणे कामो रे जरिये ये दखाओए कि आसे बी केड़े माणूं ए,</para>
  <para style="q" vid="PRO 20:11">तुसे दसी सकोए कि सेओ सच्चे ओर पले कि नई।<verse eid="PRO 20:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 20:12" />सुणने खे जो कान ओर देखणे खे जो आखी आ,</para>
  <para style="q" vid="PRO 20:12">सेयो दोनो यहोवे बणाई राखिया।<verse eid="PRO 20:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 20:13" />जादा नि सऊंदे रणा, नई तो गरीब ऊई जाणा;</para>
  <para style="q" vid="PRO 20:13">आखी खोल तेबे तूँ रोटिया साथे रज्जणा।<verse eid="PRO 20:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 20:14" />मोले लणे रे बखते ग्राह्क बोलदे रओए कि ये बऊत किमती ए,</para>
  <para style="q" vid="PRO 20:14">पर जेबे चली जाओए, तेबे से जाईकी कमण्ड करोए ओर बोलोए कि आसे से सस्ता खरीदेया ए।<verse eid="PRO 20:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 20:15" />माणूंए गे सूईना ओर बऊत कीमती रत्न तो अए;</para>
  <para style="q" vid="PRO 20:15">पर ज्ञानो रिया गल्ला ई कीमती मणि ठईरी रिया।<verse eid="PRO 20:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 20:16" />केसी पाखले माणूंए रिया तँईं जमानत देणे वाल़े रे टाल्ले लई लओ,</para>
  <para style="q" vid="PRO 20:16">ओर पराए रिया खातर जो जिम्मेबार ऊईरा, तेसते रईनो रिया चीजा लई लओ।<verse eid="PRO 20:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 20:17" />चोरी करी की लयाई री रोटी माणूंए खे मीठी लगोई,</para>
  <para style="q" vid="PRO 20:17">पर बादो ते तेसरा मूँ रोड़िया साथे परे जेड़ा बणी जाओआ।<verse eid="PRO 20:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 20:18" />सब इच्छा सलाई तेई स्थिर ओईया,</para>
  <para style="q" vid="PRO 20:18">ओर युद्ध करने ते पईले योजना बणाई लणी चाईयो।<verse eid="PRO 20:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 20:19" />जो चुगली करदा फिरोआ से पेत बताई देओआ,</para>
  <para style="q" vid="PRO 20:19">इजी री खातर बकवास करने वाल़े साथे मेल जोल नि राखणा चाईयो।<verse eid="PRO 20:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 20:20" />जो आपणे माए-बाओ खे कोसोआ, तो से छोड़ ई मरी जाणा,</para>
  <para style="q" vid="PRO 20:20">ओर तेसरा जीवन एक एड़े दिऊए जेड़ा खत्म ऊई जाणा जो न्हेरे दे बिजी जाओआ।<verse eid="PRO 20:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 20:21" />जितणिया सानिया दे तुसा खे जायदात मिलणी,</para>
  <para style="q" vid="PRO 20:21">तिदे तुसा खे कुछ बी आशीष नि ऊणी।<verse eid="PRO 20:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 20:22" />ईंयाँ नि बोल, “मां बुराईया रा बदला लणा,”</para>
  <para style="q" vid="PRO 20:22">बल्कि यहोवे पाँदे परोसा राख, तेस तूँ छुड़ाणा।<note caller="+" style="f"><char style="fr" closed="false">20:22 </char><char style="ft" closed="false">1 थिस्सलुनी 5:15</char></note><verse eid="PRO 20:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 20:23" />नकली बट्टेया ते यहोवा नफरत करोआ,</para>
  <para style="q" vid="PRO 20:23">ओर तोखे री ताकड़ी ठीक नि ए।<verse eid="PRO 20:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 20:24" />कुछ ऊणे ते पईले कोई बी माणूं जाणी नि सकदा कि क्या ऊणे वाल़ा ए?</para>
  <para style="q" vid="PRO 20:24">क्ऊँकि माणूंए री बाट यहोवे रिया तरफा तेई ठईराई जाओई।<verse eid="PRO 20:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 20:25" />परमेशरो ते वादा करने ते पईले त्यानो साथे सोचणा,</para>
  <para style="q" vid="PRO 20:25">ऊई सकोआ कि तुसे लोक से काम नि करी सको जो करने रा वादा कित्तेया था।<verse eid="PRO 20:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 20:26" />अक्लमंद राजा बुरा करने वाल़ेया लोका रा पता लगाओआ,</para>
  <para style="q" vid="PRO 20:26">ओर तिना खे बिना दया ते सख्त सजा देओआ।<verse eid="PRO 20:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 20:27" />माणूंए री आत्मा यहोवे रा दिऊआ ए, तीजी ते से मनो रिया सबी गल्ला खे टोल़ोआ।<note caller="+" style="f"><char style="fr" closed="false">20:27 </char><char style="ft" closed="false">1 कुरिन्थ 2:11</char></note><verse eid="PRO 20:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 20:28" />राजे री रक्षा कृपा ओर सच्चाईया रिया बजा ते ओई,</para>
  <para style="q" vid="PRO 20:28">ओर न्याय करने ते तेसरी गद्दी बणी री रओई।<verse eid="PRO 20:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 20:29" />जवान माणूंआ री तागत तिना री शान ए,</para>
  <para style="q" vid="PRO 20:29">पर स्याणेया री शोभा तिना रे सफेद बाल़ ए।<verse eid="PRO 20:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 20:30" />कई बार म्हारे जीवनो खे बदलणे रिया तँईं एक काओ रा ऊणा जरूरी ओआ।</para>
  <para style="q" vid="PRO 20:30">ओर मार खाणे ते मन साफ ऊई जाओआ।<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 21:1" />राजे रा मन नईरा रे पाणिए जेड़ा यहोवे रे आथो रे रओआ,</para>
  <para style="q" vid="PRO 21:1">जेथो खे से चाओआ, तेथो खे तिजी खे फेरी देओआ।<verse eid="PRO 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 21:2" />माणूंए रा सारा चाल-चलण तेसरिया आपणियां नजरा रे तो ठीक ए,</para>
  <para style="q" vid="PRO 21:2">पर यहोवा तेसरे मनो खे परखोआ।<verse eid="PRO 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 21:3" />जो सई ओर न्याय ए, से करना परमेशरो खे बलिदान करने ते जादा खरा लगोआ।<verse eid="PRO 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 21:4" />बुरे लोक आपणे कमण्ड ओर अकड़ा रे जरिये हांडोए,</para>
  <para style="q" vid="PRO 21:4">ओर ये पाप ए।<verse eid="PRO 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 21:5" />काम करने वाल़े री इच्छा ते बस फायदा ई ओआ,</para>
  <para style="q" vid="PRO 21:5">पर जल्दबाजी करने वाल़े खे बस काअटा ओआ।<verse eid="PRO 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 21:6" />जो माणूं दूजेया ते चूठ बोली कि पैसा कमाओए, सेओ चट ई कोहरे जेड़े राची जाणे,</para>
  <para style="q" vid="PRO 21:6">ओर एड़ा करने ते चट ई तिना री मौत ऊई जाणी।<verse eid="PRO 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 21:7" />जो लड़ाई-चगड़ा दुष्ट लोक करोए,</para>
  <para style="q" vid="PRO 21:7">तिजी ते तिना रा ई नाश ओआ, कऊँकि सेयो न्याय रा काम करने ते ना करोए।<verse eid="PRO 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 21:8" />दुष्ट लोक बुरे काम करोए,</para>
  <para style="q" vid="PRO 21:8">पर सीदे लोक सेई करोए जो ठीक ए।<verse eid="PRO 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 21:9" />लाम्बे-चौड़े कअरो रे चगड़ा करने वाल़ी लाड़िया साथे रणे ते,</para>
  <para style="q" vid="PRO 21:9">छतो रे कूणे रे रणा खरा ए।<verse eid="PRO 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 21:10" />दुष्ट माणूं बुराईया री इच्छा जियूए ते करोआ,</para>
  <para style="q" vid="PRO 21:10">तिना खे केसी पाँदे बी दया नि आऊँदी।<verse eid="PRO 21:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 21:11" />जेबे मजाक करने वाल़े खे सजा देओए, तेबे शरीफ अक्लमंद ऊई जाओआ,</para>
  <para style="q" vid="PRO 21:11">ओर जेबे अक्लमंदो खे उपदेश दित्तेया जाओआ,</para>
  <para style="q" vid="PRO 21:11">तेबे तेसखे ज्ञान मिलोआ।<verse eid="PRO 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 21:12" />तर्मी परमेशर दुष्टो रे कराने पाँदे अक्ला साथे सोचोआ,</para>
  <para style="q" vid="PRO 21:12">ओर यहोवा बुरेया लोका खे बुराईया रे पाई देओआ।<verse eid="PRO 21:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 21:13" />जे तुसे गरीबा री पुकार नि सुणदे,</para>
  <para style="q" vid="PRO 21:13">तो जेबे तुसा आपणियां मतादा खे पुकारना तेबे तुसा री पनि सुणी जाणी।<verse eid="PRO 21:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 21:14" />गुप्तो रे दित्ती री पेंटा साथे गुस्सा ठण्डा ओआ,</para>
  <para style="q" vid="PRO 21:14">ओर चोरिए दित्ती री रिश्वता ते बड़ी जल़न बी कम ऊई जाओई।<verse eid="PRO 21:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 21:15" />जेबे न्याय रा काम ओआ तो खरेया माणूंआ खे खुशी मिलोई,</para>
  <para style="q" vid="PRO 21:15">पर अनर्थ करने वाल़ेया खे से बुरा लगोआ।<verse eid="PRO 21:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 21:16" />जो माणूं समजा रिया बाटा ते पटकी जाओआ,</para>
  <para style="q" vid="PRO 21:16">तेसरा ठकाणा मरेया रे बीचे ऊणा।<verse eid="PRO 21:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 21:17" />जो अईयाशी करने ते प्यार राखोआ, से गरीब ऊई जाओआ;</para>
  <para style="q" vid="PRO 21:17">ओर जो अंगूरा रा रस पीणे ओर तेल लगाणे ते प्यार राखोआ, से अमीर नि ऊँदा।<verse eid="PRO 21:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 21:18" />दुष्ट माणूं आपू पाँदे ई दु:ख ल्याओए, जो सेओ तर्मिया माणूंआ पाँदे ल्याऊणा चाओ थे,</para>
  <para style="q" vid="PRO 21:18">ओर विश्वासघाती सीदे लोका रे बदले सजा पुगतोए।<verse eid="PRO 21:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 21:19" />लड़ाकू ओर चिड़चिड़े सबाओ री लाड़िया साथे रणे ते,</para>
  <para style="q" vid="PRO 21:19">सुनसाण जगा रे रणा खरा ए।<verse eid="PRO 21:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 21:20" />अक्लमंद माणूंए रे कअरे बऊत पैसा ओर जादा चीजा मिलोईया,</para>
  <para style="q" vid="PRO 21:20">पर मूर्ख तिना खे डवाई देओआ।<verse eid="PRO 21:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 21:21" />दयालु ओर ईमानदार बणो ओर तुसा री उम्र बढ़नी,</para>
  <para style="q" vid="PRO 21:21">दूजेया तुसा री महिमा करनी ओर तुसा साथे सई बर्ताओ करना।<verse eid="PRO 21:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 21:22" />अक्लमंद माणूं शूरवीरा रे शईरो रे चढ़ी की, तिना रे किले खे,</para>
  <para style="q" vid="PRO 21:22">जेते पाँदे सेयो परोसा राखोए, नाश करोआ।<verse eid="PRO 21:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 21:23" />जो आपणियां जबानी खे वशो रे राखोआ,</para>
  <para style="q" vid="PRO 21:23">से आपणे प्राणो खे मुसीबता ते बचाओआ।<verse eid="PRO 21:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 21:24" />एक कमण्डी माणूं सोचोआ की से दूजेया माणूंआ ते खरा ए, ओर सिर्फ आपणे ई बारे दे सोचोआ।</para>
  <para style="q" vid="PRO 21:24">ओर से ज्ञानो रिया गल्ला रा मजाक उडाओआ।<verse eid="PRO 21:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 21:25" />आल़सी माणूं सोचदे ऊए ई मरी जाओआ,</para>
  <para style="q" vid="PRO 21:25">कऊँकि से आपणे आथा ते कोई काम नि करदा।<verse eid="PRO 21:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 21:26" />कोई एड़ा ए<note caller="+" style="f"><char style="fr" closed="false">21:26 </char><char style="ft" closed="false">आल़सी लोक</char></note> जो पूरा दिन सोचेया ई करोआ,</para>
  <para style="q" vid="PRO 21:26">पर तार्मिक माणूं दूजेया खे बऊत चीजा देणे खे त्यार रओआ।<verse eid="PRO 21:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 21:27" />जेबे बुरे लोक बलिदान चढ़ाओए, तेबे यहोवा तिजी ते नफरत करोआ;</para>
  <para style="q" vid="PRO 21:27">खास करी की जेबे सेयो बुरिया इच्छा ते ल्याओए।<verse eid="PRO 21:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 21:28" />चूठ बोल़णे वाल़ा गवाह् नाश ऊई जाओआ,</para>
  <para style="q" vid="PRO 21:28">जिने जो सुणी राखेया, सेई बोलोआ, से स्थिर रणा।<verse eid="PRO 21:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 21:29" />दुष्ट माणूं सोचोए कि सेओ सब कुछ जाणोए,</para>
  <para style="q" vid="PRO 21:29">पर तर्मी माणूं आपणे चाल-चलणो पाँदे त्यान देओआ कि से क्या करोए।<verse eid="PRO 21:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 21:30" />जे यहोवा तुसा रे खलाफ ए, तो माणूंआ री अक्ल, समज ओर तरकीबा रा कोई फाईदा नि आ।<verse eid="PRO 21:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 21:31" />युद्धो रे दिने कोड़ा तो त्यार ओआ,</para>
  <para style="q" vid="PRO 21:31">पर जीत यहोवा ई देओआ।<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 22:1" />बऊत अमीर ऊणे ते खरा नाओं जादा चाह्णे जोगा ए,</para>
  <para style="q" vid="PRO 22:1">ओर सूईने चाँदिए ते जादा ओरी री इज्जत ए।<verse eid="PRO 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 22:2" />अमीर ओर गरीब दोनो एकी-दूजे जेड़े ए</para>
  <para style="q" vid="PRO 22:2">यहोवा तिना दुँईं खे बनाणे वाल़ा ए।<verse eid="PRO 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 22:3" />चलाक माणूं मुसीबता खे आऊँदा ऊआ देखी की एते ते बचणे री कोशिश करोए;</para>
  <para style="q" vid="PRO 22:3">पर शरीफ लोक आगे बढ़ी की मुसीबता दे पड़ी की सजा पुगतोए।<verse eid="PRO 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 22:4" />नरम सबाओ रा ऊणा ओर यहोवे रा आदर करने रा ईनाम पैसा,</para>
  <para style="q" vid="PRO 22:4">महिमा ओर लाम्बी उम्र ओई।<verse eid="PRO 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 22:5" />बुरे माणूंए खे बाटा दे कांडे ओर फन्दे ई मिलोए;</para>
  <para style="q" vid="PRO 22:5">पर जो आपणा प्राण बचाओआ, से तिना ते दूर रओआ।<verse eid="PRO 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 22:6" />बाल़का खे सखाओ कि तिना किंयाँ जिऊणा चाईयो,</para>
  <para style="q" vid="PRO 22:6">ओर सेओ इजी खे आपणियां पुरिया जिन्दगिया दे याद राखणा।<note caller="+" style="f"><char style="fr" closed="false">22:6 </char><char style="ft" closed="false">इफिसि 6:4</char></note><verse eid="PRO 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 22:7" />अमीर माणूं गरीबा पाँदे राज करोआ,</para>
  <para style="q" vid="PRO 22:7">ओर त्वार लणे वाल़ा, त्वार देणे वाल़े रा दास ओआ।<verse eid="PRO 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 22:8" />जो माणूं दूजेया खे दु:ख देणे रा कारण बणोआ,</para>
  <para style="q" vid="PRO 22:8">से आपू खे पापो रा कारण बणोआ,<verse eid="PRO 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 22:9" />दया करने वाल़े माणूंए पाँदे यहोवे री आशीष रओई,</para>
  <para style="q" vid="PRO 22:9">कऊँकि से आपणियां रोटिया बीचा ते गरीबा खे देओआ।<note caller="+" style="f"><char style="fr" closed="false">22:9 </char><char style="ft" closed="false">2 कुरिन्थ 9:10</char></note><verse eid="PRO 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 22:10" />दूजेया रा मजाक करने वाल़े खे निकयाल़ी दे, तेबे चगड़ा खत्म ऊई जाणा,</para>
  <para style="q" vid="PRO 22:10">ओर बईस ओर बेज्जती दोनो खत्म ऊई जाणे।<verse eid="PRO 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 22:11" />जो माणूं आपणे मनो खे शुद्ध राखोआ,</para>
  <para style="q" vid="PRO 22:11">ओर जेसरिया गल्ला मनो खे अच्छिया लगणे वाल़िया ओईया, राजा बी तेसखे आपणा दोस्त बणाओआ।<verse eid="PRO 22:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 22:12" />यहोवे री नजर हमेशा तिना पाँदे लगी री रओई जो समजदारी दखाओए,</para>
  <para style="q" vid="PRO 22:12">पर से विश्वासघातिये रिया योजना खे बेकार करी देओआ।<verse eid="PRO 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 22:13" />आल़सी माणूं कामो ते टल़ोआ ओर बोलोआ, बारे तो शेर ऊणा!</para>
  <para style="q" vid="PRO 22:13">आऊँ तेस चौको बीचे काई देणा।<verse eid="PRO 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 22:14" />गल़त काम करने वाल़िया जवाणसा रा मूँ डूग्गे खाते जेड़ा ए;</para>
  <para style="q" vid="PRO 22:14">जेसते यहोवा गुस्सा ओआ, सेई तिदे पड़ोआ।<verse eid="PRO 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 22:15" />बच्चेया रा सबाओ ई मूर्खा जेड़ा ओआ,</para>
  <para style="q" vid="PRO 22:15">पर जे तुसे तिना खे सजा देओए तो तिना मूर्खता रा काम करना बंद करी देणा।<verse eid="PRO 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 22:16" />जे तुसे अमीर लोका खे पेंट देओए या अमीर ऊणे रिया बजा ते गरीबा पाँदे अन्देर करोए,</para>
  <para style="q" vid="PRO 22:16">तो तुसे आपू ई गरीब ऊई जाणे।<verse eid="PRO 22:16" /></para>
  <para style="s">अक्लमंदो रिया गल्ला</para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 22:17" />त्यानो साथे अक्लमंदो रिया गल्ला सुण,</para>
  <para style="q" vid="PRO 22:17">ओर मेरे ज्ञानो रिया गल्ला रिया तरफा खे मन लगा;<verse eid="PRO 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 22:18" />जे तूँ तिजी खे आपणे मनो रे राखे,</para>
  <para style="q" vid="PRO 22:18">ओर इना खे याद करी की बोलेया बी करो, तो ये मनो खे अच्छी लगणे वाल़ी गल्ल ऊणी।<verse eid="PRO 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 22:19" />आऊँ आज इना गल्ला खे तांगे इजी खे बताणे लगी रा,</para>
  <para style="q" vid="PRO 22:19">ताकि तेरा परोसा यहोवे पाँदे ओ।<verse eid="PRO 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 22:20" />मैं तेरिया तँईं ती वचन लिखी राखे,</para>
  <para style="q" vid="PRO 22:20">तिदे ज्ञानो रिया गल्ला ओर खरिया सलाई रिया गल्ला ए।<verse eid="PRO 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 22:21" />ओर तेबे तुसा ये जाणी लणा कि सई दे सच्च क्या ए,</para>
  <para style="q" vid="PRO 22:21">तेबे तुसे तिना खे ठीक ज्वाब देई सकोए जिने तुसे पेजी राखे।<verse eid="PRO 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 22:22" />केसी माणूंए खे गरीब देखी कि तेस पाँदे अन्देर नि करना,</para>
  <para style="q" vid="PRO 22:22">जेसरी मताद करने वाल़ा कोई नि ए से अदाल़ती दे नि पीसणा।<verse eid="PRO 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 22:23" />कऊँकि यहोवे तिना रा मुकद्दमा आपू लड़ना,</para>
  <para style="q" vid="PRO 22:23">ओर तेस तिना रे प्राण बी तेस छुड़ाई लणे जो तिना रा पैसा लूटी लओए।<verse eid="PRO 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 22:24" />तैं गुस्सा करने वाल़े माणूंए साथे दोस्ती नि करनी,</para>
  <para style="q" vid="PRO 22:24">ओर ना चट गुस्सा करने वाल़े साथे जाणा,<verse eid="PRO 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 22:25" />केथी एड़ा नि ओ कि तूँ बी तेस जेड़ा ई बणी जाए,</para>
  <para style="q" vid="PRO 22:25">ओर तेरे प्राण फन्दे दे फसी जाओ।<verse eid="PRO 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 22:26" />तिना लोका साथे नि मिली जाणा जो पैसे वापस करने रा वादा करोए,</para>
  <para style="q" vid="PRO 22:26">कऊँकि सेओ पैसे वापस करने जोगे नि ए।<verse eid="PRO 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 22:27" />जे तांगे पैसे वापस देणे खे कुछ नि ओ,</para>
  <para style="q" vid="PRO 22:27">तो जिने ताखे कर्जा देई राखेया तिना तां निठा ते माँजा बी खींजी की लई जाणा।<verse eid="PRO 22:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 22:28" />जो पुराणी सिऊँ तेरे बुजुर्गे ठराई राखी</para>
  <para style="q" vid="PRO 22:28">तेसा खे टाई की आपणे पड़ोसिये री जमीना दे कब्जा नि करना।<verse eid="PRO 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 22:29" />जे तूँ एड़ा माणूं देखे जो काम करने रे माईर ए,</para>
  <para style="q" vid="PRO 22:29">तो से राजे गे बी काम करी सकोए; छोटे लोका सामणे नि।<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 23:1" />जेबे तूँ केसी परदानो साथे रोटी खाणे बैठे,</para>
  <para style="q" vid="PRO 23:1">तेबे ये गल्ल मन लगाई की सोचणी कि मां सामणे कुण बैठी रा?<verse eid="PRO 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 23:2" />जे ताखे जादा पूख लगी री ओ,</para>
  <para style="q" vid="PRO 23:2">तो तेस बखते तू सब्र राखी की थोड़ा जा ई खाई की उठी जाया।<verse eid="PRO 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 23:3" />जो स्वाद खाणे री चीजा ताखे देणे लगी रा तिजी रा लाल़च नि करना,</para>
  <para style="q" vid="PRO 23:3">कऊँकि ऊई सकोआ से ताखे फसाणे री कोशिश करने लगी रा ओ।<verse eid="PRO 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 23:4" />अमीर ऊणे खे जादा मईणत नि करनी,</para>
  <para style="q" vid="PRO 23:4">आपणी समजा रा परोसा छाडणा।<note caller="+" style="f"><char style="fr" closed="false">23:4 </char><char style="ft" closed="false">1 तीमुथि 6:9</char></note><verse eid="PRO 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 23:5" />कऊँकि तेरा कमाया दा तन तांते एकी पला दे चली जाणा,</para>
  <para style="q" vid="PRO 23:5">से तांगा गे ते अचाणक ईंयाँ चली जाणा जिंयाँ कोई उकाब पंछी पंख फलाई की ऊबे सर्गो रिया तरफा खे उडी जाओआ।<verse eid="PRO 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 23:6" />केसी कँजूसो रे कअरे जाईकी तेसरा स्वाद खाणा नि खाणा,</para>
  <para style="q" vid="PRO 23:6">ओर तेसरा स्वाद खाणा देखी की तिजी रा लाल़च नि करना;<verse eid="PRO 23:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 23:7" />कऊँकि से आपणे मुंए ते तो बोलोआ की ओर खाई लो, ओर लई लो,</para>
  <para style="q" vid="PRO 23:7">पर से मनो दे सोचोआ, “ओर मत खा” कऊँकि से खाणे रे मोलो रे बारे दे सोचदा रओआ।</para>
  <para style="q" vid="PRO 23:7">से ताखे बोलो तो अया कि खा पी, पर तेसरा मन तां साथे नि ए लगेया रा।<verse eid="PRO 23:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 23:8" />जेबे तुसा खे तेसरिया सोचा रे बारे दे पता चलणा तो तुसा खाया दा ग्रा बी उगल़ी देणा,</para>
  <para style="q" vid="PRO 23:8">ओर तुसा आपणियां मीठिया गल्ला रा फल खोई देणा।<verse eid="PRO 23:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 23:9" />मूर्खो सामणे नि बोलणा,</para>
  <para style="q" vid="PRO 23:9">नई तो तेस तेरी बुद्धिया रिया गल्ला रा आदर नि करना।<verse eid="PRO 23:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 23:10" />दूजेया री जमीन आपणे कब्जे रे करने खे पुराणिया सिऊँआ नि बढ़ाणिया, ओर ना ई अनाथा रे डोरूआ खे लणा,<verse eid="PRO 23:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 23:11" />कऊँकि तिना खे छुड़ाणे वाल़ा यहोवा सामर्थी ए;</para>
  <para style="q" vid="PRO 23:11">तिना रा मकद्दमा तां साथे तेस ई लड़ना।<verse eid="PRO 23:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 23:12" />आपणे सखाणे वाल़े रिया शिक्षा पाँदे त्यान दे,</para>
  <para style="q" vid="PRO 23:12">ओर तेसरिया सिखाईया दिया बुद्धिया रिया गल्ला खे सिखणे री कोशिश कर।<verse eid="PRO 23:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 23:13" />बच्चेया खे सुदारने रिया तँईं तिना खे थिड़कदे रणा,</para>
  <para style="q" vid="PRO 23:13">कऊँकि जे तूँ तेसखे डण्डे साथे बाएगा तो से नि मरना बल्कि तां से बुराईया ते बचाणा।<verse eid="PRO 23:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 23:14" />तां तेसरे डण्डा बायी की तेसरे प्राण नाश ऊणे ते बचाणे।<verse eid="PRO 23:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 23:15" />ओ मेरे पाऊआ,</para>
  <para style="q" vid="PRO 23:15">जे तूँ अक्लमंद ओ, तो खास करी की मेरा ई मन खुश ऊणा।<verse eid="PRO 23:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 23:16" />जेबे तूँ सीदिया गल्ला बोलेगा, तो मेरा ई मन खुश ऊणा।<verse eid="PRO 23:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 23:17" />तूँ पापिया रे बारे मनो रे ईर्ष्या नि करना,</para>
  <para style="q" vid="PRO 23:17">पूरा दिन यहोवे रा डर मानदे रणा।<verse eid="PRO 23:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 23:18" />जे तू एड़ा करेगा तो बादो ते ताखे खुशी मिलणी, ओर परमेशरो तेरी सारिया इच्छा पुरिया करनिया।<verse eid="PRO 23:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 23:19" />सुण, ओ मेरे पाऊ, समजदार बण,</para>
  <para style="q" vid="PRO 23:19">ओर तां केड़ा जीवन जीऊणा एतेरे बारे दे सोच-विचार कर।<verse eid="PRO 23:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 23:20" />शराब पीणे वाल़ेया साथे नि बैठणा,</para>
  <para style="q" vid="PRO 23:20">ओर ना ई जादा मास खाणे वाल़ेया साथे रणा।<verse eid="PRO 23:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 23:21" />कऊँकि शराबी ओर पेटू माणूं आपणा ई पाअग खोए,</para>
  <para style="q" vid="PRO 23:21">ओर सेयो गरीब ऊणे ओर तिना खे चिथड़े ई पईनणे पड़ने।<verse eid="PRO 23:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 23:22" />आपणे बाओ री गल्ल मानणी,</para>
  <para style="q" vid="PRO 23:22">ओर जेबे तेरी माये स्याणी ऊई जाओ, तेबे बी से नक्कमी नि जाणनी।<verse eid="PRO 23:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 23:23" />बुद्धिया रिया गल्ला खे सिखणे री कोशिश कर,</para>
  <para style="q" vid="PRO 23:23">ओर खरी शिक्षा ओर समजा खे आसिल कर ओर तिना खे कदी नि खोया।<verse eid="PRO 23:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 23:24" />तर्मी पाऊए रे माये-बाओ बऊत खुश रओए;</para>
  <para style="q" vid="PRO 23:24">सेओ आपणे अक्लमंद पाऊए पाँदे कमण्ड करी सकोए।<verse eid="PRO 23:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 23:25" />कुछ एड़ा कर की तेरे माये-बाओ खुश रओ,<verse eid="PRO 23:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 23:26" />ओ मेरे पाऊ, आपणा मन मेरी तरफा खे लगा,</para>
  <para style="q" vid="PRO 23:26">ओर तेरी नजर मेरे चाल-चलणो पाँदे लगी री रओ।<verse eid="PRO 23:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 23:27" />कऊँकि वेश्या ओर बगानी जवाणसा खड्डे ओर कुएँ जेड़िया ठईरोईया;</para>
  <para style="q" vid="PRO 23:27">इदे तुसे गिरी सकोए।<verse eid="PRO 23:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 23:28" />से डाकूए जेड़ी ताका रे रओई,</para>
  <para style="q" vid="PRO 23:28">ओर बऊत सारे माणूं तेसा रिया बजा ते आपणियां लाड़िया खे तोखा देओए।<verse eid="PRO 23:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 23:29" />कुण बोलोआ, हाय? कुण बोलोआ, हाय, हाय? कुण लड़ाई-चगड़े रे फसोआ?</para>
  <para style="q" vid="PRO 23:29">कुण बक-बक करोआ? केसरे बिना बजा ते जख़्म ओए? केसरिया आखी लाल ऊई जाओईया?<verse eid="PRO 23:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 23:30" />ये तिना रिया जो देरा तक अंगूरा रा रस पींदे रओए,</para>
  <para style="q" vid="PRO 23:30">ओर जो मसाला मिलेया रा अंगूरा रा रस टोल़ने खे ओरे-पोरे जाओए।<verse eid="PRO 23:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 23:31" />जेबे शराब लाल दिशोई ओर कटोरे दे तिजी रा सुन्दर रंग ओआ,</para>
  <para style="q" vid="PRO 23:31">ओर जेबे तिजी री सीदी ताअर लगाई की ग्लासो दे लटोए, तेबे से नि देखणी।<note caller="+" style="f"><char style="fr" closed="false">23:31 </char><char style="ft" closed="false">इफिसि 5:18</char></note><verse eid="PRO 23:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 23:32" />कऊँकि बादो ते से सापो जेड़ा डसोई,</para>
  <para style="q" vid="PRO 23:32">ओर करैत सापो जेड़ा कटोई।<verse eid="PRO 23:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 23:33" />कऊँकि अंगूरा रा रस पीणे ते बाद तां नऊखिया चीजा देखणियां,</para>
  <para style="q" vid="PRO 23:33">ओर उल्टी सीदिया गल्ला बकदे रणा।<verse eid="PRO 23:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 23:34" />तूँ समुद्रो बीचे लेटणे वाल़ा,</para>
  <para style="q" vid="PRO 23:34">ओर मस्तूलो रे सिरे पाँदे सऊणे वाल़े जेड़ा रणा।<verse eid="PRO 23:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 23:35" />तां बोलणा कि मैं मार तो खाई, पर दु:खी नि ऊआ;</para>
  <para style="q" vid="PRO 23:35">आऊँ कूटेया तो अया, पर माखे कोई ओश नि थी।</para>
  <para style="q" vid="PRO 23:35">आऊँ ओशा रे कदी आऊँ? मां तो फेर शराब टोल़नी।<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 24:1" />बुरेया लोका रे बारे ईर्ष्या नि करनी,</para>
  <para style="q" vid="PRO 24:1">ओर ना ई तिना री संगतिया री इच्छा राखणी;<verse eid="PRO 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 24:2" />कऊँकि सेयो लड़ाई-चगड़ेया रे बारे सोचदे रओए,</para>
  <para style="q" vid="PRO 24:2">ओर हर बखत सेओ आपणियां गल्ला ते दूजेया खे बुरिया ई गल्ला बोलदे रओए।<verse eid="PRO 24:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 24:3" />कअर बुद्धिया ते बणोआ ओर से समजा रे जरिये स्थिर रओआ।<verse eid="PRO 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 24:4" />ज्ञानो रे जरिये कोठरिया सब प्रकारा रे कीमती</para>
  <para style="q" vid="PRO 24:4">ओर मनो खे अच्छे लगणे वाल़ी चीजा ते परी जाओईया।<verse eid="PRO 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 24:5" />अक्लमंद माणूं तागतबर बी ओआ,</para>
  <para style="q" vid="PRO 24:5">ओर ज्ञानी जादा शक्तिशाली ओआ।<verse eid="PRO 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 24:6" />इजी री खातर जेबे तूँ युद्ध करे, तेबे योजना साथे करेया,</para>
  <para style="q" vid="PRO 24:6">जीत बऊत सारे मन्त्रिया रिया बजा ते मिलोई।<verse eid="PRO 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 24:7" />मूर्ख माणूंए खे बुद्धिया रिया गल्ला तेसरिया समजा ते बारे ओईया।</para>
  <para style="q" vid="PRO 24:7">से सबा बीचे आपणा मूँ नि खोली सगदा<verse eid="PRO 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 24:8" />जो माणूं सोची समजी की बुराई करोआ,</para>
  <para style="q" vid="PRO 24:8">तेसखे लोक दुष्ट ई बोलोए।<verse eid="PRO 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 24:9" />मूर्खता रिया गल्ला खे सोचणा बी पाप ए,</para>
  <para style="q" vid="PRO 24:9">ओर मजाक उडाणे वाल़े माणूंए ते लोक नफरत करोए।<verse eid="PRO 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 24:10" />जे तूँ विपत्तिया रे बखते याओ छाडी दे,</para>
  <para style="q" vid="PRO 24:10">तो तांदे तागत बऊत कम ए।<verse eid="PRO 24:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 24:11" />जो बिना मतलबो ते मारने खे कसीटे जाओए,</para>
  <para style="q" vid="PRO 24:11">तिना खे बचाणे खे पीछे नि हट।<verse eid="PRO 24:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 24:12" />जे तूँ बोले कि देख, आऊँ एसखे नि जाणूं था,</para>
  <para style="q" vid="PRO 24:12">तो क्या मनो खे परखणे वाल़ा इजी खे नि जाणदा?</para>
  <para style="q" vid="PRO 24:12">क्या तेरे प्राणो री रक्षा करने वाल़ा इजी खे नि जाणदा?</para>
  <para style="q" vid="PRO 24:12">क्या तेस हर माणूंए खे तेसरे कामो रा फल नि देणा?<note caller="+" style="f"><char style="fr" closed="false">24:12 </char><char style="ft" closed="false">मत्ती 16:27, रोमी 2:6, प्रकाशित 2:23, प्रकाशित 22:12</char></note><verse eid="PRO 24:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 24:13" />ओ मेरे पाऊ तूँ सईत खा, कऊँकि से ताखे अच्छा ए,</para>
  <para style="q" vid="PRO 24:13">कऊँकि से ताखे खाणे दे बऊत मीठा लगणा।<verse eid="PRO 24:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 24:14" />ईंयाँ ई बुद्धि बी ताखे मीठी लगणी,</para>
  <para style="q" vid="PRO 24:14">जे ताखे से मिली जाओ तो अन्तो रे तिजी रा फल बी मिलणा ओर तेरी उम्मीद नि टूटणी।<verse eid="PRO 24:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 24:15" />ओ दुष्ट माणूं, तूँ तर्मी माणूंए रा कअर नाश करने रिया ताका रे नि बैठ;</para>
  <para style="q" vid="PRO 24:15">ओर तेसरे राम करने री जगा खे नि ज्वाड़;<verse eid="PRO 24:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 24:16" />कऊँकि तार्मिक माणूं विपत्तिया दे सात बार पड़ोगा तो से फेर खड़ा ऊई जाओआ,</para>
  <para style="q" vid="PRO 24:16">पर दुष्ट लोक विपत्तिया रेई पड़े रे रओए।<verse eid="PRO 24:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 24:17" />जेबे तेरा दुश्मण ठोकर लगी की रूड़ी जाओ, तेबे तैं खुश नि ऊणा,</para>
  <para style="q" vid="PRO 24:17">ओर जेबे से ठोकर खाओ, तेबे बी तैं खुश नि ऊणा।<verse eid="PRO 24:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 24:18" />केथी एड़ा नि ओ कि यहोवा ताखे एड़ा करदे ऊए देखी की उदास ओ</para>
  <para style="q" vid="PRO 24:18">ओर आपणा गुस्सा तेरेया दुश्मणा पाँदा ते टाई देओ।<verse eid="PRO 24:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 24:19" />बुरे काम करने वाल़ेया ते नि कुढ़,</para>
  <para style="q" vid="PRO 24:19">दुष्ट लोका रिया बजा ते ईर्ष्या नि कर;<verse eid="PRO 24:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 24:20" />कऊँकि बुरेया माणूंआ साथे कुछ बी खरा नि ऊँदा,</para>
  <para style="q" vid="PRO 24:20">सेओ एक दिऊए जेड़े चट ई बिजी जाणे।<verse eid="PRO 24:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 24:21" />ओ मेरे बच्चेयो, यहोवा ओर राजा दुँईं रा आदर करना,</para>
  <para style="q" vid="PRO 24:21">ओर तिना रे खलाफ बगावत करने वाल़ेया साथे नि जाणा,<note caller="+" style="f"><char style="fr" closed="false">24:21 </char><char style="ft" closed="false">1 पत 2:17</char></note><verse eid="PRO 24:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 24:22" />कऊँकि तिना पाँदे अचाणक आफ्त आऊणी,</para>
  <para style="q" vid="PRO 24:22">ओर दुँईं रिया तरफा ते आऊणे वाल़ी आफ़्ता खे कुण जाणोआ?<verse eid="PRO 24:22" /></para>
  <para style="s">अक्लमंदा रिया ओर बी गल्ला</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />अक्लमंदा रिया गल्ला यो बी आ।</para>
  <para style="q" vid="PRO 24:23">न्याय करदे ऊए केसी रा बी पक्षपात करना, किंयाँ बी अच्छा नि ए।<verse eid="PRO 24:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 24:24" />जो न्याय करने वाल़ा दुष्टो खे बोलोआ कि तूँ बेकसुर आ,</para>
  <para style="q" vid="PRO 24:24">तेसखे प्रजा रे लोक स्राप देओए, ओर जातिया-जातिया रे लोक तेसते घृणा करोए;<verse eid="PRO 24:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 24:25" />पर जो न्यायी दुष्टो खे सजा देओए, तिना रा पला ओआ,</para>
  <para style="q" vid="PRO 24:25">ओर खरे ते खरा आशीर्वाद तिना पाँदे आओआ।<verse eid="PRO 24:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 24:26" />जो सच्चा माणूं ओआ से सिदा सीदा जबाव देओआ।<verse eid="PRO 24:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 24:27" />पईले आपणा बारला काम पूरा करना,</para>
  <para style="q" vid="PRO 24:27">ओर डोरू बी त्यार करी लणा, तिजी ते बाद आपणा कअर बनाणा।<verse eid="PRO 24:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 24:28" />बिना बजा ते आपणे पड़ोसिये रे खलाफ गवाई नि देणी,</para>
  <para style="q" vid="PRO 24:28">ओर ना से बईकेरना।<verse eid="PRO 24:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 24:29" />एड़ा नि बोलणा कि जेड़ा तिने मां साथे कित्तेया, तेड़ा ई मां बी तेस साथे करना,</para>
  <para style="q" vid="PRO 24:29">ओर तेसखे तेसरे कित्ते री सजा देणी।<verse eid="PRO 24:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 24:30" />आऊँ एक दिन आल़सिये रे डोरूए रिये ऊई की</para>
  <para style="q" vid="PRO 24:30">ओर मूर्ख माणूंए रे अंगूरा रे बगीचे रिये ऊई की गया,<verse eid="PRO 24:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 24:31" />तो मैं क्या देखेया कि तिना रे डोरुए दे कांडेया रे जाड़ जमीं गे रे;</para>
  <para style="q" vid="PRO 24:31">ओर से जमीन चींयाँ साथे टखी गी री ओर तिजी री पात्थरा री दवाल टल़ीगी री।<verse eid="PRO 24:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 24:32" />तेबे मैं ये सब देखी कि त्यानो रे सोचेया;</para>
  <para style="q" vid="PRO 24:32">तो माखे तेस देखी की ये शिक्षा मिली।<verse eid="PRO 24:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 24:33" />एक ओर छोटी जी नींज, एक ओर टमका,</para>
  <para style="q" vid="PRO 24:33">थोड़ी जी देर छातिया पाँदे आथ राखी की लेटे रे रणा,<verse eid="PRO 24:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 24:34" />तो जिंयाँ एक डाकु अमला करी की सब कुछ लूटी लओआ,</para>
  <para style="q" vid="PRO 24:34">ठीक तिंयाँ ई तां पाँदे अचाणक गरीबी आई जाणी।<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s">सुलैमानो रिया ओर बी ज्ञानो रिया गल्ला</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />एती सुलैमानो री नसीअत ओर बी ए;</para>
  <para style="q" vid="PRO 25:1">जो यहूदा प्रदेशो रे राजा हिजकिय्याह रे माणूंए नकल कित्ती थी<verse eid="PRO 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 25:2" />परमेशरो रा आदर, गल्ला खे गुप्त राखणे रे जरिये ओई,</para>
  <para style="q" vid="PRO 25:2">पर राजे रा आदर गुप्त गल्ल रा पता लगाणे ते ओई।<verse eid="PRO 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 25:3" />जिंयाँ स्वर्गो री ऊचाई ओर तरतिया री गईराई नापी नि सकदे,</para>
  <para style="q" vid="PRO 25:3">तिंयाँ ई राजे रे मनो खे कोई नि जाणी सकदा कि तेसरे मनो दे क्या ए।<verse eid="PRO 25:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 25:4" />चाँदिए रा मैल दूर करी की सन्यार तेतेखे शुद्ध चाँदी बणाई देओआ,</para>
  <para style="q" vid="PRO 25:4">ओर से तेसखे कामो री चीज बणी जाओई।<verse eid="PRO 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 25:5" />तिंयाँ ई जे राजे रे सामणे ते तेसरे दुष्ट सलाहकारो खे बारे निकयाल़ी देओ तो तेसरी गद्दी तर्मो रिया बजा ते बणी री रणी।<verse eid="PRO 25:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 25:6" />जेबे तुसे एकी राजे रे सामणे खड़े ऊई जाओए, तो आपणी तारीफ आपू नि करनी,</para>
  <para style="q" vid="PRO 25:6">ओर जेती बड़ेया लोका खे बैठणे री जगा ए तेती नि बैठणा;<verse eid="PRO 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 25:7" />कऊँकि बड़ेया लोका रे सामणे तेरी बेज्जती नि ओ,</para>
  <para style="q" vid="PRO 25:7">बल्कि ताखे सेयो आपू बोलो कि आगे आओ ओर एती बैठ।<note caller="+" style="f"><char style="fr" closed="false">25:7 </char><char style="ft" closed="false">लुका 14:10-11</char></note><verse eid="PRO 25:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 25:8" />जो कुछ तैं देखी राखेया, तेतेरे बारे दे चट कचैरिया दे नि जा,</para>
  <para style="q" vid="PRO 25:8">नई तो बादो ते जेबे तेरा पड़ोसी ताखे बोलो की ये तो बेकसूर आ तेबे तूँ कुछ नि करी सकदा।<verse eid="PRO 25:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 25:9" />आपणे पड़ोसिये साथे बईस कल्ले जे करनी,</para>
  <para style="q" vid="PRO 25:9">ओर बगाने रा पेत नि खोलणा;<verse eid="PRO 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 25:10" />एड़ा नि ओ कि सुणने वाल़ा तेरी बी बेज्जती करो,</para>
  <para style="q" vid="PRO 25:10">ओर तेरिया गल्ला रा पतंगड़ बणाई देओ।<verse eid="PRO 25:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 25:11" />जिंयाँ चाँदिए री टोकरिया दे सूईने रे सेऊ ओए,</para>
  <para style="q" vid="PRO 25:11">तिंयाँ ई ठीक बखतो पाँदे बोली री गल्ल ओई।<verse eid="PRO 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 25:12" />अक्लमंदो री सई सला खे सुणने रिया तँईं त्यार रणा,</para>
  <para style="q" vid="PRO 25:12">सूईने रे मैंगे गणेया ते जादा मैंगा ओआ।<verse eid="PRO 25:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 25:13" />एक परोसे वाल़ा दूत आपणे मालको रे मनो खे नवां करोआ,</para>
  <para style="q" vid="PRO 25:13">जिंयाँ फसल बाडणे रे बखते गर्मिया दे ठण्डा पाणी जिऊए खे चट ठण्डा करोआ।<verse eid="PRO 25:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 25:14" />जो माणूं चूठो-मूठो खे दान देणे री बडयाई करोआ पर दान नि देंदा,</para>
  <para style="q" vid="PRO 25:14">से तेसा अवा ओर बादल़ो जेड़ा ए जो गड़गड़ाओ तो अए पर बरसदे नि।<verse eid="PRO 25:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 25:15" />सब्र राखणे ते शासक मनाया जाओआ,</para>
  <para style="q" vid="PRO 25:15">ओर अच्छा वचन आड्डिया खे बी तोड़ी देओआ।<verse eid="PRO 25:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 25:16" />जे ताखे सईत खाणा ऊगा तो तिथणा ई खाया जितणा तूँ खाई सके,</para>
  <para style="q" vid="PRO 25:16">एड़ा नि कि जादा खाई की तिजी खे उगल़ी दे।<verse eid="PRO 25:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 25:17" />आपणे पड़ोसिये रे कअरे बार-बार नि जाणा,</para>
  <para style="q" vid="PRO 25:17">एड़ा नि ओ कि से तांते परेशान ऊई की नफरत करने लगो।<verse eid="PRO 25:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 25:18" />जो केसी रे खलाफ चूठी गवाई देओआ,</para>
  <para style="q" vid="PRO 25:18">से मानो थोअड़ा, तलवार ओर पैना तीर ए।<verse eid="PRO 25:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 25:19" />मुसीबता रे बखते विश्वासघातिये पाँदे परोसा करना,</para>
  <para style="q" vid="PRO 25:19">टूटे रे दाँद या काईल पैरा जेड़ा ए।<verse eid="PRO 25:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 25:20" />जेस माणूंए रा मन दु:खी आ तेसरे सामणे गाणे गाणा तेड़ा ए,</para>
  <para style="q" vid="PRO 25:20">जिंयाँ ठण्डी रे केसी रे टाल्ले खोलणा या जख़्मा पाँदे सिरका पाणा,<verse eid="PRO 25:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 25:21" />जे तेरा बैरी पूखा ओ तो तेसखे रोटी खुलाणी;</para>
  <para style="q" vid="PRO 25:21">ओर जे से त्याया ओ तो तेसखे पाणी पल़्याणा;<verse eid="PRO 25:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 25:22" />ईंयाँ तां तेस साथे आपणे एस बर्ताव ते से शर्मिंदा करी देणा,</para>
  <para style="q" vid="PRO 25:22">ओर यहोवे ताखे इजी रा फल देणा।<note caller="+" style="f"><char style="fr" closed="false">25:22 </char><char style="ft" closed="false">मत्ती 5:44, रोमी 12:20</char></note><verse eid="PRO 25:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 25:23" />जिंयाँ उत्तरो ते चलणे वाल़ी अवा बर्खा ल्याओई,</para>
  <para style="q" vid="PRO 25:23">तिंयाँ ई चुगली करने ते मुंए पाँदे गुस्सा छाई जाओआ।<verse eid="PRO 25:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 25:24" />लाम्बे चौड़े कअरो रे चगड़ा करने वाल़ी लाड़िया साथे रणे ते छतो रे कूणे रे रणा खरा ए।<verse eid="PRO 25:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 25:25" />जिंयाँ थके रे प्राणो खे ठण्डा पाणी ओआ,</para>
  <para style="q" vid="PRO 25:25">तिंयाँ ई दूर देशो ते आया रा शुभ समाचार बी ओआ।<verse eid="PRO 25:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 25:26" />जो तर्मी माणूं दुष्टो रे कईणे पाँदे आओआ,</para>
  <para style="q" vid="PRO 25:26">से गंदे पाणिए री सूबल़ ओर बिगड़े रे कूँएं जेड़ा ए।<verse eid="PRO 25:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 25:27" />जादा सयीत खाणा ठीक नि ए, पर कठण गल्ला री पूछताछ महिमा री बजा ओई।<verse eid="PRO 25:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 25:28" />जेस माणूंए री आत्मा आपणे वशो रे नि ए से एड़े शईरो जेड़ा ए जेतेरी दवाल अमला करी की तोड़ी ती री ओ।<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 26:1" />जिंयाँ तऊँदिया रे बर्फा रा ओर बडाईया रे बखते बर्खा रा पड़ना ओआ,</para>
  <para style="q" vid="PRO 26:1">तिंयाँ ई मूर्खो री महिमा बी ठीक नि ऊँदी।<verse eid="PRO 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 26:2" />जिंयाँ पंछी उडदे-उडदे नि बैठदे,</para>
  <para style="q" vid="PRO 26:2">तो तिंयाँ ई बिना मतलबो ते दित्तेया रा स्राप नि पड़दा।<verse eid="PRO 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 26:3" />जिंयाँ कोड़े खे लगाम, ओर गह्दे खे डण्डा बाणा जरूरी ओआ,</para>
  <para style="q" vid="PRO 26:3">तिंयाँ ई मूर्खा रिया पीठी खे डण्डा ए।<verse eid="PRO 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 26:4" />मूर्खो खे तेसरी मूर्खता रिया गल्ला रा जबाव नि देणा, एड़ा नि ओ कि तूँ बी तेस जेड़ा ठईरे।<verse eid="PRO 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 26:5" />मूर्खो खे तेसरी मूर्खता रे मुताबिक जबाव देणा,</para>
  <para style="q" vid="PRO 26:5">नई तो से आपणियां नजरा दे अक्लमंद बणी जाणा।<verse eid="PRO 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 26:6" />जो मूर्खो रे आथो ते सन्देसा पेजोआ,</para>
  <para style="q" vid="PRO 26:6">से मानो आपणे पैरा पाँदे क्वाड़ी बाओआ ओर जईर पियोआ।<verse eid="PRO 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 26:7" />जिंयाँ एक लंगड़ा माणूं आपणे पैरा रा साअरा नि लई सकदा,</para>
  <para style="q" vid="PRO 26:7">तिंयाँ ई मूर्ख माणूंए खे समजा रिया गल्ला बोलणा बेकार ए।<verse eid="PRO 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 26:8" />जिंयाँ पात्थरा रे टेरा रे मणिया री थैली ओई,</para>
  <para style="q" vid="PRO 26:8">तिंयाँ ई मूर्खो खे बी महिमा देणी ओई।<verse eid="PRO 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 26:9" />जिंयाँ शराबिये रे आथो रे कांडा चूबोआ,</para>
  <para style="q" vid="PRO 26:9">तिंयाँ ई मूर्ख माणूंए रा बोलेया रा समजा री गल्ल दु:ख देणे वाल़ा ओआ।<verse eid="PRO 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 26:10" />जिंयाँ कोई तीर चलाणे वाल़ा तीर बिना मतलबो ते सबी खे बाओआ,</para>
  <para style="q" vid="PRO 26:10">तिंयाँ ई मूर्खा खे या यात्रिया खे मजदूरिया पाँदे लगाणे वाल़ा बी ओआ।<verse eid="PRO 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 26:11" />जिंयाँ कुत्ता आपणी‌ उल्टिया खे चाटोआ,</para>
  <para style="q" vid="PRO 26:11">तिंयाँ ई मूर्ख माणूं आपणी मूर्खता रिया गल्ला खे बार-बार बोलोआ।<note caller="+" style="f"><char style="fr" closed="false">26:11 </char><char style="ft" closed="false">2 पत 2:20-22</char></note><verse eid="PRO 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 26:12" />जे तूँ एड़ा माणूं देखे जो आपणी नजरा रे अक्लमंद बणोआ,</para>
  <para style="q" vid="PRO 26:12">तो तेसते जादा उम्मीद मूर्ख माणूंए तेई ए।<verse eid="PRO 26:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 26:13" />आल़सी माणूं आपणे कअरे ई रओए ओर कुछ नि करदे, ओर बोलोए, “माखे लगोआ की बारे आँगणो दे शेर ए!”<verse eid="PRO 26:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 26:14" />जिंयाँ फल़े आपणियां चूल़ा पाँदे कूमोए,</para>
  <para style="q" vid="PRO 26:14">तिंयाँ ई आल़सी आपणे माँजे पाँदे बदलदा रओआ।<verse eid="PRO 26:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 26:15" />आल़सी आपणा आथ थाल़िया रे तो पाओआ,</para>
  <para style="q" vid="PRO 26:15">पर आल़सो रिया बजा ते ग्रा मुंए तक नि चकदा।<verse eid="PRO 26:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 26:16" />समजदारिया ते ज्वाब देणे वाल़े साता माणूंआ बिचा ते बी,</para>
  <para style="q" vid="PRO 26:16">आल़सी आपणे आपू खे अक्लमंद समजोआ।<verse eid="PRO 26:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 26:17" />जो माणूं बाटा रे चलदे ऊए ओरी लोका रे चगड़ेया रे गट्टी अड़ाओआ,</para>
  <para style="q" vid="PRO 26:17">से तेस माणूंए जेड़ा ए, जो कुत्तेया खे कानो ते पकड़ोआ।<verse eid="PRO 26:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 26:18" />जेड़ा एक इस्साल माणूं लोका पाँदे बल़े रे लकड़ू ओर मौता रे तीर सेटोआ,<verse eid="PRO 26:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 26:19" />तेड़ा ई से बी ओआ जो आपणे पड़ोसिये खे तोखा देई की बोलोआ,</para>
  <para style="q" vid="PRO 26:19">“आऊँ तो मजाक करुँ था।”<verse eid="PRO 26:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 26:20" />जिंयाँ लकड़ू नि ऊणे ते आग बीजी जाओई,</para>
  <para style="q" vid="PRO 26:20">तिंयाँ ई जेती चूगली करने वाल़ा नि ए तेती चगड़ा खत्म ऊई जाओआ।<verse eid="PRO 26:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 26:21" />जिंयाँ जल़दे फेऊआ पाँदे लकड़ुआ रे कोईले पाई की आग जल़दी रओई,</para>
  <para style="q" vid="PRO 26:21">तिंयाँ ई चगड़ा बढ़ाणे खे चगड़ालू माणूं चगड़ा करदे रओए।<verse eid="PRO 26:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 26:22" />चूगली करने वाल़े रिया गल्ला, स्वाद खाणे जेड़े पीतरे उतरी जाओईया।<verse eid="PRO 26:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 26:23" />जिंयाँ कोई चाँदिए रा पाणी चढ़ाए रा माट्टिया रा पांडा ओआ,</para>
  <para style="q" vid="PRO 26:23">तिंयाँ ई बुरे मन वाल़े रिया गल्ला ओईया।<verse eid="PRO 26:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 26:24" />जो बैरी गल्ला ते तो आपू खे शरीफ बणाओआ,</para>
  <para style="q" vid="PRO 26:24">पर आपणे पीतरे छल राखोआ,<verse eid="PRO 26:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 26:25" />तेसरी मीठी-मीठी गल्ला पाँदे परोसा नि करना,</para>
  <para style="q" vid="PRO 26:25">कऊँकि तेसरा मन पुरिया तरआ ते कृणा ते परेया रा रओआ।<verse eid="PRO 26:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 26:26" />चाए तेसरा बैर छलो रिया बजा ते छिपी बी जाओ,</para>
  <para style="q" vid="PRO 26:26">तेबे बी तेसरी बुराई लोका बीचे सामणे आई जाओई।<verse eid="PRO 26:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 26:27" />जेस खाता खणना से ई तिदे पड़ना ओर जेस पात्थर सेटणा,</para>
  <para style="q" vid="PRO 26:27">से वापस तेस पाँदे ई पड़ना।<verse eid="PRO 26:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 26:28" />जिने माणूंए कोई दूजा माणूं चूठी गल्ला ते काईल करी राखेया ओ से तेसते बैर राखोआ,</para>
  <para style="q" vid="PRO 26:28">ओर चिकणी चुपड़ी गल्ला बोलणे वाल़ा नाशो री बजा ओआ।<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 27:1" />आऊणे वाल़े दिना रे बारे कमण्ड नि कर,</para>
  <para style="q" vid="PRO 27:1">कऊँकि तूँ नि जाणदा कि पूरे दिनो दे क्या-क्या ऊणा?<note caller="+" style="f"><char style="fr" closed="false">27:1 </char><char style="ft" closed="false">याकूब 4:13,14</char></note><verse eid="PRO 27:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 27:2" />तैं आपणी तारीफ आपू नि करनी; तेरी तारीफ ओर लोक करो तो करो, तैं आपणी सराहना आपू नि करनी;</para>
  <para style="q" vid="PRO 27:2">दूजा ताखे सराओ तो सराओ।<verse eid="PRO 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 27:3" />पात्थर तो पारी ओआ ओर बालूए रे बोज बी ओआ,</para>
  <para style="q" vid="PRO 27:3">पर इना ते बी पारी मूर्खो रा गुस्सा ओआ।<verse eid="PRO 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 27:4" />दूजेया पाँदे गुस्सा करना तो निर्दयिता ए, आसा रा गुस्सा करना कदी-कदी दूजेया खे नाश करी देओआ,</para>
  <para style="q" vid="PRO 27:4">पर केसी साथे जल़न राखणा, तेसते बी जादा निर्दयी ओआ।<verse eid="PRO 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 27:5" />खुली की डांटणा, छिपे रे प्यारो ते खरा ए।<verse eid="PRO 27:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 27:6" />जो दोस्त तुसा खे सई गल्ला सिखाओआ तेस पाँदे तुसे परोसा करी सकोए,</para>
  <para style="q" vid="PRO 27:6">पर एक दुश्मण तुसा साथे चूठा प्यार दखाओआ।<verse eid="PRO 27:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 27:7" />रज्जे दे ऊणे ते सयीतो रा छता बी फीका लगोआ,</para>
  <para style="q" vid="PRO 27:7">पर पूखे खे सब कऊड़िया चीजा बी मीठिया लगोईया।<verse eid="PRO 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 27:8" />आपणा कअर छाडी की कूमणे वाल़ा माणूं, तेसा चिड़िया जेड़ा पटकदा रओआ,</para>
  <para style="q" vid="PRO 27:8">जो आपणा कोअला छाडी की उडदी-फिरदी रओई।<verse eid="PRO 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 27:9" />केसी माणूंए रे शरीरो दे तेल ओर खुशबुदार इत्र लगाणे ते तेसखे अच्छा लगोआ,</para>
  <para style="q" vid="PRO 27:9">पर सच्चे दोस्तो री खरी सला तेसा खुशबूआ ते बी जादा बढ़ी की ए।<verse eid="PRO 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 27:10" />जो तेरा ओर तेरे बाओ रा दोस्त बी ओ, से छाडणा नि;</para>
  <para style="q" vid="PRO 27:10">ओर आपणी मुसीबता रे बखते आपणे पाईए रे कअरे नि जाणा।</para>
  <para style="q" vid="PRO 27:10">प्यार करने वाल़ा पड़ोसी, दूर रणे वाल़े पाईए ते केथी अच्छा ए।<verse eid="PRO 27:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 27:11" />ओ मेरे पाऊ, अक्लमंद ऊई की मेरा मन खुश कर,</para>
  <para style="q" vid="PRO 27:11">तेबे आऊँ तेस माणूंए खे जबाव देई सकूँआ जो तेरिया बजा ते मेरी बेज्जती करोआ।<verse eid="PRO 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 27:12" />अक्लमंद माणूं मुसीबता खे आऊँदा ऊआ देखी की तिजी ते बचणे री कोशिश करोआ,;</para>
  <para style="q" vid="PRO 27:12">पर एक पोल़ा माणूं सिदा तेते ई कनारो खे चलदा जाओआ ओर बादो ते पछताओ आ।<verse eid="PRO 27:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 27:13" />जे तुसे मूर्खता ते एक परदेशिये ते वादा करोए कि आसे तेरे कर्जे खे टाऊँगे,</para>
  <para style="q" vid="PRO 27:13">जे से तेस कर्जे खे नि टाई सको तो तुसे एते जोगे ए कि तुसा री सम्पति तुसा ते लई लो।<verse eid="PRO 27:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 27:14" />जो प्यागा उठी की आपणे पड़ोसिये खे जोरे की आशीर्वाद देओआ,</para>
  <para style="q" vid="PRO 27:14">तो से आशीर्वाद तेस पड़ोसिये खे स्रापो जेड़ा ऊणा।<verse eid="PRO 27:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 27:15" />बरसाती रे बखते पाणिए रा लगातार चुड़ना,</para>
  <para style="q" vid="PRO 27:15">ओर चगड़ा करने वाल़ी लाड़ी दोनो एक जेड़े परेशान करने वाल़े ए।<verse eid="PRO 27:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 27:16" />एड़िया जवाणसा खे एड़े काम करने ते रोकणा इतना मुश्किल ए जितणा अवा खे रोकणा, ओर आपणे आथो रिया मुठिया दे तेलो रा पकड़ना बी इतना ई मुश्किल आ।<verse eid="PRO 27:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 27:17" />जिंयाँ लोआ लोए खे चमकाई देओआ,</para>
  <para style="q" vid="PRO 27:17">तिंयाँ ई माणूंए रा मूँ आपणे दोस्तो री संगतिया साथे चमकदार ऊई जाओआ।<verse eid="PRO 27:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 27:18" />जो दाऊगल़े रे डाल़ो री देख-पाल़ करोआ, से तिजी रा फल खाओआ,</para>
  <para style="q" vid="PRO 27:18">ईंयाँ ई जो आपणे मालको री सेवा करोआ, तेसरी महिमा ओई।<verse eid="PRO 27:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 27:19" />जिंयाँ पाणिए दे मुंए री परछाई मुंए ते मिलोई,</para>
  <para style="q" vid="PRO 27:19">तिंयाँ ई एकी माणूंए रा मन दूजे माणूंए साथे मिलोआ।<verse eid="PRO 27:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 27:20" />जिंयाँ अधलोक ओर विनाशलोक माणूंआ रिया लाशा ते नि रज्जदे,</para>
  <para style="q" vid="PRO 27:20">तिंयाँ ई माणूंए रिया आखी बी इच्छा ते नि रज्जदिया।<verse eid="PRO 27:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 27:21" />जिंयाँ चाँदिए खे परखणे खे पांडे ओर सूईने खे पट्ठी ए,</para>
  <para style="q" vid="PRO 27:21">तिंयाँ ई माणूंए री परख लोका रिया तारीफ करने ते ए।<verse eid="PRO 27:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 27:22" />चाए तूँ मूर्खो खे नज्जो री ऊखल़िया रे पाई की मूल़ो साथे कूटे,</para>
  <para style="q" vid="PRO 27:22">तेबे बी तेसरी मूर्खता नि जाणी।<verse eid="PRO 27:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 27:23" />आपणी पेडा-बाकरिया री दशा ठीक टंगो रे मन लगाई की जाणी लो,</para>
  <para style="q" vid="PRO 27:23">ओर आपणे सबी डांगरा रे चूण्डा री देख-पाल़ ठीक-टंगो रे कर।<verse eid="PRO 27:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 27:24" />कऊँकि कठी कित्ती दी सम्पति ओर राजेया रे राज-पाट सदा बणे रे नि रंदे;</para>
  <para style="q" vid="PRO 27:24">ओर क्या राजमुकुट पीढ़िया ते पीढ़िया तक चलदा रओआ।<verse eid="PRO 27:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 27:25" />एक बार काआ बाडी की डांगरा खे चांगड़ो दे राखी ता दा ए ताकि ठंडी रे बखते से कामे आओ,</para>
  <para style="q" vid="PRO 27:25">तदुए खे से बाडेया दा काआ फेर उगणे लगी जाओआ।<verse eid="PRO 27:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 27:26" />तेबे तुसे पेडा री ऊना ते आपू खे टाल्ले बणाई सकोए,</para>
  <para style="q" vid="PRO 27:26">ओर कुछ बाकरे-बाकरिया खे बेची की तिना पैसेया ते जमीन खरीदी सकोए।<verse eid="PRO 27:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 27:27" />ओर बाकरिया रा इतणा दूद ऊणा कि तां आपणे कराने समेत पेट परी की पिया करना,</para>
  <para style="q" vid="PRO 27:27">ओर तिजी की तेरी नौकराणिया री जिन्दगिया रा बी गुजारा ऊँदा रणा।<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 28:1" />दुष्ट लोक जेबे कोई पीछा नि करदा तेबे बी नठदे ई रओए,</para>
  <para style="q" vid="PRO 28:1">पर तर्मी लोक जवान शेरो जेड़े बिना डरे रओए।<verse eid="PRO 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 28:2" />देशो रे पाप ऊणे रिया बजा ते तेथो रे परदान बदलदे जाओए,</para>
  <para style="q" vid="PRO 28:2">पर समजदार ओर ज्ञानी माणूंए रे जरिए अच्छा प्रबन्द कई दिना तक बणेया रा रणा।<verse eid="PRO 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 28:3" />एक परदान जो गरीब माणूंआ साथे कठोरता रा बर्ताओ करोआ,</para>
  <para style="q" vid="PRO 28:3">से एक एड़े पऊण-चुखाने जेड़ा ए जो फसला खे पुरिया तरआ ते बर्बाद करी देओआ।<verse eid="PRO 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 28:4" />जो लोक परमेशरो री बिधानो खे नि मानदे, सेयो दुष्टो री तारीफ करोए,</para>
  <para style="q" vid="PRO 28:4">पर बिदिया पाँदे चलणे वाल़े लोक दुष्टो रा सामणा करोए।<verse eid="PRO 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 28:5" />बुरे लोक नि जाणदे कि न्याय साथे बर्ताव करने रा क्या मतलब ए,</para>
  <para style="q" vid="PRO 28:5">पर जो लोक यहोवे री पग्ति करोए सेओ इजीखे सई रितिया दे समजोए।<verse eid="PRO 28:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 28:6" />टेडी चाल चलणे वाल़े अमीर माणूंए ते, खराईया साथे चलणे वाल़ा गरीब माणूं खरा ए।<verse eid="PRO 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 28:7" />बिधानो खे मानणे वाल़ा पाऊ समजदार गिणेया जाओआ,</para>
  <para style="q" vid="PRO 28:7">पर उड़ाऊए रा साथी आपणे बाओ रा मूँ काल़ा करोआ।<verse eid="PRO 28:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 28:8" />जो अमीर माणूं ब्याजो पाँदे पैसा देई की आपणा पैसा बढ़ाओआ,</para>
  <para style="q" vid="PRO 28:8">अन्तो दे तेसरा सारा पैसा तेसगे जाणा, जो गरीबा पाँदे दया करोआ।<verse eid="PRO 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 28:9" />जो परमेशरो रे बिधानो ते नफरत करोआ,</para>
  <para style="q" vid="PRO 28:9">परमेशर तिना री प्रार्थना पसन्द नि करदा।<verse eid="PRO 28:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 28:10" />जो माणूं सीदे-सादे लोका खे बईकेरी की बुरिया बाटा रिये लई जाओआ,</para>
  <para style="q" vid="PRO 28:10">से आपणे खणे रे खाते रे आपू ई रूड़ी जाओआ;</para>
  <para style="q" vid="PRO 28:10">पर खरेया लोका रा पला ई ओआ।<verse eid="PRO 28:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 28:11" />अमीर माणूं ये सोचोआ कि आऊँ अक्लमंद ए,</para>
  <para style="q" vid="PRO 28:11">पर समजदार गरीब माणूं तेसरी काबलियत जाणी लओआ कि से अक्लमंद ए कि नि।।<verse eid="PRO 28:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 28:12" />जेबे तर्मी लोक जीतोए, तेबे बड़ी शोभा ओई,</para>
  <para style="q" vid="PRO 28:12">पर जेबे दुष्ट लोक प्रबल ओए, तेबे माणूं आपणे आपू खे लकोए।<verse eid="PRO 28:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 28:13" />जो माणूं आपणे पाप लकोआ, तेसरा काम सफल नि ऊँदा,</para>
  <para style="q" vid="PRO 28:13">पर जो तिना खे मानी लओआ ओर छाडी बी देओआ,</para>
  <para style="q" vid="PRO 28:13">तेस पाँदे दया करी जाणी।<note caller="+" style="f"><char style="fr" closed="false">28:13 </char><char style="ft" closed="false">1 यूह. 1:9</char></note><verse eid="PRO 28:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 28:14" />जो माणूं लगातार यहोवे रा डर मानदा रओआ, से तअन्य ए;</para>
  <para style="q" vid="PRO 28:14">पर जो माणूं आपणा मन काठा करी लओआ, से मुसीबता रे पड़ोआ।<verse eid="PRO 28:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 28:15" />गरीब प्रजा पाँदे राज करने वाल़ा दुष्ट राजा गरजणे वाल़े शेर ओर शकारो रिया तँईं कूमणे वाल़े रीछो जेड़ा ए।<verse eid="PRO 28:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 28:16" />जो परदान समजदार नि ऊँदा, सेई आपणेया लोका पाँदे बऊत अन्देर करोआ,</para>
  <para style="q" vid="PRO 28:16">ओर जो परदान दूजेया खे ठगी कि अमीर नि बणदे तिना री लाम्बी उम्र ओई।<verse eid="PRO 28:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 28:17" />जो कोई माणूं केसी दूजे माणूंए री अत्या करी की नठी रा ओ से पक्का गड्डे रे पड़ना;</para>
  <para style="q" vid="PRO 28:17">ओर तेसखे नि रोको<verse eid="PRO 28:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 28:18" />ईमानदारिया साथे चलणे वाल़े माणूंए खे सब कोई बचाओए,</para>
  <para style="q" vid="PRO 28:18">पर जो टेडी चाल चलोआ से अचाणक रूड़ोआ।<verse eid="PRO 28:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 28:19" />जो आपणी जमीना दे बेजा बाओआ, से पेट परी की रोटी खाओआ,</para>
  <para style="q" vid="PRO 28:19">पर नकम्मे लोक जो बखत बर्बाद करोए, सेओ गरीब ई रओए।<verse eid="PRO 28:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 28:20" />जो माणूं सच्चाईया साथे चलोआ तेस पाँदे बऊत आशीष रओई,</para>
  <para style="q" vid="PRO 28:20">पर जो माणूं अमीर ऊणे रिया तँईं जल्दबाजी करोआ, से पक्का दोषी ठईरना।<verse eid="PRO 28:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 28:21" />केसी माणूंए साथे पक्षपात करना अच्छा नि ऊँदा;</para>
  <para style="q" vid="PRO 28:21">ओर ये बी अच्छा नि ए कि माणूं रोटिया रे एकी टुकड़े रिया तँईं पाप करो।<verse eid="PRO 28:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 28:22" />जो माणूं पैसे रा लाल़च करी की पैसा लणे खे जल्दबाजी करोआ,</para>
  <para style="q" vid="PRO 28:22">पर से ए नि जाणदा कि से कमिया रेई पड़ेया दा रओआ।<verse eid="PRO 28:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 28:23" />जो कोई माणूं केसी दूजे माणूंए खे तेसरिया गल़तिया रिया बजा ते तेसखे बकोआ,</para>
  <para style="q" vid="PRO 28:23">से अन्तो रे चापलूसी करने वाल़े ते जादा प्यारा ऊई जाओआ।<verse eid="PRO 28:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 28:24" />जो पाऊ आपणे माया-बाओ री चोरी करी की बोलोआ कि मैं कोई बुरा काम नि करी राखेया,</para>
  <para style="q" vid="PRO 28:24">से कअर जवाड़ने वाल़े रा साथी ठईरोआ।<verse eid="PRO 28:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 28:25" />लाल़ची माणूं चगड़ा करोआ ओर,</para>
  <para style="q" vid="PRO 28:25">जो यहोवे पाँदे परोसा राखोआ, से तगड़ा ऊई जाओआ।<verse eid="PRO 28:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 28:26" />मूर्ख माणूं सिर्फ आपू पाँदे ई परोसा राखोआ;</para>
  <para style="q" vid="PRO 28:26">ओर जो अक्लमंदिया साथे चलोआ, से आपणे प्राण बचाओआ।<verse eid="PRO 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 28:27" />जो माणूं गरीबा खे दान देओआ, तेसखे केसी बी चीजा री कमी नि ऊँदी,</para>
  <para style="q" vid="PRO 28:27">पर जो गरीब माणूंए खे देखी की आपणी नजर फेरी लओआ,</para>
  <para style="q" vid="PRO 28:27">तेसखे स्रापो पाँदे स्राप मिलोए।<verse eid="PRO 28:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 28:28" />जेबे दुष्ट माणूं प्रबल ओआ, तेबे लोक डरो रे मारे लूकी जाओए,</para>
  <para style="q" vid="PRO 28:28">पर जेबे से नाश ऊई जाओआ, तेबे तर्मी तरक्की करोए।<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 29:1" />जो माणूं बार-बार चतौणी देणे ते बाद पनि मानदा,</para>
  <para style="q" vid="PRO 29:1">से एक दिन अचाणक नाश ऊई जाणा।<verse eid="PRO 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 29:2" />जेबे तर्मी माणूं राज करोए, तेबे प्रजा बऊत खुश ओई,</para>
  <para style="q" vid="PRO 29:2">पर बुरे माणूंए रे राज करने रे बखते प्रजा हाय-हाय बोलोई।<verse eid="PRO 29:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 29:3" />जो माणूं बुद्धिया रिया गल्ला ते प्यार करोआ, से आपणे बाओ खे खुश करोआ,</para>
  <para style="q" vid="PRO 29:3">पर वेश्या री संगति करने वाल़ा पाऊ पैसे खे उडाई देओआ।<note caller="+" style="f"><char style="fr" closed="false">29:3 </char><char style="ft" closed="false">लूक 15:13</char></note><verse eid="PRO 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 29:4" />राजे रे न्याय करने रिया बजा ते तेसरा देश बणेया रा रओआ,</para>
  <para style="q" vid="PRO 29:4">पर जो राजा आपणियां प्रजा खे लूटोआ, से आपणे देशो खे पल़टी देओआ।<verse eid="PRO 29:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 29:5" />जो माणूं केसी ओरी ते चिकणी चुपड़ी गल्ला करोआ, से ओरी खे नि पर सिर्फ आपू खे ई जाल़ लगाओआ।<verse eid="PRO 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 29:6" />बुरा माणूं पाप करने रिया बजा ते फन्दे दे फसोआ,</para>
  <para style="q" vid="PRO 29:6">पर तर्मी माणूं खुश ऊई की जयजयकार करोआ।<verse eid="PRO 29:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 29:7" />एक तर्मी माणूं गरीबा रे अधिकारा खे जाणोआ,</para>
  <para style="q" vid="PRO 29:7">पर बुरे माणूं इना गल्ला खे नि समजदे।<verse eid="PRO 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 29:8" />सबी गल्ला दे मजाक करने वाल़े लोक शईरो खे बी फूकी देओए,</para>
  <para style="q" vid="PRO 29:8">पर अक्लमंद लोक आपणियां गल्ला ते गुस्से खे ठण्डा करी देओए।<verse eid="PRO 29:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 29:9" />जेबे अक्लमंद माणूं मूर्ख माणूंए साथे मकदमा लड़ोआ,</para>
  <para style="q" vid="PRO 29:9">तेबे से मूर्ख मजाक करोआ ओर जोरे की गल़त गल्ला बोली कि बेज्जती करोआ।<verse eid="PRO 29:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 29:10" />अत्यारे लोक खरे माणूंआ ते नफरत करोए,</para>
  <para style="q" vid="PRO 29:10">पर तर्मी लोक खरेया माणूंआ रे प्राणा खे बचाओए।<verse eid="PRO 29:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 29:11" />मूर्ख माणूं गुस्से दे सारे मनो री गल्ल खोली देओआ,</para>
  <para style="q" vid="PRO 29:11">पर अक्लमंद माणूं आपणे मनो खे रोकोआ ओर शान्त रओआ।<verse eid="PRO 29:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 29:12" />जेबे शासक चूठीया गल्ला सुणी की तिना पाँदे परोसा करोआ,</para>
  <para style="q" vid="PRO 29:12">तेबे तेसरे सारे कर्मचारी बी अन्याय करने लगी जाओए।<verse eid="PRO 29:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 29:13" />गरीब ओर अन्देर करने वाल़ा माणूं दोनो एक जेड़े ए;</para>
  <para style="q" vid="PRO 29:13">ओर यहोवे तिना दुँईं खे देखणे खे आखी देई राखिया।<verse eid="PRO 29:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 29:14" />जो राजा गरीब लोका रा न्याय सच्चाईया साथे करोआ, तेसरी गद्दी सदा बणी री रओई।<verse eid="PRO 29:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 29:15" />जेस बच्चे रे माये-बाओ तेसखे डण्डे री बाओए ओर चिड़को ए से ज्ञानी बणी जाओआ,</para>
  <para style="q" vid="PRO 29:15">पर जेस बच्चे खे ईंयाँ ई छाडी देओए, से आपणी माया खे शर्मा री बजा बणोआ।<verse eid="PRO 29:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 29:16" />जेबे बुरे लोक राज करोए तेबे पाप बी बढ़ोए,</para>
  <para style="q" vid="PRO 29:16">पर अन्तो रे तर्मी लोक तिना रा आरना देखी लओए।<verse eid="PRO 29:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 29:17" />आपणे बच्चेया खे सुदार, तेबे तुँ तिना पाँदे कमण्ड करी सकेया,</para>
  <para style="q" vid="PRO 29:17">तेबे तिना रिया बजा ते तुँ कदी बी शर्मिंदा नि ऊणा।<verse eid="PRO 29:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 29:18" />जेते देशो दे लोक परमेशरो रा बिधान नि मानदे, सेयो लोक बर्बाद ऊई जाओए।</para>
  <para style="q" vid="PRO 29:18">पर जो बिधानो खे मानोए तिना खे से आशीष देओआ।<verse eid="PRO 29:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 29:19" />दास गल्ले की नि सुदारेया जांदा, कऊँकि से तेरिया गल्ला खे समजी की पनि मानदा।<verse eid="PRO 29:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 29:20" />क्या तूँ गल्ला करने रे जल्दबाजी करने वाल़े माणूंए खे जाणेया?</para>
  <para style="q" vid="PRO 29:20">तेसते जादा तो मूर्खो ते ई उम्मीद ए।<verse eid="PRO 29:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 29:21" />जो आपणे दासो खे बचपनो तेई आपणे बच्चे जेड़ा पाल़ोआ,</para>
  <para style="q" vid="PRO 29:21">तो से दास बादो ते तेसरिया सम्पत्तिया रा अक्कदार बणी जाणा ओर मालको रा सब कुछ लई लणा।<verse eid="PRO 29:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 29:22" />जो माणूं जादा गुस्सा करने वाल़ा ओआ,</para>
  <para style="q" vid="PRO 29:22">से लड़ाई-चगड़ा करोआ ओर पापी ओआ।<verse eid="PRO 29:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 29:23" />जो माणूं पईले कमण्ड करोआ तेसखे बादो ते नीचा ई देखणा पड़ोआ,</para>
  <para style="q" vid="PRO 29:23">पर नम्र सबाओ वाल़े माणूंए रा सब आदर करोए। <note caller="+" style="f"><char style="fr" closed="false">29:23 </char><char style="ft" closed="false">मत्ती 23:12</char></note><verse eid="PRO 29:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 29:24" />जो चोरो री संगत करोआ, से आपणे प्राणो रा बैरी ओआ,</para>
  <para style="q" vid="PRO 29:24">कसम खाणे ते बाद बी से गल्ल नि बतांदा।<verse eid="PRO 29:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 29:25" />माणूंए रा डर मानणा फन्दा ऊई जाओआ,</para>
  <para style="q" vid="PRO 29:25">पर जो यहोवे पाँदे परोसा राखोआ, तेस लोका बीचे आदर पाणा।<verse eid="PRO 29:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 29:26" />परदानो खे आपणा दोस्त तो बऊत लोक बनाणा चाओए,</para>
  <para style="q" vid="PRO 29:26">पर माणूंआ रा सच्चा न्याय यहोवा ई करोआ।<verse eid="PRO 29:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 29:27" />तर्मी लोक बुरे माणूंआ ते नफरत करोए,</para>
  <para style="q" vid="PRO 29:27">ओर दुष्ट माणूं बी सीदी चाल चलणे वाल़ेया ते नफरत करोआ।<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s">आगूरो रे वचन</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />याके रे पाऊ आगूरो रे असरदार वचन।</para>
  <para style="q" vid="PRO 30:1">तिने माणूंए ईतीएल ओर उक्कालो खे ये बोलेया<verse eid="PRO 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 30:2" />पक्का ई आऊँ डांगरो जेड़ा ए, बल्कि माणूं बोलणे जोगा पनि ए;</para>
  <para style="q" vid="PRO 30:2">ओर माणूंआ री समज मांदे नि ए।<verse eid="PRO 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 30:3" />ना तो माँदे बुद्धि ए ओर ना ई पवित्र परमेशरो रा ज्ञान माखे मिली रा।<verse eid="PRO 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 30:4" />कुण जा माणूं स्वर्गो रे चढ़ी की फेर उतरी की आया?</para>
  <para style="q" vid="PRO 30:4">किने माणूंए अवा आपणे मुठुए रे बंद करी राखी?</para>
  <para style="q" vid="PRO 30:4">किने माणूंए महासागर आपणे टाल्लेया रे बानी राखेया?</para>
  <para style="q" vid="PRO 30:4">तरतिया रे बन्ने किने माणूंए ठराई राखे? तेसरा नाओं क्या ए?</para>
  <para style="q" vid="PRO 30:4">ओर तेसरे पाऊए रा नाओं क्या ए? जे तूँ जाणेया तो माखे बी बताणा!<note caller="+" style="f"><char style="fr" closed="false">30:4 </char><char style="ft" closed="false">यूह. 3:13</char></note><verse eid="PRO 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 30:5" />परमेशरो रा एक-एक वचन परखेया दा ए;</para>
  <para style="q" vid="PRO 30:5">से तिना रा बचाणे वाल़ा ठईरी रा, जो तेसरी शरणा रे आई रे।<verse eid="PRO 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 30:6" />तेसरे वचनो रे कुछ नि बढ़ाणा,</para>
  <para style="q" vid="PRO 30:6">जे तूँ एड़ा करेगा तो तेस ताखे सजा देणी ओर तूँ चूठा ठईरणा।<note caller="+" style="f"><char style="fr" closed="false">30:6 </char><char style="ft" closed="false">बिध. 4:2, 12:32</char></note><verse eid="PRO 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 30:7" />ओ परमेशर, मैं तांते दो वरदान मांगी राखे,</para>
  <para style="q" vid="PRO 30:7">इजी री खातर मेरे मरने ते पईले तिना माखे देणे ते नि मुकर।<verse eid="PRO 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 30:8" />पईला वरदान ये आ कि बेकार ओर चूठिया गल्ला मांते दूर रओ; दूजा वरदान ये आ कि माखे ना तो गरीब कर ओर ना ई अमीर बणा;</para>
  <para style="q" vid="PRO 30:8">हर रोजो री रोटी माखे खुल़ाया कर।<note caller="+" style="f"><char style="fr" closed="false">30:8 </char><char style="ft" closed="false">1 तीमु. 6:8</char></note><verse eid="PRO 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 30:9" />एड़ा नि ओ कि जेबे मेरा पेट परी जाओ, तेबे आऊँ मुकरी की बोलूँ कि यहोवा कुण ए?</para>
  <para style="q" vid="PRO 30:9">या आपणा पाअग रचाई की चोरी करुँ,</para>
  <para style="q" vid="PRO 30:9">ओर आपणे परमेशरो रे नाओं री बेज्जती करुँ।<verse eid="PRO 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 30:10" />केसी रे दासो री तेसरे मालको ते चूगली नि करनी,</para>
  <para style="q" vid="PRO 30:10">एड़ा नि ओ कि से ताखे स्राप देओ ओर तूँ दोषी ठईरे।<verse eid="PRO 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 30:11" />एड़े लोक ए जो आपणे माया-बाओ खे स्राप देओए</para>
  <para style="q" vid="PRO 30:11">ओर आपणी माया खे बुरा-पला बोलोए।<verse eid="PRO 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 30:12" />सेयो एड़े लोक ए जो आपणे आपू खे शुद्ध समजोए,</para>
  <para style="q" vid="PRO 30:12">तेबे बी तिना रे मनो रा पाप तोई नि राखेया।<verse eid="PRO 30:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 30:13" />कुछ लोक बऊत कमण्डी ओए,</para>
  <para style="q" vid="PRO 30:13">सेयो आपू खे तो बऊत खरे पर दूजेया खे बऊत बेकार समजोए।<verse eid="PRO 30:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 30:14" />एड़े लोक बी ए, जिना रे दाँद तलवारा जेड़े ओर दाढ़ा छुरिया जेड़िया ए,</para>
  <para style="q" vid="PRO 30:14">ताकि तिना साथे सेयो शरीफ लोका खे तरतिया पाँदा ते ओर गरीब लोका खे माणूंआ बीचा ते रचाई देओ।<verse eid="PRO 30:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 30:15" />जोका खे सदा खून चुसणे खे चाईयो, ठीक तिंयाँ ई, लाल़ची लोक हमेशा बोलदे रओए, माखे ओर देओ,</para>
  <para style="q" vid="PRO 30:15">तिंयाँ ई चार चीजा ए, जो रज्जदिया नि; तिना खे हमेशा ओर चाईयो।<verse eid="PRO 30:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 30:16" />सेओ चार चीजा ईआ अधलोक ओर बाँज जवाणसा री कोख,</para>
  <para style="q" vid="PRO 30:16">जमीन जो पाणी पी-पी की नि रज्जदी,</para>
  <para style="q" vid="PRO 30:16">ओर आग जो कदी नि बोलदी, “बस।”<verse eid="PRO 30:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 30:17" />जेते आखी साथे कोई आपणे बाओ खे अनादरो रिया नजरा ते देखो,</para>
  <para style="q" vid="PRO 30:17">ओर बेज्जतिया साथे आपणी माया रा कईणा नि मानो,</para>
  <para style="q" vid="PRO 30:17">से आख काअटिया रे कावा नोची-नोची की निकयाल़नी ओर उकाबा रे बच्चेया खाई देणी।<verse eid="PRO 30:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 30:18" />तीन गल्ला माखे बऊत कठण ए,</para>
  <para style="q" vid="PRO 30:18">बल्कि चार ए, जो मेरी समजा ते पोरे ए:<verse eid="PRO 30:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 30:19" />सेओ यो ईआ सर्गो रे उकाब पंछिये री बाट,</para>
  <para style="q" vid="PRO 30:19">सापो रा चट्टानी पाँदे लुरदे ऊए चलणा, समुद्रो रे जाह्जो रा तरना,</para>
  <para style="q" vid="PRO 30:19">ओर बेटिया साथे मर्दो री चाल।<verse eid="PRO 30:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 30:20" />व्याभिचारणिया री चाल बी तेड़ी ईए;</para>
  <para style="q" vid="PRO 30:20">से दूजे मर्दो साथे अनर्थ काम करी कि बोलोई,</para>
  <para style="q" vid="PRO 30:20">“मैं कोई गल़त काम नि कित्तेया।”<verse eid="PRO 30:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 30:21" />संसारो दे चार चीजा ईआ,</para>
  <para style="q" vid="PRO 30:21">जिना खे कोई बी सईन नि करी सकदा<verse eid="PRO 30:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 30:22" />सेओ यो ईआ केसी दासो रा राजा बणना, मूर्खो रा पेट फरना,<verse eid="PRO 30:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 30:23" />गल़त काम करने वाल़िया जवाणसा रा ब्या ऊणा,</para>
  <para style="q" vid="PRO 30:23">ओर दासिया रा आपणी मालकणिया री बारस ऊणा।<verse eid="PRO 30:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 30:24" />तरतिया पाँदे चार छोटे जन्तु ए,</para>
  <para style="q" vid="PRO 30:24">जो बऊत अक्लमंद ए:<verse eid="PRO 30:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 30:25" />मकोड़िया कमजोर तो अए,</para>
  <para style="q" vid="PRO 30:25">पर सेयो तूपा पाँदे आपणे खाणे रिया चीजा कट्ठिया करोईया;<verse eid="PRO 30:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 30:26" />शापान कमजोर जाति ए,</para>
  <para style="q" vid="PRO 30:26">तेबे बी तिना रिया गुफा पाह्ड़ो पाँदे ओईया;<verse eid="PRO 30:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 30:27" />टिड्डिया रा राजा नि ऊँदा,</para>
  <para style="q" vid="PRO 30:27">तेबे बी सेयो चूण्ड बणाई-बणाई की चलोईया;<verse eid="PRO 30:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 30:28" />छिपकलिया<note caller="+" style="f"><char style="fr" closed="false">30:28 </char><char style="ft" closed="false">गल़ाऊ</char></note> खे आथो साथे तो पकड़ोए,</para>
  <para style="q" vid="PRO 30:28">तेबे बी राजे रे मईला रे रओईया।<verse eid="PRO 30:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 30:29" />चार बिना डरे ऊई की चलणे वाल़े जन्तु ए,</para>
  <para style="q" vid="PRO 30:29">जिना री चाल कमण्डो ते परी री ए<verse eid="PRO 30:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 30:30" />शेर जो सबी डांगरा बीचे तागतबर ए,</para>
  <para style="q" vid="PRO 30:30">ओर केसी बी जानवरो ते नि डरदा;<verse eid="PRO 30:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 30:31" />चलदा मूर्गा ओर बाकरा,</para>
  <para style="q" vid="PRO 30:31">ओर आपणी सेना समेत राजा।<verse eid="PRO 30:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 30:32" />जे तैं आपणी तारीफ करने री मूर्खता कित्ती,</para>
  <para style="q" vid="PRO 30:32">या कोई बुरी साजिश सोची राखी ओ, तो आपणा मूँ बन्द कर ओर बचार कर।<verse eid="PRO 30:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 30:33" />कऊँकि जिंयाँ दईंए रे छोल़ने ते नऊणीं ओर नाको खे मरोड़ने ते खून निकल़ोआ,</para>
  <para style="q" vid="PRO 30:33">तिंयाँ ई गुस्सा पड़कणे ते चगड़ा पैदा ओआ।<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s">राजे खे मशवरा</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />मस्सा रे राजा लमूएलो रे असरदार वचन, जो तेसरिये माये तेसखे सिखाए थे।<verse eid="PRO 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 31:2" />तेसरिये माये तेसखे बोलेया, “ओ मेरे पाऊ,</para>
  <para style="q" vid="PRO 31:2">ओ मेरे आपणे पाऊ! ओ मेरी मान्नता रे पाऊ!<verse eid="PRO 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 31:3" />आपणी तागत जवाणसा खे नि देणी,</para>
  <para style="q" vid="PRO 31:3">ओर ना आपणी जिन्दगी तिना रे वशो रे करनी, जो राजेया री मर्दानगी खाई जाओईया।”<verse eid="PRO 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 31:4" />ओ लमूएल, राजेया रा अंगूरा रा रस पीणा तिना खे शोभा नि देंदा,</para>
  <para style="q" vid="PRO 31:4">ओर ना ई तिना खे जादा शराब पीणे री इच्छा राखणी चाईयो।<verse eid="PRO 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 31:5" />एड़ा नि ओ कि सेयो शराब पी की काईदे-कानून ई पूली जाओ,</para>
  <para style="q" vid="PRO 31:5">ओर केसी दु:खिये रे अक्को खे मारो।<verse eid="PRO 31:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 31:6" />तेज अंगूरा रा रस तेसखे पल़्याओ जो मरने वाल़ा ए,</para>
  <para style="q" vid="PRO 31:6">ओर अंगूरा रा रस उदास मनो वाल़ेया खे ई देणा;<verse eid="PRO 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 31:7" />ताकि तिजी खे पी की सेयो आपणी गरीबिया खे पूली जाओ</para>
  <para style="q" vid="PRO 31:7">ओर आपणी मईणत फेर याद नि करो।<verse eid="PRO 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 31:8" />तिना लोका रिया तरफा ते बोल जो आपू खे नि बचाई सकदे,</para>
  <para style="q" vid="PRO 31:8">ओर सबी अनाथा रा न्याय ठीक-टंगो रे करेया कर।<verse eid="PRO 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 31:9" />तिना रिया तँईं बोल ओर एक ईमानदार न्यायी बणी की गरीबा ओर जरूरतमंदा रे अधिकारो री रक्षा कर।<verse eid="PRO 31:9" /></para>
  <para style="s">संस्कारी लाड़ी</para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 31:10" />एक खरी लाड़ी केसखे मिली सकोई?</para>
  <para style="q" vid="PRO 31:10">कऊँकि तेसा री कीमत मूँगेया ते बी केथी जादा ए।<verse eid="PRO 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 31:11" />तेसा रा लाड़ा तेसा पाँदे बऊत परोसा करोआ,</para>
  <para style="q" vid="PRO 31:11">ओर तेसखे किजी बी चीजा री कमी नि ऊँदी।<verse eid="PRO 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 31:12" />से आपणे लाड़े साथे कदी बी बुरा बर्ताव नि करदी,</para>
  <para style="q" vid="PRO 31:12">बल्कि तेसखे अच्छा ई सोचोई।<verse eid="PRO 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 31:13" />से ऊन ओर सण टोल़ी-टोल़ी की ल्याओई,</para>
  <para style="q" vid="PRO 31:13">ओर आपणे आथो साथे खुशिया ते काम करोई।<verse eid="PRO 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 31:14" />से बपारो रे जाह्जो जेड़ी आपणे खाणे रिया चीजा खे दूरा ते मँगवाओई।<verse eid="PRO 31:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 31:15" />से तड़के ई उठी की रोटी बणाओई,</para>
  <para style="q" vid="PRO 31:15">ओर आपणे कअरो वाल़ेया खे खाणा खुल़ाओ ई,</para>
  <para style="q" vid="PRO 31:15">ओर आपणी दासिया खे लग-लग काम देओई।<verse eid="PRO 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 31:16" />से सोची-समजी की डोरूआ खे मोले लओई,</para>
  <para style="q" vid="PRO 31:16">ओर से मईणत करी की तिदे अंगूरा रा बगीचा लगाओई।<verse eid="PRO 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 31:17" />से आपणे लको खे कसी की बानोई,</para>
  <para style="q" vid="PRO 31:17">ओर आपणियां बांयी खे मजबूत बणाओई।<verse eid="PRO 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 31:18" />से परखी लओई कि माखे बपारो दे कदी फाईदा ऊणा।</para>
  <para style="q" vid="PRO 31:18">ओर से राती तक काम करदी रओई।<verse eid="PRO 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 31:19" />से ताऊकल़िया दे आपू ऊन कातोई,</para>
  <para style="q" vid="PRO 31:19">ओर चरखे दे आपू खे टाल्ले बणाओई।<verse eid="PRO 31:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 31:20" />से दिलो ते गरीब ओर जरूरतमंद लोका री मताद करोई।<verse eid="PRO 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 31:21" />से यिऊँदो रे आऊणे ते नि डरदी,</para>
  <para style="q" vid="PRO 31:21">पर से पईले ई आपणे परिवारो खे गर्म टाल्ले बणाई लओई।<verse eid="PRO 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 31:22" />से सरयाणे बणाई लओई,</para>
  <para style="q" vid="PRO 31:22">तेसा रे टाल्ले छोटे सण ओर बैंगणी रंगो रे ओए।<verse eid="PRO 31:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 31:23" />जेबे तेसा रा लाड़ा सभा रे देशो रे बुजुर्गा साथे बैठोआ,</para>
  <para style="q" vid="PRO 31:23">तेबे तेसरी इज्जत ओई।<verse eid="PRO 31:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 31:24" />से सणो रे टाल्ले बणाई की बेचोई,</para>
  <para style="q" vid="PRO 31:24">ओर बपारिया खे लको रा पटका बणाई की बेचोई।<verse eid="PRO 31:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 31:25" />से तागतबर ओर प्रतापो ते परी री ओई,</para>
  <para style="q" vid="PRO 31:25">ओर आऊणे वाल़े बखतो ते नि डरदी।<verse eid="PRO 31:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 31:26" />से हमेशा अक्ला रिया गल्ला बोलोई,</para>
  <para style="q" vid="PRO 31:26">ओर से कृपा ते सबी खे सला देओई।<verse eid="PRO 31:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 31:27" />से आपणे कराने रे चाल-चलणो खे त्यानो रे देखोई,</para>
  <para style="q" vid="PRO 31:27">ओर से कदी बी आल़सीपन नि दखांदी।<verse eid="PRO 31:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 31:28" />तेसा रे माठे उठी-उठी की तेसा खे तअन्य बोलोए,</para>
  <para style="q" vid="PRO 31:28">तेसा रा लाड़ा बी उठी की तेसा री एड़ी तारीफ करोआ,<verse eid="PRO 31:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 31:29" />से तेसा ते बोलोआ, “बऊत सारिये जवाणसे आपणे कअरे अच्छे-अच्छे काम तो कित्ते, पर तूँ तिना सबी ते श्रेष्ठ ए।”<verse eid="PRO 31:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 31:30" />शोभा तो चूठी ओर सुन्दरता बेकार ए,</para>
  <para style="q" vid="PRO 31:30">पर जो जवाणस यहोवे रा डर मानोई, तेसा री तारीफ ऊणी।<verse eid="PRO 31:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 31:31" />एड़िया जवाणसा री इज्जत करनी चाईयो,</para>
  <para style="q" vid="PRO 31:31">ओर तेसा रे कामो री सभा दे तारीफ करनी चाईयो।<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>