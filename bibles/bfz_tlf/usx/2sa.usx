<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2SA" style="id" />
  <para style="h">2 सेमुएल</para>
  <para style="toc1">सेमुएलो री दूजी कताब</para>
  <para style="toc2">2 सेमुएल</para>
  <para style="toc3">2 सेमु.</para>
  <para style="mt">2 सेमुएल</para>
  <para style="mt2">सेमुएलो री दूजी कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">सेमुएलो रिया दूजिया कताबा दे सेमुएलो रिया पईलिया कताबा रा बचेया दा इसा ए। ये राजे रे रूपो दे दाऊदो रे राज्य रे बखतो रा, मतलब पईले दखणा दे यहूदा दे राज करना (पाठ <char style="xt"><ref loc="2SA 1-4">1-4</ref></char>), ओर तेबे उतरो रिया तरफा दे इस्राएलो समेत सबी जातिया रे लोका पाँदे राज (पाठ <char style="xt"><ref loc="2SA 5-24">5-24</ref></char>) करने रा इतिआस ए। ये इजी रे बारे दे बताओआ कि राजा दाऊदो खे आपणे राज्य खे बढ़ाणे खे ओर आपणे राज्य खे मजबूत करने रिया तँईं देशो दे पीतरले ओर बारले दुश्मणा ते किंयाँ लड़ना पड़ेया था। दाऊदो खे परमेशरो पाँदे पक्का परोसा राखणे ओर तेसरी पग्ती करने वाल़े माणूंए रे रूपो दे बताई राखेया, जो आपणे लोका रा परोसा जितणे दे सफल रया। तेसरे बारे दे ये बी बताया जाओआ कि से आपणिया इच्छा खे पूरा करने खे कदी-कदी कठोर बी बणी जाओआ ओर खतरनाक पाप करने खे त्यार बी ऊई जाओआ। पर जेबे परमेशरो रे नबी नातानो रे जरिये तेसरा सामणा आपणे पापो ते ओआ, तो से आपणा पाप मानी लओआ ओर परमेशरो रे जरिये मिली दी सजा खे सईणे खे त्यार रओआ।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">यहूदा प्रदेशो पाँदे दाऊदो रा राज करना <char style="ior"><ref loc="2SA 1:1-4:12">1:1-4:12</ref></char></para>
  <para style="io1">इस्राएलो पाँदे दाऊदो रा राज करना <char style="ior"><ref loc="2SA 5:1-24:25">5:1-24:25</ref></char></para>
  <chapter number="1" style="c" sid="2SA 1" />
  <para style="s">दाऊदो खे शाऊलो री मौता री खबर मिलणा</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 1:1" />इस्राएलो रे राजा शाऊलो रे मरने ते बाद, जेबे दाऊद अमालेकिया खे काई की वापस ऊआ ओर दाऊदो खे सिकलग शईरो दे रंदे ऊए दो दिन ऊईगे, <verse eid="2SA 1:1" /><verse number="2" style="v" sid="2SA 1:2" />तेबे तीजे दिने एड़ा ऊआ कि शाऊलो रे डेरे ते एक माणूं फाड़े रे टाल़े ओर सिरो दे तूड़ पाई की आया। जेबे से दाऊदो गे पऊँचेया, तेबे तिने जमीना दे पड़ी की माथा टेकेया। <verse eid="2SA 1:2" /><verse number="3" style="v" sid="2SA 1:3" />दाऊदे तेसते पूछेया, “तूँ केथा ते आई रा?” तिने तेसखे बोलेया, “आऊँ इस्राएली डेरे ते बची की आई रा।” <verse eid="2SA 1:3" /><verse number="4" style="v" sid="2SA 1:4" />दाऊदे तेसते पूछेया, “युद्धो दे क्या ऊआ मांगे दश।” तिने बोलेया, “ये, कि लोक युद्धो रा मैदान छाडी की नठीगे ओर बऊत लोक मरी गे ओर शाऊल ओर तेसरा पाऊ योनातान बी मरीगा।” <verse eid="2SA 1:4" /><verse number="5" style="v" sid="2SA 1:5" />दाऊदे तेस सन्देश देणे वाल़े जवानो ते पूछेया, “तूँ किंयाँ जाणेया कि शाऊल ओर तेसरा पाऊ योनातान मरी गे?” <verse eid="2SA 1:5" /><verse number="6" style="v" sid="2SA 1:6" />सन्देश देणे वाल़े जवाने बोलेया, “संयोगो ते आऊँ गिलबो रे पाह्ड़ो पाँदे था; तो मैं क्या देखेया, कि राजा शाऊले आपणी तलवारा रे साअरे खड़ी रा था; तेबे मैं ये बी देखेया कि तेसरा पीछा करने खे रथ ओर सवार बऊत तेज दौड़ी की आऊणे लगी रे। <verse eid="2SA 1:6" /><verse number="7" style="v" sid="2SA 1:7" />तिने पीछे फिरी की आऊँ देखेया ओर माखे आका पाईया।” मैं बोलेया, “क्या आज्ञा ए?” <verse eid="2SA 1:7" /><verse number="8" style="v" sid="2SA 1:8" />तिने माखे बोलेया, “तूँ कुण ए?” मैं तेसखे बोलेया, “आऊँ तो अमालेकी ए।” <verse eid="2SA 1:8" /><verse number="9" style="v" sid="2SA 1:9" />तिने माखे बोलेया, “आऊँ मरना चाऊँआ इजी री खातर माखे काईदे; कऊँकि मेरा सिर कूमणे लगी रा, पर प्राण नि निकल़दे।” <verse eid="2SA 1:9" /><verse number="10" style="v" sid="2SA 1:10" />तेबे माखे ये पक्का पता लगी गा कि से रूड़ने ते बाद नि बची सकदा, मैं तेसगे खड़े ऊई की से काई ता ओर आऊँ तेसरे सिरो रा मुकुट ओर तेसरे आथो रा कड़ा लई की आपणे स्वामिए गे आई रा। <verse eid="2SA 1:10" /><verse number="11" style="v" sid="2SA 1:11" />तेबे दाऊद बऊत दु:खी ऊआ ओर तिने आपणे टाल़े फाड़े ओर जितणे मर्द तेस साथे थे सारेया तेड़ा ई कित्तेया; ये दखाणे खे कि सेयो बी बऊत दू:खी थे।<verse eid="2SA 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 1:12" />तेबे सेयो शाऊल, ओर तेसरे पाऊ योनातान, ओर यहोवे री प्रजा ओर इस्राएलो रे कराने रिया तँईं दु:खी ऊई की रोणे लगे ओर साँजा तक कुछ नि खाया, इजी बजअ ते कि सेयो युद्धो दे तलवारी साथे काई राखे थे। <verse eid="2SA 1:12" /><verse number="13" style="v" sid="2SA 1:13" />तेबे दाऊदे तेस सन्देश देणे वाल़े जवानो ते पूछेया, “तूँ केथो राए?” तिने बोलेया, “आऊँ तो परदेशिये रा पाऊ मतलब अमालेकी ए।” <verse eid="2SA 1:13" /><verse number="14" style="v" sid="2SA 1:14" />दाऊदे तेसखे बोलेया, “तूँ यहोवे रे चूणे दे माणूंए रा नाश करने खे आथ बढ़ाणे ते कऊँ नि डरेया?”<verse eid="2SA 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 1:15" />तेबे दाऊदे आपणे एकी जवानो खे बुलाई की बोलेया, “नेड़े जाई की तेसखे काईदे।” तेबे तिने तलवार लई की एड़ी बाई की से मरी गा। <verse eid="2SA 1:15" /><verse number="16" style="v" sid="2SA 1:16" />तेबे दाऊदे तिना सबी लोका रे सामणे बोलेया, “ये माणूं आपू ई आपणियां मौता रा जिम्मेदार ए, कऊँकि तिने ये बोली की कि यहोवे रा अभिषिक्त माणूं मैं ई काई राखेया, आपणे मुंए ते आपणे ई खलाफ गवाई देई राखी।”<verse eid="2SA 1:16" /></para>
  <para style="s">शाऊल ओर योनातानो रिया तँईं दाऊदो रा रोणे रा गीत</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 1:17" />तेबे दाऊदे शाऊल ओर तेसरे पाऊ योनातानो रे बारे दे ये रोणे रा गीत बणाया,<verse eid="2SA 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 1:18" />ओर यहूदिया खे ये धनुष नाओं रे गीतो खे सिखाणे री आज्ञा दित्ती; ये याशार नाओं री कताबा दे लिखी राखेया: से ये ए,<verse eid="2SA 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="2SA 1:19" />“ओ इस्राएली लोको, तुसा रे परदान एसा ऊच्ची जगा दे काईते रे। हाय, शूरवीर केड़े रूड़ी की पड़ी रे!<verse eid="2SA 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="2SA 1:20" />गत शईरो दे ये नि बताओ ओर ना अश्कलोन शईरो रिया सड़का दे प्रचार करो; एड़ा नि ओ कि पलिश्ती जवाणसा खुश ओ, एड़ा नि ओ कि बिना खतना कित्ते रे लोका रिया बेटिया कमण्ड करने लगो।<verse eid="2SA 1:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="2SA 1:21" />ओ गिलबो रे पाह्ड़, तां पाँदे ना तो पाल़ा पड़ो, ओर ना बर्खा ओ ओर ना ई पेंटा जोगे उपजाणे वाल़े डोरू ओ! कऊँकि तेती शूरवीरा रिया ढाला अशुद्ध ऊईगिया। ओर शाऊलो री ढाल बिना तेल लगाई री रईगी।”<verse eid="2SA 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="2SA 1:22" />थके रे माणूंआ रा खून बाह्णे ते ओर शूरवीरा री चर्बी खाणे ते, योनातानो रा तीरक-बाण वापस नि जाओ था ओर ना ई शाऊलो री तलवार खाली आओ थी।<verse eid="2SA 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="2SA 1:23" />शाऊल ओर योनातान जिऊँदे जिऊए तो लोका ते प्यार करो थे ओर मनो खे अच्छे लगणे वाल़े थे ओर आपणी मौता तक लग नि ऊए; सेयो उकाबो ते बी तेज चलणे वाल़े थे ओर शेरो ते बी जादा तागतबर थे।<verse eid="2SA 1:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="2SA 1:24" />ओ इस्राएली जवाणसो, शाऊलो रिया तँईं रोओ, से तो तुसा खे लाल टाल़े पन्याई की सुख देयो था ओर तुसा रे टाल़ेया पाँदे सूईने रे गईणे पन्याओ था।<verse eid="2SA 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="2SA 1:25" />हाय, लड़ाईया रिया जगा दे शूरवीर केड़े काम आये! ओ योनातान, तूँ उची जगा दे लड़दे ऊए मरीगा,<verse eid="2SA 1:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="2SA 1:26" />ओ मेरे पाई योनातान, आऊँ तेरिया बजअ ते दु:खी ए; तूँ माखे बऊत प्यारा लगो था; तेरा प्यार मां पाँदे अद्भुत था, बल्कि बऊत जवाणसा रे प्यारो ते बी जादा था।<verse eid="2SA 1:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="2SA 1:27" />हाय, शूरवीर किंयाँ रूड़ी गे ओर लड़ाईया रे सारे अथियार केड़े नाश ऊईगे रे!<verse eid="2SA 1:27" /></para>
  <chapter eid="2SA 1" />
  <chapter number="2" style="c" sid="2SA 2" />
  <para style="s">दाऊदो रा यहूदा प्रदेशो पाँदे राजा बणना</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 2:1" />इजी ते कुछ बखतो बाद दाऊदे यहोवे ते पूछेया, “क्या आऊँ यहूदा रे केसी शईरो दे रणे खे जाऊँ?” यहोवे तेसखे बोलेया, “आ, चली जा।” दाऊदे फेर पूछेया, “कुण जे शईरो दे जाऊँ?” यहोवे ज्वाब दित्तेया, “हेब्रोन शईरो दे चली जा।” <verse eid="2SA 2:1" /><verse number="2" style="v" sid="2SA 2:2" />तेबे दाऊद यिज्रेल शईरो रे अहीनोअम ओर कर्मेल शईरो रे नाबालो री जवाणस अबीगैल नाओं री, आपणी दुँईं लाड़िया समेत तेथी गया। <verse eid="2SA 2:2" /><verse number="3" style="v" sid="2SA 2:3" />दाऊद आपणे साथिया खे बी एकी-एकी रे कराने समेत तेथी लईगा ओर सेयो सब हेब्रोन शईरो रे गाँवो दे रणे लगे।<verse eid="2SA 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 2:4" />तेबे यहूदी लोक हेब्रोनो खे गये ओर तिना बीचा ते किने एकी जणे तेथी दाऊदो रा अभिषेक कित्तेया, कि से यहूदा रे कराने रा राजा ओ। जेबे दाऊदो खे ये सन्देश मिलेया कि जिने शाऊलो खे माट्टी दित्ती थी सेयो गिलाद इलाके रे याबेश शईरो रे लोक ए। <verse eid="2SA 2:4" /><verse number="5" style="v" sid="2SA 2:5" />तेबे दाऊदे दूता गे गिलाद इलाके रे याबेश शईरो रे लोका गे ये सन्देशा पेजेया, “यहोवे री आशीष तुसा पाँदे ओ, कऊँकि तुसे आपणे प्रभु शाऊलो पाँदे कृपा करी की से दबाया। तेसखे माट्टी दित्ती। <verse eid="2SA 2:5" /><verse number="6" style="v" sid="2SA 2:6" />इजी री खातर एबे यहोवा तुसा साथे कृपा ओर सच्चाईया रा बर्ताव करो ओर मां बी तुसा री एसा पलाईया रा बदला तुसा खे देणा, कऊँकि तुसे ये काम जो शाऊलो साथे कित्तेया। <verse eid="2SA 2:6" /><verse number="7" style="v" sid="2SA 2:7" />एबे ईम्मत करो ओर मजबूत बणो, कऊँकि तुसा रा राजा शाऊल मरी गा ओर यहूदा रे कराने आपू पाँदे राजा ऊणे खे मेरा अभिषेक करी राखेया।”<verse eid="2SA 2:7" /></para>
  <para style="s">ईशबोशेत इस्राएलो रा राजा</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 2:8" />जेबे ये सब ऊणे लगी रा था तेस ई बखते नेरो रा पाऊ अब्नेर जो शाऊलो रा परदान सेनापति था, तिने शाऊलो रा पाऊ ईशबोशेत आपू साथे लया ओर यरदन नदिया ते पार महनैम शईरो खे चली गा; <verse eid="2SA 2:8" /><verse number="9" style="v" sid="2SA 2:9" />ओर तेते जगा दे अब्नेरे ईशबोशेत गिलाद प्रदेशो रा राजा बणाया, ओर अशूरिया रे देश, यिज्रेल, एप्रैम, बिन्यामीन, बल्कि सारे इस्राएल प्रदेशो पाँदे राजा नियुक्त करी ता।<verse eid="2SA 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 2:10" />शाऊलो रा पाऊ ईशबोशेत चाल़िया साला रा था जेबे से इस्राएलो पाँदे राज करने लगेया ओर दो साला तक राज करदा रया। पर यहूदा रा कराना दाऊदो रे पक्षो दे था। <verse eid="2SA 2:10" /><verse number="11" style="v" sid="2SA 2:11" />ओर दाऊदो रा हेब्रोनो दे यहूदा रे कराने पाँदे राज करने रा बखत साढ़े सात साल था।<verse eid="2SA 2:11" /></para>
  <para style="s">यहूदा ओर इस्राएलो बीचे युद्ध</para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 2:12" />एक दिन नेरो रा पाऊ अब्नेर ओर शाऊलो रे पाऊ ईशबोशेतो रे लोक, महनैमो ते गिबोन शईरो दे आए। <verse eid="2SA 2:12" /><verse number="13" style="v" sid="2SA 2:13" />तेबे सरूयाह रा पाऊ योआब ओर दाऊदो रे माणूं, हेब्रोनो ते निकल़ी की तिना साथे गिबोनो रे पोखरे गे मिले ओर दोनो दल तेस पोखरे गे एकी-एकी कनारे खे बैठीगे। <verse eid="2SA 2:13" /><verse number="14" style="v" sid="2SA 2:14" />तेबे अब्नेरे योआबो खे बोलेया, “जवान लोक उठी की आसा सामणे लड़ो।” योआबे बोलेया, “सेयो उठो।” <verse eid="2SA 2:14" /><verse number="15" style="v" sid="2SA 2:15" />तेबे सेयो उठे ओर बिन्यामीन गोत्र, मतलब शाऊलो रे पाऊ ईशबोशेतो रे पक्षो खे बारा जणे गिणी की निकल़े ओर दाऊदो रे लोका बीचा ते बी बारा निकल़े। <verse eid="2SA 2:15" /><verse number="16" style="v" sid="2SA 2:16" />ओर तिने एकी-दूजे रा सिर पकड़ी की आपणी-आपणी तलवार एकी-दूजे रिया छड़िया दे कूसायी ती ओर सेयो एकी साथे ई मरी गे। इजी ते तेसा जगा रा नाओं “हेल्कथस्सूरीम”<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="fq" closed="false">“हेल्कथस्सूरीम” </char><char style="ft" closed="false">तेज तलवारी रा डोरू </char></note> पड़ेया, से जगा गिबोनो दे ए।<verse eid="2SA 2:16" /></para>
  <para style="s">असाहेलो री मौत</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 2:17" />तेस दिने बड़ा खतरनाक युद्ध ऊआ ओर अब्नेर ओर इस्राएलो रे लोक दाऊदो रे माणूंआ ते आरी गे। <verse eid="2SA 2:17" /><verse number="18" style="v" sid="2SA 2:18" />तेस दिने तेथी तो योआब, अबीशै ओर असाहेल नाओं रे सरूयाह रे तीनो पाऊ थे ओर असाहेल बणो रे ईरणो जेड़ा तेज दौड़ने वाल़ा था। <verse eid="2SA 2:18" /><verse number="19" style="v" sid="2SA 2:19" />तेबे असाहेल अब्नेरो रा पीछा करने लगेया ओर तेसरा पीछा करदे ऊए ना तो दाँणे मुड़ेया ना खूँजे। <verse eid="2SA 2:19" /><verse number="20" style="v" sid="2SA 2:20" />अब्नेरे पीछे फिरी की पूछेया, “क्या तूँ असाहेल ए?” तिने बोलेया, “आ, आऊँ सेईए।” <verse eid="2SA 2:20" /><verse number="21" style="v" sid="2SA 2:21" />अब्नेरे तेसखे बोलेया, “चाए तूँ दाँणे, चाए खूँजे मुड़, केसी जवानो खे पकड़ी की तिना रा कवच लई लो।” पर असाहेले तेसरा पीछा करना नि छाडेया। <verse eid="2SA 2:21" /><verse number="22" style="v" sid="2SA 2:22" />अब्नेरे असाहेलो खे फेर बोलेया, “मेरा पीछा छाडी दे; मां तूँ काई की माट्टिया दे कऊँ मलाणा? एड़ा करी की मां तेरे पाई योआबो गे आपणा मूँ किंयाँ दखाणा?” <verse eid="2SA 2:22" /><verse number="23" style="v" sid="2SA 2:23" />तेबे बी तिने आटणे ते ना कित्ती; तेबे अब्नेरे आपणे भाल़े री पिछाड़ी तेसरे पेटो दे एड़ी बाई कि भाल़ा दूजे कनारे पिट्ठी दे निकल़ी गा ओर से तेथी रूड़ी की मरी गा ओर जितणे लोक तेते जगा दे आए जेती असाहेल रूड़ी की मरी गा, तेती सेयो सारे खड़े रये।<verse eid="2SA 2:23" /></para>
  <para style="s">अब्नेर ओर योआब</para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 2:24" />पर योआब ओर अबीशै अब्नेरो रा पीछा करदे रये ओर सूरजो रे डूबदे-डूबदे सेयो अम्माह नाओं री तेसा पाह्ड़िया तक पऊँचे, जो गिबोनो रे जंगल़ो री बाटा रे गीह रे सामणे ए। <verse eid="2SA 2:24" /><verse number="25" style="v" sid="2SA 2:25" />ओर बिन्यामीनी अब्नेरो पीछे ऊई की एक दल ऊईगे ओर एक पाह्ड़िया री चूँडिया पाँदे खड़े ऊए।<verse eid="2SA 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 2:26" />तेबे अब्नेर योआबो खे जोरे की आका पाई की बोलणे लगेया, “क्या तलवार सदा कांदी रओ? क्या तूँ नि जाणदा इजी रा फल दु:ख ई देणे वाल़ा ऊणा? तां कदुओ तक आपणे लोका खे आज्ञा नि देणी कि आपणे इस्राएली पाईया रा पीछा छाडी की वापस आओ?” <verse eid="2SA 2:26" /><verse number="27" style="v" sid="2SA 2:27" />योआबे बोलेया, “परमेशरो री जिन्दगिया री कसम जे तूँ नि बोलदा तेबे लोक पक्का प्यागा ई चली जाणे थे ओर आपणे-आपणे इस्राएली पाईया रा पीछा नि करना था।” <verse eid="2SA 2:27" /><verse number="28" style="v" sid="2SA 2:28" />तेबे योआबे रड़सिंगे दे फूकर दित्ती ओर सारे लोक रूकी गे ओर तेबे इस्राएली लोका रा पीछा नि कित्तेया ओर फेर लड़ाई नि कित्ती। <verse eid="2SA 2:28" /><verse number="29" style="v" sid="2SA 2:29" />तेसा ई राती अब्नेर आपणे माणूंआ समेत तेस ई दिने रातोरात अराबा ते ऊई की गया; ओर यरदन नदिया ते पार सारे बित्रोन देशो रिये ऊई की महनैमो दे पऊँचेया।<verse eid="2SA 2:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 2:30" />योआब ओर तेसरे सिपाई अब्नेरो रा पीछा छाडी की वापस ऊए ओर जेबे तिने सारे लोक कट्ठे कित्ते, तेबे क्या देखेया कि दाऊदो रे माणूंआ बीचा ते उन्नी मर्द ओर असाहेल पनि ए। <verse eid="2SA 2:30" /><verse number="31" style="v" sid="2SA 2:31" />पर दाऊदो रे माणूंए बिन्यामीनी ओर अब्नेरो रे माणूं एड़े काये कि तिना बीचा ते 360 जणे मरी गे। <verse eid="2SA 2:31" /><verse number="32" style="v" sid="2SA 2:32" />योआबो रे कुछ सिपाईए असाहेलो री लाशा खे चकी की तेसरे बाओ रे कब्रिस्तानो दे, जो बेतलेहमो दे थी, तेथी दबाईता। तेबे योआब आपणे माणूंआ समेत पूरी रात चली की प्याग ऊणे तक हेब्रोनो दे पऊँचेया।<verse eid="2SA 2:32" /></para>
  <chapter eid="2SA 2" />
  <chapter number="3" style="c" sid="2SA 3" />
  <para style="p">
    <verse number="1" style="v" sid="2SA 3:1" />तेस बखते शाऊलो रे कराने ओर दाऊदो रे कराने बीचे बऊत दिना तक लड़ाई ऊँदी रई, पर दाऊद शक्तिशाली ऊँदा गया ओर शाऊलो रा कराना कमजोर ऊँदा गया।<verse eid="2SA 3:1" /></para>
  <para style="s">दाऊदो रे पाऊ</para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 3:2" />हेब्रोन शईरो दे दाऊदो रे यो पाऊ पैदा ऊए; तेसरा जेठा पाऊ अम्नोन था, जो यिज्रेल शईरो री अहीनोअम जवाणसा ते पैदा ऊआ था; <verse eid="2SA 3:2" /><verse number="3" style="v" sid="2SA 3:3" />ओर तेसरा दूजा पाऊ किलाब था, जेसरी माये कर्मेल शईरो रे नाबालो री बिदुआ लाड़ी अबीगैल थी; तीजा अबशालोम, जो गशूर प्रदेशो रे राजा तल्मै री बेटी माका ते पैदा ऊआ था। <verse eid="2SA 3:3" /><verse number="4" style="v" sid="2SA 3:4" />चौथा अदोनिय्याह, जो हग्गीता ते पैदा ऊआ था, पाँजुआ शपत्याह, जेसरी माये अबीतल थी; <verse eid="2SA 3:4" /><verse number="5" style="v" sid="2SA 3:5" />छठुआ यित्राम, जो एग्ला नाओं री दाऊदो री जवाणसा ते पैदा ऊआ। हेब्रोनो दे दाऊदो ते यो ई ल्वादा पैदा ऊईया।<verse eid="2SA 3:5" /></para>
  <para style="s">अब्नेरो रा दाऊदो रे पक्षो दे आऊणा</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 3:6" />जेस बखते शाऊल ओर दाऊदो रे परिवारो बीचे लड़ाई ऊणे लगी री थी, अब्नेरे आपू खे शाऊलो री सेना दे तागतबर बणाई ला था। <verse eid="2SA 3:6" /><verse number="7" style="v" sid="2SA 3:7" />शाऊलो री एक रखैल थी जेसा रा नाओं रिस्पा था, से अय्या री बेटी थी; ओर ईशबोशेते अब्नेरो ते पूछेया, “तूँ मेरे बाओ री रखैला गे कऊँ गया?” <verse eid="2SA 3:7" /><verse number="8" style="v" sid="2SA 3:8" />ईशबोशेतो री एसा गल्ला रिया बजअ ते अब्नेर बऊत गुस्से ऊई की बोलणे लगेया, “क्या तूँ सोचेया कि आऊँ यहूदा प्रदेशो दे एकी कुत्ते जेड़ा ए, जो आपणे स्वामिये रे खलाफ काम करोआ? आजो तक आऊँ तेरे बाओ शाऊलो रे कराने, ओर तेसरे पाई ओर दोस्ता साथे प्यार दखांदा आई रा ओर तूँ दाऊदो रे आथो दे पड़ने नि दित्तेया; तेबे तूँ एबे मां पाँदे तेसा जवाणसा रे बारे दे दोष लगाणे लगी रा? <verse eid="2SA 3:8" /><verse number="9" style="v" sid="2SA 3:9" />जे आऊँ दाऊदो साथे परमेशरो री कसमा रे मुताबिक बर्ताव नि करुँ, तो परमेशर अब्नेरो साथे तेड़ा ई, बल्कि तिजी ते बी जादा करो; <verse eid="2SA 3:9" /><verse number="10" style="v" sid="2SA 3:10" />मतलब मां राज्य शाऊलो रे कराने ते छुड़ाणा ओर दाऊदो री राजगद्दी उतर दिशा दे दान शईरो रे इलाके ते लई की दक्खणा दे बेर्शेबा शईरो तक इस्राएल ओर यहूदा तक स्थिर करनी।” <verse eid="2SA 3:10" /><verse number="11" style="v" sid="2SA 3:11" />तेबे ईशबोशेत अब्नेरो खे कोई ज्वाब नि देई सकेया, कऊँकि से तेसते डरो था।<verse eid="2SA 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 3:12" />तेबे अब्नेरे तेसरे नाओं ते दाऊदो गे दूता ते सन्देशा पेजेया, “देश केसरा ए?” ओर ये बी सन्देशा पेजेया, “तूँ मांते वादा कर ओर मां तेरी मताद करनी, ताकि सारे इस्राएली लोका रे मन तेरी तरफा खे फेरी दूँ।” <verse eid="2SA 3:12" /><verse number="13" style="v" sid="2SA 3:13" />दाऊदे बोलेया, “खरा ए, आऊँ तांते वादा तो करूँआ, पर आऊँ तांते एक गल्ल चाऊँआ; कि जेबे तूँ मां साथे मिलणे आओ, तेबे तूँ पईले शाऊलो री बेटी मीकला खे आपू साथे लई की आओ, तेबे तूँ मां साथे मिली सकोआ।” <verse eid="2SA 3:13" /><verse number="14" style="v" sid="2SA 3:14" />तेबे दाऊदे शाऊलो रे पाऊ ईशबोशेतो गे दूता ते ये सन्देशा पेजेया, “मेरी लाड़ी मीकल, जो मैं 100 पलिश्तिया खे काई की तिना रिया खलड़िया देई की आपणी बणाई ली थी, तेसा खे माखे देई दे।”<verse eid="2SA 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 3:15" />तेबे ईशबोशेते लोका खे पेजी की से लैशो रे पाऊ पलतीएलो ते छुड़ाई ली। <verse eid="2SA 3:15" /><verse number="16" style="v" sid="2SA 3:16" />ओर तेसा रा लाड़ा तेसा साथे चलेया ओर बहूरीमो तक तेसा पीछे रोंदा ऊआ चली गा। तेबे अब्नेरे तेसखे बोलेया, “कअरो खे वापस ऊई जा;” ओर से वापस ऊईगा। <verse eid="2SA 3:16" /><verse number="17" style="v" sid="2SA 3:17" />तेबे अब्नेरे इस्राएली लोका रे बुजुर्गा साथे एड़ी गल्ल कित्ती, “पईले तो तुसे लोक चाओ थे कि दाऊद आसा पाँदे राजा ओ। <verse eid="2SA 3:17" /><verse number="18" style="v" sid="2SA 3:18" />एबे तेड़ा ई करो; कऊँकि यहोवे दाऊदो रे बारे दे ये बोली राखेया कि मां आपणे दास दाऊदो रे जरीये आपणी इस्राएली प्रजा पलिश्तिया, बल्कि तिना रे सारे दुश्मणा रे आथो ते छुड़ाणी।” <verse eid="2SA 3:18" /><verse number="19" style="v" sid="2SA 3:19" />तेबे अब्नेरे बिन्यामीनो साथे बी गल्ल बात कित्ती; तेबे अब्नेर हेब्रोनो खे चली गा, ताकि इस्राएल ओर बिन्यामीनो रे सारे कराने खे जो कुछ अच्छा लगेया, से दाऊदो खे सुणाओ। <verse eid="2SA 3:19" /><verse number="20" style="v" sid="2SA 3:20" />तेबे अब्नेर बीइ मर्दा खे साथे लई की हेब्रोनो दे आया ओर दाऊदे तेसखे ओर तेस साथले मर्दा खे रोटी बणाई। <verse eid="2SA 3:20" /><verse number="21" style="v" sid="2SA 3:21" />तेबे अब्नेरे दाऊदो खे बोलेया, “मां उठी की जाणा ओर आपणे प्रभु राजे गे सारे इस्राएली कट्ठे करने, ताकि सेयो तां साथे वाचा बानो ओर तूँ आपणी इच्छा रे मुताबिक राज करी सके।” तेबे दाऊदे अब्नेर बिदा कित्तेया ओर से रामो दे चली गा।<verse eid="2SA 3:21" /></para>
  <para style="s">अब्नेरो री अत्या</para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 3:22" />तेते ते बाद छोड़ ई दाऊदो रे कई जणे योआबो साथे केथी चढ़ाई करी की बऊत सारी लूट लई की आईगे। ओर अब्नेर दाऊदो गे हेब्रोनो दे नि था, कऊँकि तिने से बिदा करी ता था ओर से रामो दे चली गा था। <verse eid="2SA 3:22" /><verse number="23" style="v" sid="2SA 3:23" />जेबे योआब ओर तेस साथली सारी सेना आई, तेबे लोके योआबो खे बोलेया, “नेरो रा पाऊ अब्नेर राजे गे आया था ओर तिने से बिदा करी ता ओर से रामो दे चली गा।” <verse eid="2SA 3:23" /><verse number="24" style="v" sid="2SA 3:24" />तेबे योआबे राजे गे जाई की बोलेया, “तैं ये क्या करी राखेया? अब्नेर जो तांगे आया था, तो क्या बजअ ए कि तैं से फेर जाणे दित्तेया ओर से चली गा? <verse eid="2SA 3:24" /><verse number="25" style="v" sid="2SA 3:25" />तूँ नेरो रे पाऊ अब्नेरो खे तो जाणेया कि से ताखे तोखा देणे, ओर तेरे आऊणे-जाणे ओर सारे कामो रा पेत लणे आई रा था।”<verse eid="2SA 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 3:26" />योआबे दाऊदो गे ते निकल़ी की अब्नेरो पीछे दूत पेजे ओर सेयो तेसखे सीरा नाओं रे कुएँ ते वापस ली आए। पर दाऊदो खे एते गला रा पता नि था। <verse eid="2SA 3:26" /><verse number="27" style="v" sid="2SA 3:27" />जेबे अब्नेर हेब्रोनो खे वापस आया, तेबे योआब तेस साथे कल्ले जे गल्ला करने खे तेसखे बड़े द्वारो ते पीतरे लग जे लईगा ओर तेती आपणे पाई असाहेलो रे खूनो रे बदले तेसरे पेटो दे एड़ी बाई कि से मरी गा। <verse eid="2SA 3:27" /><verse number="28" style="v" sid="2SA 3:28" />इजी ते बाद जेबे दाऊदे ये सुणेया, तेबे बोलेया, “नेरो रे पाऊ अब्नेरो रे खूनो रे बारे दे आऊँ आपणी प्रजा समेत यहोवे री नजरा दे सदा निर्दोष रणा। <verse eid="2SA 3:28" /><verse number="29" style="v" sid="2SA 3:29" />से योआब ओर तेसरे बाओ रे सारे कराने खे लगो ओर योआबो रे कुलो दे कोई ना कोई प्रमेह रा रोगी, ओर कोढ़ी, ओर लंगड़ा जो बसाखिये की चलणा, ओर तलवारी साथे मरने वाल़ा ओर पूखा मरने वाल़ा सदा ऊँदा रओ।” <verse eid="2SA 3:29" /><verse number="30" style="v" sid="2SA 3:30" />योआब ओर तेसरे पाई अबीशै अब्नेरो री इजी बजअ ते अत्या कित्ती थी, कऊँकि तिने तिना रा पाई असाहेल गिबोनो दे लड़ाईया रे बखते काया था।<verse eid="2SA 3:30" /></para>
  <para style="s">दाऊदो रा अब्नेरो रिया तँईं रोणा</para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 3:31" />तेबे दाऊदे योआब ओर आपू साथले सारे लोका खे बोलेया, “आपणे टाल्ले फाड़ो ओर लको दे टाट बानी की अब्नेरो री लाशा ते आगे-आगे चलो।” ओर दाऊद राजा आपू लाशा ते पीछे-पीछे चलेया। <verse eid="2SA 3:31" /><verse number="32" style="v" sid="2SA 3:32" />अब्नेर हेब्रोनो दे दबाईता ओर राजा अब्नेरो री कब्रा गे फूटी-फूटी की रोणे लगेया ओर सारे लोक बी रोए। <verse eid="2SA 3:32" /><verse number="33" style="v" sid="2SA 3:33" />तेबे राजा दाऊदे अब्नेरो रे बारे दे ये दु:ख देणे वाल़ा गीत बणाया,</para>
  <para style="q" vid="2SA 3:33">“क्या ये सई था कि अब्नेर मूर्खो जेड़ा मरो?<verse eid="2SA 3:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="2SA 3:34" />ना तो तेरे आथ बाने गये ओर ना ई तेरे पैरो दे बेड़िया पाई राखी थिया; जेड़ा कोई बुरे माणूंए रे आथो ते काया जाओ। तेड़ा ई तूँ काया।”</para>
  <para style="p" vid="2SA 3:34">तेबे सारे लोक तेसरे बारे दे फेर रोणे लगे। <verse eid="2SA 3:34" /><verse number="35" style="v" sid="2SA 3:35" />तेबे सारे लोक दिने ई दाऊदो खे रोटी खुलाणे खे आए, पर दाऊदे कसम खाई की बोलेया, “जे आऊँ सूरज डूबणे ते पईले रोटी या कोई ओर चीज खाऊँ, तो परमेशर मां साथे एड़ा ई, बल्कि इजी ते बी जादा करो।” <verse eid="2SA 3:35" /><verse number="36" style="v" sid="2SA 3:36" />सारे लोके इजी रे बारे दे सोचेया ओर इजी ते खुश ऊए, तेड़े ई जो कुछ राजा करो था तिजी ते सारे लोक खुश ओ थे। <verse eid="2SA 3:36" /><verse number="37" style="v" sid="2SA 3:37" />तेबे तिने सारेया लोके, बल्कि सारे इस्राएलिये बी तेसी दिने जाणी ला कि नेरो रे पाऊ अब्नेरो खे काणा राजे रिया तरफा ते नि था। <verse eid="2SA 3:37" /><verse number="38" style="v" sid="2SA 3:38" />राजे आपणे कर्मचारिया खे बोलेया, “क्या तुसे लोक नि जाणदे कि इस्राएलो दे आजके दिने एक परदान ओर प्रतापी माणूं मरी रा? <verse eid="2SA 3:38" /><verse number="39" style="v" sid="2SA 3:39" />जेबे की आऊँ अभिषिक्त राजा ए, तेबे बी आज आऊँ कमजोर ए ओर सेयो सरूयाह रे पाऊ मांते जादा तागतबर ए। पर यहोवा बुराई करने वाल़े खे तेसरी बुराईया रे मुताबिक ई बदला देयो।”<verse eid="2SA 3:39" /></para>
  <chapter eid="2SA 3" />
  <chapter number="4" style="c" sid="2SA 4" />
  <para style="s">ईशबोशेतो री अत्या</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 4:1" />जेबे शाऊलो रे पाऊए सुणेया, कि अब्नेर हेब्रोन शईरो दे काई ता, तेबे ईशबोशेत ओर तेसरे सब इस्राएली लोक बऊत जादा डरीगे। <verse eid="2SA 4:1" /><verse number="2" style="v" sid="2SA 4:2" />शाऊलो रे पाऊए रे दो माणूं थे जो दलो रे परदान थे; एकी रा नाओं बानाह ओर दूजे रा नाओं रेकाब था, यो दोनो बेरोत शईरो रे बिन्यामीन गोत्रो रे रिम्मोनो रे पाऊ थे, कऊँकि बेरोत बी बिन्यामीनो रे इस्से दे गिणेया जाओआ; <verse eid="2SA 4:2" /><verse number="3" style="v" sid="2SA 4:3" />ओर बेरोती लोक गित्तैम शईरो दे नठीगे ओर आजो तक तेथी परदेशी ऊई की रओए।<verse eid="2SA 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 4:4" />शाऊलो रे पाऊ योनातानो रे एक लंगड़ा पाऊ था। जेबे यिज्रेलो ते शाऊल ओर योनातानो रे मरने रा सन्देश आया तेबे से पाँजा साला रा था; तेस बखते तेसरी दाई तेसखे लई की नठी गी ओर तेसा रे छोड़-छोड़ नठणे रिया बजअ ते से रूड़ी की लंगड़ा ऊईगा। तेसरा नाओं मपीबोशेत था। <verse eid="2SA 4:4" /><verse number="5" style="v" sid="2SA 4:5" />एक दिन बेरोती रिम्मोनो रे पाऊ रेकाब ओर बानाह तेज तूपा रे बखते ईशबोशेतो रे कअरे जेबे से त्याड़िया राम करने लगी रा था, आए। <verse eid="2SA 4:5" /><verse number="6" style="v" sid="2SA 4:6" />ओर सेयो कणक निणे रे बाह्ने दे पीतरे कूसी गे ओर तेसरे पेटो दे तलवारी की बाई; ओर से काईता। तेबे रेकाब ओर तेसरा पाई बानाह नठी की निकल़ी गे। <verse eid="2SA 4:6" /><verse number="7" style="v" sid="2SA 4:7" />जेबे सेयो कअरो दे कूसे ओर से आपणे कअरे माँजे पाँदे सऊणे लगी रा था, तेबे तिने से आपणियां तलवारी की काई ता ओर तेसरा सिर बाडीता ओर तेसरा सिर लई की सेयो यरदन काट्टिया ते ऊँदे ऊए सारी रात अराबा रिया बाटा रिये चलदे रये। <verse eid="2SA 4:7" /><verse number="8" style="v" sid="2SA 4:8" />सेयो ईशबोशेतो रा सिर हेब्रोनो दे दाऊदो गे लई जाई की बोलणे लगे, “देख, शाऊल जो तेरा दुश्मण ओर तेरे प्राणो पीछे पड़ी रा था, तेसरे पाऊ ईशबोशेतो रा ये सिर ए; तो आजके दिने यहोवे शाऊल ओर तेसरे कुलो ते मेरे प्रभु राजे रा बदला लई राखेया।”<verse eid="2SA 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 4:9" />दाऊदे बेरोती रिम्मोनो रे पाऊ रेकाब ओर तेसरे पाई बानाहो खे ज्वाब देई की तिना खे बोलेया यहोवा जो मेरे प्राणो खे सारी मुसीबता ते छुड़ांदा आई रा, तेसरी जिन्दगिया री कसम, <verse eid="2SA 4:9" /><verse number="10" style="v" sid="2SA 4:10" />जेबे किने ये जाणी की कि आऊँ शुभ सन्देश देणे लगी रा, सिकलग शईरो दे माखे शाऊलो रे मरने रा सन्देश दित्तेया, तेबे मैं से पकड़ी की काई ता; मतलब तेसखे सन्देशो रा येई बदला मिलेया। <verse eid="2SA 4:10" /><verse number="11" style="v" sid="2SA 4:11" />इजी री खातर जेबे दुष्ट माणूंए एक निर्दोष माणूं तेसरे ई कअरे, बल्कि तेसरे ई माँजे पाँदे काई ता, तो मां एबे जरूर तेसरे खूनो रा बदला तुसा ते लणा ओर तुसे तरतिया पाँदा ते नाश करी देणे। <verse eid="2SA 4:11" /><verse number="12" style="v" sid="2SA 4:12" />तेबे दाऊदे जवाना खे आज्ञा दित्ती ओर तिने सेयो काई की तिना रे आथ-पैर बाडे ओर तिना रिया लाशा पोखरे गे टाँगी तिया। तेबे ईशबोशेतो रा सिर चकी की हेब्रोनो दे अब्नेरो री कब्रा दे दबाईता।<verse eid="2SA 4:12" /></para>
  <chapter eid="2SA 4" />
  <chapter number="5" style="c" sid="2SA 5" />
  <para style="s">दाऊदो रा राज्य अभिषेक</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 5:1" />तेबे इस्राएलो रे सब गोत्रा रे परदान लोक दाऊदो रे नेड़े हेब्रोनो दे आई की बोलणे लगे, “सुण, आसे लोक ओर तूँ एक ई कुलो रे ए। <verse eid="2SA 5:1" /><verse number="2" style="v" sid="2SA 5:2" />जेबे पईले शाऊल म्हारा राजा था, तेबे बी इस्राएलो रा अगुवा तूँ ई था ओर यहोवे ताखे बोलेया, कि मेरी प्रजा इस्राएलो रा ग्वाल़ा ओर इस्राएलो रा परदान तूँ ई ऊणा।”<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">पज. 78:71</char></note> <verse eid="2SA 5:2" /><verse number="3" style="v" sid="2SA 5:3" />तेबे सारे गोत्रा रे बुजुर्ग हेब्रोनो दे राजा दाऊदो गे आए ओर दाऊद राजे तिना साथे हेब्रोनो रे यहोवे रे सामणे वाचा बानी ओर तिने इस्राएलो रा राजा ऊणे खे दाऊदो रा अभिषेक कित्तेया।<verse eid="2SA 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 5:4" />जेबे दाऊद राज करने लगेया तेबे से तिया साला रा था, ओर से इस्राएलो दे चाल़िया साला तक राज करदा रया। <verse eid="2SA 5:4" /><verse number="5" style="v" sid="2SA 5:5" />साढ़े साता साला तक तो तिने हेब्रोनो दे यहूदा पाँदे राज कित्तेया ओर तेतिया साला तक यरूशलेम शईरो दे सारे इस्राएल ओर यहूदा पाँदे राज कित्तेया।<verse eid="2SA 5:5" /></para>
  <para style="s">दाऊदो रा यरूशलेमो पाँदे कब्जा करना</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 5:6" />एक दिन राजे आपणे माणूं साथे लई की यरूशलेम शईरो दे जाई की यबूसी लोका ते लड़ने खे आए, जो तेस देशो दे रणे वाल़े थे। तिने ये समजी की कि दाऊदो री सेना एती नि आई सकदी, तेसखे बोलेया, “जदुओ तक तूँ अन्दे ओर लंगड़ेया खे दूर नि करी लओगा, तदुओ तक एती नि कूसी सकदा।” <verse eid="2SA 5:6" /><verse number="7" style="v" sid="2SA 5:7" />तेबे बी दाऊदो री सेने सिय्योन नाओं रा गढ़ लई ला, बादो ते से दाऊदो रा शईर बणेया। <verse eid="2SA 5:7" /><verse number="8" style="v" sid="2SA 5:8" />तेस ई दिने दाऊदे आपणे सिपाईया खे बोलेया, “जो कोई यबूसी लोका खे काणा चाओ, तेसखे चाईयो कि सेयो पाणिये रिया सुरंगा रिये ऊई की शईरो खे जाओ ओर अन्दे ओर लंगड़े जिना ते दाऊद मनो ते नफरत करोआ तिना खे काओ।” इजी ते ये कहावत चली, “अन्दे ओर लंगड़े मईलो दे नि आई सकदे।” <verse eid="2SA 5:8" /><verse number="9" style="v" sid="2SA 5:9" />बादो ते जेबे दाऊद ओर तेसरे सिपाई तेते शईरो पाँदे कब्जा करी चुके सेयो तेती रणे लगे ओर तेस शईरो रा नाओं दाऊदपुर राखेया। ओर दाऊदे चऊँ कनारे मिल्लो ते लई की पीतरलिया तरफा खे दवाल बणवाई।<verse eid="2SA 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 5:10" />ओर दाऊदो रा बोल-बाला लगातार जादा ऊँदा गया कऊँकि सेना रा यहोवा परमेशर तेस साथे रओ था। <verse eid="2SA 5:10" /><verse number="11" style="v" sid="2SA 5:11" />एक दिन सोरो रे राजे हीरामे दाऊदो गे दूत ओर देवदारो री लकड़ी, मिस्त्री ओर राजमिस्त्री पेजे ओर तिने दाऊदो खे एक मईल बणाया। <verse eid="2SA 5:11" /><verse number="12" style="v" sid="2SA 5:12" />ओर दाऊदो खे निश्चा ऊईगा कि यहोवे आऊँ इस्राएलो रा राजा बणाई की स्थिर करी ता ओर आपणी इस्राएली प्रजा रिया तँईं मेरा राज्य बढ़ाई राखेया।<verse eid="2SA 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 5:13" />जेबे दाऊद हेब्रोनो ते आया तेबे तिजी ते बाद तिने यरूशलेम शईरो रिया तरफा खे रखैला राखी तिया ओर लाड़िया बणाई तिया ओर तिना सबी जवाणसा ते तेसरे ओर बी माठे-बेटिया पैदा ऊए। <verse eid="2SA 5:13" /><verse number="14" style="v" sid="2SA 5:14" />तेसरी जो ल्वाद यरूशलेम शईरो रे पैदा ऊई तिना रे नाओं यो ए, मतलब शम्मू, शोबाब, नातान, सुलैमान, <verse eid="2SA 5:14" /><verse number="15" style="v" sid="2SA 5:15" />यिभार, एलीशू, नेपेग, यापी, <verse eid="2SA 5:15" /><verse number="16" style="v" sid="2SA 5:16" />एलीशामा, एल्यादा ओर एलीपेलेत।<verse eid="2SA 5:16" /></para>
  <para style="s">पलिश्तिया पाँदे जीत</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 5:17" />जेबे पलिश्तिये सुणेया कि इस्राएलो रा राजा ऊणे खे दाऊदो रा अभिषेक ऊई रा, तेबे सारे पलिश्ती दाऊदो री टोल़ा रे निकल़े; ये सुणी की दाऊद गढ़ो दे चली गा। <verse eid="2SA 5:17" /><verse number="18" style="v" sid="2SA 5:18" />तेबे पलिश्ती सिपाई आई की रपाईम नाओं री काअटिया दे फैली गे। <verse eid="2SA 5:18" /><verse number="19" style="v" sid="2SA 5:19" />तेबे दाऊदे यहोवे ते पूछेया, “क्या आऊँ ओर मेरे लोक पलिश्तिया पाँदे अमला करुँ? क्या तां सेयो मेरे आथो दे करी देणे?” यहोवे दाऊदो खे बोलेया, “अमला कर; कऊँकि मां पक्का पलिश्ती तेरे आथो दे करी देणे।”<verse eid="2SA 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 5:20" />तेबे दाऊद ओर तेसरी सेना बालपरासीमो खे गए ओर दाऊदे सेयो तेथी काई ते। तेबे तिने बोलेया, “यहोवा मां सामणे ऊई की मेरे दुश्मणा पाँदे पाणिए री खाड्डा जेड़ा टूटेया।” इजी बजअ ते तिने तेते जगा रा नाओं बालपरासीम राखेया। <verse eid="2SA 5:20" /><verse number="21" style="v" sid="2SA 5:21" />तेती पलिश्तिये आपणी मूर्तिया राखी तिया ओर दाऊद ओर तेसरे माणूं तिना खे चकी की लईगे। <verse eid="2SA 5:21" /><verse number="22" style="v" sid="2SA 5:22" />तेबे दूजी बार पलिश्ती सेना चढ़ाई करी की रपाईम नाओं री काअटिया दे फैली गे। <verse eid="2SA 5:22" /><verse number="23" style="v" sid="2SA 5:23" />जेबे दाऊदे यहोवे ते पूछेया कि आऊँ तिना पाँदे अमला करुँ तेबे तिने बोलेया, “अमला नि कर; तिना पीछा ते कूमी की तूतो रे डाल़ा सामणे ते तिना पाँदे अमला कर। <verse eid="2SA 5:23" /><verse number="24" style="v" sid="2SA 5:24" />ओर जेबे तूतो रे डाल़ा री डाल़िया बीचा ते सेना रे चलणे री जी आवाज ताखे सुणो, तेबे ये जाणी की फुर्ती करनी कि यहोवा पलिश्तिया री सेना खे काणे खे यबु मांते आगे आई रा।” <verse eid="2SA 5:24" /><verse number="25" style="v" sid="2SA 5:25" />यहोवे री एसा आज्ञा रे मुताबिक दाऊद आपणियां सेना साथे मिली की गेबा शईरो ते लई की गेजेर शईरो तक पलिश्तिया खे कांदा गया।<verse eid="2SA 5:25" /></para>
  <chapter eid="2SA 5" />
  <chapter number="6" style="c" sid="2SA 6" />
  <para style="s">पवित्र सन्दूको रा यरूशलेम शईरो दे ल्याऊणा</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 6:1" />तेबे दाऊदे एक बार ओर इस्राएलो रे गोत्रा बीचा ते सब बड़े लड़ने वाल़े सिपाई जो 30,000 थे कट्ठे कित्ते।<verse eid="2SA 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 6:2" />तेबे दाऊद ओर जितणे लोक तेस साथे थे, सेयो सारे उठी की यहूदा रे बाले नाओं री जगा ते चले, ताकि परमेशरो रे तेस पवित्र सन्दूको खे यरूशलेम शईरो खे ली आओ, जेतेखे करूबो पाँदे बैठणे वाल़े सेना रे यहोवे रा बोलोए। <verse eid="2SA 6:2" /><verse number="3" style="v" sid="2SA 6:3" />तेबे तिने परमेशरो रा सन्दूक एक नई बल़दा री गडिया दे चढ़ाई की टीले पाँदे रणे वाल़े अबीनादाबो रे कअरो ते काडेया ओर अबीनादाबो रे उज्जा ओर अह्यो नाओं रे दो पाऊ तेसा गडिया खे खेदणे लगे। <verse eid="2SA 6:3" /><verse number="4" style="v" sid="2SA 6:4" />ओर तिने से परमेशरो रे सन्दूको समेत टीले पाँदे रणे वाल़े अबीनादाबो रे कअरो ते बारे काडेया ओर अह्यो सन्दूको ते आगे-आगे चलणे लगेया। <verse eid="2SA 6:4" /><verse number="5" style="v" sid="2SA 6:5" />दाऊद ओर इस्राएलो रे सारे लोक यहोवे ते आगे केली री लकड़िया साथे बणे रे सब प्रकारा रे बाजे ओर बीणा, सारंगिया, डफ, डऊंरू, झाँझ बजांदे रये।<verse eid="2SA 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 6:6" />जेबे सेयो नाकोन<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="fq" closed="false">नाकोन </char><char style="ft" closed="false">1 इति. 13:9 दे एसरा नाओं किदोन बी आ </char></note> किसानो रे खल्याणो तक आए, तेती बल़दा रे पैरो दे ठोकर लगी। ये देखी की उज्जे आपणा आथ परमेशरो रा सन्दूक पकड़ने खे आगे कित्तेया ओर से पकड़ेया ताकि से थाले नि पड़ी जाओ। <verse eid="2SA 6:6" /><verse number="7" style="v" sid="2SA 6:7" />इजी बजा ते यहोवे रा कोप उज्जे पाँदे पड़केया ओर तिने उज्जे पाँदे अमला कित्तेया, कऊँकि तिने आपणे आथो ते से सन्दूक पकड़ेया था; ओर से तेथी परमेशरो सामणे मरी गा।<verse eid="2SA 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 6:8" />तेबे दाऊद गुस्से ऊईगा, कऊँकि यहोवे उज्जा काया, ओर तिने तेसा जगा रा नाओं पेरेसुज्जा राखेया, ये नाओं आजके दिनो तक ए। <verse eid="2SA 6:8" /><verse number="9" style="v" sid="2SA 6:9" />ओर तेस दिने दाऊद यहोवे ते डरी की बोलणे लगेया, “यहोवे रा सन्दूक मांगे कऊँ आओ?” <verse eid="2SA 6:9" /><verse number="10" style="v" sid="2SA 6:10" />इजी री खातर दाऊदे यहोवे रा सन्दूक आपणे कअरे दाऊदो रे शईरो दे नि ल्याऊणा चाया; पर गत शईरो दे रणे वाल़े ओबेदेदोमो रे कअरे पऊँचाई ता। <verse eid="2SA 6:10" /><verse number="11" style="v" sid="2SA 6:11" />यहोवे रा सन्दूक गतो रे रणे वाल़े ओबेदेदोमो रे कअरे तीन मीन्ने तक रया ओर तेस बखते यहोवे ओबेदेदोम ओर तेसरे सारे कराने खे आशीष दित्ती। <verse eid="2SA 6:11" /><verse number="12" style="v" sid="2SA 6:12" />तेबे किने दाऊद राजे गे जाई की ये दशेया कि यहोवे ओबेदेदोमो रे कराने पाँदे ओर जो कुछ तेसरा ए, तिजी पाँदे बी पवित्र सन्दूको रिया बजअ ते आशीष देई राखी। तेबे दाऊदे जाई की परमेशरो रा सन्दूक ओबेदेदोमो रे कअरो ते दाऊदो रे शईरो दे खुशिया साथे ल्याया। <verse eid="2SA 6:12" /><verse number="13" style="v" sid="2SA 6:13" />तेस बखते यहोवे रा सन्दूक चकणे वाल़े लेवी गोत्रो रे लोक सन्दूक चकी की छे कदम चली चुके, तेबे दाऊदे एक बल़द ओर एक पाल़ेया-पोषेया रा बाच्छू बलि कराया। <verse eid="2SA 6:13" /><verse number="14" style="v" sid="2SA 6:14" />ओर दाऊद रेशमो रा एपोद लको दे गूड़ी की यहोवे रे सामणे तनो-मनो ते नाचदा रया। <verse eid="2SA 6:14" /><verse number="15" style="v" sid="2SA 6:15" />ईंयाँ दाऊद ओर इस्राएलो रा सारा कराना यहोवे रे सन्दूको खे जयजयकार करदे ओर नरसिंगा बजांदे ऊए यरूशलेम शईरो खे लई चले।<verse eid="2SA 6:15" /></para>
  <para style="s">मीकला रा दाऊदो खे बेकार जाणना</para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 6:16" />जेबे यहोवे रा सन्दूक दाऊदो रे शईरो दे आऊणे लगी रा था, तेबे शाऊलो री बेटी दाऊदो री लाड़ी मीकले द्वारिया ते लमखी की दाऊद राजे खे यहोवे रे सन्दूको सामणे नाचदा ऊआ देखेया ओर तेसे से मन ई मन तुच्छ जाणेया। <verse eid="2SA 6:16" /><verse number="17" style="v" sid="2SA 6:17" />तेबे लोक यहोवे रा सन्दूक पीतरे ली आए ओर तेसरी जगा रे, मतलब तेस तम्बूए दे राखेया, जो दाऊदे तेसखे बणाया था; ओर दाऊदे यहोवे रे सामणे होमबलि ओर मेलबलि चढ़ाए। <verse eid="2SA 6:17" /><verse number="18" style="v" sid="2SA 6:18" />जेबे दाऊद होमबलि ओर मेलबलि चढ़ाई चुकेया, तेबे तिने सेना रे यहोवे रे नाओं ते प्रजा खे आशीर्वाद दित्तेया।<verse eid="2SA 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 6:19" />तेबे तिने सारी प्रजा खे, मतलब, क्या जवाणस, क्या मर्द, सारे इस्राएली लोका खे एक-एक रोटी, ओर एक-एक टुकड़ा मास ओर किशमिशा री एक-एक टिक्की बंडाई ती। तेबे प्रजा रे सारे लोक आपणे-आपणे कअरो खे चली गे। <verse eid="2SA 6:19" /><verse number="20" style="v" sid="2SA 6:20" />तेबे दाऊद आपणे कराने खे यहोवे ते आशीर्वाद मांगणे खे वापस ऊआ ओर शाऊलो री बेटी मीकल दाऊदो साथे मिलणे खे निकल़ी ओर बोलणे लगी, “आज इस्राएलो रे राजे जेबे आपणा शरीर आपणे कर्मचारिया री नौकराणिया सामणे एड़ा क्वाड़ी राखेया था, जेड़ा कोई नबाग आपणा शरीर क्वाड़ोआ, तेबे कितणा महान दिखणे लगी रा था!” <verse eid="2SA 6:20" /><verse number="21" style="v" sid="2SA 6:21" />दाऊदे मीकला खे बोलेया, “यहोवा, जिने तेरे बाओ ओर तेसरे सारे कराने रे बदले आऊँ चूणी की आपणी प्रजा इस्राएलो रा परदान ऊणे खे ठराईता रा, तेस सामणे आऊँ एड़ा नाचेया ओर मां यहोवे सामणे ईंयाँ ई नाचेया करना। <verse eid="2SA 6:21" /><verse number="22" style="v" sid="2SA 6:22" />ओर मां इजी ते बी जादा नबाग बणना ओर आपणी नजरा दे नीच ठईरना ओर जिना नौकराणिया री तैं चर्चा करी राखी तिना बी मेरा आदरमान करना।” <verse eid="2SA 6:22" /><verse number="23" style="v" sid="2SA 6:23" />इजी बजा ते शाऊलो री बेटी मीकला रे मरने रे दिना तक तेसा रे कोई ल्वाद नि ऊई।<verse eid="2SA 6:23" /></para>
  <chapter eid="2SA 6" />
  <chapter number="7" style="c" sid="2SA 7" />
  <para style="s">दाऊदो साथे परमेशरो रा वादा</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 7:1" />जेबे राजा दाऊद आपणे मईलो दे रओ था ओर यहोवे तेसखे तेसरे चऊँ कनारले दुश्मणा ते राम देई राखेया था, <verse eid="2SA 7:1" /><verse number="2" style="v" sid="2SA 7:2" />एक दिन राजा नातान नाओं रे भविष्यबक्ते खे बोलणे लगेया, “देख, आऊँ तो देवदारो रे बणे दे कअरो दे रऊँआ, पर परमेशरो रा सन्दूक तम्बूए दे रओआ।” <verse eid="2SA 7:2" /><verse number="3" style="v" sid="2SA 7:3" />नाताने राजे खे बोलेया, “जो कुछ तेरे मनो दे ए से कर; कऊँकि यहोवा तां साथे ए।” <verse eid="2SA 7:3" /><verse number="4" style="v" sid="2SA 7:4" />तेसा ई राती यहोवे रा ये वचन नातानो गे पऊँचेया, <verse eid="2SA 7:4" /><verse number="5" style="v" sid="2SA 7:5" />“जाई की मेरे दास दाऊदो खे बोल, यहोवा ईंयाँ बोलोआ, कि क्या तां माखे रणे खे कअर बनवाणा? <verse eid="2SA 7:5" /><verse number="6" style="v" sid="2SA 7:6" />जेस दिनो ते आऊँ इस्राएली लोका खे मिस्रो ते निकयाल़ी की ल्याया आजके दिनो तक आऊँ कदी बी कअरे नि रया, तम्बूए रे रणे रिया जगा दे आया-जाया करूँआ। <verse eid="2SA 7:6" /><verse number="7" style="v" sid="2SA 7:7" />जेती-जेती आऊँ सारे इस्राएली लोका बीचे फिरदा रया, क्या मैं केथी इस्राएली लोका रे केसी गोत्रो ते, जो मैं आपणी इस्राएली प्रजा खे चलाणे खे ठराई राखेया ओ, एड़ी गल्ल कदी बोली, कि तुसे लोके मेरिया तँईं देवदारो रा कअर कऊँ नि बणाया?” <verse eid="2SA 7:7" /><verse number="8" style="v" sid="2SA 7:8" />इजी री खातर एबे तूँ मेरे दास दाऊदो खे ईंयाँ बोल कि सेना रा यहोवा ईंयाँ बोलोआ, कि मैं तूँ पेडा री गवाईणी ते ओर पेडा-बाकरिया रे पीछे-पीछे फिरने ते, एते इच्छा ते बुलाई राखेया कि तूँ मेरी प्रजा इस्राएलो रा परदान ऊई जाए।<note caller="+" style="f"><char style="fr" closed="false">7:8 </char><char style="ft" closed="false">पज. 78:71</char></note> <verse eid="2SA 7:8" /><verse number="9" style="v" sid="2SA 7:9" />ओर जेती-केथी तूँ आया गया, तेती-तेती आऊँ तां साथे रया ओर तेरे सारे दुश्मण तेरे सामणे ते नाश कित्ते; तेबे मां तेरा नाओं तरतिया पाँदले बड़े-बड़े लोका रे नाओं जेड़ा महान करी देणा। <verse eid="2SA 7:9" /><verse number="10" style="v" sid="2SA 7:10" />ओर मां आपणी इस्राएली प्रजा खे एक जगा ठराणी ओर से स्थिर करनी, ताकि से आपणी ई जगा दे बसी री रओ ओर कदी चलदी-फिरदी नि रणी ओर बुरे लोका फेर तेसा खे कदी दु:ख नि देई सकणा, जेड़ा की पईले करो थे, <verse eid="2SA 7:10" /><verse number="11" style="v" sid="2SA 7:11" />बल्कि तेस बखतो ते बी जेबे आऊँ आपणी इस्राएली प्रजा पाँदे न्यायी ठराऊँ था; ओर मां ताखे तेरे सारे दुश्मणा ते राम देणा। यहोवा ताखे ये बी बोलोआ कि यहोवे तेरा कअर बणाया रा राखणा। <verse eid="2SA 7:11" /><verse number="12" style="v" sid="2SA 7:12" />जेबे तूँ मरी जाणा तूँ आपणे बुजुर्गा साथे मिली जाणा, तेबे मां तेरा निज पाऊ तां पीछे-खड़ा करी कि तेसरा राज्य पक्का करना। <verse eid="2SA 7:12" /><verse number="13" style="v" sid="2SA 7:13" />मेरे नाओं रा कअर तेस ई बनवाणा ओर मां तेसरी राजगद्दी सदा स्‍थिर राखणी।<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">(1 राज. 5:5)</char></note> <verse eid="2SA 7:13" /><verse number="14" style="v" sid="2SA 7:14" />आऊँ तेसरा बाओ ठईरना ओर से मेरा पाऊ ठईरना। जे से पाप करो, तो मां तेसखे सजा ते ओर मारा ते ताड़ना देणी, जेड़ा एक बाओ आपणे पाऊए खे सजा देओआ। <verse eid="2SA 7:14" /><verse number="15" style="v" sid="2SA 7:15" />पर मेरी दया तेस पाँदा ते ईंयाँ नि आटणी, जेड़ी मैं शाऊलो पाँदा ते टाई ली थी ओर तेसखे तेरे सामणे ते दूर कित्तेया था। <verse eid="2SA 7:15" /><verse number="16" style="v" sid="2SA 7:16" />बल्कि तेरा कराना ओर इस्राएलो रा राज्य मां सामणे सदा अटल़ बणेया दा रणा; तेरी गद्दी सदा बणी दी रणी।<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">(पज. 89:36,37 लूक. 1:32,33)</char></note> <verse eid="2SA 7:16" /><verse number="17" style="v" sid="2SA 7:17" />इना सारिया गल्ला ओर एस दर्शणो रे बारे दे जो नातान नबीए खे ऊए सेयो तिने सब दाऊदो खे बताई ते।<verse eid="2SA 7:17" /></para>
  <para style="s">दाऊदो री प्रार्थना</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 7:18" />तेबे दाऊद राजा पवित्र तम्बूए रे पीतरे जाई की यहोवे रे सामणे बैठेया ओर बोलणे लगेया, “ओ प्रभु यहोवा क्या बोलूँ ओर मेरा कराना क्या ए कि तैं आऊँ एथो तक पऊँचाई ता? <verse eid="2SA 7:18" /><verse number="19" style="v" sid="2SA 7:19" />तेबे बी ओ प्रभु यहोवा, ये तेरी नजरा दे छोटी जी गल्ल ऊई; कऊँकि तैं आपणे दासो रे कराने रे बारे दे आगले बऊत दिना तक री गल्ल-बात करी राखी, ओ प्रभु यहोवा, ये तो माणूंआ रा नियम ए। <verse eid="2SA 7:19" /><verse number="20" style="v" sid="2SA 7:20" />दाऊद ताखे ओर क्या बोली सकोआ? ओ प्रभु यहोवा, तूँ तो आपणे दासो खे जाणेया! <verse eid="2SA 7:20" /><verse number="21" style="v" sid="2SA 7:21" />तैं तो आपणे वचनो रे मुताबिक ओर आपणे ई मनो रे मुताबिक, ये सारा बड़ा काम करी राखेया, ताकि तेरा दास तिजी खे जाणी लो। <verse eid="2SA 7:21" /><verse number="22" style="v" sid="2SA 7:22" />इजी बजअ ते ओ यहोवा परमेशर, तूँ महान ए; कऊँकि जो कुछ आसे आपणे कानो ते सुणी राखेया, तेतेरे मुताबिक तां जेड़ा कोई नि ए ओर ना ई ताखे छाडी की ओर कोई परमेशर ए। <verse eid="2SA 7:22" /><verse number="23" style="v" sid="2SA 7:23" />फेर तेरी प्रजा इस्राएलो जेड़ा कुण ए? ये तो पूरी तरतिया दे एक ई जाति ए जो परमेशरे जाई की आपणी निज प्रजा करने खे छुड़ाई, इजी खे की से आपणा नाओं करो, (ओर तुसा रिया तँईं बड़े-बड़े काम करो) ओर तूँ आपणी प्रजा रे सामणे, जो तैं मिस्री बगैरा जातिया-जातिया रे लोक ओर तिना रे देवतेया ते छुड़ाई लये, आपणे देशो रिया तँईं खतरनाक काम कित्ते। <verse eid="2SA 7:23" /><verse number="24" style="v" sid="2SA 7:24" />ओर तैं आपणी प्रजा इस्राएलो खे आपणी सदा री प्रजा ऊणे खे ठराई ओर ओ यहोवा; तूँ आपू तेसा रा परमेशर ए। <verse eid="2SA 7:24" /><verse number="25" style="v" sid="2SA 7:25" />एबे ओ यहोवा परमेशर, तैं जो वचन आपणे दासो रे ओर तेसरे कराने रे बारे दे बोली राखेया, तिजी खे सदा खे पक्का कर ओर आपणे बोले रे मुताबिक ई कर, <verse eid="2SA 7:25" /><verse number="26" style="v" sid="2SA 7:26" />ओर ये कर कि लोक तेरे नाओं री महिमा सदा करदे रओ कि सेना रा यहोवा इस्राएलो पाँदे परमेशर ए ओर तेसरे दास दाऊदो रा कराना तां सामणे अटल़ रओ। <verse eid="2SA 7:26" /><verse number="27" style="v" sid="2SA 7:27" />कऊँकि ओ सेना रे यहोवा, ओ इस्राएलो रे परमेशर, तैं ये बोली की आपणे दासो पाँदे प्रगट करी राखेया कि मां तेरा कअर बणाया रा राखणा; इजी बजअ ते तेरे दासो खे तांते प्रार्थना करने रा याओ ऊई रा। <verse eid="2SA 7:27" /><verse number="28" style="v" sid="2SA 7:28" />एबे ओ प्रभु यहोवा, तूँ ई परमेशर ए ओर तेरे वचन सच्चे ए ओर तैं आपणे दासो खे ये पलाई करने रा वचन देई राखेया; <verse eid="2SA 7:28" /><verse number="29" style="v" sid="2SA 7:29" />तो एबे खुश ऊई की आपणे दासो रे कराने पाँदे एड़ी आशीष दे कि से तां सामणे सदा बणेया रा रओ; कऊँकि ओ प्रभु यहोवा, तैं एड़ा ई बोली राखेया ओर तेरे दासो रा कराना तांते आशीष पाई की सदा तन्य रओ।”<verse eid="2SA 7:29" /></para>
  <chapter eid="2SA 7" />
  <chapter number="8" style="c" sid="2SA 8" />
  <para style="s">दाऊदो री जीत</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 8:1" />कुछ बखतो ते बाद दाऊदे आपणी सेना लई की पलिश्ती सेना अराई। तिने पलिश्तिया री राजधानिया पाँदे आपणा कब्जा करी ला।<verse eid="2SA 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 8:2" />तेबे तिने मोआबी सेना बी अराई ती। तिने मोआबी कैदी तीऊँ पाल़िया दे जमीना पाँदे लेटणे खे मजबूर कित्ते। तिने सेयो सब जो दूई पाल़िया दे थे रस्सी लगाई की नापे ओर काईते। तिने सिर्फ तीजी पाल़िया रे लोक जिऊँदे रणे दित्ते। तेबे मोआबी लोक दाऊदो रे वशो दे ऊई की पेंट ल्याऊणे लगे।<verse eid="2SA 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 8:3" />जेबे सोबा प्रदेशो रे राजा रहोबो रा पाऊ हदादेजेर फरातो रे नेड़े आपणा राज्य फेर जिंयाँ का तिंयाँ करने जाणे लगी रा था, तेबे दाऊदे से जीती ला। <verse eid="2SA 8:3" /><verse number="4" style="v" sid="2SA 8:4" />ओर दाऊदे तेसते 1,700 सवार ओर 20,000 प्यादे छुड़ाई कि लई ले ओर सारे रथ वाल़े कोड़ेया री खुटिया री नस कटवाई, पर रथा वाल़े 100 कोड़े बचाईते।<verse eid="2SA 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 8:5" />जेबे दमिश्क शईरो ते अरामी<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="fq" closed="false">अरामी </char><char style="ft" closed="false">सीरिया </char></note> सेना सोबा रे राजा हदादेजेरो री सेना री मताद करने खे आए, तेबे दाऊदे अरामिया बीचा ते 22,000 सिपाई काई ते। <verse eid="2SA 8:5" /><verse number="6" style="v" sid="2SA 8:6" />तेबे दाऊदे दमिश्को रे अरामो दे सिपाईया री चौकिया बणाईया; ईंयाँ अरामी दाऊदो रे वशो दे ऊई की पेंट ल्याऊणे लगे ओर जेती-जेती दाऊद ओर तेसरी सेना जाओ थी तेती-तेती यहोवा तेसखे जीताओ था। <verse eid="2SA 8:6" /><verse number="7" style="v" sid="2SA 8:7" />हदादेजेरो रे कर्मचारिया गे सूईने रिया जो ढाला थिया तिना खे दाऊदो री सेना लई की यरूशलेम शईरो खे आए। <verse eid="2SA 8:7" /><verse number="8" style="v" sid="2SA 8:8" />ओर बेतह ओर बेरौताई नाओं रे हदादेजेरो रे शईरो ते दाऊद राजा बऊत सारा पीतल़ लई आया। <verse eid="2SA 8:8" /><verse number="9" style="v" sid="2SA 8:9" />जेबे हमाता रे राजा तोईए सुणेया कि दाऊदे री सेने हदादेजेरो री सारी सेना जीती ली री, <verse eid="2SA 8:9" /><verse number="10" style="v" sid="2SA 8:10" />तेबे तोईए योराम नाओं रा आपणा पाऊ दाऊद राजे गे तेसरा सुखसाँद पूछणे ओर से इजी री खातर मुबारकबाद देणे खे पेजेया कि तिने हदादेजेरो साथे लड़ी की से जीती ला था, कऊँकि से हदादेजेर तोईए री सेना साथे लड़ेया करो था। ओर योराम चाँदी, सूईना ओर पीतल़ी रे पांडे लई की आया। <verse eid="2SA 8:10" /><verse number="11" style="v" sid="2SA 8:11" />यो दाऊद राजे यहोवे रिया तँईं पवित्र करी की राखे ओर तेड़ा ई आपणी जीती री सब जातिया रे लोका रे सूईने चाँदिए साथे बी कित्तेया। <verse eid="2SA 8:11" /><verse number="12" style="v" sid="2SA 8:12" />मतलब अरामी, मोआबी, अम्मोनी, पलिश्ती ओर अमालेकिया रा सूईना चाँदी ओर रहोबो रे पाऊ सोबा रे राजा हदादेजेरो री लूट बी राखी।<verse eid="2SA 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 8:13" />जेबे दाऊद लूणो रिया काअटिया रे 18,000 अरामिया खे काई की वापस ऊआ, तेबे तेसरा नाओं चऊँ कनारे फैलीगा।<verse eid="2SA 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 8:14" />तेबे तिने एदोमो दे सिपाईया रिया चौकिया बणाईया; ओर पूरे एदोम प्रदेशो दे तिने चौकिया बणाई की तेती सिपाई राखी ते, ओर सारे एदोमी लोक दाऊदो रे वशो दे ऊईगे। ओर दाऊद आपणी सेना साथे जेती-जेती जाओ था तेती-तेती यहोवा तेसखे जीताओ था।<verse eid="2SA 8:14" /></para>
  <para style="s">दाऊदो रे काम करने वाल़ेया रे नाओं</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 8:15" />दाऊद तो सारे इस्राएलो पाँदे राज करो था ओर दाऊद आपणी सारी प्रजा साथे न्याय ओर तर्मो रे काम करो था। <verse eid="2SA 8:15" /><verse number="16" style="v" sid="2SA 8:16" />परदान सेनापति सरूयाह रा पाऊ योआब था; इतिआसो खे लिखणे वाल़ा अहीलूदो रा पाऊ यहोशापात था; <verse eid="2SA 8:16" /><verse number="17" style="v" sid="2SA 8:17" />अहीतूबो रा पाऊ सादोक ओर एब्यातारो रा पाऊ अहीमेलेक दोनो परदान पुरोईत थे; मंत्री सरायाह था; <verse eid="2SA 8:17" /><verse number="18" style="v" sid="2SA 8:18" />करेती ओर पलेतिया रा परदान यहोयादो रा पाऊ बनायाह था ओर दाऊदो रे पाऊ बी मुखिया अधिकारी थे।<verse eid="2SA 8:18" /></para>
  <chapter eid="2SA 8" />
  <chapter number="9" style="c" sid="2SA 9" />
  <para style="s">मपीबोशेतो पाँदे दाऊदो री दया</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 9:1" />एक दिन दाऊदे पूछेया, “क्या शाऊलो रे कराने बीचा ते एबुए तक कोई जिऊँदा बची रा, जेस पाँदे आऊँ योनातानो रिया बजअ ते दया दखाऊँ?” <verse eid="2SA 9:1" /><verse number="2" style="v" sid="2SA 9:2" />शाऊलो रे कराने रा सीबा नाओं रा एक काम करने वाल़ा था, से दाऊदो गे बुलाया ओर जेबे राजे तेसते पूछेया, “क्या तूँ सीबा ए?” तेबे तिने बोलेया, आ, “तेरा दास सेईए।” <verse eid="2SA 9:2" /><verse number="3" style="v" sid="2SA 9:3" />राजे पूछेया, “क्या शाऊलो रे कराने बीचे एबुए तक कोई जिऊँदा बची रा ए, जेस पाँदे आऊँ परमेशरो जेड़ी दया दखाऊँ?” सीबे राजे खे बोलेया, “आ, योनातानो रा एक पाऊ जिऊँदा तो आए, पर से लंगड़ा ए।” <verse eid="2SA 9:3" /><verse number="4" style="v" sid="2SA 9:4" />राजे तेसते पूछेया, “से केई आ?” सीबे राजे खे बोलेया, “से तो लोदबार शईरो दे, अम्मीएलो रे पाऊ माकीरो रे कअरे रओआ।” <verse eid="2SA 9:4" /><verse number="5" style="v" sid="2SA 9:5" />तेबे दाऊद राजे दूत पेजी की से लोदबारो ते, अम्मीएलो रे पाऊ माकीरो रे कअरो ते बुलाई ला।<verse eid="2SA 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 9:6" />जेबे मपीबोशेत, जो योनातानो रा पाऊ ओर शाऊलो रा पोता था, दाऊदो गे आया, तेबे मुंए रे पारे थाले पड़ी की माथा टेकेया। दाऊदे बोलेया, “ओ मपीबोशेत!” तिने बोलेया, “आऊँ तेरा दास तेरिया तँईं क्या करी सकूँआ?” <verse eid="2SA 9:6" /><verse number="7" style="v" sid="2SA 9:7" />दाऊदे तेसखे बोलेया, “डर नि; तेरे बाओ योनातानो रिया बजअ ते मां तां पाँदे जरूर दया करनी ओर तेरे दादे शाऊलो री सारी जमीन ताखे वापस देई देणी ओर तां मेरिया मेजा पाँदे रोज रोटी खाया करनी।” <verse eid="2SA 9:7" /><verse number="8" style="v" sid="2SA 9:8" />मपीबोपोशेते फेर दाऊदो रे सामणे माथा टेकी की बोलेया, “ओ स्वामी, आऊँ मरे दे कुत्ते जेड़ा ए, आऊँ एते जोगा नि ए कि तूँ मां पाँदे दया करे।” <verse eid="2SA 9:8" /><verse number="9" style="v" sid="2SA 9:9" />तेबे राजे शाऊलो रे कर्मचारी सीबा खे बुलाई की तेसखे बोलेया, “जो कुछ शाऊल ओर तेसरे सारे कराने रा था से मैं तेरे स्वामिए रे पोते खे देईता रा। <verse eid="2SA 9:9" /><verse number="10" style="v" sid="2SA 9:10" />आजो ते तूँ आपणे माठे ओर सेवका समेत तेसरी जमीना दे जिम्मीदारा करी की तिजी री उपज ल्याया कर, ताकि तेरे स्वामिए रे पाऊए खे रोटी मिलेया करो, पर तेरे स्वामिए रे पोते मपीबोशेतो मेरी मेजा पाँदे रोज रोटी खाया करनी।” ओर सीबा रे तो 15 पाऊ ओर 20 सेवा करने वाल़े थे। <verse eid="2SA 9:10" /><verse number="11" style="v" sid="2SA 9:11" />सीबे राजे खे बोलेया, “मेरा स्वामी राजा आपणे दासो खे जो आज्ञा देयो, तिना सबी रे मुताबिक तेरे दासा करना।” तदुए ते ई मपीबोशेत राजकुमारा जेड़ा राजे री मेजा पाँदे रोटी खाणे लगेया।<verse eid="2SA 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 9:12" />मपीबोशेतो रे बी मीका नाओं रा एक छोटा पाऊ था। ओर सीबा रे कअरे जितणे लोक रओ थे सेयो सारे मपीबोशेतो री सेवा करो थे। <verse eid="2SA 9:12" /><verse number="13" style="v" sid="2SA 9:13" />मपीबोशेत जो दुँईं पैरा ते लंगड़ा था, यरूशलेम शईरो दे रओ था; ओर से राजे री मेजा पाँदे रोज रोटी खाया करो था।<verse eid="2SA 9:13" /></para>
  <chapter eid="2SA 9" />
  <chapter number="10" style="c" sid="2SA 10" />
  <para style="s">दाऊदो रा अम्मोनिया खे अराणा</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 10:1" />कुछ बखतो ते बाद अम्मोनिया रा राजा नाहाश मरी गा ओर तेसरा हानून नाओं रा पाऊ तेसरी जगा पाँदे राजा ऊआ। <verse eid="2SA 10:1" /><verse number="2" style="v" sid="2SA 10:2" />तेबे दाऊदे ये सोचेया, “जिंयाँ हानूनो रे बाओ नाहाशे मां साथे दया दखाई राखी थी, तिंयाँ ई मां बी हानूनो साथे दया दखाणी।” तेबे दाऊदे आपणे कई काम करने वाल़ेया खे तेसगे तेसरे बाओ री मौता रे बारे दे शान्ति देणे खे पेजी ते। ओर दाऊदो रे काम करने वाल़े अम्मोनिया रिया जमीना पाँदे आए। <verse eid="2SA 10:2" /><verse number="3" style="v" sid="2SA 10:3" />पर अम्मोनिया रे परदान आपणे स्वामी हानूनो खे बोलणे लगे, “दाऊदे जो तांगे शान्ति देणे वाल़े पेजी राखे, सेयो क्या तेरी समजा ते तेरे बाओ री इज्जत करने रे बिचारो ते पेजी राखे? ना, दाऊदे सेयो तांगे एते बिचारो ते पेजी राखे कि एते शईरो दे टोल़-टाल़ करी की ओर इजी रा पेत लई की इजी पाँदे अमला करो।” <verse eid="2SA 10:3" /><verse number="4" style="v" sid="2SA 10:4" />तेबे हानूने दाऊदो रे काम करने वाल़े पकड़ी ते ओर तिना री आदी-आदी दाढ़ी कटवाई की ओर टाल्ले लको ते लई की जानूआ तक बडाई की सेयो जाणे दित्ते।<verse eid="2SA 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 10:5" />जेबे एते गल्ला रा पता दाऊदो खे लगेया तेबे तिने कुछ लोक तिना साथे मिलणे खे पेजे, कऊँकि सेयो राजे रे सामणे आऊणे ते बऊत शर्माणे लगी रे थे ओर सेयो वापस कअरे नि जाणा चाओ थे। तेबे राजे ये बोलेया, “जदुओ तक तुसा री दाढ़ी बढ़ी नि जाओ, तदुओ तक यरीहो देई रूके दे रओ, तेबे वापस आई जाएयो।”<verse eid="2SA 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 10:6" />जेबे अम्मोनिये देखेया कि दाऊद आसा रा दुश्मण बणी गा दा ए, तेबे अम्मोनिये बेत्रहोब ओर सोबा रे 20,000 अरामी<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="fq" closed="false">अरामी </char><char style="ft" closed="false">सीरिया </char></note> सिपाई, ओर माका रे राजे रे 1,000 सिपाई, ओर 12,000 तोब शईरो ते सिपाई, त्याड़िया पाँदे बुलवाए। <verse eid="2SA 10:6" /><verse number="7" style="v" sid="2SA 10:7" />ये सुणी की दाऊदे योआब ओर शूरवीरा री सारी सेना लड़ने खे पेजी। <verse eid="2SA 10:7" /><verse number="8" style="v" sid="2SA 10:8" />तेबे अम्मोनी सिपाई निकल़े ओर बड़े द्वारो गेई खड़ी गे ओर सोबा ओर रहोबो रे अरामी ओर तोब ओर माका रे सिपाई तिना ते लग मैदानो दे थे। <verse eid="2SA 10:8" /><verse number="9" style="v" sid="2SA 10:9" />जेबे योआबे ये देखेया कि आसा रे आगे-पीछे दुँईं तरफा खे म्हारे खलाफ सेना खड़ी री तेबे तिने आपणे सारे बड़े-बड़े इस्राएली सिपाईया बीचा ते बऊत सारे छाँटी की अरामिया रे सामणे लड़ने खड़े करीते, <verse eid="2SA 10:9" /><verse number="10" style="v" sid="2SA 10:10" />ओर बाकी सैनिक आपणे पाई अबीशै रे आथो दे सम्बाल़ीते ताकि सेयो अम्मोनिया साथे लड़ने खे त्यार रओ।<verse eid="2SA 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 10:11" />तेबे योआबे तेसखे बोलेया, “जे अरामी सिपाई मां पाँदे जितणे लगो, तेबे तैं मेरी मताद करनी ओर जे अम्मोनी ताखे अराणे लगो, तो मां आई की तेरी मताद करनी। <verse eid="2SA 10:11" /><verse number="12" style="v" sid="2SA 10:12" />तूँ याओ बान ओर आसा आपणे लोका खे ओर आपणे परमेशरो रे शईरो रिया तँईं लड़ना चाईयो ओर यहोवा जेड़ा तेसखे अच्छा लगो तेड़ा ई करो।”<verse eid="2SA 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 10:13" />तेबे योआब ओर जो सिपाई तेस साथे थे अरामिया साथे लड़ने खे नेड़े गए ओर अरामी सिपाई तिना सामणे ते नठीगे। <verse eid="2SA 10:13" /><verse number="14" style="v" sid="2SA 10:14" />ये देखी की कि अरामी नठीगे रे अम्मोनी सिपाई बी अबीशै रे सामणे ते नठी की शईरो ते पीतरे कूसी गे। तेबे योआब अम्मोनिया गे ते वापस ऊई की यरूशलेम शईरो खे आया। <verse eid="2SA 10:14" /><verse number="15" style="v" sid="2SA 10:15" />तेबे ये देखी की कि आसे इस्राएली लोका ते आरी गे रे सारे अरामी कट्ठे ऊए। <verse eid="2SA 10:15" /><verse number="16" style="v" sid="2SA 10:16" />तिना रे राजा हदादेजेरे दूत पेजी की फरातो ते पारले अरामी सिपाई बुलाए ओर सेयो हदादेजेरो रे सेनापति शोबको खे आपणा परदान बणाई की हेलाम शईरो खे आए। <verse eid="2SA 10:16" /><verse number="17" style="v" sid="2SA 10:17" />जेबे दाऊदो खे इजी रा पता लगेया तेबे तिने सारे इस्राएली सिपाई कट्ठे कित्ते ओर यरदन नदिया ते पार ऊई की हेलामो दे पऊँचेया। तेबे अरामिये दाऊदो रे खलाफ सेना लई की तेस साथे लड़े। <verse eid="2SA 10:17" /><verse number="18" style="v" sid="2SA 10:18" />पर अरामी इस्राएली लोका सामणे ते नठीगे ओर दाऊदे अरामिया बीचा ते 700 रथ चलाणे वाल़े ओर 40,000 कोड़ेया रे सवार काई ते ओर तिना रे सेनापति शोबक एड़ा काईल कित्तेया कि से तेथी मरी गा। <verse eid="2SA 10:18" /><verse number="19" style="v" sid="2SA 10:19" />ये देखी की कि आसे इस्राएली लोका ते आरी गे रे, जितणे राजा हदादेजेरो रे वशो दे थे तिने सबी इस्राएली लोका साथे मलाप करी ला ओर तिना री सेवा करने लगे। तेबे अरामी अम्मोनिया री ओर मताद करने ते डरी गे।<verse eid="2SA 10:19" /></para>
  <chapter eid="2SA 10" />
  <chapter number="11" style="c" sid="2SA 11" />
  <para style="s">दाऊद ओर बतशेबा</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 11:1" />फेर जेस बखते राजा लोक युद्ध करने खे निकल़ेया करो थे मतलब सालो रे शुरूए दे। दाऊदे तेसी बखते योआब ओर तेस साथे आपणे सब परदान ओर सारी इस्राएली सेना खे युद्ध करने खे पेजेया। तिने अम्मोन देश नाश करिता, ओर रब्बा शईरो पाँदे अमला कित्तेया। पर दाऊद आपू यरूशलेम शईरो देई रई गा। <verse eid="2SA 11:1" /><verse number="2" style="v" sid="2SA 11:2" />एक दिन साँजके बखते दाऊद माँजे पाँदा ते उठी की राजमईलो रे छतो पाँदे कूमणे लगी रा था ओर छतो पाँदा ते तेसखे एक जवाणस, जो बऊत बांकी थी, नांह्दी ऊई दिखी। <verse eid="2SA 11:2" /><verse number="3" style="v" sid="2SA 11:3" />जेबे दाऊदे आपणे केसी दूतो खे पेजी की तेसा जवाणसा रे बारे दे पता लगाणे खे बोलेया, तेबे तिने दूते वापस आई की दाऊदो खे दसेया, “से एलीआमो री बेटी ओर हित्ती ऊरिय्याह री लाड़ी बतशेबा ए।”<verse eid="2SA 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 11:4" />तेबे राजा दाऊदे दूत पेजी की से जवाणस बुलाई ली ओर से दाऊदो गे आई ओर से तेसा साथे सया। (से तो मासिक तर्मो ते शुद्ध ऊई गी थी) तेबे से आपणे कअरो खे वापस ऊई गी। <verse eid="2SA 11:4" /><verse number="5" style="v" sid="2SA 11:5" />कुछ बखतो ते बाद से जवाणस गर्भवती ऊई ओर तेसे दाऊदो गे सन्देशा पेजेया कि आऊँ गर्भवती ए। <verse eid="2SA 11:5" /><verse number="6" style="v" sid="2SA 11:6" />तेबे दाऊदे योआबो खे सन्देशा पेजेया, “हित्ती जातिया रे ऊरिय्याह नाओं रे माणूंए खे मांगे पेज।” तेबे योआबे ऊरिय्याह दाऊदो गे पेजीता। <verse eid="2SA 11:6" /><verse number="7" style="v" sid="2SA 11:7" />जेबे ऊरिय्याह तेसगे आया, तेबे दाऊदे तेसते योआब ओर सेना रा सुखसाँद ओर युद्धो रा आल पूछेया। <verse eid="2SA 11:7" /><verse number="8" style="v" sid="2SA 11:8" />तेबे दाऊदे ऊरिय्याह खे बोलेया, “आपणे कअरे जाई की राम कर।” जेबे ऊरिय्याह राजमईलो ते बारे निकल़ेया तेबे राजे बादो ते तेसखे कुछ ईनाम पेजेया। <verse eid="2SA 11:8" /><verse number="9" style="v" sid="2SA 11:9" />पर ऊरिय्याह आपणे स्वामिए रे सारे सेवका साथे राजमईलो रे द्वारो रे नेड़े ई लेटीगा ओर आपणे कअरे नि गया। <verse eid="2SA 11:9" /><verse number="10" style="v" sid="2SA 11:10" />जेबे दाऊदो खे ये सन्देश मिलेया कि ऊरिय्याह आपणे कअरे नि गया, तेबे दाऊदे ऊरिय्याहो खे बोलेया, “तूँ तो इतणी दूरा ते आई रा, तेबे तूँ आपणे कअरे कऊँ नि गया?” <verse eid="2SA 11:10" /><verse number="11" style="v" sid="2SA 11:11" />ऊरिय्याहे दाऊदो खे बोलेया, “जेबे परमेशरो रा सन्दूक, ओर इस्राएली लोक ओर यहूदा रे लोक तम्बूआ दे रओए ओर मेरा स्वामी योआब ओर मेरे स्वामिए रे सेवके खुले मैदानो दे डेरे लगाई राखे, तो क्या आऊँ कअरे जाई की खाऊँ, पियूँ ओर आपणी लाड़िया साथे सऊँ? तेरी जिन्दगिया री कसम ओर तेरे प्राणो री कसम, आऊँ एड़ा काम नि करी सकदा।” <verse eid="2SA 11:11" /><verse number="12" style="v" sid="2SA 11:12" />दाऊदे ऊरिय्याहो खे बोलेया, “आज एथी रओ ओर काल मां तूँ लड़ाईया खे पेजी देणा।” इजी री खातर ऊरिय्याह तेस दिने ओर दूजे दिने बी यरूशलेम शईरो देई रया। <verse eid="2SA 11:12" /><verse number="13" style="v" sid="2SA 11:13" />फेर दाऊदे तेसखे खाणे रा निऊँदा देई की आपू गे बुलाया ओर ऊरिय्याहे दाऊदो साथे खाया-पिया ओर तिने से शराब पिल़ाई की मतवाल़ा कित्तेया ओर साँजा खे से आपणे स्वामिए रे सेवका साथे सऊणे खे निकल़ेया, पर आपणे कअरे नि गया।<verse eid="2SA 11:13" /></para>
  <para style="s">दाऊदो रा ऊरिय्याह खे काणे री योजना बनाणा</para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 11:14" />तेतेरे दूजे दिने प्यागा दाऊदे योआबो रे नाओं पाँदे एक पर्ची लिखी की ऊरिय्याह रे आथो दे पेजी ती। <verse eid="2SA 11:14" /><verse number="15" style="v" sid="2SA 11:15" />तेते पर्चिया दे ये लिखी राखेया था, “जेती जादा लड़ाई ऊणे लगी री तेती ऊरिय्याह खे पेज, तेबे तेसखे छाडी की वापस ऊई जाणा, ताकि से काईल ऊई की मरी जाओ।”<verse eid="2SA 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 11:16" />इजी ते बाद योआबे शईरो खे ठीक-टंगो रे देखी की जेते जगा खे से जाणो था कि वीर ए, तेथी ऊरिय्याह ठराईता। <verse eid="2SA 11:16" /><verse number="17" style="v" sid="2SA 11:17" />तेबे शईरो रे लोके निकल़ी की योआबो साथे युद्ध कित्तेया ओर लोका बीचा ते, मतलब दाऊदो रे सेवको बीचा ते बऊत मरी गे ओर तिना बीचे हित्ती ऊरिय्याह बी मरी गा। <verse eid="2SA 11:17" /><verse number="18" style="v" sid="2SA 11:18" />तेबे योआबे दूत पेजी की दाऊदो खे युद्धो रा पूरा आल बताया; <verse eid="2SA 11:18" /><verse number="19" style="v" sid="2SA 11:19" />ओर दूतो खे आज्ञा दित्ती, “जेबे तूँ युद्धो रा पूरा आल राजे खे बताई चुके, <verse eid="2SA 11:19" /><verse number="20" style="v" sid="2SA 11:20" />तेबे जे राजा गुस्से दे बोलणे लगो कि तुसे लोक लड़ने खे शईरो रे इतणे नेड़े कऊँ गये? क्या तुसा खे पता नि था कि तिना लोका दवाला पाँदा ते तीर छाडणे? <verse eid="2SA 11:20" /><verse number="21" style="v" sid="2SA 11:21" />क्या तुसे नि जाणदे कि यरूब्बेशेतो रा पाऊ अबीमेलेक किने काया? तेती एक जवाणस शईरो री दवाला पाँदे थी जेसे चाक्किया रा पाँदला पाट अबीमेलेको पाँदे सेटेया। तेसे जवाणसे से तेबेसो दे काया। तेबे तुसे दवाला रे एड़े नेड़े कऊँ गये? जे राजा दाऊद ये पूछो तो तुसे ये ज्वाब देणा कि तेरा दास ऊरिय्याह हित्ती बी मरी गा।” <verse eid="2SA 11:21" /><verse number="22" style="v" sid="2SA 11:22" />तेबे दूत चली गा ओर जाई की दाऊदो खे योआबो रिया सारिया गल्ला सुणाईयां। <verse eid="2SA 11:22" /><verse number="23" style="v" sid="2SA 11:23" />दूते दाऊदो खे बोलेया, “सेयो लोक प्रचंड ऊई की मैदानो दे आसा सामणे निकल़ी की आए, तेबे आसे सेयो बड़े द्वारो तक नठाए। <verse eid="2SA 11:23" /><verse number="24" style="v" sid="2SA 11:24" />तेबे धनुष चलाणे वाल़ेया दवाला पाँदा ते तेरे माणूंआ पाँदे तीर छाडे ओर राजे रे बऊत माणूं मरी गे ओर तेरा दास ऊरिय्याह हित्ती बी मरी गा।” <verse eid="2SA 11:24" /><verse number="25" style="v" sid="2SA 11:25" />दाऊदे दूतो खे बोलेया, “योआबो खे ईंयाँ बोलणा कि इजी गल्ला रिया बजअ ते उदास नि ऊणा, कऊँकि तलवार जिंयाँ एसखे तिंयाँ ई तेसखे बी नाश करोई, तो तूँ शईरो रे खलाफ जादा मजबूतिया साथे लड़ी की तेसखे जबाब दे। ओर तूँ तेसखे याओ दे।” <verse eid="2SA 11:25" /><verse number="26" style="v" sid="2SA 11:26" />जेबे ऊरिय्याह री लाड़ी बतशेबे सुणेया कि मेरा लाड़ा मरी गा, तेबे से आपणे लाड़े रिया तँईं रोणे-पीटणे लगी। <verse eid="2SA 11:26" /><verse number="27" style="v" sid="2SA 11:27" />ओर जेबे तेसा रे शोगो रे दिन बीती चुके, तेबे दाऊदे से बुलाई की आपणे कअरे राखी ती ओर से तेसरी लाड़ी बणीगी ओर तेसा रे एक पाऊ ऊआ। पर तेस कामो ते जो दाऊदे कित्तेया था यहोवा रोषे ऊईगा।<verse eid="2SA 11:27" /></para>
  <chapter eid="2SA 11" />
  <chapter number="12" style="c" sid="2SA 12" />
  <para style="s">नातानो रे जरिये दाऊदो खे सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 12:1" />तेबे यहोवे राजा दाऊदो गे नातान नबी पेजेया ओर से तेसगे जाई की बोलणे लगेया, “एकी शईरो दे दो माणूं रओ थे, जिना बीचा ते एक अमीर ओर दूजा गरीब था। <verse eid="2SA 12:1" /><verse number="2" style="v" sid="2SA 12:2" />अमीरो गे तो बऊत सारिया पेडा-बाकरिया ओर गायी-बल़द थे; <verse eid="2SA 12:2" /><verse number="3" style="v" sid="2SA 12:3" />पर गरीबो गे पेडा रे एक छोटे जे बच्चे खे छाडी की ओर कुछ पनि था ओर तिने से केसी ते मोले लई राखी थी। से तेसरे कअरे तेसरे बच्चेया साथे ई पल़ी थी; से तेसरे टुकड़ेया बीचा ते खाओ थी ओर तेसरे कटोरे बीचा ते पाणी पियो थी ओर तेसरी गोदा दे सओ थी ओर से तेसरी बेटिया जेड़ी थी। <verse eid="2SA 12:3" /><verse number="4" style="v" sid="2SA 12:4" />एक दिन अमीरो गे एक यात्री आया ओर तिने तेस यात्रिये खे, जो तेसगे आया था, रोटी बनाणे खे आपणी पेडा-बाकरिया या गायी-बल़दा बीचा ते कुछ नि लया। तिने गरीब माणूंए री पेडा री बच्ची लई ली, ओर आपणे कअरे आए दे माणूंए खे तिजी रा मास पकाया।”<verse eid="2SA 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 12:5" />जेबे दाऊदे ये सुणेया तेबे से बऊत गुस्सा ऊआ। तेबे तिने नातानो खे बोलेया, “यहोवे री जिन्दगिया री कसम, जिने माणूंए एड़ा काम करी राखेया से मौता री सजा जोगा ए; <verse eid="2SA 12:5" /><verse number="6" style="v" sid="2SA 12:6" />ओर तेसखे तेसा पेडा री बच्चिया रा चार गुणा परी की देणा पड़ना, कऊँकि तिने एड़ा काम करी राखेया ओर तेस गरीब माणूंए पाँदे कोई दया नि कित्ती।”<verse eid="2SA 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 12:7" />तेबे नाताने दाऊदो खे बोलेया, “तूँ ई से माणूं ए। इस्राएलो रा यहोवा परमेशर ईंयाँ बोलोआ कि मैं तेरा अभिषेक करी की तूँ इस्राएलो रा राजा ठराया ओर मैं तूँ शाऊलो रे आथो ते बचाया; <verse eid="2SA 12:7" /><verse number="8" style="v" sid="2SA 12:8" />फेर मैं तेरे स्वामिए रा मईल ताखे दित्तेया ओर तेरे स्वामिए रिया लाड़िया ताखे दित्तिया; ओर मैं इस्राएल ओर यहूदा रा कराना ताखे दित्तेया था ओर जे ये थोड़ा था, तो आऊँ ताखे ओर बी बऊत कुछ देणे वाल़ा था। <verse eid="2SA 12:8" /><verse number="9" style="v" sid="2SA 12:9" />तैं यहोवे री आज्ञा तुच्छ जाणी की से काम कऊँ कित्तेया, जो यहोवे री नजरा दे बुरा था? हित्ती ऊरिय्याह तैं तलवारी साथे काया ओर तेसरी लाड़ी आपणी बणाई ली ओर ऊरिय्याह अम्मोनिया ते मरवाया। <verse eid="2SA 12:9" /><verse number="10" style="v" sid="2SA 12:10" />इजी री खातर तलवार एबे तेरे कअरो ते कदी दूर नि ऊणी, कऊँकि तैं आऊँ तुच्छ जाणी की हित्ती ऊरिय्याह री लाड़ी आपणी लाड़ी बणाई ली।” <verse eid="2SA 12:10" /><verse number="11" style="v" sid="2SA 12:11" />यहोवा ईंयाँ बोलोआ “सुण, मां तेरे कअरो ते मुसीबता चकी की तां पाँदे पाणिया ओर तेरिया लाड़िया तां सामणे ते दूर करी की दूजे खे देई देणियां ओर तिना दिने-दपैरे तेरी लाड़िया साथे कुकर्म करना। <verse eid="2SA 12:11" /><verse number="12" style="v" sid="2SA 12:12" />तैं तो से काम चोरिए कित्तेया; पर मां ये काम सारे इस्राएली लोका सामणे दिने-दपैरे करवाणा।”<verse eid="2SA 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 12:13" />तेबे दाऊदे नातानो खे बोलेया, “मैं यहोवे रे खलाफ पाप करी राखेया।” नाताने दाऊदो खे बोलेया, “यहोवे तेरा पाप दूर करी राखेया, एते पापो रिया बजा ते तूँ नि मरना। <verse eid="2SA 12:13" /><verse number="14" style="v" sid="2SA 12:14" />तेबे बी तैं एस कामो रे जरीये यहोवे रे दुश्मणा खे बेज्जत करने रा बड़ा मोका देई राखेया, इजी बजअ ते तेरा जो पाऊ जमीं रा, से पक्का ई मरना।”<verse eid="2SA 12:14" /></para>
  <para style="s">दाऊदो रे पाऊए री मौत</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 12:15" />तेबे नातान आपणे कअरो खे चली गा। तेबे जो पाऊ ऊरिय्याह री लाड़ी बतशेबा ते दाऊदो रे जरीये पैदा ऊआ था, से यहोवे रा मारा बऊत बमार ऊईगा। <verse eid="2SA 12:15" /><verse number="16" style="v" sid="2SA 12:16" />तेबे दाऊद तेस पाऊए रिया तँईं परमेशरो ते बिनती करने लगेया कि बच्चा नि मरना चाईयो ओर बअरत राखेया ओर पीतरे जाई की पूरी रात जमीना दे पड़ेया दा रया। <verse eid="2SA 12:16" /><verse number="17" style="v" sid="2SA 12:17" />आगले दिने प्यागा तेसरे कराने रे बुजुर्ग उठी की तेसखे जमीना पाँदा ते ऊबे चकणे खे तेसगे गये; पर से नि उठेया ओर ना तिना साथे रोटी खाई। <verse eid="2SA 12:17" /><verse number="18" style="v" sid="2SA 12:18" />सातुए दिने बच्चा मरी गा ओर दाऊदो रे कर्मचारी तेसरे बच्चे रे मरने रा सन्देश देणे ते डरे; तिने तो बोलेया था, “जदुओ तक बच्चा जिऊँदा था, तदुओ तक तिने म्हारे समजयाणे पाँदे त्यान नि दित्तेया; जे आसे तेसरे बच्चे रे मरने रा सन्देश सुणाऊँगे, तो से बऊत ई जादा दु:खी ऊणा।”<verse eid="2SA 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 12:19" />आपणे कर्मचारिया खे आपू बीचे खस-फस करदे ऊए देखी की दाऊदो खे जाणकारी ऊईगी कि बच्चा मरी गा; तेबे दाऊदे आपणे कर्मचारिया ते पूछेया, “क्या बच्चा मरी गा?” तिने बोलेया, “आ, मरी गा रा।” <verse eid="2SA 12:19" /><verse number="20" style="v" sid="2SA 12:20" />तेबे दाऊद जमीना पाँदा ते उठेया ओर नाह्यी की तेल लगाया ओर टाल्ले बदले; फेर यहोवे रे मन्दरो दे जाई की माथा टेकेया, तेबे आपणे मईलो दे आया ओर तेसरी आज्ञा पाँदे तेसखे रोटी परोसी ओर तिने रोटी खाई। <verse eid="2SA 12:20" /><verse number="21" style="v" sid="2SA 12:21" />तेबे तेसरे कर्मचारिये तेसते पूछेया, “तैं ये केड़ा काम करी राखेया? जदुए तक बच्चा जिऊँदा रया, तदुओ तक तूँ बअरत करदा ऊआ रोंदा रया; पर जिंयाँ ई बच्चा मरेया, तिंयाँ ई तूँ उठी की रोटी खाणे लगेया।” <verse eid="2SA 12:21" /><verse number="22" style="v" sid="2SA 12:22" />तिने ज्वाब दित्तेया, “जदुओ तक बच्चा जिऊँदा रया तदुओ तक आऊँ ये सोची की बअरत करदा ओर रोंदा रया, कि क्या पता यहोवा मां पाँदे एड़ी दया करो कि बच्चा जिऊँदा रओ। <verse eid="2SA 12:22" /><verse number="23" style="v" sid="2SA 12:23" />पर एबे से मरी गा, तेबे आऊँ बअरत कऊँ करुँ? क्या आऊँ तेसखे वापस ल्याई सकूँआ? आऊँ तो तेसगे जाणा, पर से मांगे वापस नि आई सकदा।”<verse eid="2SA 12:23" /></para>
  <para style="s">सुलैमानो रा जन्म</para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 12:24" />तेबे दाऊदे आपणी लाड़ी बतशेबा खे शान्ति दित्ती ओर से तेसा गे गया ओर से गर्भवती ऊई ओर तेसा रे एक पाऊ पैदा ऊआ ओर तिने तेसरा नाओं सुलैमान राखेया ओर से यहोवे रा प्यारा ऊआ।<note caller="+" style="f"><char style="fr" closed="false">12:24 </char><char style="ft" closed="false">मत्ती 1:6</char></note> <verse eid="2SA 12:24" /><verse number="25" style="v" sid="2SA 12:25" />ओर तिने नातान भविष्यबक्ते रे जरीये सन्देश पेजेया ओर तिने यहोवे रिया बजअ ते तेसरा नाओं यदिद्याह राखेया जेतेरा मतलब ए यहोवे रा प्यारा।<verse eid="2SA 12:25" /></para>
  <para style="s">रब्बाह शईरो रा बर्बाद ऊणा</para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 12:26" />एते बीचे योआबे अम्मोनिया रे रब्बाह शईरो ते लड़ी की से शईर लई ला। <verse eid="2SA 12:26" /><verse number="27" style="v" sid="2SA 12:27" />तेबे योआबे दूता रे जरिये दाऊदो गे सन्देशा पेजेया, “आऊँ रब्बाह शईरो साथे लड़ेया ओर पाणिए वाल़ा शईर लई ला रा। <verse eid="2SA 12:27" /><verse number="28" style="v" sid="2SA 12:28" />इजी खे तूँ एबे बाकी बचे रे लोका खे कट्ठे करी की शईरो रे खलाफ डेरे पाई की तेस बी लई लो, एड़ा नि ओ कि आऊँ तिजी खे लई लूँ ओर से मेरे नाओं रा बोलेया जाओ।” <verse eid="2SA 12:28" /><verse number="29" style="v" sid="2SA 12:29" />तेबे दाऊद सारे लोका खे कट्ठा करी की रब्बाह शईरो खे गया ओर तेस साथे लड़ी की से लई ला। <verse eid="2SA 12:29" /><verse number="30" style="v" sid="2SA 12:30" />तेबे तिने तिना रे राजे रा मुकुट, जो बजनो दे चौंती किलो रा था ओर तिदे मणि जड़े रे थे, से तेसरे सिरो पाँदा ते उतारेया ओर से दाऊदो रे सिरो पाँदे राखेया। तेबे तिना खे तेते शईरो री बऊत सारी किमती लूट मिली। <verse eid="2SA 12:30" /><verse number="31" style="v" sid="2SA 12:31" />तिने तेथो रे रणे वाल़े लोक निकयाल़ी की तिना ते ये काम करवाये मतलब कुछ लोका ते आरिया साथे लकड़िया रे टुकड़े कराए ओर कुछ गैंती लई की माट्टिया रा काम करवाया ओर कुछ लोका ते लोए री क्वाड़िया साथे लकड़ी बडाई ओर जबरदस्ती ईटा बणवाईया ओर अम्मोनिया रे सारे शईरो साथे बी तिने एड़ा ई कित्तेया। तेबे दाऊद सारे लोका समेत यरूशलेम शईरो खे वापस आईगा।<verse eid="2SA 12:31" /></para>
  <chapter eid="2SA 12" />
  <chapter number="13" style="c" sid="2SA 13" />
  <para style="s">अम्नोन ओर तामार</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 13:1" />दाऊदो री तामार नाओं री एक सुन्दर बेटी जो अबशालोमो री बईण थी, तेसा खे दाऊदो रा पाऊ अम्नोन पसन्द करने लगेया। <verse eid="2SA 13:1" /><verse number="2" style="v" sid="2SA 13:2" />तेबे अम्नोन आपणी बईण तामारा रिया बजअ ते एड़ा कमजोर ऊआ कि बमार पड़ीगा; कऊँकि से कुआँरी थी ओर तेसा खे आसिल करना अम्नोनो खे कठण लगो था। <verse eid="2SA 13:2" /><verse number="3" style="v" sid="2SA 13:3" />पर अम्नोनो रे योनादाब नाओं रा एक दोस्त था, जो दाऊदो रे पाई शिमआह रा पाऊ था ओर से बड़ा चलाक था। <verse eid="2SA 13:3" /><verse number="4" style="v" sid="2SA 13:4" />एक दिन योनादाबे अम्नोनो खे बोलेया, “ओ राजकुमार, क्या बजअ ए कि तूँ दिन प्रतिदिन एड़ा कमजोर ऊणे लगी रा क्या तां मांगे नि बताणा?” अम्नोने तेसखे बोलेया, “आऊँ तो आपणे सौतेले पाई अबशालोमो री बईण तामारा ते प्यार करूँआ।” <verse eid="2SA 13:4" /><verse number="5" style="v" sid="2SA 13:5" />योनादाबे तेसखे बोलेया, “आपणे माँजे पाँदे लेटी की बमार ऊणे रा टोंग कर ओर जेबे तेरा बाओ ताखे देखणे खे आओ, तेबे तेसखे बोलणा, मेरी बईण तामार आई की माखे रोटी खुल़ाओ। से मां सामणे रोटी बणाओ, ताकि आऊँ तेसा खे देखी की तेसा रे आथो साथे खाऊँ।”<verse eid="2SA 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 13:6" />तेबे अम्नोन लेटी की बमार बणी गा ओर जेबे राजा तेसखे देखणे आया, तेबे अम्नोने राजे खे बोलेया, “आऊँ बमार ए मेरी बईण तामार आई की मां सामणे रोटी बणाओ, ताकि आऊँ तेसा रे आथो साथे खाऊँ।” <verse eid="2SA 13:6" /><verse number="7" style="v" sid="2SA 13:7" />तेबे दाऊदे आपणे कअरे तामारा गे ये सन्देशा पेजेया, “आपणे पाई अम्नोनो रे कअरे जाई की तेसखे रोटी बणा।”<verse eid="2SA 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 13:8" />तेबे तामार आपणे पाई अम्नोनो रे कअरे गई ओर से माँजे पाँदे पड़ेया रा था। तेबे तेसे आटा लई की बाटेया ओर तेस सामणे रोटिया बणाईया। <verse eid="2SA 13:8" /><verse number="9" style="v" sid="2SA 13:9" />तेबे तेसे थाल़ु लई की तेसखे पाया, पर तिने खाणे खे ना करी ती, तेबे अम्नोने आपणे दासा खे बोलेया, “मेरे नेड़े-तेड़े ते सारे लोका खे बारे निकयाल़ी दे।” तेबे सारे लोक तेथा ते निकल़ी गे। <verse eid="2SA 13:9" /><verse number="10" style="v" sid="2SA 13:10" />तेबे अम्नोने तामारा खे बोलेया, “रोटिया खे कमरे दे ली आओ ताकि आऊँ तेरे आथो साथे खाऊँ।” तेबे तामार आपणी बणाई रिया रोटिया चकी की आपणे पाई अम्नोनो गे कमरे दे लईगी। <verse eid="2SA 13:10" /><verse number="11" style="v" sid="2SA 13:11" />जेबे से तिना खे तेसरे खाणे खे नेड़े लईगी, तेबे तिने तेसा खे पकड़ी की बोलेया, “ओ मेरी बईण, आओ, मां साथे सओ।” <verse eid="2SA 13:11" /><verse number="12" style="v" sid="2SA 13:12" />तेसे बोलेया, “ओ मेरे पाई, ओ मेरे पाई, एड़ा नि कर, माखे प्रष्ट नि कर; कऊँकि इस्राएलो दे एड़ा काम नि ऊणा चाईयो; एड़ी मूर्खता रा काम नि कर। <verse eid="2SA 13:12" /><verse number="13" style="v" sid="2SA 13:13" />तेबे मां बदनाम ऊई की केई जाणा? ओर तूँ इस्राएली लोका बीचे एक मूर्ख गिणेया जाणा। तूँ राजे साथे बात कर, तेस तां साथे मेरा ब्या करने खे ना नि करनी।” <verse eid="2SA 13:13" /><verse number="14" style="v" sid="2SA 13:14" />पर तिने तेसा री नि सुणी ओर तेसा ते जादा तागतबर ऊणे रिया बजअ ते तेसा साथे कुकर्म करी की से प्रष्ट करी ती। <verse eid="2SA 13:14" /><verse number="15" style="v" sid="2SA 13:15" />तेबे अम्नोन तेसा साथे बऊत जादा बैर राखणे लगेया, एथो तक कि ये बैर तेसरे पईलके प्यारो ते बढ़ी की था। तेबे अम्नोने तेसा खे बोलेया, “उठी की चली जा।” <verse eid="2SA 13:15" /><verse number="16" style="v" sid="2SA 13:16" />तेसे बोलेया, “एड़ा नि ऊई सकदा, कऊँकि ये बड़ा उपद्रव, मतलब माखे निकयाल़ना तेस पईले ते बढ़ी की ये जो तैं मां साथे करी राखेया।” पर तिने तेसा री नि सुणी। <verse eid="2SA 13:16" /><verse number="17" style="v" sid="2SA 13:17" />तेबे तिने आपणे सेवको खे बुलाई की बोलेया, “एसा जवाणसा खे मांगा गे ते बारे निकयाल़ी दे ओर एसा पीछे दरवाजे दे चिटकणी लगाई दे ताकि से वापस नि आई सको।”<verse eid="2SA 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 13:18" />तेसे तो रंगबरंगी कुर्ती पईनी राखी थी; कऊँकि जो राजकुमारिया कुआँरिया रओ थिया सेयो एड़े ई टाल्ले पईनो थिया। अम्नोनो रे देख-पाल़ करने वाल़ेया तेसा खे बारे निकयाल़ी की पीछे फल़ेया दे चिटकणी लगाईती। <verse eid="2SA 13:18" /><verse number="19" style="v" sid="2SA 13:19" />तेबे तामारे आपणे सिरो पाँदे स्वा सेटी ओर आपणी रंगबरंगी कुर्ती फाड़ी ती ओर सिरो पाँदे आथ राखी की जोरे-जोरे की रोंदी ऊई चली गी। <verse eid="2SA 13:19" /><verse number="20" style="v" sid="2SA 13:20" />तेसा रे पाईए अबशालोमे से देखी ओर तेसा ते पूछेया, “क्या तेरा पाई अम्नोन तां साथे सई रा? पर एबे, ओ मेरी बईण चुप रओ, से तो तेरा पाई ए, एते गल्ला री फिकर नि कर।” तेबे तामार आपणे पाई अबशालोमो रे कअरे मन मारी की बैठी दी रई। <verse eid="2SA 13:20" /><verse number="21" style="v" sid="2SA 13:21" />जेबे यो सारिया गल्ला दाऊद राजे रे कानो दे पड़िया, तेबे से बऊत ई गुस्से ऊआ। <verse eid="2SA 13:21" /><verse number="22" style="v" sid="2SA 13:22" />ओर अबशालोमे अम्नोनो खे पला-बुरा कुछ नि बोलेया, कऊँकि अम्नोने तेसरी बईण तामार प्रष्ट कित्ती थी, इजी बजअ ते अबशालोम तेसते नफरत करो था।<verse eid="2SA 13:22" /></para>
  <para style="s">अम्नोनो रा काया जाणा</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 13:23" />दो साल बाद अबशालोमे एप्रैमो रे नेड़े बाल्हासोर जगा दे आपणी पेडा री ऊन कतरवाई ओर तिने सारे राजकुमारा खे निऊँदा दित्तेया। <verse eid="2SA 13:23" /><verse number="24" style="v" sid="2SA 13:24" />से अबशालोम राजे गे जाई की बोलणे लगे, “बिनती ये कि तेरा दास पेडा री ऊन कतरने लगी रा, इजी री खातर राजा आपणे सारे काम करने वाल़ेया समेत आपणे दासो साथे चलो।” <verse eid="2SA 13:24" /><verse number="25" style="v" sid="2SA 13:25" />राजे अबशालोमो खे बोलेया, “ओ मेरे पाऊ, एड़ा नि ऊणा; आसे सारे नि जाणे, एड़ा नि ओ कि ताखे जादा कष्ट ओ।” तेबे अबशालोमे जोर देई की तेसते बिनती कित्ती, पर तिने जाणे ते ना करी ती, तेबे बी तेसखे आशीर्वाद दित्तेया। <verse eid="2SA 13:25" /><verse number="26" style="v" sid="2SA 13:26" />तेबे अबशालोमे बोलेया, “जे तूँ नई तो मेरे पाई अम्नोनो खे आसा साथे जाणे दे।” राजे तेसते पूछेया, “से तां साथे कऊँ जाणा?” <verse eid="2SA 13:26" /><verse number="27" style="v" sid="2SA 13:27" />पर अबशालोमे तेसते बिनती कित्ती तेबे तिने अम्नोन ओर सारे राजकुमार तेस साथे जाणे दित्ते। <verse eid="2SA 13:27" /><verse number="28" style="v" sid="2SA 13:28" />तेबे अबशालोमे आपणे सेवका खे आज्ञा दित्ती, “सावधान रओ ओर जेबे अम्नोन शराब पी की नशे दे ऊई जाओ ओर आऊँ तुसा खे बोलूँ, ‘अम्नोनो खे काई देयो।’ तो तुसे बिना डरे से कायी देणा। क्या एसा आज्ञा खे देणे वाल़ा आऊँ नि ए? याओ बानी की काम करो।” <verse eid="2SA 13:28" /><verse number="29" style="v" sid="2SA 13:29" />तेबे अबशालोमो रे सेवके तेसरी आज्ञा रे मुताबिक अम्नोन काईता। ये देखी की तेबे सारे राजकुमार खड़े ऊए ओर आपणी खच्चरा पाँदे चढ़ी की नठीगे। <verse eid="2SA 13:29" /><verse number="30" style="v" sid="2SA 13:30" />सेयो बाटा देई थे कि किनी माणूंए दाऊदो खे ये सन्देश दित्तेया, “अबशालोमे सारे राजकुमार काईते ओर तिना बीचा ते एक पनि बचेया।” <verse eid="2SA 13:30" /><verse number="31" style="v" sid="2SA 13:31" />तेबे राजा दाऊदे उठी की आपणे टाल्ले फाड़े ओर जमीना दे पड़ीगा ओर तेसरे सारे कर्मचारी आपणे टाल्ले फाड़ी की तेसगे खड़े रये। <verse eid="2SA 13:31" /><verse number="32" style="v" sid="2SA 13:32" />तेबे दाऊदो रे पाई शिमआह रे पाऊ योनादाबे बोलेया, “मेरा प्रभु ये नि समजो कि सारे राजकुमार काई ते, बस अम्नोन काई राखेया; कऊँकि जेस दिने तिने अबशालोमो री बईण तामार प्रष्ट कित्ती, तेस ई दिनो ते अबशालोमो री आज्ञा ते ये गल्ल ठाणी थी। <verse eid="2SA 13:32" /><verse number="33" style="v" sid="2SA 13:33" />इजी री खातर एबे मेरा स्वामी राजा आपणे मनो दे ये समजी की कि सारे राजकुमार मरी गे उदास नि ओ; कऊँकि बस अम्नोन ई मरी रा।”<verse eid="2SA 13:33" /></para>
  <para style="s">अबशालोमो रा नठणा</para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 13:34" />तदुओ खे अबशालोम नठी गा ओर जो सिपाई पईरा देणे लगी रा था तिने आखी चकी की देखेया कि पिछली तरफा ते पाह्ड़ो री बाटा ते बऊत सारे लोक चली की आऊणे लगी रे। <verse eid="2SA 13:34" /><verse number="35" style="v" sid="2SA 13:35" />तेबे योनादाबे राजे खे बोलेया, “देख, राजकुमार तो आईगे, जेड़ा तेरे दासे बोलेया था, तेड़ा ई ऊआ।” <verse eid="2SA 13:35" /><verse number="36" style="v" sid="2SA 13:36" />से बोली ई चुकेया था कि राजकुमार पऊँची गे ओर जोरे-जोरे की रोणे लगे ओर राजा बी आपणे सारे कर्मचारिया समेत बिलखी-बिलखी की रोणे लगेया। <verse eid="2SA 13:36" /><verse number="37" style="v" sid="2SA 13:37" />अबशालोम तो नठी की गशूर जगा दे राजा अम्मीहूदो रे पाऊ तल्मै गे गया ओर दाऊद आपणे पाऊए रिया तँईं हर दिन दु:ख करदा रया। <verse eid="2SA 13:37" /><verse number="38" style="v" sid="2SA 13:38" />जेबे अबशालोम नठी की गशूर इलाके खे गया, तेबे से तेथी तीऊँ साला तक रया, <verse eid="2SA 13:38" /><verse number="39" style="v" sid="2SA 13:39" />अम्नोनो रे मरने ते बाद राजा दाऊद शान्त ऊईगा। पर से आपणे माठे अबशालोमो खे बऊत याद करो था।<verse eid="2SA 13:39" /></para>
  <chapter eid="2SA 13" />
  <chapter number="14" style="c" sid="2SA 14" />
  <para style="s">अबशालोमो रा यरूशलेम शईरो दे आऊणा</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 14:1" />सरूयाह रे पाऊ योआबो खे पता लगी गा कि राजे रा मन अबशालोमो रिया तरफा खे लगी रा। <verse eid="2SA 14:1" /><verse number="2" style="v" sid="2SA 14:2" />इजी री खातर योआबे तकोआ शईरो दे दूत पेजी की तेथा ते एक अक्लमंद जवाणस बुलाई ओर तेसा खे बोलेया, “दु:ख करने वाल़ी बणी जा, मतलब शोगो रा पईरावा पईन ओर तेल नि लगा; पर एड़ी जवाणस बणी जा जेसे बऊत दिना ते मरे दे माणूंए खे दु:ख करी राखेया ओ। <verse eid="2SA 14:2" /><verse number="3" style="v" sid="2SA 14:3" />तेबे राजे गे जाई की एड़िया-एड़िया गल्ला बोलणिया।” ओर योआबे तेसा खे जो कुछ राजे खे बोलणा था से सिखाई ता। <verse eid="2SA 14:3" /><verse number="4" style="v" sid="2SA 14:4" />जेबे से तकोआ जगा री जवाणस राजे रे नेड़े गई, तेबे से मुंए रे पारे जमीना दे पड़ी की माथा टेकी की बोलणे लगी, “ओ राजा मेरी मताद कर।” <verse eid="2SA 14:4" /><verse number="5" style="v" sid="2SA 14:5" />राजे तेसा ते पूछेया, “ताखे क्या ऊईरा?” तेसे बोलेया, “मेरा लाड़ा कुछ बखत पईले मरी गा रा ओर आऊँ बिदुआ ऊई गी री। <verse eid="2SA 14:5" /><verse number="6" style="v" sid="2SA 14:6" />ओर तेरी दासिया रे दो पाऊ थे ओर तिने दुँईं मैदानो दे मारपीट कित्ती ओर तिना खे छुड़ाणे वाल़ा कोई नि था, तेबे एकी जणे दूजे खे एड़ी बाई कि से मरी गा। <verse eid="2SA 14:6" /><verse number="7" style="v" sid="2SA 14:7" />एबे सुण, सारे कुलो रे लोक तेरी दासिया रे खलाफ ऊई की एड़ा बोलोए, ‘जिने आपणा पाई काई राखेया तेसखे आसा रे आथो दे करी दे, ताकि तेसरे काये रे पाईए रे प्राणो रे बदले तेसखे बी काई देईए;’ ओर ईंयाँ सेयो मेरे आखरी बचे रे बारिसो खे बी नाश करना चाओए। ईंयाँ तिना मेरा दिऊआ जो बचीगा रा बजयाई देणा ओर मेरे लाड़े रा नाओं ओर ल्वाद तरतिया पाँदा ते मिटाई देणे।” <verse eid="2SA 14:7" /><verse number="8" style="v" sid="2SA 14:8" />राजे जवाणसा खे बोलेया, “आपणे कअरे जा ओर मां आपू तेरा फैंसला करना।”<verse eid="2SA 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 14:9" />तेबे तकोआ शईरो री जवाणसे राजे खे बोलेया, “ओ मेरे प्रभु, ओ राजा, दोष माखे ओर मेरे बाओ रे कराने खे ई लगो ओर राजा आपणी गद्दिया समेत निर्दोष ठईरो।” <verse eid="2SA 14:9" /><verse number="10" style="v" sid="2SA 14:10" />राजे बोलेया, “जो कोई ताखे कुछ बोलोगा तेसखे मांगे ल्याओ, तेबे से ताखे फेर छुँईं नि सकदा।” <verse eid="2SA 14:10" /><verse number="11" style="v" sid="2SA 14:11" />तेसे बोलेया, “राजा आपणे परमेशर यहोवे खे याद राखो कि खूनो रा बदला लणे वाल़ा, ओर नाश नि करी सको ओर मेरे पाऊए रा नाश नि ऊई सको।” तिने बोलेया, “यहोवे री जिन्दगिया री कसम, तेरे पाऊए रा एक बी बाल़ जमीना दे नि पड़ी सकणा।” <verse eid="2SA 14:11" /><verse number="12" style="v" sid="2SA 14:12" />जवाणसे बोलेया, “तेरी दासी आपणे प्रभु राजे साथे एक गल्ल बोलणा चाओई।” <verse eid="2SA 14:12" /><verse number="13" style="v" sid="2SA 14:13" />तिने बोलेया, “बोलदी जा।” जवाणस बोलणे लगी, “तूँ परमेशरो रे लोका रिया तँईं से सब कऊँ नि करदा जो तैं मेरिया तँईं करने खे बोली राखेया। ओ राजा, तैं ये फैंसला करने दे आपणे आपू खे दोषी बणाई ला दा ए। कऊँकि तैं आपणे निकयाल़े दे माठे खे आपणे कअरे ल्याऊणे खे ना करिती दी ए। <verse eid="2SA 14:13" /><verse number="14" style="v" sid="2SA 14:14" />आसा खे तो मरना ईए ओर जमीना दे खींडे रे पाणिए जेड़े ठईरने, जेतेखे फेर चकी नि सकदे; तेबे बी परमेशर प्राण नि लंदा, बल्कि एड़ी योजना करोआ कि काडेया दा तेसगे काडेया दा नि रओ। <verse eid="2SA 14:14" /><verse number="15" style="v" sid="2SA 14:15" />ओर एबे आऊँ जो आपणे प्रभु राजे खे ये गल्ल बोलणे आई री, इजी री बजअ ये कि लोके आऊँ डराई ती थी; इजी री खातर तेरी दासिये सोचेया, ‘मां राजे गे बोलणा, क्या पता राजा आपणी दासिया री बिनती पूरी करो। <verse eid="2SA 14:15" /><verse number="16" style="v" sid="2SA 14:16" />पक्का राजे सुणी की आपणी दासी जरूर तेस माणूंए रे आथो ते बचाणी, जो माखे ओर मेरे पाऊए खे परमेशरो रे इस्से ते नाश करना चाओआ।’ <verse eid="2SA 14:16" /><verse number="17" style="v" sid="2SA 14:17" />इजी री खातर तेरी दासिये सोचेया, ‘मेरे प्रभु राजे रे वचनो ते शान्ति मिलो;’ कऊँकि मेरा प्रभु राजा परमेशरो रे केसी दूतो जेड़ा खरे-बुरे दे भेद करी सकोआ; इजी री खातर तेरा यहोवा परमेशर तां साथे रओ।” <verse eid="2SA 14:17" /><verse number="18" style="v" sid="2SA 14:18" />राजे ज्वाब देई की तेसा जवाणसा खे बोलेया, “जो गल्ल आऊँ तांते पूछणे लगी रा, से मांते नि छुपा।” जवाणसे बोलेया, “ओ मेरे प्रभु राजा पूछ।” <verse eid="2SA 14:18" /><verse number="19" style="v" sid="2SA 14:19" />राजे पूछेया, “एते गल्ला दे क्या योआब तां साथे ए?” जवाणसे ज्वाब दित्तेया, “ओ मेरे प्रभु, ओ राजा, तेरी जिन्दगिया री कसम, जो कुछ मेरे प्रभु राजे बोली राखेया, से सब सच आ, तिदे कुछ बी चूठ नि आ। तेरे दास योआबे ई माखे आज्ञा दित्ती ओर यो सारिया गल्ला तेरी दासिया खे तिने ई सिखाई राखिया। <verse eid="2SA 14:19" /><verse number="20" style="v" sid="2SA 14:20" />तेरे दास योआबे ये काम इजी खे कित्तेया, ताकि गल्ला रा रंग बदलो। ओर मेरा प्रभु परमेशरो रे एक दूतो जेड़ा अक्लमंद ए, एथो तक कि तरतिया पाँदे जो कुछ ओआ, तिना सबी खे से जाणोआ।” <verse eid="2SA 14:20" /><verse number="21" style="v" sid="2SA 14:21" />तेबे राजे योआबो खे बोलेया, “सुण, मैं ये गल्ल मानी राखी; तूँ जाई की अबशालोमो खे वापस ली आओ।” <verse eid="2SA 14:21" /><verse number="22" style="v" sid="2SA 14:22" />तेबे योआबे जमीना दे मुंए रे पारे पड़ी की माथा टेकेया ओर राजे आशीर्वाद दित्तेया ओर योआब बोलणे लगेया, “ओ मेरे प्रभु, ओ राजा, आज तेरे दासो खे पता लगी गा रा कि मां पाँदे तेरी दया-दृष्टि ए, कऊँकि राजे आपणे दासो री बिनती सुणी राखी।” <verse eid="2SA 14:22" /><verse number="23" style="v" sid="2SA 14:23" />तेबे योआब उठी की गशूरो खे गया ओर अबशालोमो खे यरूशलेम शईरो दे लई आया। <verse eid="2SA 14:23" /><verse number="24" style="v" sid="2SA 14:24" />तेबे राजे बोलेया, “से आपणे कअरे जाई की रओ ओर माखे नि देखो।” तेबे अबशालोम आपणे कअरो खे चली गा ओर राजे खे नि मिलेया।<verse eid="2SA 14:24" /></para>
  <para style="s">अबशालोमो रा दाऊद राजे रे सामणे जाणा</para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 14:25" />सारे इस्राएलो रे सुन्दरता रिया बजअ ते बऊत तारीफा जोगा अबशालोमो जेड़ा ओर कोई नि था; बल्कि तेसरे सिरो ते लई की पैरो तक कोई दोष नि था। <verse eid="2SA 14:25" /><verse number="26" style="v" sid="2SA 14:26" />से सालो रे अन्तो रे आपणे बाल़ कटवाओ था; (तेसखे आपणे बाल़ा रा बोज लगो था, इजी बजअ ते से तिना खे कटवाओ था) ओर जेबे-जेबे से आपणे बाल़ कटवाओ था, तेबे-तेबे आपणे सिरो रे बाल़ तोली की राजे रे तोलो रे मुताबिक तिना रा बजन दो किलो ओ था। <verse eid="2SA 14:26" /><verse number="27" style="v" sid="2SA 14:27" />अबशालोमो रे तीन पाऊ ओर तामार नाओं री एक बेटी पैदा ऊई ओर से बऊत बांकी जवाणस थी। <verse eid="2SA 14:27" /><verse number="28" style="v" sid="2SA 14:28" />जेबे अबशालोम राजे खे बिना मिले यरूशलेम शईरो दे दुँईं साला तक रया। <verse eid="2SA 14:28" /><verse number="29" style="v" sid="2SA 14:29" />तेबे अबशालोमे योआब बुलाया, ताकि तेसखे राजे गे पेजो, पर योआबे तेसगे आऊणे ते ना करी ती। ओर तिने फेर से दूजी बार बुलाया, पर तेबे बी तिने आऊणे ते ना करी ती। <verse eid="2SA 14:29" /><verse number="30" style="v" sid="2SA 14:30" />तेबे तिने आपणे सेवका खे बोलेया, “सुणो, योआबो रा एक डोरू मेरी जमीना रे नेड़े ए ओर तिदे तेसरे जौ री फसल ए; तुसे जाई की तिदे आग लगाई देयो।” ओर अबशालोमो रे सेवके तिदे आग लगाईती। <verse eid="2SA 14:30" /><verse number="31" style="v" sid="2SA 14:31" />तेबे योआब उठेया ओर अबशालोमो रे कअरे तेसगे जाई की तेसते पूछणे लगेया, “तेरे सेवके मेरे डोरूए दे आग कऊँ लगाई?” <verse eid="2SA 14:31" /><verse number="32" style="v" sid="2SA 14:32" />अबशालोमे योआबो खे बोलेया, “कऊँकि आऊँ चाऊँ था तूँ राजे गे जाई की पूछे कि जे मांते मिलणा नि चांदा तो तिने आऊँ गशूरो ते कऊँ बुलाया। आऊँ तेथी ई रूकेया दा रंदा। एबे माखे राजे साथे मिलणे दे। अगर जे से मांदे केसी गल्ला रा दोष पाओआ तो से माखे काई देयो।” <verse eid="2SA 14:32" /><verse number="33" style="v" sid="2SA 14:33" />तेबे योआबे राजे गे जाई की तेसगे ये गल्ल सुणाई ओर राजे अबशालोम बुलाया। से तेसगे गया ओर तेस सामणे मुंए रे पारे जमीना दे पड़ी की माथा टेकेया ओर राजे अबशालोम गल़े लगाई की चूम्मेया।<verse eid="2SA 14:33" /></para>
  <chapter eid="2SA 14" />
  <chapter number="15" style="c" sid="2SA 15" />
  <para style="s">अबशालोमो रा बरोद</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 15:1" />कुछ बखतो ते बाद अबशालोमे रथ ओर कोड़े ओर आपू ते आगे-आगे दौड़ने वाल़े पंजा माणूं राखी ते। <verse eid="2SA 15:1" /><verse number="2" style="v" sid="2SA 15:2" />अबशालोम प्यागा छोड़ उठी की बड़े द्वारो रे नेड़े बाटा दे खड़ा ओया करो था ओर जेबे-जेबे कोई दावा करने वाल़ा राजे गे न्याय मांगणे खे आओ था तेबे अबशालोम तेसते आका पाई की पूछो था, “तूँ केस शईरो ते ओर केस गोत्रो ते आई रा?” ओर से बोलो था, “तेरा दास इस्राएलो रे अमुक गोत्रो राए।” <verse eid="2SA 15:2" /><verse number="3" style="v" sid="2SA 15:3" />तेबे अबशालोम तेसखे बोलो था, “सुण, तेरा पक्ष ठीक ओर न्याय राए; पर राजे रिया तरफा ते कोई बी तेरी सुणने वाल़ा नि ए।” <verse eid="2SA 15:3" /><verse number="4" style="v" sid="2SA 15:4" />तेबे अबशालोम ये बी बोलेया करो था, “पला ऊँदा कि माखे एते देशो रा न्यायी ठरांदे! ताकि जितणे मुकद्दमे वाल़े ऊँदे सेयो सारे मांगे ई आऊँदे ओर आऊँ तिना रा न्याय करदा।” <verse eid="2SA 15:4" /><verse number="5" style="v" sid="2SA 15:5" />फेर जेबे कोई तेसगे माथा टेकणे खे नेड़े आओ था, तेबे से आथ बढ़ाई की तेसखे पकड़ी की चूम्मो था। <verse eid="2SA 15:5" /><verse number="6" style="v" sid="2SA 15:6" />जितणे इस्राएली लोक राजे गे आपणा मुकद्दमा लई की आओ थे तिना सबी साथे अबशालोम एड़ा ई करो था; ईंयाँ अबशालोमे इस्राएली माणूंआ रा मन आपणिया तरफा खे फेरी ला था। <verse eid="2SA 15:6" /><verse number="7" style="v" sid="2SA 15:7" />चार साल बीतणे ते बाद अबशालोमे राजे गे जाई की बोलेया, “माखे हेब्रोन शईरो दे जाई की आपणी तेसा मान्नता खे पूरी करने दे, जो मैं यहोवे री मानी राखी। <verse eid="2SA 15:7" /><verse number="8" style="v" sid="2SA 15:8" />तेरा दास तो जेबे अरामो रे गशूर शईरो दे रओ था, तेबे ये बोली की यहोवे री मान्नत मानी, कि जे यहोवा सच्ची माखे यरूशलेम शईरो खे वापस ली आओ, तो मां यहोवे री सेवा हेब्रोन शईरो दे करनी।” <verse eid="2SA 15:8" /><verse number="9" style="v" sid="2SA 15:9" />राजे तेसखे बोलेया, “शान्तिया दे जा।” ओर से उठी की हेब्रोन शईरो खे गया। <verse eid="2SA 15:9" /><verse number="10" style="v" sid="2SA 15:10" />जेबे से तेती था तेबे अबशालोमे इस्राएलो रे सारे गोत्रा बीचे ये बोलणे खे पेतिए पेजे, “जेबे तुसा खे रड़सिंगे रे बजणे री आवाज सुणो, तेबे बोलणा कि अबशालोम हेब्रोनो दे राजा ऊआ।” <verse eid="2SA 15:10" /><verse number="11" style="v" sid="2SA 15:11" />अबशालोमो साथे दो सौ बुलाए दे लोक यरूशलेम शईरो ते गये; सेयो सीदे मनो ते तेसरा पेत बिना जाणे ई गये। <verse eid="2SA 15:11" /><verse number="12" style="v" sid="2SA 15:12" />जेबे अबशालोमो रा यज्ञ ऊआ, तेबे तिने गीलो दे रणे वाल़े अहीतोपेलो खे, जो दाऊदो रा मंत्री था, सन्देशा पेजेया कि से आपणे गीलो शईरो ते आओ। ओर राजद्रोहिया री मण्डल़ी तागतबर ऊँदी गई, कऊँकि अबशालोमो खे मानणे वाल़े लोक लगातार बढ़दे गये।<verse eid="2SA 15:12" /></para>
  <para style="s">दाऊदो रा यरूशलेम शईरो ते नठणा</para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 15:13" />तेबे किने दूते दाऊदो गे जाई की ये सन्देश दित्तेया, “इस्राएली माणूंआ रे मन अबशालोमो रिया तरफा खे ऊईगे रे।” <verse eid="2SA 15:13" /><verse number="14" style="v" sid="2SA 15:14" />तेबे दाऊदे आपणे सारे काम करने वाल़ेया ते जो यरूशलेम शईरो दे तेस साथे थे बोलेया, “आओ, आसे नठी जाऊँए; नई तो आसा बीचा ते कोई बी अबशालोमो ते नि बचणा, इजी री खातर फटाफट चलो, एड़ा नि ओ कि से फटाफट आई की आसा खे केरी देयो ओर आसा रा नुकशाण करो ओर एस शईरो रे लोका खे तलवारी की काई देयो।” <verse eid="2SA 15:14" /><verse number="15" style="v" sid="2SA 15:15" />राजे रे काम करने वाल़ेया तेसखे बोलेया, “जेड़ा म्हारे प्रभु राजे खे ठीक लगो, तेड़ा ई करने खे तेरे दास त्यार ए।” <verse eid="2SA 15:15" /><verse number="16" style="v" sid="2SA 15:16" />तेबे राजा निकल़ी गा ओर तेस साथे तेसरा सारा कराना निकल़ी गा। राजे दस रखैलिया मईलो री चौकसी करने खे छाडी तिया। <verse eid="2SA 15:16" /><verse number="17" style="v" sid="2SA 15:17" />तेबे राजा निकल़ी गा ओर तेस पीछे सारे लोक निकल़ी गे ओर सेयो बेतमेर्हको दे जाई की रूकी गे। <verse eid="2SA 15:17" /><verse number="18" style="v" sid="2SA 15:18" />तेसरे सारे कर्मचारी तेसगे ते ऊई की आगे निकल़ी गे ओर सारे करेती, ओर सारे पलेती ओर सारे गत शईरो रे, मतलब जो 600 मर्द गतो ते तेस पीछे चले थे सेयो सारे राजे रे सामणे ते ऊई की आगे चली गे। <verse eid="2SA 15:18" /><verse number="19" style="v" sid="2SA 15:19" />तेबे राजे गती इत्तै ते पूछेया, “तूँ आसा साथे कऊँ चलणे लगी रा? वापस ऊई की अबशालोम राजे गे रओ; कऊँकि तूँ परदेशी ओर आपणे देशो ते दूर ए, इजी री खातर आपणी जगा खे वापस ऊई जा। <verse eid="2SA 15:19" /><verse number="20" style="v" sid="2SA 15:20" />तूँ तो काल ई आई रा, क्या आऊँ आज ताखे आपू साथे मारा-मारा फिराऊँ? आऊँ तो जेती केथी जाई सकूँआ, तेती जाणा। तूँ वापस ऊई जा ओर आपणे पाईया खे बी लई जा; परमेशरो री दया ओर सच्चाई तां साथे सदा रओ।” <verse eid="2SA 15:20" /><verse number="21" style="v" sid="2SA 15:21" />इत्तै राजे खे ज्वाब दित्तेया, “यहोवे री जिन्दगिया री कसम ओर मेरे प्रभु राजे री जिन्दगिया री कसम, जेती केसी जगा दे मेरा प्रभु राजा रओगा, चाए मरने खे ओ, चाए जिऊणे खे, तेसा ई जगा दे तेरा दास बी रणा।”<verse eid="2SA 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 15:22" />तेबे दाऊदे इत्तै खे बोलेया, “मां साथे किद्रोन नाल़े ते पार चल।” तेबे गती इत्तै आपणे सारे माणूंआ ओर आपू साथले सारे बाल-बच्चेया समेत किद्रोन नाल़े ते पार चली गा। <verse eid="2SA 15:22" /><verse number="23" style="v" sid="2SA 15:23" />सारे रणे वाल़े जोरे-जोरे की रोए ओर सारे लोक किद्रोन नाल़े ते पार ऊईगे, ओर राजा बी किद्रोन नाओं रे नाल़े ते पार ऊआ ओर सारे लोक नाल़े ते पार जंगल़ो रिया बाटा रिया तरफा खे पार ऊई की चली पड़े। <verse eid="2SA 15:23" /><verse number="24" style="v" sid="2SA 15:24" />तेबे तिने क्या देखेया कि सादोक पुरोईत बी तेती था ओर तेस साथले सारे लेविये बी परमेशरो री वाचा रा सन्दूक चकी की आऊणे लगी रे ओर तिने परमेशरो रा सन्दूक थाले राखी ता, तेबे एब्यातार पुरोईत तदुए तक बलि चढ़ांदा रया जदुओ तक सारे लोक शईरो ते बारे नि निकल़ी गे। <verse eid="2SA 15:24" /><verse number="25" style="v" sid="2SA 15:25" />तेबे राजे सादोको खे बोलेया, “परमेशरो रे सन्दूको खे शईरो दे वापस लई जा। जे यहोवे री दया री नजर मां पाँदे ओ, तेबे तेस आऊँ वापस निणा ओर आपणे रणे री जगा बी दखाणी; <verse eid="2SA 15:25" /><verse number="26" style="v" sid="2SA 15:26" />पर जे से माखे एड़ा बोलो, ‘आऊँ तांते खुश नि ए,’ तेबे बी आऊँ आजीर ए, जेड़ा तेसखे अच्छा लगो से तेड़ा ई मां साथे बर्ताव करो।” <verse eid="2SA 15:26" /><verse number="27" style="v" sid="2SA 15:27" />तेबे राजे सादोक पुरोईतो खे बोलेया, “क्या तूँ दर्शी नि ए? मेरी योजना ये कि तूँ तो रामो दे शईरो दे वापस ऊई जा ओर तेरा पाऊ अहीमास ओर एब्यातारो रा पाऊ योनातान, दोनो तां साथे शईरो खे चली जाओ। <verse eid="2SA 15:27" /><verse number="28" style="v" sid="2SA 15:28" />सुणो, मां जंगल़ो रे काटो तक तदुओ तक रूके दे रणा, जदुओ तक तुसा लोका ते माखे कोई सन्देश नि मिलो।” <verse eid="2SA 15:28" /><verse number="29" style="v" sid="2SA 15:29" />तेबे सादोक ओर एब्यातारे परमेशरो रा सन्दूक यरूशलेम शईरो खे वापस करी ता ओर आपू तेथी रये।<verse eid="2SA 15:29" /></para>
  <para style="s">दाऊद ओर हूशै</para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 15:30" />तेबे दाऊद तिना साथे जो तेस साथे गये, जैतूनो रे पाह्ड़ो पाँदे सिर टखी की, नांगे पैरे, रोंदा ऊआ चढ़ने लगेया ओर जितणे लोक तेस साथे थे, सेयो बी सिर टखी की रोंदे ऊए चढ़ीगे। <verse eid="2SA 15:30" /><verse number="31" style="v" sid="2SA 15:31" />तेबे दाऊदो खे ये सन्देश मिलेया, “अबशालोमो साथले राजद्रोहिया साथे अहीतोपेल ए।” दाऊदे बोलेया, “ओ यहोवा, अहीतोपेलो री सला खे मूर्खता बणाई दे।” <verse eid="2SA 15:31" /><verse number="32" style="v" sid="2SA 15:32" />जेबे दाऊद चूँडिया तक पऊँचेया, जेती से परमेशरो री आराधना करने खे जाया करो थे, तेबे एरेकी हूशै चोगा फाड़ी की, सिरो पाँदे स्वा मल़ी की तेस साथे मिलणे खे आया। <verse eid="2SA 15:32" /><verse number="33" style="v" sid="2SA 15:33" />दाऊदे तेसखे बोलेया, “जे तूँ मां साथे आगे जाएगा, तेबे तो मेरिया तँईं बोज ऊणा, <verse eid="2SA 15:33" /><verse number="34" style="v" sid="2SA 15:34" />पर जे तू शईरो खे वापस ऊई की अबशालोमो खे बोलणे लगे कि ओ राजा, आऊँ तेरा दास ए, जेड़ा आऊँ बऊत दिना तक तेरे बाओ रा दास रया, तेड़ा ई एबे तेरा रऊँगा, तेबे तूँ मेरे फायदे रिया तँईं अहीतोपेलो रिया सला खे निष्फल करी सकेया। <verse eid="2SA 15:34" /><verse number="35" style="v" sid="2SA 15:35" />ओर तेती तां साथे सादोक ओर एब्यातार पुरोईत रणे। इजी री खातर राजमईलो बीचा ते जो आल ताखे सुणो, से सादोक ओर एब्यातार पुरोईतो गे बताया करना। <verse eid="2SA 15:35" /><verse number="36" style="v" sid="2SA 15:36" />तिना साथे तो दो तिना रे पाऊ, मतलब सादोको रा पाऊ अहीमास ओर एब्यातारो रा पाऊ योनातान, तेती रणे; तेबे जो सन्देश तुसा लोका खे मिलो से मांगे तिना रे आथो देई पेजेया करना।” <verse eid="2SA 15:36" /><verse number="37" style="v" sid="2SA 15:37" />तेबे दाऊदो रा दोस्त हूशै शईरो खे गया ओर तेस ई बखते अबशालोम बी यरूशलेम शईरो दे पऊँची गा।<verse eid="2SA 15:37" /></para>
  <chapter eid="2SA 15" />
  <chapter number="16" style="c" sid="2SA 16" />
  <para style="s">दाऊद ओर सीबा</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 16:1" />दाऊद आपणे साथिया साथे जैतून पाह्ड़ो रिया चूँडिया पाँदे थोड़ी दूर चलेया, तेती मपीबोशेतो रा सेवक सीबा दाऊदो ते मिलेया। सीबा गे काठिया समेत दो गह्दिया थिया। तिना पाँदे 200 रोटिया, दाखा रिया 100 टिक्किया, गर्मिया रे फलो रिया 100 टिक्किया ओर एक खलडु अँगूरा रा रस था। <verse eid="2SA 16:1" /><verse number="2" style="v" sid="2SA 16:2" />राजे सीबा ते पूछेया, “इना चीजा ते तेरा क्या मतलब ए?” सीबे बोलेया, “गह्दे तो राजे रे कराने रिया सवारिया खे ए ओर रोटी ओर गर्मिया रे फल जवाना खे खाणे खे ए ओर अँगूरा रा रस इजी खे ए, ताकि जो कोई जंगल़ो दे थकी जाओ से तिजी खे पियो।” <verse eid="2SA 16:2" /><verse number="3" style="v" sid="2SA 16:3" />राजे पूछेया, “तेरे स्वामी शाऊलो रा पोता मपीबोशेत केई ए?” सीबे राजे खे बोलेया, “से तो ये बोली की यरूशलेम शईरो दे रई गा कि एबे इस्राएलो रे कराने माखे मेरे दादा शाऊलो रा राज्य वापस करी देणा।” <verse eid="2SA 16:3" /><verse number="4" style="v" sid="2SA 16:4" />राजे सीबे खे बोलेया, “जो कुछ मपीबोशेतो रा था से सारा ताखे मिली गा।” सीबे बोलेया, “नमस्ते; ओ मेरे प्रभु, ओ राजा, मां पाँदे तेरी दया री नजर बणी दी रओ।”<verse eid="2SA 16:4" /></para>
  <para style="s">शिमिये रा स्राप</para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 16:5" />जेबे राजा दाऊद ओर जो तेस साथे थे बहूरीम शईरो तक पऊँचे, तेबे शाऊलो रे टब्बरो रा एक माणूं तेथा ते निकल़ेया, से गेरो रा पाऊ शिमी था ओर से दाऊदो खे कोसदा ऊआ आया। <verse eid="2SA 16:5" /><verse number="6" style="v" sid="2SA 16:6" />से राजा दाऊदो पाँदे ओर तेसरे सारे कर्मचारिया पाँदे पात्थर सेटणे लगेया ओर सेनिका समेत लोक तेसरे दाँणे ओर खूँजे दुँईं तरफा खे थे। <verse eid="2SA 16:6" /><verse number="7" style="v" sid="2SA 16:7" />शिमी कोसदा ऊआ ईंयाँ बकदा गया, “दूर ऊई जा खूनी, दूर ऊई जा नीच, निकल़ी जा, निकल़ी जा! <verse eid="2SA 16:7" /><verse number="8" style="v" sid="2SA 16:8" />यहोवे तांते शाऊलो रे कराने रे खूनो रा पूरा बदला लई राखेया, जेसरी जगा पाँदे तूँ राजा बणी रा; यहोवे राज तेरे पाऊ अबशालोमो रे आथो दे करी ता रा। कऊँकि तूँ खूनी ए, तूँ आपणी बुराईया दे आपू फसी गा।” <verse eid="2SA 16:8" /><verse number="9" style="v" sid="2SA 16:9" />तेबे सरूयाह रे पाऊ अबीशै राजे खे बोलेया, “ये मरेया रा कुत्ता मेरे प्रभु राजे खे स्राप किंयाँ देई सकोआ? माखे तेथी जाई की तेसरा सिर बाडणे दे।” <verse eid="2SA 16:9" /><verse number="10" style="v" sid="2SA 16:10" />राजे बोलेया, “सरूयाहो रे पाऊओ, माखे तुसा ते क्या काम ए? से जो कोसणे लगी रा ओर यहोवे जो तेसखे बोली राखेया कि दाऊदो खे स्राप दे, तो तेसखे कुण पूछी सकोआ, कि तैं एड़ा कऊँ कित्तेया?” <verse eid="2SA 16:10" /><verse number="11" style="v" sid="2SA 16:11" />तेबे दाऊदे अबीशै ओर आपणे सारे कर्मचारिया खे बोलेया, “जेबे मेरा आपणा पाऊ बी माखे काणा चाओआ, तो ये बिन्यामीनी एबे एड़ा कऊँ नि करो? एसखे रणी दे ओर स्राप देणे देयो; कऊँकि यहोवे तेसखे बोली राखेया। <verse eid="2SA 16:11" /><verse number="12" style="v" sid="2SA 16:12" />क्या पता यहोवा एस उपद्रवो पाँदे, जो मां पाँदे ऊणे लगी रा, नजर करी की आजके स्रापो रे बदले माखे अच्छा बदला देयो।” <verse eid="2SA 16:12" /><verse number="13" style="v" sid="2SA 16:13" />तेबे दाऊद आपणे माणूंआ समेत आपणी बाटा रे चली गा ओर शिमी तेस सामणे रे पाह्ड़ो पाँदा ते स्राप देंदा ओर तेस पाँदे पात्थर ओर तूड़ सेटदा गया। <verse eid="2SA 16:13" /><verse number="14" style="v" sid="2SA 16:14" />तेबे राजा आपणे सारे लोका साथे आपणे ठकाणे रे थकेया रा पऊँचेया ओर तेथी राम कित्तेया।<verse eid="2SA 16:14" /></para>
  <para style="s">अबशालोमो रा अहीतोपेल री सला</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 16:15" />अबशालोम सारे इस्राएली लोका समेत यरूशलेम शईरो खे आया ओर तेस साथे अहीतोपेल बी आया। <verse eid="2SA 16:15" /><verse number="16" style="v" sid="2SA 16:16" />जेबे दाऊदो रा दोस्त एरेकी हूशै अबशालोमो गे पऊँचेया, तेबे हूशै अबशालोमो खे बोलेया, “राजा सदा जिऊँदा रओ! राजा सदा जिऊँदा रओ!” <verse eid="2SA 16:16" /><verse number="17" style="v" sid="2SA 16:17" />अबशालोमे हूशै खे बोलेया, “क्या ये तेरा प्यार ए जो तूँ आपणे दोस्तो साथे राखेया? तूँ आपणे दोस्तो साथे कऊँ नि गया?” <verse eid="2SA 16:17" /><verse number="18" style="v" sid="2SA 16:18" />हूशै अबशालोमो खे बोलेया, “एड़ा नि ए; जेसखे यहोवा ओर सेयो लोक, बल्कि सारे इस्राएली लोक चाओ, तेसरा ई आऊँ ए ओर तेस साथे ई मां रणा। <verse eid="2SA 16:18" /><verse number="19" style="v" sid="2SA 16:19" />ओर फेर आऊँ केसरी सेवा करुँ? क्या तेसरे पाऊए रे सामणे रई की सेवा नि करुँ? जेड़ा आऊँ तेरे बाओ सामणे रई की सेवा करुँ था, तेड़ी ई तां सामणे रई की सेवा करनी।” <verse eid="2SA 16:19" /><verse number="20" style="v" sid="2SA 16:20" />तेबे अबशालोमे अहीतोपेलो खे बोलेया, “तुसे लोक आपणी सला देयो कि माखे क्या करना चाईयो?” <verse eid="2SA 16:20" /><verse number="21" style="v" sid="2SA 16:21" />अहीतोपेले अबशालोमो ते बोलेया, “जिना रखैला खे तेरा बाओ चौकसी करने खे छाडी गा, तिना गे तूँ जा ओर जेबे सारे इस्राएली लोका ये सुणना कि अबशालोमो रा बाओ तेसते प्यार नि करदा, तेबे तेरे सारे साथिया याओ बानणा।” <verse eid="2SA 16:21" /><verse number="22" style="v" sid="2SA 16:22" />तेबे तेसरिया तँईं छतो पाँदे एक तम्बू खड़ा कित्तेया ओर अबशालोम सारे इस्राएली लोका सामणे आपणे बाओ री रखैला गे गया। <verse eid="2SA 16:22" /><verse number="23" style="v" sid="2SA 16:23" />तिना दिना दे जो सला अहीतोपेल देयो था, से एड़ी ओ थी कि मानो कोई परमेशरो रा वचन पूछणे लगी रा ओ। इजी री खातर अबशालोम बी दाऊदो जेड़ा ई अहीतोपेलो री सला मानणे लगेया।<verse eid="2SA 16:23" /></para>
  <chapter eid="2SA 16" />
  <chapter number="17" style="c" sid="2SA 17" />
  <para style="p">
    <verse number="1" style="v" sid="2SA 17:1" />तेबे अहीतोपेले अबशालोमो खे बोलेया, “माखे 12,000 मर्द छाँटणे दे ओर मां उठी की आज ई राती दाऊदो रा पीछा करना। <verse eid="2SA 17:1" /><verse number="2" style="v" sid="2SA 17:2" />ओर जेबे से थकेया रा ओर कमजोर ऊणा, तेबे मां से पकड़ी लणा ओर डराणा ओर जितणे लोक तेस साथे ऊणे सेयो सारे नठी जाणे ओर मां राजा ई काणा, <verse eid="2SA 17:2" /><verse number="3" style="v" sid="2SA 17:3" />मां सारे लोक तांगे वापस ली आऊणे; जेस माणूंए खे तूँ टोल़ने लगी रा तेसरे मिलणे ते सारी प्रजा साथे मिलणा ऊई जाणा ओर सारी प्रजा रामो दे रणी।” <verse eid="2SA 17:3" /><verse number="4" style="v" sid="2SA 17:4" />ये गल्ल अबशालोम ओर सारे इस्राएली बुजुर्गा खे ठीक लगी।<verse eid="2SA 17:4" /></para>
  <para style="s">हूशै री सलाह</para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 17:5" />तेबे अबशालोमे बोलेया, “एरेकी हूशै खे बी बुलाई की ल्याओ ओर जो से बोलोगा आसा से बी सुणना।” <verse eid="2SA 17:5" /><verse number="6" style="v" sid="2SA 17:6" />जेबे हूशै अबशालोमो गे आया, तेबे अबशालोमे तेसखे बोलेया, “अहीतोपेले तो एड़ी गल्ल बोली राखी; क्या आसे तेसरी गल्ल मानिए कि नई? जे नई, तो तूँ बोली दे आसा खे क्या करना चाईयो?” <verse eid="2SA 17:6" /><verse number="7" style="v" sid="2SA 17:7" />हूशै अबशालोमो खे बोलेया, “जो सला अहीतोपेले एस बार देई राखी से ठीक नि ए।” <verse eid="2SA 17:7" /><verse number="8" style="v" sid="2SA 17:8" />तेबे हूशै बोलेया, “तूँ तो आपणे बाओ ओर तेसरे माणूंआ खे जाणेआ कि सेयो शूरवीर ए ओर सेयो तेसा रीछणिया जेड़े गुस्से वाल़े ए जेसा रा बच्चा छीनी लोए। तेरा बाओ योद्धा ए ओर दूजे लोका साथे रात नि बितांदा। <verse eid="2SA 17:8" /><verse number="9" style="v" sid="2SA 17:9" />एस बखते तो से केसी गड्डे, या केसी दूजी जगा दे लूकेया रा ऊणा। जेबे इना बीचा ते पईले ई कोई-कोई काये जाओ, तेबे एतेखे सारे सुणने वाल़ेया बोलणे लगणा, ‘अबशालोमो रे लोक तो आरी गे।’ <verse eid="2SA 17:9" /><verse number="10" style="v" sid="2SA 17:10" />तेबे वीरो रा दिल, जो शेरो जेड़ा ओआ, तेसरा बी औंसला टूटी जाणा, सारा इस्राएल तो जाणोआ कि तेरा बाओ तो वीर माणूं ए ओर तेस साथले बड़े योद्धा ए। <verse eid="2SA 17:10" /><verse number="11" style="v" sid="2SA 17:11" />इजी री खातर मेरी सला ये कि उतर दिशा दे दानो रे इलाके ते लई की दक्खणा दे बेर्शेबा शईरो तक रणे वाल़े सारे इस्राएली तांगे समुद्रो कनारले बालूआ रिया कणियां जेड़े कट्टे करे जाओ ओर तूँ आपू ई युद्धो खे जा। <verse eid="2SA 17:11" /><verse number="12" style="v" sid="2SA 17:12" />ओर जेबे आसा तेसखे केसी ना केसी जगा दे जेती से मिलो जाई की पकड़ी लऊँगे, तेबे जिंयाँ पाल़ा जमीना दे पड़ोआ तिंयाँ ई आसा तेस पाँदे अमला करना, तेबे ना तो से बचणा ओर ना ई तेसरे साथिया बीचा ते कोई बचणा। <verse eid="2SA 17:12" /><verse number="13" style="v" sid="2SA 17:13" />जे से केसी शईरो दे कूसी रा ऊगा, तेबे सारे इस्राएली लोका तेस शईरो गे रस्सिया ली आऊणियां ओर आसा से शईर नाल़े दे खींजणा, एथो तक कि तेसरा कोई छोटा जा पात्थर पनि रणा।” <verse eid="2SA 17:13" /><verse number="14" style="v" sid="2SA 17:14" />तेबे अबशालोम ओर जो तेस साथे इस्राएली मर्द थे तिने बोलेया, “एरेकी हूशै री सला अहीतोपेलो री सला ते ठीक ए।” यहोवे तो अहीपोतेलो री अच्छी सला खे निष्फल करने री ठाणी राखी थी, ताकि से अबशालोमो पाँदे ई मुसीबत पाओ।<verse eid="2SA 17:14" /></para>
  <para style="s">हूशै री दाऊदो खे बची की निकल़ने री चतौणी</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 17:15" />तेबे हूशै सादोक ओर एब्यातार पुरोईता खे बोलेया, “अहीतोपेले तो अबशालोम ओर इस्राएली बुजुर्गा खे एड़ी-एड़ी सला दित्ती ओर मैं एड़ी-एड़ी सला देई राखी। <verse eid="2SA 17:15" /><verse number="16" style="v" sid="2SA 17:16" />इजी री खातर एबे फुर्ती करी की दाऊदो गे सन्देशा पेजो कि आज राती जंगल़ो रिया काअटिया रे नि रूकणा, जरूर पार ई ऊई जाया; एड़ा नि ओ कि राजा ओर जितणे लोक तेस साथे ए, सारे नाश ऊई जाओ।” <verse eid="2SA 17:16" /><verse number="17" style="v" sid="2SA 17:17" />योनातान ओर अहीमास एनरोगेलो गे रूके रे रये ओर एक दासी तिना खे जाई की सन्देश देई आओ थी ओर सेयो जाई की राजा दाऊदो खे सन्देश देयो थे, कऊँकि सेयो केसी सामणे शईरो दे नि जाओ थे। <verse eid="2SA 17:17" /><verse number="18" style="v" sid="2SA 17:18" />एकी पाऊए सेयो देखे ओर तिने जाई की अबशालोमो गे बोलेया, पर सेयो दोनो फटाफट चली गे ओर एक बहूरीमो रे रणे वाल़े माणूंए रे कअरे पऊँची की जेसरे आँगणो दे कुआँ था तिदे उतरी गे। <verse eid="2SA 17:18" /><verse number="19" style="v" sid="2SA 17:19" />तेबे तेसरी जवाणसे कपड़ा लई की कुएँ रे मुरे पाँदे बछाया ओर तेते पाँदे दल़ेय्या दा नज्ज फैलाई ता; तेबे केसी खे कुछ पता नि लगेया। <verse eid="2SA 17:19" /><verse number="20" style="v" sid="2SA 17:20" />तेबे अबशालोमो रे सेवक तेस कअरो रे तेसा जवाणसा गे जाई की बोलणे लगे, “अहीमास ओर योनातान केई ए?” तेबे जवाणसे तिना खे बोलेया, “सेयो दोनो तो तेसा छोटिया नदिया ते पार गये।” तेबे तिने सेवके सेयो टोल़े ओर जेबे सेयो मिले नि तेबे यरूशलेम शईरो खे वापस ऊईगे। <verse eid="2SA 17:20" /><verse number="21" style="v" sid="2SA 17:21" />जेबे सेयो चली गे, तेबे पुरोईता रे दोनो पाऊ कुएँ ते निकल़े ओर जाई की दाऊद राजे खे सन्देश दित्तेया; ओर दाऊदो खे बोलेया, “तुसे लोक चलो, छोड़-छोड़ करी की नदिया ते पार ऊई जाओ; कऊँकि अहीतोपेले तुसा रे नुकशाणो री एड़ी-एड़ी सला देई राखी।” <verse eid="2SA 17:21" /><verse number="22" style="v" sid="2SA 17:22" />तेबे दाऊद आपणे सारे साथिया समेत उठी की यरदन नदिया ते पार चली गा ओर प्याग ऊणे तक सेयो सारे के सारे यरदन नदिया ते पार चली गे। <verse eid="2SA 17:22" /><verse number="23" style="v" sid="2SA 17:23" />जेबे अहीतोपेले देखेया कि मेरिया सलाई रे मुताबिक काम नि ऊआ, तेबे तिने आपणे गह्देया पाँदे काठी बानी ओर आपणे शईरो दे जाई की आपणे कअरे गया ओर आपणे परिवारो खे जो-जो आज्ञा देणी थी से देई की आपू खे फाँसी लगाईती ओर से मरी गा ओर से तेसरे बाओ रे कब्रिस्तानो दे दबाईता। <verse eid="2SA 17:23" /><verse number="24" style="v" sid="2SA 17:24" />तेबे दाऊद तो महनैमो रे पऊँची गा। तेबे अबशालोम सारे इस्राएली मर्दा समेत यरदन नदिया ते पार गया। <verse eid="2SA 17:24" /><verse number="25" style="v" sid="2SA 17:25" />तेबे अबशालोमे अमासा खे योआबो रिया जगा पाँदे परदान सेनापति ठराया। ये अमास एक इस्राएली मर्दो रा पाऊ था जेसरा नाओं यित्रो था ओर से योआबो री माये, सरूयाह री बईण, अबीगैल नाओं री नाहाशो री बेटिया रा पाऊ था। <verse eid="2SA 17:25" /><verse number="26" style="v" sid="2SA 17:26" />ओर इस्राएलिये ओर अबशालोमे गिलाद देशो दे डेरे लगाए। <verse eid="2SA 17:26" /><verse number="27" style="v" sid="2SA 17:27" />जेबे दाऊद ओर तेसरे सिपाई महनैम देशो दे आए, तेबे अम्मोनिया रे रब्बा दे रणे वाल़ा नाहाशो रा पाऊ शोबी ओर लोदबार शईरो दे रणे वाल़ा अम्मीएलो रा पाऊ माकीर ओर रोगलीम शईरो दे रणे वाल़ा गिलाद जगा रा बर्जिल्लै था, <verse eid="2SA 17:27" /><verse number="28" style="v" sid="2SA 17:28" />से माँजे, तसले, माट्टिया रे पांडे, कणक, जौ, मैदा, लोबिया, मस्सर, पूजे रे छोले, <verse eid="2SA 17:28" /><verse number="29" style="v" sid="2SA 17:29" />सईत, नऊणीं, पेडा-बाकरिया ओर गायी रे दईंए रा पनीर, दाऊद ओर तेसरे साथिया खे खाणे खे ये सोची की ल्याए, “जंगल़ो दे सेयो लोक पूखे त्याये ओर थके दे ऊणे।”<verse eid="2SA 17:29" /></para>
  <chapter eid="2SA 17" />
  <chapter number="18" style="c" sid="2SA 18" />
  <para style="s">अबशालोमो री आर ओर मौत</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 18:1" />तेबे दाऊदे आपू साथले लोका री गिणती कित्ती ओर तिना पाँदे सौ-सौ ओर ह्जार-ह्जार करी की लग कित्ते ओर तिना पाँदे परदान ओर सेनापति ठराए। <verse eid="2SA 18:1" /><verse number="2" style="v" sid="2SA 18:2" />तेबे दाऊदे लोका रा एक तिहाई योआबो रे, एक तिहाई सरूयाह रे पाऊ योआबो रे पाई अबीशै रे ओर एक तिहाई गती इत्तै रे आथो दे करी की युद्धो दे लड़ने खे पेजी ते ओर फेर दाऊद राजे लोका खे बोलेया, “मां बी तुसा साथे लड़ाई करने खे पक्का जाणा।” <verse eid="2SA 18:2" /><verse number="3" style="v" sid="2SA 18:3" />लोके बोलेया, “तूँ नि जाई सकदा, कऊँकि चाए आसे नठी जाऊँ, तेबे बी अबशालोमो म्हारी फिकर नि करनी; बल्कि चाए आसा बीचा ते आदे मरी बी जाओ, तेबे बी अबशालोमो म्हारी फिकर नि करनी, कऊँकि तू आसा जेड़े 10,000 माणूंआ रे बराबर ए; इजी री खातर अच्छा ये कि तूँ शईरो ते ई म्हारी मताद करने खे त्यार रया।” <verse eid="2SA 18:3" /><verse number="4" style="v" sid="2SA 18:4" />दाऊद राजे तिना खे बोलेया, “जो कुछ तुसा खे ठीक लगोआ, मां सेई करना।” तेबे राजा बड़े द्वारो दे एकी तरफा खे खड़ा रया ओर सारे लोक सौ-सौ ओर ह्जार-ह्जार करी की निकल़ने लगे। <verse eid="2SA 18:4" /><verse number="5" style="v" sid="2SA 18:5" />जेबे सेयो जाणे लगे तेबे दाऊद राजे योआब, अबीशै ओर इत्तै खे आज्ञा दित्ती, “मेरिया तँईं तेस जवान, मतलब अबशालोमो साथे नरम बर्ताओ करना।” ये आज्ञा राजे अबशालोमो रे बारे दे सारे परदाना खे सारे लोका रे सुणदे ऊए दित्ती। <verse eid="2SA 18:5" /><verse number="6" style="v" sid="2SA 18:6" />तेबे दाऊदो रे लोक इस्राएली लोका रा सामणा करने खे मैदानो दे निकल़े ओर एप्रैम नाओं रे बणो दे युद्ध ऊआ। <verse eid="2SA 18:6" /><verse number="7" style="v" sid="2SA 18:7" />तेती इस्राएली लोक दाऊदो रे माणूंआ ते आरी गे ओर तेस दिने एड़ा बड़ा खून-खराबा ऊआ कि 20,000 इस्राएली सैनिक मरी गे। <verse eid="2SA 18:7" /><verse number="8" style="v" sid="2SA 18:8" />युद्ध तेस सारे देशो दे फैलीगा ओर तेस दिने जितणे लोक तलवारी साथे मरे, तिना ते बी जादा बणो रिया बजअ ते मरी गे। <verse eid="2SA 18:8" /><verse number="9" style="v" sid="2SA 18:9" />एड़ा ऊआ कि लड़दे ऊए अबशालोम ओर दाऊदो रे माणूंआ रा आमणा-सामणा ऊआ। अबशालोम तो एकी खच्चरा पाँदे चढ़ी की जाणे लगी रा था कि खच्चर एक बड़े डाल़ो री कणी डाल़िया निठा ते गई ओर तेसरा सिर तेस बड़े डाल़ो रिया पाँगटिया दे फसी गा ओर से अदमँजो दे लटकेया दा रई गा ओर तेसरी खच्चर निकल़ी गी। <verse eid="2SA 18:9" /><verse number="10" style="v" sid="2SA 18:10" />ये देखी की किने माणूंए योआबो गे बोलेया, “मैं अबशालोम बड़े डाल़ो दे लटकेया दा देखेया।” <verse eid="2SA 18:10" /><verse number="11" style="v" sid="2SA 18:11" />योआबे बताणे वाल़े खे बोलेया, “तैं ये देखेया! तेबे तैं से तेथी जमीना दे काई की कऊँ नि सेटी ता? तो मां ताखे दस टुकड़े चाँदी ओर एक कटिबन्द देणा था।” <verse eid="2SA 18:11" /><verse number="12" style="v" sid="2SA 18:12" />तिने माणूंए योआबो खे बोलेया, “चाए मेरे आथो दे 1,000 टुकड़े चाँदिए रे तोली की देई देयो, तेबे बी राजकुमारो रे खलाफ आथ नि बढ़ाणा; कऊँकि आसा लोका रे सुणदे राजे ताखे, ओर अबीशै ओर इत्तै खे ये आज्ञा दित्ती थी, कि तुसा बीचा ते कोई कऊँ नि ओ तेस जवान, मतलब अबशालोमो खे नि छूँणा। <verse eid="2SA 18:12" /><verse number="13" style="v" sid="2SA 18:13" />जे आऊँ तोखा देई की तेसरे प्राण लई लंदा, तो तूँ आपू मेरा दुश्मण ऊई जाणा था, कऊँकि राजे ते कोई बी गल्ल छिपी दी नि रई सकदी।” <verse eid="2SA 18:13" /><verse number="14" style="v" sid="2SA 18:14" />योआबे बोलेया, “आऊँ तां साथे ईंयाँ ई रूकेया रा नि रई सकदा!” तेबे तिने तीन लकड़िया आथो दे लई की अबशालोमो रे दिलो दे, जो बड़े डाल़ो दे जिऊँदा लटकी रा था, छेद पाईता। <verse eid="2SA 18:14" /><verse number="15" style="v" sid="2SA 18:15" />तेबे योआबो रे दस अथियार टोणे वाल़े जवाने अबशालोमो खे केरी की तेसरे एड़ी बाई की से मरी गा। <verse eid="2SA 18:15" /><verse number="16" style="v" sid="2SA 18:16" />तेबे योआबे रड़सिंगे रे फूकर दित्ती ओर लोक इस्राएली सिपाईया रा पीछा करने ते वापस ऊए, कऊँकि योआब प्रजा खे बचाणा चाओ था। <verse eid="2SA 18:16" /><verse number="17" style="v" sid="2SA 18:17" />तेबे लोके अबशालोम डाल़ो पाँदा ते थाले उतारी की तेस बणो रे एक बड़े गड्डे दे पाईता ओर तेस पाँदे पात्थरा रा एक बऊत बड़ा टेर लगाई ता ओर सारे इस्राएली सिपाई आपणे-आपणे डेरे खे नठीगे। <verse eid="2SA 18:17" /><verse number="18" style="v" sid="2SA 18:18" />आपणे जिऊँदे जियूए अबशालोमे ये सोची की कि मेरे नाओं खे याद करने वाल़ा कोई पाऊ मेरे नि ए, आपू खे तिने से खम्बा खड़ा कराया था जो राजे री काअटिया दे ए ओर खम्बे रा आपणा ई नाओं राखेया, जेतेखे आजके दिनो तक अबशालोमो रा खम्बा बोलोए।<verse eid="2SA 18:18" /></para>
  <para style="s">अबशालोमो री मौता रा दाऊदो खे सन्देश</para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 18:19" />अबशालोमो रे मरने ते बाद सादोको रे पाऊ अहीमासे बोलेया, “माखे दौड़ी की राजे खे ये सन्देश देणे दे कि यहोवे न्याय करी की तूँ तेरे दुश्मणा रे आथो ते बचाई राखेया।” <verse eid="2SA 18:19" /><verse number="20" style="v" sid="2SA 18:20" />योआबे तेसखे बोलेया, “तूँ आजके दिने सन्देश नि दे, दूजे दिने सन्देश देई सकेया, पर आज सन्देश नि दे, कऊँकि राजकुमार मरी गा रा।” <verse eid="2SA 18:20" /><verse number="21" style="v" sid="2SA 18:21" />तेबे योआबे एक कूशी माणूंए खे बोलेया, “जो कुछ तैं देखी राखेया से जाई की राजे गे बताई दे।” तेबे से कूशी योआबो गे माथा टेकी की दौड़ी गा। <verse eid="2SA 18:21" /><verse number="22" style="v" sid="2SA 18:22" />तेबे सादोको रे पाऊ अहीमासे दूजी बार योआबो ते बोलेया, “जो ओ, सो ओ, पर माखे बी कूशिये पीछे दौड़ने दे।” योआबे बोलेया, “ओ मेरे पाऊ, तेरे सन्देशो रा कोई बदला नि मिलणा, तेबे तूँ कऊँ दौड़ना चाएया?” <verse eid="2SA 18:22" /><verse number="23" style="v" sid="2SA 18:23" />तिने ये बोलेया, “जो ओ, सो ओ, पर माखे दौड़ने दे।” तिने तेसखे बोलेया, “ठीक ए, दाऊदो गे दौड़ी की जा।” तेबे अहीमास दौड़ेया ओर काअटिया ते ऊई की कूशिये ते आगे चलीगा। <verse eid="2SA 18:23" /><verse number="24" style="v" sid="2SA 18:24" />दाऊद तो दूई बड़े द्वारा बीचे बैठी रा था कि पईरेदार जो बड़े द्वारो रे छतो ते दवाला पाँदे चढ़ीगा था, तिने आखी चकी की क्या देखेया कि एक माणूं कल्ला दौड़ी की आऊणे लगी रा। <verse eid="2SA 18:24" /><verse number="25" style="v" sid="2SA 18:25" />जेबे पईरेदारे आका पाई की राजे गे ये बताईता, तेबे राजे बोलेया, “जे कल्ला आऊणे लगी रा तो खरा ई सन्देशा लई की आऊणे लगी रा ऊणा।” से दौड़दे-दौड़दे निकल़ी की आया। <verse eid="2SA 18:25" /><verse number="26" style="v" sid="2SA 18:26" />तेबे पईरेदारे एक ओर माणूं दौड़दा ऊआ देखी की बड़े द्वारो रे रखवाल़े खे आका पाई की बोलेया, “सुण, एक ओर माणूं कल्ला दौड़ी की आऊणे लगी रा।” राजे बोलेया, “से बी खरा ई सन्देशा ल्याऊणे लगी रा ऊणा।” <verse eid="2SA 18:26" /><verse number="27" style="v" sid="2SA 18:27" />पईरेदारे बोलेया, “माखे तो एड़ा लगोआ कि जो पईले दौड़ी की आऊणे लगी रा, से सादोको रे पाऊ अहीमासो जेड़ा ए।” राजे बोलेया, “से तो पला माणूं ए, तो खरा सन्देशा ल्याओ ऊणा।” <verse eid="2SA 18:27" /><verse number="28" style="v" sid="2SA 18:28" />जेबे अहीमासे आका पाई की राजे खे बोलेया, “सारे ठीक ए।” तेबे तिने मुंए रे पारे जमीना दे पड़ी की राजे गे माथा टेकी की बोलेया, “तेरा यहोवा परमेशर तन्य ए, जिने मेरे प्रभु राजे रे खलाफ आथ उठाणे वाल़ा माणूं तेरे वशो दे करी ता!” <verse eid="2SA 18:28" /><verse number="29" style="v" sid="2SA 18:29" />राजे पूछेया, “क्या से जवान अबशालोम ठीक ए।” अहीमासे बोलेया, “जेबे योआबे राजे रा कर्मचारी ओर तेरा दास पेजीता, तेबे माखे बऊत बड़ी पीड़ दिखी, पर पता नि लगेया कि क्या ऊई रा था।” <verse eid="2SA 18:29" /><verse number="30" style="v" sid="2SA 18:30" />राजे बोलेया, “अटी की एथी खड़ा रओ।” तेबे से अटी की खड़ा रया। <verse eid="2SA 18:30" /><verse number="31" style="v" sid="2SA 18:31" />तेबे कूशी माणूं बी आई गा ओर कूशी बोलणे लगेया, “मेरे प्रभु राजे खे सन्देश ए। यहोवे आज न्याय करी की तूँ तेरे सारे दुश्मणा ते बचाई राखेया जो तेरे खलाफ उठे थे।” <verse eid="2SA 18:31" /><verse number="32" style="v" sid="2SA 18:32" />राजे कूशी माणूंए ते पूछेया, “क्या से जवान मतलब अबशालोम ठीक ए?” कूशिये बोलेया, “मेरे प्रभु राजे रे दुश्मण ओर जितणे लोक तेरा नुकशाण करने खे आए थे, तिना री दशा तेस जवानो री जी ओ।” <verse eid="2SA 18:32" /><verse number="33" style="v" sid="2SA 18:33" />तेबे राजा बऊत डरीगा ओर बड़े द्वारो पाँदले कमरे दे रोंदा ऊआ चढ़ने लगेया ओर चलदे-चलदे ईंयाँ बोलदा गया, “हाय मेरे पाऊ अबशालोम! मेरे पाऊ, हाय! मेरे पाऊ अबशालोम! पला ऊँदा कि आऊँ आपू तेरे बदले मरदा, हाय! अबशालोम! मेरे पाऊ, मेरे पाऊ!”<verse eid="2SA 18:33" /></para>
  <chapter eid="2SA 18" />
  <chapter number="19" style="c" sid="2SA 19" />
  <para style="s">योआबो रा दाऊदो खे चिड़कणा</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 19:1" />तेबे योआबो खे ये सन्देश मिलेया, “दाऊद राजा अबशालोमो रिया तँईं रोणे लगी रा ओर दु:ख करने लगी रा।” <verse eid="2SA 19:1" /><verse number="2" style="v" sid="2SA 19:2" />अबशालोमो रे मरने ते से बऊत दु:खी था, इजी री खातर तेस दिनो री जीत सारे लोका री समजा दे दु:खो री ई बजअ बणीगी; कऊँकि लोके तेस दिने सुणेया कि दाऊद राजा आपणे पाऊए खे दु:खी ए। <verse eid="2SA 19:2" /><verse number="3" style="v" sid="2SA 19:3" />इजी री खातर तेस दिने लोक एड़ा मूँ लकोई की शईरो दे कूसे, जेड़े लोक युद्धो ते नठी की आऊणे ते शर्मिंदा ऊई की मूँ लकोए। <verse eid="2SA 19:3" /><verse number="4" style="v" sid="2SA 19:4" />ओर दाऊद राजा मूँ टखी की जोरे-जोरे की रोणे लगेया, “हाय मेरे पाऊ अबशालोम! हाय अबशालोम, मेरे पाऊ, मेरे पाऊ!” <verse eid="2SA 19:4" /><verse number="5" style="v" sid="2SA 19:5" />तेबे योआब मईलो दे दाऊद राजे गे जाई की बोलणे लगेया, “तेरे कर्मचारिये आजके दिने तेरे, ओर तेरे माठे-बेटिया रे, ओर तेरी लाड़िया रे ओर तेरी रखैलिया रे प्राण बचाई राखे, पर तैं आज सबी रा मूँ काल़ा करी राखेया; <verse eid="2SA 19:5" /><verse number="6" style="v" sid="2SA 19:6" />कऊँकि तूँ आपणे दुश्मणा साथे प्यार ओर आपणे चाणे वाल़ेया साथे बैर राखेया। तैं आज ये दसीता कि ताखे परदाना ओर कर्मचारिया री कोई फिकर नि ए; बल्कि माखे आज पता लगी गा कि जे आसे सारे आज मरी जांदे ओर अबशालोम जिऊँदा रंदा, तो तूँ बऊत खुश ऊणा था। <verse eid="2SA 19:6" /><verse number="7" style="v" sid="2SA 19:7" />इजी री खातर एबे उठी की बारे जा ओर आपणे कर्मचारिया खे शान्ति दे; नई तो आऊँ यहोवे री कसम खाई की बोलूँआ कि जे तूँ बारे नि गया, तो आज राती एक बी माणूं तां साथे नि रणा ओर तेरे बचपनो ते लई की आजो तक जितणिया मुसीबता तां पाँदे पड़ी रिया, तिना सबी ते ये मुसीबत बड़ी ऊणी।” <verse eid="2SA 19:7" /><verse number="8" style="v" sid="2SA 19:8" />तेबे राजा उठी की बड़े द्वारो गे जाई की बैठेया। जेबे सारे लोका गे ये बोलेया कि राजा बड़े द्वारो गे बैठी रा; तेबे सारे लोक राजे सामणे आए। एते बीचे इस्राएली सिपाई आपणे-आपणे कअरा खे नठीगे थे।<verse eid="2SA 19:8" /></para>
  <para style="s">दाऊदो रा फेर राजा बणना</para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 19:9" />इस्राएलो रे सारे गोत्रा रे लोक आपू बीचे ये बोली की लड़ो थे, “दाऊद राजे आसे म्हारे दुश्मणा रे आथो ते बचाए थे ओर पलिश्तिया रे आथो ते तिने ई आसे छुड़ाए; पर एबे से अबशालोमो रे डरो रे मारे देश छाडी की नठी गा, <verse eid="2SA 19:9" /><verse number="10" style="v" sid="2SA 19:10" />अबशालोम जेसरा आसे आपणा राजा ऊणे खे अभिषेक कित्तेया था, से युद्धो दे मरी गा रा। तो तुसे एबे चुप कऊँ रओए? ओर राजे खे वापस ल्याऊणे री चर्चा कऊँ नि करदे?” <verse eid="2SA 19:10" /><verse number="11" style="v" sid="2SA 19:11" />तेबे दाऊद राजे सादोक ओर एब्यातार पुरोईता गे सन्देशा पेजेया, “यहूदी परदाना खे बोलो, ‘कि तुसे लोक राजे खे मईलो दे पऊँचाणे खे सबी ते पीछे कऊँ ओए जबकि सारे इस्राएली लोका री गल्ल बात राजे रे सुणने दे आई री कि तेसखे मईलो दे पऊँचाओ। <verse eid="2SA 19:11" /><verse number="12" style="v" sid="2SA 19:12" />तुसे लोक तो मेरे पाई, बल्कि मेरे ई कुलो रे ए; तो तुसे राजे खे वापस निणे रे सबी ते पीछे कऊँ ओए?’ <verse eid="2SA 19:12" /><verse number="13" style="v" sid="2SA 19:13" />एबे अमासा खे ये बोलो, ‘क्या तूँ मेरे कुलो रा नि ए? ओर जे तूँ योआबो रिया जगा रे सदा खे सेनापति नि ठईरे, तो परमेशर मां साथे तेड़ा ई बल्कि तिजी ते बी जादा करो।’” <verse eid="2SA 19:13" /><verse number="14" style="v" sid="2SA 19:14" />ईंयाँ तिने सारे यहूदी मर्दा रा मन आपणी तरफा खे खींजी ला कि मानो एक ई मर्द था; ओर तिने राजे खे सन्देशा पेजेया, “तूँ आपणे सारे कर्मचारिया खे लई की वापस आईजा।”<verse eid="2SA 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 19:15" />तेबे राजा वापस ऊई की यरदन नदिया तक आईगा ओर यहूदी लोक गिलगालो तक गये, ताकि तेस साथे मिली की तेसखे यरदनो ते वार ली आओ।<verse eid="2SA 19:15" /></para>
  <para style="s">शिमीए खे माफी</para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 19:16" />यहूदिया साथे गेरो रा पाऊ बिन्यामीन प्रदेशो रा शिमी बी जो बहूरीमो रा रणे वाल़ा था फटाफट दाऊद राजे खे मिलणे गया; <verse eid="2SA 19:16" /><verse number="17" style="v" sid="2SA 19:17" />तेस साथे 1,000 बिन्यामीनी मर्द थे। ओर शाऊलो रे कराने रा कर्मचारी सीबा आपणे पंद्रा पाऊ ओर बीइ दासा समेत था, ओर सेयो राजे सामणे यरदन नदिया ते पार पैदल उतरी गे। <verse eid="2SA 19:17" /><verse number="18" style="v" sid="2SA 19:18" />ओर एक बेड़ा राजे रे परिवारो खे वार ल्याऊणे ओर जेस कामो दे से तेसखे लगाणा चाओ तिदे ई लगणे खे पार गया। जेबे राजा यरदनो ते पार जाणे वाल़ा था, तेबे गेरो रा पाऊ शिमी तेसरे पैरा पाँदे पड़ी की, <verse eid="2SA 19:18" /><verse number="19" style="v" sid="2SA 19:19" />राजे खे बोलणे लगेया, “मेरा प्रभु मेरे दोषो रा लेखा नि लओ ओर जेस दिने मेरा प्रभु राजा यरूशलेम शईरो खे छाडी की आया, तेस दिने तेरे दासे जो बुरा काम कित्तेया, तेतेखे एड़ा याद नि करो कि राजा तिजी खे आपणे त्यानो दे राखो। <verse eid="2SA 19:19" /><verse number="20" style="v" sid="2SA 19:20" />कऊँकि तेरा दास जाणोआ कि मैं पाप करी राखेया; देख, आज आपणे प्रभु राजे साथे मिलणे खे यूसुफो<note caller="+" style="f"><char style="fr" closed="false">19:20 </char><char style="fq" closed="false">यूसुफो </char><char style="ft" closed="false">सारे इस्राएली </char></note> रे सारे कराने बीचा ते आऊँ ई पईला आई रा।” <verse eid="2SA 19:20" /><verse number="21" style="v" sid="2SA 19:21" />तेबे सरूयाहो रे पाऊ अबीशै बोलेया, “शिमिये जो यहोवे रे अभिषिक्तो खे स्राप दित्तेया था, इजी बजअ ते क्या से काणा नि चाईयो?” <verse eid="2SA 19:21" /><verse number="22" style="v" sid="2SA 19:22" />दाऊदे बोलेया, “ओ सरूयाहो रे पाऊओ, माखे तुसा ते क्या काम ए कि तुसे आज मेरे बिरोदी ठईरी रे? आज इस्राएलो दे केसी खे बी मौता री सजा नि मिलणी, कऊँकि आऊँ जाणूंआ कि आज आऊँ इस्राएलो रा राजा बणी रा।” <verse eid="2SA 19:22" /><verse number="23" style="v" sid="2SA 19:23" />तेबे राजे शिमिये खे बोलेया, “ताखे मौता री सजा नि मिलणी।” ओर राजे तेसते कसम बी खाई।<verse eid="2SA 19:23" /></para>
  <para style="s">मपीबोशेतो पाँदे दाऊदो री दया री नजर</para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 19:24" />तेबे शाऊलो रा पोता मपीबोशेत राजे साथे मिलणे खे आया; तिने राजे रे चली जाणे रे दिनो ते ओर तेसरे रामो दे आऊणे रे दिनो तक ना आपणे पैरो रे नस कटे ओर ना आपणी दाढ़ी बणवाई ओर ना ई आपणे टाल्ले तुलाए थे। <verse eid="2SA 19:24" /><verse number="25" style="v" sid="2SA 19:25" />जेबे यरूशलेमो रे लोक राजे साथे मिलणे खे गये, तेबे राजे तेसते पूछेया, “ओ मपीबोशेत, तूँ मां साथे कऊँ नि गया था?” <verse eid="2SA 19:25" /><verse number="26" style="v" sid="2SA 19:26" />तिने बोलेया, “ओ मेरे प्रभु, ओ राजा, मेरे कर्मचारी सीबे माखे तोखा दित्तेया था; तेरा दास जो अपंग ए; इजी री खातर मैं आपणे सेवक सीबा खे बोलेया कि मेरे गह्दे पाँदे काठी बानी की माखे बठयाल़ी दे, मां राजे साथे चली जाणा। <verse eid="2SA 19:26" /><verse number="27" style="v" sid="2SA 19:27" />ओर मेरे कर्मचारिये मेरे प्रभु राजे सामणे मेरी चुगली करी राखी। पर मेरा प्रभु राजा परमेशरो रे दूतो जेड़ा ए ओर जो कुछ ताखे अच्छा लगो, सेई कर। <verse eid="2SA 19:27" /><verse number="28" style="v" sid="2SA 19:28" />ओ मेरे मालक! मेरे बाओ रा सारा कराना तेरी तरफा ते मौता री सजा जोगा था; पर तैं आपणा दास आपणी मेजा पाँदे खाणे वाल़ेया बीचे गिणेया। माखे क्या अक्क ए कि आऊँ राजे री दुहाई देऊँ?” <verse eid="2SA 19:28" /><verse number="29" style="v" sid="2SA 19:29" />राजे तेसखे बोलेया, “तूँ आपणी गल्ला रे बारे दे कऊँ बतांदा रएआ? मेरी ये आज्ञा ए कि तेसा जमीना खे तूँ ओर सीबा आपू बीचे बांडी लो।” <verse eid="2SA 19:29" /><verse number="30" style="v" sid="2SA 19:30" />मपीबोशेते राजे खे बोलेया, “माखे तो ये ई खरा ऊआ जो मेरा प्रभु राजा सई-सलामत आपणे कअरे आई रा, इजी री खातर सीबे खे ई सब कुछ लई ले।”<verse eid="2SA 19:30" /></para>
  <para style="s">बर्जिल्लै पाँदे दाऊदो रा दया करना</para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 19:31" />तेबे गिलाद जगा दे बर्जिल्लै रोगलीमो ते आया ओर राजे साथे यरदन नदिया ते पार गया, कि तेसखे यरदन नदिया ते पार पऊँचाओ। <verse eid="2SA 19:31" /><verse number="32" style="v" sid="2SA 19:32" />बर्जिल्लै तो स्याणा माणूं था, मतलब अस्सी साला रा था, जदुओ तक राजा महनैमो दे रओ था, तदुओ तक से तेसखे पाल़दा रया; कऊँकि से बऊत अमीर था। <verse eid="2SA 19:32" /><verse number="33" style="v" sid="2SA 19:33" />तेबे राजे बर्जिल्लै खे बोलेया, “मां साथे पार चल ओर मां तूँ यरूशलेम शईरो दे आपू साथे राखी की तूँ पाल़ना।” <verse eid="2SA 19:33" /><verse number="34" style="v" sid="2SA 19:34" />बर्जिल्लै राजे खे बोलेया, “आऊँ कितणे दिन जिऊँदा रणा, कि आऊँ राजे साथे यरूशलेम शईरो खे जाऊँ? <verse eid="2SA 19:34" /><verse number="35" style="v" sid="2SA 19:35" />आज आऊँ अस्सी साला राए; आऊँ तो एबे खरे-बुरे रा भेद पनि करी सकदा। ओर ना तेरा दास जो कुछ खाओ-पियोआ तिजी रा स्वाद पछयाणी सकोआ। एबे माखे गाणेवाल़ेया री आवाज पनि सुणदी। तेरा दास एबे आपणे स्वामी राजे खे कऊँ बोजो री बजअ बणो? <verse eid="2SA 19:35" /><verse number="36" style="v" sid="2SA 19:36" />तेरा दास राजे साथे यरदनो ते पार तक ई जाणा। राजा इजी रा एड़ा बड़ा बदला माखे कऊँ देयो? <verse eid="2SA 19:36" /><verse number="37" style="v" sid="2SA 19:37" />आपणे दासो खे वापस ऊणे दे, ताकि आऊँ आपणे ई शईरो दे आपणे माया-बाओ रे कब्रिस्तानो गे मरूँ। पर तेरा दास मेरा पाऊ किम्हाम तांगे आजीर ए; मेरे प्रभु राजे साथे से पार जाओ ओर जेड़ा ताखे ठीक लगो तेड़ा ई तेस साथे बर्ताओ कर।” <verse eid="2SA 19:37" /><verse number="38" style="v" sid="2SA 19:38" />राजे बोलेया, “आ, किम्हाम मां साथे पार चलणा ओर जेड़ा ताखे ठीक लगो तेड़ा ई मां तेस साथे बर्ताओ करना बल्कि जो कुछ तूँ मांते चाएगा से मां तेरिया तँईं करना।” <verse eid="2SA 19:38" /><verse number="39" style="v" sid="2SA 19:39" />तेबे सारे लोक यरदन नदिया ते पार गये ओर राजा बी पार ऊआ; तेबे राजे बर्जिल्लै गल़े लगाया ओर तेसखे आशीर्वाद दित्तेया ओर से आपणी जगा खे वापस ऊईगा। <verse eid="2SA 19:39" /><verse number="40" style="v" sid="2SA 19:40" />नदी पार करने ते बाद राजा गिलगालो रिया तरफा खे पार गया ओर तेस साथे किम्हाम पार ऊआ ओर सारे यहूदी लोके ओर आदे इस्राएली लोके राजा पार पऊँचाया। <verse eid="2SA 19:40" /><verse number="41" style="v" sid="2SA 19:41" />तेबे सारे इस्राएली मर्द राजे गे आए ओर राजे खे बोलणे लगे, “क्या बजअ ए कि म्हारे यहूदी पाई ताखे चोरिए ल्याए ओर परिवारो समेत राजे खे ओर तेसरे सारे माणूंआ खे बी यरदनो ते पार ली आई रे।” <verse eid="2SA 19:41" /><verse number="42" style="v" sid="2SA 19:42" />सारे यहूदी मर्दे इस्राएली मर्दा खे ज्वाब दित्तेया, “बजअ ये कि राजा म्हारे गोत्रो राए। तो तुसे एते गल्ला ते नराज मत ओ। कऊँकि आसे राजे रा दित्तेया रा कुछ पनि खाई राखेया, ओर ना ई तिने आसा खे कुछ देई राखेया।” <verse eid="2SA 19:42" /><verse number="43" style="v" sid="2SA 19:43" />इस्राएली लोके यहूदी लोका खे ज्वाब दित्तेया, “आसे लोक दाऊद राजे रे राज्य रे दस इस्से ए। इजी री खातर आसा रा राजा दाऊदो पाँदे तुसा ते जादा अक्क ए। पर तुसे लोके आसे नकम्मे कऊँ जाणे। क्या आपणे राजे खे वापस ल्याऊणे री चर्चा पईले आसे ई नि कित्ती थी?” तेबे यहूदी लोके इस्राएली लोके ते जोरे की ओर गुस्से दे गल्ला कित्तिया।<verse eid="2SA 19:43" /></para>
  <chapter eid="2SA 19" />
  <chapter number="20" style="c" sid="2SA 20" />
  <para style="s">शेबा रा बरोद</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 20:1" />गिलगालो दे बिन्यामीनी गोत्रो रे बिक्रीए रा एक पाऊ रओ था, जेसरा नाओं शेबा था ओर से बऊत ई दखावा करने वाल़ा ओर दुष्ट था: से नरसिंगा बजाई की बोलणे लगेया, “दाऊदो दे म्हारा कोई इस्सा नि ए ओर ना ई यिशै रे पाऊए दे म्हारा कोई इस्सा ए; ओ इस्राएलियो, आपणे-आपणे डेरे खे चली जाओ!” <verse eid="2SA 20:1" /><verse number="2" style="v" sid="2SA 20:2" />तेबे सारे इस्राएली मर्द दाऊदो पीछे चलणा छाडी की बिक्रीए रे पाऊ शेबा पीछे चली पड़े; पर सारे यहूदी मर्द यरदन नदिया ते यरूशलेम शईरो तक आपणे राजे साथे लगे रे रये। <verse eid="2SA 20:2" /><verse number="3" style="v" sid="2SA 20:3" />तेबे दाऊद यरूशलेम शईरो खे आपणे मईलो दे आया ओर राजे सेयो दस रखैला खे, जिना खे से मईलो री चौकसी करने खे छाडी गा था, लग एकी कअरे राखिया, ओर तिना खे पाल़दा रया, पर से तिना साथे नि सया। इजी री खातर सेयो आपणी-आपणी मौता रे दिनो तक बिदुआ री जी दशा देई रईया। <verse eid="2SA 20:3" /><verse number="4" style="v" sid="2SA 20:4" />एक दिन राजे अमासो खे बोलेया, “यहूदी सिपाईया खे तीऊँ दिना ते पीतरे मांगे बुलाई की ल्याओ ओर तैं बी एती आजीर रणा।” <verse eid="2SA 20:4" /><verse number="5" style="v" sid="2SA 20:5" />तेबे अमासा यहूदी सिपाईया खे बुलाणे गया; पर तेसरे ठराए रे बखतो ते जादा रई गा। <verse eid="2SA 20:5" /><verse number="6" style="v" sid="2SA 20:6" />तेबे दाऊदे अबीशै खे बोलेया, “एबे बिक्रीए रे पाऊ शेबो अबशालोमो ते बी जादा म्हारा नुकशाण करना; इजी री खातर तूँ आपणे प्रभुए रे लोका खे लई की तिना रा पीछा कर ओर तेसखे काईदे, एड़ा नि ओ कि से गढ़वाल़े शईरो खे लई की म्हारी नजरा ते लूकी जाओ।” <verse eid="2SA 20:6" /><verse number="7" style="v" sid="2SA 20:7" />तेबे योआबो रे माणूं, करेती ओर पलेती लोक ओर सारे शूरवीर तेस पीछे ऊईगे ओर बिक्रीए रे पाऊ शेबा रा पीछा करने खे यरूशलेम शईरो ते निकल़े। <verse eid="2SA 20:7" /><verse number="8" style="v" sid="2SA 20:8" />सेयो गिबोन जगा दे तेस पारी पात्थरो गे पऊँचे ई थे कि अमासा तिना साथे आई की मिलेया। योआबे तो योद्धा रे टाल्ले ओर फेंटा गूड़ी राखेया था ओर तेते फेंटे दे एक तलवार आपणी कमरा दे म्यानो दे बानी री थी ओर जेबे से चलेया तेबे से निकल़ी की छूटी गी। <verse eid="2SA 20:8" /><verse number="9" style="v" sid="2SA 20:9" />तेबे योआबे अमासो ते पूछेया, “ओ मेरे पाई, क्या तूँ ठीक ए?” तेबे योआबे आपणा दाँणा आथ आगे करी की अमासो खे चूमणे खे तेसरी दाढ़ी पकड़ी। <verse eid="2SA 20:9" /><verse number="10" style="v" sid="2SA 20:10" />पर अमासे तेसा तलवारी री कोई फिकर नि कित्ती जो योआबो रे आथो दे थी ओर तिने से अमासो रे पेटो दे कोपी ती, जेते कि तेसरी आन्तड़िया निकल़ी की जमीना दे छूटी गिया ओर तिने तेसखे दूजी बार नि बाई ओर से मरी गा। तेबे योआब ओर तेसरा पाई अबीशै बिक्रीए रे पाऊ शेबा रा पीछा करने खे चले। <verse eid="2SA 20:10" /><verse number="11" style="v" sid="2SA 20:11" />तेबे तेसा लाशा गे योआबो रा एक माणूं खड़ा ऊई की बोलणे लगेया, “जो कोई योआबो रे ओर दाऊदो रे पक्षो रा ओ से योआबो पीछे ऊई जाओ।” <verse eid="2SA 20:11" /><verse number="12" style="v" sid="2SA 20:12" />अमासा री लाश तो सड़का बीचे खूने की लथपथ पड़ी री थी। तो जेबे तिने माणूंए देखेया कि सारे लोक खड़े ऊईगे दे, तेबे अमासा खे सड़का बीचा ते मैदानो दे चकी की लईगा ओर जेबे देखेया कि जितणे तेसगे आओए सेयो खड़े ऊई जाओए, तेबे तिने तेस पाँदे एक कपड़ा राखी ता। <verse eid="2SA 20:12" /><verse number="13" style="v" sid="2SA 20:13" />तेसरे सड़का बीचा ते खसकेणे ते बाद, सारे लोक बिक्रीए रे पाऊ शेबा रा पीछा करने खे योआबो पीछे ऊईगे।<verse eid="2SA 20:13" /></para>
  <para style="s">शेबा खे काणा</para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 20:14" />शेबा सारे इस्राएली गोत्रा बीचे ऊई की आबेल, बेतमाका ओर बेरिया रे देशो तक पऊँचेया ओर सेयो बी कट्ठे ऊई की तेस पीछे चली पड़े। <verse eid="2SA 20:14" /><verse number="15" style="v" sid="2SA 20:15" />तेबे योआबो रे लोके से बेतमाका दे केरी ता ओर शईरो सामणे एक टीला खड़ा कित्तेया पर शेबा दवाला साथे चिपकी गा। तेबे योआबो साथले सारे लोक दवाला खे टाल़ने खे ताक्का देणे लगे।<verse eid="2SA 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 20:16" />तेबे एक अक्लमंद जवाणसे शईरो ते आका पाईया, “सुणो! सुणो! योआबो खे बोलो कि एती आओ, ताकि आऊँ तेस साथे कुछ गल्ल करुँ।” <verse eid="2SA 20:16" /><verse number="17" style="v" sid="2SA 20:17" />जेबे योआब तेसा रे नेड़े गया, तेबे जवाणसे पूछेया, “क्या तूँ योआब ए?” तिने बोलेया, “आ, आऊँ सेईए।” तेबे तेसे तेसखे बोलेया, “आऊँ तेरी दासी ए, मेरिया गल्ला सुण।” तिने बोलेया, “आऊँ सुणने लगी रा।” <verse eid="2SA 20:17" /><verse number="18" style="v" sid="2SA 20:18" />से बोलणे लगी, “पुराणे जमाने रे लोक बोलेया करो थे, आबेल शईरो दे पूछेया जाओ, ओर ईंयाँ चगड़े खे निपटाई देयो थे। <verse eid="2SA 20:18" /><verse number="19" style="v" sid="2SA 20:19" />आऊँ तो मेलजोल करने वाल़े ओर परोसे जोगे इस्राएली लोका बीचा ते ई ए; पर तूँ एक परदान शईरो खे नाश करने री कोशिश करने लगी रा, तूँ यहोवे रे इस्से खे किंयाँ खत्म करी सकेया?” <verse eid="2SA 20:19" /><verse number="20" style="v" sid="2SA 20:20" />योआबे ज्वाब दित्तेया, “ये मांते दूर ओ, दूर, कि आऊँ नाश करुँ! <verse eid="2SA 20:20" /><verse number="21" style="v" sid="2SA 20:21" />गल्ल एड़ी नि ए। शेबा नाओं रा एप्रैम पाह्ड़ी देशो रा एक मर्द जो बिक्रीए रा पाऊ ए, तिने दाऊद राजे रे खलाफ आथ उठाई राखेया; तो तुसे लोक बस तेसखे ई म्हारे आथो दे करी देयो, तेबे मां शईरो खे छाडी की चली जाणा।” जवाणसे योआबो खे बोलेया, “तेसरा सिर दवाला ते तांगे सेटी देणा।” <verse eid="2SA 20:21" /><verse number="22" style="v" sid="2SA 20:22" />तेबे जवाणस आपणी अक्ला ते सारे लोका गे गई। तेबे तिने बिक्रीए रे पाऊ शेबा रा सिर बाडी की योआबो गे सेटी ता। तेबे योआबे नरसिंगा बजाया ओर सारे लोक शईरो ते लग-लग ऊई की आपणे-आपणे डेरे खे चली गे ओर योआब यरूशलेम शईरो दे राजे गे वापस ऊईगा।<verse eid="2SA 20:22" /></para>
  <para style="s">दाऊदो रे काम करने वाल़े</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 20:23" />योआब तो सारी इस्राएली सेना पाँदे परदान रया ओर यहोयादा रा पाऊ बनायाह करेती ओर पलेतिया पाँदे परदान था; <verse eid="2SA 20:23" /><verse number="24" style="v" sid="2SA 20:24" />ओर अदोराम बेगारो वाल़ेया पाँदे परदान था ओर अहीलूदो रा पाऊ यहोशापात इतिआसो रा लिखणे वाल़ा था; <verse eid="2SA 20:24" /><verse number="25" style="v" sid="2SA 20:25" />ओर शवा मंत्री था; ओर सादोक ओर एब्यातार पुरोईत थे; <verse eid="2SA 20:25" /><verse number="26" style="v" sid="2SA 20:26" />ओर याईर शईरो रा ईरा बी दाऊदो रा एक मंत्री था।<verse eid="2SA 20:26" /></para>
  <chapter eid="2SA 20" />
  <chapter number="21" style="c" sid="2SA 21" />
  <para style="s">गिबोनिया रा बदला</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 21:1" />दाऊदो रे दिना दे लगातार तीऊँ साला तक अकाल़ पड़ेया; तो दाऊदे यहोवे ते प्रार्थना कित्ती। यहोवे बोलेया, “ये शाऊल ओर तेसरे खूनी कराने रिया बजअ ते ऊआ, कऊँकि तिने गिबोनी लोक मरवाए थे।” <verse eid="2SA 21:1" /><verse number="2" style="v" sid="2SA 21:2" />तेबे दाऊद राजे गिबोनिया खे बुलाई की तिना साथे गल्ला कित्तिया। गिबोनी लोक इस्राएली लोका बीचा ते नि थे, सेयो बचे दे एमोरिया बीचा ते थे ओर इस्राएलिये तिना साथे कसम खाई थी, पर शाऊलो खे जो इस्राएली लोका ओर यहूदिया रिया तँईं जल़न ऊई थी, इजी ते तिने तिना खे काणे री कोशिश कित्ती थी। <verse eid="2SA 21:2" /><verse number="3" style="v" sid="2SA 21:3" />तेबे दाऊदे गिबोनिया ते पूछेया, “आऊँ तुसा रिया तँईं क्‍या करुँ? ओर क्या करी की एड़ा प्राश्चित करुँ कि तुसे यहोवे रे आपणे इस्से खे आशीर्वाद देई सको?” <verse eid="2SA 21:3" /><verse number="4" style="v" sid="2SA 21:4" />गिबोनिये तेसखे बोलेया, “आसा रे ओर शाऊल या तेसरे कराने बीचे पैसेया रा कोई लड़ाई चगड़ा नि ए ओर ना ई म्हारा काम ए कि केसी इस्राएलिये खे काऊँ।” दाऊदे बोलेया, “जो कुछ तुसा बोलणा, मां सेई तुसा रिया तँईं करना।” <verse eid="2SA 21:4" /><verse number="5" style="v" sid="2SA 21:5" />तिने राजे खे बोलेया, “जिने मर्दे आसे नाश करी ते ओर म्हारे खलाफ एड़ी साजिश कित्ती कि आसे एड़े नाश ऊई जाऊँ कि इस्राएलो रे देशो दे आगो खे नि रई सकूँ, <verse eid="2SA 21:5" /><verse number="6" style="v" sid="2SA 21:6" />तेसरे कुलो रे सात जणे आसा रे आथो दे देई दे ओर आसा तिना खे यहोवे रिया तँईं यहोवे रे चूणे दे शाऊलो री गिबा नाओं रिया बस्तिया दे फाँसी देणी।” राजे बोलेया, “मां सेयो देई देणे।” <verse eid="2SA 21:6" /><verse number="7" style="v" sid="2SA 21:7" />पर दाऊदे ओर शाऊलो रे पाऊ योनाताने आपू बीचे यहोवे री कसम खाई थी, इजी बजअ ते राजे योनातानो रा पाऊ मपीबोशेत जो शाऊलो रा पोता था बचाई की राखेया। <verse eid="2SA 21:7" /><verse number="8" style="v" sid="2SA 21:8" />पर अर्मोनी ओर मपीबोशेत नाओं रे, अय्या री बेटी रिस्पा रे दोनो पाऊ, जो शाऊलो ते पैदा ऊए थे; ओर शाऊलो री बेटी मेरबा रे पाँजो पाऊ, जो सेयो महोल शईरो दे रणे वाल़े बर्जिल्लै रे पाऊ अद्रीएलो रिया तरफा ते थे, सेयो राजे पकड़वाई की <verse eid="2SA 21:8" /><verse number="9" style="v" sid="2SA 21:9" />गिबोनिया रे आथो दे देई ते ओर तिने तिना खे पाह्ड़ो पाँदे यहोवे रे सामणे फाँसी दित्ती ओर सातो एक साथे नाश ऊईगे। तिना खे काणा बडाईया रे पईलके दिना रे, मतलब जौ रिया बडाईया री शुरूआता दे ऊआ। <verse eid="2SA 21:9" /><verse number="10" style="v" sid="2SA 21:10" />तेबे अय्या री बेटिये रिस्पे टाट लई की, बडाईया री शुरूआता ते लई की, जदुओ तक सर्गो ते तिना पाँदे बऊत जादा बर्खा नि ऊई, तदुए तक चट्टानी पाँदे तेसे से टाट आपू ते थाले बछाई की राखी ओर ना तो तेसे से दिने सर्गो रे पंछिया ते ओर ना राती बणो रे डांगरा ते आपणे बच्चेया रिया लाशा छूणे दित्तिया। <verse eid="2SA 21:10" /><verse number="11" style="v" sid="2SA 21:11" />जेबे अय्या री बेटी शाऊलो री रखैल रिस्पा रे एस कामो रा सन्देश दाऊदो खे मिलेया, <verse eid="2SA 21:11" /><verse number="12" style="v" sid="2SA 21:12" />तेबे दाऊदे जाई की शाऊल ओर तेसरे पाऊ योनातानो री आड्डिया खे गिलाद जगा रे याबेशो रे परदान लोका ते लई लिया, जो तिने बेतशान शईरो रे तेस चौको ते चोरी तिया थिया, जेती पलिश्तिये सेयो तेस दिने टँगाईया थिया, जेबे तिने शाऊल गिलबो पाह्ड़ो पाँदे काया था; <verse eid="2SA 21:12" /><verse number="13" style="v" sid="2SA 21:13" />तो से तेथा ते शाऊल ओर तेसरे पाऊ योनातानो रिया आड्डिया खे ली आया ओर जिना खे फाँसी मिली थी तिना री आड्डिया बी कट्ठिया कित्तिया। <verse eid="2SA 21:13" /><verse number="14" style="v" sid="2SA 21:14" />शाऊल ओर तेसरे पाऊ योनातानो रिया आड्डिया बिन्यामीन गोत्रो रे देशो दे जेला शईरो दे शाऊलो रे बाओ कीशो रे कब्रिस्तानो दे दबाईया ओर राजा दाऊदो री सारी आज्ञा रे मुताबिक काम ऊआ। तिजी ते बाद परमेशरे देशो रिया तँईं तिना री प्रार्थना सुणी ली।<verse eid="2SA 21:14" /></para>
  <para style="s">दाऊदो रा पलिश्तिया साथे लड़ना</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 21:15" />पलिश्तिये इस्राएली लोका साथे फेर लड़ाई कित्ती ओर दाऊद आपणे लोका समेत जाई की पलिश्तिया साथे लड़ने लगेया, पर दाऊद थकी गा। <verse eid="2SA 21:15" /><verse number="16" style="v" sid="2SA 21:16" />तेबे यिशबोबनोब, जो रपाईया रे कुलो रा था ओर तेसरे भाल़े रा पार बजनो दे साढ़े तीन किलो<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="fq" closed="false">साढ़े तीन किलो </char><char style="ft" closed="false">300 शेकेल </char></note> पीतल़ी रा था ओर तिने नई तलवार बानी राखी थी, तिने दाऊद काणा चाया था, <verse eid="2SA 21:16" /><verse number="17" style="v" sid="2SA 21:17" />पर सरूयाह रे पाऊ अबीशै दाऊदो री मताद करी की से पलिश्ती एड़ा मारेया कि से मरी गा। तेबे दाऊदो रे माणूंए कसम खाई की तेसखे बोलेया, “तां फेर आसा साथे युद्ध करने नि जाणा, एड़ा नि ओ कि तेरे मरने ते इस्राएलो रा दिऊआ बीजी जाओ।” <verse eid="2SA 21:17" /><verse number="18" style="v" sid="2SA 21:18" />इजी ते बाद पलिश्तिया साथे गोब जगा दे फेर युद्ध ऊआ; तेस बखते हूशाई सिब्बकै रपाईवंशी सप काई ता। <verse eid="2SA 21:18" /><verse number="19" style="v" sid="2SA 21:19" />तेबे गोबो दे पलिश्तिया साथे फेर युद्ध ऊआ; तिदे बेतलेहमो रे रणे वाल़ा यारयोरगीमो रा पाऊ एल्हानाने गत शईरो दे रणे वाल़ा गोलियत काई ता, जेसरे बड़छे रा डण्डा जुलाहे री डोंगिया जेड़ा था। <verse eid="2SA 21:19" /><verse number="20" style="v" sid="2SA 21:20" />फेर गतो रे बी लड़ाई ऊई ओर तेती एक बड़े डील-डौल वाल़ा एक रपाईवंशी मर्द था, जेसरे एक-एक आथ-पैरो रे छे-छे गूठिया, मतलब गिणतिया रे चौबी गूठिया थिया। <verse eid="2SA 21:20" /><verse number="21" style="v" sid="2SA 21:21" />जेबे तिने इस्राएलो खे ललकारेया, तेबे दाऊदो रे पाई शिमआह रे पाऊ योनाताने से काया। <verse eid="2SA 21:21" /><verse number="22" style="v" sid="2SA 21:22" />ये ई चारो पलिश्ती गतो रे तेस रपाईये ते पैदा ऊए थे, सेयो सब दाऊद ओर तेसरे माणूंए काईते।<verse eid="2SA 21:22" /></para>
  <chapter eid="2SA 21" />
  <chapter number="22" style="c" sid="2SA 22" />
  <para style="s">दाऊदो री जीता रा पजन</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 22:1" />जेस बखते यहोवे दाऊदो खे तेसरे सारे दुश्मणा ते ओर शाऊलो रे आथो ते बचाया था, तेस बखते तिने यहोवे खे ये गीत गाया: <verse eid="2SA 22:1" /><verse number="2" style="v" sid="2SA 22:2" />तिने बोलेया,</para>
  <para style="q" vid="2SA 22:2">“यहोवा मेरी चट्टान ओर मेरा गढ़, मेरा छुड़ाणे वाल़ा,<verse eid="2SA 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="2SA 22:3" />मेरा परमेशर मेरी रक्षा करने वाल़ा ए, जेसरी शरणा दे आऊँ आई रा,</para>
  <para style="q" vid="2SA 22:3">मेरी ढाल, मेरा बचाणे वाल़ा सींग, मेरा ऊच्चा कद ओर मेरी शरण लणे री जगा ए,</para>
  <para style="q" vid="2SA 22:3">ओ मेरे उद्धारकर्ता, तूँ कष्टा ते माखे बचाएया।<verse eid="2SA 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="2SA 22:4" />मां यहोवे खे जो स्तुतिया जोगा ए मैं तेसखे आका पाईया ओर तिने आऊँ मेरे दुश्मणा ते बचाया ए।<verse eid="2SA 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="2SA 22:5" />मौता री तरंगे मेरे चऊँ कनारे केरा पाई राखेया,</para>
  <para style="q" vid="2SA 22:5">विनाश करने वाल़ी तरंगे आऊँ डराई ता था;<verse eid="2SA 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="2SA 22:6" />अधलोको रिया रस्सिया मेरे चऊँ कनारे थिया,</para>
  <para style="q" vid="2SA 22:6">मौता रे फन्दे मेरे सामणे थे।<verse eid="2SA 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="2SA 22:7" />आपणी मुसीबता रे बखते मैं यहोवे खे आका पाईया ओर आपणे परमेशरो रे सामणे रोंदे ऊए प्रार्थना कित्ती।</para>
  <para style="q" vid="2SA 22:7">तिने मेरी प्रार्थना आपणे मन्दरो ते सुणी ली ओर मेरी दुहाई तेसरे कानो दे पऊँची।<verse eid="2SA 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="2SA 22:8" />तेबे तरती इल्ली गी ओर डोलणे लगी</para>
  <para style="q" vid="2SA 22:8">ओर सर्गो रिया निऊँआ थरथराई की बऊत ई इल्ली गिया,</para>
  <para style="q" vid="2SA 22:8">कऊँकि से बऊत गुस्से दे ऊईगा था।<verse eid="2SA 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="2SA 22:9" />तेसरी नासा ते तुआँ निकल़ेया</para>
  <para style="q" vid="2SA 22:9">ओर तेसरे मुंए ते आग निकल़ी की स्वा करने लगी;</para>
  <para style="q" vid="2SA 22:9">जेते कि कोईले सुलगी गे।<verse eid="2SA 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="2SA 22:10" />ओर से सर्गो खे खोली की थाले उतरी की आया</para>
  <para style="q" vid="2SA 22:10">ओर तेसरे पैरो ते थाले न्हेरा ऊईगा था।<verse eid="2SA 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="2SA 22:11" />से करूबो पाँदे सवार ऊई की उडी गा</para>
  <para style="q" vid="2SA 22:11">ओर अवा दे पंखो पाँदे चढ़ी की दिशणे लगेया।<verse eid="2SA 22:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="2SA 22:12" />तिने आपणे चऊँ कनारले न्हेरे खे,</para>
  <para style="q" vid="2SA 22:12">बादल़ो रे चूण्डे ओर सर्गो रे काल़े बादल़े आपणा मण्डप बणाया।<verse eid="2SA 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="2SA 22:13" />तेसरे मुंए रे तेजो ते कोईले बी बल़ने लगे।<verse eid="2SA 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="2SA 22:14" />यहोवा सर्गो ते गरजेया</para>
  <para style="q" vid="2SA 22:14">ओर परमपरदान परमेशरे आपणी बाणी सुणाई।<verse eid="2SA 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="2SA 22:15" />तिने तीर चलाई-चलाई की मेरे दुश्मण तित्तर-बित्तर करी ते</para>
  <para style="q" vid="2SA 22:15">ओर बिजल़ी ऊबा ते सेटी-सेटी की सेयो अराईते।<verse eid="2SA 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="2SA 22:16" />तेबे समुद्रो री थाली दिखणे लगी ओर दुनिया री निऊँआ खुलणे लगिया,</para>
  <para style="q" vid="2SA 22:16">ये तो यहोवे रे बकणे ते ओर तेसरे नासा ते साआ लणे ते ऊआ।<verse eid="2SA 22:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="2SA 22:17" />तिने पाँदा ते आथ बढ़ाई की आऊँ पकड़ी ता</para>
  <para style="q" vid="2SA 22:17">ओर आऊँ गईरे पाणिए बीचा ते बारे काडेया।<verse eid="2SA 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="2SA 22:18" />तिने आऊँ मेरे तागतबर दुश्मणो ते ओर मेरे बैरिया ते,</para>
  <para style="q" vid="2SA 22:18">जो मांते जादा तागतबर थे, आऊँ छुड़ाया।<verse eid="2SA 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="2SA 22:19" />तिने मेरी मुसीबता रे बखते मेरा सामणा तो कित्तेया;</para>
  <para style="q" vid="2SA 22:19">पर यहोवा मेरा सआरा था।<verse eid="2SA 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="2SA 22:20" />तिने आऊँ निकयाल़ी की खुली जगा रे पऊँचाया;</para>
  <para style="q" vid="2SA 22:20">तिने आऊँ छुड़ाया, कऊँकि से मांते खुश था।<verse eid="2SA 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="2SA 22:21" />यहोवे मां साथे मेरे तर्मो रे मुताबिक बर्ताओ कित्तेया;</para>
  <para style="q" vid="2SA 22:21">मेरे कामो री शुद्धता रे मुताबिक तिने माखे बदला दित्तेया।<verse eid="2SA 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="2SA 22:22" />कऊँकि आऊँ यहोवे री बाटा रे चलदा रया</para>
  <para style="q" vid="2SA 22:22">ओर आपणे परमेशरो ते मूँ मोड़ी की दुष्ट नि बणेया।<verse eid="2SA 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="2SA 22:23" />तिजी ते बाद नियम तो मां सामणे बणे रे रये</para>
  <para style="q" vid="2SA 22:23">ओर आऊँ तेसरी बिधिया ते आटेया नि।<verse eid="2SA 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="2SA 22:24" />आऊँ तेस साथे खरा बणेया रा रया</para>
  <para style="q" vid="2SA 22:24">ओर पापो ते आपू खे बचाई की राखेया,</para>
  <para style="q" vid="2SA 22:24">जिदे मेरे फसणे रा डर था।<verse eid="2SA 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="2SA 22:25" />इजी री खातर यहोवे मेरे तर्मो रे मुताबिक माखे बदला दित्तेया,</para>
  <para style="q" vid="2SA 22:25">मेरी तेसा शुद्धता रे मुताबिक जेतेखे से देखो था।<verse eid="2SA 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="2SA 22:26" />विश्वासो साथे तूँ आपू खे विश्वासो जोगा दखाएया;</para>
  <para style="q" vid="2SA 22:26">खरे मर्दो साथे तूँ आपू खे खरा दखाएया;<verse eid="2SA 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="2SA 22:27" />शुद्धो साथे तूँ आपू खे शुद्ध दखाएया</para>
  <para style="q" vid="2SA 22:27">ओर टेडे साथे तूँ कठोर बणेया।<verse eid="2SA 22:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="2SA 22:28" />ओर शरीफ लोका खे तूँ बचाएया,</para>
  <para style="q" vid="2SA 22:28">पर कमण्डिया पाँदे नजर करी की तिना खे इठा दखाएया।<verse eid="2SA 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="2SA 22:29" />ओ यहोवा, तूँ ई मेरा दिऊआ ए</para>
  <para style="q" vid="2SA 22:29">ओर यहोवा मेरे न्हेरे खे दूर करी की प्रयासा करी देयोआ।<verse eid="2SA 22:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="2SA 22:30" />तेरी मतादा ते आऊँ चूण्डो पाँदे अमला करूँआ,</para>
  <para style="q" vid="2SA 22:30">आपणे परमेशरो री मतादा ते आऊँ दवाल खे लाँगी देऊँआ।<verse eid="2SA 22:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="2SA 22:31" />परमेशरो री गति खरी ए;</para>
  <para style="q" vid="2SA 22:31">यहोवे रा वचन परखेया दा ए;</para>
  <para style="q" vid="2SA 22:31">से आपणे सारे शरणा रे आऊणे वाल़ेया री रक्षा करोआ।<verse eid="2SA 22:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="2SA 22:32" />यहोवे खे छाडी की कोई परमेशर नि ए?</para>
  <para style="q" vid="2SA 22:32">म्हारे परमेशरो खे छाडी की कोई चट्टान नि ए?<verse eid="2SA 22:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="2SA 22:33" />से सेई परमेशर ए, जो मेरा बऊत मजबूत कीला ए,</para>
  <para style="q" vid="2SA 22:33">से खरे माणूंए खे आपणी बाटा रे चलाओआ।<verse eid="2SA 22:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="2SA 22:34" />से मेरे पैरा खे ईरणियां जेड़ा बणाई देयोआ</para>
  <para style="q" vid="2SA 22:34">ओर माखे ऊच्ची जगा रे खड़ा करोआ।<verse eid="2SA 22:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="2SA 22:35" />से मेरे आथा खे युद्ध करना सिखाओआ,</para>
  <para style="q" vid="2SA 22:35">एथो तक की मेरिया बांयी पीतल़ी रे धनुषो खे चलाई सकोईया।<verse eid="2SA 22:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="2SA 22:36" />तैं माखे आपणे उद्धारो री ढाल देई राखी</para>
  <para style="q" vid="2SA 22:36">ओर तेरी नरमाई माखे बढ़ाओई।<verse eid="2SA 22:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="2SA 22:37" />तूँ मेरे पैरा खे जगा चौड़ी करेया</para>
  <para style="q" vid="2SA 22:37">कि मेरे पैर नि खरीसड़ो।<verse eid="2SA 22:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="2SA 22:38" />मैं आपणे दुश्मणा रा पीछा करी की सेयो नाश करी ते</para>
  <para style="q" vid="2SA 22:38">ओर जदुओ तक तिना रा अन्त नि कित्तेया तदुओ तक वापस नि ऊआ।<verse eid="2SA 22:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="2SA 22:39" />मैं तिना रा अन्त कित्तेया</para>
  <para style="q" vid="2SA 22:39">ओर सेयो एड़े काईल कित्ते कि सेयो उठी नि सकदे;</para>
  <para style="q" vid="2SA 22:39">बल्कि सेयो मेरे पैरा निठे पड़ी रे।<verse eid="2SA 22:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="2SA 22:40" />तैं युद्धो खे मेरा लक मजबूत कित्तेया</para>
  <para style="q" vid="2SA 22:40">ओर मेरे बिरोदी मां सामणे अराईते।<verse eid="2SA 22:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="2SA 22:41" />ओर तैं मेरे दुश्मणा री पीठ माखे दखाई,</para>
  <para style="q" vid="2SA 22:41">ताकि आऊँ आपणे बैरिया खे बाडी सकूँ।<verse eid="2SA 22:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="2SA 22:42" />तिने मताद तो न्याल़ी, पर कोई बचाणे वाल़ा नि मिलेया;</para>
  <para style="q" vid="2SA 22:42">तिने यहोवे री आश तो कित्ती पर तिने तिना खे कोई ज्वाब नि दित्तेया।<verse eid="2SA 22:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="2SA 22:43" />तेबे मैं सेयो कूटी-कूटी की जमीना री तूड़ा जेड़े करी ते,</para>
  <para style="q" vid="2SA 22:43">मैं सेयो सड़क ओर गल़िया रे चीकड़ो जेड़े पटकी-पटकी की चऊँ कनारे फैलाईते।”<verse eid="2SA 22:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="2SA 22:44" />तेबे तैं आऊँ प्रजा रे चगड़ेया ते छुड़ाई की दूजी जातिया रा परदान ऊणे खे मेरी रक्षा कित्ती;</para>
  <para style="q" vid="2SA 22:44">जिना लोका खे आऊँ नि जाणूं था सेयो बी मेरे वशो दे ऊई जाणे।<verse eid="2SA 22:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="2SA 22:45" />परदेशिया मेरी चुगली करनी;</para>
  <para style="q" vid="2SA 22:45">तिना मेरा नाओं सुणदे ई मेरे वशो रे ऊई जाणा।<verse eid="2SA 22:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="2SA 22:46" />परदेशी नराश ऊई जाणे</para>
  <para style="q" vid="2SA 22:46">ओर आपणे कअरा ते डरदे ऊए निकल़ने।<verse eid="2SA 22:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="2SA 22:47" />यहोवा जिऊँदा ए; मेरी चट्टान तन्य ए</para>
  <para style="q" vid="2SA 22:47">ओर परमेशर जो मेरे उद्धारो री चट्टान ए, तेसरी महिमा ओ।<verse eid="2SA 22:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="2SA 22:48" />तन्य ए मेरा बदला लणे वाल़ा परमेशर,</para>
  <para style="q" vid="2SA 22:48">जो देशो-देशो रे लोका खे मेरे वशो रे करी देयोआ<verse eid="2SA 22:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="2SA 22:49" />ओर माखे मेरे दुश्मणा बीचा ते निकयाल़ोआ;</para>
  <para style="q" vid="2SA 22:49">आ, तूँ माखे मेरे बिरोदिया ते ऊच्चा करेया</para>
  <para style="q" vid="2SA 22:49">ओर अत्याचार करने वाल़ेया लोका ते माखे बचाएया।<verse eid="2SA 22:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="2SA 22:50" />इजी बजअ ते, ओ यहोवा, मां जातिया-जातिया रे सामणे तेरा तन्यवाद करना</para>
  <para style="q" vid="2SA 22:50">ओर तेरे नाओं रा पजन गाणा<verse eid="2SA 22:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="2SA 22:51" />से आपणे ठराए रे राजे रा बड़ा उद्धार करोआ,</para>
  <para style="q" vid="2SA 22:51">से आपणे अभिषिक्त दाऊद ओर तेसरे कुलो पाँदे युगो-युगो तक दया करदा रणा।<verse eid="2SA 22:51" /></para>
  <chapter eid="2SA 22" />
  <chapter number="23" style="c" sid="2SA 23" />
  <para style="s">दाऊदो रे जीवनो रे आखरी बखतो रे वचन</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 23:1" />दाऊदो रे आखरी वचन यो ए: यिशै रे पाऊए री ये बाणी ए, तेस मर्दो री बाणी ए</para>
  <para style="q" vid="2SA 23:1">जो ऊच्चे रे खड़ा कित्तेया गया ओर याकूबो रे परमेशरो रा अभिषिक्त ओर इस्राएलो रा मिठे पजन गाणे वाल़ा ए:<verse eid="2SA 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="2SA 23:2" />“यहोवे रा आत्मा मांदे ऊई की बोलोआ</para>
  <para style="q" vid="2SA 23:2">ओर तेसरा ई वचन मेरे मुंए दे आया।<verse eid="2SA 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="2SA 23:3" />इस्राएलो रे परमेशरे बोली राखेया,</para>
  <para style="q" vid="2SA 23:3">इस्राएलो री चट्टाने मां साथे गल्ला करी राखिया कि माणूंआ पाँदे राज करने वाल़ा एक तर्मी ऊणा,</para>
  <para style="q" vid="2SA 23:3">जेस परमेशरो रा डर मानदे ऊए राज करना,<verse eid="2SA 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="2SA 23:4" />से मानो प्यागा रा प्रयासा ऊणा जेबे सूरज निकल़ोआ,</para>
  <para style="q" vid="2SA 23:4">एड़ी प्याग जिदे बादल़ नि ओ,</para>
  <para style="q" vid="2SA 23:4">जेड़ी बर्खा ते बाद छाँट निबल़ो रिया बजअ ते जमीना ते अरा-अरा काआ जम्मोआ।<verse eid="2SA 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="2SA 23:5" />क्या मेरा कराना परमेशरो रिया नजरा दे एड़ा नि ए?</para>
  <para style="q" vid="2SA 23:5">तिने तो मां साथे सदा री एक एड़ी वाचा बानी राखी,</para>
  <para style="q" vid="2SA 23:5">जो सबी गल्ला रे ठीक कित्ती री ओर अटल़ बी ए।</para>
  <para style="q" vid="2SA 23:5">कऊँकि चाए से तिजी खे बताओ नि,</para>
  <para style="q" vid="2SA 23:5">तेबे बी मेरा पूरा उद्धार ओर पूरी इच्छा रे बारे दे सेईए।<verse eid="2SA 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="2SA 23:6" />पर सारे बुरे लोक नकम्मे जाड़ो जेड़े ए जेतेखे आथो साथे पकड़ी नि सकदे;<verse eid="2SA 23:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="2SA 23:7" />पर जो लोक तिजी खे छूँओआ</para>
  <para style="q" vid="2SA 23:7">तेसखे सेयो एड़े चूबो ए जेड़े लोए रे या लकड़िया रे बणे रे ओ,</para>
  <para style="q" vid="2SA 23:7">सेयो लोक कांडेया जेड़े ऊणे, सेयो आगी दे सेटे जाणे,</para>
  <para style="q" vid="2SA 23:7">ओर सेयो पूरी तरआ ते पस्म ऊई जाणे।”<verse eid="2SA 23:7" /></para>
  <para style="s">दाऊदो रे तीन महान् योद्धा</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 23:8" />दाऊदो रे शूरवीरा रे नाओं यो ए, मतलब तहकमोनी जगा रा रणे वाल़ा योशेब्यश्शेबेत, जो सरदारा दे खास था; तेसखे एस्नी अदीनो बी बोलो थे; जिने एक ई बखते 800 सिपाई काये थे। <verse eid="2SA 23:8" /><verse number="9" style="v" sid="2SA 23:9" />तेसते बाद अहोही दोदै रा पाऊ एलीआजर था। से तेस बखते दाऊदो साथले तीनो वीरा बीचा ते था, जेबे तिने युद्ध करने खे कट्ठे ऊई रे पलिश्ती ललकारे ओर इस्राएली सिपाई दूर चली गे थे। <verse eid="2SA 23:9" /><verse number="10" style="v" sid="2SA 23:10" />से पलिश्तिया खे तदुओ तक कांदा रया जदुओ तक तेसरा आथ थकी नि गया ओर तलवार आथो साथे चिपकी नि गई ओर तेस दिने यहोवे बड़ी जीत कराई ओर जो लोक तेस पीछे ऊए सेयो सारे बस लुटणे खे ई तेस पीछे ऊए। <verse eid="2SA 23:10" /><verse number="11" style="v" sid="2SA 23:11" />तेसते बाद हरारी कुलो रे आगो रा पाऊ शम्मा था। पलिश्तिये कट्ठे ऊई की एक लही शईरो दे दल बानेया, जेती मस्सरा रा एक डोरू था ओर लोक तिना रे डरो रे मारे नठीगे। <verse eid="2SA 23:11" /><verse number="12" style="v" sid="2SA 23:12" />तेबे तिने डोरूआ बीचे खड़े ऊई की से बचाया ओर पलिश्ती काई ते ओर यहोवे बड़ी जीत दलाई। <verse eid="2SA 23:12" /><verse number="13" style="v" sid="2SA 23:13" />तेबे तीई खास सरदारा बीचा ते तीन जणे बडाईया रे बखते दाऊदो गे अदुल्लाम गुफा दे आए ओर पलिश्तिया रे दले रपाईम नाओं री काअटिया दे डेरे लगाई राखे थे। <verse eid="2SA 23:13" /><verse number="14" style="v" sid="2SA 23:14" />तेस बखते दाऊद गढ़ो रे था ओर तेस बखते पलिश्तिया री चौकी बेतलेहमो दे थी। <verse eid="2SA 23:14" /><verse number="15" style="v" sid="2SA 23:15" />एक दिन दाऊदे बड़ी इच्छा साथे बोलेया, “माखे बेतलेहमो रे बड़े द्वारो रे कुएँ रा पाणी केस पल़्याणा?” <verse eid="2SA 23:15" /><verse number="16" style="v" sid="2SA 23:16" />तेबे सेयो तीनो वीर पलिश्तिया रे डेरे दे गये ओर तिना साथे लड़े ओर बेतलेहमो रे बड़े द्वारो रे कुएँ रा पाणी परी की दाऊदो गे ली आए। पर तिने पीणे खे ना करी ती ओर यहोवे रे सामणे लटिता, <verse eid="2SA 23:16" /><verse number="17" style="v" sid="2SA 23:17" />ओर बोलेया, “ओ यहोवा, मांते एड़ा काम दूर रओ। क्या आऊँ तिना माणूंआ रा खून पियूँ जो आपणे प्राणो पाँदे खेली की गये थे?” इजी बजअ ते तिने से पाणी पीणे ते ना करी ती। इने तीऊँ वीरे यो ई काम कित्ते। <verse eid="2SA 23:17" /><verse number="18" style="v" sid="2SA 23:18" />अबीशै जो सरूयाह रे पाऊ योआबो रा छोटा पाई था, से तीऊँ ते लग था। तिने आपणा भाल़ा चलाई की 300 जणे काये ओर तीऊँ बीचे तेसरा नाओं ऊईगा। <verse eid="2SA 23:18" /><verse number="19" style="v" sid="2SA 23:19" />से तीऊँ ते जादा जाणेया-मानेया रा था। ओर इजी ते ई से तिना रा परदान ऊईगा; पर खास तीऊँ पदा पाँदे नि पऊँचेया। <verse eid="2SA 23:19" /><verse number="20" style="v" sid="2SA 23:20" />तेबे यहोयादा रा पाऊ बनायाह था, जो कबसेल शईरो दे रणे वाल़ा एक बड़ा काम करने वाल़े वीरो रा पाऊ था; तिने शेरो जेड़े दो मोआबी काये ओर बर्फ पड़ने रे बखते तिने एक गड्डे दे उतरी की एक शेर काया। <verse eid="2SA 23:20" /><verse number="21" style="v" sid="2SA 23:21" />तेबे तिने एक बांका मिस्री मर्द काया। मिस्त्रिये तो आथो रे भाल़ा लई राखेया था; पर बनायाह एक डण्डा लई की ई तेसगे गया ओर मिस्त्रिये रे आथो ते भाल़ा छुड़ाई की तेसरे ई भाल़े साथे से काई ता। <verse eid="2SA 23:21" /><verse number="22" style="v" sid="2SA 23:22" />एड़े-एड़े काम करी की यहोयादो रा पाऊ बनायाह तिना तीऊँ बीचे नामी ऊईगा। <verse eid="2SA 23:22" /><verse number="23" style="v" sid="2SA 23:23" />से तीई जणेया बीचे जादा जाणेया-मानेया रा तो था, पर खास तीऊँ पदा पाँदे नि पऊँचेया। तेसखे दाऊदे आपणी निज सभा रा सभासद नियुक्त कित्तेया। <verse eid="2SA 23:23" /><verse number="24" style="v" sid="2SA 23:24" />तेबे तीईया बीचे योआबो रा पाई असाहेल; बेतलेहमी दोदो रा पाऊ एल्हानान, <verse eid="2SA 23:24" /><verse number="25" style="v" sid="2SA 23:25" />हेरोद कुलो रा शम्मा, ओर एलीका, <verse eid="2SA 23:25" /><verse number="26" style="v" sid="2SA 23:26" />पेलेती शईरो रा हेलेस, तकोई शईरो रे इक्केशो रा पाऊ ईरा, <verse eid="2SA 23:26" /><verse number="27" style="v" sid="2SA 23:27" />अनातोत शईरो रा अबीएजेर, हूशाई कुलो रा मबुन्ने, <verse eid="2SA 23:27" /><verse number="28" style="v" sid="2SA 23:28" />अहोही कुलो रा सल्मोन, नतोपाही शईरो रा महरै, <verse eid="2SA 23:28" /><verse number="29" style="v" sid="2SA 23:29" />एक ओर नतोपाही शईरो रा बानाह रा पाऊ हेलेब, बिन्यामीनिया रे गिबा शईरो रे रीबै रा पाऊ इत्तै, <verse eid="2SA 23:29" /><verse number="30" style="v" sid="2SA 23:30" />पिरातोनी शईरो रा बनायाह, गाश पाह्ड़ो रे नाल़ेया गे रणे वाल़ा हिद्दै, <verse eid="2SA 23:30" /><verse number="31" style="v" sid="2SA 23:31" />अराबा रा अबीअल्बोन, बहूरीम शईरो रा अज्मावेत, <verse eid="2SA 23:31" /><verse number="32" style="v" sid="2SA 23:32" />शालबोन शईरो रा एल्यहबा, याशेनो रे कुलो बीचा ते योनातान, <verse eid="2SA 23:32" /><verse number="33" style="v" sid="2SA 23:33" />हरारी कुलो रा शम्मा, हरार शईरो रे शारारो रा पाऊ अहीआम, <verse eid="2SA 23:33" /><verse number="34" style="v" sid="2SA 23:34" />माका शईरो रे अहसबैए रा पाऊ एलीपेलेत गीलो शईरो रे रणे वाल़े अहीतोपेलो रा पाऊ एलीआम, <verse eid="2SA 23:34" /><verse number="35" style="v" sid="2SA 23:35" />कर्मेल शईरो रा हेस्रो, अराबी शईरो रा पारै <verse eid="2SA 23:35" /><verse number="36" style="v" sid="2SA 23:36" />सोबाई नातानो रा पाऊ यिगाल, गादी बानी, <verse eid="2SA 23:36" /><verse number="37" style="v" sid="2SA 23:37" />अम्मोनी सेलेक, बेरोत शईरो रा नहरै जो सरूयाह रे पाऊ योआबो रा अथियार टोणे वाल़ा था, <verse eid="2SA 23:37" /><verse number="38" style="v" sid="2SA 23:38" />येतेर शईरो रा ईरा ओर गारेब <verse eid="2SA 23:38" /><verse number="39" style="v" sid="2SA 23:39" />ओर हित्ती ऊरिय्याह था: सारे मिलाई की सैंती थे।<verse eid="2SA 23:39" /></para>
  <chapter eid="2SA 23" />
  <chapter number="24" style="c" sid="2SA 24" />
  <para style="s">दाऊदो रा प्रजा री गिणती कराणा ओर तिजी री सजा पुगतणा</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 24:1" />यहोवे रा रोष इस्राएली लोका पाँदे फेर पड़केया ओर तिने दाऊदो खे तिना रा नुकशाण करने खे ये बोली की सकेल़ेया, “इस्राएल ओर यहूदा रे लोका री गिणती लओ।” <verse eid="2SA 24:1" /><verse number="2" style="v" sid="2SA 24:2" />इजी री खातर राजे योआब सेनापतिये खे जो तेसगे था बोलेया, “तूँ उतर दिशा दे दानो रे इलाके ते लई की दक्खणा दे बेर्शेबा शईरो तक रणे वाल़े सारे इस्राएली गोत्रा बीचे ओरे-पोरे कूम ओर तुसे लोक प्रजा रे लोका री गिणती करो, ताकि आऊँ जाणी लऊँ कि प्रजा री कितणी गिणती ए।” <verse eid="2SA 24:2" /><verse number="3" style="v" sid="2SA 24:3" />योआबे राजे खे बोलेया, “प्रजा रे लोक कितणे बी कऊँ ना ओ, तेरा यहोवा परमेशर तिना खे सौ गुणा बढ़ाई देयो ओर मेरा प्रभु राजा इजी खे आपणी आखी साथे बी देखी सको; ओ मेरे प्रभु, ओ राजा, तूँ एड़ी गल्ल कऊँ चाएया?” <verse eid="2SA 24:3" /><verse number="4" style="v" sid="2SA 24:4" />तेबे बी राजे री आज्ञा योआब ओर सेनापतिया पाँदे हावी ऊई। तेबे योआब ओर सेनापति राजे सामणे ते इस्राएली प्रजा री गिणती करने खे चली गे। <verse eid="2SA 24:4" /><verse number="5" style="v" sid="2SA 24:5" />तिने यरदन नदिया ते पार जाई की अरोएर शईरो री दाँणी तरफा खे डेरे खड़े कित्ते, जो गाद नाल़े बीचे ओर याजेर शईरो रिया तरफा खे ए। <verse eid="2SA 24:5" /><verse number="6" style="v" sid="2SA 24:6" />तेबे सेयो गिलाद जगा दे ओर तहतीम्होदशी नाओं रे देशो दे गये, तेबे दान्यानो खे गये ओर चक्कर लगाई की सिदोनो दे पऊँचे; <verse eid="2SA 24:6" /><verse number="7" style="v" sid="2SA 24:7" />तेबे सेयो सोर नाओं रे मजबूत गढ़, हिब्बी ओर कनानिया रे सारे शईरो दे गये ओर तिने यहूदा प्रदेशो री दक्खण दिशा रे बेर्शेबा शईरो तक इस्राएलिया बीचे जाई की आपणा दौरा पूरा कित्तेया।<verse eid="2SA 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 24:8" />ईंयाँ सारे देशो रे ओरे-पोरे कूमी-कूमी की सेयो नौ मीन्ने ओर बीइ दिन बीतणे ते बाद यरूशलेम शईरो खे आए। <verse eid="2SA 24:8" /><verse number="9" style="v" sid="2SA 24:9" />तेबे योआबे प्रजा री गिणतिया रा जोड़ राजे गे सुणाया ओर तलवार चलाणे वाल़े योद्धा इस्राएलो रे तो आठ लाख ओर यहूदा रे पाँज लाख निकल़े। <verse eid="2SA 24:9" /><verse number="10" style="v" sid="2SA 24:10" />प्रजा री गिणती करने ते बाद दाऊदो रा मन बेचैन ऊआ ओर दाऊदे यहोवे खे बोलेया, “ये काम जो मैं कित्तेया से महापाप ए। तो एबे ओ यहोवा, आपणे दासो रा पाप दूर कर; कऊँकि मांते बड़ी मूर्खता ऊई री।” <verse eid="2SA 24:10" /><verse number="11" style="v" sid="2SA 24:11" />प्यागा जेबे दाऊद उठेया, तेबे यहोवे रा ये वचन गाद नाओं रे नबीए गे जो दाऊदो रा दर्शी था पऊँचेया, <verse eid="2SA 24:11" /><verse number="12" style="v" sid="2SA 24:12" />“जाई की दाऊदो खे बोल कि यहोवा ईंयाँ बोलोआ कि आऊँ ताखे तीन मुसीबता दखाऊँआ; तिना बीचा ते एक चूणी लो, ताकि आऊँ तिजी खे तां पाँदे पाऊ।” <verse eid="2SA 24:12" /><verse number="13" style="v" sid="2SA 24:13" />तेबे गादे दाऊदो गे जाई की इजी रा सन्देश दित्तेया ओर तेसते पूछेया, “क्या तेरे देशो रे सात साला रा अकाल़ पड़ो? या तीन मीन्ने तक तेरे दुश्मण तेरा पीछा करदे रओ ओर तूँ तिना ते नठदा रये? या तेरे देशो रे तीन दिन तक मरी फैली री रओ? एबे सोच-बिचार कर कि आऊँ आपणे पेजणे वाल़े खे क्या ज्वाब देऊँ?” <verse eid="2SA 24:13" /><verse number="14" style="v" sid="2SA 24:14" />दाऊदे गादो खे बोलेया, “आऊँ बड़ी मुसीबता दे ए; आसे यहोवे रे आथो दे पड़ूँए, कऊँकि तेसरी दया बड़ी ए; पर माणूंआ रे आथो दे मां नि पड़ना।”<verse eid="2SA 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 24:15" />तेबे यहोवा इस्राएली लोका पाँदे प्यागा ते ठराए रे बखतो दे मरी फैलांदा रया ओर उतर दिशा दे दानो रे इलाके ते लई की दक्खणा दे बेर्शेबा शईरो तक रणे वाल़ी प्रजा बीचा ते 70,000 लोक मरी गे। <verse eid="2SA 24:15" /><verse number="16" style="v" sid="2SA 24:16" />पर जेबे दूते यरूशलेम शईरो रा नाश करने खे तेस पाँदे आपणा आथ बढ़ाया, तेबे यहोवे तेसा मुसीबता खे पाई की दु:खी ऊआ ओर प्रजा रा नाश करने वाल़े दूतो खे बोलेया, “बस कर, एबे आपणा आथ नाश करने ते पीछे टाईलो।” तेबे यहोवे रा दूत तेस बखते अरौना नाओं रे एक यबूसिये रे खल्याणो गे था। <verse eid="2SA 24:16" /><verse number="17" style="v" sid="2SA 24:17" />तो जेबे प्रजा रा नाश करने वाल़ा दूत दाऊदो खे दिशेया, तेबे तिने यहोवे खे बोलेया, “देख, पाप तो मैं ई करी राखेया ओर गल़ती बी मैं ई करी राखी; पर इने लोके जो पेडा जेड़े ए इन्ने क्या करी राखेया? तो तेरा आथ मां पाँदे ओर मेरे बाओ रे कराने रे खलाफ ओ।”<verse eid="2SA 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 24:18" />तेस ई दिने गादे दाऊदो गे आई की बोलेया, “जाई की अरौना यबूसिये रे खल्याणो दे यहोवे री एक बेदी बणा।” <verse eid="2SA 24:18" /><verse number="19" style="v" sid="2SA 24:19" />तेबे दाऊद यहोवे री आज्ञा रे मुताबिक गादो रा गल्ल सुणी की तेती गया। <verse eid="2SA 24:19" /><verse number="20" style="v" sid="2SA 24:20" />जेबे अरौने दाऊदो खे तेसरे काम करने वाल़ेया समेत आपू गे आऊँदे ऊए देखे, तेबे तिने निकल़ी की मुंए रे पारे जमीना दे पड़ी की राजे गे माथा टेकेया।<verse eid="2SA 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 24:21" />ओर अरौने बोलेया, “मेरा प्रभु राजा आपणे दासो गे कऊँ आई रा?” दाऊदे बोलेया, “तांते ये खल्याण मोले लणे आई रा, ताकि यहोवे री एक बेदी बणवाऊँ, ताकि ये महामारी प्रजा पाँदा ते दूर ऊई जाओ।” <verse eid="2SA 24:21" /><verse number="22" style="v" sid="2SA 24:22" />अरौने दाऊदो खे बोलेया, “मेरा प्रभु राजा जो कुछ तेसखे ठीक लगो से लई की चढ़ाओ; देख, होमबलिया खे तो बल़द आए ओर बाडणे खे अथियार ओर बल़दा रे समानो आगी रा काम देणा।” <verse eid="2SA 24:22" /><verse number="23" style="v" sid="2SA 24:23" />ये सब कुछ अरौने राजे खे देईता। तेबे अरौने राजे खे बोलेया, “तेरा यहोवा परमेशर तांते खुश ओ।” <verse eid="2SA 24:23" /><verse number="24" style="v" sid="2SA 24:24" />राजे अरौना खे बोलेया, “एड़ा नि ए, मां यो सब चीजा तांते दाम देई की लणियां, मां आपणे परमेशर यहोवे खे मुफ्तो रिया होमबलिया नि चढ़ाणियां।” तो दाऊदे खल्याण ओर बल़द चाँदिए रे लगभग सात किलो सिक्के दे खरीदी ते। <verse eid="2SA 24:24" /><verse number="25" style="v" sid="2SA 24:25" />ओर दाऊदे तेती यहोवे री एक बेदी बणवाई की होमबलि ओर मेलबलि चढ़ाए ओर यहोवे देशो रिया तँईं बिनती सुणी ली, तेबे से महामारी इस्राएल देशो पाँदा ते दूर ऊई गी।<verse eid="2SA 24:25" /></para>
  <chapter eid="2SA 24" />
</usx>