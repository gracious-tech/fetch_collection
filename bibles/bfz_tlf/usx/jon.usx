<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JON" style="id" />
  <para style="h">योना</para>
  <para style="toc1">योना नबीए रे जरिये लिखी री कताब</para>
  <para style="toc2">योना</para>
  <para style="toc3">योन.</para>
  <para style="mt">योना</para>
  <para style="mt2">योना नबीए रे जरिये लिखी री कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">योना री कताब बाईबला री भविष्यबाणिया री ओरी कताब ते लग ए। ये एक एड़ी कताब ए जिदे एकी नबीए रे खतरे वाल़े कामा रे बारे दे ए, जिने परमेशरो री आज्ञा खे ना मानणे री कोशिश कित्ती थी। परमेशरे तेसखे नीनवे खे जाणे खे बोलेया, जो इस्राएलो रे सबी ते खतरनाक दुश्मण, बड़े अश्शूरो रे राज्य री राजधानी था। पर योना परमेशरो रे सन्देशो खे लई की तेती नि जाणा चाओ था, कऊँकि तेसखे पूरा परोसा था कि परमेशरे जो तेतेखे नाश करने री चतौणी देई राखी से तेस पूरी नि करनी। कई नाटको वाल़िया कटणा ते बाद, इच्छा ना ऊँदे ऊए बी तिने से आज्ञा मानी, ओर बादो ते से परमेशरो ते नराज ऊईगा जेबे नाशो रा तेसरा सन्देश पूरा नि ऊआ।</para>
  <para style="ip">ये कताब तरतिया पाँदे परमेशरो रे पूरे अधिकारो खे बताओई। पर सबी ते खास बात ये ए कि इजी दे परमेशरो खे “प्यार ओर दया रा परमेशर” बताई राखेया ए, एथो तक कि से आपणी प्रजा रे दुश्मणा खे सजा देणे ओर तिना खे नाश करने रे बदले तिना खे माफ करना ओर तिना रा उद्धार करना चाओआ।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">योना रा बुलाणा ओर तेसरी आज्ञा खे ना मानणा <char style="ior"><ref loc="JON 1:1-17">1:1-17</ref></char></para>
  <para style="io1">योने रा पछताणा ओर तेसरा छुटकारा <char style="ior"><ref loc="JON 2:1-10">2:1-10</ref> </char></para>
  <para style="io1">नीनवे रे खलाफ योने रा सन्देश <char style="ior"><ref loc="JON 3:1-10">3:1-10</ref></char></para>
  <para style="io1">नीनवे पाँदे परमेशरो री दया <char style="ior"><ref loc="JON 4:1-11">4:1-11</ref></char></para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s">परमेशरो री आज्ञा रा तोड़ना</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1" />इस्राएलो दे योना नाओं रा एक माणूं रओ था, जो अमित्तै रा पाऊ था। एक दिन यहोवे तेसते बोलेया, <verse eid="JON 1:1" /><verse number="2" style="v" sid="JON 1:2" />“उठी की तेस बड़े शईर नीनवे खे जा ओर तेसरे खलाफ प्रचार कर, कऊँकि तेसरी बुराई मेरी नजरा दे बढ़ी गी री। <verse eid="JON 1:2" /><verse number="3" style="v" sid="JON 1:3" />पर योना उठी की यहोवे ते दूर जाणे खे उल्टिया तरफा खे चलीगा। से याफा री बन्दरगाह पाँदे गया, जेती तेसखे तर्शीश जाणे वाल़ा एक जाह्ज मिलेया। तिने कराया दित्तेया ओर जाह्जो दे चढ़ीगा, ये सोची की कि से तर्शीशो खे जाई की यहोवे ते बची जाणा।” <verse eid="JON 1:3" /><verse number="4" style="v" sid="JON 1:4" />पर यहोवे समुद्रो दे एक प्रचण्ड अवा चलाई ओर समुद्रो दे तूफान इतणा खतरनाक था कि जाह्ज टूटणे रा खतरा था।<verse eid="JON 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 1:5" />तेबे मल्लाह डरी की आपणे-आपणे देवते री दुहाई देणे लगे ओर जाह्जो दे जो बपारो रा समान था तिजी खे समुद्रो दे सेटणे लगे, ताकि जाह्ज अल़्का ऊई जाओ। पर योना जाह्जो रे थालले इस्से दे उतरी की सयी गा था ओर गईरी नींजा दे पड़ी रा था। <verse eid="JON 1:5" /><verse number="6" style="v" sid="JON 1:6" />तेबे जाह्जो रा कप्तान तेसरे नेड़े आई की बोलणे लगेया, “तूँ किंयाँ सयी सकेया? उठ, ओर मतादा रिया तँईं आपणे देवते ते प्रार्थना कर! क्या पता से आसा साथे जो ऊणे लगी रा तिजी पाँदे त्यान देयो। तेबे आसे नि मरने।” <verse eid="JON 1:6" /><verse number="7" style="v" sid="JON 1:7" />तेबे तिने आपू-बीचे बोलेया, “आओ, आसे पर्ची पायी की जाणूंए कि ये मुसीबत आसा पाँदे किजी बजा ते पड़ी री।” तेबे तिने पर्ची पायी ओर पर्ची योना रे नाओं पाँदे निकल़ी। <verse eid="JON 1:7" /><verse number="8" style="v" sid="JON 1:8" />तेबे तिने तेसखे बोलेया, “आसा गे बता कि ये मुसीबत आसा पाँदे किजी बजा ते पड़ी री? तेरा काम क्या ए? ओर तूँ केथा ते आई रा? तूँ केस देशो रा ओर कुणजी जातिया राए?”<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />तिने तिना खे बोलेया, “आऊँ इब्री ए ओर आऊँ समुद्र ओर तरतिया खे बनाणे वाल़े स्वर्गो रे परमेशर यहोवे रा पग्त आ।” <verse eid="JON 1:9" /><verse number="10" style="v" sid="JON 1:10" />तेबे सेयो बऊत डरी गे ओर तेसखे बोलणे लगे, “तैं ये क्या करी राखेया?” कऊँकि तिना खे पता लगी गा था कि से परमेशरो रे सामणे ते नठी की आई रा, ओर तिने आपू ई तिना गे बताईता था। <verse eid="JON 1:10" /><verse number="11" style="v" sid="JON 1:11" />तेबे तिने योने ते पूछेया, “आसे तां साथे क्या करुँ जेते कि समुद्र शांत ऊई जाओ?” तेस बखते समुद्रो रिया लईरा बढ़ने ई लगी रिया थिया। <verse eid="JON 1:11" /><verse number="12" style="v" sid="JON 1:12" />योने तिना खे बोलेया, “माखे चकी की समुद्रो दे सेटी देयो, तेबे समुद्र शांत ऊई जाणा, कऊँकि माखे पता ए कि ये पारी तूफान तुसा पाँदे मेरी बजा ते ई आई रा।” <verse eid="JON 1:12" /><verse number="13" style="v" sid="JON 1:13" />पर सेयो एड़ा नि करना चाओ थे। इजी रे बदले, तिने जाह्ज वापस जमीना पाँदे ल्याऊणे री कोशिश कित्ती। पर सेयो एड़ा नि करी सके, कऊँकि तूफान लगातार बढ़ने ई लगी रा था।<verse eid="JON 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JON 1:14" />तेबे तिने परमेशरो खे आका पाई की बोलेया, “ओ परमेशर आसे प्रार्थना करूँए कि एस मर्दो रे प्राणो रे बदले आसे नाश नि ओऊँ ओर ना आसे निर्दोषो री अत्या रे दोषी ठराणे, कऊँकि ओ परमेशर, जो कुछ तेरी इच्छा थी सेई तैं करी राखेया।” <verse eid="JON 1:14" /><verse number="15" style="v" sid="JON 1:15" />तेबे तिने योना चकी की समुद्रो दे सेटी ता ओर समुद्रो रिया खतरनाक लईरा रूकी गिया। <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />तिने लोके देखेया कि क्या ऊआ था। तेबे सेयो यहोवे रा आदर करने लगे। तिने तेसखे बलिदान चढ़ाया। ओर तिने तेसते मान्नता मानियां। <verse eid="JON 1:16" /><verse number="17" style="v" sid="JON 1:17" />पर यहोवे योना खे निगल़ने खे एक बड़ी मच्छली ठराई राखी थी; ओर योना तेसा बड़ी मच्छलिया रे पेटो दे तीन दिन ओर तीन रात पड़ेया दा रया।<verse eid="JON 1:17" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="s">योना री प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1" />तेबे योने तेसा मच्छलिया रे पेटो ते आपणे परमेशर यहोवे ते प्रार्थना करी की बोलेया, <verse eid="JON 2:1" /><verse number="2" style="v" sid="JON 2:2" />“मैं मुसीबता रे पड़े दे यहोवे री दुहाई दित्ती ओर तिने मेरी सुणी ली री, अधलोको बीचा ते आऊँ चींगेया ओर तैं मेरी सुणी ली। <verse eid="JON 2:2" /><verse number="3" style="v" sid="JON 2:3" />तैं आऊँ गईरे पाणियो दे सेटिता, ओर आऊँ समुद्रो बीचे पड़ीगा। गईरे पाणिये आऊँ टकी ला। तैं मां पाँदे समुद्रो रिया बड़िया लईरा बईणे दित्तिया।” <verse eid="JON 2:3" /><verse number="4" style="v" sid="JON 2:4" />तेबे मैं बोलेया, “आऊँ तां सामणे ते निकयाल़ी ता दा ए, एबे आऊँ फेर तेरे पवित्र मन्दरो खे नि देखी सकदा।” <verse eid="JON 2:4" /><verse number="5" style="v" sid="JON 2:5" />आऊँ लगभग लईरा दे डुबी गया था। मेरे चऊँ कनारे गईरा पाणी था। मेरे सिरो पाँदे सबाल़ चिपकी गा था।<verse eid="JON 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 2:6" />आऊँ पाह्ड़ो री जड़ा तक डूबी गा था। आऊँ जमीना दे कैद था, जेते रे द्वार सदा खे बन्द ऊईगे थे। तेबे बी ओ मेरे परमेशर यहोवा, तैं आऊँ मौता रे मुंए ते छुड़ाया। <verse eid="JON 2:6" /><verse number="7" style="v" sid="JON 2:7" />जेबे आऊँ मरने ई वाल़ा था, तेबे मैं तूँ याद कित्तेया, प्रभु। मेरी प्रार्थना तां तक पऊँची। ये स्वर्गो दे तेरे पवित्र मन्दरो दे तां तँईं खे पऊँची गी। <verse eid="JON 2:7" /><verse number="8" style="v" sid="JON 2:8" />कुछ लोक आपणे देवतेया री बेकार मूर्तिया री पूजा करोए। सेयो आपणे दया करने वाल़े परमेशरो ते दूर ऊई जाओए। <verse eid="JON 2:8" /><verse number="9" style="v" sid="JON 2:9" />पर मां जोरे की तन्यवाद करी की ताखे बलिदान चढ़ाणा, जो मान्नत मैं मानी राखी, से पूरी करनी। पक्का परमेशर ई उद्धार करोआ। <verse eid="JON 2:9" /><verse number="10" style="v" sid="JON 2:10" />तेबे परमेशरे तेसा बड़ी मच्छलिया खे आज्ञा दित्ती ओर तेसे योना सूकी जमीना पाँदे उगल़ी ता।<verse eid="JON 2:10" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s">आज्ञा खे मानणा</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />तेबे परमेशरो रा वचन दूजी बार योना गे पऊँचेया, <verse eid="JON 3:1" /><verse number="2" style="v" sid="JON 3:2" />“उठी की तेस बड़े शईर नीनवे खे जा ओर जो गल्ल मां ताखे बोलणी, तिजी रा तिदे प्रचार कर।” <verse eid="JON 3:2" /><verse number="3" style="v" sid="JON 3:3" />एस बारी योने यहोवे री आज्ञा खे मानी की नीनवे शईरो खे गया, जो इतणा बड़ा था कि तेस पूरा देखणे खे तीन दिन लगी गे। <verse eid="JON 3:3" /><verse number="4" style="v" sid="JON 3:4" />योने शईरो दे जाई की पईले दिनो री यात्रा पूरी कित्ती ओर ये प्रचार करदा गया, “आजो ते चाल़ी दिन बाद नीनवे खत्म करी देणा।” <verse eid="JON 3:4" /><verse number="5" style="v" sid="JON 3:5" />तेबे नीनवे रे माणूंए परमेशरो री चतौणिया पाँदे परोसा कित्तेया। इजी री खातर तिने बअरतो रा प्रचार कित्तेया। ओर तिने सबी टाट टखी जो लोक दु:खी ऊणे पाँदे टखो थे। बड़ेया ते लई की छोटेया तक सबी एड़ा ई कित्तेया।<verse eid="JON 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6" />योने री चतौणी नीनवे रे राजे गे पऊँची। से आपणे सिंहासनो ते उठी की खड़ा ऊईगा। तिने आपणे राजे रे टाल्ले खोली ते। तिने बी आपणे दु:खो री टाट टखी ली। ओर तेबे से स्वाई पाँदे बैठी गा। <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />तेबे राजे नीनवे रे लोका खे ये सन्देश देणे खे दूत पेजे; “मैं ओर मेरे सला देणे वाल़ेया ये आज्ञा देई राखी कि कोई बी माणूं कुछ नि खाओ ओर ना ई पियो। एथो तक कि आपणे डांगरा खे बी खाणे-पीणे नि देयो। <verse eid="JON 3:7" /><verse number="8" style="v" sid="JON 3:8" />माणूं ओर डांगरा खे एक जेड़ा ई दु:खो रा टाल्ला टखणा चाईयो। तुसा सबी खे पूरे दिलो ते परमेशरो खे पुकारना चाईयो। बुराई करना बन्द करो। दूजेया रा नुकशाण नि करो। <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />ऊई सको परमेशर दया करो ओर आपणी इच्छा बदली देयो ओर तेसरा पड़केया रा रोष शान्त ऊई जाओ ओर आसे नाश ऊणे ते बची जाऊँ।” <verse eid="JON 3:9" /><verse number="10" style="v" sid="JON 3:10" />जेबे परमेशरे तिना रे काम देखे कि सेयो बुरी बाटा ते फिरने लगी रे, तेबे परमेशरे आपणी इच्छा बदली ती ओर तिना रा जो नुकशाण करने री तिने ठाणी राखी थी, से नि कित्तेया।<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s">योने रा गुस्सा ओर परमेशरो री दया</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />ये गल्ल योने खे बऊत ई बुरी लगी ओर तेसखे रोष आया। <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" />इजी री खातर तिने यहोवे ते एसा गल्ला रे बारे दे शकाईत कित्ती; “ओ यहोवा, क्या मैं कअरो ते निकल़ने ते पईले नि बोलेया था कि तां एड़ा ई करना? इजी बजा ते आऊँ तर्शीशो खे नठीगा! आऊँ जाणूं था कि तुँ दया करने वाल़ा ओर करूणा करने वाल़ा परमेशर ए, देरा ते रोष करने वाल़ा ओर प्यार करने वाल़ा परमेशर ए। ओर दु:ख देणे ते खुश नि ऊँदा। <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />तो एबे ओ यहोवा, मेरे प्राण लई लो, कऊँकि माखे जिऊँदे रणे ते मरना ठीक ए।” <verse eid="JON 4:3" /><verse number="4" style="v" sid="JON 4:4" />यहोवे बोलेया, “तेरा जो रोष पड़की रा, क्या से ठीक ए?” <verse eid="JON 4:4" /><verse number="5" style="v" sid="JON 4:5" />ये सुणी की योना तेस शईरो ते निकल़ी की, तेस शईरो रे पूर्बो रिया तरफा खे बैठी गा ओर तेती छत बणाई की तिजी रिया छांयी दे बैठी की ये देखणे लगेया कि शईरो खे क्या ऊणा?<verse eid="JON 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 4:6" />तेबे परमेशर यहोवा बड़े पत्तेया वाल़ी बेल लगाई ओर से योने रे नेड़े लगाईती, कि से तेसरे सिरो खे छांए देयो, ओर तेसखे तेसरे कष्टा ते बचाओ। ओर योना तेसा बड़े पत्तेया वाल़ी बेला रिया बजा ते बऊत खुश ऊआ। <verse eid="JON 4:6" /><verse number="7" style="v" sid="JON 4:7" />जेबे प्याग ऊणे लगी, तेबे यहोवे एक कीड़ा पेजेया, जिने से बड़े पत्तेया वाल़ी बेल एड़ी बाडी कि से सूकी गी। <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />जेबे सूरज निकल़ेया, तेबे परमेशरे अवा चलायी की गर्म लू चलायी। सूरजो री गर्मी योने रे सिरो पाँदे पड़ने लगी री थी। इजी ते से बऊत ई कमजोर ऊईगा। से मरना चाओ था। इजी री खातर तिने बोलेया, “माखे जिऊँदे रणे ते मरना ठीक ए।”<verse eid="JON 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9" />परमेशरे योने खे बोलेया, “तेरा रोष जो एसा बड़े पत्तेया वाल़ी बेला रिया बजा ते पड़की रा, क्या से ठीक ए?” तिने बोलेया, “आ, मेरा जो रोष पड़की रा से अच्छा ईए, बल्कि रोषो रे मारे मरना बी अच्छा ए।” <verse eid="JON 4:9" /><verse number="10" style="v" sid="JON 4:10" />तेबे यहोवे बोलेया, “जेसा बड़े पत्तेया वाल़ी बेला खे तैं कोई मईणत नि कित्ती, ना से बढ़ाई, जो एक ई राती दे ऊई ओर एक ई राती दे नाश बी ऊई, तेते पाँदे ताखे तरस आया। <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />सुण, ये बड़ा शईर नीनवे, जिदे 120,000 ते जादा लोक ए, जो आपणे खरे-बुरे रा पेत नि जाणदे। एते ते अलावा बेकसूर डांगर बी ए। तेबे क्या माखे एस बड़े शईरो रिया तँईं दु:खी नि ऊणा चाईयो?”<verse eid="JON 4:11" /></para>
  <chapter eid="JON 4" />
</usx>