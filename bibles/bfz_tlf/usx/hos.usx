<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HOS" style="id" />
  <para style="h">होशे</para>
  <para style="toc1">होशे नबीए रे जरिये लिखी री कताब</para>
  <para style="toc2">होशे</para>
  <para style="toc3">होश.</para>
  <para style="mt">होशे</para>
  <para style="mt2">होशे नबीए रे जरिये लिखी री कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">721 ई. पू. दे सामरिया रे नाशो ते पईले रे दु:खो रे बखतो दे, होशे नबीए नबी आमोसो ते बाद इस्राएलो रे उत्तरा रे इस्से दे प्रचार कित्तेया। से लोका रे मूर्तिपूजा दे फसणे ओर परमेशरो रे प्रति तिना रे अविश्वासो रिया बजा ते परेशान था। होशे एते अविश्वासो खे एकी वेश्या साथे आपणे बिना मतलबो रे ब्याओ रे जरीये बड़ी ईम्मत दखाई। जिंयाँ कि तेसरी लाड़ी, गोमेरे, तेस साथे विश्वासघात कित्तेया था, तिंयाँ ई परमेशरो रे लोके यहोवे खे छाडीता था। इजी बजा ते इस्राएलो पाँदे परमेशरो री सजा आऊणी। पर अन्तो दे आपणे लोका रे प्रति परमेशरो रा महान प्यार जितणा ओर तेस ये जाति फेर अपनाई लणी ओर इना साथे आपणा रिश्ता फेर मजबूत करी लणा। ये प्यार इना खास शब्दा रे जरीये बताई राखेया ए : “ओ एप्रैम, आऊँ ताखे किंयाँ छाडूं? ओ इस्राएल, आऊँ ताखे दुश्मणा रे आथो दे किंयाँ करी देऊँ? मेरा दिल तो उल्टा-पुल्टा ऊईगा, मेरा मन प्यारो रिया बजा ते पिगल़ी गा दा ए।” <char style="xt"><ref loc="HOS 11:8">11:8</ref></char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">होशे रा ब्या ओर तेसरा परिवार <char style="ior"><ref loc="HOS 1:1-3:5">1:1-3:5</ref></char></para>
  <para style="io1">इस्राएलो रे खलाफ सन्देश <char style="ior"><ref loc="HOS 4:1-13:16">4:1-13:16</ref> </char></para>
  <para style="io1">पछतावा ओर प्रतिज्ञा रा एक सन्देश <char style="ior"><ref loc="HOS 14:1-9">14:1-9</ref></char></para>
  <chapter number="1" style="c" sid="HOS 1" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1" />यहोवे रा ये सन्देश बेरीए रे पाऊ होशे गे पऊँचेया। ये सन्देश तेबे आया जेबे उज्जियाह, योताम, आहाज ओर हिजकिय्याह यहूदा दे राजा थे। ये सन्देश तेबे बी आया जेबे यारोबाम इस्राएलो रा राजा था। से योआशो रा पाऊ था। यहोवे तेसते जो बोलेया, से एती देई राखेया ए,<verse eid="HOS 1:1" /></para>
  <para style="s">होशे री लाड़ी ओर तिना रे बच्चे</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2" />जेबे यहोवे पईली बार होशे रे जरीये इस्राएलो रे लोका ते गल्ला कित्तिया, तेबे यहोवे होशे खे ये बोलेया, “जाई की एकी वेश्या साथे ब्या करी लो ओर फेर तेसा रे कुकर्मो रे बच्चेया खे आपणे बच्चे बणाई लो। ये एते गल्ला खे बताओआ कि इस्राएले यहोवे रे खलाफ जाई की दूजे देवतेया री सेवा करी की वेश्या जेड़े काम करी राखे।” <verse eid="HOS 1:2" /><verse number="3" style="v" sid="HOS 1:3" />तेबे तिने जाई की दिबलैमो री बेटी गोमेरो साथे ब्या करी ला। तेबे गोमेर गर्भवती ऊई ओर तेसा रे एक पाऊ ऊआ। <verse eid="HOS 1:3" /><verse number="4" style="v" sid="HOS 1:4" />यहोवे माखे बोलेया, “तेसरा नाओं यिज्रेल राख, जेतेरा मतलब ए ‘परमेशर ओरे-पोरे करोआ’ कऊँकि मां छोड़ ई राजा येहूए रे वंशो रे लोका खे ओरे-पोरे करी की सजा देणी, कऊँकि तिने यिज्रेल शईरो दे मेरे बऊत लोक काई राखे थे। केसी दिने मां इस्राएल देशो रा अंत करी देणा। <verse eid="HOS 1:4" /><verse number="5" style="v" sid="HOS 1:5" />तेस बखते मां यिज्रेलो री तराईया दे इस्राएलो री सेना री तागत पूरी तरआ ते नाश करी देणी।” <verse eid="HOS 1:5" /><verse number="6" style="v" sid="HOS 1:6" />इजी ते बाद गोमेर फेर गर्भवती ऊई ओर तेसा रे एक बेटी पैदा ऊई। तेबे यहोवे होशे खे बोलेया, “तेसा रा नाओं लोरूहामा राख, कऊँकि मां इस्राएलो रे कराने पाँदे फेर दया नि करनी ओर ना ई तिना रा पाप माफ करना। <verse eid="HOS 1:6" /><verse number="7" style="v" sid="HOS 1:7" />पर यहूदा रे कराने पाँदे मां दया करनी, मां सेयो तिना रे दुश्मणा ते छुड़ाणे, से तिना री सेना नि ऊणी जो धनुष ओर तलवारे की लड़ोए जो तिना खे बचाओ गी। ना तो अथियारा ते ओर ना सेना, कोड़ेया ओर रथा ते, बल्कि आपणी सामर्था ते बचाणे, कऊँकि आऊँ तिना रा परमेशर यहोवा ए।”<verse eid="HOS 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8" />जेबे तेसे जवाणसे लोरूहामा रा दूद छुड़ाया, तेबे से फेर गर्भवती ऊई ओर तेसा रे एक पाऊ पैदा ऊआ। <verse eid="HOS 1:8" /><verse number="9" style="v" sid="HOS 1:9" />इजी ते बाद यहोवे बोलेया, “एसरा नाओं लोअम्मी राख। कऊँकि तुसे लोक मेरी‍ प्रजा नि ए ओर ना आऊँ तुसा रा परमेशर रणा।”<verse eid="HOS 1:9" /></para>
  <para style="s">इस्राएलो री दुबारा स्थापना</para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 1:10" />यहोवे आगे बोलेया, “बखत आऊणा कि इस्राएलिया री गिणती समुद्रो रे बालुओ जेड़ी ऊई जाणी, जिना खे नापणा ओर गिणना मुश्किल ए ओर जेते जगा रे तिना खे ये बोलेया जाओआ था, ‘तुसे मेरी प्रजा नि ए’” तेसा ई जगा रे तिना खे जिऊँदे परमेशरो रे पाऊ बोलेया जाणा। <verse eid="HOS 1:10" /><verse number="11" style="v" sid="HOS 1:11" />इजी ते बाद यहूदा ओर इस्राएलो रे लोक कट्ठे ऊई की एक राज्य बणी जाणे। तिना आपू पाँदे राज करने खे एक परदान चुणना। सेयो तेथा ते आपणे देशो दे रणे खे वापस आऊणे जेती सेयो कैद थे। तिना जाणी लणा कि यिज्रेलो रा दिन एक महान दिन ए। ये से दिन ए जेबे परमेशरो आपणे लोक फेर आपणे देशो दे बसाणे।<verse eid="HOS 1:11" /></para>
  <chapter eid="HOS 1" />
  <chapter number="2" style="c" sid="HOS 2" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 2:1" />तेबे तुसे आपणे पाईया खे मेरे लोक ओर आपणियां बईणी खे दयावान बोलणा।<verse eid="HOS 2:1" /></para>
  <para style="s">इस्राएलो खे सजा ओर फेर बसाणा</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 2:2" />मेरे बच्चेयो, आपणी माया रे खलाफ मेरिया तरफा ते दोष लगाओ। से एबे मेरी लाड़ी नि रई, ओर ना एबे आऊँ तेसा रा लाड़ा ए। तेसा खे बोलो कि से वेश्या बणी कि नि रओ। ओर आपणे शरीरो खे दखाणे वाल़े टाल्ले खोली दे। <verse eid="HOS 2:2" /><verse number="3" style="v" sid="HOS 2:3" />जे से एड़ा करना बन्द नि करोगी, तो मां से नांगी करी देणी जेड़ी से जम्मणे रे दिने थी। मां से रेगिस्तानो जेड़ी बणाई देणी। से सुकी जमीना जेड़ी ऊई जाणी, ओर मां से त्यायी काई देणी। <verse eid="HOS 2:3" /><verse number="4" style="v" sid="HOS 2:4" />मां तेसा रे बच्चेया पाँदे बी कोई दया नि करनी, कऊँकि सेयो व्यभिचारो रे बच्चे ए। <verse eid="HOS 2:4" /><verse number="5" style="v" sid="HOS 2:5" />तिना रिये माये वेश्या जेड़े काम करी राखे, तिने मेरा परोसा तोड़ी राखेया, ओर तिने बऊत ई शर्मा वाल़े काम करी राखे। तिने बोलेया, “आसा आपणे देवतेया गे नठी जाणा जो आसा ते प्यार करोए। सेयो ई ए जो आसा खे खाणा पाणी देओए ओर ऊना ओर रेशमो रे टाल्ले ओर जैतूनो रा तेल ओर पीणे खे शराब देओए।” <verse eid="HOS 2:5" /><verse number="6" style="v" sid="HOS 2:6" />तो ये एड़ा ऊणा मानो आऊँ तेसा री बाटा दे कांडेया वाल़े बाड़ लगाई लगी रा। ओर तिना रे चऊँ कनारे दवाल खड़ी करने लगी रा ताकि तेसा खे बाट नि मिलो की केई जाणा। <verse eid="HOS 2:6" /><verse number="7" style="v" sid="HOS 2:7" />तेसा खे आपणे प्यार करने वाल़ेया पीछे चलदे ऊए बी सेयो नि मिलणे ओर से तिना टोल़ो गी बी, तेबे पनि मिलणे। तेबे तेसा बोलणा, “एबे मां आपणे पईलके लाड़े गे फेर वापस चली जाणा, तेस बखते मेरी जिंदगी आजो ते बऊत अच्छी थी।”<verse eid="HOS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 2:8" />तेसा खे पता नि था कि आऊँ ई से माणूं ए जिने तेसा खे से सब कुछ दित्तेया जेते री तेसा खे जरूरत थी। मैं तेसा खे नज्ज, नया शराब ओर जैतूनो रा तेल दित्तेया। मैं ई तेसा रा सूईना चाँदी बी बढ़ाया पर तेसे तिना रा इस्तेमाल मेरे बजाए बाल देवतेया री पूजा करने खे कित्तेया। <verse eid="HOS 2:8" /><verse number="9" style="v" sid="HOS 2:9" />पर एबे मां पक्केया दा नज्ज ओर नवां शराब तिना ते लई लणा, जो आऊँ हर फसला रे मौसमो दे उदारता ते देया करुँ था। मां ऊन ओर रेशमो रे टाल्ले बी वापस लई लणे जो आऊँ तिना रे नांगे शरीरो खे टखणे खे देऊँ था। <verse eid="HOS 2:9" /><verse number="10" style="v" sid="HOS 2:10" />एबे मां तेसा रे दोस्ता सामणे तेसा रा व्याभिचार सामणे ल्याऊणा, ओर कोई बी तेसा खे मेरे आथो ते बचाई नि सकणा, <verse eid="HOS 2:10" /><verse number="11" style="v" sid="HOS 2:11" />मां तेसा रे सारे त्योआर बन्द कराई देणे जिना खे मनाणे खे मैं पईले बोलेया था। एबे हर साल, हर मीन्ने नवें चाँदो ओर अफ़्ते रे रामो रे दिनो रे त्योआर बन्द करी देणे। मां सेयो सब तार्मिक त्योआर खत्म करी देणे। <verse eid="HOS 2:11" /><verse number="12" style="v" sid="HOS 2:12" />मां तेसा रे अंगूरा रे बगीचे ओर दाऊगल़े रे डाल़ नाश करी देणे, जिना रे बारे दे से बोलो थी तेसा रे प्यार करने वाल़ेया तेसा खे तेसा री सेवा करने खे देई राखे ए। मां तेसा रे अंगूरा रे बगीचे ओर फला रे बगीचे बण बणाई देणे, बणो रे जानवरा सेयो नाश करी देणे। <verse eid="HOS 2:12" /><verse number="13" style="v" sid="HOS 2:13" />सेयो दिन जेबे से बाल देवतेया खे तूप बाल़ो थी ओर बाल़ू ओर आर पईनी की आपणे प्यार करने वाल़ेया पीछे जाओ थी ओर माखे पूली जाओ थी, तिना दिना री सजा मां तेसा खे देणी, यहोवे री येई बाणी ए।<verse eid="HOS 2:13" /></para>
  <para style="s">परमेशरो री तिना रे लोका पाँदे दया</para>
  <para style="p">
    <verse number="14" style="v" sid="HOS 2:14" />पर सुणो! एक दिन मां तेसा साथे खरिया गल्ला करनिया। मां से बणो दे लई जाणी। मां तेसा खे बोलणा कि आऊँ तेसा ते बऊत प्यार करूँआ। <verse eid="HOS 2:14" /><verse number="15" style="v" sid="HOS 2:15" />तेती मां तेसा खे अंगूरा रे बगीचे देणे जो तेसा गे पईले थे। ओर आकोरो री तराई एक एड़िया जगा दे बदली देणी जेती उम्मीद ए। से तेती मां साथे खुश रणी, जेड़ी से जवानिया दे खुश थी। येई से बखत था जेबे से मिस्रो ते बारे आई थी। <verse eid="HOS 2:15" /><verse number="16" style="v" sid="HOS 2:16" />ओर यहोवे री ये बाणी ए कि तेस बखते तां माखे लाड़ा बोलणा, तां फेर कदी बी माखे “बाल देवता मेरा स्वामी” नि बोलणा।<verse eid="HOS 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HOS 2:17" />मां तिना खे बालो रा नाओ लणे नि देणा। ओर ना तिना फेर बालो रा नाओं लणा। <verse eid="HOS 2:17" /><verse number="18" style="v" sid="HOS 2:18" />तेबे मां तेस दिने इस्राएल देशो रिया तरफा ते बणो रे जानवर, सर्गो रे पंछी ओर जमीना दे लूरने वाल़े जीव-जन्तुआ साथे वाचा बानणी। मां तरतिया पाँदा ते लड़ाईया रे अथियार, धनुष ओर तलवार तोड़ी देणे। मां तुसा खे बिना फिकरो री नींज देणी। <verse eid="HOS 2:18" /><verse number="19" style="v" sid="HOS 2:19" />मां सदा खे तूँ आपणी लाड़ी बनाणे री प्रतिज्ञा करनी ओर ये प्रतिज्ञा तर्म, न्याय, करूणा ओर दया साथे करनी। <verse eid="HOS 2:19" /><verse number="20" style="v" sid="HOS 2:20" />ये सच्चाईया साथे करी जाणी ओर तां यहोवा जाणी लणा। <verse eid="HOS 2:20" /><verse number="21" style="v" sid="HOS 2:21" />तेस बखते मां तेसरी गल्ला रा ज्वाब देणा, यहोवे री ये बाणी ए। मां सर्गो खे आज्ञा देणी कि से तरतिया पाँदे बर्खा करो, <verse eid="HOS 2:21" /><verse number="22" style="v" sid="HOS 2:22" />ओर तरतिया नज्ज, नया शराब ओर ताजे तेलो री सुणी की तिना खे ज्वाब देणा ओर तिना यिज्रेलो खे ज्वाब देणा। <verse eid="HOS 2:22" /><verse number="23" style="v" sid="HOS 2:23" />मां आपणे लोक देशो दे बसाणे ओर सेयो तागतबर बनाणे। मां लोरूहामा पाँदे दया करनी जिना खे लोअम्मी बोलेया जाओआ, ओर जो लोक मेरे नि ए, बोलेया जाओआ, मां तिना खे बोलणा, “तुसे मेरे लोक ए” ओर तिना ज्वाब देणा ओ मेरे परमेशर।<verse eid="HOS 2:23" /></para>
  <chapter eid="HOS 2" />
  <chapter number="3" style="c" sid="HOS 3" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1" />इजी ते बाद यहोवे माखे बोलेया, “जा! आपणी लाड़िया ते फेर प्यार कर। से केसी दूजे माणूंए ते प्यार करोई। ओर तेसे व्याभिचार करी राखेया ए। पर आऊँ चाऊँआ कि तूँ तेसा ते तेड़ा ई प्यार करे जेड़ा आऊँ इस्राएलो रे लोका ते करूँआ। सेयो पराये देवतेया रिया तरफा खे फिरोए। ओर तिना खे बाल देवते खे किशमिशो रिया टिक्किया चढ़ाणा ओर खाणा पसन्द ए। इजी ते बाद बी आऊँ आपणे लोका ते प्यार करूँआ।” <verse eid="HOS 3:1" /><verse number="2" style="v" sid="HOS 3:2" />यहोवे रे एड़ा बोलणे ते बाद आऊँ गया ओर तेबे मैं 171 ग्राम चाँदिए रे सिक्के और 150 किलो जौ देई की से फेर खरीदी ली। <verse eid="HOS 3:2" /><verse number="3" style="v" sid="HOS 3:3" />तेबे मैं तेसा खे बोलेया, “तूँ कईया दिना तक मेरिया तँईं बैठी दी रया ओर ना तो व्याभिचार करना ओर ना केसी ओरी मर्दो साथे गल़त काम करना ओर मां बी तेरिया तँईं एड़ा ई करना।” <verse eid="HOS 3:3" /><verse number="4" style="v" sid="HOS 3:4" />कऊँकि इस्राएल लाम्बे बखतो ते बिना राजा, बिना परदान, बिना बलिदान, पवित्र खम्बेया, पुरोईता या एथो तक कि बिना मूर्तिया रे बी रणा, <verse eid="HOS 3:4" /><verse number="5" style="v" sid="HOS 3:5" />पर बादो ते, इस्राएलो रे लोक आपणी मूर्तिया री पूजा करने ते पछताणे ओर आपणे परमेशर यहोवे गे वापस आई की तेसरी आराधना करने लगणे। ओर तिना आपणे राजा दाऊदो रे वंशो री सेवा बी करनी अन्तो रे दिना दे सेयो यहोवे गे आऊणे, तेसरा आदर करना ओर तेसरे सामणे थरथराणे, ओर तेस तिना खे आशीर्वाद देणा।<verse eid="HOS 3:5" /></para>
  <chapter eid="HOS 3" />
  <chapter number="4" style="c" sid="HOS 4" />
  <para style="s">इस्राएलो पाँदे यहोवे रा कोप</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 4:1" />ओ इस्राएलो रे लोको, यहोवे इस्राएलो दे रणे वाल़ेया लोका पाँदे इना बुरिया गल्ला रा दोष लगाई राखेया ए, कि इस्राएलो री जमीना दे कोई बी माणूं परोसे जोगा नि ए। तिना गे सच्चा प्यार नि ए। सेयो परमेशरो खे जाणना नि चाँदे ए। <verse eid="HOS 4:1" /><verse number="2" style="v" sid="HOS 4:2" />एती स्राप देणे, चूठ बोलणे, अत्या करने, चोरी करने ओर व्याभिचारो खे छाडी की कुछ नि ऊँदा, सेयो मेरे सारे बिदिया ओर बिधान तोड़ो ए। सेयो ओरी रा खून बाह्ंदे रओए। <verse eid="HOS 4:2" /><verse number="3" style="v" sid="HOS 4:3" />इजी बजा ते एस देशो रोणा, ओर मैदानो रे जीव-जन्तुआ, ओर सर्गो रे पंछिया समेत तेतेरे सब रणे वाल़े नाश ऊई जाणे, ओर समुद्रो रिया मच्छल़िया बी नाश ऊई जाणिया। <verse eid="HOS 4:3" /><verse number="4" style="v" sid="HOS 4:4" />केसी ओरी पाँदे दोष नि लगाओ ओर ना दूजे पाँदे दोष लगाणे री कोशिश करो! मेरी शकाईत, ओ पुरोईत तां साथे ई ए। <verse eid="HOS 4:4" /><verse number="5" style="v" sid="HOS 4:5" />तूँ दिन-रात ठोकर ई खांदा ओर रूड़दा रएआ। ओर भविष्यबक्ता बी तां साथे रूड़दे रओए। ओर मां तेरी माया जेड़े इस्राएल बी नाश करी देणा।<verse eid="HOS 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 4:6" />परमेशर आगे बोलोआ, “मेरे लोक बर्बाद ऊणे लगी रे कऊँकि सेयो माखे नि जाणदे। तुसे पुरोईते माखे मानणे ते मना करिती दी ए, ओर मेरिया शिक्षा खे मानणा बी छाडीता दा ए इजी री खातर आऊँ तुसा खे छाडी देऊँआ ओर तुसा रे माठे मां आपणे पुरोईता रे कामो खे नि राखणे।” <verse eid="HOS 4:6" /><verse number="7" style="v" sid="HOS 4:7" />जिंयाँ पुरोईत बढ़दे गये, तिंयाँ ई सेयो मेरे खलाफ पाप करदे गये, तिना खे पुरोईता रे रूपो दे इज्जत मिलणी चाईयो थी, पर मां सेयो बेज्जत करने। <verse eid="HOS 4:7" /><verse number="8" style="v" sid="HOS 4:8" />जेबे लोक पापबलि चढ़ाओए, तो पुरोईता खे खाणा मिलोआ। इजी री खातर जेबे लोक पाप करोए, तो पुरोईत खुश ओए। <verse eid="HOS 4:8" /><verse number="9" style="v" sid="HOS 4:9" />इजी री खातर जो लोका री दशा ऊणी, सेई पुरोईतो री बी ऊणी; मां तिना रे चाल चलणो री सजा देणी ओर तिना रे कामो रे मुताबिक तिना खे बदला देणा। <verse eid="HOS 4:9" /><verse number="10" style="v" sid="HOS 4:10" />पुरोईता खाणा, पर सेयो पूखे ई रणे; तिना वेश्या साथे गल़त काम तो करना, पर तिना रे आपणे कोई ल्वाद नि ऊणी, कऊँकि तिने आऊँ, यहोवा छाडीता दा ए।<verse eid="HOS 4:10" /></para>
  <para style="s">इस्राएलो री मूर्तिपूजा</para>
  <para style="p">
    <verse number="11" style="v" sid="HOS 4:11" />यहोवा आगे बोलोआ, “वेश्या रा काम करना ओर शराब ओर ताजी शराब, शराब पीणे री आदती रिया बजा ते तिना री समजणे री तागत खत्म ऊईगी री ए। <verse eid="HOS 4:11" /><verse number="12" style="v" sid="HOS 4:12" />मेरी प्रजा रे लोक लकड़िया रे पुतले ते सवाल करोए ओर तिना रा डण्डा तिना खे भविष्य बताओआ। कऊँकि व्याभिचार कराणे वाल़ी आत्मे सेयो पड़काई राखे ओर सेयो मेरिया तँईं, मतलब आपणे परमेशरो रिया तँईं परोसे जोगे नि रये, जेड़े एक वेश्या आपणे लाड़े रिया तँईं परोसे जोगी नि रंदी।” <verse eid="HOS 4:12" /><verse number="13" style="v" sid="HOS 4:13" />तैं आपणा परमेशर छाडीता दा ए, ओर तूँ पाह्ड़ा ओर पाह्ड़िया री चूँडिया पाँदे दूजे देवतेया रे पीछे जाओई; तूँ बड़े डाल़ा, चिनारा रे डाल़ा ओर दूजे डाल़ा निट्ठे जेती कणी छांए ओई, तूप बाल़ोई। इजी बजा ते तुसा रिया बेटिया वेश्या ओर बऊआ व्याभिचार करोईया। <verse eid="HOS 4:13" /><verse number="14" style="v" sid="HOS 4:14" />पर आऊँ तिना खे तिना रे वेश्या रे कामो ओर व्याभिचारो रिया बजा ते कऊँ सजा देऊँ? कऊँकि तुसा रे लोक बी एई काम करने लगी रे, मतलब वेश्या ओर देवदासिया साथे पाप करने लगी रे। ओ मूर्ख लोको! तुसे समजणे ते ना करोए, इजी बजा ते तुसे नाश ऊई जाणे।<verse eid="HOS 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HOS 4:15" />तुसे इस्राएलिये आऊँ तिंयाँ ई छाडीता दा ए जेड़े व्याभिचार करने वाल़े आपणे जीवन साथिये खे छाडी देयो ए, पर यहूदा रे लोका खे बी पाप करने खे मत उकसाओ। गिलगालो खे नि जाओ या बेतावेनो रे शईरो दे जाई की मूर्तिया री पूजा नि करो। तेती कोई वादा नि करो, ये बोलदे ऊए कि यहोवे री जिन्दगिया री कसम, <verse eid="HOS 4:15" /><verse number="16" style="v" sid="HOS 4:16" />तुसे इस्राएलो रे लोक एक जवान गायी जेड़े टीठ ए। इजी री खातर आऊँ, यहोवा, तिना खे खाणा नि देई सकदा जेड़े एक ग्वाल़ा आपणे पेडा रे बच्चेया खे एक खरे काओ रे मैदानो दे लई जाई की खाणा देओआ। <verse eid="HOS 4:16" /><verse number="17" style="v" sid="HOS 4:17" />एप्रैम<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="fq" closed="false">एप्रैम </char><char style="ft" closed="false">इस्राएल </char></note> बी तेसरी मूर्तिया दे तेसरा साथी बणीगा दा ए। इजी री खातर तिना खे छाडी देयो। <verse eid="HOS 4:17" /><verse number="18" style="v" sid="HOS 4:18" />सेयो जेबे शराब पी चुकोए, तेबे वेश्यावृतिया दे लगी जाओए, तिना रे बड़े लोक बेज्जत ऊणे ते जादा प्यार राखोए। <verse eid="HOS 4:18" /><verse number="19" style="v" sid="HOS 4:19" />सेयो तूफानो दे फसी गे दे ए। तिना रे मूर्तिया खे बलि करने ते सिर्फ बेज्जती ई मिलणी।<verse eid="HOS 4:19" /></para>
  <chapter eid="HOS 4" />
  <chapter number="5" style="c" sid="HOS 5" />
  <para style="s">यहोवे इस्राएल ओर यहूदा रे लोका रा न्याय करना</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 5:1" />यहोवा बोलोआ, “ओ पुरोईतो, ये गल्ल सुणो! ओ इस्राएलो रे लोको, तुसे त्यान देई की सुणो! ओ राजे रे कराने रे लोको, तुसा खे बी सुणना चाईयो! कऊँकि आऊँ तुसा रा न्याय करने लगी रा! तुसा रा मूर्तिपूजा करना मिस्पा शईरो दे एकी जाल़ो जेड़ा ए; ये ताबोर पाह्ड़ो पाँदे लोका खे लगाए दे जाल़ो जेड़ा ए। <verse eid="HOS 5:1" /><verse number="2" style="v" sid="HOS 5:2" />तिने बिगड़े रेया बड़ी पारी अत्या करी राखी, इजी री खातर मां तुसा सबी खे सजा देणी।” <verse eid="HOS 5:2" /><verse number="3" style="v" sid="HOS 5:3" />आऊँ एप्रैमो रे लोका रे बारे दे सब कुछ जाणूंआ। इस्राएल जो व्याभिचार करने लगी रा, से मांते नि छिपी रा। एबे सेयो दूजे देवतेया ते मिली गये दे ए। तिने आपणे आपू खे अशुद्ध बणाई ला रा ए। <verse eid="HOS 5:3" /><verse number="4" style="v" sid="HOS 5:4" />तिना रे काम तिना खे आपणे परमेशरो री तरफा खे फिरने नि देंदे, कऊँकि तिना दे व्याभिचार करने वाल़ी आत्मा रओई ओर सेयो यहोवे खे नि जाणदे।<verse eid="HOS 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HOS 5:5" />इस्राएलो रा कमण्ड तेसरे ई खलाफ गवाई देयोआ ओर इस्राएल ओर एप्रैमो आपणे पापो रिया बजा ते ठोकर खाणी ओर यहूदा प्रदेशो बी तिना साथे ठोकर खाणी। <verse eid="HOS 5:5" /><verse number="6" style="v" sid="HOS 5:6" />सेयो आपणी पेडा-बाकरिया ओर गायी-बल़दा खे लई की परमेशरो खे टोल़ने चलणे, पर तिना खे से नि मिलणा, कऊँकि से तिना ते दूर ऊई गा दा ए। <verse eid="HOS 5:6" /><verse number="7" style="v" sid="HOS 5:7" />तिने यहोवे साथे विश्वासघात करी राखेया ए। तिना रे बच्चे तिना रे नि ए। इजी री खातर जिंयाँ ई नवें चाँदो रा त्योआर आऊणा, तेस सेयो ओर तिना रा देश नाश करी देणा। <verse eid="HOS 5:7" /><verse number="8" style="v" sid="HOS 5:8" />गिबा शईरो दे नरसिंगा ओर रामा शईरो दे तुरही बजाओ! बेतावेन शईरो रे लोका खे चतौणी देयो; ओ बिन्यामीन गोत्रो रे सिपाईयो, लड़ाईया दे आगे चलो। <verse eid="HOS 5:8" /><verse number="9" style="v" sid="HOS 5:9" />न्याय रे दिने एप्रैम ऊजड़ ऊई जाणा, जेसा गल्ला रा ऊणा जरूरी ए, मैं तिजी रा ई सन्देस इस्राएलो रे सबी गोत्रा खे देई राखेया। <verse eid="HOS 5:9" /><verse number="10" style="v" sid="HOS 5:10" />यहूदा प्रदेशो रे परदान तिना जेड़े ऊई रे जो बन्ना बढ़ाई लओए, मां तिना पाँदे आपणा रोष पाणिए जेड़ा बरसाणा।<verse eid="HOS 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HOS 5:11" />एप्रैमो रे लोका पाँदे अन्देर करी राखेया, से मुकद्दमा अरी गा रा, कऊँकि से मन लगाई की तेसा आज्ञा पाँदे चलेया। <verse eid="HOS 5:11" /><verse number="12" style="v" sid="HOS 5:12" />मां एप्रैम एड़ा नाश करना जेड़े कोई कीड़ा केसी टाल्ले रे टुकड़े खे खराब करी देयोआ। यहूदा मां तेड़ा नाश करी देणा जेड़े सड़ने रिया बजा ते लकड़िया रे टुकड़े खराब ऊई जाओए। <verse eid="HOS 5:12" /><verse number="13" style="v" sid="HOS 5:13" />एप्रैमो रे लोक जाणो थे कि सेयो ठीक नि ए। यहूदा रे लोक जाणो थे कि तिना रे काओए। एप्रैमो रे परदाना खे परोसा था कि अश्शूरो तिना री मताद करनी। तिने अश्शूरो रे महान राजे ते मताद मांगी राखी। पर से तुसा खे ठीक करने जोगा नि ए। से तुसा रे काओ ठीक नि करी सकदा। <verse eid="HOS 5:13" /><verse number="14" style="v" sid="HOS 5:14" />मां एप्रैम ओर यहूदा रे लोका पाँदे जवान शेरो जेड़े अमला करना। मां आपू तिना रे टुकड़े-टुकड़े करी देणे ओर फेर छाडी देणे। जेबे मां सेयो रगड़ी की निणे तेबे तिना खे कोई बी मांते छुड़ाई नि सकणे। <verse eid="HOS 5:14" /><verse number="15" style="v" sid="HOS 5:15" />मां फेर आपणियां जगा पाँदे आई जाणा जदुए तक कि सेयो आपणे पाप नि मानी लंदे ओर मेरा दर्शण नि मांगी लओ। ओर जेबे सेयो मुसीबता दे पड़ने, तेबे तिना आऊँ मन लगाई की टोल़ना।<verse eid="HOS 5:15" /></para>
  <chapter eid="HOS 5" />
  <chapter number="6" style="c" sid="HOS 6" />
  <para style="s">परमेशरो रिया तरफा खे वापस आऊणे रा प्रतिफल</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 6:1" />इस्राएलो रे लोका बोलणा, “आओ, आसे यहोवे रिया तरफा खे फिरूँए, कऊँकि तिने ई फाड़ी राखे ओर तेस ई ठीक करने, तिने ई काओ कित्ते ओर तेस ई म्हारे जख्मा दे पट्टी बी बानणी। <verse eid="HOS 6:1" /><verse number="2" style="v" sid="HOS 6:2" />दो दिन बाद तेस आसा खे नवां जीवन देणा। तीजे दिने तेस आसे फेर नवें जेड़े बणाई देणे। तेबे आसे तेस सामणे जिऊँदे रणे। <verse eid="HOS 6:2" /><verse number="3" style="v" sid="HOS 6:3" />आओ, आसे तेसखे यहोवे रे रूपो दे पछयाणी लईए। आओ आसे तेसखे जाणने री कोशिश करदे रईए। जेड़े प्यागा सूरजो रा आऊणा पक्का ए तेड़ा ई परमेशरो रा आऊणा बी पक्का ए। से ठण्डी रे बखतो दे ऊणे वाल़ी बर्खा जेड़ा आसा खे नवां करने आऊणा। से बरसाती री बर्खा जेड़ा ऊणा जो जमीना खे सिंजोई।”<verse eid="HOS 6:3" /></para>
  <para style="s">लोक सच्चे निए</para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 6:4" />पर परमेशर बोलोआ, “ओ एप्रैम तू दस आऊँ तां साथे क्या करुँ? ओ यहूदा, आऊँ तां साथे क्या करुँ? तुसा रा प्यार तो प्यागा रिया तुंदा जेड़ा राची जाओआ। ये छोड़ ई प्यागा रे पाल़े जेड़ा राची जाओआ। <verse eid="HOS 6:4" /><verse number="5" style="v" sid="HOS 6:5" />मैं तुसा खे चतौणी देणे खे आपणे नबी पेजे। तिने तुसा खे सन्देश दित्तेया कि मां तुसा खे सजा देणी। एबे से सजा तुसा खे जरूर मिलणी! मां अचाणक तुसा रा न्याय करने आऊणा, जेड़े प्यागा सूरज निकल़ोआ।” <verse eid="HOS 6:5" /><verse number="6" style="v" sid="HOS 6:6" />कऊँकि आऊँ बलिदानो ते नि, बणे दे प्यारो साथे ई खुश रऊँआ ओर होमबलिया ते जादा ये चाऊँआ कि लोक परमेशरो रा ज्ञान राखो। <verse eid="HOS 6:6" /><verse number="7" style="v" sid="HOS 6:7" />पर तिने लोके आदमो जेड़ी वाचा तोड़ी ती; तिने आपणे ई देशो रे मां साथे विश्वासघात करी राखेया। <verse eid="HOS 6:7" /><verse number="8" style="v" sid="HOS 6:8" />गिलाद शईरो रे सारे लोक बुरे काम करोए। तिना री अत्या रा खून सड़का दे पड़ी रा। <verse eid="HOS 6:8" /><verse number="9" style="v" sid="HOS 6:9" />पुरोईत लुटणे वाल़ेया जेड़े कट्ठे ऊई जाओए। सेयो लूकी जाओए ओर अमला करने खे त्यार रओए। सेयो शकेमो रिया बाटा दे न्याल़ोए, तेते बाटा रिये जाणे वाल़े लोका री अत्या करने खे त्यार रओए। तिने दुष्टता वाल़े काम करी राखे। <verse eid="HOS 6:9" /><verse number="10" style="v" sid="HOS 6:10" />इस्राएलो रे कराने दे मैं एड़ा काम देखी राखेया जेते कि शरीरो रे बाल़ खड़े ऊई जाओए, एप्रैमो रे लोके मूर्तिया री पूजा करी की आपू खे अशुद्ध करी ला दा ए।<verse eid="HOS 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HOS 6:11" />ओ यहूदा रे लोको, मां बी सई बखत आऊणे पाँदे तुसा खे सजा देणी। पर आऊँ आपणे लोका खे गुलामिया ते वापस ल्याऊणा चाऊँआ।<verse eid="HOS 6:11" /></para>
  <chapter eid="HOS 6" />
  <chapter number="7" style="c" sid="HOS 7" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 7:1" />आऊँ इस्राएलो साथे आपणा रिश्ता ठीक करना चाऊँआ। पर जेबे आऊँ एड़ा करने री कोशिश करूँआ, तो एप्रैमो रे पाप सबी रे सामणे आई जाओए। सामरिया रे पाप सबी खे लगी जाओए। लोक चूठ बोलोए। सेयो कअरा दे कूसी की चोरी करोए। सेयो बाटा रिये लोका खे लूटोए। <verse eid="HOS 7:1" /><verse number="2" style="v" sid="HOS 7:2" />तेबे बी सेयो नि सोचदे कि परमेशर म्हारी सारी बुराई याद राखोआ। इजी री खातर एबे सेयो आपणे कामो रे जाल़ो दे फसणे, कऊँकि तिना रे काम मेरी नजरा दे बणे दे ए। <verse eid="HOS 7:2" /><verse number="3" style="v" sid="HOS 7:3" />सेयो राजे खे बुराई करने ते ओर परदाना खे चूठ बोली की खुश करोए।<verse eid="HOS 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 7:4" />सेयो सारे के सारे व्याभिचारी ए, सेयो तेस तन्दूरो जेड़े ए जेतेखे पकाणे वाल़ा गर्म करोआ, पर जदुओ तक आटा बाटेया नि जांदा ओर सजेड़े साथे फूली नि जांदा, तदुओ तक से आगी खे नि धधकांदा। <verse eid="HOS 7:4" /><verse number="5" style="v" sid="HOS 7:5" />म्हारे राजे रे खास दिनो दे परदान शराब पी की मस्त ऊए, तिने मजाक करने वाल़ेया साथे आपणा आथ मलाया। <verse eid="HOS 7:5" /><verse number="6" style="v" sid="HOS 7:6" />जदुओ तक सेयो ताका दे रओए, तदुओ तक सेयो आपणा मन तन्दूरो जेड़ा त्यार करी की राखोए, तिना रा पकाणे वाल़ा पूरी रात सऊँदा रओआ, से प्यागा खे तन्दूरो री धधकदी आगी जेड़ा लाल ऊई जाओआ। <verse eid="HOS 7:6" /><verse number="7" style="v" sid="HOS 7:7" />सेयो सारे के सारे लोक तन्दूरो जेड़े धधकोए ओर आपणे न्यायिया खे स्वा करी देओए। तिना रे सारे राजे रूड़ी गे दे ओर तिना बीचा ते कोई बी माखे याद नि करदा।<verse eid="HOS 7:7" /></para>
  <para style="s">इस्राएल ओर दूजी जातिया</para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 7:8" />एप्रैम दूजी जातिया रे लोका साथे मिलेया-जुलेया दा रओआ, एप्रैम एक रोटिया जेड़ा ए जो सिर्फ एकी तरफा ते पक्की री ए। <verse eid="HOS 7:8" /><verse number="9" style="v" sid="HOS 7:9" />पराये देशो रे राजेया साथे मिली की इस्राएल एक कमजोर देश बणीगा दा ए, पर इस्राएलिया खे एतेरा एहसास नि ए। इस्राएल एक चीटे बाल़ा वाल़े स्याणे जेड़ा बणीगा दा ए, जेसरी तागत कम ऊई गी दी ए। पर इस्राएलो रे लोका खे एतेरा एहसास नि ए। <verse eid="HOS 7:9" /><verse number="10" style="v" sid="HOS 7:10" />इस्राएलो रे लोका रा कमण्ड तेसरे ई खलाफ गवाई देयोआ, इना सबी गल्ला रे रंदे ऊए बी सेयो आपणे परमेशर यहोवे रिया तरफा खे नि फिरे ओर ना से टोल़ेया। <verse eid="HOS 7:10" /><verse number="11" style="v" sid="HOS 7:11" />एप्रैम एक कबूतरिया जेड़ा ऊईगा रा, जेसरे कोई दमाक नि ए, से मिस्र देशो खे मतादा रिया तँईं बुलाओ तो अया, पर जाओआ अश्शूर देशो गे। <verse eid="HOS 7:11" /><verse number="12" style="v" sid="HOS 7:12" />जेबे सेयो आऊणे तेबे मां तिना पाँदे आपणा जाल़ सेटणा। सर्गो रे पंछिया जेड़े मां सेयो फसाई की थाले ल्याऊणे। मां तिना रे बुरे कामा रिया बजा ते तिना खे सजा देणी।<verse eid="HOS 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HOS 7:13" />तिना पाँदे हाय, कऊँकि सेयो मांगा गे ते पटकी गे! तिना रा सत्यानाश ओ, कऊँकि तिने मां साथे बगावत कित्ती! आऊँ तो तिना खे छुड़ांदा रया, पर सेयो मां साथे चूठ बोलदे आई रे। <verse eid="HOS 7:13" /><verse number="14" style="v" sid="HOS 7:14" />सेयो सच्चे मनो ते मेरी दुहाई नि देंदे, पर आपणे बछौणे पाँदे लेटे दे रोंदे रओए। सेयो कट्ठे ऊई की मांते नज्ज ओर नवें शराबो खे मांगदे रओए, पर सेयो मांते मूँ मोड़ी लओए। <verse eid="HOS 7:14" /><verse number="15" style="v" sid="HOS 7:15" />आऊँ तिना खे शिक्षा देंदा रया ओर तिना खे मजबूत करदा आई रा, तेबे बी सेयो मेरे खलाफ बुरी योजना बणाओए। <verse eid="HOS 7:15" /><verse number="16" style="v" sid="HOS 7:16" />सेयो मतादा रिया तँईं मेरिया तरफा खे नि देखदे। सेयो तोखा देणे वाल़े धनुषो जेड़े बेकार ए जो सई टंगो दे तीर नि चलाई सकदे। तिना रे परदान आपणियां तागती पाँदे कमण्ड करोए, पर सेयो लड़ाईया दे तलवारी की मरी जाणे। तेबे मिस्रो रे लोक तिना पाँदे आसणे।<verse eid="HOS 7:16" /></para>
  <chapter eid="HOS 7" />
  <chapter number="8" style="c" sid="HOS 8" />
  <para style="s">मूर्तिपूजा ते इस्राएलो रा नाश</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 8:1" />परमेशरे माखे बोलेया, “तुसे लड़ाईया खे रड़सिंगा बजाओ! मेरे लोका खे चतौणी दे! अश्शूर एक उकाब पंछिए जेड़ा ए। ये मेरी जमीना पाँदे अमला करने खे त्यार ए। मेरे लोके मां साथे कित्तेया रा वादा तोड़ी ता दा ए। तिने मेरे खलाफ ऊई की बिधानो खे मानणे खे ना करिती दी ए। <verse eid="HOS 8:1" /><verse number="2" style="v" sid="HOS 8:2" />तिना माखे आका पायी की बोलणा, ‘ओ म्हारे परमेशर, आसे इस्राएली लोक ताखे जाणूंए!’ <verse eid="HOS 8:2" /><verse number="3" style="v" sid="HOS 8:3" />पर इस्राएली लोक पलाईया ते डरी गे दे ए। इजी री खातर दुश्मणा तिना रा पीछा करना। <verse eid="HOS 8:3" /><verse number="4" style="v" sid="HOS 8:4" />सेयो राजेया खे ठरांदे रये, पर मेरी इच्छा ते नि। सेयो परदान बी ठरांदे रये, पर मेरे अणजाणे दे। तिने आपणा सूईना-चाँदी लई की मूर्तिया बणाईया जेते कि सेयो आपू ई नाश ऊई जाओ।”<verse eid="HOS 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HOS 8:5" />ओ सामरिया रे लोको, आपणे बाच्छूए री मूर्तिया खे सेटी देयो! आऊँ तुसा लोका ते बऊत गुस्से आ! तुसा कदुए तक निर्दोष ऊणे खे एड़े काम करदे रणा, जिना रिया बजा ते आऊँ तुसा ते कृणा करुँ। <verse eid="HOS 8:5" /><verse number="6" style="v" sid="HOS 8:6" />ये इस्राएलो ते ऊआ। एकी कारीगरे से बणाया, से परमेशर नि ए। इजी बजा ते सामरिया रे तेस बाच्छूए री मूर्तिया रे टुकड़े-टुकड़े ऊई जाणे। <verse eid="HOS 8:6" /><verse number="7" style="v" sid="HOS 8:7" />एकी किसानो जेड़े, इस्राएलो रे लोके अवा बाई ए। इजी री खातर तिना री खड़िया फसला तेज तूफान ऊणी! तिना रे डोरूआ दे जम्मणे वाल़िया उपजा दे कोई नज्ज नि ऊणा। इजी री खातर सेयो रोटिया रिया तँईं आटा नि बणाई सकणे। जे उपजा ते थोड़ा जा नज्ज ऊई बी जाओगा, तो परदेशी लोका से आपणियां तँईं लई जाणा। <verse eid="HOS 8:7" /><verse number="8" style="v" sid="HOS 8:8" />इस्राएली लोक निगल़ी ते, एबे सेयो दूजी जातिया बीचे एड़े नकम्मे ठईरी रे, जेड़ा तुच्छ पांडा ठईरोआ। <verse eid="HOS 8:8" /><verse number="9" style="v" sid="HOS 8:9" />कऊँकि सेयो अश्शूरो खे एड़े चली गे, जेड़ा बणो रा गह्दा चूण्डो ते बिछड़ी की रओआ, एप्रैमो रे लोके दूजे देशा ते मताद लणे रिया तँईं पैसे देई राखे। मानो कि सेयो आपणे प्यार करने वाल़ेया खे देणे लगी रे ओ। <verse eid="HOS 8:9" /><verse number="10" style="v" sid="HOS 8:10" />चाए सेयो दूजी जातिया बीचा ते मजदूर बणाई की राखो, तेबे बी मां सेयो कट्ठे करने ओर सेयो राजा ओर परदानो रे बोजो रिया बजा ते कम ऊणे लगणे।<verse eid="HOS 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HOS 8:11" />एप्रैमे पाप करने खे बऊत सारिया बेदिया बणाईया, सेयो बेदिया ई तेसरे पापी ऊणे री बजा बी ठईरिया। <verse eid="HOS 8:11" /><verse number="12" style="v" sid="HOS 8:12" />आऊँ तो तिना रिया तँईं आपणे बिधानो रिया लाखो गल्ला लिखदा आई रा, पर सेयो तिना खे पराया समजोए। <verse eid="HOS 8:12" /><verse number="13" style="v" sid="HOS 8:13" />इस्राएलो रे लोक बलिदान करना पसन्द करोए, पर मां यहोवे रिया तँईं तिना रे बलिदाना रा कोई मतलब नि ए। मां आपणे लोका खे तिना रे पापो रिया बजा ते सजा देणी। सेयो मिस्रो ते वापस आऊणे। <verse eid="HOS 8:13" /><verse number="14" style="v" sid="HOS 8:14" />कऊँकि इस्राएले आपू खे बनाणे वाल़ा पुलाई की मईल बणाई राखे ओर यहूदे बऊत सारे गढ़वाल़े शईर बसायी राखे, पर मां तिना रे शईरो दे आग लगाणी ओर तिजी ते तिना रे शईर फूकी की स्वा ऊई जाणे।<verse eid="HOS 8:14" /></para>
  <chapter eid="HOS 8" />
  <chapter number="9" style="c" sid="HOS 9" />
  <para style="s">यहोवे रा इस्राएलिया खे सजा देणा</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 9:1" />ओ इस्राएल, तूँ दूजे देशा रे लोका जेड़ा खुशिया नि मना! कऊँकि तूँ आपणे परमेशरो रे प्यारो खे छाडी की वेश्या जेड़ा बणेया। ईंयाँ तैं वेश्या रा जा काम कित्तेया। तैं नज्जो रे सबी खल्याणा दे वेश्या री कमाई खुशिया साथे लई। <verse eid="HOS 9:1" /><verse number="2" style="v" sid="HOS 9:2" />पर छोड़ ई ताखे खुल़ाणे खे खल्याणो दे कोई नज्ज या अंगूरा रा रस नि ऊणा। एथो तक कि कोई नवां शराब पनि ऊणा। <verse eid="HOS 9:2" /><verse number="3" style="v" sid="HOS 9:3" />इस्राएलो रे लोक यहोवे रे देशो दे नि रयी सकणे, पर एप्रैम मिस्रो दे वापस ऊई जाणा ओर तिना अश्शूरो दे सेयो अशुद्ध चीजा खाणिया पड़निया जो तिना खे नि खाणिया चाईयो थिया। <verse eid="HOS 9:3" /><verse number="4" style="v" sid="HOS 9:4" />तुसे इस्राएली लोक यहोवे खे शराबो रा अर्घ नि चढ़ाई सकणे, ना ई तेसखे बलिदान ल्याई सकणे। तुसा रे कोई बी दूजे बलिदान तेसखे खुश नि करी सकदे; सेयो तेसखे पसन्द नि ऊणे, जेड़े शोगो दे लोक जेस खाणे खे छूँओ ए, ओर जो कोई बी तेस खाणे खे खाओगा सेयो सब अशुद्ध ऊई जाणे। तिना खे खाणा आपू खे खाणे री इजाजत ऊणी, पर तिना खे ये मन्दरो दे ल्याऊणे री इजाजत नि ऊणी। <verse eid="HOS 9:4" /><verse number="5" style="v" sid="HOS 9:5" />ठराए रे त्योआरो रे दिन ओर परमेशरो रे खास दिना दे तुसा क्या करना?<verse eid="HOS 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 9:6" />देखो, तुसा बीचा ते कुछ लोक नाश ऊणे ते बची जाणे। पर तुसे मिस्रो दे मरी जाणे। तुसा रिया लाशा तिना मेम्फिस जगा दे दबाई देणियां। तुसा रे चाँदिए रिया अच्छी चीजा पाँदे चीं जमीं जाणी। तुसा रे तम्बूआ दे कांडेया कब्जा करी लणा। <verse eid="HOS 9:6" /><verse number="7" style="v" sid="HOS 9:7" />से दिन आऊणे वाल़ा ए जेबे परमेशरो तुसा खे सजा देणी। से दिन जेबे तेस तुसा रा न्याय करना, नेड़े आ। आऊँ चाऊँआ कि इस्राएलो खे पता चलो कि तुसे बऊत पाप करी राखे। ओर तुसे मांते बऊत नफरत करोए। इजी री खातर तुसे सोचोए कि भविष्यबक्ता मूर्ख ए। तुसे सोचोए कि जेस माणूंए रे जरीये यहोवा बोलोआ से पागल ए। <verse eid="HOS 9:7" /><verse number="8" style="v" sid="HOS 9:8" />परमेशरे आऊँ आपणे लोका एप्रैमो खे चतौणी देणे खे एक नबीए रे रूपो दे पेजी राखेया। फेर बी आऊँ जेती बी जाऊँआ, तेती तुसे माखे एकी एड़िए रे जाल़ो दे पंछिए जेड़े फसाणे री कोशिश करोए। एथो तक कि परमेशरो रे मन्दरो दे बी लोक नबीए रे दुश्मण ए। <verse eid="HOS 9:8" /><verse number="9" style="v" sid="HOS 9:9" />इस्राएली लोक बऊत ई बुराईया वाल़े काम करोए, जेड़े कि गिबा शईरो दे तिने जो खतरनाक पाप कित्ते थे। परमेशरो तिना रे जरीये कित्ते दे बुरे काम नि पुलणा। तेस पक्का तिना खे तिना रे पापा री सजा देणी। यहोवा आपणे लोका खे चतौणी देओआ।<verse eid="HOS 9:9" /></para>
  <para style="s">इस्राएलो रा पाप ओर तेसरा प्रतिफल</para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 9:10" />यहोवा बोलोआ, “जेबे मैं पईली बार इस्राएली लोका री मताद करने खे काम शुरू कित्तेया, तो माखे एड़ा लगेया जेड़े कि माखे रेगिस्तानो दे अंगूर मिली गे ओ। तुसा रे बुजुर्ग हर साल दाऊगल़ेया रे डाल़ो दे जम्मणे वाल़े पईले दाऊगल़े अंगूरा जेड़े थे। पर जेबे सेयो बालपोर पाह्ड़ो पाँदे आए, तो तिने तेसा बालो री मूर्तिया री पूजा कित्ती, ओर सेयो तेसा मूर्तिया जेड़े ई घृणित ऊईगे जेतेते सेयो प्यार करो थे। <verse eid="HOS 9:10" /><verse number="11" style="v" sid="HOS 9:11" />एप्रैमो रा वैभव पंछिये जेड़ा उडी जाणा, ना तो केसी रा जन्म ऊणा, ना केसी रे गर्भ रणा ओर ना कोई जवाणस गर्भवती ऊणी। <verse eid="HOS 9:11" /><verse number="12" style="v" sid="HOS 9:12" />चाए तुसा रे बच्चे बड़े बी ऊई जाओ तेबे बी मां सेयो तुसा ते छुड़ाई लणे। हाय! से दिन बऊत बुरा ऊणा जेबे मां तुसा लोका खे कल्ले छाडी की चली जाणा।” <verse eid="HOS 9:12" /><verse number="13" style="v" sid="HOS 9:13" />मैं एप्रैम बांका ओर भरा पूरा देखेया, जो सोर शईरो जेड़ा ए, पर एबे इस्राएलो रे लोका खे आपणे बच्चेया खे दुश्मणा रे जरीये मरवाणे रिया तँईं लई जाणे खे मजबूर ऊणा पड़ना।<verse eid="HOS 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HOS 9:14" />ओ यहोवा, आऊँ तेरी प्रजा खे क्या मांगू? मां एड़ी कोख मांगणी जो बच्चेया खे पैदा नि करो ओर एड़ी छाती मांगणी जो दूद नि देयो। <verse eid="HOS 9:14" /><verse number="15" style="v" sid="HOS 9:15" />तिना री सारी बुराई गिलगालो दे ए, मैं तिना साथे तेथी नफरत कित्ती। तिना रे बुरे कामो रिया बजा ते मां सेयो आपणे कअरो ते निकयाल़ी देणे ओर तिना साथे फेर प्यार नि राखणा, कऊँकि तिना रे सारे परदान बगावत करने वाल़े ए। <verse eid="HOS 9:15" /><verse number="16" style="v" sid="HOS 9:16" />एप्रैम एकी बेकार बेली जेड़ा ए। इजी रिया जड़ी सूकी गिया रिया ए। मानी लो कि एप्रैमो रे लोका रे बच्चे ए। तो मां सेयो काई देणे तिना ते सेयो प्यार करोए। <verse eid="HOS 9:16" /><verse number="17" style="v" sid="HOS 9:17" />कऊँकि तिने तेसरी गल्ल नि सुणी, इजी री खातर मेरे परमेशरो सेयो छाडी देणे; सेयो दूजी जातिया बीचे पटकदे रणे।<verse eid="HOS 9:17" /></para>
  <chapter eid="HOS 9" />
  <chapter number="10" style="c" sid="HOS 10" />
  <para style="s">इस्राएलो रा पाप ओर तिना री गुलामी</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 10:1" />इस्राएल एक अंगूरा री खरिया बेला जेड़ा था जिदे बऊत सारे अंगूर थे। पर जिंयाँ ई इस्राएली लोक बऊत जादा अमीर ऊँदे गये तिने जादा ते जादा बेदिया बणाईया। जिंयाँ-जिंयाँ तिना री जमीने जादा उपज दित्ती, तिने तिना खम्बेया री पूजा कित्ती, सेयो ओर बांके बणाए। <verse eid="HOS 10:1" /><verse number="2" style="v" sid="HOS 10:2" />तिना रा दिल बेईमान ए। इजी री खातर तिना आपणे पापा री सजा पुगतणी पड़नी। तेस तिना रिया बेदिया तोड़ी देणियां। तेस तिना रे पवित्र पात्थर नाश करी देणे। <verse eid="HOS 10:2" /><verse number="3" style="v" sid="HOS 10:3" />एबे इस्राएलो रे लोक बोलेया करोए, “आसा रा कोई राजा नि ए कऊँकि आसे यहोवे रा डर नि मानदे। पर एक राजा म्हारा कुछ नि बिगाड़ी सकदा।”<verse eid="HOS 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 10:4" />सेयो गल्ला बणाओए ओर चूठी कसम खाई की वाचा बानोए, इजी री खातर अन्याय तिना बीचे किसानो रे डोरूए दे जईरो वाल़े काओ जेड़ा जम्मोआ। <verse eid="HOS 10:4" /><verse number="5" style="v" sid="HOS 10:5" />सामरिया रे रणे वाल़े बेतावेनो रे बाच्छूए री मूर्तिया रिया तँईं परेशान ए; बाच्छूए री पूजा करने वाल़े तेसरिया तँईं दु:ख मनाणे लगी रे। पुजारी मूर्तिया री महिमा रिया तँईं रोणे लगी रे; कऊँकि से तेथा ते बारे करी ती दी ए। <verse eid="HOS 10:5" /><verse number="6" style="v" sid="HOS 10:6" />से यारेब राजे री पेंट ठईरने खे अश्शूर देशो रे पऊँचाया जाणा। एप्रैम शर्मिंदा ऊणा ओर इस्राएल बी आपणी योजना ते शर्माणा। <verse eid="HOS 10:6" /><verse number="7" style="v" sid="HOS 10:7" />सामरिया शईर ओर तेसरा राजा नाश ऊई जाणे; सेयो समुद्रो रे पाणिए पाँदे तैरदे ऊए लकड़िया रे केसी टुकड़े जेड़े बह्ई जाणे। <verse eid="HOS 10:7" /><verse number="8" style="v" sid="HOS 10:8" />आवेनो रे पाह्ड़ो रे मन्दर, जेती इस्राएली लोक मूर्तिया री पूजा करी की पाप करोए, नाश करी देणे। तिना री बेदिया पाँदे झड़बेरिया रे डाल़ ओर कांडे-चीट जमणे ओर तेस बखते लोका पाह्ड़ो ते बोलणा, “आसा खे लकोई देयो ओर टिलेया खे कि आसा पाँदे टल़ी जाओ।”<verse eid="HOS 10:8" /></para>
  <para style="s">परमेशरो रा इस्राएलिया खे सजा रा वादा</para>
  <para style="p">
    <verse number="9" style="v" sid="HOS 10:9" />ओ इस्राएलो रे लोको, यहोवा ईंयाँ बोलोआ, “जदुए ते तुसा रे लोके बऊत पईले गिबा दे पाप कित्तेया ए, तदुए ते तुसे बुरे काम करदे आई रे। ओर तुसे एबु बी सेई करने लगी रे जो बुरा ए। गिबा रे सेयो दुष्ट लोक सच्चो खे ई लड़ाईया दे फसी जाणे। <verse eid="HOS 10:9" /><verse number="10" style="v" sid="HOS 10:10" />जेबे मेरी इच्छा ऊणी, तेबे मां तिना खे सजा देणी ओर दूजे देशा रे लोक तिना रे खलाफ कट्ठे ऊई जाणे, कऊँकि सेयो आपणे दुँईं बुरे कामो रे फसे दे ए।” <verse eid="HOS 10:10" /><verse number="11" style="v" sid="HOS 10:11" />एप्रैम एकी बाच्छिया जेड़ा था जेसा खे मैं नज्जो पाँदे चलणा सिखाया था। से मेरिया तँईं काम करना पसन्द करो थी। पर एबे मां तेसा ते कठण काम करवाणे! मां तेसा रिया क्याड़िया पाँदे एक पारी जूँगड़ा राखणा। यहूदा खे बी जमीना दे अल़ चलाणा पड़ना। याकूबो रे वंशो खे सख्त जमीन खणने रिया तँईं काम करना पड़ना। <verse eid="HOS 10:11" /><verse number="12" style="v" sid="HOS 10:12" />आपू खे तर्मो रे बिऊ बाओ, तेबे करूणा रे मुताबिक फसल बाडी सकणे; आपणी जमीना खे बाओ, देखो, एबु यहोवे पीछे ऊणे रा बखत ए, ताकि से आओ ओर तुसा रा उद्धार करो।<verse eid="HOS 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HOS 10:13" />पर तुसे गल़त काम करने रे बीज बाई राखे। इजी री खातर तुसा आपणे बुरे व्यवहारो रा फल बाडणा ए। तुसा खे आपणे चूठो रा फल खाणा पड़ना। तुसे आपणियां तागती पाँदे परोसा करी राखेया ए। तुसे आपणे कईया सिपाईया पाँदे परोसा करी राखेया ए। <verse eid="HOS 10:13" /><verse number="14" style="v" sid="HOS 10:14" />इजी बजा ते तुसा रे लोका बीचे लड़ाई ऊणी ओर तुसा रे सारे गढ़वाल़े शईर एड़े नाश करे जाणे जेड़ा बेतर्बेल शईर लड़ाईया रे बखते शल्मनो रे जरीये नाश ऊआ था, तेस बखते माया आपणे बच्चेया समेत जमीना पाँदे पटकी ती थिया। <verse eid="HOS 10:14" /><verse number="15" style="v" sid="HOS 10:15" />तुसा री बऊत बुराईया रिया बजा ते बेतेल शईरो ते बी एड़ा ई बर्ताओ करेया जाणा। प्याग ऊँदे ई इस्राएलो रा राजा पूरी तरअ ते मिटी जाणा।<verse eid="HOS 10:15" /></para>
  <chapter eid="HOS 10" />
  <chapter number="11" style="c" sid="HOS 11" />
  <para style="s">इस्राएलो रिया तँईं परमेशरो रा प्यार</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 11:1" />यहोवा बोलोआ, “इस्राएली लोका रे एक देश बणने ते पईले मैं तिना ते तिंयाँ ई प्यार कित्तेया था जेड़े एक माणूं आपणे माठे ते करोआ, ओर मैं सेयो मिस्रो ते बारे बुलाए थे। <verse eid="HOS 11:1" /><verse number="2" style="v" sid="HOS 11:2" />पर इस्राएली लोक मैं जितणे ज्यादा बुलाए सेयो मांते तिथणे ई दूर ऊए थे, इस्राएलो रे लोक बाल देवतेया खे बलिदान करो थे ओर कअड़ी री मूर्तिया खे तूप बाल़ो थे। <verse eid="HOS 11:2" /><verse number="3" style="v" sid="HOS 11:3" />एप्रैमो खे मैं ई चलणा सिखाया था इस्राएलो खे आऊँ गोदा रे लई की फिरूँ था, पर सेयो नि जाणो थे कि तिना रा त्यान राखणे वाल़ा आऊँ ई ए।” <verse eid="HOS 11:3" /><verse number="4" style="v" sid="HOS 11:4" />आऊँ तिना खे माणूं समजी की प्यारो री डोरिया साथे खींजू था। ओर जेड़ा कोई किसान आपणे बल़दो रे गल़ो रा जूँगड़ा खोली की तेस सामणे काआ राखी देयोआ, तेड़ा ई मैं तिना साथे कित्तेया। <verse eid="HOS 11:4" /><verse number="5" style="v" sid="HOS 11:5" />सेयो मिस्र देशो खे वापस नि जाणे, पर अश्शूर तिना रा राजा ऊणा, कऊँकि तिने मेरी तरफा खे आऊणे खे ना करी ती री।<verse eid="HOS 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 11:6" />तिना रे शईरो दे तलवार चलणी, तिना रे दुश्मणा तिना रे द्वार तोड़ी की पीतरे कूसी जाणे। सेयो तिना नाश करी देणे, सेयो आपणी ई बुरी योजना दे फसी जाणे। <verse eid="HOS 11:6" /><verse number="7" style="v" sid="HOS 11:7" />मेरी प्रजा मांते दूर ऊणे खे लगी दी रओई, सेयो बोलोए कि आऊँ महान सर्वशक्तिमान परमेशर ए, पर सेयो मेरा बिलकुल बी आदर नि करदे।<verse eid="HOS 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 11:8" />ओ एप्रैम, आऊँ ताखे कऊँ छाडूं? ओ इस्राएल, आऊँ ताखे दुश्मणा रे आथो दे किंयाँ करी देऊँ? आऊँ ताखे अदमो जेड़ा कऊँ छाडूं ओर सबोयीमो जेड़ा करुँ? मेरे दिलो माखे एड़ा नि करने देणा! तुसा रिया तँईं मेरा प्यार बऊत मजबूत ए। <verse eid="HOS 11:8" /><verse number="9" style="v" sid="HOS 11:9" />मां आपणा रोष पड़कणे नि देणा ओर ना मां एप्रैम फेर नाश करना, कऊँकि आऊँ माणूं नि परमेशर ए, आऊँ तां बीचे रणे वाल़ा पवित्र ए, मां गुस्सा करी कि नि आऊणा। <verse eid="HOS 11:9" /><verse number="10" style="v" sid="HOS 11:10" />कऊँकि एक दिन सेयो लोक मेरे पीछे-पीछे आऊणे। मां यहोवे शेरो रे जेड़े गरजणा। ओर जेबे मां गरजणा, तो मेरे लोक पच्छमा रिया दिशा ते थरथरांदे ऊए वापस आऊणे। <verse eid="HOS 11:10" /><verse number="11" style="v" sid="HOS 11:11" />सेयो मिस्रो ते पंछिया रे चूण्डो जेड़े आऊणे। सेयो कबूतरा जेड़े छोड़ अश्शूर देशो ते आऊणे। ओर मां सेयो वापस कअरे लई आऊणे, यहोवे री येई बाणी ए। <verse eid="HOS 11:11" /><verse number="12" style="v" sid="HOS 11:12" />एप्रैमो रे लोक मांते चूठो ते अलावा कुछ नि बोलदे। इस्राएल माखे तोखा देओआ। ओर यहूदा परमेशरो ते दूर पटकदा रओआ। तिने विश्वासो जोगा पवित्र परमेशर छाडीता दा ए।<verse eid="HOS 11:12" /></para>
  <chapter eid="HOS 11" />
  <chapter number="12" style="c" sid="HOS 12" />
  <para style="s">यहोवा इस्राएलो रे खलाफ ए</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 12:1" />एप्रैम आपणा बखत बर्बाद करदा रओआ। इस्राएलो रे लोक सारा दिन, “अवा रे पीछे नठदे रओए।” लोक जादा ते जादा चूठ बोलदे रओए, सेयो जादा ते जादा चोरिया करदे रओए। अश्शूरो साथे तिने वाचा बानी राखी ए, ओर सेयो आपणे जैतूनो रे तेलो खे मिस्रो खे लई जाणे लगी रे। <verse eid="HOS 12:1" /><verse number="2" style="v" sid="HOS 12:2" />यहूदा साथे बी यहोवे रा मुकद्दमा ए ओर तेस याकूबो खे तेसरे चाल-चलणो रे मुताबिक सजा देणी, तेसरे कामो रे मुताबिक तेस तेसखे बदला देणा। <verse eid="HOS 12:2" /><verse number="3" style="v" sid="HOS 12:3" />एबु याकूब आपणी माया रे पेटो देई था कि तिने आपणे पाईए खे लाते बायी, याकूब एक शक्तिशाली जवान था ओर तेस बखते से परमेशरो साथे लड़ेया। <verse eid="HOS 12:3" /><verse number="4" style="v" sid="HOS 12:4" />याकूब परमेशरो रे स्वर्गदूतो साथे लड़ेया ओर जीती बी गया, से रोया ओर तिने गिड़गिड़ाई की प्रार्थना कित्ती। तेसखे परमेशर बेतेलो दे मिलेया ओर तेती परमेशरे तेस साथे गल्ला कित्तिया।<verse eid="HOS 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HOS 12:5" />यहोवा, सेना रा परमेशर, जेसरी याद यहोवे रे नाओं ते ओई। <verse eid="HOS 12:5" /><verse number="6" style="v" sid="HOS 12:6" />इजी री खातर तूँ आपणे परमेशरो रिया तरफा खे फिर, कृपा ओर न्याय रे काम करदा रओ ओर आपणे परमेशरो पाँदे ई परोसा राख। <verse eid="HOS 12:6" /><verse number="7" style="v" sid="HOS 12:7" />से बपारी ए ओर तेसरे आथो दे छलो री ताकड़ी ए, तिना खे तोखा देणा पसन्द ए। <verse eid="HOS 12:7" /><verse number="8" style="v" sid="HOS 12:8" />एप्रैमे बोलेया, “आसे बऊत अमीर ऊईगे रे, आसा गे बऊत सारी सम्पत्ति ऊई गी री, किने बी आऊँ तोखा देंदे ऊए नि पकड़ेया! मेरे जीवनो दे कोई दोष नि ए।” <verse eid="HOS 12:8" /><verse number="9" style="v" sid="HOS 12:9" />पर आऊँ तुसा रा परमेशर यहोवा ए, जिने तुसे मिस्र देशो री गुलामिया ते छुड़ाई की ल्याए ए। ओर मां फेर तूँ तम्बूए दे बसाणा, जेड़ा कि तुसे हर साल चूँगड़िया रे त्योआर मनांदे रओए। <verse eid="HOS 12:9" /><verse number="10" style="v" sid="HOS 12:10" />मैं भविष्यबक्तेया रे जरीये गल्ला कित्तिया ओर बार-बार दर्शण देंदा रया ओर भविष्यबक्तेया रे जरीये चतौणी देंदा आई रा।<verse eid="HOS 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HOS 12:11" />गिलाद शईरो रे लोक मूर्तिया री पूजा करोए ओर सेयो लोक पापी ए। गिलगाल शईरो दे लोक बल़दा री बलि चढ़ाओए, पर तिना रिया बेदिया छोड़ ई बाए दे डोरूए रे कनारे पात्थरा रे टेरो जेड़े ऊई जाणिया। <verse eid="HOS 12:11" /><verse number="12" style="v" sid="HOS 12:12" />याकूब अरामो रे मैदानो दे नठीगा था, से तेती ग्वाल़े रे रूपो दे सेवा रा काम करो था ताकि तेसखे एक लाड़ी मिली सको। <verse eid="HOS 12:12" /><verse number="13" style="v" sid="HOS 12:13" />एक भविष्यबक्ते रे जरीये यहोवा इस्राएलो खे मिस्रो री गुलामिया ते निकयाल़ी की ल्याया ओर भविष्यबक्तेया रे जरीये ई तेसरी रक्षा ऊई। <verse eid="HOS 12:13" /><verse number="14" style="v" sid="HOS 12:14" />पर एप्रैमो रे लोके परमेशरो खे बऊत रोष चढ़ाया। एप्रैमे बऊत जे लोक कायी राखे। इजी री खातर तेसरे पापो रिया तँईं तेसखे सजा मिलणी। तेसरे यहोवे तेसखे तेसरी ई बेज्जती सईन करवाणी।<verse eid="HOS 12:14" /></para>
  <chapter eid="HOS 12" />
  <chapter number="13" style="c" sid="HOS 13" />
  <para style="s">इस्राएलो रे खलाफ यहोवे रा गुस्सा</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 13:1" />जेबे एप्रैम बोलो था, तेबे लोक थरथराओ थे, ओर तेसरा इस्राएलो दे बड़ा आदर था; पर जेबे से बाल देवते रिया बजा ते दोषी ऊईगा, तेबे से मरी गा। <verse eid="HOS 13:1" /><verse number="2" style="v" sid="HOS 13:2" />एबे सेयो लोक ओर बी जादा पाप करदे रओए। सेयो आपणे चाँदिए रा इस्तेमाल आपणियां तँईं देवतेया री मूर्तिया बनाणे दे करोए। बाच्छूए री मूर्तिया तिना रे आपणे अन्दरले सोच-बचारा ते आओईया। अच्छे कारीगर तिना सबी खे बणाओए। लोक इना देवतेया री पूजा करोए। सेयो तिना खे आदमिया री बलि चढ़ाओए। सेयो बाच्छूआ जेड़े दिशणे वाल़े देवतेया खे चूम्मोए। <verse eid="HOS 13:2" /><verse number="3" style="v" sid="HOS 13:3" />इजी री खातर सेयो तड़के रे कोरे या छोड़ ई उडी जाणे वाल़ी तेल़ा रे जेड़े ऊणे, खल्याणो ते उडणे वाल़े पूए जेड़े ऊणे या तन्दूरो ते निकल़ने वाल़े तुएँ जेड़े ऊणे।<verse eid="HOS 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 13:4" />तेबे यहोवे बोलेया, “मिस्र देशो ते ई आऊँ यहोवा, तेरा परमेशर ए, तैं माखे छाडी की कोई ओर परमेशर नि मानणा, कऊँकि मांते सिवा कोई तेरा उद्धारकर्ता नि ए। <verse eid="HOS 13:4" /><verse number="5" style="v" sid="HOS 13:5" />मैं उजाड़ जगा दे तुसा री देखपाल़ कित्ती, ओर तेती बी जेती बऊत गर्मी ओर सूका था। <verse eid="HOS 13:5" /><verse number="6" style="v" sid="HOS 13:6" />मैं इस्राएलिया खे खाणे खे दित्तेया। तिने से रोटी खाई ओर सेयो रज्जी गे, तेबे रज्जणे ते बाद तिना रा मन कमण्डो साथे परी गा, इजी बजा ते सेयो माखे पूली गे। <verse eid="HOS 13:6" /><verse number="7" style="v" sid="HOS 13:7" />इजी री खातर आऊँ तिना खे शेरो जेड़ा बणी रा, मां चीते जेड़ा तिना री बाटा दे ताका दे बैठे दे रणा। <verse eid="HOS 13:7" /><verse number="8" style="v" sid="HOS 13:8" />मां तिना पाँदे एड़े पालूए जेड़े अमला करना जेड़े कोई केसी पालूए रे बच्चेया खे छुड़ाई की लई गया ओ। मां सेयो फाड़ी देणे। मां शेरो जेड़े सेयो खाई देणे, मां बणो रे जानवरा जेड़े सेयो फाड़ी देणे। <verse eid="HOS 13:8" /><verse number="9" style="v" sid="HOS 13:9" />ओ इस्राएल, तेरे नाश ऊणे री बजा ये ए कि तूँ मेरा, मतलब आपणे मताद करने वाल़े रा बिरोदी ए।” <verse eid="HOS 13:9" /><verse number="10" style="v" sid="HOS 13:10" />एबे तेरा राजा केई रया कि तेरे सबी शईरो दे से ताखे बचाओ? ओर तेरे न्यायी केयी रये, जिना रे बारे दे तैं बोलेया था, “मेरिया तँईं राजा ओर परदान ठराई दे।” <verse eid="HOS 13:10" /><verse number="11" style="v" sid="HOS 13:11" />मैं रोषो दे आई की ताखे राजे बणाए ओर तेबे रोषो दे आई की सेयो टायी बी दित्ते। <verse eid="HOS 13:11" /><verse number="12" style="v" sid="HOS 13:12" />एप्रैमे आपणे पाप लकोणे री कोशिश कित्ती; तिने सोचेया था कि तेसरे पाप छिपे दे ए। पर तिना गल्ला रिया तँईं तेसखे सजा दित्ती जाणी।<verse eid="HOS 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HOS 13:13" />लोका खे बच्चा जम्मणे री जिया पीड़ा जेड़े पीड़ ऊई री, पर सेयो तेस बच्चे जेड़े ए जो जन्म लणे खे ना करोए। जम्मणे रा बखत आईगा रा ए, पर से पेटो देई रओआ। <verse eid="HOS 13:13" /><verse number="14" style="v" sid="HOS 13:14" />मां तुसे काये जाणे ते नि बचाणे ओर ना ई तेसा जगा दे जाणे ते बचाणे जेती मरे दे लोक ए। मां तुसे विपत्तिया ते दु:खी करने ओर तुसे कुल़ाई देणे ओर कब्रा दे दबाई देणे। मां तुसा पाँदे दया नि करनी। <verse eid="HOS 13:14" /><verse number="15" style="v" sid="HOS 13:15" />दूजे देशा बीचे इस्राएल सफल रया ए। ये एक एड़े छोटिया डाल़िया जेड़ा ए जो अच्छी तरआ ते बढ़ोईया। पर एबे यहोवे मुसीबत पेजणी। ये एक मजबूत पूर्वा री अवा जेड़ा ऊणा जो रेगिस्तानो ते आओई। इस्राएलो रे कुँएं ओर पाणिए रे चरने सूकी जाणे। इस्राएले जो बी किमती चीजा जमा करी राखिया, सेयो राची जाणिया। <verse eid="HOS 13:15" /><verse number="16" style="v" sid="HOS 13:16" />सामरिया रे लोका खे आपणे पापो री सजा पुगतणी पड़नी कऊँकि तिने आपणे परमेशरो रे खलाफ बिद्रोह कित्तेया था। सेयो दुश्मणा री सेना रे जरीये काये जाणे, तिना रे छोटे बच्चे जमीना पाँदे पटकी की काये जाणे ओर तिना री गर्भवती जवाणसा तलवारे की चीरी देणियां।<verse eid="HOS 13:16" /></para>
  <chapter eid="HOS 13" />
  <chapter number="14" style="c" sid="HOS 14" />
  <para style="s">पश्चाताप ओर प्रतिज्ञा रा सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 14:1" />ओ इस्राएलो रे लोको, आपणे परमेशर यहोवे गे वापस आई जाओ, कऊँकि तुसे आपणे पापो रिया बजा ते ठोकर खाई राखी। <verse eid="HOS 14:1" /><verse number="2" style="v" sid="HOS 14:2" />तो एबे गल्ला सीखी की ओर यहोवे रिया तरफा खे फिरी की, तेसखे बोल, “सारे पाप माफ कर, दया करी की आसा खे मानी लो, तेबे आसा बलिया खे बल़द नि पर तन्यवादो री बलि चढ़ाणी।”<note caller="+" style="f"><char style="fr" closed="false">14:2 </char><char style="ft" closed="false">इब्रा. 13:15 </char></note> <verse eid="HOS 14:2" /><verse number="3" style="v" sid="HOS 14:3" />अश्शूर आसा खे नि बचाई सकदा, ना ई आसा रे लड़ाईया रे कोड़े। आसा फेर आपणी बणाई री मूर्तिया ते कदी नि बोलणा, “तुसे म्हारे देवता ए” ना, सिर्फ तुसा देई अनाथा खे दया मिलोई। <verse eid="HOS 14:3" /><verse number="4" style="v" sid="HOS 14:4" />यहोवा बोलोआ, “मां तिना रे पटकणे री आदत दूर करनी, मां तिना साथे प्यार करना, कऊँकि मेरा रोष तिना पाँदा ते उतरी गा रा।”<verse eid="HOS 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HOS 14:5" />आऊँ इस्राएलो खे पाल़े जेड़ा बणना, जो बणो रे डाल़ा डाल़िया खे जीवन देयोई। से सोसणो रे फूलो जेड़ा फलणा-फूलणा। लबानोनो रे देवदारो रे डाल़ा जेड़े तेस मजबूत ऊई जाणा। <verse eid="HOS 14:5" /><verse number="6" style="v" sid="HOS 14:6" />इस्राएल जातिया री पाँगटिया दूरो-दूरो तक फैली जाणिया, से जैतूनो रे डाल़ो जेड़ा बांका बणना, लबानोनो जेड़ी तेसरी खुशबू फैलणी। <verse eid="HOS 14:6" /><verse number="7" style="v" sid="HOS 14:7" />मां आपणे लोका खे बचाणे रिया तँईं छांए देणी। तिना एड़िया फसला लगाणियां जिना तिना खे खूब नज्ज देणा। सेयो सफल ऊणे, जेड़े कोई बेल जो बऊत सारे अंगूर देयोई। सेयो लबानोनो रे शराबो जेड़े प्रसिद्ध ऊणे। <verse eid="HOS 14:7" /><verse number="8" style="v" sid="HOS 14:8" />तेबे एप्रैमो रे लोका बोलणा, “एबे मूर्तिया साथे मेरा ओर क्या काम ए?” मां ई तेरिया प्रार्थना रा ज्वाब ताखे देणा ए, आऊँ ई तेरी देखपाल़ करूँआ। आऊँ सदाबार केली रे डाल़ो जेड़ा ए; ताखे मांते ई फल मिलणा।<verse eid="HOS 14:8" /></para>
  <para style="s">अन्तिम सला</para>
  <para style="p">
    <verse number="9" style="v" sid="HOS 14:9" />जो अक्लमंद ओ, तेस ई यो गल्ला समजणियां, ये गल्ला केसी चलाक आदमिए खे जाणनी चाईए। कऊँकि यहोवे री बाटा सीदिया ए ओर तर्मी तिना पाँदे चलदे रणे, पर पापी तिना पाँदे ठोकर खाई की रूड़ने।<verse eid="HOS 14:9" /></para>
  <chapter eid="HOS 14" />
</usx>