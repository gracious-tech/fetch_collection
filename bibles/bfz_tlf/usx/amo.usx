<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id" />
  <para style="h">आमोस</para>
  <para style="toc1">आमोस नबीए रे जरिये लिखी री कताब</para>
  <para style="toc2">आमोस</para>
  <para style="toc3">आमो.</para>
  <para style="mt">आमोस</para>
  <para style="mt2">आमोस नबीए रे जरिये लिखी री कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">आमोस नबी बाईबला रा एड़ा पईला भविष्यवक्ता था जेसरा सन्देश बड़ाई की लिखी राखेया था। हालाँकि से यहूदा रे एकी शईरो रा रणे वाल़ा था, तेबे बी तिने इस्राएलो रे उत्तरा रे इस्से रे लोका दे प्रचारो रा काम कित्तेया। तेसरा बखत लगभग ई. पू. 800 रे बीचला था। ये बखत बड़ा अच्छा, खास करी की तर्मो वाल़ा, ओर बारा ते सुरक्षा रा था। पर आमोसे ये देखेया की अच्छा सिर्फ तनवान लोका रा ई ए, ओर इजी रा बढ़ना सिर्फ अन्याय ओर गरीबा पाँदे अत्याचारो ते ई ओ था। तर्मो रे रीति-रवाज सिर्फ दखावे रे ई रईगे थे। बड़ा सोची-बिचारी की तिने ये प्रचार कित्तेया कि परमेशरो इस्राएली लोका खे सजा देणी। तिने एते गल्ला रा प्रचार कित्तेया कि न्याय खे “सूबल़ा खे बह्ईणे देयो” ओर बोलेया, “क्या पता सेना रा परमेशर यहोवा यूसुफो रे बचे दे लोका पाँदे दया करो” 5:15।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">इस्राएलो रे पड़ोसी देशा रा न्याय <char style="ior"><ref loc="AMO 1:1-2:5">1:1-2:5</ref></char></para>
  <para style="io1">इस्राएलो रा न्याय <char style="ior"><ref loc="AMO 2:6-6:14">2:6-6:14</ref></char></para>
  <para style="io1">पाँज दर्शण <char style="ior"><ref loc="AMO 7:1-9:15">7:1-9:15</ref></char></para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="s">परमेशरो रा इस्राएलो रे नेड़े-तेड़े रे देशा खे सजा देणा</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />आमोस तकोआ शईरो रा एक ग्वाल़ा था। एती से दर्शण ए जो तिने इस्राएलो रे बारे दे देखेया था। ये दर्शण तेसखे भूकम्पो ते दो साल पईले मिलेया था। तेस बखते यहूदा रा राजा उज्जियाह था। योआशो रा पाऊ यारोबाम इस्राएलो रा राजा था। यो आमोसे रे शब्द ए; <verse eid="AMO 1:1" /><verse number="2" style="v" sid="AMO 1:2" />तिने बोलोआ, “परमेशर सिय्योनो ते शेरो जेड़े गरजोआ। तेसरी आवाज यरूशलेमो ते गरजणे जेड़ी आओई। ग्वाल़ेया री चराईया सूकी जाओईया। कर्मेल पाह्ड़ो री चूँडी सूकी जाओई।”<verse eid="AMO 1:2" /></para>
  <para style="s">यहोवा सामरिया खे सजा देओआ</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />यहोवा बोलोआ, “दमिश्को रे लोके बार-बार पाप करी राखे, इजी बजा ते मां तिना खे सजा देणी। कऊँकि तिना गिलाद लोए रे अल़े की केसणा। <verse eid="AMO 1:3" /><verse number="4" style="v" sid="AMO 1:4" />इजी री खातर मां राजा हजाएलो रे मईलो खे नाश करने खे आग पेजणी। एसा आगी तेसरे पाऊ बेन्हददो रा कीला फूकी देणा। <verse eid="AMO 1:4" /><verse number="5" style="v" sid="AMO 1:5" />मां दमिश्को रे फाटक बी तोड़ी देणे ओर ओवन नाओं री काअटिया दे रणे वाल़े ओर बेतादेनो रे कअरे रणे वाल़े राजदण्डधारी नाश करने ओर अरामो रे लोक बन्दी ऊई की कीर शईरो खे जाणे, परमेशरो रा येई वचन ए।” <verse eid="AMO 1:5" /><verse number="6" style="v" sid="AMO 1:6" />परमेशर ईंयाँ बी बोलोआ, “गाजा शईरो रे लोके बार-बार पाप करी राखेया ए। ओर मां सेयो बिना सजा दित्ते नि छाडणे! तिने सारे गाँवो खाली कराईते दे ए, ओर सेयो एदोमो रे लोका खे गुलाम बणाई की बेचीते दे ए। <verse eid="AMO 1:6" /><verse number="7" style="v" sid="AMO 1:7" />इजी बजा ते मां गाजा री दवाला दे आग लगाणी ओर तिजी ते तेथो रे मईल फूखी जाणे। <verse eid="AMO 1:7" /><verse number="8" style="v" sid="AMO 1:8" />मां अशदोद रे रणे वाल़े ओर अश्कलोन रे राजदण्डाधिकारी बी नाश करने, मां एक्रोनो खे सजा देणी ओर बाकी सब पलिश्ती लोक मरी जाणे” परमेशर यहोवे रा येई वचन ए।<verse eid="AMO 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />परमेशर ईंयाँ बी बोलोआ, “सोरो रे लोके बार-बार पाप करी राखेया ए। इजी री खातर मां तिना रा न्याय करना। तिने सबी जातिया पाँदे कब्जा करी ला दा ए। तिने सेयो एदोमो खे बेचीते दे। तिने आपणा वादा याद नि कित्तेया। <verse eid="AMO 1:9" /><verse number="10" style="v" sid="AMO 1:10" />इजी बजा ते मां सोरो री दवाला दे आग लगाणी ओर तिजी ते तेथो रे मईल फूखी जाणे।”<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">मत्ती 11:21-22, लूक. 10:13-14 </char></note><verse eid="AMO 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />परमेशर फेर बोलोआ, “एदोमो रे लोके बार-बार पाप करी राखेया। इजी री खातर मां तिना रा न्याय करना। तिने तलवारा लई की इस्राएलो रा पीछा कित्तेया जो तिना खे काणे खे त्यार थिया। तिने देशो री जवाणसा काई तिया। सेयो हर बखत गुस्से दे रओ थे। तिना रा गुस्सा एक एड़िया आगी जेड़ा था जो पड़की जाओ थी। एतेखे रोकी नि सको थे। <verse eid="AMO 1:11" /><verse number="12" style="v" sid="AMO 1:12" />इजी बजा ते मां तेमान शईरो री दवाला दे आग लगाणी ओर तिजी ते बोस्रा रे मईल फूखी जाणे।”<verse eid="AMO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />परमेशर फेर बोलोआ, “अम्मोनो रे लोके बार-बार पाप करी राखेया ए। इजी री खातर मां तिना रा न्याय करना। तिने गिलादो दे गर्भवती जवाणसा चीरी तिया। सेयो तेसा जगा खे आपणे इस्से दे जोड़ना चाओ थे। <verse eid="AMO 1:13" /><verse number="14" style="v" sid="AMO 1:14" />इजी बजा ते मां रब्बा री दवाल रे आग लगाणी ओर तिजी ते तेथो रे मईल फूखी जाणे। लड़ाईया रे तेस दिने लड़ाईया री आवाज सुणनी। से दिन तेज पऊण-चूखाने वाल़ा ऊणा। <verse eid="AMO 1:14" /><verse number="15" style="v" sid="AMO 1:15" />ओर तिना रा राजा आपणे परदाना समेत गुलामिया दे जाणा, परमेशरो रा येई वचन ए।”<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="s">मोआबो रा न्याय</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />यहोवा ईंयाँ बोलोआ, “मोआबो रे लोके बार-बार पाप करी राखेया। इजी री खातर मां तिना रा न्याय करना। तिने एदोमो रे राजे री आड्डिया फूकी की स्वा बणाई ती दी। <verse eid="AMO 2:1" /><verse number="2" style="v" sid="AMO 2:2" />इजी री खातर मां मोआबो दे आग लगाणी ओर तिजी ते करिय्योत शईरो रे मईल फूखी जाणे ओर मोआबो रे लोक लड़ाईया रे शोरो दे मरी जाणे जेबे कि सिपाई जोरे की ललकारने लगी रे ऊणे ओर रड़सिंगा बजणे लगी रा ऊणा। <verse eid="AMO 2:2" /><verse number="3" style="v" sid="AMO 2:3" />मां तिना बीचा ते न्यायी नाश करी देणा ओर साथे-साथे तेसरे परदान बी काई देणे।” परमेशरो रा येई वचन ए।<verse eid="AMO 2:3" /></para>
  <para style="s">यहूदा रा न्याय</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />परमेशर फेर बोलोआ, “यहूदा रे लोके बार-बार पाप करी राखेया। इजी री खातर मां तिना रा न्याय करना। तिने मेरिया बिदिया खे मानणे ते ना करी राखी। तिने मेरी बिदिया नि मानिया ए। दूजे देवतेया सेयो पटकाईते दे ए। बऊत पईले तिना रे लोक तिना देवतेया री पूजा करो थे। <verse eid="AMO 2:4" /><verse number="5" style="v" sid="AMO 2:5" />इजी री खातर मां यहूदा दे आग लगाणी ओर तिजी ते यरूशलेमो रे मईल फूखी जाणे।”<verse eid="AMO 2:5" /></para>
  <para style="s">इस्राएलो रा न्याय</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />परमेशर फेर बोलोआ, “इस्राएलो रे लोके बार-बार पाप करी राखेया। इजी री खातर मां तिना रा न्याय करना। सेयो तिना लोका खे चाँदिए रे सिक्केया खे गुलाम बनाणे खे बेचो ए जो पुरिया तरआ ते निर्दोष ए। सेयो जरूरतमंद लोका खे एक जोड़ी जोड़ेया रे बदले बेची देओए। <verse eid="AMO 2:6" /><verse number="7" style="v" sid="AMO 2:7" />सेयो जमीना री तूड़ा पाँदे गरीबो रा सिर रगड़ोए; सेयो सीदे-सादे लोका खे तिना रिया बाटा ते फेरी देओए। बाओ ओर माठा, दोनो एकी ई छोट्टिया साथे गल़त काम करोए। ईंयाँ तिने मेरे पवित्र नाओं खे अपवित्र करिता दा ए। <verse eid="AMO 2:7" /><verse number="8" style="v" sid="AMO 2:8" />सेयो बन्दनो रे टाल्लेया खे वेदिया गे बछाओए, ओर आपू तिना पाँदे लेटोए। सेयो आपणे परमेशरो रे मन्दरो दे जुर्माने रे पैसेया री शराब पियोए। <verse eid="AMO 2:8" /><verse number="9" style="v" sid="AMO 2:9" />मैं कनान देशो दे बसाणे ते पईले एमोरी लोक नाश कित्ते थे; जिना रा कद देवदारो रे डाल़ा जेड़ा ऊच्चा था, जो बड़े डाल़ो जेड़े मजबूत थे। मैं ऊबा ते तिना रे फल़ ओर थाला ते तिना रिया जड़ी नाश कित्तिया थिया। <verse eid="AMO 2:9" /><verse number="10" style="v" sid="AMO 2:10" />इस्राएलो रे लोको, आऊँ तुसा खे मिस्र देशो ते बारे ल्याया। मैं तुसे चाल़ी साल तक रेगिस्तानो दे चलाए। मैं तुसा खे एमोरिया रे देशो पाँदे अधिकार दित्तेया। <verse eid="AMO 2:10" /><verse number="11" style="v" sid="AMO 2:11" />मैं तुसा रे माठेया बीचा ते नबी ऊणे खे ओर तुसा रे कुछ जवाना बीचा ते नाजीर ऊणे खे ठराए। ओ इस्राएलो रे लोको, क्या ये सब कुछ सच्च नि ए?” परमेशरो री येई बाणी ए।<verse eid="AMO 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 2:12" />पर तुसे नाज़ीरा खे शराब पल़्याया ओर नबिया खे आज्ञा दित्ती कि भविष्यबाणी नि करो। <verse eid="AMO 2:12" /><verse number="13" style="v" sid="AMO 2:13" />देखो, मां तुसे एड़े दबाणे, जेड़े पूल़ेया रे बजनो ते गड्डी थाले दबी जाओई। <verse eid="AMO 2:13" /><verse number="14" style="v" sid="AMO 2:14" />इजी री खातर तेज दौड़ने वाल़ेया खे नठणे खे जगा नि मिलणी ओर ना शक्तिशाली माणूं आपणा प्राण बचायी सकणा। <verse eid="AMO 2:14" /><verse number="15" style="v" sid="AMO 2:15" />धनुष चलाणे वाल़े नि रयी सकणे ओर तेज दौड़ने वाल़े नि बचणे, कोड़ेया रे सवार बी आपणा प्राण नि बचायी सकणे। <verse eid="AMO 2:15" /><verse number="16" style="v" sid="AMO 2:16" />एथो तक कि शूरवीरा बीचे जो जादा तागतबर ए, से बी तेस दिने नांगा ऊई की नठी जाणा। परमेशरो री येई बाणी ए।<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="s">यहोवे रा इस्राएलिया खे चतौणी देणा</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />ओ इस्राएलियो, ये वचन सुणो जो यहोवे तुसा रे बारे दे बोली राखेया ए, मतलब तेस सारे कराने रे खलाफ जेसखे आऊँ मिस्र देशो ते ल्याई राखेया: <verse eid="AMO 3:1" /><verse number="2" style="v" sid="AMO 3:2" />“तरतिया रे सारे कुलो बीचा ते मैं बस तुसा पाँदे ई मन लगाई राखेया, इजी बजा ते मां तुसा रे सारे बुरे कामा री सजा देणी। <verse eid="AMO 3:2" /><verse number="3" style="v" sid="AMO 3:3" />जे दो माणूं आपू बीचे सहमत नि ओ, तो क्या सेयो कट्ठे चली सकोए? <verse eid="AMO 3:3" /><verse number="4" style="v" sid="AMO 3:4" />क्या शेर बिना शिकारो ते बणो दे गरजणे? क्या जवान शेर बिना कुछ पकड़े आपणी गुफा ते गरजणा? <verse eid="AMO 3:4" /><verse number="5" style="v" sid="AMO 3:5" />क्या चिड़िया बिना फन्दा लगाए फसणी? क्या बिना कुछ फसे फन्दा जमीना ते चखणा? <verse eid="AMO 3:5" /><verse number="6" style="v" sid="AMO 3:6" />क्या केसी शईरो दे रड़सिंगा बजाणे ते लोक नि कांबणे? जदुए तक परमेशर केसी शईरो पाँदे बिपदा नि पेजो क्या तेस शईरो दे कोई मुसीबत पड़नी? <verse eid="AMO 3:6" /><verse number="7" style="v" sid="AMO 3:7" />ईंयाँ ई परमेशर यहोवा आपणे दास भविष्यबक्तेया पाँदे आपणा दु:ख बिना बताए कुछ नि करना।<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">प्रका. 10:7, पज. 25:14, </char></note> <verse eid="AMO 3:7" /><verse number="8" style="v" sid="AMO 3:8" />शेर गरजेया, कुण नि डरना? परमेशर यहोवा बोलेया, केस भविष्यबाणी नि करनी?”<verse eid="AMO 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9" />अशदोद शईरो रे मईल ओर मिस्र देशो रे मईलो पाँदे प्रचार करी की बोलो, “सामरिया रे पाह्ड़ो पाँदे कट्ठे ऊई की देखो कि तेस शईरो दे कितणी बड़ी मुसीबत ए, देखो, एथो रे लोक कितणे पाप करने लगी रे।” <verse eid="AMO 3:9" /><verse number="10" style="v" sid="AMO 3:10" />परमेशरो री ये बाणी ए, “जो लोक आपणे मईलो दे उपद्रव ओर चोरिया रा तअन कट्ठे करी की राखोए, सेयो सीदे काम करना नि जाणदे।” <verse eid="AMO 3:10" /><verse number="11" style="v" sid="AMO 3:11" />इजी बजा ते परमेशर यहोवा ईंयाँ बोलोआ, “दुश्मणा तुसा री जमीना पाँदे कब्जा करी लणा। तिना तुसा रे बचणे वाल़ी जगा टाल़ी देणियां। तिना तुसा रे किले लूटी लणे।”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />परमेशर ईंयाँ बोलोआ, “जेबे शेर पेडा पाँदे अमला करोआ, तो कदी-कदी ग्वाल़ा शेरो रे मुंए ते दो खुटिया या कानो रा एक टुकड़ा ई छुड़ाई पाओआ। ईंयाँ ई सामरिया दे रणे वाल़े कुछ इस्राएली लोक बची सकणे, ओर तिना सिर्फ एक मांजा ओर एक टखणो रा इस्सा ई बचाई सकणा।” <verse eid="AMO 3:12" /><verse number="13" style="v" sid="AMO 3:13" />सेना रे परमेशर यहोवे री ये बाणी ए, “देखो, याकूबो रे कराने रे खलाफ गवाई देयो, <verse eid="AMO 3:13" /><verse number="14" style="v" sid="AMO 3:14" />जेस बखते मां इस्राएलो खे तेसरे पापो री सजा देणी, तेस बखते ई मां बेतेलो रिया बेदिया बी तोड़ी देणियां ओर बेदिया रे सींग टूटी की जमीना दे छूटी जाणे। <verse eid="AMO 3:14" /><verse number="15" style="v" sid="AMO 3:15" />मां तिना रे सारे कअर नाश करी देणे, सेयो कअर जिना दे सेयो ठण्डी रे बखते रओए, ओर सेयो कअर जिना दे सेयो गर्मिया दे रओए। मां तिना रे बड़े ओर बांके कअर, आथी दाँदो ते बणिया दिया किमती चीजा पूरी तरआ ते नाश करी देणियां।” परमेशरो री येई बाणी ए।<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="s">सामरिया रिया जवाणसा</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1" />ओ सामरिया री पाह्ड़िया पाँदे रणे वाल़ी जवाणसो, यहोवे रा सन्देश सुणो। तुसे गरीब लोका साथे बुरा बर्ताओ करोईया। तुसे जरूरतमंदा खे केसोईया। तुसे आपणे-आपणे लाड़ेया खे बोलोईया, “आसा खे कुछ पीणे खे ल्याओ!” पर तुसे पईले ते ई बाशानो रिया गायी जेड़िया मोटिया ए। <verse eid="AMO 4:1" /><verse number="2" style="v" sid="AMO 4:2" />परमेशर यहोवा आपणी पवित्रता री कसम खाई की बोलोआ, “देखो, से बखत आऊणा जेबे तुसा रे नाको दे नकेल पाई की तुसे लई जाणे। तुसा बीचा ते हर एकी खे कांडे दे फसी री मछलिया जेड़े कसीटणे। <verse eid="AMO 4:2" /><verse number="3" style="v" sid="AMO 4:3" />तुसा रे दुश्मणा तुसे तुसा रे शईरो री दवाला दे कोर करी की बारे खींजी लणे, ओर तिना तुसे शईरो ते बारे हेर्मोन काअटिया रिया तरफा खे सेटी देणे। ये जरूर ऊणा कऊँकि मैं यहोवे ये बोली राखेया ए।”<verse eid="AMO 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 4:4" />बेतेल शईरो दे आई की मेरे खलाफ पाप करो ओर गिलगाल शईरो दे आई की बार-बार पाप करो, हर रोज प्यागा आपणी बलि पेंट चढ़ाओ। हर तीजे साले आपणी उपजा रा दसुआ इस्सा ल्याया करो। <verse eid="AMO 4:4" /><verse number="5" style="v" sid="AMO 4:5" />कुछ रोटी सजेड़े साथे पकाओ। इजी खे तन्यवादो री पेंटा रे रूपो दे फूको। आपणी इच्छा ते दित्ती री पेंटा रे बारे दे प्रचार करो। ये ई तुसा इस्राएलिया खे करना पसन्द ए, परमेशर यहोवे री येई बाणी ए। <verse eid="AMO 4:5" /><verse number="6" style="v" sid="AMO 4:6" />मैं तुसा रे सबी शईरा दे दाँदा री सफाई कराईती दी ए ओर तुसा रिया सबी जगा दे रोटिया री कमी करी राखी, तेबे बी तुसे मेरी तरफा खे फिरी की नि आए, परमेशरो री येई बाणी ए। <verse eid="AMO 4:6" /><verse number="7" style="v" sid="AMO 4:7" />जेबे बडाईया रे तीन मीन्ने रयी गे, तेबे मैं तुसा खे बर्खा नि कित्ती, मैं एकी शईरो दे पाणी बरसायी की दूजे दे नि बरसाया, एकी डोरूए दे पाणी बरसेया ओर दूजे डोरूए दे जिदे बरसेया नि, से सूकीगा।<verse eid="AMO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 4:8" />इजी री खातर दो-तीन शईरा रे लोक पाणी पीणे खे मारे-मारे फिरदे ऊए एक ई शईरो दे आए, पर रज्जे नि, तेबे बी तुसे मेरी तरफा खे नि फिरे, परमेशरो री येई बाणी ए। <verse eid="AMO 4:8" /><verse number="9" style="v" sid="AMO 4:9" />मैं तुसे लू ओर सूका पड़ने ते काये ओर जेबे तुसा रे बगीचे ओर अंगूरा रे बगीचे, दाऊगल़े ओर जैतूनो रे डाल़ बऊत ऊईगे, तेबे सेयो टिड्डिये खाई ते, तेबे बी तुसे मेरी तरफा खे फिरी की नि आए, परमेशरो री येई बाणी ए। <verse eid="AMO 4:9" /><verse number="10" style="v" sid="AMO 4:10" />मैं तुसा पाँदे बी बिपदा पेजिया, जेड़िया मैं मिस्र देशो पाँदे पेजिया थिया। मैं तुसा रे जानवर तलवारे की काये। मैं तुसा रे पाल़े दे कोड़े बी काईते। मैं तुसा रे डेरेया री बदबूआ ते तुसा रे नाक परी ते। इतणा ऊणे ते बाद बी तुसे मेरिया तरफा खे नि आए, परमेशरो री येई बाणी ए। <verse eid="AMO 4:10" /><verse number="11" style="v" sid="AMO 4:11" />मैं तुसा बीचा ते कई जणे एड़े नाश करीते, जिंयाँ परमेशरे सदोम ओर गमोरा रे लोक नाश कित्ते थे ओर तुसे आगी ते निकयाल़े रे लकड़ूआ जेड़े ठईरे, तेबे बी तुसे मेरी तरफा खे फिरी की नि आए, परमेशरो री येई बाणी ए। <verse eid="AMO 4:11" /><verse number="12" style="v" sid="AMO 4:12" />तो एबे ओ इस्राएलो रे लोको, आऊँ तुसा खे सजा देणे लगी रा। आपणे परमेशर मां सामणे खड़े ऊणे खे खड़े ऊई जाओ। <verse eid="AMO 4:12" /><verse number="13" style="v" sid="AMO 4:13" />देख, पाह्ड़ो खे बनाणे वाल़ा, अवा खे बनाणे वाल़ा ओर माणूंआ खे तेसरे मनो री सोच बताणे वाल़ा ओर जो प्रयासा ओर न्हेरे खे बनाणे वाल़ा ए, ओर जो तरतिया दे ऊच्ची जगा दे चलणे वाल़ा ए, तेसरा नाओं ई सेना रा यहोवा ए!<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s">परमेशरो रिया तरफा खे मुड़ना</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />ओ इस्राएलो रे लोको, परमेशरो रा सन्देश सुणो। तुसा रे बारे दे मेरा शोगो वाल़ा गीत सुणो; <verse eid="AMO 5:1" /><verse number="2" style="v" sid="AMO 5:2" />तुसे इस्राएलो री एकी जवान जवाणसा जेड़े ए, पर तेबे बी तुसे पक्का काये जाणे ओर तुसे फेर कदी नि उठी सकणे! तुसे जमीना पाँदे छाडे दे पड़े दे रणे, ओर कोई बी तुसा खे खड़े ऊणे दे मताद नि करी सकणा। <verse eid="AMO 5:2" /><verse number="3" style="v" sid="AMO 5:3" />कऊँकि परमेशर यहोवा ईंयाँ बोलोआ, “जेबे कोई शईर लड़ाईया खे 1,000 सिपाईया खे पेजोआ, तो सिर्फ इस्राएलो रे 100 ई सिपाई वापस आओए। जेबे कोई शईर 100 सिपाईया खे पेजोआ, तो सिर्फ दस ई जिऊँदे वापस आओए।”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />परमेशर इस्राएलो रे लोका खे ईंयाँ बोलोआ, “माखे टोल़दे रओ, तेबे जिऊँदे रणे। <verse eid="AMO 5:4" /><verse number="5" style="v" sid="AMO 5:5" />मेरी मताद मांगणे खे बेतेलो दे नि जाओ; आराधना करने खे गिलगालो खे नि जाओ; एथो तक कि बेर्शेबा दे पनि जाओ, कऊँकि तुसा रे दुश्मणा गिलगालो रे लोक दूजे देशा दे लई जाणे, ओर बेतेल पापो रिया बजा ते पूरी तरआ ते नाश ऊई जाणा।” <verse eid="AMO 5:5" /><verse number="6" style="v" sid="AMO 5:6" />तो परमेशरो गे आओ, तेबे जिऊँदे रणे, नई तो से यूसुफो रे कराने पाँदे आगी जेड़ा पड़कणा ओर तेस से फूकी देणा ओर बेतेलो दे तेसा आगी खे बजयाणे वाल़ा कोई नि ऊणा। <verse eid="AMO 5:6" /><verse number="7" style="v" sid="AMO 5:7" />तुसा बीचे कुछ एड़े लोक बी ए जो पले कामा खे बी बुरा बणाई देओए। सेयो सई कामा खे बी माट्टिया रे मलाई देओए। <verse eid="AMO 5:7" /><verse number="8" style="v" sid="AMO 5:8" />जिने कचपचिया ओर मृगशिरा खे बणाया, जो अन्दकूप न्हेरे खे प्यागा रा प्रयासा बणाओआ, जो दिनो खे रात बणाई देओआ। से समुद्रो ते पाणी खींजो आ ओर तेसखे जमीना पाँदे बर्खा रे रूपो दे बरसाओआ, तेसरा नाओं यहोवा ए। <verse eid="AMO 5:8" /><verse number="9" style="v" sid="AMO 5:9" />ते चट ई तागतवरो खे बर्बाद करी देयोआ ओर गढ़ो रा बी सत्यानाश करी देयोआ।<verse eid="AMO 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 5:10" />तुसे ईमानदार ओर न्यायिया ते कृणा करोए। तुसे तिना सबी पाँदे आसोए जो निर्दोष ए ओर सच्च बोलोए। <verse eid="AMO 5:10" /><verse number="11" style="v" sid="AMO 5:11" />तुसे जो कंगाल़ा पाँदे अत्याचार करोए ओर पेंट बोली की तिना ते नज्ज छुड़ाई लओए, इजी री खातर जो कअर तुसे कअड़े रे पात्थरा साथे बणाई राखे, तिदे रयी नि सकणे ओर जो कीमती अंगूरा रे बगीचे तुसे लगाई राखे, तिना रा शराब नि पी सकणे। <verse eid="AMO 5:11" /><verse number="12" style="v" sid="AMO 5:12" />कऊँकि आऊँ तुसा रे सबी तरआ रे पापा खे जाणूंआ। कि तुसा रे पाप बऊत पारी ए। तुसे तर्मिया खे सताओए ओर रिश्वत लओए ओर तुसे कचरिया रे द्वारो ते गरीब लोका खे नठाई देओए। <verse eid="AMO 5:12" /><verse number="13" style="v" sid="AMO 5:13" />इजी बजा ते जो अक्लमंद ओ, से एड़े बखते चुप रओ, कऊँकि बखत बुरा ए। <verse eid="AMO 5:13" /><verse number="14" style="v" sid="AMO 5:14" />ओ लोको, बुराईया खे नि, खराईया खे टोल़ो, ताकि तुसे जिऊँदे रओ ओर तुसा रा ये बोलणा सच्च ओ कि सेना रा परमेशर यहोवा तुसा साथे ए। <verse eid="AMO 5:14" /><verse number="15" style="v" sid="AMO 5:15" />बुराईया साथे बैर ओर पलाईया साथे प्यार राखो ओर फाटको दे न्याय खे पक्का करो, क्या पता सेना रा परमेशर यहोवा यूसुफो रे बचे रे वंशो पाँदे दया करो। <verse eid="AMO 5:15" /><verse number="16" style="v" sid="AMO 5:16" />इजी बजा ते सेना रे परमेशर, परमेशर यहोवा ईंयाँ बोलोआ, “सबी चौका रे रोणा-पीटणा ऊणा ओर लोका सबी सड़का रे हाय, हाय करनी! सेयो जिम्मीदारा खे आपू साथे रोणे खे बुलाओ, ओर जो रोणे रा ई काम करोए तिना खे बी रोणे खे बुलाओ।”<verse eid="AMO 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 5:17" />सबी अंगूरा रे बगीचेया दे रोणा-पीटणा ऊणा, कऊँकि परमेशर ईंयाँ बोलोआ, “कऊँकि मां सेयो सब नाश करी देणे।” <verse eid="AMO 5:17" /><verse number="18" style="v" sid="AMO 5:18" />तुसा पाँदे लाणत ए, जो परमेशरो रे दिनो री इच्छा करोए! काश, परमेशरो रा दिन आई जांदा! तुसा खे नि पता कि तुसे क्या इच्छा करने लगी रे। तेस दिनो न्हेरा ल्याऊणा प्रयासा नि। <verse eid="AMO 5:18" /><verse number="19" style="v" sid="AMO 5:19" />जेड़ा कोई शेर रे डरो ते नठोआ ओर तेसखे पालू मिलो या जेबे से बचणे खे आपणे कअरे जाओआ, तो से कांदा दे आपणा आथ राखोआ ओर एक साप तेसखे डसी लओआ। <verse eid="AMO 5:19" /><verse number="20" style="v" sid="AMO 5:20" />आ, यहोवे रा से दिन न्हेरे रा ओर निराशा वाल़ा ऊणा, बिना खुशी ओर बिना उम्मीदा वाल़ा। <verse eid="AMO 5:20" /><verse number="21" style="v" sid="AMO 5:21" />आऊँ तुसा रे त्योआरो ते बैर राखूँआ ओर तिना खे नबाग जाणूंआ ओर तुसा री बड़ी सभा ते आऊँ खुश नि ए। <verse eid="AMO 5:21" /><verse number="22" style="v" sid="AMO 5:22" />चाए तुसे माखे नज्जो री बलि ओर होमबलि चढ़ाओ, तेबे बी मां मेलबलिया रे रूपो दे चढ़ाए दे तुसा रे मोटे-मोटे बाच्छूआ रे मासो खे देखणा पनि ए।<verse eid="AMO 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="AMO 5:23" />आपणे गाणे रे आल्ले खे मांते दूर करो, तुसा री सारंगिया रे सुर मां नि सुणने। <verse eid="AMO 5:23" /><verse number="24" style="v" sid="AMO 5:24" />पर न्याय खे नदिया जेड़े ओर तर्मो खे समुद्रो रे पाणिए जेड़े बह्ईणे देयो। <verse eid="AMO 5:24" /><verse number="25" style="v" sid="AMO 5:25" />ओ इस्राएलो रे लोको, तुसे बणो दे चाल़ी साल तक डांगरा री बलि ओर नज्जो री बलि क्या माखे ई चढ़ांदे रये? <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" />तुसा गे मूर्तिया ए जो तुसे आपणियां तँईं बणाई राखिया। तुसा गे तुसा रे राजा सक्कुथो री मूर्ति ए। तुसा गे तुसा रे तारेया रे देवता कैवानो री मूर्ति ए। एबे तुसा खे सेयो आपू साथे लई जाणिया पड़निया। <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" />इजी बजा ते मां तुसे दमिश्को ते पार गुलामिया दे पेजी देणे, सेना रे परमेशर यहोवे रा येई वचन ए।<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s">इस्राएलो खे सजा मिलणा</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1" />तुसा लोका खे लाणत ए! जो सिय्योनो रे पाह्ड़ो पाँदे इतणे निश्चिंत ए! तुसा लोका खे ये कितणा खतरनाक ऊणा जो सामरिया री पाह्ड़िया पाँदे बचे दे महसूस करोए! कऊँकि तुसा रा परोसा तिना पाँदे आ। तुसे सबी ते महान देशो रे जाणे-माणे दे लोक ए। इस्राएलो रे लोक मताद ओर सलाई रिया तँईं तुसा गे आओए। <verse eid="AMO 6:1" /><verse number="2" style="v" sid="AMO 6:2" />कलने शईरो खे जाई की देखो ओर तेथा ते हमात नाओं रे बड़े शईरो खे जाओ, तेबे पलिश्तिया रे गत शईरो खे जाओ। क्या सेयो इना राज्या ते खरे ए? क्या तिना रा देश तुसा रे देशो ते कुछ बड़ा ए? <verse eid="AMO 6:2" /><verse number="3" style="v" sid="AMO 6:3" />तुसे आऊणे वाल़ी मुसीबता रे हर बिचारो खे दूर करी देओए, पर तुसा रे काम सिर्फ न्याय रे दिनो खे नेड़े ल्याओए। <verse eid="AMO 6:3" /><verse number="4" style="v" sid="AMO 6:4" />तुसे आथी दाँदो रे माँजे पाँदे लेटोए ओर आपणे-आपणे बछौणे पाँदे पैर फैलायी की सओए ओर पेडा-बाकरिया बीचा ते मिन्टू ओर गवाईणी ते बाच्छू खाओए।<verse eid="AMO 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 6:5" />तुसे आपणियां सारंगिया साथे गाणे गाओए। राजा दाऊदो जेड़े आपणे बजाणे वाल़े बाजेया खे बजांदे रओए। <verse eid="AMO 6:5" /><verse number="6" style="v" sid="AMO 6:6" />तुसे शराबो रे कटोरेया पाँदे कटोरे पियोए; ओर सबी ते बड़िया तेले की आपणे सिरो री माल़श कराओए! पर तुसा खे यूसुफो रे वंशो रे नाशो रा कोई दु:ख नि आ, <verse eid="AMO 6:6" /><verse number="7" style="v" sid="AMO 6:7" />इजी बजा ते एबे सेयो पईले गुलामिया दे जाणे। तुसे अच्छे खाणे रा मजा नि लई सकणे। तुसे एबे माँजे पाँदे नि लेटी सकणे।<verse eid="AMO 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />परमेशर यहोवा सख्ताईया साथे कसम खाई की ये बोलेया, “आऊँ इस्राएलो रे लोका ते नफरत करूँआ कऊँकि से बऊत कमण्डी ए; आऊँ तिना रे किलेया ते नफरत करूँआ। मां ये शईर सब किजी साथे जो इदे आ, तिना रे दुश्मणा रे कब्जे दे करी देणा।” <verse eid="AMO 6:8" /><verse number="9" style="v" sid="AMO 6:9" />जे केसी कअरो दे दस मर्द बचे दे रओगे, तेबे बी सेयो मरी जाणे। <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />रिश्तेदार लाशा खे फूकणे खे आई सकोए। जे सेयो एड़ा करोए, तिना खे पईले सेयो लाशा कअरो ते बारे लई जाणिया पड़निया। सेयो तेती लूके दे केसी माणूंए ते पूछो, “क्या तुसा साथे कोई ओर बी आ?” जे ज्वाब आया, ना, तो रिश्तेदारो बोलणा, “चुप रओ! आसा खे यहोवे रे नाओं नि लणा चाईयो।” <verse eid="AMO 6:10" /><verse number="11" style="v" sid="AMO 6:11" />देखो, परमेशर यहोवे आज्ञा देणी ओर बड़े-बड़े मईल टुकड़े-टुकड़े कित्ते जाणे ओर छोटे कअरा रे छोटे-छोटे टुकड़ेया दे तोड़ी देणे। <verse eid="AMO 6:11" /><verse number="12" style="v" sid="AMO 6:12" />कोड़े पात्थरा वाल़ी जमीना पाँदे नि दौड़दे। लोक बल़दे की समुद्रो दे अल़ नि चलांदे। पर तुसे न्याय वाल़े बर्ताओ खे जईरो दे बदली ता दा ए। तुसे सई जीवनो रे नतीजे खे बुराईया दे बदली ता दा ए। <verse eid="AMO 6:12" /><verse number="13" style="v" sid="AMO 6:13" />तुसे एड़ी चीजा ते खुशी मनाओए जो बेकार ए ओर बोलोए, “आसे आपणी तागती ते करनईम शईर जीती राखेया ए।” <verse eid="AMO 6:13" /><verse number="14" style="v" sid="AMO 6:14" />इजी बजा ते सेना रे परमेशर यहोवे री ये बाणी ए, “ओ इस्राएलो रे लोको, देखो, मां तुसा रे खलाफ एक एड़ी जाति खड़ी करनी, जेसा तुसे हमातो री काट्टिया ते लई की अराबा री नदिया तक दबाणे।”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s">विनाशो रे तीन दर्शण टिड्डिया</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />परमेशर यहोवा ए माखे एक दर्शण दखाया। मैं देखेया कि से देशो पाँदे टिड्डिया रा एक बड़ा चूण्ड पेजणे री त्यारी करने लगी रा था। ये तेबे ऊआ जेबे राजे रा इस्सा डोरूआ ते कटी चूकी रा था ओर खास फसल आऊणे वाल़ी थी। <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />मेरे दर्शणो दे टिड्डिये काआ खाई ला। तेबे मैं बोलेया, “ओ परमेशर यहोवा, आसा खे माफ करी दे, नई तो आसे बची नि सकणे, कऊँकि इस्राएल बऊत छोटा ए।” <verse eid="AMO 7:2" /><verse number="3" style="v" sid="AMO 7:3" />इजी रे बारे दे परमेशर पछताया ओर तेसखे बोलेया, “ये जो तैं देखेया से पूरा नि ऊणा।”<verse eid="AMO 7:3" /></para>
  <para style="s">आग</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />फेर परमेशर यहोवा माखे एक ओर दर्शण दखाया। मैं देखेया कि से आपणे लोका खे आगी ते सजा देणे री त्यारी करने लगी रा। तेसे आगी समुद्र सुकाईते थे ओर सारे देशो खे राख करने लगी री थी। <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />तेबे मैं बोलेया, “ओ परमेशर यहोवा, रूकी जा! नई तो याकूब<note caller="+" style="f"><char style="fr" closed="false">7:5 </char><char style="fq" closed="false">याकूब </char><char style="ft" closed="false">इस्राएली लोक </char></note> बची नि सकणा, कऊँकि से बऊत छोटा ए।” <verse eid="AMO 7:5" /><verse number="6" style="v" sid="AMO 7:6" />इजी रे बारे दे परमेशर पछताया ओर तेसखे बोलेया, “ये जो तैं देखेया से पूरा नि ऊणा।”<verse eid="AMO 7:6" /></para>
  <para style="s">साल़</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />फेर परमेशरे माखे एक ओर दर्शण दखाया। से एकी दवाला गे खड़ी रा था। ये दवाल बिल्कुल सीदी बणी री थी, ऊबा ते लई की थालो तक। तिने एक साल़ पकड़ी राखी थी। <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />तेबे परमेशरे माखे बोलेया, “ओ आमोस, ताखे क्या दिशणे लगी रा?” मैं बोलेया, “एक साल़।” तेबे परमेशरे बोलेया, “देख, मां आपणी इस्राएल प्रजा बीचे साल़ लगाणी। <verse eid="AMO 7:8" /><verse number="9" style="v" sid="AMO 7:9" />मां एबे सेयो नि छाडणे, इसहाको रिया ऊच्ची जगा उजाड़ ओर इस्राएलो रिया पवित्र जगा सुनसाण ऊई जाणिया ओर मां यारोबामो रे कराने पाँदे तलवार लई की अमला करना।”<verse eid="AMO 7:9" /></para>
  <para style="s">आमोस ओर अमस्याह</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />तेबे बेतेलो रे पुरोईत अमस्याहे इस्राएलो रे राजा यारोबामो गे सन्देसा पेजेया, “आमोसे इस्राएलो रे कराने बीचे तां साथे राजद्रोह करने री साजिश करी राखी, तेसरे सबी वचना देश नाश करी देणा।” <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />आमोस ईंयाँ बोलोआ, “यारोबाम तलवारी साथे कायी देणा। ओर इस्राएलो रे लोक बन्दी बणाई की लई जाणे। सेयो तिना रिया जमीना ते दूर लई जाणे।” <verse eid="AMO 7:11" /><verse number="12" style="v" sid="AMO 7:12" />तेबे अमस्याहे आमोसो ते बोलेया, “ओ नबी, इस्राएलो तो निकल़ी जा! यहूदा देशो खे वापस चली जा। तेथी आपणा जीवन बिता। तेथी भविष्यबाणी करेया कर, <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />पर बेतेल शईरो दे फेर कदी भविष्यबाणी नि करनी, कऊँकि ये राजे री पवित्र जगा ओर राजे रा शईर ए।”<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />आमोसे अमस्याह खे बोलेया, “आऊँ ना तो भविष्यबक्ता था ओर ना भविष्यबक्ते रा पाऊ, आऊँ तो गायी-बल़दा खे चराणे वाल़ा ओर खजूरा रे डाल़ा री देखपाल़ करने वाल़ा ए।” <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />पर परमेशरे माखे पेडा-बाकरिया ते पीछे-पीछे फिरने ते बुलाया ओर बोलेया, “जा मेरी इस्राएली प्रजा ते भविष्यबाणी कर।” <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />इजी री खातर एबे तूँ परमेशरो रा वचन सुण, तूँ बोलेया, “इस्राएलो रे खलाफ भविष्यबाणी नि कर ओर इसहाको रे लोका रे खलाफ बार-बार उपदेश देणा बन्द कर।” <verse eid="AMO 7:16" /><verse number="17" style="v" sid="AMO 7:17" />इजी बजा ते परमेशर ईंयाँ बोलोआ कि तेरी लाड़ी शईरो दे वेश्या ऊई जाणी ओर तेरे माठे-बेटिया तलवारी साथे काई देणे ओर तेरी जमीन डोरी लगाई की बांडी देणी ओर तूँ आपू अशुद्ध देशो दे मरना। ओर इस्राएलो रे लोक बी आपणी जमीना ते दूर गुलामिया दे चली जाणे।<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s">फला ते परी री टोकरिया रा दर्शण</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />परमेशर यहोवा माखे दर्शणो दे दखाया कि गर्मिया रे फल़ा साथे परी री एक टोकरी ए। <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />तिने माखे बोलेया, “ओ आमोस, ताखे क्या दिशणे लगी रा?” मैं बोलेया, “गर्मिया रे पके रे फल़ा साथे परी री एक टोकरी ए।” तेबे परमेशरे माखे बोलेया, “इजी ते पता चलोआ कि मेरी इस्राएल प्रजा रा अन्त आई गा रा ए। मां तिना खे सजा देणे रे बारे दे आपणा मन फेर नि बदल़णा।” <verse eid="AMO 8:2" /><verse number="3" style="v" sid="AMO 8:3" />परमेशर यहोवे री बाणी ए, “से दिन आऊणे लगी रा जेबे मन्दरो रे गाणे रोणे दे बदली जाणे। ओर सेयो लाशा चुपचाप हर जगा दे सेटी देणियां।” <verse eid="AMO 8:3" /><verse number="4" style="v" sid="AMO 8:4" />ये सुणो, तुसे जो गरीबा खे निगल़ना ओर देशो रे नम्र लोका खे बर्बाद करना चाओए।<verse eid="AMO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 8:5" />तुसे बोलोए, “नया चाँदो रा त्योआर कदी खत्म ऊणा, ताकि आसे आपणा नज्ज बेची सकिये। रामो रा दिन कदी खत्म ऊणा, तेबे लोका आसा रा नज्ज खरीदी सकणा।” पर तुसे सई नापो ते नि नापदे। तुसे आपणे समानो रिया कीमता बढ़ाई देओए। तुसे बेईमानिया ते ताकड़िया रा इस्तेमाल करी की दूजेया खे तोखा देओए। <verse eid="AMO 8:5" /><verse number="6" style="v" sid="AMO 8:6" />आसा कंगाल़ा खे पैसे देई की ओर गरीबा खे एक जोड़ी जोड़े देई की खरीदी लओए, ओर कटिया नज्ज बेचूँ।<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />याकूबो रे लोको, तुसे कमण्ड करोए कि यहोवा तुसा रा परमेशर ए। पर तिने आपणे नाओं ते वादा करी राखेया। से बोलोआ, “मां इस्राएलो रे जरीये कित्ते दे केसी बी कामो खे कदी नि पूलणा।” <verse eid="AMO 8:7" /><verse number="8" style="v" sid="AMO 8:8" />जो कुछ बी कटणा ऊणी, तिजी ते तरती काँबी जाणी। इजी दे रणे वाल़े सारे लोक रोणे लगणे। इजी री खातर जमीन नील नदिया जेड़ी ऊबो खे ऊई जाणी। ये ऊफणनी। फेर ये मिस्रो री तेसा नदिया जेड़ी फेर शांत ऊई जाणी। <verse eid="AMO 8:8" /><verse number="9" style="v" sid="AMO 8:9" />परमेशर यहोवे री ये बाणी ए, “तेस बखते मां सूरज त्याड़िया रे बखते अस्त करना ओर एस देशो दे दिन-दपईरे अन्दकूप न्हेरा करी देणा। <verse eid="AMO 8:9" /><verse number="10" style="v" sid="AMO 8:10" />मां तुसा रे त्योआरो री खुशी, शोगो दे बदली देणी; गाणे रे बजाये हर कोई रोणे लगणा। मां जो करना, तेतेरिया बजा ते तुसा सबी टाट पईनणी ओर आपणे सिर गँजे करी की दखाणे कि तुसे शोग करने लगी रे। मां से बखत तेड़ा ई बणाई देणा जेड़े लोक आपणे एकलौते पाऊए रे मरने पाँदे शोग मनाओए। तुसे सब तेस दिने बऊत दु:खी रणे।”<verse eid="AMO 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 8:11" />परमेशर यहोवे री ये बाणी ए, “देखो, एड़े दिन आओए, जेबे मां एस देशो दे पूखमरी फलाणी। पर लोक नज्जो रिया तँईं पूखे नि ऊणे। सेयो पाणिए खे त्याये नि ऊणे। इजी रे बजाये, सेयो मांते सन्देश पाणे खे पूखे ऊणे। <verse eid="AMO 8:11" /><verse number="12" style="v" sid="AMO 8:12" />लोक खारे समुद्रो ते बड़े समुद्रो तक रूड़दे ऊए जाणे, ओर उत्तरा ते पूर्बा खे पटकदे ऊए मां यहोवे ते सन्देश पाणे री टोल़ा दे जाणे, पर तिना खे कोई सन्देश नि मिलणा। <verse eid="AMO 8:12" /><verse number="13" style="v" sid="AMO 8:13" />तेस बखते सुन्दर कुआँरिया ओर जवान माठे दोनो त्यायी रे मारे बेओश ऊई जाणे। <verse eid="AMO 8:13" /><verse number="14" style="v" sid="AMO 8:14" />जो लोक सामरिया रे दोष देवते री कसम खाओए ओर जो बोलोए, ‘दानो रे देवते री जिन्दगिया री कसम’, ओर बेर्शेबा रे देवते री कसम, सेयो सारे रूड़ी जाणे ओर फेर नि उठणे।”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s">परमेशरो रा न्याय</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />फेर मैं दर्शणो दे देखेया कि परमेशर बेदिया गे खड़ी रा। तिने बोलेया, “मन्दरो रे द्वारा रे खम्बेया रे सिरे पाँदे बायी देयो, ताकि निऊँ ईल्ली जाओ, ओर तिना रे सिर टूटी जाओ। जो लोक थाले ए तिना पाँदे छत टाल़ी देयो, ओर जो बची जाणे सेयो लोक मां लड़ाईया दे तलवारी ते कायी देणे। फेर जो बची जाणे, सेयो बी बची नि सकणे। <verse eid="AMO 9:1" /><verse number="2" style="v" sid="AMO 9:2" />कऊँकि चाए सेयो खणी की पताल़ो दे उतरी जाओ, तेबे बी मां सेयो पकड़ी की तेथा ते ल्याऊणे, चाए सेयो सर्गो दे चढ़ी जाओगे, मां सेयो तेथा ते बी थाले उतारी की ल्याऊणे। <verse eid="AMO 9:2" /><verse number="3" style="v" sid="AMO 9:3" />चाए सेयो कर्मेलो रे पाह्ड़ो पाँदे लूकी जाओगे, पर मां सेयो तेती बी टोल़ी की पकड़ी लणे ओर चाए सेयो समुद्रो बीचे मेरी नजरा ते लूकी जाओ, तेती बी मां सापो खे तिना खे डसणे री आज्ञा देणी। <verse eid="AMO 9:3" /><verse number="4" style="v" sid="AMO 9:4" />चाए दुश्मण तिना खे जबरदस्ती गुलामिया दे लई जाओ, तेती बी मां आज्ञा देई की सेयो तलवारी साथे कुल़वाणे ओर मेरी नजर तिना पाँदे पलायी करने खे नि पर बुराई करने खे ई पड़नी।”<verse eid="AMO 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 9:5" />सेना रे परमेशर यहोवे रे छूँणे ते तरती गल़ोई ओर तेते पाँदे रणे वाल़े सारे शोग करोए, से सारी की सारी मिस्रो री नील नदिया जेड़ी जाओई, जो बढ़ोई, तेबे लईरा उठोईया ओर थाले बी ऊई जाओई। <verse eid="AMO 9:5" /><verse number="6" style="v" sid="AMO 9:6" />यहोवा आपणा मन्दर स्वर्गो दे बणाओआ, जेतेरी निऊँ तरतिया पाँदे राखी जाओई। से समुद्रो ते पाणी चकोआ, ओर तिजी खे बर्खा रे रूपो दे तरतिया पाँदे बरसाओआ। तेसरा नाओं ई यहोवा ए। <verse eid="AMO 9:6" /><verse number="7" style="v" sid="AMO 9:7" />ओर परमेशर बोलोआ, “ओ इस्राएलो रे लोको, तुसे एबे माखे कूशो रे लोका ते जादा जरूरी नि ए। मैं तुसा रे बुजुर्ग मिस्र देशो ते एती ल्याये, पर आऊँ पलिश्तिया खे कप्तोर द्वीपो ते बी ल्याया, ओर मैं सामरिया रे लोक कीर जगा ते ल्याये। <verse eid="AMO 9:7" /><verse number="8" style="v" sid="AMO 9:8" />देखो, परमेशर यहोवे री नजर एस पापो ते परे रे देशो पाँदे लगी री ओर मां ये तरतिया पाँदा ते नाश करना, तेबे बी मां पूरी तरअ ते याकूब नाश नि करना”, परमेशरो री येई बाणी ए। <verse eid="AMO 9:8" /><verse number="9" style="v" sid="AMO 9:9" />जेबे मां एसखे आज्ञा देणी, तो ये एड़ा ऊणा मानो आऊँ तुसा इस्राएली लोका खे जो लग-लग देशा दे रओए, ईलाई देणे, जेड़े कोई जिम्मीदार छानणिया खे ईलाई की नज्जो ते पात्थर लग करी देओआ, ताकि से साफ नज्ज जमीना दे नि पड़ो। <verse eid="AMO 9:9" /><verse number="10" style="v" sid="AMO 9:10" />मेरी प्रजा रे सारे पापी लोक जो बोलोए, “आसा पाँदे मुसीबत नि पड़नी ओर ना आसे केरने”, सेयो सारे लड़ाई दे तलवारी साथे मरने।<verse eid="AMO 9:10" /></para>
  <para style="s">इस्राएलो रे दुबारा खड़े ऊणे रा वादा</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />तेस बखते मां दाऊदो री टल़ी की चूँगड़ी खड़ी करनी ओर तेसरे बाड़े रे नाके सुदारने ओर तेसरे खण्डहर फेर बनाणे ओर जेड़ा से पुराणे बखतो दे था, से तेड़ा ई बणाई देणा। <verse eid="AMO 9:11" /><verse number="12" style="v" sid="AMO 9:12" />तेबे मेरी प्रजा रे लोका एदोमो रे बचे रे लोका पाँदे राज करना। मेरिया प्रजा तिना सबी जातिया पाँदे बी राज करना जो मेरिया ए, तेस यो सब काम करने, यहोवे री येई बाणी ए। <verse eid="AMO 9:12" /><verse number="13" style="v" sid="AMO 9:13" />परमेशरो री ये बी बाणी ए, “से बखत आऊणा जेबे तुसारे डोरूआ दे नज्ज बऊत अच्छी तरआ ते जमणा। लोका खे आपणी फसला छोड़ बाडणियां पड़निया, तेते ते बाद ई सेयो फेर दुबारा अल़ चलाई सकोए। तुसा रिया बेली दे बऊत सारे अंगूर जमणे। लोका नवींया बेली लगाणे ते पईले अंगूरा ते शराब बनाणे रा काम छोड़ करना। अंगूरा ते इतणा रस निकल़ना कि से पाह्ड़िया ते थाले बह्ईणे लगणा। <verse eid="AMO 9:13" /><verse number="14" style="v" sid="AMO 9:14" />मां आपणे इस्राएली लोक गुलामिया ते वापस ली आऊणे। तिना सेयो उजड़े दे शईर फेर बनाणे ओर तिना दे बसणे। तिना अंगूरा रे बगीचे लगाणे ओर तिना रे फल़ा रा रस पीणा। तिना साग-सब्बजिया रे बगीचे लगाणे, ओर तिना रे फल़ खाणे। <verse eid="AMO 9:14" /><verse number="15" style="v" sid="AMO 9:15" />मां इस्राएल तिना रे आपणे देशो देई बसाणा। सेयो तेस देशो ते फेर कदी नि निकाल़ने जो मैं तिना खे देई राखेया ए,” तुसा रे परमेशर यहोवे री येई बाणी ए।<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>