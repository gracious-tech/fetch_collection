<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAG" style="id" />
  <para style="h">हाग्गै</para>
  <para style="toc1">हाग्गै नबीए रे जरिये लिखी री कताब</para>
  <para style="toc2">हाग्गै</para>
  <para style="toc3">हाग्ग.</para>
  <para style="mt">हाग्गै</para>
  <para style="mt2">हाग्गै नबीए रे जरिये लिखी री कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">हाग्गै री कताब छोटे-छोटे सन्देशा रा एक समूह ए जो परमेशरे हाग्गै नबीए रे जरीये ई. पू. 520 दे दित्तेया था। लोक गुलामिया ते वापस आईगे थे, ओर यरूशलेमो दे रंदे ऊए कुछ साल बीतीगे थे, पर यरूशलेमो रा मन्दर एबु बी टूटेया-फूटेया दा ई पड़ी रा था। ये सन्देश लोका रे परदाना ते मन्दरो रे दुबारा बनाणे खे बोलोए, ओर इजी दे परमेशर आऊणे वाल़े बखतो दे आशीष ओर शान्ति देणे री प्रतिज्ञा करोआ जो फेर बसणे ओर पवित्र लोका खे ऊणी।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">मन्दरो रे दुबारा बनाणे री आज्ञा <char style="ior"><ref loc="HAG 1:1-15">1:1-15</ref></char></para>
  <para style="io1">शान्ति ओर उम्मीदा रे सन्देश <char style="ior"><ref loc="HAG 2:1-23">2:1-23</ref></char></para>
  <chapter number="1" style="c" sid="HAG 1" />
  <para style="s">मन्दरो रे दुबारा बनाणे री आज्ञा</para>
  <para style="p">
    <verse number="1" style="v" sid="HAG 1:1" />परमेशरो रिया तरफा ते एक सन्देश हाग्गै भविष्यवक्ते गे दर्शणो दे आया। हाग्गैये ये जरूब्बाबेल ओर यहोशूए खे दित्तेया। जरूब्बाबेल यहूदा प्रदेशो रा राज्यपाल ओर शालतीएलो रा पाऊ था। यहोशू बड़ा पुरोईत ओर यहोसादाको रा पाऊ था। ये सन्देश फारसो रे राजा दारा रे राजो रे दूजे सालो रे छठे मीन्ने रे पईले दिने आया। हाग्गैये जो बोलेया से ईंयाँ ए, <verse eid="HAG 1:1" /><verse number="2" style="v" sid="HAG 1:2" />सेना रा यहोवा ईंयाँ बोलोआ, “यो लोक बोलोए कि परमेशरो रे मन्दरो खे बनाणे रा बखत नि आई रा” <verse eid="HAG 1:2" /><verse number="3" style="v" sid="HAG 1:3" />तेबे यहोवे रा ये वचन हाग्गै भविष्यबक्ते रे जरीये पऊँछेया: <verse eid="HAG 1:3" /><verse number="4" style="v" sid="HAG 1:4" />तेबे तुसा रा बड़े ओर बांके कअरो दे रणा बी सई नि आ, जेबे कि मेरा ये मन्दर टूटेया-फूटेया दा पड़ी रा ए, <verse eid="HAG 1:4" /><verse number="5" style="v" sid="HAG 1:5" />इजी री खातर सेना रा यहोवा ईंयाँ बोलोआ, “जो कुछ बीतणे लगी रा तीजी रे बारे दे सोचो, <verse eid="HAG 1:5" /><verse number="6" style="v" sid="HAG 1:6" />तुसे बाया तो बऊत, पर बाडेया थोड़ा जा, तुसे खाओ तो आए, पर पेट नि फरदा, तुसे पियो तो आए, पर त्याय नि मिटदी, तुसे टाल्ले पईनोए, पर गर्म नि ऊँदे ओर तुसा री मईणता री कमाई एड़ी राची जाओई मानो तुसे से छेदा वाल़िया थैलिया दे पाई राखी ओ।”<verse eid="HAG 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HAG 1:7" />सेना रा यहोवा तुसा खे ईंयाँ बोलोआ, “जो कुछ बीतणे लगी रा तीजी रे बारे दे सोचो, <verse eid="HAG 1:7" /><verse number="8" style="v" sid="HAG 1:8" />पाह्ड़ो पाँदे चढ़ी जाओ ओर लकड़ी ली आओ ओर एस मन्दरो खे बणाओ ओर आऊँ तेसखे देखी की खुश ऊणा ओर मेरी महिमा ऊणी” परमेशरो रा येई वचन ए। <verse eid="HAG 1:8" /><verse number="9" style="v" sid="HAG 1:9" />तुसे बऊत फसला री उम्मीद राखी, पर देखो, थोड़ी जी ए ओर जेबे तुसे तिजी खे कअरे ल्याये, तेबे मैं से उडाई ती। सेना रे यहोवे री ये बाणी ए, एड़ा कऊँ ऊआ? क्या इजी खे नि मेरा मन्दर उजाड़ पड़ी रा, पर तुसा सबी लोका खे आपणे-आपणे कअरो री पड़ी री ए। <verse eid="HAG 1:9" /><verse number="10" style="v" sid="HAG 1:10" />इजी बजा ते सर्गो ते बर्खा ऊणा ओर तरतिया दे नज्ज उगणा दोनो बन्द ए। <verse eid="HAG 1:10" /><verse number="11" style="v" sid="HAG 1:11" />मैं डोरूआ ओर पाह्ड़ा पाँदे बर्खा ना ऊणे री आज्ञा देई राखी। फेर जमीना दे नज्ज नि जम्मी सकेया। ताजा अंगूरा रा रस बनाणे खे अंगूर नि थे। डाल़ा पाँदे तेल बनाणे खे जैतून नि थे। लोका ओर डांगरा खे नुकशाण सईन करना पड़ेया। तुसा री सारी मईणत बेकार ऊईगी।<verse eid="HAG 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HAG 1:12" />तेबे शालतीएलो रे पाऊ जरूब्बाबेल ओर यहोसादाको रे पाऊ यहोशू बड़े पुरोईते सब बचे रे लोका समेत आपणे परमेशर यहोवे री आज्ञा मानी ओर जो वचन तिना रे परमेशर यहोवे तिना खे बोलणे खे हाग्गै भविष्यबक्ता पेजेया था, तिने से मानी ला ओर लोके परमेशरो रा डर मानेया। <verse eid="HAG 1:12" /><verse number="13" style="v" sid="HAG 1:13" />तेबे परमेशरो रे दूत हाग्गै परमेशरो ते आज्ञा लई की तिना खे बोलेया, “परमेशर ईंयाँ बोलोआ कि आऊँ तुसा साथे ए।” <verse eid="HAG 1:13" /><verse number="14" style="v" sid="HAG 1:14" />इजी री खातर यहोवे शालतीएलो रे पाऊ जरूब्बाबेल जो यहूदा रा राज्यपाल था, ओर यहोसादाको रे पाऊ बड़ा पुरोईत यहोशूए रा मन उभारेया। यहोवे सब बचे रे लोका रे मन बी तिना री मताद करने खे उभारे। तेबे सबी यहोवे रे मन्दरो दे काम करना शुरू कित्तेया जो सबी पाँदे राज करोआ। से तिना रा परमेशर ए। <verse eid="HAG 1:14" /><verse number="15" style="v" sid="HAG 1:15" />ये राजा दारा रे दूजे सालो रे छठे मीन्ने रे चौबिये दिने ऊआ।<verse eid="HAG 1:15" /></para>
  <chapter eid="HAG 1" />
  <chapter number="2" style="c" sid="HAG 2" />
  <para style="s">परमेशरो रे मन्दरो री आऊणे वाल़ी महिमा</para>
  <para style="p">
    <verse number="1" style="v" sid="HAG 2:1" />दारा राजे रे दूजे सालो रे सातवे मीन्ने रे इक्खिये दिने यहोवे रा वचन हाग्गै भविष्यबक्ते रे जरीये आया, <verse eid="HAG 2:1" /><verse number="2" style="v" sid="HAG 2:2" />“यहूदा रे राज्यपाल ओर शालतीएलो रा पाऊ जरूब्बाबेल ओर यहोसादाक रे पाऊ यहोशू बड़े पुरोईतो ते बी गल्ल कर, ओर मेरे सबी लोका ते जो एबुए तक जिऊँदे बची गे दे ए, गल्ला कर। तिना खे पूछ, <verse eid="HAG 2:2" /><verse number="3" style="v" sid="HAG 2:3" />तुसा बीचा ते कुणे, जिने एस मन्दरो री सुन्दरता देखी थी? एबे तुसे इजी खे केड़ी दशा दे देखोए? क्या ये सच्च नि ए कि ये मन्दर तेस पईलके प्रतापो वाल़े मन्दरो री तुलना दे बिलकुल पनि ए।” <verse eid="HAG 2:3" /><verse number="4" style="v" sid="HAG 2:4" />पर एबे, जरूब्बाबेल, तूँ मजबूत ओर ईम्मती बण! ओ यहोसादाको रे पाऊ बड़ा पुरोईत यहोशू, ओर तुसे सब लोक जो एती यहूदा प्रदेशो दे रओए, मजबूत ओर ईम्मती बणो! एबे काम शुरू करो, कऊँकि आऊँ तुसा री मताद करने खे तुसा साथे आ। आऊँ सर्वशक्तिमान यहोवा, तुसा ते एई बोलूँआ। <verse eid="HAG 2:4" /><verse number="5" style="v" sid="HAG 2:5" />तुसा रे मिस्रो ते निकल़ने रे बखते जो वाचा मैं तुसा साथे बानी थी, तेसा ई वाचा रे मुताबिक मेरा आत्मा तुसा बीचे बणी रा, इजी री खातर तुसे नि डरो।<verse eid="HAG 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HAG 2:6" />कऊँकि सेना रा यहोवा ईंयाँ बोलोआ, “मां फेर सर्ग ओर तरती ईलाई देणे। मां समुद्र ओर सूकी तरती बी ईलाई देणे। <verse eid="HAG 2:6" /><verse number="7" style="v" sid="HAG 2:7" />मां सारे देश डराणे ओर सारी दूजी जातिया रे लोक कीमती चीजा लई की आऊणे ओर मां ये मन्दर आपणे तेजो साथे परी देणा,” सेना रे यहोवे री येई बाणी ए। <verse eid="HAG 2:7" /><verse number="8" style="v" sid="HAG 2:8" />चाँदी ओर सूईना मेरे ए, सेना रे परमेशरो री येई बाणी ए। <verse eid="HAG 2:8" /><verse number="9" style="v" sid="HAG 2:9" />एस मन्दरो री जो महिमा एबे ऊणी से पईलकी महिमा ते बड़ी ऊणी, सेना रे परमेशरो री येई बाणी ए ओर मां एसा जगा दे शान्ति देणी, सेना रे यहोवे री येई बाणी ए।<verse eid="HAG 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HAG 2:10" />ये राजा दारा रे राज्य रे दूजे सालो रे नऊए मीन्ने रे चौबिये दिने ऊआ। तेस दिने यहोवे आपणी बाणी हाग्गै भविष्यबक्ते खे बताई, <verse eid="HAG 2:10" /><verse number="11" style="v" sid="HAG 2:11" />“सेना रा यहोवा ईंयाँ बोलोआ कि पुरोईता ते एसा गल्ला रा बिधान पूछ, <verse eid="HAG 2:11" /><verse number="12" style="v" sid="HAG 2:12" />जे कोई आपणे टाल्लेया रे गोदड़ूए दे पवित्र मास बानी की राखो, जो मास बलिया रा इस्सा ए, इजी री खातर ए पवित्र ए। पर तेस ई गोदड़ूए ते रोटी, खाणे री चीज, अंगूरा रा रस, तेल या कोई बी खाणे री चीज छूँओ, तो क्या से रोटी पवित्र ठईरनी?” पुरोईते ज्वाब दित्तेया, “ना।” <verse eid="HAG 2:12" /><verse number="13" style="v" sid="HAG 2:13" />तेबे हाग्गै पूछेया, “अगर कोई माणूं लाशा खे छुँईं की अशुद्ध ऊई जाओ, ओर से इना बीचा ते कोई बी चीज छूँओ, तो क्या से अशुद्ध ठईरनी?” पुरोईते ज्वाब दित्तेया, “आ, अशुद्ध ठईरनी।” <verse eid="HAG 2:13" /><verse number="14" style="v" sid="HAG 2:14" />फेर हाग्गै तिना खे बोलेया, “परमेशर ईंयाँ बोलोआ कि मेरी नजरा दे ये प्रजा ओर ये जाति तेड़ी ईए ओर इना रे सारे काम बी तेड़े ईए ओर जो कुछ सेयो तेती चढ़ाओए, से बी अशुद्ध ए।”<verse eid="HAG 2:14" /></para>
  <para style="s">प्रतिज्ञा कित्ती री आशीष</para>
  <para style="p">
    <verse number="15" style="v" sid="HAG 2:15" />एबे सोच-बिचार करो कि आजो ते पईले, मतलब जेबे यहोवे रे मन्दरो खे बनाणे रा काम शुरू नि करी राखेया था, <verse eid="HAG 2:15" /><verse number="16" style="v" sid="HAG 2:16" />तिना दिना दे, तुसा खे आपणे डोरूआ ते बी बोरिया नज्जो रिया मिलणे री उम्मीद थी। पर तुसा खे सिर्फ दस बोरिया ई मिलिया। तुसा खे आपणे अंगूरा ते पंजा पांडे अंगूरा रे रसो रे मिलणे री उम्मीद थी, पर तुसा खे सिर्फ अंगूरा रे रसो रे बी पांडे ई मिले। <verse eid="HAG 2:16" /><verse number="17" style="v" sid="HAG 2:17" />तुसे तिना सबी चीजा खे बनाणे दे बऊत मईणत करी राखी। पर मैं से पाल़े, काई ओर ओल़ेया की नाश करिती। पर तुसे फेर बी मांगे वापस नि आए, परमेशरो री येई बाणी ए। <verse eid="HAG 2:17" /><verse number="18" style="v" sid="HAG 2:18" />एबे सोच-बिचार करो कि आजो ते पईले, मतलब जेस दिने परमेशरो रे नवें मन्दरो री निऊँ राखी, तेस दिनो ते लई की नऊए मीन्ने रे एस चौबिये दिनो तक क्या दशा थी? इजी रे बारे दे सोच-बिचार करो। <verse eid="HAG 2:18" /><verse number="19" style="v" sid="HAG 2:19" />क्या एबुए तक बिऊ खल्याणो दे ए? एबुए तक अंगूरा री बेल, दाऊगल़े, अनार ओर जैतूनो रे डाल़ नि फल़े, पर आजके दिनो ते आऊँ तुसा खे आशीष देंदा रऊँगा। <verse eid="HAG 2:19" /><verse number="20" style="v" sid="HAG 2:20" />तेस मीन्ने रेई चौबिये दिने दूजी बार परमेशरो रा वचन हाग्गै गे पऊँचेया, <verse eid="HAG 2:20" /><verse number="21" style="v" sid="HAG 2:21" />“यहूदा रे राज्यपाल जरूब्बाबेलो खे ईंयाँ बोल कि मां सर्ग ओर तरती दोनो डराणे। <verse eid="HAG 2:21" /><verse number="22" style="v" sid="HAG 2:22" />मां राज्य-राज्य री गद्दी उल्टी देणी, मां दूजी जातिया रे राज्य री तागत नाश करनी ओर रथ तिना रे सवारा समेत मूँदे करी देणे ओर कोड़ेया समेत सवार एकी-दूजे री तलवारी साथे नाश ऊई जाणे। <verse eid="HAG 2:22" /><verse number="23" style="v" sid="HAG 2:23" />सेना रे यहोवे री ये बाणी ए, तेस दिने ओ शालतीएलो रे पाऊ मेरे दास जरूब्बाबेल, तूँ मेरी तेसा छापा जेड़े ऊणा जेते पाँदे मेरी शाही नशाणी ए, यहोवे री ये बाणी ए। कऊँकि मैं तूँ चूणी राखेया ए, सेना रे यहोवे री ये बाणी ए।”<verse eid="HAG 2:23" /></para>
  <chapter eid="HAG 2" />
</usx>