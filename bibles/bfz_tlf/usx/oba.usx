<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id" />
  <para style="h">ओबद्याह</para>
  <para style="toc1">ओबद्याह नबीए रे जरिये लिखी री कताब</para>
  <para style="toc2">ओबद्याह</para>
  <para style="toc3">ओब.</para>
  <para style="mt">ओबद्याह</para>
  <para style="mt2">ओबद्याह नबीए रे जरिये लिखी री कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">ई. पू. 586 दे यरूशलेमो रे नाशो ते बाद केसी बखतो दे ये छोटी जी कताब लिखी थी। तेस बखते यहूदा रा पुराणा दुश्मण, एदोम जो दक्खण-पूर्बा दे बसी रा था, तिने यरूशलेमो रे नाशो पाँदे सिर्फ खुशी ई नि मनाई, बल्कि यहूदा री दुर्दशा रा फाईदा चकी की शईर लूटेया ओर अमला करने वाल़ेया री मताद बी कित्ती। ओबद्याह नबीए ये भविष्यबाणी कित्ती कि इस्राएलो रे दूजे दुश्मण राज्या साथे ई एदोमो खे बी सजा ओर आरा रा मूँ देखणा पड़ना।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">एदोमो खे सजा <char style="ior"><ref loc="OBA 1:1-14">1:1-14</ref></char></para>
  <para style="io1">यहोवे रा दिन <char style="ior"><ref loc="OBA 1:15-21">1:15-21</ref></char></para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="s">यहोवे रा एदोमिया खे सजा देणा</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />ये से दर्शण ए जो परमेशर यहोवा एदोम देशो रे बारे दे ओबद्याह खे दखाया था। एदोम देशो रे न्याय री घोषणा आसे यहोवे री तरफा ते एक सन्देश सुणेया ए कि देशा गे एक दूत पेजी राखेया ए, ये बोलणे खे, “सब लोक त्यार ऊई जाओ! आओ आसे आपणियां सेना खे कट्ठा करूँए ओर एदोम देशो पाँदे अमला करिए। <verse eid="OBA 1:1" /><verse number="2" style="v" sid="OBA 1:2" />उठो, आसे तेस साथे लड़ने खे चलूँए!” मां तूँ जातिया बीचे कमजोर करी देणा, तिना तूँ बऊत तुच्छ समजणा। <verse eid="OBA 1:2" /><verse number="3" style="v" sid="OBA 1:3" />तेरे कमण्डे ताखे तोखा देई राखेया ए। तेरी राजधानी कठोर चट्टानी रा कीला ए; तेरा कअर ऊच्चे पाह्ड़ो पाँदे ए, ओर तूँ आपणे आपू ते बोलेया, “माखे कुण थाले ल्याई सकोआ, <verse eid="OBA 1:3" /><verse number="4" style="v" sid="OBA 1:4" />पर चाए तूँ उकाबो जेड़े ऊच्चा उडे ओर तारेया बीचे आपणा कोअला बणाए, तेबे बी मां तूँ तेथा ते थाले सेटणा,” यहोवे री येई बाणी ए।<verse eid="OBA 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="OBA 1:5" />जे चोर तेरे कअरो दे कूसदे, या डाकू राथियो खे डाका पाँदे, तो सेयो इतणा ई लुटदे जितणा तिना खे काफी ऊँदा! अगर अंगूरा खे तोड़ने वाल़े तांगे आऊँदे तो तिना पक्का कुछ छाडी देणे थे, <verse eid="OBA 1:5" /><verse number="6" style="v" sid="OBA 1:6" />एसावो रे लोको, तुसा ते सब कुछ छुड़ाई लणा। तुसारे लूके दे खजाने चोरी ऊई जाणे। <verse eid="OBA 1:6" /><verse number="7" style="v" sid="OBA 1:7" />तेरे सारे साथी तेरे खलाफ ऊई जाणे। तिना तूँ तेरिया जमीना ते बारे करी देणा। तिना ताखे तोखा देणे ओर नाश करने री साजिश करदे ऊए ताखे शान्तिया रा वादा करना। तेरे परोसे वाल़ेया दोस्ता तेरिया तँईं जाल़ बछाणा, तिजी दे कुछ बी समज नि ए। <verse eid="OBA 1:7" /><verse number="8" style="v" sid="OBA 1:8" />आऊँ यहोवा ये बोलूँआ कि जेबे मां एदोम नाश करना, तो मां तिना लोका खे सजा देणी जो एसावो री चट्टानी पाँदे रओए ओर सोचोए कि सेयो अक्लमंद ए।<verse eid="OBA 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="OBA 1:9" />ओ तेमान शईर, तेरे शूरवीर डरी जाणे ओर ईंयाँ एसावो रे पाह्ड़ो पाँदला हर एक मर्द कायी की नाश ऊई जाणा। <verse eid="OBA 1:9" /><verse number="10" style="v" sid="OBA 1:10" />ओ एसाव, तैं आपणे रिश्तेदारा साथे जो याकूबो रे वंशो रे ए, रोषे ऊई की बुरा बर्ताओ करी राखेया ए। <verse eid="OBA 1:10" /><verse number="11" style="v" sid="OBA 1:11" />पराये लोक यरूशलेमो रे दरवाजेया दे कूसी की आए। तिने ये देखणे खे पर्चिया पाईया कि केसखे क्या मिलणा। पाखले लोक एसरी तअन-दौलत लूटी की लईगे। जेबे एड़ा ऊआ, तेबे तुसे तेथी खड़े दे रये ओर कुछ नि कित्तेया। तूँ बी तिना बीचा ते एक था। <verse eid="OBA 1:11" /><verse number="12" style="v" sid="OBA 1:12" />से तेरे रिश्तेदारा खे मुसीबता रा बखत था। इजी री खातर ताखे तिना साथे जो ऊआ, तीजी ते खुश नि ऊणा चाईयो था। यहूदा रे लोक नाश ऊई जाणे। इजी री खातर ताखे इजी पाँदे खुश नि ऊणा चाईयो था। जेबे सेयो मुसीबता दे थे, तो ताखे तिना पाँदे इतणा आसणा नि चाईयो था। <verse eid="OBA 1:12" /><verse number="13" style="v" sid="OBA 1:13" />जेबे इस्राएल एड़िया मुसीबता दे पड़ी रा था, तेबे ताखे तेसरी जमीन नि लुटणी चाईयो थी। जेबे इस्राएल एड़िया मुसीबता दे पड़ी रा था, तेबे ताखे तेसरे नाशो पाँदे खुश नि ऊणा चाईयो था। जेब इस्राएल एड़िया मुसीबता दे पड़ी रा था, तेबे ताखे तेसरी तअन-दौलत नि लुटणी चाईयो थी। <verse eid="OBA 1:13" /><verse number="14" style="v" sid="OBA 1:14" />जेबे सेयो आपणे प्राण बचाई की नठणे लगी रे थे तेबे ताखे सड़का दे खड़े ऊई की नठणे वाल़े काणे नि चाईयो थे। ताखे मुसीबता रे दिने आपणे बचे दे पाईया खे दुश्मणा रे आथो दे नि देणा चाईयो था। <verse eid="OBA 1:14" /><verse number="15" style="v" sid="OBA 1:15" />कऊँकि सारी दूजी जातिया पाँदे परमेशरो रे दिनो रा आऊणा नेड़े ए, ओर एसाव, जेड़ा तैं आपणे पाईया साथे करी राखेया, तेड़ा ई तां साथे कित्तेया जाणा। तेरे पाप तां पाँदे ई पड़ने।<verse eid="OBA 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="OBA 1:16" />जेड़ा तैं मेरे पवित्र पाह्ड़ो पाँदे रोषो रा ग्लास पिया, तिंयाँ ई दूजी जातिया लगातार पींदे रणा, बल्कि तिना सुड़की-सुड़की की पीणा ओर एड़िया ऊई जाणिया जेड़िया कदी ऊईया ई नि। <verse eid="OBA 1:16" /><verse number="17" style="v" sid="OBA 1:17" />पर तेस बखते सिय्योनो रे पाह्ड़ो पाँदे बचे रे लोक रणे ओर से पवित्र जगा ठईरनी ओर याकूबो रा कराना आपणे निज इस्से रा अधिकारी ऊणा। <verse eid="OBA 1:17" /><verse number="18" style="v" sid="OBA 1:18" />तेबे याकूबो रा कराना आग, यूसुफो रा कराना लौ ओर एसावो रा कराना खूँडी बणना ओर तिना तिदे आग लगाई की से फूकी देणा ओर एसावो रे कराने रा कोई नि बचणा, कऊँकि परमेशरे ई एड़ा बोली राखेया। <verse eid="OBA 1:18" /><verse number="19" style="v" sid="OBA 1:19" />नेगेब इलाके रे लोका एसावो रे पाह्ड़ो पाँदे कब्जा करना; शफेलाह इलाके रे लोका पलिश्तिया रे देशो पाँदे कब्जा करना। तिना एप्रैम प्रदेश ओर सामरिया प्रदेशो पाँदे बी कब्जा करना। ओर बिन्यामीन कुलो गिलादो पाँदे कब्जा करना। <verse eid="OBA 1:19" /><verse number="20" style="v" sid="OBA 1:20" />कुछ इस्राएलिया खे आपणे कअर छाडणे खे मजबूर कित्तेया। सेयो कनान देशो दे वापस आऊणे ओर सारफत शईरो तक आपणा कब्जा करना। यरूशलेमो ते कुछ लोका खे सपारद शईरो खे लईगे। सेयो वापस आऊणे ओर नेगेब रेगिस्तानो रे शईरो पाँदे कब्जा करना। <verse eid="OBA 1:20" /><verse number="21" style="v" sid="OBA 1:21" />जो लोक बचाई राखे सेयो सिय्योन पाह्ड़ो पाँदे चढ़ने, एसावो रे पाह्ड़ो पाँदे राज करना; ओर राज्य यहोवे रा ई ऊई जाणा।<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>