<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id" />
  <para style="h">1 इतिआस</para>
  <para style="toc1">इतिआसो री पईली कताब</para>
  <para style="toc2">1 इतिआस</para>
  <para style="toc3">1 इति.</para>
  <para style="mt">1 इतिआस</para>
  <para style="mt2">इतिआसो री पईली कताब</para>
  <para style="ip">इतिआसो री पईली कताबा दे खास करी की सेमुएल ओर राजेया रिया कताबा दे लिखिया दिया कटणा रा दुबारा जिक्र ए, पर ये जिक्र एक लग नजरा ते आ। इतिआसो रिया कताबा दे इस्राएली राजेया रे इतिआसो रा जिक्र दो खास बजा ते करी राखेया :</para>
  <para style="ili">(1) ये बताणे खे कि इस्राएल ओर यहूदा रे राजेया पाँदे आई री मुसीबता रे बावजूद परमेशर इस्राएली जातिया ते कित्ती री आपणी प्रतिज्ञा खे पूरा करने लगी रा था, ओर आपणे लोका रिया तँईं आपणिया योजना खे यहूदा राज दे रणे वाल़े लोका रे जरीये पूरा करने लगी रा था। एते परोसे पाँदे लिखणे वाल़ा दाऊद ओर सुलैमानो री महान उपलब्धिया खे, यहोशापात, हिजकिय्याह ओर योशिय्याह रे सुदारा खे, ओर तिना लोका खे देखोआ जो परमेशरो रे प्रति परोसे जोगे रये थे।</para>
  <para style="ili">(2) ये बताणे रिया तँईं कि यरूशलेम शईरो रे मन्दरो दे परमेशरो री आराधना किंयाँ शुरू ऊई, ओर खास करी की ये कि पुरोईता ओर लेविया रा बिधान केड़ा था, जिना रे जरीये आराधना रा काम कित्तेया जाओ था।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">वंशावलिया ओर सूचिया <char style="ior"><ref loc="1CH 1:1-9:44">1:1-9:44</ref></char></para>
  <para style="io1">शाऊलो रा मरना <char style="ior"><ref loc="1CH 10:1-14">10:1-14</ref></char></para>
  <para style="io1">दाऊदो रा राज्य <char style="ior"><ref loc="1CH 11:1-29:30">11:1-29:30</ref></char></para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s">आदमो ते अब्राहमो तक री वंशावली</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1" />आदम शेतो रा बाओ था, ओर शेतो रे पाऊ एनोश; <verse eid="1CH 1:1" /><verse number="2" style="v" sid="1CH 1:2" />तेसरे केनान, केनानो रे महललेल, महललेलो रे येरेद; <verse eid="1CH 1:2" /><verse number="3" style="v" sid="1CH 1:3" />येरेदो रे हनोक, हनोको रे मतूशेलह, मतूशेलह रे लेमेक; <verse eid="1CH 1:3" /><verse number="4" style="v" sid="1CH 1:4" />लेमेको रे नूह, नूह रे शेम, हाम ओर येपेत ऊए।<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">लूक. 3:36-38</char></note> <verse eid="1CH 1:4" /><verse number="5" style="v" sid="1CH 1:5" />येपेतो रे पाऊ गोमेर, मागोग, मादै, यावान, तूबल, मेशेक ओर तीरास ऊए। <verse eid="1CH 1:5" /><verse number="6" style="v" sid="1CH 1:6" />गोमेरो रे पाऊ अश्कनज, दीपत ओर तोगर्मा ऊए। <verse eid="1CH 1:6" /><verse number="7" style="v" sid="1CH 1:7" />यावानो रे पाऊ एलीशा, तर्शीश ओर कित्ती ओर रोदानी लोक थे। <verse eid="1CH 1:7" /><verse number="8" style="v" sid="1CH 1:8" />हामो रे पाऊ कूश, मिस्रम, पूत ओर कनान थे। <verse eid="1CH 1:8" /><verse number="9" style="v" sid="1CH 1:9" />कूशो रे पाऊ सबा, हवीला, सबता, रामाह ओर सब्तका थे। ओर रामाह रे पाऊ शेबा ओर ददान थे। <verse eid="1CH 1:9" /><verse number="10" style="v" sid="1CH 1:10" />ओर कूशो रे निम्रोद ऊआ; तरतिया पाँदे पईला वीर सेई ऊआ। <verse eid="1CH 1:10" /><verse number="11" style="v" sid="1CH 1:11" />ओर मिस्रमो रे लूदी, अनामी, लहाबी, नप्तूही, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />पत्रूसी, कसलूही (जिना ते पलिश्ती ऊए) ओर कप्तोरी ऊए। <verse eid="1CH 1:12" /><verse number="13" style="v" sid="1CH 1:13" />कनानो ते तेसरा जेठा सिदोन ओर हित्त, <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />ओर यबूसी, एमोरी, गिर्गाशी, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />हिब्बी, अर्की, सीनी, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />अर्वदी, समारी ओर हमाती पैदा ऊए। <verse eid="1CH 1:16" /><verse number="17" style="v" sid="1CH 1:17" />शेमो रे पाऊ एलाम, अश्शूर, अर्पक्षद, लूद, अराम, ऊस, हूल, गेतेर ओर मेशेक थे। <verse eid="1CH 1:17" /><verse number="18" style="v" sid="1CH 1:18" />ओर अर्पक्षदो रा पाऊ शेलह ओर शेलह रा पाऊ एबेर था। <verse eid="1CH 1:18" /><verse number="19" style="v" sid="1CH 1:19" />एबेरो रे दो पाऊ ऊए: एकी रा नाओं पेलेग इजी बजा ते राखेया कि तेसरे दिना रे तरती बांडी थी ओर तेसरे पाईए रा नाओं योक्तान था। <verse eid="1CH 1:19" /><verse number="20" style="v" sid="1CH 1:20" />ओर योक्तानो रे अल्मोदाद, शेलेप, हसर्मावेत, येरह, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />हदोराम, ऊजाल, दिक्ला, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />एबाल, अबीमाएल, शेबा, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />ओपीर, हवीला ओर योबाब पैदा ऊए; यो सारे ई योक्तानो रे पाऊ थे। <verse eid="1CH 1:23" /><verse number="24" style="v" sid="1CH 1:24" />शेम, अर्पक्षद, शेलह, <verse eid="1CH 1:24" /><verse number="25" style="v" sid="1CH 1:25" />एबेर, पेलेग, रू, <verse eid="1CH 1:25" /><verse number="26" style="v" sid="1CH 1:26" />सरूग, नाहोर, तेरह, <verse eid="1CH 1:26" /><verse number="27" style="v" sid="1CH 1:27" />अब्राम, तेसखे ई अब्राहम बी बोलोए। <verse eid="1CH 1:27" /><verse number="28" style="v" sid="1CH 1:28" />अब्राहमो रे पाऊ इसहाक ओर इश्माएल थे।<verse eid="1CH 1:28" /></para>
  <para style="s">हाजिरा री ल्वाद</para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 1:29" />इना रा खानदान ये आ। इश्माएलो रा जेठा पाऊ नबायोत, तेबे केदार, अदबएल, मिबसाम, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />मिश्मा, दूमा, मस्सा, हदद, तेमा, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />यतूर, नापीश, केदमा। यो इश्माएलो रे पाऊ थे।<verse eid="1CH 1:31" /></para>
  <para style="s">कतूरा री ल्वाद</para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 1:32" />तेबे कतूरा जो अब्राहमो री रखैल थी, तेसा रे यो पाऊ पैदा ऊए, मतलब तेसा ते जिम्रान, योक्षान, मदान, मिद्यान, यिशबाक ओर शूह। योक्षानो रे पाऊ शेबा ओर ददान थे। <verse eid="1CH 1:32" /><verse number="33" style="v" sid="1CH 1:33" />ओर मिद्यानो रे पाऊ एपा, एपेर, हनोक, अबीदा ओर एल्दा थे। ये सब कतूरा रे वंशो रे ए।<verse eid="1CH 1:33" /></para>
  <para style="s">सारा री ल्वाद</para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 1:34" />अब्राहमो ते इसहाक पैदा ऊआ। इसहाको रे दो पाऊ एसाव ओर इस्राएल ऊए।<note caller="+" style="f"><char style="fr" closed="false">1:34 </char><char style="ft" closed="false">मत्ती 1:2</char></note><verse eid="1CH 1:34" /></para>
  <para style="s">एसावो रा खानदान</para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 1:35" />एसावो रे पाऊ एलीपज, रूएल, यूश, यालाम ओर कोरह थे। <verse eid="1CH 1:35" /><verse number="36" style="v" sid="1CH 1:36" />एलीपजो रे पाऊ तेमान, ओमार, सपी, गाताम, कनज, तिम्ना ओर अमालेक थे। <verse eid="1CH 1:36" /><verse number="37" style="v" sid="1CH 1:37" />रूएलो रे पाऊ नहत, जेरह, शम्मा ओर मिज्जा थे।<verse eid="1CH 1:37" /></para>
  <para style="s">सेईरो रा खानदान</para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 1:38" />तेबे सेईरो रे पाऊ लोतान, शोबाल, सिबोन, अना, दीशोन, एसेर ओर दीशान थे। <verse eid="1CH 1:38" /><verse number="39" style="v" sid="1CH 1:39" />ओर लोतानो रे पाऊ होरी ओर होमाम थे, ओर लोतानो री बईण तिम्ना थी। <verse eid="1CH 1:39" /><verse number="40" style="v" sid="1CH 1:40" />शोबालो रे पाऊ अल्यान, मानहत, एबाल, शपी ओर ओनाम थे। ओर सिबोनो रे पाऊ अया ओर अना। <verse eid="1CH 1:40" /><verse number="41" style="v" sid="1CH 1:41" />अना रा पाऊ दीशोन। ओर दीशोनो रे पाऊ हम्रान, एशबान, यित्रान ओर करान थे। <verse eid="1CH 1:41" /><verse number="42" style="v" sid="1CH 1:42" />एसेरो रे पाऊ बिल्हान, जावान ओर याकान थे। ओर दीशानो रे पाऊ ऊस ओर अरान थे।<verse eid="1CH 1:42" /></para>
  <para style="s">एदोमिया रे राजा</para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 1:43" />जेबे किने बी राजे इस्राएलो पाँदे राज नि करी राखेया था, तेबे एदोमो रे इलाके दे यो राजा ऊए, मतलब बोरो रा पाऊ बेला ओर तेसरी राजधानिया रा नाओं दिन्हाबा शईर था। <verse eid="1CH 1:43" /><verse number="44" style="v" sid="1CH 1:44" />बेला रे मरने ते बाद, बोस्राई शईरो रा जेरह रा पाऊ योबाब तेसरी जगा पाँदे राजा बणेया। <verse eid="1CH 1:44" /><verse number="45" style="v" sid="1CH 1:45" />ओर योबाबो रे मरने ते बाद, तेमानिया रे देशो रा हूशाम तेसरी जगा पाँदे राजा बणेया। <verse eid="1CH 1:45" /><verse number="46" style="v" sid="1CH 1:46" />फेर हूशामो रे मरने ते बाद बददो रा पाऊ हदद तेसरी जगा पाँदे राजा बणेया, ये सेईए, जिने मिद्यानी मोआबो रे देशो दे काये ओर तेसरी राजधानिया रा नाओं अबीत शईर था। <verse eid="1CH 1:46" /><verse number="47" style="v" sid="1CH 1:47" />ओर हददो रे मरने ते बाद, मस्रेकाई शईरो रा सम्ला तेसरी जगा पाँदे राजा बणेया। <verse eid="1CH 1:47" /><verse number="48" style="v" sid="1CH 1:48" />तेबे सम्ला रे मरने ते बाद शाऊल, जो फरात नदिया रे कनारे पाँदले रहोबोत शईरो रा था, से तेसरी जगा पाँदे राजा बणेया। <verse eid="1CH 1:48" /><verse number="49" style="v" sid="1CH 1:49" />ओर शाऊलो रे मरने ते बाद अकबोरो रा पाऊ बाल्हानान तेसरी जगा पाँदे राजा बणेया। <verse eid="1CH 1:49" /><verse number="50" style="v" sid="1CH 1:50" />ओर बाल्हानानो रे मरने ते बाद हदद तेसरी जगा पाँदे राजा बणेया ओर तेसरी राजधानिया रा नाओं पाऊ शईर था, तेसरी लाड़िया रा नाओं महेतबेल था, जो मेज़ाहाबो री दोईती ओर मत्रेदो री बेटी थी। <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />तेबे राजा हदद मरी गा। फेर एदोमो रे परदान यो थे: मतलब परदान तिम्ना, परदान अल्वा, परदान यतेत, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />परदान ओहोलीबामा, परदान एला, परदान पीनोन, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />परदान कनज, परदान तेमान, परदान मिबसार, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />परदान मग्दीएल ओर परदान ईराम। एदोमो रे यो परदान ऊए।<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 2:1" />याकूबो रे बारा पाऊ ऊए: मतलब रूबेन, शिमोन, लेवी, यहूदा, इस्साकार, जबूलून, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />दान, यूसुफ, बिन्यामीन, नप्ताली, गाद ओर आशेर।<verse eid="1CH 2:2" /></para>
  <para style="s">यहूदा ते दाऊदो तको रा खानदान</para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 2:3" />यहूदा रे जो पाऊ ऊए सेयो एर, ओनान ओर शेला, तेसरे यो तीनो पाऊ, शूआ नाओं री एकी कनानी जवाणसा री बेटिया ते पैदा ऊए। ओर यहूदा रा जेठा पाऊ एर, यहोवे री नजरा रे बुरा था, इजी बजा ते तिने से काई ता। <verse eid="1CH 2:3" /><verse number="4" style="v" sid="1CH 2:4" />यहूदा री बऊ तामारा ते पेरेस ओर जेरह ऊए। यहूदा रे कुल पाँज पाऊ ऊए। <verse eid="1CH 2:4" /><verse number="5" style="v" sid="1CH 2:5" />पेरेसो रे पाऊ हेस्रोन ओर हामूल ऊए। <verse eid="1CH 2:5" /><verse number="6" style="v" sid="1CH 2:6" />ओर जेरह रे पाऊ जिम्री, एतान, हेमान, कलकोल ओर दारा, सारे मिलाई की पाँज पाऊ ऊए। <verse eid="1CH 2:6" /><verse number="7" style="v" sid="1CH 2:7" />फेर कर्मीए रा पाऊ आकार ऊआ जिने परमेशरो खे चढ़ाई री चीजा ते विश्वासघात करी की इस्राएली लोका खे कष्ट देणे रा काम कित्तेया। <verse eid="1CH 2:7" /><verse number="8" style="v" sid="1CH 2:8" />ओर एतानो रा पाऊ अजर्याह था। <verse eid="1CH 2:8" /><verse number="9" style="v" sid="1CH 2:9" />हेस्रोनो रे जो तीन पाऊ ऊए सेयो यरहमेल, राम ओर कलूबै थे।<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">मत्ती 1:3</char></note> <verse eid="1CH 2:9" /><verse number="10" style="v" sid="1CH 2:10" />ओर रामो ते अम्मीनादाब ओर अम्मीनादाबो ते नहशोन ऊआ जो यहूदिया रा परदान बणेया। <verse eid="1CH 2:10" /><verse number="11" style="v" sid="1CH 2:11" />ओर नहशोनो ते सल्मा ओर सल्मा ते बोअज; <verse eid="1CH 2:11" /><verse number="12" style="v" sid="1CH 2:12" />ओर बोअज ते ओबेद ओर ओबेद ते यिशै ऊआ।<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">मत्ती 1:4,5</char></note> <verse eid="1CH 2:12" /><verse number="13" style="v" sid="1CH 2:13" />ओर यिशै ते तेसरा जेठा एलीआब ओर दूजा अबीनादाब, तीजा शिमा, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />चौथा नतनेल ओर पाँजुआ रद्दैं। <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />छठा, ओसेम ओर सातुआ दाऊद ऊआ।<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">लूक. 3:31-32</char></note> <verse eid="1CH 2:15" /><verse number="16" style="v" sid="1CH 2:16" />इना री बईणा सरूयाह ओर अबीगैल थिया। ओर सरूयाह रे पाऊ अबीशै, योआब ओर असाहेल यो तीन ऊए। <verse eid="1CH 2:16" /><verse number="17" style="v" sid="1CH 2:17" />ओर अबीगैला ते अमासा पैदा ऊआ ओर अमासा रा बाओ येतेर इश्माएली वंशो रा था।<verse eid="1CH 2:17" /></para>
  <para style="s">हेस्रोनो रा खानदान</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 2:18" />हेस्रोनो रे पाऊ कालेबो री अजूबा नाओं री एक जवाणसा ते ओर यरीओत ते पाऊ ऊए सेयो यो ए; मतलब येशेर, शोबाब ओर अर्दोन। <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" />जेबे अजूबा मरी गी, तेबे कालेबे एप्राता साथे ब्या करी ला ओर जेसा ते हूर पैदा ऊआ। <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" />ओर हूर ते ऊरी ओर ऊरी ते बसलेल पैदा ऊआ। <verse eid="1CH 2:20" /><verse number="21" style="v" sid="1CH 2:21" />इजी ते बाद हेस्रोन गिलाद रे बाओ माकीर री बेटिया गे गया, जो तिने तेबे ब्याई ली, जेबे से साठा साला रा था ओर तेसा ते सगूब पैदा ऊआ। <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" />ओर सगूब ते याईर जम्मेया, जेसरे गिलाद इलाके दे तेई शईर थे। <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" />ओर गशूर ओर अरामे याईरो री बस्तिया खे गाँवो समेत कनात शईर तेसते लई ला; यो सारे शईर मिलाई की साठ थे। यो सब गिलादो रे बाओ माकीरो रे पाऊ थे। <verse eid="1CH 2:23" /><verse number="24" style="v" sid="1CH 2:24" />ओर जेबे हेस्रोन शईरो रा कालेब एप्राता दे मरी गा, तेबे तेसरी अबिय्याह नाओं री जवाणसा ते अशहूर पैदा ऊआ, अशहूर तको रा बाओ ऊआ।<verse eid="1CH 2:24" /></para>
  <para style="s">यरहमेलो रा खानदान</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 2:25" />ओर हेस्रोनो रे जेठे पाऊ यरहमेलो रे यो पाऊ ऊए, मतलब राम जो तेसरा जेठा पाऊ था ओर बूना, ओरेन, ओसेम ओर अहिय्याह। <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />ओर यरहमेल री एक ओर लाड़ी थी, जेसा रा नाओं अतारा था; से ओनाम री माये थी। <verse eid="1CH 2:26" /><verse number="27" style="v" sid="1CH 2:27" />ओर यरहमेलो रे जेठे पाऊ रामो रे यो पाऊ थे मतलब मास, यामीन ओर एकेर। <verse eid="1CH 2:27" /><verse number="28" style="v" sid="1CH 2:28" />ओर ओनामो रे पाऊ शम्मै ओर यादा ऊए। ओर शम्मै रे पाऊ नादाब ओर अबीशूर थे। <verse eid="1CH 2:28" /><verse number="29" style="v" sid="1CH 2:29" />ओर अबीशूरो री लाड़िया रा नाओं अबीहैल था ओर तेसा ते अहबान ओर मोलीद पैदा ऊए। <verse eid="1CH 2:29" /><verse number="30" style="v" sid="1CH 2:30" />ओर नादाबो रे पाऊ सेलेद ओर अप्पैम ऊए; सेलेद तो बिना ल्वादा ते मरी गा। <verse eid="1CH 2:30" /><verse number="31" style="v" sid="1CH 2:31" />ओर अप्पैमो रा पाऊ यिशी ओर यिशीए रा पाऊ शेशान ओर शेशानो रा पाऊ अहलै था। <verse eid="1CH 2:31" /><verse number="32" style="v" sid="1CH 2:32" />फेर शम्मै रे पाई यादा रे पाऊ येतेर ओर योनातान ऊए; येतेर तो बिना ल्वादा ते मरी गा। <verse eid="1CH 2:32" /><verse number="33" style="v" sid="1CH 2:33" />योनातानो रे पाऊ पेलेत ओर जाजा; यरहमेलो रे पाऊ यो ऊए। <verse eid="1CH 2:33" /><verse number="34" style="v" sid="1CH 2:34" />शेशान रे पाऊ नि ऊआ, बस बेटिया ई ऊईया। शेशानो गे यर्हा नाओं रा एक मिस्री दास था। <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />ओर शेशाने तेस साथे आपणी बेटी यर्हा रा ब्या करी ता ओर तेसते अत्तै पैदा ऊआ। <verse eid="1CH 2:35" /><verse number="36" style="v" sid="1CH 2:36" />ओर अत्तै ते नातान, नातानो ते जाबाद, <verse eid="1CH 2:36" /><verse number="37" style="v" sid="1CH 2:37" />जाबादो ते एपलाल, एपलालो ते ओबेद, <verse eid="1CH 2:37" /><verse number="38" style="v" sid="1CH 2:38" />ओबेदो ते येहू, येहूए ते अजर्याह, <verse eid="1CH 2:38" /><verse number="39" style="v" sid="1CH 2:39" />अजर्याह ते हेलेस, हेलेसो ते एलासा, <verse eid="1CH 2:39" /><verse number="40" style="v" sid="1CH 2:40" />एलासा ते सिस्मै, सिस्मै ते शल्लूम, <verse eid="1CH 2:40" /><verse number="41" style="v" sid="1CH 2:41" />शल्लूमो ते यकम्याह ओर यकम्याह ते एलीशामा पैदा ऊए।<verse eid="1CH 2:41" /></para>
  <para style="s">कालेबो रे खानदान</para>
  <para style="p">
    <verse number="42" style="v" sid="1CH 2:42" />तेबे यरहमेलो रे छोटे पाई कालेबो रे यो पाऊ ऊए मतलब तेसरा जेठा पाऊ मेशा जो जीप रा बाओ था ओर मारेशा रा पाऊ हेब्रोन बी तेसरे ई कुलो रे ऊआ। <verse eid="1CH 2:42" /><verse number="43" style="v" sid="1CH 2:43" />ओर हेब्रोन रे पाऊ कोरह, तप्पूह, रेकेम ओर शेमा। <verse eid="1CH 2:43" /><verse number="44" style="v" sid="1CH 2:44" />ओर शेमा ते योर्काम रा बाओ रहम ओर रेकेम ते शम्मै पैदा ऊआ था। <verse eid="1CH 2:44" /><verse number="45" style="v" sid="1CH 2:45" />ओर शम्मै रा पाऊ माओन ऊआ ओर माओन बेतसूरो रा बाओ ऊआ। <verse eid="1CH 2:45" /><verse number="46" style="v" sid="1CH 2:46" />तेबे एपा जो कालेबो री रखैल थी, तेसा ते हारान, मोसा ओर गाजेज पैदा ऊए ओर हारान ते गाजेज पैदा ऊआ। <verse eid="1CH 2:46" /><verse number="47" style="v" sid="1CH 2:47" />तेबे याहदै रे पाऊ रेगेम, योताम, गेशान, पेलेत, एपा ओर शाप। <verse eid="1CH 2:47" /><verse number="48" style="v" sid="1CH 2:48" />ओर माका जो कालेब री रखैल थी, तेसा ते शेबेर ओर तिर्हाना पैदा ऊए। <verse eid="1CH 2:48" /><verse number="49" style="v" sid="1CH 2:49" />तेबे तेसते मदमन्ना रा बाओ शाप ओर मकबेना ओर गिबा रा बाओ शवा पैदा ऊए। ओर कालेबो री बेटी अकसा थी। <verse eid="1CH 2:49" /><verse number="50" style="v" sid="1CH 2:50" />कालेबो रे खानदानो दे यो ऊए। एप्राता रे जेठे पाऊ हूर रा पाऊ किर्यत्यारीम रा बाओ शोबाल, <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />बेतलेहम रा बाओ सल्मा ओर बेतगादेर रा बाओ हारेप। <verse eid="1CH 2:51" /><verse number="52" style="v" sid="1CH 2:52" />ओर किर्यत्यारीमो रे बाओ शोबालो रे कुलो दे हारोए आदे लोक मनुहोतो दे रणे वाल़े थे, <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />ओर किर्यत्यारीमो रे कुल मतलब येतेरी, पूती, शूमाती ओर मिश्राई ओर इना ते सोराई ओर एशताओली निकल़े। <verse eid="1CH 2:53" /><verse number="54" style="v" sid="1CH 2:54" />तेबे सल्मा रे कुलो दे बेतलेहम ओर नतोपाई, अत्रोतबेत्योआब ओर आदे मानहती, सोरी। <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />तेबे याबेस शईरो दे रणे वाल़े लिखणे वाल़े रे कुल, मतलब तिराती शिमाती ओर सूकाती ऊए। ये रेकाबो रे कराने रे मूलमर्द हम्मतो रे कुलो वाल़े केनी लोक ए।<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s">दाऊदो रा खानदान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />यो छे पाऊ दाऊदो ते हेब्रोन शईरो दे पैदा ऊए थे; मतलब, जेठा पाऊ अम्नोन, जो यिज्रेली अहीनोअमो ते पैदा ऊआ, दूजा दानिय्येल जो कर्मेली अबीगैल जवाणसा ते पैदा ऊआ। <verse eid="1CH 3:1" /><verse number="2" style="v" sid="1CH 3:2" />तीजा अबशालोम जो गशूर शईरो रे राजा तल्मै री बेटी माका रा पाऊ था, चौथा अदोनिय्याह जो हग्गीता रा पाऊ था। <verse eid="1CH 3:2" /><verse number="3" style="v" sid="1CH 3:3" />पाँजुआ शपत्याह जो अबीतलो ते ओर छठुआ यित्राम जो तेसरी जवाणस एग्ला ते पैदा ऊआ। <verse eid="1CH 3:3" /><verse number="4" style="v" sid="1CH 3:4" />दाऊदो ते हेब्रोनो दे छे पाऊ पैदा ऊए ओर तेती तिने साढ़े साता साला तक राज कित्तेया ओर यरूशलेम शईरो दे तेत्ती साला तक राज कित्तेया।<verse eid="1CH 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 3:5" />यरूशलेम शईरो दे तेसरे यो पाऊ पैदा ऊए: मतलब शिमा, शोबाब, नातान ओर सुलैमान, यो चारो अम्मीएलो री बेटी बतशेबा ते पैदा ऊए। <verse eid="1CH 3:5" /><verse number="6" style="v" sid="1CH 3:6" />ओर यिभार, एलीशामा एलीपेलेत, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />नोगह, नेपेग, यापी, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />एलीशामा, एल्यादा ओर एलीपेलेत, यो नौ पाऊ थे। <verse eid="1CH 3:8" /><verse number="9" style="v" sid="1CH 3:9" />यो सारे दाऊदो रे पाऊ थे ओर इना खे छाडी की रखैलिया रे बी पाऊ थे ओर इना री बईण तामार थी।<verse eid="1CH 3:9" /></para>
  <para style="s">सुलैमानो रा खानदान</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 3:10" />तेबे सुलैमानो रा पाऊ रहूबियाम था; रहूबियामो ते अबिय्याह, अबिय्याह ते आसा, आसा ते यहोशापात, <verse eid="1CH 3:10" /><verse number="11" style="v" sid="1CH 3:11" />यहोशापातो ते योराम, योरामो ते अहज्याह, अहज्याह ते योआश; <verse eid="1CH 3:11" /><verse number="12" style="v" sid="1CH 3:12" />योआशो ते अमस्याह, अमस्याह ते अजर्याह, अजर्याह ते योताम; <verse eid="1CH 3:12" /><verse number="13" style="v" sid="1CH 3:13" />योतामो ते आहाज, आहाजो ते हिजकिय्याह, हिजकिय्याहो ते मनश्शे; <verse eid="1CH 3:13" /><verse number="14" style="v" sid="1CH 3:14" />मनश्शे ते आमोन ओर आमोनो ते योशिय्याह ऊआ।<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">मत्ती 1:7-10</char></note> <verse eid="1CH 3:14" /><verse number="15" style="v" sid="1CH 3:15" />ओर योशिय्याह रे पाऊ तेसरा जेठा पाऊ योहानान, दूजा यहोयाकीम; तीजा सिदकिय्याह, चौथा शल्लूम। <verse eid="1CH 3:15" /><verse number="16" style="v" sid="1CH 3:16" />यहोयाकीमो रा पाऊ यकोन्याह, एसरा पाऊ सिदकिय्याह।<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">मत्ती 1:11</char></note> <verse eid="1CH 3:16" /><verse number="17" style="v" sid="1CH 3:17" />ओर यकोन्याह रा पाऊ अस्सीर, अस्सीरो रा पाऊ शालतीएल;<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">मत्ती 1:12, लूक. 3:27</char></note> <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />ओर मल्कीराम, पदायाह, शेनस्सर, यकम्याह, होशामा ओर नदब्याह; <verse eid="1CH 3:18" /><verse number="19" style="v" sid="1CH 3:19" />ओर पदायाह रे पाऊ जरूब्बाबेल ओर शिमी ऊए ओर जरूब्बाबेल रे पाऊ मशुल्लाम ओर हनन्याह थे, ओर तिना री बईण शलोमीत थी; <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />ओर हशूबा, ओहेल, बेरेक्याह, हसद्याह ओर यूशब-हेसेद, यो पाँज थे। <verse eid="1CH 3:20" /><verse number="21" style="v" sid="1CH 3:21" />ओर हनन्याह रे पाऊ पलत्याह ओर यशायाह, यशायाह ते रपायाह, रपायाह रा पाऊ अर्नान, अर्नानो रा पाऊ ओबद्याह, ओबद्याह रा पाऊ शकन्याह। <verse eid="1CH 3:21" /><verse number="22" style="v" sid="1CH 3:22" />ओर शकन्याह रा एक पाऊ शमायाह था ओर शमायाह रे पाऊ हत्तूश, यिगाल, बारीह, नार्याह ओर शपात, यो छे थे। <verse eid="1CH 3:22" /><verse number="23" style="v" sid="1CH 3:23" />ओर नार्याह रे पाऊ एल्योएनै, हिजकिय्याह ओर अज्रीकाम, यो तीन थे। <verse eid="1CH 3:23" /><verse number="24" style="v" sid="1CH 3:24" />ओर एल्योएनै रे सात पाऊ ऊए जिना रे नाओं यो ए होदव्याह, एल्याशीब, पलायाह, अक्कूब, योहानान, दलायाह ओर अनानी।<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s">यहूदा रा खानदान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1" />यहूदा रा खानदान ये ऊआ; मतलब यहूदा ते पेरेस, हेस्रोन, कर्मी, हूर ओर शोबाल ऊए। <verse eid="1CH 4:1" /><verse number="2" style="v" sid="1CH 4:2" />ओर शोबालो रे पाऊ रायाह ते यहत ओर यहतो ते अहूमै ओर लहद पैदा ऊए, ये सोराई कुल ए। <verse eid="1CH 4:2" /><verse number="3" style="v" sid="1CH 4:3" />एतामो रे बाओ रे यो पाऊ ऊए: मतलब यिज्रेल, यिश्मा ओर यिद्वाश, तिना रिया बईणी रा नाओं हस्सलेलपोनी था; <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" />ओर गदोरो रा बाओ पनूएल ओर हूशाहो रा बाओ एजेर। यो एप्राता रे जेठे पाऊ हूरो री ल्वाद थी, जो बेतलेहमो रा बाओ ऊआ। <verse eid="1CH 4:4" /><verse number="5" style="v" sid="1CH 4:5" />ओर तकोआ रे बाओ अशहूरो रे हेला ओर नारा नाओं रिया दो लाड़िया थिया। <verse eid="1CH 4:5" /><verse number="6" style="v" sid="1CH 4:6" />नारा ते अहुज्जाम, हेपेर, तेमनी ओर हाहशतारी पैदा ऊए, नारा रे यो ई पाऊ ऊए। <verse eid="1CH 4:6" /><verse number="7" style="v" sid="1CH 4:7" />ओर हेला रे पाऊ, सेरेत, यिसहर ओर एत्ना ऊए। <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />तेबे कोसो ते आनूब ओर सोबेबा पैदा ऊए ओर तेसरे कुलो रे हारूमो रे पाऊ अहर्हेलो रे कुल बी पैदा ऊए।<verse eid="1CH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />याबेश नाओं रा एक माणूं था जो आपणे सबी पाईया ते जादा जाणेया-मानेया दा था। तेसरिये माये तेसरा नाओं याबेश राखेया, कऊँकि तेसरिये माये तेसखे पैदा करदे बखते बऊत पीड़ सईन कित्ती थी। <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />एक दिन याबेश इस्राएलो रे परमेशरो खे जोरे-जोरे की ये बोलणे लगेया, “खरा ऊँदा कि तूँ माखे सच्चो खे ई आशीष देंदा ओर मेरा देश बढ़ांदा, ओर तेरा आथ मां साथे रंदा ओर तूँ माखे बुराईया ते एड़ा बचाई की राखदा कि माखे तिजी ते पीड़ा नि ऊँदी!” ओर जो कुछ तिने मांगेया, से परमेशरे तेसखे दित्तेया। <verse eid="1CH 4:10" /><verse number="11" style="v" sid="1CH 4:11" />तेबे शूह रे पाई कलूबो ते एशतोनो रा बाओ महीर पैदा ऊआ। <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />एशतोनो रे कुलो रे बेतरापा रा कराना ओर पासेह ओर ईर्नाहाशो रा बाओ तहिन्ना पैदा ऊए, रेका रे लोक यो ई ए।<verse eid="1CH 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 4:13" />कनजो रे पाऊ ओत्नीएल ओर सरायाह थे। ओर ओत्नीएलो रा पाऊ हतत था। <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />मोनोतै ते ओप्रा ओर सरायाह ते योआब जो गेहराशीमो रा बाओ ऊआ; सेयो कारीगर थे। <verse eid="1CH 4:14" /><verse number="15" style="v" sid="1CH 4:15" />ओर यपुन्ने रा पाऊ कालेबो रा पाऊ ईरू, एला ओर नाओं; ओर एला रा पाऊ कनज। <verse eid="1CH 4:15" /><verse number="16" style="v" sid="1CH 4:16" />यहलेलो रे पाऊ जीप, जीपा, तीरया ओर असरेल। <verse eid="1CH 4:16" /><verse number="17" style="v" sid="1CH 4:17" />ओर एज्रा रे पाऊ येतेर, मेरेद, एपेर ओर यालोन ओर तेसरी लाड़िया ते, मिर्याम, शम्मै ओर एशतमो रा बाओ यिशबह पैदा ऊए। <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />तेसरी यहूदिणी जवाणसा ते गदोरो रा बाओ येरेद, सोको रा बाओ हेबेर ओर जानोह रा बाओ यकूतीएल पैदा ऊए, यो फिरौनो री बेटी बित्या रे पाऊ थे जेसा साथे मेरेदे ब्या कित्तेया था। <verse eid="1CH 4:18" /><verse number="19" style="v" sid="1CH 4:19" />ओर होदिय्याहो री लाड़ी जो नहमो री बईण थी, तेसा रे पाऊ कीला रा बाओ एक गेरेमी ओर एशतमो रा बाओ एक माकाई ऊए। <verse eid="1CH 4:19" /><verse number="20" style="v" sid="1CH 4:20" />ओर शिमोनो रे पाऊ अम्नोन, रिन्ना, बेन्हानान ओर तोलोन ओर यिशीए रे पाऊ जोहेत ओर बेनजोहेत।<verse eid="1CH 4:20" /></para>
  <para style="s">शेला रा खानदान</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 4:21" />यहूदा रे पाऊ शेला रे यो पाऊ थे; एर ओर लादा। एरो रे लेका नाओं रा पाऊ ऊआ, ओर लादा रे मारेश नाओं रा पाऊ ऊआ। इजी ते अलावा बरीक सूती टाल्लेया रा काम करने वाल़ेया रे परिवार जो बेत-अशबे जगा दे रओ थे, शेला रे कुलो रे थे। <verse eid="1CH 4:21" /><verse number="22" style="v" sid="1CH 4:22" />ओर योकीम ओर कोजेबा शईरो रे माणूं ओर योआश ओर साराप जो मोआब इलाके दे राज करो थे ओर याशूब, लेहेम इना रा वृतांत पुराणा ए। <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />यो कुम्हार थे ओर नताईम ओर गदेरा शईरा दे रओ थे, जेती सेयो राजे रा काम-काज करदे ऊए तेसगे रओ थे।<verse eid="1CH 4:23" /></para>
  <para style="s">शिमोनो रा खानदान</para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 4:24" />शिमोनो रे पाऊ नमूएल, यामीन, यारीब, जेरह ओर शाऊल; <verse eid="1CH 4:24" /><verse number="25" style="v" sid="1CH 4:25" />ओर शाऊलो रा पाऊ शल्लूम, शल्लूमो रा पाऊ मिबसाम ओर मिबसामो रा पाऊ मिश्मा ऊआ। <verse eid="1CH 4:25" /><verse number="26" style="v" sid="1CH 4:26" />ओर मिश्मा रा पाऊ हम्मूएल, तेसरा पाऊ जक्कूर ओर तेसरा पाऊ शिमी। <verse eid="1CH 4:26" /><verse number="27" style="v" sid="1CH 4:27" />शिमिये रे सोल़ा पाऊ ओर छे बेटिया ऊईया, पर तेसरे पाईया रे बऊत पाऊ नि ऊए ओर तिना रा सारा कुल यहूदिया रे बराबर नि बढ़ेया। <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />यो इना शईरा दे रओ थे; मतलब बेर्शेबा, मोलादा, हसर्शूआल, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />बिल्हा, एसेम, तोलाद, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />बतूएल, होर्मा, सिकलग, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />बेत्मर्काबोत, हसर्सूसीम, बेतबिरी ओर शारैम; दाऊदो रे राजो रे बखतो तक तिना रे यो ई शईर रये। <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />ओर तिना रे गाँवो एताम, ऐन, रिम्मोन, तोकेन ओर आशान नाओं रे पाँज शईर थे; <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />ओर बाल शईरो तक जितणे गाँवो इना शईरा रे नेड़े तेड़े थे, तिना दे बसणे री जगा येई थी ओर ये तिना रा खानदान आ।<verse eid="1CH 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 4:34" />फेर मशोबाब ओर यम्लेक ओर अमस्याह रे पाऊ योशा, <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />ओर योएल ओर योशिब्याह रा पाऊ येहू, जो सरायाह रा पोता ओर असीएलो रा पड़पोता था, <verse eid="1CH 4:35" /><verse number="36" style="v" sid="1CH 4:36" />ओर एल्योएनै, ओर याकोबा, यशोहायाह ओर असायाह ओर अदीएल ओर यसीमीएल ओर बनायाह, <verse eid="1CH 4:36" /><verse number="37" style="v" sid="1CH 4:37" />ओर शिपीए रा पाऊ जीजा जो अल्लोनो रा पाऊ, ये यदायाह रा पाऊ, ये शिम्रीए रा पाऊ, ये शमायाह रा पाऊ था। <verse eid="1CH 4:37" /><verse number="38" style="v" sid="1CH 4:38" />यो जिना रे नाओं लिखी राखे, आपणे-आपणे कुलो रे परदान थे; ओर तिना रे पितरा रे कराने बऊत बढ़ीगे। <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />यो आपणी पेडा-बाकरिया खे चराणे खे जगा टोल़ने खे गदोर शईरो री काट्टिया री तराईया दे पूर्वो रिया तरफा तक गये। <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />तेबे तिना खे खरी ते खरी चराई मिली ओर देश लाम्बा-चौड़ा, चैन ओर शान्तिया रा था; कऊँकि तेती पईले रणे वाल़े हामो रे कुलो रे थे। <verse eid="1CH 4:40" /><verse number="41" style="v" sid="1CH 4:41" />जिना रे नाओं ऊबे लिखी राखे, तिने यहूदा रे राजा हिजकिय्याह रे दिना रे तेती आई की जो मूनी तेती मिले, सेयो डेरेया समेत काई की एड़े सत्यानाश कित्ते कि आजो तक तिना रा पता नि ए ओर सेयो तिना री जगा रे रणे लगे, कऊँकि तेती तिना रिया पेडा-बाकरिया खे चराणे खे जगा थी <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />शिमोन कुलो बीचा ते 500 मर्द सेईरो रे पाह्ड़ी इलाके रिया तरफा खे गये। तिना रे मुखिया पलत्याह, नार्याह, रपायाह ओर उज्जीएल थे। यो सब यिशीए रे पाऊ थे। <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />तेती जाईकी तिने अमालेकी जातिया रे लोक जो बची गे थे सेयो काईते। सेयो आजो तक तेथी रओए।<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s">रूबेनो रे खानदान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1" />इस्राएलो रा जेठा पाऊ रूबेन था, पर तिने आपणे बाओ री लाड़िया साथे गन्दा काम कित्तेया ओर अशुद्ध ऊईगा, इजी बजा ते जेठे रा अक्क इस्राएलो रे पाऊ यूसुफो रे पाऊआ खे दित्तेया। जेतेरिया बजा ते रूबेनो रा नाओं कुलो दे जमणे रे मुताबिक नि ऊँदा। <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />यहूदा आपणे पाईया बीचे सबी ते तागतबर ऊईगा ओर तेसरे ई परिवारो ते परदान आए, पर यूसुफो रे परिवारो खे से अक्क मिलेया जो जेठे पाऊए खे मिलो था। <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />इस्राएलो रे जेठे पाऊ रूबेनो रे पाऊ यो ऊए: मतलब हनोक, पल्लू, हेस्रोन ओर कर्मी थे। <verse eid="1CH 5:3" /><verse number="4" style="v" sid="1CH 5:4" />योएलो रा पाऊ शमायाह, शमायाहो रा पाऊ गोग, गोगो रा पाऊ शिमी, <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />शिमिये रा पाऊ मीका। मीके रा पाऊ रायाह, रायाह रा पाऊ बाल, <verse eid="1CH 5:5" /><verse number="6" style="v" sid="1CH 5:6" />ओर बालो रा पाऊ बएराह, एसखे अश्शूरो रा राजा तिग्लत्पिलेसेर बानी की लईगा ओर से रूबेनिया रा परदान था। <verse eid="1CH 5:6" /><verse number="7" style="v" sid="1CH 5:7" />ओर तेसरे पाईया री वंशावलिया रे लिखदे बखदे सेयो आपणे-आपणे कुलो रे मुताबिक यो ठईरे, मतलब बड़ा तो यीएल, तेबे जकर्याह, <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />ओर अजाजो रा पाऊ बेला, जो शेमो रा पोता ओर योएलो रा पड़पोता था, से अरोएर शईरो दे ओर नबो शईर ओर बालमोन शईरो तक रओ था। <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />से पूर्व दिशा दे उजाड़ जगा रे बन्ने तक फरात नदिया रे एते कनारे तक बी रया था, कऊँकि तिना रे डांगर गिलाद इलाके दे बऊत जादा बढ़ीगे थे। <verse eid="1CH 5:9" /><verse number="10" style="v" sid="1CH 5:10" />ओर शाऊलो रे दिना रे तिने हग्रिया साथे युद्ध कित्तेया ओर हग्री तिना रे आथो साथे मरी गे; तेबे सेयो गिलाद इलाके रे सारे पूर्वी इस्से दे आपणे डेरेया दे रणे लगे।<verse eid="1CH 5:10" /></para>
  <para style="s">गादो रा खानदान</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 5:11" />गाद कुलो रे लोक रूबेनिया रे नेड़े बाशान इलाके दे रओ थे। सेयो सल्का शईरो तक बसे दे थे। <verse eid="1CH 5:11" /><verse number="12" style="v" sid="1CH 5:12" />मतलब बड़ा तो योएल ओर दूजा शापाम तेबे यानै ओर शापात, ये सब बाशानो दे रओ थे। <verse eid="1CH 5:12" /><verse number="13" style="v" sid="1CH 5:13" />ओर तिना रे पाई आपणे-आपणे पितरा रे कराने रे मुताबिक मीकाएल, मशुल्लाम, शेबा, योरै, याकान, जीअ ओर एबेर, सात थे। <verse eid="1CH 5:13" /><verse number="14" style="v" sid="1CH 5:14" />यो अबीहैलो रे पाऊ थे, जो हूरीए रा पाऊ था, ये योराह रा पाऊ, ये गिलादो रा पाऊ, ये मिकाएलो रा पाऊ, ये यशीशै रा पाऊ, ये यहदो रा पाऊ, ये बूजो रा पाऊ था। <verse eid="1CH 5:14" /><verse number="15" style="v" sid="1CH 5:15" />इना रे पितरा रे कराने रा मूलमर्द अब्दीएलो रा पाऊ ओर गूनीए रा पोता अही था। <verse eid="1CH 5:15" /><verse number="16" style="v" sid="1CH 5:16" />यो लोक, बाशानो रे, गिलाद ओर तेथो रे गाँवो रे ओर शारोनो री सबी काईणी रे पोरलिया तरफा तक रओ थे। <verse eid="1CH 5:16" /><verse number="17" style="v" sid="1CH 5:17" />इना सबी री वंशावली यहूदा रे राजा योतामो रे दिना दे ओर इस्राएलो रे राजा यारोबामो रे दिना दे लिखी थी। <verse eid="1CH 5:17" /><verse number="18" style="v" sid="1CH 5:18" />रूबेनी, गादी ओर मनश्शे रे आदे गोत्रो रे योद्धा जो ढाल बनाणे, तलवार चलाणे ओर धनुषो ते तीर छाडणे जोगे ओर युद्ध करना सीखे रे थे, सेयो 44,760 थे, जो लड़ाईया दे जाणे जोगे थे। <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />इने हग्री ओर यतूर नापीश ओर नोदाबो साथे युद्ध कित्तेया था। <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />तिना रे खलाफ इना खे मताद मिली ओर हग्री तिना सबी समेत जो तिना साथे थे, तिना रे कब्जे दे करीते, कऊँकि इने युद्धो दे परमेशरो री दुहाई दित्ती थी ओर तिने तिना री बिनती इजी बजा ते सुणी, कऊँकि इने तेस पाँदे परोसा राखेया था। <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />ओर इने तिना रे डांगर लई ले, मतलब ऊँट तो 50,000, पेडा-बाकरिया, 250,000, गह्दे 2,000 ओर माणूं 100,000 बन्दी बणाई की लईगे। <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />एते लड़ाईया दे बऊत जादा खून खराबा ऊआ; कऊँकि से लड़ाई परमेशरो रिया तरफा ते ऊई थी। इजी ते बाद रूबेनो रे कुलो रे, गादो रे कुलो रे ओर मनश्शे रे गोत्रो रे आदे लोक तिना रिया जगा पाँदे निकाल़ने रे बखतो तक तिना रिया रणे रिया जगा पाँदे रंदे रये।<verse eid="1CH 5:22" /></para>
  <para style="s">मनश्शे रे खानदान (पूर्वो दे रणे वाल़े)</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />मनश्शे रे गोत्रो रे आदे लोक यरदन नदिया रे पूर्बा रिया तरफा खे बसी रे थे। तिना री संख्या बऊत थी। सेयो बाशानो ते लई की बालहेर्मोन, ओर सनीर ओर हेर्मोन पाह्ड़ो तक बसी रे थे। <verse eid="1CH 5:23" /><verse number="24" style="v" sid="1CH 5:24" />ओर तिना रे पितरा रे कराने रे मुखिया मर्द यो थे, मतलब एपेर, यिशी, एलीएल, अज्रीएल, यिर्मयाह, होदव्याह ओर यहदीएल, यो बड़े वीर ओर नामी ओर आपणे पितरा रे कराने रे मुखिया मर्द थे। <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />पर तिने आपणे पितरा रे परमेशरो साथे विश्वासघात कित्तेया ओर तेस देशो रे लोक, जो परमेशरे तिना रे सामणे ते नाश कित्ते थे, तिना रे देवतेया पीछे व्याभिचारणिया जेड़े ऊईगे। <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />इजी री खातर इस्राएलो रे परमेशरे अश्शूरो रे राजा पूल ओर अश्शूरो रे राजा तिग्लत्पिलेसेरो रा मन उभारेया ओर सेयो रूबेन, गाद ओर मनश्शे रे आदे गोत्रो रे लोका खे बन्दुआ करी लईगे। सेयो तिना खे हलह, हाबोर ओर हारा शईरा दे ओर गोजान नदिया रे कनारे लईगे, जेती सेयो आजो तक रया करोए।<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s">लेविया रा खानदान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1" />लेविये रे पाऊ गेर्शोन, कहात ओर मरारी ऊए। <verse eid="1CH 6:1" /><verse number="2" style="v" sid="1CH 6:2" />ओर कहातो रे पाऊ अम्राम, यिसहार, हेब्रोन ओर उज्जीएल ऊए। <verse eid="1CH 6:2" /><verse number="3" style="v" sid="1CH 6:3" />ओर अम्रामो रे पाऊ हारूण, मूसा ओर बेटी मरियम ऊए ओर हारूणो रे पाऊ नादाब, अबीहू, एलीआजार ओर ईतामार ऊए। <verse eid="1CH 6:3" /><verse number="4" style="v" sid="1CH 6:4" />एलीआजारो ते पीनहास, पीनहासो ते अबीशू, <verse eid="1CH 6:4" /><verse number="5" style="v" sid="1CH 6:5" />अबीशूए ते बुक्की, बुक्कीए ते उज्जी, <verse eid="1CH 6:5" /><verse number="6" style="v" sid="1CH 6:6" />उज्जीए ते जरहयाह, जरहयाह ते मरायोत, <verse eid="1CH 6:6" /><verse number="7" style="v" sid="1CH 6:7" />मरायोतो ते अमर्याह, अमर्याह ते अहीतूब, <verse eid="1CH 6:7" /><verse number="8" style="v" sid="1CH 6:8" />अहीतूबो ते सादोक, सादोको ते अहीमास, <verse eid="1CH 6:8" /><verse number="9" style="v" sid="1CH 6:9" />अहीमासो ते अजर्याह, अजर्याह, ते योहानान, <verse eid="1CH 6:9" /><verse number="10" style="v" sid="1CH 6:10" />ओर योहानानो रा पाऊ अजर्याह था (जो सुलैमानो रे मईलो दे जो तिने यरूशलेम शईरो दे बणाया तिदे पुरोईतो रा काम करो थे)। <verse eid="1CH 6:10" /><verse number="11" style="v" sid="1CH 6:11" />तेबे अजर्याह ते अमर्याह, अमर्याह ते अहीतूब, <verse eid="1CH 6:11" /><verse number="12" style="v" sid="1CH 6:12" />अहीतूबो ते सादोक, सादोको ते शल्लूम, <verse eid="1CH 6:12" /><verse number="13" style="v" sid="1CH 6:13" />शल्लूमो ते हिल्किय्याह, हिल्किय्याहो ते अजर्याह, <verse eid="1CH 6:13" /><verse number="14" style="v" sid="1CH 6:14" />अजर्याहो ते सरायाह ओर सरायाह ते यहोसादाक पैदा ऊआ। <verse eid="1CH 6:14" /><verse number="15" style="v" sid="1CH 6:15" />जेबे यहोवा यहूदा ओर यरूशलेम शईरो खे राजा नबूकदनेस्सरो रे जरीये बन्दुआ करी की लईगा, तेबे यहोसादाक बी बन्दुआ ऊई की गया।<verse eid="1CH 6:15" /></para>
  <para style="s">लेविये रा खानदान</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 6:16" />लेविये रे पाऊ गेर्शोम, कहात ओर मरारी थे। <verse eid="1CH 6:16" /><verse number="17" style="v" sid="1CH 6:17" />ओर गेर्शोमो रे पाऊआ रे नाओं यो थे, मतलब लिब्नी ओर शिमी। <verse eid="1CH 6:17" /><verse number="18" style="v" sid="1CH 6:18" />ओर कहातो रे पाऊ अम्राम, यिसहार, हेब्रोन ओर उज्जीएल ऊए। <verse eid="1CH 6:18" /><verse number="19" style="v" sid="1CH 6:19" />ओर मरारिए रे पाऊ महली ओर मूशी ऊए। आपणे-आपणे पितरा रे कराने रे मुताबिक लेविया रे कुल यो ऊए। <verse eid="1CH 6:19" /><verse number="20" style="v" sid="1CH 6:20" />मतलब गेर्शोमो रा पाऊ लिब्नी ऊआ, लिब्नीए रा पाऊ यहत, यहतो रा पाऊ जिम्मा। <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />जिम्मे रा पाऊ योआह, योआह रा पाऊ इद्दो, इद्दो रा पाऊ जेरह ओर जेरहो रा पाऊ यातरै ऊआ। <verse eid="1CH 6:21" /><verse number="22" style="v" sid="1CH 6:22" />तेबे कहातो रा पाऊ अम्मीनादाब ऊआ अम्मीनादाबो रा पाऊ कोरह, कोरह रा पाऊ अस्सीर, <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />अस्सीरो रा पाऊ एलकाना, एल्काना रा पाऊ एब्यासाप, एब्यासापो रा पाऊ अस्सीर, <verse eid="1CH 6:23" /><verse number="24" style="v" sid="1CH 6:24" />अस्सीरो रा पाऊ तहत, तहतो रा पाऊ ऊरीएल, ऊरीएलो रा पाऊ उजिय्याह ओर उजिय्याह रा पाऊ शाऊल था। <verse eid="1CH 6:24" /><verse number="25" style="v" sid="1CH 6:25" />तेबे एल्काना रे पाऊ अमासै ओर अहीमोत ऊए। <verse eid="1CH 6:25" /><verse number="26" style="v" sid="1CH 6:26" />एल्काना रा पाऊ सोपै, सोपै रा पाऊ नहत, <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />नहतो रा पाऊ एलीआब, एलीआबो रा पाऊ यरोहाम ओर यरोहामो रा पाऊ एल्काना ऊआ। <verse eid="1CH 6:27" /><verse number="28" style="v" sid="1CH 6:28" />सेमुएलो रे बी दो पाऊ ऊए, जेठा पाऊ योएल ओर दूजा अबिय्याह ऊआ।<verse eid="1CH 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 6:29" />तेबे मरारिए रे पाऊ महली, महलीए रा पाऊ लिब्नी, लिब्नीये रा पाऊ शिमी, शिमिये रा पाऊ उज्जा। <verse eid="1CH 6:29" /><verse number="30" style="v" sid="1CH 6:30" />उज्जे रा पाऊ शिमा; शिमा रा पाऊ हग्गिय्याह ओर हग्गिय्याह रा पाऊ असायाह था।<verse eid="1CH 6:30" /></para>
  <para style="s">परमेशरो रे मन्दरो दे गीत गाणे वाल़े</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />तेबे जो राजा दाऊदे सन्दूको खे मईलो दे राखणे ते बाद यहोवे रे मन्दरो दे गाणे वाल़े अधिकारी ठराए, सेयो यो ए; <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />जदुओ तक सुलैमान यरूशलेम शईरो दे यहोवे रे मन्दरो खे बणाई नि चुकेया, तदुओ तक सेयो मिलणे वाल़े तम्बूए रे सामणे गाणे रे जरीये सेवा करो थे ओर एसा सेवा रे नियमो रे मुताबिक आजीर ओ थे। <verse eid="1CH 6:32" /><verse number="33" style="v" sid="1CH 6:33" />जो आपणे-आपणे पाऊआ समेत आजीर ओ थे सेयो यो ए, मतलब कहातिया बीचा ते हेमान गाणे वाल़ा, जो योएलो रा पाऊ था ओर योएल शमूएलो रा, <verse eid="1CH 6:33" /><verse number="34" style="v" sid="1CH 6:34" />शमूएल एल्काना रा, एल्काना यरोहामो रा, यरोहाम एलीएलो रा, एलीएल तोह रा, <verse eid="1CH 6:34" /><verse number="35" style="v" sid="1CH 6:35" />तोह सूफो रा, सूफ एल्काना रा, एल्काना महतो रा, महत अमासै रा, <verse eid="1CH 6:35" /><verse number="36" style="v" sid="1CH 6:36" />अमासै एल्काना रा, एल्काना योएलो रा योएल अजर्याह रा, अजर्याह सपन्याह रा, <verse eid="1CH 6:36" /><verse number="37" style="v" sid="1CH 6:37" />सपन्याह तहतो रा, तहत अस्सीरो रा, अस्सीर एब्यासापो रा, एब्यासाप कोरह रा, <verse eid="1CH 6:37" /><verse number="38" style="v" sid="1CH 6:38" />कोरह यिसहारो रा, यिसहार कहातो रा, कहात लेविये रा ओर लेवी इस्राएलो रा पाऊ था।<verse eid="1CH 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 6:39" />ओर तेसरा पाई आसाप जो तेसरे दाँणे कनारे खड़े ओ था से बेरेक्याह रा पाऊ था ओर बेरेक्याह शिमा रा, <verse eid="1CH 6:39" /><verse number="40" style="v" sid="1CH 6:40" />शिमा मीकाएलो रा, मीकाएल बासेयाह रा, बासेयाह मल्किय्याह रा, <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />मल्किय्याह एत्नीए रा, एत्नी जेरह रा, जेरह अदायाह रा, <verse eid="1CH 6:41" /><verse number="42" style="v" sid="1CH 6:42" />अदायाह एतानो रा, एतान जिम्मा रा, जिम्मा शिमीए रा, <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />शिमी यहतो रा, यहत गेर्शोमा रा, गेर्शोमा लेविये रा पाऊ था।<verse eid="1CH 6:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1CH 6:44" />ओर खूँजी तरफा खे तिना रे पाई मरारी खड़े ओ थे, मतलब एतानो जो कीशीए रा पाऊ था, ओर कीशी अब्दीए रा, अब्दी मल्लूको रा, <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />मल्लूक हशब्याह रा, हशब्याह अमस्याह रा, अमस्याह हिल्किय्याह रा, <verse eid="1CH 6:45" /><verse number="46" style="v" sid="1CH 6:46" />हिल्किय्याह अमसीये रा, अमसी बानीए रा, बानी शेमेरो रा, <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />शेमेर महलीए रा, महली मूशीए रा, मूशी मरारिए रा ओर मरारी लेविये रा पाऊ था; <verse eid="1CH 6:47" /><verse number="48" style="v" sid="1CH 6:48" />ओर इना रे पाई जो लेविये थे सेयो परमेशरो रे मन्दरो रे हर प्रकारा री सेवा करने खे अर्पण कित्ते रे थे।<verse eid="1CH 6:48" /></para>
  <para style="s">हारूणो रा खानदान</para>
  <para style="p">
    <verse number="49" style="v" sid="1CH 6:49" />पर हारूण ओर तेसरे पाऊ होमबलिया री बेदी ओर तूपो री बेदी दुँईं पाँदे बलिदान चढ़ाओ थे ओर परम पवित्र जगा रा सारा काम करो थे ओर इस्राएली लोका खे प्राश्चित करो थे, जेड़ी की परमेशरो रे दास मूसे आज्ञा दित्ती थी। <verse eid="1CH 6:49" /><verse number="50" style="v" sid="1CH 6:50" />ओर हारूणो रे कुलो दे यो ऊए: मतलब तेसरा पाऊ एलीआजार ऊआ ओर एलीआजारो रा पीनहास, पीनहासो रा अबीशू, <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />अबीशूए रा बुक्की, बुक्कीए रा उज्जी, उज्जीए रा जरहयाह, <verse eid="1CH 6:51" /><verse number="52" style="v" sid="1CH 6:52" />जरहयाह रा मरायोत, मरायोतो रा अमर्याह, अमर्याह रा अहीतूब, <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />अहीतूबो रा सादोक ओर सादोको रा अहीमास पाऊ ऊआ।<verse eid="1CH 6:53" /></para>
  <para style="s">लेविया री रणे री जगा</para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54" />तिना रे इस्से रे तिना रे डेरेया रे मुताबिक तिना रिया बस्तिया यो ए, मतलब कहातो रे कुला बीचा ते पईली चिट्ठी जो हारूणो री ल्वादा रे नाओं पाँदे निकल़ी; <verse eid="1CH 6:54" /><verse number="55" style="v" sid="1CH 6:55" />मतलब, चऊँ कनारली चराणे वाल़ी जगा समेत यहूदा प्रदेशो रा हेब्रोन शईर तिना खे मिलेया। <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />पर तेस शईरो रे डोरू ओर गाँवो यपुन्ने रे पाऊ कालेबो खे दित्ते। <verse eid="1CH 6:56" /><verse number="57" style="v" sid="1CH 6:57" />ओर हारूणो री ल्वादा खे शरण शईर हेब्रोन ओर चराणे री जगा समेत लिब्ना ओर यत्तीर शईर ओर आपणी-आपणी चराणे री जगा समेत एशतमो; <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />आपणी-आपणी चराणे वाल़ी जगा समेत हीलेन ओर दबीर; <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />आशान ओर बेतशेमेश।<verse eid="1CH 6:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="1CH 6:60" />बिन्यामीनो रे गोत्रो बीचा ते आपणी-आपणी चराणे वाल़ी जगा समेत गिबोन, गेबा, आलेमेत ओर अनातोत शईर देईते। तिना रे कराने रे सारे शईर तेरा थे। <verse eid="1CH 6:60" /><verse number="61" style="v" sid="1CH 6:61" />ओर बाकी कहातिया रे गोत्रो रे कुल, मतलब मनश्शे रे आदे गोत्रो बीचा ते चिट्ठी पाई की दस शईर दित्ते। <verse eid="1CH 6:61" /><verse number="62" style="v" sid="1CH 6:62" />ओर गेर्शोमिया रे कुलो रे मुताबिक तिना खे इस्साकार, आशेर ओर नप्तालिया रे गोत्र ओर बाशानो दे रणे वाल़े मनश्शे रे गोत्रो बीचा ते तेरा शईर मिले।<verse eid="1CH 6:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="1CH 6:63" />मरारिया रे कुलो रे मुताबिक तिना खे रूबेन, गाद ओर जबूलूनो रे गोत्रो बीचा ते चिट्ठी पाई की बारा शईर दित्ते। <verse eid="1CH 6:63" /><verse number="64" style="v" sid="1CH 6:64" />इस्राएलिये लेविया खे यो शईर चराणे वाल़ी जगा समेत दित्ते। <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" />तिने यहूदी, शिमोनी ओर बिन्यामीनिया रे गोत्रो बीचा ते सेयो शईर पर्ची पाई की दित्ते, जिना रे नाओं ऊबे देई राखे। <verse eid="1CH 6:65" /><verse number="66" style="v" sid="1CH 6:66" />ओर कहातिया रे कई कुला खे तिना रे इस्से रे शईर एप्रैमो रे गोत्रो बीचा ते मिले। <verse eid="1CH 6:66" /><verse number="67" style="v" sid="1CH 6:67" />तेबे तिना खे आपणी-आपणी चराणे वाल़ी जगा समेत एप्रैमो रे पाह्ड़ी इलाके रा शकेम जो शरण शईर था, तेबे गेजेर, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />योकमाम, बेथोरोन, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />अय्यालोन ओर गत्रिम्मोन;<verse eid="1CH 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="1CH 6:70" />ओर मनश्शे रे आदे गोत्रो बीचा ते आपणी-आपणी चराणे वाल़ी जगा समेत आनेर ओर बिलाम बाकी कहातिया रे कुलो खे मिले।<verse eid="1CH 6:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="1CH 6:71" />तेबे गेर्शोमिया खे मनश्शे रे आदे गोत्रो रे कुलो बीचा ते तो आपणी-आपणी चराणे वाल़ी जगा समेत बाशानो रा गोलान ओर अशतारोत;<verse eid="1CH 6:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="1CH 6:72" />ओर इस्साकारो रे गोत्रो बीचा ते आपणी-आपणी चराणे वाल़ी जगा समेत कादेश, दाबरत, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />रामोत ओर आनेम।<verse eid="1CH 6:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="1CH 6:74" />ओर आशेरो रे गोत्रो बीचा ते आपणी-आपणी चराणे वाल़ी जगा समेत मशाल, अब्दोन, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />हूकोक ओर रहोब;<verse eid="1CH 6:75" /></para>
  <para style="p">
    <verse number="76" style="v" sid="1CH 6:76" />ओर नप्तालीए रे गोत्रो बीचा ते आपणी-आपणी चराणे वाल़ी जगा समेत गलील इलाके रा केदेश, हम्मोन ओर किर्यातैम शईर मिले।<verse eid="1CH 6:76" /></para>
  <para style="p">
    <verse number="77" style="v" sid="1CH 6:77" />फेर बाकी लेविया खे मतलब मरारिया खे जबूलूनो रे गोत्रो बीचा ते तो आपणी-आपणी चराणे वाल़ी जगा समेत रिम्मोन ओर ताबोर।<verse eid="1CH 6:77" /></para>
  <para style="p">
    <verse number="78" style="v" sid="1CH 6:78" />ओर यरीहो रे नेड़े री यरदन नदिया री पूर्वो री तरफा खे रूबेनो रे गोत्रो बीचा ते आपणी-आपणी चराणे वाल़ी जगा समेत जंगल़ो रा बेसेर, यहस, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />कदेमोत ओर मेपात;<verse eid="1CH 6:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="1CH 6:80" />ओर गादो रे गोत्रो बीचा ते आपणी-आपणी चराणे वाल़ी जगा समेत गिलादो रा रामोत, महनैम, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />हेशबोन ओर याजेर शईर दित्ते।<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s">इस्साकारो रा खानदान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1" />इस्साकारो रे यो चार पाऊ ऊए: मतलब तोला, पूआ, याशूब ओर शिम्रोन। <verse eid="1CH 7:1" /><verse number="2" style="v" sid="1CH 7:2" />ओर तोला रे पाऊ उज्जी, रपायाह, यरीएल, यहमै, यिबसाम ओर शमूएल, यो आपणे-आपणे पितरा रे कराने, मतलब तोला री ल्वादा रे मूल़ मर्द ओर बड़े वीर थे ओर दाऊदो रे दिना दे तिना रे कुलो री गिणती 22,600 थी। <verse eid="1CH 7:2" /><verse number="3" style="v" sid="1CH 7:3" />ओर उज्जीए रा पाऊ यिज्रह्याह ऊआ, ओर यिज्रह्याह रा पाऊ मीकाएल, ओबद्याह, योएल ओर यिश्शिय्याह। यो सारे पाँजो आपणे कराने रे मुखिया मर्द थे; <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />ओर तिना साथे तिना री वंशावली ओर पितरा रे कराने रे मुताबिक सेना रे दलो रे 36,000 योद्धा थे; कऊँकि तिना रिया बऊत सारिया जवाणसा ओर पाऊ थे। <verse eid="1CH 7:4" /><verse number="5" style="v" sid="1CH 7:5" />ओर तिना रे पाई जो इस्साकारो रे सारे कुलो बीचा ते थे, सेयो 87,000 बड़े वीर योद्धा थे, जो आपणी-आपणी वंशावलिया साथे गिणे।<verse eid="1CH 7:5" /></para>
  <para style="s">बिन्यामीन ओर नप्तालिया रा खानदान</para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 7:6" />बिन्यामीनो रे तीन पाऊ ऊए: बेला, बेकेर ओर यदीएल। <verse eid="1CH 7:6" /><verse number="7" style="v" sid="1CH 7:7" />बेला रे पाँज पाऊ थे; एसबोन, उज्जी, उज्जीएल, यरीमोत ओर ईरी। यो आपणे-आपणे पितरा रे कराने रे मुखिया मर्द ओर बड़े वीर थे ओर आपणी-आपणी वंशावलिया रे मुताबिक तिना री गिणती 22,034 थी। <verse eid="1CH 7:7" /><verse number="8" style="v" sid="1CH 7:8" />ओर बेकेरो रे पाऊ जमीरा, योआश, एलीएजेर, एल्योएनै, ओम्री, यरेमोत, अबिय्याह, अनातोत ओर आलेमेत यो सब बेकेरो रे पाऊ थे। <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />यो जो आपणे-आपणे पितरा रे कराने रे मूल़ मर्द ओर बड़े वीर थे इना रे खानदानो री गिणती आपणे-आपणे खानदानो रे मुताबिक 20,200 थी।<verse eid="1CH 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 7:10" />ओर यदीएलो रा पाऊ बिल्हान ओर बिल्हानो रे पाऊ यूश, बिन्यामीन, एहूद, कनाना, जेतान, तर्शीश ओर अहीशहर थे। <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />यो सब जो यदीएलो री ल्वाद ओर यो आपणे-आपणे पितरा रे कराने रे मूल़ मर्द ओर बड़े वीर थे, इना रे कुलो ते सेना रे युद्ध करने जोगे 17,200 मर्द थे। <verse eid="1CH 7:11" /><verse number="12" style="v" sid="1CH 7:12" />ओर ईरो रे पाऊ शुप्पीम ओर हुप्पीम थे ओर अहेरो रा पाऊ हूशीम था।<verse eid="1CH 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 7:13" />नप्तालीए रे पाऊ यहसेल, गूनी, येसेर ओर शिल्लेम थे, यो बिल्हा रे पोते थे।<verse eid="1CH 7:13" /></para>
  <para style="s">मनश्शे रा खानदान जो पच्छमा दे बसेया</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 7:14" />मनश्शे रा पाऊ अस्रीएल जो तेसरी अरामी रखैला ते पैदा ऊआ था ओर तेसे अरामी जवाणसे गिलादो रे बाओ माकीरो खे बी जन्म दित्तेया। <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />ओर माकीर (जेसरिया बईणी रा नाओं माका था) तिने हुप्पीम ओर शुप्पीमो खे जवाणसा ब्यायी तिया ओर दूजे रा नाओं सलोफाद था ओर सलोफादो रे बेटिया ऊईया। <verse eid="1CH 7:15" /><verse number="16" style="v" sid="1CH 7:16" />तेबे माकीरो री जवाणस माका रे एक पाऊ पैदा ऊआ ओर तेसरा नाओं पेरेश राखेया ओर तेसरे पाईए रा नाओं शेरेश था ओर एसरे पाऊ ऊलाम ओर राकेम थे। <verse eid="1CH 7:16" /><verse number="17" style="v" sid="1CH 7:17" />ओर ऊलामो रा पाऊ बदान था। यो गिलादो री ल्वाद थी जो माकीरो रा पाऊ ओर मनश्शे रा पोता था। <verse eid="1CH 7:17" /><verse number="18" style="v" sid="1CH 7:18" />तेबे तेसरी बईणे हम्मोलेकेते ईशहोद, अबीएजेर ओर महला खे जन्म दित्तेया <verse eid="1CH 7:18" /><verse number="19" style="v" sid="1CH 7:19" />शमीदा रे पाऊ अहिअन, शेकेम, लिखी ओर अनीआम थे।<verse eid="1CH 7:19" /></para>
  <para style="s">एप्रैमो रा खानदान</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 7:20" />एप्रैमो रे पाऊ शूतेलह ओर शूतेलह रा बेरेद, बेरेदो रा तहत, तहतो रा एलादा, एलादा रा तहत; <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />तहतो रा जाबाद ओर जाबादो रा पाऊ शूतेलह था ओर एजेर ओर एलाद बी जो गत शईरो रे माणूंए, जो तेस देशो रे पैदा ऊए थे, इजी खे काये, कऊँकि सेयो तिना रे डांगर लुटणे खे आए थे। <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />तिना रा बाओ एप्रैम तिना रिया तँईं कई दिन तक शोग करदा रया ओर तेसरे पाई तेसखे शान्ति देणे खे आए। <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />ओर से आपणी लाड़िया गे गया ओर से गर्भवती ऊई ओर तेसे एकी पाऊए खे जन्म दित्तेया ओर एप्रैमे तेसरा नाओं इजी बजा ते बरीआ राखेया कि तेसरे कराने रे मुसीबत पड़ी थी।<verse eid="1CH 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 7:24" />तेसरी बेटी शेरा थी, जेसे थालले ओर पाँदले दोनो बेथोरोनो रे शईर ओर उज्जेनशेरा खे मजबूत कराया। <verse eid="1CH 7:24" /><verse number="25" style="v" sid="1CH 7:25" />तेसा रा पाऊ रेपा ओर रेशेप थे, ओर रेशेपो रा पाऊ तेलह, तेलह रा पाऊ तहन, तहनो रा पाऊ लादान, <verse eid="1CH 7:25" /><verse number="26" style="v" sid="1CH 7:26" />लादानो रा पाऊ अम्मीहूद, अम्मीहूदो रा पाऊ एलीशामा, <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />एलीशामा रा पाऊ नून ओर नूनो रा पाऊ यहोशू था। <verse eid="1CH 7:27" /><verse number="28" style="v" sid="1CH 7:28" />तिना री आपणी जमीन ओर बस्तिया गाँवो समेत बेतेल ओर पूर्वो रिया तरफा खे नारान ओर पच्छमा रिया तरफा खे गाँवो समेत गेजेर, तेबे गाँवो समेत शकेम ओर गाँवो समेत अय्या थी; <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />ओर मनश्शेइया रे बन्ने रे नेड़े आपणे-आपणे गाँवो समेत बेतशान, तानाक, मगिद्दो ओर दोर। इना जगा दे इस्राएलो रे पाऊ यूसुफो री ल्वादा रे लोक रओ थे।<verse eid="1CH 7:29" /></para>
  <para style="s">आशेरो रा खानदान</para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 7:30" />आशेरो रे पाऊ यिम्ना, यिश्वा, यिश्वी ओर बरीआ ओर तिना री बईण सेरह थी। <verse eid="1CH 7:30" /><verse number="31" style="v" sid="1CH 7:31" />ओर बरीआ रे पाऊ हेबेर ओर मल्कीएल थे ओर ये बिर्जोतो रा बाओ बणेया।<verse eid="1CH 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 7:32" />हेबेरो रे तीन पाऊ यपलेत, शोमेर, होताम ऊए ओर तेसरे एक बेटी बी ऊई जेसारा नाओं शूआ था।<verse eid="1CH 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 7:33" />ओर यपलेतो रे पाऊ पासक, बिम्हाल ओर अश्वात थे। यपलेतो रे यो ई पाऊ थे।<verse eid="1CH 7:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 7:34" />शेमेरो रे पाऊ अही, रोहगा, यहुब्बा ओर अराम थे। <verse eid="1CH 7:34" /><verse number="35" style="v" sid="1CH 7:35" />तेसरे पाई हेलेमो रे पाऊ सोपह, यिम्ना, शेलेश ओर आमाल थे।<verse eid="1CH 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CH 7:36" />सोपहो रे पाऊ सूह, हर्नेपेर, शूआल, बेरी, इम्रा। <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />बेसेर, होद, शम्मा, शिलसा, यित्रान ओर बेरा थे।<verse eid="1CH 7:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 7:38" />येतेरो रे पाऊ यपुन्ने, पिस्पा ओर अरा थे।<verse eid="1CH 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 7:39" />उल्ला रे पाऊ आरह, हन्नीएल ओर रिस्या थे। <verse eid="1CH 7:39" /><verse number="40" style="v" sid="1CH 7:40" />यो सब आशेरो रे कुलो रे ऊए ओर आपणे-आपणे पितरा रे कराने रे मूल़ मर्द ओर बड़े वीर थे ओर परदाना बीचे बड़े थे। यो जो आपणी वंशावलिया रे मुताबिक सेना रे युद्ध करने खे गिणे गये, इना री गिणती 26,000 थी।<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s">बिन्यामीनो रा खानदान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1" />बिन्यामीनो ते तेसरा जेठा पाऊ बेला, दूजा अशबेल, तीजा अहृह, <verse eid="1CH 8:1" /><verse number="2" style="v" sid="1CH 8:2" />चौथा नोहा ओर पाँजुआ रापा पैदा ऊआ। <verse eid="1CH 8:2" /><verse number="3" style="v" sid="1CH 8:3" />बेला रे पाऊ अद्दार, गेरा, अबीहूद, <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />अबीशू, नामान, अहोह, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />गेरा, शपूपान ओर हूराम थे। <verse eid="1CH 8:5" /><verse number="6" style="v" sid="1CH 8:6" />एहूदो रे पाऊ यो ऊए, गेबा रे रणे वाल़ेया रे पितरा रे कराने रे मूल़ मर्द यो थे, जिना खे बन्दी बणाई की मानहतो खे लईगे थे। <verse eid="1CH 8:6" /><verse number="7" style="v" sid="1CH 8:7" />ओर नामान, अहिय्याह ओर गेरा, इना खे बी बन्दी बणाई की मानहतो खे लईगे थे, ओर तिने उज्जा ओर अहीहूदो खे जन्म दित्तेया। <verse eid="1CH 8:7" /><verse number="8" style="v" sid="1CH 8:8" />ओर शहरैमो ते हूशीम ओर बारा नाओं री आपणी लाड़िया खे छाडणे ते बाद मोआब देशो दे पाऊ पैदा ऊए। <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />तेसरी आपणी लाड़ी होदेशो ते योबाब, सिब्या, मेशा, मल्काम, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />यूस, सोक्या, ओर मिर्मा पैदा ऊए, तेसरे यो पाऊ आपणे-आपणे पीतरा रे कराने रे मूल़ मर्द थे। <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />ओर हूशीमो ते अबीतूब ओर एल्पालो रा जन्म ऊआ। <verse eid="1CH 8:11" /><verse number="12" style="v" sid="1CH 8:12" />एल्पालो रे पाऊ एबेर, मिशाम ओर शामेद थे, इने ई ओनो ओर गाँवो समेत लोद बसाया। <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />तेबे बरीआ ओर शेमा जो अय्यालोनो दे रणे वाल़ेया रे पितरा रे कराने रे मूल़ मर्द थे ओर जिने गतो रे रणे वाल़े नठाईते थे। <verse eid="1CH 8:13" /><verse number="14" style="v" sid="1CH 8:14" />ओर अह्यो, शाशक, यरेमोत, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />जबद्याह, अराद, एदेर, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />मीकाएल, यिस्पा, योहा, जो बरीआ रे पाऊ थे, <verse eid="1CH 8:16" /><verse number="17" style="v" sid="1CH 8:17" />जबद्याह, मशुल्लाम, हिजकी, हेबेर, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />यिशमरै, यिजलीआ, योबाब, जो एल्पालो रे पाऊ थे। <verse eid="1CH 8:18" /><verse number="19" style="v" sid="1CH 8:19" />ओर याकीम, जिक्री, जब्दी, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />एलीएनै, सिल्लतै, एलीएल, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />अदायाह, बरायाह ओर शिम्रात जो शिमिये रे पाऊ थे। <verse eid="1CH 8:21" /><verse number="22" style="v" sid="1CH 8:22" />यिशपान, एबेर, एलीएल, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />अब्दोन, जिक्री, हानान, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />हनन्याह, एलाम, अन्तोतिय्याह, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />यिपदयाह ओर पनूएल, जो शाशको रे पाऊ थे। <verse eid="1CH 8:25" /><verse number="26" style="v" sid="1CH 8:26" />ओर शमशरै, शहर्याह, अतल्याह, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />योरेश्याह, एलिय्याह ओर जिक्री जो यरोहामो रे पाऊ थे। <verse eid="1CH 8:27" /><verse number="28" style="v" sid="1CH 8:28" />यो आपणी-आपणी पीढ़िया रे आपणे-आपणे पितरा रे कराने रे मूल़ मर्द ओर परदान थे, यो यरूशलेम शईरो रे रओ थे।<verse eid="1CH 8:28" /></para>
  <para style="s">शाऊलो रा खानदान</para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 8:29" />गिबोनो दे गिबोनो रा बाओ रओ था, जेसरी लाड़िया रा नाओं माका था। <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />ओर तेसरा जेठा पाऊ अब्दोन था, तेबे सूर, कीश, बाल, नादाब, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />गदोर; अह्यो ओर जेकेर ऊए। <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />मिक्लोतो ते शिमआह पैदा ऊआ। ओर यो बी आपणे पाईया सामणे, यरूशलेम शईरो रे रओ थे, आपणे ई पाईया साथे। <verse eid="1CH 8:32" /><verse number="33" style="v" sid="1CH 8:33" />नेरो ते कीश पैदा ऊआ, कीशो ते शाऊल, ओर शाऊलो ते योनातान, मल्कीशूअ, अबीनादाब ओर एशबाल पैदा ऊए; <verse eid="1CH 8:33" /><verse number="34" style="v" sid="1CH 8:34" />ओर योनातानो रा पाऊ मरीब्बाल ऊआ ओर मरीब्बालो ते मीका पैदा ऊआ। <verse eid="1CH 8:34" /><verse number="35" style="v" sid="1CH 8:35" />मीका रे यो पाऊ थे, पीतोन, मेलेक, तारे ओर आहाज। <verse eid="1CH 8:35" /><verse number="36" style="v" sid="1CH 8:36" />आहाजो ते यहोअद्दा पैदा ऊआ ओर यहोअद्दा ते आलेमेत, अज्मावेत ओर जिम्री ओर जिम्रिए ते मोसा। <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />मोसा ते बिना पैदा ऊआ, ओर बिना ते रापा ऊआ, रापा ते एलासा ओर एलासा रा पाऊ आसेल ऊआ। <verse eid="1CH 8:37" /><verse number="38" style="v" sid="1CH 8:38" />ओर आसेलो रे छे पाऊ ऊए, जिना रे नाओं यो थे, मतलब अज्रीकाम, बोकरू, इश्माएल, शरायाह, ओबद्याह ओर हानान। यो सारे ई आसेलो रे पाऊ थे। <verse eid="1CH 8:38" /><verse number="39" style="v" sid="1CH 8:39" />तेसरे पाई एशेको रे यो पाऊ ऊए, मतलब तेसरा जेठा पाऊ ऊलाम, दूजा यूश, तीजा एलीपेलेत। <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />ऊलामो रे पाऊ शूरवीर ओर धनुर्धारी ऊए ओर तिना रे बऊत सारे माठे-पोते ऊए, मतलब 150 ऊए। यो ई सारे बिन्यामीनो रे कुलो रे थे।<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="s">यरूशलेम शईरो दे रणे वाल़ेया रा इन्तजाम</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />ईंयाँ सारे इस्राएली आपणे-आपणे खानदानो रे मुताबिक, जो इस्राएलो रे राजेया रे इतिआसो री कताबा रे लिखी राखे, गिणे। ओर यहूदी आपणे विश्वासघातो रिया बजा ते बानी की बेबीलोनो रे पऊँचाए।<verse eid="1CH 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 9:2" />बन्दुआईया ते वापस ऊई की जो लोक आपणी-आपणी निज जमीन, मतलब आपणे शईरो दे रओ थे, सेयो इस्राएली, पुरोईत, लेविये ओर मन्दरो रे सेवक थे।<verse eid="1CH 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 9:3" />यरूशलेम शईरो दे कुछ यहूदी; कुछ बिन्यामीनी, ओर कुछ एप्रैमी ओर मनश्शेई लोक रओ थे, <verse eid="1CH 9:3" /><verse number="4" style="v" sid="1CH 9:4" />मतलब यहूदा रे पाऊ पेरेसो रे कुलो बीचा ते अम्मीहूदो रा पाऊ ऊतै, जो ओम्रीये रा पाऊ ओर इम्रीए रा पोता ओर बानीए रा पड़पोता था। <verse eid="1CH 9:4" /><verse number="5" style="v" sid="1CH 9:5" />ओर शीलोईया बीचा ते तेसरा जेठा पाऊ असायाह ओर तेसरे पाऊ। <verse eid="1CH 9:5" /><verse number="6" style="v" sid="1CH 9:6" />जेरह रे कुलो बीचा ते यूएल ओर इना रे पाई रओ थे, ओर इस्राएलिया बीचा ते तेती 690 मर्द रओ थे।<verse eid="1CH 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 9:7" />फेर बिन्यामीनो रे कुलो बीचा ते सल्लू जो मशुल्लामो रा पाऊ, होदव्याह रा पोता ओर हस्‍सनूआ रा पड़पोता था। <verse eid="1CH 9:7" /><verse number="8" style="v" sid="1CH 9:8" />ओर यिबनायाह जो यरोहामो रा पाऊ था ओर एला जो उज्जीए रा पाऊ ओर मिक्रीए रा पोता था ओर मशुल्लाम जो शपत्याह रा पाऊ, रूएलो रा पोता ओर यिब्निय्याह रा पड़पोता था; <verse eid="1CH 9:8" /><verse number="9" style="v" sid="1CH 9:9" />ओर इना रे पाई जो आपणी-आपणी वंशावलिया रे मुताबिक मिली की 956 थे। यो सारे मर्द आपणे-आपणे पितरा रे कराने रे मुताबिक पितरा रे करानेया रे मूल़ थे।<verse eid="1CH 9:9" /></para>
  <para style="s">गुलामिया ते वापस आए दे पुरोईत</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 9:10" />यरूशलेमो दे रणे वाल़े पुरोईता बीचा ते यदायाह, यहोयारीब ओर याकीन, <verse eid="1CH 9:10" /><verse number="11" style="v" sid="1CH 9:11" />ओर अजर्याह जो परमेशरो रे मन्दरो रा परदान ओर हिल्किय्याह रा पाऊ था, ये मशुल्लामो रा पाऊ, ये सादोको रा पाऊ, ये मरायोतो रा पाऊ, ये अहीतूबो रा पाऊ था; <verse eid="1CH 9:11" /><verse number="12" style="v" sid="1CH 9:12" />ओर अदायाह जो यरोहामो रा पाऊ था, ये पशहूरो रा पाऊ, ये मल्किय्याह रा पाऊ, ये मासै रा पाऊ, ये अदीएलो रा पाऊ, ये यहजेरा रा पाऊ, ये मशुल्लामो रा पाऊ, ये मशिल्लीतो रा पाऊ, ये इम्मेरो रा पाऊ था; <verse eid="1CH 9:12" /><verse number="13" style="v" sid="1CH 9:13" />ओर इना रे पाई थे जो आपणे-आपणे पितरा रे करानेया रे 1,760 मर्द थे, सेयो परमेशरो रे मन्दरो री सेवा करने खे बऊत ई निपुण मर्द थे।<verse eid="1CH 9:13" /></para>
  <para style="s">गुलामिया ते वापस आए दे लेवी</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 9:14" />फेर लेविया बीचा ते जो यरूशलेमो दे रणे लगे, मरारिए रे कुलो बीचा ते शमायाह जो हश्शूबो रा पाऊ, अज्रीकामो रा पोता ओर हशब्याह रा पड़पोता था; <verse eid="1CH 9:14" /><verse number="15" style="v" sid="1CH 9:15" />ओर बकबक्कर, हेरेश ओर गालाल ओर आसापो रे कुलो बिचा ते मत्तन्याह जो मीका रा पाऊ ओर जिक्रीए रा पोता था; <verse eid="1CH 9:15" /><verse number="16" style="v" sid="1CH 9:16" />ओर ओबद्याह जो शमायाह रा पाऊ, गालालो रा पोता ओर यदूतूनो रा पोता था: ओर बेरेक्याह जो आसा रा पाऊ ओर एल्काना रा पोता था जो नतोपाईया रे गाँवो रे रओ था।<verse eid="1CH 9:16" /></para>
  <para style="s">लेवी जो द्वारपाल थे</para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 9:17" />द्वारपाला बीचा ते आपणे-आपणे पाईया समेत शल्लूम, अक्कूब, तल्मोन ओर अहीमान, तिना बीचा ते बड़ा शल्लूम था। <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />ओर से यबुओ तक पूर्वो कनारले राजे रे बड़े द्वारो गे द्वारपालो रा काम करो था। लेविया रे डेरेया रे द्वारपाल यो ई थे। <verse eid="1CH 9:18" /><verse number="19" style="v" sid="1CH 9:19" />ओर शल्लूम जो कोरे रा पाऊ, एब्यासापो रा पोता ओर कोरह रा पड़पोता था ओर तेसरे पाई जो तेसरे मूलमर्दो रे कराने रे मतलब कोरही थे सेयो एते कामो रे अधिकारी थे कि सेयो तम्बूए रे द्वारपाल ओ। तिना रे बुजुर्ग तो यहोवे रे डेरे अधिकारी ओर प्रवेश द्वारो रे रखवाल़े थे।<verse eid="1CH 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 9:20" />पुराणे बखतो रे एलीआजारो रा पाऊ पीनहास जेस साथे यहोवा रओ था, से तिना रा परदान था।<verse eid="1CH 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 9:21" />मेशेलेम्याह रा पाऊ जकर्याह मिलणे वाल़े तम्बूए रा द्वारपाल था। <verse eid="1CH 9:21" /><verse number="22" style="v" sid="1CH 9:22" />यो सब जो द्वारपाल ऊणे खे चूणे, सेयो 212 थे। यो जिना रे बुजुर्गा खे दाऊद ओर शमूएल दर्शीये विश्वासो जोगे जाणी की ठराए थे, सेयो आपणे-आपणे गाँवो रे आपणी-आपणी वंशावलिया रे मुताबिक गिणे।<verse eid="1CH 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 9:23" />तेबे सेयो ओर तिना री ल्वाद यहोवे रे मन्दर, मतलब तम्बूए रे मईलो रे बड़े द्वारो रा अक्क बारी-बारी राखो थे। <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />द्वारपाल पूर्ब, पच्छमा, उत्तर, दक्खण, चारो दिशा रिया तरफा खे चौकसी करो थे। <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />ओर इना रे पाई जो गाँवो रे रओ थे, तिना खे सात-सात दिना ते बाद बारी-बारिया ते तिना साथे रणे खे आऊणा पड़ो था। <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />कऊँकि चारो परदान द्वारपाल जो लेविये थे, सेयो विश्वासो जोगे जाणी की परमेशरो रे मन्दरो दे कमरे रे ओर पण्डारो रे अधिकारी ठराए थे। <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />सेयो परमेशरो रे मन्दरो रे नेड़े-तेड़े रात इजी खे बिताओ थे, कऊँकि तेथो री रखवाल़ी तिना गे सम्बाल़ी राखी थी ओर प्यागा-प्यागा से खोलणा तिना रा ई काम था।<verse eid="1CH 9:27" /></para>
  <para style="s">लेविया री ओर जिम्मेदारी</para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />तिना बीचा ते कुछ आराधना रे पांडेया रे रखवाल़े थे, कऊँकि यो पांडे गिणी की पीतरे पऊँचाणे ओर गिणी की बारे बी निकयाल़े जाओ थे। <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />ओर इना बीचा ते कुछ रखवाल़े समानो रे ओर पवित्र जगा रे पांडेया रे ओर मैदे, शराब, तेल, लोबान ओर खुशबूदार द्रव्य रे अधिकारी ठराए थे।<verse eid="1CH 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 9:30" />पुरोईता रे पाऊआ बीचा ते कुछ खुशबूदार द्रव्य रा मिश्रण त्यार करने रा काम करो थे।<verse eid="1CH 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 9:31" />ओर मत्तित्याह नाओं रा एक लेवी जो कोरही शल्लूमो रा जेठा पाऊ था से विश्वासो जोगा जाणी की तवेया पाँदे बणाई री चीजा रा अधिकारी नियुक्त कित्तेया था।<verse eid="1CH 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 9:32" />तेसरे पाई मतलब कहातिया बीचा ते कुछ पेंटा वाल़ी रोटिया रे अधिकारी थे, ताकि हर एक रामो रे दिनो रे तिजी खे त्यार करेया करो। <verse eid="1CH 9:32" /><verse number="33" style="v" sid="1CH 9:33" />यो गायक थे जो लेवी पितरा रे कराने बीचा ते खास थे ओर मन्दरो रे रओ थे ओर बाकी सेवा रे कामो ते छूटे थे; कऊँकि सेयो दिन-रात आपणे कामो रे लगे रे रओ थे। <verse eid="1CH 9:33" /><verse number="34" style="v" sid="1CH 9:34" />यो ई आपणी-आपणी पीढ़िया रे लेविया रे पितरा रे कराने रे खास मर्द थे, यो सब यरूशलेम शईरो देई रओ थे।<verse eid="1CH 9:34" /></para>
  <para style="s">शाऊल राजे रा खानदान</para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 9:35" />गिबोन शईरो दे गिबोनो रा बाओ यीएल रओ था, जेसरी लाड़िया रा नाओं माका था। <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />तेसा रा जेठा पाऊ अब्दोन ऊआ, तेबे सूर, कीश, बाल, नेर, नादाब, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />गदोर, अह्यो, जकर्याह ओर मिक्लोत; <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />ओर मिक्लोतो ते शिमाम पैदा ऊआ ओर यो बी आपणे पाईया सामणे आपणे पाईया साथे यरूशलेम शईरो रे रओ थे। <verse eid="1CH 9:38" /><verse number="39" style="v" sid="1CH 9:39" />नेरो ते कीश, कीशो ते शाऊल, शाऊलो ते योनातान, मल्कीशूअ, अबीनादाब ओर एशबाल पैदा ऊए। <verse eid="1CH 9:39" /><verse number="40" style="v" sid="1CH 9:40" />ओर योनातानो रा पाऊ मरीब्बाल ऊआ ओर मरीब्बालो ते मीका पैदा ऊआ। <verse eid="1CH 9:40" /><verse number="41" style="v" sid="1CH 9:41" />मीका रे पाऊ पीतोन, मेलेक, तह्रे ओर आहाज ऊए; <verse eid="1CH 9:41" /><verse number="42" style="v" sid="1CH 9:42" />ओर आहाजो ते यारा, ओर यारा ते आलेमेत, अज्मावेत ओर जिम्री ओर जिम्रिए ते मोसा, <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />ओर मोसा ते बिना पैदा ऊआ ओर बिना रा पाऊ रपायाह ऊआ, रपायाह रा एलासा ओर एलासा रा पाऊ आसेल ऊआ। <verse eid="1CH 9:43" /><verse number="44" style="v" sid="1CH 9:44" />ओर आसेलो रे छे पाऊ ऊए जिना रे नाओं यो थे, मतलब अज्रीकाम, बोकरू, इश्माएल, शरायाह, ओबद्याह ओर हानान; आसेलो रे यो ई पाऊ ऊए।<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s">राजा शाऊलो री मौत</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />तेबे पलिश्ती सिपाई इस्राएली सिपाईया साथे लड़े; ओर कई इस्राएली सिपाई पलिश्ती सिपाईया रे सामणे ते नठीगे। तेबे पलिश्तिये कई इस्राएली सिपाई गिलबो नाओं रे पाह्ड़ो पाँदे काईते। <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />फेर पलिश्ती सिपाई शाऊल ओर तेसरे पाऊआ पीछे लगे दे रये ओर पलिश्तिये शाऊलो रे पाऊ योनातान, अबीनादाब ओर मल्कीशूअ काईते। <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />शाऊलो साथे घमासान युद्ध ऊँदा रया ओर धनुर्धारिये तेस पाँदे आपणे तीर चलाए। तिने तीरे की शाऊल काईल ऊईगा। <verse eid="1CH 10:3" /><verse number="4" style="v" sid="1CH 10:4" />तेबे शाऊले आपणे अथियार टोणे वाल़े खे बोलेया, “आपणी तलवार निकयाल़ी की माँदे कोपी दे, केथी एड़ा नि ओ कि सेयो बिना खतना कित्ते रे लोक आई की मेरा मजाक करो” पर तेसरे अथियार टोणे वाल़े डरो रे मारे एड़ा करने ते ना करिती, तेबे शाऊल आपणी तलवार खड़ी करी की तेते पाँदे पड़ीगा। <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />ये देखी की कि शाऊल मरीगा दा तेसरा अथियार टोणे वाल़ा बी आपणी तलवारी पाँदे आपू पड़ी की मरी गा। <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />ईंयाँ शाऊल ओर तेसरे तीनो पाऊ ओर तेसरे कराने रे सारे लोक कट्ठे मरी गे। <verse eid="1CH 10:6" /><verse number="7" style="v" sid="1CH 10:7" />काट्टिया दे रणे वाल़े इस्राएली लोके देखेया कि इस्राएली सिपाई नठीगे। तिने देखेया कि शाऊल ओर तेसरे माठे बी मरीगे। तेसा तराईया दे रणे वाल़े सब इस्राएली माणूं आपणे-आपणे शईरो खे छाडी की नठीगे ओर पलिश्ती आई की तिना शईरा दे रणे लगे।<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />दूजे दिने जेबे पलिश्ती मरे दे सिपाईया रा माल लुटणे खे आए, तेबे तिना खे शाऊल ओर तेसरे पाऊ गिलबो रे पाह्ड़ो पाँदे पड़े दे मिले। <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />तेबे तिने तेसरे टाल्ले खोली की तेसरा सिर ओर अथियार लई ले ओर पलिश्तिया रे देशो दे सारी जगा दे दूत इजी खे पेजे, ताकि तिना रे देवतेया खे ओर आम माणूंआ खे ये शुभ सन्देश देंदे जाओ। <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />तेबे तिने शाऊलो रे अथियार आपणे मन्दरो दे राखे ओर तेसरी खोपड़ी दागोन देवते रे मन्दरो रे बारे लटकाई ती।<verse eid="1CH 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11" />जो कुछ बी पलिश्तिये शाऊलो साथे कित्तेया था तेतेरे बारे दे जेबे गिलाद इलाके रे याबेश शईरो दे रणे वाल़ेया सारेया लोके सुणेया, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />तेबे सारे शूरवीर मर्द गये ओर शाऊल ओर तेसरे पाऊआ री लाशा खे चकी की याबेश जगा दे ली आए ओर तिना री आड्डिया याबेश जगा दे एक बाँजो रे डाल़ो निठे दबाई तिया ओर साता दिना तक कुछ नि खाया। <verse eid="1CH 10:12" /><verse number="13" style="v" sid="1CH 10:13" />ईंयाँ शाऊल तेस विश्वासघातो रिया बजा ते मरीगा, जो तिने यहोवे साथे कित्तेया था; कऊँकि तिने यहोवे रा वचन टाल़ी ता था, तेबे तिने जादू-टोणा करने वाल़िया ते पूछी की सला लई थी। <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />तिने यहोवे ते नि पूछेया था, इजी बजा ते यहोवे से काई की राज्य यिशै रे पाऊ दाऊदो खे देईता।<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s">दाऊदो खे पूरे इस्राएलो रा राजा बणाया</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />तेबे सारे इस्राएली लोक हेब्रोन शईरो दे कट्ठे ऊई की दाऊदो गे आए। तिने दाऊदो खे बोलेया, “सुण, आसे लोक ओर तूँ एकी ई आड्ड ओर मास ए। <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />पईले जेबे शाऊल राजा आसा पाँदे राज करो था, तेबे बी लड़ाईया दे तूँ ई इस्राएली लोका ते आगे चलो था ओर तेरे यहोवा परमेशरे ताखे बोलेया कि मेरी इस्राएली प्रजा रा ग्वाल़ा ओर परदान तूँ ई ऊणा।”<note caller="+" style="f"><char style="fr" closed="false">11:2 </char><char style="ft" closed="false">मत्ती 2:6, पज. 78:71</char></note> <verse eid="1CH 11:2" /><verse number="3" style="v" sid="1CH 11:3" />इस्राएलो रे खास बुजुर्ग हेब्रोन शईरो दे दाऊदो गे आए ओर दाऊदे तिना खास बुजुर्गा साथे हेब्रोन शईरो दे यहोवे रे सामणे वाचा बानी ओर तिने यहोवे रे वचनो रे मुताबिक, जो तिने शमूएलो खे बोलेया था, इस्राएलो रा राजा ऊणे खे दाऊदो रा अभिषेक कित्तेया। <verse eid="1CH 11:3" /><verse number="4" style="v" sid="1CH 11:4" />तेबे दाऊद ओर सारे इस्राएली लोक यरूशलेम शईरो खे गए, तेस बखते यरूशलेम शईरो खे यबूसो रे नाओं ते जाणो थे। तेस शईरो दे रणे वाल़े लोक यबूसी थे। <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />तेबे यबूसो दे रणे वाल़ेया दाऊदो खे बोलेया, “तूँ एती आसा रे शईरो दे नि आई सकदा।” तेबे बी दाऊदे सेयो लड़ाईया दे अराईते। दाऊदे सिय्योन नाओं रा गढ़ आपणे कब्जे दे लई ला, तेतेखे ई दाऊदपुर बी बोलोए।<verse eid="1CH 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6" />तिना पाँदे अमला करने ते पईले दाऊदे बोलेया, “जो कोई यबूसिया ते लड़ाई करने खे सबी ते पईले जाओगा, से मां आपणी सारी सेना पाँदे परदान ठराणा, जेबे सरूयाह रे पाऊ योआबे ये सुणेया तेबे से सबी ते पईले यबूसिया पाँदे अमला करने खे आगे चलेया। ये देखी की दाऊदे से आपणी सारी सेना पाँदे परदान सेनापति बणाईता।” <verse eid="1CH 11:6" /><verse number="7" style="v" sid="1CH 11:7" />तिजी शईरो खे आपणे कब्जे दे लणे ते बाद दाऊद तेस शईरो दे रणे लगेया, इजी बजा ते तेस शईरो रा नाओं दाऊदपुर पड़ेया। <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />ओर तिने शईरो रे चऊँ कनारे, मतलब ऊँदले छज्जे<note caller="+" style="f"><char style="fr" closed="false">11:8 </char><char style="fq" closed="false">ऊँदले छज्जे </char><char style="ft" closed="false">मिल्लो </char></note> ते लई की चऊँ कनारे दवाल बणवाई ओर योआबे बाकी शईरो रे खण्डहर फेर बसाए। <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />ओर दाऊदो रा नाओं चऊँ कनारे फैलीगा कऊँकि सेना रा यहोवा परमेशर तेस साथे था।<verse eid="1CH 11:9" /></para>
  <para style="s">राजा दाऊदो रे शूरवीर सिपाई</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />यहोवे इस्राएलो रे बारे दे जो वचन बोलेया था, तिजी रे मुताबिक दाऊदो रा इस्राएल देशो रा राजा बणने खे कुछ शूरवीरे सबी इस्राएली लोका साथे मिली की तेसरा साथ दित्तेया था, तिना बीचा ते मुख्य मर्द यो ए।<verse eid="1CH 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 11:11" />दाऊदो रे शूरवीरा रे नाओं यो ए, मतलब एक याशोबाम जो हक्मोनीए रा पाऊ था, से दाऊदो रे खास तीईया जणेया बीचे बड़ा था, तिने आपणा भाल़ा चलाई की 300 दुश्मण एक ई बार काईते थे।<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />तेसते बाद एलीआजर था जो तीनो महान वीरा बीचा ते एक था से अहोही दोदो रा पाऊ था। <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />एलीआजर पसदम्मीमो दे दाऊदो साथे था। तेती पलिश्ती लोक युद्ध करने खे कट्ठे ऊए थे। तेती जौआ रा एक डोरू था। ये सेई जगा थी जेथा ते इस्राएली लोक पलिश्ती लोका रे सामणे ते नठीगे थे। <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />तेबे एलीआजारे तेस डोरूए दे खड़े ऊई की दाऊदो री रक्षा कित्ती ओर पलिश्ती काये ओर यहोवे पलिश्तिया खे अराणे खे इस्राएली लोका री बऊत बड़ी मताद कित्ती।<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />एक दिन दाऊद अदुल्लाम नाओं री गुफा गे था। तेती तेसगे तेसरे तीई मुख्य मर्दा बीचा ते तीन मर्द तेसगे लूकी की चट्टानी गे आए। कऊँकि पलिश्तिए आपणे डेरे रपाईम नाओं री तराईया दे खड़े करी राखे थे। <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />तेस बखते दाऊद गढ़ो दे था ओर तेस बखते पलिश्तिया री एक चौकी बेतलेहमो दे थी। <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />तेबे दाऊदे बड़ी इच्छा साथे बोलेया, “माखे बेतलेहमो रे बड़े द्वारो रे कुएँ रा पाणी केस पल़्याणा।” <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />तेबे तिने तीऊँ जणेया पलिश्तिया रे डेरे दे जाई की तिना पाँदे अमला कित्तेया ओर तिना बिछिए निकल़ी की बेतलेहमो रे बड़े द्वारो रे कुएँ ते पाणी परी की दाऊदो गे ली आए; पर दाऊदे पीणे खे ना कित्ती ओर यहोवे सामणे अर्घ करी की चढ़ाईता।<verse eid="1CH 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 11:19" />दाऊदे बोलेया, “मेरा परमेशर मांते एड़ा काम कदी नि कराओ, ये पाणी पीणे रा मतलब ए कि इना मर्दा रा खून पीणा, कऊँकि इने मर्दे आपणे प्राणो पाँदे खेली की माखे पाणी ल्याया। इजी री खातर तिने से पाणी पीणे ते ना करिती। इने तीऊँ वीरे यो ई काम कित्ते।”<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />योआबो रा पाई अबीशै था, से तीऊँ बीचे मुख्य था। तिने आपणा भाल़ा चलाई की 300 दुश्मण काये थे जेतेरिया बजा ते तिना तीऊँ बीचे तेसरा नाओं ऊईगा। <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />से तिना तीई मर्दा बीचे प्रतिष्ठित तो बणीगा था ओर तिना रा परदान बी ऊईगा था। पर तिना ते बी बड़े तीऊँ मर्दा बराबर नि बणेया था जो दाऊदो रे नेड़े रओ थे।<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />यहोयादो रा पाऊ बनायाह था, जो कबसेलो रे एक वीरो रा पाऊ था, जिने बड़े-बड़े काम कित्ते थे, तिने शेरो जेड़े दो मोआबी माणूं काये थे ओर ठण्डी रे बखते तिने एकी गड्डे रे उतरी की एक शेर काया था। <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />तेबे तिने एक मिस्री मर्द काया। से लगभग पाँज आथ लाम्बा मर्द था, तेस मिस्रिए रे आथो दे एक बऊत बड़ा ओर पारी भाल़ा था। से जुलाए री खड्डिया रिया लकड़िया रे बराबर मोटा था। पर बनायाहे एक डण्डा ई लई राखेया था, तेबे तिने मिस्रिए रे आथो ते भाल़ा छुड़ाई की तेसरे ई भाल़े साथे से काई ता। <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />एड़े-एड़े काम करी की यहोयादो रा पाऊ बनायाह तीना तीऊँ वीरा बीचे नामी ऊईगा। <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />से तो तीई जणेया बीचे प्रतिष्ठित था, पर मुख्य तीऊँ रे बराबर नि पऊँचेया। तेसखे दाऊदे आपणे अंगरक्षका रा परदान बणाया।<verse eid="1CH 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 11:26" />दाऊदो री सेना रे तीई वीर सिपाई यो थे, मतलब योआबो रा पाई असाहेल, बेतलेहम शईरो रे दोदो रा पाऊ एल्हानान, <verse eid="1CH 11:26" /><verse number="27" style="v" sid="1CH 11:27" />हरोरी शईरो रा शम्मोत, पलोनी शईरो रा हेलेस, <verse eid="1CH 11:27" /><verse number="28" style="v" sid="1CH 11:28" />तकोई शईरो रा इक्केशो रा पाऊ ईरा, अनातोत शईरो रा अबीएजेर, <verse eid="1CH 11:28" /><verse number="29" style="v" sid="1CH 11:29" />सिब्बकै शईरो रा हूशाई, अहोही शईरो रा ईलै, <verse eid="1CH 11:29" /><verse number="30" style="v" sid="1CH 11:30" />महरै शईरो रा नतोपाई, एक ओर नतोपाई बानाह रा पाऊ हेलेद, <verse eid="1CH 11:30" /><verse number="31" style="v" sid="1CH 11:31" />बिन्यामीनिया रे गिबा रे रणे वाल़े रीबै रा पाऊ इतै, पिरातोनी शईरो रा बनायाह, <verse eid="1CH 11:31" /><verse number="32" style="v" sid="1CH 11:32" />गाश जगा रे नाल़ेया गे रणे वाल़ा हूरै, अराबा दे रणे वाल़ा अबीएल, <verse eid="1CH 11:32" /><verse number="33" style="v" sid="1CH 11:33" />बहूरीमी, अज्मावेत, शालबोनी एल्यहबा, <verse eid="1CH 11:33" /><verse number="34" style="v" sid="1CH 11:34" />गीजोई शईरो रा हाशेमो रा पाऊ, तेबे हरारी शागे रा पाऊ योनातान, <verse eid="1CH 11:34" /><verse number="35" style="v" sid="1CH 11:35" />हरारी साकारो रा पाऊ अहीआम, ऊरो रा पाऊ एलीपाल, <verse eid="1CH 11:35" /><verse number="36" style="v" sid="1CH 11:36" />मकेराई हेपेर, पलोनी अहिय्याह, <verse eid="1CH 11:36" /><verse number="37" style="v" sid="1CH 11:37" />कर्मेली, हेस्रो एज्बैए रा पाऊ नारै, <verse eid="1CH 11:37" /><verse number="38" style="v" sid="1CH 11:38" />नातानो रा पाई योएल, हग्रीए रा पाऊ मिभार, <verse eid="1CH 11:38" /><verse number="39" style="v" sid="1CH 11:39" />अम्मोनी सेलेक, बेरोती नहरै जो सरूयाह रे पाऊ योआबो रा अथियार टोणे वाल़ा था, <verse eid="1CH 11:39" /><verse number="40" style="v" sid="1CH 11:40" />येतेरी ईरा ओर गारेब, <verse eid="1CH 11:40" /><verse number="41" style="v" sid="1CH 11:41" />हित्ती ऊरिय्याह, अहलैए रा पाऊ जाबाद, <verse eid="1CH 11:41" /><verse number="42" style="v" sid="1CH 11:42" />रूबेनी शीजा रा पाऊ अदीना जो रूबेनिया रा मुखिया था ओर तेस साथे तीई मर्द थे, <verse eid="1CH 11:42" /><verse number="43" style="v" sid="1CH 11:43" />माका रा पाऊ हानान, मेतेनी योशापात, <verse eid="1CH 11:43" /><verse number="44" style="v" sid="1CH 11:44" />अश्तारोती उजिय्याह, अरोएरी होतामो रा पाऊ शामा ओर यीएल, <verse eid="1CH 11:44" /><verse number="45" style="v" sid="1CH 11:45" />शिम्रीए रा पाऊ यदीएल ओर तेसरा पाई तीसी, योहा, <verse eid="1CH 11:45" /><verse number="46" style="v" sid="1CH 11:46" />महवीमी एलीएल, एलनामो रे पाऊ यरीबै ओर योशव्याह, मोआबी यित्मा, <verse eid="1CH 11:46" /><verse number="47" style="v" sid="1CH 11:47" />एलीएल, ओबेद ओर मसोबाई यासीएल।<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s">सिकलगो दे दाऊदो साथे बिन्यामीनी लोक</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />जेबे राजा दाऊद सिकलग शईरो दे कीशो रे पाऊ शाऊलो रे डरो रे मारे लूकी की रओ था, तेबे यो तेसगे तेती आए ओर यो तीना वीरा बीचा ते थे, जो युद्धो दे तेसरी मताद करने वाल़े थे। <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />ये धनुर्धारी थे, जो दाँणे-खूँजे, दुँईं आथो ते गूलेला दे पात्थर ओर धनुषो रे तीर चलाई सको थे ओर यो शाऊलो रे परिवारो रे बिन्यामीनी गोत्रो रे थे, तिना रे नाओं यो थे; <verse eid="1CH 12:2" /><verse number="3" style="v" sid="1CH 12:3" />मुख्य तो अहीएजेर ओर दूजा योआश था जो गिबा रे रणे वाल़े शमाआ रा पाऊ था; तेबे अज्माबेतो रे पाऊ यजीएल ओर पेलेत, तेबे बराका ओर अनातोती येहू, <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />ओर गिबोनी यिशमायाह जो तीईया बीचा ते एक वीर ओर तिना पाँदे परदान बी था; तेबे यिर्मयाह, यहजीएल, योहानान, गदेरा दे रणे वाल़ा योजाबाद, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />एलूजै, यरीमोत, बाल्याह, शेमर्याह, हारूपी शपत्याह, <verse eid="1CH 12:5" /><verse number="6" style="v" sid="1CH 12:6" />एल्काना, यिश्शिय्याह, अजरेल, योएजेर, याशोबाम, जो सारे कोरह रे कुलो रे थे,<verse eid="1CH 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 12:7" />ओर गदोर शईरो दे रणे वाल़ा यरोहामो रे पाऊ योएला ओर जबद्याह।<verse eid="1CH 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />फेर जेबे दाऊद जंगल़ो रे गढ़ो दे रओ था, तेबे यो गादी जो शूरवीर थे ओर युद्ध बिद्या सीखे रे ओर ढाल ओर भाल़े रा इस्तेमाल करने वाल़े थे ओर तिना रे मूँ शेरो जेड़े ओर सेओ पाह्ड़ी ईरणो जेड़े तेज दौड़ने वाल़े थे, यो ओरी गादिया ते लग ऊई की तेसगे आए, <verse eid="1CH 12:8" /><verse number="9" style="v" sid="1CH 12:9" />मतलब मुख्य तो एजेर, दूजा ओबद्याह, तीजा एलीआब, <verse eid="1CH 12:9" /><verse number="10" style="v" sid="1CH 12:10" />चौथा मिश्मन्ना, पाँजुआ यिर्मयाह, <verse eid="1CH 12:10" /><verse number="11" style="v" sid="1CH 12:11" />छठा अत्तै, सातुआ एलीएल, <verse eid="1CH 12:11" /><verse number="12" style="v" sid="1CH 12:12" />आठुआ योहानान, नऊआ एलजाबाद, <verse eid="1CH 12:12" /><verse number="13" style="v" sid="1CH 12:13" />दसुआ यिर्मयाह ओर ग्यारुआ मकबन्नै था, <verse eid="1CH 12:13" /><verse number="14" style="v" sid="1CH 12:14" />यो गाद गोत्रो रे मुख्य योद्धा थे, तिना बीचा ते जो सबी ते छोटा था, से तो 100 पाँदे परदान ओर जो सबी ते बड़ा था, से 1,000 पाँदे परदान था। <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />यो सेयो ईए, जो पईले मीन्ने दे जेबे यरदन नदी सबी कनारेया पाँदे-पाँदे बह्ओ थी, तेबे तेते ते पार उतरे ओर पूर्ब ओर पच्छम दुँईं तरफा रे सब तराईया रे रणे वाल़े नठाईते।<verse eid="1CH 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />कई जणे बिन्यामीनी ओर यहूदी बी दाऊदो गे गढ़ो दे आए। <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />तिना साथे मिलणे खे दाऊद निकल़ेया ओर तिना खे बोलेया, “जे तुसे मांगे मेल-जोलो रे नाते मेरी मताद करने खे आई रे, तेबे तो मेरा मन तुसा साथे लगेया रा रणा; पर जे तुसे माखे तोखा देई की मेरे दुश्मणा रे आथो दे पकड़वाणे आई रे, तो म्हारे पितरा रा परमेशर ये देखो ओर सजा देयो, कऊँकि मेरे आथो ते कोई उपद्रव नि ऊई रा।” <verse eid="1CH 12:17" /><verse number="18" style="v" sid="1CH 12:18" />तेबे आत्मा अमासै दे समाया, जो तीईया वीरा बीचे मुख्य था ओर तिने बोलेया, “ओ दाऊद! आसे तेरे ए; ओ यिशै रे पाऊ! आसे तेरी तरफा रे ए, तेरा पला ई पला ओ ओर तेरे मतदगारा रा कल्याण ओ, कऊँकि तेरा परमेशर तेसरी मताद करेया करोआ।” इजी री खातर दाऊदे सेयो राखी ते ओर आपणे दलो रे मुखिये ठराईते।<verse eid="1CH 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />फेर कुछ मनश्शे रे गोत्रो रे लोक बी तेस बखते दाऊदो गे नठीगे, जेबे दाऊद पलिश्तिया साथे ऊई की शाऊलो साथे लड़ने खे गया, पर दाऊद ओर तेसरे लोक पलिश्तिया री कोई मताद नि करी सके, कऊँकि पलिश्तिया रे सरदारा री सला लणे ते बाद ये बोली की दाऊद तेथा ते ये बोली की पेजीता, “जे ये आपणे स्वामी शाऊलो साथे फेर मिलीगा तो एस मारे सिर बाडी देणे।” <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />जेबे दाऊद सिकलगो खे जाणे लणी रा था, तेबे यो मनश्शे गोत्रो रे मर्द तेसगे नठी की आए; मतलब अदनह, योजाबाद, यदीएल, मीकाएल, योजाबाद, एलीहू ओर सिल्लतै जो मनश्शे रे ह्जारा सिपाईया पाँदे मुखिये थे। <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />इने लूटेरेया रे दलो रे खलाफ दाऊदो री मताद कित्ती, कऊँकि यो सारे शूरवीर थे ओर सेना रे परदान बी बणीगे। <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />बल्कि हर रोज लोक दाऊदो री मताद करने खे तेसगे आया करो थे, एथो तक कि परमेशरो री सेना जेड़ी एक बड़ी ओर तागतबर सेना बणीगी। <verse eid="1CH 12:22" /><verse number="23" style="v" sid="1CH 12:23" />तेबे योद्धा लड़ने खे अथियार बानी की हेब्रोनो दे दाऊदो गे इजी खे आए कि यहोवे रे वचनो रे मुताबिक शाऊलो रा राज्य तेसरे आथो दे करी देयो; तिना रे मुखिया री गिणती ये ए।<verse eid="1CH 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 12:24" />यहूदा गोत्रो रे योद्धा ढाल ओर भाल़ा लई की 6,800 अथियार बानी की लड़ने खे आए।<verse eid="1CH 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 12:25" />शिमोनी गोत्रो रे 7,100 त्यार शूरवीर लड़ने खे आए।<verse eid="1CH 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 12:26" />लेवी गोत्रो रे 4,600 शूरवीर आए।<verse eid="1CH 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 12:27" />ओर हारूणो रे कराने रा परदान यहोयादा था ओर तेस साथे 3,700 योद्धा आए।<verse eid="1CH 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 12:28" />ओर सादोक नाओं रा एक जवान वीर बी आया ओर तेसरे बाओ रे कराने रे बाई परदान आए।<verse eid="1CH 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 12:29" />ओर शाऊलो रे परिवारो रे बिन्यामीनिया बीचा ते 3,000 योद्धा आए, कऊँकि तेस बखतो तक आदे बिन्यामीनिया ते जादा शाऊलो रे कराने रा पक्ष करदे रये।<verse eid="1CH 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 12:30" />तेबे एप्रैमो रे गोत्रो बीचा ते बड़े वीर ओर आपणे-आपणे पितरा रे करानेया रे नामी योद्धा 20,800 आए।<verse eid="1CH 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 12:31" />मनश्शे रे आदे गोत्रो बीचा ते दाऊदो खे राजा बनाणे खे 18,000 योद्धा आए, जिना रे नाओं बताए थे।<verse eid="1CH 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 12:32" />इस्साकार गोत्रो रे लोका बीचा ते जो बखतो खे पछयाणो थे कि इस्राएलो खे क्या करना चाईयो, तिना रे परदान 200 थे; ओर तिना रे सारे पाई तिना री मानो थे।<verse eid="1CH 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 12:33" />तेबे जबूलून गोत्रो रे लोका बीचा ते युद्धो रे सब प्रकारा रे अथियार लई की लड़ने खे पंग्ति बानणे वाल़े योद्धा 50,000 आए, सेयो पंग्ति बानणे वाल़े थे ओर चंचल नि थे।<verse eid="1CH 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 12:34" />तेबे नप्ताली गोत्रो रे लोका बीचा ते परदान तो 1,000 ओर तिना साथे ढाल ओर भाल़ा लई की 37,000 योद्धा आए।<verse eid="1CH 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 12:35" />दान गोत्रो रे लोका बीचा ते लड़ने खे पंग्ति बानणे वाल़े 28,600 योद्धा आए।<verse eid="1CH 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CH 12:36" />ओर आशेर गोत्रो रे लोका बीचा ते पंग्ति बानणे वाल़े 40,000 योद्धा आए।<verse eid="1CH 12:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 12:37" />ओर यरदनो ते पार रणे वाल़े रूबेन ओर गाद गोत्रो रे लोक ओर मनश्शे रे आदे गोत्रो रे लोका बीचा ते युद्धो रे सारे अथियार लई की 120,000 योद्धा आए।<verse eid="1CH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38" />यो सारे युद्ध करने खे पंग्ति बानणे वाल़े दाऊदो खे सारे इस्राएलो रा राजा बनाणे खे हेब्रोनो दे सच्चे मनो ते आए ओर सारे इस्राएली लोक बी दाऊदो खे राजा बनाणे खे त्यार थे। <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />सेयो तेथी तीऊँ दिना तक दाऊदो साथे खांदे-पींदे रये, कऊँकि तिना रे पाईए तिना खे त्यारी कित्ती थी, <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />तेबे जो तिना रे नेड़े बल्कि इस्साकार, जबूलून ओर नप्तालिया रिया जगा तक रओ थे, सेयो बी गह्दे, ऊँट, खच्चर ओर बल़दा पाँदे मैदा, दाऊगल़े ओर किशमिशा रिया टिक्किया, शराब ओर तेल बगैरा खाणे रिया चीजा लादी की ल्याये ओर बल़द ओर पेडा-बाकरिया बऊत जादा ल्याये; कऊँकि इस्राएलो रे सारे देशो दे सब लोक बऊत खुश थे।<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s">पवित्र सन्दूको रा यरूशलेम शईरो दे ल्याया जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />एकी दिने दाऊदे आपणिया सेना रे सब बड़े अधिकारी ओर परदाना ते गल्ल बात कित्ती। <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />तेबे दाऊदे इस्राएलो री सारी मण्डल़िया खे बोलेया, “जे ये तुसा खे ठीक लगो ओर म्हारे परमेशरो री बी एई इच्छा ओ, तो आओ आसे आपणे तिना सबी पाईया गे जो इस्राएलो रे सारे देशो दे रओए, चाए सेयो पुरोईत ओ या लेवी तिना सबी गे ये सन्देसा पेजूँए कि सेओ एते शईरो दे आसा गे कट्ठे ऊई जाओ, <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />ओर आसे आपणे परमेशरो रे सन्दूको खे आपू गे ली आऊँए; कऊँकि शाऊलो रे दिना दे आसे तेतेरे नेड़े नि जाऊँ थे।” <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />ओर सारी मण्डल़िए बोलेया, जेड़ा तूँ बोलेया आसा तेड़ा ई करना, कऊँकि ये गल्ल तिना सबी लोका खे ठीक लगी। <verse eid="1CH 13:4" /><verse number="5" style="v" sid="1CH 13:5" />तेबे दाऊदे मिस्रो री शीहोर नदिया ते लई की हमातो री काट्टिया तको रे सारे इस्राएली लोक इजी खे कट्ठे कित्ते, ताकि परमेशरो रे सन्दूको खे किर्यत्यारीम शईरो ते ल्याओ। <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />तेबे दाऊद सारे इस्राएली लोका खे साथे लई की बाला शईरो खे गया, जेतेखे किर्यत्यारीम शईर बी बोलोए ओर से यहूदा गोत्रो रे इस्से दे था ताकि परमेशर यहोवे रा सन्दूक तेथा ते ल्याओ; से तो करूबा पाँदे विराजणे वाल़ा ए ओर तेसरा नाओं बी येई लया जाओआ।<verse eid="1CH 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7" />तेबे तिने परमेशरो रा सन्दूक एक नई गडिया दे चढ़ाई की अबीनादाबो रे कअरो ते काडेया ओर उज्जा ओर अह्यो तेसा गडिया खे चलाणे लगे। <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />दाऊद ओर सारे इस्राएली लोक परमेशरो रे सामणे तनो-मनो ते गीत गांदे ओर बीणा, सारंगी, डफ, खंजरी ओर तुरहिया बजाणे लगी रे थे।<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />जेबे सेयो किदोन किसानो रे खल्याणो तक आए, तेबे बल़दा रे पैरो दे ठोकर लगी। ये देखी की उज्जे आपणा आथ सन्दूक पकड़ने खे आगे कित्तेया ओर से पकड़ेया। <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />तेबे यहोवे रा कोप उज्जे पाँदे पड़केया ओर तिने उज्जे पाँदे अमला कित्तेया ओर से थाले पड़ीगा, कऊँकि तिने आपणे आथो साथे से सन्दूक पकड़ेया था; ओर से तेथी परमेशरो सामणे मरी गा।<verse eid="1CH 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11" />तेबे दाऊद दु:खी ऊईगा, इजी खे कि यहोवा उज्जे पाँदे पड़केया था; ओर तिने तेसा जगा रा नाओं पेरेसुज्जा राखेया, ये नाओं आजो तक बणेया रा ए। <verse eid="1CH 13:11" /><verse number="12" style="v" sid="1CH 13:12" />तेस दिने दाऊद परमेशरो ते डरी की बोलणे लगेया, “आऊँ परमेशरो रे सन्दूको खे आपू गे किंयाँ लई जाऊँ?” <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />तेबे दाऊद सन्दूको खे आपू गे दाऊदो रे शईरो दे नि ल्याया, पर दाऊद तेस सन्दूको खे गत जगा दे रणे वाल़े ओबेदेदोम नाओं रे माणूंए रे कअरे लईगा। <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />ओर परमेशरो रा सन्दूक ओबेदेदोमो गे तेसरे कराने दे तीन मीन्ने तक रया ओर यहोवे ओबेदेदोमो रे कराने पाँदे ओर जो कुछ तेसरा था तेते पाँदे बी आशीष दित्ती।<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s">दाऊदो रा मईल ओर परिवार</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />तेबे सोर शईरो रे राजा हीरामे दाऊदो गे दूत पेजे ओर तेसखे मईल बनाणे खे देवदारो री लकड़ी, राजमिस्त्री ओर ल्वार पेजे। <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />तेबे दाऊदो खे निश्चा ऊईगा कि यहोवे से इस्राएलो रा राजा ऊणे खे चूणी ला रा ए, कऊँकि परमेशरे तेसरा राज्य बऊत बढ़ाया था, ओर तिने इस्राएलो रे लोका री मताद कित्ती। <verse eid="1CH 14:2" /><verse number="3" style="v" sid="1CH 14:3" />यरूशलेम शईरो दे दाऊदे फेर ओरी जवाणसा साथे ब्या करी ला ओर तिना रे ओर बी माठे-बेटिया पैदा ऊए। <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />दाऊदो रे जो ल्वाद यरूशलेम शईरो दे पैदा ऊई, तिना रे नाओं यो ए: शम्मू, शोबाब, नातान, सुलैमान; <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />यिभार, एलीशू, एलपेलेत; <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />नोगह, नेपेग, यापी, एलीशामा, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />बेल्यादा ओर एलीपेलेत।<verse eid="1CH 14:7" /></para>
  <para style="s">दाऊदो रा पलिश्तिया खे अराणा</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />जेबे पलिश्तिये सुणेया कि पूरे इस्राएलो रा राजा ऊणे खे दाऊदो रा अभिषेक ऊआ, तेबे सारे पलिश्ती दाऊदो रिया टोल़ा दे लगी गे; जेबे दाऊदे ये सुणेया तेबे से तिना ते लड़ने लगेया। <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />तेबे पलिश्ती आए ओर रपाईम नाओं री तराईया दे अमला कित्तेया।<verse eid="1CH 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 14:10" />तेबे दाऊदे परमेशरो ते पूछेया, “क्या आऊँ पलिश्तिया पाँदे अमला करुँ? क्या तां सेयो मेरे आथो दे करी देणे?” यहोवे तेसखे बोलेया, “अमला कर, कऊँकि मां सेयो तेरे आथो दे करी देणे।” <verse eid="1CH 14:10" /><verse number="11" style="v" sid="1CH 14:11" />इजी खे जेबे पलिश्ती बालपरासीम जगा दे आए, तेबे दाऊदे तिना पाँदे अमला कित्तेया ओर सेयो तेथी काईते; तेबे दाऊदे बोलेया, “परमेशर मेरे जरीये मेरे दुश्मणा पाँदे पाणिए री खाड्डा जेड़ा पड़ी रा।” इजी बजा ते तेसा जगा रा नाओं बालपरासीम<note caller="+" style="f"><char style="fr" closed="false">14:11 </char><char style="fq" closed="false">बालपरासीम </char><char style="ft" closed="false">टुट पड़ने री जगा</char></note> राखेया। <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />तेती सेयो आपणे देवतेया खे छाडी गे ओर दाऊदो री आज्ञा ते सेयो देवते आग लगाई की फूकी ते।<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />फेर दूजी बार पलिश्तिये तेसा ई तराईया दे आई की अमला कित्तेया। <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />तेबे दाऊदे परमेशरो ते फेर पूछेया ओर परमेशरे तेसखे बोलेया, “तिना रा पीछा नि कर; तिना ते फिरी की तूतो रे डाल़ा सामणे ते तिना पाँदे लूकी की अमला कर। <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />ओर जेबे तूतो रे डाल़ा बीचा ते सेना रे चलणे री जी आवाज ताखे सुणने लगो, तेबे ये जाणी की युद्ध करने खे निकल़ी जाणा कि परमेशर पलिश्तिया री सेना खे काणे खे तांते आगे जाणे लगी रा।”<verse eid="1CH 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 14:16" />परमेशरो री एसा आज्ञा रे मुताबिक दाऊदे कित्तेया ओर इस्राएलिये पलिश्तिया री सेना गिबोन शईरो ते लई की गेजेर शईरो तक काईती। <verse eid="1CH 14:16" /><verse number="17" style="v" sid="1CH 14:17" />तेबे दाऊदो रा नाओं सारे देशो दे फैलीगा ओर यहोवे सबी जातिया रे मनो दे तेसरा डर परी ता।<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s">पवित्र सन्दूको रा यरूशलेम शईरो दे वापस आऊणा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />तेबे दाऊदे दाऊदपुरो दे मईल बणवाए ओर परमेशरो रे सन्दूको खे एक जगा त्यार करी की एक तम्बू खड़ा कित्तेया। <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />तेबे दाऊदे बोलेया, “लेविया खे छाडी की ओर केसी खे परमेशरो रा सन्दूक नि चकणा चाईयो, कऊँकि यहोवे सेयो इजी खेई चूणी राखे, ताकि सेयो परमेशरो रा सन्दूक चको ओर तेसरी सेवा-टईल़ सदा करेया करो।” <verse eid="1CH 15:2" /><verse number="3" style="v" sid="1CH 15:3" />तेबे दाऊदे सारे इस्राएली यरूशलेम शईरो दे इजी खे कट्ठे कित्ते, ताकि यहोवे रा सन्दूक तेते जगा दे पऊँचाओ, जो तिने तेते सन्दूको खे राखणे खे त्यार कित्ती थी।<verse eid="1CH 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 15:4" />इजी री खातर दाऊदे हारूणो री ल्वादा ओर लेवी लोक कट्ठे कित्ते। <verse eid="1CH 15:4" /><verse number="5" style="v" sid="1CH 15:5" />मतलब कहातिया रे कुलो ते 120 लोक थे। तिना रा मुखिया ऊरीएल नाओं रा माणूं था।<verse eid="1CH 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 15:6" />मरारिया रे कुलो ते 220 लोक थे। तिना रा मुखिया असायाह नाओं रा माणूं था।<verse eid="1CH 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 15:7" />गेर्शोमिया रे कुलो ते 130 लोक थे। तिना रा मुखिया योएल नाओं रा माणूं था।<verse eid="1CH 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 15:8" />एलीसापानिया रे कुलो ते 200 लोक थे। तिना रा मुखिया शमायाह नाओं रा माणूं था।<verse eid="1CH 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 15:9" />हेब्रोनिया रे कुलो ते 80 लोक थे। तिना रा मुखिया एलीएल नाओं रा माणूं था।<verse eid="1CH 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 15:10" />उज्जीएलिया रे कुलो ते 112 लोक थे। तिना रा मुखिया अम्मीनादाब नाओं रा माणूं था।<verse eid="1CH 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />तेबे दाऊदे सादोक ओर एब्यातार नाओं रे पुरोईतो खे ओर ऊरीएल, असायाह, योएल, शमायाह, एलीएल ओर अम्मीनादाब नाओं रे लेविया खे बुलाई की तिना खे बोलेया, <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />“तुसे तो लेविया रे पितरा रे कराने रे खास मर्द ए; इजी री खातर आपणे पाईया समेत आपू-आपू खे पवित्र करो, ताकि तुसे इस्राएलो रे परमेशर यहोवे रा सन्दूक तेसा जगा दे पऊँचाई सको जो मैं तेसरिया तँईं त्यार करी राखी। <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />कऊँकि तुसे पिछली बार से नि चकेया था इजी बजा ते म्हारे यहोवा परमेशरे आसा खे सजा दित्ती, कऊँकि आसे से बिधि-बिधानो ते नि ल्याया था।”<verse eid="1CH 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 15:14" />तेबे पुरोईते ओर लेविये आपणे आपू खे पवित्र कित्तेया, ताकि इस्राएलो रे परमेशर यहोवे रा सन्दूक लई जाई सको। <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />तेबे तेसा आज्ञा रे मुताबिक जो मूसे परमेशरो रा वचन सुणी की दित्ती थी, लेविये सन्दूक डण्डेया रे पारे आपणी कान्दा पाँदे चकी ता। <verse eid="1CH 15:15" /><verse number="16" style="v" sid="1CH 15:16" />तेबे दाऊदे लेविया रे मुखिया खे आज्ञा दित्ती कि आपणे गाणे वाल़े पाईया खे बाजे, मतलब सारंगी, बीणा ओर खंजरी देई की बजाणे ओर खुशिया साथे ऊच्ची आवाजा दे गाणे खे नियुक्त करो। <verse eid="1CH 15:16" /><verse number="17" style="v" sid="1CH 15:17" />तेबे लेविये योएलो रा पाऊ हेमान ओर तेसरे पाईया बीचा ते बेरेक्याह रा पाऊ आसाप, ओर आपणे पाई मरारिया रे कुलो ते कूशायाह रा पाऊ एतान ठराया। <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />तिना साथे तिने दूजे पदो रे आपणे पाईया खे, मतलब जकर्याह, बेन, याजीएल, शमीरामोत, यहीएल, उन्नी, एलीआब, बनायाह, मासेयाह, मत्तित्याह, एलीपलेह, मिकनेयाह ओर ओबेदेदोम ओर यीएलो खे, जो द्वारपाल थे ठराए। <verse eid="1CH 15:18" /><verse number="19" style="v" sid="1CH 15:19" />ईंयाँ हेमान, आसाप ओर एतान नाओं रे गाणे वाल़े तो पीतल़ी री खंजरी बजाई-बजाई की राग चलाणे लगे; <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />ओर जकर्याह, अजीएल, शमीरामोत, यहीएल, उन्नी, एलीआब, मासेयाह ओर बनायाह, अलामोत नाओं रे रागो रे सारंगी बजाणे खे <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />ओर मत्तित्याह, एलीपलेह, मिकनेयाह ओबेदेदोम, यीएल ओर अज्जयाह बीणा खर्ज छेड़ने खे ठराए। <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />ओर राग चकणे रा अधिकारी कनन्याह नाओं रा लेविया रा परदान था, से राग चकणे रे बारे दे शिक्षा देयो था, कऊँकि से जाणकार था। <verse eid="1CH 15:22" /><verse number="23" style="v" sid="1CH 15:23" />ओर बेरेक्याह ओर एलकाना सन्दूको रे द्वारपाल थे। <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />ओर शबन्याह, योशापात, नतनेल, अमासै, जकर्याह, बनायाह ओर एलीएजेर नाओं रे पुरोईत परमेशरो रे सन्दूको ते आगे-आगे तुरहिया बजांदे ऊए चले ओर ओबेदेदोम ओर यहिय्याह तेसरे द्वारपाल थे; <verse eid="1CH 15:24" /><verse number="25" style="v" sid="1CH 15:25" />तेबे दाऊद ओर इस्राएली लोका रे बुजुर्ग ओर सारे सेनापति मिली की यहोवे री वाचा रा सन्दूक ओबेदेदोमो रे कअरो ते बऊत खुशिया साथे ल्याऊणे खे गये। <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />जेबे परमेशरे लेविया री मताद कित्ती जो यहोवे री वाचा रा सन्दूक चकणे वाल़े थे, तेबे तिने सात बल़द ओर सात खाडू बलि कित्ते।<verse eid="1CH 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 15:27" />दाऊद ओर यहोवे री वाचा रा सन्दूक चकणे वाल़े सब लेविये ओर गाणे वाल़े ओर गाणेवाल़ेया साथे राग चकणे वाल़ेया रा परदान कनन्याह था, इने सबी रेशमो रे चोगे पईनी राखे थे ओर दाऊदे रेशमो रे टाल्ले रा चोगा पईनी राखेया था। <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />ईंयाँ सारे इस्राएली यहोवे री वाचा रा सन्दूक जयजयकार करदे ओर रड़सिंगे, तुरहिया ओर खंजरी बजांदे ओर सारंगिया ओर बीणा बजांदे ऊए लई चले। <verse eid="1CH 15:28" /><verse number="29" style="v" sid="1CH 15:29" />जेबे यहोवे री वाचा रा सन्दूक राजा दाऊदो रे शईरो दे पऊँचेया, तेबे शाऊलो री बेटी मीकले द्वारिया बीचा ते चाँकी की दाऊदो खे उटकदे ओर नाचदे ऊए देखेया ओर तेसे से मनो ई मनो दे बेकार जाणेया।<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="s">सन्दूको रा तम्बूए दे राखणा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />तेबे लेवी वंशो रे लोके परमेशरो रा सन्दूक ल्याई की तेस तम्बूए दे राखेया, जो दाऊदे तेतेखे बणाया था। फेर दाऊदे परमेशरो सामणे होमबलि ओर मेलबलि चढ़ाए। <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />जेबे दाऊद होमबलि ओर मेलबलि चढ़ाई चुकेया, तेबे तिने यहोवे रे नाओं ते प्रजा खे आशीर्वाद दित्तेया। <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />तेबे तिने क्या मर्द, क्या जवाणस, सारे इस्राएली लोका खे एक-एक रोटी ओर एक-एक टुकड़ा मास ओर किशमिशा री एक-एक टिक्की बँडवाई ती।<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />तेबे दाऊदे यहोवे रे सन्दूको रे सामणे सेवा-टईल करने खे कुछ लेवी लोक ठराईते। तिने सेयो इस्राएलो रे परमेशर यहोवे रे कामो री चर्चा ओर तेसरा तन्यवाद ओर स्तुति करने खे ठराए। <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />तिना रा मुखिया आसाप था ओर तेसते बाद जकर्याह था, तेबे यीएल, शमीरामोत, यहीएल, मत्तित्याह, एलीआब, बनायाह, ओबेदेदोम ओर यीएल थे; इने तो सारंगिया ओर बीणा लई राखिया थिया ओर आसाप खंजरिया पाँदे राग बजाओ था। <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />बनायाह ओर यहजीएल नाओं रे पुरोईत परमेशरो री वाचा रे सन्दूको सामणे हमेशा रड़सिंगे बजाणे खे चूणी राखे थे।<verse eid="1CH 16:6" /></para>
  <para style="s">दाऊदो रे जरिये तन्यवादो रा गीत</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />तेबे तेस ई दिने दाऊदे यहोवे रा तन्यवाद करने रा काम आसाप ओर तेसरे पाईया गे सम्बाल़ी ता।<verse eid="1CH 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="1CH 16:8" />यहोवे रा तन्यवाद करो, तेसते प्रार्थना करो;</para>
  <para style="q" vid="1CH 16:8">सबी देशा दे तेसरे कामो रा प्रचार करो।<verse eid="1CH 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="1CH 16:9" />तेसरा गीत गाओ, तेसरा पजन करो,</para>
  <para style="q" vid="1CH 16:9">तेसरे सारे अचम्बे रे कामो रा त्यान करो।<verse eid="1CH 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="1CH 16:10" />यहोवे रे पवित्र नाओं री महिमा करो,</para>
  <para style="q" vid="1CH 16:10">यहोवे खे टोल़ने वाल़ेया रे काल़जे खे शान्ति मिलो।<verse eid="1CH 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="1CH 16:11" />यहोवा ओर तेसरी सामर्था खे टोल़ो;</para>
  <para style="q" vid="1CH 16:11">तेसरा दर्शण पाणे खे लगातार मईणत करदे रओ।<verse eid="1CH 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="1CH 16:12" />तेसरे कित्ते रे अचम्बे रे काम,</para>
  <para style="q" vid="1CH 16:12">तेसरे चमत्कार ओर न्याय रे वचन याद करो।<verse eid="1CH 16:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="1CH 16:13" />ओ तेसरे दास इस्राएलो रे कुल,</para>
  <para style="q" vid="1CH 16:13">ओ याकूबो री ल्वाद तुसे जो तेसरे चूणे रे ए!<verse eid="1CH 16:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="1CH 16:14" />सेई म्हारा यहोवा परमेशर ए,</para>
  <para style="q" vid="1CH 16:14">तेसरे न्याय रे काम पूरी तरतिया पाँदे ओए।<verse eid="1CH 16:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="1CH 16:15" />तेसरी वाचा खे सदा याद राखो,</para>
  <para style="q" vid="1CH 16:15">ये सेई वचन ए जो तिने ह्जार पीढ़िया खे ठराईता।<verse eid="1CH 16:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="1CH 16:16" />से वाचा जो तिने अब्राहमो साथे बानी</para>
  <para style="q" vid="1CH 16:16">ओर तेसरे ई बारे दे तिने इसहाको ते कसम खाई,<verse eid="1CH 16:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="1CH 16:17" />ओर तेसखे तिने याकूबो खे बिदि करी की</para>
  <para style="q" vid="1CH 16:17">ओर इस्राएलो खे सदा री वाचा बानी की ये बोली की मजबूत कित्ती,<verse eid="1CH 16:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="1CH 16:18" />तिने बोलेया, “मां कनान देश ताखे ई देणा,</para>
  <para style="q" vid="1CH 16:18">से बांडा दे तेरा आपणा इस्सा ऊणा।”<verse eid="1CH 16:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="1CH 16:19" />तेस बखते तो तुसे गिणतिया दे थोड़े थे, बल्कि बऊत ई थोड़े</para>
  <para style="q" vid="1CH 16:19">ओर तेस देशो दे परदेशी थे।<verse eid="1CH 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="1CH 16:20" />ओर सेयो एकी जातिया ते दूजी जातिया दे,</para>
  <para style="q" vid="1CH 16:20">ओर एकी देशो ते दूजे देशो दे फिरदे तो रये,<verse eid="1CH 16:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="1CH 16:21" />पर तिने केसी माणूंए खे तिना पाँदे अन्देर नि करने दित्तेया</para>
  <para style="q" vid="1CH 16:21">ओर से राजेया खे तिना रिया तँईं ये तमकी देयो था,<verse eid="1CH 16:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="1CH 16:22" />“मेरे अभिषिक्ता खे नि छूँओ</para>
  <para style="q" vid="1CH 16:22">ओर ना ई मेरे नबिया रा नुकशाण करो।”<verse eid="1CH 16:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="1CH 16:23" />ओ सारी तरतिया रे लोको, यहोवे रा गीत गाओ।</para>
  <para style="q" vid="1CH 16:23">हर दिन तेसरे कित्ते रे उद्धारो रा शुभ सन्देश सुणाओ।<verse eid="1CH 16:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="1CH 16:24" />दूजी जातिया बीचे तेसरी महिमा रा</para>
  <para style="q" vid="1CH 16:24">ओर देशो-देशो रे लोका गे तेसरे अचम्बे रे कामो रे बारे बताओ।<verse eid="1CH 16:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="1CH 16:25" />कऊँकि यहोवा महान ओर स्तुतिया जोगा ए,</para>
  <para style="q" vid="1CH 16:25">से तो सबी देवतेया ते जादा डरो जोगा ए।<verse eid="1CH 16:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="1CH 16:26" />कऊँकि देशो-देशो रे सब देवता मूर्तिया ई ए;</para>
  <para style="q" vid="1CH 16:26">पर यहोवे ई स्वर्ग बणाई राखेया।<verse eid="1CH 16:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="1CH 16:27" />तेसरे चऊँ कनारे एशो अराम ए;</para>
  <para style="q" vid="1CH 16:27">तेसरिया जगा दे सामर्थ ओर खुशी ए।<verse eid="1CH 16:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="1CH 16:28" />ओ देशो-देशो रे कुलो, यहोवे रे कामा रा बखाण करो,</para>
  <para style="q" vid="1CH 16:28">यहोवे री महिमा ओर सामर्था खे मानो।<verse eid="1CH 16:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="1CH 16:29" />यहोवे रे नाओं री महिमा एड़ी मानो जो तेसरे नाओं जोगी ए।</para>
  <para style="q" vid="1CH 16:29">पेंट लई की तेस सामणे आओ, पवित्र ऊई की यहोवे गे माथा टेको।<verse eid="1CH 16:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="1CH 16:30" />ओ सारी तरतिया रे लोको, तेस सामणे थरथराओ!</para>
  <para style="q" vid="1CH 16:30">दुनिया एड़ी पक्की ए कि से टल़ी नि सकदी।<verse eid="1CH 16:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="1CH 16:31" />सर्ग खुशी मनाओ ओर तरती मगन ओ</para>
  <para style="q" vid="1CH 16:31">ओर जातिया-जातिया रे लोक बोलो, “यहोवा राजा ऊई रा।”<verse eid="1CH 16:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="1CH 16:32" />समुद्र ओर तेते बीचलिया सारिया चीजा गरजो,</para>
  <para style="q" vid="1CH 16:32">मैदान ओर जो कुछ तिदे ए, सब खुश ओ।<verse eid="1CH 16:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="1CH 16:33" />तेस ई बखते बणो रे डाल़ यहोवे सामणे जयजयकार करो,</para>
  <para style="q" vid="1CH 16:33">कऊँकि से तरतिया रा न्याय करने खे आऊणे वाल़ा ए।<verse eid="1CH 16:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="1CH 16:34" />यहोवे रा तन्यवाद करो, कऊँकि से खरा ए;</para>
  <para style="q" vid="1CH 16:34">तेसरी करूणा सदा री ए।<verse eid="1CH 16:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="1CH 16:35" />ओर ये बी बोलो, “ओ म्हारे उद्धार करने वाल़े परमेशर, म्हारा उद्धार कर</para>
  <para style="q" vid="1CH 16:35">ओर आसा खे कट्ठा करी की दूजी जातिया ते छुड़ा,</para>
  <para style="q" vid="1CH 16:35">ताकि आसे तेरे पवित्र नाओं रा तन्यवाद करुँ</para>
  <para style="q" vid="1CH 16:35">ओर तेरी स्तुति करदे ऊए तेसरे बारे तारीफ करुँ।<note caller="+" style="f"><char style="fr" closed="false">16:35 </char><char style="ft" closed="false">पज. 106:47</char></note><verse eid="1CH 16:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="1CH 16:36" />शुरूओ ते लई की अनन्तकालो तक इस्राएलो रा यहोवा परमेशर तन्य ए।”</para>
  <para style="q" vid="1CH 16:36">तेबे प्रजा रे सबी लोके “आमीन्” बोलेया ओर यहोवे री स्तुति कित्ती।<note caller="+" style="f"><char style="fr" closed="false">16:36 </char><char style="ft" closed="false">पज. 106:48</char></note><verse eid="1CH 16:36" /></para>
  <para style="s">यरूशलेम ओर गिबोनो दे आराधना</para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />तेबे दाऊदे तेथी यहोवे री वाचा रे सन्दूको सामणे आसाप ओर तेसरे पाई छाडी ते, ताकि हर रोज सेयो सन्दूको सामणे सदा तेसरी सेवा-टईल करेया करो, <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />यदूतूनो रा पाऊ ओबेदेदोम ओर तेसरे कुलो रे ठाठ माणूं तिना री मताद करने खे थे। होसा ओर ओबेदेदोम बड़े द्वारा री रखवाल़ी करने वाल़ेया रे अधिकारी थे। <verse eid="1CH 16:38" /><verse number="39" style="v" sid="1CH 16:39" />तेबे दाऊदे सादोक पुरोईत ओर तेसरे पुरोईत पाई यहोवे रे तम्बूए गे छाडी ते, जो गिबोन पाह्ड़ो रिया ऊच्ची जगा पाँदे था। <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />ताकि सेयो प्यागा-साँजा होमबलिया री बेदिया पाँदे यहोवे खे होमबलि चढ़ाया करो ओर तेस यहोवे रे बिधानो रे मुताबिक करेया करो, जो तिने इस्राएली लोका खे देई राखेया था। <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />ओर तिना साथे तिने हेमान ओर यदूतून ओर दूजे लोक बी जो नाओं लई की चूणे थे ठराईते, ताकि यहोवे री सदा री करूणा रिया बजा ते तेसरा तन्यवाद करो। <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />ओर तिना साथे तिने हेमान ओर यदूतून बजाणे वाल़ेया खे तूरहिया ओर खंजरी ओर परमेशरो रे गीत गाणेवाल़ेया खे बाजे दित्ते ओर यदूतूनो रे पाऊ बड़े द्वारो री रखवाल़ी करने वाल़ेया रे अधिकारी ठराईते। <verse eid="1CH 16:42" /><verse number="43" style="v" sid="1CH 16:43" />तेबे इस्राएली प्रजा रे सारे लोक आपणे-आपणे कअरे चली गे ओर दाऊद आपणे कराने खे आशीर्वाद देणे खे प्रार्थना करने खे वापस ऊईगा।<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s">दाऊदो साथे परमेशरो रा वादा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />जेबे दाऊद आपणे मईलो दे रणे लगेया, तेबे दाऊदे नातान नबीए खे बोलेया, “देख, आऊँ देवदारा रे बणे दे कअरो दे रऊँआ, पर यहोवे री वाचा रा सन्दूक तम्बूए दे रओआ।” <verse eid="1CH 17:1" /><verse number="2" style="v" sid="1CH 17:2" />नाताने दाऊदो खे बोलेया, “जो कुछ तेरे मनो दे ओ, से कर, कऊँकि परमेशर तां साथे ए।”<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />तेस ई दिने राथियो खे परमेशरो रा वचन नातानो गे पऊँचेया, जाई की मेरे दास दाऊदो खे बोल, <verse eid="1CH 17:3" /><verse number="4" style="v" sid="1CH 17:4" />“यहोवा ईंयाँ बोलोआ कि मेरे रणे खे तां कअर नि बणाई सकणा। <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />कऊँकि जेस दिनो ते आऊँ इस्राएली लोका खे मिस्रो ते ल्याया, आजके दिनो तक आऊँ कदी कअरो दे नि रया; पर एकी तम्बूए ते दूजे तम्बूए खे ओर एकी जगा ते दूजी जगा खे आया-जाया करूँआ। <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />जेती-जेती मैं सबी इस्राएली लोका बीचे आऊणा-जाणा कित्तेया, क्या मैं इस्राएली लोका रे न्यायिया बीचा ते जो मैं आपणी प्रजा री देखपाल़ करने खे ठराई राखे थे, केसी साथे एड़ी कोई गल्ल बोली कि तुसे लोके माखे देवदारो रा कअर कऊँ नि बणाया?” <verse eid="1CH 17:6" /><verse number="7" style="v" sid="1CH 17:7" />तो एबे तूँ मेरे दास दाऊदो ते ईंयाँ बोल कि सेना रा यहोवा ईंयाँ बोलोआ कि मैं तो तूँ पेडा री गवाईणी ते ओर पेडा-बाकरिया रे पीछे-पीछे फिरने ते एते इच्छा ते बुलाया, ताकि तूँ मेरी इस्राएली प्रजा रा परदान ऊई जाए; <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />ओर जेती केथी तूँ आया ओर गया, तेती आऊँ तां साथे रया ओर तेरे सारे दुश्मण तां सामणे ते नाश कित्ते। एबे मां तेरा नाओं तरतिया रे बड़े-बड़े लोका जेड़ा बड़ा करना। <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />ओर मां आपणी इस्राएली प्रजा खे एक जगा देणी जो तिना री ई ऊई जाणी, ताकि से आपणी ई जगा दे बसी दी रओ ओर कदी चलदी नि रओ ओर बुरे लोक तिजी खे नाश नि करी सकणे, जेड़ा कि पईलके दिना दे करो थे। <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />बल्कि तेस बखते बी जेबे आऊँ आपणी इस्राएली प्रजा पाँदे न्यायी ठराऊँ था। मां तेरे सारे दुश्मण दबाई देणे। तेबे मां ताखे ये बी बताई देणा कि यहोवे तेरा कअर बणाया दा राखणा। <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />जेबे तूँ मरी जाणा ओर ताखे आपणे पितरा साथे जाणा पड़ना, तेबे मां तांते बाद तेरे कुलो खे जो तेरे पाऊआ बीचा ते ऊणा, खड़ा करी की तेसरा राज्य स्थिर करना।<note caller="+" style="f"><char style="fr" closed="false">17:11 </char><char style="ft" closed="false">1 राजा 2:10,11, 2 सेमू. 7:12</char></note> <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />तेस ई माखे एक मन्दर बनाणा ओर मां तेसरा सिंहासन सदा बणाया दा राखणा। <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />आऊँ तेसरा बाओ ठईरना ओर से मेरा पाऊ ठईरना ओर जेड़ी मैं आपणी करूणा तेस पाँदे जो तांते पईले था टाई, तेड़ी मां तेस पाँदा ते नि टाणी।<note caller="+" style="f"><char style="fr" closed="false">17:13 </char><char style="ft" closed="false">2 सेमू. 7:14</char></note> <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />पर मां से आपणे मन्दरो दे ओर आपणे राज्य दे सदा बणाया दा राखणा ओर तेसरा सिंहासन सदा बणाया दा राखणा।<note caller="+" style="f"><char style="fr" closed="false">17:14 </char><char style="ft" closed="false">2 सेमू. 7:16</char></note> <verse eid="1CH 17:14" /><verse number="15" style="v" sid="1CH 17:15" />इना सबी गल्ला ओर दर्शणो रे मुताबिक नाताने दाऊदो खे समजयाई ता।<verse eid="1CH 17:15" /></para>
  <para style="s">दाऊदो री तन्यवादो री प्रार्थना</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />तेबे दाऊद राजा पीतरे जाई की यहोवे सामणे बैठेया ओर प्रार्थना करने लगेया, “ओ यहोवा परमेशर! आऊँ क्या ए? ओर मेरा कराना क्या ए कि तैं आऊँ एथो तक पऊँचाई राखेया? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />ओ परमेशर! ये तेरी नजरा दे छोटी जी गल्ल ऊई, कऊँकि तैं आपणे दासो रे कराने रे बारे दे आऊणे वाल़े कई दिना तक री चर्चा करी राखी ओर ओ यहोवा परमेशर! तैं आऊँ एक खास माणूं जाणी राखेया। <verse eid="1CH 17:17" /><verse number="18" style="v" sid="1CH 17:18" />जो महिमा तैं आपणे दासो पाँदे दखाई राखी, तेतेरे बारे दे दाऊद ताखे ओर क्या बोली सकोआ? तूँ तो आपणे दासो खे जाणेया। <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />ओ यहोवा! तैं आपणे दासो रिया तँईं ओर आपणे मनो रे मुताबिक ये बड़ा काम करी राखेया कि तेरा दास तिजी खे जाणी लो। <verse eid="1CH 17:19" /><verse number="20" style="v" sid="1CH 17:20" />ओ यहोवा! जो कुछ आसे तेरे कामा रे बारे दे आपणे कानो साथे सुणी राखेया, तेतेरे मुताबिक तां जेड़ा कोई नि ए ओर ना ताखे छाडी की ओर कोई परमेशर ए। <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />तरतिया पाँदे परमेशरो री इस्राएली प्रजा जेड़ी ओर कोई जाति नि ए। आसे सेयो लोक ए जो तैं बचाई राखे। तैं ये दखाणे खे एड़ा कित्तेया कि तेरा नाओं आदरो जोगा ए। तैं आपणे लोक मिस्र देशो ते बचाई की बड़े चमत्कारो रे काम कित्ते। तैं सेयो लोक बारे निकाल़े जो तेरी प्रजा खे रोकणा चाओ थे। <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />कऊँकि तैं आपणी प्रजा इस्राएलो खे आपणी सदा री प्रजा ऊणे खे ठराई ओर ओ यहोवा! तूँ आपू तेसा प्रजा रा परमेशर ठईरेया। <verse eid="1CH 17:22" /><verse number="23" style="v" sid="1CH 17:23" />इजी री खातर एबे ओ यहोवा, तैं जो वचन आपणे दास ओर तेसरे कराने रे बारे दे देई राखेया, से सदा अटल़ रओ ओर आपणे वचनो रे मुताबिक ई कर। <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />तेरा नाओं सदा अटल रओ ओर ये बोली की तेरी तारीफ सदा करी जाओ कि सेना रा यहोवा इस्राएलो रा परमेशर ए, बल्कि से इस्राएलो खे ई परमेशर ए ओर तेरे दास दाऊदो रा कराना तां सामणे परोसे वाल़ा बणेया रा रओ। <verse eid="1CH 17:24" /><verse number="25" style="v" sid="1CH 17:25" />कऊँकि ओ मेरे परमेशर, तैं ये बोली कि आपणे दासो गे बताई राखेया कि मां तेरा कअर बणाया दा राखणा, इजी बजा ते तेरे दासो खे तां सामणे प्रार्थना करने रा याओ ऊई रा। <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />ओर एबे ओ यहोवा तूँ ई परमेशर ए ओर तैं आपणे दासो खे ये पलाई करने रा वचन देई राखेया; <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />ओर एबे तैं आपणे दासो ते खुश ऊई की आपणे दासो रे कराने पाँदे एड़ी आशीष देई राखी कि से तां सामणे सदा बणेया रा रओ, कऊँकि ओ यहोवा, तूँ आशीष देई चुकेया रा, इजी री खातर से सदा आशीषित बणेया रा रओ।”<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s">दाऊदो री जीता रा बखाण</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />इजी ते बाद एड़ा ऊआ कि दाऊदे पलिश्तिया खे अराई की सेयो आपणे वशो दे करीते ओर गाँवो समेत गत शईर पलिश्तिया रे आथो ते छुड़ाई ला। <verse eid="1CH 18:1" /><verse number="2" style="v" sid="1CH 18:2" />तेबे तिने मोआबी लोक बी अराईते ओर मोआबी लोक दाऊदो रे वशो दे ऊई की पेंट ल्याऊणे लगे।<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />फेर जेबे सोबा रा राजा हदादेजेर फरात नदिया गे आपणा राज्य पक्का करने खे जाणे लगी रा था, तेबे राजा दाऊदे हमात जगा दे तेस पाँदे अमला कित्तेया ओर से अराईता। <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />दाऊदे तेसते 1,000 रथ, 7,000 कोड़ेया रे सवार ओर 20,000 सिपाई जीती ले ओर राजा दाऊदे सबी रथो वाल़े कोड़ेया री नस कटवाई, पर 100 रथ वाल़े कोड़े बचाई की राखी ले।<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />जेबे दमिश्को री अरामी सेना सोबा रे राजा हदादेजेरो री मताद करने खे आई, तेबे राजा दाऊदे अरामी सेना बीचा ते 22,000 सिपाई काये। <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />तेबे दाऊदे दमिश्को रे अराम शईरो दे सिपाईया री चौकिया बठयाल़िया, तेबे अरामी लोक दाऊदो रे वशो दे ऊई की पेंट ल्याऊणे लगे। ओर जेती-जेती दाऊद जाओ था, तेती-तेती यहोवा तेसखे जीत दलाओ था। <verse eid="1CH 18:6" /><verse number="7" style="v" sid="1CH 18:7" />राजा दाऊदे सोबा रे राजा हदादेजेरो रे कर्मचारिया ते सूईने रिया ढाला लईया। तिना खे लई की राजा दाऊद यरूशलेम शईरो खे ली आया। <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />फेर राजा दाऊद हदादेजेरो रे तिभत ओर कून नाओं रे दूई शईरा ते बऊत सारा पीतल़ ल्याया ओर तिजी ते ई सुलैमाने पीतल़ी रे अऊद, खम्बे ओर पीतल़ी रे पांडे बणवाए।<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />जेबे हमात शईरो रे राजा तोऊए ये सुणेया कि राजा दाऊदे सोबा रे राजा हदादेजेरो री सारी सेना जीती ली री, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />तेबे तिने आपणा हदोराम नाओं रा पाऊ दाऊद राजे गे तेसरा सुख-साँद ओर मुबारकबाद देणे खे पेजेया, इजी खे कि तिने हदादेजेरो साथे लड़ी की से जीती ला था; कऊँकि राजा हदादेजेर राजा तोऊए साथे लड़ेया करो था, ओर हदोराम सूईने, चाँदी ओर पीतल़ी रे हर प्रकारा रे पांडे लई की आया। <verse eid="1CH 18:10" /><verse number="11" style="v" sid="1CH 18:11" />यो पांडे दाऊद राजे यहोवे खे पवित्र करी की राखे ओर तेड़ा ई तेस सूईने चाँदिए साथे बी कित्तेया जो सबी जातिया ते, मतलब एदोमी, मोआबी, अम्मोनी, पलिश्ती ओर अमालेकिया ते मिलेया था।<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />तेबे सरूयाह रे पाऊ अबीशै लूणो रिया काअटिया दे 18,000 एदोमी लोक काईते। <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />तेबे तिने एदोम शईरो दे सिपाईया रिया चौकिया बठयाल़िया ओर सारे एदोमी लोक दाऊदो रे वशो दे ऊईगे। राजा दाऊद जेती-जेती जाओ था तेती-तेती यहोवा तेसखे जीत दलाओ था।<verse eid="1CH 18:13" /></para>
  <para style="s">राजा दाऊदो रे खास अधिकारी</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />राजा दाऊद तो सारे इस्राएलो पाँदे राज करो था ओर से आपणी सारी प्रजा साथे न्याय ओर तार्मिकता रे काम करो था।<verse eid="1CH 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 18:15" />राजा दाऊदो रा परदान सेनापति योआब था। से सरूयाह रा पाऊ था। इतिआसो खे लिखणे वाल़ा यहोशापात था। से अहीलूदो रा पाऊ था। <verse eid="1CH 18:15" /><verse number="16" style="v" sid="1CH 18:16" />परदान पुरोईत, अहीतूबो रा पाऊ सादोक ओर एब्यातारो रा पाऊ अबीमेलेक थे, मंत्री शबशा था; <verse eid="1CH 18:16" /><verse number="17" style="v" sid="1CH 18:17" />करेती ओर पलेतिया रा परदान यहोयादा रा पाऊ बनायाह था ओर दाऊदो रे पाऊ राजे गे मुखिये ऊई की रओ थे।<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s">अम्मोनिया पाँदे जीत</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />इजी ते बाद अम्मोनिया रा राजा नाहाश अम्मोनी लोका रा राजा था। जेबे से मरेया, तेसते बाद तेसरा पाऊ हानून तेसरी जगा पाँदे राजा बणेया। <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />तेबे दाऊदे ये सोचेया, “हानूनो रे बाओ नाहाशे जो मां साथे प्यार दखाई राखेया, इजी री खातर मां बी तेस साथे तेड़ा ई प्यार दखाणा।” तेबे दाऊदे तेसरे बाओ रे बारे दे शान्ति देणे खे हानूनो गे दूत पेजे। ओर दाऊदो रे कर्मचारी अम्मोनिया रे देशो दे हानूनो गे तेसखे शान्ति देणे खे आये। <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />पर अम्मोनिया रे परदान हानूनो खे बोलणे लगे, “दाऊदे जो तांगे शान्ति देणे वाल़े दूत पेजी राखे, सेओ क्या तेरी समजा ते तेरे बाओ रा आदर करने री इच्छा ते पेजी राखे? क्या तेसरे कर्मचारी एड़ी इच्छा तेई नि तांगे आए कि टोल़-टाल़ करिए ओर नाश करने खे देशो रा पेत लईये?” <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />तेबे हानूने दाऊदो रे कर्मचारी पकड़े ओर तिना रे बाल़ कटवाए ओर आदे टाल्ले, मतलब लको ते थाले तक कटवाई की सेयो जाणे दित्ते। <verse eid="1CH 19:4" /><verse number="5" style="v" sid="1CH 19:5" />तेबे कईये लोके जाई की राजा दाऊदो गे बताईता कि तिना दूता साथे केड़ा बर्ताव करी राखेया, तेबे तिने कुछ लोक तिना साथे मिलणे खे पेजे, कऊँकि सेयो दूत बऊत बेज्जत ऊई रे थे, तेबे राजे बोलेया, “जदुओ तक तुसा री दाढ़िया बढ़ी नि जाओ, तदुओ तक यरीहो देई रूके दे रओ ओर बादो ते वापस आई जाएयो।”<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />जेबे अम्मोनी लोके देखेया कि आसे दाऊदो खे बुरे लगूँए, तेबे हानूने ओर अम्मोनी लोके 34,000 किलो चाँदी, अरम्नहरैम ओर अरम्माका ओर सोबा शईरो खे पेजेया, ताकि रथ ओर कोड़ेया रे सवार कराये पाँदे बुलाओ। <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />तेबे तिने 32,000 रथ ओर माका देशो रा राजा ओर तेसरी सेना कराये पाँदे बुलाए ओर तिने आई की मेदबा शईरो रे सामणे आपणे डेरे खड़े कित्ते ओर अम्मोनी लोक आपणे-आपणे शईरो ते कट्ठे ऊई की लड़ने खे आए।<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />ये सुणी की कि अम्मोनी सेना लड़ने खे त्यार ऊई री, राजा दाऊदे योआब ओर इस्राएलो री पूरी सेना पेजी। <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />तेबे अम्मोनी निकल़े ओर शईरो रे बड़े द्वारो गे पंग्ति बानी ओर जो राजा आए थे, सेयो तिना ते लग मैदानो दे थे। <verse eid="1CH 19:9" /><verse number="10" style="v" sid="1CH 19:10" />ये देखी की कि आगे-पीछे दुनी कनारे आसा रे खलाफ पंग्ति बानी राखी, योआबे सब बड़े-बड़े इस्राएली वीरा बीचा ते कई छाँटी की अरामिया सामणे तिना री पंग्ति बणाई; <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />ओर बाकी लोक आपणे पाई अबीशै रे आथो दे सम्बाल़ीते ओर तिने अम्मोनिया सामणे पंग्ति बानी। <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />तिने बोलेया, “जे अरामी मां पाँदे प्रबल ऊणे लगो, तो तैं मेरी मताद करनी ओर जे अम्मोनी तां पाँदे प्रबल ऊणे लगोगे, तो मां तेरी मताद करनी। <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />तूँ याओ बान ओर आसे सब आपणे लोक ओर आपणे परमेशरो रे शईरो रिया तँईं मईणत करूँए ओर यहोवा जेड़ा तेसखे अच्छा लगो, तेड़ा ई करोगा।” <verse eid="1CH 19:13" /><verse number="14" style="v" sid="1CH 19:14" />तेबे योआब ओर जो लोक तेस साथे थे, अरामिया साथे युद्ध करने खे तिना सामणे आए ओर अरामी तिना रे सामणे ते नठीगे। <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />ये देखी की कि अरामी नठीगे रे, अम्मोनी बी तेसरे पाई अबीशै रे सामणे ते नठी की शईरो ते पीतरे कूसी गे। तेबे योआब यरूशलेम शईरो खे वापस आया। <verse eid="1CH 19:15" /><verse number="16" style="v" sid="1CH 19:16" />तेबे ये देखी की कि सेयो इस्राएली लोका ते आरी गे रे, अरामिये दूत पेजी की फरातो ते पार रणे वाल़े अरामी बुलाए ओर हदादेजेरो रे सेनापति शोपको खे आपणा परदान बणाया। <verse eid="1CH 19:16" /><verse number="17" style="v" sid="1CH 19:17" />इजी रा सन्देश सुणी की दाऊदे सारे इस्राएली कट्ठे कित्ते ओर यरदन नदिया ते पार ऊई की तिना पाँदे चढ़ाई कित्ती ओर तिना रे खलाफ पंग्ति बणाई, तेबे सेयो तेस साथे लड़ने लगे। <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />पर अरामी इस्राएली लोका ते नठीगे ओर दाऊदे तिना बीचा ते 7,000 रथ ओर 40,000 सैनिक काईते ओर शोपक सेनापति बी काई ता। <verse eid="1CH 19:18" /><verse number="19" style="v" sid="1CH 19:19" />ये देखी की कि सेयो इस्राएली लोका ते आरी गे, हदादेजेरो रे कर्मचारिये दाऊदो साथे सन्धि कित्ती ओर तेसरे वशो दे ऊईगे ओर अरामी लोके अम्मोनी लोका री फेर मताद नि करनी चाई।<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s">रब्बा शईरो पाँदे जीत</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />तेबे नये सालो रे शुरूओ दे जेबे राजा लोक युद्ध करने खे निकल़ेया करोए, तेबे योआबे इस्राएली लोका री बड़ी सेना आपू साथे लई जाई की अम्मोनिया रा देश नाश करिता ओर आई की रब्बा शईरो पाँदे अमला कित्तेया। योआबे रब्बा शईर आपणे कब्जे दे लई की से नाश करिता। पर दाऊद आपू यरूशलेम शईरो देई रईगा। <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />तेबे दाऊदे अम्मोनिया रे राजे रा मुकुट तेसरे सिरो ते उतारी की देखेया कि तेतेरा बजन लगभग 34 किलो<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="fq" closed="false">34 किलो </char><char style="ft" closed="false">एक किक्कार </char></note> था, जो सूईने रा था ओर तिदे मणि बी जड़ी राखे थे। तिने से मुकुट दाऊदो रे सिरो पाँदे राखेया। तेबे योआब ओर इस्राएली सेना खे तेस शईरो ते बऊत सारा समान लूटा दे मिलेया। <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />तिने तेथो रे रणे वाल़े निकयाल़ी की आरेया ओर लोए रे हेंगे ओर क्वाड़िया साथे बडवाए ओर अम्मोनिया रे सारे शईरा साथे बी दाऊदे तेड़ा ई कित्तेया। तेबे दाऊद सबी लोका समेत यरूशलेम शईरो खे वापस ऊईगा।<verse eid="1CH 20:3" /></para>
  <para style="s">पलिश्ती दानवा रा विनाश</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />इजी ते बाद इस्राएली गेजेर शईरो दे पलिश्तिया साथे लड़े; तेस बखते हूशाई जगा दे रणे वाल़े सिब्बकै सिप्पै काईता, जो रपाई दानवा री ल्वाद था। ओर सेयो पलिश्ती लोक दाऊदो रे कब्जे दे ऊईगे। <verse eid="1CH 20:4" /><verse number="5" style="v" sid="1CH 20:5" />तेबे पलिश्तिया साथे फेर युद्ध ऊआ; तिदे याईरो रे पाऊ एल्हानाने गत शईरो रे गोलियतो रा पाई लहमी काई ता, जेसरे बड़छे रा थरा, टाल्ले बुणने री खड्डिया रे डण्डे बराबर मोटा था। <verse eid="1CH 20:5" /><verse number="6" style="v" sid="1CH 20:6" />तेबे गत शईरो दे बी युद्ध ऊआ ओर तेती एक बड़ा तगड़ा मर्द था, जो रापा री ल्वाद था ओर तेसरे एकी-एकी आथो ओर पैरा दे छे-छे गूठिया, मतलब सब मलाई की चौबी गूठिया थिया। <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />जेबे तिने इस्राएली ललकारे, तेबे दाऊदो रे पाई शिमा रे पाऊ योनाताने से काया। <verse eid="1CH 20:7" /><verse number="8" style="v" sid="1CH 20:8" />यो ई गत शईरो दे रणे वाल़े रापा नाओं रे माणूंए ते पैदा ऊए थे ओर सेयो दाऊद ओर तेसरे सेवका रे आथो साथे मरे।<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s">दाऊदो रे जरिये इस्राएलो री गिणती</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />एक दिन शैतान इस्राएलो रे खलाफ उठेया ओर तिने दाऊद बईकाया कि इस्राएली लोका री गिणती लओ। <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />तेबे दाऊदे योआब ओर प्रजा रे परदाना खे बोलेया, “तुसे जाई की उतर दिशा दे दानो रे इलाके ते लई की दक्खणा दे बेर्शेबा शईरो तक इस्राएली लोका री गिणती लई की मांगे बताओ, ताकि माखे पता लगो कि सेयो कितणे ए।” <verse eid="1CH 21:2" /><verse number="3" style="v" sid="1CH 21:3" />योआबे बोलेया, “यहोवे री प्रजा कितणी ई कऊँ नि ओ, से तिना खे सौ गुणा बढ़ाई देयो; पर ओ मेरे प्रभु! ओ राजा! क्या सेयो सारे राजे रे वशो दे नि ए? मेरा प्रभु एड़ी गल्ल कऊँ चाओआ? से इस्राएलो पाँदे दोष लगणे री बजा कऊँ बणो?”<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />तेबे बी राजे री आज्ञा योआबो पाँदे प्रबल ऊई। तेबे योआब बिदा ऊई की सारे इस्राएलो दे कूमी की यरूशलेम शईरो खे वापस आया। <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />तेबे योआबे प्रजा री गिणतिया रा जोड़ दाऊदो खे सुणाया ओर सारे तलवार चलाणे वाल़े मर्द इस्राएलो दे तो 1,100,000 लोक ओर यहूदा दे 470,000 लोक ठईरे। <verse eid="1CH 21:5" /><verse number="6" style="v" sid="1CH 21:6" />पर तिना बीचे योआबे लेवी ओर बिन्यामीनी नि गिणे, कऊँकि से राजे री आज्ञा ते नफरत करो था, <verse eid="1CH 21:6" /><verse number="7" style="v" sid="1CH 21:7" />ओर ये गल्ल परमेशरो खे बुरी लगी, इजी री खातर परमेशरे इस्राएलो खे सजा दित्ती।<verse eid="1CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8" />तेबे दाऊदे परमेशरो ते प्रार्थना करी की बोलेया, “ये काम जो मैं करी राखेया, से महापाप ए। पर एबे आपणे दासो रा पाप दूर कर; मांते तो बड़ी पारी मूर्खता ऊई री।” <verse eid="1CH 21:8" /><verse number="9" style="v" sid="1CH 21:9" />तेबे यहोवे दाऊदो रे दर्शी गादो खे बोलेया, <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />जाई की दाऊदो खे बोल, “यहोवा ईंयाँ बोलोआ कि आऊँ ताखे तीन मुसीबता दखाऊँआ, तिना बीचा ते एकी खे चुण कि आऊँ तिजी खे तां पाँदे पाऊँ।” <verse eid="1CH 21:10" /><verse number="11" style="v" sid="1CH 21:11" />तेबे गादे दाऊदो गे जाई की तेसखे बोलेया, “यहोवा ईंयाँ बोलोआ कि जेतेखे तूँ चाए से चूणी लो: <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />या तो तीऊँ साला रा अकाल़ पड़ो, या तीन मीन्ने तक तेरे बिरोदी ताखे नाश करने खे तां पीछे लगे दे रओ ओर तेरे दुश्मणा री तलवार तां पाँदे चलदी रओ; या तीऊँ दिना तक यहोवे री तलवार चलो, मतलब मरी देशो दे फैलो ओर यहोवे रा दूत इस्राएल देशो रे चऊँ कनारे नाश करदा रओ। एबे सोच कि आऊँ आपणे पेजणे वाल़े खे क्या ज्वाब देऊँ।”<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />दाऊदे गादो खे बोलेया, “आऊँ बड़ी मुसीबता दे पड़ीगा रा; आऊँ यहोवे रे आथो दे पड़ूँ, कऊँकि तेसरी दया बऊत बड़ी ए; पर माखे माणूंआ रे आथो दे नि पड़ना पड़ो।” <verse eid="1CH 21:13" /><verse number="14" style="v" sid="1CH 21:14" />तेबे यहोवे इस्राएलो दे मरी फैलाई ओर इस्राएलो दे 70,000 लोक मरी गे। <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />तेबे परमेशरे एक दूत यरूशलेम शईरो रा नाश करने खे पेजेया ओर से नाश करने ई वाल़ा था, कि यहोवा दु:ख देणे ते बऊत दु:खी ऊआ ओर नाश करने वाल़े दूतो खे बोलेया, “बस कर; एबे आपणा आथ पीछे टाईलो।” ओर यहोवे रा दूत यबूस शईरो दे रणे वाल़े ओर्नान नाओं रे माणूंए रे खल्याणो गे खड़ी रा था।<verse eid="1CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16" />दाऊदे आखी चकी की देखेया कि यहोवे रा दूत आथो दे खींजी री ओर यरूशलेम शईरो पाँदे प्वारी री एक तलवार लई की सर्गो बीचे खड़ी रा, तेबे दाऊद ओर बुजुर्ग लोक टाट पईनी की मुंए रे पारे थाले पड़े। <verse eid="1CH 21:16" /><verse number="17" style="v" sid="1CH 21:17" />तेबे दाऊदे परमेशरो खे बोलेया, “जिने प्रजा री गिणती लणे री आज्ञा दित्ती थी, से आऊँ ए। आ, जिने पाप कित्तेया ओर बऊत बुराई कित्ती, से तो आऊँ ईए। पर इने पेडे-बाकरिये कुछ नि करी राखेया जिना पाँदे ये मुसीबत पड़ी। इजी री खातर ओ मेरे यहोवा परमेशर! तेरा आथ मेरे बाओ रे कराने रे खलाफ ओ, पर मेरी‍ प्रजा रे खलाफ नि ओ, कि सेयो मरी जाओ।” <verse eid="1CH 21:17" /><verse number="18" style="v" sid="1CH 21:18" />तेबे यहोवे रे दूते गादो खे दाऊदो खे ये बोलणे री आज्ञा दित्ती कि दाऊद चढ़ी की यबूसी ओर्नानो रे खल्याणो दे यहोवे री एक बेदी बणाओ। <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />गादो रे एस वचनो रे मुताबिक जो तिने यहोवे रे नाओं ते बोलेया था, दाऊद तेते खल्याणो खे चलीगा। <verse eid="1CH 21:19" /><verse number="20" style="v" sid="1CH 21:20" />तेबे ओर्नाने पीछे फिरी की दूत देखेया ओर तेसरे चारो पाऊ जो तेस साथे थे लूकी गे, ओर्नान तो कणक काडणे लगी रा था। <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />जेबे दाऊद ओर्नानो गे आया, तेबे ओर्नाने नजर करी की दाऊद देखेया ओर खल्याणो ते बारे जाई की जमीना तक चूकी की दाऊदो गे माथा टेकेया। <verse eid="1CH 21:21" /><verse number="22" style="v" sid="1CH 21:22" />तेबे दाऊदे ओर्नानो खे बोलेया, “एस खल्याणो री जगा माखे देई दे, ताकि आऊँ एते पाँदे यहोवे खे एक बेदी बणाऊँ, इजी री पूरी कीमत लई की एस माखे दे, ताकि ये मुसीबत प्रजा पाँदा ते दूर ऊई जाओ।” <verse eid="1CH 21:22" /><verse number="23" style="v" sid="1CH 21:23" />ओर्नाने दाऊदो खे बोलेया, “इजी खे लई लो ओर मेरे प्रभु राजे खे जो कुछ अच्छा लगो सेई कर; सुण, आऊँ ताखे होमबलिया खे बल़द ओर लकड़ी बाडणे खे अथियार ओर नज्जो री बलिया खे कणक, ये सब आऊँ देऊँआ।” <verse eid="1CH 21:23" /><verse number="24" style="v" sid="1CH 21:24" />राजा दाऊदे ओर्नानो खे बोलेया, “ईंयाँ नि ये लणा, मां जरूर इजी रा पूरा मोल देई की ये खरीदणा; जो तेरा ए, से मां यहोवे खे नि लणा ओर ना मुफ्तो री होमबलि चढ़ाणी।” <verse eid="1CH 21:24" /><verse number="25" style="v" sid="1CH 21:25" />तेबे दाऊदे तेसा जगा दे ओर्नानो खे लगभग सात किलो सूईने रे सिक्के तोली की दित्ते।<verse eid="1CH 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 21:26" />तेबे दाऊदे तेथी यहोवे री एक बेदी बणाई ओर होमबलि ओर मेलबलि चढ़ाए। फेर तेथी तिने यहोवे ते प्रार्थना कित्ती। यहोवे होमबलिया री बेदिया पाँदे स्वर्गो ते आग सेटी की दाऊदो री सुणी ली। <verse eid="1CH 21:26" /><verse number="27" style="v" sid="1CH 21:27" />तेबे यहोवे दूतो खे आज्ञा दित्ती; ओर तिने आपणी तलवार फेर म्यानो दे राखी ती। <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />ये देखी की कि यहोवे यबूसी ओर्नानो रे खल्याणो दे मेरी सुणी ली, दाऊदे तेस ई बखते तेथी बलिदान कित्तेया। <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />यहोवे रा तम्बू जो मूसे जंगल़ो दे बणाया था ओर होमबलि चढ़ाणे खे बलिया री बेदी, यो दोनो तेस बखते गिबोनो रिया ऊच्ची जगा दे थे। <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />पर दाऊद परमेशरो गे तेस सामणे नि जाई सकेया, कऊँकि से यहोवे रे दूतो री तलवारी ते डरीगा था।<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />तेबे दाऊदे बोलेया, “परमेशर यहोवे रा मन्दर येई ए ओर इस्राएलो खे होमबलि चढ़ाणे खे बलिया री बेदी येई ए।”<verse eid="1CH 22:1" /></para>
  <para style="s">मन्दरो रे बनाणे री त्यारी</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />तेबे दाऊदे इस्राएलो रे देशो दे जो परदेशी थे तिना खे कट्ठे करने री आज्ञा दित्ती ओर परमेशरो रा मन्दर बनाणे खे पात्थर कअड़ने खे राजमिस्त्री ठराईते। <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />फेर दाऊदे बड़े द्वारो रे दरवाजेया री परेगा ओर जोड़ो खे बऊत सारा लोआ ओर तोलणे ते बारे बऊत सारा पीतल़, <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />ओर गिणतिया ते बारे देवदारो रे डाल़ कट्ठे कित्ते; कऊँकि सीदोन ओर सोर जगा रे लोक दाऊदो गे बऊत सारे देवदारो रे डाल़ ल्याये थे। <verse eid="1CH 22:4" /><verse number="5" style="v" sid="1CH 22:5" />ओर दाऊदे बोलेया, “मेरा पाऊ सुलैमान नासमज ओर बाल़क ई ए ओर जो मन्दर यहोवे खे बनाणा, से बऊत तेजोमय ओर सारे देशा दे प्रसिद्ध ओर शोभा जोगा ऊणा चाईयो; इजी री खातर मां तिजी खे त्यारी करनी।” तो दाऊदे मरने ते पईले बऊत त्यारी कित्ती। <verse eid="1CH 22:5" /><verse number="6" style="v" sid="1CH 22:6" />तेबे दाऊदे आपणा पाऊ सुलैमान बुलाया ओर तेसखे इस्राएलो रे परमेशर यहोवे रा मन्दर बनाणे री आज्ञा दित्ती।<verse eid="1CH 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 22:7" />दाऊदे आपणे पाऊ सुलैमानो खे बोलेया, “मेरी इच्छा तो थी कि आपणे परमेशर यहोवे रे नाओं रा एक मन्दर बणाऊँ। <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />पर यहोवे रा ये सन्देश माखे मिलेया, तैं बऊत खून बाह्यी राखेया ओर बड़े-बड़े युद्ध करी राखे, इजी री खातर तू मेरे नाओं रा मन्दर नि बणाई सकदा, कऊँकि तैं तरतिया पाँदे मेरी नजरा दे बऊत खून बाह्यी राखेया। <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />देख, तांते एक पाऊ पैदा ऊणा, जो शान्त मर्द ऊणा ओर मां तेसखे चऊँ कनारले दुश्मणा ते शान्ति देणी; तेसरा नाओं तो सुलैमान ऊणा ओर तेसरे दिना रे मां इस्राएलो खे शान्ति ओर चैन देणा। <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />तेस ई मेरे नाओं रा मन्दर बनाणा। ओर सेई मेरा पाऊ ठईरना ओर आऊँ तेसरा बाओ ठईरना ओर तेसरी राजगद्दी मां इस्राएलो पाँदे सदा बणाई दी राखणी।”<verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />एबे ओ मेरे पाऊ, यहोवा तां साथे रओ ओर तूँ आपणे काम पूरा करने खे तेस वचनो रे मुताबिक जो तेरे यहोवा परमेशरे तेरे बारे दे बोलेया था, तेसरा मन्दर बनाणा। <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />एबे यहोवा ताखे बुद्धि ओर समज देयो ओर इस्राएलो रा अधिकारी ठराओ ओर तूँ आपणे परमेशर यहोवे रे बिधानो खे मानदा रओ। <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />तूँ तेबेई आपणा काम पूरा करी सकेया जेबे तिना नियमा ओर बिदिया पाँदे चलणे रे चौकसी करेगा, जिना री आज्ञा यहोवे इस्राएली लोका रिया तँईं मूसे गे दितिया थिया। याओ बान ओर मजबूत ओ। डर नि ओर तेरा मन कच्चा नि ओ। <verse eid="1CH 22:13" /><verse number="14" style="v" sid="1CH 22:14" />सुण, मैं आपणे क्ल़ेशो रे बखते यहोवे रे मन्दरो खे तीन ह्जार टन<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="fq" closed="false">तीन ह्जार टन </char><char style="ft" closed="false">100,000 किक्कार </char></note> सूईना ओर चौंती ह्जार टन<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="fq" closed="false">चौंती ह्जार टन </char><char style="ft" closed="false">1,000,000 किक्कार </char></note> चाँदी ओर पीतल़ ओर लोआ इतणा कट्ठा करी राखेया कि बऊत जादा ऊणे रिया बजा ते तोलणे ते बारे ए ओर लकड़ी ओर पात्थर मैं कट्ठे करीते दे ओर तूँ तिना खे ओर बी बढ़ाई सकेया। <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />तांगे बऊत कारीगर ए, मतलब पात्थर कअड़ने वाल़े ओर लकड़िया खे बाडणे वाल़े, बल्कि सब केड़ा काम करने खे निपुण मर्द ए। <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />सूईना, चाँदी, पीतल़ ओर लोए री तो कोई गिणती नि ए, तो तूँ तेस कामो दे लगी जा! यहोवा तां साथे सदा रओ।<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />तेबे दाऊदे इस्राएलो रे सारे परदाना खे आपणे पाऊ सुलैमानो री मताद करने री आज्ञा ये बोली की दित्ती, <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />“क्या तुसा रा यहोवा परमेशर तुसा साथे नि ए? क्या तिने तुसा खे चऊँ कनारे ते राम नि देई राखेया? तिने तो देशो दे रणे वाल़े ओरी जातिया रे सब लोक मेरे वशो दे करी राखे ओर देश यहोवा ओर तेसरी प्रजा सामणे दबेया राए। <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />एबे तन-मनो साथे आपणे परमेशर यहोवे गे जाया करो ओर मन लगाई की परमेशर यहोवे री पवित्र जगा बनाणी, ताकि तुसे यहोवे री वाचा रा सन्दूक ओर परमेशरो रे पवित्र पांडे तेस मन्दरो दे ल्याओ जो यहोवे रे नाओं रा बणने वाल़ा ए।”<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s">लेविया खे जिम्मेदारिया रा दितिया जाणिया</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />दाऊद तो स्याणा बल्कि बऊत ई स्याणा ऊईगा था, इजी री खातर तिने आपणा पाऊ सुलैमान इस्राएलो पाँदे राजा बणाई ता। <verse eid="1CH 23:1" /><verse number="2" style="v" sid="1CH 23:2" />तेबे तिने इस्राएलो रे सारे परदान, पुरोईत ओर लेवी लोक कट्ठे कित्ते। <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />जितणे लेवी लोक तीई साला रे ओर तेते ते जादा उम्रा रे थे, सेयो गिणे ओर एक-एक मर्दो रे गिणने ते तिना री गिणती 38,000 ऊई। <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />इना बीचा ते 24,000 तो यहोवे रे मन्दरो दे काम करने खे नियुक्त कित्ते ओर 6,000 अधिकारी ओर न्यायी बणाए। <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />ओर 4,000 द्वारपाल नियुक्त ऊए ओर 4,000 तिना बाजेया साथे यहोवे री स्तुति करने खे ठराए जो दाऊदे स्तुति करने खे बणाए थे।<verse eid="1CH 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 23:6" />तेबे दाऊदे सेयो गेर्शोन, कहात ओर मरारी नाओं रे लेविया रे पाऊआ रे मुताबिक दलो दे लग-लग करीते।<verse eid="1CH 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 23:7" />गेर्शोनिया रे कुलो बीचा ते तो लादान ओर शिमी थे।<verse eid="1CH 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 23:8" />ओर लादानो रे तीन पाऊ सरदार यहीएल, जेताम ओर योएल थे।<verse eid="1CH 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 23:9" />शिमीए रे तीन पाऊ शलोमीत, हजीएल ओर हारान थे। लादानो रे कुलो रे बुजुर्गा रे करानेया रे मुख्य मर्द यो ई थे।<verse eid="1CH 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 23:10" />फेर शिमीए रे चार ओर पाऊ थे, यहत, जीना, यूश ओर बरीआ।<verse eid="1CH 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 23:11" />यहत जेठा था ओर जीजा दूजा था। यूश ओर बरीआ रे बऊत पाऊ नि ऊए, इजी बजा ते सेयो सब मिली की एक ई कराना ठईरे। <verse eid="1CH 23:11" /><verse number="12" style="v" sid="1CH 23:12" />कहातो रे पाऊ अम्राम, यिसहार, हेब्रोन ओर उज्जीएल, चार पाऊ ऊए।<verse eid="1CH 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 23:13" />अम्रामो रे पाऊ हारूण ओर मूसा ऊए। हारूण तो इजी री खातर लग कित्तेया, ताकि से ओर तेसरी ल्वाद सदा परम पवित्र चीजा खे पवित्र ठराओ ओर सदा परमेशरो सामणे तूप बाल़ेया करो ओर तेसरी सेवा-टईल करेया करो ओर तेसरे नाओं ते आशीर्वाद देया करो।<verse eid="1CH 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 23:14" />पर परमेशरो रे दास मूसे रे पाऊआ रे नाओं लेविया रे गोत्रा बीचे गिणे। <verse eid="1CH 23:14" /><verse number="15" style="v" sid="1CH 23:15" />मूसे रे पाऊ, गेर्शोम ओर एलीएजेर ऊए।<verse eid="1CH 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 23:16" />ओर गेर्शोमो रा पाऊ शबूएल जेठा था।<verse eid="1CH 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 23:17" />एलीएजेरो रे एक ई पाऊ रहब्याह ऊआ तेसरे ओर कोई पाऊ नि ऊआ, पर रब्याह रे बऊत सारे पाऊ ऊए।<verse eid="1CH 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 23:18" />यिसहारो रे पाऊआ बीचा ते शलोमीत जेठा था।<verse eid="1CH 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 23:19" />हेब्रोनो रे पाऊ यरिय्याह जेठा, दूजा अमर्याह, तीजा यहजीएल ओर चौथा यकमाम था।<verse eid="1CH 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 23:20" />उज्जीएलो रे पाऊआ बीचा ते जेठा तो मीका ओर दूजा यिश्शिय्याह था।<verse eid="1CH 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 23:21" />मरारिए रे पाऊ महली ओर मूशी ऊए। महलीए रे पाऊ एलीआजार ओर कीश ऊए।<verse eid="1CH 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 23:22" />एलीआजार तो बिना पाऊआ ते ई मरी गा, तेसरे बस बेटिया ई ऊईया; तेबे कीशो रे पाऊए एलीआजारो री बेटिया साथे ब्या करी ला, जो तिना रे पाई थे।<verse eid="1CH 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 23:23" />मूशीए रे पाऊ महली; एदेर ओर यरेमोत यो तीन ऊए।<verse eid="1CH 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24" />लेविया रे पीतरा रे कराने रे बड़े मर्द यो ई थे, यो नाओं लई की बुलाई राखे थे। यो सब मर्द बीइ साला रे ओर तिजी ते जादा उम्रा रे थे। यो सब यहोवे रे मन्दरो रे सेवा-टईल करने रा काम करो थे। <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />दाऊदे बोलेया था, “इस्राएलो रे यहोवा परमेशरे आपणी प्रजा खे राम देई राखेया ताकि से यरूशलेम शईरो दे सदा खे रई सको। <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />ओर लेविया खे रणे री जगा ओर तेसरी आराधना रा समान फेर चकणे रा काम नि पड़ना।” <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />कऊँकि दाऊदो री पिछली आज्ञा रे मुताबिक बीइ साल या तेते ते जादा उम्रा रे लेवी लोक गिणे। <verse eid="1CH 23:27" /><verse number="28" style="v" sid="1CH 23:28" />कऊँकि तिना रा काम तो हारूणो रे पाऊआ री सेवा-टईल करना था, मतलब ये कि सेयो आँगण ओर कमरे दे ओर सब पवित्र चीजा खे शुद्ध करने दे ओर परमेशरो रे मन्दरो री आराधना दे ओर सब कामा दे सेवा-टईल करो; <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />ओर पेंटा री रोटिया रा, नज्जो री बलिया रे मैदे रा, बिना सजेड़े री पापड़िया रा ओर तवे पाँदे बणाए रे ओर गूँदे रे आटे रा ओर नापणे-तोलणे रा सब काम करो। <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />ओर हर प्यागा-साँजा खे यहोवे रा तन्यवाद ओर तेसरी स्तुति करने खे खड़े रया करो। <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />ओर रामो रे दिने, ओर नये चाँदो रे दिने ओर ठीक त्योआरो रे गिणतिया रे नियमो रे मुताबिक हमेशा यहोवे रे सारे होमबलि चढ़ाओ; <verse eid="1CH 23:31" /><verse number="32" style="v" sid="1CH 23:32" />ओर यहोवे रे मन्दरो री आराधना रे बारे दे मिलणे वाल़े तम्बू ओर पवित्र जगा री रक्षा करो ओर आपणे पाई हारूणो रिया ल्वादा खे सम्बाल़े रे कामो खे चौकसिया साथे करो।<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s">पुरोईता रिया जिम्मेवारिया</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />तेबे हारूणो री ल्वादा रे दल यो थे। हारूणो रे पाऊ तो नादाब, अबीहू, एलीआजार ओर ईतामार थे। <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />पर नादाब ओर अबीहू आपणे बाओ रे सामणे ई मरीगे। तिना रे कोई पाऊ नि था, इजी री खातर पुरोईतो रा काम एलीआजार ओर ईतामार करो थे। <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />दाऊदे एलीआजारो रे कुलो रा सादोक ओर ईतामारो रे कुलो रे अहीमेलेको री मतादा ते तिना खे आपणी-आपणी सेवा रे कामा रे मुताबिक दल-दल करी की बाँडे। <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />एलीआजारो रे कुलो रे मुख्य मर्द ईतामारो रे कुलो रे मुख्य मर्दा ते जादा थे ओर सेयो ईंयाँ बाँडे मतलब एलीआजारो रे कुलो रे पितरा रे कराने रे सोल़ा ओर ईतामारो रे कुलो रे पितरा रे आठ मुख्य मर्द थे। <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />तेबे सेयो चिट्ठी पाई की बराबर-बराबर बाँडे, कऊँकि एलीआजार ओर ईतामार दुँईं रे कुला रे पवित्र जगा दे हाकिम ओर परमेशरो रे हाकिम नियुक्त ऊए थे।<verse eid="1CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6" />ओर नतनेलो रे पाऊ शमायाहे जो शास्त्री ओर लेवी था, तिने तिना रे नाओं राजा, परदान ओर सादोक पुरोईत ओर एब्यातारो रे पाऊ अहीमेलेक ओर पुरोईत ओर लेविया रे पितरा रे कराने रे मुख्य मर्दा रे सामणे लिखे; मतलब पितरा रा एक कराना तो एलीआजारो रे कुलो ते ओर एक ईतामारो रे कुलो बीचा ते लया।<verse eid="1CH 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 24:7" />पईली चिट्ठी तो यहोयारीबो रे ओर दूजी यदायाह, <verse eid="1CH 24:7" /><verse number="8" style="v" sid="1CH 24:8" />तीजी हारीम, चौथी सोरीम, <verse eid="1CH 24:8" /><verse number="9" style="v" sid="1CH 24:9" />पाँजी मल्किय्याह, छठी मिय्यामीन, <verse eid="1CH 24:9" /><verse number="10" style="v" sid="1CH 24:10" />साती हक्कोस, आठी अबिय्याह,<note caller="+" style="f"><char style="fr" closed="false">24:10 </char><char style="ft" closed="false">लूक. 1:5</char></note> <verse eid="1CH 24:10" /><verse number="11" style="v" sid="1CH 24:11" />नऊई येशुअ रे, दसी शकन्याह, <verse eid="1CH 24:11" /><verse number="12" style="v" sid="1CH 24:12" />ग्यारी एल्याशीब, बारी याकीमो रे, <verse eid="1CH 24:12" /><verse number="13" style="v" sid="1CH 24:13" />तेरी हुप्पा रे, चौदी येसेबाब, <verse eid="1CH 24:13" /><verse number="14" style="v" sid="1CH 24:14" />पन्द्री बिल्गा, सोल़ी इम्मेर, <verse eid="1CH 24:14" /><verse number="15" style="v" sid="1CH 24:15" />सतारी हेजीर, ठारी हप्पित्सेस, <verse eid="1CH 24:15" /><verse number="16" style="v" sid="1CH 24:16" />उन्नी पतह्माह, बीयूई यहेजकेल, <verse eid="1CH 24:16" /><verse number="17" style="v" sid="1CH 24:17" />इक्की याकीन, बाई गामूल, <verse eid="1CH 24:17" /><verse number="18" style="v" sid="1CH 24:18" />तेई दलायाह ओर चौबी माज्याह रे नाओं री निकल़ी। <verse eid="1CH 24:18" /><verse number="19" style="v" sid="1CH 24:19" />तिना री सेवकाईया खे तिना रा येई नियम ठराया कि सेयो आपणे तेस नियमो रे मुताबिक जो इस्राएलो रे परमेशर यहोवे री आज्ञा रे मुताबिक, तिना रे मूलमर्द हारूणे चलाया था, यहोवे रे मन्दरो रे कामा खे जाया करो।<verse eid="1CH 24:19" /></para>
  <para style="s">ओर लेवी</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 24:20" />बचे रे लेविया बीचा ते अम्रामो रे कुलो बीचा ते शूबाएल, शूबाएलो रे कुलो बीचा ते येहदयाह। <verse eid="1CH 24:20" /><verse number="21" style="v" sid="1CH 24:21" />बाकी रहब्याह, ओर रहब्याह रे कुलो बीचा ते यिश्शिय्याह मुखिया था। <verse eid="1CH 24:21" /><verse number="22" style="v" sid="1CH 24:22" />यिसहारिया बीचा ते शलोमोत ओर शलोमोतो रे कुलो बीचा ते यहत। <verse eid="1CH 24:22" /><verse number="23" style="v" sid="1CH 24:23" />हेब्रोनो रे कुलो बीचा ते जेठा यरिय्याह, दूजा अमर्याह, तीजा यहजीएल ओर चौथा यकमाम था। <verse eid="1CH 24:23" /><verse number="24" style="v" sid="1CH 24:24" />उज्जीएलो रे कुलो बीचा ते मीका ओर मीका रे कुलो बीचा ते शामीर था। <verse eid="1CH 24:24" /><verse number="25" style="v" sid="1CH 24:25" />मीका रा पाई यिश्शिय्याह, यिश्शिय्याह रे कुलो बीचा ते जकर्याह था। <verse eid="1CH 24:25" /><verse number="26" style="v" sid="1CH 24:26" />मरारिए रे पाऊ महली ओर मूशी ओर याजिय्याह रा पाऊ बिनो था। <verse eid="1CH 24:26" /><verse number="27" style="v" sid="1CH 24:27" />मरारिए रे पाऊ याजिय्याह ते बिनो ओर शोहम, जक्कूर ओर इब्री थे। <verse eid="1CH 24:27" /><verse number="28" style="v" sid="1CH 24:28" />महलीए ते एलीआजार जेसरे कोई पाऊ नि था। <verse eid="1CH 24:28" /><verse number="29" style="v" sid="1CH 24:29" />कीशो रे कुलो ते यरहमेल। <verse eid="1CH 24:29" /><verse number="30" style="v" sid="1CH 24:30" />ओर मूशीए रे पाऊ महली, एदेर ओर यरीमोत थे। आपणे-आपणे पितरा रे कराने रे मुताबिक येई लेविया री ल्वाद थी। <verse eid="1CH 24:30" /><verse number="31" style="v" sid="1CH 24:31" />इने बी आपणे पाई हारूणो री ल्वादा जेड़ी दाऊद राजा ओर सादोक ओर अहीमेलेक ओर पुरोईत ओर लेविया रे पितरा रे मुख्य मर्दा सामणे पर्चिया पाईया, मतलब मुख्य मर्दा रा कराना तेसरे छोटे पाईया रे पितरा रे कराने रे बराबर ठईरेया।<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s">दाऊदो रे बाजे बजाणे वाल़े</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />तेबे राजा दाऊद ओर सेनापतिये आसाप, हेमान ओर यदूतूनो रे कई पाऊ मन्दरो दे सेवा करने खे लग कित्ते, ताकि सेयो परमेशरो रे संदेशो री भविष्यबाणी बीणा, सारंगी ओर खंजरी बजाई-बजाई की प्रचार करो। ओर एसा सेवकाईया रा काम करने वाल़े माणूंआ री गिणती ये थी: <verse eid="1CH 25:1" /><verse number="2" style="v" sid="1CH 25:2" />मतलब आसापो रे पाऊआ बीचा ते जक्कूर, यूसुफ, नतन्याह ओर अशरेला थे। आसापो रे पाऊ आसापो रे ई कईणे रे मुताबिक सेवा रा काम करो थे। आसाप आपू राजे री आज्ञा रे मुताबिक भविष्यबाणी ओर प्रचार करो था। <verse eid="1CH 25:2" /><verse number="3" style="v" sid="1CH 25:3" />तेबे यदूतूनो रे पाऊआ बीचा ते गदल्याह, सरी, यशायाह, शिमी, हशब्याह, मत्तित्याह, यो ई छे आपणे बाओ यदूतूनो रे कईणे रे मुताबिक काम करो थे। सेयो यहोवे रा तन्यवाद ओर स्तुति करी की भविष्यबाणिया रा प्रचार करो थे, ओर बीणा बजाओ थे। <verse eid="1CH 25:3" /><verse number="4" style="v" sid="1CH 25:4" />हेमानो रे पाऊआ बीचा ते, बुक्किय्याह, मत्तन्याह, उज्जीएल, शबूएल, यरीमोत, हनन्याह, हनानी, एलीआता, गिद्दलती, रोममतीएजेर, योशबकाशा, मल्लोती, होतीर ओर महजीओत;<verse eid="1CH 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 25:5" />परमेशरो रे वादे रे मुताबिक जो तेसरा नाओं बढ़ाणे री थी, यो सारे हेमानो रे पाऊ थे जो राजे रा दर्शी था; कऊँकि परमेशरे हेमानो खे चौदा पाऊ ओर तीन बेटिया दित्तिया थिया। <verse eid="1CH 25:5" /><verse number="6" style="v" sid="1CH 25:6" />यो सारे यहोवे रे मन्दरो दे बाजे बजाणे खे आपणे-आपणे बाओ रे वशो दे रई की, परमेशरो रे मन्दरो री सेवा रे कामो दे खंजरी, सारंगी ओर बीणा बजाओ थे। आसाप, यदूतून ओर हेमान राजे रे वशो दे रओ थे।<verse eid="1CH 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 25:7" />इना सबी री गिणती पाईया समेत जिने यहोवे रे गीत सीखे दे थे ओर सबी प्रकारा दे निपुण थे, 288 थी। <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />तिने क्या बड़ा, क्या छोटा, क्या समजदार, क्या चेला, आपणी-आपणी बारिया खे चिट्ठी पाई। <verse eid="1CH 25:8" /><verse number="9" style="v" sid="1CH 25:9" />पईली चिट्ठी आसापो रे पाऊआ बीचा ते यूसुफो रे नाओं पाँदे निकल़ी, दूजी चिट्ठी गदल्याह रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:9" /><verse number="10" style="v" sid="1CH 25:10" />तीजी चिट्ठी जक्कूरो रे नाओं पाँदे निकल़ी, जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:10" /><verse number="11" style="v" sid="1CH 25:11" />चौथी चिट्ठी यिस्रीए रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:11" /><verse number="12" style="v" sid="1CH 25:12" />पाँजी चिट्ठी नतन्याह रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:12" /><verse number="13" style="v" sid="1CH 25:13" />छठी चिट्ठी बुक्किय्याह रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:13" /><verse number="14" style="v" sid="1CH 25:14" />साती चिट्ठी यसरेला रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:14" /><verse number="15" style="v" sid="1CH 25:15" />आठी चिट्ठी यशायाह रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:15" /><verse number="16" style="v" sid="1CH 25:16" />नऊई चिट्ठी मत्तन्याह रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:16" /><verse number="17" style="v" sid="1CH 25:17" />दसी चिट्ठी शिमीए रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:17" /><verse number="18" style="v" sid="1CH 25:18" />ग्यारी चिट्ठी अजरेला रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:18" /><verse number="19" style="v" sid="1CH 25:19" />बारी चिट्ठी हशब्याह रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:19" /><verse number="20" style="v" sid="1CH 25:20" />तेरी चिट्ठी शूबाएलो रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:20" /><verse number="21" style="v" sid="1CH 25:21" />चौदी चिट्ठी मत्तित्याह रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:21" /><verse number="22" style="v" sid="1CH 25:22" />पन्द्री चिट्ठी यरेमोतो रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:22" /><verse number="23" style="v" sid="1CH 25:23" />सोल़ी चिट्ठी हनन्याह रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:23" /><verse number="24" style="v" sid="1CH 25:24" />सतारी चिट्ठी योशबकाशो रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:24" /><verse number="25" style="v" sid="1CH 25:25" />ठारी चिट्ठी हनानीए रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:25" /><verse number="26" style="v" sid="1CH 25:26" />उन्नी चिट्ठी मल्लोतीए रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:26" /><verse number="27" style="v" sid="1CH 25:27" />बीयूई चिट्ठी इलिय्याता रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:27" /><verse number="28" style="v" sid="1CH 25:28" />इक्की चिट्ठी होतीरो रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:28" /><verse number="29" style="v" sid="1CH 25:29" />बाई चिट्ठी गिद्दलतीए रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:29" /><verse number="30" style="v" sid="1CH 25:30" />तेई चिट्ठी महजीओतो रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे। <verse eid="1CH 25:30" /><verse number="31" style="v" sid="1CH 25:31" />चौबी चिट्ठी रोममतीएजेरो रे नाओं पाँदे निकल़ी जेसरे पाऊ ओर पाईबन्दु तेस समेत बारा थे।<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s">यहोवे रे मन्दरो रे द्वारपाल</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1" />तेबे द्वारपाला रे दल यो थे: कोरहिया बीचा ते मशेलेम्याह, जो कोरे रा पाऊ ओर आसापो रिया ल्वादा बीचा ते था।<verse eid="1CH 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 26:2" />ओर मशेलेम्याह रे यो पाऊ ऊए, मतलब तेसरा जेठा जकर्याह, दूजा यदीएल, तीजा जबद्याह, <verse eid="1CH 26:2" /><verse number="3" style="v" sid="1CH 26:3" />चौथा यातनीएल, पाँजुआ एलाम, छठा यहोहानान ओर सातुआ एल्यहोएनै। <verse eid="1CH 26:3" /><verse number="4" style="v" sid="1CH 26:4" />परमेशरे ओबेदेदोमो खे आशीष दित्ती, फेर तेसरे बी पाऊ ऊए, तेसरा जेठा शमायाह, दूजा यहोजाबाद, तीजा योआह, चौथा साकार, पाँजुआ नतनेल, <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />छठा अम्मीएल, सातुआ इस्साकार ओर आठुआ पुल्लतै था। ईंयां परमेशरे तेसखे आशीष दित्ती। <verse eid="1CH 26:5" /><verse number="6" style="v" sid="1CH 26:6" />ओर तेसरे पाऊ शमायाह रे बी पाऊ पैदा ऊए, जो शूरवीर ऊणे रिया बजा ते आपणे बाओ रे कराने पाँदे राज करो थे। <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />शमायाह रे पाऊ यो थे, मतलब ओतनी, रपाएल, ओबेद, एलजाबाद ओर तिना रे पाई एलीहू ओर समक्याह तागतबर मर्द थे। <verse eid="1CH 26:7" /><verse number="8" style="v" sid="1CH 26:8" />यो सब ओबेदेदोमो री ल्वादा बीचा ते थे, सेयो ओर तिना रे पाऊ ओर पाई एसा सेवा रे कामो खे तागतबर ओर शक्तिशाली थे; यो ओबेदेदोमी बाठ जणे थे। <verse eid="1CH 26:8" /><verse number="9" style="v" sid="1CH 26:9" />मशेलेम्याह रे पाऊ ओर पाई ठारा थे, जो तागतबर थे।<verse eid="1CH 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 26:10" />तेबे मरारिए रे कुलो बीचा ते होसा रे बी पाऊ थे, मतलब जेठा शिम्री (जो जेठा ना ऊँदे ऊए बी तेसरे बाओए जेठा ठराया), <verse eid="1CH 26:10" /><verse number="11" style="v" sid="1CH 26:11" />दूजा हिल्किय्याह, तीजा तबल्याह ओर चौथा जकर्याह था; होसा रे सारे पाऊ ओर पाई मिली की तेरा थे।<verse eid="1CH 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12" />यो द्वारपाला रे दलो रे मुख्य मर्द थे, यो आपणे पाईया रे बराबर ई यहोवे रे मन्दरो दे सेवा-टईल करो थे। <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />इने क्या छोटे, क्या बड़े, आपणे-आपणे पितरा रे कराने रे मुताबिक एक-एक बड़े द्वारो खे चिट्ठी पाई। <verse eid="1CH 26:13" /><verse number="14" style="v" sid="1CH 26:14" />पूर्वो री तरफा री चिट्ठी शेलेम्याह रे नाओं पाँदे निकल़ी। तेबे तिने तेसरे पाऊ जकर्याह रे नाओं री चिट्ठी पाई से अक्लमंद मंत्री था ओर चिट्ठी उत्तरो री तरफा खे निकल़ी। <verse eid="1CH 26:14" /><verse number="15" style="v" sid="1CH 26:15" />दक्खणा रिया तरफा खे ओबेदेदोमो रे नाओं पाँदे चिट्ठी निकल़ी ओर तेसरे पाऊआ रे नाओं पाँदे खजाने री कमरे री चिट्ठी निकल़ी जेती किमती चीजा थिया। <verse eid="1CH 26:15" /><verse number="16" style="v" sid="1CH 26:16" />तेबे शुप्पीम ओर होसा रे नाओं री चिट्ठी पच्छमा रिया तरफा खे निकल़ी, ताकि सेयो शल्लेकेत नाओं रे बड़े द्वारो गे चढ़ाईया री सड़का पाँदे आमणे-सामणे चौकीदारी करेया करो। <verse eid="1CH 26:16" /><verse number="17" style="v" sid="1CH 26:17" />पूर्वो रिया तरफा खे तो छे लेविये थे, उत्तरो रिया तरफा खे हर रोज चार, दक्खणा रिया तरफा खे हर रोज चार ओर खजाने रे कमरे गे दो ठईरे। <verse eid="1CH 26:17" /><verse number="18" style="v" sid="1CH 26:18" />पच्छमा रिया तरफा रे पर्बार नाओं री जगा पाँदे ऊच्ची सड़का गे तो चार ओर पर्बारो गे दो रये। <verse eid="1CH 26:18" /><verse number="19" style="v" sid="1CH 26:19" />यो द्वारपाला रे दल थे, जिना बीचा ते कई तो कोरह रे कुलो रे थे ओर कई जणे मरारिए रे कुलो रे थे।<verse eid="1CH 26:19" /></para>
  <para style="s">मन्दरो रे पण्डारी ओर लग सेवा</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />तेबे लेविया बीचा ते अहिय्याह परमेशरो रे मन्दरो दे ओर पवित्र कित्ती री चीजा, दुँईं रे पण्डारो रा अधिकारी ठराया। <verse eid="1CH 26:20" /><verse number="21" style="v" sid="1CH 26:21" />यो लादानो री ल्वादा रे थे, मतलब गेर्शोनिया री ल्वाद जो लादानो रे कुलो रे थे, मतलब लादान ओर गेर्शेनिया रे पितरा रे करानेया रे मुख्य मर्द थे, मतलब यहोएली। <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />यहोएलीए रे पाऊ यो थे, मतलब जेताम ओर तेसरा पाई योएल जो यहोवे रे मन्दरो रे खजाने रे अधिकारी थे। <verse eid="1CH 26:22" /><verse number="23" style="v" sid="1CH 26:23" />अम्रामिया, यिसहारिया, हेब्रोनीया ओर उज्जिएलिया बीचा ते। <verse eid="1CH 26:23" /><verse number="24" style="v" sid="1CH 26:24" />ओर शबूएल जो मूसे रे पाऊ गेर्शोमो रे कुलो रा था, से खजानेया रा मुख्य अधिकारी था।<verse eid="1CH 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 26:25" />ओर तेसरे पाईया री जानकारी ये ए: एलीएजेरो रे कुलो दे तेसरा पाऊ रहब्याह, रहब्याह रा पाऊ यशायाह, यशायाह रा पाऊ योराम, योरामो रा पाऊ जिक्री ओर जिक्रीए रा पाऊ शलोमोत था। <verse eid="1CH 26:25" /><verse number="26" style="v" sid="1CH 26:26" />येई शलोमोत आपणे पाईया समेत तिना सबी पवित्र कित्ती री चीजा रे पण्डारो रा अधिकारी था, जो राजा दाऊद ओर पितरा रे करानेया रे मुख्य-मुख्य मर्द ओर सेनापति ओर बड़े सेनापति ओर मुख्य सेनापतिये पवित्र कित्तिया थिया। <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />जो लूट लड़ाईया दे मिलो थी, तिजी बीचा ते तिने यहोवे रा मन्दर बनाणे खे कुछ पवित्र कित्तेया। <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />बल्कि जितणा सेमुएल दर्शी, कीशो रे पाऊ शाऊल, नेरो रे पाऊ अब्नेर ओर सरूयाह रे पाऊ योआबे पवित्र कित्तेया था ओर जो कुछ जिने पवित्र करी राखेया था, से सब शलोमोत ओर तेसरे पाईया रे कब्जे दे था।<verse eid="1CH 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 26:29" />यिसहारिया बीचा ते कनन्याह ओर तेसरे पाऊ, इस्राएल देशो रा काम, मतलब सरदार ओर न्यायिया रा काम करने खे नियुक्त ऊए। <verse eid="1CH 26:29" /><verse number="30" style="v" sid="1CH 26:30" />ओर हेब्रोनिया बीचा ते हशब्याह ओर तेसरे पाई जो 1,700 तागतबर मर्द थे, यहोवे रे सारे काम ओर राजे री सेवा रे बारे यरदन नदिया री पच्छमा रिया तरफा खे रणे वाल़े इस्राएली लोका रे अधिकारी ठईरे। <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />हेब्रोनिया बीचा ते यरिय्याह मुख्य था, मतलब हेब्रोनिया रिया पीढ़िया रे पीतरा रे करानेया रे मुताबिक दाऊदो रे राज्य रे चाल़िए साले सेयो टोल़े ओर तिना बीचा ते कई शूरवीर गिलादो रे याजेरो दे मिले। <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />तेसरे पाई जो वीर थे, पितरा रे कराने रे 2,700 मुखिया थे, यो दाऊद राजे परमेशरो री हर चीजा रे बारे दे ओर राजे रे बारे दे, रूबेनी, गादी ओर मनश्शे रे आदे गोत्रो रे अधिकारी चूणी राखे थे।<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s">राजा दाऊदो रे मुख्य सेनापति</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1" />इस्राएली लोका री गिणती, मतलब पितरा रे करानेया रे मुख्य-मुख्य मर्द ओर जो ह्जारा पाँदे सेनापति थे ओर सौ पाँदे सेनापति थे ओर तिना रे सरदारा री गिणती जो पूरे साल मीन्ना-मीन्ना आजीर रणे ओर छुट्टी लणे वाल़े दला रे थे ओर सबी गल्ला रे बारे दे राजे री सेवा करो थे, हर एकी दलो दे 24,000 सिपाई थे। <verse eid="1CH 27:1" /><verse number="2" style="v" sid="1CH 27:2" />पईले मीन्ने दे पईले दलो रा अधिकारी जब्दीएलो रा पाऊ याशोबाम नियुक्त ऊआ ओर तेसरे दलो दे 24,000 सिपाई थे। <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />से पेरेसो रे कुलो रा था ओर पईले मीन्ने रे सबी सेनापतिया रा अधिकारी था।<verse eid="1CH 27:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 27:4" />दूजे मीन्ने रे दलो रा अधिकारी दोदै नाओं रा एक अहोही था ओर दूजे दलो रा परदान मिक्लोत था ओर तेसरे दलो दे 24,000 सिपाई थे।<verse eid="1CH 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 27:5" />तीजे मीन्ने खे तीजा सेनापति यहोयाद पुरोईतो रा पाऊ बनायाह था ओर तेसरे दलो दे 24,000 सिपाई थे। <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />ये से ई बनायाह ए, जो तीईया शूरवीरा बीचे वीर ओर तीईया बीचे श्रेष्ठ बी था ओर तेसरे दलो दे तेसरा पाऊ अम्मीजाबाद था।<verse eid="1CH 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 27:7" />चौथे मीन्ने खे चौथा सेनापति योआबो रा पाई असाहेल था ओर तेसते बाद तेसरा पाऊ जबद्याह था ओर तेसरे दलो दे 24,000 सिपाई थे।<verse eid="1CH 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 27:8" />पाँजुए मीन्ने खे पाँजुआ सेनापति यिज्राही शम्हूत था ओर तेसरे दलो दे 24,000 सिपाई थे।<verse eid="1CH 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 27:9" />छठे मीन्ने खे छठुआ सेनापति तकोई इक्केशो रा पाऊ ईरा था ओर तेसरे दलो रे 24,000 सिपाई थे।<verse eid="1CH 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 27:10" />सातुए मीन्ने खे सातुआ सेनापति एप्रैमो रे कुलो रा हेलेस पलोनी था ओर तेसरे दलो दे 24,000 सिपाई थे।<verse eid="1CH 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 27:11" />आठुए मीन्ने खे आठुआ सेनापति जेरहो रे कुलो बीचा ते हूशाई सिब्बकै था ओर तेसरे दलो दे 24,000 सिपाई थे।<verse eid="1CH 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 27:12" />नऊए मीन्ने खे नऊआ सेनापति बिन्यामीनी अबीएजेर था जो अनातोत शईरो दे रणे वाल़ा था ओर तेसरे दलो दे 24,000 सिपाई थे।<verse eid="1CH 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 27:13" />दसुए मीन्ने खे दसुआ सेनापति जेरही महरै था जो नतोपाह रा रणे वाल़ा था ओर तेसरे दलो दे 24,000 सिपाई थे।<verse eid="1CH 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 27:14" />ग्यारुए मीन्ने खे ग्यारुआ सेनापति एप्रैमो रे कुलो रा बनायाह पिरातोन जगा रा रणे वाल़ा था ओर तेसरे दलो दे 24,000 सिपाई थे।<verse eid="1CH 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 27:15" />बारूए मीन्ने खे बारूआ सेनापति ओत्नीएलो रे कुलो रा हेल्दै नतोपाह रा रणे वाल़ा था ओर तेसरे दलो दे 24,000 सिपाई थे।<verse eid="1CH 27:15" /></para>
  <para style="s">इस्राएली गोत्रा रे मुखिया</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 27:16" />इस्राएली गोत्रा रे यो अधिकारी थे: मतलब रूबेनिया रा परदान जिक्रीए रा पाऊ एलीएजेर; शिमोनिया ते माका रा पाऊ शपत्याह; <verse eid="1CH 27:16" /><verse number="17" style="v" sid="1CH 27:17" />लेविया ते कमूएलो रा पाऊ हशब्याह; हारूणो री ल्वादा रा सादोक; <verse eid="1CH 27:17" /><verse number="18" style="v" sid="1CH 27:18" />यहूदा रा एलीहू नाओं रा दाऊदो रा एक पाई, इस्साकारो ते मीकाएलो रा पाऊ ओम्री; <verse eid="1CH 27:18" /><verse number="19" style="v" sid="1CH 27:19" />जबूलूनो ते ओबद्याह रा पाऊ यिशमायाह, नप्तालीए ते अज्रीएलो रा पाऊ यरीमोत; <verse eid="1CH 27:19" /><verse number="20" style="v" sid="1CH 27:20" />एप्रैमो ते अज्जयाह रा पाऊ होशे, पच्छमा दे मनश्शे रे आदे गोत्रो रा पदायाह रा पाऊ योएल; <verse eid="1CH 27:20" /><verse number="21" style="v" sid="1CH 27:21" />पूर्बा दे गिलाद जगा रे मनश्शे रे आदे गोत्रो ते जकर्याह रा पाऊ इद्दो, बिन्यामीनो ते अब्नेरो रा पाऊ यासीएल; <verse eid="1CH 27:21" /><verse number="22" style="v" sid="1CH 27:22" />ओर दानो ते यरोहामो रा पाऊ अजरेल परदान ठईरेया। यो ई इस्राएलो रे गोत्रा रे परदान थे।<verse eid="1CH 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23" />पर राजा दाऊदे तिना री गिणती जो बीइ साला ते निठे थे तिना री नि कित्ती, कऊँकि यहोवे इस्राएलो री गिणती सर्गो रे तारेया जेड़ी बढ़ाणे खे बोलेया था। <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />सरूयाह रा पाऊ योआब गिणती लणे लगेया, पर निपटाई नि सकेया, कऊँकि परमेशरो रा रोष इस्राएलो पाँदे पड़केया ओर ये गिणती दाऊद राजे रे इतिआसो दे नि लिखी।<verse eid="1CH 27:24" /></para>
  <para style="s">राज्य री तअन-सम्पतिया री देख-पाल करने वाल़े</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 27:25" />तेबे अदीएलो रा पाऊ अज्मावेत राजपण्डारो रा अधिकारी था ओर डोरू ओर शईर ओर गाँवो ओर गढ़ो रे पण्डारो रा अधिकारी उजिय्याह रा पाऊ योनातान था।<verse eid="1CH 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 27:26" />जो जमीना दे जिम्मीदारा रा काम करो थे, तिना रा अधिकारी कलूबो रा पाऊ एज्री था।<verse eid="1CH 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 27:27" />ओर अंगूरा रे बगीचे रा अधिकारी रामाई शिमी ओर अंगूरा रे बगीचे री उपज जो शराबो रे पण्डारो दे राखणे खे थी, तेतेरा अधिकारी शापामी जब्दी था।<verse eid="1CH 27:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 27:28" />ओर थालले देशो दे जैतून ओर गूलरो रे डाल़ो रा अधिकारी गदेरी बाल्हानान था ओर तेलो रे पण्डारो रा अधिकारी योआश था।<verse eid="1CH 27:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 27:29" />ओर शारोन जगा दे चरने वाल़े गाय-बल़दा रा अधिकारी शारोनी शित्रै था ओर तराईया रे गाय-बल़दा रा अधिकारी अदलैए रा पाऊ शापात था।<verse eid="1CH 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 27:30" />ओर ऊँटा रा अधिकारी इश्माएली ओबील ओर गह्दिया रा अधिकारी मेरोनोत जगा दे रणे वाल़ा येहदयाह था।<verse eid="1CH 27:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 27:31" />ओर पेडा-बाकरिया रा अधिकारी हग्री याजीज था। यो ई सब राजा दाऊदो री तअन-सम्पत्तिया रे अधिकारी थे।<verse eid="1CH 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 27:32" />ओर दाऊदो रा चाचा योनातान एक समजदार परदान ओर शास्त्री था ओर एक हक्मोनीए रा पाऊ एहीएल राजकुमारा साथे रया करो था। <verse eid="1CH 27:32" /><verse number="33" style="v" sid="1CH 27:33" />अहीतोपेल राजे रा मंत्री था ओर एरेकी हूशै राजे रा दोस्त था। <verse eid="1CH 27:33" /><verse number="34" style="v" sid="1CH 27:34" />अहीतोपेलो ते बाद बनायाह रा पाऊ यहोयादा ओर एब्यातार मंत्री बणाए। ओर राजे रा परदान सेनापति योआब था।<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s">मन्दरो रे बारे दे दाऊदो री सभा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />राजा दाऊदे इस्राएलो रे सारे परदाना खे, मतलब गोत्रा रे परदान ओर राजे री सेवा करने वाल़े दलो रे परदाना खे ओर जो ह्जार सिपाईया पाँदे सेनापति ओर सौ सिपाईया पाँदे सेनापति थे ओर राजा ओर तेसरे पाऊआ रे डांगर बगैरा सब तअन-सम्पत्तिया रे अधिकारी, सरदार ओर वीर ओर सारे शूरवीर यरूशलेम शईरो दे बुलाए। <verse eid="1CH 28:1" /><verse number="2" style="v" sid="1CH 28:2" />तेबे दाऊद राजा खड़े ऊई की बोलणे लगेया, “ओ मेरे पाईयो! ओर ओ मेरी प्रजा रे लोको! मेरी सुणो, मेरी इच्छा तो थी कि यहोवे रे वादे रे सन्दूको खे ओर आसा लोका रे परमेशरो रे पैरा री चौकिया खे राम करने खे एक मन्दर बणाऊँ ओर मैं तिजी खे बनाणे री त्यारी बी कित्ती थी।” <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />पर परमेशरे माखे बोलेया कि तूँ मेरे नाओं रा मन्दर नि बणाई सकदा, कऊँकि तूँ युद्ध करने वाल़ा ए ओर तैं खून बाह्यी राखेया। <verse eid="1CH 28:3" /><verse number="4" style="v" sid="1CH 28:4" />तेबे बी इस्राएलो रे यहोवा परमेशरे मेरे बाओ रे सारे कराने बीचा ते आऊँ ई चूणेया, ताकि इस्राएलो रा राजा सदा बणेया रा रऊँ, मतलब तिने यहूदा खे परदान ऊणे खे ओर यहूदा रे कराने बीचा ते मेरे बाओ रा कराना‍ चूणी ला ओर मेरे बाओ रे पाऊआ बीचा ते से माखे ई सारे इस्राएलो रा राजा बनाणे खे खुश ऊआ। <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />यहोवे माखे बऊत पाऊ देई राखे। तिने मेरे सबी पाऊआ बीचा ते सुलैमान चुणेया, ताकि से इस्राएलो रे परमेशरो रे राज्य रे सिंहासनो पाँदे बैठो। कऊँकि इस्राएल देशो पाँदे यहोवे रा ई राज था। <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />ओर तिने माखे बोलेया, “तेरे पाऊ सुलैमानो ई मेरा मन्दर ओर आँगण बनाणा, कऊँकि मैं से चूणी ला रा कि से मेरा पाऊ ठईरो ओर आऊँ तेसरा बाओ ठईरूँ। <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />ओर जे से मेरी आज्ञा ओर नियम मानणे खे आज-काल जेड़ा ए तेड़ा ई मजबूत रओ, तो मां तेसरा राज्य सदा बणाया दा राखणा।” <verse eid="1CH 28:7" /><verse number="8" style="v" sid="1CH 28:8" />इजी री खातर एबे तुसे इस्राएलो रे सामणे, मतलब यहोवे री मण्डल़िया रे सामणे ओर आपणे परमेशरो सामणे, आपणे परमेशर यहोवे री सारी आज्ञा खे मानो ओर तिना पाँदे त्यान देंदे रओ; ताकि तुसे एस अच्छे देशो रे अधिकारी बणे रे रओ। ओर एते जमीना खे आपू ते बाद आपणे कुलो रे लोका खे तिना री आपणी जमीन ऊणे खे छाडी देयो।<verse eid="1CH 28:8" /></para>
  <para style="s">दाऊदो रा सुलैमानो खे मन्दरो रे बारे दे समजयाणा</para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />“ओ मेरे पाऊ सुलैमान! तूँ आपणे बाओ रे परमेशरो रा ज्ञान राख ओर खरे मनो ते ओर खुश ऊई की तेसरी सेवा करदा रओ; कऊँकि यहोवा मनो खे परखोआ ओर जाणोआ कि माणूंए रे मनो दे क्या ए, तिजी रे बारे दे बी समजोआ। जे तूँ यहोवे रे नेड़े जाएगा, तो से ताखे मिलणा; पर जे तूँ तेसखे छाडी दे, तो तेस तूँ सदा खे छाडी देणा। <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />एबे चौकस रओ, ओर याओ बानी की यहोवे रे मन्दरो खे बनाणे रे कामो दे लगी जा, कऊँकि तिने तूँ एस कामो खे करने खे चूणी ला रा, जो कि पवित्र जगा ठईरनी।”<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />तेबे दाऊदे आपणे पाऊ सुलैमानो खे मन्दरो रे बरांडे, कमरे, पण्डार, अटारिया, पीतरले कमरे ओर प्राश्चितो रे टकणे री जगा रा नमूना, <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />ओर यहोवे रे मन्दरो रे आँगणो ओर चऊँ कनारले कमरे ओर परमेशरो रे मन्दरो रे पण्डार ओर पवित्र कित्ती री चीजा रे पण्डार, जो-जो नमूने तेसखे परमेशरो री आत्मा री प्रेरणा ते मिले थे, सेयो सब देईते। <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />फेर पुरोईत ओर लेविया रे दल, ओर यहोवे रे मन्दरो री सेवा रे सारे काम ओर यहोवे रे मन्दरो री सेवा रे सारे समान, <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />मतलब सबी प्रकारा री सेवा रे कामा खे सूईने रे पांडेया रिया तँईं सूईना तोली की ओर सब प्रकारो री सेवा रे कामा खे चाँदिए रे पांडेया खे चाँदी तोली की, <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />ओर सूईने री दीवटा खे ओर तिना रे दिऊएया खे हर एकी खे एक-एक दीवट ओर तेतेरे दिऊए रा सूईना तोली की ओर चाँदिए रे दीवटा खे एक-एक दीवट ओर तिना रे दिऊए री चाँदी, एक-एक दीवटो रे कामो रे मुताबिक तोली की, <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />ओर पेंटा री रोटिया री मेजा खे एक-एक मेजो रा सूईना तोली की ओर चाँदिए री मेजा खे चाँदी, <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />ओर शुद्ध सूईने रे कांडे, कटोरे ओर प्याले ओर सूईने रिया कटोरिया खे एकी-एकी कटोरिया रा सूईना तोली की ओर चाँदिए री कटोरिया खे एक-एक कटोरिया री चाँदी तोली की, <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />ओर तूपो री बेदिया खे तपाया रा सूईना तोली की, ओर रथ, मतलब यहोवे रे वादे रा सन्दूक टकणे खे ओर पंख फैलाए रे करूबा रे नमूनेया खे सूईना दित्तेया।<verse eid="1CH 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19" />दाऊदे बोलेया, “मैं यहोवे री सामर्था ते जो माखे ज्ञान मिलेया, ये सब जाणी-बूजी की लिखी ता रा।” <verse eid="1CH 28:19" /><verse number="20" style="v" sid="1CH 28:20" />तेबे राजा दाऊदे आपणे पाऊ सुलैमानो खे बोलेया, “याओ बान ओर मजबूत ऊई की एस कामो खे करने खे लगी जा। डर नि ओर तेरा मन कच्चा नि ओ, कऊँकि यहोवा परमेशर जो मेरा परमेशर ए, से तां साथे ए ओर जदुओ तक यहोवे रे मन्दरो दे जितणा काम करना ऊगा, से नि ऊई चुकोगा, तदुओ तक तेस ना तो ताखे तोखा देणा ओर ना तूँ छाडणा। <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />ओर देख, परमेशरो रे मन्दरो रे सारे कामो खे पुरोईत ओर लेविया रे दल बणाई राखे ओर हर प्रकारा री सेवा खे सबी प्रकारा रे काम खुशिया साथे करने खे अक्लमंद मर्दा बी तेरा साथ देणा ओर परदान ओर सारी प्रजा रे लोका बी जो कुछ तां बोलणा, सेई करना।”<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s">मन्दरो रा काम करने रिया तँईं पेंट</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />तेबे दाऊद राजे सारी प्रजा खे बोलेया, “मेरा पाऊ सुलैमान बच्चा ईए ओर परमेशरे बस सेई चूणी राखेया; मन्दरो रा काम तो पारी ए, कऊँकि ये मन्दर माणूंए खे नि, बल्कि परमेशर यहोवे खे बणना। <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />जदुओ तक मांदे तागत थी, मैं आपणे परमेशरो रे मन्दरो खे सूईने रिया चीजा खे सूईना, चाँदिए रिया चीजा खे चाँदी, पीतल़ी रिया चीजा खे पीतल़ ओर लोए रिया चीजा खे लोआ ओर लकड़िया रिया चीजा खे लकड़ी ओर सुलैमानी पात्थर, जड़ने जोगी मणि, ओर पच्चीकारीया रे कामो खे लग-लग रंगो रे नग ओर हर प्रकारा रिया मणिया ओर बऊत सारा संगमरमर कट्ठा कित्तेया। <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />तेबे मेरा मन आपणे परमेशरो रे मन्दरो दे लगी रा, इजी बजा ते मैं जो कुछ पवित्र मन्दरो खे कट्ठा करी राखेया, तिना सबी ते जादा आऊँ आपणा तअन बी जो सूईने-चाँदिए रे रूपो रे मांगे ए, आपणे परमेशरो रे मन्दरो खे देई देऊँआ। <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />मतलब लगभग 100 टन<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="fq" closed="false">100 टन </char><char style="ft" closed="false">3,000 किक्कार </char></note> ओपीरो रा सूईना ओर लगभग 260 टन<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="fq" closed="false">260 टन </char><char style="ft" closed="false">7,000 किक्कार </char></note> शुद्ध कित्तेया रा चाँदी, जेते की कमरे री पीत मढ़नी। <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />ओर सूईने रिया चीजा खे सूईना, ओर चाँदिए री चीजा खे चाँदी देई राखी। ताकि तिजी ते बढ़िया काम करने वाल़े कारीगर सबी प्रकारा रिया चीजा बणाई सको। एबे तुसा लोका बीचा ते कुण ए जो आपणे आपू खे यहोवे खे अर्पित करी सकोआ?”<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />तेबे पितरा रे कराने रे परदान, ओर इस्राएलो रे लग-लग गोत्रा रे परदान ओर ह्जारा सिपाईया पाँदे जो सेनापति ओर सौ सिपाईया पाँदे जो सेनापति ए ओर राजे रे कामो रे अधिकारी आपणी-आपणी इच्छा ते, <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />परमेशरो रे मन्दरो रे कामो खे लगभग 185 टन<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="fq" closed="false">185 टन </char><char style="ft" closed="false">5,000 किक्कार </char></note> ओर 10,000 सूईने रे सिक्के, लगभग 370 टन<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="fq" closed="false">370 टन </char><char style="ft" closed="false">10,000 किक्कार </char></note> चाँदी, लगभग 670 टन<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="fq" closed="false">670 टन </char><char style="ft" closed="false">18,000 किक्कार </char></note> पीतल़ ओर लगभग 3,700 टन<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="fq" closed="false">3,700 टन </char><char style="ft" closed="false">100,000 किक्कार </char></note> लोआ देईता। <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />ओर जिना गे मणि थे, तिने सेयो यहोवे रे मन्दरो रे खजाने खे गेर्शोनो रे रणे वाल़े यहीएलो रे आथो दे देईता। <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />तेबे प्रजा रे लोक खुश ऊए, कऊँकि सबी परदाने खुश ऊई की खरे मन ओर आपणी-आपणी इच्छा ते यहोवे खे पेंट दित्ती थी ओर दाऊद राजा बऊत ई खुश ऊआ।<verse eid="1CH 29:9" /></para>
  <para style="s">दाऊदो रे जरिये परमेशरो रा तन्यवाद</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />तेबे राजा दाऊदे सारी सभा सामणे यहोवे रा तन्यवाद कित्तेया ओर दाऊदे बोलेया, “ओ यहोवा! ओ म्हारे मूल़ मर्द इस्राएलो रे परमेशर! शुरूओ ते लई की अन्तो तक तूँ ई तन्य ए। <verse eid="1CH 29:10" /><verse number="11" style="v" sid="1CH 29:11" />ओ यहोवा! महिमा, पराक्रम, शोभा, सामर्थ ओर वैभव तेरा ईए; कऊँकि सर्ग ओर तरतिया पाँदे जो कुछ ए, से तेरा ईए; ओ यहोवा! राज्य तेरा ए ओर तूँ सबी ते बड़ा ओर महान् ए। <verse eid="1CH 29:11" /><verse number="12" style="v" sid="1CH 29:12" />तअन ओर महिमा तेरी तरफा ते मिलोई ओर तूँ सबी पाँदे राज करेया। सामर्थ ओर पराक्रम तेरे ई आथो दे ए ओर सबी लोका खे बढ़ाणा ओर तागत देणी तेरे ई आथो दे ए। <verse eid="1CH 29:12" /><verse number="13" style="v" sid="1CH 29:13" />इजी री खातर एबे ओ मेरे परमेशर! आसे तेरा तन्यवाद ओर तेरे महिमा वाल़े नाओं री स्तुति करूँए। <verse eid="1CH 29:13" /><verse number="14" style="v" sid="1CH 29:14" />ना तो आऊँ कुछ ए ओर ना ई मेरी‍ प्रजा कुछ ए। आसा दे इतणी तागत नि ए आसे आपणिया मर्जिया ते ताखे कुछ पेंट देई सकिए। तांते ई आसा खे सब कुछ मिलोआ ओर आसे तांते ई लया ओर ताखे ई दित्तेया। <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />तेरी नजरा दे तो आसे आपणे सबी बुजुर्गा जेड़े पराए ओर परदेशी ए; तरतिया पाँदे आसा रे दिन छांयी जेड़े बीतणे लगी रे ओर आसा रा कुछ ठकाणा नि ए।<note caller="+" style="f"><char style="fr" closed="false">29:15 </char><char style="ft" closed="false">इब्रा. 11:13, पज. 39:12, पज. 114:4</char></note> <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />ओ म्हारे यहोवा परमेशर! आसे तेरे पवित्र नाओं रा एक मन्दर बनाणे खे जो इतणा सारा समान कट्ठा करी राखेया, से आसा खे तेरे ई आथो ते मिलेया था ओर सब तेरा ईए। <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />ओ मेरे परमेशर! आऊँ जाणूंआ कि तूँ मनो खे परखेया ओर सच्चाईया ते खुश रएया मैं तो ये सब कुछ बिना भेदभाव ते ओर आपणी इच्छा ते देई राखिया ओर एबे मैं खुशिया साथे देखी राखेया कि तेरी प्रजा रे लोक जो एती आजीर ए, सेयो आपणी इच्छा ते ताखे पेंट देओए। <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />ओ यहोवा! ओ म्हारे बुजुर्ग अब्राहम, इसहाक ओर इस्राएलो रे परमेशर! आपणी प्रजा रे मनो री सोचा दे ये गल्ल बणाई री राख ओर तिना रे मन आपणी तरफा खे लगाए रे राख। <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />ओर मेरे पाऊ सुलैमानो रा मन एड़ा खरा करी दे कि से तेरी आज्ञा, चितौणी ओर बिधिया खे मानदा रओ ओर ये सब कुछ करो ओर तेस मन्दरो खे बणाओ, जेतेरी त्यारी मैं करी राखी।” <verse eid="1CH 29:19" /><verse number="20" style="v" sid="1CH 29:20" />तेबे राजा दाऊदे सारी सभा खे बोलेया, “तुसे आपणे परमेशर यहोवे रा तन्यवाद करो।” तेबे सभा रे सबी लोके आपणे पितरा रे परमेशर यहोवे रा तन्यवाद कित्तेया ओर आपणा-आपणा सिर चुकाई की यहोवे गे ओर राजे गे माथा टेकेया।<verse eid="1CH 29:20" /></para>
  <para style="s">सुलैमानो रा राज्याभिषेक</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />ओर दूजे दिने तिने यहोवे खे बलिदान चढ़ाए, मतलब अर्घा समेत 1,000 बल़द, 1,000 खाडू ओर 1,000 पेडा रे बच्चे होमबलि करी की चढ़ाए ओर सारे इस्राएलो रे लोका खे बऊत मेलबलि चढ़ाए। <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />तेस ई दिने तिने यहोवे रे सामणे बड़ी खुशिया साथे खाया ओर पिया। तेबे तिने दाऊदो रा पाऊ सुलैमान दूजी बार राजा बणाई की यहोवे रिया तरफा ते परदान ऊणे खे तेसरा ओर पुरोईत ऊणे खे सादोको रा अभिषेक कित्तेया। <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />तेबे सुलैमान आपणे बाओ दाऊदो री जगा पाँदे राजा ऊई की यहोवे रे सिंहासनो पाँदे बैठणे लगेया ओर भाग्यशाली ऊआ ओर इस्राएल तेसरे वशो दे ऊआ। <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />तेबे सबी परदाने ओर शूरवीरे दाऊद राजे रे पाऊ सुलैमान राजे रे वशो दे रणा मानी ला। <verse eid="1CH 29:24" /><verse number="25" style="v" sid="1CH 29:25" />ओर यहोवे सुलैमान सबी इस्राएली लोका सामणे बऊत बढ़ाया ओर तेसखे एड़ा राजो रा ऐश्वर्य दित्तेया, जेड़ा तेसते पईले इस्राएलो दे केसी राजे खे नि ऊआ था।<verse eid="1CH 29:25" /></para>
  <para style="s">राजा दाऊदो री मौत</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />ईंयाँ यिशै रे पाऊ दाऊदे सारे इस्राएलो पाँदे राज कित्तेया। <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />ओर तिने इस्राएलो पाँदे चाल़िया साला तक राज कित्तेया; तिने सात साल तो हेब्रोनो दे ओर तेत्तीया साला तक यरूशलेम शईरो दे राज कित्तेया। <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />ओर से पूरा स्याणा ओर लाम्बी उम्रा रा ऊई की ओर तअन ओर वैभव, मनमाना पोगी की मरी गा ओर तेसरा पाऊ सुलैमान तेसरी जगा पाँदे राजा बणेया। <verse eid="1CH 29:28" /><verse number="29" style="v" sid="1CH 29:29" />शुरूओ ते लई की अंतो तक दाऊद राजे रे सबी कामा रा वर्णन, सेमुएल नबीए, नातान नबीए ओर गाद नबीए रिया इतिआसो रिया कताबा दे लिखी राखे। <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />ओर तेसरे सब राज्य ओर पराक्रमो रा, ओर तेस पाँदे ओर इस्राएलो पाँदे, बल्कि देश-देशो रे सबी राजो पाँदे जो कुछ बीतेया, इजी रा बी वर्णन शमूएल दर्शी ओर नातान नबी ओर गाद दर्शीए री कताबा दे लिखी राखेया।<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>