<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NEH" style="id" />
  <para style="h">नहेम्याह</para>
  <para style="toc1">नहेम्याह नाओं री कताब</para>
  <para style="toc2">नहेम्याह</para>
  <para style="toc3">नहे.</para>
  <para style="mt">नहेम्याह</para>
  <para style="mt2">नहेम्याह नाओं री कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">नहेम्याह नाओं री कताब तीऊँ इस्सेया दे बांडी जाई सकोई:</para>
  <para style="ili">(1) नहेम्याह जेसखे फारसो रे राजे यहूदा रा राज्यपाल बणाया था, तेसरिया अगुवाईया दे यरूशलेम शईरो री दवाला रा दुबारा बणाया जाणे री जानकारी। एते ते अलावा नहेम्याह कईया तरआ रे समाजिक ओर तार्मिक सुदार करोआ।</para>
  <para style="ili">(2) एज्रा रे जरीये लोका खे परमेशरो रे बिधि-बिधानो रा पढ़ी की सुनाणा, ओर लोका रा आपणे पापा रा अंगीकार करना।</para>
  <para style="ili">(3) यहूदा रे राज्यपालो रे रूपो दे नहेम्याह रे ओर बी काम।</para>
  <para style="ip">एते कताबा री एक खास खासियत ए नहेम्याह रा परमेशरो पाँदे पूरा परोसा ओर लगातार तेसते प्रार्थना करने रे बारे दे जानकारी।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">नहेम्याह रा यरूशलेम शईरो खे आऊणा <char style="ior"><ref loc="NEH 1:1-2:20">1:1-2:20</ref></char></para>
  <para style="io1">यरूशलेम शईरो री दवाला रा दुबारा बणाया जाणा <char style="ior"><ref loc="NEH 3:1-7:73">3:1-7:73</ref></char></para>
  <para style="io1">बिधानो रा पढ़ेया जाणा ओर वादे दा नवां ऊणा <char style="ior"><ref loc="NEH 8:1-10:39">8:1-10:39</ref></char></para>
  <para style="io1">नहेम्याह रे ओर बी काम <char style="ior"><ref loc="NEH 11:1-13:31">11:1-13:31</ref></char></para>
  <chapter number="1" style="c" sid="NEH 1" />
  <para style="s">नहेम्याह री प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 1:1" />हकल्याह रे पाऊ नहेम्याह रे जरीये लिखिया दिया गल्ला: जेबे अर्तक्षत्र राजे रे राज करदे ऊए बीइ साल ऊए तेबे किसलेव नाओं रे मीन्ने दे, जेबे आऊँ शूशन नाओं रे राजगढ़ो दे रऊँ था, <verse eid="NEH 1:1" /><verse number="2" style="v" sid="NEH 1:2" />तेबे हनानी नाओं रा मेरा एक पाई ओर यहूदा ते आए दे कई यहूदी पाई मांगे आए; तेबे मैं तिना ते तिना बचे रे यहूदिया रे बारे दे जो गुलामिया ते छूटी गे थे ओर एबे यरूशलेम शईरो दे रओ थे तिना रे बारे दे पूछेया। <verse eid="NEH 1:2" /><verse number="3" style="v" sid="NEH 1:3" />तिने मांगे बोलेया, “जो बचे दे लोक गुलामिया ते छूटी की इस्राएल राज्य दे रओए, तिना री दशा बऊत ई खराब ए ओर तिना री बेज्जती बी ओई; कऊँकि यरूशलेम शईरो री दवाल टूटी री ओर तेतेरे बड़े द्वार फूकी रे ए।” <verse eid="NEH 1:3" /><verse number="4" style="v" sid="NEH 1:4" />इना गल्ला खे सुणी की आऊँ बैठी की रोणे लगेया ओर कई दिना तक रोंदा रया ओर स्वर्गो रे परमेशरो रे सामणे बअरत कित्तेया ओर ये बोली की प्रार्थना करदा रया, <verse eid="NEH 1:4" /><verse number="5" style="v" sid="NEH 1:5" />“ओ स्वर्गो रे यहोवा परमेशर, ओ महान ओर डरो जोगे परमेशर! तूँ जो आपणे प्यार राखणे वाल़ेया ओर आज्ञा मानणे वाल़ेया रे बारे दे आपणी वाचा पूरी करेया ओर तिना पाँदे दया करेया, <verse eid="NEH 1:5" /><verse number="6" style="v" sid="NEH 1:6" />तूँ कान लगाई कि सुण ओर आखी खोली की देख, ताकि जो प्रार्थना आऊँ तेरा दास एस बखते तेरे सारे इस्राएली लोका खे दिन-रात करदा रऊँआ, तिजी खे तूँ सुण। आऊँ सबी इस्राएली लोका रे पाप जो आसे तेरे खलाफ करी राखे, मानी लऊँआ। मेरे बाओ रे कराने ओर मैं पाप करी राखेया।”<verse eid="NEH 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 1:7" />आसे तां सामणे बऊत बुराई करी राखी ओर जो आज्ञा, बिधिया ओर बिधान तैं आपणे दास मूसे खे दित्ते थे, सेयो आसे नि माने। <verse eid="NEH 1:7" /><verse number="8" style="v" sid="NEH 1:8" />तेस वचनो री सुधि लओ, जो तैं आपणे दास मूसे खे बोलेया था, “जे तुसे लोक मेरिया आज्ञा खे ना मानी की विश्वासघात करो, तो मां तुसे दूजे देशा रे लोका बीचे तित्तर-बित्तर करी देणे। <verse eid="NEH 1:8" /><verse number="9" style="v" sid="NEH 1:9" />पर जे तुसे मेरी तरफा खे फिरो ओर मेरी आज्ञा खे मानो ओर तिना पाँदे चलो, तेबे चाए तुसा बीचा ते निकयाल़े दे लोक तरतिया पाँदे जेती केथी बी ओ, तेबे बी मां सेयो तेथा ते कट्ठे करी की तेसा जगा दे पऊँचाणे, जो मैं आपणे आपू खे रणे री जगा चूणी राखी।” <verse eid="NEH 1:9" /><verse number="10" style="v" sid="NEH 1:10" />एबे सेयो तेरे दास ओर तेरी प्रजा रे लोक ए जो तैं आपणी बड़ी सामर्थ ओर आपणे तागती ते छुड़ाई राखे। <verse eid="NEH 1:10" /><verse number="11" style="v" sid="NEH 1:11" />ओ प्रभु प्रार्थना ये ए, “कि तूँ आपणे दासो री प्रार्थना पाँदे, ओर आपणे तिना दासा री प्रार्थना पाँदे, जो तेरे नाओं रा डर मानणा चाओए, कान लगा ओर आज आपणे दासो रा काम सफल कर ओर तेस माणूंए खे तिना पाँदे दयावान कर।” तिना दिना दे आऊँ तो राजे खे पल्याणे वाल़ा था।<verse eid="NEH 1:11" /></para>
  <chapter eid="NEH 1" />
  <chapter number="2" style="c" sid="NEH 2" />
  <para style="s">नहेम्याह रा यरूशलेम शईरो खे जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 2:1" />अर्तक्षत्र राजे रे राज करदे ऊए बीए साले नीसान नाओं रे मीन्ने दे, जेबे तेस सामणे शराब थी, तेबे मैं शराब चकी की राजे खे दित्ती। इजी ते पईले आऊँ कदी तेस सामणे उदास नि ऊआ था। <verse eid="NEH 2:1" /><verse number="2" style="v" sid="NEH 2:2" />तेबे राजे मांते पूछेया, “तूँ बमार तो नि ए, तेबे तेरा मूँ कऊँ उतरी रा? ये मनो री ई उदासी ए।” तेबे आऊँ थोड़ा जा डरीगा।<verse eid="NEH 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 2:3" />तेबे मैं राजे खे बोलेया, “राजा सदा जिऊँदा रओ! जेबे से शईर जिदे मेरे बुजुर्गा री कब्रा ए, उजाड़ पड़ी रा ओर तेतेरे द्वार फूखे दे ए, तो मेरा मूँ कऊँ नि उतरना?”<verse eid="NEH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 2:4" />राजे मांते पूछेया, तो तूँ क्या चाएया?, तेबे मैं स्वर्गो रे परमेशरो ते मनो दे प्रार्थना करी की राजे खे बोलेया, <verse eid="NEH 2:4" /><verse number="5" style="v" sid="NEH 2:5" />“अगर राजे खे ठीक लगो ओर तूँ आपणे दासो ते खुश ए, तो माखे यहूदा रे प्रदेशो दे जेती मेरे बुजुर्गा री कब्रा ए तेते शईरो खे पेजी दे, ताकि आऊँ तिजी खे फेर बणाऊँ।”<verse eid="NEH 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 2:6" />जेबे राजे गे राणी बैठी री थी, मांते पूछेया, “ताखे तेथी जाणे खे कितणे दिन लगणे? ओर वापस कदी आऊणा?” जेबे मैं तेसगे वापस आऊणे रा सई बखत दसेया तो राजा माखे पेजणे खे खुश ऊआ।<verse eid="NEH 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 2:7" />तेबे मैं राजे खे बोलेया, “जे राजे खे ठीक लगो, तो फरात नदिया रिया पच्छमा रिया जगा दे राज्यपाला खे ये लिखी की मांगे चिट्ठी देयो कि जदुओ तक आऊँ यहूदा दे नि पऊँचू, तदुओ तक सेयो माखे आपणे-आपणे देशो रिये ऊई की जाणे देयो। <verse eid="NEH 2:7" /><verse number="8" style="v" sid="NEH 2:8" />ओर सरकारी बणो रे रखवाल़े आसापो खे बी ये लिखी की चिट्ठी माखे देई दे, ताकि सेयो माखे परमेशरो रे मन्दरो साथे लगदे ऊए बणो दे लकड़िया री कड़िया खे, दवाला खे ओर तेस कअरो खे, जिदे आऊँ जाई की रणा, लकड़ी देयो।” मेरे परमेशरो री दया-दृष्टि मां पाँदे थी, इजी री खातर राजे मेरी ये प्रार्थना मानी ली। <verse eid="NEH 2:8" /><verse number="9" style="v" sid="NEH 2:9" />तेबे मैं फरात नदिया रिया पच्छमा रिया जगा दे परदाना गे जाईकी राजे रिया चिट्ठिया दित्तिया, राजे मां साथे सेनापति ओर कोड़े सवारा समेत पेजे थे। <verse eid="NEH 2:9" /><verse number="10" style="v" sid="NEH 2:10" />ये सुणी की कि एक माणूं इस्राएली लोका रा कल्याण करने खे आई रा, होरोनो रा रणे वाल़ा सम्बल्लत ओर तोबियाह नाओं रा अम्मोनो रा कर्मचारी, इना दुँईं खे बऊत बुरा लगेया। <verse eid="NEH 2:10" /><verse number="11" style="v" sid="NEH 2:11" />जेबे आऊँ यरूशलेम शईरो दे पऊँचेया, तेबे आऊँ तेथी तीऊँ दिना तक रया।<verse eid="NEH 2:11" /></para>
  <para style="s">नहेम्याह रा शईरो री दवाला खे देखणा</para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 2:12" />तेबे आऊँ थोड़े जे यहूदी मर्दा खे लई की राती उठेया; मैं केसी गे नि दशेया कि मेरे परमेशरे यरूशलेम शईरो रे कल्याणो खे मेरे मनो दे क्या परी राखेया। आऊँ आपणी सवारिया रे डांगरो खे छाडी की ओरी केसी बी डांगरो खे आपू साथे नि लईगा। <verse eid="NEH 2:12" /><verse number="13" style="v" sid="NEH 2:13" />आऊँ राती तराईया रे बड़े द्वारो रिये ऊई की निकल़ेया ओर अजगरो री सूबल़ा रिये ऊई की कूड़े रे बड़े द्वारो गे गया ओर यरूशलेम शईरो री टूटी री दवाल ओर फूखेया रा द्वार बी देखेया। <verse eid="NEH 2:13" /><verse number="14" style="v" sid="NEH 2:14" />तेबे आऊँ आगे चली की सूबल़ा रे बड़े द्वार ओर राजे रे कुण्डो गे गया; पर मेरी सवारिया रे डांगरो खे आगे जाणे खे जगा नि थी। <verse eid="NEH 2:14" /><verse number="15" style="v" sid="NEH 2:15" />तेबे आऊँ रातो-रात नाल़े रिये ऊई की दवाला खे देखदा ऊआ चढ़ीगा; तेबे कूमी की तराईया रे बड़े द्वारो ते पीतरे आया ओर ईंयाँ आऊँ वापस आया। <verse eid="NEH 2:15" /><verse number="16" style="v" sid="NEH 2:16" />ओर परदान नि जाणो थे कि आऊँ केई गया ओर क्या करुँ था; बल्कि मैं तदुओ तक ना तो यहूदिया खे कुछ बताया था, ओर ना पुरोईता खे ओर ना अमीरा खे ओर ना परदाना खे ओर ना ई दूजे काम करने वाल़ेया खे कुछ दशेया। <verse eid="NEH 2:16" /><verse number="17" style="v" sid="NEH 2:17" />तेबे मैं तिना खे बोलेया, “तुसे तो आपू देखणे लगी रे कि आसे केड़ी बुरी दशा दे ए कि यरूशलेम शईर उजाड़ पड़ी रा ओर तेतेरे द्वार फूखे रे ए। तो आओ, आसे यरूशलेम शईरो री दवाला खे बणाऊँए, ताकि आऊणे वाल़े बखतो दे म्हारी बेज्जती नि ओ।” <verse eid="NEH 2:17" /><verse number="18" style="v" sid="NEH 2:18" />तेबे मैं तिना गे बताया कि मेरे परमेशरो री दया-दृष्टि मां पाँदे केड़ी ऊई ओर राजे मां साथे क्या-क्या गल्ला बोली राखिया, तेबे तिने बोलेया, “आओ आसे इजी खे बनाणे री त्यारी करूँए।” ओर तिने एस खरे काम करने खे ईम्मत कित्ती। <verse eid="NEH 2:18" /><verse number="19" style="v" sid="NEH 2:19" />पर ये सुणी की होरोनो रा रणे वाल़ा सम्बल्लत ओर तोबियाह नाओं रा अम्मोनो रा कर्मचारी ओर गेशेम नाओं रा एक अरबी, म्हारा मजाक ड्वाणे लगे ओर आसा खे छोटा जाणी की बोलणे लगे, “तुसे ये क्या काम करने लगी रे। क्या तुसा राजे रे खलाफ बगावत करनी?” <verse eid="NEH 2:19" /><verse number="20" style="v" sid="NEH 2:20" />तेबे मैं तिना खे ज्वाब दित्तेया, “स्वर्गो रे न्यायी परमेशरो म्हारा काम सफल करना, इजी री खातर आसा जो तेसरे दास ए तनो-मनो ते ये बनाणा; पर यरूशलेम शईरो दे ना तो तुसा रा कोई इस्सा, ना कोई अक्क ओर ना कोई नशाणी ए।”<verse eid="NEH 2:20" /></para>
  <chapter eid="NEH 2" />
  <chapter number="3" style="c" sid="NEH 3" />
  <para style="s">यरूशलेम शईरो री दवाला रा दुबारा बणाया जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 3:1" />तेबे एल्याशीब नाओं रे बड़े पुरोईते आपणे पुरोईता पाईया साथे मिली की पेडा री गवाईणी रे द्वारो री दुबारा मरम्मत कित्ती, तिने तेतेरी प्रतिष्ठा कित्ती ओर तेतेरे फल़े बी लगाए ओर हम्मेआ नाओं रे गुम्मटो तक, बल्कि हननेलो रे गुम्मटो तक तिने दवाला री प्रतिष्ठा कित्ती। <verse eid="NEH 3:1" /><verse number="2" style="v" sid="NEH 3:2" />तिजी ते आगे यरीहो रे माणूंए मिली की मरम्मत कित्ती ओर इना ते आगे इम्रीए रे पाऊ जक्कूरे आपणे माणूंआ साथे मिली की मरम्मत कित्ती। <verse eid="NEH 3:2" /><verse number="3" style="v" sid="NEH 3:3" />तेबे मछलिया रा बड़े द्वार हस्सना रे माठेया मरम्मत कित्ती; तिने तिजी रिया कड़िया लगाईया ओर तिजी रे दरवाजे, ताल़े ओर परेगा लगाईया। <verse eid="NEH 3:3" /><verse number="4" style="v" sid="NEH 3:4" />तिना ते आगे मरेमोते जो हक्कोसो रा पोता ओर ऊरिय्याह रा पाऊ था, मरम्मत कित्ती। ओर इना ते आगे मशुल्लामे जो मशेजबेलो रा पोता ओर बेरेक्याह रा पाऊ था, तिजी री मरम्मत कित्ती। इजी ते आगे बाना रे पाऊ सादोके मरम्मत कित्ती। <verse eid="NEH 3:4" /><verse number="5" style="v" sid="NEH 3:5" />इना ते आगे तकोई शईरो रे लोके मरम्मत कित्ती, पर तिना रे अमीर माणूंए आपणे प्रभुए री सेवा रे कामो री जिम्मेदारी आपू पाँदे नि लया। <verse eid="NEH 3:5" /><verse number="6" style="v" sid="NEH 3:6" />तेबे पुराणे बड़े द्वारो री मरम्मत पासेह रे पाऊ योयादा ओर बसोदयाह रे पाऊ मशुल्लामे कित्ती; तिने तिजी दे कड़िया लगाईया ओर तिजी रे दरवाजे, ताल़े ओर परेगा लगाईया। <verse eid="NEH 3:6" /><verse number="7" style="v" sid="NEH 3:7" />ओर तिना ते आगे गिबोन शईरो रे मलत्याह ओर मेरोनोत शईरो रे यादोने ओर गिबोन ओर मिस्पा शईरो रे माणूंए फरात नदिया रिया पच्छमा रिया जगा रे राज्यपाला रे सिंहासनो रिया तरफा खे मरम्मत कित्ती। <verse eid="NEH 3:7" /><verse number="8" style="v" sid="NEH 3:8" />तिना ते आगे हर्हयाह रे पाऊ उजीएले ओर बाकी सन्यारे मरम्मत कित्ती, इजी ते आगे हनन्याहे, जो गन्धिया रे समाजो रा था, मरम्मत कित्ती, ओर तिने चौड़ी दवाला तक यरूशलेम शईर मजबूत कित्तेया। <verse eid="NEH 3:8" /><verse number="9" style="v" sid="NEH 3:9" />तिना ते आगे हूरो रे पाऊ रपायाहे, जो यरूशलेम शईरो रे आदे जिले रा परदान था, मरम्मत कित्ती। <verse eid="NEH 3:9" /><verse number="10" style="v" sid="NEH 3:10" />ओर तिना ते आगे हरुमपो रे पाऊ यदायाहे आपणे ई कअरो रे सामणे मरम्मत कित्ती ओर इजी ते आगे हशब्नयाह रे पाऊ हत्तूशे मरम्मत कित्ती। <verse eid="NEH 3:10" /><verse number="11" style="v" sid="NEH 3:11" />हारीमो रे पाऊ मल्कियाहे ओर पहत्मोआबो रे पाऊ हश्शूबे एक ओर इस्से री ओर भट्टेया रे गुम्मटा री मरम्मत कित्ती। <verse eid="NEH 3:11" /><verse number="12" style="v" sid="NEH 3:12" />इजी ते आगे यरूशलेम शईरो रे आदे जिले रे परदान हल्लोहेशो रे पाऊ शल्लूमे आपणी बेटिया साथे मिली की मरम्मत कित्ती। <verse eid="NEH 3:12" /><verse number="13" style="v" sid="NEH 3:13" />तराईया रे बड़े द्वारो री मरम्मत हानून ओर जानोह शईरो रे रणे वाल़ेया लोके कित्ती, तिने से बणाया ओर तिजी रे ताल़े, परेगा लगाईया ओर दरवाजे लगाए ओर 1,500 फुट लाम्बी दवाल बी बणाई, मतलब कूड़े रे बड़े द्वारो तक बणाया।<verse eid="NEH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 3:14" />कूड़ा बड़े द्वारो री मरम्मत रेकाबो रे पाऊ मल्कियाहे कित्ती, जो बेथक्केरेम जिले रा परदान था; तिने ई से बणाया ओर तिजी रे ताल़े, दरवाजे ओर परेगा लगाईया।<verse eid="NEH 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 3:15" />सूबल़ा रे बड़े द्वारो री मरम्मत कोल्होजो रे पाऊ शल्लूमे कित्ती, जो मिस्पा रे जिले रा परदान था तिने ई से बणाया ओर छवांया ओर तिजी रे ताल़े, परेगा ओर दरवाजे लगाए। ओर तिने ई राजे रे बगीचे रे नेड़े रे शेलह नाओं रे कुण्डो री दवाला खे बी दाऊदो रे शईरो ते उतरने वाल़ी पईड़िया तक बणाया। <verse eid="NEH 3:15" /><verse number="16" style="v" sid="NEH 3:16" />तेसते बाद अजबूको रे पाऊ नहेम्याहे जो बेतसूरो रे आदे जिले रा परदान था, दाऊदो रे कब्रिस्तानो ते सामणे तक ओर माणूंआ रे बणाए रे तलाबो तक, बल्कि वीर माणूंआ रे कअरो तक बी मरम्मत कित्ती।<verse eid="NEH 3:16" /></para>
  <para style="s">लेविये तिने जे दवाला री मरम्मत कित्ती</para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 3:17" />इजी ते बाद बानीए रे पाऊ रहूमे कई लेविया खे साथे लई की मरम्मत कित्ती। इजी ते आगे कीला रे आदे जिले रे परदान हशब्याहे आपणे जिले रिया तरफा ते मरम्मत कित्ती। <verse eid="NEH 3:17" /><verse number="18" style="v" sid="NEH 3:18" />तेसते बाद तिना रे पाईया समेत कीला रे आदे जिले रे परदान हेनादादो रे पाऊ बव्वैए मरम्मत कित्ती। <verse eid="NEH 3:18" /><verse number="19" style="v" sid="NEH 3:19" />तिजी ते आगे एक ओर इस्से री मरम्मत जो दवाला रे मोड़ो गे शस्त्रा रे कअरो री चढ़ाईया सामणे ए, येशूए रे पाऊ एज़ेरे कित्ती, जो मिस्पा रा परदान था। <verse eid="NEH 3:19" /><verse number="20" style="v" sid="NEH 3:20" />तेबे एक ओर इस्से री मतलब तेस ई मोड़ो ते लई की एल्याशीब नाओं रे बड़े पुरोईतो रे कअरो रे द्वारो तको री मरम्मत जब्बैए रे पाऊ बारूके तनो-मनो ते कित्ती। <verse eid="NEH 3:20" /><verse number="21" style="v" sid="NEH 3:21" />इजी ते बाद एक ओर इस्से री मतलब एल्याशीबो रे कअरो रे द्वारो ते लई की तेस ई कअरो रे सिरे तको री मरम्मत मरेमोते कित्ती, जो हक्कोसो रा पोता ओर ऊरिय्याह रा पाऊ था।<verse eid="NEH 3:21" /></para>
  <para style="s">पुरोईत जिने दवाला री मरम्मत कित्ती</para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 3:22" />तेसते बाद तिने पुरोईते मरम्मत कित्ती जो तराईया दे रणे वाल़े माणूं थे। <verse eid="NEH 3:22" /><verse number="23" style="v" sid="NEH 3:23" />तिना ते बाद बिन्यामीन ओर हश्शूबे आपणे कअरो रे सामणे मरम्मत कित्ती ओर तिना ते बाद अजर्याहे जो मासेयाह रा पाऊ ओर अनन्याह रा पोता था आपणे कअरो गे मरम्मत कित्ती। <verse eid="NEH 3:23" /><verse number="24" style="v" sid="NEH 3:24" />तेबे एक ओर इस्से री, मतलब अजर्याह रे कअरो ते लई की दवाला रे मोड़ो तक बल्कि तिजी रे कूणे तको री मरम्मत हेनादादो रे पाऊ बिन्नूईए कित्ती। <verse eid="NEH 3:24" /><verse number="25" style="v" sid="NEH 3:25" />तेबे तेस ई मोड़ो सामणे जो ऊच्चा गुम्मट राजमईलो ते बारे निकल़ेया रा जेला रे आँगणो रे नेड़े ए, तिजी ते सामणे ऊज्जै रे पाऊ पालाले मरम्मत कित्ती। इजी ते बाद परोशो रे पाऊ पदायाहे मरम्मत कित्ती। <verse eid="NEH 3:25" /><verse number="26" style="v" sid="NEH 3:26" />मन्दरो दे सेवा करने वाल़े लोक तो ओपेलो रे पूर्वो रिया तरफा खे पाणिए रे बड़े द्वारो सामणे तक ओर बारे निकल़े रे गुम्मटो तक रओ थे। <verse eid="NEH 3:26" /><verse number="27" style="v" sid="NEH 3:27" />पदायाह ते बाद तकोई शईरो रे लोके एक ओर इस्से री मरम्मत कित्ती, जो बारे निकल़े रे बड़े गुम्मटो रे सामणे ओर ओपेलो री दवाला तक ए।<verse eid="NEH 3:27" /></para>
  <para style="s">दवाला री मरम्मत करने वाल़े ओर लोक</para>
  <para style="p">
    <verse number="28" style="v" sid="NEH 3:28" />तेबे कोड़ेया रे बड़े द्वारो पाँदे पुरोईते आपणे-आपणे कअरो रे सामणे मरम्मत कित्ती। <verse eid="NEH 3:28" /><verse number="29" style="v" sid="NEH 3:29" />इजी ते बाद इम्मेरो रे पाऊ सादोके आपणे कअरो रे सामणे मरम्मत कित्ती ओर तेबे पूर्वो रे बड़े द्वारो रे रखवाल़े शकन्याह रे पाऊ शमायाहे मरम्मत कित्ती। <verse eid="NEH 3:29" /><verse number="30" style="v" sid="NEH 3:30" />इजी ते बाद शेलेम्याह रे पाऊ हनन्याह ओर सालापो रे छठुए पाऊए हानूने एक ओर इस्से री मरम्मत कित्ती। तेबे बेरेक्याह रे पाऊ मशुल्लामे आपणी कमरे सामणे मरम्मत कित्ती। <verse eid="NEH 3:30" /><verse number="31" style="v" sid="NEH 3:31" />तेसते बाद मल्कियाहे जो सन्यार था नतीनो ओर बपारिया री जगा तक ठराई री जगा रे बड़े द्वारो सामणे ओर कूणे रे कोठे तक मरम्मत कित्ती। <verse eid="NEH 3:31" /><verse number="32" style="v" sid="NEH 3:32" />ओर कूणे वाल़े कोठे ते लई की पेडा रे बड़े द्वारो तक सन्यारे ओर बपारिये मरम्मत कित्ती।<verse eid="NEH 3:32" /></para>
  <chapter eid="NEH 3" />
  <chapter number="4" style="c" sid="NEH 4" />
  <para style="s">यहूदिया रे दुश्‍मणा रा बरोद करना</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 4:1" />जेबे सम्बल्लते सुणेया कि यहूदी लोक यरूशलेम शईरो री दवाला खे बनाणे लगी रे, तेबे तेसखे बऊत बुरा लगेया ओर से बऊत रोषे ऊई की यहूदिया रा मजाक उडाणे लगेया। <verse eid="NEH 4:1" /><verse number="2" style="v" sid="NEH 4:2" />से आपणे पाईया रे ओर सामरिया री सेना सामणे ईंयाँ बोलणे लगेया, “सेयो कमजोर यहूदी क्या करना चाओए? क्या इना ये काम आपणी तागती साथे करना? क्या इना आपणी जगा मजबूत करनी? क्या तिना यज्ञ करना? क्या इना आज ई सारा काम निपटाई देणा? क्या तिने माट्टिया रे टेरो बीचले फूखे रे पात्थर फेर नये सिरे ते बनवाणे?” <verse eid="NEH 4:2" /><verse number="3" style="v" sid="NEH 4:3" />तेसगे तो अम्मोनी तोबियाह था ओर से बोलणे लगेया, “जो कुछ सेयो बनाणे लगी रे, जे कोई गीदड़ बी तिजी पाँदे चढ़ोगा, तो तेस तिना री बणाई री पात्थरा री दवाल तोड़ी देणी।”<verse eid="NEH 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 4:4" />तेबे नहेम्याहे परमेशरो ते प्रार्थना कित्ती ओर बोलेया, “ओ म्हारे परमेशर सुणी लो कि आसा री बेज्जती ऊणे लगी री ओर तिना री कित्ती री बेज्जती तिना रेई सिरो पाँदे वापस करी दे ओर इना खे गुलाम बणाई की दूजे देशो दे पेजी दे ताकि से देश इना रा सब कुछ लूटी लो। <verse eid="NEH 4:4" /><verse number="5" style="v" sid="NEH 4:5" />ओर इना रा पाप तूँ नि टख ओर ना ई इना रा पाप तां सामणे ते मिटाया जाओ; कऊँकि इने ताखे दवाला बनाणे वाल़ेया सामणे रोष चढ़ाई राखेया।”<verse eid="NEH 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 4:6" />आसे लोके दवाल बणाई ओर सारी दवाल आदी ऊचाईया तक जुड़ी गी, कऊँकि लोका रा मन तेस कामो दे हमेशा लगेया रा रया।<verse eid="NEH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 4:7" />जेबे सम्बल्लत ओर तोबियाह ओर अरबी लोके, अम्मोनी लोके ओर अशदोद शईरो रे लोके सुणेया कि यरूशलेम शईरो री दवाला री मरम्मत ऊणे लगी री ओर तेथो रे नाके बन्द ऊणे लगी रे, तेबे तिना खे बऊत बुरा लगेया; <verse eid="NEH 4:7" /><verse number="8" style="v" sid="NEH 4:8" />ओर सबी एक मनो ते साजिश कित्ती, कि जाई की यरूशलेम शईरो रे लोका साथे लड़ाई करूँए ओर तिना दे गड़बड़ी पाऊँए। <verse eid="NEH 4:8" /><verse number="9" style="v" sid="NEH 4:9" />पर आसे लोके आपणे परमेशरो ते प्रार्थना कित्ती ओर तिना रे डरो रे मारे रात-दिन पईरेदार ठराईते।<verse eid="NEH 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 4:10" />तेबे यहूदी लोक बोलणे लगे, “टोणे वाल़ेया री तागत कम ऊई गी ओर माट्टी बऊत पड़ी री, इजी री खातर दवाल आसा ते नि बणी सकदी।” <verse eid="NEH 4:10" /><verse number="11" style="v" sid="NEH 4:11" />ओर म्हारे दुश्मण बोलणे लगे, “जदुओ तक आसे तिना बीचे नि पऊँचदे ओर तिना खे काई की तेस कामो खे बन्द नि करी देऊँगे, तदुओ तक तिना खे ना कुछ पता लगणा ओर ना कुछ दिखणा।” <verse eid="NEH 4:11" /><verse number="12" style="v" sid="NEH 4:12" />तेबे जो यहूदी तिना रे नेड़े-तेड़े रओ थे, तिने सबी जगा ते कई बार आई-आई की आसा लोका खे बोलेया, “तुसा लोका खे आसा गे वापस आई जाणा चाईयो।” <verse eid="NEH 4:12" /><verse number="13" style="v" sid="NEH 4:13" />इजी बजा ते मैं लोका खे तलवारी, बड़छे ओर धनुष देई की दवाला रे पीछे सबी ते थाले खुली जगा दे कराने-कराने रे मुताबिक बठयाल़ी ते। <verse eid="NEH 4:13" /><verse number="14" style="v" sid="NEH 4:14" />तेबे आऊँ सारा काम देखी की उठेया ओर अमीर, ओर परदान ओर सबी लोका खे बोलेया, “तिना ते नि डरो; परमेशर जो महान ओर डरो जोगा ए, तेसखे ई याद करी की आपणे पाई, माठे-बेटिया, जवाणसा ओर कअरो रिया तँईं युद्ध करना।”<verse eid="NEH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 4:15" />जेबे म्हारे दुश्मणे सुणेया कि आसा खे इजी गल्ला रा पता लगी गा रा कि तिना आसा पाँदे अमला करना ओर परमेशरे तिना री योजना निष्फल करी राखी, तेबे आसे सब के सब दवाला गे आपणे-आपणे कामो पाँदे वापस ऊईगे। <verse eid="NEH 4:15" /><verse number="16" style="v" sid="NEH 4:16" />ओर तेस दिनो ते मेरे आदे सेवक तो तेस कामो खे करदे रये ओर आदे बड़छे, तलवारी, धनुष ओर झिलमा पईनी की पईरेदारिया रा काम करदे रओ थे; ओर यहूदा रे सारे कराने रे लोका पीछे जो काम करने लगी रे थे सेना रे परदान रया करो थे। <verse eid="NEH 4:16" /><verse number="17" style="v" sid="NEH 4:17" />दवाला खे बनाणे वाल़े ओर बोजा टोणे वाल़े दोनो पार चको थे, मतलब एकी आथो साथे काम करो थे ओर दूजे आथो साथे अथियार पकड़ी की राखो थे। <verse eid="NEH 4:17" /><verse number="18" style="v" sid="NEH 4:18" />राजमिस्त्री आपणी-आपणी खुटिया दे तलवार लटकाई की काम करो थे ओर नरसिंगा बजाणे वाल़ा मांगे रओ था। <verse eid="NEH 4:18" /><verse number="19" style="v" sid="NEH 4:19" />इजी री खातर मैं मुखिये, परदाना ओर सबी लोका खे बोलेया, “काम तो बड़ा ओर फैलेया रा ए ओर आसे लोक दवाला पाँदे लग-लग एकी दूजे ते दूर रऊँए। <verse eid="NEH 4:19" /><verse number="20" style="v" sid="NEH 4:20" />इजी री खातर जेथा ते तुसा खे नरसिंगा सुणो, तेथी आसा गे कट्ठे ऊई जाणा। म्हारा परमेशर म्हारी तरफा ते लड़ना।” <verse eid="NEH 4:20" /><verse number="21" style="v" sid="NEH 4:21" />ईंयाँ आसे कामो दे लगे दे रये ओर तिना बीचा ते आदे, प्यागा तड़के ते तारे निकल़ने तक बड़छे लई की रओ थे। <verse eid="NEH 4:21" /><verse number="22" style="v" sid="NEH 4:22" />तेबे तेस ई बखते मैं लोका खे ये बी बोलेया, “एक-एक माणूं आपणे दासा समेत यरूशलेम शईरो रे पीतरे रात बिताया करो, ताकि सेयो राती तो म्हारी रखवाल़ी करो ओर दिने कामो दे लगे दे रओ।” <verse eid="NEH 4:22" /><verse number="23" style="v" sid="NEH 4:23" />इजी बजा ते आऊँ ना तो आपणे टाल्ले खोलूँ था ओर ना मेरे पाई, ना मेरे सेवक, ना सेओ पईरेदार जो मां पीछे चलो थे, आपणे टाल़े नि खोलो थे; हर कोई पाणिए गे बी अथियार लई की जाओ थे।<verse eid="NEH 4:23" /></para>
  <chapter eid="NEH 4" />
  <chapter number="5" style="c" sid="NEH 5" />
  <para style="s">नहेम्याह रा गरीबा री मताद करना</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 5:1" />तेस बखते तेबे गरीब यहूदी लोक ओर तिना री जवाणसा रिया तरफा ते तिना रे पाई यहूदिया रे खलाफ बड़ा चींगणा ऊआ। <verse eid="NEH 5:1" /><verse number="2" style="v" sid="NEH 5:2" />कई लोक तो बोलो थे, “आसे आपणे माठे-बेटिया समेत बऊत लोक ए, इजी री खातर आसा खे नज्ज ओर बी जादा मिलणा चाईयो, ताकि तिजी खे खाई की जिऊँदे रऊँ।” <verse eid="NEH 5:2" /><verse number="3" style="v" sid="NEH 5:3" />कई बोलो थे, “आसे आपणे-आपणे डोरू, बगीचे ओर कअर अकाल़ो रिया बजअ ते गिरवी राखूँए, ताकि खाणे खे नज्ज मिलो।” <verse eid="NEH 5:3" /><verse number="4" style="v" sid="NEH 5:4" />तेबे कई जणे ये बोलो थे, “आसे राजे खे कर देणे रिया तँईं आपणे-आपणे डोरूआ ओर अंगूरा रे बगीचे पाँदे पैसा त्वारा लई राखेया। <verse eid="NEH 5:4" /><verse number="5" style="v" sid="NEH 5:5" />पर म्हारा ओर म्हारे पाईया रा शरीर ओर म्हारे ओर तिना रे बच्चे एक जेड़े ई ए, तेबे बी आसे आपणे माठे-बेटिया खे दास बणाऊँए; बल्कि म्हारिया कई बेटिया दासिया बी ऊई चूकी रिया ओर म्हारा कोई बस नि चलदा, कऊँकि म्हारे डोरू ओर अंगूरा रे बगीचे ओरी रे आथो दे पड़ी रे।”<verse eid="NEH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 5:6" />ये चींगणा ओर इना गल्ला खे सुणी की माखे बड़ा रोष आया। <verse eid="NEH 5:6" /><verse number="7" style="v" sid="NEH 5:7" />तेबे आपणे मनो दे सोच-बिचार करी की मैं मुखिये ओर परदाना खे रोषे ऊई की बोलेया, “तुसे आपणे-आपणे पाईया ते ब्याज लओए।” तेबे मैं तिना रे खलाफ एक बड़ी सभा कित्ती। <verse eid="NEH 5:7" /><verse number="8" style="v" sid="NEH 5:8" />ओर मैं तिना खे बोलेया, “आसे लोके तो आपणी सामर्थ आपणे यहूदी पाईया खे जो दूजी जातिया रे आथो दे बिकी गये थे, कीमत देई की छुड़ाए, तेबे क्या तुसा आपणे पाई बेचणे? क्या सेयो म्हारे आथे बिकणे?” तेबे सेयो चुप रये ओर कुछ नि बोली सके। <verse eid="NEH 5:8" /><verse number="9" style="v" sid="NEH 5:9" />तेबे आऊँ बोलदा गया, “जो काम तुसे करोए, से ठीक नि ए; क्या तुसा खे इजी बजा ते म्हारे परमेशरो रा डर मानी की चलणा नि चाईयो कि म्हारे दुश्मण जो दूजी जाति ए, सेयो म्हारी बेज्जती नि करो? <verse eid="NEH 5:9" /><verse number="10" style="v" sid="NEH 5:10" />आऊँ बी ओर मेरे पाई ओर सेवक तिना खे पैसा ओर नज्ज त्वारा देऊँए, पर आसे इजी रा ब्याज छाडी देऊँए। <verse eid="NEH 5:10" /><verse number="11" style="v" sid="NEH 5:11" />आज ई तिना खे तिना रे डोरू, ओर अंगूर, ओर जैतूनो रे बगीचे ओर कअर वापस देई देयो ओर जो पैसा, नज्ज, नया शराब ओर जैतूनो रा तेल तुसे तिना ते लओए, तिजी रा सौवा इस्सा वापस करी देयो?”<verse eid="NEH 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 5:12" />तिने बोलेया, “आसा तिना खे वापस देई देणा, ओर तिना ते कुछ नि लऊँगे; जेड़ा तुँ बोलेया, आसा तेड़ा ई करना।” तेबे मैं पुरोईता खे बुलाया ओर तिना मुखिया ओर परदाना खे कसम खुल़ाई, कि सेयो सेई काम करो जेते खे करने रा तिने बोली राखेया। <verse eid="NEH 5:12" /><verse number="13" style="v" sid="NEH 5:13" />तेबे मैं आपणे टाल्ले रे कूणे खे चाड़ी की बोलेया, “ईंयाँ जो कोई एस वचनो खे पूरा नि करोगा, तेसखे परमेशर चाड़ी की, तेसरा कअर ओर कमाई तेसते छुड़ाओ ओर ईंयाँ से चाड़ेया जाओ ओर से कंगाल़ ऊई जाओ।” तेबे सभा रे सबी लोके बोलेया, “आमीन्!” ओर तिने सबी यहोवे री स्तुति कित्ती ओर लोके एस वचनो रे मुताबिक कित्तेया।<verse eid="NEH 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 5:14" />फेर जेबे आऊँ यहूदा प्रदेशो दे तिना रा राज्यपाल बणाया, मतलब राजा अर्तक्षत्रो रे बिऊए सालो ते लई की तेसरे बत्थिये सालो तक, मतलब बारा साल तक मैं ओर मेरे पाईए परदानो रे अक्को री रोटी नि खाई राखी। <verse eid="NEH 5:14" /><verse number="15" style="v" sid="NEH 5:15" />पर पईलके राज्यपाल जो मांते पईले थे, सेयो प्रजा पाँदे पार पाओ थे ओर तिना ते रोटी, ओर शराब ओर इजी साथे चाल़ी शेकेल चाँदी लओ थे, बल्कि तिना रे नौकर बी प्रजा पाँदे अक्क जमाओ थे; पर आऊँ एड़ा नि करुँ था, कऊँकि आऊँ यहोवे रा डर मानूँ था। <verse eid="NEH 5:15" /><verse number="16" style="v" sid="NEH 5:16" />तेबे आऊँ दवाला रे कामो दे व्यस्त रया ओर आसे लोके कोई जमीन मोले नि लई ओर मेरे सब नौकर तेती काम करने खे कट्ठे रओ थे। <verse eid="NEH 5:16" /><verse number="17" style="v" sid="NEH 5:17" />तेबे मेरे मेजो पाँदे खाणे वाल़े 150 यहूदी ओर परदान ओर सेयो बी थे, जो चऊँ कनारे री दूजी जातिया बीचा ते आसा गे आये थे। <verse eid="NEH 5:17" /><verse number="18" style="v" sid="NEH 5:18" />जो हर रोज बणो था से एक बल़द, छे ठीक-ठीक पेडा ओर बाकरिया थिया ओर माखे चिड़िया रा मास बी बणाओ थे; दस-दस दिना बाद कईया प्रकारा रा बऊत शराब बी त्यार करेया जाओ था, पर तेबे बी मैं राज्यपाला रे अक्को री रोटी नि लई, <verse eid="NEH 5:18" /><verse number="19" style="v" sid="NEH 5:19" />कऊँकि प्रजा पाँदे कामो रा बड़ा पार था। ओ मेरे परमेशर! जो कुछ मैं एसा प्रजा रिया तँईं करी राखेया, तिजी रा फल माखे दे।<verse eid="NEH 5:19" /></para>
  <chapter eid="NEH 5" />
  <chapter number="6" style="c" sid="NEH 6" />
  <para style="s">नहेम्याह रे खलाफ साजिश</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 6:1" />जेबे सम्बल्लत, तोबियाह ओर अरबी गेशेम ओर म्हारे ओरी दुश्मणा खे ये सन्देश मिलेया कि आऊँ शईरो रिया चऊँ कनारलिया दवाला री मरम्मत करी चुकेया दा ए; तेबे बी तेस बखतो तक बी मैं बड़े द्वारा रे दरवाजे नि लगाई राखे थे, तेबे बी दवाला दे कोई दरार नि रई दी थी। <verse eid="NEH 6:1" /><verse number="2" style="v" sid="NEH 6:2" />तेबे सम्बल्लत ओर गेशेमे मांगे ये सन्देसा पेजेया, “आओ, आसे ओनो रे मैदानो रे केसी गाँवो रे एकी-दूजे साथे मिलूँए।” पर सेयो मेरा नुकशाण करना चाओ थे।<verse eid="NEH 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 6:3" />पर मैं तिना गे दूता रे जरीये सन्देसा पेजेया, “माखे तो बड़ा पारी काम ए, तेती नि जाई सकदा; मेरे एस कामो खे छाडी की तुसा गे आऊणे ते ये काम बन्द कऊँ रओ?”<verse eid="NEH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 6:4" />तेबे तिने चार बार मांगे से ई गल्ल बोलणे खे दूत पेजे ओर मैं तिना खे तेड़ा ई ज्वाब दित्तेया। <verse eid="NEH 6:4" /><verse number="5" style="v" sid="NEH 6:5" />तेबे पाँजी बार सेई समाचार सम्बल्लते आपणा सेवक खोली री चिट्ठी देई की मांगे पेजेया। <verse eid="NEH 6:5" /><verse number="6" style="v" sid="NEH 6:6" />जिदे लिखी राखेया था, “जातिया-जातिया रे लोका बीचे ये बोलेया जाओआ ओर गेशेम बी येई गल्ल बोलोआ कि तेरी ओर यहूदिया री इच्छा बगावत करने री ये, ओर इजी बजा ते तूँ तेसा दवाला खे बनाणे लगी रा ओर तूँ इना गल्ला रे मुताबिक तिना रा राजा बणना चाएआ। <verse eid="NEH 6:6" /><verse number="7" style="v" sid="NEH 6:7" />ओर तैं यरूशलेम शईरो दे नबी ठराई राखे, ताकि सेयो तेरे बारे दे ये प्रचार करो कि यहूदिया दे एक राजा ए। एबे एड़ा ई सन्देश राजे खे देणा। इजी री खातर एबे आओ, आसे मिली की सलाह् करूँए।”<verse eid="NEH 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 6:8" />तेबे मैं तेसगे सन्देसा पेजेया, “जेड़ा तूँ बोलणे लगी रा, तेड़ा तो कुछ पनि ए, तूँ इना गल्ला खे आपणे मनो ते बनाणे लगी रा।” <verse eid="NEH 6:8" /><verse number="9" style="v" sid="NEH 6:9" />सेयो सब लोक ये सोची की आसा खे डराणा चाओ थे, ताकि म्‍हारे आथ टीले पड़ी जाओ, ओर काम बन्द ऊई जाओ। पर एबे ओ परमेशर तूँ माखे याओ दे। <verse eid="NEH 6:9" /><verse number="10" style="v" sid="NEH 6:10" />एक दिन आऊँ शमायाह रे कअरे गया, जो दलायाह रा पाऊ ओर महेतबेलो रा पोता था, से तो बन्द कअरो रे था; तिने बोलेया, “आओ, आसे परमेशरो रे मईल, मतलब मन्दरो ते पीतरे आपू बीचे मिलूँए ओर मन्दरो रे द्वार बन्द करूँए; कऊँकि सेयो लोक ताखे काणे आऊणे, सेयो ताखे राथियो खे ई काणे आऊणे।” <verse eid="NEH 6:10" /><verse number="11" style="v" sid="NEH 6:11" />पर मैं बोलेया, “क्या मां जेड़ा माणूं नठो? ओर मां जेड़ा कुण ए जो आपणे प्राण बचाणे खे मन्दरो दे कूसो? आऊँ नि जाई सकदा।” <verse eid="NEH 6:11" /><verse number="12" style="v" sid="NEH 6:12" />तेबे माखे पता लगी गा कि से परमेशरो रा पेजेया दा नि ए, पर तिने हर गल्ल परमेशरो रा वचन बोली की मेरे नुकशाणो खे बोली, कऊँकि तोबियाह ओर सम्बल्लते तेसखे पैसा देई राखेया था। <verse eid="NEH 6:12" /><verse number="13" style="v" sid="NEH 6:13" />तिने तेसखे इजी बजा ते पैसा देई राखेया था कि आऊँ डरी जाऊँ, ओर तेड़ा ई काम करी की पापी बणूँ, ओर तिना खे दोष लगाणे रा मोका मिलो ओर सेयो मेरी बेज्जती करी सको।<verse eid="NEH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 6:14" />तेबे मैं प्रार्थना कित्ती ओ मेरे परमेशर! तोबियाह, सम्बल्लत, ओर नोअद्याह नबिया ओर जितणे नबी माखे डराणा चाओ थे, तिना सबी रे एड़े-एड़े कामा रिया बजा ते तिना खे सजा दे।<verse eid="NEH 6:14" /></para>
  <para style="s">कामो रा खत्म ऊणा</para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 6:15" />एलूल मीन्ने रे पच्चिये दिने, मतलब बूँजा दिना ते पीतरे दवाल बणीगी। <verse eid="NEH 6:15" /><verse number="16" style="v" sid="NEH 6:16" />जेबे म्हारे सबी दुश्मणे ये सुणेया, तेबे म्हारे चऊँ कनारे रणे वाल़े सब दूजी जातिया रे लोक डरी गे ओर बऊत शर्मिंदा ऊए; कऊँकि तिना खे पता लगी गा कि ये काम म्हारे परमेशरो रिया तरफा ते ऊआ। <verse eid="NEH 6:16" /><verse number="17" style="v" sid="NEH 6:17" />तिना दिना रे बी यहूदी अमीर ओर तोबियाह बीचे पर्चिया बऊत आया-जाया करो थिया। <verse eid="NEH 6:17" /><verse number="18" style="v" sid="NEH 6:18" />कऊँकि से आराह रे पाऊ शकन्याह रा जवांई था, ओर तेसरे पाऊ यहोहानाने बेरेक्याह रे पाऊ मशुल्लामो री बेटिया साथे ब्या करी ला था; इजी बजा ते बऊत सारे यहूदिये तेसरा पक्ष करने री कसम खाई राखी थी। <verse eid="NEH 6:18" /><verse number="19" style="v" sid="NEH 6:19" />सेयो मां सामणे तेसरे खरे कामो री चर्चा करेया करो थे ओर मेरी गल्ला बी तेसगे सुणाया करो थे ओर तोबियाह माखे डराणे खे पर्चिया पेजेया करो था।<verse eid="NEH 6:19" /></para>
  <chapter eid="NEH 6" />
  <chapter number="7" style="c" sid="NEH 7" />
  <para style="s">यरूशलेम शईरो रा बणाया जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 7:1" />जेबे दवाल बणीगी ओर मैं तेतेरे फल़े खड़े करीते, ओर द्वारपाल, ओर गाणे वाल़े ओर लेवी लोक ठराए, <verse eid="NEH 7:1" /><verse number="2" style="v" sid="NEH 7:2" />तेबे मैं आपणा पाई हनानी ओर राजगढ़ो रे परदान हनन्याह यरूशलेम शईरो रे अधिकारी बणाये, कऊँकि ये सच्चा माणूं ओर बऊत जादा परमेशरो रा डर मानणे वाल़ा था। <verse eid="NEH 7:2" /><verse number="3" style="v" sid="NEH 7:3" />ओर मैं तिना खे बोलेया, “जदुओ तक तूप तेज नि ऊई जाओ, तदुओ तक यरूशलेम शईरो रे बड़े द्वार नि खोलणे ओर जेबे सांजा रे बखते पईरेदार पईरा देंदे रओ, तेबेई बड़े द्वार बन्द करने ओर बेड़े लगाणे। तेबे यरूशलेम शईरो रे रणे वाल़ेया बीचे तूँ रखवाल़े राख जो आपणा-आपणा पईरा आपणे-आपणे कअरो सामणे देया करो।” <verse eid="NEH 7:3" /><verse number="4" style="v" sid="NEH 7:4" />यरूशलेम शईर तो लाम्बा-चौड़ा था, पर तिदे लोक थोड़े थे ओर कअर नि बणी रे थे।<verse eid="NEH 7:4" /></para>
  <para style="s">वापस आऊणे वाल़ेया री वंशावली</para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 7:5" />तेबे मेरे परमेशरे मेरे मनो रे ये गल्ल पाई कि यहूदा रे मुखिये, परदान ओर प्रजा रे लोका खे इजी रिया तँईं कट्ठे करुँ, ताकि सेयो आपणी-आपणी वंशावलिया रे मुताबिक गिणे जाओ। ओर तेबे माखे बऊत पईलके यरूशलेम शईरो दे आए रे लोका री वंशावलिया री चिट्ठी मिली ओर तिदे माखे ये लिखेया रा मिलेया। <verse eid="NEH 7:5" /><verse number="6" style="v" sid="NEH 7:6" />जिना खे बाबेलो रा राजा, नबूकदनेस्सर बन्दी बणाई की लईगा था, तिना बीचा ते जो राज्य रे लोक गुलामिया ते छूटी की, यरूशलेम ओर यहूदा दे आपणे-आपणे शईरो खे आए। <verse eid="NEH 7:6" /><verse number="7" style="v" sid="NEH 7:7" />सेयो परदान थे जरूब्बाबेल, येशुअ, नहेम्याह, अजर्याह, राम्‍याह, नहमानी, मोर्दकै, बिलशान, मिस्‍पेरेत, बिगवै, नहूम ओर बानाह साथे आए। इस्राएली प्रजा रे लोका री गिणती ये ए:<verse eid="NEH 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 7:8" />परोशो री ल्वाद 2,172, <verse eid="NEH 7:8" /><verse number="9" style="v" sid="NEH 7:9" />शपत्याह री ल्वाद 372, <verse eid="NEH 7:9" /><verse number="10" style="v" sid="NEH 7:10" />आरह री ल्वाद 652, <verse eid="NEH 7:10" /><verse number="11" style="v" sid="NEH 7:11" />पहत्मोआबो री ल्वाद येशुअ ओर योआबो री ल्वाद, 2,818, <verse eid="NEH 7:11" /><verse number="12" style="v" sid="NEH 7:12" />एलामो री ल्वाद 1,254, <verse eid="NEH 7:12" /><verse number="13" style="v" sid="NEH 7:13" />जत्तूए री ल्वाद 845, <verse eid="NEH 7:13" /><verse number="14" style="v" sid="NEH 7:14" />जक्कईये री ल्वाद 760, <verse eid="NEH 7:14" /><verse number="15" style="v" sid="NEH 7:15" />बिन्नूई री ल्वाद 648, <verse eid="NEH 7:15" /><verse number="16" style="v" sid="NEH 7:16" />बेबैए री ल्वाद 628, <verse eid="NEH 7:16" /><verse number="17" style="v" sid="NEH 7:17" />अजगादो री ल्वाद 2,322, <verse eid="NEH 7:17" /><verse number="18" style="v" sid="NEH 7:18" />अदोनीकामो री ल्वाद 666, <verse eid="NEH 7:18" /><verse number="19" style="v" sid="NEH 7:19" />बिगवैए री ल्वाद 2,067, <verse eid="NEH 7:19" /><verse number="20" style="v" sid="NEH 7:20" />आदीनो री ल्वाद 655, <verse eid="NEH 7:20" /><verse number="21" style="v" sid="NEH 7:21" />हिजकिय्याह री ल्वाद आतेरो रे कुलो बीचा ते 98, <verse eid="NEH 7:21" /><verse number="22" style="v" sid="NEH 7:22" />हाशूमो री ल्वाद 328, <verse eid="NEH 7:22" /><verse number="23" style="v" sid="NEH 7:23" />बेसै री ल्वाद 324, <verse eid="NEH 7:23" /><verse number="24" style="v" sid="NEH 7:24" />हारीफो री ल्वाद 112, <verse eid="NEH 7:24" /><verse number="25" style="v" sid="NEH 7:25" />गिबोनो रे लोक 95,<verse eid="NEH 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NEH 7:26" />जिना लोका रे बुजुर्ग इना शईरा दे रओ थे सेयो बी वापस आए यो ए; बेतलेहम ओर नतोपा रे माणूं 188, <verse eid="NEH 7:26" /><verse number="27" style="v" sid="NEH 7:27" />अनातोतो रे माणूं 128, <verse eid="NEH 7:27" /><verse number="28" style="v" sid="NEH 7:28" />बेतजमावतो रे माणूं 42, <verse eid="NEH 7:28" /><verse number="29" style="v" sid="NEH 7:29" />किर्यत्यारीम, कपीरा, ओर बेरोतो रे माणूं 743, <verse eid="NEH 7:29" /><verse number="30" style="v" sid="NEH 7:30" />रामाह ओर गेबा रे माणूं 621, <verse eid="NEH 7:30" /><verse number="31" style="v" sid="NEH 7:31" />मिकमाशो रे माणूं 122, <verse eid="NEH 7:31" /><verse number="32" style="v" sid="NEH 7:32" />आई ओर बेतेलो रे माणूं 123, <verse eid="NEH 7:32" /><verse number="33" style="v" sid="NEH 7:33" />दूजे नबो रे माणूं 52, <verse eid="NEH 7:33" /><verse number="34" style="v" sid="NEH 7:34" />दूजे एलामो रे लोक 1,254, <verse eid="NEH 7:34" /><verse number="35" style="v" sid="NEH 7:35" />हारीमो रे लोक 320, <verse eid="NEH 7:35" /><verse number="36" style="v" sid="NEH 7:36" />यरीहो रे लोक 345, <verse eid="NEH 7:36" /><verse number="37" style="v" sid="NEH 7:37" />लोद हादीद ओर ओनो रे लोक 721, <verse eid="NEH 7:37" /><verse number="38" style="v" sid="NEH 7:38" />सना रे लोक 3,930,<verse eid="NEH 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NEH 7:39" />तेबे पुरोईत, मतलब येशुअ रे कराने बीचा ते यदायाह री ल्वाद 973, <verse eid="NEH 7:39" /><verse number="40" style="v" sid="NEH 7:40" />इम्मेरो री ल्वाद 1,052, <verse eid="NEH 7:40" /><verse number="41" style="v" sid="NEH 7:41" />पशहूरो री ल्वाद 1,247, <verse eid="NEH 7:41" /><verse number="42" style="v" sid="NEH 7:42" />हारीमो री ल्वाद 1,017,<verse eid="NEH 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="NEH 7:43" />तेबे लेविये यो थे जो वापस आए थे: होदवा रे कुलो बीचा ते कदमिएलो री ल्वाद येशुअ री ल्वाद 74,<verse eid="NEH 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NEH 7:44" />तेबे गाणे वाल़े यो थे: आसापो री ल्वाद 148,<verse eid="NEH 7:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="NEH 7:45" />तेबे द्वारपाल यो थे: शल्लूमो री ल्वाद आतेरो री ल्वाद तल्मोनो री ल्वाद, अक्कूबो री ल्वाद, हतीता री ल्वाद ओर शोबै री ल्वाद, जो सारे मिलाई की 138 ऊए।<verse eid="NEH 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NEH 7:46" />तेबे परमेशरो रे मन्दरो दे सेवा करने वाल़े, मतलब सीहा री ल्वाद हसूपा री ल्वाद, तब्बाओतो री ल्वाद, <verse eid="NEH 7:46" /><verse number="47" style="v" sid="NEH 7:47" />केरोस री ल्वाद, सीआ री ल्वाद, पादोनो री ल्वाद, <verse eid="NEH 7:47" /><verse number="48" style="v" sid="NEH 7:48" />लबाना री ल्वाद, हगाबा री ल्वाद, शल्मै री ल्वाद, <verse eid="NEH 7:48" /><verse number="49" style="v" sid="NEH 7:49" />हानानो री ल्वाद, गिद्देलो री ल्वाद, गहरो री ल्वाद, <verse eid="NEH 7:49" /><verse number="50" style="v" sid="NEH 7:50" />रायाह री ल्वाद, रसीनो री ल्वाद, नकोदा री ल्वाद, <verse eid="NEH 7:50" /><verse number="51" style="v" sid="NEH 7:51" />गज्जामो री ल्वाद, उज्जा री ल्वाद, पासेह री ल्वाद, <verse eid="NEH 7:51" /><verse number="52" style="v" sid="NEH 7:52" />बेसै री ल्वाद, मूनीमो री ल्वाद, नपूशसो री ल्वाद, <verse eid="NEH 7:52" /><verse number="53" style="v" sid="NEH 7:53" />बकबूको री ल्वाद, हकूपा री ल्वाद, हर्हूरो री ल्वाद, <verse eid="NEH 7:53" /><verse number="54" style="v" sid="NEH 7:54" />बसलीतो री ल्वाद, महीदा री ल्वाद, हर्शा री ल्वाद, <verse eid="NEH 7:54" /><verse number="55" style="v" sid="NEH 7:55" />बर्कोसो री ल्वाद, सीसरा री ल्वाद, तेमह री ल्वाद, <verse eid="NEH 7:55" /><verse number="56" style="v" sid="NEH 7:56" />नसीह री ल्वाद, ओर हतीपा री ल्वाद। <verse eid="NEH 7:56" /><verse number="57" style="v" sid="NEH 7:57" />तेबे सुलैमानो रे नौकरा री ल्वाद मतलब सोतै री ल्वाद, सोपेरेतो री ल्वाद, परीदा री ल्वाद, <verse eid="NEH 7:57" /><verse number="58" style="v" sid="NEH 7:58" />याला री ल्वाद, दर्कोनो री ल्वाद, गिद्देलो री ल्वाद, <verse eid="NEH 7:58" /><verse number="59" style="v" sid="NEH 7:59" />शपत्याह री ल्वाद, हत्तीलो री ल्वाद, पोकरेत-सबायीमो री ल्वाद, ओर आमोनो री ल्वाद।<verse eid="NEH 7:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="NEH 7:60" />मन्दरो दे सेवा करने वाल़े ओर सुलैमानो रे नौकरा री ल्वाद मिलाई की 392 थे। <verse eid="NEH 7:60" /><verse number="61" style="v" sid="NEH 7:61" />ओर यो सेयो ए, जो तेल्मेलाह, तेलहर्शा, करूब, अद्दोन ओर इम्मेरो ते यरूशलेम शईरो खे गये, पर आपणे-आपणे पितरा रे कराने ओर वंशावली नि बताई सके कि इस्राएलो रे ए, कि नई, <verse eid="NEH 7:61" /><verse number="62" style="v" sid="NEH 7:62" />दलायाह री ल्वाद, तोबिय्याह री ल्वाद, ओर नकोदा री ल्वाद, जो सब मिलाई की 642 थे।<verse eid="NEH 7:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="NEH 7:63" />यो लोक बी पुरोईता बीचा ते होबायाह री ल्वाद, हक्कोसो री ल्वाद, ओर बर्जिल्लै री ल्वाद, जिने गिलाद लाके रे बर्जिल्लै री बेटिया बीचा ते एकी साथे ब्या करी ला, ओर तिना रा ई नाओं राखी ता था। <verse eid="NEH 7:63" /><verse number="64" style="v" sid="NEH 7:64" />इने आपणी-आपणी वंशावलिया री चिट्ठी ओरी वंशावलिया री चिट्टिया बीचे टोल़ी, पर तिना खे से नि मिली, इजी री खातर सेयो अशुद्ध ठराई की पुरोईतो रे पदो ते निकयाल़ी ते। <verse eid="NEH 7:64" /><verse number="65" style="v" sid="NEH 7:65" />ओर परदाने तिना खे बोलेया, कि जदुओ तक ऊरीम ओर तुम्मीम धारण करने वाल़ा कोई पुरोईत नि उठो, तदुओ तक तुसे कोई परम पवित्र चीज नि खाणी। <verse eid="NEH 7:65" /><verse number="66" style="v" sid="NEH 7:66" />पूरी मण्डल़िया रे लोक मिलाई की 42,360 थे। <verse eid="NEH 7:66" /><verse number="67" style="v" sid="NEH 7:67" />इना खे छाडी की तिना रे 7,337 दास-दासिया ओर 245 गाणे वाल़े ओर गाणे वाल़िया थिया। <verse eid="NEH 7:67" /><verse number="68" style="v" sid="NEH 7:68" />तिना रे 736 कोड़े, 245 खच्चरा, <verse eid="NEH 7:68" /><verse number="69" style="v" sid="NEH 7:69" />435 ऊँट ओर 6,720 गह्दे थे।<verse eid="NEH 7:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="NEH 7:70" />ओर इस्राएली पितरा रे कराने रे कई मुखिये कामो खे दान दित्तेया। परदाने तो चन्दे दे 8 किलो 600 ग्राम सूईने रे सिक्के, 50 कटोरे ओर पुरोईता खे 530 चोगे मन्दरो रे पण्डारो दे दित्ते। <verse eid="NEH 7:70" /><verse number="71" style="v" sid="NEH 7:71" />ओर इस्राएली पितरा रे कराने रे कई बड़े-बड़े माणूंए तेस कामो रे चन्‍दे दे 153 किलो सूईने रे सिक्के ओर 1,460 किलो चाँदिए रे सिक्के मन्दरो रे पण्डारो दे दित्तेया। <verse eid="NEH 7:71" /><verse number="72" style="v" sid="NEH 7:72" />जो पेंट बाकी इस्राएली प्रजे दित्ती, से ये थी: 153 किलो सूईने रे सिक्के, 1,330 किलो चाँदिए रे सिक्के ओर सताठ पुरोईता रे चोगे। <verse eid="NEH 7:72" /><verse number="73" style="v" sid="NEH 7:73" />ईंयाँ पुरोईत, लेविये, द्वारपाल, गाणे वाल़े, प्रजा रे कुछ लोक ओर मन्दरो दे सेवा करने वाल़े ओर सब इस्राएली आपणे-आपणे शईरो दे बसी गे।<verse eid="NEH 7:73" /></para>
  <chapter eid="NEH 7" />
  <chapter number="8" style="c" sid="NEH 8" />
  <para style="s">यहूदिया खे बिधानो रा सुणाया जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 8:1" />जेबे सातुआ मीन्ना नेड़े आया, तेस बखते सारे इस्राएली आपणे-आपणे शईरो दे थे। तेबे तिने सबी एक मन ऊई की, पाणिए रे द्वारो सामणे कट्ठे ऊई की, एज्रा शास्त्रिए खे बोलेया, कि मूसे रा जो बिधान परमेशरे इस्राएलो खे दित्तेया था, तेतेरी कताब ली आओ। <verse eid="NEH 8:1" /><verse number="2" style="v" sid="NEH 8:2" />तेबे एज्रा पुरोईत सातुए मीन्ने रे पईले दिने क्या जवाणस, क्या मर्द, जितणे बिधानो खे सुणी की समजी सको थे, तिना सबी सामणे बिधानो री कताब ली आया। <verse eid="NEH 8:2" /><verse number="3" style="v" sid="NEH 8:3" />से तेसरिया गल्ला प्यागा ते लई की त्याड़िया तक तेस चौको सामणे जो पाणिए रे बड़े द्वारो सामणे था, क्या जवाणस, क्या मर्द ओर सबी समजणे वाल़ेया खे पढ़ी की सुणांदा रया ओर लोके बिधानो री कताबा पाँदे कान लगाई राखेया। <verse eid="NEH 8:3" /><verse number="4" style="v" sid="NEH 8:4" />एज्रा शास्त्री, लकड़िया री तेसा ऊच्चिया जगा पाँदे जो एस कामो खे ई बणाई राखी थी, खड़ा ऊईगा; ओर तेसरे दाँणे कनारे मत्तित्याह, शेमा, अनायाह, ऊरिय्याह, हिल्किय्याह ओर मासेयाह; ओर खूँजे कनारे, पदायाह, मीशाएल, मल्किय्याह, हाशूम, हश्बद्दाना, जकर्याह ओर मशुल्लाम खड़े उए। <verse eid="NEH 8:4" /><verse number="5" style="v" sid="NEH 8:5" />तेबे एज्रे जो सबी ते ऊच्ची जगा पाँदे खड़ी रा था, सबी सामणे से कताब खोली ओर जेबे तिने से खोली, तेबे सारे लोक उठी की खड़े ऊए।<verse eid="NEH 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 8:6" />तेबे एज्रे महान परमेशर यहोवे खे तन्य बोलेया ओर सबी लोके आपणे-आपणे आथ चकी की आमीन्, आमीन्, बोलेया; ओर सिर चुकाई की आपणा-आपणा माथा जमीना दे राखी की यहोवे गे माथा टेकेया। <verse eid="NEH 8:6" /><verse number="7" style="v" sid="NEH 8:7" />येशुअ, बानी, शेरेब्याह, यामीन, अक्कूब, शब्बतै, होदिय्याह, मासेयाह, कलीता, अजर्याह, योजाबाद, हानान ओर पलायाह नाओं रे लेविये, लोका खे बिधान समजयांदे गये, ओर लोक आपणी-आपणी जगा पाँदे खड़े रये। <verse eid="NEH 8:7" /><verse number="8" style="v" sid="NEH 8:8" />तिने परमेशरो री बिधान री कताब ते पढ़ी की मतलब समजयाई ता ओर लोके पाठ समजी ला। <verse eid="NEH 8:8" /><verse number="9" style="v" sid="NEH 8:9" />तेबे नहेम्याह जो परदान था, ओर एज्रा जो पुरोईत ओर शास्त्री था, ओर जो लेवी लोका खे समजयाणे लगी रे थे, तिने सबी लोका खे बोलेया, “आजका दिन तुसा रे परमेशर यहोवे खे पवित्र ए; इजी री खातर दु:खी नि ओ ओर ना रोओ।” कऊँकि सब लोक बिधानो रे वचन सुणी की रोंदे रये। <verse eid="NEH 8:9" /><verse number="10" style="v" sid="NEH 8:10" />तेबे तिने तिना खे बोलेया, “जाई की तल़ी री रोटी खाओ, ओर मीठा-मीठा रस पियो ओर जिना खे कुछ बणी नि रया तिना गे रोटिया रा समान पेजो; कऊँकि आजका दिन म्हारे परमेशर यहोवे खे पवित्र ए; ओर उदास नि रओ, कऊँकि यहोवे री खुशी तुसा री मजबूत तागत ए।” <verse eid="NEH 8:10" /><verse number="11" style="v" sid="NEH 8:11" />ईंयाँ लेविये सबी लोका खे ये बोली की चुप कराईते, “चुप रओ कऊँकि आजका दिन पवित्र ए; ओर उदास नि रओ।” <verse eid="NEH 8:11" /><verse number="12" style="v" sid="NEH 8:12" />तेबे सब इस्राएली लोक खाणे-पीणे रोटी बांडणे ओर बड़ी खुशी मनाणे खे चली गे, कऊँकि जो वचन तिना खे समजयाए थे, सेयो तिना खे समज आईगे थे।<verse eid="NEH 8:12" /></para>
  <para style="s">चूँगड़िया रा त्यार</para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 8:13" />सातुए मीन्ने रे दूजे दिने बी सारी प्रजा रे पितरा रे कराने रे खास-खास मर्द, ओर पुरोईत ओर लेवी लोक, एज्रा शास्त्रिए गे बिधानो रे वचन त्यानो साथे सुणने खे कट्ठे ऊईगे। <verse eid="NEH 8:13" /><verse number="14" style="v" sid="NEH 8:14" />तिना खे बिधानो दे ये लिखेया दा मिलेया, कि यहोवे मूसे खे ये आज्ञा दलाई थी, कि इस्राएली सातुए मीन्ने दे त्योआरो रे बखते चूँगड़िया दे रया करो, <verse eid="NEH 8:14" /><verse number="15" style="v" sid="NEH 8:15" />ओर आपणे सबी शईरा दे ओर यरूशलेम शईरो दे ये सुणाया करो ओर प्रचार करेया करो, “पाह्ड़ो पाँदे जाई की जैतून, तेलो रे डाल़, मईंदी, खजूर ओर कणे-कणे डाल़ा रिया डाल़िया ल्याई की चूँगड़िया बणाओ, जेड़ा कि लिखी राखेया।” <verse eid="NEH 8:15" /><verse number="16" style="v" sid="NEH 8:16" />तेबे सब लोक शईरो ते बारे जाई की डाल़िया ली आए, ओर आपणे-आपणे कअरो रे छतो पाँदे ओर आपणे आँगणो दे, ओर परमेशरो रे मन्दरो रे आँगणो दे, ओर पाणिए रे बड़े द्वारो रे चौको दे ओर एप्रैमो रे बड़े द्वारो रे चौको दे, चूँगड़िया बणाई तिया। <verse eid="NEH 8:16" /><verse number="17" style="v" sid="NEH 8:17" />बल्कि सारी मण्डल़िया रे लोक जितणे गुलामिया ते छूटी की आए थे, चूँगड़िया बणाई की तिना दे रये। नूनो रे पाऊ यहोशूए रे दिना ते लई की तेस दिनो तक इस्राएली लोके एड़ा नि कित्तेया था। ओर तेस बखते बऊत बड़ी खुशी ऊई। <verse eid="NEH 8:17" /><verse number="18" style="v" sid="NEH 8:18" />तेबे पईले दिनो ते अन्तो रे दिनो तक एज्रा हर दिन परमेशरो री बिधान री कताबा बीचा ते पढ़ी-पढ़ी की सुणाया करो था। सेयो साता दिना तक त्योआर मनांदे रये, ओर आठुए दिने बिधानो रे मुताबिक बड़ी सभा ऊई।<verse eid="NEH 8:18" /></para>
  <chapter eid="NEH 8" />
  <chapter number="9" style="c" sid="NEH 9" />
  <para style="s">पापो रा मानणा</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 9:1" />तेबे सातुए मीन्ने रे चौबिये दिने इस्राएली बअरतो री टाट पईनी की ओर सिरो पाँदे तूड़ लटी की कट्ठे ऊए। <verse eid="NEH 9:1" /><verse number="2" style="v" sid="NEH 9:2" />तेबे इस्राएलो रे कुलो रे सब लोक दूजी जातिया रे लोका ते लग ऊईगे ओर खड़े ऊई की, आपणे-आपणे पाप ओर आपणे बुजुर्गा रे पापो रे काम मानी ले। <verse eid="NEH 9:2" /><verse number="3" style="v" sid="NEH 9:3" />तेबे तिने आपणी-आपणी जगा पाँदे खड़े ऊई की दिनो रे एकी पईरो तक आपणे यहोवा परमेशरो रे बिधानो री कताब पढ़दे रये ओर दूजे पईरो दे आपणे पाप मानदे ओर आपणे परमेशर यहोवे गे माथा टेकदे रये। <verse eid="NEH 9:3" /><verse number="4" style="v" sid="NEH 9:4" />ओर येशुअ, बानी, कदमिएल, शबन्याह, बुन्नी, शेरेब्याह, बानी ओर कनानिये लेविया री पईड़िया पाँदे खड़े ऊई की जोरे की आपणे परमेशर यहोवे री दुहाई दित्ती। <verse eid="NEH 9:4" /><verse number="5" style="v" sid="NEH 9:5" />तेबे येशुअ, कदमिएल, बानी, हशब्नयाह, शेरेब्याह, होदिय्याह, शबन्याह ओर पतह्याह नाओं रे लेविया रे परदाने बोलेया, खड़े ऊई जाओ, आपणे परमेशर यहोवे खे शुरूओ ते लई की अन्तो तक तन्य बोलो। तेरे महिमा जोगे नाओं खे तन्य बोलेया जाओ, जो सारे तन्यवाद ओर स्तुतिया ते पोरे ए।<verse eid="NEH 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 9:6" />फेर इस्राएली लोके बोलेया, तूँ ई कल्ला यहोवा ए; सर्ग बल्कि सबी ते ऊच्चे स्वर्ग ओर सब गण, ओर तरती ओर जो कुछ तिदे ए ओर समुद्र ओर जो कुछ तिदे ए, सब तैं ई बणाया, ओर सबी री रक्षा तूँ ई करेया; ओर स्वर्गो रे सारे स्वर्गदूत तांगे ई माथा टेकोए।<note caller="+" style="f"><char style="fr" closed="false">9:6 </char><char style="ft" closed="false">बिध. 6:4, निर्ग. 20:11</char></note> <verse eid="NEH 9:6" /><verse number="7" style="v" sid="NEH 9:7" />ओ यहोवा! तूँ सेई परमेशर ए, जो अब्रामो खे चूणी की कसदिया रे ऊर शईरो ते निकयाल़ी की ल्याया, ओर तेसरा नाओं अब्राहम राखेया; <verse eid="NEH 9:7" /><verse number="8" style="v" sid="NEH 9:8" />ओर तेसरे मनो खे आपू साथे सच्चा पाई की, तेस साथे वाचा बानी, कि मां तेरे कुलो खे कनानिया, हित्तिया, एमोरिया, परिज्जिया, यबूसिया, ओर गिर्गाशिया रा देश देणा; ओर तैं आपणा से वचन पूरा बी कित्तेया, कऊँकि तूँ तर्मी ए। <verse eid="NEH 9:8" /><verse number="9" style="v" sid="NEH 9:9" />तेबे तैं मिस्रो दे म्हारे बुजुर्गा रे दु:ख देखे; ओर लाल समुद्रो रे कनारे तिना री मतादा रिया तँईं प्रार्थना सुणी। <verse eid="NEH 9:9" /><verse number="10" style="v" sid="NEH 9:10" />ओर फिरौन ओर तेसरे सब कर्मचारी बल्कि तेसरे देशो रे सबी लोका खे दण्ड देणे खे नशाण ओर चमत्कार दखाए; कऊँकि तूँ जाणे था कि सेयो तिना ते सख्त बर्ताओ करोए; ओर तैं आपणा एड़ा बड़ा नाओं कित्तेया, जेड़ा आजके बखतो तक ए। <verse eid="NEH 9:10" /><verse number="11" style="v" sid="NEH 9:11" />ओर तैं तिना ते आगे समुद्रो रे एड़े दो इस्से कित्ते, कि सेयो समुद्रो बीचे सुकी जमीना दे पैदल चली की पार ऊए; ओर जो तिना पीछे पड़ी रे थे, सेयो तैं डूगी जगा रे एड़े सेटी ते, जेड़ा पात्थरो खे समुद्रो दे सेटोए। <verse eid="NEH 9:11" /><verse number="12" style="v" sid="NEH 9:12" />तेबे तैं दिने बादल़ो रे खम्बे दे ऊई की ओर राती आगी रे खम्बे दे ऊई की तिना री अगुआई कित्ती, ताकि जेते बाटा रिये तिना खे चलणा था, तिदे तिना खे प्रयासा मिलो। <verse eid="NEH 9:12" /><verse number="13" style="v" sid="NEH 9:13" />तेबे तैं सीनै रे पाह्ड़ो पाँदे उतरी की सर्गो ते तिना साथे गल्ला कित्तिया, ओर तिना खे सीदे बिधि, सच्चा बिधान, ओर अच्छी बिधिया ओर आज्ञा दित्ती। <verse eid="NEH 9:13" /><verse number="14" style="v" sid="NEH 9:14" />तिना खे तिना रे रामो रे दिनो रे बारे दे सिखाया, ओर आपणे दास मूसे रे जरीये आज्ञा, बिधिया ओर बिधान दित्तेया। <verse eid="NEH 9:14" /><verse number="15" style="v" sid="NEH 9:15" />ओर तिना री पूख मटयाणे खे सर्गो ते तिना खे रोटी दित्ती ओर तिना री त्याय खत्म करने खे पात्थरा ते तिना खे पाणी काडेया, ओर तिना खे आज्ञा दित्ती कि जेस देशो खे तुसा खे देणे री मैं कसम खाई राखी, तेतेरे अधिकारी ऊणे खे तुसे तिदे जाओ।<note caller="+" style="f"><char style="fr" closed="false">9:15 </char><char style="ft" closed="false">यूह. 6:31</char></note> <verse eid="NEH 9:15" /><verse number="16" style="v" sid="NEH 9:16" />पर तिने ओर म्हारे बुजुर्गे कमण्ड कित्तेया ओर टीठ बणी गे ओर तेरी आज्ञा नि मानी; <verse eid="NEH 9:16" /><verse number="17" style="v" sid="NEH 9:17" />ओर तिने आज्ञा मानणे ते ना कित्ती, ओर जो अचम्बे रे काम तैं तिना बीचे कित्ते थे, सेयो याद नि कित्ते, बल्कि टीठ बणी की एथो तक बगावत करने वाल़े बणे, कि तिने एक परदान ठराया, ताकि आपणी गुलामिया री दशा दे वापस ओ। पर तूँ माफ करने वाल़ा अनुग्रह करने वाल़ा, दयालु, देरिया ते रोष करने वाल़ा, ओर बऊत करूणामयी परमेशर ए, तैं सेयो नि त्यागे। <verse eid="NEH 9:17" /><verse number="18" style="v" sid="NEH 9:18" />बल्कि जेबे तिने बाच्छूए री मूर्ति बणाई की बोलेया, तुसा रा परमेशर जो तुसा खे मिस्र देशो ते छुड़ाई की ल्याई राखेया, से येई ए, ओर तेरी बऊत बेज्जती कित्ती, <verse eid="NEH 9:18" /><verse number="19" style="v" sid="NEH 9:19" />तेबे बी तूँ जो बऊत दयालु ए, सेयो जंगल़ो दे नि छाडे; ना तो दिने अगुआई करने वाल़ा बादल़ो रा खम्बा, ना राती प्रयासा देणे वाल़ा ओर तिना खे बाट दखाणे वाल़ा आगी रा खम्बा तिना पाँदा ते टाया। <verse eid="NEH 9:19" /><verse number="20" style="v" sid="NEH 9:20" />बल्कि तैं तिना खे समजयाणे खे आपणी आत्मा जो खरी ए दित्ती, ओर आपणा मन्ना तिना खे खुलाणा नि छाडेया, ओर तिना री त्याय मिटाणे खे तिना खे पाणी देंदा रया। <verse eid="NEH 9:20" /><verse number="21" style="v" sid="NEH 9:21" />चाल़िया साला तक तूँ जंगल़ो रे तिना खे एड़ा पाल़दा रया, कि तिना खे कोई कमी नि ऊई; ना तो तिना रे टाल्ले पुराणे ऊए ओर ना ई तिना रे पैरा दे सोजा आया। <verse eid="NEH 9:21" /><verse number="22" style="v" sid="NEH 9:22" />तेबे तैं राज्य-राज्य ओर देशो-देशो रे लोक तिना रे वशो दे करीते ओर चऊँ कनारे सेयो बांडी ते; ईंयाँ सेयो हेशबोन शईरो रे राजा सिहोन ओर बाशानो रे राजा ओग, तिना दूनी रे देशो रे परदान ऊईगे। <verse eid="NEH 9:22" /><verse number="23" style="v" sid="NEH 9:23" />तेबे तैं तिना री ल्वादा खे सर्गो रे तारेया जेड़ी बढ़ाई की सेयो तेते देशो दे पऊँचाई ते, जेतेरे बारे दे तैं तिना रे बुजुर्गा खे बोलेया था; कि सेयो तिदे जाई की तेथो रे अधिकारी ऊई जाणे। <verse eid="NEH 9:23" /><verse number="24" style="v" sid="NEH 9:24" />तो ये ल्वाद जाई की तेथो रे अधिकारी ऊईगे, ओर तैं तिना रे जरीये देशो रे रणे वाल़े कनानी दबाये, ओर राजेया ओर देशो रे लोका समेत सेयो, तिना रे आथो दे करीते, ताकि सेयो तिना साथे जो चाओ से करो। <verse eid="NEH 9:24" /><verse number="25" style="v" sid="NEH 9:25" />तेबे तिने गढ़वाल़े शईर ओर उपजाऊ जमीन लई ली, ओर सब प्रकारा री अच्छी चीजा साथे परे रे कअरा रे, ओर खणे रे अऊदा रे, ओर दाख ओर जैतूना रे बगिचेया रे, ओर खाणे वाल़े फला रे बऊती डाल़ा रे अधिकारी ऊईगे; सेयो तिना खे खाई-खाई की रज्जी गे; ओर अट्टे-कट्टे ऊईगे, ओर तेरी बड़ी पलाईया रिया बजा ते सुखी ऊई की रणे लगे। <verse eid="NEH 9:25" /><verse number="26" style="v" sid="NEH 9:26" />पर सेयो तांते फिरी की बगावत करने वाल़े बणी गे ओर तेरा बिधान त्यागी ता, ओर तेरे जो नबी तेरी तरफा खे फिरने खे तिना खे बतांदे रये तिने सेयो काईते, ओर तेरी बऊत बेज्जती कित्ती। <verse eid="NEH 9:26" /><verse number="27" style="v" sid="NEH 9:27" />इजी बजा ते तैं सेयो तिना रे दुश्मणा रे आथो रे करीते, ओर तिने सेयो मुसीबता रे पाई ते; तेबे बी जेबे-जेबे सेयो मुसीबता रे पड़ी की ताखे पुकारदे रये तेबे-तेबे तूँ स्वर्गो ते तिना री प्रार्थना सुणदा रया; ओर तूँ जो बड़ा दयालु ए, इजी री खातर तिना खे छुड़ाणे वाल़े पेजदा रया जो तिना खे दुश्मणा रे आथो रे छुड़ाओ थे। <verse eid="NEH 9:27" /><verse number="28" style="v" sid="NEH 9:28" />पर जेबे-जेबे तिना खे चैन मिलेया, तेबे-तेबे सेयो फेर तां सामणे बुराई करदे रये, इजी बजा ते तूँ तिना खे दुश्मणा रे आथो दे करी देओ था, ओर तेबे तिना रे दुश्मण तिना पाँदे राज करो थे; तेबे बी जेबे सेयो फिरी की तांते प्रार्थना करो थे, तेबे तूँ स्वर्गो ते तिना री प्रार्थना सुणे था ओर तूँ जो दयालु ए, इजी री खातर बार-बार तिना खे छुड़ाए था, <verse eid="NEH 9:28" /><verse number="29" style="v" sid="NEH 9:29" />ओर तूँ तिना खे चतौणी दे था, कि सेयो तेरे बिधि ओर बिधानो खे मानदे रओ। पर सेयो कमण्ड करदे रये ओर तेरी आज्ञा खे नि मानो थे, ओर तेरे नियम, जिना खे अगर माणूं मानो, तो तिना रिया बजा ते जिऊँदे रओ, पर म्हारे बुजुर्ग बिधानो रे खलाफ पाप करदे रये, ओर हठ करी की कमण्ड करो थे ओर सुणो नि थे। <verse eid="NEH 9:29" /><verse number="30" style="v" sid="NEH 9:30" />तूँ तो कई साला तक तिना री सयींदा रया, ओर आपणी आत्मा साथे नबिया रे जरीये तिना खे बतांदा रया, पर सेयो कान नि लगाओ थे, इजी बजा ते तैं सेयो देशो-देशो रे लोका रे आथो रे करीते। <verse eid="NEH 9:30" /><verse number="31" style="v" sid="NEH 9:31" />तेबे बी तैं जो बड़ा दयालु ए, तिना रा अन्त नि कित्तेया ओर ना सेयो त्यागे, कऊँकि तूँ अनुग्रह करने वाल़ा ओर दयालु परमेशर ए। <verse eid="NEH 9:31" /><verse number="32" style="v" sid="NEH 9:32" />एबे तो ओ म्हारे परमेशर! ओ महान ओर पराक्रमी डरो जोगे परमेशर! जो आपणा वादा मानदा ओर करूणा करदा रई रा, जो बड़ा कष्ट, अश्शूरो रे राजेया रे दिना ते लई की आजके दिनो तक आसा खे ओर म्हारे राजेया, परदान, पुरोईत, नबी, बुजुर्ग, बल्कि तेरी सारी प्रजा खे पोगणा पड़ेया, से तेरी नजरा दे थोड़ा नि ठईरो। <verse eid="NEH 9:32" /><verse number="33" style="v" sid="NEH 9:33" />तेबे बी जो कुछ आसा पाँदे बीती रा तिजी रे बारे दे तूँ तो तर्मी ए; तैं तो सच्चाईया साथे काम करी राखेया, पर आसे दुष्टता करी राखी। <verse eid="NEH 9:33" /><verse number="34" style="v" sid="NEH 9:34" />ओर म्हारे राजे, ओर परदानो, पुरोईत ओर बुजुर्गे, ना तो तेरा बिधान मानेया ओर ना तेरी आज्ञा ओर चतौणिया पाँदे त्यान दित्तेया, जिना साथे तैं तिना खे बताया था। <verse eid="NEH 9:34" /><verse number="35" style="v" sid="NEH 9:35" />तिने आपणे राज्य रे, ओर तैं बड़े कल्याणो रे बखते जो तिना खे तैं दित्तेया था, ओर एस लाम्बे-चौड़े ओर उपजाऊ देशो रे तेरी सेवा नि कित्ती; ओर ना आपणे बुरे कामो ते पश्चाताप कित्तेया। <verse eid="NEH 9:35" /><verse number="36" style="v" sid="NEH 9:36" />देख, आसे आजकाल दास ए; जो देश तैं म्हारे पितरा खे दित्तेया था कि तेतेरी खरी उपज खाओ, इदे ई आसे दास ए।<note caller="+" style="f"><char style="fr" closed="false">9:36 </char><char style="ft" closed="false">एज्र. 9:9, बिध. 28:48</char></note> <verse eid="NEH 9:36" /><verse number="37" style="v" sid="NEH 9:37" />एतेरी उपजा ते तिना राजेया खे जो तैं म्हारे पापो रिया बजा ते आसा पाँदे ठराई राखे, बऊत तअन मिलोआ; ओर सेयो म्हारे शरीर ओर डांगरा पाँदे आपणी-आपणी इच्छा रे मुताबिक राज करोए, इजी बजा ते आसे बड़ी मुसीबता रे पड़ी रे।<verse eid="NEH 9:37" /></para>
  <para style="s">वाचा रा बानणा</para>
  <para style="p">
    <verse number="38" style="v" sid="NEH 9:38" />इना सबी गल्ला रिया बजा ते, आसे सच्चाईया साथे वाचा बानूँए, ओर लिखी बी देऊँए, ओर म्हारे परदान, लेविये, ओर पुरोईत तेते पाँदे छाप लगाओए।<verse eid="NEH 9:38" /></para>
  <chapter eid="NEH 9" />
  <chapter number="10" style="c" sid="NEH 10" />
  <para style="s">बिधानो रे मुताबिक वादे रा कित्तेया जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 10:1" />जिने छाप लगाई सेयो यो ए हकल्याह रा पाऊ नहेम्याह जो राजपाल था, ओर सिदकिय्याह; <verse eid="NEH 10:1" /><verse number="2" style="v" sid="NEH 10:2" />सरायाह, अजर्याह, यिर्मयाह; <verse eid="NEH 10:2" /><verse number="3" style="v" sid="NEH 10:3" />पशहूर, अमर्याह, मल्किय्याह; <verse eid="NEH 10:3" /><verse number="4" style="v" sid="NEH 10:4" />हत्तूश, शबन्याह, मल्लूक; <verse eid="NEH 10:4" /><verse number="5" style="v" sid="NEH 10:5" />हारीम, मरेमोत, ओबद्याह; <verse eid="NEH 10:5" /><verse number="6" style="v" sid="NEH 10:6" />दानिय्येल, गिन्नतोन, बारूक; <verse eid="NEH 10:6" /><verse number="7" style="v" sid="NEH 10:7" />मशुल्लाम, अबिय्याह, मिय्यामीन; <verse eid="NEH 10:7" /><verse number="8" style="v" sid="NEH 10:8" />माज्याह, बिलगै ओर शमायाह; यो तो पुरोईत थे।<verse eid="NEH 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 10:9" />लेविये यो थे: आजन्याह रा पाऊ येशुअ, हेनादादो री ल्वादा बीचा ते बिन्नूई ओर कदमिएल; <verse eid="NEH 10:9" /><verse number="10" style="v" sid="NEH 10:10" />ओर तिना रे पाई शबन्याह, होदिय्याह, कलीता, पलायाह, हानान; <verse eid="NEH 10:10" /><verse number="11" style="v" sid="NEH 10:11" />मीका, रहोब, हशब्याह; <verse eid="NEH 10:11" /><verse number="12" style="v" sid="NEH 10:12" />जक्कूर, शेरेब्याह, शबन्याह। <verse eid="NEH 10:12" /><verse number="13" style="v" sid="NEH 10:13" />होदिय्याह, बानी ओर बनीनू;<verse eid="NEH 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 10:14" />तेबे प्रजा रे परदान यो थे: परोश, पहत्मोआब, एलाम, जत्तू, बानी; <verse eid="NEH 10:14" /><verse number="15" style="v" sid="NEH 10:15" />बुन्नी, अजगाद, बेबै; <verse eid="NEH 10:15" /><verse number="16" style="v" sid="NEH 10:16" />अदोनिय्याह, बिगवै, आदीन; <verse eid="NEH 10:16" /><verse number="17" style="v" sid="NEH 10:17" />आतेर, हिजकिय्याह, अज्जूर; <verse eid="NEH 10:17" /><verse number="18" style="v" sid="NEH 10:18" />होदिय्याह, हाशूम, बेसै; <verse eid="NEH 10:18" /><verse number="19" style="v" sid="NEH 10:19" />हारीफ, अनातोत, नोबै; <verse eid="NEH 10:19" /><verse number="20" style="v" sid="NEH 10:20" />मग्पीआश, मशुल्लाम, हेजीर; <verse eid="NEH 10:20" /><verse number="21" style="v" sid="NEH 10:21" />मशेजबेल, सादोक, यद्दू; <verse eid="NEH 10:21" /><verse number="22" style="v" sid="NEH 10:22" />पलत्याह, हानान, अनायाह; <verse eid="NEH 10:22" /><verse number="23" style="v" sid="NEH 10:23" />होशे, हनन्याह, हश्शूब; <verse eid="NEH 10:23" /><verse number="24" style="v" sid="NEH 10:24" />हल्लोहेश, पिल्हा, शोबेक; <verse eid="NEH 10:24" /><verse number="25" style="v" sid="NEH 10:25" />रहूम, हशब्ना, मासेयाह; <verse eid="NEH 10:25" /><verse number="26" style="v" sid="NEH 10:26" />अहिय्याह, हानान, आनान; <verse eid="NEH 10:26" /><verse number="27" style="v" sid="NEH 10:27" />मल्लूक, हारीम ओर बानाह।<verse eid="NEH 10:27" /></para>
  <para style="s">इस्राएली लोका रे जरीये कसम खाणी</para>
  <para style="p">
    <verse number="28" style="v" sid="NEH 10:28" />बाकी लोक मतलब पुरोईत, लेविये, द्वारपाल, गाणे वाल़े ओर मन्दरो दे सेवा करने वाल़ेया लोके, ओर जितणे परमेशरो रा बिधान मानणे खे देशो-देशो रे लोका ते लग ऊए थे, तिने सबी आपणियां जवाणसा ओर तिना माठे-बेटिया साथे जो समजणे वाल़े थे, <verse eid="NEH 10:28" /><verse number="29" style="v" sid="NEH 10:29" />ओर आपणे अमीर पाईया साथे मिली की कसम खाई, कि आसा परमेशरो रे तेस बिधानो पाँदे चलणा, जो तेसरे दास मूसे रे जरीये देई राखेया ओर आपणे परमेशर यहोवे री सब आज्ञा, नियम ओर बिधिया मानणे दे चौकसी करनी। <verse eid="NEH 10:29" /><verse number="30" style="v" sid="NEH 10:30" />आसा ना तो आपणी बेटिया एस देशो रे लोका साथे ब्याणिया ओर ना आपणे माठेया रा ब्या तिना री बेटिया साथे करना। <verse eid="NEH 10:30" /><verse number="31" style="v" sid="NEH 10:31" />ओर जेबे एस देशो रे लोक रामो रे दिने नज्ज या कोई बिकणे री चीज बेचणे खे ल्याओगे तेबे आसा तिना ते ना तो रामो रे दिने, ना केसी पवित्र दिने कुछ लणा; ओर सातुए साले आसा डोरूआ दे कुछ नि बाणा ओर बाकी यहूदिया ते आपणा-आपणा कर्ज लणा छाडी देणा। <verse eid="NEH 10:31" /><verse number="32" style="v" sid="NEH 10:32" />तेबे आसे लोके एड़ा नियम बणाईता जेते कि आसा खे आपणे परमेशरो रे मन्दरो री सेवा खे लगभग चार ग्राम चाँदी देणा पड़ो। <verse eid="NEH 10:32" /><verse number="33" style="v" sid="NEH 10:33" />मतलब पेंटा री रोटी ओर हर रोजके नज्जो री बलि, होमबलि ओर रामो रे दिन ओर नये चाँद ओर ठराए रे त्योआर ओर पवित्र पेंट ओर इस्राएलो रे प्राश्चितो खे पापबलिया खे, बल्कि आपणे परमेशरो रे मन्दरो रे सारे कामो खे देया करना।<verse eid="NEH 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NEH 10:34" />तेबे क्या पुरोईत, क्या लेवीय, क्‍या आम माणूं, आसे सबी लोके एसा गल्ला खे ठराणे खे पर्चिया पाईया, ताकि आपणे पितरा रे कराने रे मुताबिक हर साल ठराए रे बखतो पाँदे लकड़िया री पेंट, बिधानो रे लिखी री गल्ला रे मुताबिक आसे आपणे परमेशर यहोवे री बेदिया पाँदे बाल़ने खे आपणे परमेशरो रे मन्दरो दे ल्याया करिए। <verse eid="NEH 10:34" /><verse number="35" style="v" sid="NEH 10:35" />आसा आपणी-आपणी जमीना री पईली उपज ओर सब प्रकारा रे डाल़ा रे पईले फल हर साल यहोवे रे मन्दरो रे ल्याऊणे। <verse eid="NEH 10:35" /><verse number="36" style="v" sid="NEH 10:36" />ओर बिधानो दे लिखी री गल्ला रे मुताबिक, आपणे-आपणे जेठे पाऊ ओर डांगर, मतलब जेठे बाच्छू ओर मिन्टू आपणे परमेशरो रे मन्दरो दे तिना पुरोईता गे ल्याया करने, जो म्हारे परमेशरो रे मन्दरो दे सेवा-टईल करोए। <verse eid="NEH 10:36" /><verse number="37" style="v" sid="NEH 10:37" />आसा आपणा पईला बाटेया रा आटा, चकी री पेंट ओर सब डाल़ा रे फल ओर नया शराब ओर जैतूनो रा तेल आपणे परमेशरो रे मन्दरो रे कमरे दे पुरोईता गे ओर आपणी-आपणी जमीना री उपजा रा दशमांश, लेविया गे ल्याया करनी; कऊँकि सेयो लेविये थे, जो म्हारी उपजा बीचा ते सबी शईरा दे दशमांश लया करो थे।<note caller="+" style="f"><char style="fr" closed="false">10:37 </char><char style="ft" closed="false">(रोम. 11:16, लेवी. 23:7)</char></note> <verse eid="NEH 10:37" /><verse number="38" style="v" sid="NEH 10:38" />जेबे-जेबे लेविये इस्राएली लोका ते दशमांश लओ, तेबे-तेबे तिना साथे हारूणो री ल्वादा रा कोई पुरोईत रया करो; ओर लेविये दशमांशो रा दशमांश म्हारे परमेशरो रे मन्दरो री कमरे रे, मतलब पण्डारो रे पऊँचाया करोगे। <verse eid="NEH 10:38" /><verse number="39" style="v" sid="NEH 10:39" />कऊँकि जिना कमरे दे पवित्र जगा रे पांडे ओर सेवा-टईल करने वाल़े पुरोईत ओर द्वारपाल ओर गाणे वाल़े रओ थे, तिना दे इस्राएली ओर लेविये, नज्ज, नया शराब ओर जैतूनो रे तेलो री चकी री पेंट पऊँचाया करोगे। ईंयाँ आसा आपणे परमेशरो रे मन्दरो री देखपाल़ करेया करनी।<verse eid="NEH 10:39" /></para>
  <chapter eid="NEH 10" />
  <chapter number="11" style="c" sid="NEH 11" />
  <para style="s">परदान जो यरूशलमो रे बसी गे</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 11:1" />तेस बखते इस्राएली प्रजा रे परदान तो यरूशलेम शईरो दे रओ थे ओर बाकी लोके ये ठराणे खे पर्चिया पाईया, कि दसा बीचा ते एक माणूं यरूशलेम शईरो दे, जो पवित्र शईर ए, बसी जाओ ओर नौ माणूं ओरी शईरो दे वशो। <verse eid="NEH 11:1" /><verse number="2" style="v" sid="NEH 11:2" />जिने आपणी इच्छा ते ई यरूशलेम शईरो रे रणा चाएआ तिना सबी खे लोके आशीर्वाद दित्तेया। <verse eid="NEH 11:2" /><verse number="3" style="v" sid="NEH 11:3" />तेस राज्य रे बड़े-बड़े लोक जो यरूशलेम शईरो दे रओ थे, सेयो यो ए; पर यहूदा रे शईरो दे एक-एक माणूं आपणी जमीना दे रओ था; मतलब इस्राएली, पुरोईत, लेविये, मन्दरो दे सेवा करने वाल़े ओर सुलैमानो रे नौकरा री ल्वाद।<verse eid="NEH 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 11:4" />यरूशलेम शईरो दे तो कुछ यहूदी ओर बिन्यामीनी रओ थे। यहूदिया बीचा ते तो पेरेसो रे कुलो रा अतायाह जो उज्जियाह रा पाऊ था, ये जकर्याह रा पाऊ, ये अमर्याह रा पाऊ, ये शपत्याह रा पाऊ, ये महललेलो रा पाऊ था। <verse eid="NEH 11:4" /><verse number="5" style="v" sid="NEH 11:5" />मासेयाह जो बारूको रा पाऊ था, ये कोलहेजो रा पाऊ, ये हजायाह रा पाऊ, ये अदायाह रा पाऊ, ये योयारीबो रा पाऊ, ये जकर्याह रा पाऊ ओर ये शीलोईये रा पाऊ था।<verse eid="NEH 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 11:6" />पेरेसो रे कुलो रे जो यरूशलेम शईरो दे रओ थे, सेयो सारे मलाई की 468 शूरवीर थे।<verse eid="NEH 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 11:7" />बिन्यामीन गोत्रो बीचा ते एक माणूं सल्लू जो मशुल्लामो रा पाऊ था, मशुल्लाम योएदो रा पाऊ था, योएद पदायाह रा पाऊ था, पदायाह कोलायाह रा पाऊ था, कोलायाह मासेयाह रा पाऊ था, मासेयाह इतीएह रा पाऊ था, इतीएह यशायाह रा पाऊ था।<verse eid="NEH 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 11:8" />तेसते बाद गब्बै सल्लै जिना साथे 928 लोक थे। <verse eid="NEH 11:8" /><verse number="9" style="v" sid="NEH 11:9" />इना रा परदान जिक्रीए रा पाऊ योएल था ओर हस्सनूआ रा पाऊ यहूदा, जो यरूशलेम रे आदे शईरो रा परदान था तेसरी मताद करो था।<verse eid="NEH 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 11:10" />तेबे पुरोईता बीचा ते योयारीबो रा पाऊ यदायाह ओर याकीन। <verse eid="NEH 11:10" /><verse number="11" style="v" sid="NEH 11:11" />ओर सरायाह जो परमेशरो रे मन्दरो रा परदान ओर हिल्किय्याह रा पाऊ था, ये मशुल्लामो रा पाऊ, मशुल्लाम सादोको रा पाऊ, सादोक मरायोतो रा पाऊ, मरायोत अहीतूबो रा पाऊ था। <verse eid="NEH 11:11" /><verse number="12" style="v" sid="NEH 11:12" />ओर इना रे 822 पाई जो तेस मन्दरो रा काम करो थे ओर अदायाह, जो यरोहामो रा पाऊ था, यरोहाम पलल्याह रा पाऊ, पलल्याह अमसीये रा पाऊ, अमसी जकर्याह रा पाऊ, जकर्याह पशहूरो रा पाऊ, पशहूर मल्किय्याह रा पाऊ था। <verse eid="NEH 11:12" /><verse number="13" style="v" sid="NEH 11:13" />एसरे 242 पाई जो पितरा रे कराने रे परदान थे; ओर अमशै जो अजरेलो रा पाऊ था, अजरेल अहजै रा पाऊ, अहजै मशिल्लेमोतो रा पाऊ, मशिल्लेमोत इम्मेरो रा पाऊ था। <verse eid="NEH 11:13" /><verse number="14" style="v" sid="NEH 11:14" />इना रे 128 शूरवीर पाई थे ओर इना रा परदान हग्गदोलीमो रा पाऊ जब्दीएल था।<verse eid="NEH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 11:15" />तेबे लेवी लोका बीचा ते शमायाह जो हश्शूबो रा पाऊ था, हश्शूब अज्रीकामो रा पाऊ, अज्रीकाम हशब्याह रा पाऊ, हशब्याह बुन्नीये रा पाऊ था। <verse eid="NEH 11:15" /><verse number="16" style="v" sid="NEH 11:16" />शब्बतै ओर योजाबाद खास लेविया बीचा ते परमेशरो रे मन्दरो रे बारले कामो खे देखो थे। <verse eid="NEH 11:16" /><verse number="17" style="v" sid="NEH 11:17" />मत्तन्याह जो मीका रा पाऊ ओर जब्दीये रा पोता ओर आसापो रा पड़पोता था; से प्रार्थना दे तन्यवाद करने वाल़ेया रा मुखिया था ओर बकबुक्याह आपणे पाईया बीचे दूजे पदो पाँदे था; ओर अब्दा जो शम्मूये रा पाऊ ओर गालालो रा पोता ओर यदूतूनो रा पड़पोता था। <verse eid="NEH 11:17" /><verse number="18" style="v" sid="NEH 11:18" />जो लेवी लोक पवित्र शईरो दे रओ थे, सेयो सारे मलाई की 284 थे।<verse eid="NEH 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 11:19" />तेबे अक्कूब ओर तल्मोन नाओं रे द्वारपाल ओर तिना रे पाई जो बड़े द्वारा रे रखवाल़े थे, 172 लोक थे। <verse eid="NEH 11:19" /><verse number="20" style="v" sid="NEH 11:20" />बाकी इस्राएली पुरोईत ओर लेविये, यहूदा रे सबी शईरा दे आपणे-आपणे इस्से दे रओ थे। <verse eid="NEH 11:20" /><verse number="21" style="v" sid="NEH 11:21" />मन्दरो दे सेवा करने वाल़े लोक ओपेल पाह्ड़ो पाँदे रओ थे ओर मन्दरो दे सेवा करने वाल़ेया पाँदे सीहा ओर गिश्पा ठराई राखे थे। <verse eid="NEH 11:21" /><verse number="22" style="v" sid="NEH 11:22" />जो लेविये यरूशलेम शईरो दे रई की परमेशरो रे मन्दरो दे कामो दे लगे रे रओ थे, तिना रा मुखिया आसापो रे कुलो रे गाणेवाल़ेया बीचा ते उज्जी था, जो बानीए रा पाऊ था, (बानी मीके रा पड़पोता था) बानी हशब्याह रा पाऊ, हशब्याह मत्तन्याह रा ओर मत्तन्याह हशब्याह रा पाऊ था। <verse eid="NEH 11:22" /><verse number="23" style="v" sid="NEH 11:23" />कऊँकि तिना खे राजे री आज्ञा थी ओर गाणेवाल़ेया खे हर रोजके दिनो खे जो कुछ चाईयो था तिजी रे मुताबिक ठीक प्रबन्द था। <verse eid="NEH 11:23" /><verse number="24" style="v" sid="NEH 11:24" />प्रजा रे सारे कामो खे मशेजबेलो रा पाऊ पतह्माह जो यहूदा रे पाऊ जेरह रे कुलो रा था, से राजे गे रओ था।<verse eid="NEH 11:24" /></para>
  <para style="s">ओरी शईरा दे रणे वाल़े लोक</para>
  <para style="p">
    <verse number="25" style="v" sid="NEH 11:25" />बचे रे गाँवो ओर तिना रे डोरू: कुछ यहूदी जो किर्यतअर्बा शईर ओर तिना रे गाँवो दे, कुछ दीबोन शईर ओर तिना रे गाँवो दे, कुछ यकब्सेल शईर ओर तिना रे गाँवो दे रओ थे। <verse eid="NEH 11:25" /><verse number="26" style="v" sid="NEH 11:26" />तेबे येशुअ शईर, मोलादा शईर, बेत्पेलेत शईर; <verse eid="NEH 11:26" /><verse number="27" style="v" sid="NEH 11:27" />हसर्शूआल शईर ओर बेर्शेबा शईर ओर तिना रे गाँवो दे; <verse eid="NEH 11:27" /><verse number="28" style="v" sid="NEH 11:28" />ओर सिकलग शईर ओर मकोना शईर ओर तिना रे गाँवो दे; <verse eid="NEH 11:28" /><verse number="29" style="v" sid="NEH 11:29" />एन्निम्मोन, सोरा, यर्मूत, <verse eid="NEH 11:29" /><verse number="30" style="v" sid="NEH 11:30" />जानोह ओर अदुल्लाम शईर ओर तिना रे गाँवो दे, लाकीश शईर ओर तिना रे डोरूआ दे अजेका शईर ओर तिना रे गाँवो दे सेयो बेर्शेबा ते लई की हिन्नोमो रिया तराईया तक डेरे लगाई की रओ थे।<verse eid="NEH 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 11:31" />तेबे बिन्यामीनी लोक गेबा शईरो ते लई की मिकमाश, अय्या ओर बेतेल शईर ओर तिना रे गाँवो दे; <verse eid="NEH 11:31" /><verse number="32" style="v" sid="NEH 11:32" />अनातोत, नोब, अनन्याह, <verse eid="NEH 11:32" /><verse number="33" style="v" sid="NEH 11:33" />हासोर, रामाह, गित्तैम, <verse eid="NEH 11:33" /><verse number="34" style="v" sid="NEH 11:34" />हादीद, सबोईम, नबल्लत, <verse eid="NEH 11:34" /><verse number="35" style="v" sid="NEH 11:35" />लोद, ओनो शईर ओर कारीगरा री तराईया तक रओ थे। <verse eid="NEH 11:35" /><verse number="36" style="v" sid="NEH 11:36" />यहूदा रे कुछ लेविया रे दल, बिन्यामीन गोत्रो रे राज्य दे बसी गे।<verse eid="NEH 11:36" /></para>
  <chapter eid="NEH 11" />
  <chapter number="12" style="c" sid="NEH 12" />
  <para style="s">पुरोईता ओर लेविया रे बारे दे</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 12:1" />कई पुरोईत ओर लेवी लोक शालतीएलो रे पाऊ जरूब्बाबेल ओर येशुअ साथे यरूशलेम शईरो खे गये थे, सेयो यो थे: सरायाह, यिर्मयाह, एज्रा, <verse eid="NEH 12:1" /><verse number="2" style="v" sid="NEH 12:2" />अमर्याह, मल्लूक, हत्तूश, <verse eid="NEH 12:2" /><verse number="3" style="v" sid="NEH 12:3" />शकन्याह, रहूम, मरेमोत, <verse eid="NEH 12:3" /><verse number="4" style="v" sid="NEH 12:4" />इद्दो, गिन्नतोई, अबिय्याह, <verse eid="NEH 12:4" /><verse number="5" style="v" sid="NEH 12:5" />मिय्यामीन, माद्याह, बिल्गा, <verse eid="NEH 12:5" /><verse number="6" style="v" sid="NEH 12:6" />शमायाह, योयारीब, यदायाह, <verse eid="NEH 12:6" /><verse number="7" style="v" sid="NEH 12:7" />सल्लू, आमोक, हिल्किय्याह ओर यदायाह। येशुअ रे दिना दे पुरोईत ओर तिना रे पाईया रे खास लोक यो ई थे।<verse eid="NEH 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 12:8" />तेबे लेविया बीचा ते यो गये: येशुअ, बिन्नूई, कदमिएल, शेरेब्याह, यहूदा ओर से मत्तन्याह जो आपणे पाईया समेत परमेशरो रा तन्यवाद करने रे कामो खे ठराया था। <verse eid="NEH 12:8" /><verse number="9" style="v" sid="NEH 12:9" />ओर तिना रे पाई बकबुक्याह ओर उन्नो तिना सामणे आपणी-आपणी सेवकाईया रे लगे रे रओ थे।<verse eid="NEH 12:9" /></para>
  <para style="s">येशुअ री वंशावली</para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 12:10" />तेबे येशुओ ते योयाकीम पैदा ऊआ ओर योयाकीमो ते एल्याशीब, एल्याशीबो ते योयादा, <verse eid="NEH 12:10" /><verse number="11" style="v" sid="NEH 12:11" />योयादा ते योनातान ओर योनातानो ते यद्दू पैदा ऊआ। <verse eid="NEH 12:11" /><verse number="12" style="v" sid="NEH 12:12" />जेबे योयाकीम बड़ा पुरोईत था तेसरे दिना दे यो पुरोईत आपणे-आपणे पितरा रे कराने रे खास मर्द थे, मतलब सरायाह रा तो मरायाह; यिर्मयाह रा हनन्याह। <verse eid="NEH 12:12" /><verse number="13" style="v" sid="NEH 12:13" />एज्रा रा मशुल्लाम; अमर्याह रा यहोहानान। <verse eid="NEH 12:13" /><verse number="14" style="v" sid="NEH 12:14" />मल्लूकीये रा योनातान; शबन्याह रा यूसुफ। <verse eid="NEH 12:14" /><verse number="15" style="v" sid="NEH 12:15" />हारीमो रा अदना; मरायोतो रा हेलकै। <verse eid="NEH 12:15" /><verse number="16" style="v" sid="NEH 12:16" />इद्दो रा जकर्याह; गिन्नतोनो रा मशुल्लाम; <verse eid="NEH 12:16" /><verse number="17" style="v" sid="NEH 12:17" />अबिय्याह रा जिक्री; मिन्यामीनो रे मोअद्याह रा पिलतै; <verse eid="NEH 12:17" /><verse number="18" style="v" sid="NEH 12:18" />बिल्गा रा शम्मू; शमायाह रा यहोनातान; <verse eid="NEH 12:18" /><verse number="19" style="v" sid="NEH 12:19" />योयारीबो रा मत्तनै; यदायाह रा उज्जी। <verse eid="NEH 12:19" /><verse number="20" style="v" sid="NEH 12:20" />सल्लै रा कल्लै, आमोको रा एबेर। <verse eid="NEH 12:20" /><verse number="21" style="v" sid="NEH 12:21" />हिल्किय्याह रा हशब्याह ओर यदायाह रा नतनेल था। <verse eid="NEH 12:21" /><verse number="22" style="v" sid="NEH 12:22" />एल्याशीब, योयादा, योहानान ओर यद्दूये रे दिना रे लेविया रे पितरा रे बड़े मर्दा रे नाओं लिखे जाओ थे ओर फारसो रे राजा दारे राज्य रे पुरोईता रे बी नाओं लिखे जाओ थे। <verse eid="NEH 12:22" /><verse number="23" style="v" sid="NEH 12:23" />जो लेविया रे पितरा रे कराने रे बड़े मर्द थे तिना रे नाओं एल्याशीबो रे पाऊ योहानानो रे दिना तक इतिआसो री कताबा रे लिखे जाओ थे।<verse eid="NEH 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NEH 12:24" />ओर लेविया रे खास मर्द यो थे: हशब्याह, शेरेब्याह ओर कदमिएलो रा पाऊ येशुअ ओर तिना सामणे तिना रे पाई परमेशरो रे दास दाऊदो री आज्ञा रे मुताबिक आमणे-सामणे स्तुति ओर तन्यवाद करने खे नियुक्त थे। <verse eid="NEH 12:24" /><verse number="25" style="v" sid="NEH 12:25" />मत्तन्याह, बकबुक्याह, ओबद्याह, मशुल्लाम, तल्मोन ओर अक्कूब बड़े द्वारो गे पण्डारो रा पईरा देणे वाल़े द्वारपाल थे। <verse eid="NEH 12:25" /><verse number="26" style="v" sid="NEH 12:26" />योयाकीमो रे दिना दे जो योसादाको रा पोता ओर येशुअ रा पाऊ था ओर नहेम्याह राज्यपाल था ओर एज्रा पुरोईत ओर शास्त्रिये रे दिना दे यो ई थे।<verse eid="NEH 12:26" /></para>
  <para style="s">यरूशलमो री दवाला खे अर्पित करना</para>
  <para style="p">
    <verse number="27" style="v" sid="NEH 12:27" />तेबे यरूशलेम शईरो री दवाला रे अर्पित करने रे बखते लेवी लोक तिना री सब जगा दे टोल़े, ताकि यरूशलेम शईरो खे पऊँचाए जाओ, जेते कि खुशी ओर तन्यवाद करी की ओर छाज, सारंगी ओर बीणा बजाई की ओर गायी की तिजी खे अर्पित करो। <verse eid="NEH 12:27" /><verse number="28" style="v" sid="NEH 12:28" />तेबे गाणेवाल़ेया री ल्वाद यरूशलेम शईरो रे चऊँ कनारले देशो ते ओर नतोपतिया शईरो रे गाँवो ते, <verse eid="NEH 12:28" /><verse number="29" style="v" sid="NEH 12:29" />ओर बेतगिलगाल शईरो ते ओर गेबा ओर अज्माबेतो रे डोरूआ ते कट्ठे ऊए; कऊँकि गाणेवाल़ेया यरूशलेम शईरो रे नेड़े-तेड़े गाँवो बसायी ते थे। <verse eid="NEH 12:29" /><verse number="30" style="v" sid="NEH 12:30" />तेबे पुरोईते ओर लेविये आपू-आपू खे शुद्ध कित्तेया ओर तिने प्रजा खे ओर बड़े द्वार ओर दवाल बी शुद्ध कित्ती। <verse eid="NEH 12:30" /><verse number="31" style="v" sid="NEH 12:31" />तेबे मैं यहूदी परदाना खे दवाला पाँदे चढ़ाई की दो बड़े दल ठराए, जो तन्यवाद करी की धूमधड़ाके साथे चलो थे। इना बीचा ते एक दल दक्खणा रिया तरफा खे, मतलब कूड़े रे बड़े द्वारो रिया तरफा री दवाला पाँदिए-पाँदिए चलेया; <verse eid="NEH 12:31" /><verse number="32" style="v" sid="NEH 12:32" />ओर तिना पीछे-पीछे यो चले, मतलब होशायाह ओर यहूदा रे आदे परदान, <verse eid="NEH 12:32" /><verse number="33" style="v" sid="NEH 12:33" />ओर अजर्याह, एज्रा, मशुल्लाम, <verse eid="NEH 12:33" /><verse number="34" style="v" sid="NEH 12:34" />यहूदा, बिन्यामीन, शमायाह ओर यिर्मयाह <verse eid="NEH 12:34" /><verse number="35" style="v" sid="NEH 12:35" />ओर पुरोईता रे कई माठे तुरहिया लई की मतलब जकर्याह जो योनातानो रा पाऊ था ओर से शमायाह रा पाऊ, शमाया मत्तन्याह रा, मत्तन्याह मीकायाह रा पाऊ, मीकायाह जक्कूरो रा पाऊ ओर जक्कूर आसापो रा पाऊ था। <verse eid="NEH 12:35" /><verse number="36" style="v" sid="NEH 12:36" />ओर तेसरे पाई शमायाह, अजरेल, मिललै, गिललै, माए, नतनेल, यहूदा ओर हनानी परमेशरो रे दास दाऊदो रे बाजे लई की चली रे थे; ओर तिना ते आगे-आगे एज्रा शास्त्री चलेया। <verse eid="NEH 12:36" /><verse number="37" style="v" sid="NEH 12:37" />यो सोता बड़े द्वारो ते ई सीदे दाऊदो रे शईरो री पईड़िया पाँदे चढ़ी की, दवाला री ऊचाईया पाँदे चली की, दाऊदो रे मईलो पाँदिए ऊई की, पूर्वो रिया तरफा खे पाणिए रे बड़े द्वारो तक पऊँचे।<verse eid="NEH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NEH 12:38" />तन्यवाद करने ओर धूमधड़ाके साथे चलणे वाल़ेया रा दूजा दल ओर तिना पीछे-पीछे आऊँ ओर आदे लोक तिना साथे मिलणे खे दवाला पाँदले भट्टेया रे गुम्मटो गे चौड़ी दवाला तक पऊँचे। <verse eid="NEH 12:38" /><verse number="39" style="v" sid="NEH 12:39" />ओर तेबे एप्रैमो रे बड़े द्वार ओर पुराणे बड़े द्वार ओर मछली बड़े द्वार, हननेल गुम्मट ओर हम्मेआ नाओं रे गुम्मटो ते ऊई की पेडा रे बड़े द्वारो तक चले ओर पईरा देणे वाल़ेया रे बड़े द्वारा गे खड़े ऊईगे। <verse eid="NEH 12:39" /><verse number="40" style="v" sid="NEH 12:40" />तेबे तन्यवाद करने वाल़ेया रे दोनो दल ओर आऊँ ओर मां साथे आदे परदान परमेशरो रे मन्दरो दे खड़े ऊईगे। <verse eid="NEH 12:40" /><verse number="41" style="v" sid="NEH 12:41" />तेबे एल्याकीम, मासेयाह, मिन्यामीन, मीकायाह, एल्योएनै, जकर्याह ओर हनन्याह नाओं रे पुरोईत तुरहिया लई की थे। <verse eid="NEH 12:41" /><verse number="42" style="v" sid="NEH 12:42" />मासेयाह, शमायाह, एलीआजार, उज्जी, यहोहानान, मल्किय्याह, एलाम ओर एजेर खड़ी रे थे ओर गाणे वाल़े जिना रा मुखिया यिज्रह्माह था, सेयो जोरे की गांदे बजांदे रये। <verse eid="NEH 12:42" /><verse number="43" style="v" sid="NEH 12:43" />तेस ई दिने लोके बड़े-बड़े मेलबलि चढ़ाए ओर खुशी मनाई; कऊँकि परमेशरे सेयो बऊत ई खुश कित्ते थे; जवाणसे ओर बाल बच्चेया बी खुशी मनाई। यरूशलेम शईरो री खुशिया री आवाज दूरो-दूरो तक फैली गी।<verse eid="NEH 12:43" /></para>
  <para style="s">मन्दरो री सेवा करना</para>
  <para style="p">
    <verse number="44" style="v" sid="NEH 12:44" />तेस दिने ई खजानेया रे, चकी री पेंटा रे, पईली-पईली उपजा रे ओर दशमांशो री कमरे रे अधिकारी बणाए, ताकि तिना दे शईरो-शईरो रे डोरूआ रे मुताबिक तिना चीजा खे जमा करो, जो बिधान रे मुताबिक पुरोईत ओर लेविया रे इस्से री थिया; कऊँकि यहूदी आए दे पुरोईत ओर लेविया रिया बजा ते खुश थे। <verse eid="NEH 12:44" /><verse number="45" style="v" sid="NEH 12:45" />इजी री खातर सेयो आपणे परमेशरो रे काम ओर शुद्धता रे बारे चौकसी करदे रये; ओर गाणे वाल़े ओर द्वारपाल बी दाऊद ओर तेसरे पाऊ सुलैमानो री आज्ञा रे मुताबिक तेड़ा ई करदे रये। <verse eid="NEH 12:45" /><verse number="46" style="v" sid="NEH 12:46" />पुराणे बखतो ते, मतलब दाऊद ओर आसापो रे दिना दे तो गाणेवाल़ेया रे परदान थे ओर परमेशरो री स्तुति ओर तन्यवादो रे गाणे गाए जाओ थे। <verse eid="NEH 12:46" /><verse number="47" style="v" sid="NEH 12:47" />जरूब्बाबेल ओर नहेम्याह रे दिना रे सारे इस्राएली, गाणे वाल़े ओर द्वारपाला खे हर रोजो रा इस्सा देंदे रये ओर सेयो लेविया रा इस्सा पवित्र करी की देयो थे ओर लेवी लोक हारूणो री ल्वादा रा इस्सा पवित्र करी की देयो थे।<verse eid="NEH 12:47" /></para>
  <chapter eid="NEH 12" />
  <chapter number="13" style="c" sid="NEH 13" />
  <para style="s">नहेम्याह रे सुदार</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 13:1" />तेस दिने ई मूसे रे बिधानो री कताब लोका खे पढ़ी की सुणाई ओर तिदे ये लिखेया रा मिलेया, कि कोई अम्मोनी या मोआबी परमेशरो री सभा रे कदी नि आई सकदा; <verse eid="NEH 13:1" /><verse number="2" style="v" sid="NEH 13:2" />कऊँकि सेयो रोटी-पाणी लई की इस्राएली लोका साथे मिलणे नि आए, बल्कि तिने बिलाम तिना खे स्राप देणे खे पेंट देई की बुलाया था, तेबे बी म्हारे परमेशरे से स्राप आशीषा दे बदली ता। <verse eid="NEH 13:2" /><verse number="3" style="v" sid="NEH 13:3" />ये बिधान सुणी की, तिने इस्राएलो बीचा ते दूजे कराने रे लोक आपू बीचा ते लग करीते। <verse eid="NEH 13:3" /><verse number="4" style="v" sid="NEH 13:4" />इजी ते पईले एल्याशीब पुरोईत जो म्हारे परमेशरो रे मन्दरो रे कमरे रा अधिकारी ओर तोबियाह रा रिश्तेदार था। <verse eid="NEH 13:4" /><verse number="5" style="v" sid="NEH 13:5" />तिने तोबियाह खे एक बड़ी कोठरी त्यार कित्ती थी जिदे पईले नज्जो री बलिया रा समान ओर लोबान ओर पांडे ओर नज्ज, नया शराब ओर जैतूनो रे तेलो रा दशमांश, जेतेखे लेवी, गाणे वाल़े ओर द्वारपाला खे देणे री आज्ञा थी, तेती राखी राखे थे ओर पुरोईता खे चकी री पेंट बी राखो थे। <verse eid="NEH 13:5" /><verse number="6" style="v" sid="NEH 13:6" />जेस बखते ये ऊआ आऊँ यरूशलेम शईरो दे नि था, कऊँकि बाबेलो रे राजा अर्तक्षत्रो रे बत्थिये साले आऊँ राजे गे चली गा था। तेबे मैं बऊती दिना बाद राजे ते छुट्टी मांगी, <verse eid="NEH 13:6" /><verse number="7" style="v" sid="NEH 13:7" />ओर आऊँ यरूशलेम शईरो खे आया, तेबे माखे पता लगी गा, कि एल्याशीबे तोबियाह खे परमेशरो रे मन्दरो रे आँगणो रे एक कोठरी त्यार करी की, कितणी बड़ी बुराई करी राखी। <verse eid="NEH 13:7" /><verse number="8" style="v" sid="NEH 13:8" />ये माखे बऊत बुरा लगेया ओर मैं तोबियाह रे कअरो रा सारा समान तेस कमरे ते बारे सेटी ता। <verse eid="NEH 13:8" /><verse number="9" style="v" sid="NEH 13:9" />तेबे मेरी आज्ञा ते सेयो कमरे शुद्ध कित्ते ओर मैं परमेशरो रे मन्दरो रे पांडे ओर नज्जो री बलिया रा समान ओर लोबान तिना दे फेर रखवाई ता। <verse eid="NEH 13:9" /><verse number="10" style="v" sid="NEH 13:10" />फेर माखे पता लगेया कि लेविया रा इस्सा तिना खे नि देई राखेया ओर इजी बजा ते काम करने वाल़े लेविये ओर गाणे वाल़े आपणे-आपणे डोरूआ खे नठीगे रे। <verse eid="NEH 13:10" /><verse number="11" style="v" sid="NEH 13:11" />तेबे मैं परदाना खे बकी की बोलेया, “परमेशरो रा मन्दर कऊँ त्यागेया?” तेबे मैं सेयो कट्ठे करी की, एक-एक तेसरी जगा पाँदे नियुक्त कित्ते। <verse eid="NEH 13:11" /><verse number="12" style="v" sid="NEH 13:12" />तदुओ ते सारे यहूदी नज्ज, नया शराब ओर जैतूनो रे तेलो रा दशमांश पण्डारो दे ल्याऊणे लगे। <verse eid="NEH 13:12" /><verse number="13" style="v" sid="NEH 13:13" />मैं पण्डारो रे अधिकारी शेलेम्याह पुरोईत ओर सादोक मंत्री ओर लेविया बीचा ते पदायाह ओर तिना ते थाले हानान, जो मत्तन्याह रा पोता ओर जक्कूरो रा पाऊ था, नियुक्त कित्ते; सेयो तो परोसे जोगे गिणे जाओ थे ओर तिना रा काम आपणे पाईया बीचे बांडणे रा काम था। <verse eid="NEH 13:13" /><verse number="14" style="v" sid="NEH 13:14" />ओ मेरे परमेशर! मेरा ये काम मेरे कल्याणो खे याद राख ओर जो-जो अच्छे काम मैं आपणे परमेशरो रे मन्दर ओर तिजी री आराधना रे बारे दे कित्ते, तिना खे नि पुलणा। <verse eid="NEH 13:14" /><verse number="15" style="v" sid="NEH 13:15" />तिना दिना देई मैं यहूदा दे बऊत लोक देखे जो रामो रे दिने कुण्डा दे दाख केसो थे ओर पूल़िया ल्याओ थे ओर गह्देया पाँदे बोज लादो थे; तेड़े ई सेयो शराब, दाख, दाऊगल़े ओर कई प्रकारा रा बोजा रामो रे दिने यरूशलेम शईरो दे ल्याओ थे; तेबे जेस दिने सेयो खाणे-पीणे रिया चीजा बेचदे माखे दिशे, मैं तेस दिने ई तिना खे बताईता। <verse eid="NEH 13:15" /><verse number="16" style="v" sid="NEH 13:16" />तेबे यरूशलेम शईरो दे सोरी शईरो रे कुछ लोक रओ थे। सेयो मछली ओर कई प्रकारा रा समान ल्याई की, यहूदिया खे यरूशलेम शईरो दे रामो रे दिनो दे बेचेया करो थे। <verse eid="NEH 13:16" /><verse number="17" style="v" sid="NEH 13:17" />तेबे मैं यहूदा रे अमीरा खे बकी की बोलेया, “तुसे लोक ये क्या बुराई करने लगी रे, जो रामो रा दिन अपवित्र करने लगी रे? <verse eid="NEH 13:17" /><verse number="18" style="v" sid="NEH 13:18" />क्या तुसा रे बुजुर्ग एड़ा नि करो थे? ओर क्या म्हारे परमेशरे ये सारी मुसीबत आसा पाँदे ओर एस शईरो पाँदे नि पायी? तेबे बी तुसे रामो रे दिनो खे अपवित्र करने ते इस्राएलो पाँदे परमेशरो रा रोष ओर बी पड़काओए।” <verse eid="NEH 13:18" /><verse number="19" style="v" sid="NEH 13:19" />जेबे रामो रे पईले दिने यरूशलेम शईरो रे बड़े द्वारो रे नेड़े-तेड़े न्हेरा ऊणे लगेया, तेबे मैं आज्ञा दित्ती, कि शईरो रे दरवाजे बन्द करी देयो ओर ये बी आज्ञा दित्ती, कि यो रामो रे दिन पूरे ऊणे तक नि खोलणे। तेबे मैं आपणे कई नौकर बड़े द्वारो रे अधिकारी ठराईते, ताकि रामो रे दिने कोई बोजा पीतरे नि आओ। <verse eid="NEH 13:19" /><verse number="20" style="v" sid="NEH 13:20" />इजी री खातर बपारी ओर कई प्रकारा रा समान बेचणे वाल़े यरूशलेम शईरो ते बारे एक या दो बार रये। <verse eid="NEH 13:20" /><verse number="21" style="v" sid="NEH 13:21" />तेबे मैं तिना खे चतौणी देई की बोलेया, “तुसे लोक दवाला रे सामणे कऊँ रूकी रे? जे तुसे फेर एड़ा कित्तेया तो मां तुसे कैद करी लणे।” तेबे तेस बखतो ते सेयो रामो वाल़े दिने नि आए। <verse eid="NEH 13:21" /><verse number="22" style="v" sid="NEH 13:22" />तेबे मैं लेविया खे आज्ञा दित्ती, कि आपू-आपू खे शुद्ध करी की बड़े द्वारा री रखवाल़ी करने खे आया करो, ताकि रामो रा दिन पवित्र मानेया जाओ। ओ मेरे परमेशर! मेरे कल्याणो खे ये बी याद राख ओर आपणी बड़ी दया रे मुताबिक मां पाँदे दया कर। <verse eid="NEH 13:22" /><verse number="23" style="v" sid="NEH 13:23" />तेबे तिना दिना दे माखे एड़े यहूदी दिशे, जिने अशदोदी, अम्मोनी ओर मोआबी शईरो री जवाणसा साथे ब्या करी ला था। <verse eid="NEH 13:23" /><verse number="24" style="v" sid="NEH 13:24" />तिना रे बाल़का री आदी बोली अशदोदी थी ओर सेयो यहूदी बोली नि बोली सको थे, सेयो दुँईं जातिया री बोली बोलो थे। <verse eid="NEH 13:24" /><verse number="25" style="v" sid="NEH 13:25" />तेबे आऊँ तिना खे बकेया ओर कोसणे लगेया ओर तिना बीचा ते कई कूटवाये ओर तिना रे बाल़ पटवाये ओर तिना खे परमेशरो री ये कसम खुल़ाई, “आसा आपणी बेटिया रा ब्या तिना रे माठेया साथे नि करना ओर ना आपू खे ओर ना आपणे माठेया साथे तिना री बेटिया रा ब्या करना। <verse eid="NEH 13:25" /><verse number="26" style="v" sid="NEH 13:26" />क्या इस्राएलो रा राजा सुलैमान एस पापो दे नि फसेया था? बऊत सारी जातिया बीचे तेस जेड़ा राजा कोई नि ऊआ ओर से आपणे परमेशरो रा प्यारा बी था ओर परमेशरे से सारे इस्राएलो पाँदे राजा बणाया, पर तेसखे बी दूजी जातिया रिये जवाणसे पापो दे फसाया। <verse eid="NEH 13:26" /><verse number="27" style="v" sid="NEH 13:27" />तो क्या आसे तुसा री सुणी की एड़ी बुराई करिए कि दूजी जातिया रिया जवाणसा साथे ब्या करी की परमेशरो रे खलाफ पाप करुँ?” <verse eid="NEH 13:27" /><verse number="28" style="v" sid="NEH 13:28" />ओर एल्याशीब बड़े पुरोईतो रे पाऊ योयादा रा एक पाऊ, होरोनी शईरो रे सम्बल्लतो रा जवांई था, इजी री खातर से मैं आपू नेड़ा ते नठाईता। <verse eid="NEH 13:28" /><verse number="29" style="v" sid="NEH 13:29" />ओ मेरे परमेशर तिना खे याद राख, कऊँकि तिने पुरोईत ओर लेविया री वाचा खे अशुद्ध करी राखेया। <verse eid="NEH 13:29" /><verse number="30" style="v" sid="NEH 13:30" />ईंयाँ मैं सेयो सब दूजी जातिया ते शुद्ध कित्ते ओर एक-एक पुरोईत ओर लेविया री बारी ओर काम ठराईता। <verse eid="NEH 13:30" /><verse number="31" style="v" sid="NEH 13:31" />तेबे मैं लकड़िया री पेंट ल्याऊणे रे खास बखत ठराईते ओर पईली-पईली उपज देणे रा इन्तजाम बी कित्तेया! ओ मेरे परमेशर! मेरे इना खरे कामा करने रिया बजा ते माखे याद राख।<verse eid="NEH 13:31" /></para>
  <chapter eid="NEH 13" />
</usx>