<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CH" style="id" />
  <para style="h">2 इतिआस</para>
  <para style="toc1">इतिआसो री दूजी कताब</para>
  <para style="toc2">2 इतिआस</para>
  <para style="toc3">2 इति.</para>
  <para style="mt">2 इतिआस</para>
  <para style="mt2">इतिआसो री दूजी कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">इतिआसो री दूजी कताबा रे बारे दे एथा ते शुरू ओआ जेती ये पईले इतिआसो दे खत्म ऊआ था। राजा सुलैमानो रे राज्य ते लई कि तेसरी मौता रे बारे तक एसरी शुरूआत ओई फेर राजा सुलैमानो रे पाऊ ओर तेसरा उत्तराधिकारी रहूबियामो रे खलाफ यारोबामो री अगुवाईया दे उत्तरो रे गोत्रा रे बरोदो रे बारे दे। एसते आगे ये जानकारी ए सन 586 ई. पू. दे यरूशलेम शईरो रे पतनो तक, दक्खण राज्य रे इतिआसो तक ई सलामत रओआ।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">सुलैमानो रा राज्य <char style="ior"><ref loc="2CH 1:1-9:31">1:1-9:31</ref></char></para>
  <para style="io1">उत्तरो रे गोत्रा रा बरोद <char style="ior"><ref loc="2CH 10:1-19">10:1-19</ref></char></para>
  <para style="io1">यहूदा रे राजा <char style="ior"><ref loc="2CH 11:1-36:12">11:1-36:12</ref></char></para>
  <para style="io1">यरूशलेम शईरो रा पतन <char style="ior"><ref loc="2CH 36:13-23">36:13-23</ref></char></para>
  <chapter number="1" style="c" sid="2CH 1" />
  <para style="s">सुलैमानो रे राज्य री शुरूआत</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 1:1" />दाऊदो रा पाऊ राजा सुलैमान आपणे राज्य दे स्थिर ऊईगा ओर तेसरे यहोवा परमेशरे से बऊत ई महान बणाया। <verse eid="2CH 1:1" /><verse number="2" style="v" sid="2CH 1:2" />सुलैमाने इस्राएलो रे सारे लोक कट्ठे ऊई की आऊणे खे बुलाए। तिना बीचे सेयो सेना रे अधिकारी बी थे जो 1,000 सिपाईया पाँदे अधिकारी थे ओर जो 100 सिपाईया पाँदे अधिकारी थे। तिना दे न्यायी, इस्राएली लोका रे परदान, ओर पीतरा रे कराने रे खास-खास मर्द बी आई रे थे। <verse eid="2CH 1:2" /><verse number="3" style="v" sid="2CH 1:3" />तेबे सुलैमान पूरी मण्डल़िया समेत गिबोन शईरो री पाह्ड़िया पाँदे गया, कऊँकि परमेशरो रा मिलणे वाल़ा तम्बू, जो यहोवे रे दास मूसे उजाड़ जगा दे बणाया था, से तेथी था। <verse eid="2CH 1:3" /><verse number="4" style="v" sid="2CH 1:4" />बऊत बखत पईले परमेशरो रे वादे रे सन्दूको खे राजा दाऊद किर्यत्यारीम शईरो ते तेसा जगा खे ली आया था जो तिने तेसरिया तँईं बणाई थी, तिने तो तेसखे यरूशलेम शईरो दे एक तम्बू खड़ा करवाया था। <verse eid="2CH 1:4" /><verse number="5" style="v" sid="2CH 1:5" />पर पीतल़ी री जो बेदी ऊरीए रे पाऊ बसलेले, जो हूरो रा पोता था, बणाई थी, से गिबोनो दे यहोवे रे रणे री जगा सामणे थी। इजी री खातर सुलैमान मण्डल़िया खे साथे लई कि तेती गया। <verse eid="2CH 1:5" /><verse number="6" style="v" sid="2CH 1:6" />सुलैमाने तेती तेसा पीतल़ी री बेदिया गे जाई की, जो यहोवे रे सामणे मिलणे वाल़े तम्बूए गे थी, तेते पाँदे 1,000 होमबलि चढ़ाए।<verse eid="2CH 1:6" /></para>
  <para style="s">बुद्धिया रिया तँईं सुलैमानो री प्रार्थना</para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 1:7" />तेस ई दिने राती परमेशरे सुलैमानो खे दर्शण देई की तेसखे बोलेया, “जो कुछ तूँ चाएआ कि आऊँ ताखे देऊँ, से मांते माँग।” <verse eid="2CH 1:7" /><verse number="8" style="v" sid="2CH 1:8" />सुलैमाने परमेशरो ते बोलेया, “तूँ मेरे बाओ दाऊदो पाँदे बड़ी कृपा करदा रया ओर आऊँ तेसरी जगा पाँदे राजा बणाया। <verse eid="2CH 1:8" /><verse number="9" style="v" sid="2CH 1:9" />एबे ओ यहोवा परमेशर! जो वचन तैं मेरे बाओ दाऊदो खे देई राखेया था, से पूरा ओ; तैं तो आऊँ एड़ी प्रजा रा राजा बणाई की स्थिर करी राखेया जो जमीना री तूड़ा री कणियां जेड़ी बऊत ई। <verse eid="2CH 1:9" /><verse number="10" style="v" sid="2CH 1:10" />इजी री खातर एबे तूँ माखे एड़ी बुद्धि ओर ज्ञान दे, ताकि आऊँ इना लोका खे चलाणे वाल़ा एक अच्छा राजा बणी सकुँ। जे तूँ मेरिया खातर एड़ा करेगा तो ई आऊँ तेरे लोका रे एस महान राज्य पाँदे शासन करी सकूँआ।”<verse eid="2CH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 1:11" />परमेशरे सुलैमानो खे ज्वाब दित्तेया, “तेरी जो एड़ी ई इच्छा ऊई, मतलब तैं ना तो तअन-सम्पत्ति मांगी, ना ऐश्वर्य, ओर ना आपणे बैरिया रे प्राण ओर ना आपणी लाम्बी उम्र मांगी, बस बुद्धि ओर ज्ञानो रा वरदान मांगेया, जेते की तूँ मेरी प्रजा खे, जेसा पाँदे मैं तूँ राजा बणाई राखेया, मेरिया बाटा दे चलाई सके, <verse eid="2CH 1:11" /><verse number="12" style="v" sid="2CH 1:12" />इजी बजा ते बुद्धि ओर ज्ञान आऊँ ताखे देऊँआ। ओर मां ताखे इतणा तअन-सम्पत्ति ओर ऐश्वर्य देणा, जितणा ना तो तांते पईले केसी राजे खे मिलेया ओर ना तांते बाद केसी राजे खे मिलणा।”<verse eid="2CH 1:12" /></para>
  <para style="s">सुलैमानो री सेना ओर शक्ति</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 1:13" />तेबे सुलैमान गिबोनो री ऊच्ची जगा ते, मतलब मिलणे वाल़े तम्बूए रे सामणे ते यरूशलेम शईरो खे आया ओर तेथी इस्राएलो पाँदे राज करने लगेया। <verse eid="2CH 1:13" /><verse number="14" style="v" sid="2CH 1:14" />जिंयाँ-जिंयाँ मीन्ने ओर साल बीतदे गये। राजा सुलैमानो गे रथा खे चलाणे खे जादा ते जादा लड़ाईया खे गडिया ओर कोड़े मिलणे लगे। तेसगे 1,400 रथ ओर 12,000 कोड़ेया रे सवार थे। तिने कुछ रथ ओर कोड़े रथो रे शईरो दे राखे ओर बाकि ओरी खे से आपू साथे यरूशलेम शईरो खे लईगा। <verse eid="2CH 1:14" /><verse number="15" style="v" sid="2CH 1:15" />राजा सुलैमानो रे राजो रे बखते यरूशलेम शईरो दे सूईने-चाँदिए री कीमत पात्थरा जेड़ी आम ऊईगी। ओर यहूदा रे थालले इलाके दे देवदारा री कीमत गूलरो रे डाल़ा बराबर मतलब बऊत ई कम ऊईगी। <verse eid="2CH 1:15" /><verse number="16" style="v" sid="2CH 1:16" />जो कोड़े सुलैमान राखो था सेयो मिस्रो ते आओ थे ओर राजे रे बपारी तिना खे जो तिना री कीमत राखी राखो थे, चूण्डा रे चूण्ड खरीदो थे। <verse eid="2CH 1:16" /><verse number="17" style="v" sid="2CH 1:17" />तिने मिस्रो दे खरीदे दे हर एकी रथो रिया तँईं 600 सिक्के चाँदिए रे दित्ते। तिने हर एक कोड़ा 150 चाँदिए रे सिक्के देई की खरीदेया था। तिने हित्तिया रे सबी राजेया ओर अरामो रे राजेया खे रथ ओर कोड़े बेचे।<verse eid="2CH 1:17" /></para>
  <chapter eid="2CH 1" />
  <chapter number="2" style="c" sid="2CH 2" />
  <para style="s">राजा सुलैमानो री मन्दर बनाणे री त्यारी</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 2:1" />तेबे सुलैमाने यहोवे खे एक मन्दर ओर आपणा राजमईल बनाणे रे बारे दे सोचेया। <verse eid="2CH 2:1" /><verse number="2" style="v" sid="2CH 2:2" />इजी री खातर सुलैमाने 70,000 बोजा टोणे वाल़े लोक ओर 80,000 पाह्ड़ो ते पात्थर तोड़ने वाल़े ओर डाल़ बाडणे वाल़े लोक ओर इना पाँदे 3,600 मुखिये गिणती करी की ठराए। <verse eid="2CH 2:2" /><verse number="3" style="v" sid="2CH 2:3" />तेबे सुलैमाने सोरो रे राजा हीरामो गे सन्देसा पेजेया, “कुछ साल पईले जेड़ा तैं मेरे बाओ दाऊदो साथे बर्ताव कित्तेया, मतलब तेसरे रणे रा मईल बनाणे खे देवदार पेजे थे, तेड़ा ई एबे मां साथे बी बर्ताव कर। <verse eid="2CH 2:3" /><verse number="4" style="v" sid="2CH 2:4" />देख, आऊँ आपणे परमेशर यहोवे रा एक मन्दर बनाणे वाल़ा ए, ताकि आऊँ तिजी खे पवित्र करुँ ओर तेसरे सामणे खुशबूदार तूप बाल़ू ओर हर रोज पेंटा री रोटी तिदे राखी जाओ ओर हर रोज प्यागा ओर साँजा, राम ओर नये चाँदो रे त्योआरो रे दिने ओर म्हारे परमेशर यहोवे रे सब ठीक बखतो दे होमबलि चढ़ाया जाओ। इस्राएलो खे एड़ी ई सदा री बिधि ए। <verse eid="2CH 2:4" /><verse number="5" style="v" sid="2CH 2:5" />जो मन्दर आऊँ बनाणे वाल़ा ए, से महान् ऊणा; कऊँकि म्हारा परमेशर सबी देवतेया ते बड़ा ए। <verse eid="2CH 2:5" /><verse number="6" style="v" sid="2CH 2:6" />पर केसदे इतणी तागत ए कि तेसखे मन्दर बणाओ, से तो स्वर्गो रे बल्कि सबी ते ऊच्चे स्वर्गो दे पनि समांदा? आऊँ क्या ए कि तेस सामणे तूप बाल़ने खे छाडी की ओर कुछ सोची की तेसरा मन्दर बणाऊँ? <verse eid="2CH 2:6" /><verse number="7" style="v" sid="2CH 2:7" />इजी री खातर एबे तूँ मांगे एक एड़ा माणूं पेजी दे, जो सूईना, चाँदी, पीतल़, लोआ ओर बैंगणी, लाल ओर नीले टाल्लेया दे कडाई करने री कारीगरिया दे निपुण ओ ओर जो नक्काशी बी जाणदा ओ, ताकि से मेरे बाओ दाऊदो रे ठराए रे निपुण माणूंआ साथे ऊई की जो मांगे यहूदा ओर यरूशलेम शईरो दे रओए, काम करो। <verse eid="2CH 2:7" /><verse number="8" style="v" sid="2CH 2:8" />तेबे लबानोनो ते मांगे देवदार, सनौबर ओर चन्दनो री लकड़ी पेजणी, कऊँकि माखे पता ए कि तेरे दास लबानोनो रे डाल़ बाडणा जाणोए ओर तेरे दासा साथे मेरे दासा बी रई की काम करना, <verse eid="2CH 2:8" /><verse number="9" style="v" sid="2CH 2:9" />माखे बऊत सारी लकड़िया री जरूरत ए, कऊँकि जो मन्दर आऊँ बनाणा चाऊँआ, से बड़ा ओर नऊखा ऊणा। <verse eid="2CH 2:9" /><verse number="10" style="v" sid="2CH 2:10" />मां तेरेया दासा खे जिना लकड़ी बाडणी तिना खे 2,000 टन कणक, ओर तिथणा ई जौ देणा, 440,000 लीटर शराब देणी ओर तिथणा ई तेल बी देणा।”<verse eid="2CH 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 2:11" />तेबे सोरो रे राजा हीरामे चिट्ठी लिखी की सुलैमानो गे पेजी, “यहोवा आपणी प्रजा साथे प्यार राखोआ, इजी ते तिने तूँ तिना रा राजा बणाईता।” <verse eid="2CH 2:11" /><verse number="12" style="v" sid="2CH 2:12" />फेर हीरामे ये बी लिखेया, “तन्य ए इस्राएलो रा यहोवा परमेशर, जो सर्ग ओर तरतिया खे बनाणे वाल़ा ए ओर तिने दाऊद राजे खे एक अक्लमंद, उशयार ओर समजदार पाऊ दित्तेया, ताकि से यहोवे रा एक मन्दर ओर आपणा राजमईल बी बणाओ। <verse eid="2CH 2:12" /><verse number="13" style="v" sid="2CH 2:13" />इजी री खातर एबे आऊँ एक अक्लमंद ओर समजदार मर्दो खे, मतलब हूराम-अबीए खे पेजुँआ, <verse eid="2CH 2:13" /><verse number="14" style="v" sid="2CH 2:14" />जो इस्राएलो रे एक दानी गोत्रो री जवाणसा रा पाऊ ए ओर तेसरा बाओ सोरो रा रणे वाल़ा था। से सूईना, चाँदी, पीतल़, लोआ, पात्थर, लकड़ी, बैंगणी ओर नीले, लाल, छोटे रेशमो रे टाल्ले दे कडाई करने रा काम ओर हर प्रकारा री नक्काशी जाणोआ ओर हर प्रकारा री कारीगरी बणाई सकोआ इजी री खातर तेरे उशयार माणूंआ साथे ओर मेरे प्रभु तेरे बाओ दाऊदो रे उशयार माणूंआ साथे, तेसखे बी काम मिलो। <verse eid="2CH 2:14" /><verse number="15" style="v" sid="2CH 2:15" />मेरे मालके जो कणक, जौ, तेल ओर शराब पेजणे रे बारे दे वायदा करी राखेया, से आपणे दासा गे पेजी दे। <verse eid="2CH 2:15" /><verse number="16" style="v" sid="2CH 2:16" />ओर आसा लोका जितणी लकड़ी ताखे चाईयो तितणी लबानोनो रे पाह्ड़ो ते बाडणी ओर बेड़े बणाई की समुद्रो रिया बाटा ते याफा शईरो रे पऊँचाणी ओर तैं से यरूशलेम शईरो खे लई जाणी।”<verse eid="2CH 2:16" /></para>
  <para style="s">सुलैमानो रे काम</para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 2:17" />तेबे राजा सुलैमाने इस्राएल देशो रे सबी परदेशिया री गिणती लई, ये तेसा गिणतिया ते बाद ऊई जो तेसरे बाओ दाऊदे लई थी ओर सेयो 153,600 मर्द निकल़े। <verse eid="2CH 2:17" /><verse number="18" style="v" sid="2CH 2:18" />तिना बीचा ते तिने 70,000 बोजा टोणे वाल़े, 80,000 पाह्ड़ो पाँदे पात्थर तोड़ने वाल़े ओर डाल़ बाडणे वाल़े ओर 3,600 तिना लोका ते काम कराणे वाल़े मुखिये नियुक्त कित्ते।<verse eid="2CH 2:18" /></para>
  <chapter eid="2CH 2" />
  <chapter number="3" style="c" sid="2CH 3" />
  <para style="s">मन्दरो खे बनाणे रा काम</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 3:1" />तेबे सुलैमाने यरूशलेम शईरो रे मोरिय्याह नाओं रे पाह्ड़ो पाँदे तेसा ई जगा रे यहोवे रा मन्दर बनाणा शुरू कित्तेया, जो तेसरे बाओ दाऊदे दर्शण पाई की यबूसी ओर्नानो रे खल्याणो रे त्यार कित्तेया था। <verse eid="2CH 3:1" /><verse number="2" style="v" sid="2CH 3:2" />तिने आपणे राजो रे चौथे सालो रे दूजे मीन्ने दे, दूजे दिनो दे काम करना शुरू कित्तेया। <verse eid="2CH 3:2" /><verse number="3" style="v" sid="2CH 3:3" />परमेशरो रा जो मन्दर सुलैमाने बणाया, तेतेरी लम्बाई तो पुराणे नापो रे मुताबिक नब्बे फूट ओर चौड़ाई ती फूट थी। <verse eid="2CH 3:3" /><verse number="4" style="v" sid="2CH 3:4" />मन्दरो रे सामणे बरांडे री लम्बाई तो मन्दरो री चौड़ाईया रे बराबर तीई फूट थी ओर तेतेरी ऊचाई तीई फूट थी। सुलैमाने से मन्दर पीतरा ते शुद्ध सूईने साथे मढ़वाया। <verse eid="2CH 3:4" /><verse number="5" style="v" sid="2CH 3:5" />मन्दरो रे बड़े इस्से री छत तिने केली री लकड़िया ते बणवाई ओर से अच्छे सूईने साथे मढ़वाई ओर तेते पाँदे खजूरी री डाल़िया री ओर साँकल़ो री नक्काशी कराई। <verse eid="2CH 3:5" /><verse number="6" style="v" sid="2CH 3:6" />तेबे सजाणे खे तिने मन्दरो दे मणि जड़वाए। ओर ये सूईना पर्वेम देशो रा था। <verse eid="2CH 3:6" /><verse number="7" style="v" sid="2CH 3:7" />तिने मन्दरो रे सारे इस्से खे टखणे खे सूईने रा इस्तेमाल कित्तेया, मतलब एतेरे छतो रिया कड़िया, देऊल़ी, कांदा ओर दरवाजे। तिने कांदा दे करूबा रे चित्रा री नक्काशी करवाई।<verse eid="2CH 3:7" /></para>
  <para style="s">परम पवित्र जगा</para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 3:8" />तेबे तिने मन्दरो री परम पवित्र जगा बणाई; तेतेरी लम्बाई मन्दरो री चौड़ाईया रे बराबर तीई फुट थी ओर तेतेरी चौड़ाई तीई फुट थी ओर तिने से लगभग 20 टन शुद्ध सूईने साथे मढ़वाया। <verse eid="2CH 3:8" /><verse number="9" style="v" sid="2CH 3:9" />सूईने री परेगा रा बजन लगभग 600 ग्राम था। तिने अटारिया खे बी सूईने साथे मढ़वाया। <verse eid="2CH 3:9" /><verse number="10" style="v" sid="2CH 3:10" />तेबे मन्दरो री परम पवित्र जगा रे तिने नक्काशी करी की दो करूब बणाए ओर सेयो सूईने साथे मढ़वाए। <verse eid="2CH 3:10" /><verse number="11" style="v" sid="2CH 3:11" />करूबो रे सारे पंख मिलाई की तीई फुट लाम्बे थे, मतलब एकी करूबो रा एक पंख साडे सात फुट था ओर मन्दरो री कांदा तक पऊँची रा था ओर तेतेरा दूजा पंख साडे सात फुट था ओर दूजे करूबो रे पंखो साथे मिलेया रा था। <verse eid="2CH 3:11" /><verse number="12" style="v" sid="2CH 3:12" />दूजे करूबो रा बी एक पंख साडे सात फुट था ओर मन्दरो री दूजी कांदा तक पऊँचेया रा था ओर दूजा पंख साडे सात फुट था ओर पईले करूबो रे पंखो साथे लगेया रा था। <verse eid="2CH 3:12" /><verse number="13" style="v" sid="2CH 3:13" />इना करूबा रे पंख तीई फुट फैले दे थे ओर सेयो आपणे-आपणे पैरा रे पारे खड़ी रे थे ओर आपणा-आपणा मूँ पीतरली तरफा खे कित्तेया रा था। <verse eid="2CH 3:13" /><verse number="14" style="v" sid="2CH 3:14" />तेबे तिने बीचला पर्दा नीले, बैंगणी ओर लाल रंगो रे रेशमो रे टाल्लेया रा बणवाया ओर तिदे करूबा रे चित्र कढ़ाए।<verse eid="2CH 3:14" /></para>
  <para style="s">पीतल़ी रे खम्बे</para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 3:15" />मन्दरो रे सामणे तिने बूँजा-बूँजा फुट ऊच्चे दो खम्बे बणवाए ओर जो काँगणी एकी-एकी पाँदे थी से साडे सात फुट थी। <verse eid="2CH 3:15" /><verse number="16" style="v" sid="2CH 3:16" />तेबे तिने पीतरले कमरे रे साँगल़ा बणवाई की खम्बेया पाँदे लगाईया ओर 100 अनार बी बणवाई की साँगल़ा पाँदे लटकाए। <verse eid="2CH 3:16" /><verse number="17" style="v" sid="2CH 3:17" />तिने यो खम्बे मन्दरो रे सामणे, एक तो दाँणे कनारे ओर दूजा खूँजे कनारे खड़ा कराया ओर दाँणे तरफा रे खम्बे रा नाओं याकीन ओर खूँजे खम्बे रा नाओं बोअज राखेया।<verse eid="2CH 3:17" /></para>
  <chapter eid="2CH 3" />
  <chapter number="4" style="c" sid="2CH 4" />
  <para style="s">मन्दरो रा समान</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 4:1" />सुलैमाने लगभग तीई फूट लाम्बी, तीई फूट चौड़ी ओर पन्द्रा फूट ऊच्ची पीतल़ी री एक बेदी बणाई। <verse eid="2CH 4:1" /><verse number="2" style="v" sid="2CH 4:2" />तेबे तिने कअड़ेया रा एक अऊद बणाया; जो एकी कनारे ते दूजे कनारे तक पन्द्रा फुटा तक चौड़ा था, से गोल़ था ओर तेतेरी ऊचाई साडे सात फुट थी ओर तेतेरे चऊँ कनारला केरा पैंताल़ी फुटो रे नापो रा था। <verse eid="2CH 4:2" /><verse number="3" style="v" sid="2CH 4:3" />तेते निठे, तेतेरे चऊँ कनारे, डेडी-डेडी फुटो रे दस-दस बल़दा री मूर्तिया बणी री थिया, जिने अऊद केरी राखेया था; जेबे से कअड़ेया, तेबे यो बल़द बी दूई पाल़िया दे कअड़े। <verse eid="2CH 4:3" /><verse number="4" style="v" sid="2CH 4:4" />से बारा बणे रे बल़दा पाँदे राखेया, जिना बीचा ते तीन उत्तर, तीन पच्छमा, तीन दक्खण ओर तीऊँ पूर्वो रिया तरफा खे मूँ करी राखेया था ओर इना पाँदे अऊद राखी राखेया था ओर तिना सबी रे पिछले अंग पीतरले इस्से दे पड़ो थे। <verse eid="2CH 4:4" /><verse number="5" style="v" sid="2CH 4:5" />अऊद मुट्ठी पर मोटा था ओर तेतेरा कनारा कटोरे रे कनारे जेड़ा था, जिदे सोसणो रे फूलो री नक्काशी करी राखी थी ओर तिदे लगभग 65,000 लीटर पाणी आओ था। <verse eid="2CH 4:5" /><verse number="6" style="v" sid="2CH 4:6" />तेबे तिने बलिया रिया चीजा तोणे खे दस अऊदिया बणाई की, पाँज दाँणी तरफा खे ओर पाँज खूँजी तरफा खे राखिया। तिना अऊदिया दे होमबलिया री चीजा तोओ थे, पर पुरोईता खे नाह्णे-तोणे खे बड़ा अऊद था।<verse eid="2CH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 4:7" />फेर तिने सूईने रे दस दिऊए बिधिया रे मुताबिक बणवाए ओर पाँज दाँणी तरफा खे ओर पाँज खूँजी तरफा खे मन्दरो दे रखवाई ते। <verse eid="2CH 4:7" /><verse number="8" style="v" sid="2CH 4:8" />तेबे तिने दस मेजा बणवाई की पाँज दाँणी तरफा खे ओर पाँज खूँजी तरफा खे मन्दरो दे रखवाईया। ओर तिने सूईने रे 100 कटोरे बणवाए। <verse eid="2CH 4:8" /><verse number="9" style="v" sid="2CH 4:9" />फेर तिने इस्राएलो रे पुरोईता रा आँगण ओर बड़ा आँगण बणवाया ओर एते आँगणो दे बड़े द्वार बणवाई की तिना रे दरवाजेया दे पीतल़ मढ़वाया। <verse eid="2CH 4:9" /><verse number="10" style="v" sid="2CH 4:10" />तिने अऊद मन्दरो रे दाँणे कनारे, मतलब पूर्ब ओर दक्खणो रे कूणे पाँदे रखवाई ता। <verse eid="2CH 4:10" /><verse number="11" style="v" sid="2CH 4:11" />हूरामे आण्डिया, फरूए ओर कटोरे बणाए। ईंयाँ हूरामे राजा सुलैमानो खे परमेशरो रे मन्दरो दे जो काम करना था से खत्म करी ता, <verse eid="2CH 4:11" /><verse number="12" style="v" sid="2CH 4:12" />मतलब दो खम्बे ओर गोल़ाईया समेत सेयो काँगणिया जो खम्बेया रे सिरे पाँदे थिया ओर खम्बे रे सिरे पाँदले गोल़ेया खे टखणे खे दो-दो जाल़ीदार लाईनी बणाईया; <verse eid="2CH 4:12" /><verse number="13" style="v" sid="2CH 4:13" />ओर दुँईं जाल़िया खे 400 अनार ओर जो गोल़े खम्बेया रे सिरे पाँदे थे, तिना खे टखणे वाल़ी एक-एक जाल़िया खे अनारा रिया दो-दो लाईनी बणवाईया। <verse eid="2CH 4:13" /><verse number="14" style="v" sid="2CH 4:14" />तेबे तिने कुर्सिया ओर कुर्सिया पाँदलिया अऊदिया, <verse eid="2CH 4:14" /><verse number="15" style="v" sid="2CH 4:15" />ओर तिना निठो खे बारा बल़द बणाए। <verse eid="2CH 4:15" /><verse number="16" style="v" sid="2CH 4:16" />तेबे हूराम-अबीए आण्डिया, फरूए, कांडे ओर इना रा सारा सामान यहोवे रे मन्दरो खे राजा सुलैमानो री आज्ञा ते चमकाए रे पीतल़ी रे बणाए। <verse eid="2CH 4:16" /><verse number="17" style="v" sid="2CH 4:17" />राजे सेयो यरदन नदिया री तराईया रे, मतलब सुक्कोत ओर सारतानो बीचे चिकणी माट्टिया री जमीना दे बणवाए। <verse eid="2CH 4:17" /><verse number="18" style="v" sid="2CH 4:18" />राजा सुलैमाने यो सब पांडे बऊत बणवाए, एथो तक कि पीतल़ी रे तोलो रा साअब नि था। <verse eid="2CH 4:18" /><verse number="19" style="v" sid="2CH 4:19" />तेबे राजा सुलैमाने परमेशरो रे मन्दरो रे सारे पांडे, सूईने री बेदी ओर सेयो मेज जिना पाँदे पेंटा री रोटी राखो थे, <verse eid="2CH 4:19" /><verse number="20" style="v" sid="2CH 4:20" />तेबे दिऊए समेत शुद्ध सूईने री दीवटा, जो बिधिया रे मुताबिक पितरली कमरे सामणे बल़ेया करो थिया <verse eid="2CH 4:20" /><verse number="21" style="v" sid="2CH 4:21" />ओर सूईने, बल्कि शुद्ध सूईने रे फूल, दिऊए ओर चिमटे; <verse eid="2CH 4:21" /><verse number="22" style="v" sid="2CH 4:22" />ओर शुद्ध सूईने रिया कैंचिया, कटोरे, तूपदान ओर कड़छे बणवाए। तेबे मन्दरो रे द्वार ओर परम पवित्र जगा रे पीतरले दरवाजे ओर मन्दर, मतलब मन्दरो रे दरवाजे सूईने रे बणे।<verse eid="2CH 4:22" /></para>
  <chapter eid="2CH 4" />
  <chapter number="5" style="c" sid="2CH 5" />
  <para style="s">पवित्र सन्दूक मन्दरो रे ल्याया जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 5:1" />ईंयाँ सुलैमाने यहोवे रे मन्दरो खे जो-जो समान बणवाया से सारा पूरा ऊईगा। तेबे सुलैमाने आपणे बाओ दाऊदो रे पवित्र कित्ते रे सूईने, चाँदी ओर सब पांडे पीतरे पऊँचाई की परमेशरो रे पण्डारो दे रखवाई ते। <verse eid="2CH 5:1" /><verse number="2" style="v" sid="2CH 5:2" />तेबे सुलैमाने इस्राएलो रे बुजुर्गा खे ओर गोत्रो रे सारे खास मर्द, जो इस्राएली लोका रे पितरा रे करानेया रे परदान थे, सेयो बी यरूशलेम शईरो दे इजी बजा ते कट्ठे कित्ते, ताकि सेयो यहोवे री वाचा रा सन्दूक दाऊदो रे शईरो ते, मतलब सिय्योनो ते ऊबे ल्याओ। <verse eid="2CH 5:2" /><verse number="3" style="v" sid="2CH 5:3" />सारे इस्राएली मर्द सातुए मीन्ने दे त्योआरो रे बखते राजे गे कट्ठे ऊए। <verse eid="2CH 5:3" /><verse number="4" style="v" sid="2CH 5:4" />जेबे इस्राएलो रे सारे बुजुर्ग यरूशलेम शईरो दे आए, तेबे लेविये सन्दूक चकी ला। <verse eid="2CH 5:4" /><verse number="5" style="v" sid="2CH 5:5" />ओर लेवी पुरोईत सन्दूक ओर मिलणे वाल़े तम्बू ओर जितणिया पवित्र चीजा तेस तम्बूए रे थिया तिना सबी खे ऊबे लईगे। <verse eid="2CH 5:5" /><verse number="6" style="v" sid="2CH 5:6" />राजा सुलैमान ओर सारे इस्राएली मण्डल़िया रे लोक जो तेसगे कट्ठे ऊए थे, तिने सन्दूको सामणे इतणी पेडा ओर बल़द बलि कित्ते कि जिना री गिणती ओर साअब बऊत जादा ऊणे रिया बजा ते नि ऊई सकेया था। <verse eid="2CH 5:6" /><verse number="7" style="v" sid="2CH 5:7" />तेबे पुरोईते यहोवे री वाचा रा सन्दूक तेसरी जगा दे, मतलब मन्दरो दे पीतरले कमरे दे जो परम पवित्र जगा थी, पऊँचाई की करूबा रे पंखा निठे राखी ता। <verse eid="2CH 5:7" /><verse number="8" style="v" sid="2CH 5:8" />सन्दूको री जगा पाँदे करूबे पंख फैलाई राखे थे, जेते साथे तिने पाँदा ते सन्दूक ओर तिजी रे डण्डे टखी राखे थे। <verse eid="2CH 5:8" /><verse number="9" style="v" sid="2CH 5:9" />डण्डे तो इतणे लाम्बे थे कि तिना रे सिरे सन्दूको ते निकल़े रे पीतरले कमरे दे सामणे दिखो थे, पर सेयो बारा ते नि दिखो थे। सेयो आजके दिनो तक तेथी ए। <verse eid="2CH 5:9" /><verse number="10" style="v" sid="2CH 5:10" />सन्दूको रे तिना दूई तख़्तिया खे छाडी की ओर कुछ नि था, जो मूसे होरेबो दे तेते दे पीतरे तेस बखते राखिया थिया, जेबे यहोवे इस्राएली लोका रे मिस्रो ते निकल़ने ते बाद तिना साथे वाचा बानी थी।<verse eid="2CH 5:10" /></para>
  <para style="s">परमेशरो री महिमा रा तेज</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 5:11" />जेबे पुरोईत पवित्र जगा ते निकल़े, जितणे पुरोईत आजीर थे, तिने सबी तो आपू-आपू खे पवित्र करी राखेया था ओर लग-लग दलो रे ऊई की सेवा नि करो थे; <verse eid="2CH 5:11" /><verse number="12" style="v" sid="2CH 5:12" />ओर जितणे लेवी गाणे वाल़े थे, सेयो सारे के सारे मतलब पाऊ ओर पाई-बन्दुआ समेत आसाप, हेमान ओर यदूतून रेशमो रे टाल्ले पईनी की छाज, सारंगिया ओर बीणा लई की बेदिया रे पूर्वो रिया तरफा खे खड़ी रे थे ओर तिना साथे 120 पुरोईत तुरहिया बजाणे लगी रे थे। <verse eid="2CH 5:12" /><verse number="13" style="v" sid="2CH 5:13" />ओर जेबे तुरहिया बजाणे वाल़े ओर गाणे वाल़े कट्ठे ऊई की यहोवे री स्तुति ओर तन्यवाद करने लगे ओर तुरहिया छाज बगैरा बाजे बजांदे ऊए यहोवे री ये स्तुति ऊच्ची आवाजा दे करने लगे, “यहोवा पला ए ओर तेसरी करूणा सदा री ए” तेबे यहोवे रा मन्दर तेसरी महिमा रे तेजो ते परीगा, <verse eid="2CH 5:13" /><verse number="14" style="v" sid="2CH 5:14" />ओर तेजो रिया बजा ते पुरोईत लोक सेवा-टईल करने खे खड़े नि रई सके, कऊँकि यहोवे रा तेज मन्दरो दे परी गा दा था।<verse eid="2CH 5:14" /></para>
  <chapter eid="2CH 5" />
  <chapter number="6" style="c" sid="2CH 6" />
  <para style="s">सुलैमानो री प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 6:1" />तेबे सुलैमान बोलणे लगेया,</para>
  <para style="q" vid="2CH 6:1">“यहोवे बोलेया था कि मां अन्दकूप न्हेरे दे वास करना।<verse eid="2CH 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="2CH 6:2" />पर मैं तेरिया तँईं रणे खे एक बऊत ई बांका मन्दर बणाया,</para>
  <para style="q" vid="2CH 6:2">जिदे तूँ युगो-युगो तक रये।”<verse eid="2CH 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 6:3" />तेबे राजे इस्राएलो री पूरी सभा रिया तरफा खे मूँ करी की तिना खे आशीर्वाद दित्तेया ओर इस्राएलो री पूरी सभा खड़ी रई। <verse eid="2CH 6:3" /><verse number="4" style="v" sid="2CH 6:4" />तेबे तिने बोलेया, “तन्य ए इस्राएलो रा यहोवा परमेशर, जिने आपणे मुंए ते मेरे बाओ दाऊदो खे ये वचन दित्तेया था, ओर आपणे आथो साथे ये पूरा कित्तेया” <verse eid="2CH 6:4" /><verse number="5" style="v" sid="2CH 6:5" />जेस दिनो ते आऊँ आपणी प्रजा खे मिस्र देशो ते निकयाल़ी की ल्याई राखेया, तदुओ ते मैं ना तो इस्राएलो रे केसी गोत्रो रा कोई शईर चूणेया, जिदे मेरे नाओं रा रणे खे मन्दर बणाया जाओ ओर ना कोई माणूं चूणेया कि से मेरी इस्राएली प्रजा रा परदान ओ। <verse eid="2CH 6:5" /><verse number="6" style="v" sid="2CH 6:6" />पर मैं यरूशलेम इजी खे चूणेया, ताकि मेरा नाओं तेती ओ ओर दाऊद इजी खे चूणेया कि से मेरी इस्राएली प्रजा पाँदे परदान ओ। <verse eid="2CH 6:6" /><verse number="7" style="v" sid="2CH 6:7" />मेरे बाओ दाऊदो री ये इच्छा थी कि इस्राएलो रे परमेशर यहोवे री महिमा खे एक मन्दर बणाओ। <verse eid="2CH 6:7" /><verse number="8" style="v" sid="2CH 6:8" />पर यहोवे मेरे बाओ दाऊदो खे बोलेया, “तेरी जो इच्छा ए कि परमेशरो रे नाओं रा एक मन्दर बणाऊँ, एड़ी इच्छा करी की तैं खरा तो कित्तेया; <verse eid="2CH 6:8" /><verse number="9" style="v" sid="2CH 6:9" />तेबे बी तूँ तेस मन्दरो खे बणाई नि सकदा, तेरा जो आपणा पाऊ ऊणा, तेस ई मेरे नाओं रा मन्दर बनाणा।” <verse eid="2CH 6:9" /><verse number="10" style="v" sid="2CH 6:10" />ये वचन जो यहोवे बोलेया था, से तिने पूरा बी कित्तेया ओर आऊँ आपणे बाओ दाऊदो री जगा पाँदे उठी की यहोवे रे वचनो रे मुताबिक इस्राएलो री गद्दिया पाँदे राजे रे रूपो दे विराजमान ए ओर इस्राएलो रे परमेशर यहोवे री महिमा खे ये मन्दर बणाया। <verse eid="2CH 6:10" /><verse number="11" style="v" sid="2CH 6:11" />इदे मैं से सन्दूक राखी ता रा, जिदे यहोवे री से वाचा ए, जो तिने इस्राएली लोका साथे बानी थी।<verse eid="2CH 6:11" /></para>
  <para style="s">मन्दरो दे सुलैमानो री प्रार्थना</para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 6:12" />तेबे से इस्राएलो री सारी सभा रे सामणे यहोवे री बेदिया सामणे खड़ा ऊआ ओर आपणे आथ फैलाए। <verse eid="2CH 6:12" /><verse number="13" style="v" sid="2CH 6:13" />सुलैमाने साडे सात फुट लाम्बी, साडे सात फुट चौड़ी ओर साडे चार फुट ऊच्ची पीतल़ी री एक चौकी बणाई की आँगणो बीचे रखाई थी; तेते पाँदे ई खड़े ऊई की तिने सारी इस्राएली सभा सामणे जानू थाले करी की स्वर्गो रिया तरफा खे आथ फैलाई की प्रार्थना करने लगेया, <verse eid="2CH 6:13" /><verse number="14" style="v" sid="2CH 6:14" />“ओ यहोवा, ओ इस्राएलो रे परमेशर, तां जेड़ा ना तो कोई स्वर्गो रे ओर ना कोई तरतिया पाँदे परमेशर ए, तेरे जो दास आपणे सारे मनो ते आपू खे तां सामणे जाणी की हांडोए, तिना रिया तँईं तूँ आपणी वाचा पूरी करेया ओर करूणा करदा रया। <verse eid="2CH 6:14" /><verse number="15" style="v" sid="2CH 6:15" />तैं जो वादा मेरे बाओ दाऊदो साथे कित्तेया था, तैं से पूरा कित्तेया, जेड़ा तैं आपणे मुंए ते बोलेया था, तेड़ा ई आपणे आथो साथे से म्हारी आखी सामणे पूरा बी कित्तेया।” <verse eid="2CH 6:15" /><verse number="16" style="v" sid="2CH 6:16" />इजी री खातर एबे ओ इस्राएलो रे यहोवा परमेशर एस वादे खे बी पूरा कर, जो तैं आपणे दास मेरे बाओ दाऊदो ते कित्तेया था, “तेरे कुलो रे मां सामणे इस्राएलो री गद्दिया पाँदे राजे रे जेड़े विराजणे वाल़े सदा बणे दे रणे, एड़ा ओ कि जेड़ा तूँ आपू खे मेरे सामणे जाणी की चलदा रया, तेड़े ई तेरे कुलो रे लोक आपणे चाल-चलणो दे एड़ी चौकसी करो कि मेरे बिधानो पाँदे चलो।” <verse eid="2CH 6:16" /><verse number="17" style="v" sid="2CH 6:17" />एबे ओ इस्राएलो रे यहोवा परमेशर जो वचन तैं आपणे परोसे जोगे दास दाऊदो खे दित्तेया था, से पूरा कित्तेया जाओ। <verse eid="2CH 6:17" /><verse number="18" style="v" sid="2CH 6:18" />पर क्या परमेशरो सच ई माणूंआ साथे तरतिया पाँदे रणे खे आऊणा? स्वर्गो दे बल्कि सबी ते ऊच्चे स्वर्गो रे बी तूँ नि समांदा, फेर मेरे बणाए रे एस मन्दरो दे तूँ किंयाँ समाणा? <verse eid="2CH 6:18" /><verse number="19" style="v" sid="2CH 6:19" />तेबे बी ओ मेरे यहोवा परमेशर, आपणे दासो री प्रार्थना ओर गिड़गिड़ाणे रिया तरफा खे त्यान दे ओर मेरी आका ओर ये प्रार्थना सुण, जो आऊँ तां सामणे करने लगी रा। <verse eid="2CH 6:19" /><verse number="20" style="v" sid="2CH 6:20" />से ये कि तेरिया आखी एस मन्दरो रिया तरफा खे, मतलब एसा ई जगा खे जेतेरे बारे दे तैं बोलेया था कि मां तिदे आपणा नाओं राखणा, दिन-रात खुलिया रओ ओर जो प्रार्थना तेरा दास एसा जगा रिया तरफा खे करो, तेसा खे तूँ सुणी लो। <verse eid="2CH 6:20" /><verse number="21" style="v" sid="2CH 6:21" />ओर आपणे दास ओर आपणी इस्राएली प्रजा री प्रार्थना जो सेयो एसा जगा रिया तरफा खे मूँ करी की गिड़गिड़ाई की करो, तेसा खे सुणी लया; स्वर्गो ते जो तेरी रणे री जगा ए, सुणी लया ओर सुणी की माफ करेया। <verse eid="2CH 6:21" /><verse number="22" style="v" sid="2CH 6:22" />जेबे कोई माणूं केसी दूजे रे खलाफ अपराध करो ओर तेसखे कसम खुल़ाई जाओ ओर से आई की एस मन्दरो दे तेरी बेदिया सामणे कसम खाओ, <verse eid="2CH 6:22" /><verse number="23" style="v" sid="2CH 6:23" />तेबे तैं स्वर्गो ते सुणनी ओर मानणी ओर आपणे दासो रा न्याय करी की दुष्टा ते बदला लणा ओर तेसरी चाल तेसरे ई सिरो पाँदे वापस करी देणी ओर निर्दोषो खे, निर्दोष ठराई की, तेसरे तर्मो रे मुताबिक तेसखे फल देणा।<verse eid="2CH 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 6:24" />ओर जेबे तेरे इस्राएली लोक तेरे खलाफ पाप करने रिया बजा ते आपणे दुश्मणा ते अरी जाओ, ओर केसी दूजे देशो खे जाणे खे मजबूर ऊई जाओ, तेबे जे सेयो आपणे पापो खे मानी की तिजी ते फिरी जाओ ओर एस मन्दरो रिया तरफा खे फिरी जाओ ओर ये मानी लो कि तैं तिना खे ठीक सजा देई राखी, ओर बिनती करो कि तूँ तिना खे माफ करी देगा, <verse eid="2CH 6:24" /><verse number="25" style="v" sid="2CH 6:25" />तेबे तूँ स्वर्गो ते तिना री प्रार्थना सुणेया ओर आपणे इस्राएली लोका रा पाप माफ करेया ओर सेयो एते देशो दे वापस ली आऊणे, जो तैं तिना खे ओर तिना रे बुजुर्गा खे देई राखेया। <verse eid="2CH 6:25" /><verse number="26" style="v" sid="2CH 6:26" />जेबे सेयो तेरे खलाफ पाप करो ओर इजी बजा ते सर्ग इतणा बन्द ऊई जाओ कि बर्खा नि ओ, एड़े बखते जे सेयो एसा ई जगा रिया तरफा खे प्रार्थना करी की तेरे नाओं खे मानो ओर तूँ जो तिना खे दु:ख देया, इजी बजा ते सेयो आपणे पापो ते फिरो, <verse eid="2CH 6:26" /><verse number="27" style="v" sid="2CH 6:27" />तो तूँ स्वर्गो ते तिना री प्रार्थना सुणेया ओर आपणे दासा खे ओर आपणे इस्राएली लोका रे पापा खे माफ करेया; तूँ जो तिना खे से खरी बाट दखाएया, जेते पाँदे तिना खे चलणा चाईयो, इजी री खातर आपणे एस देशो पाँदे जो तैं आपणी प्रजा रा इस्सा करी की देई राखेया, पाणी बरसाई देया।<verse eid="2CH 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2CH 6:28" />जेबे एते देशो रे अकाल़ या मरी, जल़न, गेरुई या टिड्डिया या कीड़े लगो या तिना रे दुश्मण तिना रे देशो रे बड़े द्वारो दे तिना खे केरी देयो, या कोई मुसीबत या बमारी ओ; <verse eid="2CH 6:28" /><verse number="29" style="v" sid="2CH 6:29" />तेबे जे कोई माणूं या तेरी सारी‍ प्रजा इस्राएल जो आपणा-आपणा दु:ख जाणी की ओर गिड़गिड़ाई की प्रार्थना करी की आपणे आथ एस मन्दरो रिया तरफा खे फैलाओ; <verse eid="2CH 6:29" /><verse number="30" style="v" sid="2CH 6:30" />तेबे तैं आपणे स्वर्गिय रणे रिया जगा ते सुणी की माफ करना ओर एकी-एकी रे मनो री जाणी की तेसरी चाला रे मुताबिक तेसखे फल देणा, तूँ ई तो माणूंआ रे मनो खे जागणे वाल़ा ए; <verse eid="2CH 6:30" /><verse number="31" style="v" sid="2CH 6:31" />ताकि सेयो जितणे दिन तक एते देशो रे रओ, जो तैं तिना रे बुजुर्गा खे दित्तेया था, तितणे दिन तक तेरा डर मानदे ऊए तेरी बाटा रे चलदे रओ।<verse eid="2CH 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 6:32" />तेबे परदेशी बी जो तेरी इस्राएली प्रजा रा नि आ, जेबे से तेरे बड़े नाओं, तागतबर आथ ओर बडाई री बांयी रिया बजा ते दूर देशो ते आओ ओर आई की एस मन्दरो रिया तरफा खे मूँ करी की प्रार्थना करो, <verse eid="2CH 6:32" /><verse number="33" style="v" sid="2CH 6:33" />तेबे तूँ आपणे स्वर्गो दे रणे री जगा ते तिना री प्रार्थना सुणेया ओर जेसा गल्ला खे से परदेशी ताखे आका पाओ, तेतेरे मुताबिक करेया; जेते कि तरतिया रे सबी देशा रे लोक तेरा नाओं जाणी की, तेरी इस्राएली प्रजा जेड़े तेरा डर मानो ओर निश्चा करो कि ये मन्दर जो मैं बणाई राखेया, से तेरा ईए।<verse eid="2CH 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2CH 6:34" />जेबे तेरी प्रजा रे लोक जेती-केथी तूँ तिना खे पेजे तेती आपणे दुश्मणा साथे लड़ाई करने खे निकल़ी जाओ ओर तेस शईरो रिया तरफा खे जो तैं चूणी राखेया ओर एस मन्दरो रे कनारे जो मैं तेरे नाओं रा बणाई राखेया, मूँ करी की तांते प्रार्थना करो, <verse eid="2CH 6:34" /><verse number="35" style="v" sid="2CH 6:35" />तेबे तैं स्वर्गो ते तिना री प्रार्थना ओर गिड़गिड़ाणा सुणना ओर तिना रा न्याय करना। <verse eid="2CH 6:35" /><verse number="36" style="v" sid="2CH 6:36" />निष्पाप तो कोई माणूं नि ए, जे सेयो बी तेरे खलाफ पाप करो ओर तूँ तिना पाँदे रोष करी की तिना खे दुश्मणा रे आथो दे करी दे ओर सेयो दुश्मण तिना खे बन्दी बणाई की केसी देशो खे, चाए से दूर ओ, चाए नेड़े, लई जाओ, <verse eid="2CH 6:36" /><verse number="37" style="v" sid="2CH 6:37" />तो जे सेयो बन्दुआईया रे देशो दे जाई की सोच-बिचार करो ओर फिरी कि आपणे बन्दी बनाणे वाल़े रे देशो दे तांते गिड़गिड़ाई की बोलो, “आसे पाप करी राखेया ओर बुराई ओर दुष्टता करी राखी” <verse eid="2CH 6:37" /><verse number="38" style="v" sid="2CH 6:38" />इजी री खातर सेयो जे आपणे बन्दुआईया रे देशो रे जेती सेयो तिना खे बन्दी बणाई की लईगे ओ आपणे पूरे मन ओर सारे प्राणो ते तेरी तरफा खे फिरो ओर आपणे एस देशो रिया तरफा खे जो तैं तिना रे बुजुर्गा खे दित्तेया था ओर एस शईरो रिया तरफा खे जो तैं चूणी राखेया ओर एस मन्दरो रिया तरफा खे जो मैं तेरे नाओं रा बणाई राखेया, मूँ करी की प्रार्थना करो, <verse eid="2CH 6:38" /><verse number="39" style="v" sid="2CH 6:39" />तेबे तैं आपणे स्वर्गो दे रणे रिया जगा ते तिना री प्रार्थना ओर गिड़गिड़ाणा सुणना ओर तिना रा न्याय करना ओर जो पाप तेरी प्रजा रे लोक तेरे खलाफ करो, तिना खे माफ करना। <verse eid="2CH 6:39" /><verse number="40" style="v" sid="2CH 6:40" />ओ मेरे परमेशर! जो प्रार्थना एते जगा दे करी जाओ तेसरी तरफा खे आपणिया आखी खोली की राख ओर आपणे कान लगाई की राख।<verse eid="2CH 6:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="2CH 6:41" />एबे, ओ यहोवा परमेशर, उठी की आपणी सामर्था रे सन्दूको समेत आपणी रामो री जगा दे आओ,</para>
  <para style="q" vid="2CH 6:41">ओ यहोवा परमेशर तेरे पुरोईत उद्धारो रे टाल्ले पईनी की राखो</para>
  <para style="q" vid="2CH 6:41">ओर तेरे परोसे वाल़े पग्त पलाईया रिया बजा ते खुशी मनांदे रओ।<verse eid="2CH 6:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="2CH 6:42" />ओ यहोवा परमेशर, आपणे अभिषिक्तो री प्रार्थना अणसुणी नि कर,</para>
  <para style="q" vid="2CH 6:42">तूँ आपणे दास दाऊदो पाँदे कित्ती री दया रे काम याद राख।<verse eid="2CH 6:42" /></para>
  <chapter eid="2CH 6" />
  <chapter number="7" style="c" sid="2CH 7" />
  <para style="s">मन्दरो दे परमेशरो री महिमा</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 7:1" />जेबे सुलैमान ये प्रार्थना परमेशरो ते करी चुकेया, तेबे स्वर्गो ते आग निकल़ी की होमबलि ओर बाकी बलिया फूकी तिया ओर यहोवे रा तेज मन्दरो दे परी गा। <verse eid="2CH 7:1" /><verse number="2" style="v" sid="2CH 7:2" />पुरोईत यहोवे रे मन्दरो दे नि जाई सके, कऊँकि यहोवे रा तेज मन्दरो दे परी गा था। <verse eid="2CH 7:2" /><verse number="3" style="v" sid="2CH 7:3" />ओर जेबे आग निकल़ी ओर यहोवे रा तेज मन्दरो पाँदे छाईगा, तेबे सारे इस्राएली देखदे रये ओर मेल्ले दे पड़ी की आपणा-आपणा मूँ जमीना रिया तरफा खे करी की माथा टेकेया ओर ईंयाँ बोली की यहोवे रा तन्यवाद कित्तेया, “यहोवा पला ए, तेसरी करूणा सदा री ए।”<verse eid="2CH 7:3" /></para>
  <para style="s">बलिया रा चढ़ाया जाणा</para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 7:4" />तेबे सारी प्रजा समेत राजे यहोवे खे ओर बलि चढ़ाई। <verse eid="2CH 7:4" /><verse number="5" style="v" sid="2CH 7:5" />सुलैमान राजे 22,000 बल़द ओर 120,000 पेडा-बाकरिया चढ़ाईया। ईंयाँ पूरी प्रजा समेत राजे यहोवे रे मन्दरो री प्रतिष्ठा कित्ती। <verse eid="2CH 7:5" /><verse number="6" style="v" sid="2CH 7:6" />तेबे पुरोईत आपणा-आपणा काम करने के खड़े रये ओर लेविये बी यहोवे रा गीत गाणे खे बाजे लई की खड़ी रे थे, जो दाऊद राजे यहोवे री सदा री करूणा रिया बजा ते तेसरा तन्यवाद करने खे बणाई की तिना रे जरीये स्तुति कराई थी ओर तिना सामणे पुरोईत लोक तुरहिया बजांदे रये ओर सारे इस्राएली खड़े रये। <verse eid="2CH 7:6" /><verse number="7" style="v" sid="2CH 7:7" />तेबे सुलैमाने यहोवे रे मन्दरो रे सामणे आँगणो बीचे एक जगा पवित्र करी की होमबलि ओर मेलबलिया री चर्बी तेथी चढ़ाई, कऊँकि सुलैमानो री बणाई री पीतल़ी री बेदी होमबलि ओर नज्जो री बलिया री चर्बिया खे छोटी थी।<verse eid="2CH 7:7" /></para>
  <para style="s">त्यागो रा त्यार</para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 7:8" />तेस ई बखते सुलैमाने ओर तेस साथे हमातो री काट्टिया ते लई की मिस्रो रे नाल़े तको रे सारे इस्राएलो रे लोके साता दिना तक चूँगड़िया रा त्यार मनाया। <verse eid="2CH 7:8" /><verse number="9" style="v" sid="2CH 7:9" />ओर आठुए दिने तिने सबी मिली की एक बड़ी सभा कित्ती, तिने बेदिया री प्रतिष्ठा सात दिन तक कित्ती ओर त्यार बी साता दिना तक मनांदे रये। <verse eid="2CH 7:9" /><verse number="10" style="v" sid="2CH 7:10" />सातुए मीन्ने रे तेईए दिने तिने प्रजा रे लोक बिदा कित्ते कि सेयो आपणे-आपणे डेरे खे जाओ ओर सेयो तेसा पलाईया रिया बजा ते जो यहोवे दाऊद ओर सुलैमान ओर आपणी प्रजा इस्राएलो पाँदे कित्ती थी खुश थे।<verse eid="2CH 7:10" /></para>
  <para style="s">परमेशरो रा वादा ओर चतौणी</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 7:11" />ईंयाँ राजा सुलैमान परमेशरो रा मन्दर ओर राजमईलो खे बनाणे रा काम पूरा कित्तेया ओर यहोवे रे मन्दरो दे ओर आपणे मईलो दे जो कुछ तिने बनाणा चाया, तिदे तेसरे मनो री इच्छा पूरी ऊई। <verse eid="2CH 7:11" /><verse number="12" style="v" sid="2CH 7:12" />तेबे यहोवे राती तेसखे दर्शण देई की तेसखे बोलेया, “मैं तेरी प्रार्थना सुणी ओर ये जगा हर तरआ रे बलिदानो खे देई राखी। <verse eid="2CH 7:12" /><verse number="13" style="v" sid="2CH 7:13" />जे आऊँ केसी दिने सर्गो खे एड़ा बन्द करुँ कि बर्खा नि ओ या टिड्डिया खे देश उजाड़ने खे बोलूँ या आपणी‍ प्रजा दे बमारी फैलाऊँ, <verse eid="2CH 7:13" /><verse number="14" style="v" sid="2CH 7:14" />तेबे जे मेरी प्रजा रे लोक जिना खे मेरे बोलोए, दीन ऊई की प्रार्थना करो ओर मेरे दर्शणो खे टोल़ो ओर आपणी बुरी चाला ते फिरो, तो मां स्वर्गो ते सुणी की तिना रे पाप माफ करने ओर तिना रा देश जेड़ा पईले फसल पैदा करो था तेड़ा ई फेर फसल पैदा करने वाल़ा बणाई देणा।” <verse eid="2CH 7:14" /><verse number="15" style="v" sid="2CH 7:15" />आजो ते लई की जो प्रार्थना मांते एते जगा दे करी जाणी, तिना रिया तरफा खे मां त्यान देणा ओर सेयो प्रार्थना मां सुणनिया। <verse eid="2CH 7:15" /><verse number="16" style="v" sid="2CH 7:16" />कऊँकि एबे ये मन्दर मेरा ए ओर मैं ये पवित्र करी राखेया ए, ओर एथी हमेशा खे मेरी आराधना ऊँदी रणी, मां एसा जगा ते कदी बी आपणिया आखी ओर कान नि फेरने। <verse eid="2CH 7:16" /><verse number="17" style="v" sid="2CH 7:17" />जे तूँ आपणे बाओ दाऊदो जेड़ा आपू खे मां सामणे जाणी की चलदा रये ओर मेरिया सारिया आज्ञा रे मुताबिक करेया करे ओर मेरी बिधिया ओर नियम मानदा रये, <verse eid="2CH 7:17" /><verse number="18" style="v" sid="2CH 7:18" />तो मां तेरी राजगद्दी बणाई दी राखणी; जेड़ा कि मैं तेरे बाओ दाऊदो साथे वादा कित्तेया था कि तेरे कुलो रा कोई ना कोई इस्राएलो पाँदे राज करने वाल़ा सदा बणेया रा रणा। <verse eid="2CH 7:18" /><verse number="19" style="v" sid="2CH 7:19" />यहोवा आगे बोलोआ, “पर जे तुसे लोक मांते फिरो ओर मेरी बिधिया ओर आज्ञा जो मैं तुसा खे देई राखिया मानणा छाडो ओर जाई की पराये देवतेया री आराधना करो ओर तिना गे माथा टेको, <verse eid="2CH 7:19" /><verse number="20" style="v" sid="2CH 7:20" />तो मां सेयो आपणे देशो ते जो मैं तिना खे देई राखेया, जड़ी ते पटी देणे ओर ये मन्दर जो मैं आपणियां तँईं पवित्र करी राखेया, आपणी नजरा ते दूर करना ओर एड़ा करना कि देशो-देशो रे लोका बीचे तेतेरा उदारण बोली की बेज्जती ऊणी।” <verse eid="2CH 7:20" /><verse number="21" style="v" sid="2CH 7:21" />ये मन्दर जो इतना बड़ा ए, तिसिये आऊणे-जाणे वाल़ेया हैरान ऊई कि पूछणे, “यहोवे एस देशो साथे ओर एस मन्दरो साथे एड़ी खतरनाक गल्ल कऊँ करी राखी?” <verse eid="2CH 7:21" /><verse number="22" style="v" sid="2CH 7:22" />तेबे ओरी लोका बोलणा कि इस्राएली लोके आपणे पितरा रे परमेशर यहोवे खे जो तिना खे मिस्र देशो ते निकयाल़ी कि ल्याया था छाडी की पराये देवता माने ओर तिना गे माथा टेकी की तिना री आराधना कित्ती, इजी बजा ते ये सारी मुसीबत तिना पाँदे पड़ी।<verse eid="2CH 7:22" /></para>
  <chapter eid="2CH 7" />
  <chapter number="8" style="c" sid="2CH 8" />
  <para style="s">सुलैमानो रे ओर काम</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 8:1" />सुलैमानो खे यहोवे रा मन्दर ओर आपणा मईल बनाणे खे बीई साल लगे। <verse eid="2CH 8:1" /><verse number="2" style="v" sid="2CH 8:2" />तेबे जो शईर सुलैमानो खे हीराम राजे दित्ते थे, सेयो सुलैमाने मजबूत करी की तिना दे इस्राएली लोक बसाए। <verse eid="2CH 8:2" /><verse number="3" style="v" sid="2CH 8:3" />तेबे सुलैमाने सोबा शईरो रे हमात जगा पाँदे अमला करी की, से जीतेया। <verse eid="2CH 8:3" /><verse number="4" style="v" sid="2CH 8:4" />तिने तदमोर शईर जो उजाड़ जगा दे ए ओर हमात इलाके रे सारे पण्डारा रे शईर मजबूत कित्ते। <verse eid="2CH 8:4" /><verse number="5" style="v" sid="2CH 8:5" />तेबे तिने पाँदले बेथोरोन ओर थालले बेथोरोन शईरो दे दवाला ओर दरवाजे लगाई की से मजबूत कित्ते। <verse eid="2CH 8:5" /><verse number="6" style="v" sid="2CH 8:6" />तिने बालात शईर ओर सुलैमानो रे जितणे पण्डारा रे शईर थे ओर तेसरे रथ ओर सवारा रे जितणे शईर थे ओर जो कुछ सुलैमाने यरूशलेम, लबानोन ओर आपणे राज्य रे सारे देशो दे बनाणा चाया, से सारे बणाये।<verse eid="2CH 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 8:7" />हित्ती, एमोरी, परिज्जी, हिब्बी ओर यबूसिया रे बचे रे लोक जो इस्राएलो दे रओ थे, पर सेयो इस्राएली नि थे, <verse eid="2CH 8:7" /><verse number="8" style="v" sid="2CH 8:8" />तिना रे कुल जो तिना ते बाद देशो दे रई गे ओर जिना रा इस्राएलिये नाश नि कित्तेया था, तिना बीचा ते कई जणे सुलैमाने आपणे देशो देई कामो पाँदे राखे ओर आजो तक तिना री सेई दशा ए। <verse eid="2CH 8:8" /><verse number="9" style="v" sid="2CH 8:9" />पर इस्राएली लोका बीचा ते सुलैमाने आपणे कामो खे कोई बी दास नि बणाया, सेयो तो योद्धा ओर तेसरे परदान, तेसरे सरदार ओर तेसरे रथ ओर सवारा रे परदान बणे। <verse eid="2CH 8:9" /><verse number="10" style="v" sid="2CH 8:10" />सुलैमानो रे सरदारा रे परदान जो प्रजा रे लोका पाँदे राज करने वाल़े थे, सेयो 250 परदान थे।<verse eid="2CH 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 8:11" />तेबे सुलैमान फिरौनो री बेटिया खे दाऊदो रे शईरो ते तेते मईलो दे ली आया जो तिने तेसा खे बणवाया था, कऊँकि तिने बोलेया, “जेते-जेते जगा दे यहोवे रा सन्दूक आई रा, से पवित्र ए, इजी री खातर मेरी राणी इस्राएलो रे राजा दाऊदो रे मईलो दे नि रणी।” <verse eid="2CH 8:11" /><verse number="12" style="v" sid="2CH 8:12" />तेबे सुलैमानो रे काम करने वाल़ेया यहोवे री तेसा बेदिया पाँदे जो तिने बरांडे ते आगे बणाई थी, यहोवे खे होमबलि चढ़ाई। <verse eid="2CH 8:12" /><verse number="13" style="v" sid="2CH 8:13" />से मूसे री आज्ञा ओर हर रोजके नियमो रे मुताबिक, मतलब राम ओर नवां चाँद ओर हर साल तीन बार ठराए रे त्यार, मतलब बिना सजेड़े री रोटिया रे त्यार, अफ्तेया रे त्यार ओर चूँगड़िया रे त्योआरो दे बलि चढ़ाया करो था। <verse eid="2CH 8:13" /><verse number="14" style="v" sid="2CH 8:14" />तिने आपणे बाओ रे नियमो रे मुताबिक पुरोईता री सेवकाईया खे तिना रे दल ठराए ओर लेवी तिना रे कामो खे ठराए, ताकि हर एकी दिनो रे कामो रे मुताबिक सेयो यहोवे री स्तुति ओर पुरोईता सामणे सेवा-टईल करेया करो ओर एक-एक बड़े द्वारो गे द्वारपाल दल-दल करी की ठराईते; कऊँकि परमेशरो रे भग्त दाऊदे एड़ी आज्ञा दित्ती थी। <verse eid="2CH 8:14" /><verse number="15" style="v" sid="2CH 8:15" />राजे रे पण्डार या केसी ओर गल्ला रे बारे रे पुरोईता ओर लेविया खे जो-जो आज्ञा दित्ती थी, तिने से नि टाल़ी।<verse eid="2CH 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 8:16" />सुलैमानो रा सारा काम जो तिने यहोवे रे मन्दरो री निऊँआ बनाणे ते लई की तिजी खे पूरा करने तक कित्तेया से ठीक ऊआ। ईंयाँ यहोवे रे मन्दरो खे बनाणे रा काम पूरा ऊआ। <verse eid="2CH 8:16" /><verse number="17" style="v" sid="2CH 8:17" />तेबे सुलैमान एस्योनगेबेर ओर एलोत शईरो खे गया, जो एदोम देशो रे समुद्रो रे कनारे ए। <verse eid="2CH 8:17" /><verse number="18" style="v" sid="2CH 8:18" />हीरामे तेसगे आपणे जाह्जिया रे जरीये जाह्ज ओर समुद्रो रे जाणकार मल्लाह पेजी ते ओर तिने सुलैमानो रे जाह्जिया साथे ओपीर जगा दे जाई की तेथा ते लगभग 15,000 किलो सूईना सुलैमान राजे खे दित्तेया।<verse eid="2CH 8:18" /></para>
  <chapter eid="2CH 8" />
  <chapter number="9" style="c" sid="2CH 9" />
  <para style="s">शेबा री राणिया रा सुलैमानो ते मिलणा</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 9:1" />जेबे शेबा री राणिये सुलैमानो री कीर्ति सुणी, तेबे से कठण-कठण प्रश्ना साथे तेसरी परीक्षा करने खे यरूशलेम शईरो खे चली गी। से बऊत बड़ा दल ओर मसाले ओर बऊत सूईना ओर मणिया साथे लादे रे ऊँट साथे लई की यरूशलेम शईरो खे आई ओर सुलेमानो गे पऊँची की तेस साथे आपणे मनो री सारिया गल्ला रे बारे दे गल्ला कित्तिया। <verse eid="2CH 9:1" /><verse number="2" style="v" sid="2CH 9:2" />सुलैमाने तेसा रे सबी प्रश्ना रे ज्वाब दित्ते, कोई गल्ल सुलैमानो री बुद्धिया ते एड़ी बारे नि रई कि से तिजी खे नि बताई सकेया। <verse eid="2CH 9:2" /><verse number="3" style="v" sid="2CH 9:3" />जेबे शेबा री राणिये सुलैमानो री बुद्धि ओर तेसरा बणाया रा मईल, <verse eid="2CH 9:3" /><verse number="4" style="v" sid="2CH 9:4" />से तेस खाने खे देखी की बऊत ई हैरान थी जो तेसे मेजो पाँदे देखेया था, ओर तेसरे कर्मचारी किंयाँ मेजो पाँदे बैठोए ओर तेसरी सेवा करने वाल़े सेवक किंयाँ खड़े रओए, ओर केड़े-केड़े टाल्ले पईनी राखोए, ओर तेसरे पल्याणे वाल़े केड़े ए, ओर सेयो केड़े टाल्ले पईनोए ओर से केड़ी चढ़ाई ए जिदे से यहोवे रे मन्दरो दे बलिदान चढ़ाणे खे जाओआ, जेबे तेसे ये सब देखेया, तेबे से हैरान ऊई। <verse eid="2CH 9:4" /><verse number="5" style="v" sid="2CH 9:5" />तेबे तेसे राजे खे बोलेया, “मैं तेरे कामो री ओर तेरी अक्ला री जो कीर्ति आपणे देशो रे सुणी से सच्च ईए। <verse eid="2CH 9:5" /><verse number="6" style="v" sid="2CH 9:6" />पर जदुओ तक मैं आपू आई की आपणी आखी ते ये नि देखेया, तदुओ तक मैं तिना रा परोसा नि कित्तेया; बल्कि तेरी बुद्धिया री आदी तारीफ बी माखे नि बताई थी; तूँ तेसा कीर्तिया ते बढ़ी की ए जो मैं सुणी थी। <verse eid="2CH 9:6" /><verse number="7" style="v" sid="2CH 9:7" />तन्य ए इस्राएलो रे माणूं, तन्य ए तेरे यो सेवक, जो हर रोज तां सामणे आजीर रई की तेरी बुद्धिया रिया गल्ला सुणोए। <verse eid="2CH 9:7" /><verse number="8" style="v" sid="2CH 9:8" />तन्य ए तेरा यहोवा परमेशर, जो तांते एड़ा खुश ऊआ कि तूँ आपणी राजगद्दिया पाँदे इजी खे बठयाल़ेया कि तूँ आपणे परमेशर यहोवे री तरफा ते राज करे; तेरा परमेशर जो इस्राएलो साथे प्यार करी की तिना खे सदा खे स्थिर करना चाओ था, इजी बजा ते तिने तूँ न्याय ओर तर्म करने खे तिना रा राजा बणाया।” <verse eid="2CH 9:8" /><verse number="9" style="v" sid="2CH 9:9" />ये सब बोलणे ते बाद तेसे राजे खे लगभग 4,500 किलो सूईना, बऊत सारा खुशबूदार द्रव्य ओर मणि दित्ते, जेड़े खुशबूदार द्रव्य शेबा री राणिये सुलैमान राजे खे दित्ते, तेड़े देखणे दे पनि आए। <verse eid="2CH 9:9" /><verse number="10" style="v" sid="2CH 9:10" />तेबे हीराम ओर सुलैमान दुँईं रे जाह्जी जो ओपीरो ते सूईना ल्याओ थे, सेयो चन्दनो री लकड़ी ओर मणि बी ल्याओ थे। <verse eid="2CH 9:10" /><verse number="11" style="v" sid="2CH 9:11" />राजे चन्दनो री लकड़िया साथे यहोवे रा मन्दर ओर राजमईलो खे चबूतरे ओर गाणेवाल़ेया खे बीणा ओर सारंगिया बणवाईया; एड़ी चीजा तेसते पईले यहूदा प्रदेशो रे नि देखिया थिया। <verse eid="2CH 9:11" /><verse number="12" style="v" sid="2CH 9:12" />फेर शेबा री राणिये जो कुछ चाया सेई सुलैमान राजे तेसा री इच्छा रे मुताबिक दित्तेया; ये तेसते जादा था, जो से राजे गे ल्याई थी। तेबे से आपणे माणूंआ समेत आपणे देशो खे वापस ऊई गी।<verse eid="2CH 9:12" /></para>
  <para style="s">सुलैमानो रा तअन ओर शक्ति</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 9:13" />जो सूईना हर साल सुलैमानो गे पऊँचेया करो था, तिजी रा बजन लगभग 23,000 किलो था। <verse eid="2CH 9:13" /><verse number="14" style="v" sid="2CH 9:14" />ये तिजी ते जादा था जो सौदागर ओर बपारी ल्याओ थे ओर अरब देशो रे सारे राजा ओर देशो रे सेनापति बी सुलैमानो गे सूईना-चाँदी ल्याओ थे। <verse eid="2CH 9:14" /><verse number="15" style="v" sid="2CH 9:15" />सुलैमान राजे सूईना कअड़ाई की 200 बड़ी-बड़ी ढाला बणवाईया; एक-एक ढाली दे साडे तीन किलो सूईना लगेया। <verse eid="2CH 9:15" /><verse number="16" style="v" sid="2CH 9:16" />तेबे तिने सूईना कअड़ाई की 300 छोटी ढाला ओर बी बणवाईया, एक-एक छोटी ढाला दे लगभग दो किलो सूईना लगेया, ओर राजे सेयो लबानोनी बण नाओं रे मईलो दे राखी तिया। <verse eid="2CH 9:16" /><verse number="17" style="v" sid="2CH 9:17" />राजे आथी दाँदो रा एक बड़ा सिंहासन बणवाया ओर शुद्ध सूईने साथे मढ़वाया। <verse eid="2CH 9:17" /><verse number="18" style="v" sid="2CH 9:18" />तेते सिंहासनो रे छे पईड़िया ओर सूईने रा एक पायदान था; यो सब सिंहासनो साथे जुड़े रे थे ओर बैठणे री जगा रे दुँईं तरफा खे टासणे लगी रे थे ओर दुँईं टासणेया गे एक-एक शेरो री मूर्ति बणाई राखी थी। <verse eid="2CH 9:18" /><verse number="19" style="v" sid="2CH 9:19" />छे पईड़िया री दुँईं तरफा खे एक-एक शेर खड़ेया रा बणी रा था, सेयो सारे बारा थे। केसी राज्य दे एड़ा सिंहासन कदी नि बणेया। <verse eid="2CH 9:19" /><verse number="20" style="v" sid="2CH 9:20" />सुलैमान राजे रे पीणे रे सारे पांडे सूईने रे थे ओर लबानोनी बण नाओं रे मईलो रे सब पांडे बी शुद्ध सूईने रे थे, सुलैमानो रे दिना दे चाँदिए री कोई कीमत नि थी। <verse eid="2CH 9:20" /><verse number="21" style="v" sid="2CH 9:21" />कऊँकि समुद्रो दे हीरामो रे जाह्जा साथे राजा बी तर्शीशो दे जाह्ज राखो था ओर तीऊँ-तीऊँ साला तक तर्शीशो रे जाह्ज सूईना, चाँदी, आथी दाँद, बान्दर ओर मोर लई की आओ थे।<verse eid="2CH 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 9:22" />ईंयाँ सुलैमान राजा तअन ओर बुद्धिया साथे तरतिया रे सबी राजेया ते बढ़ी की ऊईगा। <verse eid="2CH 9:22" /><verse number="23" style="v" sid="2CH 9:23" />तरतिया रे सब राजा सुलैमानो री तेसा बुद्धिया री गल्ला सुणने खे, जो परमेशरे तेसरे मनो दे दित्ती थी तेसरा दर्शण करना चाओ थे। <verse eid="2CH 9:23" /><verse number="24" style="v" sid="2CH 9:24" />सेयो हर साल आपणी-आपणी पेंट, मतलब सूईने ओर चाँदिए रे पांडे, टाल्ले, शस्त्र, खुशबूदार द्रव्य, कोड़े ओर खच्चरा ल्याओ थे। <verse eid="2CH 9:24" /><verse number="25" style="v" sid="2CH 9:25" />आपणे रथो रे कोड़ेया खे सुलैमानो रे 4,000 कोड़ेया री गवाईणी ओर तिना गे 12,000 कोड़े बी थे, जो तिने रथो रे शईरो दे ओर यरूशलेम शईरो दे राजे गे राखे। <verse eid="2CH 9:25" /><verse number="26" style="v" sid="2CH 9:26" />से फरात नदिया ते लई की पलिश्तिया रे देश ओर मिस्रो रे बन्ने तको रे सबी राजेया पाँदे राज करो था। <verse eid="2CH 9:26" /><verse number="27" style="v" sid="2CH 9:27" />तेबे राजे एड़ा कित्तेया कि बऊत जादा ऊणे रिया बजा ते यरूशलेम शईरो रे चाँदिए री कीमत पात्थरा जेड़ी ओर देवदारो री कीमत थालले देशो रे गूलरा जेड़ी ऊई गी। <verse eid="2CH 9:27" /><verse number="28" style="v" sid="2CH 9:28" />सुलैमान मिस्रो ते आपू खे कोड़े ल्याया ओर बाकी सारे देशा ते बी ल्याया।<verse eid="2CH 9:28" /></para>
  <para style="s">सुलैमानो री मौत</para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 9:29" />शुरूओ ते अन्तो तक सुलैमानो रे ओर सारे कामा रे बारे दे नातान नबीए री कताबा दे ओर शीलो शईरो दे रणे वाल़े अहिय्याह री प्रचारो री कताबा रे ओर नबातो रे पाऊ राजा यारोबामो रे बारे दे इद्दो दर्शिये रे दर्शणो री कताबा दे लिखी राखे। <verse eid="2CH 9:29" /><verse number="30" style="v" sid="2CH 9:30" />सुलैमाने यरूशलेम शईरो रे सारे इस्राएली लोका पाँदे चाल़ी साल तक राज कित्तेया। <verse eid="2CH 9:30" /><verse number="31" style="v" sid="2CH 9:31" />तेबे सुलैमान मरी गा ओर से यरूशलेम शईरो री तेसा जगा दे दबाया जेतेखे दाऊदो रा शईर बोलेया जाओ था। ओर तेसते बाद तेसरा पाऊ रहूबियाम तेसरी जगा पाँदे राजा बणेया।<verse eid="2CH 9:31" /></para>
  <chapter eid="2CH 9" />
  <chapter number="10" style="c" sid="2CH 10" />
  <para style="s">इस्राएलो रे राज्य रे दो इस्सा ऊई जाणे</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 10:1" />तेबे रहूबियाम शकेम शईरो खे गया, कऊँकि सारे इस्राएली तेसखे राजा बनाणे खे तेथी गये थे। <verse eid="2CH 10:1" /><verse number="2" style="v" sid="2CH 10:2" />जेबे नबातो रे पाऊ यारोबामे ये सुणेया, कऊँकि से तो मिस्र देशो दे रओ था, जेती से सुलैमान राजे रे डरो रे मारे नठी गा था तेबे से मिस्रो ते वापस आई गा। <verse eid="2CH 10:2" /><verse number="3" style="v" sid="2CH 10:3" />इस्राएलो रे उत्तरी इस्से रे लोके यारोबामो गे दूत पेजे; तेबे यारोबाम ओर सारी इस्राएली प्रजा नवें राजा रहूबियामो ते मिलणे खे गई। ओर बोलणे लगे, <verse eid="2CH 10:3" /><verse number="4" style="v" sid="2CH 10:4" />“तेरे बाओ राजा सुलैमाने तो आसा ते पारी काम करवाया ए, पर जे तूँ आसा रा काम अल़्का करी दे तो आसा तां ई साथे रणा ओर जेड़ा तूँ बोले तेड़ा ई आसा सेवा करनी।” <verse eid="2CH 10:4" /><verse number="5" style="v" sid="2CH 10:5" />रहूबियामे तिना सबी खे बोलेया, “तीऊँ दिना ते बाद मांगे फेर आऊणा।” तेबे सेयो चली गे।<verse eid="2CH 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 10:6" />तेबे रहूबियाम राजे तिना स्याणेया ते जो तेसरे बाओ सुलैमानो री पूरी जिन्दगी तेस सामणे आजीर रया करो थे, ये बोली की सलाह् लई, “एसा प्रजा खे केड़ा ज्वाब देणा ठीक ए, इदे तुसे क्या सलाह् देओए?”<verse eid="2CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 10:7" />तिने तेसखे ये ज्वाब दित्तेया, “जे तूँ एसा प्रजा रे लोका साथे अच्छा बर्ताओ करी की तिना खे खुश करे ओर तिना खे मीठिया गल्ला बोले, तेबे सेयो सदा तेरे वशो दे बणे रे रणे।” <verse eid="2CH 10:7" /><verse number="8" style="v" sid="2CH 10:8" />पर तिने से सलाह् जो स्याणेया तेसखे दित्ती थी छाडी ती ओर तिना जवाना ते सलाह् लई, जो तेस साथे बड़े ऊए थे ओर तेस सामणे आजीर रया करो थे। <verse eid="2CH 10:8" /><verse number="9" style="v" sid="2CH 10:9" />तिना ते तिने पूछेया, “आऊँ प्रजा रे लोका खे केड़ा ज्वाब देऊँ, इदे तुसे क्या बोलोए? तिने तो माखे बोलेया था कि जो पारी काम तेरे बाओए आसा ते कराई राखे, तिजी खे तूँ अल़्का कर।” <verse eid="2CH 10:9" /><verse number="10" style="v" sid="2CH 10:10" />जवाने जो तेस साथे बड़े ऊए थे तेसखे ये ज्वाब दित्तेया, “तिने लोके ताखे बोली राखेया कि तेरे बाओए आसा ते पारी काम कराई राखेया था, पर तिजी खे आसा खे अल़्का कर।” तैं तिना खे ईंयाँ बोलणा, “जे मेरा बाओ सेर था तो आऊँ सवा सेर आ। <verse eid="2CH 10:10" /><verse number="11" style="v" sid="2CH 10:11" />मेरे बाओए तुसा ते जो पारी काम कराई राखेया था, से मां ओर बी पारी करना; मेरा बाओ तो तुसा खे कोड़ेया साथे सजा देयो था, पर मां कांडेया वाल़े डण्डे साथे सजा देणी।”<verse eid="2CH 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 10:12" />तीजे दिने जिंयाँ राजे बोलेया था, “तीजे दिने मांगे फेर आऊणा, तिंयाँ ई यारोबाम ओर सारी प्रजा राजा रहूबियामो गे आजीर ऊई।” <verse eid="2CH 10:12" /><verse number="13" style="v" sid="2CH 10:13" />तेबे राजे तिना साथे कड़क गल्ला कित्तिया ओर रहूबियाम राजे स्याणेया री सलाह् छाडी की <verse eid="2CH 10:13" /><verse number="14" style="v" sid="2CH 10:14" />जवाना री सलाह्यी रे मुताबिक तिना खे बोलेया, “मेरे बाओए तो तुसा ते पारी काम कराई राखेया था, पर मां से ओर बी पारी करना; मेरा बाओ तो तुसा खे कोड़ेया साथे सजा देयो था, पर मां कांडेया वाल़े डण्डे साथे सजा देणी।” <verse eid="2CH 10:14" /><verse number="15" style="v" sid="2CH 10:15" />ईंयाँ राजे प्रजा री बिनती नि मानी; इजी री बजा ये कि जो वचन यहोवे शीलो रे रणे वाल़े अहिय्याह रे जरीये नबातो रे पाऊ यारोबामो खे बोलेया था, तिजी खे पूरा करने खे परमेशरे एड़ा ई ठराया था।<verse eid="2CH 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 10:16" />जेबे सारे इस्राएलिये देखेया कि राजा म्हारी नि सुणदा, तेबे तिने बोलेया,</para>
  <para style="q" vid="2CH 10:16">“दाऊदो साथे म्हारा क्या अंश?</para>
  <para style="q" vid="2CH 10:16">म्हारा तो यिशै रे पाऊए दे कोई इस्सा नि ए।</para>
  <para style="q" vid="2CH 10:16">ओ इस्राएलियो, आपणे-आपणे डेरे खे चली जाओ!</para>
  <para style="q" vid="2CH 10:16">एबे ओ दाऊद, आपणे ई कराने री फिकर कर।”<verse eid="2CH 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 10:17" />तेबे सारे इस्राएली आपणे डेरे खे चली गे। बस जितणे इस्राएली यहूदा रे शईरो रे बसी रे थे, तिना पाँदे ई रहूबियाम राज करदा रया। <verse eid="2CH 10:17" /><verse number="18" style="v" sid="2CH 10:18" />तेबे रहूबियाम राजे हदोरामो खे जो सबी काम करने वाल़ेया पाँदे अधिकारी था पेजीता ओर इस्राएलिये तेस पाँदे पात्थर बाई की से काई ता। तेबे रहूबियाम फटाफट आपणे रथो पाँदे चढ़ी की, यरूशलेम शईरो खे नठी गा। <verse eid="2CH 10:18" /><verse number="19" style="v" sid="2CH 10:19" />तेस दिनो ते, इस्राएलो रे लोके दाऊदो रे कराने रे खलाफ बिद्रोह कित्तेया। ओर आजो तक तेड़ा ई ए।<verse eid="2CH 10:19" /></para>
  <chapter eid="2CH 10" />
  <chapter number="11" style="c" sid="2CH 11" />
  <para style="s">रहूबियामो रा राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 11:1" />जेबे रहूबियाम यरूशलेम शईरो खे आया, तेबे तिने यहूदा ओर बिन्यामीनो रे कराने जो मिली की 180,000 अच्छे योद्धा थे कट्ठे कित्ते, ताकि इस्राएलो रे बाकी गोत्रा रे लोका साथे युद्ध करो जेते कि राज्य रहूबियामो रे वशो रे फेर आई जाओ। <verse eid="2CH 11:1" /><verse number="2" style="v" sid="2CH 11:2" />तेबे यहोवे रा ये वचन परमेशरो रे दास शमायाह गे पऊँचेया, <verse eid="2CH 11:2" /><verse number="3" style="v" sid="2CH 11:3" />“यहूदा रे राजा सुलैमानो रे पाऊ रहूबियामो ते ओर यहूदा ओर बिन्यामीन गोत्रा रे सारे इस्राएली लोका खे बोल कि, <verse eid="2CH 11:3" /><verse number="4" style="v" sid="2CH 11:4" />यहोवा ईंयाँ बोलोआ कि आपणे पाईया पाँदे अमला करी की युद्ध नि करो। तुसे आपणे-आपणे कअरो खे वापस ऊई जाओ, कऊँकि ये गल्ल मेरी तरफा ते ई ऊई री।” यहोवे रे इना वचना खे मानी की सेयो यारोबामो पाँदे बिना अमला कित्ते ई वापस ऊईगे।<verse eid="2CH 11:4" /></para>
  <para style="s">रहूबियामो रा शईरा खे मजबूत करना</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 11:5" />तेबे रहूबियाम यरूशलेम शईरो दे रणे लगेया, तिने यहूदा प्रदेशो खे बचाणे रिया तँईं यहूदा रे शईरा रे चऊँ कनारे दवाला बणवाईया, <verse eid="2CH 11:5" /><verse number="6" style="v" sid="2CH 11:6" />सेयो शईर यो ए, बेतलेहम, एताम, तकोआ, <verse eid="2CH 11:6" /><verse number="7" style="v" sid="2CH 11:7" />बेतसूर, सोको, अदुल्लाम, <verse eid="2CH 11:7" /><verse number="8" style="v" sid="2CH 11:8" />गत, मारेशा, जीप, <verse eid="2CH 11:8" /><verse number="9" style="v" sid="2CH 11:9" />अदोरैम, लाकीश, अजेका, <verse eid="2CH 11:9" /><verse number="10" style="v" sid="2CH 11:10" />सोरा, अय्यालोन ओर हेब्रोन शईर जो यहूदा ओर बिन्यामीनो दे ए, मजबूत कित्ते। <verse eid="2CH 11:10" /><verse number="11" style="v" sid="2CH 11:11" />तिने मजबूत शईर ओर बी मजबूत करी की तिना रे परदान ठराए ओर खाणे-पीणे रिया चीजा, तेल ओर शराबो रे पण्डार बी रखवाई ते। <verse eid="2CH 11:11" /><verse number="12" style="v" sid="2CH 11:12" />तेबे एकी-एकी शईरो दे तिने ढाला ओर भाल़े रखवाई की से बऊत मजबूत करीते। यहूदा ओर बिन्यामीन तो तेसरे कब्जे दे थे।<verse eid="2CH 11:12" /></para>
  <para style="s">पुरोईता ओर लेविया रा यहूदा खे आऊणा</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 11:13" />सारे इस्राएलो रे पुरोईत ओर लेविये बी आपणे सारे देशो ते उठी की तेसगे गये। <verse eid="2CH 11:13" /><verse number="14" style="v" sid="2CH 11:14" />ईंयाँ लेविये आपणिया काईणी ओर निज जमीन छाडी की, यहूदा ओर यरूशलेम शईरो रे आए, कऊँकि यारोबाम ओर तेसरे पाऊए सेयो निकयाल़ी ते थे कि सेयो यहोवे रिया तँईं पुरोईतो रा काम नि करो, <verse eid="2CH 11:14" /><verse number="15" style="v" sid="2CH 11:15" />यारोबामे तिना वेदिया पाँदे बलि चढ़ाणे खे आपणे ई पुरोईत चूणे जो तिने पाह्ड़िया पाँदे बणवाईया थिया। तिने पुरोईते यारोबामो रिया बणवाईया रिया बाकरा देवतेया ओर बाच्छूए री मूर्तिया री पूजा कित्ती। <verse eid="2CH 11:15" /><verse number="16" style="v" sid="2CH 11:16" />लेविया ते बाद इस्राएलो रे सारे गोत्रा बीचा ते जितणे मन लगाई की इस्राएलो रे परमेशर यहोवे खे टोल़ने वाल़े थे सेयो आपणे पितरा रे परमेशर यहोवे खे बलि चढ़ाणे खे यरूशलेम शईरो दे आए। <verse eid="2CH 11:16" /><verse number="17" style="v" sid="2CH 11:17" />तिने यहूदा रा राज्य पक्का कित्तेया ओर सुलैमानो रा पाऊ रहूबियाम तीऊँ साला तक मजबूत कराया, कऊँकि तीऊँ साला तक सेयो दाऊद ओर सुलैमानो री बाटा दे चलदे रये।<verse eid="2CH 11:17" /></para>
  <para style="s">रहूबियामो रा टब्बर</para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 11:18" />तेबे राजा रहूबियामे एकी जवाणसा साथे ब्या करी ला, मतलब महलत जेसारा बाओ दाऊदो रा पाऊ यरीमोत ओर माये यिशै रे पाऊ एलीआबो री बेटी अबीहैल थी। <verse eid="2CH 11:18" /><verse number="19" style="v" sid="2CH 11:19" />महलते तीन पाऊआ खे जन्म दित्तेया, जिना रे नाओं यूश, शेमर्याह ओर जाहम थे। <verse eid="2CH 11:19" /><verse number="20" style="v" sid="2CH 11:20" />तिजी ते बाद तिने अबशालोमो री बेटी माका साथे ब्या करी ला ओर तेसा ते अबिय्याह, अत्तै, जीजा ओर शलोमीत पैदा ऊए। <verse eid="2CH 11:20" /><verse number="21" style="v" sid="2CH 11:21" />रहूबियामे ठारा राणिया साथे ब्या कित्तेया ओर साठ रखैला राखिया ओर तेसरे ठाई माठे ओर साठ बेटिया पैदा ऊईया। अबशालोमो री बेटी माका ते से आपणिया सबी राणिया ते ओर रखैला ते जादा प्यार करो था; <verse eid="2CH 11:21" /><verse number="22" style="v" sid="2CH 11:22" />राजा रहूबियामे आपणी लाड़ी माका रा पाऊ अबिय्याह जेठा ओर सबी पाईया बीचे परदान ये सोची की ठराया कि तेसखे राजा बणाओ। <verse eid="2CH 11:22" /><verse number="23" style="v" sid="2CH 11:23" />से सोची-समजी की काम कित्तेया ओर तिने आपणे सारे पाऊ लग-लग करी की यहूदा ओर बिन्यामीनो रे सबी देशो रे सारे गढ़वाल़े शईरो रे ठराईते ओर तिना खे खाणे-पीणे रिया चीजा बऊत जादा दित्तिया ओर तिना खे बऊत सारिया जवाणसा टोल़िया।<verse eid="2CH 11:23" /></para>
  <chapter eid="2CH 11" />
  <chapter number="12" style="c" sid="2CH 12" />
  <para style="s">मिस्रो रे राजा शीशको रा यहूदा पाँदे हमला</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 12:1" />पर जेबे रहूबियामो रा राज्य मजबूत ऊईगा ओर से आपू स्थिर ऊईगा, तेबे तिने ओर तेस साथे सारे इस्राएली लोके यहोवे री आज्ञा मानणा छाडी ती। <verse eid="2CH 12:1" /><verse number="2" style="v" sid="2CH 12:2" />तिने लोके यहोवे साथे जो विश्वासघात कित्तेया, इजी बजा ते राजा रहूबियामो रे पाँजुए साले मिस्रो रे राजा शीशके, <verse eid="2CH 12:2" /><verse number="3" style="v" sid="2CH 12:3" />1,200 रथ ओर 60,000 कोड़ेया रे सवार लई की यरूशलेम शईरो पाँदे अमला कित्तेया ओर जो लोक तेस साथे मिस्रो ते आए, मतलब लूबी, सुक्किय्यी, कूशी यो अणगिणत थे। <verse eid="2CH 12:3" /><verse number="4" style="v" sid="2CH 12:4" />शीशके यहूदा रे गढ़वाल़े शईर लई ले ओर यरूशलेम शईरो रे नेड़े तक आया।<verse eid="2CH 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 12:5" />तेबे शमायाह नबी राजा रहूबियामो गे आया ओर यहूदा रे परदाना गे जो शीशको री सेना रे डरो रे मारे यरूशलेम शईरो दे कट्ठे ऊए थे, आई की बोलणे लगेया, “यहोवा ईंयाँ बोलोआ कि तुसे आऊँ छाडीता रा, इजी री खातर मैं तुसे छाडी की शीशको रे आथो दे करीते दे।” <verse eid="2CH 12:5" /><verse number="6" style="v" sid="2CH 12:6" />तेबे इस्राएलो रे परदान ओर राजा दीन ऊईगे ओर बोलेया, “यहोवा तर्मी ए।” <verse eid="2CH 12:6" /><verse number="7" style="v" sid="2CH 12:7" />जेबे यहोवे देखेया कि सेयो दीन ऊईगे, तेबे यहोवे रा ये वचन शमायाह गे पऊँचेया, “सेयो दीन ऊईगे रे, मां सेयो नाश नि करने, मां तिना रा कुछ बचाव करना ओर मेरी जल़न शीशको रे जरीये यरूशलेम शईरो पाँदे नि पड़कणी। <verse eid="2CH 12:7" /><verse number="8" style="v" sid="2CH 12:8" />तेबे बी सेयो तेसरे वशो दे रणे, ताकि सेयो मेरी ओर देशा-देशा रे राज्य री बी सेवा रे फर्क जाणी लो।”<verse eid="2CH 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 12:9" />तेबे मिस्रो रा राजा शीशक आपणी सेना साथे यरूशलेम शईरो पाँदे अमला करी की यहोवे रे मन्दरो रिया कीमती चीजा ओर राजमईलो रिया कीमती चीजा चकी की लईगा। से सब कुछ चकी की लईगा ओर सूईने रिया जो ढाला सुलैमाने बणाईया थिया, तिना खे बी से लईगा। <verse eid="2CH 12:9" /><verse number="10" style="v" sid="2CH 12:10" />तेबे रहूबियाम राजे तिना रे बदले पीतल़ी रिया ढाला बणवाईया ओर सेयो पईरेदारा रे परदानो रे आथो रे सम्बाल़ी तिया, जो राजमईलो रे द्वारो री रखवाल़ी करो थे। <verse eid="2CH 12:10" /><verse number="11" style="v" sid="2CH 12:11" />जेबे-जेबे राजा यहोवे रे मन्दरो रे जाओ था, तेबे-तेबे पईरेदार आई की तिना खे चकी की लई चलो थे ओर फेर पईरेदारा री कमरे रे वापस राखी देयो थे। <verse eid="2CH 12:11" /><verse number="12" style="v" sid="2CH 12:12" />जेबे रहूबियाम दीन ऊआ, तेबे यहोवे रा रोष तेस पाँदा ते उतरी गा ओर तिने तेसरा राज्य नाश नि कित्तेया ओर यहूदा री दशा थोड़ी ठीक बी थी।<verse eid="2CH 12:12" /></para>
  <para style="s">रहूबियामो रा अन्तिम बखत</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 12:13" />तेबे राजा रहूबियाम यरूशलेम शईरो दे मजबूत ऊई की राज करदा रया। जेबे रहूबियाम राज करने लगेया, तेबे अकताल़ी साला रा था ओर यरूशलेम शईरो दे, मतलब तेस शईरो रे, जो यहोवे आपणे नाओं रा बणाई की राखणे खे इस्राएलो रे सारे गोत्रो बीचा ते चूणी ला था, सतारा साला तक राज करदा रया। तेसरी माया रा नाओं नामा था, जो अम्मोनी जवाणस थी। <verse eid="2CH 12:13" /><verse number="14" style="v" sid="2CH 12:14" />तिने सेयो काम कित्ते जो बुरे थे, मतलब तिने आपणा मन यहोवे खे टोल़णे दे नि लगाया। <verse eid="2CH 12:14" /><verse number="15" style="v" sid="2CH 12:15" />शुरूओ ते लई की अन्तो तक रहूबियामो रे काम क्या शमायाह नबी ओर इद्दो री कताबा रे वंशावलिया रे रीतिया पाँदे नि लिखी राखे? रहूबियाम ओर यारोबामो बीचे लड़ाई सदा ऊँदी रई। <verse eid="2CH 12:15" /><verse number="16" style="v" sid="2CH 12:16" />ओर रहूबियाम मरीगा ओर दाऊदो रे शईरो दे से दबाईता। ओर तेसरा पाऊ अबिय्याह तेसरी जगा पाँदे राज करने लगेया।<verse eid="2CH 12:16" /></para>
  <chapter eid="2CH 12" />
  <chapter number="13" style="c" sid="2CH 13" />
  <para style="s">यहूदा दे अबिय्याह रा राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 13:1" />जेबे यारोबाम लगभग ठारा साला तक इस्राएलो पाँदे राज करने लगी रा था, तेबे अबिय्याह यहूदा रा राजा बणेया। <verse eid="2CH 13:1" /><verse number="2" style="v" sid="2CH 13:2" />से तीऊँ साला तक यरूशलेम शईरो दे राज करदा रया। ओर तेसरी माया रा नाओं मीकायाह था; जो गिबा रे रणे वाल़े ऊरीएलो री बेटी थी। यहूदा रे राजा अबिय्याह ओर इस्राएलो रे राजा यारोबामो बीचे लड़ाई ऊई। <verse eid="2CH 13:2" /><verse number="3" style="v" sid="2CH 13:3" />अबिय्याह तो 400,000 सिपाईया खे लई की लड़ने खे गया ओर यारोबाम 800,000 सिपाईया खे लई की तेस सामणे लड़ने खे आया।<verse eid="2CH 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 13:4" />तेबे अबिय्याह समारैम नाओं रे पाह्ड़ो पाँदे, जो एप्रैमो रे पाह्ड़ी इलाके पाँदे ए, खड़ा ऊई की बोलणे लगेया, “ओ यारोबाम, ओ सारे इस्राएलियो, मेरी सुणो। <verse eid="2CH 13:4" /><verse number="5" style="v" sid="2CH 13:5" />क्या तुसा खे नि जाणना चाईयो कि इस्राएलो रे यहोवा परमेशरे लूणो री वाचा<note caller="-" style="x"><char style="xo" closed="false">13:5 </char><char style="xq" closed="false">लूणो री वाचा </char><char style="xt" closed="false"><ref loc="NUM 18:19">गिण. 18:19</ref> </char></note> बानी की दाऊद ओर तेसरे कुलो खे इस्राएलो रा राज्य सदा खे देईता रा। <verse eid="2CH 13:5" /><verse number="6" style="v" sid="2CH 13:6" />तेबे बी नबातो रा पाऊ यारोबाम जो दाऊदो रे पाऊ सुलैमानो रा काम करने वाल़ा था, से आपणे स्वामिए रे खलाफ उठी रा। <verse eid="2CH 13:6" /><verse number="7" style="v" sid="2CH 13:7" />तेसगे अल़्के ओर नीच माणूं कट्ठे ऊईगे रे ओर जेबे सुलैमानो रा पाऊ रहूबियाम बच्चा ओर उतावल़े मनो रा था ओर तिना रा सामणा नि करी सको था, तेबे सेयो तेसरे खलाफ तागतबर ऊईगे। <verse eid="2CH 13:7" /><verse number="8" style="v" sid="2CH 13:8" />एबे तुसे सोचोए कि आसे यहोवे रे राजो रा सामणा करूँए, जो दाऊदो री ल्वादा रे आथो दे ए; कऊँकि तुसे सब मिली की बड़ा समाज बणी गे रे ओर तुसा गे सेयो सूईने रे बाच्छूए री मूर्तिया बीए, जो यारोबामे तुसा रा देवता ऊणे खे बणवाया। <verse eid="2CH 13:8" /><verse number="9" style="v" sid="2CH 13:9" />क्या तुसे यहोवे रे पुरोईता खे, मतलब हारूणो री ल्वाद ओर लेवी लोक निकयाल़ी की दूजे देशा रे लोका जेड़े पुरोईत नि राखी राखे? जो कोई एक बाच्छू ओर सात खाडू आपणा संस्कार करने खे ली आओ था, से तिना रा पुरोईत ऊई जाओआ, जो परमेशर नि ए। <verse eid="2CH 13:9" /><verse number="10" style="v" sid="2CH 13:10" />पर आसा लोका रा यहोवा परमेशर ए ओर आसे से नि छाडेया ओर आसा गे यहोवे री सेवा-टईल करने वाल़े पुरोईत, हारूणो री ल्वाद ओर आपणे-आपणे कामो दे लगे दे लेवी ए। <verse eid="2CH 13:10" /><verse number="11" style="v" sid="2CH 13:11" />सेयो हर रोज प्यागा-साँजा यहोवे खे होमबलि ओर खुशबूदार द्रव्य रा तूप बाल़ोए ओर शुद्ध मेजो पाँदे पेंटा री रोटी सजाओए ओर सूईने री दीवट ओर तिजी रे दिऊए साँजा-साँजा खे बाल़ोए; आसे तो आपणे परमेशर यहोवे री आज्ञा खे मानदे रये, पर तुसे से छाडीता रा। <verse eid="2CH 13:11" /><verse number="12" style="v" sid="2CH 13:12" />देखो, आसा साथे म्हारा परदान परमेशर ए ओर तेसरे पुरोईत तुसा रे खलाफ साआ बानी की बजाणे खे तुरहिया लई की बी आसा साथे ए। ओ इस्राएलियो, आपणे बुजुर्गा रे परमेशर यहोवे साथे नि लड़ो, कऊँकि तुसे सफल नि ऊणे।”<verse eid="2CH 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 13:13" />पर यारोबामे काणे वाल़े तिना पीछे पेजी ते, सेयो तो यहूदा रे सामणे थे ओर काणे वाल़े तिना पीछे थे। <verse eid="2CH 13:13" /><verse number="14" style="v" sid="2CH 13:14" />जेबे यहूदिये पीछे मूँ फेरेया, तेबे देखेया कि आसा रे आगे ओर पीछे दुँईं तरफा ते लड़ाई ऊणे वाल़ी ए; तेबे तिने यहोवे री दुहाई दित्ती ओर पुरोईत तुरहिया खे बजाणे लगे। <verse eid="2CH 13:14" /><verse number="15" style="v" sid="2CH 13:15" />तेबे यहूदी मर्दे जयजयकार कित्ती ओर जेबे यहूदी मर्दे जयजयकार कित्ती, तेबे परमेशरे अबिय्याह ओर यहूदा रे सामणे, यारोबाम ओर सारे इस्राएली काये। <verse eid="2CH 13:15" /><verse number="16" style="v" sid="2CH 13:16" />तेबे इस्राएली यहूदा रे सामणे ते नठे ओर परमेशरे सेयो तिना रे आथो रे करीते। <verse eid="2CH 13:16" /><verse number="17" style="v" sid="2CH 13:17" />अबिय्याह राजे ओर तेसरी प्रजा रे लोके सेयो बड़ी मारा साथे मारे एथो तक कि इस्राएली लोका बीचा ते 500,000 सिपाई काये। <verse eid="2CH 13:17" /><verse number="18" style="v" sid="2CH 13:18" />तेस बखते तो इस्राएली दबी गे ओर यहूदी इजी बजा ते प्रबल ऊए कऊँकि तिने आपणे पितरा रे परमेशर यहोवे पाँदे परोसा राखेया था। <verse eid="2CH 13:18" /><verse number="19" style="v" sid="2CH 13:19" />तेबे अबिय्याहे यारोबामो रा पीछा करी की तेसते बेतेल, यशाना ओर एप्रोन शईर ओर तिना रे गाँवो लई ले। <verse eid="2CH 13:19" /><verse number="20" style="v" sid="2CH 13:20" />अबिय्याह री पूरी जिन्दगी यारोबाम फेर तागतबर नि ऊआ ओर यहोवे से एड़ा मारेया कि से मरी गा। <verse eid="2CH 13:20" /><verse number="21" style="v" sid="2CH 13:21" />पर अबिय्याह ओर बी सामर्थी ऊईगा ओर तिने चौदा जवाणसा साथे ब्या कित्तेया, जिना ते बाई माठे ओर सोल़ा बेटिया पैदा ऊईया। <verse eid="2CH 13:21" /><verse number="22" style="v" sid="2CH 13:22" />अबिय्याह रे काम ओर तेसरा चाल-चलण ओर तेसरे वचन, इद्दो नबीए री कताबा दे लिखी राखे।<verse eid="2CH 13:22" /></para>
  <chapter eid="2CH 13" />
  <chapter number="14" style="c" sid="2CH 14" />
  <para style="s">यहूदा दे आसा रा राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 14:1" />अन्तो रे अबिय्याह मरी की आपणे बुजुर्गा साथे मिलीगा ओर तेसखे दाऊदो रे शईरो दे दबाईता ओर तेसरा पाऊ आसा तेसरी जगा पाँदे नवां राजा बणेया। एसरे दिना रे दस साल तक देशो रे शान्ति रई। <verse eid="2CH 14:1" /><verse number="2" style="v" sid="2CH 14:2" />आसे सेई कित्तेया जो परमेशर यहोवे री नजरा रे ठीक था। <verse eid="2CH 14:2" /><verse number="3" style="v" sid="2CH 14:3" />तिने पराई वेदिया ओर ऊच्ची जगा दूर कित्तिया ओर तिने सेयो पात्थर तोड़ी ते जिना खे लोक पवित्र समजो थे। <verse eid="2CH 14:3" /><verse number="4" style="v" sid="2CH 14:4" />ओर तिने यहूदिया खे आज्ञा दित्ती कि आपणे बुजुर्गा रे परमेशर यहोवे खे टोल़ो ओर बिधान ओर आज्ञा खे मानो। <verse eid="2CH 14:4" /><verse number="5" style="v" sid="2CH 14:5" />तेसरे कर्मचारिये यहूदा रे सारे शईरा री पाह्ड़िया री चूँडिया पाँदे बणी री पूजा री जगा ओर मूर्तिया खे तूप बाल़ने वाल़ी वेदिया नाश करी तिया। इजी बजा ते जेबे आसा यहूदा रे राज्य पाँदे राज करो था तेबे शान्ति थी। <verse eid="2CH 14:5" /><verse number="6" style="v" sid="2CH 14:6" />तिने यहूदा रे किलेया वाल़े शईर बसाए, कऊँकि देशो रे चैन रया। तिना साला रे तेसखे केसी साथे लड़ाई नि करनी पड़ी, कऊँकि यहोवे तेसखे राम दित्तेया था। <verse eid="2CH 14:6" /><verse number="7" style="v" sid="2CH 14:7" />तिने यहूदिया खे बोलेया, “आओ आसे इना शईरा खे बसाऊँए ओर तिना रे चऊँ कनारे दवाल, किले ओर बड़े द्वारो रे फल़े ओर बेड़े बणाऊँए; देश एबुए तक आसा सामणे पड़ी रा, कऊँकि आसे आपणे परमेशर यहोवे री टोल़ करी राखी आसे से टोल़ेया ओर तिने आसा खे चऊँ कनारा ते राम दित्तेया।” तेबे तिने सेयो शईर बसाए ओर मजबूत ऊए। <verse eid="2CH 14:7" /><verse number="8" style="v" sid="2CH 14:8" />फेर आसा राजे गे ढाल ओर बड़छे राखणे वाल़ेया री एक सेना थी, मतलब यहूदा बीचा ते तो 300,000 सिपाई ओर बिन्यामीनिया बीचा ते ढाल राखणे वाल़े ओर धनुर्धारी 280,000 शूरवीर सिपाई थे।<verse eid="2CH 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 14:9" />तिना रे खलाफ 1,000,000 सिपाईया री सेना ओर 300 रथ लई की जेरह नाओं रा एक कूशी निकल़ेया ओर मारेशा तक आई गा। <verse eid="2CH 14:9" /><verse number="10" style="v" sid="2CH 14:10" />राजा आसा आपणी सेना खे साथे लई की जेरह ते लड़ने खे गया। ओर मारेश शईरो रे नेड़े सापता नाओं री तराईया दे लड़ने खे आया। <verse eid="2CH 14:10" /><verse number="11" style="v" sid="2CH 14:11" />तेबे आसे आपणे परमेशर यहोवे री दुहाई दित्ती, “ओ यहोवा! जिंयाँ तूँ तागतवरा री मताद करी सकेया, तिंयाँ ई तेसरी बी करेया जो कमजोर ए, ओ म्हारे यहोवा परमेशर! म्हारी मताद कर, कऊँकि म्हारा परोसा तां ई पाँदे ए ओर तेरे नाओं रा परोसा करी की आसे एसा पीड़ा रे खलाफ आई रे। ओ यहोवा, तूँ म्हारा परमेशर ए, माणूं तां पाँदे प्रबल नि ऊई सकदे।”<verse eid="2CH 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 14:12" />तेबे यहोवे कूशी लोक आसा राजा ओर यहूदिया सामणे काये ओर कूशी लोक नठीगे। <verse eid="2CH 14:12" /><verse number="13" style="v" sid="2CH 14:13" />आसा राजा ओर तेस साथले लोके तिना रा पीछा गरारो तक कित्तेया ओर इतणे कूशी काये कि सेयो फेर सिर नि चकी सके, कऊँकि सेयो यहोवा ओर तेसरी सेना ते आरी गे ओर यहूदी बऊत सारी लूट लईगे। <verse eid="2CH 14:13" /><verse number="14" style="v" sid="2CH 14:14" />तिने गरारो रे नेड़े-तेड़े रे सब शईर खत्म करीते, कऊँकि यहोवे रा डर तिना रे रणे वाल़ेया रे मनो रे समाई गा ओर तिने सेयो शईर लूटी ले, कऊँकि तिना रे बऊत सारा तअन था। <verse eid="2CH 14:14" /><verse number="15" style="v" sid="2CH 14:15" />तेबे गवाईणी जीती की बऊत सारिया पेडा-बाकरिया ओर ऊँट लूटी की यरूशलेम शईरो खे वापस ऊईगे।<verse eid="2CH 14:15" /></para>
  <chapter eid="2CH 14" />
  <chapter number="15" style="c" sid="2CH 15" />
  <para style="s">यहूदा दे आसा राजे रे सुदार</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 15:1" />तेबे परमेशरो रा आत्मा ओदेदो रे पाऊ अजर्याह रे समाई गा, <verse eid="2CH 15:1" /><verse number="2" style="v" sid="2CH 15:2" />ओर से आसा राजे साथे मिलणे खे निकल़ेया ओर तेसखे बोलेया, “ओ आसा राजा ओर ओ सारे यहूदा ओर बिन्यामीनो रे लोको, मेरी सुणो, जदुओ तक तुसे यहोवे साथे रणे, तदुओ तक से तुसा साथे रणा ओर जे तुसे तेसरी टोल़ा दे लगे रे रओगे, तेबे तो से तुसा साथे मिलेया करना, पर जे तुसे तेसखे छाडी देओगे, तो तेस तुसे बी छाडी देणे। <verse eid="2CH 15:2" /><verse number="3" style="v" sid="2CH 15:3" />बऊत दिना तक इस्राएल बिना सच्चे परमेशरो ते ओर बिना सिखाणे वाल़े पुरोईत ओर बिना बिधानो ते रया। <verse eid="2CH 15:3" /><verse number="4" style="v" sid="2CH 15:4" />पर जेबे-जेबे सेयो मुसीबता रे पड़ी की इस्राएलो रे परमेशर यहोवे रिया तरफा खे फिरे ओर से टोल़ेया, तेबे-तेबे से तिना खे मिलेया। <verse eid="2CH 15:4" /><verse number="5" style="v" sid="2CH 15:5" />तेस बखते ना तो जाणे वाल़ेया खे कोई शान्ति ओ थी ओर ना आऊणे वाल़ेया खे, बल्कि सारे देशो रे सब रणे वाल़ेया रे बड़ा आल्ला-गोल्ला ओ था। <verse eid="2CH 15:5" /><verse number="6" style="v" sid="2CH 15:6" />देशा खे देश ओर शईरा खे दूजे शईर नाश करने लगी रे थे, कऊँकि परमेशर कई प्रकारा रे कष्ट देई की तिना खे डराणे लगी रे थे। <verse eid="2CH 15:6" /><verse number="7" style="v" sid="2CH 15:7" />पर जेथो तक तेरी गल्ल ए, मजबूत बणो ओर काम करदे रओ, कऊँकि परमेशरो तुसा खे तुसा रे अच्छे कामा रा प्रतिफल देणा।”<verse eid="2CH 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 15:8" />जेबे आसा राजे यो वचन ओर ओदेद नबीए री भविष्यबाणी सुणी, तेबे तिने याओ बानी की यहूदा ओर बिन्यामीनो रे सारे देशो ते ओर तिना शईरा ते जो तिने एप्रैमो रे पाह्ड़ी इलाके ते लई ले थे, सारी घिनौनी चीजा दूर कित्तिया ओर यहोवे री जो बेदी यहोवे रे बरांडे सामणे थी, से नये सिरे ते बणाई। <verse eid="2CH 15:8" /><verse number="9" style="v" sid="2CH 15:9" />तिने सारे यहूदा ओर बिन्यामीन ओर एप्रैम, मनश्शे ओर शिमोनो ते जो लोक तेस साथे रओ थे, सेयो कट्ठे कित्ते, कऊँकि सेयो ये देखी की कि तेसरा यहोवा परमेशर तेस साथे रओआ, इस्राएलो ते कई जणे तेसगे आए। <verse eid="2CH 15:9" /><verse number="10" style="v" sid="2CH 15:10" />आसा राजे रे राजो दे पन्द्रुए सालो रे तीजे मीन्ने दे सेयो यरूशलेम शईरो रे कट्ठे ऊए। <verse eid="2CH 15:10" /><verse number="11" style="v" sid="2CH 15:11" />तेस ई दिने तिने लड़ाईया दे तिना लूटा बीचा ते 700 गाए बल़द ओर 7,000 पेडा-बाकरिया लईया, ओर यहोवे खे बलि चढ़ाईया। <verse eid="2CH 15:11" /><verse number="12" style="v" sid="2CH 15:12" />तिने वाचा बानी कि आसा आपणे पूरे मन ओर सारे प्राणो ते आपणे बुजुर्गा रे परमेशर यहोवे री आराधना करदे रणा; <verse eid="2CH 15:12" /><verse number="13" style="v" sid="2CH 15:13" />ओर क्या बड़ा, क्या छोटा, क्या जवाणस, क्या मर्द, जो कोई इस्राएलो रे परमेशर यहोवे री पग्ती नि करो, से काया जाणा। <verse eid="2CH 15:13" /><verse number="14" style="v" sid="2CH 15:14" />ओर तिने जयजयकार करी की तुरहिया ओर रड़सिंगे बजांदे ऊए ऊच्ची आवाजा दे यहोवे री कसम खाई। <verse eid="2CH 15:14" /><verse number="15" style="v" sid="2CH 15:15" />ये कसम खाई की सब यहूदी खुश ऊए, कऊँकि तिने आपणे सारे मनो ते कसम खाई ओर बड़े चाव साथे से टोल़ेया ओर से तिना खे मिलेया ओर यहोवे तिना खे चऊँ कनारा ते राम दित्तेया।<verse eid="2CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 15:16" />आसा राजे री दादी माका जेसे अशेरा देविया रिया तँईं एक घिनौनी मूर्ति बणाई थी, तिने से राजमाता रे पदो ते टाईती ओर आसा राजे अशेरा री मूर्ति बाडी की पीसी ती ओर किद्रोन नाल़े दे सेटी ती। <verse eid="2CH 15:16" /><verse number="17" style="v" sid="2CH 15:17" />ऊच्ची जगा इस्राएलो ते नि टाल़िया, तेबे बी आसा राजे रा मन पूरी जिन्दगी निष्कपट रया। <verse eid="2CH 15:17" /><verse number="18" style="v" sid="2CH 15:18" />तिने जो सूईना-चाँदी ओर पांडे तेसरे बाओए चढ़ाए थे ओर जो तिने आपू चढ़ाए थे, सेयो परमेशरो रे मन्दरो दे पऊँचाई ते। <verse eid="2CH 15:18" /><verse number="19" style="v" sid="2CH 15:19" />आसा राजे रे राजो दे पैंतीए सालो तक फेर लड़ाई नि ऊई।<verse eid="2CH 15:19" /></para>
  <chapter eid="2CH 15" />
  <chapter number="16" style="c" sid="2CH 16" />
  <para style="s">अरामो रे राजे साथे आसा राजे रा मलाप</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 16:1" />आसा राजे रे राजो रे छत्तिए साले इस्राएलो रे राजा बाशे यहूदा पाँदे अमला कित्तेया ओर रामाह शईर आपणे कब्जे दे लई की से इजी खे किले बणाई की मजबूत कित्तेया, ताकि यहूदा रे राजा आसा गे कोई आई-जाई नि सको। <verse eid="2CH 16:1" /><verse number="2" style="v" sid="2CH 16:2" />तेबे आसा राजे यहोवे रे मन्दरो ओर राजमईलो रे पण्डारो ते सूईना-चाँदी निकयाल़ी की दमिश्को दे रणे वाल़े अरामो रे राजा बेन्हददो गे दूत पेजी की ये बोलेया, <verse eid="2CH 16:2" /><verse number="3" style="v" sid="2CH 16:3" />“जिंयाँ मेरे ओर तेरे बाओ बीचे तिंयाँ ई मां ओर तां बीचे बी वाचा बणी दी रणी चाईयो, देख आऊँ तांगे सूईना चाँदी पेजुँआ, इजी री खातर आओ, इस्राएलो रे राजा बाशा साथली आपणी वाचा खे तोड़ी दे, ताकि से मांते दूर ओ।” <verse eid="2CH 16:3" /><verse number="4" style="v" sid="2CH 16:4" />बेन्हददे आसा राजे री ये गल्ल मानी की, आपणे दलो रे परदाना ते इस्राएली शईरो पाँदे चढ़ाई करवाई की इय्योन, दान, आबेल्मैन ओर नप्तालिया रे सारे पण्डार वाल़े शईर जीती ले। <verse eid="2CH 16:4" /><verse number="5" style="v" sid="2CH 16:5" />ये सुणी की बाशे रामाह खे मजबूत करना छाडीता ओर तेती किले बनाणा छाडीता। <verse eid="2CH 16:5" /><verse number="6" style="v" sid="2CH 16:6" />तेबे आसा राजे पूरा यहूदा प्रदेश साथे लई की रामाह शईरो रे पात्थर ओर लकड़ी जिना साथे बाशा काम करो था चकी की लईगा ओर तिना साथे तिने गेबा ओर मिस्पा शईर मजबूत कित्ते।<verse eid="2CH 16:6" /></para>
  <para style="s">नबी हनानिये रा सन्देशा</para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 16:7" />तेस बखते हनानी दर्शी यहूदा रे राजा आसा गे जाई की बोलणे लगेया, “तैं जो आपणे परमेशर यहोवे पाँदे परोसा नि राखेया बल्कि अरामो रे राजे पाँदे ई परोसा राखेया, इजी बजा ते अरामो रे राजे री सेना तेरे आथो ते बची गी री। <verse eid="2CH 16:7" /><verse number="8" style="v" sid="2CH 16:8" />क्या कूशी ओर लूबिया री सेना बड़ी नि थी ओर क्या तिदे बऊत सारे रथ ओर सवार नि थे? तेबे बी तैं यहोवे पाँदे परोसा राखेया था, इजी बजा ते तिने सेयो तेरे आथो दे करीते। <verse eid="2CH 16:8" /><verse number="9" style="v" sid="2CH 16:9" />देख, यहोवे री नजर सारी तरतिया पाँदे इजी खे फिरदी रओई, ताकि जिना रा मन तेसरी तरफा खे निष्कपट रओआ, तिना री मतादा दे आपणी सामर्थ दखाओ। तैं ये काम मूर्खता साथे करी राखेया, इजी री खातर एबे तूँ लड़ाईया दे फसेया रा रणा।”<verse eid="2CH 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 16:10" />तेबे आसा राजा दर्शिये पाँदे गुस्से ऊआ ओर से जंजीरा दे बानी की तेसरे पैर लकड़िया दे ठोकी ते, कऊँकि से तेसरिया इना गल्ला ते गुस्से था। ओर से तेस बखतो ते ई प्रजा रे कुछ लोका साथे सख्ताईया रा बर्ताओ बी करने लगेया।<verse eid="2CH 16:10" /></para>
  <para style="s">आसा राजे री मौत</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 16:11" />शुरूओ ते लई की अन्तो तक आसा राजे रे काम यहूदा ओर इस्राएलो रे राजेया री कताबा रे लिखी राखे। <verse eid="2CH 16:11" /><verse number="12" style="v" sid="2CH 16:12" />आपणे राज्य रे उँताल़िये साले आसा खे पैरो री बमारी ऊई ओर से बमारी बऊत बढ़ी गी, तेबे बी तिने बमार ऊई की यहोवे री नि बल्कि बैदा री शरण लई। <verse eid="2CH 16:12" /><verse number="13" style="v" sid="2CH 16:13" />अन्तो रे आसा राजा आपणे राज्य रे अकताल़िये साले मरी की आपणे बुजुर्गा साथे जाई की मिलीगा। <verse eid="2CH 16:13" /><verse number="14" style="v" sid="2CH 16:14" />तेबे से तेसरी कब्रा देई जो तिने दाऊदो रे शईरो दे चट्टानी दे खणाई थी, दबाईता ओर से खुशबूदार तेल ओर खुशबूआ रे कामो दे कई प्रकारा रे मसालेया साथे परे रे एकी बछौणे पाँदे लटयाल़ी ता ओर तेसरिया तँईं बऊत सारा खुशबूदार तेल बाल़ेया।<verse eid="2CH 16:14" /></para>
  <chapter eid="2CH 16" />
  <chapter number="17" style="c" sid="2CH 17" />
  <para style="s">यहूदा दे यहोशापातो रा राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 17:1" />आसा राजे री जगा पाँदे तेसरा पाऊ यहोशापात यहूदा रा नवां राजा बणेया ओर तिने यहूदा प्रदेश इतणा तागतबर बणाया जेते की से इस्राएलो रे खलाफ लड़ी सको थे। <verse eid="2CH 17:1" /><verse number="2" style="v" sid="2CH 17:2" />तिने यहूदा रे सब गढ़वाल़े शईरो रे सिपाईया रे दल ठराईते ओर यहूदा रे देशो रे ओर एप्रैमो रे तिना शईरा रे बी जो तेसरे बाओ आसे लई ले थे, सिपाईया री चौकिया बठयाल़ी तिया। <verse eid="2CH 17:2" /><verse number="3" style="v" sid="2CH 17:3" />यहोवा यहोशापातो साथे रया, कऊँकि से आपणे मूलमर्द दाऊदो री पुराणी चाल चलेया ओर बाल देवतेया री टोल़ा रे नि रया। <verse eid="2CH 17:3" /><verse number="4" style="v" sid="2CH 17:4" />बल्कि से आपणे बाओ रे परमेशरो री टोल़ा रे लगेया रा रओ था ओर तेसरी आज्ञा पाँदे ई‍ चलो था ओर इस्राएलो जेड़े काम नि करो था। <verse eid="2CH 17:4" /><verse number="5" style="v" sid="2CH 17:5" />इजी बजा ते यहोवे राज्य यहोशापातो रे आथो रे मजबूत करी ता ओर सारे यहूदी तेसगे पेंट ल्याया करो थे ओर तेसगे बऊत सारा तअन ऊईगा ओर तेसरा मान-सम्मान बढ़ी गा। <verse eid="2CH 17:5" /><verse number="6" style="v" sid="2CH 17:6" />यहोवे री बाटा रे चलदे-चलदे तेसरा मन मगन ऊईगा, तेबे तिने यहूदा ते ऊच्ची जगा ओर अशेरा नाओं रिया मूर्तिया दूर कित्तिया।<verse eid="2CH 17:6" /></para>
  <para style="s">बिधि-बिधानो री शिक्षा</para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 17:7" />यहोशापाते आपणे राज्य रे तीजे साले बेन्हैल, ओबद्याह, जकर्याह, नतनेल ओर मीकायाह नाओं रे आपणे परदानो खे यहूदा रे शईरो दे शिक्षा देणे खे पेजे। <verse eid="2CH 17:7" /><verse number="8" style="v" sid="2CH 17:8" />तिना साथे शमायाह, नतन्याह, जबद्याह, असाहेल, शमीरामोत, यहोनातान, अदोनिय्याह, तोबियाह ओर तोबदोनिय्याह, नाओं रे लेवी ओर तिना साथे एलीशामा ओर यहोराम नाओं रे पुरोईत थे। <verse eid="2CH 17:8" /><verse number="9" style="v" sid="2CH 17:9" />तेबे तिने यहोवे रे बिधानो री कताब साथे लई की यहूदा दे शिक्षा दित्ती, बल्कि सेयो यहूदा रे सारे शईरा रे प्रजा रे लोका खे सखांदे ऊए कूमे। <verse eid="2CH 17:9" /><verse number="10" style="v" sid="2CH 17:10" />यहूदा रे नेड़े-तेड़े रे देशो रे राज्य-राज्य दे यहोवे रा एड़ा डर समाई गा कि तिने यहोशापातो साथे युद्ध नि कित्तेया। <verse eid="2CH 17:10" /><verse number="11" style="v" sid="2CH 17:11" />कुछ पलिश्ती यहोशापातो गे पेंट ल्याये ओर कर समजी की चाँदी ल्याये ओर अरब देशो रे लोक बी 7,700 खाडू ओर 7,700 बाकरे लई की आए।<verse eid="2CH 17:11" /></para>
  <para style="s">यहोशापातो री सेना री शक्ति</para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 17:12" />यहोशापात बऊत ई बढ़दा ओर तागतबर ऊँदा गया ओर तिने यहूदा रे किले ओर पण्डारो रे शईर त्यार कित्ते। <verse eid="2CH 17:12" /><verse number="13" style="v" sid="2CH 17:13" />ओर यहूदा रे शईरो दे तेसरा बऊत सारा काम ओ था ओर यरूशलेम शईरो दे तेसरे योद्धा, मतलब शूरवीर रओ थे।<verse eid="2CH 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 17:14" />इना रे पितरा रे करानेया रे मुताबिक इना री ये गिणती थी, मतलब यहूदी सेनापति तो यो थे, परदान अदना जेस साथे 300,000 सिपाई थे,<verse eid="2CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 17:15" />ओर तेसते बाद परदान यहोहानान, जेस साथे 280,000 सिपाई थे।<verse eid="2CH 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 17:16" />ओर तेसते बाद जिक्रीए रा पाऊ अमस्याह, जिने आपू खे आपणी इच्छा ते यहोवे खे अर्पण कित्तेया था, तेस साथे 200,000 सिपाई थे।<verse eid="2CH 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 17:17" />तेबे बिन्यामीनो बीचा ते एल्यादा नाओं रा एक शूरवीर, जेस साथे ढाल राखणे वाल़े 200,000 धनुर्धारी सिपाई थे।<verse eid="2CH 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 17:18" />ओर तेसते बाद यहोजाबाद, जेस साथे युद्धो रे अथियार बाने दे 180,000 सिपाई थे। <verse eid="2CH 17:18" /><verse number="19" style="v" sid="2CH 17:19" />यो सेयो ए जो राजे री सेवा दे तनो-मनो ते लगे दे रओ थे ओर यो तिना ते लग थे जो राजे यहूदा रे गढ़वाल़े शईरो दे ठराए थे।<verse eid="2CH 17:19" /></para>
  <chapter eid="2CH 17" />
  <chapter number="18" style="c" sid="2CH 18" />
  <para style="s">अहाबो साथे यहोशापातो रा मेल-मिलाप</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 18:1" />राजा यहोशापात बऊत अमीर ओर महिमा वाल़ा ऊईगा ओर तिने इस्राएलो रे राजा अहाबो रे परिवारो साथे ब्याओ रा रिस्ता बणाया। <verse eid="2CH 18:1" /><verse number="2" style="v" sid="2CH 18:2" />कुछ साला बाद से सामरिया दे अहाबो गे गया, तेबे अहाबे तेसखे ओर तेसरे साथिया खे बऊत सारिया पेडा-बाकरिया ओर गाय-बल़द बाडी की, तेसखे गिलाद इलाके रे रामोत शईरो पाँदे चढ़ाई करने खे सकेल़ेया।<verse eid="2CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 18:3" />इस्राएलो रे राजा अहाबे यहूदा रे राजा यहोशापातो खे बोलेया, “क्या तां मां साथे गिलाद इलाके रे रामोत शईरो पाँदे चढ़ाई करनी?” तिने तेसखे ज्वाब दित्तेया, “जेड़ा तूँ तेड़ा आऊँ बीए, ओर जेड़ी तेरी प्रजा, तेड़ी मेरी प्रजा बीए। आसा लोका युद्धो दे तेरा साथ देणा।”<verse eid="2CH 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 18:4" />फेर यहोशापाते इस्राएलो रे राजे खे बोलेया, “आओ, पईले यहोवे रा वचन पता करूँए।” <verse eid="2CH 18:4" /><verse number="5" style="v" sid="2CH 18:5" />तेबे इस्राएलो रे राजे नबिया खे जो 400 भविष्यबाणी करने वाल़े थे, कट्ठा करी की तिना ते पूछेया, “क्या आसे गिलाद इलाके रे रामोत शईरो पाँदे युद्ध करने खे अमला करुँ या आऊँ रूकेया रा रऊँ?” तिने ज्वाब दित्तेया, “अमला कर, कऊँकि परमेशरो से राजे रे आथो रे करी देणा।”<verse eid="2CH 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 18:6" />पर राजा यहोशापाते पूछेया, “क्या एती परमेशरो रा ओर बी कोई नबी ए, जेसते आसे पूछिए?” <verse eid="2CH 18:6" /><verse number="7" style="v" sid="2CH 18:7" />इस्राएलो रे राजे यहोशापातो खे बोलेया, “आ, एक मर्द ओर ए, जेसरे जरीये आसे यहोवे ते पूछी सकूँए, पर आऊँ तेसते नफरत करूँआ, कऊँकि से मेरे बारे रे कदी कल्याणो री नि, सदा नुकशाणो री ई भविष्यबाणी करोआ। से यिम्ला रा पाऊ मीकायाह ए।” यहोशापाते बोलेया, “राजा एड़ा नि बोलो।”<verse eid="2CH 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 18:8" />तेबे इस्राएलो रे राजा अहाबे एक परदान बुलाई की बोलेया, “यिम्ला रे पाऊ मीकायाह खे फटाफट लई की आओ।” <verse eid="2CH 18:8" /><verse number="9" style="v" sid="2CH 18:9" />तेस बखते इस्राएलो रा राजा ओर यहूदा रा राजा यहोशापात आपणे-आपणे राज्य रे टाल्ले पईनी की, आपणे-आपणे सिंहासनो पाँदे बैठी रे थे, सेयो सामरिया शईरो रे बड़े द्वारो गे एक खल्याणो दे बैठी रे थे ओर सारे नबी तिना सामणे भविष्यबाणी करने लगी रे थे।<verse eid="2CH 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 18:10" />तेबे कनाना रे पाऊआ बीचा ते एकी जेसरा नाओं सिदकिय्याह था लोए रे सींग बणाई की बोलेया, “यहोवा ईंयाँ बोलोआ कि इना साथे तां अरामी काई-काई की नाश करी देणे।” <verse eid="2CH 18:10" /><verse number="11" style="v" sid="2CH 18:11" />सबी नबीए येई भविष्यबाणी करी की बोलेया, “गिलाद इलाके रे रामोत शईरो पाँदे अमला कर ओर तूँ सफल ऊणा, कऊँकि यहोवे से शईर राजे रे आथो दे करी देणा।”<verse eid="2CH 18:11" /></para>
  <para style="s">मीकायाह रे जरीये आरा रा सन्देश</para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 18:12" />जो दूत मीकायाह खे बुलाणे गया था, तिने तेसखे बोलेया, “सुण, नबी लोक सब मिली की राजे रे बारे रे शुभ गल्ला बोलोए, इजी री खातर तेरी गल्ल तिना जेड़ी ओ, तैं बी शुभ गल्ला बोलणिया।” <verse eid="2CH 18:12" /><verse number="13" style="v" sid="2CH 18:13" />मीकायाहे बोलेया, “यहोवे री जिन्दगिया री कसम, जो कुछ मेरा परमेशर बोलो सेई मां बी बोलणा।”<verse eid="2CH 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 18:14" />जेबे मीकायाह राजा अहाबो गे आया, तेबे राजे तेसते पूछेया, “ओ मीकायाह, क्या आसे गिलाद इलाके रे रामोत शईरो पाँदे युद्ध करने खे चढ़ाई करिए या रूके रे रऊँ?” तिने बोलेया, “आ, तुसे लोक चढ़ाई करो, ओर सफल ओ; ओर सेयो तुसा रे आथो रे ऊई जाणे।” <verse eid="2CH 18:14" /><verse number="15" style="v" sid="2CH 18:15" />राजे तेसखे बोलेया, “माखे कितणी बार ताखे कसम देई की बोलणा पड़ना, कि तू यहोवे खे याद करी की मांगे सच्च ई बोल।” <verse eid="2CH 18:15" /><verse number="16" style="v" sid="2CH 18:16" />मीकायाहे बोलेया, “माखे सारा इस्राएल बिना गवाल़े री पेडा-बाकरिया जेड़ा पाह्ड़ो पाँदे तित्तर-बित्तर दिशेया, ओर यहोवे रा वचन आया कि तिना खे चलाणे वाल़ा कोई नि ए, इजी री खातर हर एक आपणे-आपणे कअरो खे रामो रे वापस ऊई जाओ।”<verse eid="2CH 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 18:17" />तेबे इस्राएलो रे राजे यहोशापातो खे बोलेया, “क्या मैं ताखे बोलेया नि था, कि तेस मेरे बारे दे पलाईया री नि, नुकशाणो री भविष्यबाणी करनी।” <verse eid="2CH 18:17" /><verse number="18" style="v" sid="2CH 18:18" />मीकायाहे बोलेया, “इजी बजा ते तुसे लोक यहोवे रा ये वचन सुणो: माखे सिंहासनो पाँदे विराजमान यहोवा ओर तेसरे दाँणे-खूँजे खड़ी री स्वर्गो री सारी सेना दिशी।” <verse eid="2CH 18:18" /><verse number="19" style="v" sid="2CH 18:19" />तेबे यहोवे पूछेया, “इस्राएलो रा राजा अहाब केस एड़ा बईकाणा कि से गिलाद इलाके रे रामोत शईरो पाँदे अमला करो।” तेबे किने कुछ ओर किने कुछ बोलेया। <verse eid="2CH 18:19" /><verse number="20" style="v" sid="2CH 18:20" />अन्तो दे एक आत्मा नेड़े आई की यहोवे रे सामणे खड़ी ऊई ओर बोलणे लगी, “मां से बईकाणा।” <verse eid="2CH 18:20" /><verse number="21" style="v" sid="2CH 18:21" />यहोवे पूछेया, “किंयाँ?” तेसे बोलेया, “मां जाई की तेसरे सबी नबिया पाँदे बैठी की तिना ते चूठ बुलाणा।” यहोवे बोलेया, “तेरा तेसखे बईकाणा सफल ऊणा, जाई की एड़ा ई कर।” <verse eid="2CH 18:21" /><verse number="22" style="v" sid="2CH 18:22" />इजी री खातर सुण, एबे यहोवे तेरे इना नबिया रे मुंए पाँदे एक चूठ बोलणे वाल़ी आत्मा बठयाल़ी राखी ओर यहोवे तेरे बारे दे नुकशाणो री गल्ल बोली राखी।<verse eid="2CH 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 18:23" />तेबे कनानो रा पाऊ सिदकिय्याह नेड़े गया, ओर मीकायाह री खाखा पाँदे थप्पड़ बाई की पूछेया, “यहोवे री आत्मा माखे छाडी की तां साथे गल्ला करने खे केथो खे गया?” <verse eid="2CH 18:23" /><verse number="24" style="v" sid="2CH 18:24" />मीकायाहे बोलेया, “जेस दिने तां लूकणे खे कमरे ते कमरे खे नठणा, तेबे ताखे पता लगी जाणा।”<verse eid="2CH 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 18:25" />तेबे इस्राएलो रे राजा अहाबे बोलेया, “मीकायाह खे शईरो रे परदान आमोन ओर राजकुमार योआशो गे लई जाई की, <verse eid="2CH 18:25" /><verse number="26" style="v" sid="2CH 18:26" />तिना खे बोलो, राजा ईंयाँ बोलोआ कि एसखे जेला रे पाओ ओर जदुओ तक आऊँ सई-सलामत नि आऊँ, तदुओ तक एसखे दु:खो री रोटी ओर पाणी देया करो।” <verse eid="2CH 18:26" /><verse number="27" style="v" sid="2CH 18:27" />तेबे मीकायाहे बोलेया, “जे तूँ कदी सई-सलामत वापस ओए, तो जाणी लया कि यहोवे मेरे जरीये नि बोलेया।” तेबे तिने बोलेया, “ओ लोको, तुसे सब के सब सुणी लो।”<verse eid="2CH 18:27" /></para>
  <para style="s">अहाबो री मौत</para>
  <para style="p">
    <verse number="28" style="v" sid="2CH 18:28" />तेबे इस्राएलो रे राजा अहाबे ओर यहूदा रे राजे यहोशापाते दुँईं मिली की गिलाद इलाके रे रामोत शईरो पाँदे अमला कित्तेया। <verse eid="2CH 18:28" /><verse number="29" style="v" sid="2CH 18:29" />तेबे इस्राएलो रे राजा अहाबे यहोशापातो खे बोलेया, “मां तो पेष बदली की युद्धो रे जाणा, पर तूँ आपणे ई टाल्ले पईनी की राख।” तेबे इस्राएलो रे राजे पेष बदलेया ओर युद्ध करने खे गया।<verse eid="2CH 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CH 18:30" />अरामो रे राजे तो आपणे रथा रे परदाना खे आज्ञा देई राखी थी कि ना तो छोटेया साथे लड़ो ओर ना बड़ेया साथे लड़ो, बस इस्राएलो रे राजे साथे लड़ो। <verse eid="2CH 18:30" /><verse number="31" style="v" sid="2CH 18:31" />इजी री खातर जेबे रथो रे परदाने यहोशापातो खे देखेया, तेबे बोलेया, “पक्का इस्राएलो रा राजा सेईए” ओर सेयो तेस साथे लड़ने खे मुड़े। ये देखी की यहोशापात चिंगेया, तेबे यहोवे तेसरी मताद कित्ती ओर सेयो तेसगे ते दूर चलीगे। <verse eid="2CH 18:31" /><verse number="32" style="v" sid="2CH 18:32" />ये देखी की कि से इस्राएलो रा राजा नि ए, रथो रे परदान तेसरा पीछा छाडी की वापस ऊईगे।<verse eid="2CH 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2CH 18:33" />तेबे अरामी सिपाईया बिचा ते किने ईंयाँ ई एक तीर चलाया ओर से इस्राएलो रे राजे री झिलम ओर थालले टाल्लेया रे छेद करी की लगेया; तेबे तिने आपणे सारथिये खे बोलेया, “आऊँ कायल ऊईगा रा, इजी री खातर लगाम फेरी की माखे सेना बीचा ते बारे लई जा।” <verse eid="2CH 18:33" /><verse number="34" style="v" sid="2CH 18:34" />ओर सेयो तेस बखते सारा दिन लड़दे रये ओर इस्राएलो रा राजा अहाब आपणे रथो दे अरामिया सामणे साँजा तक खड़ेया दा रया, पर सूरज डूबदे-डूबदे से मरी गा।<verse eid="2CH 18:34" /></para>
  <chapter eid="2CH 18" />
  <chapter number="19" style="c" sid="2CH 19" />
  <para style="s">यहोशापातो खे येहू नबीए री फटकार</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 19:1" />यहूदा रा राजा यहोशापात यरूशलेम शईरो खे आपणे मईलो दे सई-सलामत वापस ऊईगा। <verse eid="2CH 19:1" /><verse number="2" style="v" sid="2CH 19:2" />तेबे हनानी नाओं रे दर्शीये रा पाऊ येहू भविष्यवक्ता यहोशापात राजे गे मिलणे खे आया ओर तेसखे बोलणे लगेया, “क्या दुष्टा री मताद करनी ओर यहोवे रे दुश्मणा साथे प्यार राखणा चाईयो? एस कामो रिया बजा ते यहोवे रा रोष तां पाँदे पड़की रा। <verse eid="2CH 19:2" /><verse number="3" style="v" sid="2CH 19:3" />तेबे बी तांदे कुछ अच्छिया गल्ला ए। तैं तो देशो ते अशेरा री बेदिया खे नाश कित्तेया ओर आपणा मन परमेशरो री टोल़ा रे लगाया।”<verse eid="2CH 19:3" /></para>
  <para style="s">यहोशापातो रे सुदार</para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 19:4" />यहोशापात यरूशलेम शईरो दे रओ था। पर एक बार, जेड़ा कि तिने एक बार पईले बी कित्तेया था, से सुदूर दक्खणा दे बेर्शेबा शईरो ते लई की सुदूर उत्तरा दे एप्रैमो रे गोत्रो रे पाह्ड़ी इलाके तक, देशो रे सबी लोका बीचे गया, ओर तिने सेयो वापस आऊणे खे मनाई ले। यहोवे री आराधना करो, जेस परमेशरो री तिना रे बुजुर्ग आराधना करो थे। <verse eid="2CH 19:4" /><verse number="5" style="v" sid="2CH 19:5" />फेर तिने यहूदा रे एक-एक गढ़वाल़े शईरो दे न्यायी ठराए। <verse eid="2CH 19:5" /><verse number="6" style="v" sid="2CH 19:6" />ओर यहोशापाते न्यायिया खे बोलेया, “सोचो कि क्या करोए, कऊँकि तुसा जो न्याय करना, से माणूंआ खे नि, यहोवे खे करना ओर से न्याय करदे बखते तुसा साथे रणा। <verse eid="2CH 19:6" /><verse number="7" style="v" sid="2CH 19:7" />एबे यहोवे रा डर तुसा दे बणेया दा रओ; चौकसिया साथे काम करना, कऊँकि म्हारे परमेशर यहोवे दे कोई बुराई नि ए ओर ना से केसी रा पक्ष लओआ ओर ना रिश्वत लंदा।”<verse eid="2CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 19:8" />यरूशलेम शईरो रे बी यहोशापाते लेवी ओर पुरोईत ओर इस्राएलो रे पितरा रे कराने रे कुछ खास मर्द यहोवे री तरफा ते न्याय करने ओर मुकद्दमे परखणे खे ठराए। तिना रा न्याय-आसण यरूशलेम शईरो रे था। <verse eid="2CH 19:8" /><verse number="9" style="v" sid="2CH 19:9" />तिने तिना खे आज्ञा दित्ती, यहोवे रा डर मानी की, सच्चाई ओर निष्कपट मनो साथे एड़ा करना। <verse eid="2CH 19:9" /><verse number="10" style="v" sid="2CH 19:10" />तुसा रे पाई जो आपणे-आपणे शईरो रे रओए, तिना बीचा ते जेसरा कोई मुकद्दमा तुसा गे आओ, चाए से खूनो रा ओ, चाए बिधानो रा या केसी आज्ञा रा या बिधि या नियमो रे बारे रे ओ, तिना गे बताई देणा कि यहोवे रे बारे रे दोषी नि ओ। एड़ा नि ओ कि तुसा पाँदे ओर तुसा रे पाईया पाँदे तेसरा गुस्सा पड़को। एड़ा करोगे तो तुसे दोषी नि ठईरने। <verse eid="2CH 19:10" /><verse number="11" style="v" sid="2CH 19:11" />ओर देखो, यहोवे रे बारे दे सारे मुकद्दमेया दे तो अमर्याह बड़ा पुरोईत ओर राजे रे बारे दे सारे मुकद्दमेया दे यहूदा रे कराने रा परदान इश्माएलो रा पाऊ जबद्याह तुसा पाँदे अधिकारी ए ओर लेविया तुसा सामणे मुखिये रा काम करना। इजी री खातर याओ बानी की काम करो ओर खरे माणूंए साथे यहोवा रणा।<verse eid="2CH 19:11" /></para>
  <chapter eid="2CH 19" />
  <chapter number="20" style="c" sid="2CH 20" />
  <para style="s">दुश्मणा साथे युद्ध</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 20:1" />इजी ते बाद मोआबिये ओर अम्मोनिये ओर तिना साथे एदोमो रे मुनि जगा रे कुछ सिपाई युद्ध करने खे राजा यहोशापातो पाँदे अमला करने खे आए। <verse eid="2CH 20:1" /><verse number="2" style="v" sid="2CH 20:2" />तेबे कुछ लोके आई की यहोशापातो गे दशेया, “समुद्रो ते पार एदोम देशो री एक बड़ी सेना तुसा पाँदे अमला करने खे आऊणे वाल़ी ए। ओर देखो, से हसासोन्तामार शईरो तक जेते खे एनगदी बी बोलोए आईगी दी ए।” <verse eid="2CH 20:2" /><verse number="3" style="v" sid="2CH 20:3" />तेबे यहोशापात डरीगा ओर यहोवे री टोल़ा रे लगी गा ओर पूरे यहूदा दे बअरतो रा प्रचार करवाया। <verse eid="2CH 20:3" /><verse number="4" style="v" sid="2CH 20:4" />तेबे यहूदी यहोवे ते मताद माँगणे खे कट्ठे ऊए, बल्कि सेयो यहूदा रे सबी शईरो ते यहोवे साथे मिलणे खे आए।<verse eid="2CH 20:4" /></para>
  <para style="s">यहोशापातो री प्रार्थना</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 20:5" />तेबे यहोशापात यहोवा रे मन्दरो रे नये आँगणो सामणे यहूदी ओर यरूशलेम शईरो रे लोका सामणे खड़े ऊई की <verse eid="2CH 20:5" /><verse number="6" style="v" sid="2CH 20:6" />ये बोलणे लगेया, “ओ म्हारे पितरा रे यहोवा परमेशर! क्या तूँ स्वर्गो दे परमेशर नि ए? क्या तूँ जातिया-जातिया रे सबी राज्या पाँदे राज नि करदा? ओर क्या तेरे आथो रे एड़ी तागत ओर पराक्रम नि ए कि तेरा सामणा कोई नि करी सकदा?” <verse eid="2CH 20:6" /><verse number="7" style="v" sid="2CH 20:7" />ओ म्हारे परमेशर! क्या तैं एस देशो रे रणे वाल़ेया खे आपणी प्रजा इस्राएलो रे सामणे ते निकयाल़ी की यो आपणे दोस्त अब्राहमो रे कुलो खे सदा खे नि देई ते? <verse eid="2CH 20:7" /><verse number="8" style="v" sid="2CH 20:8" />सेयो इदे बसी गे ओर इदे तेरे नाओं री एक पवित्र जगा बणाई कि बोलेया, <verse eid="2CH 20:8" /><verse number="9" style="v" sid="2CH 20:9" />“जे तलवार या मरी या अकाल़ या कोई मुसीबत आसा पाँदे पड़ो, तेबे बी आसे एस मन्दरो सामणे ओर तां सामणे (तेरा नाओं तो एते मन्दरो रे बसी रा) खड़े ऊई की, आपणे क्ल़ेशो रिया बजा ते तेरी दुहाई देऊँगे ओर तां सुणी की आसे बचाणे। <verse eid="2CH 20:9" /><verse number="10" style="v" sid="2CH 20:10" />ओर एबे अम्मोनी ओर मोआबी ओर सेईरो<note caller="+" style="f"><char style="fr" closed="false">20:10 </char><char style="fq" closed="false">सेईरो </char><char style="ft" closed="false">एदोमी </char></note> रे पाह्ड़ी देशो रे लोक जिना पाँदे तैं इस्राएलो खे मिस्र देशो ते आऊँदे बखते अमला करने नि दित्तेया था ओर सेयो तिना री तरफा ते मुड़ी गे ओर सेयो नाश नि कित्ते, <verse eid="2CH 20:10" /><verse number="11" style="v" sid="2CH 20:11" />देख, सेयो ई लोक तेरे दित्ते रे अक्को रे एस देशो बीचा ते जेतेरा अक्क तैं आसा खे देई राखेया, आसा खे निकयाल़ी की केड़ा बदला देणे लगी रे। <verse eid="2CH 20:11" /><verse number="12" style="v" sid="2CH 20:12" />ओ म्हारे परमेशर, क्या तां तिना रा न्याय नि करना? ये जो बड़ी पीड़ आसा पाँदे अमला करने खे आऊणे लगी री, तेसा सामणे म्हारा जोर नि चलदा ओर आसा खे कुछ समजा दे नि आऊँदा कि क्या करना चाईयो? पर म्हारिया आखी तेरिया तरफा खे लगी रिया।”<verse eid="2CH 20:12" /></para>
  <para style="s">परमेशरो रा ज्वाब</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 20:13" />तेबे सब यहूदी आपणे-आपणे बाल-बच्चे, जवाणसा ओर पाऊआ समेत यहोवे रे सामणे खड़े रये। <verse eid="2CH 20:13" /><verse number="14" style="v" sid="2CH 20:14" />तेबे आसापो रे कुलो बीचा ते यहजीएल नाओं रा एक लेवी जो जकर्याह रा पाऊ ओर बनायाह रा पोता ओर मत्तन्याह रे पाऊ यीएलो रा पड़पोता था, तेसदे मण्डल़िया बीचे यहोवे रा आत्मा समाया। <verse eid="2CH 20:14" /><verse number="15" style="v" sid="2CH 20:15" />तेबे से बोलणे लगेया, “ओ सब यहूदियो, ओ यरूशलेम शईरो रे रणे वाल़ेयो, ओ राजा यहोशापात, तुसे सब त्यान देयो, यहोवा तुसा खे ईंयाँ बोलोआ कि तुसे ना तो एसा बड़ी पीड़ा ते डरो ओर ना कबराओ, कऊँकि युद्ध तुसा रा नि, परमेशरो राए। <verse eid="2CH 20:15" /><verse number="16" style="v" sid="2CH 20:16" />काल तिना रा सामणा करने खे जाणा, देखो सेयो सीसो रिया क्वाल़िया तक आईगे दे ए ओर यरूएल नाओं रे रेगिस्तानो रे नाल़े रे कनारे तुसा खे मिलणे। <verse eid="2CH 20:16" /><verse number="17" style="v" sid="2CH 20:17" />एसा लड़ाईया दे तुसा खे लड़ना नि पड़ना, ओ यहूदा ओर ओ यरूशलेम, रूके दे रणा ओर खड़े ऊई की यहोवे रिया तरफा ते आपणा छुटकारा देखणा, डरो नि ओर तुसा रा मन कच्चा नि ओ, काल तेसरा सामणा करने खे चलणा ओर यहोवा तुसा साथे रणा।” <verse eid="2CH 20:17" /><verse number="18" style="v" sid="2CH 20:18" />तेबे यहोशापात जमीना री तरफा खे मूँ करी की चुकेया ओर सबी यहूदिये ओर यरूशलेम शईरो रे रणे वाल़ेया लोके यहोवे रे सामणे थाले पड़ी की माथा टेकेया। <verse eid="2CH 20:18" /><verse number="19" style="v" sid="2CH 20:19" />कहाती ओर कोरहिया बीचा ते कुछ लेवी माणूं खड़े ऊई की इस्राएलो रे परमेशर यहोवे री स्तुति बऊत जोरे की करने लगे।<verse eid="2CH 20:19" /></para>
  <para style="s">जीत ओर लूट</para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 20:20" />तेबे सेयो प्यागा उठी की तकोआ री उजाड़ जगा रिया तरफा खे निकल़ी गे ओर चलदे बखते यहोशापाते खड़े ऊई की बोलेया, “ओ यहूदियो, ओ यरूशलेम शईरो रे रणे वाल़ेयो, मेरी सुणो, आपणे परमेशर यहोवे पाँदे परोसा राखो, तेबे तुसे टिके रे रणे, तेसरे नबिया पाँदे परोसा करो, तेबे तुसे सफल ऊई जाणे।”<verse eid="2CH 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 20:21" />तेबे तिने प्रजा साथे सलाह् करी की कई जणे ठराए, जो कि पवित्रता साथे सिपाईया ते आगे-आगे चलदे ऊए यहोवे रे गीत गाओ ओर ये बोलदे ऊए तेसरी स्तुति करो, “यहोवे रा तन्यवाद करो, कऊँकि तेसरी दया सदा री ए।” <verse eid="2CH 20:21" /><verse number="22" style="v" sid="2CH 20:22" />जेस बखते सेयो गायी की स्तुति करने लगे, तेस ई बखते यहोवे अम्मोनी, मोआबी ओर सेईरो रे पाह्ड़ी देशो रे लोका पाँदे जो यहूदा रे खलाफ आऊणे लगी रे थे, काणे वाल़े बठयाल़ी ते ओर सेयो काई ते। <verse eid="2CH 20:22" /><verse number="23" style="v" sid="2CH 20:23" />कऊँकि अम्मोनिये ओर मोआबिये सेईरो रे पाह्ड़ी देशो रे रणे वाल़ेया खे डराणे ओर नाश करने खे तिना पाँदे अमला कित्तेया ओर जेबे सेयो तिना रा अन्त करी चुके, तेबे सेयो आपू बीचे सब एकी-दूजे खे नाश करने लगे। <verse eid="2CH 20:23" /><verse number="24" style="v" sid="2CH 20:24" />जेबे यहूदा रे सिपाई उजाड़ जगा री चौकिया पाँदे पऊँची की तेसा पीड़ा खे देखेया, तेबे क्या देखेया कि सेयो जमीना दे मरे दे पड़ी रे ओर कोई नि बचेया।<verse eid="2CH 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 20:25" />तेबे यहोशापात ओर तेसरी प्रजा लूट लणे खे गये ओर लाशा बीचे बऊत सारी सम्पत्ति ओर अच्छे गईणे मिले, तिने इतणे गईणे उतारी ले कि तिना खे नि लई जाई सके, बल्कि लूट इतणी मिली कि कट्ठे करदे-करदे तीन दिन लगी गे। <verse eid="2CH 20:25" /><verse number="26" style="v" sid="2CH 20:26" />चौथे दिने सेयो बराका नाओं री तराईया दे कट्ठे ऊए ओर तेती यहोवे रा तन्यवाद कित्तेया, इजी बजा ते तेसा जगा रा नाओं बराका री तराई पड़ेया, जो आजो तक ए। <verse eid="2CH 20:26" /><verse number="27" style="v" sid="2CH 20:27" />तेबे सेयो, मतलब यहूदा ओर यरूशलेम शईरो रे सारे लोक ओर तिना ते आगे-आगे यहोशापात, खुशिया साथे यरूशलेम शईरो खे वापस ऊए, कऊँकि यहोवे सेयो दुश्मणा पाँदे खुश कित्ते थे। <verse eid="2CH 20:27" /><verse number="28" style="v" sid="2CH 20:28" />तेबे सेयो सारंगिया, बीणा ओर तुरहिया बजांदे ऊए यरूशलेम शईरो दे यहोवे रे मन्दरो दे आए। <verse eid="2CH 20:28" /><verse number="29" style="v" sid="2CH 20:29" />ओर जेबे देशो-देशो रे सबी राज्य रे लोके सुणेया कि इस्राएलो रे दुश्मणा साथे परमेशर लड़ेया, तेबे तिना रे मनो रे परमेशरो रा डर समाई गा। <verse eid="2CH 20:29" /><verse number="30" style="v" sid="2CH 20:30" />ईंयाँ यहोशापातो रे राज्य खे चैन मिलेया, कऊँकि तेसरे परमेशरे तेसखे चऊँ कनारा ते राम दित्तेया।<verse eid="2CH 20:30" /></para>
  <para style="s">यहोशापातो रे राजो रा खत्म ऊणा ओर तेसरा मरना</para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 20:31" />ईंयाँ यहोशापाते यहूदा पाँदे राज कित्तेया। जेबे से राज करने लगेया तेबे से पैंती साला रा था ओर पच्ची साला तक यरूशलेम शईरो रे राज करदा रया। ओर तेसरी माया रा नाओं अजूबा था, जो शिल्ही री बेटी थी। <verse eid="2CH 20:31" /><verse number="32" style="v" sid="2CH 20:32" />से आपणे बाओ आसा री चाला पाँदे चलेया ओर तिजी ते नि मुड़ेया, मतलब जो यहोवे री नजरा रे ठीक था, से सेई करदा रया। <verse eid="2CH 20:32" /><verse number="33" style="v" sid="2CH 20:33" />तेबे बी ऊच्ची जगा टाल़िया नि, बल्कि एबुए तक प्रजा रे लोके आपणा मन परमेशरो री तरफा खे नि लगाया था। <verse eid="2CH 20:33" /><verse number="34" style="v" sid="2CH 20:34" />शुरूओ ते लई की अन्तो तक यहोशापातो रे ओर काम, हनानीए रे पाऊ येहू भविष्यवक्ता रे बारे दे तेसा इतिआसो री कताबा दे लिखी राखे, जो इस्राएलो रे राजेया रे इतिआसो दे मिलोआ।<verse eid="2CH 20:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2CH 20:35" />इजी ते बाद यहूदा रे राजे यहोशापाते इस्राएलो रे राजा अहज्याह साथे जो तेसते बड़ी जल़न करो था, मेल कित्तेया। <verse eid="2CH 20:35" /><verse number="36" style="v" sid="2CH 20:36" />मतलब तिने तेस साथे इजी खे मेल कित्तेया कि तर्शीश जाणे खे जाह्ज बणवाओ ओर तिने एड़े जाह्ज एस्योनगेबेरो दे बणवाए। <verse eid="2CH 20:36" /><verse number="37" style="v" sid="2CH 20:37" />तेबे दोदावाह रे पाऊ मारेश शईरो दे रणे वाल़े एलीआजारे यहोशापातो रे खलाफ ये भविष्यबाणी कित्ती, “तैं जो अहज्याह साथे मेल कित्तेया, इजी बजा ते यहोवे तेरी बणाई रिया चीजा तोड़ी देणियां।” तेबे जाह्ज टूटी गे ओर तर्शीशो खे नि जाई सके।<verse eid="2CH 20:37" /></para>
  <chapter eid="2CH 20" />
  <chapter number="21" style="c" sid="2CH 21" />
  <para style="s">यहूदा दे यहोरामो रा राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 21:1" />अन्तो दे राजा यहोशापात मरीगा ओर से तेसरे बुजुर्गा साथे दाऊदो रे शईरो दे दबाईता। ओर तेसरा पाऊ यहोराम तेसरी जगा पाँदे यहूदा पाँदे राजा बणीगा। <verse eid="2CH 21:1" /><verse number="2" style="v" sid="2CH 21:2" />तेसरे पाई जो यहोशापातो रे पाऊ थे, मतलब अजर्याह, यहीएल, जकर्याह, अजर्याऊ, मीकाएल ओर शपत्याह; यो सब इस्राएलो रे राजा यहोशापातो रे पाऊ थे। <verse eid="2CH 21:2" /><verse number="3" style="v" sid="2CH 21:3" />तिना रे बाओए तिना खे सूईना-चाँदी ओर कीमती चीजा ओर बड़े-बड़े दान ओर यहूदा रे गढ़वाल़े शईर दित्ते थे, पर यहोरामो खे तिने राज्य दित्तेया, कऊँकि से जेठा था।<verse eid="2CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 21:4" />जेबे यहोराम आपणे बाओ रिया जगा पाँदे राज करने लगेया ओर तागतबर बी ऊईगा, तेबे तिने आपणे सारे पाई ओर इस्राएलो रे कुछ हाकिम बी तलवारी साथे काये। <verse eid="2CH 21:4" /><verse number="5" style="v" sid="2CH 21:5" />जेबे यहोराम राजा बणेया, तेबे से बत्तिया साला रा था ओर से आठ साला तक यरूशलेम शईरो पाँदे राज करदा रया। <verse eid="2CH 21:5" /><verse number="6" style="v" sid="2CH 21:6" />तिने इस्राएलो रे राजेया जेड़ी चाल‍ चली, जिंयाँ अहाबो रा कराना चलो था, कऊँकि तेसरी लाड़ी अहाबो री बेटी थी। ओर से तेस कामो खे करो था, जो यहोवे री नजरा रे बुरा ए। <verse eid="2CH 21:6" /><verse number="7" style="v" sid="2CH 21:7" />तेबे बी यहोवा आपणे तेस वादे रिया बजा ते दाऊदो रे कराने खे नाश करना नि चाओ था, कऊँकि तिने दाऊदो साथे वादा कित्तेया था कि तेसरे परिवारो रा कोई ना कोई माणूं सदा राजा बणी की राज करदे रणा।<verse eid="2CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 21:8" />तेसरे दिना दे एदोमे यहूदा री अधीनता छाडी की आपू पाँदे एक राजा बणाईता। <verse eid="2CH 21:8" /><verse number="9" style="v" sid="2CH 21:9" />तेबे यहोराम आपणे परदानो ओर आपणे सारे रथा खे साथे लई की एदोमो खे गया ओर रथो रे परदान काये। <verse eid="2CH 21:9" /><verse number="10" style="v" sid="2CH 21:10" />ईंयाँ एदोम यहूदा रे वशो ते छूटीगा ओर आजो तक तेड़ा ईए। तेस ई बखते लिब्ने तेसरे खलाफ ऊई की तेसरी अधीनता छाडी ती, ये इजी बजा ते ऊआ कि तिने आपणे पितरा रा यहोवा परमेशर त्यागी ता था। <verse eid="2CH 21:10" /><verse number="11" style="v" sid="2CH 21:11" />तिने यहूदा रे पाह्ड़ो पाँदे ऊच्चिया जगा बणाईया ओर यरूशलेम शईरो दे रणे वाल़ेया ते पाप करवाया ओर यहूदा सच्चे परमेशरो ते दूर करिता।<verse eid="2CH 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 21:12" />एक दिन एलिय्याह नबीए एक चिट्ठी यहोरामो खे लिखी, “तेरे मूलमर्द राजा दाऊदो रा यहोवा परमेशर ईंयाँ बोलोआ कि तूँ जो ना तो आपणे बाओ यहोशापातो री चाला पाँदे चलेया ओर ना यहूदा रे राजा आसा री चाला पाँदे, <verse eid="2CH 21:12" /><verse number="13" style="v" sid="2CH 21:13" />बल्कि इस्राएलो रे राजेया जेड़ा बुरा काम कित्तेया ओर अहाबो रे कराने जेड़ा यहूदा ओर यरूशलेम शईरो रे रणे वाल़ेया ते यहोवे रे खलाफ पाप करवाया ओर आपणे बाओ रे कराने बीचा ते आपणे पाई, जो तांते अच्छे थे, काई राखे, <verse eid="2CH 21:13" /><verse number="14" style="v" sid="2CH 21:14" />इजी बजा ते यहोवा तां पाँदे पारी मुसीबत पड़नी, तेरी प्रजा, पाऊ, जवाणसा खे सजा देणी ओर सारी जायदात नाश करी देणी। <verse eid="2CH 21:14" /><verse number="15" style="v" sid="2CH 21:15" />तूँ आंजा री बमारिया ते बऊत दु:खी ऊणा, एथो तक कि तेसा बमारिया रिया बजा ते तेरिया आंजा हर रोज निकल़दिया रणियां।”<verse eid="2CH 21:15" /></para>
  <para style="s">यहोरामो रे अन्तो रे दिन</para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 21:16" />यहोवे पलिश्तिया खे ओर कूशी लोका रे नेड़े रणे वाल़े अरबी, यहोरामो रे खलाफ पड़काये। <verse eid="2CH 21:16" /><verse number="17" style="v" sid="2CH 21:17" />सेयो यहूदा पाँदे अमला करी की तेस पाँदे टूटी गे ओर राजमईलो रे जितणी सम्पत्ति मिली, तिना सबी खे ओर राजे रे पाऊ ओर जवाणसा खे बी लईगे, एथो तक कि तेसरे छोटे पाऊ यहोआहाजो खे छाडी की, तेसगे कोई बी पाऊ नि रया। <verse eid="2CH 21:17" /><verse number="18" style="v" sid="2CH 21:18" />इना सबी ते बाद यहोवे तेसखे आंजा री बमारी लगाईती। <verse eid="2CH 21:18" /><verse number="19" style="v" sid="2CH 21:19" />कुछ बखतो ते बाद, मतलब दूजे सालो रे अन्तो दे तेसा बमारिया रिया बजा ते तेसरिया आंजा बारे निकल़ी गिया ओर से बऊत पीड़ा रिया बजा ते मरी गा। ओर तेसरी प्रजे जेड़े खुशबूदार द्रव्य तेसरे बुजुर्गा खे बाल़ेया था, तेड़ा तेसखे कुछ नि बाल़ेया। <verse eid="2CH 21:19" /><verse number="20" style="v" sid="2CH 21:20" />से जेबे राज करने लगेया, तेबे बत्ती साला रा था ओर यरूशलेम शईरो रे आठ साला तक राज्य करदा रया ओर सबी खे बुरा लगी की मरी गा ओर तेसरे लोके से दाऊदो रे शईरो दे यरूशलेम शईरो दे दबाईता। पर राजेया रे कब्रिस्तानो दे नि दबाया।<verse eid="2CH 21:20" /></para>
  <chapter eid="2CH 21" />
  <chapter number="22" style="c" sid="2CH 22" />
  <para style="s">यहूदा दे अहज्‍याहो रा राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 22:1" />यहोरामो रे मरने ते बाद तेबे यरूशलेम शईरो रे रणे वाल़ेया तेसरा छोटा पाऊ अहज्याह तेसरी जगा पाँदे राजा बणाया, कऊँकि जो दल अरबिया साथे डेरे रे आया था, तिने तेसरे सारे बड़े पाऊ काईते थे, तेबे यहूदा रे राजा यहोरामो रा पाऊ अहज्याह राजा बणेया। <verse eid="2CH 22:1" /><verse number="2" style="v" sid="2CH 22:2" />जेबे अहज्याह राजा बणेया, तेबे से बाई साला रा था ओर तिने यरूशलेम शईरो रे एक ई साल तक राज कित्तेया। तेसरी माया रा नाओं अतल्याह था, जो ओम्रीये री पोती थी। <verse eid="2CH 22:2" /><verse number="3" style="v" sid="2CH 22:3" />तिने अहाबो रे कराने री जी चाल चली, कऊँकि तेसरी माये तेसखे बुरा करने री सलाह् देयो थी। <verse eid="2CH 22:3" /><verse number="4" style="v" sid="2CH 22:4" />से अहाबो रे कराने जेड़ा काम करो था जो यहोवे री नजरा रे बुरा ए, कऊँकि तेसरे बाओ री मौता ते बाद सेयो तेसखे एड़ी सलाह् देयो थे, जेते कि तेसरा नाश ऊआ। <verse eid="2CH 22:4" /><verse number="5" style="v" sid="2CH 22:5" />से तिना री सलाह् रे मुताबिक चलो था ओर इस्राएलो रे राजा अहाबो रे पाऊ यहोरामो साथे गिलाद इलाके रे रामोत शईरो रे अरामो रे राजा हजाएलो साथे लड़ने खे गया ओर अरामिये यहोराम कायल कित्तेया। <verse eid="2CH 22:5" /><verse number="6" style="v" sid="2CH 22:6" />तेबे राजा यहोराम इजी खे वापस ऊईगा, ताकि यिज्रेल शईरो दे तिना जख्मा रा लाज कराओ, जो तेसखे अरामिया रे आथो ते तेस बखते लगे थे जेबे से रामोत गिलगालो दे हजाएलो साथे लड़ने लगी रा था। कऊँकि राजा अहाबो रा पाऊ यहोराम जो यिज्रेलो दे बमार था, इजी बजा ते यहूदा रे राजा यहोरामो रा पाऊ अहज्याह तेसखे देखणे गया।<verse eid="2CH 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 22:7" />अहज्याहो रा नाश परमेशरो री तरफा ते ऊआ, कऊँकि से यहोरामो गे गया था। जेबे से तेथी पऊँचेया, तेबे यहोरामो साथे निमशीए रा पाऊ येहूए रा सामणा करने खे निकल़ेया, जेसरा अभिषेक यहोवे इजी खे कराया था कि से अहाबो रे कराने रा नाश करो। <verse eid="2CH 22:7" /><verse number="8" style="v" sid="2CH 22:8" />जेबे येहू अहाबो रे कराने खे दण्ड देणे लगी रा था, तेबे तेसखे यहूदा रे परदान ओर अहज्याह रे पतीजे जो अहज्याह री सेवा-टईल करने वाल़े थे मिले ओर तिने सेयो काईते। <verse eid="2CH 22:8" /><verse number="9" style="v" sid="2CH 22:9" />तेबे तिने अहज्याह टोल़ेया। से शोमरोनो दे लूकी रा था, तेबे लोके से पकड़ेया ओर फेर येहूए गे पऊँचाई की से कायी ता। तेबे ये बोली की तेसखे माट्टी दित्ती, “ये यहोशापातो रा पोता ए, जो आपणे पूरे मनो ते यहोवे खे टोल़ो था।” ओर अहज्याह रे कराने दे राज करने खे कोई नि रया।<verse eid="2CH 22:9" /></para>
  <para style="s">अतल्याह रे जरीये राज्य छुड़ाणा</para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 22:10" />जेबे अहज्याह री माये अतल्याहे देखेया कि मेरा पाऊ मरी गा, तेबे तेसे उठी की यहूदा रे सारे कराने रा नाश कित्तेया। <verse eid="2CH 22:10" /><verse number="11" style="v" sid="2CH 22:11" />पर यहोशावत जो राजे री बेटी थी, तेसे अहज्याह रा पाऊ योआश, मरने वाल़े राजकुमारा बीचा ते चोरी की दाईया समेत बछौणे राखणे री कमरे रे राखी ता। ईंयाँ राजा यहोरामो री बेटी यहोशावत जो यहोयादा पुरोईतो री लाड़ी ओर अहज्‍याहो री बईण थी, तेसे योआश अतल्याह ते एड़ा लकोई की राखेया कि से तेसखे काई नि सकी। <verse eid="2CH 22:11" /><verse number="12" style="v" sid="2CH 22:12" />से तेसा गे परमेशरो रे मन्दरो रे छे साल तक लूकेया रा रया, इतणे दिना तक अतल्याह देशो पाँदे राज करदी रयी।<verse eid="2CH 22:12" /></para>
  <chapter eid="2CH 22" />
  <chapter number="23" style="c" sid="2CH 23" />
  <para style="s">अतल्याह री आर</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 23:1" />राणी अतल्याह रे राजो रे सातवे साले पुरोईत यहोयादे याओ बानी की यरोहामो रे पाऊ, अजर्याह, यहोहानानो रा पाऊ इश्माएल, ओबेदो रे पाऊ अजर्याह, अदायाह रे पाऊ मासेयाह ओर जिक्रीए रे पाऊ एलीशापात, इना सेनापतिया साथे वाचा बानी। <verse eid="2CH 23:1" /><verse number="2" style="v" sid="2CH 23:2" />तेबे सेयो यहूदा रे कूमी की सारे शईरा ते लेविया खे ओर इस्राएलो रे पितरा रे करानेया रे खास-खास मर्द कट्ठे करी की यरूशलेम शईरो खे ल्याए। <verse eid="2CH 23:2" /><verse number="3" style="v" sid="2CH 23:3" />तेसे सारी मण्डल़िए परमेशरो रे मन्दरो रे राजे साथे वाचा बानी ओर यहोयादे तिना खे बोलेया, “सुणो, एस राजकुमारो राज्य करना जेड़ा कि यहोवे दाऊदो रे कुलो रे बारे दे बोली राखेया। <verse eid="2CH 23:3" /><verse number="4" style="v" sid="2CH 23:4" />तेबे तुसे एक काम करो, मतलब तुसे पुरोईत ओर लेविया रे एक तिहाई लोक जो रामो रे दिने आऊणे वाल़े ओ, सेयो रखवाल़ी करो, <verse eid="2CH 23:4" /><verse number="5" style="v" sid="2CH 23:5" />तुसा बीचा ते एक तिहाई पुरोईत ओर लेविया खे राजमईलो री रखवाल़ी करनी चाईयो। ओर एक तिहाई लोक निऊँआ रे बड़े द्वारो गे रओ ओर सारे लोक यहोवे रे मन्दरो रे आँगणो रे रओ। <verse eid="2CH 23:5" /><verse number="6" style="v" sid="2CH 23:6" />पर पुरोईत ओर सेवा-टईल करने वाल़े लेविया खे छाडी की ओर कोई यहोवे रे मन्दरो दे पीतरे नि आओ, सेयो तो पीतरे आओ, कऊँकि सेयो पवित्र ए, पर सारे लोक यहोवे रे मन्दरो री निगरानी करो। <verse eid="2CH 23:6" /><verse number="7" style="v" sid="2CH 23:7" />लेविये लोक आपणे-आपणे आथो रे अथियार लई की राजे रे चऊँ कनारे रये ओर जो कोई मन्दरो रे पीतरे कूसो, तेसखे काई देयो ओर तुसे राजे रे आऊँदे-जांदे तेस साथे रणा।” <verse eid="2CH 23:7" /><verse number="8" style="v" sid="2CH 23:8" />यहोयादा पुरोईतो री इना सबी आज्ञा रे मुताबिक लेविये ओर यहूदिये कित्तेया। तिने रामो रे दिने आऊणे वाल़े ओर जाणे वाल़े दुँईं दलो रे आपणे-आपणे माणूं आपू साथे करी ले, कऊँकि यहोयादा पुरोईते केसी बी दलो रे लेवी नि पेजे थे। <verse eid="2CH 23:8" /><verse number="9" style="v" sid="2CH 23:9" />तेबे यहोयादा पुरोईते सेनापतिया खे दाऊद राजे रे बड़छे, भाल़े ओर ढाला, जो परमेशरो रे मन्दरो रे थिया, देईतिया। <verse eid="2CH 23:9" /><verse number="10" style="v" sid="2CH 23:10" />तेबे तिने तिना सबी लोका खे आपणे-आपणे आथो दे अथियार लई की मन्दरो रे दक्खण कूणे ते लई की, उत्तरी कूणे तक बेदी ओर मन्दरो गे राजे रे चऊँ कनारे ओर तिना री आड़ करी की खड़ा करी ता। <verse eid="2CH 23:10" /><verse number="11" style="v" sid="2CH 23:11" />तेबे तिने राजकुमार बारे ल्याया ओर तेसरे सिरो पाँदे मुकुट राखेया ओर गवाईया री चिट्ठी देई की से राजा बणाया ओर यहोयादा ओर तेसरे पाऊए तेसरा अभिषेक कित्तेया, तेबे सबी लोके जोरे की बोलेया, “राजा लाम्बी उम्र जिओ।” <verse eid="2CH 23:11" /><verse number="12" style="v" sid="2CH 23:12" />जेबे अतल्याह खे तिना लोका रा आल्ला, जो दौड़ो ओर राजे खे सराणे लगी रे थे, सुणेया, तेबे से लोका गे यहोवे रे मन्दरो रे गई। <verse eid="2CH 23:12" /><verse number="13" style="v" sid="2CH 23:13" />तेसे क्या देखेया कि राजा मन्दरो रे द्वारो रे नेड़े खम्बे गे खड़ी रा ओर राजे गे परदान ओर तुरही बजाणे वाल़े खड़ी रे ओर सब लोक खुशी मनाणे लगी रे, तुरहिया बजाणे लगी रे ओर गाणे-बजाणे वाल़े बाजे बजाणे ओर स्तुति करने लगी रे। तेबे अतल्याह आपणे टाल्ले फाड़ी की आका पाणे लगी, “राजद्रोह, राजद्रोह!” <verse eid="2CH 23:13" /><verse number="14" style="v" sid="2CH 23:14" />तेबे यहोयादा पुरोईते दलो रे अधिकारी सेनापतिया खे बारे ल्याई की बोलेया, “तेसा खे आपणी पाल़िया बीचा ते निकयाल़ी की लई जाओ ओर जो कोई एसा पीछे चलो, तेसखे तलवारी साथे काई देयो।” पुरोईते बोलेया, “एसा खे यहोवे रे मन्दरो रे नि काओ।” <verse eid="2CH 23:14" /><verse number="15" style="v" sid="2CH 23:15" />तेबे तिने दुँईं तरफा ते तेसा खे जगा दित्ती ओर से राजमईलो रे कोड़ेया रे बड़े द्वारो तक गई ओर तिने से तेती काईती।<verse eid="2CH 23:15" /></para>
  <para style="s">यहोयादा रे सुदार</para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 23:16" />तेबे यहोयादे आपणे ओर सारी प्रजा रे ओर राजे बीचे यहोवे री प्रजा ऊणे री वाचा बणाई। <verse eid="2CH 23:16" /><verse number="17" style="v" sid="2CH 23:17" />तेबे सबी लोके जाई की बाल देवते रा मन्दर टाल़ी ता ओर तेसरी बेदिया रे ओर मूर्तिया रे टुकड़े-टुकड़े करीते ओर मत्तान नाओं रा बालो रा पुरोईत बेदिया रे सामणे ई काई ता। <verse eid="2CH 23:17" /><verse number="18" style="v" sid="2CH 23:18" />तेबे यहोयादे यहोवे रे मन्दरो री सेवा खे सेयो लेवीय पुरोईत ठराईते, जो दाऊदे यहोवे रे मन्दरो पाँदे दल-दल करी की इजी री खातर ठराए थे, ताकि जेड़ा मूसे रे बिधानो रे लिखी राखेया, तेड़े ई सेयो यहोवे खे होमबलि चढ़ाया करो ओर दाऊदो री चलाई री बिधिया रे मुताबिक खुशी करो ओर गाओ। <verse eid="2CH 23:18" /><verse number="19" style="v" sid="2CH 23:19" />तिने यहोवे रे मन्दरो रे बड़े द्वारो पाँदे द्वारपाल इजी खे खड़े कित्ते, ताकि जो कोई किंयाँ बी अशुद्ध ओ, से पीतरे नि जाई सको। <verse eid="2CH 23:19" /><verse number="20" style="v" sid="2CH 23:20" />से सेनापति ओर अमीर, प्रजा पाँदे राज करने वाल़े ओर देशो रे सारे लोका खे साथे लई की राजे खे यहोवे रे मन्दरो ते थाले लईगा ओर ऊच्चे बड़े द्वारो ते ऊई की राजमईलो रे आया ओर राजा राजगद्दिया पाँदे बठयाल़ेया। <verse eid="2CH 23:20" /><verse number="21" style="v" sid="2CH 23:21" />तेबे सारे लोक खुश ऊए ओर यरूशलेम शईरो दे शान्ति ऊई। अतल्याह तो तलवारी साथे काईती री थी।<verse eid="2CH 23:21" /></para>
  <chapter eid="2CH 23" />
  <chapter number="24" style="c" sid="2CH 24" />
  <para style="s">योआशो रा राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 24:1" />जेबे योआश राजा बणेया, तेबे से सात साला रा था ओर यरूशलेम शईरो दे चाल़ी साला तक राज करदा रया। तेसरी माया रा नाओं सिब्या था, जो बेर्शेबा शईरो री थी। <verse eid="2CH 24:1" /><verse number="2" style="v" sid="2CH 24:2" />जदुओ तक यहोयादा पुरोईत जिऊँदा रया, तदुओ तक योआश से काम करदा रया जो यहोवे री नजरा रे ठीक ए। <verse eid="2CH 24:2" /><verse number="3" style="v" sid="2CH 24:3" />यहोयादे तेसरे दो ब्या कराए ओर तेसरे माठे-बेटिया पैदा ऊए।<verse eid="2CH 24:3" /></para>
  <para style="s">मन्दरो री मरम्मत</para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 24:4" />इजी ते बाद योआश राजे रे मनो दे यहोवे रे मन्दरो री मरम्मत करने री इच्छा ऊई। <verse eid="2CH 24:4" /><verse number="5" style="v" sid="2CH 24:5" />तेबे तिने पुरोईत ओर लेविया खे कट्ठे करी की बोलेया, “हर साल यहूदा रे शईरो दे जाई-जाई की सबी इस्राएली लोका ते पैसे लया करो जेते कि तुसा रे परमेशरो रे मन्दरो री मरम्मत ओ; देखो, ये काम फटाफट करो।” तेबे बी लेविये कोई तेजी नि कित्ती। <verse eid="2CH 24:5" /><verse number="6" style="v" sid="2CH 24:6" />तेबे राजे यहोयादा बड़े पुरोईतो खे बुलाई की पूछेया, “क्या बजा ए कि तैं लेविया खे सख्त ऊई की नि बोलेया कि सेयो यहूदा ओर यरूशलेम शईरो ते तेस चन्दे रा पैसा ली आओ जेतेरा नियम यहोवे रे दास मूसा ओर इस्राएलो री मण्डल़िए गवाईया री पर्चिया रिया तँईं चलाया था।” <verse eid="2CH 24:6" /><verse number="7" style="v" sid="2CH 24:7" />एबे यहोवे रा मन्दर मरम्मत करने खे ऊईगा दा ए कऊँकि तेसा दुष्ट जवाणसा अतल्याह रे माठेया तो परमेशरो रा मन्दर तोड़ी ता ओर यहोवे रे मन्दरो रिया सब पवित्र कित्ती रिया चीजा बाल देवते री मूर्तिया खे देईतिया दिया ए।<verse eid="2CH 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 24:8" />राजे एक सन्दूक बनाणे री आज्ञा दित्ती ओर से यहोवे रे मन्दरो रे द्वारो गे बारे राखेया। <verse eid="2CH 24:8" /><verse number="9" style="v" sid="2CH 24:9" />तेबे यहूदा ओर यरूशलेम शईरो रे ये प्रचार कित्तेया कि जेस चन्दे रा नियम परमेशरो रे दास मूसे उजाड़ जगा दे इस्राएलो रे लोका खे चलाया था, तिजी रे पैसे यहोवे रिया तँईं ली आओ। <verse eid="2CH 24:9" /><verse number="10" style="v" sid="2CH 24:10" />तेबे सारे परदान ओर प्रजा रे सारे लोक खुश ऊई की पैसे ल्याई की जदुओ तक चन्दा पूरा नि ऊआ, तदुओ तक सन्दूको दे पाँदे रये। <verse eid="2CH 24:10" /><verse number="11" style="v" sid="2CH 24:11" />जेबे-जेबे से सन्दूक लेविया रे आथो ते राजे रे परदाना गे पऊँचाया जाओ ओर ये लगो था कि तिदे पैसे जादा ए, तेबे-तेबे राजे रे परदान ओर बड़े पुरोईतो रे अधिकारी आई की सन्दूको खे खाली करो थे ओर तेबे तिजी खे फेर तेसरी जगा पाँदे ई राखी देयो थे। तिने हर रोज एड़ा ई कित्तेया ओर बऊत सारा पैसा कट्ठा कित्तेया। <verse eid="2CH 24:11" /><verse number="12" style="v" sid="2CH 24:12" />तेबे राजे ओर यहोयादे से पैसा यहोवे रे मन्दरो रे काम करने वाल़ेया खे देईता ओर तिने राजमिस्त्रिया खे ओर मिस्त्रिया खे यहोवे रे मन्दरो खे सुदारने खे ओर ल्वार ओर पांडे बनाणे वाल़े यहोवे रे मन्दरो री मरम्मत करने खे मजदूरिया पाँदे राखे। <verse eid="2CH 24:12" /><verse number="13" style="v" sid="2CH 24:13" />कारीगर काम करदे गये ओर काम पूरा ऊँदा गया ओर तिने परमेशरो रा मन्दर जेड़ा का तेड़ा बणाई की मजबूत करी ता। <verse eid="2CH 24:13" /><verse number="14" style="v" sid="2CH 24:14" />जेबे तिने से काम पूरा करी ता, तेबे सेयो बाकी पैसा राजा ओर यहोयादा बड़े पुरोईतो गे लईगे ओर तिना पैसेया साथे परमेशरो रे मन्दरो रे पांडे बणाए, मतलब सेवा-टईल करने ओर होमबलि चढ़ाणे रे पांडे ओर तूपदान बगैरा सूईने-चाँदिए रे पांडे। जदुओ तक यहोयादा जिऊँदा रया, तदुओ तक यहोवे रे मन्दरो दे होमबलि हर रोज चढ़ाओ थे।<verse eid="2CH 24:14" /></para>
  <para style="s">यहोयादा री मौत ओर योआशो रा परमेशरो ते फिरना</para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 24:15" />पर यहोयादा बड़ा पुरोईत स्याणा ऊईगा ओर लाम्बी उम्रा रा ऊई की मरी गा। जेबे से मरेया तेबे 130 साला रा था। <verse eid="2CH 24:15" /><verse number="16" style="v" sid="2CH 24:16" />ओर दाऊदो रे शईरो दे राजेया बीचे से दबाईता, कऊँकि तिने इस्राएलो रे ओर परमेशरो रे ओर तेसरे मन्दरो रे बारे दे खरा कित्तेया था। <verse eid="2CH 24:16" /><verse number="17" style="v" sid="2CH 24:17" />यहोयादो रे मरने ते बाद यहूदा रे परदाने राजे गे जाई की माथा टेकेया ओर राजे तिना री मानी। <verse eid="2CH 24:17" /><verse number="18" style="v" sid="2CH 24:18" />तेबे सेयो आपणे पितरा रे परमेशर यहोवे खे छाडी की अशेरा ओर मूर्तिया री आराधना करने लगे। तेबे तिना रे एड़े दोषी ऊणे रिया बजा ते परमेशरो रा रोष यहूदा ओर यरूशलेम शईरो पाँदे पड़केया। <verse eid="2CH 24:18" /><verse number="19" style="v" sid="2CH 24:19" />तेबे बी परमेशरे तिना गे नबी पेजे, ताकि तिना खे यहोवे रे नेड़े फेर ल्याओ ओर इने तिना खे बताईता, पर तिने सुणेया नि। <verse eid="2CH 24:19" /><verse number="20" style="v" sid="2CH 24:20" />तेबे परमेशरो रा आत्मा यहोयादा पुरोईतो रे पाऊ जकर्याह रे समाया ओर से ऊच्ची जगा रे खड़े ऊई की लोका खे बोलणे लगेया, “परमेशर ईंयाँ बोलोआ कि तुसे परमेशरो री आज्ञा खे कऊँ टाल़ोए? एड़ा करी की तुसा रा पला नि ऊई सकदा। देखो, तुसे तो यहोवा छाडीता रा, इजी बजा ते तिने बी तुसे छाडी ते।” <verse eid="2CH 24:20" /><verse number="21" style="v" sid="2CH 24:21" />तेबे लोके तेसरे खलाफ साजिशा रिया गल्ला बोली की, राजे री आज्ञा ते यहोवे रे मन्दरो रे आँगणो रे तेस पाँदे पात्थर बाए। <verse eid="2CH 24:21" /><verse number="22" style="v" sid="2CH 24:22" />ईंयाँ योआश राजे से प्यार पूली की जो यहोयादे तेस साथे कित्तेया था, तेसरा पाऊ काया। मर्दे बखते तिने बोलेया, “परमेशर ई एतेरा बदला लओ।”<verse eid="2CH 24:22" /></para>
  <para style="s">अरामिया रा अमला</para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 24:23" />नया साल लगदे ई अरामिये रिये सेने तिना पाँदे अमला कित्तेया ओर यहूदा ओर यरूशलेम शईरो रे आई की प्रजा बीचा ते सारे परदान खत्म करीते ओर तिना रा सारा तअन लूटी की दमिश्क शईरो रे राजे गे पेजेया। <verse eid="2CH 24:23" /><verse number="24" style="v" sid="2CH 24:24" />अरामिया री सेना थोड़े ई सेनिका साथे तो आई थी, पर यहोवे एक बऊत बड़ी सेना तिना रे आथो रे करी ती, कऊँकि तिने आपणे बुजुर्गा रा परमेशर छाडीता था। इजी बजा ते योआशो खे बी तिने सजा दित्ती।<verse eid="2CH 24:24" /></para>
  <para style="s">योआशो री अत्या</para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 24:25" />जेबे सेयो तेसखे बऊत ई काईल करी की छाडी गे, तेबे तेसरे कर्मचारिये यहोयादा पुरोईतो रे पाऊआ रे खूनो रिया बजा ते तेसरे खलाफ साजिशा रिया गल्ला बोली की, से तेसरे बछौणे पाँदे ई एड़ा काया कि से मरी गा ओर तिने से दाऊदो रे शईरो दे दबाईता, पर राजेया रे कब्रिस्तानो रे नि। <verse eid="2CH 24:25" /><verse number="26" style="v" sid="2CH 24:26" />जिने तेस साथे राजद्रोह री साजिश कित्ती, सेयो यो थे, मतलब अम्मोनी, शिमातो रा पाऊ जाबाद ओर शिम्रित, मोआबिनो रा पाऊ यहोजाबाद। <verse eid="2CH 24:26" /><verse number="27" style="v" sid="2CH 24:27" />तेसरे पाऊआ रे बारे दे ओर तेसरे खलाफ, जो बड़े दण्डो री भविष्यबाणी ऊई, तिजी रे ओर परमेशरो रा मन्दर बणने रे बारे दे, यो सब गल्ला राजेया रे इतियासो री कताबा रे लिखी राखिया। तेबे तेसरा पाऊ अमस्याह तेसरी जगा पाँदे राजा बणेया।<verse eid="2CH 24:27" /></para>
  <chapter eid="2CH 24" />
  <chapter number="25" style="c" sid="2CH 25" />
  <para style="s">यहूदा दे अमस्याह रा राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 25:1" />जेबे अमस्याह राज करने लगेया तेबे से पच्चीया साला रा था ओर यरूशलेम शईरो दे ऊणत्तिया साला तक राज करदा रया। ओर तेसरी माया रा नाओं यहोअद्दान था, जो यरूशलेम शईरो री थी। <verse eid="2CH 25:1" /><verse number="2" style="v" sid="2CH 25:2" />तिने से कित्तेया जो यहोवे री नजरा रे ठीक ए, पर खरे मनो ते नि कित्तेया। <verse eid="2CH 25:2" /><verse number="3" style="v" sid="2CH 25:3" />जेबे राज्य तेसरे आथो रे आईगा, तेबे तिने आपणे सेयो कर्मचारी काईते, जिने तेसरा बाओ राजा काया था। <verse eid="2CH 25:3" /><verse number="4" style="v" sid="2CH 25:4" />पर तिने तिना रे बाल़क नि काये, कऊँकि तिने यहोवे री तेसा आज्ञा रे मुताबिक कित्तेया, जो मूसे री बिधानो री कताबा दे लिखी राखेया, “पाऊआ रिया बजा ते माये-बाओ नि काणे ओर ना माया-बाओ रिया बजा ते बच्चे काणे, जिने पाप करी राखेया ओ, सेई तेस पापो रिया बजा ते काणा।”<note caller="+" style="f"><char style="fr" closed="false">25:4 </char><char style="ft" closed="false">बिध. 24:16</char></note><verse eid="2CH 25:4" /></para>
  <para style="s">एदोमो रे खलाफ अमस्याहो रा युद्ध</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 25:5" />तेबे अमस्याहे यहूदा प्रदेशो रे सारे लोक कट्ठे कित्ते। तिना रे हर एकी कुलो खे तिने 1,000 मर्दा पाँदे ओर 100 मर्दा पाँदे तिना री अगुआई करने खे अधिकारी राखे। तिने यहूदा रे गोत्रो रे कुला ओर बिन्यामीन गोत्रो रे कुला खे एड़ा कित्तेया। तिने तिना सबी मर्दा री गिणती कित्ती जो बी साल या तेते ते जादा उम्रा रे थे जो बड़छे ओर ढाला लई की लड़ी सको थे। तिना री गिणती 300,000 थी। <verse eid="2CH 25:5" /><verse number="6" style="v" sid="2CH 25:6" />तेबे तिने 100,000 इस्राएली शूरवीर बी 3,400 किलो चाँदी देई की बुलाए। <verse eid="2CH 25:6" /><verse number="7" style="v" sid="2CH 25:7" />पर परमेशरो रे एकी पग्ते तेसगे आई की बोलेया, “ओ राजा इस्राएलो री सेना तां साथे जाई नि सकणी, कऊँकि यहोवा इस्राएल, मतलब एप्रैमो री सारी ल्वादा साथे नि रंदा। <verse eid="2CH 25:7" /><verse number="8" style="v" sid="2CH 25:8" />अगर तूँ जाई की आपू खे तागतबर बणाए ओर युद्ध करने खे ईम्मत दखाए, तेबे बी परमेशरो तूँ दुश्मणा सामणे रूड़ाणा, कऊँकि जीत ओर आर तो परमेशरो रे आथो देई ए।”<verse eid="2CH 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 25:9" />अमस्याहे परमेशरो रे दासो ते पूछेया, “तेबे जो 34,000 किलो चाँदी आऊँ इस्राएली दलो खे देई चुकेया रा, तेतेरे बारे दे क्या करुँ?” परमेशरो रे दासे बोलेया, “यहोवा ताखे तिजी ते बी जादा देई सकोआ।” <verse eid="2CH 25:9" /><verse number="10" style="v" sid="2CH 25:10" />तेबे अमस्याहे से दल जो एप्रैमो री तरफा ते तेसगे आया था, लग कित्तेया ताकि सेयो आपणी जगा खे वापस ऊई जाओ। तेबे तिना रा रोष यहूदिया पाँदे बऊत पड़केया ओर सेयो बऊत रोषे ऊई की आपणी जगा खे वापस ऊईगे। <verse eid="2CH 25:10" /><verse number="11" style="v" sid="2CH 25:11" />पर अमस्याह याओ बानी की आपणे लोका खे लई चलेया ओर लूणो रिया काअटिया गे जाई की, 10,000 सेईरी लोक काईते। <verse eid="2CH 25:11" /><verse number="12" style="v" sid="2CH 25:12" />यहूदिये 10,000 बन्दी बणाई की चट्टानी री चूँडिया पाँदे लईगे ओर चट्टानी रिया चूँडिया पाँदा ते रूड़ाईते ओर सेयो सारे चूर-चूर ऊईगे। <verse eid="2CH 25:12" /><verse number="13" style="v" sid="2CH 25:13" />पर तेस दलो रे मर्द जो अमस्याहे वापस करीते थे कि सेओ तेस साथे युद्ध करने खे नि जाओ, सामरिया ते बेथोरोन तक यहूदा रे सारे शईरा दे टूटे ओर तेती 3,000 रणे वाल़े लोक काईते ओर बऊत लूट लई ली। <verse eid="2CH 25:13" /><verse number="14" style="v" sid="2CH 25:14" />जेबे अमस्याह एदोमिया रा नाश करी की वापस आया, तेबे तिने सेईरिया रे देवतेया खे ल्याई की आपणे देवता करी की खड़ा कित्तेया ओर तिना रे ई सामणे माथा टेकणे ओर तूप बाल़ने लगेया।<verse eid="2CH 25:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 25:15" />तेबे यहोवे रा रोष अमस्याह पाँदे पड़केया ओर तिने तेसगे एक नबी पेजेया जिने तेसखे बोलेया, “जो देवता आपणे लोका खे तेरे आथो ते नि बचाई सको, तिना री टोल़ा दे तूँ कऊँ लगी रा?” <verse eid="2CH 25:15" /><verse number="16" style="v" sid="2CH 25:16" />से तेसखे बोलणे ई लगी रा था कि तिने तेसते पूछेया, “क्या आसे तूँ राजे खे सला देणे वाल़ा बणाई राखेया? चुप रओ! क्या तूँ मरना चाएआ?” तेबे से नबी ये चतौणी देई की चुप ऊईगा, “माखे पता ए कि परमेशरे तेरा नाश करने री ठाणी ली दी ए, कऊँकि तैं एड़ा करी राखेया ओर मेरी सलाह् नि मानी।”<verse eid="2CH 25:16" /></para>
  <para style="s">इस्राएलो रे खलाफ अमस्याह रा युद्ध</para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 25:17" />तेबे यहूदा रे राजे अमस्याहे सलाह् लई की, इस्राएलो रे राजा योआशो गे, जो येहूए रा पोता ओर यहोआहाजो रा पाऊ था, ये सन्देसा पेजेया, “आओ आसे एकी दूजे रा सामणा करूँए।” <verse eid="2CH 25:17" /><verse number="18" style="v" sid="2CH 25:18" />इस्राएलो रे राजा योआशे यहूदा रे राजा अमस्याह गे ये सन्देसा पेजेया, “लबानोनो री एक झड़बेरिये एक देवदारो गे सन्देसा पेजेया, ‘आपणी बेटी मेरे माठे खे ब्यायी दे, तदुओ खे लबानोनो रा एक बणो रा जानवर तिसिये गया ओर से झड़बेरी आपणे पैरे की केसी ती।’ <verse eid="2CH 25:18" /><verse number="19" style="v" sid="2CH 25:19" />तूँ बोलेया कि मैं एदोमी जीती ले रे, इजी बजा ते तूँ फूलणे लगी रा ओर ओछपण करने लगी रा! आपणे कअरे रयी जा; तूँ आपणे नुकशाण करने खे एती आथ कऊँ पाणे लगी रा, इजी ते तां तो क्या यहूदा खे बी निठा देखणा पड़ना।” <verse eid="2CH 25:19" /><verse number="20" style="v" sid="2CH 25:20" />पर अमस्याह नि मानेया। ये तो परमेशरो री तरफा ते ऊआ, ताकि से तिना खे तिना रे दुश्मणा रे आथो दे करी देयो, कऊँकि सेयो एदोमो रे देवतेया री टोल़ा रे लगी गे थे। <verse eid="2CH 25:20" /><verse number="21" style="v" sid="2CH 25:21" />तेबे इस्राएलो रे राजा यहोआशे चढ़ाई कित्ती ओर तिने ओर यहूदा रे राजा अमस्याहे यहूदा प्रदेशो रे बेतशेमेश शईरो दे एकी-दूजे रा सामणा कित्तेया। <verse eid="2CH 25:21" /><verse number="22" style="v" sid="2CH 25:22" />यहूदा इस्राएलो ते आरी गा ओर हर एक आपणे-आपणे डेरे खे नठी गा। <verse eid="2CH 25:22" /><verse number="23" style="v" sid="2CH 25:23" />तेबे इस्राएलो रे राजे योआशे यहूदा रे राजे, अमस्याह खे जो यहोआहाजो रा पोता ओर यहोआशो रा पाऊ था, बेतशेमेशो रे पकड़ेया ओर यरूशलेम शईरो खे लईगा ओर यरूशलेम शईरो री दवाला खे एप्रैमी बड़े द्वारो ते कूणे वाल़े बड़े द्वारो तक 600 फुट टाल़ी ती। <verse eid="2CH 25:23" /><verse number="24" style="v" sid="2CH 25:24" />ओर जितणा सूईना चाँदी ओर जितणे पांडे परमेशरो रे मन्दरो रे ओबेदेदोमो गे मिले ओर राजमईलो रे जितणा खजाना था, तिना सबी खे ओर बन्दी लोका खे बी लई की से सामरिया खे वापस ऊईगा।<verse eid="2CH 25:24" /></para>
  <para style="s">अमस्याहो री मौत</para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 25:25" />यहोआहाजो रे पाऊ इस्राएलो रे राजा योआशो रे मरने ते बाद तेसरा पाऊ यहूदा रा राजा अमस्याह पंद्रा साल तक जिऊँदा रया। <verse eid="2CH 25:25" /><verse number="26" style="v" sid="2CH 25:26" />शुरूओ ते लई की अन्तो तक अमस्याह रे ओर काम, यहूदा ओर इस्राएलो रे राजेया रे इतियासो री कताबा रे लिखी राखे। <verse eid="2CH 25:26" /><verse number="27" style="v" sid="2CH 25:27" />जेस बखते अमस्याहे परमेशरो पीछे चलणा छाडीता था तेस बखतो ते यरूशलेम शईरो रे तिना रे खलाफ साजिश ऊणे लगी ओर से लाकीश शईरो खे नठी गा। तेबे दूते लाकीशो तक तेसरा पीछा करी की, से तेथी काई ता। <verse eid="2CH 25:27" /><verse number="28" style="v" sid="2CH 25:28" />सेयो तेसरी लाशा खे कोड़ेया पाँदे राखी की यरूशलेम शईरो खे वापस लई की आए। ओर से तेसरे बुजुर्गा साथे यहूदा रे शईरो दे दबाईता।<verse eid="2CH 25:28" /></para>
  <chapter eid="2CH 25" />
  <chapter number="26" style="c" sid="2CH 26" />
  <para style="s">यहूदा दे उज्जियाह रा राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 26:1" />तेबे यहूदा प्रदेशो री सारी प्रजे उज्जियाह खे लई की जो सोल़ा साला रा था, तेसरे बाओ अमस्याह री जगा दे नवां राजा बणाया। <verse eid="2CH 26:1" /><verse number="2" style="v" sid="2CH 26:2" />जेबे राजा अमस्याह मरीगा, तेबे उज्जियाहे एलोत शईर दुबारा बणाई की यहूदा दे फेर मलाई ता। <verse eid="2CH 26:2" /><verse number="3" style="v" sid="2CH 26:3" />जेबे उज्जियाह राज करने लगेया, तेबे से सोल़ा साला रा था ओर यरूशलेम शईरो रे बूँजा साला तक राज करदा रया। तेसरी माया रा नाओं यकोल्याह था, जो यरूशलेम शईरो री थी। <verse eid="2CH 26:3" /><verse number="4" style="v" sid="2CH 26:4" />जेड़ा तेसरा बाओ अमस्याह करेया करो था तेड़ा ई तिने बी कित्तेया जो यहोवे री नजरा रे ठीक था। <verse eid="2CH 26:4" /><verse number="5" style="v" sid="2CH 26:5" />जकर्याह पुरोईतो रे दिना रे जो परमेशरो रे दर्शणो रे बारे रे समज राखो था; से परमेशरो री टोल़ा रे लगेया रा रओ था ओर जदुओ तक से यहोवे री टोल़ा रे लगेया रा रया, तदुओ तक परमेशरे तेसखे सफलता दित्ती।<verse eid="2CH 26:5" /></para>
  <para style="s">उज्जियाहो रे काम</para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 26:6" />तेबे तिने जाई की पलिश्तिया साथे युद्ध कित्तेया ओर गत, यब्‍ने ओर अशदोदो री दवाला रूड़ाई तिया ओर अशदोदो रे नेड़े-तेड़े ओर पलिश्तिया बीचे शईर बसाए। <verse eid="2CH 26:6" /><verse number="7" style="v" sid="2CH 26:7" />परमेशरे पलिश्ती ओर गूर्बाला रे रणे वाल़े, अरबी ओर मूनिया रे खलाफ तेसरी मताद कित्ती। <verse eid="2CH 26:7" /><verse number="8" style="v" sid="2CH 26:8" />तेबे अम्मोनी उज्जियाह राजे खे पेंट देणे लगे, बल्कि तेसरी कीर्ति मिस्रो रे बन्ने तक बी फैली गी, कऊँकि से बऊत तागतबर ऊईगा था। <verse eid="2CH 26:8" /><verse number="9" style="v" sid="2CH 26:9" />फेर उज्जियाहे यरूशलेम शईरो रे कूणे रे बड़े द्वार ओर तराईया रे बड़े द्वार ओर दवाला रे मोड़ो पाँदे गुम्मट बणाई की मजबूत कित्ते। <verse eid="2CH 26:9" /><verse number="10" style="v" sid="2CH 26:10" />तेसगे बऊत डांगर थे इजी री खातर तिने उजाड़ जगा दे ओर थालली जगा ओर चौरस जगा रे गुम्मट बणवाए ओर बऊत सारे अऊद खणाए ओर पाह्ड़ो पाँदे ओर कर्मेलो रे पाह्ड़ो दे तेसरे जिम्मीदार ओर अंगूरा रे बगीचेया रे माली थे, कऊँकि तेसखे जिम्मीदारा पसंद था। <verse eid="2CH 26:10" /><verse number="11" style="v" sid="2CH 26:11" />तेबे उज्जियाह रे योद्धा री एक सेना थी जिना री गिणती यीएल मुंशी ओर मासेयाह सरदार, हनन्याह नाओं रे राजे रे एक परदानो री आज्ञा ते करो थे ओर तेसरे मुताबिक सेयो दल बानी की लड़ने खे जाओ थे। <verse eid="2CH 26:11" /><verse number="12" style="v" sid="2CH 26:12" />पितरा रे कराने रे खास-खास मर्द जो शूरवीर थे, तिना री पूरी गिणती 2,600 थी। <verse eid="2CH 26:12" /><verse number="13" style="v" sid="2CH 26:13" />तिना रे कब्जे दे 307,500 सिपाईया री एक बड़ी सेना थी, जो दुश्मणा रे खलाफ राजे री मताद करने खे बड़ी तागती साथे युद्ध करने वाल़े थे। <verse eid="2CH 26:13" /><verse number="14" style="v" sid="2CH 26:14" />इना खे, मतलब पूरी सेना खे उज्जियाहे ढाला, बड़छे, टोप, कवच, तीरक-बाण ओर गूलेला रे पात्थर त्यार कित्ते। <verse eid="2CH 26:14" /><verse number="15" style="v" sid="2CH 26:15" />तेबे तिने यरूशलेम शईरो रे गुम्मटो री चूँडिया पाँदे राखणे खे उशयार मर्दा रे निकयाल़े रे यन्त्र बी बणवाए जिना रे जरीये तीर ओर बड़े-बड़े पात्थर सेटे जाओ थे। तेसरा नाओं दूरो-दूरो तक फैलीगा, कऊँकि तेसखे अद्भुत मताद एथो तक मिली कि से तागतबर ऊईगा।<verse eid="2CH 26:15" /></para>
  <para style="s">राजा उज्जियाहो रा कमण्ड ओर तेसरी सजा</para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 26:16" />पर जेबे से तागतबर ऊईगा, तेबे से बऊत कमण्डी ऊईगा ओर तिने बिगड़ी की आपणे परमेशर यहोवे साथे विश्वासघात कित्तेया, मतलब से तूपो री बेदिया पाँदे तूप बाल़ने खे परमेशरो रे मन्दरो रे कूसी गा। <verse eid="2CH 26:16" /><verse number="17" style="v" sid="2CH 26:17" />पर अजर्याह पुरोईत तेसते बाद पीतरे गया ओर तेस साथे यहोवे रे अस्सी पुरोईत बी जो वीर थे गये। <verse eid="2CH 26:17" /><verse number="18" style="v" sid="2CH 26:18" />तिने उज्जियाह राजे रा सामणा करी की तेसखे बोलेया, “ओ उजिय्याह, यहोवे खे तूप बाल़ना तेरा काम नि ए, हारूणो री ल्वाद, मतलब तिना पुरोईता रा ई काम ए, जो तूप बाल़ने खे पवित्र करी राखे। तूँ पवित्र जगा ते निकल़ी जा, तैं विश्वासघात करी राखेया, परमेशर यहोवे रिया तरफा ते ये तेरी महिमा री बजा नि ऊणी।” <verse eid="2CH 26:18" /><verse number="19" style="v" sid="2CH 26:19" />तेबे उज्जियाह तूप बाल़ने खे तूपदान आथो रे लई की रोषे ऊआ ओर से पुरोईता पाँदे रोषे ऊणे लगी रा था कि पुरोईता सामणे-सामणे यहोवे रे मन्दरो रे तूपो री बेदिया गेई तेसरे माथे पाँदे कोढ़ निकल़ेया। <verse eid="2CH 26:19" /><verse number="20" style="v" sid="2CH 26:20" />अजर्याह बड़े पुरोईते ओर सबी पुरोईते से देखेया, तेबे तिने क्या देखेया कि तेसरे माथे पाँदे कोढ़ निकल़ी रा। तेबे तिने से तेथा ते फटाफट निकयाल़ी ता, बल्कि ये जाणी की कि परमेशरे आऊँ कोढ़ी करी ता रा, तिने आपू बारे जाणे री जल्दबाजी कित्ती। <verse eid="2CH 26:20" /><verse number="21" style="v" sid="2CH 26:21" />उज्जियाह राजा मरने रे दिनो तक कोढ़ी रया ओर कोढ़ो रिया बजा ते एक लग कअरो रे रओ था, से तो यहोवे रे मन्दरो रे नि जाई सको था। ओर तेसरा पाऊ योताम राजकराने रे कामो पाँदे नियुक्त कित्तेया ओर से लोका रा न्याय बी करो था। <verse eid="2CH 26:21" /><verse number="22" style="v" sid="2CH 26:22" />शुरूओ ते लई की अन्तो तक उज्जियाह रे ओर कामा रा वर्णन तो आमोसो रे पाऊ यशायाह नबीए लिखी राखेया। <verse eid="2CH 26:22" /><verse number="23" style="v" sid="2CH 26:23" />अन्तो रे उज्जियाह मरी की आपणे बुजुर्गा साथे मिलीगा ओर तेसखे तेसरे बुजुर्गा रे नेड़े राजेया खे माट्टी देणे रे डोरूए रे माट्टी दित्ती, कऊँकि तिने बोलेया, “से कोढ़ी ए।” तेबे तेसरा पाऊ योताम तेसरी जगा पाँदे राज करने लगेया।<verse eid="2CH 26:23" /></para>
  <chapter eid="2CH 26" />
  <chapter number="27" style="c" sid="2CH 27" />
  <para style="s">यहूदा दे योतामो रा राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 27:1" />जेबे योताम राज करने लगेया, तेबे से पच्ची साला रा था ओर यरूशलेम शईरो रे सोल़ा साला तक राज करदा रया। ओर तेसरी माया रा नाओं यरूशा था, जो सादोक पुरोईतो री बेटी थी। <verse eid="2CH 27:1" /><verse number="2" style="v" sid="2CH 27:2" />तिने से कित्तेया, जो यहोवे री नजरा रे ठीक ए, मतलब जेड़ा तेसरे बाओ उज्जियाहे कित्तेया था, ठीक तेड़ा ई तिने बी कित्तेया, तेबे बी से यहोवे रे मन्दरो रे नि कूसेया ओर प्रजा रे लोका री चाल तेबे बी बिगड़ी री थी। <verse eid="2CH 27:2" /><verse number="3" style="v" sid="2CH 27:3" />तिने ई यहोवे रे मन्दरो पाँदला बड़ा द्वार बणाया ओर ओपेल पाह्ड़ो री दवाला पाँदे बी बऊत कुछ बणाया। <verse eid="2CH 27:3" /><verse number="4" style="v" sid="2CH 27:4" />तेबे तिने यहूदा री पाह्ड़िया पाँदे कई शईर मजबूत कित्ते ओर बणो दे किले ओर गुम्मट बणाए। <verse eid="2CH 27:4" /><verse number="5" style="v" sid="2CH 27:5" />से अम्मोनिया रे राजे साथे युद्ध करी की तिना पाँदे तागतबर ऊआ। तेस ई साले अम्मोनिये तेसखे लगभग 3,400 किलो चाँदी ओर लगभग 1,000 टन कणक ओर लगभग 1,000 टन जौ दित्तेया। तेबे दूजे ओर तीजे साले बी तिने तेसखे तिथणा ई दित्तेया। <verse eid="2CH 27:5" /><verse number="6" style="v" sid="2CH 27:6" />ईंयाँ योताम सामर्थी ऊईगा, कऊँकि से आपणे आपू खे परमेशरो सामणे जाणी की सीदी चाल चलो था। <verse eid="2CH 27:6" /><verse number="7" style="v" sid="2CH 27:7" />योतामो रे ओर काम ओर तेसरे सारे युद्ध ओर तेसरा चाल-चलण, इना सबी गल्ला रा लेखा इस्राएल ओर यहूदा रे राजेया री इतियासो री कताबा रे लिखी राखेया। <verse eid="2CH 27:7" /><verse number="8" style="v" sid="2CH 27:8" />जेबे से राजा बणेया, तेबे से पच्ची साला रा था ओर से यरूशलेम शईरो रे सोल़ा साल तक राज करदा रया। <verse eid="2CH 27:8" /><verse number="9" style="v" sid="2CH 27:9" />अन्तो रे योताम मरी गा ओर से दाऊदो रे शईरो दे दबाईता। तेबे तेसरा पाऊ आहाज तेसरी जगा पाँदे यहूदा देशो दे राज करने लगेया।<verse eid="2CH 27:9" /></para>
  <chapter eid="2CH 27" />
  <chapter number="28" style="c" sid="2CH 28" />
  <para style="s">यहूदा दे आहाजो रा राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 28:1" />जेबे आहाज राजा यहूदा पाँदे राज करने लगेया, तेबे से बीई साला रा था ओर सोल़ा साला तक यरूशलेम शईरो रे राज करदा रया। ओर आपणे मूलमर्द दाऊदो जेड़ा खरा काम नि कित्तेया, जो यहोवे री नजरा रे ठीक था, <verse eid="2CH 28:1" /><verse number="2" style="v" sid="2CH 28:2" />पर तिने इस्राएलो रे राजेया जेड़े बुरे काम कित्ते ओर बाल देवतेया रिया मूर्तिया कअड़ी की बणवाईया जिना ते यहोवा नफरत करो था, <verse eid="2CH 28:2" /><verse number="3" style="v" sid="2CH 28:3" />ओर हिन्नोमो रे पाऊए री काअटिया दे तूप बाल़ेया ओर तिना जातिया रे बुरे कामो रे मुताबिक, जो यहोवे इस्राएली लोका रे सामणे ते देशो ते बारे निकयाल़े थे, आपणे बच्चे आगी दे बलि करीते। <verse eid="2CH 28:3" /><verse number="4" style="v" sid="2CH 28:4" />ऊच्ची जगा पाँदे ओर पाह्ड़िया पाँदे ओर सबी अरे डाल़ा रे थाले से बलि चढ़ाओ था ओर तूप बाल़ेया करो था।<verse eid="2CH 28:4" /></para>
  <para style="s">यहूदा पाँदे अमला</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 28:5" />आहाजे पाप कित्तेया, इजी बजा ते तेसरे यहोवा परमेशरे से अरामिया रे राजेया रे आथो दे करी ता ओर सेयो तेसखे जीती की, तेसरे बऊत सारे लोका खे बन्दी बणाई की दमिश्को खे लईगे। ओर से इस्राएली लोका रे राजेया रे वशो रे करी ता, जिने से बड़ी बुरी तरअ ते काया। <verse eid="2CH 28:5" /><verse number="6" style="v" sid="2CH 28:6" />रमल्याह रे पाऊ पेकहे, यहूदा दे एक ई दिने 120,000 लोका खे जो सारे के सारे वीर थे, काये, कऊँकि तिने आपणे पितरा रा यहोवा परमेशर छाडीता था। <verse eid="2CH 28:6" /><verse number="7" style="v" sid="2CH 28:7" />जिक्री नाओं रे एक एप्रैमी वीरे मासेयाह नाओं रा एक राजकुमार ओर राजमईलो रा परदान अज्रीकाम ओर एलकाना खे, जो राजे रा मंत्री था, काईता।<verse eid="2CH 28:7" /></para>
  <para style="s">नबी ओदेद</para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 28:8" />इस्राएली आपणे पाईया बीचा ते जवाणसा ओर माठे-बेटिया खे मिलाई की 200,000 लोका खे बन्दी बणाई की ओर तिना री बऊत सारी लूट लई की सामरिया रिया तरफा खे लईगे। <verse eid="2CH 28:8" /><verse number="9" style="v" sid="2CH 28:9" />पर तेती ओदेद नाओं रा यहोवे रा एक नबी था; से सामरिया शईरो खे आऊणे वाल़ी सेना साथे मिली की बोलणे लगेया, “सुणो, तुसा रे पितरा रे यहोवा परमेशरे यहूदिया ते गुस्से ऊई की सेयो तुसा रे वशो दे करी राखे ओर तुसे तिना खे एड़ा गुस्सा करी की सेयो एड़े कायल कित्ते कि जिना रा चींगणा स्वर्गो दे पऊँची गा। <verse eid="2CH 28:9" /><verse number="10" style="v" sid="2CH 28:10" />एबे तुसे ठाणी ला रा कि यहूदिया खे ओर यरूशलेम शईरो दे रणे वाल़ेया खे आपणा दास बणाई की तिना खे दबाई की राखो। क्या तुसे बी आपणे परमेशर यहोवे सामणे दोषी नि ए? <verse eid="2CH 28:10" /><verse number="11" style="v" sid="2CH 28:11" />इजी री खातर एबे मेरी सुणो ओर इना बन्दिया खे जिना खे तुसे आपणे पाईया बीचा ते बन्दी बणाई की ली आई रे, वापस करी देयो, नई तो यहोवा बऊत रोषे ऊणा ओर तेस तुसा खे सजा देणी।” <verse eid="2CH 28:11" /><verse number="12" style="v" sid="2CH 28:12" />तेबे एप्रैमिया रे कुछ खास मर्द, मतलब योहानानो रा पाऊ अजर्याह, मशिल्लेमोतो रा पाऊ बेरेक्याह, शल्लूमो रा पाऊ यहिजकिय्याह ओर हदलै रा पाऊ अमासा, लड़ाईया ते आऊणे वाल़ेया रा सामणा करी की तिना खे बोलणे लगे, <verse eid="2CH 28:12" /><verse number="13" style="v" sid="2CH 28:13" />“तुसे इना बन्दिया खे एती नि ल्याओ, कऊँकि तुसे ये गल्ल ठाणी राखी, जेते कि आसे यहोवे सामणे दोषी ऊई जाणे ओर जेते कि म्हारा पाप ओर दोष बढ़ी जाणा, म्हारा दोष तो बड़ा ए ओर इस्राएलो पाँदे बऊत बड़ा गुस्सा पड़की रा।” <verse eid="2CH 28:13" /><verse number="14" style="v" sid="2CH 28:14" />तेबे तिने सिपाईए बन्दी ओर लूट परदाना ओर सारी सभा सामणे छाडी ती। <verse eid="2CH 28:14" /><verse number="15" style="v" sid="2CH 28:15" />तेबे जिना मर्दा रे नाओं ऊबे लिखी राखे तिने उठी की बन्दी लई ले ओर लूटा बीचा ते सबी नांगे लोका खे टाल्ले ओर जोड़े पन्याए ओर रोटी खुल़ाई ओर पाणी पल़्याया ओर तेल मल़ेया ओर तेबे कमजोर लोक गह्देया पाँदे चढ़ाई की यरीहो खे, जेतेखे खजूरो रा शईर बोलोए, तिना रे पाईया गे पऊँचाई ते। तेबे सेयो सामरिया खे वापस आए।<verse eid="2CH 28:15" /></para>
  <para style="s">राजा आहाजो रा अश्शूरो रे राजे ते मताद मांगणा</para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 28:16" />तेस बखते आहाज राजे अश्शूरो रे राजेया गे दूत पेजी की मताद मांगी। <verse eid="2CH 28:16" /><verse number="17" style="v" sid="2CH 28:17" />कऊँकि एदोमिये यहूदा दे आई की तेस पाँदे हमला कित्तेया ओर बन्दिया खे लईगे थे। <verse eid="2CH 28:17" /><verse number="18" style="v" sid="2CH 28:18" />तेबे पलिश्तिये थालले देश ओर यहूदा रे दक्खण देशो रे शईरा पाँदे चढ़ाई करी की, बेतशेमेश शईर, अय्यालोन ओर गदेरोत शईरो खे ओर आपणे-आपणे गाँवो समेत सोको, तिम्नाह ओर गिमजो खे लई ला ओर तिना रे रणे लगे। <verse eid="2CH 28:18" /><verse number="19" style="v" sid="2CH 28:19" />ईंयाँ यहोवे इस्राएलो रे राजा आहाजो रिया बजा ते यहूदा खे सजा दित्ती, कऊँकि तिने यहोवे री आज्ञा नि मानी। <verse eid="2CH 28:19" /><verse number="20" style="v" sid="2CH 28:20" />तेबे अश्शूरो रा राजा तिग्लत्पिलेसेर यहूदा दे आया, ओर तिने मताद करने रे बदले मोके रा फाईदा चकी की तेसखे कष्ट दित्तेया। <verse eid="2CH 28:20" /><verse number="21" style="v" sid="2CH 28:21" />आहाजे तो यहोवे रे मन्दर ओर राजमईल ओर परदाना रे कअरो ते तअन निकयाल़ी की अश्शूरो रे राजे खे दित्तेया, पर इजी ते तेसरी कोई मताद नि ऊई।<verse eid="2CH 28:21" /></para>
  <para style="s">आहाजो रे पाप ओर तेसरी मौत</para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 28:22" />क्ल़ेशो रे बखते आहाज राजे यहोवे साथे ओर बी विश्वासघात कित्तेया। <verse eid="2CH 28:22" /><verse number="23" style="v" sid="2CH 28:23" />तिने दमिश्को रे देवतेया खे, जिने से काया था, बलि चढ़ाया, कऊँकि तिने ये सोचेया कि अरामी राजेया रे देवते तिना री मताद कित्ती, तो मां तिना खे बलि चढ़ाणे, ताकि सेयो मेरी मताद करो। पर सेयो बलि तेसरे ओर सारे इस्राएलो रे नाशो री बजा ऊए। <verse eid="2CH 28:23" /><verse number="24" style="v" sid="2CH 28:24" />तेबे आहाज राजे परमेशरो रे मन्दरो रे पांडे कट्ठे करी की तुड़वाए ओर यहोवे रे मन्दरो रे द्वार बन्द करीते ओर यरूशलेम शईरो रे सबी कूणेया रे बेदिया बणाईया। <verse eid="2CH 28:24" /><verse number="25" style="v" sid="2CH 28:25" />यहूदा रे एकी-एकी शईरो दे तिने पराये देवतेया खे तूप बाल़ने खे ऊच्चिया जगा बणाईया ओर आपणे पितरा रे परमेशर यहोवे खे रोष चढ़ाया। <verse eid="2CH 28:25" /><verse number="26" style="v" sid="2CH 28:26" />तेसरे ओर काम ओर शुरूओ ते लई की अन्तो तक तेसरा पूरे चाल-चलणो रे बारे रे यहूदा ओर इस्राएलो रे राजेया रे इतियासो री कताबा रे लिखी राखेया। <verse eid="2CH 28:26" /><verse number="27" style="v" sid="2CH 28:27" />अन्तो दे आहाज राजा मरीगा ओर से यरूशलेम शईरो दे दबाईता, पर से इस्राएलो रे राजेया रे कब्रिस्तानो दे नि दबाया। तेबे तेसरा पाऊ हिजकिय्याह तेसरी जगा पाँदे नवां राजा बणेया।<verse eid="2CH 28:27" /></para>
  <chapter eid="2CH 28" />
  <chapter number="29" style="c" sid="2CH 29" />
  <para style="s">यहूदा दे हिजकिय्याह रा राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 29:1" />जेबे हिजकिय्याह राज करने लगेया, तेबे से पच्ची साला रा था ओर उणत्ती साला तक यरूशलेम शईरो रे राज करदा रया। तेसरी माया रा नाओं अबिय्याह था, जो जकर्याह री बेटी थी। <verse eid="2CH 29:1" /><verse number="2" style="v" sid="2CH 29:2" />जेड़ा तेसरे मूलमर्द दाऊदे कित्तेया था, मतलब जो यहोवे री नजरा दे ठीक था, तेड़ा ई तिने बी कित्तेया।<verse eid="2CH 29:2" /></para>
  <para style="s">मन्दरो खे शुद्ध करना</para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 29:3" />आपणे राज्य रे पईले सालो रे पईले मीन्ने रे तिने यहोवे रे मन्दरो रे द्वार खुलाईते ओर तिना री मरम्मत बी कराई। <verse eid="2CH 29:3" /><verse number="4" style="v" sid="2CH 29:4" />तेबे तिने पुरोईत ओर लेवी ल्याई की पूर्वो रे चौको रे कट्ठे कित्ते <verse eid="2CH 29:4" /><verse number="5" style="v" sid="2CH 29:5" />ओर तिना खे बोलणे लगेया, “ओ लेवियो, मेरी सुणो! एबे आपू-आपू खे पवित्र करो ओर आपणे बुजुर्गा रे परमेशर यहोवे रे मन्दरो खे फेर पवित्र करो ओर पवित्र जगा ते मैल निकयाल़ो। <verse eid="2CH 29:5" /><verse number="6" style="v" sid="2CH 29:6" />देखो, म्हारे बुजुर्गे विश्वासघात करी की से काम कित्तेया, जो म्हारे यहोवा परमेशरो री नजरा रे बुरा था ओर तिने से छाडी की तेसरे मन्दरो ते मूँ फेरी की तेसखे पीठ दखाई थी। <verse eid="2CH 29:6" /><verse number="7" style="v" sid="2CH 29:7" />तेबे तिने बरांडे रे द्वार बन्द कित्ते ओर दिऊए बजयाई ते ओर पवित्र जगा रे इस्राएलो रे परमेशरो खे ना तो तूप बाल़ेया ओर ना ई होमबलि चढ़ाया था।”<verse eid="2CH 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 29:8" />इजी री खातर यहोवे रा रोष यहूदा ओर यरूशलेम शईरो पाँदे पड़केया ओर तिने एड़ा कित्तेया कि सेयो मारे-मारे फिरे ओर सेयो लोका बीचे मजाको री बजा बणे, जेड़ा कि तुसे आपणी आखी ते देखणे लगी रे। <verse eid="2CH 29:8" /><verse number="9" style="v" sid="2CH 29:9" />देखो, इजी बजा ते म्हारे बुजुर्ग तलवारी साथे मरे ओर म्हारे माठे-बेटिया ओर जवाणसा गुलामिया रे चली गे। <verse eid="2CH 29:9" /><verse number="10" style="v" sid="2CH 29:10" />इजी री खातर मैं हिजकिय्याहे ये फैंसला करी राखेया कि इस्राएलो रे परमेशर यहोवे साथे वाचा बानूँ, ताकि तेसरा पड़केया रा गुस्सा आसा पाँदा ते दूर ऊई जाओ। <verse eid="2CH 29:10" /><verse number="11" style="v" sid="2CH 29:11" />ओ मेरे माठेयो, सुस्त नि बणो, देखो, यहोवे तुसे आपू सामणे खड़े रणे ओर आपणी सेवा-टईल करने ओर तूप बाल़ने रा काम करने खे चूणी राखे।<verse eid="2CH 29:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 29:12" />तेबे लेवीए परमेशरो रे मन्दरो दे काम करना शुरू कित्तेया। कहातिया रे कुलो बीचा ते अमासै रा पाऊ महत ओर अजर्याह रा पाऊ योएल। मरारिया रे कुलो बीचा ते अब्दिये रा पाऊ कीश, ओर यहल्लेलेलो रा पाऊ अजर्याह। गेर्शोनिया रे कुलो बीचा ते जिम्मा रा पाऊ योआह ओर योआह रा पाऊ एदेन। <verse eid="2CH 29:12" /><verse number="13" style="v" sid="2CH 29:13" />ओर एलीसापानो रे कुलो ते शिम्री ओर यूएल। आसापो रे कुलो ते जकर्याह ओर मत्तन्याह। <verse eid="2CH 29:13" /><verse number="14" style="v" sid="2CH 29:14" />ओर हेमानो रे कुलो बीचा ते यहीएल ओर शिमी। ओर यदूतूनो रे कुलो बीचा ते शमायाह ओर उज्जीएल। <verse eid="2CH 29:14" /><verse number="15" style="v" sid="2CH 29:15" />इने आपणे पाई कट्ठे कित्ते ओर आपू-आपू खे पवित्र करी की राजे री तेसा आज्ञा रे मुताबिक यहोवे रे मन्दरो खे शुद्ध करने खे से साफ कित्तेया, जेते रे बारे दे यहोवे राजा हिजकिय्याहो खे बोलेया था। <verse eid="2CH 29:15" /><verse number="16" style="v" sid="2CH 29:16" />तेबे पुरोईत परमेशरो रे मन्दरो रे पीतरले इस्से दे गये ओर तेतेखे शुद्ध करने खे तेती जितणिया बी अशुद्ध चीजा मिलिया तिना सबी खे निकयाल़ी की यहोवे रे मन्दरो रे आँगणो रे ली आए ओर लेविये सेयो चकी की बारे किद्रोनो रे नाल़े रे पऊँचाईया। <verse eid="2CH 29:16" /><verse number="17" style="v" sid="2CH 29:17" />पईले मीन्ने रे पईले दिने तिने पवित्र करने रा काम शुरू कित्तेया ओर तेस ई मीन्ने रे आठुए दिने यहोवे रे बरांडे तक आईगे। ईंयाँ तिने यहोवे रा मन्दर आठ दिना रे पवित्र कित्तेया ओर पईले मीन्ने रे सोल़ूए दिने तिने से काम पूरा कित्तेया। <verse eid="2CH 29:17" /><verse number="18" style="v" sid="2CH 29:18" />तेबे तिने राजा हिजकिय्याह गे पीतरे जाई की बोलेया, “आसे यहोवे रा पूरा मन्दर, पांडे समेत होमबलिया री बेदी ओर पेंटा री रोटिया री मेज बी शुद्ध करी ती री। <verse eid="2CH 29:18" /><verse number="19" style="v" sid="2CH 29:19" />जितणे पांडे आहाज राजे आपणे राज्य दे विश्वासघात करी की सेटी ते थे, सेयो बी आसे कट्ठे करी की पवित्र करीते ओर सेयो यहोवे री बेदिया सामणे राखी ते रे।”<verse eid="2CH 29:19" /></para>
  <para style="s">मन्दरो री दुबारा प्रतिष्ठता</para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 29:20" />तेबे राजा हिजकिय्याह प्यागा उठी की यरूशलेम शईरो रे परदाना खे कट्ठे करी की, परमेशरो रे मन्दरो खे गया। <verse eid="2CH 29:20" /><verse number="21" style="v" sid="2CH 29:21" />तेबे सेयो आपू साथे सात बाच्छू, सात पेड-बाकरिया, सात पेडा रे बच्चे ओर सात बाकरिया रे बच्चे लईगे। तिने सेयो जानवर राज्य, पवित्र जगा ओर यहूदा रे लोका रिया तँईं पापबलिया खे चढ़ाए। राजे हारूणो रे कुलो रे पुरोईता ते बोलेया, कि सेयो यहोवे रिया वेदिया पाँदे बलिदान चढ़ाओ। <verse eid="2CH 29:21" /><verse number="22" style="v" sid="2CH 29:22" />तेबे पुरोईते सात बाच्छू बलि कित्ते ओर पुरोईते तिना रा खून लई की बेदिया पाँदे छिड़की ता, तेबे तिने खाड्डू चढ़ाए ओर तिना रा खून बी बेदिया पाँदे छिड़की ता, तेबे तिने पेडा रे बच्चे बलि कित्ते ओर तिना रा खून बी बेदिया पाँदे छिड़की ता। <verse eid="2CH 29:22" /><verse number="23" style="v" sid="2CH 29:23" />तेबे सेयो पापबलिया रे बाकरेया खे राजा ओर मण्डल़िया रे नेड़े ल्याये ओर तिना पाँदे आपणे-आपणे आथ राखे। <verse eid="2CH 29:23" /><verse number="24" style="v" sid="2CH 29:24" />तेबे पुरोईते सेयो बलि करी की, तिना रा खून बेदिया पाँदे छिड़की की पापबलि कित्तेया, जेते कि सारे इस्राएलो रिया तँईं प्राश्चित करेया जाओ, कऊँकि राजे सारे इस्राएलो रिया तँईं होमबलि ओर पापबलि चढ़ाणे री आज्ञा दित्ती थी। <verse eid="2CH 29:24" /><verse number="25" style="v" sid="2CH 29:25" />इजी ते बाद तिने दाऊद ओर राजे रे दर्शी गाद ओर नातान नबीए री आज्ञा रे मुताबिक जो यहोवे रिया तरफा ते नबिया रे जरीये आई थी, खंजरी, सारंगिया ओर बीणा लई की लेवी यहोवे रे मन्दरो रे खड़े कित्ते। <verse eid="2CH 29:25" /><verse number="26" style="v" sid="2CH 29:26" />तेबे लेविये दाऊदो रे चलाए रे बाजे लई की ओर पुरोईत तुरहिया लई की खड़े ऊए। <verse eid="2CH 29:26" /><verse number="27" style="v" sid="2CH 29:27" />तेबे हिजकिय्याह राजे बेदिया पाँदे होमबलि चढ़ाणे री आज्ञा दित्ती ओर जेबे होमबलि चढ़ने लगी, तेबे यहोवे रा गीत शुरू ऊआ ओर तुरहिया ओर इस्राएलो रे दाऊद राजे रे बाजे बजणे लगे; <verse eid="2CH 29:27" /><verse number="28" style="v" sid="2CH 29:28" />ओर मण्डल़िया रे सारे लोक माथा टेकदे ओर गाणे वाल़े गांदे ओर तुरहिया बजाणे वाल़े बजांदे रये, ये सब तदुओ तक ऊँदा रया, जदुओ तक होमबलि चढ़ी नि चूकी। <verse eid="2CH 29:28" /><verse number="29" style="v" sid="2CH 29:29" />जेबे बलि चढ़ी चूकी, तेबे राजा ओर जितणे जणे तेस साथे तेती थे, तिने सबी सिर चुकाई की माथा टेकेया। <verse eid="2CH 29:29" /><verse number="30" style="v" sid="2CH 29:30" />हिजकिय्याह राजे ओर परदाने लेविया खे आज्ञा दित्ती कि दाऊद ओर आसाप दर्शिये रे पजन गायी की यहोवे री स्तुति करो ओर तिने खुशिया साथे स्तुति कित्ती ओर सिर चुकाई की माथा टेकेया। <verse eid="2CH 29:30" /><verse number="31" style="v" sid="2CH 29:31" />तेबे हिजकिय्याह राजा बोलणे लगेया, “एबे तुसे यहोवे खे आपणा सब कुछ अर्पण करी राखेया, इजी री खातर नेड़े आई की यहोवे रे मन्दरो दे मेलबलि ओर तन्यवाद-बलि पऊँचाओ।” तेबे मण्डल़िया रे लोके मेलबलि ओर तन्यवाद-बलि पऊँचाए ओर जितणे आपणी इच्छा साथे देणा चाओ थे तिने बी होमबलि पऊँचाई। <verse eid="2CH 29:31" /><verse number="32" style="v" sid="2CH 29:32" />आपणी होमबलिया रिया तँईं, लोक सत्तर बल़द, 100 खाडू ओर 200 मिन्टू ल्याए। <verse eid="2CH 29:32" /><verse number="33" style="v" sid="2CH 29:33" />पवित्र कित्ते रे डांगर 600 बल़द ओर 3,000 पेडा-बाकरिया थिया। <verse eid="2CH 29:33" /><verse number="34" style="v" sid="2CH 29:34" />पर पुरोईत इतणे थोड़े थे कि सेयो सबी होमबलिया रे डांगरा रिया खाला नि उतारी सके, तेबे तिना रे लेवी पाई तेस बखतो तक तिना री मताद करदे रये जदुओ तक से काम पूरा नि ऊई चुकेया ओर पुरोईते आपू खे पवित्र नि कित्तेया, कऊँकि लेविये आपू खे पवित्र करने खे पवित्र पुरोईता ते जादा सीदे मनो रे थे। <verse eid="2CH 29:34" /><verse number="35" style="v" sid="2CH 29:35" />तेबे होमबलिया रे डांगर बऊत थे ओर मेलबलिया रे डांगरा री चर्बी बी बऊत थी ओर एक-एक होमबलिया साथे अर्घ बी देणा पड़ेया। ईंयाँ यहोवे रे मन्दरो री आराधना ठीक कित्ती। <verse eid="2CH 29:35" /><verse number="36" style="v" sid="2CH 29:36" />तेबे राजा हिजकिय्याह ओर सारी प्रजा रे लोक तेस कामो रिया बजा ते खुश ऊए, जो यहोवे आपणी‍ प्रजा खे त्यार कित्तेया था, कऊँकि से काम फटाफट ऊईगा था।<verse eid="2CH 29:36" /></para>
  <chapter eid="2CH 29" />
  <chapter number="30" style="c" sid="2CH 30" />
  <para style="s">हिजकिय्याहो रे जरीये फसह रा त्‍योआर मनाणे री त्‍यारी</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 30:1" />तेबे हिजकिय्याहे सारे इस्राएल ओर यहूदा रे लोका खे सन्देसा पेजेया ओर एप्रैम ओर मनश्शे रे गोत्रा खे ये लिखी की चिट्ठी पेजी कि तुसे यरूशलेम शईरो दे यहोवे रे मन्दरो दे इस्राएलो रे परमेशर यहोवे खे फसह रा त्योआर मनाणे खे आओ। <verse eid="2CH 30:1" /><verse number="2" style="v" sid="2CH 30:2" />राजा ओर तेसरे परदान ओर यरूशलेम शईरो री मण्डल़िए सला करी राखी थी कि फसह रा त्योआर दूजे मीन्ने मनाणा। <verse eid="2CH 30:2" /><verse number="3" style="v" sid="2CH 30:3" />सेयो तेस त्योआरो खे तेस बखते इजी बजा ते नि मनाई सको थे, कऊँकि थोड़े जे ई पुरोईते आपू-आपू खे पवित्र करी राखेया था ओर प्रजा रे लोक यरूशलेम शईरो रे कट्ठे नि ऊई रे थे। <verse eid="2CH 30:3" /><verse number="4" style="v" sid="2CH 30:4" />ये गल्ल राजा ओर सारी मण्डल़िया खे ठीक लगी। <verse eid="2CH 30:4" /><verse number="5" style="v" sid="2CH 30:5" />इजी री खातर तिने इस्राएलो रे सारे देशो दे, बेर्शेबा शईरो ते लई की दानो रिया जगा तक एक सन्देश पेजेया, कि यरूशलेम शईरो दे इस्राएलो रे परमेशर यहोवे रिया तँईं फसह रा त्योआर मनाणे खे आओ, कऊँकि तिने इतणी बड़ी संख्या रे फसह ईंयाँ नि मनाया था जेड़ा लिखी राखेया। <verse eid="2CH 30:5" /><verse number="6" style="v" sid="2CH 30:6" />तेबे डाकिये राजा ओर तेसरे परदाना ते पर्चिया लई की, राजे री आज्ञा रे मुताबिक सारे इस्राएलो ओर यहूदा रे कूमे ओर ये बोलदे गये, “ओ इस्राएलियो! अब्राहम, इसहाक ओर इस्राएलो रे परमेशर यहोवे रिया तरफा खे फिरो, ताकि से अश्शूरो रे राजे रे आथो ते बची रे तुसा लोका रिया तरफा खे फिरो। <verse eid="2CH 30:6" /><verse number="7" style="v" sid="2CH 30:7" />ओर आपणे बुजुर्गा ओर पाईया जेड़े नि बणो, जिने आपणे बुजुर्गा रे परमेशर यहोवे साथे विश्वासघात कित्तेया था ओर तिने से बेज्जतिया जोगा करी ता था, जेड़ा कि तुसे आपू देखणे लगी रे। <verse eid="2CH 30:7" /><verse number="8" style="v" sid="2CH 30:8" />एबे आपणे बुजुर्गा जेड़ी हठ नि करो, बल्कि यहोवे रे वशो दे ऊई की तेसरी तेसा पवित्र जगा रे आओ, जो तिने सदा खे पवित्र करी राखी ओर आपणे परमेशर यहोवे री आराधना करो, ताकि तेसरा पड़केया रा गुस्‍सा तुसा पाँदा ते दूर ऊई जाओ। <verse eid="2CH 30:8" /><verse number="9" style="v" sid="2CH 30:9" />जे तुसे यहोवे रिया तरफा खे फिरोगे, तो जो तुसा रे पाईया खे ओर बच्चेया खे बन्दी बणाई की लईगे रे, तिना तुसा रे पाईया ओर बच्चेया पाँदे दया करनी ओर सेयो एते देशो रे वापस आई सकोए, कऊँकि तुसा रा यहोवा परमेशर अनुग्रह करने वाल़ा ओर दयालु ए, ओर जे तुसे तेसरी तरफा खे फिरोगे तो तेस आपणा मूँ तुसा ते नि मोड़ना।” <verse eid="2CH 30:9" /><verse number="10" style="v" sid="2CH 30:10" />ईंयाँ डाकिये एप्रैम ओर मनश्शे रे देशो रे शईरो-शईरो रे ऊँदे ऊए जबूलूनो तक गये, पर तिने तिना रिया आसिया लगाईया ओर तिना रा मजाक उडाया। <verse eid="2CH 30:10" /><verse number="11" style="v" sid="2CH 30:11" />तेबे बी आशेर, मनश्शे ओर जबूलूनो बीचा ते कुछ लोक दीन ऊई की यरूशलेम शईरो खे आए। <verse eid="2CH 30:11" /><verse number="12" style="v" sid="2CH 30:12" />यहूदा दे बी परमेशरो री एड़ी सामर्थ ऊई, कि सेयो एक मन ऊई की, जो आज्ञा राजा ओर परदाने यहोवे रे वचनो रे मुताबिक दित्ती थी, तेतेखे मानणे खे त्यार ऊए।<verse eid="2CH 30:12" /></para>
  <para style="s">फसह रे त्‍योआरो रा मनाया जाणा</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 30:13" />ईंयाँ जादा लोक यरूशलेम शईरो रे इजी खे कट्ठे ऊए, ताकि दूजे मीन्ने रे बिना सजेड़े री रोटिया रा त्योआर मनाओ ओर बऊत बड़ी सभा कट्ठी ऊई गी। <verse eid="2CH 30:13" /><verse number="14" style="v" sid="2CH 30:14" />तेबे तिने उठी की यरूशलेम शईरो रिया बेदिया ओर तूप बाल़ने रिया सब जगा चकी की किद्रोन नाल़े रे सेटी तिया। <verse eid="2CH 30:14" /><verse number="15" style="v" sid="2CH 30:15" />तेबे दूजे मीन्ने रे चौदुए दिने तिने फसह रे डांगर बलि कित्ते, तेबे पुरोईत ओर लेविये शर्मिंदा ऊए ओर आपू खे पवित्र करी की होमबलिया चढ़ाणे खे यहोवे रे मन्दरो रे ली आए। <verse eid="2CH 30:15" /><verse number="16" style="v" sid="2CH 30:16" />सेयो आपणे नियमो रे मुताबिक, मतलब परमेशरो रे दास मूसे रे बिधानो रे मुताबिक, आपणी-आपणी जगा रे खड़े ऊए ओर पुरोईते होमबलिया रा खून लेविया रे आथो ते लई की छिड़की ता। <verse eid="2CH 30:16" /><verse number="17" style="v" sid="2CH 30:17" />कऊँकि सभा रे बऊत एड़े थे जिने आपू खे पवित्र नि करी राखेया था, इजी री खातर सबी अशुद्ध लोका रे फसह रे डांगरा खे बलि करने रा अक्क लेविया खे दित्तेया, ताकि तिना खे यहोवे रिया तँईं पवित्र करो। <verse eid="2CH 30:17" /><verse number="18" style="v" sid="2CH 30:18" />बऊत सारे लोके, मतलब एप्रैम, मनश्शे, इस्साकार ओर जबूलूना बीचा ते कई एड़े थे जो शुद्ध नि ऊई रे थे, तेबे बी सेयो फसह रे डांगरा रा मास लिखी री बिधिया रे खलाफ खाओ थे, कऊँकि हिजकिय्याहे तिना रिया तँईं ये प्रार्थना कित्ती थी कि यहोवा जो पला ए, से तिना सबी रे पाप टखी देयो। <verse eid="2CH 30:18" /><verse number="19" style="v" sid="2CH 30:19" />जिने परमेशरो री, मतलब आपणे बुजुर्गा रे परमेशर यहोवे खे टोल़ने दे आपणा मन लगाई राखेया, चाए सेयो पवित्र जगा री बिधिया रे मुताबिक शुद्ध पनि ओ। <verse eid="2CH 30:19" /><verse number="20" style="v" sid="2CH 30:20" />ओर यहोवे हिजकिय्याह री ये प्रार्थना सुणी की लोक ठीक कित्ते। <verse eid="2CH 30:20" /><verse number="21" style="v" sid="2CH 30:21" />जो इस्राएली यरूशलेम शईरो रे आजीर थे, सेयो सात दिना तक बिना सजेड़े री रोटिया रा त्योआर बड़ी खुशिया साथे मनांदे रये ओर हर रोज लेविये ओर पुरोईत ऊच्ची आवाजा रे यहोवे खे बाजे बजांदे ऊए स्तुति करदे रये। <verse eid="2CH 30:21" /><verse number="22" style="v" sid="2CH 30:22" />जितणे लेवी लोक यहोवे रा पजन समजा साथे करो थे, तिना खे हिजकिय्याहे शान्तिया रे वचन बोले। ईंयाँ सेयो मेलबलि चढ़ाई की ओर आपणे बुजुर्गा रे परमेशर यहोवे सामणे आपणे पापो खे मानदे रये ओर तेस ठराए रे त्योआरो रे साता दिना तक खांदे रये।<verse eid="2CH 30:22" /></para>
  <para style="s">फसह रा त्योआर दूजी बार मनाया जाणा</para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 30:23" />तेबे सारी सभा रे लोके सलाह् कित्ती कि आसा सात दिन ओर त्योआर मनाणा, तेबे तिने सात दिन ओर खुशिया साथे त्योआर मनाया। <verse eid="2CH 30:23" /><verse number="24" style="v" sid="2CH 30:24" />कऊँकि यहूदा रे हिजकिय्याह राजे सभा खे 1,000 बाच्छू ओर 7,000 पेडा-बाकरिया देईतिया ओर परदाने सभा खे 1,000 बाच्छू ओर 10,000 पेडा-बाकरिया दित्तिया ओर बऊत सारे पुरोईते आपू खे पवित्र कित्तेया। <verse eid="2CH 30:24" /><verse number="25" style="v" sid="2CH 30:25" />तेबे पुरोईत ओर लेविया समेत यहूदा री सारी सभा, ओर इस्राएलो ते आए रे लोका री सभा ओर इस्राएलो रे देशो ते आए रे ओर यहूदा रे रणे वाल़े परदेशी, इने सबी खुशिया मनाईया। <verse eid="2CH 30:25" /><verse number="26" style="v" sid="2CH 30:26" />ईंयाँ यरूशलेम शईरो दे बऊत खुशिया ऊईया, कऊँकि दाऊदो रे पाऊ इस्राएलो रे राजा सुलैमानो रे दिना ते एड़ी गल्ल यरूशलेम शईरो रे नि ऊई थी। <verse eid="2CH 30:26" /><verse number="27" style="v" sid="2CH 30:27" />अन्तो रे लेवी पुरोईते खड़े ऊई की प्रजा खे आशीर्वाद दित्तेया ओर तिना री सुणी ओर तिना री प्रार्थना तेसरे पवित्र धामो तक, मतलब स्वर्गो तक पऊँची।<verse eid="2CH 30:27" /></para>
  <chapter eid="2CH 30" />
  <chapter number="31" style="c" sid="2CH 31" />
  <para style="s">मूर्तिया री पूजा बन्द करना</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 31:1" />त्योआरो रे आखरी दे, जो इस्राएली तेती आजीर थे, सेयो यहूदा रे सबी शईरा दे गए, ओर मूर्तिया रिया पूजा रिया तँईं लगे दे पात्थर ओर खम्बे तोड़ी ते, ओर अशेरा देविया री पूजा खे खम्बे बाडी ते। तिने तिना सबी जगा दे जेती यहूदा ओर बिन्यामीन गोत्रो रे लोक रओ थे, ओर एप्रैम ओर मनश्शे रे गोत्रा रे लोका रिया जगा दे बी, पाह्ड़िया रिया चूँडिया पाँदे बणे दे मन्दरा ओर बालो रिया बेदिया नाश करी तिया। तिना सबी खे नाश करी की सेयो आपणे शईरा खे वापस आए।<verse eid="2CH 31:1" /></para>
  <para style="s">लेविया रिया तँईं पेंट</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 31:2" />हिजकिय्याहे पुरोईता रे दलो खे ओर लेविया रे कुलो खे बल्कि पुरोईत ओर लेविये दोनो, हर एक दलो रे मुताबिक ओर हर एकी माणूंए खे तेसरी सेवा रे कामो रे मुताबिक इजी री खातर ठराईते, ताकि सेयो यहोवे रे तम्बूए रे द्वारो ते पीतरे होमबलि, मेलबलि, सेवा-टईल, तन्यवाद ओर स्तुति करेया करो। <verse eid="2CH 31:2" /><verse number="3" style="v" sid="2CH 31:3" />तेबे तिने आपणी सम्पत्तिया बीचा ते राजे रा इस्सा होमबलिया खे ठराईते; मतलब प्यागा ओर साँजा री होमबलिया खे ओर रामो रे ओर नये चाँदो रे दिन ओर ठराए रे बखतो री होमबलिया खे जेड़ा कि यहोवे रे बिधानो रे लिखी राखेया। <verse eid="2CH 31:3" /><verse number="4" style="v" sid="2CH 31:4" />तिने यरूशलेम शईरो दे रणे वाल़े पुरोईत ओर लेविया खे तिना रा इस्सा देणे री आज्ञा दित्ती, ताकि सेयो यहोवे रे बिधानो रे काम मन लगाई की करी सको। <verse eid="2CH 31:4" /><verse number="5" style="v" sid="2CH 31:5" />ये आज्ञा सुणदे ई इस्राएली, नज्ज, नया शराब, जैतूनो रा तेल, सयीत बगैरा री उपजा री सब प्रकारा री पईली उपज बऊत जादा देणे ओर सारिया चीजा रा दशमांश जादातर ल्याऊणे लगे। <verse eid="2CH 31:5" /><verse number="6" style="v" sid="2CH 31:6" />जो इस्राएली ओर यहूदी, यहूदा रे शईरो रे रओ थे, सेयो बी बल़दा ओर पेडा-बाकरिया रा दशमांश ओर तिना पवित्र चीजा रा दशमांश, जो तिना रे परमेशर यहोवे रिया तँईं पवित्र करी राखिया थिया, ल्याई की टेरा रे टेर करी की राखणे लगे। <verse eid="2CH 31:6" /><verse number="7" style="v" sid="2CH 31:7" />एड़े टेर लगाणा तिने तीजे मीन्ने ते शुरू कित्तेया ओर सातुए मीन्ने पूरा कित्तेया। <verse eid="2CH 31:7" /><verse number="8" style="v" sid="2CH 31:8" />जेबे हिजकिय्याह राजे ओर परदाने आई की सेयो टेर देखे, तेबे यहोवा ओर तेसरी इस्राएली प्रजा रा तन्यवाद कित्तेया। <verse eid="2CH 31:8" /><verse number="9" style="v" sid="2CH 31:9" />तेबे हिजकिय्याहे पुरोईत ओर लेविया रे कुलो ते तिना टेरा रे बारे दे पूछेया। <verse eid="2CH 31:9" /><verse number="10" style="v" sid="2CH 31:10" />अजर्याह बड़े पुरोईते जो सादोको रे कराने रा था, राजे खे बोलेया, “जदुओ ते लोक यहोवे रे मन्दरो रे पेंटा ल्याऊणे लगी रे, तदुओ ते आसा लोका खे पेट परी की रोटी मिलोई, बल्कि बऊत बची बी जाओआ, कऊँकि यहोवे आपणी प्रजा खे आशीष देई राखी ओर जो बाकी रई गा रा, तेतेरा ई ये बड़ा टेर ए।” <verse eid="2CH 31:10" /><verse number="11" style="v" sid="2CH 31:11" />तेबे हिजकिय्याहे यहोवे रे मन्दरो दे पण्डार बनाणे री आज्ञा दित्ती ओर सेयो बणाए। <verse eid="2CH 31:11" /><verse number="12" style="v" sid="2CH 31:12" />तेबे लोके चकी री पेंट, दशमांश ओर पवित्र कित्ती रिया चीजा, सच्चाईया साथे पऊँचाईया ओर तिना रे मुख्य अधिकारी तो कोनन्याह नाओं रा एक लेवी था ओर दूजा तेरा पाई शिमी था; <verse eid="2CH 31:12" /><verse number="13" style="v" sid="2CH 31:13" />ओर कोनन्याह ओर तेसरे पाई शिमिये ते थाले, हिजकिय्याह राजा ओर परमेशरो रे मन्दरो रे परदान अजर्याह दुँईं री आज्ञा ते यहीएल, अजज्याह, नहत, असाहेल, यरीमोत, योजाबाद, एलीएल, यिस्मक्याह, महत ओर बनायाह अधिकारी थे।<verse eid="2CH 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 31:14" />परमेशरो खे आपणी इच्छा रे मुताबिक बलिया रा अधिकारी यिम्ना लेविये रा पाऊ कोरे था, जो पूर्वो रे बड़े द्वारो रा द्वारपाल था, ताकि से यहोवे रिया पेंटा ओर परम पवित्र चीजा बांडेया करो। <verse eid="2CH 31:14" /><verse number="15" style="v" sid="2CH 31:15" />तेसरे अक्को रे एदेन, बिन्यामीन, येशुअ, शमायाह, अमर्याह ओर शकन्याह पुरोईता रे शईरो रे रओ थे, ताकि सेयो क्या बड़े, क्या छोटे, आपणे पाईया खे तिना रे दलो रे मुताबिक सच्चाईया साथे देया करो। <verse eid="2CH 31:15" /><verse number="16" style="v" sid="2CH 31:16" />ओर तिना ते अलावा तिना खे बी देयो, जो मर्दा री वंशावलिया रे मुताबिक गिणी की तीऊँ साला री उम्रा रे या तेते ते जादा री उम्रा रे थे ओर आपणे-आपणे दलो रे मुताबिक आपणे-आपणे सेवा रे कामो खे हर रोज कामो रे मुताबिक यहोवे रे मन्दरो रे जाया करो थे। <verse eid="2CH 31:16" /><verse number="17" style="v" sid="2CH 31:17" />तिना पुरोईता खे बी देयो, जिना री वंशावली तिना रे पितरा रे कराने रे मुताबिक कित्ती ओर लेविया खे बी जो बीई साला रिया उम्रा ते लई की बादो ते आपणे-आपणे दलो रे मुताबिक, आपणे-आपणे काम करो थे। <verse eid="2CH 31:17" /><verse number="18" style="v" sid="2CH 31:18" />सारी सभा रे तिना रे बाल-बच्चे, जवाणसा, माठे-बेटिया खे बी देयो, जिना री वंशावली थी, कऊँकि सेयो सच्चाईया साथे आपू खे पवित्र करो थे।<verse eid="2CH 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 31:19" />तेबे हारूणो री ल्वादा रे पुरोईता खे बी जो आपणे-आपणे शईरो रे चराईया रे मैदानो रे रओ थे, देणे खे सेयो मर्द राखे थे, जिना रे नाओं ऊबे लिखी राखे थे ताकि सेयो पुरोईता रे सबी मर्दा खे ओर तिना सबी लेविया खे बी तिना रा इस्सा देया करो जिना री वंशावली थी। <verse eid="2CH 31:19" /><verse number="20" style="v" sid="2CH 31:20" />सारे यहूदा दे बी हिजकिय्याहे एड़ा ई प्रबन्द कित्तेया ओर जो कुछ तेसरे परमेशर यहोवे री नजरा रे खरा ओर ठीक ओर सच्चाईया रा था, से तिजी खे करो था। <verse eid="2CH 31:20" /><verse number="21" style="v" sid="2CH 31:21" />जो-जो काम तिने परमेशरो रे मन्दरो री आराधना, बिधान ओर आज्ञा रे बारे दे आपणे परमेशरो री टोल़ा खे कित्ते, सेयो तिने आपणा सारा मन लगाई की कित्ते ओर तिदे सफल बी ऊआ।<verse eid="2CH 31:21" /></para>
  <chapter eid="2CH 31" />
  <chapter number="32" style="c" sid="2CH 32" />
  <para style="s">यहूदा पाँदे अश्शूरो रे राजे रा अमला</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 32:1" />इना सबी गल्ला ओर एड़े प्रबन्दो ते बाद अश्शूरो रे राजा सन्हेरीबे आई की यहूदा दे प्रवेश करी की ओर किले वाल़े शईरा रे खलाफ डेरे लगाई की तिने सेयो आपणे फायदे खे लणे चाए। <verse eid="2CH 32:1" /><verse number="2" style="v" sid="2CH 32:2" />ये देखी की कि सन्हेरीब नेड़े आई रा ओर यरूशलेम शईरो साथे लड़ना चाओआ, <verse eid="2CH 32:2" /><verse number="3" style="v" sid="2CH 32:3" />हिजकिय्याहे आपणे परदान ओर सेनापतिया साथे सलाह् कित्ती कि शईरो ते बारे सूबल़ा खे पटवाई देयो ओर तिने तेसरी मताद कित्ती। <verse eid="2CH 32:3" /><verse number="4" style="v" sid="2CH 32:4" />तेबे बऊत सारे लोक कट्ठे ऊए ओर ये बोली की कि, “अश्शूरो रे राजा कऊँ ऐती आओ ओर आई की बऊत सारा पाणी पाओ” तिने सारी सूबल़ा रोकी तिया ओर से नदी सुखाई ती जो देशो बीचे ऊई की बह्ओ थी। <verse eid="2CH 32:4" /><verse number="5" style="v" sid="2CH 32:5" />तेबे हिजकिय्याहे याओ बानी की दवाल जेती-केथी टूटी थी, से तेती-तेती बणाई ओर से गुम्मटा रे बराबर ऊच्ची कित्ती ओर बारे एक ओर दवाल बणाई ओर दाऊदो रे शईरो रे मील्लो खे मजबूत कित्तेया ओर बऊत सारे अथियार ओर ढाला बी बणवाईया। <verse eid="2CH 32:5" /><verse number="6" style="v" sid="2CH 32:6" />तेबे तिने प्रजा पाँदे सेनापति नियुक्त कित्ते ओर सेयो शईरो रे बड़े द्वारो रे कट्ठे कित्ते ओर ये बोली की तिना खे सब्र कराया, <verse eid="2CH 32:6" /><verse number="7" style="v" sid="2CH 32:7" />“याओ बानो ओर मजबूत ओ, तुसे ना तो अश्शूरो रे राजे ते डरो ओर ना तेस साथली सारी पीड़ा ते ओर ना ई तुसा रा मन कच्चा ओ; कऊँकि जो आसा साथे, से बऊत बड़ा ए। <verse eid="2CH 32:7" /><verse number="8" style="v" sid="2CH 32:8" />मतलब तेसरा साअरा तो माणूं ईए, पर आसा साथे, म्हारी मताद ओर म्हारी तरफा ते म्हारा यहोवा परमेशर ए।” तेबे प्रजा रे लोके यहूदा रे हिजकिय्याह राजे री गल्ला पाँदे परोसा राखेया।<verse eid="2CH 32:8" /></para>
  <para style="s">सन्हेरीबो रे काम करने वाल़ेया रा सन्देशा</para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 32:9" />इजी ते बाद अश्शूरो रा राजा सन्हेरीब जो सारी सेना समेत लाकीशो रे सामणे खड़ी रा था, तिने आपणे कर्मचारी यरूशलेम शईरो दे यहूदा रे राजा हिजकिय्याह ओर तिना सबी यहूदिया गे जो यरूशलेम शईरो रे थे ये बोलणे खे पेजे, <verse eid="2CH 32:9" /><verse number="10" style="v" sid="2CH 32:10" />“अश्शूरो रा राजा सन्हेरीब बोलोआ कि तुसा खे केसरा परोसा ए जेते कि तुसे केरे दे यरूशलेम शईरो दे बैठी रे? <verse eid="2CH 32:10" /><verse number="11" style="v" sid="2CH 32:11" />क्या हिजकिय्याह तुसा खे ये बोली की कि म्हारे यहोवा परमेशरो आसे अश्शूरो रे राजे रे आथो ते बचाणे, तुसा रा बेवकूफ नि बणांदा, ताकि तुसा खे पूखा-त्याया काओ? <verse eid="2CH 32:11" /><verse number="12" style="v" sid="2CH 32:12" />क्या तिने हिजकिय्याहे ई तेसरी ऊच्ची जगा ओर बेदिया खे दूर करी की यहूदा ओर यरूशलेम शईरो खे आज्ञा नि दित्ती कि तुसे एक ई बेदिया सामणे माथा टेकणा ओर तूप बाल़ना? <verse eid="2CH 32:12" /><verse number="13" style="v" sid="2CH 32:13" />क्या तुसा खे पता नि ए कि मैं ओर मेरे बुजुर्गे देशो-देशो रे सबी लोका साथे क्या-क्या कित्तेया? क्या तिना देशा री जातिया रे देवता किंयाँ बी आपणे देशो खे मेरे आथो ते बचाई सके? <verse eid="2CH 32:13" /><verse number="14" style="v" sid="2CH 32:14" />जितणी जातिया रा मेरे बुजुर्गे सत्यानाश कित्तेया तिना रे सबी देवतेया बीचे एड़ा कुण था, जो आपणी प्रजा खे मेरे आथो ते बचायी सकेया? तेबे तुसा रा देवता तुसा खे मेरे आथो ते किंयाँ बचाई सकोआ? <verse eid="2CH 32:14" /><verse number="15" style="v" sid="2CH 32:15" />एबे हिजकिय्याह तुसा खे ईंयाँ बेवकूफ या बईकाई नि सको ओर तुसे तेसरा परोसा नि करो, कऊँकि केसी जातिया रा या राज्य रा कोई देवता आपणी प्रजा खे ना तो मेरे आथो ते ओर ना मेरे बुजुर्गा रे आथो ते बचाई सकेया। ये पक्का ए कि तुसा रा देवता तुसा खे मेरे आथो ते नि बचाई सकदा।”<verse eid="2CH 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 32:16" />तिने इजी ते बी जादा तेसरे काम करने वाल़ेया री ओर परमेशर यहोवे री ओर तेसरे दास हिजकिय्याह री बेज्जती कित्ती। <verse eid="2CH 32:16" /><verse number="17" style="v" sid="2CH 32:17" />तेबे तिने एक एड़ी चिट्ठी पेजी, जिदे इस्राएलो रे परमेशर यहोवे री निन्दा रिया यो गल्ला लिखी राखिया थिया, “जिंयाँ देशा-देशा री जातिया रे देवता आपणी-आपणी प्रजा खे मेरे आथो ते नि बचाई सके, तिंयाँ ई हिजकिय्याह रा देवता बी आपणी प्रजा खे मेरे आथो ते नि बचाई सकदा।” <verse eid="2CH 32:17" /><verse number="18" style="v" sid="2CH 32:18" />ओर तिने जोरे की तिना यरूशलेमिया खे जो दवाला पाँदे बैठी रे थे, यहूदी पाषा रे आका पाईया, ताकि तिना खे डराई सको, जेते कि से शईरो खे लई लो। <verse eid="2CH 32:18" /><verse number="19" style="v" sid="2CH 32:19" />तिने यरूशलेम शईरो रे परमेशरो री एड़ी चर्चा कित्ती कि से मानो तरतिया रे देशो-देशो रे लोका रे देवतेया रे बराबर ओ, जो माणूंए बणाई राखे।<verse eid="2CH 32:19" /></para>
  <para style="s">सन्हेरीब राजे ते छुटकारा</para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 32:20" />तेबे इना घटणा रिया बजा ते राजा हिजकिय्याह ओर आमोसो रे पाऊ यशायाह नबीए दुँईं प्रार्थना कित्ती ओर स्वर्गो रिया तरफा खे दुहाई दित्ती। <verse eid="2CH 32:20" /><verse number="21" style="v" sid="2CH 32:21" />तेबे यहोवे एक दूत पेजेया, जिने अश्शूरो रे राजे रे डेरेया रे सारे शूरवीर, परदान ओर सेनापति नाश कित्ते। तेबे अश्शूरो रा राजा शर्मिंदा ऊई की आपणे देशो खे वापस ऊईगा। ओर जेबे से आपणे देवते रे मन्दरो दे था, तेबे तेसरे आपणे पाऊए से तेथी तलवारी साथे काया। <verse eid="2CH 32:21" /><verse number="22" style="v" sid="2CH 32:22" />ईंयाँ यहोवे हिजकिय्याह ओर यरूशलेम शईरो रे रणे वाल़े लोक अश्शूरो रे राजा सन्हेरीब ओर आपणे सारे दुश्मणा रे आथो ते बचाए ओर चऊँ कनारे तिना ते आगे चलेया। <verse eid="2CH 32:22" /><verse number="23" style="v" sid="2CH 32:23" />तेबे बऊत सारे लोक यरूशलेम शईरो खे यहोवे खे पेंट ओर यहूदा रे राजा हिजकिय्याह खे कीमती चीजा ल्याऊणे लगे ओर तेस बखतो ते से सबी जातिया बीचे महान ऊईगा।<verse eid="2CH 32:23" /></para>
  <para style="s">हिजकिय्याह री बमारी ओर कमण्ड</para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 32:24" />तिना दिना दे हिजकिय्याह एड़ा बमार ऊआ कि से मरने वाल़ा था, तेबे तिने यहोवे ते प्रार्थना कित्ती, तेबे तिने से ठीक करिता ओर तेस साथे गल्ला करी की तेसखे एक चमत्कार दखाया। <verse eid="2CH 32:24" /><verse number="25" style="v" sid="2CH 32:25" />पर हिजकिय्याहे तेस उपकारो रा बदला नि दित्तेया, कऊँकि तेसखे कमण्ड ऊईगा था। इजी बजा ते तेसरा रोष तेस पाँदे ओर यहूदा ओर यरूशलेम शईरो पाँदे पड़केया। <verse eid="2CH 32:25" /><verse number="26" style="v" sid="2CH 32:26" />तेबे हिजकिय्याह यरूशलेम शईरो रे सबी रणे वाल़ेया समेत आपणे मनो दे कमण्डो रिया बजा ते दीन ऊईगा, इजी बजा ते यहोवे रा गुस्सा तिना पाँदे हिजकिय्याह रे दिना दे नि पड़केया।<verse eid="2CH 32:26" /></para>
  <para style="s">हिजकिय्याह रा तअन ओर तेसरे काम</para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 32:27" />हिजकिय्याह खे बऊत ई तअन ओर महिमा मिली ओर तिने सूईना, चाँदी, मणिया, खुशबूदार द्रव्य, ढाला ओर सब प्रकारा रे बांके पांडेया खे राखणे खे पण्डार बणाए। <verse eid="2CH 32:27" /><verse number="28" style="v" sid="2CH 32:28" />तेबे तिने नज्ज, नवां शराब ओर जैतूनो रे तेलो खे राखणे खे पण्डार बणाए ओर सबी प्रकारा रे डांगरा खे गवाईणी ओर पेडा-बाकरिया खे बी गवाईणी बणाईया। <verse eid="2CH 32:28" /><verse number="29" style="v" sid="2CH 32:29" />तिने शईर बसाए ओर बऊत सारिया पेडा-बाकरिया ओर गायी-बल़दा री सम्पत्ति कट्ठी करी ली, कऊँकि परमेशरे तेसखे बऊत सारा तअन दित्तेया था। <verse eid="2CH 32:29" /><verse number="30" style="v" sid="2CH 32:30" />तिने हिजकिय्याहे ई गीहोन नाओं री नदिया पाँदे सूबल बणाई की तेसा नदिया खे थालली तरफा खे दाऊदो रे शईरो री पच्छमा रिया तरफा खे सीदी पऊँचाई ओर से आपणे सारे कामो रे सफल ओ था। <verse eid="2CH 32:30" /><verse number="31" style="v" sid="2CH 32:31" />तेबे बी जेबे बाबेलो रे परदाने तेसगे तेसरे देशो रे कित्ते रे अचम्बे रे कामा रे बारे रे पूछणे खे दूत पेजे, तेबे परमेशरे से इजी खे छाडीता, ताकि तेसरे मनो खे परखी की तेसरा सारा पेत जाणी लो।<verse eid="2CH 32:31" /></para>
  <para style="s">हिजकिय्याह री मौत</para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 32:32" />हिजकिय्याह रे ओर काम ओर तेसरे पलाईया रे काम आमोसो रे पाऊ यशायाह नबीए रे दर्शण नाओं री कताबा दे ओर यहूदा ओर इस्राएलो रे राजेया रे इतियासो री कताबा दे लिखी राखे। <verse eid="2CH 32:32" /><verse number="33" style="v" sid="2CH 32:33" />अन्तो रे हिजकिय्याह मरी की आपणे बुजुर्गा साथे मिलीगा ओर तेसखे दाऊदो री ल्वादा रे कब्रिस्तानो री चढ़ाईया पाँदे माट्टी दित्ती ओर सारे यहूदी ओर यरूशलेम शईरो रे रणे वाल़ेया तेसरी मौता पाँदे तेसरा आदर कित्तेया। तेबे तेसरा पाऊ मनश्शे तेसरी जगा पाँदे राज करने लगेया।<verse eid="2CH 32:33" /></para>
  <chapter eid="2CH 32" />
  <chapter number="33" style="c" sid="2CH 33" />
  <para style="s">यहूदा दे मनश्शे रा राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 33:1" />जेबे मनश्शे यहूदा दे राज करने लगेया, तेबे से बारा साला रा था ओर यरूशलेम शईरो दे पचूँजा साला तक राज करदा रया। <verse eid="2CH 33:1" /><verse number="2" style="v" sid="2CH 33:2" />तिने से कित्तेया जेतेते यहोवा नफरत करो था, मतलब तिना दूजी जातिया रे बुरे कामो रे मुताबिक जो यहोवे इस्राएली लोका रे सामणे ते देशो ते बारे निकयाल़ी तिया थिया। <verse eid="2CH 33:2" /><verse number="3" style="v" sid="2CH 33:3" />तिने सेयो ऊच्ची जगा जो तेसरे बाओ हिजकिय्याहे तोड़ी तिया थिया, फेर बणाईया ओर बाल नाओं रे देवतेया खे बेदिया ओर अशेरा नाओं री देविया खे मूर्तिया बणाईया ओर सर्गो रे सारे तारेया खे देवता मानी की तिना गे माथा टेकणे लगेया ओर तिना री आराधना बी करने लगेया। <verse eid="2CH 33:3" /><verse number="4" style="v" sid="2CH 33:4" />तिने यहोवे रे तेस मन्दरो दे बेदिया बणाईया जेतेरे बारे दे यहोवे बोलेया था, “यरूशलेम शईरो दे मेरा नाओं सदा बणेया दा रणा।” <verse eid="2CH 33:4" /><verse number="5" style="v" sid="2CH 33:5" />बल्कि यहोवे रे दुँईं आँगणा दे बी तिने सर्गो रे सारे तारेया खे देवता मानी की तिना खे बेदिया बणाईया। <verse eid="2CH 33:5" /><verse number="6" style="v" sid="2CH 33:6" />तेबे तिने हिन्नोमो रे पाऊए री काअटिया रे आपणे माठे आगी रे बलि करी की चढ़ाए ओर शुभ-अशुभ मुर्ह्त मानो था ओर जादू-टोणा ओर तंत्र-मंत्र करो था ओर आत्मा ओर पूत सिद्धिवाल़ेया साथे दोस्ती राखो था। बल्कि तिने एड़े बऊत सारे काम कित्ते, जो यहोवे री नजरा रे बुरे थे ओर जिना ते से बऊत रोषे ओआ। <verse eid="2CH 33:6" /><verse number="7" style="v" sid="2CH 33:7" />ओर तिने आपणी कअड़ी री अशेरा नाओं री मूर्ति परमेशरो रे तेस मन्दरो रे स्थापित कित्ती जेतेरे बारे रे परमेशरे दाऊद ओर तेसरे पाऊ सुलैमानो खे बोलेया था, “एते मन्दरो रे ओर यरूशलेम शईरो रे, जो मैं इस्राएलो रे सबी गोत्रा बीचे चूणी ला था, मां आपणा नाओं सदा राखणा, <verse eid="2CH 33:7" /><verse number="8" style="v" sid="2CH 33:8" />ओर मां एड़ा नि करना कि जो देश मैं तुसा रे बुजुर्गा खे देई राखेया था, तिदे इस्राएल फेर पटकदा फिरो, बस इतणा जरूर ओ कि सेयो मेरी सारी आज्ञा खे, मतलब मूसे री दित्ती री सारी बिधान ओर बिधिया ओर नियमा खे मानणे रे चौकसी करो।” <verse eid="2CH 33:8" /><verse number="9" style="v" sid="2CH 33:9" />मनश्शे यहूदा ओर यरूशलेम शईरो रे रणे वाल़े एथो तक पटकाईते कि तिने तिना जातिया ते बी बढ़ी की बुराई कित्ती, जो यहोवे इस्राएली लोका सामणे ते नाश कित्तिया थिया।<verse eid="2CH 33:9" /></para>
  <para style="s">मनश्शे रा पछताणा</para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 33:10" />यहोवे मनश्शे ओर तेसरी प्रजा साथे गल्ला कित्तिया, पर तिने कोई त्यान नि दित्तेया। <verse eid="2CH 33:10" /><verse number="11" style="v" sid="2CH 33:11" />तेबे यहोवे तिना पाँदे अश्शूरो रे राजे रे सेनापतिया ते चढ़ाई कराई ओर यो मनश्शे खे नकेल पाई की ओर पीतल़ी रिया बेड़िया दे जकड़ी की, तेसखे बाबेलो खे लईगे। <verse eid="2CH 33:11" /><verse number="12" style="v" sid="2CH 33:12" />तेबे मुसीबता दे पड़ी की से आपणे यहोवा परमेशरो खे मानणे लगेया ओर आपणे बुजुर्गा रे परमेशरो सामणे बऊत दीन ऊआ ओर तेसते बिनती कित्ती। <verse eid="2CH 33:12" /><verse number="13" style="v" sid="2CH 33:13" />तेबे तिने खुश ऊई की तेसरी प्रार्थना सुणी ओर से यरूशलेम शईरो रे पऊँचाई की तेसरा राज्य वापस कराईता। तेबे मनश्शे खे निश्चा ऊईगा कि यहोवा ई परमेशर ए। <verse eid="2CH 33:13" /><verse number="14" style="v" sid="2CH 33:14" />इजी ते बाद तिने दाऊदो रे शईरो ते बारे गीहोनो रे पश्चिम कनारे ओर नाल़े रे मच्छलिया रे बड़े द्वारो तक एक दवाल बणवाई, तेबे ओपेल केरी की बऊत ऊच्चा करी ता ओर यहूदा रे सारे गढ़वाल़े शईरो रे सेनापति ठराईते। <verse eid="2CH 33:14" /><verse number="15" style="v" sid="2CH 33:15" />तेबे तिने पराये देवता ओर यहोवे रे मन्दरो री मूर्ति ओर जितणी बेदिया तिने यहोवे रे मन्दरो रे पाह्ड़ो पाँदे ओर यरूशलेम शईरो रे बणवाईया थिया, सेयो सब दूर करी की शईरो ते बारे सेटी तिया। <verse eid="2CH 33:15" /><verse number="16" style="v" sid="2CH 33:16" />तेबे तिने यहोवे री बेदिया री मरम्मत कित्ती ओर तेते पाँदे मेलबलि ओर तन्यवादो रिया बलिया चढ़ाणे लगेया ओर यहूदिया खे इस्राएलो रे परमेशर यहोवे री आराधना करने री आज्ञा दित्ती। <verse eid="2CH 33:16" /><verse number="17" style="v" sid="2CH 33:17" />तेबे बी प्रजा रे लोक ऊच्ची जगा रे बलिदान करदे रये, पर बस आपणे परमेशर यहोवे खे।<verse eid="2CH 33:17" /></para>
  <para style="s">मनश्शे री मौत</para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 33:18" />मनश्शे रे ओर काम ओर तिने जो प्रार्थना आपणे परमेशरो ते कित्ती ओर तिना दर्शिया रे वचन, जो इस्राएलो रे परमेशर यहोवे रे नाओं ते तेस साथे गल्ला करो थे, ये सब इस्राएलो रे राजेया रे इतियासो री कताबा रे लिखी राखेया। <verse eid="2CH 33:18" /><verse number="19" style="v" sid="2CH 33:19" />ओर तेसरी प्रार्थना ओर से किंयाँ सुणी ओर तेसरा सारा पाप, ओर विश्वासघात ओर तिने दीन ऊणे ते पईले केई-केई ऊच्ची जगा बणवाईया ओर अशेरा नाओं ओर कअड़ी रिया मूर्तिया खड़िया करवाईया, ये सब होशे रे वचनो रे लिखी राखेया। <verse eid="2CH 33:19" /><verse number="20" style="v" sid="2CH 33:20" />अन्तो रे मनश्शे मरी गा ओर तेसखे तेसरे ई कअरो रे माट्टी दित्ती ओर तेसरा पाऊ आमोन तेसरी जगा पाँदे राज करने लगेया।<verse eid="2CH 33:20" /></para>
  <para style="s">यहूदा दे आमोनो रा राज्य</para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 33:21" />जेबे आमोन राज करने लगेया, तेबे से बाई साला रा था ओर यरूशलेम शईरो रे दो साला तक राज करदा रया। <verse eid="2CH 33:21" /><verse number="22" style="v" sid="2CH 33:22" />आमोने आपणे बाओ मनश्शे रे जेड़ा से कित्तेया जो यहोवे री नजरा रे बुरा था ओर जितणी मूर्तिया तेसरे बाओ मनश्शे कअड़ी की बणवाईया थिया, से बी तिना सबी सामणे बलिदान करो था ओर तिना सबी री आराधना बी करो था। <verse eid="2CH 33:22" /><verse number="23" style="v" sid="2CH 33:23" />जेड़ा तेसरा बाओ मनश्शे यहोवे रे सामणे दीन ऊआ, तेड़ा से दीन नि ऊआ, बल्कि आमोन जादा दोषी ऊँदा गया। <verse eid="2CH 33:23" /><verse number="24" style="v" sid="2CH 33:24" />तेसरे कर्मचारिये द्रोह री साजिश करी की, से तेसरे ई मईलो रे काई ता। <verse eid="2CH 33:24" /><verse number="25" style="v" sid="2CH 33:25" />तेबे आम माणूंए सेयो सारे काईते, जिने राजा आमोनो साथे द्रोह री साजिश कित्ती थी ओर लोके तेसरा पाऊ योशिय्याह तेसरी जगा पाँदे राजा बणाया।<verse eid="2CH 33:25" /></para>
  <chapter eid="2CH 33" />
  <chapter number="34" style="c" sid="2CH 34" />
  <para style="s">यहूदा दे योशिय्याह रा राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 34:1" />जेबे योशिय्याह यहूदा दे राज करने लगेया, तेबे से आठ साला रा था ओर यरूशलेम शईरो रे कत्तीया साला तक राज करदा रया। <verse eid="2CH 34:1" /><verse number="2" style="v" sid="2CH 34:2" />तिने से कित्तेया जो यहोवे री नजरा रे ठीक था ओर जिना बाटा रे तेसरा मूलमर्द दाऊद चलदा रया, तिना पाँदे ई से बी चलेया करो था ओर तेते ते से ना तो खूँजे ना दाँणे मुड़ेया।<verse eid="2CH 34:2" /></para>
  <para style="s">योशिय्याहो रे सुदार</para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 34:3" />से बाल़क ई था, मतलब तेसखे गद्दिया पाँदे बैठे रे आठ साल पनि ऊई रे थे कि आपणे मूलमर्द दाऊदो रे परमेशरो खे टोल़ने लगेया ओर बारूए साले से ऊच्ची जगा ओर आशेर नाओं री मूर्तिया ओर कअड़ी री ओर बणाई रिया मूर्तिया दूर करी की यहूदा ओर यरूशलेम शईरो खे शुद्ध करने लगेया। <verse eid="2CH 34:3" /><verse number="4" style="v" sid="2CH 34:4" />बाल देवतेया रिया वेदिया तेस सामणे तोड़िया ओर सूरजो रिया मूर्तिया जो तिना सामणे ऊच्चिया पाँदे थिया, तिने बाडी तिया ओर अशेरा नाओं, कअड़ी रिया ओर बणाई रिया मूर्तिया तिने तोड़ी की पीसी तिया ओर तिना रा चूरा तिना लोका रिया कब्रा पाँदे सटयाई ता, जो तिना खे बलि चढ़ाओ थे। <verse eid="2CH 34:4" /><verse number="5" style="v" sid="2CH 34:5" />तिना रे पुजारिया रिया आड्डिया तिने तिना रिया बेदिया पाँदे ई फूकिया। ईंयाँ तिने यहूदा ओर यरूशलेम शईरो खे शुद्ध कित्तेया। <verse eid="2CH 34:5" /><verse number="6" style="v" sid="2CH 34:6" />तेबे मनश्शे, एप्रैम ओर शिमोनो रे बल्कि नप्तालिया तको रे शईरा रे खण्डहरा दे, तिने बेदिया तोड़ी तिया। <verse eid="2CH 34:6" /><verse number="7" style="v" sid="2CH 34:7" />योशिय्याह राजे अशेरा ओर कअड़ी रिया मूर्तिया पीसी की चूरा बणाईता ओर इस्राएलो रे सारे देशो रिया सूरजो रिया मूर्तिया बाडी की यरूशलेम शईरो खे वापस ऊईगा।<verse eid="2CH 34:7" /></para>
  <para style="s">योशिय्याहो रे जरिये मन्दरो री मरम्मत</para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 34:8" />तेबे आपणे राज्य रे ठारूए साले जेबे से देश ओर यहोवे रे मन्दरो दुँईं खे शुद्ध करी चुकेया, तेबे तिने असल्याह रे पाऊ शापान ओर शईरो रे परदान मासेयाह ओर योआहाजो रा पाऊ इतियासो खे लिखणे वाल़ा योआह खे आपणे परमेशर यहोवे रे मन्दरो री मरम्मत करने खे पेजीता। <verse eid="2CH 34:8" /><verse number="9" style="v" sid="2CH 34:9" />तेबे तिने हिल्किय्याह बड़े पुरोईतो गे जाई की जो पैसा परमेशरो रे मन्दरो रे ल्याया था, मतलब जो लेवी द्वारपाले मनश्शे, एप्रैमी ओर सारे बचे रे इस्राएली लोका ते ओर सारे यहूदा, ओर बिन्यामीन ओर सारे यरूशलेम शईरो रे रणे वाल़ेया रे आथो ते लई की कट्ठा कित्तेया था, तेसगे सम्बाल़ी था। <verse eid="2CH 34:9" /><verse number="10" style="v" sid="2CH 34:10" />मतलब तिने से तिना काम करने वाल़ेया रे आथो रे सम्बाल़ी ता जो यहोवे रे मन्दरो रे कामो पाँदे मुखिये थे ओर यहोवे रे मन्दरो दे काम करने वाल़ेया तेस मन्दरो रे जो कुछ टूटी-फूटी रा था, तिजी री मरम्मत करने खे लगाया। <verse eid="2CH 34:10" /><verse number="11" style="v" sid="2CH 34:11" />मतलब तिने से मिस्त्री ओर राजमिस्त्रिया खे देईता, ताकि सेयो कअड़े रे पात्थर ओर जोड़ने खे लकड़ी खरीदो ओर तिना कअरा खे छवाओ, जो यहूदा रे राजेया नाश करीते थे। <verse eid="2CH 34:11" /><verse number="12" style="v" sid="2CH 34:12" />सेयो माणूं सच्चाईया साथे काम करो थे ओर तिना रे अधिकारी मरारीय, यहत ओर ओबद्याह, लेवी ओर कहाती, जकर्याह ओर मशुल्लाम, काम चलाणे वाल़े ओर गाणे-बजाणे रा पेत सब जाणने वाल़े लेविये बी थे। <verse eid="2CH 34:12" /><verse number="13" style="v" sid="2CH 34:13" />तेबे सेयो बोजा टोणे वाल़ेया रे परदान थे ओर कई प्रकारा री सेवा ओर काम चलाणे वाल़े थे ओर कुछ लेविये मुंशी, सरदार ओर द्वारपाल थे।<verse eid="2CH 34:13" /></para>
  <para style="s">बिधानो री कताबा रा मिलणा</para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 34:14" />जेबे सेयो तेस पैसे खे जो यहोवे रे मन्दरो रे पऊँचाया था, काडणे लगी रे थे, तेबे हिल्किय्याह पुरोईतो खे मूसे रे जरीये दित्ती री यहोवे रे बिधि-बिधानो री कताब मिली। <verse eid="2CH 34:14" /><verse number="15" style="v" sid="2CH 34:15" />तेबे हिल्किय्याहे राजे रे मंत्री शापानो खे बोलेया, “माखे यहोवे रे मन्दरो दे बिधानो री कताब मिली री।” तेबे हिल्किय्याहे शापानो खे से कताब देईती। <verse eid="2CH 34:15" /><verse number="16" style="v" sid="2CH 34:16" />तेबे शापान तेसा कताबा खे राजे गे लईगा ओर ये सन्देश दित्तेया, “जो-जो काम तेरे कर्मचारिया गे सम्बाल़ेया था, सेयो तिजी खे करने लगी रे। <verse eid="2CH 34:16" /><verse number="17" style="v" sid="2CH 34:17" />जो पैसा यहोवे रे मन्दरो रे मिलेया, से तिने निकयाल़ी की मुखिये ओर कारीगरा रे आथो रे सम्बाल़ी ता।” <verse eid="2CH 34:17" /><verse number="18" style="v" sid="2CH 34:18" />तेबे शापान मंत्रीए खे ये बी बताईता कि हिल्किय्याह पुरोईते माखे एक कताब देई राखी, तेबे तिने तिजी बीचा ते राजे गे पढ़ी की सुणाया। <verse eid="2CH 34:18" /><verse number="19" style="v" sid="2CH 34:19" />बिधानो रिया तिना गल्ला खे सुणी की राजे दु:खो रिया बजा ते आपणे टाल्ले फाड़े। <verse eid="2CH 34:19" /><verse number="20" style="v" sid="2CH 34:20" />तेबे राजे हिल्किय्याह, शापानो रा पाऊ अहीकाम, मीका रा पाऊ अब्दोन, शापान मंत्री ओर असायाह नाओं रे आपणे कर्मचारिये खे आज्ञा दित्ती, <verse eid="2CH 34:20" /><verse number="21" style="v" sid="2CH 34:21" />“तुसे जाई की मेरी तरफा ते ओर इस्राएल ओर यहूदा रे रणे वाल़ेया रिया तरफा ते एसा मिली रिया कताबा रे वचनो रे बारे दे यहोवे ते पूछो; कऊँकि यहोवे री बड़ी-पारी जल़न आसा पाँदे इजी खे पड़की री कऊँकि म्हारे बुजुर्गे यहोवे रा वचन नि मानेया ओर एसा बिधानो री कताबा रे लिखी री सबी आज्ञा रा पालण नि कित्तेया।”<verse eid="2CH 34:21" /></para>
  <para style="s">हुल्दा री भविष्यबाणी</para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 34:22" />तेबे हिल्किय्याहे राजे रे कई दूता समेत हुल्दा नबीया गे जाईकी तेसा साथे तेसा ई गल्ला रे मुताबिक गल्ला कित्तिया, से तो तेस शल्लूमो री लाड़ी थी जो तोखतो रा पाऊ ओर हस्रा रा पोता ओर टाल्लेया रा रखवाल़ा था ओर से जवाणस यरूशलेम शईरो दे नवीं टोलिया दे रओ थी। <verse eid="2CH 34:22" /><verse number="23" style="v" sid="2CH 34:23" />तेसे तिना खे बोलेया, “इस्राएलो रा यहोवा परमेशर ईंयाँ बोलोआ कि जिने मर्दे तुसे मांगे पेजे, तेसखे ईंयाँ बोलो, <verse eid="2CH 34:23" /><verse number="24" style="v" sid="2CH 34:24" />यहोवा ईंयाँ बोलोआ कि सुण, आऊँ एते जगा दे ओर एथो रे रणे वाल़ेया लोका पाँदे मुसीबत पाणी। मां सेयो सब स्राप तिना पाँदे पाणे जिना रा जिक्र यहूदा रे राजे रे सामणे जो कताब पढ़ी तिदे लिखी राखेया ए। <verse eid="2CH 34:24" /><verse number="25" style="v" sid="2CH 34:25" />तिने लोके आऊँ छाडी की पराये देवतेया खे तूप बाल़ेया ओर आपणी बणाई रिया सबी मूर्तिया रे जरीये माखे गुस्सा चढ़ाया, इजी बजा ते मेरी जल़न एते जगा पाँदे पड़की री ओर शान्त नि ऊणी। <verse eid="2CH 34:25" /><verse number="26" style="v" sid="2CH 34:26" />पर यहूदा रा राजा जिने तुसे यहोवे ते पूछणे खे पेजी राखे तेसखे तुसे ईंयाँ बोलो कि इस्राएलो रा यहोवा परमेशर ईंयाँ बोलोआ, <verse eid="2CH 34:26" /><verse number="27" style="v" sid="2CH 34:27" />कऊँकि तूँ तिना गल्ला खे सुणी की दीन ऊआ ओर परमेशरो सामणे आपणा सिर चुकाया ओर तेसरिया गल्ला सुणी की जो तिने एते जगा रे बारे दे ओर एथो रे रणे वाल़ेया लोका रे खलाफ बोलिया, तैं मां सामणे आपणा सिर चुकाया ओर टाल्ले फाड़ी की मां सामणे रोया, इजी बजा ते मैं तेरी बिनती सुणी; यहोवे री ये बाणी ए। <verse eid="2CH 34:27" /><verse number="28" style="v" sid="2CH 34:28" />सुण, आऊँ ताखे तेरे बुजुर्गा साथे एड़ा मलाऊँगा कि तूँ शान्तिया साथे आपणी कब्रा दे पऊँचाया जाणा ओर जो मुसीबत आऊँ एते जगा पाँदे ओर एथो रे रणे वाल़ेया लोका पाँदे पाणा चाऊँआ, तिजी बीचा ते ताखे कुछ बी देखणा नि पड़ना।” तेबे तिने लोके वापस ऊई की राजे खे येई सन्देस दित्तेया।<verse eid="2CH 34:28" /></para>
  <para style="s">योशिय्याह रे जरिये आज्ञा मानणे री कसम लणा</para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 34:29" />तेबे राजे यहूदा ओर यरूशलेम शईरो रे सब बुजुर्ग कट्ठे करने खे बोलेया। <verse eid="2CH 34:29" /><verse number="30" style="v" sid="2CH 34:30" />राजा यहूदा रे सारे लोका ओर यरूशलेम शईरो दे सब रणे वाल़े ओर पुरोईत, लेविये, बल्कि छोटे-बड़े सारी‍ प्रजा रे लोका खे साथे लई की यहोवे रे मन्दरो दे गया, तेबे तिने जो वाचा री कताब यहोवे रे मन्दरो दे मिली थी तेते बीचा ते सारिया गल्ला पढ़ी की तिना खे सुणाईयां। <verse eid="2CH 34:30" /><verse number="31" style="v" sid="2CH 34:31" />तेबे राजे आपणी जगा पाँदे खड़े ऊई की, यहोवे साथे इजी गल्ला रे बारे दे वाचा बानी कि मां यहोवे पीछे-पीछे चलणा ओर आपणे सारे मन ओर सारे प्राणो साथे तेसरी आज्ञा, चतौणी ओर बिधिया रा पालण करना ओर इना वाचा रिया गल्ला खे जो एते कताबा दे लिखी राखिया, पुरिया करनिया। <verse eid="2CH 34:31" /><verse number="32" style="v" sid="2CH 34:32" />तेबे तिने तिना सबी खे जो यरूशलेम शईरो रे ओर बिन्यामीनो रे थे तेड़ी ई वाचा बणवाई ओर यरूशलेम शईरो रे रणे वाल़े, परमेशर जो तिना रे पितरा रा परमेशर था, तेसरी वाचा रे मुताबिक करने लगे। <verse eid="2CH 34:32" /><verse number="33" style="v" sid="2CH 34:33" />योशिय्याहे इस्राएलो रे सारे देशो दे अशुद्ध मूर्तिया दूर करी कित्तिया जिना ते यहोवा नफरत करो था, फेर इस्राएलो दे जितणे बी इस्राएली लोक ओर गुलाम लोक मिले, तिना सबी ते यहोवा परमेशरो री सेवा कराई, मतलब तिना रे परमेशर यहोवे री आराधना कराई, तेसरी पूरी जिन्दगी तिने आपणे बुजुर्गा रे यहोवा परमेशरो पीछे चलणा नि छाडेया।<verse eid="2CH 34:33" /></para>
  <chapter eid="2CH 34" />
  <chapter number="35" style="c" sid="2CH 35" />
  <para style="s">योशिय्याह रा कित्तेया दा फसह रा त्योआर</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 35:1" />योशिय्याहे यरूशलेम शईरो रे यहोवे खे फसह रा त्योआर मनाया ओर पईले मीन्ने रे चौदुए दिने फसह रा डांगर बलि कित्तेया। <verse eid="2CH 35:1" /><verse number="2" style="v" sid="2CH 35:2" />तिने पुरोईत आपणे-आपणे कामो पाँदे ठराए ओर यहोवे रे मन्दरो री सेवा करने खे तिना खे ईम्मत दित्ती। <verse eid="2CH 35:2" /><verse number="3" style="v" sid="2CH 35:3" />तेबे लेविये जो सबी इस्राएली लोका खे सिखाओ थे ओर यहोवे खे पवित्र ठईरे थे, तिना खे तिने बोलेया, “तुसे पवित्र सन्दूको खे तेस मन्दरो दे राखो जो दाऊदो रे पाऊ इस्राएलो रे राजा सुलैमाने बणवाया था; एबे तुसा खे से कान्दा पाँदे नि चकणा पड़ना। एबे आपणे परमेशर यहोवे री ओर तेसरी प्रजा इस्राएलो री सेवा करो। <verse eid="2CH 35:3" /><verse number="4" style="v" sid="2CH 35:4" />इस्राएलो रे राजा दाऊद ओर तेसरे पाऊ सुलैमान दुँईं री लिखी री बिधिया रे मुताबिक, आपणे-आपणे पितरा रे मुताबिक, आपणे-आपणे दलो दे सेवा रा काम करने खे त्यार रओ। <verse eid="2CH 35:4" /><verse number="5" style="v" sid="2CH 35:5" />तुसा रे पाईया रे पितरा रे करानेया रे इस्सेया रे मुताबिक पवित्र जगा रे खड़े रओ, मतलब तिना रे एक इस्से खे लेविया रे एक-एक पितरा रे कराने रा एक इस्सा ओ। <verse eid="2CH 35:5" /><verse number="6" style="v" sid="2CH 35:6" />फसह रे डांगरा खे बलि करो ओर आपू-आपू खे पवित्र करी की आपणे पाईया रिया तँईं त्यारी करो, ताकि सेयो यहोवे रे तेस वचनो रे मुताबिक करी सको, जो तिने मूसे रे जरीये बोलेया था।” <verse eid="2CH 35:6" /><verse number="7" style="v" sid="2CH 35:7" />तेबे योशिय्याहे सबी लोका खे जो तेती आजीर थे, 30,000 पेडा-बाकरिया रे बच्चे ओर 3,000 बल़द दित्ते थे; यो सब फसह रे बलिदानो खे राजे रिया सम्पत्तिया बीचा ते दित्ते थे। <verse eid="2CH 35:7" /><verse number="8" style="v" sid="2CH 35:8" />तेसरे परदाने प्रजा रे लोक, पुरोईत ओर लेविया खे आपणी इच्छा रे मुताबिक बलिया खे डांगर दित्ते। ओर हिल्किय्याह, जकर्याह ओर यहीएल नाओं रे परमेशरो रे मन्दरो रे परदाने पुरोईता खे 2,600 पेडा-बाकरिया ओर 300 बल़द फसह रे बलिदानो खे दित्ते। <verse eid="2CH 35:8" /><verse number="9" style="v" sid="2CH 35:9" />कोनन्याह, शमायाह ओर नतनेल जो तेसरे पाई थे, ओर हशब्याह, यीएल ओर योजाबाद नाओं रे लेविया रे परदाने लेविया खे 5,000 पेडा-बाकरिया ओर 500 बल़द फसह रे बलिदानो खे दित्ते।<verse eid="2CH 35:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 35:10" />ईंयाँ आराधना री त्यारी ऊई गी ओर राजे री आज्ञा रे मुताबिक पुरोईत आपणी-आपणी जगा पाँदे काम करो थे ओर लेविये आपणे-आपणे दलो दे खड़े ऊए। <verse eid="2CH 35:10" /><verse number="11" style="v" sid="2CH 35:11" />तेबे फसह रे डांगर बलि कित्ते ओर पुरोईत बलि करने वाल़ेया रे आथो ते खून लई की छिड़की देयो थे ओर लेविये तिना री खाल उतारो थे। <verse eid="2CH 35:11" /><verse number="12" style="v" sid="2CH 35:12" />तेबे तिने होमबलिया रे डांगर इजी री खातर लग कित्ते, ताकि तिना खे लोका रे पितरा रे करानेया रे इस्से रे मुताबिक देयो कि सेयो यहोवे खे चढ़त देयो जेड़ा कि मूसे री कताबा रे लिखी राखेया ओर बल़द बी तिने एड़े ई कित्ते। <verse eid="2CH 35:12" /><verse number="13" style="v" sid="2CH 35:13" />तेबे तिने फसह रे डांगरा रा मास बिधिया रे मुताबिक आगी रे पूजेया ओर पवित्र चीजा, टोकणी ओर टोकणेया रे ओर थाल़िया दे राखी की फुर्तिया साथे लोका तक पऊँचाई ता। <verse eid="2CH 35:13" /><verse number="14" style="v" sid="2CH 35:14" />तेबे तिने आपू खे ओर पुरोईता खे त्यारी कित्ती, कऊँकि हारूणो री ल्वादा रे पुरोईत होमबलिया रे डांगर ओर चर्बी राथियो तक चढ़ांदे रये, इजी बजा ते लेविये आपू खे ओर हारूणो री ल्वादा रे पुरोईता खे त्यारी कित्ती।<verse eid="2CH 35:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 35:15" />आसापो रे कुलो रे गाणे वाल़े, दाऊद, आसाप, हेमान ओर राजे रे दर्शी यदूतूनो री आज्ञा रे मुताबिक आपणी-आपणी जगा दे रये ओर द्वारपाल एक-एक बड़े द्वारो गे रये। तिना खे आपणा-आपणा काम नि छाडणा पड़ेया, कऊँकि तिना रे लेवी पाईए तिना खे त्यारी कित्ती। <verse eid="2CH 35:15" /><verse number="16" style="v" sid="2CH 35:16" />ईंयाँ तेस ई दिने राजा योशिय्याह री आज्ञा रे मुताबिक फसह मनाणे ओर यहोवे री बेदिया पाँदे होमबलि चढ़ाणे रे कामो खे यहोवे री सारी आराधना री त्यारी कित्ती। <verse eid="2CH 35:16" /><verse number="17" style="v" sid="2CH 35:17" />जो इस्राएली तेथी आजीर थे तिने फसह खे तेसी बखते ओर बिना सजेड़े री रोटिया रा त्योआर सात दिना तक मनाया। <verse eid="2CH 35:17" /><verse number="18" style="v" sid="2CH 35:18" />एस फसह रे बराबर शमूएल नबीए रे दिना ते इस्राएलो रे कोई फसह नि मनाया था ओर ना इस्राएलो रे केसी राजे एड़ा मनाया, जेड़ा योशिय्याह ओर पुरोईते, लेविये ओर जितणे यहूदी ओर इस्राएली तेती आजीर थे, तिने ओर यरूशलेम शईरो रे रणे वाल़ेया मनाया। <verse eid="2CH 35:18" /><verse number="19" style="v" sid="2CH 35:19" />ये फसह योशिय्याह रे राज्य रे ठारूए साले मनाया।<verse eid="2CH 35:19" /></para>
  <para style="s">योशिय्याह री मौत ओर तेसरे राज्य रा अन्त</para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 35:20" />इजी ते बाद जेबे योशिय्याह मईलो खे त्यार करी चुकेया, तेबे मिस्रो रा राजा नको फरात नदिया रे नेड़े कर्कमीश शईरो ते लड़ने खे आया ओर योशिय्याह तेसरा सामणा करने खे गया। <verse eid="2CH 35:20" /><verse number="21" style="v" sid="2CH 35:21" />पर नको राजे योशिय्याह गे आपणे दूता रे जरीये सन्देस पेजेया, “ओ यहूदा रे राजा मेरा तां साथे क्या काम! आज आऊँ तां पाँदे नि तेस कुलो पाँदे ई चढ़ाई करने लगी रा, जेस साथे आऊँ युद्ध करूँआ, तेबे परमेशरे माखे फुर्ती करने खे बोली राखेया। इजी री खातर परमेशर जो मां साथे ए, तेसते लग रओ, केथी एड़ा नि ओ कि से ताखे नाश करो।” <verse eid="2CH 35:21" /><verse number="22" style="v" sid="2CH 35:22" />पर योशिय्याहे तेसते मूँ नि फेरेया, बल्कि तेस साथे लड़ने खे पेष बदलेया ओर नको रिया सेयो गल्ला नि मानिया जो तिने परमेशरो रिया तरफा ते बोलिया थिया ओर मगिद्दो री तराईया दे तेस साथे युद्ध करने खे गया। <verse eid="2CH 35:22" /><verse number="23" style="v" sid="2CH 35:23" />तेबे धनुष चलाणे वाल़ेया योशिय्याह राजे रिया तरफा खे तीर छाडे ओर राजे आपणे सेवका खे बोलेया, “आऊँ बऊत कायल ऊईगा रा, ओर एबे माखे एथा ते फटाफट लई चलो।” <verse eid="2CH 35:23" /><verse number="24" style="v" sid="2CH 35:24" />तेबे तेसरे सेवके से रथो ते उतारी की तेसरे दूजे रथो पाँदे चढ़ाया ओर यरूशलेम शईरो खे लईगे। तेती से मरी गा ओर तेसरे बुजुर्गा रे कब्रिस्तानो रे तेसखे माट्टी दित्ती। यहूदी ओर यरूशलेमिये योशिय्याह खे शोग मनाया। <verse eid="2CH 35:24" /><verse number="25" style="v" sid="2CH 35:25" />यिर्मयाहे योशिय्याह खे शोगो रा गाणा बणाया ओर सब गाणे वाल़े ओर गाणे वाल़िया आपणे शोगो रे गाणे रे योशिय्याह री चर्चा आजो तक करोईया। इना रा ये गाणा इस्राएलो दे एक बिधिया जेड़ा ठराया ओर यो गल्ला शोगो रे गाणेया रे लिखी राखिया।<verse eid="2CH 35:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 35:26" />योशिय्याह रे ओर काम ओर पलाईया रे जो काम तिने तेतेरे ई मुताबिक कित्ते जो यहोवे रे बिधानो दे लिखी राखे, <verse eid="2CH 35:26" /><verse number="27" style="v" sid="2CH 35:27" />शुरूओ ते लई की अन्तो तक तेसरे सारे काम इस्राएल ओर यहूदा रे राजेया रे इतियासो री कताबा दे लिखी राखे।<verse eid="2CH 35:27" /></para>
  <chapter eid="2CH 35" />
  <chapter number="36" style="c" sid="2CH 36" />
  <para style="s">यहूदा दे यहोआहाजो रा राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 36:1" />तेबे देशो रे लोके योशिय्याह रे पाऊ यहोआहाजो खे लई की तेसरे बाओ री जगा पाँदे यरूशलेम शईरो रे राजा बणाया। <verse eid="2CH 36:1" /><verse number="2" style="v" sid="2CH 36:2" />जेबे यहोआहाज राज करने लगेया, तेबे से तेईया साला रा था ओर तीन मीन्ने तक यरूशलेम शईरो रे राज करदा रया। <verse eid="2CH 36:2" /><verse number="3" style="v" sid="2CH 36:3" />तेबे मिस्रो रे राजे से यरूशलेम शईरो रे राजगद्दिया ते उतारी ता ओर देशो पाँदे 3,400 किलो चाँदी ओर 34 किलो सूईना जुर्माने रे दण्ड लगाया। <verse eid="2CH 36:3" /><verse number="4" style="v" sid="2CH 36:4" />तेबे मिस्रो रे राजे तेसरा पाई एल्याकीम यहूदा ओर यरूशलेम शईरो रा राजा बणाया ओर तेसरा नाओं बदली की यहोयाकीम राखेया; पर नको तेसरे पाई यहोआहाजो खे मिस्रो खे लईगा।<verse eid="2CH 36:4" /></para>
  <para style="s">यहूदा दे यहोयाकीमो रा राज्य</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 36:5" />जेबे यहोयाकीम राज करने लगेया, तेबे से पच्चीया साला रा था ओर ग्यारा साला तक यरूशलेम शईरो दे राज करदा रया। तिने से काम कित्ते जो तेसरे परमेशर यहोवे री नजरा रे बुरे थे। <verse eid="2CH 36:5" /><verse number="6" style="v" sid="2CH 36:6" />तेस पाँदे बाबेलो रे राजे नबूकदनेस्सरे अमला कित्तेया ओर बाबेलो खे लई जाणे खे तेसखे पीतल़ी रिया बेड़िया पन्याईया। <verse eid="2CH 36:6" /><verse number="7" style="v" sid="2CH 36:7" />तेबे नबूकदनेस्सरे यहोवे रे मन्दरो रे कुछ पांडे आपणे मन्दरो रे जो बाबेलो दे था लई जाई की राखी ते। <verse eid="2CH 36:7" /><verse number="8" style="v" sid="2CH 36:8" />यहोयाकीमो रे ओर काम ओर तिने जो-जो नीच काम कित्ते ओर तेसरे जो-जो बुराईया थिया, सेयो इस्राएल ओर यहूदा रे राजेया रे इतियासो री कताबा दे लिखी राखिया; ओर तेसरा पाऊ यहोयाकीन तेसरी जगा पाँदे राज करने लगेया।<verse eid="2CH 36:8" /></para>
  <para style="s">यहूदा दे यहोयाकीनो रा राज्य</para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 36:9" />जेबे यहोयाकीन राज करने लगेया, तेबे से ठारा साला रा था ओर तीन मीन्ने ओर दसा दिना तक यरूशलेम शईरो रे राज करदा रया। तिने से कित्तेया जो परमेशर यहोवे री नजरा रे बुरा ए। <verse eid="2CH 36:9" /><verse number="10" style="v" sid="2CH 36:10" />नया साल लगदे ई नबूकदनेस्सर राजे लोक पेजी की, से ओर यहोवे रे मन्दरो रे अच्छे पांडे बाबेलो खे मँगवाई ते ओर तेसरे पाई सिदकिय्याह खे यहूदा ओर यरूशलेम शईरो पाँदे राजा बणाया।<note caller="+" style="f"><char style="fr" closed="false">36:10 </char><char style="ft" closed="false">मत्ती 1:11</char></note><verse eid="2CH 36:10" /></para>
  <para style="s">यहूदा दे सिदकिय्याह रा राज्य</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 36:11" />जेबे सिदकिय्याह राज करने लगेया, तेबे से इक्कीया साला रा था ओर यरूशलेम शईरो रे ग्यारा साला तक राज करदा रया। <verse eid="2CH 36:11" /><verse number="12" style="v" sid="2CH 36:12" />तिने सेई कित्तेया जो तेसरे परमेशर यहोवे री नजरा रे बुरा ए। तेबे बी यिर्मयाह नबी यहोवे रिया तरफा ते गल्ला करो था, तेबे बी से तेस सामणे दीन नि ऊआ। <verse eid="2CH 36:12" /><verse number="13" style="v" sid="2CH 36:13" />फेर नबूकदनेस्सर राजा जिने तेसखे परमेशरो री कसम खुल़ाई थी, तेस साथे तिने बगावत कित्ती ओर तिने जीद कित्ती ओर आपणा मन काठा कित्तेया, ताकि से इस्राएलो रे परमेशर यहोवे रिया तरफा खे नि फिरो।<verse eid="2CH 36:13" /></para>
  <para style="s">यरूशलेम शईरो रा नाश</para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 36:14" />सबी परदान पुरोईते ओर लोके बी दूजी जातिया जेड़े नीच काम करी की बऊत बड़ा विश्वासघात कित्तेया ओर यहोवे रे मन्दरो खे जो तिने यरूशलेम शईरो दे पवित्र कित्तेया था, अशुद्ध करी ता। <verse eid="2CH 36:14" /><verse number="15" style="v" sid="2CH 36:15" />तिना रे बुजुर्गा रे यहोवा परमेशरे बड़ी कोशिश करी की आपणे दूता गे तिना खे सन्देसा पेजेया, कऊँकि तेसखे आपणी‍ प्रजा ओर आपणे मन्दरो पाँदे तरस आओ था। <verse eid="2CH 36:15" /><verse number="16" style="v" sid="2CH 36:16" />पर सेयो परमेशरो रे दूता रा मजाक उडाओ थे, तिना रे वचना खे बेकार जाणो थे ओर तेसरे नबिया रिया आसिया लगाओ थे। तेबे यहोवा आपणी प्रजा पाँदे एड़ा गुस्से ऊआ कि बचणे रा कोई तरीका नि रया।<note caller="+" style="f"><char style="fr" closed="false">36:16 </char><char style="ft" closed="false">प्रेरि. 13:41 </char></note> <verse eid="2CH 36:16" /><verse number="17" style="v" sid="2CH 36:17" />तेबे तिने तिना पाँदे कसदिया रे राजेया ते चढ़ाई करवाई ओर तिने तिना रे जवान पवित्र मन्दरो रेई तलवारी साथे काये ओर क्या जवान, क्या कुआँरिया, क्या स्याणे केसी पाँदे बी दया नि कित्ती; यहोवे सारे यरूशलेम शईरो रे लोक तेसरे आथो रे करीते। <verse eid="2CH 36:17" /><verse number="18" style="v" sid="2CH 36:18" />क्या छोटे, क्या बड़े, परमेशरो रे मन्दरो रे सारे पांडे ओर यहोवे रे मन्दरो रे ओर राजा ओर तेसरे परदानो रे खजाने, इना सबी खे से बाबेलो खे लईगा। <verse eid="2CH 36:18" /><verse number="19" style="v" sid="2CH 36:19" />तेबे कसदिये परमेशरो रा मन्दर फूकी ता ओर यरूशलेम शईरो री दवाला तोड़ी तिया ओर आग लगाई की तेसरे सारे मईल फूकी ते ओर तिना रा सारा कीमती सामान नाश करी ता। <verse eid="2CH 36:19" /><verse number="20" style="v" sid="2CH 36:20" />जो तलवारी साथे बची गे, तिना खे से बाबेलो रे लईगा ओर फारसो रे राज्य रे प्रबल ऊणे तक सेयो तेसरे ओर माठे-पोतेया रे वशो दे रये। <verse eid="2CH 36:20" /><verse number="21" style="v" sid="2CH 36:21" />ये सब इजी खे ऊआ, ताकि यहोवे रा जो वचन यिर्मयाह रे मुंए ते निकल़ेया था, से पूरा ओ कि देश आपणे रामो रे बखतो रे दिना दे सुख पोगदा रओ। इजी री खातर जदुओ तक से सूना पड़ेया रा रया तदुओ तक, मतलब सत्तर साल पूरे ऊणे तक तेसखे राम मिलेया।<verse eid="2CH 36:21" /></para>
  <para style="s">राजा कुस्रूए रे राजो दे यहूदिया री यरूशलेमो खे वापसी</para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 36:22" />फारसो रे राजा कुस्रूए रे पईले सालो रे यहोवे तेसरा मन त्यार कित्तेया, कि जो वचन यिर्मयाह रे मुंए ते निकल़ेया था, से पूरा ओ। इजी री खातर तिने आपणे सारे राज्य रे ये प्रचार करवाया ओर एते उम्मीदा ते ये पर्चिया लिखाईया, <verse eid="2CH 36:22" /><verse number="23" style="v" sid="2CH 36:23" />“फारसो रा राजा कुस्रू बोलोआ कि स्वर्गो रे यहोवा परमेशरे पूरी तरतिया रा राज्य माखे देई राखेया ओर तिने ई माखे आज्ञा देई राखी कि यरूशलेम जो यहूदा दे ए तिदे मेरा एक मन्दर बणवा; इजी री खातर ओ तेसरी प्रजा रे सारे लोको, तुसा बीचा ते जो कोई चाओ, तेसरा यहोवा परमेशर तेस साथे रओ, से तेथो खे चली जाओ।”<verse eid="2CH 36:23" /></para>
  <chapter eid="2CH 36" />
</usx>