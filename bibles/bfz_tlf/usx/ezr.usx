<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EZR" style="id" />
  <para style="h">एज्रा</para>
  <para style="toc1">एज्रा नाओं री कताब</para>
  <para style="toc2">एज्रा</para>
  <para style="toc3">एज्र.</para>
  <para style="mt">एज्रा</para>
  <para style="mt2">एज्रा नाओं री कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">एज्रा नाओं रिया कताबा दे इतिआसो रिया कताबा ते आगली जानकारी मिलोई। एते दे बेबीलोनो रिया गुलामिया ते आए दे कुछ यहूदी माणूं ओर यरूशलेम शईरो दे दुबारा माणूंआ रा बसणा ओर परमेशरो री आराधना रा दुबारा शुरू ऊणे रे बारे दे पता चलोआ। एते कताबा दे लिखिया दिया कटणा यो ईया:</para>
  <para style="ili">(1) फारसो रे राजा कुस्रूए रिया आज्ञा ते यहूदिया रे पईले चूण्डो रा आऊणा।</para>
  <para style="ili">(2) यरूशलेम शईरो रे मन्दरो रा दुबारा बनाणा ओर सौंपणा, ओर परमेशरो री आराधना दुबारा शुरू करना।</para>
  <para style="ili">(3) कईया साला बाद एज्रा रिया अगुवाईया दे एक ओर यहूदिया रे चूण्डो रा यरूशलेम शईरो खे आऊणा।</para>
  <para style="ip">एज्रा जो कि परमेशरो रे बिधानो रा अच्छा जाणकार था तिने लोका रे तार्मिक ओर समाजिक जिंदगी जिऊणे दे तिना री मताद कित्ती ताकि इस्राएलो री आध्यात्मिक सम्पति बचाई की राखी सको।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">गुलामिया ते पईले दलो रा आऊणा <char style="ior"><ref loc="EZR 1:1-2:70">1:1-2:70</ref></char></para>
  <para style="io1">मन्दरो रा दुबारा बनाणा ओर सौंपणा <char style="ior"><ref loc="EZR 3:1-6:22">3:1-6:22</ref></char></para>
  <para style="io1">एज्रा री दूजेया कैदिया साथे दुबारा यरूशलेम शईरो खे आऊणा <char style="ior"><ref loc="EZR 7:1-10:44">7:1-10:44</ref></char></para>
  <chapter number="1" style="c" sid="EZR 1" />
  <para style="s">गुलाम यहूदिया रा यरूशलेम शईरो खे वापस जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 1:1" />फारस देशो रे राजा कुस्रूए रे राज रे पईले सालो रे यहोवे फारसो रे राजा कुस्रूए रा मन उभारेया, ताकि यहोवे रा जो वचन यिर्मयाह नबीए रे मुंए ते निकल़ेया था से पूरा ओ, इजी री खातर तिने आपणे सारे राज्य दे ये प्रचार करवाया ओर लिखाई बी दित्तेया <verse eid="EZR 1:1" /><verse number="2" style="v" sid="EZR 1:2" />“आऊँ फारसो रा राजा कुस्रू ए। स्वर्गो रे यहोवा परमेशरे जो इस्राएलो रा बी परमेशर ए, तिने आऊँ पूरी तरतिया रिया सबी जातिया पाँदे परदान चूणी राखेया। ओर तिने माखे यरूशलेम शईरो दे, जो यहूदा रे इलाके दे ए, तेसरिया तँईं एक मन्दर बनाणे खे आऊँ चूणी राखेया ए। <verse eid="EZR 1:2" /><verse number="3" style="v" sid="EZR 1:3" />तेसरी सारी प्रजा रे लोका बीचा ते तुसा बीचे जो कोई ओ, तेसरा परमेशर तेस साथे रओ ओर से यहूदा रे यरूशलेम शईरो दे जाई की इस्राएलो रे परमेशर यहोवे रा मन्दर बणाओ, जो यरूशलेम शईरो दे ए, सेई परमेशर ए। <verse eid="EZR 1:3" /><verse number="4" style="v" sid="EZR 1:4" />इस्राएली जातिया रे बचे दे लोक, जेती-जेती रओए, तेते जगा रे माणूं चाँदी, सूईना, तअन ओर डांगर देई की तेसरी मताद करो ओर इजी ते जादा परमेशरो रे यरूशलेम शईरो रे मन्दरो रे आपणी-आपणी इच्छा ते बी पेंट चढ़ाओ।”<verse eid="EZR 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 1:5" />तेबे यहूदा ओर बिन्यामीनो रे गोत्रो दे जितणे पितरा रे कराने रे खास लोक ओर पुरोईत ओर लेविया बिचा ते परमेशरे जिना लोका रा मन उभारेया था कि जाई की यरूशलेम शईरो दे यहोवे रा मन्दर बणाओ, सेयो सब उठी की खड़े ऊए; <verse eid="EZR 1:5" /><verse number="6" style="v" sid="EZR 1:6" />ओर तिना रे नेड़े-तेड़े रे सब रणे वाल़ेया चाँदिए रे पांडे, सूईना, डांगर ओर कीमती चीजा देई की, तिना री मताद कित्ती; इजी ते जादा लोके आपणी-आपणी इच्छा ते यहोवे रे मन्दरो खे पेंट दित्ती।<verse eid="EZR 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 1:7" />तेबे यहोवे रे मन्दरो रे जो पवित्र पांडे नबूकदनेस्सर राजे यरूशलेम शईरो ते निकयाल़ी की आपणे देवते रे मन्दरो दे राखे थे,<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">2 राज. 25:8-17</char></note> <verse eid="EZR 1:7" /><verse number="8" style="v" sid="EZR 1:8" />फारसो रे राजा कुस्रूए आपणा से माणूं जो तेसरे सारे तअन-दौलता री देखपाल़ करो था, इना चीजा खे बारे ल्याऊणे खे बोलेया। तेस माणूंए रा नाओं मिथ्रदात था। तेबे तिने सेयो सब चीजा यहूदिया रे शेशबस्सर नाओं रे परदानो गे गिणी की सम्बाल़ितिया। <verse eid="EZR 1:8" /><verse number="9" style="v" sid="EZR 1:9" />तिना री गिणती ये थी, मतलब सूईने रे तीई ओर चाँदिए रे 1,000 पराती ओर उणत्ती छुरिया, <verse eid="EZR 1:9" /><verse number="10" style="v" sid="EZR 1:10" />सूईने रे तीई कटोरे ओर अल़्के चाँदिए रे 410 कटोरे ओर ओरी प्रकारा रे 1,000 पांडे। <verse eid="EZR 1:10" /><verse number="11" style="v" sid="EZR 1:11" />सूईने चाँदिए रे सारे पांडे मिलाई की 5,400 थे। इना सबी खे शेशबस्सर तेस बखते ल्याया जेबे गुलाम लोक बाबेलो ते यरूशलेम शईरो खे आए।<verse eid="EZR 1:11" /></para>
  <chapter eid="EZR 1" />
  <chapter number="2" style="c" sid="EZR 2" />
  <para style="s">यरूशलेम शईरो खे वापस ऊए रे यहूदिया रे बारे दे</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 2:1" />जिना खे बाबेलो रा राजा नबूकदनेस्सर बाबेलो खे बन्दुआ बणाई की लईगा था, तिना बीचा ते राज्य रे जो लोक बन्दुआईया ते छूटी की यरूशलेम शईर ओर यहूदा खे आपणे-आपणे कअरो खे वापस ऊए सेयो यो ए। <verse eid="EZR 2:1" /><verse number="2" style="v" sid="EZR 2:2" />ये जरूब्बाबेल, येशुअ, नहेम्याह, सरायाह, रेलायाह, मोर्दकै, बिलशान, मिस्पार, बिगवै, रहूम ओर बानाह रे साथे आए। इस्राएली गोत्रो रे माणूंआ री गिणती ये ए, मतलब <verse eid="EZR 2:2" /><verse number="3" style="v" sid="EZR 2:3" />परोशो री ल्वाद 2,172, <verse eid="EZR 2:3" /><verse number="4" style="v" sid="EZR 2:4" />शपत्याह री ल्वाद 372, <verse eid="EZR 2:4" /><verse number="5" style="v" sid="EZR 2:5" />आरह री ल्वाद 775, <verse eid="EZR 2:5" /><verse number="6" style="v" sid="EZR 2:6" />पहत्मोआबो री ल्वाद येशुअ ओर योआबो री ल्वादा बीचा ते 2,812, <verse eid="EZR 2:6" /><verse number="7" style="v" sid="EZR 2:7" />एलामो री ल्वाद 1,254, <verse eid="EZR 2:7" /><verse number="8" style="v" sid="EZR 2:8" />जत्तूए री ल्वाद 945, <verse eid="EZR 2:8" /><verse number="9" style="v" sid="EZR 2:9" />जक्कईये री ल्वाद 760, <verse eid="EZR 2:9" /><verse number="10" style="v" sid="EZR 2:10" />बानीए री ल्वाद 642, <verse eid="EZR 2:10" /><verse number="11" style="v" sid="EZR 2:11" />बेबैए री ल्वाद 623, <verse eid="EZR 2:11" /><verse number="12" style="v" sid="EZR 2:12" />अजगादो री ल्वाद 1,222, <verse eid="EZR 2:12" /><verse number="13" style="v" sid="EZR 2:13" />अदोनीकामो री ल्वाद 666, <verse eid="EZR 2:13" /><verse number="14" style="v" sid="EZR 2:14" />बिगवैए री ल्वाद 2,056, <verse eid="EZR 2:14" /><verse number="15" style="v" sid="EZR 2:15" />आदीनो री ल्वाद 454, <verse eid="EZR 2:15" /><verse number="16" style="v" sid="EZR 2:16" />हिजकिय्याह री ल्वाद आतेरो री ल्वादा बीचा ते 98, <verse eid="EZR 2:16" /><verse number="17" style="v" sid="EZR 2:17" />बेसै री ल्वाद 323, <verse eid="EZR 2:17" /><verse number="18" style="v" sid="EZR 2:18" />योरा रे माणूं 112, <verse eid="EZR 2:18" /><verse number="19" style="v" sid="EZR 2:19" />हाशूमो रे माणूं 223, <verse eid="EZR 2:19" /><verse number="20" style="v" sid="EZR 2:20" />गिब्बारो रे माणूं 95, <verse eid="EZR 2:20" /><verse number="21" style="v" sid="EZR 2:21" />बेतलेहमो रे माणूं 123, <verse eid="EZR 2:21" /><verse number="22" style="v" sid="EZR 2:22" />नतोपा रे माणूं 56; <verse eid="EZR 2:22" /><verse number="23" style="v" sid="EZR 2:23" />अनातोतो रे माणूं 128, <verse eid="EZR 2:23" /><verse number="24" style="v" sid="EZR 2:24" />अज्माबेतो रे माणूं 42, <verse eid="EZR 2:24" /><verse number="25" style="v" sid="EZR 2:25" />किर्यत्यारीम कपीरा ओर बेरोतो रे माणूं 743, <verse eid="EZR 2:25" /><verse number="26" style="v" sid="EZR 2:26" />रामाह ओर गेबा रे माणूं 621, <verse eid="EZR 2:26" /><verse number="27" style="v" sid="EZR 2:27" />मिकमाशो रे माणूं 122, <verse eid="EZR 2:27" /><verse number="28" style="v" sid="EZR 2:28" />बेतेल ओर आई रे माणूं 223, <verse eid="EZR 2:28" /><verse number="29" style="v" sid="EZR 2:29" />नबो रे माणूं 52, <verse eid="EZR 2:29" /><verse number="30" style="v" sid="EZR 2:30" />मग्बीसो री ल्वाद 156, <verse eid="EZR 2:30" /><verse number="31" style="v" sid="EZR 2:31" />दूजे एलामो री ल्वाद 1,254, <verse eid="EZR 2:31" /><verse number="32" style="v" sid="EZR 2:32" />हारीमो री ल्वाद 320, <verse eid="EZR 2:32" /><verse number="33" style="v" sid="EZR 2:33" />लोद, हादीद ओर ओनो रे माणूं 725, <verse eid="EZR 2:33" /><verse number="34" style="v" sid="EZR 2:34" />यरीहो रे माणूं 345, <verse eid="EZR 2:34" /><verse number="35" style="v" sid="EZR 2:35" />सना रे माणूं 3,630, <verse eid="EZR 2:35" /><verse number="36" style="v" sid="EZR 2:36" />तेबे पुरोईत, मतलब येशुअ रे कराने बीचा ते यदायाह री ल्वाद 973, <verse eid="EZR 2:36" /><verse number="37" style="v" sid="EZR 2:37" />इम्मेरो री ल्वाद 1,052, <verse eid="EZR 2:37" /><verse number="38" style="v" sid="EZR 2:38" />पशहूरो री ल्वाद 1,247, <verse eid="EZR 2:38" /><verse number="39" style="v" sid="EZR 2:39" />हारीमो री ल्वाद 1,017, <verse eid="EZR 2:39" /><verse number="40" style="v" sid="EZR 2:40" />तेबे लेविये, मतलब येशुअ री ल्वाद ओर कदमिएलो री ल्वाद होदव्याह री ल्वादा बीचा ते 74, <verse eid="EZR 2:40" /><verse number="41" style="v" sid="EZR 2:41" />तेबे गाणेवाल़ेया बीचा ते आसापो री ल्वाद 128, <verse eid="EZR 2:41" /><verse number="42" style="v" sid="EZR 2:42" />तेबे परमेशरे रे मन्दरो रे द्वारपाला री ल्वाद, शल्लूमो री ल्वाद, आतेरो री ल्वाद, तल्मोनो री ल्वाद, अक्कूबो री ल्वाद, हतीता री ल्वाद ओर शोबै री ल्वाद, यो सब मलाई की 139 ऊए। <verse eid="EZR 2:42" /><verse number="43" style="v" sid="EZR 2:43" />तेबे नतीनो री ल्वाद, सीहा री ल्वाद, हसूपा री ल्वाद, तब्बाओतो री ल्वाद। <verse eid="EZR 2:43" /><verse number="44" style="v" sid="EZR 2:44" />केरोसो री ल्वाद, सीअहा री ल्वाद, पादोनो री ल्वाद, <verse eid="EZR 2:44" /><verse number="45" style="v" sid="EZR 2:45" />लबाना री ल्वाद, हगाबा री ल्वाद, अक्कूबो री ल्वाद, <verse eid="EZR 2:45" /><verse number="46" style="v" sid="EZR 2:46" />हागाबो री ल्वाद, शल्मैए री ल्वाद, हानानो री ल्वाद, <verse eid="EZR 2:46" /><verse number="47" style="v" sid="EZR 2:47" />गिद्देलो री ल्वाद, गहरो री ल्वाद, रायाह री ल्वाद, <verse eid="EZR 2:47" /><verse number="48" style="v" sid="EZR 2:48" />रसीनो री ल्वाद, नकोदा री ल्वाद, गज्जामो री ल्वाद, <verse eid="EZR 2:48" /><verse number="49" style="v" sid="EZR 2:49" />उज्जा री ल्वाद, पासेह री ल्वाद, बेसै री ल्वाद, <verse eid="EZR 2:49" /><verse number="50" style="v" sid="EZR 2:50" />अस्ना री ल्वाद, मूनीमो री ल्वाद, नपीसीमो री ल्वाद, <verse eid="EZR 2:50" /><verse number="51" style="v" sid="EZR 2:51" />बकबूको री ल्वाद, हकूपा री ल्वाद, हर्हूरो री ल्वाद, <verse eid="EZR 2:51" /><verse number="52" style="v" sid="EZR 2:52" />बसलूतो री ल्वाद, महीदा री ल्वाद, हर्शा री ल्वाद, <verse eid="EZR 2:52" /><verse number="53" style="v" sid="EZR 2:53" />बर्कोसो री ल्वाद, सीसरा री ल्वाद, तेमह री ल्वाद, <verse eid="EZR 2:53" /><verse number="54" style="v" sid="EZR 2:54" />नसीह री ल्वाद, ओर हतीपा री ल्वाद। <verse eid="EZR 2:54" /><verse number="55" style="v" sid="EZR 2:55" />तेबे सुलैमानो रे दासा री ल्वाद, सोतै री ल्वाद, हस्सोपेरेतो री ल्वाद, परूदा री ल्वाद, <verse eid="EZR 2:55" /><verse number="56" style="v" sid="EZR 2:56" />याला री ल्वाद, दर्कोनो री ल्वाद, गिद्देलो री ल्वाद, <verse eid="EZR 2:56" /><verse number="57" style="v" sid="EZR 2:57" />शपत्याह री ल्वाद, हत्तीलो री ल्वाद, पोकरेत-सबायीमो री ल्वाद ओर आमीए री ल्वाद। <verse eid="EZR 2:57" /><verse number="58" style="v" sid="EZR 2:58" />सब मन्दरो दे सेवा करने वाल़े सेवक ओर सुलैमानो रे दासा री ल्वाद, 392 थे।<verse eid="EZR 2:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="EZR 2:59" />तेबे जो लोक तेल्मेलाह, तेलहर्शा, करूब, अद्दान ओर इम्मेरो ते आए, पर सेयो आपणे-आपणे पितरा रे कराने ओर वंशावली नि बताई सके कि सेयो इस्राएलो रे ए, सेयो यो ए: <verse eid="EZR 2:59" /><verse number="60" style="v" sid="EZR 2:60" />मतलब दलायाह री ल्वाद, तोबिय्याह री ल्वाद ओर नकोदा री ल्वाद, जो मिलाई की 652 थे। <verse eid="EZR 2:60" /><verse number="61" style="v" sid="EZR 2:61" />पुरोईता री ल्वादा बीचा ते होबायाह री ल्वाद, हक्कोसो री ल्वाद ओर बर्जिल्लै री ल्वाद, जिने गिलादी बर्जिल्लै री एकी बेटिया साथे ब्या कित्तेया ओर तेसा रा ई नाओं राखी ता था। <verse eid="EZR 2:61" /><verse number="62" style="v" sid="EZR 2:62" />इने सबी आपणी-आपणी वंशावलिया री चिट्ठी ओरी री वंशावलिया री कताबा दे टोल़ी, पर सेयो नि मिले, इजी री खातर सेयो अशुद्ध ठराई की पुरोईतो रे पदो ते निकयाल़ी ते ओर तिना खे पुरोईतो रा काम नि करने दित्तेया। <verse eid="EZR 2:62" /><verse number="63" style="v" sid="EZR 2:63" />तेबे परदाने तिना खे बोलेया कि जदुओ तक ऊरीम ओर तुम्मीम तारण करने वाल़ा कोई पुरोईत नि ओ, तदुओ तक कोई परम पवित्र चीज नि खाओ। <verse eid="EZR 2:63" /><verse number="64" style="v" sid="EZR 2:64" />सारी मण्डल़ी मिलाई की 42,360 थी। <verse eid="EZR 2:64" /><verse number="65" style="v" sid="EZR 2:65" />इना खे छाडी की इना रे 7,337 दास-दासिया ओर 200 गाणे वाल़े ओर गाणे वाल़िया थिया। <verse eid="EZR 2:65" /><verse number="66" style="v" sid="EZR 2:66" />तिना रे कोड़े 736, खच्चरा 245, <verse eid="EZR 2:66" /><verse number="67" style="v" sid="EZR 2:67" />ऊँट 435, ओर गह्दे 6,720 थे।<verse eid="EZR 2:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="EZR 2:68" />तेबे पितरा रे कराने रे कुछ बड़े-बड़े मर्दे जेबे यहोवे रे मन्दरो दे जो यरूशलेम शईरो दे ए, आए, तेबे परमेशरो रा मन्दर तेसरी जगा पाँदे ई खड़ा करने खे आपणी-आपणी इच्छा ते कुछ दित्तेया। <verse eid="EZR 2:68" /><verse number="69" style="v" sid="EZR 2:69" />तिने आपणी-आपणी आऊँदणियां रे मुताबिक लगभग 500 किलो सूईना ओर कोई 3,000 किलो चाँदिए रे सिक्के ओर पुरोईता जोगे 100 चोगे आपणी-आपणी इच्छा ते तेस कामो रे खजाने दे देई ते। <verse eid="EZR 2:69" /><verse number="70" style="v" sid="EZR 2:70" />तेबे पुरोईत ओर लेविये ओर लोका बीचा ते कुछ ओर गाणे वाल़े ओर द्वारपाल ओर मन्दरो दे सेवा करने वाल़े लोक आपणे शईरो दे ओर सब इस्राएली आपणे-आपणे शईरो दे फेर बसी गे।<verse eid="EZR 2:70" /></para>
  <chapter eid="EZR 2" />
  <chapter number="3" style="c" sid="EZR 3" />
  <para style="s">बेदिया रा फेर बणाया जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 3:1" />जेबे इस्राएली लोका रे सालो रा सातुआ मीन्ना आया तदुए तक सेयो सब आपणे-आपणे शईरा दे बसी गे थे, तेबे लोक यरूशलेम शईरो दे एक मन ऊई की कट्ठे ऊए। <verse eid="EZR 3:1" /><verse number="2" style="v" sid="EZR 3:2" />तेबे योसादाको रे पाऊ येशुअ आपणे पुरोईता पाईया साथे ओर शालतीएलो रे पाऊ जरूब्बाबेले आपणे पाईया साथे लक बानी की इस्राएलो रे परमेशरो री बेदी बणाई, ताकि तेते पाँदे होमबलि चढ़ाई सको, जेड़ा की परमेशरो रे दास मूसे री बिधानो री कताबा दे लिखी राखेया।<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">मत्ती 1:12, लूक. 3:27</char></note><verse eid="EZR 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 3:3" />तेबे तिने बेदी तेथे ई जगा पाँदे खड़ी कित्ती, कऊँकि तिना खे तेस कनारले देशो रे लोका रा डर रया ओर सेयो तेते पाँदे यहोवे खे होमबलि, मतलब हर रोज प्यागा रे ओर साँजके होमबलि चढ़ाणे लगे।<verse eid="EZR 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 3:4" />तेबे तिने चूँगड़िया रा त्योआर मनाया, जेड़ा कि मूसे रे बिधानो री कताबा दे लिखी राखेया ओर हर रोजके होमबलि एकी-एकी दिनो री गिणती ओर बिधानो रे मुताबिक चढ़ाए। <verse eid="EZR 3:4" /><verse number="5" style="v" sid="EZR 3:5" />तिजी ते बाद, तिने लगातार चलणे वाल़े हर एकी दिनो री होमबलि ओर नवां चाँद ओर यहोवे रे पवित्र कित्ते रे सारे ठराए रे त्योआरो रे बलिदान ओर पेंट चढ़ाणे शुरू कित्ते जेड़ा की यहोवे आज्ञा दित्ती थी। लोक ओरी तिना पेंटा खे बी चढ़ाणे लगे जिना खे सेयो यहोवे खे चढ़ाणा चाओ थे। <verse eid="EZR 3:5" /><verse number="6" style="v" sid="EZR 3:6" />सातुए मीन्ने रे पईले दिनो ते सेयो यहोवे खे होमबलि चढ़ाणे लगे। पर यहोवे रे मन्दरो री निऊँ तदुओ तक नि पाई राखी थी।<verse eid="EZR 3:6" /></para>
  <para style="s">मन्दरो रा दुबारा बनाणे रा काम शुरू करना</para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 3:7" />तेबे तिने पात्थर कअड़ने वाल़े ओर कारीगरा खे पैसा ओर सीदोनी ओर सोरी लोका खे खाणे-पीणे रिया चीजा ओर तेल दित्तेया, ताकि सेयो फारसो रे राजा कुस्रूए री पर्चिया रे मुताबिक देवदारो री लकड़ी लबानोनो ते याफा रे समुद्रो तक पऊँचाओ। <verse eid="EZR 3:7" /><verse number="8" style="v" sid="EZR 3:8" />तिना रे परमेशरो रे मन्दरो दे, जो यरूशलेम शईरो दे ए, आऊणे रे दूजे सालो रे दूजे मीन्ने, शालतीएलो रे पाऊ जरूब्बाबेल ओर योसादाको रे पाऊ येशुअ ओर तिना रे ओरी पाईए जो पुरोईत ओर लेविये थे ओर जितणे बन्दुआईया ते यरूशलेम शईरो दे आए थे तिने बी काम शुरू कित्तेया। ओर बीइ साल या तिजी ते जादा उम्रा रे लेविया खे यहोवे रे मन्दरो रा काम करने खे नियुक्त कित्तेया। <verse eid="EZR 3:8" /><verse number="9" style="v" sid="EZR 3:9" />तेबे येशुअ ओर तेसरे पाऊ ओर पाई ओर कदमिएल ओर तेसरे पाऊ, जो यहूदा री ल्वाद थे ओर हेनादादो री ल्वाद परमेशरो रे मन्दरो दे कारीगरा रा काम चलाणे खे खड़े ऊए। ओर सेयो सब लेविया रे कराने रे थे। <verse eid="EZR 3:9" /><verse number="10" style="v" sid="EZR 3:10" />जेबे राजमिस्त्रिए यहोवे रे मन्दरो री निऊँ पाई, तेबे पुरोईते आपणे खास टाल्ले पईने ओर तुरहिया लई की पुरोईत ओर छाज लई की आसापो रे कुलो रे लेवी इजी री खातर नियुक्त कित्ते, ताकि इस्राएली लोका रे राजा दाऊदो री चलाई री रवाजा रे मुताबिक यहोवे री स्तुति करो। <verse eid="EZR 3:10" /><verse number="11" style="v" sid="EZR 3:11" />तेबे सेयो ये गायी की यहोवे री स्तुति ओर तन्यवाद करने लगे,</para>
  <para style="q" vid="EZR 3:11">“से पला ए,</para>
  <para style="q" vid="EZR 3:11">ओर तेसरी करूणा इस्राएलो पाँदे सदा बणी री ए।”</para>
  <para style="p" vid="EZR 3:11">ओर जेबे सेयो यहोवे री स्तुति करने लगे, तेबे सबी लोके ये जाणी की कि यहोवे रे मन्दरो री निऊँ एबे पड़ने लगी री, जोरे की जयजयकार कित्ती। <verse eid="EZR 3:11" /><verse number="12" style="v" sid="EZR 3:12" />पर बऊत सारे पुरोईत ओर लेविये ओर बुजुर्गा रे कराने रे बड़े मर्द, मतलब सेयो स्याणे जिने पईलका मन्दर देखेया था, जेबे एस मन्दरो री निऊँ तिना सामणे पड़ी तेबे जोरे-जोरे की रोणे लगे ओर बऊत खुशिया रे मारे जोरे की जयजयकार करने लगी रे थे। <verse eid="EZR 3:12" /><verse number="13" style="v" sid="EZR 3:13" />इजी री खातर लोक, खुशिया री जयजयकारा री आवाज, लोका रे रोणे री आवाजा ते लग नि पछयाणी सके, कऊँकि लोक जोरे की जयजयकार करने लगी रे थे ओर से आवाज दूरो तक सुणने लगी री थी।<verse eid="EZR 3:13" /></para>
  <chapter eid="EZR 3" />
  <chapter number="4" style="c" sid="EZR 4" />
  <para style="s">दुश्मणा रे जरिये मन्दरो रा काम रोकणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 4:1" />जेबे यहूदा ओर बिन्यामीनी गोत्रा रे दुश्मण सामरी लोके ये सुणेया कि गुलामिया ते छूटे रे लोक इस्राएलो रे यहोवा परमेशरो खे मन्दर बनाणे लगी रे, <verse eid="EZR 4:1" /><verse number="2" style="v" sid="EZR 4:2" />तेबे सेयो जरूब्बाबेल ओर बुजुर्गा रे करानेया रे चूणे दे लोका गे आई की बोलणे लगे, “आसा खे बी आपू साथे एती मन्दर बनाणे खे काम करने देयो; कऊँकि तुसा जेड़े आसे बी तुसा रे परमेशरो री पग्ति करूँए ओर अश्शूरो रा राजा एसर्हद्दोन जिने आसे एती पऊँचाए, तेसरे दिना ते आसे परमेशरो खे ई बलिदान बी चढ़ाऊँए।”<verse eid="EZR 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 4:3" />पर जरूब्बाबेल, येशुअ ओर इस्राएलो रे बुजुर्गा रे कराने रे चूणे दे लोके तिना खे बोलेया, “ना, तुसे लोक म्हारे परमेशरो रा मन्दर बनाणे दे म्हारी मताद नि करी सकदे, आसा लोका ई कट्ठे ऊई की फारसो रे राजा कुस्रूए री आज्ञा रे मुताबिक इस्राएलो रे परमेशर यहोवे खे से मन्दर बनाणा।”<verse eid="EZR 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 4:4" />तेबे तेस देशो रे लोक जो इस्राएली लोका रे वापस आऊणे ते पईले तेती थे यहूदिया खे नराज करने ओर तिना खे डराई की मन्दर बनाणे ते रोकणे लगे। <verse eid="EZR 4:4" /><verse number="5" style="v" sid="EZR 4:5" />ओर सेयो फारसो रे राजा कुस्रूए री पूरी जिन्दगी बल्कि फारसो रे राजा दारा रे राजो रे बखतो तक तिना री इच्छा खे निष्फल करने खे राजे रे अधिकारिया खे पैसा देंदे रये ताकि मन्दरो रा काम रूकी जाओ। <verse eid="EZR 4:5" /><verse number="6" style="v" sid="EZR 4:6" />जेबे क्षयर्ष<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="fq" closed="false">क्षयर्ष </char><char style="ft" closed="false">एसरा दूजा नाओं अहषवेरोष </char></note> फारसो रा राजा राज करने लगेया तेबे तेसरे राजो रे पईले साले ई तिना रे दुश्मण सामरी लोक यहूदा ओर यरूशलेम शईरो दे रणे वाल़े इस्राएली लोका रे दोषो री चिट्ठी तेसखे लिखी की पेजी। <verse eid="EZR 4:6" /><verse number="7" style="v" sid="EZR 4:7" />बादो ते जेबे फारसो रे नवें राजा अर्तक्षत्रो रे दिना दे बिशलाम, मिथ्रदात ओर ताबेले ओर तेस साथले लोके फारसो रे राजा अर्तक्षत्रो खे चिट्ठी लिखी ओर चिट्ठी अरामी अक्षर ओर अरामी पाषा दे लिखी। <verse eid="EZR 4:7" /><verse number="8" style="v" sid="EZR 4:8" />मतलब रहूम राजमंत्री ओर शिमशै मंत्रिये यरूशलेम शईरो रे खलाफ राजा अर्तक्षत्रो खे एते मतलबो ते चिट्ठी लिखी। <verse eid="EZR 4:8" /><verse number="9" style="v" sid="EZR 4:9" />तेस बखते रहूम राजमंत्री ओर शिमशै मंत्री ओर तिना रा साथ देणे वाल़े ओर मतलब दीनी, अपर्सतकी, तर्पली, अफारसी, एरेकी, बाबेली, शूशनी, देहवी, एलामी, <verse eid="EZR 4:9" /><verse number="10" style="v" sid="EZR 4:10" />आदि जातिये जिना खे महान ओर परदान ओस्नप्परे पार ल्याई की सामरिया रे शईरा दे ओर फरात नदिया रे पच्छमी प्रदेशो रे कईया जगा दे बसाया था तिने बी एक चिट्ठी लिखी।<verse eid="EZR 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 4:11" />जो चिट्ठी तिने अर्तक्षत्र राजे खे लिखी, तेतेरी ये नकल ए, “राजा अर्तक्षत्रो री सेवा दे तेरे दास जो फरात नदिया रे पच्छमी प्रदेशो दे रओए ताखे शुभ कामना पेजोए, <verse eid="EZR 4:11" /><verse number="12" style="v" sid="EZR 4:12" />राजे खे ये पता ओ कि जो यहूदी तांगा गे ते चली गे, सेयो आसा गे यरूशलेम शईरो दे पऊँची रे। सेयो तेस दंगेबाज ओर घिनौने शईरो खे बसाणे लगी रे; बल्कि तेतेरी दवाल खड़ी करी चुके रे ओर तिजी री निऊँआ री मरम्मत करने लगी रे। <verse eid="EZR 4:12" /><verse number="13" style="v" sid="EZR 4:13" />एबे राजे खे पता ओ कि जे से शईर बसी गा ओर तेतेरी दवाल बणीगी, तेबे तो तिना लोका कर देणा बन्द करी देणा ओर बादो ते राजे रा नुकशाण ऊणा। <verse eid="EZR 4:13" /><verse number="14" style="v" sid="EZR 4:14" />आसे लोक तो राजमईलो रा लूण खाऊँए ओर ये ठीक नि ए कि आसा सामणे राजे री बेजती ओ, इजी बजा ते आसे ये चिट्ठी लिखी की आसे एतेरे बारे दे राजे खे बताई देऊँए। <verse eid="EZR 4:14" /><verse number="15" style="v" sid="EZR 4:15" />तेरे बुजुर्गा रे इतिआसो री कताबा दे टोल़ेया जाओ; तेबे ताखे इतिआसो री कताबा दे पता लगी जाणा कि से शईर बगावत करने वाल़े ओर राजेया री ओर राज्य रा नुकशाण करने वाल़ा ए ओर पुराणे बखतो ते तिदे बगावत ऊँदी आई री। इजी बजा ते तेस शईरो रा नाश बी कित्तेया था। <verse eid="EZR 4:15" /><verse number="16" style="v" sid="EZR 4:16" />आसे राजे खे निश्चा कराई देऊँए कि जे से शईर बसी गा ओर तेतेरी दवाल बणी चुको, तेबे इजी बजा ते फरात नदिया ते पार पच्छमा दे तेरा कोई कब्जा नि रणा।”<verse eid="EZR 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 4:17" />तेबे अर्तक्षत्र राजे रहूम राजमंत्री ओर शिमशै मंत्री ओर सामरिया ओर फरात नदिया ते पार पच्छमा दे रणे वाल़े तिना रा साथ देणे वाल़ेया खे ये ज्वाब पेजेया, “ठीक, ओ! <verse eid="EZR 4:17" /><verse number="18" style="v" sid="EZR 4:18" />जो चिट्ठी तुसे लोके मांगे पेजी से मां सामणे पढ़ी की अनुवाद करी की मांगे सुणाई राखी। <verse eid="EZR 4:18" /><verse number="19" style="v" sid="EZR 4:19" />ओर मेरी आज्ञा ते टोल़ने ते पता लगेया कि से शईर पुराणे बखतो ते राजेया रे खलाफ सिर चकदा आई रा ओर तिदे दंगा ओर बगावत ऊँदी आई री। <verse eid="EZR 4:19" /><verse number="20" style="v" sid="EZR 4:20" />यरूशलेम शईरो दे सामर्थी राजा बी ऊए जो फरात नदिया ते पार पच्छमा दे सारे देशो पाँदे राज करो थे ओर सबी तरआ रे कर तिना खे देयो थे। <verse eid="EZR 4:20" /><verse number="21" style="v" sid="EZR 4:21" />इजी री खातर एबे एसा आज्ञा रा प्रचार करो, ताकि सेयो माणूं रोके जाओ ओर जदुओ तक मेरी तरफा ते आज्ञा नि मिलो, तदुओ तक से शईर नि बणना चाईयो। <verse eid="EZR 4:21" /><verse number="22" style="v" sid="EZR 4:22" />ओर चौकस रओ कि एते गल्ला दे सुस्त नि ऊणा; राज्य रा नुकशाण करने वाल़ी से बुराई कऊँ बढ़ो?”<verse eid="EZR 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 4:23" />जेबे राजा अर्तक्षत्रो री ये चिट्ठी रहूम ओर शिमशै मंत्री ओर तिना रे साथिया खे पढ़ी कि सुणाई, तेबे सेयो फटाफट यरूशलेम शईरो खे यहूदिया गे गये ओर आपणी तागत ओर जबरदस्ती सेयो रोकी ते। <verse eid="EZR 4:23" /><verse number="24" style="v" sid="EZR 4:24" />तेबे परमेशरो रे मन्दरो रा काम जो यरूशलेम शईरो दे ए, रूकी गा ओर फारसो रे राजा दारा रे राज्य रे दूजे सालो तक रूकेया रा रया।<verse eid="EZR 4:24" /></para>
  <chapter eid="EZR 4" />
  <chapter number="5" style="c" sid="EZR 5" />
  <para style="s">मन्दरो रा काम दुबारा शुरू ऊणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 5:1" />एक दिन हाग्गै नाओं रा नबी ओर इद्दो रा पोता जकर्याह नबी यहूदा ओर यरूशलेम शईरो रे यहूदी लोका साथे भविष्यबाणी करने लगे, सेयो इस्राएलो रे परमेशरो रे नाओं ते तिना साथे भविष्यबाणी करी की ईम्मत देणे लगे। <verse eid="EZR 5:1" /><verse number="2" style="v" sid="EZR 5:2" />तेबे शालतीएलो रा पाऊ जरूब्बाबेल ओर योसादाको रा पाऊ येशुअ, लक बानी की परमेशरो रे मन्दरो खे जो यरूशलेम शईरो दे ए बनाणे लगे ओर परमेशरो रे सेयो नबी तिना रा साथ देणे लगे। <verse eid="EZR 5:2" /><verse number="3" style="v" sid="EZR 5:3" />तेस बखते फरात नदिया रे पच्छमी इलाके रा तत्तनै नाओं रा परदान था। तत्तनै ओर शतर्बोजनै आपणे साथिया साथे तिना गे जाई की पूछणे लगे, “तुसा खे एस मन्दरो खे बनाणे ओर एतेरी दवाला खे खड़ी करने री आज्ञा किने दित्ती?” <verse eid="EZR 5:3" /><verse number="4" style="v" sid="EZR 5:4" />तेबे तिने लोका खे ये बी बोलेया, “एस मन्दरो खे बनाणे वाल़ेया रे क्या नाओं ए?” <verse eid="EZR 5:4" /><verse number="5" style="v" sid="EZR 5:5" />पर यहूदिया रे बुजुर्गा रे परमेशरो री नजर तिना पाँदे रई, इजी री खातर जदुओ तक एसा गल्ला री चर्चा दारा राजे गे नि कित्ती ओर इजी रे बारे दे चिट्ठिया रे जरीये ज्वाब नि मिलेया, तदुओ तक काम करने वाल़ेया काम करना नि रोकेया।<verse eid="EZR 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 5:6" />जो चिट्ठी फरात नदिया ते पार पच्छमा रे इलाके रे परदान तत्तनै ओर शतर्बोजनै ओर फरात नदिया ते पारले संगी-साथिये फारसो रे राजा दारा गे पेजी तेतेरी नकल ये ए; <verse eid="EZR 5:6" /><verse number="7" style="v" sid="EZR 5:7" />तिने तेसखे एक चिट्ठी लिखी, जिदे ये लिखी राखेया था: “राजा दारे खे हर प्रकारा ते शान्ति मिलो।” <verse eid="EZR 5:7" /><verse number="8" style="v" sid="EZR 5:8" />राजे खे पता ए कि आसे लोक यहूदा नाओं रे राज्य रे महान परमेशरो रे मन्दरो गे गये थे, से बड़े-बड़े पात्थरा साथे बणने लगी रा ओर तेतेरे पीता रे कड़िया जुड़ने लगी रिया ओर ये काम सेयो लोक फटाफट करने लगी रे ओर सफल बी ऊणे लगी रे। <verse eid="EZR 5:8" /><verse number="9" style="v" sid="EZR 5:9" />तेबे आसे तिना बुजुर्गा ते पूछेया, “एस मन्दरो खे बनाणे ओर एतेरी दवाल खड़ी करने री आज्ञा तुसा खे किने दित्ती?” <verse eid="EZR 5:9" /><verse number="10" style="v" sid="EZR 5:10" />ओर आसे तिना रे नाओं बी पूछे, ताकि आसे तिना चूणे दे मर्दा रे नाओं लिखी की तांगे बताई सकिए। <verse eid="EZR 5:10" /><verse number="11" style="v" sid="EZR 5:11" />तेबे तिने आसा खे ज्वाब दित्तेया, “आसे तो सर्ग ओर तरतिया रे परमेशरो रे दास ए ओर जो मन्दर बऊत साल पईले इस्राएली लोका रे एक बड़े राजे बणवाई की त्यार कित्तेया था, आसे तिजी खे ई बनाणे लगी रे। <verse eid="EZR 5:11" /><verse number="12" style="v" sid="EZR 5:12" />जेबे म्हारे बुजुर्गे स्वर्गो रे परमेशरो री आज्ञा नि मानी, तेबे तिने सेयो बाबेलो रे कसदी राजा नबूकदनेस्सरो रे आथो दे करीते थे ओर तिने ये मन्दर नाश करी ता ओर लोका खे बानी की बाबेलो खे लईगा।” <verse eid="EZR 5:12" /><verse number="13" style="v" sid="EZR 5:13" />पर बेबीलोनो रे राजा कुस्रूए आपणे पईले सालो देई एस मन्दरो खे बनाणे री आज्ञा दित्ती। <verse eid="EZR 5:13" /><verse number="14" style="v" sid="EZR 5:14" />परमेशरो रे मन्दरो दे जो सूईने ओर चाँदिए रे पांडे नबूकदनेस्सर राजा यरूशलेम शईरो रे मन्दरो ते निकयाल़ी की बाबेलो रे मन्दरो खे लईगा था, सेयो कुस्रू राजे बाबेलो रे मन्दरो ते निकयाल़ी की शेशबस्सर नाओं रे एक माणूंए गे जो तिने परदान ठराईता था, सम्बाल़ीते।<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">एज्रा 1:7-8 </char></note> <verse eid="EZR 5:14" /><verse number="15" style="v" sid="EZR 5:15" />तेबे तिने तेसखे बोलेया, “इना पांडेया खे लई जाई की यरूशलेम शईरो रे मन्दरो दे राख ओर परमेशरो रा मन्दर आपणी जगा देई बणाया जाओ।” <verse eid="EZR 5:15" /><verse number="16" style="v" sid="EZR 5:16" />तेबे तिने शेशबस्सरे आई की परमेशरो रे मन्दरो री जो यरूशलेम शईरो दे ए निऊँ पाई ओर तदुओ ते यबुओ तक ये बणने लगी रा, पर यबुओ तक नि बणेया। <verse eid="EZR 5:16" /><verse number="17" style="v" sid="EZR 5:17" />एबे जे राजे खे ठीक लगो तो बाबेलो रे राजपण्डारो दे एते गल्ला खे टोल़ो कि फारसो कुस्रू राजे सच्चो खे ई परमेशरो रे मन्दरो खे, जो यरूशलेम शईरो दे ए, बनाणे री आज्ञा दित्ती थी, या नि। तेबे राजा एतेरे बारे दे आपणी इच्छा आसा गे बताओ।<verse eid="EZR 5:17" /></para>
  <chapter eid="EZR 5" />
  <chapter number="6" style="c" sid="EZR 6" />
  <para style="s">दारा राजे रा उक्कम</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 6:1" />तेबे दारा राजे री आज्ञा ते बाबेलो दे जेती पुराणे दस्तावेज सम्बाल़ी की राखी राखो थे ओर जेती खजाना बी रओ था, टोल़ कित्ती। <verse eid="EZR 6:1" /><verse number="2" style="v" sid="EZR 6:2" />तेबे मादे नाओं रे राज्य रे एकबतना शईरो रे राजगढ़ो दे एक कताब मिली, जिदे ये लिखी राखेया था, <verse eid="EZR 6:2" /><verse number="3" style="v" sid="EZR 6:3" />“फारसो रे राजा कुस्रूए रे पईले सालो दे तिने कुस्रू राजे ई ये आज्ञा दित्ती कि परमेशरो रे मन्दरो रे बारे दे जो यरूशलेम शईरो रे ए, मतलब से मन्दर जिदे बलिदान करो थे, तेतेखे बणाओ ओर तिजी री निऊँ मजबूत बनाणी, तेतेरी ऊचाई ओर चौड़ाई साठ-साठ आथो री ओ; <verse eid="EZR 6:3" /><verse number="4" style="v" sid="EZR 6:4" />तिदे तीन रद्दे पारी-पारी पात्थरा रे ओ ओर एक परत नवींया लकड़िया री ओ ओर इना री कीमत राजमईलो ते देणी।”<verse eid="EZR 6:4" /></para>
  <para style="s">परमेशरो रे मन्दरो खे फेर बनाणे रा उक्कम</para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 6:5" />परमेशरो रे मन्दरो दे जो सूईने ओर चाँदिए रे पांडे नबूकदनेस्सर राजे यरूशलेम शईरो रे मन्दरो ते निकल़वाई की बाबेलो खे पऊँचाए थे से वापस करी की यरूशलेम शईरो रे मन्दरो दे आपणी-आपणी जगा पाँदे पऊँचाओ ओर तैं सेयो परमेशरो रे मन्दरो दे राखी देणे।<verse eid="EZR 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 6:6" />फेर दारा राजे आपणे कर्मचारिया खे ये उक्कम दित्तेया, “एबे ओ फरात नदिया रिया पच्छमा रिया जगा रे परदान तत्तनै! ओ शतर्बोजनै! तुसे आपू साथे काम करने वाल़ेया लोका समेत ओर फरात नदिया रिया पच्छमा रिया जगा दे फारसिया समेत यहूदी लोका ते दूर रओ; <verse eid="EZR 6:6" /><verse number="7" style="v" sid="EZR 6:7" />परमेशरो रे मन्दरो रे तेस कामो खे नि रोको; यहूदिया रे परदान ओर यहूदिया रे बुजुर्गा खे परमेशरो रे तेस मन्दरो खे तेसरी जगा देई बनाणे देयो। <verse eid="EZR 6:7" /><verse number="8" style="v" sid="EZR 6:8" />बल्कि आऊँ उक्कम देऊँआ कि तुसा खे यहूदिया रे तिना बुजुर्गा साथे एड़ा बर्ताव करना कि परमेशरो रा से मन्दर बणाया जाओ; मतलब राजे रे तअनो बीचा ते, फरात नदिया रे पारले करो बीचा ते, तिना लोका खे फटाफट खर्चा देणा; एड़ा नि ओ कि तिना खे रूकणा पड़ो। <verse eid="EZR 6:8" /><verse number="9" style="v" sid="EZR 6:9" />तेबे क्या खाडू, क्या बाच्छू, क्या मिन्टू, स्वर्गो रे परमेशरो री होमबलिया खे जेते-जेते चीजा री तिना खे जरूरत ओ ओर जितणी कणक, लूण, शराब ओर तेल यरूशलेम शईरो रे पुरोईत बोलो, से सब तिना खे बिना पूल-चूका ते हर रोज दित्तेया जाओ, <verse eid="EZR 6:9" /><verse number="10" style="v" sid="EZR 6:10" />ताकि सेयो स्वर्गो रे परमेशरो खे सुख देणे वाल़ा खुशबूदार बलि चढ़ाई की, राजा ओर राजकुमारा खे लाम्बी उम्रा री प्रार्थना करेया करो।”<verse eid="EZR 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 6:11" />आऊँ राजा ऊणे रिया बजा ते ये आज्ञा देऊँआ, “जो कोई बी माणूं एसा आज्ञा खे टाल़ोगा, तेसरे कअरो री कअड़ी निकयाल़ी देणी ओर तेते पाँदे से आपू चढ़ाई की जकड़ी देणा ओर तेसरा कअर एस अपराधो रिया बजा ते पूरी तरआ ते नाश करी देणा। <verse eid="EZR 6:11" /><verse number="12" style="v" sid="EZR 6:12" />परमेशर जिने तेती आपणे रणे री जगा ठराई राखी, से क्या राजा, क्या प्रजा, तिना सबी खे जो एसा आज्ञा खे टाल़ो ओर परमेशरो रे मन्दरो खे जो यरूशलेम शईरो रे ए नाश करने खे आथ चको से तेसखे नाश करो। मैं दारे ये आज्ञा देई राखी फटाफट एड़ा ई करना।”<verse eid="EZR 6:12" /></para>
  <para style="s">मन्दरो रा काम पूरा ऊणा</para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 6:13" />तेबे फरात नदिया रे पच्छमी प्रदेशो रे परदान तत्तनै ओर शतर्बोजनै ओर तिना रे साथिये राजा दारे रा चिट्ठी पेजणे रिया बजा ते, तेसरे ई मुताबिक फटाफट काम कित्तेया। <verse eid="EZR 6:13" /><verse number="14" style="v" sid="EZR 6:14" />तेबे यहूदी बुजुर्ग लोक, हाग्गै नबी ओर इद्दो रे पाऊ जकर्याह नबीए री भविष्यबाणी करने रे मुताबिक परमेशरो रा मन्दर बनाणे दे सफल ऊए ओर तिने इस्राएलो रे परमेशरो री आज्ञा रे मुताबिक ओर फारसो रे राजा कुस्रू, दारा ओर अर्तक्षत्रो री आज्ञा रे मुताबिक बणांदे-बणांदे से पूरा कित्तेया। <verse eid="EZR 6:14" /><verse number="15" style="v" sid="EZR 6:15" />ईंयाँ से मन्दर राजा दारा रे राज्य रे छठुए साले अदार मीन्ने रे तीजे दिने बणी की पूरा ऊआ।<verse eid="EZR 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 6:16" />इजी ते बाद इस्राएली लोक, मतलब पुरोईत, लेविये ओर जितणे गुलामिया ते आए थे तिने तेस मन्दरो री प्रतिष्ठा बड़ी खुशिया साथे कित्ती। <verse eid="EZR 6:16" /><verse number="17" style="v" sid="EZR 6:17" />तेस मन्दरो री प्रतिष्ठा रे तिने 100 बल़द ओर 200 खाडू ओर 400 मिन्टू पेंट करी की चढ़ाए। तेबे सबी इस्राएली लोका रिया तँईं पापबलि करी की इस्राएलो रे गोत्रा री गिणतिया रे मुताबिक बारा बाकरे चढ़ाए। <verse eid="EZR 6:17" /><verse number="18" style="v" sid="EZR 6:18" />तेबे जेड़ा मूसे रे बिधानो री कताबा दे लिखी राखेया, तेड़ा ई तिने परमेशरो री आराधना खे जो यरूशलेम शईरो रे ए, बारी-बारी करी की पुरोईत ओर दल-दल करी की लेवी नियुक्त करीते।<verse eid="EZR 6:18" /></para>
  <para style="s">फसह रा त्यार मनाणा</para>
  <para style="p">
    <verse number="19" style="v" sid="EZR 6:19" />तेबे यहूदी सालो रे पईले मीन्ने रे चौदुए दिने गुलामिया ते आए रे लोके फसह मनाया। <verse eid="EZR 6:19" /><verse number="20" style="v" sid="EZR 6:20" />कऊँकि पुरोईते ओर लेविये एक मन ऊई की, आपू-आपू खे शुद्ध कित्तेया था; इजी री खातर सेयो सब के सब शुद्ध थे ओर तिने गुलामिया रे आए रे सबी लोका खे आपणे पुरोईत पाईया खे ओर आपू-आपू खे फसह रे डांगर बलि कित्ते। <verse eid="EZR 6:20" /><verse number="21" style="v" sid="EZR 6:21" />तेबे गुलामिया ते वापस आए रे इस्राएली लोक ओर जितणे ओर दूजी जातिया री अशुद्धता ते इजी खे लग ऊए थे कि इस्राएलो रे परमेशर यहोवे पीछे चलो, तिने सबी फसह री रोटी खाई। <verse eid="EZR 6:21" /><verse number="22" style="v" sid="EZR 6:22" />तेबे सेयो बिना सजेड़े री रोटिया रा त्योआर सात दिन तक खुशिया साथे मनांदे रये; कऊँकि यहोवे सेयो खुश कित्ते थे ओर अश्शूरो रे राजे रा मन तिना रिया तरफा खे एड़ा फेरेया कि से परमेशर, मतलब इस्राएलो रे परमेशरो रा मन्दर बनाणे खे तिना री मताद करो।<verse eid="EZR 6:22" /></para>
  <chapter eid="EZR 6" />
  <chapter number="7" style="c" sid="EZR 7" />
  <para style="s">एज्रा रा यरूशलेम शईरो खे पेजेया जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 7:1" />ये सब ऊणे ते बऊत साल बाद मतलब फारसो रे राजा अर्तक्षत्रो रे दिना रे, एज्रा नाओं रा एक यहूदी माणूं बाबेलो ते यरूशलेम शईरो खे गया। से सरायाह रा पाऊ था ओर सरायाह अजर्याह रा पाऊ था, अजर्याह हिल्किय्याह रा, <verse eid="EZR 7:1" /><verse number="2" style="v" sid="EZR 7:2" />हिल्किय्याह शल्लूमो रा, शल्लूम सादोको रा, सादोक <verse eid="EZR 7:2" /><verse number="3" style="v" sid="EZR 7:3" />अहीतूबो रा, अहीतूब अमर्याह रा, अमर्याह अजर्याह रा, अजर्याह मरायोतो रा पाऊ था, <verse eid="EZR 7:3" /><verse number="4" style="v" sid="EZR 7:4" />मरायोत जरहयाह रा, जरहयाह उज्जीए रा, उज्जी बुक्कीए रा, <verse eid="EZR 7:4" /><verse number="5" style="v" sid="EZR 7:5" />बुक्की अबीशूए रा, अबीशू पीनहासो रा, पीनहास एलीआजारो रा ओर एलीआजार हारूणो रा पाऊ था जो बड़ा पुरोईत था। <verse eid="EZR 7:5" /><verse number="6" style="v" sid="EZR 7:6" />येई एज्रा मूसे री बिधान रे बारे दे, जो इस्राएलो रे यहोवा परमेशरे दित्ती थी, निपुण शास्त्री था ओर तेसरे यहोवा परमेशरो री दया जो तेस पाँदे रई, इजी बजा ते राजे तेसखे मूँ मांगेया वर दित्तेया। <verse eid="EZR 7:6" /><verse number="7" style="v" sid="EZR 7:7" />तेबे तेसखे कई इस्राएली ओर पुरोईत, लेवी, गाणे वाल़े ओर द्वारपाल ओर मन्दरो रे सेवका बीचा ते कुछ लोक अर्तक्षत्र राजे रे सातुए साले यरूशलेम शईरो खे लईगे। <verse eid="EZR 7:7" /><verse number="8" style="v" sid="EZR 7:8" />एज्रा राजे रे सातुए सालो रे पाँजुए मीन्ने दे यरूशलेम पऊँचेया। <verse eid="EZR 7:8" /><verse number="9" style="v" sid="EZR 7:9" />पईले मीन्ने रे पईले दिने से बाबेलो ते चलेया ओर तेसरे परमेशरो री दया-दृष्टि तेस पाँदे रई, इजी बजा ते पाँजुए मीन्ने रे पईले दिने से यरूशलेम पऊँचेया। <verse eid="EZR 7:9" /><verse number="10" style="v" sid="EZR 7:10" />कऊँकि एज्रे यहोवे रे बिधान रा मतलब सिखणे ओर तिजी खे मानणे ओर इस्राएलो रे बिधि ओर नियम सिखाणे खे आपणा मन लगाया था।<verse eid="EZR 7:10" /></para>
  <para style="s">राजा अर्तक्षत्रो री चिट्ठी</para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 7:11" />जो चिट्ठी अर्तक्षत्र राजे एज्रा खे जो पुरोईत ओर बिधानो खे सिखाणे वाल़ा था दित्ती, इस्राएलो खे यहोवे जो आज्ञा ओर बिधिया दित्तिया तिना रे बारे दे एज्रा अच्छी तरआ ते जाणो था, ये तेते चिट्ठिया री नकल ये ए, <verse eid="EZR 7:11" /><verse number="12" style="v" sid="EZR 7:12" />एज्रा पुरोईतो रे नाओं जो स्वर्गो रे परमेशरो रा पूरा शास्त्र जाणने वाल़ा ए, तेसखे अर्तक्षत्र महाराजाधिराजो रिया तरफा ते। <verse eid="EZR 7:12" /><verse number="13" style="v" sid="EZR 7:13" />आऊँ ये आज्ञा देऊँआ कि मेरे राज्य दे जितणे इस्राएली ओर तिना रे पुरोईत ओर लेवी लोक आपणी इच्छा ते यरूशलेम शईरो खे जाणा चाओ, सेयो तां साथे जाई सकोए। <verse eid="EZR 7:13" /><verse number="14" style="v" sid="EZR 7:14" />तूँ तो राजा ओर तेसरे सातो सलाहकारा रिया तरफा ते इजी खे पेजेया, ताकि आपणे परमेशरो रे बिधानो रे बारे दे जो तांगे ए, यहूदा ओर यरूशलेम शईरो री दशा जाणी लो, <verse eid="EZR 7:14" /><verse number="15" style="v" sid="EZR 7:15" />ओर जो सूईना-चाँदी, राजा ओर तेसरे सलाहकारे इस्राएलो रे परमेशरो खे जेसरी रणे री जगा यरूशलेम शईरो दे ए, आपणी इच्छा ते देई राखेया, <verse eid="EZR 7:15" /><verse number="16" style="v" sid="EZR 7:16" />ओर जितणा सूईना-चाँदी सारे बाबेल राज्य ते ताखे मिलणा ओर जो कुछ लोक ओर इस्राएलो रे पुरोईत आपणी इच्छा ते आपणे परमेशरो रे मन्दरो खे जो यरूशलेम शईरो दे देओगे, तिजी खे लई जा। <verse eid="EZR 7:16" /><verse number="17" style="v" sid="EZR 7:17" />ओर एते तअनो ते फटाफट बल़द, खाडू ओर मिन्टू खरीद ओर तिना रे साथो खे जितणा नज्ज ओर तेल चाईयो बलि करने खे सब खरीद। तेबे इना सबी चीजा खे लई जाई की यरूशलेम शईरो दे परमेशरो रे मन्दरो दे चढ़ाई दे। <verse eid="EZR 7:17" /><verse number="18" style="v" sid="EZR 7:18" />ओर जो चाँदी-सूईना बची जाओगा, तेते बीचा ते जो कुछ ताखे ओर तेरे पाईया खे ठीक लगो, सेई आपणे परमेशरो री इच्छा रे मुताबिक करना। <verse eid="EZR 7:18" /><verse number="19" style="v" sid="EZR 7:19" />तेरे परमेशरो री आराधना करने खे जो पांडे तांगे सम्बाल़े जाओए, सेयो यरूशलेम शईरो दे परमेशरो रे मन्दरो दे राखी देणे। <verse eid="EZR 7:19" /><verse number="20" style="v" sid="EZR 7:20" />इना ते अलावा जो कुछ ताखे आपणे परमेशरो रे मन्दरो खे जरूरत लगो, से राज खजाने ते लई लणा। <verse eid="EZR 7:20" /><verse number="21" style="v" sid="EZR 7:21" />आऊँ अर्तक्षत्र राजा ये आज्ञा देऊँआ कि तुसे सब लोक जो फरात नदिया री पच्छमा दे राजे रे खजांची ए, तिना खे आज्ञा देऊँआ कि एज्रा पुरोईत, जो स्वर्गो रे परमेशरो रे बिधानो रा शास्त्री ए, तुसा लोका ते जो कुछ माँगो, से तेसखे देणा। <verse eid="EZR 7:21" /><verse number="22" style="v" sid="EZR 7:22" />मतलब 3,400 किलो चाँदी, 10,000 किलो कणक, 2,000 लीटर तक अंगूरा रा रस, 2,000 लीटर जैतूनो रा तेल ओर जितणा लूण चाईयो तितणा देणा। <verse eid="EZR 7:22" /><verse number="23" style="v" sid="EZR 7:23" />जो-जो आज्ञा स्वर्गो रे परमेशरो रिया तरफा ते मिलो, ठीक तिजी रेई मुताबिक स्वर्गो रे परमेशरो रे मन्दरो खे करेया जाओ, राजा ओर राजकुमारा पाँदे ओर राज्य पाँदे परमेशरो रा रोष नि पड़कणा चाईयो। <verse eid="EZR 7:23" /><verse number="24" style="v" sid="EZR 7:24" />तेबे आऊँ तुसा खे बताई देऊँआ कि परमेशरो रे तेस मन्दरो रे केसी पुरोईत, लेविये, गाणे वाल़े, द्वारपाल, मन्दरो दे सेवा करने वाल़े या ओर केसी सेवको ते कर या जमीना रा कर लणे री आज्ञा नि ए।<verse eid="EZR 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZR 7:25" />तेबे ओ एज्रा! तेरे परमेशरे जो बुद्धि ताखे देई राखी तिजी रे ई मुताबिक न्यायी ओर बिचार करने वाल़े नियुक्त कर जो फरात नदिया रिया पच्छमा रिया जगा दे रणे वाल़े तिना सबी लोका बीचा ते जो तेरे परमेशरो रे बिधानो खे जाणोए, न्याय करेया करो ओर जो तिना खे नि जाणदे ओ, तिना खे तुसे सिखाया करो। <verse eid="EZR 7:25" /><verse number="26" style="v" sid="EZR 7:26" />जो कोई तेरे परमेशरो रे बिधान ओर राजे रे बिधानो खे नि मानोगा, तेसखे सख्त ते सख्त सजा देणी, चाए मौती री सजा, चाए देश निकाल़ा, चाए तेसरी सारी तअन-दौलत लणा, चाए कैद करना।<verse eid="EZR 7:26" /></para>
  <para style="s">एज्रा रे जरिये परमेशरो री स्तुति करना</para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 7:27" />तेबे एज्रे बोलेया, “तन्य ए म्हारे पितरा रा यहोवा परमेशर, जिने एड़ी इच्छा राजे रे मनो दे पैदा कित्ती कि यरूशलेम शईरो दे यहोवे रे मन्दरो री मरम्मत कराओ, <verse eid="EZR 7:27" /><verse number="28" style="v" sid="EZR 7:28" />ओर मां पाँदे राजा ओर तेसरे सलाहकार ओर राजे रे सब बड़े परदान दयालु कित्ते, मेरे परमेशर यहोवे री दया-दृष्टि, जो मां पाँदे ए, इजी रे मुताबिक मैं ईम्मत कित्ती ओर इस्राएलो बीचा ते खास लोक कट्ठे कित्ते, ताकि सेयो मां साथे चलो।”<verse eid="EZR 7:28" /></para>
  <chapter eid="EZR 7" />
  <chapter number="8" style="c" sid="EZR 8" />
  <para style="s">एज्रा रा साथिया समेत यरूशलेम शईरो दे पऊँचणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 8:1" />तिना रे बुजुर्गा रे कराने रे बड़े-बड़े मर्द यो ए ओर जो लोक राजा अर्तक्षत्रो रे राज्य रे बाबेलो ते मां साथे यरूशलेम शईरो खे गये तिना री वंशावली ये ए: <verse eid="EZR 8:1" /><verse number="2" style="v" sid="EZR 8:2" />मतलब पीनहासो रे कुलो बीचा ते गेर्शोम, ईतामारो रे कुलो बीचा ते दानिय्येल, दाऊदो रे कुलो बीचा ते हत्तूश। <verse eid="EZR 8:2" /><verse number="3" style="v" sid="EZR 8:3" />शकन्याह रे कुलो रे परोशो रे गोत्रो बीचा ते जकर्याह, जेस साथे 150 मर्दा री वंशावली ऊई। <verse eid="EZR 8:3" /><verse number="4" style="v" sid="EZR 8:4" />पहत्मोआबो रे कुलो बीचा ते जरहयाह रा पाऊ एल्यहोएनै, जेस साथे 200 मर्द थे। <verse eid="EZR 8:4" /><verse number="5" style="v" sid="EZR 8:5" />शकन्याह रे कुलो बीचा ते यहजीएलो रा पाऊ, जेस साथे 300 मर्द थे। <verse eid="EZR 8:5" /><verse number="6" style="v" sid="EZR 8:6" />आदीनो रे कुलो बीचा ते योनातानो रा पाऊ एबेद, जेस साथे पंजा मर्द थे। <verse eid="EZR 8:6" /><verse number="7" style="v" sid="EZR 8:7" />एलामो रे कुलो बीचा ते अतल्याह रा पाऊ यशायाह, जेस साथे सत्तर मर्द थे। <verse eid="EZR 8:7" /><verse number="8" style="v" sid="EZR 8:8" />शपत्याह रे कुलो बीचा ते मीकाएलो रा पाऊ जबद्याह, जेस साथे अस्सी मर्द थे। <verse eid="EZR 8:8" /><verse number="9" style="v" sid="EZR 8:9" />योआबो रे कुलो बीचा ते यहीएलो रा पाऊ ओबद्याह, जेस साथे 218 मर्द थे। <verse eid="EZR 8:9" /><verse number="10" style="v" sid="EZR 8:10" />शलोमीतो रे कुलो बीचा ते योसिव्याह रा पाऊ, जेस साथे 160 मर्द थे। <verse eid="EZR 8:10" /><verse number="11" style="v" sid="EZR 8:11" />बेबै रे कुलो बीचा ते बेबैए रा पाऊ जकर्याह, जेस साथे ठाई मर्द थे। <verse eid="EZR 8:11" /><verse number="12" style="v" sid="EZR 8:12" />अजगादो रे कुलो बीचा ते हक्कातानो रा पाऊ योहानान, जेस साथे 110 मर्द थे। <verse eid="EZR 8:12" /><verse number="13" style="v" sid="EZR 8:13" />अदोनीकामो रे कुलो बीचा ते जो पीछे गये तिना रे यो नाओं ए: मतलब एलीपेलेत, यूएल ओर शमायाह ओर तिना साथे साठ मर्द थे। <verse eid="EZR 8:13" /><verse number="14" style="v" sid="EZR 8:14" />ओर बिगवै रे कुलो बीचा ते ऊतै ओर जक्कूर थे ओर इना साथे सत्तर मर्द थे।<verse eid="EZR 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZR 8:15" />तेबे मैं एज्रे यो तेसा नदिया गे जो अहवा रिया तरफा खे बह्ओई कट्ठे कित्ते ओर आसे तेती तीऊँ दिना तक डेरे लगाई की राखे ओर मैं तेती लोक ओर पुरोईत देखे पर कोई लेवी नि दिखेया। <verse eid="EZR 8:15" /><verse number="16" style="v" sid="EZR 8:16" />मैं एलीएजेर, अरीएल, शमायाह, एलनातान, यारीब, एलनातान, नातान, जकर्याह ओर मशुल्लाम जो खास मर्द थे ओर योयारीब ओर एलनातानो खे जो अक्लमंद थे <verse eid="EZR 8:16" /><verse number="17" style="v" sid="EZR 8:17" />बुलाई की, इद्दो गे जो कासिप्या नाओं री जगा रा परदान था, पेजी ते ओर इना खे समजयाई ता कि कासिप्या जगा रे इद्दो ओर तेसरे पाई मन्दरो दे सेवा करने वाल़े लोका खे क्या-क्या बोलणा, ताकि सेयो आसा गे म्हारे परमेशरो रे मन्दरो खे सेवा-टईल करने वाल़ेया खे ली आओ। <verse eid="EZR 8:17" /><verse number="18" style="v" sid="EZR 8:18" />म्हारे परमेशरो री दया-दृष्टि जो आसा पाँदे ऊई इजी रे मुताबिक आसा गे ईश्शेकेल, जो इस्राएलो रा पड़पोता ओर लेविये रा पोता महलीए रे कुलो बीचा ते था ओर शेरेब्याह जो एक अक्लमंद माणूं था तेसखे ओर तेसरे पाऊ ओर पाईया खे, मतलब ठारा जणेया खे; <verse eid="EZR 8:18" /><verse number="19" style="v" sid="EZR 8:19" />ओर हशब्याह खे ओर तेस साथे मरारीये रे कुलो बीचा ते यशायाह खे ओर तेसरे पाऊ ओर पाईया खे, मतलब बीइ जणेया खे; <verse eid="EZR 8:19" /><verse number="20" style="v" sid="EZR 8:20" />ओर तिना साथे मन्दरो दे 200 सेवादार बी पेजे। तिना रे बुजुर्ग सेयो लोक थे जो दाऊद ओर तेसरे बड़े अधिकारिए लेविया री मताद करने खे चूणी राखे थे। इना सबी रे नाओं लिखे रे थे।<verse eid="EZR 8:20" /></para>
  <para style="s">बअरत ओर प्रार्थना</para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 8:21" />तेबे मैं तेती, मतलब अहवा नदिया रे कनारे बअरतो रा प्रचार इजी रिया तँईं कराया, ताकि आसे परमेशरो सामणे दीन ओ ओर तेसते आपणे ओर आपणे बाल-बच्चे ओर आपणी सारी सम्पत्तिया रिया तँईं सीदी यात्रा मांगू। <verse eid="EZR 8:21" /><verse number="22" style="v" sid="EZR 8:22" />कऊँकि आऊँ बाटा रे दुश्मणा ते बचणे रिया खातर सिपाईया रा दल ओर सवार राजे ते माँगणे ते शर्माऊँ था, कऊँकि आसे राजे खे ये बोली चुके थे, “म्हारा परमेशर आपणे सबी टोल़ने वाल़ेया पाँदे, पलाई करने खे दया-दृष्टि राखोआ ओर जो तेसखे छाडी देओए, तेसरी तागत ओर कोप तिना रे खलाफ ए।” <verse eid="EZR 8:22" /><verse number="23" style="v" sid="EZR 8:23" />इजी बजा ते आसे बअरत करी की आपणे परमेशरो ते प्रार्थना कित्ती ओर तिने म्हारी सुणी। <verse eid="EZR 8:23" /><verse number="24" style="v" sid="EZR 8:24" />तेबे मैं पुरोईता रे मुखिया बीचा ते बारा मर्द, मतलब शेरेब्याह, हशब्याह ओर इना रे दस पाई लग करी की, जो सूईना, चाँदी ओर पांडे, <verse eid="EZR 8:24" /><verse number="25" style="v" sid="EZR 8:25" />राजे ओर तेसरे मंत्री ओर तेसरे परदाने ओर जितणे इस्राएली आजीर थे तिने म्हारे परमेशरो रे मन्दरो खे पेंट दित्ते थे, सेयो तोली की तिना खे दित्ते। <verse eid="EZR 8:25" /><verse number="26" style="v" sid="EZR 8:26" />मैं तिना रे आथो दे कोई पच्ची टन चाँदी, कोई 3,400 किलो चाँदिए रे पांडे, <verse eid="EZR 8:26" /><verse number="27" style="v" sid="EZR 8:27" />ह्जार सूईने रे सिक्केया री किमती वाल़े बीइ कटोरे ओर सूईने जेड़े कीमती शुद्ध चमकणे वाल़े पीतल़ी रे दो पांडे तोली की दित्ते। <verse eid="EZR 8:27" /><verse number="28" style="v" sid="EZR 8:28" />तेबे मैं तिना खे बोलेया, “तुसे तो यहोवे खे पवित्र ए ओर यो पांडे बी पवित्र ए ओर ये चाँदी ओर सूईना पेंटा राए, जो तुसा रे पितरा रे यहोवा परमेशरो खे खुशिया साथे देई राखे। <verse eid="EZR 8:28" /><verse number="29" style="v" sid="EZR 8:29" />इजी री खातर जागदे रओ ओर जदुओ तक तुसे इना खे यरूशलेम शईरो रे परदान पुरोईत, लेवी ओर इस्राएली लोका रे पितरा रे कराने रे परदाना सामणे यहोवे रे मन्दरो रे कमरे रे तोली की नि देओ, तदुओ तक इना री रक्षा करदे रओ।” <verse eid="EZR 8:29" /><verse number="30" style="v" sid="EZR 8:30" />तेबे पुरोईते ओर लेविये चाँदी, सूईना ओर पांडे तोली की लई ले, ताकि तिना खे यरूशलेम शईरो रे म्हारे परमेशरो रे मन्दरो रे पऊँचाओ।<verse eid="EZR 8:30" /></para>
  <para style="s">यरूशलेम शईरो रिया तरफा खे चलणा</para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 8:31" />पईले मीन्ने रे बारूए दिने आसे अहवा नदिया ते यरूशलेम शईरो खे चले ओर म्हारे परमेशरो री दया-दृष्टि आसा पाँदे रई ओर तिने आसे दुश्मणा ते ओर बाटा रे लूटेरेया ते बचाए। <verse eid="EZR 8:31" /><verse number="32" style="v" sid="EZR 8:32" />बादो ते आसे यरूशलेम शईरो दे पऊँचे ओर तेती तीऊँ दिना तक रये। <verse eid="EZR 8:32" /><verse number="33" style="v" sid="EZR 8:33" />तेबे चौथे दिने से चाँदी, सूईना ओर पांडे म्हारे परमेशरो रे मन्दरो दे ऊरिय्याह रे पाऊ मरेमोत पुरोईतो रे आथो दे तोली की दित्ते। तेस साथे पीनहासो रा पाऊ एलीआजार था ओर तिना साथे येशुअ रा पाऊ योजाबाद लेवी ओर बिन्नूईए रा पाऊ नोअद्याह लेवी थे। <verse eid="EZR 8:33" /><verse number="34" style="v" sid="EZR 8:34" />सेयो सब चीजा तोलिया ओर गिणिया ओर तिना रा बजन तेस बखते ई लिखी ता। <verse eid="EZR 8:34" /><verse number="35" style="v" sid="EZR 8:35" />जो गुलामिया ते आए थे, तिने इस्राएलो रे परमेशरो खे होमबलि चढ़ाए; मतलब सारे इस्राएली लोका रिया तँईं बारा बाच्छू, छयानुए खाडू ओर सतत्तर मिन्टू चढ़ाए ओर पापबलिया खे बारा बाकरे चढ़ाए; ये सब यहोवे खे होमबलि था। <verse eid="EZR 8:35" /><verse number="36" style="v" sid="EZR 8:36" />तेबे तिने राजे रिया आज्ञा फरात नदिया रे पच्छमा रिया जगा दे अधिकारिया ओर राज्यपाला खे दित्तिया ओर तिने इस्राएली लोका री ओर परमेशरो रे मन्दरो रे कामो दे मताद कित्ती।<verse eid="EZR 8:36" /></para>
  <chapter eid="EZR 8" />
  <chapter number="9" style="c" sid="EZR 9" />
  <para style="s">यहूदा रे पापो रिया बजा ते एज्रा री प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 9:1" />इना सबी कामा रे करने ते बाद परदान मांगे आई की बोलणे लगे, “ना तो इस्राएली लोक, ना पुरोईत, ना लेवी एस कनारले देशो रे लोका ते लग ऊए; बल्कि तिना जेड़े, मतलब कनानी, हित्ती, परिज्जी, यबूसी, अम्मोनी, मोआबी, मिस्री ओर एमोरिया जेड़े घिनौने काम करदे रये। <verse eid="EZR 9:1" /><verse number="2" style="v" sid="EZR 9:2" />ओर तिने तिना री बेटिया साथे आपणा ओर आपणे पाऊआ रा ब्या करी ता रा ओर पवित्र कुल एस कनारले देशो रे लोका साथे मिली गा रा, बल्कि परदान ओर सरदार लोक ई एस तोखे रे कामो खे करने खे आगे आई रे।” <verse eid="EZR 9:2" /><verse number="3" style="v" sid="EZR 9:3" />जिंयाँ ई ये गल्ल सुणी मैं आपणा चोगा ओर टाल्ले फाड़े ओर आपणे सिरो रे ओर दाढ़िया रे बाल़ पट्टे ओर बऊत जादा दु:खी ऊई की बैठेया रा रया।<note caller="+" style="f"><char style="fr" closed="false">9:3 </char><char style="ft" closed="false">मत्ती 26:65, अय्यू. 1:20</char></note> <verse eid="EZR 9:3" /><verse number="4" style="v" sid="EZR 9:4" />तेबे जितणे लोक इस्राएलो रे परमेशरो रा वचन सुणी की गुलामिया ते आए रे लोका रे विश्वासघातो रिया बजा ते डरो थे, सारे मांगे कट्ठे ऊए ओर आऊँ साँजा रिया पेंटा तक शर्मिंदा ऊई की बैठेया रा रया। <verse eid="EZR 9:4" /><verse number="5" style="v" sid="EZR 9:5" />पर साँजकी पेंटा रे बखते आऊँ फटे दे टाल्ले ओर चोगे साथ बअरत करी की उठेया, तेबे आऊँ जानूआ रे पारे चुकेया ओर आपणे आथ आपणे परमेशर यहोवे रिया तरफा खे फैलाई की बोलेया, <verse eid="EZR 9:5" /><verse number="6" style="v" sid="EZR 9:6" />“ओ मेरे परमेशर! माखे आपणा मूँ तां सामणे चकदे ऊए शर्म आऊणे लगी री, ओर ओ मेरे परमेशर! मेरा मूँ काल़ा ए; कऊँकि आसा लोका रे पापो रे काम आसा रे सिरो पाँदे बढ़ीगे रे ओर म्हारा दोष बढ़दे-बढ़दे सर्गो तक पऊँची गा रा।<note caller="+" style="f"><char style="fr" closed="false">9:6 </char><char style="ft" closed="false">दानि. 9:7,8</char></note> <verse eid="EZR 9:6" /><verse number="7" style="v" sid="EZR 9:7" />आपणे बुजुर्गा रे दिना ते लई की आजके दिन तक आसे बड़े दोषी ए ओर आपणे पापो रे कामो रिया बजा ते आसे आपणे राजेया ओर पुरोईता समेत देशो-देशो रे राजेया रे आथो रे कित्ते, ताकि तलवार, गुलामी, लुटणे ओर मूँ काल़ा ऊणे रिया मुसीबता रे पड़ूँ, जेड़ी की आज म्हारी दशा ए। <verse eid="EZR 9:7" /><verse number="8" style="v" sid="EZR 9:8" />एबे थोड़े दिना ते म्हारे परमेशर यहोवे री दया आसा पाँदे ऊई री, ताकि आसा बीचा ते कोई-कोई बची की निकल़ो ओर आसा खे तेसरी पवित्र जगा दे पैर राखणे खे जगा मिलो ओर म्हारा परमेशर म्हारी आखी दे जोति आऊणे देयो ओर गुलामिया ते आसा खे थोड़ा राम मिलो। <verse eid="EZR 9:8" /><verse number="9" style="v" sid="EZR 9:9" />आसे दास तो आए ई, पर म्हारी गुलामिया दे बी म्हारे परमेशरे आसे नि छाडे, बल्कि फारसो रे राजे आसा पाँदे एड़े दयावान कित्ते, ताकि आसा खे नवीं जिन्दगी मिलो ओर आसे आपणे परमेशरो रे मन्दरो खे बनाई ओर सुदारी सकिये ओर आसा खे यहूदा ओर यरूशलेम शईरो दे सुरक्षा मिलो।” <verse eid="EZR 9:9" /><verse number="10" style="v" sid="EZR 9:10" />एबे ओ म्हारे परमेशर इजी ते बाद आसे क्या बोलूँ, येई कि आसे तेरिया सेयो आज्ञा तोड़ी ती रिया,<note caller="+" style="f"><char style="fr" closed="false">9:10 </char><char style="ft" closed="false">दानि. 9:5,10,11</char></note> <verse eid="EZR 9:10" /><verse number="11" style="v" sid="EZR 9:11" />जो तैं ये बोली की आपणे नबी दासो रे जरीये दित्ती, “जेस देशो रे अधिकारी ऊणे खे तुसे जाणे वाल़े ए, से तो देश-देशो रे लोका री अशुद्धता रिया बजा ते ओर तिना रे बुरे कामो रिया बजा ते अशुद्ध देश ए, तिने से एक बन्ने ते दूजे बन्ने तक आपणी अशुद्धता साथे परी ता रा। <verse eid="EZR 9:11" /><verse number="12" style="v" sid="EZR 9:12" />इजी री खातर तैं ना तो आपणी बेटिया रा ब्या तिना रे माठेया साथे करना ओर ना तिना री बेटिया रा ब्या आपणे माठेया साथे करना ओर ना कदी तिना री शान्ति चाणी, इजी खे ताकि तुसे तागतबर बणो ओर तेस देशो रे अच्छे-अच्छे पदार्थ खाई सको ओर तिजी खे एड़ा छाडो, ताकि से तुसा रे कुलो रे अक्को दे सदा बणेया रा रओ।”<verse eid="EZR 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 9:13" />ओर इना सबी ते बाद जो म्हारे बुरे काम ओर बड़े दोषो रिया बजा ते जो कुछ आसा पाँदे बीतेया, जबकि ओ म्हारे परमेशर तैं म्हारे पापो बराबर आसा खे सजा नि दित्ती, बल्कि आसा बीचा ते कितणे बचायी की राखे, <verse eid="EZR 9:13" /><verse number="14" style="v" sid="EZR 9:14" />तेबे बी आसे तेरी आज्ञा खे फेर ना मानी की बुरे काम करने वाल़ेया लोका साथे रिश्तेदादारी करी राखी। तां आसा पाँदे एथो तक कोप करना तां आसे मिटाई देणे ओर आसा बीचा ते कोई बी जिऊँदा नि रणा। <verse eid="EZR 9:14" /><verse number="15" style="v" sid="EZR 9:15" />ओ इस्राएलो रे यहोवा परमेशर! तूँ तो तर्मी ए, आसे बची की आजाद ऊई रे, जेड़ा कि आज ए। देख, आसे तां सामणे दोषी ए, इजी बजा ते कोई तां सामणे खड़ा नि रयी सकदा।<verse eid="EZR 9:15" /></para>
  <chapter eid="EZR 9" />
  <chapter number="10" style="c" sid="EZR 10" />
  <para style="s">लोका रा आपणे पापो खे मानणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 10:1" />जेबे एज्रा परमेशरो रे मन्दरो सामणे मुंए रे पारे पड़ेया दा, रोंदा ऊआ प्रार्थना करदा ओर आपणे पापो खे मानणे लगी रा था, तेबे इस्राएलो बीचा ते मर्द, जवाणसा ओर बच्चेया री एक बऊत बड़ी मण्डल़ी तेसगे कट्ठी ऊई ओर लोक ईंकी-ईंकी की रोणे लगी रे थे।<verse eid="EZR 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZR 10:2" />तेबे यहीएलो रा पाऊ शकन्याह नाओं रा माणूं जो एलामो रे कुलो रा था, एज्रा खे बोलणे लगेया, “आसे लोके एस देशो रे लोका बीचा ते दूजी जातिया रिया जवाणसा साथे ब्या करी की परमेशरो साथे विश्वासघात तो करी राखेया, पर एड़ा ऊँदे ऊए बी एबु बी इस्राएलो खे उम्मीद ए। <verse eid="EZR 10:2" /><verse number="3" style="v" sid="EZR 10:3" />एबे आसे आपणे परमेशरो साथे ये वाचा बानूँ कि आसे आपणे प्रभुए री सलाह् ओर आपणे परमेशरो री आज्ञा सुणी की डरने वाल़ेया री सलाह् रे मुताबिक एड़िया सबी जवाणसा खे ओर तिना रे बच्चेया खे दूर करूँए ओर बिधानो रे मुताबिक काम करेया जाओ।” <verse eid="EZR 10:3" /><verse number="4" style="v" sid="EZR 10:4" />तिने बोलेया, “तूँ उठ, कऊँकि ये तेरा ई काम ए ओर आसे तां साथे ए; इजी री खातर याओ बानी की एते कामो रे लगी जा।” <verse eid="EZR 10:4" /><verse number="5" style="v" sid="EZR 10:5" />तेबे एज्रा उठेया ओर पुरोईत, लेविये ओर सबी इस्राएली लोका रे परदाना खे कसम खुल़ाई कि आसा एस वचनो रे मुताबिक ई करना ओर तिने तेड़ी ई कसम खाई।<verse eid="EZR 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 10:6" />तेबे एज्रा परमेशरो रे मन्दरो रे सामणे ते उठेया ओर एल्याशीबो रे पाऊ यहोहानानो रे कमरे खे गया ओर तेती पऊँची की ना तो रोटी खाई ओर ना ई पाणी पिया, कऊँकि से गुलामिया ते निकल़ी की आए रे विश्वासघातिया रिया बजा ते शोग मनांदा रया। <verse eid="EZR 10:6" /><verse number="7" style="v" sid="EZR 10:7" />तेबे तिने यहूदा ओर यरूशलेम शईरो रे रणे वाल़े गुलामिया ते आए रे सबी लोका बीचे ये प्रचार करवाया कि तुसे यरूशलेम शईरो रे कट्ठे ओ; <verse eid="EZR 10:7" /><verse number="8" style="v" sid="EZR 10:8" />ओर जो कोई परदान ओर बुजुर्गा री सलाह् नि मानोगा ओर तीऊँ दिना ते पीतरे नि आओगा, तो तेसरी सारी तअन-सम्पत्ति नाश करी देणी ओर से आपू गुलामिया ते आए रे लोका रिया सभा ते लग करना। <verse eid="EZR 10:8" /><verse number="9" style="v" sid="EZR 10:9" />तेबे यहूदा ओर बिन्यामीन गोत्रो रे सारे माणूं तीऊँ दिना ते पीतरे यरूशलेम शईरो दे कट्ठे ऊए; ये नऊए मीन्ने रे बिऊए दिने ऊआ ओर सब लोक परमेशरो रे मन्दरो रे चौको दे तेस प्रचारो रिया बजा ते ओर पारी बर्खा रे मारे थरथरांदे ऊए बैठे दे रये। <verse eid="EZR 10:9" /><verse number="10" style="v" sid="EZR 10:10" />तेबे एज्रा पुरोईत खड़ा ऊई की तिना खे बोलणे लगेया, “तुसे लोके परमेशरो साथे विश्वासघात करी की दूजी जातिया री जवाणसा साथे ब्या कित्तेया ओर इजी ते इस्राएलो रा दोष बढ़ी गा रा। <verse eid="EZR 10:10" /><verse number="11" style="v" sid="EZR 10:11" />तो एबे आपणे पितरा रे परमेशर यहोवे सामणे आपणे पाप मानी लो ओर तेसरी इच्छा पूरी करो ओर एस देशो रे लोका ते ओर दूजी जातिया रिया जवाणसा ते लग ऊई जाओ।”<verse eid="EZR 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 10:12" />तेबे पूरी मण्डल़िया रे लोके कट्ठे ऊई की एज्रा खे ज्वाब दित्तेया। तिने जोरे की बोलेया, “एज्रा तूँ ठीक बोलेया! ओर जेड़ा तूँ बोलेया आसा खे बी तेड़ा ई करना चाईयो। <verse eid="EZR 10:12" /><verse number="13" style="v" sid="EZR 10:13" />पर लोक बऊत ए ओर बरसाती रा मौसम ए ओर आसे बारे बरखा दे खड़े नि रयी सकदे ओर ये एक-दो दिना रा काम नि ए, कऊँकि आसे एते गल्ला दे बऊत बड़ा पाप करी राखेया। <verse eid="EZR 10:13" /><verse number="14" style="v" sid="EZR 10:14" />सारी मण्डल़िया रिया तरफा ते म्हारे परदान नियुक्त करो ओर जदुओ तक म्हारे परमेशरो रा पड़केया रा कोप आसा ते दूर नि ओ ओर ये काम खत्म नि ऊई जाओ, तदुओ तक आसा रे शईरो दे जितणे रणे वाल़ेया दूजी जातिया रिया जवाणसा साथे ब्या करी राखेया, सेयो ठराए रे बखतो पाँदे आया करो ओर तिना साथे एकी शईरो रे बुजुर्ग ओर न्यायी आया करो।” <verse eid="EZR 10:14" /><verse number="15" style="v" sid="EZR 10:15" />एतेरे खलाफ बस असाहेलो रा पाऊ योनातान ओर तिकवा रा पाऊ यहजयाह खड़े ऊए ओर मशुल्लाम ओर शब्बतै लेविये तिना रे खलाफ थे। <verse eid="EZR 10:15" /><verse number="16" style="v" sid="EZR 10:16" />पर गुलामिया ते आए रे लोके तेड़ा ई कित्तेया। तेबे एज्रा पुरोईत ओर पितरा रे कराने रे बड़े मर्द आपणे-आपणे पितरा रे कराने रे मुताबिक आपणे सब नाओं लिखाई की लग कित्ते ओर दसुए मीन्ने रे पईले दिने एते गल्ला री पूछताछ करने खे बैठीगे। <verse eid="EZR 10:16" /><verse number="17" style="v" sid="EZR 10:17" />ओर पईले मीन्ने रे पईले दिनो तक तिने तिना सबी मर्दा री छाणबीण पूरी करी ली, जिने दूजी जातिया री जवाणसा साथे ब्या कित्तेया था।<verse eid="EZR 10:17" /></para>
  <para style="s">दूजिया जातिया रिया जवाणसा साथे ब्या करने वाल़ेया रे नाओं</para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 10:18" />तेबे पुरोईता री ल्वादा बीचा ते, यो माणूं थे जिने दूजी जातिया री जवाणसा साथे ब्या कित्तेया था: येशुअ रे पाऊ, योसादाको रे पाऊ, ओर तेसरे पाई मासेयाह, एलीएजेर, यारीब ओर गदल्याह। <verse eid="EZR 10:18" /><verse number="19" style="v" sid="EZR 10:19" />इने सबी आथ आगे करी की वचन दित्तेया कि आसा आपणी जवाणसा खे तलाक देणा ओर तिने दोषी ऊई की, आपणे-आपणे दोषो रिया बजा ते एक-एक खाडू बलि कित्तेया।<verse eid="EZR 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZR 10:20" />इम्मेरो री ल्वादा बीचा ते, हनानी ओर जबद्याह। <verse eid="EZR 10:20" /><verse number="21" style="v" sid="EZR 10:21" />हारीमो री ल्वादा बीचा ते मासेयाह, एलिय्याह, शमायाह, यहीएल ओर उज्जियाह। <verse eid="EZR 10:21" /><verse number="22" style="v" sid="EZR 10:22" />पशहूरो री ल्वादा बीचा ते एल्योएनै, मासेयाह, इश्माएल, नतनेल, योजाबाद ओर एलासा। <verse eid="EZR 10:22" /><verse number="23" style="v" sid="EZR 10:23" />तेबे लेविया बीचा ते योजाबाद, शिमी, केलायाह जेसखे कलीता बोलोए, पतह्याह, यहूदा ओर एलीएजेर। <verse eid="EZR 10:23" /><verse number="24" style="v" sid="EZR 10:24" />गाणेवाल़ेया बीचा ते एल्याशीब ओर द्वारपाला बीचा ते शल्लूम, तेलेम ओर ऊरी। <verse eid="EZR 10:24" /><verse number="25" style="v" sid="EZR 10:25" />इस्राएलो बीचा ते परोशो री ल्वाद रम्याह, यिज्जियाह, मल्कियाह, मिय्यामीन, एलीआजार ओर बनायाह। <verse eid="EZR 10:25" /><verse number="26" style="v" sid="EZR 10:26" />एलामो री ल्वादा बीचा ते मत्तन्याह, जकर्याह, यहीएल अब्दी, यरेमोत ओर एलिय्याह। <verse eid="EZR 10:26" /><verse number="27" style="v" sid="EZR 10:27" />ओर जत्तूए री ल्वादा बीचा ते एल्योएनै, एल्याशीब, मत्तन्याह, यरेमोत, जाबाद ओर अज़ीज़ा। <verse eid="EZR 10:27" /><verse number="28" style="v" sid="EZR 10:28" />बेबैए री ल्वादा बीचा ते यहोहानान, हनन्याह, जब्बै ओर अतलै। <verse eid="EZR 10:28" /><verse number="29" style="v" sid="EZR 10:29" />बानीए री ल्वादा बीचा ते मशुल्लाम, मल्लूक, अदायाह, याबूश, शाल ओर यरामोत। <verse eid="EZR 10:29" /><verse number="30" style="v" sid="EZR 10:30" />पहत्मोआबो री ल्वादा बीचा ते अदना, कलाल, बनायाह, मासेयाह, मत्तन्याह, बसलेल, बिन्नूई ओर मनश्शे। <verse eid="EZR 10:30" /><verse number="31" style="v" sid="EZR 10:31" />हारीमो री ल्वादा बीचा ते एलीएजेर, यिश्शिय्याह, मल्कियाह, शमायाह, शिमोन; <verse eid="EZR 10:31" /><verse number="32" style="v" sid="EZR 10:32" />बिन्यामीन, मल्लूक ओर शेमर्याह। <verse eid="EZR 10:32" /><verse number="33" style="v" sid="EZR 10:33" />हाशूमो री ल्वादा बीचा ते मत्तनै, मत्तत्ता, जाबाद, एलीपेलेत, यरेमै, मनश्शे ओर शिमी। <verse eid="EZR 10:33" /><verse number="34" style="v" sid="EZR 10:34" />ओर बानीए री ल्वादा बीचा ते मादै, अम्राम, ऊएल; <verse eid="EZR 10:34" /><verse number="35" style="v" sid="EZR 10:35" />बनायाह, बेदयाह, कलूही; <verse eid="EZR 10:35" /><verse number="36" style="v" sid="EZR 10:36" />बन्याह, मरेमोत, एल्याशीब; <verse eid="EZR 10:36" /><verse number="37" style="v" sid="EZR 10:37" />मत्तन्याह, मत्तनै, यासू; <verse eid="EZR 10:37" /><verse number="38" style="v" sid="EZR 10:38" />बानी, बिन्नूई, शिमी; <verse eid="EZR 10:38" /><verse number="39" style="v" sid="EZR 10:39" />शेलेम्याह, नातान, अदायाह; <verse eid="EZR 10:39" /><verse number="40" style="v" sid="EZR 10:40" />मक्नदबै, शाशै, शारै; <verse eid="EZR 10:40" /><verse number="41" style="v" sid="EZR 10:41" />अजरेल, शेलेम्याह, शेमर्याह; <verse eid="EZR 10:41" /><verse number="42" style="v" sid="EZR 10:42" />शल्लूम, अमर्याह ओर यूसुफ। <verse eid="EZR 10:42" /><verse number="43" style="v" sid="EZR 10:43" />नबो री ल्वादा बीचा ते; यीएल मत्तित्याह, जाबाद, जबीना, यद्दई, योएल ओर बनायाह। <verse eid="EZR 10:43" /><verse number="44" style="v" sid="EZR 10:44" />इने सबी लोके दूजी जातिया री जवाणसा साथे ब्या करी ला था ओर बऊत जणेया री जवाणसा ते पाऊ बी पैदा ऊईगे थे।<verse eid="EZR 10:44" /></para>
  <chapter eid="EZR 10" />
</usx>