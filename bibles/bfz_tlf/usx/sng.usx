<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id" />
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright Information: Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">बांके गाणे</para>
  <para style="toc1">सुलैमानो रे बांके गाणे</para>
  <para style="toc2">बांके गाणे</para>
  <para style="toc3">बांके.</para>
  <para style="mt">बांके गाणे</para>
  <para style="mt2">सुलैमानो रे बांके गाणे</para>
  <para style="is">भूमिका</para>
  <para style="ip">बांके गाणे री कताबा रे पईले पदो ते लया दा शीर्षक ए जिदे बताई राखेया कि ये गीत कुण गाणे लगी रा। “बांके गाणे जो सुलैमानो रे ए” <char style="xt"><ref loc="SNG 1:1">1:1</ref> </char>एते कताबा रा जो शीर्षक ए तिने बस राजा सुलैमानो रा नाओं लया कऊँकि पुरिया कताबा दे तेसरे ई नाओं रे बारे दे बताई राखेया, <char style="xt"><ref loc="SNG 1:5">1:5</ref>; <ref loc="SNG 3:7">3:7</ref>,<ref loc="SNG 3:9">9</ref>,<ref loc="SNG 3:11">11</ref>; <ref loc="SNG 8:11-12">8:11-12</ref> </char></para>
  <para style="ip">ये कताब सुलैमाने तेबे लिखी थी जेबे से इस्राएलो पाँदे राज करो था। विद्वान लोक सुलैमानो खे ई एते कताबा रा लिखणे वाल़ा मानोए कि ये गाणे तिने आपणे राज्यकालो रे शुरूए देई लिखे थे। कविता दे जो ये नौ जवानिया रा जोश दखाई राखेया ए तिजी इस्से रिया बजा ते नि पर इजी खे बी कि लिखणे वाल़े देशो रे उत्तर ओर दक्खणा दुँईं तरफा रिया जगा रे बारे दे बताओआ ओर लबानोन ओर मिस्रो रे नाओं री बी चर्चा करी राखी ए। बांके गाणे एक कविता ए जो प्यारो रे सच्चे गुणो री महिमा करोए ओर सई रीतिया ते ब्याओ खे परमेशरो रा बिधान मानोई। जवाणस ओर मर्दो खे ब्याओ रिया सीमा दे रणा जरूरी ए ओर एकी दूजे साथे आत्मिक, ओर शरीरो रा प्रेम राखणा ए।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">1. वधू सुलेमानो रे बारे दे सोचोई <char style="ior"><ref loc="SNG 1:1-3:5">1:1-3:5</ref></char></para>
  <para style="io1">2. वधू मंगणी करने ते बाद ब्या ऊणे रा इन्तजार करोई <char style="ior"><ref loc="SNG 3:6-5:1">3:6-5:1</ref></char></para>
  <para style="io1">3. वधू वरो ते मिलणे री कल्पना करोई <char style="ior"><ref loc="SNG 5:2-6:3">5:2-6:3</ref></char></para>
  <para style="io1">4. वर ओर वधू एकी दूजे खे सराओ ए <char style="ior"><ref loc="SNG 6:4-8:14">6:4-8:14</ref></char></para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />ये बऊत बांके गाणे ए जो राजे सुलैमाने लिखी राखे।<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">1 राजा 4:32</char></note></para>
  <para style="s" vid="SNG 1:1">पईला गाणा</para>
  <para style="p" vid="SNG 1:1">
    <char style="k">वधू</char><verse eid="SNG 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 1:2" />काश! तूँ माखे आपणे ओठा ते चूमदा,</para>
  <para style="q" vid="SNG 1:2">कऊँकि तेरा प्यार अंगूरा रे रसो ते जादा उत्तम ए।<verse eid="SNG 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 1:3" />तैं कईया किस्मा रे इत्र लगाई राखे, इजी खे तिजी री खुशबू कितणी अच्छी ए,</para>
  <para style="q" vid="SNG 1:3">तेरा नाओं मानो लटे रे इत्रो जेड़ा ए;</para>
  <para style="q" vid="SNG 1:3">इजी री खातर जवाणसा तांते प्यार करोईया।<verse eid="SNG 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 1:4" />ओ मेरे राजा, छोड़ कर, छोड़ कर माखे आपणे मईलो खे लई चल।</para>
  <para style="q" vid="SNG 1:4">आसे तांदे मगन ओर खुश ऊणे;</para>
  <para style="q" vid="SNG 1:4">आसा तेरे अंगूरा रे रसो ते जादा तेरे न्याय री तारीफ करनी।</para>
  <para style="q" vid="SNG 1:4">से तां साथे ठीक ई प्यार राखोई।<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">होशे 11:4, फिलि. 3:1-12, पजन 45:14</char></note><verse eid="SNG 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 1:5" />ओ यरूशलेमो री जवाणसो,</para>
  <para style="q" vid="SNG 1:5">आऊँ काल़ी तो अई, पर बांकी ए,<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">ये रेगिस्तानी लोक आपणे तम्बूआ दे रओ थे जो काल़े थे</char></note></para>
  <para style="q" vid="SNG 1:5">आऊँ केदारो रे तम्बूए जेड़ी काल़ी ए, पर आऊँ सुलैमानो रे बणाए रे कअरो रे बांके पर्देया जेड़ी ए।<verse eid="SNG 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 1:6" />तूँ माखे कूरी की नि देख कि आऊँ साऊँल़ी ए</para>
  <para style="q" vid="SNG 1:6">जादातर तूपा रे रई की मेरा रंग साऊँल़ा ऊईरा।</para>
  <para style="q" vid="SNG 1:6">ओर मेरे पाई मांते नराज थे,</para>
  <para style="q" vid="SNG 1:6">तिने आऊँ अंगूरा रे बगीचेया दे रखवाल़ी करने वाल़ी बणाई,</para>
  <para style="q" vid="SNG 1:6">इजी बजा ते आऊँ आपणे शरीरो रा त्यान नि राखी सकी।<verse eid="SNG 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 1:7" />ओ मेरे प्यारे माखे बता,</para>
  <para style="q" vid="SNG 1:7">तूँ आपणियां पेडा-बाकरिया खे केई चराएया,</para>
  <para style="q" vid="SNG 1:7">तूँ तिना खे दपैरे केई राम कराएया,</para>
  <para style="q" vid="SNG 1:7">आऊँ तेरे साथिया री पेडा-बाकरिया गे</para>
  <para style="q" vid="SNG 1:7">कूँडा पाई की कदुओ तक पटकदी रऊँ?</para>
  <para style="p" vid="SNG 1:7">
    <char style="k">वर</char><verse eid="SNG 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 1:8" />ओ सबी ते बांकी, जे ताखे पता नि ए</para>
  <para style="q" vid="SNG 1:8">तो मेरिया पेडा-बाकरिया रे खुरा रे नशाण देखी की तेते कनारो खे चलदे जाणा</para>
  <para style="q" vid="SNG 1:8">आपणियां बाकरिया ओर तिना रे बच्चेया खे ओरी ग्वाल़ेया रे नेड़े-नेड़े चराया।<verse eid="SNG 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 1:9" />तूँ बांकी ए, मेरी प्यारी,</para>
  <para style="q" vid="SNG 1:9">तेसा जवान कोड़िया जेड़ी ए जो मिस्रो रे राजे रा रथ खींजोई।<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">1 राजा 10:26-29</char></note><verse eid="SNG 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 1:10" />तेरिया खाखा बाल़ा रिया लटा बीचे गईणेया ते लदी रिया कितणिया सुन्दर लगोईया,</para>
  <para style="q" vid="SNG 1:10">ओर तेरा गल़ा ईरेया री लड़िया ते परेया रा बांका लगोआ।<verse eid="SNG 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 1:11" />आसा ताखे सूईने रिया बाल़िया बनाणियां जो चाँदिए साथे सजाईया रिया ऊणिया।<verse eid="SNG 1:11" /></para>
  <para style="s">वधू</para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 1:12" />जेबे राजा आपणे सोफे पाँदे बैठी रा था,</para>
  <para style="q" vid="SNG 1:12">तेबे मेरे जटामासी इत्रो री खुशबू कमरे रे चऊँ कनारे फैलणे लगी री थी।<verse eid="SNG 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 1:13" />मेरा प्रेमी माखे लोबानो री थैलिया जेड़ा ए,</para>
  <para style="q" vid="SNG 1:13">जो मेरिया छातिया बीचे पड़ी दी रओई।<verse eid="SNG 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 1:14" />मेरा प्रेमी माखे मईंदिया रे फूला रे गुच्छेया जेड़ा ए,</para>
  <para style="q" vid="SNG 1:14">जो एनगदिया रे अंगूरा रे बगीचे रे ओआ।</para>
  <para style="p" vid="SNG 1:14">
    <char style="k">वर </char><verse eid="SNG 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 1:15" />तूँ बांकी ए, ओ मेरी प्यारी, तूँ सुन्दरी ए;</para>
  <para style="q" vid="SNG 1:15">तेरिया आखी कबूतरिया जेड़िया ए।</para>
  <para style="p" vid="SNG 1:15">
    <char style="k">वधू</char><verse eid="SNG 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 1:16" />ओ मेरी प्यारी तूँ सुन्दरी ओर मनो खे अच्छी लगणे वाल़ी ए</para>
  <para style="q" vid="SNG 1:16">ओर म्हारा बछौणा बी अरा-फरा काआ ए;<verse eid="SNG 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 1:17" />आसा रे कअरो रे शह्तीर देवदारो रे ऊणे,</para>
  <para style="q" vid="SNG 1:17">ओर म्हारे छतो रिया कड़िया केली रे डाल़ा रिया ऊणिया।<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 2:1" />आऊँ शारोन देशो रा गुलाब</para>
  <para style="q" vid="SNG 2:1">ओर काअटिया बीचला सोसणो रे फूलो जेड़ा ए।<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">यशा. 35:2; 65:10</char></note></para>
  <para style="p" vid="SNG 2:1">
    <char style="k">वर</char><verse eid="SNG 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 2:2" />जिंयाँ सोसणो रा फूल कांडेया बीचे खिलोआ</para>
  <para style="q" vid="SNG 2:2">तिंयाँ ई मेरी प्यारी जवाणसा बीचे सजी री ए।</para>
  <para style="p" vid="SNG 2:2">
    <char style="k">वधू</char><verse eid="SNG 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 2:3" />जिंयाँ सेऊआ रे डाल़ जंगल़ो दे ओरी डाल़ा बीचे ए,</para>
  <para style="q" vid="SNG 2:3">तिंयाँ ई मेरा प्रेमी जवाना बीचे ए।</para>
  <para style="q" vid="SNG 2:3">आऊँ तेसरिया छांयी रे खुश ऊई की बैठी गी</para>
  <para style="q" vid="SNG 2:3">ओर तेसरा फल माखे खाणे रे मीठा लगेया।<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="ft" closed="false">प्रकाशित 22:1,2</char></note><verse eid="SNG 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 2:4" />से माखे बड़े खाणे वाल़े कअरो दे लई आया,</para>
  <para style="q" vid="SNG 2:4">ओर आऊँ तिने आपणे प्यारे की टकी ती।<verse eid="SNG 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 2:5" />सेलियो! तुसे माखे किशमिश<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">सुकी दाख</char></note> खुल़ाई की तागत देओ,</para>
  <para style="q" vid="SNG 2:5">सेऊ खुल़ाई की माखे तरोताजा करो,</para>
  <para style="q" vid="SNG 2:5">कऊँकि माखे प्यारो री बमारी लगी गी री।<verse eid="SNG 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 2:6" />काश, तेसरा खूँजा आथ मेरे सिरो निठे ऊँदा</para>
  <para style="q" vid="SNG 2:6">ओर से माखे आपणे दाँणे आथो साथे गल़े लगांदा!<verse eid="SNG 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 2:7" />ओ यरूशलेमो री जवाणसो, आऊँ तुसा खे बारासींगिया</para>
  <para style="q" vid="SNG 2:7">ओर मैदानो री ईरणियां री कसम देई की बोलूँई</para>
  <para style="q" vid="SNG 2:7">कि तुसे म्हारे प्यारो दे बाधा नि डाल़ो।<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">बांके गाणे 3:5, 8:4</char></note></para>
  <para style="s" vid="SNG 2:7">दूजा गाणा</para>
  <para style="p" vid="SNG 2:7">
    <char style="k">वधू</char><verse eid="SNG 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 2:8" />सुणो! मेरे प्रेमिये रे आऊणे री आवाज सुणने लगी री।</para>
  <para style="q" vid="SNG 2:8">देखो एड़ा लगोआ कि से पाह्ड़ो पाँदिए उटकदा ओर पाह्ड़िया खे लाँगदा ऊआ मां कनारो खे आऊणे लगी रा।<verse eid="SNG 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 2:9" />मेरा प्रेमी बारासींगे या जवान ईरणो जेड़ा ए।</para>
  <para style="q" vid="SNG 2:9">देखो से म्हारिया दवाला पीछे खड़ी रा</para>
  <para style="q" vid="SNG 2:9">ओर द्धारिया रिया तरफा खे चांकी की देखणे लगी रा</para>
  <para style="q" vid="SNG 2:9">ओर जाल़िया वाल़ी द्धारिया बीचा ते देखणे लगी रा।<verse eid="SNG 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 2:10" />मेरा प्रेमी माखे बोलणे लगी रा,</para>
  <para style="p" vid="SNG 2:10">
    <char style="k">वर</char></para>
  <para style="q" vid="SNG 2:10">ओ मेरी प्यारी, ओ मेरी सुन्दरी, उठी की मां साथे चल;<verse eid="SNG 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 2:11" />देख, यिऊँद चलीगा रा,</para>
  <para style="q" vid="SNG 2:11">बरखा बी ऊई की चली गी री।<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">इस्राइलो दे सर्दिया दे तेज, ठण्डी बर्खा ओई </char></note><verse eid="SNG 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 2:12" />तरतिया पाँदे फूल फूलणे लगी रे,</para>
  <para style="q" vid="SNG 2:12">चिड़िया रा गाणे रा बखत आईगा रा</para>
  <para style="q" vid="SNG 2:12">ओर म्हारे देशो रे कबूतरो री आवाज सुणोई।<verse eid="SNG 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 2:13" />दाऊगल़े पाकणे लगी गे रे</para>
  <para style="q" vid="SNG 2:13">ओर अंगूरा री बेला फूलणे लगी रिया,</para>
  <para style="q" vid="SNG 2:13">सेयो खुशबू देणे लगी रिया।</para>
  <para style="q" vid="SNG 2:13">ओ मेरी प्यारी, ओ मेरी सुन्दरी, उठी की मां साथे चल।<verse eid="SNG 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 2:14" />तुँ एक कबूतरिया जेड़ी ए, जो मांते दूर चट्टानी री खीड़ा रे लूकी री ए।</para>
  <para style="q" vid="SNG 2:14">माखे आपणा मूँ दखा, ओर माखे आपणी आवाज सुणने दे,</para>
  <para style="q" vid="SNG 2:14">कऊँकि तेरी आवाज मीठी ओर तेरा मूँ बऊत सुन्दर ए।<verse eid="SNG 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 2:15" />तिना छोटिया गीदड़िया खे पकड़ी लओ,</para>
  <para style="q" vid="SNG 2:15">जो म्हारे फूल लगे दे अंगूरा रे बगीचे खे नाश करी सकोईया,<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">पजन 80:8-13, यहेजकेल 13:4</char></note></para>
  <para style="p" vid="SNG 2:15">
    <char style="k">वधू</char><verse eid="SNG 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 2:16" />मेरा प्रेमी मेरा ए ओर आऊँ तेसरी ए,</para>
  <para style="q" vid="SNG 2:16">से आपणियां पेडा-बाकरिया खे सोसणो रे फूला बीचे चराओआ।<verse eid="SNG 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 2:17" />जदुए तक दिन ठण्डा नि ओ ओर छांए लाम्बी ऊँदे-ऊँदे खत्म नि ओ,</para>
  <para style="q" vid="SNG 2:17">तदुए तक ओ मेरे प्रेमी तेस बारासींगे या जवान ईरणो जेड़ा बण</para>
  <para style="q" vid="SNG 2:17">जो बेतेर रे पाह्ड़ो पाँदे कूमोआ।<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="s">बेचैन करने वाल़ी रात</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 3:1" />राती रे बखते आऊँ आपणे माँजे पाँदे उठी की आपणे प्रेमिये खे टोल़दी रई;</para>
  <para style="q" vid="SNG 3:1">आऊँ तेसखे टोल़दी तो रई;</para>
  <para style="q" vid="SNG 3:1">पर से तेती नि मिलेया;<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">यशायाह 3:1</char></note><verse eid="SNG 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 3:2" />मैं आपणे आपू ते बोलेया, “मां एबे उठी की शईरो रे,</para>
  <para style="q" vid="SNG 3:2">ओर तिना रिया सड़का रे ओर चौको रे कूमी की आपणा प्रेमी टोल़ना।”</para>
  <para style="q" vid="SNG 3:2">आऊँ तेसखे टोल़दी तो रई, पर से माखे नि मिलेया।<verse eid="SNG 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 3:3" />शईरो रे कूमदे-कुमदे शईरो रा पईरा देणे वाल़े माखे मिले,</para>
  <para style="q" vid="SNG 3:3">तो मैं तिना ते पूछेया, “क्या तुसे मेरा प्रेमी देखी राखेया?”<verse eid="SNG 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 3:4" />माखे तिना ते आगे चलदे ऊए थोड़ी जी देर ऊई री थी</para>
  <para style="q" vid="SNG 3:4">कि मेरा प्रेमी माखे मिलीगा।</para>
  <para style="q" vid="SNG 3:4">मैं से पकड़ी ला; जदुए तक तेसखे आपणी माया रे कअरे जेती तेसे माखे जन्म दित्तेया था, लई नि आई, से जाणे नि दित्तेया।<verse eid="SNG 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 3:5" />ओ यरूशलेमो री जवाणसो, आऊँ तुसा खे बारासींगिया</para>
  <para style="q" vid="SNG 3:5">ओर मैदानो री ईरणियां री कसम देई की बोलूँई</para>
  <para style="q" vid="SNG 3:5">कि तुसे म्हारे प्यारो दे बाधा नि डाल़ो।</para>
  <para style="s" vid="SNG 3:5">तीजा गाणा</para>
  <para style="p" vid="SNG 3:5">
    <char style="k">वधू</char><verse eid="SNG 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 3:6" />ये कुण ए जो तुएँ रे खम्बे जेड़ा,</para>
  <para style="q" vid="SNG 3:6">गन्धरस ओर लोबानो साथे खुशबूदार</para>
  <para style="q" vid="SNG 3:6">ओर बपारिए रे सबी किस्मा रे खुशबूदार पाऊडरो रा लेप लगाई की</para>
  <para style="q" vid="SNG 3:6">सुनसाण जगा ते निकल़ी की आऊणे लगी रा?<verse eid="SNG 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 3:7" />देखो, ये राजा सुलैमानो री पालकी ए!</para>
  <para style="q" vid="SNG 3:7">तेसरे चऊँ कनारे इस्राएलो रे चूणे रे शूरवीरा बीचा ते साठ वीर तेस साथे-साथे चलणे लगी रे।<verse eid="SNG 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 3:8" />सेयो सारे के सारे तलवार चलाणे वाल़े ओर युद्ध बिद्या रे निपुण ए।</para>
  <para style="q" vid="SNG 3:8">राती दे ऊणे वाल़े आक्रमणो ते निपटणे खे बी हर एक मर्द तलवारी साथे लड़ने खे हमेशा त्यार रओआ।<verse eid="SNG 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 3:9" />राजा सुलैमाने आपणियां तँईं लबानोन प्रदेशो रे देवदारो री लकड़िया री एक बड़ी पालकी बणवाई।<verse eid="SNG 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 3:10" />तिने पालकिया रे खम्बे चाँदिए रे,</para>
  <para style="q" vid="SNG 3:10">तिजी रा सरयाणा सूईने रा ओर गद्दी बैंगणी रंगो रे टाल्लेया ते मढ़ी की बणवाई</para>
  <para style="q" vid="SNG 3:10">ओर तिजी रा बीचला इस्सा</para>
  <para style="q" vid="SNG 3:10">यरूशलेमो री बेटिया रे जरिए बड़े</para>
  <para style="q" vid="SNG 3:10">प्यारो साथे सजाई राखी।<verse eid="SNG 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 3:11" />ओ सिय्योनो री जवाणसो, आपणे-आपणे कअरो ते बारे निकल़ी की सुलैमान राजे खे देखो,</para>
  <para style="q" vid="SNG 3:11">देखो, तिने सेई मुकुट पईनी राखेया</para>
  <para style="q" vid="SNG 3:11">जो तेसरिये माये तेसरे ब्याओ रे</para>
  <para style="q" vid="SNG 3:11">दिने ओर तेसरे मनो री खुशिया रे दिने, तेसरे सिरो पाँदे राखेया था।<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="p">
    <char style="k">वर</char></para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 4:1" />ओ मेरी प्यारी तूँ बांकी ए, तूँ बऊत बांकी ए!</para>
  <para style="q" vid="SNG 4:1">तेरिया आखी तेरिया लटा बीचे कबूतरा</para>
  <para style="q" vid="SNG 4:1">जेड़िया दिशोईया।</para>
  <para style="q" vid="SNG 4:1">तेरे बाल़ तिना बाकरिया रे चूण्डो जेड़े ए</para>
  <para style="q" vid="SNG 4:1">जो गिलाद प्रदेशो रे पाह्ड़ो ते उतरने लगी रिया ए।<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">नसी. 5:19</char></note><verse eid="SNG 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 4:2" />तेरे दाँद तिना सऊँल़ी रिया पेडा रे चूण्डो जेड़े सफेद ए,</para>
  <para style="q" vid="SNG 4:2">जो एबु नाह्यी की ऊबे आई रिया ओ,</para>
  <para style="q" vid="SNG 4:2">ओर तिना बीचा ते एक बी राची री नि ए। सेओ सब एक जेड़िया ई आ।<verse eid="SNG 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 4:3" />तेरे ओठ लाल रंगो री तागेया री डोरिया जेड़े ए</para>
  <para style="q" vid="SNG 4:3">ओर तेरा मूँ प्यारा ए,</para>
  <para style="q" vid="SNG 4:3">तेरिया खाखा तेरिया लटा निठे</para>
  <para style="q" vid="SNG 4:3">अनारो रिया साटिया जेड़िया दिशोईया।<verse eid="SNG 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 4:4" />तेरी क्याड़ी दाऊदो रे गुम्मटो जेड़ी लाम्बी ओर बांकी ए,</para>
  <para style="q" vid="SNG 4:4">जो अस्त्र-शस्त्रा खे बणी रा ओर जेते पाँदे ह्जार ढाला टाँगी राखिया ओ,</para>
  <para style="q" vid="SNG 4:4">सेयो सब ढाला शूरवीरा रिया ए।<verse eid="SNG 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 4:5" />तेरिया दोनो छातिया मानो ईरणियां रे दो जुड़ूंआ बच्चेया जेड़िया ए,</para>
  <para style="q" vid="SNG 4:5">जो सोसणो रे फूला बीचे चरोए।<verse eid="SNG 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 4:6" />जदुए तक दिन ठण्डा नि ओ ओर छांए लाम्बी ऊँदे-ऊँदे खत्म नि ऊई जाओ,</para>
  <para style="q" vid="SNG 4:6">तदुए तक मां फटाफट गन्धरसो रे पाह्ड़ ओर लोबानो रिया पाह्ड़िया पाँदे रऊँगा।<verse eid="SNG 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 4:7" />ओ मेरी प्यारी, तूँ पुरिया तरअ ते बऊत बांकी ए,</para>
  <para style="q" vid="SNG 4:7">तांदे कोई बी दोष नि ए।<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">इफि. 5:27</char></note><verse eid="SNG 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 4:8" />ओ मेरी लाड़ी, तूँ मां साथे लबानोनो रे पाह्ड़ो ते,</para>
  <para style="q" vid="SNG 4:8">मां साथे लबानोनो रे पाह्ड़ो ते चली आओ।</para>
  <para style="q" vid="SNG 4:8">तूँ आमाना री चूँडिया पाँदा ते,</para>
  <para style="q" vid="SNG 4:8">सनीर पाह्ड़ ओर हेर्मोनो री चूँडिया<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">बिध. 3:9</char></note> पाँदा ते,</para>
  <para style="q" vid="SNG 4:8">शेरो री गुफा ते, चीतेया रे पाह्ड़ा पाँदा ते चली आओ।<verse eid="SNG 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 4:9" />ओ मेरी प्यारी, ओ मेरी मंगेतर, तैं मेरा मन मोहित करिता रा,</para>
  <para style="q" vid="SNG 4:9">तैं आपणियां एक ई नजरा ते</para>
  <para style="q" vid="SNG 4:9">ओर आपणे गल़े रे एक ई ईरे ते मेरा मन मोहित करिता रा।<verse eid="SNG 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 4:10" />ओ मेरी प्यारी, ओ मेरी मंगेतर, तेरा प्यार कितणा अच्छा ए!</para>
  <para style="q" vid="SNG 4:10">तेरा मन अंगूरा रे रसो ते कितणा खरा ए</para>
  <para style="q" vid="SNG 4:10">ओर तेरे इत्रो री खुशबू सबी किस्मा रे मसालेया री खुशबूआ ते तेज ए!<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">यूह. 4:10, यशायाह 12:3</char></note><verse eid="SNG 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 4:11" />ओ मेरी मंगेतर, तेरे ओठा ते सईत टपकोआ,</para>
  <para style="q" vid="SNG 4:11">तेरी जीबा निठे सईत ओर दूदो जेड़ी मठास ए,</para>
  <para style="q" vid="SNG 4:11">तेरे टाल्लेया री खुशबू लबानोनो री जी खुशबू ए।<verse eid="SNG 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 4:12" />मेरी प्यारी, मेरी लाड़ी, तूँ तेस बगीचे जड़ी ए,</para>
  <para style="q" vid="SNG 4:12">जेतेरा किने माणूंए प्रवेश द्वार बन्द करी राखेया ओर तिदे कोई बिना आज्ञा ते पीतरे नि आई सकदा। तूँ एक बन्द कित्ते रे झरने जेड़ी ए, जिदे कोई दूजा बिना आज्ञा ते नि पी सकदा।<verse eid="SNG 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 4:13" />तुँ स्वाद फल़ो ते परे अनारा रे डाल़ा रे एक बगीचे जेड़ी ए,</para>
  <para style="q" vid="SNG 4:13">ओर बऊत फल़णे वाल़े खुशबुदार डाल़िया जेड़ी ए, जिदे मईंदी ओर जटामासी बी ए, केसर,<verse eid="SNG 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 4:14" />लोबान, मुश्क, दाल़चीनी,</para>
  <para style="q" vid="SNG 4:14">गन्धरस, अगर ओर सबी तरआ रे खास-खास खुशबूआ वाल़िया डाल़िया बी।<verse eid="SNG 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 4:15" />तूँ एक बगीचे दे एक फव्वारे जेड़ी ए,</para>
  <para style="q" vid="SNG 4:15">साफ पाणिए रिया तारा जेड़ी ए,</para>
  <para style="q" vid="SNG 4:15">जो लबानोनो रे पाह्ड़ो ते थालो खे बह्योई।</para>
  <para style="p" vid="SNG 4:15">
    <char style="k">वधू</char><verse eid="SNG 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 4:16" />ओ उत्तरी अवा जाग ओर ओ दक्खणी अवा चली की आओ!</para>
  <para style="q" vid="SNG 4:16">मेरे बगीचे रे बह्यी जा, जेते की तिजी री खुशबू दूरो-दूरो तक फैलो।</para>
  <para style="q" vid="SNG 4:16">मेरा प्रेमी आपणे बगीचे रे आओ,</para>
  <para style="q" vid="SNG 4:16">ओर तिजी रे उत्तम-उत्तम फल खाओ।<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="p">
    <char style="k">वर</char></para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 5:1" />ओ मेरी प्यारी, ओ मेरी मंगेतर,</para>
  <para style="q" vid="SNG 5:1">आऊँ आपणे बगीचे रे आई रा,</para>
  <para style="q" vid="SNG 5:1">मैं आपणा गन्धरस ओर लोबान चूणी ला रा;</para>
  <para style="q" vid="SNG 5:1">मैं छते ते निकल़दे ऊए सईतो खे खाई ला,</para>
  <para style="q" vid="SNG 5:1">मैं दूद ओर अंगूरा रा रस पी ला।</para>
  <para style="p" vid="SNG 5:1">
    <char style="k">सेलिया</char>,</para>
  <para style="q" vid="SNG 5:1">ओ दोस्तो, तुसे बी खाओ,</para>
  <para style="q" vid="SNG 5:1">ओ प्यारेओ, पियो, जितणा जिऊ बोलोआ, तिथणा पियो!</para>
  <para style="s" vid="SNG 5:1">चौथा गाणा</para>
  <para style="p" vid="SNG 5:1">
    <char style="k">वधू</char><verse eid="SNG 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 5:2" />आऊँ सुती री थी, पर मेरा मन जागेया रा था।</para>
  <para style="q" vid="SNG 5:2">सुण, मेरा प्रेमी दरवाजा खटखटाओआ ओर बोलोआ,</para>
  <para style="p" vid="SNG 5:2">
    <char style="k">वर</char></para>
  <para style="q" vid="SNG 5:2">“ओ मेरी लाड़ी, ओ मेरी प्यारी, ओ मेरी कबूतरी,</para>
  <para style="q" vid="SNG 5:2">ओ मेरी निष्कलंक सुन्दरी, माखे दरवाजा खोल,</para>
  <para style="q" vid="SNG 5:2">कऊँकि मेरा सिर पाल़े साथे सीजी रा</para>
  <para style="q" vid="SNG 5:2">ओर मेरिया लटा राती पड़े रे पाल़े रे टीपे साथे सीजी रिया।”<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">प्रकाशित 3:20</char></note></para>
  <para style="p" vid="SNG 5:2">
    <char style="k">वधू</char><verse eid="SNG 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 5:3" />आऊँ आपणे टाल्ले खोली चूकी थी, आऊँ तिजी खे फेर किंयाँ पईनूँ?</para>
  <para style="q" vid="SNG 5:3">आऊँ तो आपणे पैर तोई चूकी थी, एबे तिना खे जमीना दे राखी की मईला किंयाँ करुँ?<verse eid="SNG 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 5:4" />मेरे प्रेमिये आपणा आथ दरवाजे रे छेदो ते पीतरे पाया,</para>
  <para style="q" vid="SNG 5:4">तेबे मेरा मन तेसरे प्यारो ते परी गा,<verse eid="SNG 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 5:5" />आऊँ आपणे प्रेमिये खे दरवाजा खोलणे खे उठी,</para>
  <para style="q" vid="SNG 5:5">ओर मेरे आथो ते गन्धरस टपकेया,</para>
  <para style="q" vid="SNG 5:5">ओर मेरी गूठिया ते टपकदा ऊआ गन्धरस दरवाजे रिया आथिया पाँदे पड़ेया।<verse eid="SNG 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 5:6" />आऊँ आपणे प्रेमिये खे दरवाजा खोलणे ई लगी री थी,</para>
  <para style="q" vid="SNG 5:6">पर मेरा प्रेमी मुड़ी की चलीगा था।</para>
  <para style="q" vid="SNG 5:6">जेबे से बोलणे लगी रा था, तेबे आऊँ डरी गी थी,</para>
  <para style="q" vid="SNG 5:6">मैं से टोल़ेया, पर मिलेया नि;</para>
  <para style="q" vid="SNG 5:6">मैं तेसखे आका पाईया, पर से नि सुणेया।<verse eid="SNG 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 5:7" />पईरा देणे वाल़े जो शईरो दे कूमणे लगी रे थे,</para>
  <para style="q" vid="SNG 5:7">तिने आऊँ टीसी ओर कायल कित्ती,</para>
  <para style="q" vid="SNG 5:7">पईरेदारे मेरी चाद्दर मांते छुड़ाई ती।<verse eid="SNG 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 5:8" />ओ यरूशलेमो री जवाणसो, आऊँ तुसा खे कसम देई की बोलूँई कि जे मेरा प्रेमी तुसा खे मिली जाओ,</para>
  <para style="q" vid="SNG 5:8">तो तेसखे बोली देणा कि आऊँ तेरे प्यारो रिया तँईं तड़फणे लगी री।</para>
  <para style="p" vid="SNG 5:8">
    <char style="k">सेलिया</char><verse eid="SNG 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 5:9" />ओ जवाणसा बीचे सबी ते बांकी,</para>
  <para style="q" vid="SNG 5:9">तेरा प्रेमी ओरी प्रेमिया ते किजी गल्ला रे खरा ए?</para>
  <para style="q" vid="SNG 5:9">तूँ आसा खे एड़ी कसम कऊँ देणे लगी री?</para>
  <para style="p" vid="SNG 5:9">
    <char style="k">वधू</char><verse eid="SNG 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 5:10" />मेरा प्रेमी गोरा ओर लाल जा ए,</para>
  <para style="q" vid="SNG 5:10">से ह्जारा बीचे एक ए।<verse eid="SNG 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 5:11" />तेसरा सिर शुद्ध सूईने जेड़ा ए,</para>
  <para style="q" vid="SNG 5:11">तेसरी लटकदी ऊईया बाल़ा रिया लटा कावा जेड़िया काल़िया ए।<verse eid="SNG 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 5:12" />तेसरिया आखी तिना कबूतरा जेड़िया बांकिया ए,</para>
  <para style="q" vid="SNG 5:12">जो दूदो दे नाह्या रा जेड़ा नदिया रे कनारे</para>
  <para style="q" vid="SNG 5:12">आपणे चूण्डो साथे एक पाल़िया रे बैठी रा ओ।<verse eid="SNG 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 5:13" />तेसरिया खाखा बलसानो रिया क्यारिया जेड़िया ए, जो खुशबू बखेरोईया,</para>
  <para style="q" vid="SNG 5:13">तेसरे ओठ मानो सोसणो रे फूलो जेड़े ए जिना ते गन्धरस टपकदा रओआ।<verse eid="SNG 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 5:14" />तेसरे आथ सूईने री छड़िया जेड़े ए जेते पाँदे किमती पात्थर फिरोजे साथे कारीगरी करी राखी।</para>
  <para style="q" vid="SNG 5:14">तेसरा शरीर मानो आथिये रे दाँदो रा बणेया राए ओर तिदे नीलमणिया जड़ी राखिया।<verse eid="SNG 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 5:15" />तेसरे पैर संगमरमरो रे खम्बे जेड़े ए जो शुद्ध सूईने पाँदे बठयाई राखे।</para>
  <para style="q" vid="SNG 5:15">से देखणे रे लबानोनो रे पाह्ड़ो जेड़े ओर सुन्दरता दे देवदारो रे डाल़ा जेड़ा ए।<verse eid="SNG 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 5:16" />तेसरी बाणी बऊत मीठी ए, आ, से बऊत बांका ए।</para>
  <para style="q" vid="SNG 5:16">ओ यरूशलेमो री जवाणसो, येई मेरा प्रेमी ए, ओर येई मेरा दोस्त ए।<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="p">
    <char style="k">सेलिया</char></para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 6:1" />ओ सारिया जवाणसा बीचे सबी ते बांकी,</para>
  <para style="q" vid="SNG 6:1">तेरा प्रेमी केई गया?</para>
  <para style="q" vid="SNG 6:1">तेरा प्रेमी केस कनारो खे चलीगा,</para>
  <para style="q" vid="SNG 6:1">आसा गे बता कि आसे तां साथे तेसखे टोल़ने निकल़ूँ?</para>
  <para style="p" vid="SNG 6:1">
    <char style="k">वधू</char><verse eid="SNG 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 6:2" />मेरा प्रेमी आपणे बगीचे रे चलीगा,</para>
  <para style="q" vid="SNG 6:2">से बलसानो रिया क्यारिया रिया तरफा खे जाई रा,</para>
  <para style="q" vid="SNG 6:2">ताकि बगीचे रे आपणियां पेडा-बाकरिया चराओ</para>
  <para style="q" vid="SNG 6:2">ओर सोसणो रे फूल कट्ठे करो।<verse eid="SNG 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 6:3" />आऊँ आपणे प्रेमिये री ए ओर मेरा प्रेमी मेरा ए,</para>
  <para style="q" vid="SNG 6:3">से सोसणो रे फूला रे मैदानो दे आपणी पेडा-बाकरिया चराओआ।</para>
  <para style="s" vid="SNG 6:3">पाँजुआ गाणा</para>
  <para style="p" vid="SNG 6:3">
    <char style="k">वर</char><verse eid="SNG 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 6:4" />ओ मेरी प्यारी, तूँ तिर्सा शईरो जेड़ी बांकी ए,</para>
  <para style="q" vid="SNG 6:4">तूँ यरूशलेमो जेड़ी बऊत ई बांकी ए,</para>
  <para style="q" vid="SNG 6:4">ओर चण्डा फरांदी ऊई सेना जेड़ी शानदार ए।<verse eid="SNG 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 6:5" />तूँ आपणियां आखी मेरिया तरफा ते फेरी लओ,</para>
  <para style="q" vid="SNG 6:5">कऊँकि आऊँ तिना ते कबराऊँआ, कऊँकि तेरिया आखी माखे आपणे काबूए रे करने लगी रिया;</para>
  <para style="q" vid="SNG 6:5">तेरे बाल़ गिलाद पाह्ड़ो रिया टलाना ते थाले उतर दिया बाकरिया रे चूण्डो जेड़े लगोए।<verse eid="SNG 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 6:6" />तेरे दाँद तिना ऊन कतरिया दिया पेडा रे चूण्डो जेड़े सफेद ए,</para>
  <para style="q" vid="SNG 6:6">जो एबु नाई की पाणिए ते बारे आई रिया,</para>
  <para style="q" vid="SNG 6:6">तिना बीचा ते एक बी राची री नि ए,</para>
  <para style="q" vid="SNG 6:6">सेओ सब एक जेड़िया ए।<verse eid="SNG 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 6:7" />तेरिया खाखा तेरिया लटा निठे</para>
  <para style="q" vid="SNG 6:7">अनारो रिया साटिया जेड़िया दिशोईया।<verse eid="SNG 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 6:8" />राजे गे साठ राणिया, अस्सी रखैला</para>
  <para style="q" vid="SNG 6:8">ओर अणगिणत कुआँरिया बी ओ।<verse eid="SNG 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 6:9" />पर तेबे बी मेरी कबूतरी, मेरी सबी ते बांकी, तूँ मेरे एक ईए;</para>
  <para style="q" vid="SNG 6:9">तूँ आपणियां माया री कल्ली ई लाडली ए।</para>
  <para style="q" vid="SNG 6:9">सारी कुआँरिये से देखी ओर तेसा खे भाग्यशाली बोलेया,</para>
  <para style="q" vid="SNG 6:9">राणिये ओर रखैलिये देखी की तेसा री सुन्दरता री तारीफ कित्ती।<verse eid="SNG 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 6:10" />ये प्यागा जेड़ी दिशणे वाल़ी कुण ए,</para>
  <para style="q" vid="SNG 6:10">जो सुन्दरता रे चाँदो जेड़ी ए,</para>
  <para style="q" vid="SNG 6:10">सूरजो जेड़ी चमकणे वाल़ी</para>
  <para style="q" vid="SNG 6:10">ओर चण्डा फरांदी ऊई सेना जेड़ी</para>
  <para style="q" vid="SNG 6:10">शानदार दिशोई?<verse eid="SNG 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 6:11" />आऊँ खोड़ो रे बगीचे रे उतरीगी,</para>
  <para style="q" vid="SNG 6:11">ताकि तराईया रे फूल देखूँ</para>
  <para style="q" vid="SNG 6:11">ओर देखूँ कि अंगूरा री बेला रे कलिया लगिया क्या</para>
  <para style="q" vid="SNG 6:11">ओर अनारो रे फूल खिले कि नई।<verse eid="SNG 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 6:12" />माखे पता चलणे ते पईले ई मेरिये सोचे</para>
  <para style="q" vid="SNG 6:12">आऊँ आपणे राजकुमारो रे रथो पाँदे तेसरे बडिया सेना साथे चढ़ाईती।</para>
  <para style="p" vid="SNG 6:12">
    <char style="k">सेलिया</char><verse eid="SNG 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 6:13" />वापस आओ, वापस आओ, ओ शूलेम्मिन,<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">शुलेमो री रणे वाल़ी</char></note></para>
  <para style="q" vid="SNG 6:13">वापस आओ, वापस आओ, ताकि आसे ताखे देखूँ।</para>
  <para style="p" vid="SNG 6:13">
    <char style="k">वधू</char></para>
  <para style="q" vid="SNG 6:13">तुसे शूलेम्मिनो खे कऊँ देखणा चाओईया?</para>
  <para style="q" vid="SNG 6:13">क्या आऊँ दुँईं चूण्डा बीचे नाचणे वाल़ी बेटी ए?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="s">तारीफा रा बखाण</para>
  <para style="p">
    <char style="k">वर</char></para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 7:1" />ओ राजकुमारी, तेरे पैर जूतिया बीचे</para>
  <para style="q" vid="SNG 7:1">केड़े बांके लगोए!</para>
  <para style="q" vid="SNG 7:1">तेरे पाटो री गोल़ाई एड़े गईणेया जेड़ी ए,</para>
  <para style="q" vid="SNG 7:1">जो किने निपुण कारीगरे बणाई राखी ओ।<verse eid="SNG 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 7:2" />तेरी नाह्यी गोल़ कटोरा ए।</para>
  <para style="q" vid="SNG 7:2">जो मानो मसाला मलाए रे शराबो साथे परेया रा ओ,</para>
  <para style="q" vid="SNG 7:2">तेरा पेट कणका रे टेरो जेड़ा ए,</para>
  <para style="q" vid="SNG 7:2">जेतेरे चऊँ कनारे मानो सोसणो रे फूल ओ।<verse eid="SNG 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 7:3" />तेरी दोनो छातिया</para>
  <para style="q" vid="SNG 7:3">ईरणियां रे दो जुड़ूंआ बच्चेया जेड़िया ए।<verse eid="SNG 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 7:4" />तेरा सुराईया जेड़ा गल़ा आथिया रे दाँदो ते बणेया रा गुम्मटो जेड़ा ए।</para>
  <para style="q" vid="SNG 7:4">तेरिया आखी हेशबोनो रे तिना कुण्डा जेड़िया ए,</para>
  <para style="q" vid="SNG 7:4">जो बत्रब्बीमो रे प्रवेश द्वारो गे ए।</para>
  <para style="q" vid="SNG 7:4">तेरा नाक लबानोनो रे गुम्मटो जेड़ी ए,</para>
  <para style="q" vid="SNG 7:4">जो दमिश्क शईरो रे कनारो खे पईरा देओआ।<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="ft" closed="false">पजन. 45:8 </char></note><verse eid="SNG 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 7:5" />तेरे सिरो रा मुकुट कर्मेल पाह्ड़ो जेड़ा सजेया रा दिशोआ,</para>
  <para style="q" vid="SNG 7:5">ओर तेरे सिरो रिया लटा बैंगणी रंगो रे टाल्लेया जेड़िया दिशोईया;</para>
  <para style="q" vid="SNG 7:5">राजा इना लटा दे कैद ऊईगा रा।<verse eid="SNG 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 7:6" />ओ प्यारी ओर मनो खे अच्छी लगणे वाल़ी,</para>
  <para style="q" vid="SNG 7:6">तूँ केड़ी बांकी ओर अच्छी ए।<verse eid="SNG 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 7:7" />तेरा कद खजूरो रे डाल़ो जेड़ा ऊच्चा ए</para>
  <para style="q" vid="SNG 7:7">ओर तेरी छातिया अंगूरा रे गुच्छेया जेड़िया ए।<verse eid="SNG 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 7:8" />मैं सोचेया, “मां एस खजूरो रे डाल़ो पाँदे चढ़ी की एतेरिया डाल़िया पकड़णियाँ।”</para>
  <para style="q" vid="SNG 7:8">तेरी छातिया अंगूरा रे गुच्छे जेड़िया ए</para>
  <para style="q" vid="SNG 7:8">ओर तेरे साओ री खुशबू सेऊआ जेड़ी ए।<verse eid="SNG 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 7:9" />तेरे ओठ खरे अंगूरा रे रसो जेड़े ए।</para>
  <para style="p" vid="SNG 7:9">
    <char style="k">वधू</char></para>
  <para style="q" vid="SNG 7:9">जो आऊल़े-आऊल़े ओठा ओर दाँदा पाँदे बह्यी जाओई।<verse eid="SNG 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 7:10" />आऊँ आपणे प्रेमिये री ए</para>
  <para style="q" vid="SNG 7:10">ओर तेसरी इच्छा हमेशा मेरिया तरफा खे बणी री रओई।<verse eid="SNG 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 7:11" />ओ मेरे प्रेमी, आओ, आसे डोरूआ खे निकल़ी जाऊँए</para>
  <para style="q" vid="SNG 7:11">ओर गाँवो रे रऊँए;<verse eid="SNG 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 7:12" />आओ आसे प्यागा उठी की अंगूरा रे बगीचे रे चलूँए</para>
  <para style="q" vid="SNG 7:12">ओर देखूँए कि अंगूरा री बेला रे कलिया लगिया या नि, अंगूरा रे फूल खिले या नि</para>
  <para style="q" vid="SNG 7:12">ओर अनारा रे फूल फूली रे कि नि,</para>
  <para style="q" vid="SNG 7:12">मां ताखे तेती आपणा प्यार दखाणा।<verse eid="SNG 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 7:13" />दूदाफल़ो बीचा ते खुशबू आऊणे लगी री</para>
  <para style="q" vid="SNG 7:13">ओर म्हारे द्वारो पाँदे सबी किस्मा रे अच्छे फल ए, नये ओर पुराणे बी,</para>
  <para style="q" vid="SNG 7:13">जो, ओ मेरे प्रेमी, मैं तेरिया तँईं कट्ठे करी राखे।<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">उत्प. 30:14-16 </char></note><verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 8:1" />खरा ऊँदा कि तूँ मेरा पाई ऊँदा,</para>
  <para style="q" vid="SNG 8:1">जिने मेरिया माया रा दूद पिया!</para>
  <para style="q" vid="SNG 8:1">तेबे आऊँ ताखे कअरो ते बारे मिली की तेरे गल़े लगदी,</para>
  <para style="q" vid="SNG 8:1">तो केसी मेरी बेजती नि करनी थी।<verse eid="SNG 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 8:2" />आऊँ ताखे आपणी माया रे कअरे लई चलदी</para>
  <para style="q" vid="SNG 8:2">ओर तेसा माखे सिखाणा था</para>
  <para style="q" vid="SNG 8:2">ओर मां ताखे मसाला मिलेया रा अंगूरा रा रस ओर आपणे अनारा रा रस पल़्याणा था।<verse eid="SNG 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 8:3" />काश, तेसरा खूँजा आथ मेरे सिरो निठे ऊँदा</para>
  <para style="q" vid="SNG 8:3">ओर से आपणे दाँणे आथो साथे माखे आपणे गल़े लगांदा।<verse eid="SNG 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 8:4" />मांते वादा करो, ओ यरूशलेमो री जवाणसो, कि तुसे म्हारे प्यारो दे बाधा नि डाल़ोगिया।</para>
  <para style="s" vid="SNG 8:4">छठा गाणा</para>
  <para style="p" vid="SNG 8:4">
    <char style="k">सेलिया</char><verse eid="SNG 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 8:5" />ये कुण ए जो आपणे प्रेमिये री कांदा पाँदे आपणा सिर राखी की</para>
  <para style="q" vid="SNG 8:5">सुनसाण जगा ते चली की आऊणे लगी री?</para>
  <para style="p" vid="SNG 8:5">
    <char style="k">वधू</char></para>
  <para style="q" vid="SNG 8:5">मैं तूँ सेऊआ रे डाल़ो निठे जगाया।</para>
  <para style="q" vid="SNG 8:5">जेती तेरिए माये तेरिया तँईं जम्मणे रिया पीड़ा लईया।</para>
  <para style="q" vid="SNG 8:5">जेती तेरिए माये ताखे जन्म दित्तेया था।<verse eid="SNG 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 8:6" />ओ मेरे प्रेमी! माखे नगिने जेड़ा आपणे दिलो दे लगाई की राख</para>
  <para style="q" vid="SNG 8:6">ओर जन्त्रो जेड़ा आपणियां बांई पाँदे बानी लओ,</para>
  <para style="q" vid="SNG 8:6">प्यार मौता जेड़ा तागतबर ए;</para>
  <para style="q" vid="SNG 8:6">तेतेरा जुनून मौता रे रूपो दे तागतबर ए। ओर जल़न कब्रा जेड़ी बिना दया री ए,</para>
  <para style="q" vid="SNG 8:6">ओर तिजी रिया लूपिया आगी री लूपिया जेड़िया ओईया,</para>
  <para style="q" vid="SNG 8:6">ओर बऊत बड़िया ओईया।<note caller="+" style="f"><char style="fr" closed="false">8:6 </char><char style="ft" closed="false">यशायाह 49:16</char></note><verse eid="SNG 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 8:7" />बऊत सारा पाणी बी प्यारो रिया आगी खे बजयाई नि सकदा</para>
  <para style="q" vid="SNG 8:7">ओर ना कोई बाढ़ा रा पाणी तिजी खे डबोई सकोआ।</para>
  <para style="q" vid="SNG 8:7">जे कोई आपणे कअरो री सारी तअन-दौलत प्यारो रे बदले बी देई देओगा,</para>
  <para style="q" vid="SNG 8:7">तेबे बी तेसरी तअन-दौलत प्यारो रे पालड़े रे अल़की पड़नी।</para>
  <para style="p" vid="SNG 8:7">
    <char style="k">वधूआ रा पाई</char><verse eid="SNG 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 8:8" />म्हारी एक छोटी बईण ए,</para>
  <para style="q" vid="SNG 8:8">जेसा रिया छातिया एबु नि उभरिया।</para>
  <para style="q" vid="SNG 8:8">जेस दिने म्हारी बईणा री ब्याओ री गल्ल लगोगी,</para>
  <para style="q" vid="SNG 8:8">तेस दिने आसे तेसा रिया तँईं क्या करुँ?<verse eid="SNG 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 8:9" />जे से छोटी बईण दवाला जेड़ी ऊँदी</para>
  <para style="q" vid="SNG 8:9">तो आसे तिजी पाँदे चाँदिए रा कंगूरा बणांदे</para>
  <para style="q" vid="SNG 8:9">ओर जे से दरवाजे रे फल़े जेड़ी ऊँदी</para>
  <para style="q" vid="SNG 8:9">तो आसे तिजी पाँदे देवदारो रे तख़्ते लगांदे।</para>
  <para style="p" vid="SNG 8:9">
    <char style="k">वधू</char><verse eid="SNG 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 8:10" />मेरी छाती पईले दवाला जेड़ी सवीं थी, पर एबे मेरी छातिया शरपनाह पाँदे गुम्मटो जेड़िया ए;</para>
  <para style="q" vid="SNG 8:10">जेबे मेरे प्रेमिये आऊँ देखी, तेबे तेसखे बड़ी शान्ति मिली। <note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="ft" closed="false">पजन 45:11</char></note></para>
  <para style="p" vid="SNG 8:10">
    <char style="k">वर</char><verse eid="SNG 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 8:11" />बाल्हामोन नाओं रिया जगा पाँदे राजा सुलैमानो रा एक अंगूरा रा बगीचा था,</para>
  <para style="q" vid="SNG 8:11">तिने से दाखा रा बगीचा रखवाल़ेया गे ठेके पाँदे सम्बाल़ी ता;</para>
  <para style="q" vid="SNG 8:11">हर एक रखवाल़े खे तिजी रे फला रिया तँईं</para>
  <para style="q" vid="SNG 8:11">चाँदिए रे ह्जार-ह्जार टुकड़े देणे थे।<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">मत्ती 21:33</char></note><verse eid="SNG 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 8:12" />मेरा आपणा अंगूरा रा बगीचा जो मेरा ई इस्सा ए, से मेरे सामणे ए,</para>
  <para style="q" vid="SNG 8:12">ओ राजा सुलैमान, ये चाँदिए रे ह्जार ताखे</para>
  <para style="q" vid="SNG 8:12">ओर फल़ो रे रखवाल़ेया खे दो सौ चाँदिए रे सिक्के मिलो।<verse eid="SNG 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 8:13" />तूँ जो बगीचेया रे रएई,</para>
  <para style="q" vid="SNG 8:13">मेरे दोस्त तेरी आवाज सुणना चाओए;</para>
  <para style="q" vid="SNG 8:13">माखे बी आपणी आवाज सुणने दे।</para>
  <para style="p" vid="SNG 8:13">
    <char style="k">वधू</char><verse eid="SNG 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 8:14" />ओ मेरे प्रेमी, फटाफट आओ</para>
  <para style="q" vid="SNG 8:14">ओर खुशबूदार पाह्ड़ो पाँदे</para>
  <para style="q" vid="SNG 8:14">बारासींगे या जवान ईरणो जेड़े बणी जा।<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>