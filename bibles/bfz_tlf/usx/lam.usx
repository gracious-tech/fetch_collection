<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LAM" style="id" />
  <para style="h">बिलापगीत</para>
  <para style="toc1">यिर्मयाह नबीए रे जरिये लिखी री कताब</para>
  <para style="toc2">बिलापगीत</para>
  <para style="toc3">बिलाप.</para>
  <para style="mt">बिलापगीत</para>
  <para style="mt2">यिर्मयाह नबीए रे जरिये लिखी री कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">बिलापगीत नाओं री कताब पाँज कविता जोड़ने ते बणी री। ये कविता 586 ई. पू. दे यरूशलेमो रे नाश ओर तेसरे फल स्वरूप यरूशलेमो रा खण्डहरो दे बदल़ने ओर तेसरे लोका रा गुलामिया दे जाणे पाँदे रोणे खे ये लिखी राखी थी। एते कताबा रा जादातर इस्सा शोक मनाणे रे सबाओ रा ए, फेर बी केथी-केथी परमेशरो पाँदे परोसा ओर आऊणे वाल़े बखतो री उम्मीदा खे बी बताओआ। यहूदी लोक इना कविता रा इस्तेमाल बरत ओर रोणे वाल़े सालो रे त्योआरो दे आराधना करने खे करो थे। ये त्योआर 586 ई. पू. रे नाशो री यादा दे मनाया करो थे।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">यरूशलेमो रे दु:ख <char style="ior"><ref loc="LAM 1:1-22">1:1-1:22</ref></char></para>
  <para style="io1">यरूशलेमो खे सजा <char style="ior"><ref loc="LAM 2:1-22">2:1-22</ref> </char></para>
  <para style="io1">सजा ओर उम्मीद <char style="ior"><ref loc="LAM 3:1-66">3:1-66</ref></char></para>
  <para style="io1">खण्डहर ऊआ दा यरूशलेम <char style="ior"><ref loc="LAM 4:1-22">4:1-22</ref></char></para>
  <para style="io1">दया रिया तँईं प्रार्थना <char style="ior"><ref loc="LAM 5:1-22">5:1-22</ref> </char></para>
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="s">यरूशलेमो रे दु:ख</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 1:1" />एक बखत था जेबे यरूशलेम शईर लोका साथे परी रओ था,</para>
  <para style="q" vid="LAM 1:1">से एबे कल्ली बैठी री बिदुआ जवाणसा जेड़ा कऊँ बणीगा?</para>
  <para style="q" vid="LAM 1:1">एक बखत था जेबे से प्रदेशा री राणिया बीचे महान थी, एबे से गुलाम बणी की दूजेया राजेया खे कर देओई।<verse eid="LAM 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 1:2" />से सारिया राती फूटी-फूटी की रोंदा रओआ, तेसरे आसू खाखा पाँदे छूटोए;</para>
  <para style="q" vid="LAM 1:2">तेसरे सबी दोस्ता बीचे एबे कोई तेसखे शान्ति देणे वाल़ा कोई नि बची रा;</para>
  <para style="q" vid="LAM 1:2">तेसरे जो देश पईले दोस्त थे तिने तेस साथे विश्वासघात कित्तेया ओर एबे यरूशलेमो रे दुश्मण बणी गे रे।<verse eid="LAM 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 1:3" />यहूदा दु:ख ओर कठण गुलामिया ते बचणे खे परदेसो दे चली गी;</para>
  <para style="q" vid="LAM 1:3">पर दूजी जातिया बीचे रंदे ऊए तेसा खे राम करने री जगा नि मिलदी;</para>
  <para style="q" vid="LAM 1:3">तेसा खे सबी खदेड़नेवाल़ेया से तेसा री मुसीबता दे पकड़ी ती।<verse eid="LAM 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 1:4" />सिय्योन मन्दरो रे पाह्ड़ो रिया बाटा शोग करोईया,</para>
  <para style="q" vid="LAM 1:4">कऊँकि तेती ठराए रे त्योआरो पाँदे कोई नि आऊँदा,</para>
  <para style="q" vid="LAM 1:4">तेसरे सारे बड़े द्वार सुनसाण पड़ी रे, तेथो रे पुरोईत कणोए;</para>
  <para style="q" vid="LAM 1:4">तेथो रिया कुआँरिया दु:खी ए ओर सेयो सब कठण दु:ख सयीन करने लगी रिया।<verse eid="LAM 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 1:5" />यरूशलेमो रे दुश्मण जीती गे रे, तेसरे दुश्मण तरक्की करने लगी रे,</para>
  <para style="q" vid="LAM 1:5">कऊँकि यहोवे आपू तेसखे तेसरे बऊत पापो रिया बजा ते दु:ख देई राखेया;</para>
  <para style="q" vid="LAM 1:5">तेसरे बाल-बच्चेया खे दुश्मण दूजे देशो दे गुलाम बणाई की लईगे।<verse eid="LAM 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 1:6" />सिय्योनो रिया बेटिया रा सारा प्रताप छुड़ाई ला दा ए।</para>
  <para style="q" vid="LAM 1:6">तेथो रे परदान एड़े ईरणो जेड़े ऊईगे रे जिना खे चरने खे कुछ नि मिलदा;</para>
  <para style="q" vid="LAM 1:6">सेयो खदेड़नेवाल़ेया रे सामणे ते कमजोर ऊई की नठी जाओए।<verse eid="LAM 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 1:7" />यरूशलेमो रे लोके इना दु:खी ओर संकटो रे दिना दे, जेबे तेथो रे लोक दुश्मणा रे आथो दे पड़े</para>
  <para style="q" vid="LAM 1:7">ओर तिना रा कोई मतदगार नि रया, तेबे आपणी सब अच्छी चीजा जो पुराणे बखतो ते तिना रिया थिया, याद कित्तिया।</para>
  <para style="q" vid="LAM 1:7">तेसा रे जीतणे वाल़ेया से ऊजड़ देखी की आसिया लगाईया।<verse eid="LAM 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 1:8" />यरूशलेमो रे लोके बड़ा पाप कित्तेया, इजी री बजा ते से अशुद्ध जवाणस जी ऊई गी री,</para>
  <para style="q" vid="LAM 1:8">जितणे तेसा रा आदर करो थे, सेयो सब तेसा री बेज्जती करोए,</para>
  <para style="q" vid="LAM 1:8">कऊँकि तिने से नांगी देखी राखी, आ, एबे से शईर आपू कणने लगी रा, ओर शर्मा रे मारे मूँ लकोणे लगी रा।<verse eid="LAM 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 1:9" />तेसरी अशुद्धता तेसरे टाल्लेया पाँदे ई; तिने आपणा अन्त याद नि राखेया;</para>
  <para style="q" vid="LAM 1:9">इजी री खातर से खतरनाक तरीके ते रूड़ाया ओर तेसखे कोई शान्ति नि देयो था।</para>
  <para style="q" vid="LAM 1:9">से यहोवे ते दया खे बिनती करोई। ओ यहोवा, मेरे दु:खो खे देख, कऊँकि दुश्मण मेरे खलाफ सफल ऊई रा!<verse eid="LAM 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 1:10" />दुश्मणे तेथो रिया सब खरिया चीजा पाँदे आथ बढ़ाई राखेया; आ,</para>
  <para style="q" vid="LAM 1:10">दूजी जातिया खे, जिना रे बारे दे तैं आज्ञा दित्ती थी कि सेयो तेरी पवित्र सभा दे नि आई सकदे,</para>
  <para style="q" vid="LAM 1:10">सेयो तिने तेरी पवित्र जगा दे कूसदे ऊए देखी राखे।<verse eid="LAM 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 1:11" />यरूशलेमो रे सारे रणे वाल़े पीड़ा साथे कणदे ऊए खाणे रिया चीजा टोल़ोए;</para>
  <para style="q" vid="LAM 1:11">तिने आपणे प्राण बचाणे खे आपणी खरिया चीजा बेची की खाणे रिया चीजा खरीदी राखिया।</para>
  <para style="q" vid="LAM 1:11">सेयो मतादा रिया तँईं रोओ ए। सेयो बोलोए ओ यहोवा, देख, त्यानो साथे देख, कऊँकि आऊँ तुच्छ ऊई गी री।<verse eid="LAM 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 1:12" />ओ सब यात्रियो, क्या तुसा खे एते गल्ला री कोई बी फिकर नि ए?</para>
  <para style="q" vid="LAM 1:12">आपणियां आखी खोली की देखो, क्या मेरे दु:खो ते बढ़ी की</para>
  <para style="q" vid="LAM 1:12">ओर कोई पीड़ा ए जो यहोवे आपणे रोषो रे दिने मां पाँदे पाईती री?<verse eid="LAM 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 1:13" />तिने पाँदा ते मेरी आड्डिया पाँदे आग लगाई ओर सेयो तिदे स्वा ऊईगिया,</para>
  <para style="q" vid="LAM 1:13">तिने मेरे पैरा खे जाल़ लगाया ओर आऊँ उल्टी फेरी ती,</para>
  <para style="q" vid="LAM 1:13">तिने आऊँ एड़ी करी ती की आऊँ त्यागी री जी ओर बमारिया रिया बजा ते कमजोर रऊँई।<verse eid="LAM 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 1:14" />परमेशरे जूँगड़े री रस्सिया जेड़े मेरे पाप आपणे आथो साथे गूड़ी राखे;</para>
  <para style="q" vid="LAM 1:14">परमेशरो रा जूँगड़ा मेरिया कांदा पाँदे आ ओर तिने मेरी तागत कटाई ती री;</para>
  <para style="q" vid="LAM 1:14">जिना रा आऊँ सामणा पनि करी सकदी, आऊँ यहोवे तिना रेई वशो दे करी ती री।<verse eid="LAM 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 1:15" />परमेशरे मेरे सारे पराक्रमी योद्धा तुच्छ जाणे, तिने ठराए रे त्योआरो रा प्रचार करी की लोक मेरे खलाफ बुलाए,</para>
  <para style="q" vid="LAM 1:15">ताकि मेरे जवाना खे पीसो; यहूदा रे लोक यहोवे मानो कोल्हूए दे अंगूरा रा रस काडणे खे जोड़ी राखे।<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">प्रका. 14:20, प्रका. 19:15 </char></note><verse eid="LAM 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 1:16" />इना सबी गल्ला रिया बजा ते आऊँ रोऊँई, मेरिया आखी ते आसू निकल़दे रओए,</para>
  <para style="q" vid="LAM 1:16">कऊँकि जेस शान्ति देणे वाल़े रिया बजा ते मेरा जियू अरा फरा ऊई जाओ था, से मांते दूर ऊईगा;</para>
  <para style="q" vid="LAM 1:16">मेरे लोक कल्ले ऊईगे, कऊँकि दुश्मण प्रबल ऊई रा।<verse eid="LAM 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 1:17" />सिय्योनो रे लोके मतादा रिया तँईं आथ फैलाई राखे, तेसखे कोई शान्ति नि देंदा।</para>
  <para style="q" vid="LAM 1:17">यहोवे याकूबो रे वंशो रे बारे दे ये आज्ञा देई राखी कि तेथो रे चऊँ कनारले रणे वाल़े तेसरे दुश्मण ऊई जाओ;</para>
  <para style="q" vid="LAM 1:17">यरूशलेम तिना बीचे अशुद्ध जवाणसा जेड़ी ऊई गी री।<verse eid="LAM 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 1:18" />यहोवा सच्चाईया पाँदे ए, कऊँकि मैं तेसरी आज्ञा नि मानी।</para>
  <para style="q" vid="LAM 1:18">ओ सारे लोको, सुणो, ओर मेरी पीड़ देखो! मेरे जवान माठे ओर बेटिया गुलामिया दे चली गे रे।<verse eid="LAM 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 1:19" />मैं आपणे दोस्ता खे आका पाईया, पर तिने बी माखे तोखा दित्तेया,</para>
  <para style="q" vid="LAM 1:19">जेबे मेरे पुरोईत ओर परदान इजी री खातर खाणे रिया चीजा टोल़ने लगी रे थे कि खाणे ते तिना दे जान आई जाओ,</para>
  <para style="q" vid="LAM 1:19">तेबे तिना रे प्राण शईरो देई निकल़ी गे।<verse eid="LAM 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 1:20" />ओ यहोवा, माखे देख, कऊँकि आऊँ मुसीबता दे ए,</para>
  <para style="q" vid="LAM 1:20">मेरी आंतड़िया कमजोर ऊणे लगी रिया, मेरा दिल उल्टा ऊईगा रा, कऊँकि आसे तेरे खलाफ बऊत बगावत करी राखी।</para>
  <para style="q" vid="LAM 1:20">बारे तो आऊँ तलवारी साथे बेऔलाद ऊँई ओर कअरे मौत बैठी री।<verse eid="LAM 1:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 1:21" />लोके सुणेया कि आऊँ पीड़ा साथे कणदी रऊँई, पर माखे कोई शान्ति नि देंदा।</para>
  <para style="q" vid="LAM 1:21">ओ यहोवा, मेरे सबी दुश्मणे मेरी मुसीबता रे बारे दे सुणेया, सेयो ये सुणी की खुश ऊईगे कि तैं ई ये करी राखेया।</para>
  <para style="q" vid="LAM 1:21">पर जेस दिने न्याय रे दिनो री चर्चा तैं प्रचार करी की सुणाई राखी, तिजी खे तूँ दखा, तेबे सेयो बी मां जेड़े ऊई जाणे।<verse eid="LAM 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 1:22" />ओ यहोवा, मेरे दुश्मणा री सारी दुष्टता खे देख</para>
  <para style="q" vid="LAM 1:22">ओर जेड़ी तैं माखे मेरे सारे पापो रिया बजा ते सजा देई राखी, तेड़ी ई तिना खे बी सजा दे;</para>
  <para style="q" vid="LAM 1:22">कऊँकि आऊँ पीड़ा रिया बजा ते बऊत कणदी रऊँई</para>
  <para style="q" vid="LAM 1:22">ओर मेरा दिल बमारिया रिया बजा ते कमजोर ऊईगा रा।<verse eid="LAM 1:22" /></para>
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="s">यरूशलेमो साथे परमेशरो रा गुस्सा</para>
  <para style="p">
    <verse number="1" style="v" sid="LAM 2:1" />देखो परमेशरे यरूशलेम शईरो खे आपणी सजा रे खतरे दे पाईता! तिने इस्राएलो री शोभा सर्गो ते तरतिया पाँदे पटकी ती ओर प्रकोपो रे दिने आपणे पैरा री चौकी याद नि राखी। <verse eid="LAM 2:1" /><verse number="2" style="v" sid="LAM 2:2" />परमेशरे गुस्से दे आई की याकूब मतलब यहूदा प्रदेशो रिया सब दवाला टाल़ी तिया, यहोवे रोषो दे आई की यहूदा प्रदेशो रे लोका रे सारे मजबूत गढ़ टाल़ी की माट्टिया रे मलाई ते; तिने परदाना समेत राज्य अपवित्र ठराई राखेया। <verse eid="LAM 2:2" /><verse number="3" style="v" sid="LAM 2:3" />तिने रोषो दे आई की इस्राएलो री सारी तागत खत्म करिती; तिने दुश्मणा सामणे तिना री मताद करने ते आपणा मूँ फेरी ता रा; तिने चऊँ कनारे स्वा करदी ऊई लौ जेड़ा याकूब फूकी ता। <verse eid="LAM 2:3" /><verse number="4" style="v" sid="LAM 2:4" />यहोवे दुश्मण बणी की तीरक बाण चढ़ाया ओर बैरी बणी की दाँणा आथ बढ़ाई की खड़ा ऊई रा ओर यहूदा रे लोक जितणे देखणे दे बांके थे, तिने सेयो सब काईते; यरूशलेम शईरो रे तम्बूए पाँदे तिने आपणा गुस्सा आगी जेड़ा पड़काई ता रा।<verse eid="LAM 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LAM 2:5" />परमेशर आसा इस्राएलिया रा दुश्मण बणीगा दा ए, तिने इस्राएल निगल़ी ता; तिने तेसरे सारे मईल खत्म करीते ओर तेसरे मजबूत गढ़ नाश करीते ओर यहूदा प्रदेशो रे लोका रा शोग ओर रोणा-पीटणा बऊत बढ़ाईता। <verse eid="LAM 2:5" /><verse number="6" style="v" sid="LAM 2:6" />यहोवे आपणा मन्दर बगीचे रे मचरूँडणे जेड़ा अचाणक रूड़ाईता, तिने आपणा मिलणे वाल़ा तम्बू तोड़ी ता; यहोवे सिय्योनो दे ठराए रे त्यार ओर रामो रे दिन दोनो पुलाई ते ओर आपणे पड़के रे रोषो ते राजा ओर पुरोईत दुँईं रा तिरस्कार करी ता। <verse eid="LAM 2:6" /><verse number="7" style="v" sid="LAM 2:7" />परमेशरे आपणी बेदी मनो ते उतारी ती ओर आपणे पवित्र मन्दर यरूशलेम बेज्जतिया साथे छाडी ती; तिने मन्दरो रिया कांदा दुश्मणा रे वशो दे करी तिया; तिने दुश्मणे यहोवे रे मन्दरो दे एड़ा जीतणे री जयकारा रा आल्ला कित्तेया कि मानो ठराए रे त्योआरो रा दिन ओ। <verse eid="LAM 2:7" /><verse number="8" style="v" sid="LAM 2:8" />यहोवे सिय्योनो री दवाल<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="fq" closed="false">सिय्योनो री दवाल </char><char style="ft" closed="false">यरूशलेम शईर </char></note> तोड़ने री ठाणी ली थी: तिने डोरी ओर साल़ पाई ओर से पूरी तरआ ते नाश करिती; तिने किले ओर दवाला दुँईं ते शोग मनवाया, सेयो दोनो कट्ठे टाल़ी ते। <verse eid="LAM 2:8" /><verse number="9" style="v" sid="LAM 2:9" />सिय्योन शईरो रे द्वार जमीना दे तसी गे रे, तिना रे साँगल़ तिने तोड़ी की नाश करीते। तेथो रे राजा ओर परदान दूजी जातिया बीचे रणे रिया बजा ते बिना बिधानो ते ऊईगे ओर यरूशलेमो रे नबिया खे यहोवे रे दर्शण नि मिलदे। <verse eid="LAM 2:9" /><verse number="10" style="v" sid="LAM 2:10" />यरूशलेमो रे बुजुर्ग दु:खी ऊई की जमीना पाँदे चुपचाप बैठी रे; तिने आपणे सिरो पाँदे तूड़ सेटी ओर चादरी की लक बानी राखेया; यरूशलेमो री कुआँरिये आपणा-आपणा सिर जमीना तक थाले चुकाया। <verse eid="LAM 2:10" /><verse number="11" style="v" sid="LAM 2:11" />मेरिया आखी आसू बाह्ंदे-बाह्ंदे थकी गिया, मेरी आन्तड़िया कमजोर ऊईगिया; मेरे लोका री बेटिया रे नाशो रिया बजा ते मेरा काल़जा फटीगा रा, कऊँकि बच्चे, बल्कि दूद पीणे वाल़े बच्चे बी शईरो रे चौको पाँदे बेओश ओए। <verse eid="LAM 2:11" /><verse number="12" style="v" sid="LAM 2:12" />सेयो बच्चे आपणी-आपणी माया खे रोई की बोलोए, “नज्ज ओर अंगूरा रा रस केई ए? सेयो शईरो रे चौका दे कायल कित्ते रे माणूंआ जेड़े बेओश ऊई की आपणे प्राण आपणी माया री गोदा दे छाडोए।”<verse eid="LAM 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LAM 2:13" />ओ यरूशलेमो रे लोको, आऊँ तेरे बारे दे क्या बोलूँ? आऊँ तेरी उपमा केस साथे करुँ? ओ सिय्योनो री कुआँरी बेटी, आऊँ कुणजी चीज तां जेड़ी ठराई की ताखे शान्ति देऊँ? कऊँकि तेरा दु:ख समुद्रो जेड़ा बड़ा ए; ताखे कुण ठीक करी सकोआ? <verse eid="LAM 2:13" /><verse number="14" style="v" sid="LAM 2:14" />तेरे भविष्यबक्ते यहोवे रे दर्शणो रा दावा करी की ता साथे बेकार ओर मूर्खता री गल्ल करी राखी; तिने तेरे पाप नि बताए, नई तो तूँ गुलाम नि ऊणी थी; पर तिने ताखे बेकार ओर चूठे वचन बताए। जो ताखे देशो ते काडणे री बजा ऊए। <verse eid="LAM 2:14" /><verse number="15" style="v" sid="LAM 2:15" />सारे यात्री तां पाँदे चाड़िया बजाओए; सेयो यरूशलेमो रे लोका पाँदे आपू बीचे एकी दूजे ते पूछी की चाड़िया बजाओए ओर सिर ईलाओए, “क्या ये सेई शईर ए, जेतेखे परमसुन्दरी ओर सारी तरतिया री खुशिया री बजा बोलो थे?”<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">मत्ती 27:39 </char></note> <verse eid="LAM 2:15" /><verse number="16" style="v" sid="LAM 2:16" />तेरे सबी दुश्मणे तेरे खलाफ बोलेया, सेयो चाड़ी बजाओए ओर दाँद पीसोए, सेयो आपू बीचे एकी दूजे ते पूछोए, “आसे इस्राएल निगल़ी ता! जेस दिनो खे आसे न्याल़ूँ थे, से येई ए, से आसा खे मिली गा, आसे तेसखे देखी चूकी रे।” <verse eid="LAM 2:16" /><verse number="17" style="v" sid="LAM 2:17" />यहोवे जो कुछ ठाणेया था सेई कित्तेया बी, जो वचन से पुराणे बखतो ते बोलदा आई रा सेई तिने पूरा बी कित्तेया; तिने निर्दयी ऊई की से टाल़ी ता, तिने दुश्मण तां पाँदे खुश कराये ओर तेरे दुश्मणा री तागतबर बढ़ाई। <verse eid="LAM 2:17" /><verse number="18" style="v" sid="LAM 2:18" />यरूशलेमो रे लोक परमेशरो रिया तरफा खे तन-मनो ते बुलाओए। ओ सिय्योनो री कुआँरी बेटी, आपणे आसू दिन-रात नदिया जेड़े बाह्दीं रओ! जरा बी राम नि कर, ना ई तेरिया आखी खे चैन मिलो! <verse eid="LAM 2:18" /><verse number="19" style="v" sid="LAM 2:19" />सारिया राती दे बार-बार उठी की चींगेया कर! परमेशरो सामणे आपणे मनो रिया गल्ला खे खाड्डा रे पाणिये जेड़िया लटी दे। तेरे बच्चे जो हर सड़का रे सिरे पाँदे पूखा रिया बजा ते बेओश ऊणे लगी रे, तिना रे प्राणो रिया खातर आपणे आथ परमेशरो रिया तरफा खे ऊबे चक।<verse eid="LAM 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LAM 2:20" />ओ यहोवा देख ओर त्यानो साथे देख कि तैं ये सारा दु:ख केसखे देई राखेया? क्या जवाणसा आपणा फल, मतलब आपणे गोदा रे बच्चेया खे खाओ? ओ प्रभु, क्या पुरोईत ओर भविष्यबक्ता खे तेरी पवित्र जगा दे काया करो? <verse eid="LAM 2:20" /><verse number="21" style="v" sid="LAM 2:21" />सड़का दे जवान ओर स्याणे दोनो जमीना दे पड़ी रे; मेरी कुआँरिया ओर जवान लोक तलवारी साथे काईते रे; तैं सेयो तेस दिने काये जेस दिने ताखे रोष आया; तैं सेयो निर्दयी ऊई की फाटी ते। <verse eid="LAM 2:21" /><verse number="22" style="v" sid="LAM 2:22" />तैं मेरे दुश्मण मेरे चऊँ कनारा ते डरो रो त्योआर मनाणे खे बुलाई राखे, ओर यहोवे रे रोषो रे दिने ना तो कोई नठी की निकल़ेया ओर ना ई कोई बचेया; मेरे दुश्मणे मेरे बच्चेया री अत्या करिती, जो मैं पाल़े ओर प्यार कित्तेया।<verse eid="LAM 2:22" /></para>
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="s">परमेशरो रिया दया ते उद्धारो री उम्मीद</para>
  <para style="p">
    <verse number="1" style="v" sid="LAM 3:1" />आऊँ जो ये लिखणे लगी रा मैं यहोवे रे रोषो रिया बजा ते बऊत दण्ड ओर दु:ख सयीन करी राखेया; <verse eid="LAM 3:1" /><verse number="2" style="v" sid="LAM 3:2" />ये एड़ा मानो कि परमेशर माखे लई जाई की प्रयासे दे नि, न्हेरे देई चलाओआ; <verse eid="LAM 3:2" /><verse number="3" style="v" sid="LAM 3:3" />यहोवे आपणा आथ मेरे खलाफ करिता एड़ा तिने बार-बार पूरा दिन ओर हर दिन कित्तेया। <verse eid="LAM 3:3" /><verse number="4" style="v" sid="LAM 3:4" />तिने मेरा मास ओर चामड़ा गल़ाई ता रा ओर तिने मेरी आड्डिया तोड़ी ती रिया। <verse eid="LAM 3:4" /><verse number="5" style="v" sid="LAM 3:5" />यहोवे माखे रोकणे खे जईरो वाल़ा कीला बणाया ओर आऊँ कठण काम ओर दु:खो साथे केरी राखेया; <verse eid="LAM 3:5" /><verse number="6" style="v" sid="LAM 3:6" />ये एड़ा मानो कि तिने आऊँ बऊत दिना ते मरे रे माणूंआ जेड़ा न्हेरी जगा दे जिऊँणे खे मजबूर कित्तेया। <verse eid="LAM 3:6" /><verse number="7" style="v" sid="LAM 3:7" />ये एड़ा मानो कि यहोवे मेरे चऊँ कनारे बाड़ लगाई राखेया कि आऊँ निकल़ी नि सकदा; तिने आऊँ बड़े साँगल़ा साथे बानी राखेया; <verse eid="LAM 3:7" /><verse number="8" style="v" sid="LAM 3:8" />आऊँ चींगी-चींगी की दुहाई देऊँआ, तेबे बी यहोवा मेरी प्रार्थना नि सुणदा; <verse eid="LAM 3:8" /><verse number="9" style="v" sid="LAM 3:9" />ये एड़ा मानो कि तिने मेरी बाट कअड़े रे पात्थरा साथे रोकी राखी, तिने मेरी बाट बाँगी करी ती री। <verse eid="LAM 3:9" /><verse number="10" style="v" sid="LAM 3:10" />यहोवा माखे बाटा दे ताक लगाए रे पालूए ओर शेरो जेड़ा ए;<verse eid="LAM 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LAM 3:11" />यहोवे आऊँ मेरी बाटा ते पुलाई ता ओर आऊँ फाड़ी ता; तिने आऊँ उजाड़ी ता रा। <verse eid="LAM 3:11" /><verse number="12" style="v" sid="LAM 3:12" />ये एड़ा मानो कि परमेशरे धनुष चढ़ाई की आऊँ आपणे तीरो रा नशाणा बणाई राखेया। <verse eid="LAM 3:12" /><verse number="13" style="v" sid="LAM 3:13" />ये एड़ा मानो कि तिने आपणे तीरो साथे मेरा दिल छेदी ता रा; <verse eid="LAM 3:13" /><verse number="14" style="v" sid="LAM 3:14" />मेरे आपणे सारे लोक मां पाँदे आसोए ओर पूरा दिन मां पाँदे गाणे बणाई की गाओए, <verse eid="LAM 3:14" /><verse number="15" style="v" sid="LAM 3:15" />परमेशरे आऊँ कठण दु:खो साथे परी ता ओर विष पल़्याई की रज्जाई ता रा। <verse eid="LAM 3:15" /><verse number="16" style="v" sid="LAM 3:16" />ये एड़ा मानो कि तिने मेरे दाँद रोड़िया साथे तोड़ी ते ओर आऊँ स्वाई साथे टखी ता रा; <verse eid="LAM 3:16" /><verse number="17" style="v" sid="LAM 3:17" />ओर आऊँ मनो ते उतारी की बिना कल्याणो रा करी ता रा; आऊँ कल्याण पूली गा रा; <verse eid="LAM 3:17" /><verse number="18" style="v" sid="LAM 3:18" />इजी री खातर मैं आपणे आपू ते बोलेया, “माँदे तागत नि रई ओर मेरी उम्मीद जो यहोवे पाँदे थी, से टूटी गी री।” <verse eid="LAM 3:18" /><verse number="19" style="v" sid="LAM 3:19" />ओ यहोवा मेरा दु:ख ओर पटकदे फिरना, मेरा विष पीणा याद कर! <verse eid="LAM 3:19" /><verse number="20" style="v" sid="LAM 3:20" />आऊँ तिना रे बारे देई सोचदा रऊँआ, इजी ते मेरे प्राण टल़ने लगी रे। <verse eid="LAM 3:20" /><verse number="21" style="v" sid="LAM 3:21" />पर आऊँ ये याद करूँआ, इजी री खातर माखे उम्मीद ए। <verse eid="LAM 3:21" /><verse number="22" style="v" sid="LAM 3:22" />आसे खत्म नि ऊए; ये यहोवे री महान करूणा रा फल ए, कऊँकि तेसरी दया अमर ए। <verse eid="LAM 3:22" /><verse number="23" style="v" sid="LAM 3:23" />से दया हर प्यागा खे नयी ऊँदी रओई; ओ यहोवा तेरी सच्चाई महान ए।<verse eid="LAM 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LAM 3:24" />इजी री खातर मैं आपणे आपू ते बोलेया, “यहोवा मेरा इस्सा ए, इजी बजा ते मां तेस पाँदे उम्मीद राखणी।” <verse eid="LAM 3:24" /><verse number="25" style="v" sid="LAM 3:25" />जो यहोवे खे न्याल़ोए ओर तेसगे जाओए, तिना खे यहोवा खरा ए। <verse eid="LAM 3:25" /><verse number="26" style="v" sid="LAM 3:26" />इजी री खातर यहोवे ते उद्धार पाणे री उम्मीद राखी की, चुपचाप रणा खरा ए। <verse eid="LAM 3:26" /><verse number="27" style="v" sid="LAM 3:27" />सबी मर्दो खे जवानिया रे कामो रा जूँगड़ा चकणा खरा ए। <verse eid="LAM 3:27" /><verse number="28" style="v" sid="LAM 3:28" />सब कोई ये जाणी की कल्ला चुपचाप रओ कि परमेशरे ई तेस पाँदे ये बोज राखी राखेया; <verse eid="LAM 3:28" /><verse number="29" style="v" sid="LAM 3:29" />से आपणा मूँ तूड़ा पाँदे राखो, क्या पता इदे कोई उम्मीद ओ कि यहोवा तिना री मताद करो; <verse eid="LAM 3:29" /><verse number="30" style="v" sid="LAM 3:30" />से आदमी आपणी खाख आपणे बाणे वाल़े रिया तरफा खे फेरो ओर बेज्जती सयीन करदा रओ। <verse eid="LAM 3:30" /><verse number="31" style="v" sid="LAM 3:31" />कऊँकि परमेशर आपणे माणूंआ खे सदा आपणे मनो ते उतारी की नि राखदा, <verse eid="LAM 3:31" /><verse number="32" style="v" sid="LAM 3:32" />यहोवा चाए दु:ख बी देयो, तेबे बी आपणी बऊत करूणा रिया बजा ते आसा पाँदे दया बी करोआ; <verse eid="LAM 3:32" /><verse number="33" style="v" sid="LAM 3:33" />कऊँकि से माणूंआ खे आपणे मनो ते ना तो दबांदा ओर ना दु:ख देंदा। <verse eid="LAM 3:33" /><verse number="34" style="v" sid="LAM 3:34" />पूरी तरतिया रे बन्दिया खे पैरा निठे राखोआ, <verse eid="LAM 3:34" /><verse number="35" style="v" sid="LAM 3:35" />केसी माणूंए रा अक्क परमपरदान परमेशरो सामणे मारना, <verse eid="LAM 3:35" /><verse number="36" style="v" sid="LAM 3:36" />ओर केसी माणूंए रा मुकद्दमा बिगाड़ना, इना तीऊँ कामा खे परमेशर देखी नि सकदा। <verse eid="LAM 3:36" /><verse number="37" style="v" sid="LAM 3:37" />जे परमेशरे आज्ञा नि दित्ती ओ, तेबे कुण ए कि वचन बोलो ओर से पूरा ऊई जाओ? <verse eid="LAM 3:37" /><verse number="38" style="v" sid="LAM 3:38" />मुसीबत ओर कल्याण, दोनो परमपरदान परमेशरो री आज्ञा ते ई ओ ए? <verse eid="LAM 3:38" /><verse number="39" style="v" sid="LAM 3:39" />इजी री खातर जिऊँदा माणूं कऊँ कुड़कुड़ाओ? ओर माणूं आपणे पापो रे दण्डो खे बुरा कऊँ मानो? <verse eid="LAM 3:39" /><verse number="40" style="v" sid="LAM 3:40" />आसा खे आपणा चाल-चलण त्यानो दे परखणा चाईयो ओर यहोवे रिया तरफा खे फिरना चाईयो। <verse eid="LAM 3:40" /><verse number="41" style="v" sid="LAM 3:41" />आओ, आसा खे स्वर्गो दे रणे वाल़े परमेशरो रिया तरफा खे त्यान लगाणा चाईयो ओर आथ फैलाई की बोलणा चाईयो, <verse eid="LAM 3:41" /><verse number="42" style="v" sid="LAM 3:42" />ओ यहोवा, आसे तेसखे बोलिये, “आसे तो तेरे खलाफ पाप ओर बगावत करी राखी ओर तैं माफ नि कित्तेया। <verse eid="LAM 3:42" /><verse number="43" style="v" sid="LAM 3:43" />तेरा गुस्सा आसा पाँदे ए, तूँ आसा पीछे पड़ी रा, तैं बिना तरस खाए आसा खे सजा देई राखी। <verse eid="LAM 3:43" /><verse number="44" style="v" sid="LAM 3:44" />तैं आपू खे बादल़ो साथे केरी ला रा, ताकि तां तक प्रार्थना नि पऊँची सको। <verse eid="LAM 3:44" /><verse number="45" style="v" sid="LAM 3:45" />तैं आसे जातिया-जातिया रे लोका बीचे कूड़ा-कबाड़ जेड़े ठराई राखे।<note caller="+" style="f"><char style="fr" closed="false">3:45 </char><char style="ft" closed="false">1 कुरि. 4:13 </char></note> <verse eid="LAM 3:45" /><verse number="46" style="v" sid="LAM 3:46" />म्हारे सारे दुश्मणे आसा पाँदे आपणा-आपणा मूँ फैलाई राखेया; <verse eid="LAM 3:46" /><verse number="47" style="v" sid="LAM 3:47" />डर ओर गड्डा, उजाड़ ओर नाश, आसा पाँदे आई की पड़ी रे।” <verse eid="LAM 3:47" /><verse number="48" style="v" sid="LAM 3:48" />कवि बोलोआ, “मेरे लोक कायी ते दे ए, ओर इजी ते मेरे आसू मेरिया आखी ते नदिया रे पाणिए जेड़े बह्ईणे लगी रे। <verse eid="LAM 3:48" /><verse number="49" style="v" sid="LAM 3:49" />मेरी आखी ते लगातार आसू बह्यींदे रणे।” <verse eid="LAM 3:49" /><verse number="50" style="v" sid="LAM 3:50" />ओ यहोवा मा तदुओ तक रोंदे रणा जदुओ तक तू स्वर्गो ते आसा रिया तरफा खे नि देखो; <verse eid="LAM 3:50" /><verse number="51" style="v" sid="LAM 3:51" />मेरे यरूशलेम शईरो रिया सबी जवान जवाणसा रा आल देखी की मेरा दु:ख बढ़ोआ। <verse eid="LAM 3:51" /><verse number="52" style="v" sid="LAM 3:52" />जो लोक बेकारो देई मेरे दुश्मण बणी रे, तिने निर्दयी ऊई की चिड़िया जेड़ा मेरा शिकार करी राखेया।<note caller="+" style="f"><char style="fr" closed="false">3:52 </char><char style="ft" closed="false">पज. 35:7 </char></note> <verse eid="LAM 3:52" /><verse number="53" style="v" sid="LAM 3:53" />तिने आऊँ जिऊँदा ई गड्डे दे सेटी ता की मेरी जिन्दगिया रा अन्त करने खे मां पाँदे पात्थर खसकेई सको; <verse eid="LAM 3:53" /><verse number="54" style="v" sid="LAM 3:54" />मेरे सिरो पाँदा ते पाणी बह्यी गा, मैं आपणे आपू ते बोलेया, “आऊँ एबे नाश ऊईगा।” <verse eid="LAM 3:54" /><verse number="55" style="v" sid="LAM 3:55" />ओ यहोवा, डूग्गे गड्डे ते मैं तांते प्रार्थना कित्ती कि मेरी मताद करो; <verse eid="LAM 3:55" /><verse number="56" style="v" sid="LAM 3:56" />तैं मेरी सुणी ताकि जो दुहाई देई की आऊँ चींगदा रऊँआ, तिजी ते कान नि फेर! <verse eid="LAM 3:56" /><verse number="57" style="v" sid="LAM 3:57" />जेबे मैं ताखे आका पाईया, तेबे तैं माखे ज्वाब दित्तेया, “डर नि!” <verse eid="LAM 3:57" /><verse number="58" style="v" sid="LAM 3:58" />ओ यहोवा, तैं मेरा मुकद्दमा लड़ी की मेरे प्राण बचाई ले रे। <verse eid="LAM 3:58" /><verse number="59" style="v" sid="LAM 3:59" />एबे ओ परमेशर, जो अन्याय मां पाँदे ऊई रा, से तैं देखी राखेया; तूँ मेरा न्याय कर। <verse eid="LAM 3:59" /><verse number="60" style="v" sid="LAM 3:60" />जो बदला मेरे दुश्मणे मांते लया ओर जो योजना मेरे खलाफ कित्ती, से बी तैं देखी राखिया। <verse eid="LAM 3:60" /><verse number="61" style="v" sid="LAM 3:61" />ओ यहोवा, जो योजना ओर निन्दा सेयो मेरे खलाफ करोए, सेयो बी तैं सुणी राखिया। <verse eid="LAM 3:61" /><verse number="62" style="v" sid="LAM 3:62" />मेरे बिरोदिया रे वचन ओर जो कुछ सेयो मेरे खलाफ लगातार सोचोए, तूँ तिजी खे जाणेया। <verse eid="LAM 3:62" /><verse number="63" style="v" sid="LAM 3:63" />तिना रा उठणा-बैठणा त्यानो दे देख; सेयो मां पाँदे गाणे बणाओए। <verse eid="LAM 3:63" /><verse number="64" style="v" sid="LAM 3:64" />ओ यहोवा, तूँ मेरे दुश्मणा रे कामो रे मुताबिक तिना खे सजा दे। <verse eid="LAM 3:64" /><verse number="65" style="v" sid="LAM 3:65" />तां तिना रा मन सुन्न करी देणा; तेरा स्राप तिना पाँदे ऊणा। <verse eid="LAM 3:65" /><verse number="66" style="v" sid="LAM 3:66" />ओ यहोवा, “तां आपणे रोषो ते सेयो दुड़ाई-दुड़ाई की तरतिया पाँदा ते पूरी तरआ ते नाश करी देणे।”<verse eid="LAM 3:66" /></para>
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="s">सजा मिलणे ते बाद यरूशलेमो री दशा</para>
  <para style="p">
    <verse number="1" style="v" sid="LAM 4:1" />पईले म्हारे लोक शुद्ध सूईने जेड़े थे, पर एबे सेयो बेकार ऊईगे दे ए।<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">सूईना बेकार समजेया जाओआ </char></note> जेड़े मन्दरो रे रत्न बिखरी रे, तेड़े ई म्हारे जवान बी बिखरी रे। <verse eid="LAM 4:1" /><verse number="2" style="v" sid="LAM 4:2" />सिय्योनो रे किमती जवान माणूं जो कुन्दनो जेड़े थे, पर एबे सेओ कुम्हारो रे बणाए दे माट्टिया रे कड़े जेड़े केड़े बेकार गिणी राखे! <verse eid="LAM 4:2" /><verse number="3" style="v" sid="LAM 4:3" />माये गीदड़िया बी आपणे बच्चेया खे खाणा खल़ाओईया, पर मेरे लोक आपणे बच्चेया ते बुरा बर्ताओ करोए; सेयो बणो दे रणे वाल़ेया शुतुरमुर्गेया जेड़िया ए जो आपणे अण्डे छाडी देओए। <verse eid="LAM 4:3" /><verse number="4" style="v" sid="LAM 4:4" />मेरे लोका रे दूद पींदे बच्चेया री जीब त्याय लगणे रिया बजा ते ताल़ूए साथे चिपकी गी री; बाल-बच्चे रोटी माँगोए, पर तिना खे कोई नि देंदा। <verse eid="LAM 4:4" /><verse number="5" style="v" sid="LAM 4:5" />एड़े लोक जो स्वाद खाणा खाओ थे, सेयो एबे थोड़ी जी रोटिया रिया तँईं पटकदे फिरोए। जो मखमलो रे टाल्लेया दे पल़े थे। सेओ कूड़ेया रे टेरो पाँदे लेटोए। <verse eid="LAM 4:5" /><verse number="6" style="v" sid="LAM 4:6" />सदोमो रे लोका पाँदे अचाणक विपत्ति आई, ओर तिना खे बचाणे वाल़ा कोई नि था; पर मेरे लोका खे सदोमो रे लोका ते बी कठोर दण्ड देई राखेया ए।<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">उत्प. 19:24-25 </char></note> <verse eid="LAM 4:6" /><verse number="7" style="v" sid="LAM 4:7" />सिय्योनो रे परदाना रा बर्ताओ पईले बऊत शुद्ध, बर्फ ओर दूदो ते बी जादा सफेद ओर चमकदार था; तिना रा शरीर मूँगेया ते जादा लाल ओर तिना री सुन्दरता नीलमणिया जेड़ी थी। <verse eid="LAM 4:7" /><verse number="8" style="v" sid="LAM 4:8" />पर एबे तिना री शक्ल न्हेरे ते बी काल़ी ए, सेयो सड़का रे पछयाणदे पनि; तिना री चामड़ी आड्डिया साथे सटी गी री ओर लकड़िया जेड़ी सूकी गी री। <verse eid="LAM 4:8" /><verse number="9" style="v" sid="LAM 4:9" />एड़े लोक जो लड़ाईया दे तलवारी साथे मारे दे पूखा री मारा ते ज्यादा ठीक थे जिना रे प्राण डोरूआ री उपजा ते बिना पूखा रे मारे आऊल़े-आऊल़े मरदे जाओए। <verse eid="LAM 4:9" /><verse number="10" style="v" sid="LAM 4:10" />जो जवाणसा पईले दया करने वाल़िया थिया तिने आपणे ई बच्चे काई की खाणे खे पकाये; कऊँकि जेबे यरूशलेम शईर दुश्मणा रे सिपाईए केरेया था तेबे तिने आपणे बच्चे काई की खाई ले। <verse eid="LAM 4:10" /><verse number="11" style="v" sid="LAM 4:11" />यहोवे आपणी पूरी जल़न बरसायी, तिने आपणा कोप बऊत ई पड़काया; ओर सिय्योनो रे एड़ी आग लगाई जेते कि तेतेरी निऊँ तक फूकी गी। <verse eid="LAM 4:11" /><verse number="12" style="v" sid="LAM 4:12" />तरतिया रा कोई राजा या दुनिया रे कोई रणे वाल़ा इजी रा कदी परोसा नि करी सको था, कि बिरोदी ओर दुश्मण यरूशलेमो रे बड़े द्वारो दे कूसी सकणे। <verse eid="LAM 4:12" /><verse number="13" style="v" sid="LAM 4:13" />ये तेथो रे भविष्यबक्ता रे पाप ओर तेथो रे पुरोईता रे पापो रे कामो रिया बजा ते ऊआ; कऊँकि सेयो तेती तर्मिया री अत्या करदे आई रे। <verse eid="LAM 4:13" /><verse number="14" style="v" sid="LAM 4:14" />नबी ओर पुरोईत सड़का रे एड़े फिरोए मानो सेयो अन्दे ओ। कोई बी तिना खे छूओं नि था कऊँकि तिना रे टाल्लेया पाँदे काये दे लोका रे खूनो रे तब्बे लगी रे थे। <verse eid="LAM 4:14" /><verse number="15" style="v" sid="LAM 4:15" />जो लोक जिऊँदे थे सेयो जोरे की बोलोए, “आसा ते दूर रओ! तुसे अशुद्ध ए।” जेबे सेयो नठी की मारे-मारे फिरने लगे, तेबे दूजी जातिया रे लोके बोलेया, “तुसे एती नि रूकी सकदे।” <verse eid="LAM 4:15" /><verse number="16" style="v" sid="LAM 4:16" />सेओ लोक यहोवे आपणे रोषो रिया बजा ते तित्तर-बित्तर करीते, तेस तिना पाँदे फेर दया नि करनी; ना तो पुरोईता रा आदर ऊआ ओर ना बुजुर्गा पाँदे कोई दया कित्ती। <verse eid="LAM 4:16" /><verse number="17" style="v" sid="LAM 4:17" />म्हारी आखी बेकार ई मताद न्याल़दे-न्याल़दे थकी गिया, आसे लगातार एक एड़ी जातिया रिया तरफा खे ताकदे रये जो बचाई नि सकदी। <verse eid="LAM 4:17" /><verse number="18" style="v" sid="LAM 4:18" />लोक आसा पीछे एड़े पड़े कि आसे आपणे शईरो रे चौको दे पनि चली सके; म्हारा अन्त नेड़े आया; म्हारी उम्र पूरी ऊई; कऊँकि म्हारा अन्त आई गा था। <verse eid="LAM 4:18" /><verse number="19" style="v" sid="LAM 4:19" />सेयो लोक जो आसा पीछे पड़ी रे थे सेयो सर्गो रे उकाबा ते बी जादा तेज चलो थे; सेओ लोक पाह्ड़ा पाँदे आसा पीछे पड़ी गे ओर उजाड़ जगा दे आसा खे पकड़ने खे म्हारी ताका दे बैठीगे। <verse eid="LAM 4:19" /><verse number="20" style="v" sid="LAM 4:20" />म्हारा राजा, जो यहोवे चूणी ला था, सेई था जिने आसे जिऊँदे रणे जोगे बणाए से सेई था जेस पाँदे आसे परोसा कित्तेया था कि तेस आसे दूजे देशो री सेना ते बचाणे। पर से एड़ा पकड़ी ला जेड़े जानवरा खे खड्डे दे फसाओए। <verse eid="LAM 4:20" /><verse number="21" style="v" sid="LAM 4:21" />ओ एदोम देशो रे लोको जो ऊज देशो दे रओए तुसे एते गल्ला ते खुश ऊई सकोए कि आसा साथे क्या ऊणे लगी रा, पर यहोवे तुसा खे सजा देणी। तुसे नशे दे ऊई जाणे ओर बेज्जत ऊई जाणे कऊँकि तुसा रे दुश्मणे तुसा रे टाल्ले खोली ते दे। <verse eid="LAM 4:21" /><verse number="22" style="v" sid="LAM 4:22" />ओ सिय्योनो रे लोको, तुसा रे पापो री सजा खत्म ऊई, यहोवे तुसे फेर गुलामिया दे नि राखणे; पर ओ एदोमो रे लोको, तुसा रे पापो री सजा तेस तुसा खे देणी, तेस तुसारे पाप बताणे।<verse eid="LAM 4:22" /></para>
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="s">दया रिया तँईं प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="LAM 5:1" />ओ यहोवा, याद कर कि आसे कितणा दु:ख सईन करी राखेया ओर म्हारी मताद कर; ओ यहोवा म्हारी तरफा खे नजर करी की म्हारी बेज्जती देख! <verse eid="LAM 5:1" /><verse number="2" style="v" sid="LAM 5:2" />जमीना रा म्हारा इस्सा परदेशिया रा ऊईगा ओर म्हारे कअर परदेशिया रे ऊईगे रे। <verse eid="LAM 5:2" /><verse number="3" style="v" sid="LAM 5:3" />आसा रे दुश्मणे म्हारे बाओ काईते ओर आसे अनाथ ऊईगे; तिने म्हारी माया बिदुआ बणाई तिया दिया ए। <verse eid="LAM 5:3" /><verse number="4" style="v" sid="LAM 5:4" />आसे पाणी मोले लई की पिऊँए, आसा खे लकड़ू बी मोले मिलोए। <verse eid="LAM 5:4" /><verse number="5" style="v" sid="LAM 5:5" />दौड़ाणे वाल़े म्हारी क्याड़िया पाँदे टूटी की पड़ी रे; आसे थकी गे रे, आसा खे राम नि मिलदा। <verse eid="LAM 5:5" /><verse number="6" style="v" sid="LAM 5:6" />आसे जिऊँदे रणे खे खाणा लणे रिया तँईं आपू ई मिस्र ओर अश्शूरो रे वशो दे ऊईगे, ओर तेथो रे लोका रिया तँईं काम करने खे त्यार ऊईगे। <verse eid="LAM 5:6" /><verse number="7" style="v" sid="LAM 5:7" />म्हारे बुजुर्गे तेरे खलाफ पाप कित्तेया ओर सेओ मरी की राची गे; पर आसे से सजा पुगतणे लगी रे जो तिना री थी। <verse eid="LAM 5:7" /><verse number="8" style="v" sid="LAM 5:8" />बाबुलो रे अधिकारी जो पईले गुलाम थे, एबे आसा पाँदे राज करोए, ओर एड़ा कोई नि आ जो आसा खे तिना ते बचाई सको। <verse eid="LAM 5:8" /><verse number="9" style="v" sid="LAM 5:9" />कऊँकि उजाड़ जगा दे लोक तलवारा लई की कूमेया करोए, इजी री खातर जेबे आसे खाणे पीणे रिया चीजा लणे खे तेती जाऊँए, तो आसे आपणे प्राण खतरे दे पाऊँए। <verse eid="LAM 5:9" /><verse number="10" style="v" sid="LAM 5:10" />अकाल़ो रिया गर्मिया ते आसा रे शरीरो री चामड़ी बी चूल्ली जेड़ी गर्म ऊईगी री।<verse eid="LAM 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LAM 5:11" />आसा रे दुश्मणे सिय्योनो रे पाह्ड़ो पाँदे म्हारिया जवाणसा साथे गल़त काम कित्तेया, ओर तिने यहूदा रे शईरा रिया कुआँरिया बेटिया बी आपणे कब्जे दे करने खे मजबूर करी राखिया ए। <verse eid="LAM 5:11" /><verse number="12" style="v" sid="LAM 5:12" />परदान आथो रे पारे टाँगी ते रे ओर बुजुर्गा रा कोई आदर नि कित्तेया। <verse eid="LAM 5:12" /><verse number="13" style="v" sid="LAM 5:13" />तिने म्हारे जवान मर्द चाक्किया दे आटा पीसणे खे मजबूर करी राखे, ओर जेबे तिना ते पारी लकड़िया रा बोजा चकणे खे बोलेया जाओआ तेबे सेयो लड़खड़ाओए। <verse eid="LAM 5:13" /><verse number="14" style="v" sid="LAM 5:14" />आसा रे परदाना खे शईरो रे बड़े द्वारो पाँदे न्याय रिया तँईं मिली की बैठणे री अनुमति नि ए। ओर ना ई जवाना रे गीत सुणदे। <verse eid="LAM 5:14" /><verse number="15" style="v" sid="LAM 5:15" />आसे एबे खुश नि ए। पर आसे बऊत दु:खी ए, इजी री खातर एबे आसे ओर नि नाचदे। <verse eid="LAM 5:15" /><verse number="16" style="v" sid="LAM 5:16" />म्हारे सिरो पाँदला मुकुट छूटीगा रा;<note caller="+" style="f"><char style="fr" closed="false">5:16 </char><char style="ft" closed="false">सिय्योनो री महिमा खत्म ऊणे लगी री </char></note> आसा पाँदे हाय, कऊँकि आसे पाप कित्तेया! <verse eid="LAM 5:16" /><verse number="17" style="v" sid="LAM 5:17" />इजी बजा ते म्हारा मन कमजोर ऊईगा, इना गल्ला रिया बजा तेई म्हारिया आखी तुँदल़िया पड़ी गिया, <verse eid="LAM 5:17" /><verse number="18" style="v" sid="LAM 5:18" />आसे बऊत दु:खी ए कऊँकि तिने सिय्योनो रिया दवाला ओर कअर नाश करीते दे। एबे तिना पाँदे बणो रे जानवर गीदड़ चलोए। <verse eid="LAM 5:18" /><verse number="19" style="v" sid="LAM 5:19" />पर ओ यहोवा, तूँ तो सदा तक रणा; तेरा राज पीढ़ी-पीढ़ी तक बणेया दा रणा। <verse eid="LAM 5:19" /><verse number="20" style="v" sid="LAM 5:20" />ओ परमेशर, तैं आसे सदा खे कऊँ पुलाई ते ओर आसे बऊत बखतो तक कऊँ छाडी ते? <verse eid="LAM 5:20" /><verse number="21" style="v" sid="LAM 5:21" />ओ यहोवा, आसा खे आपणी तरफा खे आऊणे दे म्हारी मताद कर, तेबे आसे फेर सुदरी जाणे। आसा खे फेर तेड़ा ई जीवन जिऊँणे रा मौका दे जेड़ा आसे पईले जिऊँणे लगी रे थे। <verse eid="LAM 5:21" /><verse number="22" style="v" sid="LAM 5:22" />ओ यहोवा, आसे ये परोसा करूँए कि तैं आसे बिल्कुल त्यागी नि राखे ओर तूँ आसा ते बऊत जादा नराज नि आ।<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>