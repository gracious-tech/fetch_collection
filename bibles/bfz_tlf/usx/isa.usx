<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ISA" style="id" />
  <para style="h">यशायाह</para>
  <para style="toc1">यशायाह नबीए रे जरिये लिखी री कताब</para>
  <para style="toc2">यशायाह</para>
  <para style="toc3">यशा.</para>
  <para style="mt">यशायाह</para>
  <para style="mt2">यशायाह नबीए रे जरिये लिखी री कताब</para>
  <para style="is">भूमिका</para>
  <para style="ip">यशायाह री कताबा रा नाओं एक महान् नबीए रे नाओं पाँदे राखी राखेया ए, जो यीशु मसीह रे आऊणे ते 800 साल पईले उतरो रिया तरफा खे यरूशलेम शईरो दे रओ था। ये कताब तीऊँ खास इस्सेया दे बांडी जाई सकोई:</para>
  <para style="ip">
    <char style="it">पाठ <char style="xt"><ref loc="ISA 1-39">1-39</ref></char></char> दे तेस बखतो रे बारे दे बताओआ जेबे यहूदा, दखणा रे राज, खे आपणे एक पड़ोसी राज, अश्शूरो, ते खतरा पैदा ऊईगा था। यशायाहे ये देखेया कि यहूदा राज खे खतरा सिर्फ अश्शूरो ते ई नि आ, बल्कि यहूदी जातिया रे आपणे पाप, ओर परमेशरो री आज्ञा नि मानणा ओर तेस पाँदे परोसा नि करना ई वास्तविक खतरे री गल्ल थी। जिऊँदेया शब्दा ओर काम करी की नबीए लोका ओर तिना रे अगुवेया रे सामणे एक तार्मिक ओर सच्ची जिन्दगी जिऊँणे खे ललकारे, ओर तिना खे चतौणी दित्ती कि जे तुसे परमेशरो रिया गल्ला सुणने ते मुकरे तो एते रा नतीजा बऊत ई खतरनाक ऊणा। यशायाहे सारिया दुनिया दे शान्तिया रे एक बखतो ओर दाऊदो रे एक कुलो, जो एक आदर्श राजा ऊणा, रे आऊणे रे बारे दे भविष्यबाणी कित्ती थी।</para>
  <para style="ip">
    <char style="it">पाठ <char style="xt"><ref loc="ISA 40-55">40-55</ref></char></char> दे तेस बखतो री भविष्यबाणी ए जेबे यहूदा प्रदेशो रे बऊत सारे लोक बेबीलोनो दे गुलाम ऊई की चली गे थे, ओर बऊत ई नराश ओर दु:खी थे। नबीए ये घोषणा कित्ती थी कि परमेशरो आपणे लोका खे छुटकारा देणा ओर वापस आपणे कअरे यरूशलेम शईरो दे पऊँचाणे, ताकि सेयो एक नवीं जिन्दगी शुरू करी सको। इना पाठा री एक खास गल्ल ये बी ए कि परमेशर इतिआसो रा बी प्रभु ए।</para>
  <para style="ip">
    <char style="it">पाठ <char style="xt"><ref loc="ISA 56-66">56-66</ref></char></char> बीचे जादातर इस्से दे यरूशलेम शईरो दे वापस आऊणे वाल़ेया लोका रे बारे दे भविष्यबाणी ए, ओर तिना खे एसा गल्ला रा परोसा दलाणा जरूरी था कि परमेशरे जो वादा एते जातिया रे लोका साथे करी राखेया से तेस पक्का पूरा करना।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">चतौणिया ओर वादे <char style="ior"><ref loc="ISA 1:1-12:6">1:1-12:6</ref> </char></para>
  <para style="io1">जातिया-जातिया खे सजा <char style="ior"><ref loc="ISA 13:1-23:18">13:1-23:18</ref></char></para>
  <para style="io1">परमेशरो रे जरीये दुनिया रा न्याय <char style="ior"><ref loc="ISA 24:1-27:13">24:1-27:13</ref> </char></para>
  <para style="io1">ओर चतौणिया ओर वादे <char style="ior"><ref loc="ISA 28:1-35:10">28:1-35:10</ref> </char></para>
  <para style="io1">यहूदा रा राजा हिजकिय्याह ओर अश्शूरी <char style="ior"><ref loc="ISA 36:1-39:8">36:1-39:8</ref></char></para>
  <para style="io1">वादा ओर उमिदा रा सन्देश <char style="ior"><ref loc="ISA 40:1-55:13">40:1-55:13</ref></char></para>
  <para style="io1">चतौणिया ओर वादे <char style="ior"><ref loc="ISA 56:1-66:24">56:1-66:24</ref></char></para>
  <chapter number="1" style="c" sid="ISA 1" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1" />ये कताब आमोसो रे पाऊ यशायाह रे दर्शणो रे बारे दे बताओई। यहूदा और यरूशलेम शईरो रे जो कुछ ऊणे वाल़ा था, तेतेरे बारे दे परमेशरे यशायाह खे दखाया था। यशायाहे यो गल्ला तेबे देखिया थिया जेबे उज्जियाह, योताम, आहाज ओर हिजकिय्याह यहूदा प्रदेशो पाँदे राज करो थे।<verse eid="ISA 1:1" /></para>
  <para style="s">यहूदा री बगावत</para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 1:2" />ओ स्वर्ग सुण, ओर ओ तरती त्यान लगाई की सुण, कऊँकि परमेशर बोलोआ, “मैं बाल-बच्चेया रा पालण-पोषण कित्तेया ओर से बढ़ाए बी, पर तिने मा साथे बगावत कित्ती। <verse eid="ISA 1:2" /><verse number="3" style="v" sid="ISA 1:3" />बल़द तो आपणे मालको खे ओर गह्दा आपणे मालको रिया गवाईणी खे पछयाणोआ, पर इस्राएल माखे नि जाणदा, मेरी प्रजा सोच-बचार नि करदी।” <verse eid="ISA 1:3" /><verse number="4" style="v" sid="ISA 1:4" />हाय, ये जाति पापो साथे केड़ी परी री! ये समाज बुरे कामो साथे केड़ा लादी रा! एस कुलो रे लोक केड़े कुकर्मी ए, यो बाल-बच्चे केड़े बिगड़े रे ए! इने यहोवा छाडीता रा, इने इस्राएलो रा पवित्र परमेशर तुच्छ जाणी राखेया! यो पराये बणी की दूर ऊईगे रे। <verse eid="ISA 1:4" /><verse number="5" style="v" sid="ISA 1:5" />तुसे बगावत करी-करी की जादा मार कऊँ खाणा चाओए? तुसा रा सिर जख्मा साथे परी गा ओर तुसा रा मन दु:खो साथे परी रा। <verse eid="ISA 1:5" /><verse number="6" style="v" sid="ISA 1:6" />सिरो ते लई की पैरो तक कोई बमारी नि ए, बस बूड़ने रे ओर कोड़े री मारा रे नशाण ओर सड़े रे जख्म ए, जो ना दबाए, ना बाने और ना जैतूनो रा तेल लगाई की नरम कित्ते। <verse eid="ISA 1:6" /><verse number="7" style="v" sid="ISA 1:7" />तुसा रे यहूदा प्रदेशो री जमीन उजाड़ पड़ी री, तुसा रे शईर फूखी गे रे, तुसा रे डोरूआ खे परदेशी तुसा सामणे ई निगल़ने लगी रे, से परदेशिया ते नाश कित्ते रे देशो जेड़ा उजाड़ ए। <verse eid="ISA 1:7" /><verse number="8" style="v" sid="ISA 1:8" />ओर सिय्योनो री बेटी अंगूरा रे बगीचे री चूँगड़िया जेड़ी छाडी ती री, या काकड़िया रे डोरूआ री चूँगड़ी या केरे रे शईरो जेड़ी कल्ली खड़ी री। <verse eid="ISA 1:8" /><verse number="9" style="v" sid="ISA 1:9" />जे सेना रा यहोवा म्हारे थोड़े जे लोका खे बचायी की नि राखदा, तो आसे सदोम ओर गमोरा<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fq" closed="false">सदोम ओर गमोरा </char><char style="ft" closed="false">उत्प. 19 </char></note> जेड़े खत्म ऊई जाणे थे।<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">योएल 2:32, रोम. 9:29 </char></note> <verse eid="ISA 1:9" /><verse number="10" style="v" sid="ISA 1:10" />ओ सदोम शईरो रे न्यायियो, परमेशरो रा वचन सुणो! ओ गमोरा री प्रजा, म्हारे परमेशरो री शिक्षा पाँदे त्यान देयो। <verse eid="ISA 1:10" /><verse number="11" style="v" sid="ISA 1:11" />परमेशर बोलोआ, “तुसा रे बऊत सारे मेलबलि मेरे किजी कामो रे ए?” आऊँ तो खाडूआ री होमबलिया ते ओर पाल़े रे डांगरा री चर्बिया ते परेशान ऊईगा रा, आऊँ बाच्छूआ ते, पेडा रे बच्चे या बाकरेया रे खूनो ते खुश नि ऊँदा। <verse eid="ISA 1:11" /><verse number="12" style="v" sid="ISA 1:12" />तुसे जेबे आपणे मूँ माखे दखाणे खे आओए, तेबे ये कुण चाओआ कि तुसे मेरे आँगणो खे पैरा साथे केसो? <verse eid="ISA 1:12" /><verse number="13" style="v" sid="ISA 1:13" />बेकारो दे नज्जो री बलि दुबारा नि ल्याओ, माखे तूपो ते नफरत ई। नये चाँद ओर रामो रा दिन मानणा ओर सभा रा प्रचार करना, ये माखे बुरा लगोआ। बड़ी सभा साथे-साथे अनर्थ काम करना आऊँ सयीन नि करी सकदा। <verse eid="ISA 1:13" /><verse number="14" style="v" sid="ISA 1:14" />तुसा रे नये चाँद और ठराए रे त्योआर मानणे ते आऊँ जिऊए ते बैर राखूँआ, सेयो सब माखे बोज जे लगोए, आऊँ तिना खे सयीन करदा-करदा थकी गा रा। <verse eid="ISA 1:14" /><verse number="15" style="v" sid="ISA 1:15" />जेबे तुसे मेरी तरफा खे प्रार्थना करने खे आथ फैलाओ, तेबे मां तुसा ते मूँ फेरी लणा, तुसे चाए कितणी बी प्रार्थना करो, तेबे बी मां तुसा री नि सुणनी, कऊँकि तुसा रे आथ बेकसूर माणूंए रे खूने की रंगी रे जो तुसा रे जरीये मरी रा।<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">नीति. 1:28, मीका 3:4 </char></note> <verse eid="ISA 1:15" /><verse number="16" style="v" sid="ISA 1:16" />आपू खे तोई की पवित्र करो, मेरिया आखी रे सामणे ते आपणे बुरे काम दूर करो, आगो खे बुराई करना छाडी दो,<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">1 पत. 2:1, याकूब 4:8 </char></note> <verse eid="ISA 1:16" /><verse number="17" style="v" sid="ISA 1:17" />पलाई करना सीखो, अच्छाईया साथे न्याय करो, उपद्रविये खे सुदारो, अनाथो खे न्याय दलाओ, बिदुआ रा साथ देयो। <verse eid="ISA 1:17" /><verse number="18" style="v" sid="ISA 1:18" />परमेशर बोलोआ, “आओ, आसे आपू बीचे बईस करूँए, तुसा रे पाप चाए लाल रंगो रे ओ, तेबे बी सेयो बर्फा जेड़े सफेद ऊई जाणे ओर चाए सेयो गूड़े लाल रंगो रे ओ, तेबे बी सेयो ऊना जेड़े सफेद ऊई जाणे। <verse eid="ISA 1:18" /><verse number="19" style="v" sid="ISA 1:19" />जे तुसे आज्ञाकारी ऊई की मेरी मानो, <verse eid="ISA 1:19" /><verse number="20" style="v" sid="ISA 1:20" />तो तुसा एस देशो रिया अच्छे ते अच्छिया चीजा जो जमीन पैदा करोई खाणिया ओर जे तुसे मानोगे नि ओर बगावत करोगे, तो तुसे तलवारी साथे मरने, परमेशरो रा येई वचन ए।”<verse eid="ISA 1:20" /></para>
  <para style="s">पापो ते परेया रा यरूशलेम</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 1:21" />जो यरूशलेम शईर विश्वासो जोगा था से केड़ा व्याभिचारी ऊई गा रा! तिदे न्याय ओ था ओर तिदे तर्म ओ था, पर एबे तिदे अत्यारे ई रओए। <verse eid="ISA 1:21" /><verse number="22" style="v" sid="ISA 1:22" />तेरा चाँदी कूड़े जेड़ा ऊईगा रा, तेरे अंगूरा रा रस पाणी ऊईगा रा। <verse eid="ISA 1:22" /><verse number="23" style="v" sid="ISA 1:23" />तेबे परदान टीठ ओर चोरा साथे मिले दे ए। सेयो सारे के सारे रिश्वत खाणे वाल़े ओर पेंटा रे लाल़ची ए। सेयो अनाथा रा न्याय नि करदे ओर ना बिदुआ रा मुकद्दमा लणा पसन्द करोए। <verse eid="ISA 1:23" /><verse number="24" style="v" sid="ISA 1:24" />इजी बजा ते प्रभु सेना रे परमेशर, इस्राएलो रे शक्तिमानो री ये बाणी ए, “सुणो, मां आपणे दुश्मण दूर करी की शान्ति पाणी ओर आपणे बैरिया ते बदला लणा। <verse eid="ISA 1:24" /><verse number="25" style="v" sid="ISA 1:25" />मां तुसा पाँदे आथ बढ़ाई की तुसा री धातुआ रा मैल पूरी तरअ ते फूकी देणा ओर तुसा री अशुद्धता पूरी तरअ ते दूर करी देणी। <verse eid="ISA 1:25" /><verse number="26" style="v" sid="ISA 1:26" />मां तुसा बीचे पईलके जेड़े न्यायी ओर पुराणे बखतो जेड़े मंत्री फेर राखणे। तिजी ते बाद ताखे तर्मो रा ओर विश्वासो जोगा शईर बोलेया जाणा।” <verse eid="ISA 1:26" /><verse number="27" style="v" sid="ISA 1:27" />सिय्योन न्याय रे जरीये ओर जो तिदे फिरने सेयो तर्मो रे जरीये छुड़ाई लणे। <verse eid="ISA 1:27" /><verse number="28" style="v" sid="ISA 1:28" />पर बगावत करने वाल़ेया रा ओर पापिया रा कट्ठे नाश ऊणा ओर जिने परमेशर यहोवा छाडी राखेया, तिना रा अन्त ऊई जाणा। <verse eid="ISA 1:28" /><verse number="29" style="v" sid="ISA 1:29" />कऊँकि जिना पवित्र बाँजा रे डाल़ा री आराधना करने ते तुसे खुश ओए, तीजी खे करने ते तुसे शर्मिंदा ऊणे ओर जिना पवित्र बगीचेया दे तुसे मूर्तिया री पूजा करोए, तिना री बजा ते तुसा रे मूँ काल़े ऊणे। <verse eid="ISA 1:29" /><verse number="30" style="v" sid="ISA 1:30" />कऊँकि तुसे बाँजो रे डाल़ो रे मुरझाए रे पत्ते ओर बिना पाणिए रे बगीचे जेड़े ऊई जाणे। <verse eid="ISA 1:30" /><verse number="31" style="v" sid="ISA 1:31" />तुसारे तागतबर परदान सूकिया लकड़िया रे छोटे-छोटे टुकड़ेया जेड़े ऊई जाणे ओर तिना लोका काम करना, सेयो एड़े चिलुआ जेड़े ऊणे जिना ते आग लगी जाओई। सेयो तागतबर लोक ओर तिना रे काम बल़ने लगणे ओर कोई बी माणूं एड़ा नि ऊणा जो तेसा आगी खे रोकी सको।<verse eid="ISA 1:31" /></para>
  <chapter eid="ISA 1" />
  <chapter number="2" style="c" sid="ISA 2" />
  <para style="s">शान्तिया रा शईर</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1" />आमोसो रे पाऊ यशायाह रा वचन, जो तिने यहूदा प्रदेश ओर यरूशलेम शईरो रे बारे दे दर्शणो दे देखेया। <verse eid="ISA 2:1" /><verse number="2" style="v" sid="ISA 2:2" />आऊणे वाल़े दिना दे एड़ा ऊणा कि परमेशर यहोवे रे मन्दरो रा पाह्ड़ सबी पाह्ड़ा पाँदे मजबूत करेया जाणा ओर सबी पाह्ड़िया ते ऊच्चा करेया जाणा ओर हर जातिया रे लोक खाड्डा रे पाणिए जेड़े तेसरी तरफा खे चलणे। <verse eid="ISA 2:2" /><verse number="3" style="v" sid="ISA 2:3" />तेबे बऊत देशो रे लोक आऊणे ओर तिना आपू-बीचे बोलणा, “आओ, आसे यहोवे रे पाह्ड़ो पाँदे चढ़ी की, याकूबो रे परमेशरो रे मन्दरो रे जाऊँए, तेबे तेस आसा खे आपणी बाट सिखाणी ओर आसा तेसरी बाटा रे चलणा।” कऊँकि यहोवे रा बिधि-बिधान सिय्योनो ते ओर तेसरा वचन यरूशलेम शईरो ते निकल़ना। <verse eid="ISA 2:3" /><verse number="4" style="v" sid="ISA 2:4" />यहोवे जातिया-जातिया रा न्याय करना ओर देश-देशो रे लोका रे चगड़े मिटाणे और तिना आपणियां तलवारी कूटी की अल़ो रे फाल़े ओर भाल़ेया री दाचिया बनाणियां, तेबे एकी जातिया दूजी जातिया रे खलाफ फेर तलवार नि चलाणी, ना लोका आगो खे युद्ध बिद्या सिखणी।<verse eid="ISA 2:4" /></para>
  <para style="s">कमण्डिया रा नाश करी देणा।</para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 2:5" />ओ याकूबो रे कराने, आओ, आसे परमेशर यहोवे रे प्रयासे दे चलूँए।<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">इफि. 5:8, 1 यूह. 1:7 </char></note> <verse eid="ISA 2:5" /><verse number="6" style="v" sid="ISA 2:6" />यहोवा तैं आपणी प्रजा याकूबो रा कराना त्यागी ता रा, कऊँकि तिने आपणी जमीन पूर्बा रे देशा रे रीति रिवाजा ते परीता ओर पलिश्तिया जेड़ा जादू-टोणा करोए ओर सेयो मूर्तिपूजा करने वाल़ेया साथे मिली गे। <verse eid="ISA 2:6" /><verse number="7" style="v" sid="ISA 2:7" />इस्राएल देश चाँदी ओर सूईने साथे परेया राए और तिना रे राखे रे तअनो री कोई सीमा नि ए, तिना रा देश कोड़ेया साथे परेया राए ओर तिना रे रथ अणगिणत ए। <verse eid="ISA 2:7" /><verse number="8" style="v" sid="ISA 2:8" />तिना रा देश मूर्तिया साथे परेया राए; ओर सेयो आपणे आथो री बणाई री मूर्तिया री पूजा करोए। <verse eid="ISA 2:8" /><verse number="9" style="v" sid="ISA 2:9" />सारे माणूं नराश ऊणे, ओर बेज्जत ऊणे, इजी बजा ते ओ यहोवा तिना खे माफ नि कर! <verse eid="ISA 2:9" /><verse number="10" style="v" sid="ISA 2:10" />ओ माणूं, यहोवे रे डरो रिया बजा ते ओर तेसरे प्रतापो रिया बजा ते चट्टानी रे कूसी जा ओर माट्टिया रे टेरो दे लूकी जा।<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">प्रका. 6:15, लूक. 23:30 </char></note> <verse eid="ISA 2:10" /><verse number="11" style="v" sid="ISA 2:11" />कऊँकि माणूंए रिया कमण्डो साथे परी रिया आखी निठिया करी देणियां ओर माणूंआ रा कमण्ड दूर करेया जाणा ओर तेस न्याय रे दिने बस यहोवा ई ऊच्चिया जगा दे बैठेया दा रणा।<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">2 थिस्स. 1:9</char></note> <verse eid="ISA 2:11" /><verse number="12" style="v" sid="ISA 2:12" />कऊँकि सेना रे यहोवे रे चूणे रे दिने सब कमण्डी ओर ऊच्ची क्याड़िया वाल़ेया पाँदे ओर तरक्किया ते फूलणे वाल़ेया पाँदे आऊणा ओर सेयो चुकाए जाणे; <verse eid="ISA 2:12" /><verse number="13" style="v" sid="ISA 2:13" />लबानोनो रे सब देवदारा पाँदे जो ऊच्चे ओर बड़े ए; <verse eid="ISA 2:13" /><verse number="14" style="v" sid="ISA 2:14" />बासानो रे सारे बाँजो रे डाल़ा पाँदे और सारे ऊच्चे पाह्ड़ ओर पाह्ड़िया पाँदे; <verse eid="ISA 2:14" /><verse number="15" style="v" sid="ISA 2:15" />सारे ऊच्चे गुम्मटो ओर सारी मजबूत दवाला पाँदे, <verse eid="ISA 2:15" /><verse number="16" style="v" sid="ISA 2:16" />तर्शीश शईरो रे सारे बपारो रे जाह्जा ओर सुन्दर चित्रकारिया पाँदे यहोवे रे न्याय रा आओआ। <verse eid="ISA 2:16" /><verse number="17" style="v" sid="ISA 2:17" />माणूंआ रा कमण्ड मिटाई देणा और माणूंआ रा कमण्ड निठा करेया जाणा ओर तेस दिने बस यहोवा ई ऊच्चिया जगा रे बैठेया रा रणा। <verse eid="ISA 2:17" /><verse number="18" style="v" sid="ISA 2:18" />सारी मूर्तिया नाश ऊई जाणिया। <verse eid="ISA 2:18" /><verse number="19" style="v" sid="ISA 2:19" />जेबे यहोवा तरतिया खे थरथराणे खे उठणा, तेबे तेसरे डरो रिया बजा ते ओर तेसरे प्रतापो ते बचणे खे लोक गुफा दे, पाह्ड़ा री चट्टानी ओर जमीना दे खड्डे खणी की तिना दे लूकणे खे जाणे। <verse eid="ISA 2:19" /><verse number="20" style="v" sid="ISA 2:20" />तेस दिने लोका आपणी सूईने-चाँदिए रिया मूर्तिया जो तिने माथा टेकणे खे बणाईया थिया, चूए ओर चमगादड़ा रे सामणे सेटणियां, <verse eid="ISA 2:20" /><verse number="21" style="v" sid="ISA 2:21" />ओर जेबे यहोवा तरतिया खे थरथराणे खे उठणा, तेबे सेयो तेसरे डरो रिया बजा ते ओर तेसरे प्रतापो रे मारे चट्टानी री दरारा दे ओर पाह्ड़िया रे डवारा दे कूसी जाणे। <verse eid="ISA 2:21" /><verse number="22" style="v" sid="ISA 2:22" />इजी री खातर ये परोसा नि करो की लोका तुसे बचाणे, जिना रा साआ तेसरी नासा रे ए, कऊँकि तेसरी कीमत आई क्या ए?<verse eid="ISA 2:22" /></para>
  <chapter eid="ISA 2" />
  <chapter number="3" style="c" sid="ISA 3" />
  <para style="s">यहूदा प्रदेश ओर यरूशलेम शईरो रा न्याय</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 3:1" />सुणो, प्रभु सेना रे यहोवे यरूशलेम ओर यहूदा रा सबी प्रकारा रा साअरा ओर सरयाणा, मतलब नज्जो रे सारे आधार ओर पाणिए रे सारे आधार दूर करी देणे। <verse eid="ISA 3:1" /><verse number="2" style="v" sid="ISA 3:2" />तेस वीर ओर योद्धा, न्यायी ओर नबी, चूठी भविष्यबाणी करने वाल़े ओर स्याणे, पंजा सिपाईया रे सरदार ओर कुलो रे परदान, <verse eid="ISA 3:2" /><verse number="3" style="v" sid="ISA 3:3" />पंजा सिपाईया रे सरदार ओर उशयार कारीगर ओर जादू करने रे निपुण माणूं बी दूर करने। <verse eid="ISA 3:3" /><verse number="4" style="v" sid="ISA 3:4" />यहोवा आगे बोलोआ कि मां छोटे माठे तिना रे परदान करी देणे ओर यहूदा रे लोका रे बच्चेया तिना पाँदे राज करना। <verse eid="ISA 3:4" /><verse number="5" style="v" sid="ISA 3:5" />प्रजा रे लोका आपू बीचे एकी-दूजे पाँदे ओर हर एकी आपणे पड़ोसिये पाँदे अन्देर करना ओर जवान माणूंआ स्याणेया पाँदे ओर नीच माणूंआ जाणे माणे लोका साथे बुरा बर्ताओ करना। <verse eid="ISA 3:5" /><verse number="6" style="v" sid="ISA 3:6" />तेस बखते जेबे कोई माणूं आपणे बाओ रे कअरे आपणे पाईए खे पकड़ी की बोलोगा, तांगे तो टाल्ले ए, आओ म्हारा न्यायी ऊई जा ओर एस उजड़े रे देशो खे आपणे वशो दे करी दे। <verse eid="ISA 3:6" /><verse number="7" style="v" sid="ISA 3:7" />तेबे तेस दिने कसम खाई की बोलणा, “आऊँ ठीक करने वाल़ा नि ऊणा, कऊँकि मेरे कअरे ना तो रोटी ए ओर ना टाल्ले, इजी री खातर तुसे माखे प्रजा रा न्यायी नियुक्त नि करी सकदे।” <verse eid="ISA 3:7" /><verse number="8" style="v" sid="ISA 3:8" />यरूशलेम तो डगमगाया ओर यहूदा टल़ी गा, कऊँकि तिना रे वचन ओर तिना रे काम यहोवे रे खलाफ ए, जो तेसरी तेजोमय आखी सामणे बगावत करने वाल़े ठईरी रे। <verse eid="ISA 3:8" /><verse number="9" style="v" sid="ISA 3:9" />तिना री शक्ल बी तिना रे खलाफ गवाई देयो ई; सेयो सदोम शईरो दे रणे वाल़ेया लोका जेड़े आपू ई आपणे पापो रा बखान करोए ओर छुपांदे नि। तिना पाँदे हाय! कऊँकि तिने आपणा नुकशाण आपू ई करी राखेया। <verse eid="ISA 3:9" /><verse number="10" style="v" sid="ISA 3:10" />तर्मिया खे बोलो कि तिना रा पला ऊणा, कऊँकि तिना खे तिना रे कामो रा फल़़ मिलणा। <verse eid="ISA 3:10" /><verse number="11" style="v" sid="ISA 3:11" />पर दुष्टो पाँदे हाय! तेसरा बुरा ऊणा, कऊँकि तेसरे कामो रा फल़़ तेसखे मिलणा। <verse eid="ISA 3:11" /><verse number="12" style="v" sid="ISA 3:12" />एबे मेरी प्रजा पाँदे बच्चेया जेड़े अगुवे अन्देर करोए और जवाणसा तिना पाँदे राज करोईया। ओ मेरी प्रजा, तेरे अगुवे ताखे पटकाओए ओर तेरे चलणे री बाट पुलाई देओए।<verse eid="ISA 3:12" /></para>
  <para style="s">अन्याय री निंदा</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 3:13" />यहोवा देश-देशो रे लोका साथे मुकद्दमा लड़ने ओर तिना रा न्याय करने खे खड़ेया राए। <verse eid="ISA 3:13" /><verse number="14" style="v" sid="ISA 3:14" />यहोवा आपणी प्रजा रे स्याणेया साथे ओर परदाना साथे ये बईस करना चाओआ, “तुसेई बगीचे रे अंगूर खाए और शरीफ लोका रा तअन लूटी की तुसे आपणे कअरे राखी राखेया।” <verse eid="ISA 3:14" /><verse number="15" style="v" sid="ISA 3:15" />सेना रे परमेशर यहोवे री ये बाणी ए, “तुसे मेरी प्रजा खे कऊँ दल़ो ए ओर शरीफ लोका खे पीसोए?”<verse eid="ISA 3:15" /></para>
  <para style="s">सिय्योनो री कमण्डी जवाणस</para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 3:16" />यहोवा ये बी बोलेया, “कऊँकि सिय्योनो रिया जवाणसा<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="fq" closed="false">सिय्योनो रिया जवाणसा </char><char style="ft" closed="false">यरूशलेमो री जवाणसा </char></note> कमण्ड करोईया ओर सिर ऊच्चे करी की आखी मटकाओईया ओर कुँगरूआ खे छमछमांदी ऊईया ठुमक-ठुमक करी की चलोईया। <verse eid="ISA 3:16" /><verse number="17" style="v" sid="ISA 3:17" />इजी री खातर परमेशर यहोवे तिना रे सिर गँजे करने ओर यरूशलेमो दे रणे वाल़िया जवाणसा रा शरीर नांगा करना।” <verse eid="ISA 3:17" /><verse number="18" style="v" sid="ISA 3:18" />तेस बखते परमेशरो कुँगरू, जाल़िया, <verse eid="ISA 3:18" /><verse number="19" style="v" sid="ISA 3:19" />चँद्रआर, झुमके, कड़े, कूँडे, <verse eid="ISA 3:19" /><verse number="20" style="v" sid="ISA 3:20" />पगड़िया, पैकरिया, लको रा बान, खुशबूदार पांडे, ताबीज, <verse eid="ISA 3:20" /><verse number="21" style="v" sid="ISA 3:21" />छापा, बाल़ू, <verse eid="ISA 3:21" /><verse number="22" style="v" sid="ISA 3:22" />सुन्दर टाल्ले, कुर्तिया, चाद्दर, बटुए, <verse eid="ISA 3:22" /><verse number="23" style="v" sid="ISA 3:23" />शीशा, मलमलो रे टाल्ले, बुन्दिया, चादरु, इना सबी री शोभा दूर करनी। <verse eid="ISA 3:23" /><verse number="24" style="v" sid="ISA 3:24" />खुशबूआ रे बदले सड़यान, सुन्दर चादरुए रे बदले रस्सी, गूँदे रे बाल़ा रे बदले गँजापन, सुन्दर लको रे बानो रे बदले टाटा री पेटी ओर सुन्दरता रे बदले दाग ऊणे।<note caller="+" style="f"><char style="fr" closed="false">3:24 </char><char style="ft" closed="false">ये सब तेबे पईने जाओ थे जेबे कोई मरो था, या कोई दु:ख बताणा ओ था। उत्प. 37:34, 1 राज. 21:27, यहे. 7:18 </char></note> <verse eid="ISA 3:24" /><verse number="25" style="v" sid="ISA 3:25" />तेरे शईरो रे मर्द तलवारी साथे ओर शूरवीर युद्धो रे मारे जाणे। <verse eid="ISA 3:25" /><verse number="26" style="v" sid="ISA 3:26" />ओर सिय्योन शईरो रे बड़े द्वारो दे साआ परना ओर शोग करना ऊणा ओर से जमीना दे कल्ली बैठी दी रणी।<verse eid="ISA 3:26" /></para>
  <chapter eid="ISA 3" />
  <chapter number="4" style="c" sid="ISA 4" />
  <para style="s">सिय्योन रा नवां बणना</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 4:1" />तेस दिने जेबे शईरो रे सारे मर्द काई देणे ओर गुलामिया दे लई जाणे, ओर जो कुछ तेती जिऊँदे बचणे तिना ते तिना साता-साता जवाणसा एकी-एकी मर्दो खे आथ जोड़ी की बोलणा, “रोटी तो आसा आपणी ई खाणी ओर टाल्ले बी आपणे ई पईनणे, तेरी कमाई नि आसा खाणी, बस आसा खे आपणी लाड़िया बणाई लो, ओर म्हारी कुआँरिया ऊणे री बेज्जती दूर कर।” <verse eid="ISA 4:1" /><verse number="2" style="v" sid="ISA 4:2" />तेस बखते इस्राएलो रे बचे दे लोका खे यहोवे री डाल़ी, गईणे ओर महिमा ठईरना ओर जमीना री उपज, बडयाई ओर शोभा ठईरनी।<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="ft" closed="false">यिर्म. 23:5, यशा. 27:6, यूह. 1:14 </char></note> <verse eid="ISA 4:2" /><verse number="3" style="v" sid="ISA 4:3" />जो कोई सिय्योनो रे बचेया रा रओगा, ओर यरूशलेम शईरो रे रओ, मतलब यरूशलेम शईरो रे जितणेया रे नाओं जिन्दगिया री पर्चिया रे लिखी ते रे, तिना खे पवित्र बोलेया जाणा।<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">प्रका. 17:8, प्रका. 20:15 </char></note> <verse eid="ISA 4:3" /><verse number="4" style="v" sid="ISA 4:4" />ये तेबे ऊणा, जेबे परमेशर न्याय करने वाल़ी ओर फूकणे वाल़ी आत्मा रे जरीये सिय्योनो रे लोका रा मैल तोई चुकणा ओर यरूशलेम शईरो रे खूनो खे दूर करी चुकोगा।<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">आगी ते न्याय करना </char></note> <verse eid="ISA 4:4" /><verse number="5" style="v" sid="ISA 4:5" />तेबे यहोवे सिय्योन पाह्ड़ो रे एक-एक कअरो पाँदे ओर तेथो रे सभा री जगा पाँदे, दिने तो तुएँ रा बादल़ ओर राथियो खे लूपिया वाल़ी आगी रा प्रयासा बनाणा ओर सारे यरूशलेम शईरो रे वैभवो पाँदे परमेशरो री महिमा रा एक मण्डप छाया दा रणा। <verse eid="ISA 4:5" /><verse number="6" style="v" sid="ISA 4:6" />से दिन तूपा ते बचाणे खे ओर पऊण-चूखाने ते ओर बर्खा ते बचाणे खे एक शरण ओर लूकणे री जगा ऊणा।<verse eid="ISA 4:6" /></para>
  <chapter eid="ISA 4" />
  <chapter number="5" style="c" sid="ISA 5" />
  <para style="s">नकम्मा अंगूरा रा बगीचा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 5:1" />एबे मां आपणे प्यारे दोस्त परमेशरो खे</para>
  <para style="q" vid="ISA 5:1">ओर तेसरे अंगूरा रे बगीचे रे बारे दे गीत गाणा,</para>
  <para style="q" vid="ISA 5:1">एक बऊत उपजाऊ टीले पाँदे मेरे परमेशरो रा एक अंगूरा रा बगीचा था।<verse eid="ISA 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 5:2" />तिने तेथो री माट्टी खणी ओर तेतेरे पात्थर कट्ठे करी की तिदे अच्छे अंगूरा रा एक बगीचा लगाया,</para>
  <para style="q" vid="ISA 5:2">तेते बीचे तिने एक गुम्मट बणाया ओर अंगूरा रे रसो खे एक कुण्ड बी खणेया,</para>
  <para style="q" vid="ISA 5:2">तेबे तिने अंगूरा री उम्मीद कित्ती, पर तिदे नकम्मे अंगूर ई निकल़े।<verse eid="ISA 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 5:3" />एबे मेरा दोस्त यहोवा ये बोलोआ, ओ यरूशलेम शईरो रे रणे वाल़ेयो ओर ओ यहूदा रे माणूंओ,</para>
  <para style="q" vid="ISA 5:3">मां ओर मेरे अंगूरा रे बगीचे बीचे न्याय करो।<verse eid="ISA 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 5:4" />मेरे अंगूरा रे बगीचे खे ओर क्या करना रयी गा जो मैं तेसरिया तँईं नि कित्तेया ऊगा?</para>
  <para style="q" vid="ISA 5:4">तेबे क्या बजा ए कि जेबे मैं अंगूरा री उम्मीद कित्ती, तेबे तिदे नकम्मे अंगूर लगे?<verse eid="ISA 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 5:5" />एबे आऊँ ताखे बताऊँआ कि मां आपणे अंगूरा रे बगीचे साथे क्या करना।</para>
  <para style="q" vid="ISA 5:5">मां तिजी रा कांडेया वाल़ा बाड़ पट्टी देणा, ताकि पशु तिजी खे खाई सको,</para>
  <para style="q" vid="ISA 5:5">मां तेतेरी रक्षा करने वाल़ी दवाल टाल़ी देणी, ताकि पशु तिजी खे केसी सको।<verse eid="ISA 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 5:6" />मां अंगूरा रा बगीचा उजाड़ी देणा, से ना तो फेर छाँटणी और ना खणनी और तिदे कई प्रकारा रे कांडेवाल़े डाल़ जमणे,</para>
  <para style="q" vid="ISA 5:6">मां बादल़ा खे बी आज्ञा देणी कि तेती पाँदे नि बरसणा।<verse eid="ISA 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 5:7" />कऊँकि सेना रे यहोवे रा अंगूरा रा बगीचा इस्राएलो रा कराना और तेसरा अच्छा पौधा यहूदा रे लोक ए</para>
  <para style="q" vid="ISA 5:7">और तिना बीचे तिने न्याय री उम्मीद कित्ती, पर अन्याय दिशेया,</para>
  <para style="q" vid="ISA 5:7">तिना बीचे तर्मो री उम्मीद कित्ती, पर तेथा ते चींगणा ई सुणेया!<note caller="+" style="f"><char style="fr" closed="false">5:7 </char><char style="ft" closed="false">पज. 80:8, मत्ती 3:8-10 </char></note><verse eid="ISA 5:7" /></para>
  <para style="s">यहूदा रे पापा री निन्दा</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 5:8" />लाणत ए तिना पाँदे जो कअरो ते कअर और डोरूए ते डोरू एथो तक मिलांदे जाओए कि कोई जगा नि बचदी, ताकि तुसे देशो बीचे कल्ले रयी जाओ। <verse eid="ISA 5:8" /><verse number="9" style="v" sid="ISA 5:9" />सेना रे यहोवे मेरी सुणी की बोली राखेया, “पक्का बऊत सारे कअर सुनसाण ऊई जाणे ओर बड़े-बड़े ओर सुन्दर कअर ऊजड़ पड़ी जाणे।<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">आमो. 6:11, मत्ती 26:38 </char></note> <verse eid="ISA 5:9" /><verse number="10" style="v" sid="ISA 5:10" />कऊँकि ऊँताल़ी बीघे दे जम्मणे वाल़ी अंगूरा री बेला ते सिर्फ बाई लीटर शराब मिलणी ओर 100 किलो बीजो बीचा ते सिर्फ 10 किलो नज्ज ई मिलणा।” <verse eid="ISA 5:10" /><verse number="11" style="v" sid="ISA 5:11" />लाणत ए तिना पाँदे जो प्यागा तड़के उठी की शराब पीणे लगोए ओर बड़ी रात तक शराब पींदे रओए, जदुओ तक तिना खे गर्मी नि चढ़ी जाओ! <verse eid="ISA 5:11" /><verse number="12" style="v" sid="ISA 5:12" />तिना री पाट्टिया रे बीणा, सारंगी, डफ, बँसरी ओर शराब, यो सब मिलोए, पर सेयो यहोवे रे कामो रिया तरफा खे नि देखदे ओर तेसरे आथो रे कामो खे नि देखदे। <verse eid="ISA 5:12" /><verse number="13" style="v" sid="ISA 5:13" />इजी री खातर मेरे लोक मेरे बारे दे ज्ञान ना ऊणे रिया बजा ते गुलामिया दे जाणे। तेसरे इज्जतदार मर्द पूखे मरोए ओर आम लोक त्यायी साथे बेचैन ओए। <verse eid="ISA 5:13" /><verse number="14" style="v" sid="ISA 5:14" />इजी री खातर अधलोके बऊत लाल़च करी की आपणा मूँ अदो ते जादा खोलेया ओर तिना रा वैभव ओर पीड़-पड़ाका ओर खुशी करने वाल़े सारे के सारे तेसरे मुंए रे जाई की पड़ोए।<verse eid="ISA 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 5:15" />आम माणूं दबाए जाओए ओर बड़े माणूं नीच करे जाओए ओर कमण्डिया री आखी निठिया करिया जाओईया। <verse eid="ISA 5:15" /><verse number="16" style="v" sid="ISA 5:16" />पर सेना रा यहोवा न्याय करने रिया बजा ते महान ठईरोआ पवित्र परमेशर तर्मी ऊणे रिया बजा ते पवित्र ठईरोआ। <verse eid="ISA 5:16" /><verse number="17" style="v" sid="ISA 5:17" />तेबे पेडा रे बच्चे मानो आपणे डोरूए दे चरने, पर तगड़ेया री ऊजड़ जगा परदेशिया खे चराणे खे मिलणी। <verse eid="ISA 5:17" /><verse number="18" style="v" sid="ISA 5:18" />लाणत ए तिना पाँदे जो पापो खे बुराईया री रस्सिया साथे ओर बुरे कामो खे मानो गडिया रे रस्सेया ते खींजी की लई जाओए। <verse eid="ISA 5:18" /><verse number="19" style="v" sid="ISA 5:19" />ओर तुसे बोलोए, “इस्राएलो रे पवित्र परमेशरो खे तेसरी योजना फटाफट पूरी करने देयो, ओर जो तिने बोली राखेया तिजी खे पूरा करो, ताकि आसे तिना खे आपू देखूँ!” <verse eid="ISA 5:19" /><verse number="20" style="v" sid="ISA 5:20" />लाणत ए तिना पाँदे जो बुरे खे खरा ओर खरे खे बुरा बोलोए, जो न्हेरे खे प्रयासा ओर प्रयासे खे न्हेरा बोलोए ओर कड़ुए खे मीठा ओर मीठे खे कड़ुआ करी की मानोए! <verse eid="ISA 5:20" /><verse number="21" style="v" sid="ISA 5:21" />लाणत ए तिना पाँदे जो आपणी नजरा रे ज्ञानी ओर अक्लमंद ए!<note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="ft" closed="false">नीति. 3:7, 26:12, रोम. 12:16 </char></note> <verse eid="ISA 5:21" /><verse number="22" style="v" sid="ISA 5:22" />लाणत ए तिना पाँदे जो शराब पीणे रे वीर ओर शराबो खे तेज बनाणे रे बहादूर ए, <verse eid="ISA 5:22" /><verse number="23" style="v" sid="ISA 5:23" />जो न्यायी रिश्वत लई की दुष्टा खे निर्दोष ओर निर्दोषा खे दोषी ठराओए! <verse eid="ISA 5:23" /><verse number="24" style="v" sid="ISA 5:24" />इजी बजा ते जिंयाँ आगी री लूपी ठूँठो खे फूकी देओई ओर सूका काआ फूखी की स्वा बणी जाओआ, तिंयाँ ई तिना री जड़ सड़ी जाणी ओर तिना रे फूल तूड़ बणी की उडी जाणे, कऊँकि तिने सेना रे परमेशर यहोवे रे बिधि-बिधानो खे नकम्मा जाणेया ओर इस्राएलो रे पवित्र परमेशरो रा वचन तुच्छ जाणेया। <verse eid="ISA 5:24" /><verse number="25" style="v" sid="ISA 5:25" />इजी बजा ते यहोवे रा रोष आपणी प्रजा पाँदे पड़की रा ओर तिने तिना रे खलाफ आथ बढ़ाई की सेयो काई राखे ओर पाह्ड़ थरथराईगे ओर लोका री लाशा सड़का बीचे कूड़े जेड़िया पड़ी रिया। इतणा ऊणे ते बी तेसरा रोष शान्त नि ऊआ ओर तिने सजा देणे खे आपणा आथ आगे बढ़ेया राए। <verse eid="ISA 5:25" /><verse number="26" style="v" sid="ISA 5:26" />यहोवे दूरो-दूरो रिया जातिया रिया तँईं चण्डा खड़ा करना ओर सिटी बजाई की सेयो तरतिया रे कूणे ते बुलाणे; देखो, सेयो फटाफट तेज दौड़ी की यरूशलेमो खे आऊणे! <verse eid="ISA 5:26" /><verse number="27" style="v" sid="ISA 5:27" />तिना दुश्मणा बीचा ते कोई बी थकेया नि, ना कोई ठोकर खाओआ, कोई सऊणे वाल़ा नि ए, केसी रे लको रा बान नि खुली रा ओर केसी रे जोड़ेया रा बान नि टूटेया। <verse eid="ISA 5:27" /><verse number="28" style="v" sid="ISA 5:28" />तिना रे तीर तेज ओर धनुष चढ़ाए रे ए, तिना रे कोड़ेया रे खुर आथिया जेड़े ओर रथो रे टईर तूफानो जेड़े ए। <verse eid="ISA 5:28" /><verse number="29" style="v" sid="ISA 5:29" />दुश्मण सिपाई जवान शेरो जेड़े गरजोए, सेयो गुर्राई की शिकार पकड़ी लओए ओर तिजी खे लई की नठी जाओए ओर कोई शिकारो खे तिना ते नि छुड़ांदा। <verse eid="ISA 5:29" /><verse number="30" style="v" sid="ISA 5:30" />तेस बखते सेयो तिना इस्राएलो पाँदे एड़े गरजणे जिंयाँ समुद्र गरजोआ ओर जे कोई देशो रिया तरफा खे देखोगा, तो तेसखे न्हेरा ओर मुसीबत दिशणी ओर ज्योति बादल़ा की लूकी जाणी।<verse eid="ISA 5:30" /></para>
  <chapter eid="ISA 5" />
  <chapter number="6" style="c" sid="ISA 6" />
  <para style="s">यशायाह खे बुलाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1" />आऊँ दसुआ कि एक दिन क्या ऊआ जेस साले यहूदा प्रदेशो रा राजा उज्जियाह मरेया, मैं परमेशर बऊत ई ऊच्चे सिंहासनो पाँदे बैठेया रा देखेया ओर तेसरे टाल्ले रे केरे ते मन्दर परी गा।<note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="ft" closed="false">प्रका. 4:2,6, मत्ती 25:3, प्रका. 7:10</char></note> <verse eid="ISA 6:1" /><verse number="2" style="v" sid="ISA 6:2" />तेसते पाँदले कनारे साराप<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fq" closed="false">साराप </char><char style="ft" closed="false">गुस्से वाल़े स्वर्गदूत </char></note> दिशे, तिना रे छे-छे पंख थे, तिने दूई पंखा साथे आपणा मूँ टखी राखेया था, दूई साथे आपणे पैर ओर दूई साथे उडने लगी रे थे। <verse eid="ISA 6:2" /><verse number="3" style="v" sid="ISA 6:3" />ओर सेयो एकी-दूजे खे आका पायी-पायी की गाणे लगी रे थे, “सेना रा यहोवा पवित्र, पवित्र, पवित्र ए; सारी तरती तेसरे तेजो ते परी रिये ए।”<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">प्रका. 4:8, प्रका. 15:8 </char></note> <verse eid="ISA 6:3" /><verse number="4" style="v" sid="ISA 6:4" />ओर तिना रे आका पाणे ते देऊल़ी रिया निऊँआ ईलणे लगिया ओर मन्दर तुएँ साथे परी गा। <verse eid="ISA 6:4" /><verse number="5" style="v" sid="ISA 6:5" />तेबे मैं चींगदे ऊए बोलेया, “हाय! हाय! आऊँ नाश ऊईगा, कऊँकि आऊँ अशुद्ध ओठ वाल़ा माणूं ए ओर आऊँ अशुद्ध ओठवाले माणूंआ बीचे रऊँआ, कऊँकि मैं सेना रा यहोवा महाराजाधिराज आपणी आखी साथे देखी राखेया!” <verse eid="ISA 6:5" /><verse number="6" style="v" sid="ISA 6:6" />तेबे एक साराप आथो रे फेऊ लई की, जो तिने चिमटे साथे बेदिया पाँदा ते चकेया था, मांगे उडी की आया। <verse eid="ISA 6:6" /><verse number="7" style="v" sid="ISA 6:7" />तिने तिजी साथे मेरा मूँ छुँईं की बोलेया, “देख, इने तेरा ओठ छुँईं ला रा, इजी री खातर तेरे बुरे काम दूर ऊईगे ओर तेरे पाप माफ ऊईगे।” <verse eid="ISA 6:7" /><verse number="8" style="v" sid="ISA 6:8" />तेबे मैं परमेशरो रा ये वचन सुणेया, “आऊँ केसखे पेजूँ ओर म्हारी तरफा ते कुण जाणा?” तेबे मैं ज्वाब दित्तेया, “आऊँ एती ए! माखे पेज।” <verse eid="ISA 6:8" /><verse number="9" style="v" sid="ISA 6:9" />यहोवे मांते बोलेया, “जा, ओर इना इस्राएलो रे लोका खे बोल, सुणदे ई रओ, पर समजो नि, देखदे ई रओ, पर बूजो नि।” <verse eid="ISA 6:9" /><verse number="10" style="v" sid="ISA 6:10" />तेबे तिने माखे बोलेया, “तूँ इना लोका रे मन मोटे ओर इना रे काना खे पारी करी दे ओर इना रिया आखी बन्द करी दे, एड़ा नि कि सेयो आखी साथे देखो ओर कानो साथे सुणो ओर मनो ते बूजो ओर मन फिराओ ओर ठीक ऊई जाओ।”<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">मत्ती 13:15, यूह. 12:40, प्रेरि. 28:26,27, रोम. 11:8 </char></note> <verse eid="ISA 6:10" /><verse number="11" style="v" sid="ISA 6:11" />तेबे मैं यहोवे ते पूछेया, “ओ परमेशर, कदुओ तक?” तिने बोलेया, “जदुओ तक शईर नि उजड़ो ओर तिना रे कोई नि रयी जाओ ओर कअरा रे कोई माणूं नि रयी जाओ ओर देश उजाड़ ओर सुनसाण ऊई जाओ, <verse eid="ISA 6:11" /><verse number="12" style="v" sid="ISA 6:12" />ओर यहोवा माणूंआ खे तेथा ते दूर करी देयो ओर देशो री कई जगा ऊजड़ ऊई जाओ। <verse eid="ISA 6:12" /><verse number="13" style="v" sid="ISA 6:13" />चाए तेथो रे रणे वाल़ेया रा दसुआ इस्सा बी रयी जाओ, तेबे बी तिना दुबारा अमला करना ओर फूकी देणे, पर जेड़े छोटे या बड़े बाँजा रे डाल़ बाडणे ते बाद बी ठूँठ बणेया रा रओआ, तिंयाँ ई पवित्र इस्सा तेसरा इस्सा ठईरना।”<verse eid="ISA 6:13" /></para>
  <chapter eid="ISA 6" />
  <chapter number="7" style="c" sid="ISA 7" />
  <para style="s">राजा आहाजो रिया तँईं सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1" />जेबे योतामो रा पाऊ ओर उज्जियाह रा पोता राजा आहाज यहूदा पाँदे राज करो था, तेसरे दिना दे अरामो रे राजा रसीन ओर इस्राएलो रे राजा रमल्याह रे पाऊ पेकहे यरूशलेम शईरो साथे लड़ने खे चढ़ाई कित्ती, पर सेयो युद्ध नि जीती सके। <verse eid="ISA 7:1" /><verse number="2" style="v" sid="ISA 7:2" />जेबे दाऊदो रे कराने खे ये सन्देश मिलेया कि अरामिये एप्रैमिया साथे समजौता करी ला रा, तेबे तेसरा ओर प्रजा रा मन बी एड़ा इल्ली गा, जेड़े बणो रे डाल़ अवा लगणे ते ईलोए।<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">दाऊदो रा कराना दाऊदो रे वंशो रे आहाजो खे बताओआ, जो यहूदा रा राजा बणीगा था। </char></note> <verse eid="ISA 7:2" /><verse number="3" style="v" sid="ISA 7:3" />तेबे यहोवे यशायाह खे बोलेया, “आपणे पाऊ शार्याशूबो खे लई की तोबिया रे डोरूआ री सड़का ते पाँदले पोखरे री नाल़िया रे सिरे पाँदे राजा आहाजो साथे मिलणे खे जा।” <verse eid="ISA 7:3" /><verse number="4" style="v" sid="ISA 7:4" />तेबे तेसखे बोल, “सावधान ओर शान्त ऊई जा ओर तिना दुँईं तुआँ निकल़दे ऊए लकड़ूआ ते, मतलब रसीन ओर अरामिया रे पड़के रे रोषो ते ओर रमल्याह रे पाऊए ते नि डर ओर ना कबरा। <verse eid="ISA 7:4" /><verse number="5" style="v" sid="ISA 7:5" />कऊँकि अरामी और रमल्याह रे पाऊआ समेत एप्रैमिये ये बोली की तेरे खलाफ बुरी साजिश करने री सोची राखी कि आओ, <verse eid="ISA 7:5" /><verse number="6" style="v" sid="ISA 7:6" />आसे यहूदा पाँदे अमला करी की तिना पाँदे कब्जा करी देऊँए ओर तेस पाँदे ताबेलो रे पाऊए खे राजा नियुक्त करी देऊँए। <verse eid="ISA 7:6" /><verse number="7" style="v" sid="ISA 7:7" />इजी री खातर यहोवे ईंयाँ बोली राखेया कि ये साजिश ना तो सफल ऊणी ओर ना पूरी। <verse eid="ISA 7:7" /><verse number="8" style="v" sid="ISA 7:8" />सेयो तितणे तागतबर नि ए जितणे लगोए कऊँकि अरामो रा सिर दमिश्क ओर दमिश्को रा सिर रसीन ए। तेबे एप्रैमो रा सिर शोमरोन ओर शोमरोनो रा सिर रमल्याह रा पाऊ ए। <verse eid="ISA 7:8" /><verse number="9" style="v" sid="ISA 7:9" />पैंठ साला ते पीतरे एप्रैमो री तागत इतणी टूटी जाणी कि से जाति बणी री नि रणी। जे तुसे लोक एसा गल्ला रा परोसा नि करो, तो पक्का तुसे स्थिर नि रणे।”<verse eid="ISA 7:9" /></para>
  <para style="s">इम्मानुएलो रा नशाण</para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10" />बादो ते यहोवे माखे राजा आहाजो खे बोलणे खे एक ओर सनेआ दित्तेया, <verse eid="ISA 7:10" /><verse number="11" style="v" sid="ISA 7:11" />“आपणे परमेशर यहोवे ते कोई नशाण माँग; चाए से डूगी जगा रा ओ या ऊबे सर्गो रा ओ।” <verse eid="ISA 7:11" /><verse number="12" style="v" sid="ISA 7:12" />आहाजे बोलेया, “आऊँ नि मांगी सकदा ओर मां यहोवे री परीक्षा नि करनी।” <verse eid="ISA 7:12" /><verse number="13" style="v" sid="ISA 7:13" />तेबे तिने बोलेया, “ओ राजा दाऊदो रे कराने रे लोको सुणो! क्या तुसा माणूंआ खे परेशान करना छोटी गल्ल समजी की क्या एबे मेरा परमेशर बी परेशान करना? <verse eid="ISA 7:13" /><verse number="14" style="v" sid="ISA 7:14" />इजी बजा ते यहोवे आपू ई तुसा खे एक नशाण देणा। सुणो, एक कुआँरी गर्भवती ऊणी ओर तेसा रे पाऊ ऊणा ओर तेसा तेसरा नाओं इम्मानुएल<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">मतलब परमेशर आसा साथे ए </char></note> राखणा।<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">मत्ती 1:23, लूक. 1:31 </char></note> <verse eid="ISA 7:14" /><verse number="15" style="v" sid="ISA 7:15" />ओर जदुओ तक से बुरे खे छाडणा ओर खरे खे मानणा नि जाणी लओगा, तदुओ तक तेस नऊणीं ओर सयीत खाणा। <verse eid="ISA 7:15" /><verse number="16" style="v" sid="ISA 7:16" />कऊँकि तिजी ते पईले कि से पाऊ बुरे खे छाडणा ओर खरे खे मानणा जाणी लओ, से देश जेतेरे दुँईं राजेया ते तूँ डरने लगी रा, उजाड़ ऊई जाणा।<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">ये सीरिया ओर एप्रैम नाओं रे दो देश थे, जिना रे दो राजा थे, रसीन ओर पेकह, जिना ते आहाज डरो था। </char></note> <verse eid="ISA 7:16" /><verse number="17" style="v" sid="ISA 7:17" />ओर तुसा रे देशो दे यहोवे तां पाँदे, तेरी प्रजा पाँदे ओर तेरे बाओ रे कराने पाँदे एड़े दिन ल्याऊणे कि जदुओ ते एप्रैम यहूदा ते लग ऊईगा, तदुओ ते एड़े दिन कदी नि आए, मतलब अश्शूरो रे राजे रे दिन।” <verse eid="ISA 7:17" /><verse number="18" style="v" sid="ISA 7:18" />तेस बखते यहोवे सेयो पँऊरी रिया माक्खिया जो मिस्रो री नदिया रे सिरे पाँदे रओईया ओर सेयो पऊँरी जो अश्शूरो रे देशो दे रओईया, सीटी बजाई की बुलाणियां। <verse eid="ISA 7:18" /><verse number="19" style="v" sid="ISA 7:19" />तेबे दुश्मण सेना सारिया की सारिया एस देशो रे पाह्ड़ी नाल़े दे ओर चट्टानी री दरारा दे ओर सारे कांडेया ओर सबी चराईया पाँदे बैठी जाणिया। <verse eid="ISA 7:19" /><verse number="20" style="v" sid="ISA 7:20" />जेबे से बखत आऊणा, तेबे परमेशरो फरात नदिया रिया रे पारले कनारे ते एक नाई कैंची लई की बुलाणा, जो अश्शूरो रा राजा ए, यहोवे यहूदा रे लोक पूरी तरआ ते बेज्जत करने। <verse eid="ISA 7:20" /><verse number="21" style="v" sid="ISA 7:21" />तेस दिने एड़ा ऊणा कि माणूंए एक गाय ओर दो पेडा पाल़नियां। <verse eid="ISA 7:21" /><verse number="22" style="v" sid="ISA 7:22" />ओर तिना इतणा दूद देणा कि तेस नऊणीं खाया करनी; कऊँकि जितणे एती देशो रे रयी जाणे, तिना सबी नऊणीं ओर सयीत खाया करना। <verse eid="ISA 7:22" /><verse number="23" style="v" sid="ISA 7:23" />तेस बखते जिना-जिना जगा रे 1,000 चाँदिए रे सिक्केया रिया ह्जार अंगूरा री बेला ए, तिना सबी जगा रे कांडे ई कांडेवाल़े डाल़ ऊणे।<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">शेकेल चीजा खे तोलणे खे इस्तेमाल कित्तेया जाणे वाल़ा एक नाप था। एकी शेकेलो रा बजन लगभग 11 ग्राम चाँदी ओ था। एती 11,000 ग्राम चाँदी था। </char></note> <verse eid="ISA 7:23" /><verse number="24" style="v" sid="ISA 7:24" />सब लोक तेती तीर ओर धनुष लई की जाया करने, कऊँकि सारे देशो रे कांडेवाल़े डाल़ ऊई जाणे। <verse eid="ISA 7:24" /><verse number="25" style="v" sid="ISA 7:25" />ओर जितणे पाह्ड़ फरूए साथे खणे जाओए, तिना सबी रे कांडेवाल़े डाल़ा रे डरो रे मारे कोई नि जाणा, सेयो पाह्ड़ गाय-बल़दा खे चरने खे ओर पेडा-बाकरिया खे केसणे खे ऊणे।<verse eid="ISA 7:25" /></para>
  <chapter eid="ISA 7" />
  <chapter number="8" style="c" sid="ISA 8" />
  <para style="s">यशायाह रा पाऊ: लोका रिया तँईं एक नशाण</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1" />केसी ओरी दिने यहोवे माखे बोलेया, “एक बड़ी फटी लई की तिदे परेगे की सान अक्षरा रे ये लिख: महेर्शालाल्हाशबजो रिया तँईं।<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="fq" closed="false">महेर्शालाल्हाशबजो रिया तँईं। </char><char style="ft" closed="false">जल्दी लुटणे-जल्दी लुटणे </char></note>” <verse eid="ISA 8:1" /><verse number="2" style="v" sid="ISA 8:2" />तेबे मां विश्वासो जोगे मर्द मतलब ऊरिय्याह पुरोईत ओर जेबेरेक्याह रा पाऊ जकर्याह एते गल्ला रे गवाह् करने। <verse eid="ISA 8:2" /><verse number="3" style="v" sid="ISA 8:3" />तेबे आऊँ एक दिन आपणी लाड़िया गे गया जो एक भविष्यवक्ता थी, ओर से गर्भवती ऊई ओर तेसा रे एक पाऊ ऊआ। तेबे यहोवे माखे बोलेया, “एसरा नाओं महेर्शालाल्हाशबज राख। <verse eid="ISA 8:3" /><verse number="4" style="v" sid="ISA 8:4" />कऊँकि इजी ते पईले कि ये पाऊ बाओ ओर आम्मा बोलणा जाणो, दमिश्क शईर ओर शोमरोन शईर दुँईं री तअन-सम्पत्ति लूटी की अश्शूरो रे राजे आपणे देशो खे पेजणी।<note caller="+" style="f"><char style="fr" closed="false">8:4 </char><char style="ft" closed="false">दमिश्क ओर सामरिया मतलब सीरिया ओर इस्राएलो खे बताओए </char></note>”<verse eid="ISA 8:4" /></para>
  <para style="s">अश्शूरो रे राजे रा आऊणा</para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5" />यहोवे फेर माखे दूजी बार बोलेया, <verse eid="ISA 8:5" /><verse number="6" style="v" sid="ISA 8:6" />“कऊँकि लोक शीलोह रे आऊल़े-आऊल़े बह्यीणे वाल़ी सूबल़ा खे नबाग जाणोए ओर रसीन ओर रमल्याह रे पाऊए साथे एकता करी की मजे करोए,<note caller="+" style="f"><char style="fr" closed="false">8:6 </char><char style="ft" closed="false">राजा रसीन ओर राजा पेकह जो रमल्याह रा पाऊ था। </char></note> <verse eid="ISA 8:6" /><verse number="7" style="v" sid="ISA 8:7" />इजी बजा ते सुण, परमेशर यहोवा तिना पाँदे से प्रबल ओर डूग्गा महानद, मतलब अश्शूरो रा राजा तेसरे सारे प्रतापो साथे चढ़ाई की ली आऊणा ओर तेस तिना रे सेयो सारे नाल़े परी देणे ओर सारे कनारेया पाँदे छल़खी-छल़खी की बह्यीणा। <verse eid="ISA 8:7" /><verse number="8" style="v" sid="ISA 8:8" />ओर अश्शूरो री बाढ़ यहूदा पाँदे नि चढ़ी की आऊणा ओर बढ़ी-बढ़ी की तेस पाँदे चढ़ना और गल़े तक पऊँचणा ओर ओ इम्मानुएल<note caller="+" style="f"><char style="fr" closed="false">8:8 </char><char style="fq" closed="false">इम्मानुएल </char><char style="ft" closed="false">मत्ती 1:23 </char></note>, तेसरा सारा देश, तेसरे पंखा रे फैलणे ते टखी जाणा।” <verse eid="ISA 8:8" /><verse number="9" style="v" sid="ISA 8:9" />ओ लोको, आल्ला करो तो करो, पर तुसे बिखरी जाणे। ओ तरतिया रे दूरो-दूरो रे सबी लोको कान लगाई की सुणो, आपणा-आपणा लक गूड़ो तो गूड़ो, पर तुसा रे टुकड़े-टुकड़े करे जाणे, आपणा लक गूड़ो तो गूड़ो, पर तुसा रा सत्यानाश ऊई जाणा। <verse eid="ISA 8:9" /><verse number="10" style="v" sid="ISA 8:10" />तुसे उपाय करो तो करो, पर से निष्फल ऊई जाणा, तुसे कुछ बी बोलो, पर तुसा रा बोलेया रा ठईरना नि, कऊँकि परमेशर आसा साथे ए।<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="ft" closed="false">रोम. 8:31, नीति. 31:30 </char></note><verse eid="ISA 8:10" /></para>
  <para style="s">परमेशरो की चतौणी</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11" />यहोवे सख्तिया साथे माखे बोलेया ओर इना लोका री चाल-चलणे ते माखे ना कित्ती। <verse eid="ISA 8:11" /><verse number="12" style="v" sid="ISA 8:12" />तिने माखे बोलेया, “जेसा गल्ला खे यो लोक राजद्रोह बोलो, तेतेखे तुसे राजद्रोह नि बोलणा ओर जेसा गल्ला ते सेयो डरोए, तेसा गल्ला ते तुसे नि डरना ओर ना कबराणा। <verse eid="ISA 8:12" /><verse number="13" style="v" sid="ISA 8:13" />सेना रा यहोवा सेईए जेसखे तुसा पवित्र जाणना, तेसरा ई डर मानणा ओर तेसरी ई इज्जत करनी।<note caller="+" style="f"><char style="fr" closed="false">8:13 </char><char style="ft" closed="false">प्रका. 15:4, लूक. 12:5 </char></note> <verse eid="ISA 8:13" /><verse number="14" style="v" sid="ISA 8:14" />परमेशर तुसा री रक्षा करने वाल़ा ऊणा, पर इस्राएलो रे दुँईं करानेया खे ठोकर लगणे रा पात्थर ओर ठेस लगणे री चट्टान ओर यरूशलेम शईरो रे रणे वाल़ेया खे फन्दा ओर जाल़ ऊणा।<note caller="+" style="f"><char style="fr" closed="false">8:14 </char><char style="ft" closed="false">रोम. 9:32,33 </char></note> <verse eid="ISA 8:14" /><verse number="15" style="v" sid="ISA 8:15" />बऊत सारे लोका ठोकर खाणी, सेयो रूड़ने ओर चूर-चूर ऊई जाणे, सेयो फन्दे दे फसणे ओर पकड़े जाणे।”<note caller="+" style="f"><char style="fr" closed="false">8:15 </char><char style="ft" closed="false">मत्ती 21:44 </char></note><verse eid="ISA 8:15" /></para>
  <para style="s">मुड़देया ते पूछणे रे खलाफ चतौणी</para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 8:16" />चतौणिया री पर्ची लपेटो ओर बन्द करो, ओ मेरे चेलेयो, तुसा खे परमेशरो रे जरीये दित्ती री चतौणिया री कताब लपेटी की बानणी चाईयो। <verse eid="ISA 8:16" /><verse number="17" style="v" sid="ISA 8:17" />मां यहोवे खे न्याल़दे रणा, जिने आपणा मूँ याकूबो रे वंशो ते लकोई राखेया ओर मां यहोवे पाँदे ई उम्मीद लगाई की राखणी।<note caller="+" style="f"><char style="fr" closed="false">8:17 </char><char style="ft" closed="false">मीका 3:4, पज. 27:14 </char></note> <verse eid="ISA 8:17" /><verse number="18" style="v" sid="ISA 8:18" />देख, मां ओर जो बच्चे यहोवे मांगे सम्बाल़ी राखे, तेस ई सेनाओं रे यहोवा री तरफा ते, जो यरूशलेम शईरो दे सिय्योनो रे पाह्ड़ो पाँदे वास करोआ, इस्राएली लोका खे नशाण ओर चमत्कार ए।<note caller="+" style="f"><char style="fr" closed="false">8:18 </char><char style="ft" closed="false">इब्रा. 2:13 </char></note><verse eid="ISA 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 8:19" />जेबे लोक तुसा खे बोलो, “जादू करने वाल़े ओर मरी री आत्मा साथे गल्ल करने वाल़ेया गे जाई की पूछो, जो गुणगुणाओए ओर खसफस करोए,” तेबे तुसे ये बोलणा, “क्या प्रजा खे आपणे परमेशरो गे जाई की नि पूछणा चाईयो? क्या जिऊँदेया खे मुड़देया ते पूछणा चाईयो?”<note caller="+" style="f"><char style="fr" closed="false">8:19 </char><char style="ft" closed="false">लेवी. 20:6, 19:31 </char></note> <verse eid="ISA 8:19" /><verse number="20" style="v" sid="ISA 8:20" />तुसे तिना खे ज्वाब देयो ओर बिधान ओर चतौणिया री ई चर्चा करेया करो! जे सेयो लोक एस वचनो रे मुताबिक नि बोलो तो पक्का तिना खे प्याग नि ऊणी।<verse eid="ISA 8:20" /></para>
  <para style="s">संकटो रा बखत</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 8:21" />लोक एस देशो रे क्ल़ेशो ते परे रे ओर पूखे फिरदे रणे ओर जेबे सेयो पूखे ऊणे, तेबे तिना रोषो रे आई की आपणे राजा ओर परमेशरो खे स्राप देणा ओर आपणा मूँ ऊबे सर्गो रिया तरफा खे चकणा। <verse eid="ISA 8:21" /><verse number="22" style="v" sid="ISA 8:22" />तेबे तिना तरतिया री तरफा खे आपणी मुसीबता दे मतादा रिया तँईं देखणा, पर तिना खे संकट ओर न्हेरा, मतलब संकटो साथे परेया रा न्हेरा ई दिशणा ओर सेयो अन्दकूप न्हेरे रे तकेले जाणे।<note caller="+" style="f"><char style="fr" closed="false">8:22 </char><char style="ft" closed="false">सप. 1:14,15 </char></note><verse eid="ISA 8:22" /></para>
  <chapter eid="ISA 8" />
  <chapter number="9" style="c" sid="ISA 9" />
  <para style="s">शान्तिया रे राजकुमारो रा जन्म</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 9:1" />तेबे बी मुसीबता ते फरेया रा न्हेरा जांदा रणा। पईले तो तिने जबूलून ओर नप्तालिया रे देशो री बेज्जती कित्ती, पर अन्तो रे दिना दे भूमध्य समुद्रो रिया तरफा खे यरदन नदिया ते पारली दूजी जातिया रे गलील प्रदेशो खे इज्जत देणी। <verse eid="ISA 9:1" /><verse number="2" style="v" sid="ISA 9:2" />जो लोक न्हेरे दे चलणे लगी रे थे, तिने बड़ा प्रयासा देखेया ओर जो लोक अन्दकूप न्हेरे ते परे रे मौता रे देशो दे रओ थे, तिना पाँदे ज्योति चमकी।<note caller="+" style="f"><char style="fr" closed="false">9:2 </char><char style="fq" closed="false">तिना पाँदे ज्योति चमकी। </char><char style="ft" closed="false">मत्ती 4:15, लूक. 1:79 </char></note> <verse eid="ISA 9:2" /><verse number="3" style="v" sid="ISA 9:3" />ओ मेरे यहोवा तैं एस देशो रे लोक बऊत बढ़ाए, तैं तिना खे बऊत मजे दित्ते, सेयो तां सामणे बडाईया रे बखतो री जी खुशी करोए ओर एड़े मगन ए, जेड़े लोक लूट बांडणे रे बखते मगन रओए। <verse eid="ISA 9:3" /><verse number="4" style="v" sid="ISA 9:4" />कऊँकि तैं तेसरी क्याड़िया पाँदला पारी जूँगड़ा, तिजी री पँजाल़िया और तेस पाँदे अन्देर करने वाल़े रा डण्डा, यो सारे एड़े तोड़ी ते रे, ठीक तेड़े ई जेड़े तुसे बऊत पईले मिद्यानिया री सेना अराई थी।<verse eid="ISA 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 9:5" />कऊँकि युद्धो रे लड़ने वाल़े सिपाईया रे बूट ओर खूनो साथे लथपथ टाल्ले सारे आगी दे फूखी जाणे। <verse eid="ISA 9:5" /><verse number="6" style="v" sid="ISA 9:6" />कऊँकि आसा रिया तँईं एक बाल़क पैदा ऊआ, यहोवे आसा खे एक पाऊ दित्तेया ओर राज्य रा बोज तेसरी कांदा पाँदे ऊणा ओर तेसरा नाओं “अद्भुत काम करने वाल़ा पराक्रमी परमेशर, अनन्तकालो रा बाओ ओर शान्तिया रा राजकुमार राखेया जाणा।” <verse eid="ISA 9:6" /><verse number="7" style="v" sid="ISA 9:7" />तेसरा राज्य सदा बढ़दा रणा ओर तेसरी शान्तिया रा अन्त नि ऊणा, इजी री खातर तेस से दाऊदो री राजगद्दिया पाँदे, एस बखतो ते लई की सदा खे न्याय ओर तर्मो रे जरीये पक्का करी की सम्बाल़ी की राखणा। सेना रे यहोवे री धुना रे जरीये ये ऊई जाणा।<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">लूक. 1:32,33, यिर्म. 23:5 </char></note><verse eid="ISA 9:7" /></para>
  <para style="s">इस्राएलो रिया तँईं परमेशरो रा गुस्‍सा</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 9:8" />परमेशरे इस्राएलो खे चतौणी देई की एक सन्देश पेजी राखेया; ओर से सच्च ऊणा। <verse eid="ISA 9:8" /><verse number="9" style="v" sid="ISA 9:9" />ओर सारी‍ प्रजा खे, एप्रैमी ओर सामरिया रे रणे वाल़ेया खे पता लगी जाणा जो कमण्ड ओर सख्ताईया रे बोलोए, <verse eid="ISA 9:9" /><verse number="10" style="v" sid="ISA 9:10" />“ईटा री दवाला तो टल़ी गिया, पर आसा कअड़े रे पात्थरा साथे कअर बनाणा, गूलरो री लकड़िया री कड़िया बाडी तिया दिया ए, पर आसा तिना रे बदले देवदारो रा इस्तेमाल करना।” <verse eid="ISA 9:10" /><verse number="11" style="v" sid="ISA 9:11" />इजी बजा ते यहोवे इस्राएलिया रे खलाफ रसीनो रे बैरी प्रबल करने, <verse eid="ISA 9:11" /><verse number="12" style="v" sid="ISA 9:12" />ओर तिना रे दुश्मणा खे, मतलब पईले अराम ओर तेबे पलिश्ती उभारने ओर तिना मूँ खोली की इस्राएली निगल़ी लणे। इतणा ऊणे ते बाद बी तेसरा रोष शान्त नि ऊआ ओर एबु बी तेसरा आथ तिना रे खलाफ उठेया रा ए। <verse eid="ISA 9:12" /><verse number="13" style="v" sid="ISA 9:13" />तेबे बी यो इस्राएलो रे लोक तेस परमेशरो रे नेड़े नि आए जिने सेयो काईते थे। ओर ना सेना रे यहोवे खे टोल़दे। <verse eid="ISA 9:13" /><verse number="14" style="v" sid="ISA 9:14" />इजी बजा ते यहोवे इस्राएलो बीचा ते सिर ओर पूँछ, खजूरी री डाल़िया ओर नंगल़ एक ई दिने बाडी देणे<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">नरम खजूरी री डाल़िया जेड़े लोक ओर जरूरतमंद लोक </char></note>।<verse eid="ISA 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 9:15" />बुजुर्ग ओर इज्जतदार मर्द तो सिर ए ओर चूठी गल्ल सिखाणे वाल़ा नबी पूँछ ए, <verse eid="ISA 9:15" /><verse number="16" style="v" sid="ISA 9:16" />कऊँकि जो इना लोका ते आगे चलोए, सेयो इना खे बाटा ते पटकाई देओए ओर जो इना पीछे चलोए, सेयो नाश ऊई जाओए। <verse eid="ISA 9:16" /><verse number="17" style="v" sid="ISA 9:17" />इजी बजा ते प्रभु ना तो तिना रे जवाना ते खुश ऊणा ओर ना तेस इना रे अनाथ बाल़का ओर बिदुआ पाँदे दया करनी, कऊँकि हर एक पग्ति हीन ओर कुकर्मी ए ओर हर एकी रे मुंए ते मूर्खता री गल्ल निकल़ोई, इतणा ऊणे ते बी तेसरा रोष शान्त नि ऊआ ओर तेसरा आथ एबुए तक सजा देणे खे आगे बढ़ेया राए। <verse eid="ISA 9:17" /><verse number="18" style="v" sid="ISA 9:18" />कऊँकि दुष्टता आगी जेड़ी पड़कोई, से कांडे-चीट फूकी देओई, बल्कि से कणे जंगल़ा रे जाड़ो रे आग लगाओई ओर से तुएँ रे चड़चड़ करी की ऊबो खे उठोई। <verse eid="ISA 9:18" /><verse number="19" style="v" sid="ISA 9:19" />सेना रे यहोवे रे रोषो रिया बजा ते ये इस्राएल देश फूकीगा ओर यो लोक आगी रे फेऊआ जेड़े ए, ओर केसी आपणा पाई पनि छाडणा। <verse eid="ISA 9:19" /><verse number="20" style="v" sid="ISA 9:20" />लोका आपणे दाँणे कनारे रे पड़ोसिये पाँदे अमला करना, पर तेबे बी पूखे ई रणे। तिना आपणे खूँजे कनारे रे पड़ोसी खाई जाणे, पर रजणे नि। अंतो दे तिना आपणे ई बच्चेया रा मास खाई जाणा। <verse eid="ISA 9:20" /><verse number="21" style="v" sid="ISA 9:21" />मनश्शे एप्रैमो रे लोक एकी दूजे पाँदे अमला करोए, ओर साथे मिली की सेयो यहूदा पाँदे अमला करोए। इतणे ते बी तेसरा रोष शान्त नि ऊआ ओर यहोवे रा आथ एबुए तक सजा देणे खे बढ़ेया राए।<verse eid="ISA 9:21" /></para>
  <chapter eid="ISA 9" />
  <chapter number="10" style="c" sid="ISA 10" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 10:1" />लाणत ए तिना पाँदे जो दुष्टता साथे न्याय करोए ओर तिना पाँदे जो अनर्थ करने री आज्ञा लिखी देओए, <verse eid="ISA 10:1" /><verse number="2" style="v" sid="ISA 10:2" />सेयो ये इजी खे करोए ताकि सेयो कंगाल़ा रा न्याय बिगाड़ो ओर सेयो मेरे लोका खे सताणे वाल़ेया रा न्याय नि करदे, ताकि सेयो बिदुआ खे लूटो ओर अनाथा रा माल आपणा बणाई लो! <verse eid="ISA 10:2" /><verse number="3" style="v" sid="ISA 10:3" />तुसा सजा रे दिने ओर मुसीबता रे दिने जो दूरा ते आऊणी क्या करना? तुसा मतादा खे केसगे नठी की जाणा? तुसा आपणी सम्पति केयी राखी की छाडणी?<note caller="+" style="f"><char style="fr" closed="false">10:3 </char><char style="ft" closed="false">अय्यू. 31:14, 1 पत. 2:12 </char></note> <verse eid="ISA 10:3" /><verse number="4" style="v" sid="ISA 10:4" />सेयो बस गुलामा रे पैरा गे पड़ने ओर मरेया निठे दबे रे पड़े रे रणे। इतणे दे बी यहोवे रा रोष शान्त नि ऊआ ओर तेसरा आथ एबुए तक बढ़ेया दा ए।<verse eid="ISA 10:4" /></para>
  <para style="s">अश्शूर रोषो री बजा</para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 10:5" />यहोवा ये बोलोआ, अश्शूरो रे राजे पाँदे लाणत ए, जो मेरे आथो रा ओर मेरे रोषो रा सोठा ए! से मेरा रोष ए। <verse eid="ISA 10:5" /><verse number="6" style="v" sid="ISA 10:6" />मां से एक नास्तिक जातिया गे पेजणा ओर जिना लोका पाँदे मेरा रोष पड़की रा, तिना रे खलाफ तेसखे आज्ञा देणी कि छुड़ाई की लूटी लो ओर तिना खे सड़का रे चीकड़ो जेड़ा चाड़ी देयो। <verse eid="ISA 10:6" /><verse number="7" style="v" sid="ISA 10:7" />पर सीरिया रे राजे खे तेसरी एड़ी इच्छा नि ऊणी, ना तेसरे मनो दे एड़ी सोच ए, कऊँकि तेसरे मनो दे ये कि मां बऊत सारिया जातिया नाश ओर तिना रा अन्त करना। <verse eid="ISA 10:7" /><verse number="8" style="v" sid="ISA 10:8" />कऊँकि से गर्व करी की बोलोआ, “क्या मेरे सारे परदान राजे जेड़े नि ए? <verse eid="ISA 10:8" /><verse number="9" style="v" sid="ISA 10:9" />क्या कलनो शईर कर्कमीश शईरो जेड़ा नि ए? क्या हमात शईर अर्पाद शईरो जेड़ा ओर सामरिया शईर दमिश्क शईरो जेड़ा नि ए? <verse eid="ISA 10:9" /><verse number="10" style="v" sid="ISA 10:10" />जिंयाँ मेरा आथ मूर्तिया साथे परे रे तिना राजा पाँदे पऊँचेया जिना रिया मूर्तिया यरूशलेम ओर सामरिया री मूर्तिया ते बढ़ी की थिया ओर जेड़ा मैं सामरिया ओर तिना री मूर्तिया साथे कित्तेया, <verse eid="ISA 10:10" /><verse number="11" style="v" sid="ISA 10:11" />क्या आऊँ तेड़ा ई यरूशलेम ओर तिना री मूर्तिया साथे नि करुँ?”<verse eid="ISA 10:11" /></para>
  <para style="s">अश्शूरो पाँदे न्याय</para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 10:12" />इजी बजा ते जेबे प्रभु सिय्योनो रे पाह्ड़ो पाँदे ओर यरूशलेम शईरो रे आपणा सारा काम पूरा करी चुकोगा, तेबे मां अश्शूरो रे राजे री कमण्डी गल्ला रा ओर कमण्डी आखी रा बदला देणा। <verse eid="ISA 10:12" /><verse number="13" style="v" sid="ISA 10:13" />अश्शूरो रा राजा गर्व करी की बोलोआ, “आपणी तागती ते ओर अक्ला साथे मैं ये काम करी राखेया, कऊँकि आऊँ उशयार ए, मैं देश-देशो रे बन्ने टायी ते ओर तिना रा राखेया रा तअन लूटी ला, मैं वीरो जेड़े गद्दिया पाँदे बैठणे वाल़े उतारी ते। <verse eid="ISA 10:13" /><verse number="14" style="v" sid="ISA 10:14" />देश-देशो रे लोका री तअन-सम्पत्ति, चिड़िया रे कोअलेया जेड़ी, मेरे आथो दे आई री ओर जेड़ा कोई छाडे दे अण्डेया खे कट्ठा करोआ, तिंयाँ ई मैं सारी तरती कट्ठी करी ली री ओर कोई पंख फड़फड़ाणे वाल़ा या चूँज खोलणे वाल़ा या चीं-चीं करने वाल़ा नि था।” <verse eid="ISA 10:14" /><verse number="15" style="v" sid="ISA 10:15" />राजा सोचोआ कि से ये सब आपणे दमो पाँदे करी सकोआ, क्या क्वाड़ी तेसरे खलाफ जो तेसखे बाडोई फफल़्यारापण करो, या आरी तेसरे खलाफ जो तेसखे खिंजोआ बडयाईया करो? क्या सोठा आपणे चलाणे वाल़े खे चलाओ या डण्डा तेसखे चको जो लक्कड़ नि ए! <verse eid="ISA 10:15" /><verse number="16" style="v" sid="ISA 10:16" />इजी बजा ते प्रभुए मतलब सेना रे यहोवे तेस राजे रे तगड़े योद्धा कमजोर करी देणे ओर तेसरे ऐश्वर्य निठे आगी जेड़ी जल़न ऊणी। <verse eid="ISA 10:16" /><verse number="17" style="v" sid="ISA 10:17" />इस्राएलो रा प्रयासा, यहोवा तो आग ठईरना ओर इस्राएलो रा पवित्र परमेशर ठईरना ओर तेस तेसरे कांडे-चीट एक ई दिनो रे फूकी देणे। <verse eid="ISA 10:17" /><verse number="18" style="v" sid="ISA 10:18" />जेड़ा बमारो री दशा कमजोर ऊणे ते ओई, तेड़ी ई तेस तेसरे बण ओर फल़़ देणे वाल़े बगीचे री शोभा पूरी तरअ ते नाश करी देणी। <verse eid="ISA 10:18" /><verse number="19" style="v" sid="ISA 10:19" />तेस बणो रे डाल़ इतणे थोड़े रयी जाणे कि बच्चे बी सेयो गिणी की लिखी लणे।<verse eid="ISA 10:19" /></para>
  <para style="s">बचे रे इस्राएली लोका री वापसी</para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 10:20" />तेस बखते इस्राएलो रे बचे रे लोक ओर याकूबो रे कराने रे नठे रे लोका, अश्शूरो रे सिपाईया, ओरी देशो रे राजेया पाँदे परोसा नि करना, पर यहोवा जो इस्राएलो रा पवित्र ए, तेस पाँदे ई तिना सच्चाईया साथे परोसा राखणा। <verse eid="ISA 10:20" /><verse number="21" style="v" sid="ISA 10:21" />याकूबो रे कराने ते बचे रे लोक पराक्रमी परमेशरो रिया तरफा खे फिरने। <verse eid="ISA 10:21" /><verse number="22" style="v" sid="ISA 10:22" />कऊँकि ओ इस्राएल, चाए तेरे लोक समुद्रो रे बालूए रिया कणियां जेड़े ओ, तेबे बी पक्का ए कि तिना बीचा ते बचे रे लोक ई वापस ऊणे। सत्यानाश तो पूरे न्याय साथे ठाणेया राए। <verse eid="ISA 10:22" /><verse number="23" style="v" sid="ISA 10:23" />कऊँकि प्रभु सेनाओं रे यहोवे देशो रा सत्यानाश करना ठाणी राखेया।<note caller="+" style="f"><char style="fr" closed="false">10:23 </char><char style="ft" closed="false">रोम. 9:27,28 </char></note><verse eid="ISA 10:23" /></para>
  <para style="s">परमेशरो अश्शूरो खे सजा देणी</para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 10:24" />इजी री खातर सेना रा यहोवा ईंयाँ बोलोआ, “ओ सिय्योनो दे रणे वाल़ी मेरी प्रजा, अश्शूरो ते नि डर; चाए से ताखे सोठे साथे बाओ ओर मिस्रो जेड़ा तां पाँदे सोठा चको। <verse eid="ISA 10:24" /><verse number="25" style="v" sid="ISA 10:25" />कऊँकि एबे थोड़ी जी देर ए कि मेरी जल़न ओर मेरा रोष तिना रा सत्यानाश करी की शान्त ऊणा। <verse eid="ISA 10:25" /><verse number="26" style="v" sid="ISA 10:26" />सेना रे यहोवे तेसरे खलाफ कोड़ा चकी की से एड़ा मारना जेड़े तिने ओरेब नाओं री चट्टानी पाँदे मिद्यानी काये थे<note caller="+" style="f"><char style="fr" closed="false">10:26 </char><char style="ft" closed="false">न्याय. 7:24-25 </char></note> ओर जेड़ा तिने मिस्रिया रे खलाफ समुद्रो रे डण्डा बढ़ाया, तेड़ा ई तेसरी तरफा खे बी बढ़ाणा। <verse eid="ISA 10:26" /><verse number="27" style="v" sid="ISA 10:27" />तेस बखते एड़ा ऊणा कि तेसरा बोज तेरी कांदा पाँदा ते ओर तेसरा जूँगड़ा तेरी क्याड़िया पाँदा ते चकेया जाणा ओर अभिषेको रिया बजा ते से जूँगड़ा तोड़ी देणा।”<verse eid="ISA 10:27" /></para>
  <para style="s">अश्शूरी सेना रा अमला</para>
  <para style="p">
    <verse number="28" style="v" sid="ISA 10:28" />से अय्यात शईरो रे आई रा ओर मिग्रोन शईरो रिये आगे बढ़ी गा रा, मिकमाश शईरो दे तिने आपणा समान राखी राखेया। <verse eid="ISA 10:28" /><verse number="29" style="v" sid="ISA 10:29" />सेयो काट्टिया ते पार ऊईगे, तिने गेबा शईरो दे रात कटी, रामा शईरो रे लोक डरीगे रे, शाऊलो रे गिबा शईरो रे सब लोक नठीगे रे। <verse eid="ISA 10:29" /><verse number="30" style="v" sid="ISA 10:30" />ओ गल्लीम शईरो रे लोको मतादा रिया तँईं रोओ! ओ लैशा रे लोको कान लगाओ! हाय बचारा अनातोत!<note caller="+" style="f"><char style="fr" closed="false">10:30 </char><char style="fq" closed="false">अनातोत! </char><char style="ft" closed="false">एती यिर्मयाह जम्मेया था, यरूशलेमो रिया उत्तर-पूर्बा दे एक शईर </char></note> <verse eid="ISA 10:30" /><verse number="31" style="v" sid="ISA 10:31" />मदमेना शईर मारा-मारा फिरोआ, गेबीम शईरो रे रणे वाल़े लोक नठणे खे आपणा-आपणा समान कट्ठा करने लगी रे। <verse eid="ISA 10:31" /><verse number="32" style="v" sid="ISA 10:32" />आजके दिने ई सीरिया सेना रा दुश्मण नोब<note caller="+" style="f"><char style="fr" closed="false">10:32 </char><char style="fq" closed="false">नोब </char><char style="ft" closed="false">बिन्यामीन गोत्रो रा एक शईर ए जिदे पुरोईत रओए </char></note> शईरो दे रूकणा, तेबे तेस सिय्योन रे पाह्ड़ो पाँदे जो यरूशलेमो रा शईर ए आथ चकी की तमकाणे। <verse eid="ISA 10:32" /><verse number="33" style="v" sid="ISA 10:33" />देखो, सेना रे यहोवे यो डाल़ खतरनाक टंगो दे छाँटणे, ऊच्चे-ऊच्चे डाल़ बाडी देणे ओर जो ऊच्चे ए, सेयो निठे करे जाणे। <verse eid="ISA 10:33" /><verse number="34" style="v" sid="ISA 10:34" />यहोवे सेयो एड़े बाडणे जेड़े जंगल़ो रे बीचे क्वाड़िये कि डाल़ बाडे जाओए, एथो तक कि लबानोनो रे खरे डाल़ बी टल़ी जाओए!<verse eid="ISA 10:34" /></para>
  <chapter eid="ISA 10" />
  <chapter number="11" style="c" sid="ISA 11" />
  <para style="s">यिशै रे वंशो रा राज करने रा बखत</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 11:1" />तेबे यिशै रे ठूँठो बीचा ते एक डाल़ी निकल़नी ओर तेतेरिया जड़ी ते एक पाँगटी निकल़ी की फल़नी।<note caller="+" style="f"><char style="fr" closed="false">11:1 </char><char style="ft" closed="false">एती मसीही री भावना जादा ए, यिशै दाऊदो रा बाओ था। ये ठूँठ दाऊदो रे कराने खे बताओआ, मतलब दाऊद ओर तेसरे वंशो रे लोक, जो यरूशलेमो दे राजा थे। प्रेरि. 13:23, यिर्म. 23:5, प्रका. 22:16 </char></note> <verse eid="ISA 11:1" /><verse number="2" style="v" sid="ISA 11:2" />यहोवे रा आत्मा, बुद्धि ओर समजा रा आत्मा, सला ओर पराक्रमो रा, ज्ञानो रा ओर यहोवे रे डरो रा आत्मा नवें राजे पाँदे मतलब दाऊदो रे वंशो पाँदे रूकेया दा रणा।<note caller="+" style="f"><char style="fr" closed="false">11:2 </char><char style="ft" closed="false">इफि. 1:17, यशा. 42:1, यूह. 14:17 </char></note> <verse eid="ISA 11:2" /><verse number="3" style="v" sid="ISA 11:3" />तेसखे परमेशरो रा डर खुशबूआ जेड़ा अच्छा लगणा। तेस मूँ देखी की न्याय नि करना ओर ना आपणे कानो साथे सुणी की न्याय करना।<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="ft" closed="false">यूह. 8:15,16, यूह. 7:24 </char></note> <verse eid="ISA 11:3" /><verse number="4" style="v" sid="ISA 11:4" />पर तेस कंगाल़ा रा न्याय तर्मो साथे ओर तरतिया रे शरीफ लोका रा फैंसला खराईया साथे करना ओर तेस तरती आपणे शब्दा रे सोठे साथे कूटणी ओर तरतिया खे तेसरी आज्ञा ते बुराईया री सजा मिलणी।<note caller="+" style="f"><char style="fr" closed="false">11:4 </char><char style="ft" closed="false">2 थिस्स. 2:8, प्रका. 19:15, नसी. 31:8,9 </char></note> <verse eid="ISA 11:4" /><verse number="5" style="v" sid="ISA 11:5" />तर्म ई तेसरी तागत ऊणा ओर सच्चाई तेसरी सामर्थ ऊणी।<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false">यशा. 59:17, इफि. 6:14</char></note><verse eid="ISA 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 11:6" />तेस दिने जंगल़ी कुत्ता पेडा रे बच्चे साथे रया करना ओर चीता बाकरिया रे बच्चे साथे बैठेया रा रणा ओर बाच्छू ओर जवान शेर ओर पाल़ेया रा बल़द तीनो कट्ठे रया करने ओर एकी छोटे बच्चे सेयो चलाया करने। <verse eid="ISA 11:6" /><verse number="7" style="v" sid="ISA 11:7" />गाय ओर पालणी मिली की चरेया करनिया ओर तिना रे बच्चे मिली की रया करने ओर शेरो बल़दा जेड़े काआ खाया करना। <verse eid="ISA 11:7" /><verse number="8" style="v" sid="ISA 11:8" />दूद पींदा बच्चा सापो रे बिलो पाँदे खेलेया करना ओर दूद छुड़ाए रे बच्चे नागो रे बिलो दे बिना केसी नुकशाणो ते आथ पाया करना। <verse eid="ISA 11:8" /><verse number="9" style="v" sid="ISA 11:9" />मेरे सारे पवित्र पाह्ड़ो<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="fq" closed="false">पवित्र पाह्ड़ो </char><char style="ft" closed="false">सिय्योन पाह्ड़ </char></note> पाँदे ना तो केसी दु:ख देया करना ओर ना नुकशाण करना, कऊँकि तरती परमेशरो रे ज्ञानो साथे एड़ी परी जाणी जेड़ा समुद्र पाणिए साथे फरेया रा रओआ।<verse eid="ISA 11:9" /></para>
  <para style="s">इस्राएली लोका रा दुबारा कट्ठे ऊणा</para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 11:10" />तेस बखते यिशै री जड़<note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="fq" closed="false">यिशै री जड़ </char><char style="ft" closed="false">दाऊदो रे कराने ते नवां राजा </char></note> सबी देशा रे लोका खे एक चण्डा ऊणी, सबी राज रे लोका से टोल़नी ओर तेसा रे राम करने री जगा तेजोमय ऊणी।<note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="ft" closed="false">रोम. 15:12 </char></note> <verse eid="ISA 11:10" /><verse number="11" style="v" sid="ISA 11:11" />तेस बखते दूजी बार परमेशर यहोवे आपणा आथ बढ़ाई की बचे दे लोक आजाद करने। तेस सेयो अश्शूर, मिस्र, पत्रोस, कूश, एलाम, शिनारो ते, हमातो रे देशा ते, भूमध्य समुद्रो ते मोले लई की छुड़ाणे। <verse eid="ISA 11:11" /><verse number="12" style="v" sid="ISA 11:12" />यहोवे दूजी जातिया रे लोका खे चतौणी देणे खे चण्डा खड़ा करना, ओर इस्राएलो रे सब काडेया रे लोका खे ओर यहूदा रे सब बिखरे रे लोक तरतिया री चारो दिशा ते कट्ठे करने।<verse eid="ISA 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 11:13" />एप्रैमो फेर ईर्ष्या नि करनी ओर यहूदा खे तंग करने वाल़े बाडी देणे, ना तो एप्रैमो यहूदा साथे डाह् करना ओर ना यहूदा फेर एप्रैम तंग करना। <verse eid="ISA 11:13" /><verse number="14" style="v" sid="ISA 11:14" />पर इस्राएल ओर यहूदा रे लोक एकी साथे इस्राएलो रे पच्छमा रिया तरफा खे पलिश्तिया पाँदे अमला करना ओर मिली की यरदन नदिया रे पूर्बा दे रणे वाल़े लोक लुटणे। तिना एदोम ओर मोआबो रे देशा पाँदे अमला करना ओर अम्मोन देशो रे लोक तिना रे वशो दे ऊई जाणे।<verse eid="ISA 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 11:15" />यहोवे मिस्रो री सड़क सुकाई देणी ओर फरात नदिया पाँदे आपणा आथ बढ़ाई की प्रचण्ड लू साथे एड़ा सूकाणा कि तेसरे सात नदिया ऊई जाणिया ओर लोक जोड़े पईनी की बी पार ऊई जाणे।<note caller="+" style="f"><char style="fr" closed="false">11:15 </char><char style="ft" closed="false">जक. 10:11 </char></note> <verse eid="ISA 11:15" /><verse number="16" style="v" sid="ISA 11:16" />परमेशरो आपणे इस्राएलिया खे जो अश्शूरो दे बची गे दे ए, वापस आऊणे खे खरी बाट त्यार करनी, जेड़ी मिस्र देशो ते चली की आऊणे रे बखते इस्राएलो खे ऊई थी।<verse eid="ISA 11:16" /></para>
  <chapter eid="ISA 11" />
  <chapter number="12" style="c" sid="ISA 12" />
  <para style="s">तन्यवादो रा गाणा</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 12:1" />तेस दिने तां गाणा, “ओ यहोवा, आऊँ तेरा तन्यवाद करूँआ,</para>
  <para style="q" vid="ISA 12:1">तेबे बी तूँ मां पाँदे रोषे ऊआ था,</para>
  <para style="q" vid="ISA 12:1">पर एबे तेरा रोष शान्त ऊआ</para>
  <para style="q" vid="ISA 12:1">ओर तैं माखे शान्ति देई राखी।<verse eid="ISA 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 12:2" />देखो, परमेशर मेरी रक्षा करने वाल़ा ए, मां परोसा राखणा ओर डरना नि,</para>
  <para style="q" vid="ISA 12:2">कऊँकि यहोवा मेरी तागत ओर मां तेसरा पजन गाणा ए,</para>
  <para style="q" vid="ISA 12:2">ओर से मेरा उद्धार करने वाल़ा ऊईगा रा।”<note caller="+" style="f"><char style="fr" closed="false">12:2 </char><char style="ft" closed="false">पज. 118:14, निर्ग. 15:2 </char></note><verse eid="ISA 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 12:3" />जेड़े ताजा पाणी त्याये खे खुशी देओआ,</para>
  <para style="q" vid="ISA 12:3">तेड़े ई जेबे परमेशर आपणे लोका खे बचाओआ तो सेयो बी खुश ओ ए।<verse eid="ISA 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 12:4" />तेस दिने तुसा गाणा, “यहोवे री स्तुति करो,</para>
  <para style="q" vid="ISA 12:4">तेसते मतादा रिया तँईं प्रार्थना करो; सबी जातिया दे तेसरे बड़े कामा रा प्रचार करो,</para>
  <para style="q" vid="ISA 12:4">ओर बोलो कि तेसरा नाओं महान ए।<note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="ft" closed="false">पज. 105:1,2 </char></note><verse eid="ISA 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 12:5" />परमेशरो रा पजन गाओ, कऊँकि तिने बड़े-बड़े काम करी राखे,</para>
  <para style="q" vid="ISA 12:5">परमेशरो रे इना कामा रे बारे दे सारी तरतिया पाँदे बताओ।<verse eid="ISA 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 12:6" />ओ सिय्योनो दे बसणे वाल़े लोको, तुसे जयजयकार करो</para>
  <para style="q" vid="ISA 12:6">ओर जोरे की गाओ, कऊँकि तुसा बीचे रणे वाल़ा इस्राएलो रा पवित्र परमेशर महान ए।”<verse eid="ISA 12:6" /></para>
  <chapter eid="ISA 12" />
  <chapter number="13" style="c" sid="ISA 13" />
  <para style="s">परमेशरो रा बाबेलो खे सजा देणा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1" />आमोसो रे पाऊ यशायाहे परमेशरो ते मिले दे दर्शणो दे बाबेलो रे बारे दे पारी भविष्यबाणी देखी। <verse eid="ISA 13:1" /><verse number="2" style="v" sid="ISA 13:2" />पाह्ड़ो री चूँडिया पाँदे एक चण्डा खड़ा करो, सिपाईया खे जोरे की आका पाई की बुलाओ ओर आपणा आथ ऊबे करी की तिना खे अमला करने ओर बेबीलोनो रे तागतबर शईरो रे बड़े द्वारो दे पीतरे जाणे खे साअरा करो। <verse eid="ISA 13:2" /><verse number="3" style="v" sid="ISA 13:3" />यहोवे लड़ाईया रिया तँईं आपणे पवित्र ओर तागतबर सिपाईया खे आज्ञा देई राखी, मैं आपणे रोषो खे आपणे वीर बुलाए, सेयो मेरिया जीता ते खुश ओ ए। <verse eid="ISA 13:3" /><verse number="4" style="v" sid="ISA 13:4" />पाह्ड़ा पाँदे लोका री एक बड़ी पीड़ा रा जा आल्ला ऊणे लगी रा, मानो लोका री एक बड़ी पीड़ा री आवाज ए। राज-राज री कट्ठी कित्ती री जातिया आल्ला-गोल्ला करने लगी रिया। सेना रा यहोवा युद्धो खे आपणी सेना कट्ठी करने लगी रा। <verse eid="ISA 13:4" /><verse number="5" style="v" sid="ISA 13:5" />सेयो दूर देशो ते, सर्गो रे कूणे ते आई रे, आ, यहोवा आपणे रोषो रे अथियारो समेत सारे देशो खे नाश करने खे आई रा। <verse eid="ISA 13:5" /><verse number="6" style="v" sid="ISA 13:6" />हाय-हाय करो, कऊँकि यहोवे रे न्याय रा दिन नेड़े ए, से सर्वशक्तिमानो रिया तरफा ते मानो सत्यानाश करने खे आओआ।<note caller="+" style="f"><char style="fr" closed="false">13:6 </char><char style="ft" closed="false">योएल 1:15 </char></note> <verse eid="ISA 13:6" /><verse number="7" style="v" sid="ISA 13:7" />इजी आऊणे वाल़े विनाशो ते सबी रे आथ टीले पड़ने ओर डरो रिया बजा ते सबी री इम्मता ज्वाब देई जाणा। <verse eid="ISA 13:7" /><verse number="8" style="v" sid="ISA 13:8" />ओर सेयो लोक कबराई जाणे। तिना खे पीड़ ओर दु:ख ऊणा, तिना खे बच्चा पैदा करने री जी पीड़ ऊणी। तिना हैरान ऊई की एकी-दूजे खे ताकणा, तिना रे मूँ फूखी जाणे।<note caller="+" style="f"><char style="fr" closed="false">13:8 </char><char style="ft" closed="false">1 थिस्स. 5:3 </char></note><verse eid="ISA 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 13:9" />देखो, यहोवे रा से खतरनाक दिन रोष ओर निर्दयता साथे आओआ, ताकि से तरतिया खे उजाड़ी देयो ओर पापिया खे तिजी बीचा ते नाश करो। <verse eid="ISA 13:9" /><verse number="10" style="v" sid="ISA 13:10" />कऊँकि सर्गो रे तारेया ओर बड़े-बड़े नक्षत्रा आपणा प्रयासा नि देणा ओर सूरज निकल़दे-निकल़दे काल़ा ऊई जाणा ओर चाँदो आपणा प्रयासा नि देणा।<note caller="+" style="f"><char style="fr" closed="false">13:10 </char><char style="ft" closed="false">मत्ती 24:29, मर. 13:24, प्रका. 6:12-13 </char></note><verse eid="ISA 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 13:11" />यहोवे बोलेया, “मां दुनिया रे लोका खे तिना री बुराईया री बजा ते ओर दुष्टा खे तिना रे पापो रिया बजा ते सजा देणी, मां कमण्डिया रा कमण्ड नाश करना ओर उपद्रव करने वाल़ेया रा कमण्ड तोड़ना। <verse eid="ISA 13:11" /><verse number="12" style="v" sid="ISA 13:12" />मां सेयो माणूं जो जिऊँदे बची रे कुन्दनो ते ओर ओपीरो रे शुद्ध सूईने ते बी मईंगे करी देणे। <verse eid="ISA 13:12" /><verse number="13" style="v" sid="ISA 13:13" />इजी री खातर मां सर्ग ईलाणा ओर तरती आपणी जगा ते कनारे ऊई जाणी, ये सेना रे यहोवे रे रोषो रिया बजा ते ओर तेसरे पड़के रे गुस्से रे दिने ऊणा। <verse eid="ISA 13:13" /><verse number="14" style="v" sid="ISA 13:14" />बेबीलोनो दे रणे वाल़े परदेशी नठाए रे ईरण या बिना गवाल़े री पेडा जेड़े आपणे-आपणे लोका रिया तरफा खे फिरने ओर आपणे-आपणे देशो खे नठी जाणे।”<verse eid="ISA 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 13:15" />जो कोई मिलणा, से काई देणा ओर जो कोई पकड़ेया जाणा से तलवारी साथे काया जाणा। <verse eid="ISA 13:15" /><verse number="16" style="v" sid="ISA 13:16" />नठदे ऊए लोका रे बाल-बच्चे तिना सामणे जमीना पाँदे पटकी देणे ओर तिना रे कअर लूटी देणे ओर तिना रिया जवाणसा प्रष्ट करी देणियां। <verse eid="ISA 13:16" /><verse number="17" style="v" sid="ISA 13:17" />यहोवे बोलेया, “देखो, मां बेबीलोनो रे खलाफ मादी लोक उकसाणे, जिना ना तो चाँदिए रे बारे दे सोचणा ओर ना सूईने रा लाल़च करना। <verse eid="ISA 13:17" /><verse number="18" style="v" sid="ISA 13:18" />तिना तीरे की जवान काणे ओर बच्चेया पाँदे कोई दया नि करनी ना तरस खाणी।”<verse eid="ISA 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 13:19" />बाबेल जो सबी राजा ते ऊच्चा ए ओर जेसरी सुन्दरता पाँदे कसदी लोक फूलोए, से एड़ा ऊई जाणा जेड़ा सदोम ओर गमोरा शईर, जेबे परमेशरे सेयो उल्टी ते थे।<note caller="+" style="f"><char style="fr" closed="false">13:19 </char><char style="ft" closed="false">उत्प. 19:23-29 </char></note> <verse eid="ISA 13:19" /><verse number="20" style="v" sid="ISA 13:20" />बेबीलोन फेर कदी नि बसणा ओर युगो-युगो तक तिदे केसी नि रणा, अरबी लोका बी तिदे डेरा खड़ा नि करना ओर ना ग्वाल़ेया तिदे आपणे डांगर चराणे। <verse eid="ISA 13:20" /><verse number="21" style="v" sid="ISA 13:21" />तेती जंगल़ी जानवर रणे ओर उल्लूआ तिना रे कअरा दे डेरा करना, तेती शुतुरमुर्ग बसणे ओर बणो रे बाकरे तेती नाचणे।<note caller="+" style="f"><char style="fr" closed="false">13:21 </char><char style="ft" closed="false">प्रका. 18:2 </char></note> <verse eid="ISA 13:21" /><verse number="22" style="v" sid="ISA 13:22" />बेबीलोनो रे किलेया दे जंगल़ी कुत्ते ओर तेसरे सुख-विलासो रे भवनो दे गीदड़ बोलेया करने, तेसरे नाश ऊणे रा बखत नेड़े आई गा रा ओर तेसरे दिन एबे थोड़े ई रयी गे रे।<verse eid="ISA 13:22" /></para>
  <chapter eid="ISA 13" />
  <chapter number="14" style="c" sid="ISA 14" />
  <para style="s">याकूबो पाँदे दया</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 14:1" />यहोवे आपणे लोका इस्राएलो पाँदे दया करनी ओर इस्राएल फेर अपनाई की, तिना रे ई देशो दे बसाणा ओर कई परदेशी लोक तिदे मिली जाणे ओर तिना आपणे आपू खे याकूबो रे वंशो साथे मिलाई लणा। <verse eid="ISA 14:1" /><verse number="2" style="v" sid="ISA 14:2" />कई देशा रे लोका इस्राएलो रे लोका री तेस देशो दे वापस आऊणे दे मताद करनी जो यहोवे तिना खे देई राखेया था। ओर इस्राएलो रा कराना परमेशरो री जमीना दे तिना रा अधिकारी ऊई जाणा ओर तिना सेयो दास-दासिया बनाणे, कऊँकि इस्राएली लोका सेयो बन्दी बनाणे जो तिना खे गुलामिया दे लईगे थे ओर जो तिना पाँदे अत्याचार करो थे, तिना पाँदे तिना राज करना।<verse eid="ISA 14:2" /></para>
  <para style="s">बाबेलो रे राजे रा नाश ऊणा</para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3" />जेस दिने यहोवा ताखे तेरे कष्टा ते ओर कबराणे ते ओर तेसा कठण मईणता ते जो तांते लई, राम देयोगा, <verse eid="ISA 14:3" /><verse number="4" style="v" sid="ISA 14:4" />तेबे तुसा ये गाणा गायी की बेबीलोनो रे राजे रा मजाक उडाणा, “मईणत कराणे वाल़ा केड़ा नाश ऊईगा, सुनहरे मईलो वाल़ा शईर केड़ा नाश ऊईगा रा। <verse eid="ISA 14:4" /><verse number="5" style="v" sid="ISA 14:5" />यहोवे दुष्टा रे सोठे ओर अन्याय साथे शासन करने वाल़ेया रे डण्डे तोड़ी ते दे, <verse eid="ISA 14:5" /><verse number="6" style="v" sid="ISA 14:6" />जिना ते सेयो माणूंआ खे लगातार रोषो रे मारे बांदे रओ थे ओर जातिया-जातिया पाँदे रोषो साथे राज करी की ओर लगातार तिना पीछे पड़े रे रओ थे। <verse eid="ISA 14:6" /><verse number="7" style="v" sid="ISA 14:7" />एबे सारी तरतिया रे लोका खे राम मिली रा, से चैनो साथे ए, लोक जोरे की गाओए।” <verse eid="ISA 14:7" /><verse number="8" style="v" sid="ISA 14:8" />सनौबर ओर लबानोनो रे देवदार बी तां पाँदे खुशिया रे गाणे गाओ, “जदुओ ते तूँ थाले सेटेया, तदुओ ते कोई बी आसा खे बाडणे नि आया।” <verse eid="ISA 14:8" /><verse number="9" style="v" sid="ISA 14:9" />पताल़ो निठे अधलोक मतलब मरेया री जगा दे तां साथे मिलणे खे अलचल ऊणे लगी री, से तेरिया तँईं मुड़देया खे, मतलब तरतिया रे सबी सरदारा खे जगाओआ ओर से जातिया-जातिया ते सबी राजेया खे तिना रे सिंहासनो ते चकी की खड़ा करोआ। <verse eid="ISA 14:9" /><verse number="10" style="v" sid="ISA 14:10" />सेयो सारे बेबीलोनो रे पईलके राजे खे बुलाओए, “क्या तूँ बी आसा जेड़ा कमजोर ऊईगा रा? क्या तूँ आसा जेड़ा ई बणी गा रा? <verse eid="ISA 14:10" /><verse number="11" style="v" sid="ISA 14:11" />तेरा वैभव ओर तेरी सारंगिया री आवाज अधलोको दे उतारी राखी, कीड़े तेरा बछौणा ओर कंसल़ोई तेरा टखण ए।”<verse eid="ISA 14:11" /></para>
  <para style="s">लूसिफरो रा नाश ऊणा</para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 14:12" />ओ प्यागा रे चमकणे वाल़े तारे<note caller="+" style="f"><char style="fr" closed="false">14:12 </char><char style="fq" closed="false">ओ प्यागा रे चमकणे वाल़े तारे </char><char style="ft" closed="false">बेबीलोनो रा राजा </char></note>, तूँ किंयाँ सर्गो ते थाले पड़ेया? तूँ जो जातिया-जातिया खे अराई देयो था, तूँ एबे केड़ा बाडी की जमीना दे सेटी राखेया?<note caller="+" style="f"><char style="fr" closed="false">14:12 </char><char style="ft" closed="false">लूक. 10:18, यहे. 28:13-17 </char></note> <verse eid="ISA 14:12" /><verse number="13" style="v" sid="ISA 14:13" />तूँ मनो दे बोले तो था, “मां स्वर्गो दे चढ़ना, मां आपणा सिंहासन परमेशरो रे तारेया ते जादा ऊच्चा करना ओर उत्तर दिशा रे कूणे पाँदे सभा रे पाह्ड़ो पाँदे बैठणा;<note caller="+" style="f"><char style="fr" closed="false">14:13 </char><char style="ft" closed="false">मत्ती 11:23, लूक. 10:15 </char></note> <verse eid="ISA 14:13" /><verse number="14" style="v" sid="ISA 14:14" />मां बादल़ो ते बी ऊच्ची-ऊच्ची जगा ते पाँदे चढ़ना, आऊँ परमपरदान परमेशरो जेड़ा ऊई जाणा।” <verse eid="ISA 14:14" /><verse number="15" style="v" sid="ISA 14:15" />पर तूँ अधलोको रे गड्डे रिया थालिया दे सेटेया।<note caller="+" style="f"><char style="fr" closed="false">14:15 </char><char style="ft" closed="false">मत्ती 11:23 लूक. 10:15</char></note> <verse eid="ISA 14:15" /><verse number="16" style="v" sid="ISA 14:16" />जिना तूँ देखणा, तिना ताखे देखी की तेरे बारे दे सोच-बिचार करी की बोलणा, “क्या ये सेई मर्द ए जो तरतिया खे चैना साथे रणे नि देयो था ओर राज-राज खे डराई देयो था, <verse eid="ISA 14:16" /><verse number="17" style="v" sid="ISA 14:17" />जो दुनिया खे जंगल़ बणाओआ ओर तिना रे शईर टाल़ी देयो था ओर आपणे गुलामा खे कअरे नि जाणे देयो था।” <verse eid="ISA 14:17" /><verse number="18" style="v" sid="ISA 14:18" />जातिया-जातिया रे सब राजा आपणे-आपणे कअरो दे महिमा साथे रामो दे पड़ी रे। <verse eid="ISA 14:18" /><verse number="19" style="v" sid="ISA 14:19" />पर तूँ नकम्मी पाँगटिया जेड़ा आपणी कब्रा बीचा ते बारे सेटेया गया, तेरे चऊँ कनारे काये रे मुड़दे पड़ी रे, जो तलवारी साथे काई की गड्डेया दे पात्थरा बीचे सेटी री लाशा जेड़े पड़ी रे। <verse eid="ISA 14:19" /><verse number="20" style="v" sid="ISA 14:20" />तूँ ओरी राजेया जेड़ा कब्रा दे नि दबाणा, कऊँकि तैं आपणा देश उजाड़ी ता ओर आपणी प्रजा काई राखी। कुकर्मिया रे कुलो रा नाओं बी कदी नि लया जाणा। <verse eid="ISA 14:20" /><verse number="21" style="v" sid="ISA 14:21" />लोक ईंयाँ बोलोए, तिना रे बुजुर्गा रे पापो रिया बजा ते राजे रे पाऊआ खे काणे री त्यारी करो, एड़ा नि ओ कि सेयो फेर उठी की तरतिया रे अधिकारी ऊई जाओ ओर दुनिया दे बऊत सारे शईर बसाओ।<verse eid="ISA 14:21" /></para>
  <para style="s">परमेशरो रा बाबेलो खे नाश करना</para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 14:22" />सेना रे यहोवे री ये बाणी ए, “मां तिना रे खलाफ उठणा ओर बाबेलो रा नाओं-नशाण मिटाई देणा ओर माठे-पोते बाडी देणे।” यहोवे री येई बाणी ए। <verse eid="ISA 14:22" /><verse number="23" style="v" sid="ISA 14:23" />“मां बेबीलोन उल्लूआ रे कअर ओर पाणिए री नदी करी देणी ओर मां से सत्यानाशो रे जुड़े साथे चाड़ी देणा।” सेना रे यहोवे री ये बाणी ए।<verse eid="ISA 14:23" /></para>
  <para style="s">अश्शूरिया रा नाश ऊणा</para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 14:24" />सेना रे यहोवे ये कसम खाई राखी, “पक्का जेड़ा मैं ठाणी राखेया, तेड़ा ई ऊई जाणा ओर जेड़ी मैं योजना करी राखी, तेड़ी ई पूरी ऊणी। <verse eid="ISA 14:24" /><verse number="25" style="v" sid="ISA 14:25" />मां अश्शूर आपणे ई इस्राएल देशो दे तोड़ी देणा ओर आपणे पाह्ड़ा पाँदे से माँडी देणा; तेबे तेसरा जूँगड़ा तिना री क्याड़िया पाँदा ते ओर तेसरा बोजा तिना री कांदा पाँदा ते उतरी जाणा।” <verse eid="ISA 14:25" /><verse number="26" style="v" sid="ISA 14:26" />येई योजना सारी तरतिया खे ठराई राखी ओर ये सेई आथ ए, जो सबी जातिया पाँदे बढ़ी रा। <verse eid="ISA 14:26" /><verse number="27" style="v" sid="ISA 14:27" />कऊँकि सेना रे यहोवे योजना करी राखी ओर तिजी खे कुण टाल़ी सकोआ? तेसरा आथ सजा देणे खे आगे बढ़ायी राखेया, तिजी खे कुण रोकी सकोआ?<verse eid="ISA 14:27" /></para>
  <para style="s">पलिश्तीन देशो रा नाश</para>
  <para style="p">
    <verse number="28" style="v" sid="ISA 14:28" />जेस साले यहूदा रा राजा आहाज मरेया, तेस साले ई ये पारी भविष्यबाणी मांगे आई थी, <verse eid="ISA 14:28" /><verse number="29" style="v" sid="ISA 14:29" />“ओ सारे पलिश्तीन तूँ इजी री खातर खुशी नि मना कि ताखे मारने वाल़े राजा मरीगा। पर तेसरे एकी पाऊए आई की राज करना। से तुसा खे एकी एड़े सापो जेड़ा ऊणा जेस जईरीले नाग पैदा करने। से नवां राजा तुसा खे एक खतरनाक नागो जेड़ा ऊणा। <verse eid="ISA 14:29" /><verse number="30" style="v" sid="ISA 14:30" />पर मेरे गरीब लोका रे बच्चेया बिना डरे खाणा ओर जरूरतमंद लोक बिना डरे रणे, पर ओ पलिश्तीन मां तेरा कुल अकाल़ पाई की काई देणा ओर तेरे बचे रे लोक काये जाणे।” <verse eid="ISA 14:30" /><verse number="31" style="v" sid="ISA 14:31" />ओ शईरो रे बड़े द्वार, तूँ हाय, हाय कर; ओ शईर, तूँ मतादा रिया तँईं रोओ, ओ पलिश्तीन, तूँ सारा का सारा गल़ी जा! कऊँकि उत्तरा रिया तरफा ते एक तुआँ उठणा ओर तेसरी सेना बीचा ते कोई पीछे नि रणा। <verse eid="ISA 14:31" /><verse number="32" style="v" sid="ISA 14:32" />तेबे पलिश्ती देशो रे दूता खे क्या ज्वाब देया जाणा? ये कि यहोवे सिय्योनो री निऊँ पायी राखी ओर तेसरी प्रजा रे दीन लोका तिदे शरण लणी।<verse eid="ISA 14:32" /></para>
  <chapter eid="ISA 14" />
  <chapter number="15" style="c" sid="ISA 15" />
  <para style="s">मोआबो खे परमेशरो रा सनेआ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 15:1" />ए बुरा सन्देस मोआब देशो रे बारे दे ए। एकी राती मोआब देशो रे आर ओर कीर शईर सिपाईए लूटिते तेसा ई राती से शईर नाश बी करीते। ओर मोआब दुश्मणा रे जरीये नाश करिता दा ए। <verse eid="ISA 15:1" /><verse number="2" style="v" sid="ISA 15:2" />बैत ओर दीबोन शईरो रे लोक मन्दरो पाँदे रोणे खे ऊबे पाह्ड़ो चढ़ीगे, नबो ओर मेदबा शईरो रिया तँईं मोआब हाय, हाय करोआ। तिना सबी रे सिर गँजे ओर सबी री दाढ़िया बी गँजिया ए। <verse eid="ISA 15:2" /><verse number="3" style="v" sid="ISA 15:3" />मोआबो रे लोके सड़का दे ये दखाणे खे कि सेयो दु:खी ए शोगो रिया टाटा पईनी राखिया, छता पाँदे<note caller="+" style="f"><char style="fr" closed="false">15:3 </char><char style="fq" closed="false">छता पाँदे </char><char style="ft" closed="false">छत तेस बखते सीदे ई ओ थे, इजी री खातर लोक कई बजा ते कअरो रे छतो पाँदे कट्ठे ऊई सको थे, जेते दे कट्ठे मिली की शोग मनाणा बी ओ था। </char></note> ओर शईरो रे चौका दे हर कोई आसू बाह्ंदे ऊए हाय, हाय करोए। <verse eid="ISA 15:3" /><verse number="4" style="v" sid="ISA 15:4" />हेशबोन ओर एलाले शईरो रे लोक चींगणे लगी रे, ओर तिना री आवाज यहस शईरो तक सुणोई, इजी बजा ते मोआबो रे सिपाई चींगणे लगी रे, तिना रा जियू बऊत उदास ए। <verse eid="ISA 15:4" /><verse number="5" style="v" sid="ISA 15:5" />मेरा मन मोआबो खे दुहाई देयोआ, तेसरे अमीर लोक सोअर ओर एग्लतशलीशिया शईरो खे नठणे लगी रे। देखो, लूहीत शईरो री पाह्ड़िया री क्वाल़िया दे सेयो रोंदे ऊए चढ़ने लगी रे; सुणो, होरोनैम शईरो री बाटा दे सेयो नाश ऊणे खे चींगणे लगी रे। <verse eid="ISA 15:5" /><verse number="6" style="v" sid="ISA 15:6" />निम्रीम नदिया रा पाणी सूकीगा, काआ बी सूकीगा ओर अरीयाली मुरझाई गी ओर कोई सीन्नक नि रयी। <verse eid="ISA 15:6" /><verse number="7" style="v" sid="ISA 15:7" />इजी री खातर जो तअन तिने बचाई की राखेया ओर जो कुछ तिने कट्ठा कित्तेया था, तेस सबी खे सेयो तेसा काट्टिया ते पार निणे लगी रे, जिदे बियूँसो रे डाल़ ए। <verse eid="ISA 15:7" /><verse number="8" style="v" sid="ISA 15:8" />इजी बजा ते मोआब देशो दे हर केथी मुसीबता दे चींगणा ई सुणने लगी रा। तेथो रा हाहाकार दक्खणा दे एग्लैम शईर ओर उत्तरा दे बेरेलीम शईरो दे बी सुणोआ। <verse eid="ISA 15:8" /><verse number="9" style="v" sid="ISA 15:9" />कऊँकि दीमोन शईरो री नदी खूनो साथे परी री ए, तेबे बी मां दीमोनो खे ओर दु:ख देणे, मां बचे रे मोआबिया खे ओर तिना रे देशो ते नठे रे लोका रे खलाफ शेर पेजणे।<verse eid="ISA 15:9" /></para>
  <chapter eid="ISA 15" />
  <chapter number="16" style="c" sid="ISA 16" />
  <para style="s">मोआब देशो खे ओर बी विपत्तिया</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 16:1" />ओ मोआब देशो रे लोको, सेला शईरो ते उजाड़ जगा रिये ऊँदे ऊए सिय्योनो<note caller="+" style="f"><char style="fr" closed="false">16:1 </char><char style="fq" closed="false">सिय्योनो </char><char style="ft" closed="false">यरूशलेमो रा पाह्ड़ </char></note> री बेटिया रे पाह्ड़ो पाँदे देशो रे परदाना खे पेडा रे बच्चे पेजो। <verse eid="ISA 16:1" /><verse number="2" style="v" sid="ISA 16:2" />मोआब देशो री बेटिया अर्नोनो रिया नदिया पाँदे एड़िया दिशोईया जेड़े की पंछिया रे बच्चे उजड़े रे कोअले रिया बजा ते पटकदे रओए।<verse eid="ISA 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 16:3" />मोआबो रे दूत यहूदा रे लोका खे बोलोए आसा रे बारे दे सलाअ-मशवरा करो, म्हारी मताद करो ओर म्हारेया दुश्मणा ते आसा री रक्षा करो, जेड़ा डाल़ त्याड़िया री तूपा दे जमीना खे छांए देओआ। आसा खे आसा रे दुश्मणा रे आथो दे नि पकड़वाओ। <verse eid="ISA 16:3" /><verse number="4" style="v" sid="ISA 16:4" />मेरे लोक जो निकयाल़े रे ए सेयो तां बीचे रओ, नाश करने वाल़े ते मोआबो खे बचाओ। पीसणे वाल़ा नि रया, लूट-पाट फेर नि ऊणी, कऊँकि देशो ते अन्देर करने वाल़े नाश ऊईगे रे। <verse eid="ISA 16:4" /><verse number="5" style="v" sid="ISA 16:5" />तेबे दया साथे परमेशरो एक सिंहासन स्थापित करना ओर तेते पाँदे दाऊदो रे तम्बूए दे सच्चाईया साथे एक बैठणा, जेस सोची-समजी की सच्चा न्याय करना ओर तर्मो रे काम करेया करने। <verse eid="ISA 16:5" /><verse number="6" style="v" sid="ISA 16:6" />यहूदा रे लोक बोलोए, “आसे मोआबो रे बारे दे सुणी राखेया कि से बऊत कमण्डी था, तेसरे कमण्ड, गर्व ओर रोषो रे बारे दे बी सुणी राखेया पर तेसरा बड़ा बोल सच्चा नि ए।” <verse eid="ISA 16:6" /><verse number="7" style="v" sid="ISA 16:7" />मोआबो रे लोका आपणे दु:खो रिया बजा ते हाय, हाय करनी, सारे के सारेया मोआबो रिया तँईं हाहाकार करनी। कीरहरासत शईरो री किशमिशा खे तिना बऊत नराज ऊई की लाम्बे-लाम्बे साआ लया करने। <verse eid="ISA 16:7" /><verse number="8" style="v" sid="ISA 16:8" />कऊँकि हेशबोन शईरो रे डोरू ओर सिबमा शईरो रे अंगूरा रे बगीचे मुरझाई गे रे, जातिया-जातिया रे अधिकारिए तिना री अच्छिया-अच्छिया बेला बाडी-बाडी की सेटी ती रिया, सेयो याजेर शईरो तक पऊँचीया ओर जंगल़ो दे बी फैली गिया ओर बढ़दे-बढ़दे तालो ते पार दूरो तक बढ़ी गी थिया। <verse eid="ISA 16:8" /><verse number="9" style="v" sid="ISA 16:9" />इजी री खातर मां तिना लोका साथे रोणा जो याजेरो ओर सिबमा शईरो दे रणे वाल़े ए कऊँकि अंगूरा रिया बेला खराब ऊईगिया। मां हेशबोन ओर एलाले शईरो रे लोका साथे शोग करना, कऊँकि तुसा रे गर्मिया रे फल़ो रे ओर फसला री बडाईया रे बखतो री ललकार सुणने लगी री। <verse eid="ISA 16:9" /><verse number="10" style="v" sid="ISA 16:10" />फल़ वाल़े अंगूरा रे बगीचे ते खुशी ओर मगन रणा चली गा, अंगूरा रे बगीचे दे गाणा नि गाया जाणा, मां बडाईया रे बखतो री सारी खुशी खत्म करी देणी। ओर अंगूरा रे रसो रे कुण्डो दे केसी अंगूर नि केसणे, कऊँकि मां तिना रे खुशिया रे शब्द बन्द करने। <verse eid="ISA 16:10" /><verse number="11" style="v" sid="ISA 16:11" />इजी री खातर आऊँ मोआब देशो रे लोका रिया तँईं बऊत दु:खी ए। आऊँ कीरहेरेस शईरो रिया तँईं बऊत दु:खी ए। आऊँ तिना शईरा रिया तँईं बऊत दु:खी ए। <verse eid="ISA 16:11" /><verse number="12" style="v" sid="ISA 16:12" />जेबे मोआबो रे लोक आपणे पाह्ड़ी मन्दरो दे प्रार्थना करने खे जांदे-जांदे थकी जाओए, पर एते ते तिना खे कोई फायदा नि ऊणा। <verse eid="ISA 16:12" /><verse number="13" style="v" sid="ISA 16:13" />येई से गल्ल ए जो यहोवे इजी ते पईले मोआबो रे बारे दे बोली थी। <verse eid="ISA 16:13" /><verse number="14" style="v" sid="ISA 16:14" />पर एबे यहोवे ईंयाँ बोली राखेया, “ठीक तीऊँ साला दे, सेयो मजदूरा रे रूपो दे गिणने पाँदे मोआबो रा वैभव ओर तेसरा पीड़-पड़ाका सब बेकार ठईरना ओर बाकी जो थोड़े बचणे सेयो बिना साअरे ते ऊई जाणे।”<verse eid="ISA 16:14" /></para>
  <chapter eid="ISA 16" />
  <chapter number="17" style="c" sid="ISA 17" />
  <para style="s">परमेशरो रा दमिश्क ओर इस्राएलो खे सजा देणा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 17:1" />यहोवे री दमिश्क शईरो रे बारे दे पारी भविष्यबाणी, दमिश्क शईर एबे शईर नि रणा, से खंडहर ई खंडहर ऊई जाणा। <verse eid="ISA 17:1" /><verse number="2" style="v" sid="ISA 17:2" />अरोएरो रे शईरा रे शईर उजाड़ ऊई जाणे, सेयो डांगरा रे चूण्डो रे चरने री जगा बणी जाणे, डांगर तिदे रणे ओर तिना खे कोई नठाणे वाल़ा नि ऊणा। <verse eid="ISA 17:2" /><verse number="3" style="v" sid="ISA 17:3" />एप्रैमो रे गढ़वाल़े शईर, दमिश्को रा राज ओर बचे रे अरामी, तीनो बादो ते नि रणे ओर जो दशा इस्राएलो रे लोका रे वैभवो री ऊई, सेई तिना री ऊणी, सेना रे यहोवे री येई बाणी ए। <verse eid="ISA 17:3" /><verse number="4" style="v" sid="ISA 17:4" />यहोवे बोलेया, “तिना दिना दे याकूबो री तअन दौलत चली जाणी याकूब तेड़ा ऊई जाणा जेड़ा आदमी बमारिया ते पतल़ा ओआ।” <verse eid="ISA 17:4" /><verse number="5" style="v" sid="ISA 17:5" />से बखत एड़ा ऊणा जेड़ा रपाईम नाओं री काअटिया दे फसल बाडणे रे बखते ओआ। काम करने वाल़े खड़िया फसला बाडी की कट्ठी करोए जो डोरुए दे लगोई तेबे सेओ तिना सिल्लेया खे बाडोए ओर तिना ते नज्जो रे दाणे निकयाल़ोए। <verse eid="ISA 17:5" /><verse number="6" style="v" sid="ISA 17:6" />से बखत तेस बखतो जेड़ा ऊणा जेबे लोक जैतूनो री फसल निकयाल़ोए लोक जैतूनो रे डाल़ो ते जैतून चाड़दे बखते कुछ फल़ रयी जाओए, मतलब डाल़िया पाँदे दो-तीन फल़ ओर फल़ो वाल़ी डाल़िया दे केथी-केथी चार-पाँज फल़ रयी जाओए, तेड़े ई तिने सिल्ले बाडे ऊणे, इस्राएलो रे परमेशर यहोवे री येई बाणी ए।<verse eid="ISA 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 17:7" />तेस बखते लोका परमेशरो रिया तरफा खे देखणा परमेशर, जिने से बणाये। तिना इस्राएलो रे पवित्र परमेशरो रिया तरफा खे मतादा रिया तँईं देखणा। <verse eid="ISA 17:7" /><verse number="8" style="v" sid="ISA 17:8" />लोका तिना आपणी बणाई री बेदिया रिया तरफा खे नि देखणा ओर ना आपणी बणाई री अशेरा देविया रे नाओं री मूर्तिया या सूरजो री मूर्तिया री तरफा खे देखणा।<note caller="+" style="f"><char style="fr" closed="false">17:8 </char><char style="ft" closed="false">मीका 5:13,14 </char></note> <verse eid="ISA 17:8" /><verse number="9" style="v" sid="ISA 17:9" />जेबे से दिन आऊणा, इस्राएलिया रे मजबूत शईर कणे बण ओर तिना री ऊजड़ जगा पाह्ड़ो री चूँडिया जेड़े ऊणे, जो इस्राएली लोका रे डरो ते छाडी ते थे<note caller="+" style="f"><char style="fr" closed="false">17:9 </char><char style="ft" closed="false">खाली ओर खण्डहरा रे रूपो दे छाडे दे तिना शईरा जेड़े जिना खे हित्ती ओर एमोरी लोक इस्राएलिया रे लोका ते नठदे बखते छाडी गे थे। </char></note> ओर सेयो ऊजड़ पड़े रे रणे। <verse eid="ISA 17:9" /><verse number="10" style="v" sid="ISA 17:10" />कऊँकि तूँ ओ इस्राएल, आपणे उद्धारकर्ता परमेशरो खे पूली गा ओर आपणी मजबूत चट्टान याद नि राखी, इजी बजा ते चाए तूँ, अच्छिया डाल़िया लगाए ओर परदेशी डाल़िया री कलम चढ़ाए, <verse eid="ISA 17:10" /><verse number="11" style="v" sid="ISA 17:11" />एक दिन तुसा आपणी अँगूरो री रिया बेला लगाणे रे दिने तूँ तिना रे चऊँ कनारे बाड़ा लगाए ओर प्यागा खे ई तिना रे फूल खिलणे लगो, तेबे बी पछतावे ओर बऊत दु:खो रे दिने तेतेरा फल़ नाश ऊई जाणा।<verse eid="ISA 17:11" /></para>
  <para style="s">परमेशरो रा आपणे लोका री रक्षा करना</para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 17:12" />सुणो, लाणत, लाणत ए! सबी देशा दे बऊत सारे लोका रा केड़ा दहाड़ने रा शब्द ऊणे लगी रा, सेयो समुद्रो री लईरा जेड़े दहाड़ने लगी रे। राज-राज रे लोक केड़े दहाड़ने लगी रे, सेयो प्रचण्ड खाड्डा जेड़ी आवाज करोए! <verse eid="ISA 17:12" /><verse number="13" style="v" sid="ISA 17:13" />राज्य-राज्य रे लोक बाढ़ी रे बऊत पाणिए जेड़ा आल्ला करोए, पर परमेशर तिना खे बकणा ओर सेयो दूर नठी जाणे ओर एड़े उडाए जाणे जेड़ा पाह्ड़ो रा काआ-पतूड़ अवा साथे ओर तूड़ पऊण-चूखाने साथे कूमायी की उडाई जाओई। <verse eid="ISA 17:13" /><verse number="14" style="v" sid="ISA 17:14" />तेसा राती दुश्मण देशा रे जरीये इस्राएली लोक बऊत ई डरी जाणे। प्याग ऊणे ते पईले, कुछ बी नि बचणा। दुश्मणा खे तेती कुछ बी आथे नि आऊणा सेयो यहूदा रे पागो रिया तरफा खे आऊणे, पर तेती बी कुछ नि ऊणा।<verse eid="ISA 17:14" /></para>
  <chapter eid="ISA 17" />
  <chapter number="18" style="c" sid="ISA 18" />
  <para style="s">कूशो रिया तँईं परमेशरो रा सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 18:1" />लाणत ए तेसा जमीना खे जो कूशो रिया नदिया साथे-साथे फैली री। ए जमीन टिड्डिया ते परी री ए। तुसे तिना पंखा रा फड़फड़ाणा सुणी सकोए। <verse eid="ISA 18:1" /><verse number="2" style="v" sid="ISA 18:2" />ओर समुद्रो पाँदे दूता खे नंगल़ो री किस्तिया दे बठयाल़ी की नील नदिया री बाटा ते ये बोली की पेजेया, “ओ फुर्तिले दूतो, एक एड़िया जातिया रे लोका गे जाओ जेसा रे लोक तगड़े ओर सुन्दर ए, जो शुरूओ ते आजो तक डराऊणे ए, जो नापणे ओर केसणे वाल़ा बीए ओर जिना रा देश बड़ी नदिया साथे दो इस्से दे करी राखेया।” <verse eid="ISA 18:2" /><verse number="3" style="v" sid="ISA 18:3" />सुणो, तरतिया रे सब रणे वाल़े लोको, जेबे लड़ाईया खे चण्डे खे पाह्ड़ो पाँदे खड़ा करो, तो तेसखे देखो! जेबे नरसिंगा बजोगा, तेबे सुणो! <verse eid="ISA 18:3" /><verse number="4" style="v" sid="ISA 18:4" />कऊँकि यहोवे मांगे ईंयाँ बोली राखेया, “तूपा री तेज गर्मी या बडाईया रे बखतो दे बर्खा वाल़े बादल़ो जेड़ा मां शान्त ऊई की देखणा। <verse eid="ISA 18:4" /><verse number="5" style="v" sid="ISA 18:5" />कऊँकि अंगूर तोड़ने रे बखतो ते पईले जेबे फूल फूली चुके ओर अंगूरा रे गुच्छे पाकणे लगे, तेबे यहोवे तिना रिया पाँगटिया दाचिया साथे बाडणियां ओर फैली रिया डाल़िया तोड़ी-तोड़ी की लग सेटी देणियां। <verse eid="ISA 18:5" /><verse number="6" style="v" sid="ISA 18:6" />सेयो अँगूर ओर फैलणे वाल़ी डाल़िया<note caller="+" style="f"><char style="fr" closed="false">18:6 </char><char style="fq" closed="false">सेयो अँगूर ओर फैलणे वाल़ी डाल़िया </char><char style="ft" closed="false">इथोपिया सिपाईया रिया लाशा </char></note> पाह्ड़ो रे मासाहारी पंछीया<note caller="+" style="f"><char style="fr" closed="false">18:6 </char><char style="fq" closed="false">मासाहारी पंछीया </char><char style="ft" closed="false">इल्ला </char></note> खे ओर बणो रे डांगरा खे खाणे रिया तँईं छाडी देणियां। गर्मिया दे पंछीया इना अँगूरा रिया बेला दे रणा ओर सारे प्रकारा रे बणो रे डांगरा तिना खे खांदे-खांदे ठण्ड बीताणी। <verse eid="ISA 18:6" /><verse number="7" style="v" sid="ISA 18:7" />तेस बखते जेसा जातिया रे लोक<note caller="+" style="f"><char style="fr" closed="false">18:7 </char><char style="fq" closed="false">जेसा जातिया रे लोक </char><char style="ft" closed="false">सेयो इथोपिया रे लोक </char></note> तगड़े ओर सुन्दर ऊणे ओर जो शुरूओ ते ई डराऊणे ऊँदे आई रे ओर नापणे ओर केसणे वाल़े ए ओर जिना रा देश नदिया साथे दो इस्से करी राखेया, तेसा जातिया ते सेना रे यहोवे रे नाओं री जगा, सिय्योन पाह्ड़ो<note caller="+" style="f"><char style="fr" closed="false">18:7 </char><char style="fq" closed="false">सिय्योन पाह्ड़ो </char><char style="ft" closed="false">यरूशलेम </char></note> पाँदे सेना रे यहोवे गे पेंट पऊँचाया जाणी।”<verse eid="ISA 18:7" /></para>
  <chapter eid="ISA 18" />
  <chapter number="19" style="c" sid="ISA 19" />
  <para style="s">परमेशरो रा मिस्र देशो खे सजा देणा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 19:1" />मिस्र देशो रे बारे दे परमेशरो री पारी भविष्यबाणी। देखो, यहोवा चट ई उडणे वाल़े बादल़ो पाँदे सवार ऊई की मिस्र देशो दे आऊणे लगी रा ओर मिस्रो रिया मूर्तिया तेसरे आऊणे ते थरथराई जाणिया ओर मिस्रिया रा दिल पाणी-पाणी ऊई जाणा।<note caller="+" style="f"><char style="fr" closed="false">19:1 </char><char style="ft" closed="false">यहे. 30:13, प्रका. 1:7 </char></note> <verse eid="ISA 19:1" /><verse number="2" style="v" sid="ISA 19:2" />यहोवा बोलोआ, मां मिस्रो रे लोक एकी-दूजे रे खलाफ पड़काणे ओर सेयो आपू-बीचे लड़ने, हर एक आपणे पाईए साथे ओर हर एक आपणे पड़ोसिये साथे लड़ना। शईर-शईरो रे ओर राज-राज रे खलाफ लड़ने।<note caller="+" style="f"><char style="fr" closed="false">19:2 </char><char style="ft" closed="false">मत्ती 10:21, 36 </char></note> <verse eid="ISA 19:2" /><verse number="3" style="v" sid="ISA 19:3" />जेबे आऊँ तिना री योजना दे गड़बड़ी करी देऊँआ तेबे मिस्रिया री बुद्धि मारी जाणी ओर मां तिना रिया योजना बेकार करी देणियां ओर तिना आपणी मूर्तिया गे ओर जादू ओर मरी री आत्मा साथे गल्ला करने वाल़ेया गे जाई-जाई की पूछणा, <verse eid="ISA 19:3" /><verse number="4" style="v" sid="ISA 19:4" />पर मां मिस्री एक अत्याचार करने वाल़े राजे रे आथो दे करी देणे ओर एक शक्तिशाली राजे तिना पाँदे राज करना, सेना रे यहोवे री येई बाणी ए।<verse eid="ISA 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 19:5" />तेबे नील नदिया रा पाणी सूकी जाणा ओर नदी सूकी की खाली ऊई जाणी। <verse eid="ISA 19:5" /><verse number="6" style="v" sid="ISA 19:6" />नाल़े ते सड़यान आऊणे लगणी, ओर मिस्रो री नदिया बी सूकी जाणिया ओर नंगल़ ओर बियूँसो रे डाल़ मुरझाई जाणे। <verse eid="ISA 19:6" /><verse number="7" style="v" sid="ISA 19:7" />नील नदिया रा कनारा ऊजड़ी जाणा ओर तेथो री जमीना रा काआ ओर जो कुछ नील नदिया रे नेड़े-तेड़े बाणा, से सूकी की बर्बाद ऊई जाणा ओर तिजी रा कोई पता पनि लगणा। <verse eid="ISA 19:7" /><verse number="8" style="v" sid="ISA 19:8" />सारे मच्छुआरे, ओर सेओ सारे लोक जितणे नील नदिया दे मछल़ी पकड़ने खे ऊक सेटोए, दु:ख करना ओर लाम्बे-लाम्बे साआ लणे ओर जो पाणिए पाँदे जाल़ सेटोए, सेयो उदास ऊई जाणे। <verse eid="ISA 19:8" /><verse number="9" style="v" sid="ISA 19:9" />तेबे जो लोक रेशमो रा काम करोए ओर जो सूत बूणोए, तिना री उम्मीद टूटी जाणी। <verse eid="ISA 19:9" /><verse number="10" style="v" sid="ISA 19:10" />मिस्रो रे अमीर ओर मजदूर उदास ऊई जाणे। <verse eid="ISA 19:10" /><verse number="11" style="v" sid="ISA 19:11" />पक्का सोअन शईरो रे सारे परदान मूर्ख ए ओर फिरौनो रे अक्लमंद मन्त्रिया री योजना डांगरा जेड़ी ठईरी। तेबे तुसे फिरौनो खे किंयाँ बोली सकोए कि आऊँ अक्लमंदो रा पाऊ ओर पुराणे राजेया री ल्वाद ए? <verse eid="ISA 19:11" /><verse number="12" style="v" sid="ISA 19:12" />ओ मिस्रो रे राजा तेरे अक्लमंद मर्द केयी ए? तिना अक्लमंद लोका खे ओर मिस्रो रिया तँईं यहोवे जो योजना बणाई राखी, तिजी रा पता ऊणा चाईओ। तिना लोका खे, जो ऊणे वाल़ा ए, तुसा खे बताणा चाईओ।<note caller="+" style="f"><char style="fr" closed="false">19:12 </char><char style="ft" closed="false">1 कुरि. 1:20 </char></note> <verse eid="ISA 19:12" /><verse number="13" style="v" sid="ISA 19:13" />सोअनो रे परदान मूर्ख बणी गे दे, नोप शईरो रे परदाने तोखा खाई राखेया ओर जिना पाँदे मिस्रो रे गोत्रो रे परदाना रा परोसा था, तिने मिस्र परमाई ता रा। <verse eid="ISA 19:13" /><verse number="14" style="v" sid="ISA 19:14" />यहोवे मिस्रिया दे बईम पैदा करी राखेया, सेओ पटकी गे ओर मिस्रो खे गल़त बाटा रिये निणे लगी रे। सेओ नशेड़िये जेड़े ऊईगे दे जो बमारिया रिया बजा ते जमीना पाँदे ओरे-पोरे मरेलणे लगी रे। <verse eid="ISA 19:14" /><verse number="15" style="v" sid="ISA 19:15" />मिस्रो खे कोई एड़ा काम नि रणा जो सिरो ते या पूँछा ते<note caller="+" style="f"><char style="fr" closed="false">19:15 </char><char style="fq" closed="false">सिरो ते या पूँछा ते </char><char style="ft" closed="false">खजूरो रिया पाँगटिया या नंगल़ </char></note> या परदान या आम माणूंए ते ऊई सको।<verse eid="ISA 19:15" /></para>
  <para style="s">मिस्रो परमेशरो री आराधना करनी</para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 19:16" />तेस बखते मिस्री लोक, जवाणसा जेड़े ऊई जाणे ओर सेना रे यहोवे जेस तिना पाँदे आपणा आथ बढ़ाणा, तेसरे डरो रे मारे सेयो काँबी जाणे ओर डरी जाणे। <verse eid="ISA 19:16" /><verse number="17" style="v" sid="ISA 19:17" />मिस्रो रे सारे लोका रिया तँईं यहूदा रा देश डरो री बजा ऊणा मिस्रो दे कोई बी यहूदा रा नाओ सुणी की डरी जाणा। एड़ा इजी खे ऊणा कऊँकि यहोवे डराऊणी कटणा कटाणे री योजना बनाई राखी। <verse eid="ISA 19:17" /><verse number="18" style="v" sid="ISA 19:18" />तेस बखते मिस्र देशो रे पाँज शईर ऊणे जेती लोका कनानो री इब्रानी पाषा बोलणी। ओर यहोवे री कसम खाणी। तिना बीचा ते एकी रा नाओं सूर्या शईर राखेया जाणा। <verse eid="ISA 19:18" /><verse number="19" style="v" sid="ISA 19:19" />तेस बखते मिस्र देशो बीचे यहोवे खे एक बेदी ऊणी। मिस्रो रे बन्ने रे नेड़े यहोवे खे एक खम्बा खड़ा ऊणा। <verse eid="ISA 19:19" /><verse number="20" style="v" sid="ISA 19:20" />से मिस्र देशो रे सेना रे यहोवे खे नशाण ओर गवाई ठईरना ओर जेबे तिना अन्देर करने वाल़ेया रिया बजा ते यहोवे ते मतादा खे बोलणा, तेबे यहोवे तिना री रक्षा करने खे एक आदमी पेजणा, ओर तेस सेयो आजाद करने। <verse eid="ISA 19:20" /><verse number="21" style="v" sid="ISA 19:21" />तेबे यहोवे आपू मिस्रिया सामणे आऊणा ओर मिस्रिया तेस बखते यहोवा पछयाणना ओर मेलबलि ओर नज्जो री बलि चढ़ाई की तेसरी आराधना करनी ओर यहोवे खे मान्नता मानी की पूरी बी करनी। <verse eid="ISA 19:21" /><verse number="22" style="v" sid="ISA 19:22" />यहोवे मिस्रो रे लोका खे सजा देणी। फेर यहोवे सेओ ठीक बी करने ओर सेयो यहोवे रिया तरफा खे फिरने ओर तेस तिना री प्रार्थना सुणी की सेयो ठीक करने। <verse eid="ISA 19:22" /><verse number="23" style="v" sid="ISA 19:23" />तेस बखते मिस्र देशो ते अश्शूर देशो खे जाणे खे एक मुख्य बाट ऊणी ओर अश्शूरी मिस्रो रे आऊणे ओर मिस्री लोक अश्शूरो खे जाणे ओर मिस्रिया अश्शूरिया साथे मिली की परमेशरो री आराधना करेया करनी। <verse eid="ISA 19:23" /><verse number="24" style="v" sid="ISA 19:24" />तेस बखते इस्राएल, मिस्र ओर अश्शूर तीनो मिली की आपू बीचे एक ऊई जाणे ओर तरतिया खे आशीषा री बजा ऊणे। <verse eid="ISA 19:24" /><verse number="25" style="v" sid="ISA 19:25" />कऊँकि सेना रे यहोवे तिना तीऊँ खे ये बोली की आशीष देणी, “तन्य ओ मेरी मिस्री प्रजा ओर मेरे बणाए दे अश्शूरी लोक ओर मेरा आपणा इस्सा इस्राएली लोक।”<verse eid="ISA 19:25" /></para>
  <chapter eid="ISA 19" />
  <chapter number="20" style="c" sid="ISA 20" />
  <para style="s">नांगे नबीए रा नशाण</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1" />जेस बखते अश्शूरो रे राजा सर्गोनो री आज्ञा ते तर्त्ताने पलिश्तिया रे शईर अशदोदो दे आई की तेस साथे युद्ध कित्तेया ओर तेस पाँदे आपणा कब्जा करी ला। <verse eid="ISA 20:1" /><verse number="2" style="v" sid="ISA 20:2" />तेस बखते यहोवे आमोसो रे पाऊ यशायाह खे बोलेया, “जाई की आपणे लको री शोगो री टाट खोल ओर आपणे बूट खोल।” यशायाहे यहोवे री आज्ञा मानी ओर से बगैर टाल्लेया ते नांगा ओर पताणे पैरे कूमणे फिरने लगेया। <verse eid="ISA 20:2" /><verse number="3" style="v" sid="ISA 20:3" />तेबे यहोवे बोलेया, “जिंयाँ मेरा दास यशायाह तीऊँ साला ते बगैर टाल्लेया ते नांगा ओर बगैर बूटा ते पताणे पैरे चलदा आई रा, ताकि मिस्र ओर कूश देशो खे नशाण ओर उदारण ओ, <verse eid="ISA 20:3" /><verse number="4" style="v" sid="ISA 20:4" />तिंयाँ ई अश्शूरो रे राजे मिस्र ओर कूश देशो रे लोका खे बन्दी बणाई की देश निकाल़ा देणा, क्या बच्चे, क्या स्याणे, सारे बन्दी बणाई की नांगे ओर पताणे पैरे ओर पूरे नांगे लई जाणे, ताकि मिस्र शर्मिंदा ओ। <verse eid="ISA 20:4" /><verse number="5" style="v" sid="ISA 20:5" />जो लोक मतादा रिया तँईं कूश देशो रिया तरफा खे देखेया करो थे, ओर मिस्र, जेसरी बजा ते पलिश्ती कमण्ड करो थे, बेचैन ओर शर्मिंदा ऊई जाणा।” <verse eid="ISA 20:5" /><verse number="6" style="v" sid="ISA 20:6" />तेस दिने तेबे भूमध्य समुद्रो रे कनारे रणे वाल़े पलिश्ती ओर यहूदा रे लोका बोलणा, “देखो, जिना पाँदे मिस्रो रे लोक उम्मीद राखो थे ओर जिना गे आसे अश्शूरो रे राजे ते बचणे खे नठणे वाल़े थे, तिना री एड़ी दशा ऊई गी री, तो तेबे आसे लोक किंयाँ बची सकूँ थे?”<verse eid="ISA 20:6" /></para>
  <chapter eid="ISA 20" />
  <chapter number="21" style="c" sid="ISA 21" />
  <para style="s">बाबेलो रे नाशो रा दर्शण</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 21:1" />समुद्रो<note caller="+" style="f"><char style="fr" closed="false">21:1 </char><char style="fq" closed="false">समुद्रो </char><char style="ft" closed="false">ये फरात नदी ओर तेतेरे पाणिये की टकी री दलदला रे सारे इलाके खे बताओआ </char></note> रे नेड़े री उजाड़ जगा रे बारे दे परमेशरो री पारी भविष्यबाणी, जिंयाँ यहूदा रे दक्खणा<note caller="+" style="f"><char style="fr" closed="false">21:1 </char><char style="fq" closed="false">यहूदा रे दक्खणा </char><char style="ft" closed="false">बेबीलोन </char></note> ते प्रचण्ड तूफान आओआ, से जंगल़ो ते मतलब, डराऊणे देशो ते नेड़े आऊणे लगी रा। <verse eid="ISA 21:1" /><verse number="2" style="v" sid="ISA 21:2" />परमेशरे माखे कष्टो रिया गल्ला रा दर्शण दखाया, विश्वासघाती विश्वासघात करोआ ओर नाश करने वाल़ा नाश करोआ। ओ एलामो रे लोको, अमला कर, ओ मादै रे लोको, केरी लो, तेसरा सारा कणना आऊँ बन्द करी देऊँआ। <verse eid="ISA 21:2" /><verse number="3" style="v" sid="ISA 21:3" />इजी बजा ते मेरे लको दे बऊत पीड़ ए; माखे मानो बच्चा पैदा करने री जी पीड़ा ऊणे लगी रिया, आऊँ एड़ी मुसीबता दे पड़ीगा रा कि कुछ सुणदा नि, आऊँ एड़ा कबराईगा रा कि कुछ दिशदा नि। <verse eid="ISA 21:3" /><verse number="4" style="v" sid="ISA 21:4" />मेरा दिल धड़कोआ, आऊँ बऊत डरीगा रा, जेसा साँजा खे आऊँ न्याल़ूँ था, से तिने मेरे डरने री बजा बणाई ती री। <verse eid="ISA 21:4" /><verse number="5" style="v" sid="ISA 21:5" />दर्शणो दे बेबीलोनो रे लोक पाट्टिया री त्यारी करने लगी रे, चादरी बछाणे लगी रे, खाणे-पीणे लगी रे। अचाणक एक आवाज सुणने लगी; ओ सेना रे परदानो, आपणियां ढाला दे तेल लगाओ! <verse eid="ISA 21:5" /><verse number="6" style="v" sid="ISA 21:6" />कऊँकि प्रभुए माखे ईंयाँ बोली राखेया, “जाई की एक पईरेदार खड़ा करी दे ओर से जो कुछ देखो से बताओ। <verse eid="ISA 21:6" /><verse number="7" style="v" sid="ISA 21:7" />जेबे से चौकीदार देखो, जो दो-दो करी की आओए ओर गह्दे ओर ऊँटा रे सवार, तेबे बऊत ई त्यान देई की सुणो।” <verse eid="ISA 21:7" /><verse number="8" style="v" sid="ISA 21:8" />तेबे पईरेदारे शेरो री आवाजा जेड़ी आक पायी, “ओ स्वामी, आऊँ पूरा दिन खड़े ऊई की पईरा देंदा रया ओर मैं पूरी रात बी पईरा दित्तेया। <verse eid="ISA 21:8" /><verse number="9" style="v" sid="ISA 21:9" />तेबे मैं क्या देखेया कि माणूंआ रा दल ओर दो-दो करी की कोड़ेया रे सवार आऊणे लगी रे!” तेबे तिने ज्वाब दित्तेया, “टल़ी गा, बाबेल टल़ी गा ओर तेथो रे सबी देवतेया रिया कअड़ी रिया मूर्तिया जमीना दे चकनाचूर करी ती रिया।”<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false">प्रका. 14:8, प्रका. 18:2 </char></note> <verse eid="ISA 21:9" /><verse number="10" style="v" sid="ISA 21:10" />तेबे यशायाहे बोलेया, “ओ मेरे फड़ाके रे ओर मेरे खल्याणो रे नज्ज, जो गल्ला मैं इस्राएलो रे परमेशर सेना रे यहोवे ते सुणी राखिया, सेयो मैं तुसा गे बताई ती रिया।”<verse eid="ISA 21:10" /></para>
  <para style="s">एदोम देशो खे परमेशरो रा सन्देश</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 21:11" />परमेशर एदोमो रे बारे दे ईंयाँ बोलोआ। सेईर पाह्ड़ो ते कोई माखे आका पाणे लगी रा, “ओ पईरेदार, रात कितणी बची री? ओ पईरेदार रात एबु कितणी देर ओर रणी?”<note caller="+" style="f"><char style="fr" closed="false">21:11 </char><char style="ft" closed="false">उत्प. 32:3 </char></note> <verse eid="ISA 21:11" /><verse number="12" style="v" sid="ISA 21:12" />पईरेदारे ज्वाब दित्तेया, “प्याग ऊणे वाल़ी ए ओर रात फेर आऊणी। जे तूँ मांते कुछ पूछणा चाएया तो वापस आओ ओर मांते पूछी लो।”<verse eid="ISA 21:12" /></para>
  <para style="s">अरबो रिया तँईं परमेशरो रा सन्देश</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 21:13" />अरब देशो रे बारे दे परमेशरो रा पारी वचन: ओ ददानी शईरो रे यात्रियो<note caller="+" style="f"><char style="fr" closed="false">21:13 </char><char style="fq" closed="false">ओ ददानी शईरो रे यात्रियो </char><char style="ft" closed="false">ये ऊँटा या गह्देया रा एक चूण्ड ओआ जो समान टोणे रा काम करो थे। </char></note>, तुसा खे अरबो रे जंगल़ो दे रात बिताणी पड़नी। <verse eid="ISA 21:13" /><verse number="14" style="v" sid="ISA 21:14" />ओ तेमा देशो रे रणे वाल़ेयो, जो त्याये ए तिना खे पाणी देयो ओर जो आपणे दुश्मणा ते बची की नठणे लगी रे तिना खे मिली की रोटी खाणे खे देयो। <verse eid="ISA 21:14" /><verse number="15" style="v" sid="ISA 21:15" />कऊँकि सेयो लोक तलवारी रे सामणे ते, बल्कि नांगी तलवारी सामणे ते ओर ताणे रे धनुष ओर घोर युद्धो ते नठी रे। <verse eid="ISA 21:15" /><verse number="16" style="v" sid="ISA 21:16" />प्रभुए माखे बोलेया, “मजदूरो रे साला रे मुताबिक एकी सालो दे केदारो<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="fq" closed="false">केदारो </char><char style="ft" closed="false">केदारो रे गोत्रो </char></note> रे सारे वैभवो रा अन्त ऊई जाणा। <verse eid="ISA 21:16" /><verse number="17" style="v" sid="ISA 21:17" />ओर केदारो रे धनुर्धारी शूरवीरा बीचा ते थोड़े ई रयी जाणे, कऊँकि इस्राएलो रे परमेशर यहोवा एड़ा बोली राखेया।”<verse eid="ISA 21:17" /></para>
  <chapter eid="ISA 21" />
  <chapter number="22" style="c" sid="ISA 22" />
  <para style="s">यरूशलेम शईरो रिया तँईं परमेशरो रा सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 22:1" />परमेशरे ये वचन दर्शणो री तराईया रे बारे दे देई राखेया।<note caller="+" style="f"><char style="fr" closed="false">22:1 </char><char style="ft" closed="false">ये सन्देश माखे यरूशलेम, दर्शणो री काअटिया रे बारे दे मिली रा। </char></note> शईरो रे सारे लोक खुशी मनाणे खे आपणे कअरा री छता पाँदे कऊँ जाणे लगी रे?<note caller="+" style="f"><char style="fr" closed="false">22:1 </char><char style="ft" closed="false">एक इस्राएली कअरो री छत सीदी ओ थी, ओर बारली कांदा साथे जमीना ते ऊबे जाणे खे पैड़िया ओ थिया। </char></note> <verse eid="ISA 22:1" /><verse number="2" style="v" sid="ISA 22:2" />ओ आल्ले-गोल्ले ते ओर हुड़दंगो ते परी रे यरूशलेम शईरो रे लोको, तुसा बीचे जो काई राखे, सेयो ना तो तलवारी साथे ओर ना युद्धो दे काई राखे। <verse eid="ISA 22:2" /><verse number="3" style="v" sid="ISA 22:3" />तेरे सारे न्यायी कट्ठे नठीगे ओर बिना धनुषो ते बन्दी बणाईते रे। तेरे जितणे बाकी रईगे, सेयो सब कट्ठे बानी ते, तेबे बी सेयो दूर नठीगे थे। <verse eid="ISA 22:3" /><verse number="4" style="v" sid="ISA 22:4" />इजी बजा ते आऊँ एड़ा बोलूँआ की मा कनारे नि देखो, बस माखे रोणे देओ यरूशलेम शईरो रे सत्यानाश ऊणे ते माखे शान्ति देणे री कोशिश नि करो। <verse eid="ISA 22:4" /><verse number="5" style="v" sid="ISA 22:5" />सेना रे प्रभु यहोवे रा ठराया रा दिन ऊणा, जेबे दर्शणो री तराईया दे आल्ला-गोल्ला ओर केसेया जाणा ओर बेचैनी ऊणी। दवाला दे सुरंग लगाई जाणी ओर दुहाईया री आवाज पाह्ड़ो दे पऊँचणी। <verse eid="ISA 22:5" /><verse number="6" style="v" sid="ISA 22:6" />एलाम देशो रे कोड़ेया रे सवार सिपाई आपणे-आपणे तर्कश बानी की लड़ाईया खे त्यार ए, ओर कीर शईरो रे सिपाईया ढाला दे बड़ी छेड़ करनी। <verse eid="ISA 22:6" /><verse number="7" style="v" sid="ISA 22:7" />तेरी अच्छी-अच्छी तराईया रथो साथे परी रिया ऊणिया ओर सवार बड़े द्वारो सामणे अथियार बाने रे ऊणे। तिने यरूशलेम शईरो रा द्वार खोली ता रा। <verse eid="ISA 22:7" /><verse number="8" style="v" sid="ISA 22:8" />तेस बखते यहूदा री रक्षा रा सारा काम बेकार ऊईगा दा ए। जेबे एड़ा ऊआ, तो तुसे जंगल़ो रे मईलो ते अथियार लई की आए। <verse eid="ISA 22:8" /><verse number="9" style="v" sid="ISA 22:9" />ओर तैं दाऊदपुरो<note caller="+" style="f"><char style="fr" closed="false">22:9 </char><char style="fq" closed="false">दाऊदपुरो </char><char style="ft" closed="false">यरूशलेमो </char></note> री दवाला री दरारा देखिया कि सेओ बऊत ए ओर तैं थालले खाल़ा रा पाणी कट्ठा कित्तेया। <verse eid="ISA 22:9" /><verse number="10" style="v" sid="ISA 22:10" />तेबे तैं यरूशलेम शईरो दे कअर गिणी की दवाल मजबूत करने खे कअर टाल़ी ते। <verse eid="ISA 22:10" /><verse number="11" style="v" sid="ISA 22:11" />तैं दुँईं कांदा बीचे पुराणे खाल़ा रे पाणिए खे एक कुण्ड खणेया। पर तैं तेसरा बनाणे वाल़ा याद नि कित्तेया, परमेशरे से पुराणे बखतो ते बणाई राखेया था ओर ना तैं तेसरी तरफा खे देखेया। <verse eid="ISA 22:11" /><verse number="12" style="v" sid="ISA 22:12" />तेस बखते सेना रे प्रभु यहोवे रोणे-पीटणे, सिर गँजा करने ओर टाट पईनणे खे बोलेया था। <verse eid="ISA 22:12" /><verse number="13" style="v" sid="ISA 22:13" />पर तिने क्या देखेया कि खुशी ओर मजे ऊणे लगी रे, गायी-बल़द ओर पेडा बाकरिया खे काणे लगी रे, तुसे तिना रे मासो पाँदे पाट्टी करोए, ओर बोलोए, “आओ, खाओ-पियो, कऊँकि काल तो आसे मरी सकूँए।”<note caller="+" style="f"><char style="fr" closed="false">22:13 </char><char style="ft" closed="false">1 कुरि. 15:32 </char></note> <verse eid="ISA 22:13" /><verse number="14" style="v" sid="ISA 22:14" />सेना रे यहोवे ये गल्ला मा साथे बोलिया थिया ओर आपणे मनो री गल्ल बताई, “पक्का तुसा लोका रे एस पापो रा कोई प्राश्चित तुसा री मौता तक नि ऊई सकणा”, सेना रे प्रभु यहोवे री येई बाणी ए।<verse eid="ISA 22:14" /></para>
  <para style="s">शेबना खे चतौणी</para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 22:15" />सेना रे प्रभु यहोवे मांगे आई की ईंयाँ बोलेया, “शेबना नाओं रे तेस पण्डारिये गे जो राजकराने रे कामो पाँदे नियुक्त ए, जाई की बोल, <verse eid="ISA 22:15" /><verse number="16" style="v" sid="ISA 22:16" />तेसते पूछणा, तूँ एती क्या करने लगी रा? एती तेरा कुण ए कि तैं आपणी कब्र एती खणायी? तूँ आपणी कब्र ऊच्ची जगा दे खणाएया ओर आपणे रणे री जगा चट्टानी दे खणाएया? <verse eid="ISA 22:16" /><verse number="17" style="v" sid="ISA 22:17" />देख, यहोवे तूँ बड़ी सामर्था साथे पकड़ी की बऊत दूर करी देणा। <verse eid="ISA 22:17" /><verse number="18" style="v" sid="ISA 22:18" />यहोवे तूँ मरोड़ी की गींदो जेड़ा लाम्बे-चौड़े देशो दे सेटी देणा। आपणे दुश्मण मालक जेसरी तुसे सेवा करोए तेसरे कराने खे बेज्जत करने वाल़े तेती तुँ मरना ओर तेरे वैभवो रे रथ तेथी ई रई जाणे। <verse eid="ISA 22:18" /><verse number="19" style="v" sid="ISA 22:19" />मां तूँ तेरी जगा ते तकेली की बारे करी देणा ओर तूँ तेरे बड़े पदो ते उतारी देणा।” <verse eid="ISA 22:19" /><verse number="20" style="v" sid="ISA 22:20" />यहोवे शेबना ते बोलेया, “जेस दिने ये ऊणा तेस बखते मां हिल्किय्याह रा पाऊ आपणा दास एल्याकीम बुलाई की, तेसखे तेरा चोगा पन्याणा। <verse eid="ISA 22:20" /><verse number="21" style="v" sid="ISA 22:21" />तेसरे लको दे तेरा अधिकारो वाल़ा पटका गूड़ी की बानणा ओर तेरा सारा काम जो तूँ करेया तांते लई की तेसरे आथो दे देई देणा। से सेवक यरूशलेम शईरो रे लोका ओर यहूदा रे कराने रे लोका खे बाओ जेड़ा ठईरना।”<verse eid="ISA 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 22:22" />मां से राजे रे कब्जे दे, दाऊदो रे वंशो दे पूरा अधिकार देणा। ओर से केसी द्वारो खे खोलोगा तेबे से द्वार खुला ई रणा। कोई बी आदमी तेसखे बन्द नि करी सकणा; जे से केसी द्वारो खे बन्द करोगा तेबे से द्वार बंद ऊई जाणा। कोई बी आदमी तेसखे खोली नि सकदा से सेवक आपणे बाओ रे कअरो दे एक सिंहासनो जेड़ा ऊणा।<note caller="+" style="f"><char style="fr" closed="false">22:22 </char><char style="ft" closed="false">प्रका. 3:7 </char></note> <verse eid="ISA 22:22" /><verse number="23" style="v" sid="ISA 22:23" />मां से मजबूत जगा दे किलेया जेड़ा दबाणा ओर से आपणे बाओ रे कराने खे महिमा वाल़े सिंहासनो जेड़ा ऊणा। <verse eid="ISA 22:23" /><verse number="24" style="v" sid="ISA 22:24" />तेसरे बाओ ते बच्चे ओर रिश्तेदारा रा सारा वैभव, कुल ओर बच्चे, सारे छोटे-छोटे पांडे, क्या कटोरे, ओर बड़ी-बड़ी सुराहिया, सब तेते पाँदे टाँगिया जाणिया। <verse eid="ISA 22:24" /><verse number="25" style="v" sid="ISA 22:25" />सेना रे यहोवे री येई बाणी ए, “जेस दिने एड़ा ऊणा तेस बखते से किल्ला जो मजबूत जगा दे लगाया था, से टीला ऊई जाणा ओर कटी की सेटी देणा ओर तेस पाँदला सारा पार छूटी जाणा, कऊँकि यहोवे ये बोली राखेया।”<verse eid="ISA 22:25" /></para>
  <chapter eid="ISA 22" />
  <chapter number="23" style="c" sid="ISA 23" />
  <para style="s">सोरो रे बारे दे सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 23:1" />सोर शईरो रे बारे दे पारी वचन। ओ तर्शीशो रे जाह्जो, हाय, हाय, करो, कऊँकि से ऊजड़ी गा, तेती ना तो कोई कअर ओर ना कोई रणे री जगा ए! ये गल्ला तिना खे कित्तिया रे देशो ते बताई राखिया ए। <verse eid="ISA 23:1" /><verse number="2" style="v" sid="ISA 23:2" />ओ समुद्रो रे नेड़े रणे वाल़े लोको, जो समुद्रो ते पार जाणे वाल़े सिदोनो रे बपारिये तअनो साथे परी ते दे, चुप रओ! <verse eid="ISA 23:2" /><verse number="3" style="v" sid="ISA 23:3" />सेओ लोक नज्जो रिया टोल़ा दे समुद्रो रिया बाटा रिये यात्रा करो थे। शीहोरो<note caller="+" style="f"><char style="fr" closed="false">23:3 </char><char style="fq" closed="false">शीहोरो </char><char style="ft" closed="false">मिस्र </char></note> रे लोक नील नदिया रे नेड़े री जमीना री फसल समुद्रो री बाटा रिये तेसखे मिलो थी, कऊँकि से ओरी जातिया खे बपारो री जगा थी। <verse eid="ISA 23:3" /><verse number="4" style="v" sid="ISA 23:4" />ओ सिदोन, शर्मिंदा ओ, कऊँकि समुद्रे, मतलब समुद्रो री मजबूत जगे ये बोली राखेया, “माखे ना तो बच्चा पैदा करने री पीड़ा रा पता ए ओर ना मैं कोई बाल़क पैदा करी राखेया ओर ना मैं कदी पाऊ-मुन्निया पाल़ी राखे।” <verse eid="ISA 23:4" /><verse number="5" style="v" sid="ISA 23:5" />जेबे सोरो रा सन्देश मिस्रो दे पऊँचो, तेबे सेयो सुणी की मुसीबता दे पड़ने।<verse eid="ISA 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 23:6" />ओ समुद्रो रे नेड़े रणे वाल़ेयो, हाय। हाय, करो! पार ऊई की तर्शीशो खे जाओ। <verse eid="ISA 23:6" /><verse number="7" style="v" sid="ISA 23:7" />क्या तुसे एस सोर शईरो दे खुश ए, जो पुराणे बखतो ते बसी रा था, जेस रे पैर तेसखे बसणे खे दूर लई जाओ थे? <verse eid="ISA 23:7" /><verse number="8" style="v" sid="ISA 23:8" />सोर शईर जो राजेया खे गद्दिया पाँदे बठयाल़ो था, जेसरे बपारी परदान थे ओर जेसरे महाजन पूरी तरतिया दे इज्जतदार थे, तेसरे खलाफ एड़ी योजना किने करी राखी?<note caller="+" style="f"><char style="fr" closed="false">23:8 </char><char style="ft" closed="false">यहे. 28:1,2,6-8 </char></note> <verse eid="ISA 23:8" /><verse number="9" style="v" sid="ISA 23:9" />सेना रे यहोवे ई तो एड़ी योजना करी राखी कि सारे कमण्डो खे तुच्छ करी देयो ओर पूरी तरतिया रे इज्जतदार लोका री बेज्जती कराओ।<verse eid="ISA 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 23:10" />ओ तर्शीश शईरो रे रणे वाल़ेयो, नील नदिया जेड़े आपणे देशो दे फैली जाओ, एबे कुछ बन्दन नि रया। <verse eid="ISA 23:10" /><verse number="11" style="v" sid="ISA 23:11" />यहोवे आपणा आथ समुद्रो पाँदे बढ़ाई की राज ईलाई ते रे, यहोवे कनानो रे मजबूत बजारो खे नाश करने री आज्ञा देई राखी। <verse eid="ISA 23:11" /><verse number="12" style="v" sid="ISA 23:12" />यहोवा बोलोआ ओ सिदोन शईरो रे लोका री प्रष्ट कित्ती री कुआँरी बेटी, तूँ फेर खुश नि ऊई सकदी, उठ, पार ऊई की कित्तिया रे देशो दे जा, पर तेती बी ताखे चैन नि मिलणा।<verse eid="ISA 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 23:13" />बेबीलोनो रे देशो खे देखो, से जाति एबे नि रयी, अश्शूरे से देश जंगल़ी जानवरा री जगा बणाई ती, तिने मोर्चा बन्दिया रे आपणे गुम्मट बणाए ओर राजमईल टाल़ी ते ओर सेयो खण्डहर करीते। <verse eid="ISA 23:13" /><verse number="14" style="v" sid="ISA 23:14" />ओ तर्शीशो रे जाह्जो, हाय, हाय, करो, कऊँकि तुसा री मजबूत जगा ऊजड़ी गी री। <verse eid="ISA 23:14" /><verse number="15" style="v" sid="ISA 23:15" />तेस बखते एक राजे रे दिनो रे मुताबिक सत्तर साल तक सोर पूलेया रा रणा। सत्तर साल बीतणे ते बाद सोर वेश्या जेड़ा गाणा गाणे लगणा। <verse eid="ISA 23:15" /><verse number="16" style="v" sid="ISA 23:16" />ओ पूली री वेश्या, बीणा लई की शईरो दे कूम, तू आपणे गीत ठीक-टंगो रे बजा, तू आपणे गीत गाया कर। तेबे तू लोका फेर याद करना।<note caller="+" style="f"><char style="fr" closed="false">23:16 </char><char style="ft" closed="false">ये तेस बखतो रे एक खास गाणे रे बोल ए। नबी इना खे सोरो रे भविष्य पाँदे इस्तेमाल करोआ जेबे से फेर बपारो दे शामिल ऊणा ओर वाणिज्य केन्द्रो रे रूपो दे आपणी खोई दी इज्जत वापस पाई लणी। </char></note> <verse eid="ISA 23:16" /><verse number="17" style="v" sid="ISA 23:17" />सत्तर साल बीतणे ते बाद यहोवे फेर सोर शईरो री सम्बाल़ लणी ओर तेसा फेर व्याभिचारो री कमाईया पाँदे मन लगाई की पूरी तरतिया रे सबी राजेया साथे व्याभिचार करना।<note caller="+" style="f"><char style="fr" closed="false">23:17 </char><char style="ft" closed="false">प्रका. 17:2 </char></note> <verse eid="ISA 23:17" /><verse number="18" style="v" sid="ISA 23:18" />जे सोरो रे बपार ओर व्याभिचारो री कमाई, यहोवे खे पवित्र करनी, से ना तो पण्डारो दे राखी जाणी ओर ना कट्ठी करी जाणी, कऊँकि जो कुछ तेसा रे बपारो ते मिली रा, से तिना रेई कामो दे आऊणा, जो यहोवे सामणे रया करने, ताकि तिना खे पेट परी की रोटी ओर अच्छे टाल्ले मिलो।<verse eid="ISA 23:18" /></para>
  <chapter eid="ISA 23" />
  <chapter number="24" style="c" sid="ISA 24" />
  <para style="s">परमेशरो तरतिया रा न्याय करना</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 24:1" />सुणो, यहोवा तरतिया खे बर्बाद करने वाल़ा ए, तेस तेसरी जगा नाश करी देणी ओर तेसरे लोक तित्तर-बित्तर करी देणे। <verse eid="ISA 24:1" /><verse number="2" style="v" sid="ISA 24:2" />तेस बखते हर केसी साथे एक जेड़ी कटणा कटणी, जेड़ी यजमानो री तेड़ी पुरोईतो री, जेड़ी दासो री तेड़ी मालको री, जेड़ी दासिया री तेड़ी मालकणिया री, जेड़ी लणे वाल़े री तेड़ी बेचणे वाल़े री, जेड़ी त्वार देणे वाल़े री तेड़ी त्वार लणे वाल़े री, जेड़ी ब्याज लणे वाल़े री, तेड़ी ब्याज देणे वाल़े री, सबी री एक जेड़ी दशा ऊणी। <verse eid="ISA 24:2" /><verse number="3" style="v" sid="ISA 24:3" />तरती खाली ओर सत्यानाश ऊई जाणी, कऊँकि ये यहोवे ई बोली राखेया। <verse eid="ISA 24:3" /><verse number="4" style="v" sid="ISA 24:4" />देश उजाड़ ओर दु:खी ऊई जाणा। दुनिया खाली ऊई जाणी ओर कमजोर ऊई जाणी। तरतिया साथे स्वर्ग बी कमजोर ऊई जाओए।<note caller="+" style="f"><char style="fr" closed="false">24:4 </char><char style="ft" closed="false">तरतिया रे सबी ते महान लोक बी नाश ऊई जाणे </char></note> <verse eid="ISA 24:4" /><verse number="5" style="v" sid="ISA 24:5" />एसा तरतिया रे रणे वाल़े लोका रिया बजा ते तरती अशुद्ध ऊई गी री, कऊँकि तिने परमेशरो रे बिधि-बिधानो खे नि मानेया ओर बिधि पलटी ती ओर सदा रणे वाल़ी वाचा तोड़ी ती। <verse eid="ISA 24:5" /><verse number="6" style="v" sid="ISA 24:6" />एसा तरतिया रे रणे वाल़े पापी ए। इजी बजा ते तरतिया खे परमेशरो रा स्राप पड़ना ओर तिदे रणे वाल़े दोषी ठईरने ओर इजी बजा तेई तरतिया रे रणे वाल़े स्वा ऊई जाणे ओर तेती थोड़े ई माणूं रयी जाणे। <verse eid="ISA 24:6" /><verse number="7" style="v" sid="ISA 24:7" />नया शराब नि रणा, अंगूरा री बेल मुरझाई जाणी ओर जितणे लोक मनो दे खुशी मनाओए, सबी लाम्बा-लाम्बा साआ लणा। <verse eid="ISA 24:7" /><verse number="8" style="v" sid="ISA 24:8" />डफलिया रा सुख देणे वाल़ा शब्द बन्द ऊई जाणा, खुश रणे वाल़ेया रा आल्ला नि रणा, बीणा रा सुख देणे वाल़ा शब्द शान्त ऊई जाणा।<note caller="+" style="f"><char style="fr" closed="false">24:8 </char><char style="ft" closed="false">यहे. 26:13, प्रका. 18:22 </char></note> <verse eid="ISA 24:8" /><verse number="9" style="v" sid="ISA 24:9" />एबे लोक जेबे शराब पियोए तेबे खुशिया रे गीत नि गांदे। एबे जेबे आदमी शराब पियोए तेबे से तिना खे कड़ुआ लगणा। <verse eid="ISA 24:9" /><verse number="10" style="v" sid="ISA 24:10" />गड़बड़ी मचाणे वाल़ा शईर नाश ऊणा, तेसरा हर एक कअर एड़ा बन्द करेया जाणा कि कोई बचणे खे तिदे कूसी नि सकणा। <verse eid="ISA 24:10" /><verse number="11" style="v" sid="ISA 24:11" />लोक सड़का दे शराबो रिया तँईं खे चींगणे, खुशी खत्म ऊई जाणी, देशो री सारी खुशी चली जाणी। <verse eid="ISA 24:11" /><verse number="12" style="v" sid="ISA 24:12" />शईर ऊजड़ ई रणा ओर तेथो रे शईरो रे बड़े द्वार तोड़ी की नाश करी देणे। <verse eid="ISA 24:12" /><verse number="13" style="v" sid="ISA 24:13" />कऊँकि तरतिया पाँदे देश-देशो रे लोका बीचे एड़ा ऊणा जेड़ा कि जैतूनो खे चाड़ने रे बखते या अंगूर तोड़ने ते बाद कोई-कोई फल़ रयी जाओए।<verse eid="ISA 24:13" /></para>
  <para style="s">पग्ता रा खुशी मनाणा</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 24:14" />पर बचे दे लोका आपणा गल़ा खोली की जयजयकार करनी ओर तिना समुद्रो ते ललकारी की बोलणा कि यहोवा महान ए। <verse eid="ISA 24:14" /><verse number="15" style="v" sid="ISA 24:15" />इजी री खातर पूर्ब देशा रे लोका तेसरी महिमा करनी। समुद्रो रे कनारे रणे वाल़ेया लोका तिना लोका इस्राएलो रे परमेशर यहोवे री स्तुति करनी।<note caller="+" style="f"><char style="fr" closed="false">24:15 </char><char style="ft" closed="false">मला. 1:11, यशा. 42:10 </char></note> <verse eid="ISA 24:15" /><verse number="16" style="v" sid="ISA 24:16" />तरतिया रे कूणे ते आसा खे एड़े गाणे री आवाज सुणोई कि तर्मिये री महिमा ओर तारीफ ओ। पर मैं बोलेया, “हाय, हाय! आऊँ नाश ऊईगा, नाश! कऊँकि विश्वासघाती विश्वासघात करोए, सेयो बड़ा विश्वासघात करोए।” <verse eid="ISA 24:16" /><verse number="17" style="v" sid="ISA 24:17" />ओ तरतिया पाँदे रणे वाल़े लोको, तुसा खे डर ओर गड्डा ओर फन्दा ए।<note caller="+" style="f"><char style="fr" closed="false">24:17 </char><char style="ft" closed="false">लूक. 21:35 </char></note> <verse eid="ISA 24:17" /><verse number="18" style="v" sid="ISA 24:18" />जो कोई डरो रे शब्दो ते नठोगा, से गड्डे दे रूड़ी जाणा ओर जो कोई गड्डे ते निकल़ोगा, से फन्दे रे फसी जाणा। कऊँकि सर्गो रे द्वार खुली जाणे ओर तरतिया री निऊँ ईलणे लगणी। <verse eid="ISA 24:18" /><verse number="19" style="v" sid="ISA 24:19" />तरती फटी की टुकड़े-टुकड़े ऊई जाणी, तरती बऊत काँबणी।<note caller="+" style="f"><char style="fr" closed="false">24:19 </char><char style="ft" closed="false">नहू. 1:5 </char></note> <verse eid="ISA 24:19" /><verse number="20" style="v" sid="ISA 24:20" />संसारो दे पाप बऊत पारी ए। तेते पारो ते दबी की ये तरती टल़ी जाणी। ये तरती चूँगड़िया जेड़ी ईलणी ओर नशे दे पड़े दे आदमिए जेड़ी तरती रूड़ी जाणी। ओर फेर नि उठणी। <verse eid="ISA 24:20" /><verse number="21" style="v" sid="ISA 24:21" />तेस बखते यहोवे सबी रा न्याय करना। सर्गो री सेना<note caller="+" style="f"><char style="fr" closed="false">24:21 </char><char style="fq" closed="false">सर्गो री सेना </char><char style="ft" closed="false">सर्गो रे देवते </char></note> खे सर्गो दे ओर तरतिया रे राजेया खे तरतिया पाँदे सजा देणी। <verse eid="ISA 24:21" /><verse number="22" style="v" sid="ISA 24:22" />स्वर्गो रे प्राणी ओर तरतिया रे राजा बन्दिया जेड़े गड्डे दे कट्ठे करे जाणे ओर जेला दे बन्द करे जाणे ओर कई दिना ते बाद तिना खे सजा देई जाणी। <verse eid="ISA 24:22" /><verse number="23" style="v" sid="ISA 24:23" />तेस बखते चाँद ओर सूरजो रा प्रयासा कम ऊई जाणा ओर येओ यहोवे सामणे शर्मिंदा ऊई जाणे, कऊँकि सेना रे यहोवे सिय्योनो रे पाह्ड़ो पाँदे ओर यरूशलेम शईरो दे आपणी प्रजा रे बुजुर्गा सामणे प्रतापो साथे राज करना।<verse eid="ISA 24:23" /></para>
  <chapter eid="ISA 24" />
  <chapter number="25" style="c" sid="ISA 25" />
  <para style="s">परमेशरो री स्तुतिया रा गीत</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 25:1" />ओ यहोवा, तूँ मेरा परमेशर ए,</para>
  <para style="q" vid="ISA 25:1">आऊँ तेरे नाओं री स्तुति करूँआ, मां तेरे नाओं रा तन्यवाद करना,</para>
  <para style="q" vid="ISA 25:1">कऊँकि तैं अचम्बे रे काम करी राखे, तैं पुराणे बखतो ते सच्चाईया साथे योजना करी राखी।<verse eid="ISA 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 25:2" />तैं म्हारे दुश्मणा रा शईर खत्म करिता। ओर तेथो रे गढ़वाल़े शईर खण्डहर करी राखे,</para>
  <para style="q" vid="ISA 25:2">तैं परदेशिया रे मईल एड़े उजाड़े कि से शईर नि रया, से फेर कदी बसाया नि जाणा।<verse eid="ISA 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 25:3" />इजी बजा ते शक्तिशाली राज्य रे लोका तेरी महिमा करनी,</para>
  <para style="q" vid="ISA 25:3">डराऊणी जातिया रे शईरो दे तेरा डर मानेया जाणा।<verse eid="ISA 25:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 25:4" />कऊँकि तूँ मुसीबता रे बखते शरीफा खे गढ़ ओर जेबे डराऊणे लोक माट्टिया रे पीता पाँदे बर्खा री छाछा जेड़े बरसो थे,</para>
  <para style="q" vid="ISA 25:4">तेबे तूँ गरीबा खे तिना री शरण ओर गर्मिया दे छांए देणे वाल़ा ऊआ।<verse eid="ISA 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 25:5" />जेड़े मरूस्थल देशो दे बादल़ो री छांयी ते गर्मी ठण्डी ओई,</para>
  <para style="q" vid="ISA 25:5">तेड़ा ई तूँ परदेशिया रा आल्ला ओर दुष्ट लोका री जयजयकार बन्द करेया।<verse eid="ISA 25:5" /></para>
  <para style="s">आपणे लोका खे परमेशरो रा खाणा</para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 25:6" />सेना रे यहोवे एस पाह्ड़ो<note caller="+" style="f"><char style="fr" closed="false">25:6 </char><char style="fq" closed="false">पाह्ड़ो </char><char style="ft" closed="false">सिय्योन पाह्ड़ </char></note> पाँदे ई सबी देशा रे लोका खे एड़ी पाट्टी त्यार करनी, जिदे कई प्रकारा रा तल़ेया रा खान-पान ओर अच्छा शराब ऊणा। <verse eid="ISA 25:6" /><verse number="7" style="v" sid="ISA 25:7" />पर एबे देखो, जो पर्दा सबी देशा रे लोका पाँदे पड़ी रा, जो कूँडा सबी जातिया पाँदे लटकी रा, तेस से सिय्योन पाह्ड़ो पाँदे ई नाश करना।<note caller="+" style="f"><char style="fr" closed="false">25:7 </char><char style="ft" closed="false">इफि. 4:18 </char></note> <verse eid="ISA 25:7" /><verse number="8" style="v" sid="ISA 25:8" />यहोवे मौत सदा खे नाश करनी ओर प्रभु यहोवे सबी रे मुंए पाँदा ते आसू टूसणे ओर आपणी प्रजा री बेज्जती सारी तरतिया पाँदा ते दूर करनी, कऊँकि यहोवे एड़ा ई बोली राखेया था।<note caller="+" style="f"><char style="fr" closed="false">25:8 </char><char style="ft" closed="false">1 कुरि. 15:54, प्रका. 7:17, प्रका. 21:4 </char></note> <verse eid="ISA 25:8" /><verse number="9" style="v" sid="ISA 25:9" />जेस दिने एड़ा ऊणा तेस बखते लोका बोलणा, “देखो, म्हारा परमेशर येई ए, ये सेईए जेसखे आसे न्याल़ूँ थे कि से म्हारा उद्धार करो। यहोवा येई ए, आसे एसखे न्याल़दे आई रे, आसे एसते उद्धार पायी की खुश ओर मगन ऊणे।”<verse eid="ISA 25:9" /></para>
  <para style="s">परमेशरो मोआबो खे सजा देणी</para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 25:10" />कऊँकि एस सिय्योनो रे पाह्ड़ो पाँदे यहोवे रा आथ सदा बणेया दा रणा पर मोआब आपणी जगा देई एड़ा फानणा, जेड़ा खल्याणो दे पराल़ फानोए। <verse eid="ISA 25:10" /><verse number="11" style="v" sid="ISA 25:11" />मोआबिये आपणे आथ एड़े फैलाणे, जेड़ा कोई तरने री कोशिश करने लगी रा ओ, पर परमेशरो सेयो बेज्जत करने ओर तिना री चलाकी निष्फल करी देणी। <verse eid="ISA 25:11" /><verse number="12" style="v" sid="ISA 25:12" />यहोवे लोका रिया ऊच्ची-ऊच्ची ओर मजबूत दवाल तेस थाले करी देणी ओर निठी करी देणी, बल्कि जमीना दे सेटी की माट्टिया दे मलाई देणी।<verse eid="ISA 25:12" /></para>
  <chapter eid="ISA 25" />
  <chapter number="26" style="c" sid="ISA 26" />
  <para style="s">परमेशरो रा एक स्तुतिया रा गीत</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 26:1" />मोआबो रे नाशो रे दिने यहूदा रे लोका ये गाणा गाणा,</para>
  <para style="q" vid="ISA 26:1">“म्हारा एक मजबूत शईर ए! परमेशर म्हारे शईरो री रक्षा करोआ, से एक दवाला जेड़ा ए।<verse eid="ISA 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 26:2" />शईरो रे बड़े द्वार खोलो, परोसे जोगी जातिया खे पीतरे आऊणे देओ।</para>
  <para style="q" vid="ISA 26:2">मतलब तेसा जातिया खे जेसरे लोक तर्मो रा काम करदे ओ।<verse eid="ISA 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 26:3" />ओ यहोवा, जेसरे मने तां पाँदे सब्र राखी राखेया,</para>
  <para style="q" vid="ISA 26:3">तेसरी तूँ पूरी शान्तिया साथे रक्षा करेया,</para>
  <para style="q" vid="ISA 26:3">कऊँकि से तां पाँदे परोसा राखोआ।<note caller="+" style="f"><char style="fr" closed="false">26:3 </char><char style="ft" closed="false">फिलि. 4:7</char></note><verse eid="ISA 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 26:4" />परमेशरो पाँदे सदा परोसा राख,</para>
  <para style="q" vid="ISA 26:4">कऊँकि परमेशर यहोवा सदा रणे वाल़ी चट्टान ए।<verse eid="ISA 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 26:5" />से ऊच्चे पद वाल़ेया खे चुकाई देयोआ, जो शईर उची जगा दे बसी रा, तेसखे से थाले करी देयोआ।</para>
  <para style="q" vid="ISA 26:5">से तिजी खे जमीना पाँदे सेटी की माट्टिया दे मलायी देयोआ।<verse eid="ISA 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 26:6" />ओ यहोवा, तेबे दीन ओर नम्र लोका शईरो रे खण्डहर आपणे पैरा साथे केसणे।”<verse eid="ISA 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 26:7" />तर्मिये री बाट सच्चाई ए, तूँ जो आपू तर्मी यहोवा ए,</para>
  <para style="q" vid="ISA 26:7">तूँ तर्मिये री अगुवाई करेया।<verse eid="ISA 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 26:8" />ओ यहोवा, तेरे न्याय री बाटा दे आसे लोक ताखे न्याल़दे आई रे,</para>
  <para style="q" vid="ISA 26:8">मारा मन ताखे ओर तेरे नाओं खे यादा करना चाओआ।<verse eid="ISA 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 26:9" />मेरा मन रात पर तां साथे रणा चाओआ,</para>
  <para style="q" vid="ISA 26:9">मेरा मन पूरी कोशिश करी की ताखे टोल़ोआ,</para>
  <para style="q" vid="ISA 26:9">कऊँकि जेबे तेरे न्याय रे काम तरतिया पाँदे बताओए,</para>
  <para style="q" vid="ISA 26:9">तेबे दुनिया रे रणे वाल़े लोक तार्मिकता खे सीखो ए।<verse eid="ISA 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 26:10" />जे तुसे दुष्टो पाँदे दया बी करी देयो, तेबे बी से ठीक कर्म करना नि सकदा,</para>
  <para style="q" vid="ISA 26:10">तेस तर्मो रे राज दे बी बुराई करनी ओर से कदी बी महान यहोवे रे बारे दे सोची नि सकदा।<verse eid="ISA 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 26:11" />ओ यहोवा, तेरा आथ बढ़ेया राए, पर तेरे दुश्मण नि देखदे।</para>
  <para style="q" vid="ISA 26:11">पर तिना खे पता लगी जाणा कि ताखे प्रजा री केड़ी जल़न ए ओर सेयो शर्मिंदा ऊणे।<note caller="+" style="f"><char style="fr" closed="false">26:11 </char><char style="ft" closed="false">मीका 5:9, इब्रा. 10:27</char></note><verse eid="ISA 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 26:12" />तेरे बैरी आगी दे फूखणे।</para>
  <para style="q" vid="ISA 26:12">ओ यहोवा, तां आसा खे शान्ति ठराणी,</para>
  <para style="q" vid="ISA 26:12">आसे जो कुछ करी राखेया, से तैंई मारिया तँईं करी राखेया।<verse eid="ISA 26:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 26:13" />ओ यहोवा तू मारा परमेशर ए, तांते अलावा ओर मालक बी आसा पाँदे राज करो थे,</para>
  <para style="q" vid="ISA 26:13">पर तेरी कृपा ते आसे बस तेरे ई नाओं रा गुणगाण करूँए।<verse eid="ISA 26:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 26:14" />एबे सेयो न्यायी मरी गे रे, सेयो फेर कदी जिऊँदे नि ऊणे, तिना खे मरे दे बऊत दिन ऊईगे,</para>
  <para style="q" vid="ISA 26:14">सेयो फेर नि उठी सकदे, तैं तिना खे नाशो रे बारे दे सोची की सेयो एड़े नाश कित्ते कि सेयो फेर याद नि आऊणे।<verse eid="ISA 26:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 26:15" />ओ यहोवा, तैं यहूदा रा प्रदेश बढ़ाया।</para>
  <para style="q" vid="ISA 26:15">तैं जातिया खे बढ़ाई की आपणी महिमा दखाई राखी</para>
  <para style="q" vid="ISA 26:15">ओर तेस देशो रे सारे बन्ने तैं बढ़ाई राखे।<verse eid="ISA 26:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 26:16" />ओ यहोवा, सेयो लोक ताखे दु:खो दे याद करो थे,</para>
  <para style="q" vid="ISA 26:16">जेबे तूँ तिना खे दण्ड देओ था, तेबे से दबी री आवाजा दे आपणे मनो री गल्ल तांगे बताओ थे।<verse eid="ISA 26:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 26:17" />ओ यहोवा, आसे लोक बी, तां सामणे तेड़े ई ऊईगे रे।</para>
  <para style="q" vid="ISA 26:17">जिंयाँ गर्भवती जवाणस बच्चा जमाणे रे बखते रिगड़ोई ओर पीड़ा रिया बजा ते चींगोई।<note caller="+" style="f"><char style="fr" closed="false">26:17 </char><char style="ft" closed="false">पज. 48:6</char></note><verse eid="ISA 26:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 26:18" />आसे बी गर्भवती ऊए, आसे बी रिगड़े, आसे मानो अवा खे ई जन्म दित्तेया।</para>
  <para style="q" vid="ISA 26:18">आसे देशो रिया तँईं कोई उद्धारो रा काम नि कित्तेया ओर दुनिया दे रणे वाल़ेया रा नाश करने दे असफल रये।<verse eid="ISA 26:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 26:19" />ओ यहोवा, तेरे मरे दे लोक जिऊँदे ऊणे, मुड़दे उठी की खड़े ऊणे।</para>
  <para style="q" vid="ISA 26:19">ओ माट्टिया दे बसणे वाल़ेयो, जागी की जयजयकार करो!</para>
  <para style="q" vid="ISA 26:19">कऊँकि तेरा पाल़ा जोतिया ते पैदा ओआ ओर तरतिया मुड़दे वापस करी देणे।<verse eid="ISA 26:19" /></para>
  <para style="s">न्याय ओर छुटकारा</para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 26:20" />ओ मेरे यहूदा शईरो रे लोको, आओ, तुसे आपणे-आपणे कमरे दे आई की दरवाजे बन्द करो, ओर थोड़ी देरा तक जदुओ तक यहोवे रा रोष शान्त नि ओ तदुओ तक आपू खे लकोई की राखो।<note caller="+" style="f"><char style="fr" closed="false">26:20 </char><char style="ft" closed="false">पज. 91:4, 32:7</char></note> <verse eid="ISA 26:20" /><verse number="21" style="v" sid="ISA 26:21" />कऊँकि देखो, यहोवा तरतिया दे रणे वाल़ेया खे पापो री सजा देणे खे आपणे स्वर्गो रिया रणे री जगा ते चली की आऊणे लगी रा ओर तरतिया पाँदे लकोई की कित्ती रया अत्या सामणे आई जाणिया, ओर जो लोक मरीगे दे ए, तिना खे तरती एबे ओए नि लकोई सकणी।<verse eid="ISA 26:21" /></para>
  <chapter eid="ISA 26" />
  <chapter number="27" style="c" sid="ISA 27" />
  <para style="s">इस्राएलो रा उद्धार</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 27:1" />न्याय रे तेस दिने यहोवे कड़क, बड़ी ओर मजबूत तलवारी साथे लिब्यातान नाओं रे तेज ओर टेडे चलणे वाल़े सापो खे सजा देणी ओर जो अजगर समुद्रो दे रओआ, से बी काई देणा। <verse eid="ISA 27:1" /><verse number="2" style="v" sid="ISA 27:2" />तेस बखते एक सुन्दर अंगूरा रा बगीचा ऊणा, तुसे तेसरे गीत गाओ। <verse eid="ISA 27:2" /><verse number="3" style="v" sid="ISA 27:3" />आऊँ यहोवा तेस बागो री रक्षा करूँआ, मां बाग ठीक बखतो पाँदे सिंजेया करना। मां बगीचे री दिन-रात रक्षा करदे रणा, एड़ा नि ओ कि कोई तेसरा नुकशाण करो। <verse eid="ISA 27:3" /><verse number="4" style="v" sid="ISA 27:4" />आऊँ आपणे माणूंआ ते बऊत दिन तक नराज नि रयी सकदा। जे कोई कई-प्रकारा रे कांडेवाल़े डाल़ मां साथे लड़ने खे खड़े करोआ, तो आऊँ तिना पाँदे पैर बढ़ाई की पूरी तरअ ते फूखी देऊँआ। <verse eid="ISA 27:4" /><verse number="5" style="v" sid="ISA 27:5" />जे कोई मेरा दुश्मण मेरी शरण लओ, ओर मा साथे मेलजोल करने खे मेरी शरण लओ, सेयो मां साथे मेलजोल करी लओ। <verse eid="ISA 27:5" /><verse number="6" style="v" sid="ISA 27:6" />आऊणे वाल़े बखतो दे याकूबो रे लोक तेस डाल़ो जेड़े ऊणे जेसरी जड़ खरी ओई ओर इस्राएल फल़णा-फूलणा ओर तेसरे फल़ा साथे दुनिया परी जाऊणी।<verse eid="ISA 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 27:7" />मैं यहोवे इस्राएली लोका खे इतणी सख्त सजा नि दित्ती, जितणी मैं तिना रे दुश्मणा खे सख्त सजा देई कि काये थे। <verse eid="ISA 27:7" /><verse number="8" style="v" sid="ISA 27:8" />जेबे तैं आपणे लोका खे गुलामिया दे पेजी की सजा दित्ती, तेबे सोची-समजी की तेसखे दु:ख दित्तेया, तिने पुरवाईया रे दिने से प्रचण्ड अवा साथे उडाई ता रा। <verse eid="ISA 27:8" /><verse number="9" style="v" sid="ISA 27:9" />इजी ते याकूबो रे पापो रा प्राश्चित करेया जाणा ओर तेसरे पापो रे दूर ऊणे रा प्रतिफल़ ये ऊणा कि तिना बेदिया रे सारे पात्थर चूना बनाणे वाल़े पात्थरा जेड़े चूर-चूर करने ओर अशेरा देवता ओर सूरजो रिया मूर्तिया फेर खड़िया नि रणियां।<note caller="+" style="f"><char style="fr" closed="false">27:9 </char><char style="ft" closed="false">रोम. 11:27 </char></note> <verse eid="ISA 27:9" /><verse number="10" style="v" sid="ISA 27:10" />कऊँकि मजबूत दवाला वाल़ा शईर खाली ऊई रा,<note caller="+" style="f"><char style="fr" closed="false">27:10 </char><char style="ft" closed="false">दवाला वाल़ा शईर ऊई सकोआ इस्राएलो रे सारे दवाला वाल़े शईरा खे बताओआ </char></note> से छाडी री बस्तिया जेड़े खाली ओर जंगल़ ऊईगा रा, तेती बाच्छू चरने ओर तेथी बैठणे ओर तेती तिना डाल़ा री पाँगटिया रे पत्ते खाणे। <verse eid="ISA 27:10" /><verse number="11" style="v" sid="ISA 27:11" />जेबे अँगूरो रिया पाँगटिया सूकी जाणिया, तेबे सेयो तोड़ी की सेटी देणियां ओर जवाणसा आई की सेयो चकी की फूकी देणियां। कऊँकि यो लोक समजदार नि ए, इजी री खातर इना खे बनाणे वाल़े परमेशरो इना पाँदे फेर दया नि करनी ओर ना इना पाँदे अनुग्रह करना। <verse eid="ISA 27:11" /><verse number="12" style="v" sid="ISA 27:12" />तेस बखते यहोवे फरात नदिया रे कनारे ते लई की मिस्रो रे नाल़े तक आपणा नज्ज फरकाणा ओर ओ इस्राएलियो, तुसे एक-एक करी की कट्ठे करे जाणे। <verse eid="ISA 27:12" /><verse number="13" style="v" sid="ISA 27:13" />तेस बखते बड़ा नरसिंगा बजाया जाणा ओर जो अश्शूर देशो दे नाश ऊणे लगी रे थे ओर सेयो इस्राएली लोक जो अश्शूर देशो दे छाडी ते दे थे ओर मिस्र देशो दे बसाई ते दे थे, सेयो मिली की आऊणे ओर तिना यरूशलेम शईरो रे पवित्र पाह्ड़ो पाँदे यहोवे री आराधना करनी<note caller="+" style="f"><char style="fr" closed="false">27:13 </char><char style="ft" closed="false">मत्ती 24:31 </char></note><verse eid="ISA 27:13" /></para>
  <chapter eid="ISA 27" />
  <chapter number="28" style="c" sid="ISA 28" />
  <para style="s">एप्रैम ओर यरूशलेम शईरो पाँदे हाय</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 28:1" />कमण्डो रे मुकुटो पाँदे लाणत ए!<note caller="+" style="f"><char style="fr" closed="false">28:1 </char><char style="ft" closed="false">ये शईर उत्तरी इस्राएलो रे राज्य री राजधानी सामरिया ए। ये पूरे देशो पाँदे राज करोआ। </char></note> जो एप्रैमो रे नशेड़िये राए<note caller="+" style="f"><char style="fr" closed="false">28:1 </char><char style="ft" closed="false">इस्राएलो रे परदान जो जादातर नशे देई रओ थे </char></note> ओर तिना री पड़काणे वाल़ी सुन्दरता पाँदे जो मुरझाणे वाल़ा फूल ए, जो बऊत उपजाऊ तराईया रे सिरे पाँदे शराबो साथे नशेड़िया री ए। <verse eid="ISA 28:1" /><verse number="2" style="v" sid="ISA 28:2" />देखो, मेरे प्रभुए गे एक तागतबर ओर सामर्थी माणूं ए,<note caller="+" style="f"><char style="fr" closed="false">28:2 </char><char style="ft" closed="false">सामरिया </char></note> जो ओल़ेया री बर्खा या उजाड़ने वाल़े तूफान बाढ़ा री प्रचण्ड नदिया जेड़ा ए, तेस तागतबर ऊई की तरती जमीना पाँदे रूड़ाई देणी। <verse eid="ISA 28:2" /><verse number="3" style="v" sid="ISA 28:3" />एप्रैमो रे नशेड़िया लोका रा कमण्डो रा मुकुट<note caller="+" style="f"><char style="fr" closed="false">28:3 </char><char style="fq" closed="false">कमण्डो रा मुकुट </char><char style="ft" closed="false">इस्राएलो रा सुन्दर मुकुट </char></note> पैरा साथे केसेया जाणा। <verse eid="ISA 28:3" /><verse number="4" style="v" sid="ISA 28:4" />ओर तिना री पड़काणे वाल़ी सुन्दरता रा मुरझाणे वाल़ा फूल जो बऊत उपजाऊ तराईया रे सिरे पाँदे ए, से गर्मिया ते पईले पाक्के रे दाऊगल़े जेड़ा ऊणा, जेतेखे देखणे वाल़ा देखदे ई आथो दे लओ ओर खाई जाओ। <verse eid="ISA 28:4" /><verse number="5" style="v" sid="ISA 28:5" />तेस बखते सेना रा यहोवा आपू आपणी प्रजा रे बचे रे लोका खे सुन्दर ओर प्रतापी मुकुट ठईरना। <verse eid="ISA 28:5" /><verse number="6" style="v" sid="ISA 28:6" />ओर जो न्याय करने खे बैठोए तिना रिया तँईं न्याय करने वाल़ी आत्मा ओर जो अमला करदे ऊए दुश्मणा खे शईरो रे बड़े द्वारो ते टायी देओए, तिना खे से तागत ठईरनी। <verse eid="ISA 28:6" /><verse number="7" style="v" sid="ISA 28:7" />ये पुरोईत ओर नबी बी शराबो रिया बजा ते रूड़ोए ओर शराबो रिया बजा ते लड़खड़ाओए। पुरोईत ओर नबी बी शराबो रिया बजा ते लड़खड़ाओए, शराबे सेयो पुलाई ते रे, सेयो शराबो रिया बजा ते लड़खड़ाओए ओर दर्शण पाँदे ऊए पटकी जाओए ओर न्याय करदे ऊए पूली जाओए। <verse eid="ISA 28:7" /><verse number="8" style="v" sid="ISA 28:8" />कऊँकि सारी खाणा खाणे री जगा उल्टी ओर कूड़े साथे परी रिये, कोई शुद्ध जगा नि बची। <verse eid="ISA 28:8" /><verse number="9" style="v" sid="ISA 28:9" />सेयो मांते शकाईत करोए ओर पूछोए, “तेस केसखे ज्ञान सिखाणा ओर केसखे आपणे सन्देशो रा मतलब समजयाणा? क्या तिना खे जो दूद छुड़ाए दे बच्चे ओर दुदुआ साथे बिना लगाए दे बच्चे ए। <verse eid="ISA 28:9" /><verse number="10" style="v" sid="ISA 28:10" />कऊँकि आज्ञा पाँदे आज्ञा, आज्ञा पाँदे आज्ञा, नियमो पाँदे नियम, नियमो पाँदे नियम, थोड़ा एती, थोड़ा तेती।” <verse eid="ISA 28:10" /><verse number="11" style="v" sid="ISA 28:11" />फेर एबे यहोवे खे आपणे लोका ते परदेशी जो दु:ख देओ ए तिना रे जरीये गल्ल करनी पड़नी, जो एक लग ई पाषा बोलोए। <verse eid="ISA 28:11" /><verse number="12" style="v" sid="ISA 28:12" />यहोवे पईले तिना लोका ते बोलेया था, “राम एसते ई मिलणा, एसरे जरीये ई थके रेया खे राम देयो”, पर लोके परमेशरो री सुणनी नि चाई। <verse eid="ISA 28:12" /><verse number="13" style="v" sid="ISA 28:13" />इजी री खातर परमेशरो रा वचन तिना गे आज्ञा पाँदे आज्ञा, आज्ञा पाँदे आज्ञा, नियमो पाँदे नियम, नियमो पाँदे नियम, थोड़ा एती, थोड़ा तेती, जेते कि सेयो ठोकर खाई की बेओश ऊई की रूड़ो ओर कायल ऊई जाओ ओर फन्दे दे फसी की पकड़े जाओ।<verse eid="ISA 28:13" /></para>
  <para style="s">सिय्योन देशो दे निऊँ</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 28:14" />ओ, यरूशलेम शईरो रे आज्ञा ना मानणे वाल़े कमण्डी परदानो, यहोवे रा वचन सुणो! <verse eid="ISA 28:14" /><verse number="15" style="v" sid="ISA 28:15" />तुसे लोक बोलोए, “आसे मौता साथे वाचा बानी ओर अधलोको ते प्रतिज्ञा कराई राखी, इजी बजा ते मुसीबत जेबे बाढ़ा जेड़ी बढ़ी की आओगी, तेबे आसा गे नि आऊणी, कऊँकि आसे चूठो री शरण लई ओर चूठो पीछे लूके रे रये।” <verse eid="ISA 28:15" /><verse number="16" style="v" sid="ISA 28:16" />इजी री खातर परमेशर यहोवा ईंयाँ बोलोआ, “देखो, मैं सिय्योनो रे पाह्ड़ो पाँदे निऊँआ रा पात्थर राखी राखेया,<note caller="+" style="f"><char style="fr" closed="false">28:16 </char><char style="ft" closed="false">एक मजबूत निऊँआ रा पात्थर आपू यहोवे री एक नशाणी ए </char></note> एक परखेया रा पात्थर, कूणे रा कीमती ओर बऊत मजबूत निऊँआ जोगा पात्थर ओर जो कोई परोसा राखोगा, तेस जल्दबाजी नि करनी।<note caller="+" style="f"><char style="fr" closed="false">28:16 </char><char style="ft" closed="false">रोम. 9:33, 1 कुरि. 3:11, इफि. 2:20, 1 पत. 2:4-6 </char></note> <verse eid="ISA 28:16" /><verse number="17" style="v" sid="ISA 28:17" />ओर मां न्याय डोरी ओर तर्म साल़ ठराणा ओर तुसा रे चूठो री जगा ओल़ेया साथे बह्यी जाणी ओर तुसा रे लूकणे री जगा पाणिए दे डूबी जाणी।” <verse eid="ISA 28:17" /><verse number="18" style="v" sid="ISA 28:18" />तेबे जो वाचा तुसे मौता साथे बानी राखी, से टूटी जाणी ओर जो प्रतिज्ञा तुसे अधलोको ते कराई से नि ठईरनी, जेबे मुसीबत बाढ़ा जेड़ी बढ़ी जाओगी, तेबे तुसे तिदे डूबी जाणे। <verse eid="ISA 28:18" /><verse number="19" style="v" sid="ISA 28:19" />जेबे-जेबे से बाढ़ बढ़ी जाओगी, तेबे-तेबे तेसा तुसे लई जाणे, से रोज बल्कि दिन-रात बढ़ेया करनी ओर एस सन्देशो रा सुणना ई बेचैन ऊणे रिया बजा ते ऊणा। <verse eid="ISA 28:19" /><verse number="20" style="v" sid="ISA 28:20" />कऊँकि बछौणा खुटिया फैलाणे खे छोटा ओर टखण टखणे खे कम ए। <verse eid="ISA 28:20" /><verse number="21" style="v" sid="ISA 28:21" />कऊँकि यहोवा एड़ा उठ खड़ा ऊणा जेड़ा से पराजीम नाओं रे पाह्ड़ो पाँदे खड़ा ऊआ ओर जेड़ा गिबोनो री तराईया दे रोषे ऊआ था,<note caller="+" style="f"><char style="fr" closed="false">28:21 </char><char style="ft" closed="false">2 सेमु. 5:20, 1 कुरि. 14:11 </char></note> तेस एबे फेर रोष दखाणा, जेते कि से आपणा काम करो, जो अचम्बे रे काम ए ओर एड़े काम करने जो नऊखे ए।<note caller="+" style="f"><char style="fr" closed="false">28:21 </char><char style="ft" closed="false">यहोशू 10:10-11 </char></note> <verse eid="ISA 28:21" /><verse number="22" style="v" sid="ISA 28:22" />इजी री खातर एबे तुसे मजाक नि करो, नई तो तुसा रे बान गूड़े जाणे, कऊँकि मैं सेना रे यहोवे ते ये सुणी राखेया कि तेस सारे देशो रा सत्यानाश करना।<verse eid="ISA 28:22" /></para>
  <para style="s">परमेशरो रा ज्ञान</para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 28:23" />जो सन्देश आऊँ तुसा खे सुनाणे लगी रा, तेसखे त्यान लगाई की सुणो। <verse eid="ISA 28:23" /><verse number="24" style="v" sid="ISA 28:24" />क्या अल़ बाणे वाल़ा बेजा बाणे खे लगातार बांदा रओआ? क्या से सदा तरतिया खे चीरदा रओआ ओर मैड़ा फेरदा रओआ? <verse eid="ISA 28:24" /><verse number="25" style="v" sid="ISA 28:25" />एड़ा नि आ, एक जिम्मीदार डोरूए खे पईले सीदा करी की तिदे संफ सेटोआ, जीरा बाओआ ओर कणका खे सरेद-सरेद करी की फल्याओआ ओर जौ बी लग जगा दे लगाओआ। ओर कई प्रकारा रा कणका रा बीज डोरूआ रे कनारे पाँदे बाओआ। <verse eid="ISA 28:25" /><verse number="26" style="v" sid="ISA 28:26" />कऊँकि तेसरा परमेशर तेसखे ठीक-ठीक काम करना सिखाओआ ओर बताओआ। <verse eid="ISA 28:26" /><verse number="27" style="v" sid="ISA 28:27" />दाणा काडणे वाल़ी मशीना दे संफ काडी नि जांदी ओर गडिया रा टईर जीरे पाँदे नि चलाया जांदा, पर संफ डण्डे साथे ओर जीरा सोठे साथे चाड़ेया जाओआ। <verse eid="ISA 28:27" /><verse number="28" style="v" sid="ISA 28:28" />रोटिया रा नज्ज मशीना दे काडेया जाओआ, पर कोई तिजी खे सदा काडदा नि रंदा ओर ना ई कोई गडिया रे टईर या कोड़े तिजी पाँदे चलांदा, से तिजी रा चूरा नि करदा। <verse eid="ISA 28:28" /><verse number="29" style="v" sid="ISA 28:29" />ये बी सेना रे यहोवे रिया तरफा ते नियुक्त ऊई रा, से अद्भुत योजना वाल़ा ओर बड़ा समजदार ए।<verse eid="ISA 28:29" /></para>
  <chapter eid="ISA 28" />
  <chapter number="29" style="c" sid="ISA 29" />
  <para style="s">यरूशलेम शईरो पाँदे हाय</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 29:1" />यहोवे बोलेया, अरीएल, अरीएल, लाणत ए तेस यरूशलेम शईरो पाँदे, जिदे दाऊद डेरे लगाई की रया! सालो पाँदे साल जोड़दे जाओ, त्योआर आपणे-आपणे बखतो दे मनांदे जाओ।<note caller="+" style="f"><char style="fr" closed="false">29:1 </char><char style="ft" closed="false">खास एड़ा तार्मिक त्योआर जिदे लोक हर साल यरूशलेम आओ थे </char></note> <verse eid="ISA 29:1" /><verse number="2" style="v" sid="ISA 29:2" />तेबे बी मां अरीएलो खे सजा देणी। तेती रोण-पीटण रणा ओर से मेरी नजरा दे सच्ची खे ई अरीएलो<note caller="+" style="f"><char style="fr" closed="false">29:2 </char><char style="fq" closed="false">अरीएलो </char><char style="ft" closed="false">बलिदान करने खे आगी री बेदी </char></note> जेड़ा ठईरना। <verse eid="ISA 29:2" /><verse number="3" style="v" sid="ISA 29:3" />मां तूँ चऊँ कनारा ते तेरे खलाफ डेरा लगाई की कांडेया साथे केरी देणा ओर मां लड़ाईया रिया तँईं तेरे खलाफ गढ़ बी बनाणे। <verse eid="ISA 29:3" /><verse number="4" style="v" sid="ISA 29:4" />मां तू अराई देणा ओर जमीना दे रूड़ाई की जमीना दे पाणा ओर तेबे तां तूड़ा बीचा ते बोलणा ओर तेरी आवाज आऊल़ी-आऊल़ी सुणनी, तेरी आवाज जमीना ते पूत-प्रेतो जेड़ी ऊणी ओर तां तूड़ा ते गुणगुणाई की बोलणा। <verse eid="ISA 29:4" /><verse number="5" style="v" sid="ISA 29:5" />तेबे तेरे परदेशी दुश्मणा री पीड़ छोटी तूड़ा जेड़ी ओर तिना डराऊणे लोका री पीड़ पूए जेड़ी उडाई जाणी।<verse eid="ISA 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 29:6" />यशायाह भविष्यबक्ता बोलोआ, “सेना रा यहोवा अचाणक तेसगे बीच बचाओ करने ओर यरूशलेमो खे बचाणे आऊणा ओर तेस बादल़ गरजाणे, तरती ईलाणी, बऊत बड़ी आवाज करनी, पऊण-चूखाना ओर नाश करने वाल़ी आग पड़काणी। <verse eid="ISA 29:6" /><verse number="7" style="v" sid="ISA 29:7" />ओर सारी जातिया री पीड़ जेसा अरीएलो साथे लड़ाई करनी ओर जितणे लोक तेसरे ओर तेसरे गढ़ो रे खलाफ लड़ने, सेयो सारे राती देखे रे सुफने जेड़े ठईरने। <verse eid="ISA 29:7" /><verse number="8" style="v" sid="ISA 29:8" />तेबे जेड़ा कोई पूखा सुफने दे तो देखोआ कि से खाणे लगी रा, पर जागी की देखोआ कि तेसरा पेट पूखा ए या कोई त्याया सुफने दे तो देखोआ कि से पीणे लगी रा, पर जागी की देखोआ कि तेसरा गल़ा सूकणे लगी रा ओर से त्याया मरने लगी रा, तेड़ी ई तिना सबी जातिया री दशा ऊणी, जेसा सिय्योनो रे पाह्ड़ो साथे लड़ाई करनी।”<verse eid="ISA 29:8" /></para>
  <para style="s">चतौणिया खे अणदेखा करना</para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 29:9" />यशायाह भविष्यवक्ते बोलेया, “यरूशलेम शईरो रे लोको, सोचो ओर हैरान ओ! भोग-विलास करो ओर अन्दे ऊई जाओ! सेयो नशेड़ी तो आए, पर शराबो साथे नि, सेयो लड़खड़ाओ तो आए, पर दारू पीणे ते नि! <verse eid="ISA 29:9" /><verse number="10" style="v" sid="ISA 29:10" />यहोवे तुसे पारी नींजा दे पाई ते रे ओर नींजे तुसा रिया नबीए रिया जिया आखी बन्द करी ती रिया ओर तुसा रे दर्शण देखणे वाल़े सिरो पाँदे पड़दा पायी ता रा।”<note caller="+" style="f"><char style="fr" closed="false">29:10 </char><char style="ft" closed="false">रोम. 11:8 </char></note> <verse eid="ISA 29:10" /><verse number="11" style="v" sid="ISA 29:11" />इजी री खातर सारे दर्शण तुसा खे एक टाल्ले दे लपेटी री ओर मुहरा साथे बन्द कित्ती री कताबा दे लपेटी दी कताबा जेड़े ए, जेतेखे कोई पढ़े-लिखे रे माणूंए खे ये बोली की देयो, “इजी खे पढ़” ओर से बोलो, “आऊँ नि पढ़ी सकदा, कऊँकि ये मुहरा साथे बन्द ए।”<note caller="+" style="f"><char style="fr" closed="false">29:11 </char><char style="ft" closed="false">प्रका. 5:1-3 </char></note> <verse eid="ISA 29:11" /><verse number="12" style="v" sid="ISA 29:12" />तेबे तेसा ई कताबा खे केसी अनपढ़ो खे ये बोली की देयो, “इजी खे पढ़” ओर से बोलो, “आऊँ तो अनपढ़ ए।” <verse eid="ISA 29:12" /><verse number="13" style="v" sid="ISA 29:13" />परमेशरे बोलेया, “यो लोक जो मुंए ते मेरा आदर करदे ऊए नेड़े आओए, पर आपणा मन मांते दूर राखोए ओर जो बस माणूंए री आज्ञा सुणी-सुणी की मेरा डर मानोए,<note caller="+" style="f"><char style="fr" closed="false">29:13 </char><char style="ft" closed="false">मत्ती 15:8,9, मर. 7:6,7 </char></note> <verse eid="ISA 29:13" /><verse number="14" style="v" sid="ISA 29:14" />इजी बजा ते सुण, मां इना साथे हैरान करने वाल़े काम, बल्कि बऊत हैरान करने वाल़े ओर अचम्बे रे काम करने, तेबे इना रे अक्लमंद माणूंआ री बुद्धि नाश ऊणी। यो आपू खे उशयार समजोए, पर आए नि, सेयो मां सामणे ल्याऊणे।”<note caller="+" style="f"><char style="fr" closed="false">29:14 </char><char style="ft" closed="false">1 कुरि. 1:19 </char></note><verse eid="ISA 29:14" /></para>
  <para style="s">आऊणे वाल़ेया दिना री उम्मीद</para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 29:15" />लाणत ए तिना लोका पाँदे जो आपणी योजना खे यहोवे सामणे लकोणे री बड़ी कोशिश करोए ओर आपणे काम न्हेरे दे करी की बोलोए, “आसा खे कोई देखी नि सकदा। आसे कुण ए, आसा खे कोई आदमी नि जाणदा।” <verse eid="ISA 29:15" /><verse number="16" style="v" sid="ISA 29:16" />तुसा री समज केड़ी उल्टी ए! क्या कुम्हार माट्टिया जेड़ा गिणेया जाणा? क्या बणाई रिया चीजा आपणे बनाणे वाल़े रे बारे दे बोलो, “तिने आऊँ नि बणाया” या “तेसखे कोई समज नि ए”<note caller="+" style="f"><char style="fr" closed="false">29:16 </char><char style="ft" closed="false">रोम. 9:20,21 </char></note> <verse eid="ISA 29:16" /><verse number="17" style="v" sid="ISA 29:17" />क्या एबे थोड़े दिन बीतणे ते बाद लबानोन जंगल़ फेर फल़ देणे वाल़ा बगीचा नि बणी जाणा ओर फल़ देणे वाल़ा बगीचा जंगल़ नि गिणेया जाणा? <verse eid="ISA 29:17" /><verse number="18" style="v" sid="ISA 29:18" />तेस बखते टऊणेया कताबा री गल्ला सुणने लगी जाणिया ओर अन्दे जिना खे एबुए तक कुछ नि दिशदा, सेयो देखणे लगणे।<note caller="+" style="f"><char style="fr" closed="false">29:18 </char><char style="ft" closed="false">मत्ती 11:5, प्रेरि. 26:18 </char></note> <verse eid="ISA 29:18" /><verse number="19" style="v" sid="ISA 29:19" />यहोवे रिया बजा ते फेर शरीफ लोक खुश ऊणे ओर गरीब माणूं इस्राएलो रे पवित्र परमेशरो रिया बजा ते मगन ऊणे। <verse eid="ISA 29:19" /><verse number="20" style="v" sid="ISA 29:20" />कऊँकि उपद्रवी माणूं फेर नि रणे ओर बुरे माणूंआ रा अन्त ऊणा, जो बुराई करने खे जागदे रओए। <verse eid="ISA 29:20" /><verse number="21" style="v" sid="ISA 29:21" />जो माणूंआ खे गल्ला दे फसाओए ओर जो सभा दे ल़वामे देंदे ऊए तिना खे फन्दा लगाओए, ओर तर्मो खे बेकार गल्ला रे जरीये बिगाड़ी देओए, सेयो सारे बर्बाद ऊई जाणे। <verse eid="ISA 29:21" /><verse number="22" style="v" sid="ISA 29:22" />इजी बजा ते अब्राहमो खे छुड़ाणे वाल़ा यहोवा, याकूबो रे कराने रे बारे दे ईंयाँ बोलोआ, “याकूबो खे फेर शर्मिंदा नि ऊणा पड़ना, तेसरा मूँ फेर निठा नि ऊणा। <verse eid="ISA 29:22" /><verse number="23" style="v" sid="ISA 29:23" />कऊँकि जेबे तेसरी ल्वादा मेरे काम देखणे, जो मां तिना बीचे करने, तेबे तिना मेरे नाओं री इज्जत करनी, आऊँ याकूबो रा पवित्र परमेशर ए, ओर तिना इस्राएलो रे परमेशरो रा बऊत डर मानणा। <verse eid="ISA 29:23" /><verse number="24" style="v" sid="ISA 29:24" />तेस बखते जिना रा मन पटकेया रा ऊणा तिना खे समज मिलणी ओर जो कुड़कुड़ाओए, तिना खे शिक्षा मिलणी।”<verse eid="ISA 29:24" /></para>
  <chapter eid="ISA 29" />
  <chapter number="30" style="c" sid="ISA 30" />
  <para style="s">मिस्र देशो पाँदे परोसा करना बेकार ए</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 30:1" />यहोवे री ये बाणी ए, “लाणत ए मेरे बिद्रोह करने वाल़ेया बच्चेया खे जो योजना तो करोए पर मेरी तरफा ते नि, वाचा तो बानोए पर मेरी आत्मा रे सिखाए दे नि ओर ईंयाँ आपणे सिरो पाँदे पापो पाँदे पाप चढ़ांदे रओए।<note caller="+" style="f"><char style="fr" closed="false">30:1 </char><char style="ft" closed="false">बिद्रोह करने वाल़े बच्चे, यहूदा रे लोका खे हट्ठी ओर आपणी मर्जी करने वाल़े बताओए। सेयो परमेशरो री इच्छा खे नि मानदे </char></note> <verse eid="ISA 30:1" /><verse number="2" style="v" sid="ISA 30:2" />सेयो मांते बिना पूछे मिस्र देशो खे जाओए, ताकि सेयो मिस्र देशो दे आसरा लई सको ओर मिस्रो रा राजा फिरौन तिना री रक्षा करो। <verse eid="ISA 30:2" /><verse number="3" style="v" sid="ISA 30:3" />इजी बजा ते मिस्रो रे फिरौनो रे आसरे री जगा तुसा री शर्मा रा ओर मिस्रो दे आसरा लणा तुसा री निन्दा री बजा ऊणा। <verse eid="ISA 30:3" /><verse number="4" style="v" sid="ISA 30:4" />यहूदा रे राजे रे जरीये पेजे दे हाकिम सोअन शईरो दे तो आई रे ओर तेथो रे दूत एबे हानेस शईरो दे पऊँची रे। <verse eid="ISA 30:4" /><verse number="5" style="v" sid="ISA 30:5" />सेयो सारे एक एड़ी जातिया रिया बजा ते शर्मिंदा ऊणे, जेते कि तिना रा कोई फायदा नि ऊणा, जो मताद ओर फायदे रे बदले शर्म ओर बेज्जतिया री बजा ऊणी।” <verse eid="ISA 30:5" /><verse number="6" style="v" sid="ISA 30:6" />यशायाह खे ये वचन दक्खणा रे बणो रे जानवरा रे बारे दे मिलेया: सेयो आपणी तअन-सम्पत्ति जवान गह्देया पाँदे ओर आपणे खजाने ऊँटा रे पाँदे लादी की, मुसीबत ओर कष्टो रे देशो रिये ऊई की, जेती शेर ओर शेरनी, नाग ओर उडणे वाल़े तेज विषो वाल़े साप रओए, तिना लोका गे जाणे लगी रे, जिना ते तिना खे कोई फायदा नि ऊणा। <verse eid="ISA 30:6" /><verse number="7" style="v" sid="ISA 30:7" />मिस्र देशो री मताद करने रे वादे बेकार ए! इजी री खातर आऊँ तेसखे राहाब बोलूँआ।<note caller="+" style="f"><char style="fr" closed="false">30:7 </char><char style="ft" closed="false">51:9; अय्यू. 9:13; पज. 89:10 </char></note><verse eid="ISA 30:7" /></para>
  <para style="s">आज्ञा ना मानणे वाल़े लोक</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 30:8" />यहोवे यशायाह खे बोलेया, “एबे जाई की इना गल्ला खे तिना सामणे पात्थरा पाँदे खण ओर कताबा दे लिख कि आऊणे वाल़े बखतो खे, बल्कि सदा खे गवाई बणी दी रओ। <verse eid="ISA 30:8" /><verse number="9" style="v" sid="ISA 30:9" />कऊँकि यहूदा रे लोक बगावत करने वाल़े लोक ओर चूठ बोलणे वाल़े ए, जो परमेशरो री शिक्षा खे नि सुणना चांदे।” <verse eid="ISA 30:9" /><verse number="10" style="v" sid="ISA 30:10" />सेयो दर्शण देखणे वाल़ेया खे बोलोए, “दर्शण नि देखो” ओर नबिया खे बोलोए, “आसा खे ठीक भविष्यबाणी नि करो, आसा गे मीठिया-मीठिया गल्ला बोलो, तोखा देणे वाल़ी भविष्यबाणी करो। <verse eid="ISA 30:10" /><verse number="11" style="v" sid="ISA 30:11" />बाटा ते मुड़ो, बाटा ते अटो ओर इस्राएलो रे पवित्र परमेशरो खे आसा सामणे ते दूर करो।” <verse eid="ISA 30:11" /><verse number="12" style="v" sid="ISA 30:12" />इजी बजा ए इस्राएलो रा पवित्र परमेशर ईंयाँ बोलोआ, “तुसे लोक जो मेरिया इना गल्ला खे बेकार जाणोए ओर अन्देर ओर बुराईया पाँदे परोसा करी की तिना पाँदे ई त्यान लगाओए, <verse eid="ISA 30:12" /><verse number="13" style="v" sid="ISA 30:13" />इजी बजा ते तुसा रा ये पाप तुसा खे एड़ा ऊणा जेड़ा कि कोई केसी ऊच्ची दवाला दे खीड़ आई री ओ ओर से टल़ने वाल़ी ओ ओर से टुटी की अचाणक टल़ीगी ओ। <verse eid="ISA 30:13" /><verse number="14" style="v" sid="ISA 30:14" />तुसे कुम्हारो रे तिना पांडेया जेड़े ऊई जाणे जो फूटी की चूर-चूर ऊई जाओए ओर तिना रा एक बी टुकड़ा इतणा बड़ा नि रँदा जेते दे आग लई सको या अऊदो ते पाणी निकयाल़ी सको।” <verse eid="ISA 30:14" /><verse number="15" style="v" sid="ISA 30:15" />परमेशर यहोवा, इस्राएलो रा पवित्र ईंयाँ बोलोआ, “जे तुसे मां नेड़े वापस आई जाओ ओर चुपचाप मां पाँदे परोसा करो तेबे तुसे बची जाणे। तुसा रा मां पाँदे परोसा राखणे दे उद्धार ए, शान्त रणे दे ओर परोसा राखणे दे तुसा री वीरता ए। पर तुसे एड़ा नि कित्तेया।” <verse eid="ISA 30:15" /><verse number="16" style="v" sid="ISA 30:16" />तुसे बोलेया, “ना, आसा तो कोड़ेया पाँदे बैठी की नठणा,” इजी री खातर तुसे नठणे; ओर ये बी बोलेया, “आसा एड़े कोड़ेया पाँदे नठणा जो बऊत तेज नठोए,” इजी री खातर तुसा रा पीछा करने वाल़े तुसा रे दुश्मण तुसा ते बी तेज ऊणे। <verse eid="ISA 30:16" /><verse number="17" style="v" sid="ISA 30:17" />एकी दुश्मण सिपाईए री तमकिया तेई तुसा रे एक ह्जार सिपाई नठणे ओर पाँजा सिपाईया री तमकिया ते तुसे एड़े नठणे कि अन्तो दे तुसे पाह्ड़ो री चूँडिया रे डण्डे या चूँडिया पाँदले चण्डे जेड़े रयी जाणे जिना खे नशाणिया रिया तँईं लगाओए।<verse eid="ISA 30:17" /></para>
  <para style="s">परमेशरो रा आपणे लोका पाँदे अनुग्रह</para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 30:18" />तेबे बी परमेशर इजी रिया तँईं देरी करोआ ताकि तुसा पाँदे अनुग्रह करो ओर इजी री खातर से ऊच्चे उठणा ताकि तुसा पाँदे दया करो, कऊँकि परमेशर यहोवा न्यायी परमेशर ए; सेयो माणूं कितणे तन्य ए जो तेस पाँदे उम्मीद लगाई राखोए। <verse eid="ISA 30:18" /><verse number="19" style="v" sid="ISA 30:19" />ओ सिय्योनो रे लोको, तुसे यरूशलेम शईरो दे बसे दे रओ, तुसे फेर कदी नि रोणे, तेस तुसा रे मतादा खे रोणे खे सुणदे ई तुसा पाँदे जरूर दया करनी, तेस सुणदे ई तुसा री मानणी। <verse eid="ISA 30:19" /><verse number="20" style="v" sid="ISA 30:20" />चाए परमेशर यहोवा तुसा खे मुसीबता री रोटी ओर दु:खो रा पाणी बी देयोगा, तेबे बी तुसा रे सिखाणे वाल़े फेर नि लूको ओर तुसा आपणियां आखी साथे आपणे सिखाणे वाल़े देखदे रणे। <verse eid="ISA 30:20" /><verse number="21" style="v" sid="ISA 30:21" />जेबे तुसे कदी दाँणे या खूँजे कनारे मुड़ने लगो, तेबे यहोवे रा ये वचन तुसा रे कानो दे पड़ना, “बाट येई ए, एते पाँदे ई चलो।” <verse eid="ISA 30:21" /><verse number="22" style="v" sid="ISA 30:22" />तेबे तुसा से चाँदी जेते साथे तुसा रिया मूर्तिया मढ़ी राखिया ओर से सूईना जेते साथे तुसा री कअड़ी रिया मूर्तिया सजी रिया, अशुद्ध करनिया, तुसा सेयो फटे-पुराणे टाल्ले जेड़िया सेटी देणियां ओर बोलणा, “आसा खे तुसा री जरूरत नि ए।” <verse eid="ISA 30:22" /><verse number="23" style="v" sid="ISA 30:23" />तेबे तेस तुसा रिया तँईं पाणी बरसाणा ताकि तुसे डोरू बायी सको, जेतेरिया बजा ते जमीना दे नज्ज बढ़िया ओर बऊत पजणा। तेस बखते तुसा रे डांगरा खे लाम्बा-चौड़ा मदान चरने खे मिलणा। <verse eid="ISA 30:23" /><verse number="24" style="v" sid="ISA 30:24" />तेबे बल़द ओर गह्दे जो तुसा रे डोरू बाणे रे कामे आऊणे, तिना सूप ओर छाजो साथे फड़ाके रा स्वाद चारा खाणा। <verse eid="ISA 30:24" /><verse number="25" style="v" sid="ISA 30:25" />तिना दिना दे यहूदा रे दुश्मणा खे दित्ती दी सजा पाँदे जेबे गुम्मट टल़ने, तेबे सारे ऊच्चे-ऊच्चे पाह्ड़ो ओर पाह्ड़िया पाँदे नाल़िया ओर सूबल़ा मिलणिया। <verse eid="ISA 30:25" /><verse number="26" style="v" sid="ISA 30:26" />तेस बखते परमेशरो आपणी प्रजा रा जख़्म बानणा ओर जेती तिना रे बूड़ी रणी से ठीक करनी, तेबे चाँदो रा प्रयासा सूरजो जेड़ा ओर सूरजो रा प्रयासा सातगुणा ऊई जाणा, मतलब अफ़्ते रा प्रयासा एकी दिनो दे ऊणा।<verse eid="ISA 30:26" /></para>
  <para style="s">परमेशरो अश्शूर राज खे सजा देणी</para>
  <para style="p">
    <verse number="27" style="v" sid="ISA 30:27" />देखो, यहोवा आपू दूरा ते चली की आऊणे लगी रा, तेसरा रोष पड़की गा रा ओर तुएँ रा बादल़ उठणे लगी रा, तेसरे ओठ रोषो रिया बजा ते फड़फड़ाणे लगी रे ओर तेसरी जीब आगी री लूपिया जेड़ी ए। <verse eid="ISA 30:27" /><verse number="28" style="v" sid="ISA 30:28" />तेसरा साआ तेसा बाढ़ा जेड़ा ए जो गल़े तक पऊँचोई, तेस सारी जातिया नाशो रे सूपो साथे फड़ाकणियां ओर देश-देशो रे लोका खे फड़ाकणे खे तिना रे जबड़ेया दे लगाम लगाणी। <verse eid="ISA 30:28" /><verse number="29" style="v" sid="ISA 30:29" />तेबे तुसा पवित्र त्योआरो री राती जेड़ा गीत गाणा ओर जेड़ा लोक यहोवे रे पाह्ड़ो<note caller="+" style="f"><char style="fr" closed="false">30:29 </char><char style="fq" closed="false">यहोवे रे पाह्ड़ो </char><char style="ft" closed="false">यरूशलेम पाह्ड़ो पाँदे बसेया दा मन्दरो खे बताओआ, जेती सेयो तार्मिक त्योआर मनाओ थे। </char></note> रिया तरफा खे मिलणे खे, जो इस्राएलो री चट्टान ए, बँसरी बजांदे ऊए जाओए, तेड़ी ई तुसा रे मनो दे खुशी ऊणी। <verse eid="ISA 30:29" /><verse number="30" style="v" sid="ISA 30:30" />ओर यहोवे आपणी प्रतापी बाणी सुनाणी ओर आपणा रोष पड़कांदा ओर आगी री लूपिया साथे स्वा करदा ऊआ ओर प्रचण्ड तूफान ओर बऊत बर्खा ओर ओल़ेया साथे आपणियां बाँई री तागत दखाणी।<note caller="+" style="f"><char style="fr" closed="false">30:30 </char><char style="ft" closed="false">पज. 18:13,14 </char></note> <verse eid="ISA 30:30" /><verse number="31" style="v" sid="ISA 30:31" />अश्शूर यहोवे री आवाजा री शक्तिया साथे नाश ऊई जाणा, तेस तेसदे सोठे साथे बाणी। <verse eid="ISA 30:31" /><verse number="32" style="v" sid="ISA 30:32" />जेबे-जेबे यहोवे तेसखे सजा देणी, तेबे साथे-साथे बीणा ओर डफली बजणी ओर तेस आथ बढ़ाई की से लगातार खत्म करदे रणा। <verse eid="ISA 30:32" /><verse number="33" style="v" sid="ISA 30:33" />बऊत दिना ते तोपेत<note caller="+" style="f"><char style="fr" closed="false">30:33 </char><char style="fq" closed="false">तोपेत </char><char style="ft" closed="false">से जगा थी जेती यरूशलेम शईरो रा कूड़ा फूकेया जाओ था। ये शईरो ते बारे हिन्नोम काट्टिया दे था। </char></note> त्यार करी राखेया, से सीरिया रे राजे खेई ठराई राखेया, से लाम्बा-चौड़ा ओर डूगा बी बणाई राखेया, तेथो री चिता दे आग ओर बऊत सारे लकड़ू ए, यहोवे रे साओ बल़ी री गन्धको री खाड्डा जेड़ा से सुलगाणी।<verse eid="ISA 30:33" /></para>
  <chapter eid="ISA 30" />
  <chapter number="31" style="c" sid="ISA 31" />
  <para style="s">परमेशरो यरूशलेम शईर बचाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 31:1" />लाणत ए तिना पाँदे जो लोक मतादा रिया तँईं मिस्र देशो खे जाओए ओर कोड़ेया रा आसरा करोए; जो रथा पाँदे परोसा राखोए, कऊँकि सेयो बऊत ए ओर सवारा पाँदे, कऊँकि सेयो बऊत तागतबर ए, पर इस्राएलो रे पवित्र परमेशरो रिया तरफा खे नि देखदे ओर ना ई यहोवे खे टोल़दे!<note caller="+" style="f"><char style="fr" closed="false">31:1 </char><char style="ft" closed="false">एती यहूदा रे लोका री गल्ल करी राखी </char></note> <verse eid="ISA 31:1" /><verse number="2" style="v" sid="ISA 31:2" />पर यहोवा ई अक्लमंद ए ओर से यहोवा ई ए जेस तिना खे दु:ख देणा, तेस आपणे वचन नि टाल़ने, पर उठी की कुकर्मिया रे करानेया पाँदे ओर बुरे काम करने वाल़ेया री मताद करने वाल़ेया पाँदे बी अमला करना। <verse eid="ISA 31:2" /><verse number="3" style="v" sid="ISA 31:3" />मिस्र देशो रे लोक परमेशर नि ए, माणूं ई ए; ओर तिना रे कोड़े आत्मा नि मास ई ए। जेबे यहोवे आथ बढ़ाणा, तेबे मताद करने वाल़े ओर मताद चाणे वाल़े दोनो ठोकर खाई की रूड़ने ओर सेयो सारे के सारे कट्ठे ई नाश ऊई जाणे।<verse eid="ISA 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 31:4" />फेर यहोवे माखे ईंयाँ बोलेया, “जिंयाँ शेर या जवान शेर जेबे आपणे शिकारो पाँदे गुर्राओआ ओर गवाल़े कट्ठे ऊई की तेसरे खलाफ बड़ी पीड़ लगाओगे, तेबे बी से तिना रे आल्ले ते नि डरदा ओर ना तिना रे आल्ले रिया बजा ते नठदा, तिंयाँ ई सर्वशक्तिमान यहोवा, सिय्योन पाह्ड़ ओर यरूशलेम शईरो री पाह्ड़िया री रक्षा करने खे ऊँदे उतरना। <verse eid="ISA 31:4" /><verse number="5" style="v" sid="ISA 31:5" />यहोवे तीईया ई यरूशलेम शईरो री रक्षा करनी जिया आपणे कोअले पाँदे उडदी ऊई चिड़िया आपणे बच्चेया री रक्षा करोई। यहोवे से बचाणा ओर तेसरी रक्षा करनी। यहोवा पाँदिए ऊई की निकल़ी जाणा और यरूशलेम शईरो री रक्षा करनी।”<verse eid="ISA 31:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 31:6" />ओ इस्राएलो रे लोको, तुसे यहोवे ते पूरी तरआ ते अटी गे दे ओ, तुसे परमेशरो री तरफा खेई फिरो। <verse eid="ISA 31:6" /><verse number="7" style="v" sid="ISA 31:7" />तेस बखते तुसा लोका सूईने ओर चाँदिए रिया आपणी-आपणी मूर्तिया साथे जिना खे बणाई की तुसे पापी ऊईगे रे, नफरत करनी। <verse eid="ISA 31:7" /><verse number="8" style="v" sid="ISA 31:8" />तेबे अश्शूर तेसा तलवारी साथे लड़ाईया दे टाल़ेया जाणा जो माणूंआ री नि ए; से तेसा तलवारी रा ग्रा ऊई जाणा जो माणूंआ री नि ए; ओर से तलवारी सामणे ते नठणा ओर तेसरे जवान सिपाई पकड़ी की दास बणाई देणे। <verse eid="ISA 31:8" /><verse number="9" style="v" sid="ISA 31:9" />से डरो रे मारे आपणे सुन्दर मईलो ते चली जाणा ओर तेसरे परदान कबराई की लड़ाईया रा चण्डा छाडी की नठी जाणे। यहोवा जेसरी आग सिय्योनो दे ओर जेसरा पट्ठा यरूशलेम शईरो दे ए, तेसरी येई बाणी ए।<verse eid="ISA 31:9" /></para>
  <chapter eid="ISA 31" />
  <chapter number="32" style="c" sid="ISA 32" />
  <para style="s">तार्मिकता रा राज</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 32:1" />आऊँ जो गल्ला बताणे लगी रा, देखो, कुछ दिन एकी राजे तर्मो साथे राज करना ओर राजकुमारा न्याय साथे राज करना।<note caller="+" style="f"><char style="fr" closed="false">32:1 </char><char style="ft" closed="false">प्रका. 19:11, इब्रा. 1:8-9 </char></note> <verse eid="ISA 32:1" /><verse number="2" style="v" sid="ISA 32:2" />नवां राजा ओर तेसरे सब अधिकारी मानो तूफानो ते लूकणे री जगा ओर छाछा ते लूकणे खे ऊणे या बिना पाणिए रे देशो दे पाणिए रे झरने ओर तपी री जमीना दे बड़ी चट्टानी री छांए ऊणे। <verse eid="ISA 32:2" /><verse number="3" style="v" sid="ISA 32:3" />तेस बखते देखणे वाल़े रिया आखी तुँदल़िया नि ऊणिया ओर सुणने वाल़ेया रे कान लगे दे रणे। <verse eid="ISA 32:3" /><verse number="4" style="v" sid="ISA 32:4" />पराऊणी करने वाल़ेया रे मना ज्ञानो रिया गल्ला समजणियां ओर तोतला बोलणे वाल़ेया रिया जीबा फटाफट ओर साफ बोलणा। <verse eid="ISA 32:4" /><verse number="5" style="v" sid="ISA 32:5" />मूर्ख लोका खे फेर ज्ञानी नि बोलेया जाणा ओर ना कँजूसो खे दानी बोलेया जाणा। <verse eid="ISA 32:5" /><verse number="6" style="v" sid="ISA 32:6" />कऊँकि मूर्ख तो मूर्खता री गल्ला बोलोआ ओर से आपणे मनो दे अनर्थ ई सोचदा रओआ ताकि से पापो रे काम करो ओर यहोवे रे खलाफ चूठ बोलो, पूखे खे पूखा ई रणी दो ओर त्याये खे त्याया ई। <verse eid="ISA 32:6" /><verse number="7" style="v" sid="ISA 32:7" />कपटिये रिया गल्ला बुरिया ओईया, से बुरिया योजना निकयाल़दा रओआ ताकि गरीबो खे बी प्यारो साथे बोली की चूठी गल्ला दे लूटो। <verse eid="ISA 32:7" /><verse number="8" style="v" sid="ISA 32:8" />पर खरा माणूं खरिया ई योजना निकयाल़ोआ, से खराईया साथे स्थिर बी रणा।<verse eid="ISA 32:8" /></para>
  <para style="s">यरूशलेम शईरो रिया जवाणसा</para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 32:9" />ओ सुखी जवाणसो, उठी की मेरी सुणो; ओ बेफिकर बेटियो, मेरे वचना रिया तरफा खे कान लगाओ। <verse eid="ISA 32:9" /><verse number="10" style="v" sid="ISA 32:10" />ओ बेफिकर जवाणसो, एकी सालो ते बाद ई तुसा पाँदे विपत्ति आऊणे वाल़ी ए, कऊँकि तुसे एक साल बाद अंगूर कट्ठे नि करी सकदिया, इजी री बजा ये कि तेस बखते ना तो तोड़ने खे अंगूर ऊणे ओर ना ई कोई फल़ मिलणा। <verse eid="ISA 32:10" /><verse number="11" style="v" sid="ISA 32:11" />ओ सुखी जवाणसो, डरो, ओ बेफिकर जवाणसो, आपणे-आपणे अच्छे टाल्ले खोली की आपणे-आपणे लको दे शोगो री टाट बानो। <verse eid="ISA 32:11" /><verse number="12" style="v" sid="ISA 32:12" />तुसा खरे डोरूआ खे ओर फल़ लगणे वाल़ी अंगूरा री बेला खे छाती पीटणी। <verse eid="ISA 32:12" /><verse number="13" style="v" sid="ISA 32:13" />मेरे लोका री जमीना पाँदे कांडे वाल़े डाल़ जमणे लगी रे। तिना सबी कअरा खे रोओ जेती लोक खुश थे ओर तेस यरूशलेम शईरो रिया तँईं जो जिन्दगिया साथे परेया रा था। <verse eid="ISA 32:13" /><verse number="14" style="v" sid="ISA 32:14" />कऊँकि राजे री जगा खाली ऊई जाणी, आल्ला करने वाल़ेया रा शईर सुनसाण ऊई जाणा, ओर पाह्ड़ी ओर तिना पाँदले पईरेदारा रे कअर सदा खे गुफा ओर बणो रे गह्देया खे कूमणे री जगा ओर करेलू डांगरा खे चरने री जगा तदुओ तक बणी दी रणी, <verse eid="ISA 32:14" /><verse number="15" style="v" sid="ISA 32:15" />जदुओ तक परमेशर आपणा आत्मा उबा ते आसा पाँदे नि लटी देयोगा ओर जंगल़ फल़ देणे वाल़ा बगीचा नि बणी जाओगा ओर फल़ देणे वाल़ा बगीचा फेर बण नि गिणेया जाओगा। <verse eid="ISA 32:15" /><verse number="16" style="v" sid="ISA 32:16" />तेबे तेस जंगल़ो दे न्याय बसणा ओर तेस फल़ देणे वाल़े बगीचे दे तर्म रणा। <verse eid="ISA 32:16" /><verse number="17" style="v" sid="ISA 32:17" />ओर तर्मो रा फल़ शान्ति ओर तिजी रा नतीजा सदा रा चैन ओर बेफिकर ऊणा।<note caller="+" style="f"><char style="fr" closed="false">32:17 </char><char style="ft" closed="false">रोम. 14:7, याकू. 3:18 </char></note> <verse eid="ISA 32:17" /><verse number="18" style="v" sid="ISA 32:18" />मेरे लोक शान्तिया रिया बांकिया जगा दे बेफिकर रणे ओर रामो री जगा दे सुखो साथे रणे। <verse eid="ISA 32:18" /><verse number="19" style="v" sid="ISA 32:19" />पर जंगल़ो रे नाशो रे बखते ओल़े बरसणे ओर शईर पूरी तरअ ते बर्बाद ऊई जाणा। <verse eid="ISA 32:19" /><verse number="20" style="v" sid="ISA 32:20" />तुसे बऊत तन्य ए जो सबी पाणिए रे कनारे बिऊ लगाओए ओर बल़द ओर गह्देया खे रामो दे चराओए।<verse eid="ISA 32:20" /></para>
  <chapter eid="ISA 32" />
  <chapter number="33" style="c" sid="ISA 33" />
  <para style="s">मतादा रिया तँईं प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 33:1" />लाणत ए तां नाश करने वाल़े पाँदे जो नाश नि कित्तेया गया था, लाणत ए तां विश्वासघातिये पाँदे, जेस साथे विश्वासघात नि कित्तेया! जेबे तूँ नाश करी चुकेगा, तेबे तूँ बी पूरी तरआ ते नाश कित्तेया जाणा ओर जेबे तूँ विश्वासघात करी चुकेगा, तेबे तां साथे बी विश्वासघात कित्तेया जाणा।<note caller="+" style="f"><char style="fr" closed="false">33:1 </char><char style="ft" closed="false">एती दुश्मण अश्शूर थे </char></note> <verse eid="ISA 33:1" /><verse number="2" style="v" sid="ISA 33:2" />ओ यहोवा, आसा लोका पाँदे दया कर, आसा री उम्मीद तूँ ई ए। तूँ आसा खे हर दिन मजबूत कर, ओर मुसीबता रे बखते म्हारा उद्धार करने वाल़ा बण। <verse eid="ISA 33:2" /><verse number="3" style="v" sid="ISA 33:3" />म्हारे दुश्मण यहोवे री आवाज सुणदे ई नठीगे, तेरे उठदे ई दूजिया जातिया रे लोक ओरे-पोरे ऊईगे। <verse eid="ISA 33:3" /><verse number="4" style="v" sid="ISA 33:4" />जिंयाँ टिड्डिया नज्जो खे चट करी देयोइया, तिंयाँ ई तुसा री लूट बी तुसा रे दुश्मणा चट करी देणी ओर जिंयाँ टिड्डिया फसला खे नाश करने खे अमला करोईया, तिंयाँ ई तिना बी तुसा पाँदे अमला करना।<verse eid="ISA 33:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 33:5" />यहोवा बऊत महान ए, से बऊत ऊच्चिया जगा स्वर्गो दे रओआ, यहोवे सिय्योन शईर न्याय ओर तर्मो साथे परी राखेया; <verse eid="ISA 33:5" /><verse number="6" style="v" sid="ISA 33:6" />ओर उद्धार, बुद्धि ओर बऊत जादा ज्ञान तेरे दिना रा आधार ऊणा; यहोवे रा डर तेसरा तअन ऊणा। <verse eid="ISA 33:6" /><verse number="7" style="v" sid="ISA 33:7" />देख, तिना रे शूरवीर<note caller="+" style="f"><char style="fr" closed="false">33:7 </char><char style="fq" closed="false">शूरवीर </char><char style="ft" closed="false">यरूशलेमो रे सिपाई </char></note> बारे चींगणे लगी रे, मेल करने वाल़े दूत ईंकी-ईंकी की रोणे लगी रे। <verse eid="ISA 33:7" /><verse number="8" style="v" sid="ISA 33:8" />सारिया बाटा सूनिया पड़ी रिया, एबे तिना बाटा रिये लोक नि चलदे। तिने वादा तोड़ी ता, शईर तुच्छ जाणे, तिने माणूं कुछ नि समजे। <verse eid="ISA 33:8" /><verse number="9" style="v" sid="ISA 33:9" />यहूदा प्रदेशो री तरती विलाप करदी ओर फूखी गी री; लबानोन पाह्ड़ो रे डाल़ सूकी गे रे ओर तिना पाँदे उदासी छायी गी री, शारोन पजणे वाल़ी जमीना रे बदले सापड़ी वाल़ी जमीना जेड़ा ऊईगा रा; बाशान ओर कर्मेलो रे बणा दे डाल़ो रे पत्ते अल़ने लगी रे।<verse eid="ISA 33:9" /></para>
  <para style="s">परमेशरो रे दुश्मणा खे चतौणी</para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 33:10" />यहोवा बोलोआ, “एबे मां उठणा, मां आपणा प्रताप दखाणा, एबे आऊँ लोका रिया तँईं महान ठईरना। <verse eid="ISA 33:10" /><verse number="11" style="v" sid="ISA 33:11" />तुसे लोके बेकारो रे काम करी राखे। तुसा रे सूके काओ रा गर्भ रणा, तुसा ते पूऊ जमणा, तुसा री आत्मा आगी जेड़ी ऊई जाणी ओर तुसे फूकी देणे। <verse eid="ISA 33:11" /><verse number="12" style="v" sid="ISA 33:12" />यहूदा रे दुश्मण फूखे रे चूने जेड़े ऊई जाणे, ओर बाड़ो जेड़े आगी दे फूके जाणे। <verse eid="ISA 33:12" /><verse number="13" style="v" sid="ISA 33:13" />ओ दूर-दूर देशा रे लोको, सुणो कि मैं क्या करी राखेया? ओर तुसे बी जो नेड़े ए, मेरी तागत जाणी लो। <verse eid="ISA 33:13" /><verse number="14" style="v" sid="ISA 33:14" />सिय्योनो रे पापी लोक डरी गे, जो परमेशरो खे नि मानदे तिना खे थुरनी छूटी गी; आसा बीचा ते कोई बी एड़ा नि ए जो प्रचण्ड आगी दे रयी सको। आसा बीचा ते कोई नि ये जो तेसा बल़ी रिया आगी दे जाणे दे बाद जिऊँदा रयी सकोआ, जो कदी नि बिजणी।”<note caller="+" style="f"><char style="fr" closed="false">33:14 </char><char style="ft" closed="false">इब्रा. 12:29 </char></note><verse eid="ISA 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 33:15" />सेओ लोक ई एसा आगी ते बची सकोए जो तर्मो साथे चलोए ओर सीदी गल्ल बोलोए, जो अन्देरो रे फायदे ते नफरत करोए, जो रिश्वत नि लंदे, जो खूनो री गल्ल सुणने ते कान बन्द करी देओए ओर बुराई देखणे ते आखी बन्द करी देओए। सेई ऊच्ची जगा रे रणे। <verse eid="ISA 33:15" /><verse number="16" style="v" sid="ISA 33:16" />से चट्टानी रे गढ़ो दे शरण लई की रणे, तिना खे खाणे खे रोटी ओर पीणे खे पाणी मिलणा।<verse eid="ISA 33:16" /></para>
  <para style="s">आऊणे वाल़ा खरा बखत</para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 33:17" />तां आपणी आखी साथे राजा यहोवे खे तेसरी शोभा साथे देखणा ओर लाम्बा-चौड़ा देश देखणा।<note caller="+" style="f"><char style="fr" closed="false">33:17 </char><char style="ft" closed="false">मत्ती 17:2, यूह. 1:14 </char></note> <verse eid="ISA 33:17" /><verse number="18" style="v" sid="ISA 33:18" />तां डरो रे दिन याद करने, लेखा लणे वाल़ा ओर कर तोली की लणे वाल़ा केयी रया? गुम्मटो रा गिणने वाल़ा केयी रया?<note caller="+" style="f"><char style="fr" closed="false">33:18 </char><char style="ft" closed="false">1 कुरि. 1:20 </char></note> <verse eid="ISA 33:18" /><verse number="19" style="v" sid="ISA 33:19" />जिना री कठण पाषा तूँ नि समजदा ओर जिना री बड़बड़ांदी जीबा री गल्ल तूँ नि समजी सकदा, सेयो निर्दयी लोक तां फेर नि देखणे। <verse eid="ISA 33:19" /><verse number="20" style="v" sid="ISA 33:20" />म्हारे तार्मिक त्योआरो रे शईर सिय्योनो खे देख, तां आपणी आखी साथे यरूशलेम देखणा, से राम करने री जगा ओर एड़ा तम्बू ए जो कदी टाल़ेया नि जाणा, जेतेरा कोई बी खूँडा कदी नि पट्टेया जाणा ओर ना कदी कोई रस्सी टूटणी। <verse eid="ISA 33:20" /><verse number="21" style="v" sid="ISA 33:21" />तेती महान यहोवा आसा रिया तँईं रणा, से बऊत बड़ी-बड़ी नदिया ओर नईरा री जगा ऊणा, जिदे म्हारे दुश्मण कदी नि चली सकणे ओर ना ई कोई युद्धो रा जाह्ज तिदे जाणा ओर ना दुश्मणा रा तागतबर जाह्ज तिसिये जाई सकणा। <verse eid="ISA 33:21" /><verse number="22" style="v" sid="ISA 33:22" />कऊँकि यहोवा म्हारा न्यायी, यहोवा म्हारा परदान, यहोवा म्हारा राजा ए, तेस ई म्हारा उद्धार करना। <verse eid="ISA 33:22" /><verse number="23" style="v" sid="ISA 33:23" />तेरी रस्सिया टीलिया ऊईगिया, सेयो मस्तूलो रिया जड़ा खे मजबूत नि राखी सकिया ओर ना तरपालो खे ताणी की राखी सकिया। तेबे दुश्मणा ते लूटी रिया चीजा छुड़ाई की बांडी तिया, लंगड़े लोक बी लूटा दे शामिल ऊए। <verse eid="ISA 33:23" /><verse number="24" style="v" sid="ISA 33:24" />तेबे यरूशलेम शईरो दे रणे वाल़ेया केसी बी लोका नि बोलणा कि आऊँ बमार ए; ओर जो लोक तिदे बसणे, तिना रा पाप माफ करेया जाणा।<verse eid="ISA 33:24" /></para>
  <chapter eid="ISA 33" />
  <chapter number="34" style="c" sid="ISA 34" />
  <para style="s">परमेशरो आपणे दुश्मणा खे सजा देणी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 34:1" />ओ सारे देशो री जातिया-जातिया रे लोको, सुणने खे नेड़े आओ ओर ओ राज-राज रे लोको, त्यानो साथे सुणो! तरती बी ओर जो कुछ तिदे ए, दुनिया ओर जो कुछ तिदे पैदा ओआ, सब कान खोली की सुणो। <verse eid="ISA 34:1" /><verse number="2" style="v" sid="ISA 34:2" />यहोवा सबी जातिया पाँदे रोष करने लगी रा ओर तिना री सारी सेना पाँदे तेसरा रोष पड़की रा, तिने सेयो तिना रे दुश्मणा रे आथो दे नाश ऊणे ओर संहार ऊणे खे छाडी ते रे। <verse eid="ISA 34:2" /><verse number="3" style="v" sid="ISA 34:3" />तिना रे लोक काई की बारे सेटी देणे ओर तिना री लाशा ते सड़यान आऊणी, तिना रे खूनो साथे पाह्ड़ बी टखी जाणे। <verse eid="ISA 34:3" /><verse number="4" style="v" sid="ISA 34:4" />सर्गो रे सारे ग्रह, सूरज, चाँद ओर तारे चूर-चूर ऊई जाणे, सर्ग रूड़ी जाणा ओर तेतेरिया सारिया चीजा रूड़ी जाणिया ओर सर्ग कागजो जेड़ा लपेटी देणा। जिंयाँ अंगूर या दाऊगल़े रे पत्ते सूकी की अल़ी जाओए, तिंयाँ ई सर्गो रे सारे तारेया री चमक जांदी रणी।<note caller="+" style="f"><char style="fr" closed="false">34:4 </char><char style="ft" closed="false">मत्ती 24:29, मर. 13:25, लूक. 21:26, 2 पत. 3:12, प्रका. 6:13,14 </char></note> <verse eid="ISA 34:4" /><verse number="5" style="v" sid="ISA 34:5" />यहोवा बोलोआ, एड़ा तेस बखते ऊणा जेबे सर्गो दे मेरी तलवार खून पी की रज्जी जाणी, देखो यहोवे री नाश करने वाल़ी तलवार एदोमो पाँदे, ओर जिना पाँदे परमेशरो रा स्राप ए तिना पाँदे पड़नी।<note caller="+" style="f"><char style="fr" closed="false">34:5 </char><char style="ft" closed="false">एदोमी याकूबो रे पाई एसावो रे कुलो रे थे, उत्प. 25:30। </char></note> <verse eid="ISA 34:5" /><verse number="6" style="v" sid="ISA 34:6" />यहोवे री तलवार खूनो साथे परी गी री, से चर्बिया साथे, ओर पेडा रे बच्चे, बाकरेया रे खून ओर खाडूआ रे गुर्देया री चर्बिया साथे रज्जी गी री ए। कऊँकि बोस्रा शईरो दे यहोवे रा एक यज्ञ ओर एदोम प्रदेशो दे बड़ा संहार ऊई रा।<verse eid="ISA 34:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 34:7" />एदोमिया साथे जंगल़ी सांड, बाच्छू ओर बल़द फाटणे ओर तिना री जमीन खूनो साथे सीजी जाणी ओर तेथो री माट्टी चर्बिया साथे मोटी ऊई जाणी। <verse eid="ISA 34:7" /><verse number="8" style="v" sid="ISA 34:8" />कऊँकि बदला लणे खे यहोवे रा एक दिन ओर सिय्योनो रा मुकद्दमा चुकाणे खे एक साल ठराई राखेया ए। <verse eid="ISA 34:8" /><verse number="9" style="v" sid="ISA 34:9" />ओर एदोमो रिया नदिया तारकोल़ा साथे ओर तेथो री माट्टी गन्धको दे बदली जाणी, एदोमो री माट्टी फूकदी ऊई तारकोल़ बणी जाणी। <verse eid="ISA 34:9" /><verse number="10" style="v" sid="ISA 34:10" />से दिन-रात बल़दी रणी, कोई बी आदमी तेसा आगी खे नि रोकी सकदा तेतेरा तुआँ सदा उठदा रणा। से तरती युगो-युगो तक उजाड़ पड़ी दी रणी, कोई तिसिये ऊई की कदी नि चलणा।<note caller="+" style="f"><char style="fr" closed="false">34:10 </char><char style="ft" closed="false">प्रका. 14:11, प्रका. 19:3 </char></note> <verse eid="ISA 34:10" /><verse number="11" style="v" sid="ISA 34:11" />पर तेती जंगल़ी पंछी ओर डांगर ऊणे ओर तेती उल्लू ओर कावा रे बसेरे ऊणे। तेस तेते पाँदे गड़बड़िया री डोरी ओर सुनसानिया रा साल़ लगाणा।<note caller="+" style="f"><char style="fr" closed="false">34:11 </char><char style="ft" closed="false">प्रका. 18:2, सप. 2:14 </char></note> <verse eid="ISA 34:11" /><verse number="12" style="v" sid="ISA 34:12" />तेती ना तो अमीर ऊणे ओर ना कोई एड़ा ऊणा जो राज करने खे ठराया जाओ, तेसरे सबी परदाना रा अन्त ऊणा।<note caller="+" style="f"><char style="fr" closed="false">34:12 </char><char style="ft" closed="false">प्रका. 6:15 </char></note> <verse eid="ISA 34:12" /><verse number="13" style="v" sid="ISA 34:13" />तेथो रे सारे बांके मईला दे कांडेवाल़े डाल़, गढ़ा दे बिच्छूए रे पौधे ओर जाड़ जमणा। से गीदड़ा रे रणे री जगा ओर शुतुरमुर्गेया रे रणे री जगा बणी जाणी। <verse eid="ISA 34:13" /><verse number="14" style="v" sid="ISA 34:14" />एदोमो रे रेगिस्तानो रे देशो रे जानवर कुत्तेया साथे मिली की बसणे ओर जंगल़ी बाकरिया एकी-दूजे खे आका पाया करनिया; तेती जानवरा आपणा डेरा पाई की रात कटेया करनी। डराऊणा जानवर चैना साथे रया करना।<note caller="+" style="f"><char style="fr" closed="false">34:14 </char><char style="ft" closed="false">प्रका. 18:2 </char></note> <verse eid="ISA 34:14" /><verse number="15" style="v" sid="ISA 34:15" />तेती उल्लूआ अण्डे देणे ओर जेबे अण्डे टूटी जाणे, तेबे माया सेयो तिना रे पंख आऊणे तक सेयो टखी देणे, तेती ईला आपणे साथिया साथे मिली की रणियां। <verse eid="ISA 34:15" /><verse number="16" style="v" sid="ISA 34:16" />यहोवे री कताबा दे टोल़ी की पढ़ो, तिदे क्या लिखी राखेया। इना बीचा ते एक बी गल्ल बिना पूरे ऊणे ते नि रणी, कोई बी पंछी बिना जोड़े ते नि रणा, कऊँकि परमेशरे आपणे मुंए ते ये आज्ञा देई राखी ओर तेसरी आत्मे सेयो कट्ठे करी राखे। <verse eid="ISA 34:16" /><verse number="17" style="v" sid="ISA 34:17" />ये यहोवा ए तिने ई फैंसला करी राखेया कि एदोम प्रदेशो री जमीना दे कुण रणा, तिने ई आपणे आथो साथे डोरी ओर साल़ लगाई की एदोमो री जमीन पूरी तरआ ते बणो रे जानवरा खे देईती दी ए, से सदा तिना रा ई बणेया दा रणा ओर सेयो पीढ़िया ते पीढ़िया तक तिदे ई बसे रे रणे।<verse eid="ISA 34:17" /></para>
  <chapter eid="ISA 34" />
  <chapter number="35" style="c" sid="ISA 35" />
  <para style="s">परमेशरो आपणे लोका खे सुख देणा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 35:1" />उजाड़ जगा ओर रेगिस्तान खुश ऊणे, उजाड़ जगा मगन ऊई की केसरो जेड़े खुश ऊणी, <verse eid="ISA 35:1" /><verse number="2" style="v" sid="ISA 35:2" />रेगिस्तान बऊत खुश ऊणा ओर तेस खुशिया साथे जयजयकार करनी। रेगिस्तान एड़ा सुन्दर ऊई जाणा जेड़ा लबानोनो री पाह्ड़िया ए, ओर से कर्मेल ओर शारोनो री जमीना जेड़ा तेजोमय ऊई जाणा। तिना यहोवे री सामर्थ ओर म्हारे परमेशरो रा तेज देखणा।<verse eid="ISA 35:2" /></para>
  <para style="s">परमेशरो रे जरिये सब कुछ बदलणा</para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 35:3" />इजी री खातर कमजोर आथा खे तागतबर बणाओ ओर थरथराए रे जानूआ खे मजबूत करो।<note caller="+" style="f"><char style="fr" closed="false">35:3 </char><char style="ft" closed="false">इब्रा. 12:12 </char></note> <verse eid="ISA 35:3" /><verse number="4" style="v" sid="ISA 35:4" />डरने वाल़ेया खे बोलो, “याओ बानो, डरो नि! देखो, तुसा रा परमेशर बदला लणे ओर फल़ देणे आऊणे लगी रा। आ, परमेशरो आई की तुसा रा उद्धार करना।” <verse eid="ISA 35:4" /><verse number="5" style="v" sid="ISA 35:5" />तेबे अन्देया रिया आखी खोलिया जाणिया ओर सेयो देखणे लगणे। टऊणेया रे कान बी खोले जाणे ओर सेयो सुणने लगणे। <verse eid="ISA 35:5" /><verse number="6" style="v" sid="ISA 35:6" />तेबे लंगड़े ईरणो जेड़ा दौड़ना ओर गूँगेया आपणी जीबा साथे परमेशरो री जयजयकार करनी, कऊँकि जंगल़ो ते पाणिए रिया सूबल़ा फूटणियां ओर रेगिस्तान जगा दे नदिया बह्ईणे लगणियां;<note caller="+" style="f"><char style="fr" closed="false">35:6 </char><char style="ft" closed="false">मत्ती 11:5, यशा. 41:17,18 </char></note> <verse eid="ISA 35:6" /><verse number="7" style="v" sid="ISA 35:7" />बऊत गर्म जमीन ओर सूके मैदान पाणिए री खाड्डा दे बदली जाणे, सूकी जमीना दे सूबल़ा फूटणियां ओर जेते जगा दे सयार बैठेया करो थे तिदे दल-दल काआ, ओर नंगल़ ओर जाड़ ऊणे।<verse eid="ISA 35:7" /></para>
  <para style="s">परमेशरो री पवित्र बाट</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 35:8" />तेती एक सड़क, मतलब राजमार्ग ऊणा, तेरे राजमार्गो रा नाओं पवित्र बाट ऊणा, कोई अशुद्ध माणूं तिसिये नि जाई सकणा, से तिना खेई रणा ओर जो तेसा बाटा दे चलणे, से चाए मूर्ख बी ओ, तेबे बी कदी नि पटकणे। <verse eid="ISA 35:8" /><verse number="9" style="v" sid="ISA 35:9" />तेती शेर नि ऊणा ओर ना ई कोई खतरनाक जानवर तेसा बाटा दे ऊणा, पर सेयो लोक जो परमेशरे गुलामिया ते छुड़ाई राखे तेते बाटा रिये रोज चलेया करने। <verse eid="ISA 35:9" /><verse number="10" style="v" sid="ISA 35:10" />ओर यहोवे रे छुड़ाए रे लोक वापस ऊई की जयजयकार करदे ऊए सिय्योनो दे आऊणे ओर तिना रे सिरो पाँदे सदा री खुशी ऊणी, तिना खे खुशी ओर आनन्द मिलणा, तिना खे कदी बी शोग ओर दु:ख नि ऊणा।<note caller="+" style="f"><char style="fr" closed="false">35:10 </char><char style="ft" closed="false">प्रका. 21:4 </char></note><verse eid="ISA 35:10" /></para>
  <chapter eid="ISA 35" />
  <chapter number="36" style="c" sid="ISA 36" />
  <para style="s">अश्शूरो रा यहूदा पाँदे अमला</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1" />यहूदा प्रदेशो रे राजा हिजकिय्याह रे राजो रे चौदुए सालो दे, अश्शूरो रे राजे सन्हेरीबे यहूदा रे सारे गढ़वाल़े शईरा पाँदे अमला करी की सेयो लई ले। <verse eid="ISA 36:1" /><verse number="2" style="v" sid="ISA 36:2" />ओर अश्शूरो रे राजे आपणी बड़ी सेना रबशाके<note caller="+" style="f"><char style="fr" closed="false">36:2 </char><char style="fq" closed="false">रबशाके </char><char style="ft" closed="false">सेना रा सबी ते बड़ा अधिकारी </char></note> खे देई की लाकीश शईरो ते यरूशलेम शईरो रे राजा हिजकिय्याह गे पेजेया। रबशाके उत्तरो रे पूल़ो री नाल़िया गे तोबिया रे डोरूआ री सड़का पाँदे जाई की खड़ा ऊआ। <verse eid="ISA 36:2" /><verse number="3" style="v" sid="ISA 36:3" />तेबे हिल्किय्याह रा पाऊ एल्याकीम, जो राजकराने रे कामो पाँदे नियुक्त था, ओर शेबना जो राजे रा मंत्री था ओर आसापो रा पाऊ योआह जो इतिआसो रा लिखणे वाल़ा था, राजे रे यो तीनो सबी ते बड़े अधिकारी अश्शूरो रे राजे रे दूतो ते मिलणे खे बारे निकल़ी गे। <verse eid="ISA 36:3" /><verse number="4" style="v" sid="ISA 36:4" />अश्शूरो रे सेनापति रबशाके तिना खे बोलेया, “हिजकिय्याह खे बोलो कि अश्शूरो रा राजा ईंयाँ बोलोआ कि तू केसरा परोसा करी की बैठी रा? <verse eid="ISA 36:4" /><verse number="5" style="v" sid="ISA 36:5" />मेरे बोलणे रा मतलब ए कि क्या मुंए ते गल्ला बोलणिया ई युद्ध करने खे पराक्रम ओर योजना ए? तू केस पाँदे परोसा राखेया, कि तैं मां साथे बगावत करी राखी? <verse eid="ISA 36:5" /><verse number="6" style="v" sid="ISA 36:6" />सुण, तूँ तो तेस केसे रे नंगल़ो जेड़ा ए, मतलब मिस्रो पाँदे परोसा राखेया; तेस पाँदे जे कोई टेक लगाओ तो तेस तेसरे आथो दे चूबी की छेद करी देणा। मिस्रो रा राजा फिरौन तिना सबी साथे एड़ा ई करोआ जो तेस पाँदे परोसा राखोए।” <verse eid="ISA 36:6" /><verse number="7" style="v" sid="ISA 36:7" />अश्शूरो रे राजे रे दूते आगे बोलेया, “फेर जे तूँ माखे बोले कि म्हारा परोसा आपणे परमेशर यहोवे पाँदे ए, ये हिजकिय्याह ई था जिने यहोवे री पवित्र जगा ओर बेदिया नाश कित्तिया थिया ओर फेर यहूदा रे लोका खे सिर्फ यरूशलेमो री बेदिया पाँदे ई आराधना करने री आज्ञा दित्ती थी। <verse eid="ISA 36:7" /><verse number="8" style="v" sid="ISA 36:8" />इजी री खातर एबे मेरे मालक अश्शूरो रे राजे साथे वाचा बान, तेबे मां ताखे 2,000 कोड़े देणे, जे तूँ तिना पाँदे सवार चढ़ाई सके। <verse eid="ISA 36:8" /><verse number="9" style="v" sid="ISA 36:9" />तेबे तूँ रथ ओर सवारा रिया तँईं मिस्रो पाँदे परोसा राखी की मेरे मालको रे छोटे ते छोटे काम करने वाल़े सेनापतिये खे बी किंयाँ अराई सकेया? <verse eid="ISA 36:9" /><verse number="10" style="v" sid="ISA 36:10" />क्या मैं यहोवे ते बिना बोले एस देशो खे उजाड़ने रिया तँईं चढ़ाई करी राखी? यहोवे माखे बोली राखेया कि तेस देशो पाँदे अमला करी की तेसखे उजाड़ी दे।”<verse eid="ISA 36:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11" />यरूशलेम शईरो रे तीनो आदमी, एल्याकीम, शेबना ओर योआहे रबशाके खे बोलेया, “आपणे दासा साथे अरामी पाषा दे गल्ला कर कऊँकि आसे तेसा पाषा खे समजूँए, आसा साथे यहूदी पाषा दे गल्ला नि कर कऊँकि शईरो री दवाला पाँदे लोक बैठी की सुणने लगी रे।” <verse eid="ISA 36:11" /><verse number="12" style="v" sid="ISA 36:12" />रबशाके बोलेया, “क्या मेरे मालके आऊँ तुसा गेई यो गल्ला बोलणे खे पेजी राखेया? क्या तिने आऊँ इना लोका गे नि पेजी राखेया जो दवाला पाँदे बैठी रे, जिना खे तुसा साथे आपणा गू खाणा ओर आपणा पशाब पीणा पड़ना।” <verse eid="ISA 36:12" /><verse number="13" style="v" sid="ISA 36:13" />तेबे रबशाके खड़े ऊई की यहूदी पाषा दे जोरे की बोलेया, “अश्शूरो रे राजा महाराजाधिराजो रिया गल्ला सुणो! <verse eid="ISA 36:13" /><verse number="14" style="v" sid="ISA 36:14" />अश्शूरो रा राजा ईंयाँ बोलोआ कि, तुसा रा राजा हिजकिय्याह तुसा खे तोखा नि देयो, कऊँकि से तुसा खे बचाई नि सकदा। <verse eid="ISA 36:14" /><verse number="15" style="v" sid="ISA 36:15" />एड़ा नि ओ कि हिजकिय्याह तुसा खे ये बोली की यहोवे रा परोसा दलाओ कि आसे यहोवे जरूर बचाणे ताकि ये यरूशलेम शईर अश्शूरो रे राजे रे वशो दे नि पड़ो।” <verse eid="ISA 36:15" /><verse number="16" style="v" sid="ISA 36:16" />आपणे राजा हिजकिय्याह री नि सुणो; अश्शूरो रा राजा बोलोआ कि माखे पेंट पेजी की खुश करो ओर मांगे आओ; तेबे तुसे आपणे-आपणे अंगूर ओर दाऊगल़े खाई सकोए ओर आपणे-आपणे कुण्डो रा पाणी पी सकोए। <verse eid="ISA 36:16" /><verse number="17" style="v" sid="ISA 36:17" />जदुओ तक आऊँ आई की तुसा खे एड़े देशो दे नि लई जाऊँ जो तुसा रे देशो जेड़ा नज्ज ओर नये शराबो रा देश ओर रोटी ओर अंगूरा रे बगीचे रा देश ए। <verse eid="ISA 36:17" /><verse number="18" style="v" sid="ISA 36:18" />एड़ा नि ओ कि हिजकिय्याह ये बोली की तुसा खे बईकाओ कि आसे यहोवे बचाणे। क्या ओरी जातिया रे देवते आपणे-आपणे देश अश्शूरो रे राजे रे आथो ते बचायी राखे? <verse eid="ISA 36:18" /><verse number="19" style="v" sid="ISA 36:19" />हमात ओर अर्पादो शईरो रे देवता केयी रये? सपवैंम राज रे देवता केयी रये? क्या तिने सामरिया रे लोक मेरे आथो ते बचाए?<note caller="+" style="f"><char style="fr" closed="false">36:19 </char><char style="ft" closed="false">सामरिया इस्राएलो रे उत्तरा रे राज्य री राजधानी थी, जेते खे अश्शूरिये 721 ई. पू. जीती ला था 2 राज. 18:11-12 </char></note> <verse eid="ISA 36:19" /><verse number="20" style="v" sid="ISA 36:20" />देशो-देशो रे सारे देवतेया बीचा ते एड़ा कुण ए जिने आपणा देश मेरे आथो ते बचाया ओ? तेबे क्या यहोवे यरूशलेम मेरे आथो ते बचाणा? <verse eid="ISA 36:20" /><verse number="21" style="v" sid="ISA 36:21" />पर यरूशलेमो रे लोक शईरो री दवाला पाँदे खड़े दे रये<note caller="+" style="f"><char style="fr" closed="false">36:21 </char><char style="ft" closed="false">हिजकिय्याह रे अधिकारी एल्याकीम, शेबना ओर योआह </char></note> ओर तेसखे एक बी ज्वाब नि दित्तेया, कऊँकि हिजकियाह राजे री एड़ी आज्ञा थी कि सेनापतिये खे कोई ज्वाब नि देणा। <verse eid="ISA 36:21" /><verse number="22" style="v" sid="ISA 36:22" />तेबे हिल्किय्याह रा पाऊ एल्याकीम, जो राजकराने पाँदे नियुक्त था ओर शेबना जो राजे रा मंत्री था ओर आसापो रा पाऊ योआह जो इतिआसो रा लिखणे वाल़ा था, इने हिजकिय्याह गे जाई की दु:खो दे आपणे टाल्ले फाड़े ओर सीरिया रे सेना रे बड़े अधिकारी रबशाके रिया गल्ला सुणाईयां।<verse eid="ISA 36:22" /></para>
  <chapter eid="ISA 36" />
  <chapter number="37" style="c" sid="ISA 37" />
  <para style="s">राजा हिजकिय्याह रा यशायाह ते सला लणा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1" />जेबे हिजकिय्याह राजे सेनापतिये रिया यो गल्ला सुणिया, तेबे से दु:खो दे आपणे टाल्ले फाड़ी की ओर दु:ख बताणे खे टाट टखी की यहोवे रे मन्दरो दे गया। <verse eid="ISA 37:1" /><verse number="2" style="v" sid="ISA 37:2" />ओर तिने एल्याकीम जो राजकराने रे कामो पाँदे नियुक्त था ओर शेबना मंत्री ओर पुरोईता रे बुजुर्ग जिने सबी जणेया टाट टखी राखी थी, आमोसो रे पाऊ यशायाह नबीए गे पेजी ते। <verse eid="ISA 37:2" /><verse number="3" style="v" sid="ISA 37:3" />राजा हिजकिय्याह रे अधिकारिए यशायाह खे बोलेया, “राजा हिजकिय्याह ईंयाँ बोलोआ कि आजका दिन शोक ओर दु:खो रा एक खास दिन ऊणा, ए दिन एक एड़ा दिन ऊणा जिंयाँ एक बच्चा जन्म लओआ पर बच्चे खे जन्म देणे वाल़ी माया दे जितणी तागत ऊणी चाईए तेसा दे तितणी तागत नि ऊँदी। <verse eid="ISA 37:3" /><verse number="4" style="v" sid="ISA 37:4" />पर क्या पता तेरे परमेशर यहोवा रबशाके रिया गल्ला सुणिया ओ, जो तेसरे मालके अश्शूरो रे राजे जिऊँदे परमेशरो री बेज्जती करने खे पेजी राखेया था ओर जो गल्ला तेरे परमेशर यहोवा सुणी राखिया तिना रे बदले परमेशर तिना खे सजा देयो, कृपा करी की इस्राएलो रे तिना थोड़े जे लोका रिया तँईं प्रार्थना कर जो बची गे रे।”<verse eid="ISA 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5" />जेबे हिजकिय्याह राजे रे सेयो अधिकारी नबी यशायाह गे आये। <verse eid="ISA 37:5" /><verse number="6" style="v" sid="ISA 37:6" />तेबे यशायाहे तिना खे बोलेया, “आपणे मालको खे बोलो कि यहोवा ईंयाँ बोलोआ कि जो गल्ला तैं सुणी राखिया जिना रे जरीये अश्शूरो रे राजे रे माणूंए मेरी बेज्जती करी राखी, तिना रिया बजा ते नि डर। <verse eid="ISA 37:6" /><verse number="7" style="v" sid="ISA 37:7" />सुण, मां तेसरे मनो दे एड़ी आत्मा पाणी कि जेते कि से कोई सन्देश सुणी की आपणे देशो खे वापस ऊई जाओ ओर मां से तेसरे देशो देई से तलवारी साथे मरवाई देणा।”<verse eid="ISA 37:7" /></para>
  <para style="s">अश्शूरो री सेना रा यरूशलेम शईरो खे छाडणा</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8" />तेबे रबशाके वापस ऊई की अश्शूरो रा राजा लिब्ना शईरो साथे युद्ध करदा ऊआ देखेया, कऊँकि तिने सुणेया था कि से लाकीश शईरो ते उठी गा रा। <verse eid="ISA 37:8" /><verse number="9" style="v" sid="ISA 37:9" />तिने कूशो रे राजा तिर्हाका रे बारे दे ये सुणेया कि से तेस साथे लड़ने खे आऊणे लगी रा। तेबे अश्शूरो रे राजे हिजकिय्याह रे नेड़े दूत ये बोलणे खे पेजे, <verse eid="ISA 37:9" /><verse number="10" style="v" sid="ISA 37:10" />“तुसे यहूदा रे राजा हिजकिय्याह खे ईंयाँ बोलणा कि तेरा परमेशर जेस पाँदे तूँ परोसा राखेया, ये बोली की ताखे तोखा नि देयो कि यरूशलेम अश्शूरो रे राजे रे वशो दे नि पड़ना। <verse eid="ISA 37:10" /><verse number="11" style="v" sid="ISA 37:11" />देख, तैं अश्शूरो रे राजे रे बारे दे सुणी राखेया कि तिने सबी देशा साथे क्या करी राखेया कि सेयो सत्यानाश ई करीते। <verse eid="ISA 37:11" /><verse number="12" style="v" sid="ISA 37:12" />तेबे क्या तूँ बची सकणा? गोजान, हारान ओर रेसेप शईरा दे रणे वाल़िया जो जातिया ओर तलस्सार शईरो दे रणे वाल़े एदेनी लोक मेरे बुजुर्गे नाश कित्ते, क्या तिना रे देवते तिना खे बचाई सके? <verse eid="ISA 37:12" /><verse number="13" style="v" sid="ISA 37:13" />हमात ओर अर्पाद शईरो रा राजा, सपवैंम शईरो रा राजा ओर हेना ओर इव्वा शईरा रे राजा, यो सारे केयी गे?”<verse eid="ISA 37:13" /></para>
  <para style="s">राजा हिजकिय्याह री परमेशरो ते प्रार्थना</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14" />ये पर्ची राजा हिजकिय्याहे दूता रे आथो ते लई की पढ़ी, तेबे तिने ये पर्ची यहोवे रे मन्दरो दे जाई की यहोवे सामणे बखेरी तिया। <verse eid="ISA 37:14" /><verse number="15" style="v" sid="ISA 37:15" />फेर हिजकिय्याह राजे यहोवे ते ये प्रार्थना कित्ती, <verse eid="ISA 37:15" /><verse number="16" style="v" sid="ISA 37:16" />“ओ सेना रे यहोवा, तू राजे जेड़ा करूबा पाँदे विराजमान इस्राएलो रे परमेशर, तरतिया रे सबी राजेया पाँदे बस तूँ ई परमेशर ए, सर्ग ओर तरती तैंई बणाई राखी। <verse eid="ISA 37:16" /><verse number="17" style="v" sid="ISA 37:17" />ओ यहोवा, कान लगाई की सुण, ओ यहोवा आखी खोली की देख, ओर सन्हेरीबो रे सारे वचन सुण, जिने जिऊँदे परमेशरो री बेज्जती करने खे लिखी की पेजी राखे। <verse eid="ISA 37:17" /><verse number="18" style="v" sid="ISA 37:18" />ओ यहोवा, अश्शूरो रे राजेया सच्चो खे ई कई देश नाश करी ते, तिना री जमीन उजाड़ पाईती। <verse eid="ISA 37:18" /><verse number="19" style="v" sid="ISA 37:19" />अश्शूरो रे राजे तिना देशा रे देवते आगी दे फूके, कऊँकि सेयो परमेशर नि थे, सेयो बस माणूंआ री कारीगरी, लक्कड़ ओर पात्थर ई थे, इजी बजा ते सेयो तिना खे नाश करी सके।<note caller="+" style="f"><char style="fr" closed="false">37:19 </char><char style="ft" closed="false">पज. 115:4-8, गला. 4:8 </char></note> <verse eid="ISA 37:19" /><verse number="20" style="v" sid="ISA 37:20" />एबे ओ म्हारे परमेशर यहोवा, तूँ आसा खे तेसरे आथो ते बचा, जेते कि तरतिया रे राज-राज रे लोक जाणी लो कि बस तूँ ई यहोवा ए।”<verse eid="ISA 37:20" /></para>
  <para style="s">राजा हिजकिय्याह खे परमेशरो रा जबाव</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21" />तेबे आमोसो रे पाऊ यशायाहे हिजकिय्याह गे ये सन्देसा पेजेया, इस्राएलो रा परमेशर यहोवा ये बोलोआ, तैं जो अश्शूरो रे राजा सन्हेरीबो रे बारे दे मांते प्रार्थना करी राखी, <verse eid="ISA 37:21" /><verse number="22" style="v" sid="ISA 37:22" />तेसरे बारे दे यहोवे ये बोली राखेया, “सिय्योनो री कुँवारी बेटी<note caller="+" style="f"><char style="fr" closed="false">37:22 </char><char style="fq" closed="false">सिय्योनो री कुँवारी बेटी </char><char style="ft" closed="false">यरूशलेमो रे जवान लोक </char></note> ताखे तुच्छ जाणोई ओर तेरा मजाक करोई, यरूशलेम शईरो री बेटी तेरा मजाक उड़ाओई। <verse eid="ISA 37:22" /><verse number="23" style="v" sid="ISA 37:23" />तैं जेसरी बेज्जती ओर निन्दा करी राखी, ओर जेसरे खलाफ कमण्ड करी की बोलेया, से इस्राएलो रा पवित्र परमेशर ए। <verse eid="ISA 37:23" /><verse number="24" style="v" sid="ISA 37:24" />आपणे नौकरा रे जरीये तैं जो परमेशरो री बेज्जती करी की बोली राखेया कि आऊँ बऊत सारे रथ लई की पाह्ड़ो री चूँडिया पाँदे, बल्कि लबानोनो रे बणो तक चढ़ी की आई गा रा, मां तेथो रे ऊच्चे-ऊच्चे देवदार ओर अच्छे-अच्छे सनौबरो रे डाल़ बाडी देणे ओर मां तेथो री ऊच्ची जगा रे ओर तेसरे बणो दे फल़ देणे वाल़े बगिचेया दे जाणा।”<verse eid="ISA 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 37:25" />मैं खाता खणी की पाणी पिया ओर मिस्रो री खाड्डा दे पैर राखदे ई सेयो सुकाईते। <verse eid="ISA 37:25" /><verse number="26" style="v" sid="ISA 37:26" />क्या तैं नि सुणी राखेया कि पईले तेई मैं ये ठाणी राखेया था ओर एतेरी त्यारी कित्ती थी? इजी री खातर एबे मैं ये पूरा बी कित्तेया ताकि तूँ गढ़वाल़े शईरा खे खण्डहर ई खण्डहर करी दे। <verse eid="ISA 37:26" /><verse number="27" style="v" sid="ISA 37:27" />इजी बजा ते तेती रणे वाल़ेया दे शक्ति कम ऊईगी ओर सेयो बेज्जत ओर शर्मिंदा ऊए, सेयो मैदानो रे नीके-नीके डाल़, ओर अरा काआ, ओर छतो पाँदला काआ ओर एड़े नज्जो जेड़े ऊईगे जो बढ़ने ते पईले ई सूकी जाओआ। <verse eid="ISA 37:27" /><verse number="28" style="v" sid="ISA 37:28" />आऊँ तो तेरा बैठणा, जाणा ओर वापस आऊणा जाणूंआ ओर ये बी कि तूँ मां पाँदे आपणा रोष करेया। <verse eid="ISA 37:28" /><verse number="29" style="v" sid="ISA 37:29" />इजी बजा ते कि तूँ मां पाँदे आपणा रोष करेया ओर तेरे कमण्डो रिया गल्ला मैं सुणी राखिया, मां तेरे नाको दे नकेल पायी की ओर तेरे मुंए दे आपणी लगाम लगाई की जेते बाटा रिये तूँ आई रा, तेसा ई बाटा रिये तूँ वापस करी देणा। <verse eid="ISA 37:29" /><verse number="30" style="v" sid="ISA 37:30" />तेबे यशायाहे रा हिजकियाह खे बोलेया, “ताखे ये नशाण ऊणा कि एते साले तो तां से खाणा, जो आपणे आप जमणा ओर दूजे साले से जो तिजी ते पैदा ऊणा ओर तीजे साले बेजा बायी की से बाडणा ओर अंगूरा रे बगीचे लगाणे ओर तिना रा फल़ खाई सकणा। <verse eid="ISA 37:30" /><verse number="31" style="v" sid="ISA 37:31" />ओर यहूदा रे कराने रे कुछ लोक बची जाणे। सेओ ई लोक बढ़दे ऊए एक बऊत बड़ी जातिया रा रूप लई लणा। सेओ लोक तिना डाल़ा जेड़े ऊणे जिना रिया जड़ा तरतिया दे बऊत डूगिया जाओईया ओर सेओ बऊत तगड़े ऊई जाओए ओर बऊत ज्यादा फल देओए। <verse eid="ISA 37:31" /><verse number="32" style="v" sid="ISA 37:32" />कऊँकि यरूशलेम शईरो रे बचे रे ओर सिय्योन पाह्ड़ो ते नठे रे लोक निकल़ने।” सेना रे यहोवे आपणे रोषो रिया बजा ते ये काम करना। <verse eid="ISA 37:32" /><verse number="33" style="v" sid="ISA 37:33" />इजी री खातर यहोवा अश्शूरो रे राजे रे बारे दे ईंयाँ बोलोआ, “से एस शईरो दे नि आई सकणा, बल्कि से एस शईरो पाँदे एक बी तीर नि बायी सकणा ओर ना से ढाल लई की एस सामणे आऊणे या एसरे खलाफ दम बानी सकणा। <verse eid="ISA 37:33" /><verse number="34" style="v" sid="ISA 37:34" />जेते बाटा रिये से आई रा, तेसा ई बाटा रिये से वापस बी ऊई जाणा ओर एस शईरो दे नि आई सकणा, यहोवे री येई बाणी ए।” <verse eid="ISA 37:34" /><verse number="35" style="v" sid="ISA 37:35" />कऊँकि मां आपणे शईरो रिया तँईं ओर आपणे दास दाऊदो रिया तँईं, एस शईरो री रक्षा करी की ये बचाणा।<verse eid="ISA 37:35" /></para>
  <para style="s">सन्हेरीबो री आर ओर मौत</para>
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36" />तेसा ई राती यहोवे रे दूते निकल़ी की अश्शूरिया रे डेरे दे 185,000 सिपाई काये ओर जेबे लोक दूजे दिने प्यागा उठे तो तिने देखेया कि तिना रे चारो तरफा खे मरे रे सैनिका रिया लाशा ई लाशा पड़ी रिया। <verse eid="ISA 37:36" /><verse number="37" style="v" sid="ISA 37:37" />तेबे अश्शूरो रा राजा सन्हेरीब चली गा ओर वापस ऊई की नीनवे शईरो दे रणे लगेया। <verse eid="ISA 37:37" /><verse number="38" style="v" sid="ISA 37:38" />एक दिन से आपणे देवता निस्रोको रे मन्दरो दे माथा टेकणे लगी रा था कि तदुओ खे तेसरे पाऊ अद्रम्मेलेक ओर शरेसेरे से तलवारी साथे काया ओर अरारात देशो खे नठीगे। तेबे सन्हेरीबो रा एक ओर पाऊ एसर्हद्दोन तेसरी जगा पाँदे राज करने लगेया।<verse eid="ISA 37:38" /></para>
  <chapter eid="ISA 37" />
  <chapter number="38" style="c" sid="ISA 38" />
  <para style="s">राजा हिजकिय्याह री बमारी ओर ठीक ऊणा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1" />एक दिन हिजकिय्याह एड़ा बमार ऊआ कि से मरने वाल़ा था। तेबे आमोसो रे पाऊ यशायाह नबीए तेसगे जाई की बोलेया, “यहोवा ईंयाँ बोलोआ कि आपणे कअरो दे सब कुछ ठीक करी दे, कऊँकि तूँ नि बचणा, बल्कि मरी ई जाणा।” <verse eid="ISA 38:1" /><verse number="2" style="v" sid="ISA 38:2" />तेबे राजा हिजकिय्याहे कांदा रिया तरफा खे मूँ फेरी की यहोवे ते प्रार्थना करी की बोलेया, <verse eid="ISA 38:2" /><verse number="3" style="v" sid="ISA 38:3" />“ओ यहोवा, आऊँ प्रार्थना करूँआ कि आऊँ सच्चाई ओर खरे मनो साथे आपू खे तां सामणे जाणी की चलदा आई रा ओर जो तेरी नजरा दे ठीक था, सेई करदा आई रा।” ओर हिजकिय्याह ईंकी-ईंकी की रोणे लगेया। <verse eid="ISA 38:3" /><verse number="4" style="v" sid="ISA 38:4" />तेबे यहोवे रा ये वचन यशायाह गे पऊँचेया, <verse eid="ISA 38:4" /><verse number="5" style="v" sid="ISA 38:5" />“जाई की हिजकिय्याह रे नेड़े जा ओर तेसखे बोल कि तेरे मूलमर्द दाऊदो रा परमेशर यहोवा ईंयाँ बोलोआ कि मैं तेरी प्रार्थना सुणी ओर तेरे आसू देखे, सुण, मां तेरी उम्र पंद्रा साल ओर बढ़ाई देणी। <verse eid="ISA 38:5" /><verse number="6" style="v" sid="ISA 38:6" />अश्शूरो रे राजे रे आथो ते आऊँ तेरी ओर एस यरूशलेम शईरो री रक्षा करी की बचाऊँगा।” <verse eid="ISA 38:6" /><verse number="7" style="v" sid="ISA 38:7" />यहोवा जो बोली राखेया से तेस पूरा करना, <verse eid="ISA 38:7" /><verse number="8" style="v" sid="ISA 38:8" />ओर यहोवे रिया तरफा ते एसा गल्ला रा ये नशाण ऊणा कि तूपा री छांए जो राजा आहाजो रे जरीये बणाई दी पैड़िया पाँदे, यहोवे छांए दस कदम पीछे लई जाणी। तेबे से छांए जो दश कदम पीछे चली गी थी वापस ऊई गी।<verse eid="ISA 38:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9" />यहूदा रे राजा हिजकिय्याह रा से लेख जो तिने लिखेया, जेबे से बमार ऊई की ठीक ऊईगा था से ये आराधना रा गीत था: <verse eid="ISA 38:9" /><verse number="10" style="v" sid="ISA 38:10" />मैं आपणे मनो दे बोलेया, “आपणी उम्रा रे बीचे ई मां अधलोको रे बड़े द्वारा दे जाणा; कऊँकि मेरी बाकी उम्र कम करी ती री।”<note caller="+" style="f"><char style="fr" closed="false">38:10 </char><char style="ft" closed="false">मत्ती 16:18 </char></note> <verse eid="ISA 38:10" /><verse number="11" style="v" sid="ISA 38:11" />मैं बोलेया कि मां यहोवा जिऊँदेया री जमीना दे फेर नि देखी सकणा, एसा दुनिया रे माणूं मां फेर नि देखी सकणे। <verse eid="ISA 38:11" /><verse number="12" style="v" sid="ISA 38:12" />मेरा कअर गवाल़े रे तम्बूए जेड़ा चकी ता रा, मैं जुलाहे जेड़ी आपणी जिन्दगी लपेटी ती री, तेस आऊँ ताँता ते बाडी की लग करी देणा, तां एक ई दिनो दे मेरा अन्त करी देणा। <verse eid="ISA 38:12" /><verse number="13" style="v" sid="ISA 38:13" />मैं प्यागा तक सोच बचार कित्तेया; परमेशर शेरो जेड़ा मेरे सारे आड्ड तोड़ोआ; तां एक ई दिनो दे मेरा अन्त करी देणा। <verse eid="ISA 38:13" /><verse number="14" style="v" sid="ISA 38:14" />आऊँ ककराखा जेड़ा ओर सारसो जेड़ा च्यूं-च्यूं करदा ओर कबूतरो जेड़ा रोंदा रएया। मेरी आखी ऊबे देखदिया-देखदिया थकी गी रिया। ओ यहोवा, मां पाँदे अन्देर ऊणे लगी रा, तूँ मेरा सआरा ओ! <verse eid="ISA 38:14" /><verse number="15" style="v" sid="ISA 38:15" />आऊँ क्या बोलूँ? यहोवे ई माखे बोलेया ओर पूरा बी कित्तेया। मां पूरी जिन्दगी दु:खो साथे आऊल़े-आऊल़े चलदे रणा। <verse eid="ISA 38:15" /><verse number="16" style="v" sid="ISA 38:16" />ओ प्रभु, इना ई गल्ला साथे लोक जिऊँदे ए ओर इना सबी साथे मेरी आत्मा खे जिन्दगी मिलोई। तूँ माखे ठीक कर ओर जिऊँदा राख! <verse eid="ISA 38:16" /><verse number="17" style="v" sid="ISA 38:17" />देख, शान्तिया खेई माखे बऊत दु:ख ऊआ; पर तैं प्यार करी की आऊँ नाशो रे गड्डे ते निकयाल़ी राखेया, कऊँकि तैं मेरे सारे पाप आपणी पीठी पीछे सेटी ते रे। <verse eid="ISA 38:17" /><verse number="18" style="v" sid="ISA 38:18" />कऊँकि अधलोको ते आऊँ तेरा तन्यवाद नि करी सकदा, ना मरने ते बाद आऊँ तेरी स्तुति करी सकदा; जो कब्रा दे पड़ी गे रे सेयो तेरी सच्चाईया री उम्मीद नि राखी सकदे। <verse eid="ISA 38:18" /><verse number="19" style="v" sid="ISA 38:19" />सेओ लोक जो जिऊँदे, आ जिऊँदे ई तेरा तन्यवाद करोए, जेड़ा आऊँ आज करने लगी रा; बाओ तेरी सच्चाईया रा सन्देश आपणे पाऊआ खे देयोआ। <verse eid="ISA 38:19" /><verse number="20" style="v" sid="ISA 38:20" />यहोवे मेरा उद्धार करना, इजी बजा ते आसा पूरी जिन्दगी यहोवे रे मन्दरो दे तार वाल़े बाजे साथे आपणे बणाए रे गाणे गांदे रणा। <verse eid="ISA 38:20" /><verse number="21" style="v" sid="ISA 38:21" />यशायाहे राजे रे कर्मचारिया ते बोलेया था, “हिजकिय्याह रे फोड़े पाँदे दाऊगल़े री एकी टिक्की रा लेप लगाणा, तेबे से बचणा।” <verse eid="ISA 38:21" /><verse number="22" style="v" sid="ISA 38:22" />तेबे हिजकिय्याहे यशायाह ते पूछेया, “इजी रा क्या नशाण ऊणा कि आऊँ यहोवे रे मन्दरो दे फेर जाई सकणा?”<verse eid="ISA 38:22" /></para>
  <chapter eid="ISA 38" />
  <chapter number="39" style="c" sid="ISA 39" />
  <para style="s">राजा हिजकिय्याह री मूर्खता</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1" />तिना दिना दे जेबे हिजकिय्याह ठीक ऊईगा तेस बखते बलदानो रे पाऊए मरोदक बलदाने, जो बाबेलो रा राजा था, तिने हिजकिय्याह रे बमार ऊणे रे बारे दे ओर फेर ठीक ऊणे रे बारे दे सुणी की तेसगे मुबारक देणे खे चिट्ठी ओर पेंट दूता गे पेजी। <verse eid="ISA 39:1" /><verse number="2" style="v" sid="ISA 39:2" />इना ते हिजकिय्याह राजे खुश ऊई की आपणे कीमती पदार्थो रा पण्डार ओर चाँदी, सूईना, खुशबूदार द्रव्य, खरा तेल ओर आपणे कीमती पण्डारो दे जो-जो चीजा थिया, सेयो सब तिना खे दखाईया। हिजकिय्याह रे मईलो दे ओर पूरे राज दे एड़ी कोई चीज नि रयी जो तिने तिना खे नि दखाई। <verse eid="ISA 39:2" /><verse number="3" style="v" sid="ISA 39:3" />तेबे यशायाह नबीए हिजकिय्याह राजे गे जाई की पूछेया, “सेयो दूत क्या बोली गे ओर सेयो तांगे केथा ते आई रे थे?” राजा हिजकिय्याहे बोलेया, “सेयो तो दूर देशो ते, मतलब बाबेलो ते आई रे थे।” <verse eid="ISA 39:3" /><verse number="4" style="v" sid="ISA 39:4" />तेबे यशायाहे तेसते पूछेया, “तिने तेरे मईलो दे क्या-क्या देखेया?” हिजकिय्याहे बोलेया, “जो कुछ मेरे मईलो दे ए, से सब तिने देखेया; मेरे पण्डारो दे एड़ी कोई चीज नि ए, जो मैं तिना खे नि दखाई।” <verse eid="ISA 39:4" /><verse number="5" style="v" sid="ISA 39:5" />तेबे यशायाह नबीए राजा हिजकिय्याह खे बोलेया, “सेना रे यहोवे रा ये वचन सुणी लो: <verse eid="ISA 39:5" /><verse number="6" style="v" sid="ISA 39:6" />एड़े दिन आऊणे वाल़े ए, जिना दे जो कुछ तेरे मईलो दे ए ओर जो कुछ आजो तक तेरे बुजुर्गा रा राखेया रा तेरे पण्डारो दे ए, से सारा बाबेलो खे उठी जाणा, यहोवा ईंयाँ बोलोआ कि कोई चीज नि बचणी। <verse eid="ISA 39:6" /><verse number="7" style="v" sid="ISA 39:7" />जो पाऊ तेरे कुलो दे पैदा ऊणे, तिना बीचा ते बी कई तिना गुलाम बणाई की लई जाणे ओर सेयो खुसरे बणाई की बाबेलो रे राजे रे मईलो दे राजे री सेवा करने खे रणे।” <verse eid="ISA 39:7" /><verse number="8" style="v" sid="ISA 39:8" />राजा हिजकिय्याहे यशायाह खे बोलेया, “यहोवे रा जो वचन तैं बोली राखेया से खरा ई ए।” तेबे तिने बोलेया, “मेरे जिऊँदे जिऊए तो माखे ओर मेरे लोका खे शान्ति ओर रक्षा बणी दी रणी।”<verse eid="ISA 39:8" /></para>
  <chapter eid="ISA 39" />
  <chapter number="40" style="c" sid="ISA 40" />
  <para style="s">परमेशरो रे लोका खे शान्ति</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 40:1" />आगे यशायाह भविष्यबाणी करोआ, आसा रा परमेशर ईंयाँ बोलोआ, मेरी प्रजा खे शान्ति देयो, शान्ति!<note caller="+" style="f"><char style="fr" closed="false">40:1 </char><char style="ft" closed="false">पज. 85:8, 2 कुरि. 1:4 </char></note> <verse eid="ISA 40:1" /><verse number="2" style="v" sid="ISA 40:2" />यरूशलेम शईरो रे लोका साथे शान्तिया री गल्ला बोलो ओर तेसखे आका पाई की बोलो कि तेरी कठण सेवा पूरी ऊई री, तेरे पापो री सजा मानी ती री, यहोवे रे आथो साथे तूँ दुगणी सजा पाई मुकी रा।<note caller="+" style="f"><char style="fr" closed="false">40:2 </char><char style="ft" closed="false">प्रका. 1:5 </char></note> <verse eid="ISA 40:2" /><verse number="3" style="v" sid="ISA 40:3" />केसी री आक सुणने लगी री, “बणो दे यहोवे री बाट सुदारो, म्हारे परमेशरो खे अराबा दे एक राजे री बाट चौरस करो।<note caller="+" style="f"><char style="fr" closed="false">40:3 </char><char style="ft" closed="false">मत्ती 3:3, मर. 1:3, यूह. 1:23 </char></note> <verse eid="ISA 40:3" /><verse number="4" style="v" sid="ISA 40:4" />हर एक तराई परी देयो ओर हर एक पाह्ड़ ओर पाह्ड़ी तोड़ी देयो, जो टेडा ए से सीदा ओर जो ऊच्चा-निठा ए तीजी खे चौरस करो। <verse eid="ISA 40:4" /><verse number="5" style="v" sid="ISA 40:5" />तेबे यहोवे री महिमा प्रगट ऊणी ओर तेसखे सारे माणूं एक साथे दिशणे, कऊँकि यहोवे आपू ई एड़ा बोली राखेया।”<note caller="+" style="f"><char style="fr" closed="false">40:5 </char><char style="ft" closed="false">पज. 72:19, लूक. 3:6 </char></note> <verse eid="ISA 40:5" /><verse number="6" style="v" sid="ISA 40:6" />बोलणे वाल़े रा वचन सुणेया, “प्रचार कर!” मैं पूछेया, “आऊँ क्या प्रचार करुँ?” तेबे आवाजे ज्वाब दित्तेया ये प्रचार कर कि सारे माणूं रेगिस्तानो रे काओ जेड़े ए, तिना री सजावट मैदानो रे फूला जेड़ी ए। <verse eid="ISA 40:6" /><verse number="7" style="v" sid="ISA 40:7" />जेबे यहोवे रा आत्मा तिजी पाँदे चलोआ, तेबे काआ सूकी जाओआ ओर फूल मुरझाई जाओए, इदे कोई शक नि ए कि प्रजा काआ ए।<note caller="+" style="f"><char style="fr" closed="false">40:7 </char><char style="ft" closed="false">याकू. 1:10,11 </char></note> <verse eid="ISA 40:7" /><verse number="8" style="v" sid="ISA 40:8" />काआ तो सूकी जाओआ ओर फूल मुरझाई जाओए, पर म्हारे परमेशरो रा वचन सदा अटल़ रणा।<note caller="+" style="f"><char style="fr" closed="false">40:8 </char><char style="ft" closed="false">1 पत. 1:24,25 </char></note> <verse eid="ISA 40:8" /><verse number="9" style="v" sid="ISA 40:9" />किने माखे बोलेया सिय्योनो खे एक शुभ सन्देश बोल, ऊच्चे पाह्ड़ो पाँदे चढ़ी जाओ, ओ यरूशलेम शईरो खे शुभ सन्देश सुनाणे वाल़ेयो, बऊत जोरे की बोल, जोरे की बोल, डर नि, यहूदा शईरो रे लोका खे बोल कि आपणे परमेशरो खे देखो!<note caller="+" style="f"><char style="fr" closed="false">40:9 </char><char style="ft" closed="false">यशा. 52:7,8 </char></note> <verse eid="ISA 40:9" /><verse number="10" style="v" sid="ISA 40:10" />देखो, परमेशर यहोवा सामर्थ दखांदा ऊआ यरूशलेमो खे आऊणे लगी रा, तेस आपणी बाई रिया तागती ते राज करना; देखो, जो मजदूरी देणे री ए, से तेसगे ए ओर जो बदला देणे राए, से तेसरे आथो दे ए।<note caller="+" style="f"><char style="fr" closed="false">40:10 </char><char style="ft" closed="false">प्रका. 22:7-12 </char></note> <verse eid="ISA 40:10" /><verse number="11" style="v" sid="ISA 40:11" />परमेशरो गवाल़े जेड़ा आपणा चूण्ड चराणा, तेस पेडा रे बच्चे आपणी बांयी पाँदे लणे ओर दूद पल्याणे वाल़िया पेडा आऊल़े-आऊल़े निणियां।<note caller="+" style="f"><char style="fr" closed="false">40:11 </char><char style="ft" closed="false">यहे. 34:23, मीका 5:4 </char></note><verse eid="ISA 40:11" /></para>
  <para style="s">इस्राएलो रा महान परमेशर</para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 40:12" />किने माणूंए समुद्रो रा पाणी आपणे मुठुए दे परी की नापेया ओर सर्गो रा नाप किने फिथे साथे लया, किने माणूंए तरतिया री माट्टी आपणे कटोरे दे परी ओर पाह्ड़ ताकड़िया दे ओर पाह्ड़िया कांडे दे तोली राखिया? <verse eid="ISA 40:12" /><verse number="13" style="v" sid="ISA 40:13" />यहोवे रे दमाको खे किने आदमिए ये नि दसेया कि तेसखे क्या करना था यहोवे खे किने ये सला नि दित्ती की तेसखे जो तिने करी राखेया किंयाँ करना था?<note caller="+" style="f"><char style="fr" closed="false">40:13 </char><char style="ft" closed="false">1 कुरि. 2:16 </char></note> <verse eid="ISA 40:13" /><verse number="14" style="v" sid="ISA 40:14" />तिने केसते सला लई ओर तेसखे समजयाई की किने न्याय री बाट दसी ओर ज्ञान सिखाई की अक्ला री बाट दसी राखी?<note caller="+" style="f"><char style="fr" closed="false">40:14 </char><char style="ft" closed="false">रोम. 11:34,35 </char></note><verse eid="ISA 40:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 40:15" />देखो, संसारो रे सारे देश कड़े दे एक छोटे टीपे जेड़े या ताकड़िया पाँदली तूड़ा जेड़ी ठईरी, देखो, यहोवा द्वीपा खे तूड़ा जेड़ा चकोआ। <verse eid="ISA 40:15" /><verse number="16" style="v" sid="ISA 40:16" />लबानोनो रे सारे डाल़ परमेशरो खे पेंट चढ़ाणे रिया तँईं बाल़ने खे काफी नि ए। ओर लबानोनो रे जीव-जन्तु होमबलिया खे कम ऊणे। <verse eid="ISA 40:16" /><verse number="17" style="v" sid="ISA 40:17" />सारिया जातिया तेस सामणे कुछ नि ए, सेयो तेसरी नजरा दे बेकार ओर शून्य ते बी कम ठईरी रिया। <verse eid="ISA 40:17" /><verse number="18" style="v" sid="ISA 40:18" />तुसे परमेशरो खे केस जेड़ा बताई सकोए ओर तेसरी उपमा केस साथे देई सकोए? <verse eid="ISA 40:18" /><verse number="19" style="v" sid="ISA 40:19" />मूर्तिया खे तो कारीगर बणाओआ, सन्यार तिजी खे सूईने साथे मढ़ोआ ओर तिजी खे चाँदिए रे साँगल़ कअड़ी की बणाओआ। <verse eid="ISA 40:19" /><verse number="20" style="v" sid="ISA 40:20" />जो कोई कंगाल़ माणूं इतणा सूईना चाँदी पेंटा दे नि देई सकदा, तो से एड़ा डाल़ चूणी लओआ जो सड़ो नि, से एक निपुण कारीगर टोल़ी की मूर्ति बणवाओआ ओर तेसा मूर्तिया खे एड़ा खड़ा करोआ कि से ईल्ली नि सको।<note caller="+" style="f"><char style="fr" closed="false">40:20 </char><char style="ft" closed="false">प्रेरि. 17:29 </char></note> <verse eid="ISA 40:20" /><verse number="21" style="v" sid="ISA 40:21" />क्या तुसे नि जाणदे? क्या तुसे नि सुणेया? क्या तुसा गे शुरूओ ते ई नि बताया? क्या तुसे तरतिया री निऊँ पड़ने ते पईले ई नि सोचेया? <verse eid="ISA 40:21" /><verse number="22" style="v" sid="ISA 40:22" />ये परमेशर ए जो तरतिया रे केरे पाँदे सर्गो दे बैठी रा ओर तरतिया रे रणे वाल़े माणूं टिड्डिया जेड़े ए; जो सर्गो खे मलमलो जेड़ा फैलाओआ ओर एड़ा ताणी देयोआ, जेड़ा रणे खे तम्बू ताणोए। <verse eid="ISA 40:22" /><verse number="23" style="v" sid="ISA 40:23" />परमेशर बड़े-बड़े परदाना खे तुच्छ करी देयोआ ओर तरतिया रे अधिकारिया खे बेकार करी देयोआ। <verse eid="ISA 40:23" /><verse number="24" style="v" sid="ISA 40:24" />से परदान ओर अधिकारी एड़े ए, जेड़े सेयो डोरूआ दे पौधेया खे रूमोए, ओर तिना खे बाओए, जदुए खे से डंडल़ जमीना दे जड़ पकड़ने वाल़े ओए, तदुओ खे यहोवा तिना पाँदे अवा चलाओआ ओर सेयो सूकी जाओए ओर तूफान तिना खे पूओ जेड़ा उडाई की लई जाओआ।<verse eid="ISA 40:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 40:25" />इजी री खातर तुसे माखे केस जेड़ा बताओए कि आऊँ तेस जेड़ा ठईरूँ? तेस पवित्र परमेशरो रा येई वचन ए। <verse eid="ISA 40:25" /><verse number="26" style="v" sid="ISA 40:26" />आपणियां आखी ऊबे करो ओर सर्गो रिया तरफा खे देखो, यो सारे तारे किने बणाए? से इना तारेया खे गिणी-गिणी की निकयाल़ोआ ओर इना सबी खे नाओं लई-लई की बुलाओआ। से एड़ा सामर्थी ओर बऊत तागतबर ए कि तिना बीचा ते कोई बिना आए नि रंदा।<verse eid="ISA 40:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ISA 40:27" />ओ याकूब, तूँ कऊँ बोलेया, ओ इस्राएल तूँ कऊँ बोलेया, “मेरी बाट यहोवे ते लूकी रिये, मेरा परमेशर मेरे न्याय री कोई फिकर नि करदा?” <verse eid="ISA 40:27" /><verse number="28" style="v" sid="ISA 40:28" />क्या तुसे नि जाणदे? क्या तुसे नि सुणेया? यहोवा जो सदा रणे वाल़ा परमेशर ओर पूरी तरतिया खे बनाणे वाल़ा ए, से थकदा नि, ना ई कमजोर ऊँदा, तेसरी बुद्धिया रा कोई अन्त नि ए। <verse eid="ISA 40:28" /><verse number="29" style="v" sid="ISA 40:29" />से थके रेया खे तागत देयोआ ओर कमजोरा खे शक्ति देयोआ। <verse eid="ISA 40:29" /><verse number="30" style="v" sid="ISA 40:30" />जवान थकी जाओए ओर तिना खे राम करने री जरूरत पड़ी जाओई ओर जवान ठोकर खाई की रूड़ी जाओए, <verse eid="ISA 40:30" /><verse number="31" style="v" sid="ISA 40:31" />पर जो यहोवे खे मतादा रिया उम्मीदा ते न्याल़ोए, तिना खे नवीं तागत मिलदी रणी, सेयो उकाबो जेड़े उडदे रणे, सेयो दौड़ने ओर बेओश नि ऊणे ओर चलणे पर थकणे नि।<verse eid="ISA 40:31" /></para>
  <chapter eid="ISA 40" />
  <chapter number="41" style="c" sid="ISA 41" />
  <para style="s">इस्राएलो खे परमेशरो री तसल्ली</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 41:1" />यशायाहे इजी रे खलाफ भविष्यबाणी कित्ती परमेशर बोलोआ, ओ द्धीपो मा सामणे चुप रओ ओर मेरी सुणो, देशो-देशो रे लोक नवां जोर पाओए सेओ नेड़े आई की बोलो; आसे आपू-बीचे न्याय रिया तँईं एकी-दूजे रे नेड़े आईए। <verse eid="ISA 41:1" /><verse number="2" style="v" sid="ISA 41:2" />किने पूर्व दिशा ते कोई एक सकेल़ेया, जेसखे से तर्मो साथे आपणे पैरा गे बुलाओआ? से जातिया खे तेसरे वशो दे करी देयोआ ओर तेसखे राजेया पाँदे अधिकारी ठराओआ, से आपणी तलवारी साथे तिना खे तूड़ा जेड़ा ओर आपणे धनुषो साथे उडाए रे पूओ जेड़ा करी देयोआ। <verse eid="ISA 41:2" /><verse number="3" style="v" sid="ISA 41:3" />सीरिया रा राजा तिना खे नठाओआ ओर एड़ी बाटा दे जिदे से कदी नि चलेया था, बिना रोके-टोके आगे बढ़ोआ। <verse eid="ISA 41:3" /><verse number="4" style="v" sid="ISA 41:4" />किने ये काम करी राखेया ओर शुरूओ ते पीढ़िया खे बुलांदा आई रा? आऊँ यहोवा, आऊँ यहोवा अन्तो तक तेथी रणा।<note caller="+" style="f"><char style="fr" closed="false">41:4 </char><char style="ft" closed="false">प्रका. 1:8, प्रका. 22:13, प्रका. 16:5 </char></note> <verse eid="ISA 41:4" /><verse number="5" style="v" sid="ISA 41:5" />दूजे देशा रे लोके देखी राखेया कि मैं क्या करी राखेया सेओ डरी गे ओर डरो रे मारे कांबणे लगी रे इजी खे सेओ सब कट्ठे आए। <verse eid="ISA 41:5" /><verse number="6" style="v" sid="ISA 41:6" />मूर्तिपूजा करने वाल़े एकी दूजे खे शान्ति देओए ओर तिना बीचा ते एक आपणे पाईए खे बोलोआ, “याओ राख!” <verse eid="ISA 41:6" /><verse number="7" style="v" sid="ISA 41:7" />मिस्त्री सन्यारो खे ओर थौड़ूए साथे बराबर करने वाल़ा निहाईया पाँदे बाणे वाल़े खे ये बोली की याओ बणाओआ, “जोड़ तो ठीक ए” तेबे से परेगा ठोकी-ठोकी की तिजी खे एड़ा पक्का करोआ ताकि से पक्का रओ। <verse eid="ISA 41:7" /><verse number="8" style="v" sid="ISA 41:8" />पर ओ मेरे दास इस्राएल, ओ मेरे चूणे रे याकूब, ओ मेरे दोस्त अब्राहमो रे कुल;<note caller="+" style="f"><char style="fr" closed="false">41:8 </char><char style="ft" closed="false">याकू. 2:23, बिध. 14:2, पज. 105:6 </char></note> <verse eid="ISA 41:8" /><verse number="9" style="v" sid="ISA 41:9" />तूँ जो मैं तरतिया रे दूर-दूर देशो ते ल्याया ओर तरतिया रे कूणे ते बुलाई की ये बोलेया, “तूँ मेरा दास ए, मैं तूँ चूणी राखेया ओर छाडेया नि;”<note caller="+" style="f"><char style="fr" closed="false">41:9 </char><char style="ft" closed="false">पज. 107:2,3, पज. 94:14, मत्ती 2:18-22 </char></note> <verse eid="ISA 41:9" /><verse number="10" style="v" sid="ISA 41:10" />डर नि, कऊँकि आऊँ तां साथे ए, ओरे-पोरे नि देख, कऊँकि आऊँ तेरा परमेशर ए; मां तूँ मजबूत करना ओर तेरी मताद करनी, मां आपणे तर्मी दाँणे आथो साथे तूँ सम्बाल़ना।<note caller="+" style="f"><char style="fr" closed="false">41:10 </char><char style="ft" closed="false">यहो. 1:9, बिध. 31:6 </char></note> <verse eid="ISA 41:10" /><verse number="11" style="v" sid="ISA 41:11" />देख, जो तां पाँदे रोष करोए, सेयो सारे शर्मिंदा ऊणे; जो तां साथे लड़ाई करोए, तिना रे मूँ काल़े ऊणे ओर सेयो बर्बाद ऊई की राची जाणे। <verse eid="ISA 41:11" /><verse number="12" style="v" sid="ISA 41:12" />जो तां साथे लड़ोए, सेयो ताखे टोल़दे ऊए पनि मिलणे, जो तां साथे युद्ध करोए, सेयो बर्बाद ऊई की नाश ऊई जाणे। <verse eid="ISA 41:12" /><verse number="13" style="v" sid="ISA 41:13" />कऊँकि आऊँ तेरा परमेशर यहोवा ए, मां तेरा दाँणा आथ पकड़ी की बोलणा, “डर नि, मां तेरी मताद करनी।” <verse eid="ISA 41:13" /><verse number="14" style="v" sid="ISA 41:14" />यहोवे बोलेया, “ओ कीड़े जेड़े याकूब, ओ इस्राएलो रे माणूंओ, डरो नि! यहोवे री ये बाणी ए, मां तेरी मताद करनी; इस्राएलो रा पवित्र परमेशर तेरा छुड़ाणे वाल़ा ए। <verse eid="ISA 41:14" /><verse number="15" style="v" sid="ISA 41:15" />देख, मैं तूँ छुरी वाल़े गाह्णे रा एक नवां ओर शुद्ध यन्त्र ठराई राखेया; तां पाह्ड़ गाह्यी-गाह्यी की, तूड़ बणाई देणे ओर तां पाह्ड़िया पूओ जेड़िया करी देणियां।” <verse eid="ISA 41:15" /><verse number="16" style="v" sid="ISA 41:16" />तां पाह्ड़ ओर पाह्ड़िया अवा दे फड़ाकणियां ओर सेयो अवा उडाई की लई जाणिया ओर सेयो तूफानो तित्तर-बित्तर करी देणियां। पर तूँ यहोवे रिया बजा ते मगन ऊणा ओर तां इस्राएलो रे पवित्र परमेशरो री तारीफ करनी।<verse eid="ISA 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 41:17" />जेबे गरीब ओर कंगाल़ लोका खे पाणी टोल़ी की पनि मिलणा ओर तिना रा गल़ा त्याय रे मारे सूकी जाणा, तेबे मां यहोवे तिना री दुहाई सुणनी, आऊँ इस्राएलो रा परमेशर ए ओर मां सेयो छाडणे नि। <verse eid="ISA 41:17" /><verse number="18" style="v" sid="ISA 41:18" />मां फूखी री पाह्ड़िया ते नदिया ओर मैदाना बीचे सूबल़ा निकयाल़निया; मां जंगल़ तलाब ओर मरूस्थल देशो दे सूबल़ा ई सूबल़ा करी देणियां। <verse eid="ISA 41:18" /><verse number="19" style="v" sid="ISA 41:19" />मां रेगिस्तानो रे बणो रे देवदार, बबूल, मईंदी ओर जैतून जमाणे; मां अराबा रे सनौबर, चिनार ओर चीला रे डाल़ कट्ठे लगाणे; <verse eid="ISA 41:19" /><verse number="20" style="v" sid="ISA 41:20" />जिना खे देखी की लोका खे पता लगी जाओ ओर सोची की पूरी तरअ ते समजी लो कि ये यहोवे रे आपणे आथो साथे कित्तेया राए, ओर इस्राएलो रे पवित्र परमेशरो रा बणाया राए।<verse eid="ISA 41:20" /></para>
  <para style="s">यहोवे री चूठे देवतेया खे चतौणी</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 41:21" />यहोवा मूर्तिया खे बोलोआ, “आपणा मुकद्दमा लड़ो,” याकूबो रा राजा बोलोआ, “आपणे सबूत देयो।” <verse eid="ISA 41:21" /><verse number="22" style="v" sid="ISA 41:22" />सेयो तिना खे देई की आसा खे भविष्यबाणी करो कि आऊणे वाल़े बखतो दे क्या ऊणा? बीते रे बखतो रिया कटना बताओ कि शुरूओ दे क्या-क्या ऊआ, जेते कि आसे तिना खे सोची की जाणी सकिये कि आऊणे वाल़े बखतो दे तिना रा क्या फल़ ऊणा; या ऊणे वाल़ी कटना रे बारे दे आसा गे सुणाई देयो। <verse eid="ISA 41:22" /><verse number="23" style="v" sid="ISA 41:23" />आऊणे वाल़े बखतो दे जो कुछ बितणा से बताओ, तेबे आसा मानणा कि तूँ परमेशर ए, खरा या बुरा, कुछ तो करो कि आसे देखी की हैरान ऊई जाऊँ। <verse eid="ISA 41:23" /><verse number="24" style="v" sid="ISA 41:24" />देख, तुसे मूर्तिया कुछ नि ए, तुसा दे कुछ नि ऊँदा, जो कोई तुसा खे चाओआ से घृणित ए। <verse eid="ISA 41:24" /><verse number="25" style="v" sid="ISA 41:25" />मैं एक उत्तर दिशा ते अमला करने खे सकेल़ेया, फारसो रा राजा आई बी गया, से पूर्ब दिशा ते ए ओर मेरा नाओं लओआ; जिंयाँ कुम्हार सीनी माट्टिया खे मांडोआ, तेड़ा ई तेस परदान चीकड़ो दे मांडणे। <verse eid="ISA 41:25" /><verse number="26" style="v" sid="ISA 41:26" />ये गल्ल पईले ते ई किने बताई राखी थी, जेते कि आसे ये जाणदे? क्या ये पईले तेई किने बताया जेते कि आसे बोलूँ कि से सच्चा ए? कोई बी बताणे वाल़ा नि ए, कोई बी सुनाणे वाल़ा नि ए, तुसा री गल्ला खे सुनाणे वाल़ा कोई नि ए। <verse eid="ISA 41:26" /><verse number="27" style="v" sid="ISA 41:27" />आऊँ यहोवा, सिय्योनो खे समाचार देणे वाल़ा पईला माणूं था, “देख, इना खे देख ओर मैं यरूशलेम शईरो खे एक शुभ सन्देश देणे वाल़ा पेजेया। <verse eid="ISA 41:27" /><verse number="28" style="v" sid="ISA 41:28" />मैं देवतेया बीचे बी कोई नि देखेया ओर तिना बीचे कोई मन्त्री नि ए जो मेरे पूछणे ते कोई ज्वाब देई सको। <verse eid="ISA 41:28" /><verse number="29" style="v" sid="ISA 41:29" />सुणो, तिना सबी मूर्तिया रे काम अनर्थ करने वाल़े ए, तिना रे काम तुच्छ ए ओर तिना री कअड़ी रिया मूर्तिया अवा ओर चूठिया ए।”<verse eid="ISA 41:29" /></para>
  <chapter eid="ISA 41" />
  <chapter number="42" style="c" sid="ISA 42" />
  <para style="s">प्रभुए रा दास</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 42:1" />यहोवे बोलेया, “मेरे दासो खे देखो जेसखे आऊँ सम्बाल़ूँआ, मेरे चूणे दे खे, जेसते मेरा मन खुश ओआ; मैं तेस पाँदे आपणा आत्मा राखी राखेया, तेस जातिया-जातिया रे लोका खे न्याय दलाणा।<note caller="+" style="f"><char style="fr" closed="false">42:1 </char><char style="ft" closed="false">मत्ती 3:17, लूक. 9:35, 2 पत. 1:17 </char></note> <verse eid="ISA 42:1" /><verse number="2" style="v" sid="ISA 42:2" />ना यहोवे रा दास चींगणा ओर ना तेस जोरे की बोलणा, ना ई सड़का दे आपणा बोल सुनाणा। <verse eid="ISA 42:2" /><verse number="3" style="v" sid="ISA 42:3" />यहोवे रे दासो केसे रे नंगल़ नि तोड़ने ओर ना बल़ी री बत्ती बजयाणी, तेस सच्चाईया साथे न्याय करना। <verse eid="ISA 42:3" /><verse number="4" style="v" sid="ISA 42:4" />से कमजोर ओर केसेया रा तदुओ तक नि ऊणा, जदुओ तक से न्याय खे दुनिया दे नि लई आओ। दूर देशो रे लोका तेसरी शिक्षा पाँदे परोसा करना।”<verse eid="ISA 42:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 42:5" />परमेशर जो सर्गो खे बनाणे वाल़ा ओर तणने वाल़ा ए, जो फसला समेत तरतिया खे फैलाणे वाल़ा ओर तेते पाँदले लोका खे साआ ओर तेते पाँदे चलणे वाल़ेया खे आत्मा देणे वाल़ा यहोवा ए, से आपणे दासो खे ईंयाँ बोलोआ, <verse eid="ISA 42:5" /><verse number="6" style="v" sid="ISA 42:6" />“मैं यहोवे तूँ तर्मो साथे बुलाई राखेया, मां तेरा आथ पकड़ी की तेरी रक्षा करनी; मां तूँ प्रजा खे वाचा ओर जातिया खे प्रयासा ठईराणा;<note caller="+" style="f"><char style="fr" closed="false">42:6 </char><char style="ft" closed="false">लूक. 2:32, प्रेरि. 13:47 </char></note> <verse eid="ISA 42:6" /><verse number="7" style="v" sid="ISA 42:7" />ताकि तूँ अन्देया रिया आखी खोले, कैदिया खे जेला ते निकयाल़े ओर जो न्हेरे दे बैठी रे तिना खे जेला ते निकयाल़ो।<note caller="+" style="f"><char style="fr" closed="false">42:7 </char><char style="ft" closed="false">यशा. 61:1, प्रेरि. 26:18 </char></note> <verse eid="ISA 42:7" /><verse number="8" style="v" sid="ISA 42:8" />आऊँ यहोवा ए, मेरा नाओं यहोवा ई ए, मां आपणी महिमा दूजे खे नि देणी ओर जो महिमा मां जोगी ए, से कअड़ी री मूर्तिया खे नि देणी। <verse eid="ISA 42:8" /><verse number="9" style="v" sid="ISA 42:9" />देखो, पईलकिया गल्ला तो ऊई चुकिया, एबे आऊँ नईया गल्ला बताऊँआ; तिना रे ऊणे ते पईले आऊँ तुसा खे सुणाऊँआ।”<verse eid="ISA 42:9" /></para>
  <para style="s">परमेशरो री स्तुतिया रा एक गीत</para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 42:10" />ओ समुद्रो दे चलणे वाल़ेयो, ओ समुद्रो दे सब रणे वाल़ेयो, ओ द्वीपो, तुसे सब आपणे रणेया वाल़ेया समेत यहोवे खे एक नवां गीत गाओ ओर तरतिया रे कूणे ते तेसरी स्तुति करो।<note caller="+" style="f"><char style="fr" closed="false">42:10 </char><char style="ft" closed="false">पज. 96:1-3, पज. 97:1 </char></note> <verse eid="ISA 42:10" /><verse number="11" style="v" sid="ISA 42:11" />उजाड़ जगा ओर तेथो रिया बस्तिया ओर केदारो रे लोक जो अराबो रे रेगिस्तानो दे रओ थे यहोवे री जयजयकार करो, सेला शईरो दे रणे वाल़े लोको जयजयकार करो, सेयो पाह्ड़ो री चूँडिया पाँदा ते जोरे की गाओ। <verse eid="ISA 42:11" /><verse number="12" style="v" sid="ISA 42:12" />सेयो यहोवे री महिमा बताओ ओर द्वीपो दे तेसरे बारे दे बताओ। <verse eid="ISA 42:12" /><verse number="13" style="v" sid="ISA 42:13" />यहोवा वीर सिपाईया जेड़ा बारे निकल़ना ओर सिपाईया जेड़ा आपणा रोष पड़काणा, तेस जोरे की ललकारना ओर आपणे दुश्मणा ते जितणा। <verse eid="ISA 42:13" /><verse number="14" style="v" sid="ISA 42:14" />यहोवे बोलेया, “आऊँ बऊत बखतो ते तो चुप रया ओर मौन रयी की आपू खे रोकदा रया, पर एबे मां बच्चे खे जन्म देणे वाल़ी जवाणसा जेड़ा चींगणा ओर हाँफी-हाँफी की साआ परना। <verse eid="ISA 42:14" /><verse number="15" style="v" sid="ISA 42:15" />मां पाह्ड़ ओर पाह्ड़िया सुकाई देणियां ओर तिना री सारी अरयाली सुकाई देणी; मां नदिया द्वीप करी देणे ओर तलाब सुकाई देणे।” <verse eid="ISA 42:15" /><verse number="16" style="v" sid="ISA 42:16" />फेर मां अन्दे लोक एकी बाटा रिये लई जाणे, जेतेखे सेयो नि जाणदे ओर सेयो एड़ी बाटा दे चलाणे, जेतेखे सेयो नि जाणदे। तिना ते आगे मा राती दे प्रयासा करना ओर टेडिया बाटा सिदिया करनिया। मा एड़े-एड़े काम करने ओर सेओ नि छाडणे।<note caller="+" style="f"><char style="fr" closed="false">42:16 </char><char style="ft" closed="false">लूक. 3:5, यशा. 29:18 </char></note> <verse eid="ISA 42:16" /><verse number="17" style="v" sid="ISA 42:17" />जो लोक कअड़ी री मूर्तिया पाँदे परोसा राखोए ओर तिना खे बोलोए, “तुसे म्हारे ईश्वर ए” तिना खे पीछे आटणा पड़ना ओर बऊत शर्मिंदा ऊणा पड़ना।<verse eid="ISA 42:17" /></para>
  <para style="s">इस्राएले परमेशरो री नि सुणी</para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 42:18" />यहोवा बोलोआ, “ओ टऊणेयो, सुणो; ओ अन्देयो, आखी खोलो ताकि तुसे देखी सको!<note caller="+" style="f"><char style="fr" closed="false">42:18 </char><char style="ft" closed="false">मत्ती 11:5 </char></note> <verse eid="ISA 42:18" /><verse number="19" style="v" sid="ISA 42:19" />मेरे दासो ते अलावा ओर कुण अन्दा ए? मेरे पेजे रे दूतो जेड़ा कुण टऊणा ए? मेरे दोस्तो जेड़ा कुण अन्दा या यहोवे रे दासो जेड़ा कुण अन्दा ए? <verse eid="ISA 42:19" /><verse number="20" style="v" sid="ISA 42:20" />ओ इस्राएल, तूँ बऊत सारी गल्ला पाँदे नजर लगाएया, पर तिना खे देखदा नि; कान तो खुले ए, पर सुणदा नि। <verse eid="ISA 42:20" /><verse number="21" style="v" sid="ISA 42:21" />यहोवे खे आपणे तर्मो रे मुताबिक ये अच्छा लगेया कि बिधानो री तारीफ जादा करो।<note caller="+" style="f"><char style="fr" closed="false">42:21 </char><char style="ft" closed="false">मत्ती 5:17,18, रोम. 7:12; 10:4 </char></note> <verse eid="ISA 42:21" /><verse number="22" style="v" sid="ISA 42:22" />पर यो इस्राएलो रे लोक लूटी गे रे ओर गड्डेया दे फसी रे ओर जेला दे बन्द करी राखे, यो पकड़े ओर इना खे कोई नि छुड़ांदा, यो लूटी गे ओर कोई आज्ञा नि देंदा कि वापस करी देयो। <verse eid="ISA 42:22" /><verse number="23" style="v" sid="ISA 42:23" />तुसा बीचा ते केस एते पाँदे त्यान लगाणा? केस त्यान लगाई की मईणत करने वाल़े रिया तँईं सुणना? <verse eid="ISA 42:23" /><verse number="24" style="v" sid="ISA 42:24" />याकूब किने लूटाया ओर इस्राएल लूटेरेया रे वशो दे करी ता? क्या यहोवे ये नि कित्तेया जेसरे खलाफ आसे पाप कित्तेया, जेसरी बाटा दे तिने चलणा नि चाया ओर ना तेसरा बिधान मानेया? <verse eid="ISA 42:24" /><verse number="25" style="v" sid="ISA 42:25" />इजी बजा ते यहोवे इस्राएलिया पाँदे आपणे रोषो री आग पड़काई ओर युद्धो री तागत चलायी, तेबे बी आग तेसरे चऊँ कनारे लगी गी, तेबे बी से नि समजेया, से फूखी बी गया, तेबे पनि समजेया।”<verse eid="ISA 42:25" /></para>
  <chapter eid="ISA 42" />
  <chapter number="43" style="c" sid="ISA 43" />
  <para style="s">परमेशर सदा आपणे लोका साथे रओआ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 43:1" />ओ इस्राएलो रे लोको तुसा खे रचणे वाल़ा ओर ओ याकूब ताखे रचणे वाल़ा यहोवा एबे ईंयाँ बोलोआ, “डर नि, कऊँकि मैं तूँ छुड़ाई ला रा, मैं तूँ नाओं लई की बुलाई राखेया, तूँ मेरा ई ए। <verse eid="ISA 43:1" /><verse number="2" style="v" sid="ISA 43:2" />जेबे तूँ समुद्रो बीचे पाणिए बीछीए जाए, मां तां साथे-साथे रणा ओर जेबे तूँ नदिया बीछीए चलेगा, तेबे नदिया ताखे डूबाई नि सकदिया, जेबे तूँ आगी बीछीए चलेगा, तेबे ताखे सेक नि लगणा ओर आगी री लूपिया ताखे फूकी नि सकणियां। <verse eid="ISA 43:2" /><verse number="3" style="v" sid="ISA 43:3" />कऊँकि आऊँ यहोवा तेरा परमेशर ए, आऊँ इस्राएलो रा पवित्र परमेशर तेरा उद्धार करने वाल़ा ए, मैं तूँ मिस्र देशो री गुलामिया ते छुड़ाया ओर बदले दे ताखे कूश ओर सबा देश आपणे करने खे दित्ते। <verse eid="ISA 43:3" /><verse number="4" style="v" sid="ISA 43:4" />मेरी नजरा दे तूँ बऊत कीमती ओर इज्जतदार ठईरी रा ओर आऊँ तां साथे प्यार राखूँआ, इजी बजा ते मां तेरे बदले माणूं ओर तेरे प्राणो रे बदले राज-राज रे लोक देई देणे। <verse eid="ISA 43:4" /><verse number="5" style="v" sid="ISA 43:5" />इजी खे डर नि, कऊँकि आऊँ तां साथे ए, मां तेरा कराना दूरो रे पूर्ब देशो ते लई आऊणा ओर पच्छमा ते बी कट्ठा करना।<note caller="+" style="f"><char style="fr" closed="false">43:5 </char><char style="ft" closed="false">यहे. 36:24, जक. 8:7 </char></note> <verse eid="ISA 43:5" /><verse number="6" style="v" sid="ISA 43:6" />मां उत्तर दिशा खे बोलणा, ‘मेरे बाल़क माखे देई दे’, ओर दक्खण दिशा ते बोलणा: मेरे लोका खे बंदी बनाई कि नि राख दूरो-दूरो ते मेरे पाऊआ ओर मेरी बेटिया खे मांगे ली आओ;<note caller="+" style="f"><char style="fr" closed="false">43:6 </char><char style="ft" closed="false">पज. 107:2,3 </char></note> <verse eid="ISA 43:6" /><verse number="7" style="v" sid="ISA 43:7" />हर एकी माणूंए खे जेसखे मेरा बोलेया जाओआ, ओर जो मैं आपणे आदर करने खे बणाई राखे, सेयो सब मेरे ए।”<verse eid="ISA 43:7" /></para>
  <para style="s">इस्राएल परमेशरो रा गवाह्</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 43:8" />परमेशरे बोलेया, “एड़े लोका खे जिना रे आखी रंदे ऊए अन्दे ए ओर कान रंदे ऊए टऊणे ए तिना खे निकयाल़ी की ली आओ! <verse eid="ISA 43:8" /><verse number="9" style="v" sid="ISA 43:9" />सबी जातिया रे लोका खे कट्ठे करी देयो ओर सारी दुनिया रे लोक कट्ठे ओ। तिना बीचा ते कुण ये गल्ल बताई सकोआ या बीती रिया गल्ला आसा गे सुणायी सकोआ? सेयो आपणे गवाह् ली आओ, जेते कि सेयो सच्चे ठईरो, सेयो सुणी लो ओर बोलो कि ये सच्च ए।” <verse eid="ISA 43:9" /><verse number="10" style="v" sid="ISA 43:10" />यहोवा बोलोआ, “तुसे लोक ई मेरे गवाह् ए ओर मेरे दास ए, जो मैं इजी खे चूणी राखे ताकि तुसे समजी की मेरा परोसा करो ओर ये जाणी लो कि आऊँ सेईए। मांते पईले कोई परमेशर नि ऊआ ओर ना मांते बाद कोई ओर परमेशर ऊणा।<note caller="+" style="f"><char style="fr" closed="false">43:10 </char><char style="ft" closed="false">यूह. 1:7,8, यशा. 45:6 </char></note> <verse eid="ISA 43:10" /><verse number="11" style="v" sid="ISA 43:11" />आऊँ ई यहोवा ए ओर माखे छाडी की ओर कोई उद्धार करने वाल़ा नि ए। <verse eid="ISA 43:11" /><verse number="12" style="v" sid="ISA 43:12" />मैं ई सन्देश दित्तेया, ओर उद्धार कित्तेया ओर बताया बी, जेबे तुसा बीचे कोई पराया देवता नि था, इजी री खातर तुसेई मेरे गवाह् ए,” यहोवे री ये बाणी ए। <verse eid="ISA 43:12" /><verse number="13" style="v" sid="ISA 43:13" />आऊँ ई परमेशर ए ओर सदा रणे वाल़ा बी आऊँ ईए, कोई नि ए जो मेरे आथो ते केसी खे छुड़ाई सकोआ, जेबे आऊँ काम करना चाऊँ, तेबे माखे कुण रोकी सकोआ।<note caller="+" style="f"><char style="fr" closed="false">43:13 </char><char style="ft" closed="false">1 तीमु. 1:17; रोम. 9:18,19 </char></note><verse eid="ISA 43:13" /></para>
  <para style="s">बाबेलो ते बचणा</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 43:14" />तुसा रा छुड़ाणे वाल़ा ओर इस्राएलो रा पवित्र यहोवा ईंयाँ बोलोआ, “मां तुसा रिया तँईं सेना बाबेलो रे खलाफ पेजणी। ओर तेथो रे सब रणे वाल़े भगोड़े री दशा दे ओर कसदी लोक बी तिना रे जाह्जो दे चढ़ाई की ल्याऊणे, जिना रे बारे दे सेयो बड़ा बोलोए। <verse eid="ISA 43:14" /><verse number="15" style="v" sid="ISA 43:15" />आऊँ यहोवा तुसा रा पवित्र, इस्राएलो खे बनाणे वाल़ा, तुसा रा राजा ए।” <verse eid="ISA 43:15" /><verse number="16" style="v" sid="ISA 43:16" />यहोवा जो समुद्रो दे बाट ओर प्रचण्ड बाढ़ा दे बाट बणाओआ, <verse eid="ISA 43:16" /><verse number="17" style="v" sid="ISA 43:17" />जो रथा, कोड़ेया ओर शूरवीरा समेत सेना खे निकयाल़ी की ली आओआ, सेयो तो कट्ठे ई तेथी रयी गे ओर फेर नि उठी सकदे, सेयो बीजी गे, सेयो रेशमो री बाठिया जेड़े बीजी गे। से ईंयाँ बोलोआ, <verse eid="ISA 43:17" /><verse number="18" style="v" sid="ISA 43:18" />पर यहोवे बोलेया, “एबे बीती री गल्ला रे बारे दे नि सोचो, ना ई पुराणे बखतो री गल्ला पाँदे त्यान लगाओ। <verse eid="ISA 43:18" /><verse number="19" style="v" sid="ISA 43:19" />देखो, आऊँ एक नवीं गल्ल करूँआ, से यबु सामणे आऊणी, क्या तुसे तिजी रे बारे दे अणजाण रणे? मां उजाड़ जगा दे एक बाट बनाणी ओर सूके रेगिस्तान देशो दे पाणिये रिया नदिया बाह्णियां।<note caller="+" style="f"><char style="fr" closed="false">43:19 </char><char style="ft" closed="false">पज. 107:35 </char></note> <verse eid="ISA 43:19" /><verse number="20" style="v" sid="ISA 43:20" />गीदड़ ओर शुतुरमुर्गेया बगैरा सबी जंगल़ी जन्तुआ मेरी महिमा करनी, कऊँकि मां आपणी चूणी री प्रजा खे पीणे खे उजाड़ जगा दे पाणी ओर रेगिस्तानो दे नदिया बाह्णियां। <verse eid="ISA 43:20" /><verse number="21" style="v" sid="ISA 43:21" />ये इस्राएलो रे लोक ए जो मैं आपणियां तँईं बणाई राखे, ताकि सेयो मेरी स्तुति करो।”<note caller="+" style="f"><char style="fr" closed="false">43:21 </char><char style="ft" closed="false">1 कुरि. 10:31, 1 पत. 2:9 </char></note><verse eid="ISA 43:21" /></para>
  <para style="s">इस्राएलो रा पाप</para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 43:22" />यहोवे बोलेया, “तेबे बी ओ याकूब, तैं मांते मतादा रिया तँईं प्रार्थना नि कित्ती; बल्कि ओ इस्राएल, तूँ मांते बोर ऊईगा रा! <verse eid="ISA 43:22" /><verse number="23" style="v" sid="ISA 43:23" />मेरिया तँईं बलि करने खे तूँ मिन्टू नि ल्याया ओर ना मेलबलि चढ़ाई की मेरी महिमा करी राखी। देख, मैं नज्जो री बलि चढ़ाणे री कठण सेवा तांते नि कराई, ना तांते तूप लई की तूँ थकाया।” <verse eid="ISA 43:23" /><verse number="24" style="v" sid="ISA 43:24" />तूँ मेरिया तँईं खुशबूदार नंगल़ कीमत देई की नि ल्याया ओर ना मेलबलिया री चर्बिया साथे आऊँ खुश कराया, पर तैं आपणे पापो रिया बजा ते मां पाँदे बोजा लादी ता रा ओर आपणे बुरे कामो साथे आऊँ थकाईता रा। <verse eid="ISA 43:24" /><verse number="25" style="v" sid="ISA 43:25" />आऊँ सेईए, जो आपणे नाओं रे मुताबिक तेरे पाप खत्म करी देऊँआ ओर तेरे पाप याद नि करूँगा।<note caller="+" style="f"><char style="fr" closed="false">43:25 </char><char style="ft" closed="false">इब्रा. 10:17; 8:12; यिर्म. 31:34 </char></note> <verse eid="ISA 43:25" /><verse number="26" style="v" sid="ISA 43:26" />माखे याद करो, आसे आपू बीचे बईस करूँए, तूँ आपणी गल्ल बता जेते कि तूँ निर्दोष ठईरे। <verse eid="ISA 43:26" /><verse number="27" style="v" sid="ISA 43:27" />तेरा मूल़ मर्द<note caller="+" style="f"><char style="fr" closed="false">43:27 </char><char style="fq" closed="false">मूल़ मर्द </char><char style="ft" closed="false">आदम </char></note> पापी ऊआ ओर जो-जो मेरे ओर तुसा बीचे बीचोले ऊए, सेयो मां साथे बगावत करदे आई रे। <verse eid="ISA 43:27" /><verse number="28" style="v" sid="ISA 43:28" />इजी बजा ते मैं पवित्र जगा रे हाकिम अपवित्र ठराए, मैं याकूबो रा नाश ओर इस्राएल शर्मिंदा ऊणे दित्तेया।<verse eid="ISA 43:28" /></para>
  <chapter eid="ISA 43" />
  <chapter number="44" style="c" sid="ISA 44" />
  <para style="s">बस यहोवा ई परमेशर ए</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 44:1" />यहोवे बोलेया, पर एबे ओ मेरे दास याकूब, ओ मेरे चूणे रे इस्राएल, मेरी गल्ल सुणी लो! <verse eid="ISA 44:1" /><verse number="2" style="v" sid="ISA 44:2" />ताखे बनाणे वाल़ा यहोवा, जो ताखे गर्भो तेई बणांदा आया ओर तेरी मताद करदा आई रा, से ईंयाँ बोलोआ, “ओ मेरे दास याकूब, ओ मेरे चूणे दे यशूरून, डर नि!<note caller="+" style="f"><char style="fr" closed="false">44:2 </char><char style="ft" closed="false">यशूरून इस्राएलो रे लोका खे प्यारो वाल़ा नाओं ए, ओर ये बिधानो री कताबा दे 33:5,26 दे बी आओआ; यशूरूनो रा मतलब तर्मी ए। </char></note> <verse eid="ISA 44:2" /><verse number="3" style="v" sid="ISA 44:3" />कऊँकि त्याये लोका रिया तँईं मा पाणी बरसाणा। सूकिया जमीना दे खाड्डा बाह्णियां, मां तेरे बच्चेया पाँदे आपणी आत्मा ओर तेरी ल्वादा पाँदे आपणी आशीष लटणी।<note caller="+" style="f"><char style="fr" closed="false">44:3 </char><char style="ft" closed="false">प्रका. 21:6, योए. 2:28 </char></note> <verse eid="ISA 44:3" /><verse number="4" style="v" sid="ISA 44:4" />बच्चे तिना बियूँसा रे डाल़ा जेड़े बढ़ने जो पाणिए कनारे काओ बीचे ओए।” <verse eid="ISA 44:4" /><verse number="5" style="v" sid="ISA 44:5" />लोका बीचा ते केसी बोलणा, “आऊँ यहोवे रा ए” केसी आपणा नाओं याकूब राखणा, केसी आपणे आथो दे लिखणा, “आऊँ यहोवे राए” ओर आपणे कुलो रा नाओं इस्राएली बताणा।<verse eid="ISA 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 44:6" />यहोवा इस्राएलो रा राजा ए, मतलब सेना रा यहोवा जो तेसखे छुड़ाणे वाल़ा ए, से ईंयाँ बोलोआ, “आऊँ सबी ते पईला ए ओर आऊँ ई अन्तो तक रणा; माखे छाडी की कोई परमेशर अया ई नि।<note caller="+" style="f"><char style="fr" closed="false">44:6 </char><char style="ft" closed="false">प्रका. 1:17, बिध. 1:17, प्रका. 21:6, प्रका. 22:13 </char></note> <verse eid="ISA 44:6" /><verse number="7" style="v" sid="ISA 44:7" />जदुओ ते मैं पुराणे बखतो ते माणूं बणाए, तदुओ ते कुण ऊआ जो मां जेड़ा तिजी खे प्रचार करो या बताओ या मेरिया तँईं बणाओ या ऊणे वाल़िया गल्ला पईले तेई बताओ? <verse eid="ISA 44:7" /><verse number="8" style="v" sid="ISA 44:8" />डरो नि ओर ना ई कबराओ; क्या मैं पईले तेई यो गल्ला तुसा गे नि सुणाईयां ओर तुसा सामणे ल्याईया नि? तुसे मेरे गवाह् ए। क्या माखे छाडी की ओर कोई देवता ए? ना, माखे छाडी की कोई चट्टान नि ए, आऊँ केसी ओरी खे नि जाणदा।”<verse eid="ISA 44:8" /></para>
  <para style="s">मूर्तिपूजा बेकार ए</para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 44:9" />जो लोक मूर्तिया कअड़ी की बणाओए, सेयो सारिया मूर्तिया बेकार ए ओर जिना चीजा दे सेयो खुशी टोल़ोए, तिना ते कोई फायदा नि ऊणा, तिना रे गवाह् ना तो आपू कुछ देखदे ओर ना कुछ जाणदे, इजी री खातर तिना खे शर्मिंदा ऊणा पड़ना। <verse eid="ISA 44:9" /><verse number="10" style="v" sid="ISA 44:10" />किने देवता या बेकार मूर्तिया बणाईया? <verse eid="ISA 44:10" /><verse number="11" style="v" sid="ISA 44:11" />देख, तेसरे सारे मूर्तिया खे बनाणे वाल़े कारीगर ओर पूजा करने वाल़ेया खे शर्मिंदा ऊणा पड़ना, मूर्तिया बनाणे वाल़े तो माणूं ईए, सेयो सारे के सारे कट्ठे ऊई की खड़े ओ; सेयो डरी जाणे; सेयो सारे के सारे शर्मिंदा ऊणे। <verse eid="ISA 44:11" /><verse number="12" style="v" sid="ISA 44:12" />ल्वार एक बसूला फेऊआ पाँदे बणाओआ ओर थौड़ेया साथे कअड़ी की त्यार करोआ, से आपणी तागती साथे तिजी खे बणाओआ; तेबे से पूखा ऊई जाओआ ओर तेसरी तागत कम ऊई जाओई, से पाणी नि पींदा ओर थकी जाओआ। <verse eid="ISA 44:12" /><verse number="13" style="v" sid="ISA 44:13" />मिस्त्री सूत लगाई की परकारा साथे सरेदा लगाओआ ओर छिणियाँ ओर रन्दे साथे काम करोआ, से तिजी रा आकार ओर माणूंए जेड़ी सुन्दरता बणाओआ ताकि लोक तिजी खे मन्दरो दे राखो। <verse eid="ISA 44:13" /><verse number="14" style="v" sid="ISA 44:14" />लकड़िया दे नक्काशी करने वाल़ा देवदारा खे बाडोआ या बणो रे डाल़ा बीचा ते जातिया-जातिया रे बाँजो रे डाल़ चूणी की देख-भाल़ करोआ, से देवदारो रा एक डाल़ लगाओआ, जो बर्खा रे पाणिए साथे बढ़ोआ। <verse eid="ISA 44:14" /><verse number="15" style="v" sid="ISA 44:15" />तेबे से माणूंआ रे बाल़ने रे कामे आओआ, से तिजी बीचा ते कुछ सुलगायी की तपाओआ, से तिजी खे बाल़ी की रोटी बणाओआ, तिजी साथे ई से देवता बणाई की तेस सामणे माथा टेकोआ, से मूर्ति बणाई की तिजी री आराधना करोआ। <verse eid="ISA 44:15" /><verse number="16" style="v" sid="ISA 44:16" />से आदमी तिजी रा एक इस्सा तो से आगी दे बाल़ोआ ओर दूजे इस्से दे मास पकाई की खाओआ, से मास पूजी की खुश ओआ, तेबे सेकी की बोलोआ, “वा, आऊँ गर्म ऊईगा, मैं आग देखी राखी!” <verse eid="ISA 44:16" /><verse number="17" style="v" sid="ISA 44:17" />ओर तिजी रे बचे रे इस्से खे लई की एक देवता, मतलब एक मूर्ति बणाओआ, तेबे से तिजी सामणे माथा टेकोआ ओर आराधना करोआ ओर तेसते प्रार्थना करी की बोलोआ, “माखे बचाई लो, कऊँकि तूँ मेरा देवता ए!”<note caller="+" style="f"><char style="fr" closed="false">44:17 </char><char style="ft" closed="false">प्रेरि. 17:29 </char></note> <verse eid="ISA 44:17" /><verse number="18" style="v" sid="ISA 44:18" />सेयो कुछ नि जाणदे, ना ई कोई समज राखदे; कऊँकि तिना रिया आखी एड़िया मिछी गी रिया कि सेयो देखी नि सकदे ओर तिना रा दमाक एड़ा कि सेयो कुछ समजी नि सकदे। <verse eid="ISA 44:18" /><verse number="19" style="v" sid="ISA 44:19" />इना चीजा रे बारे दे ये लोक कोई त्यान नि देंदे ओर ना ई केसी खे इतणा ज्ञान या समज रंदी कि से बोली सको, “इजी रा एक इस्सा तो मैं फूकी ता ओर तिजी रे फेऊआ पाँदे रोटी बणाई ओर मास पूजी की खाई राखेया; तो क्या आऊँ इजी रे बचे रे इस्से खे बुरी चीज बणाऊँ? क्या आऊँ लक्कड़ो गे माथा टेकूँ?” <verse eid="ISA 44:19" /><verse number="20" style="v" sid="ISA 44:20" />एड़ा मूर्ति बनाणे वाल़ा स्वा खाओआ, से सकेल़ी री बुद्धिया साथे पटकाई राखेया ओर से ना तो आपू खे बचाई सकदा ओर ना ये बोली सकदा, “क्या मेरे दाँणे आथो रे चूठ नि ए?”<verse eid="ISA 44:20" /></para>
  <para style="s">सच्चा परमेशर यहोवा इस्राएलो रा मताद करने वाल़ा ए</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 44:21" />यहोवे बोलेया, “ओ याकूब, ओ इस्राएल, इना गल्ला खे याद कर, तूँ मेरा दास ए, मैं तूँ बणाई राखेया; ओ इस्राएल, तूँ मेरा दास ए, मां तूँ नि पूलाणा। <verse eid="ISA 44:21" /><verse number="22" style="v" sid="ISA 44:22" />मैं तेरे पाप काल़ी तूँईंयां जेड़े ओर तेरे पाप बादल़ो जेड़े मिटाईते रे; मेरी तरफा खे फेर वापस आओ, कऊँकि मैं तूँ छुड़ाई ला रा। <verse eid="ISA 44:22" /><verse number="23" style="v" sid="ISA 44:23" />ओ सर्ग, जोरे की गा, कऊँकि यहोवे महान काम करी राखेया; ओ तरतिया री डूगी जगा, जयजयकार करो, ओ पाह्ड़ो, ओ बणो, ओ बणो रे सारे डाल़ो, गल़ा खोली की जोरे की गाओ! कऊँकि यहोवे याकूब छुड़ाई ला रा ओर इस्राएलो दे महान ऊणा।” <verse eid="ISA 44:23" /><verse number="24" style="v" sid="ISA 44:24" />यहोवा, तेरा उद्धार करने वाल़ा, जो ताखे गर्भो ते ई बणांदा आई रा, ईंयाँ बोलोआ, “आऊँ यहोवा ई सबी खे बनाणे वाल़ा ए, जिने कल्ले ई सर्ग तणेया ओर तरती आपणी शक्तिया साथे फैलाई राखी। <verse eid="ISA 44:24" /><verse number="25" style="v" sid="ISA 44:25" />आऊँ चूठे लोका रे बोले रे नशाणा खे बेकार करी देऊँआ ओर मरी री आत्मा साथे गल्ला करने वाल़ेया खे इस्साल करी देऊँआ; जो अक्लमंद माणूंए खे पीछे टाई देयोआ ओर तिना री अक्ला खे मूर्ख बणाई देयोआ।”<note caller="+" style="f"><char style="fr" closed="false">44:25 </char><char style="ft" closed="false">अय्यू. 5:12-14, 1 कुरि. 1:20 </char></note> <verse eid="ISA 44:25" /><verse number="26" style="v" sid="ISA 44:26" />ओर आपणे दासो रे वचना खे पूरा करूँआ ओर आपणे दूतो री योजना खे पूरा करूँआ, जो यरूशलेम शईरो रे बारे दे बोलोआ, “से फेर बसाई जाणी” ओर यहूदा रे शईरो रे बारे, सेयो फेर बणने ओर मां तिना रे खण्डहर सुदारने, <verse eid="ISA 44:26" /><verse number="27" style="v" sid="ISA 44:27" />यहोवा डूग्गे पाणिए खे बोलोआ, “तूँ सूकी जा, मां तेरी नदिया सुकाई देणियां”<note caller="+" style="f"><char style="fr" closed="false">44:27 </char><char style="ft" closed="false">यिर्म. 51:36 </char></note> <verse eid="ISA 44:27" /><verse number="28" style="v" sid="ISA 44:28" />आऊँ ई से माणूंआ जो फारसो रे राजा कुस्रूए रे बारे दे बोलोआ, “से मेरा ठराया रा ग्वाल़ा ए ओर तेस मेरी इच्छा पूरी करनी” यरूशलेम शईरो रे बारे दे बोलोआ, “से फेर बसणा ओर मन्दरो रे बारे दे कि तेरी निऊँ पड़नी।”<note caller="+" style="f"><char style="fr" closed="false">44:28 </char><char style="ft" closed="false">एज्र. 1:1-3 </char></note><verse eid="ISA 44:28" /></para>
  <chapter eid="ISA 44" />
  <chapter number="45" style="c" sid="ISA 45" />
  <para style="s">कुस्रू राजा परमेशरो रे अभिषिक्तो रे रूपो दे</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 45:1" />यहोवा आपणे अभिषिक्त फारसो रे राजा कुस्रूए रे बारे दे ईंयाँ बोलोआ कि मैं तेसरा दाँणा आथ इजी खे पकड़ेया ताकि तेस सामणे जातिया खे दबाई देऊँ ओर दुश्मण राजेया री शक्ति कम करुँ, तेस सामणे शईरा रे बड़े द्वारा खे एड़ा खोली देऊँ कि सेयो बड़े द्वार बन्द नि ओ। ओर से तिना दे पीतरे जाई सको। <verse eid="ISA 45:1" /><verse number="2" style="v" sid="ISA 45:2" />मां तांते आगे-आगे चलणा, ओर उची-उची जगा चौरस करनी, मां पीतल़ी रे द्वार तोड़ी देणे ओर लोए रे बेड़ेया रे टुकड़े-टुकड़े करी देणे। <verse eid="ISA 45:2" /><verse number="3" style="v" sid="ISA 45:3" />मां ताखे न्हेरे दे लूकेया रा ओर गुप्त जगा रे दबाया रा तअन देणा, जेते कि ताखे पता लगी जाओ कि आऊँ इस्राएलो रा परमेशर यहोवा ए जो ताखे नाओं लई की बुलाओआ।<note caller="+" style="f"><char style="fr" closed="false">45:3 </char><char style="ft" closed="false">यिर्म. 27:5, कुलु. 2:3 </char></note> <verse eid="ISA 45:3" /><verse number="4" style="v" sid="ISA 45:4" />आपणे दास याकूब ओर आपणे चूणे रे इस्राएलो रिया तँईं मैं तूँ नाओं लई की बुलाई राखेया, तेबे बी तूँ माखे नि जाणदा, पर मैं तेबे बी ताखे पदवी देई राखी। <verse eid="ISA 45:4" /><verse number="5" style="v" sid="ISA 45:5" />आऊँ यहोवा ए ओर माखे छाडी की कोई दूजा परमेशर नि ए; तूँ माखे नि जाणदा, पर मां तेबे बी ताखे युद्ध करने खे शक्ति देणी, <verse eid="ISA 45:5" /><verse number="6" style="v" sid="ISA 45:6" />आऊँ ये काम करूँआ ताकि सारे लोक जाणी जाओ कि आऊँ ई परमेशर ए। जेते कि पूर्बो ते लई की पच्छमा तक लोका खे पता लगी जाओ कि आऊँ यहोवा ए ओर दूजा कोई परमेशर नि ए। <verse eid="ISA 45:6" /><verse number="7" style="v" sid="ISA 45:7" />आऊँ प्रयासे खे ओर न्हेरे खे बनाणे वाल़ा ए, आऊँ शान्तिया खे ओर मुसीबता खे बणाऊँआ, आऊँ यहोवा ई इना सबी खे बनाणे वाल़ा ए। <verse eid="ISA 45:7" /><verse number="8" style="v" sid="ISA 45:8" />ओ सर्ग, ऊबा ते तर्म बरसा, सर्गो ते तर्मो री बर्खा ओ; तरती खुलो ताकि उद्धार पैदा ओ ओर तर्म बी तिजी साथे जमाओ, मैं यहोवे ई से पैदा करी राखेया।<verse eid="ISA 45:8" /></para>
  <para style="s">कुम्हार ओर माट्टी</para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 45:9" />ओ इस्राएल, लाणत ए तेस पाँदे जो आपणे बनाणे वाल़े परमेशरो साथे लड़ोआ! से तो माट्टिया रे ठीकरेया बीचे एकी ठीकरे जेड़ा ए, माट्टी कुम्हारो खे नि बोली सकदी कि तूँ ये क्या करने लगी रा? क्या कारीगरो रा बणाया रा काम तेसरे बारे दे बोलोआ, “एतेरे तो आथ ई नि ए?<note caller="+" style="f"><char style="fr" closed="false">45:9 </char><char style="ft" closed="false">रोम. 9:20,21 </char></note> <verse eid="ISA 45:9" /><verse number="10" style="v" sid="ISA 45:10" />तेस पाँदे लाणत ए जो आपणे बाओ खे बोलो कि तूँ क्या जमाएया? ओर माया खे बोलो कि तूँ केसरी माये ए?” <verse eid="ISA 45:10" /><verse number="11" style="v" sid="ISA 45:11" />यहोवा जो इस्राएलो रा पवित्र परमेशर ओर तिजी खे बनाणे वाल़ा ए, से ईंयाँ बोलोआ, “क्या तुसा ऊणे वाल़ी गल्ला मांते पूछणियां? क्या मेरे पाऊआ ओर मेरे कामो रे बारे दे तुसा माखे आज्ञा देणी? <verse eid="ISA 45:11" /><verse number="12" style="v" sid="ISA 45:12" />मैं ई तरती बणाई ओर तिजी पाँदे माणूं बणाए; मैं आपणे आथो साथे ई सर्ग तणेया ओर सर्गो रे सारे तारेया खे आज्ञा देई राखी। <verse eid="ISA 45:12" /><verse number="13" style="v" sid="ISA 45:13" />मैं ई से मर्द कुस्रू तार्मिकता साथे परेया ओर मां तेसरिया सारिया बाटा सीदिया करनिया; तेस मेरा शईर यरूशलेम फेर बसाणा ओर मेरे बन्दी बिना कीमत या बदला लई की छुड़ाणे सेना रे यहोवे रे यो ई वचन ए।”<verse eid="ISA 45:13" /></para>
  <para style="s">एक परमेशर ई उद्धार करने वाल़ा ए</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 45:14" />यहोवा इस्राएलो ते ईंयाँ बोलोआ, “मिस्री लोका री कमाई ओर कूशी<note caller="+" style="f"><char style="fr" closed="false">45:14 </char><char style="fq" closed="false">कूशी </char><char style="ft" closed="false">इथोपिया देश </char></note> लोका रे बपारो रा फाईदा ओर सबाई लोक जो मोटे-तगड़े ए, तांगे आऊणे ओर तेरे ई ऊई जाणे, सेयो तां पीछे-पीछे चलणे, सेयो साँगल़ा साथे बन्दे रे आऊणे ओर तां सामणे माथा टेकी की तांते प्रार्थना करी की बोलणा कि पक्का परमेशर तां साथे ए ओर दूजा कोई नि ए; तेसरे सिवाये कोई ओर परमेशर नि ए।”<note caller="+" style="f"><char style="fr" closed="false">45:14 </char><char style="ft" closed="false">जक. 8:22,23, प्रका. 3:9 </char></note> <verse eid="ISA 45:14" /><verse number="15" style="v" sid="ISA 45:15" />ओ इस्राएलो रे परमेशर, ओ उद्धार करने वाल़े! पक्का तूँ एड़ा परमेशर ए जो आपू खे गुप्त राखोआ।<note caller="+" style="f"><char style="fr" closed="false">45:15 </char><char style="ft" closed="false">रोम. 11:33 </char></note> <verse eid="ISA 45:15" /><verse number="16" style="v" sid="ISA 45:16" />मूर्तिया खे कअड़ने वाल़े सारे के सारे कारीगर शर्मिंदा ओर हैरान ऊणे, सेयो सारे के सारे बेचैन ऊणे। <verse eid="ISA 45:16" /><verse number="17" style="v" sid="ISA 45:17" />पर इस्राएलो रे लोका खे यहोवे रे जरीये उद्धार मिलणा आसे युगो-युगो तक बल्कि अनन्तकालो तक ना तो कदी शर्मिंदा ऊणे ओर ना कदी बेचैन ऊणे।<note caller="+" style="f"><char style="fr" closed="false">45:17 </char><char style="ft" closed="false">रोम. 10:11, योए. 2:26,27, इब्रा. 5:9 </char></note> <verse eid="ISA 45:17" /><verse number="18" style="v" sid="ISA 45:18" />कऊँकि यहोवा ई परमेशर ए। सेई सर्गो खे बनाणे वाल़ा ए, तिने ई तरती बणाई, ओर तिने ई से स्थिर बी कित्ती, तिने से सुनसाण रणे खे नि पर से बसणे खे बणाई राखी। से ईंयाँ बोलोआ, “आऊँ यहोवा ए, मांते सिवाये ओर कोई परमेशर नि ए। <verse eid="ISA 45:18" /><verse number="19" style="v" sid="ISA 45:19" />मैं ना तो केसी गुप्त जगा रे, ना न्हेरे दे केसी देशो दे गल्ला कित्तिया, मैं याकूबो रे कुलो खे नि बोलेया कि माखे बेकारो दे टोल़ो। आऊँ यहोवा सच्च ई बोलूँआ, आऊँ खरिया गल्ला बताऊँआ।”<verse eid="ISA 45:19" /></para>
  <para style="s">यहोवा सिद्ध करोआ कि से ई परमेशर ए</para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 45:20" />यहोवा बोलोआ, “ओ जातिया-जातिया बीचा ते बचे रे लोको, कट्ठे ऊई की आओ, एक साथे मिली की नेड़े आओ! सेयो जो आपणी बणाई री मूर्तिया लई की फिरोए ओर एड़े देवतेया ते जिना साथे उद्धार नि ऊई सकदा, प्रार्थना करोए, सेयो मूर्ख ए। <verse eid="ISA 45:20" /><verse number="21" style="v" sid="ISA 45:21" />तुसे प्रचार करो ओर तिना खे मांगे ल्याओ; आ, सेयो आपू बीचे सला करो किने पुराणे बखतो दे ऊईया दिया गल्ला रे बारे दे बताया? जो ऊणे वाल़ा ए तेतेरे बारे दे पुराणे बखतो देई पईले ते ई किने बताया था? मैं यहोवे ई इजी रे बारे दे दशेया था। इजी री खातर माखे छाडी की कोई ओर दूजा परमेशर नि ए, तर्मी ओर उद्धार करने वाल़ा एती माखे छाडी की कोई ओर परमेशर नि ए, सिर्फ आऊँ कल्ला ई ए।” <verse eid="ISA 45:21" /><verse number="22" style="v" sid="ISA 45:22" />ओ तरतिया रे दूर-दूर देशो रे रणे वाल़ेयो, तुसे मेरी तरफा खे फिरो ओर उद्धार पाओ! कऊँकि माखे छाडी की कोई ओर दूजा परमेशर नि ए। <verse eid="ISA 45:22" /><verse number="23" style="v" sid="ISA 45:23" />मैं आपणी ई कसम खाई, तर्मो रे मुताबिक मेरे मुंए ते ये वचन निकल़ेया ओर से नि टल़ना, एक दिन हर एक माणूं मां सामणे नपणा ओर हर एकी रे मुंए ते मेरी ई कसम खाई जाणी।<note caller="+" style="f"><char style="fr" closed="false">45:23 </char><char style="ft" closed="false">इब्रा. 6:13, रोम. 14:11, फिलि. 2:10,11 </char></note> <verse eid="ISA 45:23" /><verse number="24" style="v" sid="ISA 45:24" />लोका मेरे बारे दे बोलणा, “बस यहोवे देई तर्म ओर शक्ति ए। तेसगे ई लोक आऊणे ओर जो तेसते नराज रणे, तिना खे शर्मिंदा ऊणा पड़ना। <verse eid="ISA 45:24" /><verse number="25" style="v" sid="ISA 45:25" />पर इस्राएलो रे सारे वंशो रे लोका यहोवे दे जीत आसिल करनी ओर जो कुछ यहोवे करी राखेया तीजी रिया बजा ते खुश ऊणे।”<verse eid="ISA 45:25" /></para>
  <chapter eid="ISA 45" />
  <chapter number="46" style="c" sid="ISA 46" />
  <para style="s">मरिया दिया मूर्तिया ओर जिऊँदा परमेशर</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 46:1" />यशायाहे बोलेया, “बेल देवता<note caller="+" style="f"><char style="fr" closed="false">46:1 </char><char style="fq" closed="false">बेल देवता </char><char style="ft" closed="false">एसखे मर्दुक देवते रे नाओ ते जाणेया जाओ था, बेबीलोनो रा खास देवता था। </char></note> ओर नबो देवता<note caller="+" style="f"><char style="fr" closed="false">46:1 </char><char style="fq" closed="false">नबो देवता </char><char style="ft" closed="false">ये बी बेबीलोनो रा एक देवता था जो मर्दुको रा पाऊ था। </char></note> तां आगे चूकी गे, तिना री मूर्तिया डांगरा पाँदे बल्कि करेलू डांगरा पाँदे लदी रिया; जिना चीजा खे तुसे चकी की फिरदे रओए, सेयो एबे पारी बोजा ऊईगिया ओर थके रे डांगरा पाँदे लदी रिया।” <verse eid="ISA 46:1" /><verse number="2" style="v" sid="ISA 46:2" />यहोवा बोलोआ, “सेयो मूर्तिया चूकी गिया, सेयो एक साथे चूकी गिया, सेयो तेस पारो खे छुड़ाई नि सके ओर आपू बी गुलामिया दे चली गे रे।” <verse eid="ISA 46:2" /><verse number="3" style="v" sid="ISA 46:3" />ओ याकूबो रे कराने, मेरी सुण! ओ इस्राएलो रे कराने रे सारे बचे रे लोको, मेरी तरफा खे कान लगाई की सुणो; आऊँ तुसा खे तदुओ ते चकी की आई रा, जदुओ ते तुसे पैदा ऊई रे। <verse eid="ISA 46:3" /><verse number="4" style="v" sid="ISA 46:4" />जेबे तुसे स्याणे ऊणे तेबे बी आऊँ तेड़ा ई रणा ओर मां तुसे स्याणदे बखतो तक साथे राखणे। मैं तुसे बणाए ओर तुसे साथे राखणे; मां तुसे चकी की राखणे ओर तुसा खे छुड़ांदा बी रऊँगा। <verse eid="ISA 46:4" /><verse number="5" style="v" sid="ISA 46:5" />तुसा मेरी उपमा केस साथे देणी ओर आऊँ केस जेड़ा बताणा, केस साथे मेरा मलाप करना कि आसे एक जेड़े ए। <verse eid="ISA 46:5" /><verse number="6" style="v" sid="ISA 46:6" />कई लोक सूईने ओर चाँदिए ते अमीर ए। जो थैलिया ते सूईना लटोए ओर ताकड़िया दे चाँदी तोलोए, जो सन्यारो खे मजदूरी देई की तेसते देवते री मूर्ति बणाओए, तेबे सेयो तेसगे माथा टेकोए, बल्कि तेसरी आराधना बी करोए।<note caller="+" style="f"><char style="fr" closed="false">46:6 </char><char style="ft" closed="false">निर्ग. 32:2-4 </char></note> <verse eid="ISA 46:6" /><verse number="7" style="v" sid="ISA 46:7" />सेयो लोक चूठे देवतेया रिया मूर्तिया खे कान्दा पाँदे चकी की फिरदे रओए, सेयो तेसा मूर्तिया खे तेसरी जगा दे राखी देओए ओर से तेथी खड़ी दी रओई; से आपणी जगा ते अटी नि सकदी; जे कोई तेसारी दुहाई बी देयो, तेबे बी से सुणी नि सकदी ओर ना मुसीबता दे तेसरा उद्धार करी सकोई। <verse eid="ISA 46:7" /><verse number="8" style="v" sid="ISA 46:8" />“तुसे लोके पाप करी राखे। तुसे इना गल्ला खे फेर याद करो ओर त्यान देयो, इजी पाँदे फेर मन लगाओ। <verse eid="ISA 46:8" /><verse number="9" style="v" sid="ISA 46:9" />जो काम मैं बऊत बखत पईले कित्ते थे तिना खे याद करो, कऊँकि आऊँ ई परमेशर ए, दूजा कोई नि ए, आऊँ ई परमेशर ए ओर मां जेड़ा कोई पनि ए। <verse eid="ISA 46:9" /><verse number="10" style="v" sid="ISA 46:10" />आऊँ तो अन्तो री गल्ल शुरूओ ते ओर पुराणे बखतो ते बतांदा आई रा जो एबुए तक नि ऊई। आऊँ बोलूँआ, ‘मेरी योजना स्थिर रणी ओर मां आपणी इच्छा पूरी करनी।’ <verse eid="ISA 46:10" /><verse number="11" style="v" sid="ISA 46:11" />आऊँ पूर्बो ते एक उकाब पंछी, मतलब दूर देशो ते आपणी योजना पूरी करने वाल़े मर्दो खे बुलाऊँआ। मैं ई ये गल्ल बोली राखी ओर मां ये पूरी बी करनी, मैं ये सोची राखेया ओर मां ये सफल बी करनी।<note caller="+" style="f"><char style="fr" closed="false">46:11 </char><char style="ft" closed="false">एती फारसो रे राजा कुस्रूए रे बारे दे ए। तेस सेई करना जो यहोवे तेसरिया तँईं योजना बणाई राखी। </char></note> <verse eid="ISA 46:11" /><verse number="12" style="v" sid="ISA 46:12" />ओ काठे मन वाल़े लोको! मेरी गल्ल सुणो। तुसे जो उद्धारो ते बऊत दूर ए। <verse eid="ISA 46:12" /><verse number="13" style="v" sid="ISA 46:13" />आऊँ आपणी धार्मिकता नेड़े ल्याऊणे वाल़ा ए, से दूर नि ए ओर मेरे उद्धार करने दे देरी नि ऊणी, मां यरूशलेम बचाणा ओर इस्राएलो खे इज्जत देणी।”<verse eid="ISA 46:13" /></para>
  <chapter eid="ISA 46" />
  <chapter number="47" style="c" sid="ISA 47" />
  <para style="s">बाबेलो रा नाश</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 47:1" />यहोवा बोलोआ, “ओ बाबेलो री कँवारी बेटी, आपणी जगा ते उतरी की थाले आओ ओर तूड़ा पाँदे बैठ; ओ कसदिया री बेटी तू बिना सिंहासनो ते जमीना पाँदे बैठ! कऊँकि तू एबे फेर नरम ओर नाजुक नि बोली जाणी। <verse eid="ISA 47:1" /><verse number="2" style="v" sid="ISA 47:2" />चाक्की लई की आटा पीस, आपणा कुण्डा कनारे कर ओर नदिया खे पार करने खे आपणा कागरा कट्ठा करी की ऊबे चकी लो। <verse eid="ISA 47:2" /><verse number="3" style="v" sid="ISA 47:3" />लोका तूँ नांगी करनी ओर तूँ बऊत शर्मिंदा ऊणी, मां बदला लणा ओर कोई माणूं नि छाडणा।” <verse eid="ISA 47:3" /><verse number="4" style="v" sid="ISA 47:4" />म्हारा छुटकारा देणे वाल़े रा नाओं सेना रा यहोवा ओर इस्राएलो रा पवित्र परमेशर ए। <verse eid="ISA 47:4" /><verse number="5" style="v" sid="ISA 47:5" />यहोवा बोलोआ, “ओ कसदिया री बेटी<note caller="+" style="f"><char style="fr" closed="false">47:5 </char><char style="fq" closed="false">कसदिया री बेटी </char><char style="ft" closed="false">बेबीलोनो रे लोको </char></note>, चुपचाप बैठी जा, ओर न्हेरे दे जा; कऊँकि ताखे दूजी बार केसी बी राज-राज री राणी नि बोलणा।”<verse eid="ISA 47:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 47:6" />मैं आपणे लोका पाँदे रोषे ऊई की आपणा इस्सा अपवित्र ठराया ओर तेरे वशो दे करी ता; तैं तिना पाँदे कोई दया नि कित्ती; तैं स्याणेया पाँदे आपणा बड़ा पारी जूँगड़ा राखी ता। <verse eid="ISA 47:6" /><verse number="7" style="v" sid="ISA 47:7" />तैं बोलेया, “ओ बेबीलोनियो, मां सदा राणी बणी की रणा” इजी री खातर तैं आपणे मनो दे इना गल्ला रे बारे दे नि सोचेया ओर ये पनि सोचेया कि इना गल्ला रा क्या फल़ ऊणा। <verse eid="ISA 47:7" /><verse number="8" style="v" sid="ISA 47:8" />इजी री खातर मेरी सुण, तूँ जो राग-रंगो दे फसी री बिना डरे बैठी री रएई ओर मनो दे बोलोई, “कि आऊँ ईए ओर माखे छाडी की दूजा कोई नि ए, मां बिदुआ जेड़े नि बैठणा ओर ना मेरे बाल-बच्चे मरने।”<note caller="+" style="f"><char style="fr" closed="false">47:8 </char><char style="ft" closed="false">सप. 2:15, प्रका. 18:7 </char></note> <verse eid="ISA 47:8" /><verse number="9" style="v" sid="ISA 47:9" />सुण, ये दोनो गल्ला, मतलब दु:ख ओर बच्चेया रा मरना ओर बिदुआ ऊणा, अचाणक एक ई दिने तां पाँदे पड़ना। तेरे बऊत सारे जादू-टोणे ओर तंत्र-मंत्र ऊँदे ऊए बी यो तां पाँदे आपणी पूरी तागती ते पड़ने।<note caller="+" style="f"><char style="fr" closed="false">47:9 </char><char style="ft" closed="false">प्रका. 18:8,23 </char></note> <verse eid="ISA 47:9" /><verse number="10" style="v" sid="ISA 47:10" />तैं आपणी बुराईया पाँदे परोसा राखेया, तैं बोलेया, “माखे कोई नि देखदा” तेरी बुद्धि ओर ज्ञाने तूँ बईकाईती ओर तैं आपणे मनो दे बोलेया, “आऊँ ईए ओर मांते अलावा कोई दूजा नि ए।” <verse eid="ISA 47:10" /><verse number="11" style="v" sid="ISA 47:11" />पर तेरी एड़ी बुरी दशा ऊणी, जेतेरा मंत्र तूँ नि जाणदी ओर तां पाँदे एड़ी मुसीबत पड़नी कि तूँ तिजी रा प्राश्चित करी की निवारण नि करी सकदी, तां पाँदे अचाणक मुसीबत आऊणी, जेतेरा ताखे कोई बी पता नि ए।<note caller="+" style="f"><char style="fr" closed="false">47:11 </char><char style="ft" closed="false">1 थिस्स. 5:3 </char></note><verse eid="ISA 47:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 47:12" />आपणे तंत्र-मंत्र ओर बऊत सारे जादू जो तैं बचपनो ते सीखी राखे, कामो दे ल्याओ, क्या पता ताखे तिना ते कुछ फायदा ऊई जाओ या तिना रे जरीये स्थिर रई सके। <verse eid="ISA 47:12" /><verse number="13" style="v" sid="ISA 47:13" />तूँ तो योजना करदी-करदी थकी गी री; एबे तेरे ज्योतषी जो नक्षत्र त्यानो साथे देखोए ओर नये-नये चाँद देखी की ऊणे वाल़ी गल्ला बताओए, सेयो खड़े ऊई की ताखे तिना मुसीबता ते बचाओ जो तां पाँदे पड़नियां। <verse eid="ISA 47:13" /><verse number="14" style="v" sid="ISA 47:14" />देख, बेबीलोनो रे ज्योतषी पूओ जेड़े ऊई की आगी दे फूखी जाऊणे; सेयो आपणे प्राणो खे आगी ते नि बचाई सकणे। से आग सेखणे खे नि, ना एड़ी ऊणी कि जेते सामणे कोई बैठी सको! <verse eid="ISA 47:14" /><verse number="15" style="v" sid="ISA 47:15" />जिना रिया तँईं तूँ मईणत करदी आई री सेयो सारे तेरिया तँईं तेड़े ई ऊणे ओर जो तेरी जवानिया दे तां साथे बपार करदे आई रे, तिना बीचा ते हर एक आपणी-आपणी बाटा दे चली जाणा, ताखे बचाणे वाल़ा कोई नि रणा।<verse eid="ISA 47:15" /></para>
  <chapter eid="ISA 47" />
  <chapter number="48" style="c" sid="ISA 48" />
  <para style="s">परमेशर भविष्य रा बी स्वामी ए</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 48:1" />भविष्यबक्ता यशायाह इस्राएलो रे लोका खे बोलोआ कि यहोवा बोलोआ, “ओ इस्राएलियो, ये गल्ल सुणो, तुसा खे जो इस्राएली बोलेया जाओआ ओर यहूदा री सूबल़ा रे पाणिए ते पैदा ऊई रे; जो यहोवे रे नाओं री कसम खाओए ओर इस्राएलो रे परमेशरो री चर्चा तो करोए, पर सच्चाई ओर तर्मो साथे नि करदे। <verse eid="ISA 48:1" /><verse number="2" style="v" sid="ISA 48:2" />कऊँकि इस्राएली लोक आपणे आपू खे पवित्र शईर यरूशलेमो रे लोक ऊणे रा दावा करोए ओर इस्राएलो रे परमेशरो पाँदे, जेसरा नाओं सेना रा यहोवा ए, परोसा राखोए।” <verse eid="ISA 48:2" /><verse number="3" style="v" sid="ISA 48:3" />यहोवा इस्राएलो ते बोलोआ, “मैं ऊणे वाल़िया गल्ला बऊत पईले ते ई बताई ती रिया कि क्या ऊणे वाल़ा ए, मैं अचाणक सेयो बताईया ओर सेयो गल्ला सच्ची ऊईया। <verse eid="ISA 48:3" /><verse number="4" style="v" sid="ISA 48:4" />आऊँ जाणो था कि तूँ टीठ ए ओर तेरी क्याड़ी लोए री नस ओर तेरा माथा पीतल़ी राए। <verse eid="ISA 48:4" /><verse number="5" style="v" sid="ISA 48:5" />इजी बजा ते मैं यो गल्ला पईले ते ई तांगे बताईया, तिना रे ऊणे ते पईले ई मैं तांगे बताया, ताकि एड़ा नि ओ कि तूँ बोले कि ये तो मेरे देवते रा काम ए, मेरी बणाई री मूर्तिया री आज्ञा ते ये ऊई रा। <verse eid="ISA 48:5" /><verse number="6" style="v" sid="ISA 48:6" />तैं सुणी राखेया, एबे इना सबी मेरिया भविष्यबाणिया पाँदे त्यान दे ओर देख, क्या तां इना रा प्रचार नि करना? आजो ते मां ताखे नईया-नईया गल्ला ओर एड़िया गुप्त सुनाणियां जिना खे तूँ नि जाणदा।<note caller="+" style="f"><char style="fr" closed="false">48:6 </char><char style="ft" closed="false">प्रका. 1:19 </char></note> <verse eid="ISA 48:6" /><verse number="7" style="v" sid="ISA 48:7" />सेयो कटना यबु-यबु बणाई राखिया, पईले ते नि; बल्कि आजो ते पईले तैं सुणी पनि राणिया थिया, एड़ा नि ओ कि तूँ बोले कि देख आऊँ तो इना खे जाणूं था। <verse eid="ISA 48:7" /><verse number="8" style="v" sid="ISA 48:8" />जिना गल्ला रे बारे दे आऊँ तांगे बताणे वाल़ा ए, तैं सेयो कदी नि सुणी राखिया ओर ना ई सेयो पईले ते समजी राखिया, कऊँकि माखे पता था कि तां पक्का मां साथे विश्वासघात करना ओर तेरा नाओं गर्भो ते ई पापी ए। <verse eid="ISA 48:8" /><verse number="9" style="v" sid="ISA 48:9" />ताकि लोक मेरे नाओं री स्तुति करो आऊँ देरिया ते रोष करूँआ ओर आपणी महिमा रे मुताबिक आऊँ आपू खे रोकी राखूँआ, एड़ा नि ओ कि आऊँ ताखे बाडी देऊँ। <verse eid="ISA 48:9" /><verse number="10" style="v" sid="ISA 48:10" />देख, मैं तूँ शुद्ध तो कित्तेया, पर चाँदिए जेड़ा नि; मैं तूँ दु:खो री पट्ठिया रे परखी की चूणी राखेया।<note caller="+" style="f"><char style="fr" closed="false">48:10 </char><char style="ft" closed="false">पज. 66:10, 1 पत. 1:7 </char></note> <verse eid="ISA 48:10" /><verse number="11" style="v" sid="ISA 48:11" />आपणे मुताबिक, आ आपणे ई मुताबिक मैं ये कित्तेया, मेरा नाओं अपवित्र कऊँ ठईरो? मां आपणी महिमा दूजे खे नि देणी।”<verse eid="ISA 48:11" /></para>
  <para style="s">परमेशरो इस्राएलो रे लोक छुड़ाणे</para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 48:12" />यहोवा बोलोआ, “ओ याकूब, ओ इस्राएल मेरी गल्ल सुण, मेरी तरफा खे कान लगाई की सुण! आऊँ सेईए, आऊँ ई शुरूआत ओर आऊँ ई अन्त ए। <verse eid="ISA 48:12" /><verse number="13" style="v" sid="ISA 48:13" />आ, मैं आपणे ई आथो साथे तरतिया री निऊँ पायी राखी, ओर मेरे ई दाणे आथे सर्ग फैलायी राखेया, जेबे आऊँ तिना खे बुलाऊँआ, सेयो एकी साथे दिशोए।<note caller="+" style="f"><char style="fr" closed="false">48:13 </char><char style="ft" closed="false">इब्रा. 1:10 </char></note> <verse eid="ISA 48:13" /><verse number="14" style="v" sid="ISA 48:14" />तुसे सारे के सारे कट्ठे ऊई की सुणो! तिना बीचा ते किने एकी बी इना गल्ला रे बारे दे बताया? यहोवा तेस साथे प्यार राखोआ, तेस बेबीलोनो पाँदे आपणी इच्छा पूरी करनी ओर तेसरा आथ बेबीलोनो रे लोका पाँदे पड़ना। <verse eid="ISA 48:14" /><verse number="15" style="v" sid="ISA 48:15" />मैं, आ मैं ई कुस्रू राजा बुलाई राखेया, आऊँ तेसखे ली आई रा ओर तेसरा काम सफल ऊणा। <verse eid="ISA 48:15" /><verse number="16" style="v" sid="ISA 48:16" />मेरे नेड़े आई की एसा गल्ला खे सुणो, शुरूओ ते लई की एबुए तक मैं कोई बी गल्ल गुप्त नि बोली; जदुओ ते से ऊआ तदुओ ते आऊँ तेती ए। एबे प्रभु यहोवे ओर तेसरी आत्मे आऊँ पेजीता रा।”<verse eid="ISA 48:16" /></para>
  <para style="s">आपणे लोका रिया तँईं परमेशरो री योजना</para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 48:17" />यहोवा जो ताखे छुड़ाणे वाल़ा ओर इस्राएलो रा पवित्र परमेशर ए, से ईंयाँ बोलोआ, “आऊँ ई तेरा परमेशर यहोवा ए जो ताखे तेरे फायदे रिया तँईं शिक्षा देयोआ ओर जेते बाटा दे तां जाणा ओआ, तेते ई बाटा दे ताखे लई चलूँआ। <verse eid="ISA 48:17" /><verse number="18" style="v" sid="ISA 48:18" />खरा ऊँदा जे तैं मेरिया आज्ञा त्यानो साथे सुणिया ऊँदिया! तेबे तेरी शान्ति नदिया जेड़ी ओर तेरा तर्म समुद्रो री लईरा जेड़ा ऊँदा; <verse eid="ISA 48:18" /><verse number="19" style="v" sid="ISA 48:19" />तेरा कराना ओर तेरी ल्वाद बालूए री कणियां जेड़ी ऊँदी; तिना रा नाओं मेरे सामणे ते ना कदी कठदा ओर ना मिटदा।” <verse eid="ISA 48:19" /><verse number="20" style="v" sid="ISA 48:20" />यहोवा भविष्यबक्ते रे जरीये आपणे लोका ते बोलोआ, “बाबेलो ते निकल़ी जाओ, कसदिया बीचा ते नठी जाओ; जयजयकार करी की एसा गल्ला रा प्रचार करी की सुणाओ, तरतिया रे कूणे तक एसा गल्ला री चर्चा फैलाओ; बोलदे जाओ, यहोवे आपणे दास इस्राएलो रे लोक छुड़ाईते दे ए!”<note caller="+" style="f"><char style="fr" closed="false">48:20 </char><char style="ft" closed="false">यिर्म. 90:8, 51:6, प्रका. 18:4 </char></note> <verse eid="ISA 48:20" /><verse number="21" style="v" sid="ISA 48:21" />यहोवा आपणे लोका इस्राएलिया खे रेगिस्तान देशो रे लईगा, तेबे तिना खे त्याय नि लगी; तिने तिना खे चट्टानी ते पाणी काडेया; तिने चट्टान चीरी ओर पाणी निकल़ी गा। <verse eid="ISA 48:21" /><verse number="22" style="v" sid="ISA 48:22" />पापिया खे कोई शान्ति नि ए, “यहोवे रा येई वचन ए।”<verse eid="ISA 48:22" /></para>
  <chapter eid="ISA 48" />
  <chapter number="49" style="c" sid="ISA 49" />
  <para style="s">इस्राएल, जातिया-जातिया रिया तँईं प्रयासा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 49:1" />यहोवे रा दास बोलोआ, “ओ दूर देशो रे लोको मेरी गल्ल कान लगाई की सुणो; ओर दूरो-दूरो रे राज रे लोको, त्यान लगाई की मेरी सुणो! यहोवे आऊँ गर्भो ते ई चूणी राखेया, जेबे आऊँ माया रे पेटो दे था, तेबेई तिने आऊँ आपणा दास चूणी ला दा ए।”<note caller="+" style="f"><char style="fr" closed="false">49:1 </char><char style="ft" closed="false">यिर्म. 90:8, गला. 1:15 </char></note> <verse eid="ISA 49:1" /><verse number="2" style="v" sid="ISA 49:2" />यहोवे मेरा मूँ पैनी तलवारी जेड़ा बणाया ओर तिने आऊँ आपणे आथो पीछे लकोया; तिने आऊँ चमकीला तीर बणाई की आपणे तरकशो दे गुप्त राखेया; <verse eid="ISA 49:2" /><verse number="3" style="v" sid="ISA 49:3" />यहोवे माखे बोलेया, “तूँ मेरा दास इस्राएल ए, मां तांते ओर इस्राएली लोका ते आपणी महिमा करवाणी।”<note caller="+" style="f"><char style="fr" closed="false">49:3 </char><char style="ft" closed="false">2 थिस्स. 1:10 </char></note><verse eid="ISA 49:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 49:4" />तेबे मैं आपणे आपू ते बोलेया, “मेरी मईणत बेकार ऊई, मैं आपणी सामर्थ बेकार लगाई, तेबे बी मेरा न्याय पक्का यहोवे गे ए ओर मेरी मईणता रा फल़ मेरे परमेशरो रे आथो दे ए।” <verse eid="ISA 49:4" /><verse number="5" style="v" sid="ISA 49:5" />ओर एबे यहोवे जिने आऊँ जन्मो ते ई इजी खे बणाई राखेया ताकि आऊँ तेसरा दास बणी की याकूबो खे तेसरी तरफा खे फेरी की ल्याऊँ, मतलब इस्राएलो रे लोका खे तेसगे कट्ठा करुँ, कऊँकि आऊँ यहोवे री नजरा रे आदरो जोगा ए ओर मेरा परमेशर मेरी तागत ए, <verse eid="ISA 49:5" /><verse number="6" style="v" sid="ISA 49:6" />यहोवे माखे ये बी बोलेया, “ये तो अल़्की जी गल्ल ए कि तूँ याकूबो रे गोत्रो रा उद्धार करने ओर इस्राएलो रे बचे रे लोका खे वापस ल्याऊणे खे मेरा दास बणे; मां तूँ जातिया-जातिया रे लोका खे ज्योति ठराणा, ताकि मेरा उद्धार तरतिया रे एक कनारे ते दूजे कनारे तक फैली जाओ।”<note caller="+" style="f"><char style="fr" closed="false">49:6 </char><char style="ft" closed="false">लूक. 2:32, प्रेरि. 13:47, पज. 98:2,3 </char></note> <verse eid="ISA 49:6" /><verse number="7" style="v" sid="ISA 49:7" />इस्राएलो रा पवित्र यहोवा ओर उद्धार करने वाल़ा तेस माणूंए खे जो बऊत ई त्यागेया दा ए, जेसते देश बी नफरत करोए ओर जो परदाना रा दास ए, बोलोआ, “राजेया तूँ आजाद ऊँदा ऊआ देखणा, ओर तेरी इज्जत करने खे उठणे; अधिकारिया बी ये देखणा, ओर तिना तेरी इज्जत करने खे थाले चुकणा।” ये इजी खे ऊणा कऊँकि यहोवे आपणा दास ऊणे खे चूणी राखेया; इस्राएलो रा पवित्र परमेशर आपणे वादे खे पूरा करोआ।<verse eid="ISA 49:7" /></para>
  <para style="s">यरूशलेम शईरो रा दुबारा बनाणा</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 49:8" />यहोवा ईंयाँ बोलोआ, “आपणी खुशिया रे बखते मैं तेरी सुणी, उद्धार करने रे दिने मैं तेरी मताद करी राखी; मां तेरी रक्षा करी की तूँ लोका खे एक वाचा ठराणा, ताकि देशो खे स्थिर करे ओर ऊजड़ी री जगा खे तिना रे अधिकारिया रे आथो रे देई दे”<note caller="+" style="f"><char style="fr" closed="false">49:8 </char><char style="ft" closed="false">पज. 69:13, 2 कुरि. 6:2 </char></note> <verse eid="ISA 49:8" /><verse number="9" style="v" sid="ISA 49:9" />ओर कैदिया खे बोले जेला ते निकल़ी जाओ ओर जो न्हेरे दे ए तिना खे बोलो, “आपणे आपू खे दखाओ।” तिना बाटा रे कनारे-कनारे पेट परना, सारे सूके टीलेया पाँदे बी तिना खे खाणे खे मिलणा।<note caller="+" style="f"><char style="fr" closed="false">49:9 </char><char style="ft" closed="false">लूक. 4:18 </char></note> <verse eid="ISA 49:9" /><verse number="10" style="v" sid="ISA 49:10" />गुलामिया ते वापस आऊणे वाल़े इस्राएली लोक पूखे-त्याये नि रणे, ना ई तिना खे सूरजो री गर्मी लगणी, कऊँकि से जो तिना पाँदे दया करोआ, यहोवा तिना रा अगुवा ऊणा ओर तेस सेयो पाणिए री सूबल़ा गे निणे।<note caller="+" style="f"><char style="fr" closed="false">49:10 </char><char style="ft" closed="false">प्रका. 7:16,17 </char></note> <verse eid="ISA 49:10" /><verse number="11" style="v" sid="ISA 49:11" />मां आपणे सारे पाह्ड़ तोड़ी की सीदिया बाटा बणाई देणियां ओर मां आपणे उबड़ खाबड़ राज्य रिया सड़का सीदिया करनिया। <verse eid="ISA 49:11" /><verse number="12" style="v" sid="ISA 49:12" />देखो, मेरे लोक दूरा ते आऊणे, कुछ उत्तर दिशा ते आऊणे कुछ पच्छमा ते आऊणे, कुछ सीनियों रे देशो ते आऊणे। <verse eid="ISA 49:12" /><verse number="13" style="v" sid="ISA 49:13" />ओ सर्ग जयजयकार कर, ओ तरती मगन ओ; ओ पाह्ड़ो गल़ा खोली की जयजयकार करो! कऊँकि यहोवे आपणी प्रजा खे शान्ति देई राखी ओर आपणे शरीफ लोका पाँदे दया करी राखी।<note caller="+" style="f"><char style="fr" closed="false">49:13 </char><char style="ft" closed="false">पज. 96:11-13, यिर्म. 31:13 </char></note> <verse eid="ISA 49:13" /><verse number="14" style="v" sid="ISA 49:14" />पर सिय्योने बोलेया, “यहोवे आसे छाडी ते रे, म्हारा प्रभु आसा खे पूली गा दा।” <verse eid="ISA 49:14" /><verse number="15" style="v" sid="ISA 49:15" />यहोवा सिय्योनो री शकाईता रा ज्वाब देओआ, “क्या एड़ा ऊई सकोआ कि कोई माये आपणे दूद पींदे बच्चे खे पूली जाओ ओर आपणे जमाए रे बच्चे पाँदे दया नि करो? आ, से तो पूली सकोई, पर आऊँ तुसा खे नि पूली सकदा। <verse eid="ISA 49:15" /><verse number="16" style="v" sid="ISA 49:16" />देख, मैं तेरा नाओं आपणे आथो पाँदे लिखी राखेया, आऊँ सदा तेरे बारे दे सोचदा रऊँआ। <verse eid="ISA 49:16" /><verse number="17" style="v" sid="ISA 49:17" />तेरे बच्चे तांगे वापस आई जाणे। जिने लोके तेरा शईर उजाड़ी राखेया सेयो तुसा रा शईर छाडी की जाणे लगी रे।” <verse eid="ISA 49:17" /><verse number="18" style="v" sid="ISA 49:18" />आपणी आखी चकी की चऊँ कनारे देख, तेरे लोक सारे के सारे कट्ठे ऊई की तांगे आऊणे लगी रे। यहोवे री ये बाणी ए कि मेरी जिन्दगिया री कसम, तां पक्का सेयो गईणे जेड़े पईनणे, तां लाड़िया जेड़े सेयो आपणे शरीरो रे बानी लणे।<note caller="+" style="f"><char style="fr" closed="false">49:18 </char><char style="ft" closed="false">रोम. 14:11 </char></note> <verse eid="ISA 49:18" /><verse number="19" style="v" sid="ISA 49:19" />तेरिया जो जगा सुनसाण ओर ऊजड़ी रिया ए ओर तेरे जो देश खण्डहर ई खण्डहर ए, तिना रे एबे माणूं नि रणे ओर ताखे नाश करने वाल़े तेरे दुश्मण दूर ऊई जाणे। <verse eid="ISA 49:19" /><verse number="20" style="v" sid="ISA 49:20" />तेरे बच्चे जो तांते लई ले दे तिना फेर तेरे कानो रे बोलणा, “ये जगा आसा खे छोटी ए, आसा खे रणे खे ओर जगा दे कि।” <verse eid="ISA 49:20" /><verse number="21" style="v" sid="ISA 49:21" />तेबे तां मनो रे बोलणा, “यो बच्चे मेरिया तँईं किने पैदा कित्ते? आऊँ तो बाँज ऊई गी थी, आऊँ तो बिना बच्चे री ऊई गी थी, आऊँ गुलामिया रे ओर ओरे-पोरे कूमदी रई, यो किने पाल़े? देख, आऊँ कल्ली रईगी थी; तेबे यो केई थे?” <verse eid="ISA 49:21" /><verse number="22" style="v" sid="ISA 49:22" />प्रभु यहोवा ईंयाँ बोलोआ, “देख, आऊँ आपणा आथ जातिया-जातिया रे लोका पाँदे चकूँआ ओर मां आपणा चण्डा देशा-देशा रे लोका सामणे खड़ा करना; तेबे सेयो तेरे पाऊआ खे आपणी गोदा रे लई की आऊणे ओर तेरी बेटिया खे आपणी कान्दा पाँदे चढ़ाई की तांगे आऊणे। <verse eid="ISA 49:22" /><verse number="23" style="v" sid="ISA 49:23" />राजे तेरे बच्चेया गे नौकर ओर राणिया तेरी बेटिया रिया दाईया ऊणिया। तिना आपणे नाक रगड़ी की तांगे माथा टेकणा ओर तेरे पैरा री तूड़ चाटणी। तेबे ताखे पता लगी जाणा कि आऊँ ई यहोवा ए; मेरी बाट न्याल़ने वाल़े कदी शर्मिंदा नि ऊणे।”<note caller="+" style="f"><char style="fr" closed="false">49:23 </char><char style="ft" closed="false">पज. 72:9-11, योए. 2:27 </char></note> <verse eid="ISA 49:23" /><verse number="24" style="v" sid="ISA 49:24" />क्या शेरो रे मुंओ ते कोई शकार छुड़ाई सकोआ? क्या अत्याचारी राजे रे आथो ते बन्दी छुड़ाई सकोए कदी बीनी।<note caller="+" style="f"><char style="fr" closed="false">49:24 </char><char style="ft" closed="false">मत्ती 12:29 </char></note> <verse eid="ISA 49:24" /><verse number="25" style="v" sid="ISA 49:25" />तेबे बी यहोवा ईंयाँ बोलोआ, “आ, वीरो रे बन्दी तेसते छुड़ाए जाणे ओर दुष्टो रा शिकार तेसरे आथो ते छुड़ाई लणा, कऊँकि जो तां साथे लड़ोए, तिना साथे मां आपू मुकद्दमा लड़ना ओर मां तेरे बाल-बच्चेया रा उद्धार करना। <verse eid="ISA 49:25" /><verse number="26" style="v" sid="ISA 49:26" />मां तां पाँदे अन्देर करने वाल़े आपू बीचे लड़ाई की एकी दूजे खे काणे खे मजबूर करी देणे, ओर सेयो तिना एकी दूजे खे नाश करी देणा, जेड़े नये शराबो खे पी की ओए। तेबे सबी लोका खे पता लगी जाणा कि तेरा उद्धार करने वाल़ा यहोवा ओर तेरा छुड़ाणे वाल़ा याकूबो रा शक्तिमान परमेशर आऊँ ईए।”<note caller="+" style="f"><char style="fr" closed="false">49:26 </char><char style="ft" closed="false">प्रका. 16:6 </char></note><verse eid="ISA 49:26" /></para>
  <chapter eid="ISA 49" />
  <chapter number="50" style="c" sid="ISA 50" />
  <para style="s">इस्राएलो खे तेसरे पापो री सजा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 50:1" />यहोवे इस्राएलिया ते बोलेया, “ओ मेरे पाऊओ, तुसा रिया माया रा फारगती पत्र केईया, जो मैं तेसा खे त्याग देंदे बखते दित्तेया था? या क्या तुसे सोचोए कि मैं तुसे तेस आदमिए जेड़े गुलाम बणाई की बेचीते जो आपणे बच्चेया खे गुलाम बणाई की बेची देओआ?” सुणो, तुसे आपणे ई बुरे कामो रिया बजा ते बिकी गे ओर तुसा रे पापो रिया बजा ते मैं तुसा री माये छाडी ती। <verse eid="ISA 50:1" /><verse number="2" style="v" sid="ISA 50:2" />इजी री क्या बजा ए कि जेबे आऊँ कअरे आया तेबे कोई नि मिलेया? जेबे मैं बार-बार आका पाईया, तेबे किने बी ज्वाब नि दित्तेया? क्या तुसे सोचोए कि आऊँ तुसा खे नि बचाई सकदा? क्या माँदे उद्धार करने री शक्ति नि ए? देखो, आऊँ एकी तमकिया साथे समुद्रो खे सुकाई देऊँआ, आऊँ बड़े समुद्रा खे रेगिस्तान बणाई देऊँआ; तिना रिया मछलिया पाणिए ते बिना मरी जाओईया ओर सड़ी जाओईया। <verse eid="ISA 50:2" /><verse number="3" style="v" sid="ISA 50:3" />आऊँ सर्गो खे मानो शोगो रे काल़े टाल्ले पन्याऊँआ ओर तिना रा टखण टाट<note caller="+" style="f"><char style="fr" closed="false">50:3 </char><char style="fq" closed="false">टाट </char><char style="ft" closed="false">टाट मरे दे माणूंए रे शोगो दे पईनी जाओई </char></note> बणाई देऊँआ।<verse eid="ISA 50:3" /></para>
  <para style="s">आज्ञा खे मानणे वाल़ा दास</para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 50:4" />प्रभु यहोवे माखे सिखणे वाल़ी जीब देई राखी, ताकि आऊँ थके रे लोका खे आपणे बचना साथे सम्बाल़ी सकूँ। से माखे प्यागा रोज जगाओआ ओर मेरे कान खोलोआ, ताकि आऊँ शिष्य जेड़ा सुणूँ। <verse eid="ISA 50:4" /><verse number="5" style="v" sid="ISA 50:5" />प्रभु यहोवे मेरे कान खोली राखे ओर मैं तोखा नि कित्तेया, ना ई पीछे आटेया। <verse eid="ISA 50:5" /><verse number="6" style="v" sid="ISA 50:6" />मैं कोड़ा बाणे वाल़ेया रे सामणे आपणी पीठ ओर मूछा मरोड़ने वाल़ेया रिया तरफा खे आपणी खाखा कित्तिया; मैं बेज्जत ऊणे ओर तिना रे थूकणे ते आपणा मूँ नि लकोया।<note caller="+" style="f"><char style="fr" closed="false">50:6 </char><char style="ft" closed="false">मत्ती 26:67, इब्रा. 12:2 </char></note> <verse eid="ISA 50:6" /><verse number="7" style="v" sid="ISA 50:7" />कऊँकि प्रभु यहोवा मेरी मताद करोआ, इजी बजा ते मैं शर्म नि कित्ती; बल्कि आपणा माथा चकमक पात्थरो जेड़ा काठा कित्तेया, कऊँकि माखे निश्चा था कि माखे शर्मिंदा नि ऊणा पड़ना। <verse eid="ISA 50:7" /><verse number="8" style="v" sid="ISA 50:8" />परमेशर जो माखे तर्मी मानोआ, से मेरे नेड़े ए। मां साथे केस मुकद्दमा करना? आसे आमणे-सामणे खड़ी रे। जो माणूं मेरा बिरोदी ए, से मां नेड़े आओ।<note caller="+" style="f"><char style="fr" closed="false">50:8 </char><char style="ft" closed="false">रोम. 8:33,34 </char></note> <verse eid="ISA 50:8" /><verse number="9" style="v" sid="ISA 50:9" />देखो, प्रभु यहोवा मेरी मताद करोआ; कोई बी माखे दोषी नि ठराई सकदा। देखो, मां पाँदे दोष लगाणे वाल़े सारे टाल्लेया जेड़े पुराणे ऊई जाणे; सेयो कीड़ेया खाई जाणे। <verse eid="ISA 50:9" /><verse number="10" style="v" sid="ISA 50:10" />तुसा बीचा ते कुण ए जो यहोवे रा डर मानोआ ओर तेसरे दासो रिया गल्ला सुणाओआ, जो न्हेरे दे चलोआ ओर तेसगे प्रयासा नि ओ? से यहोवे रे नाओं रा परोसा राखो ओर आपणे परमेशरो पाँदे उम्मीद लगाई की राखो। <verse eid="ISA 50:10" /><verse number="11" style="v" sid="ISA 50:11" />देखो, तुसे सारे जो आग बाल़ोए ओर आगी रे बाणा खे लको रे बानोए! तुसे सारे आपणी लगाई री आगी रे ओर आपणे बाल़े रे आगी रे बाणा बीचे आपू ई चलो। तुसा री ये दशा मां यहोवे री तरफा ते ई ऊणी, तुसे पीड़ा रे पड़े रे रणे।<verse eid="ISA 50:11" /></para>
  <chapter eid="ISA 50" />
  <chapter number="51" style="c" sid="ISA 51" />
  <para style="s">सिय्योनो खे शान्ति देणे वाल़े वचन</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 51:1" />यहोवा बोलोआ, “ओ तार्मिकता पाँदे चलणे वाल़े लोको, ओ यहोवे खे टोल़ने वाल़े लोको, कान लगाई की मेरी सुणो; जेसा चट्टानी ते तुसे खणी राखे ओर जेसा खानी ते तुसे निकयाल़ी राखे, तेते पाँदे त्यान करो। <verse eid="ISA 51:1" /><verse number="2" style="v" sid="ISA 51:2" />आपणे मूलमर्द अब्राहम ओर तेसरी लाड़ी सारा जिना रिया बजा ते तूँ आई रा तिना पाँदे त्यान देयो; जेबे से माणूं बिना बच्चेया ते कल्ला था, तदुओ ते ई मैं से बुलाया ओर आशीष दित्ती ओर बढ़ाया।”<verse eid="ISA 51:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 51:3" />यहोवे सिय्योनो खे शान्ति देई राखी, तिने तेथो रे सबी खण्डहरा खे दया करी राखी ए; तेस तेथो रे बण अदनो जेड़े ओर तेथो रे रेगिस्तान यहोवे रे बगीचे जेड़े बनाणे; तिदे खुशी, मगन, तन्यवाद ओर पजन गाणे री आवज सुणनी। <verse eid="ISA 51:3" /><verse number="4" style="v" sid="ISA 51:4" />यहोवा बोलोआ, “ओ मेरी प्रजा रे लोको, मेरिया तरफा खे त्यान करो; ओ मेरे लोको कान लगाई की सुणो; कऊँकि मां तुसा खे बिधान देणा ओर मां आपणा नियम सबी देशा रे लोका रा प्रयासा ऊणे खे स्थिर करना। <verse eid="ISA 51:4" /><verse number="5" style="v" sid="ISA 51:5" />मेरा छुटकारा नेड़े ए; मेरा उद्धार सामणे आई रा; मां आपणी सामर्था साथे देश-देशो रे लोका रा न्याय करना। दूरा-दूरा रे देश मेरे आऊणे रा इन्तजार करने लगी रे ओर तिना मेरी तागता पाँदे उम्मीद राखणी।” <verse eid="ISA 51:5" /><verse number="6" style="v" sid="ISA 51:6" />परमेशर गुलामा खे बुलाओआ, “आपणियां आखी सर्गो रिया तरफा खे चको ओर तरतिया खे देखो; कऊँकि सर्ग तुएँ जेड़ा राची जाणा, तरती टाल्लेया जेड़ी पुराणी ऊई जाणी, ओर तिदे रणे वाल़े माच्छरा जेड़े ईंयाँ ई जांदे रणे; पर जो उद्धार मां करना से सदा रणा ओर मेरे तर्मो रा अन्त नि ऊणा।” <verse eid="ISA 51:6" /><verse number="7" style="v" sid="ISA 51:7" />ओ तर्मो खे जाणने वाल़ेयो, “जिना रे मनो दे मेरे बिधान ए, तुसे कान लगाई की मेरी सुणो; माणूंआ री बेज्जतिया ते नि डरो ओर ना तिना री निन्दा करने ते तंग ओ। <verse eid="ISA 51:7" /><verse number="8" style="v" sid="ISA 51:8" />कऊँकि तिना रे बरोदी पुराणे टाल्लेया जेड़े ऊणे, ओर कीड़ा टाल्लेया खे ओर ऊना खे खाई जाओआ; पर मेरा तर्म अनन्तकालो तक ओर मेरा उद्धार पीढ़िया ते पीढ़ी बणेया रा रणा।”<verse eid="ISA 51:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 51:9" />ओ यहोवे री बां जाग! जाग ओर तागतबर ओ, जेड़ा पुराणे बखतो दे ओर बीती री पीढ़िया दे, तेड़ा ई एबे बी जागो। क्या तूँ से ई नि ए जिने रहबो रे टुकड़े-टुकड़े कित्ते ओर अजगर छेदेया? <verse eid="ISA 51:9" /><verse number="10" style="v" sid="ISA 51:10" />क्या तूँ सेई नि ए, जिने गईरा समुद्र सुकाईता ओर तेतेरी गईराईया रे आपणे छुड़ाए रे लोका खे पार जाणे खे बाट निकयाल़ी थी? <verse eid="ISA 51:10" /><verse number="11" style="v" sid="ISA 51:11" />यहोवे रे छुड़ाए रे लोक वापस ऊई की जयजयकार करदे ऊए सिय्योनो रे आऊणे ओर तिना रे सिरो पाँदे बऊत खुशी ऊणी; सेयो खुश ओर मगन ऊणे ओर दु:ख ओर रोणे रा अन्त ऊई जाणा। <verse eid="ISA 51:11" /><verse number="12" style="v" sid="ISA 51:12" />यहोवा बोलोआ, “आऊँ ई ताखे शान्ति देणे वाल़ा ए; तूँ कुण ए जो मरने वाल़े माणूंआ ते ओर काओ जेड़े मुरझाणे वाल़े माणूंआ ते डरेया, <verse eid="ISA 51:12" /><verse number="13" style="v" sid="ISA 51:13" />ओर सर्गो खे बनाणे वाल़े ओर तरतिया री निऊँ पाणे वाल़े, आपू खे बनाणे वाल़े यहोवे खे पूली गा रा, ओर जेबे बिरोदी नाश करने खे त्यार ओआ, तेबे तेसरे रोषो ते पूरा दिन लगातार थरथराओआ? पर बिरोदिये रा रोष केई रया? <verse eid="ISA 51:13" /><verse number="14" style="v" sid="ISA 51:14" />बन्दी चट ई आजाद करे जाणे; सेयो गड्डे रे नि मरने ओर ना तिना खे रोटिया री कमी ऊणी। <verse eid="ISA 51:14" /><verse number="15" style="v" sid="ISA 51:15" />जो समुद्रो खे उथल-पुथल करोआ, जेते साथे तिना री लईरा गरजोईया, से आऊँ ई तेरा परमेशर यहोवा ए, मेरा नाओ सेना रा यहोवा ए। <verse eid="ISA 51:15" /><verse number="16" style="v" sid="ISA 51:16" />मैं तेरे मुंए रे आपणे वचन पाए ओर तूँ आपणे आथो पीछे लकोई राखेया; आऊँ सर्गो खे ताणूँ ओर तरतिया री निऊँ पाऊँ ओर सिय्योनो खे बोलूँ कि तुसे मेरी‍ प्रजा ए।”<note caller="+" style="f"><char style="fr" closed="false">51:16 </char><char style="ft" closed="false">यिर्म. 31:33, इब्रा. 8:10 </char></note><verse eid="ISA 51:16" /></para>
  <para style="s">यरूशलेम शईरो रे दु:खो रा अन्त</para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 51:17" />ओ यरूशलेम जाग, जागी की उठ, खड़े ऊई जाओ, तुसे यहोवे रे आथो ते तेसरे रोषो रे कटोरे ते पी राखेया, तुसे कटोरे रा नशा करने वाल़ा शराब पूरा ई पी ला रा।<note caller="+" style="f"><char style="fr" closed="false">51:17 </char><char style="ft" closed="false">प्रका. 14:10, 1 कुरि. 15:34 </char></note> <verse eid="ISA 51:17" /><verse number="18" style="v" sid="ISA 51:18" />जितणे बच्चेया तेसते जन्म लया, तिना बीचा ते कोई नि रया जो तिना री अगुवाई करी की लई चलो ओर जितणे तेसरे बच्चे पाल़े-पोषे तिना बीचा ते कोई नि रया जो तेसरे आथो खे पकड़ो।<note caller="+" style="f"><char style="fr" closed="false">51:18 </char><char style="ft" closed="false">तेसरे शब्द यरूशलेम शईरो खे बताओआ, ये शईर एकी माया जेड़ा दशी राखेया ए, 50:1 जेसरे बऊत बच्चे ए। </char></note> <verse eid="ISA 51:18" /><verse number="19" style="v" sid="ISA 51:19" />यो दो मुसीबता तां पाँदे आई की पड़ी रिया, तां साथे कुण दु:खी ऊणा? उजाड़ ओर विनाश ओर काल़ ओर तलवार आई की पड़ी री; ताखे शान्ति केस देणी? <verse eid="ISA 51:19" /><verse number="20" style="v" sid="ISA 51:20" />तेरे बच्चे बेओश ऊई की हर एक सड़का रे मोड़ो पाँदे, महा जाल़ो दे फसे रे ईरणो जेड़े पड़ी रे; यहोवे रे रोष ओर तेरे परमेशरो रिया तमकिया री बजा ते सेयो बेओश पड़ी रे।<verse eid="ISA 51:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 51:21" />इजी बजा ते ओ यरूशलेमो रे दु:खी लोको, तुसे मेरी सुणो, तुसे केसी नशे दे तो आए, पर शराब पी की नि; <verse eid="ISA 51:21" /><verse number="22" style="v" sid="ISA 51:22" />तेरा प्रभु यहोवा जो आपणी प्रजा रा मुकद्दमा लड़ने वाल़ा तेरा परमेशर ए, से ईंयाँ बोलोआ, “सुण, आऊँ लड़खड़ाणे वाल़े शराबो रे कटोरे ते, मतलब आपणे रोषो रा कटोरा तेरे आथो ते लई लऊँआ; ताखे तिजी बीचा ते फेर कदी नि पीणा पड़ना; <verse eid="ISA 51:22" /><verse number="23" style="v" sid="ISA 51:23" />ओर मां से तिना कष्टा दे तिना रे आथो रे देणा जो ताखे दु:ख देओए, जिने ताखे बोलेया कि सयी जा, ताकि आसे तां पाँदे पैर राखी की आगे चलूँ; ओर तैं मूँदे पड़ी की आपणी पीठ जमीना दे ओर आगे चलणे वाल़ेया रिया तँईं बाट बणाई ती।”<verse eid="ISA 51:23" /></para>
  <chapter eid="ISA 51" />
  <chapter number="52" style="c" sid="ISA 52" />
  <para style="s">इस्राएलो रा उद्धार ऊणा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 52:1" />यशायाह बोलोआ, “ओ सिय्योनो रे लोको जागो! तुसे फेर सामर्थी ऊई जाओ। ओ पवित्र शईर यरूशलेम, आपणे अच्छे टाल्ले पईनी लो; कऊँकि तां बीचे बिना खतना कित्ते रे ओर अशुद्ध लोक तुसा खे सताणे फेर कदी नि आऊणे।<note caller="+" style="f"><char style="fr" closed="false">52:1 </char><char style="ft" closed="false">प्रका. 21:2,10,27 </char></note> <verse eid="ISA 52:1" /><verse number="2" style="v" sid="ISA 52:2" />आपू पाँदा ते तूड़ चाड़ी दे, ओ यरूशलेम शईरो रे लोको उठो, ओ सिय्योनो रे लोको तुसे गुलाम थे, आपणे गल़ो ते गुलामिया री जंजीर खोली दे।” <verse eid="ISA 52:2" /><verse number="3" style="v" sid="ISA 52:3" />कऊँकि यहोवा आपणे लोका ते ईंयाँ बोलोआ, “जेबे तुसे गुलाम बणे थे तो तुसा खे कोई पैसा नि दित्तेया था; तिंयाँ ई बिना पैसे देई की छुड़ाए बी जाणे।”<note caller="+" style="f"><char style="fr" closed="false">52:3 </char><char style="ft" closed="false">पज. 44:12, 1 पत. 1:18 </char></note> <verse eid="ISA 52:3" /><verse number="4" style="v" sid="ISA 52:4" />परमेशर यहोवा ईंयाँ बोलोआ, “मेरी प्रजा पईले तो मिस्रो दे परदेशी ऊई की रणे खे गई थी बादो ते अश्शूरिये बी यहोवे रे लोका पाँदे बिना बजा ते अत्याचार कित्तेया। <verse eid="ISA 52:4" /><verse number="5" style="v" sid="ISA 52:5" />इजी री खातर यहोवे री ये बाणी ए कि आऊँ एबे एती क्या करुँ जेबे कि मेरी प्रजा मुफ्त लई ली री? यहोवा ये बी बोलोआ कि जो तिना पाँदे राज करोए सेयो उड़दंग मचाणे लगी रे ओर मेरे नाओं री निन्दा लगातार पूरा दिन ऊँदी रओई।<note caller="+" style="f"><char style="fr" closed="false">52:5 </char><char style="ft" closed="false">यहे. 36:20-23, रोम. 2:24 </char></note> <verse eid="ISA 52:5" /><verse number="6" style="v" sid="ISA 52:6" />इजी बजा ते मेरिया प्रजा मेरा नाओं जाणी लणा कि जो गल्ल करोआ से यहोवा ई ए; देखो, आऊँ ईए।” <verse eid="ISA 52:6" /><verse number="7" style="v" sid="ISA 52:7" />तेसरे पैर पाह्ड़ो पाँदे कितणे ई अच्छे दिखोए, जो शुभ सन्देश सुनाणे खे ल्याओआ, जो शान्तिया री गल्ला सुणाओआ ओर कल्याणो रा शुभ सन्देश ओर उद्धारो रा सन्देस देयोआ, जो सिय्योनो खे बोलोआ, “तेरा परमेशर राजा ए।”<note caller="+" style="f"><char style="fr" closed="false">52:7 </char><char style="ft" closed="false">प्रेरि. 10:36, रोम. 10:15, नहू. 1:15 </char></note> <verse eid="ISA 52:7" /><verse number="8" style="v" sid="ISA 52:8" />सुण, तेरे शईरो पईरेदार बुलाणे लगी रे, सेयो मिली की जयजयकार करने लगी रे; कऊँकि सेयो साक्षात देखणे लगी रे कि यहोवा सिय्योनो खे वापस ऊणे लगी रा। <verse eid="ISA 52:8" /><verse number="9" style="v" sid="ISA 52:9" />ओ यरूशलेम शईरो रे खण्डहरो, मिली की खुश ऊई की जयजयकार करो; कऊँकि यहोवे आपणी प्रजा खे शान्ति देई राखी, तिने यरूशलेम छुड़ाई ला रा। <verse eid="ISA 52:9" /><verse number="10" style="v" sid="ISA 52:10" />यहोवे सारी‍ प्रजा सामणे आपणी सामर्थ दखाई राखी ओर तरतिया रे दूर-दूर देशो रे सारे लोका म्हारे परमेशरो रा कित्तेया रा उद्धार पक्का देखणा।<note caller="+" style="f"><char style="fr" closed="false">52:10 </char><char style="ft" closed="false">पज. 98:3, लूक. 3:16, 2:31-31 </char></note> <verse eid="ISA 52:10" /><verse number="11" style="v" sid="ISA 52:11" />दूर ऊई जाओ, दूर, बेबीलोनो ते निकल़ी जाओ, कोई अशुद्ध चीज नि छूँओ; तिना बीचा ते निकल़ी जाओ; ओ यहोवे रे पांडेया खे टोणे वाल़ेयो, आपू खे शुद्ध करो।<note caller="+" style="f"><char style="fr" closed="false">52:11 </char><char style="ft" closed="false">2 कुरि. 6:17, प्रका. 18:4 </char></note> <verse eid="ISA 52:11" /><verse number="12" style="v" sid="ISA 52:12" />कऊँकि तुसा खे जल्दबाजिया दे नि निकल़ना, ओर न नठदे ऊए चलणा पड़ना कऊँकि यहोवा तुसा ते आगे-आगे अगुवाई करदा ऊआ चलणा ओर इस्राएलो रा परमेशर तुसा पीछे बी रक्षा करदा ऊआ चलणा।<verse eid="ISA 52:12" /></para>
  <para style="s">परमेशरो रा सेवक कष्ट सैदा ऊआ</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 52:13" />यहोवा बोलोआ, “देखो, मेरे दासो दमाको साथे काम करना, से ऊच्चा, महान ओर बऊत महान ऊई जाणा।<note caller="+" style="f"><char style="fr" closed="false">52:13 </char><char style="ft" closed="false">यिर्म. 23:5 </char></note> <verse eid="ISA 52:13" /><verse number="14" style="v" sid="ISA 52:14" />जेड़े बऊत सारे लोक तेसखे देखी की हैरान ऊए कऊँकि तेसरी शक्ल इतणी बिगड़ी री थी कि से माणूंए जेड़ा नि लगो था ओर से माणूंआ जेड़ा बांका नि रयी गा था,<note caller="+" style="f"><char style="fr" closed="false">52:14 </char><char style="ft" closed="false">पज. 22:6,7; यशा. 53:2,3 </char></note> <verse eid="ISA 52:14" /><verse number="15" style="v" sid="ISA 52:15" />तिंयाँ ई मेरे दासो देश मेरी आराधना करने जोगा बनाणा; ओर तेसखे देखी की राजा शान्त रणे; कऊँकि तिना एड़ी गल्ल देखणी जेसरी गल्ल तिना रे सुणने रे पनि आई ओर एड़ी गल्ल तिना री समजा रे आऊणी, जो तिने एबुए तक पनि सुणी राखी थी।”<note caller="+" style="f"><char style="fr" closed="false">52:15 </char><char style="ft" closed="false">रोम. 15:21; 1 कुरि. 2:9 </char></note><verse eid="ISA 52:15" /></para>
  <chapter eid="ISA 52" />
  <chapter number="53" style="c" sid="ISA 53" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 53:1" />लोक बेबीलोनो दे गुलाम आपणे साथी यहूदिया खे बोलोए, “जो सन्देश आसा खे दित्तेया, तेतेरा परोसा किने कित्तेया? ओर यहोवे री सामर्थ केस पाँदे प्रगट ऊई?<note caller="+" style="f"><char style="fr" closed="false">53:1 </char><char style="ft" closed="false">यूह. 12:38, रोम. 10:16 </char></note> <verse eid="ISA 53:1" /><verse number="2" style="v" sid="ISA 53:2" />कऊँकि यहोवे रे सामणे लूँगा जेड़ा ओर एड़ी जड़ी जेड़ा जम्मेया जो सूकी जमीना दे फूटी की निकल़े; मेरा दास ना तो कोई सुन्दर था कि आसे तेसखे देखदे ओर ना आसा खे तेसरी एड़ी शक्ल लगी कि आसे तेसखे पसन्द करदे।<note caller="+" style="f"><char style="fr" closed="false">53:2 </char><char style="ft" closed="false">मत्ती 2:23, मर. 9:12 </char></note> <verse eid="ISA 53:2" /><verse number="3" style="v" sid="ISA 53:3" />लोक तेसखे बेकार जाणो थे ओर माणूंआ रा त्यागेया रा था; से दु:खी मर्द था, तेसरी जाण-पछयाण बमारिया ते थी ओर लोक तेसखे देखदे ई आपणा मूँ फेरी लओ थे। से तुच्छ जाणेया गया ओर आसे तेसरी एहमियत नि जाणी।<note caller="+" style="f"><char style="fr" closed="false">53:3 </char><char style="ft" closed="false">मत्ती. 9:12 </char></note> <verse eid="ISA 53:3" /><verse number="4" style="v" sid="ISA 53:4" />तिने पक्का म्हारिया बमारिया सई लिया ओर म्हारे ई दु:ख चकी ले; तेबे बी आसे से परमेशरो रा मारेया-कूटेया रा ओर बुरी दशा रे पड़ेया रा समजेया।<note caller="+" style="f"><char style="fr" closed="false">53:4 </char><char style="ft" closed="false">मत्ती 8:17, 1 पत. 2:24 </char></note> <verse eid="ISA 53:4" /><verse number="5" style="v" sid="ISA 53:5" />पर से म्हारे ई पापो रिया बजा ते कायल कित्तेया, से म्हारे पापो रे कामो रिया बजा ते दबाया; म्हारी ई शान्तिया रिया खातर तेस पाँदे ताड़ना पड़ी, ताकि तेसरे कोड़े खाणे ते आसे ठीक ऊई जाऊँ।<note caller="+" style="f"><char style="fr" closed="false">53:5 </char><char style="ft" closed="false">रोम. 4:25, 1 पत. 2:24 </char></note> <verse eid="ISA 53:5" /><verse number="6" style="v" sid="ISA 53:6" />आसे तो सारे के सारे पेडा जेड़े राची गे थे; आसा बीचा ते हर एक आपणी-आपणी बाटा दे चली रा था।<note caller="+" style="f"><char style="fr" closed="false">53:6 </char><char style="ft" closed="false">पुराणे नियमो दे पेडा रा पटकणा परमेशरो रे बिधानो रा ना मानणे वाल़े लोका खे एक सादारण बात ए, पजन. 119:176, यिर्मयाह 50:6 </char></note> ओर यहोवे आसा सबी रे पापा रा बोज आपणे दासो पाँदे लादी ता।<note caller="+" style="f"><char style="fr" closed="false">53:6 </char><char style="ft" closed="false">प्रेरि. 10:43, 1 पत. 2:25 </char></note> <verse eid="ISA 53:6" /><verse number="7" style="v" sid="ISA 53:7" />तेसखे दु:ख देंदे रये, तेबे बी से सयीन करदा रया ओर आपणा मूँ नि खोलेया; जिंयाँ पेड फाटणे रे बखते ओर ऊन कतरने रे बखते चुपचाप शान्त रओई, तिंयाँ ई से बी आपणा मूँ खोले बिना चुपचाप रया।<note caller="+" style="f"><char style="fr" closed="false">53:7 </char><char style="ft" closed="false">यूह. 1:29, मत्ती 27:12,14, मर. 15:4,5, 1 कुरि. 5:7, प्रका. 5:6,12 </char></note> <verse eid="ISA 53:7" /><verse number="8" style="v" sid="ISA 53:8" />अत्याचार करी की ओर दोष लगाई की सेयो तेसखे लईगे; तेस बखतो रे लोका बीचा ते किने बी एते पाँदे त्यान नि दित्तेया कि से जिऊँदेया बीचा ते चकी ता? मेरे ई लोका रे पापो रिया बजा ते तेस पाँदे मौता री सजा पड़ी।<note caller="+" style="f"><char style="fr" closed="false">53:8 </char><char style="ft" closed="false">प्रेरि. 8:32,33 </char></note> <verse eid="ISA 53:8" /><verse number="9" style="v" sid="ISA 53:9" />तेसरी कब्र बी दुष्टा साथे ठराई ओर मौता रे बखते से अमीरा रा साथी ऊआ, तेबे बी तिने कोई बी उपद्रव नि कित्तेया था ओर तेसरे मुंए ते कदी बी छल-कपटो री गल्ल नि निकल़ी थी।<note caller="+" style="f"><char style="fr" closed="false">53:9 </char><char style="ft" closed="false">1 कुरि. 15:3, 1 पत. 2:22, 1 यूह. 3:5, यूह. 19:38-42 </char></note> <verse eid="ISA 53:9" /><verse number="10" style="v" sid="ISA 53:10" />तेबे बी यहोवे खे ये ई अच्छा लगेया कि तेसखे केसो; तिने ई से बमार करी ता; जेबे से आपणा प्राण दोषबलि करो,<note caller="+" style="f"><char style="fr" closed="false">53:10 </char><char style="ft" closed="false">लेवी. 5:15-19 </char></note> तेबे से आपणा कुल देखी सकोआ, से बऊत दिना तक जिऊँदा रणा, तेसरे आथे यहोवे री इच्छा पूरी ऊणी। <verse eid="ISA 53:10" /><verse number="11" style="v" sid="ISA 53:11" />दासे दु:ख सईन कित्तेया ए, तेस जिंदगिया रा प्रयासा देखणा ओर खुश ऊणा, ओर तेसखे तसल्ली मिलणी; आपणे ज्ञानो रे जरीये मेरे तर्मी दासो बऊत सारे तर्मी ठराणे ओर तिना रे बुरे कामो रा बोज आपू चकी लणा।<note caller="+" style="f"><char style="fr" closed="false">53:11 </char><char style="ft" closed="false">रोम. 5:19 </char></note> <verse eid="ISA 53:11" /><verse number="12" style="v" sid="ISA 53:12" />इजी बजा ते मां तेसखे महान लोका साथे इस्सा देणा ओर तेस तागतबरा साथे लूट बाँडणी; कऊँकि तिने आपणे प्राण मौता रे तोरे करीते, से अपराधिया साथे गिणेया गया, तेबे बी तिने बऊता रे पापो रा बोज चकी ला ओर अपराधिया रिया तँईं प्रार्थना करोआ।”<note caller="+" style="f"><char style="fr" closed="false">53:12 </char><char style="ft" closed="false">मत्ती 27:38, मर. 15:27, लूक. 22:37, इब्रा. 9:28 </char></note><verse eid="ISA 53:12" /></para>
  <chapter eid="ISA 53" />
  <chapter number="54" style="c" sid="ISA 54" />
  <para style="s">सदा रिया शान्तिया री वाचा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 54:1" />ओ बेऔलाद जवाणस,<note caller="+" style="f"><char style="fr" closed="false">54:1 </char><char style="ft" closed="false">यरूशलेम शईर </char></note> तू जो पाऊआ ते बिना ए जयजयकार कर; तू, जेसा खे जो जमणे रिया पीड़ा नि ऊईया, गल़ा खोली की जयजयकार कर ओर बोल! कऊँकि छाडी रिया रे बच्चे सवागणी रे बच्चेया ते जादा ऊणे, यहोवे रा येई वचन ए।<note caller="+" style="f"><char style="fr" closed="false">54:1 </char><char style="ft" closed="false">पज. 113:9, गला. 4:27 </char></note> <verse eid="ISA 54:1" /><verse number="2" style="v" sid="ISA 54:2" />जेते तम्बूए दे तुसे रओए तिजी री जगा चौड़ी कर ओर तेरे डेरे रे फल़़े लाम्बे करे जाओ; आथ नि रोक, रस्सिया खे लाम्बा ओर खूँडिया खे मजबूत कर। <verse eid="ISA 54:2" /><verse number="3" style="v" sid="ISA 54:3" />कऊँकि तू दाँणे-खूँजे बऊत बढ़नी ओर तूँ ओर तेरे कुलो दूजे देशा दे कब्जे वाल़ी जमीन वापस लई लणी ओर तेथो रे लोक नठाणे ओर जो शईर उजड़े दे ए सेयो फेर बसाणे। <verse eid="ISA 54:3" /><verse number="4" style="v" sid="ISA 54:4" />डर नि, कऊँकि तेरी उम्मीद फेर नि टूटणी; कबरा नि, कऊँकि तू फेर शर्मिंदा नि ऊणी ओर तू उदास नि ऊणी; कऊँकि तू एक जवान लाड़िया जेड़ी आपणी बेशर्मी पूली जाणी ओर आपणी बिदुआ री बदनामी फेर याद नि करनी। <verse eid="ISA 54:4" /><verse number="5" style="v" sid="ISA 54:5" />कऊँकि ताखे बनाणे वाल़ा परमेशर तेरा लाड़ा ए, तेसरा नाओं सेना रा यहोवा ए; ओर इस्राएलो रा पवित्र परमेशर तेरा छुड़ाणे वाल़ा ए, तेसखे सारी तरतिया रा परमेशर बी बोलेया जाणा। <verse eid="ISA 54:5" /><verse number="6" style="v" sid="ISA 54:6" />कऊँकि यहोवे तूँ एड़ी बुलाई राखी, मानो तूँ छाडी री, दु:खिया ओर जवानिया दे छाडी री जवाणस ए, तेरे परमेशरो रा येई वचन ए।<verse eid="ISA 54:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 54:7" />दूई कड़िया खे ई मैं तू छाडी ती थी, पर एबे बड़ी दया करी की मां तुँ फेर राखी लणी। <verse eid="ISA 54:7" /><verse number="8" style="v" sid="ISA 54:8" />रोषो दे आई की मैं थोड़ी देरा खे तांते आपणा मूँ लकोया था, पर एबे अनन्त करूणा करी की मां तां पाँदे दया करनी, तेरे छुड़ाणे वाल़े यहोवे रा येई वादे रा वचन ए। <verse eid="ISA 54:8" /><verse number="9" style="v" sid="ISA 54:9" />ये मेरी नजरा रे नूह रे बखतो रे जलप्रलय जेड़ा ए; कऊँकि जिंयाँ मैं कसम खाई थी कि नूह रे बखतो रे जलप्रलय ते तरती फेर नि डूबणी, तेड़ी ई मैं ये कसम बी खाई कि फेर कदी तां पाँदे रोष नि करना ओर ना ताखे तमकी देणी। <verse eid="ISA 54:9" /><verse number="10" style="v" sid="ISA 54:10" />चाए पाह्ड़ अटी जाओ ओर पाह्ड़िया टल़ी जाओ, तेबे बी मेरी दया तां पाँदे ते कदी नि आटणी ओर मेरी शान्ति देणे वाल़ी वाचा नि टल़नी, यहोवा, जो तां पाँदे दया करोआ, तेसरा येई वचन ए।<verse eid="ISA 54:10" /></para>
  <para style="s">नवां यरूशलेम शईर</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 54:11" />यहोवा बोलोआ, “ओ यरूशलेम शईरो रे लोको, तुसे जो दुश्मणा रे सताए रे ए ओर जिना खे शान्ति नि मिली, सुणो, मां तुसा रे शईरो रे पात्थर कड़ी की बठयाल़ने ओर तुसा रे शईरो री निऊँ नीलमणिया साथे पाणी। <verse eid="ISA 54:11" /><verse number="12" style="v" sid="ISA 54:12" />तेरे कल़श मां माणिको साथे, तेरे शईरो रिया सारिया दवाला लालड़िया साथे ओर तेरे सारे बन्ने सुन्दर रत्नो साथे बनाणे।<note caller="+" style="f"><char style="fr" closed="false">54:12 </char><char style="ft" closed="false">प्रका. 21:18-21 </char></note> <verse eid="ISA 54:12" /><verse number="13" style="v" sid="ISA 54:13" />तेरे सारे बच्चे यहोवे रे सिखाए रे ऊणे ओर तिना खे बऊत शान्ति मिलणी।<note caller="+" style="f"><char style="fr" closed="false">54:13 </char><char style="ft" closed="false">पज. 119:165, यूह. 6:45 </char></note> <verse eid="ISA 54:13" /><verse number="14" style="v" sid="ISA 54:14" />तू तार्मिकता रे जरीये पक्की ऊणी; तू अन्देरो ते बचणी, कऊँकि ताखे डरना नि पड़ना ओर तू डरने ते बचणी, कऊँकि डरो री बजा तांगे गे नि आऊणी। <verse eid="ISA 54:14" /><verse number="15" style="v" sid="ISA 54:15" />सुण, लोका पीड़ लगाणी, पर मेरी तरफा ते नि; जितणेया लोका तुसा पाँदे अमला करना, सेयो तुसा बन्दी बणाई लणे। <verse eid="ISA 54:15" /><verse number="16" style="v" sid="ISA 54:16" />सुण, एक ल्वार कोईले री आग बाल़ी की आपणे कामो खे जरूरी अथियार बणाओआ, से मेरा ई बणाया राए। उजाड़ने खे बी मेरी तरफा ते एक नाश करने वाल़ा बणाई राखेया।<note caller="+" style="f"><char style="fr" closed="false">54:16 </char><char style="ft" closed="false">नसी. 16:4, निर्ग. 9:16, रोम. 9:22 </char></note> <verse eid="ISA 54:16" /><verse number="17" style="v" sid="ISA 54:17" />जितणे अथियार तेरे नुकशाणो खे बणाए जाओगे, तिना बीचा ते कोई सफल नि ऊणा ओर जितणे लोक दुश्मण ऊई की ताखे दोषी ठराओगे, तिना सबी ते तूँ जीती जाणा। यहोवे रे दासो रा येई इस्सा ऊणा ओर सेयो मेरी बजा ते ई जीतणे। यहोवे री येई बाणी ए।”<verse eid="ISA 54:17" /></para>
  <chapter eid="ISA 54" />
  <chapter number="55" style="c" sid="ISA 55" />
  <para style="s">परमेशरो री दया सबी माणूंआ खे</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 55:1" />यहोवा आपणे लोका खे बोलोआ, “ओ सारे त्याये लोको, पाणिए गे आओ ओर जिना गे पैसा नि ओ, तुसे बी आई की खाणा खरीदो ओर खाओ! शराब ओर दूद बिना पैसे ओर बिना दाम देई की आई की लई लो।<note caller="+" style="f"><char style="fr" closed="false">55:1 </char><char style="ft" closed="false">यूह. 7:37, प्रका. 21:6, प्रका. 22:17 </char></note> <verse eid="ISA 55:1" /><verse number="2" style="v" sid="ISA 55:2" />जो खाणे रिया चीजा नि ए, तिजी खे तुसे कऊँ पैसा लगाओए ओर जेते कि पेट नि परदा तेतेखे कऊँ मईणत करोए, मेरी तरफा खे त्यान लगाई की सुणो, तेबे खरी चीजा खाई सकोए ओर तल़ी रिया चीजा खाई की सन्तुष्ट ऊई जाणे।” <verse eid="ISA 55:2" /><verse number="3" style="v" sid="ISA 55:3" />ओ मेरे लोको, “जो कुछ आऊँ बोलूँआ त्यानो साथे सुणो ओर मांगे आओ, तेबे तुसे जिऊँदे रणे ओर मां तुसा साथे सदा री वाचा बानणी, मतलब दाऊदो पाँदली अटल़ करूणा री वाचा।<note caller="+" style="f"><char style="fr" closed="false">55:3 </char><char style="ft" closed="false">पज. 89:28, नसी. 4:20, प्रेरि. 13:34 </char></note> <verse eid="ISA 55:3" /><verse number="4" style="v" sid="ISA 55:4" />सुणो, मैं दाऊद राज्य-राज्य रे लोका खे गवाह्, ओर परदान ओर आज्ञा देणे वाल़ा ठराई राखेया।<note caller="+" style="f"><char style="fr" closed="false">55:4 </char><char style="ft" closed="false">इब्रा. 2:10, इब्रा. 5:9, प्रका. 1:5 </char></note> <verse eid="ISA 55:4" /><verse number="5" style="v" sid="ISA 55:5" />सुण, तां एड़ी जाति जेसा खे तूँ नि जाणदा बुलाणी ओर एड़ी जातिया जो ताखे नि जाणदिया तांगे दौड़ी की आऊणियां, तिना तेरे परमेशर यहोवा ओर इस्राएलो रे पवित्र परमेशरो रिया खातर ये करना, कऊँकि तिने तूँ इज्जतदार करी राखेया।” <verse eid="ISA 55:5" /><verse number="6" style="v" sid="ISA 55:6" />जदुओ तक यहोवा मिली सकोआ, तदुओ तक तेसरी टोल़ा रे रओ, जदुओ तक से तेरे नेड़े ए, तदुओ तक तेसखे आका पाओ;<note caller="+" style="f"><char style="fr" closed="false">55:6 </char><char style="ft" closed="false">प्रेरि. 17:27 </char></note> <verse eid="ISA 55:6" /><verse number="7" style="v" sid="ISA 55:7" />दुष्ट आपणा चाल-चलण ओर बुरे काम करने वाल़े आपणे सोच-बिचार छाडी की यहोवे रिया तरफा खे ई फिरो, तेस तिना पाँदे दया करनी, से म्हारे परमेशरो रिया तरफा खे फिरो ओर तेस तेसखे पूरी तरअ ते माफ करना। <verse eid="ISA 55:7" /><verse number="8" style="v" sid="ISA 55:8" />कऊँकि यहोवा बोलोआ, “मेरे बिचार ओर तुसा रे बिचार एक जेड़े नि ए, ना तुसा री बाट ओर ना मेरी बाट एक जेड़ी ए।<note caller="+" style="f"><char style="fr" closed="false">55:8 </char><char style="ft" closed="false">रोम. 11:33 </char></note> <verse eid="ISA 55:8" /><verse number="9" style="v" sid="ISA 55:9" />कऊँकि मेरी ओर तुसा री गतिया रे ओर मेरे ओर तुसा रे सोच-बिचारो दे सर्ग ओर तरतिया रा फर्क ए।” <verse eid="ISA 55:9" /><verse number="10" style="v" sid="ISA 55:10" />यहोवा बोलोआ, “जिंयाँ सर्गो ते बर्खा ओर बर्फ पड़ोआ ओर बर्फा रा पाणी बणी जाओआ, ओर सर्गो खे वापस नि ऊँदा बल्कि तरतिया पाँदे जमीना खे सिंजी की बिऊ उपजाओ आ जेते कि बाणे वाल़े खे बेजा ओर खाणे वाल़े खे रोटी मिलोई,<note caller="+" style="f"><char style="fr" closed="false">55:10 </char><char style="ft" closed="false">2 कुरि. 9:10 </char></note> <verse eid="ISA 55:10" /><verse number="11" style="v" sid="ISA 55:11" />तेड़ा ई मेरा वादे रा वचन बी ऊणा जो मेरे मुंए ते निकल़ोआ; से बेकार ठईरी की मांगे वापस नि आऊणा, पर जो मेरी इच्छा ए से तेस पूरी करनी ओर जेस कामो खे से मैं पेजी राखेया तेस से पूरा करना। <verse eid="ISA 55:11" /><verse number="12" style="v" sid="ISA 55:12" />कऊँकि तुसे बेबीलोनो ते खुशिया साथे निकल़ने ओर शान्तिया साथे पऊँछाए जाणे; तुसा ते आगे-आगे पाह्ड़ ओर पाह्ड़िया गल़ा खोली की जयजयकार करनी ओर मैदानो रे डाल़ा खुशिया रे मारे चाड़िया बजाणियां। <verse eid="ISA 55:12" /><verse number="13" style="v" sid="ISA 55:13" />तेबे कांडे-चीटा रे बदले सनौबर ओर चींआ रे डाल़ो रे बदले मईंदी जमणी ओर इजी ते यहोवे रा नाओं ऊणा, जो सदा री नशाणी ऊणी ओर कदी नि मिटणी।”<verse eid="ISA 55:13" /></para>
  <chapter eid="ISA 55" />
  <chapter number="56" style="c" sid="ISA 56" />
  <para style="s">ओरी जातिया रिया तँईं उदार</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 56:1" />यहोवा आपणे लोका ते ईंयाँ बोलोआ, “न्याय रा पालण करो ओर तर्मो रे काम करो, कऊँकि मां चट ई तुसा रा उद्धार करना ओर मेरा तर्मी ऊणा सामणे आऊणा। <verse eid="ISA 56:1" /><verse number="2" style="v" sid="ISA 56:2" />से माणूं बऊत ई तन्य ए, जो एड़ा ई करोआ ओर से माणूं जो एते पाँदे स्थिर रओआ, जो रामो रे दिनो खे पवित्र मानोआ ओर अपवित्र करने ते बचेया रा रओआ ओर आपणे आथो खे सब तरआ री बुराई करने ते रोकी राखोआ।” <verse eid="ISA 56:2" /><verse number="3" style="v" sid="ISA 56:3" />जो परदेशी यहोवे साथे मिली गे रे, सेयो ये नि बोलो, “यहोवे आसे आपणी प्रजा ते पक्का लग करने” ओर खुसरे पनि बोलो, “आसे तो सूके रे डाल़ा ए, जेसरे कोई बच्चे नि ए ओर ना ई कोई भविष्य ए।” <verse eid="ISA 56:3" /><verse number="4" style="v" sid="ISA 56:4" />कऊँकि जो खुसरे मेरे रामो रे दिनो खे मानोए ओर जेसा गल्ला ते आऊँ खुश रऊँआ, तेतेखे ई मानोए ओर मेरी आज्ञा रा पालण करोए, तिना रे बारे दे यहोवा ईंयाँ बोलोआ, <verse eid="ISA 56:4" /><verse number="5" style="v" sid="ISA 56:5" />“मां आपणे पवित्र मन्दर ओर आपणी दवाला रे पीतरे तिना खुसरेया खे जो मेरी आज्ञा मानोए एड़ा नाओं देणा जो माठे-बेटिया ते केथी अच्छा ऊणा, मां तिना रा नाओं सदा बणाया रा राखणा ओर से कदी नि मिटाया जाणा। <verse eid="ISA 56:5" /><verse number="6" style="v" sid="ISA 56:6" />परदेशी बी जो यहोवे साथे एसा इच्छा ते मिले रे ए कि तेसरी सेवा करो ओर यहोवे रे नाओं ते प्यार राखो ओर तेसरे दास ऊई जाओ, जितणे रामो रे दिनो खे अपवित्र करने ते बचे रे रओए ओर मेरी वाचा रा पालण करोए, <verse eid="ISA 56:6" /><verse number="7" style="v" sid="ISA 56:7" />सेयो मां आपणे पवित्र पाह्ड़ो पाँदे ल्याई की आपणे प्रार्थना रे मन्दरो रे खुश करने, तिना रे होमबलि ओर मेलबलि मेरी बेदिया पाँदे ग्रहण करे जाणे, कऊँकि मेरे मन्दरो खे सब देशो रे लोका खे प्रार्थना रा कअर बोलेया जाणा।”<note caller="+" style="f"><char style="fr" closed="false">56:7 </char><char style="ft" closed="false">मला. 1:11, मर. 11:17, 1 पत. 2:5 </char></note><verse eid="ISA 56:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 56:8" />परमेशर यहोवा, जिने आपणे लोक इस्राएलो दे गुलामिया ते वापस ल्याये, तिने वादा करी राखेया कि तेस ओर बी लोक तिना साथे जोड़ने।<note caller="+" style="f"><char style="fr" closed="false">56:8 </char><char style="ft" closed="false">यूह. 10:16 </char></note><verse eid="ISA 56:8" /></para>
  <para style="s">इस्राएली प्रदाना खे ताड़ना</para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 56:9" />यहोवा बोलोआ, “ओ इस्राएलो रे दुश्मणो, तुसा री सेना जो जानवरा जेड़ी ए, आओ ओर इस्राएलो खे नाश करो, खास करी की तिना रे परदाना खे। <verse eid="ISA 56:9" /><verse number="10" style="v" sid="ISA 56:10" />इस्राएलो रे परदान अन्दे ए, सेयो सारे के सारे मूर्ख ए, सेयो सारे के सारे गूँगे कुत्ते ए जो पूकी नि सकदे, सेयो सुफने देखणे वाल़े ओर लेटी की रणा ओर सऊणा पसन्द करोए।” <verse eid="ISA 56:10" /><verse number="11" style="v" sid="ISA 56:11" />सेयो लोक एड़े ए जेड़े पूखे कुत्ते ए जो कदी नि रज्जदे। सेयो गवाल़े ए, जिना रे समज नि ए, तिने सबी आपणे-आपणे फायदे खे आपणी-आपणी बाट लई राखी। <verse eid="ISA 56:11" /><verse number="12" style="v" sid="ISA 56:12" />सेयो एकी दूजे खे बोलोए, “आओ, आसे शराब ल्याऊँए, आओ शराब पी की रज्जी जाऊँए, काल का दिन बी आजके दिनो जेड़ा ई बऊत अच्छा ऊणा।”<note caller="+" style="f"><char style="fr" closed="false">56:12 </char><char style="ft" closed="false">लूक. 12:19-20, 1 कुरि. 15:32 </char></note><verse eid="ISA 56:12" /></para>
  <chapter eid="ISA 56" />
  <chapter number="57" style="c" sid="ISA 57" />
  <para style="s">इस्राएलो री मूर्तिपूजा खे गल़त ठराणा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 57:1" />नबी रोंदे ऊए बोलोआ, “जेबे तर्मी माणूं मरी जाओए ओर कोई एसा गल्ला री फिकर नि करदा; पग्त माणूं मरी जाओए, पर कोई नि समजदा। सच्चो खे ई तर्मी माणूं मरोआ ताकि आऊणे वाल़ी मुसीबता ते बची जाओ, <verse eid="ISA 57:1" /><verse number="2" style="v" sid="ISA 57:2" />से शान्तिया रे पऊँचोआ; जो सीदी चाल चलोआ, सेयो आपणे माँजे पाँदे राम करोए।” <verse eid="ISA 57:2" /><verse number="3" style="v" sid="ISA 57:3" />पर तुसे, ओ जादूगरनिया रे पाऊओ, ओ व्याभिचारी ओर व्याभिचारणिया री ल्वाद, न्याय रिया तँईं एती नेड़े आओ। <verse eid="ISA 57:3" /><verse number="4" style="v" sid="ISA 57:4" />तुसे केस पाँदे आसोए? तुसे केस पाँदे मूँ खोली की जीब निकयाल़ोए? क्या तुसे पाखण्डी ओर चूठे रे कुलो रे नि ए? <verse eid="ISA 57:4" /><verse number="5" style="v" sid="ISA 57:5" />तुसे सारे लोक आपणे तिना पवित्र डाल़ा निठे शारीरिक सम्बन्द बणाई की पैदा करने वाल़े देवतेया री पूजा करोए। ओर नाल़ेया दे ओर चट्टानी री दरारा बीचे आपणे बच्चेया खे बलिदान करोए। <verse eid="ISA 57:5" /><verse number="6" style="v" sid="ISA 57:6" />नाल़े रे चिकणे पात्थर ई तेरा इस्सा ठईरो जिना खे तुसे देवतेया रे रूपो दे पूजोए, तैं तिना खे अर्घ ओर नज्जो री बलि चढ़ाई। क्या आऊँ इना गल़त तार्मिकता रिया गल्ला ते शान्त ऊई जाऊँ? <verse eid="ISA 57:6" /><verse number="7" style="v" sid="ISA 57:7" />तैं एक बड़े ऊच्चे पाह्ड़ो पाँदे आपणा मूर्तिया खे बलिदान चढ़ाई राखेया, तूँ तेथी बलि चढ़ाणे खे चढ़ी गी। <verse eid="ISA 57:7" /><verse number="8" style="v" sid="ISA 57:8" />तैं आपणी घिनौनी मूर्तिया री नशाणी आपणे दरवाजे रे फल़ेया रे ओर देऊल़ी पीछे ई राखी; माखे छाडी की तूँ ओरी गे आपणे आपू खे दखाणे खे चढ़ी, तैं आपणा माँजा चौड़ा कित्तेया ओर तिना साथे कसम खाईली, ताखे तिना रा नांगा शरीर देखणा अच्छा लगोआ। <verse eid="ISA 57:8" /><verse number="9" style="v" sid="ISA 57:9" />तुसे आपणे इत्र ओर खुशबूदार तेल लगाओए, ओर मोलेक देवते री पूजा करने खे जाओए।<note caller="+" style="f"><char style="fr" closed="false">57:9 </char><char style="ft" closed="false">इब्रानी दे मोलेक ओर राजा एक जेड़े लगोए </char></note> तैं आपणे दूत दूर-दूर देशो खे पेजे ओर इजी तेई तुसे अधलोको तक आपू खे नीचा करी ता। <verse eid="ISA 57:9" /><verse number="10" style="v" sid="ISA 57:10" />तूँ ओरी देवतेया खे टोल़दे ऊए आपणी जादा यात्रा ऊणे रिया बजा ते थकी गी, तेबे बी तैं नि बोलेया कि ये बेकार ए; तूँ सोचे ई कि तेरी घिनौनी मूर्तिया रिया बजा ते ताखे तागत मिलोई, पर कदी नि सोचेया कि ताखे मूर्तिया री पूजा करना बन्द करी देणा चाईयो। <verse eid="ISA 57:10" /><verse number="11" style="v" sid="ISA 57:11" />यहोवा बोलोआ, “तैं केसरे डरो रे मारे मांते चूठ बोलेया ओर केसरा डर मानी की एड़ा कित्तेया कि आऊँ याद नि राखेया, ना मां पाँदे त्यान दित्तेया? क्या आऊँ बऊत बखतो ते चुप नि रया? इजी बजा ते तूँ मेरा डर नि मानदी। <verse eid="ISA 57:11" /><verse number="12" style="v" sid="ISA 57:12" />मां आपू तेरे तर्म ओर कामो रे बारे दे बताणा, पर मूर्तिया ते ताखे कोई फायदा नि ऊणा। <verse eid="ISA 57:12" /><verse number="13" style="v" sid="ISA 57:13" />जेबे तां मतादा खे मूर्तिया बुलाणियां, तेबे जो मूर्तिया तैं जमा करी राखिया, सेयो ई ताखे छुड़ाओ! सेयो सारिया अवा साथे बल्कि एक फूकरा साथे उडी जाणिया। पर जो मां पाँदे परोसा करोए सेयो एते देशो दे रणे ओर तिना मेरे मन्दरो दे मेरी आराधना करनी।”<verse eid="ISA 57:13" /></para>
  <para style="s">चंगाई ओर शान्ति</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 57:14" />यहोवा बोलोआ, “ये बोलेया जाणा, पाँति बानी-बानी की बाट साफ करो, मेरी प्रजा री बाटा ते हर एक ठोकर दूर करो।” <verse eid="ISA 57:14" /><verse number="15" style="v" sid="ISA 57:15" />जो म्हारा पवित्र परमेशर सबी ते ऊच्चे स्वर्गो दे सदा रओआ; कऊँकि महान परमेशर जो सदा जिऊँदा रओआ, जेसरा नाओं पवित्र ए, से ईंयाँ बोलोआ, “जो दु:खी ओर नम्र ए, ताकि दु:खी ओर नम्र लोका रे मनो खे खुश करुँ। <verse eid="ISA 57:15" /><verse number="16" style="v" sid="ISA 57:16" />मां सदा आपणे लोका पाँदे दोष नि लगांदे रणा, ना सदा रोषे रणा; कऊँकि आत्मा मेरिया बणाई रिया ए ओर जीव मां सामणे बेओश ऊई जाओए। <verse eid="ISA 57:16" /><verse number="17" style="v" sid="ISA 57:17" />तिना रे लाल़चो रिया बजा ते रोषे ऊई कि तेसखे दुख दित्तेया था ओर रोषो रिया बजा ते तिना ते आपणा मूँ लकोया था; पर से आपणी मर्जिया री पापो री बाटा दे दूर पटकदे चली गे थे। <verse eid="ISA 57:17" /><verse number="18" style="v" sid="ISA 57:18" />आऊँ आपणे लोका री चाल देखदा आई रा, तेबे बी एबे सेयो ठीक करने; मां सेयो लई चलणे ओर खास करी की तिना रे दु:ख करने वाल़ेया खे शान्ति देऊँगा। <verse eid="ISA 57:18" /><verse number="19" style="v" sid="ISA 57:19" />आऊँ महिमा रे गीत गाणेवाल़ेया रे मुंए खे बनाणे वाल़ा ए; यहोवे बोलेया, जो दूर ओर नेड़े ए, दुँईं खे पूरी शान्ति मिलो; ओर मा सेयो ठीक करने।<note caller="+" style="f"><char style="fr" closed="false">57:19 </char><char style="ft" closed="false">इफि. 2:13,17, रोम. 2:39, इब्रा. 13:15 </char></note> <verse eid="ISA 57:19" /><verse number="20" style="v" sid="ISA 57:20" />पर दुष्ट तो लईरांदे ऊए समुद्रो जेड़े ए जो एखी जगा नि रई सकदा ओर तेसरा पाणी मैल ओर चीकड़ उछाल़ोआ।<note caller="+" style="f"><char style="fr" closed="false">57:20 </char><char style="ft" closed="false">यहू. 1:13 </char></note> <verse eid="ISA 57:20" /><verse number="21" style="v" sid="ISA 57:21" />मेरा परमेशर बोलोआ, दुष्ट लोका खे केथी बी शान्ति नि ए।”<verse eid="ISA 57:21" /></para>
  <chapter eid="ISA 57" />
  <chapter number="58" style="c" sid="ISA 58" />
  <para style="s">ठीक ओर गल़त बअरत</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 58:1" />यहोवे भविष्यबक्ते ते बोलेया, “गल़ा खोली की आका पा, कुछ नि राख, रड़सिंगे जेड़ी ऊच्ची आवाज कर; मेरे लोका इस्राएलिया रा बरोद, मतलब याकूबो रे कराने खे तिना रे पाप बताई दे। <verse eid="ISA 58:1" /><verse number="2" style="v" sid="ISA 58:2" />सेयो हर रोज मेरे मन्दरो दे मेरी पूजा करने आओए ओर मेरी चाल जाणने री इच्छा एड़ी राखोए मानो सेयो तर्मी लोक ए जिने आपणे परमेशरो रे नियम नि टाल़े; सेयो मांते तर्मो रे नियम पूछोए ओर परमेशरो रे नेड़े आऊणे ते खुश ओए।” <verse eid="ISA 58:2" /><verse number="3" style="v" sid="ISA 58:3" />एबे सेयो लोक यहोवे ते पूछोए, “क्या बजा ए कि आसे बअरत राखी राखेया, पर तैं एतेरी सुधि नि लई? आसे दु:ख उठाया, पर तैं कोई त्यान नि दित्तेया?” यहोवा तिना ते बोलोआ, “सुणो, बअरतो रे दिने तुसे आपणी ई इच्छा पूरी करोए ओर आपणे नौकरा ते कठण काम कराओए। <verse eid="ISA 58:3" /><verse number="4" style="v" sid="ISA 58:4" />जेबे तुसे बअरत करोए तेबे पूखा रिया बजा ते लड़ाई-चगड़ा करोए ओर दुष्टता साथे मुक्केया साथे आपू बीचे मारा-मारी करोए। जे तुसे चाओए कि तुसा री प्रार्थना ऊबे स्वर्गो दे परमेशर सुणो तेबे तुसा खे बअरत ईंयाँ नि राखणा चाईए जिया तुसे आजकाल राखोए। <verse eid="ISA 58:4" /><verse number="5" style="v" sid="ISA 58:5" />जेस बअरतो ते आऊँ खुश ओऊँआ, मतलब जिदे माणूं आपू खे दीन करो, क्या तुसे एड़ा करोए? क्या सिरो खे नंगल़ो जेड़ा नपाणा, आपू निठे टाट बछाणा ओर स्वा बिखरने खे ई तुसे बअरत ओर परमेशरो खे खुश करने रा दिन बोलोए?<note caller="+" style="f"><char style="fr" closed="false">58:5 </char><char style="ft" closed="false">मत्ती 6:16, जक. 7:5 </char></note> <verse eid="ISA 58:5" /><verse number="6" style="v" sid="ISA 58:6" />जेस बअरतो ते आऊँ खुश ओऊँआ, से क्या ये नि ए कि अन्याय साथे बणाए रे दास ओर अन्देर सयीन करने वाल़ेया रा जूँगड़ा तोड़ी की सेयो छुड़ाई लणे ओर सबी जूँगड़ेया रे टुकड़े-टुकड़े करी देणे?<note caller="+" style="f"><char style="fr" closed="false">58:6 </char><char style="ft" closed="false">लूक. 4:18,19, नसी. 21:3, याकू. 1:27 </char></note> <verse eid="ISA 58:6" /><verse number="7" style="v" sid="ISA 58:7" />आऊँ चाऊँआ कि तुसे पूखे लोका साथे रोटी बाँडो, आऊँ चाऊँआ कि तुसे एड़े अनाथ ओर जो बिना कअरो रे ए, तिना खे आपणे कअरे ल्याओ, केसी खे नांगा देखी की तेसखे टाल्ले पन्याणे ओर आपणे रिश्तेदारा री मताद करने ते नि मुकरना।”<note caller="+" style="f"><char style="fr" closed="false">58:7 </char><char style="ft" closed="false">इब्रा. 13:2-3, नसी. 25:21; 28:27, मत्ती 25:35,36 </char></note> <verse eid="ISA 58:7" /><verse number="8" style="v" sid="ISA 58:8" />तेबे तेरा तेज तड़के रे प्रयासे जेड़ा चमकणा ओर तूँ फटाफट ठीक ऊई जाणा; तेरा तर्म तांते आगे-आगे चलणा, यहोवे री तागतबर उपस्थिती तां पीछे रक्षा करदी चलणी।<note caller="+" style="f"><char style="fr" closed="false">58:8 </char><char style="ft" closed="false">पज. 37:6, यिर्म. 33:6, लूक. 1:78,79 </char></note> <verse eid="ISA 58:8" /><verse number="9" style="v" sid="ISA 58:9" />तेबे तां मांते प्रार्थना करनी ओर यहोवे ज्वाब देणा, तां दुहाई देणी ओर तेस बोलणा, “आऊँ एती ए।” जे तूँ अन्देर करना, ओर दोष लगाणा ओर दुष्ट गल्ला बोलणा छाडी दे, <verse eid="ISA 58:9" /><verse number="10" style="v" sid="ISA 58:10" />पूखेया खे रोटी दे ओर शरीफ-दु:खिया खे सन्तुष्ट करे, तेबे न्हेरे दे तेरा प्रयासा चमकणा ओर तेरा अन्दकूप न्हेरा त्याड़िया रे प्रयासे जेड़ा ऊई जाणा। <verse eid="ISA 58:10" /><verse number="11" style="v" sid="ISA 58:11" />यहोवे तूँ लगातार आपू साथे चलाणा ओर जेबे अकाल़ पड़ना तेबे ताखे खाणे खे रोटी देणी ओर तेरिया आड्डिया पक्किया करनिया ओर तूँ सींजे रे बगीचे ओर एड़ी सूबल़ा जेड़ा ऊणा जेतेरा पाणी कदी नि सूकदा।<note caller="+" style="f"><char style="fr" closed="false">58:11 </char><char style="ft" closed="false">यूह. 7:38 </char></note> <verse eid="ISA 58:11" /><verse number="12" style="v" sid="ISA 58:12" />तेरे कराने रे लोका बऊत बखतो ते बेबीलोनो दे ऊजड़ी रिया जगा दे पड़ी रा फेर बसाणियां; तां कई पीढ़िया ते पड़ी रिया निऊँआ पाँदे कअर बनाणा; तेरा नाओं टूटे रे बाड़ो रा सुदारने वाल़ा ओर बाटा खे ठीक करने वाल़ा पड़ना।<verse eid="ISA 58:12" /></para>
  <para style="s">रामो रे दिनो रा पाल़न करना</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 58:13" />यहोवा बोलोआ, “जे तूँ रामो रे दिनो खे अपवित्र नि करे, मतलब मेरे तेस पवित्र दिनो रे आपणी इच्छा पूरी करने री कोशिश नि करे ओर रामो रे दिनो खे खुशिया रा दिन ओर यहोवे रा पवित्र कित्तेया रा दिन करी की माने; जे तूँ तेतेरी इज्जत करी की तेस दिने आपणी बाटा रे नि चले, आपणी इच्छा पूरी नि करे ओर आपणियां ई गल्ला नि बोले, <verse eid="ISA 58:13" /><verse number="14" style="v" sid="ISA 58:14" />तो तूँ यहोवे रिया बजा ते सुखी ऊणा ओर मां ताखे सबी ते ऊच्चे पाह्ड़ो ते राज करने देणा; मां ताखे तेरे मूलमर्द याकूबो रे इस्से री उपजा बीचा ते खुलाणा, कऊँकि यहोवे रेई मुंए ते ये वचन निकल़ी रा।”<verse eid="ISA 58:14" /></para>
  <chapter eid="ISA 58" />
  <chapter number="59" style="c" sid="ISA 59" />
  <para style="s">परमेशरो ते दूर रणा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 59:1" />भविष्यबक्ता बोलोआ, “सुणो, यहोवे रा आथ इतना छोटा नि ऊईगा कि से ताखे बचाई नि सकदा, ना ई से एड़ा टऊणा ऊईगा रा कि मतादा रिया तँईं तेरी प्रार्थना खे सुणी नि सको; <verse eid="ISA 59:1" /><verse number="2" style="v" sid="ISA 59:2" />पर तुसा रे पाप तुसा खे तुसा रे परमेशरो ते दूर करोए ओर इजी री खातर तुसा रे पापो रिया बजा ते तिने आपणा मूँ तुसा रिया प्रार्थना ते फेरी ला दा ए ताकि तेसखे सुणो नि।” <verse eid="ISA 59:2" /><verse number="3" style="v" sid="ISA 59:3" />कऊँकि तुसा रे आथ अत्या रे खूनो साथे ओर तुसा री गूठिया पापो रे कामो साथे अपवित्र ऊई गी रिया, तुसा रे मुंए ते तो चूठ ओर तुसा री जीबा ते बुरिया गल्ला निकल़ोईया। <verse eid="ISA 59:3" /><verse number="4" style="v" sid="ISA 59:4" />दूजे आदमिए रे बारे दे कोई बी आदमी सच्च नि बोलदा। लोक अदाल़ती दे एकी दूजे रे खलाफ मुकद्दमा करोए। सेयो चूठो पाँदे परोसा राखोए। सेओ एकी दूजे रे बारे दे चूठिया गल्ला बोलोए; तेसखे मानो चगड़ा करने री पीड़ ओई ओर सेयो बुराईया खे जन्म देओए। <verse eid="ISA 59:4" /><verse number="5" style="v" sid="ISA 59:5" />सेयो बुरे लोक सापो रे अण्डे पाल़ोए ओर गल़ाऊआ रे जाल़ बणाओए; जो कोई तिना रे अण्डे खाओआ, से मरी जाओआ ओर जेबे कोई एकी खे फोड़ोआ, तेबे तेते बीचा ते साप निकल़ोआ। <verse eid="ISA 59:5" /><verse number="6" style="v" sid="ISA 59:6" />गल़ाऊए रे जाल़ो रे पतल़े तागेया टाल्लेया रा काम नि करना, ना सेयो आपणे कामो साथे आपू खे टखी सकोए। कऊँकि तिना रे काम अनर्थ ई ओए ओर तिना रे आथो साथे उपद्रवो रा काम ओआ। <verse eid="ISA 59:6" /><verse number="7" style="v" sid="ISA 59:7" />एड़े लोक बुराई करने खे दौड़ोए ओर ये लोक निर्दोषो री अत्या करने खे आगे रओए, तिना री योजना बेकार ए, उजाड़ ओर नाश ई तिना री बाटा रे ए। <verse eid="ISA 59:7" /><verse number="8" style="v" sid="ISA 59:8" />एड़े लोक शान्तिया री बाट जाणदे ई नि ओर ना तिना रे बर्ताओ रे न्याय ए; तिना री बाट टेडी ए, जो कोई तिना पाँदे चलोगा, तेसखे शान्ति नि मिलणी।<note caller="+" style="f"><char style="fr" closed="false">59:8 </char><char style="ft" closed="false">रोम. 3:15-17 </char></note><verse eid="ISA 59:8" /></para>
  <para style="s">इस्राएलो रे पापो रिया बजा ते मुसीबता रा आऊणा</para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 59:9" />लोक बोलोए, “इजी बजा ते परमेशरो रा न्याय आसा ते बऊत दूर ए ओर तर्म आसा रे नेड़े नि आऊँदा; आसे प्रयासे री बाट तो देखूँए पर देखो, न्हेरा ई बणेया रा रओआ, आसे प्रयासे री उम्मीद तो लगाई राखूँए, पर अन्दकूप न्हेरे देई चलूँए।” <verse eid="ISA 59:9" /><verse number="10" style="v" sid="ISA 59:10" />आसे अन्देया जेड़ी कांद तोपुंए, आ, आसे बिना आखी रे लोका जेड़े तोपुंए; आसे दिने-दपैरे राती जेड़ी ठोकर खाऊँए, तगड़ेया बीचे आसे मुड़देया जेड़े ए। <verse eid="ISA 59:10" /><verse number="11" style="v" sid="ISA 59:11" />आसे सब बऊत दु:खी ए आसे सारे के सारे पूखे पालूए जेड़े चीगूँए ओर कूगिया जेड़े चीं-चीं करूँए, आसे न्याय री बाट तो देखूँए, पर से केथी नि ए; ओर आसे परमेशरो ते प्रार्थना करूँए कि से आसा खे अत्याचार ओर अन्याय ते बचाओ, पर से आसा ते दूर ई रओई। <verse eid="ISA 59:11" /><verse number="12" style="v" sid="ISA 59:12" />कऊँकि ओ यहोवा, म्हारे पाप परमेशरो रे सामणे बऊत ऊई रे, म्हारे पाप म्हारे खलाफ गवाई देणे लगी रे; म्हारे पाप आसा साथे ए ओर आसे आपणे बुरे काम जाणूंए। <verse eid="ISA 59:12" /><verse number="13" style="v" sid="ISA 59:13" />आसे यहोवे रा पाप करी राखेया, आसे तेसते मुकरी गे ओर आपणे परमेशरो पीछे चलणा छाडीता, आसे अन्देर करने लगे ओर उल्ट-फेरो रिया गल्ला बोलिया, आसे मनो दे चूठिया गल्ला बणाईया ओर बोली बी राखिया। <verse eid="ISA 59:13" /><verse number="14" style="v" sid="ISA 59:14" />आसे न्याय तो पीछे टाईता ओर तर्म दूर खड़ा रईगा; कऊँकि सच्चाई बजारा दे नि मिलदी ओर ईमानदारी आऊँदी नि। <verse eid="ISA 59:14" /><verse number="15" style="v" sid="ISA 59:15" />आ, सच्चाई राची गी ओर जो बुराईया ते नठोआ, से शिकार ऊई जाओआ।</para>
  <para style="s" vid="ISA 59:15">सिय्योनो रा उद्धारकर्ता</para>
  <para style="p" vid="ISA 59:15">प्रभुए ये देखी की बुरा मानेया, कऊँकि न्याय जांदा रया। <verse eid="ISA 59:15" /><verse number="16" style="v" sid="ISA 59:16" />यहोवे देखेया कि कुचल़े दे लोका री मताद करने वाल़ा कोई नि ए ओर इजी ते हैरान ऊआ कि कोई प्रार्थना करने वाल़ा नि ए; तेबे तिने आपणी सामर्था साथे ई उद्धार कित्तेया ओर आपणे तर्मी ऊणे रिया बजा ते से सम्बल़ी गा।<note caller="+" style="f"><char style="fr" closed="false">59:16 </char><char style="ft" closed="false">यहे. 22:30, इब्रा. 7:25, प्रका. 5:1-5, पज. 98:1 </char></note> <verse eid="ISA 59:16" /><verse number="17" style="v" sid="ISA 59:17" />यहोवे तर्म झिलमा जेड़ा पईनी ला ओर तेसरे सिरो पाँदे उद्धारो रा टोप राखी राखेया; तिने बदला लणे रे टाल्ले पईनी ले ओर जल़न चोगे जेड़ी पईनी ली री।<note caller="+" style="f"><char style="fr" closed="false">59:17 </char><char style="ft" closed="false">इफि. 6:14, इफि. 6:17,1 थिस्स. 5:8 </char></note> <verse eid="ISA 59:17" /><verse number="18" style="v" sid="ISA 59:18" />तेसरे दुश्मणा रे कामो रे मुताबिक यहोवे तिना खे फल़ देणा, तेस आपणे बिरोदिया पाँदे आपणा रोष पड़काणा ओर आपणे दुश्मणा खे तिना री कमाई देणी; तेस तिना लोका खे बी तिना री कमाई देई देणी जो द्वीपो रे रओए।<note caller="+" style="f"><char style="fr" closed="false">59:18 </char><char style="ft" closed="false">जक. 17:10, प्रका. 20:12,13, नहू. 1:2, प्रका. 22:12 </char></note> <verse eid="ISA 59:18" /><verse number="19" style="v" sid="ISA 59:19" />तेबे पच्छमा रिया तरफा ते लोका यहोवे रे नाओं रा ओर पूर्बो रे लोका रिया तरफा ते यहोवे री महिमा रा डर मानणा; कऊँकि जेबे दुश्मणा समुद्रो जेड़ी चढ़ाई करनी, तेबे यहोवे रे आत्मा तेसरे खलाफ आपणा चण्डा खड़ा करना।<note caller="+" style="f"><char style="fr" closed="false">59:19 </char><char style="ft" closed="false">मत्ती 8:11, लूक. 13:29, पज. 102:15-16, 113:3 </char></note> <verse eid="ISA 59:19" /><verse number="20" style="v" sid="ISA 59:20" />यहोवा आपणे लोका ते बोलोआ, “याकूबो बीचे जो पापो ते मन फिराओए तिना रिया तँईं सिय्योनो रे एक छुड़ाणे वाल़ा आऊणा, यहोवे री येई बाणी ए।”<note caller="+" style="f"><char style="fr" closed="false">59:20 </char><char style="ft" closed="false">रोम. 11:26 </char></note> <verse eid="ISA 59:20" /><verse number="21" style="v" sid="ISA 59:21" />यहोवा ईंयाँ बोलोआ, “जो वाचा मैं तेस साथे बानी राखी से ये ए कि मेरा आत्मा तां पाँदे ठईरी रा ओर आपणे वचन जो मैं तेरे मुंए रे पाई राखे आजो ते लई की सदा तक सेयो तेरे मुंए ते ओर तेरे पाऊ ओर पोतेया रे मुंए ते बी कदी नि आटणे।”<note caller="+" style="f"><char style="fr" closed="false">59:21 </char><char style="ft" closed="false">इब्रा. 10:16, रोम. 11:27 </char></note><verse eid="ISA 59:21" /></para>
  <chapter eid="ISA 59" />
  <chapter number="60" style="c" sid="ISA 60" />
  <para style="s">सिय्योनो दे परमेशरो री महिमा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 60:1" />ओ यरूशलेम शईरो रे लोको, उठो, सामर्था साथे परी जाओ; ओर यहोवे रा वैभव तुसा पाँदे उदय ऊई रा।<note caller="+" style="f"><char style="fr" closed="false">60:1 </char><char style="ft" closed="false">इफि. 5:14 </char></note> <verse eid="ISA 60:1" /><verse number="2" style="v" sid="ISA 60:2" />देखो आज तरतिया पाँदे तो न्हेरा ओर राज्य-राज्य रे लोका पाँदे अन्दकूप न्हेरा छायी रा; पर तुसा पाँदे यहोवे रा प्रकाश ऊणा ओर तेसरे उपस्थित ऊणे री चमक तुसा पाँदे प्रगट ऊणी।<note caller="+" style="f"><char style="fr" closed="false">60:2 </char><char style="ft" closed="false">यूह. 1:14, प्रका. 21:23 </char></note> <verse eid="ISA 60:2" /><verse number="3" style="v" sid="ISA 60:3" />तेस बखते सारे देशो रिया जातिया-जातिया रे लोक ओर राजा तुसा पाँदे ऊए रे नवें दिनो री शुरूआत देखणे आऊणे।<note caller="+" style="f"><char style="fr" closed="false">60:3 </char><char style="ft" closed="false">प्रका. 21:24 </char></note> <verse eid="ISA 60:3" /><verse number="4" style="v" sid="ISA 60:4" />आपणे चऊँ कनारे देख कि क्या ऊणे लगी रा; तेरे चऊँ कनारे सेयो सारे के सारे कट्ठे ऊई की तांगे आऊणे लगी रे; तेरे पाऊ दूरा ते आऊणे लगी रे ओर तेरी बेटिया आथो-आथ पऊँचाईया जाणे लगी रिया। <verse eid="ISA 60:4" /><verse number="5" style="v" sid="ISA 60:5" />तेबे तुसा ये देखणा ओर तुसा रा मूँ चमकणा, तुसा रा मन डरी जाणा ओर खुशिया साथे परी जाणा; कऊँकि समुद्रो रा सारा तअन ओर जातिया-जातिया री सारी सम्पत्ति तुसा खे मिलणी।<note caller="+" style="f"><char style="fr" closed="false">60:5 </char><char style="ft" closed="false">यिर्म. 33:9, योए. 2:26, यशा. 61:6 </char></note> <verse eid="ISA 60:5" /><verse number="6" style="v" sid="ISA 60:6" />तेरे देशो रे ऊँटा रे चूण्ड ओर मिद्यान ओर एपा देशो रिया साँड़णिया कट्ठिया ऊणिया; शेबा जगा रे सारे लोका आई की सूईना ओर लोबान पेंट ल्याऊणी ओर लोका यहोवे री महिमा खुशिया साथे सुनाणी।<note caller="+" style="f"><char style="fr" closed="false">60:6 </char><char style="ft" closed="false">पज. 72:10, मत्ती 2:11 </char></note> <verse eid="ISA 60:6" /><verse number="7" style="v" sid="ISA 60:7" />केदार जगा रिया सब पेडा-बाकरिया कट्ठिया ऊई की तेरिया ऊई जाणिया, नबायोत जगा रे खाडू तेरी सेवा करने रे कामे आऊणे; सेयो मेरी बेदिया पाँदे ग्रहण करे जाणे ओर मां आपणा सुन्दर मन्दर ओर बी प्रतापी करी देणा।<note caller="+" style="f"><char style="fr" closed="false">60:7 </char><char style="ft" closed="false">मत्ती 21:13 </char></note> <verse eid="ISA 60:7" /><verse number="8" style="v" sid="ISA 60:8" />इना लोका खे देखो! ये तेरे नेड़े एड़े छोड़ आऊणे लगी रे जो बादल़ो जेड़े ओर आपणे कोलेया री तरफा खे उडदे ऊए कबूतरो जेड़े आऊणे लगी रे? <verse eid="ISA 60:8" /><verse number="9" style="v" sid="ISA 60:9" />जरूर द्वीपा रे लोका मेरी ई बाट देखणी पईले तो तर्शीश शईरो रे जाह्ज दूर देशो ते सूईने-चाँदिए समेत तुसा रे माठे बेटिया ल्याऊणे परमेशर यहोवा मतलब इस्राएलो रे पवित्र परमेशरो रे नाओं रिया खातर दूरा ते पऊँचाओ, कऊँकि तिने तूँ इज्जतदार करी राखेया। <verse eid="ISA 60:9" /><verse number="10" style="v" sid="ISA 60:10" />यहोवा यरूशलेमो रे लोका खे बोलोआ, “परदेशी लोका तुसा री दवाल चकणी ओर तिना रे राजेया तुसा री सेवा टईल करनी; कऊँकि मैं गुस्से दे आई की तुसा खे दु:ख दित्तेया था, पर एबे तुसा ते खुश ऊई की तुसा पाँदे दया करी राखी। <verse eid="ISA 60:10" /><verse number="11" style="v" sid="ISA 60:11" />तुसा रे शईरो रे बड़े द्वार सदा खुले दे रणे; सेयो रात-दिन कदी बी बन्द नि करे जाणे जेते कि जातिया-जातिया री तअन-सम्पत्ति ओर तिना रे राजा बन्दी ऊई की तुसा गे पऊँचाए जाओ।<note caller="+" style="f"><char style="fr" closed="false">60:11 </char><char style="ft" closed="false">प्रका. 21:24,26 </char></note> <verse eid="ISA 60:11" /><verse number="12" style="v" sid="ISA 60:12" />कऊँकि जेसा जातिया रे ओर राज रे लोक तुसा री सेवा नि करोगे सेयो नाश ऊई जाणे, आ एड़िया जातिया पूरी तरअ ते नाश ऊई जाणिया। <verse eid="ISA 60:12" /><verse number="13" style="v" sid="ISA 60:13" />लबानोनो रे जंगल़ो रा वैभव मतलब सनौबर ओर देवदार ओर चीला रे डाल़ एक साथे तांगे आऊणे ताकि मेरे मन्दरो खे सजाओ ओर मां आपणे पैरा री जगा खे महिमा देणी।” <verse eid="ISA 60:13" /><verse number="14" style="v" sid="ISA 60:14" />सेओ ई लोक जो पईले तुसा खे दु:ख देया करो थे तां सामणे सिर चुकाई की आऊणे ओर जिने तुसा री बेज्जती कित्ती, सबी तुसा रे पैरा पाँदे पड़ी की माथा टेकणा; तिना तुसा रा नाओं यहोवे रा शईर, इस्राएलो रे पवित्र परमेशरो रा सिय्योन राखणा। <verse eid="ISA 60:14" /><verse number="15" style="v" sid="ISA 60:15" />तुसे जो बेज्जत कित्ते ओर घृणित ठईरे, एथो तक कि कोई बी तुसा रे शईरो रे ऊई की नि जाओ था, इजी रे बदले मां तुसे सदा रे कमण्ड ओर पीढ़िया-पीढ़िया री खुशिया री बजा ठराणे। <verse eid="ISA 60:15" /><verse number="16" style="v" sid="ISA 60:16" />देशा ओर राजेया तेरी देखपाल़ करनी, ता राजेया रिया छातिया चुशणीया ओर तुसा खे पता लगी जाणा कि आऊँ यहोवा तुसा रा उद्धार करने वाल़ा ओर तेरा छुड़ाणे वाल़ा, याकूबो रा सर्वशक्‍तिमान परमेशर ए। <verse eid="ISA 60:16" /><verse number="17" style="v" sid="ISA 60:17" />मां पीतल़ी रे बदले सूईना, लोए रे बदले चाँदी, लकड़िया रे बदले पीतल़ ओर पात्थरो रे बदले लोआ ल्याऊणा। मां तुसा रे परदान मेल-मिलाप ओर तेरे सरदार धार्मिकता ठराणे। <verse eid="ISA 60:17" /><verse number="18" style="v" sid="ISA 60:18" />तुसा रे देशो रे फेर कदी उपद्रव ओर तुसा रे बन्ने रे पीतरे उत्पाद या अन्देरो री चर्चा नि सुणनी; पर तुसा आपणी दवाला रा नाओं उद्धार ओर आपणे शईरो रे बड़े द्वारा रा नाओं यश राखणा। <verse eid="ISA 60:18" /><verse number="19" style="v" sid="ISA 60:19" />तेबे दिने तुसा खे सूरजो प्रयासा नि देणा ओर ना राती चाँदो चाँदणी देणी, पर यहोवे तुसा खे सदा रा प्रयासा ओर तुसा रा परमेशर तुसा री शोभा ठईरना।<note caller="+" style="f"><char style="fr" closed="false">60:19 </char><char style="ft" closed="false">प्रका. 21:123, प्रका. 22:5 </char></note> <verse eid="ISA 60:19" /><verse number="20" style="v" sid="ISA 60:20" />तुसा रा सूरज फेर कदी नि डूबणा ओर ना तुसा रे चाँदो री चाँदणी काल़ी ऊणी; कऊँकि यहोवा तुसा री सदा री जोति ऊणी ओर तुसा रे दु:खो रे दिन खत्म ऊई जाणे। <verse eid="ISA 60:20" /><verse number="21" style="v" sid="ISA 60:21" />तुसा रे सारे के सारे लोक तर्मी ऊणे; सेयो सदा देशो रे अधिकारी रणे। सेयो मेरे लगाए रे पौधे ओर मेरे आथो रा काम ठईरने, जेते कि मेरी महिमा प्रगट ओ।<note caller="+" style="f"><char style="fr" closed="false">60:21 </char><char style="ft" closed="false">प्रका. 21:27, इफि. 2:10, 2 पत. 3:13 </char></note> <verse eid="ISA 60:21" /><verse number="22" style="v" sid="ISA 60:22" />छोटे ते छोटा 1,000 ऊई जाणा ओर सबी ते कमजोर एक सामर्थी जाति बणी जाणा। आऊँ यहोवा ए; जेबे ठीक बखत आऊणा, तेबे ये फटाफट पूरा करना।<verse eid="ISA 60:22" /></para>
  <chapter eid="ISA 60" />
  <chapter number="61" style="c" sid="ISA 61" />
  <para style="s">उद्धारो रा शुभ सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 61:1" />भविष्यबक्ता यशायाह बोलोआ, “परमेशर यहोवे रा आत्मा मां पाँदे ए, कऊँकि यहोवे शुभ सन्देश सुनाणे खे मेरा अभिषेक कित्तेया ओर आऊँ इजी खे पेजी राखेया ताकि दु:खी मनो रे लोका खे शान्ति देऊँ ओर गुलामा खे आजादिया रा ओर कैदिया खे छुटकारे रा प्रचार करुँ।<note caller="+" style="f"><char style="fr" closed="false">61:1 </char><char style="ft" closed="false">मत्ती 11:5, प्रेरि. 10:38, मत्ती 5:3, प्रेरि. 26:18, लूक. 4:18 </char></note> <verse eid="ISA 61:1" /><verse number="2" style="v" sid="ISA 61:2" />ताकि यहोवे रे खुश रणे रे सालो रा ओर म्हारे परमेशरो रे बदला लणे रे दिनो रा प्रचार करुँ; ताकि सब दु:ख करने वाल़ेया खे शान्ति देऊँ।<note caller="+" style="f"><char style="fr" closed="false">61:2 </char><char style="ft" closed="false">लूक. 4:18,19, मत्ती 5:4 </char></note> <verse eid="ISA 61:2" /><verse number="3" style="v" sid="ISA 61:3" />ओर सिय्योनो रे दु:ख करने वाल़े लोका रे सिरो पाँदली दु:खो री स्वा दूर करी की सुन्दर पगड़ी बानूँ, ताकि तिना रा दु:ख दूर करी की खुशिया रा तेल लगाऊँ ओर तिना री उदासी दूर करी की यशो रा टखण टखाऊँ; जेते कि तिना खे तर्मो रे बाँजो रे डाल़ ओर यहोवे रे लगाए रे बोलेया जाओ ओर जेते कि तिना रा आदर प्रगट ओ।”<note caller="+" style="f"><char style="fr" closed="false">61:3 </char><char style="ft" closed="false">पज. 45:7; 30:11; लूक. 6:21 </char></note> <verse eid="ISA 61:3" /><verse number="4" style="v" sid="ISA 61:4" />तेस बखते यहूदा रे लोका सौ साल पईले बेबीलोनो रे लोका रे जरीये बर्बाद कित्ते दे शईर फेर बनाणे, पुराणे बखतो ते पड़े रे खण्डहरो रे फेर कअर बनाणे; उजड़े रे शईर जो पीढ़िया-पीढ़िया ते उजड़े रे सेओ फेर नये सिरे ते बसाणे। <verse eid="ISA 61:4" /><verse number="5" style="v" sid="ISA 61:5" />परदेशी आई की खड़े ऊणे ओर तुसा रिया पेडा-बाकरिया चराणिया ओर विदेशी लोका तुसा रे डोरूआ रे अल़ चलाणे ओर अंगूरा रे बगीचेया रे माली ऊणे; <verse eid="ISA 61:5" /><verse number="6" style="v" sid="ISA 61:6" />पर तुसा खे यहोवे रे पुरोईत बोलेया जाणा; तिना तुसा खे म्हारे परमेशरो रे सेवक बोलेया करना ओर तुसा जातिया-जातिया री तअन-सम्पत्ति खाया करनी, तिना री वैभवो रिया चीजा पाई की तुसा बडयाईया करेया करनिया।<note caller="+" style="f"><char style="fr" closed="false">61:6 </char><char style="ft" closed="false">1 पत. 2:5,9; प्रका. 1:6; प्रका. 5:10 </char></note> <verse eid="ISA 61:6" /><verse number="7" style="v" sid="ISA 61:7" />तुसा री बेज्जतिया रे बदले दो गुणा आशिर्वाद मिलणा, अनादरो रे बदले तुसा आपणे इस्से रिया बजा ते जयजयकार करनी; तुसे आपणे देशो रे दो गुणे इस्से रे अधिकारी ऊणे ओर सदा खुश रणे। <verse eid="ISA 61:7" /><verse number="8" style="v" sid="ISA 61:8" />यहोवा बोलोआ, “कऊँकि आऊँ यहोवा न्याय साथे प्यार राखूँआ, आऊँ अन्याय ओर चोरिया ते नफरत करूँआ; इजी री खातर मां आपणी सच्चाईया ते आपणे लोका खे वादा कित्तेया रा ईनाम देणा। <verse eid="ISA 61:8" /><verse number="9" style="v" sid="ISA 61:9" />तिना रा वंश जातिया-जातिया बीचे ओर तिना री ल्वाद देशो-देशो रे लोका बीचे मशूर ऊणी; हर कोई आदमी जितणेया सेयो देखणे, पछयाणी लणे कि ये से कराना ए जिना खे यहोवे आशीष देई राखी। <verse eid="ISA 61:9" /><verse number="10" style="v" sid="ISA 61:10" />आऊँ यहोवे रिया बजा ते बऊत खुश ऊणा, मेरे प्राण परमेशरो रिया बजा ते खुश रणे; कऊँकि यहोवे माखे उद्धारो रे टाल्ले पन्याए ओर तर्मो री चाद्दर एड़ी टखाई ती जेड़ा लाड़ा फूला री माल़ा साथे आपू खे सजाओआ ओर लाड़ी आपणे गईणेया साथे आपणा श्रृंगार करोई।<note caller="+" style="f"><char style="fr" closed="false">61:10 </char><char style="ft" closed="false">इब्रा. 3:18, रोम. 5:11, प्रका. 19:7-8 </char></note> <verse eid="ISA 61:10" /><verse number="11" style="v" sid="ISA 61:11" />कऊँकि जिंयाँ जमीन आपणी फसल जमाओई ओर बगीचे रे जो कुछ बाया जाओआ, से तिजी खे जमाओई, तिंयाँ ई परमेशर यहोवा सबी जातिया सामणे धार्मिकता ओर तन्यवाद बढ़ाणा।”<verse eid="ISA 61:11" /></para>
  <chapter eid="ISA 61" />
  <chapter number="62" style="c" sid="ISA 62" />
  <para style="s">सिय्योनो रे उद्धारो रा परोसा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 62:1" />भविष्यबक्ता बोलोआ, “सिय्योनो रे बारे दे मां चुप नि रणा ओर यरूशलेम शईरो रे बारे दे मां चैना दे नि रणा, जदुओ तक कि तिना री तार्मिकता प्रयासे जेड़ी ओर तिना रा उद्धार बल़ी रे हुल़े जेड़ा नि दिशेया। <verse eid="ISA 62:1" /><verse number="2" style="v" sid="ISA 62:2" />ओ यरूशलेम, तेबे जातिया-जातिया रे लोका तुसा रा तर्म ओर सबी राजेया तुसा दे मेरी महिमा देखणी ओर तेरा एक नया नाओं राखेया जाणा जो यहोवे रे मुंए ते निकल़ना।<note caller="+" style="f"><char style="fr" closed="false">62:2 </char><char style="ft" closed="false">प्रका. 2:17, प्रका. 3:12 </char></note> <verse eid="ISA 62:2" /><verse number="3" style="v" sid="ISA 62:3" />तुसे यहोवे रे आथो दे एक सुन्दर मुकुट ओर आपणे परमेशरो रे आथो दे राजमुकुट ठईरने। <verse eid="ISA 62:3" /><verse number="4" style="v" sid="ISA 62:4" />तुसा खे फेर त्यागे रे नि बोलेया जाणा ओर तुसा री जमीना खे फेर ऊजड़ी री नि बोलेया जाणा; पर तुसा खे हेप्सीबा<note caller="+" style="f"><char style="fr" closed="false">62:4 </char><char style="fq" closed="false">हेप्सीबा </char><char style="ft" closed="false">परमेशरो री खुशिया रा शईर </char></note> ओर तुसा री जमीना खे ब्यूला बोलेया जाणा; कऊँकि यहोवा तुसा ते खुश ए ओर तुसा री जमीन सवागण रणी। <verse eid="ISA 62:4" /><verse number="5" style="v" sid="ISA 62:5" />कऊँकि जिया जवान मर्द एक कुआँरिया खे ब्याई लओआ, तिया ई तेरे पाऊआ तू ब्याई लणी, ओर जिंयाँ लाड़ा आपणी लाड़िया ते खुश ओआ, तिंयाँ ई तेरा परमेशर तेरी बजा ते खुश ऊणा। <verse eid="ISA 62:5" /><verse number="6" style="v" sid="ISA 62:6" />ओ यरूशलेम शईरो रे लोको, मैं तुसा री शईरो री दवाला पाँदे पईरेदार बठयाल़ी राखे; सेयो रात-दिन कदी चुप नि रणे। ओ यहोवे खे याद करने वाल़ेयो, चुप नि रओ,<note caller="+" style="f"><char style="fr" closed="false">62:6 </char><char style="ft" closed="false">यहे. 3:17-21, इब्रा. 13:17 </char></note> <verse eid="ISA 62:6" /><verse number="7" style="v" sid="ISA 62:7" />ओर जदुओ तक यहोवा यरूशलेम शईरो खे स्थिर करी की तेसरी तारीफ पूरी तरतिया रे नि फैलायी देयोगा, तदुओ तक तेसखे बी चैन नि लणे दे। <verse eid="ISA 62:7" /><verse number="8" style="v" sid="ISA 62:8" />यहोवे आपणे दाँणे आथो री ओर आपणी बाई री तागता री कसम खाई राखी, मां पक्का आऊणे वाल़े बखतो रे तेरा नज्ज एबे फेर तेरे दुश्मणा खे खाणे खे नि देणा ओर परदेशिया रे पाऊआ तुसा रा नया शराब जेतेरिया तँईं तुसे मईणत करी राखी, पी नि सकणे; <verse eid="ISA 62:8" /><verse number="9" style="v" sid="ISA 62:9" />बस सेयो ई खाई सकोए, जिने से पण्डारा रे राखी राखेया, तिना तेते बीचा ते खाई की यहोवे री स्तुति करनी ओर जिने शराब पण्डारो रे राखी राखेया ओ, सेयो ई तेतेखे मेरे मन्दरो रे आँगणो रे पी सकणे। <verse eid="ISA 62:9" /><verse number="10" style="v" sid="ISA 62:10" />यरूशलेम शईरो रे लोको, जाओ, बड़े द्वारो रिये बारे जाओ, तुसा रे वापस आऊणे वाल़े लोका खे बाट सुदारो, सड़का सुदारी की ऊच्चिया करो, तेते बीचा ते पात्थर चूगी-चूगी की सेटी देयो, देश-देशो रे लोका खे बाट टोल़ने दे मताद करने खे एक चण्डा खड़ा करो। <verse eid="ISA 62:10" /><verse number="11" style="v" sid="ISA 62:11" />देखो, यहोवे तरतिया रे कूणे तक एसा आज्ञा रा प्रचार करी राखेया: सिय्योनो रे लोका खे बोलो, देखो, तुसा रा उद्धार करने वाल़ा आऊणे लगी रा, देखो, जो मजदूरी तेसखे देणी, से तेसगे ए ओर तेसरा काम तेस सामणे ए।”<note caller="+" style="f"><char style="fr" closed="false">62:11 </char><char style="ft" closed="false">मत्ती 21:5, प्रका. 22:12 </char></note> <verse eid="ISA 62:11" /><verse number="12" style="v" sid="ISA 62:12" />ओर लोका यहूदा रे लोका खे पवित्र प्रजा ओर यहोवे रे छुड़ाए रे बोलणा ओर तुसा रे शईरो रा नाओं ग्रहण कित्ती री, मतलब ना छाडी रा शईर पड़ना।<verse eid="ISA 62:12" /></para>
  <chapter eid="ISA 62" />
  <chapter number="63" style="c" sid="ISA 63" />
  <para style="s">परमेशरो रा न्याय ओर उद्धार</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 63:1" />पईरेदारो रे रूपो दे नबी पूछोआ, “ये कुण ए जो एदोम देशो रे बोस्रा शईरो ते लाल टाल्ले पईनी की आऊणे लगी रा, जो बऊत तागतबर ओर सुन्दर टाल्ले पईनी की मजे दे आऊणे लगी रा?” यहोवे ज्वाब दित्तेया, “ये आऊँ ईए यहोवा, जो तर्मो साथे बोलोआ ओर उद्धार करने री शक्ति राखोआ।” <verse eid="ISA 63:1" /><verse number="2" style="v" sid="ISA 63:2" />भविष्यबक्ता यहोवे ते पूछोआ, “तेरे टाल्ले लाल कऊँ ए? क्या बजा ए कि तेरे टाल्ले अऊदो रे अंगूर केसणे वाल़ेया जेड़े ए?” <verse eid="ISA 63:2" /><verse number="3" style="v" sid="ISA 63:3" />यहोवे ज्वाब दित्तेया, “मैं तो कल्ले ई अऊदो रे अंगूर केसी राखे ओर देशो रे लोका बीचा ते किने बी मेरा साथ नि दित्तेया; आ, मैं रोषो दे आई की सेयो केसी ते ओर जल़ी-फूखी की सेयो फड़ाके; तिना रे खूनो रे छीटे मेरे टाल्लेया पाँदे पड़ी रे, जेते कि मेरे सारे टाल्लेया दे तब्बे लगी गे रे।<note caller="+" style="f"><char style="fr" closed="false">63:3 </char><char style="ft" closed="false">प्रका. 19:15, प्रका. 14:20 </char></note> <verse eid="ISA 63:3" /><verse number="4" style="v" sid="ISA 63:4" />कऊँकि मेरे मनो दे सई न्याय करी की सजा देणे रा बखत था ओर यहूदा रे आपणे लोका खे बचाणे रा साल आई गा रा। <verse eid="ISA 63:4" /><verse number="5" style="v" sid="ISA 63:5" />मैं ओर-पोरे टोल़ेया, पर कोई मेरी मताद करने वाल़ा नि दिशेया; माखे हैरानी बी ऊई कि कोई सम्बाल़ने वाल़ा नि था; तेबे मैं आपणी ई सामर्था साथे उद्धार कित्तेया ओर मेरी जल़ने ई आऊँ सम्बाल़ेया। <verse eid="ISA 63:5" /><verse number="6" style="v" sid="ISA 63:6" />आ, मैं रोषो रे आई की देश-देशो रे लोको खे सजा दित्ती आपणी जल़ना ते मैं सेयो मतवाल़े करीते ओर तिना रा खून जमीना दे बाह्यी ता।”<verse eid="ISA 63:6" /></para>
  <para style="s">इस्राएलो साथे कित्ती री पलाई</para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 63:7" />मां ए बताणा कि यहोवा दया करने वाल़ा ए ओर मां यहोवे री स्तुति करनी याद राखणी, मतलब इस्राएलो रे कराने पाँदे दया ओर बऊत करूणा करी की तिने आसा साथे जितणी पलायी करी राखी, तिना सबी रे मुताबिक मां यहोवे रिया करूणा रे कामो रा ओर तेसरा गुणगाण करना। <verse eid="ISA 63:7" /><verse number="8" style="v" sid="ISA 63:8" />यहोवे बोलेया था, “इस्राएली मेरी प्रजा रे लोक ए, एड़े बाल़क ए इना कदी बी तोखा नि देणा; ओर से तिना रा उद्धार करने वाल़ा ऊईगा। <verse eid="ISA 63:8" /><verse number="9" style="v" sid="ISA 63:9" />तिना री सारी मुसीबता रे तेसखे बी कष्ट ऊआ ओर तेस सामणे रणे वाल़े दूते तिना रा उद्धार कित्तेया; प्यार ओर नरमाईया साथे तिने आपू ई सेयो छुड़ाए; तिने सेयो चके ओर बऊत बखतो ते सदा तिना खे लई की चलेया। <verse eid="ISA 63:9" /><verse number="10" style="v" sid="ISA 63:10" />तेबे बी इस्राएलिये बगावत कित्ती ओर यहोवे री पवित्र आत्मा दु:खी कित्ती; इजी बजा ते से बदली की तिना रा दुश्मण ऊईगा ओर आपू ई तिना साथे लड़ने लगेया।”<note caller="+" style="f"><char style="fr" closed="false">63:10 </char><char style="ft" closed="false">प्रेरि. 7:51, इफि. 4:30 </char></note> <verse eid="ISA 63:10" /><verse number="11" style="v" sid="ISA 63:11" />तेबे परमेशरो रे लोका खे तिना रे पुराणे दिन, मतलब मूसे रे दिन याद आए, सेयो बोलणे लगे, “जो आपणी पेडा खे तिना रे ग्वाल़ेया समेत समुद्रो ते निकयाल़ी की ल्याया से केयी ए? जिने तिना बीचे आपणा पवित्र आत्मा पाया, से केयी ए? <verse eid="ISA 63:11" /><verse number="12" style="v" sid="ISA 63:12" />यहोवे आपणी प्रतापी सामर्थ मूसे रे दाँणे आथो साथे करी ती, यहोवे तिना सामणे लाल समुद्रो रे पाणिए रे पार जाणे खे दो इस्से करी की आपणा सदा रा नाओं करी ता, <verse eid="ISA 63:12" /><verse number="13" style="v" sid="ISA 63:13" />जो तिना खे डूगे समुद्रो ते लई चलेया; जिंयाँ कोड़ेया खे उजाड़ जगा दे, तिंयाँ ई तिना खे बी ठोकर नि लगी, से केयी ए? <verse eid="ISA 63:13" /><verse number="14" style="v" sid="ISA 63:14" />जिंयाँ करेलू डांगर तराईया रे उतरी जाओआ, तिंयाँ ई यहोवे री आत्मे तिना खे राम दित्तेया। इजी बजा ते तैं आपणी प्रजा री अगुवाई कित्ती ताकि आपणा नाओ महिमा साथे फरेया रा बणाओ।”<verse eid="ISA 63:14" /></para>
  <para style="s">इस्राएलो री प्रार्थना</para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 63:15" />ओ यहोवा तू स्वर्गो ते, जो तेरी पवित्र ओर महिमा साथे परी री रणे री जगा ए, देख। तेरी जल़न ओर पराक्रम केई रये? तेरी दया ओर करूणा मां पाँदा ते अटी गी री। <verse eid="ISA 63:15" /><verse number="16" style="v" sid="ISA 63:16" />देख, तूँ ई म्हारा बाओ ए, तेबे बी म्हारा पुर्वज अब्राहम आसा खे नि पछयाणदा ओर म्हारा पुर्वज इस्राएल आसा खे नि मानदा; तेबे बी ओ यहोवा, तूँ म्हारा बाओ ओर म्हारा छुड़ाणे वाल़ा ए; पुराणे बखतो ते येई तेरा नाओं ए।<note caller="+" style="f"><char style="fr" closed="false">63:16 </char><char style="ft" closed="false">यूह. 8:41 </char></note> <verse eid="ISA 63:16" /><verse number="17" style="v" sid="ISA 63:17" />ओ यहोवा, तूँ आसा खे म्हारी बाटा ते पटकाई देया ओर म्हारे मन एड़े काठे करेया कि आसे तेरा डर नि मानदे? आपणे दास, आपणे इस्से रे गोत्रो रिया खातर वापस आओ। <verse eid="ISA 63:17" /><verse number="18" style="v" sid="ISA 63:18" />तेरी पवित्र प्रजा तो थोड़े ई बखतो तक तेरी पवित्र जगा री अधिकारी रयी, एबे म्हारे दुश्मणे तुसा री पवित्र जगा केसी ती दी ए। से उजाड़ी ती री।<note caller="+" style="f"><char style="fr" closed="false">63:18 </char><char style="ft" closed="false">लूक. 21:24, प्रका. 11:2 </char></note> <verse eid="ISA 63:18" /><verse number="19" style="v" sid="ISA 63:19" />कदी-कदी आसे लोक तो एड़े ऊईगे रे, मानो तैं आसा पाँदे कदी राज नि कित्तेया ओर तिना जेड़े जिना खे तेरे नि बोलेया गया।<verse eid="ISA 63:19" /></para>
  <chapter eid="ISA 63" />
  <chapter number="64" style="c" sid="ISA 64" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 64:1" />ओ यहोवा, “खरा ऊँदा कि तूँ सर्गो खे फाड़ी की तरतिया पाँदे उतरी की आऊँदा ओर पाह्ड़ तां सामणे डरी जांदे। <verse eid="ISA 64:1" /><verse number="2" style="v" sid="ISA 64:2" />जिंयाँ आग कांडा-चीट फूकी देओई या पाणिए खे ब्वाल़ोई, तिंयाँ ई तूँ आपणे दुश्मणा पाँदे आपणी तागत एड़ी प्रगट कर, ताकि जातिया-जातिया रे लोक तेरे प्रतापो ते डरी जाओ! <verse eid="ISA 64:2" /><verse number="3" style="v" sid="ISA 64:3" />जेबे तैं एड़े डराऊणे काम कित्ते जो म्हारी उम्मीदा ते बी बढ़ी की थे, तेबे तूँ उतरी की आया, पाह्ड़ तेरिया मौजुदगिया ते थरथराईगे।” <verse eid="ISA 64:3" /><verse number="4" style="v" sid="ISA 64:4" />कऊँकि पुराणे बखतो ते ई ताखे छाडी की कोई ओर एड़ा परमेशर ना तो कदी देखेया ओर ना कानो साथे तेसरी चर्चा सुणी राखी जो आपणी बाट न्याल़ने वाल़ेया खे काम करो।<note caller="+" style="f"><char style="fr" closed="false">64:4 </char><char style="ft" closed="false">पज. 31:19, 1 कुरि. 2:9 </char></note> <verse eid="ISA 64:4" /><verse number="5" style="v" sid="ISA 64:5" />तूँ तो तिना साथे ई मिलेया जो तर्मो रे काम खुशिया साथे करोए ओर तेरी बाटा रे चलदे ऊए ताखे याद करोए। देख, तूँ आसा ते रोषे ऊआ था, कऊँकि आसे पाप कित्तेया था; आसे बऊत बखतो तक पापो री दशा रे रये, क्या म्हारा उद्धार ऊई सकोआ? <verse eid="ISA 64:5" /><verse number="6" style="v" sid="ISA 64:6" />आसे तो सारे के सारे अशुद्ध माणूंए जेड़े ए ओर म्हारे तर्मो रे काम सारे के सारे मैले चिथड़ेया जेड़े ए। आसे सारे के सारे पत्तेया जेड़े मुरझाई जाऊँए ओर म्हारे बुरे कामे आसे अवा जेड़े उडाई ते रे। <verse eid="ISA 64:6" /><verse number="7" style="v" sid="ISA 64:7" />कोई बी आदमी तांते प्रार्थना नि करदा, ना कोई तांते मताद लणे खे चौकस रओआ कि तां साथे जुड़ेया रा रओ; कऊँकि म्हारे बुरे कामो रिया बजा ते तैं आसा ते आपणा मूँ लकोईता रा ओर आसे म्हारी बुराईया रे वशो रे छाडी ते रे। <verse eid="ISA 64:7" /><verse number="8" style="v" sid="ISA 64:8" />तेबे बी, ओ यहोवा, तूँ म्हारा बाओ ए; देख, आसे तो माट्टी ए ओर तूँ म्हारा कुम्हार ए; आसे सारे के सारे तेरे आथो रे काम ए।<note caller="+" style="f"><char style="fr" closed="false">64:8 </char><char style="ft" closed="false">पज. 100:3, गला. 3:26 </char></note> <verse eid="ISA 64:8" /><verse number="9" style="v" sid="ISA 64:9" />इजी री खातर ओ यहोवा, बऊत रोषे नि ओ, ओर बऊत बखतो तक म्हारे पापो खे याद नि राख। सोची की देख, आसे तांते प्रार्थना करूँए, आसे सब तेरी प्रजा ए। <verse eid="ISA 64:9" /><verse number="10" style="v" sid="ISA 64:10" />देख, तेरे पवित्र शईर यरूशलेमो समेत यहूदा रे शईर उजाड़ ऊईगे, सिय्योन सुनसाण ऊईगा रा, यरूशलेम ऊजड़ी गा रा। <verse eid="ISA 64:10" /><verse number="11" style="v" sid="ISA 64:11" />म्हारा पवित्र ओर सुन्दर मन्दर, जिदे म्हारे बुजुर्ग तेरी स्तुति करो थे, आगी रे फूकी ता रा ओर म्हारिया सेयो सब जगा जो आसे कीमती समजिया नाश ऊई गी रिया। <verse eid="ISA 64:11" /><verse number="12" style="v" sid="ISA 64:12" />ओ यहोवा, क्या यहूदा प्रदेशो री तबाई ऊणे ते बाद बी तूँ आपू खे रोकी सकेया? क्या तां आसे एड़ी बुरी दशा रे रणे देणे?<verse eid="ISA 64:12" /></para>
  <chapter eid="ISA 64" />
  <chapter number="65" style="c" sid="ISA 65" />
  <para style="s">सारेया लोका परमेशरो रे बारे दे जाणना</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 65:1" />यहोवा बोलोआ, जो माखे मतादा रिया तँईं पूछो पनि थे, सेयो माखे टोल़ने लगी रे; जो माखे टोल़ो पनि थे तिने आऊँ पाई ला रा ओर जिना जातिया खे मेरा नि बोलेया जाओ था, तिना खे बी आऊँ बोलूँआ, “देख, आऊँ एती आ, मां तुसा री मताद करनी।” <verse eid="ISA 65:1" /><verse number="2" style="v" sid="ISA 65:2" />मैं एक टीठ जातिया रिया तरफा खे पूरा दिन आपणे लोका रे स्वागतो खे आथ फैलाई राखे, जो आपणी योजना रे मुताबिक बुरी बाटा रे चलो थे।<note caller="+" style="f"><char style="fr" closed="false">65:2 </char><char style="ft" closed="false">रोम. 10:20,21 </char></note> <verse eid="ISA 65:2" /><verse number="3" style="v" sid="ISA 65:3" />एड़े लोक जो मां सामणे ई बगीचे दे मूर्तिया खे बलि चढ़ाई-चढ़ाई की ओर ईटा ते बणी री मूर्तिया री बेदिया पाँदे तूप बाली-बाली की माखे लगातार रोष चढ़ाओ थे। <verse eid="ISA 65:3" /><verse number="4" style="v" sid="ISA 65:4" />ये लोक कब्रा बीचे बैठो थे ओर लूकणे री जगा दे रात बिताओ थे; जो सूंअरो रा मास खाओए ओर तिना रे पांडेया दे मूर्तिया खे बलि कित्ते रे मासो ते बणेया दा रस ए। <verse eid="ISA 65:4" /><verse number="5" style="v" sid="ISA 65:5" />पर ये लोक दूजे लोका ते बोलोए, “अटी जा, मां नेड़े नि आओ, कऊँकि आऊँ तांते पवित्र ए।” यो मेरे नाको रे तुएँ ओर तेसा आगी जेड़े ए जो पूरा दिन बल़दी रओई। <verse eid="ISA 65:5" /><verse number="6" style="v" sid="ISA 65:6" />यहोवा बोलोआ, “देखो, तिना री सजा मां सामणे लिखी राखी: मां चुप नि रणा, मां जरूर बदला लणा, बल्कि तुसा रे ओर तुसा रे बुजुर्गा रे बुरे कामो रा बदला बी तुसा री गोदा दे परी देणा। <verse eid="ISA 65:6" /><verse number="7" style="v" sid="ISA 65:7" />कऊँकि तिने पाह्ड़ो पाँदे तूप बाल़ेया ओर पाह्ड़िया पाँदे मन्दरो दे मूर्तिया री पूजा करी की मेरी बेज्जती करी राखी, इजी री खातर आऊँ यहोवा बोलूँआ कि इना रे पिछले कामा रा दण्ड बी इना री गोदा दे तोली की देणे।” <verse eid="ISA 65:7" /><verse number="8" style="v" sid="ISA 65:8" />यहोवा ईंयाँ बोलोआ; “जिंयाँ अंगूरा रे केसी गुच्छे रे नया रस परी जाओआ, तेबे लोक बोलोए, इजी खे बर्बाद नि करो, कऊँकि इदे आशीष ए, तिंयाँ ई मां आपणे दासो रिया खातर करना कि मेरे सबी लोका खे नाश नि करुँ। <verse eid="ISA 65:8" /><verse number="9" style="v" sid="ISA 65:9" />मां याकूबो बीचा ते एक कुल ओर यहूदा बीचा ते आपणे पाह्ड़ो रा एक बारिस पैदा करना; मेरे चूणे रे तेसरे बारिस ऊणे ओर मेरे दास तेती रणे। <verse eid="ISA 65:9" /><verse number="10" style="v" sid="ISA 65:10" />मेरी प्रजा जो माखे टोल़ोई, तिना रिया पेडा-बाकरिया तो शारोनो री काअटिया दे चरनिया ओर तिना रे गायी-बल़दा आकोर नाओं री तराईया दे राम करना। <verse eid="ISA 65:10" /><verse number="11" style="v" sid="ISA 65:11" />पर तुसे लोक तो यहोवे खे छाडी देओए ओर मेरे पवित्र पाह्ड़ो खे पूली जाओए, जो गाद ओर मेनी नाओं रे भाग्य देवते खे मेजो पाँदे खाणे रिया चीजा सजाओए ओर आत्मा साथे गल्ल करने वाल़ी देविया खे मसाला मलाया रा शराब पेंटा रे रूपो दे चढ़ाओए;<note caller="+" style="f"><char style="fr" closed="false">65:11 </char><char style="ft" closed="false">गाद ओर मेनी भाग्य ओर बखतो रे चूठे देवता थे। </char></note> <verse eid="ISA 65:11" /><verse number="12" style="v" sid="ISA 65:12" />मां तुसे गिणी-गिणी की तलवारी रा ग्रा बणाई देणे ओर तुसे सब मरने खे नपणे; कऊँकि जेबे मैं तुसे बुलाए तुसे कोई ज्वाब नि दित्तेया, जेबे आऊँ बोलणे लगेया, तेबे तुसे मेरी नि सुणी; बल्कि जो माखे बुरा लगोआ, तुसे सेई रोज कित्तेया ओर जेते कि आऊँ दु:खी ओऊँआ, तुसे सेई अपनाया।” <verse eid="ISA 65:12" /><verse number="13" style="v" sid="ISA 65:13" />इजी बजा ते यहोवा ईंयाँ बोलोआ: “देखो, मेरे दासा तो खाणा, पर हे पापियो तुसे सब पूखे मरने; मेरे दासा पीणा, पर तुसे त्याये रणे; मेरे दासा खुशी मनाणी, पर तुसे शर्मिंदा ऊणे; <verse eid="ISA 65:13" /><verse number="14" style="v" sid="ISA 65:14" />देखो, मेरे दासा रे मन खरे ए इजी खे तिना खुशिया रिया बजा ते जयजयकार करनी पर तुसा दु:खो रे मारे हाय-हाय करनी। <verse eid="ISA 65:14" /><verse number="15" style="v" sid="ISA 65:15" />मेरे‍ चूणे दे लोका तुसा रा उदारण देई-देई की स्राप देया करना ओर परमेशर यहोवे तुसे नाश करने; पर तेस आपणे दासा रा दूजा नाओं राखणा।<note caller="+" style="f"><char style="fr" closed="false">65:15 </char><char style="ft" closed="false">जक. 8:13, प्रका. 2:17, प्रका. 3:12 </char></note> <verse eid="ISA 65:15" /><verse number="16" style="v" sid="ISA 65:16" />तेबे सारे देशो दे जो कोई आपू खे तन्य बोलोगा, तेस सच्चे परमेशरो रा नाओं लई की आपू खे तन्य बोलणा ओर जो कोई देशो रे कसम खाओगा, तेस सच्चे परमेशरो रे नाओं ते कसम खाणी; कऊँकि पिछला कष्ट दूर ऊईगा ओर से मेरिया आखी ते लूकी गा रा।”<verse eid="ISA 65:16" /></para>
  <para style="s">एक नई सृष्टि</para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 65:17" />यहोवा बोलोआ, “कऊँकि देखो, मां एक नया सर्ग ओर नई तरती बनाणी ओर लोका मेरे लोका रिया पईलकिया गल्ला याद नि राखणियां ओर सोच बिचारो रे पनि आऊणियां।”<note caller="+" style="f"><char style="fr" closed="false">65:17 </char><char style="ft" closed="false">2 पत. 3:13, प्रका. 21:1,4 </char></note> <verse eid="ISA 65:17" /><verse number="18" style="v" sid="ISA 65:18" />इजी री खातर जो आऊँ पैदा करने वाल़ा ए, तेतेरी बजा ते तुसे खुश ओ ओर सदा मगन रओ; कऊँकि देखो, मां यरूशलेम मगन ओर तेथो री प्रजा खुश बनाणी। <verse eid="ISA 65:18" /><verse number="19" style="v" sid="ISA 65:19" />आऊँ आपू यरूशलेम शईरो रिया बजा ते मगन ओर आपणी प्रजा रिया बजा ते खुश ऊणा; तिदे फेर मतादा खे रोणे रा ओर चींगणे री आवाज नि सुणनी।<note caller="+" style="f"><char style="fr" closed="false">65:19 </char><char style="ft" closed="false">प्रका. 21:4 </char></note> <verse eid="ISA 65:19" /><verse number="20" style="v" sid="ISA 65:20" />परमेशरो री नवीं दुनिया दे फेर ना तो थोड़े दिना रा बच्चा ओर ना एड़ा स्याणा मरना, जिने आपणी उम्र पूरी नि करी राखी ऊगी; कऊँकि जो बचपनो रे मरने वाल़ा ए से सौ साला रा ऊई की मरना, पर पापी सौ साला रा ऊई की स्रापित ठईरना। <verse eid="ISA 65:20" /><verse number="21" style="v" sid="ISA 65:21" />मेरे लोक कअर बणाई की तिदे रणे; तिना अंगूरा रे बगीचे लगाई की तिना रा फल़ खाणा। <verse eid="ISA 65:21" /><verse number="22" style="v" sid="ISA 65:22" />एड़ा नि ऊणा कि सेयो बणाओ ओर अमला करने वाल़ा रओ; या सेयो लगाओ ओर दूजा खाओ; कऊँकि मेरी प्रजा री उम्र डाल़ा जेड़ी ऊणी ओर मेरे चूणे रेया आपणे कामो रा पूरा फायदा चकणा। <verse eid="ISA 65:22" /><verse number="23" style="v" sid="ISA 65:23" />तिना री मईणत बेकार नि ऊणी, ना तिना रे बाल़क कबराई की मरने, कऊँकि सेयो यहोवे रे तन्य लोका रा कुल ठईरने ओर मां सेयो ओर तिना रे वंशो खे सदा खे आशीष देणी।<note caller="+" style="f"><char style="fr" closed="false">65:23 </char><char style="ft" closed="false">पज. 115:14-15 </char></note> <verse eid="ISA 65:23" /><verse number="24" style="v" sid="ISA 65:24" />माखे प्रार्थना दे बुलाणे ते पईले ई मां तिना खे ज्वाब देणा ओर तिना रे माँगदे ई मां तिना री सुणी लणी। <verse eid="ISA 65:24" /><verse number="25" style="v" sid="ISA 65:25" />भेड़िये ओर मिन्टू साथे-साथे चरेया करने, ओर शेरो बल़दो जेड़ा काआ खाया करना ओर सापो माट्टी ई खाया करनी। मेरे सारे पवित्र पाह्ड़ सिय्योनो पाँदे ना तो केसी, केसी खे दु:ख देया करना ओर ना केसी, केसी रा नुकशाण करना, यहोवे रा येई वादे रा वचन ए।<verse eid="ISA 65:25" /></para>
  <chapter eid="ISA 65" />
  <chapter number="66" style="c" sid="ISA 66" />
  <para style="s">परमेशरो जातिया-जातिया रा न्याय करना</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 66:1" />यहोवा ईंयाँ बोलोआ, “सर्ग मेरा सिंहासन ओर तरती मेरे पैरा री चौकी ए; तुसा माखे केड़ा मईल बनाणा ओर मेरे रामो री जगा कुणजी ऊणी?<note caller="+" style="f"><char style="fr" closed="false">66:1 </char><char style="ft" closed="false">प्रेरि. 7:48-50, मत्ती 5:34,35 </char></note> <verse eid="ISA 66:1" /><verse number="2" style="v" sid="ISA 66:2" />यहोवे री ये बाणी ए, कि यो सारी चीजा मेरे ई आथो रिया बणाई रिया ए, ईंयाँ ये सब ऊआ। पर मां तेसरी तरफा खे ई नजर करनी जो शरीफ ओर दु:खी मनो रा ओ ओर मेरा वचन सुणी की डरोआ।<note caller="+" style="f"><char style="fr" closed="false">66:2 </char><char style="ft" closed="false">पज. 34:18, मत्ती 5:3 </char></note> <verse eid="ISA 66:2" /><verse number="3" style="v" sid="ISA 66:3" />बल़दो खे बलि करने वाल़ा, माणूंए खे काणे जेड़ा ए; जो पेडा खे चढ़ाणे वाल़ा ए, से तेस जेड़ा ए जो कुत्ते रा गल़ा बाडोआ; जो नज्जो री बलि चढ़ाओआ, से मानो सूंअरा रा खून चढ़ाणे वाल़े जेड़ा ए ओर जो लोबान बाल़ोआ, से तेस जेड़ा ए जो मूर्तिया खे तन्य बोलोआ। इने सबी आपणी-आपणी बाट टोल़ी दी ए ओर तिना रे मन घिनौनी चीजा साथे खुश ओए। <verse eid="ISA 66:3" /><verse number="4" style="v" sid="ISA 66:4" />इजी री खातर मां बी तिना खे सजा रिया गल्ला काडणिया ओर जिना गल्ला ते सेयो डरोए सेयो ई मां तिना पाँदे ल्याऊणिया; कऊँकि जेबे मैं सेयो बुलाए, तेबे किने नि ज्वाब नि दित्तेया; ओर जेबे मैं तिना साथे गल्ला कित्तिया, तेबे तिने मेरी नि सुणी; पर जो मेरी नजरा दे बुरा था, सेयो तेड़ा ई करदे रये ओर जो माखे बुरा लगो था, सेई तिने अपनाया।” <verse eid="ISA 66:4" /><verse number="5" style="v" sid="ISA 66:5" />तुसे लोक जो यहोवे रा वचन सुणी की डरोए, यहोवे रा वचन सुणो: “तुसा रे जाति पाई जो तुसा साथे दुश्मणी राखोए ओर मेरे नाओं रिया बजा ते तुसा खे लग करी देओए तिने बोलेया, यहोवे री इज्जत तो बढ़ो, जेते कि आसे तुसा री खुशी देखी सकूँ; पर तिना खे ई शर्मिंदा ऊणा पड़ना।”<note caller="+" style="f"><char style="fr" closed="false">66:5 </char><char style="ft" closed="false">2 थिस्स. 1:12 </char></note><verse eid="ISA 66:5" /></para>
  <para style="s">सजा ओर नऊई जाति</para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 66:6" />सुणो, यरूशलेम शईरो ते आल्ला सुणना, मन्दरो ते ए आवाज सुणने लगी री! ये यहोवे री आवाज ए, से आपणे दुश्मणा खे तिना री करनिया रा फल़ देणे लगी रा!<note caller="+" style="f"><char style="fr" closed="false">66:6 </char><char style="ft" closed="false">प्रका. 16:1,17 </char></note> <verse eid="ISA 66:6" /><verse number="7" style="v" sid="ISA 66:7" />मेरा पवित्र शईर तेसा जवाणसा जेड़ा ए जो जम्मणे री पीड़ा लगणे ते पईले ई बच्चे खे जन्म देई देओई; तेसा खे पीड़ा लगणे ते पईले ई तेसे पाऊए खे जन्म दित्तेया।<note caller="+" style="f"><char style="fr" closed="false">66:7 </char><char style="ft" closed="false">प्रका. 12:2,5 </char></note> <verse eid="ISA 66:7" /><verse number="8" style="v" sid="ISA 66:8" />एड़ी गल्ल किने बी कदी सुणी? किने कदी एड़ी गल्ल देखी? क्या कोई देश एक ई दिनो दे पैदा ऊई सकोआ? क्या एक जाति दूई कड़िया रेई पैदा ऊई सकोई? कऊँकि सिय्योनो री पीड़ा शुरू ऊई थी कि तिना ते ल्वाद पैदा ऊई गी। <verse eid="ISA 66:8" /><verse number="9" style="v" sid="ISA 66:9" />यहोवा पूछोआ, “क्या मां से जमाणे रे बखतो तक लई जाई की नि जमाणा?” तेरा परमेशर पूछोआ, “आऊँ जो गर्भ देऊँआ, तो क्या आऊँ कोख बन्द करुँ?” <verse eid="ISA 66:9" /><verse number="10" style="v" sid="ISA 66:10" />भविष्यबक्ता लोका ते बोलोआ, “ओ यरूशलेम शईरो रे लोका साथे सब प्यार राखणे वाल़ेयो, तिना साथे खुशी मनाओ ओर तिना रिया बजा ते मगन ओ; ओ तिना रे बारे दे सब दु:ख करने वाल़ेयो, तिना साथे खुश ओ!” <verse eid="ISA 66:10" /><verse number="11" style="v" sid="ISA 66:11" />जेतेते तू तेसा रा दूद शान्तिया साथे पी-पी की सन्तुष्ट ओआ; ओर दूद पी कि तेसारी महिमा साथे बऊत ज्यादा सुखी ओ। <verse eid="ISA 66:11" /><verse number="12" style="v" sid="ISA 66:12" />कऊँकि यहोवा ईंयाँ बोलोआ, “देखो, मां तिना री वैभवो री नदिया जेड़ी ओर जातिया-जातिया रा तअन नदिया री बाढ़ी जेड़ा बाह्यी देणा ओर तुसा तेते ते पीणा, जिंयाँ माये आपणे बच्चे खे सम्बाल़ोई, तिंयाँ ई मां बी यरूशलेम शईरो रे लोक सम्बाल़ने। <verse eid="ISA 66:12" /><verse number="13" style="v" sid="ISA 66:13" />जिंयाँ माये आपणे बच्चे खे शान्ति देयो ई, तिंयाँ ई मां बी तुसा खे शान्ति देणी; तुसा खे यरूशलेम शईरो रेई शान्ति मिलणी। <verse eid="ISA 66:13" /><verse number="14" style="v" sid="ISA 66:14" />तुसा ये देखणा ओर खुश ऊणे, तुसा रिया आड्डिया काओ जेड़िया अरिया ऊणिया ओर यहोवे रा आथ तेसरे दासा खे प्रगट ऊणा ओर तेसरे दुश्मणा पाँदे तेसरा रोष पड़कणा।<note caller="+" style="f"><char style="fr" closed="false">66:14 </char><char style="ft" closed="false">यूह. 16:22 </char></note> <verse eid="ISA 66:14" /><verse number="15" style="v" sid="ISA 66:15" />कऊँकि देखो, यहोवा आगी साथे आऊणा ओर तेसरे रथ तूफानो जेड़े ऊणे, जेते कि से आपणे रोषो खे जल़नी साथे ओर आपणी चतौणिया खे आगी री लूपिया साथे प्रगट करो।”<note caller="+" style="f"><char style="fr" closed="false">66:15 </char><char style="ft" closed="false">2 थिस्स. 1:8 </char></note> <verse eid="ISA 66:15" /><verse number="16" style="v" sid="ISA 66:16" />कऊँकि यहोवे सबी रा न्याय आगी साथे ओर आपणियां तलवारी साथे करना ओर यहोवे रे मारे दे बऊत ऊणे। <verse eid="ISA 66:16" /><verse number="17" style="v" sid="ISA 66:17" />यहोवा बोलोआ, “जो लोक मूर्तिया री पूजा करने खे आपू खे पवित्र ओर शुद्ध करोए कि बगीचे रे जाओ ओर केसी पीछे खड़े ऊई की सूंअर या चूए रा मास ओर बाकी घिनौनी खाणे रिया चीजा खाओए, सेयो लोक कट्ठे ई नाश ऊणे, यहोवे री येई बाणी ए।” <verse eid="ISA 66:17" /><verse number="18" style="v" sid="ISA 66:18" />कऊँकि आऊँ देशा रे लोका रे काम ओर तिना री योजना दुँईं खे ठीक टंगो दे जाणूंआ ओर से बखत आऊणा जेबे मां सब जातिया ओर लग-लग पाषा बोलणे वाल़े कट्ठे करने ओर तिना आई की मेरी महिमा देखणी। <verse eid="ISA 66:18" /><verse number="19" style="v" sid="ISA 66:19" />मां तिना लोका बीचे एक नशाण प्रगट करना; ओर तिना रे बचे रे लोक मां तिना जातिया गे पेजणे जिने ना तो मेरा सन्देश सुणेया ओर ना मेरी महानता देखी राखी, मतलब तर्शीशिया गे ओर धनुष चलाणे वाल़े पूलिया, लूदिया, तूबली, यूनानी ओर दूर द्धीपो रे रणे वाल़ेया गे बी पेजणे ओर तिना जातिया-जातिया बीचे मेरी महिमा रे बारे दे बताणा। <verse eid="ISA 66:19" /><verse number="20" style="v" sid="ISA 66:20" />जिंयाँ इस्राएली लोक नज्जो री बलिया खे साफ पांडे रे राखी की यहोवे रे मन्दरो रे ल्याओए, तिंयाँ ई तिना तुसा रे सब इस्राएली साथी, कोड़े, रथ, पालकी, खच्चर ओर साँड़णिया पाँदे चढ़ाई-चढ़ाई की मेरे पवित्र पाह्ड़ यरूशलेम शईरो पाँदे यहोवे री पेंटा खे ल्याऊणे, यहोवे रा येई वचन ए। <verse eid="ISA 66:20" /><verse number="21" style="v" sid="ISA 66:21" />ओर तिना बीचा ते कुछ लेवी ओर पुरोईता रे पदो खे बी चूणी लणे, यहोवे री येई बाणी ए।<verse eid="ISA 66:21" /></para>
  <para style="s">नवां सर्ग ओर नवीं तरती</para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 66:22" />कऊँकि जिंयाँ नवां सर्ग ओर नवीं तरती जेतेखे आऊँ बनाणे वाल़ा ए, मां सामणे बणी री रणी, तिंयाँ ई तुसा रा कुल ओर तुसा रा नाओं बी बणेया रा रणा; यहोवे री येई बाणी ए।<note caller="+" style="f"><char style="fr" closed="false">66:22 </char><char style="ft" closed="false">2 पत. 3:13, प्रका. 21: 1</char></note> <verse eid="ISA 66:22" /><verse number="23" style="v" sid="ISA 66:23" />तेबे एड़ा ऊणा कि हर नवें चाँदो रे त्योआरो रे दिने, ओर हर रामो रे दिने, हर देशो रे लोका यरूशलेमो दे मेरी पूजा करनी; यहोवे रा येई वचन ए। <verse eid="ISA 66:23" /><verse number="24" style="v" sid="ISA 66:24" />तेबे मेरे लोक यरूशलेमो ते बारे निकल़ी जाणे तिना बगावत करने वाल़ेया लोका रिया लाशा पाँदे नजर करनी, कऊँकि तिना बीचे पड़े रे कीड़े कदी बी खत्म नि ऊणे, तिना री आग कदी नि बिजणी ओर सारे माणूंआ खे तिना ते बऊत नफरत ऊणी।<note caller="+" style="f"><char style="fr" closed="false">66:24 </char><char style="ft" closed="false">मर. 9:48 </char></note><verse eid="ISA 66:24" /></para>
  <chapter eid="ISA 66" />
</usx>