<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NUM" style="id">- Biblica® Open New Luo Translation 2020</book>
  <para style="h">Kwan</para>
  <para style="toc1">Kwan</para>
  <para style="toc2">Kwan</para>
  <para style="toc3">Kwa</para>
  <para style="mt1">Kwan</para>
  <chapter number="1" style="c" sid="NUM 1"/>
  <para style="s1">Kweno mar jo-Israel</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1"/>Chiengʼ mokwongo mar dwe mar ariyo e higa mar ariyo Jehova Nyasaye nowuoyo gi Musa e Hemb Romo e Thim mar Sinai ka jo-Israel nosewuok Misri. Nowachone niya, <verse eid="NUM 1:1"/><verse number="2" style="v" sid="NUM 1:2"/>“Kaw kwan dhout oganda mar jo-Israel duto kaluwore gi gwengegi kod anywolagi, kindiko nying joma chwo duto moro ka moro. <verse eid="NUM 1:2"/><verse number="3" style="v" sid="NUM 1:3"/>In kod Harun mondo ukwan jo-Israel kuketogi e migepegi, ma mago jo-higni piero ariyo kadhi nyime nyalo tiyo e lweny. <verse eid="NUM 1:3"/><verse number="4" style="v" sid="NUM 1:4"/>Kaw ngʼato achiel koa e dhoot ka dhoot, ka moro ka moro otelo ne jog-gi mondo okonyi kweno.<verse eid="NUM 1:4"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="5" style="v" sid="NUM 1:5"/>“Magi e nying joma chwo mabiro konyi kweno:</para>
  <para style="b" vid="NUM 1:5"/>
  <para style="li1" vid="NUM 1:5">“koa kuom joka Reuben, kaw Elizur wuod Shedeur;<verse eid="NUM 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 1:6"/>koa kuom joka Simeon, kaw Shelumiel wuod Zurishadai;<verse eid="NUM 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 1:7"/>koa kuom joka Juda, kaw Nashon wuod Aminadab;<verse eid="NUM 1:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 1:8"/>koa kuom joka Isakar, kaw Nethanel wuod Zuar;<verse eid="NUM 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 1:9"/>koa kuom joka Zebulun, kaw Eliab wuod Helon.<verse eid="NUM 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 1:10"/>Magi e joma chwo mane okaw koa kuom yawuot Josef:</para>
  <para style="li2" vid="NUM 1:10">koa kuom Efraim, kaw Elishama wuod Amihud;</para>
  <para style="li2" vid="NUM 1:10">koa kuom Manase, kaw Gamaliel wuod Pedazur;<verse eid="NUM 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 1:11"/>koa kuom joka Benjamin, kaw Abidan wuod Gideoni;<verse eid="NUM 1:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 1:12"/>koa kuom joka Dan, kaw Ahiezer wuod Amishadai;<verse eid="NUM 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 1:13"/>koa kuom joka Asher, kaw Pagiel wuod Okran;<verse eid="NUM 1:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 1:14"/>koa kuom joka Gad, kaw Eliasaf wuod Dewel;<verse eid="NUM 1:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 1:15"/>koa kuom joka Naftali, kaw Ahira wuod Enan.”<verse eid="NUM 1:15"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="16" style="v" sid="NUM 1:16"/>Magi e joma chwo mane oyier koa e dhoudi, mane gin jotend dhoudigo. Gin ema ne gin jotend dhout Israel.<verse eid="NUM 1:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="NUM 1:17"/>Musa gi Harun nokawo nying joma nomigi, <verse eid="NUM 1:17"/><verse number="18" style="v" sid="NUM 1:18"/>kendo negiluongo jogwengʼno duto kanyakla e odiechiengʼ mokwongo mar dwe mar ariyo. Ji nonyiso nonro margi kaluwore gi gwengegi kod anywola mag-gi, kendo joma hikgi piero ariyo kadhi nyime nondik nying-gi, moro ka moro, <verse eid="NUM 1:18"/><verse number="19" style="v" sid="NUM 1:19"/>mana kaka Jehova Nyasaye nochiko Musa. Kuom mano ma e kaka Musa nokwanogi e Thim mar Sinai.<verse eid="NUM 1:19"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 1:20"/>Koa kuom nyikwa Reuben ma en wuowi makayo mar Israel:</para>
  <para style="li2" vid="NUM 1:20">Chwo duto mahikgi piero ariyo kadhi nyime moromo tiyo e lweny nondik nying-gi, achiel ka achiel, kaluwore gi nonro mar dhoodgi kod anywolagi. <verse eid="NUM 1:20"/><verse number="21" style="v" sid="NUM 1:21"/>Kar romb joka Reuben ne gin ji alufu piero angʼwen gauchiel gi mia abich (46,500).<verse eid="NUM 1:21"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 1:22"/>Koa kuom nyikwa Simeon:</para>
  <para style="li2" vid="NUM 1:22">Chwo duto mahikgi piero ariyo kadhi nyime moromo tiyo e lweny nondik nying-gi, achiel kaachiel, kaluwore gi nonro mar dhoodgi kod anywolagi. <verse eid="NUM 1:22"/><verse number="23" style="v" sid="NUM 1:23"/>Kar romb joka Simeon ne gin ji alufu piero abich gochiko gi mia adek (59,300).<verse eid="NUM 1:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 1:24"/>Koa kuom nyikwa Gad:</para>
  <para style="li2" vid="NUM 1:24">Chwo duto mahikgi piero ariyo kadhi nyime moromo tiyo e lweny nondik nying-gi, kaluwore gi nonro mar dhoodgi kod anywolagi. <verse eid="NUM 1:24"/><verse number="25" style="v" sid="NUM 1:25"/>Kar romb joka Gad ne gin ji alufu piero angʼwen gabich, mia auchiel gi piero abich (45,650).<verse eid="NUM 1:25"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 1:26"/>Koa kum nyikwa Juda:</para>
  <para style="li2" vid="NUM 1:26">Chwo duto mahikgi piero ariyo kadhi nyime moromo tiyo e lweny nondik nying-gi, kaluwore gi nonro mar dhoodgi kod anywolagi. <verse eid="NUM 1:26"/><verse number="27" style="v" sid="NUM 1:27"/>Kar romb joka Juda ne gin ji alufu piero abiriyo gangʼwen gi mia auchiel (74,600).<verse eid="NUM 1:27"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 1:28"/>Koa kuom nyikwa Isakar:</para>
  <para style="li2" vid="NUM 1:28">Chwo duto mahikgi piero ariyo kadhi nyime moromo tiyo e lweny nondik nying-gi, kaluwore gi nonro mar dhoodgi kod anywolagi. <verse eid="NUM 1:28"/><verse number="29" style="v" sid="NUM 1:29"/>Kar romb joka Isakar ne gin ji alufu piero abich gangʼwen gi mia angʼwen (54,400).<verse eid="NUM 1:29"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="30" style="v" sid="NUM 1:30"/>Koa kuom nyikwa Zebulun:</para>
  <para style="li2" vid="NUM 1:30">Chwo duto mahikgi piero ariyo kadhi nyime moromo tiyo e lweny nondik nying-gi, kaluwore gi nonro mar dhoodgi kod anywolagi. <verse eid="NUM 1:30"/><verse number="31" style="v" sid="NUM 1:31"/>Kar romb joka Zebulun ne gin ji alufu piero abich gabiriyo gi mia angʼwen (57,400).<verse eid="NUM 1:31"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="32" style="v" sid="NUM 1:32"/>Kuom yawuot Josef:</para>
  <para style="li1" vid="NUM 1:32">Koa e dhood Efraim:</para>
  <para style="li2" vid="NUM 1:32">Chwo duto mahikgi piero ariyo kadhi nyime moromo tiyo e lweny nondik nying-gi, kaluwore gi nonro mar dhoodgi kod anywolagi. <verse eid="NUM 1:32"/><verse number="33" style="v" sid="NUM 1:33"/>Kar romb joka Efraim ne gin ji alufu piero angʼwen gi mia abich (40,500).<verse eid="NUM 1:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 1:34"/>Koa e dhood Manase:</para>
  <para style="li2" vid="NUM 1:34">Chwo duto mahikgi piero ariyo kadhi nyime moromo tiyo e lweny nondik nying-gi, kaluwore gi nonro mar dhoodgi kod anywolagi. <verse eid="NUM 1:34"/><verse number="35" style="v" sid="NUM 1:35"/>Kar romb joka Manase ne gin ji alufu piero adek gariyo gi mia ariyo (32,200).<verse eid="NUM 1:35"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="36" style="v" sid="NUM 1:36"/>Koa kuom nyikwa Benjamin:</para>
  <para style="li2" vid="NUM 1:36">Chwo duto mahikgi piero ariyo kadhi nyime moromo tiyo e lweny nondik nying-gi, kaluwore gi nonro mar dhoodgi kod anywolagi. <verse eid="NUM 1:36"/><verse number="37" style="v" sid="NUM 1:37"/>Kar romb dhood Benjamin ne gin ji alufu piero adek gabich gi mia angʼwen (35,400).<verse eid="NUM 1:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 1:38"/>Koa kuom nyikwa Dan:</para>
  <para style="li2" vid="NUM 1:38">Chwo duto mahikgi piero ariyo kadhi nyime moromo tiyo e lweny nondik nying-gi, kaluwore gi nonro mar dhoodgi kod anywolagi. <verse eid="NUM 1:38"/><verse number="39" style="v" sid="NUM 1:39"/>Kar romb dhood Dan ne gin ji alufu piero auchiel gariyo gi mia abiriyo (62,700).<verse eid="NUM 1:39"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="40" style="v" sid="NUM 1:40"/>Koa kuom nyikwa Asher:</para>
  <para style="li2" vid="NUM 1:40">Chwo duto mahikgi piero ariyo kadhi nyime moromo tiyo e lweny nondik nying-gi, kaluwore gi nonro mar dhoodgi kod anywolagi. <verse eid="NUM 1:40"/><verse number="41" style="v" sid="NUM 1:41"/>Kar romb dhood Asher ne gin ji alufu piero angʼwen gachiel gi mia abich (41,500).<verse eid="NUM 1:41"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="42" style="v" sid="NUM 1:42"/>Koa kuom nyikwa Naftali:</para>
  <para style="li2" vid="NUM 1:42">Chwo duto mahikgi piero ariyo kadhi nyime moromo tiyo e lweny nondik nying-gi, kaluwore gi nonro mar dhoodgi kod anywolagi. <verse eid="NUM 1:42"/><verse number="43" style="v" sid="NUM 1:43"/>Kar romb dhood Naftali ne gin ji alufu piero abich gadek gi mia angʼwen (53,400).<verse eid="NUM 1:43"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="44" style="v" sid="NUM 1:44"/>Magi e joma Musa gi Harun kod jotend Israel apar gariyo nokwano, ka moro ka moro ochungʼ ne anywolane. <verse eid="NUM 1:44"/><verse number="45" style="v" sid="NUM 1:45"/>Jo-Israel duto ma jo-higni piero ariyo kadhi nyime mane nyalo tiyo e lwenj Israel nokwan kaluwore gi anywolagi. <verse eid="NUM 1:45"/><verse number="46" style="v" sid="NUM 1:46"/>Kar rombgi ne gin ji alufu mia auchiel gadek mia abich gi piero abich (603,550).<verse eid="NUM 1:46"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47"/>Anywola mar jo-Lawi, kata kamano, ne ok okwan gi joma moko. <verse eid="NUM 1:47"/><verse number="48" style="v" sid="NUM 1:48"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 1:48"/><verse number="49" style="v" sid="NUM 1:49"/>“Kik ikwan dhood Lawi kata riwogi e kweno mar jo-Israel mamoko. <verse eid="NUM 1:49"/><verse number="50" style="v" sid="NUM 1:50"/>Kuom mano, yier jo-Lawi mondo obed jorit Hemb Romo mar Rapar kaachiel gi gik moko duto manie iye. Gin ema nyaka gitingʼ Hemb Romo gi gige; kendo girite maber ka gilwore kod hembegi koni gi koni. <verse eid="NUM 1:50"/><verse number="51" style="v" sid="NUM 1:51"/>Kamoro amora ma itero e Hema, jo-Lawi ema nyaka gole oko, kendo kamoro amora midhi gure Hema, jo-Lawi ema nyaka gure. Ngʼato angʼata mosudo machiegni kode nyaka negi. <verse eid="NUM 1:51"/><verse number="52" style="v" sid="NUM 1:52"/>Jo-Israel nyaka gur hembegi e migepe, ka ngʼato ka ngʼato nitiere kare owuon kaluwore gi rangʼiny moketi. <verse eid="NUM 1:52"/><verse number="53" style="v" sid="NUM 1:53"/>Jo-Lawi, kata kamano, nyaka gur hembegi e alwora mar Hemb Romo mar Rapar mondo omi mirimb Jehova Nyasaye kik lwar kuom oganda mar jo-Israel. Jo-Lawi nobed karito Hemb Romo mar Rapar.”<verse eid="NUM 1:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 1:54"/>Jo-Israel notimo gigi duto mana kaka Jehova Nyasaye nochiko Musa.<verse eid="NUM 1:54"/></para>
  <chapter eid="NUM 1"/>
  <chapter number="2" style="c" sid="NUM 2"/>
  <para style="s1">Chenro mar kuonde dak mag dhoudi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1"/>Jehova Nyasaye nowacho ne Musa gi Harun niya, <verse eid="NUM 2:1"/><verse number="2" style="v" sid="NUM 2:2"/>“Jo-Israel nyaka chokre kolworo Hemb Romo kochwalore matin kode, ka ngʼato ka ngʼato ni e bwo jatendgi kod gima ondikie nying dhoodgi.”<verse eid="NUM 2:2"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="3" style="v" sid="NUM 2:3"/>Koa yo wuok chiengʼ,</para>
  <para style="li1" vid="NUM 2:3">migepe mag joka Juda nodag kanyo kaluwore gi rangʼiny moketi. Jatend Juda ne en Nashon wuod Aminadab. <verse eid="NUM 2:3"/><verse number="4" style="v" sid="NUM 2:4"/>Migawo mar dhood Juda ne romo ji alufu piero abich gangʼwen gi mia angʼwen (74,600).<verse eid="NUM 2:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 2:5"/>Dhood Isakar nodag butgi. Jatend dhood Isakar ne en Nethanel wuod Zuar. <verse eid="NUM 2:5"/><verse number="6" style="v" sid="NUM 2:6"/>Migawo mar dhood Isakar ne romo ji alufu piero abich gangʼwen gi mia angʼwen (54,400).<verse eid="NUM 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 2:7"/>Dhood Zebulun noluwogi. Jatend dhood Zebulun ne en Eliab wuod Helon. <verse eid="NUM 2:7"/><verse number="8" style="v" sid="NUM 2:8"/>Migawo mar dhood Zebulun ne romo ji alufu piero abich gabiriyo gi mia angʼwen (57,400).<verse eid="NUM 2:8"/></para>
  <para style="li4">
    <verse number="9" style="v" sid="NUM 2:9"/>Jogo duto mane odak e dala Juda, kaluwore gi migepegi, ne romo ji alufu mia achiel gi piero aboro gauchiel gi mia angʼwen (186,400). Gin e joma biro wuok motelo.<verse eid="NUM 2:9"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="10" style="v" sid="NUM 2:10"/>Koa yo milambo nobedie</para>
  <para style="li1" vid="NUM 2:10">migepe mag Reuben kaluwore gi rangʼiny moketi. Jatend dhood Reuben ne en Elizur wuod Shedeur. <verse eid="NUM 2:10"/><verse number="11" style="v" sid="NUM 2:11"/>Migawo mar dhood Reuben ne romo ji alufu piero angʼwen gauchiel gi mia abich (46,500).<verse eid="NUM 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 2:12"/>Dhood Simeon nodag butgi. Jatend dhood Simeon ne en Shelumiel wuod Zurishadai. <verse eid="NUM 2:12"/><verse number="13" style="v" sid="NUM 2:13"/>Migawo mar dhood Simeon ne romo ji alufu piero abich gochiko gi mia adek (59,300).<verse eid="NUM 2:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 2:14"/>Maluwogi ne en dhood Gad. Jatend dhood Gad ne en Eliasaf wuod Reuel. <verse eid="NUM 2:14"/><verse number="15" style="v" sid="NUM 2:15"/>Migawo mar dhood Gad ne romo ji alufu piero angʼwen gabich gi mia auchiel gi piero abich (45,650).<verse eid="NUM 2:15"/></para>
  <para style="li4">
    <verse number="16" style="v" sid="NUM 2:16"/>Jogo duto mane odak e dala Reuben, kaluwore gi migepe mag-gi, noromo ji alufu mia achiel gi piero abich gachiel, mia angʼwen gi piero abich (151,450). Gin ema giniwuogi mar ariyo.<verse eid="NUM 2:16"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="17" style="v" sid="NUM 2:17"/>Bangʼe Hemb Romo kod kar dak mar jo-Lawi noket e dier kambe mamoko. Ginichanre mana kaka kuondegi mag bworo ochanore ka jomoko ka jomoko ni kargi giwegi.<verse eid="NUM 2:17"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="18" style="v" sid="NUM 2:18"/>Koa yo podho chiengʼ nobedie</para>
  <para style="li1" vid="NUM 2:18">migepe mag Efraim kaluwore gi rangʼiny moketi. Jatend dhoodno ne en Elishama wuod Amihud. <verse eid="NUM 2:18"/><verse number="19" style="v" sid="NUM 2:19"/>Migawo mar dhood Efraim noromo ji alufu piero angʼwen gi mia abich (40,500).<verse eid="NUM 2:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 2:20"/>Dhood Manase ema nobed butgi. Jatend dhoodno ne en Gamaliel wuod Pedazur. <verse eid="NUM 2:20"/><verse number="21" style="v" sid="NUM 2:21"/>Migawo mar dhood Manase noromo ji alufu piero adek gariyo gi mia ariyo (32,200).<verse eid="NUM 2:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 2:22"/>Maluwogi ne en dhood Benjamin. Jatend dhood Benjamin ne en Abidan wuod Gideoni. <verse eid="NUM 2:22"/><verse number="23" style="v" sid="NUM 2:23"/>Migawo mar dhood Benjamin noromo ji alufu piero adek gabich gi mia angʼwen (35,400).<verse eid="NUM 2:23"/></para>
  <para style="li4">
    <verse number="24" style="v" sid="NUM 2:24"/>Jogo duto mane odak e dala Efraim, kaluwore gi migepe mag-gi noromo ji alufu mia achiel gaboro gi mia achiel (108,100). Gin ema ne giwuok mar adek.<verse eid="NUM 2:24"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="25" style="v" sid="NUM 2:25"/>Koa yo nyandwat nobedi</para>
  <para style="li1" vid="NUM 2:25">migepe mag kuonde dak mag Dan, kaluwore gi rangʼiny moketi. Jatend dhood Dan en Ahiezer wuod Amishadai. <verse eid="NUM 2:25"/><verse number="26" style="v" sid="NUM 2:26"/>Migawo mar dhood Dan noromo ji alufu piero auchiel gariyo gi mia abiriyo (62,700).<verse eid="NUM 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="NUM 2:27"/>Maluwogi ne en dhood Asher. Jatend dhood Asher ne en Pagiel wuod Okran. <verse eid="NUM 2:27"/><verse number="28" style="v" sid="NUM 2:28"/>Migawo mar dhood Asher noromo ji alufu piero angʼwen gachiel gi mia abich (41,500).<verse eid="NUM 2:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 2:29"/>Maluwogi ne en dhood Naftali. Jatend dhood Naftali ne en Ahira wuod Enan. <verse eid="NUM 2:29"/><verse number="30" style="v" sid="NUM 2:30"/>Migawo mar dhood Naftali noromo ji alufu piero abich gadek gi mia angʼwen (53,400).<verse eid="NUM 2:30"/></para>
  <para style="li4">
    <verse number="31" style="v" sid="NUM 2:31"/>Jogo duto mane odak e dala Dan noromo ji alufu mia achiel gi piero abich gabiriyo, gi mia auchiel (157,600). Gin ema giniwuogi mogik kaluwore gi rangʼiny moketi.<verse eid="NUM 2:31"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="32" style="v" sid="NUM 2:32"/>Magi e jo-Israel, mane okwan kaluwore gi dhoutgi. Jogo duto mane nitie kar dak, kaluwore gi migepe mag-gi noromo ji alufu mia auchiel gadek, mia abich gi piero abich (603,550). <verse eid="NUM 2:32"/><verse number="33" style="v" sid="NUM 2:33"/>Kata kamano, jo-Lawi ne ok okwan gi jo-Israel mamoko, mana kaka Jehova Nyasaye nosechiko Musa.<verse eid="NUM 2:33"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="34" style="v" sid="NUM 2:34"/>Omiyo jo-Israel notimo gik moko duto mane Jehova Nyasaye ochiko Musa; mano e yo mane gichokore godo e rangʼiny mag-gi giwegi, kendo mano e kaka negichokore, moro ka moro gi dhoodgi kod joge.<verse eid="NUM 2:34"/></para>
  <chapter eid="NUM 2"/>
  <chapter number="3" style="c" sid="NUM 3"/>
  <para style="s1">Jo-Lawi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1"/>Ma e nonro mar joka Harun kod Musa e kinde mane Jehova Nyasaye owuoyo gi Musa e Got Sinai.<verse eid="NUM 3:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="NUM 3:2"/>Nying yawuot Harun ne gin Nadab ma wuowi makayo kod Abihu, Eliazar kod Ithamar. <verse eid="NUM 3:2"/><verse number="3" style="v" sid="NUM 3:3"/>Mago ema ne nying yawuot Harun, mane gin jodolo mowir kendo mopwodhi mondo obed jodolo. <verse eid="NUM 3:3"/><verse number="4" style="v" sid="NUM 3:4"/>Kata kamano Nadab kod Abihu, notho e nyim Jehova Nyasaye e kinde mane gichiwo misango ma ok opwodhi e Thim mar Sinai. Ne gionge yawuowi; omiyo Eliazar gi Ithamar kende ema nobedo jodolo e ndalo mane Harun wuon-gi pod ngima.<verse eid="NUM 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 3:5"/><verse number="6" style="v" sid="NUM 3:6"/>“Kel dhood jo-Lawi kendo ichiwgi e nyim jadolo Harun mondo gikonye tich. <verse eid="NUM 3:6"/><verse number="7" style="v" sid="NUM 3:7"/>Nyaka gitine kaachiel gi oganda duto e nyim Hemb Romo ka gitiyo tije mag kama ler. <verse eid="NUM 3:7"/><verse number="8" style="v" sid="NUM 3:8"/>Nyaka girit malongʼo gige Hemb Romo duto, ka gichopo chike duto mag jo-Israel monego gitim e Hemb Romo. <verse eid="NUM 3:8"/><verse number="9" style="v" sid="NUM 3:9"/>Chiw jo-Lawi e lwet Harun gi yawuote nikech gin e joma owal e dhood Israel mondo okonye tich. <verse eid="NUM 3:9"/><verse number="10" style="v" sid="NUM 3:10"/>Yier Harun kod yawuote mondo obed jodolo; ngʼato angʼata mosudo machiegni gi kama ler mar lemo nyaka negi.”<verse eid="NUM 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11"/>Jehova Nyasaye nomedo wachone Musa niya, <verse eid="NUM 3:11"/><verse number="12" style="v" sid="NUM 3:12"/>“Asekawo jo-Lawi koa ei jo-Israel e lo wuowi makayo mar chi ja-Israel moro ka moro. Jo-Lawi gin meka, <verse eid="NUM 3:12"/><verse number="13" style="v" sid="NUM 3:13"/>nimar yawuowi makayo duto gin meka. Kane anego yawuowi makayo duto e piny Misri, ne awalo ne an awuon kayo moro amora e Israel, obed mar dhano kata mar le mondo gibed maga. An e Jehova Nyasaye.”<verse eid="NUM 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14"/>Jehova Nyasaye nowacho ne Musa e Thim mar Sinai niya, <verse eid="NUM 3:14"/><verse number="15" style="v" sid="NUM 3:15"/>“Kwan jo-Lawi kaluwore gi joutgi kod anywolagi. Kwan chwo duto chakre ja-dwe achiel kadhi nyime.” <verse eid="NUM 3:15"/><verse number="16" style="v" sid="NUM 3:16"/>Omiyo Musa nokwanogi, mana kaka Jehova Nyasaye nomiye chik.<verse eid="NUM 3:16"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="17" style="v" sid="NUM 3:17"/>Magi ema ne nyinge yawuot jo-Lawi:</para>
  <para style="li2" vid="NUM 3:17">Gershon, Kohath gi Merari.<verse eid="NUM 3:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="NUM 3:18"/>Magi ema ne nying joka Gershon:</para>
  <para style="li2" vid="NUM 3:18">Libni gi Shimei.<verse eid="NUM 3:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="NUM 3:19"/>Joka Kohath ne gin:</para>
  <para style="li2" vid="NUM 3:19">Amram, Izhar, Hebron gi Uziel.<verse eid="NUM 3:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 3:20"/>Joka Merari ne gin:</para>
  <para style="li2" vid="NUM 3:20">Mali gi Mushi.</para>
  <para style="b" vid="NUM 3:20"/>
  <para style="li4" vid="NUM 3:20">Magi ema ne anywola jo-Lawi, kaluwore gi dhoutgi.<verse eid="NUM 3:20"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="21" style="v" sid="NUM 3:21"/>Koa e dhood Gershon, ne nitiere jo-Libni gi Shimei; mago ema ne joka Gershon.<verse eid="NUM 3:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 3:22"/>Kar romb chwo duto kochakore ja-dwe achiel kadhi nyime noromo ji alufu abiriyo mia abich (7,500).<verse eid="NUM 3:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 3:23"/>Dhout jo-Gershon nonego dag yo podho chiengʼ mar kama ler.<verse eid="NUM 3:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 3:24"/>Jatend Gershon ne en Eliasaf wuod Lael.<verse eid="NUM 3:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 3:25"/>Tij jo-Gershon e Kar Hemb Romo ne en rito Kama Ler mar Lemo kod hema, kaachiel gi gik moumego, kaka pasia mantiere e dhorangach mar Hemb Romo. <verse eid="NUM 3:25"/><verse number="26" style="v" sid="NUM 3:26"/>Bende negirito pasia mag laru, pasia mar dhorangach mar laru molworo kama ler gi kendo mar misango kod tonde, kaachiel gi gik moko duto mitwechogo.<verse eid="NUM 3:26"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="27" style="v" sid="NUM 3:27"/>E dhood Kohath ne nitiere jo-Amram, jo-Izhar, jo-Hebron, jo-Uziel; magi ema ne anywola joka Kohath.<verse eid="NUM 3:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 3:28"/>Kar romb chwo duto kochakore ja-dwe achiel kadhi nyime ne romo ji alufu aboro mia auchiel (8,600).</para>
  <para style="li1" vid="NUM 3:28">Tij jo-Kohath ne en rito kama ler mar lemo.<verse eid="NUM 3:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 3:29"/>Dhood Kohath nonego dagi yo milambo mar kama ler.<verse eid="NUM 3:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="NUM 3:30"/>Jatend dhout jo-Kohath ne en Elizafan wuod Uziel.<verse eid="NUM 3:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="NUM 3:31"/>Tijgi ne en rito Sandug Muma, mesa, rachungi mar taya, kende mag misengini, gige kama ler mar lemo mitiyogo tije dolo, pasia, kod gik moko duto mitiyogo tijego.<verse eid="NUM 3:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="NUM 3:32"/>Jatelo maduongʼ mar jo-Lawi ne en Eliazar wuod Harun jadolo. En ema ne oyiere bedo jatelo mag joma rito kama ler mar lemo.<verse eid="NUM 3:32"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="33" style="v" sid="NUM 3:33"/>E dhood Merari ne nitiere jo-Mali kod jo-Mushi; magi ema anywola joka Merari.<verse eid="NUM 3:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 3:34"/>Kar romb chwo duto kochakore ja-dwe achiel kata moloyo dwe achiel mane okwan ne romo ji alufu auchiel mia ariyo (6,200).<verse eid="NUM 3:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="NUM 3:35"/>Jatend dhout Merari ne en Zuriel wuod Abihail.</para>
  <para style="li1" vid="NUM 3:35">Nonego gidagi yo nyandwat mar kama ler.<verse eid="NUM 3:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="NUM 3:36"/>Joka Merari noyier mondo orit sirni mag kama ler mar lemo, yiend reru, sirni mamoko, mise, kaachiel gi gige duto kod gik moko duto mitiyogo kanyo, <verse eid="NUM 3:36"/><verse number="37" style="v" sid="NUM 3:37"/>kaachiel gi sirni mochungʼ molworo laru man-gi mise, sigingi mag hema kod tonde.<verse eid="NUM 3:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 3:38"/>Musa kod Harun gi yawuote nonego dagi yo wuok chiengʼ mar Hemb Romo.</para>
  <para style="li1" vid="NUM 3:38">Tijgi ne en rito kama ler mar lemo e lo jo-Israel.</para>
  <para style="li1" vid="NUM 3:38">Ngʼato angʼata mane osudo machiegni gi kama ler mar lemo nyaka ne negi.<verse eid="NUM 3:38"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="39" style="v" sid="NUM 3:39"/>Kar romb jo-Lawi duto mane okwan kaluwore gi chik mane Jehova Nyasaye ogolo kokadho kuom Musa kod Harun kaluwore gi anywolagi ne gin ji alufu piero ariyo gariyo (22,000), magi ne gin kaachiel gi nyithindo duto ma yawuowi kochakore ja-dwe achiel kadhi nyime.<verse eid="NUM 3:39"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40"/>Jehova Nyasaye nowacho ne Musa niya, “Kwan nyithindo ma yawuowi makayo duto mag Israel kochakore ja-dwe achiel kadhi nyime kendo indik nyingegi piny. <verse eid="NUM 3:40"/><verse number="41" style="v" sid="NUM 3:41"/>Ket jo-Lawi obedna kaka kayo e lo kayo duto mag jo-Israel, kendo kaw jamb jo-Lawi obed e lo kweth makayo mag jamb jo-Israel. An e Jehova Nyasaye.”<verse eid="NUM 3:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 3:42"/>Omiyo Musa nokwano nyithindo makayo duto mag jo-Israel, mana kaka Jehova Nyasaye nochike. <verse eid="NUM 3:42"/><verse number="43" style="v" sid="NUM 3:43"/>Kar romb nyithindo ma yawuowi duto makayo ma ja-dwe achiel kadhi nyime, kondik nying-gi moro ka moro ne romo ji alufu piero ariyo gariyo, mia ariyo gi piero abiriyo gadek (22,273).<verse eid="NUM 3:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44"/>Jehova Nyasaye nochako owachone Musa niya, <verse eid="NUM 3:44"/><verse number="45" style="v" sid="NUM 3:45"/>“Ket jo-Lawi mondo obedna kaka kayo e lo jo-Israel, kendo jamni mag jo-Lawi e lo jambgi. Jo-Lawi nyaka bed maga. An e Jehova Nyasaye. <verse eid="NUM 3:45"/><verse number="46" style="v" sid="NUM 3:46"/>Mondo omi ires jo-Israel makayo ji mia ariyo piero adek gabiriyo ma kwan-gi ohewo kwan midwaro mar jo-Lawi, <verse eid="NUM 3:46"/><verse number="47" style="v" sid="NUM 3:47"/>chok shekel abich ne ngʼato ka ngʼato, kaluwore gi shekel mar kama ler mar lemo, ma pekne romo gera piero ariyo. <verse eid="NUM 3:47"/><verse number="48" style="v" sid="NUM 3:48"/>Mi Harun kod yawuote pesa miwarogo jo-Israel momedore.”<verse eid="NUM 3:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="NUM 3:49"/>Omiyo Musa nochoko pesa kuom joma ne omedore e kwan mane jo-Lawi oreso. <verse eid="NUM 3:49"/><verse number="50" style="v" sid="NUM 3:50"/>Koa kuom kayo mag jo-Israel nochoko fedha ma pekne en shekel alufu mia achiel mia adek gi piero auchiel gabich (1,365), kaluwore gi shekel mar kama ler mar lemo. <verse eid="NUM 3:50"/><verse number="51" style="v" sid="NUM 3:51"/>Musa nochiwo ne Harun kod yawuote pesa miwarogo jo-Israel momedore mana kaka Jehova Nyasaye nochike.<verse eid="NUM 3:51"/></para>
  <chapter eid="NUM 3"/>
  <chapter number="4" style="c" sid="NUM 4"/>
  <para style="s1">Jo-Kohath</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1"/>Jehova Nyasaye nowacho ne Musa gi Harun niya, <verse eid="NUM 4:1"/><verse number="2" style="v" sid="NUM 4:2"/>“Kwan jo-Kohath ma gin bad jo-Lawi kaluwore gi gwengegi kod dhoutgi. <verse eid="NUM 4:2"/><verse number="3" style="v" sid="NUM 4:3"/>Kwan chwo duto mahikgi chakore piero adek nyaka piero abich mabiro tiyo e Hemb Romo.<verse eid="NUM 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 4:4"/>“Tij jo-Kohath e Hemb Romo en rito gik maler moloyo. <verse eid="NUM 4:4"/><verse number="5" style="v" sid="NUM 4:5"/>Ka udar kama ujote, to Harun kod yawuote nyaka donji ei hema mi gigol pasia kendo giumgo Sandug Muma. <verse eid="NUM 4:5"/><verse number="6" style="v" sid="NUM 4:6"/>Bangʼe gium nangani gi piende monyongʼ mayom mag le mag nembe, kendo giyar suka marambulu bangʼe giket sirni mitingʼego.<verse eid="NUM 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7"/>“Nyaka gipedh mesa manie Nyim Nyasaye gi kitamba marambulu, bangʼe giket sende e wiye, gi dise kod bakunde, gi njage mar chiwo misango miolo piny; bende gine ni makati man kanyo seche duto kik rum. <verse eid="NUM 4:7"/><verse number="8" style="v" sid="NUM 4:8"/>Nyaka gipedh nanga ewi gigi duto kendo giumgi gi piende monyongʼ mayom mag le mag nembe bangʼe giket sirni mitingʼego.<verse eid="NUM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 4:9"/>“Nyaka gikaw nanga marambulu kendo gium rachungi taya ma en kar keto gima chiwo ler, kaachiel gi techene, gi gima ingʼadogo otambi kod odheru, kod njage duto mikanoe mo. <verse eid="NUM 4:9"/><verse number="10" style="v" sid="NUM 4:10"/>Bangʼe to nyaka giume gi piende monyongʼ mayom mag le mag nembe kaachiel gi gige duto kendo gikete e sirni mitingʼego.<verse eid="NUM 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11"/>“Nyaka gipedh nanga marambulu ewi kendo mar misango mar dhahabu bangʼe giume gi piende monyongʼ mayom mag le mag nembe kendo giket sirni mitingʼego kuonde mowinjore.<verse eid="NUM 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 4:12"/>“Nyaka gikaw gik moko duto motiyogo e tij dolo e kama ler mar lemo, kendo gibogi gi suka marambulu, kod piende monyongʼ mayom mag le mag nembe, bangʼe giketgi e sirni mitingʼego oliero liero.<verse eid="NUM 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 4:13"/>“Nyaka gigol buru oko e kendo mar misango mar mula bangʼe gipedh suka maralik e wiye. <verse eid="NUM 4:13"/><verse number="14" style="v" sid="NUM 4:14"/>Bangʼ mano giniket gik michiemogo mag dolo e kar kendo mar misango, kaachiel gi gige chiedo, uma mar chwoyo ringʼo, opawo kod bakunde mikirogo remo. Nyaka gipedh raum mar piende monyongʼ mayom mag le mag nembe e wiye kendo giket sirni mitingʼego kuonde mowinjore.<verse eid="NUM 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 4:15"/>“Bangʼ ka Harun gi yawuote osetieko umo gik maler mitiyogo kod gik maler duto mamoko, kendo ka kambi oseikore mar wuok, to jo-Kohath koro nyaka bi mondo oti tij tingʼo. Kik gimul gik maler, nimar ka gitimo kamano to ginitho. Jo-Kohath nyaka tingʼ gigo mantiere ei Hemb Romo.<verse eid="NUM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 4:16"/>“Eliazar wuod Harun, jadolo, nochungʼne mo mar taya, ubani mangʼwe ngʼar, chiwo mar cham michiwo kinde ka kinde, kod mor pwodhruok. Nyaka obed jarit mar kar lemo duto kod gik moko duto manie iye, kaachiel gi gik maler molosego kod gik moko duto mokan kanyo.”<verse eid="NUM 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17"/>Jehova Nyasaye nowacho ne Musa gi Harun niya, <verse eid="NUM 4:17"/><verse number="18" style="v" sid="NUM 4:18"/>“Neuru ni dhout jo-Kohath ok ogol oko kuom jo-Lawi, <verse eid="NUM 4:18"/><verse number="19" style="v" sid="NUM 4:19"/>mondo omi gibed mangima kendo kik githo ka gibiro machiegni gi gik maler moloyo. Timnegiuru kama: Harun gi yawuote mondo odhi ei kama ler mar lemo kendo gimi ngʼato ka ngʼato tije kod gima onego otingʼ. <verse eid="NUM 4:19"/><verse number="20" style="v" sid="NUM 4:20"/>To dhout jo-Kohath kik donji nikech dipo ka gigoyo wangʼ-gi kuom gik maler mi githo.”<verse eid="NUM 4:20"/></para>
  <para style="s1">Joka Gershon</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 4:21"/><verse number="22" style="v" sid="NUM 4:22"/>“Kwan joka Gershon kaluwore gi anywolagi kod dhoutgi. <verse eid="NUM 4:22"/><verse number="23" style="v" sid="NUM 4:23"/>Kwan chwo duto mahikgi en piero adek nyaka piero abich, ma gin joma obiro konyo tich mar Hemb Romo.<verse eid="NUM 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 4:24"/>“Ma e tich ma joka Gershon biro timo ka gitiyo kendo ka gitingʼo misigo: <verse eid="NUM 4:24"/><verse number="25" style="v" sid="NUM 4:25"/>Gibiro tingʼo pasia moumgo kar lemo, Hemb Romo, gik moumego kod piende monyongʼ mayom mag le mag nam moumgo wiye, moumgo dhoranga Hemb Romo, <verse eid="NUM 4:25"/><verse number="26" style="v" sid="NUM 4:26"/>pasia mag laru molworo kar lemo kod kendo mar misango, pasia mar dhorangach, tonde kod gik moko duto mitiyogo kanyo. Joka Gershon nyaka ti tije duto madwarore mondo oti kanyo. <verse eid="NUM 4:26"/><verse number="27" style="v" sid="NUM 4:27"/>Tijegi duto, bedni en tingʼo kata tich moro amora nyaka tim ka Harun kod yawuote ema oteloe. Unupog-gi tich monego gitim. <verse eid="NUM 4:27"/><verse number="28" style="v" sid="NUM 4:28"/>Ma e tich ma dhout Gershon onego tim e Hemb Romo. Ithamar wuod Harun jadolo ema notelne tijegi.<verse eid="NUM 4:28"/></para>
  <para style="s1">Joka Merari</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29"/>“Kwan jo-Merari kaluwore gi dhoutgi kod anywolagi. <verse eid="NUM 4:29"/><verse number="30" style="v" sid="NUM 4:30"/>Kwan joma chwo duto mahikgi piero adek nyaka piero abich mabiro konyo e tich mar Hemb Romo. <verse eid="NUM 4:30"/><verse number="31" style="v" sid="NUM 4:31"/>Ma e tich ma gibiro tiyo e Hemb Romo: ginitingʼ yiende moten-go kar lemo, fito mage, sirni kod mise, <verse eid="NUM 4:31"/><verse number="32" style="v" sid="NUM 4:32"/>kaachiel gi sirni molworo laru man-gi mise, sigingi mag hema, tonde, gi gik moko duto mitiyogo kanyo kendo ngʼato ka ngʼato nyaka mi gik monego otingʼ. <verse eid="NUM 4:32"/><verse number="33" style="v" sid="NUM 4:33"/>Ma e tich ma dhood Merari onego ti e Hemb Romo kotelnegi gi Ithamar wuod Harun jadolo.”<verse eid="NUM 4:33"/></para>
  <para style="s1">Kwan mar dhout jo-Lawi</para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 4:34"/>Musa, Harun kod jotend oganda mar jo-Israel nokwano jo-Kohath kaluwore gi dhoutgi kod anywolagi.<verse eid="NUM 4:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="NUM 4:35"/>Chwo duto mahikgi piero adek nyaka piero abich mane obiro tiyo e tij Hemb Romo, <verse eid="NUM 4:35"/><verse number="36" style="v" sid="NUM 4:36"/>kokwan kaluwore gi dhoutgi, ne romo ji alufu ariyo mia abiriyo gi piero abich (2,750). <verse eid="NUM 4:36"/><verse number="37" style="v" sid="NUM 4:37"/>Mano e kar romb jogo duto mane oa e dhout jo-Kohath mane otiyo e Hemb Romo. Musa kod Harun nokwanogi kaluwore gi chik mane Jehova Nyasaye ogolo kokalo kuom Musa.<verse eid="NUM 4:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 4:38"/>Jo-Gershon nokwan kaluwore gi dhoutgi kod anywolagi.<verse eid="NUM 4:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 4:39"/>Chwo duto mahikgi piero adek nyaka piero abich mane obiro tich e Hemb Romo, <verse eid="NUM 4:39"/><verse number="40" style="v" sid="NUM 4:40"/>kokwan kaluwore gi dhoutgi kod anywolagi, ne romo ji alufu ariyo mia auchiel gi piero adek (2,630). <verse eid="NUM 4:40"/><verse number="41" style="v" sid="NUM 4:41"/>Mano e kar romb jogo mane oa e dhout anywola mar Gershon mane otiyo e Hemb Romo. Musa kod Harun nokwanogi kaluwore gi chik Jehova Nyasaye.<verse eid="NUM 4:41"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="42" style="v" sid="NUM 4:42"/>Jo-Merari nokwan kaluwore gi dhoutgi kod anywolagi.<verse eid="NUM 4:42"/></para>
  <para style="li2">
    <verse number="43" style="v" sid="NUM 4:43"/>Chwo duto mahikgi piero adek nyaka piero adek gabich mane obiro chiwo kony e tich mar Hemb Romo, <verse eid="NUM 4:43"/><verse number="44" style="v" sid="NUM 4:44"/>kokwan kaluwore gi dhoutgi ne romo ji alufu adek gi mia ariyo (3,200). <verse eid="NUM 4:44"/><verse number="45" style="v" sid="NUM 4:45"/>Ma e kar kwan joka Merari duto. Musa kod Harun nokwanogi kaluwore gi chik mane Jehova Nyasaye ochiwo kokalo kuom Musa.<verse eid="NUM 4:45"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="46" style="v" sid="NUM 4:46"/>Omiyo Musa, Harun kod jotend Israel nokwano jo-Lawi duto kaluwore gi dhoutgi kod anywolagi. <verse eid="NUM 4:46"/><verse number="47" style="v" sid="NUM 4:47"/>Chwo duto mahikgi piero adek nyaka piero abich mane obiro tiyo e Hemb Romo <verse eid="NUM 4:47"/><verse number="48" style="v" sid="NUM 4:48"/>ne romo ji alufu aboro mia abich gi piero aboro (8,580). <verse eid="NUM 4:48"/><verse number="49" style="v" sid="NUM 4:49"/>Kaluwore gi chik Jehova Nyasaye mane omiyo Musa, ngʼato ka ngʼato nomi tije.</para>
  <para style="b" vid="NUM 4:49"/>
  <para style="p" vid="NUM 4:49">Kuom mano nokwan-gi, mana kaka Jehova Nyasaye nochiko Musa.<verse eid="NUM 4:49"/></para>
  <chapter eid="NUM 4"/>
  <chapter number="5" style="c" sid="NUM 5"/>
  <para style="s1">Pwodhruok mar kambi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 5:1"/><verse number="2" style="v" sid="NUM 5:2"/>“Mi jo-Israel chik mondo oriemb ngʼato angʼata man-gi tuo mar del kata man-gi tuo magolo tutu kata ngʼat ma ok ler nikech osemulo ringre ngʼama otho. <verse eid="NUM 5:2"/><verse number="3" style="v" sid="NUM 5:3"/>Riemb chwo kod mon duto mondo giwuok oko mar kambi; kik ginjaw kambi nikech adak e diergi.” <verse eid="NUM 5:3"/><verse number="4" style="v" sid="NUM 5:4"/>Jo-Israel notimo kamano; mine giriembogi oko mar kambi. Negitimo mana kaka Jehova Nyasaye nosechiko Musa.<verse eid="NUM 5:4"/></para>
  <para style="s1">Chudo mar joketho</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 5:5"/><verse number="6" style="v" sid="NUM 5:6"/>“Wachne jo-Israel kama: ‘Ka dichwo kata dhako okwinyo wadgi e yo moro amora kendo obedo ngʼama ok ja-ratiro ne Jehova Nyasaye, ngʼatno oketho <verse eid="NUM 5:6"/><verse number="7" style="v" sid="NUM 5:7"/>kendo nyaka ohul richo mosetimono. Nyaka ochiw chudo duto mar kethone, omed achiel kuom abich ewi chudono bangʼe ochiwe duto ne ngʼat mosekethone. <verse eid="NUM 5:7"/><verse number="8" style="v" sid="NUM 5:8"/>Ka ngʼat ma okethneno onge gi watne moro amora ma inyalo mi chudono, to chudono en mar Jehova Nyasaye kendo nyaka chiwe ne jadolo, ka itere gi im ma ikwayonego pwodhruok kuom richo. <verse eid="NUM 5:8"/><verse number="9" style="v" sid="NUM 5:9"/>Chiwo duto mowal ma jo-Israel kelo gin mek jadolo. <verse eid="NUM 5:9"/><verse number="10" style="v" sid="NUM 5:10"/>Chiwo mowal mar ngʼato ka ngʼato en mare owuon, ka osechiwe ne jadolo nobed mar jadolo.’ ”<verse eid="NUM 5:10"/></para>
  <para style="s1">Tem mar dhako ma ok ja-ratiro</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11"/>Eka Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 5:11"/><verse number="12" style="v" sid="NUM 5:12"/>“Wuo gi jo-Israel kendo iwachnegi kama: ‘Ka chi ngʼato ok obedo ja-adiera kendo ok obedo ja-ratiro <verse eid="NUM 5:12"/><verse number="13" style="v" sid="NUM 5:13"/>mi oterore gi dichwo moro, kendo timni opandore ne chwore ma ok ongʼere (nikech onge janeno mane onene kendo ne ok omake randoo), <verse eid="NUM 5:13"/><verse number="14" style="v" sid="NUM 5:14"/>kendo ka nyiego omako chwor dhakono mi ochich kode, to chiegeno ochido, kata kapo ni nyiego omake kode kendo ochich kode kata obedo ni ok ochido, <verse eid="NUM 5:14"/><verse number="15" style="v" sid="NUM 5:15"/>to chworeno nyaka tere ir jadolo bed ni dhakono osedwanyore adier kata chwore chich mana kode kayiem. Bende nyaka oter chiwo mar achiel kuom apar mar efa mar mogo mar shairi e lo jaode. Ok onego ool mo kuome kata keto gima dungʼ tik mangʼwe ngʼar kuome, nikech en chiwo mar cham mar ketho chich, tiende ni en chiwo mifwenyogo adiera.<verse eid="NUM 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16"/>“ ‘Jadolo nokel dhakono mochungʼ e nyim Jehova Nyasaye. <verse eid="NUM 5:16"/><verse number="17" style="v" sid="NUM 5:17"/>Eka notuom pi maler e agulu kendo nojow buru moa e dier kama ler mar lemo mi okwo e pigno. <verse eid="NUM 5:17"/><verse number="18" style="v" sid="NUM 5:18"/>Bangʼ ka jadolo osekelo dhakono mochungʼ e nyim Jehova Nyasaye, enogony yie wiye eka noket chiwo mifwenyogo adiera e lwete ma en chiwo mar cham mitiekogo chich. Jadolo to notingʼ pi mar muma mifwenyogo adiera e lwete owuon. <verse eid="NUM 5:18"/><verse number="19" style="v" sid="NUM 5:19"/>Eka jadolo noket dhakono kwongʼre kowacho niya, “Kaonge dichwo moseterore kodi kendo pod ok ibedo ja-adiera mibedo modwanyore kendo weyo yo ma ibedo mogak ka ingʼeyo ni in dhako man kod chwore, to mad pi makechni makelo kwongʼ kik hinyi. <verse eid="NUM 5:19"/><verse number="20" style="v" sid="NUM 5:20"/>To ka en adier ni isedwanyori, mi ngʼato oterore kodi, kingʼeyo ni in chi ngʼato,” <verse eid="NUM 5:20"/><verse number="21" style="v" sid="NUM 5:21"/>to jadolo nokwongʼ dhakono niya, “Jehova Nyasaye mondo omi iyi ogore piny, kata omi ibwog nyathi ka kindene mar nywol pok ochopo, kibedogo ranyisi ne jou kuom wach kwongʼruok. <verse eid="NUM 5:21"/><verse number="22" style="v" sid="NUM 5:22"/>Mad pigni donj e iyi kendo omi iyi kirre kata omi ibwog nyathi ka kinde mar nywolne pok ochopo.”</para>
  <para style="p" vid="NUM 5:22">“ ‘Bangʼe dhakono nodwok kawacho niya, “Amin. Mad obed kamano.”<verse eid="NUM 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23"/>“ ‘Nyaka jadolo ndik kwongʼ-gi e Kitabu bangʼe olingʼ-gi ei pi makechno. <verse eid="NUM 5:23"/><verse number="24" style="v" sid="NUM 5:24"/>Enoket dhakono mondo omodh pi makech makelo kwongʼ, kendo pigni nodonj e iye mi kelne sand mager. <verse eid="NUM 5:24"/><verse number="25" style="v" sid="NUM 5:25"/>Jadolo nokaw chiwo mar cham mar golo chich koa e lwet dhakono, mi nofwaye e nyim Jehova Nyasaye kendo okele e kendo mar misango. <verse eid="NUM 5:25"/><verse number="26" style="v" sid="NUM 5:26"/>Eka jadolo nojuk chiwo mar cham mopongʼo lwete kaka chiwo mar rapar kendo nowangʼe ewi kendo mar misango; bangʼ mano, noket dhakono omodh pigno. <verse eid="NUM 5:26"/><verse number="27" style="v" sid="NUM 5:27"/>Ka dipo ni osedwanyore en owuon kendo ok osebedo ja-ratiro ne chwore, to nokete omodh pigno makelo kwongʼ, kendo ma nomi obed gi sand mager; ma mi obwog nyathi ka ndalone pok ochopo kendo ngʼama okwongʼ e kind ogandane. <verse eid="NUM 5:27"/><verse number="28" style="v" sid="NUM 5:28"/>To ka dipo ni dhakono ok odwanyore kendo ok ochido, nokete thuolo mi ochak onywol nyithindo kendo.<verse eid="NUM 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29"/>“ ‘Ma e chik mar tieko chich ka dhako ok ja-adiera kendo odwanyore, kongʼeyo ni pod en dhako man-gi chwore, <verse eid="NUM 5:29"/><verse number="30" style="v" sid="NUM 5:30"/>kata ka gimoro otimore ma chwore ochich kode. Jadolo nokete ochungʼ e nyim Jehova Nyasaye kendo nyaka oket chikni ne dhakoni. <verse eid="NUM 5:30"/><verse number="31" style="v" sid="NUM 5:31"/>Dichwo nobed maonge ketho moro amora, to dhakono ibiro kum ne richo mage.’ ”<verse eid="NUM 5:31"/></para>
  <chapter eid="NUM 5"/>
  <chapter number="6" style="c" sid="NUM 6"/>
  <para style="s1">Ngʼat mowal ne ruoth kaka ja-Nazir</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 6:1"/><verse number="2" style="v" sid="NUM 6:2"/>“Wuo kod jo-Israel kendo inyisgi kama: ‘Ka dichwo kata dhako dwaro chiwo singruok makende, ma en singruok makende ne Jehova Nyasaye kaka ja-Nazir, <verse eid="NUM 6:2"/><verse number="3" style="v" sid="NUM 6:3"/>to nyaka owe madho divai kod math mamoko moket e thowi kendo ok onego omadh kongʼo kata kongʼo moa kuom math mamoko moket e thowi. Ok onego omadh gimoro amora molos gi olemb mzabibu, kata chamo olemb mzabibu manumu kata motwo. <verse eid="NUM 6:3"/><verse number="4" style="v" sid="NUM 6:4"/>E kinde duto ma en ja-Nazir, ok onego ocham gimoro amora mowuok kuom olemb mzabibu, bed ni en kothe kata opokone.<verse eid="NUM 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5"/>“ ‘E thuoloni duto ma en e bwo singruok mar bedo tenge, wiye ok noliel gi wembe. Enorite maler ne Jehova Nyasaye nyaka ndalone mag kwongʼruok norum; kendo enopidh yie wiye maboyo.<verse eid="NUM 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 6:6"/>“ ‘E thuoloni duto ma en e bwo singruok mar bedo tenge ne Jehova Nyasaye, ok onego osud machiegni gi ringre ngʼama otho. <verse eid="NUM 6:6"/><verse number="7" style="v" sid="NUM 6:7"/>Bed ni wuon-gi kata min-gi kata owadgi kata nyamin-gi ema otho, to ok onego obed mogak, nikech ranyisi mar bedo ngʼat mowal ne Nyasaye ni e wiye. <verse eid="NUM 6:7"/><verse number="8" style="v" sid="NUM 6:8"/>E kindeno duto ma okete tenge, en ngʼama owal ne Jehova Nyasaye.<verse eid="NUM 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9"/>“ ‘Ka dipo ni ngʼato otho bute, mi yie wiye mosewal ogak, to nyaka oliel yie wiyeno chiengʼ mar abiriyo mipwodhee. <verse eid="NUM 6:9"/><verse number="10" style="v" sid="NUM 6:10"/>To chiengʼ mar aboro nyaka okel akuch odugla ariyo kata nyithi akuru ne jadolo e dhoranga Hemb Romo. <verse eid="NUM 6:10"/><verse number="11" style="v" sid="NUM 6:11"/>Jadolo nochiw achiel kaka misango mar golo richo to machielo kaka misango miwangʼo pep mar kwayone ngʼwono nikech notimo richo kuom bedo kama ringre ngʼama otho nitie. E odiechiengno nyaka opwodh wiye. <verse eid="NUM 6:11"/><verse number="12" style="v" sid="NUM 6:12"/>E kindeno duto mokete tenge nyaka ochiwre ne Jehova Nyasaye kendo okel nyaim ma hike achiel kaka misango michiwo mar pwodhruok e ketho. To kinde mane osetieko kowale ok nokwan nikech yie wiye mane nyiso ni owaleno ne odoko mogak.<verse eid="NUM 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13"/>“ ‘Koro mano e chik momi ja-Nazir ka kinde mokete tenge orumo kendo nyaka kele e dhoranga Hemb Romo. <verse eid="NUM 6:13"/><verse number="14" style="v" sid="NUM 6:14"/>E dhorangach kanyo ema nyaka ochiwe misangone ne Jehova Nyasaye ma gin: nyaim ma hike achiel maonge songa kaka misango miwangʼo pep, sibini ma hike achiel maonge songa kaka misango migologo richo; im maonge songa kaka chiwo mar lalruok, <verse eid="NUM 6:14"/><verse number="15" style="v" sid="NUM 6:15"/>kaachiel gi chiwo mar cham kod misango miolo piny, kod okapu mopongʼ gi makati ma ok oketie thowi kaka kek molos gi mogo mayom moru gi mo, kod chapat mowir gi mo.<verse eid="NUM 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 6:16"/>“ ‘Jadolo nochiwgi e nyim Jehova Nyasaye kaka misango mar pwodhruok e richo kod misango miwangʼo pep. <verse eid="NUM 6:16"/><verse number="17" style="v" sid="NUM 6:17"/>Bende nochiw okapu man-gi makati ma ok oketie thowi kod im kaka misango mar lalruok ne Jehova Nyasaye, kaachiel gi chiwo mar cham kod misango miolo piny.<verse eid="NUM 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 6:18"/>“ ‘Bangʼe e dhoranga Hemb Romo, ja-Nazirno nyaka liel yie wiye mane osewal tenge. Enokaw yie wiyeno mi olute e mach mantiere e bwo misango mar chiwo mar lalruok.<verse eid="NUM 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 6:19"/>“ ‘Bangʼ ka ja-Nazirno oselielo yie wiye mane osewal tenge, jadolo nomiye bad im mosechwaki, kod kek kod chapat mogoloe okapu, mago molos ma ok oketie thowi. <verse eid="NUM 6:19"/><verse number="20" style="v" sid="NUM 6:20"/>Bangʼ mano jadolo noliergi e nyim Jehova Nyasaye kaka misango mifwayo; kaachiel gi agoko kod em mane olier nimar gin gik mopwodhi kendo gin mek jadolo. Bangʼ timo kamano, ja-Nazir koro nyalo mana madho divai.<verse eid="NUM 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21"/>“ ‘Mano e chik momako ja-Nazir mosekwongʼore kaluwore gi pwodhruok mare kendo mano e misango manyaka otimne Jehova Nyasaye kaachiel gi gimoro monyalo chiwo. Nyaka ochop singo mar kwongʼruok mane ochiwo, kaluwore gi chik mar ja-Nazir.’ ”<verse eid="NUM 6:21"/></para>
  <para style="s1">Gweth mar jadolo</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 6:22"/><verse number="23" style="v" sid="NUM 6:23"/>“Nyis Harun kod yawuote ni, ‘Ma e kaka onego ugwedh jo-Israel. Wachnegi kama:<verse eid="NUM 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 6:24"/>“ ‘Jehova Nyasaye mondo ogwedhu</para>
  <para style="q2" vid="NUM 6:24">kendo oritu;<verse eid="NUM 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 6:25"/>Wangʼ Jehova Nyasaye mondo orieny kuomu</para>
  <para style="q2" vid="NUM 6:25">kendo omiu ngʼwono mogundho;<verse eid="NUM 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 6:26"/>Jehova Nyasaye orangu maber</para>
  <para style="q2" vid="NUM 6:26">kendo omiu kwe.’ <verse eid="NUM 6:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27"/>“Kamano e kaka ginihul nyinga kuom jo-Israel, kendo anagwedhgi.”<verse eid="NUM 6:27"/></para>
  <chapter eid="NUM 6"/>
  <chapter number="7" style="c" sid="NUM 7"/>
  <para style="s1">Chiwo mar walo hekalu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1"/>Kane Musa osetieko gero hekalu, nogwedhe, kendo owale gi gik moko duto manie iye. Bende nogwedho kendo owalo kar kendo mar misango kod gik moko duto mitiyogo e kendono. <verse eid="NUM 7:1"/><verse number="2" style="v" sid="NUM 7:2"/>Eka jotelo mag Israel, ma gin jotelo mag anywola ma bende ema jotend dhoudi mane ochungʼ ne jogo mane okwan, nochiwo misengini. <verse eid="NUM 7:2"/><verse number="3" style="v" sid="NUM 7:3"/>Chiwo mane gikelo e nyim Jehova Nyasaye ne gin geche auchiel moum wiye gi rwedhi mabwoch apar gariyo. Jatelo ka jatelo nogolo rwadh bwoch achiel bende jotelo ariyo noriwore mochiwo gari achiel moum wiye. Gigi duto negikelo e nyim hekalu.<verse eid="NUM 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 7:4"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 7:4"/><verse number="5" style="v" sid="NUM 7:5"/>“Kaw gigi koa kuomgi, mondo iti kodgi e tij Hemb Romo. Migi jo-Lawi kaluwore gi tich ngʼato ka ngʼato.”<verse eid="NUM 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 7:6"/>Omiyo Musa nokawo gechego kod rwedhi ma buochgo mi ochiwogi ne jo-Lawi. <verse eid="NUM 7:6"/><verse number="7" style="v" sid="NUM 7:7"/>Nomiyo jo-Gershon geche ariyo kod rwedhi mabwoch angʼwen, kaluwore gi tijgi, <verse eid="NUM 7:7"/><verse number="8" style="v" sid="NUM 7:8"/>kendo nomiyo jo-Merari geche angʼwen kod rwedhi mabwoch aboro, kaluwore gi tijgi. Giduto ne gin e bwo loch Ithamar ma wuod Harun jadolo. <verse eid="NUM 7:8"/><verse number="9" style="v" sid="NUM 7:9"/>To joka Kohath, Musa ne ok omiyogi gimoro amora nikech tich mane omigi ne en mar tingʼo gik maler.<verse eid="NUM 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10"/>Kane osegwedh kendo mar misango, jotelo nokelo chiwo mag-gi mag gweth kendo nochiwgi e nyim kendo mar misango. <verse eid="NUM 7:10"/><verse number="11" style="v" sid="NUM 7:11"/>Nimar Jehova Nyasaye nosewacho ne Musa niya, “Odiechiengʼ ka odiechiengʼ jatelo achiel nyaka kel misango mare mar gwedho kendo mar misango.”<verse eid="NUM 7:11"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="12" style="v" sid="NUM 7:12"/>Ngʼatno mane okelo misango mare e odiechiengʼ mokwongo ne en Nashon wuod Aminadab moa e dhood Juda.<verse eid="NUM 7:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 7:13"/>Chiwo mare ne en</para>
  <para style="li2" vid="NUM 7:13">san achiel mar fedha ma pekne en shekel mia achiel gi piero adek, kod bakul achiel mar fedha mokuoyogo pi ma pekne en shekel piero abiriyo. Magi nokel kaluwore gi shekel mar kama ler mar lemo, ka moro ka moro opongʼ gi mogo mayom moru gi mo kaka chiwo mar cham;<verse eid="NUM 7:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="NUM 7:14"/>bakul achiel mar dhahabu ma pekne en shekel apar, mopongʼ gi mo mangʼwe ngʼar;<verse eid="NUM 7:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="NUM 7:15"/>rwath matin achiel, im achiel kod nyaim achiel matin ma hike achiel, nochiw misango miwangʼo pep;<verse eid="NUM 7:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="NUM 7:16"/>nywok achiel mar kaka misango mar golo richo;<verse eid="NUM 7:16"/></para>
  <para style="li2">
    <verse number="17" style="v" sid="NUM 7:17"/>kod rwedhi ariyo, imbe abich, nywogi abich kod nyiimbe abich mahikgi oromo higa achiel, nochiw kaka misango mar lalruok.</para>
  <para style="li4" vid="NUM 7:17">Magi e misengini mane Nashon wuod Aminadab ogolo.<verse eid="NUM 7:17"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="18" style="v" sid="NUM 7:18"/>Nethanel wuod Zuar, ma jatend Isakar nokelo misango mare e odiechiengʼ mar ariyo.<verse eid="NUM 7:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="NUM 7:19"/>Misango mane okelo ne en</para>
  <para style="li2" vid="NUM 7:19">san achiel mar fedha ma pekne ne en shekel mia achiel gi piero adek, kod bakul achiel mar kwoyo pi mar fedha ma pekne en shekel piero abiriyo. Magi nokel kaluwore gi shekel mar kama ler mar lemo, ka moro ka moro opongʼ gi mogo mayom moru gi mo kaka chiwo mar cham;<verse eid="NUM 7:19"/></para>
  <para style="li2">
    <verse number="20" style="v" sid="NUM 7:20"/>bakul achiel mar dhahabu ma pekne en shekel apar, mopongʼ gi mo mangʼwe ngʼar;<verse eid="NUM 7:20"/></para>
  <para style="li2">
    <verse number="21" style="v" sid="NUM 7:21"/>nyarwath achiel, im achiel kod nyaim achiel ma hike achiel, kaka misango miwangʼo pep;<verse eid="NUM 7:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="NUM 7:22"/>nywok achiel kaka misango mar golo richo;<verse eid="NUM 7:22"/></para>
  <para style="li2">
    <verse number="23" style="v" sid="NUM 7:23"/>kod rwedhi mabwoch ariyo, imbe abich, nywogi abich kod nyiimbe abich mahikgi achiel, nochiw kaka misango mar lalruok.</para>
  <para style="li4" vid="NUM 7:23">Magi e misengini mane Nethanel wuod Zuar ogolo.<verse eid="NUM 7:23"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="24" style="v" sid="NUM 7:24"/>Eliab wuod Helon, ma jatend jo-Zebulun nokelo misango mare e odiechiengʼ mar adek.<verse eid="NUM 7:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 7:25"/>Misango mane okelo ne en san achiel mar fedha</para>
  <para style="li2" vid="NUM 7:25">ma pekne ne en shekel mia achiel gi piero adek, kod bakul achiel mar fedha mar kwoyo pi ma pekne en shekel piero abiriyo. Giduto nokel kaluwore gi shekel mar kama ler mar lemo, ka moro ka moro opongʼ gi mogo moru gi mo kaka misango mar cham;<verse eid="NUM 7:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="NUM 7:26"/>bakul achiel mar dhahabu ma pekne ne en shekel apar, mopongʼ gi mo mangʼwe ngʼar;<verse eid="NUM 7:26"/></para>
  <para style="li2">
    <verse number="27" style="v" sid="NUM 7:27"/>nyarwath achiel, im achiel kod nyaim achiel ma hike achiel kaka misango miwangʼo pep;<verse eid="NUM 7:27"/></para>
  <para style="li2">
    <verse number="28" style="v" sid="NUM 7:28"/>nywok achiel kaka misango mar golo richo;<verse eid="NUM 7:28"/></para>
  <para style="li2">
    <verse number="29" style="v" sid="NUM 7:29"/>kod rwedhi mabwoch ariyo, imbe abich, nywogi abich gi nyiimbe abich ma jo-higa achiel, nochiw misango mar lalruok.</para>
  <para style="li4" vid="NUM 7:29">Magi e misengini mane Eliab wuod Helon ogolo.<verse eid="NUM 7:29"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="30" style="v" sid="NUM 7:30"/>Elizur wuod Shedeur, ma jatend joka Reuben nokelo misango mare e odiechiengʼ mar angʼwen.<verse eid="NUM 7:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="NUM 7:31"/>Misango mane okelo ne en</para>
  <para style="li2" vid="NUM 7:31">san achiel mar fedha ma pekne ne en shekel mia achiel gi piero adek, kod bakul achiel mar fedha mar kwoyo pi ma pekne en shekel piero abiriyo. Mago nokel ka giluwore gi shekel mar kama ler mar lemo, ka moro ka moro opongʼ gi mogo mayom moru gi mo kaka misango mar cham;<verse eid="NUM 7:31"/></para>
  <para style="li2">
    <verse number="32" style="v" sid="NUM 7:32"/>bakul achiel mar dhahabu ma pekne en shekel apar, mopongʼ gi mo mangʼwe ngʼar;<verse eid="NUM 7:32"/></para>
  <para style="li2">
    <verse number="33" style="v" sid="NUM 7:33"/>rwath matin achiel, im achiel kod nyaim achiel matin ma hike achiel, nochiw kaka misango miwangʼo pep;<verse eid="NUM 7:33"/></para>
  <para style="li2">
    <verse number="34" style="v" sid="NUM 7:34"/>nywok achiel kaka misango mar golo richo;<verse eid="NUM 7:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="NUM 7:35"/>kod rwedhi ariyo, imbe abich, nywogi abich kod nyiimbe mahikgi oromo higa achiel, nochiw kaka misango mar lalruok.</para>
  <para style="li4" vid="NUM 7:35">Magi e misengini mane Elizur wuod Shedeur ochiwo.<verse eid="NUM 7:35"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="36" style="v" sid="NUM 7:36"/>Shelumiel wuod Zurishadai, ma jatend joka Simeon nokelo misango mare e odiechiengʼ mar abich.<verse eid="NUM 7:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="NUM 7:37"/>Misango mane okelo ne en</para>
  <para style="li2" vid="NUM 7:37">san achiel mar fedha ma pekne ne en shekel mia achiel gi piero adek, kod bakul achiel mar fedha mar kwoyo pi ma pekne en shekel piero abiriyo. Mago nokel kaluwore gi shekel mar kama ler mar lemo, ka moro ka moro opongʼ gi mogo mayom moru gi mo kaka misango mar cham;<verse eid="NUM 7:37"/></para>
  <para style="li2">
    <verse number="38" style="v" sid="NUM 7:38"/>bakul achiel mar dhahabu ma pekne en shekel apar, mopongʼ gi mo mangʼwe ngʼar;<verse eid="NUM 7:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 7:39"/>rwath matin achiel, im achiel kod nyaim matin achiel ma hike achiel, nochiw kaka misango miwangʼo pep;<verse eid="NUM 7:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="NUM 7:40"/>nywok achiel kaka misango mar golo richo;<verse eid="NUM 7:40"/></para>
  <para style="li2">
    <verse number="41" style="v" sid="NUM 7:41"/>gi rwedhi ariyo, imbe abich, nywogi abich kod nyiimbe mahikgi oromo higa achiel, nochiw kaka misango mar lalruok.</para>
  <para style="li4" vid="NUM 7:41">Magi e misengini mane Shelumiel wuod Zurishadai ochiwo.<verse eid="NUM 7:41"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="42" style="v" sid="NUM 7:42"/>Eliasaf wuod Dewel, ma jatend joka Gad nokelo misango mare e odiechiengʼ mar auchiel.<verse eid="NUM 7:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="NUM 7:43"/>Misango mane okelo ne en</para>
  <para style="li2" vid="NUM 7:43">san achiel mar fedha ma pekne ne en shekel mia achiel gi piero adek, kod bakul achiel mar fedha mar kwoyo pi ma pekne en shekel piero abiriyo. Mago nokel kaluwore gi shekel mar kama ler mar lemo, ka moro ka moro opongʼ gi mogo mayom moru gi mo kaka misango mar cham;<verse eid="NUM 7:43"/></para>
  <para style="li2">
    <verse number="44" style="v" sid="NUM 7:44"/>bakul achiel mar dhahabu ma pekne en shekel apar, mopongʼ gi mo mangʼwe ngʼar;<verse eid="NUM 7:44"/></para>
  <para style="li2">
    <verse number="45" style="v" sid="NUM 7:45"/>rwath matin achiel, im achiel kod nyaim matin achiel ma hike achiel, nochiw kaka misango miwangʼo pep;<verse eid="NUM 7:45"/></para>
  <para style="li2">
    <verse number="46" style="v" sid="NUM 7:46"/>nywok kaka misango mar golo richo;<verse eid="NUM 7:46"/></para>
  <para style="li2">
    <verse number="47" style="v" sid="NUM 7:47"/>gi rwedhi mabwoch ariyo, imbe abich, nywogi abich kod nyiimbe abich ma jo-higa achiel, nochiw kaka misango mar lalruok.</para>
  <para style="li4" vid="NUM 7:47">Magi e misengini mane Eliasaf wuod Dewel ochiwo.<verse eid="NUM 7:47"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="48" style="v" sid="NUM 7:48"/>Elishama wuod Amihud, ma jatend joka Efraim nokelo misango mare e odiechiengʼ mar abiriyo.<verse eid="NUM 7:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="NUM 7:49"/>Misango mare mane okelo ne en</para>
  <para style="li2" vid="NUM 7:49">san achiel mar fedha ma pekne ne en shekel mia achiel gi piero adek, kod bakul achiel mar fedha mar kwoyo pi ma pekne en shekel piero abiriyo. Mago nokel kaluwore gi shekel mar kama ler mar lemo, ka moro ka moro opongʼ gi mogo mayom moru gi mo kaka misango mar cham;<verse eid="NUM 7:49"/></para>
  <para style="li2">
    <verse number="50" style="v" sid="NUM 7:50"/>bakul achiel mar dhahabu ma pekne ne en shekel apar, mopongʼ gi mo mangʼwe ngʼar;<verse eid="NUM 7:50"/></para>
  <para style="li2">
    <verse number="51" style="v" sid="NUM 7:51"/>rwath matin achiel, im achiel kod nyaim matin achiel ma hike achiel, nochiw kaka misango miwangʼo pep;<verse eid="NUM 7:51"/></para>
  <para style="li2">
    <verse number="52" style="v" sid="NUM 7:52"/>nywok achiel kaka misango mar golo richo;<verse eid="NUM 7:52"/></para>
  <para style="li2">
    <verse number="53" style="v" sid="NUM 7:53"/>gi rwedhi mabwoch ariyo, imbe abich, nywogi abich kod nyiimbe abich ma jo-higa achiel, nochiw kaka misango mar lalruok.</para>
  <para style="li4" vid="NUM 7:53">Mago e misengini mane Elishama wuod Amihud ochiwo.<verse eid="NUM 7:53"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="54" style="v" sid="NUM 7:54"/>Gamaliel wuod Pedazur, ma jatend joka Manase, nokelo misango mare e odiechiengʼ mar aboro.<verse eid="NUM 7:54"/></para>
  <para style="li1">
    <verse number="55" style="v" sid="NUM 7:55"/>Misango mane okelo ne en</para>
  <para style="li2" vid="NUM 7:55">san achiel mar fedha ma pekne en shekel mia achiel gi piero adek, kod bakul achiel mar fedha mar kwoyo pi ma pekne en shekel piero abiriyo. Mago nokel kaluwore gi shekel mar kama ler mar lemo, ka moro ka moro opongʼ gi mogo mayom moru gi mo kaka misango mar cham;<verse eid="NUM 7:55"/></para>
  <para style="li2">
    <verse number="56" style="v" sid="NUM 7:56"/>bakul achiel mar dhahabu ma pekne en shekel apar, mopongʼ gi mo mangʼwe ngʼar;<verse eid="NUM 7:56"/></para>
  <para style="li2">
    <verse number="57" style="v" sid="NUM 7:57"/>rwath matin achiel, im achiel kod nyaim matin achiel ma hike achiel, nochiw kaka misango miwangʼo pep;<verse eid="NUM 7:57"/></para>
  <para style="li2">
    <verse number="58" style="v" sid="NUM 7:58"/>nywok achiel kaka misango mar golo richo;<verse eid="NUM 7:58"/></para>
  <para style="li2">
    <verse number="59" style="v" sid="NUM 7:59"/>gi rwedhi mabwoch ariyo, imbe abich, nywogi abich, kod nyiimbe abich ma jo-higa achiel, nochiw kaka misango mar lalruok.</para>
  <para style="li4" vid="NUM 7:59">Mago e misengini mane Gamaliel wuod Pedazur ochiwo.<verse eid="NUM 7:59"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="60" style="v" sid="NUM 7:60"/>Abidan wuod Gideoni, ma jatend joka Benjamin, nokelo misango mare e odiechiengʼ mar ochiko.<verse eid="NUM 7:60"/></para>
  <para style="li1">
    <verse number="61" style="v" sid="NUM 7:61"/>Misango mane okelo ne en</para>
  <para style="li2" vid="NUM 7:61">san achiel mar fedha ma pekne ne en shekel mia achiel gi piero adek, kod bakul mar fedha mar kwoyo pi ma pekne ne en shekel piero abiriyo. Mago nokel kaluwore gi shekel mar kama ler mar lemo, ka moro ka moro opongʼ gi mogo mayom moru gi mo kaka misango mar cham;<verse eid="NUM 7:61"/></para>
  <para style="li2">
    <verse number="62" style="v" sid="NUM 7:62"/>bakul achiel mar dhahabu ma pekne en shekel apar, mopongʼ gi mo mangʼwe ngʼar;<verse eid="NUM 7:62"/></para>
  <para style="li2">
    <verse number="63" style="v" sid="NUM 7:63"/>rwath matin achiel, im achiel kod nyaim achiel ma hike achiel, nochiw kaka misango miwangʼo pep;<verse eid="NUM 7:63"/></para>
  <para style="li2">
    <verse number="64" style="v" sid="NUM 7:64"/>nywok achiel kaka misango mar golo richo;<verse eid="NUM 7:64"/></para>
  <para style="li2">
    <verse number="65" style="v" sid="NUM 7:65"/>gi rwedhi mabwoch ariyo, imbe abich, nywogi abich gi nyiimbe abich ma jo-higa achiel, nochiw kaka misango mar lalruok.</para>
  <para style="li4" vid="NUM 7:65">Mago e misengini mane Abidan wuod Gideoni ochiwo.<verse eid="NUM 7:65"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="66" style="v" sid="NUM 7:66"/>Ahiezer wuod Amishadai, ma jatend joka Dan, nokelo misango mare e odiechiengʼ mar apar.<verse eid="NUM 7:66"/></para>
  <para style="li1">
    <verse number="67" style="v" sid="NUM 7:67"/>Misango mane okelo ne en</para>
  <para style="li2" vid="NUM 7:67">san achiel mar fedha ma pekne ne en shekel mia achiel gi piero adek, kod bakul achiel mar fedha mar kwoyo pi ma pekne ne en shekel piero abiriyo. Mago nokel kaluwore gi shekel mar kama ler mar lemo, ka moro ka moro opongʼ gi mogo mayom moru gi mo kaka misango mar cham;<verse eid="NUM 7:67"/></para>
  <para style="li2">
    <verse number="68" style="v" sid="NUM 7:68"/>bakul achiel mar dhahabu ma pekne ne en shekel apar, mopongʼ gi mo mangʼwe ngʼar;<verse eid="NUM 7:68"/></para>
  <para style="li2">
    <verse number="69" style="v" sid="NUM 7:69"/>rwath matin achiel, im achiel kod nyaim matin achiel ma hike achiel, nochiw kaka misango miwangʼo pep;<verse eid="NUM 7:69"/></para>
  <para style="li2">
    <verse number="70" style="v" sid="NUM 7:70"/>nywok achiel kaka misango mar golo richo;<verse eid="NUM 7:70"/></para>
  <para style="li2">
    <verse number="71" style="v" sid="NUM 7:71"/>gi rwedhi mabwoch ariyo, imbe abich, nywogi abich gi nyiimbe abich ma jo-higa achiel, nochiw kaka misango mar lalruok.</para>
  <para style="li4" vid="NUM 7:71">Mago e misengini mane Ahiezer wuod Amishadai ogolo.<verse eid="NUM 7:71"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="72" style="v" sid="NUM 7:72"/>Pagiel wuod Okran, ma jatend joka Asher, nokelo misango mare odiechiengʼ mar apar gachiel.<verse eid="NUM 7:72"/></para>
  <para style="li1">
    <verse number="73" style="v" sid="NUM 7:73"/>Misango mane okelo ne en</para>
  <para style="li2" vid="NUM 7:73">san achiel mar fedha ma pekne ne en shekel mia achiel gi piero adek, kod bakul achiel mar fedha mar kwoyo pi ma pekne ne en shekel piero abiriyo. Mago nokel kaluwore gi shekel mar kama ler mar lemo, ka moro ka moro opongʼ gi mogo mayom moru gi mo kaka misango mar cham;<verse eid="NUM 7:73"/></para>
  <para style="li2">
    <verse number="74" style="v" sid="NUM 7:74"/>bakul achiel mar dhahabu ma pekne ne en shekel apar, mopongʼ gi mo mangʼwe ngʼar;<verse eid="NUM 7:74"/></para>
  <para style="li2">
    <verse number="75" style="v" sid="NUM 7:75"/>rwath matin achiel, im achiel kod nyaim achiel ma hike achiel, nochiw kaka misango miwangʼo pep;<verse eid="NUM 7:75"/></para>
  <para style="li2">
    <verse number="76" style="v" sid="NUM 7:76"/>nywok achiel kaka misango mar golo richo;<verse eid="NUM 7:76"/></para>
  <para style="li2">
    <verse number="77" style="v" sid="NUM 7:77"/>gi rwedhi mabwoch ariyo, imbe abich, nywogi abich gi nyiimbe abich ma jo-higa achiel, nochiw kaka misango mar lalruok.</para>
  <para style="li4" vid="NUM 7:77">Mago e misengini mane Pagiel wuod Okran ochiwo.<verse eid="NUM 7:77"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="78" style="v" sid="NUM 7:78"/>Ahira wuod Enan, ma jatend joka Naftali, nokelo misango mare e odiechiengʼ mar apar gariyo.<verse eid="NUM 7:78"/></para>
  <para style="li1">
    <verse number="79" style="v" sid="NUM 7:79"/>Misango mare mane okelo ne en</para>
  <para style="li2" vid="NUM 7:79">san achiel mar fedha ma pekne ne en shekel mia achiel gi piero adek, kod bakul achiel mar fedha mar kwoyo pi ma pekne ne en shekel piero abiriyo. Mago nokel kaluwore gi shekel mar kama ler mar lemo, ka moro ka moro opongʼ gi mogo mayom moru gi mo kaka misango mar cham;<verse eid="NUM 7:79"/></para>
  <para style="li2">
    <verse number="80" style="v" sid="NUM 7:80"/>bakul achiel mar dhahabu ma pekne ne en shekel apar, mopongʼ gi mo mangʼwe ngʼar; <verse eid="NUM 7:80"/><verse number="81" style="v" sid="NUM 7:81"/>nyarwath achiel, im achiel kod nyaim achiel ma hike achiel, nochiw misango miwangʼo pep;<verse eid="NUM 7:81"/></para>
  <para style="li2">
    <verse number="82" style="v" sid="NUM 7:82"/>nywok achiel kaka misango mar golo richo;<verse eid="NUM 7:82"/></para>
  <para style="li2">
    <verse number="83" style="v" sid="NUM 7:83"/>gi rwedhi mabwoch ariyo, imbe abich, nywogi abich kod nyiimbe abich ma jo-higa achiel, nochiw kaka misango mar lalruok.</para>
  <para style="li4" vid="NUM 7:83">Mago e misengini mane Ahira wuod Enan ochiwo.<verse eid="NUM 7:83"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="84" style="v" sid="NUM 7:84"/>Misengini mane jotend jo-Israel okelo e kinde mane ogwedh kendo mar misango e magi:</para>
  <para style="li2" vid="NUM 7:84">sende mag fedha apar gariyo, bakunde mag fedha mag kwoyo pi apar gariyo kod dise mag dhahabu apar gariyo. <verse eid="NUM 7:84"/><verse number="85" style="v" sid="NUM 7:85"/>San ka san mar fedha pekne ne en shekel mia achiel gi piero adek, kendo bakul ka bakul mar kwoyo pi pekne ne en shekel piero abiriyo. Dise duto mag fedha pekgi noromo shekel alufu ariyo gi mia angʼwen (2,400), kaluwore gi shekel mar kama ler mar lemo. <verse eid="NUM 7:85"/><verse number="86" style="v" sid="NUM 7:86"/>Dise apar gariyo mag dhahabu mane opongʼ gi mo mangʼwe ngʼar pekgi noromo shekel apar moro ka moro, kaluwore gi shekel mar kama ler mar lemo. Dise duto mag dhahabu pekgi noromo shekel mia achiel gi piero ariyo.<verse eid="NUM 7:86"/></para>
  <para style="li2">
    <verse number="87" style="v" sid="NUM 7:87"/>Kar kwan mar jamni mane ochiw kaka misango miwangʼo pep noromo nyirwedhi apar gariyo, imbe apar gariyo kod nyiimbe apar gariyo mahikgi achiel, kaachiel gi misango mag cham. Nywogi apar gariyo notigo kaka misango mar golo richo.<verse eid="NUM 7:87"/></para>
  <para style="li2">
    <verse number="88" style="v" sid="NUM 7:88"/>Kar kwan jamni duto mane ochiw kaka misango mar lalruok noromo rwedhi mabwoch piero ariyo gangʼwen, imbe piero auchiel, nywogi piero auchiel kod nyiimbe piero auchiel ma jo-higa achiel.</para>
  <para style="b" vid="NUM 7:88"/>
  <para style="li4" vid="NUM 7:88">Magi e misengini mane ochiw e kendo mar misango kane osepwodhe.<verse eid="NUM 7:88"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89"/>Kane Musa odonjo e Hemb Romo mondo owuo gi Jehova Nyasaye, nowinjo dwond Jehova Nyasaye kawuoyo kode koa e kind kerubi ariyo manie wi raum mar Sandug Muma mar Singruok. Kendo Musa nowuoyo kode.<verse eid="NUM 7:89"/></para>
  <chapter eid="NUM 7"/>
  <chapter number="8" style="c" sid="NUM 8"/>
  <para style="s1">Keto teyni kuonde mowinjore</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 8:1"/><verse number="2" style="v" sid="NUM 8:2"/>“Wuo gi Harun kendo iwachne kama: ‘Ka iketo teyni abiriyo kuonde mowinjore, to nyaka ler margi meny nyim rachung taya.’ ”<verse eid="NUM 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 8:3"/>Harun notimo kamano; noketo teyni kuonde mowinjore ka gimenyo nyim rachung taya, mana kaka Jehova Nyasaye nosechiko Musa. <verse eid="NUM 8:3"/><verse number="4" style="v" sid="NUM 8:4"/>Ma e kaka rachung taya nolosi: Nolose gi dhahabu mothedhi chakre e bwoye nyaka wiye malo. Rachung taya nolosi mana kaka ranyisi mane Jehova Nyasaye osenyiso Musa.<verse eid="NUM 8:4"/></para>
  <para style="s1">Walo jo-Lawi tenge</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 8:5"/><verse number="6" style="v" sid="NUM 8:6"/>“Wal jo-Lawi e kind jo-Israel mamoko kendo pwodhgi gibed maler. <verse eid="NUM 8:6"/><verse number="7" style="v" sid="NUM 8:7"/>Kipwodhogi, to itim kama: Kwo pi mipwodhogigo kuomgi; bangʼe giliel yie dendgi duto kendo giluok lepgi, eka gibed joma opwodhi. <verse eid="NUM 8:7"/><verse number="8" style="v" sid="NUM 8:8"/>Nyisgi gikaw nyarwath kaachiel gi misango mar cham mar mogo mayom moru gi mo; bangʼe ikaw nyarwath matin mar ariyo kaka misango mar golo richo. <verse eid="NUM 8:8"/><verse number="9" style="v" sid="NUM 8:9"/>Kel jo-Lawi e nyim Hemb Romo kendo ichok oganda duto mar dhood Israel. <verse eid="NUM 8:9"/><verse number="10" style="v" sid="NUM 8:10"/>Nyaka ikel jo-Lawi e nyim Jehova Nyasaye, mondo jo-Israel nyaka oyie lwetgi kuomgi. <verse eid="NUM 8:10"/><verse number="11" style="v" sid="NUM 8:11"/>Harun nyaka kel jo-Lawi e nyim Jehova Nyasaye kaka misango mifwayo koa kuom jo-Israel, mondo omi gibed moikore ne tij Jehova Nyasaye.<verse eid="NUM 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 8:12"/>“Bangʼ ka jo-Lawi oseketo lwetgi ewi rwedhigo, to chiw achiel kuomgi ne Jehova Nyasaye kaka misango mar golo richo, to machielo chiw kaka misango miwangʼo pep mipwodhogo jo-Lawi mondo ngʼwon-nigi. <verse eid="NUM 8:12"/><verse number="13" style="v" sid="NUM 8:13"/>Ket jo-Lawi ochungʼ e nyim Harun kod yawuote bangʼe ichiwgi kaka misango mifwayo ne Jehova Nyasaye. <verse eid="NUM 8:13"/><verse number="14" style="v" sid="NUM 8:14"/>Ma e kaka onego iwal jo-Lawi e kind jo-Israel mamoko mondo obed maga.<verse eid="NUM 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 8:15"/>“Bangʼ ka isepwodho jo-Lawi kendo ichiwogi kaka misango mifwayo, to nyaka gibi mondo gitim tijgi e Hemb Romo. <verse eid="NUM 8:15"/><verse number="16" style="v" sid="NUM 8:16"/>Gin e jo-Israel manyaka chiw chuth ne an. Asekawogi kaka meka awuon e lo kayo ma en nyodo mokwongo ma wuowi mar ja-Israel. <verse eid="NUM 8:16"/><verse number="17" style="v" sid="NUM 8:17"/>Nyathi moro amora ma wuowi mokwongo ma ja-Israel bed ni en dhano kata chiayo, en mara. Kane anego kayo duto man Misri, ne awalogi gibedo maga. <verse eid="NUM 8:17"/><verse number="18" style="v" sid="NUM 8:18"/>Bende aseketo jo-Lawi duto obedo e lo yawuowi makayo e Israel. <verse eid="NUM 8:18"/><verse number="19" style="v" sid="NUM 8:19"/>Kuom jo-Israel duto, asechiwo jo-Lawi kaka mich ne Harun gi yawuote mondo giti tij lemo e Hemb Romo e lo jo-Israel kendo mondo gikelnegi resruok kuom masira manyalo mako jo-Israel ka gisudo machiegni gi kama ler mar lemo.”<verse eid="NUM 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20"/>Musa gi Harun kod oganda jo-Israel duto notimone jo-Lawi gigo duto mane Jehova Nyasaye ochiko Musa. <verse eid="NUM 8:20"/><verse number="21" style="v" sid="NUM 8:21"/>Jo-Lawi nopwodhore giwegi kendo negiluoko lepgi. Bangʼ mano Harun nochiwogi e nyim Jehova Nyasaye kaka misango mifwayo mi notimonegi misango mondo opwodhgigo. <verse eid="NUM 8:21"/><verse number="22" style="v" sid="NUM 8:22"/>Bangʼ mano, jo-Lawi nobiro tiyo tijgi e Hemb Romo kotelnegi gi Harun kod yawuote. Negitimone jo-Lawi mana kaka Jehova Nyasaye nochiko Musa.<verse eid="NUM 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 8:23"/><verse number="24" style="v" sid="NUM 8:24"/>“Ma e kaka jo-Lawi biro tiyo: Joma chwo mahikgi piero ariyo gabich kata moloyo kanyo nobi mondo obed achiel kuom jotich e Hemb Romo, <verse eid="NUM 8:24"/><verse number="25" style="v" sid="NUM 8:25"/>to ka giromo higni piero abich, to giniwe tich. <verse eid="NUM 8:25"/><verse number="26" style="v" sid="NUM 8:26"/>Ginyalo konyo owetegi e tije mag Hemb Romo, to gin giwegi ok onego gimul tich moro amora. Ma e kaka ibiro pogo tije ne jo-Lawi.”<verse eid="NUM 8:26"/></para>
  <chapter eid="NUM 8"/>
  <chapter number="9" style="c" sid="NUM 9"/>
  <para style="s1">Sawo mar Pasaka</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1"/>Jehova Nyasaye nowuoyo gi Musa e Thim mar Sinai e dwe mokwongo mar higa mar ariyo bangʼ kane gisewuok Misri. Nowachone niya, <verse eid="NUM 9:1"/><verse number="2" style="v" sid="NUM 9:2"/>“Ket jo-Israel otim nyasi mar Pasaka e kinde moketne mowinjore. <verse eid="NUM 9:2"/><verse number="3" style="v" sid="NUM 9:3"/>Tim nyasini e kinde moketne, ma en kinde mag odhiambo mar odiechiengʼ mar apar gangʼwen mar dweni, kaluwore gi chikene kod buchene duto.”<verse eid="NUM 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 9:4"/>Omiyo Musa nowacho ne jo-Israel mondo otim nyasi mar Pasaka, <verse eid="NUM 9:4"/><verse number="5" style="v" sid="NUM 9:5"/>kendo negitimo kamano e Thim mar Sinai e kinde mag odhiambo mar odiechiengʼ mar apar gangʼwen mar dwe mokwongo. Jo-Israel notimo gik moko duto mana kaka Jehova Nyasaye nochiko Musa.<verse eid="NUM 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 9:6"/>To jomoko kuomgi ne ok obedo e nyasi mar Pasaka e odiechiengʼno nikech negibedo mogak bangʼ mulo ringre joma otho. Omiyo negibiro ir Musa kod Harun mana godiechiengno <verse eid="NUM 9:6"/><verse number="7" style="v" sid="NUM 9:7"/>mi giwachone Musa niya, “Wasebedo mogak nikech wamulo ringre joma otho, to en angʼo momiyo ditamwa chiwo misango ne Jehova Nyasaye kaka jo-Israel mamoko e kinde moketne?”<verse eid="NUM 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 9:8"/>Musa nodwokogi niya, “Horeuru nyaka angʼe gima Jehova Nyasaye wacho kuomu.”<verse eid="NUM 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9"/>Eka Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 9:9"/><verse number="10" style="v" sid="NUM 9:10"/>“Nyis jo-Israel kama: ‘Ka ngʼato angʼata kuomu kata nyikwau obedo mogak nikech ringruok motho kata ka gidhi wuoth, to pod ginyalo mana timo nyasi mar Pasaka mar Jehova Nyasaye. <verse eid="NUM 9:10"/><verse number="11" style="v" sid="NUM 9:11"/>Nyasini ginitim chiengʼ mar apar gangʼwen mar dwe mar ariyo e seche mag odhiambo. Ginicham nyarombo, kaachiel gi makati ma ok oketie thowi kod alode makech. <verse eid="NUM 9:11"/><verse number="12" style="v" sid="NUM 9:12"/>Kik giwe chiemogo machop okinyi bende kik gitur choke rombono. E kinde ma gitimo nyasi mar Pasaka nyaka gine ni giluwo chike duto. <verse eid="NUM 9:12"/><verse number="13" style="v" sid="NUM 9:13"/>To ka ngʼat ma ok ogak kendo ma ok odhi wuoth otamore timo nyasi mar Pasaka, ngʼatno nyaka gol oko kuom jogi nikech ne ok ochiwo misango ne Jehova Nyasaye e kinde moketne. Ngʼat ma kamano noyud kum moromore gi richone.<verse eid="NUM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 9:14"/>“ ‘Japiny moro modak kodu madwaro timo nyasi mar Pasaka mar Jehova Nyasaye nyaka tim kamano kaluwore gi chikene kod buchene. Nyaka ubed gi chike machalre ne japiny moro kod ngʼat monywol e gwengʼno.’ ”<verse eid="NUM 9:14"/></para>
  <para style="s1">Bor polo moumo hekalu</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15"/>E odiechiengʼ mane osetiek gero kar lemo, ma en Hema mar Singruok, bor polo noume. Chakre odhiambo nyaka okinyi bor polo mane oumo kar lemo ne chalo ka mach. <verse eid="NUM 9:15"/><verse number="16" style="v" sid="NUM 9:16"/>Mano e kaka nochalo ka bor polo oume godiechiengʼ to gotieno ochalo ka mach. <verse eid="NUM 9:16"/><verse number="17" style="v" sid="NUM 9:17"/>E kinde moro amora ma bor polo ne oa ewi Hema, jo-Israel ne chako wuoth; to e kinde ma bor polo nopiyo ewi Hema, jo-Israel ne goyo kambi. <verse eid="NUM 9:17"/><verse number="18" style="v" sid="NUM 9:18"/>Kane Jehova Nyasaye ogolo chik, to jo-Israel ne chako wuoth, kendo kane ogolo chik to negigoyo kambi. E kinde duto ma bor polo nosiko ewi kar lemo, negisiko e kambi. <verse eid="NUM 9:18"/><verse number="19" style="v" sid="NUM 9:19"/>Kane bor polo osiko koumo kar lemo kuom thuolo malach, jo-Israel norito buche Jehova Nyasaye kendo ne ok giwuok. <verse eid="NUM 9:19"/><verse number="20" style="v" sid="NUM 9:20"/>Seche moko bor polo neumo kar lemo kuom ndalo manok kende; to ka Jehova Nyasaye nogolo chik to negidak, bangʼe kochako ogolo chik to gichako wuoth. <verse eid="NUM 9:20"/><verse number="21" style="v" sid="NUM 9:21"/>Seche moko bor polo ne ni kanyo chakre odhiambo nyaka okinyi kende, to kane oyawore gokinyi to negichako wuoth. Bed ni en odiechiengʼ kata otieno, to e kinde ma bor polo noyawore, negichako wuoth. <verse eid="NUM 9:21"/><verse number="22" style="v" sid="NUM 9:22"/>Bed ni bor polo nosiko koumo kar lemo kuom ndalo ariyo, dwe achiel kata higa achiel, to jo-Israel ne siko e kambi kendo ne ok gichak wuoth; to ka bor polono ne oyawore, to negichako wuoth. <verse eid="NUM 9:22"/><verse number="23" style="v" sid="NUM 9:23"/>Kane Jehova Nyasaye ogolo chik negibet e kambi, kendo kane ochako ogolo chik to negichako wuoth. Negirito weche Jehova Nyasaye, kaluwore gi chik mane ochiwo kokalo kuom Musa.<verse eid="NUM 9:23"/></para>
  <chapter eid="NUM 9"/>
  <chapter number="10" style="c" sid="NUM 10"/>
  <para style="s1">Turumbete mag fedha</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 10:1"/><verse number="2" style="v" sid="NUM 10:2"/>Los turumbete ariyo mag fedha mothedhi, kendo ti kodgi kuom choko oganda duto kanyakla mondo mi gichak wuoth. <verse eid="NUM 10:2"/><verse number="3" style="v" sid="NUM 10:3"/>Ka turumbete ariyogi oywak, to ogandagi mondo ochokre e nyimi e dhoranga Hemb Romo. <verse eid="NUM 10:3"/><verse number="4" style="v" sid="NUM 10:4"/>Ka turumbete achiel kende ema oywak, to jotelo mag oganda, jo-Israel nyaka chokre e nyimi. <verse eid="NUM 10:4"/><verse number="5" style="v" sid="NUM 10:5"/>Ka turumbete oywak, to dhoudi mantie yo wuok chiengʼ nyaka chak wuoth. <verse eid="NUM 10:5"/><verse number="6" style="v" sid="NUM 10:6"/>Ka turumbete mar ariyo oywak, to dhoudi mantie yo milambo nyaka chak wuoth. Ywak mar turumbeteno ema nobed ranyisi mar chako wuoth. <verse eid="NUM 10:6"/><verse number="7" style="v" sid="NUM 10:7"/>Ka ichoko ji kanyakla, to ywak turumbetego nyaka pogre.<verse eid="NUM 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 10:8"/>“Yawuot Harun, ma gin jodolo, ema nogo turumbete. Ma en chik mosiko ne un kod tiengʼ mabiro. <verse eid="NUM 10:8"/><verse number="9" style="v" sid="NUM 10:9"/>Ka udhi kedo gi wasiku ma thirou e pinyu owuon, to nyaka ugo turumbete. Bangʼe Jehova Nyasaye ma Nyasachu noparu kendo noresu e lwet wasiku. <verse eid="NUM 10:9"/><verse number="10" style="v" sid="NUM 10:10"/>Bende e kinde ma un gi mor, ma gin kinde sewni moyier kaka nyasi mar Dwe Manyien, nyaka ugo turumbete e kinde muchiwoe misengini miwangʼo pep kod misengini mag lalruok, nikech ginibednu rapar e nyim Nyasachu nimar An e Jehova Nyasaye ma Nyasachu.”<verse eid="NUM 10:10"/></para>
  <para style="s1">Jo-Israel owuok Sinai</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11"/>E odiechiengʼ mar piero ariyo mar dwe mar ariyo e higa mar ariyo, bor polo nowuok ewi Hemb Romo mar Sandug Muma mar Singruok. <verse eid="NUM 10:11"/><verse number="12" style="v" sid="NUM 10:12"/>Eka jo-Israel nowuok koa e Thim mar Sinai kendo ne giwuotho kuonde duto nyaka bor polo nopie e Thim mar Paran. <verse eid="NUM 10:12"/><verse number="13" style="v" sid="NUM 10:13"/>Chako wuodhgi mokwongo notimore bangʼ ka Jehova Nyasaye nosegolo chik kokalo kuom Musa.<verse eid="NUM 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 10:14"/>Jo-Juda ema ne okwongo wuok ka gin e bwo bandechgi, kotelnegi gi Nashon wuod Aminadab. <verse eid="NUM 10:14"/><verse number="15" style="v" sid="NUM 10:15"/>Dhood Isakar notelnegi gi Nethanel wuod Zuar, <verse eid="NUM 10:15"/><verse number="16" style="v" sid="NUM 10:16"/>to Eliab wuod Helon notelo ne dhood Zebulun. <verse eid="NUM 10:16"/><verse number="17" style="v" sid="NUM 10:17"/>Bangʼe ne gibano Hemb Romo, kendo joka Gershon kod joka Merari mane otingʼe, nochako wuoth.<verse eid="NUM 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 10:18"/>Dhood joka Reuben nowuok bangʼ-gi ka gin e bwo bandechgi, kotelnegi gi Elizur wuod Shedeur. <verse eid="NUM 10:18"/><verse number="19" style="v" sid="NUM 10:19"/>Dhood Simeon notelnegi gi Shelumiel wuod Zurishadai, <verse eid="NUM 10:19"/><verse number="20" style="v" sid="NUM 10:20"/>to Eliasaf wuod Dewel notelo ne dhood Gad. <verse eid="NUM 10:20"/><verse number="21" style="v" sid="NUM 10:21"/>Bangʼe jo-Kohath nochako wuoth ka gitingʼo gik maler nikech Hemb Romo nyaka ne gur kapok gichopo.<verse eid="NUM 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 10:22"/>Bangʼe jo-Efraim nochako wuoth ka gin e bwo bandechgi kotelnegi gi Elishama wuod Amihud. <verse eid="NUM 10:22"/><verse number="23" style="v" sid="NUM 10:23"/>Dhood Manase notelnegi gi Gamaliel wuod Pedazur, <verse eid="NUM 10:23"/><verse number="24" style="v" sid="NUM 10:24"/>to Abidan wuod Gideoni notelo ne dhood Benjamin.<verse eid="NUM 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 10:25"/>Dhood Dan ema ne ochako wuoth mogik e bwo bandechgi kotelnegi gi Ahiezer wuod Amishadai. <verse eid="NUM 10:25"/><verse number="26" style="v" sid="NUM 10:26"/>Dhood Asher notelne gi Pagiel wuod Okran, <verse eid="NUM 10:26"/><verse number="27" style="v" sid="NUM 10:27"/>to Ahira wuod Enan notelo ne dhood Naftali. <verse eid="NUM 10:27"/><verse number="28" style="v" sid="NUM 10:28"/>Ma e kaka chenro mar jo-Israel nobet kane gichako wuoth.<verse eid="NUM 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29"/>Musa nowacho ne Hobab wuod Reuel ja-Midian, ma en jaduongʼne niya, “Wawuok wadhi kama Jehova Nyasaye nowacho ni obiro miyowa. Kuom mano bi kodwa mondo wadhi e piny maber mane Jehova Nyasaye osingo ne jo-Israel kendo wabiro miyi kar dak.”<verse eid="NUM 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 10:30"/>Nodwoke niya, “Ooyo, ok anadhi kodu; to adok thurwa ir jowa.”<verse eid="NUM 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 10:31"/>Musa to nowachone niya, “Ka iyie to kik iwewa. In ema ingʼeyo kambi monego wadhi wadagie thimni, kendo in e wangʼwa. <verse eid="NUM 10:31"/><verse number="32" style="v" sid="NUM 10:32"/>Ka idhi kodwa, to wabiro pogoni gimoro amora maber ma Jehova Nyasaye omiyowa.”<verse eid="NUM 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33"/>Omiyo ne giwuok ka gia e got mar Jehova Nyasaye kendo ne giwuotho kuom ndalo adek. Sandug Muma mar Jehova Nyasaye nodhi nyimgi e ndalo adekgo mondo oiknegi kama ginyalo yweyoe. <verse eid="NUM 10:33"/><verse number="34" style="v" sid="NUM 10:34"/>Bor polo mar Jehova Nyasaye noumogi godiechiengʼ kane giwuok e kargi mar bworo.<verse eid="NUM 10:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 10:35"/>Pile kane gisechako wuoth gi Sandug Muma, Musa ne wacho niya,</para>
  <para style="q1" vid="NUM 10:35">“Yaye Jehova Nyasaye, aa malo!</para>
  <para style="q2" vid="NUM 10:35">Mad wasiki okee;</para>
  <para style="q2" vid="NUM 10:35">kendo jomamon kodi oringi oa e nyimi!”<verse eid="NUM 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 10:36"/>Kinde duto mane oyie Sandug Muma piny, Musa ne wacho niya,</para>
  <para style="q1" vid="NUM 10:36">“Yaye Jehova Nyasaye,</para>
  <para style="q2" vid="NUM 10:36">duogi ir oganda jo-Israel mangʼenygi.”<verse eid="NUM 10:36"/></para>
  <chapter eid="NUM 10"/>
  <chapter number="11" style="c" sid="NUM 11"/>
  <para style="s1">Mach moa kuom Jehova Nyasaye</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1"/>Kane koro ji ngʼur ne Jehova Nyasaye kuom chandruok mane gineno, kendo kane owinjo ngʼurgino mirimbe nomedore. Kuom mano mach mane oa kuom Jehova Nyasaye noliel e kindgi mi owangʼo bath kambi konchiel. <verse eid="NUM 11:1"/><verse number="2" style="v" sid="NUM 11:2"/>Kane ji oywak ne Musa, ne olamo Jehova Nyasaye mi mach notho. <verse eid="NUM 11:2"/><verse number="3" style="v" sid="NUM 11:3"/>Omiyo kanyo noluong ni Tabera (tiende ni Kama Mach osewangʼo) nikech mach moa kuom Jehova Nyasaye nosewangʼo bath kambi konchiel e kindgi.<verse eid="NUM 11:3"/></para>
  <para style="s1">Manna moa kuom Jehova Nyasaye</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 11:4"/>Joma yoreyore mane obiro kodgi nochako dwaro chiemo mamoko, kendo jo-Israel nochako ywak kawacho niya, “Mad debed ni wan gi ringʼo ma wanyalo chamo! <verse eid="NUM 11:4"/><verse number="5" style="v" sid="NUM 11:5"/>Mano kaka waparo rech mane wachamo Misri maonge chudo moro amora, bende waparo olembe mopogore opogore, kitungu kod kitungu marachar. <verse eid="NUM 11:5"/><verse number="6" style="v" sid="NUM 11:6"/>Koro sani waonge gi ndhandhu mar chiemo; kendo ok wane gimoro amora makmana manna-gi!”<verse eid="NUM 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 11:7"/>Manna-no ne chalo gi kothe matindo tindo marachere kendo ma kitgi ne chalo gi duogo. <verse eid="NUM 11:7"/><verse number="8" style="v" sid="NUM 11:8"/>Ji ne wuok gokinyi michok manna-go bangʼe giregogi e pongʼ lwedo kata yokogi e pany. Ne gitedogi e agulu kata dwalogi ka ngʼama dwalo makati. Bende ne gichalo gimoro molos gi mo zeituni. <verse eid="NUM 11:8"/><verse number="9" style="v" sid="NUM 11:9"/>Kane thoo omako kambi gotieno, to manna bende ne lwar piny.<verse eid="NUM 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 11:10"/>Musa nowinjo ji duto moa e anywola ka anywola kaywak, ka moro ka moro ochungʼ e dho hembe. Jehova Nyasaye iye nomedo owangʼ kendo kihondko nomako Musa. <verse eid="NUM 11:10"/><verse number="11" style="v" sid="NUM 11:11"/>Nopenjo Jehova Nyasaye niya, “En angʼo momiyo isekelo chandruok ma kama ne jatichni? En angʼo ma asetimo ma ok mori momiyo imiya tingʼ mapek mar jogi duto? <verse eid="NUM 11:11"/><verse number="12" style="v" sid="NUM 11:12"/>Bende ne amako ich mar jogi duto? Bende ne anywologi? Angʼo momiyo iwachona mondo akaw tingʼ-gi ka atingʼogi e kora mana kaka japidi tingʼo nyithindo matindo, mondo atergi e piny mane isingori ne kweregi ni nitergie. <verse eid="NUM 11:12"/><verse number="13" style="v" sid="NUM 11:13"/>Dayud ringʼo madirom jogi kanye? Gisiko ka giywakna ni, ‘Miwa ringʼo mondo wacham!’ <verse eid="NUM 11:13"/><verse number="14" style="v" sid="NUM 11:14"/>Ok anyal tingʼo jogi duto kenda awuon; gipek mohewa. <verse eid="NUM 11:14"/><verse number="15" style="v" sid="NUM 11:15"/>Ka mano e kaka idwaro tiyo koda, to nega sani, to ka dipo ni ikecha, to yie iwe miya chandruok ma kama.”<verse eid="NUM 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16"/>Omiyo Jehova Nyasaye nowacho ne Musa kama: “Kelna jodong Israel piero abiriyo ma ingʼeyo ni jotelo kendo ruodhi. Kelgi e Hemb Romo kendo gichungʼ kodi kanyo. <verse eid="NUM 11:16"/><verse number="17" style="v" sid="NUM 11:17"/>Abiro lor mondo awuo kodi kanyo, kendo abiro kawo teko mar loch moko kuomi mane amiyi kendo ami jogo. Gibiro konyi rito ogandano makoro tingʼno ok noturi kendi.<verse eid="NUM 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 11:18"/>“Nyis jo-Israel kama: ‘Pwodhreuru ka uikoru ne kiny ma ubiro chamoe ringʼo; nimar Jehova Nyasaye osewinjo ywak maru niya, “Mad dibed ni nitie kama wanyalo yudoe ringʼo mwachamo! Ne wawinjo maber e piny Misri!” Omiyo koro Jehova Nyasaye nomiu ringʼo, ma ubiro chamo. <verse eid="NUM 11:18"/><verse number="19" style="v" sid="NUM 11:19"/>Ok unuchame mana kuom ndalo achiel kende, kata ndalo ariyo, kata ndalo abich, kata apar kata piero ariyo, <verse eid="NUM 11:19"/><verse number="20" style="v" sid="NUM 11:20"/>to unuchame kuom dwe achiel, manyaka othingʼu mi ungʼogi nikech usedagi Jehova Nyasaye modak e kindu kendo useywak e nyima, kuwacho niya, “Angʼo momiyo ne waa Misri?” ’ ”<verse eid="NUM 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 11:21"/>To Musa nodwoko niya, “Antie gi ji alufu mia achiel mawuotho gi tiendgi, to in to iwacho ni, ‘Abiro miyogi ringʼo moromogi chamo kuom dwe achiel mangima!’ <verse eid="NUM 11:21"/><verse number="22" style="v" sid="NUM 11:22"/>Bende ginyalo yiengʼ ka kweth mag jamni kod kweth mag dhok oyangʼ duto? Bende ginyalo yiengʼ ka rech duto manie nam omaknegi?”<verse eid="NUM 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 11:23"/>Jehova Nyasaye nopenjo Musa niya, “Bende nitie gima nyalo tamo Jehova Nyasaye? Kawuononi ibiro ngʼeyo ka wechena gin adier kata ok adier.”<verse eid="NUM 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24"/>Omiyo Musa nowuok kendo nonyiso ji gima Jehova Nyasaye nowacho. Nokelo jodong-gi piero abiriyo ma gichokore kanyakla kendo noketogi duto gichungʼ ka gilworo Hemb Romo. <verse eid="NUM 11:24"/><verse number="25" style="v" sid="NUM 11:25"/>Eka Jehova Nyasaye nolor e bor polo mi owuoyo kode, kendo nokawo teko moko mane osemiye mi omiyo jodongo piero abiriyogo. Kane Roho odonjo kuomgi, ne gikoro wach, to bangʼ mano ne ok gichako gitimo kamano kendo.<verse eid="NUM 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 11:26"/>Kata kamano, ji ariyo ma nying-gi Eldad kod Medad, mane osekwan kaachiel gi jodongo piero abiriyo-ka nodongʼ e kambi. To kata kane ok gidhi e Hemb Romo kamano, Roho nobiro kuomgi mi gikoro wach e kambi. <verse eid="NUM 11:26"/><verse number="27" style="v" sid="NUM 11:27"/>Rawera moro noringo mi odhi ir Musa mowachone niya, “Eldad kod Medad koro wach e kambi.”<verse eid="NUM 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 11:28"/>Joshua wuod Nun, mane jakony Musa chakre tin-ne, nowacho ne Musa niya, “Ruodha, kwergi!”<verse eid="NUM 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 11:29"/>To Musa nodwoko niya, “Nyiego omaki nikech wachna? Mad ne oganda duto mag Jehova Nyasaye bed jonabi mi oket Roho mare kuomgi!” <verse eid="NUM 11:29"/><verse number="30" style="v" sid="NUM 11:30"/>Eka Musa kod jodong Israel nodok e kambi.<verse eid="NUM 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31"/>Eka Jehova Nyasaye notugo yamo mokelo aluru koa e nam. Yamo nokelogi ma gichokore e alwora mar kambi madirom fut adek koa piny, kendo kama ne gichokoreno ne nyalo romo wuoth mar ndalo achiel. <verse eid="NUM 11:31"/><verse number="32" style="v" sid="NUM 11:32"/>Odiechiengno duto kod otieno gi odiechiengʼ maluwe duto ji nowuok kendo nochoko aluru. Onge ngʼama nochoko aluru matin ne atonge apar. Bangʼe ne gimoyogi e kambi mondo gituo. <verse eid="NUM 11:32"/><verse number="33" style="v" sid="NUM 11:33"/>To kane pok gimuonyo ring alurugo, mirimb Jehova Nyasaye nomedore kuomgi, kendo nonegogi gi masira malich. <verse eid="NUM 11:33"/><verse number="34" style="v" sid="NUM 11:34"/>Omiyo kanyo noluongi ni Kibroth Hatava, nikech kanyo ema ne giyikoe joma ne wuoch ringʼo omako.<verse eid="NUM 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 11:35"/>Koa Kibroth Hatava, ji nodhi nyaka Hazeroth kendo negidak kanyo.<verse eid="NUM 11:35"/></para>
  <chapter eid="NUM 11"/>
  <chapter number="12" style="c" sid="NUM 12"/>
  <para style="s1">Miriam kod Harun okwedo Musa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1"/>Miriam kod Harun nochako wuoyo marach kuom Musa nikech jaode ma nyar jo-Kush, nimar ne onywomo nyar Kush. <verse eid="NUM 12:1"/><verse number="2" style="v" sid="NUM 12:2"/>Negipenjore niya, “Bende Jehova Nyasaye osewuoyo kokalo kuom Musa kende? Donge osewuoyo kokalo kuomwa bende?” Kendo Jehova Nyasaye nowinjo ma.<verse eid="NUM 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 12:3"/>(Musa ne en ngʼama obolore, ngʼat mobolore moloyo ngʼato angʼata manie wangʼ piny.)<verse eid="NUM 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 12:4"/>Gikanyono Jehova Nyasaye nowacho ne Musa, Harun kod Miriam niya, “Wuoguru oko e Hemb Romo karu ji adekgo.” Omiyo giduto ne giwuok oko. <verse eid="NUM 12:4"/><verse number="5" style="v" sid="NUM 12:5"/>Eka Jehova Nyasaye nolor e bor polo; mochungʼ e dho Hemb Romo kendo noluongo Harun gi Miriam. Kane gibiro kargi ji ariyogo, <verse eid="NUM 12:5"/><verse number="6" style="v" sid="NUM 12:6"/>nowachonegi niya, “Winjuru wechena:</para>
  <para style="q1" vid="NUM 12:6">“Ka janabi mar Jehova Nyasaye nitie e dieru,</para>
  <para style="q2" vid="NUM 12:6">to abiro afwenyorane,</para>
  <para style="q2" vid="NUM 12:6">kendo awuoyo kode e lek.<verse eid="NUM 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 12:7"/>To ma ok en adiera kuom jatichna Musa;</para>
  <para style="q2" vid="NUM 12:7">nikech en ja-ratiro e oda duto.<verse eid="NUM 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 12:8"/>En awuoyo kode wangʼ gi wangʼ,</para>
  <para style="q2" vid="NUM 12:8">awuoyo kode maler ma ok gi ngeche;</para>
  <para style="q2" vid="NUM 12:8">kendo oneno tich Jehova Nyasaye.</para>
  <para style="q1" vid="NUM 12:8">Angʼo momiyo ne ok uluor</para>
  <para style="q2" vid="NUM 12:8">ka uwuoyo kuom jatichna Musa?”<verse eid="NUM 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 12:9"/>Mirimb Jehova Nyasaye nomedore kuomgi, kendo no-aa oweyogi.<verse eid="NUM 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 12:10"/>Kane bor polo owalore oa ewi Hemb Romo, Miriam noa malo ka dende obawore gi dhoho mobedo marachar ka pe. Harun nolokore mongʼiye kendo noneno ka en-gi dhoho, <verse eid="NUM 12:10"/><verse number="11" style="v" sid="NUM 12:11"/>kendo nowacho ne Musa niya, “Yaye, ruodha, kik iwe wachul gowi mar richo kata obedo ni wasetimo gima ofuwoni. <verse eid="NUM 12:11"/><verse number="12" style="v" sid="NUM 12:12"/>Kik iweye ochal gi nyathi mobwogi ma aa ei min-gi ka en-gi ringruok mokethore.”<verse eid="NUM 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 12:13"/>Omiyo Musa noywak ne Jehova Nyasaye niya, “Yaye Nyasaye, yie ichange!”<verse eid="NUM 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 12:14"/>Jehova Nyasaye nodwoko Musa niya, “Ka wuon-gi ne nyalo ngʼudho olawo e wangʼe, donge dine obedo gi wichkuot kuom ndalo abiriyo? Wale obed tenge kuom ndalo abiriyo; bangʼ mano inyalo duoge e kambi.” <verse eid="NUM 12:14"/><verse number="15" style="v" sid="NUM 12:15"/>Omiyo Miriam nobedo oko mar kambi kuom ndalo abiriyo, kendo ji nochungʼ kar tiendgi nyaka ne odwogo.<verse eid="NUM 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 12:16"/>Bangʼ mano, ji nowuok Hazeroth kendo negigoyo kambi e Thim mar Paran.<verse eid="NUM 12:16"/></para>
  <chapter eid="NUM 12"/>
  <chapter number="13" style="c" sid="NUM 13"/>
  <para style="s1">Oor jonono Kanaan</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 13:1"/><verse number="2" style="v" sid="NUM 13:2"/>“Or jomoko odhi onon piny Kanaan, ma onego ami jo-Israel. Koa e dhoot ka dhoot manie oganda inior achiel kuom jotendgi.”<verse eid="NUM 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 13:3"/>Kaluwore gi dwond Jehova Nyasaye, Musa noorogi ka gia e Thim mar Paran. Jogi duto ne gin jotend jo-Israel.<verse eid="NUM 13:3"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="4" style="v" sid="NUM 13:4"/>Magi e nying-gi,</para>
  <para style="b" vid="NUM 13:4"/>
  <para style="li1" vid="NUM 13:4">koa e dhood Reuben ne en Shamua wuod Zakur;<verse eid="NUM 13:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 13:5"/>koa e dhood Simeon, ne en Shafat wuod Hori;<verse eid="NUM 13:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 13:6"/>koa e dhood Juda, ne en Kaleb wuod Jefune;<verse eid="NUM 13:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 13:7"/>koa e dhood Isakar, ne en Igal wuod Josef;<verse eid="NUM 13:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 13:8"/>koa e dhood Efraim, ne en Hoshea wuod Nun;<verse eid="NUM 13:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 13:9"/>koa e dhood Benjamin, ne en Palti wuod Rafu;<verse eid="NUM 13:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 13:10"/>koa e dhood Zebulun, ne en Gadiel wuod Sodi;<verse eid="NUM 13:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 13:11"/>koa e dhood Manase (ma en dhood Josef), ne en Gadi wuod Susi;<verse eid="NUM 13:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 13:12"/>koa e dhood Dan, ne en Amiel wuod Gemali;<verse eid="NUM 13:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 13:13"/>koa e dhood Asher, ne en Sethur wuod Mikael;<verse eid="NUM 13:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 13:14"/>koa e dhood Naftali, ne en Nabi wuod Vofsi;<verse eid="NUM 13:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 13:15"/>koa e dhood Gad, ne en Geuel wuod Maki.<verse eid="NUM 13:15"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="16" style="v" sid="NUM 13:16"/>Magi e nying chwo mane Musa ooro mondo onon piny Kanaan. (Musa nomiyo Hoshea wuod Nun nying ni Joshua.)<verse eid="NUM 13:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="NUM 13:17"/>Kane Musa oorogi mondo gidhi ginon piny Kanaan, nowachonegi niya, “Luwuru Negev kendo udhi nyaka piny manie got. <verse eid="NUM 13:17"/><verse number="18" style="v" sid="NUM 13:18"/>Nonuru ane pinyno kaka chalo, mondo ungʼego ni joma odak kanyo gin thuondi koso ngoche, gingʼeny koso ginok? <verse eid="NUM 13:18"/><verse number="19" style="v" sid="NUM 13:19"/>Nonuru ane kaka piny ma gidakieno chalo, ka ober kata orach? Nonuru ane mier ma gidakie nichalo nade, ochielgi koso ok ochielgi? <verse eid="NUM 13:19"/><verse number="20" style="v" sid="NUM 13:20"/>Lopno, to chalo nade? En lowo mamiyo koso motwo? Bende en gi yiende koso oongego? Temuru beru mondo ukel olembe moko mag pinyno.” (Ndalono ne en kinde keyo mokwongo mar mzabibu.)<verse eid="NUM 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 13:21"/>Omiyo ne giwuok kendo neginono pinyno kochakore Thim mar Zin nyaka Rehob, kagichomo Lebo Hamath. <verse eid="NUM 13:21"/><verse number="22" style="v" sid="NUM 13:22"/>Ne giwuotho mi gikadho piny Negev nyaka gichopo Hebron, kama Ahiman, Sheshai kod Talmai, ma nyikwa Anak nodakie. (Hebron noger higni abiriyo motelone Zoan manie piny Misri.) <verse eid="NUM 13:22"/><verse number="23" style="v" sid="NUM 13:23"/>Kane gichopo e Holo mar Eshkol, ne gitongʼo bad yath achiel motingʼo pumbi mar olemb mzabibu. Ji ariyo kuomgi notingʼe e luth kaachiel gi gik mongʼinore kod ngʼowu. <verse eid="NUM 13:23"/><verse number="24" style="v" sid="NUM 13:24"/>Kanyo niluongo ni Holo mar Eshkol nikech negingʼado bad olemb mzabibu mochiek. <verse eid="NUM 13:24"/><verse number="25" style="v" sid="NUM 13:25"/>Bangʼ ndalo piero angʼwen negidwogo ka gia nono pinyno.<verse eid="NUM 13:25"/></para>
  <para style="s1">Dwoko mar nono piny Kanaan</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 13:26"/>Negidwogo ir Musa gi Harun kod oganda jo-Israel duto e dala Kadesh manie Thim Paran. Kanyo ema ne gimiyogi dwoko kaachiel gi chokruok duto kendo neginyisogi olemo machiek e pinyno. <verse eid="NUM 13:26"/><verse number="27" style="v" sid="NUM 13:27"/>Negimiyo Musa nonro machalo kama: “Ne wadhi e piny mane iorowae, kendo en piny mopongʼ gi chak kod mor kich! Olemo moa kuno eri. <verse eid="NUM 13:27"/><verse number="28" style="v" sid="NUM 13:28"/>Joma odak kuno nigi teko mangʼeny, kendo gidakie mier madongo mochiel motegno kendo malich. Bende ne waneno nyikwa Anak kuno. <verse eid="NUM 13:28"/><verse number="29" style="v" sid="NUM 13:29"/>Jo-Amalek odak Negev; jo-Hiti, jo-Jebus kod jo-Amor odak e piny manie got; to jo-Kanaan odak machiegni gi dho nam e alwora mar Jordan.”<verse eid="NUM 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30"/>Eka Kaleb nokwero ji mondo olingʼ e nyim Musa kendo nowacho niya, “Wadhiuru kendo wakaw pinyno, nimar wanyalo kawe.”<verse eid="NUM 13:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 13:31"/>To joma nodhi kode kuno nowacho niya, “Ok wanyal monjo jogo; gitek moloyowa.” <verse eid="NUM 13:31"/><verse number="32" style="v" sid="NUM 13:32"/>Omiyo ne gilandone jo-Israel dwoko marachni kuom piny mane gidhi nono. Negiwacho niya, “Piny mane wadhi nono nego joma odak eigi. Ji mane waneno kuno gin joma robede. <verse eid="NUM 13:32"/><verse number="33" style="v" sid="NUM 13:33"/>Ne waneno Nefilim kuno (nyikwa Anak aa kuom jo-Nefilim). Ne wanenore mana ka ongogo, to bende mano e kaka ne wachalo e nyimgi.”<verse eid="NUM 13:33"/></para>
  <chapter eid="NUM 13"/>
  <chapter number="14" style="c" sid="NUM 14"/>
  <para style="s1">Ji ongʼanyo</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1"/>Otienono oganda duto mag gwengʼ notingʼo dwondgi malo mi giywak matek. <verse eid="NUM 14:1"/><verse number="2" style="v" sid="NUM 14:2"/>Jo-Israel duto nongʼur ne Musa kod Harun, kendo chokruok mar oganda duto nowachonegi niya, “Donge dine ber ka watho Misri? Kata mana e thim ka! <verse eid="NUM 14:2"/><verse number="3" style="v" sid="NUM 14:3"/>Angʼo momiyo Jehova Nyasaye kelowa e pinyni mondo negwa gi ligangla? Mondewa kod nyithindwa ibiro kaw mana kaka gik moyaki. Donge deber ka wadok Misri?” <verse eid="NUM 14:3"/><verse number="4" style="v" sid="NUM 14:4"/>Kendo negiwacho e kindgi giwegi niya, “Onego wayier jatelo mondo wadog Misri.”<verse eid="NUM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 14:5"/>Eka Musa kod Harun nopodho auma e nyim chokruok mar oganda Israel duto mane ochokore kanyo. <verse eid="NUM 14:5"/><verse number="6" style="v" sid="NUM 14:6"/>Joshua wuod Nun kod Kaleb wuod Jefune, ma gin achiel kuom joma ne odhi nono piny Kanaan, noyiecho lepgi <verse eid="NUM 14:6"/><verse number="7" style="v" sid="NUM 14:7"/>mi owacho ne chokruok mar oganda jo-Israel duto niya, “Piny mane wakalo e iye kendo wanono ber miwuoro. <verse eid="NUM 14:7"/><verse number="8" style="v" sid="NUM 14:8"/>Ka dipo ni Jehova Nyasaye mor kodwa, to obiro telonwa nyaka e pinyno, piny mopongʼ gi chak kod mor kich, kendo obiro miyowa pinyno. <verse eid="NUM 14:8"/><verse number="9" style="v" sid="NUM 14:9"/>Gima utim en ni kik ungʼanyne Jehova Nyasaye. Kik uluor jopinyno, nikech wabiro mwonyogi duto. Jarit mag-gi osea, to wan to Jehova Nyasaye nikodwa kendo kik uluorgi.”<verse eid="NUM 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 14:10"/>To chokruok mar oganda duto nowuoyo e kindgi giwegi mondo gichielgi gi kite. Eka duongʼ mar Jehova Nyasaye nothinyore ne jo-Israel duto e Hemb Romo. <verse eid="NUM 14:10"/><verse number="11" style="v" sid="NUM 14:11"/>Jehova Nyasaye nowacho ne Musa niya, “Nyaka karangʼo ma jogi biro jarae? Nyaka karangʼo ma jogi biro tamore yie kuoma, kata bangʼ timo honni mopogore opogore e kindgi? <verse eid="NUM 14:11"/><verse number="12" style="v" sid="NUM 14:12"/>Abiro negogi gi masira mi atiekgi chuth, to un to abiro miyou ubed oganda maduongʼ kendo motegno moloyogi.”<verse eid="NUM 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13"/>Musa noywak ne Jehova Nyasaye niya, “Jo-Misri ongʼeyo wachni malongʼo ni in ema nigolo jo-Israel oa kuomgi gi tekoni iwuon. <verse eid="NUM 14:13"/><verse number="14" style="v" sid="NUM 14:14"/>Kendo gibiro nyiso jopinyni wachni. To bende gisewinjo ni in, yaye Jehova Nyasaye, oseneni kitelonegi godiechiengʼ gi boche mag polo, to gotieno itelonegi gi pilni mar mach. <verse eid="NUM 14:14"/><verse number="15" style="v" sid="NUM 14:15"/>Ka inego jogi duto dichiel, to oganda mabiro winjo wach machalo kama kuomi biro wacho niya, <verse eid="NUM 14:15"/><verse number="16" style="v" sid="NUM 14:16"/>‘Jehova Nyasaye ne ok nyal chopo gi jogi e piny mane osingorenegi kokwongʼore, momiyo ne onegogi e thim.’<verse eid="NUM 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 14:17"/>“Mad koro teko Jehova Nyasaye oyangre malongʼo, mana kaka isewacho: <verse eid="NUM 14:17"/><verse number="18" style="v" sid="NUM 14:18"/>‘Jehova Nyasaye ok kech piyo, to en gihera mogundho kendo oweyo ne ji richogi kendo ongʼwono ne joma ongʼanyo. To kata kamano, joma oketho ok nyal we ma ok okum; okumo nyithindo kuom richo mag wuonegi nyaka tiengʼ mar adek kata nyaka tiengʼ mar angʼwen.’ <verse eid="NUM 14:18"/><verse number="19" style="v" sid="NUM 14:19"/>Kaluwore gihera mari maduongʼ, yie iwene jogi richo mag-gi, mana kaka isebedo ka ingʼwononegi chakre gia Misri nyaka sani.”<verse eid="NUM 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20"/>Jehova Nyasaye nodwoko niya, “Aseweyonegi richogi mana kaka ne ikwayo. <verse eid="NUM 14:20"/><verse number="21" style="v" sid="NUM 14:21"/>Kata kamano, akwongʼora gi nyinga awuon kod duongʼ mara mopongʼo piny, <verse eid="NUM 14:21"/><verse number="22" style="v" sid="NUM 14:22"/>ni onge kata mana ngʼato achiel kuomgi mane oneno duongʼ mara kod ranyisi mag honni mane atimo Misri kendo e thim, to ne ok owinja kendo otema nyadipar; ma nochopi e piny mane asingonegi. <verse eid="NUM 14:22"/><verse number="23" style="v" sid="NUM 14:23"/>Bende onge kata mana ngʼato achiel kuomgi mabiro neno piny mane asingone kweregi ka akwongʼora. Ngʼato angʼata ma osenyisa achaya ok none pinyno. <verse eid="NUM 14:23"/><verse number="24" style="v" sid="NUM 14:24"/>To nikech jatichna Kaleb nigi chuny mopogore kod mag-gi kendo ma luwa gi chunye duto, abiro tere e piny mane odhiyoeno, kendo nyikwaye nokaw pinyno kaka girkeni margi. <verse eid="NUM 14:24"/><verse number="25" style="v" sid="NUM 14:25"/>To nikech jo-Amalek kod jo-Kanaan odak e kuonde mag holo, dwoguru kiny kendo udhi e thim mantiere e yo mochiko Nam Makwar.”<verse eid="NUM 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26"/>Jehova Nyasaye nowacho ne Musa kod Harun niya, <verse eid="NUM 14:26"/><verse number="27" style="v" sid="NUM 14:27"/>“Nyaka karangʼo ma oganda ma timbegi richogi biro ngʼur koda? Asewinjo ngʼur mar jo-Israel ma jo-mibadhigi. <verse eid="NUM 14:27"/><verse number="28" style="v" sid="NUM 14:28"/>Omiyo nyisgiuru ni Jehova Nyasaye owacho ni, ‘Akwongʼora gi nyinga awuon, ni abiro timonu mana gigo mane awinjo kuwacho: <verse eid="NUM 14:28"/><verse number="29" style="v" sid="NUM 14:29"/>Ringreu nolwar mana e thimni; ngʼato angʼata kuomu ma hike piero ariyo ka dhi nyime mane okwan e ndalo kweno kendo mosengʼur koda. <verse eid="NUM 14:29"/><verse number="30" style="v" sid="NUM 14:30"/>Onge ngʼato angʼata kuomu manodonji e piny mane asingone katingʼo bada malo mondo obed dalau, makmana Kaleb wuod Jefune kod Joshua wuod Nun. <verse eid="NUM 14:30"/><verse number="31" style="v" sid="NUM 14:31"/>To kuom nyithindu mane uwacho ni ibiro kaw kaka gik moyaki, gin to abiro kelogi mondo giyud mor mar piny mane udagi. <verse eid="NUM 14:31"/><verse number="32" style="v" sid="NUM 14:32"/>To un, ringreu nodongʼ e thim. <verse eid="NUM 14:32"/><verse number="33" style="v" sid="NUM 14:33"/>Nyithindu nobed jokwath e pinyni kuom higni piero angʼwen, ka giyudo thagruok nikech bedou maonge gi ratiro, nyaka ane ni ringre ngʼama ogik odongʼ e thim. <verse eid="NUM 14:33"/><verse number="34" style="v" sid="NUM 14:34"/>Ne ubet ka unono pinyno kuom ndalo piero angʼwen, omiyo unuchul richou kuom higni piero angʼwen, ka higa achiel ikwano kar ndalo achiel, mi unufweny malongʼo gima omiyo akwedou.’ <verse eid="NUM 14:34"/><verse number="35" style="v" sid="NUM 14:35"/>An, Jehova Nyasaye, asewacho, kendo abiro timo gigi adieri ne oganda ma timbegi richogi, moseriwore mar kweda. Giko mar ngimagi notimre e thim; kendo kae ema gibiro thoe.”<verse eid="NUM 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 14:36"/>Omiyo joma Musa ne oseoro mondo odhi onon pinyno, mi odwogo kendo omiyo oganda duto ma timbegi richogi ongʼur kode kaluwore gi wach marach mane gikelo kuom pinyno; <verse eid="NUM 14:36"/><verse number="37" style="v" sid="NUM 14:37"/>jogi mane okelo wach marachni kuom pinyno noneg-gi gi masira e nyim Jehova Nyasaye. <verse eid="NUM 14:37"/><verse number="38" style="v" sid="NUM 14:38"/>Kuom joma nodhi nono pinyno, Joshua wuod Nun kod Kaleb wuod Jefune kende ema notony.<verse eid="NUM 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39"/>Ka Musa nowacho ne jo-Israel duto wachni kendo ne giywak gi lit ahinya. <verse eid="NUM 14:39"/><verse number="40" style="v" sid="NUM 14:40"/>Kiny gokinyi mangʼich ne giwuok mi gidhi e piny manie got. Negiwacho niya, “Wasetimo richo. Wabiro dhi nyaka kama Jehova Nyasaye nosingo.”<verse eid="NUM 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 14:41"/>To Musa nowachonegi niya, “Angʼo momiyo utamoru winjo chik Jehova Nyasaye? Mano ok bi timore! <verse eid="NUM 14:41"/><verse number="42" style="v" sid="NUM 14:42"/>Kik udhi kuno, nikech Jehova Nyasaye oseweyou. Wasiku biro lou, <verse eid="NUM 14:42"/><verse number="43" style="v" sid="NUM 14:43"/>nimar jo-Amalek kod jo-Kanaan noked kodu kuno. Nikech useweyo Jehova Nyasaye, ok enodhi kodu kendo nonegu gi ligangla.”<verse eid="NUM 14:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 14:44"/>To kata kamano, ne ok gidewo wachno, mi gichako dhi malo e piny got, to Musa kata Sandug Muma mar Jehova Nyasaye ne ok owuok e kambi. <verse eid="NUM 14:44"/><verse number="45" style="v" sid="NUM 14:45"/>Eka jo-Amalek kod jo-Kanaan mane odak e piny got nolor mwalo mi omonjogi kendo neginegogi duto ma gichopo nyaka Horma.<verse eid="NUM 14:45"/></para>
  <chapter eid="NUM 14"/>
  <chapter number="15" style="c" sid="NUM 15"/>
  <para style="s1">Misengini mamoko</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 15:1"/><verse number="2" style="v" sid="NUM 15:2"/>“Wuo gi jo-Israel kendo iwachnegi ni, ‘Bangʼ ka usedonjo e piny mamiyouni kaka kar dak <verse eid="NUM 15:2"/><verse number="3" style="v" sid="NUM 15:3"/>kendo uchiwone Jehova Nyasaye misengini miwangʼo pep koa kuom kweth mag dhok kata mag jamni, kaka gima dungʼ tik mangʼwe ngʼar mamoro Jehova Nyasaye bed ni gin misengini miwangʼo pep, chiwo mar hera, chiwo mag kwongʼruok kata mago mag nyasi. <verse eid="NUM 15:3"/><verse number="4" style="v" sid="NUM 15:4"/>Bangʼe ngʼama kelo chiwo mare nokelne Jehova Nyasaye chiwo mar cham maromo achiel kuom apar mar efa mar mogo mayom moruw gi achiel kuom angʼwen mar lita mar mo. <verse eid="NUM 15:4"/><verse number="5" style="v" sid="NUM 15:5"/>Bende nyaka uchiw achiel kuom angʼwen mar lita mar divai mondo obed misango miolo piny kuom nyarombo ka nyarombo mutimogo misango miwangʼo pep kata misango mar nyasi.<verse eid="NUM 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 15:6"/>“ ‘Ka chiayo mitimogo misangono en im, to mogo mitimogo misango mar cham nyaka bed kilo angʼwen gi nus moruw gi mo moromo lita achiel gi nus, <verse eid="NUM 15:6"/><verse number="7" style="v" sid="NUM 15:7"/>kendo uchiw lita achiel gi nus mar divai kaka misango miolo piny. Kamano e kaka unuchiwne Jehova Nyasaye misango madungʼ tik mangʼwe ngʼar ne Jehova Nyasaye.<verse eid="NUM 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 15:8"/>“ ‘To ka en nyarwath ema utimogo ne Jehova Nyasaye misango miwangʼo pep, kata misango mar sawo, kaka singruok mowal kata chiwo mar lalruok ne Jehova Nyasaye, <verse eid="NUM 15:8"/><verse number="9" style="v" sid="NUM 15:9"/>to ukel rwath kaachiel gi chiwo mar cham maromo kilo ariyo mar mogo mayom moru gi nus mar lita mar mo. <verse eid="NUM 15:9"/><verse number="10" style="v" sid="NUM 15:10"/>Bende ukel nus mar lita mar divai kaka misango miolo piny. Obiro bedo chiwo mowangʼ miwangʼo, ma en gima dungʼ tik mangʼwe ngʼar mamoro Jehova Nyasaye. <verse eid="NUM 15:10"/><verse number="11" style="v" sid="NUM 15:11"/>Rwath ka rwath, im ka im, rombo ka rombo, kata nyadiel ka nyadiel, nyaka losi e yo machal kamano. <verse eid="NUM 15:11"/><verse number="12" style="v" sid="NUM 15:12"/>Timuru ma ne misengini duto mag jamni moro ka moro.<verse eid="NUM 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 15:13"/>“ ‘Ngʼato angʼata monywol e pinyni ma ja-Israel nyaka tim gigi, ka okelo chiwo molos gi mach kaka gima dungʼ tik mangʼwe ngʼar mamoro Jehova Nyasaye. <verse eid="NUM 15:13"/><verse number="14" style="v" sid="NUM 15:14"/>To ne tiengʼ mabiro, kinde duto ma japiny moro kata ngʼato angʼata modak e kindu okelo misango molos gi mach kaka gima dungʼ tik mangʼwe ngʼar mamoro Jehova Nyasaye, nyaka otim mana kaka utimo. <verse eid="NUM 15:14"/><verse number="15" style="v" sid="NUM 15:15"/>Oganda jo-Israel nyaka bed gi chike machalre ne tiengʼ mabiro kod jopinje mamoko; ma en singo mochwere ne tiengʼ mabiro. Un kod jopinje mamoko nubed machalre e nyim Jehova Nyasaye: <verse eid="NUM 15:15"/><verse number="16" style="v" sid="NUM 15:16"/>Chik achiel ema omakou machalre gi jopinje mamoko modak e dieru.’ ”<verse eid="NUM 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 15:17"/><verse number="18" style="v" sid="NUM 15:18"/>“Wuo gi jo-Israel kendo iwachnegi kama: ‘Ka udonjo e piny ma ateroue, <verse eid="NUM 15:18"/><verse number="19" style="v" sid="NUM 15:19"/>kendo uchamo chiemb pinyno, to uchiw bathe moko kaka misango ne Jehova Nyasaye. <verse eid="NUM 15:19"/><verse number="20" style="v" sid="NUM 15:20"/>Chiw cham moa e nyak mokwongo mar lopi kendo ichiwe kaka misango moa e laru mar dino cham. <verse eid="NUM 15:20"/><verse number="21" style="v" sid="NUM 15:21"/>E tienge duto mabiro nyaka ugol misangoni ne Jehova Nyasaye koa e nyak mokwongo mar lopi.<verse eid="NUM 15:21"/></para>
  <para style="s1">Misengini mag richo ma ngʼato otimo kokia</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22"/>“ ‘Ka e kia maru ok urito chike mane Jehova Nyasaye omiyo Musa, <verse eid="NUM 15:22"/><verse number="23" style="v" sid="NUM 15:23"/>ma gin chike mane omiyou kokalo kuome, chakre e kinde mane Jehova Nyasaye ochiwogie kendo ka gidhi nyime nyaka e tienge mabiro; <verse eid="NUM 15:23"/><verse number="24" style="v" sid="NUM 15:24"/>to ka ma otim maonge chenro ka oganda ok ongʼeyo, to oganda duto nochiw nyarwath matin kaka misango miwangʼo pep ma en gima dungʼ tik mangʼwe ngʼar mamoro Jehova Nyasaye, kaachiel gi chiwo mar cham kod misango miolo piny, kod nywok kaka misango mar golo richo. <verse eid="NUM 15:24"/><verse number="25" style="v" sid="NUM 15:25"/>Jadolo notim pwodhoruok ne oganda duto mag jo-Israel, kendo nowenegi richogi, nimar ne ok gingʼeyo gima negitimo kendo gisekelone Jehova Nyasaye misango mowangʼ pep kuom ketho margi kod misango mar golo richo. <verse eid="NUM 15:25"/><verse number="26" style="v" sid="NUM 15:26"/>Oganda duto mag jo-Israel kod jopinje mamoko manie dieru nowenegi richogi, nikech ji duto notimo richo ka ok gingʼeyo.<verse eid="NUM 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27"/>“ ‘To ka ngʼato achiel ema otimo richo ka ok ongʼeyo, to nyaka ochiw diel madhako ma ja-higa achiel kaka misango mar golo richo. <verse eid="NUM 15:27"/><verse number="28" style="v" sid="NUM 15:28"/>Jadolo notim pwodhruok e nyim Jehova Nyasaye ne ngʼatno motimo richo ka ok ongʼeyo, kendo ka osetimne pwodhruok, nowene richo. <verse eid="NUM 15:28"/><verse number="29" style="v" sid="NUM 15:29"/>Chik achielno ema oket ne ngʼato angʼata motimo richo ka ok ongʼeyo, bed ni en jakanyo ma ja-Israel kata japiny moro.<verse eid="NUM 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 15:30"/>“ ‘To ka ngʼato otimo richo gi wangʼ matek, bed ni en japinyno kata japiny moro, to ojaro Jehova Nyasaye, kendo ngʼat makamano onego ogol oko e dier jogi. <verse eid="NUM 15:30"/><verse number="31" style="v" sid="NUM 15:31"/>Nikech osejaro wach Jehova Nyasaye kendo oketho chikene, ngʼatno nyaka gol oko; kendo richo mare nodongʼ e wiye.’ ”<verse eid="NUM 15:31"/></para>
  <para style="s1">Ngʼama oketho Sabato inego</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32"/>Kane jo-Israel ne nitie e thim, ngʼat moro noyud ka modo yien chiengʼ Sabato. <verse eid="NUM 15:32"/><verse number="33" style="v" sid="NUM 15:33"/>Joma ne oyude ka omodo yien nokele ir Musa gi Harun kod chokruok duto, <verse eid="NUM 15:33"/><verse number="34" style="v" sid="NUM 15:34"/>kendo ne gikane e od twech, nikech ne ok ongʼere malongʼo gima onego timne. <verse eid="NUM 15:34"/><verse number="35" style="v" sid="NUM 15:35"/>Eka Jehova Nyasaye nowacho ne Musa niya, “Ngʼatno nyaka negi. Chokruok duto nyaka chiele gi kite e oko mar kambi.” <verse eid="NUM 15:35"/><verse number="36" style="v" sid="NUM 15:36"/>Omiyo ogandago nogole oko mar kambi kendo negichiele gi kite motho, mana kaka Jehova Nyasaye nochiko Musa.<verse eid="NUM 15:36"/></para>
  <para style="s1">Usi motwangʼ e riak law</para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 15:37"/><verse number="38" style="v" sid="NUM 15:38"/>“Wuo gi jo-Israel kendo iwachnegi kama: ‘Ne tiengʼ duto mabiro nyaka umin usi e riak lepu ka usi moro ka moro olwor gi kido marambulu. <verse eid="NUM 15:38"/><verse number="39" style="v" sid="NUM 15:39"/>Usi momin molier e riak lepugo nomi unupar chike duto mag Jehova Nyasaye, mondo omi uritgi ma ok uteroru gi gombo mag chunjeu kod wengeu uwegi. <verse eid="NUM 15:39"/><verse number="40" style="v" sid="NUM 15:40"/>Bangʼ mano unupar mar rito chikena duto kendo nowalu tenge ne Nyasachu. <verse eid="NUM 15:40"/><verse number="41" style="v" sid="NUM 15:41"/>An e Jehova Nyasaye ma Nyasachu, mane ogolou Misri mondo obed Nyasachu. An Jehova Nyasaye ma Nyasachu.’ ”<verse eid="NUM 15:41"/></para>
  <chapter eid="NUM 15"/>
  <chapter number="16" style="c" sid="NUM 16"/>
  <para style="s1">Kora, Dathan kod Abiram jongʼanyo</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1"/>Kora wuod Izhar, ma wuod Kohath, ma wuod Lawi, kod joka Reuben moko kaka Dathan gi Abiram, ma yawuot Eliab kod On wuod Peleth noriwore kaachiel <verse eid="NUM 16:1"/><verse number="2" style="v" sid="NUM 16:2"/>kendo negichokore mondo giked gi Musa. Kaachiel kodgi ne nitiere jo-Israel mia ariyo gi piero abich, ma jotend oganda mongʼere mane oseyier kaka jakanyo mar bura. <verse eid="NUM 16:2"/><verse number="3" style="v" sid="NUM 16:3"/>Negibiro kaka oganda achiel mochokore mondo giked gi Musa kod Harun kendo negiwachonegi niya, “Usetimo mokalo tongʼ! Oganda duto ler, ngʼato ka ngʼato kuomgi, kendo Jehova Nyasaye ni kodgi. En angʼo momiyo koro uketoru malo moloyo oganda mar Jehova Nyasaye?”<verse eid="NUM 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 16:4"/>Kane Musa owinjo wachno, nopodho piny auma. <verse eid="NUM 16:4"/><verse number="5" style="v" sid="NUM 16:5"/>Eka nowacho ne Kora kod jolupne duto niya, “Kochopo gokinyi Jehova Nyasaye noyier joma oyie kuome kendo maler, kendo norwak ngʼatno obi bute. <verse eid="NUM 16:5"/><verse number="6" style="v" sid="NUM 16:6"/>To in, Kora, kod joma luwou duto nyaka tim ma: Kawuru ubani <verse eid="NUM 16:6"/><verse number="7" style="v" sid="NUM 16:7"/>kendo kiny umok mach kod gima dungʼ tik mangʼwe ngʼar e nyim Jehova Nyasaye. Ngʼatno ma Jehova Nyasaye oyiero ema nobed ngʼama ler. Un jo-Lawi usekalo tongʼ!”<verse eid="NUM 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 16:8"/>Musa bende nowacho ne Kora niya, “Koro Winjuru, un jo-Lawi! <verse eid="NUM 16:8"/><verse number="9" style="v" sid="NUM 16:9"/>Ok lichnu ni Nyasach Israel osegolou oko mar oganda jo-Israel mamoko kendo okelou bute owuon mondo uti e hekalu mar Jehova Nyasaye kendo mondo uchung e nyim oganda kendo utinegi? <verse eid="NUM 16:9"/><verse number="10" style="v" sid="NUM 16:10"/>Osekelou kod jo-Lawi weteu duto bute, to koro sani utemo bedo jodolo bende. <verse eid="NUM 16:10"/><verse number="11" style="v" sid="NUM 16:11"/>Un kaachiel gi joma luwou duto usengʼanyo ni Jehova Nyasaye. Harun to en ngʼa ma ungʼurne?”<verse eid="NUM 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12"/>Eka Musa noluongo Dathan kod Abiram, ma yawuot Eliab. To negiwacho niya, “Ok wanabi! <verse eid="NUM 16:12"/><verse number="13" style="v" sid="NUM 16:13"/>Ok lichni ni isegolowa e piny mopongʼ gi chak kod mor kich mondo inegwa e thim? Kendo sani koro idwaro miyowa tingʼ mapek? <verse eid="NUM 16:13"/><verse number="14" style="v" sid="NUM 16:14"/>Kata kamano, pod ok ikelowa e piny mopongʼ gi chak kod mor kich kata miyowa girkeni mag puothe kod puothe mag mzabibu. Ubiro lodho wenge jogi oko? Ngangʼ, ok wanabi!”<verse eid="NUM 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 16:15"/>Eka Musa iye nowangʼ matek mi owachone Jehova Nyasaye niya, “Kik iyie gi misengini mag-gi. Pod ok akawo kata mana punda achiel koa kuomgi, kata mana kethone ngʼato angʼata kuomgi.”<verse eid="NUM 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 16:16"/>Musa nowacho ne Kora niya, “In kaachiel gi jolupni duto kod Harun bende nyaka ubi e nyim Jehova Nyasaye. <verse eid="NUM 16:16"/><verse number="17" style="v" sid="NUM 16:17"/>Ngʼato ka ngʼato nyaka kaw tape owuon ma mach ni e yie kendo oketie ubani mangʼwe ngʼar madirom mia ariyo gi piero abich mi uchiwe e nyim Jehova Nyasaye in kaachiel gi Harun.” <verse eid="NUM 16:17"/><verse number="18" style="v" sid="NUM 16:18"/>Omiyo ngʼato ka ngʼato nokawo tape owuon ma mach nitie iye kendo oketoe ubani mangʼwe ngʼar mine gichungʼ kod Musa gi Harun e dhoranga Hemb Romo. <verse eid="NUM 16:18"/><verse number="19" style="v" sid="NUM 16:19"/>Kane Kora osechoko joge duto mondo okwedgo Musa gi Harun e dhoranga Hemb Romo, duongʼ Jehova Nyasaye ne onyisore ayanga ne oganda mane ochokore duto. <verse eid="NUM 16:19"/><verse number="20" style="v" sid="NUM 16:20"/>Jehova Nyasaye nowacho ne Musa kod Harun niya, <verse eid="NUM 16:20"/><verse number="21" style="v" sid="NUM 16:21"/>“Pogreuru gi kanyakla mar ogandani mondo omi atiekgi chuth.”<verse eid="NUM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 16:22"/>To Musa kod Harun nopodho auma moywak niya, “Yaye Nyasaye, mongʼeyo chunje duto mag dhano, iyi diwangʼ gi kanyakla mar ogandagi duto ka en mana ngʼato achiel ema otimo richo?”<verse eid="NUM 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 16:23"/>Eka Jehova Nyasaye nowacho ne Musa ni, <verse eid="NUM 16:23"/><verse number="24" style="v" sid="NUM 16:24"/>“Wachne kanyakla mar oganda kama: ‘Daruru uwuog machiegni gi hembe Kora, Dathan kod Abiram.’ ”<verse eid="NUM 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 16:25"/>Musa noa malo modhi ir Dathan kod Abiram, kendo jodong Israel noluwe. <verse eid="NUM 16:25"/><verse number="26" style="v" sid="NUM 16:26"/>Nochiwo siem ne kanyakla mar oganda niya, “Suduru mabor gi hembe jogo ma timbegi richo! Kik umul girgi moro amora, ka ok kamano to ubiro lal nono nikech richo mag-gi.” <verse eid="NUM 16:26"/><verse number="27" style="v" sid="NUM 16:27"/>Omiyo negisudo mabor gi hembe mag Kora, Dathan kod Abiram. Dathan kod Abiram nosewuok oko kendo negichungo gi mondegi, nyithindgi kod rowere mag-gi e dhoranga hembegi.<verse eid="NUM 16:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 16:28"/>Eka Musa nowacho niya, “Ma e kaka ubiro ngʼeyo ni Jehova Nyasaye ema noora mondo atim gigi duto kendo ni ne ok en pacha awuon: <verse eid="NUM 16:28"/><verse number="29" style="v" sid="NUM 16:29"/>Ka dipo ni jogi otho mana kaka ji duto nyalo tho, to kare Jehova Nyasaye ne ok oora. <verse eid="NUM 16:29"/><verse number="30" style="v" sid="NUM 16:30"/>To ka Jehova Nyasaye okelo gima nyien mopogore gi mago duto mapile, kendo ma piny oyawo dhoge mi omwonyogi, gi gik moko duto ma mekgi, kendo ma gidhi ei bur ka gingima, eka unungʼe ni jogi osewuotho e nyim Jehova Nyasaye gi achaya.”<verse eid="NUM 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31"/>Mana gi sa mane otieko wacho gigi, lowo mane ni e bwo tiendgi nobarore, <verse eid="NUM 16:31"/><verse number="32" style="v" sid="NUM 16:32"/>kendo piny noyawo dhoge mi omwonyogi, gi joodgi duto kod joka Kora duto kod mwandugi duto. <verse eid="NUM 16:32"/><verse number="33" style="v" sid="NUM 16:33"/>Negidhi e bur kagingima mi lowo uomogi kod mwandugi kendo negilal nono ei oganda Israel. <verse eid="NUM 16:33"/><verse number="34" style="v" sid="NUM 16:34"/>E kinde mane giywak, jo-Israel duto mane ni machiegni kodgi noringo, kaywak niya, “Wan bende piny dhi mwonyowa!”<verse eid="NUM 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 16:35"/>Kendo mach nowuok koa kuom Jehova Nyasaye mi owangʼo ji mia ariyo gi piero abich mane oyudo chiwo misango mangʼwe ngʼar.<verse eid="NUM 16:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 16:36"/><verse number="37" style="v" sid="NUM 16:37"/>“Nyis Eliazar wuod Harun, ma jadolo, mondo ogol tawo miwangʼo ubani kendo okee mirni mar mach mabor, nimar tawono ler <verse eid="NUM 16:37"/><verse number="38" style="v" sid="NUM 16:38"/>nimar gin tawo mag joma otimo richo ewi ngimagi giwegi. Los tawono moriere kendo iketgi ewi kendo mar misango, nimar nochiwgi e nyim Jehova Nyasaye kendo gisebedo maler. We gibed ranyisi ne jo-Israel.”<verse eid="NUM 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 16:39"/>Omiyo Eliazar jadolo nochoko tawo mar mula mane okel gi jogo mane osewangʼ, kendo nochokogi kanyakla monywasogi mondo muon-go kendo mar misango, <verse eid="NUM 16:39"/><verse number="40" style="v" sid="NUM 16:40"/>mana kaka Jehova Nyasaye nochike kokalo kuom Musa. Ma ne parone jo-Israel ni onge ngʼato angʼata makmana nyikwa Harun ema onego bi mondo owangʼ gima dungʼ tik mangʼwe ngʼar e nyim Jehova Nyasaye, ka ok kamano to obiro chalo kaka Kora kod jolupne.<verse eid="NUM 16:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41"/>Kinyne oganda mar jo-Israel duto nongʼurne Musa kod Harun. Negiwachonegi niya, “Usenego jo-Jehova Nyasaye.”<verse eid="NUM 16:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 16:42"/>To ka ogandano nochokore mar kwedo Musa kod Harun kendo gilokore ka gingʼiyo Hemb Romo, apoya nono boche polo noume kendo duongʼ mar Jehova Nyasaye noyangore. <verse eid="NUM 16:42"/><verse number="43" style="v" sid="NUM 16:43"/>Eka Musa kod Harun nodhi e nyim Hemb Romo, <verse eid="NUM 16:43"/><verse number="44" style="v" sid="NUM 16:44"/>kendo Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 16:44"/><verse number="45" style="v" sid="NUM 16:45"/>“Wuogi e kanyakla mondo omi atiekgi chuth.” Kendo Musa gi Harun nopodho auma e nyim Jehova Nyasaye.<verse eid="NUM 16:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 16:46"/>Eka Musa nowacho ne Harun niya, “Kaw tawo mar ubani mari kendo iket gima dungʼ tik mangʼwe ngʼar e iye, kaachiel gi mach moa e kendo mar misango, kendo iret idhi e chokruokno mondo itimnegi misango mar pwodhruok e richo. Mirima osebiro koa ir Jehova Nyasaye; masiche osechakore.” <verse eid="NUM 16:46"/><verse number="47" style="v" sid="NUM 16:47"/>Omiyo Harun notimo kaka Musa nowachone, kendo noringo modhi e dier chokruok. Masira ne osechakore e dier ji, to Harun nochiwo gima dungʼ tik mangʼwe ngʼar kendo nokwayonegi ngʼwono kuom gima gisetimo. <verse eid="NUM 16:47"/><verse number="48" style="v" sid="NUM 16:48"/>Nochungʼ e kind joma ngima gi joma otho, mi masiche norumo. <verse eid="NUM 16:48"/><verse number="49" style="v" sid="NUM 16:49"/>Makmana ji alufu apar gangʼwen gi mia abiriyo (14,700) nosetho nikech masichego, komedore gi jogo mane osetho nikech Kora. <verse eid="NUM 16:49"/><verse number="50" style="v" sid="NUM 16:50"/>Eka Harun noduogo ir Musa e dhoranga Hemb Romo, nimar masiche noserumo.<verse eid="NUM 16:50"/></para>
  <chapter eid="NUM 16"/>
  <chapter number="17" style="c" sid="NUM 17"/>
  <para style="s1">Odunga mar Harun oloth</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 17:1"/><verse number="2" style="v" sid="NUM 17:2"/>“Wuo gi jo-Israel kendo ichok odunga apar gariyo koa kuomgi, achiel ka achiel koa kuom jatelo moro ka moro mar dhoutgi. Ndik nying ngʼato ka ngʼato kuom odungane. <verse eid="NUM 17:2"/><verse number="3" style="v" sid="NUM 17:3"/>E odunga mar Lawi ndike nying Harun, nimar nyaka bedi odunga achiel mar jatelo mar dhoot ka dhoot. <verse eid="NUM 17:3"/><verse number="4" style="v" sid="NUM 17:4"/>Ketgi e Hemb Romo e nyim Sandug Rapar, kama aromoe kodi. <verse eid="NUM 17:4"/><verse number="5" style="v" sid="NUM 17:5"/>Odunga mar ngʼat mayiero biro loth, kendo abiro tieko chuth ngʼur ma jo-Israel ngʼurnigo maonge giko.”<verse eid="NUM 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 17:6"/>Omiyo Musa nowuoyo gi jo-Israel, kendo jotendgi nomiye odunga apar gariyo, ka moro ka moro en mar dhoutgi, kendo odunga mar Harun ne achiel kuomgi. <verse eid="NUM 17:6"/><verse number="7" style="v" sid="NUM 17:7"/>Musa noketo odungago e nyim Jehova Nyasaye e Hema e nyim Sandug Rapar.<verse eid="NUM 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 17:8"/>Kinyne Musa nodonjo ei Hemb Rapar kendo noneno odunga mar Harun, mane ochungʼ e lo Lawi, ne pok ochako loth kende to thuokene bende nosechako dongo, ka gingʼich mamoro wangʼ kendo gigolo olembe mag oyungu. <verse eid="NUM 17:8"/><verse number="9" style="v" sid="NUM 17:9"/>Eka Musa nogolo odunga duto e nyim Jehova Nyasaye mi okelone jo-Israel duto. Ne gingʼiyogi, kendo ngʼato ka ngʼato nokawo odungane owuon.<verse eid="NUM 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 17:10"/>Jehova Nyasaye nowacho ne Musa niya, “Dwok odunga mar Harun e nyim Sandug Rapar, mondo kane kaka ranyisi ne joma ongʼanyo. Mano biro tieko chuth kitgi mar ngʼur koda, mondo omi kik githo.” <verse eid="NUM 17:10"/><verse number="11" style="v" sid="NUM 17:11"/>Musa notimo mana kaka Jehova Nyasaye nonyise.<verse eid="NUM 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 17:12"/>Jo-Israel nowacho ne Musa niya, “Wabiro tho! Waserwenyo, kendo wan duto waselal! <verse eid="NUM 17:12"/><verse number="13" style="v" sid="NUM 17:13"/>Ngʼato angʼata mosudo machiegni gi hekalu mar Jehova Nyasaye biro tho. Dibed ni wan duto wabiro tho?”<verse eid="NUM 17:13"/></para>
  <chapter eid="NUM 17"/>
  <chapter number="18" style="c" sid="NUM 18"/>
  <para style="s1">Tije mag jodolo kod jo-Lawi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1"/>Jehova Nyasaye nowacho ne Harun niya, “In gi yawuoti kod od wuonu nyaka ukaw tingʼ mag richo motimne kama ler mar lemo, kendo in-gi yawuoti kende ema nyaka ukaw tingʼ richo motimne jodolo. <verse eid="NUM 18:1"/><verse number="2" style="v" sid="NUM 18:2"/>Kel jo-Lawi weteu koa e dhoutu mag anywola mondo oriwre kodi kendo gikonyu ka in kod yawuote tiyo e nyim Hema mar Sandug Rapar. <verse eid="NUM 18:2"/><verse number="3" style="v" sid="NUM 18:3"/>Nyaka giwinju kendo giti tije duto mag Hema, to kik gidhi machiegni gi gig kama ler mar lemo kata mag kendo mar misango, ka ok kamano to gin kod un duto ubiro tho. <verse eid="NUM 18:3"/><verse number="4" style="v" sid="NUM 18:4"/>Nyaka giriwre kodi kendo gikaw tich mar rito Hemb Romo kaachiel gi tije duto manie Hema, kendo onge ngʼat machielo moyiene biro machiegni gi kama intie.<verse eid="NUM 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 18:5"/>“Nyaka ikaw tich mar rito kama ler mar lemo kod kendo mar misango, mondo mi masira kik lwar kuom jo-Israel kendo. <verse eid="NUM 18:5"/><verse number="6" style="v" sid="NUM 18:6"/>An awuon aseyiero jo-Lawi weteni koa kuom jo-Israel kaka chiwo ne un, mowal ne Jehova Nyasaye mondo oti e Hemb Romo. <verse eid="NUM 18:6"/><verse number="7" style="v" sid="NUM 18:7"/>To in kod yawuoti kende ema onego bed jodolo kaluwore gi gik moko duto manie kendo mar misango kod mago mantiere ei pasia. Amiyou tich mar bedo jodolo kaka chiwo. Ngʼato angʼata ma osudo machiegni gi kama ler mar lemo nyaka negi.”<verse eid="NUM 18:7"/></para>
  <para style="s1">Chiwo mag jodolo kod jo-Lawi</para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8"/>Eka Jehova Nyasaye nowacho ne Harun niya, “An awuon aseketi jarit mar chiwo duto mokelna; chiwo maler duto ma jo-Israel omiya amiyi kod yawuoti kaka pok maru kendo mano ema unuyud pile. <verse eid="NUM 18:8"/><verse number="9" style="v" sid="NUM 18:9"/>Nyaka ikaw thoth bath chiwo duto maler ma ok owangʼ e mach. Koa kuom mich duto ma gikelona kaka chiwo maler moloyo, bedni en chiwo mar cham, kata mar misango mar golo richo kata mar pwodhruok, pokno en mari kod yawuoti. <verse eid="NUM 18:9"/><verse number="10" style="v" sid="NUM 18:10"/>Chame kaka gima ler moloyo; chwo duto nochame. Nyaka ikawe kaka gima ler.<verse eid="NUM 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 18:11"/>“Gimoro amora mowal tenge koa e mich mag misango mifwayo mar jo-Israel bende nobed mari. Achiwo ma ne in kod yawuoti gi nyigi kaka pok maru mapile pile. Ngʼato angʼata mantiere e odi mopwodhore maler nyalo chame.<verse eid="NUM 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 18:12"/>“Amiyou mo zeituni mayom duto kod divai manyien mayom duto kod cham ma gichiwone Jehova Nyasaye kaka olemo mokwongo mar keyo margi. <verse eid="NUM 18:12"/><verse number="13" style="v" sid="NUM 18:13"/>Olembe mokwongo duto moa e puodho ma gikelone Jehova Nyasaye nobed mari. Ngʼato angʼata mantiere e odi mopwodhore maler nyalo chame.<verse eid="NUM 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 18:14"/>“Gimoro amora mochiwne Jehova Nyasaye chuth nobed magu. <verse eid="NUM 18:14"/><verse number="15" style="v" sid="NUM 18:15"/>Nyodo mokwongo mar ich, obed dhano kata chiayo, mochiwne Jehova Nyasaye en mari. To nyaka uwar wuowi makayo moro amora kod kayo madichwo moro amora mar jamni ma ok ler. <verse eid="NUM 18:15"/><verse number="16" style="v" sid="NUM 18:16"/>Ka giromo dwe achiel, nyaka iwargi e nengo mar wero ma en shekel abich mar fedha, kaluwore gi shekel mar kama ler mar lemo, ma pekne romo gera piero ariyo.<verse eid="NUM 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 18:17"/>“To kik iwar kayo ma rwath, rombo kata diel; nikech giler. Kir rembgi e kendo mar misango kendo iwangʼ mo mawuok kuomgi kaka misango miwangʼo gi mach, ma en gima dungʼ tik mangʼwe ngʼar mamoro Jehova Nyasaye. <verse eid="NUM 18:17"/><verse number="18" style="v" sid="NUM 18:18"/>Ring jamnigo gin magu, mana kaka misango mifwayo mar agoko kod em korachwich bende maru. <verse eid="NUM 18:18"/><verse number="19" style="v" sid="NUM 18:19"/>Gimoro amora mowal tenge koa kuom misengini maler ma jo-Israel ochiwo ne Jehova Nyasaye, amiyoi gi yawuoti kod nyigi kaka pok maru mapile. En singruok ma ok rum e nyim Jehova Nyasaye ne in kaachiel gi nyikwayi.”<verse eid="NUM 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 18:20"/>Jehova Nyasaye nowacho ne Harun niya, “Ok iniyud girkeni mora amora e piny jogi, kata pok moro amora ok inibedgo e kindgi nimar an e pok maru kendo girkeni maru e kind jo-Israel.<verse eid="NUM 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 18:21"/>“Amiyo jo-Lawi achiel kuom apar duto mantiere e Israel kaka girkeni margi ka achulogigo kuom tich ma gitiyo e Hemb Romo. <verse eid="NUM 18:21"/><verse number="22" style="v" sid="NUM 18:22"/>Chakre kawuono jo-Israel ok onego dhi machiegni gi Hemb Romo, ka ok kamano to ibiro kumogi kuom richo mag-gi kendo gibiro tho. <verse eid="NUM 18:22"/><verse number="23" style="v" sid="NUM 18:23"/>En mana jo-Lawi ema oyienegi mar tiyo tij Hemb Romo kendo kaw tingʼ duto mag richo motimie Hemb Romo. Ma en chik mogik makende ne tiengʼ mabiro. Ok giniyud girkeni moro amora kuom jo-Israel. <verse eid="NUM 18:23"/><verse number="24" style="v" sid="NUM 18:24"/>Kata kamano, amiyo jo-Lawi kaka girkeni margi achiel kuom apar ma jo-Israel ochiwo kaka misango ne Jehova Nyasaye. Mano emomiyo ne awacho kama kuomgi: ‘Ok giniyud girkeni e dier jo-Israel.’ ”<verse eid="NUM 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 18:25"/><verse number="26" style="v" sid="NUM 18:26"/>“Wuo gi jo-Lawi kendo iwachnegi kama: ‘Ka uyudo koa kuom jo-Israel achiel kuom apar ma amiyou kaka girkeni magu, to nyaka un bende ugol achiel kuom apar mar achiel kuom aparno kaka chiwo ne Jehova Nyasaye. <verse eid="NUM 18:26"/><verse number="27" style="v" sid="NUM 18:27"/>Chiwouno nokwan kaka cham moa kar dino kata kaka divai mimadho moa kar biyo divai. <verse eid="NUM 18:27"/><verse number="28" style="v" sid="NUM 18:28"/>E yo machalo kama ema un bende ubiro chiwoe chiwo ne Jehova Nyasaye koa kuom achiel kuom apar duto muyudo koa kuom jo-Israel. E achiel kuom apargo, nyaka ichiw pok mar Jehova Nyasaye ne Harun, jadolo. <verse eid="NUM 18:28"/><verse number="29" style="v" sid="NUM 18:29"/>Nyaka ichiw pok mar Jehova Nyasaye gino maber kendo maler moloyo mar gik moko duto ma omiu.’<verse eid="NUM 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 18:30"/>“Wachne jo-Lawi kama: ‘Ka ichiwo mano maber, to ibiro kwane ne in kaka gima oa e kar dino cham kata kar biyo divai. <verse eid="NUM 18:30"/><verse number="31" style="v" sid="NUM 18:31"/>Un kod jouteu duto unyalo chamo bathe moko kamoro amora, nimar en pok maru ne tich mutiyo e Hemb Romo. <verse eid="NUM 18:31"/><verse number="32" style="v" sid="NUM 18:32"/>Ka usegolone Jehova Nyasaye gik mabeyo moloyo kamano, to ok unubed joketho kuom wachno, kendo ok nobed ni udwanyo gik maler ma jo-Israel ochiwo kendo ok ubi tho.’ ”<verse eid="NUM 18:32"/></para>
  <chapter eid="NUM 18"/>
  <chapter number="19" style="c" sid="NUM 19"/>
  <para style="s1">Pi mar pwodhruok</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1"/>Jehova Nyasaye nowacho ne Musa gi Harun niya, <verse eid="NUM 19:1"/><verse number="2" style="v" sid="NUM 19:2"/>“Ma e dwaro mar chik ma Jehova Nyasaye osechiko: Nyis jo-Israel mondo okel nyaroya ma silwal maonge songa kata ma ok ongʼol kendo mapok otwe e jok. <verse eid="NUM 19:2"/><verse number="3" style="v" sid="NUM 19:3"/>Chiwe ne Eliazar jadolo; kendo nyaroyano nyaka gol oko mar kambi mi yangʼe ka oneno. <verse eid="NUM 19:3"/><verse number="4" style="v" sid="NUM 19:4"/>Bangʼe Eliazar jadolo nyaka kaw rembe moko e lith lwete kendo okwoye nyadibiriyo kochiko nyim Hemb Romo. <verse eid="NUM 19:4"/><verse number="5" style="v" sid="NUM 19:5"/>E kinde ma pod ongʼicho nyaroyano nyaka wangʼ piende, ringe, rembe kod wen. <verse eid="NUM 19:5"/><verse number="6" style="v" sid="NUM 19:6"/>Jadolo nokaw yiende moko mag sida, owino gi usi marakwaro kendo owitgi kuom nyaroya ma wangʼno. <verse eid="NUM 19:6"/><verse number="7" style="v" sid="NUM 19:7"/>Bangʼ mano, jadolo nyaka luok lepe kendo olwokre gi pi. Bangʼe onyalo donjo e kambi, makmana ni obiro bedo mochido nyaka chop odhiambo. <verse eid="NUM 19:7"/><verse number="8" style="v" sid="NUM 19:8"/>Ngʼatno mowangʼo nyaroyano bende nyaka luok lepe, kendo olwokre, en bende nobed mochido nyaka chop odhiambo.<verse eid="NUM 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 19:9"/>“Ngʼat maler nochok buru mag nyaroyano kendo oketgi kar misango maler e oko mar kambi. Ginikan-gi gi dhout oganda mar jo-Israel mondo ti kodgi e pi pwodhruok; nikech en mar pwodho ji aa e richo. <verse eid="NUM 19:9"/><verse number="10" style="v" sid="NUM 19:10"/>Ngʼatno mochoko buch nyaroyano nyaka luok lepe bende, to en bende nobed mochido nyaka chop odhiambo. Ma nobedi chik mosiko ne jo-Israel kaachiel gi jopinje mamoko modak kodgi.<verse eid="NUM 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11"/>“Ngʼato angʼata momulo ringre ngʼama otho biro bedo mochido kuom ndalo abiriyo. <verse eid="NUM 19:11"/><verse number="12" style="v" sid="NUM 19:12"/>Nyaka opwodhre owuon gi pi chiengʼ mar adek kod chiengʼ mar abiriyo; eka obiro bedo maler. To ka ok opwodhore owuon chiengʼ mar adek gi chiengʼ mar abiriyo, to ok obi bedo maler. <verse eid="NUM 19:12"/><verse number="13" style="v" sid="NUM 19:13"/>Ngʼato angʼata momulo ringre ngʼama otho kendo ma ok opwodhore owuon ochido hekalu mar Jehova Nyasaye. Ngʼatno nyaka gol oko mar Israel. Nikech pi mar pwodhruok pod ok okir kuome, ochido; kendo chidono odongʼ kuome.<verse eid="NUM 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14"/>“Chik momako ngʼama otho e hema ema: Ngʼato angʼata modonjo ei hema kendo ngʼato angʼata mantiere e iye nobed mochido kuom ndalo abiriyo, <verse eid="NUM 19:14"/><verse number="15" style="v" sid="NUM 19:15"/>kendo mikebe moro amora maonge raum moumego nobed mochido.<verse eid="NUM 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 19:16"/>“Ngʼato angʼata man oko momulo ngʼatno mane onegi gi ligangla kata ngʼat motho kende, kata ngʼatno momulo chok dhano, kata liel, nobedi mochido kuom ndalo abiriyo.<verse eid="NUM 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 19:17"/>“Ne ngʼatno mochido, ket buru moko moa e misango mar pwodhruok kendo uruw gi pi maler mi uol e wigi. <verse eid="NUM 19:17"/><verse number="18" style="v" sid="NUM 19:18"/>Eka ngʼatno maler nokaw owino, gilute e pi kendo gikuo pi e hema kod e gik moko duto molosgo ii hekalu gi ji man kanyo. Bende nyaka okwo pi kuom ngʼato angʼata mabed ni osemulo chok ngʼama osetho kata liel kata ngʼato ma osenegi kata ngʼato motho athoya. <verse eid="NUM 19:18"/><verse number="19" style="v" sid="NUM 19:19"/>Ngʼat maler ema nyaka kir pi kuom ngʼat mochidono chiengʼ mar adek gi mar abiriyo, to kochopo e odiechiengʼ mar abiriyo nyaka opwodhe. Ngʼama ipwodhono nyaka luok lepe kendo luokre gi pi, kendo odhiambono nobed mapoth. <verse eid="NUM 19:19"/><verse number="20" style="v" sid="NUM 19:20"/>To ka ngʼat mochido ok opwodhore owuon, nyaka gole oko e dier oganda, nikech osemiyo kama ler mar lemo mar Jehova Nyasaye ochido. Pi pwodhruokgo pod ok okir kuome, omiyo ochido. <verse eid="NUM 19:20"/><verse number="21" style="v" sid="NUM 19:21"/>Chik mosiko ne gin ema.</para>
  <para style="p" vid="NUM 19:21">“Ngʼat mokiro pi mar pwodhruok nyaka luok lepe bende, kendo ngʼato angʼata momulo pi mar pwodhruok nobed mochido nyaka chop odhiambo. <verse eid="NUM 19:21"/><verse number="22" style="v" sid="NUM 19:22"/>Gimoro amora ma ngʼat mochido omulo nobed mochido, kendo ngʼato angʼata momule nobed mochido nyaka chop odhiambo.”<verse eid="NUM 19:22"/></para>
  <chapter eid="NUM 19"/>
  <chapter number="20" style="c" sid="NUM 20"/>
  <para style="s1">Pi mowuok e lwanda</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1"/>E dwe mokwongo oganda jo-Israel duto nochopo e Thim mar Zin, kendo negidak Kadesh. Kanyo ema Miriam nothoe moike.<verse eid="NUM 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2"/>Koro ne onge pi mane ogandani nyalo modho, kendo ji nochokore mondo okwed Musa gi Harun. <verse eid="NUM 20:2"/><verse number="3" style="v" sid="NUM 20:3"/>Negidhawo gi Musa kagiwacho niya, “Mad ne bed ni watho e kinde mane owetewa otho e nyim Jehova Nyasaye! <verse eid="NUM 20:3"/><verse number="4" style="v" sid="NUM 20:4"/>Angʼo momiyo ikelo oganda Jehova Nyasaye e thimni, mondo mi wan kod jambwa watho kaye? <verse eid="NUM 20:4"/><verse number="5" style="v" sid="NUM 20:5"/>Angʼo momiyo ne igolowa Misri mondo ikelwa e piny malichni? Pinyni onge gi cham kata ngʼowu, mzabibu kata olembe mongʼinore to bende onge kata mana pi modho!”<verse eid="NUM 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 20:6"/>Musa kod Harun nowuok koa e chokruok kochiko dhoranga Hemb Romo mi gipodho auma, kendo duongʼ mar Jehova Nyasaye nofwenyorenegi. <verse eid="NUM 20:6"/><verse number="7" style="v" sid="NUM 20:7"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 20:7"/><verse number="8" style="v" sid="NUM 20:8"/>“Kaw odunga, kod owadu Harun mondo uchok jo-Israel kaachiel. Wuo kod lwanda ka gineno kendo pi biro chwer koa kuome. Ibiro golo pi kowuok e lwandano ne oganda mondo gin kod jambgi gimodhi.”<verse eid="NUM 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 20:9"/>Omiyo Musa nokawo odunga e nyim Jehova Nyasaye mana kaka ne ochike. <verse eid="NUM 20:9"/><verse number="10" style="v" sid="NUM 20:10"/>En kod Harun nochoko chokruok kanyakla e nyim lwanda kendo Musa nowachonegi niya, “Winjuru, un jongʼanyogi, bende ochuno ni nyaka wamiu pi kowuok e lwandani?” <verse eid="NUM 20:10"/><verse number="11" style="v" sid="NUM 20:11"/>Eka Musa norieyo bade malo mi ochwado lwandano nyadiriyo gi odunga mare. Pi nobubni oko, kendo ogandago gi jambgi nomodho.<verse eid="NUM 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 20:12"/>To Jehova Nyasaye nowacho ne Musa kod Harun niya, “Nikech ne ok uketo genou kuoma chuth mondo umiya duongʼ kaka ngʼama ler e nyim jo-Israel, ok unuter ogandani e piny ma amiyogi.”<verse eid="NUM 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 20:13"/>Magi ne gin pige mag Meriba, kama jo-Israel nongʼurie gi Jehova Nyasaye kendo mano e kama nonyisore owuon kaka ngʼama ler e kindgi.<verse eid="NUM 20:13"/></para>
  <para style="s1">Jo-Edom otamo jo-Israel kadho e pinygi</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14"/>Musa nooro joote moa Kadesh ir ruodh Edom, kowacho kama:</para>
  <para style="pm" vid="NUM 20:14">“Ma e gima owadu Israel wacho: Ingʼeyo tije matek duto ma wasebedo godo. <verse eid="NUM 20:14"/><verse number="15" style="v" sid="NUM 20:15"/>Kwerewa nodhi Misri, kendo negidak kuno kuom higni mathoth. Jo-Misri nosandowa kod wuonewa, <verse eid="NUM 20:15"/><verse number="16" style="v" sid="NUM 20:16"/>to kane waywakne Jehova Nyasaye, nowinjo ywakwa kendo nooro malaika mi ogolowa waa Misri.</para>
  <para style="pm" vid="NUM 20:16">“Koro wan Kadesh ka, ma en dala mantiere but piny ma irito. <verse eid="NUM 20:16"/><verse number="17" style="v" sid="NUM 20:17"/>Yienwa wakal e pinyi. Ok wananyon puodho moro amora kata puoth mzabibu, kata modho pi moa e soko moro amora. Wabiro mana luwo yor ruoth tir kendo ok wanagom yo korachwich kata koracham nyaka wakal pinyi duto.”<verse eid="NUM 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 20:18"/>To Edom nodwoko niya,</para>
  <para style="pm" vid="NUM 20:18">“Ok unyal luwo ka; ka utemo, to wabiro wuok riat kendo wamonju gi ligangla.”<verse eid="NUM 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 20:19"/>Jo-Israel nodwoko niya,</para>
  <para style="pm" vid="NUM 20:19">“Wabiro luwo yo maduongʼ tir, kendo ka wan kata jambwa omodho piu mora amora, to wabiro chulo. Wadwaro mana kalo kanyo ka wawuotho gi tiendwa; maonge gimoro amora machielo mwadwaro timo.”<verse eid="NUM 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 20:20"/>Negidwoko kendo niya,</para>
  <para style="pm" vid="NUM 20:20">“Ok unyal luwo kae.”</para>
  <para style="p" vid="NUM 20:20">Eka Edom nochodo mar kedo kodgi gi jolweny mangʼeny kendo mager. <verse eid="NUM 20:20"/><verse number="21" style="v" sid="NUM 20:21"/>Nikech Edom notamore ni ok gikal e pinye, Israel nowere kodgi.<verse eid="NUM 20:21"/></para>
  <para style="s1">Tho mar Harun</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22"/>Oganda duto mar Israel nowuok Kadesh mi gibiro Got Hor. <verse eid="NUM 20:22"/><verse number="23" style="v" sid="NUM 20:23"/>E Got Hor machiegni gi tongʼ mar Edom, Jehova Nyasaye nowacho ne Musa gi Harun niya, <verse eid="NUM 20:23"/><verse number="24" style="v" sid="NUM 20:24"/>“Harun nochokre gi joge. Ok enodonji e piny mamiyo jo-Israel, nikech un ji ariyogi nungʼanyo ne chikena e pige mag Meriba. <verse eid="NUM 20:24"/><verse number="25" style="v" sid="NUM 20:25"/>Kaw Harun kod wuode Eliazar mondo itergi e Got Hor. <verse eid="NUM 20:25"/><verse number="26" style="v" sid="NUM 20:26"/>Lony lep Harun kendo irwakne wuode ma Eliazar, nimar Harun biro riwore gi jogi; mi otho kanyo.”<verse eid="NUM 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 20:27"/>Musa notimo kaka Jehova Nyasaye nowachone: Negidhi e Got Hor ka oganda duto neno. <verse eid="NUM 20:27"/><verse number="28" style="v" sid="NUM 20:28"/>Musa nogolo lep Harun mi orwako ne wuode ma Eliazar. Kendo Harun notho ewi godno. Eka Musa kod Eliazar nolor oa ewi got, <verse eid="NUM 20:28"/><verse number="29" style="v" sid="NUM 20:29"/>kendo ka oganda duto nowinjo ni Harun osetho, to jo-Israel noywage kuom ndalo piero adek.<verse eid="NUM 20:29"/></para>
  <chapter eid="NUM 20"/>
  <chapter number="21" style="c" sid="NUM 21"/>
  <para style="s1">Piny Arad omuki</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1"/>Kane ruodh Arad ma ja-Kanaan, mane odak Negev, nowinjo ni Israel ne wuotho e yo kochiko Atharim, nomonjo jo-Israel mi omako moko. <verse eid="NUM 21:1"/><verse number="2" style="v" sid="NUM 21:2"/>Eka Israel nosingore ne Jehova Nyasaye kama: “Ka ichiwonwa jogi e lwetwa, to wabiro tieko miechgi madongo duto.” <verse eid="NUM 21:2"/><verse number="3" style="v" sid="NUM 21:3"/>Jehova Nyasaye nochiko ite ne kwayo Israel kendo nochiwo jo-Kanaan ne gin. Negitiekogi duto kod miechgi; omiyo kanyo negichako ni Horma.<note caller="+" style="f"><char style="fr" closed="false">21:3 </char><char style="fq" closed="false">Horma </char><char style="ft" closed="false">tiende ni </char><char style="fqa" closed="false">Kethruok.</char></note><verse eid="NUM 21:3"/></para>
  <para style="s1">Thuol mar mula</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4"/>Negiwuotho ka gia Got Hor ka giluwo yo mochiko Nam Makwar, mondo giluor Edom. To ji chunygi nojok ka gin e yo; <verse eid="NUM 21:4"/><verse number="5" style="v" sid="NUM 21:5"/>omiyo negikwedo Nyasaye kod Musa, mi giwacho niya, “En angʼo momiyo ne igolowa Misri mondo watho e thimni? Waonge chiemo, waonge pi! Ok wadwar chiemo marachni!”<verse eid="NUM 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 21:6"/>Eka Jehova Nyasaye noolo thuonde man-gi kwiri mager kuomgi; negikayo ji kendo jo-Israel mathoth notho. <verse eid="NUM 21:6"/><verse number="7" style="v" sid="NUM 21:7"/>Ji nobiro ir Musa mi giwachone niya, “Ne watimo richo e kinde mane wakwedo Jehova Nyasaye kod in. Lamnwa mondo Jehova Nyasaye ogol thuondegi oa kuomwa.” Omiyo Musa nolamone jogo.<verse eid="NUM 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 21:8"/>Jehova Nyasaye nowacho ne Musa niya, “Los thuond mula kendo ikete ewi luth; ma ngʼato angʼata ma thuol okayo kongʼiye to chango.” <verse eid="NUM 21:8"/><verse number="9" style="v" sid="NUM 21:9"/>Omiyo Musa noloso thuol mar mula mi okete ewi luth. Kane ngʼato thuol okayo mi bangʼe ongʼiyo thuond mulano to nochango.<verse eid="NUM 21:9"/></para>
  <para style="s1">Wuoth madhi Moab</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10"/>Jo-Israel nodhi nyime giwuoth mi gigo kambi kama iluongo ni Oboth. <verse eid="NUM 21:10"/><verse number="11" style="v" sid="NUM 21:11"/>Eka ne giwuok Oboth mi gigo kambi kama iluongo ni Iye Abarim, mantiere e thim mochomo piny Moab kochiko yo wuok chiengʼ. <verse eid="NUM 21:11"/><verse number="12" style="v" sid="NUM 21:12"/>Kane giwuok kanyo negidhi nyime gi wuoth mi gigo kambi Holo mar Zered. <verse eid="NUM 21:12"/><verse number="13" style="v" sid="NUM 21:13"/>Negiwuok kanyo mi gigo kambi e bath aora Arnon, ma en thim molawore nyaka e piny jo-Amor. Arnon en kiewo mar Moab, mantiere e kind Moab kod jo-Amor. <verse eid="NUM 21:13"/><verse number="14" style="v" sid="NUM 21:14"/>Mano emomiyo Kitabu mar Lweny mar Jehova Nyasaye wacho niya,</para>
  <para style="q1" vid="NUM 21:14">“Waheb mantiere Sufa kod holo</para>
  <para style="q2" vid="NUM 21:14">mar aora Arnon, <verse eid="NUM 21:14"/><verse number="15" style="v" sid="NUM 21:15"/>kod kuonde mopie mag holo matut,</para>
  <para style="q1" vid="NUM 21:15">kendo diny mochiko kar tich mar Ar</para>
  <para style="q2" vid="NUM 21:15">kendo manie e kiewo mar Moab.”<verse eid="NUM 21:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="NUM 21:16"/>Koa kanyo negidhi nyime nyaka Beer, ma en soko kama Jehova Nyasaye nonyisoe Musa niya, “Chok ji obed kanyakla kendo abiro miyogi pi.”<verse eid="NUM 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 21:17"/>Eka Israel nower wendni:</para>
  <para style="q1" vid="NUM 21:17">“Yaye soko, bubni oko!</para>
  <para style="q2" vid="NUM 21:17">Werne soko,<verse eid="NUM 21:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 21:18"/>wer kuom soko mane rawera matin okunyo,</para>
  <para style="q2" vid="NUM 21:18">mano mane joka ruoth okunyo;</para>
  <para style="q2" vid="NUM 21:18">joka ruoth molony e chike kendo man-gi odunga.”</para>
  <para style="m" vid="NUM 21:18">Eka negiwuok e thimno ka gidhi Matana, <verse eid="NUM 21:18"/><verse number="19" style="v" sid="NUM 21:19"/>ka gia Matana negidhi Nahaliel, ka gia Nahaliel negidhi Bamoth, <verse eid="NUM 21:19"/><verse number="20" style="v" sid="NUM 21:20"/>kendo kane gia Bamoth negidhi e holo mar Moab kama omanyore gi wi got Pisga minyalo nenogo kama otwo.<verse eid="NUM 21:20"/></para>
  <para style="s1">Olo Sihon kod Og</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21"/>Israel nooro joote mondo owach ne Sihon ma ruodh jo-Amor kama:<verse eid="NUM 21:21"/></para>
  <para style="pm">
    <verse number="22" style="v" sid="NUM 21:22"/>“Yienwauru wakal e pinyu. Ok wanabar tenge e puothu moro amora kata e mago mag mzabibu, kata modho pi moa e soko moro amora. Wabiro wuotho e yor ruoth moriere tir nyaka wakal pinyruodhi.”<verse eid="NUM 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 21:23"/>To Sihon notamo jo-Israel kalo e pinye. Nochoko ogandane mar lweny duto kendo negidhi e thim mondo giked gi Israel. Kane ochopo Jahaz, nokedo gi Israel. <verse eid="NUM 21:23"/><verse number="24" style="v" sid="NUM 21:24"/>Kata kamano jo-Israel nonege gi ligangla kendo gikawo puothe koa aora Arnon nyaka Jabok, ma en tongʼ mar jo-Amon kendo ne giyudo e pinyno ka jogo roteke. <verse eid="NUM 21:24"/><verse number="25" style="v" sid="NUM 21:25"/>Israel nomako mier madongo duto mag jo-Amor kendo negidak kuondego, kaachiel gi Heshbon kod kuonde dak duto molwore. <verse eid="NUM 21:25"/><verse number="26" style="v" sid="NUM 21:26"/>Heshbon ne en dala maduongʼ mar Sihon ruodh jo-Amor mane osekedo gi ruoth machon mar Moab kendo nosemayo lopene duto mochopo nyaka aora Arnon.<verse eid="NUM 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 21:27"/>Mano emomiyo jochuog wer nowero niya,</para>
  <para style="q1" vid="NUM 21:27">“Bi Heshbon mondo mi ogere kendo;</para>
  <para style="q2" vid="NUM 21:27">mad dala maduongʼ mar Sihon ochal kaka chon.<verse eid="NUM 21:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 21:28"/>“Mach nowuok Heshbon,</para>
  <para style="q2" vid="NUM 21:28">en mach makakni moa e dala maduongʼ mar Sihon.</para>
  <para style="q1" vid="NUM 21:28">Nowangʼo Ar man Moab,</para>
  <para style="q2" vid="NUM 21:28">ma gin jokanyo mag kuonde motingʼore malo mag Arnon.<verse eid="NUM 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 21:29"/>Okwongʼi, yaye Moab,</para>
  <para style="q2" vid="NUM 21:29">otieku duto, yaye jo-Kemosh!</para>
  <para style="q1" vid="NUM 21:29">Oseweyo yawuote e lwet nono mobedo jonjore</para>
  <para style="q2" vid="NUM 21:29">kendo nyige obedo joma oter e twech,</para>
  <para style="q2" vid="NUM 21:29">ir Sihon ruodh jo-Amor.<verse eid="NUM 21:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 21:30"/>“To waseloko loch margi;</para>
  <para style="q2" vid="NUM 21:30">Heshbon osetieki duto nyaka ochopo Dibon.</para>
  <para style="q1" vid="NUM 21:30">Wasemukogi nyaka chopi Nofa,</para>
  <para style="q2" vid="NUM 21:30">modhi nyaka Medeba.”<verse eid="NUM 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31"/>Omiyo Israel nodak e piny jo-Amor.<verse eid="NUM 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 21:32"/>Bangʼ ka Musa noseoro jonon piny Jazer, jo-Israel nokawo kuonde dak molwore kendo ne giriembo jo-Amor mane ni kanyo. <verse eid="NUM 21:32"/><verse number="33" style="v" sid="NUM 21:33"/>Eka negigomo ma giluwo yo madhi Bashan, kendo Og ruodh Bashan gi jolweny mage duto nowuok riat mokedo kodgi e lweny Edrei.<verse eid="NUM 21:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 21:34"/>Jehova Nyasaye nowacho ne Musa niya, “Kik iluore, nimar asechiwe e lweti, en kaachiel gi jolweny mage duto kod pinye. Timne kaka ne itimone Sihon ruodh jo-Amor, mane obedo gi loch e piny Heshbon.”<verse eid="NUM 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 21:35"/>Omiyo neginege, en kaachiel gi yawuote kod jolweny mage duto, maonge ngʼama otony mane odongʼ. Kendo negikawo pinye.<verse eid="NUM 21:35"/></para>
  <chapter eid="NUM 21"/>
  <chapter number="22" style="c" sid="NUM 22"/>
  <para style="s1">Balak oluonge Balaam</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1"/>Eka jo-Israel nowuotho e pewe mag Moab mi gibworo e dho Aora Jordan momanyore gi Jeriko.<verse eid="NUM 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 22:2"/>Balak wuod Zipor noneno gigo duto mane jo-Israel osetimo ni jo-Amor, <verse eid="NUM 22:2"/><verse number="3" style="v" sid="NUM 22:3"/>kendo Moab ne nigi bwok maduongʼ nikech jogo ne ngʼeny ahinya. Adiera, Moab luoro nomako ahinya nikech jo-Israel.<verse eid="NUM 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 22:4"/>Jo-Moab nowacho ne jodong Midian niya, “Oganda mangʼenyni biro tieko gimoro amora ma wan-go, mana kaka rwath tieko lum manie pap.”</para>
  <para style="p" vid="NUM 22:4">Omiyo Balak wuod Zipor, mane ruodh Moab e kindeno, <verse eid="NUM 22:4"/><verse number="5" style="v" sid="NUM 22:5"/>nooro joote mondo oluong Balaam wuod Beor, mane ni Pethor but Aora Yufrate, mantiere e piny mane onywole. Balak nowacho kama:</para>
  <para style="pm" vid="NUM 22:5">“Ogandagi oa Misri; gipongʼo wangʼ piny kendo gidak machiegni koda. <verse eid="NUM 22:5"/><verse number="6" style="v" sid="NUM 22:6"/>Koro bi mondo ikwongʼ jogi, nikech tekregi thoth. Dibed ni bangʼ ma anyalo loyogi mi ariembgi gia e pinyni. Nimar angʼeyo ni joma igwedho ogwedhi, kendo joma ikwongʼo okwongʼ.”<verse eid="NUM 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7"/>Jodong Moab kod Midian nowuok, ka gikawo chudo mar koro. Kane gichopo ir Balaam, neginyise gima Balak nowacho.<verse eid="NUM 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 22:8"/>Balaam nowachonegi niya, “Ninduru ka kawuono kendo abiro miyou dwoko ma Jehova Nyasaye omiya.” Omiyo jotend jo-Moab nobedo kode.<verse eid="NUM 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 22:9"/>Nyasaye nofwenyore ne Balaam mopenje niya, “Magi ngʼa gini man kodigi?”<verse eid="NUM 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 22:10"/>To Balaam nonyiso Nyasaye niya, “Balak wuod Zipor, ma ruodh Moab, noorona ote ni: <verse eid="NUM 22:10"/><verse number="11" style="v" sid="NUM 22:11"/>‘Joma oa Misri opongʼo wangʼ piny. Koro bi kendo ikwongʼnagi. Dibed ni bangʼe anyalo kedo kodgi mi ariembgi.’ ”<verse eid="NUM 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 22:12"/>To Nyasaye nowacho ne Balaam niya, “Kik idhi kodgi. Kik ikwongʼ jogo, nikech gin joma ogwedhi.”<verse eid="NUM 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 22:13"/>Kinyne gokinyi Balaam noa malo mi owachone jotend Balak niya, “Doguru e pinyu, nimar Jehova Nyasaye osedagi weya mondo adhi kodu.”<verse eid="NUM 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 22:14"/>Omiyo jotend jo-Moab nodok ir Balak mi owacho niya, “Balaam nodagi biro kodwa.”<verse eid="NUM 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15"/>Eka Balak nooro jotelo mamoko mangʼeny moloyo kendo mongirore moloyo mokwongo ka. <verse eid="NUM 22:15"/><verse number="16" style="v" sid="NUM 22:16"/>Negidok ir Balaam mi giwachone kama:</para>
  <para style="pm" vid="NUM 22:16">“Ma e gima Balak wuod Zipor wacho: Kik iwe gimoro amora tami biro ira, <verse eid="NUM 22:16"/><verse number="17" style="v" sid="NUM 22:17"/>nikech abiro chuli maber kendo timoni gimoro amora miwacho. Bi mondo ikwongʼna ogandani.”<verse eid="NUM 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 22:18"/>To Balaam nodwoko jotij Balak niya, “Kata ne bed ni Balak ne omiya kar dakne mopongʼ gi fedha gi dhahabu, to ok anyal timo gimoro amora maduongʼ kata matin makalo chik mar Jehova Nyasaye ma Nyasacha. <verse eid="NUM 22:18"/><verse number="19" style="v" sid="NUM 22:19"/>Koro ninduru ka otienoni kaka jowadu mamoko ka notimo, mondo abi awinjiane gima nyien ma Jehova Nyasaye biro nyisa kuom wachni.”<verse eid="NUM 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 22:20"/>Nyasaye nofwenyore ne Balaam otienono mowachone niya, “Nikech jogi obiro luongi, yie idhi kodgi, to kata kamano itim mana gima anyisi.”<verse eid="NUM 22:20"/></para>
  <para style="s1">Punda mar Balaam</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 22:21"/>Balaam nochiewo gokinyi, moidho pundane kendo nodhi gi jotelo mag Moab. <verse eid="NUM 22:21"/><verse number="22" style="v" sid="NUM 22:22"/>To mirima nomako Nyasaye ahinya kane odhi, kendo malaika mar Jehova Nyasaye nochungʼ e yo mondo ogengʼne. Balaam noidho pundane, kendo jotijene ariyo bende ne ni kode. <verse eid="NUM 22:22"/><verse number="23" style="v" sid="NUM 22:23"/>Kane pundano oneno malaika mar Jehova Nyasaye kochungʼ e chuny yo kotingʼo ligangla e lwete, nobaro oko mar yo modhi e puodho. Balaam nogoye mondo oduog e wangʼ yo.<verse eid="NUM 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 22:24"/>Eka malaika mar Jehova Nyasaye nodhi mochungʼ kamoro ma yo dinygo e kind puothe ariyo mag mzabibu kama ochiel gohinga koni gi koni. <verse eid="NUM 22:24"/><verse number="25" style="v" sid="NUM 22:25"/>Kane pundano oneno malaika mar Jehova Nyasaye, nosudo machiegni gohingano moreyo tiend Balaam gohingano. Omiyo nogoyo pundano kendo.<verse eid="NUM 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 22:26"/>Eka malaika mar Jehova Nyasaye nosudo nyime mi ochungʼ kama diny maonge thuolo mar lokruok, korachwich kata koracham. <verse eid="NUM 22:26"/><verse number="27" style="v" sid="NUM 22:27"/>Kane pundano oneno malaika mar Jehova Nyasaye, nonindo piny e tiend Balaam, kendo ii Balaam nowangʼ mi ochwade gi luth. <verse eid="NUM 22:27"/><verse number="28" style="v" sid="NUM 22:28"/>Eka Jehova Nyasaye noyawo dho pundano, kendo nowacho ne Balaam niya, “En angʼo masetimoni momiyo isegoya nyadidek?”<verse eid="NUM 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 22:29"/>Balaam nodwoko pundano niya, “Isemiya achalo ngʼama ofuwo! Kane bed ni an-gi ligangla e lweta, to dikoro asenegi.”<verse eid="NUM 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 22:30"/>Pundano nopenjo Balaam niya, “Donge an mana pundani owuon, ma isebedo ka iidho, nyaka kawuononi? Bende iseneno ka an gi kido mar timoni gima chalo kama?”</para>
  <para style="p" vid="NUM 22:30">Nodwoke niya, “Ooyo.”<verse eid="NUM 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31"/>Bangʼe Jehova Nyasaye noyawo wenge Balaam, mi noneno malaika mar Jehova Nyasaye kochungʼ e wangʼ yo korieyo ligangla mare. Omiyo nokulore piny kendo nopodho auma e lowo.<verse eid="NUM 22:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 22:32"/>Malaika mar Jehova Nyasaye nopenje niya, “Angʼo momiyo isechwado pundani nyadidek? Abiro mondo agengʼi nikech yoreni obam e nyima. <verse eid="NUM 22:32"/><verse number="33" style="v" sid="NUM 22:33"/>Punda nonena nyadidek mobaro oa yo. To ka dine ok obaro, to dine asenegi, to en to aweye odhi.”<verse eid="NUM 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 22:34"/>Balaam nowacho ne malaika mar Jehova Nyasaye niya, “Asetimo richo. Ne ok angʼeyo nine ichungʼ e wangʼ yo mondo igengʼna. Koro ka ok imor, to abiro dok dala.”<verse eid="NUM 22:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 22:35"/>Malaika mar Jehova Nyasaye nowacho ne Balaam niya, “Dhiyo adhiya gi jogi, to iwach mana gima awachoni.” Omiyo Balaam nodhi gi jodong Balak.<verse eid="NUM 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 22:36"/>Kane Balak owinjo ni Balaam biro, nowuok mondo oromne e dala jo-Moab mokiewo gi aora Arnon, e giko mar pinye. <verse eid="NUM 22:36"/><verse number="37" style="v" sid="NUM 22:37"/>Balak nowacho ne Balaam niya, “Donge ne aoroni joote mondo ibi ira piyo? Angʼo ma nomoni biro ira? Koso iparo ni ok anyal chuli?”<verse eid="NUM 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 22:38"/>Balaam nodwoko niya, “Mano ber, eri asebiro. Koso iparo ni anyalo wacho gimoro amora? Ooyo, nyaka awach mana gima Nyasaye oketo e dhoga.”<verse eid="NUM 22:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 22:39"/>Eka Balaam nodhi gi Balak nyaka Kiriath Huzoth. <verse eid="NUM 22:39"/><verse number="40" style="v" sid="NUM 22:40"/>Balak nochiwo misango mar dhok kod rombe, kendo nochiwo moko ne Balaam kod jodongo mane ni kode. <verse eid="NUM 22:40"/><verse number="41" style="v" sid="NUM 22:41"/>Kinyne gokinyi Balak nokawo Balaam motero Bamoth Baal, kendo kanyo noneno bath oganda.<verse eid="NUM 22:41"/></para>
  <chapter eid="NUM 22"/>
  <chapter number="23" style="c" sid="NUM 23"/>
  <para style="s1">Ote mokwongo mane Nyasaye omiyo Balaam</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1"/>Balaam nowacho niya, “Gerna kende abiriyo mag misango ka, kendo ikna rwedhi abiriyo kod imbe abiriyo.” <verse eid="NUM 23:1"/><verse number="2" style="v" sid="NUM 23:2"/>Balak notimo kaka Balaam nowacho, kendo negichiwo rwath gi im ewi kendo ka kendo mar misango.<verse eid="NUM 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 23:3"/>Eka Balaam nowacho ne Balak niya, “Bed but misango ka, ka an to alengʼora e bathe ka; nimar sa moro dipo ka Jehova Nyasaye ofwenyorena. Gimoro amora monyisa to abiro nyisi.” Eka nowuok modhi kama otingʼore gi malo motwo.<verse eid="NUM 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 23:4"/>Nyasaye nofwenyore ne Balaam kendo Balaam nowachone niya, “Aseloso kende abiriyo mag misango, kendo ewi kendo ka kendo asechiwe misango mar rwath kod im.”<verse eid="NUM 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 23:5"/>Jehova Nyasaye nomiyo Balaam ote kowachone niya, “Dog ir Balak kendo imiye wachni.”<verse eid="NUM 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 23:6"/>Omiyo nodok moyudo Balak kochungʼ but misango mane osechiwo ka en gi jodong Moab duto. <verse eid="NUM 23:6"/><verse number="7" style="v" sid="NUM 23:7"/>Eka Balaam nohulo ote moa kuom Nyasaye kama:</para>
  <para style="q1" vid="NUM 23:7">“Balak ruodh Moab manie piny gode man yo wuok chiengʼ</para>
  <para style="q2" vid="NUM 23:7">nooma Aram.</para>
  <para style="q1" vid="NUM 23:7">Nowacho ni, ‘Bi mondo ikwongʼna Jakobo;</para>
  <para style="q2" vid="NUM 23:7">bi mondo ikwedna jo-Israel.’<verse eid="NUM 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 23:8"/>Ere kaka anyalo kwongʼo</para>
  <para style="q2" vid="NUM 23:8">joma Nyasaye pok okwongʼo?</para>
  <para style="q1" vid="NUM 23:8">Ere kaka anyalo kwedo</para>
  <para style="q2" vid="NUM 23:8">joma Jehova Nyasaye pok okwedo?<verse eid="NUM 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 23:9"/>Anenogi ka achungʼ ewi kite mabeyo;</para>
  <para style="q2" vid="NUM 23:9">kendo arangogi gi ewi gode.</para>
  <para style="q1" vid="NUM 23:9">Aneno oganda modak kar kendgi ma ok oseriwore</para>
  <para style="q2" vid="NUM 23:9">gi ogendini mamoko.<verse eid="NUM 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 23:10"/>Ere ngʼama nyalo kwano kar romb oganda joka Jakobo machalo gi buru</para>
  <para style="q2" vid="NUM 23:10">kata ngʼama nyalo kwano migawo mar angʼwen mar Israel?</para>
  <para style="q1" vid="NUM 23:10">Weuru atho kaka joma kare tho,</para>
  <para style="q2" vid="NUM 23:10">kendo mad giko mara ochal kod margi!”<verse eid="NUM 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11"/>Balak nopenjo Balaam niya, “En angʼo ma isetimona? Ne aomi mondo ikwongʼ wasika, to onge gima isetimo makmana gwedhogi!”<verse eid="NUM 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 23:12"/>Nodwoke niya, “Ok anyal wacho gima Jehova Nyasaye ne ok onyisa?”<verse eid="NUM 23:12"/></para>
  <para style="s1">Ote mar ariyo mane Nyasaye omiyo Balaam</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13"/>Eka Balak nowachone niya, “Bi wadhi kamoro machielo kama inyalo nenogie; ibiro mana neno moko kuomgi to ok giduto. To ka isenenogi, to ikwongʼnagi.” <verse eid="NUM 23:13"/><verse number="14" style="v" sid="NUM 23:14"/>Omiyo notere e pap mar Zofim mantiere ewi Got Pisga, kendo kanyo nogero kende mag misango abiriyo mi nochiwo misango mar rwath kod im ewi kendo ka kendo.<verse eid="NUM 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 23:15"/>Balaam nowacho ne Balak niya, “Bed but misangoni ka, ka anto adhi romo gi Nyasaye bathe kocha.”<verse eid="NUM 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 23:16"/>Jehova Nyasaye nofwenyore ne Balaam kendo nomiyo Balaam ote kowachone niya, “Dog ir Balak kendo imiye wachni.”<verse eid="NUM 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 23:17"/>Omiyo nodok moyudo Balak kochungʼ but misangone, ka en-gi jodong Moab. Balak nopenje niya, “Angʼo mane Jehova Nyasaye owacho?”<verse eid="NUM 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 23:18"/>Eka Balaam nohulo ote moa kuom Nyasaye kama:</para>
  <para style="q1" vid="NUM 23:18">Aa malo, Balak, kendo ichik iti;</para>
  <para style="q2" vid="NUM 23:18">winja, wuod Zipor.<verse eid="NUM 23:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 23:19"/>Nyasaye ok en dhano, mondo omi oriambi,</para>
  <para style="q2" vid="NUM 23:19">kata ok en wuod dhano, mondo omi olok pache.</para>
  <para style="q1" vid="NUM 23:19">Bende onyalo wuoyo to ok otim kaka owacho?</para>
  <para style="q2" vid="NUM 23:19">Bende onyalo chiwo singo, to ok ochop singruokno?<verse eid="NUM 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 23:20"/>Ne ayudo chik mondo achiw gweth;</para>
  <para style="q2" vid="NUM 23:20">osegwedhogi, kendo ok anyal loko mano.<verse eid="NUM 23:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 23:21"/>“Onge kido magalagala moyud kuom Jakobo,</para>
  <para style="q2" vid="NUM 23:21">kata tim moro marach moyud kuom Israel.</para>
  <para style="q1" vid="NUM 23:21">Jehova Nyasaye ma Nyasachgi ni kodgi;</para>
  <para style="q2" vid="NUM 23:21">teko mar Ruoth ni kodgi.<verse eid="NUM 23:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 23:22"/>Nyasaye nogologi Misri;</para>
  <para style="q2" vid="NUM 23:22">tekogi chalo gi teko jowi.<verse eid="NUM 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 23:23"/>Onge tim jwok manyalo mako joka Jakobo,</para>
  <para style="q2" vid="NUM 23:23">kendo timbe ndagla ok nyal mako Israel.</para>
  <para style="q1" vid="NUM 23:23">Ibiro goyo ngero kuom joka Jakobo</para>
  <para style="q2" vid="NUM 23:23">ma Israel ni, ‘Ne gima Nyasaye osetimo!’<verse eid="NUM 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 23:24"/>Ogandani ger mana ka sibuor madhako;</para>
  <para style="q2" vid="NUM 23:24">kendo gijuol ka sibuor madichwo,</para>
  <para style="q1" vid="NUM 23:24">ma ok nyal nindo piny nyaka ocham gima onego</para>
  <para style="q2" vid="NUM 23:24">momadh rembe.”<verse eid="NUM 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25"/>Eka Balak nowacho ne Balaam niya, “Kare koro kik ikwongʼ-gi kata kik igwedhgi!”<verse eid="NUM 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 23:26"/>Balaam nodwoke niya, “Donge ne anyisi ni nyaka atim mana gima Jehova Nyasaye onyisa?”<verse eid="NUM 23:26"/></para>
  <para style="s1">Ote mar adek mane Nyasaye omiyo Balaam</para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 23:27"/>Eka Balak nowacho ne Balaam niya, “Bi wadhi kamachielo. Dibed ni biro bedo maber ne Nyasaye mondo ikwongʼnagi kanyo.” <verse eid="NUM 23:27"/><verse number="28" style="v" sid="NUM 23:28"/>Kendo Balak nokawo Balaam nyaka ewi Peor, momanyore gi kama otwo.<verse eid="NUM 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 23:29"/>Balaam nowacho niya, “Gerna kende abiriyo mag misango kae, kendo ikna rwedhi abiriyo kod imbe abiriyo.” <verse eid="NUM 23:29"/><verse number="30" style="v" sid="NUM 23:30"/>Balak notimo kaka Balaam nonyise kendo nochiwo misango mar rwath kod im ewi kendo ka kendo mar misango.<verse eid="NUM 23:30"/></para>
  <chapter eid="NUM 23"/>
  <chapter number="24" style="c" sid="NUM 24"/>
  <para style="p">
    <verse number="1" style="v" sid="NUM 24:1"/>Omiyo kane Balaam oneno ni berne Jehova Nyasaye mondo ogwedh Israel, ne ok otimo tim jwok kaka ne osetimo e kinde mokalo, to nolokore kongʼiyo yo thim. <verse eid="NUM 24:1"/><verse number="2" style="v" sid="NUM 24:2"/>Kane Balaam ongʼiyo oko mi oneno jo-Israel kochokore e dhoot ka dhoot, Roho mar Nyasaye nobiro kuome <verse eid="NUM 24:2"/><verse number="3" style="v" sid="NUM 24:3"/>mi nochiwo ote mare kama:</para>
  <para style="q1" vid="NUM 24:3">“Ote Balaam wuod Beor,</para>
  <para style="q2" vid="NUM 24:3">ote mar ngʼat ma wengene neno maber,<verse eid="NUM 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NUM 24:4"/>ote mar ngʼat mawinjo weche Nyasaye,</para>
  <para style="q2" vid="NUM 24:4">ngʼat maneno fweny moa kuom Nyasaye Maratego,</para>
  <para style="q2" vid="NUM 24:4">ngʼat mopodho piny auma, kendo ma wengene oyawore.<verse eid="NUM 24:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 24:5"/>“Mano kaka hembe magi ber neno, yaye Jakobo,</para>
  <para style="q2" vid="NUM 24:5">kuondeni mag dak, yaye Israel!<verse eid="NUM 24:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 24:6"/>“Gilandore ka holni,</para>
  <para style="q2" vid="NUM 24:6">mana ka puothe mantiere e bath aora,</para>
  <para style="q1" vid="NUM 24:6">mana ka mane-mane ma Jehova Nyasaye opidho,</para>
  <para style="q2" vid="NUM 24:6">bende mana ka yiend sida mopidh but pi.<verse eid="NUM 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 24:7"/>Pi ma aa e dapigeni biro pongʼ mao oko;</para>
  <para style="q2" vid="NUM 24:7">kendo kothgi nochal gi pi mabubni.</para>
  <para style="b" vid="NUM 24:7"/>
  <para style="q1" vid="NUM 24:7">“Ruodhgi nobed gi teko moloyo Agag;</para>
  <para style="q2" vid="NUM 24:7">pinyruodhgi notingʼ malo.<verse eid="NUM 24:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 24:8"/>“Nyasaye nogologi Misri;</para>
  <para style="q2" vid="NUM 24:8">kendo gin gi teko machalo mar jowi.</para>
  <para style="q1" vid="NUM 24:8">Gikidho oganda jowasikgi</para>
  <para style="q2" vid="NUM 24:8">kendo gituro chokegi matindo tindo;</para>
  <para style="q2" vid="NUM 24:8">kendo gichwowogi gi aserni mag-gi.<verse eid="NUM 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 24:9"/>Gilidho ka ginindo piny mana ka sibuor madichwo,</para>
  <para style="q2" vid="NUM 24:9">bende mana ka sibuor madhako maonge ngʼama nyalo chiewo?</para>
  <para style="b" vid="NUM 24:9"/>
  <para style="q1" vid="NUM 24:9">“Mad joma ogwedhi gwedhi</para>
  <para style="q2" vid="NUM 24:9">to joma kwongʼi mondo okwongʼ!”<verse eid="NUM 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10"/>Eka Balak nobedo gi mirima mager gi Balaam. Noriwo lwetene kanyakla mi owachone niya, “Ne aomi mondo ikwongʼna wasika, to isemana gwedhogi ndalo adekgi. <verse eid="NUM 24:10"/><verse number="11" style="v" sid="NUM 24:11"/>Koro aa sani sani mondo idhi dala! Ne awachoni ni abiro miyi chudo maber, to Jehova Nyasaye osetami yudo chudono.”<verse eid="NUM 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 24:12"/>Balaam nodwoko Balak niya, “Donge ne anyiso joote mane ioro ira niya, <verse eid="NUM 24:12"/><verse number="13" style="v" sid="NUM 24:13"/>‘Kata bed ni Balak ne miya ode mar ruoth mopongʼ gi fedha gi dhahabu, to ne ok anyal timo gimoro amora gi pacha awuon mopogore gi chik Jehova Nyasaye bed ni ber kata rach?’ <verse eid="NUM 24:13"/><verse number="14" style="v" sid="NUM 24:14"/>Koro adok ir jowa, to kapok adhi to we anyisi gima jo-Israel biro timo, asiemi kuom gik ma jogi biro timo ne jogi e ndalo mabiro.”<verse eid="NUM 24:14"/></para>
  <para style="s1">Ote mar angʼwen mane Nyasaye omiyo Balaam</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 24:15"/>Eka Balaam nohulo ote moa kuom Nyasaye kama:</para>
  <para style="q1" vid="NUM 24:15">“Ote mar Balaam wuod Beor,</para>
  <para style="q2" vid="NUM 24:15">ote mar ngʼat man-gi wangʼ maneno ler,<verse eid="NUM 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 24:16"/>ote mar ngʼat mawinjo weche Nyasaye,</para>
  <para style="q2" vid="NUM 24:16">ngʼat man-gi rieko moa kuom Nyasaye Man Malo Moloyo,</para>
  <para style="q1" vid="NUM 24:16">ngʼat maneno fweny moa kuom Nyasaye Maratego,</para>
  <para style="q2" vid="NUM 24:16">ngʼat moriere piny auma, kendo ma wengene oyawore.<verse eid="NUM 24:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 24:17"/>“Anene, to ok sani;</para>
  <para style="q2" vid="NUM 24:17">asudo machiegni, to ok bute.</para>
  <para style="q1" vid="NUM 24:17">Sulwe biro wuok koa kuom Jakobo;</para>
  <para style="q2" vid="NUM 24:17">ludh loch biro wuok ei Israel.</para>
  <para style="q1" vid="NUM 24:17">Obiro toyo wiye jo-Moab,</para>
  <para style="q2" vid="NUM 24:17">kod wiye yawuot Sheth<note caller="+" style="f"><char style="fr" closed="false">24:17 </char><char style="fq" closed="false">Sheth </char><char style="ft" closed="false">tiende ni joma sungore.</char></note> duto.<verse eid="NUM 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 24:18"/>Obiro loyo piny jo-Edom e lweny mi okaw;</para>
  <para style="q2" vid="NUM 24:18">kendo Seir ma wasike, nokaw,</para>
  <para style="q2" vid="NUM 24:18">to Israel nomed bedo motegno.<verse eid="NUM 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 24:19"/>Jatelo noa e oganda joka Jakobo,</para>
  <para style="q2" vid="NUM 24:19">kendo enotiek joma otony mag dala maduongʼ.”<verse eid="NUM 24:19"/></para>
  <para style="s1">Ote mogik mane Nyasaye omiyo Balaam</para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 24:20"/>Eka Balaam noneno Amalek kendo nowachone ote mar Nyasaye kama:</para>
  <para style="q1" vid="NUM 24:20">“Amalek ema ne okwongo kuom ogendini,</para>
  <para style="q2" vid="NUM 24:20">to gikone ibiro tieke.”<verse eid="NUM 24:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 24:21"/>Eka noneno jo-Keni kendo ochiwo oteneni:</para>
  <para style="q1" vid="NUM 24:21">“Kar dak mari nigi kwe,</para>
  <para style="q2" vid="NUM 24:21">kari mar pondo ni e bwo lwanda;<verse eid="NUM 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 24:22"/>kata kamano un jo-Keni ibiro negu ndalo</para>
  <para style="q2" vid="NUM 24:22">ma Ashur oterou e twech.”<verse eid="NUM 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 24:23"/>Eka nochiwo otene niya,</para>
  <para style="q1" vid="NUM 24:23">“Yaye, en ngʼa manyalo bedo mangima ka Nyasaye otimo ma?<verse eid="NUM 24:23"/></para>
  <para style="q2">
    <verse number="24" style="v" sid="NUM 24:24"/>Yiedhi madongo mathoth nobi koa e dho nam mar Kitim;</para>
  <para style="q1" vid="NUM 24:24">gibiro mako Ashur kod Eber,</para>
  <para style="q2" vid="NUM 24:24">to kata gin bende ibiro tiekgi.”<verse eid="NUM 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 24:25"/>Eka Balaam noa malo mi odok dala kendo Balak bende nodhi e yore owuon.<verse eid="NUM 24:25"/></para>
  <chapter eid="NUM 24"/>
  <chapter number="25" style="c" sid="NUM 25"/>
  <para style="s1">Moab olombo Israel</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1"/>Kane oyudo jo-Israel odak Shitim, chwo nochako terore gi monde jo-Moab, <verse eid="NUM 25:1"/><verse number="2" style="v" sid="NUM 25:2"/>mane ogwelogi e chiwo misengini ne nyisechegi. Ji nochiemo moyiengʼ kendo negipodho auma ka gilamo nyisechegi. <verse eid="NUM 25:2"/><verse number="3" style="v" sid="NUM 25:3"/>Omiyo Israel noriwore kodgi e yor lamo Baal mar Peor. Kendo mirima nomako Jehova Nyasaye ahinya kodgi.<verse eid="NUM 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 25:4"/>Jehova Nyasaye nowacho ne Musa niya, “Kaw jotend jogi duto, neg-gi kendo dhurgi e lela e nyim Jehova Nyasaye, mondo omi mirimb Jehova Nyasaye owuog kuom Israel.”<verse eid="NUM 25:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 25:5"/>Omiyo Musa nowacho ne jongʼad bura mag Israel niya, “Ngʼato ka ngʼato kuomu nyaka neg jou machwo ma oseriwore e lamo Baal mar Peor.”<verse eid="NUM 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6"/>Eka ja-Israel moro nobiro gi nyar jo-Midian e hembe ka Musa neno kaachiel gi oganda jo-Israel duto mane oyudo ywak e dho Hemb Romo. <verse eid="NUM 25:6"/><verse number="7" style="v" sid="NUM 25:7"/>Kane Finehas wuod Eliazar, ma wuod Harun jadolo, noneno ma, nowuok e chokruokno, mokawo tongʼ e lwete, <verse eid="NUM 25:7"/><verse number="8" style="v" sid="NUM 25:8"/>kendo noluwo bangʼ ja-Israelno nyaka e hema. Nochwowogi duto moriwogi gi tongʼ. Eka tho mane osenego jo-Israel norumo; <verse eid="NUM 25:8"/><verse number="9" style="v" sid="NUM 25:9"/>to ji mane tho ma kamano onego ne gin ji alufu piero ariyo gangʼwen (24,000).<verse eid="NUM 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 25:10"/><verse number="11" style="v" sid="NUM 25:11"/>“Finehas wuod Eliazar, ma wuod Harun jadolo, osetieko mirimba kuom jo-Israel; nimar en gi nyiego machal gi mara; mano emomiyo ne ok atiekogi kata obedo nine an kod mirima kodgi kamano. <verse eid="NUM 25:11"/><verse number="12" style="v" sid="NUM 25:12"/>Emomiyo nyise ni aloso singruok mar kwe kode. <verse eid="NUM 25:12"/><verse number="13" style="v" sid="NUM 25:13"/>Asingorane ni en kod nyikwaye ginibed jodolo maga nyaka chiengʼ, nikech ne en jasinani kuom miyo Nyasache duongʼ kendo negichiwo misango mar pwodho jo-Israel e richo.”<verse eid="NUM 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14"/>Nying ja-Israel mane onegi gi nyar jo-Midian ne en Zimri wuod Salu, mane en jatend dhood Simeon. <verse eid="NUM 25:14"/><verse number="15" style="v" sid="NUM 25:15"/>To nying nyar jo-Midian mane onegi ne en Kozbi ma nyar Zur, ma wuon-gi ne en jatend dhood jo-Midian.<verse eid="NUM 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 25:16"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 25:16"/><verse number="17" style="v" sid="NUM 25:17"/>“Sanduru jo-Midian kendo uneg-gi, <verse eid="NUM 25:17"/><verse number="18" style="v" sid="NUM 25:18"/>nikech ne githagou gi timbegi maricho mane gitimo Peor kendo kuom wach Kozbi ma nyar jatend Midian mane onegi ndalo mane yamb tho obiro nikech gima notimore Peor.”<verse eid="NUM 25:18"/></para>
  <chapter eid="NUM 25"/>
  <chapter number="26" style="c" sid="NUM 26"/>
  <para style="s1">Kweno mar ariyo</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1"/>Bangʼ masirano Jehova Nyasaye nowacho ne Musa kod Eliazar wuod Harun jadolo niya, <verse eid="NUM 26:1"/><verse number="2" style="v" sid="NUM 26:2"/>“Kwan ogendini mag jo-Israel duto kaluwore gi anywolagi, mago mahikgi piero ariyo kadhi nyime manyalo bedo jolweny e Israel.” <verse eid="NUM 26:2"/><verse number="3" style="v" sid="NUM 26:3"/>Musa kod Eliazar jadolo nowuoyo kod jo-Israel e pewe mag Moab mantiere e loka Jordan kod Jeriko mowachonegi niya, <verse eid="NUM 26:3"/><verse number="4" style="v" sid="NUM 26:4"/>“Kwanuru jogo mahikgi romo piero ariyo kadhi nyime, mana kaka Jehova Nyasaye nochiko Musa.”</para>
  <para style="b" vid="NUM 26:4"/>
  <para style="li4" vid="NUM 26:4">Jo-Israel mane owuok Misri e magi:<verse eid="NUM 26:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 26:5"/>Nyikwa Reuben, ma en wuod Israel makayo, ne gin:</para>
  <para style="li2" vid="NUM 26:5">kokadho kuom Hanok, ne gin joka Hanok;</para>
  <para style="li2" vid="NUM 26:5">kokadho kuom Palu, ne gin joka Palu;<verse eid="NUM 26:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="NUM 26:6"/>kokadho kuom Hezron, ne gin joka Hezron;</para>
  <para style="li2" vid="NUM 26:6">kokadho kuom Karmi, ne gin joka Karmi.<verse eid="NUM 26:6"/></para>
  <para style="li4">
    <verse number="7" style="v" sid="NUM 26:7"/>Magi ema ne joka Reuben; ma kar kwan-gi ne romo ji alufu piero angʼwen mia abiriyo gi piero adek (43,730).<verse eid="NUM 26:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="NUM 26:8"/>Wuod Palu ne en Eliab, <verse eid="NUM 26:8"/><verse number="9" style="v" sid="NUM 26:9"/>to yawuot Eliab ne gin Nemuel, Dathan kod Abiram. Dathan-no kod Abiram ne jotend oganda, to kata kamano negikwedo Musa kod Harun kendo gijiwo joma ne luwo Kora kuom kwedo Jehova Nyasaye. <verse eid="NUM 26:9"/><verse number="10" style="v" sid="NUM 26:10"/>Piny nongʼamo dhoge mi omwonyogi kaachiel gi Kora, ma joma ne luwo bangʼe ji mia ariyo gi piero abich notho e mach. Jogi nobedo kaka ranyisi mar siemo ji. <verse eid="NUM 26:10"/><verse number="11" style="v" sid="NUM 26:11"/>To kata kamano, joka Kora ne ok orumo.<verse eid="NUM 26:11"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 26:12"/>Nyikwa Simeon kaluwore gi anywola margi ne gin:</para>
  <para style="li2" vid="NUM 26:12">koa kuom Nemuel, joka Nemuel;</para>
  <para style="li2" vid="NUM 26:12">koa kuom Jamin, joka Jamin;</para>
  <para style="li2" vid="NUM 26:12">koa kuom Jakin, joka Jakin;<verse eid="NUM 26:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="NUM 26:13"/>koa kuom Zera, joka Zera;</para>
  <para style="li2" vid="NUM 26:13">koa kuom Shaul, joka Shaul.<verse eid="NUM 26:13"/></para>
  <para style="li4">
    <verse number="14" style="v" sid="NUM 26:14"/>Magi ema ne joka Simeon; ma kar kwan-gi ne romo ji alufu piero ariyo gariyo mia ariyo (22,200).<verse eid="NUM 26:14"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 26:15"/>Nyikwa Gad kaluwore gi anywola margi ne gin:</para>
  <para style="li2" vid="NUM 26:15">koa kuom Zefon, joka Zefon;</para>
  <para style="li2" vid="NUM 26:15">koa kuom Hagai, joka Hagi;</para>
  <para style="li2" vid="NUM 26:15">koa kuom Shuni, joka Shuni;<verse eid="NUM 26:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="NUM 26:16"/>koa kuom Ozni, joka Ozni;</para>
  <para style="li2" vid="NUM 26:16">koa kuom Eri, joka Eri;<verse eid="NUM 26:16"/></para>
  <para style="li2">
    <verse number="17" style="v" sid="NUM 26:17"/>koa kuom Arodi, joka Arodi;</para>
  <para style="li2" vid="NUM 26:17">koa kuom Areli, joka Areli.<verse eid="NUM 26:17"/></para>
  <para style="li4">
    <verse number="18" style="v" sid="NUM 26:18"/>Magi ema ne joka Gad; ma kar kwan-gi ne romo ji alufu piero angʼwen mia abich (40,500).<verse eid="NUM 26:18"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="19" style="v" sid="NUM 26:19"/>Yawuot Juda ma Er kod Onan notho Kanaan.<verse eid="NUM 26:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 26:20"/>Nyikwa Juda kaluwore gi anywola margi ne gin:</para>
  <para style="li2" vid="NUM 26:20">koa kuom Shela, joka Shela;</para>
  <para style="li2" vid="NUM 26:20">koa kuom Perez, joka Perez;</para>
  <para style="li2" vid="NUM 26:20">koa kuom Zera, joka Zera.<verse eid="NUM 26:20"/></para>
  <para style="li2">
    <verse number="21" style="v" sid="NUM 26:21"/>Nyikwa Perez ne gin:</para>
  <para style="li3" vid="NUM 26:21">koa kuom Hezron, joka Hezron;</para>
  <para style="li3" vid="NUM 26:21">koa kuom Hamul, kod joka Hamul.<verse eid="NUM 26:21"/></para>
  <para style="li4">
    <verse number="22" style="v" sid="NUM 26:22"/>Magi ema ne joka Juda; ma kar kwan-gi ne romo ji alufu piero abiriyo gauchiel gi mia abich (76,500).<verse eid="NUM 26:22"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 26:23"/>Nyikwa Isakar kaluwore gi anywola margi ne gin:</para>
  <para style="li2" vid="NUM 26:23">koa kuom Tola, joka Tola;</para>
  <para style="li2" vid="NUM 26:23">koa kuom Pua, joka Pua;<verse eid="NUM 26:23"/></para>
  <para style="li2">
    <verse number="24" style="v" sid="NUM 26:24"/>koa kuom Jashub, joka Jashub;</para>
  <para style="li2" vid="NUM 26:24">koa kuom Shimron, joka Shimron.<verse eid="NUM 26:24"/></para>
  <para style="li4">
    <verse number="25" style="v" sid="NUM 26:25"/>Magi ema ne joka Isakar, ma kar kwan-gi ne romo ji alufu piero auchiel angʼwen gi mia adek (64,300).<verse eid="NUM 26:25"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 26:26"/>Nyikwa Zebulun kaluwore gi anywola margi ne gin:</para>
  <para style="li2" vid="NUM 26:26">koa kuom Sered, joka Sered;</para>
  <para style="li2" vid="NUM 26:26">koa kuom Elon, joka Elon;</para>
  <para style="li2" vid="NUM 26:26">koa kuom Jalel, joka Jalel.<verse eid="NUM 26:26"/></para>
  <para style="li4">
    <verse number="27" style="v" sid="NUM 26:27"/>Magi ema ne joka Zebulun, ma kar kwan-gi ne romo ji alufu piero auchiel gi mia abich (60,500).<verse eid="NUM 26:27"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="28" style="v" sid="NUM 26:28"/>Nyikwa Josef kaluwore gi anywola margi kokalo kuom Manase kod Efraim ne gin:<verse eid="NUM 26:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 26:29"/>Nyikwa Manase ne gin:</para>
  <para style="li2" vid="NUM 26:29">koa kuom Makir, joka Makir (Makir ne en wuod Gilead);</para>
  <para style="li2" vid="NUM 26:29">koa kuom Gilead, joka Gilead.<verse eid="NUM 26:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="NUM 26:30"/>Nyikwa Gilead e magi:</para>
  <para style="li3" vid="NUM 26:30">koa kuom Iezer, joka Iezer;</para>
  <para style="li3" vid="NUM 26:30">koa kuom Helek, joka Helek;<verse eid="NUM 26:30"/></para>
  <para style="li3">
    <verse number="31" style="v" sid="NUM 26:31"/>koa kuom Asriel, joka Asriel;</para>
  <para style="li3" vid="NUM 26:31">koa kuom Shekem, joka Shekem;<verse eid="NUM 26:31"/></para>
  <para style="li3">
    <verse number="32" style="v" sid="NUM 26:32"/>koa kuom Shemida, joka Shemida;</para>
  <para style="li3" vid="NUM 26:32">koa kuom Hefer, joka Hefer.<verse eid="NUM 26:32"/></para>
  <para style="li3">
    <verse number="33" style="v" sid="NUM 26:33"/>(Kata kamano Zelofehad wuod Hefer ne onge yawuowi; to ne en mana gi nyiri kende, ma nyingegi ne gin Mala, Nowa, Hogla, Milka gi Tirza.)<verse eid="NUM 26:33"/></para>
  <para style="li4">
    <verse number="34" style="v" sid="NUM 26:34"/>Magi ema ne joka Manase; ma kar kwan-gi ne romo ji alufu piero abich gariyo mia abiriyo (52,700).<verse eid="NUM 26:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="NUM 26:35"/>Nyikwa Efraim kaluwore gi anywola margi e magi:</para>
  <para style="li2" vid="NUM 26:35">koa kuom Shuthela, joka Shuthela;</para>
  <para style="li2" vid="NUM 26:35">koa kuom Beker, joka Beker;</para>
  <para style="li2" vid="NUM 26:35">koa kuom Tahan, joka Tahan.<verse eid="NUM 26:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="NUM 26:36"/>Magi ema ne nyikwa Shuthela:</para>
  <para style="li3" vid="NUM 26:36">kokadho kuom Eran, ne gin joka Eran.<verse eid="NUM 26:36"/></para>
  <para style="li4">
    <verse number="37" style="v" sid="NUM 26:37"/>Magi ema ne joka Efraim; ma kar kwan-gi ne romo ji alufu piero adek mia abich.</para>
  <para style="li4" vid="NUM 26:37">Magi duto ne gin nyikwa Josef kaluwore gi anywola mag-gi.<verse eid="NUM 26:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 26:38"/>Nyikwa Benjamin kaluwore gi anywola margi ne gin:</para>
  <para style="li2" vid="NUM 26:38">koa kuom Bela, joka Bela;</para>
  <para style="li2" vid="NUM 26:38">koa kuom Ashbel, joka Ashbel;</para>
  <para style="li2" vid="NUM 26:38">koa kuom Ahiram, joka Ahiram;<verse eid="NUM 26:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 26:39"/>koa kuom Shufam, joka Shufam;</para>
  <para style="li2" vid="NUM 26:39">koa kuom Hufam, joka Hufam.<verse eid="NUM 26:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="NUM 26:40"/>Nyikwa Bela kokalo kuom Ard gi Naaman ne gin:</para>
  <para style="li3" vid="NUM 26:40">koa kuo Ard, joka Ard;</para>
  <para style="li3" vid="NUM 26:40">koa kuom Naaman, joka Naaman.<verse eid="NUM 26:40"/></para>
  <para style="li4">
    <verse number="41" style="v" sid="NUM 26:41"/>Magi ema ne joka Benjamin; ma kar kwan-gi ne romo ji alufu piero angʼwen gabich mia auchiel (45,600).<verse eid="NUM 26:41"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="42" style="v" sid="NUM 26:42"/>Nyikwa Dan kaluwore gi anywolagi ne gin:</para>
  <para style="li2" vid="NUM 26:42">koa kuom Shulam, joka Shuham.</para>
  <para style="li4" vid="NUM 26:42">Magi ema ne anywola mag Dan: <verse eid="NUM 26:42"/><verse number="43" style="v" sid="NUM 26:43"/>Anywola jo-Shuham duto kar kwan-gi ne romo ji alufu piero auchiel gangʼwen mia angʼwen (64,400).<verse eid="NUM 26:43"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="44" style="v" sid="NUM 26:44"/>Nyikwa Asher kaluwore gi anywola margi ne gin:</para>
  <para style="li2" vid="NUM 26:44">koa kuom Imna, joka Imna;</para>
  <para style="li2" vid="NUM 26:44">koa kuom Ishvi, joka Ishvi;</para>
  <para style="li2" vid="NUM 26:44">koa kuom Beria, joka Beria;<verse eid="NUM 26:44"/></para>
  <para style="li2">
    <verse number="45" style="v" sid="NUM 26:45"/>kendo koa kuom nyikwa Beria ne gin:</para>
  <para style="li3" vid="NUM 26:45">joka Heber;</para>
  <para style="li3" vid="NUM 26:45">kod joka Malkiel.<verse eid="NUM 26:45"/></para>
  <para style="li4">
    <verse number="46" style="v" sid="NUM 26:46"/>To Asher ne nigi nyako ma nyinge Sera.<verse eid="NUM 26:46"/></para>
  <para style="li4">
    <verse number="47" style="v" sid="NUM 26:47"/>Magi ema ne joka Asher; ma kar kwan-gi ne romo ji alufu piero abich gadek mia angʼwen (53,400).<verse eid="NUM 26:47"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="48" style="v" sid="NUM 26:48"/>Nyikwa Naftali kaluwore gi anywola margi ne gin:</para>
  <para style="li2" vid="NUM 26:48">koa kuom Jazel, joka Jazel;</para>
  <para style="li2" vid="NUM 26:48">koa kuom Guni, joka Guni;<verse eid="NUM 26:48"/></para>
  <para style="li2">
    <verse number="49" style="v" sid="NUM 26:49"/>koa kuom Jezer, joka Jezer;</para>
  <para style="li2" vid="NUM 26:49">koa kuom Shilem, joka Shilem.<verse eid="NUM 26:49"/></para>
  <para style="li4">
    <verse number="50" style="v" sid="NUM 26:50"/>Magi ema ne joka Naftali; ma kar kwan-gi ne romo ji alufu piero angʼwen gabich mia angʼwen (45,400).<verse eid="NUM 26:50"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="51" style="v" sid="NUM 26:51"/>Kar kwan jo-Israel duto ne romo ji alufu mia auchiel gachiel, mia abiriyo gi piero adek (601,730).<verse eid="NUM 26:51"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 26:52"/><verse number="53" style="v" sid="NUM 26:53"/>“Nyaka pog jo-Israel pinyni kaka girkeni kaluwore gi kar kwan-gi. <verse eid="NUM 26:53"/><verse number="54" style="v" sid="NUM 26:54"/>Dhoot maduongʼ imi lowo maduongʼ to dhoot matin to imi lowo matin; dhoot ka dhoot mondo oyud pok maromre gi kar kwan-gi. <verse eid="NUM 26:54"/><verse number="55" style="v" sid="NUM 26:55"/>Nyaka ine ni lopegi opog gi ombulu. Pok mar oganda ka oganda biro bedo kaluwore gi nying kweregi. <verse eid="NUM 26:55"/><verse number="56" style="v" sid="NUM 26:56"/>Pok moro ka moro nyaka pog gi ombulu e kind dhoudi madongo gi matindo.”<verse eid="NUM 26:56"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="57" style="v" sid="NUM 26:57"/>Jo-Lawi mane okwan kaluwore gi anywola ne gin:</para>
  <para style="li2" vid="NUM 26:57">koa kuom Gershon, joka Gershon;</para>
  <para style="li2" vid="NUM 26:57">koa kuom Kohath, joka Kohath;</para>
  <para style="li2" vid="NUM 26:57">koa kuom Merari, joka Merari.<verse eid="NUM 26:57"/></para>
  <para style="li1">
    <verse number="58" style="v" sid="NUM 26:58"/>Jo-Lawi mamoko mane okwan ne gin:</para>
  <para style="li2" vid="NUM 26:58">joka Libni,</para>
  <para style="li2" vid="NUM 26:58">joka Hebron,</para>
  <para style="li2" vid="NUM 26:58">joka Mali,</para>
  <para style="li2" vid="NUM 26:58">joka Mushi,</para>
  <para style="li2" vid="NUM 26:58">joka Kora.</para>
  <para style="li2" vid="NUM 26:58">(Kohath ne kwar Amram; <verse eid="NUM 26:58"/><verse number="59" style="v" sid="NUM 26:59"/>kendo jaod Amram ne nyinge Jokebed, ma nyakwar Lawi, mane onywol ne jo-Lawi e Piny Misri. Amram nonywolo Harun, Musa kod nyamin-gi Miriam. <verse eid="NUM 26:59"/><verse number="60" style="v" sid="NUM 26:60"/>Harun ne en wuon Nadab gi Abihu, Eliazar kod Ithamar. <verse eid="NUM 26:60"/><verse number="61" style="v" sid="NUM 26:61"/>To kata kamano Nadab gi Abihu notho kane gichiwo misango e nyim Jehova Nyasaye gi mach ma ok oyiego.)<verse eid="NUM 26:61"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="62" style="v" sid="NUM 26:62"/>Kar kwan jo-Lawi machwo ma ja-dwe achiel kadhi nyime kwan-gi ne romo ji alufu piero ariyo gadek (23,000). Ne ok okwan-gi gi jo-Israel mamoko nikech ne ok opog-gi lowo.<verse eid="NUM 26:62"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63"/>Magi e joma ne okwan gi Musa kod Eliazar jadolo e kinde mane okwan jo-Israel e paw Moab mantiere e loka Jordan koa Jeriko. <verse eid="NUM 26:63"/><verse number="64" style="v" sid="NUM 26:64"/>Onge moro amora kuomgi mane okwan gi Musa kod Harun jadolo e kinde mane gikwano jo-Israel e Thim mar Sinai. <verse eid="NUM 26:64"/><verse number="65" style="v" sid="NUM 26:65"/>Nimar Jehova Nyasaye ne owachone jo-Israelgo ni nyaka githo e thim, kendo onge kata ngʼata achiel kuomgi mane otony makmana Kaleb wuod Jefune kod Joshua wuod Nun.<verse eid="NUM 26:65"/></para>
  <chapter eid="NUM 26"/>
  <chapter number="27" style="c" sid="NUM 27"/>
  <para style="s1">Nyi Zelofehad</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1"/>Nyi Zelofehad wuod Hefer, ma wuod Gilead, ma wuod Makir, ma wuod Manase, ne gin joka Manase wuod Josef. Nyirigo ne gin Mala, Nowa, Hogla, Milka kod Tirza. Negisudo machiegni gi <verse eid="NUM 27:1"/><verse number="2" style="v" sid="NUM 27:2"/>kar donjo mar Hemb Romo mi gichungʼ e nyim Musa, Eliazar jadolo, jotelo kod chokruok mar oganda duto, mi giwacho niya, <verse eid="NUM 27:2"/><verse number="3" style="v" sid="NUM 27:3"/>“Wuonwa notho e thim. Ne ok en achiel kuom jolup Kora, mane okwedo Jehova Nyasaye, to notho nikech richone owuon kendo ne ok onywolo yawuowi. <verse eid="NUM 27:3"/><verse number="4" style="v" sid="NUM 27:4"/>Angʼo ma dimi nying wuonwa lal nono e anywolagi nikech ne ok onywolo wuowi? Yie upognwa kamoro e kind wede wuonwa.”<verse eid="NUM 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 27:5"/>Omiyo Musa nokelo wachgini e nyim Jehova Nyasaye <verse eid="NUM 27:5"/><verse number="6" style="v" sid="NUM 27:6"/>kendo Jehova Nyasaye nowachone niya, <verse eid="NUM 27:6"/><verse number="7" style="v" sid="NUM 27:7"/>“Gima nyi Zelofehad owacho nikare. Nyaka ipog-gi gimoro kaka girkeni ei wede wuon-gi kendo girkeni mag wuon-gi imigi.<verse eid="NUM 27:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 27:8"/>“Wachne jo-Israel ni, ‘Ka dichwo otho ma ok onywolo wuowi, to ipog nyathine ma nyako girkeni mare. <verse eid="NUM 27:8"/><verse number="9" style="v" sid="NUM 27:9"/>To ka oonge gi nyako, to ipog owetene girkeni mare. <verse eid="NUM 27:9"/><verse number="10" style="v" sid="NUM 27:10"/>To ka oonge gi owete, to ipog owete gi wuonene girkeni mare. <verse eid="NUM 27:10"/><verse number="11" style="v" sid="NUM 27:11"/>To ka wuon-gi onge gi owetene, to ipog watne moro amora machiegni kode e anywolagi, mondo oyud girkenino. Mae nobed chik ne jo-Israel, mana kaka Jehova Nyasaye nosechiko Musa.’ ”<verse eid="NUM 27:11"/></para>
  <para style="s1">Oyier Joshua mondo okaw kar Musa</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12"/>Eka Jehova Nyasaye nowacho ne Musa niya, “Dhi malo e Got Abarim kendo ingʼi piny ma asemiyo jo-Israel. <verse eid="NUM 27:12"/><verse number="13" style="v" sid="NUM 27:13"/>Bangʼ ka isenene, to in bende ibiro tho miluw kwereni, mana kaka owadu Harun notho, <verse eid="NUM 27:13"/><verse number="14" style="v" sid="NUM 27:14"/>nimar e kinde mane oganda ongʼanyo e sokni mantiere e Thim mar Zin, un duto ne ok urito chikna kendo nyiso oganda ni an Ngʼama Ler.” (Magi ne sokni mag Meriba Kadesh, mantiere e Thim mar Zin.)<verse eid="NUM 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 27:15"/>Musa nowacho ne Jehova Nyasaye ni, <verse eid="NUM 27:15"/><verse number="16" style="v" sid="NUM 27:16"/>“Mad Jehova Nyasaye, ma Nyasach chunje duto mag dhano, oyier jatelo manyalo rito ogandani <verse eid="NUM 27:16"/><verse number="17" style="v" sid="NUM 27:17"/>mondo otelnegi e gik moko duto ma gitimo kendo oritgi kagiwuok kendo ka gidwogo dala mondo oganda Jehova Nyasaye kik chal gi rombe maonge jokwath.”<verse eid="NUM 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 27:18"/>Omiyo Jehova Nyasaye nowacho ne Musa niya, “Kaw Joshua wuod Nun, ngʼat man-gi Roho, kendo yie lweti kuome. <verse eid="NUM 27:18"/><verse number="19" style="v" sid="NUM 27:19"/>Kete ochungʼ e nyim Eliazar jadolo kod chokruok duto mar oganda kendo ipwodhe e nyimgi. <verse eid="NUM 27:19"/><verse number="20" style="v" sid="NUM 27:20"/>Miye tekoni moko mondo mi oganda jo-Israel duto omiye luor. <verse eid="NUM 27:20"/><verse number="21" style="v" sid="NUM 27:21"/>Nyaka ochungʼ e nyim jadolo Eliazar, mabiro ngʼadone rieko kopenjo Urim e nyim Jehova Nyasaye. Kogolo chik, to en kod oganda jo-Israel duto nowuog oko, kendo kogolo chik to gibiro donjo iye.”<verse eid="NUM 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 27:22"/>Musa notimo kaka Jehova Nyasaye nochike. Nokawo Joshua mi otero e nyim Eliazar jadolo gi chokruok duto. <verse eid="NUM 27:22"/><verse number="23" style="v" sid="NUM 27:23"/>Eka noyieyo lwete kuome mi opwodhe, mana kaka Jehova Nyasaye nochiko Musa.<verse eid="NUM 27:23"/></para>
  <chapter eid="NUM 27"/>
  <chapter number="28" style="c" sid="NUM 28"/>
  <para style="s1">Misengini michiwo pile ka pile</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 28:1"/><verse number="2" style="v" sid="NUM 28:2"/>“Mi jo-Israel chikni kiwachonegi kama: ‘Kelnauru chiwo mitimonago misengini miwangʼo pep mondo obed chiemba madum tik mangʼwe ngʼar e kinde mowinjore.’ <verse eid="NUM 28:2"/><verse number="3" style="v" sid="NUM 28:3"/>Wachnegi niya, ‘Misengini miwangʼo ne Jehova Nyasaye e magi: nyirombe ariyo ma jo-higa achiel maonge songa, kaka chiwo mapile mowangʼ odiechiengʼ kodiechiengʼ. <verse eid="NUM 28:3"/><verse number="4" style="v" sid="NUM 28:4"/>Chiw nyarombo achiel gokinyi to machielo godhiambo, <verse eid="NUM 28:4"/><verse number="5" style="v" sid="NUM 28:5"/>kaachiel gi chiwo mar cham moromo gorogoro achiel gi nus mar mogo mayom moruw gi mo mobi e olemb zeituni moromo lita achiel. <verse eid="NUM 28:5"/><verse number="6" style="v" sid="NUM 28:6"/>Ma e chiwo mapile mowangʼ mopwodhi e Got Sinai kaka gima dungʼ tik mangʼwe ngʼar mamoro Jehova Nyasaye, en misango miwangʼo pep mochiwne Jehova Nyasaye. <verse eid="NUM 28:6"/><verse number="7" style="v" sid="NUM 28:7"/>Nyarombo ka nyarombo nokel gi misango miolo piny maromo divai lita achiel. Nyaka uol divaino ei kama ler mar lemo ne Jehova Nyasaye. <verse eid="NUM 28:7"/><verse number="8" style="v" sid="NUM 28:8"/>Chiw nyarombo mar ariyo godhiambo, kaachiel gi chiwo mar cham machalo kamano kod misango miolo piny ma iloso gokinyi. Ma en chiwo miwangʼo pep, misango madungʼ tik mangʼwe ngʼar mamoro Jehova Nyasaye.<verse eid="NUM 28:8"/></para>
  <para style="s1">Misengini mag Sabato</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9"/>“ ‘Chiengʼ Sabato, chiwuru misango mar nyiimbe ariyo maonge songa mahikgi achiel, kaachiel gi misango miolo piny kod chiwo mar cham maromo kilo abiriyo mar mogo mayom moru gi mo. <verse eid="NUM 28:9"/><verse number="10" style="v" sid="NUM 28:10"/>Ma en misango miwangʼo pep Sabato ka Sabato, komedi ewi chiwo mapile mar misango miwangʼo pep kod misango miolo piny.<verse eid="NUM 28:10"/></para>
  <para style="s1">Misengini mag dwe ka dwe</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11"/>“ ‘Odiechiengʼ mokwongo mar dwe ka dwe, chiwne Jehova Nyasaye misango miwangʼo pep mar nyirwedhi ariyo, im achiel kod nyiimbe abiriyo moromo higa achiel, duto maonge songa. <verse eid="NUM 28:11"/><verse number="12" style="v" sid="NUM 28:12"/>Rwath ka rwath nyaka chiw gi chiwo mar cham maromo kilo apar mar mogo mayom moru gi mo; im to chiw gi chiwo mar cham maromo kilo abiriyo mar mogo mayom moru gi mo; <verse eid="NUM 28:12"/><verse number="13" style="v" sid="NUM 28:13"/>to nyaim ka nyaim, to chiw gi cham maromo kilo adek mar mogo mayom moru gi mo. Ma en misango miwangʼo pep, gima dungʼ tik mangʼwe ngʼar mamoro Jehova Nyasaye. <verse eid="NUM 28:13"/><verse number="14" style="v" sid="NUM 28:14"/>Rwath ka rwath nyaka chiw gi misango miolo piny mar divai maromo lita angʼwen; im to chiw gi lita achiel mar divai; to nyaim ka nyaim, to chiw gi lita achiel mar divai. Ma en misango miwangʼo pep mar dwe ka dwe ma onego chiw e higa mangima sa moro amora ma dwe manyien opor. <verse eid="NUM 28:14"/><verse number="15" style="v" sid="NUM 28:15"/>Nywok achiel chiwne Jehova Nyasaye kaka misango mar pwodhruok kimedo gi misango miwangʼo pep mapile pile kod misango miolo piny michiwego.<verse eid="NUM 28:15"/></para>
  <para style="s1">Pasaka</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16"/>“ ‘Nyaka utim Pasaka mar Jehova Nyasaye e odiechiengʼ mar apar gangʼwen mar dwe mokwongo. <verse eid="NUM 28:16"/><verse number="17" style="v" sid="NUM 28:17"/>E odiechiengʼ mar apar gabich mar dweno nyaka ulos sawo; kuom ndalo abiriyo chamuru makati motedi ma ok oketie thowi. <verse eid="NUM 28:17"/><verse number="18" style="v" sid="NUM 28:18"/>Chiengʼ mokwongo mar jumano nyaka ubed gi chokruok mowal kendo kik uti tich moro amora mutiyo pile. <verse eid="NUM 28:18"/><verse number="19" style="v" sid="NUM 28:19"/>Chiwuru ne Jehova Nyasaye misango miwangʼo pep, misango mowangʼ mar nyirwedhi ariyo, im achiel kod nyiimbe abiriyo mahikgi achiel kendo maonge songa. <verse eid="NUM 28:19"/><verse number="20" style="v" sid="NUM 28:20"/>Rwath ka rwath nyaka chiw gi chiwo mar cham mar mogo mayom maromo kilo adek gi nus moru gi mo; im to ichiw gi mogo mayom maromo kilo ariyo moru gi mo; <verse eid="NUM 28:20"/><verse number="21" style="v" sid="NUM 28:21"/>to nyiimbe abiriyogo, to ichiw gi mogo mayom maromo kilo achiel moru gi mo. <verse eid="NUM 28:21"/><verse number="22" style="v" sid="NUM 28:22"/>Umed nyanywok achiel mar chiwo mar pwodhruok e richo. <verse eid="NUM 28:22"/><verse number="23" style="v" sid="NUM 28:23"/>Chiwuru magi kumedo ewi misango miwangʼo pep mapile pile gokinyi. <verse eid="NUM 28:23"/><verse number="24" style="v" sid="NUM 28:24"/>Kamano bende kelnauru chiwo mitimogo misengini miwangʼo pile pile kuom ndalo abiriyo mondo chiemba odungʼ tik mangʼwe ngʼar ni Jehova Nyasaye; kendo nyaka ulose kumedo gi misango miwangʼo pep mapile pile kod misango miolo piny. <verse eid="NUM 28:24"/><verse number="25" style="v" sid="NUM 28:25"/>E odiechiengʼ mar abiriyo losuru chokruok mowal kendo kik uti tich moro amora mutiyo pile.<verse eid="NUM 28:25"/></para>
  <para style="s1">Nyasi mag jumbe</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26"/>“ ‘E odiechiengʼ mokwongo mar keyo mokwongo, kinde ma uchiwoe misango mar cham manyien ne Jehova Nyasaye e Sawo mar Jumbe, losuru chokruok maler kendo kik uti tijeu mapile. <verse eid="NUM 28:26"/><verse number="27" style="v" sid="NUM 28:27"/>Chiwuru misango miwangʼo pep mag nyirwedhi ariyo, im achiel gi nyirombe abiriyo mahikgi en achiel kaka gima dungʼ tik mangʼwe ngʼar mamoro Jehova Nyasaye. <verse eid="NUM 28:27"/><verse number="28" style="v" sid="NUM 28:28"/>Rwath ka rwath nyaka chiw gi chiwo mar cham maromo kilo apar mar mogo mayom moru gi mo; im to uchiw gi kilo abiriyo; <verse eid="NUM 28:28"/><verse number="29" style="v" sid="NUM 28:29"/>to imbe abiriyogo moro ka moro to chiw gi kilo adek. <verse eid="NUM 28:29"/><verse number="30" style="v" sid="NUM 28:30"/>Ewi mago meduru nywok achiel kaka chiwo mar pwodhruok e richo. <verse eid="NUM 28:30"/><verse number="31" style="v" sid="NUM 28:31"/>Chiwuru magi kaachiel gi misango miolo piny, kumedo gi misango miwangʼo pep mapile pile kod chiwo mar cham. Neuru ni jamnigo onge songa.<verse eid="NUM 28:31"/></para>
  <chapter eid="NUM 28"/>
  <chapter number="29" style="c" sid="NUM 29"/>
  <para style="s1">Nyasi mag turumbete</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1"/>“ ‘E odiechiengʼ mokwongo mar dwe mar abiriyo losuru chokruok mowal kendo kik uti tijeu mapile. En odiechiengʼ mugoyoe turumbete. <verse eid="NUM 29:1"/><verse number="2" style="v" sid="NUM 29:2"/>Chiwuru misango miwangʼo pep mar nyarwath achiel, im achiel kod nyiimbe abiriyo moromo higa achiel, ma duto onge songa mondo obed kaka misango madungʼ tik mangʼwe ngʼar mamoro Jehova Nyasaye. <verse eid="NUM 29:2"/><verse number="3" style="v" sid="NUM 29:3"/>Rwath ka rwath nyaka chiw gi chiwo mar cham maromo kilo apar mar mogo mayom moru gi mo; im to chiw gi kilo abiriyo; <verse eid="NUM 29:3"/><verse number="4" style="v" sid="NUM 29:4"/>nyiimbe abiriyogo moro ka moro uchiw gi kilo adek. <verse eid="NUM 29:4"/><verse number="5" style="v" sid="NUM 29:5"/>Ewi mago meduru nywok achiel kaka chiwo mar pwodhruok e richo. <verse eid="NUM 29:5"/><verse number="6" style="v" sid="NUM 29:6"/>Magi imedo ewi misango miwangʼo pep mar dwe ka dwe kod mago michiwo pile ka pile kaachiel gi chiwo mar cham kod misango miolo piny mana kaka owinjore. Gin chiwo miwangʼo pep ne Jehova Nyasaye, madungʼ tik mangʼwe ngʼar mamoro Jehova Nyasaye.<verse eid="NUM 29:6"/></para>
  <para style="s1">Odiechiengʼ mar pwodhruok</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7"/>“ ‘E odiechiengʼ mar apar mar dwe mar abiriyo beduru gi chokruok mowal. Nyaka utwe chiemo kulamo kendo kik uti tich moro amora. <verse eid="NUM 29:7"/><verse number="8" style="v" sid="NUM 29:8"/>Kelneuru Jehova Nyasaye chiwo madungʼ tik mangʼwe ngʼar mar misango miwangʼo pep mar nyarwath, im achiel kod nyiimbe abiriyo ma jo-higa achiel, mago maonge songa. <verse eid="NUM 29:8"/><verse number="9" style="v" sid="NUM 29:9"/>Rwath ka rwath nyaka chiw gi chiwo mar cham maromo kilo apar mar mogo mayom moruw gi mo; im to uchiw gi kilo abiriyo; <verse eid="NUM 29:9"/><verse number="10" style="v" sid="NUM 29:10"/>to nyiimbe abiriyo-ka, to uchiw gi kilo adek. <verse eid="NUM 29:10"/><verse number="11" style="v" sid="NUM 29:11"/>Ewi mago meduru nywok achiel kaka chiwo mar pwodhruok e richo, kumedo gi chiwo mar pwodhruok e richo kod misango miwangʼo pep mapile pile mikelo gi chiwo mar cham, kod misango miolo piny.<verse eid="NUM 29:11"/></para>
  <para style="s1">Nyasi mag hekalu</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12"/>“ ‘E odiechiengʼ mar apar gabich e dwe mar abiriyo, losuru chokruok mowal kendo kik uti tijeu mapile. Losneuru Jehova Nyasaye sawo kuom ndalo abiriyo. <verse eid="NUM 29:12"/><verse number="13" style="v" sid="NUM 29:13"/>Kelnauru Jehova Nyasaye chiwo madungʼ tik mangʼwe ngʼar mar misango miwangʼo pep mar rwedhi apar gadek, imbe ariyo kod nyiimbe apar gangʼwen mahikgi achiel, maonge songa. <verse eid="NUM 29:13"/><verse number="14" style="v" sid="NUM 29:14"/>Kuom rwedhi apar gadekgo kelnauru chiwo mar cham maromo kilo apar mar mogo mayom moru gi mo; kuom imbe ariyogo, chiwuru kilo abiriyo ne moro ka moro; <verse eid="NUM 29:14"/><verse number="15" style="v" sid="NUM 29:15"/>to kuom nyiimbe apar gangʼwen-ka, to uchiw kilo adek. <verse eid="NUM 29:15"/><verse number="16" style="v" sid="NUM 29:16"/>Ewi mago meduru nywok achiel kaka misango mar pwodhruok e richo, kumedo ewi misango miwangʼo pep mapile kod chiwo mar cham gi misango miolo piny.<verse eid="NUM 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17"/>“ ‘E odiechiengʼ mar ariyo chiwuru nyirwedhi apar gariyo, imbe ariyo kod nyiimbe apar gangʼwen mahikgi achiel, ma duto onge songa. <verse eid="NUM 29:17"/><verse number="18" style="v" sid="NUM 29:18"/>Chiwo mag cham kod misango miolo piny nyaka keti kaka chik dwaro maromre gi rwedhigo, imbego kod nyiimbego. <verse eid="NUM 29:18"/><verse number="19" style="v" sid="NUM 29:19"/>Ewi mago meduru nywok achiel kaka chiwo mar pwodhruok e richo, kumedo ewi misango miwangʼo pep mapile kod chiwo mar cham, kaachiel gi misango miolo piny.<verse eid="NUM 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 29:20"/>“ ‘E odiechiengʼ mar adek chiwuru rwedhi apar gachiel, imbe ariyo kod nyiimbe apar gangʼwen ma jo-higa achiel, ma duto onge songa. <verse eid="NUM 29:20"/><verse number="21" style="v" sid="NUM 29:21"/>Chiwo mag cham kod misango miolo piny nyaka keti kaka chik dwaro maromre gi rwedhigo, imbego kod nyiimbego. <verse eid="NUM 29:21"/><verse number="22" style="v" sid="NUM 29:22"/>Ewi mago meduru nywok achiel kaka chiwo mar pwodhruok e richo, kumedo ewi misango miwangʼo pep mapile kaachiel gi misango miolo piny.<verse eid="NUM 29:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23"/>“ ‘E odiechiengʼ mar angʼwen chiwuru rwedhi apar, imbe ariyo kod nyiimbe apar gangʼwen ma jo-higa achiel, ma duto onge songa. <verse eid="NUM 29:23"/><verse number="24" style="v" sid="NUM 29:24"/>Chiwo mag cham kod misango miolo piny nyaka keti kaka chik dwaro maromre gi rwedhigo, imbego kod nyiimbego. <verse eid="NUM 29:24"/><verse number="25" style="v" sid="NUM 29:25"/>Ewi mago meduru nywok achiel kaka chiwo mar pwodhruok e richo, kumedo ewi misango miwangʼo pep mapile kaachiel gi chiwo mar cham kaachiel gi misango miolo piny.<verse eid="NUM 29:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26"/>“ ‘E odiechiengʼ mar abich chiwuru rwedhi ochiko, imbe ariyo kod nyiimbe apar gangʼwen ma jo-higa achiel, ma duto onge songa. <verse eid="NUM 29:26"/><verse number="27" style="v" sid="NUM 29:27"/>Chiwo mag cham kod misango miolo piny nyaka keti kaka chik dwaro maromre gi rwedhigo, imbego kod nyiimbego. <verse eid="NUM 29:27"/><verse number="28" style="v" sid="NUM 29:28"/>Ewi mago meduru nywok achiel kaka chiwo mar pwodhruok e richo, kumedo ewi misango miwangʼo pep mapile kaachiel gi chiwo mar cham kaachiel gi misango miolo piny.<verse eid="NUM 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29"/>“ ‘E odiechiengʼ mar auchiel chiwuru rwedhi aboro, imbe ariyo kod nyiimbe apar gangʼwen ma jo-higa achiel, ma duto onge songa. <verse eid="NUM 29:29"/><verse number="30" style="v" sid="NUM 29:30"/>Chiwo mag cham kod misango miolo piny nyaka keti kaka chik dwaro maromre gi rwedhigo, imbego kod nyiimbego. <verse eid="NUM 29:30"/><verse number="31" style="v" sid="NUM 29:31"/>Ewi mago meduru nywok achiel kaka chiwo mar pwodhruok e richo, kumedo ewi misango miwangʼo pep mapile kaachiel gi chiwo mar cham kaachiel gi misango miolo piny.<verse eid="NUM 29:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32"/>“ ‘E odiechiengʼ mar abiriyo chiw rwedhi abiriyo, imbe ariyo kod nyiimbe apar gangʼwen ma jo-higa achiel, ma duto onge songa. <verse eid="NUM 29:32"/><verse number="33" style="v" sid="NUM 29:33"/>Chiwo mag cham kod misango miolo piny nyaka keti kaka chik dwaro maromre gi rwedhigo, imbego kod nyiimbego. <verse eid="NUM 29:33"/><verse number="34" style="v" sid="NUM 29:34"/>Ewi mago meduru nywok achiel kaka chiwo mar pwodhruok e richo, kumedo ewi misango miwangʼo pep mapile kaachiel gi chiwo mar cham kaachiel gi misango miolo piny.<verse eid="NUM 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35"/>“ ‘E odiechiengʼ mar aboro chok oganda kanyakla kendo kik uti tije mapile. <verse eid="NUM 29:35"/><verse number="36" style="v" sid="NUM 29:36"/>Kelneuru Jehova Nyasaye chiwo madungʼ tik mangʼwe ngʼar mar misango miwangʼo pep mar rwath achiel, im achiel kod nyiimbe abiriyo ma jo-higa achiel, ma duto onge songa. <verse eid="NUM 29:36"/><verse number="37" style="v" sid="NUM 29:37"/>Chiwo mag cham kod misango miolo piny nyaka keti kaka chik dwaro maromre gi rwadhno, imno kod nyiimbego. <verse eid="NUM 29:37"/><verse number="38" style="v" sid="NUM 29:38"/>Ewi mago meduru nywok achiel kaka chiwo mar pwodhruok e richo, kumedo ewi misango miwangʼo pep mapile mar cham kaachiel gi misango miolo piny.<verse eid="NUM 29:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39"/>“ ‘Kuom chiwo mar kwongʼruok kod chiwo mar hera, losneuru Jehova Nyasaye sewni moyier kaka: misango miwangʼo pep, chiwo mag cham, misango miolo piny kod chiwo mag lalruok.’ ”<verse eid="NUM 29:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 29:40"/>Musa nonyiso jo-Israel gigo duto mane Jehova Nyasaye ochike.<verse eid="NUM 29:40"/></para>
  <chapter eid="NUM 29"/>
  <chapter number="30" style="c" sid="NUM 30"/>
  <para style="s1">Chike mag kwongʼruok</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1"/>Musa nowacho ne jotend dhout Israel niya, “Jehova Nyasaye ochiko kama: <verse eid="NUM 30:1"/><verse number="2" style="v" sid="NUM 30:2"/>Ka ngʼato osingore ne Jehova Nyasaye kata kokwongʼore mar timo gimoro to kik olokre, to nyaka one ni ochopo singruokneno.<verse eid="NUM 30:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 30:3"/>“Ka nyako ma rawera ma pod odak e od wuon mare osingore ne Jehova Nyasaye kata okwongʼore mar timo gimoro <verse eid="NUM 30:3"/><verse number="4" style="v" sid="NUM 30:4"/>mi wuon mare owinjo singruokneno to ok owacho gimoro, to kwongʼruokneno nyaka siki. <verse eid="NUM 30:4"/><verse number="5" style="v" sid="NUM 30:5"/>To ka wuon mare okwero e kinde mosingoreno, to onge kwongʼruok kata singruok mare ma osingorego manitimre; Jehova Nyasaye noweye thuolo nikech wuon mare osedagi.<verse eid="NUM 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 30:6"/>“Ka onywome bangʼ ka osekwongʼore kata orikni ochiwo singruok motweye <verse eid="NUM 30:6"/><verse number="7" style="v" sid="NUM 30:7"/>mi chwore owinje to olingʼ alingʼa, to kwongʼruokneno nobed kamano. <verse eid="NUM 30:7"/><verse number="8" style="v" sid="NUM 30:8"/>To ka chwore owinjo wachni mokwere, to oketho kwongʼruok motweye kata singruok mane orikni chiwo, kendo Jehova Nyasaye kete thuolo.<verse eid="NUM 30:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 30:9"/>“Kwongʼruok kata singruok moro amora ma dhako ma chwore otho kata dhako ma mowere gi chwore otimo nosiki.<verse eid="NUM 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 30:10"/>“Ka dhako modak gi chwore okwongʼore kata otwere gi kwongʼruok <verse eid="NUM 30:10"/><verse number="11" style="v" sid="NUM 30:11"/>mi chwore owinjo wachni to ok owachone gimoro kendo ok okwere, to kwongʼruokno nyaka siki. <verse eid="NUM 30:11"/><verse number="12" style="v" sid="NUM 30:12"/>To ka chwore odagi kwongʼruokneno, to onge gimoro amora mane chiege owacho manyalo make. Chwore osekethogi, kendo Jehova Nyasaye nokete thuolo. <verse eid="NUM 30:12"/><verse number="13" style="v" sid="NUM 30:13"/>Chwor dhako nyalo guro kata ketho singruok kata kwongʼruok ma chiege dwaro sandorego. <verse eid="NUM 30:13"/><verse number="14" style="v" sid="NUM 30:14"/>To ka chwore ok owacho gimoro kuom wachno odiechiengʼ ka odiechiengʼ, to nochop kwongʼruok mage kod singruok mage duto motwerego. Kwongʼruokgo nosiki nikech kane owinjogi to nolingʼ. <verse eid="NUM 30:14"/><verse number="15" style="v" sid="NUM 30:15"/>To ka dipo ni olokore bangʼe modagi kosewinjogi, to ketho mar chiege nobed e wiye owuon.”<verse eid="NUM 30:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 30:16"/>Magi e chike mane Jehova Nyasaye omiyo Musa kaluwore gidak manie kind dichwo gi dhako, kendo e kind wuoro gi nyare ma pod tin modak e odgi.<verse eid="NUM 30:16"/></para>
  <chapter eid="NUM 30"/>
  <chapter number="31" style="c" sid="NUM 31"/>
  <para style="s1">Lweny gi jo-Midian</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 31:1"/><verse number="2" style="v" sid="NUM 31:2"/>“In kaachiel gi jo-Israel dhi uked gi jo-Midian, eka bangʼe ibiro tho miluw bangʼ kwereni.”<verse eid="NUM 31:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 31:3"/>Omiyo Musa nowacho ne jo-Israel niya, “Yieruru jou moko mondo odhi oked gi jo-Midian kendo gitiek mirimb Jehova Nyasaye kuomgi. <verse eid="NUM 31:3"/><verse number="4" style="v" sid="NUM 31:4"/>Goluru ji alufu achiel achiel (1,000) moa e dhoot ka dhoot mar Israel.” <verse eid="NUM 31:4"/><verse number="5" style="v" sid="NUM 31:5"/>Omiyo ji alufu apar gariyo (12,000) noikore ne lweny, kowuok e dhout Israel duto ka gigolo ji alufu achiel achiel (1,000). <verse eid="NUM 31:5"/><verse number="6" style="v" sid="NUM 31:6"/>Musa noorogi e lweny ji alufu achiel (1,000) e dhoot ka dhoot, ka gin gi Finehas wuod Eliazar, ma jadolo, mane otingʼo gik moa ei kama ler mar lemo kod turumbete michiwogo ranyisi.<verse eid="NUM 31:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 31:7"/>Negikedo gi Midian, mana kaka Jehova Nyasaye nochiko Musa, kendo neginego chwo duto. <verse eid="NUM 31:7"/><verse number="8" style="v" sid="NUM 31:8"/>Moko kuom joma nonegi ne gin Evi, Rekem, Zur, Hur kod Reba mane gin ruodhi abich mag Midian. Bende neginego Balaam wuod Beor gi ligangla. <verse eid="NUM 31:8"/><verse number="9" style="v" sid="NUM 31:9"/>Jo-Israel nomako mond jo-Midian kod nyithindo kendo ne giyako kweth mag jamni, dhok, kod gik moko duto mag jo-Midian. <verse eid="NUM 31:9"/><verse number="10" style="v" sid="NUM 31:10"/>Ne giwangʼo miech jo-Midian mane gidakie, kaachiel gi kuondegi mag bworo. <verse eid="NUM 31:10"/><verse number="11" style="v" sid="NUM 31:11"/>Negikawo gik moko duto ma oyaki kod mane ope, kaachiel gi ji kod jamni, <verse eid="NUM 31:11"/><verse number="12" style="v" sid="NUM 31:12"/>kendo negikelo joma ne omaki, gik mane ope kod mane oyaki ne Musa gi Eliazar ma jadolo kod oganda jo-Israel e kargi mar bworo mantiere e pewe Moab, man but Jordan loka mar Jeriko.<verse eid="NUM 31:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13"/>Musa gi Eliazar jadolo kod jotend oganda duto nodhi mondo orom kodgi e oko mar kambi. <verse eid="NUM 31:13"/><verse number="14" style="v" sid="NUM 31:14"/>Musa nokecho gi jotend lweny duto; mago mane otelo ne migawo mar lweny mar alufe alufe kod mag miche miche mane odwogo koa e lweny.<verse eid="NUM 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 31:15"/>Nopenjogi niya, “Angʼo momiyo useyiene mon mondo obed mangima?” <verse eid="NUM 31:15"/><verse number="16" style="v" sid="NUM 31:16"/>Gin e joma noluwo puonj Balaam kendo gin ema negimiyo oganda mar jo-Israel oweyo Jehova Nyasaye kuom gima notimore Peor, mane omiyo masira onego jo-Jehova Nyasaye. <verse eid="NUM 31:16"/><verse number="17" style="v" sid="NUM 31:17"/>Omiyo neguru yawuowi duto. Kendo uneg dhako moro amora moseriwore gi dichwo, <verse eid="NUM 31:17"/><verse number="18" style="v" sid="NUM 31:18"/>to uwe nyiri duto mapok ongʼeyo chwo.<verse eid="NUM 31:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 31:19"/>“Un duto ma usenego ngʼato angʼata kata mulo ngʼato angʼata motho nyaka ubed oko mar kambi kuom ndalo abiriyo. To e odiechiengʼ mar adek kod mar abiriyo nyaka upwodhru uwegi kendo upwodh jogo mumako. <verse eid="NUM 31:19"/><verse number="20" style="v" sid="NUM 31:20"/>Pwodhuru lewni duto kaachiel gi gimoro amora molos gi pien, molos gi yie diel kata mago molos gi bao.”<verse eid="NUM 31:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21"/>Eka Eliazar jadolo nowacho ne jolweny mane odhi e lweny niya, “Chik mane Jehova Nyasaye omiyo Musa ema: <verse eid="NUM 31:21"/><verse number="22" style="v" sid="NUM 31:22"/>Gik machalo gi dhahabu, fedha, mula, nyinyo, chuma <verse eid="NUM 31:22"/><verse number="23" style="v" sid="NUM 31:23"/>kod gimoro amora ma mach ok nyal wangʼo noleny e mach, eka enopwodhgi mi gibed maler. To bende nyaka luokgi gi pi mondo gibed maler. Omiyo gimoro amora ma mach ok nyal lenyo nyaka luok gi pigno. <verse eid="NUM 31:23"/><verse number="24" style="v" sid="NUM 31:24"/>Kochopo odiechiengʼ mar abiriyo to ulwok lepu kendo ubiro bedo maler. Bangʼe unyalo biro e kambi.”<verse eid="NUM 31:24"/></para>
  <para style="s1">Pogo gigo moyaki kod mope</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 31:25"/><verse number="26" style="v" sid="NUM 31:26"/>“In gi Eliazar jadolo kod jotend anywola mag oganda nyaka kwan ji duto kod jamni mane ope. <verse eid="NUM 31:26"/><verse number="27" style="v" sid="NUM 31:27"/>Nyaka upogi gik mane ope maromre ne joma nodhi e lweny kod joma nodongʼ. <verse eid="NUM 31:27"/><verse number="28" style="v" sid="NUM 31:28"/>Kuom mago mopogne jolweny mano kedo, goluru ni Jehova Nyasaye achiel kuom mia abich bed ni gin ji, dhok, punde, rombe kata diek. <verse eid="NUM 31:28"/><verse number="29" style="v" sid="NUM 31:29"/>Kawuru nus mar pokni kendo umi Eliazar jadolo kaka chiwo ne Jehova Nyasaye. <verse eid="NUM 31:29"/><verse number="30" style="v" sid="NUM 31:30"/>Kuom nus mar pok jo-Israel kawuru achiel kuom piero abich, bed ni gin ji, dhok, punde, rombe, diek kata jamni mamoko. Chiwgi ne jo-Lawi ma tijgi en rito hekalu mar Jehova Nyasaye.” <verse eid="NUM 31:30"/><verse number="31" style="v" sid="NUM 31:31"/>Omiyo Musa kod Eliazar jadolo notimo kaka Jehova Nyasaye nochiko Musa.<verse eid="NUM 31:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 31:32"/>Kuom gik mane ope, jolweny nokawo rombe alufu mia auchiel gi piero abiriyo gabich (675,000), <verse eid="NUM 31:32"/><verse number="33" style="v" sid="NUM 31:33"/>dhok alufu piero abiriyo gariyo (72,000), <verse eid="NUM 31:33"/><verse number="34" style="v" sid="NUM 31:34"/>punde alufu piero auchiel gachiel (61,000), <verse eid="NUM 31:34"/><verse number="35" style="v" sid="NUM 31:35"/>kod nyiri alufu piero adek gariyo (32,000) mane pok ongʼeyo chwo.<verse eid="NUM 31:35"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="36" style="v" sid="NUM 31:36"/>Nus mar gik mane ope mane omi joma ne odhi kedo e lweny ne gin:</para>
  <para style="b" vid="NUM 31:36"/>
  <para style="li1" vid="NUM 31:36">rombe alufu mia adek gi piero adek gabiriyo gi mia abich (337,500), <verse eid="NUM 31:36"/><verse number="37" style="v" sid="NUM 31:37"/>pok mar Jehova Nyasaye ne gin rombe mia auchiel gi piero abiriyo gabich (675);<verse eid="NUM 31:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 31:38"/>kuom dhok alufu piero adek gauchiel (36,000), pok mar Jehova Nyasaye ne gin dhok piero abiriyo gariyo (72);<verse eid="NUM 31:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="NUM 31:39"/>kuom punde alufu piero adek gi mia abich (30,500), pok mar Jehova Nyasaye ne gin punde piero auchiel gachiel (61);<verse eid="NUM 31:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="NUM 31:40"/>kuom ji alufu apar gauchiel (16,000), pok mar Jehova Nyasaye ne gin ji piero adek gariyo (32).<verse eid="NUM 31:40"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="41" style="v" sid="NUM 31:41"/>Musa nomiyo Eliazar jadolo ma kor Jehova Nyasaye, kaka Jehova Nyasaye nochiko Musa.<verse eid="NUM 31:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 31:42"/>Nus mar pok mar jo-Israel mane Musa ogolo kuom joma nodhi e lweny ne chalo kama: <verse eid="NUM 31:42"/><verse number="43" style="v" sid="NUM 31:43"/>nus mar pok mar oganda ne gin rombe alufu mia adek gi piero adek gabiriyo gi mia abich (337,500), <verse eid="NUM 31:43"/><verse number="44" style="v" sid="NUM 31:44"/>dhok alufu piero adek gauchiel (36,000), <verse eid="NUM 31:44"/><verse number="45" style="v" sid="NUM 31:45"/>punde alufu piero adek gi mia abich (30,500), <verse eid="NUM 31:45"/><verse number="46" style="v" sid="NUM 31:46"/>kod ji alufu apar gauchiel (16,000). <verse eid="NUM 31:46"/><verse number="47" style="v" sid="NUM 31:47"/>Kuom nus pok mar jo-Israel, Musa noyiero achiel kuom piero abich mar ji kod jamni, mana kaka Jehova Nyasaye nochike, mi nomiyogi jo-Lawi, ma tijgi ne en rito hekalu mar Jehova Nyasaye.<verse eid="NUM 31:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48"/>Eka jotelo mane orito migepe mag jolweny, jotelo mag alufe alufe kod jotelo mag miche miche, nodhi ir Musa <verse eid="NUM 31:48"/><verse number="49" style="v" sid="NUM 31:49"/>mi owachone niya, “Jotichni osekwano kar romb jolweny man e lwetwa, kendo onge kata achiel kuomgi molal. <verse eid="NUM 31:49"/><verse number="50" style="v" sid="NUM 31:50"/>Omiyo wasekelo mich ne Jehova Nyasaye kuom gik molos gi dhahabu mane wayako kaka; thiwni, manyonge, tere, stadi kod tigo mondo omi wapwodhrego e richo e nyim Jehova Nyasaye.”<verse eid="NUM 31:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 31:51"/>Musa kod Eliazar jadolo noyie okawo dhahabugo irgi, ma gin gik mothedhi maber. <verse eid="NUM 31:51"/><verse number="52" style="v" sid="NUM 31:52"/>Dhahabu duto mane oa ir jotend lweny mag alufe alufe kod mago mag miche miche mane Musa kod Eliazar jadolo ochiwo kaka mich ne Jehova Nyasaye pekgi ne romo kilo mia ariyo. <verse eid="NUM 31:52"/><verse number="53" style="v" sid="NUM 31:53"/>Jalweny ka jalweny noyako mana gima orome. <verse eid="NUM 31:53"/><verse number="54" style="v" sid="NUM 31:54"/>Musa kod Eliazar jadolo nokawo dhahabu koa kuom jotend jolweny mag alufe alufe kod mago mag miche miche mi negiterogi e Hemb Romo kaka rapar mar jo-Israel e nyim Jehova Nyasaye.<verse eid="NUM 31:54"/></para>
  <chapter eid="NUM 31"/>
  <chapter number="32" style="c" sid="NUM 32"/>
  <para style="s1">Dhout Israel mane odongʼ loka Jordan</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1"/>Jo-Reuben gi jo-Gad, mane nigi kweth mag rombe kod dhok, noneno ni piny Jazer kod piny Gilead ne nigi lek maber mar pidho jamni. <verse eid="NUM 32:1"/><verse number="2" style="v" sid="NUM 32:2"/>Omiyo negibiro ir Musa gi Eliazar jadolo kod jotend oganda mar jo-Israel, mi giwachonegi niya, <verse eid="NUM 32:2"/><verse number="3" style="v" sid="NUM 32:3"/>Piny motingʼo Ataroth, Dibon, Jazer, Nimra, Heshbon, Eleale, Sebam, Nebo kod Beon <verse eid="NUM 32:3"/><verse number="4" style="v" sid="NUM 32:4"/>ma Jehova Nyasaye osekawo ka oganda mar jo-Israel neno en piny man-gi lek maber mar pidho jamni kendo ungʼeyo ni wan jotichu wan jopidh jamni. <verse eid="NUM 32:4"/><verse number="5" style="v" sid="NUM 32:5"/>Negiwachonegi niya, “Ka uyie kodwa, to miwauru pinyni wasumbiniu obed marwa mondo kik wakadh wadhi loka Jordan.”<verse eid="NUM 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6"/>Musa nowacho ne jo-Gad kod jo-Reuben niya, “Bende jou nyalo dhi e lweny ka un to udongʼ ka? <verse eid="NUM 32:6"/><verse number="7" style="v" sid="NUM 32:7"/>Angʼo momiyo unego chuny jo-Israel mondo kik dhi e piny ma Jehova Nyasaye osemiyogi? <verse eid="NUM 32:7"/><verse number="8" style="v" sid="NUM 32:8"/>Ma e gima kwereu notimo kane aorogi kane wan Kadesh Barnea mondo gidhi ginon pinyno. <verse eid="NUM 32:8"/><verse number="9" style="v" sid="NUM 32:9"/>Kane gisechopo e Holo mar Eshkol mi giringo pinyno, negimiyo chuny jo-Israel onyosore mar dhi e piny mane Jehova Nyasaye osemiyogi. <verse eid="NUM 32:9"/><verse number="10" style="v" sid="NUM 32:10"/>Negitugo mirimb Jehova Nyasaye chiengʼno mi nokwongʼore kama: <verse eid="NUM 32:10"/><verse number="11" style="v" sid="NUM 32:11"/>‘Nikech ok giseluwa gi chunygi duto, onge kata ngʼato achiel ma ja-higa piero ariyo kadhi nyime mane oa Misri mabiro neno piny mane asingora ka akwongʼora ne Ibrahim, Isaka kod Jakobo; <verse eid="NUM 32:11"/><verse number="12" style="v" sid="NUM 32:12"/>onge ngʼato angʼata kuomgi manone pinyno makmana Kaleb wuod Jefune ma ja-Kenizi kod Joshua wuod Nun, nimar negiluwo bangʼ Jehova Nyasaye gi chunygi duto.’ <verse eid="NUM 32:12"/><verse number="13" style="v" sid="NUM 32:13"/>Jehova Nyasaye nokecho gi jo-Israel kendo nomiyo giwuotho alanda e thim kuom higni piero angʼwen, nyaka ogandani duto mane otimo marach e nyim Jehova Nyasaye notho.<verse eid="NUM 32:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 32:14"/>“Un koth jorichogi, koro ubiro ira, kuchungʼ kar kwereu kendo umiyo mirimb Jehova Nyasaye medore kuom Israel. <verse eid="NUM 32:14"/><verse number="15" style="v" sid="NUM 32:15"/>Ka uweyo luwo Jehova Nyasaye, to obiro jwangʼo ogandani duto e thim kendo un ema ubiro miyo jogi rum.”<verse eid="NUM 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16"/>Bangʼ kinde matin negidwogo ir Musa mi giwachone niya, “Dwaher gero dipo ne jambwa kod mier madongo mondo mondwa kod nyithindwa odagie. <verse eid="NUM 32:16"/><verse number="17" style="v" sid="NUM 32:17"/>To kata kamano waikore mar manore gi gige lweny kendo dhi gi jo-Israel wetewa e piny mane osingnegi. To mokwongo nyaka wager ne mondwa gi nyithindwa mier madongo mochiel motegno mondo ogengʼ-gi kuom wasigu. <verse eid="NUM 32:17"/><verse number="18" style="v" sid="NUM 32:18"/>Ok wanaduogi e miechwa nyaka wane ni jo-Israel duto oseyudo pinyno kaka pok margi. <verse eid="NUM 32:18"/><verse number="19" style="v" sid="NUM 32:19"/>Wan ok wanadwar mondo opognwa piny kodgi loka machielo mar aora Jordan nimar osepognwa lopwa yo wuok chiengʼ mar Jordan lokani.”<verse eid="NUM 32:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20"/>Eka Musa nowachonegi niya, “Ka utimo kamano ma umanoru gi gige lweny e nyim Jehova Nyasaye, <verse eid="NUM 32:20"/><verse number="21" style="v" sid="NUM 32:21"/>kendo ka un duto unudhi ka utingʼo gige lweny loka Jordan e nyim Jehova Nyasaye mi ubed kuno nyaka chop Jehova Nyasaye riemb wasike duto e nyime, <verse eid="NUM 32:21"/><verse number="22" style="v" sid="NUM 32:22"/>ka uloyo pinyno e nyim Jehova Nyasaye, eka unuduogi kendo unubedi maonge ketho e nyim Jehova Nyasaye gi Israel. Kendo pinyni biro bedo pok maru e nyim Jehova Nyasaye.<verse eid="NUM 32:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 32:23"/>“To ka ok utimo kamano, to ubiro timo richo e nyim Jehova Nyasaye; kendo bed ka ungʼeyo ni richou nofwenyre e lela. <verse eid="NUM 32:23"/><verse number="24" style="v" sid="NUM 32:24"/>Geruru mier madongo ne mondu gi nyithindu, kod dipo ne jambu, kendo nyaka utim kaka usesingoru.”<verse eid="NUM 32:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25"/>Jo-Gad kod jo-Reuben nowacho ne Musa niya, “Wan jotichni, wabiro timo gima ruodhwa osechikowa. <verse eid="NUM 32:25"/><verse number="26" style="v" sid="NUM 32:26"/>Nyithindwa kod mondewa, rombwa kod dhowa biro dongʼ e miech Gilead ka. <verse eid="NUM 32:26"/><verse number="27" style="v" sid="NUM 32:27"/>To wan jotichni, ngʼato ka ngʼata ma jalweny biro ngʼado loka Jordan mondo oked e nyim Jehova Nyasaye mana kaka ruodhwa osechiko.”<verse eid="NUM 32:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28"/>Omiyo Musa nomiyogi chik ka oorogi ir Eliazar jadolo, kod Joshua wuod Nun kaachiel gi jotend dhout Israel. <verse eid="NUM 32:28"/><verse number="29" style="v" sid="NUM 32:29"/>Nowachonegi niya, “Ka jo-Gad kod jo-Reuben noidh kaachiel kodu Jordan e nyim Jehova Nyasaye, ka ngʼato ka ngʼato omanore mar kedo, to bangʼ ka useloyo piny, to unumigi piny Gilead kaka pok margi. <verse eid="NUM 32:29"/><verse number="30" style="v" sid="NUM 32:30"/>To ka ok giidho kaachiel kodu ka gimanore gi gige lweny, to nyaka gikaw pok mag-gi kaachiel kodu Kanaan.”<verse eid="NUM 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 32:31"/>Jo-Gad kod jo-Reuben nodwoko niya, “Jotichni biro timo kaka Jehova Nyasaye osewacho. <verse eid="NUM 32:31"/><verse number="32" style="v" sid="NUM 32:32"/>Wabiro ngʼado ka wadhi loka Kanaan e nyim Jehova Nyasaye ka wamanore gi gige lweny, to pok ma wabiro yudo biro bedo loka koni mar Jordan.”<verse eid="NUM 32:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33"/>Eka Musa nomiyo jo-Gad, jo-Reuben kod nus mar dhood Manase wuod Josef pinyruodh Sihon ma ruodh jo-Amor kod pinyruodh Og ma ruodh Bashan; pinyno duto kaachiel gi miechgi kod gwenge molworogi.<verse eid="NUM 32:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 32:34"/>Jo-Gad nogero mier madongo motegno kaka Dibon, Ataroth, Aroer, <verse eid="NUM 32:34"/><verse number="35" style="v" sid="NUM 32:35"/>Atroth Shofan, Jazer, Jogbeha, <verse eid="NUM 32:35"/><verse number="36" style="v" sid="NUM 32:36"/>Beth Nimra kod Beth Haran, kendo negigero dipo ne jambgi. <verse eid="NUM 32:36"/><verse number="37" style="v" sid="NUM 32:37"/>Joka Reuben nogero Heshbon, Eleale kod Kiriathaim, <verse eid="NUM 32:37"/><verse number="38" style="v" sid="NUM 32:38"/>kaachiel gi Nebo kod Baal Meon (nyingegi noduog oloki achien) kod Sibma. Mier madongo mane gigero negimiyo nying mamoko.<verse eid="NUM 32:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 32:39"/>Nyikwa Makir wuod Manase nodhi Gilead, moloyo dalano mi giriembo jo-Amor mane oyudo odak kanyo. <verse eid="NUM 32:39"/><verse number="40" style="v" sid="NUM 32:40"/>Omiyo Musa nochiwo Gilead e lwet jo-Makir, ma nyikwa Manase, kendo negidak kanyo. <verse eid="NUM 32:40"/><verse number="41" style="v" sid="NUM 32:41"/>Jair ma nyakwar Manase nodhi mokawo mier madongo mane ni kanyo, kendo nochako kanyo ni Havoth Jair. <verse eid="NUM 32:41"/><verse number="42" style="v" sid="NUM 32:42"/>Noba nomonjo Kenath kod mier molwore kendo nochake nyinge owuon miluongo ni Noba.<verse eid="NUM 32:42"/></para>
  <chapter eid="NUM 32"/>
  <chapter number="33" style="c" sid="NUM 33"/>
  <para style="s1">Migepe mag wuodh jo-Israel</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1"/>Ma e chenro mar wuodh jo-Israel e kinde mane gia Misri kopog-gi e migepe mopogore opogore kendo kotelnegi gi Musa kod Harun. <verse eid="NUM 33:1"/><verse number="2" style="v" sid="NUM 33:2"/>Kaluwore gi chik mar Jehova Nyasaye, Musa nondiko nonro maber mar migepe mag wuodhgi. Ma e kaka ne giwuotho e migawo ka migawo:<verse eid="NUM 33:2"/></para>
  <para style="b"/>
  <para style="pi1">
    <verse number="3" style="v" sid="NUM 33:3"/>Jo-Israel nochako wuoth koa Rameses e odiechiengʼ mar apar gabich mar dwe mokwongo, ma en odiechiengʼ mokwongo bangʼ Pasaka. Negiwuok ayanga ka jo-Misri nenogi to ne ok gidewo, <verse eid="NUM 33:3"/><verse number="4" style="v" sid="NUM 33:4"/>nikech jo-Misri noyudo yiko nyithindgi makayo mane Jehova Nyasaye onego ka ngʼadogo bura ne nyisechegi.<verse eid="NUM 33:4"/></para>
  <para style="pi1">
    <verse number="5" style="v" sid="NUM 33:5"/>Jo-Israel nowuok Rameses kendo negibuoro Sukoth.<verse eid="NUM 33:5"/></para>
  <para style="pi1">
    <verse number="6" style="v" sid="NUM 33:6"/>Negiwuok Sukoth mi gibworo Etham, mantiere e bath thim.<verse eid="NUM 33:6"/></para>
  <para style="pi1">
    <verse number="7" style="v" sid="NUM 33:7"/>Negiwuok Etham, mi gidok chien Pi Hahiroth, man yo wuok chiengʼ mar Baal Zefon, mi gibworo but Migdol.<verse eid="NUM 33:7"/></para>
  <para style="pi1">
    <verse number="8" style="v" sid="NUM 33:8"/>Negiwuok Pi Hahiroth mi gingʼado nam nyaka e thim, kendo kane gisewuotho kuom ndalo adek e Thim mar Etham, negibuoro Mara.<verse eid="NUM 33:8"/></para>
  <para style="pi1">
    <verse number="9" style="v" sid="NUM 33:9"/>Negiwuok Mara mi gidhi Elim, kuma ne nitie sokni apar gariyo kod yiend othidhe piero abiriyo, kendo negibuoro kanyo.<verse eid="NUM 33:9"/></para>
  <para style="pi1">
    <verse number="10" style="v" sid="NUM 33:10"/>Negiwuok Elim mi gibworo but Nam Makwar.<verse eid="NUM 33:10"/></para>
  <para style="pi1">
    <verse number="11" style="v" sid="NUM 33:11"/>Negiwuok Nam Makwar mi gibworo e Thim mar Sin.<verse eid="NUM 33:11"/></para>
  <para style="pi1">
    <verse number="12" style="v" sid="NUM 33:12"/>Negiwuok e Thim mar Sin mi gibworo Dofka.<verse eid="NUM 33:12"/></para>
  <para style="pi1">
    <verse number="13" style="v" sid="NUM 33:13"/>Negiwuok Dofka mi gibworo Alush.<verse eid="NUM 33:13"/></para>
  <para style="pi1">
    <verse number="14" style="v" sid="NUM 33:14"/>Negiwuok Alush mi gibworo Refidim, kama ne onge pi ma ji ne nyalo modho.<verse eid="NUM 33:14"/></para>
  <para style="pi1">
    <verse number="15" style="v" sid="NUM 33:15"/>Negiwuok Refidim mi gibworo e Thim mar Sinai.<verse eid="NUM 33:15"/></para>
  <para style="pi1">
    <verse number="16" style="v" sid="NUM 33:16"/>Negiwuok e Thim mar Sinai mi gibworo Kibroth Hatava.<verse eid="NUM 33:16"/></para>
  <para style="pi1">
    <verse number="17" style="v" sid="NUM 33:17"/>Negiwuok Kibroth Hatava mi gibworo Hazeroth.<verse eid="NUM 33:17"/></para>
  <para style="pi1">
    <verse number="18" style="v" sid="NUM 33:18"/>Negiwuok Hazeroth mi gibworo Rithma.<verse eid="NUM 33:18"/></para>
  <para style="pi1">
    <verse number="19" style="v" sid="NUM 33:19"/>Negiwuok Rithma mi gibworo Rimon Perez.<verse eid="NUM 33:19"/></para>
  <para style="pi1">
    <verse number="20" style="v" sid="NUM 33:20"/>Negiwuok Rimon Perez mi gibworo Libna.<verse eid="NUM 33:20"/></para>
  <para style="pi1">
    <verse number="21" style="v" sid="NUM 33:21"/>Negiwuok Libna mi gibworo Risa.<verse eid="NUM 33:21"/></para>
  <para style="pi1">
    <verse number="22" style="v" sid="NUM 33:22"/>Negiwuok Risa mi gibworo Kehelatha.<verse eid="NUM 33:22"/></para>
  <para style="pi1">
    <verse number="23" style="v" sid="NUM 33:23"/>Negiwuok Kehelatha mi gibworo e Got Shefa.<verse eid="NUM 33:23"/></para>
  <para style="pi1">
    <verse number="24" style="v" sid="NUM 33:24"/>Negiwuok Got Shefa mi gibworo Harada.<verse eid="NUM 33:24"/></para>
  <para style="pi1">
    <verse number="25" style="v" sid="NUM 33:25"/>Negiwuok Harada mi gibworo Makheloth.<verse eid="NUM 33:25"/></para>
  <para style="pi1">
    <verse number="26" style="v" sid="NUM 33:26"/>Negiwuok Makheloth mi gibworo Tahath.<verse eid="NUM 33:26"/></para>
  <para style="pi1">
    <verse number="27" style="v" sid="NUM 33:27"/>Negiwuok Tahath mi gibworo Tera.<verse eid="NUM 33:27"/></para>
  <para style="pi1">
    <verse number="28" style="v" sid="NUM 33:28"/>Negiwuok Tera mi gibworo Mithka.<verse eid="NUM 33:28"/></para>
  <para style="pi1">
    <verse number="29" style="v" sid="NUM 33:29"/>Negiwuok Mithka mi gibworo Hashmona.<verse eid="NUM 33:29"/></para>
  <para style="pi1">
    <verse number="30" style="v" sid="NUM 33:30"/>Negiwuok Hashmona mi gibworo Moseroth.<verse eid="NUM 33:30"/></para>
  <para style="pi1">
    <verse number="31" style="v" sid="NUM 33:31"/>Negiwuok Moseroth mi gibworo Bene Jaakan.<verse eid="NUM 33:31"/></para>
  <para style="pi1">
    <verse number="32" style="v" sid="NUM 33:32"/>Negiwuok Bene Jaakan mi gibworo Hor Hagidgad.<verse eid="NUM 33:32"/></para>
  <para style="pi1">
    <verse number="33" style="v" sid="NUM 33:33"/>Negiwuok Hor Hagidgad mi gibworo Jotbatha.<verse eid="NUM 33:33"/></para>
  <para style="pi1">
    <verse number="34" style="v" sid="NUM 33:34"/>Negiwuok Jotbatha mi gibworo Abrona.<verse eid="NUM 33:34"/></para>
  <para style="pi1">
    <verse number="35" style="v" sid="NUM 33:35"/>Negiwuok Abrona mi gibworo Ezion Geber.<verse eid="NUM 33:35"/></para>
  <para style="pi1">
    <verse number="36" style="v" sid="NUM 33:36"/>Negiwuok Ezion Geber mi gibworo Kadesh, mantiere e Thim mar Zin.<verse eid="NUM 33:36"/></para>
  <para style="pi1">
    <verse number="37" style="v" sid="NUM 33:37"/>Negiwuok Kadesh mi gibworo e Got Hor, mantiere e tongʼ mar Edom. <verse eid="NUM 33:37"/><verse number="38" style="v" sid="NUM 33:38"/>Kaluwore gi chik mar Jehova Nyasaye, Harun jadolo nodhi e Got Hor, kama nothoe odiechiengʼ mokwongo mar dwe mar abich, e higa mar piero angʼwen bangʼ wuok jo-Israel e piny Misri. <verse eid="NUM 33:38"/><verse number="39" style="v" sid="NUM 33:39"/>Harun ne ja-higni mia achiel gi piero ariyo gadek eka ne otho e Got Hor.<verse eid="NUM 33:39"/></para>
  <para style="pi1">
    <verse number="40" style="v" sid="NUM 33:40"/>Ruoth Arad ma ja-Kanaan, mane odak Negev mar Kanaan, nowinjo ni jo-Israel biro.<verse eid="NUM 33:40"/></para>
  <para style="pi1">
    <verse number="41" style="v" sid="NUM 33:41"/>Kane giwuok e Got Hor negibuoro Zalmona.<verse eid="NUM 33:41"/></para>
  <para style="pi1">
    <verse number="42" style="v" sid="NUM 33:42"/>Negiwuok Zalmona mi gibworo Punon.<verse eid="NUM 33:42"/></para>
  <para style="pi1">
    <verse number="43" style="v" sid="NUM 33:43"/>Negiwuok Punon mi gibworo Oboth.<verse eid="NUM 33:43"/></para>
  <para style="pi1">
    <verse number="44" style="v" sid="NUM 33:44"/>Negiwuok Oboth mi gibworo Iye Abarim, mantiere e tongʼ piny Moab.<verse eid="NUM 33:44"/></para>
  <para style="pi1">
    <verse number="45" style="v" sid="NUM 33:45"/>Negiwuok Iye Abarim mi gibworo Dibon Gad.<verse eid="NUM 33:45"/></para>
  <para style="pi1">
    <verse number="46" style="v" sid="NUM 33:46"/>Negiwuok Dibon Gad mi gibworo Almon Diblathaim.<verse eid="NUM 33:46"/></para>
  <para style="pi1">
    <verse number="47" style="v" sid="NUM 33:47"/>Negiwuok Almon Diblathaim mi gibworo e gode mag Abarim, man but Nebo.<verse eid="NUM 33:47"/></para>
  <para style="pi1">
    <verse number="48" style="v" sid="NUM 33:48"/>Bangʼ kane giwuok e gode mag Abarim negibuoro e pewe mag Moab mokiewo gi Jordan momanyore gi Jeriko. <verse eid="NUM 33:48"/><verse number="49" style="v" sid="NUM 33:49"/>Negibuoro e pewe mag Moab mokiewo gi Jordan chakre Beth Jeshimoth nyaka Abel Shitim.<verse eid="NUM 33:49"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50"/>Jehova Nyasaye nowuoyo gi Musa e pewe mag Moab momanyore gi Jeriko mokiewo gi Jordan kowachone niya, <verse eid="NUM 33:50"/><verse number="51" style="v" sid="NUM 33:51"/>“Wuo gi jo-Israel kendo iwachnegi kama: Ka ungʼado Jordan mi udonjo Kanaan, <verse eid="NUM 33:51"/><verse number="52" style="v" sid="NUM 33:52"/>to uriemb ji duto modak e pinyno. Kethuru gigegi duto mopa milamo bende uwit kido duto milamo ma giloso, kendo umuki kuondegi magiloso motingʼore gi malo mar lemo. <verse eid="NUM 33:52"/><verse number="53" style="v" sid="NUM 33:53"/>Kawuru pinyno mi udagie, nimar asemiyougo mondo obed maru. <verse eid="NUM 33:53"/><verse number="54" style="v" sid="NUM 33:54"/>Poguru pinyno e kugoyo ombulu e kindu, kaluwore gi dhoutu. Dhoot maduongʼ opog lowo maduongʼ, to dhoot matin opog lowo matin. Gimoro amora mopogne dhoutu gombulu nobed margi. Pog-gi kaluwore gi dhout kweregi.<verse eid="NUM 33:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="NUM 33:55"/>“ ‘To ka ok uriembo joma odak e pinyno, to joma uweyo modongʼ biro bedonu ka cha bondo e wangʼu kendo ka kudho machwoyo dendu koni gi koni. Ginimiu chandruok e piny ma ubiro dakieno. <verse eid="NUM 33:55"/><verse number="56" style="v" sid="NUM 33:56"/>Bangʼ mano anatimnu gima ne achano mondo atimnegi.’ ”<verse eid="NUM 33:56"/></para>
  <chapter eid="NUM 33"/>
  <chapter number="34" style="c" sid="NUM 34"/>
  <para style="s1">Tongʼ piny Kanaan</para>
  <para style="li4">
    <verse number="1" style="v" sid="NUM 34:1"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 34:1"/><verse number="2" style="v" sid="NUM 34:2"/>“Chik jo-Israel kiwachonegi kama: Ka usedonjo e piny Kanaan, ma en piny manomiu kaka poku, tongʼne nochal kama:<verse eid="NUM 34:2"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="3" style="v" sid="NUM 34:3"/>“ ‘Pinyu ma yo milambo nochakre e Thim Zin manie tongʼ piny Edom. Tongʼu ma yo milambo mogik yo wuok chiengʼ nochakre e giko mar Nam Chumbi <verse eid="NUM 34:3"/><verse number="4" style="v" sid="NUM 34:4"/>kongʼado yo milambo mar Akrabim, modhi nyime nyaka Zin kendo ochopo yo milambo mar Kadesh Barnea. Eka nodhi nyaka Hazar Adar mi okal nyaka Azmon, <verse eid="NUM 34:4"/><verse number="5" style="v" sid="NUM 34:5"/>kama Azmon ogomoe, moriwre gi Wadi mar Misri kendo gikone en Nam Mediterania.<verse eid="NUM 34:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 34:6"/>Tongʼu man yo podho chiengʼ nobed Nam Mediterania. Ma ema nobed tongʼu man yo podho chiengʼ.<verse eid="NUM 34:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 34:7"/>Tongʼu man yo nyandwat nochakre e dho Nam Mediterania nyaka e Got Hor <verse eid="NUM 34:7"/><verse number="8" style="v" sid="NUM 34:8"/>kendo koa e Got Hor nyaka Lebo Hamath. Eka tongʼno nodhi nyaka Zedad, <verse eid="NUM 34:8"/><verse number="9" style="v" sid="NUM 34:9"/>kodhi nyime nyaka Zifron mi ogik Hazar Enan. Ma ema nobed tongʼu man yo nyandwat.<verse eid="NUM 34:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 34:10"/>Tongʼu man yo wuok chiengʼ, nochakre Hazar Enan nyaka Shefam. <verse eid="NUM 34:10"/><verse number="11" style="v" sid="NUM 34:11"/>Tongʼno nodhi nyime koa Shefam nyaka Ribla mantiere yo wuok chiengʼ mar Ain kendo nomed dhi nyaka kuonde moridore mantiere yo wuok chiengʼ mar Nam Kinereth. <verse eid="NUM 34:11"/><verse number="12" style="v" sid="NUM 34:12"/>Eka tongʼno nodhi nyime koluwo Jordan kendo nogigi e Nam Chumbi.</para>
  <para style="b" vid="NUM 34:12"/>
  <para style="li4" vid="NUM 34:12">“ ‘Magi ema nobed tongʼ pinyu koni gi koni.’ ”<verse eid="NUM 34:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13"/>Musa nomiyo jo-Israel chik kama: “Ma e piny ma ubiro kawo kaka poku kokalo kuom goyo ombulu. Jehova Nyasaye osechiwo chik mondo pinyno opogi ne dhoudi ochiko gi nus, <verse eid="NUM 34:13"/><verse number="14" style="v" sid="NUM 34:14"/>nimar anywola mag dhood Reuben, dhood Gad, kod nus mar dhood Manase oseyudo pok margi. <verse eid="NUM 34:14"/><verse number="15" style="v" sid="NUM 34:15"/>Dhoudi ariyo gi nusgo oseyudo pokgi loka Aora Jordan man yo wuok chiengʼ mar Jeriko.”<verse eid="NUM 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16"/>Jehova Nyasaye nowacho ne Musa niya, <verse eid="NUM 34:16"/><verse number="17" style="v" sid="NUM 34:17"/>“Magi e nyinge joma chwo monego pogu pinyni kaka pok maru: Eliazar jadolo kod Joshua wuod Nun. <verse eid="NUM 34:17"/><verse number="18" style="v" sid="NUM 34:18"/>Bende nyaka ikaw jatend dhoot ka dhoot mondo okonyi e tijno.<verse eid="NUM 34:18"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="19" style="v" sid="NUM 34:19"/>“Kendo magi e nying-gi:</para>
  <para style="b" vid="NUM 34:19"/>
  <para style="li1" vid="NUM 34:19">“e dhood Juda, en Kaleb wuod Jefune;<verse eid="NUM 34:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 34:20"/>e dhood Simeon, en Shemuel wuod Amihud;<verse eid="NUM 34:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="NUM 34:21"/>e dhood Benjamin, en Elidad wuod Kislon;<verse eid="NUM 34:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 34:22"/>jatelo mowuok e dhood Dan, en Buki wuod Jogli;<verse eid="NUM 34:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 34:23"/>jatelo mowuok e dhood Manase wuod Josef, en Haniel wuod Efod;<verse eid="NUM 34:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 34:24"/>jatelo mowuok e dhood Efraim wuod Josef, en Kemuel wuod Shiftan;<verse eid="NUM 34:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 34:25"/>jatelo mowuok e dhood Zebulun, en Elizafan wuod Parnak;<verse eid="NUM 34:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 34:26"/>jatelo mowuok e dhood Isakar, en Paltiel wuod Azan;<verse eid="NUM 34:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="NUM 34:27"/>jatelo mowuok e dhood Asher, en Ahihud wuod Shelomi;<verse eid="NUM 34:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 34:28"/>jatelo mowuok e dhood Naftali, en Pedahel wuod Amihud.”<verse eid="NUM 34:28"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="29" style="v" sid="NUM 34:29"/>Magi e joma Jehova Nyasaye nochiko mondo opog jo-Israel girkeni e piny Kanaan.<verse eid="NUM 34:29"/></para>
  <chapter eid="NUM 34"/>
  <chapter number="35" style="c" sid="NUM 35"/>
  <para style="s1">Miech jo-Lawi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1"/>Jehova Nyasaye nowuoyo gi Musa e pewe mag Moab momanyore gi Jeriko mokiewo gi Jordan kowacho niya, <verse eid="NUM 35:1"/><verse number="2" style="v" sid="NUM 35:2"/>“Chik jo-Israel mondo gimi jo-Lawi mier ma gibiro dakie kuom pok ma jo-Israel biro yudo. Kendo umigi lege mag kwath molworo miergo. <verse eid="NUM 35:2"/><verse number="3" style="v" sid="NUM 35:3"/>Eka ginibed gi mier ma ginyalo dakie kod lege mag kwath ne dhog-gi, rombegi kod jambgi mamoko duto.<verse eid="NUM 35:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 35:4"/>“Kuonde mag kwath molworo mier ma umiyo jo-Lawi nopim maromo fut alufu achiel mia angʼwen gi piero abiriyo gauchiel koa e kor ohinga. <verse eid="NUM 35:4"/><verse number="5" style="v" sid="NUM 35:5"/>To oko mar dala, pimuru fut alufu angʼwen mia abich kod piero ochiko gadek koa yo wuok chiengʼ, fut alufu angʼwen mia abich kod piero ochiko gadek koa yo milambo, fut alufu angʼwen mia abich kod piero ochiko gadek koa yo podho chiengʼ, kod fut alufu angʼwen mia abich kod piero ochiko gadek koa yo nyandwat, ka dala oger e dier lowono tir. Ginikaw kanyo kaka lek mar kwath ne joma odak e miergo.<verse eid="NUM 35:5"/></para>
  <para style="s1">Mier mag tony</para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 35:6"/>“Mier auchiel ma umiyo jo-Lawi nobed mier mag tony, ma ngʼat moneko nyalo ringo mondo opondie. Ewi mago medgi mier piero angʼwen gariyo mamoko. <verse eid="NUM 35:6"/><verse number="7" style="v" sid="NUM 35:7"/>Koriwore duto nyaka umi jo-Lawi mier piero angʼwen gaboro, kaachiel gi lege mag kwath. <verse eid="NUM 35:7"/><verse number="8" style="v" sid="NUM 35:8"/>Mier ma umiyo jo-Lawi koa kuom piny ma jo-Israel okawo kaka pok margi nyaka pog matindo tindo kaka pok mar dhoot ka dhoot: Kawuru mier mangʼeny kuom dhoot man-gi mangʼeny, to kawuru manok kuom jogo man-gi manok.”<verse eid="NUM 35:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9"/>Eka Jehova Nyasaye nowacho ne Musa kama: <verse eid="NUM 35:9"/><verse number="10" style="v" sid="NUM 35:10"/>“Wuo gi jo-Israel kendo iwachnegi ni: ‘Ka ungʼado Jordan mi uchopo Kanaan, <verse eid="NUM 35:10"/><verse number="11" style="v" sid="NUM 35:11"/>to yieruru mier moko mondo obed miechu mag tony, ma ngʼat monego ngʼato kobothne nyalo ringo dhiye. <verse eid="NUM 35:11"/><verse number="12" style="v" sid="NUM 35:12"/>Gibiro bedo mier mag tony kua e nyim ngʼama dwaro chulo kuor, mondo omi ngʼat miparo kuome ni oneko kik negi kapok oyale e nyim oganda. <verse eid="NUM 35:12"/><verse number="13" style="v" sid="NUM 35:13"/>Mier auchiel muchiwogi nobed mier mag tony. <verse eid="NUM 35:13"/><verse number="14" style="v" sid="NUM 35:14"/>Chiwuru mier adek mag tony ni yo wuok chiengʼ mar Jordan to adek nobed Kanaan. <verse eid="NUM 35:14"/><verse number="15" style="v" sid="NUM 35:15"/>Mier auchielgo nobed kuonde tony ne jo-Israel, jodak kod ngʼato angʼata modak kodgi, mondo omi ngʼato angʼata monego ngʼat machielo kobothne nyalo ringo dhiye.<verse eid="NUM 35:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 35:16"/>“ ‘Ka ngʼato ogoyo wadgi gi gima olos gi chuma, motho, to en janek; omiyo janekno nyaka negi. <verse eid="NUM 35:16"/><verse number="17" style="v" sid="NUM 35:17"/>Kata ka ngʼato nigi kidi e lwete manyalo nego ngʼato, mi ogoyogo wadgi motho, to en janek; omiyo janekno nyaka negi. <verse eid="NUM 35:17"/><verse number="18" style="v" sid="NUM 35:18"/>Kata ka ngʼato otingʼo gimoro molos gi yien e lwete, mi ogoyogo wadgi motho, en janek; omiyo janekno nyaka negi. <verse eid="NUM 35:18"/><verse number="19" style="v" sid="NUM 35:19"/>Owad gi ngʼat monegno noneg janekno; koromo kode to nonege. <verse eid="NUM 35:19"/><verse number="20" style="v" sid="NUM 35:20"/>Ka ngʼato obwono wadgi gi chunye kata odiro gimoro kuome kongʼeyo motho, <verse eid="NUM 35:20"/><verse number="21" style="v" sid="NUM 35:21"/>kata ka en gi mirima mi ogoye adhongʼ motho, to ngʼatno nonegi; nimar en janek. Owad gi ngʼat monegno noneg janekno koromo kode.<verse eid="NUM 35:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 35:22"/>“ ‘To kaponi odhiro wadgi ma ok gimonrego kata kochiele gi gimoro kobothne <verse eid="NUM 35:22"/><verse number="23" style="v" sid="NUM 35:23"/>kata ka olwaro kidi manyalo nege kuome motho; to ne ok en jasike kendo noonge gi paro mar hinye, <verse eid="NUM 35:23"/><verse number="24" style="v" sid="NUM 35:24"/>to oganda nokel thek e kind janekno kod owadgi ngʼat monegi kaluwore gi chik. <verse eid="NUM 35:24"/><verse number="25" style="v" sid="NUM 35:25"/>Oganda nyaka res janekno kuom owad gi ngʼat monegi mi gidwoke e dala mar tony mane oringo odhiye. Enodag kanyo nyaka chop jadolo mane owir gi mo maler tho.<verse eid="NUM 35:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 35:26"/>“ ‘To ka ngʼat monekono owuok oko mar dala mar tony mane odhiyoe, <verse eid="NUM 35:26"/><verse number="27" style="v" sid="NUM 35:27"/>kendo owad gi ngʼat mane onegocha oyude oko mar dala mar tony, to onyalo nege ma ok obedo gi richo mar nek. <verse eid="NUM 35:27"/><verse number="28" style="v" sid="NUM 35:28"/>Janek nyaka sik e dalane mar tony nyaka jadolo maduongʼ tho; to en mana bangʼ tho mar jadolo maduongʼno ema onyalo dok chamo mwandune.<verse eid="NUM 35:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 35:29"/>“ ‘Mago ema nobednu chike mosiko e tienge duto, kamoro amora ma unudagie.<verse eid="NUM 35:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 35:30"/>“ ‘Ngʼato angʼata ma onego ngʼato nyaka negi kaka janek mana ka nitie joneno manyalo wacho ni notimore kamano. To onge ngʼama inyalo negi kuom wach janeno achiel kende.<verse eid="NUM 35:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 35:31"/>“ ‘Kik ikaw asoya kuom ngʼatno moneko, nikech owinjore gi tho. Nyaka ngʼatno negi.<verse eid="NUM 35:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 35:32"/>“ ‘Kik ikaw asoya kuom ngʼato angʼata moringo odhi e dala mar tony koparo ni inyalo weye mondo odog e lope owuon kapok jadolo maduongʼ otho.<verse eid="NUM 35:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 35:33"/>“ ‘Kik udwany piny mudakie. Chwero remo dwanyo piny, kendo pwodhruok ok nyal tim ne piny modwany kuom chwero remo, makmana kokadho kuom remb ngʼatno mane ochwero remo. <verse eid="NUM 35:33"/><verse number="34" style="v" sid="NUM 35:34"/>Kik udwany piny mudakie gi remo kod kama adakie, nimar an, Jehova Nyasaye, adak e kind jo-Israel.’ ”<verse eid="NUM 35:34"/></para>
  <chapter eid="NUM 35"/>
  <chapter number="36" style="c" sid="NUM 36"/>
  <para style="s1">Pok mwandu mag nyi Zelofehad</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1"/>Jatend anywola mar joka Gilead wuod Makir, ma wuod Manase, mane oa e dhout nyikwa Josef, nobiro mi owuoyo e nyim Musa kod jotelo, ma gin jotend anywola mag jo-Israel. <verse eid="NUM 36:1"/><verse number="2" style="v" sid="NUM 36:2"/>Negiwacho niya, “Kane Jehova Nyasaye omiyo ruodha chik mondo opog piny ne jo-Israel kigoyo ombulu, nomiyi chik mondo pok mag owadwa Zelofehad mi nyige. <verse eid="NUM 36:2"/><verse number="3" style="v" sid="NUM 36:3"/>Koro parane ni onywomgi gi chwo moa e dhout jo-Israel mamoko; to pokgi nogol kuom pok mar kwerewa, mi med libamba mane onywomogi. Omiyo bath pok marwa nomawa. <verse eid="NUM 36:3"/><verse number="4" style="v" sid="NUM 36:4"/>Ka Higa mar Piero Abich mar jo-Israel ochopo (tiende ni Jubli), to nokaw girkeni mag-gi kigolo kuom gikeni mar dhoodgi kimedo e dhood joma onywomogi.”<verse eid="NUM 36:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5"/>Eka Musa nomiyo jo-Israel wach machalo kama kaluwore gi chik mane Jehova Nyasaye omiye: “Gima dhood nyikwa Josef wacho nikare. <verse eid="NUM 36:5"/><verse number="6" style="v" sid="NUM 36:6"/>Ma e chik ma Jehova Nyasaye chiwo kuom nyi Zelofehad: Inyalo nywomgi gi ngʼato angʼata ma gihero moa e dhoodgi. <verse eid="NUM 36:6"/><verse number="7" style="v" sid="NUM 36:7"/>Onge pok mar Israel maa e dhoodni to dhi e dhoot machielo, nimar ja-Israel moro ka moro norit lowo mane oyudo koa kuom kwerene. <verse eid="NUM 36:7"/><verse number="8" style="v" sid="NUM 36:8"/>Nyako moro amora ma oyudo pok mar lowo kaka girkeni e dhood Israel moro amora nyaka nyuom gi ngʼato moa e dhood wuon mare, mondo omi ja-Israel moro amora oyud pok mar wuon mare. <verse eid="NUM 36:8"/><verse number="9" style="v" sid="NUM 36:9"/>Onge pok mano kadhi koa e dhoodni kadhi e dhoot machielo, nimar ja-Israel moro amora nyaka rit lop kwerene.”<verse eid="NUM 36:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 36:10"/>Omiyo nyi Zelofehad notimo mana kaka Jehova Nyasaye nosemiyo Musa chik. <verse eid="NUM 36:10"/><verse number="11" style="v" sid="NUM 36:11"/>Nyi Zelofehad miluongo ni Mala, Tirza, Hogla, Milka kod Nowa nonywom gi ominegi ma yawuot owadgi wuon-gi. <verse eid="NUM 36:11"/><verse number="12" style="v" sid="NUM 36:12"/>Nonywomgi ei anywola mar nyikwa Manase wuod Josef, kendo pok margi nosiko e anywola gi wuon-gi kendo e dhood gi wuon-gi.<verse eid="NUM 36:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="NUM 36:13"/>Magi e chike kod buche mane Jehova Nyasaye ochiwo kokalo kuom Musa mondo omi jo-Israel e pewe mag Moab e bath Aora Jordan kama omanyore gi Jeriko.<verse eid="NUM 36:13"/></para>
  <chapter eid="NUM 36"/>
</usx>
