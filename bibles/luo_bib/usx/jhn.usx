<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Biblica® Open New Luo Translation 2020</book>
  <para style="h">Johana</para>
  <para style="toc1">Injili Mar Johana</para>
  <para style="toc2">Johana</para>
  <para style="toc3">Joh</para>
  <para style="mt2">Injili Mar</para>
  <para style="mt1">Johana</para>
  <chapter number="1" style="c" sid="JHN 1"/>
  <para style="s1">Wach nodoko dhano</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1"/>Kar chakruok, Wach ne nitie, kendo Wach ne ni kod Nyasaye, kendo Wach ne en Nyasaye. <verse eid="JHN 1:1"/><verse number="2" style="v" sid="JHN 1:2"/>Ne en gi Nyasaye nyaka aa chakruok. <verse eid="JHN 1:2"/><verse number="3" style="v" sid="JHN 1:3"/>En ema nomiyo gik moko duto ochwe; kendo ka dine onge en, to onge gima dine ochwe mosechwe. <verse eid="JHN 1:3"/><verse number="4" style="v" sid="JHN 1:4"/>Ngima ne ni kuome, kendo ngimano ne en ler ni ji. <verse eid="JHN 1:4"/><verse number="5" style="v" sid="JHN 1:5"/>Lerno rieny ei mudho, to mudho pok oime.<verse eid="JHN 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6"/>Nyasaye nooro ngʼat moro ma nyinge Johana. <verse eid="JHN 1:6"/><verse number="7" style="v" sid="JHN 1:7"/>Nobiro kaka janeno mondo otim nend lerno, mondo kanyalore to ji duto oyie kuom lerno. <verse eid="JHN 1:7"/><verse number="8" style="v" sid="JHN 1:8"/>Johana owuon ne ok en ler nogo, to nobiro mana kaka janeno mar lerno.<verse eid="JHN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 1:9"/>Ler mar adier machiwo ler ni ji duto noyudo biro e piny e kindeno. <verse eid="JHN 1:9"/><verse number="10" style="v" sid="JHN 1:10"/>Ne en e piny, to kata obedo ni en ema nomiyo ochwe piny, to piny ne ok ongʼeye. <verse eid="JHN 1:10"/><verse number="11" style="v" sid="JHN 1:11"/>Nobiro ir joge owuon, to joge ne ok orwake. <verse eid="JHN 1:11"/><verse number="12" style="v" sid="JHN 1:12"/>To ji duto mane orwake, mi oyie kuome, nomiyogi teko mar doko nyithind Nyasaye, <verse eid="JHN 1:12"/><verse number="13" style="v" sid="JHN 1:13"/>ma gin nyithindo mane ok onywol koa e koth dhano, kata kuom pach dhano, kata kuom dwach dichwo, to nonywolgi kuom Nyasaye.<verse eid="JHN 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14"/>Wach nodoko dhano kendo nodak kodwa. Waseneno duongʼne, ma en duongʼ mar Wuowi ma Miderma, ma noa ka Wuoro kopongʼ gi ngʼwono kod adiera.<verse eid="JHN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15"/>Johana notimo neno kuome. Nokok matek kowacho niya, “Ma e Jal mane awuoyo kuome kane awachonu ni, ‘Jal mabiro bangʼa oloya mabor nikech ne entie kapok ne abetie.’ ” <verse eid="JHN 1:15"/><verse number="16" style="v" sid="JHN 1:16"/>Waduto waseyudo gweth mogundho kuom ngʼwonone mathoth. <verse eid="JHN 1:16"/><verse number="17" style="v" sid="JHN 1:17"/>Chik nochiw kokalo kuom Musa, to ngʼwono kod adiera, to Yesu Kristo ema nokelo. <verse eid="JHN 1:17"/><verse number="18" style="v" sid="JHN 1:18"/>Onge ngʼama oseneno Nyasaye, to Wuowi ma Miderma machiegni gi Wuoro ema osemiyo wangʼeye.<verse eid="JHN 1:18"/></para>
  <para style="s1">Johana ja-Batiso okwero ni ok en Kristo</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19"/>Ma e neno mane Johana otimo ka jo-Yahudi modak Jerusalem nooro jodolo gi jo-Lawi mondo openje ni ne en ngʼa. <verse eid="JHN 1:19"/><verse number="20" style="v" sid="JHN 1:20"/>Johana ne ok opandonegi gimoro, to nohulonigi ka en thuolo niya, “Ok an Kristo.”<verse eid="JHN 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21"/>Negipenje niya, “Kare in ngʼa? In Elija koso?”</para>
  <para style="p" vid="JHN 1:21">To nowacho niya, “Ok an.”</para>
  <para style="p" vid="JHN 1:21">“Koso in e janabi?”</para>
  <para style="p" vid="JHN 1:21">Nodwoko niya, “Ooyo.”<verse eid="JHN 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22"/>Eka negiwachone mogik niya, “Kare, in ngʼa? Miwa dwoko mondo water ni joma ne oorowa. Iwacho angʼo kuomi in iwuon?”<verse eid="JHN 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23"/>Johana nodwokogi gi weche mag Isaya Janabi niya, “An e ngʼat makok e thim ni, ‘Losuru yo moriere tir ne Jehova Nyasaye.’ ”<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:3">Isa 40:3</ref></char></char></note><verse eid="JHN 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24"/>To jo-Farisai moko ma noor, <verse eid="JHN 1:24"/><verse number="25" style="v" sid="JHN 1:25"/>nopenje niya, “Ka ok in Kristo, kata Elija, kata janabi, to angʼo momiyo ibatiso ji?”<verse eid="JHN 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26"/>Johana nodwokogi niya, “An abatisou gi pi, to nitie ngʼato e dieru ma ukia. <verse eid="JHN 1:26"/><verse number="27" style="v" sid="JHN 1:27"/>En Jal mabiro bangʼa, ma ok awinjora gonyo tond wuochene.”<verse eid="JHN 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28"/>Magi duto notimore Bethania, loka mar aora Jordan, kuma Johana ne batisoe ji.<verse eid="JHN 1:28"/></para>
  <para style="s1">Yesu nyarombo mar Nyasaye</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29"/>Kinyne Johana noneno Yesu kabiro ire, mi nowacho niya, “Neuru, Jalcha e Nyarombo mar Nyasaye, magolo richo mar piny! <verse eid="JHN 1:29"/><verse number="30" style="v" sid="JHN 1:30"/>Ma e jal mane awuoyo kuome kane awacho ni, ‘Ngʼato mabiro bangʼa oloya mabor, nikech ne entie kapok ne abetie.’ <verse eid="JHN 1:30"/><verse number="31" style="v" sid="JHN 1:31"/>An awuon ne ok angʼeye, to gimomiyo ne abiro ka abatiso ji gi pi ne en mondo ofwenyre ni Israel.”<verse eid="JHN 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32"/>Eka Johana notimo nenoni kama: “Ne aneno Roho kalor piny koa e polo e kido mar akuru kendo kapiyo kuome. <verse eid="JHN 1:32"/><verse number="33" style="v" sid="JHN 1:33"/>Ka dine Jal mane oora mondo abatis ji gi pi we nyisa, to dine ok angʼeye. Nonyisa ni, ‘Ngʼama ineno ka Roho olor mi opiyo kuome e Jal mabiro batiso ji gi Roho Maler.’ <verse eid="JHN 1:33"/><verse number="34" style="v" sid="JHN 1:34"/>Koro aseneno mano kotimore omiyo anyisou ni en Wuod Nyasaye.”<verse eid="JHN 1:34"/></para>
  <para style="s1">Jopuonjre mokwongo mag Yesu</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35"/>Kinyne Johana ne ni kanyo kendo gi jopuonjrene ariyo. <verse eid="JHN 1:35"/><verse number="36" style="v" sid="JHN 1:36"/>Kane gineno ka Yesu kalo machiegni, nowacho niya, “Neuru, Jalcha e Nyarombo mar Nyasaye!”<verse eid="JHN 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37"/>Kane jopuonjrene ariyogo owinjo kowacho mano, negiluwo bangʼ Yesu. <verse eid="JHN 1:37"/><verse number="38" style="v" sid="JHN 1:38"/>Yesu nolokore monenogi ka giluwo bangʼe, mi nopenjogi niya, <char style="wj">“Angʼo mudwaro?”</char></para>
  <para style="p" vid="JHN 1:38">Negiwachone niya, “Rabi” (ma tiende ni “Japuonj”), “idak kanye?”<verse eid="JHN 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39"/>Nodwokogi niya, <char style="wj">“Biuru mondo udhi une.”</char></para>
  <para style="p" vid="JHN 1:39">Omiyo negidhi mine gineno kama ne odakie, kendo negibet kode kanyo odiechiengʼ ngima. Ne en kar sa apar mar odhiambo.<verse eid="JHN 1:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40"/>Andrea mowadgi Simon Petro ne en achiel kuom ji ariyo mane owinjo gima Johana nowacho mi noluwo bangʼ Yesu. <verse eid="JHN 1:40"/><verse number="41" style="v" sid="JHN 1:41"/>Gima Andrea notimo mokwongo ne en manyo owadgi ma Simon kendo nyise niya, “Waseyudo Mesia” (tiende ni Kristo). <verse eid="JHN 1:41"/><verse number="42" style="v" sid="JHN 1:42"/>Omiyo nokelo Simon ir Yesu.</para>
  <para style="p" vid="JHN 1:42">Yesu nongʼiye tir mowachone niya, <char style="wj">“In Simon wuod Johana, chiengʼ moro noluongi ni Kefa”</char> (tiende ni Petro<note caller="+" style="f"><char style="fr" closed="false">1:42 </char><char style="fq" closed="false">Kefa </char><char style="ft" closed="false">en dho jo-Arama, to </char><char style="fq" closed="false">Petro </char><char style="ft" closed="false">en dho jo-Yunani, giduto tiende ni </char><char style="fqa" closed="false">Lwanda.</char></note>).<verse eid="JHN 1:42"/></para>
  <para style="s1">Yesu oluongo Filipo gi Nathaniel</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43"/>Kinyne Yesu nongʼado e pache mondo oa odhi Galili. Kane oyudo Filipo, nowachone niya, <char style="wj">“Luwa.”</char><verse eid="JHN 1:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44"/>Filipo, mana kaka Andrea gi Petro, ne aa e dala mar Bethsaida. <verse eid="JHN 1:44"/><verse number="45" style="v" sid="JHN 1:45"/>Filipo noyudo Nathaniel mowachone niya, “Waseyudo ngʼat ma Musa nondiko kuome e kitap Chik, kendo ma jonabi bende nondiko kuome, ma en Yesu ja-Nazareth, ma wuod Josef.”<verse eid="JHN 1:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46"/>Nathaniel nopenje niya, “Bende gima ber moro amora nyalo aa Nazareth adier?”</para>
  <para style="p" vid="JHN 1:46">Filipo nodwoke niya, “Bi mondo ine.”<verse eid="JHN 1:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47"/>Kane Yesu oneno Nathaniel ka biro kochomo ire, nowuoyo kuome kowacho niya, <char style="wj">“Neuru ja-Israel adier, maonge miganga moro amora kuome.”</char><verse eid="JHN 1:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48"/>Nathaniel nopenje niya, “Ingʼeya nade?”</para>
  <para style="p" vid="JHN 1:48">Yesu nodwoke niya, <char style="wj">“Ne aneni sa ma ne in e tiend ngʼowu, kane pok Filipo oluongi.”</char><verse eid="JHN 1:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49"/>Eka Nathaniel nodwoke niya, “Rabi, in Wuod Nyasaye adier; in Ruodh Israel.”<verse eid="JHN 1:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50"/>Yesu nowachone niya, <char style="wj">“Iyie mana nikech aa wachoni ni nende aneni e tie yiend ngʼowu. To ibiro neno gik madongo mohingo mano.”</char> <verse eid="JHN 1:50"/><verse number="51" style="v" sid="JHN 1:51"/>Eka nomedo wacho niya, <char style="wj">“Awachonu adier ni ubiro neno ka polo oyawore, kendo ka malaike mag Nyasaye idho kendo lor kuom Wuod Dhano.”</char><verse eid="JHN 1:51"/></para>
  <chapter eid="JHN 1"/>
  <chapter number="2" style="c" sid="JHN 2"/>
  <para style="s1">Yesu oloko pi divai</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1"/>Chiengʼ mar adek, arus moro ne nitie Kana, e piny Galili. Min Yesu ne ni kanyo, <verse eid="JHN 2:1"/><verse number="2" style="v" sid="JHN 2:2"/>kendo Yesu gi jopuonjrene bende noluongi e arusno. <verse eid="JHN 2:2"/><verse number="3" style="v" sid="JHN 2:3"/>Kane divai orumo, min Yesu nowachone niya, “Divai mane jogi nigo oserumo.”<verse eid="JHN 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4"/>Yesu nowachone niya, <char style="wj">“Mama, angʼo momiyo idwaro mondo atim ma to sana pok ochopo?”</char><verse eid="JHN 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5"/>Eka min-gi nowachone jotich niya, “Timuru gimoro amora monyisou.”<verse eid="JHN 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6"/>To machiegni kanyo ne nitie degi auchiel mag pi, mane gin kaka degi ma jo-Yahudi ne tiyogo kuom logo e yor pwodhruok, ma moro ka moro ne tingʼo pi madirom depe ariyo kata adek.<verse eid="JHN 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 2:7"/>Yesu nowachone jotich niya, <char style="wj">“Pongʼuru degnigi gi pi”</char>; mine gipongʼogi thich.<verse eid="JHN 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 2:8"/>Eka nonyisogi niya, <char style="wj">“Koro tuomuru pi moko mondo ukaw uter ne jatend budho.”</char></para>
  <para style="p" vid="JHN 2:8">Negitimo kamano, <verse eid="JHN 2:8"/><verse number="9" style="v" sid="JHN 2:9"/>kendo jatend budho nobilo pi mane koro oselokore divai. Ne ok ofwenyo kuma ne ogolee, kata obedo ni jotich mane otuomo pi to nongʼeyo. Eka noluongo wuon kisera tenge, <verse eid="JHN 2:9"/><verse number="10" style="v" sid="JHN 2:10"/>kendo nowachone niya, “Ji mangʼeny kuongo kelo divai maber eka bangʼe gikelo divai maboth ka welo osemetho momer to in to ne ikano divai maber mogik nyaka sani.”<verse eid="JHN 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11"/>Ranyisi mar hono mokwongoni Yesu notimo e dala Kana e piny Galili. Nonyiso duongʼne kuom timne, kendo jopuonjrene noyie kuome.<verse eid="JHN 2:11"/></para>
  <para style="s1">Yesu oriembo jo-ohala e hekalu</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12"/>Bangʼ mano nodhi Kapernaum kaachiel gi min-gi gi owetene kod jopuonjrene. Negibet kuno kuom ndalo manok.<verse eid="JHN 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13"/>Ka kinde mag Pasaka mar jo-Yahudi ne chiegni chopo, Yesu nodhi Jerusalem. <verse eid="JHN 2:13"/><verse number="14" style="v" sid="JHN 2:14"/>To ei agola mag hekalu, noyudo ka ji hono dhok gi rombe kod akuche, kendo jomoko to nobet olworo mesni ka giwilo pesa. <verse eid="JHN 2:14"/><verse number="15" style="v" sid="JHN 2:15"/>Omiyo noloso del gi piende molir olir, kendo noriembo ji duto oko ei hekalu, kod rombe gi dhok bende. Nokeyo pesa mag jowil pesa, kendo noloko mesnigi ataro. <verse eid="JHN 2:15"/><verse number="16" style="v" sid="JHN 2:16"/>Johala mag akuche to nowachonegi niya, <char style="wj">“Goluru gigi oko ka! Ngʼa monyisou mondo ulok od Wuora chiro!”</char> <verse eid="JHN 2:16"/><verse number="17" style="v" sid="JHN 2:17"/>Jopuonjrene noparo gima nondiki niya, “Hera matut ma aherogo odi tieka.”<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 69:9">Zab 69:9</ref></char></char></note><verse eid="JHN 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18"/>Eka jo-Yahudi nowachone niya, “Ranyisi mar hono mane minyalo nyisowa mondo osir teko mitimogo gigi?”<verse eid="JHN 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19"/>Yesu nodwokogi niya, <char style="wj">“Mukuru hekaluni, to abiro gere kendo bangʼ ndalo adek.”</char><verse eid="JHN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20"/>Jo-Yahudi nodwoke niya, “Gero hekaluni osekawo higni piero angʼwen gauchiel, to in to ere kaka inyalo gere gi ndalo adek?” <verse eid="JHN 2:20"/><verse number="21" style="v" sid="JHN 2:21"/>To hekalu mane owuoyo kuome ne en ringre. <verse eid="JHN 2:21"/><verse number="22" style="v" sid="JHN 2:22"/>Bangʼ kane osechier oa kuom joma otho, jopuonjrene noparo gima nowachono. Omiyo ne giyie kuom Ndiko kod weche mane Yesu osewacho.<verse eid="JHN 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23"/>Kane pod en Jerusalem e Sap Pasaka, ji mangʼeny noneno ranyisi mag honni mane otimo mine giyie kuom nyinge. <verse eid="JHN 2:23"/><verse number="24" style="v" sid="JHN 2:24"/>To Yesu ne ok ochiwore e lwetgi, nimar nongʼeyo pach ji duto. <verse eid="JHN 2:24"/><verse number="25" style="v" sid="JHN 2:25"/>Ne ok odwar mondo ngʼato onyise wach moro kuom dhano wadgi nimar nongʼeyo gik manie chuny dhano.<verse eid="JHN 2:25"/></para>
  <chapter eid="JHN 2"/>
  <chapter number="3" style="c" sid="JHN 3"/>
  <para style="s1">Yesu owuoyo gi Nikodemo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1"/>Ne nitie ngʼat moro ma ja-Farisai ma nyinge Nikodemo, ne en achiel kuom jobuch jo-Yahudi. <verse eid="JHN 3:1"/><verse number="2" style="v" sid="JHN 3:2"/>Nikodemo nobiro ir Yesu gotieno mowachone niya, “Rabi, wangʼeyo ni in japuonj moa ka Nyasaye, nimar onge ngʼama nyalo timo ranyisi mag honni mitimogi ka Nyasaye ok ni kode.”<verse eid="JHN 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3"/>Yesu nodwoke kawacho niya, <char style="wj">“Awachoni adier, ni onge ngʼama nyalo neno pinyruoth Nyasaye ka ok onywole nywol manyien.”</char><verse eid="JHN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4"/>Nikodemo nopenje niya, “Ere kaka inyalo nywol ngʼato kosebedo ngʼama duongʼ? Adier, bende dochak odog ei min mare mi chak nywole kendo!”<verse eid="JHN 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5"/>Yesu nodwoke niya, <char style="wj">“Awachoni adier ni onge ngʼama nyalo donjo e pinyruoth Nyasaye ka ok onywole gi pi kod Roho Maler.</char> <verse eid="JHN 3:5"/><verse number="6" style="v" sid="JHN 3:6"/><char style="wj">Ringruok nywolo mana ringruok, to Roho nywolo roho.</char> <verse eid="JHN 3:6"/><verse number="7" style="v" sid="JHN 3:7"/><char style="wj">Ok onego ibwogi kuom gima awacho ni, ‘Nyaka nywoli nywol manyien.’</char> <verse eid="JHN 3:7"/><verse number="8" style="v" sid="JHN 3:8"/><char style="wj">Yamo futo kochomo kuma ohero, kendo inyalo winje, to ok inyal nyiso kuma oaye kata kuma odhiye. Mano bende e gima timore ni ngʼato ka ngʼato monywol kuom Roho.”</char><verse eid="JHN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9"/>Nikodemo nopenje niya, “Gigo nyalo timore kamano nade?”<verse eid="JHN 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10"/>Yesu nodwoke niya, <char style="wj">“Ere kaka ok iwinj tiend wechegi, to in japuonj jo-Israel?</char> <verse eid="JHN 3:10"/><verse number="11" style="v" sid="JHN 3:11"/><char style="wj">Anyisi adier ni wawuoyo kuom gik mwangʼeyo, kendo watimo neno kuom gik mwaseneno; to un, to pod utamoru rwako neno marwa.</char> <verse eid="JHN 3:11"/><verse number="12" style="v" sid="JHN 3:12"/><char style="wj">Asewuoyo kodu mana kuom gik manie pinyni, to utamoru yie; koro ubiro yie nade ka awuoyo kuom gik manie polo?</char> <verse eid="JHN 3:12"/><verse number="13" style="v" sid="JHN 3:13"/><char style="wj">Onge ngʼato angʼata mosedhi e polo makmana Jal mane olor oa e polo, ma en Wuod Dhano.</char> <verse eid="JHN 3:13"/><verse number="14" style="v" sid="JHN 3:14"/><char style="wj">Mana kaka Musa nochungo thuol e thim, e kaka Wuod Dhano bende ibiro chungo,</char> <verse eid="JHN 3:14"/><verse number="15" style="v" sid="JHN 3:15"/><char style="wj">mondo ngʼato ka ngʼato moyie kuome obed gi ngima mochwere.</char><verse eid="JHN 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16"/>
    <char style="wj">“Nikech Nyasaye nohero piny ahinya, omiyo nochiwo Wuode ma miderma, mondo ngʼato angʼata moyie kuome kik lal, to obed gi ngima mochwere.</char> <verse eid="JHN 3:16"/><verse number="17" style="v" sid="JHN 3:17"/><char style="wj">Nimar Nyasaye ne ok ooro Wuode e piny mondo ongʼad ne piny bura, to noore mondo ores piny.</char> <verse eid="JHN 3:17"/><verse number="18" style="v" sid="JHN 3:18"/><char style="wj">Ngʼato angʼata moyie kuome ok nobed gi bura. To ngʼat ma ok oyie kuome bura oseloyo, nikech pok oyie kuom nying Wuowi ma miderma mar Nyasaye.</char> <verse eid="JHN 3:18"/><verse number="19" style="v" sid="JHN 3:19"/><char style="wj">Ma e gima bura osengʼado: Ler osebiro e piny, to ji nohero mudho moloyo ler, nikech timbegi ne richo.</char> <verse eid="JHN 3:19"/><verse number="20" style="v" sid="JHN 3:20"/><char style="wj">Ngʼato ka ngʼato matimo richo ok dwar ler, kendo ok odwar donjo ei ler, nikech oluor ni dipo ka timbene ongʼere.</char> <verse eid="JHN 3:20"/><verse number="21" style="v" sid="JHN 3:21"/><char style="wj">To ngʼato angʼata mawuotho e adiera donjo e ler, mondo onere maler ni gik motimo duto gin gik ma Nyasaye oyiego.”</char><verse eid="JHN 3:21"/></para>
  <para style="s1">Johana ja-Batiso otimo neno kuom Yesu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22"/>Bangʼ mano, Yesu gi jopuonjrene nodhi e gwenge mag piny Judea, kendo nokawo kinde mogwarore kodgi kuno, kobatiso ji. <verse eid="JHN 3:22"/><verse number="23" style="v" sid="JHN 3:23"/>To Johana bende ne batiso ji Ainon machiegni gi Salim, nikech pi ne ngʼeny kanyo, kendo ji nosiko ka biro ire mondo obatisgi. <verse eid="JHN 3:23"/><verse number="24" style="v" sid="JHN 3:24"/>(Mano notimore ka Johana ne pok oter e od twech.) <verse eid="JHN 3:24"/><verse number="25" style="v" sid="JHN 3:25"/>Mino wach nochakore e kind jopuonjre Johana moko gi ja-Yahudi moro kuom wach mar pwodhruok. <verse eid="JHN 3:25"/><verse number="26" style="v" sid="JHN 3:26"/>Negibiro ir Johana mi giwachone niya, “Rabi, jal manyocha ni kodi loka Jordan, ma en Jal mane iwuoyo kuome cha, parie ni en bende tinde obatiso ji, kendo ji duto dhi ire.”<verse eid="JHN 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27"/>Johana nodwokogi niya, “Onge gima ngʼato nyalo yudo makmana mano momiye koa e polo. <verse eid="JHN 3:27"/><verse number="28" style="v" sid="JHN 3:28"/>Un uwegi unyalo timo neno ni ne anyisou ni, ‘An ok an Kristo, to an ngʼat moor mondo otel nyime.’ <verse eid="JHN 3:28"/><verse number="29" style="v" sid="JHN 3:29"/>Miaha en mar wuon kisera. Jachungʼ mar wuon kisera nyaka chik ite ne wuon kisera kendo winje; opongʼ gi mor kowinjo dwond wuon kisera kawuoyo. An ema an gi mor machal kamano, kendo mornano koro oromo chuth. <verse eid="JHN 3:29"/><verse number="30" style="v" sid="JHN 3:30"/>En ema nyaka omed yudo duongʼ moloyo, to an nyaka adog piny.<verse eid="JHN 3:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31"/>“Jal moa e polo malo duongʼ moloyo gik moko duto, to ngʼat monywol e piny en mar piny, kendo owuoyo kaka ngʼama onywol e piny. Jal moa e polo duongʼ moloyo gik moko duto. <verse eid="JHN 3:31"/><verse number="32" style="v" sid="JHN 3:32"/>Otimo neno kuom gik moseneno kendo owinjo, to onge ngʼama orwako nende. <verse eid="JHN 3:32"/><verse number="33" style="v" sid="JHN 3:33"/>Ngʼat moyie ni wechene gin adier, biro ngʼeyo malongʼo ni Nyasaye en ja-adiera. <verse eid="JHN 3:33"/><verse number="34" style="v" sid="JHN 3:34"/>Nimar Jal ma Nyasaye oseoro wacho weche Nyasaye, nikech Nyasaye chiwo Rohone mogundho ma ok ongʼwonyo lwete. <verse eid="JHN 3:34"/><verse number="35" style="v" sid="JHN 3:35"/>Wuoro ohero Wuowi, kendo oseketo gik moko duto e lwete. <verse eid="JHN 3:35"/><verse number="36" style="v" sid="JHN 3:36"/>Ngʼato moyie kuom Wuowi nigi ngima mochwere, to ngʼat modagi Wuowi ok none ngimano, nimar mirimb Nyasaye osiko kuome.”<verse eid="JHN 3:36"/></para>
  <chapter eid="JHN 3"/>
  <chapter number="4" style="c" sid="JHN 4"/>
  <para style="s1">Yesu owuoyo gi chi Samaria</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1"/>Jo-Farisai nowinjo ni joma Yesu ne oseloko obedo jopuonjre, kendo obatiso ne ngʼeny moloyo jopuonjre Johana, <verse eid="JHN 4:1"/><verse number="2" style="v" sid="JHN 4:2"/>kata obedo ni Yesu owuon ne ok batiso ji, to jopuonjrene ema ne timo kamano. <verse eid="JHN 4:2"/><verse number="3" style="v" sid="JHN 4:3"/>Kane Ruoth owinjo wachni, noa Judea mochako odok Galili.<verse eid="JHN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 4:4"/>To nochune ni nyaka okadh e piny Samaria. <verse eid="JHN 4:4"/><verse number="5" style="v" sid="JHN 4:5"/>Kuom mano, nochopo e dala moro e piny Samaria miluongo ni Sukar, mane ni machiegni gi puodho mane Jakobo omiyo Josef wuode. <verse eid="JHN 4:5"/><verse number="6" style="v" sid="JHN 4:6"/>Soko Jakobo ne ni kanyo, kendo Yesu ne koro ool gi wuoth, omiyo nobet piny e dir sokono. Ne en kar sa auchiel mar odiechiengʼ.<verse eid="JHN 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7"/>E sechego chi Samaria moro nobiro umbo pi, mi Yesu nowachone niya, <char style="wj">“Yie imiya pi amodhi.”</char> <verse eid="JHN 4:7"/><verse number="8" style="v" sid="JHN 4:8"/>(Mano noyudo ka jopuonjrene osedhi Sukar mondo ongʼiew chiemo.)<verse eid="JHN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9"/>Chi Samaria-no nowachone niya, “In ja-Yahudi, an to an chi Samaria. Ere kaka ikwaya pi modho?” (Donge ingʼeyo ni jo-Yahudi ok winjre gi jo-Samaria.)<verse eid="JHN 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10"/>Yesu nodwoke niya, <char style="wj">“Ka dine ingʼe mich Nyasaye kendo ingʼe jal makwayi pi mondo omodhi, to dikwaye pi momiyi pi mar ngima.”</char><verse eid="JHN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11"/>Dhakono nowachone niya, “Jaduongʼ, ionge gi gima inyalo tuomogo pi, kendo sokoni bende tut. Pi ngimano to inyalo yud kanye? <verse eid="JHN 4:11"/><verse number="12" style="v" sid="JHN 4:12"/>Iparo ni iduongʼ moloyo Jakobo kwarwa mane omiyowa sokoni, kendo nomodho pige en owuon kaachiel gi yawuote, gi jambe kod dhoge?”<verse eid="JHN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13"/>Yesu nodwoke niya, <char style="wj">“Ngʼato ka ngʼato mamodho pigni riyo biro chako loye,</char> <verse eid="JHN 4:13"/><verse number="14" style="v" sid="JHN 4:14"/><char style="wj">to ngʼato angʼata momodho pi mamiye ok nochak owinj riyo. Chutho, pi ma anamiye nodok soko mar pi e iye, mosiko ka bubni nyaka chop e ngima mochwere.”</char><verse eid="JHN 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15"/>Dhakono nowachone niya, “Jaduongʼ, yie imiyae pigno mondo riyo kik chak loya, kendo kik asik ka achandora gi biro ka pile pile mondo aom pi.”<verse eid="JHN 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16"/>Yesu nodwoke niya, <char style="wj">“Dhi iluong chwori eka iduogi.”</char><verse eid="JHN 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17"/>Nodwoke niya, “Aonge gi dichwo.”</para>
  <para style="p" vid="JHN 4:17">Yesu nowachone niya, <char style="wj">“In kare kuom wacho ni ionge gi dichwo.</char> <verse eid="JHN 4:17"/><verse number="18" style="v" sid="JHN 4:18"/><char style="wj">Adiera en ni isebedo gi chwo abich, kendo ngʼat makoro in-go sani bende ok chwori. Gima isewachono en adier.”</char><verse eid="JHN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19"/>Dhakono nowachone niya, “Jaduongʼ, nenorena ni in janabi. <verse eid="JHN 4:19"/><verse number="20" style="v" sid="JHN 4:20"/>Kwerewa ne lemo ewi godni, to un jo-Yahudi to uwacho ka uramo ni Jerusalem ema nyaka walamie.”<verse eid="JHN 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21"/>Yesu nodwoke niya, <char style="wj">“Nyarwa, yie koda; ndalo biro ma ok unulam Wuoro ewi godni kata ei Jerusalem.</char> <verse eid="JHN 4:21"/><verse number="22" style="v" sid="JHN 4:22"/><char style="wj">Un jo-Samaria ulamo gima ukia, nimar warruok aa kuom jo-Yahudi.</char> <verse eid="JHN 4:22"/><verse number="23" style="v" sid="JHN 4:23"/><char style="wj">Kata kamano kinde biro, kendo osechopo, ma joma lemo gadier nolam Wuoro e yo ma Roho dwaro kendo gadiera, joma lamo kamano ema Wuoro dwaro.</char> <verse eid="JHN 4:23"/><verse number="24" style="v" sid="JHN 4:24"/><char style="wj">Nyasaye en Roho, omiyo joma lame nyaka lame e yo ma Roho dwaro kendo gadiera.”</char><verse eid="JHN 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25"/>Dhakono nowacho niya, “Angʼeyo ni in Mesia” (miluongo ni Kristo) “mane onego bi kendo ka obiro, to enonyiswa tiend weche duto.”<verse eid="JHN 4:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26"/>Eka Yesu nonyise ratiro niya, <char style="wj">“An ma awuoyo kodini An e En.”</char><verse eid="JHN 4:26"/></para>
  <para style="s1">Jopuonjre odwogo ir Yesu</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27"/>E sechego jopuonjrene noduogo, kendo ne giwuoro kane giyude kowuoyo gi dhako. To onge ngʼama nopenjo niya, “Angʼo midwaro kuom dhakoni?” kata niya, “Iwuoyo kode nangʼo?”<verse eid="JHN 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28"/>Eka dhakono noweyo dapige kanyo, kendo nowuok odok dala mi owachone ji niya, <verse eid="JHN 4:28"/><verse number="29" style="v" sid="JHN 4:29"/>“Biuru uneye ngʼama osenyisa gik moko duto ma asetimo. Donge jalni dibed Kristo?” <verse eid="JHN 4:29"/><verse number="30" style="v" sid="JHN 4:30"/>Joma odak e dalano duto nowuok kadhi ire.<verse eid="JHN 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31"/>To e sechego jopuonjrene nosiko kajiwe niya, “Rabi, chamie gimoro.”<verse eid="JHN 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32"/>To nowachonegi niya, <char style="wj">“An gi chiemo ma achamo ma ukia gimoro amora kuome.”</char><verse eid="JHN 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33"/>Eka jopuonjrene nowacho e kindgi giwegi niya, “Dibed ni ngʼato osekelone chiemo?”<verse eid="JHN 4:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34"/>Yesu nowachonegi niya, <char style="wj">“Chiemba en timo dwach Jal mane oora kendo tieko tichne.</char> <verse eid="JHN 4:34"/><verse number="35" style="v" sid="JHN 4:35"/><char style="wj">Donge uwacho ni, ‘Odongʼ dweche angʼwen to ndalo keyo chopo’? Awachonu ni utingʼ wengeu malo urang puothe! Gisechiek giromo keyo.</char> <verse eid="JHN 4:35"/><verse number="36" style="v" sid="JHN 4:36"/><char style="wj">Kata mana sani ngʼat ma keyo ichulo pokne, kendo ochoko olembe mochiek ne ngima mochwere, mondo omi jachwoyo, kaachiel gi jakeyo, obed mamor kanyakla.</char> <verse eid="JHN 4:36"/><verse number="37" style="v" sid="JHN 4:37"/><char style="wj">Mana kaka ngero mawacho ni, ‘Ngʼato achiel chwoyo, to ngʼato machielo keyo’ en adier.</char> <verse eid="JHN 4:37"/><verse number="38" style="v" sid="JHN 4:38"/><char style="wj">Ne aorou mondo uka gima ne ok utiyone. Jomoko nono osetiyo tich matek moloyo, to un useyudo konyruok kuom tichgi matek.”</char><verse eid="JHN 4:38"/></para>
  <para style="s1">Jo-Samaria mangʼeny oyie kuom Yesu</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39"/>Jo-Samaria mangʼeny moa e dalano noyie kuom Yesu nikech neno mane dhakono otimonigi kowacho niya, “Ne onyisa gik moko duto ma asetimo.” <verse eid="JHN 4:39"/><verse number="40" style="v" sid="JHN 4:40"/>Kuom mano, ka jo-Samaria nobiro ir Yesu, negisaye mondo omed bet kodgi, mi nobet kodgi kuom ndalo ariyo. <verse eid="JHN 4:40"/><verse number="41" style="v" sid="JHN 4:41"/>Omiyo ji mangʼeny moko bende noyie kuom Yesu nikech weche mane owachonegi.<verse eid="JHN 4:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 4:42"/>Negiwachone dhakono niya, “Koro wayie, ok nikech weche mane iwacho kende; to wasewinje gi itwa wawegi, kendo wangʼeyo gadier ni jalni en Jawar mar piny.”<verse eid="JHN 4:42"/></para>
  <para style="s1">Yesu ochango wuod jatelo moro</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43"/>Bangʼ ndalo ariyogo, nowuok modhi Galili. <verse eid="JHN 4:43"/><verse number="44" style="v" sid="JHN 4:44"/>(Mano noyudo ka Yesu owuon nosewacho ni janabi ok mi duongʼ e pinygi owuon.) <verse eid="JHN 4:44"/><verse number="45" style="v" sid="JHN 4:45"/>Kane ochopo Galili, jo-Galili norwake. Ne giseneno gik moko duto mane osetimo Jerusalem chiengʼ Sap Pasaka, nimar gin bende ne gin kuno.<verse eid="JHN 4:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46"/>Nochako olimo dala mar Kana, manie piny Galili, kama ne oloke pi divai. To ne nitie jatelo moro ma wuode ne tuo Kapernaum. <verse eid="JHN 4:46"/><verse number="47" style="v" sid="JHN 4:47"/>Kane ngʼatni owinjo ni Yesu osechopo Galili koa Judea, nodhi ire mosaye mondo odhi ochang wuode mane chiegni tho.<verse eid="JHN 4:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48"/>Yesu nowachone niya, <char style="wj">“Angʼeyo ni ka ok uneno honni gi ranyisi, to ok ubi yie.”</char><verse eid="JHN 4:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49"/>Jatelono nowachone niya, “Jaduongʼ, yie idhi koda kapok nyathina otho.”<verse eid="JHN 4:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50"/>Yesu nodwoke niya, <char style="wj">“Dhiyo, wuodi dhi bedo mangima.”</char></para>
  <para style="p" vid="JHN 4:50">Ngʼatno norwako wach mane Yesu owachoneno, mi noa odhi. <verse eid="JHN 4:50"/><verse number="51" style="v" sid="JHN 4:51"/>Kane oyudo pod en e yo odok dalane, jotichne noromone gi wach ni wuode koro ngima. <verse eid="JHN 4:51"/><verse number="52" style="v" sid="JHN 4:52"/>Kane ononogi mondo ongʼe ni en sa mane mane wuode ochangoe, negiwachone niya, “Midhusi nyoro oweye kar sa abiriyo.”<verse eid="JHN 4:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 4:53"/>Eka wuon nongʼeyo ni mano e sa nogono mane Yesu owachone niya, <char style="wj">“Wuodi dhi bedo mangima.”</char> Kuom mano, en kaachiel gi joode duto ne giyie kuom Yesu.<verse eid="JHN 4:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54"/>Mano e hono mar ariyo mane Yesu otimo, ka nodonjo Galili koa Judea.<verse eid="JHN 4:54"/></para>
  <chapter eid="JHN 4"/>
  <chapter number="5" style="c" sid="JHN 5"/>
  <para style="s1">Yesu ochango ngʼat matuo Bethesda</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1"/>Bangʼ kinde moko, Yesu nodhi Jerusalem e Sap jo-Yahudi. <verse eid="JHN 5:1"/><verse number="2" style="v" sid="JHN 5:2"/>E Jerusalem kanyo, but ranga Rombe, miluongo ni Bethesda gi dho jo-Hibrania, ne nitiere yawo moro ma nigi raidhi abich midonjogo. <verse eid="JHN 5:2"/><verse number="3" style="v" sid="JHN 5:3"/>Kanyo ji mathoth man-gi tuoche mopogore opogore kaka muofni, rongʼonde, kod joma nigi athany nohero riyo kanyo [kendo negirito mondo pi otugre. <verse eid="JHN 5:3"/><verse number="4" style="v" sid="JHN 5:4"/>Kinde ka kinde malaika mar Ruoth ne lor mondo otug pi. Ngʼama nokwongo donjo e pigno sa ma otugoreno ne chango kuom kit tuo moro amora mane en-go].<note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="ft" closed="false">Loko moko machon mag Muma onge gi giko mar <char style="xt"><ref loc="JHN 5:3">5:3</ref></char> kod <char style="xt"><ref loc="JHN 5:4">5:4</ref></char> duto.</char></note> <verse eid="JHN 5:4"/><verse number="5" style="v" sid="JHN 5:5"/>To ne nitie ngʼato kanyo mane osebedo gi midekre kuom higni piero adek gaboro. <verse eid="JHN 5:5"/><verse number="6" style="v" sid="JHN 5:6"/>Kane Yesu onene konindo kanyo, kendo kane onyise ni osebedo kochal kamano kuom kinde marabora, nopenje niya, <char style="wj">“Bende idwaro ni ochangi?”</char><verse eid="JHN 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7"/>Ngʼatno nodwoke niya, “Jaduongʼ, aonge gi ngʼama nyalo konya donjo ei yawo sa ma pi otugore. Kinde ka kinde ma atemo ni adonji to ngʼat machielo donjo kuongona.”<verse eid="JHN 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8"/>Yesu nowachone niya, <char style="wj">“Aa malo! Kaw pieni mondo iwuothi.”</char> <verse eid="JHN 5:8"/><verse number="9" style="v" sid="JHN 5:9"/>Gikanyono ngʼatno nochango, kendo nokawo piende mowuotho.</para>
  <para style="p" vid="JHN 5:9">Ma notimore chiengʼ Sabato, <verse eid="JHN 5:9"/><verse number="10" style="v" sid="JHN 5:10"/>omiyo jo-Yahudi nowachone ngʼama nochangino niya, “Kawuono en chiengʼ Sabato, kendo chik ok oyieni tingʼo pieni.”<verse eid="JHN 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11"/>Nodwokogi niya, “Ngʼat ma nochanga ema nowachona ni, ‘Kaw pieni mondo iwuothi.’ ”<verse eid="JHN 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12"/>Omiyo negipenje niya, “Mano to en ngʼama nade manowachoni ni ikaw pieni kendo iwuothi?”<verse eid="JHN 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13"/>To ngʼat mane ochangino ne ok ongʼeyo nying ngʼat mane ochange, nimar noyudo ka Yesu osedonjo ei oganda mane ni kanyo.<verse eid="JHN 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14"/>Bangʼe Yesu noyude e hekalu mowachone niya, <char style="wj">“Winji, koro isedoko mangima. We richo, nono to gimoro marach moloyo biro timoreni.”</char> <verse eid="JHN 5:14"/><verse number="15" style="v" sid="JHN 5:15"/>Ngʼatno noa modhi onyiso jo-Yahudi ni Yesu ema nochange.<verse eid="JHN 5:15"/></para>
  <para style="s1">Ngima miyudo kuom Wuowi</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16"/>Kuom mano, nikech Yesu ne chango ji chiengʼ Sabato, jo-Yahudi nosande. <verse eid="JHN 5:16"/><verse number="17" style="v" sid="JHN 5:17"/>To Yesu nowachonegi niya, <char style="wj">“Wuora osiko katiyo tichne nyaka kawuono, kendo an bende atiyo mana kamano.”</char> <verse eid="JHN 5:17"/><verse number="18" style="v" sid="JHN 5:18"/>Wachni nomiyo jo-Yahudi oramo ni nyaka ginege, nimar negineno ni ok Sabato kende ema noketho, to bende noluongo Nyasaye ni Wuon-gi, manyiso ni ne oketore ni orom gi Nyasaye.<verse eid="JHN 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19"/>Yesu nodwokogi niya, <char style="wj">“Awachonu adier ni, Wuod Dhano ok nyal timo gimoro kende owuon; to onyalo mana timo gima oneno ka Wuoro timo, nikech gimoro amora ma Wuoro timo ema Wuowi bende timo.</char> <verse eid="JHN 5:19"/><verse number="20" style="v" sid="JHN 5:20"/><char style="wj">Nimar Wuoro ohero Wuowi, kendo onyise gik moko duto motimo. Ee, obiro medo nyise nyaka gik madongo moloyo magi mi unuwuor.</char> <verse eid="JHN 5:20"/><verse number="21" style="v" sid="JHN 5:21"/><char style="wj">Mana kaka Wuoro chiero joma otho, kendo miyogi ngima, e kaka Wuowi bende chiwo ngima ne ngʼato angʼata mohero.</char> <verse eid="JHN 5:21"/><verse number="22" style="v" sid="JHN 5:22"/><char style="wj">To bende, Wuoro ok ngʼad bura ne ngʼato, to oseketo teko mar ngʼado bura e lwet Wuowi,</char> <verse eid="JHN 5:22"/><verse number="23" style="v" sid="JHN 5:23"/><char style="wj">mondo ji duto omi Wuowi duongʼ mana kaka gimiyo Wuoro duongʼ. Ngʼat ma ok mi Wuowi duongʼ ok mi Wuoro mane ooro Wuowino duongʼ.</char><verse eid="JHN 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24"/>
    <char style="wj">“Awachonu adier ni ngʼato angʼata mawinjo wachna, kendo moyie kuom Jal mane oora, nigi ngima mochwere, kendo ok bi ngʼadne buch tho; to osengʼado oa e tho modonjo e ngima.</char> <verse eid="JHN 5:24"/><verse number="25" style="v" sid="JHN 5:25"/><char style="wj">Awachonu adier ni ndalo biro, kendo koro osechopo, ma joma otho biro winjo dwond Wuod Nyasaye, kendo joma owinjo dwolno biro doko mangima.</char> <verse eid="JHN 5:25"/><verse number="26" style="v" sid="JHN 5:26"/><char style="wj">Mana kaka Wuoro nigi teko mar miyo ji ngima, e kaka osemiyo Wuowi bende teko mar timo kamano.</char> <verse eid="JHN 5:26"/><verse number="27" style="v" sid="JHN 5:27"/><char style="wj">To bende osemiye teko mondo ongʼad bura, nikech en e Wuod Dhano.</char><verse eid="JHN 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 5:28"/>
    <char style="wj">“Wachni kik bwogu, nimar ndalo biro ma ji duto manie bur nowinj dwonde</char> <verse eid="JHN 5:28"/><verse number="29" style="v" sid="JHN 5:29"/><char style="wj">mi giwuog oko; joma osetimo maber nochier mondo obed mangima, to joma osetimo gik maricho nochier mondo ongʼadnigi buch tho.</char> <verse eid="JHN 5:29"/><verse number="30" style="v" sid="JHN 5:30"/><char style="wj">An onge gima anyalo timo gi tekona awuon, to angʼado bura ne ji mana kaluwore gi gima awinjo, kendo bura ma angʼado nikare, nimar ok atim kamano mondo atim dwarona awuon, to mondo atim dwaro Jal mane oora.</char><verse eid="JHN 5:30"/></para>
  <para style="s1">Weche manyiso ni Yesu en ngʼa</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31"/>
    <char style="wj">“Kapo ni atimo nenda awuon to nenda ok nikare.</char> <verse eid="JHN 5:31"/><verse number="32" style="v" sid="JHN 5:32"/><char style="wj">To nitie ngʼama chielo matimo neno ma chwaka, kendo angʼeyo ni neno motimo kuoma nikare.</char><verse eid="JHN 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 5:33"/>
    <char style="wj">“Ne uoro joote ne Johana kendo osetimo neno kuom adiera.</char> <verse eid="JHN 5:33"/><verse number="34" style="v" sid="JHN 5:34"/><char style="wj">Ok awach kamano nikech ayie gi nend dhano, to awacho kamano mondo uyud warruok.</char> <verse eid="JHN 5:34"/><verse number="35" style="v" sid="JHN 5:35"/><char style="wj">Johana ne en taya maliel makelo ler, kendo kuom kinde moko nuyie mondo omiu lerno.</char><verse eid="JHN 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36"/>
    <char style="wj">“To an gi neno maduongʼ moloyo mar Johana, nimar tich mane Wuora omiya mondo achopi, kendo makoro atimo sani-ni, nyiso ni Wuora ema noora.</char> <verse eid="JHN 5:36"/><verse number="37" style="v" sid="JHN 5:37"/><char style="wj">Wuoro moseorano osetimo neno kuoma en owuon. Pok uwinjo dwonde nyaka nene kendo pok uneno kite.</char> <verse eid="JHN 5:37"/><verse number="38" style="v" sid="JHN 5:38"/><char style="wj">Wachne bende onge eiu, nimar udagi yie kuom Jal mane ooro.</char> <verse eid="JHN 5:38"/><verse number="39" style="v" sid="JHN 5:39"/><char style="wj">Uketo chunyu kuom nono Muma nikech uparo ni unyalo yudo ngima mochwere kuomgi. Muma ema timo neno kuoma,</char> <verse eid="JHN 5:39"/><verse number="40" style="v" sid="JHN 5:40"/><char style="wj">to kata kamano utamoru biro ira mondo uyud ngima.</char><verse eid="JHN 5:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41"/>
    <char style="wj">“An ok adwar mondo dhano omiya duongʼ;</char> <verse eid="JHN 5:41"/><verse number="42" style="v" sid="JHN 5:42"/><char style="wj">nikech angʼeyou maber ni uonge gihera mar Nyasaye e chunyu.</char> <verse eid="JHN 5:42"/><verse number="43" style="v" sid="JHN 5:43"/><char style="wj">An asebiro e nying Wuora, to utamoru rwaka; to ka ngʼato machielo nobi e nyinge owuon to ubiro rwake arwaka.</char> <verse eid="JHN 5:43"/><verse number="44" style="v" sid="JHN 5:44"/><char style="wj">Ere kaka unyalo yie ka urwako pak ma joweteu pakougo, to ok utem matek mondo uyud pak moa kuom Nyasaye ma achiel kende?</char><verse eid="JHN 5:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45"/>
    <char style="wj">“Kik upar ni abiro donjonu e nyim Wuoro. Ngʼat madonjonu en Musa, ma useketo genou kuome.</char> <verse eid="JHN 5:45"/><verse number="46" style="v" sid="JHN 5:46"/><char style="wj">To ka dine bed ni uyie kuom Musa, to An bende dine uyie kuoma, nimar nondiko kuoma.</char> <verse eid="JHN 5:46"/><verse number="47" style="v" sid="JHN 5:47"/><char style="wj">To kaka ok uyie kuom gik mane ondiko, ere kaka ubiro yie kuom gik ma awacho?”</char><verse eid="JHN 5:47"/></para>
  <chapter eid="JHN 5"/>
  <chapter number="6" style="c" sid="JHN 6"/>
  <para style="s1">Yesu opidho ji alufu abich</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1"/>Bangʼ kinde moko, Yesu nodhi nyaka loka machielo mar Nam Galili (tiende ni Nam Tiberia), <verse eid="JHN 6:1"/><verse number="2" style="v" sid="JHN 6:2"/>kendo oganda maduongʼ noluwe nikech ne giseneno honni mane osetimo kochango joma tuo. <verse eid="JHN 6:2"/><verse number="3" style="v" sid="JHN 6:3"/>Eka Yesu nodhi e bath got kamoro mi nobet piny kanyo gi jopuonjrene. <verse eid="JHN 6:3"/><verse number="4" style="v" sid="JHN 6:4"/>Sap Pasaka mar jo-Yahudi koro nokayo machiegni.<verse eid="JHN 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 6:5"/>Kane Yesu otingʼo wangʼe noneno oganda maduongʼ kabiro ire, mowachone Filipo niya, <char style="wj">“Ere kuma wanyalo ngʼiewe makati ni jogi mondo gicham?”</char> <verse eid="JHN 6:5"/><verse number="6" style="v" sid="JHN 6:6"/>Nopenje kamano mana mondo otemego nimar nongʼeyo gima nobiro timo.<verse eid="JHN 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7"/>Filipo nodwoke niya, “Kata chudo mar ngʼato mar dweche aboro ok dingʼiewgo makati moromo, ma ngʼato ka ngʼato kuom jogi duto nyalo yudo kata matin!”<verse eid="JHN 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8"/>Japuonjrene machielo, ma nyinge Andrea, mane en owadgi Simon Petro nowachone niya, <verse eid="JHN 6:8"/><verse number="9" style="v" sid="JHN 6:9"/>“Wuowi moro eri nika man-gi makati matindo abich motedi gi shairi, kod rech matindo ariyo, to magi dikony angʼo kuom pidho oganda machal kama?”<verse eid="JHN 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10"/>Yesu nowacho niya, <char style="wj">“Nyisuru ji obed piny.”</char> Kanyo ne nitie lum mangʼeny, omiyo ji nobedo piny (ka joma chwo kuomgi noromo ji alufu abich). <verse eid="JHN 6:10"/><verse number="11" style="v" sid="JHN 6:11"/>Eka Yesu nokawo makatigo mi nogwedhogi, bangʼe opogone joma nobedo piny, kendo ngʼato ka ngʼato nochiemo kaka odwaro. Kamano bende e kaka notimo gi rechgo.<verse eid="JHN 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 6:12"/>Kane gisechiemo giduto mi giyiengʼ, nowachone jopuonjrene niya, <char style="wj">“Chokuru ngʼinjo duto ma ji ochamo oweyo. Kik uwe gimoro dhi nono.”</char> <verse eid="JHN 6:12"/><verse number="13" style="v" sid="JHN 6:13"/>Omiyo negichokogi, kendo negipongʼo okepe apar gariyo gi ngʼinjo ma noa e makati matindo abich mane olos gi shairi, mane joma nosechiemo oweyo.<verse eid="JHN 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14"/>Kane ji oneno tim hono ma Yesu notimono, negichako wacho niya, “Kuom adier, ma e janabi mane onego bi e piny.” <verse eid="JHN 6:14"/><verse number="15" style="v" sid="JHN 6:15"/>To kaka Yesu nongʼeyo ni negichano biro make mondo gikete ruoth githuon, noa kanyo kendo nodhi ewi got moro kar kende.<verse eid="JHN 6:15"/></para>
  <para style="s1">Yesu owuotho ewi pi</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16"/>Kane ochopo odhiambo, jopuonjre nodhi nyaka e dho nam, <verse eid="JHN 6:16"/><verse number="17" style="v" sid="JHN 6:17"/>kuma negidonjo ei yie, kendo ne gisiayo yieno mi gingʼado nam nyaka Kapernaum. Sechego piny koro noselil, to Yesu ne pok obiro irgi. <verse eid="JHN 6:17"/><verse number="18" style="v" sid="JHN 6:18"/>Yamb ahiti ne kudho, kendo pi nam ne gingore matek. <verse eid="JHN 6:18"/><verse number="19" style="v" sid="JHN 6:19"/>Kane koro gisekiewo yie kama nyalo romo kilomita abich kata auchiel; negineno Yesu kawuotho ewi pi kochiko irgi; mi luoro nomakogi. <verse eid="JHN 6:19"/><verse number="20" style="v" sid="JHN 6:20"/>Yesu nowachonegi niya, <char style="wj">“Kik uluor, en mana An.”</char> <verse eid="JHN 6:20"/><verse number="21" style="v" sid="JHN 6:21"/>Kane osewacho kamano eka ne gikwaye mondo odonj irgi ei yie. Kendo gikanyono yie nogowo e dho nam kama negidhiye.<verse eid="JHN 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22"/>Kinyne, oganda mane ni kode loka nam noyudo ni yie achiel kende ema ne ni kanyo, kendo ni Yesu ne ok odonjo ei yieno gi jopuonjrene, to ni negidhi adhiya kendgi. <verse eid="JHN 6:22"/><verse number="23" style="v" sid="JHN 6:23"/>Eka yiedhi moko moa Tiberia nogowo but kama ne ji ochame makati, mane Ruoth Yesu ogwedho. <verse eid="JHN 6:23"/><verse number="24" style="v" sid="JHN 6:24"/>Kane ogandano ofwenyo ni Yesu gi jopuonjrene ne onge kanyo, negidonjo ei yiedhigo, mi gidhi Kapernaum, mondo gimany Yesu kuno.<verse eid="JHN 6:24"/></para>
  <para style="s1">Yesu e makati mar ngima</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25"/>Kane giyude loka nam komachielo, negipenje niya, “Rabi, ne ichopo sa adi?”<verse eid="JHN 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26"/>Yesu nodwokogi niya, <char style="wj">“Awachonu adier, ni umanya ok nikech nyoro uneno honni, to mana nikech makati manyoro uchamo ma uyiengʼ.</char> <verse eid="JHN 6:26"/><verse number="27" style="v" sid="JHN 6:27"/><char style="wj">Weuru tiyo ni chiemo marumo, to tiuru ni chiemo masiko nyaka chop uyud ngima mochwere, ma Wuod Dhano biro miyou. Nyasaye Wuoro oseketo kido mare kuome manyiso ni oyie kode.”</char><verse eid="JHN 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28"/>Eka negipenje niya, “Angʼo mowinjore watim eka wati tije ma Nyasaye dwaro?”<verse eid="JHN 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29"/>Yesu nodwokogi niya, <char style="wj">“Tich ma Nyasaye dwaro en ni mondo uyie kuom Jal moseoro.”</char><verse eid="JHN 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30"/>Kuom mano negipenje niya, “Kara en hono mane ma idwaro timo mondo wane eka wayie kuomi? Angʼo mibiro timonwa? <verse eid="JHN 6:30"/><verse number="31" style="v" sid="JHN 6:31"/>Kwerewa nochamo manna e thim; mana kaka ondiki ni, ‘Nomiyogi chiemo moa e polo mondo gicham.’<note caller="+" style="f"><char style="fr" closed="false">6:31 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 16:4">Wuo 16:4</ref>; <ref loc="NEH 9:15">Neh 9:15</ref>; <ref loc="PSA 78:24">Zab 78:24</ref>,<ref loc="PSA 78:25">25</ref></char></char></note>”<verse eid="JHN 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32"/>Yesu nowachonegi niya, <char style="wj">“Awachonu adier ni Musa ok ema nomiyou makati moa e polo, to Wuora ema nomiyou makati mar adier moa e polo.</char> <verse eid="JHN 6:32"/><verse number="33" style="v" sid="JHN 6:33"/><char style="wj">Nimar makati ma Nyasaye chiwo en Jal malor koa e polo kendo ochiwo ngimane ni piny.”</char><verse eid="JHN 6:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34"/>Negiwachone niya, “Jaduongʼ, miwae makati pile pile kochakore kawuono.”<verse eid="JHN 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35"/>Eka Yesu nowachonegi niya, <char style="wj">“An e makati mar ngima. Ngʼama obiro ira kech ok noka, kendo ngʼama oyie kuoma riyo ok nolo ngangʼ.</char> <verse eid="JHN 6:35"/><verse number="36" style="v" sid="JHN 6:36"/><char style="wj">To mana kaka nyocha anyisou, usenena to pod udagi yie kuoma.</char> <verse eid="JHN 6:36"/><verse number="37" style="v" sid="JHN 6:37"/><char style="wj">Joma Wuoro omiya duto biro ira, kendo ngʼato angʼata mobiro ira ok anariembi ngangʼ.</char> <verse eid="JHN 6:37"/><verse number="38" style="v" sid="JHN 6:38"/><char style="wj">Nimar asebiro e piny ka aa e polo, ok ni mondo atim dwacha, to mondo atim dwach Jal mane oora.</char> <verse eid="JHN 6:38"/><verse number="39" style="v" sid="JHN 6:39"/><char style="wj">Dwach Jal mane oora en ni kik awit kata achiel kuom ji duto mosemiya, to ni mondo achiergi chiengʼ giko.</char> <verse eid="JHN 6:39"/><verse number="40" style="v" sid="JHN 6:40"/><char style="wj">Adier, Wuora dwaro ni mondo ji duto mogeno kuom Wuowi, kendo moyie kuome mondo obed gi ngima mochwere, kendo ochiergi chiengʼ giko piny.”</char><verse eid="JHN 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41"/>Jo-Yahudi nochako ngʼur kode nikech nowacho niya, <char style="wj">“An e makati mobiro e piny koa e polo.”</char> <verse eid="JHN 6:41"/><verse number="42" style="v" sid="JHN 6:42"/>Negiwacho niya, “Donge ma en Yesu, ma wuod Josef, ma wangʼeyo wuon gi min? Ere kaka dobukre kowacho sani ni, <char style="wj">‘Ne abiro e piny ka aa e polo’</char> ?”<verse eid="JHN 6:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43"/>Kuom mano, Yesu nodwokogi niya, <char style="wj">“Weuru ngʼur e kindu uwegi.</char> <verse eid="JHN 6:43"/><verse number="44" style="v" sid="JHN 6:44"/><char style="wj">Onge ngʼama nyalo biro ira ka ok Wuora mane oora ema okele, kendo anachiere chiengʼ giko piny.</char> <verse eid="JHN 6:44"/><verse number="45" style="v" sid="JHN 6:45"/><char style="wj">Ondiki e kitepe Jonabi ni, ‘Jehova Nyasaye nopuonj ji duto.’</char><note caller="+" style="f"><char style="fr" closed="false">6:45 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 54:13">Isa 54:13</ref></char></char></note> <char style="wj">Emomiyo ngʼat mosewinjo wach Wuoro, kod mosemako puonj mare, biro ira.</char> <verse eid="JHN 6:45"/><verse number="46" style="v" sid="JHN 6:46"/><char style="wj">Onge ngʼama oseneno Wuoro makmana Jal ma noa ka Nyasaye; En kende ema oseneno Wuoro.</char> <verse eid="JHN 6:46"/><verse number="47" style="v" sid="JHN 6:47"/><char style="wj">Awachonu adier ni ngʼama oyie kuoma nigi ngima mochwere.</char> <verse eid="JHN 6:47"/><verse number="48" style="v" sid="JHN 6:48"/><char style="wj">An e kuon mar ngima.</char> <verse eid="JHN 6:48"/><verse number="49" style="v" sid="JHN 6:49"/><char style="wj">Kwereu nochamo manna e thim, to kata kamano ne githo.</char> <verse eid="JHN 6:49"/><verse number="50" style="v" sid="JHN 6:50"/><char style="wj">An to awuoyo kuom makati moa e polo, ma ngʼato nyalo chamo mondo kik otho.</char> <verse eid="JHN 6:50"/><verse number="51" style="v" sid="JHN 6:51"/><char style="wj">An e makati mar ngima ma nobiro e piny koa e polo. Ka ngʼato moro amora ochamo makatini, to obiro bet mangima nyaka chiengʼ. Makatini en ringra, ma abiro chiwo mondo piny oyud ngima.”</char><verse eid="JHN 6:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52"/>Eka jo-Yahudi nochako mino wach e kindgi giwegi, kagiwacho niya, “Ere kaka ngʼatni nyalo miyowa ringre mondo wacham?”<verse eid="JHN 6:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53"/>Eka Yesu nowachonegi niya, <char style="wj">“Awachonu adier, ni ka ok uchamo ringre Wuod Dhano kendo umadho rembe, to uonge gi ngima.</char> <verse eid="JHN 6:53"/><verse number="54" style="v" sid="JHN 6:54"/><char style="wj">Ngʼato angʼata mochamo ringra kendo omadho remba nigi ngima mochwere, kendo abiro chiere chiengʼ giko piny.</char> <verse eid="JHN 6:54"/><verse number="55" style="v" sid="JHN 6:55"/><char style="wj">Ringra e chiemo madier kendo remba e math madier.</char> <verse eid="JHN 6:55"/><verse number="56" style="v" sid="JHN 6:56"/><char style="wj">Ngʼato angʼata mochamo ringra kendo omadho remba siko kuoma, to an bende asiko kuome.</char> <verse eid="JHN 6:56"/><verse number="57" style="v" sid="JHN 6:57"/><char style="wj">Mana kaka Wuoro Mangima noora, kendo angima nikech Wuoro, e kaka ngʼama chamo ringra biro bedo mangima nikech an.</char> <verse eid="JHN 6:57"/><verse number="58" style="v" sid="JHN 6:58"/><char style="wj">An e makati mobiro e piny koa e polo. Kwereu nochamo manna kendo ne githo, to ngʼat mochamo makatini, to biro bedo mangima nyaka chiengʼ.”</char> <verse eid="JHN 6:58"/><verse number="59" style="v" sid="JHN 6:59"/>Nowacho wechegi Kapernaum kane oyudo opuonjo ei sinagogi.<verse eid="JHN 6:59"/></para>
  <para style="s1">Jopuonjre mangʼeny oweyo Yesu</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60"/>Kane jopuonjre owinjo wachno, thothgi nowacho niya, “Ma en puonj matek manade. En ngʼa manyalo yie gi puonjni?”<verse eid="JHN 6:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61"/>Yesu nongʼeyo ni jopuonjrene ne ngʼur kuom wachni, omiyo nowachonegi niya, <char style="wj">“Dibed ni wachni ochwanyou?</char> <verse eid="JHN 6:61"/><verse number="62" style="v" sid="JHN 6:62"/><char style="wj">Ka en kamano, to ubiro timoru nade ka unune Wuod Dhano kadok kuma ne oae!</char> <verse eid="JHN 6:62"/><verse number="63" style="v" sid="JHN 6:63"/><char style="wj">Roho ema chiwo ngima; to dhano ok nyal gimoro. Weche ma asewachonu gin mag Roho kod ngima.</char> <verse eid="JHN 6:63"/><verse number="64" style="v" sid="JHN 6:64"/><char style="wj">To kata kamano pod nitie jomoko kuomu ma ok oyie.”</char> Yesu nowacho kamano nikech nosengʼeyo nyaka aa chakruok joma ok oyie kaachiel gi ngʼat mabiro ndhoge. <verse eid="JHN 6:64"/><verse number="65" style="v" sid="JHN 6:65"/>Eka nomedo wuoyo kowacho niya, <char style="wj">“Mano emomiyo ne anyisou ni onge ngʼama nyalo biro ira ka ok Wuora ema okele.”</char><verse eid="JHN 6:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66"/>Chakre kindeno ngʼeny jopuonjrene nodok chien moweyo luwe.<verse eid="JHN 6:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67"/>Yesu nopenjo jopuonjrene apar gariyo niya, <char style="wj">“Dibed ni un bende udwaro weya koso?”</char><verse eid="JHN 6:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68"/>Simon Petro nodwoke niya, “Ruoth, en ngʼa madwadhi ire? In ema in gi weche makelo ngima mochwere. <verse eid="JHN 6:68"/><verse number="69" style="v" sid="JHN 6:69"/>Wayie kendo wangʼeyo ni in e Ngʼama Ler mar Nyasaye.”<verse eid="JHN 6:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70"/>Eka Yesu nodwokogi niya, <char style="wj">“Donge aseyierou duto karu ji apar gariyo, to kata kamano, ngʼato achiel kuomu en jachien!”</char> <verse eid="JHN 6:70"/><verse number="71" style="v" sid="JHN 6:71"/>(Nowuoyo kuom Judas ma wuod Simon Iskariot mane biro ndhoge bangʼe, kata obedo ni ne en achiel kuom jopuonjrene apar gariyo.)<verse eid="JHN 6:71"/></para>
  <chapter eid="JHN 6"/>
  <chapter number="7" style="c" sid="JHN 7"/>
  <para style="s1">Yesu odhi e Sap Kiche</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1"/>Bangʼ mano Yesu nodhi koni gi koni e piny Galili, kotemo bedo mabor gi Judea nikech jo-Yahudi ne rite kuno mondo ginege. <verse eid="JHN 7:1"/><verse number="2" style="v" sid="JHN 7:2"/>To ka Sap jo-Yahudi mar Kiche ne chiegni chopo, <verse eid="JHN 7:2"/><verse number="3" style="v" sid="JHN 7:3"/>owete Yesu nowachone niya, “Wuog ka idhi Judea mondo jopuonjreni one honni mitimo. <verse eid="JHN 7:3"/><verse number="4" style="v" sid="JHN 7:4"/>Ka ngʼato dwaro mondo obed rahuma to ok otim gik moko lingʼ-lingʼ. Omiyo kaka isebedo ka itimo honnigi, koro nyenyri ane e lela mondo piny oneni.” <verse eid="JHN 7:4"/><verse number="5" style="v" sid="JHN 7:5"/>Negiwachone kamano nikech kata gin giwegi ne ok giyie kuome.<verse eid="JHN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6"/>Kuom mano, Yesu nowachonegi niya, <char style="wj">“An sechega pok ochopo, un to unyalo timo gigeu sa moro amora.</char> <verse eid="JHN 7:6"/><verse number="7" style="v" sid="JHN 7:7"/><char style="wj">Piny ok nyal chayou, to an to piny ochaya nikech ahulo ni gik motimo richo.</char> <verse eid="JHN 7:7"/><verse number="8" style="v" sid="JHN 7:8"/><char style="wj">Un dhiuru adhiya e sawo. An pod ok adhi e sawono mondi nikech sa mowinjore adhi kuno pok ochopo.”</char> <verse eid="JHN 7:8"/><verse number="9" style="v" sid="JHN 7:9"/>Bangʼ wacho kamano nodongʼ Galili.<verse eid="JHN 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10"/>Kata kamano bangʼ ka owetene nosewuok odhi e sawo, en bende nodhi, to nodhi lingʼ-lingʼ ka ji ok ongʼeyo ni odhi. <verse eid="JHN 7:10"/><verse number="11" style="v" sid="JHN 7:11"/>Jo-Yahudi ne manye e sawono ka gipenjo niya, “Ere ngʼatno?”<verse eid="JHN 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12"/>Ji mathoth mane ni e sawono ne wuoyo kuom Yesu. Jomoko nowacho niya, “En ngʼat maber.”</para>
  <para style="p" vid="JHN 7:12">To jomoko kuomgi to nowacho niya, “Ooyo, owuondo ji.” <verse eid="JHN 7:12"/><verse number="13" style="v" sid="JHN 7:13"/>To onge ngʼama ne nyalo hedhore wuoyo kuome e lela nikech negiluoro jo-Yahudi.<verse eid="JHN 7:13"/></para>
  <para style="s1">Yesu opuonjo e Sawo</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14"/>Kane ji pod ni e Sawo, Yesu nodonjo nyaka e laru mar hekalu mochako puonjo ji. <verse eid="JHN 7:14"/><verse number="15" style="v" sid="JHN 7:15"/>Jo-Yahudi nowuoro ka gipenjo niya, “Rieko machalo kama ngʼatni oyudo kanye to ok osomo?”<verse eid="JHN 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16"/>Yesu nodwokogi niya, <char style="wj">“Gik ma apuonjo ok gin maga awuon, to gin mag Jal mane oora.</char> <verse eid="JHN 7:16"/><verse number="17" style="v" sid="JHN 7:17"/><char style="wj">Ka ngʼato oyiero mar timo dwach Nyasaye, to obiro ngʼeyo ka bende puonjna oa kuom Nyasaye adier, kata ka awacho mana wechena awuon.</char> <verse eid="JHN 7:17"/><verse number="18" style="v" sid="JHN 7:18"/><char style="wj">Ngʼat ma wuoyo kuome owuon timo kamano mondo oyud duongʼ en owuon, to ngʼat matiyo mondo Nyasaye mane oore ema oyud duongʼ, en ja-adiera, kendo onge miriambo moro amora kuome.</char> <verse eid="JHN 7:18"/><verse number="19" style="v" sid="JHN 7:19"/><char style="wj">Musa donge nomiyou chik? Kata kamano, onge kata achiel kuomu ma orito chik. Ka en kamano, to angʼo momiyo udwaro nega?”</char><verse eid="JHN 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20"/>Ogandano nodwoko niya, “Jachien ni kodi! En ngʼa madwaro negi?”<verse eid="JHN 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21"/>Yesu nowachonegi niya, <char style="wj">“Hono achiel kende ema ne atimo mi ubwok uduto.</char> <verse eid="JHN 7:21"/><verse number="22" style="v" sid="JHN 7:22"/><char style="wj">Nikech Musa nomiyou chik mar mondo oteru nyangu (to chutho Musa ok ema nomiyou chikni, to noa kuom kwereu), omiyo utero ji nyangu nyaka chiengʼ Sabato.</char> <verse eid="JHN 7:22"/><verse number="23" style="v" sid="JHN 7:23"/><char style="wj">To ka inyalo ter nyathi nyangu chiengʼ Sabato, mondo kik uketh Chik Musa, anto iu wangʼ koda nangʼo ka achango ringre dhano duto chiengʼ Sabato?</char> <verse eid="JHN 7:23"/><verse number="24" style="v" sid="JHN 7:24"/><char style="wj">Weuru ngʼado bura kuom gik muneno gioko, to ngʼaduru bura makare.”</char><verse eid="JHN 7:24"/></para>
  <para style="s1">Bende Yesu en Kristo adier?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25"/>Gikanyono jo-Jerusalem moko nochako penjo niya, “Donge ma e ngʼat mane gidwaro nego cha? <verse eid="JHN 7:25"/><verse number="26" style="v" sid="JHN 7:26"/>To neuru koro opuonjo e lela, to onge ngʼama wachone gimoro. Koso dibed ni jodongwa oseyie ni en Kristo? <verse eid="JHN 7:26"/><verse number="27" style="v" sid="JHN 7:27"/>Wangʼeyo kuma ngʼatni oaye nikech Kristo to kobiro, to onge ngʼama nongʼe kuma oaye.”<verse eid="JHN 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28"/>Kane oyudo Yesu pod puonjo ei laru mar hekalu, nokok matek kowacho niya, <char style="wj">“Ee, ungʼeya, kendo ungʼeyo kuma aaye. Ok an ka gi dwarona awuon, to Jal ma noora en ja-adiera. Un ukiaye,</char> <verse eid="JHN 7:28"/><verse number="29" style="v" sid="JHN 7:29"/><char style="wj">to an to angʼeye nikech ne aa ire, kendo en ema noora.”</char><verse eid="JHN 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30"/>Kane giwinjo mano, ne gitemo mondo gimake, to onge ngʼama notemo mule gi lwete, nikech kindene ne pok ochopo. <verse eid="JHN 7:30"/><verse number="31" style="v" sid="JHN 7:31"/>Ji mathoth e dier ogandano pod noyie mana kuome. Negiwacho niya, “Ka Kristo miwachono obiro, bende notim honni mangʼeny moloyo ngʼatni adier?”<verse eid="JHN 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32"/>Jo-Farisai nowinjo ka oganda wacho gik ma kamago kuome, omiyo jodolo madongo gi jo-Farisai nooro askeche mag hekalu mondo omake.<verse eid="JHN 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33"/>Yesu nowachonegi niya, <char style="wj">“An kodu mana kuom kinde matin kende, bangʼe to abiro dok ir Jal mane oora.</char> <verse eid="JHN 7:33"/><verse number="34" style="v" sid="JHN 7:34"/><char style="wj">Ubiro manya, to ok unuyuda, kendo kama antie ok unyal bire.”</char><verse eid="JHN 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35"/>Jo-Yahudi nowacho e kindgi giwegi niya, “Ngʼatni dwadhi kune ma ok wanyal yudee? Dibed ni odwaro dhi kuma jowa odakie ka gikere e dier jo-Yunani mondo opuonj jo-Yunani? <verse eid="JHN 7:35"/><verse number="36" style="v" sid="JHN 7:36"/>Tiend gima nowacho ni, <char style="wj">‘Ubiro manya to ok unuyuda’</char> kendo ni, <char style="wj">‘kama antie ok unyal bire’</char> en angʼo?”<verse eid="JHN 7:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37"/>Odiechiengʼ mogik mar Sawo, mane en odiechiengʼ maduongʼ ahinya, Yesu nochungʼ mowacho gi dwol maduongʼ niya, <char style="wj">“Ngʼat ma riyo oloyo mondo obi ira omodhi.</char> <verse eid="JHN 7:37"/><verse number="38" style="v" sid="JHN 7:38"/><char style="wj">Ngʼato angʼata moyie kuoma pi ngima nobubni koa kuome, mana kaka Ndiko owacho.”</char> <verse eid="JHN 7:38"/><verse number="39" style="v" sid="JHN 7:39"/>Gima ne owuoyo kuome ne en Roho, mane joma oyie kuome biro yudo bangʼe. E kindeno Roho ne pok obiro, nikech Yesu ne pok omi duongʼ.<verse eid="JHN 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40"/>Kane giwinjo wachno, moko kuom joma ne ni kanyo nowacho niya, “Jalni en janabi adier.”<verse eid="JHN 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41"/>Jomoko to nowacho niya, “En e Kristo.”</para>
  <para style="p" vid="JHN 7:41">Ji mamoko to nopenjo niya, “Ere kaka Kristo nyalo aa Galili? <verse eid="JHN 7:41"/><verse number="42" style="v" sid="JHN 7:42"/>Donge Ndiko wacho ni Kristo biro aa e anywola joka Daudi, kendo ni obiro aa Bethlehem, dala mane Daudi odakie?” <verse eid="JHN 7:42"/><verse number="43" style="v" sid="JHN 7:43"/>Omiyo pogruok nobedo e kind ji nikech wach Yesu. <verse eid="JHN 7:43"/><verse number="44" style="v" sid="JHN 7:44"/>Jomoko ne dwaro make, to onge ngʼama noketo lwete kuome.<verse eid="JHN 7:44"/></para>
  <para style="s1">Jotend jo-Yahudi otamore yie kuom Yesu</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45"/>Eka askeche mag hekalu nodok ir jodolo madongo gi jo-Farisai, kendo ne gipenjogi niya, “Angʼo momiyo ok usekele ka?”<verse eid="JHN 7:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46"/>Askeche nodwoko niya, “Onge ngʼama osewuoyo kaka ngʼatni nyaka nene.”<verse eid="JHN 7:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47"/>Jo-Farisai nodwokogi niya, “Kare un bende useyie gi miriambone. <verse eid="JHN 7:47"/><verse number="48" style="v" sid="JHN 7:48"/>Bende useneno jotend jo-Farisai kata achiel moyie kuome? <verse eid="JHN 7:48"/><verse number="49" style="v" sid="JHN 7:49"/>Onge ngʼama luwo ngʼatni makmana oganda mokia chik, gin joma okwongʼ!”<verse eid="JHN 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50"/>Nikodemo, jal manoyudo osedhi ir Yesu motelo, kendo mane en achiel kuomgi, nopenjo niya, <verse eid="JHN 7:50"/><verse number="51" style="v" sid="JHN 7:51"/>“Bende chikwa oyie adier mondo ongʼad ne ngʼato bura kapok onone mokwongo mondo ongʼe gima otimo?”<verse eid="JHN 7:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52"/>Negidwoke niya, “Donge in bende ia Galili? Non maber, to ibiro yudo ni onge janabi manyalo aa Galili.”</para>
  <para style="iex" vid="JHN 7:52">[Loko moko machon mag Muma kata joneno moko machon ne ok ondiko <char style="xt"><ref loc="JHN 7:53-8:11">Joh 7:53–8:11</ref></char>.]</para>
  <para style="p" vid="JHN 7:52">[<verse eid="JHN 7:52"/><verse number="53" style="v" sid="JHN 7:53"/>Eka moro ka moro kuomgi nowuok modok e dalane.<verse eid="JHN 7:53"/></para>
  <chapter eid="JHN 7"/>
  <chapter number="8" style="c" sid="JHN 8"/>
  <para style="nb">
    <verse number="1" style="v" sid="JHN 8:1"/>Yesu nodhi e Got Zeituni.<verse eid="JHN 8:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 8:2"/>Kinyne gokinyi nochak odok e hekalu, kama ji duto nochokore kolwore, kendo nobet piny mopuonjogi. <verse eid="JHN 8:2"/><verse number="3" style="v" sid="JHN 8:3"/>Jopuonj Chik kod jo-Farisai nokelo dhako moro mane onwangʼ ka terore. Negikete ochungʼ e nyim joma ne ni kanyo duto, <verse eid="JHN 8:3"/><verse number="4" style="v" sid="JHN 8:4"/>bangʼe negiwachone Yesu niya, “Japuonj, dhakoni nende omaki rando ka terore. <verse eid="JHN 8:4"/><verse number="5" style="v" sid="JHN 8:5"/>Musa to nomiyowa chik mondo wachiel mon ma kamago gi kite. In to iwacho angʼo kuom wachni?” <verse eid="JHN 8:5"/><verse number="6" style="v" sid="JHN 8:6"/>Negiketo wachno e nyim Yesu mondo gigajego kendo giyud yo mane ginyalo donjonego.</para>
  <para style="p" vid="JHN 8:6">Yesu to nokulore piny kendo nochako ndiko e lowo gi lith lwete. <verse eid="JHN 8:6"/><verse number="7" style="v" sid="JHN 8:7"/>Kane gimedo dhi nyime gipenje, noa malo mowachonegi niya, <char style="wj">“Ngʼato kuomu mapok otimo richo ema okuong goye gi kidi.”</char> <verse eid="JHN 8:7"/><verse number="8" style="v" sid="JHN 8:8"/>Eka nochako okulore piny mondiko e lowo.<verse eid="JHN 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 8:9"/>Gikanyono, joma nowinjo gima nowachono nochako wuok achiel kaachiel, chakre jomadongo nyaka nyithindo mi dhakono ema nodongʼ kende kochungʼ but Yesu. <verse eid="JHN 8:9"/><verse number="10" style="v" sid="JHN 8:10"/>Yesu noa malo kendo nopenje niya, <char style="wj">“Nyarwa, eregi? Onge ngʼama odongʼ ma pod donjoni?”</char><verse eid="JHN 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11"/>Nowacho niya, “Jaduongʼ, onge ngʼat modongʼ.”</para>
  <para style="p" vid="JHN 8:11">Yesu nokone niya, <char style="wj">“Kata an bende ok angʼadni bura. Wuogi idhi, to kik ichak itim richo kendo.”</char>]<verse eid="JHN 8:11"/></para>
  <para style="s1">Gimomiyo nend Yesu en adier</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12"/>Yesu nochako owuoyo kodgi, kowacho niya, <char style="wj">“An e ler mar piny, ngʼato angʼata ma luwa ok nyal wuotho e mudho, to enobed gi ler mar ngima.”</char><verse eid="JHN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13"/>Omiyo jo-Farisai nokwede kagiwacho niya, “Itimo mana nendi iwuon, omiyo ok wanyal yie ni gik miwacho gin adier.”<verse eid="JHN 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14"/>Yesu nodwokogi niya, <char style="wj">“Kata obedo ni atimo nenda awuon to nenda pod en mana adier nimar angʼeyo kuma ne aaye gi kuma adhiye. Un to ukia kuma aaye kata kuma adhiye.</char> <verse eid="JHN 8:14"/><verse number="15" style="v" sid="JHN 8:15"/><char style="wj">Ungʼado bura gi rieko mar dhano, an to ok angʼad bura ni ngʼato.</char> <verse eid="JHN 8:15"/><verse number="16" style="v" sid="JHN 8:16"/><char style="wj">To ka angʼado bura to paro ma angʼadogo bura nikare nikech ok atime kenda, to atime gi paro mar Wuoro mane oora.</char> <verse eid="JHN 8:16"/><verse number="17" style="v" sid="JHN 8:17"/><char style="wj">Ondiki e chiku ni nend ji ariyo nyalo bedo adiera mi yiego.</char> <verse eid="JHN 8:17"/><verse number="18" style="v" sid="JHN 8:18"/><char style="wj">An atimo nenda awuon, to ngʼama chielo matimo nenda en Wuoro mane oora.”</char><verse eid="JHN 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19"/>Eka negipenje niya, “Wuonuno nikanye?” Yesu nodwokogi niya,</para>
  <para style="p" vid="JHN 8:19">
    <char style="wj">“Ukiaya kendo Wuora bende ukia. Ka dine bed ni ungʼeya, to Wuora bende dine ungʼeyo.”</char> <verse eid="JHN 8:19"/><verse number="20" style="v" sid="JHN 8:20"/>Ne owacho wechegi kane oyudo opuonjo e laru mar hekalu, but kama ji ne ketoe sadaka. To onge ngʼama nomake, nikech kindene ne pok ochopo.<verse eid="JHN 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21"/>Yesu nowachonegi kendo niya, <char style="wj">“Abiro dhi aweyou, kendo ubiro manya, to unutho mana e richou. Kuma adhiye ok unyal bire.”</char><verse eid="JHN 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22"/>Wachneno nomiyo jo-Yahudi openjore niya, “Dibed ni ngʼatni dwaro dere? Dipo mano emomiyo owacho ni, <char style="wj">‘Kuma adhiye ok unyal bire?’</char> ”<verse eid="JHN 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23"/>To nomedo wachonegi niya, <char style="wj">“Unua mwalo e piny, an to aa malo e polo. Un jopinyni, to an ok an japinyni.</char> <verse eid="JHN 8:23"/><verse number="24" style="v" sid="JHN 8:24"/><char style="wj">Ne asenyisou ni ubiro tho e richou. Ka utamoru yie ni an ngʼama asebedo ka awachonu ni an, to ubiro tho e richou adier.”</char><verse eid="JHN 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25"/>Negipenje niya, “In ngʼa?”</para>
  <para style="p" vid="JHN 8:25">Yesu nodwokogi niya, <char style="wj">“An mana ngʼama asebedo ka awacho ni an nyaka aa chakruok.</char> <verse eid="JHN 8:25"/><verse number="26" style="v" sid="JHN 8:26"/><char style="wj">An gi gik mangʼeny monego awachnu mondo angʼadnugo bura. To Jal mane oora en ja-adiera, kendo anyiso piny gik ma asewinjo kuome.”</char><verse eid="JHN 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27"/>
    <char style="wj">Ne ok gingʼeyo ni ne owuoyonegi kuom Wuoro.</char> <verse eid="JHN 8:27"/><verse number="28" style="v" sid="JHN 8:28"/>Omiyo Yesu nowachonegi niya, <char style="wj">“Bangʼ ka useguro Wuod Dhano eka unungʼe ni an ngʼama asebedo ka anyisou ni an, kendo ni onge gima atimo kenda, to awacho mana gik ma Wuora opuonja.</char> <verse eid="JHN 8:28"/><verse number="29" style="v" sid="JHN 8:29"/><char style="wj">Jal mane oora ni koda kendo pok oweya kenda, nimar atimo gik malongʼone kinde duto.”</char> <verse eid="JHN 8:29"/><verse number="30" style="v" sid="JHN 8:30"/>Ji mangʼeny noyie kuome seche ma nowuoyono.<verse eid="JHN 8:30"/></para>
  <para style="s1">Nyikwa Ibrahim</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31"/>Yesu nowacho ni jo-Yahudi manoyie kuome niya, <char style="wj">“Ka usiko kumako puonjna, eka un jopuonjrena adier.</char> <verse eid="JHN 8:31"/><verse number="32" style="v" sid="JHN 8:32"/><char style="wj">Kutimo kamano, to ubiro ngʼeyo adiera kendo adiera nomi ubed thuolo.”</char><verse eid="JHN 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33"/>To negidwoke niya, “Wan koth Ibrahim kendo pok ne wabedo wasumb ngʼato nyaka nene. Ere gima omiyo iwachonwa ni ibiro miyowa wabed thuolo.”<verse eid="JHN 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34"/>Yesu nodwokogi niya, <char style="wj">“Awachonu adier, ni ngʼato ka ngʼato matimo richo, en misumba richo.</char> <verse eid="JHN 8:34"/><verse number="35" style="v" sid="JHN 8:35"/><char style="wj">To ongʼere ni misumba ok luong ni wuod dala, to wuod wuon dala ema iluongo kamano nyaka chiengʼ.</char> <verse eid="JHN 8:35"/><verse number="36" style="v" sid="JHN 8:36"/><char style="wj">Omiyo ka Wuowi ema omiyo ubedo thuolo, to ubiro bedo thuolo chutho.</char> <verse eid="JHN 8:36"/><verse number="37" style="v" sid="JHN 8:37"/><char style="wj">Angʼeyo ni un koth Ibrahim, kata kamano udwaro nega, nikech udagi miyo Wachna thuolo e chunyu.</char> <verse eid="JHN 8:37"/><verse number="38" style="v" sid="JHN 8:38"/><char style="wj">An awachonu gik ma aseneno kuom Wuora wangʼ gi wangʼ, to un usiko utimo mana gik ma useneno kuom wuonu.”</char><verse eid="JHN 8:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39"/>Negidwoke niya, “Wan Ibrahim e Wuonwa.”</para>
  <para style="p" vid="JHN 8:39">Yesu nowachonegi niya, <char style="wj">“Ka dine bed ni un nyithind Ibrahim adier, to dine utimo gik ma Ibrahim notimo;</char> <verse eid="JHN 8:39"/><verse number="40" style="v" sid="JHN 8:40"/><char style="wj">to kar timo kamano to udwaro mana nega nikech asebedo kanyiso weche mag adiera mane Nyasaye omiya. Ibrahim to ne ok otimo gik ma kamago.</char> <verse eid="JHN 8:40"/><verse number="41" style="v" sid="JHN 8:41"/><char style="wj">Un timbe wuonu ema utimo.”</char></para>
  <para style="p" vid="JHN 8:41">Ne gikone ka gikwere niya, “Wan ok wan kimirwa. Wuoro ma wan-go en Nyasaye owuon.”<verse eid="JHN 8:41"/></para>
  <para style="s1">Nyithind Satan</para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42"/>Yesu nowachonegi niya, <char style="wj">“Ka dine bed ni Nyasaye en Wuoru, dine uhera, nimar ne aa ir Nyasaye kendo koro an ka, ok asebiro kenda awuon, to en ema noora.</char> <verse eid="JHN 8:42"/><verse number="43" style="v" sid="JHN 8:43"/><char style="wj">Angʼo momiyo gik mawacho ok nyal donjonu kendo ok unyal winjo tiendgi?</char> <verse eid="JHN 8:43"/><verse number="44" style="v" sid="JHN 8:44"/><char style="wj">Un nyithind wuonu ma Satan kendo dwach wuonuno ema uhero timo. Ne en janek nyaka aa chakruok, kendo ok odwar adiera nikech adiera onge kuome. Koriambo to otimo gima ongʼiyogo, nimar en ja-miriambo, kendo en e wuon miriambo duto.</char> <verse eid="JHN 8:44"/><verse number="45" style="v" sid="JHN 8:45"/><char style="wj">To an ok uyie kuoma nikech awacho adiera!</char> <verse eid="JHN 8:45"/><verse number="46" style="v" sid="JHN 8:46"/><char style="wj">Ere ngʼato kuomu ka manyalo ngʼengʼa ni an jaricho? To ka awachonu adier to angʼo momiyo udagi yie kuoma?</char> <verse eid="JHN 8:46"/><verse number="47" style="v" sid="JHN 8:47"/><char style="wj">Ngʼat Nyasaye winjo weche Nyasaye, to un ok uwinj wach Nyasaye nikech ok un joge.”</char><verse eid="JHN 8:47"/></para>
  <para style="s1">Gik ma Yesu nowacho kuome owuon</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48"/>Jo-Yahudi nodwoke niya, “Donge wan kare ka wawacho ni in ja-Samaria kendo ni in gi jachien?”<verse eid="JHN 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49"/>Yesu nodwokogi niya, <char style="wj">“Aonge gi jachien. Wuora ema amiyo duongʼ to un to uchaya.</char> <verse eid="JHN 8:49"/><verse number="50" style="v" sid="JHN 8:50"/><char style="wj">An ok adwar mondo umiya duongʼ, to nitie Jal machielo madwaro mondo ayud duongʼ, kendo en e jangʼad bura.</char> <verse eid="JHN 8:50"/><verse number="51" style="v" sid="JHN 8:51"/><char style="wj">Awachonu adier ni ka ngʼato orito wachna, to ok notho nyaka chiengʼ.”</char><verse eid="JHN 8:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52"/>Kane jo-Yahudi owinjo wachno, negiwachone niya, “Koro wangʼeyo maonge kiawa ni in gi jachien! Ibrahim notho, kendo jonabi bende notho, to in to iwacho ni ka ngʼato orito wachni to ok notho. <verse eid="JHN 8:52"/><verse number="53" style="v" sid="JHN 8:53"/>Iparo ni iduongʼ moloyo kwarwa Ibrahim? Ka en notho, to jonabi bende notho, in to iparo ni in ngʼa?”<verse eid="JHN 8:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54"/>Yesu nodwokogi niya, <char style="wj">“Ka dipo ni amiyora duongʼ kenda, to duongʼna onge tich. Wuora, ma un bende uluongo ni Nyasachuno ema miya duongʼ.</char> <verse eid="JHN 8:54"/><verse number="55" style="v" sid="JHN 8:55"/><char style="wj">Kata obedo ni ok ungʼeye, anto angʼeye. Ka anyalo wacho ni ok angʼeye, to anyalo bedo ja-miriambo mana ka un, to angʼeye adier kendo pile angʼeyo wachne.</char> <verse eid="JHN 8:55"/><verse number="56" style="v" sid="JHN 8:56"/><char style="wj">Ibrahim kwaru ne mor koneno ndalona; adier, nonene mobedo mamor.”</char><verse eid="JHN 8:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57"/>Jo-Yahudi nowachone niya, “Pok ichopo kata higni piero abich, to Ibrahim to iseneno kanye!”<verse eid="JHN 8:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58"/>Yesu nowachonegi niya, <char style="wj">“Awachonu adier ni kane pok onywol Ibrahim, to ne Antie!”</char> <verse eid="JHN 8:58"/><verse number="59" style="v" sid="JHN 8:59"/>Gikanyono ne gikwanyo kite mondo gichielgo Yesu, to nopondonigi, mopusore oa e laru mar hekalu.<verse eid="JHN 8:59"/></para>
  <chapter eid="JHN 8"/>
  <chapter number="9" style="c" sid="JHN 9"/>
  <para style="s1">Yesu ochango ngʼat ma muofu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1"/>Kane oyudo owuotho odhi, noneno ngʼat moro mane osebedo muofu nyaka aa nywolne. <verse eid="JHN 9:1"/><verse number="2" style="v" sid="JHN 9:2"/>Jopuonjre nopenje niya, “Rabi, en ngʼa ma notimo richo; ngʼatni koso jonywolne, momiyo nonywole muofu?”<verse eid="JHN 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3"/>Yesu nodwokogi niya, <char style="wj">“Ngʼatni kata jonywolne ne ok otimo richo, to ma notimore mondo teko mar Nyasaye onenre e changne.</char> <verse eid="JHN 9:3"/><verse number="4" style="v" sid="JHN 9:4"/><char style="wj">Nyaka wati tije mag Jal mane oora ka pod piny odiechiengʼ, nikech otieno biro maonge ngʼama nyalo tiyo.</char> <verse eid="JHN 9:4"/><verse number="5" style="v" sid="JHN 9:5"/><char style="wj">Ka pod an e piny, to an e ler mar piny.”</char><verse eid="JHN 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6"/>Kane osewacho kamano, nongʼudho olawo piny, mi olosogo chwodho, kaeto oketo e wangʼ ngʼatno. <verse eid="JHN 9:6"/><verse number="7" style="v" sid="JHN 9:7"/>Eka nowachone ngʼatno niya, <char style="wj">“Dhiyo ilwok wangʼi e yawo mar Siloam”</char> (tiende ni “Ote”). Omiyo ngʼatno nodhi moluoko wangʼe, kendo noduogo dala koneno.<verse eid="JHN 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8"/>Jogwengʼ-gi gi joma nosenene motelo kokwecho nopenjo niya, “Donge ma e ngʼat mosebedo kakwechocha?” <verse eid="JHN 9:8"/><verse number="9" style="v" sid="JHN 9:9"/>Jomoko kuomgi nowacho ni mano en.</para>
  <para style="p" vid="JHN 9:9">Ji mamoko to nowacho niya, “Ooyo, ngʼatni chal mana kode.”</para>
  <para style="p" vid="JHN 9:9">Ngʼatno owuon to nowacho koramo niya, “En mana an.”<verse eid="JHN 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10"/>Negimedo penje niya, “Ka en kamano, to wengeni nokelo yawore nade?”<verse eid="JHN 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11"/>Nodwokogi niya, “Ngʼat miluongo ni Yesu noloso chwodho moro bangʼe oketo chwodhono e wengena. Nonyisa ni adhi Siloam aluok wangʼa, kendo ne adhi mi aluoko wangʼa, bangʼe ne aneno.”<verse eid="JHN 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12"/>Negipenje niya, “Ere ngʼatno?”</para>
  <para style="p" vid="JHN 9:12">To nodwokogi niya, “Ok angʼeyo kuma entiere.”<verse eid="JHN 9:12"/></para>
  <para style="s1">Jo-Farisai onono kaka muofuni okelo chango</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13"/>Ne gitero ngʼat machon ne muofuno ir jo-Farisai. <verse eid="JHN 9:13"/><verse number="14" style="v" sid="JHN 9:14"/>To chiengʼ mane Yesu olose chwodho kendo ochango wangʼ muofuno ne en chiengʼ Sabato. <verse eid="JHN 9:14"/><verse number="15" style="v" sid="JHN 9:15"/>Omiyo jo-Farisai nopenje kaka nokelo neno. To ngʼatno nodwokogi niya, “Nende oketo chwodho e wengena, bangʼe aluoko mi koro aneno.”<verse eid="JHN 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16"/>Moko kuom jo-Farisaigo nowacho niya, “Ngʼatni ok oa kuom Nyasaye, nimar ok orito Sabato.”</para>
  <para style="p" vid="JHN 9:16">Ji mamoko to nopenjo niya, “Ere kaka ngʼama jaricho nyalo timo tim hono machal kama?” Omiyo ne gipogore e kindgi giwegi.<verse eid="JHN 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17"/>Eka negichako gidonjore gi muofuno, mi gipenje niya, “In manende ochangi, to iwacho angʼo kuome?”</para>
  <para style="p" vid="JHN 9:17">Ngʼatno nodwokogi niya, “En janabi.”<verse eid="JHN 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18"/>To jo-Yahudi ne pod ok oyie ni ngʼatni nonywol ka en muofu, kendo ni wengene noseyawore, nyaka negioro wach mondo oluong jonywol ngʼatno. <verse eid="JHN 9:18"/><verse number="19" style="v" sid="JHN 9:19"/>Ne gipenjogi niya, “Bende ngʼatni e wuodu ma uwacho ni nonywol muofu? Obet nade ni koro onyalo neno?”<verse eid="JHN 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20"/>Jonywolgo nodwokogi niya, “Wangʼeyo ni ma en wuodwa, kendo wangʼeyo ni nonywole muofu. <verse eid="JHN 9:20"/><verse number="21" style="v" sid="JHN 9:21"/>To kaka koro onyalo neno sani, kata ngʼama noyawo wengene, to wakia. Penjeuru, tinde oduongʼ. Obiro wacho wach kuome owuon.” <verse eid="JHN 9:21"/><verse number="22" style="v" sid="JHN 9:22"/>Jonywolne nowacho kamano nikech negiluoro jo-Yahudi, nimar noyudo jo-Yahudi osengʼado wach ni ngʼato angʼata ma nohul ni Yesu en Kristo ne ibiro riembi e sinagogi. <verse eid="JHN 9:22"/><verse number="23" style="v" sid="JHN 9:23"/>Mano emomiyo jonywolne nowacho niya, “Tinde oduongʼ, penjeuru.”<verse eid="JHN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24"/>Negichako giluongo ngʼat ma nonywol ka en muofuno mi gikone niya, “Wach adier e nyim Nyasaye! Wan wangʼeyo ni ngʼatni en jaricho.”<verse eid="JHN 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25"/>Nodwokogi niya, “An akia kata ka en jaricho kata ka ok en. Gimoro achiel kende ema angʼeyo: Ni chon ne an muofu, to sani koro aneno!”<verse eid="JHN 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26"/>Eka negipenje niya, “Angʼo ma notimoni ma wangʼi oneno? Ere kaka noyawo wengeni?”<verse eid="JHN 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27"/>Nodwokogi niya, “Donge ne asenyisou, to ok uyie. Udwaro winje kendo nangʼo? Koso un bende udwaro doko jopuonjrene?”<verse eid="JHN 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28"/>Kuom mano, ne giyanye mangʼeny kagiwacho niya, “In e japuonjrene! Wan to wan jopuonjre Musa. <verse eid="JHN 9:28"/><verse number="29" style="v" sid="JHN 9:29"/>Wangʼeyo ni Nyasaye nowuoyo gi Musa, to ngʼatni to wakia kata mana kuma oaye.”<verse eid="JHN 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30"/>Ngʼatno nodwokogi niya, “Mano en wach miwuoro! Ukia kuma oaye to en ema noyawo wengena? <verse eid="JHN 9:30"/><verse number="31" style="v" sid="JHN 9:31"/>Wangʼeyo ni Nyasaye ok winj jaricho. Owinjo mana ngʼatno matimo dwarone. <verse eid="JHN 9:31"/><verse number="32" style="v" sid="JHN 9:32"/>Nyaka nene pok nowinji ngʼat moyawo wangʼ ngʼat mane onywol ka en muofu. <verse eid="JHN 9:32"/><verse number="33" style="v" sid="JHN 9:33"/>Ka dine bed ni ngʼatni ok noa kuom Nyasaye, to ok dine otimo gimoro.”<verse eid="JHN 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34"/>Omiyo negidwoke niya, “In nonywoli e chuny richo, koro ere kaka inyalo bukori ni ipuonjowa!” Bangʼ mano negiriembe oko.<verse eid="JHN 9:34"/></para>
  <para style="s1">Bedo muofu kuom Wach Nyasaye</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35"/>Yesu nowinjo ni ne oseriemb ngʼatno oko, omiyo kane oyude, nopenje niya, <char style="wj">“Bende iyie kuom Wuod Dhano?”</char><verse eid="JHN 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36"/>Ngʼatno nopenjo niya, “Jaduongʼ, Wuod Dhano to en ngʼa? Nyisago mondo ayie kuome.”<verse eid="JHN 9:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37"/>Yesu nodwoke niya, <char style="wj">“Eri koro isenene; kendo en ema owuoyo kodini.”</char><verse eid="JHN 9:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38"/>Ngʼatno nowachone niya, “Ruoth, ayie,” kendo nolame.<verse eid="JHN 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39"/>Eka Yesu nowacho niya, <char style="wj">“Asebiro e piny mondo angʼadne bura, mondo joma muofni onen, to joma neno olokre muofni.”</char><verse eid="JHN 9:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40"/>Jo-Farisai moko mane ni kode nowinje kowacho kamano mi openje niya, “Iwacho angʼono? Kare wan bende wan muofni?”<verse eid="JHN 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41"/>Yesu nowachonegi niya, “Ka dine bed ni un muofni, to dine ok ubedo joketho nikech richo; to nikech uketoru ni uneno, koro kethou osiko.”<verse eid="JHN 9:41"/></para>
  <chapter eid="JHN 9"/>
  <chapter number="10" style="c" sid="JHN 10"/>
  <para style="s1">Jakwath kod rombe</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1"/>Yesu nomedo wachonegi niya, <char style="wj">“Adier, adier, awachonu ni ngʼama ok donji e abich rombe koluwo dhorangach, to odonjo koluwo yo machielo, en jakuo kendo jamecho.</char> <verse eid="JHN 10:1"/><verse number="2" style="v" sid="JHN 10:2"/><char style="wj">Ngʼat madonjo koluwo dhorangach e jakwadh rombe.</char> <verse eid="JHN 10:2"/><verse number="3" style="v" sid="JHN 10:3"/><char style="wj">Jarito yawone dhorangach kendo rombe winjo dwonde. Oluongo rombene owuon gi nying-gi kendo otelonegi kagiwuok oko moro ka moro.</char> <verse eid="JHN 10:3"/><verse number="4" style="v" sid="JHN 10:4"/><char style="wj">Ka osegolo rombene duto oko, to otelo e nyimgi, kendo rombene luwo bangʼe nikech gingʼeyo kit dwonde.</char> <verse eid="JHN 10:4"/><verse number="5" style="v" sid="JHN 10:5"/><char style="wj">To ok ginyal luwo bangʼ ngʼama gikia. Adier, giringo gia bute nikech ok gingʼeyo dwonde.”</char> <verse eid="JHN 10:5"/><verse number="6" style="v" sid="JHN 10:6"/>Yesu notiyo gi ngeroni to ne ok giwinjo tiend gima nonyisogi.<verse eid="JHN 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7"/>Kuom mano, Yesu nochako owachonegi niya, <char style="wj">“Adier, adier, awachonu ni an e dhoranga rombe.</char> <verse eid="JHN 10:7"/><verse number="8" style="v" sid="JHN 10:8"/><char style="wj">Ji duto mane obiro motelona ne gin jokwoge kendo jomecho, to rombe ne ok owinjogi.</char> <verse eid="JHN 10:8"/><verse number="9" style="v" sid="JHN 10:9"/><char style="wj">An e dhorangach; ma ngʼato angʼata mokadho kuoma nokwo kendo nodonj iye mi owuog oko kendo oyud kar kwath maber.</char> <verse eid="JHN 10:9"/><verse number="10" style="v" sid="JHN 10:10"/><char style="wj">Jakuo biro mana mondo okwal kendo oneki kendo oketh gik moko, An to asebiro mondo giyud ngima, kendo giyude mogundho.</char><verse eid="JHN 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11"/>
    <char style="wj">“An e jakwath maber. Jakwath maber chiwo ngimane ne rombe.</char> <verse eid="JHN 10:11"/><verse number="12" style="v" sid="JHN 10:12"/><char style="wj">Jatij ngʼato ok en jakwath ma wuon rombe. Omiyo koneno ondiek kabiro, to oringo oweyo rombe kanyo. Eka ondiek monjo rombe kendo keyogi.</char> <verse eid="JHN 10:12"/><verse number="13" style="v" sid="JHN 10:13"/><char style="wj">Ngʼatno ringo tony nikech en mana jatich kendo ngima rombe ok obadhe.</char><verse eid="JHN 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 10:14"/>
    <char style="wj">“An e jakwath maber; angʼeyo rombena kendo rombena bende ongʼeya.</char> <verse eid="JHN 10:14"/><verse number="15" style="v" sid="JHN 10:15"/><char style="wj">Gingʼeya mana kaka Wuora ongʼeya kendo angʼeyo Wuoro, kendo achiwo ngimana ne rombe.</char> <verse eid="JHN 10:15"/><verse number="16" style="v" sid="JHN 10:16"/><char style="wj">An gi rombe moko ma ok ni e abich rombegi. Gin bende nyaka akelgi kendo giniwinj dwonda, eka rombe duto nobed kweth achiel man-gi jakwath achiel.</char> <verse eid="JHN 10:16"/><verse number="17" style="v" sid="JHN 10:17"/><char style="wj">Gimomiyo Wuora ohera en nikech ayie chiwo ngimana, eka achako akawe kendo.</char> <verse eid="JHN 10:17"/><verse number="18" style="v" sid="JHN 10:18"/><char style="wj">Onge ngʼama nyalo kawe kuoma, to achiwe nikech ahero. An gi teko mar chiwe bende an gi teko mar kawe kendo. Tekoni ne ayudo kuom Wuora.”</char><verse eid="JHN 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19"/>Wechegi nomedo kelo pogruok e kind jo-Yahudi. <verse eid="JHN 10:19"/><verse number="20" style="v" sid="JHN 10:20"/>Ji mangʼeny nowacho niya, “Ngʼatni nigi jachien kendo ojaneko, en angʼo momiyo uchiko itu ni wechene?”<verse eid="JHN 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21"/>Ji mamoko to nowacho niya, “Magi ok gin weche ma ngʼama nigi jachien nyalo wacho. Jachien bende nyalo yawo wangʼ muofu adier?”<verse eid="JHN 10:21"/></para>
  <para style="s1">Tamruok yie mar jo-Yahudi</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22"/>Eka kinde mar Sawo mar Puodho hekalu nochopo Jerusalem. Ne en ndalo chwiri <verse eid="JHN 10:22"/><verse number="23" style="v" sid="JHN 10:23"/>kendo noyudo Yesu nitie machiegni gi hekalu, kowuotho e agola mar Solomon. <verse eid="JHN 10:23"/><verse number="24" style="v" sid="JHN 10:24"/>Jo-Yahudi nochokore molwore, kendo negiwachone niya, “Pod ibiro weyowa e mudho nyaka karangʼo? Ka in e Kristo to nyiswa maler.”<verse eid="JHN 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25"/>Yesu nodwokogi niya, <char style="wj">“Asenyisou, to utamoru yie. Honni ma atimo e nying Wuora bende nyiso gima An,</char> <verse eid="JHN 10:25"/><verse number="26" style="v" sid="JHN 10:26"/><char style="wj">to udagi yie nikech ok un rombena.</char> <verse eid="JHN 10:26"/><verse number="27" style="v" sid="JHN 10:27"/><char style="wj">Rombena winjo dwonda, bende angʼeyogi kendo giluwo bangʼa.</char> <verse eid="JHN 10:27"/><verse number="28" style="v" sid="JHN 10:28"/><char style="wj">Amiyogi ngima mochwere, kendo ok ginilal ngangʼ, bende onge ngʼama nyalo kawogi kagologi e lweta.</char> <verse eid="JHN 10:28"/><verse number="29" style="v" sid="JHN 10:29"/><char style="wj">Wuora mosemiyagi duongʼ moloyo duto, kendo onge ngʼama nyalo kawogi mi golgi e lwet Wuora.</char> <verse eid="JHN 10:29"/><verse number="30" style="v" sid="JHN 10:30"/><char style="wj">An kod Wuora wan achiel.”</char><verse eid="JHN 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31"/>Kane jo-Yahudi owinjo wachno, negichako gikwanyo kite mondo gichielego, <verse eid="JHN 10:31"/><verse number="32" style="v" sid="JHN 10:32"/>to Yesu nowachonegi niya, <char style="wj">“Asenyisou honni madongo mangʼeny moa ka Wuora. Kuom honnigi duto, en mane kuomgi ma udwaro chielane gi kite?”</char><verse eid="JHN 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33"/>Jo-Yahudi nodwoke niya, “Ok wachieli gi kite nikech honni madongo misetimo, to wachieli gi kite nikech iseyanyo Nyasaye. In mana dhano adhanani, ere kaka inyalo ketori ni in Nyasaye?”<verse eid="JHN 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34"/>Yesu nodwokogi niya, <char style="wj">“Donge ondiki e chiku ni, ‘Ne awacho ni un “nyiseche” ’</char><note caller="+" style="f"><char style="fr" closed="false">10:34 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 82:6">Zab 82:6</ref></char></char></note><char style="wj">?</char> <verse eid="JHN 10:34"/><verse number="35" style="v" sid="JHN 10:35"/><char style="wj">Kane oluongo joma wach Nyasaye nobironigi ni ‘nyiseche,’ to ongʼere ni Ndiko ok nyal kethi,</char> <verse eid="JHN 10:35"/><verse number="36" style="v" sid="JHN 10:36"/><char style="wj">to koro unyalo wacho angʼo kuom Jal ma Wuoro nowalo kaka Ngʼate owuon mi ooro e piny? Ka kamano, to angʼo momiyo udonjona gi ketho mar yanyo Nyasaye, nikech nende awacho ni, ‘An Wuod Nyasaye’?</char> <verse eid="JHN 10:36"/><verse number="37" style="v" sid="JHN 10:37"/><char style="wj">Ka dipo ni ok atim gik ma Wuora timo, to kik uyie kuoma.</char> <verse eid="JHN 10:37"/><verse number="38" style="v" sid="JHN 10:38"/><char style="wj">To ka atimogi, to yieuru kuom honnigo, kata ka an ok udwar yie kuoma, mondo ungʼe maber ni Wuoro ni e iya kendo an ei Wuoro.”</char> <verse eid="JHN 10:38"/><verse number="39" style="v" sid="JHN 10:39"/>Ne gitemo make kendo, to nopusore e lwetgi.<verse eid="JHN 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40"/>Eka Yesu nongʼado Jordan modok kama Johana ne batisoe ji kinde motelo. Nodak kanyo, <verse eid="JHN 10:40"/><verse number="41" style="v" sid="JHN 10:41"/>kendo ji mangʼeny nobiro ire. Negiwacho niya, “Kata obedo ni Johana ne ok otimo tim hono moro amora, to gik moko duto manowacho kuom ngʼatni ne gin adier.” <verse eid="JHN 10:41"/><verse number="42" style="v" sid="JHN 10:42"/>Kamano, ji mangʼeny noyie kuom Yesu kanyo.<verse eid="JHN 10:42"/></para>
  <chapter eid="JHN 10"/>
  <chapter number="11" style="c" sid="JHN 11"/>
  <para style="s1">Tho mar Lazaro</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1"/>Ngʼat moro ma nyinge Lazaro ne tuo. Ne en ja-Bethania, dala gi Maria gi Maritha nyamin mare. <verse eid="JHN 11:1"/><verse number="2" style="v" sid="JHN 11:2"/>Maria-ni ma owadgi Lazaro makoro tuoni ema noolo mo mangʼwe ngʼar e tiend Ruoth mi oyweyo gi yie wiye. <verse eid="JHN 11:2"/><verse number="3" style="v" sid="JHN 11:3"/>Omiyo nyimine Lazaro nooro wach ni Yesu niya, “Ruoth, osiepni mihero tuo.”<verse eid="JHN 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4"/>Kane Yesu owinjo mano, nowacho niya, <char style="wj">“Tuono ok en mar tho, to mano otimore mana ni mondo Nyasaye oyud duongʼ, kendo mondo Wuod Nyasaye oyud duongʼ kuome.”</char> <verse eid="JHN 11:4"/><verse number="5" style="v" sid="JHN 11:5"/>Yesu nohero Maritha gi nyamin mare kod Lazaro. <verse eid="JHN 11:5"/><verse number="6" style="v" sid="JHN 11:6"/>To kata kamano, kane owinjo ni Lazaro tuo, nomedo bedo kama ne entie kuom ndalo ariyo.<verse eid="JHN 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 11:7"/>Eka nowacho ni jopuonjrene niya, <char style="wj">“Wadoguru Judea.”</char><verse eid="JHN 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8"/>To jopuonjrene nodwoke niya, “Rabi, ere kaka didog kuno to nyocha eka jo-Yahudi dwaro goyi gi kite?”<verse eid="JHN 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9"/>Yesu nodwokogi niya, <char style="wj">“Donge nitie seche apar gariyo e odiechiengʼ? Ngʼat mawuotho godiechiengʼ ok chwanyre, nimar ler mar piny miyo oneno.</char> <verse eid="JHN 11:9"/><verse number="10" style="v" sid="JHN 11:10"/><char style="wj">Kowuotho gotieno eka ochwanyore, nikech oonge gi ler.”</char><verse eid="JHN 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 11:11"/>Bangʼ kane osewacho kamano, nomedo loso kodgi kowacho niya, <char style="wj">“Osiepwa ma Lazaro nindo osetero, to adwaro dhi kuno mondo achiewe.”</char><verse eid="JHN 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12"/>Jopuonjrene nodwoke niya, “Ruoth, konindo aninda, to obiro mana chiewo.” <verse eid="JHN 11:12"/><verse number="13" style="v" sid="JHN 11:13"/>Yesu ne wuoyo kuom tho Lazaro, to jopuonjrene to ne paro ni oloso mana kuom nindo mapile.<verse eid="JHN 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14"/>Omiyo koro nonyisogi ratiro niya, <char style="wj">“Lazaro otho,</char> <verse eid="JHN 11:14"/><verse number="15" style="v" sid="JHN 11:15"/><char style="wj">to amor ni nyocha otho ka aonge kuno, mondo eka uyie. Kata kamano, wawuog wadhiuru ire.”</char><verse eid="JHN 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16"/>Eka Thoma, ma bende iluongo ni Didimas, nowachone jopuonjre mamoko niya, “Wan bende wadhiuru mondo kata ka en tho, to watho kode.”<verse eid="JHN 11:16"/></para>
  <para style="s1">Yesu ohoyo Maritha gi Maria</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17"/>Kane Yesu ochopo, to noyudo ka Lazaro osetieko ndalo angʼwen e bur. <verse eid="JHN 11:17"/><verse number="18" style="v" sid="JHN 11:18"/>Bethania ne chiegni gi Jerusalem madirom kar kilomita adek, <verse eid="JHN 11:18"/><verse number="19" style="v" sid="JHN 11:19"/>kendo jo-Yahudi mangʼeny noyudo osebiro ir Maritha gi Maria mondo ohogi e kuyo margi kuom tho mar owadgi. <verse eid="JHN 11:19"/><verse number="20" style="v" sid="JHN 11:20"/>Kane Maritha owinjo ni Yesu biro, nowuok oko mondo oromne, ka Maria to nodongʼ ei ot.<verse eid="JHN 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 11:21"/>Maritha nowacho ni Yesu niya, “Ruoth, ka dinyocha bed ni in ka, to owadwa dine ok otho. <verse eid="JHN 11:21"/><verse number="22" style="v" sid="JHN 11:22"/>To angʼeyo ni kata mana sani Nyasaye biro miyi gimoro amora mikwaye.”<verse eid="JHN 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23"/>Yesu nowachone niya, <char style="wj">“Owadu biro chier.”</char><verse eid="JHN 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24"/>Maritha nodwoke niya, “Angʼeyo ni obiro chier kendo e ndalo chier, ma en chiengʼ giko piny.”<verse eid="JHN 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25"/>Yesu nowachone niya, <char style="wj">“An e chier kendo An e ngima. Ngʼat moyie kuoma kata otho to nodok mangima,</char> <verse eid="JHN 11:25"/><verse number="26" style="v" sid="JHN 11:26"/><char style="wj">kendo ngʼama ngima moyie kuoma ok notho ngangʼ. Bende iyie gi wachni?”</char><verse eid="JHN 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27"/>Eka nodwoke niya, “Ee, Ruoth, ayie ni in e Kristo ma Wuod Nyasaye, ma nonego obi e piny.”<verse eid="JHN 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28"/>Kane osewacho mano, to nodok oluongo Maria nyamin-gi tenge, mowachone niya, “Japuonj nika, kendo oluongi.” <verse eid="JHN 11:28"/><verse number="29" style="v" sid="JHN 11:29"/>Kane Maria owinjo mano, noa malo piyo piyo mi odhi ire. <verse eid="JHN 11:29"/><verse number="30" style="v" sid="JHN 11:30"/>Noyudo Yesu pok odonjo ei dalano; to ne pod ochungʼ oko kama Maritha noromonee. <verse eid="JHN 11:30"/><verse number="31" style="v" sid="JHN 11:31"/>Ka jo-Yahudi manoyudo nigi Maria ei ot, kahoye, nonene kochungʼ girikni modhi oko, negiluwo bangʼe, ka giparo ni odhi e liel mondo oywagi kuno.<verse eid="JHN 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32"/>Kane Maria ochopo kama Yesu ne nitie monene gi wangʼe, nopodho e tiende mowachone niya, “Ruoth, ka dinyocha bed ni in ka to owadwa dine ok otho.”<verse eid="JHN 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33"/>Kane Yesu onene koywak, kendo ka jo-Yahudi mane gibirogo ire bende ne ywak, chunye nodoko malit kendo nochandore. <verse eid="JHN 11:33"/><verse number="34" style="v" sid="JHN 11:34"/>Nopenjo niya, <char style="wj">“Ne uiko ringre kanye?”</char></para>
  <para style="p" vid="JHN 11:34">Negidwoke niya, “Ruoth, bi wadhi wanyisi.”<verse eid="JHN 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35"/>Pi wangʼ Yesu nochwer.<verse eid="JHN 11:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 11:36"/>Eka jo-Yahudi nowacho niya, “Neyeuru kaka nohere!”<verse eid="JHN 11:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37"/>Ji moko kuomgi to nopenjore niya, “Jal ma yande oyawo wangʼ muofuni, donge nyocha onyalo gengʼo tho Lazaro?”<verse eid="JHN 11:37"/></para>
  <para style="s1">Yesu ochiero Lazaro</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38"/>Yesu nochopo kar liel ka chunye nigi kuyo maduongʼ moloyo. Ne en rogo, kendo noyie kidi e dhoge. <verse eid="JHN 11:38"/><verse number="39" style="v" sid="JHN 11:39"/>Yesu nowacho niya, <char style="wj">“Goluru kidino oko e dho liel.”</char></para>
  <para style="p" vid="JHN 11:39">To Maritha ma nyamin ngʼat mane othono nokwer niya, “Ruoth, sani koro en gi tik marach, nimar osetieko ndalo angʼwen nyaka notho.”<verse eid="JHN 11:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40"/>Yesu nowachone niya, <char style="wj">“Donge nende anyisi ni kiyie to ibiro neno duongʼ mar Nyasaye?”</char><verse eid="JHN 11:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41"/>Omiyo ne gingʼielo kidino oko. Eka Yesu nongʼiyo malo mowacho niya, <char style="wj">“Wuora, agoyoni erokamano nikech isewinja.</char> <verse eid="JHN 11:41"/><verse number="42" style="v" sid="JHN 11:42"/><char style="wj">Angʼeyo bende ni isebedo kiwinja ndalo duto, to asewacho wechegi mondo joma ochungʼ ka oyud konyruok, kendo mondo giyie nine iora adier.”</char><verse eid="JHN 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43"/>Bangʼ wacho mano, Yesu noluongo gi dwol maduongʼ niya, <char style="wj">“Lazaro, wuog oko!”</char> <verse eid="JHN 11:43"/><verse number="44" style="v" sid="JHN 11:44"/>Mi ngʼama nothono nowuok oko, ka bedene gi tiendene onal gi lewni molir olir, kendo ka lela wangʼe bende otwe gi nanga alwora.</para>
  <para style="p" vid="JHN 11:44">Yesu nowachonegi niya, <char style="wj">“Gonyuru lep liel oko kuome mondo uweye odhi.”</char><verse eid="JHN 11:44"/></para>
  <para style="s1">Jo-Yahudi ochano mar nego Yesu</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45"/>Kuom mano, jo-Yahudi mangʼeny mane obiro hoyo chuny Maria, kendo ma noneno gima Yesu notimo, noyie kuome. <verse eid="JHN 11:45"/><verse number="46" style="v" sid="JHN 11:46"/>Ji moko kuomgi to nodhi ir jo-Farisai monyisogi gima Yesu nosetimo. <verse eid="JHN 11:46"/><verse number="47" style="v" sid="JHN 11:47"/>Eka jodolo madongo gi jo-Farisai nochoko buch jo-Sanhedrin, kendo negipenjore niya,</para>
  <para style="p" vid="JHN 11:47">“Watim angʼo? Ngʼatni medo timo timbe honni mangʼeny moloyo. <verse eid="JHN 11:47"/><verse number="48" style="v" sid="JHN 11:48"/>Ka waweye odhi nyime kama, to ji duto biro yie kuome, kendo kamano otimore to jo-Rumi biro biro mi kaw karwa ka, kaachiel gi pinywa bende.”<verse eid="JHN 11:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49"/>To achiel kuomgi, mane nyinge Kaifas, mane en jadolo maduongʼ e higano nowachonegi niya, “Un joma ok riek kata matin! <verse eid="JHN 11:49"/><verse number="50" style="v" sid="JHN 11:50"/>Ok unyal fwenyo ni en gima ber moloyo mondo ngʼato achiel otho ni ji duto, moloyo ka oganda duto otho.”<verse eid="JHN 11:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 11:51"/>Ne ok owacho wachni gi pache owuon, to kaka ne en jadolo maduongʼ e higano, nokoro wach ni Yesu ne biro tho ne piny jo-Yahudi, <verse eid="JHN 11:51"/><verse number="52" style="v" sid="JHN 11:52"/>to ok ne pinyno kende, to ne nyithind Nyasaye duto mokere, mondo ochokgi kaachiel, kendo omi gibed gimoro achiel. <verse eid="JHN 11:52"/><verse number="53" style="v" sid="JHN 11:53"/>Omiyo chakre chiengʼno kadhi nyime negichano kaka ginyalo nego Yesu.<verse eid="JHN 11:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 11:54"/>Kuom mano, Yesu koro ne ok wuothi e dier jo-Yahudi ka ji nene. Nopondo modhi e gwengʼ man but thim, e dala miluongo ni Efraim, kendo nobet kuno gi jopuonjrene.<verse eid="JHN 11:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55"/>Ka kinde mag Pasaka mar jo-Yahudi ne chiegni chopo, ji mangʼeny moa e gwenge mopogore opogore nodhi Jerusalem mondo gipwodhre kapok Pasaka ochopo. <verse eid="JHN 11:55"/><verse number="56" style="v" sid="JHN 11:56"/>Negisiko ka gimanyo Yesu, kendo negipenjore ngʼato gi ngʼato, ka gichungʼ ei alwora mar hekalu niya, “Uparo nade? Donge obiro biro e sawoni koso ok obi biro?” <verse eid="JHN 11:56"/><verse number="57" style="v" sid="JHN 11:57"/>Negiwacho kamano nikech jodolo madongo gi jo-Farisai ne osegolo chik ni ngʼato angʼata mongʼeyo kuma Yesu nitie nyaka ternegi wach mondo gidhi gimake.<verse eid="JHN 11:57"/></para>
  <chapter eid="JHN 11"/>
  <chapter number="12" style="c" sid="JHN 12"/>
  <para style="s1">Maria owiro Yesu gi mo Bethania</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1"/>Kane pod odongʼ ndalo auchiel mondo Pasaka ochopi, Yesu notundo Bethania, kama Lazaro nodakie, mane en ngʼat mane Yesu ochiero oa kuom joma otho. <verse eid="JHN 12:1"/><verse number="2" style="v" sid="JHN 12:2"/>Negiloso nyasi maduongʼ Bethania ne Yesu. Maritha ne miyo welo chiemo, to Lazaro to nobet kachiemo kaachiel gi joma nobet kolworo mesa. <verse eid="JHN 12:2"/><verse number="3" style="v" sid="JHN 12:3"/>Eka Maria nokawo mo mangʼwe ngʼar kendo ma nengone tek, manyalo romo nus lita, mowirogo tiende Yesu, bangʼe oyweyo tiendene gi yie wiye. Mi ot nopongʼ gi tik mangʼwe ngʼar mar mono.<verse eid="JHN 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4"/>Judas Iskariot, ma en achiel kuom jopuonjre Yesu kendo mane biro ndhoge bangʼe, nokwero tim mane dhakono otimo, kowacho niya, <verse eid="JHN 12:4"/><verse number="5" style="v" sid="JHN 12:5"/>“Angʼo ma nomone hono mo mangʼwe ngʼarno mondo pesa moyudi omi joma odhier? Onge tiende ketho mo ma nengone tek kama, moromo chulo misach ngʼat achiel kuom higa ngima.” <verse eid="JHN 12:5"/><verse number="6" style="v" sid="JHN 12:6"/>Ne ok owacho kamano nikech nohero jodhier, to nikech ne en jakuo. Kaka jakeno mar pesa, nothoro konyore gi pesa ma nokanogo.<verse eid="JHN 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7"/>Yesu nodwoko niya, <char style="wj">“Weyeuru mos. Ne ochan chon ni owinjore okan mo mangʼwe ngʼarno nyaka chiengʼ yikna.</char> <verse eid="JHN 12:7"/><verse number="8" style="v" sid="JHN 12:8"/><char style="wj">Joma odhier ubiro bedogo e dieru kinde duto, to an ok ubi siko koda ndalo duto.”</char><verse eid="JHN 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9"/>E kindeno, jo-Yahudi mangʼeny nofwenyo ni Yesu ne nitie kanyo mi negibiro, ok nikech en, to nikech negidwaro neno Lazaro, manoyudo osechiero oa kuom joma otho. <verse eid="JHN 12:9"/><verse number="10" style="v" sid="JHN 12:10"/>Omiyo jodolo madongo noloso chenro kaka digineg Lazaro kaachiel kode, <verse eid="JHN 12:10"/><verse number="11" style="v" sid="JHN 12:11"/>nimar wachne nomiyo jo-Yahudi mangʼeny koro ne weyogi dhi ir Yesu kendo giyie kuome.<verse eid="JHN 12:11"/></para>
  <para style="s1">Yesu odonjo Jerusalem gi rwak maduongʼ</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12"/>Kinyne, oganda maduongʼ mane oyudo obiro e Sawo nowinjo ni Yesu ni e yo biro Jerusalem. <verse eid="JHN 12:12"/><verse number="13" style="v" sid="JHN 12:13"/>Negikawo bede othidhe mi giwuok oko mondo giromne, ka gikok niya,</para>
  <para style="q1" vid="JHN 12:13">“Hosana!”</para>
  <para style="b" vid="JHN 12:13"/>
  <para style="q1" vid="JHN 12:13">“Ogwedh ngʼat mabiro e nying Jehova Nyasaye!”<note caller="+" style="f"><char style="fr" closed="false">12:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:25">Zab 118:25</ref>,<ref loc="PSA 118:26">26</ref></char></char></note></para>
  <para style="b" vid="JHN 12:13"/>
  <para style="q1" vid="JHN 12:13">“Ogwedh Ruodh Israel!”<verse eid="JHN 12:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="JHN 12:14"/>Yesu noyudo nyathi kanyna moro moidho obetie, mana kaka Ndiko wacho niya,<verse eid="JHN 12:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15"/>“Kik ibed maluor, yaye Nyar Sayun;</para>
  <para style="q2" vid="JHN 12:15">nee, ruodhi eri biro,</para>
  <para style="q2" vid="JHN 12:15">koidho nyathi kanyna.”<note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 9:9">Zek 9:9</ref></char></char></note><verse eid="JHN 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16"/>Mokwongo jopuonjrene ne ok owinjo tiend gigi duto, to achien, bangʼ ka Yesu nosemi duongʼ eka negifwenyo ni wechegi nosendiki kuome chon, kendo ni gigo notimore nikech en.<verse eid="JHN 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17"/>Oganda mane ni kode chiengʼ mane oluongo Lazaro oa e liel, ka nochiere oa kuom joma otho, nomedo lando wachno. <verse eid="JHN 12:17"/><verse number="18" style="v" sid="JHN 12:18"/>Omiyo ji mangʼeny nowuok mondo giromne, nikech negisewinjo ni en ema yande otimo honono. <verse eid="JHN 12:18"/><verse number="19" style="v" sid="JHN 12:19"/>Kuom mano, jo-Farisai nowacho e kindgi ngʼato gi ngʼato niya, “Uneno ka wachni e muomowa. Neyeuru kaka piny duto osewuok luwo bangʼe!”<verse eid="JHN 12:19"/></para>
  <para style="s1">Yesu okoro thone</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20"/>Koro ne nitie jo-Yunani moko kuom joma ne biro lemo e Sawono. <verse eid="JHN 12:20"/><verse number="21" style="v" sid="JHN 12:21"/>Negibiro ir Filipo, mane aa Bethsaida, e piny Galili, mi gikwaye niya, “Jaduongʼ, wadwaro neno Yesu.” <verse eid="JHN 12:21"/><verse number="22" style="v" sid="JHN 12:22"/>Filipo nodhi monyiso Andrea wachno; eka Andrea kod Filipo nodhi ir Yesu ma ginyise wachno.<verse eid="JHN 12:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23"/>Yesu nodwokogi niya, <char style="wj">“Sa osechopo mondo Wuod Dhano omi duongʼ.</char> <verse eid="JHN 12:23"/><verse number="24" style="v" sid="JHN 12:24"/><char style="wj">Awachonu adier ni ka koth cham ok oiki e lowo motho, to osiko mana kodhi achiel kende. To ka otho, to onywolo kothe mangʼeny.</char> <verse eid="JHN 12:24"/><verse number="25" style="v" sid="JHN 12:25"/><char style="wj">Ngʼama ohero ngimane, ngimane biro lalne, to ngʼama ochayo ngimane e pinyni biro rite nyaka chop oyud ngima mochwere.</char> <verse eid="JHN 12:25"/><verse number="26" style="v" sid="JHN 12:26"/><char style="wj">Ngʼato angʼata matiyona nyaka luwa, kendo kama antie ema jatichna bende nobedie. Ngʼat matiyona Wuora biro miyo duongʼ.</char><verse eid="JHN 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27"/>
    <char style="wj">“Koro chunya chandore, to en angʼo ma dawachi? Dawach ni, ‘Wuora, resa e sa machalo kama?’ Ooyo, ok onyal timo kamano nikech ma e gima omiyo ne abiro e kindeni.</char> <verse eid="JHN 12:27"/><verse number="28" style="v" sid="JHN 12:28"/><char style="wj">Wuora, mi nyingi duongʼ!”</char></para>
  <para style="p" vid="JHN 12:28">Eka dwol moro noa e polo, kawacho niya, “Asemiye duongʼ kendo abiro chako amiye duongʼ.” <verse eid="JHN 12:28"/><verse number="29" style="v" sid="JHN 12:29"/>Oganda mane ni kanyo manowinjo dwolno nowacho ni polo ema nomor, to ji mamoko to nowacho ni malaika ema nowuoyo kode.<verse eid="JHN 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30"/>Yesu nokonegi niya, <char style="wj">“Dwolno ne ok obiro mondo okonya, to nobiro mondo okonyu.</char> <verse eid="JHN 12:30"/><verse number="31" style="v" sid="JHN 12:31"/><char style="wj">Koro sa osechopo ma ingʼadone piny bura, kendo sani ema ruodh pinyni noriemb oko.</char> <verse eid="JHN 12:31"/><verse number="32" style="v" sid="JHN 12:32"/><char style="wj">To an, bangʼ kosetingʼa malo mogola e pinyni, to anaywa ji duto ira.”</char> <verse eid="JHN 12:32"/><verse number="33" style="v" sid="JHN 12:33"/>Nowacho mano mondo onyisgo kit tho ma nobiro thogo.<verse eid="JHN 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34"/>Ogandano nodwoke niya, “Wasewinjo e chik ni Kristo biro siko nyaka chiengʼ, ka en kamano, to ikelo wacho nade ni, ‘<char style="wj">Wuod Dhano nyaka bi tingʼ malo’</char>? ‘Wuod Dhano’ miwuoyo kuomeno to en ngʼa?”<verse eid="JHN 12:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35"/>Eka Yesu nodwokogi niya, <char style="wj">“Pod ubiro bedo gi ler kuom ndalo manok. Wuothuru kapod un gi ler; ka mudho pok ojukou. Ngʼama wuotho e mudho okia kuma odhiye.</char> <verse eid="JHN 12:35"/><verse number="36" style="v" sid="JHN 12:36"/><char style="wj">Keturu genou kuom ler kapod un kode, mondo mi ubed nyithind ler.”</char> Kane Yesu osetieko wuoyo kodgi, to nowuok owegi kendo nopondonigi.<verse eid="JHN 12:36"/></para>
  <para style="s1">Jo-Yahudi otamore yie kuom Yesu</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37"/>To kata obedo ni Yesu nosetimo honnigo duto ka gineno gi wengegi, to pod ne gidagi mana yie kuome. <verse eid="JHN 12:37"/><verse number="38" style="v" sid="JHN 12:38"/>Mano notimore mondo ochop wach mane Isaya janabi osewacho niya,</para>
  <para style="q1" vid="JHN 12:38">“Jehova Nyasaye, en ngʼa moseyie wach mwalando,</para>
  <para style="q2" vid="JHN 12:38">koso en ngʼa ma Jehova Nyasaye osenyiso tekone?”<note caller="+" style="f"><char style="fr" closed="false">12:38 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:1">Isa 53:1</ref></char></char></note><verse eid="JHN 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39"/>Kuom mano, ne ok ginyal yie, mana kaka Isaya nowacho bende komachielo niya,<verse eid="JHN 12:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40"/>“Osedino wengegi</para>
  <para style="q2" vid="JHN 12:40">kendo osemiyo chunygi odoko matek,</para>
  <para style="q1" vid="JHN 12:40">mondo kik gine gimoro gi wengegi,</para>
  <para style="q2" vid="JHN 12:40">kendo kik giwinj tiend weche gi chunygi,</para>
  <para style="q2" vid="JHN 12:40">mi gilokre gidwog ira mi achang-gi.”<note caller="+" style="f"><char style="fr" closed="false">12:40 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 6:10">Isa 6:10</ref></char></char></note><verse eid="JHN 12:40"/></para>
  <para style="m">
    <verse number="41" style="v" sid="JHN 12:41"/>Isaya nowacho kamano nikech noneno duongʼ maler mar Yesu kendo nowuoyo kuome.<verse eid="JHN 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42"/>Kata kamano, e kindeno, ji mangʼeny kuom jotelo bende noyie kuome. To nikech negiluoro jo-Farisai, ne ok ginyal hulo yie margi e lela nimar negiluor ni dipo ka oriembgi e sinagogi. <verse eid="JHN 12:42"/><verse number="43" style="v" sid="JHN 12:43"/>Nimar ne gihero pak moa kuom dhano moloyo pak moa kuom Nyasaye.<verse eid="JHN 12:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44"/>Eka Yesu nokok matek kawacho niya, <char style="wj">“Ka ngʼato oyie kuoma, to an ok ema oyie kuoma kenda, to oyie kuom Jal mane oora bende.</char> <verse eid="JHN 12:44"/><verse number="45" style="v" sid="JHN 12:45"/><char style="wj">Ngʼama nena, neno Jal mane oora.</char> <verse eid="JHN 12:45"/><verse number="46" style="v" sid="JHN 12:46"/><char style="wj">Asebiro e piny kaka ler, mondo ngʼato angʼata moyie kuoma kik sik e mudho.</char><verse eid="JHN 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 12:47"/>
    <char style="wj">“To ngʼat mawinjo wechena to ok riti, to an ok angʼadne bura, nikech ne ok abiro mondo angʼadne piny bura, to nabiro mondo ares piny.</char> <verse eid="JHN 12:47"/><verse number="48" style="v" sid="JHN 12:48"/><char style="wj">Nitie Ngʼat mangʼado bura ne ngʼama odaga kendo ma ok oyie wechena. Ngʼama kamano wachna mane awacho ema biro ngʼadone bura marach chiengʼ giko piny.</char> <verse eid="JHN 12:48"/><verse number="49" style="v" sid="JHN 12:49"/><char style="wj">Nimar ne ok awuoyo gi dwacha awuon, to Wuoro ma noora ema nochika mondo awachi gik ma asebedo ka awacho kendo kaka onego awachgi.</char> <verse eid="JHN 12:49"/><verse number="50" style="v" sid="JHN 12:50"/><char style="wj">Angʼeyo ni chikne ema kelo ngima mochwere. Kuom mano, gimoro amora ma awacho en mana gima Wuora onyisa mondo awachi.”</char><verse eid="JHN 12:50"/></para>
  <chapter eid="JHN 12"/>
  <chapter number="13" style="c" sid="JHN 13"/>
  <para style="s1">Yesu olwoko tiend jopuonjrene</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1"/>Kane Sap Pasaka okayo machiegni, Yesu nongʼeyo ni sane osechopo mar wuok e pinyni mondo odog ir Wuoro. Kaka nosehero joge owuon mane ni e pinyni, koro noikore nyisogi herane matut mogik.<verse eid="JHN 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2"/>E kinde mane gichano chiemb odhiambo, noyudo Jachien oseketo paro marach e chuny Judas Iskariot, ma wuod Simon, mondo ondhog Yesu. <verse eid="JHN 13:2"/><verse number="3" style="v" sid="JHN 13:3"/>Yesu nongʼeyo ni Wuoro noseketo gik moko duto e bwo tekone, kendo ni noa ka Nyasaye kendo nobiro dok ir Nyasaye; <verse eid="JHN 13:3"/><verse number="4" style="v" sid="JHN 13:4"/>omiyo noa malo oweyo chiemo, kendo nongʼwano kandhone bangʼe otweyo taulo e nungone. <verse eid="JHN 13:4"/><verse number="5" style="v" sid="JHN 13:5"/>Bangʼ timo kamano, noolo pi e karaya bangʼe ochako luoko tiend jopuonjrene, kendo noyweyo tiendegi gi taulo mane oyudo otweyo e nungone.<verse eid="JHN 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6"/>Kane obiro ir Simon Petro, Petro nowachone niya, “Ruoth, idwaro luoko tienda adier?”<verse eid="JHN 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7"/>Yesu nodwoke niya, <char style="wj">“Ok inyal winjo tiend gima atimo, to ibiro winjo tiende bangʼe.”</char><verse eid="JHN 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8"/>Petro nonyise koramo niya, “Ooyo, Ruoth, ok inyal luoko tiendena ngangʼ.”</para>
  <para style="p" vid="JHN 13:8">Yesu nodwoke niya, <char style="wj">“Ka ok aluoko tiendi, to ok iwinjori bedo koda e kanyakla mar jopuonjrena.”</char><verse eid="JHN 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9"/>Simon Petro nodwoke niya, “Ruoth, ka kamano, to kik ilwok mana tienda kende, to luok bedena kod wiya bende!”<verse eid="JHN 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10"/>Yesu nodwoke niya, <char style="wj">“Ngʼat moseluokore onego olwok mana tiendene kende, nimar dende duto ler. Un usedoko maler, makmana ngʼato achiel kuomu kende ema ok ler.”</char> <verse eid="JHN 13:10"/><verse number="11" style="v" sid="JHN 13:11"/>Nikech nongʼeyo ngʼat mane biro ndhoge, mano emomiyo nowachonegi ni ok giler giduto.<verse eid="JHN 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12"/>Kane osetieko luoko tiendegi, norieyo kandhone bangʼe nodok obet piny. Nopenjogi niya, <char style="wj">“Bende ungʼeyo tiend gima asetimonuno?</char> <verse eid="JHN 13:12"/><verse number="13" style="v" sid="JHN 13:13"/><char style="wj">Uluonga kare ni ‘Japuonj’ kendo ni ‘Ruoth,’ kendo utimo kare, nikech mano e ngʼama an.</char> <verse eid="JHN 13:13"/><verse number="14" style="v" sid="JHN 13:14"/><char style="wj">Koro ka an ma an Ruodhu kendo Japuonju ema aselwoko tiendeu, un bende nyaka ulwok tiendeu ngʼato gi ngʼato.</char> <verse eid="JHN 13:14"/><verse number="15" style="v" sid="JHN 13:15"/><char style="wj">Aseketonu ranyisi mondo utim kaka asetimonu.</char> <verse eid="JHN 13:15"/><verse number="16" style="v" sid="JHN 13:16"/><char style="wj">Awachonu adier ni onge jatich maduongʼ moloyo ruodhe motiyone, kata jaote ok duongʼ moloyo ngʼama oore.</char> <verse eid="JHN 13:16"/><verse number="17" style="v" sid="JHN 13:17"/><char style="wj">Nikech koro ungʼeyo wechegi, nogwedhu kutiyo kodgi.”</char><verse eid="JHN 13:17"/></para>
  <para style="s1">Yesu owuoyo kuom thone</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18"/>
    <char style="wj">Yesu nomedo wuoyo kodgi niya, “Ok awuo kuomu un uduto, nimar angʼeyo joma aseyiero. To mano osetimore mondo ochop Ndiko mawacho ni, ‘Ngʼat machiemo koda bende osendhoga.’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13:18 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 41:9">Zab 41:9</ref>
        </char>
      </char>
    </note><verse eid="JHN 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 13:19"/>
    <char style="wj">“Koro anyisou wachni chon kapok otimore mondo kotimore, to ubiro yie ni An e Kristo.</char> <verse eid="JHN 13:19"/><verse number="20" style="v" sid="JHN 13:20"/><char style="wj">Awachonu adier, ni ngʼato angʼata morwako ngʼama aoro, orwaka, kendo ngʼama orwaka orwako jal ma noora.”</char><verse eid="JHN 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21"/>Bangʼ kane osewacho mano, Yesu nochandore gie chunye mi nohulonigi niya, <char style="wj">“Awachonu adier, ni achiel kuomu biro ndhoga.”</char><verse eid="JHN 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22"/>Jopuonjrene dhogi nomoko, kendo ne gingʼiyore kendgi ka giparo ni en ngʼa kuomgi ma nowuoyo kuome. <verse eid="JHN 13:22"/><verse number="23" style="v" sid="JHN 13:23"/>To noyudo japuonjre mane Yesu ohero, ne chiemo kobedo bute machiegni. <verse eid="JHN 13:23"/><verse number="24" style="v" sid="JHN 13:24"/>Simon Petro nogwelo japuonjreno kawacho niya, “Penje ane ngʼama owuoyo kuome.”<verse eid="JHN 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25"/>Nolokore motenore kuom Yesu mopenje niya, “Ruoth, en ngʼa?”<verse eid="JHN 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26"/>Yesu nodwoke niya, <char style="wj">“En ngʼama abiro miyo makatini bangʼ ka aselute e kado.”</char> Eka, bangʼ luto makati e kado, nomiye Judas Iskariot wuod Simon. <verse eid="JHN 13:26"/><verse number="27" style="v" sid="JHN 13:27"/>To kane Judas osekawo makatino, Satan nodonjo kuome.</para>
  <para style="p" vid="JHN 13:27">Yesu nokone niya, <char style="wj">“Gima idwaro timono, tim piyo.”</char> <verse eid="JHN 13:27"/><verse number="28" style="v" sid="JHN 13:28"/>To kuom joma ne chiemo kanyo, onge ngʼama nongʼeyo gimomiyo nowachone kamano. <verse eid="JHN 13:28"/><verse number="29" style="v" sid="JHN 13:29"/>To kaka Judas ne en jakeno mar pesa, jomoko ne paro ni Yesu nonyise mondo odhi ongʼiew gik mane dwarore e sawo, kata ni mondo ochiw gimoro ni jodhier. <verse eid="JHN 13:29"/><verse number="30" style="v" sid="JHN 13:30"/>Mapiyo bangʼ ka Judas nosekawo makatino, nowuok oweyogi. Koro ne en seche mag otieno.<verse eid="JHN 13:30"/></para>
  <para style="s1">Yesu okoro ni Petro biro kwede</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31"/>Kane Judas osedhi, Yesu nowacho niya, <char style="wj">“Wuod Dhano koro imiyo duongʼ sani kendo Nyasaye bende yudo duongʼ kuome.</char> <verse eid="JHN 13:31"/><verse number="32" style="v" sid="JHN 13:32"/><char style="wj">Ka Nyasaye oyudo duongʼ kuome, eka Wuowi bende biro yudo duongʼ kuome, kendo obiro miye duongʼ sani sani.</char><verse eid="JHN 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 13:33"/>
    <char style="wj">“Nyithinda, pod abiro bedo kodu kuom thuolo matin. Bangʼe ubiro manya, to mana kaka ne anyiso jo-Yahudi e kaka anyisou sani, ni kama adhiye un ok unyal bire.</char><verse eid="JHN 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 13:34"/>
    <char style="wj">“Amiyou chik manyien mawacho kama: Herreuru ngʼato gi ngʼato. Mana kaka aseherou e kaka nyaka uherru ngʼato gi ngʼato.</char> <verse eid="JHN 13:34"/><verse number="35" style="v" sid="JHN 13:35"/><char style="wj">Mano ema biro miyo ji duto ngʼeyo ni un jopuonjrena adier, ka uheroru ngʼato gi ngʼato.”</char><verse eid="JHN 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36"/>Simon Petro nopenje niya, “Ruoth, idhi kanye?”</para>
  <para style="p" vid="JHN 13:36">Yesu nodwoke niya, <char style="wj">“Kuma adhiye ok inyal luwae sani, to ibiro luwa kuno bangʼe.”</char><verse eid="JHN 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37"/>Petro nopenje niya, “Ruoth, angʼo momiyo ok anyal luwi sani? Aikora chiwo ngimana nikech in.”<verse eid="JHN 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38"/>Eka Yesu nodwoke niya, <char style="wj">“Bende inyalo chiwo ngimani nikech an adier? Anyisi ni kapok thuon gweno okok, wangʼ inikweda nyadidek!</char><verse eid="JHN 13:38"/></para>
  <chapter eid="JHN 13"/>
  <chapter number="14" style="c" sid="JHN 14"/>
  <para style="s1">Yesu ojiwo jopuonjrene</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1"/>
    <char style="wj">“Kik uwe chunyu chandre. Yieuru kuom Nyasaye, to An bende yieuru kuoma.</char> <verse eid="JHN 14:1"/><verse number="2" style="v" sid="JHN 14:2"/><char style="wj">E dala Wuora nitiere udi mangʼeny, kendo ka dine ok en kamano, to dikoro asenyisou. Adhi kuno mondo alosnu kar dak.</char> <verse eid="JHN 14:2"/><verse number="3" style="v" sid="JHN 14:3"/><char style="wj">To ka adhi mi alosonu kar dak, eka abiro duogo kawou mondo un bende ubed koda kama antiere.</char> <verse eid="JHN 14:3"/><verse number="4" style="v" sid="JHN 14:4"/><char style="wj">Ageno ni ungʼeyo yo madhi kuma adhiye.”</char><verse eid="JHN 14:4"/></para>
  <para style="s1">Yesu e yo madhi ka Wuoro</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5"/>Thoma nowachone niya, “Ruoth wakia kuma idhiye, koro ere kaka dwangʼe yo?”<verse eid="JHN 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6"/>Yesu nodwoke niya, <char style="wj">“An e yo kendo An e adiera bende An e ngima. Onge ngʼama nyalo biro ir Wuora ka ok okadho kuoma.</char> <verse eid="JHN 14:6"/><verse number="7" style="v" sid="JHN 14:7"/><char style="wj">Ka ungʼeya adier, to Wuora bende ubiro ngʼeyo. Chakre kawuononi ungʼeye kendo usenene.”</char><verse eid="JHN 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8"/>Filipo nowachone niya, “Ruoth, nyiswa Wuoro mondo kik wachak wachandi kendo.”<verse eid="JHN 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9"/>Yesu nodwoke niya, <char style="wj">“Filipo, asebedo kodu kuom kinde mangʼeny, kare in pok ingʼeya? Ngʼato angʼata mosenena oseneno Wuoro, koro ere kaka ikelo wacho ni, ‘Nyiswa Wuoro’?</char> <verse eid="JHN 14:9"/><verse number="10" style="v" sid="JHN 14:10"/><char style="wj">Donge iyie ni An ei Wuora kendo Wuora ni e iya? Weche ma awachonu ok gin mana wechena awuon. Chutho, Wuora modak e iya ema timo tichne.</char> <verse eid="JHN 14:10"/><verse number="11" style="v" sid="JHN 14:11"/><char style="wj">Yie koda ka awacho ni an ei Wuora kendo Wuora ni e iya; to ka ok kamano, to yie kuom ranyisi gi honni ma asebedo ka atimo.</char> <verse eid="JHN 14:11"/><verse number="12" style="v" sid="JHN 14:12"/><char style="wj">Awachonu adier, ni ngʼato ka ngʼato ma oyie kuoma biro timo gik ma asebedo ka atimo. Bende obiro timo gik madongo moloyo magi, nikech adhi ka Wuora.</char> <verse eid="JHN 14:12"/><verse number="13" style="v" sid="JHN 14:13"/><char style="wj">Abiro timo gimoro amora mukwayo e nyinga, eka Wuowi omi Wuoro duongʼ.</char> <verse eid="JHN 14:13"/><verse number="14" style="v" sid="JHN 14:14"/><char style="wj">Gimoro amora ma ukwayo e nyinga anatimnu.”</char><verse eid="JHN 14:14"/></para>
  <para style="s1">Yesu osingo ni jopuonjrene Roho Maler</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15"/>
    <char style="wj">“Ka uhera to ubiro timo gima achikou.</char> <verse eid="JHN 14:15"/><verse number="16" style="v" sid="JHN 14:16"/><char style="wj">Anakwa Wuoro, kendo obiro miyou Jakony machielo mondo obed kodu nyaka chiengʼ.</char> <verse eid="JHN 14:16"/><verse number="17" style="v" sid="JHN 14:17"/><char style="wj">Jakonyno en Roho mar adier. Piny ok nyal rwake, nikech ok ginyal nene kendo gikiaye. Un to ungʼeye, nimar odak kodu kendo obiro bet eiu.</char> <verse eid="JHN 14:17"/><verse number="18" style="v" sid="JHN 14:18"/><char style="wj">Ok abi weyou ka nyithi kiye; abiro biro iru.</char> <verse eid="JHN 14:18"/><verse number="19" style="v" sid="JHN 14:19"/><char style="wj">Odongʼ kinde matin to piny ok bi nena kendo. Un to pod ubiro nena, kendo ubiro bedo mangima nikech angima.</char> <verse eid="JHN 14:19"/><verse number="20" style="v" sid="JHN 14:20"/><char style="wj">Odiechiengʼno unungʼe ni an ei Wuora; kendo ni un e iya, kendo an eiu.</char> <verse eid="JHN 14:20"/><verse number="21" style="v" sid="JHN 14:21"/><char style="wj">Ngʼato angʼata mongʼeyo chikena kendo orito, e ngʼama ohera. Ngʼat mohera, Wuora biro hero, kendo an bende abiro here, mi afwenyrane.”</char><verse eid="JHN 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22"/>Eka Judas, ma ok Judas Iskariot, nowachone niya, “To Ruoth, angʼo momiyo wan ema idwaro fwenyorinwa to ok ni piny?”<verse eid="JHN 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23"/>Yesu nodwoke niya, <char style="wj">“Ka ngʼato ohera to obiro rito puonjna, Wuora biro here, kendo wabiro biro ire mi walos kar dakwa kode.</char> <verse eid="JHN 14:23"/><verse number="24" style="v" sid="JHN 14:24"/><char style="wj">Ngʼama ok ohera ok nyal timo gima apuonjo. Weche muwinjogi ok gin maga awuon, to gin mag Wuora mane oora.</char><verse eid="JHN 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25"/>
    <char style="wj">“Gigi duto asenyisou kapod an kodu.</char> <verse eid="JHN 14:25"/><verse number="26" style="v" sid="JHN 14:26"/><char style="wj">To Jakony, ma en Roho Maler, ma Wuora biro oro e nyinga, biro puonjou weche duto, kendo obiro paronu gik moko duto ma asenyisou.</char> <verse eid="JHN 14:26"/><verse number="27" style="v" sid="JHN 14:27"/><char style="wj">Aweyonu kwe; kwe mara ema amiyou. En kwe ma pinyni ok nyal miyou. Kik chunyu parre kendo kik ubed maluor.</char><verse eid="JHN 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 14:28"/>
    <char style="wj">“Ne uwinjo ka awacho niya, ‘Adhi to abiro duogo iru kendo.’ Ka dine bed ni uhera, to dine ubedo mamor ni adhi ka Wuora, nimar Wuora duongʼ moloya.</char> <verse eid="JHN 14:28"/><verse number="29" style="v" sid="JHN 14:29"/><char style="wj">Koro asenyisou kapok mano otimore, mondo ka gigo otimore to uyie.</char> <verse eid="JHN 14:29"/><verse number="30" style="v" sid="JHN 14:30"/><char style="wj">Ok abi wuoyo kodu amingʼa nimar ruodh pinyni biro, to oonge gi teko kuoma.</char> <verse eid="JHN 14:30"/><verse number="31" style="v" sid="JHN 14:31"/><char style="wj">Kata kamano, piny nyaka ngʼe ni ahero Wuora kendo ni atimo mana gima Wuora osechika mondo atim.</char></para>
  <para style="p" vid="JHN 14:31">
    <char style="wj">“Kuom mano, chunguru mondo wadhi.</char><verse eid="JHN 14:31"/></para>
  <chapter eid="JHN 14"/>
  <chapter number="15" style="c" sid="JHN 15"/>
  <para style="s1">Yadh mzabibu kod bedene</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1"/>
    <char style="wj">“An e mzabibu madier, kendo Wuora e japur mar mzabibuno.</char> <verse eid="JHN 15:1"/><verse number="2" style="v" sid="JHN 15:2"/><char style="wj">Bedena duto ma ok nyag olemo ongʼado oko, to bede duto manyago olemo olwero mondo omed nyak moloyo.</char> <verse eid="JHN 15:2"/><verse number="3" style="v" sid="JHN 15:3"/><char style="wj">Un usedoko maler nikech wach ma asewachonu.</char> <verse eid="JHN 15:3"/><verse number="4" style="v" sid="JHN 15:4"/><char style="wj">Sikuru kuoma, kaka an bende asiko kuomu, nikech onge bad yath manyalo nyago olemo kende owuon ka ok osiko e mzabibu. Un bende ok unyal nyago olemo ka ok usiko kuoma.</char><verse eid="JHN 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5"/>
    <char style="wj">“An e mzabibu, to un e bedene. Ka ngʼato osiko kuoma kendo an bende asiko kuome, to obiro nyago olemo mangʼeny, nimar onge gima unyalo timo ka upogoru koda.</char> <verse eid="JHN 15:5"/><verse number="6" style="v" sid="JHN 15:6"/><char style="wj">Ka ngʼato ok osiko kuoma, to ochalo gi bad yath motongʼ oko maner. Bede yath machal kamano ichoko kendo idiro e mach mi wangʼ.</char> <verse eid="JHN 15:6"/><verse number="7" style="v" sid="JHN 15:7"/><char style="wj">Ka usiko e iya kendo wechena osiko eiu, to unyalo kwayo gimoro amora ma chunyu gombo mi nomiu.</char> <verse eid="JHN 15:7"/><verse number="8" style="v" sid="JHN 15:8"/><char style="wj">Ka unyago olemo mangʼeny, to Wuora yudo duongʼ, kendo mano nyiso ni un jopuonjrena.</char><verse eid="JHN 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9"/>
    <char style="wj">“Mana kaka Wuoro osehera, e kaka an bende aseherou. Koro sikuru e herana.</char> <verse eid="JHN 15:9"/><verse number="10" style="v" sid="JHN 15:10"/><char style="wj">Ka urito chikena, to ubiro siko e herana, mana kaka an bende aserito chike Wuora kendo asiko e herane.</char> <verse eid="JHN 15:10"/><verse number="11" style="v" sid="JHN 15:11"/><char style="wj">Asenyisou wachni mondo morna obed eiu kendo mondo mor maru obed moromo chuth.</char> <verse eid="JHN 15:11"/><verse number="12" style="v" sid="JHN 15:12"/><char style="wj">Chik ma amiyou ema: Herreuru ngʼato gi ngʼato, mana kaka an bende aseherou.</char> <verse eid="JHN 15:12"/><verse number="13" style="v" sid="JHN 15:13"/><char style="wj">Onge hera maduongʼ ma ngʼato nyalo herogo osiepene moloyo chiwonegi ngimane.</char> <verse eid="JHN 15:13"/><verse number="14" style="v" sid="JHN 15:14"/><char style="wj">Un osiepena mana kutimo gik ma achikou.</char> <verse eid="JHN 15:14"/><verse number="15" style="v" sid="JHN 15:15"/><char style="wj">Koro ok achak aluongu ni wasumbini nikech misumba ok ongʼeyo gima ruodhe timo; to aluongou ni osiepena nimar asenyisou gik moko duto mane apuonjora kuom Wuora.</char> <verse eid="JHN 15:15"/><verse number="16" style="v" sid="JHN 15:16"/><char style="wj">Un ne ok uyiera, an ema nayierou kendo aketou mondo udhi unyag olemo, ma en olemo masiko. Eka Wuora biro miyou gimoro amora mukwayo e nyinga.</char> <verse eid="JHN 15:16"/><verse number="17" style="v" sid="JHN 15:17"/><char style="wj">Chik ma amiyou ema: Herreuru ngʼato gi ngʼato.</char><verse eid="JHN 15:17"/></para>
  <para style="s1">Piny ochayo jopuonjre</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18"/>
    <char style="wj">“Ka piny chayou, to ngʼeuru ni an ema ne gichaya mokwongo.</char> <verse eid="JHN 15:18"/><verse number="19" style="v" sid="JHN 15:19"/><char style="wj">Ka dine bed ni un mag pinyni, to piny dine oherou kaka joge owuon. Piny mon kodu nikech aseyierou, omiyo koro ok un mar pinyni.</char> <verse eid="JHN 15:19"/><verse number="20" style="v" sid="JHN 15:20"/><char style="wj">Paruru weche ma nawachonu ni, ‘Onge jatich maduongʼ moloyo ruodhe motiyone.’</char><note caller="+" style="f"><char style="fr" closed="false">15:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="JHN 13:16">Joh 13:16</ref></char></char></note> <char style="wj">Omiyo ka an ema gisesanda, to un bende gibiro sandou. Ka gimako puonjna, to puonju bende gibiro mako.</char> <verse eid="JHN 15:20"/><verse number="21" style="v" sid="JHN 15:21"/><char style="wj">Gibiro timonu kamano nikech nyinga, nimar gikia Jal mane oora.</char> <verse eid="JHN 15:21"/><verse number="22" style="v" sid="JHN 15:22"/><char style="wj">Ka dine ok abiro mi awuoyo kodgi, to dine ok buch richo oloyogi. To koro, onge wach ma ginyalo umogo richogi.</char> <verse eid="JHN 15:22"/><verse number="23" style="v" sid="JHN 15:23"/><char style="wj">Ngʼama ochaya, ochayo Wuora bende.</char> <verse eid="JHN 15:23"/><verse number="24" style="v" sid="JHN 15:24"/><char style="wj">Ka dine bed ni ne pok atimo honni ma ngʼato angʼata pok otimo e diergi, to buch richo dine ok oloyogi, to sani koro giseneno honnigi duto, eka pod gichaya kaachiel gi Wuora bende.</char> <verse eid="JHN 15:24"/><verse number="25" style="v" sid="JHN 15:25"/><char style="wj">Mago duto osetimore mana mondo ochop gima ondiki e chikgi ni, ‘Ne gichaya kayiem nono.’</char><note caller="+" style="f"><char style="fr" closed="false">15:25 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 35:19">Zab 35:19</ref>; <ref loc="PSA 69:4">69:4</ref></char></char></note><verse eid="JHN 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26"/>
    <char style="wj">“Ka Jakony ma abiro oronu koa ka Wuora, ma en Roho mar adier maa kuom Wuora nobi, enotim neno kuoma.</char> <verse eid="JHN 15:26"/><verse number="27" style="v" sid="JHN 15:27"/><char style="wj">To un bende nyaka utim nenda, nimar usebedo koda nyaka ne achak lando Injilini.</char><verse eid="JHN 15:27"/></para>
  <chapter eid="JHN 15"/>
  <chapter number="16" style="c" sid="JHN 16"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1"/>
    <char style="wj">“Asewachonu wechegi duto mondo kik ulal.</char> <verse eid="JHN 16:1"/><verse number="2" style="v" sid="JHN 16:2"/><char style="wj">Giniriembu e sinagogi; chutho ndalo biro ma ngʼama nonegu notim kamano kaparo ni otiyo ni Nyasaye.</char> <verse eid="JHN 16:2"/><verse number="3" style="v" sid="JHN 16:3"/><char style="wj">Ginitim kamano nikech ok gingʼeyo Wuora kata An.</char> <verse eid="JHN 16:3"/><verse number="4" style="v" sid="JHN 16:4"/><char style="wj">Asewachonu wechegi mondo ka ndalo ochopo to upar ni nasesiemou motelo. Ne ok awachonu wechegi chon nikech ne pod an kodu.</char><verse eid="JHN 16:4"/></para>
  <para style="s1">Tich mar Roho Maler</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5"/>
    <char style="wj">“Koro adhi ir Ngʼat mane oora, to onge ngʼato kuomu mapenja ni, ‘Idhi kanye?’</char> <verse eid="JHN 16:5"/><verse number="6" style="v" sid="JHN 16:6"/><char style="wj">Nikech gik ma asewachonu, omiyo un gi kuyo.</char> <verse eid="JHN 16:6"/><verse number="7" style="v" sid="JHN 16:7"/><char style="wj">To awachonu adier ni dhi ma adhigo biro kelonu ber. Ka ok adhi, to Jakony ok bi bironu; to ka adhi eka abiro oronugo.</char> <verse eid="JHN 16:7"/><verse number="8" style="v" sid="JHN 16:8"/><char style="wj">Ka obiro, nopuonj piny mondo ongʼe tiend richo, tim makare kod kum mabiro.</char> <verse eid="JHN 16:8"/><verse number="9" style="v" sid="JHN 16:9"/><char style="wj">Obiro nyisogi ni tamruok yie Kuoma en richo.</char> <verse eid="JHN 16:9"/><verse number="10" style="v" sid="JHN 16:10"/><char style="wj">Bende ka adok ir Wuora, kuma ok ginyal nenae, to giningʼe ni an ngʼat makare;</char> <verse eid="JHN 16:10"/><verse number="11" style="v" sid="JHN 16:11"/><char style="wj">kendo abiro nyisogi kuom kum mabiro, nikech ruodh pinyni koro bura oseloyo.</char><verse eid="JHN 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12"/>
    <char style="wj">“An gi weche mangʼeny monego awachnu, to ok unyal winjo tiendgi sani.</char> <verse eid="JHN 16:12"/><verse number="13" style="v" sid="JHN 16:13"/><char style="wj">To ka Roho mar adiera, osebiro, to enopuonju adiera duto. Ok enobed janeno kuome owuon, to nowachnu mana gik mosebedo kowinjo kendo obiro nyisou gik mabiro timore bangʼe.</char> <verse eid="JHN 16:13"/><verse number="14" style="v" sid="JHN 16:14"/><char style="wj">Enomiya duongʼ, nikech gik ma enowachnu nokaw kuoma.</char> <verse eid="JHN 16:14"/><verse number="15" style="v" sid="JHN 16:15"/><char style="wj">Gik moko duto ma Wuora nigo gin maga. Mano emomiyo ne awachonu ni gik moko duto ma Roho nowachnu nogol kuoma.”</char><verse eid="JHN 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16"/>Yesu nowacho bende niya, <char style="wj">“Odongʼ ndalo matin to ok ubi nena, to bangʼe matin achien ubiro nena kendo.”</char><verse eid="JHN 16:16"/></para>
  <para style="s1">Kuyo mar jopuonjre biro lokore mor</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17"/>Moko kuom jopuonjrene nopenjore e kindgi giwegi niya, “Ere tiend gima owachonwa ni, <char style="wj">‘Bangʼ kinde matin ok ubi nena, to achien unuchak unena,’</char> kendo owacho bende ni <char style="wj">‘adhi ka Wuoro’</char>?” <verse eid="JHN 16:17"/><verse number="18" style="v" sid="JHN 16:18"/>Negimedo penjore kendgi niya, “Ere gima oparo kowacho ni, <char style="wj">‘Kinde matin</char>?’ Ok wangʼeyo gima owacho.”<verse eid="JHN 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19"/>Yesu noneno ka gidwaro penje tiend wachno, omiyo nowachonegi niya, <char style="wj">“Dibed ni upenjoru e kindu tiend gima ne awachonu ni, ‘Odongʼ ndalo matin to ok ubi nena, to bangʼe matin achien ubiro nena?’</char> <verse eid="JHN 16:19"/><verse number="20" style="v" sid="JHN 16:20"/><char style="wj">Adier, adier awachonu, ni ubiro goyo nduru kendo ubiro ywak ka piny to winjo maber. Kuyo to ubiro kuyo, to kata kamano kuyo maru biro lokore mor achien.</char> <verse eid="JHN 16:20"/><verse number="21" style="v" sid="JHN 16:21"/><char style="wj">Dhako madwaro nywolo nyathi nyaka muoch kaa nikech sane ochopo; to bangʼ nywolo nyathine, wiye wil gi muoch, nikech omor ni osenywolo dhano mangima e piny.</char> <verse eid="JHN 16:21"/><verse number="22" style="v" sid="JHN 16:22"/><char style="wj">Kamano un bende sani en sau mar kuyo, to ubiro bedo mamor ka ananeu bangʼe, kendo onge ngʼama nomau mor maru.</char> <verse eid="JHN 16:22"/><verse number="23" style="v" sid="JHN 16:23"/><char style="wj">Chiengʼno ok unukwaya gimoro amora. Awachonu adier ni Wuora biro miyou gimoro amora mukwayo e nyinga.</char> <verse eid="JHN 16:23"/><verse number="24" style="v" sid="JHN 16:24"/><char style="wj">Nyaka sani pok ukwayo gimoro amora e nyinga. Kwauru to nomiu, eka nubed mamor chuth.</char><verse eid="JHN 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25"/>
    <char style="wj">“Kata obedo ni asebedo ka awuoyonu gi ngeche, to ndalo biro ma ok nawuo kodu kamano, to ananyisu maler kuom Wuora.</char> <verse eid="JHN 16:25"/><verse number="26" style="v" sid="JHN 16:26"/><char style="wj">Chiengʼno unukwa Wuoro e nyinga. Ok awach ni an ema nakwa Wuoro karu.</char> <verse eid="JHN 16:26"/><verse number="27" style="v" sid="JHN 16:27"/><char style="wj">Ooyo, Wuoro owuon oherou nikech usehera kendo useyie ni ne aa ka Nyasaye.</char> <verse eid="JHN 16:27"/><verse number="28" style="v" sid="JHN 16:28"/><char style="wj">Ne aa ka Wuoro mi adonjo e piny, to sani koro aweyo piny kendo adok ir Wuoro.”</char><verse eid="JHN 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29"/>Eka jopuonjre Yesu nowachone niya, “Ero koro iwuoyo kodwa maler ma ok itiyo gi ngeche. <verse eid="JHN 16:29"/><verse number="30" style="v" sid="JHN 16:30"/>Koro wayie ni ingʼeyo gik moko duto kendo ni onge tiende mondo ngʼato ochandi gi penjo mathoth. Mano omiyo wayie ni ne ia ka Nyasaye.”<verse eid="JHN 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31"/>Yesu nodwokogi niya, <char style="wj">“Kare ber ka koro uyie!</char> <verse eid="JHN 16:31"/><verse number="32" style="v" sid="JHN 16:32"/><char style="wj">To ndalo biro, kendo osechopo ma unukerue, ka ngʼato ka ngʼato kuomu ringo dok dalane. Unuweya mi adongʼ kenda, kata kamano ok an kenda, nimar Wuora ni koda.</char><verse eid="JHN 16:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 16:33"/>
    <char style="wj">“Asenyisou gigi mondo uyud kwe moa kuoma. E pinyni ubiro neno chandruok, to beduru gi chir nikech aseloyo piny.”</char><verse eid="JHN 16:33"/></para>
  <chapter eid="JHN 16"/>
  <chapter number="17" style="c" sid="JHN 17"/>
  <para style="s1">Yesu olamo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1"/>Kane Yesu osetieko wacho wechegi, nongʼiyo polo bangʼe olamo kama:</para>
  <para style="pm" vid="JHN 17:1">
    <char style="wj">“Wuora, sa osechopo. Mi Wuodi duongʼ mondo Wuodi bende omiyi duongʼ.</char> <verse eid="JHN 17:1"/><verse number="2" style="v" sid="JHN 17:2"/><char style="wj">Nimar isemiye loch ewi ji duto mondo omi ji duto misemiye oyud ngima mochwere.</char> <verse eid="JHN 17:2"/><verse number="3" style="v" sid="JHN 17:3"/><char style="wj">To ngima mochwere ema: ni mondo gingʼeyi in Nyasaye makende mar adier, kod Yesu Kristo, Jal miseoro.</char> <verse eid="JHN 17:3"/><verse number="4" style="v" sid="JHN 17:4"/><char style="wj">Asemiyi duongʼ e piny kuom tieko tich mane imiya mondo atim.</char> <verse eid="JHN 17:4"/><verse number="5" style="v" sid="JHN 17:5"/><char style="wj">To koro, Wuora, miya duongʼ e nyimi machal gi duongʼ mane an-go kodi kane piny pok obetie.</char><verse eid="JHN 17:5"/></para>
  <para style="s1">Yesu olemo ne jopuonjrene</para>
  <para style="pm">
    <verse number="6" style="v" sid="JHN 17:6"/>
    <char style="wj">“Asehulo nyingi ni joma ne imiya e piny. Ne gin jogi, to ne imiyagi, kendo koro girito wachni.</char> <verse eid="JHN 17:6"/><verse number="7" style="v" sid="JHN 17:7"/><char style="wj">Koro gingʼeyo ni gik moko duto ma isemiya oa kuomi.</char> <verse eid="JHN 17:7"/><verse number="8" style="v" sid="JHN 17:8"/><char style="wj">Nimar ne amiyogi weche mane imiya kendo ne girwakogi. Gisengʼeyo gadier ni ne aa iri, kendo giseyie ni ne iora.</char> <verse eid="JHN 17:8"/><verse number="9" style="v" sid="JHN 17:9"/><char style="wj">Koro alamonegi. Ok alam ni piny, to alamo ni joma isemiya, nimar gin magi.</char> <verse eid="JHN 17:9"/><verse number="10" style="v" sid="JHN 17:10"/><char style="wj">Giga duto gin magi, kendo gigi duto gin maga, kendo aseyudo duongʼ kuomgi.</char> <verse eid="JHN 17:10"/><verse number="11" style="v" sid="JHN 17:11"/><char style="wj">Koro ndalona mag bet e piny orumo, nimar abiro iri, to gin pod gin e piny. Yaye Wuoro Maler, ritgi gi teko mar nyingi mane imiya, mondo gibed achiel mana kaka wan kodi wan achiel.</char> <verse eid="JHN 17:11"/><verse number="12" style="v" sid="JHN 17:12"/><char style="wj">Kane pod an kodgi, to nachikogi kendo naritogi maber gi nying mane imiya. Onge kata achiel kuomgi moselal, makmana ngʼatno mane ochan ni nyaka lal mondo Ndiko ochop kare.</char><verse eid="JHN 17:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="JHN 17:13"/>
    <char style="wj">“Koro abiro iri, to awacho gigi kapod an e piny, mondo gibed gi morna mogundho eigi.</char> <verse eid="JHN 17:13"/><verse number="14" style="v" sid="JHN 17:14"/><char style="wj">Asemiyogi wachni, kendo piny ochayogi, nimar ok gin mag pinyni, mana kaka an bende ok an mar pinyni.</char> <verse eid="JHN 17:14"/><verse number="15" style="v" sid="JHN 17:15"/><char style="wj">Ok alam mondo igolgi oko e piny, to alamo ni iritgi mondo kik Ngʼama Rach timnegi marach.</char> <verse eid="JHN 17:15"/><verse number="16" style="v" sid="JHN 17:16"/><char style="wj">Ok gin mag pinyni, mana kaka an bende ok an mar pinyni.</char> <verse eid="JHN 17:16"/><verse number="17" style="v" sid="JHN 17:17"/><char style="wj">Pwodhgi gi adierani, nikech Wachni en adiera.</char> <verse eid="JHN 17:17"/><verse number="18" style="v" sid="JHN 17:18"/><char style="wj">Kaka ne iora e piny e kaka an bende aseorogi e piny.</char> <verse eid="JHN 17:18"/><verse number="19" style="v" sid="JHN 17:19"/><char style="wj">Apwodhora nikech gin, mondo omi gin bende gipwodhreni gi adiera.</char><verse eid="JHN 17:19"/></para>
  <para style="s1">Yesu olemo ne joma oyie duto</para>
  <para style="pm">
    <verse number="20" style="v" sid="JHN 17:20"/>
    <char style="wj">“Ok alam ni gin kendgi, to alamo bende ni jogo mabiro yie kuoma bangʼ ka gisepuonjogi.</char> <verse eid="JHN 17:20"/><verse number="21" style="v" sid="JHN 17:21"/><char style="wj">Yaye Wuora, mi gibed achiel, mana kaka in e iya kendo an e iyi. Mad gin bende gibed e achiel kodwa, mondo piny oyie ni iseora.</char> <verse eid="JHN 17:21"/><verse number="22" style="v" sid="JHN 17:22"/><char style="wj">Asemiyogi duongʼ mane imiya, mondo gibed achiel kaka wan achiel,</char> <verse eid="JHN 17:22"/><verse number="23" style="v" sid="JHN 17:23"/><char style="wj">ka an kuomgi kendo in kuoma. Mad giriwre gibed gimoro achiel mondo piny ongʼe ni ne iora, kendo ni iseherogi mana kaka isehera.</char><verse eid="JHN 17:23"/></para>
  <para style="pm">
    <verse number="24" style="v" sid="JHN 17:24"/>
    <char style="wj">“Wuora, adwaro ni joma isemiya obed koda kama antie, kendo ni gine duongʼna, ma en duongʼno misemiya nikech ne ihera kapok nochwe piny.</char><verse eid="JHN 17:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="JHN 17:25"/>
    <char style="wj">“Wuoro Makare, kata obedo ni piny ok ongʼeyi, an to angʼeyi, kendo jogi bende ongʼeyo ni ne iora.</char> <verse eid="JHN 17:25"/><verse number="26" style="v" sid="JHN 17:26"/><char style="wj">Asehulonegi nyingi, kendo pod abiro medo nyiso ji ngʼama in, mondo hera miherago obed kuomgi, kendo an awuon bende abed kuomgi.”</char><verse eid="JHN 17:26"/></para>
  <chapter eid="JHN 17"/>
  <chapter number="18" style="c" sid="JHN 18"/>
  <para style="s1">Yesu omaki</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1"/>Kane Yesu osetieko lemo, nowuok gi jopuonjrene, mine gingʼado holo mar Kidron. Loka mar holono ne nitie puodho moro mane nigi yiende mag Zeituni, kendo Yesu nodonjo kanyo kaachiel gi jopuonjrene.<verse eid="JHN 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 18:2"/>To Judas, mane oyudo ondhoge, nongʼeyo kanyo, nikech Yesu ne thoro romo gi jopuonjrene kanyo. <verse eid="JHN 18:2"/><verse number="3" style="v" sid="JHN 18:3"/>Omiyo Judas nobiro e puodhono, kotelone migawo mar jolweny kod jotelo moko ma noa ir jodolo madongo gi jo-Farisai. Negitingʼo toje gi teyni kod gige lweny.<verse eid="JHN 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 18:4"/>To kaka Yesu nongʼeyo gik moko duto mane biro timorene, nowuok oko mopenjogi niya, <char style="wj">“En ngʼa mudwaro?”</char><verse eid="JHN 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5"/>Negidwoko niya, “Wadwaro Yesu ma jo-Nazareth.” Yesu nowachonegi niya,</para>
  <para style="p" vid="JHN 18:5">
    <char style="wj">“An e en.”</char> (To Judas mane ndhoge bende nochungʼ kodgi kanyo). <verse eid="JHN 18:5"/><verse number="6" style="v" sid="JHN 18:6"/>Kane Yesu owachonegi niya, <char style="wj">“An e En,”</char> negigoyo okangʼ gidok chien mi gipodho piny.<verse eid="JHN 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 18:7"/>Nochako openjogi niya, <char style="wj">“En ngʼa mudwaro?”</char></para>
  <para style="p" vid="JHN 18:7">Kendo neginwoyone niya, “Wadwaro Yesu ma jo-Nazareth.”<verse eid="JHN 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8"/>Yesu nodwokogi niya,<char style="wj">“Donge asenyisou ni An e En. Ka an ema umanya, to weuru jogi odhi mondi.”</char> <verse eid="JHN 18:8"/><verse number="9" style="v" sid="JHN 18:9"/>Mano notimore mondo weche mane Yesu oyudo osewacho ochop kare. Nonyisogi niya, <char style="wj">“Onge kata ngʼato achiel moselal kuom joma ne imiya.”</char><note caller="+" style="f"><char style="fr" closed="false">18:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="JHN 6:39">Joh 6:39</ref></char></char></note><verse eid="JHN 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10"/>Eka Simon Petro, mane oyudo nigi ligangla, nowuodho liganglane kendo notongʼo jatij jadolo maduongʼ mi ochodo ite ma korachwich, kendo nying jatijno ne en Malko.<verse eid="JHN 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 18:11"/>Yesu nokwero Petro kowachone niya, <char style="wj">“Dwok liganglani e olalo! Idwaro mona metho e okombe ma Wuora osemiya nangʼo?”</char><verse eid="JHN 18:11"/></para>
  <para style="s1">Oter Yesu ir Anas jadolo</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12"/>Eka migawo mar jolweny gi jatendgi kod jotend jo-Yahudi nomako Yesu. Ne gitweye <verse eid="JHN 18:12"/><verse number="13" style="v" sid="JHN 18:13"/>mi gitere ir Anas. Anas ne en jadolo maduongʼ e higano bende ne en jaduongʼ Kaifas. <verse eid="JHN 18:13"/><verse number="14" style="v" sid="JHN 18:14"/>Kaifas e ngʼama noyudo osengʼado rieko ni jo-Yahudi ni ber mondo ngʼato achiel otho ni ji duto.<verse eid="JHN 18:14"/></para>
  <para style="s1">Petro okwedo Yesu mokwongo</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15"/>Simon Petro gi japuonjre machielo noluwo bangʼ Yesu. To nikech japuonjre machielono ne jadolo maduongʼ ongʼeyo, nodonjo gi Yesu nyaka ei laru mar jadolo maduongʼ, <verse eid="JHN 18:15"/><verse number="16" style="v" sid="JHN 18:16"/>to Petro to nodongʼ karito e dhoot oko. Japuonjre machielo ma jadolo maduongʼ nongʼeyono noduogo mowuoyo gi nyako mane rito welo madonjo mi nokawo Petro gidonjogo iye.<verse eid="JHN 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 18:17"/>Nyako mane ni e dhootno nopenjo Petro niya, “Donge in bende in achiel kuom jopuonjre ngʼatni, koso ariambo?”</para>
  <para style="p" vid="JHN 18:17">Nodwoke niya, “Ooyo, ok an.”<verse eid="JHN 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18"/>To nikech piny ne ngʼich, jotich gi jotelo nochungʼ kolworo mach manoyudo gisemoko mondo gio. Petro bende nochungʼ kodgi kanyo kaoyo mach.<verse eid="JHN 18:18"/></para>
  <para style="s1">Jadolo maduongʼ oyalo Yesu</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19"/>E thuolono jadolo maduongʼ nomiyo Yesu penjo kuom wach jopuonjrene kod puonjne.<verse eid="JHN 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 18:20"/>Yesu nodwoke niya, <char style="wj">“Asebedo ka awuoyo e lela ni oganda, kendo asebedo ka apuonjo ei sinagoke gi hekalu, kuonde ma jo-Yahudi duto chokoree. Onge gimoro amora masewacho lingʼ-lingʼ.</char> <verse eid="JHN 18:20"/><verse number="21" style="v" sid="JHN 18:21"/><char style="wj">En angʼo momiyo umiya penjo? Penjuru joma osebedo ka winja. Gin gingʼeyo maber gima nawacho.”</char><verse eid="JHN 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22"/>Kane Yesu owacho kamano, achiel kuom askeche mane ochungʼ bute nothalo lembe kawacho niya, “Kamano e kaka inyalo dwoko jadolo maduongʼ adier?”<verse eid="JHN 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23"/>To Yesu nodwoke niya, <char style="wj">“Kapo ni awachone gimoro amora marach to hul ane gino. To kapo nawacho adier to ithala nangʼo?”</char> <verse eid="JHN 18:23"/><verse number="24" style="v" sid="JHN 18:24"/>Eka Anas nochiwo Yesu mondo oter ir Kaifas, jadolo maduongʼ, ka pod otweye.<verse eid="JHN 18:24"/></para>
  <para style="s1">Petro okwedo Yesu kendo</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25"/>Kane oyudo Simon Petro pod ochungʼ oyo mach, negipenje niya, “Idagi ni ok in achiel kuom jopuonjrene, koso iyie?”</para>
  <para style="p" vid="JHN 18:25">Nodagi kowacho niya, “Ooyo, ok an.”<verse eid="JHN 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26"/>Achiel kuom jotich jadolo maduongʼ mane en wat ngʼat mane Petro ongʼado ite cha, nochome tir, kapenje niya, “Donge nende aneni kode e puoth Zeituni?” <verse eid="JHN 18:26"/><verse number="27" style="v" sid="JHN 18:27"/>To Petro nochako okwer kendo, kendo gikanyono thuon gweno nochako kok.<verse eid="JHN 18:27"/></para>
  <para style="s1">Yesu oter e nyim Pilato</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28"/>Eka jo-Yahudi nokawo Yesu koa ir Kaifas motere nyaka e od ruoth Pilato. Sechego koro piny nosechako yawore, omiyo jo-Yahudi ne ok odonjo ei dala ruoth, mondo kik gibed mogak. Negidwaro ni gicham Pasaka ka giler. <verse eid="JHN 18:28"/><verse number="29" style="v" sid="JHN 18:29"/>Omiyo Pilato nowuoknigi oko mopenjogi niya, “Ngʼatni udonjone gi ketho mage?”<verse eid="JHN 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30"/>Negidwoke niya, “Ka dine bed ni ok en jaketho, to dine ok wakele e nyimi ka.”<verse eid="JHN 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31"/>Pilato nowachonegi niya, “Kaweuru un uwegi udhi ungʼadne bura kaka chiku dwaro.”</para>
  <para style="p" vid="JHN 18:31">To jo-Yahudi nodagi, kagiwacho niya, “Wan waonge gi teko mar ngʼado ne ngʼato buch tho.” <verse eid="JHN 18:31"/><verse number="32" style="v" sid="JHN 18:32"/>Mano notimore mondo weche Yesu mane oyudo osewacho kuom tho mane obiro thogo ochop kare.<verse eid="JHN 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33"/>Eka Pilato nodok e ode, kendo noluongo Yesu ire mopenje niya, “In e ruodh jo-Yahudi?”<verse eid="JHN 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34"/>Yesu nopenje niya, <char style="wj">“Gima ipenjano oa e pachi iwuon koso jomoko nono ema owachonigo kuoma?”</char><verse eid="JHN 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35"/>Pilato nodwoke niya, “Iparo ni an bende an ja-Yahudi? Jou owuon gi jodolou madongo ema oketi e lweta. Nyisa, en angʼo misetimo?”<verse eid="JHN 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36"/>Yesu nodwoke niya, <char style="wj">“Pinyruodha ok en mar pinyni. Ka dine bed ni en, to jotichna dine ogore mi gitamo jo-Yahudi maka. To koroni, pinyruodha aa kamachielo.”</char><verse eid="JHN 18:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37"/>Pilato nowacho niya, “Kare in ruoth?”</para>
  <para style="p" vid="JHN 18:37">Yesu nodwoko niya, <char style="wj">“In kare kuom wacho ni an ruoth. Chutho mano emomiyo nonywola, kendo mano emomiyo ne abiro e pinyni, mondo atim neno kuom adiera. Ngʼato ka ngʼato ma jakora adiera winja.”</char><verse eid="JHN 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38"/>Pilato nopenje niya, “Adiera en angʼo?” Bangʼ penjo kamano to nochako odok oko ir jo-Yahudi, mi owachonegi niya, “Ok ayudo ketho kata achiel kuom ngʼatni minyalo ngʼadnego bura. <verse eid="JHN 18:38"/><verse number="39" style="v" sid="JHN 18:39"/>To kaka en kitu mondo agonynu achiel kuom joma otwe e kinde mag sawo mar Pasaka, duher mondo agonynu ‘ruodh jo-Yahudi’ koso?”<verse eid="JHN 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40"/>To ne gikokne matek, kagiwacho riat niya, “Ooyo, ok en! Barabas ema imiwa!” Barabas ne en jamecho.<verse eid="JHN 18:40"/></para>
  <chapter eid="JHN 18"/>
  <chapter number="19" style="c" sid="JHN 19"/>
  <para style="s1">Ongʼadne Yesu buch tho</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1"/>Eka Pilato nokawo Yesu mi ochiwe mondo ochwade. <verse eid="JHN 19:1"/><verse number="2" style="v" sid="JHN 19:2"/>Jolweny nokado osimbo mar kudho, mi gisidhone kendo negiketo e wiye. Ne girwakone kandho makwar, <verse eid="JHN 19:2"/><verse number="3" style="v" sid="JHN 19:3"/>kendo negisiko ka gidhi ire sa ka sa kagiwachone niya, “Ruodh jo-Yahudi, mondo omi duongʼ!” Negisiko ka githalo lembe.<verse eid="JHN 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4"/>Pilato nochako owuok oko kendo mowacho ni jo-Yahudi niya, “Neuru, eri akele e nyimu mondo ungʼe ni ok ayudo ketho kata achiel kuome minyalo ngʼadnego bura.” <verse eid="JHN 19:4"/><verse number="5" style="v" sid="JHN 19:5"/>Kane Yesu owuok oko korwako osimbo mar kudho gi kandho makwar, Pilato nowachonegi niya, “Eri ngʼatno!”<verse eid="JHN 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6"/>E sa ma jodolo madongo gi jotendgi nonene, negigoyo koko matek niya, “Gure! Gure!”</para>
  <para style="p" vid="JHN 19:6">To Pilato nowachonegi niya, “Kaweuru un uwegi udhi ugure. An ok ayudo ketho moro amora kuome minyalo ngʼadonego bura.”<verse eid="JHN 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7"/>To jo-Yahudi nokone koramo niya, “Wan gi chik, kendo kaluwore gi chikwano, nyaka otho, nikech noketore ni en Wuod Nyasaye.”<verse eid="JHN 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8"/>Kane Pilato owinjo mano, luoro nomedo make moloyo, <verse eid="JHN 19:8"/><verse number="9" style="v" sid="JHN 19:9"/>omiyo nochako odok e ode, mopenjo Yesu niya, “In jakanye?” To Yesu ne ok odwoke. <verse eid="JHN 19:9"/><verse number="10" style="v" sid="JHN 19:10"/>Pilato nowachone niya, “Idagi wuoyo koda nangʼo? Bende ingʼeyo ni an gi teko ma anyalo gonyigo kata gurigo?”<verse eid="JHN 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11"/>Yesu nodwoke niya, <char style="wj">“Ok dibedo gi teko moro amora kuoma ka dine bed ni ok omiyigo koa malo. Kuom mano ngʼama noketa e lweti nigi ketho maduongʼ moloyo richo misetimo.”</char><verse eid="JHN 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12"/>Kochakore e sechego, Pilato notemo gonyo Yesu, kata kamano jo-Yahudi nomedo kok matek kagiwacho niya, “Kiweyo ngʼatni thuolo modhi, to ok in osiep Kaisar. Ngʼato ka ngʼato ma ketore ni en ruoth, kedo gi Kaisar.”<verse eid="JHN 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13"/>Kane Pilato owinjo mano, nogolo Yesu oko kendo nobet piny e kome mar ngʼado bura kama iluongo ni Laru motingʼore malo mar kidi (miluongo gi dho jo-Hibrania ni Gabatha). <verse eid="JHN 19:13"/><verse number="14" style="v" sid="JHN 19:14"/>Ne en chiengʼ ikruok mar jumb Pasaka, kar sa auchiel.</para>
  <para style="p" vid="JHN 19:14">Pilato nowachone jo-Yahudi niya, “Ma e Ruodhu!”<verse eid="JHN 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15"/>To ne gikok niya, “Gole e wangʼwa! Gole e wangʼwa! Gure!”</para>
  <para style="p" vid="JHN 19:15">Pilato nopenjogi niya, “Udwaro ni agur ruodhu?”</para>
  <para style="p" vid="JHN 19:15">Jodolo madongo nodwoke niya, “Wan waonge gi ruoth machielo makmana Kaisar kende.”<verse eid="JHN 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16"/>Eka Pilato nokete e lwetgi mondo gigure,</para>
  <para style="s1" vid="JHN 19:16">Ogur Yesu</para>
  <para style="p" vid="JHN 19:16">kendo jolweny nokawo Yesu modhigo. <verse eid="JHN 19:16"/><verse number="17" style="v" sid="JHN 19:17"/>Yesu nowuok kanyo kotingʼo msalape owuon nyaka kar Hanga Wich (miluongo gi dho jo-Hibrania ni Golgotha). <verse eid="JHN 19:17"/><verse number="18" style="v" sid="JHN 19:18"/>Negigure kanyo, kaachiel gi ji ariyo mamoko. Yesu ne ogur e diere, ka ngʼato achiel ni e bathe konchiel to moro e bathe komachielo.<verse eid="JHN 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 19:19"/>Pilato ne nigi milome moro ma nondiko bangʼe oguro ewi msalaba gimalo. Nondike niya:</para>
  <para style="pc" vid="JHN 19:19">Ma en Yesu Ja-Nazareth, Ruodh Jo-Yahudi.<verse eid="JHN 19:19"/></para>
  <para style="m">
    <verse number="20" style="v" sid="JHN 19:20"/>Jo-Yahudi mangʼeny nosomo ndikono, nimar kama nogure Yesu ne ni machiegni gi dala maduongʼ, kendo milomeno nondiki e dho jo-Hibrania, gi Latin kod dho jo-Yunani. <verse eid="JHN 19:20"/><verse number="21" style="v" sid="JHN 19:21"/>To jodolo madongo mag jo-Yahudi nokwedo gima ne Pilato ondikono kagiwacho niya, “We ndiko ni ‘Ruodh jo-Yahudi,’ ndik ni, ngʼatni noketore ni en ruodh jo-Yahudi.”<verse eid="JHN 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22"/>Pilato nowacho niya, “Gima asendiko, asendiko.”<verse eid="JHN 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23"/>Kane jolweny oseguro Yesu, negikawo lepe mi gipogogi nyadingʼwen, bangʼe gipogore moro ka moro, kargi ji angʼwen. Lawe mar kandho kende ema ne giweyo. En ne oonge gi wangʼ usi, to notwangʼe machalre, chakre malo nyaka piny.<verse eid="JHN 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 19:24"/>Negiwacho e kindgi giwegi niya, “En kik wayieche. Wagouru ombulu e dierwa mondo wangʼe ngʼama kawe.”<note caller="+" style="f"><char style="fr" closed="false">19:24 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:18">Zab 22:18</ref></char></char></note></para>
  <para style="p" vid="JHN 19:24">Mano notimore mondo Ndiko ochop kare manowacho niya,</para>
  <para style="q1" vid="JHN 19:24">“Ne gipogore lepa e kindgi giwegi</para>
  <para style="q2" vid="JHN 19:24">kendo gigoyo ombulu ne nangana.”</para>
  <para style="m" vid="JHN 19:24">Mano e kaka ne jolwenygo notimo.<verse eid="JHN 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25"/>Min Yesu gi nyamin min-gi, gi Maria ma chi Kiliopa kod Maria ma aa Magdala nochungʼ but msalaba. <verse eid="JHN 19:25"/><verse number="26" style="v" sid="JHN 19:26"/>Kane Yesu oneno min-gi gi japuonjre ma nohero kochungʼ machiegni kanyo, nowachone min-gi niya, <char style="wj">“Mama, neye wuodi!”</char> <verse eid="JHN 19:26"/><verse number="27" style="v" sid="JHN 19:27"/>Nowacho bende ni japuonjreno niya, <char style="wj">“Neye mamau!”</char> Chakre chiengʼno japuonjreno nokawe odhi kode dalane owuon.<verse eid="JHN 19:27"/></para>
  <para style="s1">Tho mar Yesu</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28"/>Bangʼ, kane koro osengʼeyo ni gik moko duto osetimore kaka dwarore, mondo Ndiko ochop kare, Yesu nowacho niya, <char style="wj">“Riyo oloya.”</char> <verse eid="JHN 19:28"/><verse number="29" style="v" sid="JHN 19:29"/>To ne nitie njagi motingʼo kongʼo makech kanyo, omiyo ne giluto siponj e iye bangʼe ne gichwoyo siponjno ewi kede moro mi gitere nyaka e dho Yesu. <verse eid="JHN 19:29"/><verse number="30" style="v" sid="JHN 19:30"/>Kane Yesu osebilo kongʼono nowacho niya, <char style="wj">“Duto koro orumo.”</char> Eka nokulo wiye piny, kendo chunye nochot.<verse eid="JHN 19:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31"/>Ne en odiechiengʼ motelo ne odiechieng Pasaka. Nikech jo-Yahudi ne ok dwar mondo owe ringre Yesu koliero e msalaba chiengʼ Sabato, ne gikwayo Pilato mondo one ni otur tiende joma nogur, kendo olor ringregi. <verse eid="JHN 19:31"/><verse number="32" style="v" sid="JHN 19:32"/>Omiyo jolweny nobiro moturo tiend ngʼat mokwongo ma nogur gi Yesu, kod tiende ngʼat machielo bende. <verse eid="JHN 19:32"/><verse number="33" style="v" sid="JHN 19:33"/>Kane gibiro ir Yesu mi giyudo nine osetho, ne ok gituro tiendene. <verse eid="JHN 19:33"/><verse number="34" style="v" sid="JHN 19:34"/>Kar timo kamano, to achiel kuom askechego nochwowo ngʼet Yesu gi tongʼ, mi remo gi pi nochwer. <verse eid="JHN 19:34"/><verse number="35" style="v" sid="JHN 19:35"/>Ngʼama noneno ka gigo timore ema ochiwo nenoni kendo nende en adier. Ongʼeyo ni owacho adiera, kendo ohulo wechegi mondo un bende uyie. <verse eid="JHN 19:35"/><verse number="36" style="v" sid="JHN 19:36"/>Gigi notimore mondo Ndiko ochop kare kaka nondiki niya, “Onge kata choke achiel ma notur.”<note caller="+" style="f"><char style="fr" closed="false">19:36 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 12:46">Wuo 12:46</ref>; <ref loc="NUM 9:12">Kwa 9:12</ref>; <ref loc="PSA 34:20">Zab 34:20</ref></char></char></note> <verse eid="JHN 19:36"/><verse number="37" style="v" sid="JHN 19:37"/>Ndiko machielo bende wacho niya, “Giniket geno margi kuom Jal mane gichwowo gi tongʼ.”<note caller="+" style="f"><char style="fr" closed="false">19:37 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 12:10">Zek 12:10</ref></char></char></note><verse eid="JHN 19:37"/></para>
  <para style="s1">Yik mar Yesu</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38"/>Bangʼe Josef ja-Arimathaya nokwayo Pilato mondo omiye ringre Yesu. Josef ne en japuonjre Yesu to nobedo kamano lingʼ-lingʼ nikech noluoro jo-Yahudi. Kane Pilato osemiye thuolo, nobiro mokawo ringre Yesu. <verse eid="JHN 19:38"/><verse number="39" style="v" sid="JHN 19:39"/>Nikodemo mane oseyudo odhi ir Yesu gotieno chiengʼ moro nodhi gi Josef. Nikodemo nokelo yien moko mangʼwe ngʼar moru kaachiel mane-mane madirom kilo piero adek gangʼwen. <verse eid="JHN 19:39"/><verse number="40" style="v" sid="JHN 19:40"/>Negikawo ringre Yesu mi giwiro gi modhigo bangʼe giboye gi lewni marep-rep molir olir, kaka chik jo-Yahudi mar yiko ngʼato dwaro. <verse eid="JHN 19:40"/><verse number="41" style="v" sid="JHN 19:41"/>To kama negigure Yesuno ne nitie puodho moro, kendo ei puodhono ne nitie bur manyien mapok oike ngʼato. <verse eid="JHN 19:41"/><verse number="42" style="v" sid="JHN 19:42"/>Nikech ne en odiechieng jo-Yahudi mar ikruok ne Sabato, kendo nikech bur mar ik ne ni machiegni, negiiko Yesu kanyo.<verse eid="JHN 19:42"/></para>
  <chapter eid="JHN 19"/>
  <chapter number="20" style="c" sid="JHN 20"/>
  <para style="s1">Chier mar Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1"/>To odiechiengʼ mokwongo mar juma, kogwen, kane piny pod olil, Maria ma aa Magdala nodhi e liel, mi noneno ka kidi osengʼiel oko e dho lielno. <verse eid="JHN 20:1"/><verse number="2" style="v" sid="JHN 20:2"/>Omiyo noringo modhi ir Simon Petro kod japuonjre machielo mane Yesu ohero, kendo nowachonegi niya, “Gisekawo ringre Ruoth gigolo e liel kama noyike, kendo koro wakia kama giketee!”<verse eid="JHN 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3"/>Kuom mano, Petro gi japuonjre machielono nowuok modhi kama noyike. <verse eid="JHN 20:3"/><verse number="4" style="v" sid="JHN 20:4"/>Negiringo giduto, to japuonjre machielono noyombo Petro, mi nokuongone chopo e liel. <verse eid="JHN 20:4"/><verse number="5" style="v" sid="JHN 20:5"/>Nokulore mongʼicho, kendo noneno lewni mayom molir olir kod law ik ma nonalgo wi Yesu kani ei bur kanyo. To kata kamano, ne ok odonjo e iye. <verse eid="JHN 20:5"/><verse number="6" style="v" sid="JHN 20:6"/>Eka Simon Petro, mane ringo bangʼe bende notundo. En to nodonjo nyaka ei bur ik, mi noneno lewni mayom molir olir ka ni kanyo, <verse eid="JHN 20:6"/><verse number="7" style="v" sid="JHN 20:7"/>kaachiel gi law ik mane onalgo wi Yesu. Nangano noban maber, kendo ne en kar kende, mopogore gi kama lewni mayom molir olir ne nitie. <verse eid="JHN 20:7"/><verse number="8" style="v" sid="JHN 20:8"/>Mogik, japuonjre machielo, mane okwongo chopo e bur yikno, bende nodonjo ei bur mi noneno kendo noyie. <verse eid="JHN 20:8"/><verse number="9" style="v" sid="JHN 20:9"/>(Nyaka ae thuolono ne pok gingʼeyo, koa e Ndiko, ni nochuno ni Yesu nyaka ne chier mi aa kuom joma otho.) <verse eid="JHN 20:9"/><verse number="10" style="v" sid="JHN 20:10"/>Eka jopuonjre nodok e miechgi.<verse eid="JHN 20:10"/></para>
  <para style="s1">Yesu ofwenyorene Maria ma aa Magdala</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11"/>Maria nochungʼ oko e dho bur kaywak. Kane oyudo oywak, nokulore mongʼiyo i bur, <verse eid="JHN 20:11"/><verse number="12" style="v" sid="JHN 20:12"/>kendo noneno malaike ariyo morwako lewni marochere, kobet piny kama ringre Yesu nopielie, ka moro ni yo ka wiye, to machielo ni yo ka tiende.<verse eid="JHN 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 20:13"/>Negipenje niya, “Nyarwa, iywago angʼo?”</para>
  <para style="p" vid="JHN 20:13">Nowachonegi niya, “Gisekawo Ruodha gidhigo, to akia kama giketee.” <verse eid="JHN 20:13"/><verse number="14" style="v" sid="JHN 20:14"/>Bangʼ wacho kamano, nolokore ongʼiyo ngʼeye, kendo noneno Yesu kochungʼ kanyo, to ne ok ongʼeyo ni en Yesu.<verse eid="JHN 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15"/>Yesu nopenje niya, <char style="wj">“Nyarwa, iywago angʼo? En ngʼa mimanyo?”</char></para>
  <para style="p" vid="JHN 20:15">En to noparo ni mano jarit puodho ema wuoyo kode, omiyo nopenje niya, “Jaduongʼ, ka dipo ni in ema ne ikawe idhi kode, to nyisa kama iseketee, mondo adhi akawe.”<verse eid="JHN 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16"/>Yesu noluonge niya, <char style="wj">“Maria!”</char></para>
  <para style="p" vid="JHN 20:16">Nolokore mi ongʼiye koluonge matek gi dho jo-Hibrania niya, <char style="tl">“Raboni!”</char> (tiende ni “Japuonj”).<verse eid="JHN 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17"/>Yesu nowachone niya, <char style="wj">“Kik itweri kuoma, nimar pok adok ka Wuora, to dhi ir owetena mondo inyisgi ni, ‘Adok ir Wuora ma en Wuoru un bende, kendo Nyasacha ma en Nyasachu.’ ”</char><verse eid="JHN 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18"/>Maria nyar Magdala nodhi ir jopuonjre monyisogi Injili niya, “Aseneno Ruoth!” Kendo Ruoth ema osenyisa weche ma awachonugi.<verse eid="JHN 20:18"/></para>
  <para style="s1">Yesu ofwenyore ne jopuonjrene</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19"/>Godhiambo mar odiechiengʼ mokwongo mar juma, jopuonjre nochokore kanyakla, kendo ne giloro dhoudi nikech negiluoro jo-Yahudi, Yesu nobiro mochungʼ e diergi kendo nowachonegi niya, <char style="wj">“Kwe obed kodu!”</char> <verse eid="JHN 20:19"/><verse number="20" style="v" sid="JHN 20:20"/>Bangʼ kane osewacho ma, nonyisogi lwetene gi ngʼetne. Jopuonjre ne mor mokalo kane gineno Ruoth.<verse eid="JHN 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 20:21"/>Yesu nochako owachonegi kendo niya, <char style="wj">“Beduru gi kwe! Mana kaka Wuora oseora e kaka an bende aorou.”</char> <verse eid="JHN 20:21"/><verse number="22" style="v" sid="JHN 20:22"/>Bangʼ wachonegi wechego, nokudho muche kuomgi, kowachonegi niya, <char style="wj">“Nwangʼuru Roho Maler.</char> <verse eid="JHN 20:22"/><verse number="23" style="v" sid="JHN 20:23"/><char style="wj">Ngʼato angʼata muweyone richone nowenegi, to ka ok uweyonegi, to ok nowenegi.”</char><verse eid="JHN 20:23"/></para>
  <para style="s1">Yesu ofwenyore ne Thoma</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24"/>Thoma (ma bende iluongo ni Didimas), ma en achiel kuom jopuonjre apar gariyo, ne ok ni kodgi e kinde mane Yesu ofwenyorenigi. <verse eid="JHN 20:24"/><verse number="25" style="v" sid="JHN 20:25"/>Omiyo jopuonjre mamoko nokone niya, “Waseneno Ruoth!”</para>
  <para style="p" vid="JHN 20:25">To nowachonegi niya, “An to ka ok aneno lwete kuonde mane musmal ochwowo, mi aketo lith lweta kuondego, kendo asoyo lweta e ngʼetne, to ok abi yie wachno.”<verse eid="JHN 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26"/>Bangʼ juma achiel, jopuonjre ne ni ei ot kendo, to chiengʼno Thoma ne ni kodgi. Kata obedo ni dhoudi nolor, Yesu nobiro mochungʼ e diergi momosogi niya, <char style="wj">“Okweuru!”</char> <verse eid="JHN 20:26"/><verse number="27" style="v" sid="JHN 20:27"/>Eka nowachone Thoma niya, <char style="wj">“Ket lith lweti kae kendo nee lwetena. Chor lweti kuoma bangʼe iketi e ngʼetna. We bedo ngʼama riwo gi kiawa, bed ngʼama nigi yie!”</char><verse eid="JHN 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28"/>Thoma nodwoke niya, “Ruodha kendo Nyasacha!”<verse eid="JHN 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29"/>Eka Yesu nowachone niya, <char style="wj">“In iyie nikech isenena, to ogwedh joma pok onena, to oseyie.”</char><verse eid="JHN 20:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30"/>Yesu notimo ranyisi gi honni mamoko mangʼeny, ka jopuonjrene neno, ma ok ondiki e kitabuni. <verse eid="JHN 20:30"/><verse number="31" style="v" sid="JHN 20:31"/>To magi ondiki mondo uyie ni Yesu e Kristo ma Wuod Nyasaye, kendo mondo ka uyie kamano, to ubed gi ngima e nyinge.<verse eid="JHN 20:31"/></para>
  <chapter eid="JHN 20"/>
  <chapter number="21" style="c" sid="JHN 21"/>
  <para style="s1">Yesu omiyo jopuonjrene omako rech mangʼeny</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1"/>Bangʼ ka gigo nosetimore, Yesu nochako onenore kendo ni jopuonjrene e dho Nam Tiberia. To nenruokne kodgi nobet kama: <verse eid="JHN 21:1"/><verse number="2" style="v" sid="JHN 21:2"/>Simon Petro, Thoma (ma bende iluongo ni Didimas), Nathaniel mane aa Kana e piny Galili, yawuot Zebedi, kod jopuonjre mamoko ariyo, noyudo ochokore kanyakla. <verse eid="JHN 21:2"/><verse number="3" style="v" sid="JHN 21:3"/>Simon Petro nowachonegi niya, “Adok lupo” kendo negiwachone niya, “Wan bende wadok kodi.” Omiyo negiwuok gidhi kendo negidonjo ei yie. To otienono duto onge gima negimako.<verse eid="JHN 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4"/>Kinyne kogwen, Yesu nochungʼ e dho nam, to jopuonjre ne ok ongʼeye.<verse eid="JHN 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 21:5"/>Noluongogi niya, <char style="wj">“Jowadwa, bende unie gi rech moro?”</char></para>
  <para style="p" vid="JHN 21:5">Negidwoke niya, “Ooyo.”<verse eid="JHN 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6"/>Nowachonegi niya, <char style="wj">“Boluru gogo mau yo bat korachwich mar yie, to ubiro mako rech.”</char> Kane gitimo kamano, ywayo gogo nyaka ei yie notamogi, nikech rech ne ngʼeny mohewogi ywayo.<verse eid="JHN 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7"/>Eka japuonjre ma Yesu nohero nowacho ni Petro niya, “En Ruoth!” Sa nogono ma Simon Petro nowinje kowacho niya, “En Ruoth,” notweyo lawe mar abola e nungone, nimar noyudo osegole oko mi nochikore ei pi. <verse eid="JHN 21:7"/><verse number="8" style="v" sid="JHN 21:8"/>Jopuonjre mamoko to ne luwo bangʼe ka gin ei yie, kendo ka giywayo gogo ma rech opongʼo, nimar ne koro ok gin mabor gi dho nam, kendo nodongʼnegi mana fut mia ariyo gi piero ochiko gabich kende to gichop oko. <verse eid="JHN 21:8"/><verse number="9" style="v" sid="JHN 21:9"/>Kane gigowo e dho nam, negineno mach maliel ka ni kanyo ka oket rech e wiye, kod makati moko.<verse eid="JHN 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 21:10"/>Yesu nowachonegi niya, <char style="wj">“Keluru rech moko kuom mago ma usemako.”</char> <verse eid="JHN 21:10"/><verse number="11" style="v" sid="JHN 21:11"/>Simon Petro nodonjo ei pi, mi noywayo gogo nyaka dho wath. Nopongʼ gi rech madongo dongo ma dirom rech mia achiel gi piero abich gadek, to kata negingʼeny kamano, to gogo ne ok oyiech. <verse eid="JHN 21:11"/><verse number="12" style="v" sid="JHN 21:12"/>Yesu nowachonegi niya, <char style="wj">“Suduru machiegni uchiem.”</char> Onge japuonjre kata achiel mane ohedhore penje niya, “In ngʼa?” Negingʼeyo ni en Ruoth. <verse eid="JHN 21:12"/><verse number="13" style="v" sid="JHN 21:13"/>Yesu nobiro mokawo makati omiyogi, kendo rech bende nomiyogi kamano. <verse eid="JHN 21:13"/><verse number="14" style="v" sid="JHN 21:14"/>Mano ne en fwenyruok mar Yesu mar adek ni jopuonjrene bangʼ chier aa kuom joma otho.<verse eid="JHN 21:14"/></para>
  <para style="s1">Yesu odwogo Petro e tich</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15"/>Kane gisetieko chiemo, Yesu nopenjo Simon Petro niya, <char style="wj">“Simon wuod Johana, bende ihera adier moloyo jogi?”</char></para>
  <para style="p" vid="JHN 21:15">Nodwoke niya, “Ee, Ruoth, ingʼeyo ni aheri.”</para>
  <para style="p" vid="JHN 21:15">Yesu nowachone niya, <char style="wj">“Kare pidh nyiromba.”</char><verse eid="JHN 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16"/>Nochako openje kendo mar ariyo niya, <char style="wj">“Simon wuod Johana, bende ihera adier?”</char></para>
  <para style="p" vid="JHN 21:16">Nodwoke niya, “Ee, Ruoth, ingʼeyo ni aheri.”</para>
  <para style="p" vid="JHN 21:16">Yesu nowachone niya, <char style="wj">“Kare rit romba.”</char><verse eid="JHN 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17"/>Nopenje mar adek niya, <char style="wj">“Simon wuod Johana, bende ihera?”</char></para>
  <para style="p" vid="JHN 21:17">Petro nokuyo nikech Yesu nopenje mar adek niya, <char style="wj">“Bende ihera?”</char> Nodwoke niya, “Ruoth, in ingʼeyo gik moko duto; ingʼeyo ni aheri.”</para>
  <para style="p" vid="JHN 21:17">Yesu nowachone niya, <char style="wj">“Kare pidh romba.</char> <verse eid="JHN 21:17"/><verse number="18" style="v" sid="JHN 21:18"/><char style="wj">Adier, adier awachoni, kane pod itin, to nirwakori kendi kendo ne inyalo dhi kamoro amora mihero; to kibiro doko moti, to ibiro rieyo bedeni ne ngʼama chielo ma biro rwakoni lepi mi teri kuma ok idwar dhiye.”</char> <verse eid="JHN 21:18"/><verse number="19" style="v" sid="JHN 21:19"/>Yesu nowacho mano mondo onyisgo kit tho ma Petro ne biro miyogo Nyasaye duongʼ. Eka nowachone niya, <char style="wj">“Luwa!”</char><verse eid="JHN 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20"/>Petro nolokore moneno japuonjre mane Yesu ohero kaluwogi. (Ma e ngʼat mane otenore kuom Yesu kane gilworo mesa gichamo chiemb odhiambo, mi openje niya, “Ruoth, en ngʼa madwaro ndhogi?”) <verse eid="JHN 21:20"/><verse number="21" style="v" sid="JHN 21:21"/>Kane Petro onene, nopenjo niya, “Ruoth, to en to?”<verse eid="JHN 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22"/>Yesu nodwoke niya, <char style="wj">“Ka adwaro ni osik kongima nyaka aduogi, to mano chandi nangʼo? In to luwa!”</char> <verse eid="JHN 21:22"/><verse number="23" style="v" sid="JHN 21:23"/>Dwoko mane Yesu odwokono nomiyo wachno olandore e kind jowete ni japuonjreno ok bi tho ngangʼ, to Yesu to nowacho mana niya, <char style="wj">“Ka adwaro ni osik kongima nyaka aduogi, to mano chandi nangʼo?”</char><verse eid="JHN 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24"/>Ma e japuonjre makoro timo neno kuom gigi kendo en bende ema nondikogi piny. Wangʼeyo ni nende en adier.<verse eid="JHN 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25"/>Yesu notimo gik mangʼeny mamoko. Ka dine ndikgi duto moro ka moro kuomgi, to an gi ratiro ni kata mana piny ngima ok doromo kano kitepe duto ma dine ondiki.<verse eid="JHN 21:25"/></para>
  <chapter eid="JHN 21"/>
</usx>
