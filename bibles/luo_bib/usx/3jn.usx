<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Biblica® Open New Luo Translation 2020</book>
  <para style="h">3 Johana</para>
  <para style="toc1">Johana Mar Adek</para>
  <para style="toc2">3 Johana</para>
  <para style="toc3">3Joh</para>
  <para style="mt1">3 Johana</para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>An Jaduongʼ,</para>
  <para style="b" vid="3JN 1:1"/>
  <para style="p" vid="3JN 1:1">Andikoni in Gayo osiepna mahero gi chunya.<verse eid="3JN 1:1"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2"/>Osiepna, alamo ni mondo ibed gi ngima maber, kendo ni mondo gik moko duto odhini maber, mana kaka chunyi dhi maber. <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>Ne abedo mamor ahinya ka jowete moko nobiro kendo mowachona kaka isiko kiwuotho e adieranogo. <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>Onge gima mora moloyo winjo ni nyithinda wuotho e adiera.<verse eid="3JN 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>Osiepna in ja-adiera kuom gik mitimo ni jowete kata obedo ni gin joma welo kuomi. <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>Gisenyiso kanisa hera ma in-go. Konygi e wuodhgi ka ikowogi e yo mowinjore ni Nyasaye. <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>Nikech nying Kristo ema nomiyo giwuok gidhi adhiya, ka ok giyie kawo mich moro amora kuom jopiny. <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>Omiyo nyaka wakony joma kamago, mondo wati kaachiel kodgi e tij adiera.<verse eid="3JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>Ne andiko ni kanisa, to Diotrefes, mohero ketore mondo obed jatelo, ne ok oyie kodwa. <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>Omiyo ka abiro to abiro nyiso ji e lela gik motimo; kaka ohangonwa weche maricho. To bende otamore rwako jowete mobiro, kendo otamo joma dwaro timo kamano, bende oriembo jogo mondo oa e kanisa.<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>Osiepna, kik iluw timbe maricho, to luw tim maber. Ngʼat matimo gima ber en ngʼat Nyasaye, to ngʼat matimo gima rach pok oneno Nyasaye. <verse eid="3JN 1:11"/><verse number="12" style="v" sid="3JN 1:12"/>Ji duto wuoyo maber kuom Demetrio, nikech adiera ema wachore kuome. Wan bende wawuoyo kuome maber, kendo ungʼeyoni nendwa en adier.<verse eid="3JN 1:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>An gi weche mangʼeny monego andikni, to ok adwar ndikonigi e baruwani. <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>Ageno nenoi mapiyo, eka wanawuo wangʼ gi wangʼ.<verse eid="3JN 1:14"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15"/>Kwe mondo obed kodi.</para>
  <para style="b" vid="3JN 1:15"/>
  <para style="p" vid="3JN 1:15">Osiepe man ka ooroni mos. Mosnwa osiepe man kuno gi nyingegi.<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
