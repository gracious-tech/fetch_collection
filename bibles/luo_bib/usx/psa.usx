<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Biblica® Open New Luo Translation 2020</book>
  <para style="h">Zaburi</para>
  <para style="toc1">Zaburi</para>
  <para style="toc2">Zaburi</para>
  <para style="toc3">Zab</para>
  <para style="mt1">Zaburi</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms">Kitabu Mokwongo</para>
  <para style="mr">
    <ref loc="PSA 1-41">Zaburi 1–41</ref></para>
  <para style="cl">Zaburi 1</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1"/>Nyasaye gwedho ngʼat</para>
  <para style="q2" vid="PSA 1:1">ma ok lu pach joma richo,</para>
  <para style="q1" vid="PSA 1:1">kata luwo yor joricho</para>
  <para style="q2" vid="PSA 1:1">kata bedo e kom jojaro.<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>To chik Jehova Nyasaye ema more,</para>
  <para style="q2" vid="PSA 1:2">kendo osiko oparo kuom chikene odiechiengʼ gotieno.<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>Ochalo gi yien mopidhi e bath aora,</para>
  <para style="q2" vid="PSA 1:3">manyago olembe e kinde molemo chieke,</para>
  <para style="q1" vid="PSA 1:3">kendo ma bedene ok ner.</para>
  <para style="b" vid="PSA 1:3"/>
  <para style="q2" vid="PSA 1:3">Gimoro amora motimo dhi maber.<verse eid="PSA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>Joma timbegi richo to ok chal kamano kata matin!</para>
  <para style="q2" vid="PSA 1:4">Gin gichalo gi mihudhi,</para>
  <para style="q2" vid="PSA 1:4">ma yamo tero.<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>Kuom mano joma timbegi richo ok nolo bura,</para>
  <para style="q2" vid="PSA 1:5">adier, joricho ok nobedi e kanyakla mar joma kare,<verse eid="PSA 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>nikech Jehova Nyasaye rango yor joma kare,</para>
  <para style="q2" vid="PSA 1:6">to yor joma richo to biro kethore.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="cl">Zaburi 2</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1"/>Angʼo momiyo ogendini chano timo marach</para>
  <para style="q2" vid="PSA 2:1">kendo ji chano jiemo kayiem nono?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>Ruodhi mag piny osebiro kanyakla</para>
  <para style="q2" vid="PSA 2:2">kendo jotelo pimo wach kaachiel,</para>
  <para style="q1" vid="PSA 2:2">mondo giked gi Jehova Nyasaye</para>
  <para style="q2" vid="PSA 2:2">kendo giked gi ngʼate mowir.<verse eid="PSA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3"/>“Giwacho ni, wachoduru nyorochegi;</para>
  <para style="q2" vid="PSA 2:3">kendo wawit ratekegi kucha.”<verse eid="PSA 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>To Jal mobet e kom loch e polo to nyierogi anyiera,</para>
  <para style="q2" vid="PSA 2:4">Ruoth goyonegi siboi.<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>Eka okwerogi kokecho</para>
  <para style="q2" vid="PSA 2:5">kendo obwogogi kopongʼ gi mirima mager, kowacho niya,<verse eid="PSA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6"/>“Aseketo Ruoth ma adwaro</para>
  <para style="q2" vid="PSA 2:6">e Sayun, goda maler.”<verse eid="PSA 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 2:7"/>Abiro hulo chenro mag Jehova Nyasaye ma ok lokre:</para>
  <para style="q1" vid="PSA 2:7">Nowachona niya, “In wuoda;</para>
  <para style="q2" vid="PSA 2:7">kawuono asedoko wuonu.<verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>Omiyo kwaya gima idwaro</para>
  <para style="q2" vid="PSA 2:8">mondo aket ogendini duto obed girkeni mari,</para>
  <para style="q2" vid="PSA 2:8">mondo piny ngima obed mwanduni.<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>Initelnigi kod ludhi mar nyinyo;</para>
  <para style="q2" vid="PSA 2:9">kendo initogi matindo tindo ka agulu.”<verse eid="PSA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>Kuom mano, un ruodhi, beduru mariek;</para>
  <para style="q2" vid="PSA 2:10">tangʼuru un joloch mag piny.<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>Tiuru ne Jehova Nyasaye gi luoro</para>
  <para style="q2" vid="PSA 2:11">kendo moruru e nyime gi luoro.<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>Bolreuru e nyim Wuowi,</para>
  <para style="q2" vid="PSA 2:12">nono to dipo kokecho kodu mi dongʼad ndalou, motieku,</para>
  <para style="q1" vid="PSA 2:12">nimar iye nyalo wangʼ kodu kadiemo wangʼ.</para>
  <para style="q2" vid="PSA 2:12">Ji duto mogeno kuome gin joma ogwedhi.<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="cl">Zaburi 3</para>
  <para style="d">Zaburi mar Daudi, kane oringo oa ir wuode Abisalom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1"/>Yaye Jehova Nyasaye, mano kaka wasika thoth!</para>
  <para style="q2" vid="PSA 3:1">Mano kaka joma lawa ngʼeny!<verse eid="PSA 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2"/>Ji mangʼeny wuoyo kuoma, kagiwacho ni,</para>
  <para style="q2" vid="PSA 3:2">“Nyasaye ok bi rese.” <char style="qs">Sela</char><note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">Sela </char><char style="ft" closed="false">tiend wachni ok ongʼere.</char></note><verse eid="PSA 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3"/>To In e okumbana mogengʼa, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 3:3">In ema imiyo alocho, kendo isetingʼo wiya malo.<verse eid="PSA 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4"/>Aywak matek ka alemo ni Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 3:4">kendo odwoka gie gode maler. <char style="qs">Sela</char><verse eid="PSA 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5"/>Ariera piny mondo anindi;</para>
  <para style="q2" vid="PSA 3:5">kendo achako aa malo, nikech Jehova Nyasaye orita.<verse eid="PSA 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6"/>Ok abi luoro ji gana gi gana</para>
  <para style="q2" vid="PSA 3:6">molwora mondo otimna marach.<verse eid="PSA 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7"/>Aa malo, yaye Jehova Nyasaye!</para>
  <para style="q2" vid="PSA 3:7">Resa, yaye Nyasacha!</para>
  <para style="q1" vid="PSA 3:7">Tur chok lemb wasika duto;</para>
  <para style="q2" vid="PSA 3:7">Muk leke joma timbegi richo.<verse eid="PSA 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8"/>Resruok aa mana kuom Jehova Nyasaye.</para>
  <para style="q2" vid="PSA 3:8">Mad igweth jogi. <char style="qs">Sela</char><verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="cl">Zaburi 4</para>
  <para style="d">Kuom jatend wer. Miwero gi gig wer man-gi tondegi. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1"/>Ka aluongi to yie idwoka,</para>
  <para style="q2" vid="PSA 4:1">yaye Nyasacha makare.</para>
  <para style="q1" vid="PSA 4:1">Konya e lit momako chunya;</para>
  <para style="q2" vid="PSA 4:1">yie ikecha kendo iwinj lamona.<verse eid="PSA 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2"/>Yaye, ubiro chayo duongʼ ka ukuodo wiya nyaka karangʼo?</para>
  <para style="q2" vid="PSA 4:2">Ubiro hero gik manono kendo luwo nyiseche manono nyaka karangʼo? <char style="qs">Sela</char><verse eid="PSA 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3"/>Ngʼeuru ni Jehova Nyasaye oseyiera mondo abed mare owuon;</para>
  <para style="q2" vid="PSA 4:3">kendo Jehova Nyasaye winja, ka aluonge.<verse eid="PSA 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4"/>Ka iu owangʼ to kik utim richo;</para>
  <para style="q2" vid="PSA 4:4">seche ma uyweyo mos e kitandau,</para>
  <para style="q1" vid="PSA 4:4">to nonuru chunyu ka ulingʼ mos,</para>
  <para style="q2" vid="PSA 4:4">keturu chunyu mos ka unindo e kitandau. <char style="qs">Sela</char><verse eid="PSA 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5"/>Chiwuru misengini mowinjore</para>
  <para style="q2" vid="PSA 4:5">kendo genuru kuom Jehova Nyasaye.<verse eid="PSA 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6"/>Ji mangʼeny penjo niya, “En ngʼa manyalo timonwa gimoro maber?”</para>
  <para style="q2" vid="PSA 4:6">Mad ler moa e lela wangʼi rieny kuomwa, yaye Jehova Nyasaye.<verse eid="PSA 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7"/>Isepongʼo chunya gi mor maduongʼ moloyo mor ma gin-go</para>
  <para style="q2" vid="PSA 4:7">e kinde ma gin-gi cham kod divai mangʼeny.<verse eid="PSA 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8"/>Abiro riera piny mi anind gi kwe,</para>
  <para style="q2" vid="PSA 4:8">nikech in kendi, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 4:8">in ema imiyo adak gi kwe.<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="cl">Zaburi 5</para>
  <para style="d">Kuom jatend wende miwero gi asili. Zaburi Mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1"/>Chik iti mondo iwinj wechena, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 5:1">para kuom pek manie chunya.<verse eid="PSA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2"/>Winj ywakna mar dwaro kony,</para>
  <para style="q2" vid="PSA 5:2">Yaye Ruodha kendo Nyasacha,</para>
  <para style="q2" vid="PSA 5:2">nikech in ema alami.<verse eid="PSA 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3"/>Yie iwinj dwonda gokinyi, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 5:3">aketo kwayona e nyimi gokinyi,</para>
  <para style="q2" vid="PSA 5:3">kendo arito dwoko ka an gi geno.<verse eid="PSA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4"/>Ok in Nyasaye mamor gi timbe maricho.</para>
  <para style="q2" vid="PSA 5:4">Joma richo ok nyal dak kodi kanyachiel.<verse eid="PSA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5"/>Josunga ok nyal chungʼ e nyimi;</para>
  <para style="q2" vid="PSA 5:5">imon gi ji duto matimo gik maricho.<verse eid="PSA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6"/>Itieko joma wacho miriambo;</para>
  <para style="q2" vid="PSA 5:6">Jehova Nyasaye ok mor gi joma dwaro chwero remo,</para>
  <para style="q2" vid="PSA 5:6">kod jo-miriambo.<verse eid="PSA 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7"/>An to, nikech kechni maduongʼ,</para>
  <para style="q2" vid="PSA 5:7">abiro donjo e odi;</para>
  <para style="q1" vid="PSA 5:7">abiro kulora gi luor</para>
  <para style="q2" vid="PSA 5:7">ka achomo hekalu mari maler.<verse eid="PSA 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8"/>Telna, yaye Jehova Nyasaye, kuom adiera mari,</para>
  <para style="q2" vid="PSA 5:8">nikech wasigu molwora,</para>
  <para style="q2" vid="PSA 5:8">yie iriena yori tir e nyima.<verse eid="PSA 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9"/>Kata wach achiel mowuok e dho jogi ok nyal gen;</para>
  <para style="q2" vid="PSA 5:9">chunygi opongʼ gi kethruok.</para>
  <para style="q1" vid="PSA 5:9">Dwondgi chalo gi liel mapok oum;</para>
  <para style="q2" vid="PSA 5:9">lewgi olony e wacho miriambo.<verse eid="PSA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10"/>Kwan-gi kaka joketho, yaye Nyasaye!</para>
  <para style="q2" vid="PSA 5:10">Ket obadho ma giketo ne ji ogajgi gin giwegi.</para>
  <para style="q1" vid="PSA 5:10">Riembgi nikech richogi mathoth,</para>
  <para style="q2" vid="PSA 5:10">nimar gisengʼanyoni.<verse eid="PSA 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11"/>We ji duto moketi kar pondo margi obed mamor;</para>
  <para style="q2" vid="PSA 5:11">we gisiki ka giwer gimor.</para>
  <para style="q1" vid="PSA 5:11">Umgi gi rit mari,</para>
  <para style="q2" vid="PSA 5:11">mondo joma ohero nyingi omor kodi.<verse eid="PSA 5:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12"/>Nikech igwedho joma kare adier, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 5:12">igengʼogi gi hapi mana ka okumba.<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="cl">Zaburi 6</para>
  <para style="d">Kuom jatend wer. Miwero gi gig wer man-gi tondegi. Kaluwore gi <char style="tl">sheminith</char><note caller="+" style="f"><char style="fr" closed="false">6:0 </char><char style="fl" closed="false">Sheminith: </char><char style="ft" closed="false">Ochalo ni en kit wer moro</char></note>. Zaburi Mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1"/>Kik ikwera, yaye Jehova Nyasaye, ka iyi owangʼ</para>
  <para style="q2" vid="PSA 6:1">kata kum kik ikuma ka mirima omaki.<verse eid="PSA 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>Kecha, yaye Jehova Nyasaye, nikech aol;</para>
  <para style="q2" vid="PSA 6:2">changa, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 6:2">nikech chokena rama malit.<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>Chunya winjo malit.</para>
  <para style="q2" vid="PSA 6:3">Nyaka karangʼo, yaye Jehova Nyasaye, nyaka karangʼo?<verse eid="PSA 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>Lokri, yaye Jehova Nyasaye, mondo iresa;</para>
  <para style="q2" vid="PSA 6:4">resa nikech herani ma ok rum.<verse eid="PSA 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>Onge ngʼama nyalo pari ka osetho.</para>
  <para style="q2" vid="PSA 6:5">En ngʼa madi paki gi ei liel?<verse eid="PSA 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>Chur ma achurgo ojonya</para>
  <para style="q2" vid="PSA 6:6">otieno duto abudo kitandana gi ywak,</para>
  <para style="q2" vid="PSA 6:6">kendo pi wangʼa olwoko piendena.<verse eid="PSA 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>Wengena ool nikech lit ma an-go;</para>
  <para style="q2" vid="PSA 6:7">ok ginen maber nikech wasika duto.<verse eid="PSA 6:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>Ayiuru buta, un duto ji matimo richo,</para>
  <para style="q2" vid="PSA 6:8">nikech Jehova Nyasaye osewinjo ywakna.<verse eid="PSA 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>Jehova Nyasaye osewinjo ywak mar kwayo kech;</para>
  <para style="q2" vid="PSA 6:9">Jehova Nyasaye orwako lamo mara.<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>Wasika duto wigi biro kuot kendo gibiro hum nono;</para>
  <para style="q2" vid="PSA 6:10">gibiro dok chien apoya nono gi wichkuot.<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="cl">Zaburi 7</para>
  <para style="d">Wend <char style="tl">shigaion</char><note caller="+" style="f"><char style="fr" closed="false">7:0 </char><char style="fl" closed="false">Shigaion: </char><char style="ft" closed="false">Ochalo ni en kit wer moro</char></note> mane Daudi owero ne Jehova Nyasaye kuom Kush ja-Benjamin.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1"/>Yaye Jehova Nyasaye ma Nyasacha, in e kar pondona;</para>
  <para style="q2" vid="PSA 7:1">Resa kendo igola e lwet joma lawa duto,<verse eid="PSA 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2"/>nono to gibiro kidha kaka sibuor kidho gik moko.</para>
  <para style="q2" vid="PSA 7:2">Kendo gibiro yiecha matindo tindo maonge ngʼama diresa e lwetgi.<verse eid="PSA 7:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3"/>Yaye Jehova Nyasaye Nyasacha, kapo ni asetimo gima kamano adieri</para>
  <para style="q2" vid="PSA 7:3">kendo lweta osetimo gima rach,<verse eid="PSA 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4"/>kaponi asetimo marach ni ngʼama onge koda gi wach</para>
  <para style="q2" vid="PSA 7:4">kata kapo ni asemayo wasika kaonge gima omiyo,<verse eid="PSA 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5"/>to yie ni wasikano mondo olawa mi juka;</para>
  <para style="q2" vid="PSA 7:5">we ginyon ngimana piny e lowo,</para>
  <para style="q2" vid="PSA 7:5">mi gimi anind e buru mar lowo. <char style="qs">Sela</char><verse eid="PSA 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6"/>Aa malo, yaye Jehova Nyasaye, ka in gi mirima</para>
  <para style="q2" vid="PSA 7:6">aa malo irad gi gero mar wasika.</para>
  <para style="q2" vid="PSA 7:6">Chiew, Nyasacha; chiew inyis adierana.<verse eid="PSA 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7"/>We chokruoge mag ogendini olwori koni gi koni.</para>
  <para style="q2" vid="PSA 7:7">Ngʼad negi bura gie kom loch mari man malo;<verse eid="PSA 7:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 7:8"/>Jehova Nyasaye mondo ongʼad bura ne ogendini.</para>
  <para style="q1" vid="PSA 7:8">Ngʼadna bura, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 7:8">kaluwore gi ngimana makare,</para>
  <para style="q1" vid="PSA 7:8">ngʼadna bura, yaye Nyasaye Man Malo Moloyo,</para>
  <para style="q2" vid="PSA 7:8">kaluwore gi ngimana moriere tir.<verse eid="PSA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9"/>Yaye Nyasaye makare,</para>
  <para style="q2" vid="PSA 7:9">In ema inono pach ji gi chunje ji,</para>
  <para style="q1" vid="PSA 7:9">tiek timbe mamono mag joma richo</para>
  <para style="q2" vid="PSA 7:9">mondo imi joma kare odag gi kwe.<verse eid="PSA 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10"/>Okumbana en Nyasaye Man Malo Moloyo,</para>
  <para style="q2" vid="PSA 7:10">ma reso joma chunygi oriere tir.<verse eid="PSA 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11"/>Nyasaye en jangʼad bura makare;</para>
  <para style="q2" vid="PSA 7:11">en e Nyasaye matoyo mirimbe pile ka pile.<verse eid="PSA 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12"/>Ka ok oloko pache</para>
  <para style="q2" vid="PSA 7:12">to obiro piago liganglane;</para>
  <para style="q2" vid="PSA 7:12">obiro dolo okumbane mi otwe tondene.<verse eid="PSA 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13"/>Oseiko gige mag lweny mager;</para>
  <para style="q2" vid="PSA 7:13">oiko asernige makakni ka mach.<verse eid="PSA 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14"/>Ngʼama iye okuot gi gik maricho</para>
  <para style="q2" vid="PSA 7:14">kendo ma yach gi chandruok nywolo yamo nono.<verse eid="PSA 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15"/>Ngʼama loso bur kendo kunye maber</para>
  <para style="q2" vid="PSA 7:15">podho e bure mokunyono.<verse eid="PSA 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16"/>Chandruok mokelo gaje en owuon;</para>
  <para style="q2" vid="PSA 7:16">timbene mag mahundu dwogone e wiye owuon.<verse eid="PSA 7:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17"/>Abiro goyo erokamano ne Jehova Nyasaye nikech en ngʼama kare</para>
  <para style="q2" vid="PSA 7:17">kendo abiro wero wend pak ne nying Jehova Nyasaye Man Malo Moloyo.<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="cl">Zaburi 8</para>
  <para style="d">Kuom Jatend Wer. Kaluwore Gi <char style="tl">Gitith</char><note caller="+" style="f"><char style="fr" closed="false">8:0 </char><char style="fl" closed="false">Gitith: </char><char style="ft" closed="false">Ochalo ni en kit wer moro</char></note>. Zaburi Mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1"/>Yaye Jehova Nyasaye, ma Ruodhwa,</para>
  <para style="q2" vid="PSA 8:1">mano kaka nyingi nigi duongʼ e piny duto!</para>
  <para style="b" vid="PSA 8:1"/>
  <para style="q1" vid="PSA 8:1">Iseketo duongʼni maler milamo,</para>
  <para style="q2" vid="PSA 8:1">moyombo polo.<verse eid="PSA 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2"/>Ne isechano mondo</para>
  <para style="q2" vid="PSA 8:2">nyithindo kod nyithindo mayom omiyi pak,</para>
  <para style="q1" vid="PSA 8:2">nikech wasiki,</para>
  <para style="q2" vid="PSA 8:2">mondo jawasigu kod jachul kuor olingʼ kawuoro timni.<verse eid="PSA 8:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3"/>Kaparo polo mari</para>
  <para style="q2" vid="PSA 8:3">ma gin tich lweti,</para>
  <para style="q1" vid="PSA 8:3">kaparo dwe gi sulwe</para>
  <para style="q2" vid="PSA 8:3">miseketo kargi,<verse eid="PSA 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4"/>to dhano adhana to en angʼo momiyo ipare,</para>
  <para style="q2" vid="PSA 8:4">wuod dhano to en angʼo momiyo iketo pachi kuome?<verse eid="PSA 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5"/>Ne ichweye mapiny ne malaike</para>
  <para style="q2" vid="PSA 8:5">kendo isesidhone osimbo mar duongʼ kod luor.<verse eid="PSA 8:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6"/>Isekete jatelo ewi tich lweti duto;</para>
  <para style="q2" vid="PSA 8:6">iseketo gik moko duto e bwo tiende:<verse eid="PSA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7"/>Jamni gi kweth duto</para>
  <para style="q2" vid="PSA 8:7">kod le mager mag bungu,<verse eid="PSA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8"/>Winy duto mafuyo e kor polo,</para>
  <para style="q2" vid="PSA 8:8">kod rech manie nam,</para>
  <para style="q2" vid="PSA 8:8">gi le duto mamol kaluwo yore manie nembe iketo e bwo lochne.<verse eid="PSA 8:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9"/>Yaye Jehova Nyasaye, ma Ruodhwa,</para>
  <para style="q2" vid="PSA 8:9">mano kaka nyingi nigi duongʼ e piny duto!<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="cl">Zaburi 9</para>
  <para style="d">Kuom jatend wer. E dwol mar “Tho mar wuowi.” Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1"/>Abiro paki gi chunya duto, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 9:1">abiro nyiso timbegi madongo duto.<verse eid="PSA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2"/>Abiro bedo mamor kendo abiro bedo moil kodi;</para>
  <para style="q2" vid="PSA 9:2">abiro pako nyingi gi wer, yaye Nyasaye Man Malo Moloyo.<verse eid="PSA 9:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3"/>Wasika dok chien;</para>
  <para style="q2" vid="PSA 9:3">gichwanyore kendo gilal e nyimi.<verse eid="PSA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4"/>Nikech isechungʼna matek ka ichwaka</para>
  <para style="q2" vid="PSA 9:4">isebet e kom duongʼ mari, kiyalo bura kare.<verse eid="PSA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5"/>Isekwero ogendini kendo isetieko joma richo;</para>
  <para style="q2" vid="PSA 9:5">iserucho nying-gi oko manyaka chiengʼ.<verse eid="PSA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6"/>Kethruok mosiko osejuko jasigu,</para>
  <para style="q2" vid="PSA 9:6">isemuko miechgi madongo;</para>
  <para style="q2" vid="PSA 9:6">kendo wi ji osewil kodgi.<verse eid="PSA 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7"/>Jehova Nyasaye olocho nyaka chiengʼ,</para>
  <para style="q2" vid="PSA 9:7">oseguro kom loch mare mar ngʼado bura.<verse eid="PSA 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8"/>Obiro ngʼado bura ne piny gi tim makare;</para>
  <para style="q2" vid="PSA 9:8">obiro rito ogendini gi adiera.<verse eid="PSA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9"/>Jehova Nyasaye en kar pondo ne joma idiyo,</para>
  <para style="q2" vid="PSA 9:9">en e kar pondo e kinde mag chandruok.<verse eid="PSA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10"/>Joma ongʼeyo nyingi biro geno kuomi,</para>
  <para style="q2" vid="PSA 9:10">nikech in, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 9:10">ne pok ijwangʼo joma manyi.<verse eid="PSA 9:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11"/>Wer wende pak ne Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 9:11">mobet e kom lochne e Sayun;</para>
  <para style="q2" vid="PSA 9:11">hul ni ogendini gik mosetimo.<verse eid="PSA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12"/>Nikech ngʼat machulo kuor kuom remo mochwer siko kaparo;</para>
  <para style="q2" vid="PSA 9:12">ok owe mak odewo ywak joma hinyore.<verse eid="PSA 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13"/>Neye kaka wasika sanda, yaye Jehova Nyasaye!</para>
  <para style="q2" vid="PSA 9:13">Kecha kendo tingʼa igola e dhorangeye mag tho,<verse eid="PSA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14"/>mondo anyis pakni</para>
  <para style="q2" vid="PSA 9:14">e dhorangeye mag Nyi Sayun,</para>
  <para style="q2" vid="PSA 9:14">kendo abed mamor kuno nikech warruokni.<verse eid="PSA 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15"/>Ogendini oselutore e buche ma gikunyo;</para>
  <para style="q2" vid="PSA 9:15">tiendegi ogajore e tondegi ma gichokogo ji.<verse eid="PSA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16"/>Jehova Nyasaye ongʼere nikech adier mare;</para>
  <para style="q2" vid="PSA 9:16">joma timbegi richo omoko e gik ma giloso gi lwetgi giwegi. <char style="qs">Higaion. Sela</char><verse eid="PSA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17"/>Joma timbegi richo dok e bur matut,</para>
  <para style="q2" vid="PSA 9:17">nyaka ogendini duto ma wigi wil gi Nyasaye.<verse eid="PSA 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18"/>To jochan wiyi ok nowilgo ngangʼ</para>
  <para style="q2" vid="PSA 9:18">kendo geno mar joma hinyore ok rum.<verse eid="PSA 9:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19"/>Aa malo, yaye Jehova Nyasaye, kik iyie mondo dhano olochi;</para>
  <para style="q2" vid="PSA 9:19">ne ni ogendini ongʼadnegi bura e nyimi.<verse eid="PSA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20"/>Gogi gi luoro, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 9:20">mi ogendini ongʼe ni gin mana dhano. <char style="qs">Sela</char><verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="cl">Zaburi 10</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1"/>Angʼo momiyo ichungʼ gichien, yaye Jehova Nyasaye?</para>
  <para style="q2" vid="PSA 10:1">Angʼo momiyo ipondo ne ji e ndalo mag chandruok?<verse eid="PSA 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2"/>Ngʼat ma timbene richo goyo apedha ni joma onge nyalo</para>
  <para style="q2" vid="PSA 10:2">kendo omakogi e otegu mage mosechiko.<verse eid="PSA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3"/>Dwache maricho mopando e chunye omiyo osungore;</para>
  <para style="q2" vid="PSA 10:3">jowuoche ema ogwedho to Jehova Nyasaye to ochayo.<verse eid="PSA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4"/>Sunga omake ma ok onyal manye;</para>
  <para style="q2" vid="PSA 10:4">onge thuolo kata matin mochiwo ne Nyasaye e chunye.<verse eid="PSA 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5"/>Yorene dhi maber kinde duto,</para>
  <para style="q2" vid="PSA 10:5">okawore omiyo chikeni ni mabor moyombe;</para>
  <para style="q2" vid="PSA 10:5">ojaro wasike duto.<verse eid="PSA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6"/>Owacho ne en owuon niya, “Onge gima nyalo yienga;</para>
  <para style="q2" vid="PSA 10:6">abiro dak gi kwe kinde duto kaonge gima thaga.”<verse eid="PSA 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7"/>Dhoge opongʼ gi miriambo kod weche mag kwongʼ;</para>
  <para style="q2" vid="PSA 10:7">chandruok gi weche maricho ni e bwo lewe.<verse eid="PSA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8"/>Okiyo ji e bath yore mag gwengʼ,</para>
  <para style="q2" vid="PSA 10:8">onego ji apoya koa kuonde moponde,</para>
  <para style="q2" vid="PSA 10:8">osiko ongʼicho mondo wangʼe omaki joma onge ketho mondo ohiny.<verse eid="PSA 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9"/>Okiyo ji kokichore ka sibuor mopondo;</para>
  <para style="q2" vid="PSA 10:9">okichore mar mako joma ok nyal mondo ohinygi,</para>
  <para style="q2" vid="PSA 10:9">omako joma ok nyal kendo oywayogi oko gi tonde mar meko.<verse eid="PSA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10"/>Joma hapgi rach momako otieko kendo podho chuth,</para>
  <para style="q2" vid="PSA 10:10">gipodho e bwo tekone.<verse eid="PSA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11"/>Owachone en owuon niya, “Nyasaye wiye osewil;</para>
  <para style="q2" vid="PSA 10:11">opando wangʼe kendo onge gima oneno.”<verse eid="PSA 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12"/>Aa malo yaye Jehova Nyasaye!</para>
  <para style="q2" vid="PSA 10:12">Tingʼ badi malo, yaye Nyasaye.</para>
  <para style="q2" vid="PSA 10:12">Kik wiyi wil gi joma ok nyal.<verse eid="PSA 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13"/>Angʼo momiyo ngʼama timbene richo jaro Nyasaye?</para>
  <para style="q2" vid="PSA 10:13">Angʼo momiyo owacho e chunye ni,</para>
  <para style="q2" vid="PSA 10:13">“Ok obi keta piny mopenja gima asetimo?”<verse eid="PSA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14"/>To in, yaye Nyasaye, ineno chandruok gi kuyo,</para>
  <para style="q2" vid="PSA 10:14">ikawogi kaka mari kendo itingʼogi e lweti.</para>
  <para style="q1" vid="PSA 10:14">Ngʼat ma ok nyal; chiwore ne in;</para>
  <para style="q2" vid="PSA 10:14">in e jakony mar joma onge wuonegi.<verse eid="PSA 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15"/>Tur bad ngʼama rach ma timbene richo;</para>
  <para style="q2" vid="PSA 10:15">luonge mondo onyis ji gik maricho mosetimo lingʼ-lingʼ,</para>
  <para style="q2" vid="PSA 10:15">ma ji ok nyal fwenyo mi ngʼe.<verse eid="PSA 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16"/>Jehova Nyasaye en Ruoth mochwere manyaka chiengʼ;</para>
  <para style="q2" vid="PSA 10:16">ogendini biro lal nono e pinye.<verse eid="PSA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17"/>Yaye Jehova Nyasaye, in iwinjo kwayo mar joma chandore;</para>
  <para style="q2" vid="PSA 10:17">ijiwogi, kendo ichiko iti ni ywakgi,<verse eid="PSA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18"/>Ichwako nyithi kiye kod joma isando,</para>
  <para style="q2" vid="PSA 10:18">mondo dhano ma ochwe gi lowo,</para>
  <para style="q2" vid="PSA 10:18">kik dhi nyime gi bwogo ji.<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="cl">Zaburi 11</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1"/>Jehova Nyasaye ema ageno kuome.</para>
  <para style="q2" vid="PSA 11:1">Koro ere kaka duwachna ni:</para>
  <para style="q2" vid="PSA 11:1">“Ringi ka winyo nyaka ewi got mari.<verse eid="PSA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2"/>Nikech joma timbegi richo osechako ywayo atungegi;</para>
  <para style="q2" vid="PSA 11:2">gisechano asernigi e tonde mag atungʼ,</para>
  <para style="q1" vid="PSA 11:2">mondo gichielgo</para>
  <para style="q2" vid="PSA 11:2">joma jo-adiera e chunygi.<verse eid="PSA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3"/>Ka mise iketho,</para>
  <para style="q2" vid="PSA 11:3">to en angʼo ma joma kare ditim?”<verse eid="PSA 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4"/>Jehova Nyasaye ni e hekalu mare maler;</para>
  <para style="q2" vid="PSA 11:4">Jehova Nyasaye ni e kom duongʼ mare manie polo.</para>
  <para style="q1" vid="PSA 11:4">Orango timbe yawuot ji;</para>
  <para style="q2" vid="PSA 11:4">wengene nonogi matut.<verse eid="PSA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5"/>Jehova Nyasaye nono joma kare,</para>
  <para style="q2" vid="PSA 11:5">to joma timbegi richo kod joma ohero mahundu,</para>
  <para style="q2" vid="PSA 11:5">to chunye ochayo.<verse eid="PSA 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6"/>Obiro chwero</para>
  <para style="q2" vid="PSA 11:6">mach maliel mager kod salfa kuom joma timbegi richo;</para>
  <para style="q2" vid="PSA 11:6">yamo maliet ha matwoyo gik moko, biro kudhogi.<verse eid="PSA 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7"/>Nikech Jehova Nyasaye en Ngʼama Kare,</para>
  <para style="q2" vid="PSA 11:7">kendo ohero adiera;</para>
  <para style="q2" vid="PSA 11:7">joma timbegi oriere biro neno wangʼe.<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="cl">Zaburi 12</para>
  <para style="d">Kuom jatend wer. Kaluwore gi <char style="tl">sheminith</char><note caller="+" style="f"><char style="fr" closed="false">12:0 </char><char style="fl" closed="false">Sheminith: </char><char style="ft" closed="false">Ochalo ni en kit wer moro</char></note>. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1"/>Kony ji yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 12:1">nikech joma oluoro Nyasaye koro onge;</para>
  <para style="q2" vid="PSA 12:1">joma jo-adiera oserumo e dier ji.<verse eid="PSA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2"/>Ngʼato ka ngʼato riambo ne nyawadgi;</para>
  <para style="q2" vid="PSA 12:2">dhogi mohero jaro ji wuoyo gi wuond.<verse eid="PSA 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3"/>Mad Jehova Nyasaye ongʼad oko lep duto</para>
  <para style="q2" vid="PSA 12:3">ma jaro ji kod lep duto masungore;<verse eid="PSA 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4"/>mawacho niya, “Wabiro wuoyo kaka wahero;</para>
  <para style="q2" vid="PSA 12:4">kendo onge ngʼama biro tamowa.</para>
  <para style="q2" vid="PSA 12:4">Koso en ngʼa ma ruodhwa manyalo tamowa timo kamano?”<verse eid="PSA 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5"/>“Nikech dich modigo joma ok nyal</para>
  <para style="q2" vid="PSA 12:5">kod chur ma joma ochando churgo,</para>
  <para style="q1" vid="PSA 12:5">koro abiro aa malo,” Jehova Nyasaye owacho.</para>
  <para style="q2" vid="PSA 12:5">“Abiro ritogi e lwet joma sandogi.”<verse eid="PSA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6"/>Weche Jehova Nyasaye liw,</para>
  <para style="q2" vid="PSA 12:6">giliw ka fedha moleny e lowo mowangʼ maliet ha,</para>
  <para style="q2" vid="PSA 12:6">mopwodhi ndalo abiriyo.<verse eid="PSA 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7"/>Yaye Jehova Nyasaye, yie iritwa maber kik gimoro ohinywa</para>
  <para style="q2" vid="PSA 12:7">kendo reswa e lwet joma kamago nyaka chiengʼ.<verse eid="PSA 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8"/>Joma timbegi richo wuotho koni gi koni</para>
  <para style="q2" vid="PSA 12:8">kendo gima rach ema ji puoyo.<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="cl">Zaburi 13</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1"/>Nyaka karangʼo, yaye Jehova Nyasaye? Wiyi biro wil koda nyaka chiengʼ koso?</para>
  <para style="q2" vid="PSA 13:1">Ibiro pandona wangʼi nyaka karangʼo?<verse eid="PSA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2"/>Abiro dhi nyime ka an gi pek manie pacha</para>
  <para style="q2" vid="PSA 13:2">kod kuyo manie chunya odiechiengʼ kodiechiengʼ nyaka karangʼo?</para>
  <para style="q2" vid="PSA 13:2">Wasika biro locho kuoma nyaka karangʼo?<verse eid="PSA 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3"/>Para kendo idwoka, yaye Jehova Nyasaye Nyasacha.</para>
  <para style="q2" vid="PSA 13:3">Chiw ler ne wengena, nono to dipo ka nindo otera mi atho;<verse eid="PSA 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4"/>nikech mano nyalo miyo jasika wach niya, “Aseloye,”</para>
  <para style="q2" vid="PSA 13:4">kendo wasika biro bedo mamor ka apodho.<verse eid="PSA 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5"/>Anto ageno kuom herani mosiko;</para>
  <para style="q2" vid="PSA 13:5">chunya oil kuom warruok mari.<verse eid="PSA 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6"/>Abiro wer ne Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 13:6">nikech osebedo ka otimona maber.<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="cl">Zaburi 14</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1"/>Ngʼat mofuwo wacho e chunye niya,</para>
  <para style="q2" vid="PSA 14:1">“Nyasaye onge.”</para>
  <para style="q1" vid="PSA 14:1">Gin joma okethore, timbegi richo mokalo tongʼ,</para>
  <para style="q2" vid="PSA 14:1">onge kata ngʼato achiel matimo maber.<verse eid="PSA 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2"/>Jehova Nyasaye ngʼiyo ji duto gie polo,</para>
  <para style="q2" vid="PSA 14:2">mondo oneye ka bende nitie moro kuomgi ma nigi winjo,</para>
  <para style="q2" vid="PSA 14:2">kata ka bende nitie moro kuomgi mamanyo Nyasaye.<verse eid="PSA 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3"/>Ji duto osebaro,</para>
  <para style="q2" vid="PSA 14:3">giduto kaachiel gisedoko joma okethore;</para>
  <para style="q1" vid="PSA 14:3">onge ngʼama timo maber,</para>
  <para style="q2" vid="PSA 14:3">onge kata achiel.<verse eid="PSA 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4"/>Bende joma timo timbe maricho dipuonjre adier?</para>
  <para style="b" vid="PSA 14:4"/>
  <para style="q1" vid="PSA 14:4">Gin joma kidho joga kaka ji chamo kuon;</para>
  <para style="q2" vid="PSA 14:4">kendo gin joma ok luong Jehova Nyasaye mondo okonygi.<verse eid="PSA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5"/>Negie kaka luoro dwaro negogi,</para>
  <para style="q2" vid="PSA 14:5">nikech Nyasaye nitie e chokruok mar joma kare.<verse eid="PSA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6"/>Un joma timo gik maricho, uketho chenro joma odhier,</para>
  <para style="q2" vid="PSA 14:6">to Jehova Nyasaye e kar pondo margi.<verse eid="PSA 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7"/>Yaye, mad warruok mar Israel obi koa Sayun!</para>
  <para style="q2" vid="PSA 14:7">Kinde ma Jehova Nyasaye duogo ne joge mwandugi,</para>
  <para style="q2" vid="PSA 14:7">onego joka Jakobo obed moil kendo Israel obed mamor!<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="cl">Zaburi 15</para>
  <para style="d">Zaburi Mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1"/>Jehova Nyasaye, en ngʼa manyalo siko kari maler milamie?</para>
  <para style="q2" vid="PSA 15:1">En ngʼa manyalo dak e godi maler?<verse eid="PSA 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2"/>En ngʼat ma wuodhe obidhore</para>
  <para style="q2" vid="PSA 15:2">kendo matimo gima kare,</para>
  <para style="q1" vid="PSA 15:2">ngʼat mawacho adiera gi e chunye<verse eid="PSA 15:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 15:3"/>kendo maonge gi miriambo e dhoge,</para>
  <para style="q1" vid="PSA 15:3">kendo ma ok tim ne wadgi gimoro amora marach</para>
  <para style="q2" vid="PSA 15:3">kendo ok dir weche makwodo wi dhano wadgi,<verse eid="PSA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4"/>Ngʼat machayo ngʼama timbene richo mokalo tongʼ,</para>
  <para style="q2" vid="PSA 15:4">to miyo joma oluoro Jehova Nyasaye duongʼ,</para>
  <para style="q1" vid="PSA 15:4">Ngʼat marito singruok motimo</para>
  <para style="q2" vid="PSA 15:4">kata bed ni timo kamano hinye,<verse eid="PSA 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5"/>Ngʼat ma holo ji pesane ma ok odwaro ni odwokne gi gimoro e wiye</para>
  <para style="q2" vid="PSA 15:5">kendo ma ok yie kaw asoya kuom joma onge ketho.</para>
  <para style="b" vid="PSA 15:5"/>
  <para style="q1" vid="PSA 15:5">Ngʼat matimo gik makamagi</para>
  <para style="q2" vid="PSA 15:5">gimoro amora ok nyal yiengo.<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="cl">Zaburi 16</para>
  <para style="d">
    <char style="tl">Miktam</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">16:0 </char>
      <char style="fl" closed="false">Miktam: </char>
      <char style="ft" closed="false">en kit wer mane Daudi wero.</char>
    </note> mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1"/>Rita maber, yaye Nyasaye</para>
  <para style="q2" vid="PSA 16:1">nikech in e kar pondona.<verse eid="PSA 16:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2"/>Ne awacho ne Jehova Nyasaye niya, “In e Ruodha;</para>
  <para style="q2" vid="PSA 16:2">onge gima ber machielo ma an-go makmana in.”<verse eid="PSA 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3"/>To jomaler manie piny,</para>
  <para style="q2" vid="PSA 16:3">to gin kaka joma nigi duongʼ ma ahero gi chunya duto.<verse eid="PSA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4"/>Joma lawo nyiseche mamoko</para>
  <para style="q2" vid="PSA 16:4">kuyo margi biro medore.</para>
  <para style="q1" vid="PSA 16:4">Misengini magi mag remo ok abi olo oko</para>
  <para style="q2" vid="PSA 16:4">kendo kata nying-gi ok abi hulo gi dhoga.<verse eid="PSA 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5"/>Jehova Nyasaye, isemiya pok makora kod okombena;</para>
  <para style="q2" vid="PSA 16:5">iserita maber gi giga duto.<verse eid="PSA 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6"/>Kiepena duto ochopo kuonde mabeyo;</para>
  <para style="q2" vid="PSA 16:6">adier, girkeni maga duto moro wangʼ adier.<verse eid="PSA 16:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7"/>Abiro pako Jehova Nyasaye mangʼadona rieko;</para>
  <para style="q2" vid="PSA 16:7">kata gotieno chunya puonja.<verse eid="PSA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8"/>Asiko aketo Jehova Nyasaye e nyima ndalo duto.</para>
  <para style="q2" vid="PSA 16:8">Nikech ka entie e lweta korachwich,</para>
  <para style="q2" vid="PSA 16:8">to onge gima nyalo yienga.<verse eid="PSA 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9"/>Emomiyo chunya mor kendo lewa yot;</para>
  <para style="q2" vid="PSA 16:9">ringra bende biro yweyo gi kwe,<verse eid="PSA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10"/>nikech ok inijwangʼa ei liel,</para>
  <para style="q2" vid="PSA 16:10">to bende ok niyie Ngʼati Maler tow.<verse eid="PSA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11"/>Isenyisa yor ngima;</para>
  <para style="q2" vid="PSA 16:11">inipongʼa gi mor mogundho ka an e nyimi,</para>
  <para style="q2" vid="PSA 16:11">kendo gi mor mosiko e badi korachwich.<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="cl">Zaburi 17</para>
  <para style="d">Lamo mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1"/>Yaye Jehova Nyasaye, yie iwinj kwayona makare;</para>
  <para style="q2" vid="PSA 17:1">chik iti ne ywakna,</para>
  <para style="q1" vid="PSA 17:1">chik iti ne lemona,</para>
  <para style="q2" vid="PSA 17:1">lamona ok aa e dhok mawuondo ji.<verse eid="PSA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2"/>Mad chwak michwakago oa kuomi;</para>
  <para style="q2" vid="PSA 17:2">mad wengeni nee gima kare.<verse eid="PSA 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3"/>Kata obedo ni inono chunya kendo itema gotieno,</para>
  <para style="q2" vid="PSA 17:3">kata ka itema to ok ibi yudo gimoro kuoma;</para>
  <para style="q2" vid="PSA 17:3">asengʼado e chunya ni dhoga ok bi timo richo.<verse eid="PSA 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4"/>To kuom gik ma joma moko timo,</para>
  <para style="q2" vid="PSA 17:4">kaluwore gi wach mowuok e dhogi,</para>
  <para style="q1" vid="PSA 17:4">an awuon asepogora</para>
  <para style="q2" vid="PSA 17:4">gi yore jo-mahundu.<verse eid="PSA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5"/>Tienda osesiko e yoreni;</para>
  <para style="q2" vid="PSA 17:5">tiendena pok okier.<verse eid="PSA 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6"/>Aluongi, yaye Nyasaye, nikech ibiro dwoka;</para>
  <para style="q2" vid="PSA 17:6">chik iti kendo winj lamona.<verse eid="PSA 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7"/>Nyisie teko mar herani maduongʼ,</para>
  <para style="q2" vid="PSA 17:7">in ma ireso ji gi lweti ma korachwich,</para>
  <para style="q2" vid="PSA 17:7">joma pondo ne wasikgi kuomi.<verse eid="PSA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8"/>Rita adimba kaka tong wangʼi,</para>
  <para style="q2" vid="PSA 17:8">panda e bwo tipo mar bwombi,<verse eid="PSA 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9"/>mondo atony e lwet joma richo ma lawa,</para>
  <para style="q2" vid="PSA 17:9">mondo atony e lwet wasika ma dhano molwora.<verse eid="PSA 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10"/>Chunjegi odinore matek,</para>
  <para style="q2" vid="PSA 17:10">kendo dhogi wuoyo gi wich teko.<verse eid="PSA 17:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="PSA 17:11"/>Giselawa kuonde duto, mi koro gilwora,</para>
  <para style="q2" vid="PSA 17:11">ka wengegi ochiek, mondo gidira piny.<verse eid="PSA 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12"/>Gichalo sibuor ma nigi kech mar mako le,</para>
  <para style="q2" vid="PSA 17:12">mana ka sibuor maduongʼ mopondo kokichore.<verse eid="PSA 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13"/>Aa malo, yaye Jehova Nyasaye, chomgi tir, mi igogi piny;</para>
  <para style="q2" vid="PSA 17:13">resa e lwet joma richo gi liganglani.<verse eid="PSA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14"/>Yaye Jehova Nyasaye, resa e lwet joma kamago gi lweti,</para>
  <para style="q2" vid="PSA 17:14">resa e lwet jopinyni ma pokgi ni e pinyni.</para>
  <para style="b" vid="PSA 17:14"/>
  <para style="q1" vid="PSA 17:14">Itieko kech ma joma ihero nigo;</para>
  <para style="q2" vid="PSA 17:14">yawuotgi nigi chiemo mangʼeny,</para>
  <para style="q2" vid="PSA 17:14">kendo gikano mwandu ne nyithindgi.<verse eid="PSA 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15"/>To anane wangʼi ka ngimana nikare;</para>
  <para style="q2" vid="PSA 17:15">ka achiewo, abiro romo ka aneno kiti kaka ichal.<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="cl">Zaburi 18</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi jatich Jehova Nyasaye. Nowerone Jehova Nyasaye weche mag wendni kinde mane Jehova Nyasaye orese e lwet wasike duto kendo e lwet Saulo. Nowacho niya:</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1"/>Aheri, yaye Jehova Nyasaye, in e tekra.<verse eid="PSA 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2"/>Jehova Nyasaye en lwandana,</para>
  <para style="q2" vid="PSA 18:2">en kar pondo mara kendo en jawarna;</para>
  <para style="q1" vid="PSA 18:2">Nyasacha en lwandana ma apondo kuome.</para>
  <para style="q2" vid="PSA 18:2">En okumbana, en tungʼ mar warruokna, kendo en ohingana.<verse eid="PSA 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3"/>Aluongo Jehova Nyasaye, en mowinjore gi pak,</para>
  <para style="q2" vid="PSA 18:3">kendo oresa e lwet wasika.<verse eid="PSA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4"/>Tonde mag tho ne orida matek;</para>
  <para style="q2" vid="PSA 18:4">kendo ohula mangʼongo mar tho nouma.<verse eid="PSA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5"/>Tonde mag liel ne orida kendo odhoga matek;</para>
  <para style="q2" vid="PSA 18:5">obadho mag tho ne ochoma tir.<verse eid="PSA 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6"/>E chandruok ne aluongo Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 18:6">ne aywak ne Nyasaye mondo okonya.</para>
  <para style="q1" vid="PSA 18:6">Ne owinjo dwonda gie hekalu mare;</para>
  <para style="q2" vid="PSA 18:6">ywakna nochopo e nyime, modonjo e ite.<verse eid="PSA 18:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7"/>Piny notetni kendo oyiengni;</para>
  <para style="q2" vid="PSA 18:7">kendo mise mag gode notetni;</para>
  <para style="q2" vid="PSA 18:7">ne gikirni nikech ne okecho.<verse eid="PSA 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8"/>Iro nodum koa e otuchi mag ume;</para>
  <para style="q2" vid="PSA 18:8">mach mangʼangʼni nodhuolore kawuok e dhoge,</para>
  <para style="q2" vid="PSA 18:8">kendo makaa maliel mager nobebni kawuok kuome.<verse eid="PSA 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9"/>Nobaro polo mobiro e piny;</para>
  <para style="q2" vid="PSA 18:9">rumbi molil ti nonyono gi tiende.<verse eid="PSA 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10"/>Noidho kerubi eka ofuyo;</para>
  <para style="q2" vid="PSA 18:10">ne ofuyo matek komoko e bwomb yamo.<verse eid="PSA 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11"/>Noloko mudho kaka raum mare, mudhono nobedo hema molwore,</para>
  <para style="q2" vid="PSA 18:11">kendo nokawo rumbi mar koth moloko raumne.<verse eid="PSA 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12"/>Boche nowuok e ler marieny mane aa kuome,</para>
  <para style="q2" vid="PSA 18:12">kaachiel gi pe madongo dongo kod mil polo ma tiarore.<verse eid="PSA 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13"/>Jehova Nyasaye nomor gie polo;</para>
  <para style="q2" vid="PSA 18:13">dwond Nyasaye Man Malo Moloyo nowinjore.<verse eid="PSA 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14"/>Nodiro asernige mokeyo wasigu,</para>
  <para style="q2" vid="PSA 18:14">mor polo gi mil polo noriembogi.<verse eid="PSA 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15"/>Holni manie bwo nembe noelore</para>
  <para style="q2" vid="PSA 18:15">kendo mise mag piny nowe nono,</para>
  <para style="q1" vid="PSA 18:15">kane ikwerogi, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 18:15">kane teko mar muya mowuok e otuchi mag umi ogoyogi.<verse eid="PSA 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16"/>Nochopo ira piny koa malo mi okawa;</para>
  <para style="q2" vid="PSA 18:16">ne ogola oko e kude mag pi matut.<verse eid="PSA 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17"/>Noresa e lwet jasika maratego,</para>
  <para style="q2" vid="PSA 18:17">kuom jowasika, mane tek moloya.<verse eid="PSA 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18"/>Negimonja e kinde mane an gi masira,</para>
  <para style="q2" vid="PSA 18:18">to Jehova Nyasaye ema nokonya.<verse eid="PSA 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19"/>Ne okela moketa kama lach;</para>
  <para style="q2" vid="PSA 18:19">ne oresa nikech chunye ne mor koda.<verse eid="PSA 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20"/>Jehova Nyasaye osetimona maber ka oluwore gi timna makare;</para>
  <para style="q2" vid="PSA 18:20">osechiwona ka oluwore gi ler mar lwetena.<verse eid="PSA 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21"/>Nikech aserito yore Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 18:21">pok atimo marach kuom lokora weyo Nyasacha.<verse eid="PSA 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22"/>Chikene duto ni e nyima;</para>
  <para style="q2" vid="PSA 18:22">pok alokora aweyo buchene.<verse eid="PSA 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23"/>Asebedo ka aonge ketho e nyime</para>
  <para style="q2" vid="PSA 18:23">kendo aseritora mondo kik atim richo.<verse eid="PSA 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24"/>Jehova Nyasaye osechiwona kaluwore gi timna makare,</para>
  <para style="q2" vid="PSA 18:24">osechiwona kaluwore gi ler mar lwetena e nyime.<verse eid="PSA 18:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25"/>Ne joma jo-adiera, inyisori kaka ja-adiera,</para>
  <para style="q2" vid="PSA 18:25">kendo ne joma longʼo, inyisori kaka ngʼama longʼo,<verse eid="PSA 18:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26"/>ne jomaler, inyisori kaka ngʼama ler,</para>
  <para style="q2" vid="PSA 18:26">to ne joma yoregi obam, inyisori kaka ngʼama rach.<verse eid="PSA 18:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27"/>Ireso joma muol</para>
  <para style="q2" vid="PSA 18:27">to joma wengegi tek idwoko piny.<verse eid="PSA 18:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28"/>In ema imiyo tacha siko kaliel, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 18:28">Nyasacha loko mudho mouma doko ler.<verse eid="PSA 18:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29"/>Ka ikonya to anyalo loyo jolweny momonja;</para>
  <para style="q2" vid="PSA 18:29">ka an gi Nyasacha to anyalo lwenyo ohinga.<verse eid="PSA 18:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30"/>Nyasaye to yore longʼo chuth;</para>
  <para style="q2" vid="PSA 18:30">wach Jehova Nyasaye onge rem moro amora.</para>
  <para style="q1" vid="PSA 18:30">En okumba</para>
  <para style="q2" vid="PSA 18:30">ne ji duto ma pondo kuome.<verse eid="PSA 18:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31"/>Nikech en Nyasaye mane minyalo pimo gi Jehova Nyasaye?</para>
  <para style="q2" vid="PSA 18:31">Koso en ngʼa ma en Lwanda, ka ok Nyasachwa?<verse eid="PSA 18:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32"/>Nyasaye ema miya teko</para>
  <para style="q2" vid="PSA 18:32">kendo omiyo yora bedo mokwe.<verse eid="PSA 18:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33"/>Omiyo tiendena bedo mayot ka tiende mwanda;</para>
  <para style="q2" vid="PSA 18:33">kendo en ema omiyo achungʼ kuonde man malo maboyo.<verse eid="PSA 18:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34"/>Otiego lwetena ne lweny;</para>
  <para style="q2" vid="PSA 18:34">momiyo bedena nyalo dolo atung nyinyo.<verse eid="PSA 18:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35"/>Isemiya okumba mar warruokni,</para>
  <para style="q2" vid="PSA 18:35">kendo lweti korachwich osesira;</para>
  <para style="q2" vid="PSA 18:35">kony mari osemiyo abedo gi duongʼ.<verse eid="PSA 18:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36"/>Imiyo yo mawuothoe bedo malach,</para>
  <para style="q2" vid="PSA 18:36">mondo tiendena kik ba yo.<verse eid="PSA 18:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37"/>Ne alawo wasika mi ajukogi;</para>
  <para style="q2" vid="PSA 18:37">kendo ne ok alokora aweyogi nyaka ne atiekogi pep.<verse eid="PSA 18:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38"/>Ne atiekogi, mane ok ginyal chungʼ;</para>
  <para style="q2" vid="PSA 18:38">negipodho e tienda.<verse eid="PSA 18:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39"/>Ne imiya teko mar kedo lweny;</para>
  <para style="q2" vid="PSA 18:39">ne imiyo jomamon koda kulore e nyima.<verse eid="PSA 18:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40"/>Ne imiyo wasika oringo kadhi,</para>
  <para style="q2" vid="PSA 18:40">mine atieko joma ok dwara.<verse eid="PSA 18:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41"/>Ne giywak mondo okonygi to onge ngʼama ne nyalo resogi;</para>
  <para style="q2" vid="PSA 18:41">ne giywakne Jehova Nyasaye to ne ok odwokogi.<verse eid="PSA 18:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42"/>Ne agoyogi adunya ka buru ma yamo tero,</para>
  <para style="q2" vid="PSA 18:42">ne achodhogi oko ka chwodho mag yore mag dala.<verse eid="PSA 18:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43"/>Ne iresa e ywaruok gi ji.</para>
  <para style="q2" vid="PSA 18:43">Ne iketa jatend ogendini;</para>
  <para style="q2" vid="PSA 18:43">joma ne ok angʼeyo chon notiyona.<verse eid="PSA 18:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44"/>Kane giwinjo humba, ne giwinja;</para>
  <para style="q2" vid="PSA 18:44">jopinje mamoko nobiro motwere kuoma.<verse eid="PSA 18:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45"/>Negibiro ka gitetni; kendo ka chunygi ool,</para>
  <para style="q2" vid="PSA 18:45">ka gia kuondegi mag pondo.<verse eid="PSA 18:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46"/>Jehova Nyasaye ngima! Lwandana mondo ogwedhi.</para>
  <para style="q2" vid="PSA 18:46">Kendo Nyasaye mar Warruokna mondo otingʼ malo!<verse eid="PSA 18:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47"/>Nyasaye mane ochulo kuor kara</para>
  <para style="q2" vid="PSA 18:47">kendo oloyo ogendini e bwoya;<verse eid="PSA 18:47"/></para>
  <para style="q2">
    <verse number="48" style="v" sid="PSA 18:48"/>mane oresa e lwet wasika;</para>
  <para style="q1" vid="PSA 18:48">ne itingʼa malo e kind wasika</para>
  <para style="q2" vid="PSA 18:48">ne iresa e lwet jo-mahundu.<verse eid="PSA 18:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49"/>Emomiyo anapaki e kind ogendini, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 18:49">kendo anawer wende mapako nyingi.<verse eid="PSA 18:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50"/>Jehova Nyasaye kelo resruok maduongʼ ne ruoth moketo,</para>
  <para style="q2" vid="PSA 18:50">onyiso hera mogundho ma ok rum ne ngʼate mowir,</para>
  <para style="q2" vid="PSA 18:50">ni Daudi gi nyikwaye nyaka chiengʼ.<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="cl">Zaburi 19</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1"/>Polo hulo duongʼ mar Nyasaye;</para>
  <para style="q2" vid="PSA 19:1">kor polo nyiso tich mar lwete.<verse eid="PSA 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2"/>Odiechiengʼ kodiechiengʼ gilando wach;</para>
  <para style="q2" vid="PSA 19:2">otieno kotieno ginyiso rieko.<verse eid="PSA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3"/>Gionge dhok kata weche</para>
  <para style="q2" vid="PSA 19:3">kata dwondgi ok winji.<verse eid="PSA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4"/>Kata kamano dwondgi chopo kuonde duto e piny,</para>
  <para style="q2" vid="PSA 19:4">wechegi osechopo nyaka e tunge piny.</para>
  <para style="q1" vid="PSA 19:4">Osechungo hema e kor polo ne wangʼ chiengʼ,<verse eid="PSA 19:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 19:5"/>machalo gi wuon kisera mothinyore oko kawuok e ode mar mor,</para>
  <para style="q2" vid="PSA 19:5">kendo mana ka jangʼwech mongirore moil moikore ni chako ngʼwech.<verse eid="PSA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6"/>Owuok gie tungʼ polo konchiel,</para>
  <para style="q2" vid="PSA 19:6">kendo olworore nyaka komachielo;</para>
  <para style="q2" vid="PSA 19:6">onge gima opondo ne liet mare.<verse eid="PSA 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7"/>Chik Jehova Nyasaye longʼo chuth,</para>
  <para style="q2" vid="PSA 19:7">odwogo chuny.</para>
  <para style="q1" vid="PSA 19:7">Buche mag Jehova Nyasaye gin adiera,</para>
  <para style="q1" vid="PSA 19:7">gimiyo joma riekogi tin bedo mariek.<verse eid="PSA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8"/>Chike mag Jehova Nyasaye nikare,</para>
  <para style="q2" vid="PSA 19:8">gichiwo mor ne chuny.</para>
  <para style="q1" vid="PSA 19:8">Chike mag Jehova Nyasaye rieny,</para>
  <para style="q2" vid="PSA 19:8">gichiwo ler ne wangʼ.<verse eid="PSA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9"/>Luoro Jehova Nyasaye en gima ber,</para>
  <para style="q2" vid="PSA 19:9">mosiko nyaka chiengʼ.</para>
  <para style="q1" vid="PSA 19:9">Buche mag Jehova Nyasaye gin adier</para>
  <para style="q2" vid="PSA 19:9">kendo gin kare kargi giduto.<verse eid="PSA 19:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10"/>Gibeyo moloyo dhahabu,</para>
  <para style="q2" vid="PSA 19:10">moloyo dhahabu malerie moloyo;</para>
  <para style="q1" vid="PSA 19:10">gimit moloyo mor kich</para>
  <para style="q2" vid="PSA 19:10">moa e pedni.<verse eid="PSA 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11"/>Gin ema gimiyo jatichni bedo motangʼ; kendo bedogi kanyo</para>
  <para style="q2" vid="PSA 19:11">kelo pok maduongʼ.<verse eid="PSA 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12"/>En ngʼa manyalo ngʼeyo kethone mopondo?</para>
  <para style="q2" vid="PSA 19:12">Wena kethoga mopondo.<verse eid="PSA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13"/>Bende gengʼ jatichni kuom richo mag wich teko;</para>
  <para style="q2" vid="PSA 19:13">mad kik gibed gi loch kuoma.</para>
  <para style="q1" vid="PSA 19:13">Eka anabed maonge ketho,</para>
  <para style="q2" vid="PSA 19:13">anabed ka aonge gi ketho chik moro maduongʼ.<verse eid="PSA 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14"/>Mad weche mawuok e dhoga, kod paro manie chunya,</para>
  <para style="q2" vid="PSA 19:14">obed malongʼo e nyimi,</para>
  <para style="q2" vid="PSA 19:14">yaye Jehova Nyasaye, Lwandana kendo Jawarna.<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="cl">Zaburi 20</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1"/>Mad Jehova Nyasaye dwoki ka in e chandruok;</para>
  <para style="q2" vid="PSA 20:1">mad nying Nyasach Jakobo riti.<verse eid="PSA 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2"/>Mad oorni kony moa kare maler mar lemo</para>
  <para style="q2" vid="PSA 20:2">kendo omiyi kony moa Sayun.<verse eid="PSA 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3"/>Mad opar misengni magi duto</para>
  <para style="q2" vid="PSA 20:3">kendo oyie gi misengini miwangʼo pep magi. <char style="qs">Sela</char><note caller="+" style="f"><char style="fr" closed="false">20:3 </char><char style="fq" closed="false">Sela </char><char style="ft" closed="false">tiend wachni ok ongʼere.</char></note><verse eid="PSA 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4"/>Mad omiyi gima chunyi gombo</para>
  <para style="q2" vid="PSA 20:4">kendo omi chenro magi duto odhi maber.<verse eid="PSA 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5"/>Wabiro kok gimor ka ilocho</para>
  <para style="q2" vid="PSA 20:5">kendo wabiro tingʼo bendechwa malo e nying Nyasachwa.</para>
  <para style="q1" vid="PSA 20:5">Mad Jehova Nyasaye chiw</para>
  <para style="q2" vid="PSA 20:5">gik moko duto mikwaye.<verse eid="PSA 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6"/>Koro angʼeyo ni Jehova Nyasaye reso ngʼate mowir;</para>
  <para style="q2" vid="PSA 20:6">odwoke gie kare maler mar lemo manie polo,</para>
  <para style="q2" vid="PSA 20:6">gi teko ma waro ji mar lwete ma korachwich.<verse eid="PSA 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7"/>Jomoko ogeno kuom gechegi to jomoko kuom faresegi,</para>
  <para style="q2" vid="PSA 20:7">to wan to wageno kuom nying Jehova Nyasaye, ma Nyasachwa.<verse eid="PSA 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8"/>Gibiro lwar e chonggi mi gipodhi,</para>
  <para style="q2" vid="PSA 20:8">to wan wabiro aa malo mi wachungʼ motegno.<verse eid="PSA 20:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9"/>Yaye Jehova Nyasaye, reswa ruoth!</para>
  <para style="q2" vid="PSA 20:9">Dwokwa ka waluongi!<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="cl">Zaburi 21</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1"/>Yaye Jehova Nyasaye, ruoth oil nikech teko ma imiye.</para>
  <para style="q2" vid="PSA 21:1">Mano kaka en gi mor maduongʼ nikech isemiyo olocho!<verse eid="PSA 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2"/>Isemiye gima chunye gombo</para>
  <para style="q2" vid="PSA 21:2">kendo pok idagi timone kwayone. <char style="qs">Sela</char><verse eid="PSA 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3"/>Ne irwake gi gweth momew</para>
  <para style="q2" vid="PSA 21:3">kendo nisidho osimbo mar dhahabu maler e wiye.<verse eid="PSA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4"/>Ne okwayi ngima kendo ne imiye;</para>
  <para style="q2" vid="PSA 21:4">ne imede ndalo mochwere manyaka chiengʼ.<verse eid="PSA 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5"/>Kuom loch mane ichiwo, duongʼ mare duongʼ;</para>
  <para style="q2" vid="PSA 21:5">isemiye huma gi luor.<verse eid="PSA 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6"/>Adier, isemiye gweth mochwere</para>
  <para style="q2" vid="PSA 21:6">kendo isemiyo obedo mamor gi mor moa kuomi.<verse eid="PSA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7"/>Nikech ruoth ogeno kuom Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 21:7">kuom hera ma ok rum mar Nyasaye Man Malo Moloyo,</para>
  <para style="q2" vid="PSA 21:7">ok obi yiengni.<verse eid="PSA 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8"/>Lweti biro mako wasiki duto;</para>
  <para style="q2" vid="PSA 21:8">lweti ma korachwich biro ndhiyo joma kedo kodi.<verse eid="PSA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9"/>E sa ma ibiro chopoe,</para>
  <para style="q2" vid="PSA 21:9">to ibiro miyo gichal gi kendo mar mach mager.</para>
  <para style="q1" vid="PSA 21:9">Jehova Nyasaye biro mwonyogi kuom mirimbe mager,</para>
  <para style="q2" vid="PSA 21:9">kendo mach mare biro tiekogi.<verse eid="PSA 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10"/>Ibiro tieko kothgi mi rum e piny,</para>
  <para style="q2" vid="PSA 21:10">kendo nyithindgi biro rumo e dier ji.<verse eid="PSA 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11"/>Kata obedo ni gichano timoni marach</para>
  <para style="q2" vid="PSA 21:11">kendo giloso chenro maricho, to ok ginyal loyo;<verse eid="PSA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12"/>nikech ibiro miyo gilok dier ngʼegi</para>
  <para style="q2" vid="PSA 21:12">ka ibiro dimbogi gi atungʼ moywa.<verse eid="PSA 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13"/>Yud duongʼ, yaye Jehova Nyasaye, kuom tekoni maduongʼ;</para>
  <para style="q2" vid="PSA 21:13">wabiro wer kendo pako nyalo mari.<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="cl">Zaburi 22</para>
  <para style="d">Kuom jatend wer. E dwol mar “Mwanda mar Okinyi.” Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1"/>Nyasacha, Nyasacha, iweya nangʼo?</para>
  <para style="q2" vid="PSA 22:1">Angʼo momiyo in mabor koda ma ok inyal resa?</para>
  <para style="q2" vid="PSA 22:1">In mabor ma ok inyal winjo weche mag churna mondo iresa?<verse eid="PSA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2"/>Yaye Nyasacha, aywagora odiechiengʼ duto to ok idwoka,</para>
  <para style="q2" vid="PSA 22:2">aywagora gotieno bende ma ok alingʼ.<verse eid="PSA 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3"/>To eka ibet e kom duongʼ kaka Ngʼama Ler;</para>
  <para style="q2" vid="PSA 22:3">in e pak mar jo-Israel.<verse eid="PSA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4"/>Kuomi ema wuonewa noketoe genogi;</para>
  <para style="q2" vid="PSA 22:4">ne gigeni kendo ne iresogi.<verse eid="PSA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5"/>Ne giywakni kendo ne iwarogi;</para>
  <para style="q2" vid="PSA 22:5">negigeno kuomi mine ok gineno wichkuot.<verse eid="PSA 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6"/>An to an mana kudni ma ok dhano,</para>
  <para style="q2" vid="PSA 22:6">ngʼama ji duto jaro kendo ma ji ochayo.<verse eid="PSA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7"/>Ji duto monena jara;</para>
  <para style="q2" vid="PSA 22:7">gidiro ayany ka gikino wigi.<verse eid="PSA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8"/>“Ogeno kuom Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 22:8">koro mondo Jehova Nyasaye okonye ane.</para>
  <para style="q1" vid="PSA 22:8">Koro mondo orese ane,</para>
  <para style="q2" vid="PSA 22:8">nikech chunye mor kode.”<verse eid="PSA 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9"/>To in ema ne igola e ich;</para>
  <para style="q2" vid="PSA 22:9">ne ichweya mondo agen kuomi kata kane pod adhodho thund minwa.<verse eid="PSA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10"/>Ne oriwa kodi chakre chiengʼ mane onywolae;</para>
  <para style="q2" vid="PSA 22:10">isebedo Nyasacha aa kinde mane an ei minwa.<verse eid="PSA 22:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11"/>Kik ibed mabor koda,</para>
  <para style="q2" vid="PSA 22:11">nikech chandruok ni koda machiegni,</para>
  <para style="q2" vid="PSA 22:11">kendo onge ngʼama nyalo konya.<verse eid="PSA 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12"/>Rwedhi mangʼeny olwora;</para>
  <para style="q2" vid="PSA 22:12">rwedhi maroteke moa Bashan olwora koni gi koni.<verse eid="PSA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13"/>Sibuoche maruto makidho le ma gisemako</para>
  <para style="q2" vid="PSA 22:13">ongʼamo dhogi malach ka dwaro kidha.<verse eid="PSA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14"/>Ipuka oko ka pi,</para>
  <para style="q2" vid="PSA 22:14">kendo chokena duto osewil.</para>
  <para style="q1" vid="PSA 22:14">Chunya olokore odok;</para>
  <para style="q2" vid="PSA 22:14">oseleny morumo e iya.<verse eid="PSA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15"/>Tekona osetwo ka balatago,</para>
  <para style="q2" vid="PSA 22:15">kendo lewa omoko e danda;</para>
  <para style="q2" vid="PSA 22:15">isepiela e lop tho.<verse eid="PSA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16"/>Guogi oselwora;</para>
  <para style="q2" vid="PSA 22:16">oganda mar joma richo oseketa diere,</para>
  <para style="q2" vid="PSA 22:16">gisetucho lwetena gi tiendena.<verse eid="PSA 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17"/>Anyalo kwano chokena duto;</para>
  <para style="q2" vid="PSA 22:17">ji ranga amingʼa kendo jara.<verse eid="PSA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18"/>Ne gipogore lepa e kindgi giwegi</para>
  <para style="q2" vid="PSA 22:18">kendo gigoyo ombulu ne nangana.<verse eid="PSA 22:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19"/>To in, yaye Jehova Nyasaye, kik ibed mabor koda.</para>
  <para style="q2" vid="PSA 22:19">In e tekra, bi piyo mondo ikonya.<verse eid="PSA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20"/>Res ngimana kuom ligangla,</para>
  <para style="q2" vid="PSA 22:20">res ngimana e teko guogi.<verse eid="PSA 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21"/>Resa e dho sibuoche;</para>
  <para style="q2" vid="PSA 22:21">resa e tunge jowi mager.<verse eid="PSA 22:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22"/>Abiro hulo nyingi ne owetena;</para>
  <para style="q2" vid="PSA 22:22">abiro paki e nyim chokruok.<verse eid="PSA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23"/>Un muluoro Jehova Nyasaye, pakeuru!</para>
  <para style="q2" vid="PSA 22:23">Un nyikwa Jakobo duto, miyeuru duongʼ.</para>
  <para style="q2" vid="PSA 22:23">Luoreuru, un koth jo-Israel duto!<verse eid="PSA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24"/>Nikech pok ochayo kata ojaro</para>
  <para style="q2" vid="PSA 22:24">sandruok mar joma winjo malit;</para>
  <para style="q1" vid="PSA 22:24">pok opandone wangʼe</para>
  <para style="q2" vid="PSA 22:24">to osewinjo ywakne mar dwaro kony.<verse eid="PSA 22:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25"/>Kuomi ema thoro mara mar pak e chokruok maduongʼ aye;</para>
  <para style="q2" vid="PSA 22:25">abiro chopo singruok maga e nyim joma oluori.<verse eid="PSA 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26"/>Joma odhier biro chiemo mi yiengʼ;</para>
  <para style="q2" vid="PSA 22:26">joma manyo Jehova Nyasaye biro pake,</para>
  <para style="q2" vid="PSA 22:26">mad chunjeu bed mangima nyaka chiengʼ!<verse eid="PSA 22:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27"/>Tunge piny duto</para>
  <para style="q2" vid="PSA 22:27">biro paro miduog ir Jehova Nyasaye,</para>
  <para style="q1" vid="PSA 22:27">kendo dhout ogendini duto</para>
  <para style="q2" vid="PSA 22:27">biro kulore e nyime,<verse eid="PSA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28"/>Nikech loch en mar Jehova Nyasaye</para>
  <para style="q2" vid="PSA 22:28">kendo en ema olocho ewi ogendini.<verse eid="PSA 22:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29"/>Jo-mwandu duto manie piny biro chiemo kendo lemo;</para>
  <para style="q2" vid="PSA 22:29">ji duto madhi piny e lowo biro kulore e nyime,</para>
  <para style="q2" vid="PSA 22:29">jogo ma ok nyal siko kangima.<verse eid="PSA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30"/>Tienge mabiro noti ne Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 22:30">kendo nonyis ogendini mabiro wachne.<verse eid="PSA 22:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31"/>Gibiro hulo timne makare,</para>
  <para style="q2" vid="PSA 22:31">ne ji mapok onywol niya:</para>
  <para style="q2" vid="PSA 22:31">“Jehova Nyasaye osewaro joge.”<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="cl">Zaburi 23</para>
  <para style="d">Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1"/>Jehova Nyasaye e jakwadha, ok anachand gimoro.<verse eid="PSA 23:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 23:2"/>Omiyo ayweyo e lum mangʼich,</para>
  <para style="q1" vid="PSA 23:2">otelona e aore mokwe,<verse eid="PSA 23:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 23:3"/>odwogo chunya.</para>
  <para style="q1" vid="PSA 23:3">Otaya e yore mag tim makare</para>
  <para style="q2" vid="PSA 23:3">mondo nyinge oyud duongʼ.<verse eid="PSA 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4"/>Kata ka obedo ni awuotho</para>
  <para style="q2" vid="PSA 23:4">e hoho mar tipo mar tho,</para>
  <para style="q1" vid="PSA 23:4">to ok analuor gimoro marach,</para>
  <para style="q2" vid="PSA 23:4">nimar in koda;</para>
  <para style="q1" vid="PSA 23:4">ludhi gi odungani</para>
  <para style="q2" vid="PSA 23:4">ema hoya.<verse eid="PSA 23:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5"/>Iloso mesa e nyima</para>
  <para style="q2" vid="PSA 23:5">ka wasika neno.</para>
  <para style="q1" vid="PSA 23:5">Iwiro wiya gi mo;</para>
  <para style="q2" vid="PSA 23:5">kikombena opongʼ moo oko.<verse eid="PSA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6"/>Adier, ber gihera biro luwa</para>
  <para style="q2" vid="PSA 23:6">ndalo duto mag ngimana,</para>
  <para style="q1" vid="PSA 23:6">kendo abiro dak e od Jehova Nyasaye</para>
  <para style="q2" vid="PSA 23:6">nyaka chiengʼ.<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="cl">Zaburi 24</para>
  <para style="d">Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1"/>Piny kaachiel gi gik moko duto manie iye gin mag Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 24:1">bende ji duto modakie piny gin mage;<verse eid="PSA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2"/>nikech ne omiyo piny obet ewi nembe</para>
  <para style="q2" vid="PSA 24:2">kendo noguro misene ewi pige.<verse eid="PSA 24:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3"/>En ngʼa manyalo idho wi got mar Jehova Nyasaye?</para>
  <para style="q2" vid="PSA 24:3">En ngʼa manyalo chungʼ e ode maler?<verse eid="PSA 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4"/>En mana ngʼat ma lwete ler kendo chunye bende ler,</para>
  <para style="q2" vid="PSA 24:4">ngʼat ma ok lam nyiseche ma dhano oloso,</para>
  <para style="q2" vid="PSA 24:4">kata kwongʼre gi miriambo.<verse eid="PSA 24:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5"/>Ngʼat ma kamano Jehova Nyasaye biro gwedho</para>
  <para style="q2" vid="PSA 24:5">kendo obiro yudo ber moa kuom Nyasaye ma Jawarne.<verse eid="PSA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6"/>Kamano e kaka tiengʼ mar joma dware chalo,</para>
  <para style="q2" vid="PSA 24:6">mamanyo wangʼi, yaye Nyasach Jakobo. <char style="qs">Sela</char><verse eid="PSA 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7"/>tingʼuru lodiu malo, yaye dhorangeye;</para>
  <para style="q2" vid="PSA 24:7">tingʼreuru malo, yaye rangeye machon,</para>
  <para style="q2" vid="PSA 24:7">mondo Ruodh duongʼ odonji.<verse eid="PSA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8"/>Ruoth man-gi duongʼni to en ngʼa?</para>
  <para style="q2" vid="PSA 24:8">En Jehova Nyasaye Maratego kendo manyalo duto,</para>
  <para style="q2" vid="PSA 24:8">En Jehova Nyasaye maloyo lweny.<verse eid="PSA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9"/>Tingʼuru lodiu malo, yaye un dhorangeye;</para>
  <para style="q2" vid="PSA 24:9">tingʼ-giuru malo, un dhorangeye machon,</para>
  <para style="q2" vid="PSA 24:9">mondo Ruodh duongʼ odonji.<verse eid="PSA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10"/>Ruodh duongʼni en ngʼa?</para>
  <para style="q2" vid="PSA 24:10">Jehova Nyasaye Maratego,</para>
  <para style="q2" vid="PSA 24:10">En e Ruodh Duongʼ. <char style="qs">Sela</char><verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="cl">Zaburi 25</para>
  <para style="d">Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1"/>Achiwoni chunya, yaye Jehova Nyasaye;<verse eid="PSA 25:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 25:2"/>In ema aketo genona kuomi, yaye Nyasacha.</para>
  <para style="q1" vid="PSA 25:2">Kik iwe ane wichkuot,</para>
  <para style="q2" vid="PSA 25:2">bende kik iwe wasika loya.<verse eid="PSA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3"/>Onge ngʼama oketo genone kuomi</para>
  <para style="q2" vid="PSA 25:3">manyalo neno wichkuot,</para>
  <para style="q1" vid="PSA 25:3">to joma timo timbe maricho</para>
  <para style="q2" vid="PSA 25:3">ema biro neno wichkuot.<verse eid="PSA 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4"/>Nyisa yoreni, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 25:4">puonja mondo aluwgi;<verse eid="PSA 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5"/>telna gi adierani, kendo puonja,</para>
  <para style="q2" vid="PSA 25:5">nikech in Nyasaye ma Jawarna,</para>
  <para style="q2" vid="PSA 25:5">kendo genona ni kuomi odiechiengʼ duto.<verse eid="PSA 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6"/>Par kechni maduongʼ gi herani, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 25:6">nikech gisebedo ka gintie nyaka aa chon.<verse eid="PSA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7"/>Kik ipar richo mane atimo kapod an rawere</para>
  <para style="q2" vid="PSA 25:7">kod yorena mobam;</para>
  <para style="q1" vid="PSA 25:7">para kaluwore gi herani,</para>
  <para style="q2" vid="PSA 25:7">nikech iber, yaye Jehova Nyasaye.<verse eid="PSA 25:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8"/>Jehova Nyasaye ber kendo yorene oriere tir;</para>
  <para style="q2" vid="PSA 25:8">mano emomiyo opuonjo joricho yorene.<verse eid="PSA 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9"/>Otelo ni joma muol kuom gima nikare</para>
  <para style="q2" vid="PSA 25:9">kendo opuonjogi yore.<verse eid="PSA 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10"/>Yore duto mag Jehova Nyasaye opongʼ gihera kod adiera</para>
  <para style="q2" vid="PSA 25:10">ni joma rito gik moko duto ma singruokne dwaro.<verse eid="PSA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11"/>Wena richona nikech nyingi</para>
  <para style="q2" vid="PSA 25:11">kata obedo ni richona duongʼ ahinya, yaye Jehova Nyasaye,<verse eid="PSA 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12"/>Koro ere ngʼat ma oluoro Jehova Nyasaye?</para>
  <para style="q2" vid="PSA 25:12">Obiro puonje luwo yo moyierne.<verse eid="PSA 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13"/>Obiro dak e ngima momew,</para>
  <para style="q2" vid="PSA 25:13">kendo nyikwaye nokaw piny kaka girkeni margi.<verse eid="PSA 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14"/>Jehova Nyasaye en osiep joma miye luor;</para>
  <para style="q2" vid="PSA 25:14">omiyo gingʼeyo singruok mage.<verse eid="PSA 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15"/>Achomo wangʼa kuom Jehova Nyasaye ndalo duto,</para>
  <para style="q2" vid="PSA 25:15">nikech en kende ema obiro golo tiendena mobadho omako.<verse eid="PSA 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16"/>Duog ira kendo bedna mangʼwon,</para>
  <para style="q2" vid="PSA 25:16">nikech adongʼ kenda kendo an gi kuyo.<verse eid="PSA 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17"/>Chandruok manie chunya osemedore;</para>
  <para style="q2" vid="PSA 25:17">resa kuom rem ma an-go.<verse eid="PSA 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18"/>Neye kuyo manie chunya kod rem ma an-go,</para>
  <para style="q2" vid="PSA 25:18">kendo gol richona duto.<verse eid="PSA 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19"/>Neye kaka wasika osemedore</para>
  <para style="q2" vid="PSA 25:19">kendo kaka gichaya gi chunygi duto!<verse eid="PSA 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20"/>Rit ngimana kendo iresa;</para>
  <para style="q2" vid="PSA 25:20">kik iwe ane wichkuot,</para>
  <para style="q2" vid="PSA 25:20">nikech in ema apondo kuomi.<verse eid="PSA 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21"/>Mad bidhruok gi ngima moriere rita</para>
  <para style="q2" vid="PSA 25:21">nikech genona ni kuomi.<verse eid="PSA 25:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22"/>Res Israel, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 25:22">kuom chandruok mage duto!<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="cl">Zaburi 26</para>
  <para style="d">Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1"/>Ngʼadna bura makare, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 26:1">nikech e ngimana duto asedak ka aonge ketho;</para>
  <para style="q1" vid="PSA 26:1">aseketo genona kuom Jehova Nyasaye</para>
  <para style="q2" vid="PSA 26:1">ma ok adigni.<verse eid="PSA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2"/>Nona kendo itema, yaye Jehova Nyasaye</para>
  <para style="q2" vid="PSA 26:2">nonie chunya gi pacha;<verse eid="PSA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3"/>nikech herani osiko kanie chunya kinde duto,</para>
  <para style="q2" vid="PSA 26:3">kendo asiko kawuotho e adierani.<verse eid="PSA 26:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4"/>Ok abed piny gi joma wuondore</para>
  <para style="q2" vid="PSA 26:4">bende ok ariwra gi jo-miriambo.<verse eid="PSA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5"/>Achayo chokruok mar joma timo gik maricho</para>
  <para style="q2" vid="PSA 26:5">kendo ok ayie bet piny gi joricho.<verse eid="PSA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6"/>Aluoko lwetena kanyisogo ni aonge ketho,</para>
  <para style="q2" vid="PSA 26:6">kendo aluoro kendoni mar misango, yaye Jehova Nyasaye,<verse eid="PSA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7"/>ka alando pakni gi dwol maduongʼ,</para>
  <para style="q2" vid="PSA 26:7">kendo anyiso timbeni duto miwuoro.<verse eid="PSA 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8"/>Ahero hekalu kama idakie, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 26:8">kama duongʼni nitie.<verse eid="PSA 26:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9"/>Kik ikaw chunya kaachiel gi joricho, kik ikaw ngimana</para>
  <para style="q2" vid="PSA 26:9">kod joma ohero chwero remo,<verse eid="PSA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10"/>joma lwetegi otingʼo chenro maricho</para>
  <para style="q2" vid="PSA 26:10">ma lwetegi ma korachwich asoya opongʼo.<verse eid="PSA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11"/>An to ngimana onge ketho;</para>
  <para style="q2" vid="PSA 26:11">yie iwara kendo ikecha.<verse eid="PSA 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12"/>Tiendena onyono kama opie;</para>
  <para style="q2" vid="PSA 26:12">e chokruok mangʼongo abiro pako Jehova Nyasaye.<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="cl">Zaburi 27</para>
  <para style="d">Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1"/>Jehova Nyasaye e lerna kendo e warruokna;</para>
  <para style="q2" vid="PSA 27:1">en ngʼa ma daluor?</para>
  <para style="q1" vid="PSA 27:1">Jehova Nyasaye e kama ngimana opondoe.</para>
  <para style="q2" vid="PSA 27:1">En ngʼa ma dibwoga?<verse eid="PSA 27:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2"/>Ka joma richo lawa</para>
  <para style="q2" vid="PSA 27:2">mondo oketh ngimana,</para>
  <para style="q1" vid="PSA 27:2">ka wasika kod joma kedo koda monja,</para>
  <para style="q2" vid="PSA 27:2">to gibiro kier mi gipodhi.<verse eid="PSA 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3"/>Kata ka jolweny ogoyona agengʼa koni gi koni,</para>
  <para style="q2" vid="PSA 27:3">to chunya ok bi luor;</para>
  <para style="q1" vid="PSA 27:3">kata ka lweny otugorena,</para>
  <para style="q2" vid="PSA 27:3">to pod abiro mana bedo gi chir.<verse eid="PSA 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4"/>Gimoro achiel kende ema akwayo Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 27:4">ma e gima adwaro moloyo;</para>
  <para style="q1" vid="PSA 27:4">ni mondo adag e od Jehova Nyasaye</para>
  <para style="q2" vid="PSA 27:4">ndalo duto mag ngimana,</para>
  <para style="q1" vid="PSA 27:4">mondo achom wangʼa kuom ber mar Jehova Nyasaye</para>
  <para style="q2" vid="PSA 27:4">kendo amanye e hekalu mare.<verse eid="PSA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5"/>Nikech chiengʼ ma chandruok omaka</para>
  <para style="q2" vid="PSA 27:5">obiro panda maber e kar dakne;</para>
  <para style="q1" vid="PSA 27:5">obiro panda e kar pondo mar hembe maler</para>
  <para style="q2" vid="PSA 27:5">kendo obiro keta malo ewi lwanda.<verse eid="PSA 27:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6"/>Eka abiro bedo jaloch</para>
  <para style="q2" vid="PSA 27:6">ka aloyo wasigu duto molwora;</para>
  <para style="q1" vid="PSA 27:6">abiro timo misango mar pak ka akok gimor e hembe maler.</para>
  <para style="q2" vid="PSA 27:6">Abiro wer kendo abiro loso wende mamit ne Jehova Nyasaye.<verse eid="PSA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7"/>Winj dwonda ka aluongo, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 27:7">kecha kendo idwoka.<verse eid="PSA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8"/>Chunya wuoyo kuomi kawacho niya,</para>
  <para style="q2" vid="PSA 27:8">“Many wangʼ Nyasaye ka ilemo!”</para>
  <para style="q2" vid="PSA 27:8">Wangʼi, yaye Jehova Nyasaye, ema abiro manyo.<verse eid="PSA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9"/>Kik ipandna wangʼi,</para>
  <para style="q2" vid="PSA 27:9">kik iriemb jatichni ka mirima omaki,</para>
  <para style="q2" vid="PSA 27:9">in ema isebedo jakonyna.</para>
  <para style="q1" vid="PSA 27:9">Kik ikweda bende kik ijwangʼa,</para>
  <para style="q2" vid="PSA 27:9">yaye Nyasaye Jawarna.<verse eid="PSA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10"/>Kata obedo ni wuonwa gi minwa ojwangʼa</para>
  <para style="q2" vid="PSA 27:10">to Jehova Nyasaye biro rwaka.<verse eid="PSA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11"/>Puonja yoreni, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 27:11">telna e yo moriere tir,</para>
  <para style="q2" vid="PSA 27:11">nikech joma sanda.<verse eid="PSA 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12"/>Kik ijwangʼa ne dwach wasika,</para>
  <para style="q2" vid="PSA 27:12">nikech joneno mag miriambo oramona matek,</para>
  <para style="q2" vid="PSA 27:12">ka gichano mar hinya.<verse eid="PSA 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13"/>To an gi ratiro kuom wachni:</para>
  <para style="q2" vid="PSA 27:13">ni pod abiro neno ber Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 27:13">e piny joma ngima.<verse eid="PSA 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14"/>Gen kuom Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 27:14">bed motegno ka in gi chir,</para>
  <para style="q2" vid="PSA 27:14">kendo rit kuom Jehova Nyasaye.<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="cl">Zaburi 28</para>
  <para style="d">Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1"/>In ema aluongi, yaye Jehova Nyasaye Lwandana;</para>
  <para style="q2" vid="PSA 28:1">kik itamri winjo ywakna.</para>
  <para style="q1" vid="PSA 28:1">Nikech ka isiko ilingʼ alingʼa,</para>
  <para style="q2" vid="PSA 28:1">to abiro chalo gi joma osedhi e bur.<verse eid="PSA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2"/>Winj ywakna mondo ikecha</para>
  <para style="q2" vid="PSA 28:2">e sa ma aluongi mondo ikonya,</para>
  <para style="q1" vid="PSA 28:2">e sa ma atingʼo bedena malo</para>
  <para style="q2" vid="PSA 28:2">kochomo Kari Maler Moloyo.<verse eid="PSA 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3"/>Kik iywaya oko gi joricho,</para>
  <para style="q2" vid="PSA 28:3">kod joma timo gik maricho,</para>
  <para style="q1" vid="PSA 28:3">joma wuoyo gi jowetegi maber</para>
  <para style="q2" vid="PSA 28:3">to opando sigu e chunygi.<verse eid="PSA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4"/>Chulgi kuom timbegi maricho</para>
  <para style="q2" vid="PSA 28:4">kendo kuom tijegi maricho;</para>
  <para style="q1" vid="PSA 28:4">chulgi kuom gik ma lwetgi osetimo</para>
  <para style="q2" vid="PSA 28:4">kendo dwok kuomgi gik mowinjore gi timbegi.<verse eid="PSA 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5"/>Nikech ok gidew tije mag Jehova Nyasaye</para>
  <para style="q2" vid="PSA 28:5">kod gik ma lwetene osetimo,</para>
  <para style="q1" vid="PSA 28:5">obiro mukogi mi ogogi piny</para>
  <para style="q2" vid="PSA 28:5">kendo ok nochak ogergi mi gichungʼ kendo.<verse eid="PSA 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6"/>Opak Jehova Nyasaye</para>
  <para style="q2" vid="PSA 28:6">nikech osewinjo ywakna ma akwayogo kony.<verse eid="PSA 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7"/>Jehova Nyasaye e tekona kendo okumbana;</para>
  <para style="q2" vid="PSA 28:7">chunya ogeno kuome kendo en e konyruokna.</para>
  <para style="q1" vid="PSA 28:7">Chunya nigi mor</para>
  <para style="q2" vid="PSA 28:7">kendo abiro goyone erokamano gi wer.<verse eid="PSA 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8"/>Jehova Nyasaye e teko mar joge,</para>
  <para style="q2" vid="PSA 28:8">en e ohinga mar resruok ni joge moyiero.<verse eid="PSA 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9"/>Res jogi kendo gwedh jogi moyier</para>
  <para style="q2" vid="PSA 28:9">bed Jakwadh jogi kendo telnegi nyaka chiengʼ.<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="cl">Zaburi 29</para>
  <para style="d">Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1"/>Chiwneuru Jehova Nyasaye, yaye un malaike,</para>
  <para style="q2" vid="PSA 29:1">chiwneuru Jehova Nyasaye duongʼ kod teko.<verse eid="PSA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2"/>Chiwneuru Jehova Nyasaye duongʼ mowinjore gi nyinge;</para>
  <para style="q2" vid="PSA 29:2">lamuru Jehova Nyasaye e dier lerne maduongʼ.<verse eid="PSA 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3"/>Dwond Jehova Nyasaye mor ewi pige;</para>
  <para style="q2" vid="PSA 29:3">Nyasaye mar duongʼ mor ka polo,</para>
  <para style="q2" vid="PSA 29:3">Jehova Nyasaye mor ewi pige madongo.<verse eid="PSA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4"/>Dwond Jehova Nyasaye nigi teko,</para>
  <para style="q2" vid="PSA 29:4">dwond Jehova Nyasaye nigi duongʼ.<verse eid="PSA 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5"/>Dwond Jehova Nyasaye muko yiende mag sida,</para>
  <para style="q2" vid="PSA 29:5">Jehova Nyasaye turo yiende sida mag Lebanon matindo tindo.<verse eid="PSA 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6"/>Omiyo Lebanon chikore ka nyaroya,</para>
  <para style="q2" vid="PSA 29:6">Sirion lengʼore ka jowi ma pod tin.<verse eid="PSA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7"/>Dwond Jehova Nyasaye mor,</para>
  <para style="q2" vid="PSA 29:7">omor ka mil polo.<verse eid="PSA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8"/>Dwond Jehova Nyasaye yiengo piny motimo ongoro;</para>
  <para style="q2" vid="PSA 29:8">Jehova Nyasaye yiengo ongoro mar Kadesh.<verse eid="PSA 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9"/>Dwond Jehova Nyasaye ma dolo yiend bungu miyo mwanda nywol</para>
  <para style="q2" vid="PSA 29:9">kendo omiyo yiend bungu dongʼ kolwerore.</para>
  <para style="q1" vid="PSA 29:9">Ji duto kok ei hekalu mare kagiwacho niya,</para>
  <para style="q2" vid="PSA 29:9">“Duongʼ odog ni Jehova Nyasaye!”<verse eid="PSA 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10"/>Jehova Nyasaye obet e kom loch mare ewi ataro;</para>
  <para style="q2" vid="PSA 29:10">Jehova Nyasaye obet e kom loch kaka Ruoth nyaka chiengʼ.<verse eid="PSA 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11"/>Jehova Nyasaye miyo joge teko;</para>
  <para style="q2" vid="PSA 29:11">Jehova Nyasaye gwedho joge gi kwe.<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="cl">Zaburi 30</para>
  <para style="d">Zaburi. Wer mar gwedho hekalu. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1"/>Abiro tingʼi malo, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 30:1">nikech ne igola e bur matut,</para>
  <para style="q2" vid="PSA 30:1">kendo ne ok iyiene wasika mondo obed mamor kuoma.<verse eid="PSA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2"/>Yaye Jehova Nyasaye Nyasacha, ne aluongi mondo ikonya</para>
  <para style="q2" vid="PSA 30:2">kendo ne ichanga.<verse eid="PSA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3"/>Yaye Jehova Nyasaye, ne igola oko e liel,</para>
  <para style="q2" vid="PSA 30:3">ne iresa kane oyudo aridora piny e bur matut mar joma otho.<verse eid="PSA 30:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4"/>Werneuru Jehova Nyasaye, un joge maler;</para>
  <para style="q2" vid="PSA 30:4">pakuru nyinge maler.<verse eid="PSA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5"/>Nikech mirimbe bedo mana kuom kinde matin kende,</para>
  <para style="q2" vid="PSA 30:5">to ngʼwonone osiko nyaka chiengʼ;</para>
  <para style="q1" vid="PSA 30:5">ywak nyalo bedo gotieno</para>
  <para style="q2" vid="PSA 30:5">to mor biro mana gokinyi.<verse eid="PSA 30:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6"/>Kane aparo ni adhi maber, ne awacho niya,</para>
  <para style="q2" vid="PSA 30:6">“Onge gima biro bwoga.”<verse eid="PSA 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7"/>Yaye Jehova Nyasaye, kane itimona ngʼwono,</para>
  <para style="q2" vid="PSA 30:7">ne imiyo achungʼ motegno kaka got;</para>
  <para style="q1" vid="PSA 30:7">to kane ipando wangʼi,</para>
  <para style="q2" vid="PSA 30:7">to piny nochama.<verse eid="PSA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8"/>In ema ne aluongi, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 30:8">Ruoth Nyasaye ema ne aywakne mondo okecha.<verse eid="PSA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9"/>“Ere ohala ma thona biro kelo,</para>
  <para style="q2" vid="PSA 30:9">ere gima dhina e liel biro konyigo?</para>
  <para style="q1" vid="PSA 30:9">Buru bende nyalo paki adier?</para>
  <para style="q2" vid="PSA 30:9">Bende dohul adierani kasetho?<verse eid="PSA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10"/>Winja, yaye Jehova Nyasaye, kendo kecha;</para>
  <para style="q2" vid="PSA 30:10">yaye Jehova Nyasaye bed konyruok mara.”<verse eid="PSA 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11"/>Ne iloko ywakna modoko miel;</para>
  <para style="q2" vid="PSA 30:11">ne igolo lawa mar kuyo mi irwakona law mor,<verse eid="PSA 30:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 30:12"/>mondo chunya owerni kendo kik olingʼ.</para>
  <para style="q1" vid="PSA 30:12">Yaye Jehova Nyasaye Nyasacha,</para>
  <para style="q2" vid="PSA 30:12">abiro goyoni erokamano nyaka chiengʼ.<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="cl">Zaburi 31</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1"/>Kuomi ema aseponde, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 31:1">kik iwe ayud wichkuot;</para>
  <para style="q2" vid="PSA 31:1">gola e chandruok nikech timni makare.<verse eid="PSA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2"/>Winj ywakna,</para>
  <para style="q2" vid="PSA 31:2">kendo bi piyo mondo iresa;</para>
  <para style="q1" vid="PSA 31:2">bed lwandana mar pondo,</para>
  <para style="q2" vid="PSA 31:2">kendo ohinga motegno manyalo resa.<verse eid="PSA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3"/>Kaka in lwandana kendo ohingana,</para>
  <para style="q2" vid="PSA 31:3">telna kendo itaya nikech nyingi.<verse eid="PSA 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4"/>Gola oko e obadho mopondo mochikna</para>
  <para style="q2" vid="PSA 31:4">nikech in e kar pondona.<verse eid="PSA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5"/>Aketo chunya e lweti;</para>
  <para style="q2" vid="PSA 31:5">resa, yaye Jehova Nyasaye, ma Nyasaye mar adiera.<verse eid="PSA 31:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6"/>Asin gi joma lamo nyiseche manono ma dhano oloso;</para>
  <para style="q2" vid="PSA 31:6">an to aketo genona kuom Jehova Nyasaye.<verse eid="PSA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7"/>Abiro bedo mamor kendo moil kuom herani,</para>
  <para style="q2" vid="PSA 31:7">nikech ne ineno chandruokna,</para>
  <para style="q2" vid="PSA 31:7">kendo ne ingʼeyo lit mar chunya.<verse eid="PSA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8"/>Ok iseketa e lwet jawasigu</para>
  <para style="q2" vid="PSA 31:8">to iseguro tiendena kama lach.<verse eid="PSA 31:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9"/>Kecha, yaye Jehova Nyasaye, nikech an e chandruok;</para>
  <para style="q2" vid="PSA 31:9">wengena ojony nikech ywak,</para>
  <para style="q2" vid="PSA 31:9">kendo chunya gi ringra bende nigi lit.<verse eid="PSA 31:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10"/>Ngimana rem chamo</para>
  <para style="q2" vid="PSA 31:10">kendo higni maga opongʼ gi chur;</para>
  <para style="q1" vid="PSA 31:10">tekona rumo nikech lit ma an-go</para>
  <para style="q2" vid="PSA 31:10">kendo chokena doko mayom yom.<verse eid="PSA 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11"/>Nikech wasigu olwora mangʼeny,</para>
  <para style="q2" vid="PSA 31:11">joma odak koda koro ochaya gi chunygi;</para>
  <para style="q1" vid="PSA 31:11">alich kata mana ni osiepena</para>
  <para style="q2" vid="PSA 31:11">kendo joma onena e wangʼ yo ringa.<verse eid="PSA 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12"/>Wigi owil koda mana ka gima ne asetho chon</para>
  <para style="q2" vid="PSA 31:12">bende koro achalo mana gi agulu motore.<verse eid="PSA 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13"/>Nikech awinjo ayany mangʼeny ma ji yanyago,</para>
  <para style="q2" vid="PSA 31:13">kihondko olwora koni gi koni;</para>
  <para style="q1" vid="PSA 31:13">gikuodho kaka digitimna marach</para>
  <para style="q2" vid="PSA 31:13">kendo gichano mar kawo ngimana.<verse eid="PSA 31:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14"/>To an aketo mana genona kuomi, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 31:14">kendo awacho niya, “In e Nyasacha.”<verse eid="PSA 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15"/>Ndalona ni e lweti;</para>
  <para style="q2" vid="PSA 31:15">resa e lwet wasika,</para>
  <para style="q2" vid="PSA 31:15">kendo kuom joma lawa.<verse eid="PSA 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16"/>Mad ibed mamor gi jatichni;</para>
  <para style="q2" vid="PSA 31:16">resa gi herani ma ok rum.<verse eid="PSA 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17"/>Kik iwe wiya kuodi, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 31:17">nikech aseywakni ka alemo;</para>
  <para style="q1" vid="PSA 31:17">to we joma timbegi richo oyud wichkuot</para>
  <para style="q2" vid="PSA 31:17">kendo ginindi ka gilingʼ thi ei liel.<verse eid="PSA 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18"/>Mi dhogi mawacho miriambo mondo olingʼ;</para>
  <para style="q2" vid="PSA 31:18">nikech sungagi kod chuny marach ma gin-go,</para>
  <para style="q2" vid="PSA 31:18">omiyo giwuoyo gi wich teko kuom joma kare.<verse eid="PSA 31:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19"/>Mano kaka berni duongʼ,</para>
  <para style="q2" vid="PSA 31:19">ber mikano ne joma oluori,</para>
  <para style="q1" vid="PSA 31:19">mimiyo joma opondo kuomi</para>
  <para style="q2" vid="PSA 31:19">ka ji duto neno.<verse eid="PSA 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20"/>Ipandogi e bwombi iwuon</para>
  <para style="q2" vid="PSA 31:20">mondo joma richo kik hinygi;</para>
  <para style="q1" vid="PSA 31:20">iritogi maber e kar dak mari</para>
  <para style="q2" vid="PSA 31:20">kuom lew joma hangonigi wach.<verse eid="PSA 31:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21"/>Pak obed ni Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 31:21">nikech ne onyisa herane maduongʼ,</para>
  <para style="q2" vid="PSA 31:21">kane an e dala ma wasigu ogoyona agengʼa.<verse eid="PSA 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22"/>Kane chandruok omaka to ne awacho ni,</para>
  <para style="q2" vid="PSA 31:22">“Opoga kodi!”</para>
  <para style="q1" vid="PSA 31:22">Kata kamano ne iwinja ka aywakni</para>
  <para style="q2" vid="PSA 31:22">mondo ikecha kane aluongi mondo ikonya.<verse eid="PSA 31:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23"/>Heruru Jehova Nyasaye un joge maler duto!</para>
  <para style="q2" vid="PSA 31:23">Jehova Nyasaye rito ngima joma jo-adiera,</para>
  <para style="q2" vid="PSA 31:23">to josunga to ochulo moromo chuth.<verse eid="PSA 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24"/>Beduru motegno kendo jiwuru chunyu,</para>
  <para style="q2" vid="PSA 31:24">un duto mugeno kuom Jehova Nyasaye.<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="cl">Zaburi 32</para>
  <para style="d">Zaburi mar Daudi. Wer mower gi <char style="tl">maskil.</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1"/>Ogwedh ngʼat</para>
  <para style="q2" vid="PSA 32:1">ma kethone owene,</para>
  <para style="q2" vid="PSA 32:1">kendo ma richone oseruchi.<verse eid="PSA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2"/>Ogwedh ngʼatno</para>
  <para style="q2" vid="PSA 32:2">ma Jehova Nyasaye ok kwan-ne richone,</para>
  <para style="q2" vid="PSA 32:2">kendo ma wuondruok onge e chunye.<verse eid="PSA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3"/>Kane alingʼ</para>
  <para style="q2" vid="PSA 32:3">to chokena ne ochiyore,</para>
  <para style="q2" vid="PSA 32:3">kane achur odiechiengʼ duto ma ok aywe.<verse eid="PSA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4"/>Nikech odiechiengʼ gotieno</para>
  <para style="q2" vid="PSA 32:4">lweti ne pek kuoma;</para>
  <para style="q1" vid="PSA 32:4">tekrena ne oduono</para>
  <para style="q2" vid="PSA 32:4">mana kaka timore e liet mar ndalo oro. <char style="qs">Sela</char><verse eid="PSA 32:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5"/>Eka ne ahulo richona</para>
  <para style="q2" vid="PSA 32:5">kendo ne ok apando timbena mag ketho.</para>
  <para style="q1" vid="PSA 32:5">Ne awacho niya,</para>
  <para style="q2" vid="PSA 32:5">“Abiro hulo ketho chik maga ne Jehova Nyasaye.”</para>
  <para style="q1" vid="PSA 32:5">Omiyo ne iweyona ketho mane richona okelo. <char style="qs">Sela</char><verse eid="PSA 32:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6"/>Kuom mano, owinjore ji duto moluoro Nyasaye olami</para>
  <para style="q2" vid="PSA 32:6">kapod inyalo yudi;</para>
  <para style="q1" vid="PSA 32:6">adier ka pige madongo otugore,</para>
  <para style="q2" vid="PSA 32:6">to ok gibi chopo ire,<verse eid="PSA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7"/>In e kar pondona;</para>
  <para style="q2" vid="PSA 32:7">ibiro rita e chandruok,</para>
  <para style="q2" vid="PSA 32:7">kendo ibiro lwora gi wende mag loch. <char style="qs">Sela</char><verse eid="PSA 32:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8"/>Abiro chiki kendo abiro puonji e yo monego ilu;</para>
  <para style="q2" vid="PSA 32:8">adier abiro ngʼadoni rieko kendo abiro rangi maber.<verse eid="PSA 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9"/>Kik ichal gi farese kata gi punda,</para>
  <para style="q2" vid="PSA 32:9">maonge gi rieko,</para>
  <para style="q1" vid="PSA 32:9">manyaka chiki mana ka otwe dhoge kendo iywayo gi kamba,</para>
  <para style="q2" vid="PSA 32:9">nono to ok gibi buti.<verse eid="PSA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10"/>Lit mochomo joma timbegi richo ngʼeny,</para>
  <para style="q2" vid="PSA 32:10">to hera ma ok rum mar Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 32:10">olworo ngʼat mogeno kuome.<verse eid="PSA 32:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11"/>Beduru moil kuom Jehova Nyasaye, kendo beduru mamor, un joma kare;</para>
  <para style="q2" vid="PSA 32:11">weruru, un duto ma urieru tir gie chunyu!<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="cl">Zaburi 33</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1"/>Weruru gimor ni Jehova Nyasaye, un joma kare;</para>
  <para style="q2" vid="PSA 33:1">en gima owinjore mondo joma kare opake.<verse eid="PSA 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2"/>Pakuru Jehova Nyasaye gi nyatiti;</para>
  <para style="q2" vid="PSA 33:2">werneuru wer mamit gi nyatiti.<verse eid="PSA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3"/>Werneuru wer manyien;</para>
  <para style="q2" vid="PSA 33:3">werneuru kugoyone nyiduonge kendo weruru gi ilo.<verse eid="PSA 33:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4"/>Wach Jehova Nyasaye nikare kendo en adier;</para>
  <para style="q2" vid="PSA 33:4">en ja-adiera e gik moko duto motimo.<verse eid="PSA 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5"/>Jehova Nyasaye ohero tim makare kod ratiro;</para>
  <para style="q2" vid="PSA 33:5">piny duto opongʼ gi herane ma ok rem.<verse eid="PSA 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6"/>Polo ne ochwe kuom wach Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 33:6">i dwe gi nyinyo duto nochweyo gi much dhoge.<verse eid="PSA 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7"/>Ochoko pige mag nembe madongo e tawo;</para>
  <para style="q2" vid="PSA 33:7">oketo kut e dere.<verse eid="PSA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8"/>Piny duto mondo oluor Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 33:8">ji duto manie e piny mondo okulrene.<verse eid="PSA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9"/>Nikech ne owuoyo mi piny nobetie,</para>
  <para style="q2" vid="PSA 33:9">nogolo chik mi ochungʼ mongirore.<verse eid="PSA 33:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10"/>Jehova Nyasaye ketho chenro duto mag pinje;</para>
  <para style="q2" vid="PSA 33:10">othiro dwaro ma ogendini nigo.<verse eid="PSA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11"/>To chenro duto mag Jehova Nyasaye to siko kochungʼ nyaka chiengʼ;</para>
  <para style="q2" vid="PSA 33:11">ochopo dwaro duto manie chunye e tienge duto.<verse eid="PSA 33:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12"/>Piny ma ogeno Jehova Nyasaye ma Nyasache ogwedhi,</para>
  <para style="q2" vid="PSA 33:12">nikech gin oganda mane oyiero kaka girkeni mare.<verse eid="PSA 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13"/>Jehova Nyasaye rango piny gie polo</para>
  <para style="q2" vid="PSA 33:13">kendo oneno dhano duto;<verse eid="PSA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14"/>ongʼiyo ji duto modak e piny gie kar dakne e polo,<verse eid="PSA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15"/>en ema ne ochweyo chunje ji duto,</para>
  <para style="q2" vid="PSA 33:15">kendo onono gik moko duto ma gitimo.<verse eid="PSA 33:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16"/>Onge ruoth minyalo reso nikech en gi jolweny mangʼeny;</para>
  <para style="q2" vid="PSA 33:16">bende onge jakedo manyalo tony nikech tekone ngʼeny.<verse eid="PSA 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17"/>Geno yudo resruok kuom faras en gima nono</para>
  <para style="q2" vid="PSA 33:17">kata obedo ni en giteko mangʼeny to ok onyal reso ngʼato.<verse eid="PSA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18"/>To wangʼ Jehova Nyasaye neno jogo momiye luor,</para>
  <para style="q2" vid="PSA 33:18">orango joma geno margi ni kuom herane ma ok rem,<verse eid="PSA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19"/>mondo oresgi e tho</para>
  <para style="q2" vid="PSA 33:19">kendo oritgi gibed mangima e ndalo mag kech.<verse eid="PSA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20"/>Warito Jehova Nyasaye gi geno;</para>
  <para style="q2" vid="PSA 33:20">en e konyruokwa kendo okumbawa.<verse eid="PSA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21"/>Chunywa mor kuome,</para>
  <para style="q2" vid="PSA 33:21">nikech wageno kuom nyinge maler.<verse eid="PSA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22"/>Mad herani ma ok rum osik kuomwa, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 33:22">mana kaka waketo genowa kuomi.<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="cl">Zaburi 34</para>
  <para style="d">Zaburi mar Daudi. Kane owuondore ni in janeko e nyim Abimelek, mane oriembe mi oa odhi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1"/>Abiro miyo Jehova Nyasaye duongʼ kinde duto;</para>
  <para style="q2" vid="PSA 34:1">dhoga biro siko kapake.<verse eid="PSA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2"/>Chunya biro sungore kuom Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 34:2">joma nigi rem mondo owinji kendo obed mamor.<verse eid="PSA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3"/>Miuru Jehova Nyasaye duongʼ kaachiel koda;</para>
  <para style="q2" vid="PSA 34:3">watingʼuru nyinge malo kaachiel.<verse eid="PSA 34:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4"/>Ne amanyo Jehova Nyasaye ka alamo, kendo nodwoka;</para>
  <para style="q2" vid="PSA 34:4">ne oresa e luoro duto ma an-go.<verse eid="PSA 34:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5"/>Joma oketo genogi kuome rieny;</para>
  <para style="q2" vid="PSA 34:5">ok gi bi neno wichkuot.<verse eid="PSA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6"/>Ngʼat ma odhierni noluongo Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 34:6">kendo Jehova Nyasaye nowinje;</para>
  <para style="q2" vid="PSA 34:6">ne orese mogole e chandruokne duto.<verse eid="PSA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7"/>Malaika mar Jehova Nyasaye oumo alwora mar jogo momiye luor</para>
  <para style="q2" vid="PSA 34:7">kendo oresogi.<verse eid="PSA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8"/>Bi mondo ine ni Jehova Nyasaye ber;</para>
  <para style="q2" vid="PSA 34:8">ngʼat ma pondo kuome ogwedhi.<verse eid="PSA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9"/>Luoruru Jehova Nyasaye, un joge maler,</para>
  <para style="q2" vid="PSA 34:9">nikech joma omiye luor ok chand gimoro amora.<verse eid="PSA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10"/>Sibuoche nyalo ool kendo kech nyalo kayogi,</para>
  <para style="q2" vid="PSA 34:10">to joma manyo Jehova Nyasaye ok ochando gima ber moro amora.<verse eid="PSA 34:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11"/>Biuru nyithinda kendo winjauru.</para>
  <para style="q2" vid="PSA 34:11">Abiro puonjou luoro Jehova Nyasaye.<verse eid="PSA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12"/>Ngʼato angʼata kuomu mohero ngima</para>
  <para style="q2" vid="PSA 34:12">kendo nigi geno kuom ndalo mabiro mangʼeny mabeyo,<verse eid="PSA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13"/>nyaka ogengʼ lewe kik wuo marach</para>
  <para style="q2" vid="PSA 34:13">kendo ogengʼ dhoge kuom wacho miriambo.<verse eid="PSA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14"/>Lokri iwe timbe maricho kendo itim tim maber;</para>
  <para style="q2" vid="PSA 34:14">many kwe kendo iluwe.<verse eid="PSA 34:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15"/>Wangʼ Jehova Nyasaye ni kuom joma kare</para>
  <para style="q2" vid="PSA 34:15">kendo ite winjo ywakgi;<verse eid="PSA 34:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16"/>to Jehova Nyasaye mon gi joma timo gik maricho,</para>
  <para style="q2" vid="PSA 34:16">kendo omiyo wich wil kodgi e piny.<verse eid="PSA 34:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17"/>Joma kare koywak to Jehova Nyasaye winjogi;</para>
  <para style="q2" vid="PSA 34:17">oresogi e chandruokgi duto.<verse eid="PSA 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18"/>Jehova Nyasaye chiegni gi joma chunygi otur</para>
  <para style="q2" vid="PSA 34:18">kendo oreso joma chunygi muol.<verse eid="PSA 34:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19"/>Ngʼat makare nyalo bedo gi chandruok mangʼeny,</para>
  <para style="q2" vid="PSA 34:19">to Jehova Nyasaye rese kuomgi duto;<verse eid="PSA 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20"/>orito chokene duto,</para>
  <para style="q2" vid="PSA 34:20">ma kata achiel kuomgi ok notur.<verse eid="PSA 34:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21"/>Timbe maricho biro nego ngʼama timbene rach,</para>
  <para style="q2" vid="PSA 34:21">to jowasik joma kare, bura biro loyo.<verse eid="PSA 34:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22"/>Jehova Nyasaye reso jotichne;</para>
  <para style="q2" vid="PSA 34:22">onge ngʼato kata achiel mopondo kuome ma bura biro loyo.<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="cl">Zaburi 35</para>
  <para style="d">Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1"/>Yaye Jehova Nyasaye kedi gi joma kedo koda;</para>
  <para style="q2" vid="PSA 35:1">ked gi joma lawa.<verse eid="PSA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2"/>Kaw kuodi gi okumbani;</para>
  <para style="q2" vid="PSA 35:2">aa malo mondo ibi ikonya.<verse eid="PSA 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3"/>Chom tongʼ ma dhoge bith mar kedo</para>
  <para style="q2" vid="PSA 35:3">ibwog-go joma lawa.</para>
  <para style="q1" vid="PSA 35:3">Wuo gi chunya kiwachone niya, “An e warruokni.”<verse eid="PSA 35:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 35:4"/>Mad joma dwaro ketho ngimana,</para>
  <para style="q2" vid="PSA 35:4">ne wichkuot gi achaya.</para>
  <para style="q1" vid="PSA 35:4">Mad joma chanona hinyruok,</para>
  <para style="q2" vid="PSA 35:4">chunygi nyosre mi giweya.<verse eid="PSA 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5"/>Mad gichal gi mihudhi ma yamo tero,</para>
  <para style="q2" vid="PSA 35:5">ka malaika mar Jehova Nyasaye riembogi mabor;<verse eid="PSA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6"/>mad yore ma giluwo bed gi mudho</para>
  <para style="q2" vid="PSA 35:6">bende yoregigo obed makierogi ka malaika mar Jehova Nyasaye lawogi.<verse eid="PSA 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7"/>Nikech gichikona obadhogi kayiem nono</para>
  <para style="q2" vid="PSA 35:7">kendo gikunyona bur kayiem mondo alwarie;<verse eid="PSA 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8"/>mad kethruok jukgi apoya ka gikia</para>
  <para style="q2" vid="PSA 35:8">mad obadhogi ma gisechikona makgi;</para>
  <para style="q2" vid="PSA 35:8">mad gilwar ei bur ma kargi lal nono.<verse eid="PSA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9"/>Eka chunya nobed mamor kuom Jehova Nyasaye</para>
  <para style="q2" vid="PSA 35:9">kendo anabed gimor kuom warruokne.<verse eid="PSA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10"/>Ringra gi chunya duto, biro hulo kawacho niya,</para>
  <para style="q2" vid="PSA 35:10">“En ngʼa machalo kodi, yaye Jehova Nyasaye.”</para>
  <para style="q1" vid="PSA 35:10">Ireso joma odhier e lwet joma nigi teko moloyogi,</para>
  <para style="q2" vid="PSA 35:10">Adier, ikonyo joma odhier gi jochan kuom joma mayogi.<verse eid="PSA 35:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11"/>Joma timo neno ma wengegi tek sudo nyime;</para>
  <para style="q2" vid="PSA 35:11">gipenja gik ma ok angʼeyo gimoro amora kuomgi.<verse eid="PSA 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12"/>Gichula rach kar ber,</para>
  <para style="q2" vid="PSA 35:12">kendo giweyo chunya kochwanyore.<verse eid="PSA 35:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13"/>To kane gituo magihewore to ne arwako law ywagruok</para>
  <para style="q2" vid="PSA 35:13">kendo ne abolora katweyo chiemo.</para>
  <para style="q1" vid="PSA 35:13">Kane lamona ok odwoki,<verse eid="PSA 35:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 35:14"/>ne awuotho koni gi koni ka chunya lit,</para>
  <para style="q2" vid="PSA 35:14">mana ka gima aywago osiepna kata owadwa.</para>
  <para style="q1" vid="PSA 35:14">Ne akulo wiya ka an gi kuyo maduongʼ</para>
  <para style="q2" vid="PSA 35:14">mana ka gima aywago minwa.<verse eid="PSA 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15"/>To kane achwanyora, negichokore kaachiel gi mor;</para>
  <para style="q2" vid="PSA 35:15">joma ne monja nochokorena sa ma ok angʼeyo,</para>
  <para style="q2" vid="PSA 35:15">negisiko ka giketho nyinga.<verse eid="PSA 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16"/>Kaka joma ok oluoro Nyasaye chayo ji,</para>
  <para style="q2" vid="PSA 35:16">ne gijara ka gichano timona marach, ne gikayona lekegi.<verse eid="PSA 35:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17"/>Yaye Ruoth, ibiro siko kirango gigi katimore nyaka karangʼo?</para>
  <para style="q2" vid="PSA 35:17">Res ngimana kuom kethruok duto mag-gi.</para>
  <para style="q2" vid="PSA 35:17">Akwayi ni ires ngimana ma nengone tek e lwet sibuochegi.<verse eid="PSA 35:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18"/>Abiro goyoni erokamano e chokruok maduongʼ;</para>
  <para style="q2" vid="PSA 35:18">abiro paki e dier oganda maduongʼ mochokore kaachiel.<verse eid="PSA 35:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19"/>Kik iyie ni jogo osungre ni gisenyala,</para>
  <para style="q2" vid="PSA 35:19">joma obedo wasika maonge gima omiyo;</para>
  <para style="q1" vid="PSA 35:19">iyie joma ochaya maonge gimoro sigre</para>
  <para style="q2" vid="PSA 35:19">gi wengegi mar timona marach.<verse eid="PSA 35:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20"/>Ok giwuo gi kwe,</para>
  <para style="q2" vid="PSA 35:20">to gichano wacho miriambo,</para>
  <para style="q2" vid="PSA 35:20">kuom joma odak mos e piny.<verse eid="PSA 35:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21"/>Giyawona dhogi maduongʼ kendo nyiera ka giwachona giwacho niya, “Haa! Haa!</para>
  <para style="q2" vid="PSA 35:21">Wasenene gi wengewa wawegi.”<verse eid="PSA 35:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22"/>Yaye Jehova Nyasaye, iseneno timgini; kik ilingʼ.</para>
  <para style="q2" vid="PSA 35:22">Kik ibed koda mabor, yaye Ruoth Nyasaye.<verse eid="PSA 35:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23"/>Aa malo, kendo chungi mondo ikonya!</para>
  <para style="q2" vid="PSA 35:23">Kedna, yaye Nyasacha kendo Ruodha.<verse eid="PSA 35:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24"/>Yala kichwaka kuom timni makare, yaye Jehova Nyasaye ma Nyasacha;</para>
  <para style="q2" vid="PSA 35:24">kik iyienegi gisungre ni gisenyala.<verse eid="PSA 35:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25"/>Kik iwe giwach e chunygi niya,</para>
  <para style="q2" vid="PSA 35:25">“Ero, otimorene mana kaka ne wadwaro.”</para>
  <para style="q2" vid="PSA 35:25">Kata giwach niya, “Koro wasemuonye ngili.”<verse eid="PSA 35:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26"/>Mad ji duto mamor nikech chandruokna</para>
  <para style="q2" vid="PSA 35:26">oyud wichkuot kendo pachgi olal;</para>
  <para style="q1" vid="PSA 35:26">mad joma kaworena oyud wichkuot gi achaya.<verse eid="PSA 35:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27"/>Mad joma mor kuom loch ma imiya</para>
  <para style="q2" vid="PSA 35:27">okog gi ilo kod mor;</para>
  <para style="q1" vid="PSA 35:27">mad gisiki kagiwacho kinde duto niya,</para>
  <para style="q2" vid="PSA 35:27">“Jehova Nyasaye mondo otingʼ malo</para>
  <para style="q2" vid="PSA 35:27">nikech omiyo jatichne locho.”<verse eid="PSA 35:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28"/>Abiro pako timni makare</para>
  <para style="q2" vid="PSA 35:28">kendo kuom pakni duto odiechiengʼ duto.<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="cl">Zaburi 36</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi jatich Jehova Nyasaye.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1"/>An-gi wach e chunya mowuok kuom Nyasaye,</para>
  <para style="q2" vid="PSA 36:1">kuom gima joricho timo:</para>
  <para style="q1" vid="PSA 36:1">Ok giluoro Nyasaye</para>
  <para style="q2" vid="PSA 36:1">kata matin.<verse eid="PSA 36:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2"/>Nikech chunye wuonde kendo owuondore kende,</para>
  <para style="q2" vid="PSA 36:2">chunye wuonde ma ok onyal neno richone mosin-go.<verse eid="PSA 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3"/>Weche mawuok e dhoge richo kendo gin miriambo;</para>
  <para style="q2" vid="PSA 36:3">oseweyo bedo mariek kod timo maber.<verse eid="PSA 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4"/>Kata konindo e kitandane, to ochano timo gima rach;</para>
  <para style="q2" vid="PSA 36:4">oseketo chunye mar luwo yor richo,</para>
  <para style="q2" vid="PSA 36:4">kendo ok otamre gima rach.<verse eid="PSA 36:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5"/>Herani ochopo nyaka e polo malo, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 36:5">adierani chopo nyaka e polo,<verse eid="PSA 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6"/>Timni makare chalo gi gode madongo,</para>
  <para style="q2" vid="PSA 36:6">ratiro mari chalo gi kut matut.</para>
  <para style="q1" vid="PSA 36:6">Yaye Jehova Nyasaye, in ema irito ngima dhano gi le.<verse eid="PSA 36:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="PSA 36:7"/>Mano kaka herani ma ok rum nengone tek, yaye Nyasaye!</para>
  <para style="q1" vid="PSA 36:7">Joma idewo kaachiel gi joma ni piny</para>
  <para style="q2" vid="PSA 36:7">yudo kar pondo margi e bwo tipo mar bwombeni.<verse eid="PSA 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8"/>Gichamo chiemo mangʼeny e hekalu mari ka gimor;</para>
  <para style="q2" vid="PSA 36:8">imiyogi math moa e aorani mar mor.<verse eid="PSA 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9"/>Nimar in ema in gi soko mar pi mar ngima;</para>
  <para style="q2" vid="PSA 36:9">kuom lerni ema wanenoe ler.<verse eid="PSA 36:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10"/>Med nyiso herani ni joma ongʼeyi,</para>
  <para style="q2" vid="PSA 36:10">med nyiso timni makare ne joma gie chunygi ni kare.<verse eid="PSA 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11"/>Mad tiend joma sungore kik nyona,</para>
  <para style="q2" vid="PSA 36:11">kata lwet joma timbegi richo gola kama antie.<verse eid="PSA 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12"/>Neye kaka joma timo gik maricho oriere piny kopodho</para>
  <para style="q2" vid="PSA 36:12">osedirgi piny ma ok ginyal aa malo!<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="cl">Zaburi 37</para>
  <para style="d">Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1"/>Kik chunyi chandre nikech joma richo</para>
  <para style="q2" vid="PSA 37:1">bende chunyi kik gomb gige joma timo gik maricho;<verse eid="PSA 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2"/>nikech gibiro ner mapiyo mana kaka lum ner;</para>
  <para style="q2" vid="PSA 37:2">gibiro tho mi gilal nono mapiyo mana kaka yiende mangʼich.<verse eid="PSA 37:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3"/>Gen kuom Jehova Nyasaye kendo tim maber.</para>
  <para style="q2" vid="PSA 37:3">Eka inidag e piny kendo inichiem gi mor e lek maber.<verse eid="PSA 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4"/>Bed mamor kuom Jehova Nyasaye</para>
  <para style="q2" vid="PSA 37:4">eka obiro miyi gik moko duto ma chunyi dwaro.<verse eid="PSA 37:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5"/>Ket yoreni kuom Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 37:5">ket genoni kuome eka obiro timo kama:<verse eid="PSA 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6"/>Obiro miyo timni makare rieny ka ler mar okinyi,</para>
  <para style="q2" vid="PSA 37:6">kendo obiro miyo ratiro mari bed machalo</para>
  <para style="q2" vid="PSA 37:6">gi wangʼ chiengʼ marieny odiechiengʼ tir.<verse eid="PSA 37:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7"/>Bed mos e nyim Jehova Nyasaye, kendo rite kihori mos;</para>
  <para style="q2" vid="PSA 37:7">kik chunyi chandre ka joma moko dhi nyime maber,</para>
  <para style="q2" vid="PSA 37:7">ka gitimo chenrogi maricho.<verse eid="PSA 37:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8"/>Ritri kik ibed gi mirima kendo lokri iwe ich wangʼ</para>
  <para style="q2" vid="PSA 37:8">kik ibed gi ich wangʼ nikech okelo mana rach.<verse eid="PSA 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9"/>Nikech joma richo ibiro ngʼad kargi oko,</para>
  <para style="q2" vid="PSA 37:9">to joma oketo genogi kuom Jehova Nyasaye piny biro bedo margi.<verse eid="PSA 37:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10"/>Kinde matin nono to joma timbegi richo ok nobedie;</para>
  <para style="q2" vid="PSA 37:10">kata obedo ni unumanygi to ok unuyudgi.<verse eid="PSA 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11"/>To joma muol piny biro bedo margi</para>
  <para style="q2" vid="PSA 37:11">kendo gibiro winjo maber ka gin gi kwe maduongʼ.<verse eid="PSA 37:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12"/>Joma timbegi richo chano timo marach ni joma kare</para>
  <para style="q2" vid="PSA 37:12">kendo gimwodo lekegi ka gin gi mirima;<verse eid="PSA 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13"/>to Ruoth Nyasaye nyiero joma timbegi richo,</para>
  <para style="q2" vid="PSA 37:13">nimar ongʼeyo ni odiechieng-gi biro.<verse eid="PSA 37:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14"/>Joma timbegi richo wuodho liganglagi</para>
  <para style="q2" vid="PSA 37:14">kendo gidolo atungegi,</para>
  <para style="q1" vid="PSA 37:14">mondo gichiel joma odhier gi jochan piny,</para>
  <para style="q2" vid="PSA 37:14">mondo gineg joma yoregi oriere tir.<verse eid="PSA 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15"/>To ligengligi biro chwoyo adundogi giwegi,</para>
  <para style="q2" vid="PSA 37:15">kendo atungegi biro tur.<verse eid="PSA 37:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16"/>Gima tin ma ngʼat makare nigo</para>
  <para style="q2" vid="PSA 37:16">ber moloyo mwandu mathoth mag joma timbegi richo;<verse eid="PSA 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17"/>nikech teko mar joma timbegi richo ibiro kethi,</para>
  <para style="q2" vid="PSA 37:17">to Jehova Nyasaye tingʼo ngʼat makare malo.<verse eid="PSA 37:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18"/>Ndalo mag joma kare ongʼere ni Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 37:18">kendo girkeni margi biro siko nyaka chiengʼ.<verse eid="PSA 37:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19"/>E kinde mag masira mopore ok ginibed moner,</para>
  <para style="q2" vid="PSA 37:19">bende gibiro bedo gi chiemo mathoth ndalo kech.<verse eid="PSA 37:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20"/>To joma timbegi richo biro lal nono:</para>
  <para style="q2" vid="PSA 37:20">Wasik Jehova Nyasaye biro chalo gi ber mar thiepe manie pap,</para>
  <para style="q2" vid="PSA 37:20">gibiro lal nono, adier gibiro lal nono kaka iro.<verse eid="PSA 37:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21"/>Joma timbegi richo holo ji gik moko to ok chul,</para>
  <para style="q2" vid="PSA 37:21">to joma kare to chiwo gi ngʼwono;<verse eid="PSA 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22"/>piny biro bedo girkeni mar joma Jehova Nyasaye ogwedho,</para>
  <para style="q2" vid="PSA 37:22">to joma okwongʼo ibiro ngʼad kargi oko.<verse eid="PSA 37:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23"/>Ka Jehova Nyasaye mor gi yor ngʼato,</para>
  <para style="q2" vid="PSA 37:23">to omiyo yorene bedo mopie;<verse eid="PSA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24"/>kata ka ochwanyore to ok obi podho;</para>
  <para style="q2" vid="PSA 37:24">nikech Jehova Nyasaye omako lwete.<verse eid="PSA 37:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25"/>Nyaka aa e tin-na mi koro adoko ngʼama duongʼ</para>
  <para style="q2" vid="PSA 37:25">pok aneno ka joma kare ojwangʼ,</para>
  <para style="q2" vid="PSA 37:25">kata ka nyithindgi kwayo chiemo.<verse eid="PSA 37:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26"/>Kinde duto gingʼwon kendo giholo ji gigegi nono;</para>
  <para style="q2" vid="PSA 37:26">nyithindgi ibiro gwedhi.<verse eid="PSA 37:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27"/>Lokri iwe timo marach mondo itim maber;</para>
  <para style="q2" vid="PSA 37:27">eka inidag e piny nyaka chiengʼ.<verse eid="PSA 37:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28"/>Nikech Jehova Nyasaye ohero joma joratiro,</para>
  <para style="q2" vid="PSA 37:28">kendo ok obi jwangʼo joge ma jo-adiera.</para>
  <para style="b" vid="PSA 37:28"/>
  <para style="q1" vid="PSA 37:28">Ibiro ritgi maber nyaka chiengʼ,</para>
  <para style="q2" vid="PSA 37:28">to koth joma timbegi richo,</para>
  <para style="q2" vid="PSA 37:28">ibiro ngʼad kargi oko;<verse eid="PSA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29"/>joma kare piny biro bedo margi</para>
  <para style="q2" vid="PSA 37:29">kendo gibiro dak e piny nyaka chiengʼ.<verse eid="PSA 37:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30"/>Dho ngʼat makare hulo rieko</para>
  <para style="q2" vid="PSA 37:30">kendo lewe wacho gima ratiro.<verse eid="PSA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31"/>Chik mar Nyasache ni e chunye;</para>
  <para style="q2" vid="PSA 37:31">omiyo tiendene ok kier.<verse eid="PSA 37:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32"/>Joma timbegi richo pondo karito joma kare</para>
  <para style="q2" vid="PSA 37:32">ka gidwaro tieko ngimagi;<verse eid="PSA 37:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33"/>to Jehova Nyasaye ok bi weyogi e lwetgi</para>
  <para style="q2" vid="PSA 37:33">kata yie bura logi sa ma iyalogi.<verse eid="PSA 37:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34"/>Bed gi geno kuom Jehova Nyasaye</para>
  <para style="q2" vid="PSA 37:34">kendo luw yore.</para>
  <para style="q1" vid="PSA 37:34">Obiro tingʼi malo mi omi piny bed mari;</para>
  <para style="q2" vid="PSA 37:34">ka joma richo ongʼad kargi oko to ibiro neno gi wangʼi.<verse eid="PSA 37:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35"/>Aseneno ngʼama timbene richo kendo makwiny</para>
  <para style="q2" vid="PSA 37:35">kadhi maber mana ka yien mangʼich moti e lowo mowinjore kode.<verse eid="PSA 37:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36"/>To ne okalo kamano piyo piyo nono kendo ne ok ochak onene,</para>
  <para style="q2" vid="PSA 37:36">kata ne omanye to ne ok nyal yude.<verse eid="PSA 37:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37"/>Ne kit ngima joma onge ketho,</para>
  <para style="q2" vid="PSA 37:37">non chal joma ngimagi oriere tir,</para>
  <para style="q2" vid="PSA 37:37">ngʼama ohero kwe nigi geno mar dak amingʼa.<verse eid="PSA 37:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38"/>To joricho duto ibiro tieki,</para>
  <para style="q2" vid="PSA 37:38">joma timbegi richo ibiro ngʼad ndalogi oko.<verse eid="PSA 37:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39"/>Warruok mar joma kare aa mana kuom Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 37:39">En e kar pondo margi e ndalo mar chandruok.<verse eid="PSA 37:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40"/>Jehova Nyasaye konyogi kendo resogi</para>
  <para style="q2" vid="PSA 37:40">oresogi e lwet joma timbegi richo,</para>
  <para style="q2" vid="PSA 37:40">kendo owarogi, nikech gipondo kuome.<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="cl">Zaburi 38</para>
  <para style="d">Zaburi mar Daudi. Lemo mar kwayo kony.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1"/>Yaye Jehova Nyasaye, kik ikwera ka in gi mirima</para>
  <para style="q2" vid="PSA 38:1">bende kik ikuma ka mirima mager omaki.<verse eid="PSA 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2"/>Nikech aserni magi osechwoya,</para>
  <para style="q2" vid="PSA 38:2">kendo lweti osebet kuoma.<verse eid="PSA 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3"/>Mirimbi mager osemiyo ringra obedo maonge ngima maber;</para>
  <para style="q2" vid="PSA 38:3">chokena ok winj maber nikech richona.<verse eid="PSA 38:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4"/>Ketho ma asekethogo oima</para>
  <para style="q2" vid="PSA 38:4">mana ka lodi mapek mohinga tingʼo.<verse eid="PSA 38:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5"/>Adhondena otimo tutu kendo dungʼ marach</para>
  <para style="q2" vid="PSA 38:5">nikech fupa mar timo richo.<verse eid="PSA 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6"/>Adolora kendo akulora piny chuth odiechiengʼ duto,</para>
  <para style="q2" vid="PSA 38:6">awuotho koni gi koni, ka akuyo.<verse eid="PSA 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7"/>Ondingʼa rama gi rem malich;</para>
  <para style="q2" vid="PSA 38:7">ringra onge gi ngima maber.<verse eid="PSA 38:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8"/>Denda ool kendo tekra orumo chuth;</para>
  <para style="q2" vid="PSA 38:8">achur nikech chunya lit.<verse eid="PSA 38:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9"/>Gik ma chunya dwaro duto ongʼereni maber, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 38:9">chur ma achurgo ok opondoni.<verse eid="PSA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10"/>Chunya gwecho, tekra orumo;</para>
  <para style="q2" vid="PSA 38:10">wengena otimo mudho.<verse eid="PSA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11"/>Osiepena gi anywolana ok dwar nena nikech adhondena;</para>
  <para style="q2" vid="PSA 38:11">joma odak buta otangʼ koda.<verse eid="PSA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12"/>Joma dwaro kawo ngimana ochiko obadhogi,</para>
  <para style="q2" vid="PSA 38:12">joma dwaro hinya chano kaka ginyalo tieka chuth.</para>
  <para style="q2" vid="PSA 38:12">Gichano miriambo odiechiengʼ duto.<verse eid="PSA 38:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13"/>Achalo ngʼama ite odino, ma ok nyal winjo wach,</para>
  <para style="q2" vid="PSA 38:13">mana ka momo ma ok nyal yawo dhoge;<verse eid="PSA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14"/>Achalo gi ngʼat ma ok winj wach,</para>
  <para style="q2" vid="PSA 38:14">ma dhoge ok nyal dwoko wach.<verse eid="PSA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15"/>To in ema ariti, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 38:15">kendo angʼeyo ni ibiro dwoka, yaye Ruoth Nyasacha.<verse eid="PSA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16"/>Nimar ne awacho niya, “Kik iyie mondo gisungrena,</para>
  <para style="q2" vid="PSA 38:16">kata gigona siboi ni tienda okier.”<verse eid="PSA 38:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17"/>Nimar achiegni podho,</para>
  <para style="q2" vid="PSA 38:17">kendo rem ma an-go osiko koda.<verse eid="PSA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18"/>Ahulo kethona;</para>
  <para style="q2" vid="PSA 38:18">richona chando chunya.<verse eid="PSA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19"/>Wasika molwora ngʼeny;</para>
  <para style="q2" vid="PSA 38:19">joma ochaya maonge gima omiyo thoth mokalo akwana.<verse eid="PSA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20"/>Joma chulo rach kuom ber ma asetimonegi</para>
  <para style="q2" vid="PSA 38:20">kuodho nyinga ka an to alawo gima ber.<verse eid="PSA 38:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21"/>Yaye Jehova Nyasaye, kik ijwangʼa;</para>
  <para style="q2" vid="PSA 38:21">kik ibed mabor koda, yaye Nyasacha.<verse eid="PSA 38:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22"/>Bi piyo mondo ikonya,</para>
  <para style="q2" vid="PSA 38:22">yaye Ruoth Nyasaye kendo Jawarna.<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="cl">Zaburi 39</para>
  <para style="d">Kuom jatend wer. Ne Jeduthun. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1"/>Ne awacho niya, “Abiro ritora e yorena,</para>
  <para style="q2" vid="PSA 39:1">kendo abiro rito lewa kik wach richo;</para>
  <para style="q1" vid="PSA 39:1">abiro tweyo dhoga gi tol kinde duto</para>
  <para style="q2" vid="PSA 39:1">ma joma timbegi richo ni buta.”<verse eid="PSA 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2"/>To e seche mane ok awuo kendo alingʼ mos,</para>
  <para style="q2" vid="PSA 39:2">kane ok awach gimoro amora maber,</para>
  <para style="q2" vid="PSA 39:2">pek manie chunya nomedore.<verse eid="PSA 39:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3"/>Chunya nodoko maliet e iya</para>
  <para style="q2" vid="PSA 39:3">kendo kane amedo paro matut, to nomedo bedo malit;</para>
  <para style="q2" vid="PSA 39:3">eka ne atingʼo dhoga mi awuoyo:<verse eid="PSA 39:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4"/>Yaye Jehova Nyasaye, nyisa giko mar ngimana</para>
  <para style="q2" vid="PSA 39:4">bende nyisa kar romb ndalona;</para>
  <para style="q2" vid="PSA 39:4">mondo abed ka angʼeyo ni ndalona kadho piyo.<verse eid="PSA 39:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5"/>Iseketo ndalona obedo machiek ka bad dhano;</para>
  <para style="q2" vid="PSA 39:5">kar romb higni maga ok gimoro e nyimi,</para>
  <para style="q2" vid="PSA 39:5">ngima dhano ka dhano en mana muya nono. <char style="qs">Sela</char><verse eid="PSA 39:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6"/>Dhano en mana tipo makadho kata ka owuotho koni gi koni,</para>
  <para style="q2" vid="PSA 39:6">orikni gi tijene mapile kayiem;</para>
  <para style="q2" vid="PSA 39:6">ochoko mwandu mathoth ka ok ongʼeyo ngʼama obiro weyonegi.<verse eid="PSA 39:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7"/>To koro, yaye Ruoth, en angʼo ma amanyo?</para>
  <para style="q2" vid="PSA 39:7">Genona aketo kuomi.<verse eid="PSA 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8"/>Resa kuom ketho maga duto;</para>
  <para style="q2" vid="PSA 39:8">kik imi abedi ngʼama joma ofuwo jaro.<verse eid="PSA 39:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9"/>Ne alingʼ alingʼa, kendo ne ok anyal yawo dhoga mondo awuo,</para>
  <para style="q2" vid="PSA 39:9">nikech in ema isetimo ma.<verse eid="PSA 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10"/>Gol chwat ma isechwadago oko;</para>
  <para style="q2" vid="PSA 39:10">goch ma lweti goyago ohinga.<verse eid="PSA 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11"/>Ikwero ji kikumogi nikech richogi;</para>
  <para style="q2" vid="PSA 39:11">itieko mwandugi mana kaka thuth tieko oduma,</para>
  <para style="q2" vid="PSA 39:11">dhano ka dhano en mana muya nono. <char style="qs">Sela</char><verse eid="PSA 39:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12"/>Winj lamona, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 39:12">chik iti ni lamona ma adwarogo kony;</para>
  <para style="q2" vid="PSA 39:12">kik idin iti ne ywakna,</para>
  <para style="q1" vid="PSA 39:12">nikech adak kodi mana ka japiny moro,</para>
  <para style="q2" vid="PSA 39:12">an mana wendo kaka kwerena duto ne gin.<verse eid="PSA 39:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13"/>We ngʼiya, mondo achak abed moil kendo</para>
  <para style="q2" vid="PSA 39:13">kapok adar aweyo pinyni mi alal e wangʼ ji.<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="cl">Zaburi 40</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1"/>Ne arito Jehova Nyasaye ka ahora mos;</para>
  <para style="q2" vid="PSA 40:1">ne odwogo ira mi owinjo ywakna.<verse eid="PSA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2"/>Ne oywaya oko e bur motimo otodo,</para>
  <para style="q2" vid="PSA 40:2">ne ogola e chwodho gi thidhna.</para>
  <para style="q1" vid="PSA 40:2">Ne oketo tiendena e lwanda</para>
  <para style="q2" vid="PSA 40:2">kendo nomiya kama otegno mondo achungie.<verse eid="PSA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3"/>Ne oketo wer manyien e dhoga,</para>
  <para style="q2" vid="PSA 40:3">en wer mipakogo Nyasachwa.</para>
  <para style="q1" vid="PSA 40:3">Ji mangʼeny biro neno mi gibed maluor</para>
  <para style="q2" vid="PSA 40:3">kendo gibiro keto genogi kuom Jehova Nyasaye.<verse eid="PSA 40:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4"/>Ngʼat moketo Jehova Nyasaye</para>
  <para style="q2" vid="PSA 40:4">kaka kar geno mare en ngʼat mogwedhi,</para>
  <para style="q1" vid="PSA 40:4">ngʼat ma ok many kony kuom josunga,</para>
  <para style="q2" vid="PSA 40:4">bende ok omany kony kuom joma lokore mondo olam nyiseche mag miriambo.<verse eid="PSA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5"/>Ranyisi misetimo thoth,</para>
  <para style="q2" vid="PSA 40:5">yaye Jehova Nyasaye ma Nyasacha.</para>
  <para style="q1" vid="PSA 40:5">Gigo mane ichanonwa</para>
  <para style="q2" vid="PSA 40:5">onge ngʼama nyalo kwanoni;</para>
  <para style="q1" vid="PSA 40:5">ka dine bed ni wanyalo wuoyo kuomgi;</para>
  <para style="q2" vid="PSA 40:5">to dine gibedo mangʼeny ma ok wanyal wacho.<verse eid="PSA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6"/>Misengini kod chiwo ok ema ne idwaro</para>
  <para style="q2" vid="PSA 40:6">to ita ema iseyawo;</para>
  <para style="q1" vid="PSA 40:6">misengini miwangʼo pep kod chiwo mag golo richo</para>
  <para style="q2" vid="PSA 40:6">ne ok idwaro.<verse eid="PSA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7"/>Eka nawacho niya, “Eri an ka,</para>
  <para style="q2" vid="PSA 40:7">asebiro mana kaka ondiki kuoma e Muma.<verse eid="PSA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8"/>Chunya dwaro timo dwaroni, yaye Nyasacha;</para>
  <para style="q2" vid="PSA 40:8">chikni ni ei chunya.”<verse eid="PSA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9"/>Alando tim makare e chokruok maduongʼ;</para>
  <para style="q2" vid="PSA 40:9">ok aumo dhoga,</para>
  <para style="q2" vid="PSA 40:9">mana kaka ingʼeyo, yaye Jehova Nyasaye.<verse eid="PSA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10"/>Ok apando timni makare e chunya;</para>
  <para style="q2" vid="PSA 40:10">to awuoyo kuom adierani gi warruokni.</para>
  <para style="q1" vid="PSA 40:10">Ok apando herani gi adierani</para>
  <para style="q2" vid="PSA 40:10">ni chokruok maduongʼ.<verse eid="PSA 40:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11"/>Kik itamri kecha, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 40:11">mad herani gi adierani osik ka rita.<verse eid="PSA 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12"/>Nikech chandruok mokalo akwana olwora;</para>
  <para style="q2" vid="PSA 40:12">richona osejuka kendo ok anyal neno.</para>
  <para style="q1" vid="PSA 40:12">Gingʼeny moloyo yie wiya,</para>
  <para style="q2" vid="PSA 40:12">kendo chunya onyosore gie iya.<verse eid="PSA 40:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13"/>Bed mamor, yaye Jehova Nyasaye, mondo iresa.</para>
  <para style="q2" vid="PSA 40:13">Bi piyo, yaye Jehova Nyasaye, mondo ikonya.<verse eid="PSA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14"/>Mad ji duto madwaro ketho ngimana</para>
  <para style="q2" vid="PSA 40:14">wigi kuodi kendo pachgi olal;</para>
  <para style="q1" vid="PSA 40:14">mad ji duto ma chunygi gombona tho</para>
  <para style="q2" vid="PSA 40:14">oriemb kadok gi wich okuot.<verse eid="PSA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15"/>Mad joma nyiera niya, “Haa! Haa!”</para>
  <para style="q2" vid="PSA 40:15">Ngʼengʼ ka gineno wichkuot.<verse eid="PSA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16"/>To mad ji duto madwari</para>
  <para style="q2" vid="PSA 40:16">bed moil kendo mamor kuomi;</para>
  <para style="q1" vid="PSA 40:16">mad joma ohero warruok mari osik kawacho niya,</para>
  <para style="q2" vid="PSA 40:16">“Jehova Nyasaye mondo oyud duongʼ!”<verse eid="PSA 40:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17"/>Anto adhier kendo achando,</para>
  <para style="q2" vid="PSA 40:17">mad Ruoth Nyasaye parae.</para>
  <para style="q1" vid="PSA 40:17">In e jakonyna kendo jawarna;</para>
  <para style="q2" vid="PSA 40:17">in e Nyasacha, kik ideki.<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="cl">Zaburi 41</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1"/>Ngʼama paro joma ok nyal en jahawi;</para>
  <para style="q2" vid="PSA 41:1">Jehova Nyasaye rese ka chandruok omake.<verse eid="PSA 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2"/>Jehova Nyasaye biro rite kendo biro miyo obed mangima;</para>
  <para style="q2" vid="PSA 41:2">Jehova Nyasaye biro gwedhe e piny,</para>
  <para style="q2" vid="PSA 41:2">kendo ok obi jwangʼe e lwet wasike.<verse eid="PSA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3"/>Jehova Nyasaye biro rite e kitandane mar tuo midekre</para>
  <para style="q2" vid="PSA 41:3">kendo obiro miyo oa malo e kitandane ka ohewore.<verse eid="PSA 41:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4"/>Ne awacho niya, “Yaye Jehova Nyasaye, kecha;</para>
  <para style="q2" vid="PSA 41:4">changa, nikech aseketho e nyimi.”<verse eid="PSA 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5"/>Wasika wuoyo kuoma ka chunygi rach koda, kagiwacho niya,</para>
  <para style="q2" vid="PSA 41:5">“Obiro tho karangʼo mondo nyinge olal chuth?”<verse eid="PSA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6"/>Sa asaya ma ngʼato obiro nena,</para>
  <para style="q2" vid="PSA 41:6">to owuondore ni owuoyo kuoma maber,</para>
  <para style="q1" vid="PSA 41:6">to ei chunye to ofwambo weche,</para>
  <para style="q2" vid="PSA 41:6">mondo okethgo nyinga eka oa odhi kendo okeyo wechego ne ji.<verse eid="PSA 41:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7"/>Wasika duto kuodho wach kuoma kaachiel kaka ginyalo hinya,</para>
  <para style="q2" vid="PSA 41:7">chunygi paro gik maricho mogik mondo ohinya,</para>
  <para style="q2" vid="PSA 41:7">kagiwacho niya,<verse eid="PSA 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8"/>“Tuo marach osekete piny;</para>
  <para style="q2" vid="PSA 41:8">ok obi aa malo kama oninde.”<verse eid="PSA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9"/>Koda ka osiepna mane ageno kuome,</para>
  <para style="q2" vid="PSA 41:9">ngʼat mane chiemo koda,</para>
  <para style="q2" vid="PSA 41:9">bende osendhoga.<verse eid="PSA 41:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10"/>To in, yaye Jehova Nyasaye, yie ikecha;</para>
  <para style="q2" vid="PSA 41:10">chunga malo, mondo achulgi.<verse eid="PSA 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11"/>Angʼeyo ni chunyi mor koda,</para>
  <para style="q2" vid="PSA 41:11">nimar jowasika ok loya.<verse eid="PSA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12"/>Itingʼa malo nikech timna makare</para>
  <para style="q2" vid="PSA 41:12">kendo ichunga e nyimi nyaka chiengʼ.<verse eid="PSA 41:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13"/>Pak ne Jehova Nyasaye, ma Nyasach Israel,</para>
  <para style="q2" vid="PSA 41:13">nyaka chiengʼ kendo nyaka chiengʼ.</para>
  <para style="qc" vid="PSA 41:13">Amin kendo Amin.<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms">Kitabu mar Ariyo</para>
  <para style="mr">
    <ref loc="PSA 42-72">Zaburi 42–72</ref></para>
  <para style="cl">Zaburi 42</para>
  <para style="d">Kuom jatend wer. <char style="tl">Maskil</char><note caller="+" style="f"><char style="fr" closed="false">42:0 </char><char style="fl" closed="false">Maskil: </char><char style="ft" closed="false">en kit wer moro mane Daudi owero.</char></note> mar yawuot Kora.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1"/>Mana kaka mwanda gamo yweyo kamanyo kuonde ma pi nitie,</para>
  <para style="q2" vid="PSA 42:1">e kaka chunya dwari, yaye Nyasaye.<verse eid="PSA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2"/>Chunya riyo oloyo mar dwaro Nyasaye.</para>
  <para style="q2" vid="PSA 42:2">En riyo mar dwaro Nyasaye mangima.</para>
  <para style="q2" vid="PSA 42:2">Abiro dhi romo kod Nyasaye karangʼo?<verse eid="PSA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3"/>Aseywak mi pi wangʼa osechalo chiemba</para>
  <para style="q2" vid="PSA 42:3">odiechiengʼ gotieno,</para>
  <para style="q1" vid="PSA 42:3">ka ji to wachona odiechiengʼ duto niya,</para>
  <para style="q2" vid="PSA 42:3">“Koro ere Nyasachino?”<verse eid="PSA 42:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4"/>Aparo gigi duto</para>
  <para style="q2" vid="PSA 42:4">ka chunya opongʼ giywak:</para>
  <para style="q1" vid="PSA 42:4">aparo kaka ne adhi gi oganda maduongʼ</para>
  <para style="q2" vid="PSA 42:4">ka atelo ni ji madhi e od Nyasaye,</para>
  <para style="q1" vid="PSA 42:4">Ka akok gimor kendo agoyo erokamano</para>
  <para style="q2" vid="PSA 42:4">E dier oganda maduongʼ matimo nyasi gi mor.<verse eid="PSA 42:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5"/>Angʼo momiyo ikuyo, yaye chunya?</para>
  <para style="q2" vid="PSA 42:5">Angʼo momiyo inyosori yaye chunya?</para>
  <para style="q1" vid="PSA 42:5">Ket genoni kuom Nyasaye,</para>
  <para style="q2" vid="PSA 42:5">nikech pod abiro pake,</para>
  <para style="q2" vid="PSA 42:5">kaka Jawarna kendo Nyasacha.<verse eid="PSA 42:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6"/>Chunya lit;</para>
  <para style="q2" vid="PSA 42:6">omiyo abiro pari,</para>
  <para style="q1" vid="PSA 42:6">ka an e piny mar Jordan,</para>
  <para style="q2" vid="PSA 42:6">gi kuonde motingʼore mar Hermon kod e got Mizar.<verse eid="PSA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7"/>Kut luongore gi kut</para>
  <para style="q2" vid="PSA 42:7">ei abururu mar pi;</para>
  <para style="q1" vid="PSA 42:7">apaka magi duto gi ahiti mager</para>
  <para style="q2" vid="PSA 42:7">oseywera motera.<verse eid="PSA 42:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8"/>Jehova Nyasaye chiko herane godiechiengʼ,</para>
  <para style="q2" vid="PSA 42:8">to gotieno to wende ni e chunya;</para>
  <para style="q1" vid="PSA 42:8">ma e lamo ma alamogo Nyasach ngimana.<verse eid="PSA 42:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9"/>Awacho ni Nyasaye ma lwandana niya,</para>
  <para style="q2" vid="PSA 42:9">“Angʼo momiyo wiyi osewil koda?</para>
  <para style="q1" vid="PSA 42:9">Angʼo momiyo asiko gi kuyo</para>
  <para style="q2" vid="PSA 42:9">ka jawasigu sanda?”<verse eid="PSA 42:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10"/>Chokena tho omako kendo rama malit</para>
  <para style="q2" vid="PSA 42:10">seche ma joma kedo koda yanya kochaya,</para>
  <para style="q1" vid="PSA 42:10">ka giwachona odiechiengʼ duto niya,</para>
  <para style="q2" vid="PSA 42:10">“Koro ere Nyasachino?”<verse eid="PSA 42:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11"/>Angʼo momiyo ikuyo, yaye chunya?</para>
  <para style="q2" vid="PSA 42:11">Angʼo momiyo inyosori, yaye chunya?</para>
  <para style="q1" vid="PSA 42:11">Ket genoni kuom Nyasaye,</para>
  <para style="q2" vid="PSA 42:11">nikech pod abiro pake,</para>
  <para style="q2" vid="PSA 42:11">en e Jawarna kendo Nyasacha.<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="cl">Zaburi 43</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1"/>Ngʼadna bura makare, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 43:1">kendo chwaka e kind joma ok ongʼeyo Nyasaye;</para>
  <para style="q2" vid="PSA 43:1">resa e lwet joma wuondore gi joma timbegi richo.<verse eid="PSA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2"/>In Nyasaye ma apondo kuome.</para>
  <para style="q2" vid="PSA 43:2">Koro to ijwangʼa nangʼo?</para>
  <para style="q1" vid="PSA 43:2">Angʼo momiyo nyaka asik ka akuyo,</para>
  <para style="q2" vid="PSA 43:2">ka jawasigu sanda?<verse eid="PSA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3"/>Or lerni kod adierani,</para>
  <para style="q2" vid="PSA 43:3">orgi mondo gitelna;</para>
  <para style="q1" vid="PSA 43:3">yie mondo gikela nyaka godi maler,</para>
  <para style="q2" vid="PSA 43:3">nyaka kama idakie.<verse eid="PSA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4"/>Eka anadhi e kendo mar misango mar Nyasaye,</para>
  <para style="q2" vid="PSA 43:4">nyaka achopi e nyim Nyasaye,</para>
  <para style="q2" vid="PSA 43:4">Nyasaye ma kelona mor kendo ilo.</para>
  <para style="q1" vid="PSA 43:4">Abiro paki gi nyatiti,</para>
  <para style="q2" vid="PSA 43:4">yaye Nyasaye kendo Nyasacha.<verse eid="PSA 43:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5"/>Angʼo momiyo ikuyo, yaye chunya?</para>
  <para style="q2" vid="PSA 43:5">Angʼo momiyo inyosori, yaye chunya?</para>
  <para style="q1" vid="PSA 43:5">Ket genoni kuom Nyasaye,</para>
  <para style="q2" vid="PSA 43:5">nikech pod abiro pake,</para>
  <para style="q2" vid="PSA 43:5">en e Jawarna kendo Nyasacha.<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="cl">Zaburi 44</para>
  <para style="d">Kuom jatend wer. <char style="tl">Maskil</char><note caller="+" style="f"><char style="fr" closed="false">44:0 </char><char style="fl" closed="false">Maskil: </char><char style="ft" closed="false">en kit wer moro mane Daudi owero</char></note> mar yawuot Kora.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1"/>Yaye Nyasaye, wasewinjo gi itwa;</para>
  <para style="q2" vid="PSA 44:1">kendo kwerewa osenyisowa,</para>
  <para style="q1" vid="PSA 44:1">gik mane itimo e ndalogi,</para>
  <para style="q2" vid="PSA 44:1">ndalo machon gi lala.<verse eid="PSA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2"/>Ne iriembo ogendini mamoko gi lweti iwuon</para>
  <para style="q2" vid="PSA 44:2">kendo ne iguro kwerewa kargi;</para>
  <para style="q1" vid="PSA 44:2">ne itieko ogendinigo</para>
  <para style="q2" vid="PSA 44:2">mi imiyo kwerewa okar.<verse eid="PSA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3"/>Ne ok giloyo pinyno gi liganglagi</para>
  <para style="q2" vid="PSA 44:3">kendo kata bedegi bende ne ok okelonigi loch;</para>
  <para style="q1" vid="PSA 44:3">to mana badi iwuon ma korachwich,</para>
  <para style="q2" vid="PSA 44:3">kod ler mar wangʼi ema nomiyo gilocho nimar ne iherogi.<verse eid="PSA 44:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4"/>In e Ruodha kendo Nyasacha,</para>
  <para style="q2" vid="PSA 44:4">magolo chik mondo Jakobo olochi.<verse eid="PSA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5"/>Wasiro wasikwa nikech in,</para>
  <para style="q2" vid="PSA 44:5">waloyo joma kedo kodwa kuom nyingi.<verse eid="PSA 44:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6"/>Atungʼ mara ok ageno kuome,</para>
  <para style="q2" vid="PSA 44:6">liganglana bende ok mi alochi;<verse eid="PSA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7"/>to in ema imiyowa loch ewi wasikwa,</para>
  <para style="q2" vid="PSA 44:7">imiyo joma kedo kodwa neno wichkuot.<verse eid="PSA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8"/>Sungawa ni kuom Nyasaye odiechiengʼ duto,</para>
  <para style="q2" vid="PSA 44:8">kendo wabiro pako nyingi nyaka chiengʼ. <char style="qs">Sela</char><note caller="+" style="f"><char style="fr" closed="false">44:8 </char><char style="fq" closed="false">Sela </char><char style="ft" closed="false">tiend wachni ok ongʼere.</char></note><verse eid="PSA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9"/>To koro isedagiwa kendo isedwokowa piny;</para>
  <para style="q2" vid="PSA 44:9">tinde ok idhi e kedo gi jolwenjwa.<verse eid="PSA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10"/>Ne imiyo waringo e nyim wasigu</para>
  <para style="q2" vid="PSA 44:10">kendo joma kedo kodwa oseyakowa.<verse eid="PSA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11"/>Ne ijwangʼowa mondo ongamwa ka rombe</para>
  <para style="q2" vid="PSA 44:11">kendo isekeyowa e dier pinje.<verse eid="PSA 44:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12"/>Ne iuso jogi nono</para>
  <para style="q2" vid="PSA 44:12">maonge ohala mane iyudo kuom usogi.<verse eid="PSA 44:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13"/>Isemiyo wadoko joma iyanyo e dier joma odak butwa,</para>
  <para style="q2" vid="PSA 44:13">wan joma inyiero kendo ma ocha gi joma olworowa.<verse eid="PSA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14"/>Isemiyo olokwa ngero e dier ogendini;</para>
  <para style="q2" vid="PSA 44:14">kendo ogendini kino wigi konenowa.<verse eid="PSA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15"/>Wichkuot mara osiko neno e wangʼa odiechiengʼ duto,</para>
  <para style="q2" vid="PSA 44:15">kendo lela wangʼa wichkuot oumo.<verse eid="PSA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16"/>Seche ma joma ochaya kendo yanya dirona weche,</para>
  <para style="q2" vid="PSA 44:16">nikech jasigu oramo ni nyaka ochul kuor.<verse eid="PSA 44:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17"/>Magi duto notimorena, kata obedo ni wiwa ne pok owil kodi,</para>
  <para style="q2" vid="PSA 44:17">kata riambo ne singruok mari.<verse eid="PSA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18"/>Chunywa ne pok oa moweyi;</para>
  <para style="q2" vid="PSA 44:18">kendo tiendewa ne pok okier moweyo yori.<verse eid="PSA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19"/>To pod ne igoyowa agoya mimiyo ondiegi olawowa;</para>
  <para style="q2" vid="PSA 44:19">kendo ne iumowa gi mudho mandiwa.<verse eid="PSA 44:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20"/>Ka dipo ni wiwa nosewil gi Nyasachwa</para>
  <para style="q2" vid="PSA 44:20">kata ni ne waseyaro lwetwa ne nyasaye moro ma wendo,<verse eid="PSA 44:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21"/>donge Nyasaye dine ofwenyo wachno,</para>
  <para style="q2" vid="PSA 44:21">nikech ongʼeyo gik malingʼ-lingʼ manie chuny?<verse eid="PSA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22"/>To nikech in, tho ochomowa odiechiengʼ duto;</para>
  <para style="q2" vid="PSA 44:22">ikwanowa kaka rombo mitero kar yengʼo.<verse eid="PSA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23"/>Chiew, yaye Ruoth Nyasaye! Inindo nangʼo?</para>
  <para style="q2" vid="PSA 44:23">Yaw wangʼi inen! Kik ikwedwa nyaka chiengʼ.<verse eid="PSA 44:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24"/>Ere gima omiyo ipandonwa wangʼi</para>
  <para style="q2" vid="PSA 44:24">momiyo wiyi owil kod pek ma wan-go kod chandruokwa?<verse eid="PSA 44:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25"/>Osedwokwa piny nyaka e buru,</para>
  <para style="q2" vid="PSA 44:25">dendwa omoko piny e lowo.<verse eid="PSA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26"/>Aa malo mondo ikonywa;</para>
  <para style="q2" vid="PSA 44:26">reswa nikech herani ma ok rem.<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="cl">Zaburi 45</para>
  <para style="d">Kuom jatend wer. Gi dwol mar “Ondanyo.” <char style="tl">Maskil</char><note caller="+" style="f"><char style="fr" closed="false">45:0 </char><char style="fl" closed="false">Maskil: </char><char style="ft" closed="false">en kit wer moro mane Daudi owero</char></note> mar yawuot Kora. Wend Arus.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1"/>Chunya bedo mamor gi wer mamit</para>
  <para style="q2" vid="PSA 45:1">e kinde mawero Zaburi maga ne Ruoth;</para>
  <para style="q2" vid="PSA 45:1">kendo lewa chalo kalamb jandiko mongʼith.<verse eid="PSA 45:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2"/>In ema iber moloyo chwo mamoko</para>
  <para style="q2" vid="PSA 45:2">kendo dhogi owir gi ngʼwono,</para>
  <para style="q2" vid="PSA 45:2">nikech Nyasaye osegwedhi nyaka chiengʼ.<verse eid="PSA 45:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3"/>Twe liganglani e bathi, yaye ngʼat maratego;</para>
  <para style="q2" vid="PSA 45:3">rwakri gi ler kod duongʼ.<verse eid="PSA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4"/>E duongʼni nyisri ayanga kaka jalocho</para>
  <para style="q2" vid="PSA 45:4">mochungʼ ni adiera gi muolo kod tim makare;</para>
  <para style="q2" vid="PSA 45:4">lweti ma korachwich mondo onyis timbeni miwuoro.<verse eid="PSA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5"/>Aserni mabitho mondo ochwo chunje mag wasik ruoth;</para>
  <para style="q2" vid="PSA 45:5">ogendini mondo opodh piny e bwoyi.<verse eid="PSA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6"/>Lochni nosik nyaka chiengʼ, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 45:6">kendo tim makare ema nobed kaka ludh loch e pinyruodhi.<verse eid="PSA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7"/>Ihero tim makare to imon gi timbe maricho;</para>
  <para style="q2" vid="PSA 45:7">emomiyo Nyasaye, ma Nyasachi,</para>
  <para style="q2" vid="PSA 45:7">osetingʼi malo moyombo jowadu nikech osewiri gi mo mamiyi mor.<verse eid="PSA 45:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8"/>Lepi maboyo duto dungʼ tik mane-mane gi poda kod kasia;</para>
  <para style="q2" vid="PSA 45:8">moa e ute ruodhi molichi gi lak liech.</para>
  <para style="q2" vid="PSA 45:8">Wende mindito gi gig wer miyi mor.<verse eid="PSA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9"/>Nyi ruodhi ni e kanyakla mag mondi moluor;</para>
  <para style="q2" vid="PSA 45:9">mikach ruoth ni e bathi korachwich korwakore gi dhahabu mogol Ofir.<verse eid="PSA 45:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10"/>Winji nyara, bed mos, kendo chik iti:</para>
  <para style="q2" vid="PSA 45:10">Gol pachi kuom jou kaachiel gi jood wuonu monywoli.<verse eid="PSA 45:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11"/>Berni otoyo ruoth; miye duongʼ,</para>
  <para style="q2" vid="PSA 45:11">nikech en ruodhi.<verse eid="PSA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12"/>Nyar Turo biro biro gi mich,</para>
  <para style="q2" vid="PSA 45:12">joma nigi mwandu biro dwaro kony kuomi.<verse eid="PSA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13"/>Duongʼ olworo ruoth madhako koni gi koni e kar dakne;</para>
  <para style="q2" vid="PSA 45:13">law abola mare oton-oton gi dhahabu.<verse eid="PSA 45:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14"/>Omake itere ne ruoth gi law mochwe gi usi;</para>
  <para style="q2" vid="PSA 45:14">nyiri masilili man kode luwo bangʼe kendo ikelonegi.<verse eid="PSA 45:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15"/>Irwakogi e ot gi ilo kod mor maduongʼ;</para>
  <para style="q2" vid="PSA 45:15">gidonjo e dala ruoth.<verse eid="PSA 45:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16"/>Yawuoti biro kawo kar wuonegi;</para>
  <para style="q2" vid="PSA 45:16">ibiro ketogi ruodhi e piny duto koni gi koni.<verse eid="PSA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17"/>Abiro miyo ji pari e tienge duto nyaka chiengʼ;</para>
  <para style="q2" vid="PSA 45:17">kuom mano ogendini biro paki mochwere manyaka chiengʼ.<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="cl">Zaburi 46</para>
  <para style="d">Kuom jatend wer. Mar yawuot Kora. Kaluwore gi dwond <char style="tl">alamoth</char><note caller="+" style="f"><char style="fr" closed="false">46:0 </char><char style="fl" closed="false">Alamoth: </char><char style="ft" closed="false">Ochalo ni en kit wer moro</char></note>. Wer.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1"/>Nyasaye e kar pondowa kendo tekowa,</para>
  <para style="q2" vid="PSA 46:1">en e kar konyruok man kodwa seche duto.<verse eid="PSA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2"/>Emomiyo ok wabi luor,</para>
  <para style="q2" vid="PSA 46:2">kata bed ni piny okethore kendo gode mukore e chuny nam,<verse eid="PSA 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3"/>Kata obedoni pige manie nam wuo kendo golo buoyo</para>
  <para style="q2" vid="PSA 46:3">kata obedo ni gode yiengni kendo dhwolore. <char style="qs">Sela</char><verse eid="PSA 46:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4"/>Nitie aora moro ma pige kelo mor e dala Nyasaye,</para>
  <para style="q2" vid="PSA 46:4">e dala maler kama Nyasaye Man Malo Moloyo odakie.<verse eid="PSA 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5"/>Nyasaye odak e iye omiyo ok obi podho;</para>
  <para style="q2" vid="PSA 46:5">Nyasaye biro konye ka piny oyawore.<verse eid="PSA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6"/>Ogendini nigi chandruok, kendo pinjeruodhi podho;</para>
  <para style="q2" vid="PSA 46:6">otingʼo dwonde mi piny leny nono.<verse eid="PSA 46:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7"/>Jehova Nyasaye Maratego ni kodwa;</para>
  <para style="q2" vid="PSA 46:7">Nyasach Jakobo e ohingawa. <char style="qs">Sela</char><verse eid="PSA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8"/>Biuru uneye tije Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 46:8">bi uneye kethruok mosekelo e piny.<verse eid="PSA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9"/>Omiyo lwenje rumo e tungʼ piny koni gi koni;</para>
  <para style="q2" vid="PSA 46:9">oturo atungʼ kendo ochodo tongʼ matindo tindo,</para>
  <para style="q2" vid="PSA 46:9">bende owangʼo kuodi gi mach.<verse eid="PSA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10"/>“Bed mos, kendo ngʼe ni an Nyasaye;</para>
  <para style="q2" vid="PSA 46:10">ogendini biro miya duongʼ;</para>
  <para style="q2" vid="PSA 46:10">piny duto biro miya duongʼ.”<verse eid="PSA 46:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11"/>Jehova Nyasaye Maratego ni kodwa;</para>
  <para style="q2" vid="PSA 46:11">Nyasach Jakobo e ohingawa. <char style="qs">Sela</char><verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="cl">Zaburi 47</para>
  <para style="d">Kuom jatend wer. Zaburi mar yawuot Kora.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1"/>Pamuru lweteu, un ogendini duto;</para>
  <para style="q2" vid="PSA 47:1">Pakuru Nyasaye ka ukok matek gi mor.<verse eid="PSA 47:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2"/>Mano kaka Jehova Nyasaye Man Malo Moloyo lich,</para>
  <para style="q2" vid="PSA 47:2">en Ruoth Maduongʼ man-gi loch e piny duto!<verse eid="PSA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3"/>Ne oloyonwa ogendini mi gibet e bwowa,</para>
  <para style="q2" vid="PSA 47:3">ji nopodho piny e tiendewa.<verse eid="PSA 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4"/>Ne oyieronwa girkeni marwa,</para>
  <para style="q2" vid="PSA 47:4">gik mabeyo mogik ne Jakobo mane ohero. <char style="qs">Sela</char><verse eid="PSA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5"/>Nyasaye oseidho malo ka ji pake gi mor.</para>
  <para style="q2" vid="PSA 47:5">Jehova Nyasaye osetingʼ malo ka dwond turumbete ywak.<verse eid="PSA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6"/>Weruru wende pak ne Nyasaye, weruru wende pak;</para>
  <para style="q2" vid="PSA 47:6">weruru wende pak ne Ruodhwa, weruru wende pak.<verse eid="PSA 47:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7"/>Nikech Nyasaye en Ruodh piny duto,</para>
  <para style="q2" vid="PSA 47:7">werneuru zaburi mar pak.<verse eid="PSA 47:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8"/>Nyasaye nigi loch ewi ogendini;</para>
  <para style="q2" vid="PSA 47:8">Nyasaye obet piny e kom lochne maler.<verse eid="PSA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9"/>Jotend ogendini ochokore kaachiel</para>
  <para style="q2" vid="PSA 47:9">kaka jo-Nyasach Ibrahim,</para>
  <para style="q1" vid="PSA 47:9">nikech ruodhi mag piny gin mag Nyasaye;</para>
  <para style="q2" vid="PSA 47:9">omiyo Nyasaye oyud duongʼ.<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="cl">Zaburi 48</para>
  <para style="d">Wer. Zaburi mar yawuot Kora.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1"/>Jehova Nyasaye duongʼ adier, kendo owinjore chuth gi pak,</para>
  <para style="q2" vid="PSA 48:1">e dala maduongʼ mar Nyasachwa, ma en gode maler.<verse eid="PSA 48:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2"/>E dala motingʼore malo kendo ober neno</para>
  <para style="q2" vid="PSA 48:2">omiyo piny duto bedo mamor.</para>
  <para style="q1" vid="PSA 48:2">Got Sayun chalo gi kama otingʼore malo mar Zafon,</para>
  <para style="q2" vid="PSA 48:2">ma en dala maduongʼ mar Ruoth Maduongʼ.<verse eid="PSA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3"/>Nyasaye nitiere e dalane mochiel motegno</para>
  <para style="q2" vid="PSA 48:3">kendo osenyisore ni en e ohingane.<verse eid="PSA 48:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4"/>Ka ruodhi noriwo teko kanyakla,</para>
  <para style="q2" vid="PSA 48:4">kane giwuokne oko kaachiel,<verse eid="PSA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5"/>negineno mi gibuok;</para>
  <para style="q2" vid="PSA 48:5">kendo negiringo gia ka luoro omakogi.<verse eid="PSA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6"/>Dendgi nochako tetni kanyo</para>
  <para style="q2" vid="PSA 48:6">kendo negibedo gi rem machalo gi muoch ma kayo dhako.<verse eid="PSA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7"/>Ne iturogi matindo tindo ka meli mag Tarshish</para>
  <para style="q2" vid="PSA 48:7">ma yamb wuok chiengʼ ongʼinjo.<verse eid="PSA 48:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8"/>Mana kaka wasewinjo</para>
  <para style="q2" vid="PSA 48:8">e kaka waseneno gi wengewa,</para>
  <para style="q1" vid="PSA 48:8">e dala maduongʼ mar Jehova Nyasaye Maratego,</para>
  <para style="q2" vid="PSA 48:8">e dala mar Nyasachwa:</para>
  <para style="q2" vid="PSA 48:8">Nyasaye oselose kama dak berie nyaka chiengʼ. <char style="qs">Sela</char><verse eid="PSA 48:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9"/>Ei hekalu mari, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 48:9">ema wabetie ka waparo kuom herani ma ok rem.<verse eid="PSA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10"/>Mana kaka nyingi, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 48:10">e kaka pakni bende chopo nyaka tungʼ piny;</para>
  <para style="q2" vid="PSA 48:10">lweti ma korachwich opongʼ gi tim makare.<verse eid="PSA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11"/>Got Sayun oil,</para>
  <para style="q2" vid="PSA 48:11">kendo mier mag Juda nigi mor,</para>
  <para style="q2" vid="PSA 48:11">nikech iyalo ji maber.<verse eid="PSA 48:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12"/>Wuothi ei Sayun, luorri e iye koni gi koni,</para>
  <para style="q2" vid="PSA 48:12">kwan osuche duto,<verse eid="PSA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13"/>par maber kuom ohinga mage,</para>
  <para style="q2" vid="PSA 48:13">nee udi mag ruodhine,</para>
  <para style="q2" vid="PSA 48:13">mondo ibi inyis tienge mabiro.<verse eid="PSA 48:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14"/>Nikech Nyasaye en Nyasachwa manyaka chiengʼ</para>
  <para style="q2" vid="PSA 48:14">obiro bedo jaritwa nyaka chop giko ndalowa e piny.<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="cl">Zaburi 49</para>
  <para style="d">Kuom jatend wer. Zaburi mar yawuot Kora.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1"/>Winjuru wachni, un ji duto:</para>
  <para style="q2" vid="PSA 49:1">chikuru itu, un duto mudak e pinyni,<verse eid="PSA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2"/>un joma odhier kod joma idew,</para>
  <para style="q2" vid="PSA 49:2">jo-mwandu gi jodhier machalre:<verse eid="PSA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3"/>Dhoga biro wacho weche mag rieko,</para>
  <para style="q2" vid="PSA 49:3">weche moa e chunya biro miyo ji winjo tiend weche.<verse eid="PSA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4"/>Abiro chiko ita ne ngero moro;</para>
  <para style="q2" vid="PSA 49:4">abiro nyiso tiend midhiero mara ka agoyo nyatitina:<verse eid="PSA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5"/>En ngʼa monego aluor ka ndalo mag richo obiro,</para>
  <para style="q2" vid="PSA 49:5">ka jo-miriambo ma timbegi richo olwora.<verse eid="PSA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6"/>Joma oketo genogi kuom mwandu</para>
  <para style="q2" vid="PSA 49:6">kendo masungore kuom mwandugi mathoth?<verse eid="PSA 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7"/>Onge ngʼama nyalo waro ngima nyawadgi</para>
  <para style="q2" vid="PSA 49:7">kata manyalo chulo Nyasaye nengo moromo ware.<verse eid="PSA 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8"/>Nikech yor waro dhano tek ahinya,</para>
  <para style="q2" vid="PSA 49:8">maonge nengo madichul marom,<verse eid="PSA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9"/>ma dimi odag nyaka chiengʼ</para>
  <para style="q2" vid="PSA 49:9">kendo kik odhi e liel.<verse eid="PSA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10"/>Nikech ongʼere ne ji duto ni joma riek tho,</para>
  <para style="q2" vid="PSA 49:10">mana kaka joma ofuwo gi joma omingʼ,</para>
  <para style="q2" vid="PSA 49:10">bende tho mi giwe mwandu ne joma moko.<verse eid="PSA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11"/>Lietegi ema biro siko kaka utegi nyaka chiengʼ</para>
  <para style="q2" vid="PSA 49:11">kendo ema gibiro dakie higni gi higni ma ok rum,</para>
  <para style="q2" vid="PSA 49:11">kata obedo ni negimako lope mathoth koni gi koni.<verse eid="PSA 49:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12"/>To ongʼere ni dhano ok siki e piny,</para>
  <para style="q2" vid="PSA 49:12">kata obed gi mwandu mathoth machal nade,</para>
  <para style="q2" vid="PSA 49:12">to otho mana kaka le bende tho.<verse eid="PSA 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13"/>Mano e gima biro timore ne joma ogenore kendgi giwegi,</para>
  <para style="q2" vid="PSA 49:13">kendo ne joma luwogi, moluwo wechegi. <char style="qs">Sela</char><verse eid="PSA 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14"/>Gichomo liete mokuny nigi mana kaka rombe</para>
  <para style="q2" vid="PSA 49:14">kendo tho biro lokogi chiembe.</para>
  <para style="q1" vid="PSA 49:14">Joma ngimagi oriere tir biro loyogi ka piny oru,</para>
  <para style="q2" vid="PSA 49:14">to dendgi biro towo e liete,</para>
  <para style="q2" vid="PSA 49:14">ka gin mabor gi utegi madongo machalo ute ruodhi.<verse eid="PSA 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15"/>Anto Nyasaye biro reso chunya mi ogola e liel adier,</para>
  <para style="q2" vid="PSA 49:15">obiro kawa mi odhi koda ire. <char style="qs">Sela</char><verse eid="PSA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16"/>Kik chunyi thagre ka ngʼato mwandune medore,</para>
  <para style="q2" vid="PSA 49:16">kata ka duongʼ mar ode medore;<verse eid="PSA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17"/>nikech onge gima obiro kawo odhigo ka otho,</para>
  <para style="q2" vid="PSA 49:17">duongʼ ma en-go ok bi dhi kode e liel,<verse eid="PSA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18"/>kata obedo ni ne okawore kaka ngʼama ogwedhi kane pod ongima</para>
  <para style="q2" vid="PSA 49:18">nikech ji nyaka paki ka mwanduni medore,<verse eid="PSA 49:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19"/>to obiro dhi mi oriwre gi tiengʼ machon mar kwerene,</para>
  <para style="q2" vid="PSA 49:19">ma ok nyal neno ler mar wangʼ chiengʼ kendo.<verse eid="PSA 49:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20"/>Ngʼat man-gi mwandu mathoth to onge winjo,</para>
  <para style="q2" vid="PSA 49:20">chalo gi le ma otho.<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="cl">Zaburi 50</para>
  <para style="d">Zaburi mar Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1"/>Jal Manyalo Duto, Nyasaye ma en Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 50:1">wuoyo kendo luongo ji duto modak e piny mondo ochokrene kaachiel,</para>
  <para style="q2" vid="PSA 50:1">chakre wuok chiengʼ nyaka podho chiengʼ.<verse eid="PSA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2"/>Nyasaye rieny gie Sayun,</para>
  <para style="q2" vid="PSA 50:2">dala ma berne longʼo chuth.<verse eid="PSA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3"/>Nyasachwa biro kendo ok obi lingʼ</para>
  <para style="q2" vid="PSA 50:3">mach ni e nyime mawangʼo gik moko pep,</para>
  <para style="q2" vid="PSA 50:3">kendo ahiti mager olwore.<verse eid="PSA 50:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4"/>Oluongo joma odak e polo malo</para>
  <para style="q2" vid="PSA 50:4">kaachiel gi joma odak e piny, mondo oyal joge:<verse eid="PSA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5"/>“Choknauru joga maler,</para>
  <para style="q2" vid="PSA 50:5">mane otimo koda singruok e yor misango.”<verse eid="PSA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6"/>Kendo polo hulo timne makare,</para>
  <para style="q2" vid="PSA 50:6">nikech Nyasaye owuon e jangʼad bura. <char style="qs">Sela</char><verse eid="PSA 50:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7"/>“Winjuru, yaye joga, mondo awuo kodu,</para>
  <para style="q2" vid="PSA 50:7">yaye jo-Israel, chiknauru itu mondo atim neno ma akwedougo:</para>
  <para style="q2" vid="PSA 50:7">An Nyasaye ma Nyasachu.<verse eid="PSA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8"/>Ok akweru nikech wach misengini mutimona,</para>
  <para style="q2" vid="PSA 50:8">kata nikech misango miwangʼo pep,</para>
  <para style="q2" vid="PSA 50:8">mosiko ka nitie e nyima.<verse eid="PSA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9"/>Ok agomb rwath moro amora moa e kundeu</para>
  <para style="q2" vid="PSA 50:9">kata diek moa e abilni magu,<verse eid="PSA 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10"/>nikech le moro amora manie bungu en mara,</para>
  <para style="q2" vid="PSA 50:10">kaachiel gi jamni makwayo ewi gode gana achiel.<verse eid="PSA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11"/>Angʼeyo nying winyo ka winyo manie wi gode,</para>
  <para style="q2" vid="PSA 50:11">kendo gik mochwe duto manie pewe gin maga.<verse eid="PSA 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12"/>Ka dine bed ni kech kaya to ok dak anyisu,</para>
  <para style="q2" vid="PSA 50:12">nikech piny en mara, kaachiel gi gik moko duto manie iye.<verse eid="PSA 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13"/>Uparo ni achamo ring rwedhi</para>
  <para style="q2" vid="PSA 50:13">kata ni amadho remb diek?<verse eid="PSA 50:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14"/>Chiwuru misango mar goyo erokamano ni Nyasaye,</para>
  <para style="q2" vid="PSA 50:14">chopuru singruok mau ne Nyasaye Man Malo Moloyo,<verse eid="PSA 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15"/>kendo luongauru e kinde ma un e chandruok;</para>
  <para style="q2" vid="PSA 50:15">to abiro resou e chandruokugo, eka ubiro miya duongʼ.”<verse eid="PSA 50:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 50:16"/>Joma timbegi richo to Nyasaye wachonegi ni:</para>
  <para style="q1" vid="PSA 50:16">“Ngʼa momiyou thuolo mar olo chikena</para>
  <para style="q2" vid="PSA 50:16">kata mondo ukaw singruok maga kaka mau?<verse eid="PSA 50:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17"/>Ere kaka dutim kamano to uchayo puonjna</para>
  <para style="q2" vid="PSA 50:17">kendo udiro wechena katoku!<verse eid="PSA 50:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18"/>Ka uneno jakuo to uriworu kode</para>
  <para style="q2" vid="PSA 50:18">kendo uchodo mana kaka joma moko timo.<verse eid="PSA 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19"/>Utiyo gi dhou kuom timo richo</para>
  <para style="q2" vid="PSA 50:19">kendo lewu oikore ne wuond.<verse eid="PSA 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20"/>Usiko uwuoyo marach kuom joweteu</para>
  <para style="q2" vid="PSA 50:20">kendo ukuotho koda ka oweteu mahie ma uago e ich achiel.<verse eid="PSA 50:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21"/>Gigi duto usetimo ka an to alingʼ;</para>
  <para style="q2" vid="PSA 50:21">useparo ni an bende achalo kodu.</para>
  <para style="q1" vid="PSA 50:21">To koro akwerou kendo anyisou e wangʼu</para>
  <para style="q2" vid="PSA 50:21">ni useketho kuom timo gigo duto.<verse eid="PSA 50:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22"/>“Paruru matut kuom wachni, un joma wigi wil gi Nyasaye,</para>
  <para style="q2" vid="PSA 50:22">nono to abiro kidhou matindo tindo, maonge ngʼama diresu:<verse eid="PSA 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23"/>Ngʼat ma timona misango mar erokamano miya duongʼ</para>
  <para style="q2" vid="PSA 50:23">mondo olos yo moriere tir,</para>
  <para style="q2" vid="PSA 50:23">kendo anyise kaka warruok mar Nyasaye chalo.”<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="cl">Zaburi 51</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi. Kane janabi Nathan obiro ire bangʼ ka Daudi noseterore gi Bathsheba.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1"/>Kecha, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 51:1">kaluwore gi herani ma ok rem;</para>
  <para style="q1" vid="PSA 51:1">gol kethona duto oko</para>
  <para style="q2" vid="PSA 51:1">kuom ngʼwononi maduongʼ.<verse eid="PSA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2"/>Luok rochruokna duto oko</para>
  <para style="q2" vid="PSA 51:2">kendo pwodha kuom richona.<verse eid="PSA 51:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3"/>Nikech angʼeyo kethona duto</para>
  <para style="q2" vid="PSA 51:3">kendo richona osiko e nyima.<verse eid="PSA 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4"/>In iwuon ema asekethoni</para>
  <para style="q2" vid="PSA 51:4">kendo asetimo richo e nyim wangʼi,</para>
  <para style="q1" vid="PSA 51:4">mano omiyo in kare ka iwuoyo</para>
  <para style="q2" vid="PSA 51:4">kendo iwacho adiera ka ingʼadona bura.<verse eid="PSA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5"/>En adier chutho ni nonywola e richo</para>
  <para style="q2" vid="PSA 51:5">asebedo ka an jaricho chakre chiengʼ mane minwa omake ichna.<verse eid="PSA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6"/>Adier, idwaro ni dhano obed ja-adiera gie chunye iye</para>
  <para style="q2" vid="PSA 51:6">emomiyo ipuonja rieko gie chunya maiye mogik.<verse eid="PSA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7"/>Lwoka maler gi owino eka abiro bedo maler;</para>
  <para style="q2" vid="PSA 51:7">lwoka mondo abed marachar moloyo pe.<verse eid="PSA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8"/>We awinjie mor kod ilo;</para>
  <para style="q2" vid="PSA 51:8">mi chokena misetoyo ochak obedie mamor.<verse eid="PSA 51:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9"/>Pand wangʼi mondo kik ine richona</para>
  <para style="q2" vid="PSA 51:9">kendo gol kethona duto oko.<verse eid="PSA 51:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10"/>Chwe chuny maler e iya, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 51:10">kendo los chuny motegno mosiko koluori iket e iya.<verse eid="PSA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11"/>Kik iriemba buti</para>
  <para style="q2" vid="PSA 51:11">bende kik igol Roho Maler mari kuoma.<verse eid="PSA 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12"/>Duogna mor ma warruokni kelo</para>
  <para style="q2" vid="PSA 51:12">kendo mi abed gi chuny mohero timo dwaroni,</para>
  <para style="q2" vid="PSA 51:12">mondo chuny makamano orita.<verse eid="PSA 51:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13"/>Eka abiro puonjo joketho yoreni</para>
  <para style="q2" vid="PSA 51:13">kendo joricho biro lokore duogo iri.<verse eid="PSA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14"/>Resa e ketho mar chwero remo, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 51:14">tim kamano, yaye Nyasaye ma wara,</para>
  <para style="q2" vid="PSA 51:14">eka lewa biro wer kuom timni makare.<verse eid="PSA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15"/>Yaye Ruoth yaw pien dhoga,</para>
  <para style="q2" vid="PSA 51:15">eka dhoga biro hulo pakni.<verse eid="PSA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16"/>Ok imor gi misango mitimoni, nikech dine achiwonigo;</para>
  <para style="q2" vid="PSA 51:16">misango miwangʼo pep ok miyi mor.<verse eid="PSA 51:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17"/>Misango mar Nyasaye en chuny motur,</para>
  <para style="q2" vid="PSA 51:17">chuny motur kendo mamuol,</para>
  <para style="q2" vid="PSA 51:17">ok itamri, yaye Nyasaye.<verse eid="PSA 51:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18"/>Mi Sayun odhi maber kuom herani;</para>
  <para style="q2" vid="PSA 51:18">chak iger ohinga mag Jerusalem kendo.<verse eid="PSA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19"/>Eka ibiro yudo mor kuom misengni mag joma kare,</para>
  <para style="q2" vid="PSA 51:19">kuom misango miwangʼo pep mochiw duto,</para>
  <para style="q2" vid="PSA 51:19">kendo ibiro chiw rwedhi e kendoni mar misango.<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="cl">Zaburi 52</para>
  <para style="d">Kuom jatend wer. <char style="tl">Maskil</char><note caller="+" style="f"><char style="fr" closed="false">52:0 </char><char style="fl" closed="false">Maskil: </char><char style="ft" closed="false">en kit wer moro mane Daudi owero</char></note> mar Daudi. Kane noyudo Doeg ja-Edom nosedhi ir Saulo kendo onyise niya, “Daudi osedhi e od Ahimelek.”</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1"/>Angʼo momiyo isungori kuom tim marach,</para>
  <para style="q2" vid="PSA 52:1">yaye ngʼat maratego?</para>
  <para style="q1" vid="PSA 52:1">Angʼo momiyo isungori odiechiengʼ duto,</para>
  <para style="q2" vid="PSA 52:1">in ma in gir wichkuot e nyim Nyasaye?<verse eid="PSA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2"/>Ichano timbe midwaro wuondogo ji,</para>
  <para style="q2" vid="PSA 52:2">lewi bende chano gik modwaro hinyogo ji;</para>
  <para style="q2" vid="PSA 52:2">kendo lewino chalo gi wembe mabith.<verse eid="PSA 52:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3"/>Ihero rach moloyo ber,</para>
  <para style="q2" vid="PSA 52:3">miriambo mitni moloyo wacho adiera. <char style="qs">Sela</char><verse eid="PSA 52:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4"/>Ihero weche duto machwanyo ji,</para>
  <para style="q2" vid="PSA 52:4">yaye in lep mohero wuondni!<verse eid="PSA 52:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5"/>To Nyasaye biro tieli piny matieki chuth nyaka chiengʼ;</para>
  <para style="q2" vid="PSA 52:5">obiro yudhi mi oyiechi oko e hembi;</para>
  <para style="q2" vid="PSA 52:5">obiro pudhi mi ogoli e piny joma ngima. <char style="qs">Sela</char><verse eid="PSA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6"/>Joma kare biro neno mano mi gibed maluor;</para>
  <para style="q2" vid="PSA 52:6">gibiro nyiere kagiwacho ni,<verse eid="PSA 52:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7"/>“Koro neyeuru ngʼatno,</para>
  <para style="q2" vid="PSA 52:7">mane ok okawo Nyasaye obedo kar pondo mare,</para>
  <para style="q1" vid="PSA 52:7">to nogeno mana kuom mwandune mathoth</para>
  <para style="q2" vid="PSA 52:7">kendo notieko joma moko mondo eka omed bedo gi teko!”<verse eid="PSA 52:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8"/>An to achalo yiend zeituni</para>
  <para style="q2" vid="PSA 52:8">madongo maber e od Nyasaye;</para>
  <para style="q1" vid="PSA 52:8">ageno kuom hera ma ok rem mar Nyasaye</para>
  <para style="q2" vid="PSA 52:8">manyaka chiengʼ.<verse eid="PSA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9"/>Abiro paki nyaka chiengʼ kuom gima isetimo;</para>
  <para style="q2" vid="PSA 52:9">abiro paki e nyim jogi maler.</para>
  <para style="q1" vid="PSA 52:9">Abiro keto geno mara kuom nyingi,</para>
  <para style="q2" vid="PSA 52:9">nikech nyingi ber.<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="cl">Zaburi 53</para>
  <para style="d">Kuom jatend wer. Kaluwore gi dwol mar <char style="tl">mahalath.</char> <char style="tl">Maskil</char><note caller="+" style="f"><char style="fr" closed="false">53:0 </char><char style="fl" closed="false">Maskil: </char><char style="ft" closed="false">en kit wer moro mane Daudi owero</char></note> mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1"/>Ngʼat mofuwo wacho e chunye niya,</para>
  <para style="q2" vid="PSA 53:1">“Nyasaye onge.”</para>
  <para style="q1" vid="PSA 53:1">Gin joma okethore, kendo yoregi obam;</para>
  <para style="q2" vid="PSA 53:1">onge kata ngʼato achiel matimo maber.<verse eid="PSA 53:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2"/>Nyasaye ngʼiyo ji duto gie polo;</para>
  <para style="q2" vid="PSA 53:2">mondo oneye ka bende nitie moro kuomgi ma nigi winjo,</para>
  <para style="q2" vid="PSA 53:2">kata ka bende nitie moro kuomgi mamanyo Nyasaye.<verse eid="PSA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3"/>Giduto gisebaro giweyo yo;</para>
  <para style="q2" vid="PSA 53:3">giduto gisekethore;</para>
  <para style="q1" vid="PSA 53:3">onge ngʼama timo maber,</para>
  <para style="q2" vid="PSA 53:3">onge kata achiel.<verse eid="PSA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4"/>Bende joma timo timbe maricho dipuonjre adier?</para>
  <para style="b" vid="PSA 53:4"/>
  <para style="q1" vid="PSA 53:4">Gin joma kidho joga kaka ji chamo kuon;</para>
  <para style="q2" vid="PSA 53:4">kendo gin joma ok luong Nyasaye mondo okonygi.<verse eid="PSA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5"/>To koro gin ka,</para>
  <para style="q2" vid="PSA 53:5">ka kihondko maduongʼ omakogi,</para>
  <para style="q2" vid="PSA 53:5">kata obedo ni onge gima kelo kihondko.</para>
  <para style="q1" vid="PSA 53:5">Nyasaye osekeyo choke joma nomonji;</para>
  <para style="q2" vid="PSA 53:5">isemiyogi wichkuot,</para>
  <para style="q2" vid="PSA 53:5">nikech Nyasaye nodagigi.<verse eid="PSA 53:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6"/>Yaye, mad warruok mar Israel obi koa Sayun!</para>
  <para style="q2" vid="PSA 53:6">Kinde ma Nyasaye duogo ne joge mwandugi,</para>
  <para style="q2" vid="PSA 53:6">onego joka Jakobo obed moil kendo Israel obed mamor!<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="cl">Zaburi 54</para>
  <para style="d">Kuom jatend wer. Wer miwero gi thumbe man-gi waya. <char style="tl">Maskil</char><note caller="+" style="f"><char style="fr" closed="false">54:0 </char><char style="fl" closed="false">Maskil: </char><char style="ft" closed="false">en kit wer moro mane Daudi owero</char></note> mar Daudi. Kane jo-Zif osedhi ir Saulo kendo onyise niya, “Donge Daudi ma imanyo opondo e gwengʼwa?”</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1"/>Resa gi nyingi, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 54:1">ngʼadna bura kare gi tekoni.<verse eid="PSA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2"/>Winj lamona, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 54:2">chik iti ne weche mawuok e dhoga.<verse eid="PSA 54:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3"/>Jopinje moko monja;</para>
  <para style="q2" vid="PSA 54:3">acheje kawo ngimana,</para>
  <para style="q2" vid="PSA 54:3">gin joma ok dew Nyasaye. <char style="qs">Sela</char><verse eid="PSA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4"/>Adier, Nyasaye e jakonyna;</para>
  <para style="q2" vid="PSA 54:4">Ruoth owuon ema rita.<verse eid="PSA 54:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5"/>Mad chandruok lwor joma ketho nyinga mi ketgi diere;</para>
  <para style="q2" vid="PSA 54:5">tiekgi, nikech in ja-adiera.<verse eid="PSA 54:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6"/>Abiro timoni misango gi chiwo mar hera;</para>
  <para style="q2" vid="PSA 54:6">abiro pako nyingi, yaye Jehova Nyasaye, nikech nyingi ber.<verse eid="PSA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7"/>Nikech oseresa kuom gik mathaga duto,</para>
  <para style="q2" vid="PSA 54:7">mi omiyo wengena ongʼiyo wasika tir bangʼ loyogi.<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="cl">Zaburi 55</para>
  <para style="d">Kuom jatend wer. Wer gi thumbe man-gi Waya. <char style="tl">Maskil</char><note caller="+" style="f"><char style="fr" closed="false">55:0 </char><char style="fl" closed="false">Maskil: </char><char style="ft" closed="false">en kit wer moro mane Daudi owero</char></note> mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1"/>Winj lamona, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 55:1">kik itamri winjo ywakna;<verse eid="PSA 55:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 55:2"/>Winja kendo idwoka.</para>
  <para style="q1" vid="PSA 55:2">Pacha chanda kendo chunya onge gi kwe<verse eid="PSA 55:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 55:3"/>Ka awinjo dwond wasika,</para>
  <para style="q2" vid="PSA 55:3">kendo ka joma timbegi richo okwarona wengegi,</para>
  <para style="q1" vid="PSA 55:3">nikech gimiyo abedo gi thagruok</para>
  <para style="q2" vid="PSA 55:3">kendo giyanya ka gin gi mirima.<verse eid="PSA 55:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4"/>Chunya winjo malit e iya</para>
  <para style="q2" vid="PSA 55:4">kendo luoro mar tho osemaka.<verse eid="PSA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5"/>Aluor kendo denda tetni;</para>
  <para style="q2" vid="PSA 55:5">kibaji ogoya matek.<verse eid="PSA 55:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6"/>Ne awacho niya, “Yaye mad ne bed ni an gi bwombe ka akuru!</para>
  <para style="q2" vid="PSA 55:6">Dine afuyo aa ka mi ayudo yweyo.<verse eid="PSA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7"/>Dine aringo adhi mabor</para>
  <para style="q2" vid="PSA 55:7">mi adhi adak e piny ongoro; <char style="qs">Sela</char><verse eid="PSA 55:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8"/>dine areto adhi nyaka kara mar pondo,</para>
  <para style="q2" vid="PSA 55:8">kuma ni mabor gi apaka kod ahiti.”<verse eid="PSA 55:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9"/>Lal pach joma timbegi richo, yaye Ruoth,</para>
  <para style="q2" vid="PSA 55:9">mi lewgi moki e dandgi,</para>
  <para style="q2" vid="PSA 55:9">nikech aneno ka mahundu gi dhawo opongʼo dala maduongʼ.<verse eid="PSA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10"/>Odiechiengʼ gotieno gilwenyo kor ohinga mare;</para>
  <para style="q2" vid="PSA 55:10">himruok gi ayany ni e iye.<verse eid="PSA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11"/>Teko mar kethruok chopo tijgi ei dala maduongʼ,</para>
  <para style="q2" vid="PSA 55:11">mecho gi wuond osiko e yorene.<verse eid="PSA 55:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12"/>Ka dine ok obedo malichna ka dine ngʼat ma ok dwara ema ogarna,</para>
  <para style="q2" vid="PSA 55:12">to dine apondone.<verse eid="PSA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13"/>To en mana in, dichwo kaka an in jawuodha</para>
  <para style="q2" vid="PSA 55:13">kendo osiepna,<verse eid="PSA 55:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14"/>mane wan-go gi lalruok matut</para>
  <para style="q2" vid="PSA 55:14">chon kane wawuotho e dier oganda maduongʼ e od Nyasaye.<verse eid="PSA 55:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15"/>Mad tho neg wasika apoya,</para>
  <para style="q2" vid="PSA 55:15">mad liel mwonygi ngili kapod gingima,</para>
  <para style="q2" vid="PSA 55:15">nikech richo olokogi kar dakne.<verse eid="PSA 55:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16"/>An to aluongo Nyasaye,</para>
  <para style="q2" vid="PSA 55:16">kendo Jehova Nyasaye resa.<verse eid="PSA 55:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17"/>Odhiambo gi okinyi kod odiechiengʼ</para>
  <para style="q2" vid="PSA 55:17">aywagora ka chunya lit,</para>
  <para style="q2" vid="PSA 55:17">kendo owinjo dwonda.<verse eid="PSA 55:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18"/>Owara kapok gimoro ohinya</para>
  <para style="q2" vid="PSA 55:18">kuom lweny ma ji goyago,</para>
  <para style="q2" vid="PSA 55:18">kata obedo ni ji mangʼeny kweda.<verse eid="PSA 55:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19"/>Nyasaye mobet e kom loch nyaka chiengʼ,</para>
  <para style="q2" vid="PSA 55:19">biro winjogi kendo biro goyogi: <char style="qs">Sela</char></para>
  <para style="q1" vid="PSA 55:19">jogo motamore loko yoregi</para>
  <para style="q2" vid="PSA 55:19">kendo ma ok mi Nyasaye luor.<verse eid="PSA 55:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20"/>Jawuodha monjo osiepene;</para>
  <para style="q2" vid="PSA 55:20">oseketho singruok mane otimo kodgi.<verse eid="PSA 55:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21"/>Weche mowacho to yom ka mo mabuo,</para>
  <para style="q2" vid="PSA 55:21">to lweny to ni e chunye;</para>
  <para style="q1" vid="PSA 55:21">wechege yomo del moloyo mor wirruok,</para>
  <para style="q2" vid="PSA 55:21">to kara gin mana ligangla mosewuodh oko.<verse eid="PSA 55:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22"/>Ket pek manie chunyi ne Jehova Nyasaye</para>
  <para style="q2" vid="PSA 55:22">to obiro riti;</para>
  <para style="q2" vid="PSA 55:22">ok obi weyo ngʼat makare podhi.<verse eid="PSA 55:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23"/>To in, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 55:23">ibiro dwoko joma timbegi richo piny nyaka</para>
  <para style="q2" vid="PSA 55:23">ei bur ma gitow;</para>
  <para style="q1" vid="PSA 55:23">joma joricho machwero remo</para>
  <para style="q2" vid="PSA 55:23">ok bi bet mangima kata moromo nus ndalogi.</para>
  <para style="b" vid="PSA 55:23"/>
  <para style="q1" vid="PSA 55:23">An to ageno kuomi.<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="cl">Zaburi 56</para>
  <para style="d">Kuom jatend wer. E dwol mar “Akuru mopiyo e onera man mabor.” <char style="tl">Miktam</char><note caller="+" style="f"><char style="fr" closed="false">56:0 </char><char style="fl" closed="false">Miktam: </char><char style="ft" closed="false">Ochalo ni en kit wer moro</char></note> mar Daudi. Kane jo-Filistia osemake Gath.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1"/>Kecha, yaye Nyasacha,</para>
  <para style="q2" vid="PSA 56:1">nikech wasika dwaro monja;</para>
  <para style="q2" vid="PSA 56:1">odiechiengʼ duto gidiya ma ok aywe.<verse eid="PSA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2"/>Joketh nyinga lawa odiechiengʼ duto;</para>
  <para style="q2" vid="PSA 56:2">ji mangʼeny monja ka sunga omakogi.<verse eid="PSA 56:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3"/>Ka luoro omaka</para>
  <para style="q2" vid="PSA 56:3">to abiro geno kuomi.<verse eid="PSA 56:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4"/>Kuom Nyasaye ma apako wachne,</para>
  <para style="q2" vid="PSA 56:4">in Nyasaye ema aketo genona kuomi omiyo ok abi bedo maluor.</para>
  <para style="q2" vid="PSA 56:4">Dhano adhana to nyalo timona angʼo?<verse eid="PSA 56:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5"/>Odiechiengʼ duto gimino koda wach;</para>
  <para style="q2" vid="PSA 56:5">kinde duto gichano kaka digihinya.<verse eid="PSA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6"/>Gikuotho kendo gijimbo wach,</para>
  <para style="q2" vid="PSA 56:6">ginono okangʼ ka okangʼ ma agoyo,</para>
  <para style="q2" vid="PSA 56:6">ka gidwaro kawo ngimana.<verse eid="PSA 56:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7"/>Kik iyie gitony kata matin nikech richo mag-gi,</para>
  <para style="q2" vid="PSA 56:7">dwok ogendini piny, yaye Nyasaye, gi mirimbi;<verse eid="PSA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8"/>Ndik ywak ma aywakgo</para>
  <para style="q2" vid="PSA 56:8">kwan pi wangʼa machwer e kitapi,</para>
  <para style="q2" vid="PSA 56:8">donge iketogi e kitabu mari?<verse eid="PSA 56:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9"/>Eka wasika biro gomo dok</para>
  <para style="q2" vid="PSA 56:9">ka aluongo kony moa kuomi.</para>
  <para style="q2" vid="PSA 56:9">Mano ema abiro ngʼeyogo ni Nyasaye en jakora.<verse eid="PSA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10"/>Kuom Nyasaye ma apako wachne,</para>
  <para style="q2" vid="PSA 56:10">in Jehova Nyasaye ema apako wachne,<verse eid="PSA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11"/>kendo Nyasaye ema aketo genona kuome;</para>
  <para style="q2" vid="PSA 56:11">omiyo ok abi bedo maluor.</para>
  <para style="q2" vid="PSA 56:11">Dhano adhana to nyalo timona angʼo?<verse eid="PSA 56:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12"/>Asetimo kodi singruok, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 56:12">abiro chiwoni chiwo maga mag erokamano.<verse eid="PSA 56:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13"/>Nikech iseresa e tho</para>
  <para style="q2" vid="PSA 56:13">kendo isegengʼo tienda mi ok ochwanyore,</para>
  <para style="q1" vid="PSA 56:13">mondo mi awuothi e nyim Nyasaye</para>
  <para style="q2" vid="PSA 56:13">ma en e ler makelo ngima.<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="cl">Zaburi 57</para>
  <para style="d">Kuom jatend wer. E dwond “Kik iketh gik moko.” <char style="tl">Miktam</char><note caller="+" style="f"><char style="fr" closed="false">57:0 </char><char style="fl" closed="false">Miktam: </char><char style="ft" closed="false">Ochalo ni en kit wer moro</char></note> mar Daudi. Kane oringone Saulo mi opondo e rogo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1"/>Kecha, yaye Nyasaye, yie ikecha</para>
  <para style="q2" vid="PSA 57:1">nikech kuomi ema chunya yudoe kar pondo.</para>
  <para style="q1" vid="PSA 57:1">Abiro pondo e bwo tipo mar bwombeni</para>
  <para style="q2" vid="PSA 57:1">nyaka chop apaka mager rum.<verse eid="PSA 57:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2"/>Aywagora ne Nyasaye Man Malo Moloyo,</para>
  <para style="q2" vid="PSA 57:2">Nyasaye machopona chenroge ema aywakne.<verse eid="PSA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3"/>Ooro wach gie polo kendo oresa,</para>
  <para style="q2" vid="PSA 57:3">kokwero joma lawa gi tekregi duto; <char style="qs">Sela</char></para>
  <para style="q2" vid="PSA 57:3">Nyasaye oro herane gi adiera mare.<verse eid="PSA 57:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4"/>An e dier sibuoche;</para>
  <para style="q2" vid="PSA 57:4">anindo e dier le mager mangemo,</para>
  <para style="q1" vid="PSA 57:4">joma lekegi chalo tonge gi aserni,</para>
  <para style="q2" vid="PSA 57:4">ma lewgi chalo ligangla mabitho.<verse eid="PSA 57:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5"/>Nyingi mondo otingʼ malo moyombo polo, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 57:5">mad duongʼ mari opongʼ piny duto.<verse eid="PSA 57:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6"/>Ne giyaro jogo mondo omak tiendena,</para>
  <para style="q2" vid="PSA 57:6">kane chuny lit odola.</para>
  <para style="q1" vid="PSA 57:6">Ne gikunyo bugo e yora,</para>
  <para style="q2" vid="PSA 57:6">to kata kamano gin giwegi ema giselutore e iye. <char style="qs">Sela</char><verse eid="PSA 57:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7"/>Chunya otegno, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 57:7">chunya otegno;</para>
  <para style="q2" vid="PSA 57:7">abiro paki gi wer kendo abiro loso wer mamit.<verse eid="PSA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8"/>Chiew, in chunya!</para>
  <para style="q2" vid="PSA 57:8">Chiewuru un orutu gi nyatiti!</para>
  <para style="q2" vid="PSA 57:8">Abiro chiewo kogwen.<verse eid="PSA 57:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9"/>Abiro paki e dier ogendini, yaye Jehova Nyasaye.</para>
  <para style="q2" vid="PSA 57:9">Abiro werni e dier ogendini.<verse eid="PSA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10"/>Nikech herani maduongʼ chopo nyaka e polo;</para>
  <para style="q2" vid="PSA 57:10">kendo adiera mari chopo nyaka ewi lwasi.<verse eid="PSA 57:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11"/>Nyingi mondo otingʼ malo moyombo polo, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 57:11">mad duongʼ mari opongʼ piny duto.<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="cl">Zaburi 58</para>
  <para style="d">Kuom jatend wer. E dwol mar “Kik iketh gik moko.” <char style="tl">Miktam</char><note caller="+" style="f"><char style="fr" closed="false">58:0 </char><char style="fl" closed="false">Miktam: </char><char style="ft" closed="false">Ochalo ni en kit wer moro</char></note> mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1"/>Un jotelo, bende uwuoyo gi adiera?</para>
  <para style="q2" vid="PSA 58:1">Bende ungʼado bura moriere tir e dier ji?<verse eid="PSA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2"/>Ooyo, uchano mayo ji ratiro magi e chunyu,</para>
  <para style="q2" vid="PSA 58:2">kendo lwetu chano kelo dhawo e piny.<verse eid="PSA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3"/>Joma timbegi richo chako lal ae nywolgi;</para>
  <para style="q2" vid="PSA 58:3">gin jo-jendeke kendo gin jo-miriambo aa nywolgi.<verse eid="PSA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4"/>Kwiri margi chalo gi kwich thuol,</para>
  <para style="q2" vid="PSA 58:4">chalo gi kwich thuond rachier ma tege oyienyo,<verse eid="PSA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5"/>ma kata ja-bochne wuone to ok owinji,</para>
  <para style="q2" vid="PSA 58:5">kata bed ni ja-bochneno olony machal nadi.<verse eid="PSA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6"/>Muk lekegi ei dhogi, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 58:6">yiech kwiri mag sibuoche oko, yaye Jehova Nyasaye!<verse eid="PSA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7"/>Mi gilal nono ka pi mamol;</para>
  <para style="q2" vid="PSA 58:7">ka giywayo atungegi to mi asernigi obed madik.<verse eid="PSA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8"/>Mana kaka ndach kamnie maleny nono,</para>
  <para style="q2" vid="PSA 58:8">kendo mana kaka nyathi monywol kosetho,</para>
  <para style="q2" vid="PSA 58:8">mad kik gine wangʼ chiengʼ.<verse eid="PSA 58:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9"/>Kapok agulni magi ochako winjo liet mach,</para>
  <para style="q2" vid="PSA 58:9">bed ni en mach mabebni kata maliel mos,</para>
  <para style="q2" vid="PSA 58:9">to joma timbegi richo ibiro ywe oko.<verse eid="PSA 58:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10"/>Joma kare biro bedo mamor kichulonigi kuor,</para>
  <para style="q2" vid="PSA 58:10">ka giniluok tiendegi e remb joma timbegi richo.<verse eid="PSA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11"/>Eka ji nowach niya,</para>
  <para style="q2" vid="PSA 58:11">“Kara en adier ni joma kare pod yudo pok;</para>
  <para style="q2" vid="PSA 58:11">kara nitie Nyasaye mangʼado bura ne piny.”<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="cl">Zaburi 59</para>
  <para style="d">Kuom jatend wer. E dwol mar “Kik iketh gik moko.” <char style="tl">Miktam</char><note caller="+" style="f"><char style="fr" closed="false">59:0 </char><char style="fl" closed="false">Miktam: </char><char style="ft" closed="false">Ochalo ni en kit wer moro</char></note> mar Daudi. Kane Saulo ooro ji mondo ocher od Daudi mondo onege.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1"/>Resa e lwet wasika, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 59:1">Rit ngimana kuom joma ogar koda.<verse eid="PSA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2"/>Gola e lwet joma timo gik maricho</para>
  <para style="q2" vid="PSA 59:2">kendo resa kuom joma riyo mar chwero remo omako.<verse eid="PSA 59:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3"/>Neye kaka gibutona ka girita e yo!</para>
  <para style="q2" vid="PSA 59:3">Joma kwiny chano kaka digihinya,</para>
  <para style="q2" vid="PSA 59:3">to an onge gima rach kata richo masetimo, yaye Jehova Nyasaye.<verse eid="PSA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4"/>Onge gima asetimo marach,</para>
  <para style="q2" vid="PSA 59:4">to kata kamano gin to giikore monja.</para>
  <para style="q2" vid="PSA 59:4">Aa malo ikonya; ne chandruokna.<verse eid="PSA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5"/>Yaye Jehova Nyasaye, ma Nyasaye Maratego,</para>
  <para style="q2" vid="PSA 59:5">in Nyasach Israel,</para>
  <para style="q1" vid="PSA 59:5">aa malo ikum ogendini duto;</para>
  <para style="q2" vid="PSA 59:5">kik ikech andhoke ma timbegi richo. <char style="qs">Sela</char><verse eid="PSA 59:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6"/>Gidwogo ka piny imore,</para>
  <para style="q2" vid="PSA 59:6">ka gingʼur ka guogi,</para>
  <para style="q2" vid="PSA 59:6">kendo giwuotho koni gi koni e dala ka gingʼanjo.<verse eid="PSA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7"/>Neye gik ma gingʼudho koa e dhogi,</para>
  <para style="q2" vid="PSA 59:7">gingʼudho ligengni gi dhogi,</para>
  <para style="q2" vid="PSA 59:7">kendo giwacho niya, “En ngʼa manyalo winjowa?”<verse eid="PSA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8"/>To in nyiergi, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 59:8">go siboi ne ogendinigo duto.<verse eid="PSA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9"/>Yaye tekona, in ema angʼiyi,</para>
  <para style="q2" vid="PSA 59:9">in e kar pondona, yaye Nyasaye,<verse eid="PSA 59:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 59:10"/>Yaye Nyasacha ma jahera.</para>
  <para style="b" vid="PSA 59:10"/>
  <para style="q1" vid="PSA 59:10">Nyasaye biro telona</para>
  <para style="q2" vid="PSA 59:10">kendo obiro miyo asungra ne joma ketho nyinga.<verse eid="PSA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11"/>To kik uneg-gi, yaye Ruoth ma okumbana</para>
  <para style="q2" vid="PSA 59:11">nikech joga dipoka wigi owil.</para>
  <para style="q1" vid="PSA 59:11">Mi giba abaya koni gi koni gi tekoni,</para>
  <para style="q2" vid="PSA 59:11">kendo mi gidog piny.<verse eid="PSA 59:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12"/>Nikech richo ma gitimo gi dhogi kuom wuoyo,</para>
  <para style="q2" vid="PSA 59:12">nikech weche mawuok e dhogi,</para>
  <para style="q2" vid="PSA 59:12">wegi mondo sungagi ogajgi.</para>
  <para style="q1" vid="PSA 59:12">Nikech gikwongʼo ji kendo gi wuondo ji,<verse eid="PSA 59:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 59:13"/>tiekgi gi mirimbi mager,</para>
  <para style="q2" vid="PSA 59:13">tiekgi mi kargi lal nono,</para>
  <para style="q1" vid="PSA 59:13">eka biro ngʼere e tungʼ piny koni gi koni</para>
  <para style="q2" vid="PSA 59:13">ni Nyasaye nigi loch kuom joka Jakobo. <char style="qs">Sela</char><verse eid="PSA 59:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14"/>Gidwogo ka piny imore</para>
  <para style="q2" vid="PSA 59:14">ka gingʼur ka guogi,</para>
  <para style="q2" vid="PSA 59:14">kendo giwuotho koni gi koni e dala ka gingʼanjo.<verse eid="PSA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15"/>Gibayo koni gi koni ka gidwaro chiemo</para>
  <para style="q2" vid="PSA 59:15">kendo ka ok giyiengʼ to gingʼur.<verse eid="PSA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16"/>Anto abiro wer kuom tekoni</para>
  <para style="q2" vid="PSA 59:16">abiro wero herani gokinyi;</para>
  <para style="q1" vid="PSA 59:16">nikech in e ohingana,</para>
  <para style="q2" vid="PSA 59:16">in e kar pondona e kinde mag thagruok.<verse eid="PSA 59:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17"/>In e tekona, omiyo abiro weroni wend pak;</para>
  <para style="q2" vid="PSA 59:17">in e ohingana, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 59:17">in e Nyasacha ma jahera.<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="cl">Zaburi 60</para>
  <para style="d">Kuom jatend wer. E dwol mar “Ondanyo mar singruok.” <char style="tl">Miktam</char><note caller="+" style="f"><char style="fr" closed="false">60:0 </char><char style="fl" closed="false">Miktam: </char><char style="ft" closed="false">Ochalo ni en kit wer moro</char></note> mar Daudi. Mar puonjo. Kane okedo gi Aram-Naharaim kod Aram Zoba, kendo kane Joab odwogo mi onego jo-Edom alufu apar gariyo e Holo mar Chumbi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1"/>Yaye Nyasaye, isedagiwa mi imuomori kuomwa;</para>
  <para style="q1" vid="PSA 60:1">isebedo ka ikecho kodwa, to koro loswa!<verse eid="PSA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2"/>Iseyiengo piny mi ibare diere ariyo,</para>
  <para style="q2" vid="PSA 60:2">Los kuondene mosebarore, nikech oyiengni.<verse eid="PSA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3"/>Isenyiso jogi kinde mag chandruok mapek;</para>
  <para style="q2" vid="PSA 60:3">isemiyowa kongʼo mamiyo wakwangʼ.<verse eid="PSA 60:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4"/>To isechungo bandech loch ni joma oluori</para>
  <para style="q2" vid="PSA 60:4">mondo oumgi ka oywanegi atungʼ. <char style="qs">Sela</char><verse eid="PSA 60:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5"/>Reswa kendo konywa gi lweti ma korachwich</para>
  <para style="q2" vid="PSA 60:5">mondo joma ihero ogol e chandruok.<verse eid="PSA 60:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 60:6"/>Nyasaye osewuoyo gie kare maler kowacho niya,</para>
  <para style="q2" vid="PSA 60:6">“Abiro pogo Shekem ne ji,</para>
  <para style="q2" vid="PSA 60:6">kendo abiro pimo ne ji Holo mar Sukoth.<verse eid="PSA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7"/>Gilead en mara, Manase bende mara;</para>
  <para style="q2" vid="PSA 60:7">Efraim en oguta mar lweny,</para>
  <para style="q2" vid="PSA 60:7">to Juda en osimbona mar loch.<verse eid="PSA 60:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8"/>Moab en besen mara mar luok,</para>
  <para style="q2" vid="PSA 60:8">to Edom e kama amoe wuochena;</para>
  <para style="q2" vid="PSA 60:8">Filistia ema akoke ka aseloyo lweny.”<verse eid="PSA 60:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9"/>En ngʼa mabiro kela e dala maduongʼ mochiel motegno?</para>
  <para style="q2" vid="PSA 60:9">Ngʼa mabiro telona nyaka Edom?<verse eid="PSA 60:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10"/>Donge in ema isedagiwa, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 60:10">kendo tinde ok idhi gi jolwenjwa e lweny?<verse eid="PSA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11"/>Miwa kony mondo walo wasikwa,</para>
  <para style="q2" vid="PSA 60:11">nikech kony mar dhano onge tich.<verse eid="PSA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12"/>Wabiro loyo lweny ka Nyasaye nikodwa,</para>
  <para style="q2" vid="PSA 60:12">kendo obiro nyono wasikwa piny.<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="cl">Zaburi 61</para>
  <para style="d">Kuom jatend wer. Gi gig wer man-gi tondegi. Mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1"/>Winj ywakna, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 61:1">chik iti ne lamona.<verse eid="PSA 61:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2"/>Aluongi gie tungʼ piny,</para>
  <para style="q2" vid="PSA 61:2">aluongi ka chunya ool;</para>
  <para style="q2" vid="PSA 61:2">telna nyaka lwanda mohinga gi bor.<verse eid="PSA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3"/>Nikech in ema isebedo kar pondona,</para>
  <para style="q2" vid="PSA 61:3">isebedona ohinga motegno maponde ne jasigu.<verse eid="PSA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4"/>Agombo dak e hembi nyaka chiengʼ</para>
  <para style="q2" vid="PSA 61:4">mondo apondie e raum mar bwombeni. <char style="qs">Sela</char><verse eid="PSA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5"/>Nikech isewinjo singruokna kodi, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 61:5">isemiya gweth mikano ne joma oluoro nyingi.<verse eid="PSA 61:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6"/>Med ndalo mar ngima ruoth,</para>
  <para style="q2" vid="PSA 61:6">mede higni e tienge mangʼeny.<verse eid="PSA 61:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7"/>Mi obed e kom loch e nyim Nyasaye nyaka chiengʼ;</para>
  <para style="q2" vid="PSA 61:7">ket herani kod adierani mondo orite.<verse eid="PSA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8"/>Eka anasik ka apako nyingi gi wer</para>
  <para style="q2" vid="PSA 61:8">kendo abiro chopo singruokna kodi odiechiengʼ kodiechiengʼ.<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="cl">Zaburi 62</para>
  <para style="d">Kuom jatend wer. Mar Jeduthun. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1"/>Chunya yudo yweyo kuom Nyasaye kende;</para>
  <para style="q2" vid="PSA 62:1">warruok aa kuome.<verse eid="PSA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2"/>En kende ema en lwandana kendo warruokna;</para>
  <para style="q2" vid="PSA 62:2">en e ohingana, onge gima biro bwoga.<verse eid="PSA 62:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3"/>Ubiro siko kumonjo ngʼat achielni nyaka karangʼo?</para>
  <para style="q2" vid="PSA 62:3">Angʼo momiyo uduto unywakone mondo ugoye piny?</para>
  <para style="q2" vid="PSA 62:3">En ngʼat machalo mana gi chiel mayiengni madwaro mukore.<verse eid="PSA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4"/>Giramo ni nyaka to gigole oko</para>
  <para style="q2" vid="PSA 62:4">kama entie e duongʼne;</para>
  <para style="q2" vid="PSA 62:4">miriambo ema morogi.</para>
  <para style="q1" vid="PSA 62:4">Dhogi gigwedhogo ji,</para>
  <para style="q2" vid="PSA 62:4">to gi ei chunygi to gikwongʼo ji. <char style="qs">Sela</char><verse eid="PSA 62:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5"/>Yud yweyo, yaye chunya, kuom Nyasaye kende;</para>
  <para style="q2" vid="PSA 62:5">genona aa mana kuome.<verse eid="PSA 62:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6"/>En kende ema en lwandana kendo warruokna;</para>
  <para style="q2" vid="PSA 62:6">en e ohingana; onge gima biro bwoga.<verse eid="PSA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7"/>Warruok mara gi luor ma ayudo aa kuom Nyasaye;</para>
  <para style="q2" vid="PSA 62:7">en e lwandana manyalo duto, en e kar pondona.<verse eid="PSA 62:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8"/>Un ji, genuru kuome kinde duto;</para>
  <para style="q2" vid="PSA 62:8">olneuru oko gik manie chunyu,</para>
  <para style="q2" vid="PSA 62:8">nikech Nyasaye e kar pondo marwa. <char style="qs">Sela</char><verse eid="PSA 62:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9"/>Joma nipiny gin mana muya nono;</para>
  <para style="q2" vid="PSA 62:9">joma ni malo gin mana miriambo;</para>
  <para style="q1" vid="PSA 62:9">ka opimgi e ratil, to gin nono;</para>
  <para style="q2" vid="PSA 62:9">gin duto gin mana muya nono.<verse eid="PSA 62:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10"/>Kik igen kuom mwandu moma ji</para>
  <para style="q2" vid="PSA 62:10">kata isungri kuom gik mokwal;</para>
  <para style="q1" vid="PSA 62:10">kata bed ni mwandugi medore</para>
  <para style="q2" vid="PSA 62:10">to kik iket chunyi kuomgi.<verse eid="PSA 62:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11"/>Nitie gimoro achiel ma Nyasaye osewacho,</para>
  <para style="q2" vid="PSA 62:11">chutho nitie gik moko ariyo ma asewinjo gi ita:</para>
  <para style="q1" vid="PSA 62:11">ni in, yaye Nyasaye, in ratego,<verse eid="PSA 62:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 62:12"/>kendo ni in, yaye Ruoth Nyasaye, ihero ji.</para>
  <para style="q1" vid="PSA 62:12">Kuom adier, ibiro chiwo pok ne ngʼato ka ngʼato</para>
  <para style="q2" vid="PSA 62:12">kaluwore gi gima osetimo.<verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="cl">Zaburi 63</para>
  <para style="d">Zaburi mar Daudi kane en e thim mar Juda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1"/>Yaye Nyasaye, in e Nyasacha,</para>
  <para style="q2" vid="PSA 63:1">adwari gi tekra duto;</para>
  <para style="q1" vid="PSA 63:1">chunya riyo oloyo mar neni</para>
  <para style="q2" vid="PSA 63:1">kendo denda duto dwari,</para>
  <para style="q1" vid="PSA 63:1">e piny motwo kendo maliet,</para>
  <para style="q2" vid="PSA 63:1">maonge pi modho.<verse eid="PSA 63:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2"/>Aseneni ei kari maler</para>
  <para style="q2" vid="PSA 63:2">kendo asengʼeyo tekoni gi duongʼni.<verse eid="PSA 63:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3"/>Nikech herani ber moloyo ngima,</para>
  <para style="q2" vid="PSA 63:3">dhoga biro miyi duongʼ.<verse eid="PSA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4"/>Abiro paki kapod angima,</para>
  <para style="q2" vid="PSA 63:4">kendo abiro tingʼo bedena malo e nyingi.<verse eid="PSA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5"/>Chunya biro romo mana ka ngʼama oromo gi chiemo mabeyo mogik;</para>
  <para style="q2" vid="PSA 63:5">abiro yawo dwonda ka apaki gi wer.<verse eid="PSA 63:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6"/>Ka an e kitandana to apari;</para>
  <para style="q2" vid="PSA 63:6">pacha osiko pari seche duto mag otieno.<verse eid="PSA 63:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7"/>Nikech in e konyruokna,</para>
  <para style="q2" vid="PSA 63:7">awer ka an e bwo tipo mar bwombeni.<verse eid="PSA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8"/>Chunya omoko kuomi;</para>
  <para style="q2" vid="PSA 63:8">lweti ma korachwich orita.<verse eid="PSA 63:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9"/>Joma dwaro kawo ngimana ibiro tieki;</para>
  <para style="q2" vid="PSA 63:9">gibiro dhi piny nyaka ei bur kama tut.<verse eid="PSA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10"/>Ibiro chiwgi ne ligangla</para>
  <para style="q2" vid="PSA 63:10">kendo gibiro doko chiemb ondiegi.<verse eid="PSA 63:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11"/>To ruoth to biro bedo moil kuom Nyasaye;</para>
  <para style="q2" vid="PSA 63:11">ji duto masingore e nying Nyasaye biro pake,</para>
  <para style="q2" vid="PSA 63:11">to dho jo-miriambo ibiro um mi lingʼ.<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="cl">Zaburi 64</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1"/>Winja, Yaye Nyasaye e kinde manyisi chandruokna;</para>
  <para style="q2" vid="PSA 64:1">rit ngimana kuom jasigu ma bwoga.<verse eid="PSA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2"/>Panda ne chenro maricho mag joma richo,</para>
  <para style="q2" vid="PSA 64:2">panda ne koko ma oganda matimo marach goyo.<verse eid="PSA 64:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3"/>Gipiago lewgi ka ligangla</para>
  <para style="q2" vid="PSA 64:3">kendo gichimo wechegi ka asere motimo sum.<verse eid="PSA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4"/>Gidiro asere kama giponde mondo gichwogo ngʼama onge ketho;</para>
  <para style="q2" vid="PSA 64:4">gibaye gi asere apoya ka gionge luoro.<verse eid="PSA 64:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5"/>Gijiwore ngʼato gi ngʼato kuom chenrogi maricho,</para>
  <para style="q2" vid="PSA 64:5">giwuoyo kaka ginyalo pando obadhogi,</para>
  <para style="q2" vid="PSA 64:5">kagiwacho niya, “En ngʼa mabiro nenogi?”<verse eid="PSA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6"/>Gichano timo ne ji marach kagiwacho niya,</para>
  <para style="q2" vid="PSA 64:6">“Waseloso chenro malongʼo chuth!”</para>
  <para style="q2" vid="PSA 64:6">Kuom adier, pach dhano gi chunye opando riekni maricho miwuoro.<verse eid="PSA 64:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7"/>To Nyasaye biro bayogi gi aserni;</para>
  <para style="q2" vid="PSA 64:7">apoya nono, ibiro puodgi piny.<verse eid="PSA 64:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8"/>Obiro loko lewgi mi gogi gin giwegi</para>
  <para style="q2" vid="PSA 64:8">mi otiekgi chuth;</para>
  <para style="q2" vid="PSA 64:8">ji duto monenogi biro kino wigi gi wuoro.<verse eid="PSA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9"/>Ji duto biro bedo maluor,</para>
  <para style="q2" vid="PSA 64:9">gibiro hulo tije Nyasaye,</para>
  <para style="q2" vid="PSA 64:9">kendo gibiro paro mos kuom gima osetimo.<verse eid="PSA 64:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10"/>Joma kare mondo obed moil kuom Jehova Nyasaye</para>
  <para style="q2" vid="PSA 64:10">kendo gipondo kuome;</para>
  <para style="q2" vid="PSA 64:10">ji duto moriere tir gie chunygi mondo opake!<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="cl">Zaburi 65</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi. Wer.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1"/>Pak riti e dala mar Sayun, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 65:1">wabiro rito singruokwa duto.<verse eid="PSA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2"/>Yaye in miwinjo lamo,</para>
  <para style="q2" vid="PSA 65:2">in ema ji duto biro biro iri.<verse eid="PSA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3"/>Kane richowa turowa,</para>
  <para style="q2" vid="PSA 65:3">iweyonwa kethowa.<verse eid="PSA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4"/>Joma iyiero gin joma ogwedhi,</para>
  <para style="q2" vid="PSA 65:4">jogo ma ikelo machiegni mondo odag e hekalu mari!</para>
  <para style="q1" vid="PSA 65:4">Gik mabeyo mowuok e odi oromowa chuth,</para>
  <para style="q2" vid="PSA 65:4">mana gigo moa e hekalu mari maler.<verse eid="PSA 65:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5"/>Idwokowa gi timbe madongo makare,</para>
  <para style="q2" vid="PSA 65:5">yaye Nyasaye ma Jawarwa,</para>
  <para style="q1" vid="PSA 65:5">yaye geno mar piny koni gi koni</para>
  <para style="q2" vid="PSA 65:5">kendo mar nembe man maboyo mogik,<verse eid="PSA 65:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6"/>in mane iloso gode gi tekoni iwuon</para>
  <para style="q2" vid="PSA 65:6">kane imanori gi teko,<verse eid="PSA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7"/>in mane imiyo nembe olingʼ,</para>
  <para style="q2" vid="PSA 65:7">wuo mar apaka margi,</para>
  <para style="q2" vid="PSA 65:7">kod koko mag ogendini.<verse eid="PSA 65:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8"/>Joma odak kuonde maboyo oluoro timbeni miwuoro,</para>
  <para style="q2" vid="PSA 65:8">imiyo ji werni gimor,</para>
  <para style="q2" vid="PSA 65:8">kuma okinyi yaworee kendo odhiambo rumoe.<verse eid="PSA 65:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9"/>Irito piny kendo iolone pi,</para>
  <para style="q2" vid="PSA 65:9">imiyo obedo momew moromo chuth.</para>
  <para style="q1" vid="PSA 65:9">Aore mag Nyasaye opongʼ gi pi</para>
  <para style="q2" vid="PSA 65:9">mamiyo ji bedo gi cham,</para>
  <para style="q2" vid="PSA 65:9">nimar kamano e kaka ne ichano chon.<verse eid="PSA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10"/>Ipuro puothene</para>
  <para style="q2" vid="PSA 65:10">kendo iloso oparane duto.</para>
  <para style="q1" vid="PSA 65:10">Imiyo puothene bedo mangʼich,</para>
  <para style="q2" vid="PSA 65:10">kendo igwedhe gi cham.<verse eid="PSA 65:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11"/>Igwedho higa gi cham mogundho,</para>
  <para style="q2" vid="PSA 65:11">kendo gechegi mwandu opongʼo.<verse eid="PSA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12"/>Pewe motimo lum mag piny ongoro ngʼich oromo;</para>
  <para style="q2" vid="PSA 65:12">kendo gode opongʼ gi mor.<verse eid="PSA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13"/>Lek duto jamni kwaye ka giwinjo maber</para>
  <para style="q2" vid="PSA 65:13">kendo holni cham mochiek odhure;</para>
  <para style="q2" vid="PSA 65:13">gikok gimor kendo giwer.<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="cl">Zaburi 66</para>
  <para style="d">Kuom jatend wer. Wer. Zaburi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1"/>Go koko gi mor ne Nyasaye, in piny duto!<verse eid="PSA 66:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 66:2"/>Wer kipako duongʼ mar nyinge;</para>
  <para style="q2" vid="PSA 66:2">mi pakne obed gi duongʼ!<verse eid="PSA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3"/>Wachne Nyasaye niya, “Mano kaka timbe mitimo dongo!</para>
  <para style="q2" vid="PSA 66:3">Tekoni duongʼ manade,</para>
  <para style="q2" vid="PSA 66:3">mamiyo wasiki duto leny nono koneni.<verse eid="PSA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4"/>Piny duto kuloreni;</para>
  <para style="q2" vid="PSA 66:4">giweroni wende pak;</para>
  <para style="q2" vid="PSA 66:4">giwero wende pak ka gipako nyingi.” <char style="qs">Sela</char><verse eid="PSA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5"/>Biuru uneye gik ma Nyasaye osetimo;</para>
  <para style="q2" vid="PSA 66:5">bi uneye kaka gik motimo ne dhano dongo!<verse eid="PSA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6"/>Ne oloko nam lo motwo,</para>
  <para style="q2" vid="PSA 66:6">mine gikalo pige ka giwuotho gi tiendegi,</para>
  <para style="q2" vid="PSA 66:6">Biuru mondo wabed moil kuome.<verse eid="PSA 66:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7"/>Olocho nyaka chiengʼ gi teko ne,</para>
  <para style="q2" vid="PSA 66:7">wengene ema rito ogendini.</para>
  <para style="q2" vid="PSA 66:7">Omiyo kik jongʼanyo hedhre mar kedo kode. <char style="qs">Sela</char><verse eid="PSA 66:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8"/>Pakuru Nyasachwa, yaye ogendini,</para>
  <para style="q2" vid="PSA 66:8">neuru ni pak mipakego ji duto owinjo;<verse eid="PSA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9"/>oserito ngimawa</para>
  <para style="q2" vid="PSA 66:9">kendo osegengʼo tiendewa ni kik kier.<verse eid="PSA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10"/>Yaye Nyasaye ne itemowa ni in iwuon;</para>
  <para style="q2" vid="PSA 66:10">ne ipwodhowa ka fedha.<verse eid="PSA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11"/>Ne iterowa e od twech</para>
  <para style="q2" vid="PSA 66:11">kendo ne iketo lodi mapek e dier ngʼewa.<verse eid="PSA 66:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12"/>Ne imiyo ji onyono wiyewa;</para>
  <para style="q2" vid="PSA 66:12">kendo ne wakalo mach gi pi,</para>
  <para style="q2" vid="PSA 66:12">kata kamano ne ikelowa nyaka kama omew.<verse eid="PSA 66:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13"/>Abiro biro e hekalu mari gi misango miwangʼo pep</para>
  <para style="q2" vid="PSA 66:13">kendo abiro chopo kwongʼruok masetimo kodi.<verse eid="PSA 66:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14"/>Kwongʼruok mane asingoni e chunya kendo awacho gi dhoga</para>
  <para style="q2" vid="PSA 66:14">kane an e thagruok.<verse eid="PSA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15"/>Abiro timoni misango gi jamni machwe</para>
  <para style="q2" vid="PSA 66:15">kendo abiro miyi chiwo mar imbe;</para>
  <para style="q2" vid="PSA 66:15">bende abiro chiwoni rwedhi gi diek. <char style="qs">Sela</char><verse eid="PSA 66:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16"/>Biuru uchik itu, un duto muluoro Nyasaye;</para>
  <para style="q2" vid="PSA 66:16">we anyisue gik ma osetimona.<verse eid="PSA 66:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17"/>Ne aywakne gi dhoga;</para>
  <para style="q2" vid="PSA 66:17">pakne ne ni e lewa.<verse eid="PSA 66:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18"/>Ka dine bed ni amor gi richo manie chunya,</para>
  <para style="q2" vid="PSA 66:18">to Ruoth dine ok ochikona ite,<verse eid="PSA 66:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19"/>to kuom adier, Nyasaye osechikona ite</para>
  <para style="q2" vid="PSA 66:19">kendo osewinjo dwonda ka alame.<verse eid="PSA 66:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20"/>Pak obed ne Nyasaye,</para>
  <para style="q2" vid="PSA 66:20">ma ok osedagi lamona,</para>
  <para style="q2" vid="PSA 66:20">kata golo herane kuoma.<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="cl">Zaburi 67</para>
  <para style="d">Kuom jatend wer. Gik miwergo man-gi tondegi. Zaburi. Wer.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1"/>Mad Nyasaye timnwa ngʼwono kendo owinjwa;</para>
  <para style="q2" vid="PSA 67:1">mad omi wangʼe rienynwa maber, <char style="qs">Sela</char><verse eid="PSA 67:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2"/>mondo yoreni ongʼere e piny,</para>
  <para style="q2" vid="PSA 67:2">kendo ogendini duto oyud warruokne.<verse eid="PSA 67:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3"/>Mad ji paki, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 67:3">mad ji duto opaki.<verse eid="PSA 67:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4"/>Mad ogendini obed mamor kendo ower gi ilo,</para>
  <para style="q2" vid="PSA 67:4">nikech irito ji gi ratiro,</para>
  <para style="q2" vid="PSA 67:4">kendo itayo ogendini mag piny. <char style="qs">Sela</char><verse eid="PSA 67:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5"/>Mad ji paki, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 67:5">mad ji duto opaki.<verse eid="PSA 67:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6"/>Eka piny biro chiego cham kaka owinjore</para>
  <para style="q2" vid="PSA 67:6">kendo Nyasaye, ma Nyasachwa, biro gwedhowa.<verse eid="PSA 67:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7"/>Nyasaye biro gwedhowa,</para>
  <para style="q2" vid="PSA 67:7">kendo piny duto koni gi koni biro luore.<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="cl">Zaburi 68</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi. Wer.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1"/>Mad Nyasaye aa malo, mad wasike ke;</para>
  <para style="q2" vid="PSA 68:1">mad joma kedo kode ring konene.<verse eid="PSA 68:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2"/>Mad iriembgi gi dhi mabor,</para>
  <para style="q2" vid="PSA 68:2">mana kaka yamo riembo iro tero mabor;</para>
  <para style="q1" vid="PSA 68:2">mad joma timbegi richo lal nono e nyim Nyasaye</para>
  <para style="q2" vid="PSA 68:2">mana kaka odok leny kowinjo mach.<verse eid="PSA 68:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3"/>To joma kare to mad bed mamor</para>
  <para style="q2" vid="PSA 68:3">kendo moil e nyim Nyasaye;</para>
  <para style="q2" vid="PSA 68:3">mad gibed mamor kendo gibed mamor chuth.<verse eid="PSA 68:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4"/>Weruru ne Nyasaye, weruru wende pak ne nyinge,</para>
  <para style="q2" vid="PSA 68:4">miyeuru duongʼ, En moriembo gechene e boche polo,</para>
  <para style="q1" vid="PSA 68:4">nyinge en Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 68:4">beduru moil e nyime.<verse eid="PSA 68:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5"/>Nyasaye modak kare kama ler.</para>
  <para style="q2" vid="PSA 68:5">En wuoro ne joma onge gi wuonegi kendo en jachwak mon ma chwogi otho.<verse eid="PSA 68:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6"/>Nyasaye keto joma odongʼ kendgi e udi</para>
  <para style="q2" vid="PSA 68:6">kendo otelo ne joma otwe kower;</para>
  <para style="q2" vid="PSA 68:6">to joma ohero ngʼanyo to dak e piny ma chiengʼ otwoyo kururu.<verse eid="PSA 68:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7"/>Kane iwuok idhi kitelo ne jogi, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 68:7">kane iwuotho e piny mokethore maonge tich, <char style="qs">Sela</char><verse eid="PSA 68:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8"/>piny noyiengni</para>
  <para style="q2" vid="PSA 68:8">kendo polo noolo koth e piny,</para>
  <para style="q1" vid="PSA 68:8">e nyim Nyasaye, Jal man Sinai,</para>
  <para style="q2" vid="PSA 68:8">e nyim Nyasaye ma Nyasach Israel.<verse eid="PSA 68:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9"/>Ne ichiwo koth mogundho, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 68:9">ne idwogo chuny girkeni mari mane ojony.<verse eid="PSA 68:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10"/>Jogi nokawo pinyno modakie kendo nichiwo ne joma odhier gik ma gilando,</para>
  <para style="q2" vid="PSA 68:10">kigolo kuom mwanduni mogundho, yaye Nyasaye.<verse eid="PSA 68:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11"/>Ruoth nolando wach kendo oganda mane okawo wachno</para>
  <para style="q2" vid="PSA 68:11">mi okeye ne duongʼ mokalo:<verse eid="PSA 68:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12"/>“Ruodhi gi jolweny dar gi ngʼwech;</para>
  <para style="q2" vid="PSA 68:12">ji pogo gik moyaki e kambi.<verse eid="PSA 68:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13"/>Kata mana sa ma inindo but mach kama liet,</para>
  <para style="q2" vid="PSA 68:13">to bwombe mag akuchena oum gi dhahabu,</para>
  <para style="q2" vid="PSA 68:13">kendo yierene oum gi fedha maleny.”<verse eid="PSA 68:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14"/>Kane Jal Maratego okeyo ruodhi manie piny,</para>
  <para style="q2" vid="PSA 68:14">to ne ochal mana gi pe molwar koa e kama otingʼore gi malo mar Zalmon.<verse eid="PSA 68:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15"/>Gode mag Bashan gin gode madongo miwuoro;</para>
  <para style="q2" vid="PSA 68:15">godego mag Bashan ojuothore adier.<verse eid="PSA 68:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16"/>Angʼo momiyo ungʼicho gi nyiego, yaye gode mojuothore,</para>
  <para style="q2" vid="PSA 68:16">angʼo momiyo nyiego omakou gi got kama Nyasaye oyiero mondo ogurie lochne,</para>
  <para style="q2" vid="PSA 68:16">kama Jehova Nyasaye owuon biro dakie nyaka chiengʼ?<verse eid="PSA 68:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17"/>Geche mag lweny mag Nyasaye gin tara gi tara;</para>
  <para style="q2" vid="PSA 68:17">gingʼeny mokalo akwana;</para>
  <para style="q2" vid="PSA 68:17">Ruoth osebiro koa Sinai mondo odonji kare maler.<verse eid="PSA 68:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18"/>Kane iidho idhi malo</para>
  <para style="q2" vid="PSA 68:18">to ne itelone joma nimako e lweny;</para>
  <para style="q2" vid="PSA 68:18">kendo ne ikawo mich mane ji omiyi,</para>
  <para style="q1" vid="PSA 68:18">nyaka mich mane jongʼanyo omiyi,</para>
  <para style="q2" vid="PSA 68:18">mondo in Jehova Nyasaye, idag kanyo.<verse eid="PSA 68:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19"/>Pak odog ne Ruoth, ma en Nyasaye ma Jawarwa,</para>
  <para style="q2" vid="PSA 68:19">Nyasaye matingʼonwa pekwa ndalo duto. <char style="qs">Sela</char><verse eid="PSA 68:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20"/>Nyasachwa en Nyasaye ma waro ji;</para>
  <para style="q2" vid="PSA 68:20">tony e tho aa kuom Jehova Nyasaye Manyalo Gik Moko Duto ma Wuon Loch.<verse eid="PSA 68:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21"/>Kuom adier, Nyasaye biro toyo wiye wasike,</para>
  <para style="q2" vid="PSA 68:21">obiro mayo joma dhi nyime gi timo richo osimbo motimo yier ma girwako.<verse eid="PSA 68:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22"/>Ruoth wacho niya, “Abiro gologi oko Bashan;</para>
  <para style="q2" vid="PSA 68:22">abiro gologi oko kama tut mar nam,<verse eid="PSA 68:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23"/>mondo unyum tiendeu e remb joma kedo kodu,</para>
  <para style="q2" vid="PSA 68:23">seche ma guogi magu olodho lewgi ka gichamo makorgi.”<verse eid="PSA 68:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24"/>Wuodhi koro nenore maler, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 68:24">wuodh Nyasacha ma Ruodha nenore maler kodonjo kare maler.<verse eid="PSA 68:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25"/>Joma wer gi dhogi otelo eka joma wer ka goyo thumbe luwogi,</para>
  <para style="q2" vid="PSA 68:25">nyiri magoyo oyieke bende ni kodgi machiegni.<verse eid="PSA 68:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26"/>Pakuru Nyasaye e dier chokruok maduongʼ;</para>
  <para style="q2" vid="PSA 68:26">pakuru Jehova Nyasaye e dier chokruok mar jo-Israel.<verse eid="PSA 68:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27"/>Dhoot matin mar joka Benjamin otelonegi,</para>
  <para style="q2" vid="PSA 68:27">oganda maduongʼ mar ruodhi moa e dhood Juda bende ni kodgi,</para>
  <para style="q2" vid="PSA 68:27">eka nitie ruodhi moa e dhout Zebulun gi Naftali.<verse eid="PSA 68:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28"/>Chok tekoni kaachiel, yaye Nyasaye; nyiswa tekoni,</para>
  <para style="q2" vid="PSA 68:28">yaye Nyasaye; kaka isebedo kitimo nyaka aa chon.<verse eid="PSA 68:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29"/>Nikech hekalu mari man Jerusalem</para>
  <para style="q2" vid="PSA 68:29">ruodhi biro keloni mich.<verse eid="PSA 68:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30"/>Kwer ondiek manie dier togo,</para>
  <para style="q2" vid="PSA 68:30">kwer kweth mag rwedhi manie dier nyiroye mag ogendini.</para>
  <para style="q1" vid="PSA 68:30">Mi okel sirni mangʼeny mag fedha ka wiye okuot.</para>
  <para style="q2" vid="PSA 68:30">Ke ogendini mohero lweny.<verse eid="PSA 68:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31"/>Joote biro biro koa Misri;</para>
  <para style="q2" vid="PSA 68:31">Kush bende biro bolore ne Nyasaye.<verse eid="PSA 68:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32"/>Weruru ne Nyasaye, yaye pinjeruodhi mag piny,</para>
  <para style="q2" vid="PSA 68:32">weruru wende pak ne Ruoth Nyasaye, <char style="qs">Sela</char><verse eid="PSA 68:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33"/>werneuru ne Jal mariembo gechene e kor polo malo manyaka nene,</para>
  <para style="q2" vid="PSA 68:33">Jal mamor gi dwol maduongʼ.<verse eid="PSA 68:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34"/>Landuru teko mar Nyasaye</para>
  <para style="q2" vid="PSA 68:34">ma nigi duongʼ kuom Israel,</para>
  <para style="q2" vid="PSA 68:34">kendo ma nigi teko e kor polo.<verse eid="PSA 68:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35"/>Ilich miwuoro ka in kari maler, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 68:35">Nyasach Israel chiwo teko gi nyalo ne joge.</para>
  <para style="b" vid="PSA 68:35"/>
  <para style="q1" vid="PSA 68:35">Pak mondo obed ne Nyasaye!<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="cl">Zaburi 69</para>
  <para style="d">Kuom jatend wer e dwol mar “Ondanyo.” Mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1"/>Resa, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 69:1">nikech pi oseima nyaka e ngʼuta.<verse eid="PSA 69:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2"/>Asechako nimo e chwodho matut,</para>
  <para style="q2" vid="PSA 69:2">kama onge lowo motegno ma ngʼato nyalo chungʼie.</para>
  <para style="q1" vid="PSA 69:2">Asechopo e chuny pi kama tut,</para>
  <para style="q2" vid="PSA 69:2">kendo apaka olwora oketa diere.<verse eid="PSA 69:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3"/>Koro aseywak mondo okonya mi aol;</para>
  <para style="q2" vid="PSA 69:3">dwonda rewni.</para>
  <para style="q1" vid="PSA 69:3">Wengena pek,</para>
  <para style="q2" vid="PSA 69:3">ka amanyo Nyasacha.<verse eid="PSA 69:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4"/>Joma ochaya maonge gima omiyo</para>
  <para style="q2" vid="PSA 69:4">ngʼeny moloyo yie wiya;</para>
  <para style="q1" vid="PSA 69:4">joma olokore wasika kayiem thoth adier,</para>
  <para style="q2" vid="PSA 69:4">jogogo madwaro mondo otieka.</para>
  <para style="q1" vid="PSA 69:4">Ichuna mondo adwok</para>
  <para style="q2" vid="PSA 69:4">gima ne ok akwalo.<verse eid="PSA 69:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5"/>Ingʼeyo fupa, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 69:5">kethona ok opondoni.<verse eid="PSA 69:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6"/>Mad joma ogeno kuomi</para>
  <para style="q2" vid="PSA 69:6">kik ne wichkuot nikech an,</para>
  <para style="q2" vid="PSA 69:6">yaye Ruoth, Jehova Nyasaye Maratego;</para>
  <para style="q1" vid="PSA 69:6">mad joma manyi</para>
  <para style="q2" vid="PSA 69:6">kik ne wichkuot nikech an,</para>
  <para style="q2" vid="PSA 69:6">yaye Nyasach Israel.<verse eid="PSA 69:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7"/>Nimar ji yanya to alingʼ alingʼa nikech in,</para>
  <para style="q2" vid="PSA 69:7">kendo wichkuot obako lela wangʼa.<verse eid="PSA 69:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8"/>Achalo wendo ne owetena</para>
  <para style="q2" vid="PSA 69:8">an kaka jamwa ne yawuot minwa;<verse eid="PSA 69:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9"/>nikech hera matut ma aherogo odi tieka,</para>
  <para style="q2" vid="PSA 69:9">kendo ayenje mag joma yanyi lwar kuoma.<verse eid="PSA 69:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10"/>Ka aywak kendo atweyo chiemo</para>
  <para style="q2" vid="PSA 69:10">to pod nyaka ayud ayany;<verse eid="PSA 69:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11"/>ka arwako law ywak,</para>
  <para style="q2" vid="PSA 69:11">to ji oloka ngero.<verse eid="PSA 69:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12"/>Joma obet e rangach jara,</para>
  <para style="q2" vid="PSA 69:12">kendo alokora wer ma jokongʼo wero.<verse eid="PSA 69:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13"/>To alami, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 69:13">e kinde ma iikori mar konya;</para>
  <para style="q1" vid="PSA 69:13">kuom herani maduongʼ, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 69:13">dwoka gi resruok mari mar adier.<verse eid="PSA 69:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14"/>Gola oko e chwodho,</para>
  <para style="q2" vid="PSA 69:14">kik iyie anim;</para>
  <para style="q1" vid="PSA 69:14">resa e lwet joma ochaya,</para>
  <para style="q2" vid="PSA 69:14">gola e chuny pi kama tut.<verse eid="PSA 69:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15"/>Kik iwe ohula ywera mi tera</para>
  <para style="q2" vid="PSA 69:15">kata kut mwonya duto,</para>
  <para style="q2" vid="PSA 69:15">kata bur matut um dhoge ka an e iye.<verse eid="PSA 69:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16"/>Dwoka, yaye Jehova Nyasaye, dwoka, nikech herani ber;</para>
  <para style="q2" vid="PSA 69:16">lokri ira kuom kechni maduongʼ.<verse eid="PSA 69:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17"/>Kik ipand wangʼi ne jatichni;</para>
  <para style="q2" vid="PSA 69:17">dwoka piyo, nikech anie chandruok.<verse eid="PSA 69:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18"/>Bi machiegni mondo ikonya,</para>
  <para style="q2" vid="PSA 69:18">resa nikech joma kedo koda.<verse eid="PSA 69:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19"/>Ingʼeyo kaka ijara, kaka ikuodo wiya kendo kaka aneno wichkuot;</para>
  <para style="q2" vid="PSA 69:19">wasika duto ochoma tir.<verse eid="PSA 69:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20"/>Ajara osechodo chunya</para>
  <para style="q2" vid="PSA 69:20">kendo aonge gi kar kony.</para>
  <para style="q1" vid="PSA 69:20">Ne amanyo joma hoya,</para>
  <para style="q2" vid="PSA 69:20">to ne ok ayudo kata achiel.<verse eid="PSA 69:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21"/>Negiketo kedhno e chiemba</para>
  <para style="q2" vid="PSA 69:21">kendo negimiya kong andwayo mondo otiekna riyo.<verse eid="PSA 69:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22"/>Mad mesa mochan e nyimgi lokre obadho;</para>
  <para style="q2" vid="PSA 69:22">kendo mad olokrenegi gir chulo kuor kod otegu.<verse eid="PSA 69:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23"/>Mad wengegi dinre mondo kik ginen</para>
  <para style="q2" vid="PSA 69:23">kendo oguchgi odolre nyaka chiengʼ.<verse eid="PSA 69:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24"/>Ol mirimbi kuomgi;</para>
  <para style="q2" vid="PSA 69:24">we mirimbi mager omakgi.<verse eid="PSA 69:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25"/>Mad miechgi dongʼ gundni;</para>
  <para style="q2" vid="PSA 69:25">kendo kik iyie ne ngʼato angʼata dag e hembgi.<verse eid="PSA 69:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26"/>Nimar gisando joma ihinyo</para>
  <para style="q2" vid="PSA 69:26">kendo giwuoyo kuom lit mag joma ihinyo.<verse eid="PSA 69:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27"/>Ket ketho e wigi kuom ketho ka ketho ma gitimo;</para>
  <para style="q2" vid="PSA 69:27">kendo kik iyie giyud warruok mari.<verse eid="PSA 69:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28"/>Mad ruch kargi oko e kitap joma ngima</para>
  <para style="q2" vid="PSA 69:28">kendo kik kwan-gi kaachiel gi joma kare.<verse eid="PSA 69:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29"/>An-gi rem kendo awinjo marach e chunya;</para>
  <para style="q2" vid="PSA 69:29">mad warruokni rita, yaye Nyasaye.<verse eid="PSA 69:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30"/>Abiro pako nying Nyasaye gi wer</para>
  <para style="q2" vid="PSA 69:30">kendo abiro miyo nyinge duongʼ gi erokamano.<verse eid="PSA 69:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31"/>Mano biro miyo Jehova Nyasaye mor moloyo rwadh pur,</para>
  <para style="q2" vid="PSA 69:31">moloyo rwath mabwoch man-gi tungene kod ombongʼne.<verse eid="PSA 69:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32"/>Joma odhier biro neno mi gibed mamor,</para>
  <para style="q2" vid="PSA 69:32">un ma udwaro Nyasaye mad chunyu bed mangima!<verse eid="PSA 69:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33"/>Jehova Nyasaye winjo joma ochando</para>
  <para style="q2" vid="PSA 69:33">kendo ok olok ngʼeye ne joge motwe.<verse eid="PSA 69:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34"/>Piny gi polo mondo opake,</para>
  <para style="q2" vid="PSA 69:34">kaachiel gi nembe kod gik moko duto mawuothoe igi,<verse eid="PSA 69:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35"/>nikech Nyasaye biro reso Sayun</para>
  <para style="q2" vid="PSA 69:35">kendo obiro gero dala mag Juda kendo.</para>
  <para style="q1" vid="PSA 69:35">Eka ji nodag kanyo kendo ginikawe kaka margi;<verse eid="PSA 69:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="PSA 69:36"/>enobed girkeni mar koth jotichne,</para>
  <para style="q2" vid="PSA 69:36">kendo joma ohero nyinge nodag kanyo.<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="cl">Zaburi 70</para>
  <para style="d">Kuom jatend wer. Kwayo mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1"/>Ret piyo mondo iresa, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 70:1">bi piyo mondo ikonya, yaye Jehova Nyasaye.<verse eid="PSA 70:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2"/>Mad joma dwaro ngimana</para>
  <para style="q2" vid="PSA 70:2">yud wichkuot kendo pachgi lal;</para>
  <para style="q1" vid="PSA 70:2">mad ji duto ma gombona hinyruok</para>
  <para style="q2" vid="PSA 70:2">dog kuma giaye ka giyudo achaya.<verse eid="PSA 70:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3"/>Mad joma wachona niya, “Haa! Haa!”</para>
  <para style="q2" vid="PSA 70:3">Dog kuma giaye ka wichkuot omakogi.<verse eid="PSA 70:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4"/>To mad ji duto madwari</para>
  <para style="q2" vid="PSA 70:4">bed moil kendo mamor kuomi;</para>
  <para style="q1" vid="PSA 70:4">mad joma ohero warruok mari osik kawacho niya,</para>
  <para style="q2" vid="PSA 70:4">“Jehova Nyasaye mondo oyud duongʼ!”<verse eid="PSA 70:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5"/>Adhier kendo achando;</para>
  <para style="q2" vid="PSA 70:5">bi ira piyo, yaye Nyasaye.</para>
  <para style="q1" vid="PSA 70:5">In e konyruokna kendo jaresna;</para>
  <para style="q2" vid="PSA 70:5">kik ideki, yaye Jehova Nyasaye.<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="cl">Zaburi 71</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1"/>Kuomi ema aseponde, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 71:1">kik iwe ayud wichkuot.<verse eid="PSA 71:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2"/>Konya kendo gola e chandruok, nikech timni makare;</para>
  <para style="q2" vid="PSA 71:2">winja kendo iresa.<verse eid="PSA 71:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3"/>Bedna lwanda mar pondo,</para>
  <para style="q2" vid="PSA 71:3">ma anyalo ringo adhiye seche duto;</para>
  <para style="q1" vid="PSA 71:3">gol chik mondo iresa,</para>
  <para style="q2" vid="PSA 71:3">nimar in e lwandana kendo ohingana.<verse eid="PSA 71:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4"/>Resa e lwet joma timbegi richo, yaye Nyasacha,</para>
  <para style="q2" vid="PSA 71:4">gola kuom richo gi joma kwiny momaka matek.<verse eid="PSA 71:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5"/>Nimar in ema isebedo genona, yaye Jehova Nyasaye Manyalo Gik Moko Duto,</para>
  <para style="q2" vid="PSA 71:5">in ema isebedo kimiya chir nyaka ae tin-na.<verse eid="PSA 71:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6"/>Asebedo ka ayiengora kuomi nyaka ne nywola;</para>
  <para style="q2" vid="PSA 71:6">in ema ne igola ei minwa.</para>
  <para style="q2" vid="PSA 71:6">Abiro apaki nyaka chiengʼ.<verse eid="PSA 71:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7"/>Alokora gima bwogo ji mangʼeny</para>
  <para style="q2" vid="PSA 71:7">to kata kamano in e kar pondo mara motegno.<verse eid="PSA 71:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8"/>Dhoga opongʼ gi pakni,</para>
  <para style="q2" vid="PSA 71:8">kendo asiko ahulo duongʼni maler odiechiengʼ duto.<verse eid="PSA 71:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9"/>Kik ijog koda ka koro ati;</para>
  <para style="q2" vid="PSA 71:9">kik ijwangʼa ka tekra orumo.<verse eid="PSA 71:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10"/>Nimar wasika wuoyo marach kuoma;</para>
  <para style="q2" vid="PSA 71:10">jogo marita mondo onega loso wach kaachiel.<verse eid="PSA 71:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11"/>Giwacho niya, “Nyasaye oseweye;</para>
  <para style="q2" vid="PSA 71:11">laweuru mondo umake,</para>
  <para style="q2" vid="PSA 71:11">nikech onge ngʼama biro rese.”<verse eid="PSA 71:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12"/>Kik ibed mabor koda, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 71:12">bi piyo mondo ikonya, yaye Nyasacha.<verse eid="PSA 71:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13"/>Mad joma donjona lal nono ka wigi okuot;</para>
  <para style="q2" vid="PSA 71:13">mad joma dwaro hinya,</para>
  <para style="q2" vid="PSA 71:13">obed gi achaya kod wichkuot koni gi koni.<verse eid="PSA 71:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14"/>Anto abiro siko ka an gi geno;</para>
  <para style="q2" vid="PSA 71:14">abiro paki kendo abiro medo paki.<verse eid="PSA 71:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15"/>Dhoga biro hulo timni makare,</para>
  <para style="q2" vid="PSA 71:15">kod warruokni odiechiengʼ duto,</para>
  <para style="q2" vid="PSA 71:15">kata obedo ni gingʼeny mohinga ngʼeyo.<verse eid="PSA 71:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16"/>Abiro biro mondo anyis ji timbeni madongo,</para>
  <para style="q2" vid="PSA 71:16">yaye Jehova Nyasaye Manyalo Gik Moko Duto;</para>
  <para style="q2" vid="PSA 71:16">abiro nyiso ji timni makare, timni makare in kendi.<verse eid="PSA 71:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17"/>Isepuonja nyaka aa e nyathi, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 71:17">kendo nyaka kawuono pod ahulo timbe miwuoro.<verse eid="PSA 71:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18"/>Kata ka ochopo kinde ma ati kendo wiya oselokore lwar,</para>
  <para style="q2" vid="PSA 71:18">to kik iweya, yaye Nyasaye,</para>
  <para style="q1" vid="PSA 71:18">nyaka ahul tekoni ni tienge mabiro,</para>
  <para style="q2" vid="PSA 71:18">kendo ahul timbeni madongo ni tienge duto mabiro.<verse eid="PSA 71:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19"/>Timni makare ochopo nyaka ei kor polo, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 71:19">in misetimo gik madongo.</para>
  <para style="q2" vid="PSA 71:19">En ngʼa ma dipim kodi, yaye Nyasaye?<verse eid="PSA 71:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20"/>Kata obedo ni isemiyo aneno chandruok mathoth kendo malit,</para>
  <para style="q2" vid="PSA 71:20">to pod ibiro miyo abed mangima kendo.</para>
  <para style="q1" vid="PSA 71:20">Ibiro gola e bur matut</para>
  <para style="q2" vid="PSA 71:20">mi achak abed gi duongʼ.<verse eid="PSA 71:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21"/>Ibiro miyo duongʼ ma an-go medore</para>
  <para style="q2" vid="PSA 71:21">kendo ibiro chako ihoya kendo.<verse eid="PSA 71:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22"/>Abiro paki gi nyatiti</para>
  <para style="q2" vid="PSA 71:22">nikech adiera mari, yaye Nyasaye;</para>
  <para style="q1" vid="PSA 71:22">abiro weroni wend pak gi orutu,</para>
  <para style="q2" vid="PSA 71:22">yaye Nyasaye Maler mar Israel.<verse eid="PSA 71:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23"/>Abiro kok gi mor</para>
  <para style="q2" vid="PSA 71:23">ka aweroni wend pak,</para>
  <para style="q2" vid="PSA 71:23">nikech an ngʼat misewaro.<verse eid="PSA 71:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24"/>Dhoga biro nyiso ji kuom timbeni makare</para>
  <para style="q2" vid="PSA 71:24">odiechiengʼ duto,</para>
  <para style="q1" vid="PSA 71:24">nimar joma ne dwaro hinya</para>
  <para style="q2" vid="PSA 71:24">oseneno wichkuot kendo osengʼengʼ.<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="cl">Zaburi 72</para>
  <para style="d">Mar Solomon.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1"/>Sidh ne ruoth adiera mari, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 72:1">sidh ne wuod ruoth timni makare.<verse eid="PSA 72:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2"/>Obiro ngʼado ne jou bura makare,</para>
  <para style="q2" vid="PSA 72:2">obiro kelo adiera ne jou masandore.<verse eid="PSA 72:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3"/>Gode biro kelo mwandu ne ji,</para>
  <para style="q2" vid="PSA 72:3">kendo thuche biro kelo olemb tim makare.<verse eid="PSA 72:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4"/>Obiro chwako joma odhier manie dier ji</para>
  <para style="q2" vid="PSA 72:4">kendo obiro reso nyithind joma ochando;</para>
  <para style="q2" vid="PSA 72:4">to thiro ji, to obiro tieko pep.<verse eid="PSA 72:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5"/>Obiro siko ka wangʼ chiengʼ,</para>
  <para style="q2" vid="PSA 72:5">obiro siko ka dwe e tienge duto.<verse eid="PSA 72:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6"/>Obiro chalo gi koth machwe e lum mongʼadi maber</para>
  <para style="q2" vid="PSA 72:6">kendo gi kodh ajiki mamiyo piny ngʼich.<verse eid="PSA 72:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7"/>E ndalone joma kare biro dhi maber,</para>
  <para style="q2" vid="PSA 72:7">kendo kwe biro bedo mogundho nyaka chop dwe lal nono.<verse eid="PSA 72:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8"/>Obiro bedo gi loch chakre nam nyaka nam</para>
  <para style="q2" vid="PSA 72:8">kendo kochakore Aora maduongʼ nyaka kuma piny ogikie.<verse eid="PSA 72:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9"/>Ogendini modak e piny ongoro biro kulorene</para>
  <para style="q2" vid="PSA 72:9">kendo wasike biro nangʼo lowo gi dhogi.<verse eid="PSA 72:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10"/>Ruodhi mag Tarshish kod mag dho nembe man maboyo</para>
  <para style="q2" vid="PSA 72:10">biro miye gik moko,</para>
  <para style="q1" vid="PSA 72:10">kendo ruodhi mag Sheba gi mag Seba</para>
  <para style="q2" vid="PSA 72:10">biro kelone mich.<verse eid="PSA 72:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11"/>Ruodhi duto biro kulorene</para>
  <para style="q2" vid="PSA 72:11">kendo ogendini duto biro tiyone.<verse eid="PSA 72:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12"/>Nimar obiro konyo joma ochando maywagore,</para>
  <para style="q2" vid="PSA 72:12">jogo modhier maonge gi jakony.<verse eid="PSA 72:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13"/>Obiro kecho joma ok nyal gi joma ochando</para>
  <para style="q2" vid="PSA 72:13">kendo obiro reso ngima joma ochando.<verse eid="PSA 72:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14"/>Obiro gologi e dich modigigo kendo e timbe mahundu,</para>
  <para style="q2" vid="PSA 72:14">nimar okwano rembgi ka gima nengone tek.<verse eid="PSA 72:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15"/>Mad odag amingʼa!</para>
  <para style="q2" vid="PSA 72:15">Mad kelne dhahabu moa Sheba.</para>
  <para style="q1" vid="PSA 72:15">Mad ji duto sik ka lamone</para>
  <para style="q2" vid="PSA 72:15">kendo ka gwedhe odiechiengʼ duto.<verse eid="PSA 72:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16"/>Mad cham bed mangʼeny e piny duto,</para>
  <para style="q2" vid="PSA 72:16">bende gikwak nyaka wi godo matindo duto.</para>
  <para style="q1" vid="PSA 72:16">Mad olembene ol mathoth ka Lebanon,</para>
  <para style="q2" vid="PSA 72:16">kendo mad onyagi ka lum manie pap.<verse eid="PSA 72:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17"/>Mad nyinge sik nyaka chiengʼ</para>
  <para style="q2" vid="PSA 72:17">kendo mad odhi nyime ka wangʼ chiengʼ.</para>
  <para style="b" vid="PSA 72:17"/>
  <para style="q1" vid="PSA 72:17">Ogendini duto ibiro gwedhi gi gweth moa kuomi</para>
  <para style="q2" vid="PSA 72:17">kendo gibiro luongi ni ngʼat mogwedhi.<verse eid="PSA 72:17"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18"/>Jehova Nyasaye, ma Nyasach Israel, mondo oyud opak,</para>
  <para style="q2" vid="PSA 72:18">en kende ema otimo gik miwuoro.<verse eid="PSA 72:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19"/>Nyinge man-gi duongʼ mondo opaki nyaka chiengʼ</para>
  <para style="q2" vid="PSA 72:19">kendo mad piny duto pongʼ gi duongʼne.</para>
  <para style="qc" vid="PSA 72:19">Amin kendo Amin.<verse eid="PSA 72:19"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20"/>Ma e giko mag lamo mag Daudi Wuod Jesse.<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms">Kitabu mar Adek</para>
  <para style="mr">
    <ref loc="PSA 73-89">Zaburi 73–89</ref></para>
  <para style="cl">Zaburi 73</para>
  <para style="d">Zaburi mar Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1"/>Adier Nyasaye timo maber ni jo-Israel,</para>
  <para style="q2" vid="PSA 73:1">otimo maber ne jogo maler ei chunygi.<verse eid="PSA 73:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2"/>Anto tiendena nodwaro kier.</para>
  <para style="q2" vid="PSA 73:2">Ne achiegni aa kama ne anyono.<verse eid="PSA 73:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3"/>Nimar ne agombo timbe joma ochayo ji</para>
  <para style="q2" vid="PSA 73:3">kane aneno kaka joma timbegi richo dhi maber.<verse eid="PSA 73:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4"/>Gionge gi pek moro amora</para>
  <para style="q2" vid="PSA 73:4">kendo dendgi ber kendo otegno.<verse eid="PSA 73:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5"/>Chandruok mamako ji gin ok yudgi</para>
  <para style="q2" vid="PSA 73:5">kendo ok githagre kaka ji mamoko thagore.<verse eid="PSA 73:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6"/>Emomiyo sunga chalonegi thiwni mar ngʼut,</para>
  <para style="q2" vid="PSA 73:6">kendo girwako mahundu ka law.<verse eid="PSA 73:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7"/>Wengegi onyiedhore gi bor</para>
  <para style="q2" vid="PSA 73:7">kendo miriambo maricho mopongʼo pachgi onge gikogi.<verse eid="PSA 73:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8"/>Gijaro ji kendo giwuoyo ka gihimo ji,</para>
  <para style="q2" vid="PSA 73:8">nikech gichayo ji gisiko gibwogo ji ni ji biro wuoro.<verse eid="PSA 73:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9"/>Giwacho weche polo gi dhogi</para>
  <para style="q2" vid="PSA 73:9">to lewgi to gimakogo mwandu mag piny.<verse eid="PSA 73:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10"/>Emomiyo jogegi doknegi kendo pakogi</para>
  <para style="q2" vid="PSA 73:10">kendo ok giyud rach moro amora kuomgi.<verse eid="PSA 73:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11"/>Giwacho niya, “Ere kaka Nyasaye nyalo ngʼeyo?</para>
  <para style="q2" vid="PSA 73:11">Nyasaye Man Malo Moloyo to ongʼeyo angʼo?”<verse eid="PSA 73:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12"/>Kama e kaka joma timbegi richo chalo,</para>
  <para style="q2" vid="PSA 73:12">ok gidew gimoro amora kendo mwandugi osiko medore ameda.<verse eid="PSA 73:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13"/>Kare asetemo ritora mondo chunya osik kaler kayiem,</para>
  <para style="q2" vid="PSA 73:13">kendo asetemo gengʼo lwetena ni kik omul richo kayiem.<verse eid="PSA 73:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14"/>Nimar asiko achandora seche duto,</para>
  <para style="q2" vid="PSA 73:14">kendo ayudo kum okinyi kokinyi.<verse eid="PSA 73:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15"/>Ka dine bed ni awacho kamano,</para>
  <para style="q2" vid="PSA 73:15">to dine andhogo nyithindi.<verse eid="PSA 73:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16"/>To kane atemo winjo tiend gigi duto,</para>
  <para style="q2" vid="PSA 73:16">to ne opek mohinga;<verse eid="PSA 73:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17"/>nyaka ne adonjo kama ler mar lemo mar Nyasaye;</para>
  <para style="q2" vid="PSA 73:17">eka nawinjo kaka gikogi nobedi.<verse eid="PSA 73:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18"/>Chutho iketogi kama poth-poth,</para>
  <para style="q2" vid="PSA 73:18">kendo idwokogi piny mi gikethre.<verse eid="PSA 73:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19"/>Mano kaka itiekogi apoya nono,</para>
  <para style="q2" vid="PSA 73:19">mi masiche malich lal kodgi nono!<verse eid="PSA 73:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20"/>Gilal nono ka lek ma ngʼato oleko gokinyi,</para>
  <para style="q2" vid="PSA 73:20">omiyo e kinde ma ia malo, yaye Ruoth Nyasaye,</para>
  <para style="q2" vid="PSA 73:20">to ok ibi dewogi mana ka kido maonge.<verse eid="PSA 73:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21"/>Kane iya owangʼ,</para>
  <para style="q2" vid="PSA 73:21">kendo chunya winjo lit,<verse eid="PSA 73:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22"/>to pacha nolal kendo ne abedo mofuwo,</para>
  <para style="q2" vid="PSA 73:22">ne achalo le maonge rieko e nyimi.<verse eid="PSA 73:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23"/>Kata kamano an kodi ndalo duto,</para>
  <para style="q2" vid="PSA 73:23">kendo imaka gi bada korachwich.<verse eid="PSA 73:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24"/>Itaya gi rieko mingʼadona</para>
  <para style="q2" vid="PSA 73:24">kendo bangʼe ibiro tera kar duongʼ.<verse eid="PSA 73:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25"/>En ngʼa ma an-go e polo makmana in?</para>
  <para style="q2" vid="PSA 73:25">Piny bende onge gi gimoro amora madwaro moloyi.<verse eid="PSA 73:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26"/>Ringra gi chunya nyalo doko manyap,</para>
  <para style="q2" vid="PSA 73:26">to Nyasaye ema miyo chunya teko,</para>
  <para style="q2" vid="PSA 73:26">kendo en e girkeni mara nyaka chiengʼ.<verse eid="PSA 73:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27"/>Joma ni mabor kodi biro lal nono</para>
  <para style="q2" vid="PSA 73:27">kendo ibiro tieko ji duto ma ok jo-adiera ne in.<verse eid="PSA 73:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28"/>An to berna ka an but Nyasaye.</para>
  <para style="q2" vid="PSA 73:28">Aseketo Jehova Nyasaye Manyalo Gik Moko Duto kar pondona,</para>
  <para style="q2" vid="PSA 73:28">kendo abiro lando gik moko duto mitimo.<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="cl">Zaburi 74</para>
  <para style="d">
    <char style="tl">Maskil</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">74:0 </char>
      <char style="fl" closed="false">Maskil: </char>
      <char style="ft" closed="false">en kit wer moro mane Daudi owero</char>
    </note> mar Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1"/>Angʼo momiyo isedagiwa nyaka chiengʼ, yaye Nyasaye?</para>
  <para style="q2" vid="PSA 74:1">Angʼo momiyo mirimbi dhwolore ka iro kochomo rombe mag lek mari iwuon?<verse eid="PSA 74:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2"/>Par jogi mane ingʼiewo chon gi lala,</para>
  <para style="q2" vid="PSA 74:2">oganda ma gin girkeni mari, kendo mane iwaro,</para>
  <para style="q2" vid="PSA 74:2">Got Sayun, kama in iwuon idakie.<verse eid="PSA 74:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3"/>Lokri ichom kuonde mosebedo kokethore nyaka nene,</para>
  <para style="q2" vid="PSA 74:3">lokri ichom kethruok maduongʼ ma jasigu osekelo e kari maler mar lemo.<verse eid="PSA 74:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4"/>Wasiki noruto kama iromoe kodwa;</para>
  <para style="q2" vid="PSA 74:4">kendo negichungo bendechegi mochungʼ kar timbegi maricho.<verse eid="PSA 74:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5"/>Negitimore marach mana ka ji mangʼawo leyegi malo</para>
  <para style="q2" vid="PSA 74:5">ka gidwaro tongʼo yiende madongo dongo modongo modhigore.<verse eid="PSA 74:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6"/>Negituro chumbe modol odol</para>
  <para style="q2" vid="PSA 74:6">gi tindogi kod nyundogi.<verse eid="PSA 74:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7"/>Ne giwangʼo kari maler mar lemo molokore buru,</para>
  <para style="q2" vid="PSA 74:7">kendo ne gidwanyo kama nyingi dakie.<verse eid="PSA 74:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8"/>Negiwacho e chunygi niya, “Wabiro tiekogi chuth!”</para>
  <para style="q2" vid="PSA 74:8">Ne giwangʼo kuonde duto e piny mane ilame Nyasaye.<verse eid="PSA 74:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9"/>Tinde ok wayud honni kata ranyisi,</para>
  <para style="q2" vid="PSA 74:9">kendo onge jonabi modongʼ kata achiel,</para>
  <para style="q1" vid="PSA 74:9">to onge kata ngʼato achiel kuomwa mongʼeyo</para>
  <para style="q2" vid="PSA 74:9">ni mano biro bedo kamano nyaka karangʼo.<verse eid="PSA 74:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10"/>Nyaka karangʼo ma jasigu biro jarie, yaye Nyasaye?</para>
  <para style="q2" vid="PSA 74:10">Ibiro yiene jasigu mondo oyany nyingi nyaka chiengʼ koso?<verse eid="PSA 74:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11"/>Angʼo momiyo itamo lweti tiyo tichne,</para>
  <para style="q2" vid="PSA 74:11">mana lweti ma korachwich?</para>
  <para style="q2" vid="PSA 74:11">Gole oko kama isoye ei lepi mondo itiekgi!<verse eid="PSA 74:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12"/>To Nyasaye in e Ruodha nyaka chakre chon, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 74:12">kendo isebedo kikelo resruok e piny.<verse eid="PSA 74:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13"/>In ema ne ipogo nam e diere ariyo gi tekoni,</para>
  <para style="q2" vid="PSA 74:13">kendo ne itoyo wiye ondiek marach ei pi.<verse eid="PSA 74:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14"/>In ema ne itoyo wiye Leviathan,</para>
  <para style="q2" vid="PSA 74:14">mi ichiwe kaka chiemo ne le modak e thim.<verse eid="PSA 74:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15"/>In ema ne iyawo sokni gi aore,</para>
  <para style="q2" vid="PSA 74:15">kendo ne imiyo aore madongo ma ok dwon otwo.<verse eid="PSA 74:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16"/>Odiechiengʼ en mari, kendo otieno bende mari,</para>
  <para style="q2" vid="PSA 74:16">bende ne iguro wangʼ chiengʼ gi dwe keregi.<verse eid="PSA 74:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17"/>In ema ne iketo tongʼ duto mag piny</para>
  <para style="q2" vid="PSA 74:17">kende ne iguro oro gi chwiri.<verse eid="PSA 74:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18"/>Parie kaka jasigu osejari, yaye Jehova Nyasaye.</para>
  <para style="q2" vid="PSA 74:18">Parie kaka joma onge rieko osechayo nyingi.<verse eid="PSA 74:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19"/>Kik iyie ichiw ngima mar akuch oduglani ne le mager mag bungu;</para>
  <para style="q2" vid="PSA 74:19">kik wiyi wil gi ngima jogi mathagore nyaka chiengʼ.<verse eid="PSA 74:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20"/>Par singruok mari</para>
  <para style="q2" vid="PSA 74:20">nikech timbe mahundu opongʼo kuonde duto motimo mudho e piny.<verse eid="PSA 74:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21"/>Kik iyie mondo joma idiyo ringa ka wigi okuot,</para>
  <para style="q2" vid="PSA 74:21">to mad joma odhier gi joma ochando opak nyingi.<verse eid="PSA 74:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22"/>Aa malo mondo isir tichni, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 74:22">parie kaka joma ofuwo jari odiechiengʼ duto.<verse eid="PSA 74:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23"/>Kik wiyi wil gi sibuoch wasiki,</para>
  <para style="q2" vid="PSA 74:23">chom tir sigich wasiki mosiko medore ameda.<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="cl">Zaburi 75</para>
  <para style="d">Kuom jatend wer. E dwol mar “Kik iketh gik moko.” Zaburi mar Asaf. Wer.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1"/>Wagoyoni erokamano, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 75:1">wagoyoni erokamano nimar Nyingi ni machiegni,</para>
  <para style="q2" vid="PSA 75:1">kendo ji lando timbeni miwuoro.<verse eid="PSA 75:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2"/>Iwacho niya, “An ema ayiero ndalo mowinjore,</para>
  <para style="q2" vid="PSA 75:2">kendo an ema angʼado bura kare.<verse eid="PSA 75:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3"/>Ka piny kaachiel gi ji duto modakie yiengni,</para>
  <para style="q2" vid="PSA 75:3">to an ema amako sirnige motegno. <char style="qs">Sela</char><note caller="+" style="f"><char style="fr" closed="false">75:3 </char><char style="fq" closed="false">Sela </char><char style="ft" closed="false">tiend wachni ok ongʼere.</char></note><verse eid="PSA 75:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4"/>Joma ochecho akwero ni, ‘Weuru sungoru,’</para>
  <para style="q2" vid="PSA 75:4">to joma timbegi richo to okwero niya,</para>
  <para style="q2" vid="PSA 75:4">‘Weuru tingʼo tungeu malo.<verse eid="PSA 75:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5"/>Weuru sungoru ni un gi teko,</para>
  <para style="q2" vid="PSA 75:5">kendo kuwuoyo kududo ngʼutu.’ ”<verse eid="PSA 75:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6"/>Nimar duongʼ ok nyal medore ne ngʼato</para>
  <para style="q2" vid="PSA 75:6">koa wuok chiengʼ kata podho chiengʼ kata e thim.<verse eid="PSA 75:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7"/>To Nyasaye ma jangʼad bura ema dwoko ngʼato piny,</para>
  <para style="q2" vid="PSA 75:7">kendo tingʼo ngʼat machielo malo.<verse eid="PSA 75:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8"/>Nitiere kikombe mopongʼ gi divai mochiek e lwet Jehova Nyasaye</para>
  <para style="q2" vid="PSA 75:8">en kikombe mopongʼ gi divai mokik gi apilo,</para>
  <para style="q1" vid="PSA 75:8">Nyasaye ole oko, to joma timbegi richo duto manie piny</para>
  <para style="q2" vid="PSA 75:8">madhe duto pep nyaka ngʼiende.<verse eid="PSA 75:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9"/>An to abiro siko ka alando wachni nyaka chiengʼ</para>
  <para style="q2" vid="PSA 75:9">kendo abiro wero wende pak ne Nyasach Jakobo,<verse eid="PSA 75:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10"/>mawacho niya, “Abiro ngʼado oko tunge joma timbegi richo duto,</para>
  <para style="q2" vid="PSA 75:10">to tunge joma kare to ibiro tingʼ malo.”<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="cl">Zaburi 76</para>
  <para style="d">Kuom jatend wer. Gi gig wer man-gi tondegi. Zaburi mar Asaf. Wer.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1"/>Nyasaye en rahuma e piny Juda,</para>
  <para style="q2" vid="PSA 76:1">kendo nyinge duongʼ e piny Israel.<verse eid="PSA 76:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2"/>Hembe nitie Salem</para>
  <para style="q2" vid="PSA 76:2">kar dakne ni Sayun.<verse eid="PSA 76:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3"/>Kanyo ema e oturoe aserni makakni,</para>
  <para style="q2" vid="PSA 76:3">kaachiel gi okumbni gi ligengni, ma gin gig lweny. <char style="qs">Sela</char><verse eid="PSA 76:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4"/>Duongʼ mari ler okwako</para>
  <para style="q2" vid="PSA 76:4">kendo iyombo gode momew gi kit le mayoreyore.<verse eid="PSA 76:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5"/>Yawuowi madongo mojingʼ osema gik mane giyako</para>
  <para style="q2" vid="PSA 76:5">koro ginindo nindogi mogik;</para>
  <para style="q1" vid="PSA 76:5">kendo onge jolwenygo kata achiel,</para>
  <para style="q2" vid="PSA 76:5">manyalo tingʼo kata mana bade.<verse eid="PSA 76:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6"/>Nikech kwer misekwerogigo, yaye Nyasach Jakobo</para>
  <para style="q2" vid="PSA 76:6">omiyo faras gi gari moywayo ochungʼ kar tiendegi.<verse eid="PSA 76:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7"/>In kendi ema onego oluori.</para>
  <para style="q2" vid="PSA 76:7">Koso en ngʼa manyalo chungʼ e nyimi ka mirima omaki?<verse eid="PSA 76:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8"/>Ne ingʼado bura gie polo,</para>
  <para style="q2" vid="PSA 76:8">mi piny ne luoro omako molingʼ thi.<verse eid="PSA 76:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9"/>Kane ia malo mondo ingʼad bura, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 76:9">mondo ikony ji duto mawinjo marach e piny. <char style="qs">Sela</char><verse eid="PSA 76:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10"/>Kuom adier, mirima ma in-go gi ji, keloni pak,</para>
  <para style="q2" vid="PSA 76:10">kendo miyo joma otony ne mirimbi ritore.<verse eid="PSA 76:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11"/>Singri ne Jehova Nyasaye ma Nyasachi,</para>
  <para style="q2" vid="PSA 76:11">kendo chop singruokgo;</para>
  <para style="q1" vid="PSA 76:11">bende jopinje duto mokiewo kodi,</para>
  <para style="q2" vid="PSA 76:11">okel mich ne Jal monego ji luor.<verse eid="PSA 76:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12"/>Ochodo chuny jotelo,</para>
  <para style="q2" vid="PSA 76:12">kendo ruodhi duto mag piny oluore.<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="cl">Zaburi 77</para>
  <para style="d">Kuom jatend wer. Ne Jeduthun. Mar Asaf. Zaburi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1"/>Ne aywak ni Nyasaye mondo okonya,</para>
  <para style="q2" vid="PSA 77:1">kendo ne aywak ni Nyasaye mondo owinja.<verse eid="PSA 77:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2"/>Kane an e chandruok, ne amanyo Ruoth Nyasaye;</para>
  <para style="q2" vid="PSA 77:2">otieno duto ne arieyo bedena malo ma ok aol,</para>
  <para style="q2" vid="PSA 77:2">kendo chunya nodagi hoch.<verse eid="PSA 77:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3"/>Ne apari mine ahum, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 77:3">ne aol kendo chunya nonyosore. <char style="qs">Sela</char><verse eid="PSA 77:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4"/>Ne imako wengena mi ok oimore,</para>
  <para style="q2" vid="PSA 77:4">kendo ne an gi pek ma ok anyal wuoyo.<verse eid="PSA 77:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5"/>Ne aparo kuom ndalo machon,</para>
  <para style="q2" vid="PSA 77:5">higni machon gi lala;<verse eid="PSA 77:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6"/>ne aparo wendena mag otieno.</para>
  <para style="q2" vid="PSA 77:6">Ne aloso gi pacha awuon, kendo chunya nopenjo kama:<verse eid="PSA 77:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7"/>“Bende Ruoth Nyasaye nyalo dagi ngʼato chuth?</para>
  <para style="q2" vid="PSA 77:7">Bende en adier ni ok obi ochak ongʼwon kendo?<verse eid="PSA 77:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8"/>Bende herane ma ok rem dirum chuth adier?</para>
  <para style="q2" vid="PSA 77:8">Bende singruokne nyalo bare ma ok ochopo nyaka chiengʼ?<verse eid="PSA 77:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9"/>Dibed ni Nyasaye wiye osewil gi kecho ji?</para>
  <para style="q2" vid="PSA 77:9">Koso mirimbe mager osemiyo ok okech joge?” <char style="qs">Sela</char><verse eid="PSA 77:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10"/>Eka naparo niya, “Ma e kama abiro kwayoe kony:</para>
  <para style="q2" vid="PSA 77:10">higni ma lwet Nyasaye Man Malo Moloyo ma korachwich osetieko.<verse eid="PSA 77:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11"/>Abiro siko kaparo timbe Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 77:11">ee, abiro paro kuom honni magi machon gi lala.<verse eid="PSA 77:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12"/>Abiro paro mos kuom tijeni duto,</para>
  <para style="q2" vid="PSA 77:12">abiro paro matut kuom timbeni madongo duto.”<verse eid="PSA 77:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13"/>Yoreni ler, yaye Nyasaye.</para>
  <para style="q2" vid="PSA 77:13">En nyasaye mane maduongʼ kaka Nyasachwa?<verse eid="PSA 77:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14"/>In e Nyasaye matimo honni,</para>
  <para style="q2" vid="PSA 77:14">inyiso tekoni e dier ji mopogore opogore.<verse eid="PSA 77:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15"/>Ne iwaro jogi gi badi maratego,</para>
  <para style="q2" vid="PSA 77:15">jogi ma nyikwa Jakobo gi Josef. <char style="qs">Sela</char><verse eid="PSA 77:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16"/>Pige noneni, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 77:16">pige noneni mi luoro omakogi,</para>
  <para style="q2" vid="PSA 77:16">kendo kude matut notetni.<verse eid="PSA 77:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17"/>Boche polo ne oolo pi piny,</para>
  <para style="q2" vid="PSA 77:17">kendo polo nomor e kor polo,</para>
  <para style="q2" vid="PSA 77:17">ka asernigi mil koni gi koni.<verse eid="PSA 77:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18"/>Mor polo mari nowinji ei yamo mager,</para>
  <para style="q2" vid="PSA 77:18">mil polo mari nomenyo piny duto,</para>
  <para style="q2" vid="PSA 77:18">kendo piny notetni kendo oyiengni.<verse eid="PSA 77:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19"/>Yori nongʼado dier nam,</para>
  <para style="q2" vid="PSA 77:19">yo miluwo nokadho e dier pige maringo matek,</para>
  <para style="q2" vid="PSA 77:19">kata obedo ni kuonde mane tiendeni onyono ne ok nyal ne gi wangʼ.<verse eid="PSA 77:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20"/>Ne itelone jogi ka rombe</para>
  <para style="q2" vid="PSA 77:20">ka gin e lwet Musa gi Harun.<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="cl">Zaburi 78</para>
  <para style="d">
    <char style="tl">Maskil</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">78:0 </char>
      <char style="fl" closed="false">Maskil: </char>
      <char style="ft" closed="false">en kit wer moro mane Daudi owero</char>
    </note> mar Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1"/>Chiknauru itu, yaye un joga,</para>
  <para style="q2" vid="PSA 78:1">winjuru weche mawuok e dhoga.<verse eid="PSA 78:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2"/>Abiro yawo dhoga mondo awuo gi ngeche,</para>
  <para style="q2" vid="PSA 78:2">ee, abiro hulo gik mopondo ma wuoyo kuom gik mane otimore chon gi lala.<verse eid="PSA 78:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3"/>Gik ma wasewinjo kendo ma wangʼeyo,</para>
  <para style="q2" vid="PSA 78:3">mane wuonewa onyisowa.<verse eid="PSA 78:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4"/>Ok wabi pandogi ne nyithindgi;</para>
  <para style="q2" vid="PSA 78:4">to wabiro hulogi ne tiengʼ mabiro timbe mipako mag Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 78:4">gi tekone kod gik miwuoro mosetimo.<verse eid="PSA 78:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5"/>Ne ogolo chike ne joka Jakobo</para>
  <para style="q2" vid="PSA 78:5">kendo noguro chik e piny Israel,</para>
  <para style="q1" vid="PSA 78:5">chike mane omiyo kwerewa</para>
  <para style="q2" vid="PSA 78:5">mondo opuonj nyithindgi,<verse eid="PSA 78:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6"/>mondo tiengʼ mabiro ongʼegi,</para>
  <para style="q2" vid="PSA 78:6">koda ka nyithindo mapok onywol,</para>
  <para style="q2" vid="PSA 78:6">kendo gin bende ginyis nyithindgi.<verse eid="PSA 78:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7"/>Eka mondo mi giket genogi kuom Nyasaye</para>
  <para style="q2" vid="PSA 78:7">kendo kik wigi wil gi gik mosetimo,</para>
  <para style="q2" vid="PSA 78:7">to mondo girit chikene.<verse eid="PSA 78:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8"/>Ne ok ginyal chalo gi kweregi;</para>
  <para style="q2" vid="PSA 78:8">mane tiengʼ ma tokgi tek kendo ma jongʼanyo,</para>
  <para style="q1" vid="PSA 78:8">ma chunjegi ne ok ochiwore ne Nyasaye</para>
  <para style="q2" vid="PSA 78:8">kendo ne ok luwe gi adiera.<verse eid="PSA 78:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9"/>Kata ka jo-Efraim nomanore gi gige lweny,</para>
  <para style="q2" vid="PSA 78:9">to negiringo lweny.<verse eid="PSA 78:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10"/>Ne ok girito singruok mar Nyasaye</para>
  <para style="q2" vid="PSA 78:10">kendo ne gidagi dak ka giluwo chik Nyasaye.<verse eid="PSA 78:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11"/>Wigi nowil gi gik mane osetimo,</para>
  <para style="q2" vid="PSA 78:11">ranyisi mane osenyisogi.<verse eid="PSA 78:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12"/>Ne otimo honni ka wuonegi neno</para>
  <para style="q2" vid="PSA 78:12">e gwengʼ mar Zoan, e piny Misri.<verse eid="PSA 78:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13"/>Ne omiyo nam opogore diere ariyo mi nomiyo gikadho</para>
  <para style="q2" vid="PSA 78:13">kendo nomiyo pi ochungʼ molingʼ thi ka ohinga.<verse eid="PSA 78:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14"/>Ne otayogi kod bor polo godiechiengʼ</para>
  <para style="q2" vid="PSA 78:14">kendo giler moa e mach otieno duto.<verse eid="PSA 78:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15"/>Ne otucho lwanda e thim</para>
  <para style="q2" vid="PSA 78:15">kendo nomiyogi pi mogundho ka nembe;<verse eid="PSA 78:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16"/>bende nomiyo aore obubni kawuok e lwanda kama obarore</para>
  <para style="q2" vid="PSA 78:16">mi pi nomol piny mana ka aora.<verse eid="PSA 78:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17"/>To eka pod negidhi mana nyime ka gitimo richo e nyime</para>
  <para style="q2" vid="PSA 78:17">ka gingʼanyo e thim ne Nyasaye Man Malo Moloyo.<verse eid="PSA 78:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18"/>Ne gitemo Nyasaye ka gingʼeyo,</para>
  <para style="q2" vid="PSA 78:18">kuom kete mondo omigi chiemo mane gigombo.<verse eid="PSA 78:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19"/>Ne giwuoyo marach kuom Nyasaye kagiwacho ni,</para>
  <para style="q2" vid="PSA 78:19">“Nyasaye bende nyalo chano mesa e nyimwa e thim ka?<verse eid="PSA 78:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20"/>Kane ogoyo lwanda to pi nothinyore oko</para>
  <para style="q2" vid="PSA 78:20">kendo aore nochako mol mogundho.</para>
  <para style="q1" vid="PSA 78:20">To chiemo bende domiwa adier?</para>
  <para style="q2" vid="PSA 78:20">Ringʼo bende onyalo kelo mi opog ne joge adier?”<verse eid="PSA 78:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21"/>Kane Jehova Nyasaye owinjo gi ite, iye nowangʼ ahinya,</para>
  <para style="q2" vid="PSA 78:21">mi mach mare notuk kuom joka Jakobo,</para>
  <para style="q2" vid="PSA 78:21">kendo mirimbe mager nobiro kuom jo-Israel,<verse eid="PSA 78:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22"/>nimar ne ok giyie kuom Nyasaye</para>
  <para style="q2" vid="PSA 78:22">kata geno kuom resruok mare.<verse eid="PSA 78:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23"/>To eka pod nogolo chik ne kor polo malo</para>
  <para style="q2" vid="PSA 78:23">kendo noyawo dhoudi mag polo;<verse eid="PSA 78:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24"/>ne oolo mana piny ka koth mondo ji ocham,</para>
  <para style="q2" vid="PSA 78:24">adier, nomiyogi chiemb polo.<verse eid="PSA 78:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25"/>Ji nochamo makati mar malaike,</para>
  <para style="q2" vid="PSA 78:25">kendo nooronegi kit chiemo duto mane ginyalo chamo.<verse eid="PSA 78:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26"/>Ne ogonyo yamb ugwe moa e polo,</para>
  <para style="q2" vid="PSA 78:26">kendo nogolo yamb milambo gi tekone.<verse eid="PSA 78:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27"/>Nolwaro ringʼo piny kuomgi ka buru, adier,</para>
  <para style="q2" vid="PSA 78:27">winy mafuyo nolwar kuomgi ka kwoyo manie dho nam.<verse eid="PSA 78:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28"/>Nomiyo winyogo olwar piny nyaka ei kambi</para>
  <para style="q2" vid="PSA 78:28">mine gilworo hembegi duto koni gi koni.<verse eid="PSA 78:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29"/>Negichiemo mi chiemo otamogi tieko,</para>
  <para style="q2" vid="PSA 78:29">nimar nomiyogi gima ne chunygi gombo.<verse eid="PSA 78:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30"/>To kane pok gitieko chiembgi mar gombono,</para>
  <para style="q2" vid="PSA 78:30">chutho, ka chiemo ne pod opongʼo dhogi,<verse eid="PSA 78:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31"/>mirima mager mar Nyasaye nogore kuomgi,</para>
  <para style="q2" vid="PSA 78:31">mi nomiyo jogi maroteke otho,</para>
  <para style="q2" vid="PSA 78:31">kendo nopielo yawuot Israel ma pod tindo piny.<verse eid="PSA 78:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32"/>To kata obedo ni magi duto nosetimore,</para>
  <para style="q2" vid="PSA 78:32">pod negidhi mana nyime gitimo richo;</para>
  <para style="q1" vid="PSA 78:32">pod ne ok giyie kuome,</para>
  <para style="q2" vid="PSA 78:32">kata obedo ni ne osetimo ranyisi mathoth e diergi.<verse eid="PSA 78:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33"/>Omiyo nomiyo ngimagi orumo kaonge ber</para>
  <para style="q2" vid="PSA 78:33">kendo higni mag-gi nopongʼ gi masiche mabwogo ji.<verse eid="PSA 78:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34"/>E kinde moro amora mane Nyasaye okumogie, to ne gimanye</para>
  <para style="q2" vid="PSA 78:34">mine gilokore ka gidware gi siso.<verse eid="PSA 78:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35"/>Negiparo ni Nyasaye ema ne en lwanda margi,</para>
  <para style="q2" vid="PSA 78:35">kendo ni Nyasaye Man Malo Moloyo ema ne en Jawargi.<verse eid="PSA 78:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36"/>To kata kamano ne gichare achara gi dhogi,</para>
  <para style="q2" vid="PSA 78:36">ka giwuonde gi lewgi.<verse eid="PSA 78:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37"/>Nimar chunygi ne ok omoko kuome,</para>
  <para style="q2" vid="PSA 78:37">kendo ne ok gilu singruokne kuom adier.<verse eid="PSA 78:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38"/>To en, kaka en ngʼama kecho ji,</para>
  <para style="q2" vid="PSA 78:38">noweyonegi kethogi,</para>
  <para style="q2" vid="PSA 78:38">kendo ne ok otiekogi.</para>
  <para style="q1" vid="PSA 78:38">Kinde ka kinde nogengʼo mirimbe</para>
  <para style="q2" vid="PSA 78:38">kendo ne ok otoyo mirimbe duto kuomgi.<verse eid="PSA 78:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39"/>Noparo kaka ne gin mana dhano adhana</para>
  <para style="q2" vid="PSA 78:39">machalo yamo makalo kendo ok chak duogi.<verse eid="PSA 78:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40"/>Mano kaka ne gingʼanyone e thim nyadi mangʼeny</para>
  <para style="q2" vid="PSA 78:40">kendo negimiye chuny lit e piny motwo!<verse eid="PSA 78:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41"/>Ne gitemo Nyasaye kinde mangʼeny,</para>
  <para style="q2" vid="PSA 78:41">kendo negimiyo Jal Maler mar Israel osin.<verse eid="PSA 78:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42"/>Ne ok giparo tekone,</para>
  <para style="q2" vid="PSA 78:42">kendo ne ok giparo odiechiengʼ mane owarogi e lwet jasigu,<verse eid="PSA 78:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43"/>odiechiengʼ mane onyiso e lela honni mage e piny Misri</para>
  <para style="q2" vid="PSA 78:43">kane otimo ranyisino e gwengʼ mar Zoan.<verse eid="PSA 78:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44"/>Noloko aoregi remo mi koro</para>
  <para style="q2" vid="PSA 78:44">ne ok ginyal modho pi moa e aoregi.<verse eid="PSA 78:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45"/>Ne ooro bonyo mag lwangʼni mane omwonyogi,</para>
  <para style="q2" vid="PSA 78:45">gi ogwende mane oketho pinygi.<verse eid="PSA 78:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46"/>Ne ochiwo chambgi ne ongogo,</para>
  <para style="q2" vid="PSA 78:46">chambgi mosechiek ne bonyo.<verse eid="PSA 78:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47"/>Ne oketho olembegi mag mzabibu gi pe,</para>
  <para style="q2" vid="PSA 78:47">kod yiendegi mag ngʼowu gi yamo mangʼich.<verse eid="PSA 78:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48"/>Ne ochiwo jambgi ne pe,</para>
  <para style="q2" vid="PSA 78:48">kendo nomiyo dhogegi polo ogoyo.<verse eid="PSA 78:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49"/>Ne oolo kuomgi mirimbe maliet,</para>
  <para style="q2" vid="PSA 78:49">kokecho kendo iye owangʼ kendo oger;</para>
  <para style="q2" vid="PSA 78:49">oganda malaike ma jonek.<verse eid="PSA 78:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50"/>Ne olosone mirimbe yo maluwo,</para>
  <para style="q2" vid="PSA 78:50">kendo ne ok okechogi e tho, to ne ojwangʼogi,</para>
  <para style="q2" vid="PSA 78:50">mondo tho otiekgi.<verse eid="PSA 78:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51"/>Ne onego kach jo-Misri duto,</para>
  <para style="q2" vid="PSA 78:51">mana olemo mokwongo chiek mag dhano e hembe mag Ham.<verse eid="PSA 78:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52"/>To joge to nogolo oko mana ka kweth,</para>
  <para style="q2" vid="PSA 78:52">kendo notelonegi ka rombe koyoro kodgi thim.<verse eid="PSA 78:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53"/>Ne otayogi maber omiyo ne gionge gi luoro,</para>
  <para style="q2" vid="PSA 78:53">to wasikgi to ne nam omwonyo.<verse eid="PSA 78:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54"/>Kamano e kaka ne okelogi nyaka e tongʼ mar pinje maler,</para>
  <para style="q2" vid="PSA 78:54">nyaka ne gitundo e piny motimo gode,</para>
  <para style="q2" vid="PSA 78:54">ma lwete ma korachwich nosekawo.<verse eid="PSA 78:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55"/>Ne oriembo ogendini e nyimgi</para>
  <para style="q2" vid="PSA 78:55">kendo nomiyogi lopgi kaka girkeni margi,</para>
  <para style="q2" vid="PSA 78:55">mi nomiyo dhout Israel odak e miechgi giwegi.<verse eid="PSA 78:55"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56"/>To kata kamano ne gitemo Nyasaye,</para>
  <para style="q2" vid="PSA 78:56">mine gingʼanyone Nyasaye Man Malo Moloyo;</para>
  <para style="q2" vid="PSA 78:56">ka gidagi rito chikene.<verse eid="PSA 78:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57"/>Mana kaka wuonegi ne ok giwinje kendo ne ok gin jo-adiera</para>
  <para style="q2" vid="PSA 78:57">kendo ne gichalo atungʼ mobam ma ok nyal gen.<verse eid="PSA 78:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58"/>Ne giwangʼo iye gi kuondegi motingʼore malo,</para>
  <para style="q2" vid="PSA 78:58">kendo ne gichiewo nyiego mare gi nyisechegi mane giloso.<verse eid="PSA 78:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59"/>Kane Nyasaye owinjogi, iye nowangʼ ahinya,</para>
  <para style="q2" vid="PSA 78:59">kendo nokwedo jo-Israel chuth.<verse eid="PSA 78:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60"/>Ne ojwangʼo Hemb Romo mane ni Shilo,</para>
  <para style="q2" vid="PSA 78:60">mane en hema mane oguro owuon e dier ji.<verse eid="PSA 78:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61"/>Nooro Sandug Muma e twech,</para>
  <para style="q2" vid="PSA 78:61">mi duongʼne maler nodhi e lwet wasigu.<verse eid="PSA 78:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62"/>Nochiwo joge ne ligangla,</para>
  <para style="q2" vid="PSA 78:62">kendo nokecho ahinya gi girkeni mare.<verse eid="PSA 78:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63"/>Mach notieko yawuotgi matindo,</para>
  <para style="q2" vid="PSA 78:63">kendo nyigi ne ok owernegi wende kisera;<verse eid="PSA 78:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64"/>jodologi ne onegi,</para>
  <para style="q2" vid="PSA 78:64">kendo mondegi ne ywak otamo.<verse eid="PSA 78:64"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65"/>Eka Ruoth Nyasaye nochiew ka gima oa e nindo,</para>
  <para style="q2" vid="PSA 78:65">mana kaka ngʼato chiewo, bangʼ madho divai mangʼeny.<verse eid="PSA 78:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66"/>Ne oriembo wasike gi goch,</para>
  <para style="q2" vid="PSA 78:66">kendo nomiyo giyudo wichkuot mosiko.<verse eid="PSA 78:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67"/>Ne odagi hembe mag Josef,</para>
  <para style="q2" vid="PSA 78:67">bende ne ok oyiero dhood joka Efraim,<verse eid="PSA 78:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68"/>to dhood joka Juda ema ne oyiero,</para>
  <para style="q2" vid="PSA 78:68">ee, noyiero mana Got Sayun, mane ohero.<verse eid="PSA 78:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69"/>Ne ogero kare maler mar lemo, ka gode maboyo,</para>
  <para style="q2" vid="PSA 78:69">kendo mana ka piny mane oguro nyaka chiengʼ.<verse eid="PSA 78:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70"/>Ne oyiero Daudi jatichne,</para>
  <para style="q2" vid="PSA 78:70">kendo nogole e abich rombe;<verse eid="PSA 78:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71"/>nogole e tij rito rombe mokele</para>
  <para style="q2" vid="PSA 78:71">mondo okwa joge ma nyikwa Jakobo,</para>
  <para style="q2" vid="PSA 78:71">mondo okwa Israel girkeni mare.<verse eid="PSA 78:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72"/>Kuom mano Daudi nokwayogi gi chuny makare</para>
  <para style="q2" vid="PSA 78:72">kendo notelonegi, gi lwedo mongʼith.<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="cl">Zaburi 79</para>
  <para style="d">Zaburi mar Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1"/>Yaye Nyasaye, ogendini osemonjo girkeni mari;</para>
  <para style="q2" vid="PSA 79:1">gisedwanyo hekalu mari maler,</para>
  <para style="q2" vid="PSA 79:1">kendo giseketho Jerusalem modongʼ pidhe pidhe.<verse eid="PSA 79:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2"/>Gisechiwo ringre jogi motho</para>
  <para style="q2" vid="PSA 79:2">mondo obed chiemb winy manie kor polo,</para>
  <para style="q2" vid="PSA 79:2">ring jogi maler gisechiwo ne ondiegi mag piny.<verse eid="PSA 79:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3"/>Giseolo remo</para>
  <para style="q2" vid="PSA 79:3">e alwora mar Jerusalem ka pi,</para>
  <para style="q2" vid="PSA 79:3">kendo koro onge ngʼama nyalo yiko joma otho.<verse eid="PSA 79:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4"/>Waselokore gima kuodo wich ne jobutwa,</para>
  <para style="q2" vid="PSA 79:4">joma ijaro kendo inyiero gi joma olworowa.<verse eid="PSA 79:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5"/>Nyaka karangʼo, yaye Jehova Nyasaye? Ibiro kecho nyaka chiengʼ koso?</para>
  <para style="q2" vid="PSA 79:5">Nyaka karangʼo ma nyiego mari biro lielie ka mach?<verse eid="PSA 79:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6"/>Ol mirimbi kuom pinjeruodhi,</para>
  <para style="q1" vid="PSA 79:6">adier ol mirimbi kuom ogendini</para>
  <para style="q2" vid="PSA 79:6">ma ok luong nyingi;<verse eid="PSA 79:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7"/>nimar gisengamo Jakobo</para>
  <para style="q2" vid="PSA 79:7">mi giketho gwengʼe.<verse eid="PSA 79:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8"/>Kik ikwanwa kaka joketho,</para>
  <para style="q2" vid="PSA 79:8">nikech richo mag wuonewa;</para>
  <para style="q1" vid="PSA 79:8">mad kechni bi romnwa piyo,</para>
  <para style="q2" vid="PSA 79:8">nimar osedwokwa piny marach.<verse eid="PSA 79:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9"/>Konywa, yaye Nyasaye ma Jawarwa,</para>
  <para style="q2" vid="PSA 79:9">nikech duongʼ mar nyingi;</para>
  <para style="q1" vid="PSA 79:9">reswa kendo wenwa richowa,</para>
  <para style="q2" vid="PSA 79:9">mondo nyingi oyud duongʼ.<verse eid="PSA 79:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10"/>Angʼo momiyo ogendini onego owach ni,</para>
  <para style="q2" vid="PSA 79:10">“Nyasachgino to ni kanye?”</para>
  <para style="b" vid="PSA 79:10"/>
  <para style="q1" vid="PSA 79:10">Mi ogendini ongʼe, ka waneno gi wangʼwa,</para>
  <para style="q2" vid="PSA 79:10">ni ichulo kuor nikech remb jogi mosechwer.<verse eid="PSA 79:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11"/>Mad chur ma joma otwe churgo chopi e nyimi;</para>
  <para style="q2" vid="PSA 79:11">rit ngima joma osengʼad nigi buch tho,</para>
  <para style="q2" vid="PSA 79:11">gi teko mar badi.<verse eid="PSA 79:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12"/>Chul kuor ne jobutwa nyadibiriyo kigoyo bembegi.</para>
  <para style="q2" vid="PSA 79:12">Kuom ayany ma gisediro kuomi, yaye Jehova Nyasaye.<verse eid="PSA 79:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13"/>Eka jogi, ma gin rombegi mikwayo,</para>
  <para style="q2" vid="PSA 79:13">biro paki nyaka chiengʼ,</para>
  <para style="q1" vid="PSA 79:13">kendo wabiro nyiso pakni,</para>
  <para style="q2" vid="PSA 79:13">koa e tiengʼ moro nyaka tiengʼ machielo.<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="cl">Zaburi 80</para>
  <para style="d">Kuom jatend wer. E dwol mar “Ondanyo mar Singruok.” Mar Asaf. Zaburi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1"/>Chiknwa iti, yaye Jakwadh jo-Israel,</para>
  <para style="q2" vid="PSA 80:1">in mitelo ne Josef ka kweth mar dhok.</para>
  <para style="q1" vid="PSA 80:1">In mibet e kom loch e kind kerubi,</para>
  <para style="q2" vid="PSA 80:1">koro rieny ane <verse eid="PSA 80:1"/><verse number="2" style="v" sid="PSA 80:2"/>e nyim Efraim, gi Benjamin gi Manase.</para>
  <para style="q2" vid="PSA 80:2">Nyis tekri,</para>
  <para style="q2" vid="PSA 80:2">kendo bi mondo ireswa.<verse eid="PSA 80:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3"/>Dwogwa iri, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 80:3">mi wangʼi orienynwa,</para>
  <para style="q2" vid="PSA 80:3">eka mondo wayud warruok.<verse eid="PSA 80:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4"/>Yaye Jehova Nyasaye, ma Nyasaye Maratego,</para>
  <para style="q2" vid="PSA 80:4">mirimbi biro siko koyienyo,</para>
  <para style="q2" vid="PSA 80:4">gi lamo mar jogi nyaka karangʼo?<verse eid="PSA 80:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5"/>Isemiyo gichamo pi wangʼ ka kuon</para>
  <para style="q2" vid="PSA 80:5">kendo isemiyo gimodho pi wangʼ agwetni modhuro.<verse eid="PSA 80:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6"/>Isemiyo wadoko rachwany ne jobutwa,</para>
  <para style="q2" vid="PSA 80:6">kendo wasikwa jarowa.<verse eid="PSA 80:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7"/>Dwogwa iri, yaye Nyasaye Maratego;</para>
  <para style="q2" vid="PSA 80:7">mi wangʼi orienynwa, eka mondo wayud warruok.<verse eid="PSA 80:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8"/>Ne igolo mzabibu moro e piny Misri,</para>
  <para style="q2" vid="PSA 80:8">kendo ne iriembo ogendini mi ipidhe kargi.<verse eid="PSA 80:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9"/>Ne ilosone lowo maber,</para>
  <para style="q2" vid="PSA 80:9">kendo nochwoyo tiendene piny mi opongʼo piny.<verse eid="PSA 80:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10"/>Tipo Nyasaye noimo gode duto,</para>
  <para style="q2" vid="PSA 80:10">mana ka yiende sida ma odongo ma bedene olak.<verse eid="PSA 80:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11"/>Noyaro bedene madongo nyaka e Nam Mediterania</para>
  <para style="q2" vid="PSA 80:11">kendo noloth mochweyo nyaka e Aora Yufrate.<verse eid="PSA 80:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12"/>Koro angʼo momiyo isemuko ohinga mage,</para>
  <para style="q2" vid="PSA 80:12">momiyo ji duto makadho pone ka olemo.<verse eid="PSA 80:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13"/>Mbithe moa e bungu kethe, kendo le mag bungu chame.<verse eid="PSA 80:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14"/>Duog irwa, yaye Nyasaye Maratego!</para>
  <para style="q2" vid="PSA 80:14">Ngʼi piny gie polo mondo ine!</para>
  <para style="q1" vid="PSA 80:14">Ngʼi mzabibu maber,<verse eid="PSA 80:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 80:15"/>yien ma lweti ma korachwich ema nopidho gi tiende,</para>
  <para style="q2" vid="PSA 80:15">ma en wuodi misepidho in iwuon.<verse eid="PSA 80:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16"/>Mzabibu mari osetongʼ mi owangʼ gi mach,</para>
  <para style="q2" vid="PSA 80:16">jogi lal nono nikech isekwerogi.<verse eid="PSA 80:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17"/>Mad lweti bed kuom ngʼat mobet e bathi korachwich,</para>
  <para style="q2" vid="PSA 80:17">ma en wuod dhano misemiyo teko in iwuon.<verse eid="PSA 80:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18"/>Eka ok wanachak walokre waweyi;</para>
  <para style="q2" vid="PSA 80:18">konywa wabed mangima, kendo wabiro pako nyingi.<verse eid="PSA 80:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19"/>Dwogwa iri, yaye Jehova Nyasaye, ma Nyasaye Maratego;</para>
  <para style="q2" vid="PSA 80:19">mi wangʼi orienynwa,</para>
  <para style="q2" vid="PSA 80:19">eka mondo wayud warruok.<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="cl">Zaburi 81</para>
  <para style="d">Kuom jatend wer. Wer mower kaluwore gi <char style="tl">Gitith</char><note caller="+" style="f"><char style="fr" closed="false">81:0 </char><char style="fl" closed="false">Gitith: </char><char style="ft" closed="false">Ochalo ni en kit wer moro</char></note>. Mar Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1"/>Weruru matek gi mor ne Nyasaye mamiyowa teko,</para>
  <para style="q2" vid="PSA 81:1">gouru koko matek ne Nyasach Jakobo!<verse eid="PSA 81:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2"/>Chakuru wer, yiekuru oyieke;</para>
  <para style="q2" vid="PSA 81:2">gweluru nyatiti gi asili mamit.<verse eid="PSA 81:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3"/>Gouru tung im ka dwe manyien ochakore,</para>
  <para style="q2" vid="PSA 81:3">ma en ka dwe osetegno, e odiechiengʼ mar Nyasiwa mogen.<verse eid="PSA 81:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4"/>Ma en gima ochuno jo-Israel;</para>
  <para style="q2" vid="PSA 81:4">chik ma Nyasach Jakobo nogolo.<verse eid="PSA 81:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5"/>Kane Nyasaye mirima omako gi jo-Misri,</para>
  <para style="q2" vid="PSA 81:5">to ne ogure kaka chik ne Josef.</para>
  <para style="b" vid="PSA 81:5"/>
  <para style="q1" vid="PSA 81:5">Ne awinjo dwol ma ok angʼeyo kuma oaye kawacho kama:<verse eid="PSA 81:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6"/>“Ne agolo tingʼ mapek e gokgi,</para>
  <para style="q2" vid="PSA 81:6">mi lwetgi nogony e tingʼo atonge.<verse eid="PSA 81:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7"/>Ne iluongo ka in e chandruok mi akonyi,</para>
  <para style="q2" vid="PSA 81:7">ne adwoki gi ei boche polo,</para>
  <para style="q2" vid="PSA 81:7">kendo ne atemi e tie pige mag Meriba. <char style="qs">Sela</char><verse eid="PSA 81:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8"/>“Winjuru wach, yaye joga, to abiro siemou,</para>
  <para style="q2" vid="PSA 81:8">abiro siemou ka uikoru mar winja, yaye Israel.<verse eid="PSA 81:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9"/>Kik ubed gi nyasaye ma wendo e dieru,</para>
  <para style="q2" vid="PSA 81:9">kendo kik ukulru ne nyasaye ma ukia.<verse eid="PSA 81:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10"/>An Jehova Nyasaye, ma Nyasachu, mane ogolou Misri.</para>
  <para style="q2" vid="PSA 81:10">Ngʼamuru dhou malach mondo apongʼe.<verse eid="PSA 81:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11"/>“To joga nodagi winjo dwonda</para>
  <para style="q2" vid="PSA 81:11">kendo Israel nodagi timo kaka achikogi.<verse eid="PSA 81:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12"/>Omiyo ne aweyogi nikech chunygi ne tek,</para>
  <para style="q2" vid="PSA 81:12">kendo negiluwo yoregi giwegi.<verse eid="PSA 81:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13"/>“Ka dine joga yie winja,</para>
  <para style="q2" vid="PSA 81:13">ka dine Israel yie lu yorena,<verse eid="PSA 81:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14"/>mano kaka dine atieko wasikgi piyo piyo</para>
  <para style="q2" vid="PSA 81:14">kendo dine agoyo joma kedo kodgi gi lweta!<verse eid="PSA 81:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15"/>Joma ochayo Jehova Nyasaye dine okulorene gi luoro,</para>
  <para style="q2" vid="PSA 81:15">kendo kum margi osiko nyaka chiengʼ.<verse eid="PSA 81:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16"/>To un dine apidhou gi ngano maber mogik,</para>
  <para style="q2" vid="PSA 81:16">kendo dine aromou gi mor kich ma athodho e lwanda.”<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="cl">Zaburi 82</para>
  <para style="d">Zaburi mar Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1"/>Nyasaye osekawo kare e dier chokruok maduongʼ,</para>
  <para style="q2" vid="PSA 82:1">ongʼado bura e kind “nyiseche.”<verse eid="PSA 82:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2"/>Nyaka karangʼo ma ubiro dhi nyime ka udewo wangʼ joma ok timbegi nikare</para>
  <para style="q2" vid="PSA 82:2">kendo kudewo wangʼ joma timbegi richo? <char style="qs">Sela</char><verse eid="PSA 82:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3"/>Ngʼaduru bura makare ne joma ok nyal kod nyithi kiye,</para>
  <para style="q2" vid="PSA 82:3">kendo konyuru joma odhier kod joma ok nyal konyore kendgi.<verse eid="PSA 82:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4"/>Resuru joma ok nyal kod joma ochando;</para>
  <para style="q2" vid="PSA 82:4">golgiuru e lwet joma timbegi richo.<verse eid="PSA 82:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5"/>To gisesiko ka gimemore kendo onge gima gingʼeyo.</para>
  <para style="q2" vid="PSA 82:5">Giwuotho koni gi koni e mudho;</para>
  <para style="q2" vid="PSA 82:5">kendo gimiyo mise duto mag piny yiengni.<verse eid="PSA 82:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6"/>“Asenyisou ni, ‘Un “nyiseche;”</para>
  <para style="q2" vid="PSA 82:6">kendo ni un duto un yawuot Nyasaye Man Malo Moloyo.’<verse eid="PSA 82:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7"/>To ubiro tho ka ji ajia;</para>
  <para style="q2" vid="PSA 82:7">adier ubiro podho mana kaka jatelo moro amora ma ok otangʼ.”<verse eid="PSA 82:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8"/>Aa malo, yaye Nyasaye, ngʼadni piny bura,</para>
  <para style="q2" vid="PSA 82:8">nimar ogendini duto gin girkeni magi.<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="cl">Zaburi 83</para>
  <para style="d">Wer. Zaburi mar Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1"/>Kik ilingʼ, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 83:1">kik iywe, yaye Nyasaye, bende kik ibed mos.<verse eid="PSA 83:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2"/>Neye kaka wasiki piem kodi gi koko maduongʼ.</para>
  <para style="q2" vid="PSA 83:2">Neye kaka joma kedo kodi ngʼanyoni.<verse eid="PSA 83:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3"/>Gichano timo ne jogi marach lingʼ-lingʼ;</para>
  <para style="q2" vid="PSA 83:3">giloso chenro maricho ne joma chunyi ohero.<verse eid="PSA 83:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4"/>Giwacho niya, “Biuru watiekgi mi girum pep kaka oganda,</para>
  <para style="q2" vid="PSA 83:4">mondo nying mar Israel kik chak par kendo.”<verse eid="PSA 83:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5"/>Giloso chenro ka giriwo pachgi bedo achiel,</para>
  <para style="q2" vid="PSA 83:5">gilosoni riwruok mondo giked kodi.<verse eid="PSA 83:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6"/>Gin jo-Edom gi jo-Ishmael, jo-Moab gi jo-Hagri,<verse eid="PSA 83:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7"/>jo-Gebal, jo-Amon kod jo-Amalek,</para>
  <para style="q2" vid="PSA 83:7">jo-Filistia kaachiel gi joma odak Turo.<verse eid="PSA 83:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8"/>Nyaka jo-Asuria bende oseriwore kodgi</para>
  <para style="q2" vid="PSA 83:8">mondo oriw lwetgi ne nyikwa Lut. <char style="qs">Sela</char><verse eid="PSA 83:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9"/>Timnegi kaka ne itimo ne Midian,</para>
  <para style="q2" vid="PSA 83:9">mana kaka nitimo ne Sisera gi Jabin e Aora Kishon,<verse eid="PSA 83:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10"/>mane jotho Endor</para>
  <para style="q2" vid="PSA 83:10">modoko owuoyo mar dhok e lowo.<verse eid="PSA 83:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11"/>Mi jogi momew ochal gi Oreb kod Zeb</para>
  <para style="q2" vid="PSA 83:11">mi ruodhigi duto chal gi Zeba kod Zalmuna,<verse eid="PSA 83:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12"/>mane jowacho niya,</para>
  <para style="q2" vid="PSA 83:12">“Wakawuru pewe mag kwath mag Nyasaye mondo obed marwa.”<verse eid="PSA 83:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13"/>Mi gichal gi buya mayot-yot, yaye Nyasacha,</para>
  <para style="q2" vid="PSA 83:13">mi gichal gi mihudhwe ma yamo tero.<verse eid="PSA 83:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14"/>Mana kaka mach wangʼo bungu maduongʼ</para>
  <para style="q2" vid="PSA 83:14">kata kaka mach wangʼo wi got,<verse eid="PSA 83:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15"/>e kaka in bende ilawgi gi ahiti maduongʼ</para>
  <para style="q2" vid="PSA 83:15">kendo ibwog-gi gi yambi makudho matek.<verse eid="PSA 83:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16"/>Pongʼ wengegi gi wichkuot</para>
  <para style="q2" vid="PSA 83:16">mondo ji omany nyingi, yaye Jehova Nyasaye.<verse eid="PSA 83:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17"/>Mad wigi kuodi nyaka chiengʼ kendo gisiki ka luoro omakogi;</para>
  <para style="q2" vid="PSA 83:17">mad gilal nono ka gin gi wichkuot.<verse eid="PSA 83:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18"/>Mi gingʼe ni in, ma nyingi Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 83:18">ni in kendi e Nyasaye Man Malo Moloyo kendo ni iloyo piny duto.<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="cl">Zaburi 84</para>
  <para style="d">Kuom jatend wer. Kaluwore gi <char style="tl">gitith</char><note caller="+" style="f"><char style="fr" closed="false">84:0 </char><char style="fl" closed="false">Gitith: </char><char style="ft" closed="false">Ochalo ni en kit wer moro</char></note>. Zaburi mar Yawuot Kora.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1"/>Mano kaka hekalu mari ber miwuoro,</para>
  <para style="q2" vid="PSA 84:1">yaye Jehova Nyasaye Maratego!<verse eid="PSA 84:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2"/>Chunya gombo kendo njawni</para>
  <para style="q2" vid="PSA 84:2">ka agombo bedo e od Jehova Nyasaye;</para>
  <para style="q1" vid="PSA 84:2">Chunya gi denda duto wer gi mor</para>
  <para style="q2" vid="PSA 84:2">ne Nyasaye mangima.<verse eid="PSA 84:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3"/>Nyaka winj oyundi oseloso kar dakne,</para>
  <para style="q2" vid="PSA 84:3">kendo opija bende osegero ode,</para>
  <para style="q2" vid="PSA 84:3">kama onyalo nywole nyithinde,</para>
  <para style="q1" vid="PSA 84:3">but kendoni mar misango,</para>
  <para style="q2" vid="PSA 84:3">yaye Jehova Nyasaye Maratego,</para>
  <para style="q2" vid="PSA 84:3">ma Ruodha kendo Nyasacha.<verse eid="PSA 84:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4"/>Ogwedh joma odak e odi;</para>
  <para style="q2" vid="PSA 84:4">mosiko ka paki. <char style="qs">Sela</char><verse eid="PSA 84:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5"/>Ogwedh joma tekregi ni kuomi</para>
  <para style="q2" vid="PSA 84:5">jogo moketo chunygi e luwo yori maler.<verse eid="PSA 84:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6"/>Ka gikadho e Holo mar Baka</para>
  <para style="q2" vid="PSA 84:6">to gimiyo obedo kama opongʼ gi sokni;</para>
  <para style="q2" vid="PSA 84:6">kendo kodh opon bende pongʼe gi yewni.<verse eid="PSA 84:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7"/>Tekreni osiko medore ameda,</para>
  <para style="q2" vid="PSA 84:7">nyaka chop moro ka moro kuomgi chop Sayun e nyim Nyasaye.<verse eid="PSA 84:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8"/>Yie iwinj lemona, yaye Jehova Nyasaye, ma Nyasaye Maratego;</para>
  <para style="q2" vid="PSA 84:8">chikna iti, yaye Nyasach Jakobo. <char style="qs">Sela</char><verse eid="PSA 84:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9"/>Tingʼ wangʼi ine okumbawa, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 84:9">rang ngʼati miwiro gi ngʼwono.<verse eid="PSA 84:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10"/>Bet e laru mari kuom odiechiengʼ achiel ber</para>
  <para style="q2" vid="PSA 84:10">moloyo bet kamachielo kuom higni alufu achiel;</para>
  <para style="q1" vid="PSA 84:10">daher bedo jarit dhoot e od Nyasacha,</para>
  <para style="q2" vid="PSA 84:10">moloyo dak e hembe joma timbegi richo.<verse eid="PSA 84:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11"/>Nimar Jehova Nyasaye en chiengʼ kendo en okumba;</para>
  <para style="q2" vid="PSA 84:11">Jehova Nyasaye chiwo ngʼwono gi duongʼ;</para>
  <para style="q1" vid="PSA 84:11">ok otuon joma wuodhgi oriere tir</para>
  <para style="q2" vid="PSA 84:11">gimoro amora maber.<verse eid="PSA 84:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12"/>Yaye Jehova Nyasaye Maratego,</para>
  <para style="q2" vid="PSA 84:12">ngʼama ogeno kuomi ogwedhi.<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="cl">Zaburi 85</para>
  <para style="d">Kuom jatend wer. Zaburi mar yawuot Kora.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1"/>Ne itimo maber ne piny, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 85:1">ne iduogone Jakobo mwandune.<verse eid="PSA 85:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2"/>Ne iweyone jogi kethogi</para>
  <para style="q2" vid="PSA 85:2">kendo ne iumo richogi duto. <char style="qs">Sela</char><verse eid="PSA 85:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3"/>Mirimbi duto ne iketo tenge,</para>
  <para style="q2" vid="PSA 85:3">kendo ne ilokori iweyo mirimbi mager.<verse eid="PSA 85:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4"/>Dwogwa iri kendo, yaye Nyasaye Jawarwa,</para>
  <para style="q2" vid="PSA 85:4">kendo gol kecho mikechogo kodwa iter mabor.<verse eid="PSA 85:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5"/>Ibiro kecho kodwa nyaka chiengʼ koso?</para>
  <para style="q2" vid="PSA 85:5">Koso ibiro choro mirimbi e tienge duto?<verse eid="PSA 85:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6"/>Angʼo mamoni duogowa iri kendo,</para>
  <para style="q2" vid="PSA 85:6">mondo eka jogi obed mamor kuomi?<verse eid="PSA 85:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7"/>Nyiswa herani ma ok rem, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 85:7">kendo mi wayud resruok mari.<verse eid="PSA 85:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8"/>Abiro chiko ita ne gima Nyasaye, ma Jehova Nyasaye biro wacho;</para>
  <para style="q2" vid="PSA 85:8">osingo kwe ne joge ma joratiro,</para>
  <para style="q2" vid="PSA 85:8">to nyaka gine ni ok gidok e timbe mofuwo.<verse eid="PSA 85:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9"/>Adier, resruokne ni machiegni gi joma omiye luor,</para>
  <para style="q2" vid="PSA 85:9">kendo duongʼne biro bet e pinywa.<verse eid="PSA 85:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10"/>Hera gi adiera biro riwore kanyakla,</para>
  <para style="q2" vid="PSA 85:10">kendo tim makare gi kwe biro nyodhore.<verse eid="PSA 85:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11"/>Adiera biro aa piny kochomo malo,</para>
  <para style="q2" vid="PSA 85:11">kendo tim makare biro ngʼiyo piny gie polo.<verse eid="PSA 85:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12"/>Jehova Nyasaye biro miyowa gima ber adier</para>
  <para style="q2" vid="PSA 85:12">kendo pinywa biro chiego chambe.<verse eid="PSA 85:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13"/>Tim makare biro telo nyime</para>
  <para style="q2" vid="PSA 85:13">kendo biro loso yo ne okangene.<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="cl">Zaburi 86</para>
  <para style="d">Lemo mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1"/>Winj lamona, yaye Jehova Nyasaye, kendo dwoka,</para>
  <para style="q2" vid="PSA 86:1">nimar adhier kendo achando.<verse eid="PSA 86:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2"/>Rit ngimana, nikech achiworani.</para>
  <para style="q2" vid="PSA 86:2">In e Nyasacha, omiyo res ngima jatichni,</para>
  <para style="q2" vid="PSA 86:2">mogeno kuomi.<verse eid="PSA 86:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3"/>Kecha, yaye Ruoth Nyasaye,</para>
  <para style="q2" vid="PSA 86:3">nimar aywakni odiechiengʼ duto.<verse eid="PSA 86:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4"/>Mi jatichni obed mamor, yaye Ruoth Nyasaye,</para>
  <para style="q2" vid="PSA 86:4">nimar in ema aketo genona kuomi.<verse eid="PSA 86:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5"/>Nikech in iber kendo iweyo richo, yaye Ruoth Nyasaye</para>
  <para style="q2" vid="PSA 86:5">in gihera mangʼeny kuom joma luongi.<verse eid="PSA 86:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6"/>Winj lamona, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 86:6">chik iti ne ywakna ma akwayigo kech.<verse eid="PSA 86:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7"/>Chiengʼ ma chandruok omaka</para>
  <para style="q2" vid="PSA 86:7">to abiro luongi mondo ikonya, nimar ibiro dwoka.<verse eid="PSA 86:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8"/>Onge nyasaye moro amora e dier nyiseche machalo kodi, yaye Ruoth Nyasaye;</para>
  <para style="q2" vid="PSA 86:8">onge timbe minyalo pimo gi magi.<verse eid="PSA 86:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9"/>Ogendini duto michweyo</para>
  <para style="q2" vid="PSA 86:9">biro lami kapodho e nyimi, yaye Ruoth Nyasaye;</para>
  <para style="q2" vid="PSA 86:9">bende gibiro miyo nyingi duongʼ.<verse eid="PSA 86:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10"/>Nimar iduongʼ kendo itimo timbe miwuoro;</para>
  <para style="q2" vid="PSA 86:10">in e Nyasaye kende.<verse eid="PSA 86:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11"/>Puonja yoreni, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 86:11">mondo eka awuothi e adierani;</para>
  <para style="q1" vid="PSA 86:11">miya chuny ma ok ba koni gi koni,</para>
  <para style="q2" vid="PSA 86:11">mondo omi aluor nyingi.<verse eid="PSA 86:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12"/>Abiro paki gi chunya duto, yaye Ruoth Nyasacha,</para>
  <para style="q2" vid="PSA 86:12">abiro miyo nyingi duongʼ nyaka chiengʼ.<verse eid="PSA 86:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13"/>Nimar hera ma iherago duongʼ,</para>
  <para style="q2" vid="PSA 86:13">kendo isegola ei chuny bur matut.<verse eid="PSA 86:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14"/>Josunga ma wengegi tek monja, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 86:14">migawo mar joma ok kech ngʼato dwaro tieko ngimana,</para>
  <para style="q2" vid="PSA 86:14">joma ok dew kata in.<verse eid="PSA 86:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15"/>In to in Nyasaye ma kecho kendo ngʼwon, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 86:15">iyi ok wangʼ piyo, ipongʼ gihera kendo in ja-adiera.<verse eid="PSA 86:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16"/>Duog ira mondo ikecha;</para>
  <para style="q2" vid="PSA 86:16">med jatichni tekoni,</para>
  <para style="q2" vid="PSA 86:16">kendo res jatichni mogeni.<verse eid="PSA 86:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17"/>Miyae ranyisi mar berni,</para>
  <para style="q2" vid="PSA 86:17">mondo wasika one mi wigi okuodi,</para>
  <para style="q2" vid="PSA 86:17">nimar in ema isebedo ka ikonya kendo ihoya, yaye Jehova Nyasaye.<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="cl">Zaburi 87</para>
  <para style="d">Zaburi mar yawuot Kora. Wer.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1"/>Oseguro mise mare ewi got maler;<verse eid="PSA 87:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 87:2"/>Jehova Nyasaye ohero rangeye mag Sayun,</para>
  <para style="q2" vid="PSA 87:2">moloyo kuonde dak duto mag Jakobo.<verse eid="PSA 87:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3"/>Ji wacho gik madongo kuomi,</para>
  <para style="q2" vid="PSA 87:3">yaye dala maduongʼ mar Nyasaye: <char style="qs">Sela</char><verse eid="PSA 87:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4"/>“Abiro kwano Rahab<note caller="+" style="f"><char style="fr" closed="false">87:4 </char><char style="ft" closed="false">Nying machielo midendogo Misri.</char></note> gi Babulon</para>
  <para style="q2" vid="PSA 87:4">e kanyakla mar joma ongʼeya,</para>
  <para style="q1" vid="PSA 87:4">nyaka Filistia bende, kod Turo, kaachiel gi Kush</para>
  <para style="q2" vid="PSA 87:4">kendo abiro wacho ni, ‘Ngʼatni nonywol ei Sayun.’ ”<verse eid="PSA 87:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5"/>Adier, nowachi kuom Sayun niya,</para>
  <para style="q2" vid="PSA 87:5">“En min ogendini mathoth,</para>
  <para style="q2" vid="PSA 87:5">kendo Nyasaye Man Malo Moloyo owuon biro chunge.”<verse eid="PSA 87:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6"/>Jehova Nyasaye biro ndiko e kitabu mindikoe nying ogendini kama:</para>
  <para style="q2" vid="PSA 87:6">“Jali nonywol ei Sayun.” <char style="qs">Sela</char><verse eid="PSA 87:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7"/>Sa ma giloso wer to giniwer niya,</para>
  <para style="q2" vid="PSA 87:7">“Soknina duto ni e iyi.”<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="cl">Zaburi 88</para>
  <para style="d">Wer. Zaburi mar yawuot Kora. Kuom jatend wer. Kaluwore gi <char style="tl">mahalath leanoth.</char> <char style="tl">Maskil</char><note caller="+" style="f"><char style="fr" closed="false">88:0 </char><char style="fl" closed="false">Maskil: </char><char style="ft" closed="false">en kit wer moro mane Daudi owero</char></note> mar Heman ja-Ezra.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1"/>Yaye Jehova Nyasaye, in e Nyasacha ma resa,</para>
  <para style="q2" vid="PSA 88:1">aywagora e nyimi odiechiengʼ gotieno.<verse eid="PSA 88:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2"/>Mad lamona chop e nyimi;</para>
  <para style="q2" vid="PSA 88:2">yie ilok iti ne kwayona.<verse eid="PSA 88:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3"/>Nimar chandruok opongʼo chunya</para>
  <para style="q2" vid="PSA 88:3">kendo ngimana sudo machiegni gi liel.<verse eid="PSA 88:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4"/>Ikwana kaachiel gi joma ridore piny ei bur matut;</para>
  <para style="q2" vid="PSA 88:4">achalo ngʼama onge teko.<verse eid="PSA 88:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5"/>Ojwangʼa kaachiel gi joma otho,</para>
  <para style="q2" vid="PSA 88:5">mana kaka joma onegi monindo e bur,</para>
  <para style="q1" vid="PSA 88:5">makoro ok ipar kuomgi kendo,</para>
  <para style="q2" vid="PSA 88:5">joma ongʼad kargi oko e ritni.<verse eid="PSA 88:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6"/>Iseketa ei bur matut mogik, ei piny mogik,</para>
  <para style="q2" vid="PSA 88:6">kama olil ti.<verse eid="PSA 88:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7"/>Mirimbi mager ogore kuoma mapek;</para>
  <para style="q2" vid="PSA 88:7">isetamo wangʼa gi apaka magi duto. <char style="qs">Sela</char><verse eid="PSA 88:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8"/>Isemiyo osiepena mane ni machiegni koda mogik oringa,</para>
  <para style="q2" vid="PSA 88:8">kendo isemiyo koro achalonegi mana koko.</para>
  <para style="q1" vid="PSA 88:8">Odinna ma ok anyal tony;<verse eid="PSA 88:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 88:9"/>wengena ok nen maber nikech kuyo ma an-go.</para>
  <para style="b" vid="PSA 88:9"/>
  <para style="q1" vid="PSA 88:9">Aluongi odiechiengʼ kodiechiengʼ, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 88:9">achikoni lwetena.<verse eid="PSA 88:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10"/>Bende itimo honni magi ne joma otho?</para>
  <para style="q2" vid="PSA 88:10">Joma otho bende nyalo chier kendo mi paki? <char style="qs">Sela</char><verse eid="PSA 88:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11"/>Herani bende inyiso joma ni ei liel; adier,</para>
  <para style="q2" vid="PSA 88:11">koso adierani bende yudore e kethruok piny?<verse eid="PSA 88:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12"/>Timbeni miwuoro bende ongʼere kama otimo mudhono,</para>
  <para style="q2" vid="PSA 88:12">kata timbeni makare e piny ma ilalieno?<verse eid="PSA 88:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13"/>Anto aywakni mondo ikonya, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 88:13">lamona chopo e nyimi gokinyi.<verse eid="PSA 88:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14"/>Yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 88:14">angʼo momiyo idaga kendo ipandona wangʼi?<verse eid="PSA 88:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15"/>Aseneno chandruok chakre tin-na mi adwa tho;</para>
  <para style="q2" vid="PSA 88:15">asewinjo malit nikech thagruok misekelona, kendo chunya oseol.<verse eid="PSA 88:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16"/>Mirimbi mager oseywaya;</para>
  <para style="q2" vid="PSA 88:16">thagruok mimiya osetieka.<verse eid="PSA 88:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17"/>Gilwora ka ataro odiechiengʼ duto;</para>
  <para style="q2" vid="PSA 88:17">gisedinona chuth koni gi koni.<verse eid="PSA 88:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18"/>Isemaya osiepena gi joherana;</para>
  <para style="q2" vid="PSA 88:18">mudho mandiwa ema koro odongʼ machiegni koda kaka osiepna.<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="cl">Zaburi 89</para>
  <para style="d">
    <char style="tl">Maskil</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">89:0 </char>
      <char style="fl" closed="false">Maskil: </char>
      <char style="ft" closed="false">en kit wer moro mane Daudi owero</char>
    </note> mar Ethan ja-Ezra.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1"/>Abiro wer nyaka chiengʼ kuom hera maduongʼ mar Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 89:1">abiro nyiso ji gi dhoga mi gingʼe kuom adierani e tienge duto.<verse eid="PSA 89:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2"/>Abiro nyiso ratiro ni herani ogurore motegno nyaka chiengʼ;</para>
  <para style="q2" vid="PSA 89:2">kendo ni ne iguro adierani e polo owuon.<verse eid="PSA 89:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3"/>Ne iwacho niya, “Asetimo muma gi ngʼata ma ayiero,</para>
  <para style="q2" vid="PSA 89:3">asesingora ne Daudi jatichna ni,<verse eid="PSA 89:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4"/>‘Anachung kothi nyaka chiengʼ</para>
  <para style="q2" vid="PSA 89:4">kendo anagur lochni motegno e tienge duto.’ ” <char style="qs">Sela</char><verse eid="PSA 89:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5"/>Polo pako timbeni miwuoro kod adierani, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 89:5">e dier chokruok mar jomaler.<verse eid="PSA 89:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6"/>Koso en ngʼa e kor polo minyalo pimo gi Jehova Nyasaye?</para>
  <para style="q2" vid="PSA 89:6">En ngʼa e dier chwech mag polo machalo gi Jehova Nyasaye?<verse eid="PSA 89:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7"/>E buch jomaler Nyasaye oluor gi luor maduongʼ;</para>
  <para style="q2" vid="PSA 89:7">olich moloyo chwech duto molwore.<verse eid="PSA 89:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8"/>Yaye Jehova Nyasaye Maratego en ngʼa machalo kodi?</para>
  <para style="q2" vid="PSA 89:8">In Jehova Nyasaye iratego kendo adierani olwori.<verse eid="PSA 89:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9"/>In giteko ewi nam magingore;</para>
  <para style="q2" vid="PSA 89:9">ka apakane dhwolore malo, to ikweyogi.<verse eid="PSA 89:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10"/>Ne ingʼinyo Rahab mana ka kitundu,</para>
  <para style="q2" vid="PSA 89:10">kendo ne ikeyo wasiki gi badi maratego.<verse eid="PSA 89:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11"/>Polo gin magi, kendo piny bende en mari.</para>
  <para style="q2" vid="PSA 89:11">In ema ne imiyo piny obetie kaachiel gi gik moko duto manie iye.<verse eid="PSA 89:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12"/>Ne ichweyo nyandwat gi milambo;</para>
  <para style="q2" vid="PSA 89:12">Tabor gi Hermon pako nyingi gi wer gi mor.<verse eid="PSA 89:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13"/>In-gi bat maratego, lweti bende otegno,</para>
  <para style="q2" vid="PSA 89:13">kendo lweti ma korachwich nigi duongʼ.<verse eid="PSA 89:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14"/>Tim makare gi adiera e mise mag lochni;</para>
  <para style="q2" vid="PSA 89:14">hera gi ber otelo e nyimi.<verse eid="PSA 89:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15"/>Ogwedh joma osepuonjore goyoni sigio mar mor,</para>
  <para style="q2" vid="PSA 89:15">jogo mawuotho buti e lerni, yaye Jehova Nyasaye.<verse eid="PSA 89:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16"/>Giil odiechiengʼ duto nikech nyingi;</para>
  <para style="q2" vid="PSA 89:16">gidhialo timni makare.<verse eid="PSA 89:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17"/>Nimar in e duongʼgi gi tekogi,</para>
  <para style="q2" vid="PSA 89:17">kendo isedhialo tungwa kuom ngʼwononi.<verse eid="PSA 89:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18"/>Adier, kuodi marwa en mar Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 89:18">ruodhwa en mar Jal Maler mar Israel.<verse eid="PSA 89:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19"/>Kinde moko ne iwuoyo e yor fweny,</para>
  <para style="q2" vid="PSA 89:19">mine iwacho ne jogi ma jo-adiera niya,</para>
  <para style="q1" vid="PSA 89:19">“Asesidho teko kuom jalweny,</para>
  <para style="q2" vid="PSA 89:19">asemiyo wuowi moro matin duongʼ e dier ji.<verse eid="PSA 89:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20"/>Aseyudo Daudi jatichna;</para>
  <para style="q2" vid="PSA 89:20">asewire gi moya maler.<verse eid="PSA 89:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21"/>Lweta biro sire, adier,</para>
  <para style="q2" vid="PSA 89:21">bada biro miye teko.<verse eid="PSA 89:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22"/>Onge ngʼama timbene richo moro amora mane ochune mondo ogolne osuru;</para>
  <para style="q2" vid="PSA 89:22">onge ngʼama timbene richo moro amora ma nosande.<verse eid="PSA 89:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23"/>Abiro tieko chuth joma kedo kode koneno gi wangʼe,</para>
  <para style="q2" vid="PSA 89:23">kendo abiro goyo wasike duto piny.<verse eid="PSA 89:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24"/>Herana mar adier nobed kode,</para>
  <para style="q2" vid="PSA 89:24">kendo tungene nomi duongʼ nikech nyinga.<verse eid="PSA 89:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25"/>Abiro keyo lwete mi kwak nam,</para>
  <para style="q2" vid="PSA 89:25">kendo lwete ma korachwich biro kwako aore.<verse eid="PSA 89:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26"/>Obiro luonga ni, ‘In Wuonwa kendo in Nyasacha,</para>
  <para style="q2" vid="PSA 89:26">lwandana ma Jawarna.’<verse eid="PSA 89:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27"/>Bende abiro ketone nyathina makayo,</para>
  <para style="q2" vid="PSA 89:27">ma en Jal motingʼ malo moloyo ruodhi duto mag piny.<verse eid="PSA 89:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28"/>Abiro siko ka ahere nyaka chiengʼ,</para>
  <para style="q2" vid="PSA 89:28">kendo winjruok ma atimo kode ok norem mak ochopo ngangʼ.<verse eid="PSA 89:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29"/>Abiro guro kothe nyaka chiengʼ,</para>
  <para style="q2" vid="PSA 89:29">kendo lochne nosiki mana kaka polo osiko.<verse eid="PSA 89:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30"/>“Kata ka yawuote nowe chikna</para>
  <para style="q2" vid="PSA 89:30">ma ok giluwo yorena,<verse eid="PSA 89:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31"/>ka ok girito buchena</para>
  <para style="q2" vid="PSA 89:31">kendo ka chikena otamogi luwo,<verse eid="PSA 89:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32"/>to anakum richogi gi luth,</para>
  <para style="q2" vid="PSA 89:32">kendo anago kethogi gi chwat.<verse eid="PSA 89:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33"/>Kata kamano ok anagol herana kuome,</para>
  <para style="q2" vid="PSA 89:33">bende ok anatimne gima opogore gi adierana.<verse eid="PSA 89:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34"/>Ok anawe mak achopo winjruokna kode</para>
  <para style="q2" vid="PSA 89:34">kata loko gima asewacho gi dhoga.<verse eid="PSA 89:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35"/>Asesingora dichiel kendo mogik kuom ler mara,</para>
  <para style="q2" vid="PSA 89:35">kendo ok abi riambo ne Daudi,<verse eid="PSA 89:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36"/>ni kothe nodhi nyime nyaka chiengʼ</para>
  <para style="q2" vid="PSA 89:36">kendo lochne nosiki e nyima ka wangʼ chiengʼ;<verse eid="PSA 89:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37"/>nogure mi osiki nyaka chiengʼ kaka dwe,</para>
  <para style="q2" vid="PSA 89:37">ma en ranyisi madier e kor polo.” <char style="qs">Sela</char><verse eid="PSA 89:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38"/>To in isekwedo, kendo iseweya,</para>
  <para style="q2" vid="PSA 89:38">iyi osewangʼ matek gi ngʼati mowir.<verse eid="PSA 89:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39"/>Iselokori iweyo singruok mane itimo gi jatichni,</para>
  <para style="q2" vid="PSA 89:39">kendo isechido osimbone ei buru.<verse eid="PSA 89:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40"/>Isegoyo ohingane duto piny</para>
  <para style="q2" vid="PSA 89:40">kendo isemuko kuondege mochiel motegno mi olokore gunda.<verse eid="PSA 89:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41"/>Ji duto makalo bute oseyake;</para>
  <para style="q2" vid="PSA 89:41">osedoko ngʼama jobute nyiero.<verse eid="PSA 89:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42"/>Isetingʼo lwedo ma korachwich mar wasike malo;</para>
  <para style="q2" vid="PSA 89:42">isemiyo wasike duto oil.<verse eid="PSA 89:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43"/>Bende isemiyo dho liganglane obedo madik</para>
  <para style="q2" vid="PSA 89:43">kendo ok isekonye e kedo.<verse eid="PSA 89:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44"/>Isemiyo duongʼne orumo</para>
  <para style="q2" vid="PSA 89:44">kendo isewito lochne piny.<verse eid="PSA 89:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45"/>Isengʼado ndalo mag tin-ne odoko machiek;</para>
  <para style="q2" vid="PSA 89:45">isemiyo oneno wichkuot maduongʼ. <char style="qs">Sela</char><verse eid="PSA 89:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46"/>Nyaka karangʼo, yaye Jehova Nyasaye?</para>
  <para style="q2" vid="PSA 89:46">Ibiro pando wangʼi nyaka chiengʼ koso?</para>
  <para style="q2" vid="PSA 89:46">Mirimbi biro liel ka mach nyaka karangʼo?<verse eid="PSA 89:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47"/>Parie kaka ngimana rumo piyo.</para>
  <para style="q2" vid="PSA 89:47">Neye kaka ne ichweyo dhano duto kayiem!<verse eid="PSA 89:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48"/>En ngʼa manyalo bedo mangima nyaka chiengʼ mak oneno tho?</para>
  <para style="q2" vid="PSA 89:48">Koso en ngʼa manyalo resore owuon e teko mar liel? <char style="qs">Sela</char><verse eid="PSA 89:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49"/>Yaye Jehova Nyasaye, tinde ere herani maduongʼ machon,</para>
  <para style="q2" vid="PSA 89:49">hera mane isingori kuom adierani, ni initim ne Daudi?<verse eid="PSA 89:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50"/>Ruoth, parie kaka ji osechayo jatichni,</para>
  <para style="q2" vid="PSA 89:50">parie kaka atingʼo e chunya ayenje mag ogendini duto,<verse eid="PSA 89:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51"/>ayenje ma wasiki osejerogo, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 89:51">ayenje ma gisejarogo okangʼ kokangʼ mar jatichni mowir.<verse eid="PSA 89:51"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52"/>Opak Jehova Nyasaye nyaka chiengʼ!</para>
  <para style="qc" vid="PSA 89:52">Amin kendo Amin.<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms">Kitabu mar Angʼwen</para>
  <para style="mr">
    <ref loc="PSA 90-106">Zaburi 90–106</ref></para>
  <para style="cl">Zaburi 90</para>
  <para style="d">Lamo mar Musa ngʼat Nyasaye.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1"/>Yaye Jehova Nyasaye, isebedo kar dak marwa</para>
  <para style="q2" vid="PSA 90:1">nyaka nene e tienge duto.<verse eid="PSA 90:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2"/>Kane pok gode obetie</para>
  <para style="q2" vid="PSA 90:2">kata kane pok ichweyo piny gi ji modak e iye,</para>
  <para style="q2" vid="PSA 90:2">to isebedo ka in Nyasaye nyaka nene kendo manyaka chiengʼ.<verse eid="PSA 90:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3"/>Idwoko dhano e lowo,</para>
  <para style="q2" vid="PSA 90:3">kiwacho niya, “Doguru e lowo un koth dhano.”<verse eid="PSA 90:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4"/>Nimar higni alufu achiel e nyimi</para>
  <para style="q2" vid="PSA 90:4">chalo gi odiechiengʼ manyoro mosekalo,</para>
  <para style="q2" vid="PSA 90:4">kata gi sa mar otieno.<verse eid="PSA 90:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5"/>Iywoyo dhano ilalgo nono ka nindo mar tho terogi;</para>
  <para style="q2" vid="PSA 90:5">gichalo gi lum mangʼich mar okinyi,<verse eid="PSA 90:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6"/>ma kata obedo ni loth ka ngʼich gokinyi</para>
  <para style="q2" vid="PSA 90:6">to godhiambo to ner kendo two.<verse eid="PSA 90:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7"/>Mirimbi tiekowa</para>
  <para style="q2" vid="PSA 90:7">kendo kecho mikechogo kodwa bwogowa.<verse eid="PSA 90:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8"/>Iseketo richowa e nyimi,</para>
  <para style="q2" vid="PSA 90:8">ee, richowa ma watimo lingʼ-lingʼ ineno seche duto.<verse eid="PSA 90:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9"/>Ndalowa kadho piyo nikech mirimbi;</para>
  <para style="q2" vid="PSA 90:9">hikwa rumo piyo gi chir.<verse eid="PSA 90:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10"/>Ndalowa en piero abiriyo kata piero aboro,</para>
  <para style="q2" vid="PSA 90:10">ka ringrewa otegno;</para>
  <para style="q1" vid="PSA 90:10">to kata kamano ndalogo duto opongʼ gi chandruok kod kuyo,</para>
  <para style="q2" vid="PSA 90:10">nimar gikalo piyo, kendo gilal nono.<verse eid="PSA 90:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11"/>En ngʼa mongʼeyo teko mar mirimbi?</para>
  <para style="q2" vid="PSA 90:11">Nimar gero mari nigi teko machalo gi teko ma luori kelo.<verse eid="PSA 90:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12"/>Omiyo puonjwa kwano ndalowa kare,</para>
  <para style="q2" vid="PSA 90:12">mondo wabed gi chuny mariek.<verse eid="PSA 90:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13"/>Ibiro siko kikecho nyaka karangʼo, yaye Jehova Nyasaye?</para>
  <para style="q2" vid="PSA 90:13">Lokri, kech jatichni.<verse eid="PSA 90:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14"/>Romwa gokinyi gi herani ma ok rem,</para>
  <para style="q2" vid="PSA 90:14">mondo wawer gi ilo kendo wabed mamor ndalowa duto.<verse eid="PSA 90:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15"/>Mi wabed mamor amingʼa mana kaka isemiyo waneno malit,</para>
  <para style="q2" vid="PSA 90:15">marom gi higni ma wasenene chandruok.<verse eid="PSA 90:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16"/>Mad tijeni nere gi jotichni,</para>
  <para style="q2" vid="PSA 90:16">mad duongʼni nyisre ne nyithindi.<verse eid="PSA 90:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17"/>Mad ngʼwono mar Ruoth Nyasachwa obed kodwa;</para>
  <para style="q2" vid="PSA 90:17">yie igurnwa tich mar lwetwa,</para>
  <para style="q2" vid="PSA 90:17">ee gurnwa tich mar lwetwa.<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="cl">Zaburi 91</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1"/>Ngʼat modak ei kar pondo mar Nyasaye Man Malo Moloyo</para>
  <para style="q2" vid="PSA 91:1">biro yudo yweyo e bwo tipo mar Jehova Nyasaye Maratego.<verse eid="PSA 91:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2"/>Ngʼat ma kamano nyalo wacho kuom Jehova Nyasaye niya,</para>
  <para style="q2" vid="PSA 91:2">“En e kar pondona kendo en e ohingana,</para>
  <para style="q2" vid="PSA 91:2">en e Nyasacha ma ageno kuome.”<verse eid="PSA 91:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3"/>Jehova Nyasaye biro resi adier kuom gik mochikigo</para>
  <para style="q2" vid="PSA 91:3">mondo ohinyi kendo kuom tuoche maricho maneko.<verse eid="PSA 91:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4"/>Obiro umi gi bwombene,</para>
  <para style="q2" vid="PSA 91:4">kendo ibiro yudo konyruok e bwo bwombene;</para>
  <para style="q2" vid="PSA 91:4">adierane biro bedoni ka okumba kendo ka siro.<verse eid="PSA 91:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5"/>Ok iniluor masira mar otieno,</para>
  <para style="q2" vid="PSA 91:5">kata asere machielore godiechiengʼ,<verse eid="PSA 91:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6"/>kata tuoche maricho maliwo ji e mudho,</para>
  <para style="q2" vid="PSA 91:6">kata tho matieko ngima ji e dier odiechiengʼ tir.<verse eid="PSA 91:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7"/>Ji alufu achiel nyalo podho e bathi,</para>
  <para style="q2" vid="PSA 91:7">ee, ji alufu apar nyalo riere e badi korachwich,</para>
  <para style="q2" vid="PSA 91:7">to in onge moro ma nochop buti.<verse eid="PSA 91:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8"/>Iningʼigi angʼiya gi wengeni</para>
  <para style="q2" vid="PSA 91:8">kendo inine kikumo joma timbegi richo.<verse eid="PSA 91:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9"/>Ka iwacho niya, “Jehova Nyasaye e kar pondona,”</para>
  <para style="q2" vid="PSA 91:9">kendo iketo Nyasaye Man Malo Moloyo kar dakni,<verse eid="PSA 91:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10"/>to onge gimoro amora marach ma notimreni,</para>
  <para style="q2" vid="PSA 91:10">kendo onge masira ma nosud machiegni gi odi.<verse eid="PSA 91:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11"/>Nimar obiro miyo malaika mage chik nikech in</para>
  <para style="q2" vid="PSA 91:11">mondo giriti e yoreni duto;<verse eid="PSA 91:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12"/>gibiro tingʼi malo e lwetgi,</para>
  <para style="q2" vid="PSA 91:12">mondo kik ichwany tiendi e kidi.<verse eid="PSA 91:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13"/>Ininyon sibuor gi thuond fu;</para>
  <para style="q2" vid="PSA 91:13">adier ininyon sibuor maratego gi thuol maduongʼ man-gi kwiri marach.<verse eid="PSA 91:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14"/>Jehova Nyasaye wacho niya, “Abiro rese nikech ohera;</para>
  <para style="q2" vid="PSA 91:14">abiro rite nikech ohulo nyinga.<verse eid="PSA 91:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15"/>Enoluonga, kendo anadwoke;</para>
  <para style="q2" vid="PSA 91:15">anabed kode e chandruok,</para>
  <para style="q2" vid="PSA 91:15">adier, anakonye kendo anamiye duongʼ.<verse eid="PSA 91:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16"/>Anami odag amingʼa</para>
  <para style="q2" vid="PSA 91:16">kendo ananyise warruokna.”<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="cl">Zaburi 92</para>
  <para style="d">Zaburi. Wer. Ne chiengʼ Sabato.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1"/>Pako Jehova Nyasaye en gima ber kendo wero wende mapako nyingi</para>
  <para style="q2" vid="PSA 92:1">bende ber, yaye Nyasaye Man Malo Moloyo,<verse eid="PSA 92:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2"/>hulo herani gokinyi</para>
  <para style="q2" vid="PSA 92:2">kod adierani gotieno,<verse eid="PSA 92:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3"/>kiwer gi nyatiti matin</para>
  <para style="q2" vid="PSA 92:3">ma tondene apar ka wer ridore gi nyatiti maduongʼ ber adier.<verse eid="PSA 92:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4"/>Nimar timbeni miya mor, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 92:4">awer gi mor nikech tije ma lweti otimo.<verse eid="PSA 92:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5"/>Mano kaka tijeni dongo, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 92:5">mano kaka pachi tut miwuoro!<verse eid="PSA 92:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6"/>Ngʼama omingʼ ok nyal ngʼeyo,</para>
  <para style="q2" vid="PSA 92:6">joma ofuwo ok winj tiend wachno,<verse eid="PSA 92:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7"/>ni kata obedo ni joma timbegi richo nyalo loth kaka lum</para>
  <para style="q2" vid="PSA 92:7">kendo joricho nyalo dhi maber,</para>
  <para style="q1" vid="PSA 92:7">to ibiro tiekgi chuth nyaka chiengʼ.<verse eid="PSA 92:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8"/>To in, yaye Jehova Nyasaye, ibiro siko kimiyi duongʼ nyaka chiengʼ.<verse eid="PSA 92:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9"/>Nimar ka kuom adier, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 92:9">ka kuom adier to wasiki duto biro lal nono;</para>
  <para style="q2" vid="PSA 92:9">joricho duto ibiro ke mel.<verse eid="PSA 92:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10"/>Isemiyo tungena odoko ma roboche ka tunge jowi;</para>
  <para style="q2" vid="PSA 92:10">oseol kuoma modhi maliw.<verse eid="PSA 92:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11"/>Aseneno gi wengena ka iloyo wasika</para>
  <para style="q2" vid="PSA 92:11">kendo asewinjo gi itena ka joma oramona ma timbegi richo itieko.<verse eid="PSA 92:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12"/>Joma kare biro loth maber ka yiend othith,</para>
  <para style="q2" vid="PSA 92:12">gibiro dongo ka yiend sida mar Lebanon;<verse eid="PSA 92:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13"/>Nikech opidhgi e od Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 92:13">gibiro loth e agolni mag Nyasachwa.<verse eid="PSA 92:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14"/>Kata hikgi oniangʼ to pod gininyag mana olemo,</para>
  <para style="q2" vid="PSA 92:14">kendo ginisik ka ginyien kendo gingʼich,<verse eid="PSA 92:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15"/>ka gilando niya “Jehova Nyasaye oriere tir;</para>
  <para style="q2" vid="PSA 92:15">en e Lwandana, kendo onge richo moro amora kuome.”<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="cl">Zaburi 93</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1"/>Jehova Nyasaye olocho kendo orwakore gi duongʼ,</para>
  <para style="q2" vid="PSA 93:1">Jehova Nyasaye orwakore gi duongʼ,</para>
  <para style="q2" vid="PSA 93:1">kendo omanore gi teko.</para>
  <para style="q1" vid="PSA 93:1">Piny ochungʼ mongirore;</para>
  <para style="q2" vid="PSA 93:1">onge ngʼama nyalo yienge.<verse eid="PSA 93:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2"/>Lochni nogur chon gi lala;</para>
  <para style="q2" vid="PSA 93:2">ionge chakruokni kata gikoni.<verse eid="PSA 93:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3"/>Nembe tingʼore malo, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 93:3">nembe dhwolore malo ka giwuo;</para>
  <para style="q2" vid="PSA 93:3">nembe tingʼore ka apaka gore matek.<verse eid="PSA 93:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4"/>Jehova Nyasaye nigi teko maduongʼ moloyo mor mar pige maroteke,</para>
  <para style="q2" vid="PSA 93:4">en gi teko maduongʼ moloyo apaka ma tekregi ngʼeny,</para>
  <para style="q2" vid="PSA 93:4">adier Jehova Nyasaye man malo nigi teko maduongʼ.<verse eid="PSA 93:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5"/>Bucheni ochungʼ mongirore;</para>
  <para style="q2" vid="PSA 93:5">kendo ler opongʼo odi,</para>
  <para style="q2" vid="PSA 93:5">nyaka chiengʼ, yaye Jehova Nyasaye.<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="cl">Zaburi 94</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1"/>Yaye Jehova Nyasaye en Nyasaye ma jachul kuor,</para>
  <para style="q2" vid="PSA 94:1">yaye Nyasaye ma jachul kuor, nyis lerni.<verse eid="PSA 94:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2"/>Aa malo, yaye Jangʼad bura mar piny;</para>
  <para style="q2" vid="PSA 94:2">chul josunga gima owinjore kodgi.<verse eid="PSA 94:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3"/>Yaye Jehova Nyasaye, nyaka karangʼo ma joma timbegi richo,</para>
  <para style="q2" vid="PSA 94:3">nyaka karangʼo ma joma timbegi richo biro goyo siboi?<verse eid="PSA 94:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4"/>Gidiro weche mag wich teko;</para>
  <para style="q2" vid="PSA 94:4">joma timbegi richo duto opongʼ gi sunga.<verse eid="PSA 94:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5"/>Gikidho jogi, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 94:5">gidiyo girkeni mari.<verse eid="PSA 94:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6"/>Ginego dhako ma chwore otho gi jadak;</para>
  <para style="q2" vid="PSA 94:6">gideyo ngʼama onge gi wuon.<verse eid="PSA 94:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7"/>Giwacho niya, “Jehova Nyasaye ok ne;</para>
  <para style="q2" vid="PSA 94:7">Nyasach Jakobo ok dew gik ma watimo.”<verse eid="PSA 94:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8"/>To winjuru, un joma omingʼ e dier ji;</para>
  <para style="q2" vid="PSA 94:8">un joma ofuwogi, ubiro bedo mariek karangʼo?<verse eid="PSA 94:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9"/>Donge ngʼama nochomo it winjo wach?</para>
  <para style="q2" vid="PSA 94:9">Donge ngʼat manoloso wangʼ neno?<verse eid="PSA 94:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10"/>Donge ngʼat marieyo ogendini kumo ji?</para>
  <para style="q2" vid="PSA 94:10">Bende ngʼat mapuonjo dhano dibed maonge rieko?<verse eid="PSA 94:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11"/>Jehova Nyasaye ongʼeyo pach dhano;</para>
  <para style="q2" vid="PSA 94:11">ongʼeyo ni gionge tich.<verse eid="PSA 94:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12"/>Ogwedh ngʼat mikumo, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 94:12">ma en ngʼama ipuonjo koa e chikeni;<verse eid="PSA 94:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13"/>imiyo ngʼama kamano resruok e ndalo chandruok,</para>
  <para style="q2" vid="PSA 94:13">nyaka chop kuny bur ne joma richo.<verse eid="PSA 94:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14"/>Nimar Jehova Nyasaye ok bi dagi joge;</para>
  <para style="q2" vid="PSA 94:14">ok obi jwangʼo girkeni mare.<verse eid="PSA 94:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15"/>Yor adiera biro yudore kendo ne joma kare,</para>
  <para style="q2" vid="PSA 94:15">kendo joma oriere gie chunygi biro luwe.<verse eid="PSA 94:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16"/>En ngʼa mabiro radona gi joma timbegi richo?</para>
  <para style="q2" vid="PSA 94:16">Ngʼatno mabiro chwaka kakedo gi joricho?<verse eid="PSA 94:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17"/>Ka dine Jehova Nyasaye ok omiya kony,</para>
  <para style="q2" vid="PSA 94:17">to dikoro asedhi dak e piny ma ji olingʼe thi.<verse eid="PSA 94:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18"/>Kane awacho niya, “Tienda kier,”</para>
  <para style="q2" vid="PSA 94:18">to herani nojola, yaye Jehova Nyasaye.<verse eid="PSA 94:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19"/>Ka achiedh-nade nopongʼo chunya,</para>
  <para style="q2" vid="PSA 94:19">to hochni noduogo mor e ngimana.<verse eid="PSA 94:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20"/>Loch marach bende inyalo riworigo adier,</para>
  <para style="q2" vid="PSA 94:20">loch mamiyo ji chandore malit nikech chikene maricho?<verse eid="PSA 94:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21"/>Ginywako ne joma kare</para>
  <para style="q2" vid="PSA 94:21">kendo gingʼadone joma onge ketho buch tho.<verse eid="PSA 94:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22"/>To Jehova Nyasaye osebedo ohingana,</para>
  <para style="q2" vid="PSA 94:22">kendo Nyasacha en lwanda ma aponde.<verse eid="PSA 94:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23"/>Obiro chulogi nikech richogi</para>
  <para style="q2" vid="PSA 94:23">kendo obiro tiekogi nikech timbegi maricho;</para>
  <para style="q2" vid="PSA 94:23">Jehova Nyasaye ma Nyasachwa biro tiekogi.<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="cl">Zaburi 95</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1"/>Biuru wawer gimor ne Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 95:1">wagouru koko matek ne lwanda mar warruokwa.<verse eid="PSA 95:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2"/>Wabiuru e nyime gi erokamano</para>
  <para style="q2" vid="PSA 95:2">kendo wami nyinge duongʼ ka wawer kendo wakok gi mor.<verse eid="PSA 95:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3"/>Nimar Jehova Nyasaye e Nyasaye maduongʼ,</para>
  <para style="q2" vid="PSA 95:3">en e Ruoth maduongʼ moloyo nyiseche duto.<verse eid="PSA 95:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4"/>Otingʼo kuonde matut duto mag piny e lwete,</para>
  <para style="q2" vid="PSA 95:4">kendo wi gode ma roboche bende mage.<verse eid="PSA 95:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5"/>Nam mare, nimar en ema nolose,</para>
  <para style="q2" vid="PSA 95:5">kendo lwetene ema noloso lowo motwo.<verse eid="PSA 95:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6"/>Biuru wakulrene ka walame,</para>
  <para style="q2" vid="PSA 95:6">biuru wago chongwa e nyim Jehova Nyasaye ma Jachwechwa;<verse eid="PSA 95:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7"/>nimar en e Nyasachwa</para>
  <para style="q2" vid="PSA 95:7">kendo wan e joge mokwayo,</para>
  <para style="q2" vid="PSA 95:7">wan e jambe morito.</para>
  <para style="b" vid="PSA 95:7"/>
  <para style="q1" vid="PSA 95:7">Kawuono ka uwinjo dwonde,<verse eid="PSA 95:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 95:8"/>to kik chunyu bed mapek kaka ne utimo Meriba,</para>
  <para style="q2" vid="PSA 95:8">kata kaka ne utimo chiengʼ cha Masa manie thim,<verse eid="PSA 95:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9"/>kama kwereu noteme gi tem,</para>
  <para style="q2" vid="PSA 95:9">kata obedo ni ne giseneno gima ne atimo.<verse eid="PSA 95:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10"/>Kuom higni piero angʼwen iya nowangʼ gi tiengʼno;</para>
  <para style="q2" vid="PSA 95:10">kendo nawacho niya, “Gin joma chunygi ohero rwenyo,</para>
  <para style="q2" vid="PSA 95:10">kendo pok gingʼeyo yorena.”<verse eid="PSA 95:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11"/>Omiyo mirima nomaka kodgi mi nasingora ka akwongʼora ni,</para>
  <para style="q2" vid="PSA 95:11">“Ok ginidonji e yweyona ngangʼ.”<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="cl">Zaburi 96</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1"/>Weruru ne Jehova Nyasaye wer manyien;</para>
  <para style="q2" vid="PSA 96:1">piny duto mondo ower ne Jehova Nyasaye.<verse eid="PSA 96:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2"/>Weruru ne Jehova Nyasaye, pakuru nyinge;</para>
  <para style="q2" vid="PSA 96:2">landuru warruokne odiechiengʼ kodiechiengʼ.<verse eid="PSA 96:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3"/>Huluru duongʼne e kind ogendini,</para>
  <para style="q2" vid="PSA 96:3">kendo landuru tijene miwuoro ne ji duto.<verse eid="PSA 96:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4"/>Nimar Jehova Nyasaye duongʼ kendo owinjore gi pak;</para>
  <para style="q2" vid="PSA 96:4">onego omiye luor moloyo nyiseche mamoko duto.<verse eid="PSA 96:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5"/>Nikech nyiseche duto mag ogendini gin mana gik ma dhano oloso</para>
  <para style="q2" vid="PSA 96:5">to Jehova Nyasaye ema nochweyo polo.<verse eid="PSA 96:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6"/>Duongʼ kod pak nitiere e nyime;</para>
  <para style="q2" vid="PSA 96:6">teko kod duongʼ nitiere e kare maler mar lemo.<verse eid="PSA 96:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7"/>Pakuru Jehova Nyasaye, yaye ogendini manie piny,</para>
  <para style="q2" vid="PSA 96:7">wachuru ni Jehova Nyasaye duongʼ kendo en gi teko.<verse eid="PSA 96:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8"/>Miuru Jehova Nyasaye duongʼ mowinjore gi nyinge;</para>
  <para style="q2" vid="PSA 96:8">kelneuru mich kendo biuru e laru mage.<verse eid="PSA 96:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9"/>Lamuru Jehova Nyasaye kaka Ngʼama Ler man-gi duongʼ mangʼongo;</para>
  <para style="q2" vid="PSA 96:9">beduru maluor ahinya e nyime, un piny duto.<verse eid="PSA 96:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10"/>Wachuru e dier ogendini niya, “Jehova Nyasaye olocho.”</para>
  <para style="q2" vid="PSA 96:10">Piny osegur motegno, ok nyal yienge;</para>
  <para style="q2" vid="PSA 96:10">obiro ngʼado ne ji bura maonge dewo wangʼ.<verse eid="PSA 96:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11"/>Polo mondo obed moil, piny mondo obed mamor;</para>
  <para style="q2" vid="PSA 96:11">nam mondo owuo kaachiel gi gik moko duto manie iye;<verse eid="PSA 96:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12"/>pewe mondo okog gi mor,</para>
  <para style="q2" vid="PSA 96:12">kod gik moko duto manie igi.</para>
  <para style="q1" vid="PSA 96:12">Eka yiende duto manie bungu nower gi mor;<verse eid="PSA 96:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 96:13"/>giniwer e nyim Jehova Nyasaye, nimar obiro,</para>
  <para style="q2" vid="PSA 96:13">adier obiro mondo ongʼad ne piny bura.</para>
  <para style="q1" vid="PSA 96:13">Obiro ngʼado ne piny bura e yo makare,</para>
  <para style="q2" vid="PSA 96:13">ee, obiro yalo ji gi adierane.<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="cl">Zaburi 97</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1"/>Jehova Nyasaye e Ruoth, omiyo piny mondo obed mamor;</para>
  <para style="q2" vid="PSA 97:1">dho nembe man mabor mondo obed moil.<verse eid="PSA 97:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2"/>Boche polo gi mudho mandiwa oume;</para>
  <para style="q2" vid="PSA 97:2">tim makare gi adiera e mise mar lochne.<verse eid="PSA 97:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3"/>Mach liel e nyime</para>
  <para style="q2" vid="PSA 97:3">kendo wangʼo wasike e alworane duto.<verse eid="PSA 97:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4"/>Mil polo mare menyo piny;</para>
  <para style="q2" vid="PSA 97:4">piny neno kendo yiengni.<verse eid="PSA 97:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5"/>Gode leny nono ka odok e nyim Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 97:5">gileny nono e nyim Ruoth piny duto.<verse eid="PSA 97:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6"/>Polo hulo timne makare,</para>
  <para style="q2" vid="PSA 97:6">kendo ji duto neno duongʼne.<verse eid="PSA 97:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7"/>Ji duto malamo gik mokedi wigi okuot;</para>
  <para style="q2" vid="PSA 97:7">jogo gin joma sungore kuom nyiseche mopa;</para>
  <para style="q2" vid="PSA 97:7">nyiseche duto mondo olame!<verse eid="PSA 97:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8"/>Sayun nowinjo wachno mi obedo moil,</para>
  <para style="q2" vid="PSA 97:8">miech Juda bende nobedo mamor,</para>
  <para style="q2" vid="PSA 97:8">nikech bucheni, yaye Jehova Nyasaye.<verse eid="PSA 97:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9"/>Nimar in Jehova Nyasaye, e Nyasaye Man Malo Moloyo mohewo piny duto;</para>
  <para style="q2" vid="PSA 97:9">iduongʼ kendo iyombo nyiseche mamoko duto mabor.<verse eid="PSA 97:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10"/>Joma ohero Jehova Nyasaye mondo osin gi gik maricho</para>
  <para style="q2" vid="PSA 97:10">nimar orito ngima joge ma jo-adiera,</para>
  <para style="q2" vid="PSA 97:10">kendo oresogi e lwet joma richo.<verse eid="PSA 97:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11"/>Joma kare imenyonegi ler;</para>
  <para style="q2" vid="PSA 97:11">joma oriere gie chunygi imiyo mor.<verse eid="PSA 97:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12"/>Moruru kuom Jehova Nyasaye un joma kare,</para>
  <para style="q2" vid="PSA 97:12">kendo pakuru nyinge maler.<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="cl">Zaburi 98</para>
  <para style="d">Zaburi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1"/>Weruru ne Jehova Nyasaye wer manyien,</para>
  <para style="q2" vid="PSA 98:1">nimar osetimo gik miwuoro;</para>
  <para style="q1" vid="PSA 98:1">lwete korachwich gi bade maler</para>
  <para style="q2" vid="PSA 98:1">osekelone warruok.<verse eid="PSA 98:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2"/>Jehova Nyasaye osemiyo warruokne ongʼere</para>
  <para style="q2" vid="PSA 98:2">kendo osefwenyone ogendini timne makare.<verse eid="PSA 98:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3"/>Oseparo herane</para>
  <para style="q2" vid="PSA 98:3">kod adierane ne dhood Israel;</para>
  <para style="q1" vid="PSA 98:3">kuonde duto ma piny ogikie</para>
  <para style="q2" vid="PSA 98:3">oseneno warruok mar Nyasachwa.<verse eid="PSA 98:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4"/>Koguru gi mor ni Jehova Nyasaye, un piny duto,</para>
  <para style="q2" vid="PSA 98:4">weruru kod ilo gi dwol mamit;<verse eid="PSA 98:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5"/>weruru mamit ne Jehova Nyasaye kugoyo nyatiti;</para>
  <para style="q2" vid="PSA 98:5">werneuru mamit kugoyo nyatiti gi dwond wer molungi,<verse eid="PSA 98:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6"/>werneuru gi turumbete kod tung im maywak matek,</para>
  <para style="q2" vid="PSA 98:6">koguru gi mor e nyim Jehova Nyasaye ma Ruoth.<verse eid="PSA 98:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7"/>Nam mondo owuo, kaachiel gi gik moko duto manie iye,</para>
  <para style="q2" vid="PSA 98:7">kod piny duto, gi ji duto modak e iye.<verse eid="PSA 98:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8"/>Aore mondo opam lwetgi,</para>
  <para style="q2" vid="PSA 98:8">gode mondo ower kaachiel ka gimor;<verse eid="PSA 98:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9"/>onego giwer e nyim Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 98:9">nimar obiro mondo ongʼad bura ne piny.</para>
  <para style="q1" vid="PSA 98:9">Obiro ngʼado bura ne piny e yo makare</para>
  <para style="q2" vid="PSA 98:9">kendo obiro yalo ji maonge dewo wangʼ.<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="cl">Zaburi 99</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1"/>Jehova Nyasaye e Ruoth,</para>
  <para style="q2" vid="PSA 99:1">ogendini mondo okirni;</para>
  <para style="q1" vid="PSA 99:1">obet e kom lochne e kind kerubi,</para>
  <para style="q2" vid="PSA 99:1">piny mondo oyiengni.<verse eid="PSA 99:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2"/>Jehova Nyasaye duongʼ miwuoro e Sayun;</para>
  <para style="q2" vid="PSA 99:2">otingʼe malo moyombo ogendini duto.<verse eid="PSA 99:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3"/>Owinjore gipak nyingi maduongʼ kendo miwuoro,</para>
  <para style="q2" vid="PSA 99:3">nyinge ler.<verse eid="PSA 99:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4"/>Ruoth nyalo, ohero bura makare,</para>
  <para style="q2" vid="PSA 99:4">isechungo adiera;</para>
  <para style="q1" vid="PSA 99:4">isetimo ne joka Jakobo</para>
  <para style="q2" vid="PSA 99:4">gima adier kendo makare.<verse eid="PSA 99:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5"/>Dhialuru Jehova Nyasaye ma Nyasachwa</para>
  <para style="q2" vid="PSA 99:5">kendo lameuru,</para>
  <para style="q2" vid="PSA 99:5">e tiend kome mobetie nikech oler.<verse eid="PSA 99:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6"/>Musa gi Harun ne gin jodolo mage e dier jodolo mamoko,</para>
  <para style="q2" vid="PSA 99:6">Samuel ne en achiel kuom joma ne luongo nyinge;</para>
  <para style="q1" vid="PSA 99:6">negiluongo Jehova Nyasaye</para>
  <para style="q2" vid="PSA 99:6">kendo nodwokogi.<verse eid="PSA 99:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7"/>Ne owuoyo kodgi e siro mar bor polo;</para>
  <para style="q2" vid="PSA 99:7">negirito chikene gi buche mane omiyogi.<verse eid="PSA 99:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8"/>Yaye Jehova Nyasaye ma Nyasachwa,</para>
  <para style="q2" vid="PSA 99:8">ne idwokogi;</para>
  <para style="q1" vid="PSA 99:8">ne in Nyasaye maweyo richo ne jo-Israel,</para>
  <para style="q2" vid="PSA 99:8">kata obedo ni ne ikumo timbegi mobam.<verse eid="PSA 99:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9"/>Tingʼuru nying Jehova Nyasaye ma Nyasachwa</para>
  <para style="q2" vid="PSA 99:9">kendo lamuru e gode maler,</para>
  <para style="q2" vid="PSA 99:9">nimar Jehova Nyasaye ma Nyasachwa ler.<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="cl">Zaburi 100</para>
  <para style="d">Zaburi mar goyo erokamano.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1"/>Gouru koko gi mor ne Jehova Nyasaye, un piny duto.<verse eid="PSA 100:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 100:2"/>Lamuru Jehova Nyasaye ka umor;</para>
  <para style="q2" vid="PSA 100:2">biuru e nyime kuwero wende mamor.<verse eid="PSA 100:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3"/>Ngʼeuru ni Jehova Nyasaye en Nyasaye.</para>
  <para style="q2" vid="PSA 100:3">En ema nochweyowa, kendo wan mage;</para>
  <para style="q2" vid="PSA 100:3">wan joge, kendo wan rombene mokwayo.<verse eid="PSA 100:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4"/>Donjuru e rangeyene kugoyo erokamano</para>
  <para style="q2" vid="PSA 100:4">bende biuru e laru mare kupake.</para>
  <para style="q2" vid="PSA 100:4">Goneuru erokamano kendo pakuru nyinge.<verse eid="PSA 100:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5"/>Nimar Jehova Nyasaye ber kendo herane osiko nyaka chiengʼ;</para>
  <para style="q2" vid="PSA 100:5">adierane ochwere e tienge duto.<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="cl">Zaburi 101</para>
  <para style="d">Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1"/>Abiro wer nikech herani gi berni;</para>
  <para style="q2" vid="PSA 101:1">in ema abiro weroni wend pak, yaye Jehova Nyasaye.<verse eid="PSA 101:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2"/>Abiro neno ni aritora mondo ngimana obed malongʼo chuth,</para>
  <para style="q2" vid="PSA 101:2">ibiro biro ira karangʼo?</para>
  <para style="b" vid="PSA 101:2"/>
  <para style="q1" vid="PSA 101:2">Abiro dak e oda</para>
  <para style="q2" vid="PSA 101:2">gi chuny malongʼo chuth.<verse eid="PSA 101:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3"/>Ok abi yie neno</para>
  <para style="q2" vid="PSA 101:3">gimoro amora mochido gi wengena.</para>
  <para style="b" vid="PSA 101:3"/>
  <para style="q1" vid="PSA 101:3">Achayo timbe joma chunygi richo;</para>
  <para style="q2" vid="PSA 101:3">gik maricho ok adwar winjo kata gi ita.<verse eid="PSA 101:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4"/>Ok anabed gi paro mochido;</para>
  <para style="q2" vid="PSA 101:4">bende kata paro mar timo richo ok anapar.<verse eid="PSA 101:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5"/>Ngʼato angʼata makuodho nyawadgi lingʼ-lingʼ</para>
  <para style="q2" vid="PSA 101:5">abiro kwero mi lingʼ;</para>
  <para style="q1" vid="PSA 101:5">ngʼato angʼata ma wangʼe tek kendo ma sungore gie chunye,</para>
  <para style="q2" vid="PSA 101:5">ok anyal betgo amingʼa.<verse eid="PSA 101:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6"/>Joma jo-adiera ema abiro keto wengena kuomgi;</para>
  <para style="q2" vid="PSA 101:6">gin ema abiro yie dak kodgi;</para>
  <para style="q1" vid="PSA 101:6">ngʼat ma wuodhe oriere tir</para>
  <para style="q2" vid="PSA 101:6">ema biro tiyona.<verse eid="PSA 101:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7"/>Ok abi yiene ngʼama ohero miriambo</para>
  <para style="q2" vid="PSA 101:7">mondo odag e oda;</para>
  <para style="q1" vid="PSA 101:7">ngʼat moro amora mawacho miriambo</para>
  <para style="q2" vid="PSA 101:7">ok nochungʼ e nyima.<verse eid="PSA 101:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8"/>Okinyi kokinyi abiro tieko</para>
  <para style="q2" vid="PSA 101:8">joma timbegi richo modak e piny.</para>
  <para style="q1" vid="PSA 101:8">Abiro nego ngʼato angʼata matimo richo</para>
  <para style="q2" vid="PSA 101:8">ka agologi e dala mar Jehova Nyasaye.<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="cl">Zaburi 102</para>
  <para style="d">Lamo mar ngʼat mawinjo marach kendo machiwo ywakne e nyim Jehova Nyasaye.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1"/>Winj lamona, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 102:1">yie irwak lamona ma akwayigo kony.<verse eid="PSA 102:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2"/>Kik ipandna wangʼi sa ma chunya lit.</para>
  <para style="q2" vid="PSA 102:2">Chikna iti; ka aluongi to dwoka mapiyo.<verse eid="PSA 102:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3"/>Nimar ndalona rumo piyo ka iro;</para>
  <para style="q2" vid="PSA 102:3">chokena rewni ka kit kendo maliet.<verse eid="PSA 102:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4"/>Chunya orewore kendo oner ka lum;</para>
  <para style="q2" vid="PSA 102:4">wiya wil kata mana gi chamo chiemba.<verse eid="PSA 102:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5"/>Chur ma achurgo matek</para>
  <para style="q2" vid="PSA 102:5">omiyo adhero alokora choke lilo.<verse eid="PSA 102:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6"/>Achalo gi tula mar bungu,</para>
  <para style="q2" vid="PSA 102:6">achalo gi tula modak e gunda.<verse eid="PSA 102:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7"/>Asiko aneno anena,</para>
  <para style="q2" vid="PSA 102:7">achalo gi winyo man kende ewi osuri.<verse eid="PSA 102:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8"/>Odiechiengʼ duto wasika kinya ka gijara;</para>
  <para style="q2" vid="PSA 102:8">joma dhawona konyore gi nyinga kaka gir kwongʼruok.<verse eid="PSA 102:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9"/>Nimar achamo buch kendo kaka chiemba</para>
  <para style="q2" vid="PSA 102:9">kendo ariwo mathna gi pi wangʼa,<verse eid="PSA 102:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10"/>nikech mirimbi maduongʼ,</para>
  <para style="q2" vid="PSA 102:10">nimar isekawa mi iwita gichien.<verse eid="PSA 102:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11"/>Ndalona chalo gi tipo modhiambo;</para>
  <para style="q2" vid="PSA 102:11">aner adwaro two ka lum.<verse eid="PSA 102:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12"/>In to ibet e kom lochni nyaka chiengʼ, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 102:12">humbi osiko e tienge duto.<verse eid="PSA 102:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13"/>Ibiro aa malo mi ikech Sayun,</para>
  <para style="q2" vid="PSA 102:13">nimar sa osechopo monego ongʼwonee;</para>
  <para style="q2" vid="PSA 102:13">sa mochanne osechopo.<verse eid="PSA 102:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14"/>Nimar kitene beyo gi lala ne jotichni,</para>
  <para style="q2" vid="PSA 102:14">kata mana buru madum kuome miyo ji keche.<verse eid="PSA 102:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15"/>Ogendini biro luoro nying Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 102:15">ruodhi duto mag piny biro luoro duongʼni.<verse eid="PSA 102:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16"/>Nimar Jehova Nyasaye biro gero Sayun</para>
  <para style="q2" vid="PSA 102:16">kendo obiro thinyore e lela e duongʼne.<verse eid="PSA 102:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17"/>Obiro dwoko lamo mar ngʼama ok nyal</para>
  <para style="q2" vid="PSA 102:17">kendo ok obi chayo lamogi.<verse eid="PSA 102:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18"/>Wachni mondo ondik piny ne tiengʼ mabiro,</para>
  <para style="q2" vid="PSA 102:18">mondo joma pok onywol opak Jehova Nyasaye:<verse eid="PSA 102:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19"/>“Jehova Nyasaye nongʼiyo piny gie kare maler man malo,</para>
  <para style="q2" vid="PSA 102:19">nongʼiyo piny gie polo,<verse eid="PSA 102:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20"/>mondo owinj ywak joma otwe</para>
  <para style="q2" vid="PSA 102:20">kendo ogony joma ongʼadnegi buch tho.”<verse eid="PSA 102:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21"/>Kuom mano nying Jehova Nyasaye ibiro hul e Sayun,</para>
  <para style="q2" vid="PSA 102:21">ibiro pake e Jerusalem,<verse eid="PSA 102:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22"/>ka joma odak e pinjeruodhi ochokore</para>
  <para style="q2" vid="PSA 102:22">mondo olam Jehova Nyasaye.<verse eid="PSA 102:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23"/>Ka noyudo ngimana dhi maber to nomiyo tekona odok chien</para>
  <para style="q2" vid="PSA 102:23">kendo nongʼado ngimana odoko machiek.<verse eid="PSA 102:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24"/>Omiyo ne awacho niya,</para>
  <para style="q1" vid="PSA 102:24">“Kik ikaw ngimana, yaye Nyasacha, kapod an e chuny ngima;</para>
  <para style="q2" vid="PSA 102:24">in to isiko ingima nyaka tienge duto.<verse eid="PSA 102:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25"/>Kar chakruok ne iketo mise mag piny,</para>
  <para style="q2" vid="PSA 102:25">kendo polo bende gin tij lweti.<verse eid="PSA 102:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26"/>Gin to ginilal nono in to isiko manyaka chiengʼ;</para>
  <para style="q2" vid="PSA 102:26">giduto giniti mana kaka law ti.</para>
  <para style="q1" vid="PSA 102:26">Ibiro lokogi kaka iloko law</para>
  <para style="q2" vid="PSA 102:26">kendo ibiro witgi.<verse eid="PSA 102:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27"/>In to isiko ichalri mana kaka in,</para>
  <para style="q2" vid="PSA 102:27">kendo hiki ok norum.<verse eid="PSA 102:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28"/>Nyithind jotichni biro dak buti machiegni;</para>
  <para style="q2" vid="PSA 102:28">nyikwagi nodhi maber e nyimi.”<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="cl">Zaburi 103</para>
  <para style="d">Mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1"/>Pak Jehova Nyasaye, yaye chunya;</para>
  <para style="q2" vid="PSA 103:1">chunya maiye duto mondo opak nyinge maler.<verse eid="PSA 103:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2"/>Pak Jehova Nyasaye, yaye chunya,</para>
  <para style="q2" vid="PSA 103:2">kendo kik wiyi wil gi konyruok mochiwo,<verse eid="PSA 103:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3"/>en ema oweyoni richoni duto</para>
  <para style="q2" vid="PSA 103:3">kendo ochango tuocheni duto,<verse eid="PSA 103:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4"/>oreso ngimani kogolo e bur matut</para>
  <para style="q2" vid="PSA 103:4">kendo osidhi gihera kod kech,<verse eid="PSA 103:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5"/>oromo chunyi gi gik mabeyo</para>
  <para style="q2" vid="PSA 103:5">momiyo tin-ni osiko nyien ka mar ongo.<verse eid="PSA 103:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6"/>Jehova Nyasaye timo gik makare</para>
  <para style="q2" vid="PSA 103:6">kendo otimo maber ne joma isando duto.<verse eid="PSA 103:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7"/>Nonyiso Musa timbe mane ochano timo,</para>
  <para style="q2" vid="PSA 103:7">nomiyo jo-Israel oneno timbene.<verse eid="PSA 103:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8"/>Jehova Nyasaye kecho ji kendo ongʼwon,</para>
  <para style="q2" vid="PSA 103:8">iye ok wangʼ piyo kendo en gihera mangʼeny.<verse eid="PSA 103:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9"/>Ok osik komanyo ketho kuom ji,</para>
  <para style="q2" vid="PSA 103:9">bende ok okan mirimbe nyaka chiengʼ;<verse eid="PSA 103:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10"/>ok otimnwa mowinjore gi richowa</para>
  <para style="q2" vid="PSA 103:10">bende ok ochulwa kaluwore gi kethowa.<verse eid="PSA 103:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11"/>Nimar kaka polo ni malo moyombo piny,</para>
  <para style="q2" vid="PSA 103:11">e kaka herane duongʼ ne joma omiye luor;<verse eid="PSA 103:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12"/>mana kaka wuok chiengʼ bor gi podho chiengʼ,</para>
  <para style="q2" vid="PSA 103:12">e kaka osepogowa mabor gi kethowa.<verse eid="PSA 103:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13"/>Mana kaka wuoro kecho nyithinde,</para>
  <para style="q2" vid="PSA 103:13">e kaka Jehova Nyasaye kecho joma omiye luor;<verse eid="PSA 103:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14"/>nimar ongʼeyo kaka ochweyowa,</para>
  <para style="q2" vid="PSA 103:14">ongʼeyo e pache ni wan mana buch lowo.<verse eid="PSA 103:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15"/>Dhano to ndalone chalo gi lum,</para>
  <para style="q2" vid="PSA 103:15">oloth piyo ka maua mopidhi;<verse eid="PSA 103:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16"/>to ka yamo okudhe matin nono to kare orumo,</para>
  <para style="q2" vid="PSA 103:16">kendo ok chak pare.<verse eid="PSA 103:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17"/>Hera ma Jehova Nyasaye oherogo joma omiye luor,</para>
  <para style="q2" vid="PSA 103:17">to osiko manyaka chiengʼ,</para>
  <para style="q2" vid="PSA 103:17">kendo osiko otimo maber ne nyithind nyithindgi,<verse eid="PSA 103:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18"/>ma gin joma orito singruokne kendo jogo maparo</para>
  <para style="q2" vid="PSA 103:18">mondo orit chikene.<verse eid="PSA 103:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19"/>Jehova Nyasaye osechungo lochne e polo,</para>
  <para style="q2" vid="PSA 103:19">kendo lochne orito ji duto.<verse eid="PSA 103:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20"/>Pakuru Jehova Nyasaye, un malaikane duto,</para>
  <para style="q2" vid="PSA 103:20">un joge maroteke matimo kaka odwaro,</para>
  <para style="q2" vid="PSA 103:20">kendo matimo kaka owacho.<verse eid="PSA 103:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21"/>Pakuru Jehova Nyasaye, un jopolo duto,</para>
  <para style="q2" vid="PSA 103:21">un jotichne matimo dwarone.<verse eid="PSA 103:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22"/>Pakuru Jehova Nyasaye, un gik moko duto mochweyo,</para>
  <para style="q2" vid="PSA 103:22">manie bwo lochne kuonde duto.</para>
  <para style="b" vid="PSA 103:22"/>
  <para style="q1" vid="PSA 103:22">Pak Jehova Nyasaye, yaye chunya.<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="cl">Zaburi 104</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1"/>Pak Jehova Nyasaye, yaye chunya.</para>
  <para style="q1" vid="PSA 104:1">Yaye Jehova Nyasaye Nyasacha, mano kaka iduongʼ,</para>
  <para style="q2" vid="PSA 104:1">irwakori gi luor kod duongʼ.<verse eid="PSA 104:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2"/>Oumore gi ler mana kaka nanga; oyaro polo mana kaka hema<verse eid="PSA 104:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 104:3"/>kendo ogero ode moluore ewi pi.</para>
  <para style="q1" vid="PSA 104:3">Oidho boche polo kaka gache mar lweny</para>
  <para style="q2" vid="PSA 104:3">kendo yamo e ndike moriembo.<verse eid="PSA 104:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4"/>Omiyo yembe bedo kaka jootene,</para>
  <para style="q2" vid="PSA 104:4">kendo jotichne kaka ligek mach.<verse eid="PSA 104:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5"/>Iseguro piny e mise mage;</para>
  <para style="q2" vid="PSA 104:5">ma ok onyal yiengni kata matin.<verse eid="PSA 104:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6"/>Ne iume gi kut mana kaka nanga</para>
  <para style="q2" vid="PSA 104:6">mi pige obiwore moyombo gode.<verse eid="PSA 104:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7"/>To kane ikwero pigego to ne gileny nono,</para>
  <para style="q2" vid="PSA 104:7">kane giwinji kimor to ne giwalore gia;<verse eid="PSA 104:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8"/>ne gimol ewi gode,</para>
  <para style="q2" vid="PSA 104:8">ka giridore gidhi e holni,</para>
  <para style="q2" vid="PSA 104:8">kuonde mane ochan-negi.<verse eid="PSA 104:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9"/>Ne iketonegi tongʼ ma ok ginyal kadho;</para>
  <para style="q2" vid="PSA 104:9">mondo kik gichak giim piny kendo.<verse eid="PSA 104:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10"/>Jehova Nyasaye miyo sokni olo pi</para>
  <para style="q2" vid="PSA 104:10">e bugni ka gimol e kind gode.<verse eid="PSA 104:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11"/>Gichiwo pi ne le mag bungu duto;</para>
  <para style="q2" vid="PSA 104:11">kanyna mag bungu tieko riyo ma gin-go.<verse eid="PSA 104:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12"/>Winy mafuyo e kor polo ogero utegi e bath pigego,</para>
  <para style="q2" vid="PSA 104:12">kendo giwer ewi yiende.<verse eid="PSA 104:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13"/>Omiyo koth chue ewi gode koa e dalane manie polo;</para>
  <para style="q2" vid="PSA 104:13">piny nyago olembe moromo nikech tijene.<verse eid="PSA 104:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14"/>Omiyo lum loth ne jamni,</para>
  <para style="q2" vid="PSA 104:14">kod cham ma dhano doyo,</para>
  <para style="q2" vid="PSA 104:14">mamiyo chiemo yudore e piny;<verse eid="PSA 104:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15"/>kaachiel gi divai mamoro chuny dhano,</para>
  <para style="q2" vid="PSA 104:15">gi mo mamiyo lela wangʼe leny,</para>
  <para style="q2" vid="PSA 104:15">kod makati molerogo chunye.<verse eid="PSA 104:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16"/>Yiende Jehova Nyasaye yudo pi moromogi,</para>
  <para style="q2" vid="PSA 104:16">yiendego gin sida mag Lebanon mane opidho.<verse eid="PSA 104:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17"/>Kanyo ema winy geroe utegi,</para>
  <para style="q2" vid="PSA 104:17">winj nyamnaha nigi utegi ewi yiende mag obudo.<verse eid="PSA 104:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18"/>Diek mag bungu odak e gode maboyo,</para>
  <para style="q2" vid="PSA 104:18">to lwendni morokore gin kuonde pondo mag aidha.<verse eid="PSA 104:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19"/>Dwe pogo kinde mag chwiri gi kinde mag opon</para>
  <para style="q2" vid="PSA 104:19">kendo wangʼ chiengʼ ongʼeyo sa monego opodhie.<verse eid="PSA 104:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20"/>Ikelo mudho mi piny lokre otieno,</para>
  <para style="q2" vid="PSA 104:20">kendo le mag bungu duto lak oko.<verse eid="PSA 104:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21"/>Sibuoche ruto ka gimanyo chiemo;</para>
  <para style="q2" vid="PSA 104:21">gimanyo chiembgi kuom Jehova Nyasaye.<verse eid="PSA 104:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22"/>To ka chiengʼ wuok to gidok e bungu;</para>
  <para style="q2" vid="PSA 104:22">gidok kendo ginindo e gondegi.<verse eid="PSA 104:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23"/>Eka dhano wuok oko chako tijene,</para>
  <para style="q2" vid="PSA 104:23">kendo nyagore gi tich nyaka odhiambo.<verse eid="PSA 104:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24"/>Mano kaka gik michweyo ngʼeny, yaye Jehova Nyasaye!</para>
  <para style="q2" vid="PSA 104:24">Ne ichweyogi duto gi rieko miwuoro;</para>
  <para style="q2" vid="PSA 104:24">piny opongʼ gi gik michweyo.<verse eid="PSA 104:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25"/>Isechweyo nam maduongʼ kendo malach</para>
  <para style="q2" vid="PSA 104:25">mopongʼ gi le mamol mathoth mokalo akwana,</para>
  <para style="q2" vid="PSA 104:25">gik mangima madongo gi matindo.<verse eid="PSA 104:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26"/>Kuno ema meli kwangʼie koni gi koni,</para>
  <para style="q2" vid="PSA 104:26">kendo ondieg nam mane ichweyo miluongo ni Leviathan tuge.<verse eid="PSA 104:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27"/>In ema gigo duto ngʼiyi</para>
  <para style="q2" vid="PSA 104:27">mondo imigi chiembgi e kinde mowinjore.<verse eid="PSA 104:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28"/>Ka imiyogi chiemo, to gichamo;</para>
  <para style="q2" vid="PSA 104:28">ka iyawonegi lweti, to giyiengʼ gi gik mabeyo;<verse eid="PSA 104:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29"/>ka ipando wangʼi, to githagore;</para>
  <para style="q2" vid="PSA 104:29">ka igolo muchi kuomgi, to githo kendo gidok e lowo.<verse eid="PSA 104:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30"/>Ka ioro Roho mari, to gibedo mangima;</para>
  <para style="q2" vid="PSA 104:30">kendo imiyo piny bedo gi ngima manyien.<verse eid="PSA 104:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31"/>Mad duongʼ mar Jehova Nyasaye sik nyaka chiengʼ;</para>
  <para style="q2" vid="PSA 104:31">mad Jehova Nyasaye bed mamor gi gik mane ochweyo.<verse eid="PSA 104:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32"/>En e ma kongʼiyo piny to piny yiengni,</para>
  <para style="q2" vid="PSA 104:32">kendo komulo gode to gode dhwolo iro.<verse eid="PSA 104:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33"/>Abiro wer ne Jehova Nyasaye e ngimana duto,</para>
  <para style="q2" vid="PSA 104:33">adier, abiro wero wende pak ne Nyasacha e kinde duto ma pod angima.<verse eid="PSA 104:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34"/>Mad gik ma aparo e chunya omiye mor,</para>
  <para style="q2" vid="PSA 104:34">seche duto ma amor kuom Jehova Nyasaye.<verse eid="PSA 104:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35"/>Joricho to owinjore orum e piny;</para>
  <para style="q2" vid="PSA 104:35">joma timbegi richo ok onego obedie piny kata achiel.</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">Pak Jehova Nyasaye, yaye chunya.</para>
  <para style="q1" vid="PSA 104:35">Pak Jehova Nyasaye.<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="cl">Zaburi 105</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1"/>Pakuru Jehova Nyasaye, luonguru nyinge;</para>
  <para style="q2" vid="PSA 105:1">landuru ne ogendini duto gima osetimo.<verse eid="PSA 105:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2"/>Werneuru, pakeuru gi wende;</para>
  <para style="q2" vid="PSA 105:2">nyisuru kuom tijene duto miwuoro.<verse eid="PSA 105:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3"/>Nyinge maler nigi duongʼ;</para>
  <para style="q2" vid="PSA 105:3">chuny joma manyo Jehova Nyasaye mondo obed mamor.<verse eid="PSA 105:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4"/>Ranguru Jehova Nyasaye gi tekone;</para>
  <para style="q2" vid="PSA 105:4">dwaruru wangʼe kinde duto.<verse eid="PSA 105:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5"/>Paruru gik miwuoro mosetimo,</para>
  <para style="q2" vid="PSA 105:5">honni mage kod buche mosengʼado,<verse eid="PSA 105:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6"/>yaye un nyikwa Ibrahim jatichne,</para>
  <para style="q2" vid="PSA 105:6">yaye yawuot Jakobo joge moyiero.<verse eid="PSA 105:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7"/>En e Jehova Nyasaye ma Nyasachwa;</para>
  <para style="q2" vid="PSA 105:7">buchene ni e piny duto.<verse eid="PSA 105:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8"/>Oparo singruokne nyaka chiengʼ,</para>
  <para style="q2" vid="PSA 105:8">weche mane osingo e tienge tara,<verse eid="PSA 105:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9"/>singruok mane otimo gi Ibrahim,</para>
  <para style="q2" vid="PSA 105:9">Muma mane okwongʼorego ni Isaka.<verse eid="PSA 105:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10"/>Ne ogure ne Jakobo kaka chik,</para>
  <para style="q2" vid="PSA 105:10">kendo nogure ni Israel kaka singruok mochwere, kowacho ni,<verse eid="PSA 105:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11"/>“Anamiyi piny Kanaan</para>
  <para style="q2" vid="PSA 105:11">kaka girkeni mari.”<verse eid="PSA 105:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12"/>Kane pod gin ji manok e kar rombgi,</para>
  <para style="q2" vid="PSA 105:12">ne ginok ahinya kendo ne gin welo e pinyno,<verse eid="PSA 105:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13"/>ne giwuotho e kind ogendini mopogore,</para>
  <para style="q2" vid="PSA 105:13">ka gidhi e pinyruodhi mopogore opogore.<verse eid="PSA 105:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14"/>Ne ok oyie mondo ngʼato osandgi;</para>
  <para style="q2" vid="PSA 105:14">nokwero ruodhi kowachonegi niya,<verse eid="PSA 105:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15"/>“Kik umul joga ma awiro;</para>
  <para style="q2" vid="PSA 105:15">kik uhiny jonabi maga.”<verse eid="PSA 105:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16"/>Ne okelo kech e piny</para>
  <para style="q2" vid="PSA 105:16">kendo noketho yore duto mane giyudogo chiemo;<verse eid="PSA 105:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17"/>kendo nooro ngʼato otelonegi,</para>
  <para style="q2" vid="PSA 105:17">ngʼatno ne en Josef mane oloki kaka misumba.<verse eid="PSA 105:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18"/>Ne giridho tiendene gi arungu mochuoye chuma,</para>
  <para style="q2" vid="PSA 105:18">kendo ne giridho ngʼute gi chumbe,<verse eid="PSA 105:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19"/>nyaka nochopo kinde ma gik mane okoro notimore,</para>
  <para style="q2" vid="PSA 105:19">nyaka wach Jehova Nyasaye nochopo kare.<verse eid="PSA 105:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20"/>Ruodh Misri nooro wach mi nogonye</para>
  <para style="q2" vid="PSA 105:20">jatend ji nogonye thuolo.<verse eid="PSA 105:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21"/>Nokete ruodh ode,</para>
  <para style="q2" vid="PSA 105:21">manorito gik moko duto mane en-go,<verse eid="PSA 105:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22"/>mondo en ema ne otieg jotende kaka ohero</para>
  <para style="q2" vid="PSA 105:22">kendo opuonj jodonge.<verse eid="PSA 105:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23"/>Bangʼe Israel duto nobiro Misri;</para>
  <para style="q2" vid="PSA 105:23">Jakobo nodoko jadak e piny Ham.<verse eid="PSA 105:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24"/>Jehova Nyasaye nomiyo joge onya ahinya;</para>
  <para style="q2" vid="PSA 105:24">nomiyo gibedo mathoth ma wasikgi ne ok nyal nyalogi,<verse eid="PSA 105:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25"/>wasikgi ma noloko chunygi mondo ocha joge,</para>
  <para style="q2" vid="PSA 105:25">kendo noketo chunye mar timo ne jotichne marach.<verse eid="PSA 105:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26"/>Nooro Musa jatichne,</para>
  <para style="q2" vid="PSA 105:26">gi Harun, ngʼat mane oseyiero.<verse eid="PSA 105:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27"/>Negitimo ranyisi mag honni e diergi,</para>
  <para style="q2" vid="PSA 105:27">ee, negitimo timbene miwuoro e piny Ham.<verse eid="PSA 105:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28"/>Nooro mudho mi nomiyo piny olil</para>
  <para style="q2" vid="PSA 105:28">nimar donge ne gisengʼanyo ne wechene?<verse eid="PSA 105:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29"/>Noloko pigegi remo,</para>
  <para style="q2" vid="PSA 105:29">mi nomiyo rechgi otho.<verse eid="PSA 105:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30"/>Ogwende nosieko mopongʼo pinygi,</para>
  <para style="q2" vid="PSA 105:30">kendo negidonjo nyaka ei ute nindo mag ruodhigi.<verse eid="PSA 105:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31"/>Nowuoyo, mi pumbi mag lwangʼni nosieko,</para>
  <para style="q2" vid="PSA 105:31">kendo kikun nopongʼo pinygi.<verse eid="PSA 105:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32"/>Nomiyo kodhi olokore pe</para>
  <para style="q2" vid="PSA 105:32">kendo mil polo nokwako pinygi;<verse eid="PSA 105:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33"/>nogoyo yiendegi mag mzabibu gi ngʼowu piny</para>
  <para style="q2" vid="PSA 105:33">kendo nolwero yiende mane ni e pinygi.<verse eid="PSA 105:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34"/>Nowuoyo, mi bonyo nosieko,</para>
  <para style="q2" vid="PSA 105:34">ongogo mokalo akwana;<verse eid="PSA 105:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35"/>negichamo gimoro amora mane loth</para>
  <para style="q2" vid="PSA 105:35">e pinygi koda ka chambgi mane gipidho e puothegi.<verse eid="PSA 105:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36"/>Bangʼe nonego nyithindo makayo duto mane ni e pinygi,</para>
  <para style="q2" vid="PSA 105:36">kodhi mokwongo duto mane gihango nywolo.<verse eid="PSA 105:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37"/>Nogolo Israel, kogangore gi fedha kod dhahabu,</para>
  <para style="q2" vid="PSA 105:37">kendo onge ngʼama nodongʼ chien kuom dhout Israel duto.<verse eid="PSA 105:37"/></para>
  <para style="q2">
    <verse number="38" style="v" sid="PSA 105:38"/>Misri ne mor kane giwuok,</para>
  <para style="q2" vid="PSA 105:38">nikech mbi mar jo-Israel nosegore kuomgi.<verse eid="PSA 105:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39"/>Noumogi gi boche polo kaka raum,</para>
  <para style="q2" vid="PSA 105:39">kendo mach nochiwonegi ler gotieno.<verse eid="PSA 105:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40"/>Kane gikwaye, to nokelonegi aluru</para>
  <para style="q2" vid="PSA 105:40">kendo noyiengʼogi gi makati mar polo.<verse eid="PSA 105:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41"/>Noyawo lwanda, mi pi nowuok gi teko;</para>
  <para style="q2" vid="PSA 105:41">kendo pigno nomol ka aora mamol e piny motwo.<verse eid="PSA 105:41"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42"/>Nimar noparo singruokne maler</para>
  <para style="q2" vid="PSA 105:42">mane omiyo Ibrahim jatichne.<verse eid="PSA 105:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43"/>Nogolo joge gi ilo,</para>
  <para style="q2" vid="PSA 105:43">adier, nomiyo joge moyier owuok kakok gi mor;<verse eid="PSA 105:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44"/>nomiyogi pinje mag ogendini,</para>
  <para style="q2" vid="PSA 105:44">kendo gik ma jomoko nono nochandore ka loso nodoko girkeni magi,<verse eid="PSA 105:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45"/>mondo omi gilu yorene</para>
  <para style="q2" vid="PSA 105:45">kendo girit chikene.</para>
  <para style="b" vid="PSA 105:45"/>
  <para style="q1" vid="PSA 105:45">Pak ne Jehova Nyasaye!<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="cl">Zaburi 106</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1"/>Pakuru Jehova Nyasaye!</para>
  <para style="q1" vid="PSA 106:1">Gouru erokamano ne Jehova Nyasaye, nikech ober;</para>
  <para style="q2" vid="PSA 106:1">kendo herane osiko manyaka chiengʼ.<verse eid="PSA 106:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2"/>En ngʼa manyalo hulo gik madongo ma Jehova Nyasaye osetimo</para>
  <para style="q2" vid="PSA 106:2">kata manyalo nyiso pakne duto?<verse eid="PSA 106:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3"/>Ogwedh joma osiko koluwo adiera,</para>
  <para style="q2" vid="PSA 106:3">joma osiko katimo gima kare.<verse eid="PSA 106:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4"/>An bende parae, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 106:4">parae ka itimo ngʼwono ne jogi, bi ikonya ka iresogi,<verse eid="PSA 106:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5"/>mondo an bende awinjie maber gi mwandu mimiyo jogi miyiero,</para>
  <para style="q2" vid="PSA 106:5">mondo ayudie mor mar ogandani,</para>
  <para style="q2" vid="PSA 106:5">kendo amiyi duongʼ kaachiel gi girkeni mari.<verse eid="PSA 106:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6"/>Wasetimo richo mana kaka kwerewa bende notimo;</para>
  <para style="q2" vid="PSA 106:6">wasetimo marach kendo wasetimo gik mamono.<verse eid="PSA 106:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7"/>Kane kwerewa ni Misri,</para>
  <para style="q2" vid="PSA 106:7">ne ok giparo matut kuom honni magi;</para>
  <para style="q1" vid="PSA 106:7">bende ne wigi owil gi kechni mathoth,</para>
  <para style="q2" vid="PSA 106:7">ne gingʼanyoni e dho nam, ma en Nam Makwar.<verse eid="PSA 106:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8"/>Kata kamano noresogi nikech nyinge,</para>
  <para style="q2" vid="PSA 106:8">mondo omi tekone maduongʼ ongʼere.<verse eid="PSA 106:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9"/>Nokwero Nam Makwar, mi Nam Makwar notwo;</para>
  <para style="q2" vid="PSA 106:9">kendo nomiyo gikalo kama tut mana ka gima ne giwuotho kama otwo.<verse eid="PSA 106:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10"/>Noresogi e lwet joma ne kedo kodgi,</para>
  <para style="q2" vid="PSA 106:10">adier, nowarogi e lwet wasigu.<verse eid="PSA 106:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11"/>Pi noimo wasikgi;</para>
  <para style="q2" vid="PSA 106:11">ma kata achiel kuomgi ne ok otony.<verse eid="PSA 106:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12"/>Eka ne giyie gi singruok mage</para>
  <para style="q2" vid="PSA 106:12">kendo ne gipake gi wer.<verse eid="PSA 106:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13"/>To ma ok wigi nowil gi gik mane osetimo</para>
  <para style="q2" vid="PSA 106:13">kendo ne ok girite mondo ongʼadnegi rieko.<verse eid="PSA 106:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14"/>Wuoro mokalo tongʼ nomakogi e thim,</para>
  <para style="q2" vid="PSA 106:14">kendo ne gitemo Nyasaye e piny motwo.<verse eid="PSA 106:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15"/>Omiyo ne omiyogi gima negidwaro,</para>
  <para style="q2" vid="PSA 106:15">to kata kamano nooronegi tuo machiyo del.<verse eid="PSA 106:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16"/>Nyiego nomakogi gi Musa e kambi,</para>
  <para style="q2" vid="PSA 106:16">kendo gi Harun, jatich mowal ni Jehova Nyasaye.<verse eid="PSA 106:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17"/>Piny ne oyawore mi nomwonyo Dathan;</para>
  <para style="q2" vid="PSA 106:17">piny noiko oganda joka Abiram.<verse eid="PSA 106:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18"/>Mach nomuoch kuom joma luwogi;</para>
  <para style="q2" vid="PSA 106:18">mach maliel mager nowangʼo joma timbegi richogo motiekogi pep.<verse eid="PSA 106:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19"/>Negiloso nyaroya Horeb,</para>
  <para style="q2" vid="PSA 106:19">mine gilamo kido molos gi chuma.<verse eid="PSA 106:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20"/>Ne giwilo Duongʼ margi</para>
  <para style="q2" vid="PSA 106:20">gi kido mar rwath machamo lum.<verse eid="PSA 106:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21"/>Wigi nowil gi Nyasaye mane oresogi,</para>
  <para style="q2" vid="PSA 106:21">Nyasaye mane osetimo gik madongo e piny Misri,<verse eid="PSA 106:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22"/>Nyasaye mane osetimo honni e piny Ham</para>
  <para style="q2" vid="PSA 106:22">kod timbe miwuoro e dho Nam Makwar.<verse eid="PSA 106:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23"/>Emomiyo nowacho ni nobiro tiekogi</para>
  <para style="q2" vid="PSA 106:23">ka dine Musa, ngʼate moyiero,</para>
  <para style="q1" vid="PSA 106:23">we chungʼ kaywagore e nyime</para>
  <para style="q2" vid="PSA 106:23">mondo ogengʼ mirimbe kik otiekgi.<verse eid="PSA 106:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24"/>Bangʼe ne gichayo pinye ma jaber;</para>
  <para style="q2" vid="PSA 106:24">nikech ne ok giyie singruokne ni en adier.<verse eid="PSA 106:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25"/>Ne gingʼur ei hembegi</para>
  <para style="q2" vid="PSA 106:25">kendo ne ok gitimo gik ma Jehova Nyasaye nochikogi.<verse eid="PSA 106:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26"/>Emomiyo ne osingorenegi kosiemogi</para>
  <para style="q2" vid="PSA 106:26">gi lwete nine obiro miyo gipodhi e thim,<verse eid="PSA 106:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27"/>nonyisogi ni ne obiro miyo nyikwagi podhi e kind ogendini,</para>
  <para style="q2" vid="PSA 106:27">kendo ni ne obiro keyogi e pinje duto.<verse eid="PSA 106:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28"/>Ne giriwore kaachiel e lamo Baal mar jo-Peor,</para>
  <para style="q2" vid="PSA 106:28">kendo negichamo misango michiwone nyiseche motho;<verse eid="PSA 106:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29"/>omiyo ne giwangʼo i Jehova Nyasaye gi timbegi marichogo,</para>
  <para style="q2" vid="PSA 106:29">mi masira nomakogi.<verse eid="PSA 106:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30"/>Kata kamano Finehas nochungʼ kargi kendo noywagore ne Nyasaye,</para>
  <para style="q2" vid="PSA 106:30">mi masirano ne ok otiekogi.<verse eid="PSA 106:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31"/>Nyasaye nokwane kaka ngʼama kare nikech timneno,</para>
  <para style="q2" vid="PSA 106:31">kendo ibiro kwane kamano nyaka tienge mabiro.<verse eid="PSA 106:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32"/>Ne giwangʼo i Jehova Nyasaye, e dho sokni mag Meriba,</para>
  <para style="q2" vid="PSA 106:32">mi timgino nokelone Musa chandruok;<verse eid="PSA 106:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33"/>nimar negiketho chunye</para>
  <para style="q2" vid="PSA 106:33">mi weche maricho nowuok e dhoge.<verse eid="PSA 106:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34"/>Ne ok gitieko ogendini chutho</para>
  <para style="q2" vid="PSA 106:34">kaka Jehova Nyasaye nosechikogi,<verse eid="PSA 106:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35"/>to ne giriwore kodgi</para>
  <para style="q2" vid="PSA 106:35">kendo negiluwo timbegi.<verse eid="PSA 106:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36"/>Negilamo kido mag nyisechegi,</para>
  <para style="q2" vid="PSA 106:36">ma bangʼe nolokorenegi obadho.<verse eid="PSA 106:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37"/>Negichiwo yawuotgi gi nyigi kaka misango,</para>
  <para style="q2" vid="PSA 106:37">kendo negichiwogi ne jochiende.<verse eid="PSA 106:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38"/>Ne gichwero remo maonge ketho,</para>
  <para style="q2" vid="PSA 106:38">remb yawuotgi gi nyigi,</para>
  <para style="q1" vid="PSA 106:38">mane gichiwo kaka misango ne kido mag nyiseche mag Kanaan,</para>
  <para style="q2" vid="PSA 106:38">mi piny nogak nikech rembgi.<verse eid="PSA 106:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39"/>Negidoko mogak nikech gik mane gitimo;</para>
  <para style="q2" vid="PSA 106:39">negibedo joma odwanyore,</para>
  <para style="q2" vid="PSA 106:39">nikech timbegigo.<verse eid="PSA 106:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40"/>Emomiyo Jehova Nyasaye nokecho gi joge</para>
  <para style="q2" vid="PSA 106:40">kendo chunye noa kuom girkeni mare.<verse eid="PSA 106:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41"/>Nochiwogi e lwet ogendini,</para>
  <para style="q2" vid="PSA 106:41">mine gibet e bwo loch joma ne mon kodgi.<verse eid="PSA 106:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42"/>Wasikgi nothirogi</para>
  <para style="q2" vid="PSA 106:42">kendo negiketogi e bwo tekogi.<verse eid="PSA 106:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43"/>Ne oresogi nyadi mangʼeny</para>
  <para style="q2" vid="PSA 106:43">to kata kamano joge noketo chunygi ne ngʼanyo,</para>
  <para style="q2" vid="PSA 106:43">mi richogi nochiwogi mi girumo.<verse eid="PSA 106:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44"/>Kata kamano nokechogi e chandruokgi</para>
  <para style="q2" vid="PSA 106:44">kane owinjo ywakgi;<verse eid="PSA 106:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45"/>nikech noparo singruok mane otimo kodgi</para>
  <para style="q2" vid="PSA 106:45">kendo noloko chunye nikech herane maduongʼ.<verse eid="PSA 106:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46"/>Nochuno ji duto mane oketogi wasumbini</para>
  <para style="q2" vid="PSA 106:46">mondo okechgi.<verse eid="PSA 106:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47"/>Reswa, yaye Jehova Nyasaye ma Nyasachwa,</para>
  <para style="q2" vid="PSA 106:47">kendo chokwa igolwa e dier ogendini,</para>
  <para style="q1" vid="PSA 106:47">mondo wadwok erokamano ne nyingi maler</para>
  <para style="q2" vid="PSA 106:47">kendo wabed mamor kwapaki.<verse eid="PSA 106:47"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48"/>Pakuru Jehova Nyasaye, ma Nyasach Israel,</para>
  <para style="q2" vid="PSA 106:48">mochwere manyaka chiengʼ.</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q1" vid="PSA 106:48">Ji duto mondo owach niya, “Amin!”</para>
  <para style="q1" vid="PSA 106:48">Opak Jehova Nyasaye.<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms">Kitabu mar Abich</para>
  <para style="mr">
    <ref loc="PSA 107-150">Zaburi 107–150</ref></para>
  <para style="cl">Zaburi 107</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1"/>Gouru erokamano ne Jehova Nyasaye, nimar ober;</para>
  <para style="q2" vid="PSA 107:1">herane osiko nyaka chiengʼ.<verse eid="PSA 107:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2"/>Joma owar mag Jehova Nyasaye mondo owach kama</para>
  <para style="q2" vid="PSA 107:2">joma ne owaro e lwet jasigu,<verse eid="PSA 107:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3"/>mane ochoko kogolo e pinje,</para>
  <para style="q2" vid="PSA 107:3">kochakore wuok chiengʼ gi podho chiengʼ,</para>
  <para style="q2" vid="PSA 107:3">nyaka nyandwat gi milambo.<verse eid="PSA 107:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4"/>Joge moko nobayo abaya e thim motwo</para>
  <para style="q2" vid="PSA 107:4">nikech ne gionge yo mar chopo e dala mane ginyalo dakie gi kwe.<verse eid="PSA 107:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5"/>Ne gidenyo kendo riyo noloyogi,</para>
  <para style="q2" vid="PSA 107:5">chunygi noa.<verse eid="PSA 107:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6"/>Eka ne giywakne Jehova Nyasaye mondo okonygi e chandruokgino</para>
  <para style="q2" vid="PSA 107:6">mi noresogi e pekgino.<verse eid="PSA 107:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7"/>Ne otelonegi e yo moriere tir,</para>
  <para style="q2" vid="PSA 107:7">nyaka negichopo e dala, mane ginyalo dakie.<verse eid="PSA 107:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8"/>Onego gigo ne Jehova Nyasaye erokamano kuom herane ma ok rem</para>
  <para style="q2" vid="PSA 107:8">kendo kuom timbene miwuoro, motimo ne ji,<verse eid="PSA 107:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9"/>nimar otieko riyo mar joma riyo oloyo</para>
  <para style="q2" vid="PSA 107:9">kendo omiyo joma odenyo yiengʼ gi gik mabeyo.<verse eid="PSA 107:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10"/>Moko kuomgi nobet e mudho, kendo e tipo mar tho,</para>
  <para style="q2" vid="PSA 107:10">ne gin joma thagore motwe gi nyoroche mag chuma,<verse eid="PSA 107:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11"/>nimar ne gingʼanyo giweyo weche Nyasaye</para>
  <para style="q2" vid="PSA 107:11">kendo ne gichayo rieko mar Nyasaye Man Malo Moloyo.<verse eid="PSA 107:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12"/>Omiyo noketogi gi tich matek mohewogi mine gigore piny</para>
  <para style="q2" vid="PSA 107:12">kendo onge ngʼama ne nyalo konyogi.<verse eid="PSA 107:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13"/>Eka ne giywakne Jehova Nyasaye mondo okonygi e chandruokgino,</para>
  <para style="q2" vid="PSA 107:13">mi noresogi e pekgino.<verse eid="PSA 107:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14"/>Nogologi e mudho kendo e tipo mar tho</para>
  <para style="q2" vid="PSA 107:14">kendo noturo nyoroche mane otuegigo.<verse eid="PSA 107:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15"/>Onego gigo ne Jehova Nyasaye erokamano kuom herane ma ok rem,</para>
  <para style="q2" vid="PSA 107:15">kendo kuom timbene miwuoro motimo ne ji,<verse eid="PSA 107:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16"/>nimar omuko rangeye mag mula,</para>
  <para style="q2" vid="PSA 107:16">kendo ongʼado lodi mag nyinyo.<verse eid="PSA 107:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17"/>Moko kuomgi nobedo joma ofuwo nikech yoregi mobam</para>
  <para style="q2" vid="PSA 107:17">kendo negineno thagruok nikech timbegi mamono.<verse eid="PSA 107:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18"/>Dhogi ne rach ma ok ginyal chamo chiemo moro amora,</para>
  <para style="q2" vid="PSA 107:18">kendo ne gichiegni tho.<verse eid="PSA 107:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19"/>Eka ne giywakne Jehova Nyasaye mondo okonygi e chandruokgino</para>
  <para style="q2" vid="PSA 107:19">mi noresogi e pekgino.<verse eid="PSA 107:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20"/>Ne ooro wachne mi nochangogi</para>
  <para style="q2" vid="PSA 107:20">kendo noresogi e lak tho.<verse eid="PSA 107:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21"/>Onego gigo ne Jehova Nyasaye erokamano kuom herane ma ok rem</para>
  <para style="q2" vid="PSA 107:21">kendo kuom timbene miwuoro motimo ne ji.<verse eid="PSA 107:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22"/>Onego gichiwne misango mar goyo erokamano</para>
  <para style="q2" vid="PSA 107:22">kendo ginyis kuom gik mosetimo ka giwer gi mor.<verse eid="PSA 107:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23"/>Moko kuomgi nodhi kwangʼ e nam gi meli;</para>
  <para style="q2" vid="PSA 107:23">ne gin jo-ohala ma yoro nembe madongo dongo.<verse eid="PSA 107:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24"/>Negineno tije Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 107:24">negineno tijene malich miwuoro manie kude.<verse eid="PSA 107:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25"/>Nimar ne owuoyo, mi notugo ahiti mangʼongo</para>
  <para style="q2" vid="PSA 107:25">ma nomiyo apaka ogingore.<verse eid="PSA 107:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26"/>Apaka nodirogi malo e kor yamo,</para>
  <para style="q2" vid="PSA 107:26">kendo nonyumogi kuonde matut mogik;</para>
  <para style="q2" vid="PSA 107:26">mi chir mane gin-go noleny nono kane ginie masira ma kamano.<verse eid="PSA 107:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27"/>Ne gipuore kendo gitagore ka joma omer;</para>
  <para style="q2" vid="PSA 107:27">kendo pachgi nolalnegi.<verse eid="PSA 107:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28"/>Eka ne giywakne Jehova Nyasaye mondo okonygi e chandruokgino</para>
  <para style="q2" vid="PSA 107:28">mi noresogi e pekgino;<verse eid="PSA 107:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29"/>ne okweyo ahiti mobet mos;</para>
  <para style="q2" vid="PSA 107:29">kendo apaka nolingʼ thi.<verse eid="PSA 107:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30"/>Negidoko mamor ka nam nokwe,</para>
  <para style="q2" vid="PSA 107:30">kendo notelonegi nyaka negichopo e dho wath maber, kama negidwaro chopoe.<verse eid="PSA 107:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31"/>Onego gigo ne Jehova Nyasaye erokamano kuom herane ma ok rem</para>
  <para style="q2" vid="PSA 107:31">kendo kuom timbene miwuoro motimo ne ji.<verse eid="PSA 107:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32"/>Onego gitingʼ nyinge malo e chokruok mar joge</para>
  <para style="q2" vid="PSA 107:32">kendo gidende e buch jodongo.<verse eid="PSA 107:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33"/>Ne omiyo aore olokore kuonde motwo,</para>
  <para style="q2" vid="PSA 107:33">sokni mamol nolokore ongoro,<verse eid="PSA 107:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34"/>kendo lowo manyak maber nodoko lowo motimo chumbi,</para>
  <para style="q1" vid="PSA 107:34">maonge tich nikech timbe mamono</para>
  <para style="q2" vid="PSA 107:34">mag joma nodak kuondego.<verse eid="PSA 107:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35"/>To bende nomiyo piny ongoro odoko yewni mag pi,</para>
  <para style="q2" vid="PSA 107:35">kendo lowo motwo nolokore sokni mamol;<verse eid="PSA 107:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36"/>nokelo joma odenyo mondo odag kuondego,</para>
  <para style="q2" vid="PSA 107:36">kendo negigero dala kama neginyalo dakie.<verse eid="PSA 107:36"/></para>
  <para style="q2">
    <verse number="37" style="v" sid="PSA 107:37"/>Ne gipuro puothe kendo ne gipidho puothe mzabibu,</para>
  <para style="q2" vid="PSA 107:37">mane ochiego cham maber;<verse eid="PSA 107:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38"/>ne ogwedhogi, kendo negidoko ji mangʼeny ahinya,</para>
  <para style="q2" vid="PSA 107:38">bende ne ok oyie mondo jambgi odog piny.<verse eid="PSA 107:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39"/>Bangʼe achien kwan-gi nodok matin</para>
  <para style="q2" vid="PSA 107:39">kendo ne odwokgi piny nikech sand gi masiche kod kuyo;<verse eid="PSA 107:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40"/>Jal ma olo mirimbe kuom ruodhi</para>
  <para style="q2" vid="PSA 107:40">nomiyo gibayo koni gi koni e thim.<verse eid="PSA 107:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41"/>To jochan to noreso e thagruokgi,</para>
  <para style="q2" vid="PSA 107:41">kendo nomiyo joutegi onya ka rombe.<verse eid="PSA 107:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42"/>Joma kare neno kendo gidoko mamor;</para>
  <para style="q2" vid="PSA 107:42">To joma timbegi richo dhogi moko.<verse eid="PSA 107:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43"/>Ngʼama riek mondo omak wechegi maber,</para>
  <para style="q2" vid="PSA 107:43">kendo opar matut kuom hera maduongʼ mar Jehova Nyasaye.<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="cl">Zaburi 108</para>
  <para style="d">Wer. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1"/>Chunya ochungʼ mongirore, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 108:1">abiro paki gi wer kendo abiro loso mamit gi chunya duto.<verse eid="PSA 108:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2"/>Chiewuru, un orutu gi nyatiti!</para>
  <para style="q2" vid="PSA 108:2">Abiro chiewo kogwen.<verse eid="PSA 108:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3"/>Abiro paki e dier ogendini, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 108:3">abiro werni e dier ogendini.<verse eid="PSA 108:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4"/>Nikech herani maduongʼ chopo nyaka e polo;</para>
  <para style="q2" vid="PSA 108:4">kendo adiera mari chopo nyaka ewi lwasi.<verse eid="PSA 108:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5"/>Nyingi mondo otingʼ malo moyombo polo, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 108:5">mad duongʼ mari opongʼ piny duto.<verse eid="PSA 108:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6"/>Reswa kendo konywa gi lweti ma korachwich,</para>
  <para style="q2" vid="PSA 108:6">mondo joma ihero ogol e chandruok.<verse eid="PSA 108:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7"/>Nyasaye osewuoyo gie kare maler kowacho niya,</para>
  <para style="q2" vid="PSA 108:7">“Abiro pogo Shekem ne ji,</para>
  <para style="q2" vid="PSA 108:7">kendo abiro pimo ne ji Holo mar Sukoth.<verse eid="PSA 108:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8"/>Gilead en mara, Manase bende mara,</para>
  <para style="q2" vid="PSA 108:8">Efraim en oguta mar lweny,</para>
  <para style="q2" vid="PSA 108:8">to Juda en osimbona mar loch.<verse eid="PSA 108:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9"/>Moab en besen mara mar luok,</para>
  <para style="q2" vid="PSA 108:9">to Edom e kama amoe wuochena;</para>
  <para style="q2" vid="PSA 108:9">Filistia ema akoke ka aseloyo lweny.”<verse eid="PSA 108:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10"/>En ngʼa mabiro kela e dala maduongʼ mochiel motegno?</para>
  <para style="q2" vid="PSA 108:10">En ngʼa mabiro telona nyaka Edom?<verse eid="PSA 108:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11"/>Donge in ema isedagiwa, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 108:11">kendo tinde ok idhi gi jolwenjwa e lweny?<verse eid="PSA 108:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12"/>Miwa kony mondo walo wasikwa,</para>
  <para style="q2" vid="PSA 108:12">nikech kony mar dhano onge tich.<verse eid="PSA 108:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13"/>Wabiro loyo lweny ka Nyasaye nikodwa,</para>
  <para style="q2" vid="PSA 108:13">kendo obiro nyono wasikwa piny.<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="cl">Zaburi 109</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1"/>Yaye Nyasaye ma apako,</para>
  <para style="q2" vid="PSA 109:1">kik ilingʼ,<verse eid="PSA 109:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2"/>nimar joma timbegi richo gi jo-miriambo osemonja gi wechegi;</para>
  <para style="q2" vid="PSA 109:2">gisewuoyo kuomwa marach,</para>
  <para style="q2" vid="PSA 109:2">adier gisewacho miriambo kuoma.<verse eid="PSA 109:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3"/>Gilwora koni gi koni gi weche mag achaya;</para>
  <para style="q2" vid="PSA 109:3">gibuka maonge gima omiyo.<verse eid="PSA 109:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4"/>An aherogi to gin to gimon koda.</para>
  <para style="q2" vid="PSA 109:4">Gitimona kamano kata obedo ni an to alemonegi.<verse eid="PSA 109:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5"/>Gichula rach kar ber,</para>
  <para style="q2" vid="PSA 109:5">kod achaya kar osiep.<verse eid="PSA 109:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6"/>Ket ngʼat marach mondo oked kod jasika;</para>
  <para style="q2" vid="PSA 109:6">we jadonj ne ji mondo ochungʼ kode e bura.<verse eid="PSA 109:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7"/>Kiyale to mi mondo oyude gi ketho,</para>
  <para style="q2" vid="PSA 109:7">kendo kata lemo molamo onego onyis kethone.<verse eid="PSA 109:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8"/>Mad ngʼad ndalone dok manok;</para>
  <para style="q2" vid="PSA 109:8">kendo mad ngʼat machielo kaw tije.<verse eid="PSA 109:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9"/>Mad nyithinde dongʼ kiye</para>
  <para style="q2" vid="PSA 109:9">kendo chiege dongʼ dhako ma chwore otho.<verse eid="PSA 109:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10"/>Mad nyithinde lokre jokwecho mabayo abaya;</para>
  <para style="q2" vid="PSA 109:10">mad riembgi gia koda ka e miechgi mosekethore.<verse eid="PSA 109:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11"/>Mad jagope moro mak gige duto ma en-go</para>
  <para style="q2" vid="PSA 109:11">kendo mad joma welo oyak mwandu duto moseloso.<verse eid="PSA 109:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12"/>Onego ngʼato kik timne ngʼwono</para>
  <para style="q2" vid="PSA 109:12">kata kecho nyithinde modongʼ kiye.<verse eid="PSA 109:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13"/>Kothe duto mondo kargi olal nono,</para>
  <para style="q2" vid="PSA 109:13">kendo nying-gi oruchi kik bedi e tiengʼ mabiro.<verse eid="PSA 109:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14"/>Mad Jehova Nyasaye sik kaparo richo mane wuonegi otimo;</para>
  <para style="q2" vid="PSA 109:14">kendo mad richo min kik ruchi.<verse eid="PSA 109:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15"/>Richogi mondo osiki e nyim Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 109:15">eka mondo ongʼad kargi oko chuth e piny.<verse eid="PSA 109:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16"/>Nimar kane ongima to ne ok odewo timo ngʼwono,</para>
  <para style="q2" vid="PSA 109:16">kar timo kamano to nosando jodhier,</para>
  <para style="q1" vid="PSA 109:16">kaachiel gi joma ochando gi joma chunygi lit;</para>
  <para style="q2" vid="PSA 109:16">nosandogi malit nyaka ne githo.<verse eid="PSA 109:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17"/>Nohero kwongʼo ji</para>
  <para style="q2" vid="PSA 109:17">to koro mad kwongʼneno dogne;</para>
  <para style="q1" vid="PSA 109:17">ne ok ohero gwedho ji</para>
  <para style="q2" vid="PSA 109:17">omiyo koro mad gweth bed mabor kode.<verse eid="PSA 109:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18"/>Ne orwako kwongʼ ka nangane;</para>
  <para style="q2" vid="PSA 109:18">mad kwongʼno koro donji e dende ka pi,</para>
  <para style="q2" vid="PSA 109:18">mad gibud chokene ka mo.<verse eid="PSA 109:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19"/>Mad ochal nanga moumogo dende duto,</para>
  <para style="q2" vid="PSA 109:19">kata kamba motweyego nyaka chiengʼ.<verse eid="PSA 109:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20"/>Mano ema mondo obed chudo, ma Jehova Nyasaye chulo joma donjona;</para>
  <para style="q2" vid="PSA 109:20">mano e kaka onego otim ne joma wuoyo marach kuoma.<verse eid="PSA 109:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21"/>To in, yaye Jehova Nyasaye Manyalo Gik Moko Duto,</para>
  <para style="q2" vid="PSA 109:21">timna maber nikech nyingi;</para>
  <para style="q2" vid="PSA 109:21">konya nikech ber mar herani.<verse eid="PSA 109:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22"/>Nimar adhier kendo achando,</para>
  <para style="q2" vid="PSA 109:22">kendo chunya winjo marach e iya.<verse eid="PSA 109:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23"/>Ndalona rumo mos mos ka tipo mar odhiambo</para>
  <para style="q2" vid="PSA 109:23">kendo yamo uka ka det bonyo.<verse eid="PSA 109:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24"/>Chongena onyosore nikech onge gima acham,</para>
  <para style="q2" vid="PSA 109:24">kendo adhero alokora choke lilo.<verse eid="PSA 109:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25"/>Alokora gima ijaro ne joma donjona;</para>
  <para style="q2" vid="PSA 109:25">ka ginena to gitwenyona umgi ka gigoyona siboi.<verse eid="PSA 109:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26"/>Konya, yaye Jehova Nyasaye Nyasacha,</para>
  <para style="q2" vid="PSA 109:26">resa kaluwore gi herani.<verse eid="PSA 109:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27"/>Mi mondo gingʼe ni achal kama nikech lweti,</para>
  <para style="q2" vid="PSA 109:27">mi gingʼe ni lweti ema osetime, yaye Jehova Nyasaye.<verse eid="PSA 109:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28"/>Gin ginyalo kwongʼa to angʼeyo ni in ibiro gwedha;</para>
  <para style="q2" vid="PSA 109:28">ka gimonja to ibiro kuodo wigi,</para>
  <para style="q2" vid="PSA 109:28">to jatichni to biro bedo mamor.<verse eid="PSA 109:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29"/>Wichkuot maduongʼ biro mako joma donjona</para>
  <para style="q2" vid="PSA 109:29">kendo gibiro rwako wichkuot ka kandho.<verse eid="PSA 109:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30"/>Abiro dhialo Jehova Nyasaye malich gi dhoga;</para>
  <para style="q2" vid="PSA 109:30">abiro pake e dier oganda maduongʼ.<verse eid="PSA 109:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31"/>Nimar ochungʼ e bat korachwich mar ngʼat mochando,</para>
  <para style="q2" vid="PSA 109:31">mondo ores ngimane kuom joma ngʼadone buch tho.<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="cl">Zaburi 110</para>
  <para style="d">Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1"/>Jehova Nyasaye nowachone Ruodha kama:</para>
  <para style="q2" vid="PSA 110:1">“Bed e bada korachwich,</para>
  <para style="q1" vid="PSA 110:1">nyaka chop aket wasiki</para>
  <para style="q2" vid="PSA 110:1">e bwo tiendi.”<verse eid="PSA 110:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2"/>Jehova Nyasaye biro yaro lochni chakre Sayun;</para>
  <para style="q2" vid="PSA 110:2">ibiro bedo gi loch e dier wasiki.<verse eid="PSA 110:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3"/>Jokedo magi biro bedo gi chuny moikore;</para>
  <para style="q2" vid="PSA 110:3">gibiro riedo gokinyi kogwen gi duongʼ mamalo,</para>
  <para style="q1" vid="PSA 110:3">kendo tekri nomedre odiechiengʼ kodiechiengʼ</para>
  <para style="q2" vid="PSA 110:3">mana ka tho momoko e lum gokinyi.<verse eid="PSA 110:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4"/>Jehova Nyasaye osekwongʼore</para>
  <para style="q2" vid="PSA 110:4">kendo ok nolok pache,</para>
  <para style="q1" vid="PSA 110:4">osesingore niya, “In jadolo nyaka chiengʼ,</para>
  <para style="q2" vid="PSA 110:4">koluwo kit dolo mar Melkizedek.”<verse eid="PSA 110:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5"/>Jehova Nyasaye ni e badi ma korachwich</para>
  <para style="q2" vid="PSA 110:5">obiro loyo ruodhi chiengʼ ma mirimbe otuk.<verse eid="PSA 110:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6"/>Obiro ngʼado bura ne ogendini,</para>
  <para style="q2" vid="PSA 110:6">mi opiel joma otho achana-achana kotieko jotelo duto mag piny.<verse eid="PSA 110:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7"/>Obiro modho e aora matin manie bath yo,</para>
  <para style="q2" vid="PSA 110:7">emomiyo noyud teko mi otingʼ wiye.<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="cl">Zaburi 111</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1"/>Pak ne Jehova Nyasaye!</para>
  <para style="q1" vid="PSA 111:1">Abiro miyo Jehova Nyasaye duongʼ gi chunya duto,</para>
  <para style="q1" vid="PSA 111:1">abiro miye duongʼ e buch joma kare kendo e dier chokruok.<verse eid="PSA 111:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2"/>Tije Jehova Nyasaye dongo adier;</para>
  <para style="q2" vid="PSA 111:2">joma mor kodgi osiko kaparo kuomgi.<verse eid="PSA 111:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3"/>Timbene nigi duongʼ kod luor,</para>
  <para style="q2" vid="PSA 111:3">kendo timne makare osiko nyaka chiengʼ.<verse eid="PSA 111:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4"/>Omiyo waparo kuom honni mage;</para>
  <para style="q2" vid="PSA 111:4">nikech Jehova Nyasaye ngʼwon kendo okecho ji.<verse eid="PSA 111:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5"/>Ochiwo chiemo ne joma omiye luor,</para>
  <para style="q2" vid="PSA 111:5">kendo oparo singruok mare nyaka chiengʼ.<verse eid="PSA 111:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6"/>Osenyiso joge tekre kuom gik motimo</para>
  <para style="q2" vid="PSA 111:6">komiyogi lope mag ogendini moko.<verse eid="PSA 111:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7"/>Tije motimo gi lwetene nikare</para>
  <para style="q2" vid="PSA 111:7">kendo beyo kendo buchene duto inyalo geno.<verse eid="PSA 111:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8"/>Gingirore kendo ok gilokre mochwere manyaka chiengʼ,</para>
  <para style="q2" vid="PSA 111:8">nikech osetimgi gi adiera kendo moriere.<verse eid="PSA 111:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9"/>Ne ochiwo warruok ne joge,</para>
  <para style="q2" vid="PSA 111:9">kendo ne oguro singruokne mosiko;</para>
  <para style="q2" vid="PSA 111:9">nyinge ler kendo lich miwuoro.<verse eid="PSA 111:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10"/>Luoro Jehova Nyasaye e chakruok mar rieko;</para>
  <para style="q2" vid="PSA 111:10">ji duto moluwo buchene nigi winjo maber.</para>
  <para style="q2" vid="PSA 111:10">En kende ema owinjore yudo pak manyaka chiengʼ.<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="cl">Zaburi 112</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1"/>Pak ne Jehova Nyasaye!</para>
  <para style="q1" vid="PSA 112:1">Ogwedh ngʼama oluoro Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 112:1">kendo marito chikene gi mor.<verse eid="PSA 112:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2"/>Nyithinde nobed joma roteke e piny;</para>
  <para style="q2" vid="PSA 112:2">ee, koth joma ngimagi oriere tir ibiro gwedhi.<verse eid="PSA 112:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3"/>Pith gi mwandu yudore e ode,</para>
  <para style="q2" vid="PSA 112:3">kendo timne makare osiko nyaka chiengʼ.<verse eid="PSA 112:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4"/>Ngʼama ngimane oriere ler rienyne kata gotieno, ngʼat mangʼwon,</para>
  <para style="q2" vid="PSA 112:4">ma kecho ji kendo makare.<verse eid="PSA 112:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5"/>Ngʼama ngʼwon ma holo ji gige gi chuny maler biro neno ber</para>
  <para style="q2" vid="PSA 112:5">ngʼat matiyo tijene gi adiera.<verse eid="PSA 112:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6"/>Adier, onge gima nyalo yienge,</para>
  <para style="q2" vid="PSA 112:6">ngʼat makare ibiro par nyaka chiengʼ.<verse eid="PSA 112:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7"/>Ok oluoro weche makelo kuyo</para>
  <para style="q2" vid="PSA 112:7">nikech chunye otegno kendo ogeno kuom Jehova Nyasaye.<verse eid="PSA 112:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8"/>Chunye ok chandre kendo oonge gi luoro moro amora;</para>
  <para style="q2" vid="PSA 112:8">ongʼeyo ni obiro neno ka olo wasike ka en to olocho.<verse eid="PSA 112:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9"/>Gisepogo gigegi ne joma odhier, bergi osiko nyaka chiengʼ;</para>
  <para style="q2" vid="PSA 112:9">duongʼne gi luor ma ji oluorego,</para>
  <para style="q2" vid="PSA 112:9">biro siko nyaka chiengʼ.<verse eid="PSA 112:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10"/>Ngʼama timbene richo biro nene mi iye wangʼ,</para>
  <para style="q2" vid="PSA 112:10">obiro mwodo lekene kendo obiro chiyore morum;</para>
  <para style="q2" vid="PSA 112:10">gik ma ngʼama timbene richo gombo ni otimrene ok bi timorene ngangʼ.<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="cl">Zaburi 113</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1"/>Opak Jehova Nyasaye!</para>
  <para style="q1" vid="PSA 113:1">Pakuru Jehova Nyasaye, yaye un jotichne,</para>
  <para style="q2" vid="PSA 113:1">pakuru nying Jehova Nyasaye.<verse eid="PSA 113:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2"/>Nying Jehova Nyasaye mondo opaki,</para>
  <para style="q2" vid="PSA 113:2">sani kendo nyaka chiengʼ.<verse eid="PSA 113:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3"/>Nying Jehova Nyasaye onego opaki,</para>
  <para style="q2" vid="PSA 113:3">chakre kuma chiengʼ wuokie,</para>
  <para style="q2" vid="PSA 113:3">nyaka kuma opodhoe.<verse eid="PSA 113:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4"/>Jehova Nyasaye nigi duongʼ moyombo ogendini duto,</para>
  <para style="q2" vid="PSA 113:4">kendo duongʼne maler oyombo polo.<verse eid="PSA 113:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5"/>En ngʼa machalo gi Jehova Nyasaye ma Nyasachwa,</para>
  <para style="q2" vid="PSA 113:5">Jal mobet e kom loch kuma bor,<verse eid="PSA 113:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6"/>kendo makulore piny</para>
  <para style="q2" vid="PSA 113:6">mondo ongʼi polo gi piny?<verse eid="PSA 113:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7"/>Otingʼo joma odhier malo kogolo piny e lowo;</para>
  <para style="q2" vid="PSA 113:7">adier, ogolo joma ochando e pidh buru,<verse eid="PSA 113:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8"/>kendo oketogi gibet kaachiel gi ruodhi,</para>
  <para style="q2" vid="PSA 113:8">mi kwan-gi kaachiel gi jotend jogi.<verse eid="PSA 113:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9"/>Omiyo dhako ma migumba bedo gi ode</para>
  <para style="q2" vid="PSA 113:9">mi obed miyo mamor man-gi nyithinde.</para>
  <para style="b" vid="PSA 113:9"/>
  <para style="q1" vid="PSA 113:9">Opak Jehova Nyasaye!<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="cl">Zaburi 114</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1"/>Kane jo-Israel owuok Misri,</para>
  <para style="q2" vid="PSA 114:1">ee, kane joka Jakobo owuok e kind joma wacho dhok mopogore,<verse eid="PSA 114:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2"/>Juda nodoko kama ler mar lemo mar Nyasaye,</para>
  <para style="q2" vid="PSA 114:2">kendo Israel nobedo mwandune owuon.<verse eid="PSA 114:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3"/>Nam nonenogi mi oa gi ngʼwech,</para>
  <para style="q2" vid="PSA 114:3">kendo Jordan ne odar oweyonigi piny,<verse eid="PSA 114:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4"/>gode nolengʼore ka imbe,</para>
  <para style="q2" vid="PSA 114:4">to thuche to nochikore ka nyirombe.<verse eid="PSA 114:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5"/>Angʼo momiyo ne ia gi ngʼwech, yaye nam?</para>
  <para style="q2" vid="PSA 114:5">Yaye Jordan, ne idar iweyonegi piny nangʼo?<verse eid="PSA 114:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6"/>To un gode to ne ulengʼoru ka imbe nangʼo?</para>
  <para style="q2" vid="PSA 114:6">Koso thuche to nochikore ka nyirombe nikech angʼo?<verse eid="PSA 114:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7"/>Yaye piny, yiengni ka Ruoth Nyasaye ni machiegni kodi,</para>
  <para style="q2" vid="PSA 114:7">yiengni e nyim Nyasach Jakobo,<verse eid="PSA 114:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8"/>Nyasaye mane omiyo lwanda olokore pi mogudore,</para>
  <para style="q2" vid="PSA 114:8">kendo mane omiyo lwanda matek olokore sokni mag pi.<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="cl">Zaburi 115</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1"/>Ok wan, ok wan, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 115:1">to In ema nyingi oyud duongʼ,</para>
  <para style="q2" vid="PSA 115:1">nikech herani kod adierani.<verse eid="PSA 115:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2"/>Angʼo momiyo ogendini penjo niya,</para>
  <para style="q2" vid="PSA 115:2">“Nyasachgino ere?”<verse eid="PSA 115:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3"/>Nyasachwa ni e polo;</para>
  <para style="q2" vid="PSA 115:3">otimo gimoro amora mohero.<verse eid="PSA 115:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4"/>To nyisechegi mopa gin fedha gi dhahabu,</para>
  <para style="q2" vid="PSA 115:4">molos gi lwet dhano.<verse eid="PSA 115:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5"/>Gin gi dhogi, to kata kamano ok ginyal wuoyo,</para>
  <para style="q2" vid="PSA 115:5">gin gi wenge to ok ginyal neno gimoro.<verse eid="PSA 115:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6"/>Gin gi it, to ok ginyal winjo wach,</para>
  <para style="q2" vid="PSA 115:6">kendo gin gi um, to ok ginyal ngʼwecho.<verse eid="PSA 115:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7"/>Gin gi lwetegi, to ok ginyal mulo,</para>
  <para style="q2" vid="PSA 115:7">kendo gin gi tiende to ok ginyal wuotho,</para>
  <para style="q2" vid="PSA 115:7">bende ok ginyal kata temo loso gi dwondgi.<verse eid="PSA 115:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8"/>Joma losogi nobed machal kodgi,</para>
  <para style="q2" vid="PSA 115:8">kendo joma oketo genogi kuomgi bende biro chalo kodgi.<verse eid="PSA 115:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9"/>Yaye dhood jo-Israel, genuru kuom Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 115:9">En e konyruokgi kendo okumbagi.<verse eid="PSA 115:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10"/>Yaye dhood joka Harun, genuru kuom Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 115:10">En e konyruokgi kendo okumbagi.<verse eid="PSA 115:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11"/>Un joma omiyo Jehova Nyasaye luor, keturu genou kuome,</para>
  <para style="q2" vid="PSA 115:11">En e konyruokgi kendo okumbagi.<verse eid="PSA 115:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12"/>Jehova Nyasaye parowa kendo obiro gwedhowa;</para>
  <para style="q2" vid="PSA 115:12">obiro gwedho dhood Israel,</para>
  <para style="q2" vid="PSA 115:12">obiro gwedho dhood joka Harun,<verse eid="PSA 115:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13"/>obiro gwedho joma oluoro Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 115:13">ji ajia kod joma igeno.<verse eid="PSA 115:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14"/>Mad Jehova Nyasaye mi imedri,</para>
  <para style="q2" vid="PSA 115:14">in kaachiel gi nyithindi.<verse eid="PSA 115:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15"/>Mad iyud gweth moa kuom Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 115:15">jachwech polo gi piny.<verse eid="PSA 115:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16"/>Polo malo mogik en mar Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 115:16">to piny to osechiwo ne dhano.<verse eid="PSA 115:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17"/>Joma osetho ok ema pak Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 115:17">joma oseiki molingʼ thi e bur ok pake;<verse eid="PSA 115:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18"/>en wan ema wadendo Jehova Nyasaye</para>
  <para style="q2" vid="PSA 115:18">tinende kendo nyaka chiengʼ.</para>
  <para style="b" vid="PSA 115:18"/>
  <para style="q1" vid="PSA 115:18">Pakuru Jehova Nyasaye!<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="cl">Zaburi 116</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1"/>Ahero Jehova Nyasaye nikech nowinjo kwayona;</para>
  <para style="q2" vid="PSA 116:1">nowinjo ywakna kane adwaro kech.<verse eid="PSA 116:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2"/>Nikech ne ochikona ite,</para>
  <para style="q2" vid="PSA 116:2">abiro luonge kinde duto ma angima.<verse eid="PSA 116:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3"/>Tonde mag tho norida, lit mar liel nochopona,</para>
  <para style="q2" vid="PSA 116:3">kendo chandruok gi chuny lit noloya.<verse eid="PSA 116:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4"/>Eka naluongo nying Jehova Nyasaye, ne aywakne niya,</para>
  <para style="q2" vid="PSA 116:4">“Resa, yaye Jehova Nyasaye!”<verse eid="PSA 116:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5"/>Jehova Nyasaye ngʼwon kendo timo maber;</para>
  <para style="q2" vid="PSA 116:5">Nyasachwa opongʼ gi kech.<verse eid="PSA 116:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6"/>Jehova Nyasaye rito joma chunygi obolore;</para>
  <para style="q2" vid="PSA 116:6">kane an-gi chando maduongʼ to ne oresa.<verse eid="PSA 116:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7"/>Bed abeda mos, yaye chunya,</para>
  <para style="q2" vid="PSA 116:7">nimar Jehova Nyasaye osebedo katimoni maber ndalo duto.<verse eid="PSA 116:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8"/>Nimar in ema isegolo chunya e tho, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 116:8">wengena bende isereso e ywak,</para>
  <para style="q2" vid="PSA 116:8">kendo tiendena isegengʼo mondo kik okier,<verse eid="PSA 116:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9"/>isetimo kamano mondo awuothi e nyim Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 116:9">e piny joma ngima.<verse eid="PSA 116:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10"/>Ne ayie; emomiyo ne awacho niya,</para>
  <para style="q2" vid="PSA 116:10">“Sand oromo chunya.”<verse eid="PSA 116:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11"/>Kendo kane achiedh-nade omaka,</para>
  <para style="q2" vid="PSA 116:11">to ne awacho niya, “Dhano duto riambo.”<verse eid="PSA 116:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12"/>Ere kaka dachul Jehova Nyasaye</para>
  <para style="q2" vid="PSA 116:12">kuom berne duto mosetimona?<verse eid="PSA 116:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13"/>Abiro tingʼo okumba mar warruok malo</para>
  <para style="q2" vid="PSA 116:13">kendo abiro luongo nying Jehova Nyasaye.<verse eid="PSA 116:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14"/>Abiro chopo singruokga ma asetimo ne Jehova Nyasaye</para>
  <para style="q2" vid="PSA 116:14">e nyim ji duto.<verse eid="PSA 116:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15"/>Tho mar nyithind Nyasaye</para>
  <para style="q2" vid="PSA 116:15">en gima ber miwuoro e nyim Jehova Nyasaye.<verse eid="PSA 116:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16"/>Yaye Jehova Nyasaye, an jatichni adier;</para>
  <para style="q2" vid="PSA 116:16">an jatichni, ma wuod jatichni ma nyako;</para>
  <para style="q2" vid="PSA 116:16">isegonya mi igola e nyorochena.<verse eid="PSA 116:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17"/>Abiro timoni misango mar erokamano</para>
  <para style="q2" vid="PSA 116:17">kendo abiro luongo nying Jehova Nyasaye.<verse eid="PSA 116:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18"/>Abiro chopo singruokga</para>
  <para style="q2" vid="PSA 116:18">ma asetimo ne Jehova Nyasaye e nyim ji duto,<verse eid="PSA 116:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19"/>abiro chopogi e lache mag od Jehova Nyasaye</para>
  <para style="q2" vid="PSA 116:19">abiro timogi e iyi, yaye Jerusalem.</para>
  <para style="b" vid="PSA 116:19"/>
  <para style="q1" vid="PSA 116:19">Pakuru Jehova Nyasaye!<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="cl">Zaburi 117</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1"/>Pakuru Jehova Nyasaye, un ogendini duto;</para>
  <para style="q2" vid="PSA 117:1">dendeuru, un ji duto manie piny.<verse eid="PSA 117:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2"/>Nimar hera moherowago duongʼ,</para>
  <para style="q2" vid="PSA 117:2">kendo adierane osiko nyaka chiengʼ.</para>
  <para style="b" vid="PSA 117:2"/>
  <para style="q1" vid="PSA 117:2">Pakuru Jehova Nyasaye.<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="cl">Zaburi 118</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1"/>Gouru erokamano ne Jehova Nyasaye, nimar ober;</para>
  <para style="q2" vid="PSA 118:1">kendo herane osiko nyaka chiengʼ.<verse eid="PSA 118:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2"/>Jo-Israel mondo owach niya,</para>
  <para style="q2" vid="PSA 118:2">“Herane osiko nyaka chiengʼ.”<verse eid="PSA 118:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3"/>Jo-dhood Harun mondo owach niya,</para>
  <para style="q2" vid="PSA 118:3">“Herane osiko nyaka chiengʼ.”<verse eid="PSA 118:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4"/>Joma oluoro Jehova Nyasaye mondo owach niya,</para>
  <para style="q2" vid="PSA 118:4">“Herane osiko nyaka chiengʼ.”<verse eid="PSA 118:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5"/>Ne aywak ne Jehova Nyasaye kane chunya lit,</para>
  <para style="q2" vid="PSA 118:5">kendo ne odwoka mine ogonya thuolo.<verse eid="PSA 118:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6"/>Jehova Nyasaye ni koda, omiyo ok analuor.</para>
  <para style="q2" vid="PSA 118:6">Ere gima dhano ditimna?<verse eid="PSA 118:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7"/>Jehova Nyasaye ni koda; en e Jakonyna.</para>
  <para style="q2" vid="PSA 118:7">Abiro neno gi wangʼa ka olo wasika.<verse eid="PSA 118:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8"/>Ber pondo kuom Jehova Nyasaye</para>
  <para style="q2" vid="PSA 118:8">moloyo geno kuom dhano.<verse eid="PSA 118:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9"/>Ber pondo kuom Jehova Nyasaye</para>
  <para style="q2" vid="PSA 118:9">moloyo geno kuom ruodhi.<verse eid="PSA 118:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10"/>Ogendini duto nolwora koni gi koni,</para>
  <para style="q2" vid="PSA 118:10">to ne atiekogi e nying Jehova Nyasaye.<verse eid="PSA 118:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11"/>Ne gilwora koni gi koni,</para>
  <para style="q2" vid="PSA 118:11">to ne atiekogi e nying Jehova Nyasaye.<verse eid="PSA 118:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12"/>Ne ginur kuoma ka kich,</para>
  <para style="q2" vid="PSA 118:12">to ne githo ka mach ma wangʼo kudho;</para>
  <para style="q2" vid="PSA 118:12">mine atiekogi e nying Jehova Nyasaye.<verse eid="PSA 118:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13"/>Ne gidhira gichien kendo ne achiegni podho,</para>
  <para style="q2" vid="PSA 118:13">to Jehova Nyasaye nokonya.<verse eid="PSA 118:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14"/>Jehova Nyasaye e tekra kendo en e wenda;</para>
  <para style="q2" vid="PSA 118:14">osedoko warruok mara.<verse eid="PSA 118:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15"/>Koko mag mor gi mag loch</para>
  <para style="q2" vid="PSA 118:15">winjore ei hembe mag joma kare kama:</para>
  <para style="q1" vid="PSA 118:15">“Lwet Jehova Nyasaye ma korachwich osetimo gik madongo!<verse eid="PSA 118:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 118:16"/>Lwet Jehova Nyasaye ma korachwich otingʼ malo;</para>
  <para style="q2" vid="PSA 118:16">lwet Jehova Nyasaye ma korachwich osetimo gik madongo!”<verse eid="PSA 118:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17"/>Ok abi tho, abiro bedo mangima;</para>
  <para style="q2" vid="PSA 118:17">abiro bedo mangima modo ahul gik ma Jehova Nyasaye osetimo.<verse eid="PSA 118:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18"/>Jehova Nyasaye osegoya modwa nega,</para>
  <para style="q2" vid="PSA 118:18">to kata kamano pok oweyo tho onega.<verse eid="PSA 118:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19"/>Yawna rangeye mag tim makare;</para>
  <para style="q2" vid="PSA 118:19">mondo adonji kendo ago erokamano ne Jehova Nyasaye.<verse eid="PSA 118:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20"/>Mano e dhoranga Jehova Nyasaye</para>
  <para style="q2" vid="PSA 118:20">ma joma kare nyalo donjogo.<verse eid="PSA 118:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21"/>Abiro goyoni erokamano, nikech ne idwoka;</para>
  <para style="q2" vid="PSA 118:21">mi idoko warruokna.<verse eid="PSA 118:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22"/>Kidi mane jogedo odagi</para>
  <para style="q2" vid="PSA 118:22">koro osedoko kidi moriwo kor ot;<verse eid="PSA 118:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23"/>Jehova Nyasaye ema osetimo mano</para>
  <para style="q2" vid="PSA 118:23">kendo en gima iwuoro ka waneno.<verse eid="PSA 118:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24"/>Ma en odiechiengʼ ma Jehova Nyasaye oseloso;</para>
  <para style="q2" vid="PSA 118:24">wamoruru kendo wail e iye.<verse eid="PSA 118:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25"/>Yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 118:25">reswa yaye Jehova Nyasaye, mi walochi.<verse eid="PSA 118:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26"/>Ogwedh ngʼat mabiro gi nying Jehova Nyasaye.</para>
  <para style="q2" vid="PSA 118:26">Wagwedhi gie od Jehova Nyasaye.<verse eid="PSA 118:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27"/>Jehova Nyasaye en Nyasaye,</para>
  <para style="q2" vid="PSA 118:27">kendo osemiyo lerne orieny kuomwa.</para>
  <para style="q1" vid="PSA 118:27">Riwreuru gi oganda moriedo katimo nyasi,</para>
  <para style="q2" vid="PSA 118:27">nyaka uchopi e tunge mag kendo mar misango.<verse eid="PSA 118:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28"/>In Nyasacha, omiyo abiro goyoni erokamano;</para>
  <para style="q2" vid="PSA 118:28">in Nyasacha omiyo abiro miyi duongʼ.<verse eid="PSA 118:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29"/>Gouru erokamano ne Jehova Nyasaye, nimar ober;</para>
  <para style="q2" vid="PSA 118:29">herane osiko nyaka chiengʼ.<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="cl">Zaburi 119</para>
  <para style="qa">א Alef</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1"/>Ogwedh joma yoregi ler,</para>
  <para style="q2" vid="PSA 119:1">mawuotho koluwore gi chik Jehova Nyasaye.<verse eid="PSA 119:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2"/>Ogwedh joma orito chikene</para>
  <para style="q2" vid="PSA 119:2">kendo ma manye gi chunygi duto.<verse eid="PSA 119:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3"/>Gin joma ok tim gimoro amora marach,</para>
  <para style="q2" vid="PSA 119:3">to gisiko ka giwuotho e yorene.<verse eid="PSA 119:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4"/>Iseguro chikeni</para>
  <para style="q2" vid="PSA 119:4">ni nyaka lu kaka gin.<verse eid="PSA 119:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5"/>Yaye, mad ne bed ni yorena ogurore</para>
  <para style="q2" vid="PSA 119:5">e luwo chikeni!<verse eid="PSA 119:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6"/>Dine ok aneno wichkuot</para>
  <para style="q2" vid="PSA 119:6">nikech aketo chunya e chikeni duto.<verse eid="PSA 119:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7"/>Kaka amedo puonjora chikeni makare</para>
  <para style="q2" vid="PSA 119:7">e kaka abiro dhi nyime gi paki gi chuny moriere tir.<verse eid="PSA 119:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8"/>Abiro rito chikeni;</para>
  <para style="q1" vid="PSA 119:8">omiyo kik ijwangʼa chuth.<verse eid="PSA 119:8"/></para>
  <para style="qa">ב Beth</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9"/>Ere kaka ngʼama pod tin nyalo rito ngimane mondo osik ka oler?</para>
  <para style="q2" vid="PSA 119:9">Onyalo rito mana ka odak moluwore gi wachni.<verse eid="PSA 119:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10"/>Amanyi gi chunya duto;</para>
  <para style="q2" vid="PSA 119:10">omiyo kik iwe abar awe chikeni.<verse eid="PSA 119:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11"/>Asekano wachni ei chunya</para>
  <para style="q2" vid="PSA 119:11">mondo kik akethi e nyimi.<verse eid="PSA 119:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12"/>Yaye Jehova Nyasaye, mad iyud pak;</para>
  <para style="q2" vid="PSA 119:12">yie ipuonja chikeni.<verse eid="PSA 119:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13"/>Aolo gi dhoga chike duto</para>
  <para style="q2" vid="PSA 119:13">mowuok e dhogi.<verse eid="PSA 119:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14"/>Luwo chikeni mora</para>
  <para style="q2" vid="PSA 119:14">mana kaka ngʼato bedo mamor kuom mwandu duto.<verse eid="PSA 119:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15"/>Abiro paro matut kuom chikeni</para>
  <para style="q2" vid="PSA 119:15">kendo abiro tego wengena e yoreni.<verse eid="PSA 119:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16"/>Amor ahinya gi chikeni;</para>
  <para style="q2" vid="PSA 119:16">ok abi jwangʼo wachni.<verse eid="PSA 119:16"/></para>
  <para style="qa">ג Gimel</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17"/>Tim maber ne jatichni,</para>
  <para style="q2" vid="PSA 119:17">eka abiro bedo mangima kendo abiro rito chikeni.<verse eid="PSA 119:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18"/>Yaw wengena mondo eka ane</para>
  <para style="q2" vid="PSA 119:18">gik mabeyo miwuoro manie chikeni.<verse eid="PSA 119:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19"/>An mana wendo e piny</para>
  <para style="q2" vid="PSA 119:19">omiyo kik ipandna chikeni.<verse eid="PSA 119:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20"/>Chunya opongʼ kod siso</para>
  <para style="q2" vid="PSA 119:20">mar chikeni kinde duto.<verse eid="PSA 119:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21"/>Ikwero joma ochayo ji, ma gin joma okwongʼ,</para>
  <para style="q2" vid="PSA 119:21">kendo gin joma osebaro oweyo chikeni.<verse eid="PSA 119:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22"/>Gol kuoma ajara gi achaya</para>
  <para style="q2" vid="PSA 119:22">nimar arito chikeni.<verse eid="PSA 119:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23"/>Kata obedo ni jotelo chokorena kendo giyanya,</para>
  <para style="q2" vid="PSA 119:23">to jatichni pod biro mana paro matut kuom chikeni.<verse eid="PSA 119:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24"/>Chikeni e morna;</para>
  <para style="q2" vid="PSA 119:24">gin e jongʼad rieko maga.<verse eid="PSA 119:24"/></para>
  <para style="qa">ד Daleth</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25"/>Osepiela ei lowo piny;</para>
  <para style="q2" vid="PSA 119:25">omiyo rit ngimana kaluwore gi wachni.<verse eid="PSA 119:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26"/>Kane ahulo yorena to ne idwoka;</para>
  <para style="q1" vid="PSA 119:26">puonja chikeni.<verse eid="PSA 119:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27"/>Mi awinj tiend gik ma chikegi puonjo;</para>
  <para style="q2" vid="PSA 119:27">eka abiro paro matut kuom timbegi miwuoro.<verse eid="PSA 119:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28"/>Kuyo onyoso chunya,</para>
  <para style="q2" vid="PSA 119:28">omiyo meda teko kaluwore gi wachni.<verse eid="PSA 119:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29"/>Gengʼa kik adonji e yore mag miriambo,</para>
  <para style="q1" vid="PSA 119:29">kendo ngʼwon-na ka ipuonja chikni.<verse eid="PSA 119:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30"/>Aseyiero yor adiera;</para>
  <para style="q2" vid="PSA 119:30">kendo aseketo chunya e chikeni.<verse eid="PSA 119:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31"/>Amako chikeni matek, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 119:31">omiyo kik iwe ane wichkuot.<verse eid="PSA 119:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32"/>Yor chikeni ema aringe,</para>
  <para style="q2" vid="PSA 119:32">nimar isegonyo chunya.<verse eid="PSA 119:32"/></para>
  <para style="qa">ה He</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33"/>Puonja mondo alu yoreni, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 119:33">eka abiro ritogi nyaka giko.<verse eid="PSA 119:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34"/>Miya rieko mondo eka arit chikeni</para>
  <para style="q2" vid="PSA 119:34">kendo atim kaka owacho gi chunya duto.<verse eid="PSA 119:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35"/>Taya e yo mar chikeni,</para>
  <para style="q2" vid="PSA 119:35">nimar kanyo ema ayudoe mor.<verse eid="PSA 119:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36"/>Ket chunya mondo oher chikeni,</para>
  <para style="q2" vid="PSA 119:36">to ok dwaro maga mag wuoro.<verse eid="PSA 119:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37"/>Gol wangʼa oko kuom gik manono;</para>
  <para style="q2" vid="PSA 119:37">rit ngimana kaluwore gi wachni.<verse eid="PSA 119:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38"/>Chop singruok mari ne jatichni,</para>
  <para style="q2" vid="PSA 119:38">mondo ji oluori.<verse eid="PSA 119:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39"/>Golna achaya ma aluoro,</para>
  <para style="q2" vid="PSA 119:39">nimar chikeni beyo.<verse eid="PSA 119:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40"/>Mano kaka ahero yoreni!</para>
  <para style="q2" vid="PSA 119:40">Rit ngimana e timni makare.<verse eid="PSA 119:40"/></para>
  <para style="qa">ו Waw</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41"/>Mad herani ma ok rem bina, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 119:41">mad warruokni bina kaluwore gi singruokni.<verse eid="PSA 119:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42"/>Eka abiro dwokora gi ngʼat ma timona anyali,</para>
  <para style="q2" vid="PSA 119:42">nimar ageno kuom wachni.<verse eid="PSA 119:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43"/>Kik igol wach mar adiera e dhoga chuth,</para>
  <para style="q2" vid="PSA 119:43">nimar aseketo genona e chikeni.<verse eid="PSA 119:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44"/>Abiro rito chikeni ndalo duto,</para>
  <para style="q2" vid="PSA 119:44">manyaka chiengʼ.<verse eid="PSA 119:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45"/>Abiro wuotho ka an thuolo,</para>
  <para style="q2" vid="PSA 119:45">nimar chikeni ema asebedo ka amanyo.<verse eid="PSA 119:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46"/>Abiro wuoyo kuom chikeni e nyim ruodhi</para>
  <para style="q2" vid="PSA 119:46">kendo wiya ok bi kuot,<verse eid="PSA 119:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47"/>nimar amor gi chikeni</para>
  <para style="q2" vid="PSA 119:47">nikech aherogi.<verse eid="PSA 119:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48"/>Atingʼo bedena malo ne chikeni ma ahero</para>
  <para style="q2" vid="PSA 119:48">kendo asiko aparo matut kuom yoreni.<verse eid="PSA 119:48"/></para>
  <para style="qa">ז Zayin</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49"/>Par wachni mane iwacho ne jatichni,</para>
  <para style="q2" vid="PSA 119:49">nimar isemiya geno.<verse eid="PSA 119:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50"/>Gima hoya e chandruokna en ma:</para>
  <para style="q2" vid="PSA 119:50">ni singruokni rito ngimana.<verse eid="PSA 119:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51"/>Joma ochayo ji jara ma ok obadhogi</para>
  <para style="q2" vid="PSA 119:51">to kata kamano ok alokra awe chikeni.<verse eid="PSA 119:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52"/>Asiko aparo chikeni mosebedo ka nitie nyaka nene, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 119:52">kendo ayudo hoch kuomgi.<verse eid="PSA 119:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53"/>Mirima mager omaka nikech joma timbegi richo,</para>
  <para style="q2" vid="PSA 119:53">mosejwangʼo chikeni.<verse eid="PSA 119:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54"/>Chikeni e thoro mar wenda,</para>
  <para style="q2" vid="PSA 119:54">kamoro amora ma abwore.<verse eid="PSA 119:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55"/>Aparo nyingi gotieno, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 119:55">kendo abiro rito chikni.<verse eid="PSA 119:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56"/>Ma osebedo timna,</para>
  <para style="q2" vid="PSA 119:56">nimar asebedo ka arito yoreni.<verse eid="PSA 119:56"/></para>
  <para style="qa">ח Heth</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57"/>In e pokna, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 119:57">asesingora ni abiro rito chikeni.<verse eid="PSA 119:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58"/>Asemanyo wangʼi gi chunya duto;</para>
  <para style="q2" vid="PSA 119:58">ngʼwon-na kaluwore gi singruok mari.<verse eid="PSA 119:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59"/>Asenono yorena</para>
  <para style="q2" vid="PSA 119:59">kendo asechiko yorena mondo oluw yoreni.<verse eid="PSA 119:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60"/>Abiro reto kendo ok abi deko</para>
  <para style="q2" vid="PSA 119:60">mar rito chikeni.<verse eid="PSA 119:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61"/>Kata obedo ni joma timbegi richo orida gi tonde,</para>
  <para style="q2" vid="PSA 119:61">to wiya ok bi wil gi chikeni.<verse eid="PSA 119:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62"/>Achiewo dier otieno mondo aduokni erokamano</para>
  <para style="q2" vid="PSA 119:62">kuom chikeni makare.<verse eid="PSA 119:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63"/>An osiep ji duto moluori,</para>
  <para style="q2" vid="PSA 119:63">jogo duto moluwo yoreni.<verse eid="PSA 119:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64"/>Piny opongʼ gi herani, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 119:64">yie ipuonja chikeni.<verse eid="PSA 119:64"/></para>
  <para style="qa">ט Teth</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65"/>Tim maber ne jatichni</para>
  <para style="q2" vid="PSA 119:65">kaluwore gi wachni, yaye Jehova Nyasaye.<verse eid="PSA 119:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66"/>Puonja ngʼeyo gi paro maber,</para>
  <para style="q2" vid="PSA 119:66">nimar ayie kuom chikeni.<verse eid="PSA 119:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67"/>Kane pok ayudo masira to ne abayo yo,</para>
  <para style="q2" vid="PSA 119:67">to sani koro atimo gima wachni owacho.<verse eid="PSA 119:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68"/>Iber, kendo gima itimo ber;</para>
  <para style="q2" vid="PSA 119:68">omiyo puonja chikeni.<verse eid="PSA 119:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69"/>Kata obedo ni joma ochayo ji osemiena gi miriambo,</para>
  <para style="q2" vid="PSA 119:69">to pod arito yoreni gi chunya duto.<verse eid="PSA 119:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70"/>Chunygi tek kendo ok dew gimoro amora;</para>
  <para style="q2" vid="PSA 119:70">to an to chikni miya mor.<verse eid="PSA 119:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71"/>Ne en gima ber mondo ayud chandruok</para>
  <para style="q2" vid="PSA 119:71">mondo eka apuonjra chikeni.<verse eid="PSA 119:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72"/>Chik moa e dhogi berna</para>
  <para style="q2" vid="PSA 119:72">moloyo ngʼinjo gana gi gana mag fedha gi dhahabu.<verse eid="PSA 119:72"/></para>
  <para style="qa">י Yodh</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73"/>Lweti ema nochweya;</para>
  <para style="q2" vid="PSA 119:73">miya ngʼeyo mondo apuonjra chikeni.<verse eid="PSA 119:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74"/>Mad joma oluori bed mamor ka ginena,</para>
  <para style="q2" vid="PSA 119:74">nimar aseketo genona e wachni.<verse eid="PSA 119:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75"/>Angʼeyo, yaye Jehova Nyasaye, ni chikeni nikare,</para>
  <para style="q2" vid="PSA 119:75">kendo angʼeyo ni chwat misechwadago nikare.<verse eid="PSA 119:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76"/>Mad ihoya gi herani ma ok rem,</para>
  <para style="q2" vid="PSA 119:76">kaluwore gi singruok mane imiyo jatichni.<verse eid="PSA 119:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77"/>Orna kechni mondo abed mangima,</para>
  <para style="q2" vid="PSA 119:77">nimar chikni e morna.<verse eid="PSA 119:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78"/>Mad joma ochayo ji ne wichkuot kuom kwinya maonge gima omiyo,</para>
  <para style="q2" vid="PSA 119:78">an to abiro paro matut kuom yoreni.<verse eid="PSA 119:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79"/>Mad joma oluori dog jokora,</para>
  <para style="q2" vid="PSA 119:79">kaachiel gi joma ongʼeyo bucheni.<verse eid="PSA 119:79"/></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80"/>Mad chunya bed maonge ketho, kuom rito chikeni,</para>
  <para style="q2" vid="PSA 119:80">mondo kik ane wichkuot.<verse eid="PSA 119:80"/></para>
  <para style="qa">כ Kaf</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81"/>Riyo mar dwaro warruokni oloyo chunya,</para>
  <para style="q2" vid="PSA 119:81">kata kamano aseketo genona e wachni.<verse eid="PSA 119:81"/></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82"/>Wengena ool kamanyo singruokni;</para>
  <para style="q2" vid="PSA 119:82">apenjora niya, “Ibiro hoya karangʼo?”<verse eid="PSA 119:82"/></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83"/>Kata obedo ni achalo pien tingʼo divai molier e iro,</para>
  <para style="q2" vid="PSA 119:83">to wiya pok owil gi chikeni.<verse eid="PSA 119:83"/></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84"/>Jatichni biro rito nyaka karangʼo?</para>
  <para style="q2" vid="PSA 119:84">Ibiro kumo joma sanda karangʼo?<verse eid="PSA 119:84"/></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85"/>Joma ochayo ji osekunyona buche mondo apodhie,</para>
  <para style="q2" vid="PSA 119:85">gitimo gima chikni okwedo.<verse eid="PSA 119:85"/></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86"/>Chikeni duto inyalo geno; omiyo yie ikonya,</para>
  <para style="q2" vid="PSA 119:86">nikech ji sanda maonge gima omiyo.<verse eid="PSA 119:86"/></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87"/>Ne gichiegni yweya oko e piny,</para>
  <para style="q2" vid="PSA 119:87">to kata kamano pok aweyo chikeni.<verse eid="PSA 119:87"/></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88"/>Rit ngimana kaluwore gi herani,</para>
  <para style="q2" vid="PSA 119:88">mondo alu chike mowuok e dhogi.<verse eid="PSA 119:88"/></para>
  <para style="qa">ל Lamedh</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89"/>Wachni ochwere, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 119:89">ochungʼ mogurore e polo.<verse eid="PSA 119:89"/></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90"/>Adiera mari ochwere e tienge duto;</para>
  <para style="q2" vid="PSA 119:90">mana kaka ne iguro piny mi piny osiko.<verse eid="PSA 119:90"/></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91"/>Chikeni osiko nyaka kawuono,</para>
  <para style="q2" vid="PSA 119:91">nimar gik moko duto tiyoni.<verse eid="PSA 119:91"/></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92"/>Ka dine bed ni chikeni ok ema miya mor,</para>
  <para style="q2" vid="PSA 119:92">to dikoro aselal nono nikech masichena.<verse eid="PSA 119:92"/></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93"/>Wiya ok bi wil gi bucheni,</para>
  <para style="q2" vid="PSA 119:93">nimar gin ema iseritogo ngimana.<verse eid="PSA 119:93"/></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94"/>Resa nimar an mari;</para>
  <para style="q2" vid="PSA 119:94">nikech asiko amanyo chikeni ndalo duto.<verse eid="PSA 119:94"/></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95"/>Joma timbegi richo obutona mondo gitieka,</para>
  <para style="q2" vid="PSA 119:95">to abiro bet mos ka aparo kuom chikeni.<verse eid="PSA 119:95"/></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96"/>Angʼeyo ni koda ka gik malongʼo chuth nigi gikogi,</para>
  <para style="q2" vid="PSA 119:96">to chikeni onge gikogi.<verse eid="PSA 119:96"/></para>
  <para style="qa">מ Mem</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97"/>Yaye, mano kaka ahero chikni!</para>
  <para style="q2" vid="PSA 119:97">Aparo kuome odiechiengʼ duto.<verse eid="PSA 119:97"/></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98"/>Chikeni miyo abedo mariek moloyo wasika,</para>
  <para style="q2" vid="PSA 119:98">nimar gisiko gin koda seche duto.<verse eid="PSA 119:98"/></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99"/>An gi winjo moloyo jopuonjna duto,</para>
  <para style="q2" vid="PSA 119:99">nimar arito chikeni.<verse eid="PSA 119:99"/></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100"/>Wach donjona moloyo jodongo machon</para>
  <para style="q2" vid="PSA 119:100">nimar arito chikeni.<verse eid="PSA 119:100"/></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101"/>Asetamo tiendena ni kik wuothi e yore maricho,</para>
  <para style="q2" vid="PSA 119:101">mondo eka atim gima wachni ochiko.<verse eid="PSA 119:101"/></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102"/>Pok abaro aweyo chikeni,</para>
  <para style="q2" vid="PSA 119:102">nimar in iwuon ema isepuonja.<verse eid="PSA 119:102"/></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103"/>Mano kaka wechegi mit ka abilogi,</para>
  <para style="q2" vid="PSA 119:103">gimit e dhoga moloyo mor kich!<verse eid="PSA 119:103"/></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104"/>Chikeni miyo abedo gi winjo;</para>
  <para style="q2" vid="PSA 119:104">emomiyo achayo yo moro amora marach.<verse eid="PSA 119:104"/></para>
  <para style="qa">נ Nun</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105"/>Wachni e taya mar tienda</para>
  <para style="q2" vid="PSA 119:105">kendo en ler mamenyona yo.<verse eid="PSA 119:105"/></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106"/>Asekwongʼora mi aketo sei ni abiro siko</para>
  <para style="q2" vid="PSA 119:106">kaluwo chikeni makare.<verse eid="PSA 119:106"/></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107"/>Asechandora moloyo;</para>
  <para style="q2" vid="PSA 119:107">omiyo rit ngimana, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 119:107">kaluwore gi wachni.<verse eid="PSA 119:107"/></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108"/>Rwak pak ma achiwoni gi dhoga ka ahero, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 119:108">kendo puonja chikeni.<verse eid="PSA 119:108"/></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109"/>Kata obedo ni atingʼo ngimana e lweta kinde duto,</para>
  <para style="q2" vid="PSA 119:109">to wiya ok bi wil gi chikeni.<verse eid="PSA 119:109"/></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110"/>Joma timbegi richo osechikona obadho;</para>
  <para style="q2" vid="PSA 119:110">to kata kamano pok abaro aweyo bucheni.<verse eid="PSA 119:110"/></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111"/>Chikeni e girkeni mara manyaka chiengʼ;</para>
  <para style="q2" vid="PSA 119:111">gin e mor mar chunya.<verse eid="PSA 119:111"/></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112"/>Aketo chunya kuom rito chikeni</para>
  <para style="q2" vid="PSA 119:112">ma ok aweyo nyaka giko.<verse eid="PSA 119:112"/></para>
  <para style="qa">ס Samek</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113"/>Achayo joma pachgi ariyo,</para>
  <para style="q1" vid="PSA 119:113">to ahero chikni.<verse eid="PSA 119:113"/></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114"/>In e ohingana kendo okumbana;</para>
  <para style="q2" vid="PSA 119:114">omiyo aseketo genona e wachni.<verse eid="PSA 119:114"/></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115"/>Ayiuru buta, un jorichogi,</para>
  <para style="q2" vid="PSA 119:115">mondo arit chike mag Nyasacha!<verse eid="PSA 119:115"/></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116"/>Maka motegno kaluwore gi singruokni,</para>
  <para style="q2" vid="PSA 119:116">eka anabed mangima; kik iwe geno ma an-go lalna.<verse eid="PSA 119:116"/></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117"/>Sira eka ananwangʼ konyruok;</para>
  <para style="q1" vid="PSA 119:117">abiro siko ka ahero chikeni.<verse eid="PSA 119:117"/></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118"/>Idagi ji duto mabaro weyo chikeni,</para>
  <para style="q2" vid="PSA 119:118">nimar wuondruok ma giwuondorego en kayiem.<verse eid="PSA 119:118"/></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119"/>Joma timbegi richo duto modak e piny ipuko oko ka yugi;</para>
  <para style="q2" vid="PSA 119:119">emomiyo ahero chikeni.<verse eid="PSA 119:119"/></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120"/>Denda tetni nikech oluori,</para>
  <para style="q2" vid="PSA 119:120">kihondko omaka nikech chikeni.<verse eid="PSA 119:120"/></para>
  <para style="qa">ע Ayin</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121"/>asetimo gima kare kendo madier,</para>
  <para style="q2" vid="PSA 119:121">omiyo kik iweya e lwet joma sanda.<verse eid="PSA 119:121"/></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122"/>Ne ni jatichni dhi maber,</para>
  <para style="q2" vid="PSA 119:122">kendo kik iyie joma ochayo ji osanda.<verse eid="PSA 119:122"/></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123"/>Wengena ool karango resruok mikelo,</para>
  <para style="q2" vid="PSA 119:123">kendo kamanyo gima kare mane isingona.<verse eid="PSA 119:123"/></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124"/>Timne jatichni kaluwore gi herani,</para>
  <para style="q2" vid="PSA 119:124">kendo puonja chikeni.<verse eid="PSA 119:124"/></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125"/>An jatichni, omiyo yie imiya nyalo mar ngʼeyo gik mopondo</para>
  <para style="q2" vid="PSA 119:125">eka awinj tiend chikeni.<verse eid="PSA 119:125"/></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126"/>Sa oromo mondo koro itim gimoro, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 119:126">nikech iketho chikni.<verse eid="PSA 119:126"/></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127"/>Nikech ahero chikeni moloyo dhahabu,</para>
  <para style="q2" vid="PSA 119:127">kendo moloyo dhahabu maler mogik,<verse eid="PSA 119:127"/></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128"/>kendo nikech akawo bucheni duto ni nikare,</para>
  <para style="q2" vid="PSA 119:128">omiyo achayo yo moro amora marach.<verse eid="PSA 119:128"/></para>
  <para style="qa">פ Pe</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129"/>Chikeni lich miwuoro;</para>
  <para style="q2" vid="PSA 119:129">emomiyo aritogi.<verse eid="PSA 119:129"/></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130"/>Wachni koler tiende to kelo ler,</para>
  <para style="q2" vid="PSA 119:130">omiyo joma riekogi tin bedo gi winjo.<verse eid="PSA 119:130"/></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131"/>Ayawo dhoga kendo agamo yweyo,</para>
  <para style="q2" vid="PSA 119:131">ka agombo chikeni.<verse eid="PSA 119:131"/></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132"/>Lokri iranga mondo ikecha,</para>
  <para style="q2" vid="PSA 119:132">kaka ijatimo ndalo duto ne joma ohero nyingi.<verse eid="PSA 119:132"/></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133"/>Ket okangega mondo gilure gi wachni;</para>
  <para style="q2" vid="PSA 119:133">kik iwe richo moro amora loya.<verse eid="PSA 119:133"/></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134"/>Resa e dicho ma ji diyogo jowetegi,</para>
  <para style="q2" vid="PSA 119:134">mondo eka arit bucheni.<verse eid="PSA 119:134"/></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135"/>Ngʼi jatichni gi wangʼ maber</para>
  <para style="q2" vid="PSA 119:135">kendo puonja chikeni.<verse eid="PSA 119:135"/></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136"/>Pi wangʼ bubni kawuok e wengena,</para>
  <para style="q2" vid="PSA 119:136">nimar chikni ok ji orito.<verse eid="PSA 119:136"/></para>
  <para style="qa">צ Tsadhe</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137"/>In ngʼat makare, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 119:137">kendo chikeni nikare.<verse eid="PSA 119:137"/></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138"/>Chike misendiko nikare,</para>
  <para style="q2" vid="PSA 119:138">inyalo genogi chuth.<verse eid="PSA 119:138"/></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139"/>Hera matut ma aherogo wachni tieka,</para>
  <para style="q2" vid="PSA 119:139">nimar wasika ok dew wachni.<verse eid="PSA 119:139"/></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140"/>Singruok magi osetem maber chuth,</para>
  <para style="q2" vid="PSA 119:140">omiyo jatichni oherogi.<verse eid="PSA 119:140"/></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141"/>Kata obedo ni an chien kendo ji ochaya,</para>
  <para style="q2" vid="PSA 119:141">to wiya ok nyal wil gi bucheni.<verse eid="PSA 119:141"/></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142"/>Timni makare osiko</para>
  <para style="q2" vid="PSA 119:142">kendo chikni en adier,<verse eid="PSA 119:142"/></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143"/>Chandruok kod malit osebirona,</para>
  <para style="q2" vid="PSA 119:143">kata kamano chikeni e morna.<verse eid="PSA 119:143"/></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144"/>Chikeni nikare nyaka chiengʼ,</para>
  <para style="q2" vid="PSA 119:144">omiyo miya ngʼeyo mondo abed mangima.<verse eid="PSA 119:144"/></para>
  <para style="qa">ק Kof</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145"/>Yie idwoka, yaye Jehova Nyasaye, nikech aywakni gi chunya duto</para>
  <para style="q2" vid="PSA 119:145">kendo abiro timo kaka chikni dwaro.<verse eid="PSA 119:145"/></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146"/>Aywakni, yie ikonya,</para>
  <para style="q2" vid="PSA 119:146">eka abiro rito chikeni.<verse eid="PSA 119:146"/></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147"/>Achiewo kogwen ka piny pok oyawore kendo aywagora mondo ayud kony;</para>
  <para style="q2" vid="PSA 119:147">aseketo genona e wachni.<verse eid="PSA 119:147"/></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148"/>Wengena neno otieno duto,</para>
  <para style="q2" vid="PSA 119:148">mondo omi apar matut kuom singruok magi.<verse eid="PSA 119:148"/></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149"/>Winj dwonda kaluwore gi herani;</para>
  <para style="q2" vid="PSA 119:149">rit ngimana, yaye Jehova Nyasaye, kaluwore gi chikeni.<verse eid="PSA 119:149"/></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150"/>Joma chanona gik maricho ni koda machiegni,</para>
  <para style="q2" vid="PSA 119:150">kata kamano gin mabor gi chikni.<verse eid="PSA 119:150"/></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151"/>In to in machiegni, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 119:151">kendo chikeni duto gin adier.<verse eid="PSA 119:151"/></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152"/>Ne apuonjora kuom chikeni chon gi lala,</para>
  <para style="q2" vid="PSA 119:152">ni ne igurogi mondo gisiki nyaka chiengʼ.<verse eid="PSA 119:152"/></para>
  <para style="qa">ר Resh</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153"/>Ne chandruokna mondo ikonya,</para>
  <para style="q2" vid="PSA 119:153">nimar pok wiya owil gi chikni.<verse eid="PSA 119:153"/></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154"/>Dog jakora mondo iresa,</para>
  <para style="q2" vid="PSA 119:154">rit ngimana kaluwore gi singruokni.<verse eid="PSA 119:154"/></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155"/>Warruok ni mabor gi joma timbegi richo,</para>
  <para style="q2" vid="PSA 119:155">nimar ok giket chunygi kuom dwaro chikeni.<verse eid="PSA 119:155"/></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156"/>Ngʼwononi duongʼ, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 119:156">rit ngimana kaluwore gi chikeni.<verse eid="PSA 119:156"/></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157"/>Wasigu masanda thoth adier,</para>
  <para style="q2" vid="PSA 119:157">to kata kamano pok abaro aweyo chikeni.<verse eid="PSA 119:157"/></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158"/>Arango joma onge yie ka chunya ochido kodgi,</para>
  <para style="q2" vid="PSA 119:158">nimar ok girit chikni.<verse eid="PSA 119:158"/></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159"/>Neye kaka ahero bucheni;</para>
  <para style="q2" vid="PSA 119:159">omiyo rit ngimana, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 119:159">kaluwore gi herani.<verse eid="PSA 119:159"/></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160"/>Wechegi duto gin adier;</para>
  <para style="q2" vid="PSA 119:160">kendo chikegi makare duto ochwere.<verse eid="PSA 119:160"/></para>
  <para style="qa">ש Sin gi Shin</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161"/>Jotelo sanda maonge gima omiyo,</para>
  <para style="q2" vid="PSA 119:161">to kata kamano chunya oluoro wachni.<verse eid="PSA 119:161"/></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162"/>Singruokni miya mor,</para>
  <para style="q2" vid="PSA 119:162">mana ka ngʼama oyudo mwandu maduongʼ mope wasigu.<verse eid="PSA 119:162"/></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163"/>Asin kendo ajok gi miriambo,</para>
  <para style="q2" vid="PSA 119:163">to ahero chikni.<verse eid="PSA 119:163"/></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164"/>Apaki ndalo abiriyo e odiechiengʼ achiel</para>
  <para style="q2" vid="PSA 119:164">kuom chikegi makare.<verse eid="PSA 119:164"/></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165"/>Joma ohero chikeni nigi kwe maduongʼ</para>
  <para style="q2" vid="PSA 119:165">kendo onge gima nyalo miyo gichwanyre.<verse eid="PSA 119:165"/></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166"/>Arito warruokni, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 119:166">kendo aluwo chikeni.<verse eid="PSA 119:166"/></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167"/>Atimo gima chikeni dwaro,</para>
  <para style="q2" vid="PSA 119:167">nimar aherogi gihera maduongʼ.<verse eid="PSA 119:167"/></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168"/>Arito bucheni gi chikeni,</para>
  <para style="q2" vid="PSA 119:168">nimar yorega duto ongʼereni maber.<verse eid="PSA 119:168"/></para>
  <para style="qa">ת Taw</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169"/>Mad ywakna chopi e nyimi, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 119:169">mi abed gi winjo kaluwore gi wachni.<verse eid="PSA 119:169"/></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170"/>Mad kwayona chopi e nyimi,</para>
  <para style="q2" vid="PSA 119:170">resa kaluwore gi singruokni.<verse eid="PSA 119:170"/></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171"/>Mad dhoga pongʼ gi pak,</para>
  <para style="q2" vid="PSA 119:171">nimar isepuonja chikeni.<verse eid="PSA 119:171"/></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172"/>Mad lewa wer kuom wachni,</para>
  <para style="q2" vid="PSA 119:172">nimar chikegi duto nikare.<verse eid="PSA 119:172"/></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173"/>Mad lweti ikre mar konya,</para>
  <para style="q2" vid="PSA 119:173">nimar aseyiero bucheni.<verse eid="PSA 119:173"/></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174"/>Asedwaro resruok mari matek, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 119:174">kendo chikni e morna.<verse eid="PSA 119:174"/></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175"/>We amed bedo mangima mondo apaki,</para>
  <para style="q2" vid="PSA 119:175">kendo mad chikeni okonya.<verse eid="PSA 119:175"/></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176"/>Aserwenyo ka rombo molal,</para>
  <para style="q2" vid="PSA 119:176">omiyo yie imany jatichni, nimar wiya pok owil gi chikeni.<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="cl">Zaburi 120</para>
  <para style="d">Wer miwero ka ji dhi e hekalu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1"/>Ka an e chandruok to aluongo Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 120:1">kendo odwoka,<verse eid="PSA 120:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2"/>Resa, yaye Jehova Nyasaye, kuom dho joma riambo</para>
  <para style="q2" vid="PSA 120:2">kendo kuom lew joma wuondore.<verse eid="PSA 120:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3"/>Bende ingʼeyo gima Nyasaye biro timoni,</para>
  <para style="q2" vid="PSA 120:3">bende ingʼeyo gik mochomi adier, yaye lep mawuondore?<verse eid="PSA 120:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4"/>Obiro kumi gi aserni mabitho mag jakedo,</para>
  <para style="q2" vid="PSA 120:4">ee, obiro wangʼi gi maka maliel mager,</para>
  <para style="q2" vid="PSA 120:4">mowangʼ gi yiend adugo.<verse eid="PSA 120:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5"/>Malit ochoma adier nikech adak Meshek,</para>
  <para style="q2" vid="PSA 120:5">hapa rach nikech adak e dier hembe mag Kedar!<verse eid="PSA 120:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6"/>Asedak amingʼa ahinya,</para>
  <para style="q2" vid="PSA 120:6">e dier joma ok dwar kwe.<verse eid="PSA 120:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7"/>An ngʼat kwe;</para>
  <para style="q2" vid="PSA 120:7">to ka awuoyo, to giikore ni lweny.<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="cl">Zaburi 121</para>
  <para style="d">Wer ma ji wero kadhi e hekalu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1"/>Atingʼo wangʼa ka arango gode,</para>
  <para style="q2" vid="PSA 121:1">ere kuma konyruokna biro aye?<verse eid="PSA 121:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2"/>Konyruokna aa kuom Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 121:2">Jachwech polo gi piny.<verse eid="PSA 121:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3"/>Ok obi weyo tiendi kier,</para>
  <para style="q2" vid="PSA 121:3">Jal ma riti ok bi nur;<verse eid="PSA 121:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4"/>adier, Jal marito Israel</para>
  <para style="q2" vid="PSA 121:4">ok nur kendo ok nindi.<verse eid="PSA 121:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5"/>Jehova Nyasaye riti,</para>
  <para style="q2" vid="PSA 121:5">Jehova Nyasaye e tipo moumi gi yo badi korachwich;<verse eid="PSA 121:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6"/>omiyo chiengʼ ok nochami godiechiengʼ</para>
  <para style="q2" vid="PSA 121:6">kendo dwe ok notimi gimoro gotieno.<verse eid="PSA 121:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7"/>Jehova Nyasaye biro riti</para>
  <para style="q2" vid="PSA 121:7">mondo gimoro amora kik ohinyi.<verse eid="PSA 121:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8"/>Jehova Nyasaye biro riti kidonjo kendo kiwuok,</para>
  <para style="q2" vid="PSA 121:8">obiro timo kamano sani kendo nyaka chiengʼ.<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="cl">Zaburi 122</para>
  <para style="d">Wer ma ji wero kadhi e hekalu. Mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1"/>Ne amor gi joma nowachona niya,</para>
  <para style="q2" vid="PSA 122:1">“Wadhiuru e od Jehova Nyasaye.”<verse eid="PSA 122:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2"/>Tiendewa ochungʼ</para>
  <para style="q2" vid="PSA 122:2">e dhorangeyeni, yaye Jerusalem.<verse eid="PSA 122:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3"/>Jerusalem oger ka dala</para>
  <para style="q2" vid="PSA 122:3">ma ji odakie machiegni motenore.<verse eid="PSA 122:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4"/>Kanyo e kama ogendini idho dhiye,</para>
  <para style="q2" vid="PSA 122:4">ogendini mag Jehova Nyasaye dhi kuno,</para>
  <para style="q1" vid="PSA 122:4">mondo opak nying Jehova Nyasaye</para>
  <para style="q2" vid="PSA 122:4">ka giluwo chike mane omi Israel.<verse eid="PSA 122:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5"/>Kanyo ema kombe loch mag ngʼado bura nitie</para>
  <para style="q2" vid="PSA 122:5">gin kombe loch mag jood Daudi.<verse eid="PSA 122:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6"/>Lamuru mondo Jerusalem obed gi kwe.</para>
  <para style="q2" vid="PSA 122:6">Lamuru niya, “Mad joma oheri bed gi kwe.<verse eid="PSA 122:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7"/>Mad kwe yudre ei alworani,</para>
  <para style="q2" vid="PSA 122:7">adier kwe mondo obedi ei ohinga mochieli.”<verse eid="PSA 122:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8"/>Nikech owetena gi osiepena modak e iyi,</para>
  <para style="q2" vid="PSA 122:8">awacho niya, “Jerusalem mondo obed gi kwe.”<verse eid="PSA 122:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9"/>Nikech wach od Jehova Nyasaye ma Nyasachwa,</para>
  <para style="q2" vid="PSA 122:9">adwaro ni idhi maber.<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="cl">Zaburi 123</para>
  <para style="d">Wer ma ji wero kadhi e hekalu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1"/>Atingʼo wangʼa ka arango,</para>
  <para style="q2" vid="PSA 123:1">in ma kom lochni ni e polo.<verse eid="PSA 123:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2"/>Mana kaka wenge wasumbini rango lwet ruodhgi,</para>
  <para style="q2" vid="PSA 123:2">kendo kaka wenge jatich ma nyako mar ot rango lwet ruodhe madhako,</para>
  <para style="q1" vid="PSA 123:2">e kaka wengewa rango Jehova Nyasaye ma Nyasachwa</para>
  <para style="q2" vid="PSA 123:2">nyaka chop okechwa.<verse eid="PSA 123:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3"/>Yie ikechwa, yaye Jehova Nyasaye, yie ikechwa,</para>
  <para style="q2" vid="PSA 123:3">nikech osechawa gi kinda.<verse eid="PSA 123:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4"/>Josunga osejarowa moromo</para>
  <para style="q2" vid="PSA 123:4">acheje bende osechayowa moromo.<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="cl">Zaburi 124</para>
  <para style="d">Wer ma ji wero kadhi e hekalu. Mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1"/>Ka dine bed ni Jehova Nyasaye ok jakorwa,</para>
  <para style="q2" vid="PSA 124:1">jo-Israel mondo owach kamano,<verse eid="PSA 124:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2"/>ka dine bed ni Jehova Nyasaye ok jakorwa</para>
  <para style="q2" vid="PSA 124:2">kane ji omonjowa,<verse eid="PSA 124:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3"/>e kinde mane mirima mabebni ka mach omakogi kodwa,</para>
  <para style="q2" vid="PSA 124:3">to dine gimwonyowa ngili;<verse eid="PSA 124:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4"/>ataro dine odinonwa,</para>
  <para style="q2" vid="PSA 124:4">ee, kodh yamo dine oywerowa,<verse eid="PSA 124:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5"/>kendo pi maringo matek</para>
  <para style="q2" vid="PSA 124:5">dine odhi kodwa.<verse eid="PSA 124:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6"/>Pak mondo odogne Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 124:6">ma ok oseyie mondo gikidhwa gi lekegi.<verse eid="PSA 124:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7"/>Wasetony mana ka winyo</para>
  <para style="q2" vid="PSA 124:7">mowuok e wino mar jachik winy;</para>
  <para style="q1" vid="PSA 124:7">wino osechodi,</para>
  <para style="q2" vid="PSA 124:7">to wan wasetony.<verse eid="PSA 124:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8"/>Konyruokwa ni e nying Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 124:8">Jachwech polo gi piny.<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="cl">Zaburi 125</para>
  <para style="d">Wer ma ji wero kadhi e hekalu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1"/>Joma ogeno kuom Jehova Nyasaye chalo gi Got Sayun,</para>
  <para style="q2" vid="PSA 125:1">ma ok nyal yiengi to osiko nyaka chiengʼ.<verse eid="PSA 125:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2"/>Mana kaka gode olworo Jerusalem,</para>
  <para style="q2" vid="PSA 125:2">e kaka Jehova Nyasaye olworo joge chakre,</para>
  <para style="q2" vid="PSA 125:2">tinende kendo nyaka chiengʼ.<verse eid="PSA 125:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3"/>Ludh loch mar joma timbegi richo</para>
  <para style="q2" vid="PSA 125:3">ok bi siko korito piny mopog ne joma kare,</para>
  <para style="q1" vid="PSA 125:3">nimar ka mano otimore</para>
  <para style="q2" vid="PSA 125:3">to joma kare nyalo tiyo gi lwetgi kuom timo marach.<verse eid="PSA 125:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4"/>Tim maber, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 125:4">kendo ni jogo moriere gie chunygi.<verse eid="PSA 125:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5"/>To joma lokore luwo yore mobam</para>
  <para style="q2" vid="PSA 125:5">Jehova Nyasaye biro kumo kaachiel gi joma timo timbe maricho.</para>
  <para style="b" vid="PSA 125:5"/>
  <para style="q1" vid="PSA 125:5">Israel mondo obed gi kwe.<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="cl">Zaburi 126</para>
  <para style="d">Wer ma ji wero kadhi e hekalu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1"/>Kane Jehova Nyasaye odwogo joma otwe Sayun,</para>
  <para style="q2" vid="PSA 126:1">to ne ochalonwa mana lek.<verse eid="PSA 126:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2"/>Ne wathungʼ gi nyiero</para>
  <para style="q2" vid="PSA 126:2">kendo dhowa nopongʼ gi wende mor.</para>
  <para style="q1" vid="PSA 126:2">Eka nowachore e dier ogendini niya,</para>
  <para style="q2" vid="PSA 126:2">“Jehova Nyasaye osetimonegi gik madongo.”<verse eid="PSA 126:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3"/>Adier, Jehova Nyasaye osetimonwa gik madongo,</para>
  <para style="q2" vid="PSA 126:3">omiyo wamor mokalo.<verse eid="PSA 126:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4"/>Duognwa gigewa, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 126:4">mondo wachal gi aore man Negev.<verse eid="PSA 126:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5"/>Joma komo kodhi kaywak</para>
  <para style="q2" vid="PSA 126:5">biro keyo ka wero wende mor.<verse eid="PSA 126:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6"/>Ngʼat madhi oko kaywak,</para>
  <para style="q2" vid="PSA 126:6">kotingʼo kodhi mikomo,</para>
  <para style="q1" vid="PSA 126:6">biro duogo ka wero wende mor,</para>
  <para style="q2" vid="PSA 126:6">kotingʼo cham mosechiek.<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="cl">Zaburi 127</para>
  <para style="d">Wer ma ji wero kadhi e hekalu. Mar Solomon.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1"/>Ka Jehova Nyasaye ok ema ger ot,</para>
  <para style="q2" vid="PSA 127:1">to joma gere nyagore gi tich matek kayiem nono.</para>
  <para style="q1" vid="PSA 127:1">Ka Jehova Nyasaye ok ema orito dala,</para>
  <para style="q2" vid="PSA 127:1">to jorito ochungʼ karito kayiem.<verse eid="PSA 127:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2"/>In bende imondo chiewo chon</para>
  <para style="q2" vid="PSA 127:2">kendo ineno nyaka sa molewo,</para>
  <para style="q1" vid="PSA 127:2">kinyagori gi tich matek mondo iyud chiemo minyalo chamo;</para>
  <para style="q2" vid="PSA 127:2">nimar Nyasaye miyo joge mohero nindo mokwe.<verse eid="PSA 127:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3"/>Yawuowi gin gweth moa kuom Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 127:3">adier, nyithindo gin mich moa kuome.<verse eid="PSA 127:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4"/>Yawuowi ma ngʼato onywolo kapod otin,</para>
  <para style="q2" vid="PSA 127:4">chalo gi asere manie lwet jakedo.<verse eid="PSA 127:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5"/>Ngʼat ma ofukune opongʼ kodgi</para>
  <para style="q2" vid="PSA 127:5">en ngʼama ogwedhi.</para>
  <para style="q1" vid="PSA 127:5">Ok ginine wichkuot</para>
  <para style="q2" vid="PSA 127:5">ka gikedo gi wasikgi e dhorangach.<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="cl">Zaburi 128</para>
  <para style="d">Wer ma ji wero kadhi e hekalu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1"/>Ji duto moluoro Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 128:1">kendo ngimagi oriere gie chunygi.<verse eid="PSA 128:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2"/>Ibiro chamo olemb luchi;</para>
  <para style="q2" vid="PSA 128:2">iniyud gweth kendo inidhi maber.<verse eid="PSA 128:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3"/>Chiegi nochal gi yiend mzabibu manyak maber</para>
  <para style="q2" vid="PSA 128:3">e odi;</para>
  <para style="q1" vid="PSA 128:3">nyithindi nochal gi chuny zeituni maloth</para>
  <para style="q2" vid="PSA 128:3">e kinde ma gilworo mesa ka gichiemo.<verse eid="PSA 128:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4"/>Kamano e kaka ngʼama oluoro Jehova Nyasaye</para>
  <para style="q2" vid="PSA 128:4">ogwedhi.<verse eid="PSA 128:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5"/>Jehova Nyasaye mondo ogwedhi gie Sayun,</para>
  <para style="q2" vid="PSA 128:5">ndalo duto mag ngimani;</para>
  <para style="q1" vid="PSA 128:5">mad ineye gi wangʼi ka Jerusalem dhi maber,<verse eid="PSA 128:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 128:6"/>kendo mad idag amingʼa nyaka ine nyithind nyithindi,</para>
  <para style="q2" vid="PSA 128:6">Israel mondo obed gi kwe!<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="cl">Zaburi 129</para>
  <para style="d">Wer ma ji wero kadhi e hekalu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1"/>“Jogi osesanda malit nyaka aa e tin-na,”</para>
  <para style="q2" vid="PSA 129:1">Israel mondo owach niya;<verse eid="PSA 129:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2"/>“gisesanda malit nyaka aa e tin-na,</para>
  <para style="q2" vid="PSA 129:2">to kata kamano pok gibedo gi loch kuoma.<verse eid="PSA 129:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3"/>Jopur osepuro diengʼeya</para>
  <para style="q2" vid="PSA 129:3">kendo gisegore opara ma roboche,<verse eid="PSA 129:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4"/>to kata kamano Jehova Nyasaye en ngʼama kare;</para>
  <para style="q2" vid="PSA 129:4">osegola e badho mar joma timbegi richo.”<verse eid="PSA 129:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5"/>Ji duto mochayo Sayun</para>
  <para style="q2" vid="PSA 129:5">lo mi dog chien gi wichkuot.<verse eid="PSA 129:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6"/>Mad gichal gi lum moti ewi tado</para>
  <para style="q2" vid="PSA 129:6">maner kata kapok odongo maber.<verse eid="PSA 129:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7"/>Ok onyal nyago gimoro mapongʼo lwet jakeyo,</para>
  <para style="q2" vid="PSA 129:7">kata ma jachoko nyalo tingʼo e bade.<verse eid="PSA 129:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8"/>Mad joma kalo bute kik wachnegi niya,</para>
  <para style="q2" vid="PSA 129:8">“Jehova Nyasaye mondo ogwedhi, kata ni,</para>
  <para style="q2" vid="PSA 129:8">wagwedhi e nying Jehova Nyasaye.”<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="cl">Zaburi 130</para>
  <para style="d">Wer ma ji wero kadhi e hekalu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1"/>Aywakni ka an e chuny bur matut, yaye Jehova Nyasaye,<verse eid="PSA 130:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 130:2"/>Yaye Jehova Nyasaye, yie iwinj dwonda.</para>
  <para style="q1" vid="PSA 130:2">Chik iti ne ywakna ma aywaknigo</para>
  <para style="q2" vid="PSA 130:2">mondo ikecha.<verse eid="PSA 130:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3"/>Yaye Jehova Nyasaye, ka dine bed ni isiko iparo richo, ma ji timo,</para>
  <para style="q2" vid="PSA 130:3">yaye Jehova Nyasaye, to en ngʼa ma dichungʼ e nyimi ka ok bura oloyo?<verse eid="PSA 130:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4"/>To kata kamano kuomi nitiere weyo richo;</para>
  <para style="q2" vid="PSA 130:4">kuom mano watiyoni gi luor.<verse eid="PSA 130:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5"/>Arito Jehova Nyasaye, chunya rite</para>
  <para style="q2" vid="PSA 130:5">kendo aketo genona kuom wachne.<verse eid="PSA 130:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6"/>Chunya rito Ruoth Nyasaye,</para>
  <para style="q2" vid="PSA 130:6">moloyo kaka jorito rito ru piny,</para>
  <para style="q1" vid="PSA 130:6">chunya riti, yaye Nyasaye,</para>
  <para style="q2" vid="PSA 130:6">moloyo kaka jorito rito ru piny.<verse eid="PSA 130:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7"/>Yaye jo-Israel, keturu genou kuom Jehova Nyasaye, nimar Jehova Nyasaye</para>
  <para style="q2" vid="PSA 130:7">nigi hera ma ok rem,</para>
  <para style="q2" vid="PSA 130:7">kendo en ema owaro ji chuth.<verse eid="PSA 130:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8"/>En owuon ema obiro waro jo-Israel</para>
  <para style="q2" vid="PSA 130:8">kuom richogi duto.<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="cl">Zaburi 131</para>
  <para style="d">Wer ma ji wero kadhi e hekalu. Mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1"/>Ngʼayi onge e chunya, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 131:1">wangʼa bende ok tek;</para>
  <para style="q1" vid="PSA 131:1">chunya ok chandre gi gik madongo,</para>
  <para style="q2" vid="PSA 131:1">kata gi weche matek modhiera ngʼeyo.<verse eid="PSA 131:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2"/>To abet mos kendo chunya okwe;</para>
  <para style="q2" vid="PSA 131:2">mana ka nyathi ma pod dhoth molingʼ mos e bad min,</para>
  <para style="q1" vid="PSA 131:2">ee, kaka nyathi ma kamano lingʼ mos,</para>
  <para style="q2" vid="PSA 131:2">e kaka chunya bende olingʼ mos e iya.<verse eid="PSA 131:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3"/>Yaye Israel, keturu genou kuom Jehova Nyasaye</para>
  <para style="q2" vid="PSA 131:3">chakre tinende kendo nyaka chiengʼ.<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="cl">Zaburi 132</para>
  <para style="d">Wer ma ji wero kadhi e hekalu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1"/>Parie Daudi, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 132:1">parie Daudi gi chandruok duto moseneno.<verse eid="PSA 132:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2"/>Ne okwongʼore kane osingore ne Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 132:2">kendo ne okwongʼore ne Nyasaye Maratego mar Jakobo kama:<verse eid="PSA 132:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3"/>“Ok anadonji e oda,</para>
  <para style="q2" vid="PSA 132:3">kata dhi e kitandana,<verse eid="PSA 132:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4"/>Ok anayie nindo tera,</para>
  <para style="q2" vid="PSA 132:4">kata ayula wangʼ lo wengena,<verse eid="PSA 132:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5"/>kapok aloso ne Jehova Nyasaye kare,</para>
  <para style="q2" vid="PSA 132:5">kapok ayudo ne Nyasaye Maratego mar Jakobo kar dak.”<verse eid="PSA 132:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6"/>Ne wawinjo wachno Efratha,</para>
  <para style="q2" vid="PSA 132:6">ee, ne wayude e puothe mag Jaar:<verse eid="PSA 132:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7"/>“Wadhiuru kare modakie;</para>
  <para style="q2" vid="PSA 132:7">wadhiuru mondo walame e nyim kom duongʼne, ka wawacho niya,<verse eid="PSA 132:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8"/>‘Aa malo, yaye Jehova Nyasaye, aa malo ibi kari mar yweyo,</para>
  <para style="q2" vid="PSA 132:8">in kaachiel gi Sandug Muma ma en kido mar tekoni.<verse eid="PSA 132:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9"/>Mad jodolo magi rwakre gi tim makare,</para>
  <para style="q2" vid="PSA 132:9">kendo mad jogi maler wer gi mor.’ ”<verse eid="PSA 132:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10"/>Nikech Daudi jatichni,</para>
  <para style="q2" vid="PSA 132:10">kik idagi ngʼati miseyiero.<verse eid="PSA 132:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11"/>Jehova Nyasaye nokwongʼore kendo osingore ne Daudi,</para>
  <para style="q2" vid="PSA 132:11">kendo ne en kwongʼruok ma ok enoloki ngangʼ;</para>
  <para style="q1" vid="PSA 132:11">nokwongʼorene niya,</para>
  <para style="q2" vid="PSA 132:11">“Abiro keto achiel kuom kothi e lochni,<verse eid="PSA 132:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12"/>ka yawuoti orito singruokna</para>
  <para style="q2" vid="PSA 132:12">kod chike ma apuonjogi,</para>
  <para style="q1" vid="PSA 132:12">eka yawuotgi nobedi,</para>
  <para style="q2" vid="PSA 132:12">e lochni nyaka chiengʼ kendo nyaka chiengʼ.”<verse eid="PSA 132:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13"/>Nimar Jehova Nyasaye oseyiero Sayun,</para>
  <para style="q2" vid="PSA 132:13">osehere kaka kar dakne, osewacho ni,<verse eid="PSA 132:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14"/>Ma e kar yweyona mochwere manyaka chiengʼ,</para>
  <para style="q2" vid="PSA 132:14">kae ema abiro betie kom lochna, nimar asehere,<verse eid="PSA 132:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15"/>abiro gwedhe gi gik moko mogundho,</para>
  <para style="q2" vid="PSA 132:15">kendo joge modhier abiro romo gi chiemo.<verse eid="PSA 132:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16"/>Abiro rwako jodolo mage gi warruok</para>
  <para style="q2" vid="PSA 132:16">kendo jomaler modak e iye biro siko ka wero wende mor.<verse eid="PSA 132:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17"/>“Ka eni ema abiro miyo tung moro donge ne Daudi</para>
  <para style="q2" vid="PSA 132:17">kendo abiro chungo taya ne ngʼata mowir.<verse eid="PSA 132:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18"/>Abiro bako wasike gi wichkuot,</para>
  <para style="q2" vid="PSA 132:18">to en osimbo manie wiye biro medo rieny.”<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="cl">Zaburi 133</para>
  <para style="d">Wer ma ji wero kadhi e hekalu. Mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1"/>Mano kaka en gima ber kendo malongʼo,</para>
  <para style="q2" vid="PSA 133:1">ka jowete odak kanyakla gi kwe!<verse eid="PSA 133:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2"/>Dak ma kamano chalo gi mo ma nengone tek mool e wich</para>
  <para style="q2" vid="PSA 133:2">kendo mamol piny nyaka e tik,</para>
  <para style="q1" vid="PSA 133:2">mamol piny koluwo tik Harun</para>
  <para style="q2" vid="PSA 133:2">kamol piny mos mos nyaka e ngʼut kandhone.<verse eid="PSA 133:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3"/>Ochalo bende gi thoo momoko e Got Hermon</para>
  <para style="q2" vid="PSA 133:3">maridore ewi Got Sayun.</para>
  <para style="q1" vid="PSA 133:3">Nimar kanyo ema Jehova Nyasaye chiwe gwethne,</para>
  <para style="q2" vid="PSA 133:3">ma en ngima mochwere.<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="cl">Zaburi 134</para>
  <para style="d">Wer ma ji wero kadhi e hekalu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1"/>Pakuru Jehova Nyasaye, un jotich duto mag Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 134:1">kendo matiyo gotieno e od Jehova Nyasaye.<verse eid="PSA 134:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2"/>Tingʼuru bedeu malo e kare maler mar lemo</para>
  <para style="q2" vid="PSA 134:2">kendo upak Jehova Nyasaye.<verse eid="PSA 134:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3"/>Mad Jehova Nyasaye ma jachwech polo gi piny,</para>
  <para style="q2" vid="PSA 134:3">ogwedhu gie Sayun.<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="cl">Zaburi 135</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1"/>Pakuru Jehova Nyasaye.</para>
  <para style="q1" vid="PSA 135:1">Pakuru nying Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 135:1">pakeuru, un jotich mag Jehova Nyasaye,<verse eid="PSA 135:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2"/>un mutiyo e od Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 135:2">e laru mag od Nyasachwa.<verse eid="PSA 135:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3"/>Pakuru Jehova Nyasaye, nimar Jehova Nyasaye ber;</para>
  <para style="q2" vid="PSA 135:3">pakuru nyinge gi wende pak nimar timo kamano en gima ber.<verse eid="PSA 135:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4"/>Nimar Jehova Nyasaye oseyiero Jakobo, mondo obed gire owuon;</para>
  <para style="q2" vid="PSA 135:4">oseyiero Israel, mondo obed mwandune mogeno.<verse eid="PSA 135:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5"/>Angʼeyo ni Jehova Nyasaye duongʼ,</para>
  <para style="q2" vid="PSA 135:5">angʼeyo adier ni Ruoth Nyasachwa duongʼ moloyo nyiseche duto.<verse eid="PSA 135:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6"/>Jehova Nyasaye timo gimoro amora mohero,</para>
  <para style="q2" vid="PSA 135:6">e polo kendo e piny,</para>
  <para style="q2" vid="PSA 135:6">ei nembe kendo e kudegi.<verse eid="PSA 135:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7"/>Omiyo boche wuok koa e tungʼ piny koni gi koni,</para>
  <para style="q2" vid="PSA 135:7">kendo ooro mil polo ka koth chue,</para>
  <para style="q2" vid="PSA 135:7">bende okelo yamo kogolo e utege mokanogie.<verse eid="PSA 135:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8"/>Ne ogoyo nyithindo makayo mag Misri,</para>
  <para style="q2" vid="PSA 135:8">nyithindo makayo mag dhano kod le.<verse eid="PSA 135:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9"/>Ne ooro ranyisi gi honni mage e dieru, yaye Misri,</para>
  <para style="q2" vid="PSA 135:9">noorogi kuom Farao kaachiel gi jotichne duto.<verse eid="PSA 135:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10"/>Ne ogoyo pinje mangʼeny piny,</para>
  <para style="q2" vid="PSA 135:10">kendo ne onego ruodhi maroteke,<verse eid="PSA 135:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11"/>kaka Sihon ruodh jo-Amor,</para>
  <para style="q2" vid="PSA 135:11">gi Og ruodh Bashan,</para>
  <para style="q2" vid="PSA 135:11">kod ruodhi duto mag Kanaan,<verse eid="PSA 135:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12"/>kendo nomiyogi piny jogo kaka girkeni,</para>
  <para style="q2" vid="PSA 135:12">kaka girkeni ne joge ma gin jo-Israel.<verse eid="PSA 135:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13"/>Yaye Jehova Nyasaye, nyingi osiko nyaka chiengʼ,</para>
  <para style="q2" vid="PSA 135:13">yaye Jehova Nyasaye, humbi ochwere e tienge duto.<verse eid="PSA 135:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14"/>Nimar Jehova Nyasaye biro chwako joge,</para>
  <para style="q2" vid="PSA 135:14">kendo obiro kecho jotichne.<verse eid="PSA 135:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15"/>Nyiseche mopa mag ogendini gin fedha gi dhahabu,</para>
  <para style="q2" vid="PSA 135:15">molos gi lwet dhano.<verse eid="PSA 135:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16"/>Gin gi dhogi, to kata kamano, ok ginyal wuoyo,</para>
  <para style="q2" vid="PSA 135:16">gin gi wenge, to ok ginyal neno.<verse eid="PSA 135:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17"/>Gin gi it, to ok ginyal winjo wach,</para>
  <para style="q2" vid="PSA 135:17">kendo kata mana muya onge e dhogi.<verse eid="PSA 135:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18"/>Joma losogi nobed machal kodgi,</para>
  <para style="q2" vid="PSA 135:18">kendo joma oketo genogi kuomgi bende biro chalo kodgi.<verse eid="PSA 135:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19"/>Un jo-Israel, pakuru Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 135:19">un dhood joka Harun, pakuru Jehova Nyasaye;<verse eid="PSA 135:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20"/>un dhood joka Lawi, pakuru Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 135:20">pakuru Jehova Nyasaye, un ji duto moluore.<verse eid="PSA 135:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21"/>Jehova Nyasaye mondo opaki gie Sayun,</para>
  <para style="q2" vid="PSA 135:21">Jal modak Jerusalem mondo opaki.</para>
  <para style="b" vid="PSA 135:21"/>
  <para style="q1" vid="PSA 135:21">Pakuru Jehova Nyasaye!<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="cl">Zaburi 136</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1"/>Gouru erokamano ne Jehova Nyasaye, nimar ober.</para>
  <para style="qr" vid="PSA 136:1">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2"/>Gouru erokamano ne Nyasach nyiseche:</para>
  <para style="qr" vid="PSA 136:2">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3"/>Gouru erokamano ne Ruodh ruodhi:</para>
  <para style="qr" vid="PSA 136:3">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4"/>Ne en kendo matimo honni madongo,</para>
  <para style="qr" vid="PSA 136:4">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5"/>Jal mane oloso polo gi riekone,</para>
  <para style="qr" vid="PSA 136:5">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6"/>Jal mane oyaro piny ewi pige,</para>
  <para style="qr" vid="PSA 136:6">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7"/>Jal mane oloso rameny madongo dongo,</para>
  <para style="qr" vid="PSA 136:7">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8"/>Nochweyo wangʼ chiengʼ mondo orit odiechiengʼ,</para>
  <para style="qr" vid="PSA 136:8">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9"/>kod dwe gi sulwe mondo orit otieno;</para>
  <para style="qr" vid="PSA 136:9">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10"/>ne En mane onego nyithindo makayo mag Misri,</para>
  <para style="qr" vid="PSA 136:10">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11"/>kendo mane ogolo jo-Israel oko kuomgi,</para>
  <para style="qr" vid="PSA 136:11">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12"/>nogologi gi lwedo motegno kod bat morie;</para>
  <para style="qr" vid="PSA 136:12">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13"/>ne En mane obaro Nam Makwar diere ariyo;</para>
  <para style="qr" vid="PSA 136:13">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14"/>mi nogolo jo-Israel koluwo diere tir,</para>
  <para style="qr" vid="PSA 136:14">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15"/>to Farao gi jolwenje to nomiyo Nam Makwar oywero;</para>
  <para style="qr" vid="PSA 136:15">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16"/>ne En mane otelo ne joge e thim,</para>
  <para style="qr" vid="PSA 136:16">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17"/>ne En mane ogoyo ruodhi madongo piny,</para>
  <para style="qr" vid="PSA 136:17">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18"/>kendo mane onego ruodhi maroteke;</para>
  <para style="qr" vid="PSA 136:18">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19"/>Kaka Sihon ruodh jo-Amor,</para>
  <para style="qr" vid="PSA 136:19">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20"/>gi Og ruodh Bashan,</para>
  <para style="qr" vid="PSA 136:20">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21"/>mi nochiwo pinygi kaka girkeni,</para>
  <para style="qr" vid="PSA 136:21">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22"/>Kaka girkeni ne Israel jatichne;</para>
  <para style="qr" vid="PSA 136:22">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23"/>ne En mane oparowa ka piny ochamowa,</para>
  <para style="qr" vid="PSA 136:23">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24"/>kendo mane ogonyowa e lwet wasikwa,</para>
  <para style="qr" vid="PSA 136:24">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25"/>machiwo chiemo ne chwech duto,</para>
  <para style="qr" vid="PSA 136:25">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26"/>Gouru erokamano ne Nyasach polo,</para>
  <para style="qr" vid="PSA 136:26">Herane osiko nyaka chiengʼ.<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="cl">Zaburi 137</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1"/>E bath aore mag Babulon ne wabet piny kendo ne waywak</para>
  <para style="q2" vid="PSA 137:1">kane waparo Sayun.<verse eid="PSA 137:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2"/>Ne wangʼawo thumbewa</para>
  <para style="q2" vid="PSA 137:2">ewi omburi mane ni kanyo,<verse eid="PSA 137:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3"/>nimar joma ne omakowa nokwayowa wende kane wan kanyo,</para>
  <para style="q2" vid="PSA 137:3">joma nesandowa nochunowa ni wawernegi wende mor;</para>
  <para style="q2" vid="PSA 137:3">negiwachonwa niya, “Wernwauru achiel kuom wende Sayun!”<verse eid="PSA 137:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4"/>Ere kaka wanyalo wero wende Jehova Nyasaye</para>
  <para style="q2" vid="PSA 137:4">kapod wan e piny ma wendo?<verse eid="PSA 137:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5"/>Ka dipo ni wiya owil kodi, yaye Jerusalem,</para>
  <para style="q2" vid="PSA 137:5">to mad lweta ma korachwich wiye wil gi tichne.<verse eid="PSA 137:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6"/>Mad lewa moki e danda</para>
  <para style="q2" vid="PSA 137:6">ka dipo ni ok apari,</para>
  <para style="q1" vid="PSA 137:6">ka dipo ni ok aketo chunya kuomi,</para>
  <para style="q2" vid="PSA 137:6">yaye Jerusalem, morna maduongʼ mogik.<verse eid="PSA 137:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7"/>Parie gima ne jo-Edom otimo, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 137:7">parie gima negitimo chiengʼ mane Jerusalem opodho.</para>
  <para style="q1" vid="PSA 137:7">Ne gikok matek niya, “Mukeuru ogoye piny.</para>
  <para style="q2" vid="PSA 137:7">Mukeuru ogore piny gi mise mare duto!”<verse eid="PSA 137:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8"/>Yaye nyar Babulon, in mochanni kethruok,</para>
  <para style="q2" vid="PSA 137:8">ngʼama nochuli kuom gima isetimonwa en jahawi,<verse eid="PSA 137:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9"/>ngʼat manomak nyithindi mayom</para>
  <para style="q2" vid="PSA 137:9">mi gogi piny e lwendni en jahawi.<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="cl">Zaburi 138</para>
  <para style="d">Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1"/>Abiro paki gi chunya duto, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 138:1">abiro paki gi wer e nyim nyiseche.<verse eid="PSA 138:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2"/>Abiro kulora piny ka achomo hekalu mari maler</para>
  <para style="q2" vid="PSA 138:2">kendo abiro pako nyingi,</para>
  <para style="q2" vid="PSA 138:2">nikech herani kod adierani,</para>
  <para style="q1" vid="PSA 138:2">nimar isetingʼo nyingi kod Wachni malo</para>
  <para style="q2" vid="PSA 138:2">moyombo gik moko duto.<verse eid="PSA 138:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3"/>Kane aluongo to ne idwoka,</para>
  <para style="q2" vid="PSA 138:3">kendo ne imiyo abedo gi chir kod chuny motegno.<verse eid="PSA 138:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4"/>Mad ruodhi duto mag piny paki, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 138:4">e sa ma giwinjo weche mowuok e dhogi.<verse eid="PSA 138:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5"/>Mad giwer kuom yore mag Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 138:5">nimar duongʼ mar Jehova Nyasaye ngʼongo.<verse eid="PSA 138:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6"/>Jehova Nyasaye rango joma obolore kata obedo ni en malo to josunga</para>
  <para style="q2" vid="PSA 138:6">to ongʼeyo kata kapod gin gichien.<verse eid="PSA 138:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7"/>Kata obedo ni awuotho e dier chandruok,</para>
  <para style="q2" vid="PSA 138:7">to irito ngimana;</para>
  <para style="q1" vid="PSA 138:7">irieyo lweti kuom mirimb joma kedo koda,</para>
  <para style="q2" vid="PSA 138:7">kendo iresa gi lweti ma korachwich.<verse eid="PSA 138:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8"/>Jehova Nyasaye biro chopona chenroge;</para>
  <para style="q2" vid="PSA 138:8">yaye Jehova Nyasaye, herani osiko nyaka chiengʼ:</para>
  <para style="q2" vid="PSA 138:8">kik ijwangʼ tije ma iloso gi lweti.<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="cl">Zaburi 139</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1"/>Yaye Jehova Nyasaye, isenona</para>
  <para style="q2" vid="PSA 139:1">kendo ingʼeya.<verse eid="PSA 139:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2"/>Ingʼeya sa ma abet piny nyaka sa ma aa malo;</para>
  <para style="q2" vid="PSA 139:2">adier, ingʼeyo parona gi kuma bor.<verse eid="PSA 139:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3"/>Bende ingʼeyo yorega ma aluwo kod kuonde ma ayweyoe;</para>
  <para style="q2" vid="PSA 139:3">yorena duto oyangoreni maber.<verse eid="PSA 139:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4"/>Kata kapok wach moro owuok e dhoga</para>
  <para style="q2" vid="PSA 139:4">to ingʼeye malongʼo, yaye Jehova Nyasaye.<verse eid="PSA 139:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5"/>Ilwora koni gi koni mi iketa diere;</para>
  <para style="q2" vid="PSA 139:5">adier, iseuma duto gi lweti.<verse eid="PSA 139:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6"/>Rieko ma kamano lichna miwuoro,</para>
  <para style="q2" vid="PSA 139:6">kendo otutna moyombo pacha.<verse eid="PSA 139:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7"/>Dadhi kure eka apond ne Roho mari?</para>
  <para style="q2" vid="PSA 139:7">Koso kanye ma daring adhiye mondo apondni?<verse eid="PSA 139:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8"/>Ka aidho e polo, to in kuno;</para>
  <para style="q2" vid="PSA 139:8">ka aloso kitandana e bur matut, to in kuno.<verse eid="PSA 139:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9"/>Ka aidho yamb kogwen</para>
  <para style="q2" vid="PSA 139:9">mondo otera e tok nam komachielo,<verse eid="PSA 139:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10"/>to kata kuno bende lweti biro telonae,</para>
  <para style="q2" vid="PSA 139:10">kendo lweti ma korachwich biro maka motegno.<verse eid="PSA 139:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11"/>Ka awacho niya, “Mudho biro ima adier</para>
  <para style="q2" vid="PSA 139:11">kendo ler biro lokorena otieno,”<verse eid="PSA 139:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12"/>to in mudho ok timni mudho</para>
  <para style="q2" vid="PSA 139:12">kendo otieno rienyni ka odiechiengʼ,</para>
  <para style="q2" vid="PSA 139:12">nimar mudho chaloni ler.<verse eid="PSA 139:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13"/>In ema ne ichweyo dhanda maiye,</para>
  <para style="q2" vid="PSA 139:13">adier, ne ingʼina maber gi ei minwa.<verse eid="PSA 139:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14"/>Apaki nikech ne ichweya mongʼith kendo malich miwuoro;</para>
  <para style="q2" vid="PSA 139:14">tijeni misetimo lich,</para>
  <para style="q2" vid="PSA 139:14">kendo angʼeyo mano maber.<verse eid="PSA 139:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15"/>Fuonde mag ringra ne ok opondoni,</para>
  <para style="q2" vid="PSA 139:15">kane ochweya ei minwa,</para>
  <para style="q2" vid="PSA 139:15">kane ochwe ringra e kama opondo,<verse eid="PSA 139:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16"/>wangʼi ne oneno ringra ei minwa;</para>
  <para style="q2" vid="PSA 139:16">ndalona duto e piny-ka ne ondiki chon gi lala,</para>
  <para style="q2" vid="PSA 139:16">e kitabu mari kane pok kata achiel kuomgi obetie.<verse eid="PSA 139:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17"/>Mano kaka pachi tutna, yaye Nyasaye!</para>
  <para style="q2" vid="PSA 139:17">Mano kaka gingʼeny mokalo akwana kargi duto!<verse eid="PSA 139:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18"/>Ka dine bed ni anyalo kwanogi,</para>
  <para style="q2" vid="PSA 139:18">to dine giloyo kuoyo gi ngʼeny.</para>
  <para style="q1" vid="PSA 139:18">Sa ma achiew to ayudo</para>
  <para style="q2" vid="PSA 139:18">ni pod an mana kodi.<verse eid="PSA 139:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19"/>Yaye Jehova Nyasaye, mad iyie ineg joma timbegi richo!</para>
  <para style="q2" vid="PSA 139:19">Ayiuru buta, un joma rich chwero remb ji omakogi!<verse eid="PSA 139:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20"/>Giwuoyo kuomi gi paro marach;</para>
  <para style="q2" vid="PSA 139:20">adier, wasiki tiyo gi nyingi e yo marach.<verse eid="PSA 139:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21"/>Donge amon gi jomamon kodi, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 139:21">koso donge ok awinjra gi joma chungʼ mondo oked kodi?<verse eid="PSA 139:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22"/>Achayogi kendo aonge kodgi gi tich</para>
  <para style="q2" vid="PSA 139:22">adier akwanogi kaka wasika.<verse eid="PSA 139:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23"/>Nona, yaye Jehova Nyasaye, mondo ingʼe chunya;</para>
  <para style="q2" vid="PSA 139:23">tema, mondo ingʼe pacha.<verse eid="PSA 139:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24"/>Tim kamano mondo ineane ka nitie gimoro marach kuoma,</para>
  <para style="q2" vid="PSA 139:24">mondo itera e yor ngima mochwere.<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="cl">Zaburi 140</para>
  <para style="d">Kuom jatend wer. Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1"/>Resa, yaye Jehova Nyasaye, kuom joma richo,</para>
  <para style="q2" vid="PSA 140:1">konya e lwet jo-mahundu,<verse eid="PSA 140:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2"/>joma chano chenro maricho e chunygi</para>
  <para style="q2" vid="PSA 140:2">kendo gitugo lweny pile pile.<verse eid="PSA 140:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3"/>Gipiago lewgi mabith ka lew thuol</para>
  <para style="q2" vid="PSA 140:3">kendo kwiri mar thuond fu ni e lewgi. <char style="qs">Sela</char><note caller="+" style="f"><char style="fr" closed="false">140:3 </char><char style="fq" closed="false">Sela </char><char style="ft" closed="false">tiend wachni ok ongʼere.</char></note><verse eid="PSA 140:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4"/>Rita, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 140:4">rita e lwet joma timbegi richo;</para>
  <para style="q2" vid="PSA 140:4">konya e lwet jo-mahundu machano gajo tiendena.<verse eid="PSA 140:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5"/>Josunga chikona obadho;</para>
  <para style="q2" vid="PSA 140:5">giseyarona gogo mondo amokie,</para>
  <para style="q2" vid="PSA 140:5">kendo gisechikona otegu e yorega ma aluwo. <char style="qs">Sela</char><verse eid="PSA 140:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6"/>Yaye Jehova Nyasaye, awachoni niya, “In Nyasacha.”</para>
  <para style="q2" vid="PSA 140:6">Omiyo yie iwinja, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 140:6">winj ywak ma aywaknigo mondo ikecha.<verse eid="PSA 140:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7"/>Yaye Jehova Nyasaye Manyalo Gik Moko Duto, ma jakonyna motegno,</para>
  <para style="q2" vid="PSA 140:7">in migengʼona wiya sa ma lweny ger.<verse eid="PSA 140:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8"/>Kik iyie mondo joma timbegi richo oyud gik</para>
  <para style="q2" vid="PSA 140:8">ma chunygi gombo, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 140:8">kik iyie mondo chenrogi otimre. <char style="qs">Sela</char><verse eid="PSA 140:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9"/>Mi mondo chandruok ma joma olwora bwogago,</para>
  <para style="q2" vid="PSA 140:9">odog e wiyegi.<verse eid="PSA 140:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10"/>Mi mondo makaa maliel mager oolre kuomgi,</para>
  <para style="q2" vid="PSA 140:10">ee, ne ni odirgi e mach,</para>
  <para style="q2" vid="PSA 140:10">kata e thidhna ma nimo ji, ma ok ginyal wuokie kendo.<verse eid="PSA 140:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11"/>Mi mondo joma ketho nying jowetegi kik dhi maber e piny,</para>
  <para style="q2" vid="PSA 140:11">ee, ne ni masira olawo jo-mahundu mi ojukogi.<verse eid="PSA 140:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12"/>Angʼeyo ni Jehova Nyasaye miyo jodhier yudo adieragi,</para>
  <para style="q2" vid="PSA 140:12">kendo oneno ni ongʼad bura kare ne joma ochando.<verse eid="PSA 140:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13"/>Joma kare biro pako nyingi adier</para>
  <para style="q2" vid="PSA 140:13">kendo joma ngimagi oriere tir biro dak kangima e nyimi.<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="cl">Zaburi 141</para>
  <para style="d">Zaburi Mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1"/>Aluongi, yaye Jehova Nyasaye, yie ibi ira piyo.</para>
  <para style="q2" vid="PSA 141:1">Yie iwinj dwonda ka aluongi.<verse eid="PSA 141:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2"/>Mad lamona osiki e nyimi mana ka ubani miwangʼo,</para>
  <para style="q2" vid="PSA 141:2">kendo bedena osik koriere kochomo malo mana ka misango mitimoni godhiambo.<verse eid="PSA 141:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3"/>Yaye Jehova Nyasaye, ket jarit e dhoga;</para>
  <para style="q2" vid="PSA 141:3">ketna jarit mondo okonya umo dhoga.<verse eid="PSA 141:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4"/>Kik iyie gimoro amora marach ywa chunya,</para>
  <para style="q2" vid="PSA 141:4">ma dimi an bende atim timbe maricho,</para>
  <para style="q1" vid="PSA 141:4">kaachiel gi joma timbe gi richo;</para>
  <para style="q2" vid="PSA 141:4">rita mondo kik acham chiembgi mabeyonegi.<verse eid="PSA 141:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5"/>Onego ngʼat makare ema ogoya, nikech mano chalo tim ngʼwono motimona;</para>
  <para style="q2" vid="PSA 141:5">onego en ema okwera, nikech mano chalo mo mool e wiya;</para>
  <para style="q2" vid="PSA 141:5">ok anyal dagi mondo ngʼama kare otimna kamano.</para>
  <para style="b" vid="PSA 141:5"/>
  <para style="q1" vid="PSA 141:5">To kata kamano obiro kwedo timbe joma richo e lemona;<verse eid="PSA 141:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 141:6"/>chiengʼ ma nowit ruodhigi piny koa ewi got mabor,</para>
  <para style="q2" vid="PSA 141:6">eka joma timbegi richo nongʼe ni kare wechena ne gin adier.<verse eid="PSA 141:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7"/>Giniwach niya, “Mana kaka ngʼato puro kendo toyo lowo,</para>
  <para style="q2" vid="PSA 141:7">e kaka chokewa osekere e dho bur liel.”<verse eid="PSA 141:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8"/>Anto atego wangʼa kuomi, yaye Jehova Nyasaye Manyalo Gik Moko Duto;</para>
  <para style="q2" vid="PSA 141:8">In e kar pondona, omiyo kik iwe atho.<verse eid="PSA 141:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9"/>Kik iwe obadho ma gisechikona maka,</para>
  <para style="q2" vid="PSA 141:9">ee, resa kuom otegu ma joma timbegi richo ochikona.<verse eid="PSA 141:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10"/>Mad joma timbegi richogo moki e gokegi giwegi</para>
  <para style="q2" vid="PSA 141:10">ka anto akadho maber mak gimoro otima.<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="cl">Zaburi 142</para>
  <para style="d">
    <char style="tl">Maskil</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">142:0 </char>
      <char style="fl" closed="false">Maskil: </char>
      <char style="ft" closed="false">en kit wer moro mane Daudi owero</char>
    </note> mar Daudi. Kane en ei bur. Lamo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1"/>Aywak matek ne Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 142:1">atingʼo dwonda ne Jehova Nyasaye mondo okecha.<verse eid="PSA 142:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2"/>Ahulone gik mathaga duto;</para>
  <para style="q2" vid="PSA 142:2">anyise chandruokna duto ka abet e nyime.<verse eid="PSA 142:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3"/>E kinde ma chunya chandore e iya,</para>
  <para style="q2" vid="PSA 142:3">to in ema ingʼeyo yor konyruokna.</para>
  <para style="q1" vid="PSA 142:3">E bugo matut ma awuothoe</para>
  <para style="q2" vid="PSA 142:3">ji osechikonae obadho.<verse eid="PSA 142:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4"/>Rang batha korachwich;</para>
  <para style="q2" vid="PSA 142:4">mondo ine kaonge ngʼama dewa.</para>
  <para style="q1" vid="PSA 142:4">Aonge kar pondo;</para>
  <para style="q2" vid="PSA 142:4">bende aonge ngʼama rito ngimana.<verse eid="PSA 142:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5"/>Aywakni, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 142:5">awachoni niya, “In e kar pondona,</para>
  <para style="q2" vid="PSA 142:5">kendo in e pokna e piny joma ngima.”<verse eid="PSA 142:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6"/>Yie iwinj ywakna,</para>
  <para style="q2" vid="PSA 142:6">nimar an-gi chandruok maduongʼ;</para>
  <para style="q1" vid="PSA 142:6">resa e lwet joma lawa</para>
  <para style="q2" vid="PSA 142:6">nimar gitek moloya mabor.<verse eid="PSA 142:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7"/>Gonya e twech ma antie,</para>
  <para style="q2" vid="PSA 142:7">mondo apak nyingi.</para>
  <para style="q1" vid="PSA 142:7">Eka joma kare biro chokore buta</para>
  <para style="q2" vid="PSA 142:7">nikech ber misetimona.<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="cl">Zaburi 143</para>
  <para style="d">Zaburi mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1"/>Winj lamona, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 143:1">chik iti ne ywakna mar kech;</para>
  <para style="q1" vid="PSA 143:1">bi mondo ikonya</para>
  <para style="q2" vid="PSA 143:1">nikech in ja-adiera kendo itimo maber.<verse eid="PSA 143:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2"/>Kik imi jatichni yud kum</para>
  <para style="q2" vid="PSA 143:2">nimar onge kata ngʼato achiel matimo maber e nyimi.<verse eid="PSA 143:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3"/>Jasigu lawa matek,</para>
  <para style="q2" vid="PSA 143:3">oserodha piny nyaka e lowo;</para>
  <para style="q1" vid="PSA 143:3">ochuna ni nyaka adag kama otimo mudho</para>
  <para style="q2" vid="PSA 143:3">mana ka joma notho chon gi lala.<verse eid="PSA 143:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4"/>Omiyo chunya chandore e iya,</para>
  <para style="q2" vid="PSA 143:4">ee, chunya obwok.<verse eid="PSA 143:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5"/>Aparo higni machon mosekalo;</para>
  <para style="q2" vid="PSA 143:5">aketo pacha mos kuom tijeni duto,</para>
  <para style="q2" vid="PSA 143:5">kendo ageno gik ma lweti osetimo.<verse eid="PSA 143:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6"/>Ayaroni lwetena;</para>
  <para style="q2" vid="PSA 143:6">chunya gombi mana kaka lowo motwo gombo koth. <char style="qs">Sela</char><verse eid="PSA 143:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7"/>Dwoka piyo, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 143:7">nimar chunya ool.</para>
  <para style="q1" vid="PSA 143:7">Kik ipandna wangʼi</para>
  <para style="q2" vid="PSA 143:7">nono to dipoka achalo gi joma ridore e bur matut.<verse eid="PSA 143:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8"/>Mi mondo okinyi oromna gi herani ma ok rem,</para>
  <para style="q2" vid="PSA 143:8">nimar aketo genona kuomi.</para>
  <para style="q1" vid="PSA 143:8">Nyisa yo monego alu</para>
  <para style="q2" vid="PSA 143:8">nimar aketo chunya duto kuomi.<verse eid="PSA 143:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9"/>Resa e lwet wasika, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="PSA 143:9">nimar in e jaritna.<verse eid="PSA 143:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10"/>Puonja timo dwaroni,</para>
  <para style="q2" vid="PSA 143:10">nimar in e Nyasacha;</para>
  <para style="q1" vid="PSA 143:10">mi mondo Roho mari maber,</para>
  <para style="q2" vid="PSA 143:10">otelna e yo mopie.<verse eid="PSA 143:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11"/>Yaye Jehova Nyasaye, kony ngimana nikech nyingi iwuon;</para>
  <para style="q2" vid="PSA 143:11">gola oko e chandruok nikech timni maber.<verse eid="PSA 143:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12"/>Mi wasika olingʼ thi,</para>
  <para style="q2" vid="PSA 143:12">nikech herani ma ok rem;</para>
  <para style="q2" vid="PSA 143:12">tiek joma kedo koda duto nimar an jatichni.<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="cl">Zaburi 144</para>
  <para style="d">Mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1"/>Pak obed ni Jehova Nyasaye ma en Lwandana,</para>
  <para style="q2" vid="PSA 144:1">pakeuru en motego lwetena ne lweny,</para>
  <para style="q2" vid="PSA 144:1">kendo en momiyo lith lwetena bedo mongʼith e kedo.<verse eid="PSA 144:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2"/>En Nyasacha ma jahera kendo en ohingana,</para>
  <para style="q2" vid="PSA 144:2">bende en kar pondona kendo en jakonyna.</para>
  <para style="q1" vid="PSA 144:2">En okumbana ma agengʼorago,</para>
  <para style="q2" vid="PSA 144:2">kendo en ema oloyona joma ni e bwoya.<verse eid="PSA 144:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3"/>Dhano to en angʼo, yaye Jehova Nyasaye, momiyo iketo chunyi kuome,</para>
  <para style="q2" vid="PSA 144:3">koso wuod dhano to en angʼo, momiyo isiko ipare?<verse eid="PSA 144:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4"/>Dhano chalo gi muya nono</para>
  <para style="q2" vid="PSA 144:4">kendo ndalone chalo gi tipo makadho piyo.<verse eid="PSA 144:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5"/>Wuogi e polo, yaye Jehova Nyasaye, wuogi mondo ilor piny;</para>
  <para style="q2" vid="PSA 144:5">lor piny imul gode, mondo gidhuol iro.<verse eid="PSA 144:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6"/>Or mil polo, mondo ike wasigu;</para>
  <para style="q2" vid="PSA 144:6">dir aserni magi, mondo itiekgi.<verse eid="PSA 144:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7"/>Rie lweti koa e polo nyaka piny,</para>
  <para style="q2" vid="PSA 144:7">mondo ikonya, kendo igola,</para>
  <para style="q1" vid="PSA 144:7">e pige ma tekregi ngʼeny,</para>
  <para style="q2" vid="PSA 144:7">kendo e lwet jopinje mamoko,<verse eid="PSA 144:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8"/>ma dhogi opongʼ gi miriambo</para>
  <para style="q2" vid="PSA 144:8">kendo ma lwetgi ma korachwich opongʼ gi wuondruok.<verse eid="PSA 144:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9"/>Abiro weroni wer manyien, yaye Nyasaye;</para>
  <para style="q2" vid="PSA 144:9">abiro weroni wer mamit ka agoyoni thum man-gi tonde apar,<verse eid="PSA 144:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10"/>abiro werne Jal mamiyo ruodhi locho,</para>
  <para style="q2" vid="PSA 144:10">kendo makonyo Daudi jatichne e dho ligangla mager.<verse eid="PSA 144:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11"/>Konya kendo gola</para>
  <para style="q2" vid="PSA 144:11">e lwet jopinje mamoko,</para>
  <para style="q1" vid="PSA 144:11">ma dhogi opongʼ gi miriambo</para>
  <para style="q2" vid="PSA 144:11">kendo ma lwetgi ma korachwich opongʼ gi wuondruok.<verse eid="PSA 144:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12"/>Eka yawuotwa</para>
  <para style="q2" vid="PSA 144:12">biro chalo gi yiende mayudo pi maber,</para>
  <para style="q1" vid="PSA 144:12">kendo nyiwa biro chalo gi sirni modol maber</para>
  <para style="q2" vid="PSA 144:12">mondo olich dala ruoth.<verse eid="PSA 144:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13"/>Dechewa biro pongʼ</para>
  <para style="q2" vid="PSA 144:13">gi kit mwandu duto.</para>
  <para style="q1" vid="PSA 144:13">Rombewa biro medore gana gi gana,</para>
  <para style="q2" vid="PSA 144:13">ee, gibiro bedo gana mathoth e lek magwa,<verse eid="PSA 144:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 144:14"/>kendo rwedhi magwa biro ywayo misike mapek.</para>
  <para style="q1" vid="PSA 144:14">Jokwoge ok nodonj e kundewa,</para>
  <para style="q2" vid="PSA 144:14">bende ok noterwa e twech,</para>
  <para style="q2" vid="PSA 144:14">kendo yoreyore ok nogo e gwengʼwa.<verse eid="PSA 144:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15"/>Ogwedh joma gigi gin adier kuomgi;</para>
  <para style="q2" vid="PSA 144:15">kendo ogwedh jogo ma Nyasachgi en Jehova Nyasaye.<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="cl">Zaburi 145</para>
  <para style="d">Zaburi mar pak. Mar Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1"/>Abiro tingʼo nyingi malo, yaye Nyasacha ma Ruoth;</para>
  <para style="q2" vid="PSA 145:1">abiro pako nyingi nyaka chiengʼ kendo nyaka chiengʼ.<verse eid="PSA 145:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2"/>Abiro paki pile ka pile</para>
  <para style="q2" vid="PSA 145:2">kendo abiro tingʼo nyingi malo mochwere manyaka chiengʼ.<verse eid="PSA 145:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3"/>Jehova Nyasaye duongʼ miwuoro kendo owinjore gi pak,</para>
  <para style="q2" vid="PSA 145:3">onge ngʼama nyalo yango duongʼne.<verse eid="PSA 145:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4"/>Tiengʼ achiel biro pako tijeni ne tiengʼ machielo;</para>
  <para style="q2" vid="PSA 145:4">adier, gibiro nyiso ji kuom tijeni madongo.<verse eid="PSA 145:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5"/>Gibiro wuoyo kuom duongʼni mangʼongo kendo marieny,</para>
  <para style="q2" vid="PSA 145:5">to an abiro paro mos kuom tijeni miwuoro.<verse eid="PSA 145:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6"/>Gibiro nyiso kuom tekoni mitimogo gik malich miwuoro,</para>
  <para style="q2" vid="PSA 145:6">to an abiro hulo kuom tijeni madongo.<verse eid="PSA 145:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7"/>Gibiro loso nyasi mar ber ni mogundho</para>
  <para style="q2" vid="PSA 145:7">kendo gibiro wer gi mor kuom timbeni makare.<verse eid="PSA 145:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8"/>Jehova Nyasaye ngʼwon kendo kecho ji,</para>
  <para style="q2" vid="PSA 145:8">iye ok wangʼ piyo kendo en gihera mangʼeny.<verse eid="PSA 145:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9"/>Jehova Nyasaye timo maber ne ji duto;</para>
  <para style="q2" vid="PSA 145:9">okecho ji duto mosechweyo.<verse eid="PSA 145:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10"/>Ji duto ma isechweyo biro paki, yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PSA 145:10">jogi maler duto biro dhiali.<verse eid="PSA 145:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11"/>Gibiro nyiso ji kuom duongʼ mar pinyruodhi</para>
  <para style="q2" vid="PSA 145:11">kendo gibiro wuoyo kuom tekoni,<verse eid="PSA 145:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12"/>mondo ji duto ongʼe gik madongo mitimo</para>
  <para style="q2" vid="PSA 145:12">kod duongʼ mangʼongo mar pinyruodhi.<verse eid="PSA 145:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13"/>Pinyruodhi en pinyruoth mochwere,</para>
  <para style="q2" vid="PSA 145:13">kendo lochni osiko nyaka tienge duto.</para>
  <para style="b" vid="PSA 145:13"/>
  <para style="q1" vid="PSA 145:13">Jehova Nyasaye chopo singruok mage duto</para>
  <para style="q2" vid="PSA 145:13">kendo ohero ji duto mosechweyo.<verse eid="PSA 145:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14"/>Jehova Nyasaye chungo ji duto mopodho</para>
  <para style="q2" vid="PSA 145:14">kendo omiyo joma piny otaro aa malo.<verse eid="PSA 145:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15"/>In ema wenge ji duto ngʼiyi,</para>
  <para style="q2" vid="PSA 145:15">kendo imiyogi chiembgi e kinde mowinjore.<verse eid="PSA 145:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16"/>Ka iyawo lweti</para>
  <para style="q2" vid="PSA 145:16">to gik mangima duto yudo konyruokgi duto.<verse eid="PSA 145:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17"/>Jehova Nyasaye nikare e yorene duto</para>
  <para style="q2" vid="PSA 145:17">kendo ohero ji duto mosechweyo.<verse eid="PSA 145:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18"/>Jehova Nyasaye ni machiegni gi ji duto maluongo nyinge,</para>
  <para style="q2" vid="PSA 145:18">to mana joma luongo nyinge e adiera.<verse eid="PSA 145:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19"/>Ochopo dwaro mag joma omiye luor;</para>
  <para style="q2" vid="PSA 145:19">adier, owinjo ywakgi kendo oresogi.<verse eid="PSA 145:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20"/>Jehova Nyasaye rito maber ji duto mohere,</para>
  <para style="q2" vid="PSA 145:20">to ji duto ma timbegi richo obiro tieko.<verse eid="PSA 145:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21"/>Dhoga biro wacho pak ne Jehova Nyasaye.</para>
  <para style="q2" vid="PSA 145:21">Gik mangima duto mondo opak nyinge maler,</para>
  <para style="q2" vid="PSA 145:21">nyaka chiengʼ kendo nyaka chiengʼ.<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="cl">Zaburi 146</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1"/>Pak ne Jehova Nyasaye!</para>
  <para style="q1" vid="PSA 146:1">Yaye chunya, pak Jehova Nyasaye.<verse eid="PSA 146:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 146:2"/>Abiro pako Jehova Nyasaye e ngimana duto;</para>
  <para style="q2" vid="PSA 146:2">abiro wero wende pak ne Nyasacha kinde duto ma angima.<verse eid="PSA 146:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3"/>Kik iket genoni kuom ruodhi mag piny,</para>
  <para style="q2" vid="PSA 146:3">kata kuom dhano matho ma ok nyal waro ngʼato,<verse eid="PSA 146:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 146:4"/>nikech ka chunygi ochot to gidok e lowo;</para>
  <para style="q2" vid="PSA 146:4">kendo chiengʼono chenrogi ogik gikanyono.<verse eid="PSA 146:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5"/>Ogwedh ngʼat ma konyruokne en Nyasach Jakobo,</para>
  <para style="q2" vid="PSA 146:5">ngʼat ma genone ni kuom Jehova Nyasaye ma Nyasache.<verse eid="PSA 146:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6"/>En jachwech mar polo gi piny,</para>
  <para style="q2" vid="PSA 146:6">gi nam kod gik moko duto manie igi,</para>
  <para style="q2" vid="PSA 146:6">osiko ka en ja-adiera nyaka chiengʼ.<verse eid="PSA 146:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7"/>Ochwako ngʼat misando</para>
  <para style="q2" vid="PSA 146:7">kendo ochiwo chiemo ne joma odenyo.</para>
  <para style="q1" vid="PSA 146:7">Jehova Nyasaye gonyo joma otwe mi gibed thuolo,<verse eid="PSA 146:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 146:8"/>kendo Jehova Nyasaye miyo muofni neno.</para>
  <para style="q1" vid="PSA 146:8">Jehova Nyasaye miyo joma piny otaro aa malo,</para>
  <para style="q2" vid="PSA 146:8">kendo ohero joma kare.<verse eid="PSA 146:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9"/>Jehova Nyasaye rito jadak</para>
  <para style="q2" vid="PSA 146:9">kendo okonyo nyathi kich gi dhako ma chwore otho,</para>
  <para style="q2" vid="PSA 146:9">to yore mag ngʼama timbene richo to orocho.<verse eid="PSA 146:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10"/>Jehova Nyasaye olocho nyaka chiengʼ yaye Sayun,</para>
  <para style="q2" vid="PSA 146:10">Nyasachi olocho nyaka tienge duto mabiro.</para>
  <para style="b" vid="PSA 146:10"/>
  <para style="q1" vid="PSA 146:10">Pakuru Jehova Nyasaye!<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="cl">Zaburi 147</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1"/>Pakuru Jehova Nyasaye!</para>
  <para style="q1" vid="PSA 147:1">Mano kaka en gima ber wero wende pak ne Nyasachwa,</para>
  <para style="q2" vid="PSA 147:1">mano kaka en gima longʼo kendo mowinjore mondo ji opake!<verse eid="PSA 147:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2"/>Jehova Nyasaye gero Jerusalem kendo;</para>
  <para style="q2" vid="PSA 147:2">ochoko jo-Israel mane otwe.<verse eid="PSA 147:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3"/>Ochango joma chunygi tuo</para>
  <para style="q2" vid="PSA 147:3">kendo othiedho adhondegi.<verse eid="PSA 147:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4"/>Osekwano kendo ongʼeyo kar romb sulwe duto</para>
  <para style="q2" vid="PSA 147:4">kendo oluongo moro ka moro kuomgi gi nyinge.<verse eid="PSA 147:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5"/>Ruodhwa duongʼ kendo en gi teko kendo nyalo;</para>
  <para style="q2" vid="PSA 147:5">ngʼeyone onge gikone.<verse eid="PSA 147:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6"/>Jehova Nyasaye tingʼo joma obolore malo</para>
  <para style="q2" vid="PSA 147:6">to joma timbegi richo to ochwado piny e lowo.<verse eid="PSA 147:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7"/>Weruru ne Jehova Nyasaye kugoyone erokamano,</para>
  <para style="q2" vid="PSA 147:7">weruru wer mamit ne Nyasachwa kugoyo nyatiti.<verse eid="PSA 147:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8"/>Oumo kor polo gi boche polo,</para>
  <para style="q2" vid="PSA 147:8">kendo oromo piny gi koth,</para>
  <para style="q2" vid="PSA 147:8">bende omiyo lum twi ewi thuche.<verse eid="PSA 147:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9"/>Ochiwo chiemo ne dhok</para>
  <para style="q2" vid="PSA 147:9">kendo ne agege ka giywakne.<verse eid="PSA 147:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10"/>Morne ok ni kuom teko farase</para>
  <para style="q2" vid="PSA 147:10">kata kuom ogwand dhano;<verse eid="PSA 147:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11"/>to Jehova Nyasaye mor gi joma omiye luor;</para>
  <para style="q2" vid="PSA 147:11">joma oketo genogi kuom herane ma ok rem.<verse eid="PSA 147:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12"/>Dhial Jehova Nyasaye, yaye Jerusalem;</para>
  <para style="q2" vid="PSA 147:12">pak Nyasachi, yaye Sayun.<verse eid="PSA 147:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13"/>Omedo sirni manie dhorangeyeni teko,</para>
  <para style="q2" vid="PSA 147:13">kendo ogwedho jogi modak e iyi.<verse eid="PSA 147:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14"/>Omiyo kwe bedo e tongʼ pinyu</para>
  <para style="q2" vid="PSA 147:14">kendo oromou gi ngano mabeyoe mogik.<verse eid="PSA 147:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15"/>Ooro chikne e piny,</para>
  <para style="q2" vid="PSA 147:15">kendo wachne ringo matek ka diemo wangʼ.<verse eid="PSA 147:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16"/>Oyaro pe ka yie rombo</para>
  <para style="q2" vid="PSA 147:16">kendo okeyo ongʼwengʼo ka buru.<verse eid="PSA 147:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17"/>Odiro pe mage e piny ka kit ombo.</para>
  <para style="q2" vid="PSA 147:17">En ngʼa manyalo ngino sa ma odiro pe kamano?<verse eid="PSA 147:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18"/>Ooro wachne kendo pego leny nono;</para>
  <para style="q2" vid="PSA 147:18">ee, otugo yembene mi pego lokre pi mamol.<verse eid="PSA 147:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19"/>Osenyiso Jakobo wachne,</para>
  <para style="q2" vid="PSA 147:19">ee, osenyiso Israel chikene gi buchene.<verse eid="PSA 147:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20"/>Onge oganda moro machielo mosetimone kamano</para>
  <para style="q2" vid="PSA 147:20">kendo gin ok gingʼeyo chikene.</para>
  <para style="b" vid="PSA 147:20"/>
  <para style="q1" vid="PSA 147:20">Pakuru Jehova Nyasaye!<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="cl">Zaburi 148</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1"/>Pakuru Jehova Nyasaye!</para>
  <para style="q1" vid="PSA 148:1">Pakuru Jehova Nyasaye gie polo,</para>
  <para style="q2" vid="PSA 148:1">ee, pakeuru gi malo kuma bor.<verse eid="PSA 148:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2"/>Pakeuru, un malaikane duto,</para>
  <para style="q2" vid="PSA 148:2">pakeuru, un jopolo duto.<verse eid="PSA 148:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3"/>Wangʼ chiengʼ gi dwe</para>
  <para style="q2" vid="PSA 148:3">bende opake, kaachiel gi sulwe duto marieny.<verse eid="PSA 148:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4"/>Un polo man malo mogik,</para>
  <para style="q2" vid="PSA 148:4">pakeuru, kaachiel gi un, pige manie bwo polo.<verse eid="PSA 148:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5"/>Onego gipak nying Jehova Nyasaye kargi duto</para>
  <para style="q2" vid="PSA 148:5">nimar nogolo chik mine gibetie.<verse eid="PSA 148:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6"/>Ne ogurogi kuondegi nyaka chiengʼ</para>
  <para style="q2" vid="PSA 148:6">kendo nyaka chiengʼ kaluwore gi chikne mochwere.<verse eid="PSA 148:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7"/>Pakuru Jehova Nyasaye gie piny,</para>
  <para style="q2" vid="PSA 148:7">un gik madongo mag nam kod kude matut duto mag ataro,<verse eid="PSA 148:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8"/>kaachiel gi mil polo gi pe gi theluji gi boche,</para>
  <para style="q2" vid="PSA 148:8">kod yembe maringo matek mawinjo wachne;<verse eid="PSA 148:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9"/>kod un gode gi thuche</para>
  <para style="q2" vid="PSA 148:9">gi yiende manyago olembe gi yiende mag sida duto;<verse eid="PSA 148:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10"/>kod le mager gi jamni duto</para>
  <para style="q2" vid="PSA 148:10">gi le matindo gi winy mafuyo,<verse eid="PSA 148:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11"/>kod ruodhi mag piny gi ogendini duto;</para>
  <para style="q2" vid="PSA 148:11">kod un jotelo gi joloch duto mag piny,<verse eid="PSA 148:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12"/>kod un yawuowi matindo gi nyiri matindo,</para>
  <para style="q2" vid="PSA 148:12">gi jodongo kod nyithindo.<verse eid="PSA 148:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13"/>Onego gipak nying Jehova Nyasaye gin duto,</para>
  <para style="q2" vid="PSA 148:13">nimar nyinge kende ema nigi duongʼ;</para>
  <para style="q2" vid="PSA 148:13">kendo duongʼne maler oyombo piny gi polo.<verse eid="PSA 148:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14"/>Osechungo tung ne joge,</para>
  <para style="q2" vid="PSA 148:14">tung mosekelo pak ne joge maler duto,</para>
  <para style="q2" vid="PSA 148:14">joge ma jo-Israel, ma gin joma ni machiegni gi chunye.</para>
  <para style="b" vid="PSA 148:14"/>
  <para style="q1" vid="PSA 148:14">Pakuru Jehova Nyasaye!<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="cl">Zaburi 149</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1"/>Pakuru Jehova Nyasaye!</para>
  <para style="q1" vid="PSA 149:1">Werneuru Jehova Nyasaye wer manyien,</para>
  <para style="q2" vid="PSA 149:1">kendo dendeuru e chokruok mar jomaler.<verse eid="PSA 149:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2"/>Jo-Israel mondo obed mamor gi jachwechgi;</para>
  <para style="q2" vid="PSA 149:2">ee, jo-Sayun mondo obed mamor gi Ruodhgi.<verse eid="PSA 149:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3"/>Onego gi pak nyinge gi miel</para>
  <para style="q2" vid="PSA 149:3">kendo giwerne mamit ka gigoyo oyieke gi nyatiti.<verse eid="PSA 149:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4"/>Nimar chuny Jehova Nyasaye mor gi joge</para>
  <para style="q2" vid="PSA 149:4">kendo osidho joma obolore gi warruok.<verse eid="PSA 149:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5"/>Jomaler mondo oil kamiye duongʼ</para>
  <para style="q2" vid="PSA 149:5">kendo giwer gimor ka gibet e kitandagi.<verse eid="PSA 149:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6"/>Onego pak mar Nyasaye obed e dhogi</para>
  <para style="q2" vid="PSA 149:6">kendo gitingʼ ligangla ma dhoge ariyo e lwetgi,<verse eid="PSA 149:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7"/>mondo gichulgo kuor ni ogendini</para>
  <para style="q2" vid="PSA 149:7">kendo gikum ogendini mamoko,<verse eid="PSA 149:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8"/>kendo gitwe ruodhigi gi nyoroche,</para>
  <para style="q2" vid="PSA 149:8">kod jotendgi gi opingo mag chuma,<verse eid="PSA 149:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9"/>ka gichopo kum mane ondik kuomgi chon.</para>
  <para style="q2" vid="PSA 149:9">Ma e duongʼ mar joge maler duto.</para>
  <para style="b" vid="PSA 149:9"/>
  <para style="q1" vid="PSA 149:9">Pakuru Jehova Nyasaye!<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="cl">Zaburi 150</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1"/>Pakuru Jehova Nyasaye!</para>
  <para style="q1" vid="PSA 150:1">Pakuru Nyasaye e kare maler mar lemo;</para>
  <para style="q2" vid="PSA 150:1">pakeuru ei polo mare mar nyalo.<verse eid="PSA 150:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2"/>Pakeuru nikech tijene mosetimo kuom tekone maduongʼ;</para>
  <para style="q2" vid="PSA 150:2">kendo nikech duongʼne moyombo duto.<verse eid="PSA 150:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3"/>Pakeuru kugoyo turumbete,</para>
  <para style="q2" vid="PSA 150:3">kendo kugoyo nyatiti gi asili,<verse eid="PSA 150:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4"/>pakeuru kugoyo oyieke kendo umiel,</para>
  <para style="q2" vid="PSA 150:4">ee, pakeuru gi gita kod oporo,<verse eid="PSA 150:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5"/>pakeuru kudiemo ongengʼo gi nyawadgi,</para>
  <para style="q2" vid="PSA 150:5">ee, pakeuru ka ongengʼo gore.<verse eid="PSA 150:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6"/>Gimoro amora mayweyo mondo opak Jehova Nyasaye.</para>
  <para style="q1" vid="PSA 150:6">Pakuru Jehova Nyasaye.<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
