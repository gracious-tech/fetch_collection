<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Biblica® Open New Luo Translation 2020</book>
  <para style="h">Ywagruok</para>
  <para style="toc1">Ywagruok</para>
  <para style="toc2">Ywagruok</para>
  <para style="toc3">Ywa</para>
  <para style="mt1">Ywagruok</para>
  <chapter number="1" style="c" sid="LAM 1"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1"/>Mano kaka dala maduongʼ mane ji ngʼenyie</para>
  <para style="q2" vid="LAM 1:1">odongʼ nono!</para>
  <para style="q1" vid="LAM 1:1">Kinde moro ne en dala malich miwuoro</para>
  <para style="q2" vid="LAM 1:1">to koro ochalo gi dhako ma chwore otho!</para>
  <para style="q1" vid="LAM 1:1">Ne en ruoth madhako e kind pinje,</para>
  <para style="q2" vid="LAM 1:1">to tinde osebedo misumba.<verse eid="LAM 1:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2"/>Oywak malit gotieno,</para>
  <para style="q2" vid="LAM 1:2">pi wangʼe ridore e lembe.</para>
  <para style="q1" vid="LAM 1:2">Kuom joherane duto,</para>
  <para style="q2" vid="LAM 1:2">onge moro manyalo hoye.</para>
  <para style="q1" vid="LAM 1:2">Osiepene duto osendhoge</para>
  <para style="q2" vid="LAM 1:2">kendo gisebedo jowasike.<verse eid="LAM 1:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3"/>Bangʼ sand gi tij achuna,</para>
  <para style="q2" vid="LAM 1:3">Juda oseter e twech.</para>
  <para style="q1" vid="LAM 1:3">Odak e dier ogendini</para>
  <para style="q2" vid="LAM 1:3">kendo oonge kar yweyo.</para>
  <para style="q1" vid="LAM 1:3">Jogo duto malawe osemake kapod en</para>
  <para style="q2" vid="LAM 1:3">e chandruok malich.<verse eid="LAM 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4"/>Yore madhiyo Sayun ywagore,</para>
  <para style="q2" vid="LAM 1:4">nimar onge ngʼato mabiro e nyasi mag sewni moyier.</para>
  <para style="q1" vid="LAM 1:4">Dhorangeye duto odongʼ nono maonge ji,</para>
  <para style="q2" vid="LAM 1:4">jodologe ywak ka chur,</para>
  <para style="q1" vid="LAM 1:4">jotichge ma nyiri okuyo,</para>
  <para style="q2" vid="LAM 1:4">to en owuon en gi lit malich.<verse eid="LAM 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5"/>Wasike ema tinde otelone,</para>
  <para style="q2" vid="LAM 1:5">kendo wasikego dhi maber.</para>
  <para style="q1" vid="LAM 1:5">Jehova Nyasaye osekelone chandruok</para>
  <para style="q2" vid="LAM 1:5">nikech richone mangʼeny.</para>
  <para style="q1" vid="LAM 1:5">Nyithinde oseter e twech, kendo gisebedo kaka joma omaki</para>
  <para style="q2" vid="LAM 1:5">e nyim wasigu.<verse eid="LAM 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6"/>Duongʼ mar loch duto mane nyar Sayun nigo</para>
  <para style="q2" vid="LAM 1:6">oserumo.</para>
  <para style="q1" vid="LAM 1:6">Jodonge chalo gi mwanda modenyo</para>
  <para style="q2" vid="LAM 1:6">ma ok yud lum machamo,</para>
  <para style="q1" vid="LAM 1:6">giringo ka gionge</para>
  <para style="q2" vid="LAM 1:6">gi teko e nyim joma lawogi.<verse eid="LAM 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7"/>E ndalo mane Jerusalem ni e chandruok kod chuny lit,</para>
  <para style="q2" vid="LAM 1:7">noparo mwandune duto mane en-go e ndalo machon.</para>
  <para style="q1" vid="LAM 1:7">Wasike nojare</para>
  <para style="q2" vid="LAM 1:7">kendo onyiero kuom thagruok mage.<verse eid="LAM 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8"/>Jerusalem osetimo richo madongo</para>
  <para style="q2" vid="LAM 1:8">omiyo koro osebedo mochido.</para>
  <para style="q1" vid="LAM 1:8">Ji duto mane omiye luor koro ochaye,</para>
  <para style="q2" vid="LAM 1:8">nimar giseneno duge;</para>
  <para style="q1" vid="LAM 1:8">kendo koro oywak kochur</para>
  <para style="q2" vid="LAM 1:8">nikech wiye kuot.<verse eid="LAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9"/>Chilo ma en-go omienore e lepe,</para>
  <para style="q2" vid="LAM 1:9">ne ok odewo gima biro timorene bangʼe.</para>
  <para style="q1" vid="LAM 1:9">Nopodho malich miwuoro,</para>
  <para style="q2" vid="LAM 1:9">to onge ngʼama ne nyalo hoye.</para>
  <para style="q1" vid="LAM 1:9">Yaye Jehova Nyasaye, neye chandruok ma an-go,</para>
  <para style="q2" vid="LAM 1:9">nimar wasigu oseloyo.<verse eid="LAM 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10"/>Wasigu oseyako</para>
  <para style="q2" vid="LAM 1:10">mwandune duto;</para>
  <para style="q1" vid="LAM 1:10">oseneno ogendini ma jopiny</para>
  <para style="q2" vid="LAM 1:10">ka donjoe kare maler mar lemo,</para>
  <para style="q1" vid="LAM 1:10">jogo misekwero ni kik donji</para>
  <para style="q2" vid="LAM 1:10">e kari maler mar lemo.<verse eid="LAM 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11"/>Joge duto chur kaywagore</para>
  <para style="q2" vid="LAM 1:11">ka gimanyo chiemo;</para>
  <para style="q1" vid="LAM 1:11">giloko mwandugi</para>
  <para style="q2" vid="LAM 1:11">mondo giyud chiemo,</para>
  <para style="q2" vid="LAM 1:11">mondo gibed mangima.</para>
  <para style="q1" vid="LAM 1:11">“Yaye Jehova Nyasaye, neye kendo iparae,</para>
  <para style="q2" vid="LAM 1:11">nimar ji ochaya.”<verse eid="LAM 1:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12"/>Un ji duto makadho, onge lich muneno kuom gima timorenani?</para>
  <para style="q2" vid="LAM 1:12">Lokreuru anena mondo unee,</para>
  <para style="q1" vid="LAM 1:12">ka bende nitiere masira machielo</para>
  <para style="q2" vid="LAM 1:12">machalo gi masira moyudani,</para>
  <para style="q1" vid="LAM 1:12">ma Jehova Nyasaye oseketo kuoma</para>
  <para style="q2" vid="LAM 1:12">e odiechiengʼ mar mirimbe mager?<verse eid="LAM 1:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13"/>Ne ooro mach koa e polo,</para>
  <para style="q2" vid="LAM 1:13">modonjo e chokena.</para>
  <para style="q1" vid="LAM 1:13">Nochiko obadho momako tiendena</para>
  <para style="q2" vid="LAM 1:13">kendo nodwoka chien.</para>
  <para style="q1" vid="LAM 1:13">Nomiya abedo modhier kadongʼ kenda</para>
  <para style="q2" vid="LAM 1:13">ka aol maonge teko odiechiengʼ duto.<verse eid="LAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14"/>Richona osetwe e ngʼuta ka jok;</para>
  <para style="q2" vid="LAM 1:14">adier osetweyogi gi lwete owuon.</para>
  <para style="q1" vid="LAM 1:14">Oseketgi e ngʼuta</para>
  <para style="q2" vid="LAM 1:14">kendo Ruoth Nyasaye osetieko tekra,</para>
  <para style="q1" vid="LAM 1:14">bende osejwangʼa</para>
  <para style="q2" vid="LAM 1:14">e lwet joma ok anyal loyo.<verse eid="LAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15"/>“Ruoth Nyasaye</para>
  <para style="q2" vid="LAM 1:15">osekwedo jolweny maga duto;</para>
  <para style="q1" vid="LAM 1:15">osechoko jolweny</para>
  <para style="q2" vid="LAM 1:15">mondo omonja,</para>
  <para style="q1" vid="LAM 1:15">kendo otiek yawuota ma jolweny.</para>
  <para style="q1" vid="LAM 1:15">Ruoth Nyasaye osekumo nyar Juda mapok ongʼeyo chwo</para>
  <para style="q2" vid="LAM 1:15">e kare mar biyo olemb mzabibu.<verse eid="LAM 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16"/>“Ma emomiyo aywak</para>
  <para style="q2" vid="LAM 1:16">kendo pi wangʼa mol e lemba.</para>
  <para style="q1" vid="LAM 1:16">Onge ngʼat machiegni koda ma dihoya,</para>
  <para style="q2" vid="LAM 1:16">bende onge ngʼat ma dikwe chunya.</para>
  <para style="q1" vid="LAM 1:16">Nyithinda odongʼ kiye</para>
  <para style="q2" vid="LAM 1:16">nikech wasigu oselocho.”<verse eid="LAM 1:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17"/>Sayun tingʼo bedene malo kaywak,</para>
  <para style="q2" vid="LAM 1:17">to onge ngʼama nyalo hoye.</para>
  <para style="q1" vid="LAM 1:17">Jehova Nyasaye oseketo chik ni Jakobo,</para>
  <para style="q2" vid="LAM 1:17">ni jogo modak bute,</para>
  <para style="q2" vid="LAM 1:17">mondo obed wasike;</para>
  <para style="q1" vid="LAM 1:17">Jerusalem osebedo gima ochido</para>
  <para style="q2" vid="LAM 1:17">e diergi.<verse eid="LAM 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18"/>Jehova Nyasaye en Nyasaye makare,</para>
  <para style="q2" vid="LAM 1:18">to kata kamano ne angʼanyo ne chikene.</para>
  <para style="q1" vid="LAM 1:18">Winjuru, un ji duto;</para>
  <para style="q2" vid="LAM 1:18">kendo neeuru kaka achandora.</para>
  <para style="q1" vid="LAM 1:18">Yawuota gi nyiga osemaki</para>
  <para style="q2" vid="LAM 1:18">moter e twech.<verse eid="LAM 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19"/>Ne aluongo osiepena,</para>
  <para style="q2" vid="LAM 1:19">to ne gindhoga.</para>
  <para style="q1" vid="LAM 1:19">Jodolo maga gi jodonga</para>
  <para style="q2" vid="LAM 1:19">notho e dala maduongʼ,</para>
  <para style="q1" vid="LAM 1:19">kane gimanyo chiemo</para>
  <para style="q2" vid="LAM 1:19">mondo gibed mangima.<verse eid="LAM 1:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20"/>Yaye Jehova Nyasaye, nee kaka anie chandruok malich!</para>
  <para style="q2" vid="LAM 1:20">Iya nyawni,</para>
  <para style="q1" vid="LAM 1:20">kendo chunya chandore malich,</para>
  <para style="q2" vid="LAM 1:20">nikech ok aseluoro chikeni.</para>
  <para style="q1" vid="LAM 1:20">Lweny nego ji oko mar dala</para>
  <para style="q2" vid="LAM 1:20">to ei dala bende tho nekoe.<verse eid="LAM 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21"/>Ji osewinjo ywakna,</para>
  <para style="q2" vid="LAM 1:21">to onge ngʼama dewa.</para>
  <para style="q1" vid="LAM 1:21">Wasika duto osewinjo chandruokna;</para>
  <para style="q2" vid="LAM 1:21">kendo gimor kuom gik ma isetimona.</para>
  <para style="q1" vid="LAM 1:21">Mad ikel odiechiengʼ mane iselando</para>
  <para style="q2" vid="LAM 1:21">mondo omi gichal koda.<verse eid="LAM 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22"/>We mondo timbegi mamono ochop e nyimi;</para>
  <para style="q2" vid="LAM 1:22">kendo timnegi,</para>
  <para style="q1" vid="LAM 1:22">mana kaka isetimona</para>
  <para style="q2" vid="LAM 1:22">kuom richona duto.</para>
  <para style="q1" vid="LAM 1:22">An gi pek mangʼeny</para>
  <para style="q2" vid="LAM 1:22">kendo chunya onyosore.<verse eid="LAM 1:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 1"/>
  <chapter number="2" style="c" sid="LAM 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1"/>Mano kaka Ruoth Nyasaye osekumo Nyar Sayun</para>
  <para style="q2" vid="LAM 2:1">gi mirimbe motwere ka rumbi!</para>
  <para style="q1" vid="LAM 2:1">Duongʼ mar Israel ma yande otundo nyaka e polo,</para>
  <para style="q2" vid="LAM 2:1">osewito piny,</para>
  <para style="q1" vid="LAM 2:1">bende kuom mirimbe</para>
  <para style="q2" vid="LAM 2:1">ok oseparo ni en raten mar tiende.<verse eid="LAM 2:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2"/>Ruoth Nyasaye oseketho</para>
  <para style="q2" vid="LAM 2:2">mier duto mag Jakobo ka ok odewo;</para>
  <para style="q1" vid="LAM 2:2">nikech mirimbe osemuko</para>
  <para style="q2" vid="LAM 2:2">kuonde mochiel motegno mag Nyar Juda.</para>
  <para style="q1" vid="LAM 2:2">Nokuodo wi jopinyno gi jotende</para>
  <para style="q2" vid="LAM 2:2">mi odwoko lochgi chien.<verse eid="LAM 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3"/>Osetieko teko mar jo-Israel</para>
  <para style="q2" vid="LAM 2:3">gi mirimbe mager,</para>
  <para style="q1" vid="LAM 2:3">kendo osejwangʼogi</para>
  <para style="q2" vid="LAM 2:3">e lwet wasikgi.</para>
  <para style="q1" vid="LAM 2:3">Osewengʼo ka Jakobo kaka mach mager makakni</para>
  <para style="q2" vid="LAM 2:3">ma wangʼo gik moko duto molwore.<verse eid="LAM 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4"/>Oseywayo atungʼe mar kedo</para>
  <para style="q2" vid="LAM 2:4">gi joge mana ka gima gin wasike.</para>
  <para style="q1" vid="LAM 2:4">Kaka jasigu neko,</para>
  <para style="q2" vid="LAM 2:4">osenego jogo duto mane nenore mabeyo e wangʼ,</para>
  <para style="q1" vid="LAM 2:4">kendo oseolo mirimbe oko</para>
  <para style="q2" vid="LAM 2:4">ka mach kuom hemb Nyar Sayun.<verse eid="LAM 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5"/>Ruoth Nyasaye chalo gi jasigu;</para>
  <para style="q2" vid="LAM 2:5">kendo osetieko Israel!</para>
  <para style="q1" vid="LAM 2:5">Osemuko ute Israel duto mag ruoth</para>
  <para style="q2" vid="LAM 2:5">kendo oseketho mieche mochiel motegno.</para>
  <para style="q1" vid="LAM 2:5">Osemedo ywagruok</para>
  <para style="q2" vid="LAM 2:5">kod kuyo ne Nyar Juda.<verse eid="LAM 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6"/>Oseketho kare mar dak mana ka puodho moketh chambe modongʼ nono,</para>
  <para style="q2" vid="LAM 2:6">kendo osemuko kare mar romo.</para>
  <para style="q1" vid="LAM 2:6">Jehova Nyasaye osemiyo Sayun wiye owil</para>
  <para style="q2" vid="LAM 2:6">kod sewni moyier gi Sabatoge;</para>
  <para style="q1" vid="LAM 2:6">kendo kuom mirimbe mager,</para>
  <para style="q2" vid="LAM 2:6">osejwangʼo ruoth kaachiel gi jadolo.<verse eid="LAM 2:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7"/>Ruoth Nyasaye osedagi kendone mar misango</para>
  <para style="q2" vid="LAM 2:7">kendo jwangʼo kare maler mar lemo.</para>
  <para style="q1" vid="LAM 2:7">Osechiwo ohinga mag kuonde mag dak</para>
  <para style="q2" vid="LAM 2:7">e lwet wasigu;</para>
  <para style="q1" vid="LAM 2:7">gisegoyo koko e od Jehova Nyasaye</para>
  <para style="q2" vid="LAM 2:7">mana kaka ne itimo e odiechiengʼ mar sawo moyier.<verse eid="LAM 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8"/>Jehova Nyasaye osechano muko ohinga</para>
  <para style="q2" vid="LAM 2:8">molworo Nyar Sayun.</para>
  <para style="q1" vid="LAM 2:8">Oserieyo rapim kendo ne ok ogengʼo lwete</para>
  <para style="q2" vid="LAM 2:8">mondo kik okethe.</para>
  <para style="q1" vid="LAM 2:8">Nomiyo chiel ma oko mar dala kod ohinga oyiengni,</para>
  <para style="q2" vid="LAM 2:8">giduto kaachiel ne gimukore mi gigore piny.<verse eid="LAM 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9"/>Dhorangeyene osegore piny molal ei lowo,</para>
  <para style="q2" vid="LAM 2:9">oseturo lodi mage kendo kethogi.</para>
  <para style="q1" vid="LAM 2:9">Ruodhe gi jodonge oke e kind ogendini,</para>
  <para style="q2" vid="LAM 2:9">chik onge koro,</para>
  <para style="q1" vid="LAM 2:9">to jonabi mage koro ok yud fweny</para>
  <para style="q2" vid="LAM 2:9">moa kuom Jehova Nyasaye.<verse eid="LAM 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10"/>Jodongo mag nyar Sayun,</para>
  <para style="q2" vid="LAM 2:10">obedo piny kolingʼ thi,</para>
  <para style="q1" vid="LAM 2:10">gisebuko wiyegi gi buru</para>
  <para style="q2" vid="LAM 2:10">kendo girwako piende gugru.</para>
  <para style="q1" vid="LAM 2:10">Nyi Jerusalem</para>
  <para style="q2" vid="LAM 2:10">osekulo wiyegi piny.<verse eid="LAM 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11"/>Wangʼa ojony nikech ywak,</para>
  <para style="q2" vid="LAM 2:11">chunya ool,</para>
  <para style="q1" vid="LAM 2:11">kendo chandore malit</para>
  <para style="q2" vid="LAM 2:11">nikech joga osetieki,</para>
  <para style="q1" vid="LAM 2:11">kendo nyithindo kod nyithindo mayom kech nego</para>
  <para style="q2" vid="LAM 2:11">e yore mag dala maduongʼ.<verse eid="LAM 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12"/>Kech negogi</para>
  <para style="q2" vid="LAM 2:12">e kor minegi,</para>
  <para style="q1" vid="LAM 2:12">ka jogo mohiny e lweny</para>
  <para style="q2" vid="LAM 2:12">e yore mag dala maduongʼ,</para>
  <para style="q1" vid="LAM 2:12">mi gipodhi,</para>
  <para style="q2" vid="LAM 2:12">omiyo gipenjo minegi niya, “Ere chiemo kod divai?”<verse eid="LAM 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13"/>Yaye Nyar Jerusalem, en angʼo madawach kuomi?</para>
  <para style="q2" vid="LAM 2:13">Koso en angʼo ma dapimigo?</para>
  <para style="q2" vid="LAM 2:13">Yaye Nyar Sayun mapok ongʼeyo dichwo,</para>
  <para style="q1" vid="LAM 2:13">en angʼo ma dapimigo,</para>
  <para style="q2" vid="LAM 2:13">koso en angʼo ma dahoyigo?</para>
  <para style="q1" vid="LAM 2:13">Adhola ma in-go tut mana ka nam.</para>
  <para style="q2" vid="LAM 2:13">Ere ngʼama dithiedhnigo?<verse eid="LAM 2:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14"/>Fweny mane jonabi magi oneno</para>
  <para style="q2" vid="LAM 2:14">ne ok adiera, to gin mana miriambo lilo,</para>
  <para style="q1" vid="LAM 2:14">ne ok ginyisi richoni</para>
  <para style="q2" vid="LAM 2:14">mondo omi kik teri e twech.</para>
  <para style="q1" vid="LAM 2:14">To fweny mane ginyisi</para>
  <para style="q2" vid="LAM 2:14">ne gin mana weche mag miriambo kendo ma wito ji.<verse eid="LAM 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15"/>Ji duto makadho buti</para>
  <para style="q2" vid="LAM 2:15">pamo ni lwetegi;</para>
  <para style="q1" vid="LAM 2:15">gijari kendo gikino wigi</para>
  <para style="q2" vid="LAM 2:15">kuom gigo mosetimorene Nyar Jerusalem,</para>
  <para style="q1" vid="LAM 2:15">ka gipenjore niya, “Bende ma e dala maduongʼ</para>
  <para style="q2" vid="LAM 2:15">ma yande ongʼere ni dala maler,</para>
  <para style="q2" vid="LAM 2:15">kendo mor mar piny mangima?”<verse eid="LAM 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16"/>Wasiki duto</para>
  <para style="q2" vid="LAM 2:16">wuoyo marach kuomi;</para>
  <para style="q1" vid="LAM 2:16">gijari ka gikayo lekegi</para>
  <para style="q2" vid="LAM 2:16">kagiwacho niya, “Wasetieke chuth.</para>
  <para style="q1" vid="LAM 2:16">Ma e ndalo mane wasebedo ka warito;</para>
  <para style="q2" vid="LAM 2:16">adier, osechopo ma wanene.”<verse eid="LAM 2:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17"/>Jehova Nyasaye osetimo gima ne osechano;</para>
  <para style="q2" vid="LAM 2:17">osechopo mano mane owacho,</para>
  <para style="q2" vid="LAM 2:17">ma en gima nochiko chon.</para>
  <para style="q1" vid="LAM 2:17">Osetieki ma ok odewo,</para>
  <para style="q2" vid="LAM 2:17">kendo osemiyo wasigu goyoni siboi,</para>
  <para style="q2" vid="LAM 2:17">komedogi teko.<verse eid="LAM 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18"/>Chunje ji ywak</para>
  <para style="q2" vid="LAM 2:18">ni Ruoth Nyasaye.</para>
  <para style="q1" vid="LAM 2:18">Yaye ohinga mar Nyar Sayun,</para>
  <para style="q2" vid="LAM 2:18">we pi wangʼi omol ka aora,</para>
  <para style="q2" vid="LAM 2:18">odiechiengʼ gotieno;</para>
  <para style="q1" vid="LAM 2:18">kik iywe kata matin,</para>
  <para style="q2" vid="LAM 2:18">kendo pi wangʼi kik chogi.<verse eid="LAM 2:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19"/>Aa malo, ywagi otieno duto,</para>
  <para style="q2" vid="LAM 2:19">e kindego mag arita ma otieno chakore,</para>
  <para style="q1" vid="LAM 2:19">kendo weche duto manie chunyi ol oko ka pi</para>
  <para style="q2" vid="LAM 2:19">e nyim Ruoth Nyasaye.</para>
  <para style="q1" vid="LAM 2:19">Tingʼ bedeni malo kilame</para>
  <para style="q2" vid="LAM 2:19">nikech nyithindi,</para>
  <para style="q1" vid="LAM 2:19">ma kech nego</para>
  <para style="q2" vid="LAM 2:19">e wangʼ yore duto.<verse eid="LAM 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20"/>Yaye Jehova Nyasaye winjie wachni:</para>
  <para style="q2" vid="LAM 2:20">En ngʼa misetimone gima lit machal kama?</para>
  <para style="q1" vid="LAM 2:20">Bende mon dicham nyithindgi</para>
  <para style="q2" vid="LAM 2:20">ma giserito maber kama?</para>
  <para style="q1" vid="LAM 2:20">Koso jodolo gi jonabi dinegi</para>
  <para style="q2" vid="LAM 2:20">e kama ler mar lemo mar Ruoth Nyasaye adier?<verse eid="LAM 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21"/>Jomatindo gi jomadongo nindo</para>
  <para style="q2" vid="LAM 2:21">e yore motimo buru;</para>
  <para style="q1" vid="LAM 2:21">yawuota gi nyiga</para>
  <para style="q2" vid="LAM 2:21">oseneg gi ligangla.</para>
  <para style="q1" vid="LAM 2:21">Isenegogi ka in gi mirima</para>
  <para style="q2" vid="LAM 2:21">kendo isetiekogi ka ok idewo.<verse eid="LAM 2:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22"/>Ne iluongo masira koa kuonde duto</para>
  <para style="q2" vid="LAM 2:22">mana ka ji mabiro e nyasi moro maduongʼ.</para>
  <para style="q1" vid="LAM 2:22">E odiechiengʼ mar mirimb Jehova Nyasaye</para>
  <para style="q2" vid="LAM 2:22">onge ngʼato mane otony kata mane odongʼ kangima.</para>
  <para style="q1" vid="LAM 2:22">Kuom joga mane apidho</para>
  <para style="q2" vid="LAM 2:22">kendo arito, wasika osetieko.<verse eid="LAM 2:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 2"/>
  <chapter number="3" style="c" sid="LAM 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1"/>An e ngʼat moseneno masira</para>
  <para style="q2" vid="LAM 3:1">mane ayudo koa e lwet Jehova Nyasaye.<verse eid="LAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2"/>Oseriemba mabor kendo miyo awuotho</para>
  <para style="q2" vid="LAM 3:2">e mudho kar wuotho e ler;<verse eid="LAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3"/>chutho osekuma</para>
  <para style="q2" vid="LAM 3:3">kinde ka kinde ndalo duto.<verse eid="LAM 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4"/>Osemiyo denda odoko mool</para>
  <para style="q2" vid="LAM 3:4">kendo chokena osetur.<verse eid="LAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5"/>Osegoyona agengʼa kendo lwora</para>
  <para style="q2" vid="LAM 3:5">komiya abedo gi chuny malit kod olo.<verse eid="LAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6"/>Osemiyo adak ei mudho</para>
  <para style="q2" vid="LAM 3:6">kaka jogo mane osetho chon.<verse eid="LAM 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7"/>Osechiela gi ohinga ma ok anyal ringo madhi;</para>
  <para style="q2" vid="LAM 3:7">kendo oseketa piny kotweya gi nyororo.<verse eid="LAM 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8"/>Kata ka aluongo kata kaywak ka dwaro kony,</para>
  <para style="q2" vid="LAM 3:8">to ogengʼo lamona.<verse eid="LAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9"/>Osedino yora gohinga moger gi kidi;</para>
  <para style="q2" vid="LAM 3:9">omiyo awuotho e yore mobam.<verse eid="LAM 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10"/>Mana kaka ondieg bungu mobuto karito,</para>
  <para style="q2" vid="LAM 3:10">kata ka sibuor mopondo,<verse eid="LAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11"/>e kaka noywaya oko e yo mokidha</para>
  <para style="q2" vid="LAM 3:11">kendo oweya maonge kaka dakonyra.<verse eid="LAM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12"/>Noywayo atungʼe</para>
  <para style="q2" vid="LAM 3:12">kendo oketa thoro mar aserni mage.<verse eid="LAM 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13"/>Nochwoyo chunya gi aserene</para>
  <para style="q2" vid="LAM 3:13">mowuodho e olalo mare.<verse eid="LAM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14"/>Nabedo ngʼat ma ji duto nyiero,</para>
  <para style="q2" vid="LAM 3:14">ne gijara gi wer pile ka pile.<verse eid="LAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15"/>Osepongʼo chunya</para>
  <para style="q2" vid="LAM 3:15">gi gik makech kod olo.<verse eid="LAM 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16"/>Oseturo lekena gi kite mimuodo</para>
  <para style="q2" vid="LAM 3:16">kendo osenyona piny e buru.<verse eid="LAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17"/>Osemaya kwe;</para>
  <para style="q2" vid="LAM 3:17">kendo wiya osewil kod mor ma yande an godo.<verse eid="LAM 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18"/>Emomiyo awacho niya, “Chia mara oserumo</para>
  <para style="q2" vid="LAM 3:18">kod gigo mane ageno kuom Jehova Nyasaye.”<verse eid="LAM 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19"/>Aparo chandruokna, wuodhena ma ok nikare,</para>
  <para style="q2" vid="LAM 3:19">kaachiel gi lit gi kuyo.<verse eid="LAM 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20"/>Aparogi maber,</para>
  <para style="q2" vid="LAM 3:20">kendo an kod kuyo e chunya.<verse eid="LAM 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21"/>To gima bende aparo</para>
  <para style="q2" vid="LAM 3:21">mamiyo abedo gi geno ema:<verse eid="LAM 3:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22"/>Nikech hera maduongʼ mar Jehova Nyasaye osiko mochwere,</para>
  <para style="q2" vid="LAM 3:22">kendo ngʼwonone ok rum omiyo ok otiekwa.<verse eid="LAM 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23"/>Herani gi ngʼwononi nyien okinyi kokinyi,</para>
  <para style="q2" vid="LAM 3:23">kendo adiera mari duongʼ.<verse eid="LAM 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24"/>Abiro wacho kenda niya, “Jehova Nyasaye e pokna,</para>
  <para style="q2" vid="LAM 3:24">omiyo abiro geno kuome.”<verse eid="LAM 3:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25"/>Jehova Nyasaye ber ne jogo ma genogi ni kuome,</para>
  <para style="q2" vid="LAM 3:25">kendo ne ngʼatno madware,<verse eid="LAM 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26"/>en gima ber</para>
  <para style="q2" vid="LAM 3:26">rito warruok mar Jehova Nyasaye.<verse eid="LAM 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27"/>Ber mondo ngʼato otingʼ jok</para>
  <para style="q2" vid="LAM 3:27">kapod en ngʼama tin.<verse eid="LAM 3:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28"/>We obed kar kende owuon kolingʼ,</para>
  <para style="q2" vid="LAM 3:28">nimar Jehova Nyasaye osetweyone jokno.<verse eid="LAM 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29"/>We oik wiye ei buru,</para>
  <para style="q2" vid="LAM 3:29">dipoka pod en gi geno.<verse eid="LAM 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30"/>We ochiw lembe ne ngʼatno ma digoye</para>
  <para style="q2" vid="LAM 3:30">kendo oyie bedo ngʼat ma ji jaro,<verse eid="LAM 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31"/>nikech Ruoth Nyasaye ok nyal jwangʼo ngʼato</para>
  <para style="q2" vid="LAM 3:31">nyaka chiengʼ.<verse eid="LAM 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32"/>Kata obedo ni okelo kuyo, to obiro nyiso ngʼwono,</para>
  <para style="q2" vid="LAM 3:32">nikech herane ma ok rum duongʼ ahinya,<verse eid="LAM 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33"/>nimar Nyasaye ok kel chandruok goyiem,</para>
  <para style="q2" vid="LAM 3:33">kata mana kuyo ni nyithind ji.<verse eid="LAM 3:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34"/>Donge Jehova Nyasaye neno kisando ji duto</para>
  <para style="q2" vid="LAM 3:34">manie twech,<verse eid="LAM 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35"/>kata kitamo ngʼato e ratiro mare</para>
  <para style="q2" vid="LAM 3:35">e nyim Nyasaye Man Malo Moloyo,<verse eid="LAM 3:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36"/>kata ka iketho buch ngʼato,</para>
  <para style="q2" vid="LAM 3:36">donge Ruoth Nyasaye neno gik ma kamago?<verse eid="LAM 3:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37"/>En ngʼa manyalo wuoyo kendo miyo gimoro timre</para>
  <para style="q2" vid="LAM 3:37">ka ok en Ruoth Nyasaye ema owacho?<verse eid="LAM 3:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38"/>Donge masiche kod ber wuok mana</para>
  <para style="q2" vid="LAM 3:38">koa kuom Nyasaye Man Malo Moloyo?<verse eid="LAM 3:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39"/>Ere gima omiyo ngʼato angʼata mangima ngʼur</para>
  <para style="q2" vid="LAM 3:39">ka okume nikech richoge?<verse eid="LAM 3:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40"/>Weuru wanon timbewa kendo wapar ane kaka gichalo,</para>
  <para style="q2" vid="LAM 3:40">eka wadog ir Jehova Nyasaye.<verse eid="LAM 3:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41"/>Wachiwuru chunywa kendo watingʼ bedewa malo</para>
  <para style="q2" vid="LAM 3:41">e nyim Nyasaye manie polo, kawawacho niya,<verse eid="LAM 3:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42"/>Wasetimo richo kendo ngʼanyo,</para>
  <para style="q2" vid="LAM 3:42">to ok iseweyonwa.<verse eid="LAM 3:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43"/>Iselawowa ka in gi mirima;</para>
  <para style="q2" vid="LAM 3:43">mi inegowa ka ok idewo.<verse eid="LAM 3:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44"/>Iseumori gi boche polo</para>
  <para style="q2" vid="LAM 3:44">mondo lemo moro amora kik chop iri.<verse eid="LAM 3:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45"/>Isemiyo wabedo ka yugi</para>
  <para style="q2" vid="LAM 3:45">kendo ka owuoyo e kind ogendini.<verse eid="LAM 3:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46"/>“Wasikwa duto</para>
  <para style="q2" vid="LAM 3:46">wuoyo kuomwa marach gi ajara.<verse eid="LAM 3:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47"/>Luoro gi obadho ritowa</para>
  <para style="q2" vid="LAM 3:47">kendo kethruok gi masira ochomowa.”<verse eid="LAM 3:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48"/>Pi wangʼa mol ka aora</para>
  <para style="q2" vid="LAM 3:48">nikech joga osenegi.<verse eid="LAM 3:48"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49"/>Pi wangʼa biro chwer ma ok chogi,</para>
  <para style="q2" vid="LAM 3:49">maonge ngʼama konyo,<verse eid="LAM 3:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50"/>nyaka chop Jehova Nyasaye nokul wangʼe piny</para>
  <para style="q2" vid="LAM 3:50">ma onena gie polo.<verse eid="LAM 3:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51"/>Gima aneno miyo chunya kuyo</para>
  <para style="q2" vid="LAM 3:51">nikech gik matimore ne mon duto mar dalawa maduongʼ.<verse eid="LAM 3:51"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52"/>Jogo mane wasika kayiem nono</para>
  <para style="q2" vid="LAM 3:52">nomanya ka winyo.<verse eid="LAM 3:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53"/>Negitemo mondo gitiek ngimana ka giluta ei bur;</para>
  <para style="q2" vid="LAM 3:53">kendo negibaya gi kite;<verse eid="LAM 3:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54"/>pi noima mine aparo</para>
  <para style="q2" vid="LAM 3:54">ni achiegni tho.<verse eid="LAM 3:54"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55"/>Naluongo nyingi, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="LAM 3:55">ka an ei bur matut.<verse eid="LAM 3:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56"/>Kane akwayi ni mondo ikonya</para>
  <para style="q2" vid="LAM 3:56">to ne iwinjo ywakna.<verse eid="LAM 3:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57"/>Nibiro machiegni kane aluongi</para>
  <para style="q2" vid="LAM 3:57">kendo ne iwachona niya, “Kik iluor ngangʼ.”<verse eid="LAM 3:57"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58"/>Yaye Ruoth Nyasaye ne itingʼo tingʼna,</para>
  <para style="q2" vid="LAM 3:58">kendo ne ireso ngimana.<verse eid="LAM 3:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59"/>Yaye Jehova Nyasaye, iseneno, rach mosetimna,</para>
  <para style="q2" vid="LAM 3:59">ngʼad bucha kare!<verse eid="LAM 3:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60"/>Iseneno kaka ne gichulona kuor,</para>
  <para style="q2" vid="LAM 3:60">kod timbe mamono mane gichano timona.<verse eid="LAM 3:60"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61"/>Yaye Jehova Nyasaye, isewinjo ayany mag-gi,</para>
  <para style="q2" vid="LAM 3:61">kaachiel gi timbe mamono ma gichano timona,<verse eid="LAM 3:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62"/>ma gin gigo ma joma wasika wacho kuoma</para>
  <para style="q2" vid="LAM 3:62">kendo kuodhago lingʼ-lingʼ odiechiengʼ duto.<verse eid="LAM 3:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63"/>Koro negie nikech kata gibedo piny kata chungo to nyinga</para>
  <para style="q2" vid="LAM 3:63">ema giwuoyoe kokalo kuom wendegi.<verse eid="LAM 3:63"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64"/>Yaye Jehova Nyasaye, migi kum moromo gi timbegi kaluwore</para>
  <para style="q2" vid="LAM 3:64">gi gik ma lwetgi osetimo.<verse eid="LAM 3:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65"/>Mi gibed gi chuny matek</para>
  <para style="q2" vid="LAM 3:65">kendo mad kwongʼ mari obed kuomgi.<verse eid="LAM 3:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66"/>Yaye Jehova Nyasaye, mad ilawgi gi mirima,</para>
  <para style="q2" vid="LAM 3:66">kendo itiekgi gia e piny mane ichweyo.<verse eid="LAM 3:66"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 3"/>
  <chapter number="4" style="c" sid="LAM 4"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1"/>Mano kaka dhahabu osewito berne,</para>
  <para style="q2" vid="LAM 4:1">dhahabu maberie moloyo obedo marach!</para>
  <para style="q1" vid="LAM 4:1">Kite maler okere</para>
  <para style="q2" vid="LAM 4:1">e akerkeke mag yore duto.<verse eid="LAM 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2"/>Mano kaka yawuot Sayun mabeyo,</para>
  <para style="q2" vid="LAM 4:2">ma yande bergi ne romre gi pek mar dhahabu,</para>
  <para style="q1" vid="LAM 4:2">tinde ipimo mana gi agulni mag lowo,</para>
  <para style="q2" vid="LAM 4:2">ma en tich lwedo mar jachwe aguch lowo!<verse eid="LAM 4:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3"/>Kata mana ondiegi chiwo thundegi</para>
  <para style="q2" vid="LAM 4:3">mondo nyithindgi odhodhi,</para>
  <para style="q1" vid="LAM 4:3">to joga osebedo jogo maonge chuny,</para>
  <para style="q2" vid="LAM 4:3">gichalo udo manie thim.<verse eid="LAM 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4"/>Nikech riyo oloyo nyathi madhoth</para>
  <para style="q2" vid="LAM 4:4">mi koro lewe omoko e dande;</para>
  <para style="q1" vid="LAM 4:4">kendo nyithindo kwayo chiemo,</para>
  <para style="q2" vid="LAM 4:4">to onge ngʼama migi.<verse eid="LAM 4:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5"/>Joma yande chamo chiemo mamit,</para>
  <para style="q2" vid="LAM 4:5">koro gin jokwecho mojwangʼ e wangʼ yore;</para>
  <para style="q1" vid="LAM 4:5">to jogo ma yande odak e ngima maber</para>
  <para style="q2" vid="LAM 4:5">koro nindo e pidh yugi.<verse eid="LAM 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6"/>Kum mar joga</para>
  <para style="q2" vid="LAM 4:6">duongʼ moloyo mano mar Sodom,</para>
  <para style="q1" vid="LAM 4:6">mane lochne okethi mapiyo piyo nono</para>
  <para style="q2" vid="LAM 4:6">maonge ngʼama nobiro mondo okonye.<verse eid="LAM 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7"/>Jotendgi ne ler marieny moloyo pe</para>
  <para style="q2" vid="LAM 4:7">kendo rachar maloyo chak,</para>
  <para style="q1" vid="LAM 4:7">dendgi ne pichni moloyo mo;</para>
  <para style="q2" vid="LAM 4:7">kendo nenruok margi ne chalo gi kidi ma nengone tek.<verse eid="LAM 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8"/>To koro gin rotenge moloyo oyare</para>
  <para style="q2" vid="LAM 4:8">ma kata irom kodgi e wangʼ yore to ok nyal ngʼegi,</para>
  <para style="q1" vid="LAM 4:8">nimar pien ringregi osejowore kuom chokegi;</para>
  <para style="q2" vid="LAM 4:8">kendo osebedo motwo ka yien.<verse eid="LAM 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9"/>Joma notho e lweny ber moloyo</para>
  <para style="q2" vid="LAM 4:9">jogo ma kech onego;</para>
  <para style="q1" vid="LAM 4:9">kech chamogi ma gidhero</para>
  <para style="q2" vid="LAM 4:9">nikech cham onge e puothe.<verse eid="LAM 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10"/>Mon madhoth</para>
  <para style="q2" vid="LAM 4:10">notedo nyithindgi giwegi,</para>
  <para style="q1" vid="LAM 4:10">mobedo chiembgi</para>
  <para style="q2" vid="LAM 4:10">ka joga ne inego itieko.<verse eid="LAM 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11"/>Jehova Nyasaye oseolo mirimbe mangʼeny</para>
  <para style="q2" vid="LAM 4:11">ka iye owangʼ.</para>
  <para style="q1" vid="LAM 4:11">Osemoko mach Sayun</para>
  <para style="q2" vid="LAM 4:11">moketho mise mage.<verse eid="LAM 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12"/>Ruodhi mag piny ne ok oyie,</para>
  <para style="q2" vid="LAM 4:12">kata ji mag piny bende ne ok oyie,</para>
  <para style="q1" vid="LAM 4:12">ni wasigu kod jolweny nyalo donjo</para>
  <para style="q2" vid="LAM 4:12">e dhorangeye mag Jerusalem.<verse eid="LAM 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13"/>To mano notimore</para>
  <para style="q2" vid="LAM 4:13">nikech richo mag jonabi mage,</para>
  <para style="q1" vid="LAM 4:13">kod kethruok mag jodolo mage</para>
  <para style="q2" vid="LAM 4:13">mane ochwero remb joma kare.<verse eid="LAM 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14"/>Koro gidigni e wangʼ yore</para>
  <para style="q2" vid="LAM 4:14">ka joma muofni.</para>
  <para style="q1" vid="LAM 4:14">Gidwanyore gi remo</para>
  <para style="q2" vid="LAM 4:14">maonge ngʼato madihedhre mulo lepgi.<verse eid="LAM 4:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15"/>Ji ywak kagoyonegi koko niya,</para>
  <para style="q2" vid="LAM 4:15">“Dhiuru kucha! Ok uler!”</para>
  <para style="q1" vid="LAM 4:15">Mabor kucha, mabor kucha!</para>
  <para style="q2" vid="LAM 4:15">Kik umulwa!</para>
  <para style="q1" vid="LAM 4:15">Ka giringo giaa kendo gibayo abaya,</para>
  <para style="q2" vid="LAM 4:15">ji mag ogendini wacho ni,</para>
  <para style="q2" vid="LAM 4:15">“Ok ginyal dak kodwa kendo.”<verse eid="LAM 4:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16"/>Jehova Nyasaye owuon osekeyogi e pinje;</para>
  <para style="q2" vid="LAM 4:16">kendo koro ok odewgi.</para>
  <para style="q1" vid="LAM 4:16">Jodolo ok yud duongʼ,</para>
  <para style="q2" vid="LAM 4:16">kendo jodongo ok mi luor.<verse eid="LAM 4:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17"/>Kata kamano, wengewa nojony,</para>
  <para style="q2" vid="LAM 4:17">ka warango gima dikonywa;</para>
  <para style="q1" vid="LAM 4:17">to oganda mane wageno kuome ni nyalo konyowa</para>
  <para style="q2" vid="LAM 4:17">ne ok nyal konyowa.<verse eid="LAM 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18"/>Ji ne manyowa kamoro amora mawaluwo,</para>
  <para style="q2" vid="LAM 4:18">omiyo ne ok wanyal wuotho e wangʼ yorewa.</para>
  <para style="q1" vid="LAM 4:18">Luoro nomakowa nikech ndalowa nosechopo machiegni</para>
  <para style="q2" vid="LAM 4:18">kendo thowa ne osekayo.<verse eid="LAM 4:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19"/>Jogo mane lawowa ne ringo mapiyo</para>
  <para style="q2" vid="LAM 4:19">maloyo ongo mafuyo e kor polo;</para>
  <para style="q1" vid="LAM 4:19">negilawowa e kor gode madongo</para>
  <para style="q2" vid="LAM 4:19">kendo negibutonwa e thim.<verse eid="LAM 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20"/>Ngʼatno mowir mar Jehova Nyasaye,</para>
  <para style="q2" vid="LAM 4:20">mane wakwano kaka ngimawa,</para>
  <para style="q2" vid="LAM 4:20">nomaki e obadho mane gichiko.</para>
  <para style="q1" vid="LAM 4:20">Ne waparo ni e bwo tipone</para>
  <para style="q2" vid="LAM 4:20">wanyalo bedo mangima e dier ogendini.<verse eid="LAM 4:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21"/>Moruru kendo beduru moil, yaye Nyar Edom,</para>
  <para style="q2" vid="LAM 4:21">un jogo modak e piny Uz.</para>
  <para style="q1" vid="LAM 4:21">To un bende, kikombeno ibiro miyou;</para>
  <para style="q2" vid="LAM 4:21">kendo ubiro mer mi udongʼ duge.<verse eid="LAM 4:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22"/>Yaye jo-Sayun, kum mane okumugo biro rumo;</para>
  <para style="q2" vid="LAM 4:22">bende ok nochak omed ndalou mar twech.</para>
  <para style="q1" vid="LAM 4:22">To un jo-Edom, obiro kumou nikech richou</para>
  <para style="q2" vid="LAM 4:22">kendo timbeu mamono obiro elo e lela.<verse eid="LAM 4:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 4"/>
  <chapter number="5" style="c" sid="LAM 5"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1"/>Yaye Jehova Nyasaye, parie gima osetimorenwa;</para>
  <para style="q2" vid="LAM 5:1">rangwa mondo ineye wichkuot ma wan-go.<verse eid="LAM 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2"/>Girkeni mawa osemi jopinje mamoko,</para>
  <para style="q2" vid="LAM 5:2">to miechwa to osekaw gi ji ma welo.<verse eid="LAM 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3"/>Wasedongʼ kiye,</para>
  <para style="q2" vid="LAM 5:3">to minewa chalo mon ma chwogi otho.<verse eid="LAM 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4"/>Nyaka wangʼiew pi mawamodho;</para>
  <para style="q2" vid="LAM 5:4">yiendwa ma wachwako nyaka wachul nengo eka wayudgi.<verse eid="LAM 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5"/>Jogo malawowa nikodwa machiegni;</para>
  <para style="q2" vid="LAM 5:5">waol kendo waonge yweyo.<verse eid="LAM 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6"/>Ne wachiwore ni Misri kod Asuria</para>
  <para style="q2" vid="LAM 5:6">mondo wayud chiemo moromo.<verse eid="LAM 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7"/>Kwerewa notimo richo, to koro gionge,</para>
  <para style="q2" vid="LAM 5:7">to wan ema ikumowa kargi.<verse eid="LAM 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8"/>Wasumbini ema tinde otelonwa,</para>
  <para style="q2" vid="LAM 5:8">kendo onge ngʼama resowa e lwetgi.<verse eid="LAM 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9"/>Wayudo chiembwa e yo matek manyalo hinyo ngimawa</para>
  <para style="q2" vid="LAM 5:9">nikech lweny manie thim.<verse eid="LAM 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10"/>Dendwa owre mana ka mach</para>
  <para style="q2" vid="LAM 5:10">nikech tuo ma kech kelonwa.<verse eid="LAM 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11"/>Mon osemak githuon e Sayun,</para>
  <para style="q2" vid="LAM 5:11">to nyiri e miech Juda.<verse eid="LAM 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12"/>Jodong gwengʼ oselier gi lwetegi e yien,</para>
  <para style="q2" vid="LAM 5:12">to jomadongo ok osemi luor.<verse eid="LAM 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13"/>Jomatindo tiyo matek kuonde mag rego,</para>
  <para style="q2" vid="LAM 5:13">to yawuowi chandore ka gitingʼo yien mapek.<verse eid="LAM 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14"/>Jodongo onge e dhoranga dala maduongʼ;</para>
  <para style="q2" vid="LAM 5:14">kendo jomatindo oseweyo wero wendegi.<verse eid="LAM 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15"/>Mor oserumo e chunywa;</para>
  <para style="q2" vid="LAM 5:15">miendwa oselokore ywak.<verse eid="LAM 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16"/>Osimbo mar duongʼ oselwar oa e wiwa.</para>
  <para style="q2" vid="LAM 5:16">Yaye, masira omakowa, nikech wasetimo richo.<verse eid="LAM 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17"/>Nikech gik ma osetimorenwagi,</para>
  <para style="q2" vid="LAM 5:17">chunywa ool kendo wengewa osejony,<verse eid="LAM 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18"/>nimar got Sayun, osejwangʼ modongʼ gunda</para>
  <para style="q2" vid="LAM 5:18">ma ondiegi ema kwayoe.<verse eid="LAM 5:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19"/>Yaye Jehova Nyasaye, lochni osiko manyaka chiengʼ</para>
  <para style="q2" vid="LAM 5:19">kendo ochwere e tiengʼ ka tiengʼ.<verse eid="LAM 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20"/>Ere gima omiyo wiyi wil kodwa kinde duto?</para>
  <para style="q2" vid="LAM 5:20">Ere gima omiyo ijwangʼowa kuom kinde malach kamano?<verse eid="LAM 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21"/>Yaye Jehova Nyasaye, dwogwa iri;</para>
  <para style="q2" vid="LAM 5:21">kendo ndalowa obed manyien kaka ne wan chon.<verse eid="LAM 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22"/>Ka ok itimonwa kamano, to nyiso ni isedagiwa</para>
  <para style="q2" vid="LAM 5:22">kendo in gi mirima kodwa ma ok nyal pim.<verse eid="LAM 5:22"/></para>
  <chapter eid="LAM 5"/>
</usx>
