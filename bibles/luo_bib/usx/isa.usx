<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ISA" style="id">- Biblica® Open New Luo Translation 2020</book>
  <para style="h">Isaya</para>
  <para style="toc1">Isaya</para>
  <para style="toc2">Isaya</para>
  <para style="toc3">Isa</para>
  <para style="mt1">Isaya</para>
  <chapter number="1" style="c" sid="ISA 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1"/>Fweny ma wuoyo ewi Juda kod Jerusalem mane Isaya wuod Amoz oneno e ndalo loch Uzia gi Jotham gi Ahaz kod Hezekia mane gin ruodhi Juda.<verse eid="ISA 1:1"/></para>
  <para style="b"/>
  <para style="s1">Oganda mongʼanyo</para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 1:2"/>Winji yaye polo! Chik iti, yaye piny!</para>
  <para style="q2" vid="ISA 1:2">Nikech Jehova Nyasaye osewuoyo:</para>
  <para style="q1" vid="ISA 1:2">asepidho nyithindo mobedo madongo,</para>
  <para style="q2" vid="ISA 1:2">to gisepiem koda.<verse eid="ISA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 1:3"/>Rwath ongʼeyo wuon,</para>
  <para style="q2" vid="ISA 1:3">kendo kanyna ongʼeyo kund wuon,</para>
  <para style="q1" vid="ISA 1:3">to jo-Israel ok ongʼeya adier;</para>
  <para style="q2" vid="ISA 1:3">joga awuon onge gi winjo.<verse eid="ISA 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 1:4"/>Yaye oganda ma joricho,</para>
  <para style="q2" vid="ISA 1:4">koth ji mogangore gi timbe mamono,</para>
  <para style="q1" vid="ISA 1:4">kanyakla mar joma timbegi richo,</para>
  <para style="q2" vid="ISA 1:4">nyithindo mochiwore ne timbe acheje!</para>
  <para style="q1" vid="ISA 1:4">Giseweyo Jehova Nyasaye;</para>
  <para style="q1" vid="ISA 1:4">gisejaro Jal Maler mar Israel</para>
  <para style="q2" vid="ISA 1:4">giselokone ngʼegi.<verse eid="ISA 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 1:5"/>Angʼo momiyo pod usiko kudwaro kum?</para>
  <para style="q2" vid="ISA 1:5">Angʼo momiyo usiko kungʼanyo?</para>
  <para style="q1" vid="ISA 1:5">Wiyeu opongʼ gi adhonde</para>
  <para style="q2" vid="ISA 1:5">kendo chunyu opongʼ gi lit.<verse eid="ISA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 1:6"/>Kochakore e tiendu nyaka ewiu</para>
  <para style="q2" vid="ISA 1:6">onge kama ngima,</para>
  <para style="q1" vid="ISA 1:6">kendo upongʼ gi adhonde,</para>
  <para style="q2" vid="ISA 1:6">kuonde moriemo,</para>
  <para style="q1" vid="ISA 1:6">kod kuonde moridhore mapok oketie yath,</para>
  <para style="q2" vid="ISA 1:6">mapok otwe kata wiroe yath.<verse eid="ISA 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 1:7"/>Pinyu odongʼ gunda,</para>
  <para style="q2" vid="ISA 1:7">miechu madongo osewangʼ gi mach;</para>
  <para style="q1" vid="ISA 1:7">puotheu jopinje mamoko osemau</para>
  <para style="q2" vid="ISA 1:7">mana kuneno gi wangʼu,</para>
  <para style="q2" vid="ISA 1:7">ma gidongʼ gundni mana ka joma wasigu oseriembo.<verse eid="ISA 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 1:8"/>Nyar Sayun odongʼ</para>
  <para style="q2" vid="ISA 1:8">ka kiru manie e puoth mzabibu,</para>
  <para style="q1" vid="ISA 1:8">kata ka abila e puoth budho</para>
  <para style="q2" vid="ISA 1:8">kendo ka dala maduongʼ ma wasigu omonjo.<verse eid="ISA 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 1:9"/>Ka dine Jehova Nyasaye Maratego</para>
  <para style="q2" vid="ISA 1:9">ok oweyo jomoko kuomwa otony,</para>
  <para style="q1" vid="ISA 1:9">to dine wachalo gi jo-Sodom,</para>
  <para style="q2" vid="ISA 1:9">adier dikoro ne wachalo kaka jo-Gomora.<verse eid="ISA 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 1:10"/>Winjuru wach Jehova Nyasaye un jotelo mag Sodom,</para>
  <para style="q2" vid="ISA 1:10">chikuru itu ne chike mag Nyasachwa un oganda man Gomora!<verse eid="ISA 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 1:11"/>Jehova Nyasaye wacho kama:</para>
  <para style="q2" vid="ISA 1:11">“Misengini mangʼeny mutimogi amon-go.”</para>
  <para style="q1" vid="ISA 1:11">Aol gi misengini</para>
  <para style="q2" vid="ISA 1:11">miwangʼo pep mag imbe kaachiel gi boche mag jamni machwe.</para>
  <para style="q1" vid="ISA 1:11">Ok amor</para>
  <para style="q2" vid="ISA 1:11">gi remb rwedhi gi mag imbe kod mag nywogi.<verse eid="ISA 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 1:12"/>Ere ngʼama osekwayou gigo ka ubiro e nyima,</para>
  <para style="q2" vid="ISA 1:12">donge mano en dwanyo hekalu mara maler.<verse eid="ISA 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 1:13"/>Kik ukel misengini maonge tich e nyima!</para>
  <para style="q2" vid="ISA 1:13">Tik ubanino dungʼna marach,</para>
  <para style="q1" vid="ISA 1:13">kendo sewni mutimo ka dwe opor,</para>
  <para style="q2" vid="ISA 1:13">gi mag Sabato kata e chokruoge duto ok amorgo.<verse eid="ISA 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 1:14"/>Sewni mutimo ka dwe opor kod sewni moyier</para>
  <para style="q2" vid="ISA 1:14">chido chunya,</para>
  <para style="q1" vid="ISA 1:14">giselokore tingʼ mapek matura bende aol gi tingʼogi.<verse eid="ISA 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 1:15"/>Ka utingʼo bedeu malo kulemo</para>
  <para style="q2" vid="ISA 1:15">to anapandnu wangʼa,</para>
  <para style="q1" vid="ISA 1:15">kendo kata ulem machal nade</para>
  <para style="q2" vid="ISA 1:15">to ok anadwoku.</para>
  <para style="b" vid="ISA 1:15"/>
  <para style="q1" vid="ISA 1:15">Lweteu osechwero remo mangʼeny!<verse eid="ISA 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 1:16"/>Lwokreuru mondo ubed maler.</para>
  <para style="q2" vid="ISA 1:16">Goluru timbeu mamono</para>
  <para style="q2" vid="ISA 1:16">e wangʼa!<verse eid="ISA 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 1:17"/>Weuru timbeu maricho;</para>
  <para style="q2" vid="ISA 1:17">to upuonjru timbe mabeyo!</para>
  <para style="q1" vid="ISA 1:17">Dwaruru tim makare,</para>
  <para style="q2" vid="ISA 1:17">kendo jiwuru joma ithiro.</para>
  <para style="q1" vid="ISA 1:17">Bende nyaka une ni nyithind kiye</para>
  <para style="q2" vid="ISA 1:17">kod mon ma chwogi otho oyal buchegi e yo makare kare.<verse eid="ISA 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 1:18"/>Jehova Nyasaye wacho niya,</para>
  <para style="q2" vid="ISA 1:18">“Biuru machiegni mondo wapor wach,</para>
  <para style="q1" vid="ISA 1:18">kata obedo ni richou kwar manade</para>
  <para style="q2" vid="ISA 1:18">to ibiro luoki magibed matar ka pe,</para>
  <para style="q1" vid="ISA 1:18">bende kata bed ni gikwar malich</para>
  <para style="q2" vid="ISA 1:18">to nobed marachar ka pamba.<verse eid="ISA 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 1:19"/>Ka uyie kuoma muboloru kendo umako chikena duto,</para>
  <para style="q2" vid="ISA 1:19">to unucham gik mabeyo mag piny;<verse eid="ISA 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 1:20"/>to ka udagi kendo ungʼanyo</para>
  <para style="q2" vid="ISA 1:20">to ligangla notieku.”</para>
  <para style="q1" vid="ISA 1:20">Nimar an Jehova Nyasaye ema asewacho.<verse eid="ISA 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 1:21"/>Neye kaka dala maduongʼ ma yande oluoro Nyasaye</para>
  <para style="q2" vid="ISA 1:21">koro oselokore ochot!</para>
  <para style="q1" vid="ISA 1:21">Kinde moko ne en kama adiera odakie,</para>
  <para style="q2" vid="ISA 1:21">tim makare ne yudore,</para>
  <para style="q2" vid="ISA 1:21">to tinde jonek ema opongʼe.<verse eid="ISA 1:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 1:22"/>Fedha magu oselokore chuoth nyinyo</para>
  <para style="q2" vid="ISA 1:22">bende divai magu mogen oseruw gi pi.<verse eid="ISA 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 1:23"/>Jotendu ongʼanyo</para>
  <para style="q2" vid="ISA 1:23">kendo gin e kanyakla mar jokwoge,</para>
  <para style="q1" vid="ISA 1:23">giduto gihero asoya,</para>
  <para style="q2" vid="ISA 1:23">kendo gihero gik makonyogi giwegi.</para>
  <para style="q1" vid="ISA 1:23">Ok giyal buche nyithind kiye kare,</para>
  <para style="q2" vid="ISA 1:23">bende weche mamon ma chwogi otho okelo e nyimgi ok gidew.<verse eid="ISA 1:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 1:24"/>Kuom mano, Ruoth Nyasaye ma en Jehova Nyasaye Maratego,</para>
  <para style="q2" vid="ISA 1:24">kendo Jehova Nyasaye mar kanyakla mar Israel wacho kama:</para>
  <para style="q1" vid="ISA 1:24">“Anayud kwe kuom jok ma jara</para>
  <para style="q2" vid="ISA 1:24">kendo nachul kuor ne wasika.<verse eid="ISA 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 1:25"/>Anachwadu gi masiche</para>
  <para style="q2" vid="ISA 1:25">kendo anapwodhu maler,</para>
  <para style="q2" vid="ISA 1:25">mi agol timbeu mamono duto.<verse eid="ISA 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 1:26"/>Bangʼe anaduognu jongʼad bura makare kaka ne timore e ndalo machon,</para>
  <para style="q2" vid="ISA 1:26">kendo jongʼad rieko mane nitie aa chakruok.</para>
  <para style="q1" vid="ISA 1:26">Eka noluongu ni</para>
  <para style="q2" vid="ISA 1:26">Dala Maduongʼ mar Tim Makare,</para>
  <para style="q2" vid="ISA 1:26">Dala Maduongʼ Madiera Nitie.”<verse eid="ISA 1:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 1:27"/>Sayun nopwodh gi bura makare</para>
  <para style="q2" vid="ISA 1:27">bende joma oyie modak e iye norit kod adiera.<verse eid="ISA 1:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 1:28"/>To joma ongʼanyo kod joricho duto</para>
  <para style="q2" vid="ISA 1:28">gi joma oweyo Jehova Nyasaye notiek chuth.<verse eid="ISA 1:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 1:29"/>Wiu nokuodi gi tiend yiende mag ober</para>
  <para style="q2" vid="ISA 1:29">ma umorgo kutimoe misengini,</para>
  <para style="q1" vid="ISA 1:29">kendo unubed gi kuyo kuom puothe</para>
  <para style="q2" vid="ISA 1:29">museyiero mondo ulemie.<verse eid="ISA 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 1:30"/>Ubiro chalo kaka yiend ober ma ite ner</para>
  <para style="q2" vid="ISA 1:30">kendo kaka puodho ma ok yud pi.<verse eid="ISA 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 1:31"/>Ngʼat maratego e dieru nodok manyap,</para>
  <para style="q2" vid="ISA 1:31">kendo tekone nowuog mana ka pilni,</para>
  <para style="q1" vid="ISA 1:31">kendo gigo duto nowangʼ pep</para>
  <para style="q2" vid="ISA 1:31">maonge ngʼama nyalo nego majno.<verse eid="ISA 1:31"/></para>
  <chapter eid="ISA 1"/>
  <chapter number="2" style="c" sid="ISA 2"/>
  <para style="s1">Got mar Jehova Nyasaye</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1"/>Ma e fweny mane Isaya wuod Amoz noneno kuom Juda kod Jerusalem:<verse eid="ISA 2:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="ISA 2:2"/>E ndalo giko</para>
  <para style="q1" vid="ISA 2:2">got mogerie hekalu mar Jehova Nyasaye nobed gi teko</para>
  <para style="q2" vid="ISA 2:2">e kind gode duto molwore,</para>
  <para style="q1" vid="ISA 2:2">kendo ibiro tingʼe malo moyombo gode duto</para>
  <para style="q2" vid="ISA 2:2">kendo ogendini duto nobi ma pongʼe.<verse eid="ISA 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 2:3"/>Ogendini mangʼeny nobi kawacho niya,</para>
  <para style="q1" vid="ISA 2:3">“Biuru wadhi e got mar Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 2:3">e od Nyasach Jakobo.</para>
  <para style="q1" vid="ISA 2:3">Enopuonjwa wechene</para>
  <para style="q2" vid="ISA 2:3">mondo wawuothie e yorene.”</para>
  <para style="q1" vid="ISA 2:3">Chik nowuog Sayun,</para>
  <para style="q2" vid="ISA 2:3">kendo wach Jehova Nyasaye nowuog koa Jerusalem.<verse eid="ISA 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 2:4"/>Obiro ngʼado bura e kind ogendini</para>
  <para style="q2" vid="ISA 2:4">kendo nokel kwe e kind ogendini mangʼeny.</para>
  <para style="q1" vid="ISA 2:4">Ginithedh ligengligi olokre kwe mag pur</para>
  <para style="q2" vid="ISA 2:4">kendo tongegi ginithedhi olokre pende keyo.</para>
  <para style="q1" vid="ISA 2:4">Onge piny mano kedi gi nyawadgi gi ligangla</para>
  <para style="q2" vid="ISA 2:4">bende ok ginichak gipuonjre ne lweny kendo.<verse eid="ISA 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 2:5"/>Yaye od Jakobo,</para>
  <para style="q2" vid="ISA 2:5">biuru mondo wawuoth e ler mar Jehova Nyasaye.<verse eid="ISA 2:5"/></para>
  <para style="s1">Odiechieng Jehova Nyasaye</para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 2:6"/>Yaye Jehova Nyasaye, isejwangʼo jogi,</para>
  <para style="q2" vid="ISA 2:6">jogi ma nyikwa Jakobo.</para>
  <para style="q1" vid="ISA 2:6">Gipongʼ gi timbe mag mudho kod timbe mag jwok moa yo wuok chiengʼ,</para>
  <para style="q2" vid="ISA 2:6">gitimo timbe jwok ka jo-Filistia,</para>
  <para style="q2" vid="ISA 2:6">kendo gin e winjruok gi joma ok oyie.<verse eid="ISA 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 2:7"/>Pinygi opongʼ gi fedha kod dhahabu;</para>
  <para style="q2" vid="ISA 2:7">kendo mwandugi okadho akwana.</para>
  <para style="q1" vid="ISA 2:7">Pinygi opongʼ kod farese;</para>
  <para style="q2" vid="ISA 2:7">ngechegi mag lweny okadho akwana.<verse eid="ISA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 2:8"/>Pinygi opongʼ kod nyiseche manono;</para>
  <para style="q2" vid="ISA 2:8">gilamo gik ma gipayo kod lwetgi,</para>
  <para style="q2" vid="ISA 2:8">gigo ma lwetgi ema oloso.<verse eid="ISA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 2:9"/>Omiyo dhano nodwok piny</para>
  <para style="q2" vid="ISA 2:9">kendo ogendini mangʼeny noma teko,</para>
  <para style="q2" vid="ISA 2:9">kuom mano ok nowenegi.<verse eid="ISA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 2:10"/>Donjuru e buche manie kind lwendni, ponduru e buche manie lowo</para>
  <para style="q2" vid="ISA 2:10">ka luoro omakou nikech,</para>
  <para style="q2" vid="ISA 2:10">duongʼ malich mar Jehova Nyasaye kod tekone!<verse eid="ISA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 2:11"/>Wangʼ teko mar ngʼama janjore nothir</para>
  <para style="q2" vid="ISA 2:11">kendo sunga mag ji nodwok piny;</para>
  <para style="q1" vid="ISA 2:11">Jehova Nyasaye kende ema notingʼ nyinge malo odiechiengno.<verse eid="ISA 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 2:12"/>Jehova Nyasaye Maratego owalo odiechiengʼ</para>
  <para style="q2" vid="ISA 2:12">manokumie josunga,</para>
  <para style="q1" vid="ISA 2:12">joma kawore gi jogo matingʼore malo duto</para>
  <para style="q2" vid="ISA 2:12">(mi nodwokgi piny),<verse eid="ISA 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 2:13"/>nimar yiende sida duto maboyo moriere man Lebanon</para>
  <para style="q2" vid="ISA 2:13">kendo yiende mag ober duto man Bashan,<verse eid="ISA 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 2:14"/>kaachiel gi gode maboyo duto</para>
  <para style="q2" vid="ISA 2:14">gi gode matindo duto motingʼore malo,<verse eid="ISA 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 2:15"/>gi kuonde moger malo mag jorito,</para>
  <para style="q2" vid="ISA 2:15">kendo gi ohinga mochiel motegno,<verse eid="ISA 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 2:16"/>kod meli mangʼeny duto mag ohala</para>
  <para style="q2" vid="ISA 2:16">gi yiedhi molos mabeyo.<verse eid="ISA 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 2:17"/>Wich teko mar dhano ibiro dwoko piny</para>
  <para style="q2" vid="ISA 2:17">kendo sunga mag ji nothir,</para>
  <para style="q1" vid="ISA 2:17">mi Jehova Nyasaye kende ema notingʼ malo odiechiengno,<verse eid="ISA 2:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ISA 2:18"/>kendo nyiseche manono notiek pep.<verse eid="ISA 2:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 2:19"/>Ji noring kapondo e buche manie kind lwendni</para>
  <para style="q2" vid="ISA 2:19">to gi buche manie lowo,</para>
  <para style="q1" vid="ISA 2:19">ka luoro omakogi</para>
  <para style="q2" vid="ISA 2:19">nikech duongʼ malich mar Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 2:19">kod e kindeno mano thinyre mondo oyieng piny.<verse eid="ISA 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 2:20"/>E kindeno ji nojwangʼ</para>
  <para style="q2" vid="ISA 2:20">nyiseche manono molos gi fedha kod dhahabu ma yande gilamo,</para>
  <para style="q2" vid="ISA 2:20">kaachiel gi oyieyo kod olik tiga.<verse eid="ISA 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 2:21"/>Ji noring kapondo e buche manie kind lwendni</para>
  <para style="q2" vid="ISA 2:21">kod buche manie kor lwanda,</para>
  <para style="q1" vid="ISA 2:21">ka luoro omakogi</para>
  <para style="q2" vid="ISA 2:21">nikech duongʼ malich mar Jehova Nyasaye kod tekone,</para>
  <para style="q2" vid="ISA 2:21">e kindeno mano thinyre mondo oyieng piny.<verse eid="ISA 2:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 2:22"/>We keto genoni kuom dhano nimar dhano,</para>
  <para style="q2" vid="ISA 2:22">en mana muya kende mawuok e ume.</para>
  <para style="q2" vid="ISA 2:22">Koso en angʼo man kuome maber?<verse eid="ISA 2:22"/></para>
  <chapter eid="ISA 2"/>
  <chapter number="3" style="c" sid="ISA 3"/>
  <para style="s1">Kum ne Jerusalem kod Juda</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 3:1"/>Neuru koro Ruoth Nyasaye,</para>
  <para style="q2" vid="ISA 3:1">ma en Jehova Nyasaye Maratego,</para>
  <para style="q1" vid="ISA 3:1">biro tieko mich kod kony</para>
  <para style="q2" vid="ISA 3:1">mikelo ne Jerusalem kod Juda.</para>
  <para style="q1" vid="ISA 3:1">Notiek kit chiemo duto kod pi<verse eid="ISA 3:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="ISA 3:2"/>thuondi maroteke kod jolweny,</para>
  <para style="q1" vid="ISA 3:2">gi jongʼad bura gi jonabi</para>
  <para style="q2" vid="ISA 3:2">gi jokor wach kod jodongo,<verse eid="ISA 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 3:3"/>jatend lweny morito ji piero abich gi joma ogen,</para>
  <para style="q2" vid="ISA 3:3">jongʼad rieko, jopecho molony kod joma olony e wach.<verse eid="ISA 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 3:4"/>Anaket mana yawuowi obed jotendgi,</para>
  <para style="q2" vid="ISA 3:4">to rawere matindo noritgi.<verse eid="ISA 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 3:5"/>Ji nosandre kendgi giwegi,</para>
  <para style="q2" vid="ISA 3:5">ka ngʼato sando mana wadgi owuon</para>
  <para style="q2" vid="ISA 3:5">bende jogo modak mokiewo nosandre kendgi giwegi.</para>
  <para style="q1" vid="ISA 3:5">Jomatindo notug lweny gi jomadongo,</para>
  <para style="q2" vid="ISA 3:5">kendo ji ajiya nocha joma ogen.<verse eid="ISA 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 3:6"/>Ngʼato nochun achiel kuom owetene</para>
  <para style="q2" vid="ISA 3:6">manie dala wuon-gi kowacho niya,</para>
  <para style="q1" vid="ISA 3:6">“In ema in-gi lep loch, koro telnwa;</para>
  <para style="q2" vid="ISA 3:6">kendo ibed gi teko ewi pinywa mokethoreni.”<verse eid="ISA 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 3:7"/>To e kindeno ngʼatno nodwoki niya,</para>
  <para style="q2" vid="ISA 3:7">“Ooyo ok dabed ruodhu,</para>
  <para style="q1" vid="ISA 3:7">nimar aonge gi chiemo kata lewni e oda</para>
  <para style="q2" vid="ISA 3:7">madimi uketa abed jatend ogandani.”<verse eid="ISA 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 3:8"/>Jerusalem yiengni,</para>
  <para style="q2" vid="ISA 3:8">bende Juda mukore;</para>
  <para style="q1" vid="ISA 3:8">wechegi kod timbegi opogore gi dwach Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 3:8">nimar ok omi duongʼne nenre e diergi.<verse eid="ISA 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 3:9"/>Wangʼ-gi nyiso ni gin joricho</para>
  <para style="q2" vid="ISA 3:9">kendo richogi oyangore e lela mana ka richo mane ni Sodom,</para>
  <para style="q2" vid="ISA 3:9">bende gionge gi wichkuot.</para>
  <para style="q1" vid="ISA 3:9">Yaye, mano kaka ginine malit</para>
  <para style="q2" vid="ISA 3:9">nikech gisekelo masira kuomgi giwegi.<verse eid="ISA 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 3:10"/>Kone joma kare ni gin johawi,</para>
  <para style="q2" vid="ISA 3:10">nimar giniyud pok kuom tichgi matek.<verse eid="ISA 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 3:11"/>Yaye, mano kaka nobed malit ne joricho nikech masira nobed kuomgi.</para>
  <para style="q2" vid="ISA 3:11">Enokumgi kuom gik maricho ma lwetgi osetimo.<verse eid="ISA 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 3:12"/>Jomatindo ema thiro joga</para>
  <para style="q2" vid="ISA 3:12">kendo mon ema jotendgi.</para>
  <para style="q1" vid="ISA 3:12">Yaye joga, jotendu osewuondou,</para>
  <para style="q2" vid="ISA 3:12">momiyo ubaro uweyo yo.<verse eid="ISA 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 3:13"/>Jehova Nyasaye osebedo e kom bura</para>
  <para style="q2" vid="ISA 3:13">mondo ongʼad bura ne oganda.<verse eid="ISA 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 3:14"/>Sa ngʼado bura mar Jehova Nyasaye</para>
  <para style="q2" vid="ISA 3:14">kuom jodongo kod jotend joge osechopo,</para>
  <para style="q1" vid="ISA 3:14">kowacho niya, “Un ema useketho puotha mar mzabibu</para>
  <para style="q2" vid="ISA 3:14">kendo gik ma uyako kukawo e ut joma odhier opongʼo uteu.<verse eid="ISA 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 3:15"/>En angʼo momiyo usando</para>
  <para style="q2" vid="ISA 3:15">kendo uthiro joga modhier?”</para>
  <para style="q2" vid="ISA 3:15">Ruoth Nyasaye, ma en Jehova Nyasaye Maratego ema owacho.<verse eid="ISA 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 3:16"/>Jehova Nyasaye wacho niya,</para>
  <para style="q2" vid="ISA 3:16">“Mond Sayun sungore kendo kawore, gingʼayo ngʼutgi malo,</para>
  <para style="q1" vid="ISA 3:16">kendo giningʼo wengegi.</para>
  <para style="q2" vid="ISA 3:16">Bende giwuotho ka gingʼadore,</para>
  <para style="q2" vid="ISA 3:16">ka gara manie tiendgi ywak.<verse eid="ISA 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 3:17"/>Kuom mano Ruoth Nyasaye biro kelo adhonde ewi mond Sayun,</para>
  <para style="q2" vid="ISA 3:17">kendo Jehova Nyasaye nomi timbegi mamono nenre ratiro.”<verse eid="ISA 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 3:18"/>Odiechiengʼno Ruoth Nyasaye biro mayogi gik ma gilichorego kaka: bangli gi kitembini mag wich kod tigo mag ngʼut, <verse eid="ISA 3:18"/><verse number="19" style="v" sid="ISA 3:19"/>gi tigo miliero e it gi bangli mag lwetgi kod kitamba miliero e ngʼut, <verse eid="ISA 3:19"/><verse number="20" style="v" sid="ISA 3:20"/>gi kitembini mag wich, gi thiwni mag ofunj tielo, gi misip gi chupni motingʼo gik mangʼwe ngʼar kod ris, <verse eid="ISA 3:20"/><verse number="21" style="v" sid="ISA 3:21"/>gi tere mag lwedo gi mag um, <verse eid="ISA 3:21"/><verse number="22" style="v" sid="ISA 3:22"/>lewni mayom gi kode gi mifuke mag lwedo, <verse eid="ISA 3:22"/><verse number="23" style="v" sid="ISA 3:23"/>kod kio, gi lewni mabeyo gi lewni miliero e ngʼut kod mago miumogo wangʼ.<verse eid="ISA 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 3:24"/>Kar winjo tik mangʼwe ngʼar to unuwinj mana tik madungʼ marach;</para>
  <para style="q2" vid="ISA 3:24">kar bedo gi okanda to tol ema nutwerugo;</para>
  <para style="q1" vid="ISA 3:24">kar bedo gi yie wich molos maber to bondo ema unudongʼ-go;</para>
  <para style="q2" vid="ISA 3:24">kar bedo gi lewni mabeyo to unurwak mana pien gugru,</para>
  <para style="q2" vid="ISA 3:24">kar bedo gi wangʼ man-gi chia to adhonde nopongʼ dendu.<verse eid="ISA 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 3:25"/>Chwou notiek gi ligangla</para>
  <para style="q2" vid="ISA 3:25">kendo jolweny magu norum e lweny.<verse eid="ISA 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 3:26"/>Nduru gi ywak mag dengo nopongʼ dhorongeye mag Sayun,</para>
  <para style="q2" vid="ISA 3:26">kendo dalano nodongʼ nono kokethore.<verse eid="ISA 3:26"/></para>
  <chapter eid="ISA 3"/>
  <chapter number="4" style="c" sid="ISA 4"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 4:1"/>E kindeno mon abiriyo</para>
  <para style="q2" vid="ISA 4:1">biro laro dichwo achiel,</para>
  <para style="q1" vid="ISA 4:1">kagiwacho niya, “Wanacham chiembwa wawegi</para>
  <para style="q2" vid="ISA 4:1">kendo wanarwak lepwa wawegi,</para>
  <para style="q1" vid="ISA 4:1">makmana yienwa mondo oluongwa gi nyingi</para>
  <para style="q2" vid="ISA 4:1">mondo igolnwa wichkuot!”<verse eid="ISA 4:1"/></para>
  <para style="s1">Bad Yath mar Jehova Nyasaye</para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 4:2"/>E kindeno Bad Yath mar Jehova Nyasaye nobed maber kendo man-gi duongʼ, kendo olemo mar piny nobed mor kod duongʼ ne jo-Israel motony. <verse eid="ISA 4:2"/><verse number="3" style="v" sid="ISA 4:3"/>Eka joma noyud kotony e Sayun kod Jerusalem noluong ni jomaler, ma gin kar romb ji duto moyud kangima e Jerusalem <verse eid="ISA 4:3"/><verse number="4" style="v" sid="ISA 4:4"/>Ruoth Nyasaye noluok richo mag mond Sayun; kendo enopwodh remo manochwer Jerusalem gi roho mar ngʼado bura kod roho mar mach. <verse eid="ISA 4:4"/><verse number="5" style="v" sid="ISA 4:5"/>Bangʼe Jehova Nyasaye nokel rumbi mar iro ne ji godiechiengʼ kendo ligek mach mangʼangʼni gotieno e Got Sayun. Duongʼni nobed ka yath maduongʼ makelo tipo. <verse eid="ISA 4:5"/><verse number="6" style="v" sid="ISA 4:6"/>Nobed mana ka tado makelo tipo ka chiengʼ rieny kendo ka kama ji ringo tonyie ka bwok ne koth kod ahiti maduongʼ.<verse eid="ISA 4:6"/></para>
  <chapter eid="ISA 4"/>
  <chapter number="5" style="c" sid="ISA 5"/>
  <para style="s1">Wend jarit puoth mzabibu</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 5:1"/>Abiro wero wend ngʼat ma ahero,</para>
  <para style="q2" vid="ISA 5:1">wer mar puothe mar mzabibu niya:</para>
  <para style="q1" vid="ISA 5:1">Jal ma ahero ne nigi puoth mzabibu</para>
  <para style="q2" vid="ISA 5:1">e bath got kama omewo.<verse eid="ISA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 5:2"/>Ne opure maber mogolo kite duto manie iye</para>
  <para style="q2" vid="ISA 5:2">kendo opidhoe olembe mabeyo ahinya moyier.</para>
  <para style="q1" vid="ISA 5:2">Ne ogero kama otingʼore gi malo mar ngʼicho e chuny puodhono</para>
  <para style="q2" vid="ISA 5:2">bende noloso kama ibiyoe mzabibu.</para>
  <para style="q1" vid="ISA 5:2">Eka nomanyo olembe mabeyo</para>
  <para style="q2" vid="ISA 5:2">to kata kamano neginyago mana olembe maricho.<verse eid="ISA 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 5:3"/>“Koro un joma odak Jerusalem to gi jogo modak Juda;</para>
  <para style="q2" vid="ISA 5:3">ngʼadieuru bura e kinda kod puotha mar mzabibu.<verse eid="ISA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 5:4"/>Angʼo machielo mane onego otim e puotha mar mzabibu</para>
  <para style="q2" vid="ISA 5:4">maloyo mano mane atimone?</para>
  <para style="q1" vid="ISA 5:4">Kane adwaro olembe mabeyo</para>
  <para style="q2" vid="ISA 5:4">to angʼo mane omiyo onyago mana mago maricho?<verse eid="ISA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 5:5"/>Koro abiro nyisou</para>
  <para style="q2" vid="ISA 5:5">gima abiro timo ne puotha mar mzabibu:</para>
  <para style="q1" vid="ISA 5:5">Abiro golo chiende oko,</para>
  <para style="q2" vid="ISA 5:5">kendo ibiro kethe,</para>
  <para style="q1" vid="ISA 5:5">abiro muko ohingane</para>
  <para style="q2" vid="ISA 5:5">kendo nonyone piny.<verse eid="ISA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 5:6"/>Bende anaweye kojwangʼore</para>
  <para style="q2" vid="ISA 5:6">ma ok olose kata doye kendo ongʼono,</para>
  <para style="q2" vid="ISA 5:6">kod kuthe ema nodongie.</para>
  <para style="q1" vid="ISA 5:6">Abiro chiko boche polo</para>
  <para style="q2" vid="ISA 5:6">mondo kik koth ochwene.”<verse eid="ISA 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 5:7"/>Puoth mzabibu mar Jehova Nyasaye Maratego</para>
  <para style="q2" vid="ISA 5:7">en od jo-Israel,</para>
  <para style="q1" vid="ISA 5:7">kod jo-Juda</para>
  <para style="q2" vid="ISA 5:7">e puodho mamiye mor.</para>
  <para style="q1" vid="ISA 5:7">Osedwaro mondo ngʼado bura makare obedie,</para>
  <para style="q2" vid="ISA 5:7">to oneno mana nek</para>
  <para style="q1" vid="ISA 5:7">kendo osedwaro mondo one tim makare,</para>
  <para style="q2" vid="ISA 5:7">to owinjo mana ywak mar lit.<verse eid="ISA 5:7"/></para>
  <para style="s1">Masiche kod ngʼado bura</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 5:8"/>Unune malit, un joma mayo ji utegi ma gisegero</para>
  <para style="q2" vid="ISA 5:8">kendo umayo ji puothegi,</para>
  <para style="q1" vid="ISA 5:8">maonge kama odongʼ</para>
  <para style="q2" vid="ISA 5:8">ma udongʼ ka udak kendu e pinyno.<verse eid="ISA 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 5:9"/>Jehova Nyasaye Maratego osewacho ayanga ka awinjo ni:</para>
  <para style="q1" vid="ISA 5:9">“Kata kamano ute madongo biro dongʼ gunda,</para>
  <para style="q2" vid="ISA 5:9">kendo ute madongo moger mabeyo biro dongʼ maonge joma odakie.<verse eid="ISA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 5:10"/>Heka apar mar mzabibu nogol mana olemo karaya achiel kende,</para>
  <para style="q2" vid="ISA 5:10">kendo kodhi moromo gorogoro nonyag cham maromo debe kende.”<verse eid="ISA 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 5:11"/>Unune malit un joma chiewo gokinyi</para>
  <para style="q2" vid="ISA 5:11">kulawo kuonde kongʼo,</para>
  <para style="q1" vid="ISA 5:11">un ma ubudho kuneno nyaka chuny otieno</para>
  <para style="q2" vid="ISA 5:11">ka umer maonge rieko.<verse eid="ISA 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 5:12"/>Gitimo nyasigi gi kongʼo, gi nyatiti, gi orutu,</para>
  <para style="q2" vid="ISA 5:12">gi oyieke kod asili,</para>
  <para style="q1" vid="ISA 5:12">to ok gidewo gik ma Jehova Nyasaye osetimo</para>
  <para style="q2" vid="ISA 5:12">bende ok giluoro tij lwete.<verse eid="ISA 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 5:13"/>Omiyo koro joga biro dhi e twech</para>
  <para style="q2" vid="ISA 5:13">nikech bedo maonge winjo;</para>
  <para style="q1" vid="ISA 5:13">jotendgi kech biro nego,</para>
  <para style="q2" vid="ISA 5:13">Kendo oganda modongʼ to riyo ema biro nego.<verse eid="ISA 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 5:14"/>Kuom mano piny joma otho ongʼamo dhoge malach</para>
  <para style="q2" vid="ISA 5:14">ka dande oyawore malich;</para>
  <para style="q1" vid="ISA 5:14">kendo enomuony jotelo kod oganda mamoko</para>
  <para style="q2" vid="ISA 5:14">e kinde ma gikokee gi mor.<verse eid="ISA 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 5:15"/>Omiyo dhano nodwok piny</para>
  <para style="q2" vid="ISA 5:15">kendo ogendini duto nogol tekogi,</para>
  <para style="q2" vid="ISA 5:15">kendo timbe jonjore notieki.<verse eid="ISA 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 5:16"/>To Jehova Nyasaye Maratego notingʼ malo gi timne makare,</para>
  <para style="q2" vid="ISA 5:16">kendo Nyasaye maler nonyis lerne gi timne makare.<verse eid="ISA 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 5:17"/>Eka rombe nokwa e legegi giwegi;</para>
  <para style="q2" vid="ISA 5:17">to nyirombe nokwa e gundni mane mag jomoko.<verse eid="ISA 5:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 5:18"/>Unune malit un joma osiko katimo richo ka umede gi miriambo,</para>
  <para style="q2" vid="ISA 5:18">kod timbe anjawo,<verse eid="ISA 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 5:19"/>kod joma wacho ni joga niya, “Nyasaye mondo oreti,</para>
  <para style="q2" vid="ISA 5:19">kendo otim gima odwaro timo,</para>
  <para style="q2" vid="ISA 5:19">mondo wanene.</para>
  <para style="q1" vid="ISA 5:19">We gima Jal Maler mar Israel dwaro timo otimre</para>
  <para style="q2" vid="ISA 5:19">mondo wangʼeye.”<verse eid="ISA 5:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 5:20"/>Mano kaka nobed malit ne joma luongo tim mamono ni ber</para>
  <para style="q2" vid="ISA 5:20">to tim maber ni rach;</para>
  <para style="q1" vid="ISA 5:20">jogo maketo mudho kar ler</para>
  <para style="q2" vid="ISA 5:20">to kar ler gikete mudho,</para>
  <para style="q1" vid="ISA 5:20">joma keto gik makech kar mamit</para>
  <para style="q2" vid="ISA 5:20">to mamit giketo kar makech.<verse eid="ISA 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 5:21"/>Mano kaka nobed malit ne jogo mariek e wengegi giwegi</para>
  <para style="q2" vid="ISA 5:21">kendo kwano ni ongʼeyo gik moko duto.<verse eid="ISA 5:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 5:22"/>Mano kaka nobed malit ne thuondi mag madho kongʼo</para>
  <para style="q2" vid="ISA 5:22">kendo molony e ruwo kongʼo makech.<verse eid="ISA 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 5:23"/>Un ma uweyo joketho nikech asoya,</para>
  <para style="q2" vid="ISA 5:23">to joma onge ketho ema utamo e adiera margi.<verse eid="ISA 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 5:24"/>Kuom mano kaka lew mach wangʼo yugi</para>
  <para style="q2" vid="ISA 5:24">kendo kaka lum motwo lal nono e mach,</para>
  <para style="q1" vid="ISA 5:24">e kaka tiendgi notow</para>
  <para style="q2" vid="ISA 5:24">bende maua mawuok e itgi nolwar mana ka buru,</para>
  <para style="q1" vid="ISA 5:24">nikech gisedagi chik mar Jehova Nyasaye Maratego</para>
  <para style="q2" vid="ISA 5:24">kendo chayo wach Jal Maler mar Israel.<verse eid="ISA 5:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 5:25"/>Kuom mano Jehova Nyasaye osekecho gi joge;</para>
  <para style="q2" vid="ISA 5:25">kendo oserieyo bade kuomgi monegogi.</para>
  <para style="q1" vid="ISA 5:25">Gode yiengni kendo</para>
  <para style="q2" vid="ISA 5:25">ringre joma otho odhurore e wangʼ yore ka yugi.</para>
  <para style="b" vid="ISA 5:25"/>
  <para style="q1" vid="ISA 5:25">To kata bed ni magi duto osetimore,</para>
  <para style="q2" vid="ISA 5:25">to mirimbe pod ok okwe,</para>
  <para style="q2" vid="ISA 5:25">nimar pod okecho kodgi.<verse eid="ISA 5:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 5:26"/>Otingʼo bandera malo ne ogendini moa mabor,</para>
  <para style="q2" vid="ISA 5:26">kendo ogoyo tungʼ koluongo jogo moa e tunge piny.</para>
  <para style="q1" vid="ISA 5:26">Gibiro mapiyo piyo</para>
  <para style="q2" vid="ISA 5:26">ka giringo matek.<verse eid="ISA 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 5:27"/>Onge kata mana ngʼato achiel kuomgi ma ol kata machwanyore,</para>
  <para style="q2" vid="ISA 5:27">bende onge kata ngʼato achiel kuomgi ma nindo tero,</para>
  <para style="q1" vid="ISA 5:27">bende onge moro ma okanda ombekni e nungone</para>
  <para style="q2" vid="ISA 5:27">kata ma tond wuochene ochot.<verse eid="ISA 5:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 5:28"/>Asernigi bith</para>
  <para style="q2" vid="ISA 5:28">bende atungegi duto oywa motegno,</para>
  <para style="q1" vid="ISA 5:28">kendo faresegi ombongʼ tiendgi ojingʼ,</para>
  <para style="q2" vid="ISA 5:28">tiend gechegi winyore ka kalausi.<verse eid="ISA 5:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 5:29"/>Giruto ka sibuor</para>
  <para style="q2" vid="ISA 5:29">kendo gingʼur ka sibuoche matindo,</para>
  <para style="q1" vid="ISA 5:29">bende gimor ka gidwaro mako le,</para>
  <para style="q2" vid="ISA 5:29">mi gitingʼ-gi e dhogi maonge ngʼama nyalo resogi.<verse eid="ISA 5:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 5:30"/>Odiechiengno ginirut kuome</para>
  <para style="q2" vid="ISA 5:30">mana ka mor mar ataro.</para>
  <para style="q1" vid="ISA 5:30">Kendo ka ngʼato ongʼiyo pinyno</para>
  <para style="q2" vid="ISA 5:30">to none mudho gi kuyo;</para>
  <para style="q2" vid="ISA 5:30">kata mana ler mar chiengʼ boche polo noum.<verse eid="ISA 5:30"/></para>
  <chapter eid="ISA 5"/>
  <chapter number="6" style="c" sid="ISA 6"/>
  <para style="s1">Luong mar Isaya</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1"/>E higano mane Ruoth Uzia othoe, naneno Ruoth Nyasaye kobet e kom duongʼ motingʼore malo kendo omi luor, ka tiend lawe opongʼo hekalu. <verse eid="ISA 6:1"/><verse number="2" style="v" sid="ISA 6:2"/>E wiye malo malaike miluongoni serafi ochungʼe kamoro ka moro nigi bwombe auchiel ka bwombe ariyo giumogo wengegi, to bwombe ariyo mamako giumogo tiendegi, to bwombe ariyo modongʼ gihuyogo. <verse eid="ISA 6:2"/><verse number="3" style="v" sid="ISA 6:3"/>Negiluongore moro ka moro kagiwacho ni:</para>
  <para style="q1" vid="ISA 6:3">“Maler, Maler, Maler en Jehova Nyasaye Maratego;</para>
  <para style="q2" vid="ISA 6:3">piny duto opongʼ gi duongʼne.”<verse eid="ISA 6:3"/></para>
  <para style="m">
    <verse number="4" style="v" sid="ISA 6:4"/>E seche mane dwondgi kok kamano, mise mag dhoudi ne yiengni kendo hekalu ne opongʼ kod iro.<verse eid="ISA 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 6:5"/>Ne aywak niya, “mano kaka lit! Arumo chuth! Nimar an ngʼat ma dhoge wacho gik ma ok ler kendo adak e kind joma wechegi ochido, eka an to aseneno Ruoth, ma en Jehova Nyasaye Maratego gi wangʼa awuon.”<verse eid="ISA 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 6:6"/>Eka achiel kuom malaike miluongo ni serafi nohuyo mochopo buta kotingʼo mach e lwete, mosegolo gi ramaki e kendo mar misango. <verse eid="ISA 6:6"/><verse number="7" style="v" sid="ISA 6:7"/>Nokawo gino momulogo dhoga mi owacho niya, “Ne, koro asemulo lewi, mi kethoni oseweni kendo richoni osepwodhi.”<verse eid="ISA 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 6:8"/>Eka ne awinjo dwond Ruoth Nyasaye kapenjo niya, “Ere ngʼama abiro oro? Koso en ngʼa monego odhinwa?”</para>
  <para style="p" vid="ISA 6:8">Kendo ne adwoko niya, “Eri antie, ora!”<verse eid="ISA 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 6:9"/>Eka nowacho niya, “Dhiyo kendo iwachne jogi kama:</para>
  <para style="q1" vid="ISA 6:9">“ ‘Ubiro siko kuwinjo weche miwacho</para>
  <para style="q2" vid="ISA 6:9">to wach ok nodonjnu ngangʼ;</para>
  <para style="q1" vid="ISA 6:9">ubiro siko kungʼicho,</para>
  <para style="q2" vid="ISA 6:9">to ok unune gimoro.’<verse eid="ISA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 6:10"/>Ket chuny jogi obed modhil,</para>
  <para style="q2" vid="ISA 6:10">kendo mi itgi dinre ma ok winj wach,</para>
  <para style="q2" vid="ISA 6:10">bende wengegi obed ma ok nen.</para>
  <para style="q1" vid="ISA 6:10">Nono to dipo ka wengegi oneno,</para>
  <para style="q2" vid="ISA 6:10">kendo itgi owinjo wach,</para>
  <para style="q2" vid="ISA 6:10">kendo mi chunygi ofwenyo tiend weche,</para>
  <para style="q1" vid="ISA 6:10">mi gilokre ma chang-gi.”<verse eid="ISA 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 6:11"/>Eka napenjo niya, “Yaye Ruoth Nyasaye, mano notimre nyaka karangʼo?”</para>
  <para style="p" vid="ISA 6:11">Kendo nodwoko niya,</para>
  <para style="q1" vid="ISA 6:11">“Nyaka chop mier madongo ruombre piny madongʼ gunda</para>
  <para style="q2" vid="ISA 6:11">maonge joma odakie,</para>
  <para style="q1" vid="ISA 6:11">bende mi udi ma ji odakie ojwangʼ</para>
  <para style="q2" vid="ISA 6:11">kendo puothe duto kethre mi jwangʼ-gi,<verse eid="ISA 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 6:12"/>bende nyaka ndalo ma Jehova Nyasaye oriemboe ji duto mabor</para>
  <para style="q2" vid="ISA 6:12">ma piny odongʼ malich ka gunda.<verse eid="ISA 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 6:13"/>Kata bedni achiel kuom apar mar jogi nodongʼ e piny,</para>
  <para style="q2" vid="ISA 6:13">to gin bende notiekgi pep.</para>
  <para style="q1" vid="ISA 6:13">To mana kaka yiende mag ngʼowu kod yiend ober</para>
  <para style="q2" vid="ISA 6:13">motongʼ mowe osiki loth,</para>
  <para style="q2" vid="ISA 6:13">kamano e kaka jo-Nyasaye mabiro dongʼ e piny nochal gosikino.”<verse eid="ISA 6:13"/></para>
  <chapter eid="ISA 6"/>
  <chapter number="7" style="c" sid="ISA 7"/>
  <para style="s1">Ranyisi mar Imanuel</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1"/>E kinde mane Ahaz wuod Jotham ma wuod Uzia, ne ruodh Juda, ruoth Rezin mar Aram to gi Peka wuod Remalia ruodh Israel nomonjo Jerusalem gi lweny, to ne ok ginyal loye.<verse eid="ISA 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 7:2"/>Eka nowach ne od Daudi niya, “Jo-Aram osetimo winjruok gi jo-Efraim,” omiyo chuny Ahaz gi joge kihondko osemako, mana ka yien manie bungu ma yamo yiengo.<verse eid="ISA 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 7:3"/>Eka Jehova Nyasaye nowachone Isaya niya, “Wuogi in kaachiel gi wuodi miluongo ni Shear-Jashub udhi mondo urad gi Ahaz kama oula madonjo e yawo mamalo ogikie mantie but yo miluongo ni Puoth Jaluok lewni. <verse eid="ISA 7:3"/><verse number="4" style="v" sid="ISA 7:4"/>Wachne ni, ‘Bed motangʼ, hori kendo kik iluor. Kik chunyi nyosre nikech osiki ariyo mag mach motimo iro, machal gi mirima mager mar Rezin kod Aram to gi mar wuod Remalia. <verse eid="ISA 7:4"/><verse number="5" style="v" sid="ISA 7:5"/>Aram, Efraim kod wuod Remalia osechikoni obadho mondo otieki, kagiwacho niya, <verse eid="ISA 7:5"/><verse number="6" style="v" sid="ISA 7:6"/>“Wadhi mondo wamonj Juda, wakidhe matindo tindo kendo wapoge e kindwa wawegi bangʼe waket wuod Tabel obed ruodhe.” <verse eid="ISA 7:6"/><verse number="7" style="v" sid="ISA 7:7"/>To kata kamano ma e gima Jehova Nyasaye Manyalo Gik Moko Duto owacho,</para>
  <para style="q1" vid="ISA 7:7">“ ‘Ok giniyud thuolo,</para>
  <para style="q2" vid="ISA 7:7">bende ok notimre,<verse eid="ISA 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 7:8"/>nimar dala maduongʼ mar Aram en Damaski,</para>
  <para style="q2" vid="ISA 7:8">to jatend Damaski en Rezin.</para>
  <para style="q1" vid="ISA 7:8">Kuom higni piero auchiel gabich</para>
  <para style="q2" vid="ISA 7:8">Efraim notieki ma kare nolal nono.<verse eid="ISA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 7:9"/>Dala maduongʼ mar Efraim en Samaria,</para>
  <para style="q2" vid="ISA 7:9">kendo jatend Samaria en mana wuod Remalia.</para>
  <para style="q1" vid="ISA 7:9">Omiyo ka ok ichungʼ motegno e yie mari,</para>
  <para style="q2" vid="ISA 7:9">to ok inichung ngangʼ.’ ”<verse eid="ISA 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10"/>Jehova Nyasaye nowuoyo gi Ahaz kendo kawacho niya, <verse eid="ISA 7:10"/><verse number="11" style="v" sid="ISA 7:11"/>“Kwa Jehova Nyasaye ma Nyasachi ranyisi moro amora moa mwalo e bur piny kata moa e polo malo.”<verse eid="ISA 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 7:12"/>To Ahaz nowacho niya, “Ok abi kwayo to bende ok abi temo Jehova Nyasaye.”<verse eid="ISA 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 7:13"/>Eka Isaya nowacho niya, “To un joka Daudi, koro winjuru! Chand muchandogo ji pok oromou? Koso pod udwaro chando Nyasacha bende? <verse eid="ISA 7:13"/><verse number="14" style="v" sid="ISA 7:14"/>Kuom mano Ruoth Nyasaye owuon biro miyou ranyisi machal kama: Nyako ngili biro mako ich minywol wuowi, ma noluonge ni Imanuel (tiende ni Nyasaye nikodwa). <verse eid="ISA 7:14"/><verse number="15" style="v" sid="ISA 7:15"/>Obiro chamo mana mor dhiangʼ kod mor kich nyaka chop orom pogo rach gi ber. <verse eid="ISA 7:15"/><verse number="16" style="v" sid="ISA 7:16"/>To kapok nyathino ongʼeyo pogo rach gi ber, to pinjeruodhi ariyo miluorogo notieki. <verse eid="ISA 7:16"/><verse number="17" style="v" sid="ISA 7:17"/>Kokalo kuom ruodh Asuria, Jehova Nyasaye biro kelo kuomi gi kuom jogi kod od wuonu masira mane pok oneye nyaka ne Efraim pogre gi Juda.”<verse eid="ISA 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 7:18"/>E kindeno Jehova Nyasaye nochok lwangʼni kawuok e aore mag Misri kendo notug kich koa e piny Asuria. <verse eid="ISA 7:18"/><verse number="19" style="v" sid="ISA 7:19"/>Giduto ginibi kendo ginidagi kuonde holo kod buche mag lwendni kendo e bungu mag kuthe kod sokni duto. <verse eid="ISA 7:19"/><verse number="20" style="v" sid="ISA 7:20"/>E kindeno Ruoth Nyasaye nokonyre gi wembe mokwa tok Aora kocha ma en ruodh Asuria, mondo olielgo yie wiyeu, yie tiendeu kod yie tiku bende. <verse eid="ISA 7:20"/><verse number="21" style="v" sid="ISA 7:21"/>E kindeno ngʼato biro yudo konyruokne koa kuom nyaroya kod diek ariyo. <verse eid="ISA 7:21"/><verse number="22" style="v" sid="ISA 7:22"/>To nikech chak mangʼeny manonyiedh kuomgi enonwangʼ mor dhiangʼ mochamo. Jogo duto manodongʼ e pinyno nocham mana mor dhiangʼ kod mor kich. <verse eid="ISA 7:22"/><verse number="23" style="v" sid="ISA 7:23"/>E kindeno kuonde duto ma yande nitie mzabibu mangʼeny, maromo pesa mangʼeny nolokre pedo kod kuthe. <verse eid="ISA 7:23"/><verse number="24" style="v" sid="ISA 7:24"/>Ji nodhi kuno gi atungʼ kod asere nikech pinyno duto nopongʼ gi pedo kod kuthe. <verse eid="ISA 7:24"/><verse number="25" style="v" sid="ISA 7:25"/>To kuom gode matindo ma yande ipuro gi kwer, to ok unudhie kendo nikech luoro mar pedo mogawore kod kuthe, to ginibed kuonde ma dhok gi rombe kwayoe.<verse eid="ISA 7:25"/></para>
  <chapter eid="ISA 7"/>
  <chapter number="8" style="c" sid="ISA 8"/>
  <para style="s1">Jehova Nyasaye tiyo gi Asuria</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1"/>Jehova Nyasaye nowachone niya, “Kaw kalatas maduongʼ kendo indik wachni gi kalam mongʼongʼore ni Maher-Shalal-Hash-Baz, tiende ni yeko biro chako timore machiegni.” <verse eid="ISA 8:1"/><verse number="2" style="v" sid="ISA 8:2"/>Kendo abiro luongo Uria jadolo kod Zekaria wuod Jeberekia mondo gibedna joneno mar adier. <verse eid="ISA 8:2"/><verse number="3" style="v" sid="ISA 8:3"/>Bangʼe ne ariwora gi chiega ma janabi madhako kendo ne omako ich mi onywolo wuowi kendo Jehova Nyasaye nowachona niya, “Chake wuowino ni Maher-Shalal-Hash-Baz. <verse eid="ISA 8:3"/><verse number="4" style="v" sid="ISA 8:4"/>Kapok nyathino odongo mongʼeyo luongo ‘wuonwa’ kata ‘minwa,’ to mwandu duto mag Damaski kaachiel gi gik moyaki mag Samaria notingʼ gi ruodh Asuria.”<verse eid="ISA 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5"/>Jehova Nyasaye nowuoyo koda kendo kawacho niya,<verse eid="ISA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 8:6"/>“Nikech jogi osedagi,</para>
  <para style="q2" vid="ISA 8:6">pi mamol mamuol kawuok Shilo,</para>
  <para style="q1" vid="ISA 8:6">kendo gi mor mana gi Rezin</para>
  <para style="q2" vid="ISA 8:6">kod wuod Remalia,<verse eid="ISA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 8:7"/>Omiyo Ruoth Nyasaye biro kelo kuomgi</para>
  <para style="q2" vid="ISA 8:7">oula mopongʼ mag Aora,</para>
  <para style="q2" vid="ISA 8:7">ma en ruodh Asuria gi joge mag lweny.</para>
  <para style="q1" vid="ISA 8:7">Pi Aora nopongʼ wengene</para>
  <para style="q2" vid="ISA 8:7">ma nomuom gengene,<verse eid="ISA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 8:8"/>kendo obiro muomo piny Juda</para>
  <para style="q2" vid="ISA 8:8">mi ochop koni gi koni kokadho e diere,</para>
  <para style="q1" vid="ISA 8:8">kendo kopongʼ thich nyaka oulano nokwak pinyu duto,</para>
  <para style="q2" vid="ISA 8:8">yaye Imanuel!”<verse eid="ISA 8:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 8:9"/>Chokreuru ne lweny, un ogendini, ka luoro omakou!</para>
  <para style="q2" vid="ISA 8:9">Chikuru itu un ji duto manie pinje maboyo!</para>
  <para style="q1" vid="ISA 8:9">Bende ikreuru ne lweny ka luoro omakou!</para>
  <para style="q2" vid="ISA 8:9">Bende ikreuru ne lweny ka luoro omakou!<verse eid="ISA 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 8:10"/>Kata dabed ni ungʼado rieko kuom gik mudwaro timo to ibiro thirgi;</para>
  <para style="q2" vid="ISA 8:10">bende kata dabed ni uchano gima udwaro timo to ok notimre,</para>
  <para style="q1" vid="ISA 8:10">nikech Nyasaye nikodwa.<verse eid="ISA 8:10"/></para>
  <para style="s1">Luor Nyasaye</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11"/>Jehova Nyasaye ne owuoyo koda ka bade maratego ni kuoma, kosiema ni mondo kik awuothi e yore mag ogandani. Nowacho niya,<verse eid="ISA 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 8:12"/>“Gima jogi luongo ni andhoga</para>
  <para style="q2" vid="ISA 8:12">Kik uluong ni andhoga;</para>
  <para style="q1" vid="ISA 8:12">bende kik iluor gik ma giluoro</para>
  <para style="q2" vid="ISA 8:12">kendo kik gibwogi.<verse eid="ISA 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 8:13"/>Jehova Nyasaye Maratego ema onego ikwan ka ngʼat maler,</para>
  <para style="q2" vid="ISA 8:13">en ema onego umiye luor,</para>
  <para style="q2" vid="ISA 8:13">kendo en ema onego kibaji mare goyi,<verse eid="ISA 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 8:14"/>kendo en ema nobed kare maler;</para>
  <para style="q2" vid="ISA 8:14">to ne jo-Israel kod jo-Juda,</para>
  <para style="q1" vid="ISA 8:14">enobed kidi machwanyo ji</para>
  <para style="q2" vid="ISA 8:14">kendo lwanda mamiyo gipodho.</para>
  <para style="q1" vid="ISA 8:14">Chutho enobed obadho</para>
  <para style="q2" vid="ISA 8:14">ma jo-Jerusalem nomokie.<verse eid="ISA 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 8:15"/>Ji mangʼeny kuomgi nochwanyre</para>
  <para style="q2" vid="ISA 8:15">mi gore piny kendo tur,</para>
  <para style="q2" vid="ISA 8:15">nochiknegi obadho ma makgi.”<verse eid="ISA 8:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 8:16"/>Koro twe kalatas mondikie wechego motegno</para>
  <para style="q2" vid="ISA 8:16">kendo chan chikego e nyim jopuonjrena.<verse eid="ISA 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 8:17"/>Abiro dwaro Jehova Nyasaye</para>
  <para style="q2" vid="ISA 8:17">ma opando wangʼe ne od Jakobo.</para>
  <para style="q1" vid="ISA 8:17">Abiro keto genona kuome.<verse eid="ISA 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 8:18"/>Eri an kaachiel gi nyithindo ma Jehova Nyasaye osemiya. Wan e ranyisi kod honni e piny Israel koa kuom Jehova Nyasaye Maratego modak e got mar Sayun.<verse eid="ISA 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 8:19"/>Ka ji wachonu ni manyuru rieko kuom ajuoke gi jo-nyakalondo madhum kendo jajni, to donge dhano onego penj wach kuom Nyasaye? Angʼo momiyo upenjo joma otho wach mar joma ngima? <verse eid="ISA 8:19"/><verse number="20" style="v" sid="ISA 8:20"/>To kar timo kamano to nonuru chike Nyasaye kod wechene! Ka ok ginyal wuoyo kaluwore gi wachni to ok ginyal konyo ngʼato. <verse eid="ISA 8:20"/><verse number="21" style="v" sid="ISA 8:21"/>Ginitangni e piny ka githagore kendo ka gidenyo, kendo e kindeno ma kech onurogi, igi nowangʼ matek mi gikwongʼ ruodhgi kod Nyasachgi. <verse eid="ISA 8:21"/><verse number="22" style="v" sid="ISA 8:22"/>Eka ginikulre ka gingʼiyo piny, to chandruok gi mudho kod chuny malit ema ginine kendo noriembgi mawitgi e mudho mandiwa.<verse eid="ISA 8:22"/></para>
  <chapter eid="ISA 8"/>
  <chapter number="9" style="c" sid="ISA 9"/>
  <para style="s1">Osenywolnwa nyathi</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 9:1"/>Kata kamano, joma ne nigi chandruok ok nochak obed gikuyo kendo. E ndalo mosekadho Nyasaye nomiyo piny Zebulun gi piny Naftali odoko pinje michayo, to e ndalo mabiro Jehova Nyasaye notingʼ malo Galili mar ogendini man yo nam modak e tiend aora Jordan:<verse eid="ISA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 9:2"/>Joma wuotho e mudho</para>
  <para style="q2" vid="ISA 9:2">oseneno ler maduongʼ;</para>
  <para style="q1" vid="ISA 9:2">jogo modak e piny man-gi mudho mandiwa,</para>
  <para style="q2" vid="ISA 9:2">ler oserienynegi.<verse eid="ISA 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 9:3"/>Isemiyo piny oyarore</para>
  <para style="q2" vid="ISA 9:3">kendo isemedo morgi,</para>
  <para style="q1" vid="ISA 9:3">mi gibedo gi ilo e nyimi</para>
  <para style="q2" vid="ISA 9:3">mana kaka oganda bedo gi mor e ndalo keyo,</para>
  <para style="q1" vid="ISA 9:3">kendo mana kaka ji bedo gi mor</para>
  <para style="q2" vid="ISA 9:3">ka gipogo gik ma oyaki.<verse eid="ISA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 9:4"/>Mana kaka e kinde mane olo jo-Midian e lweny,</para>
  <para style="q2" vid="ISA 9:4">iseturo jok mane turogi,</para>
  <para style="q1" vid="ISA 9:4">kaachiel gi lodi mane gitingʼo e gokni,</para>
  <para style="q2" vid="ISA 9:4">ma gin ludh ngʼama sandogi.<verse eid="ISA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 9:5"/>Wuoch duto mag lweny</para>
  <para style="q2" vid="ISA 9:5">kaachiel gi lewni motimo remo mag jolweny,</para>
  <para style="q1" vid="ISA 9:5">ibiro ter e mach,</para>
  <para style="q2" vid="ISA 9:5">ginibedi ramoki mar mach.<verse eid="ISA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 9:6"/>Nimar osenywolnwa nyathi,</para>
  <para style="q2" vid="ISA 9:6">adier osemiwa wuowi,</para>
  <para style="q2" vid="ISA 9:6">kendo loch nobedi e lwete.</para>
  <para style="q1" vid="ISA 9:6">Noluong nyinge ni</para>
  <para style="q2" vid="ISA 9:6">Jabura Mahono, Nyasaye Maratego,</para>
  <para style="q2" vid="ISA 9:6">Wuoro Manyaka Chiengʼ kendo Ruodh Kwe.<verse eid="ISA 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 9:7"/>Lochne gi kwe mare nobed</para>
  <para style="q2" vid="ISA 9:7">maonge giko.</para>
  <para style="q1" vid="ISA 9:7">Enobed e kom loch mar Daudi</para>
  <para style="q2" vid="ISA 9:7">kendo e pinyruodhe,</para>
  <para style="q1" vid="ISA 9:7">bende enogure motegno</para>
  <para style="q2" vid="ISA 9:7">ka orite gi adiera kod tim makare,</para>
  <para style="q2" vid="ISA 9:7">chakre kawuono nyaka chiengʼ.</para>
  <para style="q1" vid="ISA 9:7">Jehova Nyasaye Maratego</para>
  <para style="q2" vid="ISA 9:7">notim ma kuom tekone owuon.<verse eid="ISA 9:7"/></para>
  <para style="s1">Mirimb Jehova Nyasaye kuom jo-Israel</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 9:8"/>Jehova Nyasaye oseoro wach ni okecho gi joka Jakobo,</para>
  <para style="q2" vid="ISA 9:8">kendo wachno osechopo ne jo-Israel.<verse eid="ISA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 9:9"/>Ji duto biro winjo wachno</para>
  <para style="q2" vid="ISA 9:9">jo-Efraim kod joma odak Samaria duto,</para>
  <para style="q1" vid="ISA 9:9">ma wuoyo gi sunga</para>
  <para style="q2" vid="ISA 9:9">kod wangʼ teko kawacho niya,<verse eid="ISA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 9:10"/>“Ute mag matafare osepodho,</para>
  <para style="q2" vid="ISA 9:10">to wabiro gedo kendo kod kite mopa,</para>
  <para style="q1" vid="ISA 9:10">bende kata obedo ni yiend ngʼowu osetongʼ</para>
  <para style="q2" vid="ISA 9:10">to wabiro pidho yiend sida kargi.”<verse eid="ISA 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 9:11"/>To Jehova Nyasaye biro miyo wasik Rezin teko mondo oked kodgi,</para>
  <para style="q2" vid="ISA 9:11">adier obiro thuwogi kod wasigu.<verse eid="ISA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 9:12"/>Jo-Aram mane oa yo wuok chiengʼ kod jo-Filistia mane oa yo podho chiengʼ;</para>
  <para style="q2" vid="ISA 9:12">osetieko jo-Israel pep.</para>
  <para style="b" vid="ISA 9:12"/>
  <para style="q1" vid="ISA 9:12">Kata ka magi duto osetimore,</para>
  <para style="q2" vid="ISA 9:12">to mirimbe pod ok orumo kuomgi</para>
  <para style="q2" vid="ISA 9:12">kendo pod odhi nyime mana gikumogi.<verse eid="ISA 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 9:13"/>Kata obedo ni osekumogi kamano to ji pok odwogo ire</para>
  <para style="q2" vid="ISA 9:13">bende pok gimanyo wangʼ Jehova Nyasaye Maratego.<verse eid="ISA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 9:14"/>Omiyo Jehova Nyasaye biro ngʼado joma ogen kod ji ajia mag Israel,</para>
  <para style="q2" vid="ISA 9:14">othith kod odundu e odiechiengʼ achiel;<verse eid="ISA 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 9:15"/>jodongo kod joma ogen e wich jo-Israel,</para>
  <para style="q2" vid="ISA 9:15">to jonabi mapuonjo miriambo e iwe.<verse eid="ISA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 9:16"/>Jotend ogandani osemiyo gilal</para>
  <para style="q2" vid="ISA 9:16">kendo joma otelnegi bende oserwenyo.<verse eid="ISA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 9:17"/>Kuom mano Ruoth Nyasaye ok nobed mamor gi jomatindo</para>
  <para style="q2" vid="ISA 9:17">bende ok nokech nyithi kiye kod mon ma chwogi otho,</para>
  <para style="q1" vid="ISA 9:17">nikech ji duto opongʼ gi richo kendo timo timbe mamono</para>
  <para style="q2" vid="ISA 9:17">bende dhogi opongʼ gi weche mochido.</para>
  <para style="b" vid="ISA 9:17"/>
  <para style="q1" vid="ISA 9:17">To Kata ka magi duto osetimore to mirimbe ok orumo kuomgi</para>
  <para style="q2" vid="ISA 9:17">kendo pod odhi nyime mana gikumogi.<verse eid="ISA 9:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 9:18"/>Adier timbe mamono chalo gi mach maliel;</para>
  <para style="q2" vid="ISA 9:18">ma wangʼo pedo kod kuthe,</para>
  <para style="q1" vid="ISA 9:18">kendo omiyo bungu modinore wangʼ</para>
  <para style="q2" vid="ISA 9:18">mi dhuol iro maduongʼ mochomo malo.<verse eid="ISA 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 9:19"/>Mirimb Jehova Nyasaye Maratego</para>
  <para style="q2" vid="ISA 9:19">biro wangʼo piny,</para>
  <para style="q1" vid="ISA 9:19">kendo ji ema nobed ramoki mar mach,</para>
  <para style="q2" vid="ISA 9:19">kendo onge ngʼat mano ngʼwon-ne nyawadgi.<verse eid="ISA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 9:20"/>E bathe korachwich gibiro mecho</para>
  <para style="q2" vid="ISA 9:20">to pod gidenyo adenya;</para>
  <para style="q1" vid="ISA 9:20">to e bathe koracham gibiro chiemo</para>
  <para style="q2" vid="ISA 9:20">to ok giniyiengʼ.</para>
  <para style="q1" vid="ISA 9:20">Ngʼato ka ngʼato nocham mana ringre nyathine owuon.<verse eid="ISA 9:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="ISA 9:21"/>Manase biro chamo Efraim kendo Efraim nocham Manase;</para>
  <para style="q2" vid="ISA 9:21">giduto ginibed wasik Juda.</para>
  <para style="b" vid="ISA 9:21"/>
  <para style="q1" vid="ISA 9:21">Kata ka magi duto osetimore,</para>
  <para style="q2" vid="ISA 9:21">to mirimbe pod ok orumo kuomgi</para>
  <para style="q2" vid="ISA 9:21">kendo pod odhi nyime mana gikumogi.<verse eid="ISA 9:21"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 9"/>
  <chapter number="10" style="c" sid="ISA 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 10:1"/>Yaye, unune malit un joma loso chike ma ok nikare,</para>
  <para style="q2" vid="ISA 10:1">un joma keto chike maricho mathiro ji,<verse eid="ISA 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 10:2"/>utamo joma odhier e adieragi</para>
  <para style="q2" vid="ISA 10:2">kendo umayo joga ma ochando gik ma onego giyudi,</para>
  <para style="q1" vid="ISA 10:2">omiyo umayo mon ma chwogi otho kendo uyako gige nyithind kiye.<verse eid="ISA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 10:3"/>To initim angʼo chiengʼ ngʼado bura,</para>
  <para style="q2" vid="ISA 10:3">ka masira nowuog kuma bor?</para>
  <para style="q1" vid="ISA 10:3">To en ngʼa manuring udhi ire mondo okonyu?</para>
  <para style="q2" vid="ISA 10:3">Mwandu magu to unuwe kanye?<verse eid="ISA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 10:4"/>Onge gima nodongʼ makmana kirni e nyim joma otwe</para>
  <para style="q2" vid="ISA 10:4">kata podho e lwet janek.</para>
  <para style="b" vid="ISA 10:4"/>
  <para style="q1" vid="ISA 10:4">Kata ka magi duto osetimore,</para>
  <para style="q2" vid="ISA 10:4">to mirimbe ok norum kuomgi,</para>
  <para style="q2" vid="ISA 10:4">kendo pod odhi nyime mana gikumogi.<verse eid="ISA 10:4"/></para>
  <para style="s1">Nyasaye ngʼado bura ne jo-Asuria</para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 10:5"/>Mano kaka unune malit un jo-Asuria,</para>
  <para style="q2" vid="ISA 10:5">luth ma agoyogo ji ka akecho,</para>
  <para style="q2" vid="ISA 10:5">en e luth ma akumogo ji ka mirima omaka!<verse eid="ISA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 10:6"/>En ema aore, mondo odhi oked gi oganda mokia Nyasaye,</para>
  <para style="q2" vid="ISA 10:6">achike mondo omonj joma miya mirima,</para>
  <para style="q2" vid="ISA 10:6">mi oketh mwandugi kendo oyakgi,</para>
  <para style="q1" vid="ISA 10:6">kendo onyon-gi piny mana ka</para>
  <para style="q2" vid="ISA 10:6">chwodho minyono e wangʼ yore.<verse eid="ISA 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 10:7"/>To mae ok e gima oparo timo to bende ma ok e gima ni e pache;</para>
  <para style="q2" vid="ISA 10:7">to dwarone en ketho kendo tieko ogendini mangʼeny.<verse eid="ISA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 10:8"/>Openjo niya, Donge jotenda duto gin ruodhi?<verse eid="ISA 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 10:9"/>Donge Kalno osechalo gi Karkemish?</para>
  <para style="q2" vid="ISA 10:9">Donge Hamath chal mana gi Arpad,</para>
  <para style="q1" vid="ISA 10:9">kendo Samaria mana ka Damaski?<verse eid="ISA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 10:10"/>Mana kaka asemako pinyruodhi mag nyiseche manono,</para>
  <para style="q2" vid="ISA 10:10">ma gin pinyruoth ma kido ma gin-go ngʼeny moloyo mag Jerusalem gi Samaria.<verse eid="ISA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 10:11"/>Donge onego atimne Jerusalem kod nyisechene manono</para>
  <para style="q2" vid="ISA 10:11">mana kaka asetimone Samaria kod kido mage manono?<verse eid="ISA 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 10:12"/>Ka Ruoth Nyasaye osetieko tijene duto mag kumo Got Sayun gi jo-Jerusalem, enowach niya, “Abiro kumo ruodh Asuria nikech timbene mohero mag sunga gi ngʼayi. <verse eid="ISA 10:12"/><verse number="13" style="v" sid="ISA 10:13"/>Nikech owacho niya,</para>
  <para style="q1" vid="ISA 10:13">“ ‘Kuom teko mar bada kod riekona asetimo ma</para>
  <para style="q2" vid="ISA 10:13">nikech an-gi winjo matut.</para>
  <para style="q2" vid="ISA 10:13">Ne aketho tongʼ mag pinje, mi ayako mwandugi mathoth;</para>
  <para style="q1" vid="ISA 10:13">kendo ka ngʼat maratego ne amako ruodhigo.<verse eid="ISA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 10:14"/>Mana kaka ngʼato kawo tongʼ e od winyo,</para>
  <para style="q2" vid="ISA 10:14">e kaka lweta oseyudo kuma mwandu mag pinje nitie;</para>
  <para style="q1" vid="ISA 10:14">mana kaka ji choko tongʼ modongʼ kendgi,</para>
  <para style="q2" vid="ISA 10:14">e kaka ne achoko pinje duto,</para>
  <para style="q1" vid="ISA 10:14">maonge mano mane nyalo kwadho bwombe,</para>
  <para style="q2" vid="ISA 10:14">kata ngʼamo dhoge mondo oywagi.’ ”<verse eid="ISA 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 10:15"/>To bende le disungre ne ngʼat matongʼo kode,</para>
  <para style="q2" vid="ISA 10:15">koso musimeno dinyisre ne ngʼat ma ngʼeto kode?</para>
  <para style="q1" vid="ISA 10:15">Bende arungu digo ngʼato kaonge ngʼama odire,</para>
  <para style="q2" vid="ISA 10:15">koso okwajo diwuothi kaonge ngʼama osirore kode?<verse eid="ISA 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 10:16"/>Kuom mano, Ruoth Nyasaye ma en Jehova Nyasaye Maratego,</para>
  <para style="q2" vid="ISA 10:16">biro kelo tuo kuom jolwenj Asuria marateke;</para>
  <para style="q2" vid="ISA 10:16">kendo tuo norew ringregi ka mach.<verse eid="ISA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 10:17"/>Ler mar Israel nolokre mach,</para>
  <para style="q2" vid="ISA 10:17">Jal Maler margi nolokre mach mangʼangʼni;</para>
  <para style="q1" vid="ISA 10:17">ei odiechiengʼ achiel kende nowangʼ motiek</para>
  <para style="q2" vid="ISA 10:17">pep kuthe kod pedo mag ruodh Asuria.<verse eid="ISA 10:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ISA 10:18"/>Ber mar bungene kod puothene momewo,</para>
  <para style="q2" vid="ISA 10:18">nowangʼ chuth,</para>
  <para style="q1" vid="ISA 10:18">mana ka ngʼat matuo ochamo dende motieko.<verse eid="ISA 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 10:19"/>Kendo yiende mag bungene</para>
  <para style="q2" vid="ISA 10:19">nodongʼ manok,</para>
  <para style="q2" vid="ISA 10:19">ma nyathi matin nyalo kwanogi.<verse eid="ISA 10:19"/></para>
  <para style="s1">Jo-Israel modongʼ</para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 10:20"/>Chiengʼno jo-Israel manok,</para>
  <para style="q2" vid="ISA 10:20">ma nyikwa Jakobo mane odongʼ,</para>
  <para style="q1" vid="ISA 10:20">nowe keto genogi kuom</para>
  <para style="q2" vid="ISA 10:20">ngʼat mane tiekogi,</para>
  <para style="q1" vid="ISA 10:20">to gini gen gi chunygi duto mana kuom Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 10:20">Jal Maler mar Israel.<verse eid="ISA 10:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 10:21"/>Nyikwa Jakobo manok mane odongʼ</para>
  <para style="q2" vid="ISA 10:21">noduog ir Nyasaye Maratego.<verse eid="ISA 10:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 10:22"/>Yaye jo-Israel kata obedo ni ungʼeny,</para>
  <para style="q2" vid="ISA 10:22">ka kwoyo manie dho nam,</para>
  <para style="q2" vid="ISA 10:22">to ji manok kuomu kende ema nodwogi.</para>
  <para style="q1" vid="ISA 10:22">Nimar oseketo bura makare mabiro tieko ji duto.<verse eid="ISA 10:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 10:23"/>Ruoth Nyasaye, ma en Jehova Nyasaye Maratego,</para>
  <para style="q2" vid="ISA 10:23">osechano kelo masira mabiro tieko piny duto.<verse eid="ISA 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 10:24"/>Kuom mano, ma e gima Ruoth Nyasaye ma en Jehova Nyasaye Maratego wacho:</para>
  <para style="q1" vid="ISA 10:24">“Yaye un joga modak Sayun,</para>
  <para style="q2" vid="ISA 10:24">kik ubed maluor nikech jo-Asuria,</para>
  <para style="q1" vid="ISA 10:24">kata obedo ni gichwadou gi ludhegi kendo gigoyou gi rungegi</para>
  <para style="q2" vid="ISA 10:24">kaka jo-Misri ne timo.<verse eid="ISA 10:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 10:25"/>Machiegnini mirimba kodu biro rumo</para>
  <para style="q2" vid="ISA 10:25">kendo koro abiro chomogi tir mondo atiekgi.”<verse eid="ISA 10:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 10:26"/>Jehova Nyasaye Maratego nochwadgi gi del,</para>
  <para style="q2" vid="ISA 10:26">mana kaka e kinde mane ogoyo jo-Midian,</para>
  <para style="q2" vid="ISA 10:26">e lwanda mar Oreb;</para>
  <para style="q1" vid="ISA 10:26">kendo enorie ludhe ewi pi</para>
  <para style="q2" vid="ISA 10:26">mana kaka ne otimo Misri.<verse eid="ISA 10:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 10:27"/>E kindeno tingʼ mapek mane joga nigo</para>
  <para style="q2" vid="ISA 10:27">nogol kuomgi,</para>
  <para style="q1" vid="ISA 10:27">jok mag-gi nogol e ngʼutgi;</para>
  <para style="q1" vid="ISA 10:27">kendo jok notur</para>
  <para style="q2" vid="ISA 10:27">nikech gisebedo machwe.<verse eid="ISA 10:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 10:28"/>Ne aneno ka gidonjo Ayath,</para>
  <para style="q2" vid="ISA 10:28">mi gikalo dier Migron;</para>
  <para style="q1" vid="ISA 10:28">kendo negikawo gigegi Mikmash.<verse eid="ISA 10:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 10:29"/>Kane giwuotho ka gikalo negiwacho niya,</para>
  <para style="q2" vid="ISA 10:29">“Otieno ma kawuono wabiro bworo Geba.”</para>
  <para style="q1" vid="ISA 10:29">Jo-Rama kibaji ogoyo;</para>
  <para style="q2" vid="ISA 10:29">to Gibea ma jo-dala Saulo joringo dhi.<verse eid="ISA 10:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 10:30"/>Yaye, nyi Galim, gouru nduru!</para>
  <para style="q2" vid="ISA 10:30">Yaye, Laish chikuru itu!</para>
  <para style="q1" vid="ISA 10:30">Yaye, Anathoth mar midhiero!<verse eid="ISA 10:30"/></para>
  <para style="q2">
    <verse number="31" style="v" sid="ISA 10:31"/>Jo-Madmena ringo;</para>
  <para style="q2" vid="ISA 10:31">un jo-Gebim ringuru upondi.<verse eid="ISA 10:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 10:32"/>Kawuono gibiro bworo kambigi Nob;</para>
  <para style="q2" vid="ISA 10:32">gibiro kwadho bandera,</para>
  <para style="q1" vid="ISA 10:32">e got mar nyar Sayun,</para>
  <para style="q2" vid="ISA 10:32">machiegni gi got matin mar Jerusalem.<verse eid="ISA 10:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="ISA 10:33"/>Neuru Ruoth Nyasaye ma en Jehova Nyasaye Maratego,</para>
  <para style="q2" vid="ISA 10:33">biro tieko wasike gi teko maduongʼ.</para>
  <para style="q1" vid="ISA 10:33">Yiende ma yamo yiengo nongʼadi,</para>
  <para style="q2" vid="ISA 10:33">to yiende maboyo nolwar piny.<verse eid="ISA 10:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 10:34"/>Obiro ngʼado bunge moyugno kod le;</para>
  <para style="q2" vid="ISA 10:34">bende Lebanon biro podho e nyim,</para>
  <para style="q1" vid="ISA 10:34">Nyasaye Maratego.<verse eid="ISA 10:34"/></para>
  <chapter eid="ISA 10"/>
  <chapter number="11" style="c" sid="ISA 11"/>
  <para style="s1">Bad Yath moa kuom Jesse</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 11:1"/>Nyakwar Jesse moro nowuogi</para>
  <para style="q2" vid="ISA 11:1">mana ka bad yath maloth;</para>
  <para style="q1" vid="ISA 11:1">Kuom tiende, Bade nonyag olemo.<verse eid="ISA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 11:2"/>Roho mar Jehova Nyasaye nobi kuome,</para>
  <para style="q2" vid="ISA 11:2">en Roho makelo rieko gingʼeyo,</para>
  <para style="q1" vid="ISA 11:2">kendo mangʼadone ji rieko kendo miyogi teko,</para>
  <para style="q2" vid="ISA 11:2">bende en Roho mapuonjo ji luoro Jehova Nyasaye,<verse eid="ISA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 11:3"/>kendo enobed mamor gi joma oluoro Jehova Nyasaye.</para>
  <para style="b" vid="ISA 11:3"/>
  <para style="q2" vid="ISA 11:3">Ok nongʼad bura kuom gima oneno giwangʼe,</para>
  <para style="q1" vid="ISA 11:3">kata chiwo parone kod gima owinjo gi ite;<verse eid="ISA 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 11:4"/>to gi adiera nongʼad bura ne joma odhier,</para>
  <para style="q2" vid="ISA 11:4">kendo kuom bura makare enongʼad wach,</para>
  <para style="q1" vid="ISA 11:4">mowinjore ni joma ochando manie piny.</para>
  <para style="q2" vid="ISA 11:4">Dhoge ema nobed luth mogoyogo piny,</para>
  <para style="q2" vid="ISA 11:4">bende wach moa e dhoge ema noneg-go joma timbegi mono.<verse eid="ISA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 11:5"/>Tim makare nobed okanda mare</para>
  <para style="q2" vid="ISA 11:5">kendo adiera nobed misip motweyo e nungone.<verse eid="ISA 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 11:6"/>Ondiek nodag kaachiel gi nyirombe,</para>
  <para style="q2" vid="ISA 11:6">kwach nonind kaachiel gi diel,</para>
  <para style="q1" vid="ISA 11:6">nyaroya kod sibuor nokwa kaachiel,</para>
  <para style="q2" vid="ISA 11:6">kendo nyathi matin nokwagi.<verse eid="ISA 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 11:7"/>Dhiangʼ gi ondiek nokwa kaachiel,</para>
  <para style="q2" vid="ISA 11:7">kendo nyithindgi nonind kanyakla,</para>
  <para style="q2" vid="ISA 11:7">kendo sibuor nocham lum ka rwath.<verse eid="ISA 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 11:8"/>Nyathi madhoth notug machiegni gi dho bur thuond rachier,</para>
  <para style="q2" vid="ISA 11:8">kendo rawera noso lwete e bur thuond fu.<verse eid="ISA 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 11:9"/>Ok ginihiny kata ketho gimoro</para>
  <para style="q2" vid="ISA 11:9">e godena duto maler,</para>
  <para style="q1" vid="ISA 11:9">nimar rieko mar Jehova Nyasaye</para>
  <para style="q2" vid="ISA 11:9">nopongʼ piny,</para>
  <para style="q1" vid="ISA 11:9">mana ka pi mopongʼo nam.<verse eid="ISA 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 11:10"/>Odiechiengno Nyakwar Jesse nochungʼ kaka ranyisi ne ji; mi ogendini nobi ire, kendo kare mar yweyo nobed gi duongʼ. <verse eid="ISA 11:10"/><verse number="11" style="v" sid="ISA 11:11"/>Kindeno Ruoth Nyasaye norie bade kendo koresogo joge mane odongʼ e lwet jo-Asuria, koa Misri mamwalo nyaka mamalo, koa Kush, Elam, Babulon, Hamath to gi chula manie ii nam.<verse eid="ISA 11:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 11:12"/>Enochung bandera ne ogendini</para>
  <para style="q2" vid="ISA 11:12">mi ochok jo-Israel mane oriembi e pinygi;</para>
  <para style="q1" vid="ISA 11:12">kendo enochok jo-Juda kanyakla</para>
  <para style="q2" vid="ISA 11:12">ka ogologi e tunge angʼwen mag piny.<verse eid="ISA 11:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 11:13"/>Nyiego mar jo-Efraim norum</para>
  <para style="q2" vid="ISA 11:13">bende jowasik Juda notieki;</para>
  <para style="q1" vid="ISA 11:13">kendo jo-Efraim ok nochak obed gi nyiego gi jo-Juda,</para>
  <para style="q2" vid="ISA 11:13">kata jo-Juda ok nobed gi ich wangʼ kod jo-Efraim.<verse eid="ISA 11:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 11:14"/>Ginimonj jo-Filistia kagiwuok yo podho chiengʼ,</para>
  <para style="q2" vid="ISA 11:14">kendo giniriwre ka giyako gige ji nyaka yo wuok chiengʼ.</para>
  <para style="q1" vid="ISA 11:14">Ginikaw piny Edom kod Moab,</para>
  <para style="q2" vid="ISA 11:14">Jo-Amon to nobed wasumbinigi.<verse eid="ISA 11:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 11:15"/>Jehova Nyasaye nomi nam makwar mar jo-Misri dwon,</para>
  <para style="q2" vid="ISA 11:15">eka norie lwete e Aora Yufrate,</para>
  <para style="q1" vid="ISA 11:15">mi okel yamo maliet.</para>
  <para style="q2" vid="ISA 11:15">Nopog aorano nyadibiriyo,</para>
  <para style="q2" vid="ISA 11:15">mondo omi ji ongʼade ka girwako mana pat pat.<verse eid="ISA 11:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 11:16"/>Wangʼ yo maduongʼ nobedi ne joge manok</para>
  <para style="q2" vid="ISA 11:16">mane odongʼ koa e piny Asuria,</para>
  <para style="q2" vid="ISA 11:16">mana kaka wangʼ yo nobedone jo-Israel kawuok Misri.<verse eid="ISA 11:16"/></para>
  <chapter eid="ISA 11"/>
  <chapter number="12" style="c" sid="ISA 12"/>
  <para style="s1">Wende mag pak</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 12:1"/>E kindeno iniwach niya,</para>
  <para style="q1" vid="ISA 12:1">“Anapaki, yaye Jehova Nyasaye.</para>
  <para style="q2" vid="ISA 12:1">Kata obedo ni mirima nomaki koda to mirimbino,</para>
  <para style="q2" vid="ISA 12:1">koro oserumo kendo isekweyo chunya.<verse eid="ISA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 12:2"/>Kuom adiera Nyasaye e jaresna;</para>
  <para style="q2" vid="ISA 12:2">anagen kuome kendo ok analuor.</para>
  <para style="q1" vid="ISA 12:2">Jehova Nyasaye, ma en Jehova Nyasaye owuon,</para>
  <para style="q2" vid="ISA 12:2">e tekra kendo wenda;</para>
  <para style="q2" vid="ISA 12:2">kendo osebedo resruokna.”<verse eid="ISA 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 12:3"/>Gi mor malach,</para>
  <para style="q2" vid="ISA 12:3">ibiro tuomo pi koa e sokni mag resruok.<verse eid="ISA 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 12:4"/>E kindeno iniwach niya,</para>
  <para style="q1" vid="ISA 12:4">“Gone Jehova Nyasaye erokamano,</para>
  <para style="q2" vid="ISA 12:4">luong nyinge kendo landuru ni ji duto gik ma osetimo,</para>
  <para style="q2" vid="ISA 12:4">ka uhulo ni nyinge nigi duongʼ moloyo.<verse eid="ISA 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 12:5"/>Werne Jehova Nyasaye nikech osetimo gik madongo;</para>
  <para style="q2" vid="ISA 12:5">kendo mano nyaka ngʼere e piny duto.<verse eid="ISA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 12:6"/>Koguru matek kuwer gi mor,</para>
  <para style="q2" vid="ISA 12:6">un jo-Sayun nimar Jal Maler mar Israel odak e dieru.”<verse eid="ISA 12:6"/></para>
  <chapter eid="ISA 12"/>
  <chapter number="13" style="c" sid="ISA 13"/>
  <para style="s1">Wach mokor kuom Babulon</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1"/>Ma e wach mane Nyasaye onyiso Isaya wuod Amoz e fweny kuom Babulon:<verse eid="ISA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 13:2"/>Chunguru bandera ewi got motwo</para>
  <para style="q2" vid="ISA 13:2">kendo gouru koko,</para>
  <para style="q1" vid="ISA 13:2">gwelgiuru mondo gidonj e dhorangeye joma ogen.<verse eid="ISA 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 13:3"/>Asegolo chik ne joga maler;</para>
  <para style="q2" vid="ISA 13:3">asechiko joga ma jolweny kakecho mondo gitim gima adwaro,</para>
  <para style="q2" vid="ISA 13:3">jogo mamor kaloyo.<verse eid="ISA 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 13:4"/>Winjuru kaka koko wuok e gode;</para>
  <para style="q2" vid="ISA 13:4">machalo mar oganda mangʼongo,</para>
  <para style="q1" vid="ISA 13:4">en koko maduongʼ magore e kind pinjeruodhi,</para>
  <para style="q2" vid="ISA 13:4">machalo mana gi ogendini mangʼeny mochokore kaachiel!</para>
  <para style="q2" vid="ISA 13:4">Jehova Nyasaye Maratego choko oganda mangʼongo mar lweny.<verse eid="ISA 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 13:5"/>Gibiro ka gia e pinje man mabor,</para>
  <para style="q2" vid="ISA 13:5">manie tungʼ piny mogik,</para>
  <para style="q1" vid="ISA 13:5">Jehova Nyasaye kod gige mager mag lweny,</para>
  <para style="q2" vid="ISA 13:5">biro mondo otiekgo pinyno duto.<verse eid="ISA 13:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 13:6"/>Denguru nimar odiechieng Jehova Nyasaye chiegni;</para>
  <para style="q1" vid="ISA 13:6">odiechiengno biro ka gir kethruok maduongʼ</para>
  <para style="q2" vid="ISA 13:6">mawuok e lwet Jehova Nyasaye Maratego.<verse eid="ISA 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 13:7"/>Nikech wachni, lwet ngʼato ka ngʼato ne jony,</para>
  <para style="q2" vid="ISA 13:7">kendo kihondko nogo chuny ji duto ma aa.<verse eid="ISA 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 13:8"/>Kibaji nogogi malich,</para>
  <para style="q2" vid="ISA 13:8">rem gi kuyo bende noneg-gi;</para>
  <para style="q1" vid="ISA 13:8">ginibed gi rem mana ka dhako mamuoch kayo.</para>
  <para style="q2" vid="ISA 13:8">Ngʼato ka ngʼato nongʼi wadgi malich ka midhiero omako.<verse eid="ISA 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 13:9"/>Neuru, odiechieng Jehova Nyasaye biro,</para>
  <para style="q2" vid="ISA 13:9">en odiechiengʼ malich man-gi mirima kod kum mager,</para>
  <para style="q1" vid="ISA 13:9">mabiro weyo piny gunda,</para>
  <para style="q2" vid="ISA 13:9">kendo joricho manie iye.<verse eid="ISA 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 13:10"/>Sulwe mag polo kod lergi ok nonenre.</para>
  <para style="q2" vid="ISA 13:10">Wangʼ chiengʼ nolokre mudho,</para>
  <para style="q1" vid="ISA 13:10">kawuok kendo dwe bende ok norieny.<verse eid="ISA 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 13:11"/>Abiro kumo piny kuom timbene mamono,</para>
  <para style="q2" vid="ISA 13:11">joricho kuom richogi.</para>
  <para style="q1" vid="ISA 13:11">Abiro tieko wich teko ka mar josunga</para>
  <para style="q2" vid="ISA 13:11">kendo abiro thiro sunga mar joma wangʼ-gi tek.<verse eid="ISA 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 13:12"/>Abiro miyo ji doko manok moloyo dhahabu mopwodhi,</para>
  <para style="q2" vid="ISA 13:12">manok mana ka dhahabu ma aa Ofir.<verse eid="ISA 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 13:13"/>Kuom mano Jehova Nyasaye Maratego nomi polo tetni,</para>
  <para style="q2" vid="ISA 13:13">kendo piny noyiengni milengʼre;</para>
  <para style="q2" vid="ISA 13:13">e chiengʼ onogo mar mirimbe mager.<verse eid="ISA 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 13:14"/>Mana kaka mwanda ma jodwar lawo,</para>
  <para style="q2" vid="ISA 13:14">kod rombe maonge jakwath,</para>
  <para style="q1" vid="ISA 13:14">e kaka ngʼato ka ngʼato kuomgi biro dok ir joodgi owuon</para>
  <para style="q2" vid="ISA 13:14">kendo ngʼato ka ngʼato nodog e pinygi.<verse eid="ISA 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 13:15"/>Ngʼato angʼata manomaki nochwo matho,</para>
  <para style="q2" vid="ISA 13:15">jogo duto momaki noneg gi ligangla.<verse eid="ISA 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 13:16"/>Nyithindgi madhoth nochwad piny e wangʼ-gi ka gineno,</para>
  <para style="q2" vid="ISA 13:16">utegi noyaki, kendo mondegi nomak githuon.<verse eid="ISA 13:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 13:17"/>Neuru, anakel jo-Media,</para>
  <para style="q2" vid="ISA 13:17">ma ok dew fedha kendo ok gomb dhahabu mondo omonjgi.<verse eid="ISA 13:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 13:18"/>Gibiro chielo yawuowi matindo gi asere;</para>
  <para style="q2" vid="ISA 13:18">ok giningʼwon-ne nyithindo madhoth,</para>
  <para style="q2" vid="ISA 13:18">bende ok ginikech nyithindo matindo.<verse eid="ISA 13:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 13:19"/>Babulon ma en piny maber moloyo pinjeruodhi duto,</para>
  <para style="q2" vid="ISA 13:19">kendo ma jo-Babulon sungerego,</para>
  <para style="q1" vid="ISA 13:19">Nyasaye nokethi mana kaka noketho Sodom gi Gomora.<verse eid="ISA 13:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 13:20"/>Onge ngʼat manochak obedi e iye</para>
  <para style="q2" vid="ISA 13:20">kata dak kuno e tienge duto mabiro;</para>
  <para style="q1" vid="ISA 13:20">onge ja-Arabu moro manodag kuno;</para>
  <para style="q2" vid="ISA 13:20">bende onge jakwath mano kwa jambe kanyo.<verse eid="ISA 13:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 13:21"/>To mana le mag thim ema nodag kanyo,</para>
  <para style="q2" vid="ISA 13:21">kibwe nopongʼ utegi;</para>
  <para style="q1" vid="ISA 13:21">tula bende nodag kanyo</para>
  <para style="q2" vid="ISA 13:21">kendo nywok nolengʼre kanyo.<verse eid="ISA 13:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 13:22"/>Ondiegi noywagre kuondegi mane gigeno,</para>
  <para style="q2" vid="ISA 13:22">kibwe to noywe e ute mabeyo mag ruoth.</para>
  <para style="q1" vid="ISA 13:22">Ndalo mag Babulon osekayo</para>
  <para style="q2" vid="ISA 13:22">machiegni ma ok notony.<verse eid="ISA 13:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 13"/>
  <chapter number="14" style="c" sid="ISA 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 14:1"/>Jehova Nyasaye biro kecho Jakobo</para>
  <para style="q2" vid="ISA 14:1">mi enochak oyier Israel,</para>
  <para style="q1" vid="ISA 14:1">kendo enomi gidag e pinygi giwegi.</para>
  <para style="q2" vid="ISA 14:1">Jopinje mamoko nobi irgi mi riwre gi od Jakobo.<verse eid="ISA 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 14:2"/>Ogendini nochokgi</para>
  <para style="q2" vid="ISA 14:2">mi duog-gi e gwengegi giwegi.</para>
  <para style="q2" vid="ISA 14:2">Kendo od Israel nolok ogendini jotichgi,</para>
  <para style="q1" vid="ISA 14:2">machwo kod mamon e piny Jehova Nyasaye.</para>
  <para style="q2" vid="ISA 14:2">Ginilok joma noketogi wasumbini,</para>
  <para style="q2" vid="ISA 14:2">obed wasumbinigi mi giti joma ne thirogi.<verse eid="ISA 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3"/>E odiechiengʼ ma Jehova Nyasaye nomiu yweyo kuom chandruok gi masira kod twech malit,<verse eid="ISA 14:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 14:4"/>unugo agoro ni ruodh Babulon ka uwacho niya:</para>
  <para style="q2" vid="ISA 14:4">Neyeuru kaka giko mar jatend ji chalo,</para>
  <para style="q2" vid="ISA 14:4">kendo kaka gerone orumo!<verse eid="ISA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 14:5"/>Jehova Nyasaye oseturo ludh joma timbegi mono,</para>
  <para style="q2" vid="ISA 14:5">ludh loch mar jotelo,<verse eid="ISA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 14:6"/>mane gisandogo ogendini pile gi gero</para>
  <para style="q2" vid="ISA 14:6">ka gigoyogi maonge yweyo,</para>
  <para style="q2" vid="ISA 14:6">kendo ka gitiyogi gi gero malich maonge giko.<verse eid="ISA 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 14:7"/>Pinje duto oyudo yweyo kod kwe</para>
  <para style="q2" vid="ISA 14:7">omiyo ji kok gi mor.<verse eid="ISA 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 14:8"/>Yiend saipras kod sida mag Lebanon</para>
  <para style="q2" vid="ISA 14:8">bende mor kodu kawacho ni:</para>
  <para style="q1" vid="ISA 14:8">“Koro onge ngʼama nochak otongʼwa</para>
  <para style="q2" vid="ISA 14:8">nikech osetieku.”<verse eid="ISA 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 14:9"/>Piny joma otho otuk duto</para>
  <para style="q2" vid="ISA 14:9">ka romoni kidonjo kuno,</para>
  <para style="q1" vid="ISA 14:9">kendo ochiewo chunje joma ne osetho mondo omosi,</para>
  <para style="q2" vid="ISA 14:9">ma gin jogo duto mane jotelo e piny;</para>
  <para style="q2" vid="ISA 14:9">omiyo jogo duto mane ruodhi mag ogendini aa malo e kombegi mag loch.<verse eid="ISA 14:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 14:10"/>Giniwuo gi dwol achiel</para>
  <para style="q2" vid="ISA 14:10">kagiwacho niya,</para>
  <para style="q1" vid="ISA 14:10">“Kara in bende koro isebedo manyap, mana ka wan;</para>
  <para style="q2" vid="ISA 14:10">isebedo machal kodwa.”<verse eid="ISA 14:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 14:11"/>Tekoni duto osedok piny nyaka ei liel,</para>
  <para style="q2" vid="ISA 14:11">kaachiel gi thumbe ma yande iwinjo;</para>
  <para style="q1" vid="ISA 14:11">kudni e pieni minindoe kendo e</para>
  <para style="q2" vid="ISA 14:11">ongedi ma iumorigo.<verse eid="ISA 14:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 14:12"/>Mano kaka isepodho kia e polo,</para>
  <para style="q2" vid="ISA 14:12">yaye ratego, sulwe mar okinyi!</para>
  <para style="q2" vid="ISA 14:12">Oseboli e piny in ma yande itieko ogendini.<verse eid="ISA 14:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 14:13"/>Ne iwacho e chunyi niya,</para>
  <para style="q2" vid="ISA 14:13">“Abiro idho e polo;</para>
  <para style="q1" vid="ISA 14:13">abiro guro lochna malo moyombo sulwe mag Nyasaye;</para>
  <para style="q2" vid="ISA 14:13">kendo anabed e kom duongʼ,</para>
  <para style="q2" vid="ISA 14:13">ewi got mar chokruok, mantiere malo mogik mar got maler.<verse eid="ISA 14:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 14:14"/>Anaidh malo moyombo boche polo;</para>
  <para style="q2" vid="ISA 14:14">kendo anachal gi Nyasaye Man Malo Moloyo.”<verse eid="ISA 14:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 14:15"/>To koro osedwoki piny e bur matut</para>
  <para style="q2" vid="ISA 14:15">nyaka e piny joma otho.<verse eid="ISA 14:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 14:16"/>Ji duto maneni biro ngʼiyi ka giwuoro,</para>
  <para style="q2" vid="ISA 14:16">kendo penjo ka gihum kuom gima osetimore niya,</para>
  <para style="q1" vid="ISA 14:16">“Bende ma e ngʼat mane yiengo piny</para>
  <para style="q2" vid="ISA 14:16">kendo miyo pinjeruodhi tetni,<verse eid="ISA 14:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 14:17"/>ngʼat mane omiyo piny duto odongʼ gunda,</para>
  <para style="q2" vid="ISA 14:17">mane otieko miechgi madongo,</para>
  <para style="q2" vid="ISA 14:17">kendo mane ok nyal gonyo joma osetweyo odog thuchegi?”<verse eid="ISA 14:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 14:18"/>Ruodhi duto mag ogendini onindo komi luor,</para>
  <para style="q2" vid="ISA 14:18">ka moro ka moro ni e liende owuon.<verse eid="ISA 14:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 14:19"/>In to osejwangʼi oko mar buri</para>
  <para style="q2" vid="ISA 14:19">mana ka bad yath mojwangʼ;</para>
  <para style="q1" vid="ISA 14:19">kendo ringri oum gi jogo mosenegi gi ligangla,</para>
  <para style="q2" vid="ISA 14:19">jogo mowiti e bur motimo kite.</para>
  <para style="q2" vid="ISA 14:19">Mana ka ringre joma otho minyono gi tielo,<verse eid="ISA 14:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 14:20"/>ringreni ok noiki kaka noik ruodhi mamoko</para>
  <para style="q2" vid="ISA 14:20">nimar iseketho piny kendo isenego jogi.</para>
  <para style="b" vid="ISA 14:20"/>
  <para style="b" vid="ISA 14:20"/>
  <para style="q1" vid="ISA 14:20">Nyithi joma timbegi mono</para>
  <para style="q2" vid="ISA 14:20">ok nochak oluong nyingegi kendo.<verse eid="ISA 14:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 14:21"/>Yieruru kamoro ma udhi negoe yawuote</para>
  <para style="q2" vid="ISA 14:21">nikech richo mag kweregi;</para>
  <para style="q1" vid="ISA 14:21">ok onego giyud thuolo mar bedo gi loch e piny</para>
  <para style="q2" vid="ISA 14:21">kendo gipongʼe gi miechgi madongo.<verse eid="ISA 14:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 14:22"/>Jehova Nyasaye Maratego wacho niya,</para>
  <para style="q2" vid="ISA 14:22">“Abiro kedo kodgi.</para>
  <para style="q1" vid="ISA 14:22">Anagol nyinge oko gi joge motony gi</para>
  <para style="q2" vid="ISA 14:22">nyithinde kod nyikwaye kuom jo-Babulon.”<verse eid="ISA 14:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 14:23"/>“Abiro loko kar dakne ochal gi kar dak tula,</para>
  <para style="q2" vid="ISA 14:23">kendo kar siany;</para>
  <para style="q2" vid="ISA 14:23">mi anayweye oko kendo tieke chuth.”<verse eid="ISA 14:23"/></para>
  <para style="s1">Wach mokor kuom jo-Asuria</para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 14:24"/>Jehova Nyasaye Maratego osingore niya,</para>
  <para style="q1" vid="ISA 14:24">“Adier, notimre mana kaka asechano</para>
  <para style="q2" vid="ISA 14:24">kendo nobedi mana kaka aseparo.<verse eid="ISA 14:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 14:25"/>Abiro tieko jo-Asuria manie pinya,</para>
  <para style="q2" vid="ISA 14:25">kendo ananyone piny ewi godena.</para>
  <para style="q1" vid="ISA 14:25">Jok mage nogol kuom joga</para>
  <para style="q2" vid="ISA 14:25">kendo tingʼne mapek nogol e gok-gi.”<verse eid="ISA 14:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 14:26"/>Ma e chenro mabiro timore ne piny ngima;</para>
  <para style="q2" vid="ISA 14:26">ma e bat moserie kuom ogendini duto.<verse eid="ISA 14:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 14:27"/>Nimar Jehova Nyasaye Maratego</para>
  <para style="q2" vid="ISA 14:27">osechano mar timo ma,</para>
  <para style="q2" vid="ISA 14:27">en ngʼa manyalo gengʼe?</para>
  <para style="q1" vid="ISA 14:27">Oserieyo bade,</para>
  <para style="q2" vid="ISA 14:27">to en ngʼa manyalo tame?<verse eid="ISA 14:27"/></para>
  <para style="s1">Wach mokor kuom jo-Filistia</para>
  <para style="p">
    <verse number="28" style="v" sid="ISA 14:28"/>Wachni nofwenyore e higa mane ruoth Ahaz othoe.<verse eid="ISA 14:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 14:29"/>Kik ubed gi mor un jo-Filistia</para>
  <para style="q2" vid="ISA 14:29">duto ni luth mane ogougo osetur,</para>
  <para style="q1" vid="ISA 14:29">nimar koa kuom thuondno nonywol thuond rachier</para>
  <para style="q2" vid="ISA 14:29">ma kothe nobed gi kwiri marach.<verse eid="ISA 14:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 14:30"/>Joma odhier moloyo e kind jodhier noyud kuonde kwath</para>
  <para style="q2" vid="ISA 14:30">kendo joma ochando noywe gi kwe.</para>
  <para style="q1" vid="ISA 14:30">To kothi natiek gi kech,</para>
  <para style="q2" vid="ISA 14:30">kendo kejno noneg joma nok modongʼ kuomi.<verse eid="ISA 14:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 14:31"/>Dengi, yaye in rangach! Go nduru, yaye in dala maduongʼ!</para>
  <para style="q2" vid="ISA 14:31">Beduru gi bwok maduongʼ, un jo-Filistia.</para>
  <para style="q1" vid="ISA 14:31">Rumbi mar iro biro kowuok yo nyandwat</para>
  <para style="q2" vid="ISA 14:31">kendo onge kata ngʼato achiel madigni kuomgi.<verse eid="ISA 14:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 14:32"/>Dwoko mane ma onego omi</para>
  <para style="q2" vid="ISA 14:32">joote mag pinyno?</para>
  <para style="q1" vid="ISA 14:32">“Jehova Nyasaye oseguro Sayun,</para>
  <para style="q2" vid="ISA 14:32">kendo kuome ema joge man-gi lit noyudie resruok.”<verse eid="ISA 14:32"/></para>
  <chapter eid="ISA 14"/>
  <chapter number="15" style="c" sid="ISA 15"/>
  <para style="s1">Wach mokor nibiro timore ne jo-Moab</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 15:1"/>Wach nofwenyore kuom jo-Moab ni:</para>
  <para style="q1" vid="ISA 15:1">Ar manie Moab okethi,</para>
  <para style="q2" vid="ISA 15:1">omuke ei otieno achiel!</para>
  <para style="q1" vid="ISA 15:1">Kir manie Moab bende okethi,</para>
  <para style="q2" vid="ISA 15:1">omuke ei otieno achiel!<verse eid="ISA 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 15:2"/>Jo-Dibon dhiyo e kargi mar lemo,</para>
  <para style="q2" vid="ISA 15:2">gidhiyo e hembko mag-gi mondo giywagi;</para>
  <para style="q1" vid="ISA 15:2">kendo jo-Moab goyo nduru nikech Nebo gi Medeba osekethi.</para>
  <para style="q2" vid="ISA 15:2">Ngʼato ka ngʼato oliel wiye kod tike.<verse eid="ISA 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 15:3"/>E yore, girwako pien gugru;</para>
  <para style="q2" vid="ISA 15:3">to ewi udi kod laru maduongʼ,</para>
  <para style="q2" vid="ISA 15:3">giduto giywak ka gidengo kendo gingʼielore e lowo.<verse eid="ISA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 15:4"/>Jo-Heshbon kod jo-Eleale ywak,</para>
  <para style="q2" vid="ISA 15:4">kendo ywakgi winjore nyaka Jahaz.</para>
  <para style="q1" vid="ISA 15:4">Kuom mano jolweny mag jo-Moab ywak</para>
  <para style="q2" vid="ISA 15:4">kendo kihondko omakogi.<verse eid="ISA 15:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 15:5"/>Chunya ywago jo-Moab;</para>
  <para style="q2" vid="ISA 15:5">nimar ogandane ringo kadhi pondo Zoar,</para>
  <para style="q2" vid="ISA 15:5">ma gichopo nyaka Eglath Shelishiya.</para>
  <para style="q1" vid="ISA 15:5">Gidhi ka giluwo yo mochomo Luhith ka giywak,</para>
  <para style="q2" vid="ISA 15:5">e yo madhi Horonaim giywak malit nikech kethruokgi.<verse eid="ISA 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 15:6"/>Pige mag Nimrim oseduono,</para>
  <para style="q2" vid="ISA 15:6">kendo lum bende osener,</para>
  <para style="q1" vid="ISA 15:6">kendo oboke orumo,</para>
  <para style="q2" vid="ISA 15:6">maonge gimoro amora modongʼ ka ngʼich.<verse eid="ISA 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 15:7"/>Omiyo mwandu mane giseloso</para>
  <para style="q2" vid="ISA 15:7">kendo kano negitingʼo magingʼadogo Holo ma Omburi otiye.<verse eid="ISA 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 15:8"/>Ywakgi winjore nyaka e tongʼ Moab,</para>
  <para style="q1" vid="ISA 15:8">nduru margi chopo nyaka Eglaim,</para>
  <para style="q2" vid="ISA 15:8">kendo dengo margi landore nyaka Beer Elim.<verse eid="ISA 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 15:9"/>Pige mag Dimon opongʼ gi remo,</para>
  <para style="q2" vid="ISA 15:9">to kata kamano named kelo masiche ne Dimon,</para>
  <para style="q1" vid="ISA 15:9">ne joge maringo koa Moab</para>
  <para style="q2" vid="ISA 15:9">mondo opondi kod jogo modongʼ e pinyno nomak gi sibuor.<verse eid="ISA 15:9"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 15"/>
  <chapter number="16" style="c" sid="ISA 16"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 16:1"/>Kawuru rombe koa Sela</para>
  <para style="q2" vid="ISA 16:1">kungʼadogo thim mondo uterne ruodh piny,</para>
  <para style="q2" vid="ISA 16:1">modak e got mar Nyar Sayun kaka gir chiwo.<verse eid="ISA 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 16:2"/>Mana kaka nyithind winy</para>
  <para style="q2" vid="ISA 16:2">moketh odgi mafuyo koni gi koni,</para>
  <para style="q1" vid="ISA 16:2">e kaka mond jo-Moab nodongʼ</para>
  <para style="q2" vid="ISA 16:2">e kar otuodo manie Aora Arnon.<verse eid="ISA 16:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 16:3"/>“Ngʼadnwauru rieko,</para>
  <para style="q2" vid="ISA 16:3">nyiswa gima onego watim.</para>
  <para style="q1" vid="ISA 16:3">Pandwauru mondo kik yudwa</para>
  <para style="q2" vid="ISA 16:3">kendo panduru jowa moringo lweny,</para>
  <para style="q2" vid="ISA 16:3">kendo kik uyie mondo omaki joma oseringo.<verse eid="ISA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 16:4"/>We jo-Moab moringo lweny odag kodu</para>
  <para style="q2" vid="ISA 16:4">kendo bednegi ragengʼ kuom jakethgi.”</para>
  <para style="b" vid="ISA 16:4"/>
  <para style="q1" vid="ISA 16:4">Ngʼatno masandogi tekone norum,</para>
  <para style="q2" vid="ISA 16:4">kendo kethruok notieki;</para>
  <para style="q2" vid="ISA 16:4">mi jathir ji nolal nono e piny.<verse eid="ISA 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 16:5"/>Kuom hera, loch nogur;</para>
  <para style="q2" vid="ISA 16:5">kuom adiera ngʼato nobedie lojno,</para>
  <para style="q1" vid="ISA 16:5">ngʼatno nowuogi e od Daudi,</para>
  <para style="q2" vid="ISA 16:5">ma en ngʼat mangʼado bura kare,</para>
  <para style="q2" vid="ISA 16:5">kendo ojiwo timbe mag adieri.<verse eid="ISA 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 16:6"/>Wasewinjo sunga mar Moab,</para>
  <para style="q2" vid="ISA 16:6">kaka otingʼore malo gi wuondruok,</para>
  <para style="q1" vid="ISA 16:6">kopongʼ gi sunga kod achaya,</para>
  <para style="q2" vid="ISA 16:6">to dhialruokneno en kayiem nono.<verse eid="ISA 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 16:7"/>Kuom mano jo-Moab dengo,</para>
  <para style="q2" vid="ISA 16:7">gidengo kaachiel nikech Moab.</para>
  <para style="q2" vid="ISA 16:7">Ywaguru kendo ubed gi lit nikech jo-Kir Hareseth.<verse eid="ISA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 16:8"/>Puothe mag Heshbon ner,</para>
  <para style="q2" vid="ISA 16:8">kaachiel gi mzabibu mag Sibma.</para>
  <para style="q1" vid="ISA 16:8">Jotelo mag ogendini oseketho divai mane berie moloyo,</para>
  <para style="q2" vid="ISA 16:8">mane ndalo moro ochopo nyaka Jazer,</para>
  <para style="q1" vid="ISA 16:8">kendo olandore nyaka kar ongoro.</para>
  <para style="q2" vid="ISA 16:8">Bedene nolawore malach mochopo nyaka nam.<verse eid="ISA 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 16:9"/>Omiyo aywak mana kaka Jazer ywak</para>
  <para style="q2" vid="ISA 16:9">nikech mzabibu mag Sibma.</para>
  <para style="q1" vid="ISA 16:9">Yaye Heshbon, yaye Eleale,</para>
  <para style="q2" vid="ISA 16:9">analuoku gi pi wangʼ.</para>
  <para style="q1" vid="ISA 16:9">Mor ma un-go nikech olembeu mosechiek</para>
  <para style="q2" vid="ISA 16:9">kendo nikech keyo maru osetieki.<verse eid="ISA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 16:10"/>Mor kod ilo norum chuth e puotheu mag olemo</para>
  <para style="q2" vid="ISA 16:10">kendo onge wer mano wer kata koko manogo e puotheu mag mzabibu;</para>
  <para style="q1" vid="ISA 16:10">bende onge ngʼato angʼata manochak obi mzabibu e kuonde mag bicho,</para>
  <para style="q2" vid="ISA 16:10">nimar asetieko mahu mar mor ma un-go.<verse eid="ISA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 16:11"/>Chunya ywago Moab mana kaywak mar nyatiti,</para>
  <para style="q2" vid="ISA 16:11">kendo chunya ma iye ywago Kir Hareseth.<verse eid="ISA 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 16:12"/>Ka Moab ochopo kuonde hembko mag misengini,</para>
  <para style="q2" vid="ISA 16:12">to ochandore achanda nono;</para>
  <para style="q1" vid="ISA 16:12">to kata ka odonjo e kare mar lemo,</para>
  <para style="q2" vid="ISA 16:12">to en mana kayiem nono.<verse eid="ISA 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 16:13"/>Ma e wach ma Jehova Nyasaye nosewacho kuom Moab. <verse eid="ISA 16:13"/><verse number="14" style="v" sid="ISA 16:14"/>To sani Jehova Nyasaye wacho niya: Kapok okadho higni adek, mana kaka ja-otongʼo tiyo kaparo hignige adek ma tije rumogo e kaka duongʼ mar Moab kaachiel gi joge mangʼeny duto none achaya, bende joge ma notony nobed manok kendo mayom yom.<verse eid="ISA 16:14"/></para>
  <chapter eid="ISA 16"/>
  <chapter number="17" style="c" sid="ISA 17"/>
  <para style="s1">Wach mokor nibiro timore ne Damaski</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 17:1"/>Ma e wach mane okor kuom Damaski:</para>
  <para style="q1" vid="ISA 17:1">“Neuru, Damaski ok nochak obed dala maduongʼ,</para>
  <para style="q2" vid="ISA 17:1">to obiro bedo pidhe mag gik mokethi.<verse eid="ISA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 17:2"/>Mier madongo mag Aroer nodongʼ gunda</para>
  <para style="q2" vid="ISA 17:2">nodongʼ kar nindo jamni kendo onge ngʼama nobwog-gi.<verse eid="ISA 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 17:3"/>Dala maduongʼ mochiel nolal nono koa Efraim</para>
  <para style="q2" vid="ISA 17:3">nyaka kom loch man Damaski;</para>
  <para style="q1" vid="ISA 17:3">jo-Aram manok modongʼ tekogi norum</para>
  <para style="q2" vid="ISA 17:3">mana kaka mar jo-Israel norumo,”</para>
  <para style="q1" vid="ISA 17:3">Jehova Nyasaye Maratego ema owacho.<verse eid="ISA 17:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 17:4"/>“E kindeno duongʼ mar Jakobo nolal;</para>
  <para style="q2" vid="ISA 17:4">kendo nodok manok.<verse eid="ISA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 17:5"/>Nochal mana ka jakeyo mabeto cham</para>
  <para style="q2" vid="ISA 17:5">choko kamoro achiel bangʼe okayogi gi lwete mana kaka jahulo,</para>
  <para style="q2" vid="ISA 17:5">hulo cham e Holo mar Refaim.<verse eid="ISA 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 17:6"/>Kaka cham dongʼ e puodho bangʼ hulo,</para>
  <para style="q2" vid="ISA 17:6">e kaka olembe mag zeituni nodongʼ e yath kosepon,</para>
  <para style="q1" vid="ISA 17:6">olembe ariyo kata adek nyalo dongʼ ewi bede yath mamalo</para>
  <para style="q2" vid="ISA 17:6">kendo olembe angʼwen kata abich nyalo dongʼ e bedene monyaa,”</para>
  <para style="q2" vid="ISA 17:6">Jehova Nyasaye ma Nyasach Israel ema owacho.<verse eid="ISA 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 17:7"/>E kindeno ji nongʼi Jachwechgi</para>
  <para style="q2" vid="ISA 17:7">kendo gichom wengegi kuom Jal Maler mar Israel.<verse eid="ISA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 17:8"/>Ok gini ngʼi kende mag misango,</para>
  <para style="q2" vid="ISA 17:8">kata kuom tije mag lwetgi,</para>
  <para style="q1" vid="ISA 17:8">kendo ok ginibed gi luor ne sirni mag Ashera</para>
  <para style="q2" vid="ISA 17:8">kata ne kende miwangʼoe ubani ma lwetgi oloso.<verse eid="ISA 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 17:9"/>E kindeno miechgi madongo mochiel motegno, mane giweyo nikech jo-Israel, biro chalo gi kuonde mojwangʼ motimo bunge kod buya kendo giduto ginidongʼ gunda.<verse eid="ISA 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 17:10"/>Wiyi osewil gi Nyasachi ma jaresni;</para>
  <para style="q2" vid="ISA 17:10">adier ok iseparo Lwanda ma en ohingani.</para>
  <para style="q1" vid="ISA 17:10">Kuom mano kata ka ipidho cham mabeyo</para>
  <para style="q2" vid="ISA 17:10">kendo ipidho mzabibu migolo e pinje ma oko,<verse eid="ISA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 17:11"/>kata obedo ni chiengʼ mipidhogieno ema gidongoe</para>
  <para style="q2" vid="ISA 17:11">kendo okinyi ma ipidhogieno ema gichiewoe,</para>
  <para style="q1" vid="ISA 17:11">onge gima niyudi to makmana chandruok kod rem ma ok rum.<verse eid="ISA 17:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 17:12"/>Yaye, winjuru mahu mar ogendini mangʼeny,</para>
  <para style="q2" vid="ISA 17:12">giwuo mana ka apaka mar nam!</para>
  <para style="q2" vid="ISA 17:12">Yaye, winjuru koko mar ji, ka gimor mana ka apaka mar nam!<verse eid="ISA 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 17:13"/>Kata obedo ni gimor mana ka pi mogingore,</para>
  <para style="q2" vid="ISA 17:13">to ka akwerogi to giniring ma gidhi mabor,</para>
  <para style="q1" vid="ISA 17:13">mana machal gi mihudhwe mipiedho e gode ma yamo tero,</para>
  <para style="q2" vid="ISA 17:13">kata ka yamo mar kalausi.<verse eid="ISA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 17:14"/>Kochopo odhiambo, kibaji nogogi apoya nono!</para>
  <para style="q2" vid="ISA 17:14">To kapok piny oru, to ginilal nono!</para>
  <para style="q1" vid="ISA 17:14">Ma e pok mar joma mayowa,</para>
  <para style="q2" vid="ISA 17:14">kendo en e pok mar joma yakowa.<verse eid="ISA 17:14"/></para>
  <chapter eid="ISA 17"/>
  <chapter number="18" style="c" sid="ISA 18"/>
  <para style="s1">Wach mokor nibiro timore ne Kush</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 18:1"/>Inine malit in piny man-gi bede</para>
  <para style="q2" vid="ISA 18:1">mag aore mamor mag Kush,<verse eid="ISA 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 18:2"/>ma oro jootene ka ngʼado nam</para>
  <para style="q2" vid="ISA 18:2">gi yiedhi mohondhi gi oundho.</para>
  <para style="b" vid="ISA 18:2"/>
  <para style="q1" vid="ISA 18:2">Dhiuru, un joote ma tiendgi yot ir oganda ma roboche kendo ma dendgi poth,</para>
  <para style="q2" vid="ISA 18:2">moluor kuonde duto, oganda ma tokgi tek mawacho dhok mopogore,</para>
  <para style="q2" vid="ISA 18:2">kendo ma pinygi aore opogo migawo.<verse eid="ISA 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 18:3"/>Un ji duto manie piny, un mudak e piny,</para>
  <para style="q1" vid="ISA 18:3">ka bandech lweny otingʼ malo ewi gode,</para>
  <para style="q2" vid="ISA 18:3">to ununene kendo ka turumbete noywagi to unuwinje.<verse eid="ISA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 18:4"/>Ma e gima Jehova Nyasaye wachona:</para>
  <para style="q2" vid="ISA 18:4">Abiro lingʼ thi kendo nangʼichi gie kar dakna mana,</para>
  <para style="q1" vid="ISA 18:4">kaka piny kwe mos ka chiengʼ</para>
  <para style="q2" vid="ISA 18:4">liet kendo kaka rumbi mar tho moko ndalo keyo.<verse eid="ISA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 18:5"/>E kinde ma keyo podi ma mzabibu osemoyo</para>
  <para style="q2" vid="ISA 18:5">kendo ma olembgi osechiek,</para>
  <para style="q1" vid="ISA 18:5">enongʼadgi oko kod ratongʼ</para>
  <para style="q2" vid="ISA 18:5">kendo enongʼad bedene molawore.<verse eid="ISA 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 18:6"/>Giduto nowegi ne achudhe mae gode kendo ne le mag bungu,</para>
  <para style="q2" vid="ISA 18:6">winy nochamgi e ndalo mag oro duto,</para>
  <para style="q2" vid="ISA 18:6">ka le mag bungu to chamogi e ndalo chwiri duto.<verse eid="ISA 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 18:7"/>E kindeno chiwo noter e nyim Jehova Nyasaye Maratego</para>
  <para style="q1" vid="ISA 18:7">koa kuom oganda ma roboche,</para>
  <para style="q2" vid="ISA 18:7">kendo ma dendgi poth, moluor kuonde duto,</para>
  <para style="q1" vid="ISA 18:7">oganda ma tokgi tek mawacho dhok mopogore</para>
  <para style="q2" vid="ISA 18:7">kendo ma pinygi aore opogo.</para>
  <para style="m" vid="ISA 18:7">Chiwogi nokel ewi Got Sayun kama Nying Jehova Nyasaye Maratego nitie.<verse eid="ISA 18:7"/></para>
  <chapter eid="ISA 18"/>
  <chapter number="19" style="c" sid="ISA 19"/>
  <para style="s1">Wach mokor kuom Misri</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 19:1"/>Ma e wach mane okor kuom Misri:</para>
  <para style="q1" vid="ISA 19:1">To neuru, Jehova Nyasaye biro piyo piyo</para>
  <para style="q2" vid="ISA 19:1">koa e boche polo kochomo Misri.</para>
  <para style="q1" vid="ISA 19:1">Nyiseche mopa mag Misri kirni</para>
  <para style="q2" vid="ISA 19:1">e nyime kendo jo-Misri dhi ka rumo.<verse eid="ISA 19:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 19:2"/>“Abiro thuwo jo-Misri kendgi,</para>
  <para style="q2" vid="ISA 19:2">ngʼato noked mana gowadgi,</para>
  <para style="q2" vid="ISA 19:2">joma odak mokiewo noked kendgi,</para>
  <para style="q2" vid="ISA 19:2">mier madongo noked kendgi,</para>
  <para style="q2" vid="ISA 19:2">kendo pinjeruodhi bende noked kendgi.<verse eid="ISA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 19:3"/>Chuny jo-Misri nonyosre</para>
  <para style="q2" vid="ISA 19:3">kendo anaketh gik moko duto ma gichano timo;</para>
  <para style="q1" vid="ISA 19:3">ginidwar wach kuom nyiseche mopa kod lang chunje mane osetho,</para>
  <para style="q2" vid="ISA 19:3">ajuoke kod nyakalondo.<verse eid="ISA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 19:4"/>Abiro chiwo jo-Misri</para>
  <para style="q2" vid="ISA 19:4">e lwet jatelo mager,</para>
  <para style="q1" vid="ISA 19:4">kendo ruoth makwiny ema nobed gi loch kuomgi.”</para>
  <para style="q2" vid="ISA 19:4">Ruoth Nyasaye ma en Jehova Nyasaye Maratego ema owacho.<verse eid="ISA 19:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 19:5"/>Pige mag aora biro dwono,</para>
  <para style="q2" vid="ISA 19:5">kendo kuonde ma pi luwo biro two ma bar okak.<verse eid="ISA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 19:6"/>Kuonde ma pi luwo nodungʼ marach;</para>
  <para style="q2" vid="ISA 19:6">bede aore mag Misri nodwon mi two.</para>
  <para style="q2" vid="ISA 19:6">Odundu kod se biro ner,<verse eid="ISA 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 19:7"/>kaachiel gi gik moti mopidhie cham e bath aora Nael</para>
  <para style="q2" vid="ISA 19:7">notwo ma bar okak kendo cham bende noner molal nono.<verse eid="ISA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 19:8"/>Jolupo nobed gi lit mi ywagi,</para>
  <para style="q2" vid="ISA 19:8">to jogo duto matego golowu e aora Nael;</para>
  <para style="q2" vid="ISA 19:8">kod joma chiko gokgi e pi nosienyre.<verse eid="ISA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 19:9"/>Jogo machweyo lewni mag tworo nobed mool</para>
  <para style="q2" vid="ISA 19:9">kendo joma chweyo gik mabeyo chunygi nonyosre.<verse eid="ISA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 19:10"/>Jogo maloso lewni nobed gi parruok,</para>
  <para style="q2" vid="ISA 19:10">kendo jogo mayudo misara nobed gi chuny mool.<verse eid="ISA 19:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 19:11"/>Jotelo mag Zoan gin ji mofuwo,</para>
  <para style="q2" vid="ISA 19:11">kendo jongʼad rieko mag Farao chiwo paro manono.</para>
  <para style="q1" vid="ISA 19:11">Ere kaka iwacho ne Farao niya,</para>
  <para style="q2" vid="ISA 19:11">“An achiel kuom jorieko, ma nopuonjore kuom ruodhi machon?”<verse eid="ISA 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 19:12"/>Koro ere jogi mariekgo?</para>
  <para style="q2" vid="ISA 19:12">Koro ginyisiane mondo ingʼe gima Jehova Nyasaye Maratego chano timo ne Misri.<verse eid="ISA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 19:13"/>Jotend Zoan osebedo joma ofuwo,</para>
  <para style="q2" vid="ISA 19:13">jodong Memfis osewuondi;</para>
  <para style="q2" vid="ISA 19:13">kendo jotelogi osewito jo-Misri.<verse eid="ISA 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 19:14"/>Jehova Nyasaye osejwangʼogi ma chunygi ool;</para>
  <para style="q2" vid="ISA 19:14">gimiyo jo-Misri tangni e gik moko duto ma otimo,</para>
  <para style="q2" vid="ISA 19:14">machal mana ka jakongʼo madwanyore kama ongʼokie.<verse eid="ISA 19:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 19:15"/>Onge gimoro amora ma Misri nyalo timo maber,</para>
  <para style="q2" vid="ISA 19:15">bedni en jatelo kata ngʼama otelne,</para>
  <para style="q2" vid="ISA 19:15">obed bad othith kata odundu.<verse eid="ISA 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 19:16"/>E kindeno jo-Misri nochal mana ka mon. Gibiro kirni ka luoro omakogi ka gineno kum maa e lwet Jehova Nyasaye Maratego. <verse eid="ISA 19:16"/><verse number="17" style="v" sid="ISA 19:17"/>Piny Juda nomi luoro maduongʼ omak jo-Misri. Ji duto ma nowinj nying Juda kihondko nogo, nikech gima Jehova Nyasaye Maratego osechano timonegi.<verse eid="ISA 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 19:18"/>E kindeno mier madongo abich mag Misri nowuo gi dho jo-Kanaan kendo ginikwongʼre ni ginitine Jehova Nyasaye Maratego. Achiel kuomgi noluongi ni Dala Maduongʼ mar Kethruok.<verse eid="ISA 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 19:19"/>E kindeno kendo mar misango mar Jehova Nyasaye nobedi e dier piny Misri kendo kidi mar rapar mar Jehova Nyasaye noket e tongʼne. <verse eid="ISA 19:19"/><verse number="20" style="v" sid="ISA 19:20"/>Obiro bedo ranyisi kendo rapar ne Jehova Nyasaye Maratego e piny Misri. Ka giywagore ne Jehova Nyasaye nikech joma sandogi, to obiro oronegi jawar kendo jakony, mi enoresgi. <verse eid="ISA 19:20"/><verse number="21" style="v" sid="ISA 19:21"/>Kuom mano Jehova Nyasaye noyangre maler mi jo-Misri ngʼeye, kendo e kindeno giniyie kuom Jehova Nyasaye. Gibiro lame ka gitimone misengini kod chiwo mag cham; ka gisingore ne Jehova Nyasaye kendo gichopo singruokno. <verse eid="ISA 19:21"/><verse number="22" style="v" sid="ISA 19:22"/>Jehova Nyasaye biro goyo Misri gi masiche, nogogi kendo bangʼe nochang-gi. Giniduogi ir Jehova Nyasaye, mi nowinj kwayogi kendo ochang-gi.<verse eid="ISA 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 19:23"/>E kindeno yo maduongʼ nobedi koa Misri nyaka Asuria. Jo-Asuria nodhi Misri kendo jo-Misri bende nodhi Asuria. Jo-Misri kod jo-Asuria nolam kaachiel. <verse eid="ISA 19:23"/><verse number="24" style="v" sid="ISA 19:24"/>E kindeno Israel nobed piny mar adek ka giriwore gi Misri kod Asuria mondo gibed gweth ne piny. <verse eid="ISA 19:24"/><verse number="25" style="v" sid="ISA 19:25"/>Jehova Nyasaye Maratego biro gwedhogi kawacho niya, “Agwedho jo-Misri ma gin joga, jo-Asuria ma gin chwechna kod jo-Israel ma gin girkeni mara.”<verse eid="ISA 19:25"/></para>
  <chapter eid="ISA 19"/>
  <chapter number="20" style="c" sid="ISA 20"/>
  <para style="s1">Wach mokor nibiro timore ne Misri kod Kush</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1"/>E higano mane Sargon ruodh Asuria nooro jatend lweny maduongʼ, nodhi Ashdod mi omonje kendo okawe, <verse eid="ISA 20:1"/><verse number="2" style="v" sid="ISA 20:2"/>kendo e ndalono ema ne Jehova Nyasaye owuoyo kokalo kuom Isaya wuod Amoz. Nowachone niya, “Gony pien gugru manie dendi kendo ilony wuocheni oko e tiendi.” Kendo notimo kamano kowuotho duk gi tiende nono.<verse eid="ISA 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 20:3"/>Eka Jehova Nyasaye nowacho niya, “Mana kaka jatichna Isaya oselonyore duk mowuotho gi tiende nono kuom higni adek, kobedo ranyisi kuom gima timore ne Misri kod Kush, <verse eid="ISA 20:3"/><verse number="4" style="v" sid="ISA 20:4"/>omiyo ruodh Asuria biro sembo jo-Misri kod jo-Kush ma osemako duto, jomatindo kod jomadongo. Giniwuoth duge gi tiendegi nono, ka siandagi neno, mi mano nobed wichkuot ni jo-Misri. <verse eid="ISA 20:4"/><verse number="5" style="v" sid="ISA 20:5"/>Ji mane oketo genoni kuom jo-Kush, kendo tingʼore malo nikech jo-Misri nobed gi luoro kod wichkuot. <verse eid="ISA 20:5"/><verse number="6" style="v" sid="ISA 20:6"/>E kindeno jogo modak e dho namni nowach ni, ‘Neuru gima osetimore ne joma waketo genowa kuomgi, joma ne waringo kuomgi mondo okonywa kendo oreswa e lwet ruodh Asuria! To koro, ere kaka wanatony?’ ”<verse eid="ISA 20:6"/></para>
  <chapter eid="ISA 20"/>
  <chapter number="21" style="c" sid="ISA 21"/>
  <para style="s1">Wach mokor nibiro timore ne Babulon</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 21:1"/>Wach mokor kuom piny Ongoro manie dho Nam:</para>
  <para style="q2" vid="ISA 21:1">Mana kaka kalausi mager kudho koluwo piny man yo milambo,</para>
  <para style="q2" vid="ISA 21:1">e kaka joma monjou biro wuok e piny motwo, piny masira.<verse eid="ISA 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 21:2"/>Fweny malich osenyisa ni:</para>
  <para style="q2" vid="ISA 21:2">Jandhoko biro ndhoko, to jayeko biro yeko.</para>
  <para style="q1" vid="ISA 21:2">Elam mondo omonje! Media mondo olwore koni gi koni!</para>
  <para style="q2" vid="ISA 21:2">Abiro tieko lit duto mane okelo.<verse eid="ISA 21:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 21:3"/>Kaneno magi to apuodora ka rem rama e ringra,</para>
  <para style="q2" vid="ISA 21:3">rem rama mana ka dhako mamuoch kayo;</para>
  <para style="q1" vid="ISA 21:3">kibaji goya kuom gik mawinjo</para>
  <para style="q2" vid="ISA 21:3">kendo midhiero omaka kuom gik ma aneno.<verse eid="ISA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 21:4"/>Chunya bwok, denda tetni nikech luoro;</para>
  <para style="q2" vid="ISA 21:4">gombo ma an-go mondo piny imre oselokorena masira.<verse eid="ISA 21:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 21:5"/>Negiiko mesa mondo gimethi kendo gichiem,</para>
  <para style="q2" vid="ISA 21:5">to apoya nono negipo kinyisogi,</para>
  <para style="q2" vid="ISA 21:5">ni mondo giik gigegi mag lweny.<verse eid="ISA 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 21:6"/>Ruoth Nyasaye wachona niya,</para>
  <para style="q1" vid="ISA 21:6">“Dhiyo mondo iket jangʼicho</para>
  <para style="q2" vid="ISA 21:6">mondo odwok wach kuom gik moneno.<verse eid="ISA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 21:7"/>Ka oneno geche lweny miywayo gi farese,</para>
  <para style="q1" vid="ISA 21:7">gi joma oidho punde kata ngamia,</para>
  <para style="q2" vid="ISA 21:7">to oikre kendo obed motangʼ.”<verse eid="ISA 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 21:8"/>Kendo jangʼicho nokok niya,</para>
  <para style="q1" vid="ISA 21:8">“Yaye Ruoth Nyasacha pile ka pile asebedo kar ngʼicho,</para>
  <para style="q2" vid="ISA 21:8">kendo otieno asiko e kara mar tich.<verse eid="ISA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 21:9"/>Ero ngʼato biro koidho gach lweny miywayo gi farese.</para>
  <para style="q2" vid="ISA 21:9">To ngʼatno nowacho niya,</para>
  <para style="q1" vid="ISA 21:9">‘Babulon osepodho, adier osepodho,</para>
  <para style="q2" vid="ISA 21:9">adier osepodho,</para>
  <para style="q2" vid="ISA 21:9">kendo nyisechene manono osetur matindo tindo!’ ”<verse eid="ISA 21:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 21:10"/>Yaye ogandana mosenyon piny</para>
  <para style="q2" vid="ISA 21:10">ka cham midino anyisou gima asewinjo koa kuom Jehova Nyasaye Maratego,</para>
  <para style="q2" vid="ISA 21:10">ma Nyasach Israel.<verse eid="ISA 21:10"/></para>
  <para style="s1">Wach mokor ni biro timore ne Edom</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 21:11"/>Wach mokor kuom Duma:</para>
  <para style="q1" vid="ISA 21:11">Ngʼato obiro ira koa Seir, kendo openja monwore niya,</para>
  <para style="q2" vid="ISA 21:11">“Jarito odongʼ seche adi mondo piny oru?</para>
  <para style="q2" vid="ISA 21:11">Jarito odongʼ seche adi mondo piny oru?”<verse eid="ISA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 21:12"/>Eka jarito nodwoko niya,</para>
  <para style="q2" vid="ISA 21:12">“Piny chiegni ru, to otieno bende biro chopo.</para>
  <para style="q2" vid="ISA 21:12">Kidwaro penjo, to penji kendo imed penjo.”<verse eid="ISA 21:12"/></para>
  <para style="s1">Wach mokor nibiro timore ne jo-Arabu</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 21:13"/>Wach mokor kuom jo-Arabu:</para>
  <para style="q1" vid="ISA 21:13">Un jo-Dedan ma jo-ohala mawuotho</para>
  <para style="q1" vid="ISA 21:13">ka gi kacha ka bworo e thim jo-Arabu,<verse eid="ISA 21:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 21:14"/>keluru pi ne joma riyo oloyo,</para>
  <para style="q1" vid="ISA 21:14">to un mudak Tema,</para>
  <para style="q2" vid="ISA 21:14">keluru chiemo ne joma oseringo ka pondone lweny.<verse eid="ISA 21:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 21:15"/>Giseringone ligangla,</para>
  <para style="q2" vid="ISA 21:15">ne ligangla mowuodhi,</para>
  <para style="q2" vid="ISA 21:15">ne atungʼ moywa kendo ne lweny mager.<verse eid="ISA 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 21:16"/>Ruoth Nyasaye wachona niya, “Mana kaka ja-otongʼo kwano hike achiel ma tije rumogo e kaka duongʼ mar Kedar norum. <verse eid="ISA 21:16"/><verse number="17" style="v" sid="ISA 21:17"/>Joma nok ma gin jolweny mag asere ma gin thuondi man Kedar ema notony. Jehova Nyasaye ma en Nyasach Israel osewacho.”<verse eid="ISA 21:17"/></para>
  <chapter eid="ISA 21"/>
  <chapter number="22" style="c" sid="ISA 22"/>
  <para style="s1">Wach mokor kuom Jerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 22:1"/>Ma e wach mokor kuom Holo mar Fweny:</para>
  <para style="q1" vid="ISA 22:1">Koro angʼo mathagou momiyo un duto uidho ewi udi,<verse eid="ISA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 22:2"/>Yaye in dala ma mahu opongʼo,</para>
  <para style="q2" vid="ISA 22:2">yaye dala maduongʼ ma koko gi mor kod ilo opongʼo?</para>
  <para style="q1" vid="ISA 22:2">Jogi mane otho ok noneg gi ligangla</para>
  <para style="q2" vid="ISA 22:2">to bende ne ok githo e lweny.<verse eid="ISA 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 22:3"/>Jotendu duto oseringo kaachiel,</para>
  <para style="q1" vid="ISA 22:3">osemakgi ma ok oti gi gige lweny moro amora.</para>
  <para style="q2" vid="ISA 22:3">Un duto mane uringo ka wasigu ne pod ni mabor,</para>
  <para style="q1" vid="ISA 22:3">osemaku kanyakla moteru e twech.<verse eid="ISA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 22:4"/>Kuom mano ne awacho niya,</para>
  <para style="q1" vid="ISA 22:4">“Weyauru aweya mondo aywag malit.</para>
  <para style="q2" vid="ISA 22:4">Weuru hoya nikech jowa osetieki.”<verse eid="ISA 22:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 22:5"/>Ruoth Nyasaye ma en Jehova Nyasaye Maratego</para>
  <para style="q2" vid="ISA 22:5">oseketo odiechieng mahu gi koko kod masira e Holo mar Fweny,</para>
  <para style="q1" vid="ISA 22:5">en odiechiengʼ mar muko ohinga</para>
  <para style="q2" vid="ISA 22:5">kendo nduru nowuog malit kochomo ewi gode.<verse eid="ISA 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 22:6"/>Jo-Elam kawo aserni mag-gi,</para>
  <para style="q2" vid="ISA 22:6">kaachiel gi joriemb geche mag lweny gi farese;</para>
  <para style="q2" vid="ISA 22:6">to jo-Kir to nokawo kuodigi.<verse eid="ISA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 22:7"/>Holniu mabeyo opongʼ gi geche mag lweny,</para>
  <para style="q2" vid="ISA 22:7">kendo joidh farese osechielo rangeye mag dala maduongʼ.<verse eid="ISA 22:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 22:8"/>Ruoth Nyasaye oselonyo mabor tekre Juda,</para>
  <para style="q2" vid="ISA 22:8">kendo e kindeno ne umanyo,</para>
  <para style="q2" vid="ISA 22:8">gige lweny manie Od Ruoth manie Bungu.<verse eid="ISA 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 22:9"/>Ne uneno ka kuonde mangʼeny mar ohinga</para>
  <para style="q2" vid="ISA 22:9">mar Dala Maduongʼ mar Daudi omukore,</para>
  <para style="q1" vid="ISA 22:9">omiyo ne uchiko pi</para>
  <para style="q2" vid="ISA 22:9">odhi e soko mamwalo.<verse eid="ISA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 22:10"/>Ne gikwano ute mag Jerusalem</para>
  <para style="q2" vid="ISA 22:10">kendo ne gimukogi mondo olosgo ohinga motegno.<verse eid="ISA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 22:11"/>Ne gikunyo yawo e kind ohinga ariyogo</para>
  <para style="q2" vid="ISA 22:11">ne pi mawuok e soko machon,</para>
  <para style="q1" vid="ISA 22:11">to ne ok upenjo Jal mane olose,</para>
  <para style="q2" vid="ISA 22:11">kata miyo Jalno mane ochane luor.<verse eid="ISA 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 22:12"/>To Ruoth Nyasaye ma en Jehova Nyasaye Maratego,</para>
  <para style="q2" vid="ISA 22:12">ne oluongou odiechiengno mondo uywagi kendo udengi,</para>
  <para style="q2" vid="ISA 22:12">ka upudho yie wiu kendo urwako pien gugru.<verse eid="ISA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 22:13"/>To kata kamano nitie mor kod ilo,</para>
  <para style="q2" vid="ISA 22:13">kaachiel gi yangʼo dhok kod rombe,</para>
  <para style="q2" vid="ISA 22:13">chamo ringʼo kod madho divai!</para>
  <para style="q1" vid="ISA 22:13">Giwacho niya, “We wachiem kendo wamethi</para>
  <para style="q2" vid="ISA 22:13">nikech kiny wanatho!”<verse eid="ISA 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 22:14"/>Jehova Nyasaye Maratego osefwenyona ma kawinjo: “Richoni ok nopwodhi nyaka chop thou,” Ruoth Nyasaye ma en Jehova Nyasaye Maratego owacho.<verse eid="ISA 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 22:15"/>Ma e gima Ruoth Nyasaye ma en Jehova Nyasaye Maratego wacho,</para>
  <para style="q1" vid="ISA 22:15">Dhi ir jakeno mar od ruoth miluongo</para>
  <para style="q2" vid="ISA 22:15">ni Shebna mondo iwachne niya,<verse eid="ISA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 22:16"/>En angʼo ma itimo ka,</para>
  <para style="q1" vid="ISA 22:16">kendo en ngʼa manomiyi thuolo mar kunyo buri ka,</para>
  <para style="q2" vid="ISA 22:16">momiyo iloso bur kama otingʼore,</para>
  <para style="q2" vid="ISA 22:16">kendo iloso kari maber mar yweyo e kind lwanda?<verse eid="ISA 22:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 22:17"/>Bed motangʼ,</para>
  <para style="q2" vid="ISA 22:17">Jehova Nyasaye chiegni ngʼwasi mi owiti oko,</para>
  <para style="q2" vid="ISA 22:17">yaye in ngʼat maratego.<verse eid="ISA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 22:18"/>Obiro ngʼwasi motweyi matek</para>
  <para style="q2" vid="ISA 22:18">kendo owiti e piny malach mana ka mipira mowiti.</para>
  <para style="q2" vid="ISA 22:18">Kuno ema nithoe,</para>
  <para style="q1" vid="ISA 22:18">kendo kuno ema gecheni mag lweny mabeyo</para>
  <para style="q2" vid="ISA 22:18">nosikie in mikelo wichkuot ne od ruodhi.<verse eid="ISA 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 22:19"/>Abiro goli e kari mar tich</para>
  <para style="q2" vid="ISA 22:19">kendo goli e loch mari.<verse eid="ISA 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 22:20"/>E kindeno analuong jatichna Eliakim ma wuod Hilkia. <verse eid="ISA 22:20"/><verse number="21" style="v" sid="ISA 22:21"/>Anarwake gi law mar duongʼ kendo anatwe okanda e nungone mi anamiye loch mari. Enobed wuon joma odak Jerusalem kod Juda. <verse eid="ISA 22:21"/><verse number="22" style="v" sid="ISA 22:22"/>Anamiye rayaw mar od Daudi, ma gima oyawo ngʼato ok lor, to bende gima oloro onge ngʼama yawo. <verse eid="ISA 22:22"/><verse number="23" style="v" sid="ISA 22:23"/>Abiro gure motegno kendo mongirore ka sigingi kendo enobed e kom duongʼ ne od wuon mare. <verse eid="ISA 22:23"/><verse number="24" style="v" sid="ISA 22:24"/>Duongʼ duto ma joodgi noyudi ma gin, nyithinde gi nyikwaye, gige duto ma ok ogen, machalo kaka bakunde nyaka agulni duto nowuog kuome.<verse eid="ISA 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 22:25"/>Jehova Nyasaye Maratego wacho niya, “E kindeno sigingi mane ogur motegno kendo mongirore biro pudhore, nongʼade mi olwar kendo gik moko duto mongʼaw kuome bende nolwar.” Jehova Nyasaye osewacho.<verse eid="ISA 22:25"/></para>
  <chapter eid="ISA 22"/>
  <chapter number="23" style="c" sid="ISA 23"/>
  <para style="s1">Wach mokor kuom Turo</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 23:1"/>Ma e wach mokor kuom Turo:</para>
  <para style="q1" vid="ISA 23:1">Ywaguru, yaye yiedhi mag Tarshish!</para>
  <para style="q2" vid="ISA 23:1">Nimar Turo osekethi,</para>
  <para style="q2" vid="ISA 23:1">kendo oweye maonge ot kata dho wath!</para>
  <para style="q1" vid="ISA 23:1">Wach osechoponegi koa e piny Saipras.<verse eid="ISA 23:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 23:2"/>Lingʼuru thi un joma odak e chula,</para>
  <para style="q1" vid="ISA 23:2">kendo un jo-ohala madongo man Sidon,</para>
  <para style="q2" vid="ISA 23:2">un ma jokwangʼ ji osemiyo umewo.<verse eid="ISA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 23:3"/>Nam maduongʼ ema cham mag Shihor ngʼado,</para>
  <para style="q2" vid="ISA 23:3">mwandu mokaa kowuok Nael ema osebedo girkeni mar Turo,</para>
  <para style="q2" vid="ISA 23:3">kendo osebedo kar ohala mar ogendini.<verse eid="ISA 23:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 23:4"/>Ininwangʼ wichkuot, yaye Sidon,</para>
  <para style="q2" vid="ISA 23:4">yaye in, ma in ohinga mar nam,</para>
  <para style="q2" vid="ISA 23:4">nimar nam osewuoyo niya,</para>
  <para style="q1" vid="ISA 23:4">“Ok asewinjo rem mar muoch bende pok anywol,</para>
  <para style="q2" vid="ISA 23:4">ok asepidho yawuowi kata nyiri pok abedogo.”<verse eid="ISA 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 23:5"/>Jo-Misri nobed gi kuyo</para>
  <para style="q2" vid="ISA 23:5">ka wach nochopnegi koa Turo.<verse eid="ISA 23:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 23:6"/>Ngʼaduru udhi Tarshish denguru,</para>
  <para style="q2" vid="ISA 23:6">un joma odak e chula.<verse eid="ISA 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 23:7"/>Bende ma e dalau maduongʼ</para>
  <para style="q1" vid="ISA 23:7">machon mane opongʼ gi mor kod ilo</para>
  <para style="q2" vid="ISA 23:7">masani koro oke e pinje man kuonde maboyo.<verse eid="ISA 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 23:8"/>En ngʼa mosechano kelo masirani kuom Turo,</para>
  <para style="q2" vid="ISA 23:8">wuon loch, ma jo-ohala mage ogen,</para>
  <para style="q2" vid="ISA 23:8">ma bende jongʼiewo mage ongʼere e piny duto?<verse eid="ISA 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 23:9"/>Jehova Nyasaye Maratego osechano tieko sunga duto mar joma nigi duongʼ</para>
  <para style="q2" vid="ISA 23:9">kendo obiro kuodo wi ji duto moluor ahinya e piny.<verse eid="ISA 23:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 23:10"/>Pururu lowo manie bath aora Nael,</para>
  <para style="q2" vid="ISA 23:10">yaye Nyar Tarshish,</para>
  <para style="q2" vid="ISA 23:10">nikech koro uonge gi dho wath.<verse eid="ISA 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 23:11"/>Jehova Nyasaye oserieyo bade e nam</para>
  <para style="q2" vid="ISA 23:11">kendo osemiyo pinyruodhi tetni,</para>
  <para style="q1" vid="ISA 23:11">bende osegolo chik ne Foenikia</para>
  <para style="q2" vid="ISA 23:11">mondo otiek gik ma gineno kuomgi.<verse eid="ISA 23:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 23:12"/>Nowacho niya, “Ok unuchak ubed gi mor kod ilo,</para>
  <para style="q2" vid="ISA 23:12">yaye Nyar Sidon Mangili ma osekethi!</para>
  <para style="b" vid="ISA 23:12"/>
  <para style="q1" vid="ISA 23:12">“Kata bed mana ni ungʼado nam ma udhi Saipras</para>
  <para style="q2" vid="ISA 23:12">to kuno bende ok unuyudie yweyo.”<verse eid="ISA 23:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 23:13"/>Neuru piny jo-Babulon,</para>
  <para style="q2" vid="ISA 23:13">jogi makoro ikwano ka nono!</para>
  <para style="q1" vid="ISA 23:13">Jo-Asuria osemiyo odongʼ kar le mag thim;</para>
  <para style="q2" vid="ISA 23:13">kendo negigero kargi mar ngʼicho motingʼore gi malo,</para>
  <para style="q1" vid="ISA 23:13">ka gilworo dala bende negimuko ohingane duto</para>
  <para style="q2" vid="ISA 23:13">mi giweye gunda.<verse eid="ISA 23:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 23:14"/>Denguru un yiedhi moa Tarshish,</para>
  <para style="q2" vid="ISA 23:14">nikech karu mochiel motegno osemuki!<verse eid="ISA 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 23:15"/>E kindeno wich nowil gi Turo kuom higni piero abiriyo, marom kod ngima mar ruoth achiel, to giko mar higni piero abiriyogi, nobed ne Turo mana kaka wend nyako mochot mawero niya:<verse eid="ISA 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 23:16"/>“Kaw thumi ilworgo dala maduongʼ,</para>
  <para style="q2" vid="ISA 23:16">yaye nyako ma jachode makoro wich osewilgo,</para>
  <para style="q1" vid="ISA 23:16">go thumino mamit, wer wende mangʼeny</para>
  <para style="q2" vid="ISA 23:16">mondo kanyalore to opari.”<verse eid="ISA 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 23:17"/>To bangʼ higni piero abiriyo Jehova Nyasaye biro kecho Turo mirese. To bangʼe nodogi e tije machon mar chode kendo notim timbene machon mag chode gi pinjeruodhi duto mag piny ngima. <verse eid="ISA 23:17"/><verse number="18" style="v" sid="ISA 23:18"/>To koro ohala moyudo kod chudo kuom tije noket tenge ne Jehova Nyasaye; ok nokan-gi kata kungogi ne en owuon. Ohala moyudo biro dhiyone jogo matiyone Jehova Nyasaye mondo ongʼiewgo chiemo mangʼeny kod lewni mabeyo.<verse eid="ISA 23:18"/></para>
  <chapter eid="ISA 23"/>
  <chapter number="24" style="c" sid="ISA 24"/>
  <para style="s1">Jehova Nyasaye biro ketho piny</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 24:1"/>Neuru Jehova Nyasaye biro ketho piny,</para>
  <para style="q2" vid="ISA 24:1">mi odongʼ nono,</para>
  <para style="q1" vid="ISA 24:1">obiro loko kit piny</para>
  <para style="q2" vid="ISA 24:1">kendo keyo jogo modakie.<verse eid="ISA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 24:2"/>Notime machalre ne jodolo kata ne joma moko,</para>
  <para style="q1" vid="ISA 24:2">misumba kata ne ruodhe,</para>
  <para style="q2" vid="ISA 24:2">ne dhako man-gi jatich kata ne nyako matiyone,</para>
  <para style="q1" vid="ISA 24:2">ne jahono kata ne jangʼiewo, ne ngʼat ma holo ji,</para>
  <para style="q2" vid="ISA 24:2">kata ne ngʼat ma holo,</para>
  <para style="q2" vid="ISA 24:2">ne ngʼat man-gi gowi kata ngʼat ma holo ji.<verse eid="ISA 24:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 24:3"/>Piny nodongʼ gunda</para>
  <para style="q2" vid="ISA 24:3">kendo nokethre chuth.</para>
  <para style="q1" vid="ISA 24:3">Jehova Nyasaye ema osewacho wechegi.<verse eid="ISA 24:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 24:4"/>Piny notwo kendo noner,</para>
  <para style="q2" vid="ISA 24:4">piny nojwangʼ miner,</para>
  <para style="q2" vid="ISA 24:4">kendo polo gi piny nojwangʼ.<verse eid="ISA 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 24:5"/>Piny osedwany gi jok modakie,</para>
  <para style="q2" vid="ISA 24:5">giseketho chike, gisetamore rito buchene,</para>
  <para style="q1" vid="ISA 24:5">kendo giseketho winjruok manyaka nene.<verse eid="ISA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 24:6"/>Kuom mano kwongʼ</para>
  <para style="q2" vid="ISA 24:6">osetieko piny kendo joma odakie nyaka yud kum kuom richogi.</para>
  <para style="q1" vid="ISA 24:6">Omiyo joma odak e piny osewangʼ</para>
  <para style="q2" vid="ISA 24:6">mi manok ema odongʼ.<verse eid="ISA 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 24:7"/>Divai mobi manyien notuwo</para>
  <para style="q2" vid="ISA 24:7">kendo mzabibu biro ner,</para>
  <para style="q2" vid="ISA 24:7">ji duto mamiyo ji mor nobed gi chuny lit.<verse eid="ISA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 24:8"/>Mor mar nyiduonge norum,</para>
  <para style="q2" vid="ISA 24:8">koko mar joma nigi mor kod ilo nolal,</para>
  <para style="q2" vid="ISA 24:8">kendo mor mar thum ok nowinji.<verse eid="ISA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 24:9"/>Ok ginichak gimadh divai ka giwer,</para>
  <para style="q2" vid="ISA 24:9">nikech kongʼo osebedo marach ne jomath.<verse eid="ISA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 24:10"/>Dala maduongʼ</para>
  <para style="q2" vid="ISA 24:10">okethore modongʼ gunda,</para>
  <para style="q1" vid="ISA 24:10">kendo dhoudi duto olor.<verse eid="ISA 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 24:11"/>Ji ywagore e wangʼ yore</para>
  <para style="q2" vid="ISA 24:11">nikech divai onge, mor duto olokore kuyo,</para>
  <para style="q2" vid="ISA 24:11">piny duto odongʼ gi lit.<verse eid="ISA 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 24:12"/>Dala maduongʼ odongʼ ka oruombore piny</para>
  <para style="q2" vid="ISA 24:12">kendo dhorangeye mage otur matindo tindo.<verse eid="ISA 24:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 24:13"/>Ma notimre e piny</para>
  <para style="q1" vid="ISA 24:13">ngima e kind ogendini mana kaka ipono olemb zeituni</para>
  <para style="q2" vid="ISA 24:13">e yath kata mana kaka olemo manok,</para>
  <para style="q2" vid="ISA 24:13">mag mzabibu dongʼne johulo e yath kosepon.<verse eid="ISA 24:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 24:14"/>Gitingʼo dwondgi malo, ka gigoyo koko gimor</para>
  <para style="q2" vid="ISA 24:14">koa yo podho chiengʼ,</para>
  <para style="q2" vid="ISA 24:14">kendo ka gihulo teko mar Jehova Nyasaye.<verse eid="ISA 24:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 24:15"/>Omiyo miuru Jehova Nyasaye duongʼ</para>
  <para style="q1" vid="ISA 24:15">un joma odak e chula mag nam man yo wuok chiengʼ;</para>
  <para style="q2" vid="ISA 24:15">tingʼuru nying Jehova Nyasaye malo,</para>
  <para style="q2" vid="ISA 24:15">ma en Nyasach Israel,<verse eid="ISA 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 24:16"/>koa e tungʼ piny duto wawinjo wer mawer niya:</para>
  <para style="q2" vid="ISA 24:16">“Duongʼ odongʼ ne Jal Makare.”</para>
  <para style="b" vid="ISA 24:16"/>
  <para style="q1" vid="ISA 24:16">To an ne awacho niya, “Aserumo chuth, aserumo chuth!</para>
  <para style="q2" vid="ISA 24:16">Mano kaka aneno malit!</para>
  <para style="q1" vid="ISA 24:16">Jandhoko ndhogo ji!</para>
  <para style="q2" vid="ISA 24:16">Kuom timbe mag andhoga osendhogo ji!”<verse eid="ISA 24:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 24:17"/>Masira rita, osekunyna bugo</para>
  <para style="q2" vid="ISA 24:17">kendo obadho osechikna,</para>
  <para style="q2" vid="ISA 24:17">yaye un oganda modak e piny.<verse eid="ISA 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 24:18"/>Ngʼama notem ringo kowinjo mahu mar masira</para>
  <para style="q2" vid="ISA 24:18">nolwar e bur,</para>
  <para style="q1" vid="ISA 24:18">kendo ngʼama notem wuok e burno</para>
  <para style="q2" vid="ISA 24:18">nolwar e obadho.</para>
  <para style="b" vid="ISA 24:18"/>
  <para style="q1" vid="ISA 24:18">Dhorangeye mag polo noyawre,</para>
  <para style="q2" vid="ISA 24:18">kendo mise mag piny noyiengni.<verse eid="ISA 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 24:19"/>Piny osebarore,</para>
  <para style="q2" vid="ISA 24:19">piny oselal nono,</para>
  <para style="q2" vid="ISA 24:19">kendo piny yiengni malich.<verse eid="ISA 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 24:20"/>Piny thembo ka jakongʼo,</para>
  <para style="q2" vid="ISA 24:20">kendo ohukni ka kiru ma yamo yiengo,</para>
  <para style="q1" vid="ISA 24:20">kethruok kod timbene mamono</para>
  <para style="q2" vid="ISA 24:20">omiyo opodho ma ok nochak oa malo.<verse eid="ISA 24:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 24:21"/>E kindeno Jehova Nyasaye nokum</para>
  <para style="q2" vid="ISA 24:21">teko duto manie polo malo,</para>
  <para style="q2" vid="ISA 24:21">kaachiel gi ruodhi duto manie piny.<verse eid="ISA 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 24:22"/>Nochokgi kaachiel kendo nolornegi</para>
  <para style="q1" vid="ISA 24:22">mana kaka jo-jela molornegi e od twech</para>
  <para style="q2" vid="ISA 24:22">kendo nolornegi e od twech,</para>
  <para style="q2" vid="ISA 24:22">mi giyud kum kuom kinde mangʼeny.<verse eid="ISA 24:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 24:23"/>Dwe norieny matip-tip kendo wangʼ</para>
  <para style="q2" vid="ISA 24:23">chiengʼ noimre nikech Jehova Nyasaye Maratego,</para>
  <para style="q1" vid="ISA 24:23">nogur lochne kod duongʼne e Got Sayun</para>
  <para style="q2" vid="ISA 24:23">kod Jerusalem e nyim jodongo.<verse eid="ISA 24:23"/></para>
  <chapter eid="ISA 24"/>
  <chapter number="25" style="c" sid="ISA 25"/>
  <para style="s1">Pak obed ne Jehova Nyasaye</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 25:1"/>Yaye Jehova Nyasaye, in Nyasacha;</para>
  <para style="q2" vid="ISA 25:1">abiro miyi duongʼ kendo anapak nyingi,</para>
  <para style="q1" vid="ISA 25:1">nimar kuom adiera mowinjore</para>
  <para style="q2" vid="ISA 25:1">isetimo gik makare,</para>
  <para style="q1" vid="ISA 25:1">mago mane osechan chon.<verse eid="ISA 25:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="ISA 25:2"/>Isemiyo dala maduongʼ omukore,</para>
  <para style="q2" vid="ISA 25:2">modhurore pidhe pidhe, dalano mochiel motegno okethore,</para>
  <para style="q1" vid="ISA 25:2">dala maduongʼ ma jopinje mamoko noketoe genogi oserumo;</para>
  <para style="q2" vid="ISA 25:2">bende ok nochak ogere kendo.<verse eid="ISA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 25:3"/>Kuom mano joma roteke nomiyi duongʼ;</para>
  <para style="q2" vid="ISA 25:3">mier madongo mag ogendini ma jonjore biro miyi luor.<verse eid="ISA 25:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 25:4"/>Isebedo kar pondo ne jochan,</para>
  <para style="q2" vid="ISA 25:4">kar gengʼruok ne jodhier manie lit,</para>
  <para style="q2" vid="ISA 25:4">kar bwok ka ahiti kudho, kendo kar tipo ka chiengʼ kech.</para>
  <para style="q1" vid="ISA 25:4">Nimar muya mar janjore</para>
  <para style="q2" vid="ISA 25:4">chalo mana ka ahiti makudho kochomo ohinga,<verse eid="ISA 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 25:5"/>kendo mana ka liet manie piny motimo ongoro.</para>
  <para style="q1" vid="ISA 25:5">Isetieko koko mar jopinje mamoko mana kaka tipo mar</para>
  <para style="q2" vid="ISA 25:5">bor polo gengʼo liet,</para>
  <para style="q2" vid="ISA 25:5">e kaka wend jonjore osechung.<verse eid="ISA 25:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 25:6"/>Ewi godni Jehova Nyasaye Maratego biro loso</para>
  <para style="q2" vid="ISA 25:6">nyasi mar chiemo mamiyo ne oganda duto,</para>
  <para style="q1" vid="ISA 25:6">sawo mar divai mosekan,</para>
  <para style="q2" vid="ISA 25:6">kod chiemo mabeyo gi divai molos maber.<verse eid="ISA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 25:7"/>Ewi godni obiro walo law moumo wangʼ ji duto,</para>
  <para style="q2" vid="ISA 25:7">law mogengʼo ogendini duto;<verse eid="ISA 25:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 25:8"/>kendo enotiek tho chuth.</para>
  <para style="q2" vid="ISA 25:8">Jehova Nyasaye Manyalo Gik Moko Duto biro yweyo pi wangʼ ji duto;</para>
  <para style="q1" vid="ISA 25:8">mi nogol ajara kuom joge</para>
  <para style="q2" vid="ISA 25:8">e piny duto.</para>
  <para style="q1" vid="ISA 25:8">Jehova Nyasaye ema osewacho.<verse eid="ISA 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 25:9"/>E kindeno giniwach ni,</para>
  <para style="q1" vid="ISA 25:9">“Adier ma en Nyasachwa;</para>
  <para style="q2" vid="ISA 25:9">ne wageno kuome,</para>
  <para style="q2" vid="ISA 25:9">kendo ne oresowa.</para>
  <para style="q1" vid="ISA 25:9">Ma en Jehova Nyasaye, ne wageno kuome;</para>
  <para style="q2" vid="ISA 25:9">wabeduru gi mor kendo gi ilo kuom warruokne.”<verse eid="ISA 25:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 25:10"/>Lwet Jehova Nyasaye biro yweyo ewi godni,</para>
  <para style="q2" vid="ISA 25:10">to Moab nonyon piny gi tiende,</para>
  <para style="q2" vid="ISA 25:10">mana kaka inyono lum e dipo.<verse eid="ISA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 25:11"/>Giniyar badgi kuome,</para>
  <para style="q2" vid="ISA 25:11">mana kaka ngʼama goyo abal yaro bedene ka kwangʼ.</para>
  <para style="q1" vid="ISA 25:11">Nyasaye biro tieko sungagi</para>
  <para style="q2" vid="ISA 25:11">kata obedo ni lwetgi riek e yor goyo abal.<verse eid="ISA 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 25:12"/>Obiro muko piny kuondeu mochiel motegno</para>
  <para style="q2" vid="ISA 25:12">motingʼore gi malo mi oketgi piny,</para>
  <para style="q2" vid="ISA 25:12">enotergi e lowo ma gilokre buru.<verse eid="ISA 25:12"/></para>
  <chapter eid="ISA 25"/>
  <chapter number="26" style="c" sid="ISA 26"/>
  <para style="s1">Wend pak</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 26:1"/>E ndalono wendni nower e piny Juda ni:</para>
  <para style="q2" vid="ISA 26:1">Wan gi dala maduongʼ man-gi teko;</para>
  <para style="q2" vid="ISA 26:1">Nyasaye kelo resruok e ohingane gi kuonde molwore.<verse eid="ISA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 26:2"/>Yaw dhorangeye</para>
  <para style="q2" vid="ISA 26:2">mondo oganda makare odonji,</para>
  <para style="q2" vid="ISA 26:2">oganda morito yie.<verse eid="ISA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 26:3"/>Inirit gi kwe ngʼatno ma parone oriere tir,</para>
  <para style="q2" vid="ISA 26:3">nikech ogeno kuomi.<verse eid="ISA 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 26:4"/>Gen kuom Jehova Nyasaye nyaka chiengʼ,</para>
  <para style="q2" vid="ISA 26:4">nimar Jehova Nyasaye en Jehova Nyasaye ma Lwanda nyaka chiengʼ.<verse eid="ISA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 26:5"/>Odwoko piny joma otingʼore malo,</para>
  <para style="q2" vid="ISA 26:5">odwoko dala maduongʼ mar ngʼayi piny,</para>
  <para style="q2" vid="ISA 26:5">mi otoye matindo tindo ma olokre buru.<verse eid="ISA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 26:6"/>Tiende joma ithiro</para>
  <para style="q2" vid="ISA 26:6">kod mag joma odhier nyone piny.<verse eid="ISA 26:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 26:7"/>Yor joma kare opie,</para>
  <para style="q2" vid="ISA 26:7">yaye in Jal makare, iloso yor joma kare bedo maber.<verse eid="ISA 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 26:8"/>Yaye Jehova Nyasaye, wuotho e yore mag chikeni ema warito,</para>
  <para style="q2" vid="ISA 26:8">nyingi kod duongʼ mari ema chunywa dwaro.<verse eid="ISA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 26:9"/>Chunya gombi gotieno</para>
  <para style="q2" vid="ISA 26:9">kendo chunya dwari gokinyi.</para>
  <para style="q1" vid="ISA 26:9">Ka buchi makare biro e piny,</para>
  <para style="q2" vid="ISA 26:9">ogendini mag piny puonjore yo makare.<verse eid="ISA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 26:10"/>Kata obedo ni ngʼwono itimone joricho,</para>
  <para style="q2" vid="ISA 26:10">to ok gipuonjore tim makare;</para>
  <para style="q1" vid="ISA 26:10">kata mana e piny joma kare gidhi nyime mana ka gitimo richo,</para>
  <para style="q2" vid="ISA 26:10">ka ok gichiwo luor ne duongʼ mar Jehova Nyasaye.<verse eid="ISA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 26:11"/>Yaye Jehova Nyasaye, isetingʼo badi malo,</para>
  <para style="q2" vid="ISA 26:11">to ok gine.</para>
  <para style="q1" vid="ISA 26:11">We mondo gine geno ma in-go,</para>
  <para style="q2" vid="ISA 26:11">kuom jogi mi giyud wichkuot,</para>
  <para style="q1" vid="ISA 26:11">kendo mad mach mokan ne wasiki wangʼ-gi duto.<verse eid="ISA 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 26:12"/>Jehova Nyasaye, isemiyowa kwe;</para>
  <para style="q2" vid="ISA 26:12">kendo gik moko duto ma wasetimo in ema isetimonwa.<verse eid="ISA 26:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 26:13"/>Yaye Jehova Nyasaye ma Nyasachwa,</para>
  <para style="q2" vid="ISA 26:13">ruodhi mamoko ma ok in osetiyowa,</para>
  <para style="q2" vid="ISA 26:13">makmana nyingi kende ema wamiyo luor.<verse eid="ISA 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 26:14"/>To koro jogo osetho kendo koro gionge;</para>
  <para style="q2" vid="ISA 26:14">chunje moseago ok nochier.</para>
  <para style="q2" vid="ISA 26:14">Ne ikumogi mi itiekogi maonge ngʼama parogi.<verse eid="ISA 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 26:15"/>Isemedo ogandawa, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 26:15">isemedo ogandawa.</para>
  <para style="q1" vid="ISA 26:15">Iseyudo duongʼ mana ne in iwuon;</para>
  <para style="q2" vid="ISA 26:15">kendo isemedo tongʼ duto mar pinywa.<verse eid="ISA 26:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 26:16"/>Yaye Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 26:16">negimanyi e kinde mane ginie chandruok;</para>
  <para style="q2" vid="ISA 26:16">kendo kane ikumogi ne gionge gi teko mar lemo.<verse eid="ISA 26:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 26:17"/>Mana kaka dhako man-gi ich machiegni nywol</para>
  <para style="q2" vid="ISA 26:17">muoch kayo kendo ywak kawinjo rem mano,</para>
  <para style="q2" vid="ISA 26:17">bende e kaka wanie nyimi yaye Jehova Nyasaye.<verse eid="ISA 26:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 26:18"/>Wasebedo gi ich,</para>
  <para style="q2" vid="ISA 26:18">muoch osekayowa malit to ne wanywolo mana yamo.</para>
  <para style="q1" vid="ISA 26:18">Ok wasekelo warruok e piny,</para>
  <para style="q2" vid="ISA 26:18">bende pod ok wanywolo ji e piny.<verse eid="ISA 26:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 26:19"/>To jogi mosenindo kuom Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 26:19">nobed mangima,</para>
  <para style="q2" vid="ISA 26:19">kendo ringregi nochier.</para>
  <para style="q1" vid="ISA 26:19">In misiko e buru,</para>
  <para style="q2" vid="ISA 26:19">chiew kendo igo koko gi mor.</para>
  <para style="q1" vid="ISA 26:19">Thoo ma in-go chalo thoo mar okinyi,</para>
  <para style="q2" vid="ISA 26:19">piny biro golo joma otho oko.<verse eid="ISA 26:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 26:20"/>Dhiuru, un joga, donjuru e uteu</para>
  <para style="q2" vid="ISA 26:20">kendo loruru dhoutu,</para>
  <para style="q1" vid="ISA 26:20">ponduru kuom ndalo matin</para>
  <para style="q2" vid="ISA 26:20">nyaka ndalo mar mirimbe kal.<verse eid="ISA 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 26:21"/>To ne, Jehova Nyasaye biro kawuok kare mar dak</para>
  <para style="q2" vid="ISA 26:21">mondo okum joma odak e piny kuom richogi.</para>
  <para style="q1" vid="ISA 26:21">Piny noket ayanga remo mosechwer kuome,</para>
  <para style="q2" vid="ISA 26:21">mi ok noum joge mosenegi.<verse eid="ISA 26:21"/></para>
  <chapter eid="ISA 26"/>
  <chapter number="27" style="c" sid="ISA 27"/>
  <para style="s1">Resruok mar Israel</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 27:1"/>E kindeno,</para>
  <para style="q1" vid="ISA 27:1">Jehova Nyasaye nokaw liganglane mabith,</para>
  <para style="q2" vid="ISA 27:1">motegno kendo man-gi teko,</para>
  <para style="q1" vid="ISA 27:1">mokumgo Leviathan,</para>
  <para style="q2" vid="ISA 27:1">thuol malich mamol kendo monudore;</para>
  <para style="q1" vid="ISA 27:1">motiek thuol malich mar nam.<verse eid="ISA 27:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 27:2"/>E kindeno:</para>
  <para style="q1" vid="ISA 27:2">“Nuwerne puoth mzabibu mamiyo kama:<verse eid="ISA 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 27:3"/>An Jehova Nyasaye, aketo wangʼa kuome;</para>
  <para style="q2" vid="ISA 27:3">kendo amiye pi pile.</para>
  <para style="q1" vid="ISA 27:3">Arite odiechiengʼ gotieno</para>
  <para style="q2" vid="ISA 27:3">mondo kik ngʼato kethe.<verse eid="ISA 27:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 27:4"/>Aonge gi ich wangʼ.</para>
  <para style="q1" vid="ISA 27:4">Ka dine pedo kod kuthe ok gwara,</para>
  <para style="q2" vid="ISA 27:4">to dine amonjogi;</para>
  <para style="q2" vid="ISA 27:4">mi awangʼogi duto e mach.<verse eid="ISA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 27:5"/>Ka ok kamano to wegi gibi ira mondo abed kar pondogi;</para>
  <para style="q2" vid="ISA 27:5">we mondo gilos kwe e kinda kodgi,</para>
  <para style="q2" vid="ISA 27:5">ee, we gilos winjruok koda.”<verse eid="ISA 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 27:6"/>E kinde mabirogo Jakobo nogurre motegno,</para>
  <para style="q1" vid="ISA 27:6">Israel nobed ka bad yath madongo kendo thiewo,</para>
  <para style="q2" vid="ISA 27:6">kendo enonyag olemo mopongʼo piny.<verse eid="ISA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 27:7"/>Bende Jehova Nyasaye osekumo Israel</para>
  <para style="q2" vid="ISA 27:7">kaka nokumo joma nosandogi?</para>
  <para style="q2" vid="ISA 27:7">Bende osenego Israel kaka nonego joma ne onegogi?<verse eid="ISA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 27:8"/>Ei masiche kod twech isebedo machiegni kode,</para>
  <para style="q2" vid="ISA 27:8">iseriembogi mabor,</para>
  <para style="q2" vid="ISA 27:8">mana ka gima yamo mager moa yo wuok chiengʼ ema terogi.<verse eid="ISA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 27:9"/>Kuom ma, richo mar Jakobo nopwodhi,</para>
  <para style="q2" vid="ISA 27:9">kendo ma ema nobed ranyisi mar golo richone duto:</para>
  <para style="q1" vid="ISA 27:9">Komiyo kite duto milosogo kar</para>
  <para style="q2" vid="ISA 27:9">kendo mar misango chalo mana gi matafare motore matindo tindo,</para>
  <para style="q1" vid="ISA 27:9">bende onge sirni mag Ashera kata</para>
  <para style="q2" vid="ISA 27:9">kendo miwangʼoe ubani mane odongʼ kochungʼ.<verse eid="ISA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 27:10"/>Dala maduongʼ mochiel motegno odongʼ gunda,</para>
  <para style="q2" vid="ISA 27:10">kama yande ji odakie ojwangʼ ka thim;</para>
  <para style="q1" vid="ISA 27:10">nyiroye nokwa kanyo bende kanyo</para>
  <para style="q2" vid="ISA 27:10">ema gini nindie kagiselwero bede yien magitieko.<verse eid="ISA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 27:11"/>Ka bedegi osetwo to gimukore oko</para>
  <para style="q2" vid="ISA 27:11">kendo mon modogi michwakgi.</para>
  <para style="q1" vid="ISA 27:11">Nimar gin ogendini maonge winjo;</para>
  <para style="q2" vid="ISA 27:11">omiyo Jachwechgi onge gi miwafu kuomgi,</para>
  <para style="q2" vid="ISA 27:11">kendo Jachwech ok nyisgi ngʼwono moro amora.<verse eid="ISA 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 27:12"/>E kindeno Jehova Nyasaye biro piedho joge kochakore Aora Yufrate nyaka aore mag Wadi mar Misri, to un, yaye jo-Israel nochoku achiel kaachiel. <verse eid="ISA 27:12"/><verse number="13" style="v" sid="ISA 27:13"/>Kendo e kindeno tungʼ maduongʼ noywagi. Jogo mane olal e piny Asuria nobi kendo joma ni e twech e piny Misri nochopi ma lam Jehova Nyasaye e gode maler man Jerusalem.<verse eid="ISA 27:13"/></para>
  <chapter eid="ISA 27"/>
  <chapter number="28" style="c" sid="ISA 28"/>
  <para style="s1">Siem ne jo-Efraim</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 28:1"/>Mano kaka unune malit un osimbo mar jomer man Efraim,</para>
  <para style="q2" vid="ISA 28:1">maber mare malich biro rumo ka maua maner,</para>
  <para style="q1" vid="ISA 28:1">mopidhi ei holo momiyo</para>
  <para style="q2" vid="ISA 28:1">mana kaka josunga malwokore gi kongʼo!<verse eid="ISA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 28:2"/>Ne, Ruoth Nyasaye nigi ngʼato man kod loch gi teko.</para>
  <para style="q2" vid="ISA 28:2">Mana kaka pe kod yamo maketho piny,</para>
  <para style="q1" vid="ISA 28:2">e kaka obiro kelo koth machwe mabubni giteko</para>
  <para style="q2" vid="ISA 28:2">matiek gik moko duto manie lowo.<verse eid="ISA 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 28:3"/>Osimbo ma jomer man Efraim sungorego</para>
  <para style="q2" vid="ISA 28:3">ibiro nyono gi tielo.<verse eid="ISA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 28:4"/>Berne malich norum mana ka maua maner,</para>
  <para style="q2" vid="ISA 28:4">mopidhi ei holo momiyo,</para>
  <para style="q2" vid="ISA 28:4">mi nochal ka olemb ngʼowu mokwongo chiek,</para>
  <para style="q1" vid="ISA 28:4">ngʼato angʼata monene pone,</para>
  <para style="q2" vid="ISA 28:4">kendo chame ka rikni morum chuth.<verse eid="ISA 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 28:5"/>E kindeno Jehova Nyasaye Maratego nobedi kaka</para>
  <para style="q2" vid="ISA 28:5">osimbo mar duongʼ maber ne joge manok modongʼ.<verse eid="ISA 28:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 28:6"/>Enobed e chuny jangʼad bura mowinjore</para>
  <para style="q2" vid="ISA 28:6">kendo enojiw jolwenjeu makedo,</para>
  <para style="q2" vid="ISA 28:6">e dhorangeyeu obed gichir kendo olochi.<verse eid="ISA 28:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 28:7"/>To jogi bende kwangʼ</para>
  <para style="q2" vid="ISA 28:7">nikech divai kendo gibayo nikech kongʼo:</para>
  <para style="q1" vid="ISA 28:7">Jodolo kod jonabi mer makwangʼ nikech kongʼo</para>
  <para style="q2" vid="ISA 28:7">kendo gitagore nikech divai,</para>
  <para style="q1" vid="ISA 28:7">githembo ka gineno fweny,</para>
  <para style="q2" vid="ISA 28:7">gichwanyore ka gingʼado bura.<verse eid="ISA 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 28:8"/>Mesa duto opongʼ gi ngʼok,</para>
  <para style="q2" vid="ISA 28:8">onge kamoro amora ma ok dungʼ tik marach.<verse eid="ISA 28:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 28:9"/>“En ngʼa motemo puonjo?</para>
  <para style="q2" vid="ISA 28:9">To koso en ngʼa ma otemo yarone tiend wachne?</para>
  <para style="q1" vid="ISA 28:9">Ne nyithindo mogolie chak,</para>
  <para style="q2" vid="ISA 28:9">koso ne joma koro eka ogolie thuno?<verse eid="ISA 28:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 28:10"/>Onyisowa weche mak winjre ka mag jomomer ni:</para>
  <para style="q2" vid="ISA 28:10">Tim ma, tim macha kendo tim ma, tim macha.”<verse eid="ISA 28:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 28:11"/>To kata kamano Nyasaye biro wuoyo gi jogi</para>
  <para style="q2" vid="ISA 28:11">gi dho welo kod dhok mayoreyore.<verse eid="ISA 28:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 28:12"/>Mowachone niya,</para>
  <para style="q2" vid="ISA 28:12">“Ma en kar yweyo, joma ool mondo oywe.”</para>
  <para style="q1" vid="ISA 28:12">Kendo niya, “Ma en kar kwe,”</para>
  <para style="q2" vid="ISA 28:12">to ne ok ginyal winjo.<verse eid="ISA 28:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 28:13"/>Kuom mano, wach Jehova Nyasaye biro chalonegi mana ka wach awacha mar joma omer niya:</para>
  <para style="q2" vid="ISA 28:13">Tim ma, tim macha,</para>
  <para style="q2" vid="ISA 28:13">kendo tim ma, tim macha,</para>
  <para style="q2" vid="ISA 28:13">matin ka, matin kacha,</para>
  <para style="q1" vid="ISA 28:13">mamiyo gikwangʼ koni gi koni mi gipodhi</para>
  <para style="q2" vid="ISA 28:13">kendo gihinyre ma makgi e obadho.<verse eid="ISA 28:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 28:14"/>Kuom mano winjuru</para>
  <para style="q2" vid="ISA 28:14">wach Jehova Nyasaye un joma jaro ji ma,</para>
  <para style="q2" vid="ISA 28:14">jotend ogandani modak Jerusalem.<verse eid="ISA 28:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 28:15"/>Usungoru niya, “Wasetimo singruok gi tho</para>
  <para style="q2" vid="ISA 28:15">wasedonjo e winjruok gi liete omiyo,</para>
  <para style="q1" vid="ISA 28:15">ka masira miwachono nolandre e piny to ok nomulwa,</para>
  <para style="q2" vid="ISA 28:15">nimar waseketo miriambo ragengʼ-wa,</para>
  <para style="q2" vid="ISA 28:15">kendo wuondruok ka kar pondo.”<verse eid="ISA 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 28:16"/>Ma e gima Jehova Nyasaye Manyalo Gik Moko Duto wacho,</para>
  <para style="q1" vid="ISA 28:16">“Ne, aketo kidi e Sayun, ma en kidi moyier,</para>
  <para style="q2" vid="ISA 28:16">en kidi motegno, ma nengone tek,</para>
  <para style="q2" vid="ISA 28:16">moriwo kor ot kendo man-gi mise mongirore;</para>
  <para style="q1" vid="ISA 28:16">ma ngʼat moyie kuome</para>
  <para style="q2" vid="ISA 28:16">ok nobam.<verse eid="ISA 28:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 28:17"/>Abiro miyo adiera bedo tol mipimogo</para>
  <para style="q2" vid="ISA 28:17">kendo tim makare kaka rapim mirieyogo ot;</para>
  <para style="q1" vid="ISA 28:17">to kodh pe biro yweyo karu mar pondo,</para>
  <para style="q2" vid="ISA 28:17">un jo-miriambo kendo pi biro pongʼo kuondeu mag tony.<verse eid="ISA 28:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 28:18"/>Singruok maru gi tho nobed maonge;</para>
  <para style="q2" vid="ISA 28:18">kendo winjruok mane utimo gi liete ok nobedi.</para>
  <para style="q1" vid="ISA 28:18">Ka masira nomwomre,</para>
  <para style="q2" vid="ISA 28:18">to mano ema nochwadu piny.<verse eid="ISA 28:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 28:19"/>E kinde duto ma masira nobi enotieku;</para>
  <para style="q2" vid="ISA 28:19">noyweu okinyi ka okinyi kendo odiechiengʼ gotieno.”</para>
  <para style="b" vid="ISA 28:19"/>
  <para style="q1" vid="ISA 28:19">Ka wachni nodonjne ji,</para>
  <para style="q2" vid="ISA 28:19">to ginibed gi bwok maduongʼ.<verse eid="ISA 28:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 28:20"/>Kitanda nobed machiek ma ok nyal rieye tielo tir,</para>
  <para style="q2" vid="ISA 28:20">kendo onget nobed matin ma ok nyal umo ngʼato maber.<verse eid="ISA 28:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 28:21"/>To Jehova Nyasaye biro aa malo mana</para>
  <para style="q2" vid="ISA 28:21">kaka notimo e Got Perazim,</para>
  <para style="q1" vid="ISA 28:21">mirimbe nowuogi kaka ne otimore e Holo mar Gibeon,</para>
  <para style="q2" vid="ISA 28:21">mondo oti tichne, tichne mayoreyore ma ji kia</para>
  <para style="q2" vid="ISA 28:21">kendo timne mar wich teko.<verse eid="ISA 28:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 28:22"/>Koro weuru ajara mondo kik tol motweugo ridre,</para>
  <para style="q2" vid="ISA 28:22">nimar Ruoth Nyasaye ma en Jehova Nyasaye Maratego,</para>
  <para style="q2" vid="ISA 28:22">osenyisa wach mar kethruok mabiro kwako piny duto.<verse eid="ISA 28:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 28:23"/>Chik iti kendo iwinj dwonda,</para>
  <para style="q2" vid="ISA 28:23">keturu chunyu mondo uwinj weche mawacho.<verse eid="ISA 28:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 28:24"/>Ka japur puro puodho mondo okom</para>
  <para style="q2" vid="ISA 28:24">to bende osiko ka opuro apura?</para>
  <para style="q2" vid="ISA 28:24">Koso bende osiko ka obuso abusa?<verse eid="ISA 28:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 28:25"/>Kosetieko loso puothe donge ochwoyo kothe mopogore opogore</para>
  <para style="q2" vid="ISA 28:25">kendo okiro kal?</para>
  <para style="q2" vid="ISA 28:25">To donge opidho shairi kanyo kod ngano e bath puodho?<verse eid="ISA 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 28:26"/>Nyasache nyise yo monego oluw</para>
  <para style="q2" vid="ISA 28:26">kendo puonje yo maber.<verse eid="ISA 28:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 28:27"/>Cham moko ok din gi twor to</para>
  <para style="q2" vid="ISA 28:27">bende kal ok wuothie wiye gi gari;</para>
  <para style="q1" vid="ISA 28:27">moko to idino gi luth</para>
  <para style="q2" vid="ISA 28:27">kendo kal itengʼo gi kede.<verse eid="ISA 28:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 28:28"/>Ngano nyaka regi mondo olos makati;</para>
  <para style="q2" vid="ISA 28:28">omiyo ok dine amingʼa.</para>
  <para style="q1" vid="ISA 28:28">Kata obedo ni oywayo gache mar dino kuome,</para>
  <para style="q2" vid="ISA 28:28">to faresene ok rege.<verse eid="ISA 28:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 28:29"/>Magi duto bende oa kuom Jehova Nyasaye Maratego,</para>
  <para style="q2" vid="ISA 28:29">ma jangʼad rieko mowinjore,</para>
  <para style="q2" vid="ISA 28:29">kendo ma parone ber ahinya.<verse eid="ISA 28:29"/></para>
  <chapter eid="ISA 28"/>
  <chapter number="29" style="c" sid="ISA 29"/>
  <para style="s1">Siem ne Dala Maduongʼ mar Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 29:1"/>Ariel, Ariel,</para>
  <para style="q2" vid="ISA 29:1">inine malit, in dala maduongʼ mane Daudi odakie!</para>
  <para style="q1" vid="ISA 29:1">Meduru dhi nyime</para>
  <para style="q2" vid="ISA 29:1">ka utimo sewni higa ka higa.<verse eid="ISA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 29:2"/>To kata kamano abiro monjo Ariel</para>
  <para style="q2" vid="ISA 29:2">mi enobedi gi ywagruok kod kuyo,</para>
  <para style="q2" vid="ISA 29:2">kendo enochalna mana ka kendo mar misango.<verse eid="ISA 29:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 29:3"/>Abiro lwori koni gi koni,</para>
  <para style="q2" vid="ISA 29:3">mi anagoni agengʼa kendo namonji gi tekona.<verse eid="ISA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 29:4"/>Nadwoki piny miwuo mana koa ei lowo;</para>
  <para style="q2" vid="ISA 29:4">kendo wecheni nowuog mana koa ei buru.</para>
  <para style="q1" vid="ISA 29:4">Dwondi nochal mana ka dwond jachien moa ei lowo;</para>
  <para style="q2" vid="ISA 29:4">kendo koa ei lowo dwondi nowinji.<verse eid="ISA 29:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 29:5"/>To jowasiki mangʼeny nochal gi buru mayom,</para>
  <para style="q2" vid="ISA 29:5">kendo oganda mager nochal gi mihudhwe ma yamo tero.</para>
  <para style="q1" vid="ISA 29:5">Apoya nono, ka diemo wangʼ,<verse eid="ISA 29:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 29:6"/>Jehova Nyasaye Maratego nobi gi mor polo</para>
  <para style="q1" vid="ISA 29:6">gi yiengni mar piny kod koko maduongʼ,</para>
  <para style="q2" vid="ISA 29:6">gi ahiti kod kalausi kendo gi mach mager.<verse eid="ISA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 29:7"/>Eka ogendini mag pinje duto makedo gi Ariel,</para>
  <para style="q2" vid="ISA 29:7">mamonjo kuondege motegno kendo lwore,</para>
  <para style="q2" vid="ISA 29:7">biro chalo mana ka lek kata ka fweny mar otieno,<verse eid="ISA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 29:8"/>mana ka ngʼama kech kayo to leko ni chiemo,</para>
  <para style="q2" vid="ISA 29:8">to ka ochiewo to oyudo mana ka kech pod kaye,</para>
  <para style="q1" vid="ISA 29:8">kendo mana kaka ngʼat ma riyo oloyo leko ni modho pi,</para>
  <para style="q2" vid="ISA 29:8">to ka ochiewo to opodho mana piny ka riyo oloye.</para>
  <para style="q1" vid="ISA 29:8">E kaka nobedi kuom ogendini mag pinje duto makedo gi Got Sayun.<verse eid="ISA 29:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 29:9"/>Bed mobuok kendo kiwuoro,</para>
  <para style="q2" vid="ISA 29:9">dinuru wengeu kendo kik unen,</para>
  <para style="q1" vid="ISA 29:9">meruru amera to ok gi divai,</para>
  <para style="q2" vid="ISA 29:9">kendo themburu athemba to ok gi kongʼo.<verse eid="ISA 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 29:10"/>Jehova Nyasaye osekelo nindo matut kuomu,</para>
  <para style="q2" vid="ISA 29:10">oseumo wengeu (un jonabi);</para>
  <para style="q2" vid="ISA 29:10">kendo oseumo wiyeu (un jokor wach).<verse eid="ISA 29:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 29:11"/>Un to fwenyruokni duto nochalnu mana ka gima nono, mana ka kitabu modin gi duogo. To ka imiyo ngʼato manyalo somo, miwachone niya, “Yie isom kitabuni,” to obiro dwoko niya, “Ok anyal some nikech odine gi duogo.” <verse eid="ISA 29:11"/><verse number="12" style="v" sid="ISA 29:12"/>Kata ka imiyo ngʼat makia somo miwachone niya, “Yie isomna kitabuni,” to obiro dwoko niya, “Ok angʼeyo somo.”<verse eid="ISA 29:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 29:13"/>Ruoth Nyasaye wacho niya:</para>
  <para style="q1" vid="ISA 29:13">Jogi sudo ira mana gi weche manie dhogi</para>
  <para style="q2" vid="ISA 29:13">kendo gipaka mana gi dhogi kende,</para>
  <para style="q2" vid="ISA 29:13">to chunygi bor koda.</para>
  <para style="q1" vid="ISA 29:13">Yo ma gilamago</para>
  <para style="q2" vid="ISA 29:13">gin mana chike mipuonjo gi dhano.<verse eid="ISA 29:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 29:14"/>Kuom mano anachak abwog chuny jogi</para>
  <para style="q2" vid="ISA 29:14">gi masira bangʼ masira,</para>
  <para style="q1" vid="ISA 29:14">mi rieko mar jorieko nolal</para>
  <para style="q2" vid="ISA 29:14">kendo ngʼeyo mar joma ongʼeyo norum.<verse eid="ISA 29:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 29:15"/>Ginine malit jogo maparo timo gimoro amora</para>
  <para style="q2" vid="ISA 29:15">mondo gipandgo timbegi ne Jehova Nyasaye,</para>
  <para style="q1" vid="ISA 29:15">ma gin joma timo timbegi e mudho ka giparo niya,</para>
  <para style="q2" vid="ISA 29:15">“Ere ngʼama nenowa? En ngʼa mabiro ngʼeyo?”<verse eid="ISA 29:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 29:16"/>Iloko gik moko ataro,</para>
  <para style="q2" vid="ISA 29:16">mana ka gima jachwech bende chal gi lowo mochweyo!</para>
  <para style="q1" vid="ISA 29:16">Bende gima ochwe nyalo wachone jachwechne niya,</para>
  <para style="q2" vid="ISA 29:16">“Ne ok ichweya?”</para>
  <para style="q1" vid="ISA 29:16">Koso agulu bende nyalo wachone jachwechne niya,</para>
  <para style="q2" vid="ISA 29:16">“Onge gima ingʼeyo?”<verse eid="ISA 29:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 29:17"/>Kuom ndalo matin kende, donge Lebanon nolok mana ka puodho momewo</para>
  <para style="q2" vid="ISA 29:17">kendo puodho momewo nochal mana gi bungu?<verse eid="ISA 29:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 29:18"/>E kindeno joma itgi odino nowinj</para>
  <para style="q2" vid="ISA 29:18">weche manie kitabu, mi joma osebedo kokuyo,</para>
  <para style="q2" vid="ISA 29:18">kendo manie mudho mandiwa wengegi nonen.<verse eid="ISA 29:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 29:19"/>Joma obolore nochak obed gi mor kuom Jehova Nyasaye;</para>
  <para style="q2" vid="ISA 29:19">kendo joma ochando,</para>
  <para style="q2" vid="ISA 29:19">bende nobed gi mor kuom Jal Maler mar Israel.<verse eid="ISA 29:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 29:20"/>Joma timbegi mono nolal nono,</para>
  <para style="q2" vid="ISA 29:20">jo-jar ji bende nolal nono,</para>
  <para style="q2" vid="ISA 29:20">kendo jogo duto ma timbegi mono notieki;<verse eid="ISA 29:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 29:21"/>gin jogo machiwo neno mar miriambo</para>
  <para style="q2" vid="ISA 29:21">mondo omi ngʼato onere ni jaketho,</para>
  <para style="q1" vid="ISA 29:21">kendo mawuondo jangʼad bura</para>
  <para style="q2" vid="ISA 29:21">mi omi ngʼat maonge ketho tamie adierane.<verse eid="ISA 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 29:22"/>Kuom mano ma e wach ma Jehova Nyasaye, mane oreso Ibrahim wachone od Jakobo ni,</para>
  <para style="q1" vid="ISA 29:22">Jakobo ok none wichkuot kendo;</para>
  <para style="q2" vid="ISA 29:22">bende ok ginichak ginenre mokuyo.<verse eid="ISA 29:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 29:23"/>Ka gineno nyithindgi ma tich lweta e kindgi,</para>
  <para style="q1" vid="ISA 29:23">to gibiro rito nyinga obed maler,</para>
  <para style="q2" vid="ISA 29:23">kendo gibiro yie kuom ler mar Jal Maler mar Jakobo,</para>
  <para style="q1" vid="ISA 29:23">kendo gichungʼ e nyim Nyasach Israel gi luor maduongʼ.<verse eid="ISA 29:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 29:24"/>Joma parogi bayo noyud rieko;</para>
  <para style="q2" vid="ISA 29:24">kendo joma kwedo wach bende nopuonji.<verse eid="ISA 29:24"/></para>
  <chapter eid="ISA 29"/>
  <chapter number="30" style="c" sid="ISA 30"/>
  <para style="s1">Siem ne ogandana wigi tek</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 30:1"/>Jehova Nyasaye wacho niya,</para>
  <para style="q2" vid="ISA 30:1">“Ubiro neno malit, un nyithindo ma wigi tek,</para>
  <para style="q1" vid="ISA 30:1">un jogo mosieko gi riekni ma ok maga,</para>
  <para style="q2" vid="ISA 30:1">ka uloso riwruok ka ok owuok e dwond Roho mara,</para>
  <para style="q2" vid="ISA 30:1">kendo ka ubiwo richo ewi richo;<verse eid="ISA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 30:2"/>uringo kudhi Misri ka ok upenja,</para>
  <para style="q1" vid="ISA 30:2">umanyo kony kuom Farao mondo oresu,</para>
  <para style="q2" vid="ISA 30:2">kendo ugengʼoru e tipo mar Misri kaka karu mar pondo.<verse eid="ISA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 30:3"/>To gengʼruok mawuok kuom Farao nobednu wichkuot,</para>
  <para style="q2" vid="ISA 30:3">kendo tipo mar Misri nokelnu masira.<verse eid="ISA 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 30:4"/>Kata obedo ni gin gi jotelo Zoan</para>
  <para style="q2" vid="ISA 30:4">kendo jootene osechopo Hanes,<verse eid="ISA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 30:5"/>to ji duto noyud wichkuot</para>
  <para style="q2" vid="ISA 30:5">kuom jogo ma ok nyal konyogi,</para>
  <para style="q1" vid="ISA 30:5">jogo ma ok nyal konyogi kata kelonegi ber</para>
  <para style="q2" vid="ISA 30:5">to mana wichkuot kod achaya.”<verse eid="ISA 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 30:6"/>Ma e wach mane okor kuom le mag Negev:</para>
  <para style="q2" vid="ISA 30:6">Kokadho e piny mar chandruok kod masira,</para>
  <para style="q1" vid="ISA 30:6">motingʼo sibuoche machwo to gi mamon</para>
  <para style="q2" vid="ISA 30:6">bende kama thuonde mag bungu kod thuonde maringo piyo odakie,</para>
  <para style="q1" vid="ISA 30:6">jootegi tingʼo mwandugi e ngʼe</para>
  <para style="q2" vid="ISA 30:6">punde kendo girkeni mag-gi otingʼ e kuom ngamia,</para>
  <para style="q2" vid="ISA 30:6">kiterone oganda maonge ohala,<verse eid="ISA 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 30:7"/>ma en Misri, ma kony mare onge tiende.</para>
  <para style="q2" vid="ISA 30:7">Kuom mano iluonge ni Rahab maonge nyalo.<verse eid="ISA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 30:8"/>Dhiyo sani kendo indiknegi wach e kidi mopa,</para>
  <para style="q2" vid="ISA 30:8">Ndike e kitabu, mondo omi obed janeno,</para>
  <para style="q2" vid="ISA 30:8">manyaka chiengʼ e ndalo mabiro.<verse eid="ISA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 30:9"/>Magi gin oganda mongʼanyo nyithindo ma jo-miriambo,</para>
  <para style="q2" vid="ISA 30:9">ma ok oikore winjo puonj Jehova Nyasaye.<verse eid="ISA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 30:10"/>Giwachone jokor wach ni,</para>
  <para style="q2" vid="ISA 30:10">“Kik une fweny moro amora kendo!”</para>
  <para style="q1" vid="ISA 30:10">To ne jonabi,</para>
  <para style="q2" vid="ISA 30:10">“Kik uchak unyiswa fweny moro amora makare!”</para>
  <para style="q1" vid="ISA 30:10">Kornwauru mana weche mamorowa mag wuondruok.<verse eid="ISA 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 30:11"/>Weuru yorni, wuoguru e ndarani</para>
  <para style="q2" vid="ISA 30:11">kendo we bwogowa gi Jal Maler mar Israel.<verse eid="ISA 30:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 30:12"/>Kuom mano, ma e wach ma Jal Maler mar Israel wacho:</para>
  <para style="q1" vid="ISA 30:12">“Nikech isedagi winjo oteni,</para>
  <para style="q1" vid="ISA 30:12">mi iserwako chuny mar sando ji kendo iseyiengori e timbe mag miganga,<verse eid="ISA 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 30:13"/>richoni nobini kaka ohinga mabor mobarore,</para>
  <para style="q2" vid="ISA 30:13">matetni kendo ruombore piny matek dichiel.<verse eid="ISA 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 30:14"/>Obiro ngʼinjore matindo tindo mana</para>
  <para style="q2" vid="ISA 30:14">ka agulu molwar piny motore,</para>
  <para style="q1" vid="ISA 30:14">ma ok nyal yud kata dire moro kodongʼ</para>
  <para style="q2" vid="ISA 30:14">minyalo kwanygo mach e dwol kata pate mitwomogo pi.”<verse eid="ISA 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 30:15"/>Ma e gima Jehova Nyasaye Manyalo Gik Moko Duto, Jal Maler mar Israel wacho:</para>
  <para style="q1" vid="ISA 30:15">“Warruok gi kwe nowuog kuom hulo richo,</para>
  <para style="q2" vid="ISA 30:15">tekou nowuog kuom horuok kod genou kuoma,</para>
  <para style="q1" vid="ISA 30:15">to kata onge gima usetimo kuom gigi duto.<verse eid="ISA 30:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 30:16"/>Kata kamano uwacho ni,</para>
  <para style="q2" vid="ISA 30:16">‘Ooyo, wabiro idho farese mondo waringi.’</para>
  <para style="q2" vid="ISA 30:16">To mano ber ubiro ringo!</para>
  <para style="q1" vid="ISA 30:16">Bende nuwacho ni,</para>
  <para style="q2" vid="ISA 30:16">‘Wabiro idho faresewa mi waringi.’</para>
  <para style="q2" vid="ISA 30:16">Kuom mano joma lawou nobed jongʼwech molony.<verse eid="ISA 30:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 30:17"/>Jou alufu achiel noringi</para>
  <para style="q2" vid="ISA 30:17">ka ngʼato achiel obwogogi;</para>
  <para style="q1" vid="ISA 30:17">bende jou noring duto ka ji abich obwogogi,</para>
  <para style="q2" vid="ISA 30:17">mi unudongʼ kar kendu,</para>
  <para style="q1" vid="ISA 30:17">mana ka yiend bandera mochwo ewi got malo</para>
  <para style="q2" vid="ISA 30:17">kata ka law bandera mafwadhore ewi got.”<verse eid="ISA 30:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 30:18"/>Kata kamano pod odwaro nyiso</para>
  <para style="q1" vid="ISA 30:18">ngʼwono mare kuome; obiro mondo onyisu kech mare.</para>
  <para style="q2" vid="ISA 30:18">Nimar Jehova Nyasaye en Nyasaye ma ja-adiera.</para>
  <para style="q2" vid="ISA 30:18">Jogo duto mogeno kuome ogwedhi.<verse eid="ISA 30:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 30:19"/>Yaye un oganda mag Sayun, modak Jerusalem, ok unuchak uywag kendo. Mano kaka notimnu ngʼwono e kinde ma unuywagne mondo okonyu! E sa moro amora mowinjo ywaku, to nokonyu. <verse eid="ISA 30:19"/><verse number="20" style="v" sid="ISA 30:20"/>Kata Jehova Nyasaye miyou chiemo mar chandruok kod pi mar masira, to jopuonju ok nochak opondnu kendo, to ununegi gi wengeu uwegi. <verse eid="ISA 30:20"/><verse number="21" style="v" sid="ISA 30:21"/>Kata ka ubaro korachwich kata koracham, itu to nowinj dwol mawuok ka ngʼeu, kawacho niya, “Ma e yo; luweuru.” <verse eid="ISA 30:21"/><verse number="22" style="v" sid="ISA 30:22"/>Bangʼe unudwany nyisecheu manono mubawo gi fedha kod dhahabu; kendo unuwitgi ka ukwano gi ka gik ma ok ler, mi uwitgi ka nanga moywego remb nyodo, kuwachonegi niya, “Aiuru ira.”<verse eid="ISA 30:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 30:23"/>Bende noornu koth kuom kodhi muchwowo e lowo kendo chiemo mawuok e piny nobed mamiyo kendo mangʼeny. E kindeno jambu nokwa e lege madongo. <verse eid="ISA 30:23"/><verse number="24" style="v" sid="ISA 30:24"/>Rwethu kod pundeu mapuro lowo nocham lumb ogada kod chiembgi moregi, mi keyo gi uma kod opawo. <verse eid="ISA 30:24"/><verse number="25" style="v" sid="ISA 30:25"/>E odiechiengʼ maduongʼ mar yengʼo, ka kuonde ngʼicho motingʼore gi malo opodho, oula mag pige nomol ewi gode duto kod pidhe duto motingʼore malo. <verse eid="ISA 30:25"/><verse number="26" style="v" sid="ISA 30:26"/>Dwe norieny ka wangʼ chiengʼ, kendo ler mar chiengʼ nobed maler moloyo kaka orieny pile nyadibiriyo, machal mana gi ler mar chiengʼ mar ndalo abiriyo, e kindeno ma Jehova Nyasaye nowir kuonde duto moriemo mag joge kendo nochang adhondegi.<verse eid="ISA 30:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 30:27"/>Ne, Nying Jehova Nyasaye aa kuma bor,</para>
  <para style="q2" vid="ISA 30:27">ka en-gi mirima mager machalo gi iro mopongʼo bor polo;</para>
  <para style="q1" vid="ISA 30:27">dhoge opongʼ gi mirima mangʼeny,</para>
  <para style="q2" vid="ISA 30:27">kendo lewe en mach mawengʼo.<verse eid="ISA 30:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 30:28"/>Muche chalo gi oula mopongʼ,</para>
  <para style="q2" vid="ISA 30:28">mopongʼ nyaka dwonde.</para>
  <para style="q1" vid="ISA 30:28">Oyiengo ogendini gi rapiedhi mar kethruok;</para>
  <para style="q2" vid="ISA 30:28">kendo oywayo ji gi chuma mamiyo girwenyo.<verse eid="ISA 30:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 30:29"/>Kendo unuwer wende machalo gi wende mag nyasi</para>
  <para style="q2" vid="ISA 30:29">mag sawo maler miwero gotieno;</para>
  <para style="q1" vid="ISA 30:29">chunyu nobed gi mor mana ka ji mabedo gi mor</para>
  <para style="q2" vid="ISA 30:29">ka goyo asili kadhi e got Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 30:29">ma en Lwanda mar Israel.<verse eid="ISA 30:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 30:30"/>Jehova Nyasaye nomi oganda winj dwonde mar duongʼ</para>
  <para style="q2" vid="ISA 30:30">kendo enomi gine lwete kabiro piny,</para>
  <para style="q1" vid="ISA 30:30">gi mirima mager kod mach mawengʼo,</para>
  <para style="q2" vid="ISA 30:30">bende gi rumbi motwere gi polo mariadore kod pe.<verse eid="ISA 30:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 30:31"/>Dwond Jehova Nyasaye biro mako dho jo-Asuria;</para>
  <para style="q2" vid="ISA 30:31">to gi odungane obiro negogi.<verse eid="ISA 30:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 30:32"/>Chwat ka chwat ma Jehova Nyasaye nochwadgigo</para>
  <para style="q2" vid="ISA 30:32">gi ludhe mar kum kokedo kodgi malit,</para>
  <para style="q1" vid="ISA 30:32">nomi jo-Nyasaye bed mamor</para>
  <para style="q2" vid="ISA 30:32">ka gigoyo oyieke kod nyatiti.<verse eid="ISA 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="ISA 30:33"/>Tofeth noseiki nyaka aa chon;</para>
  <para style="q2" vid="ISA 30:33">noseik ne ruoth.</para>
  <para style="q1" vid="ISA 30:33">Kare mar kendo osekuny matut kendo malach,</para>
  <para style="q2" vid="ISA 30:33">kodhurie yiende mangʼeny gi mach maduongʼ;</para>
  <para style="q1" vid="ISA 30:33">kendo much Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 30:33">machalo mach makakni ema moke.<verse eid="ISA 30:33"/></para>
  <chapter eid="ISA 30"/>
  <chapter number="31" style="c" sid="ISA 31"/>
  <para style="s1">Siem ne joma oketo genogi kuom Misri</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 31:1"/>Mano kaka unune malit,</para>
  <para style="q2" vid="ISA 31:1">jogo madhi dwaro kony Misri,</para>
  <para style="q1" vid="ISA 31:1">moketo genogi kuom farese,</para>
  <para style="q2" vid="ISA 31:1">kendo moketo genogi kuom geche mag lweny mangʼeny magiywayo,</para>
  <para style="q1" vid="ISA 31:1">kendo kuom teko maduongʼ ma joidh faresegi nigo,</para>
  <para style="q2" vid="ISA 31:1">to ok uketo genou kuom Jal Maler mar Israel,</para>
  <para style="q2" vid="ISA 31:1">kata dwaro kony kuom Jehova Nyasaye.<verse eid="ISA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 31:2"/>Kata kamano en bende en gi rieko</para>
  <para style="q2" vid="ISA 31:2">kendo onyalo kelo chandruok;</para>
  <para style="q1" vid="ISA 31:2">bende ok olok pache e gima osewacho.</para>
  <para style="q2" vid="ISA 31:2">Obiro kumo joma timbegi mono,</para>
  <para style="q2" vid="ISA 31:2">kaachiel gi joricho makonyogi.<verse eid="ISA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 31:3"/>To jo-Misri gin mana dhano ma ok Nyasaye;</para>
  <para style="q2" vid="ISA 31:3">bende faresegi gin mana ringʼo ma ok roho.</para>
  <para style="q1" vid="ISA 31:3">Ka Jehova Nyasaye norie bade mar kum,</para>
  <para style="q2" vid="ISA 31:3">jogo machiwo kony nochwanyre,</para>
  <para style="q1" vid="ISA 31:3">kendo jogo mikonyo nopodh piny;</para>
  <para style="q2" vid="ISA 31:3">giduto ginilal nono.<verse eid="ISA 31:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 31:4"/>Ma e gima Jehova Nyasaye wachona:</para>
  <para style="q1" vid="ISA 31:4">Mana kaka sibuor ngʼur konyono chiayo mosemako piny,</para>
  <para style="q2" vid="ISA 31:4">kendo kata obedo ni jokwath duto oyworo ka goyo koko,</para>
  <para style="q2" vid="ISA 31:4">to ok odew bende ok oluor,</para>
  <para style="q1" vid="ISA 31:4">e kaka Jehova Nyasaye Maratego,</para>
  <para style="q2" vid="ISA 31:4">biro biro mondo oked ewi got Sayun.<verse eid="ISA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 31:5"/>Mana kaka winy mafuyo malo,</para>
  <para style="q2" vid="ISA 31:5">e kaka Jehova Nyasaye Maratego nochiel Jerusalem;</para>
  <para style="q1" vid="ISA 31:5">nogengʼe kendo norese, noume kendo nokonye.<verse eid="ISA 31:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 31:6"/>Dwoguru ire, yaye un jo-Israel</para>
  <para style="q2" vid="ISA 31:6">mosengʼanyo mabor kode.<verse eid="ISA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 31:7"/>Nimar e odiechiengno ngʼato ka ngʼato kuomu nowiti</para>
  <para style="q2" vid="ISA 31:7">nyiseche mag fedha kod dhahabu,</para>
  <para style="q2" vid="ISA 31:7">ma lwetu motimo richo oseloso.<verse eid="ISA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 31:8"/>Jehova Nyasaye wacho niya,</para>
  <para style="q2" vid="ISA 31:8">“Jo-Asuria ibiro tieki gi ligangla ma ok oa e lwet dhano;</para>
  <para style="q2" vid="ISA 31:8">nimar ligangla ma ok oa e lwedo biro tiekogi.</para>
  <para style="q1" vid="ISA 31:8">Giniring lweny nikech ligangla, mi yawuotgi ma</para>
  <para style="q2" vid="ISA 31:8">jolweny nolokgi wasumbini maketgi e tij achuna.<verse eid="ISA 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 31:9"/>Kuondegi mochiel motegno nopodhi mi gidhier nono,</para>
  <para style="q2" vid="ISA 31:9">kendo jotendgi mag lweny,</para>
  <para style="q2" vid="ISA 31:9">kibaji nogo ma ok ginyal ringo,” Jehova Nyasaye wacho,</para>
  <para style="q1" vid="ISA 31:9">en ma maye liel koa Sayun,</para>
  <para style="q2" vid="ISA 31:9">kendo maye mangʼangʼni ni Jerusalem.<verse eid="ISA 31:9"/></para>
  <chapter eid="ISA 31"/>
  <chapter number="32" style="c" sid="ISA 32"/>
  <para style="s1">Pinyruoth makare</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 32:1"/>Winjuru, Ruoth nobed gi loch makare</para>
  <para style="q2" vid="ISA 32:1">kendo jotelo nobed gi telo mar adier.<verse eid="ISA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 32:2"/>Ngʼato ka ngʼato nobed kar gengʼruok</para>
  <para style="q2" vid="ISA 32:2">ne kalausi mana ka aore mamol e piny ongoro,</para>
  <para style="q1" vid="ISA 32:2">kendo mana ka tipo mar Lwanda maduongʼ e piny motwo.<verse eid="ISA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 32:3"/>Eka wenge joma neno ok nochak ogengʼ,</para>
  <para style="q2" vid="ISA 32:3">kendo joma ochiko itgi nowinj wach.<verse eid="ISA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 32:4"/>Chuny ngʼat mamuomore nowinj wach gi tiende</para>
  <para style="q2" vid="ISA 32:4">kendo ngʼat ma radwal nowuo maber kendo maliw.<verse eid="ISA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 32:5"/>Ok nochak oluong ngʼat mofuwo ni ngʼat malongʼo,</para>
  <para style="q2" vid="ISA 32:5">kata ngʼat ma ja-miganga ni ngʼat ma ogen.<verse eid="ISA 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 32:6"/>Nimar ngʼat mofuwo wacho weche mofuwo,</para>
  <para style="q2" vid="ISA 32:6">kendo opongʼ gi richo:</para>
  <para style="q1" vid="ISA 32:6">Otimo timbe mag richo</para>
  <para style="q2" vid="ISA 32:6">kendo olando miriambo kuom Jehova Nyasaye;</para>
  <para style="q1" vid="ISA 32:6">mi omon joma odenyo chamo gik monego gicham</para>
  <para style="q2" vid="ISA 32:6">kendo joma riyo oloyo otamoe pi.<verse eid="ISA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 32:7"/>Ngʼat ma achach yorene richo,</para>
  <para style="q2" vid="ISA 32:7">osiko ka chunye chano mana timo richo,</para>
  <para style="q1" vid="ISA 32:7">kotieko jodhier gi miriambo kata obedo ni</para>
  <para style="q2" vid="ISA 32:7">ywak mar joma ni e chandruok nikare.<verse eid="ISA 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 32:8"/>To ngʼat mogen loso weche mabeyo</para>
  <para style="q2" vid="ISA 32:8">kendo kuom timbe makare miyo ochungʼ motegno.<verse eid="ISA 32:8"/></para>
  <para style="s1">Mond Jerusalem</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 32:9"/>Un mon maparo ni odak e ngima maber,</para>
  <para style="q2" vid="ISA 32:9">auru malo kendo uwinj wachna,</para>
  <para style="q1" vid="ISA 32:9">un nyiri modak gi kwe,</para>
  <para style="q2" vid="ISA 32:9">winjuru gima awacho!<verse eid="ISA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 32:10"/>Bangʼ higa achiel,</para>
  <para style="q2" vid="ISA 32:10">un ma uparo nudak mokwe, kibaji nogou;</para>
  <para style="q1" vid="ISA 32:10">cham ok nochiegi,</para>
  <para style="q2" vid="ISA 32:10">kendo keyo mar mzabibu ok nobedie.<verse eid="ISA 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 32:11"/>Beduru moluor un mon maparo nodak e ngima maber;</para>
  <para style="q2" vid="ISA 32:11">beduru mokuyo, un nyiri maparo nodak gi kwe!</para>
  <para style="q2" vid="ISA 32:11">Lonyreuru duge kendo utwe piende gugru enungou.<verse eid="ISA 32:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 32:12"/>Ywaguru ka ugoyo agogu nikech puothe momewo,</para>
  <para style="q2" vid="ISA 32:12">nikech olembe mag mzabibu,<verse eid="ISA 32:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 32:13"/>kendo kuom piny joga,</para>
  <para style="q2" vid="ISA 32:13">piny mopongʼ gi kuthe kod pedo,</para>
  <para style="q1" vid="ISA 32:13">ee, ywaguru udi ma yande mor opongʼo</para>
  <para style="q2" vid="ISA 32:13">kendo kuom dala maduongʼ mar mor gi ilo masani odongʼ nono.<verse eid="ISA 32:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 32:14"/>Kama ochiel motegno nojwangʼ,</para>
  <para style="q2" vid="ISA 32:14">dala maduongʼ nodongʼ gunda;</para>
  <para style="q1" vid="ISA 32:14">kama ochiel motegno mag siro lweny kod kar ngʼicho</para>
  <para style="q2" vid="ISA 32:14">nodongʼ kama punda bukore, kod kar kwadh jamni,<verse eid="ISA 32:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 32:15"/>nyaka chop Roho ol kuomwa koa malo,</para>
  <para style="q2" vid="ISA 32:15">kendo piny motwo nolokre kuonde mamiyo,</para>
  <para style="q2" vid="ISA 32:15">mi kuonde mamiyo nonenre ka bungu.<verse eid="ISA 32:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 32:16"/>Adiera nobedie e piny motwo,</para>
  <para style="q2" vid="ISA 32:16">mi tim makare nodag e puodho mamiyo.<verse eid="ISA 32:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 32:17"/>Olemb tim makare nobed kwe;</para>
  <para style="q2" vid="ISA 32:17">to tim makare nokel horuok gi chir nyaka chiengʼ.<verse eid="ISA 32:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 32:18"/>Joga nodag kuonde ma kwe nitie,</para>
  <para style="q2" vid="ISA 32:18">e mier moger motegno,</para>
  <para style="q2" vid="ISA 32:18">kendo kuonde ma kwe nitie ma koko ongee.<verse eid="ISA 32:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 32:19"/>Kata obedo ni pe nolwer bunge</para>
  <para style="q2" vid="ISA 32:19">kendo dala maduongʼ nopodh chuth,<verse eid="ISA 32:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 32:20"/>to mano kaka inibed ngʼama ogwedhi,</para>
  <para style="q2" vid="ISA 32:20">ka ichwoyo chambi e bath aore duto,</para>
  <para style="q1" vid="ISA 32:20">kendo ka iweyo jambi kod punde magi wuotho awuotha kaka ohero.<verse eid="ISA 32:20"/></para>
  <chapter eid="ISA 32"/>
  <chapter number="33" style="c" sid="ISA 33"/>
  <para style="s1">Achiedh-nade kod resruok</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 33:1"/>Unune malit un joma osetieko ji, to pok otieku!</para>
  <para style="q2" vid="ISA 33:1">Unune malit un joma osendhogo ji, to un pok ondhogu!</para>
  <para style="q1" vid="ISA 33:1">Ka uweyo tieko ji to notieku;</para>
  <para style="q2" vid="ISA 33:1">bende ka uweyo ndhogo ji to nondhogu.<verse eid="ISA 33:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 33:2"/>Yaye Jehova Nyasaye, yie ikechwa;</para>
  <para style="q2" vid="ISA 33:2">nimar chunywa dwari.</para>
  <para style="q1" vid="ISA 33:2">Miwae teko okinyi ka okinyi,</para>
  <para style="q2" vid="ISA 33:2">kendo bednwa kar resruok,</para>
  <para style="q2" vid="ISA 33:2">e kinde mag chandruok.<verse eid="ISA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 33:3"/>Ka dwondi omor to ji ringo;</para>
  <para style="q2" vid="ISA 33:3">ka ia malo to ogendini ke.<verse eid="ISA 33:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 33:4"/>Yaye un ogendini,</para>
  <para style="q2" vid="ISA 33:4">mwandu noyaki mana ka kama nyithi bonyo omonjo;</para>
  <para style="q1" vid="ISA 33:4">kendo ji noyak mwandugi,</para>
  <para style="q2" vid="ISA 33:4">mana kaka bonyo monjo piny.<verse eid="ISA 33:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 33:5"/>Nying Jehova Nyasaye otingʼ malo, nimar odak e polo;</para>
  <para style="q2" vid="ISA 33:5">obiro pongʼo Sayun gi tim makare kod adiera.<verse eid="ISA 33:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 33:6"/>Enobed mise mar adier e ndalou,</para>
  <para style="q2" vid="ISA 33:6">kar mwandu mar resruok gi rieko kod ngʼeyo;</para>
  <para style="q2" vid="ISA 33:6">luoro Jehova Nyasaye e rayaw mar mwanduni.<verse eid="ISA 33:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 33:7"/>To neuru kaka thuondige ywak malit e wangʼ yore;</para>
  <para style="q2" vid="ISA 33:7">joote ma oseor mondo odwar kwe ywak malit.<verse eid="ISA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 33:8"/>Yore osedongʼ nono,</para>
  <para style="q2" vid="ISA 33:8">kendo onge jowuoth e yo.</para>
  <para style="q1" vid="ISA 33:8">Winjruok osekethi mi joma nobedo joneno ok dew,</para>
  <para style="q2" vid="ISA 33:8">kendo onge ngʼama omi luor.<verse eid="ISA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 33:9"/>Piny ywak kendo dok chien,</para>
  <para style="q2" vid="ISA 33:9">Lebanon ni e wichkuot kendo okethore,</para>
  <para style="q1" vid="ISA 33:9">Sharon olokore ongoro ka Araba,</para>
  <para style="q2" vid="ISA 33:9">kendo Bashan gi Karmel oyaki modongʼ nono.<verse eid="ISA 33:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 33:10"/>Jehova Nyasaye wacho niya,</para>
  <para style="q2" vid="ISA 33:10">“Koro abiro aa malo,</para>
  <para style="q2" vid="ISA 33:10">mondo anyisu duongʼna gi tekona.<verse eid="ISA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 33:11"/>Ubiro mako ich to unywolo yamo;</para>
  <para style="q2" vid="ISA 33:11">muya muyweyo en mach ma tiekou.<verse eid="ISA 33:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 33:12"/>Ogendini nowangʼ,</para>
  <para style="q2" vid="ISA 33:12">mi lokre pidhe mag buru,</para>
  <para style="q1" vid="ISA 33:12">kendo mana kaka kudho mobet e bungu</para>
  <para style="q2" vid="ISA 33:12">enowangʼ gi mach!”<verse eid="ISA 33:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 33:13"/>Un mudak mabor,</para>
  <para style="q2" vid="ISA 33:13">winjuru gima asetimo,</para>
  <para style="q2" vid="ISA 33:13">un mudak machiegni ngʼeuru tekona!<verse eid="ISA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 33:14"/>Joricho man Sayun,</para>
  <para style="q2" vid="ISA 33:14">kihondko osemako;</para>
  <para style="q2" vid="ISA 33:14">kibaji ogoyo joma okia nyasaye,</para>
  <para style="q1" vid="ISA 33:14">mi gisepenjore kendgi niya,</para>
  <para style="q2" vid="ISA 33:14">“En ngʼa kuomwa manyalo dak kod mach mawengʼo magerni?</para>
  <para style="q1" vid="ISA 33:14">Koso en ngʼa kuomwa manyalo</para>
  <para style="q1" vid="ISA 33:14">dak kod mach maliel maonge gikone?”<verse eid="ISA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 33:15"/>Ngʼatno mawuotho e ratiro</para>
  <para style="q2" vid="ISA 33:15">kendo wacho gima adiera,</para>
  <para style="q1" vid="ISA 33:15">ma tamore yudo ohala e yor mecho</para>
  <para style="q2" vid="ISA 33:15">kendo ok oyie kawo asoya,</para>
  <para style="q2" vid="ISA 33:15">ngʼatno ma ok chik ite e chenro mar neko,</para>
  <para style="q1" vid="ISA 33:15">kendo odino wengene e neno timbe mamono,<verse eid="ISA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 33:16"/>ma e ngʼama nodagi kuonde motingʼore gi malo,</para>
  <para style="q2" vid="ISA 33:16">ma kare mar pondo nobedi got mochiel gohinga motegno.</para>
  <para style="q1" vid="ISA 33:16">Chiembe ibiro chiw,</para>
  <para style="q2" vid="ISA 33:16">kendo pi ok nodwon-ne.<verse eid="ISA 33:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 33:17"/>Wengeni biro neno ruoth</para>
  <para style="q2" vid="ISA 33:17">kober kendo iningʼi piny molandore malach.<verse eid="ISA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 33:18"/>E pachi inipar masiche machon:</para>
  <para style="q2" vid="ISA 33:18">“Ere jatelo maduongʼ cha?</para>
  <para style="q1" vid="ISA 33:18">Ere ngʼatno mane okawo osuru?</para>
  <para style="q2" vid="ISA 33:18">Ere jatelo mochungʼne kuonde ngʼicho man malo?”<verse eid="ISA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 33:19"/>Ok inichak ine jonjorego kendo,</para>
  <para style="q2" vid="ISA 33:19">jogo ma wechegi oyombore,</para>
  <para style="q2" vid="ISA 33:19">kendo mawacho dhok matek winjo.<verse eid="ISA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 33:20"/>Ka irango Sayun,</para>
  <para style="q2" vid="ISA 33:20">dala maduongʼ mar sewniwa moyier;</para>
  <para style="q2" vid="ISA 33:20">ibiro neno Jerusalem kama kwe nitie,</para>
  <para style="q1" vid="ISA 33:20">hema ma ok bi muki;</para>
  <para style="q2" vid="ISA 33:20">loje mage ok nopudhi, kata tondene ok nochodi.<verse eid="ISA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 33:21"/>Kanyo Jehova Nyasaye biro bedonwa Jal Maratego.</para>
  <para style="q2" vid="ISA 33:21">Kanyo nochalnwa ka aore kod mago matindo.</para>
  <para style="q1" vid="ISA 33:21">Yiedhi man-gi tanga ok nokwangʼ kanyo,</para>
  <para style="q2" vid="ISA 33:21">meli maduongʼ ok nokwangʼ e aore.<verse eid="ISA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 33:22"/>Nimar Jehova Nyasaye e jangʼadnwa bura,</para>
  <para style="q2" vid="ISA 33:22">Jehova Nyasaye e jaketonwa chik,</para>
  <para style="q1" vid="ISA 33:22">kendo Jehova Nyasaye e ruodhwa;</para>
  <para style="q2" vid="ISA 33:22">en ema obiro resowa.<verse eid="ISA 33:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 33:23"/>Tondegi mag meli obwodhore:</para>
  <para style="q2" vid="ISA 33:23">Tanga ok otwe motegno,</para>
  <para style="q2" vid="ISA 33:23">ok ginyal kwangʼ maber.</para>
  <para style="q1" vid="ISA 33:23">Eka gik moyaki ibiro pogi</para>
  <para style="q2" vid="ISA 33:23">kendo kata mana joma rongʼonde noyud pok.<verse eid="ISA 33:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 33:24"/>Onge ngʼama odak Sayun manowachi niya, “Atuo,”</para>
  <para style="q2" vid="ISA 33:24">kendo richo mag joma odak kanyo nowenegi.<verse eid="ISA 33:24"/></para>
  <chapter eid="ISA 33"/>
  <chapter number="34" style="c" sid="ISA 34"/>
  <para style="s1">Kum ne ogendini</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 34:1"/>Suduru machiegni,</para>
  <para style="q2" vid="ISA 34:1">un ogendini kendo chikuru itu;</para>
  <para style="q1" vid="ISA 34:1">winjuru, un ogendini!</para>
  <para style="q2" vid="ISA 34:1">Mad piny kod gik moko manie iye winja!<verse eid="ISA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 34:2"/>Jehova Nyasaye nigi ich wangʼ kod ogendini duto;</para>
  <para style="q2" vid="ISA 34:2">mirimbe ochomo jolweny mag-gi duto.</para>
  <para style="q1" vid="ISA 34:2">Obiro tiekogi duto,</para>
  <para style="q2" vid="ISA 34:2">mi nochiwgi mondo otiekgi.<verse eid="ISA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 34:3"/>Jogi monegi nowit oko,</para>
  <para style="q2" vid="ISA 34:3">mi ringregi nodungʼ kendo rembgi nopongʼ gode.<verse eid="ISA 34:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 34:4"/>Sulwe duto manie polo noleny nono,</para>
  <para style="q2" vid="ISA 34:4">polo noban mana ka kalatas,</para>
  <para style="q2" vid="ISA 34:4">gik moko duto manie polo malo nolwar,</para>
  <para style="q1" vid="ISA 34:4">mana ka it mzabibu moner,</para>
  <para style="q2" vid="ISA 34:4">kata ka olemb ngʼowu ma kundi ochwowo.<verse eid="ISA 34:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 34:5"/>Liganglana osetieko tichne e kor lwasi,</para>
  <para style="q2" vid="ISA 34:5">neuru, olor mondo ongʼad bura ne Edom,</para>
  <para style="q2" vid="ISA 34:5">oganda ma asetieko chuth.<verse eid="ISA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 34:6"/>Ligangla mar Jehova Nyasaye opongʼ gi remo,</para>
  <para style="q2" vid="ISA 34:6">kendo boche ogawore kuome ma gin, remb rombe kod diek,</para>
  <para style="q1" vid="ISA 34:6">kaachiel gi boche moa e nyiroke mag imbe.</para>
  <para style="q2" vid="ISA 34:6">Nimar Jehova Nyasaye nigi misango Bozra kod nek ei Edom.<verse eid="ISA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 34:7"/>Kendo jope, gi nyirwedhi</para>
  <para style="q2" vid="ISA 34:7">kod rwedhi madongo nopodh kodgi.</para>
  <para style="q1" vid="ISA 34:7">Pinygi nopongʼ gi remo,</para>
  <para style="q2" vid="ISA 34:7">kendo boche noum buru.<verse eid="ISA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 34:8"/>Nimar Jehova Nyasaye ni kod odiechienge mar chulo kuor,</para>
  <para style="q2" vid="ISA 34:8">ma en higa mar chiwo kum ne jogo,</para>
  <para style="q1" vid="ISA 34:8">mosetimo marach ne Sayun.<verse eid="ISA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 34:9"/>Aore mag Edom nobar okak,</para>
  <para style="q2" vid="ISA 34:9">lopene nolokre lot maliet mawengʼo,</para>
  <para style="q1" vid="ISA 34:9">kendo pinye nowangʼ duto!<verse eid="ISA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 34:10"/>Ok nokwe odiechiengʼ gotieno;</para>
  <para style="q2" vid="ISA 34:10">iro mare nodum kanyo nyaka chiengʼ.</para>
  <para style="q1" vid="ISA 34:10">Koa e tiengʼ moro nyaka machielo nodongʼ gunda;</para>
  <para style="q2" vid="ISA 34:10">onge ngʼat manochak oluwe kendo.<verse eid="ISA 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 34:11"/>Nobed kama winj tula rutoe</para>
  <para style="q2" vid="ISA 34:11">kendo agak odakie.</para>
  <para style="q1" vid="ISA 34:11">Nyasaye nopim timbe maricho</para>
  <para style="q2" vid="ISA 34:11">mag Edom kod ketho mage.<verse eid="ISA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 34:12"/>Jodonge ok nobed gi gimoro</para>
  <para style="q2" vid="ISA 34:12">miluongo ni pinyruoth,</para>
  <para style="q2" vid="ISA 34:12">nyithi ruoth nolal nono.<verse eid="ISA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 34:13"/>Kuthe ema noyugno e utege madongo,</para>
  <para style="q2" vid="ISA 34:13">aila kod pedo nobed ohingane.</para>
  <para style="q1" vid="ISA 34:13">Enobed piny mojwangʼ ma ondiegi</para>
  <para style="q2" vid="ISA 34:13">ema odakie kendo kuonde ma tula odakie.<verse eid="ISA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 34:14"/>Gi bungu norom gondiegi kuno,</para>
  <para style="q2" vid="ISA 34:14">kendo diek mag bungu noywagne jowetegi;</para>
  <para style="q1" vid="ISA 34:14">kanyo bende gik malich mag otieno noyud kar yweyo.<verse eid="ISA 34:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 34:15"/>Tula noger ode kanyo monywol tongʼ,</para>
  <para style="q2" vid="ISA 34:15">motogi kendo norit nyithinde,</para>
  <para style="q2" vid="ISA 34:15">koumo e tipo mar bwombene;</para>
  <para style="q1" vid="ISA 34:15">kanyo bende ema otenga nochokre,</para>
  <para style="q2" vid="ISA 34:15">moro ka moro gi nyawadgi.<verse eid="ISA 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 34:16"/>Ngʼii e kitap Jehova Nyasaye kendo isom:</para>
  <para style="q2" vid="ISA 34:16">Onge moro kuomgi kata achiel manobed maonge,</para>
  <para style="q1" vid="ISA 34:16">kendo moro ka moro nobed gi nyawadgi.</para>
  <para style="q2" vid="ISA 34:16">Nimar osegolo chik gi dhoge owuon,</para>
  <para style="q2" vid="ISA 34:16">kendo Roho mare ema nochokgi kanyakla.<verse eid="ISA 34:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 34:17"/>Opogogi kuondegi;</para>
  <para style="q2" vid="ISA 34:17">kendo lwetene chiwogi gi rapim.</para>
  <para style="q1" vid="ISA 34:17">Enobed margi nyaka chiengʼ mi</para>
  <para style="q2" vid="ISA 34:17">gidag kanyo ndalo duto mag ngimagi.<verse eid="ISA 34:17"/></para>
  <chapter eid="ISA 34"/>
  <chapter number="35" style="c" sid="ISA 35"/>
  <para style="s1">Mor mar joma oresi</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 35:1"/>Kuonde motimo ongoro</para>
  <para style="q2" vid="ISA 35:1">kendo mobaro okak nobed mamor;</para>
  <para style="q1" vid="ISA 35:1">kuonde thimbe nobed moil</para>
  <para style="q2" vid="ISA 35:1">kendo momiyo ka maua mathiewo,</para>
  <para style="q2" vid="ISA 35:1">mana kaka ondanyo,<verse eid="ISA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 35:2"/>enogol maua mabeyo,</para>
  <para style="q2" vid="ISA 35:2">mi nobed gi mor ka ogoyo koko gi ilo.</para>
  <para style="q2" vid="ISA 35:2">Enobed gi duongʼ mar Lebanon,</para>
  <para style="q1" vid="ISA 35:2">gi mor mar Karmel kod Sharon;</para>
  <para style="q2" vid="ISA 35:2">ginine duongʼ mar Jehova Nyasaye, ma Nyasachwa maber.<verse eid="ISA 35:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 35:3"/>Teguru bede mayom yom,</para>
  <para style="q2" vid="ISA 35:3">rieuru chong monyosore;<verse eid="ISA 35:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 35:4"/>koneuru joma nigi chuny mool ni,</para>
  <para style="q2" vid="ISA 35:4">“Beduru motegno kendo kik uluor;</para>
  <para style="q1" vid="ISA 35:4">nimar Nyasachu biro biro,</para>
  <para style="q2" vid="ISA 35:4">mondo ochul kuor ne wasiku,</para>
  <para style="q2" vid="ISA 35:4">kaka owinjore kendo oresu.”<verse eid="ISA 35:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 35:5"/>Eka joma muofni nonen</para>
  <para style="q2" vid="ISA 35:5">kendo joma itgi odino nowinj wach.<verse eid="ISA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 35:6"/>Eka rongʼonde nolengʼre ka nyakech</para>
  <para style="q2" vid="ISA 35:6">kendo momni nokog gi mor.</para>
  <para style="q1" vid="ISA 35:6">Pi nobubni kowuok e thim,</para>
  <para style="q2" vid="ISA 35:6">kendo oula nomol kar ongoro.<verse eid="ISA 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 35:7"/>Piny ma yande otwo nolokre dago,</para>
  <para style="q2" vid="ISA 35:7">kendo achiya nowuog e lowo motwo.</para>
  <para style="q1" vid="ISA 35:7">Lum, odundu kod togo nodongi kama ondiegi yande odakie.<verse eid="ISA 35:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 35:8"/>Kendo wangʼ yo nobedi kanyo,</para>
  <para style="q2" vid="ISA 35:8">mi noluonge ni Wangʼ Yo Maler.</para>
  <para style="q1" vid="ISA 35:8">Joma ok ler ok nowuothie,</para>
  <para style="q2" vid="ISA 35:8">to nobedi wangʼ yo ma joma kare ema luwo,</para>
  <para style="q2" vid="ISA 35:8">joma ofuwo ma joricho ok nowuothie.<verse eid="ISA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 35:9"/>Onge sibuor manoyud kuno</para>
  <para style="q2" vid="ISA 35:9">kata mana ondieg bungu mager manade,</para>
  <para style="q1" vid="ISA 35:9">ok nosud machiegni kanyo.</para>
  <para style="q2" vid="ISA 35:9">To mana joma Nyasaye osewaro ema nowuothie,<verse eid="ISA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 35:10"/>kendo joma Jehova Nyasaye osereso nodwogi.</para>
  <para style="q2" vid="ISA 35:10">Ginidonji Sayun ka giwer;</para>
  <para style="q1" vid="ISA 35:10">kendo ka ilo mosiko opongʼo chunygi.</para>
  <para style="q2" vid="ISA 35:10">Ginibed gi mor gi ilo mosiko,</para>
  <para style="q2" vid="ISA 35:10">kendo kuyo kod parruok norum chuth.<verse eid="ISA 35:10"/></para>
  <chapter eid="ISA 35"/>
  <chapter number="36" style="c" sid="ISA 36"/>
  <para style="s1">Senakerib omonjo Jerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1"/>E higa mar apar gangʼwen mar loch Ruoth Hezekia, Senakerib ruodh Asuria nomonjo mier madongo duto mochiel motegno mag Juda mokawogi. <verse eid="ISA 36:1"/><verse number="2" style="v" sid="ISA 36:2"/>Eka ruodh Asuria ne ooro jatend lweny gi ogandane mag lweny koa Lakish mondo odhi ir Ruoth Hezekia Jerusalem. Kane jatend lweny ochopo kuno, ne ochungʼ but Soko Mamalo mantie e yo miluongo ni Puoth Jaluoko. <verse eid="ISA 36:2"/><verse number="3" style="v" sid="ISA 36:3"/>Eliakim wuod Hilkia ma jatend od ruoth, gi Shebna jagoro kod Joa wuod Asaf mane jachan weche, nodhi ire kanyo.<verse eid="ISA 36:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 36:4"/>Jatend lweny nowachonegi niya, “Wachneuru Hezekia kama:</para>
  <para style="pm" vid="ISA 36:4">“ ‘Ma e gima ruoth maduongʼ, ma ruodh Asuria wacho: En kama nade miketoe genoni momiyo in-gi chir kama? <verse eid="ISA 36:4"/><verse number="5" style="v" sid="ISA 36:5"/>Uwacho ni un gi rieko kod teko mangʼeny mar lweny, to gik ma uwacho onge tiendgi. En ngʼa ma uketo genou kuome, mamiyo ungʼanyo uweya? <verse eid="ISA 36:5"/><verse number="6" style="v" sid="ISA 36:6"/>Neuru, sani koro uketo genou kuom Misri, machalo odundu mobarore ma ka ngʼato orere to opilore mochwo ngʼatno kendo kelo adhola! Mano e kaka Farao ruodh Misri chalo ne joma ogeno kuome. <verse eid="ISA 36:6"/><verse number="7" style="v" sid="ISA 36:7"/>To ka uwachona niya, “Wan waketo genowa kuom Jehova Nyasaye ma Nyasachwa” to donge en ema kuondene motingʼore malo kod kendene mag misango Hezekia nogolo kowachone jo-Juda gi jo-Jerusalem niya, “Nyaka ulam mana e nyim kendo mar misangoni kende”?<verse eid="ISA 36:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="ISA 36:8"/>“ ‘Biuru sani mondo uwinjru gi ruodha, ma en ruodh Asuria: Abiro miyou farese alufu ariyo, ka unyalo yudo joma riembogi! <verse eid="ISA 36:8"/><verse number="9" style="v" sid="ISA 36:9"/>Ere kaka koro uparo ni unyalo loyo achiel kuom jotend jolweny matinie moloyo mag ruodha ka uketo genou mana kuom jolwenj Misri gi faresegi? <verse eid="ISA 36:9"/><verse number="10" style="v" sid="ISA 36:10"/>To moloyo mano iparo ni asebiro monjo pinyni mana gi pacha awuon ka ok en wach moa kuom Jehova Nyasaye? Jehova Nyasaye owuon ema osenyisa mondo abi amonj pinyni kendo akethe.’ ”<verse eid="ISA 36:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11"/>Eka Eliakim, Shebna kod Joa nowachone jatend lweny niya, “Yie iwuo gi jotichni gi dho jo-Aram nimar wawinjo dhokno. We wuoyo kodwa gi dho jo-Hibrania nikech joma ni e ohinga nyalo winjo gik miwachonwa.”<verse eid="ISA 36:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 36:12"/>To jatend lweny nodwokogi niya, “Uparo ni un kod ruodhu kendu ema ne ruodha oora iru mondo awachnu wechegi, to ok ne joma obedo ei ohinga; bende ungʼeyo ni jogo kaachiel gi un biro bangʼo chiethgi kendo madho lachgi?”<verse eid="ISA 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 36:13"/>Eka jatend lweny nochungʼ moluongo matek gi dho jo-Hibrania niya, “Winjuru weche moa kuom ruoth maduongʼ ma en ruodh Asuria! <verse eid="ISA 36:13"/><verse number="14" style="v" sid="ISA 36:14"/>Ma e gima ruoth wacho: Kik uyie Hezekia wuondu nikech ok onyal resou! <verse eid="ISA 36:14"/><verse number="15" style="v" sid="ISA 36:15"/>Kik uwe Hezekia hou mondo ugen kuom Jehova Nyasaye kowachonu ni, ‘Jehova Nyasaye biro resowa adier; kendo dala maduongʼni ok nochiw e lwet ruodh Asuria.’<verse eid="ISA 36:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 36:16"/>“Kik uwinj wach Hezekia. Ma e gima ruodh Asuria wacho: Winjreuru koda kendo biuru ira oko. Bangʼe ngʼato ka ngʼato kuomu nocham mzabibu kod ngʼowu kendo nomodh pi moa e sokone owuon, <verse eid="ISA 36:16"/><verse number="17" style="v" sid="ISA 36:17"/>nyaka chop abi mi ateru e piny machal gi pinyu, ma en piny machiego cham gi divai manyien, piny mopongʼ gi makati kod mzabibu.<verse eid="ISA 36:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 36:18"/>“Kik uwe Hezekia wuondu kowachonu ni, ‘Jehova Nyasaye biro resowa.’ Bende nyaka nene nyasach piny moro amora osereso ogandane e lwet ruodh Asuria? <verse eid="ISA 36:18"/><verse number="19" style="v" sid="ISA 36:19"/>Ere nyiseche mag Hamath gi Arpad? Ere nyiseche mag Sefarvaim? Bende ne gireso Samaria e lweta? <verse eid="ISA 36:19"/><verse number="20" style="v" sid="ISA 36:20"/>Kuom nyiseche duto mag pinjegi, en mane mosereso pinye e lweta? To koro ere kaka uparo ni Jehova Nyasaye nyalo reso Jerusalem e lweta?”<verse eid="ISA 36:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 36:21"/>To ji duto nolingʼ thi maonge ngʼama dwoko nimar ruoth Hezekia nosegolo chik niya, “Kik udwoke.”<verse eid="ISA 36:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 36:22"/>Eka Eliakim wuod Hilkia jatend od ruoth gi Shebna jagoro kod Joa wuod Asaf, jachan weche mag piny, nodhi ir Hezekia ka lepgi oyiech kendo negiwachone gima jatend lwenyno osewacho.<verse eid="ISA 36:22"/></para>
  <chapter eid="ISA 36"/>
  <chapter number="37" style="c" sid="ISA 37"/>
  <para style="s1">Fweny ni Jerusalem noresi</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1"/>Kane Ruoth Hezekia owinjo wachno, noyiecho lepe morwako pien gugru mi odhi e hekalu mar Jehova Nyasaye. <verse eid="ISA 37:1"/><verse number="2" style="v" sid="ISA 37:2"/>Ne ooro Eliakim ma jatend od ruoth, gi Shebna jagoro kod jodolo madongo ir janabi Isaya wuod Amoz ka giduto girwako piende gugru. <verse eid="ISA 37:2"/><verse number="3" style="v" sid="ISA 37:3"/>Negiwachone niya, “Ma e gima Hezekia wacho: Odiechiengni en odiechieng kuyo, siem kod wichkuot machalo gi nyithindo ma ndalogi mar nywol osechopo to onge teko minywologigo. <verse eid="ISA 37:3"/><verse number="4" style="v" sid="ISA 37:4"/>Nyalo bedo ni Jehova Nyasaye ma Nyasachi biro winjo weche Rabshake jatend lweny, ma jatende ma ruodh Asuria oseoro mondo oyany Nyasaye mangima, kendo obiro kwere kuom weche mane Jehova Nyasaye ma Nyasachu osewinjo kowacho. Kuom mano, in Isaya, lamne ji mane otony ma pod ngima.”<verse eid="ISA 37:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5"/>Kane jodong Ruoth Hezekia nobiro ir Isaya, <verse eid="ISA 37:5"/><verse number="6" style="v" sid="ISA 37:6"/>Isaya nowachonegi niya, “Nyisuru ruodhu ni, ‘Jehova Nyasaye wacho kama: Kik ibed maluor kuom weche misewinjo, wechego ma ruodh Asuria oseyanyago. <verse eid="ISA 37:6"/><verse number="7" style="v" sid="ISA 37:7"/>Winji! Abiro goyo chunye gi kihondko ma kowinjo wach moro to noring odog e pinygi, to kuno ema nachiwe mondo onege gi ligangla.’ ”<verse eid="ISA 37:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8"/>Kane Rabshake jatend lweny owinjo ni ruodh Asuria osewuok Lakish, ne oringo oa kanyo moyudo ka ruoth kedo gi jo-Libna.<verse eid="ISA 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 37:9"/>Senakerib noyudo wach ni Tirhaka ja-Kush ruodh Misri obiro monje. Kane owinjo wachno, nooro joote ir Hezekia kowacho kama: <verse eid="ISA 37:9"/><verse number="10" style="v" sid="ISA 37:10"/>“Wachne Hezekia ruodh Juda kama: Kik iyie nyasaye migeno kuomeno wuondi kowacho ni, ‘Jerusalem ok nochiw e lwet ruodh Asuria.’ <verse eid="ISA 37:10"/><verse number="11" style="v" sid="ISA 37:11"/>Adier isewinjo gik ma ruodhi mag Asuria osetimo ni pinjeruodhi duto kotiekogi chuth. In to iparo ni ibiro tony? <verse eid="ISA 37:11"/><verse number="12" style="v" sid="ISA 37:12"/>Bende nyiseche mag ogendini mane kwerena oketho pinygi kaka nyiseche mag Gozan, Haran, Rezef kod jo-Eden man Tel Assar nokonyogi? <verse eid="ISA 37:12"/><verse number="13" style="v" sid="ISA 37:13"/>Tinde ere ruodh Hamath, gi ruodh Arpad gi ruodh dala maduongʼ mar Sefarvaim, kata ruodh Hena kod Iva?”<verse eid="ISA 37:13"/></para>
  <para style="s1">Lamo mar Hezekia</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14"/>Hezekia noyudo baruwano mane joote okelone mosome. Bangʼe nodhi e hekalu mar Jehova Nyasaye, moyaro baruwano e nyim Jehova Nyasaye. <verse eid="ISA 37:14"/><verse number="15" style="v" sid="ISA 37:15"/>Kendo Hezekia nolamo Jehova Nyasaye kowacho kama: <verse eid="ISA 37:15"/><verse number="16" style="v" sid="ISA 37:16"/>Yaye Jehova Nyasaye Maratego, ma Nyasach Israel, modak e kind kerubi, in kendi e Nyasaye mar pinjeruodhi duto manie piny, kendo in ema ne ichweyo polo gi piny. <verse eid="ISA 37:16"/><verse number="17" style="v" sid="ISA 37:17"/>Chik iti, yaye Jehova Nyasaye mondo iwinji, yaw wangʼi, yaye Jehova Nyasaye mondo ine; kendo winjie weche duto ma Senakerib oseoro joge kayanyigo in Nyasaye mangima.<verse eid="ISA 37:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 37:18"/>“En adier, yaye Jehova Nyasaye, ni ruodhi mag Asuria osetieko ogendini mangʼenygi ma giweyo pinjegi gunda. <verse eid="ISA 37:18"/><verse number="19" style="v" sid="ISA 37:19"/>Gisewito nyisechegi e mach mi gitiekogi, nikech ne ok gin nyiseche to ne gin mana yien kod kidi molos gi lwet dhano. <verse eid="ISA 37:19"/><verse number="20" style="v" sid="ISA 37:20"/>Yaye Jehova Nyasaye, ma Nyasachwa, koro reswa e lwet Senakerib mondo pinjeruodhi duto manie piny ongʼe ni in kendi e Jehova Nyasaye, ma Nyasaye.”<verse eid="ISA 37:20"/></para>
  <para style="s1">Senakerib otieki</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21"/>Eka Isaya wuod Amoz ne ooro wach ne Hezekia kama: “Ma e gima Jehova Nyasaye, ma Nyasach Israel, wacho: Nikech uselama kuom wach mar Senakerib ruodh Asuria, <verse eid="ISA 37:21"/><verse number="22" style="v" sid="ISA 37:22"/>ma e wach ma Jehova Nyasaye osewacho kuom Senakerib:</para>
  <para style="q1" vid="ISA 37:22">“Nyar Sayun Mangili ochayi kendo jari.</para>
  <para style="q2" vid="ISA 37:22">Nyar Jerusalem kino wiye koneni kiringo.<verse eid="ISA 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 37:23"/>En ngʼa misejaro kendo yanyo?</para>
  <para style="q2" vid="ISA 37:23">Koso en ngʼa ma isegone koko,</para>
  <para style="q2" vid="ISA 37:23">kijowo wangʼi gi sunga?</para>
  <para style="q1" vid="ISA 37:23">Donge en mana Jal Maler mar Israel.<verse eid="ISA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 37:24"/>Kokalo kuom jooteni usegango</para>
  <para style="q2" vid="ISA 37:24">weche mag ayany kuom Ruoth Nyasaye.</para>
  <para style="q1" vid="ISA 37:24">Bende usewacho niya,</para>
  <para style="q2" vid="ISA 37:24">‘Gi gechena mangʼeny mag lweny,</para>
  <para style="q1" vid="ISA 37:24">aseidho gode maboyo mag Lebanon</para>
  <para style="q2" vid="ISA 37:24">mi achopo ewi got mabor moloyo.</para>
  <para style="q1" vid="ISA 37:24">Asetongʼo yiendene mag sida maboyo</para>
  <para style="q2" vid="ISA 37:24">kendo mabeyo.</para>
  <para style="q1" vid="ISA 37:24">Asechopo nyaka e chuny</para>
  <para style="q2" vid="ISA 37:24">bungu ma iye mogik kuma yien odiche.<verse eid="ISA 37:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 37:25"/>Asekunyo sokni e pinje mamoko</para>
  <para style="q2" vid="ISA 37:25">mi amodho pige man kuno.</para>
  <para style="q1" vid="ISA 37:25">Asemiyo aore duto mag Misri bende oduono</para>
  <para style="q2" vid="ISA 37:25">ka anyonogi gi tienda.’<verse eid="ISA 37:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 37:26"/>“Donge usewinjo ni an ema ne achano chon mondo gigo otimre?</para>
  <para style="q2" vid="ISA 37:26">Ne achanogi chon to koro amiyo gitimore,</para>
  <para style="q1" vid="ISA 37:26">kendo an ema ne achano mondo imuk mier</para>
  <para style="q2" vid="ISA 37:26">madongo mochiel motegno mondo olokre pidhe mag kite.<verse eid="ISA 37:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 37:27"/>Joge teko orumonegi,</para>
  <para style="q2" vid="ISA 37:27">mi gibuok kendo gidongʼ gi wichkuot.</para>
  <para style="q1" vid="ISA 37:27">Gichalo gi cham manie puodho,</para>
  <para style="q2" vid="ISA 37:27">kata ka maua mangʼich mathiewo,</para>
  <para style="q2" vid="ISA 37:27">kata ka lum madongo ewi tado, to ner kapok odongo.<verse eid="ISA 37:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 37:28"/>“To angʼeyo kama idakie,</para>
  <para style="q2" vid="ISA 37:28">bende angʼeyo sa ma idonjo kata sa ma iwuok,</para>
  <para style="q2" vid="ISA 37:28">kata kaka iwuoyo marach kuoma.<verse eid="ISA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 37:29"/>Nikech iwuoyo kuoma marach</para>
  <para style="q2" vid="ISA 37:29">kendo wechegi maricho osechopo e ita,</para>
  <para style="q1" vid="ISA 37:29">abiro keto chuma e umi</para>
  <para style="q2" vid="ISA 37:29">kod mbedona e dhogi,</para>
  <para style="q1" vid="ISA 37:29">kendo abiro miyo idog</para>
  <para style="q2" vid="ISA 37:29">gi yo mane ibirogo.<verse eid="ISA 37:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ISA 37:30"/>“Ma ema nobedni ranyisi, yaye Hezekia:</para>
  <para style="q1" vid="ISA 37:30">“E higa mokwongoni unucham gik matwi kendgi</para>
  <para style="q2" vid="ISA 37:30">kendo e higa mar ariyo unucham orowe moloth bangʼ keyo e higa mokwongono.</para>
  <para style="q1" vid="ISA 37:30">To e higa mar adek, unuchwo kodhi kendo unuka cham,</para>
  <para style="q2" vid="ISA 37:30">bende unupidh mzabibu mi ucham olembegi.<verse eid="ISA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 37:31"/>Jo-Juda modongʼ</para>
  <para style="q2" vid="ISA 37:31">biro chalo gi yath matero tiendene piny kendo nyago olemo e bedene.<verse eid="ISA 37:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 37:32"/>Nimar joma nok modongʼ</para>
  <para style="q2" vid="ISA 37:32">nowuog Jerusalem,</para>
  <para style="q1" vid="ISA 37:32">kendo oganda mar joma otony nowuogi koa</para>
  <para style="q2" vid="ISA 37:32">e Got Sayun.</para>
  <para style="q1" vid="ISA 37:32">Jehova Nyasaye Maratego,</para>
  <para style="q2" vid="ISA 37:32">notim ma kuom tekone owuon.<verse eid="ISA 37:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 37:33"/>“Kuom mano ma e gima Jehova Nyasaye wacho ewi ruodh Asuria:</para>
  <para style="q1" vid="ISA 37:33">“Ok nodonji e dala maduongʼni</para>
  <para style="q2" vid="ISA 37:33">kata diro asere.</para>
  <para style="q1" vid="ISA 37:33">Ok nomonj dalano kotingʼo kuot</para>
  <para style="q2" vid="ISA 37:33">kata lwore gi jolweny mondo omonje.<verse eid="ISA 37:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 37:34"/>Enodogi mana gi yo mane obirogo;</para>
  <para style="q2" vid="ISA 37:34">kendo ok enodonj e dala maduongʼni,”</para>
  <para style="q2" vid="ISA 37:34">Jehova Nyasaye ema owacho.<verse eid="ISA 37:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ISA 37:35"/>“Abiro kedone dala maduongʼni kendo rese,</para>
  <para style="q2" vid="ISA 37:35">nikech nyinga kod nying Daudi jatichna!”<verse eid="ISA 37:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36"/>Eka malaika mar Jehova Nyasaye ne owuok mi odhi onego ji alufu mia achiel gi piero aboro gabich e kambi mar jo-Asuria. Kane ji ochiewo gokinyi negiyudo mana ringre joma otho! <verse eid="ISA 37:36"/><verse number="37" style="v" sid="ISA 37:37"/>Omiyo Senakerib ruodh Asuria noweyo lweny moloro kambi kendo nodok Nineve kuma nodakie.<verse eid="ISA 37:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ISA 37:38"/>Chiengʼ moro achiel kane olemo e hekalu mar Nisrok nyasache, yawuote miluongo ni Adramelek gi Shareza nonege gi ligangla, bangʼe negiringo gidhi e piny Ararat. Kendo Esarhadon wuode nobedo ruoth kare.<verse eid="ISA 37:38"/></para>
  <chapter eid="ISA 37"/>
  <chapter number="38" style="c" sid="ISA 38"/>
  <para style="s1">Tuo mar Hezekia</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1"/>E ndalogo Hezekia nobedo matuo kendo nohewore. Janabi Isaya wuod Amoz nodhi ire mowachone niya, “Ma e gima Jehova Nyasaye wacho: Los weche mag dalani maber nikech ndaloni mar tho ochopo kendo ok inichangi.”<verse eid="ISA 38:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 38:2"/>Hezekia nolokore kongʼiyo kor ot mi olamo Jehova Nyasaye kama, <verse eid="ISA 38:2"/><verse number="3" style="v" sid="ISA 38:3"/>“Yaye Jehova Nyasaye, parie kaka asewuotho e nyimi gi adiera kod chuny modimbore kendo asetimo gigo makare e nyim wangʼi.” Bangʼe Hezekia noywak malit.<verse eid="ISA 38:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 38:4"/>Eka wach Jehova Nyasaye nobiro ne Isaya kama: <verse eid="ISA 38:4"/><verse number="5" style="v" sid="ISA 38:5"/>“Dhi mondo inyis Hezekia ni, ‘Ma e gima Jehova Nyasaye, ma Nyasach Daudi kwaru wacho: Asewinjo lemoni kendo aseneno pi wangʼi; omiyo abiro medi ngima moromo higni apar gabich. <verse eid="ISA 38:5"/><verse number="6" style="v" sid="ISA 38:6"/>Kendo abiro resi kaachiel gi dala maduongʼni e lwet ruodh Asuria. Abiro rito dala maduongʼni.<verse eid="ISA 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 38:7"/>“ ‘Ma e ranyisi ma Jehova Nyasaye nomiyi ni obiro timo gima osesingo: <verse eid="ISA 38:7"/><verse number="8" style="v" sid="ISA 38:8"/>Abiro dwoko tipo mar wangʼ chiengʼ manie raidhi mar dhood Ahaz ondamo apar chien.’ ” Omiyo wangʼ chiengʼ ne odok ondamo apar chien e raidhi mane oselorie.<verse eid="ISA 38:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9"/>Magi e weche mag Hezekia ruodh Juda bangʼ kane osechango e tuone:<verse eid="ISA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 38:10"/>Ne apenjora niya, “E ndalo mag ber mar ngimana,</para>
  <para style="q1" vid="ISA 38:10">bende onego bed ni akalo e rangeye mag tho<note caller="+" style="f"><char style="fr" closed="false">38:10 </char><char style="ft" closed="false">Gi dho jo-Hibrania rangeye mag tho en </char><char style="fqa" closed="false">Sheol.</char></note></para>
  <para style="q2" vid="ISA 38:10">kendo hikena modongʼ duto gol kuoma?”<verse eid="ISA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 38:11"/>Ne awacho niya, “Ok anachak ane Jehova Nyasaye owuon,</para>
  <para style="q2" vid="ISA 38:11">e piny joma ngima;</para>
  <para style="q1" vid="ISA 38:11">bende ok anachak aket genona kuom dhano wadwa,</para>
  <para style="q2" vid="ISA 38:11">kata bedo gi joma koro odak e pinyni.<verse eid="ISA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 38:12"/>Osepudh oda mi owit mabor mana</para>
  <para style="q2" vid="ISA 38:12">kaka igolo kiru mar jakwath.</para>
  <para style="q1" vid="ISA 38:12">Ngimana osengʼad machiek mana kaka jatwengʼo</para>
  <para style="q2" vid="ISA 38:12">dolo usi mabed machiek kendo asandora pile ka pile,</para>
  <para style="q2" vid="ISA 38:12">odiechiengʼ kod otieno.<verse eid="ISA 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 38:13"/>Aywak ka rem ohewa nyaka piny ru,</para>
  <para style="q2" vid="ISA 38:13">chokena otur mana ka gima sibuor ema oturo,</para>
  <para style="q1" vid="ISA 38:13">isanda chakre okinyi nyaka odhiambo.<verse eid="ISA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 38:14"/>Ne aywak mana ka opija kata ka ongo-wangʼ</para>
  <para style="q1" vid="ISA 38:14">kendo adengo mana ka akuru.</para>
  <para style="q2" vid="ISA 38:14">Wengena ne otho bo kane arango polo.</para>
  <para style="q2" vid="ISA 38:14">An gi chandruok, yaye Ruoth Nyasaye, bi iresa!”<verse eid="ISA 38:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 38:15"/>To an dawach angʼo?</para>
  <para style="q2" vid="ISA 38:15">Osewuoyo koda mi en owuon osetimona ma,</para>
  <para style="q1" vid="ISA 38:15">abiro wuotho kadembora e ngimana duto</para>
  <para style="q2" vid="ISA 38:15">nikech lit manie chunya.<verse eid="ISA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 38:16"/>Yaye Ruoth Nyasaye wecheni emomiyo dhano ngima;</para>
  <para style="q2" vid="ISA 38:16">chunya yudo ngima kuom wecheni.</para>
  <para style="q1" vid="ISA 38:16">Iseduogona ngimana</para>
  <para style="q2" vid="ISA 38:16">mi koro iyiena mondo adagi.<verse eid="ISA 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 38:17"/>Chutho chandruok duto maseyudo</para>
  <para style="q2" vid="ISA 38:17">okelona mana kony.</para>
  <para style="q1" vid="ISA 38:17">Nikech herani mogundho iseresa e kethruok;</para>
  <para style="q2" vid="ISA 38:17">bende isewito richona duto kadiengʼeyi.<verse eid="ISA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 38:18"/>Joma ni e liel ok nyal paki,</para>
  <para style="q2" vid="ISA 38:18">tho ok nyal wero wendi mar pak,</para>
  <para style="q2" vid="ISA 38:18">chutho joma dhi e bur ok nyal geno adiera mari.<verse eid="ISA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 38:19"/>To joma ngima,</para>
  <para style="q2" vid="ISA 38:19">kende ema nyalo goyoni erokamano,</para>
  <para style="q1" vid="ISA 38:19">mana kaka atimo kawuononi;</para>
  <para style="q2" vid="ISA 38:19">wuone bende nyiso nyithindgi adiera mari.<verse eid="ISA 38:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 38:20"/>Jehova Nyasaye biro resa,</para>
  <para style="q2" vid="ISA 38:20">kendo wanawer wende pak gi nyiduonge,</para>
  <para style="q1" vid="ISA 38:20">ndalo duto mag ngimawa ei hekalu mar Jehova Nyasaye.<verse eid="ISA 38:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 38:21"/>Isaya nowacho niya, “Swag ngʼowu kendo iwirie kama bur okuodono, to obiro chango.”<verse eid="ISA 38:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 38:22"/>Hezekia noyudo osepenjo, “Ere gima biro bedona ranyisi ni abiro dhi e hekalu mar Jehova Nyasaye?”<verse eid="ISA 38:22"/></para>
  <chapter eid="ISA 38"/>
  <chapter number="39" style="c" sid="ISA 39"/>
  <para style="s1">Joote moa Babulon</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1"/>E kindeno Marduk-Baladan wuod Baladan ruodh Babulon nooro joote ir Hezekia gi barupe kod mich nikech yande nowinjo ni otuo to koro osechango. <verse eid="ISA 39:1"/><verse number="2" style="v" sid="ISA 39:2"/>Hezekia norwako joote gi mor mi onyisogi gik duto mane nitiere utege mag keno kaka fedha, dhahabu, gik mangʼwe ngʼar kod modhi ma nengogi tek kaachiel gi kar kenone mar gige lweny duto kod gik moko duto mane yudore kuom mwandune. Onge gimoro amora mane odongʼ e ode kata e pinye duto mane ok onyisogi.<verse eid="ISA 39:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 39:3"/>Eka Isaya janabi nodhi ir Ruoth Hezekia mopenje niya, “Angʼo mane jogo owacho kendo negia kanye?”</para>
  <para style="p" vid="ISA 39:3">Hezekia nodwoke niya, “Negia e piny mabor, miluongo ni Babulon.”<verse eid="ISA 39:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 39:4"/>Janabi nopenjo niya, “Angʼo mane gineno e odi?”</para>
  <para style="p" vid="ISA 39:4">Hezekia nodwoke niya, “Giseneno gik moko duto manie oda. Onge gimoro amora modongʼ e mwanduna mane ok anyisogi.”<verse eid="ISA 39:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 39:5"/>Eka Isaya nowachone Hezekia niya, “Wach Jehova Nyasaye Maratego wacho kama: <verse eid="ISA 39:5"/><verse number="6" style="v" sid="ISA 39:6"/>Ndalo biro chopo adier ma gik moko duto manie odi kod gik moko mane kwereni osekano nyaka chil kawuono, noter Babulon. Onge gimoro amora mane odongʼ, Jehova Nyasaye owacho. <verse eid="ISA 39:6"/><verse number="7" style="v" sid="ISA 39:7"/>Kendo nyikwayi moko mowuok e ringri kendo rembi iwuon noter e twech mi nolokgi wasumbini mabwoch e od ruoth mar ruodh Babulon.”<verse eid="ISA 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 39:8"/>Hezekia nodwoke niya, “Wach Jehova Nyasaye misewacho ber.” Nodwoke kamano koparo niya, “Abiro bedo gi kwe kod rit makare e ndalo mar ngimana.”<verse eid="ISA 39:8"/></para>
  <chapter eid="ISA 39"/>
  <chapter number="40" style="c" sid="ISA 40"/>
  <para style="s1">Hoch kuom jo-Nyasaye</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 40:1"/>Houru chuny joga, hogiuru,</para>
  <para style="q2" vid="ISA 40:1">Nyasachu wacho kamano.<verse eid="ISA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 40:2"/>Wuouru gi muolo ne Jerusalem,</para>
  <para style="q2" vid="ISA 40:2">kendo uwachne,</para>
  <para style="q1" vid="ISA 40:2">ni ndalone mag chandruok oserumo,</para>
  <para style="q2" vid="ISA 40:2">bende ni richone osewene,</para>
  <para style="q1" vid="ISA 40:2">kendo oseyudo kum nyadiriyo koa e lwet Jehova Nyasaye</para>
  <para style="q2" vid="ISA 40:2">nikech richone duto.<verse eid="ISA 40:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 40:3"/>Ngʼat moro kok niya:</para>
  <para style="q2" vid="ISA 40:3">“Losuru yo ne Jehova Nyasaye,</para>
  <para style="q1" vid="ISA 40:3">losneuru Nyasachwa yo moriere tir,</para>
  <para style="q2" vid="ISA 40:3">e piny motimo ongoro e thim.<verse eid="ISA 40:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 40:4"/>Holo ka holo nobugi mapongʼ,</para>
  <para style="q2" vid="ISA 40:4">gode madongo gi matindo duto nopie;</para>
  <para style="q1" vid="ISA 40:4">yore motimo gogni nobed maler,</para>
  <para style="q2" vid="ISA 40:4">kendo kuonde motimo gode nobed pewe.<verse eid="ISA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 40:5"/>Eka duongʼ mar Jehova Nyasaye nofwenyre</para>
  <para style="q2" vid="ISA 40:5">kendo ji duto biro nene.</para>
  <para style="q1" vid="ISA 40:5">Nimar Jehova Nyasaye owuon ema osewacho kamano.”<verse eid="ISA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 40:6"/>Dwol moro wacho niya, “Tingʼ dwondi iywagi.”</para>
  <para style="q2" vid="ISA 40:6">To ne apenjo niya, “Ere gima aywago?”</para>
  <para style="b" vid="ISA 40:6"/>
  <para style="q1" vid="ISA 40:6">“Dhano duto chalo gi lum,</para>
  <para style="q2" vid="ISA 40:6">kendo bergi duto chalo mana gi maua manie pap.<verse eid="ISA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 40:7"/>Lum ner kendo maua tuo mi lwar piny</para>
  <para style="q2" vid="ISA 40:7">ka much Jehova Nyasaye okudhogi.</para>
  <para style="q2" vid="ISA 40:7">Chutho dhano chalo mana gi lum.<verse eid="ISA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 40:8"/>Lum ner kendo maua tuo mi lwar piny,</para>
  <para style="q2" vid="ISA 40:8">to wach Nyasachwa osiko manyaka chiengʼ.”<verse eid="ISA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 40:9"/>In mikelo wach maber ne Sayun,</para>
  <para style="q2" vid="ISA 40:9">dhi ewi got malo.</para>
  <para style="q1" vid="ISA 40:9">In mikelo wach maber ne Jerusalem,</para>
  <para style="q2" vid="ISA 40:9">tingʼ dwondi malo ka ikok matek,</para>
  <para style="q1" vid="ISA 40:9">tingʼ dwondi malo, kik ibed maluor;</para>
  <para style="q2" vid="ISA 40:9">wach ne mier mag Juda niya,</para>
  <para style="q2" vid="ISA 40:9">“Eri Nyasachu nika!”<verse eid="ISA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 40:10"/>Neuru, Jehova Nyasaye Manyalo Gik Moko Duto biro gi teko,</para>
  <para style="q2" vid="ISA 40:10">kendo loch ni e lwete.</para>
  <para style="q1" vid="ISA 40:10">Neuru, obiro gi pok mare,</para>
  <para style="q2" vid="ISA 40:10">kendo pokne luwo bangʼe.<verse eid="ISA 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 40:11"/>Orito rombene mana kaka jakwath:</para>
  <para style="q2" vid="ISA 40:11">Ochoko nyirombene e bade,</para>
  <para style="q1" vid="ISA 40:11">kendo oriwogi e kore</para>
  <para style="q2" vid="ISA 40:11">kotelo maber ni rombe man-gi nyithindo.<verse eid="ISA 40:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 40:12"/>En ngʼa mosepimo pi e chuny lwete</para>
  <para style="q2" vid="ISA 40:12">kata mana pimo lach mar polo gi lwete?</para>
  <para style="q1" vid="ISA 40:12">En ngʼa ma osechoko buru manie piny e atonga,</para>
  <para style="q2" vid="ISA 40:12">kata pimo gode madongo gi matindo e rapim?<verse eid="ISA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 40:13"/>En ngʼa mosefwenyo pach Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 40:13">koso en ngʼa mosebedo kaka jangʼadne rieko?<verse eid="ISA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 40:14"/>En ngʼa mane Jehova Nyasaye openjo mondo opuonje,</para>
  <para style="q2" vid="ISA 40:14">koso en ngʼa mane onyise yo makare?</para>
  <para style="q1" vid="ISA 40:14">En ngʼa ma nopuonje rieko</para>
  <para style="q2" vid="ISA 40:14">koso en ngʼa mane onyise yor ngʼeyo?<verse eid="ISA 40:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 40:15"/>Adier ogendini chalo mana ka pi matin modongʼ e dapi;</para>
  <para style="q2" vid="ISA 40:15">ee, gichalo mana ka buru momoko e ratil,</para>
  <para style="q2" vid="ISA 40:15">opimo chula mag nembe e ratil mana ka buru mayom.<verse eid="ISA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 40:16"/>Yiende mag Lebanon ok oromo moko mach mar kendo mar misango,</para>
  <para style="q2" vid="ISA 40:16">kata le man kuno nok ma ok oromo timogo misango miwangʼo pep.<verse eid="ISA 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 40:17"/>Ogendini duto ok gimoro e nyime,</para>
  <para style="q2" vid="ISA 40:17">okwanogi ka gik manono,</para>
  <para style="q2" vid="ISA 40:17">maonge tich.<verse eid="ISA 40:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 40:18"/>En ngʼa ma dipim gi Nyasaye?</para>
  <para style="q2" vid="ISA 40:18">Koso en kido mane madiwach ni chal kode?<verse eid="ISA 40:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 40:19"/>To nyiseche manono, jatheth nyalo loso</para>
  <para style="q2" vid="ISA 40:19">kendo jatheth nyalo bawe gi dhahabu,</para>
  <para style="q2" vid="ISA 40:19">mi olosne thiwni mar fedha.<verse eid="ISA 40:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 40:20"/>Ngʼat modhier ma ok nyal golo chiwo machalo kama,</para>
  <para style="q2" vid="ISA 40:20">yiero yien ma ok tow.</para>
  <para style="q1" vid="ISA 40:20">Omanyo japecho molony</para>
  <para style="q2" vid="ISA 40:20">mondo olosne kido ma ok nyal podho piny.<verse eid="ISA 40:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 40:21"/>Donge ungʼeyo</para>
  <para style="q2" vid="ISA 40:21">Koso donge usewinjo?</para>
  <para style="q1" vid="ISA 40:21">Pok owachnu nyaka aa chakruok?</para>
  <para style="q2" vid="ISA 40:21">Koso pok wachno odonjonu nyaka ne chwe pinyni.<verse eid="ISA 40:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 40:22"/>Nyasaye obet e kom duongʼne kuma bor moyombo piny</para>
  <para style="q2" vid="ISA 40:22">kendo joma ni e polo ngʼeny machalo kama ongogo ochokoree.</para>
  <para style="q1" vid="ISA 40:22">Oyaro polo mana ka tipo maduongʼ</para>
  <para style="q2" vid="ISA 40:22">kendo oyarogi mana ka hema midakie.<verse eid="ISA 40:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 40:23"/>Odwoko ruodhi piny</para>
  <para style="q2" vid="ISA 40:23">kendo omiyo jotelo duto mag pinyni bet kanono.<verse eid="ISA 40:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 40:24"/>Ka okudhogi gi muche to giner</para>
  <para style="q2" vid="ISA 40:24">mi kalausi dhi kodgi ka mihudhwe,</para>
  <para style="q1" vid="ISA 40:24">nikech gichalo gi kodhi mokom machiegni,</para>
  <para style="q2" vid="ISA 40:24">ma tiendgi pok ochwowo lowo.<verse eid="ISA 40:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 40:25"/>Nyasaye Maler penjo niya, “En ngʼa madupima-go?</para>
  <para style="q2" vid="ISA 40:25">Koso en ngʼa madirom koda?”<verse eid="ISA 40:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 40:26"/>Tingʼuru wengeu malo kendo ungʼi polo:</para>
  <para style="q2" vid="ISA 40:26">En ngʼa manochweyo gigi duto?</para>
  <para style="q1" vid="ISA 40:26">Donge en ema nomiyo sulwe manie kor polo obetie kokelogi achiel kachiel,</para>
  <para style="q2" vid="ISA 40:26">koluongo moro ka moro gi nyinge.</para>
  <para style="q1" vid="ISA 40:26">Onge moro kuomgi molal</para>
  <para style="q2" vid="ISA 40:26">nikech tekone duongʼ kod nyalone.<verse eid="ISA 40:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 40:27"/>Yaye joka Jakobo angʼo momiyo uwuoyo,</para>
  <para style="q2" vid="ISA 40:27">angʼo momiyo ungʼur, yaye jo-Israel,</para>
  <para style="q1" vid="ISA 40:27">kuwacho niya, “Jehova Nyasaye ok dew yorena;</para>
  <para style="q2" vid="ISA 40:27">kendo ni yorena ok okwan ka gimoro gi Nyasacha.”<verse eid="ISA 40:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 40:28"/>Donge ungʼeyo?</para>
  <para style="q2" vid="ISA 40:28">Koso pok uwinjo?</para>
  <para style="q1" vid="ISA 40:28">Jehova Nyasaye en Nyasaye manyaka chiengʼ</para>
  <para style="q2" vid="ISA 40:28">kendo Jachwech mar piny duto.</para>
  <para style="q1" vid="ISA 40:28">Ok nobed mool bende ok nonyosre,</para>
  <para style="q2" vid="ISA 40:28">kendo pache onge ngʼama nyalo ngʼeyo.<verse eid="ISA 40:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 40:29"/>Omiyo joma ool teko</para>
  <para style="q2" vid="ISA 40:29">kendo omedo joma tekregi orumo bedo motegno.<verse eid="ISA 40:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 40:30"/>Jomatindo nyalo bedo mool mi nyosre,</para>
  <para style="q2" vid="ISA 40:30">kendo yawuowi nyalo chwanyore mi podhi,<verse eid="ISA 40:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 40:31"/>to joma oketo genogi kuom Jehova Nyasaye</para>
  <para style="q2" vid="ISA 40:31">tekregi nodwogi.</para>
  <para style="q1" vid="ISA 40:31">Gibiro huyo mana ka ongo mafuyo gi bwombe;</para>
  <para style="q2" vid="ISA 40:31">gibiro ringo to ok gibi bedo mool,</para>
  <para style="q2" vid="ISA 40:31">bende gibiro wuotho to tekregi ok norum.<verse eid="ISA 40:31"/></para>
  <chapter eid="ISA 40"/>
  <chapter number="41" style="c" sid="ISA 41"/>
  <para style="s1">Jehova Nyasaye en jakony mar Israel</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 41:1"/>“Lingʼuru e nyima, un pinje mag chula e dier nam!</para>
  <para style="q2" vid="ISA 41:1">Weuru ogendini obed motegno!</para>
  <para style="q1" vid="ISA 41:1">Wegiuru gisud machiegni mondo giwuo;</para>
  <para style="q2" vid="ISA 41:1">kendo warom kaachiel kama ingʼadoe bura.<verse eid="ISA 41:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 41:2"/>“En ngʼa mosejiwo ngʼat maa yo wuok chiengʼ,</para>
  <para style="q2" vid="ISA 41:2">kaluonge kuom tim makare mondo otim tichne?</para>
  <para style="q1" vid="ISA 41:2">Ochiwo ogendini e lwete</para>
  <para style="q2" vid="ISA 41:2">kendo oloyo Ruodhi e nyime.</para>
  <para style="q1" vid="ISA 41:2">Otiekogi gi liganglane ma gichal gi buru</para>
  <para style="q2" vid="ISA 41:2">kendo okeyogi gi asere mana ka mihudhwe ma yamo tero.<verse eid="ISA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 41:3"/>Olawogi matek nyaka e yore mane pok owuothoe</para>
  <para style="q2" vid="ISA 41:3">kendo okadho yorego maber mak ohinyre.<verse eid="ISA 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 41:4"/>En ngʼa mosetimo kamano mochopo dwarone,</para>
  <para style="q2" vid="ISA 41:4">koluongo tiengʼ ka tiengʼ nyaka chakre chon?</para>
  <para style="q1" vid="ISA 41:4">En mana an Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 41:4">an ema akwongo kendo An ema agik.”<verse eid="ISA 41:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 41:5"/>Pinje manie chula oseneno wachno mi luoro omakogi;</para>
  <para style="q2" vid="ISA 41:5">kendo tungʼ piny nyaka tungʼ piny kirni.</para>
  <para style="q1" vid="ISA 41:5">Gibiro ka gisudo machiegni.<verse eid="ISA 41:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 41:6"/>Kamoro konyo nyawadgi,</para>
  <para style="q2" vid="ISA 41:6">kendo jiwo wadgi kowachone niya, “Bed gichir!”<verse eid="ISA 41:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 41:7"/>Kamano japecho jiwo jatheth,</para>
  <para style="q2" vid="ISA 41:7">kendo ngʼat matiyo gi nyundo,</para>
  <para style="q2" vid="ISA 41:7">jiwo ngʼatno magoyo musmal,</para>
  <para style="q1" vid="ISA 41:7">konyiso jawengʼo gi mach niya, “Iriwo nyinyono maber.”</para>
  <para style="q2" vid="ISA 41:7">Ngʼat machielo to guro nyasacheno motegno mondo kik lwar piny.<verse eid="ISA 41:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 41:8"/>“To in, yaye Israel jatichna,</para>
  <para style="q2" vid="ISA 41:8">un joka Jakobo ma aseyiero,</para>
  <para style="q2" vid="ISA 41:8">un nyikwa Ibrahim osiepna,<verse eid="ISA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 41:9"/>ne agolou e tungʼ piny gi tungʼ piny,</para>
  <para style="q2" vid="ISA 41:9">kendo ne aluongou kagolou mabor.</para>
  <para style="q1" vid="ISA 41:9">Ne awacho ni, ‘In jatichna’;</para>
  <para style="q2" vid="ISA 41:9">aseyieri bende pok akwedi.<verse eid="ISA 41:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 41:10"/>Omiyo kik ibed maluor, nimar an kodi;</para>
  <para style="q2" vid="ISA 41:10">bende kik kibaji goyi, nimar an Nyasachi.</para>
  <para style="q1" vid="ISA 41:10">Abiro miyi teko kendo abiro konyi;</para>
  <para style="q2" vid="ISA 41:10">bende abiro siri gi bada ma korachwich mar loch.”<verse eid="ISA 41:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 41:11"/>“Jogo duto mamon kodi</para>
  <para style="q2" vid="ISA 41:11">wigi biro kuot ma dhier nono,</para>
  <para style="q1" vid="ISA 41:11">adier jogo duto makwedi</para>
  <para style="q2" vid="ISA 41:11">biro lal nono.<verse eid="ISA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 41:12"/>Ibiro manyo wasikigo</para>
  <para style="q2" vid="ISA 41:12">to ok iniyudgi.</para>
  <para style="q1" vid="ISA 41:12">Chutho jogo makedo kodi</para>
  <para style="q2" vid="ISA 41:12">ok nobed gimoro kata matin.”<verse eid="ISA 41:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 41:13"/>Nimar an Jehova Nyasaye ma Nyasachi</para>
  <para style="q2" vid="ISA 41:13">mamako badi ma korachwich,</para>
  <para style="q1" vid="ISA 41:13">omiyo awachoni niya, “Kik ibed maluor;</para>
  <para style="q2" vid="ISA 41:13">abiro konyi.<verse eid="ISA 41:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 41:14"/>Kik ibed maluor, yaye Jakobo,</para>
  <para style="q2" vid="ISA 41:14">kata obedo ni inenori ni iyomyom ka kudni kamano,</para>
  <para style="q2" vid="ISA 41:14">yaye in Israel matin maonge ndhathe kik ibed maluor,</para>
  <para style="q1" vid="ISA 41:14">nimar an awuon abiro konyi,” Jehova Nyasaye Maler mar Israel,</para>
  <para style="q2" vid="ISA 41:14">ma Jawarni ema asewacho kamano.<verse eid="ISA 41:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 41:15"/>“Ne, abiro miyo ichal gi gir dino</para>
  <para style="q2" vid="ISA 41:15">ngano manyien kendo ma pod lekene bith.</para>
  <para style="q1" vid="ISA 41:15">Ibiro muko gode madongo kitoyogi matindo tindo</para>
  <para style="q2" vid="ISA 41:15">kendo inimi gode matindo lokre buru.<verse eid="ISA 41:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 41:16"/>Inipiedhgi to yamo nokegi</para>
  <para style="q2" vid="ISA 41:16">kendo kalausi notergi mabor.</para>
  <para style="q1" vid="ISA 41:16">To inibed mamor nikech Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 41:16">kendo inibed gi ilo nikech Nyasaye Maler mar Israel.<verse eid="ISA 41:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 41:17"/>“Joma chandore kendo joma odhier manyo pi,</para>
  <para style="q2" vid="ISA 41:17">to ok gininwangʼ,</para>
  <para style="q2" vid="ISA 41:17">omiyo dwondgi otwo nikech riyo ohingogi.</para>
  <para style="q1" vid="ISA 41:17">To an Jehova Nyasaye abiro resogi;</para>
  <para style="q2" vid="ISA 41:17">An, ma an Nyasach Israel ok anajwangʼ-gi.<verse eid="ISA 41:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 41:18"/>Abiro miyo aore mol kawuok kuonde motwo,</para>
  <para style="q2" vid="ISA 41:18">kendo sokni biro tuch e holni.</para>
  <para style="q1" vid="ISA 41:18">Abiro miyo piny motimo ongoro bed gi pi thidhna,</para>
  <para style="q2" vid="ISA 41:18">kendo kuonde motimo okak sokni nowuogie.<verse eid="ISA 41:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 41:19"/>Abiro miyo yiend sida gi siala, gi ochwoga kod zeituni</para>
  <para style="q2" vid="ISA 41:19">twi e piny motimo ongoro.</para>
  <para style="q1" vid="ISA 41:19">Abiro pidho yiende kuonde ma yande ojwangʼ,</para>
  <para style="q2" vid="ISA 41:19">bap ndege gi obudo nodongʼ kaachiel,<verse eid="ISA 41:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 41:20"/>mondo ji one kendo ongʼe,</para>
  <para style="q2" vid="ISA 41:20">mondo gipar kendo gibed giwinjo,</para>
  <para style="q1" vid="ISA 41:20">ni lwet Jehova Nyasaye ema osetimo kamano,</para>
  <para style="q2" vid="ISA 41:20">kendo ni Nyasaye Maler mar Israel ema osemiyo magi otimore.”<verse eid="ISA 41:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 41:21"/>Jehova Nyasaye wacho niya,</para>
  <para style="q2" vid="ISA 41:21">“Kel ane ywakni.”</para>
  <para style="q1" vid="ISA 41:21">Ruodh Jakobo wacho niya,</para>
  <para style="q2" vid="ISA 41:21">“Wuouru ane kuom wachni.<verse eid="ISA 41:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 41:22"/>Un nyisecheu manono,</para>
  <para style="q2" vid="ISA 41:22">nyiswa anena gima biro timore.</para>
  <para style="q1" vid="ISA 41:22">Nyiswa anena tiend gik mane osetimore,</para>
  <para style="q2" vid="ISA 41:22">mondo omi wangʼe ni gichalo nade,</para>
  <para style="q2" vid="ISA 41:22">kendo nyiswa anena kaka gikogi nobedi.</para>
  <para style="q1" vid="ISA 41:22">Kata nyiswa anena gik mabiro timore,<verse eid="ISA 41:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="ISA 41:23"/>kendo nyiswa anena ni angʼo mabiro timore,</para>
  <para style="q2" vid="ISA 41:23">mondo wangʼe ni un nyiseche.</para>
  <para style="q1" vid="ISA 41:23">Timuru ane gimoro, bed ni ber kata rach,</para>
  <para style="q2" vid="ISA 41:23">manyalo bwogowa kendo kelo luoro kuomwa.<verse eid="ISA 41:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 41:24"/>To kata kamano ok unyal gimoro kendo gik mutimo onge tich;</para>
  <para style="q2" vid="ISA 41:24">bende ngʼat makwanou ka nyisechene en raura ka un.<verse eid="ISA 41:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 41:25"/>“Asejiwo ngʼato mawuok nyandwat kendo obiro,</para>
  <para style="q2" vid="ISA 41:25">en ngʼat maa yo wuok chiengʼ maluongo nyinga.</para>
  <para style="q1" vid="ISA 41:25">Onyono Ruodhi mag piny mana ka lop muono,</para>
  <para style="q2" vid="ISA 41:25">mi onywasgi mana kaka jachwech nywaso lop chweyo agulu.<verse eid="ISA 41:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 41:26"/>En ngʼa mane ofwenyo wachni nyaka aa chakruok, mondo wangʼe wachni</para>
  <para style="q2" vid="ISA 41:26">kata en ngʼa mane fwenye kapok otimore mondo</para>
  <para style="q2" vid="ISA 41:26">ne wawachi ni, ‘Ne owacho adier’?</para>
  <para style="q1" vid="ISA 41:26">Onge ngʼato mane owacho ma</para>
  <para style="q2" vid="ISA 41:26">kata mane owuoyo kuome chon,</para>
  <para style="q2" vid="ISA 41:26">bende onge ngʼato mane owinjo wach moro amora koa kuomi.<verse eid="ISA 41:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 41:27"/>An ema ne akwongo nyiso Sayun kawachone ni,</para>
  <para style="q2" vid="ISA 41:27">‘Ne, eri gin ka!’</para>
  <para style="q2" vid="ISA 41:27">Ne aoro jaote mondo oter wach maber Jerusalem.<verse eid="ISA 41:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 41:28"/>Ne amanyo to ok aneno ngʼato,</para>
  <para style="q2" vid="ISA 41:28">onge ngʼato kuomgi manyalo puonjo,</para>
  <para style="q2" vid="ISA 41:28">bende onge ngʼato e diergi manyalo dwoko penjona.<verse eid="ISA 41:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 41:29"/>Neuru, nyisechegi duto gin gik manono!</para>
  <para style="q2" vid="ISA 41:29">Timbegi duto onge tich,</para>
  <para style="q2" vid="ISA 41:29">kendo kido ma gilamo chalo mana gi yamo kendo gin gik manono.”<verse eid="ISA 41:29"/></para>
  <chapter eid="ISA 41"/>
  <chapter number="42" style="c" sid="ISA 42"/>
  <para style="s1">Jatich Jehova Nyasaye</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 42:1"/>“Ma e jatichna masemiyo teko,</para>
  <para style="q2" vid="ISA 42:1">en e ngʼat ma aseyiero, kendo ma chunya morgo,</para>
  <para style="q1" vid="ISA 42:1">abiro keto Roho mara Maler</para>
  <para style="q2" vid="ISA 42:1">kendo obiro kelo adiera ne ogendini.<verse eid="ISA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 42:2"/>Ok obi goyo koko kata nduru,</para>
  <para style="q2" vid="ISA 42:2">dwonde bende ok nowinji e wangʼ yore.<verse eid="ISA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 42:3"/>Kata obedo ni onenore kaka odundu mayom yom ok notur</para>
  <para style="q2" vid="ISA 42:3">kendo kata obedo ni oliel ka taya ma mirimiri to ok notho.</para>
  <para style="q1" vid="ISA 42:3">Enongʼad bura gadiera;<verse eid="ISA 42:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 42:4"/>ok nochwanyre kata chunye bende ok nonyosre,</para>
  <para style="q1" vid="ISA 42:4">nyaka okel adiera e piny duto.</para>
  <para style="q2" vid="ISA 42:4">Pinje duto manie chula mag dier nam biro keto genogi kuom chikene.”<verse eid="ISA 42:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 42:5"/>Nyasaye ma en Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 42:5">kendo ma Jachwech polo malach,</para>
  <para style="q2" vid="ISA 42:5">gi piny kod gik moko duto manie iye.</para>
  <para style="q1" vid="ISA 42:5">En ema ochiwo muya ne dhano</para>
  <para style="q2" vid="ISA 42:5">kod ngima ne joma wuotho e piny.</para>
  <para style="q2" vid="ISA 42:5">Owacho kama:<verse eid="ISA 42:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 42:6"/>“An Jehova Nyasaye, aseluongi mondo anyisi adierana;</para>
  <para style="q2" vid="ISA 42:6">abiro mako lweti.</para>
  <para style="q1" vid="ISA 42:6">Abiro riti kendo ibiro keti gir singruok e kinda gi ji</para>
  <para style="q2" vid="ISA 42:6">kendo abiro keti ler mar ogendini duto,<verse eid="ISA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 42:7"/>mondo iyaw wenge muofni,</para>
  <para style="q2" vid="ISA 42:7">kendo igol joma oketi e od twech,</para>
  <para style="q2" vid="ISA 42:7">kendo igony joma otwe mobetie mudho.<verse eid="ISA 42:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 42:8"/>“Nyinga ma ongʼeyago en; Jehova Nyasaye!</para>
  <para style="q2" vid="ISA 42:8">Ok anawe duongʼ mara ne nyasaye moro,</para>
  <para style="q2" vid="ISA 42:8">bende pak ma ipakago ok nopakgo nyiseche mopa.<verse eid="ISA 42:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 42:9"/>Koro ne, gik machon osetimore</para>
  <para style="q2" vid="ISA 42:9">bende anyisou gik manyien mabiro timore,</para>
  <para style="q1" vid="ISA 42:9">to kapok gitimore</para>
  <para style="q2" vid="ISA 42:9">to ahulonugi.”<verse eid="ISA 42:9"/></para>
  <para style="s1">Wend pak ne Jehova Nyasaye</para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 42:10"/>Werneuru Jehova Nyasaye wer manyien,</para>
  <para style="q2" vid="ISA 42:10">kupako nyinge e piny duto,</para>
  <para style="q1" vid="ISA 42:10">un joma kwangʼ e nam kaachiel gi gik manie yie</para>
  <para style="q2" vid="ISA 42:10">gi pinje mag chula mar nam kod ji duto modak.<verse eid="ISA 42:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 42:11"/>Weuru kuonde motimo ongoro gi miechgi mondo ogo koko;</para>
  <para style="q2" vid="ISA 42:11">kendo weuru joma odak e gwenge mag Kedar obed mamor.</para>
  <para style="q1" vid="ISA 42:11">Weuru joma odak Sela ower gi mor,</para>
  <para style="q2" vid="ISA 42:11">ka gikok ewi got malo.<verse eid="ISA 42:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 42:12"/>Weuru gimi nying Jehova Nyasaye duongʼ</para>
  <para style="q2" vid="ISA 42:12">kendo giland pakne e pinje manie chula.<verse eid="ISA 42:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 42:13"/>Jehova Nyasaye biro wuok oko ka thuon maratego,</para>
  <para style="q2" vid="ISA 42:13">enobed gi mirima mager mana ka jalweny;</para>
  <para style="q1" vid="ISA 42:13">kendo enokogi ka ogiyo sigich lweny,</para>
  <para style="q2" vid="ISA 42:13">mi olo wasike.<verse eid="ISA 42:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 42:14"/>Nimar kuom kinde mangʼeny aselingʼ,</para>
  <para style="q2" vid="ISA 42:14">asehora kendo aseterora mos.</para>
  <para style="q1" vid="ISA 42:14">To koro sani, abiro chalo mana ka dhako mamuoch kayo,</para>
  <para style="q2" vid="ISA 42:14">maywak ka gamo yweyo matek.<verse eid="ISA 42:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 42:15"/>Abiro tieko gode madongo gi gode matindo</para>
  <para style="q2" vid="ISA 42:15">kendo anami gik motwi kuome two;</para>
  <para style="q1" vid="ISA 42:15">bende anami aore lokre pinje manie chula</para>
  <para style="q2" vid="ISA 42:15">kendo nami yewni dwon.<verse eid="ISA 42:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 42:16"/>Anatel ne muofni mondo owuothi e yore mane ok gingʼeyo,</para>
  <para style="q2" vid="ISA 42:16">kuonde mapok giwuothoe ema anatagie;</para>
  <para style="q1" vid="ISA 42:16">kendo anami mudho olokrenegi ler,</para>
  <para style="q2" vid="ISA 42:16">kendo analos kuonde bugni bed mopie.</para>
  <para style="q1" vid="ISA 42:16">Magi e gik ma abiro timo;</para>
  <para style="q2" vid="ISA 42:16">kendo ok najwangʼ-gi.<verse eid="ISA 42:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 42:17"/>To jogo ma oketo genogi kuom nyiseche mopa,</para>
  <para style="q2" vid="ISA 42:17">mawacho ni kido mopa niya, Un e nyisechewa,</para>
  <para style="q2" vid="ISA 42:17">jogo nokwed magiyud wichkuot.<verse eid="ISA 42:17"/></para>
  <para style="s1">Israel muofu kendo ite odino</para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 42:18"/>“Winjuru un joma itgi odino</para>
  <para style="q2" vid="ISA 42:18">un muofni ngʼiuru mondo une!<verse eid="ISA 42:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 42:19"/>En ngʼa ma muofu makmana jotichna,</para>
  <para style="q2" vid="ISA 42:19">kendo ma ite odino ka jaote maoro?</para>
  <para style="q1" vid="ISA 42:19">Koso en ngʼa ma muofu maloyo ngʼat mochiworena,</para>
  <para style="q2" vid="ISA 42:19">kata ma muofu maloyo jatich Jehova Nyasaye?<verse eid="ISA 42:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 42:20"/>Iseneno gik mangʼeny, to ok isedewo;</para>
  <para style="q2" vid="ISA 42:20">iti to oyawore, to gima iwinjo ema onge.”<verse eid="ISA 42:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 42:21"/>Jehova Nyasaye ne mor</para>
  <para style="q2" vid="ISA 42:21">mondo chikne obed gi teko kod duongʼ,</para>
  <para style="q2" vid="ISA 42:21">mondo adiera mare olandre.<verse eid="ISA 42:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 42:22"/>To jogi gin joma oyaki kendo omaa,</para>
  <para style="q2" vid="ISA 42:22">giduto gisenyumore ma gimoko e bugni,</para>
  <para style="q2" vid="ISA 42:22">kendo opandgi e ute mag twech.</para>
  <para style="q1" vid="ISA 42:22">Gisebedo gik moyaki</para>
  <para style="q2" vid="ISA 42:22">maonge ngʼama nyalo resogi;</para>
  <para style="q1" vid="ISA 42:22">bende gichalo gik moyaki</para>
  <para style="q2" vid="ISA 42:22">maonge ngʼama nyalo wacho niya, “Dwokgi.”<verse eid="ISA 42:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 42:23"/>En ngʼa kuomu manyalo winjo wachni</para>
  <para style="q2" vid="ISA 42:23">kata chiko ite malongʼo e ndalo mabiro?<verse eid="ISA 42:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 42:24"/>En ngʼa mane ochiwo Jakobo mondo obed gima oyaki,</para>
  <para style="q2" vid="ISA 42:24">kendo jo-Israel e lwet joyeko?</para>
  <para style="q1" vid="ISA 42:24">Donge en Jehova Nyasaye</para>
  <para style="q2" vid="ISA 42:24">ma wasetimo richo e nyime?</para>
  <para style="q1" vid="ISA 42:24">Nimar ne ok ginyal luwo yorene;</para>
  <para style="q2" vid="ISA 42:24">bende ne ok girito chikene.<verse eid="ISA 42:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 42:25"/>Omiyo noolo mirimbe mager</para>
  <para style="q2" vid="ISA 42:25">mar lweny kuomgi.</para>
  <para style="q1" vid="ISA 42:25">Ne olworogi gi mach mawengʼo to ne ok gidewe;</para>
  <para style="q2" vid="ISA 42:25">bende majno ne owangʼogi to ne ok gidewe.<verse eid="ISA 42:25"/></para>
  <chapter eid="ISA 42"/>
  <chapter number="43" style="c" sid="ISA 43"/>
  <para style="s1">Jakony makende mar Israel</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 43:1"/>To koro ma e gima Jehova Nyasaye wacho,</para>
  <para style="q2" vid="ISA 43:1">Nyasaye mane ochweyi, yaye Jakobo,</para>
  <para style="q2" vid="ISA 43:1">Nyasaye mane ochweyi, yaye Israel:</para>
  <para style="q1" vid="ISA 43:1">“Kik ibed maluor, nimar aseresi;</para>
  <para style="q2" vid="ISA 43:1">kendo aseluongi gi nyingi ni in mara awuon.<verse eid="ISA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 43:2"/>Ka ikadho ei pige matut,</para>
  <para style="q2" vid="ISA 43:2">to anabed kodi;</para>
  <para style="q1" vid="ISA 43:2">kendo ka ungʼado aore</para>
  <para style="q2" vid="ISA 43:2">to ok giniteru.</para>
  <para style="q1" vid="ISA 43:2">Ka uwuotho e mach mager</para>
  <para style="q2" vid="ISA 43:2">to ok nowangʼu,</para>
  <para style="q2" vid="ISA 43:2">kata mana mach makakni ok nowangʼu.<verse eid="ISA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 43:3"/>Nimar an Jehova Nyasaye, ma Nyasachi,</para>
  <para style="q2" vid="ISA 43:3">Nyasaye Maler mar Israel, ma Jawarni;</para>
  <para style="q1" vid="ISA 43:3">achiwo Misri gi Kush kod Seba</para>
  <para style="q2" vid="ISA 43:3">ka gir chudo mondo oresigo.<verse eid="ISA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 43:4"/>Nikech in ngʼat makare kendo mogen e nyima</para>
  <para style="q2" vid="ISA 43:4">kendo nikech aheri,</para>
  <para style="q1" vid="ISA 43:4">abiro chiwo ji kar loi mondo aresigo</para>
  <para style="q2" vid="ISA 43:4">kendo abiro chiwo ji mamoko mondo ochungʼ e loi.<verse eid="ISA 43:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 43:5"/>Kik ibed maluor, nimar an kodi;</para>
  <para style="q2" vid="ISA 43:5">abiro duogo nyithindi koa yo wuok chiengʼ,</para>
  <para style="q2" vid="ISA 43:5">kendo abiro choko nyithindi moa yo podho chiengʼ.<verse eid="ISA 43:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 43:6"/>Abiro wachone joma odak nyandwat ni, ‘Wegi gidhi!’</para>
  <para style="q2" vid="ISA 43:6">Kendo ni joma odak milambo ni, ‘Kik ugengʼ-gi.’</para>
  <para style="q1" vid="ISA 43:6">Keluru yawuota moa mabor</para>
  <para style="q2" vid="ISA 43:6">kaachiel gi nyiga koa e tunge piny,<verse eid="ISA 43:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 43:7"/>ngʼato angʼata miluongo gi nyinga,</para>
  <para style="q2" vid="ISA 43:7">ngʼat mane achweyo mondo omiya duongʼ,</para>
  <para style="q2" vid="ISA 43:7">ngʼat mane achweyo kendo amiyo ngima.”<verse eid="ISA 43:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 43:8"/>Keluru jogo man-gi wenge to ok nyal neno,</para>
  <para style="q2" vid="ISA 43:8">to bende gin gi it to ok giwinj wach.<verse eid="ISA 43:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 43:9"/>Ogendini duto chokore kanyakla</para>
  <para style="q2" vid="ISA 43:9">kendo ji duto chokore kamoro achiel.</para>
  <para style="q1" vid="ISA 43:9">En ngʼa kuomgi mane ofwenyo gima kama kapok otimore</para>
  <para style="q2" vid="ISA 43:9">kendo mane owachonwa gigo mane otimore chon?</para>
  <para style="q1" vid="ISA 43:9">Wegiuru gikel joneno mag-gi mondo onyiswa ane ni ne gin kare,</para>
  <para style="q2" vid="ISA 43:9">eka joma owinjo owachi niya, “En adier.”<verse eid="ISA 43:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 43:10"/>Jehova Nyasaye wacho niya, “Un joneno maga ma wuoyo kuoma”</para>
  <para style="q2" vid="ISA 43:10">kendo jotichna ma aseyiero,</para>
  <para style="q1" vid="ISA 43:10">mondo mi ungʼe kendo uyie kuoma</para>
  <para style="q2" vid="ISA 43:10">kendo ubed gingʼeyo ni An e Nyasaye.</para>
  <para style="q1" vid="ISA 43:10">Onge Nyasaye moro ma nobetie kapok abet</para>
  <para style="q2" vid="ISA 43:10">bende onge nyasaye moro manobi bangʼe.<verse eid="ISA 43:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 43:11"/>An e Jehova Nyasaye adier,</para>
  <para style="q2" vid="ISA 43:11">kendo onge jawar moro machielo makmana an.<verse eid="ISA 43:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 43:12"/>An awuon ema asenyisou, aseresou kendo asewachonu</para>
  <para style="q2" vid="ISA 43:12">ni an ema asetimo magi ma ok nyiseche manono ma un-go e dieru.</para>
  <para style="q1" vid="ISA 43:12">Jehova Nyasaye wacho niya,</para>
  <para style="q2" vid="ISA 43:12">“Un e joneno maga ni an e Nyasaye.”<verse eid="ISA 43:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="ISA 43:13"/>Ee An ema asebetie nyaka aa chakruok.</para>
  <para style="q1" vid="ISA 43:13">Gima amako onge ngʼama nyalo golo e lweta.</para>
  <para style="q2" vid="ISA 43:13">En ngʼa manyalo ketho gima atimo?<verse eid="ISA 43:13"/></para>
  <para style="s1">Ngʼwono mar Nyasaye gi jo-Israel ma ok joratiro</para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 43:14"/>Ma e gima Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 43:14">Jal Maler mar Israel ma jaresu wacho:</para>
  <para style="q1" vid="ISA 43:14">“Nikech un, abiro oro ji Babulon</para>
  <para style="q2" vid="ISA 43:14">mondo odhi oom jo-Babulon duto e twech,</para>
  <para style="q2" vid="ISA 43:14">kotingʼ-gi e yiedhi mane gisungorego.<verse eid="ISA 43:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 43:15"/>An e Jehova Nyasaye, Jal Maler,</para>
  <para style="q2" vid="ISA 43:15">Jachwech Israel kendo Ruodhu.”<verse eid="ISA 43:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 43:16"/>Ma e gima Jehova Nyasaye wacho,</para>
  <para style="q2" vid="ISA 43:16">Jal manoloso yo e dier nam,</para>
  <para style="q2" vid="ISA 43:16">kendo manoketo yo e kind pi mogingore,<verse eid="ISA 43:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 43:17"/>bende namiyo geche lweny kod farese odonjo kuno,</para>
  <para style="q2" vid="ISA 43:17">kaachiel gi jolweny duto maroteke,</para>
  <para style="q1" vid="ISA 43:17">kendo negirumo kuno ma ok gichako gitingʼo wigi</para>
  <para style="q2" vid="ISA 43:17">mi githo mana ka taya monegi.<verse eid="ISA 43:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 43:18"/>Koro awachonu niya, “Goluru chunyu oko e gik machon</para>
  <para style="q2" vid="ISA 43:18">kendo weuru paro gik mosekadho.<verse eid="ISA 43:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 43:19"/>Neuru, atimo gimoro manyien!</para>
  <para style="q2" vid="ISA 43:19">Koro osechako timore, bende unene?</para>
  <para style="q1" vid="ISA 43:19">Aloso yo e piny motimo ongoro</para>
  <para style="q2" vid="ISA 43:19">kendo aketo aore kuonde mojwangʼ.<verse eid="ISA 43:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 43:20"/>Le mag thim ma gin</para>
  <para style="q2" vid="ISA 43:20">ondiegi kod tula miya duongʼ,</para>
  <para style="q1" vid="ISA 43:20">nikech asemiyogi pi e piny motimo ongoro</para>
  <para style="q2" vid="ISA 43:20">kendo aseketo aore kuonde mojwangʼ,</para>
  <para style="q1" vid="ISA 43:20">mondo joga mayiero oyud pi modho,<verse eid="ISA 43:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="ISA 43:21"/>gin ji mane achweyo ne an awuon,</para>
  <para style="q2" vid="ISA 43:21">mondo omi gipaka.<verse eid="ISA 43:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 43:22"/>“To kata kamano ne ok uluonga mondo akonyu, yaye Jakobo,</para>
  <para style="q2" vid="ISA 43:22">useol koda, yaye Israel.<verse eid="ISA 43:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 43:23"/>Ok usechiwo rombe mondo otimnago misango miwangʼo pep,</para>
  <para style="q2" vid="ISA 43:23">bende ok usemiya duongʼ gi misengini magu.</para>
  <para style="q1" vid="ISA 43:23">Ok asemiyou tingʼ mapek mag chiwo mag cham,</para>
  <para style="q2" vid="ISA 43:23">kata dwaro ni uwangʼna ubani.<verse eid="ISA 43:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 43:24"/>Ne ok ungʼiewona gimoro amora mangʼwe ngʼar,</para>
  <para style="q2" vid="ISA 43:24">bende ne ok udhila gi boche mag misengini.</para>
  <para style="q1" vid="ISA 43:24">To richou kende ema ne tura,</para>
  <para style="q2" vid="ISA 43:24">kendo ne uola mana gi kethou.<verse eid="ISA 43:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 43:25"/>“An kende e jal magolo richou duto</para>
  <para style="q2" vid="ISA 43:25">kendo ok achak apargi nikech mano e gima ahero timo.<verse eid="ISA 43:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 43:26"/>Parnauru gik mane otimore chon,</para>
  <para style="q2" vid="ISA 43:26">mondo wapim wechego kanyakla;</para>
  <para style="q2" vid="ISA 43:26">kendo wachuru ane gik manyiso ni uonge gi ketho.<verse eid="ISA 43:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 43:27"/>Kwaru mokwongo notimo richo;</para>
  <para style="q2" vid="ISA 43:27">kendo jotendu nongʼanyona.<verse eid="ISA 43:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 43:28"/>Kuom mano abiro kuodo wi joma tiyo ei hekalu mau,</para>
  <para style="q2" vid="ISA 43:28">kendo abiro jwangʼo Jakobo mondo otieki,</para>
  <para style="q2" vid="ISA 43:28">mi Israel yud wichkuot.”<verse eid="ISA 43:28"/></para>
  <chapter eid="ISA 43"/>
  <chapter number="44" style="c" sid="ISA 44"/>
  <para style="s1">Israel oganda moyier</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 44:1"/>“Koro winja, yaye Jakobo jatichna,</para>
  <para style="q2" vid="ISA 44:1">in Israel maseyiero.<verse eid="ISA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 44:2"/>Ma e gima Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 44:2">jal mane ochweyi, ei minu,</para>
  <para style="q2" vid="ISA 44:2">kendo mabiro konyi wacho:</para>
  <para style="q1" vid="ISA 44:2">Kik ibed maluor, yaye Jakobo jatichna,</para>
  <para style="q2" vid="ISA 44:2">in Jeshurun maseyiero.<verse eid="ISA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 44:3"/>Nimar abiro kelo koth ne piny mobaro okak</para>
  <para style="q2" vid="ISA 44:3">kendo loso aore e piny motwo;</para>
  <para style="q1" vid="ISA 44:3">bende anaol Roho mara ne nyikwayi</para>
  <para style="q2" vid="ISA 44:3">kendo anagwedh kothi.<verse eid="ISA 44:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 44:4"/>Ginidongi mana ka lum man kama ngʼich</para>
  <para style="q2" vid="ISA 44:4">kata ka omburi manie bath aore.<verse eid="ISA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 44:5"/>Moro kuomgi nowacho ni, ‘An ngʼat Jehova Nyasaye.’</para>
  <para style="q2" vid="ISA 44:5">To machielo to noluongre gi nying Jakobo.</para>
  <para style="q1" vid="ISA 44:5">Moro machielo nondik e lwete ni,</para>
  <para style="q2" vid="ISA 44:5">‘Mar Jehova Nyasaye,’</para>
  <para style="q2" vid="ISA 44:5">kendo giduto giniluongre gi nying Israel.<verse eid="ISA 44:5"/></para>
  <para style="s1">Jehova Nyasaye ma ok nyiseche manono</para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 44:6"/>“Ma e gima Jehova Nyasaye Maratego ma</para>
  <para style="q2" vid="ISA 44:6">Ruodh Israel kendo Jawarne wacho:</para>
  <para style="q1" vid="ISA 44:6">Anie mokwongo kendo e mogik;</para>
  <para style="q2" vid="ISA 44:6">onge Nyasaye moro kendo mopogore koda.<verse eid="ISA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 44:7"/>Ere kare ngʼama chal koda? Ochungane owachi.</para>
  <para style="q2" vid="ISA 44:7">Ohulane kendo olerane e nyima gik mosetimore,</para>
  <para style="q1" vid="ISA 44:7">nyaka ne ayier joga aa chon, kendo mabiro timore;</para>
  <para style="q2" vid="ISA 44:7">adier we onyiswa gigo mabiro timore.<verse eid="ISA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 44:8"/>Kik chunyi nyosre bende kik ibed maluor.</para>
  <para style="q2" vid="ISA 44:8">Donge ne asewacho mae kendo ne afwenye chon?</para>
  <para style="q1" vid="ISA 44:8">Un joneno maga. Bende nitiere Nyasaye moro ma ok An?</para>
  <para style="q2" vid="ISA 44:8">Ooyo, onge Lwanda moro amora mangʼeyo.”<verse eid="ISA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 44:9"/>Jogo duto maloso nyiseche manono gin joma nono,</para>
  <para style="q2" vid="ISA 44:9">kendo gik ma gihero ok kony gimoro.</para>
  <para style="q1" vid="ISA 44:9">Joma wuoyo e logi gin muofni momemore</para>
  <para style="q2" vid="ISA 44:9">kendo mano kelonegi mana wichkuot.<verse eid="ISA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 44:10"/>En ngʼa manyalo loso nyasaye mar bao</para>
  <para style="q2" vid="ISA 44:10">kod mar chuma ma ok nyal miye ohala?<verse eid="ISA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 44:11"/>En kaachiel gi joma chalo kode noyud wichkuot;</para>
  <para style="q2" vid="ISA 44:11">kendo jopechogo gin mana dhano adhana.</para>
  <para style="q1" vid="ISA 44:11">Wegiuru gichokre giduto mondo gichoma tir ane;</para>
  <para style="q2" vid="ISA 44:11">ka ok giniyud wichkuot maduongʼ.<verse eid="ISA 44:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 44:12"/>Jatheth ema keto chuma e mach mi chwakre</para>
  <para style="q2" vid="ISA 44:12">bangʼe ogoye gi nyundo, kolosogo nyasaye manono,</para>
  <para style="q1" vid="ISA 44:12">kendo oloso gi tekone duto.</para>
  <para style="q2" vid="ISA 44:12">Bangʼ mano obedo modenyo kendo mool;</para>
  <para style="q2" vid="ISA 44:12">bende obedo monyosore kendo riyo loye.<verse eid="ISA 44:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 44:13"/>Japecho pimo bao gi tol kendo oketo kido kuome;</para>
  <para style="q2" vid="ISA 44:13">opaye gi koyo; kendo ogoro kuonde modwaro loso.</para>
  <para style="q1" vid="ISA 44:13">Olose e kido machalo gi dhano,</para>
  <para style="q2" vid="ISA 44:13">e kido mar dhano gi duongʼne duto,</para>
  <para style="q2" vid="ISA 44:13">mondo omi ochunge e od lemo.<verse eid="ISA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 44:14"/>Ne onyalo ngʼado yiend sida kata yiend ober.</para>
  <para style="q2" vid="ISA 44:14">Oweye mondo odongi e kind yiende mamoko e bungu,</para>
  <para style="q1" vid="ISA 44:14">kata ne onyalo pidho yiende mamoko</para>
  <para style="q2" vid="ISA 44:14">mi koth mi yiendego odongi.<verse eid="ISA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 44:15"/>Dir yadhno ochwakogo chiemo,</para>
  <para style="q2" vid="ISA 44:15">bathe mamoko omokogo mach mondo oo,</para>
  <para style="q1" vid="ISA 44:15">eka dir yadhno konchiel otedogo makati.</para>
  <para style="q2" vid="ISA 44:15">To bende bath yien achielno opayogo nyasaye molamo,</para>
  <para style="q2" vid="ISA 44:15">kokulorene piny.<verse eid="ISA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 44:16"/>Dir yadhno ochwako e kendo mi olosgo chiemo,</para>
  <para style="q2" vid="ISA 44:16">kendo obule ringʼo moyiengʼ.</para>
  <para style="q1" vid="ISA 44:16">Bende ooyo majno kowacho ni,</para>
  <para style="q2" vid="ISA 44:16">“Adier, awinjo maber kendo denda yudo liet.”<verse eid="ISA 44:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 44:17"/>Bath yien modongʼ opayo mi olosgo nyasaye,</para>
  <para style="q2" vid="ISA 44:17">mokulorene kendo olamo.</para>
  <para style="q2" vid="ISA 44:17">Olame kowacho niya, “Resa in e nyasacha.”<verse eid="ISA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 44:18"/>Onge gima gingʼeyo, onge gima giwinjo;</para>
  <para style="q2" vid="ISA 44:18">wengegi omuon ti ma ok ginyal neno,</para>
  <para style="q2" vid="ISA 44:18">kendo pachgi odinore ma ok ginyal winjo.<verse eid="ISA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 44:19"/>Onge ngʼama hore mapar, onge ngʼama nigi ngʼeyo</para>
  <para style="q2" vid="ISA 44:19">kata winjo makare manyalo wacho niya,</para>
  <para style="q2" vid="ISA 44:19">“Nus mare ne atiyogo kaka gir chweko;</para>
  <para style="q1" vid="ISA 44:19">to bende ne atedo makati katiyo gi mirnigo,</para>
  <para style="q2" vid="ISA 44:19">kendo ne abulo ringʼo mi achamo.</para>
  <para style="q1" vid="ISA 44:19">Bende anyalo loso gima ok oher kuom gima odongʼ?</para>
  <para style="q2" vid="ISA 44:19">Bende anyalo kulora piny ne osiki?”<verse eid="ISA 44:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 44:20"/>Ochamo buru, chunye mobam wuonde;</para>
  <para style="q2" vid="ISA 44:20">ok onyal resore kende, kata wacho ni,</para>
  <para style="q1" vid="ISA 44:20">“Donge gima ni e lweta korachwich ni miriambo?”<verse eid="ISA 44:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 44:21"/>“Par gigi, yaye Jakobo,</para>
  <para style="q2" vid="ISA 44:21">nimar in jatichna, yaye Israel.</para>
  <para style="q1" vid="ISA 44:21">Asechweyi, in jatichna;</para>
  <para style="q2" vid="ISA 44:21">yaye Israel, wiya ok nowil kodi.<verse eid="ISA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 44:22"/>Asekeyo timbeni manono mana ka boche polo,</para>
  <para style="q2" vid="ISA 44:22">kendo aserucho richogi modwono mana kongʼwengʼo.</para>
  <para style="q1" vid="ISA 44:22">Duog ira,</para>
  <para style="q2" vid="ISA 44:22">nimar aseresi.”<verse eid="ISA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 44:23"/>Weruru gi mor,</para>
  <para style="q2" vid="ISA 44:23">yaye polo, nimar Jehova Nyasaye ema osetimo ma;</para>
  <para style="q1" vid="ISA 44:23">koguru matek, yaye piny mamwalo.</para>
  <para style="q2" vid="ISA 44:23">Weruru matek un gode,</para>
  <para style="q1" vid="ISA 44:23">bunge kod yiende duto,</para>
  <para style="q2" vid="ISA 44:23">nimar Jehova Nyasaye osereso Jakobo,</para>
  <para style="q2" vid="ISA 44:23">kendo osenyiso ayanga duongʼ mare e Israel.<verse eid="ISA 44:23"/></para>
  <para style="s1">Ji nodag Jerusalem</para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 44:24"/>“Ma e gima Jehova Nyasaye</para>
  <para style="q2" vid="ISA 44:24">ma Jaresni, Jal mane ochweyoi e ich wacho:</para>
  <para style="b" vid="ISA 44:24"/>
  <para style="q1" vid="ISA 44:24">“An e Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 44:24">ma Jachwech gik moko duto,</para>
  <para style="q2" vid="ISA 44:24">mane ochweyo polo malach,</para>
  <para style="q2" vid="ISA 44:24">ma bende en owuon ema nochweyo piny,<verse eid="ISA 44:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 44:25"/>oketho ranyisi mag jonabi mariambo</para>
  <para style="q2" vid="ISA 44:25">kendo miyo joma neno gik moko nenore mofuwo,</para>
  <para style="q1" vid="ISA 44:25">bende odwoko weche jomariek</para>
  <para style="q2" vid="ISA 44:25">chien mi ginere gik maonge tich,<verse eid="ISA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 44:26"/>kendo okawo weche jotichne</para>
  <para style="q2" vid="ISA 44:26">mi omi weche jootene,</para>
  <para style="b" vid="ISA 44:26"/>
  <para style="q1" vid="ISA 44:26">“ma giwacho kuom Jerusalem chop kare kama:</para>
  <para style="q2" vid="ISA 44:26">‘Ibiro dak e iyi,’</para>
  <para style="q1" vid="ISA 44:26">kendo ne miech Juda ni,</para>
  <para style="q2" vid="ISA 44:26">‘Ibiro gergi kendo,’</para>
  <para style="q1" vid="ISA 44:26">to bende ne kuonde momukore ni,</para>
  <para style="q2" vid="ISA 44:26">‘Abiro loso kuonde mane omukore obed maber kendo,’<verse eid="ISA 44:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 44:27"/>bende mawachone nembe ni, ‘Dwon,</para>
  <para style="q2" vid="ISA 44:27">kendo abiro miyo aocheni dwon,’<verse eid="ISA 44:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 44:28"/>kendo owuoyo kuom Sairas ni, ‘En jakwadha</para>
  <para style="q2" vid="ISA 44:28">kendo enochop kare gigo duto madwaro;</para>
  <para style="q1" vid="ISA 44:28">enowachne Jerusalem niya, “Mad gere kendo,”</para>
  <para style="q2" vid="ISA 44:28">to ne hekalu ni, “Mad mise mare keti.” ’ ”<verse eid="ISA 44:28"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 44"/>
  <chapter number="45" style="c" sid="ISA 45"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 45:1"/>Ma e gima Jehova Nyasaye wachone Sairas,</para>
  <para style="q2" vid="ISA 45:1">ngʼate moseyiero niya,</para>
  <para style="q2" vid="ISA 45:1">“Asemako lweti ma korachwich,</para>
  <para style="q1" vid="ISA 45:1">mondo ilo ogendini manie nyimi,</para>
  <para style="q2" vid="ISA 45:1">kendo iketh teko mag ruodhi gigegi mag lweny,</para>
  <para style="q2" vid="ISA 45:1">mondo iyaw dhoudi e nyime maonge dhorangeye mibiro lor.<verse eid="ISA 45:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 45:2"/>Abiro telo e nyimi</para>
  <para style="q2" vid="ISA 45:2">kendo abiro pieyo gode madongo mogangore;</para>
  <para style="q1" vid="ISA 45:2">anamuk dhorangeye mag nyinyo</para>
  <para style="q2" vid="ISA 45:2">kendo anangʼad ndigni mag dhorangeye mag chuma.<verse eid="ISA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 45:3"/>Anamiyi mwandu mopandi e mudho,</para>
  <para style="q2" vid="ISA 45:3">mwandu mokan kuonde mopondo,</para>
  <para style="q1" vid="ISA 45:3">mondo omi ingʼe ni An e Jehova Nyasaye ma Nyasach Israel,</para>
  <para style="q2" vid="ISA 45:3">maluongi gi nyingi.<verse eid="ISA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 45:4"/>Nikech Jakobo jatichna, kendo nikech Israel mayiero,</para>
  <para style="q2" vid="ISA 45:4">aseluongi gi nyingi kendo aseketo kuomi nonro mar luor,</para>
  <para style="q1" vid="ISA 45:4">kata obedo ni ok iseyanga kamano.<verse eid="ISA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 45:5"/>An e Jehova Nyasaye, kendo moro onge;</para>
  <para style="q1" vid="ISA 45:5">onge Nyasaye moro makmana an.</para>
  <para style="q2" vid="ISA 45:5">Anamiyi teko, kata obedo ni pok iyanga kamano,<verse eid="ISA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 45:6"/>mondo omi ji ongʼe ni koa wuok chiengʼ</para>
  <para style="q2" vid="ISA 45:6">nyaka podho chiengʼ, onge ngʼat moro amora makmana an.</para>
  <para style="q2" vid="ISA 45:6">An e Jehova Nyasaye, kendo moro onge.<verse eid="ISA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 45:7"/>An ema ne achweyo ler kod mudho,</para>
  <para style="q2" vid="ISA 45:7">akelo gweth kod masira bende;</para>
  <para style="q2" vid="ISA 45:7">An, Jehova Nyasaye ema timo magi duto.<verse eid="ISA 45:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 45:8"/>“Un polo lwaruru tim makare</para>
  <para style="q2" vid="ISA 45:8">mondo ochwer kaka koth e piny.</para>
  <para style="q2" vid="ISA 45:8">Un piny yawreuru malach mondo warruok obi,</para>
  <para style="q1" vid="ISA 45:8">mondo tim makare odongi e piny,</para>
  <para style="q2" vid="ISA 45:8">an Jehova Nyasaye achweyo magi duto.<verse eid="ISA 45:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 45:9"/>“Mano kaka ngʼama piem gi Jachwechne none malit,</para>
  <para style="q2" vid="ISA 45:9">ngʼat ma en mana lowo mochwe,</para>
  <para style="q1" vid="ISA 45:9">mantiere e kind lope mamoko.</para>
  <para style="q2" vid="ISA 45:9">Bende lowo nyalo wachone jachwechne ni,</para>
  <para style="q1" vid="ISA 45:9">‘En angʼo ma iloso?’</para>
  <para style="q2" vid="ISA 45:9">Bende tich lweti nyalo wachoni ni,</para>
  <para style="q2" vid="ISA 45:9">Onge gima iloso?<verse eid="ISA 45:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 45:10"/>Inine malit in ngʼat mawachone wuon-gi ni,</para>
  <para style="q2" vid="ISA 45:10">‘Angʼo minywoloni?’</para>
  <para style="q1" vid="ISA 45:10">Kata ne min-gi ni,</para>
  <para style="q2" vid="ISA 45:10">‘En angʼo maninywoloni?’<verse eid="ISA 45:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 45:11"/>“Ma e gima Jehova Nyasaye</para>
  <para style="q2" vid="ISA 45:11">Jal Maler mar Israel, kendo Jachwechne wacho:</para>
  <para style="q1" vid="ISA 45:11">Kuom gigo mabiro timore, bende inyalo penja kuom nyithinda,</para>
  <para style="q2" vid="ISA 45:11">kata miya chik kuom tich lweta?<verse eid="ISA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 45:12"/>An ema ne achweyo piny</para>
  <para style="q2" vid="ISA 45:12">kendo ne achweyo dhano e iye.</para>
  <para style="q1" vid="ISA 45:12">Ne achweyo polo malach gi lweta awuon,</para>
  <para style="q2" vid="ISA 45:12">kendo an ema ne aketo gik moko duto manie kor polo.<verse eid="ISA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 45:13"/>Kuom ratiro mara abiro tingʼo Sairas malo kama:</para>
  <para style="q2" vid="ISA 45:13">Anami yorene duto oriere tir.</para>
  <para style="q1" vid="ISA 45:13">Enochak oger dala maduongʼ</para>
  <para style="q2" vid="ISA 45:13">kendo omi joga manoter e twech obed thuolo,</para>
  <para style="q1" vid="ISA 45:13">to ok en yor chudo kata yudo mich moro amora,</para>
  <para style="q2" vid="ISA 45:13">Jehova Nyasaye Maratego owacho.”<verse eid="ISA 45:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 45:14"/>Ma e gima Jehova Nyasaye wacho:</para>
  <para style="q1" vid="ISA 45:14">“Gik moa Misri gi gige ohala mag Kush,</para>
  <para style="q2" vid="ISA 45:14">to gi jo-Sabea ma roboche nobi iri,</para>
  <para style="q1" vid="ISA 45:14">kendo ginibed magi;</para>
  <para style="q2" vid="ISA 45:14">ginilu bangʼi ka gibiro,</para>
  <para style="q1" vid="ISA 45:14">ka moro ka moro otwe gi nyororo.</para>
  <para style="q2" vid="ISA 45:14">Ginikulre e nyimi kendo ka gisayi, kagiwacho ni,</para>
  <para style="q1" vid="ISA 45:14">‘Adiera Nyasaye ni kodi, kendo onge moro amora;</para>
  <para style="q2" vid="ISA 45:14">onge Nyasaye moro amora.’ ”<verse eid="ISA 45:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 45:15"/>Adiera in Nyasaye modak apanda,</para>
  <para style="q2" vid="ISA 45:15">yaye Nyasaye kendo Jawar mar Israel.<verse eid="ISA 45:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 45:16"/>Jogo duto maloso nyiseche manono</para>
  <para style="q2" vid="ISA 45:16">noyud wichkuot kod achaya;</para>
  <para style="q2" vid="ISA 45:16">kendo giduto gininwangʼ wichkuot.<verse eid="ISA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 45:17"/>To Israel Jehova Nyasaye noresi gi warruok manyaka chiengʼ;</para>
  <para style="q2" vid="ISA 45:17">wiwu ok nokuodi bende ok nochau nyaka chiengʼ.<verse eid="ISA 45:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 45:18"/>Nimar ma e gima Jehova Nyasaye ma</para>
  <para style="q2" vid="ISA 45:18">Nyasaye mane ochweyo polo,</para>
  <para style="q1" vid="ISA 45:18">kendo mane ochweyo piny mondo ji odagie</para>
  <para style="q2" vid="ISA 45:18">to ok ni mondo piny obed maonge ji,</para>
  <para style="q1" vid="ISA 45:18">owacho niya:</para>
  <para style="q2" vid="ISA 45:18">“An e Jehova Nyasaye kendo onge moro machielo.<verse eid="ISA 45:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 45:19"/>Ok asewuoyo kama opondo,</para>
  <para style="q2" vid="ISA 45:19">kata kama otimo mudho;</para>
  <para style="q1" vid="ISA 45:19">ok asewachone nyikwa Jakobo ni,</para>
  <para style="q2" vid="ISA 45:19">‘Manyauru kayiem nono.’</para>
  <para style="q2" vid="ISA 45:19">An, Jehova Nyasaye, awacho adiera; awacho gima kare.<verse eid="ISA 45:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 45:20"/>“Chokreuru kanyakla kendo ubi;</para>
  <para style="q2" vid="ISA 45:20">chokreuru, un joma otony moa e pinje.</para>
  <para style="q1" vid="ISA 45:20">Joma ofuwo gin jogo mawuotho kotingʼo nyiseche mopa mag yien,</para>
  <para style="q2" vid="ISA 45:20">malamo nyiseche ma ok nyal resogi.<verse eid="ISA 45:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 45:21"/>Wach gima biro timore</para>
  <para style="q2" vid="ISA 45:21">kendo yange e lela mondo mi gilalre kanyakla.</para>
  <para style="q1" vid="ISA 45:21">En ngʼa mane ofwenyo wachni chon</para>
  <para style="q2" vid="ISA 45:21">kendo mane owacho chon ni obiro timore?</para>
  <para style="q1" vid="ISA 45:21">Donge ne en an, Jehova Nyasaye?</para>
  <para style="q2" vid="ISA 45:21">Kendo onge Nyasaye moro makmana an,</para>
  <para style="q1" vid="ISA 45:21">Nyasaye makare kendo ma Jawar;</para>
  <para style="q2" vid="ISA 45:21">onge moro amora makmana an.<verse eid="ISA 45:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 45:22"/>“Biuru ira un joma oa e tungʼ</para>
  <para style="q2" vid="ISA 45:22">piny gi tungʼ piny nimar unuyud resruok;</para>
  <para style="q2" vid="ISA 45:22">nimar an Nyasaye, kendo onge moro amora.<verse eid="ISA 45:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 45:23"/>Asesingora an awuon,</para>
  <para style="q2" vid="ISA 45:23">kendo dhoga osewacho gi ratiro duto wach ma ok bi kethi ni:</para>
  <para style="q1" vid="ISA 45:23">Ji duto nogo chong-gi piny e nyima;</para>
  <para style="q2" vid="ISA 45:23">kendo ngʼato ka ngʼato nosingre gi nyinga.<verse eid="ISA 45:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 45:24"/>Giniwach kuoma ni,</para>
  <para style="q1" vid="ISA 45:24">‘Kuom Jehova Nyasaye kende ema iyudoe adieri kod teko.’ ”</para>
  <para style="q2" vid="ISA 45:24">Jogo duto manopiem kode nochungʼ e nyime gi wichkuot.<verse eid="ISA 45:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 45:25"/>To kuom Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 45:25">nyikwa Israel duto noyudi ka joma nikare kendo man-gi duongʼ.<verse eid="ISA 45:25"/></para>
  <chapter eid="ISA 45"/>
  <chapter number="46" style="c" sid="ISA 46"/>
  <para style="s1">Nyiseche mag Babulon</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 46:1"/>Bel kod Nebo ma nyisechegi</para>
  <para style="q2" vid="ISA 46:1">miywayo gi farese opodho piny.</para>
  <para style="q1" vid="ISA 46:1">Nyisechegi mosebedo kitingʼo</para>
  <para style="q2" vid="ISA 46:1">atingʼa osekelo chandruok ma giolo joma otingʼogi.<verse eid="ISA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 46:2"/>Gipodho piny giduto;</para>
  <para style="q2" vid="ISA 46:2">ma ok ginyal kelo resruok ne joma lamogi,</para>
  <para style="q2" vid="ISA 46:2">ka gin giwegi otergi e twech.<verse eid="ISA 46:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 46:3"/>Winjuru wachna, yaye od Jakobo,</para>
  <para style="q2" vid="ISA 46:3">un jo-Israel duto modongʼ,</para>
  <para style="q1" vid="ISA 46:3">un duto ma aseyiero nyaka aa chakruok</para>
  <para style="q2" vid="ISA 46:3">kendo ma aserito nyaka aa e nywolu.<verse eid="ISA 46:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 46:4"/>Kata ka udoko moti ma wiu otimo lwar,</para>
  <para style="q2" vid="ISA 46:4">to pod An mana en, An ema abiro tingʼou mi aresu.<verse eid="ISA 46:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 46:5"/>To en ngʼa ma unyalo pimago</para>
  <para style="q2" vid="ISA 46:5">kata ma unyalo kwano ni rom koda?</para>
  <para style="q2" vid="ISA 46:5">Koso ere ngʼama dichal koda ma dwapimrego?<verse eid="ISA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 46:6"/>Jomoko olo dhahabu piny koa ei okepegi</para>
  <para style="q2" vid="ISA 46:6">kendo pimo fedha e ratil;</para>
  <para style="q1" vid="ISA 46:6">bangʼe gichulo jatheth,</para>
  <para style="q2" vid="ISA 46:6">mondo olesnegigo nyasaye,</para>
  <para style="q2" vid="ISA 46:6">kendo gikulore piny mi gilame.<verse eid="ISA 46:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 46:7"/>Gitingʼe malo ma gikete e gokgi;</para>
  <para style="q2" vid="ISA 46:7">eka gikete e kare monego obedie kendo kanyo ema osikoe.</para>
  <para style="q1" vid="ISA 46:7">Kama oketeno ok onyal chorore.</para>
  <para style="q2" vid="ISA 46:7">Kata bed ni ngʼato nyalo ywagorene to ok onyal dwoko;</para>
  <para style="q2" vid="ISA 46:7">bende ok onyal rese e chandruokne.<verse eid="ISA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 46:8"/>Paruru wachni, keturu e pachu</para>
  <para style="q2" vid="ISA 46:8">kendo pareuru e chunyu un joma ongʼanyo.<verse eid="ISA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 46:9"/>Paruru gik mosekadho,</para>
  <para style="q2" vid="ISA 46:9">gigo mane otimore chon,</para>
  <para style="q1" vid="ISA 46:9">An e Nyasaye kendo onge moro machielo,</para>
  <para style="q2" vid="ISA 46:9">bende An e Nyasaye kendo onge moro machalo koda.<verse eid="ISA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 46:10"/>Anyiso giko mar gimoro mana e kinde mochakore,</para>
  <para style="q2" vid="ISA 46:10">bende asebedo kahulo gik mapok otimore.</para>
  <para style="q1" vid="ISA 46:10">Awacho ni: Gima awacho nyaka timre</para>
  <para style="q2" vid="ISA 46:10">kendo abiro timo gimoro amora mahero.<verse eid="ISA 46:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 46:11"/>Koa yo wuok chiengʼ nakel winyo mager,</para>
  <para style="q2" vid="ISA 46:11">koa e piny mabor anakel ngʼato machopo dwarona.</para>
  <para style="q1" vid="ISA 46:11">Gima asewacho nyaka chop kare,</para>
  <para style="q2" vid="ISA 46:11">gima asechano ema abiro timo.<verse eid="ISA 46:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 46:12"/>Winjauru, un joma chunygi tek</para>
  <para style="q2" vid="ISA 46:12">kendo mabor gi adiera.<verse eid="ISA 46:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 46:13"/>Akelo adiera mara machiegni,</para>
  <para style="q2" vid="ISA 46:13">ok en mabor;</para>
  <para style="q2" vid="ISA 46:13">kendo warruokna ok nodeki.</para>
  <para style="q1" vid="ISA 46:13">Abiro kelo resruok ni Sayun,</para>
  <para style="q2" vid="ISA 46:13">kendo duongʼna nobed Israel.<verse eid="ISA 46:13"/></para>
  <chapter eid="ISA 46"/>
  <chapter number="47" style="c" sid="ISA 47"/>
  <para style="s1">Babulon opodho</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 47:1"/>In Nyar Babulon Mangili bed piny e buru;</para>
  <para style="q2" vid="ISA 47:1">bed piny e lowo kionge loch in nyar jo-Babulon.</para>
  <para style="q2" vid="ISA 47:1">Ok nochak oluongi ni nyako ma dende yom kendo ma jaber.<verse eid="ISA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 47:2"/>Kawuru nyiponge mondo ureg-go mogo;</para>
  <para style="q2" vid="ISA 47:2">goluru leso ma uumogo wengeu.</para>
  <para style="q2" vid="ISA 47:2">Ngʼwanuru lepu mondo ungʼadgo aore.<verse eid="ISA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 47:3"/>Dugu biro neno kendo</para>
  <para style="q2" vid="ISA 47:3">wichkuot maru nonenre e lela.</para>
  <para style="q1" vid="ISA 47:3">Abiro chulo kuor;</para>
  <para style="q2" vid="ISA 47:3">kendo onge ngʼama notony.<verse eid="ISA 47:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 47:4"/>Jareswa, Jehova Nyasaye Maratego e nyinge,</para>
  <para style="q2" vid="ISA 47:4">en e Jal Maler mar Israel.<verse eid="ISA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 47:5"/>Bed mokuyo kendo ilingʼ thi, in nyar Babulon;</para>
  <para style="q2" vid="ISA 47:5">nimar ok nochak oluong ni ruoth madhako mar pinje.<verse eid="ISA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 47:6"/>Kane iya owangʼ gi joga to ne ajwangʼogi mi</para>
  <para style="q2" vid="ISA 47:6">aweyogi ka gima ok gin ogandana awuon;</para>
  <para style="q1" vid="ISA 47:6">ne achiwogi e lweti, kendo ne ok ikechogi.</para>
  <para style="q2" vid="ISA 47:6">To bende ne iketo tingʼ mapek nyaka ne joma oti.<verse eid="ISA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 47:7"/>Ne iwacho niya,</para>
  <para style="q2" vid="ISA 47:7">Abiro dhi nyime kaka ruoth madhako nyaka chiengʼ!</para>
  <para style="q1" vid="ISA 47:7">To ne ok iparo gigi maber bende ne ok igo</para>
  <para style="q2" vid="ISA 47:7">machiemo kuom gik manyalo timore.<verse eid="ISA 47:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 47:8"/>“Koro lingʼ thi, in ngʼat moowre marach makawore</para>
  <para style="q2" vid="ISA 47:8">ni nigi ngima mamalo, kendo iwacho e chunyi iwuon ni,</para>
  <para style="q1" vid="ISA 47:8">‘An ema antie kendo onge moro ma dirom koda,</para>
  <para style="q2" vid="ISA 47:8">ok nachal gi dhako ma chwore otho kata nyithinda ok notho.’<verse eid="ISA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 47:9"/>Gik moko ariyogi nochopni,</para>
  <para style="q2" vid="ISA 47:9">e sa machwok kende e odiechiengʼ achiel:</para>
  <para style="q1" vid="ISA 47:9">nyithindi notho kendo inibed dhako ma chwore otho.</para>
  <para style="q2" vid="ISA 47:9">Masichegi duto nochopni,</para>
  <para style="q2" vid="ISA 47:9">kendo timbe ajuoke gi ris miritorigo ok nokonyi.<verse eid="ISA 47:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 47:10"/>Isegeno kuom timbeni mamono</para>
  <para style="q2" vid="ISA 47:10">kendo isewacho e chunyi ni, ‘Onge ngʼama nena.’</para>
  <para style="q1" vid="ISA 47:10">Ngʼeyoni gi riekoni osewuondi</para>
  <para style="q2" vid="ISA 47:10">kiwacho e chunyi ni,</para>
  <para style="q2" vid="ISA 47:10">‘An kenda ema antie, onge machielo.’<verse eid="ISA 47:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 47:11"/>Masira biro maki,</para>
  <para style="q2" vid="ISA 47:11">mi ok ningʼe kaka digole kuomi.</para>
  <para style="q1" vid="ISA 47:11">Adier kwongʼ nogore kuomi</para>
  <para style="q2" vid="ISA 47:11">ma ok initieki gi misango,</para>
  <para style="q1" vid="ISA 47:11">ee chandruok maduongʼ</para>
  <para style="q2" vid="ISA 47:11">ma ok inyal neno sani biro choponi.<verse eid="ISA 47:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 47:12"/>“Med dhiyo nyime gi timbegi mag jwok</para>
  <para style="q2" vid="ISA 47:12">kod timbegi mangʼeny mag ajuoke,</para>
  <para style="q1" vid="ISA 47:12">misebedo kitimo nyaka ia e nyathi;</para>
  <para style="q2" vid="ISA 47:12">mondo waneane ka digikonyi kata dibwog ji.<verse eid="ISA 47:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 47:13"/>Rieko duto mosengʼadni osemana tieki!</para>
  <para style="q2" vid="ISA 47:13">Koro we jokorgigo obi,</para>
  <para style="q1" vid="ISA 47:13">jogo makoro wach dwe ka dwe karango sulwe,</para>
  <para style="q2" vid="ISA 47:13">weyane giresi e gik mabiro timoreni.<verse eid="ISA 47:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 47:14"/>Adiera gichalo mana tiangʼ,</para>
  <para style="q2" vid="ISA 47:14">mach biro wangʼogi duto.</para>
  <para style="q1" vid="ISA 47:14">Ok ginyal resore kata gin giwegi e teko mar mach.</para>
  <para style="q2" vid="ISA 47:14">Kaonge makaa kata mach minyalo hoyo.<verse eid="ISA 47:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 47:15"/>Mago duto e gik magi nyalo timoni kuom</para>
  <para style="q2" vid="ISA 47:15">gik ma isechandorine ka itiyo matek nyaka aa tin-ni.</para>
  <para style="q1" vid="ISA 47:15">Moro ka moro nokwangʼ,</para>
  <para style="q2" vid="ISA 47:15">kochiko yore owuon kendo onge ngʼama noresi.”<verse eid="ISA 47:15"/></para>
  <chapter eid="ISA 47"/>
  <chapter number="48" style="c" sid="ISA 48"/>
  <para style="s1">Jo-Israel matheko</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 48:1"/>“Winjuru ma, yaye un joka Jakobo,</para>
  <para style="q2" vid="ISA 48:1">miluongo ni jo-Israel kendo ma koth Juda,</para>
  <para style="q1" vid="ISA 48:1">un ma ukwongʼoru gi nying Jehova Nyasaye</para>
  <para style="q2" vid="ISA 48:1">kendo un muluongo nying Nyasach Israel,</para>
  <para style="q2" vid="ISA 48:1">to ok e yo madiera kata makare;<verse eid="ISA 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 48:2"/>un muluongoru ni weg dala maduongʼ</para>
  <para style="q2" vid="ISA 48:2">maler kendo moketo genogi kuom Nyasach Israel,</para>
  <para style="q2" vid="ISA 48:2">Jehova Nyasaye Maratego, e nyinge:<verse eid="ISA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 48:3"/>Ne akoro chon gik makoro osetimoregi,</para>
  <para style="q2" vid="ISA 48:3">dhoga nohulogi mi namiyo gingʼere;</para>
  <para style="q2" vid="ISA 48:3">bangʼe ne akelogi piyo magitimore.<verse eid="ISA 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 48:4"/>Nimar nangʼeyo wich tekou;</para>
  <para style="q2" vid="ISA 48:4">ka leche mag ngʼutu ochungʼ,</para>
  <para style="q2" vid="ISA 48:4">kendo pat wengeu tek ka nyinyo.<verse eid="ISA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 48:5"/>Kuom mano, ne anyisou magi duto chon,</para>
  <para style="q2" vid="ISA 48:5">kapok negitimore, to ne asewachonugi,</para>
  <para style="q1" vid="ISA 48:5">mondo omi kik uwach niya,</para>
  <para style="q2" vid="ISA 48:5">‘Nyisechena manono ema otimo magi;</para>
  <para style="q2" vid="ISA 48:5">kido mopa mara kod nyasacha mar mula ema oselerona ma?’<verse eid="ISA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 48:6"/>Isewinjo wechegi, rang-gi ane duto.</para>
  <para style="q2" vid="ISA 48:6">Donge ibiro yie kodgi?</para>
  <para style="b" vid="ISA 48:6"/>
  <para style="q1" vid="ISA 48:6">“Kochakore sani abiro nyisi gik manyien,</para>
  <para style="q2" vid="ISA 48:6">gik mopondo mapok ingʼeyo.<verse eid="ISA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 48:7"/>Gin gik mochwe sani, kendo mapok obudho;</para>
  <para style="q2" vid="ISA 48:7">bende gin gik mapok iwinjo nyaka chil kawuono.</para>
  <para style="q2" vid="ISA 48:7">Omiyo ok inyal wacho ni, ‘Ee, ne angʼeyogi.’<verse eid="ISA 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 48:8"/>Chutho ok osewinjo kata mana ngʼeyo,</para>
  <para style="q2" vid="ISA 48:8">nimar nyaka aa chon itu ne pok oyaw.</para>
  <para style="q1" vid="ISA 48:8">To bende angʼeyo ni un gi mwandu</para>
  <para style="q2" vid="ISA 48:8">kendo un oganda ma jopiem nyaka aa nywolu.<verse eid="ISA 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 48:9"/>Agengʼo mirimba nikech nyinga awuon;</para>
  <para style="q2" vid="ISA 48:9">kendo ahora mondo arit pakna,</para>
  <para style="q2" vid="ISA 48:9">mondo omi kik atieku.<verse eid="ISA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 48:10"/>Asepwodhou, to ok kaka ipwodho fedha,</para>
  <para style="q2" vid="ISA 48:10">kendo asetemou gi masira mager ka mach.<verse eid="ISA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 48:11"/>Asetimo kamano kuom rito nyinga,</para>
  <para style="q2" vid="ISA 48:11">mana kuom rito nyinga awuon, emomiyo asetimo ma.</para>
  <para style="q1" vid="ISA 48:11">Ere kaka dayie mondo nyinga oyany?</para>
  <para style="q2" vid="ISA 48:11">Ok ayie mondo duongʼ ma imiya, omi ngʼato machielo.”<verse eid="ISA 48:11"/></para>
  <para style="s1">Ogony Israel</para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 48:12"/>“Winjauru, yaye joka Jakobo in Israel ma aseluongo:</para>
  <para style="q2" vid="ISA 48:12">An e en; an ema okwongo kendo an ema ogik.<verse eid="ISA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 48:13"/>Lweta owuon ema ne oketo mise mar piny</para>
  <para style="q2" vid="ISA 48:13">kendo lweta ma korachwich ema ne oyaro polo,</para>
  <para style="q2" vid="ISA 48:13">ka aluongogi to giwuok kadiemo wangʼ.<verse eid="ISA 48:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 48:14"/>“Chokreuru un duto mondo uwinji:</para>
  <para style="q2" vid="ISA 48:14">Ere kata achiel kuom nyiseche manono mosehulo gima biro timore?</para>
  <para style="q1" vid="ISA 48:14">Oganda ma osiep Jehova Nyasaye</para>
  <para style="q2" vid="ISA 48:14">ema nokel kum mare kuom Babulon;</para>
  <para style="q1" vid="ISA 48:14">mirimbe nobed kuom jo-Babulon.<verse eid="ISA 48:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 48:15"/>An, kendo en An adier, ema asewacho kamano;</para>
  <para style="q2" vid="ISA 48:15">ee, an ema aseluonge.</para>
  <para style="q1" vid="ISA 48:15">Abiro kele,</para>
  <para style="q2" vid="ISA 48:15">kendo enobed gi loch kuom gik mochano timo.<verse eid="ISA 48:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 48:16"/>“Sud machiegni koda mondo iwinj wachni:</para>
  <para style="q1" vid="ISA 48:16">“Pok apandonu gimoro nyaka ne achak wuoyo kodu;</para>
  <para style="q2" vid="ISA 48:16">kendo e kinde mane magi timore, ne antie.”</para>
  <para style="b" vid="ISA 48:16"/>
  <para style="q1" vid="ISA 48:16">To koro Jehova Nyasaye Manyalo Gik Moko Duto oseora,</para>
  <para style="q2" vid="ISA 48:16">gi Roho mare.<verse eid="ISA 48:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 48:17"/>Ma e gima Jehova Nyasaye, ma Jaresni,</para>
  <para style="q2" vid="ISA 48:17">Ngʼat Maler mar Israel wacho:</para>
  <para style="q1" vid="ISA 48:17">“An e Jehova Nyasaye, ma Nyasachi,</para>
  <para style="q2" vid="ISA 48:17">mapuonji gima owinjore kodi kendo manyisi yo monego iluw.<verse eid="ISA 48:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 48:18"/>Ka dine bed ni irito chikena,</para>
  <para style="q2" vid="ISA 48:18">kwe mari domol mana ka aora,</para>
  <para style="q2" vid="ISA 48:18">kendo timni makare digingre mana ka apaka mar nam.<verse eid="ISA 48:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 48:19"/>Nyikwayi dine obedo mana ka kwoyo,</para>
  <para style="q2" vid="ISA 48:19">to nyithindi dobedo mangʼeny mokalo akwana;</para>
  <para style="q2" vid="ISA 48:19">nying-gi ok nongʼad oko kendo ok noruch e wangʼa.”<verse eid="ISA 48:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 48:20"/>Wuoguru Babulon,</para>
  <para style="q2" vid="ISA 48:20">ringuru ua ir jo-Babulon!</para>
  <para style="q1" vid="ISA 48:20">Landuru wachni kendo unyis</para>
  <para style="q2" vid="ISA 48:20">ji duto ka ugoyo koko gimor.</para>
  <para style="q1" vid="ISA 48:20">Landuru wachni e tungʼ piny niya,</para>
  <para style="q2" vid="ISA 48:20">“Jehova Nyasaye osereso jotichne ma joka Jakobo.”<verse eid="ISA 48:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 48:21"/>Kane otelonegi e thim, to riyo ne ok oloyogi;</para>
  <para style="q2" vid="ISA 48:21">ee, nomiyo pi owuoknegi e lwanda ka bubni kane obaro lwanda.<verse eid="ISA 48:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 48:22"/>Jehova Nyasaye owacho niya, “Jaricho to onge gi kwe.”<verse eid="ISA 48:22"/></para>
  <chapter eid="ISA 48"/>
  <chapter number="49" style="c" sid="ISA 49"/>
  <para style="s1">Jatich Jehova Nyasaye</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 49:1"/>Winjauru un joma odak e dho nembe,</para>
  <para style="q2" vid="ISA 49:1">winjuru un pinje man mabor:</para>
  <para style="q1" vid="ISA 49:1">Kane pok onywola Jehova Nyasaye ne oluonga</para>
  <para style="q2" vid="ISA 49:1">koa e nywolna ne oluongo nyinga.<verse eid="ISA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 49:2"/>Ne omiyo lewa obedo ka ligangla mabith,</para>
  <para style="q2" vid="ISA 49:2">e bwo tipo mar lwete ne opanda;</para>
  <para style="q1" vid="ISA 49:2">ne omiyo abedo ka asere moywe maler</para>
  <para style="q2" vid="ISA 49:2">kendo ne opanda e olalone.<verse eid="ISA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 49:3"/>Ne owachona niya,</para>
  <para style="q2" vid="ISA 49:3">“In e jatichna, Israel, kuomi ema abiro nyisoe duongʼ mara.”<verse eid="ISA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 49:4"/>To ne awacho ni, “Asetiyo matek kayiem nono;</para>
  <para style="q2" vid="ISA 49:4">aseketho tekra kayiem nono.</para>
  <para style="q1" vid="ISA 49:4">Kata kamano pokna ni e lwet Jehova Nyasaye</para>
  <para style="q2" vid="ISA 49:4">kendo michna Nyasacha ema nigo.”<verse eid="ISA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 49:5"/>To koro Jehova Nyasaye wacho kama;</para>
  <para style="q2" vid="ISA 49:5">jal mane ochweya e ich mondo abed jatichne,</para>
  <para style="q1" vid="ISA 49:5">mondo adwok joka Jakobo kuome</para>
  <para style="q2" vid="ISA 49:5">kendo achok jo-Israel ire,</para>
  <para style="q1" vid="ISA 49:5">nimar aseyudo duongʼ e wangʼ Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 49:5">kendo Nyasacha ema osebedo tekrena.<verse eid="ISA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 49:6"/>Owacho ni:</para>
  <para style="q1" vid="ISA 49:6">“En gima tin ahinya mondo ibed jatichna</para>
  <para style="q2" vid="ISA 49:6">kata mondo iduog dhood joka Jakobo,</para>
  <para style="q2" vid="ISA 49:6">kendo mondo iduog jo-Israel manok mane odongʼ.</para>
  <para style="q1" vid="ISA 49:6">Abiro miyo ibed ler mar ogendini,</para>
  <para style="q2" vid="ISA 49:6">mondo iter wach warruokna e tunge piny duto.”<verse eid="ISA 49:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 49:7"/>Ma e gima Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 49:7">ma Jares ji kendo Ngʼat Maler mar Israel wacho,</para>
  <para style="q1" vid="ISA 49:7">ne ngʼat mane ogendini ochayo</para>
  <para style="q2" vid="ISA 49:7">kendo ma en misumba jotend piny:</para>
  <para style="q1" vid="ISA 49:7">“Ruodhi nochungʼni malo koneni,</para>
  <para style="q2" vid="ISA 49:7">kendo jotelo koneno ma to nopodhni auma,</para>
  <para style="q1" vid="ISA 49:7">nikech Jehova Nyasaye, jal ma ja-adiera ma</para>
  <para style="q2" vid="ISA 49:7">en Ngʼat Maler mar Israel ema oseyieri.”<verse eid="ISA 49:7"/></para>
  <para style="s1">Jo-Israel oduogi</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 49:8"/>Ma e gima Jehova Nyasaye wacho,</para>
  <para style="q1" vid="ISA 49:8">“E ndalona mag kech abiro dwoko kwayoni,</para>
  <para style="q2" vid="ISA 49:8">chutho ne akonyi e odiechiengʼ mar warruok;</para>
  <para style="q1" vid="ISA 49:8">abiro riti mi ami ibed ngʼama kelo winjruok</para>
  <para style="q2" vid="ISA 49:8">e kinda gi ji mondo ires piny,</para>
  <para style="q2" vid="ISA 49:8">mi ipog ji kuonde ma yande odongʼ gunda,<verse eid="ISA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 49:9"/>kendo iwachne joma ni e twech ni, ‘Wuoguru oko,’</para>
  <para style="q2" vid="ISA 49:9">to joma ni e mudho ni, ‘Beduru thuolo!’</para>
  <para style="b" vid="ISA 49:9"/>
  <para style="q1" vid="ISA 49:9">“Gibiro chiemo e bath yo</para>
  <para style="q2" vid="ISA 49:9">kendo giniyud kuonde kwath e gode matindo.<verse eid="ISA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 49:10"/>Kech ok nokagi kata riyo ok nologi,</para>
  <para style="q2" vid="ISA 49:10">bende liet mar kama otimo ongoro,</para>
  <para style="q1" vid="ISA 49:10">kata chiengʼ marieny makech ok nomigi olo.</para>
  <para style="q2" vid="ISA 49:10">Jal ma chunye opongʼ gi kech,</para>
  <para style="q2" vid="ISA 49:10">ema notelnigi mi tergi kuonde sokni mag pi.<verse eid="ISA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 49:11"/>Abiro loko godena duto yore</para>
  <para style="q2" vid="ISA 49:11">kendo anabug yorena madongo duto maber.<verse eid="ISA 49:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 49:12"/>To ne, ginibi ka gia mabor;</para>
  <para style="q2" vid="ISA 49:12">moko kawuok yo nyandwat, moko kawuok yo yimbo,</para>
  <para style="q2" vid="ISA 49:12">moko to nowuogi e gwenge mag Aswan.”<verse eid="ISA 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 49:13"/>Go koko nikech mor, yaye polo, bed gi ilo,</para>
  <para style="q2" vid="ISA 49:13">yaye piny, weruru matek, un gode!</para>
  <para style="q1" vid="ISA 49:13">Nimar Jehova Nyasaye kweyo chuny joge</para>
  <para style="q2" vid="ISA 49:13">kendo obiro bedo gi kech ne joge machandore.<verse eid="ISA 49:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 49:14"/>To Sayun nowacho niya,</para>
  <para style="q2" vid="ISA 49:14">“Jehova Nyasaye osejwangʼa;</para>
  <para style="q1" vid="ISA 49:14">kendo Ruoth Nyasaye wiye osewil koda.”<verse eid="ISA 49:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 49:15"/>“To bende dhako wiye diwil gi nyathi modhodho</para>
  <para style="q2" vid="ISA 49:15">mi ok obedo gi kech e kothe mane onywolo.</para>
  <para style="q1" vid="ISA 49:15">Kata ka dipo ni wiye nyalo wil,</para>
  <para style="q2" vid="ISA 49:15">An to wiya ok nowil kodi.<verse eid="ISA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 49:16"/>Ne, asendiko nyingi ei lweta</para>
  <para style="q2" vid="ISA 49:16">kendo isiko ka ineno anena e wangʼa.<verse eid="ISA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 49:17"/>Yawuoti noreti kaduogo iri</para>
  <para style="q2" vid="ISA 49:17">kendo jogo manoyako gigi noringi kaduogo iri.<verse eid="ISA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 49:18"/>Tingʼ wangʼi malo kendo ingʼi koni gi koni:</para>
  <para style="q2" vid="ISA 49:18">mondo ine kaka yawuoti chokore kaduogo iri.”</para>
  <para style="q1" vid="ISA 49:18">Jehova Nyasaye wacho niya,</para>
  <para style="q2" vid="ISA 49:18">“Akwongʼora gi nyinga awuon ni nyithindi nochal</para>
  <para style="q2" vid="ISA 49:18">gi thiwni madhako rwako kata ka law maber ma miaha rwako.<verse eid="ISA 49:18"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 49:19"/>“Kata obedo ni osetieki midongʼ</para>
  <para style="q2" vid="ISA 49:19">gunda kendo pinyi odongʼ nono,</para>
  <para style="q1" vid="ISA 49:19">to koro ibiro yudo ni pinyi odoko matin ma ok oromo jogi dakie,</para>
  <para style="q2" vid="ISA 49:19">kendo jogo mane otieki biro bedo kodi mabor.<verse eid="ISA 49:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 49:20"/>Nyithindo mane inywolo ka in e chandruok</para>
  <para style="q2" vid="ISA 49:20">nowachni kiwinjo ni,</para>
  <para style="q2" vid="ISA 49:20">Kaeni tin-nwa; dwarnwa kama lach mondo wadagie.<verse eid="ISA 49:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 49:21"/>Eka inipenjri e chunyi ni,</para>
  <para style="q2" vid="ISA 49:21">‘En ngʼa mane onywolona jogi?</para>
  <para style="q1" vid="ISA 49:21">Ne an gi kuyo kendo ne an migumba,</para>
  <para style="q2" vid="ISA 49:21">ne otera e twech kendo ojwangʼa.</para>
  <para style="q2" vid="ISA 49:21">En ngʼa manopidhogi?</para>
  <para style="q1" vid="ISA 49:21">Ne adongʼ kenda,</para>
  <para style="q2" vid="ISA 49:21">to jogi to oa kure?’ ”<verse eid="ISA 49:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 49:22"/>Ma e gima Jehova Nyasaye Manyalo Gik Moko Duto wacho:</para>
  <para style="q1" vid="ISA 49:22">“Winji, abiro luongo Ogendini,</para>
  <para style="q2" vid="ISA 49:22">abiro chungo bandecha ne oganda kaka ranyisi,</para>
  <para style="q1" vid="ISA 49:22">gibiro kelo yawuoti ka gitingʼogi e badgi</para>
  <para style="q2" vid="ISA 49:22">kendo ginikel nyigi ka gitingʼogi e gokgi.<verse eid="ISA 49:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 49:23"/>Ruodhi ema nobed kaka wuoneu kendo mond ruodhi</para>
  <para style="q2" vid="ISA 49:23">ema nobed kaka mineu ma ritou.</para>
  <para style="q1" vid="ISA 49:23">Ginikulre auma e nyimu ka wengegi ngʼiyo piny;</para>
  <para style="q2" vid="ISA 49:23">kendo gininangʼ buru manie tiendu.</para>
  <para style="q1" vid="ISA 49:23">Eka unungʼe ni An e Jehova Nyasaye</para>
  <para style="q2" vid="ISA 49:23">kendo joma oketo genogi kuoma ok noyud wichkuot.”<verse eid="ISA 49:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 49:24"/>Bende dima jolweny maroteke gik ma giseyako,</para>
  <para style="q2" vid="ISA 49:24">koso dires joma otwe e lwet ngʼama kwiny?<verse eid="ISA 49:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 49:25"/>To ma e gima Jehova Nyasaye wachoni:</para>
  <para style="q1" vid="ISA 49:25">“Ee, joma otwe inyalo gol e lwet jolweny maroteke,</para>
  <para style="q2" vid="ISA 49:25">kendo ngʼama omaki inyalo gamo e lwet joma kwiny;</para>
  <para style="q1" vid="ISA 49:25">anaked gi jogo makedo kodu,</para>
  <para style="q2" vid="ISA 49:25">kendo anares nyithindu.<verse eid="ISA 49:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 49:26"/>Abiro miyo joma sandou nocham ringregi giwegi</para>
  <para style="q2" vid="ISA 49:26">mi anami gimer gi rembgi ka joma omadho kongʼo.</para>
  <para style="q1" vid="ISA 49:26">Eka koth dhano duto manie piny nongʼe</para>
  <para style="q2" vid="ISA 49:26">ni an Jehova Nyasaye e Jawarni,</para>
  <para style="q2" vid="ISA 49:26">Jaresni kendo Nyasaye Maratego mar Jakobo.”<verse eid="ISA 49:26"/></para>
  <chapter eid="ISA 49"/>
  <chapter number="50" style="c" sid="ISA 50"/>
  <para style="s1">Richo mar Israel kod bolruok mar jatich</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 50:1"/>Ma e gima Jehova Nyasaye wacho,</para>
  <para style="q1" vid="ISA 50:1">Ere baruwa mar weruok</para>
  <para style="q2" vid="ISA 50:1">manyiso nine ariembo minu?</para>
  <para style="q1" vid="ISA 50:1">Koso ngʼato nitie mane achiwene</para>
  <para style="q2" vid="ISA 50:1">mondo achulgo gope ma an-go?</para>
  <para style="q1" vid="ISA 50:1">Nousu nikech richou;</para>
  <para style="q2" vid="ISA 50:1">kendo minu noriembi nikech ketho mage.<verse eid="ISA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 50:2"/>Kane abiro iru, angʼo momiyo ne ok ayudo ngʼato?</para>
  <para style="q2" vid="ISA 50:2">Kane aluongou, ere gima omiyo ne ok ngʼato odwoka?</para>
  <para style="q1" vid="ISA 50:2">Koso uparo ni bada ne chiek ma ok nyal konyou?</para>
  <para style="q2" vid="ISA 50:2">Uparo ni aonge gi teko mar resou?</para>
  <para style="q2" vid="ISA 50:2">Wuoyona matin nomiyo nam oduono,</para>
  <para style="q1" vid="ISA 50:2">kendo ne amiyo aore obedo piny motwo mi rech manie eigi otho</para>
  <para style="q2" vid="ISA 50:2">kendo otop nikech onge mar pi.<verse eid="ISA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 50:3"/>Aloko polo doko maratengʼ</para>
  <para style="q2" vid="ISA 50:3">ti mana ka gima aume gi pien gugru.<verse eid="ISA 50:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 50:4"/>Jehova Nyasaye Manyalo Gik Moko Duto osemiyo apongʼ</para>
  <para style="q2" vid="ISA 50:4">kod puonj,</para>
  <para style="q1" vid="ISA 50:4">mondo omi angʼe wach manyalo hoyogo ngʼama ni e chandruok.</para>
  <para style="q2" vid="ISA 50:4">Ochiewa pile okinyi kokinyi,</para>
  <para style="q2" vid="ISA 50:4">kendo oyawo ita mondo abed gi winjo ka ngʼat mipuonjo.<verse eid="ISA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 50:5"/>Jehova Nyasaye Manyalo Gik Moko Duto oseyawo pacha</para>
  <para style="q2" vid="ISA 50:5">kendo ok asetamore winjo wachne;</para>
  <para style="q2" vid="ISA 50:5">bende ok asedok chien.<verse eid="ISA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 50:6"/>Ne achiwora ne joma goya,</para>
  <para style="q2" vid="ISA 50:6">ne joma pudho yie tika;</para>
  <para style="q1" vid="ISA 50:6">kendo ne ok apando</para>
  <para style="q2" vid="ISA 50:6">wangʼa ne joma nyiera kendo ngʼulo kuoma olawo.<verse eid="ISA 50:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 50:7"/>Nikech Jehova Nyasaye Manyalo Gik Moko Duto konya,</para>
  <para style="q2" vid="ISA 50:7">ok anayud wichkuot.</para>
  <para style="q1" vid="ISA 50:7">Kuom mano,</para>
  <para style="q2" vid="ISA 50:7">asechomo wangʼa tir kuome maonge luoro</para>
  <para style="q2" vid="ISA 50:7">kendo angʼeyo maber ni ok nayud achaya.<verse eid="ISA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 50:8"/>Jal mabiro ngʼadona bura ni koda.</para>
  <para style="q2" vid="ISA 50:8">Kare koro en ngʼa manyalo donjona?</para>
  <para style="q2" vid="ISA 50:8">Owuogane oko koro!</para>
  <para style="q1" vid="ISA 50:8">En ngʼa modonjona?</para>
  <para style="q2" vid="ISA 50:8">Owuogane okwera.<verse eid="ISA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 50:9"/>En mana Jehova Nyasaye Manyalo Gik Moko Duto ema konya.</para>
  <para style="q2" vid="ISA 50:9">En ngʼa mabiro ngʼadona bura?</para>
  <para style="q2" vid="ISA 50:9">Gibiro ti mana ka law, ma olwenda ochamo.<verse eid="ISA 50:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 50:10"/>En ngʼatno e dieru moluoro Jehova Nyasaye</para>
  <para style="q2" vid="ISA 50:10">kendo mako weche jatichne?</para>
  <para style="q1" vid="ISA 50:10">Weuru ngʼat mawuotho e mudho kaonge ler ogen kuom nying</para>
  <para style="q2" vid="ISA 50:10">Jehova Nyasaye kendo osud machiegni gi Nyasache.<verse eid="ISA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 50:11"/>To koro un jogo duto ma jomok mach</para>
  <para style="q2" vid="ISA 50:11">kendo moko mirni maliel,</para>
  <para style="q1" vid="ISA 50:11">dhiuru mondo uwuothi e ler mar mach mumoko</para>
  <para style="q2" vid="ISA 50:11">kata e ligek mach musemoko.</para>
  <para style="q1" vid="ISA 50:11">Ma e gima udhi yudo e lweta:</para>
  <para style="q2" vid="ISA 50:11">Ubiro rieru piny gi rem malit.<verse eid="ISA 50:11"/></para>
  <chapter eid="ISA 50"/>
  <chapter number="51" style="c" sid="ISA 51"/>
  <para style="s1">Resruok manyaka chiengʼ ne dala Sayun</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 51:1"/>Winjauru, un mumanyo tim makare</para>
  <para style="q2" vid="ISA 51:1">kendo udwaro Jehova Nyasaye:</para>
  <para style="q1" vid="ISA 51:1">Ngʼi aneuru lwanda mane ogolue,</para>
  <para style="q2" vid="ISA 51:1">ranganeuru kama ne okuny mogolue;<verse eid="ISA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 51:2"/>paruru Ibrahim wuonu</para>
  <para style="q2" vid="ISA 51:2">kod Sara mane onywolou.</para>
  <para style="q1" vid="ISA 51:2">Ne en mana ngʼat achiel kende kane aluonge</para>
  <para style="q2" vid="ISA 51:2">kendo nagwedhe mi aloke oganda maduongʼ.<verse eid="ISA 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 51:3"/>Jehova Nyasaye biro hoyo chuny Sayun adier;</para>
  <para style="q2" vid="ISA 51:3">kendo obiro bedo gi kech kuom kuondene mokethore;</para>
  <para style="q1" vid="ISA 51:3">enolok kuondene motimo ongoro chal ka Eden,</para>
  <para style="q2" vid="ISA 51:3">kendo kuondene modongʼ gunda chal ka puoth Jehova Nyasaye.</para>
  <para style="q1" vid="ISA 51:3">Mor gi ilo kaachiel gi erokamano</para>
  <para style="q2" vid="ISA 51:3">gi wer mamit noyud kuome.<verse eid="ISA 51:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 51:4"/>Winjauru un joga, chikuru itu un ogandana:</para>
  <para style="q2" vid="ISA 51:4">Abiro golo chik kendo bucha makare nobed ler ne ogendini.<verse eid="ISA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 51:5"/>Adiera mara sudo machiegni piyo,</para>
  <para style="q2" vid="ISA 51:5">warruokna chiegni,</para>
  <para style="q2" vid="ISA 51:5">kendo abiro ngʼado bura makare ne ogendini.</para>
  <para style="q1" vid="ISA 51:5">Joma odak e dho nembe biro ngʼiya</para>
  <para style="q2" vid="ISA 51:5">ka gin gi geno ni abiro resogi gi tekona.<verse eid="ISA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 51:6"/>Tingʼ wangʼi malo ingʼi polo,</para>
  <para style="q2" vid="ISA 51:6">bende rang piny gie polo,</para>
  <para style="q2" vid="ISA 51:6">nikech polo nolal nono mana ka iro,</para>
  <para style="q1" vid="ISA 51:6">to piny bende biro ti mana ka law</para>
  <para style="q2" vid="ISA 51:6">kendo oganda modak e iye notho mana ka lwangʼni.</para>
  <para style="q1" vid="ISA 51:6">To resruok makelo nosiki nyaka chiengʼ</para>
  <para style="q2" vid="ISA 51:6">kendo adiera mara ok norum.<verse eid="ISA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 51:7"/>Winjauru un joma ongʼeyo tim makare,</para>
  <para style="q2" vid="ISA 51:7">un oganda mondiko chikena e chunyu:</para>
  <para style="q2" vid="ISA 51:7">Kik uluor weche midiro mag dhano kata luoro ayany mag ji.<verse eid="ISA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 51:8"/>Nimar olwenda biro chamogi duto ka law;</para>
  <para style="q2" vid="ISA 51:8">kendo kudni nochamgi mana ka yie rombe.</para>
  <para style="q1" vid="ISA 51:8">To adiera mara nosiki manyaka chiengʼ,</para>
  <para style="q2" vid="ISA 51:8">kendo resruok makelo ok norum e kind tienge gi tienge.<verse eid="ISA 51:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 51:9"/>Aa malo, Aa malo! Jiw badi motegno,</para>
  <para style="q2" vid="ISA 51:9">yaye Jehova Nyasaye;</para>
  <para style="q1" vid="ISA 51:9">aa malo kendo ijiwri,</para>
  <para style="q2" vid="ISA 51:9">mana kaka ne ijiwori chon e ndalo mokadho.</para>
  <para style="q1" vid="ISA 51:9">Donge in ema nitieko ondiek nam miluongo ni Rahab,</para>
  <para style="q2" vid="ISA 51:9">mingʼado matindo tindo?<verse eid="ISA 51:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 51:10"/>Donge in ema nomiyo nam oduono,</para>
  <para style="q2" vid="ISA 51:10">ma gin pige mano chokore kuonde matut,</para>
  <para style="q1" vid="ISA 51:10">kendo niloso yo e kind nam matut</para>
  <para style="q2" vid="ISA 51:10">mondo joma ne ireso ongʼadi kadhi loka cha?<verse eid="ISA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 51:11"/>Joma Jehova Nyasaye osereso nodwogi.</para>
  <para style="q2" vid="ISA 51:11">Ginidonji e dala Sayun ka giwer;</para>
  <para style="q2" vid="ISA 51:11">mor mochwere nobed kuomgi.</para>
  <para style="q1" vid="ISA 51:11">Ginibed gi mor kod ilo,</para>
  <para style="q2" vid="ISA 51:11">kendo kuyo gi parruok nolal nono kuomgi.<verse eid="ISA 51:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 51:12"/>“An, kendo en An e Jal mahoyo chunyu.</para>
  <para style="q2" vid="ISA 51:12">Angʼo momiyo uluoro yawuot dhano adhana matho,</para>
  <para style="q2" vid="ISA 51:12">kendo maner mana ka lum,<verse eid="ISA 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 51:13"/>momiyo wiwu owil gi Jehova Nyasaye ma Jachwechu,</para>
  <para style="q2" vid="ISA 51:13">Jal mane oyaro polo kendo oketo mise mar piny,</para>
  <para style="q1" vid="ISA 51:13">momiyo udak gi kihondko pile,</para>
  <para style="q2" vid="ISA 51:13">nikech kum muyudo kuom ngʼama sandou,</para>
  <para style="q1" vid="ISA 51:13">kendo oikore mar tiekou.</para>
  <para style="q1" vid="ISA 51:13">Jal masandouno, ere gima geroneno ditim?<verse eid="ISA 51:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 51:14"/>Joma ni e twech ma luoro omako ibiro gony machiegni;</para>
  <para style="q1" vid="ISA 51:14">ok ginitho e kuondegi mag twech</para>
  <para style="q2" vid="ISA 51:14">kendo ok ginichand chiemo.<verse eid="ISA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 51:15"/>Nimar an Jehova Nyasaye ma Nyasachi mamiyo</para>
  <para style="q2" vid="ISA 51:15">Nam gingore mi apaka wuo, Jehova Nyasaye Maratego e nyinge.<verse eid="ISA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 51:16"/>Aseketo wechena e dhogi</para>
  <para style="q2" vid="ISA 51:16">kendo aumi gi tipo mar lweta,</para>
  <para style="q2" vid="ISA 51:16">an ema ne ayaro polo maketo kare,</para>
  <para style="q1" vid="ISA 51:16">mi aketo mise mar piny</para>
  <para style="q2" vid="ISA 51:16">kendo awachone jo-Sayun ni, ‘Un e joga.’ ”<verse eid="ISA 51:16"/></para>
  <para style="s1">Kikombe motingʼo mirima mager mar Jehova Nyasaye</para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 51:17"/>Aa malo, Aa malo!</para>
  <para style="q2" vid="ISA 51:17">Chiew, yaye Jerusalem,</para>
  <para style="q1" vid="ISA 51:17">in misemetho e kikombe mar mirima mager,</para>
  <para style="q2" vid="ISA 51:17">moa e lwet Jehova Nyasaye,</para>
  <para style="q1" vid="ISA 51:17">kendo isemadho kikombe mamero ji</para>
  <para style="q2" vid="ISA 51:17">milungʼo nyaka duro.<verse eid="ISA 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 51:18"/>Kuom yawuowi duto mane onywolo onge moro amora mane nyalo</para>
  <para style="q2" vid="ISA 51:18">taye kata mane nyalo telone komako lwete.<verse eid="ISA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 51:19"/>Masiche moluwore osemaki ma en kethruok kod tieki;</para>
  <para style="q2" vid="ISA 51:19">kech kod ligangla, en ngʼa madihoyi kata duogo chunyi.<verse eid="ISA 51:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 51:20"/>Yawuoti osepodho,</para>
  <para style="q2" vid="ISA 51:20">giriere piny e yore mana ka mwanda mogengʼne ei obadho.</para>
  <para style="q1" vid="ISA 51:20">Giyudo kum mager moa kuom Jehova Nyasaye</para>
  <para style="q2" vid="ISA 51:20">kendo chwat mar Nyasache.<verse eid="ISA 51:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 51:21"/>Kuom mano winj ma,</para>
  <para style="q2" vid="ISA 51:21">in miseyudo masira midoko ngʼama omer to ok gi kongʼo.<verse eid="ISA 51:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 51:22"/>Ma e gima Jehova Nyasaye ma Nyasachi Manyalo Gik Moko Duto,</para>
  <para style="q2" vid="ISA 51:22">ma en Nyasachi machwako joge e bura wacho,</para>
  <para style="q1" vid="ISA 51:22">Ne, asegolo oko e lweti kikombe mane miyo ithembo,</para>
  <para style="q2" vid="ISA 51:22">bende ok inichak imethi e kikombe mar mirimba kendo.<verse eid="ISA 51:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 51:23"/>Anaket kikombe e lwet joma sandou mane wacho ni,</para>
  <para style="q2" vid="ISA 51:23">“Nind piny mondo wawuoth kuomi.</para>
  <para style="q2" vid="ISA 51:23">Kendo niloko die ngʼeyi ka yo miwuothoe.”<verse eid="ISA 51:23"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 51"/>
  <chapter number="52" style="c" sid="ISA 52"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 52:1"/>Aa malo, Aa malo, yaye Sayun,</para>
  <para style="q2" vid="ISA 52:1">jiw badi motegno!</para>
  <para style="q1" vid="ISA 52:1">Rwak lepi mabeyo,</para>
  <para style="q2" vid="ISA 52:1">yaye Jerusalem dala maduongʼ maler.</para>
  <para style="q1" vid="ISA 52:1">Nimar joma ok oter nyangu kendo mogak,</para>
  <para style="q2" vid="ISA 52:1">ok nochak odonji e Jerusalem kendo.<verse eid="ISA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 52:2"/>Tengʼ buru momaki oko;</para>
  <para style="q2" vid="ISA 52:2">aa malo kendo ibed piny e kom duongʼ, yaye Jerusalem.</para>
  <para style="q1" vid="ISA 52:2">Gony nyoroche motwe ngʼuti,</para>
  <para style="q2" vid="ISA 52:2">yaye in Nyar Sayun manie twech.<verse eid="ISA 52:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 52:3"/>Nimar ma e gima Jehova Nyasaye wacho:</para>
  <para style="q1" vid="ISA 52:3">“Nongʼiewi maonge chudo moro,</para>
  <para style="q2" vid="ISA 52:3">omiyo ibiro wari ma ok ochulie pesa.”<verse eid="ISA 52:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 52:4"/>Ma e gima Jehova Nyasaye Manyalo Gik Moko Duto wacho:</para>
  <para style="q1" vid="ISA 52:4">“Mokwongo joga nodhi Misri mondo odagie,</para>
  <para style="q2" vid="ISA 52:4">bangʼe jo-Asuria nosandogi.<verse eid="ISA 52:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 52:5"/>“To koro en angʼo manenoni?</para>
  <para style="q1" vid="ISA 52:5">“Joga okaw nono maonge gima ochul</para>
  <para style="q1" vid="ISA 52:5">kendo joma tiyogi koro goyonegi siboi,”</para>
  <para style="q2" vid="ISA 52:5">Jehova Nyasaye owacho.</para>
  <para style="q1" vid="ISA 52:5">“Kendo kinde duto giyanyo nyinga.<verse eid="ISA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 52:6"/>Kuom mano joga biro ngʼeyo nyinga;</para>
  <para style="q2" vid="ISA 52:6">kendo odiechiengno giningʼe maber ni an,</para>
  <para style="q1" vid="ISA 52:6">ema ne asewacho wechegi chon.</para>
  <para style="q2" vid="ISA 52:6">Adier, en An.”<verse eid="ISA 52:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 52:7"/>Mano kaka en gima ber neno tiend joote maringo ewi gode</para>
  <para style="q2" vid="ISA 52:7">kakelo wach maber, mar kwe, mar resruok,</para>
  <para style="q2" vid="ISA 52:7">kod mar warruok kagiwachone Sayun niya, “Nyasachu olocho!”<verse eid="ISA 52:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 52:8"/>Winjuru! Jorito mau mondo okog matek;</para>
  <para style="q2" vid="ISA 52:8">giduto gikok nikech gimor.</para>
  <para style="q1" vid="ISA 52:8">Ka Jehova Nyasaye noduog Sayun,</para>
  <para style="q2" vid="ISA 52:8">to ginine lochne ayanga.<verse eid="ISA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 52:9"/>Weruru matek gimor un duto,</para>
  <para style="q2" vid="ISA 52:9">un kuonde mokethore mag Jerusalem,</para>
  <para style="q1" vid="ISA 52:9">nimar Jehova Nyasaye osehoyo chuny joge,</para>
  <para style="q2" vid="ISA 52:9">osereso Jerusalem.<verse eid="ISA 52:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 52:10"/>Jehova Nyasaye biro rieyo bade maler ka ogendini duto neno,</para>
  <para style="q2" vid="ISA 52:10">kendo tungʼ piny ka piny none warruok mar Nyasachwa.<verse eid="ISA 52:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 52:11"/>Wuoguru, wuoguru, auru kanyo!</para>
  <para style="q2" vid="ISA 52:11">Kik umul gima ochido!</para>
  <para style="q1" vid="ISA 52:11">Wuoguru kuome mondo ubed maler,</para>
  <para style="q2" vid="ISA 52:11">un mutingʼo gik ler mar Jehova Nyasaye.<verse eid="ISA 52:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 52:12"/>To ok unuwuogi kurikni kata ka uringo;</para>
  <para style="q2" vid="ISA 52:12">nimar Jehova Nyasaye notel nyimu,</para>
  <para style="q2" vid="ISA 52:12">ee Nyasach Israel bende nodongʼnu chien.<verse eid="ISA 52:12"/></para>
  <para style="s1">Sandruok kod duongʼ mar jatich</para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 52:13"/>Ne, jatichna biro tiyo gi rieko;</para>
  <para style="q2" vid="ISA 52:13">enotingʼe malo moloyo kimiye duongʼ mangʼongo.<verse eid="ISA 52:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 52:14"/>Mana kaka ji mangʼeny nobwok konene,</para>
  <para style="q2" vid="ISA 52:14">kite ne olokore makoro ne ok ochal ka dhano,</para>
  <para style="q2" vid="ISA 52:14">kendo kite nokethore mopogore gi kit dhano,<verse eid="ISA 52:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 52:15"/>omiyo ogendini mangʼeny nobwogi</para>
  <para style="q2" vid="ISA 52:15">kendo ruodhi nolingʼ thi nikech en.</para>
  <para style="q1" vid="ISA 52:15">Nimar gik mane ok owachnegi, gibiro neno,</para>
  <para style="q2" vid="ISA 52:15">kendo gik mapok giwinjo, nodonjnegi.<verse eid="ISA 52:15"/></para>
  <para style="b"/>
  <chapter eid="ISA 52"/>
  <chapter number="53" style="c" sid="ISA 53"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 53:1"/>En ngʼa moseyie wach ma walando,</para>
  <para style="q2" vid="ISA 53:1">koso en ngʼa ma Jehova Nyasaye osenyiso tekone?<verse eid="ISA 53:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 53:2"/>Nodongo e nyime mana ka chuny yath mayom matwi;</para>
  <para style="q2" vid="ISA 53:2">kendo mana ka tiend yath madongo kaa e lowo motwo.</para>
  <para style="q1" vid="ISA 53:2">Ne oonge gi chia kata duongʼ moro</para>
  <para style="q2" vid="ISA 53:2">mane nyalo lombo wangʼwa kuome,</para>
  <para style="q1" vid="ISA 53:2">kendo onge gima ne nenore kuome</para>
  <para style="q2" vid="ISA 53:2">maber mane nyalo miyo wahere.<verse eid="ISA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 53:3"/>Ne ojare mokwede gi oganda,</para>
  <para style="q2" vid="ISA 53:3">en ngʼat mane neno chandruok mangʼeny,</para>
  <para style="q1" vid="ISA 53:3">kendo mosiko kawinjo rem.</para>
  <para style="q2" vid="ISA 53:3">Ji nojare kendo wan bende ne ok wamiye luor,</para>
  <para style="q2" vid="ISA 53:3">mana ka ngʼama ok dwar neno.<verse eid="ISA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 53:4"/>Adier, notingʼo sandruok-wa</para>
  <para style="q2" vid="ISA 53:4">kendo chandruokwa ema ne ture,</para>
  <para style="q1" vid="ISA 53:4">kata kamano wan to ne waparo ni kum mane oyudo,</para>
  <para style="q2" vid="ISA 53:4">sandruok kod chandruok noa kuom Nyasaye.<verse eid="ISA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 53:5"/>To kare ne ochwowe mana nikech kethowa,</para>
  <para style="q2" vid="ISA 53:5">nosande malit nikech richowa;</para>
  <para style="q1" vid="ISA 53:5">kum mane oyudo kuome ema nokelnwa kwe,</para>
  <para style="q2" vid="ISA 53:5">kendo moriemo mage ema nochangowa.<verse eid="ISA 53:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 53:6"/>Wan duto, waselal mana ka rombe,</para>
  <para style="q2" vid="ISA 53:6">ka ngʼato ochomo mana yore owuon;</para>
  <para style="q2" vid="ISA 53:6">kendo Jehova Nyasaye oseketo kuome richowa duto.<verse eid="ISA 53:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 53:7"/>Nosande kichwade malit to ne ok otingʼo dhoge;</para>
  <para style="q2" vid="ISA 53:7">notere kar thone mana ka rombo mitero kar yengʼo,</para>
  <para style="q1" vid="ISA 53:7">kendo nolingʼ ka rombo manie lwet joma ngʼado yiere,</para>
  <para style="q2" vid="ISA 53:7">omiyo en bende ne ok otingʼo dhoge.<verse eid="ISA 53:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 53:8"/>Ne oyale angʼaya kendo nongʼadne bura molal kode.</para>
  <para style="q2" vid="ISA 53:8">To en ngʼa manyalo wuoyo kuom gunde?</para>
  <para style="q1" vid="ISA 53:8">Nimar nogole e piny joma ngima,</para>
  <para style="q2" vid="ISA 53:8">kendo nolal kode nikech richo mag jowa.<verse eid="ISA 53:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 53:9"/>Ne okete e bur e kind joricho</para>
  <para style="q2" vid="ISA 53:9">kendo gi jo-mwandu e thone,</para>
  <para style="q1" vid="ISA 53:9">kata obedo ni ne ok otimo tim mahundu moro amora</para>
  <para style="q2" vid="ISA 53:9">bende miriambo nine ok owuok e dhoge.<verse eid="ISA 53:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 53:10"/>To kata kamano ne en dwaro Jehova Nyasaye</para>
  <para style="q2" vid="ISA 53:10">mondo sande malit koyudo chandruok,</para>
  <para style="q1" vid="ISA 53:10">kendo Jehova Nyasaye nochiwo ngimane mondo obed misango mar pwodhruok e ketho,</para>
  <para style="q2" vid="ISA 53:10">to enone nyikwaye kendo omedne ndalo,</para>
  <para style="q2" vid="ISA 53:10">kendo dwaro mar Nyasaye nochop kare nikech en.<verse eid="ISA 53:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 53:11"/>Bangʼ chandruokne duto enone ler mar ngima</para>
  <para style="q2" vid="ISA 53:11">kendo noyud mor e chunye;</para>
  <para style="q2" vid="ISA 53:11">kuom riekone,</para>
  <para style="q1" vid="ISA 53:11">jatichna makare nongʼad bura makare ne ji mangʼeny</para>
  <para style="q2" vid="ISA 53:11">kendo notingʼ richogi.<verse eid="ISA 53:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 53:12"/>Kuom mano abiro miye pok e kind thuondi</para>
  <para style="q2" vid="ISA 53:12">kendo enopog gik moyaki gi rateke,</para>
  <para style="q1" vid="ISA 53:12">nikech ne ochiwo ngimane nyaka tho</para>
  <para style="q2" vid="ISA 53:12">mine okwane kod joketho.</para>
  <para style="q1" vid="ISA 53:12">Nimar notingʼo richo ji mangʼeny</para>
  <para style="q2" vid="ISA 53:12">kendo nochungʼ kar joricho e nyim Nyasaye.<verse eid="ISA 53:12"/></para>
  <chapter eid="ISA 53"/>
  <chapter number="54" style="c" sid="ISA 54"/>
  <para style="s1">Duongʼ mabiro ne dala Sayun</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 54:1"/>Jehova Nyasaye owacho niya,</para>
  <para style="q2" vid="ISA 54:1">“Wer, yaye in dhako ma migumba,</para>
  <para style="q1" vid="ISA 54:1">in ma ok inywol nyithindo;</para>
  <para style="q2" vid="ISA 54:1">wer matek, ka igoyo koko gi ilo,</para>
  <para style="q1" vid="ISA 54:1">in mane muoch ok okayi;</para>
  <para style="q2" vid="ISA 54:1">nimar dhako ma migumba nobed gi nyithindo,</para>
  <para style="q2" vid="ISA 54:1">mangʼeny moloyo dhako man-gi dichwo.<verse eid="ISA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 54:2"/>Ket kar hembi obed maduongʼ,</para>
  <para style="q2" vid="ISA 54:2">yar ragengʼ mar hembi obed malach,</para>
  <para style="q2" vid="ISA 54:2">kendo kik idog chien;</para>
  <para style="q1" vid="ISA 54:2">tud tondene obed maboyo</para>
  <para style="q2" vid="ISA 54:2">bende igur loyene motegno.<verse eid="ISA 54:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 54:3"/>Nimar ibiro medori malach kichomo</para>
  <para style="q2" vid="ISA 54:3">bat korachwich kendo kidhi bat koracham;</para>
  <para style="q1" vid="ISA 54:3">ogandani noma ogendini pinjegi mi</para>
  <para style="q2" vid="ISA 54:3">dagie e mier madongo makoro owe gundini.<verse eid="ISA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 54:4"/>“Kik ibed maluor; nikech ok iniyud wichkuot.</para>
  <para style="q2" vid="ISA 54:4">Kik ibed gi luoro mar yudo wichkuot; nikech ok nojari.</para>
  <para style="q1" vid="ISA 54:4">Wiyi nowil gi wichkuot mane iyudo ka in nyako,</para>
  <para style="q2" vid="ISA 54:4">kendo ok inichak ipar chandruok mane ineno kane ibedo dhako ma chwore otho.<verse eid="ISA 54:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 54:5"/>Nimar Jachwechni e chwori,</para>
  <para style="q2" vid="ISA 54:5">Jehova Nyasaye Maratego e nyinge midendego,</para>
  <para style="q1" vid="ISA 54:5">Jal Maler mar Israel e Jaresni;</para>
  <para style="q2" vid="ISA 54:5">iluonge ni Nyasach piny ngima.<verse eid="ISA 54:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 54:6"/>Jehova Nyasaye nodwogi ire,</para>
  <para style="q2" vid="ISA 54:6">mana ka dhako manoyudo osejwangʼ,</para>
  <para style="q1" vid="ISA 54:6">kendo ma chunye nigi lit ahinya, en dhako mane</para>
  <para style="q2" vid="ISA 54:6">okend ka nyako ngili kae to bangʼe ojwangʼ,”</para>
  <para style="q2" vid="ISA 54:6">Nyasachi ema owacho mano.<verse eid="ISA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 54:7"/>“Kuom kinde manok asejwangʼi,</para>
  <para style="q2" vid="ISA 54:7">to koro abiro duogi ira gi kech mangʼeny.<verse eid="ISA 54:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 54:8"/>E kinde mane an gi mirima mangʼeny ne apandoni</para>
  <para style="q2" vid="ISA 54:8">wangʼa kuom ndalo manok,</para>
  <para style="q1" vid="ISA 54:8">to koro gi ngʼwono mochwere an-gi kech kuomi,”</para>
  <para style="q2" vid="ISA 54:8">Jehova Nyasaye ma Jaresni ema owacho.<verse eid="ISA 54:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 54:9"/>“Kuoma to ma chalona mana gi ndalo mag Nowa</para>
  <para style="q2" vid="ISA 54:9">kane akwongʼora ni pi mane oimo piny ok nochak obedie kendo.</para>
  <para style="q1" vid="ISA 54:9">Omiyo koro asekwongʼora ni</para>
  <para style="q2" vid="ISA 54:9">mirima ok nochak omaka kodu kendo,</para>
  <para style="q2" vid="ISA 54:9">bende ok anachak adhawnu.<verse eid="ISA 54:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 54:10"/>Kata ka gode biro yiengni,</para>
  <para style="q2" vid="ISA 54:10">kendo gode matindo ibiro muki,</para>
  <para style="q1" vid="ISA 54:10">to herana kuomu mosiko ok noyiengi,</para>
  <para style="q2" vid="ISA 54:10">bende singruokna mar kwe ok nogol,”</para>
  <para style="q2" vid="ISA 54:10">Jehova Nyasaye man-gi kech kuomu owacho.<verse eid="ISA 54:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 54:11"/>“Yaye dala maduongʼ misando,</para>
  <para style="q2" vid="ISA 54:11">ma ahiti oyiecho maonge ngʼama hoyo,</para>
  <para style="q1" vid="ISA 54:11">abiro geri gi kite motegno,</para>
  <para style="q2" vid="ISA 54:11">kendo miseni anager gi gik mabeyo.<verse eid="ISA 54:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 54:12"/>Anager kuondeni mag gige lweny gi rubi,</para>
  <para style="q2" vid="ISA 54:12">dhorangeyeni to naketie kite ma nengogi tek,</para>
  <para style="q2" vid="ISA 54:12">kendo ohingani naketie kite mabeyo.<verse eid="ISA 54:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 54:13"/>Nyithindi duto nopuonj gi Jehova Nyasaye</para>
  <para style="q2" vid="ISA 54:13">kendo ginibed gi kwe maduongʼ.<verse eid="ISA 54:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 54:14"/>Ibiro geri e tim makare:</para>
  <para style="q2" vid="ISA 54:14">Ok nichak ine tij achuna; kendo onge gima iniluor.</para>
  <para style="q1" vid="ISA 54:14">Bwok maduongʼ ibiro ter mabor kode;</para>
  <para style="q2" vid="ISA 54:14">kendo ok ginisud machiegni kodi.<verse eid="ISA 54:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 54:15"/>Kapo ni ngʼato omonji,</para>
  <para style="q2" vid="ISA 54:15">to ok nobed ni an ema aore;</para>
  <para style="q2" vid="ISA 54:15">to ngʼato angʼata momonji nochiwre e lweti.<verse eid="ISA 54:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 54:16"/>“To ne, an ema ne achweyo jatheth mula,</para>
  <para style="q2" vid="ISA 54:16">machwako chuma e mach,</para>
  <para style="q2" vid="ISA 54:16">kendo loso gige lweny makare ne tijno.</para>
  <para style="q1" vid="ISA 54:16">An ema asechweyo jaketh mabiro kelonegi chandruok;<verse eid="ISA 54:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="ISA 54:17"/>onge gige lweny molosi ne in mano hinyi,</para>
  <para style="q2" vid="ISA 54:17">kendo inilo buche duto modonjnie.</para>
  <para style="q1" vid="ISA 54:17">Ma e pok ma jotich Jehova Nyasaye yudo,</para>
  <para style="q2" vid="ISA 54:17">kendo ma bende e gweth ma asemiyou,”</para>
  <para style="q2" vid="ISA 54:17">Jehova Nyasaye owacho.<verse eid="ISA 54:17"/></para>
  <chapter eid="ISA 54"/>
  <chapter number="55" style="c" sid="ISA 55"/>
  <para style="s1">Luong ne joma riyo oloyo</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 55:1"/>“Biuru un duto ma riyo oloyo,</para>
  <para style="q2" vid="ISA 55:1">biuru mondo umodh pi,</para>
  <para style="q1" vid="ISA 55:1">adier biuru un ma uonge pesa,</para>
  <para style="q2" vid="ISA 55:1">mondo ungʼiew kendo uchiem!</para>
  <para style="q2" vid="ISA 55:1">Biuru ungʼiew divai gi chak nono maonge chudo.<verse eid="ISA 55:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 55:2"/>Angʼo momiyo utiyo gi pesa</para>
  <para style="q2" vid="ISA 55:2">kungʼiewo gik ma ok chiemo kendo utiyo matek gi luchi ne gima ok yiengʼu.</para>
  <para style="q1" vid="ISA 55:2">Winjuru, ee winjauru kendo ucham gima ber,</para>
  <para style="q2" vid="ISA 55:2">mi unubed gi mwandu mar chuny.<verse eid="ISA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 55:3"/>Chik iti kendo ibi ira,</para>
  <para style="q2" vid="ISA 55:3">winj gima awacho mondo chunyi obed gi kwe.</para>
  <para style="q1" vid="ISA 55:3">Abiro loso singruok mosiko kod</para>
  <para style="q2" vid="ISA 55:3">herana mar adier mane asingone Daudi.<verse eid="ISA 55:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 55:4"/>To ne, asemiyo obedo janeno e kind ogendini,</para>
  <para style="q2" vid="ISA 55:4">kendo asekete obedo jatelo mar ogendini.<verse eid="ISA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 55:5"/>Chutho iniluong pinjeruodhi</para>
  <para style="q2" vid="ISA 55:5">mane ok ingʼeyo mabi iri,</para>
  <para style="q1" vid="ISA 55:5">kendo pinjeruodhi mane ok ongʼeyi malongʼo nobi iri,</para>
  <para style="q2" vid="ISA 55:5">nikech Jehova Nyasaye ma Nyasachi,</para>
  <para style="q2" vid="ISA 55:5">Jal Maler mar Israel osewiri kod duongʼne.”<verse eid="ISA 55:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 55:6"/>Dwar Jehova Nyasaye ka pod thuolo</para>
  <para style="q2" vid="ISA 55:6">nitie minyalo yudego;</para>
  <para style="q2" vid="ISA 55:6">chutho luonge kapod en machiegni.<verse eid="ISA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 55:7"/>Ngʼama timbene achach mondo owe yorene,</para>
  <para style="q2" vid="ISA 55:7">kendo ngʼama parone opongʼ gi timbe richo mondo owe.</para>
  <para style="q1" vid="ISA 55:7">Onego oduog ir Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 55:7">kendo enobed gi ngʼwono kuome mi enowene richone.<verse eid="ISA 55:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 55:8"/>“Nimar parona ok e paroni</para>
  <para style="q2" vid="ISA 55:8">bende yorena ok e yoreni,”</para>
  <para style="q2" vid="ISA 55:8">Jehova Nyasaye owacho.<verse eid="ISA 55:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 55:9"/>“Mana kaka polo bor gi piny e kaka</para>
  <para style="q2" vid="ISA 55:9">bende yorena boyo maloyo mau,</para>
  <para style="q2" vid="ISA 55:9">kendo e kaka parona ohewo parou.<verse eid="ISA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 55:10"/>Mana kaka koth gi pe lwar koa e polo,</para>
  <para style="q2" vid="ISA 55:10">kendo ok dog nono ka ok omiyo piny ngʼich,</para>
  <para style="q1" vid="ISA 55:10">ma cham twi kendo nyag kothe ne jachwoyo,</para>
  <para style="q2" vid="ISA 55:10">kendo cham ne jachiemo,<verse eid="ISA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 55:11"/>e kaka wachna mawuok e dhoga,</para>
  <para style="q2" vid="ISA 55:11">ok noduogna nono ka ok otiyo tije,</para>
  <para style="q1" vid="ISA 55:11">to nyaka ochop dwarona,</para>
  <para style="q2" vid="ISA 55:11">kendo otiek tijno mane omiyo aore.<verse eid="ISA 55:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 55:12"/>Unuwuog kuno gi mor</para>
  <para style="q2" vid="ISA 55:12">kendo notelnu gi kwe,</para>
  <para style="q1" vid="ISA 55:12">gode madongo gi matindo nower matek e nyime</para>
  <para style="q2" vid="ISA 55:12">kendo yiende duto manie bungu nopam gi ilo.<verse eid="ISA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 55:13"/>Kuonde ma yande pedo ema nitie,</para>
  <para style="q2" vid="ISA 55:13">nonyag olemo mabeyo mag yiend obudo,</para>
  <para style="q1" vid="ISA 55:13">kendo kar kudho ema ochwoga mamit nodongie.</para>
  <para style="q2" vid="ISA 55:13">Mano nomi Jehova Nyasaye huma maduongʼ,</para>
  <para style="q2" vid="ISA 55:13">to gi ranyisi manyaka chiengʼ ma ok nomuki.”<verse eid="ISA 55:13"/></para>
  <chapter eid="ISA 55"/>
  <chapter number="56" style="c" sid="ISA 56"/>
  <para style="s1">Resruok mar ogendini mamoko</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 56:1"/>Ma e gima Jehova Nyasaye wacho:</para>
  <para style="q1" vid="ISA 56:1">“Ngʼaduru bura makare</para>
  <para style="q2" vid="ISA 56:1">kendo utim gima kare,</para>
  <para style="q1" vid="ISA 56:1">nikech warruokna osekayo machiegni</para>
  <para style="q2" vid="ISA 56:1">kendo timna makare chiegni fwenyore.<verse eid="ISA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 56:2"/>Ogwedh ngʼat matimo ma,</para>
  <para style="q2" vid="ISA 56:2">mangʼado bura makare kendo ngʼatno marito chiengʼ Sabato ka ok odwanye,</para>
  <para style="q2" vid="ISA 56:2">kendo ok oyie lwete mulo gik mogak.”<verse eid="ISA 56:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 56:3"/>Kik ngʼat ma japiny moro</para>
  <para style="q2" vid="ISA 56:3">moseyie kuom Jehova Nyasaye wachi ni,</para>
  <para style="q1" vid="ISA 56:3">“Jehova Nyasaye biro kweda e kind ogandane adier.”</para>
  <para style="q2" vid="ISA 56:3">Kendo ngʼato angʼata mabwoch kik wachi ni,</para>
  <para style="q2" vid="ISA 56:3">“An mana ka yien motwo.”<verse eid="ISA 56:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 56:4"/>Nimar ma e gima Jehova Nyasaye wacho:</para>
  <para style="q1" vid="ISA 56:4">“Joma bwoch, morito Sabato mara,</para>
  <para style="q2" vid="ISA 56:4">mayiero timo gima miya mor,</para>
  <para style="q2" vid="ISA 56:4">kendo morito singruokna,<verse eid="ISA 56:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 56:5"/>ei hekalu mara, anami nying-gi bedo rapar</para>
  <para style="q2" vid="ISA 56:5">moloyo bedo gi yawuowi kod nyiri;</para>
  <para style="q2" vid="ISA 56:5">bende anamigi nying ma ok norum nyaka chiengʼ.<verse eid="ISA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 56:6"/>Kendo jopinje mamoko mane oseyie kuom</para>
  <para style="q2" vid="ISA 56:6">Jehova Nyasaye katiyone kohero nyinge, kendo kalame,</para>
  <para style="q1" vid="ISA 56:6">jogo duto marito chiengʼ</para>
  <para style="q2" vid="ISA 56:6">Sabato ma ok odwanye kendo morito singruokna,<verse eid="ISA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 56:7"/>gin duto anakelgi e goda maler</para>
  <para style="q2" vid="ISA 56:7">mi anamigi mor e oda mar lamo.</para>
  <para style="q1" vid="ISA 56:7">Chiwo mag-gi mag misengini miwangʼo pep kod misengini mamoko</para>
  <para style="q2" vid="ISA 56:7">nayiego e kendona mar misango;</para>
  <para style="q2" vid="ISA 56:7">kendo oda noluongi ni od lamo mar ogendini duto.”<verse eid="ISA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 56:8"/>Jehova Nyasaye Manyalo Gik Moko</para>
  <para style="q2" vid="ISA 56:8">Duto ma en Jal ma choko jo-Israel duto,</para>
  <para style="q1" vid="ISA 56:8">mane oter e twech wacho niya,</para>
  <para style="q2" vid="ISA 56:8">“Pod abiro choko jomoko makel irgi,</para>
  <para style="q2" vid="ISA 56:8">kaweyo mago mosechoki.”<verse eid="ISA 56:8"/></para>
  <para style="s1">Nyasaye ngʼado bura ne joricho</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 56:9"/>Biuru un le manie thim,</para>
  <para style="q2" vid="ISA 56:9">biuru mondo utiek gik moko un le mag bungu duto!<verse eid="ISA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 56:10"/>Jorito mag Israel muofni,</para>
  <para style="q2" vid="ISA 56:10">giduto gionge rieko;</para>
  <para style="q1" vid="ISA 56:10">gichalo mana gi guogi mamuol,</para>
  <para style="q2" vid="ISA 56:10">ma ok nyal giyo;</para>
  <para style="q2" vid="ISA 56:10">kendo riere piny mi lek, nikech gihero nindo.<verse eid="ISA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 56:11"/>Gin guogi ma dhogi mit kendo ok giyiengʼ.</para>
  <para style="q2" vid="ISA 56:11">Gin jokwath maonge winjo;</para>
  <para style="q1" vid="ISA 56:11">giduto gibaro ka giluwo yoregi giwegi,</para>
  <para style="q2" vid="ISA 56:11">kendo moro ka moro dwaro gima kelone ohala ne en owuon.<verse eid="ISA 56:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 56:12"/>Giwacho e kindgi giwegi ni,</para>
  <para style="q2" vid="ISA 56:12">“Biuru mondo wakaw divai!</para>
  <para style="q1" vid="ISA 56:12">Wamadhuru kongʼo mi wamer!</para>
  <para style="q2" vid="ISA 56:12">Kendo kiny nochal mana gi kawuono,</para>
  <para style="q2" vid="ISA 56:12">to bende onyalo bedo maber moloyo.”<verse eid="ISA 56:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 56"/>
  <chapter number="57" style="c" sid="ISA 57"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 57:1"/>Joma kare tho, to onge ngʼama wachno chando e chunye,</para>
  <para style="q2" vid="ISA 57:1">joma ogeno kuom Nyasaye bende tho,</para>
  <para style="q1" vid="ISA 57:1">to onge ngʼama dewo</para>
  <para style="q2" vid="ISA 57:1">kendo joma kare igolo mondo kik richo yudgi.<verse eid="ISA 57:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 57:2"/>Joma timbegi ni kare yudo kwe;</para>
  <para style="q2" vid="ISA 57:2">kendo giyudo yweyo ka ginindo e liel.<verse eid="ISA 57:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 57:3"/>“To un, biuru un yawuot jojuogi,</para>
  <para style="q2" vid="ISA 57:3">ma koth terruok kod chode!<verse eid="ISA 57:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 57:4"/>En ngʼa ma ujaro? En ngʼa mutingʼorene malo</para>
  <para style="q2" vid="ISA 57:4">kendo kumilone leu?</para>
  <para style="q2" vid="ISA 57:4">Donge un koth jonjore ma jo-miriambo?<verse eid="ISA 57:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 57:5"/>Uoworu gi gombo manono ka un e tiend yiend ober</para>
  <para style="q2" vid="ISA 57:5">kod yiende mamoko motimo otiep;</para>
  <para style="q1" vid="ISA 57:5">kendo kanyo ema uwangʼoe nyithindu</para>
  <para style="q2" vid="ISA 57:5">ka misengini e holni kendo e kuonde rogo.<verse eid="ISA 57:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 57:6"/>Kar dak mar nyisecheni ni e kind hoho</para>
  <para style="q2" vid="ISA 57:6">motimo lwendni mapoth,</para>
  <para style="q1" vid="ISA 57:6">kuno ema ogandau nitie.</para>
  <para style="q2" vid="ISA 57:6">Ee, kuondego ema usechiwoe misengini miolo piny,</para>
  <para style="q2" vid="ISA 57:6">kod misengini mag cham.</para>
  <para style="q1" vid="ISA 57:6">Kaluwore gi gigi duto,</para>
  <para style="q2" vid="ISA 57:6">bende anyalo weyonu?<verse eid="ISA 57:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 57:7"/>Iseloso kitanda mari kama otingʼore gi malo;</para>
  <para style="q2" vid="ISA 57:7">kanyo ema isechiwoe misenginigi.<verse eid="ISA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 57:8"/>E tok dhoutu kod ewi sirni</para>
  <para style="q2" vid="ISA 57:8">mag dhoutu useketoe kido mar nyisecheu manono.</para>
  <para style="q1" vid="ISA 57:8">Adier useweya mabor muchalo nyiri molonyore duk</para>
  <para style="q2" vid="ISA 57:8">kendo unindo e kitanda malach ma useloso;</para>
  <para style="q1" vid="ISA 57:8">usetimo winjruok gi joma uhero kitendinigi</para>
  <para style="q2" vid="ISA 57:8">kendo ne uneno dugegi.<verse eid="ISA 57:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 57:9"/>Ne uterone ruoth Molek mo zeituni</para>
  <para style="q2" vid="ISA 57:9">kod modhi moko mangʼwe ngʼar.</para>
  <para style="q1" vid="ISA 57:9">Ne uoro jombetre mau e piny mabor;</para>
  <para style="q2" vid="ISA 57:9">to gikone ne utundo mana e tho owuon!<verse eid="ISA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 57:10"/>Kata nobedo ni timbegi mamono duto nooli kamano;</para>
  <para style="q2" vid="ISA 57:10">to ne ok inyal wacho ni, ‘Gionge tich.’</para>
  <para style="q1" vid="ISA 57:10">Nibedo gi teko</para>
  <para style="q2" vid="ISA 57:10">kendo omiyo chunyi ne ok onyosore.<verse eid="ISA 57:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 57:11"/>“En ngʼatno ma chunyu ogeno ahinya kendo uluoro,</para>
  <para style="q2" vid="ISA 57:11">momiyo usebedona jo-miriambo,</para>
  <para style="q1" vid="ISA 57:11">kendo ok usepara kata mana paro wechena e chunyu?</para>
  <para style="q2" vid="ISA 57:11">Koso en nikech uneno ni aselingʼ ahinya,</para>
  <para style="q2" vid="ISA 57:11">momiyo ok useluora?<verse eid="ISA 57:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 57:12"/>Abiro nyiso ayanga timbeu makare kod tijeu,</para>
  <para style="q2" vid="ISA 57:12">kendo ok ginikelnu konyruok.<verse eid="ISA 57:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 57:13"/>We ane nyisecheni manonogo okonyi sa ma inie chandruok!</para>
  <para style="q2" vid="ISA 57:13">Yamo mafuto biro yweyogi oko duto,</para>
  <para style="q1" vid="ISA 57:13">kata mana muya matin nono nokudhgi matergi mabor.</para>
  <para style="q2" vid="ISA 57:13">To ngʼama oloka kar pondone nokaw piny,</para>
  <para style="q2" vid="ISA 57:13">mi goda maler nobed mwandune.”<verse eid="ISA 57:13"/></para>
  <para style="s1">Hoyo chuny ngʼama oneno richone</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 57:14"/>Kendo enowach niya:</para>
  <para style="q2" vid="ISA 57:14">“Buguru yo, bugeuru kendo ulose maber!</para>
  <para style="q2" vid="ISA 57:14">Goluru gik madichwany joga e yo.”<verse eid="ISA 57:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 57:15"/>Nimar ma e gima Jal Man Malo Moloyo</para>
  <para style="q2" vid="ISA 57:15">ma en Jal modak nyaka chiengʼ,</para>
  <para style="q1" vid="ISA 57:15">ma nyinge ler wacho,</para>
  <para style="q2" vid="ISA 57:15">“Adak kama ler man malo,</para>
  <para style="q1" vid="ISA 57:15">kaachiel gi ngʼat mofwenyo richone</para>
  <para style="q2" vid="ISA 57:15">kendo man-gi chuny mobolore,</para>
  <para style="q1" vid="ISA 57:15">mondo aduog chuny ngʼat moboloreno</para>
  <para style="q2" vid="ISA 57:15">kendo ajiw chuny ngʼat mofwenyo richone.<verse eid="ISA 57:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 57:16"/>Ok anabed ka adhawo ndalo duto,</para>
  <para style="q2" vid="ISA 57:16">kata bedo gi ich wangʼ kinde duto,</para>
  <para style="q2" vid="ISA 57:16">nimar katimo kamano,</para>
  <para style="q1" vid="ISA 57:16">to chuny dhano biro nyosore e nyima,</para>
  <para style="q2" vid="ISA 57:16">ma en muya mane aketo kuom dhano.<verse eid="ISA 57:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 57:17"/>Ne akecho gi timbene mamono ma ok rum,</para>
  <para style="q2" vid="ISA 57:17">ne amiye kum, kendo apandone wangʼa ka an-gi mirima,</para>
  <para style="q1" vid="ISA 57:17">to kata kamano nomedo mana</para>
  <para style="q2" vid="ISA 57:17">dhiyo nyime gi timbene mamonogo.<verse eid="ISA 57:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 57:18"/>Aseneno yorene to kata kamano abiro change;</para>
  <para style="q2" vid="ISA 57:18">abiro nyise yo kendo aho chunye;<verse eid="ISA 57:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 57:19"/>ka achiwo wende pak e dho jo-Israel man-gi kuyo.</para>
  <para style="q2" vid="ISA 57:19">Kwe, kwe, ne jogo man machiegni kod man maboyo.</para>
  <para style="q2" vid="ISA 57:19">Kendo abiro changogi,” Jehova Nyasaye owacho.<verse eid="ISA 57:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 57:20"/>To joricho chalo gi nam moduwore,</para>
  <para style="q2" vid="ISA 57:20">ma ok nyal bedo gi kwe,</para>
  <para style="q2" vid="ISA 57:20">ma apaka mage gingore kendo kelo chwodho.<verse eid="ISA 57:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 57:21"/>Nyasacha wacho niya,</para>
  <para style="q2" vid="ISA 57:21">“Onge kwe ne joricho.”<verse eid="ISA 57:21"/></para>
  <chapter eid="ISA 57"/>
  <chapter number="58" style="c" sid="ISA 58"/>
  <para style="s1">Kit tweyo chiemo mowinjore</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 58:1"/>“Gouru koko matek, kendo kik udog chien.</para>
  <para style="q2" vid="ISA 58:1">Tingʼuru dwondi malo mana ka turumbete.</para>
  <para style="q1" vid="ISA 58:1">Nyisuru joga malongʼo ngʼanyo margi</para>
  <para style="q2" vid="ISA 58:1">kendo richo mar od joka Jakobo nyisgiuru.<verse eid="ISA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 58:2"/>Nimar pile ka pile gidwara,</para>
  <para style="q2" vid="ISA 58:2">ginenore joma nigi chuny mar ngʼeyo yorena,</para>
  <para style="q2" vid="ISA 58:2">mana ka gima gin oganda matimo gima kare,</para>
  <para style="q1" vid="ISA 58:2">kendo mapok oweyo chike Nyasachgi.</para>
  <para style="q2" vid="ISA 58:2">Gikwaya ngʼado bura makare,</para>
  <para style="q1" vid="ISA 58:2">kendo ginenore joma dwaro ni</para>
  <para style="q2" vid="ISA 58:2">Nyasaye osud machiegni kodgi.<verse eid="ISA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 58:3"/>Giwacho niya,</para>
  <para style="q2" vid="ISA 58:3">‘Angʼo momiyo wasebedo ka waweyo chiemo to ok ine?</para>
  <para style="q1" vid="ISA 58:3">Bende angʼo momiyo wasebedo ka wahore malich</para>
  <para style="q2" vid="ISA 58:3">to ok ikwan ma ka gimoro?’</para>
  <para style="b" vid="ISA 58:3"/>
  <para style="q2" vid="ISA 58:3">“To kata kamano e kindeu mar tweyo chiemo,</para>
  <para style="q1" vid="ISA 58:3">utimo mana kaka udwaro,</para>
  <para style="q2" vid="ISA 58:3">kendo ukonyoru gi jotichu e yo marach.<verse eid="ISA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 58:4"/>Tweyo chiemo maru rumo mana gi</para>
  <para style="q2" vid="ISA 58:4">dhawo kod chuny malit,</para>
  <para style="q2" vid="ISA 58:4">bende miyo ugoru e kindu uwegi.</para>
  <para style="q1" vid="ISA 58:4">Ok unyal tweyo chiemo kaka utimo e ndalogi</para>
  <para style="q2" vid="ISA 58:4">kuparo ni lemou nowinj e polo malo.<verse eid="ISA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 58:5"/>Bende ma e kit tweyo chiemo ma aseyiero,</para>
  <para style="q2" vid="ISA 58:5">ma ngʼato hore mana odiechiengʼ achiel kende?</para>
  <para style="q1" vid="ISA 58:5">Koso en mana ka ngʼama okuyo kokulo wiye ka odundu mayamo yuko</para>
  <para style="q2" vid="ISA 58:5">kata ngʼama onindo e pien gugru kotimo buru?</para>
  <para style="q1" vid="ISA 58:5">Bende mano e gima uluongo ni</para>
  <para style="q2" vid="ISA 58:5">tweyo chiemo ma en odiechiengʼ mowal ne Jehova Nyasaye.<verse eid="ISA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 58:6"/>“Donge ma e kit tweyo chiemo ma aseyiero:</para>
  <para style="q2" vid="ISA 58:6">ni ugony tonde mag timbe maricho gi mag jok,</para>
  <para style="q2" vid="ISA 58:6">mondo uwe joma otwe obed thuolo kendo utur jok duto?<verse eid="ISA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 58:7"/>Donge en ni mondo upog chiembu ne joma</para>
  <para style="q2" vid="ISA 58:7">kech kayo kendo urwak joma odhier maonge kuonde dak,</para>
  <para style="q1" vid="ISA 58:7">bende ni mondo umi joma wuotho duk lewni,</para>
  <para style="q2" vid="ISA 58:7">kendo kik upand wangʼu ne wedeu?<verse eid="ISA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 58:8"/>Kutimo mago eka ler ma un-go nonen</para>
  <para style="q2" vid="ISA 58:8">ka ler mar okinyi kendo chang maru nobi mapiyo;</para>
  <para style="q1" vid="ISA 58:8">bende timu makare notel nyimu</para>
  <para style="q2" vid="ISA 58:8">kendo teko gi duongʼ mar Jehova Nyasaye nodongʼnu chien.<verse eid="ISA 58:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 58:9"/>Omiyo iniluong Jehova Nyasaye kendo nodwoki;</para>
  <para style="q2" vid="ISA 58:9">iniywagne mondo okonyi kendo nokoni ni: Eri antie.</para>
  <para style="b" vid="ISA 58:9"/>
  <para style="q1" vid="ISA 58:9">“Ka uweyo sando ji</para>
  <para style="q2" vid="ISA 58:9">kendo uweyo achaya kod weche mag oyiem,<verse eid="ISA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 58:10"/>kendo ka utuonoru mondo ukony joma kech kayo</para>
  <para style="q2" vid="ISA 58:10">mi uchopo dwaro mar joma isando.</para>
  <para style="q1" vid="ISA 58:10">Eka ler maru norieny e mudho</para>
  <para style="q2" vid="ISA 58:10">kendo otieno maru nochal mana ka dier odiechiengʼ tir.<verse eid="ISA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 58:11"/>Jehova Nyasaye notelnu ndalo duto,</para>
  <para style="q2" vid="ISA 58:11">obiro chopo dwarou e piny motwo,</para>
  <para style="q1" vid="ISA 58:11">kendo motimo ongoro mi enomi dendu bed mojingʼ.</para>
  <para style="q2" vid="ISA 58:11">Unuchal mana ka puodho mayudo pi maber,</para>
  <para style="q2" vid="ISA 58:11">kendo ka soko ma pige ok rum.<verse eid="ISA 58:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 58:12"/>Jou ema nochak oger kuondeu mane omukore,</para>
  <para style="q2" vid="ISA 58:12">kendo gini gedi ewi mise machon mane oketi,</para>
  <para style="q1" vid="ISA 58:12">mi noluongi ni Jager Ohinga mane Omukore</para>
  <para style="q2" vid="ISA 58:12">kendo ni Jalos Yore Matindo mane ji odakie.<verse eid="ISA 58:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 58:13"/>“Ka ok uketho odiechiengʼ mar Sabato,</para>
  <para style="q2" vid="ISA 58:13">kendo utimo dwarou e odiechienga maler,</para>
  <para style="q1" vid="ISA 58:13">ka uwacho ni Sabato en chiengʼ mor,</para>
  <para style="q2" vid="ISA 58:13">kendo mowal ni Jehova Nyasaye kumiye luor,</para>
  <para style="q1" vid="ISA 58:13">ma ok utimo gik ma un ema udwaro,</para>
  <para style="q2" vid="ISA 58:13">kendo ka uweyo wecheu manono,<verse eid="ISA 58:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 58:14"/>eka unubed moil kuom Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 58:14">mi oteru ewi piny kama otingʼore,</para>
  <para style="q2" vid="ISA 58:14">bende nomiu chiemo kar mwandu mane osingore ne Jakobo kwaru.”</para>
  <para style="q1" vid="ISA 58:14">Jehova Nyasaye ema owacho.<verse eid="ISA 58:14"/></para>
  <chapter eid="ISA 58"/>
  <chapter number="59" style="c" sid="ISA 59"/>
  <para style="s1">Richo, ulo richo kod resruok</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 59:1"/>Adiera bad Jehova Nyasaye ok chiek ma ok dores joge,</para>
  <para style="q2" vid="ISA 59:1">bende ite ok odino ma ok dowinj wach.<verse eid="ISA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 59:2"/>To richou ema osepogou gi Nyasachu;</para>
  <para style="q2" vid="ISA 59:2">richou ema omiyo osepandonu wangʼe mondo kik owinju.<verse eid="ISA 59:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 59:3"/>Nimar lwetu otimo remo,</para>
  <para style="q2" vid="ISA 59:3">kendo usemulo richo.</para>
  <para style="q1" vid="ISA 59:3">Dhou osewacho miriambo</para>
  <para style="q2" vid="ISA 59:3">kendo leu osehulo gik mamono.<verse eid="ISA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 59:4"/>Onge ngʼama dwaro tim makare;</para>
  <para style="q2" vid="ISA 59:4">kata manyo bura miyalo gadiera.</para>
  <para style="q1" vid="ISA 59:4">Gigeno mana kuom weche manono kendo giwacho miriambo,</para>
  <para style="q2" vid="ISA 59:4">gimako ich mar chandruok kendo ginywolo mana richo.<verse eid="ISA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 59:5"/>Gibutno e tong thuonde,</para>
  <para style="q2" vid="ISA 59:5">kendo gichweyo mbuyi mar otiengʼ-otiengʼ.</para>
  <para style="q1" vid="ISA 59:5">Ngʼato angʼata mochamo tongʼ-gi biro tho</para>
  <para style="q2" vid="ISA 59:5">kendo kamoro oto to nyathi fu ema wuokie.<verse eid="ISA 59:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 59:6"/>Mbui margi ok nyal twangʼ-go nanga,</para>
  <para style="q2" vid="ISA 59:6">bende ok ginyal umore giwegi gi gik ma giloso.</para>
  <para style="q1" vid="ISA 59:6">Timbegi gin timbe richo;</para>
  <para style="q2" vid="ISA 59:6">kendo timbe mag mahundu ni e lwetgi.<verse eid="ISA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 59:7"/>Tiendegi reto kadhi timo richo;</para>
  <para style="q2" vid="ISA 59:7">giyot ahinya mondo gichwer remo maonge ketho.</para>
  <para style="q1" vid="ISA 59:7">Paro manie chunygi gin paro maricho</para>
  <para style="q2" vid="ISA 59:7">kendo kamoro amora ma gidhiyoe;</para>
  <para style="q2" vid="ISA 59:7">masira gi chandruok ema dongʼie.<verse eid="ISA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 59:8"/>Ok gingʼeyo yo makelo kwe,</para>
  <para style="q2" vid="ISA 59:8">onge tim makare e yoregi.</para>
  <para style="q1" vid="ISA 59:8">Giseloko yorego obedo yore mogondore ogondore,</para>
  <para style="q2" vid="ISA 59:8">kendo ngʼato angʼata mawuotho e yorego ok noyud kwe.<verse eid="ISA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 59:9"/>Omiyo ngʼado bura makare koro bor kodwa,</para>
  <para style="q2" vid="ISA 59:9">kendo tim makare ok chop irwa.</para>
  <para style="q1" vid="ISA 59:9">Wagombo ler, to mudho ema waneno;</para>
  <para style="q2" vid="ISA 59:9">kendo wadwaro mondo piny oru,</para>
  <para style="q2" vid="ISA 59:9">to mudho mandiwa ema wawuothoe.<verse eid="ISA 59:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 59:10"/>Wamulo kor udi mana ka muofni,</para>
  <para style="q2" vid="ISA 59:10">kendo wamulo kuonde ma wawuothe,</para>
  <para style="q1" vid="ISA 59:10">mana ka joma onge wengegi.</para>
  <para style="q2" vid="ISA 59:10">Wachwanyore godiechiengʼ,</para>
  <para style="q1" vid="ISA 59:10">mana ka gima en otieno</para>
  <para style="q2" vid="ISA 59:10">kendo wachalo joma otho e kind joma rateke.<verse eid="ISA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 59:11"/>Walak mana ka ondiegi</para>
  <para style="q2" vid="ISA 59:11">kendo wadengo malit mana ka akuru.</para>
  <para style="q1" vid="ISA 59:11">Wadwaro ngʼado bura makare to ok wayud kata achiel,</para>
  <para style="q2" vid="ISA 59:11">kendo wamanyo ngʼama reswa to obor kodwa.<verse eid="ISA 59:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 59:12"/>Nimar timbewa mamono opongʼo wangʼi</para>
  <para style="q2" vid="ISA 59:12">kendo richowa elore e lela.</para>
  <para style="q1" vid="ISA 59:12">Timbewa marichogo osiko kodwa</para>
  <para style="q2" vid="ISA 59:12">kendo wayie timbewa mamonogo, ma gin:<verse eid="ISA 59:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 59:13"/>ngʼanyo kendo ketho e nyim Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 59:13">loko ngʼewa ne Nyasachwa,</para>
  <para style="q1" vid="ISA 59:13">chano timo tulo kendo paro weche mag miriambo</para>
  <para style="q2" vid="ISA 59:13">ka chunywa opongʼ kod wuond.<verse eid="ISA 59:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 59:14"/>Omiyo ngʼado bura makare ogol oko</para>
  <para style="q2" vid="ISA 59:14">kendo tim makare ni mabor kodwa,</para>
  <para style="q2" vid="ISA 59:14">adiera onge e yore matindo kendo tim makare ni kuma bor.<verse eid="ISA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 59:15"/>Adiera ok nyal yudi,</para>
  <para style="q2" vid="ISA 59:15">kendo ngʼat motangʼ ne richo chuny ji ojokgo.</para>
  <para style="b" vid="ISA 59:15"/>
  <para style="q1" vid="ISA 59:15">Jehova Nyasaye norangogi kendo nokecho</para>
  <para style="q2" vid="ISA 59:15">nikech ngʼado bura makare onge kuomgi.<verse eid="ISA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 59:16"/>Ne oneno kaonge ngʼato kata achiel,</para>
  <para style="q2" vid="ISA 59:16">kendo nobwok ni onge kata ngʼato madikony;</para>
  <para style="q1" vid="ISA 59:16">omiyo bade owuon nokelone en owuon warruok</para>
  <para style="q2" vid="ISA 59:16">kendo timne makare ema norite.<verse eid="ISA 59:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 59:17"/>Norwakore tim makare ka law akor mar nyinyo,</para>
  <para style="q2" vid="ISA 59:17">kendo ne orwako warruok ka ogut lweny;</para>
  <para style="q1" vid="ISA 59:17">bende ne orwako chulo kuor ka ngʼama rwako law,</para>
  <para style="q2" vid="ISA 59:17">kendo nobolo mirima mager kuome ka law abola.<verse eid="ISA 59:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 59:18"/>Obiro chulo ngʼato ka ngʼato mana moromore gi timbene,</para>
  <para style="q1" vid="ISA 59:18">obiro kumo wasike duto gi mirima mager</para>
  <para style="q2" vid="ISA 59:18">kendo obiro kumo joma odakie dho nembe.<verse eid="ISA 59:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 59:19"/>Koa yo podho chiengʼ, ji noluor nying Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 59:19">kendo koa yo wuok chiengʼ, oganda nomiye duongʼ.</para>
  <para style="q2" vid="ISA 59:19">Nimar nobi ka pi mongingore ma much Jehova Nyasaye osekudho.<verse eid="ISA 59:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 59:20"/>Jehova Nyasaye wacho niya,</para>
  <para style="q2" vid="ISA 59:20">“Jalno makelo Resruok nobi Sayun,</para>
  <para style="q2" vid="ISA 59:20">mondo ores nyikwa Jakobo moseweyo richogi.”<verse eid="ISA 59:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 59:21"/>Jehova Nyasaye wacho niya, “Akwongʼora ni ma e singruokna kodgi. Roho mara man kuomu kod wechena ma aseketo e dhou nosik kodu chakre kawuono nyaka tiengʼ mabiro bangʼu koa kuom nyikwau kadhi nyaka kuom nyithindgi, wach ok nowuogi e dhog-gi ndalo duto nyaka chiengʼ,” Jehova Nyasaye ema owacho.<verse eid="ISA 59:21"/></para>
  <chapter eid="ISA 59"/>
  <chapter number="60" style="c" sid="ISA 60"/>
  <para style="s1">Duongʼ mar Sayun</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 60:1"/>Aa malo mondo irieny nikech lerni osechopo,</para>
  <para style="q2" vid="ISA 60:1">kendo duongʼ mar Jehova Nyasaye oserieny kuomi.<verse eid="ISA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 60:2"/>Neye mudho okwako piny,</para>
  <para style="q2" vid="ISA 60:2">kendo ogendini ni e mudho mandiwa,</para>
  <para style="q1" vid="ISA 60:2">to Jehova Nyasaye oserieny kuomi</para>
  <para style="q2" vid="ISA 60:2">kendo duongʼne osenenore kuomi.<verse eid="ISA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 60:3"/>Ogendini nobi, e lerni,</para>
  <para style="q2" vid="ISA 60:3">kendo ruodhi nobi koneno lerni mar okinyi.<verse eid="ISA 60:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 60:4"/>Tingʼ wangʼi malo kingʼiyo koni gi koni:</para>
  <para style="q2" vid="ISA 60:4">Gik moko duto ochokore kendo gibiro iri;</para>
  <para style="q1" vid="ISA 60:4">yawuoti biro koa mabor</para>
  <para style="q2" vid="ISA 60:4">kendo nyigi ikelo kotingʼ e bat.<verse eid="ISA 60:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 60:5"/>Eka inine mano mi inibed mamor</para>
  <para style="q2" vid="ISA 60:5">ka chunyi opongʼ gi ilo,</para>
  <para style="q1" vid="ISA 60:5">mwandu mogundho nokelni kokalo nam,</para>
  <para style="q2" vid="ISA 60:5">kuomi ema mwandu mag ogendini noae.<verse eid="ISA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 60:6"/>Kweth mag ngamia nopongʼ pinyi,</para>
  <para style="q2" vid="ISA 60:6">ma gin ngamia matindo moa Midian gi Efa.</para>
  <para style="q1" vid="ISA 60:6">Jogo duto moa Sheba ka gikelo dhahabu kod ubani,</para>
  <para style="q2" vid="ISA 60:6">nobi ka gipako Jehova Nyasaye gi wer.<verse eid="ISA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 60:7"/>Jamni duto mag Kedar nochokni,</para>
  <para style="q2" vid="ISA 60:7">imbe mag Nebayoth nobed mitimogo misango;</para>
  <para style="q1" vid="ISA 60:7">ginibed gigo mitimonago misango e</para>
  <para style="q2" vid="ISA 60:7">kendona mar misango,</para>
  <para style="q2" vid="ISA 60:7">mi duongʼ maler mar hekalu mara nenre.<verse eid="ISA 60:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 60:8"/>Magi to gin angʼo mafuyo ka boche polo,</para>
  <para style="q2" vid="ISA 60:8">kata ka akuche maduogo e utegi?<verse eid="ISA 60:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 60:9"/>Kuom adiera pinje manie dho nembe ngʼiya,</para>
  <para style="q2" vid="ISA 60:9">motelonegi kabiro gin yiedhi mowuok Tarshish,</para>
  <para style="q1" vid="ISA 60:9">makelo yawuotu koa mabor ka gitingʼo fedha kod dhahabu,</para>
  <para style="q2" vid="ISA 60:9">magi biro miyogo nying Jehova Nyasaye duongʼ,</para>
  <para style="q2" vid="ISA 60:9">Jal Maler mar Israel, nikech oseumi gi duongʼne.<verse eid="ISA 60:9"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 60:10"/>Jopinje mamoko nochak oger ohinga maru</para>
  <para style="q2" vid="ISA 60:10">kendo ruodhigi nobed jotichu.</para>
  <para style="q1" vid="ISA 60:10">Kata obedo nine akumogi gi mirima,</para>
  <para style="q2" vid="ISA 60:10">to kuom ngʼwonona koro abiro nyiso kechna mangʼeny.<verse eid="ISA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 60:11"/>Dhorangeyeni biro siko ka oyaw,</para>
  <para style="q2" vid="ISA 60:11">ok nochieg-gi odiechiengʼ kata otieno,</para>
  <para style="q1" vid="ISA 60:11">mondo owe thuolo ogendini okelni</para>
  <para style="q2" vid="ISA 60:11">mwandu moa e pinje ka ruodhigi otelonegi.<verse eid="ISA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 60:12"/>Nimar ogendini kata pinjeruodhi ma ok notini norum;</para>
  <para style="q2" vid="ISA 60:12">adier ibiro tiekgi chuth.<verse eid="ISA 60:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 60:13"/>Duongʼ mar Lebanon nobini,</para>
  <para style="q2" vid="ISA 60:13">yien mabeyo duto mag obudo kod saipras nokelni,</para>
  <para style="q1" vid="ISA 60:13">mondo olosgo kara maler mar lemo</para>
  <para style="q2" vid="ISA 60:13">kendo abiro miyo kar yweyo mar tienda duongʼ.<verse eid="ISA 60:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 60:14"/>Yawuot joma ne osandi nobi iri kakulore e nyimi;</para>
  <para style="q2" vid="ISA 60:14">jogo duto mane ojari biro kulore e tiendi,</para>
  <para style="q1" vid="ISA 60:14">kendo giniluongi ni Dala Maduongʼ ma en mar Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 60:14">ma en Sayun mar Jal Maler mar Israel.<verse eid="ISA 60:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 60:15"/>Kata obedo ni osejwangʼi kendo osechayi,</para>
  <para style="q2" vid="ISA 60:15">maonge ngʼama limi,</para>
  <para style="q1" vid="ISA 60:15">abiro miyo ibed dala man-gi duongʼ mosiko</para>
  <para style="q2" vid="ISA 60:15">kendo mor mar tiengʼ mabiro mangʼeny.<verse eid="ISA 60:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 60:16"/>Ibiro madho chak mag pinje mi</para>
  <para style="q2" vid="ISA 60:16">nopiri gi thuno mar joka ruoth.</para>
  <para style="q1" vid="ISA 60:16">Eka iningʼe ni An e Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 60:16">ma Jawarni, Jaresni, Nyasaye Maratego mar Jakobo.<verse eid="ISA 60:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 60:17"/>Kar mula anakelni dhahabu</para>
  <para style="q2" vid="ISA 60:17">kendo fedha kar nyinyo.</para>
  <para style="q1" vid="ISA 60:17">Kar yien anakel mula kendo nyinyo kar kite.</para>
  <para style="q2" vid="ISA 60:17">Kwe ema nobed jaritni kendo tim makare ema notelni.<verse eid="ISA 60:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 60:18"/>Timbe mahundu ok nochak owinji e pinyu,</para>
  <para style="q2" vid="ISA 60:18">tuo kata kethruok moro marach ok nochak owinji machiegni gi tongʼ magu,</para>
  <para style="q1" vid="ISA 60:18">to iniluong ohinga magi ni Warruok</para>
  <para style="q2" vid="ISA 60:18">kendo dhorangeyeni ni Pak.<verse eid="ISA 60:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 60:19"/>Wangʼ chiengʼ ok nobed lerni mar odiechiengʼ</para>
  <para style="q2" vid="ISA 60:19">kata mana ler mar dwe ok nomenyi,</para>
  <para style="q1" vid="ISA 60:19">nimar Jehova Nyasaye ema nobed ler mari</para>
  <para style="q2" vid="ISA 60:19">kendo Nyasachi ema nobed duongʼ mari.<verse eid="ISA 60:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 60:20"/>Wangʼ chiengʼ ok nochak opodhi</para>
  <para style="q2" vid="ISA 60:20">bende dwe ok nochak olal kendo;</para>
  <para style="q1" vid="ISA 60:20">Jehova Nyasaye ema nobed lerni manyaka chiengʼ</para>
  <para style="q2" vid="ISA 60:20">kendo ndalogi mag kuyo norum.<verse eid="ISA 60:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 60:21"/>Omiyo jogi duto nobed joma kare</para>
  <para style="q2" vid="ISA 60:21">kendo piny nobed margi nyaka chiengʼ.</para>
  <para style="q1" vid="ISA 60:21">Ginichal gi bad yath ma an ema</para>
  <para style="q2" vid="ISA 60:21">apidho gi lweta awuon mondo omiya duongʼ.<verse eid="ISA 60:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 60:22"/>Ngʼat matinie kuomu nolokre oganda mangʼeny,</para>
  <para style="q2" vid="ISA 60:22">kendo oganda matin nolokre piny maduongʼ man-gi teko.</para>
  <para style="q1" vid="ISA 60:22">An Jehova Nyasaye ema nami</para>
  <para style="q2" vid="ISA 60:22">gino timre piyo piyo ka kinde ochopo.<verse eid="ISA 60:22"/></para>
  <chapter eid="ISA 60"/>
  <chapter number="61" style="c" sid="ISA 61"/>
  <para style="s1">Higa mar ngʼwono mar Jehova Nyasaye</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 61:1"/>Roho mar Jehova Nyasaye Manyalo Gik Moko Duto ni kuoma,</para>
  <para style="q2" vid="ISA 61:1">nikech Jehova Nyasaye osewira,</para>
  <para style="q2" vid="ISA 61:1">mondo aland wach maber ne joma odhier.</para>
  <para style="q1" vid="ISA 61:1">Oseora mondo akwe chuny jok modakie lit,</para>
  <para style="q2" vid="ISA 61:1">kendo mondo aland ne joma otwe ni gin thuolo,</para>
  <para style="q2" vid="ISA 61:1">bende mondo ahul ne joma otwe modakie mudho ni koro osegonygi.<verse eid="ISA 61:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 61:2"/>Bende oseora mondo aland ni ma e higa mar ngʼwono mar Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 61:2">kendo chiengʼ ma Nyasachwa biro chuloe kuor,</para>
  <para style="q1" vid="ISA 61:2">kohoyo ji duto manie kuyo,<verse eid="ISA 61:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 61:3"/>abiro konyo jogo man-gi lit Sayun,</para>
  <para style="q1" vid="ISA 61:3">kendo gik mabiro miyogi e magi:</para>
  <para style="q2" vid="ISA 61:3">ketonegi maua mabeyo kar buru magi bukorego,</para>
  <para style="q1" vid="ISA 61:3">kendo mor kar lit ma gin-go,</para>
  <para style="q2" vid="ISA 61:3">kendo chiwo lewni mag pak kar chuny mool.</para>
  <para style="q1" vid="ISA 61:3">Enoluong-gi ni yiend ober mag tim makare,</para>
  <para style="q2" vid="ISA 61:3">mopidh gi Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 61:3">konyiso godo duongʼne.<verse eid="ISA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 61:4"/>Ginichak giger kuonde machon mane omukore,</para>
  <para style="q2" vid="ISA 61:4">ka gidwoko kare kuonde mane okethore,</para>
  <para style="q1" vid="ISA 61:4">kendo ginichak giger mier madongo mane</para>
  <para style="q2" vid="ISA 61:4">okethore mosebedo kojwangʼ e tiengʼ ka tiengʼ.<verse eid="ISA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 61:5"/>Jodak nobed jokwadh jambu,</para>
  <para style="q2" vid="ISA 61:5">jopinje mamoko nopurnu puotheu mag cham,</para>
  <para style="q2" vid="ISA 61:5">kod mago mag mzabibu.<verse eid="ISA 61:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 61:6"/>Kendo noluongu ni jodolo mag Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 61:6">kendo noluongu ni jotich Nyasachwa.</para>
  <para style="q1" vid="ISA 61:6">Unucham mwandu mag pinje</para>
  <para style="q2" vid="ISA 61:6">kendo unungʼaru gi sunga kuom mwandugigo.<verse eid="ISA 61:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 61:7"/>Kar yudo wichkuot to joga noyud pok nyadiriyo,</para>
  <para style="q1" vid="ISA 61:7">kendo kar yudo achaya to ginibed mamor gi pokgi;</para>
  <para style="q2" vid="ISA 61:7">kuom mano giniyud pok nyadiriyo e pinygi,</para>
  <para style="q2" vid="ISA 61:7">kendo mor mochwere nobed margi.<verse eid="ISA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 61:8"/>“Nimar an Jehova Nyasaye ahero adiera,</para>
  <para style="q2" vid="ISA 61:8">amon gi mecho kod timbe mamono.</para>
  <para style="q1" vid="ISA 61:8">Kuom adiera mara abiro miyogi pok</para>
  <para style="q2" vid="ISA 61:8">kendo anatim kodgi singruok mosiko.<verse eid="ISA 61:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 61:9"/>Nyikwagi nongʼere e kind ogendini</para>
  <para style="q2" vid="ISA 61:9">kendo nyithindgi nomi luor e kind ji.</para>
  <para style="q1" vid="ISA 61:9">Ji duto monenogi nongʼe ni gin</para>
  <para style="q2" vid="ISA 61:9">oganda ma Jehova Nyasaye ogwedho.”<verse eid="ISA 61:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 61:10"/>An-gi mor maduongʼ e nying Jehova Nyasaye;</para>
  <para style="q2" vid="ISA 61:10">chunya opongʼ gi ilo kuom Nyasacha.</para>
  <para style="q1" vid="ISA 61:10">Nimar oserwaka gi lep warruok,</para>
  <para style="q2" vid="ISA 61:10">kendo oboya gi law mar tim makare,</para>
  <para style="q1" vid="ISA 61:10">mana kaka wuon kisera boyo wiye ka jadolo,</para>
  <para style="q2" vid="ISA 61:10">kendo ka miaha morwakore gi thiwni mabeyo.<verse eid="ISA 61:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 61:11"/>Mana kaka lowo miyo cham twi,</para>
  <para style="q2" vid="ISA 61:11">kendo kaka cham mae puodho thiewo,</para>
  <para style="q1" vid="ISA 61:11">e kaka Jehova Nyasaye Manyalo Gik Moko</para>
  <para style="q2" vid="ISA 61:11">Duto nomi tim makare kod pak thiew e dier ogendini duto.<verse eid="ISA 61:11"/></para>
  <chapter eid="ISA 61"/>
  <chapter number="62" style="c" sid="ISA 62"/>
  <para style="s1">Omi Sayun nying manyien</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 62:1"/>Nikech Sayun ok analingʼ,</para>
  <para style="q2" vid="ISA 62:1">bende nikech Jerusalem ok anasik kalingʼ,</para>
  <para style="q1" vid="ISA 62:1">nyaka timne makare rieny ka yawruok mar piny,</para>
  <para style="q2" vid="ISA 62:1">kendo warruokne obed marieny ka mach makakni.<verse eid="ISA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 62:2"/>Ogendini none timni makare,</para>
  <para style="q2" vid="ISA 62:2">kendo ruodhi duto none duongʼ mari;</para>
  <para style="q1" vid="ISA 62:2">bangʼe noluongi gi nying manyien,</para>
  <para style="q2" vid="ISA 62:2">ma Jehova Nyasaye biro chaki.<verse eid="ISA 62:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 62:3"/>Inibed kondo maber e lwet Jehova Nyasaye</para>
  <para style="q2" vid="ISA 62:3">bende inibed osimb loch e lwet Nyasachi.<verse eid="ISA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 62:4"/>Ok ginichak giluongi ni Kama Ojwangʼ</para>
  <para style="q2" vid="ISA 62:4">kata chako pinyi ni kama Odongʼ Gunda.</para>
  <para style="q2" vid="ISA 62:4">To noluongi ni Hefziba kendo pinyi noluongi ni Beula;</para>
  <para style="q1" vid="ISA 62:4">nimar Jehova Nyasaye nobed kodi gi mor</para>
  <para style="q2" vid="ISA 62:4">kendo pinyi nochal gi dhako mokendi.<verse eid="ISA 62:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 62:5"/>Kaka wuowi kendo nyako e kaka yawuoti nokendi;</para>
  <para style="q2" vid="ISA 62:5">to bende kaka ngʼama okendo mor gi chiege,</para>
  <para style="q1" vid="ISA 62:5">e kaka Nyasachi nobed mamor kodi.<verse eid="ISA 62:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 62:6"/>Yaye Jerusalem, aseoro jorit e ohinga mari</para>
  <para style="q2" vid="ISA 62:6">ok ginilingʼ odiechiengʼ gotieno.</para>
  <para style="q2" vid="ISA 62:6">Un muluongo nying Jehova Nyasaye kik unyosru,<verse eid="ISA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 62:7"/>kendo kik umiye yweyo nyaka chop olos Jerusalem</para>
  <para style="q2" vid="ISA 62:7">mi omi obed dala marahuma mipako e piny ngima.<verse eid="ISA 62:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 62:8"/>Jehova Nyasaye osesingore gi lwete ma korachwich</para>
  <para style="q2" vid="ISA 62:8">kendo gi bade maratego ni,</para>
  <para style="q1" vid="ISA 62:8">“Ok nachak ayie</para>
  <para style="q2" vid="ISA 62:8">wasiku kaw chambu micham,</para>
  <para style="q1" vid="ISA 62:8">jopinje mamoko bende ok nochak omadh divai manyien,</para>
  <para style="q2" vid="ISA 62:8">ma usetiyone matek;<verse eid="ISA 62:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 62:9"/>to jogo mano kagi ema nochamgi,</para>
  <para style="q2" vid="ISA 62:9">ka gipako Jehova Nyasaye,</para>
  <para style="q1" vid="ISA 62:9">bende jogo ma choko olemb mzabibu ema nomadhgi</para>
  <para style="q2" vid="ISA 62:9">e laru mar kara maler mar lemo.”<verse eid="ISA 62:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 62:10"/>Kaluru, kaluru dhorangach!</para>
  <para style="q2" vid="ISA 62:10">Losuru yo ne joga.</para>
  <para style="q1" vid="ISA 62:10">Buguru, buguru yore!</para>
  <para style="q2" vid="ISA 62:10">Goluru kite.</para>
  <para style="q1" vid="ISA 62:10">Tingʼuru bandera malo mondo pinje one.<verse eid="ISA 62:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 62:11"/>Jehova Nyasaye oselando wachne e tung pinje duto niya:</para>
  <para style="q2" vid="ISA 62:11">“Wachne nyar Sayun ni, ‘Ne, Jaresni biro!</para>
  <para style="q1" vid="ISA 62:11">Ne, michne ni e lwete</para>
  <para style="q2" vid="ISA 62:11">kendo jogo mosegonyo wuotho kode.’ ”<verse eid="ISA 62:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 62:12"/>Enoluong-gi ni Oganda Maler,</para>
  <para style="q2" vid="ISA 62:12">ma Jehova Nyasaye Osewalo;</para>
  <para style="q1" vid="ISA 62:12">kendo noluongi ni Dala Midwaro Gwedho</para>
  <para style="q2" vid="ISA 62:12">ma en Dala Maduongʼ Ma Ok Nochak Ojwangʼ.<verse eid="ISA 62:12"/></para>
  <chapter eid="ISA 62"/>
  <chapter number="63" style="c" sid="ISA 63"/>
  <para style="s1">Odiechiengʼ ma Nyasaye chuloe kuor kendo keloe resruok</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 63:1"/>Ma en ngʼa mabiro koa Bozra dala maduongʼ</para>
  <para style="q2" vid="ISA 63:1">mar Edom korwako lewni makwar mochido?</para>
  <para style="q1" vid="ISA 63:1">Ma en ngʼa morwakore gi law duongʼ,</para>
  <para style="q2" vid="ISA 63:1">kowuotho gi sunga nikech teko ma en-go?</para>
  <para style="b" vid="ISA 63:1"/>
  <para style="q2" vid="ISA 63:1">En an Jehova Nyasaye ema awuoyo gi tim makare makelo warruok.<verse eid="ISA 63:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 63:2"/>Angʼo momiyo lepi kwar mana ka lep ngʼama</para>
  <para style="q2" vid="ISA 63:2">nyono olemb mzabibu kabiyo?<verse eid="ISA 63:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 63:3"/>Asenyono olemo mibiyo kenda;</para>
  <para style="q2" vid="ISA 63:3">kendo ngʼato angʼata moa kuom ogendini mane ni koda.</para>
  <para style="q1" vid="ISA 63:3">Ne anyonogi piny kakecho</para>
  <para style="q2" vid="ISA 63:3">kendo ka an-gi mirima mager;</para>
  <para style="q1" vid="ISA 63:3">mi rembgi okirore e lepa</para>
  <para style="q2" vid="ISA 63:3">kendo omiyo lepa duto otimo remo.<verse eid="ISA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 63:4"/>Nimar odiechieng chulo kuor ne ni e</para>
  <para style="q2" vid="ISA 63:4">chunya kendo hik warruok osechopo.<verse eid="ISA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 63:5"/>Ne angʼiyo koni gi koni to ne ok aneno</para>
  <para style="q2" vid="ISA 63:5">ngʼama konya,</para>
  <para style="q1" vid="ISA 63:5">omiyo lweta awuon ema ne ochiwo warruok;</para>
  <para style="q2" vid="ISA 63:5">kendo mirimba awuon ema ne orita.<verse eid="ISA 63:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 63:6"/>Ne anyono ogendini kakecho;</para>
  <para style="q2" vid="ISA 63:6">mi kuom mirimba ne amiyo gimer,</para>
  <para style="q2" vid="ISA 63:6">kendo ne aolo rembgi e lowo.<verse eid="ISA 63:6"/></para>
  <para style="s1">Pak kod lamo</para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 63:7"/>Abiro wuoyo kuom ngʼwono mar Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 63:7">kuom timbene madongo mowinjore gi pak,</para>
  <para style="q1" vid="ISA 63:7">kaluwore gi gik moko duto ma Jehova Nyasaye osetimonwa.</para>
  <para style="q2" vid="ISA 63:7">Ee, gik mangʼeny duto mosetimo ne oganda Israel,</para>
  <para style="q2" vid="ISA 63:7">kaluwore gi kech mare kod timbene mag ngʼwono duto.<verse eid="ISA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 63:8"/>Jehova Nyasaye nowacho niya,</para>
  <para style="q2" vid="ISA 63:8">“Kuom adiera gin joga,</para>
  <para style="q1" vid="ISA 63:8">yawuota ma ok nyal wuonda,”</para>
  <para style="q2" vid="ISA 63:8">omiyo nobedo Jaresgi.<verse eid="ISA 63:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 63:9"/>E litgi duto en bende ne en gi lit</para>
  <para style="q2" vid="ISA 63:9">kendo malaika mane ni e nyime ne oresogi.</para>
  <para style="q1" vid="ISA 63:9">Kuom herane kod ngʼwonone neresogi;</para>
  <para style="q2" vid="ISA 63:9">mi otingʼogi malo nyaka aa ndalo machon.<verse eid="ISA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 63:10"/>Kata kamano ne gingʼanyo mi gimiyo</para>
  <para style="q2" vid="ISA 63:10">Roho Maler mare okuyo.</para>
  <para style="q1" vid="ISA 63:10">Omiyo nolokore obedo jasikgi</para>
  <para style="q2" vid="ISA 63:10">kendo en owuon ne okedo kodgi.<verse eid="ISA 63:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 63:11"/>Bangʼe joge ne oparo ndalo machon,</para>
  <para style="q2" vid="ISA 63:11">ndalo mag Musa kod ogandane mi gipenjore niya,</para>
  <para style="q1" vid="ISA 63:11">“Ere Jal mane otelonegi ka jakwadh rombe ka gikalo nam makwar?</para>
  <para style="q2" vid="ISA 63:11">Ere Jal mane oketo Roho Maler mare kuomgi?<verse eid="ISA 63:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 63:12"/>Ere Jal mane ooro bade man-gi</para>
  <para style="q2" vid="ISA 63:12">teko mondo obedie lwet Musa ma korachwich,</para>
  <para style="q1" vid="ISA 63:12">mane obaro pi e nyimgi</para>
  <para style="q2" vid="ISA 63:12">mondo nyinge oyud duongʼ mochwere?<verse eid="ISA 63:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 63:13"/>Ere Jal mane otelonegi nyaka kuonde matut?”</para>
  <para style="q2" vid="ISA 63:13">Mana ka faras mangʼado thim, ne ok gichwanyore;<verse eid="ISA 63:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 63:14"/>mana kaka jamni maridore kochomo holo,</para>
  <para style="q2" vid="ISA 63:14">negiyudo yweyo koa kuom Roho mar Jehova Nyasaye.</para>
  <para style="q1" vid="ISA 63:14">Ma e kaka nitelo ne jogi</para>
  <para style="q2" vid="ISA 63:14">kimiyorigo duongʼ.<verse eid="ISA 63:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 63:15"/>Rang piny gie polo ka in e komi mar duongʼ,</para>
  <para style="q2" vid="ISA 63:15">maler kendo man-gi teko?</para>
  <para style="q1" vid="ISA 63:15">Ere hera matut gi teko misebedogo kodwa cha?</para>
  <para style="q2" vid="ISA 63:15">Ngʼwono kod hoch mari isetuonowa.<verse eid="ISA 63:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 63:16"/>To ngʼe ni inie wuonwa kata obedo ni Ibrahim</para>
  <para style="q2" vid="ISA 63:16">ok ongʼeyowa kendo Israel ok kwan ni wan joge,</para>
  <para style="q1" vid="ISA 63:16">in, yaye Jehova Nyasaye, e wuonwa,</para>
  <para style="q2" vid="ISA 63:16">Jareswa manyaka nene e nyingi.<verse eid="ISA 63:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 63:17"/>Yaye Jehova Nyasaye, angʼo momiyo wachandore e yoregi</para>
  <para style="q2" vid="ISA 63:17">kendo chunywa pek ma ok wanyal chiwo luor ne in?</para>
  <para style="q1" vid="ISA 63:17">Yie iduog irwa nikech wan jotichni,</para>
  <para style="q2" vid="ISA 63:17">oganda ma gin girkeni mari.<verse eid="ISA 63:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 63:18"/>Kuom ndalo matin kende jogi ne orito kar dakni maler,</para>
  <para style="q2" vid="ISA 63:18">to sani wasikwa osenyono moketho kari maler mar lemo.<verse eid="ISA 63:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 63:19"/>Wan magi kochakore chon to</para>
  <para style="q2" vid="ISA 63:19">ok isebedo ruodhgi,</para>
  <para style="q2" vid="ISA 63:19">to bende ok oseluong-gi gi nyingi.<verse eid="ISA 63:19"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 63"/>
  <chapter number="64" style="c" sid="ISA 64"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 64:1"/>Mad ibar polo mondo ilor piny,</para>
  <para style="q2" vid="ISA 64:1">mondo gode otetni e nyimi,<verse eid="ISA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 64:2"/>mana kaka mach wangʼo yugi kendo yienyo pi,</para>
  <para style="q2" vid="ISA 64:2">lor piny mondo wasiki ongʼe ni intie,</para>
  <para style="q2" vid="ISA 64:2">kendo imi ogendini otetni e nyimi!<verse eid="ISA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 64:3"/>Nimar kane itimo gik</para>
  <para style="q2" vid="ISA 64:3">madongo mane ok wapar,</para>
  <para style="q2" vid="ISA 64:3">ne ilor piny ma gode ne oyiengni e nyimi,<verse eid="ISA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 64:4"/>nyaka aa nene onge ngʼama osewinjo,</para>
  <para style="q2" vid="ISA 64:4">kendo onge it mosewinjo,</para>
  <para style="q1" vid="ISA 64:4">bende onge wangʼ moseneno Nyasaye moro amora ma ok in,</para>
  <para style="q2" vid="ISA 64:4">moserito joge mogeno kuome.<verse eid="ISA 64:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 64:5"/>Ikonyo joma nigi mor mar timo gik makare,</para>
  <para style="q2" vid="ISA 64:5">ma gin joma paro yoregi.</para>
  <para style="q1" vid="ISA 64:5">To kane wadhi nyime gi ketho e nyimi,</para>
  <para style="q2" vid="ISA 64:5">to iyi nowangʼ. To koro ere kaka inyalo reswa?<verse eid="ISA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 64:6"/>Waduto wasebedo ka jok mogak,</para>
  <para style="q2" vid="ISA 64:6">kendo timbewa duto mabeyo chalo mana gi lewni mochido;</para>
  <para style="q2" vid="ISA 64:6">waduto wasener mana ka it oboke,</para>
  <para style="q1" vid="ISA 64:6">kendo richowa mamono kwadhowa</para>
  <para style="q2" vid="ISA 64:6">oko mabor mana ka yamo.<verse eid="ISA 64:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 64:7"/>Onge ngʼato angʼata maluongo nyingi,</para>
  <para style="q2" vid="ISA 64:7">kata matemo mondo opadre kuomi,</para>
  <para style="q1" vid="ISA 64:7">nimar isepandonwa wangʼi kendo ijwangʼowa</para>
  <para style="q2" vid="ISA 64:7">mabor nikech richo magwa.<verse eid="ISA 64:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 64:8"/>Kata kamano, yaye Jehova Nyasaye, in e Wuonwa.</para>
  <para style="q2" vid="ISA 64:8">Wan e lop chwech, to ine jachwechwa;</para>
  <para style="q2" vid="ISA 64:8">kendo wan duto wan tich lweti.<verse eid="ISA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 64:9"/>Yaye Jehova Nyasaye, kik ibed gi mirima mokadho apima,</para>
  <para style="q2" vid="ISA 64:9">kik ipar richowa ndalo duto.</para>
  <para style="q1" vid="ISA 64:9">Yaye Jehova Nyasaye, wakwayi,</para>
  <para style="q2" vid="ISA 64:9">yie irangwa, nimar wan duto wan jogi.<verse eid="ISA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 64:10"/>Miechi madongo maler olokore thim,</para>
  <para style="q1" vid="ISA 64:10">kata mana Sayun owuon bende olokore thim,</para>
  <para style="q2" vid="ISA 64:10">kendo Jerusalem odongʼ gunda.<verse eid="ISA 64:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 64:11"/>Hekalu marwa maler, kendo man-gi duongʼ mane kwerewa opakie,</para>
  <para style="q2" vid="ISA 64:11">osewangʼ gi mach,</para>
  <para style="q2" vid="ISA 64:11">kendo mwanduwa duto osekethore.<verse eid="ISA 64:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 64:12"/>Bangʼ magi duto, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 64:12">bende pod inyalo mana jwangʼowa?</para>
  <para style="q2" vid="ISA 64:12">Adier dilingʼ thi kikumowa mokadho apima?<verse eid="ISA 64:12"/></para>
  <chapter eid="ISA 64"/>
  <chapter number="65" style="c" sid="ISA 65"/>
  <para style="s1">Kum kod resruok</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 65:1"/>“Ne afwenyora ne joma ne ok openja,</para>
  <para style="q2" vid="ISA 65:1">bende ne oyuda gi joma ne ok omanya.</para>
  <para style="q1" vid="ISA 65:1">To ne oganda mane ok luong nyinga,</para>
  <para style="q2" vid="ISA 65:1">ne awachonegi ni, ‘Eri an, eri an.’<verse eid="ISA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 65:2"/>Odiechiengʼ duto aserieyo bada</para>
  <para style="q2" vid="ISA 65:2">ne oganda ma wigi tek,</para>
  <para style="q1" vid="ISA 65:2">jogo mawuotho e yore ma ok beyo,</para>
  <para style="q2" vid="ISA 65:2">ka gitimo dwarogi giwegi,<verse eid="ISA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 65:3"/>ma gin joma osiko mana</para>
  <para style="q1" vid="ISA 65:3">ka miya mirima e wangʼa awuon,</para>
  <para style="q2" vid="ISA 65:3">ka gitimo misengini e puothe,</para>
  <para style="q1" vid="ISA 65:3">kendo giwangʼo ubani e kendo molos gi matafare;<verse eid="ISA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 65:4"/>gibet e dier liete joma otho otieno duto ka,</para>
  <para style="q2" vid="ISA 65:4">gipondo kuonde mobuto, gichamo ring anguro,</para>
  <para style="q2" vid="ISA 65:4">kendo agulnigi otingʼo chiemo moko makwero;<verse eid="ISA 65:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 65:5"/>giwacho ni ji mamoko niya,</para>
  <para style="q2" vid="ISA 65:5">‘Bed mabor koda;</para>
  <para style="q1" vid="ISA 65:5">kik isud buta,</para>
  <para style="q2" vid="ISA 65:5">nimar aler moloyi!’</para>
  <para style="q1" vid="ISA 65:5">Joma kamago gin mana iro mawuok e uma</para>
  <para style="q2" vid="ISA 65:5">kendo ka mach maliel ma ok tho odiechiengʼ duto.<verse eid="ISA 65:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 65:6"/>“To ne, wachno osiko kondiki e nyima ni:</para>
  <para style="q2" vid="ISA 65:6">Ok analingʼ to abiro chulo kuor adimba;</para>
  <para style="q1" vid="ISA 65:6">abiro chulo kuor kuneno,<verse eid="ISA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 65:7"/>ma en richo magu kaachiel gi richo mag kwereu,”</para>
  <para style="q2" vid="ISA 65:7">Jehova Nyasaye owacho.</para>
  <para style="q1" vid="ISA 65:7">Nikech negitimo misengini e gode</para>
  <para style="q2" vid="ISA 65:7">mine gidwanyo nyinga e gode matindo,</para>
  <para style="q1" vid="ISA 65:7">omiyo abiro kumogi chuth ka gineno kuom timbegi mosekadho.<verse eid="ISA 65:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 65:8"/>Ma e gima Jehova Nyasaye wacho:</para>
  <para style="q1" vid="ISA 65:8">“Mana kaka olemo maber inyalo yudi e saga marach,</para>
  <para style="q2" vid="ISA 65:8">ma ji wach ni, ‘Kik wite,</para>
  <para style="q2" vid="ISA 65:8">nimar pod nitie gima ber kuome,</para>
  <para style="q1" vid="ISA 65:8">e kaka anatim e lo jotichna</para>
  <para style="q2" vid="ISA 65:8">kendo ok anatiekgi duto.’<verse eid="ISA 65:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 65:9"/>Abiro kelo nyikwa joka Jakobo</para>
  <para style="q2" vid="ISA 65:9">kendo joka Juda, jogo manokaw godena;</para>
  <para style="q2" vid="ISA 65:9">ee joga mogen ma jotichna nokaw pinyno mi gidagie.<verse eid="ISA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 65:10"/>Joga mosebedo ka manya nokwa jambgi</para>
  <para style="q2" vid="ISA 65:10">Sharon kendo Holo mar Akor nobed lek mar dhog-gi.<verse eid="ISA 65:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 65:11"/>“To un musejwangʼo Jehova Nyasaye kendo</para>
  <para style="q2" vid="ISA 65:11">wiu osewil kod goda maler,</para>
  <para style="q1" vid="ISA 65:11">un mupedho mesa mar misengini,</para>
  <para style="q2" vid="ISA 65:11">kendo uloso sewni ne nyiseche manono.<verse eid="ISA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 65:12"/>Aseketou e dho ligangla,</para>
  <para style="q2" vid="ISA 65:12">kendo un duto unugo chongu kar nek;</para>
  <para style="q2" vid="ISA 65:12">nimar ne aluongou,</para>
  <para style="q1" vid="ISA 65:12">to onge ngʼama ne odwoko, ne awuoyo kodu</para>
  <para style="q2" vid="ISA 65:12">to onge ngʼama nowinjo.</para>
  <para style="q1" vid="ISA 65:12">Ne utimo timbe mamono e nyima,</para>
  <para style="q2" vid="ISA 65:12">kendo uyiero mana gik mamorou.”<verse eid="ISA 65:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 65:13"/>Kuom mano ma e gima Jehova Nyasaye Manyalo Gik Moko Duto wacho:</para>
  <para style="q1" vid="ISA 65:13">“Jotichna nochiem,</para>
  <para style="q2" vid="ISA 65:13">to unudeny;</para>
  <para style="q1" vid="ISA 65:13">jotichna nomethi,</para>
  <para style="q2" vid="ISA 65:13">to unuwinj riyo;</para>
  <para style="q1" vid="ISA 65:13">jotichna nobed gimor,</para>
  <para style="q2" vid="ISA 65:13">to unune wichkuot.<verse eid="ISA 65:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 65:14"/>Jotichna nower,</para>
  <para style="q2" vid="ISA 65:14">kamor opongʼo chunygi,</para>
  <para style="q1" vid="ISA 65:14">to unuywagi ka lit opongʼo chunyu,</para>
  <para style="q2" vid="ISA 65:14">kendo unudengi ka chunyu otur.<verse eid="ISA 65:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 65:15"/>Nyingu nobed gir kwongʼ</para>
  <para style="q2" vid="ISA 65:15">e dier joga mayiero,</para>
  <para style="q1" vid="ISA 65:15">nimar Jehova Nyasaye Manyalo Gik Moko Duto notieku chuth,</para>
  <para style="q2" vid="ISA 65:15">kendo nomi jotichne madiera nying machielo.<verse eid="ISA 65:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 65:16"/>Ngʼato angʼata mano dwar gweth e piny</para>
  <para style="q2" vid="ISA 65:16">nyaka luong mana nying Nyasaye madiera;</para>
  <para style="q1" vid="ISA 65:16">kendo ngʼato angʼata ma nokwongʼre e piny,</para>
  <para style="q2" vid="ISA 65:16">nokwongʼre mana gi nying Nyasaye madiera.</para>
  <para style="q1" vid="ISA 65:16">Nimar chandruok machon wich nowilgo,</para>
  <para style="q2" vid="ISA 65:16">kendo ginilal e wangʼa.”<verse eid="ISA 65:16"/></para>
  <para style="s1">Polo manyien gi piny manyien</para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 65:17"/>“Winjuru, abiro chweyo polo manyien kod piny manyien.</para>
  <para style="q2" vid="ISA 65:17">Gik mosekadho ok nochak opar bende ok ginibi kata e paro.<verse eid="ISA 65:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 65:18"/>To bed mamor kendo gi ilo manyaka chiengʼ,</para>
  <para style="q2" vid="ISA 65:18">gi gik ma abiro chweyo,</para>
  <para style="q1" vid="ISA 65:18">nimar abiro chweyo Jerusalem obed dala makelo mor,</para>
  <para style="q2" vid="ISA 65:18">kendo joma odakie obed gi ilo.<verse eid="ISA 65:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 65:19"/>Abiro bedo gi mor gi Jerusalem</para>
  <para style="q2" vid="ISA 65:19">kendo bedo gi ilo nikech joga;</para>
  <para style="q2" vid="ISA 65:19">ywak kod koko mar nduru ok nochak owinji kuome kendo.<verse eid="ISA 65:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 65:20"/>“E polo manyien-no kod piny manyien-no</para>
  <para style="q2" vid="ISA 65:20">ok nochak oyudie nyathi minywolo bangʼe dak mana kuom ndalo manok;</para>
  <para style="q2" vid="ISA 65:20">kata ngʼat maduongʼ ma ok nodag matiek hike duto,</para>
  <para style="q1" vid="ISA 65:20">ngʼat manotho ka hike mia achiel,</para>
  <para style="q2" vid="ISA 65:20">nokwan mana ni otho ka pod en rawera;</para>
  <para style="q1" vid="ISA 65:20">kendo ngʼat manotho ka hike pok ochopo higa mia achiel,</para>
  <para style="q2" vid="ISA 65:20">nokwan mana ka ngʼama okwongʼ.<verse eid="ISA 65:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 65:21"/>Gibiro gero udi mi gidagie</para>
  <para style="q2" vid="ISA 65:21">kendo gibiro pidho mzabibu mi gicham olembgi.<verse eid="ISA 65:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 65:22"/>Ok ginichak giger udi kae</para>
  <para style="q2" vid="ISA 65:22">to jomoko nono ema dakie,</para>
  <para style="q1" vid="ISA 65:22">kata pidho cham to jomoko nono ema biro chamo.</para>
  <para style="q2" vid="ISA 65:22">Mana kaka yath dak amingʼa,</para>
  <para style="q1" vid="ISA 65:22">e kaka joga nodagi,</para>
  <para style="q2" vid="ISA 65:22">joga mayiero none mor kuom gik ma lwetgi oseloso.<verse eid="ISA 65:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 65:23"/>Ok gini chandre kayiem nono,</para>
  <para style="q2" vid="ISA 65:23">kata nywolo nyithindo mokwongʼ;</para>
  <para style="q1" vid="ISA 65:23">nimar ginibedi oganda ma Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 65:23">ogwedho gin kod nyikwagi.<verse eid="ISA 65:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 65:24"/>Abiro dwokogi kata kapok giluonga,</para>
  <para style="q2" vid="ISA 65:24">kendo abiro winjogi kata kapok giwuoyo.<verse eid="ISA 65:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 65:25"/>Ondiek kod rombo nokwa kaachiel,</para>
  <para style="q2" vid="ISA 65:25">sibuor nocham lum mana kaka faras,</para>
  <para style="q1" vid="ISA 65:25">to lowo ema nobed chiemb thuol.</para>
  <para style="q2" vid="ISA 65:25">Onge gima ginikethi e godega duto maler,”</para>
  <para style="q2" vid="ISA 65:25">Jehova Nyasaye owacho.<verse eid="ISA 65:25"/></para>
  <chapter eid="ISA 65"/>
  <chapter number="66" style="c" sid="ISA 66"/>
  <para style="s1">Kum kod bedo gi geno</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 66:1"/>Ma e gima Jehova Nyasaye wacho:</para>
  <para style="q1" vid="ISA 66:1">“Polo e koma mar duongʼ,</para>
  <para style="q2" vid="ISA 66:1">to piny e raten tienda.</para>
  <para style="q1" vid="ISA 66:1">Koro ere kama dugerna e ot?</para>
  <para style="q2" vid="ISA 66:1">To kar yweyo mara nobed kanye?<verse eid="ISA 66:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 66:2"/>Donge lweta ema osechweyo gigi</para>
  <para style="q2" vid="ISA 66:2">duto momiyo gibedo mangima?”</para>
  <para style="q2" vid="ISA 66:2">Jehova Nyasaye ema owacho.</para>
  <para style="b" vid="ISA 66:2"/>
  <para style="q1" vid="ISA 66:2">“Ma e ngʼat ma ayiego ma en ngʼat ma hore</para>
  <para style="q2" vid="ISA 66:2">kendo man-gi chuny motur,</para>
  <para style="q2" vid="ISA 66:2">kendo ngʼama oluoro wachna.<verse eid="ISA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 66:3"/>To ngʼato angʼata moyangʼo</para>
  <para style="q2" vid="ISA 66:3">rwath katimogo misango chal gi ngʼat monego dhano,</para>
  <para style="q1" vid="ISA 66:3">kendo ngʼato angʼata motimo misango mar rombo,</para>
  <para style="q2" vid="ISA 66:3">chal gi ngʼama oturo ngʼut guok,</para>
  <para style="q1" vid="ISA 66:3">kendo ngʼato angʼata mochiwo misango mar cham</para>
  <para style="q2" vid="ISA 66:3">chal gi ngʼat mochiwo remb anguro,</para>
  <para style="q1" vid="ISA 66:3">bende ngʼato angʼata mowangʼo ubani mangʼwe</para>
  <para style="q2" vid="ISA 66:3">ngʼar mar rapar, chal gi ngʼama lamo nyiseche manono.</para>
  <para style="q1" vid="ISA 66:3">Giseyiero yoregi giwegi kendo chunygi mor</para>
  <para style="q2" vid="ISA 66:3">gi timbegi mag rondogo;<verse eid="ISA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 66:4"/>omiyo an bende abiro yieronegi masiche</para>
  <para style="q2" vid="ISA 66:4">mondo omakgi kendo abiro kelo kuomgi gik ma giluoro.</para>
  <para style="q1" vid="ISA 66:4">Nimar kane aluongo, to onge ngʼat mane odwoka,</para>
  <para style="q2" vid="ISA 66:4">kendo kane awuoyo, to onge ngʼat mane owinjo.</para>
  <para style="q1" vid="ISA 66:4">Negitimo timbe mamono e nyima,</para>
  <para style="q2" vid="ISA 66:4">kendo ne giyiero mana gik mamorogi.”<verse eid="ISA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 66:5"/>Winjuru wach Jehova Nyasaye,</para>
  <para style="q2" vid="ISA 66:5">un jogo matetni kuwinjo dwonde:</para>
  <para style="q1" vid="ISA 66:5">“Oweteni mochai kendo ok kwani ka gimoro</para>
  <para style="q2" vid="ISA 66:5">nikech ihero nyinga osewacho niya,</para>
  <para style="q1" vid="ISA 66:5">‘Mad Jehova Nyasaye mi duongʼ,</para>
  <para style="q2" vid="ISA 66:5">mondo omi wane morni!’</para>
  <para style="q2" vid="ISA 66:5">Kata kamano gin giwegi ema ginine wichkuot.<verse eid="ISA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 66:6"/>Winjuru kaka nduru wuok e dala maduongʼ,</para>
  <para style="q2" vid="ISA 66:6">kendo winjuru kaka kokono wuok e hekalu!</para>
  <para style="q1" vid="ISA 66:6">Ma en dwond Jehova Nyasaye kochulogo</para>
  <para style="q2" vid="ISA 66:6">kuor ne wasike moromo gi timbegi.<verse eid="ISA 66:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 66:7"/>“Kapok muoch ochako kaye,</para>
  <para style="q2" vid="ISA 66:7">to osenywolo nyathi;</para>
  <para style="q2" vid="ISA 66:7">kapok owinjo rem to osenywolo wuowi.<verse eid="ISA 66:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 66:8"/>En ngʼa mosewinjo wach machal kamano?</para>
  <para style="q2" vid="ISA 66:8">En ngʼa moseneno gik machalo kamano?</para>
  <para style="q1" vid="ISA 66:8">Bende piny dichwe godiechiengʼ</para>
  <para style="q2" vid="ISA 66:8">achiel koso ogendini dichok dichiel?</para>
  <para style="q1" vid="ISA 66:8">To mana e seche mane muoch ochako</para>
  <para style="q2" vid="ISA 66:8">kayo Sayun ema nonywoloe nyithinde.<verse eid="ISA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 66:9"/>Bende dawe sa ma dhako nywolie</para>
  <para style="q2" vid="ISA 66:9">chopi mak amiye teko mar nywol?”</para>
  <para style="q2" vid="ISA 66:9">Jehova Nyasaye owacho.</para>
  <para style="q1" vid="ISA 66:9">“Bende dadin ich</para>
  <para style="q2" vid="ISA 66:9">kochopo sa mar chiwo nyathi?”</para>
  <para style="q2" vid="ISA 66:9">Nyasachi owacho.<verse eid="ISA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 66:10"/>“Moruru gi Jerusalem kendo bed mamor kode,</para>
  <para style="q2" vid="ISA 66:10">un duto muhere;</para>
  <para style="q1" vid="ISA 66:10">beduru gi ilo maduongʼ,</para>
  <para style="q2" vid="ISA 66:10">un duto man-gi kuyo nikech en.<verse eid="ISA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 66:11"/>Nimar ibiro piru maber kudhodho thunde;</para>
  <para style="q2" vid="ISA 66:11">kendo unumethi gi ilo mi ubed gi mor mogundho.”<verse eid="ISA 66:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 66:12"/>Nimar ma e gima Jehova Nyasaye wacho:</para>
  <para style="q1" vid="ISA 66:12">“Abiro miyo kwe ma en-go mol ka aora</para>
  <para style="q2" vid="ISA 66:12">kendo mwandu mag pinje namiye mamol ka oula;</para>
  <para style="q1" vid="ISA 66:12">unubed mamor ka odhodhou kotingʼou e bade</para>
  <para style="q2" vid="ISA 66:12">kendo kopirou e chonge.<verse eid="ISA 66:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 66:13"/>Mana kaka miyo hoyo nyathine,</para>
  <para style="q2" vid="ISA 66:13">e kaka abiro hoyou;</para>
  <para style="q2" vid="ISA 66:13">kendo noho chunyu e Jerusalem.”<verse eid="ISA 66:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 66:14"/>Ka uneno ma, to chunyu nobed gi mor,</para>
  <para style="q2" vid="ISA 66:14">kendo dendu nobed maber mana ka lum matwi ndalo chwiri;</para>
  <para style="q1" vid="ISA 66:14">lwet Jehova Nyasaye nofwenyre ne jotichne,</para>
  <para style="q2" vid="ISA 66:14">to mirimbe to none kuom wasike.<verse eid="ISA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 66:15"/>To nee, Jehova Nyasaye biro gi mach,</para>
  <para style="q2" vid="ISA 66:15">kendo gechene mag lweny chalo ka kalausi;</para>
  <para style="q1" vid="ISA 66:15">obiro kelo mirimbe makakni,</para>
  <para style="q2" vid="ISA 66:15">kendo chwat mare nopilre ka mach.<verse eid="ISA 66:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 66:16"/>Nimar mach kod ligangla</para>
  <para style="q2" vid="ISA 66:16">ema Jehova Nyasaye noyalgo ji duto,</para>
  <para style="q2" vid="ISA 66:16">kendo joma Jehova Nyasaye nonegi nobed mangʼeny.<verse eid="ISA 66:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 66:17"/>Jehova Nyasaye wacho niya, “Joma pwodhore kendo bedo maler mondo odhiye puothe, kamoro ka moro luwo wadgi kendo chamo ring anguro, oyieyo kod gik moko duto makwero norum duto dichiel.<verse eid="ISA 66:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 66:18"/>“An Jehova Nyasaye angʼeyo timbeni gi paroni achiegni biro mondo achok ogendini duto kod dhoudi mawacho dhok mopogore opogore kendo ginibi mi ginine duongʼ mara maler.<verse eid="ISA 66:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 66:19"/>“Anatim ranyisi e kindgi kendo anaor jomoko manok ma notony mane pok owinjo humba kata mane pok oneno duongʼ mara maler ma gin: Tarshish, Libya, Lud (mongʼere gi nying mar jolweny mongʼeyo kedo gi asere), jo-Tubal kod jo-Yunani kaachiel gi joma odak e dho nembe man kuonde maboyo. Gibiro nyiso duongʼna e kind ogendini. <verse eid="ISA 66:19"/><verse number="20" style="v" sid="ISA 66:20"/>Kendo ginikel oweteni duto koa e ogendini duto, e goda maler ma en Jerusalem kaka gir misango ne Jehova Nyasaye ka moko oidho farese, geche lweny, pundane kod ngamia,” Jehova Nyasaye owacho. “Gibiro kelogi mana kaka jo-Israel kelo misengini e od Jehova Nyasaye, ka gitingʼogi e tewni maler. <verse eid="ISA 66:20"/><verse number="21" style="v" sid="ISA 66:21"/>Kendo moko kuomgi bende nayier mondo obed jodolo kod jo-Lawi,” Jehova Nyasaye owacho.<verse eid="ISA 66:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 66:22"/>Jehova Nyasaye wacho niya, “Mana kaka polo manyien machweyo gi piny manyien nosiki e nyima, e kaka nyingi kod nying nyikwayi nosiki. <verse eid="ISA 66:22"/><verse number="23" style="v" sid="ISA 66:23"/>Mana kaka dwe por kendo podho kendo machielo por, bende mana kaka chiengʼ Sabato nyaka chiengʼ Sabato machielo e kaka ji duto biro bedo kendo kulore e nyima,” Jehova Nyasaye owacho. <verse eid="ISA 66:23"/><verse number="24" style="v" sid="ISA 66:24"/>“Giniwuogi mi gine ringre joma otho mosepiem koda, kudni machamogi ok notho kata mach mawangʼogi ok notho kendo ginibed gik ma piny ngima ojokgo.”<verse eid="ISA 66:24"/></para>
  <chapter eid="ISA 66"/>
</usx>
