<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Biblica® Open New Luo Translation 2020</book>
  <para style="h">Nahum</para>
  <para style="toc1">Nahum</para>
  <para style="toc2">Nahum</para>
  <para style="toc3">Nah</para>
  <para style="mt1">Nahum</para>
  <chapter number="1" style="c" sid="NAM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1"/>Wach Nyasaye kuom Nineve. Kitap fweny mar Nahum ja-Elkosh.<verse eid="NAM 1:1"/></para>
  <para style="b"/>
  <para style="s1">Mirimb Jehova Nyasaye kuom Nineve</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2"/>Jehova Nyasaye en Nyasaye ma janyiego kendo machulo kuor.</para>
  <para style="q2" vid="NAM 1:2">Jehova Nyasaye chulo kuor kendo en gi mirima.</para>
  <para style="q1" vid="NAM 1:2">Jehova Nyasaye chulo kuor ne joma kwede</para>
  <para style="q2" vid="NAM 1:2">kendo kumne osiko kuom jowasike.<verse eid="NAM 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3"/>Jehova Nyasaye iye ok wangʼ piyo kendo en gi teko maduongʼ.</para>
  <para style="q2" vid="NAM 1:3">Jehova Nyasaye ok nowe joketho ma ok okumo.</para>
  <para style="q1" vid="NAM 1:3">Yore moluwo ni ei kalausi gi ahiti,</para>
  <para style="q2" vid="NAM 1:3">bende boche polo gin buch tiende.<verse eid="NAM 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4"/>Ogolo chik to nam mi nam tuo,</para>
  <para style="q2" vid="NAM 1:4">kendo aore duto dwono.</para>
  <para style="q1" vid="NAM 1:4">Lege mabeyo mag Bashan gi Karmel tuo,</para>
  <para style="q2" vid="NAM 1:4">kendo yiende mag Lebanon bende ner.<verse eid="NAM 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5"/>Gode madongo yiengni e nyime</para>
  <para style="q2" vid="NAM 1:5">kendo thuche leny nono.</para>
  <para style="q1" vid="NAM 1:5">Piny tetni e nyime,</para>
  <para style="q2" vid="NAM 1:5">piny kod ji duto madakie tetni.<verse eid="NAM 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6"/>Ere ngʼat manyalo siro mirimbe?</para>
  <para style="q2" vid="NAM 1:6">Koso en ngʼa manyalo siro mirimbe mager?</para>
  <para style="q1" vid="NAM 1:6">Mirimbe mager oolo mana ka mach.</para>
  <para style="q2" vid="NAM 1:6">Lwendni barore e nyime.<verse eid="NAM 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7"/>Jehova Nyasaye ber,</para>
  <para style="q2" vid="NAM 1:7">Jehova Nyasaye e kar pondo e kinde mag chandruok,</para>
  <para style="q1" vid="NAM 1:7">orito joma ogeno kuome.<verse eid="NAM 1:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="NAM 1:8"/>Nineve to obiro ywero,</para>
  <para style="q1" vid="NAM 1:8">gi ohula maduongʼ motiek chuth;</para>
  <para style="q2" vid="NAM 1:8">obiro lawo joma kwede nyaka e mudho mandiwa.<verse eid="NAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9"/>Gimoro amora marach ma gichano timo ni Jehova Nyasaye</para>
  <para style="q2" vid="NAM 1:9">obiro tieko;</para>
  <para style="q2" vid="NAM 1:9">bende chandruok ok nobedie kendo.<verse eid="NAM 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10"/>Gibiro moko e kind kuthe</para>
  <para style="q2" vid="NAM 1:10">kendo gibiro mer gi divai mag-gi,</para>
  <para style="q2" vid="NAM 1:10">bende ibiro wangʼ-gi ka lum motwo.<verse eid="NAM 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11"/>Ngʼat machano gik maricho kuom Jehova Nyasaye</para>
  <para style="q2" vid="NAM 1:11">wuok mana kuomi, yaye Nineve,</para>
  <para style="q2" vid="NAM 1:11">en e ngʼat mamiyo ji donjo e ketho.<verse eid="NAM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12"/>Jehova Nyasaye wacho kama:</para>
  <para style="q1" vid="NAM 1:12">“Kata obedo ni gingʼeny kendo gin gi joma konyogi,</para>
  <para style="q2" vid="NAM 1:12">ibiro ngʼad kargi oko mi gilal nono.</para>
  <para style="q1" vid="NAM 1:12">Kata obedo ni asesandi, yaye Juda,</para>
  <para style="q2" vid="NAM 1:12">ok anachak sandi kendo.<verse eid="NAM 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13"/>Koro abiro turo jok ma giketo e ngʼuti</para>
  <para style="q2" vid="NAM 1:13">kendo abiro chodo nyororo motweyigo.”<verse eid="NAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14"/>Jehova Nyasaye osegolo chik kuomi, in Nineve, kowacho niya:</para>
  <para style="q2" vid="NAM 1:14">“Ok inibed gi nyikwayi mabiro tingʼo nyingi.</para>
  <para style="q1" vid="NAM 1:14">Abiro tieko nyisecheu manono mopa kaachiel gi mochwe gi lowo</para>
  <para style="q2" vid="NAM 1:14">manie uteu mag lemo.</para>
  <para style="q1" vid="NAM 1:14">Abiro kunyonu bur miyikoue</para>
  <para style="q2" vid="NAM 1:14">nikech un joma timbegi richo.”<verse eid="NAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15"/>Tingʼ wangʼi,</para>
  <para style="q2" vid="NAM 1:15">ineye tiende ngʼat makelo Injili,</para>
  <para style="q2" vid="NAM 1:15">kendo malando kwe ewi gode!</para>
  <para style="q1" vid="NAM 1:15">Tim nyasi mar mor, yaye Juda,</para>
  <para style="q2" vid="NAM 1:15">chopuru singruoku.</para>
  <para style="q1" vid="NAM 1:15">Jomaricho ok nochak omonju kendo;</para>
  <para style="q2" vid="NAM 1:15">nikech ibiro tiekgi pep.<verse eid="NAM 1:15"/></para>
  <chapter eid="NAM 1"/>
  <chapter number="2" style="c" sid="NAM 2"/>
  <para style="s1">Nineve biro podho</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1"/>Ngʼat mabiro monji ochomi,</para>
  <para style="q2" vid="NAM 2:1">yaye Nineve, omiyo rit dala mochiel motegno,</para>
  <para style="q2" vid="NAM 2:1">rit yoreni,</para>
  <para style="q2" vid="NAM 2:1">bed gi ikruok maber,</para>
  <para style="q2" vid="NAM 2:1">kuom tekoni duto!<verse eid="NAM 2:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2"/>Jehova Nyasaye biro dwoko duongʼ mar Jakobo,</para>
  <para style="q2" vid="NAM 2:2">mana ka duongʼ mar Israel,</para>
  <para style="q1" vid="NAM 2:2">kata obedo ni joma omonje osekethe</para>
  <para style="q2" vid="NAM 2:2">kendo oseketho puothegi mag mzabibu.<verse eid="NAM 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3"/>Okumba mag jolweny osebedo makwar ka remo;</para>
  <para style="q2" vid="NAM 2:3">kendo lewni ma girwakorego bende kwar.</para>
  <para style="q1" vid="NAM 2:3">Chuma manie ewi gechegi mil</para>
  <para style="q2" vid="NAM 2:3">ka giikore ne chiengʼ lweny;</para>
  <para style="q2" vid="NAM 2:3">tongegi opiag mabith kendo milni ka gikedogo.<verse eid="NAM 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4"/>Geche powore e yore mag dala,</para>
  <para style="q2" vid="NAM 2:4">ka giringo koni gi koni e tunge mag dala.</para>
  <para style="q1" vid="NAM 2:4">Gichalo gi rameny maliel mager,</para>
  <para style="q2" vid="NAM 2:4">ka gipiachore ka mil polo.<verse eid="NAM 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5"/>Oluongo jolweny mage moyiero,</para>
  <para style="q2" vid="NAM 2:5">to gichwanyore ka gidhi.</para>
  <para style="q1" vid="NAM 2:5">Giringo ka gidhi e ohinga mar dala;</para>
  <para style="q2" vid="NAM 2:5">ka gigengʼore gi okumba.<verse eid="NAM 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6"/>Ohinga mane gigengʼogo pi madonjo e dala ruoth omukore,</para>
  <para style="q2" vid="NAM 2:6">bende od ruoth ogore piny.<verse eid="NAM 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7"/>Osegol Chik ni dala maduongʼ</para>
  <para style="q2" vid="NAM 2:7">nyaka maki ma ter e piny ma wendo.</para>
  <para style="q1" vid="NAM 2:7">Wasumbinigi ma nyiri ywagore ka akuche</para>
  <para style="q2" vid="NAM 2:7">kendo ka gidwongʼo korgi.<verse eid="NAM 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8"/>Nineve chalo dago,</para>
  <para style="q2" vid="NAM 2:8">kendo pige mol kadhi.</para>
  <para style="q1" vid="NAM 2:8">Giywak kagiwacho niya, “Chungʼ! Chungʼ!”</para>
  <para style="q2" vid="NAM 2:8">to onge ngʼama lokore duogo.<verse eid="NAM 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9"/>Yakuru fedha!</para>
  <para style="q2" vid="NAM 2:9">Yakuru dhahabu!</para>
  <para style="q1" vid="NAM 2:9">Mwandugi ngʼeny mokadho,</para>
  <para style="q2" vid="NAM 2:9">gin mwandu mogol kuonde kenogi duto.<verse eid="NAM 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10"/>Odongʼ nono, omaye gik moko duto,</para>
  <para style="q2" vid="NAM 2:10">bende olonye modongʼ duk.</para>
  <para style="q1" vid="NAM 2:10">Kibaji ogoyo chunygi,</para>
  <para style="q2" vid="NAM 2:10">bende chongegi onyosere,</para>
  <para style="q1" vid="NAM 2:10">kendo dendgi tetni</para>
  <para style="q2" vid="NAM 2:10">ka ngʼato ka ngʼato wangʼe ojowore.<verse eid="NAM 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11"/>Koro to ere bur sibuor</para>
  <para style="q2" vid="NAM 2:11">kama ne gipidhoe nyithindgi,</para>
  <para style="q1" vid="NAM 2:11">kama sibuor madichwo gi sibuor madhako nodhiye,</para>
  <para style="q2" vid="NAM 2:11">ka nyithind sibuochego onge gi gima ginyalo luoro?<verse eid="NAM 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12"/>Sibuor ne yangʼo le moromo nyithinde</para>
  <para style="q2" vid="NAM 2:12">kendo ne gideyo le ma gichamo gi nyawadgi,</para>
  <para style="q1" vid="NAM 2:12">ka opongʼo kar kano chiembe</para>
  <para style="q2" vid="NAM 2:12">kod kuonde dakne gi gik monegi.<verse eid="NAM 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13"/>Jehova Nyasaye Maratego wacho niya,</para>
  <para style="q2" vid="NAM 2:13">“An gi sigu kodu.</para>
  <para style="q1" vid="NAM 2:13">Abiro wangʼo gecheu mag lweny gi mach mawuog iro</para>
  <para style="q2" vid="NAM 2:13">kendo ligangla biro tieko sibuoche matindo maroteke.</para>
  <para style="q2" vid="NAM 2:13">Kata ringregi motho ok anawenu e piny.</para>
  <para style="q1" vid="NAM 2:13">Dwond jooteu</para>
  <para style="q2" vid="NAM 2:13">ok nowinj kendo.”<verse eid="NAM 2:13"/></para>
  <chapter eid="NAM 2"/>
  <chapter number="3" style="c" sid="NAM 3"/>
  <para style="s1">Lit mabiro ne jo-Nineve</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1"/>Mano kaka nobed malit ne dala mopongʼ gi remo,</para>
  <para style="q2" vid="NAM 3:1">dala mopongʼ gi miriambo,</para>
  <para style="q1" vid="NAM 3:1">dala mopongʼ gi gige mecho,</para>
  <para style="q2" vid="NAM 3:1">kendo dala mopongʼ gi gik moyaki mosiko ka chando ji!<verse eid="NAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2"/>Nochwade gi del malit,</para>
  <para style="q2" vid="NAM 3:2">ka tiende geche magoyo koko,</para>
  <para style="q1" vid="NAM 3:2">ka tiend farese maringo mamor matek,</para>
  <para style="q2" vid="NAM 3:2">kendo ka geche maringo mag farese makakni ka mach!<verse eid="NAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3"/>Oganda lweny omonjogi,</para>
  <para style="q2" vid="NAM 3:3">gi ligengni mamil,</para>
  <para style="q2" vid="NAM 3:3">kendo gi tonge mag lweny mamil!</para>
  <para style="q1" vid="NAM 3:3">Joma ohinyore e lweny ngʼeny,</para>
  <para style="q2" vid="NAM 3:3">kendo ringre joma otho ochok mangʼeny,</para>
  <para style="q1" vid="NAM 3:3">ringre joma othogo okadho akwana,</para>
  <para style="q2" vid="NAM 3:3">kendo joma ringo chwanyore kuom ringre joma othogo.<verse eid="NAM 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4"/>Magi duto timore nikech gombo mandhaga mar ochot,</para>
  <para style="q2" vid="NAM 3:4">maywayo ji ire, en e chot ma jo-nyakalondo dhi ire,</para>
  <para style="q1" vid="NAM 3:4">en ema ne oketo ogendini misumbinine kuom timbene mag chode</para>
  <para style="q2" vid="NAM 3:4">kendo oywayo ji kuome gi timbene mag jwok.<verse eid="NAM 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5"/>Jehova Nyasaye Maratego wacho niya, “An gi sigu kodu.</para>
  <para style="q2" vid="NAM 3:5">Abiro elo lepu maum wengeu.</para>
  <para style="q1" vid="NAM 3:5">Abiro nyiso ogendini duto dugu,</para>
  <para style="q2" vid="NAM 3:5">kendo pinjeruodhi biro neno wichkuot maru.<verse eid="NAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6"/>Abiro bayi gi gik modwanyore kendo mochido,</para>
  <para style="q2" vid="NAM 3:6">ka an kod chuny marach kodi,</para>
  <para style="q1" vid="NAM 3:6">kendo abiro keti gima ji jaro.<verse eid="NAM 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7"/>Ji duto ma oneni biro ringi kawacho ni,</para>
  <para style="q2" vid="NAM 3:7">‘Nineve osepodho ere ngʼama noywage?’</para>
  <para style="q2" vid="NAM 3:7">Ere kama danwangʼie ngʼama nyalo hoyi?”<verse eid="NAM 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8"/>Iparo ni iber moloyo Thebes</para>
  <para style="q2" vid="NAM 3:8">mane oger e tiend aora mar Nael,</para>
  <para style="q2" vid="NAM 3:8">ka olwore gi pi?</para>
  <para style="q1" vid="NAM 3:8">Aorano ema ne otene kaka ohinga molwore,</para>
  <para style="q2" vid="NAM 3:8">pige to ne obedone ohinga motegno.<verse eid="NAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9"/>Jo-Kush gi Jo-Misri e kama nonwangʼie teko ma ok rum;</para>
  <para style="q2" vid="NAM 3:9">jo-Put gi jo-Libya ne gin pinje kuom moko mane konye.<verse eid="NAM 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10"/>To kata kamano ne otere e twech,</para>
  <para style="q2" vid="NAM 3:10">piny ma ok mare ma obedo misumba jomoko.</para>
  <para style="q1" vid="NAM 3:10">Nyithinde ne ongʼad migepe matindo tindo</para>
  <para style="q2" vid="NAM 3:10">e dho yore mag dalane.</para>
  <para style="q1" vid="NAM 3:10">Ne ogo ombulu kuom jotende ma ruodhi,</para>
  <para style="q2" vid="NAM 3:10">kendo joge madongo duto ne otwe gi nyororo.<verse eid="NAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11"/>In bende ibiro mer,</para>
  <para style="q2" vid="NAM 3:11">ibiro pondo,</para>
  <para style="q2" vid="NAM 3:11">kendo ibiro kwayo kar dak kuom jowasiki.<verse eid="NAM 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12"/>Miechu mochiel motegno duto nochal mana gi yiende mag ngʼowu,</para>
  <para style="q2" vid="NAM 3:12">machiego olemo mokwongo;</para>
  <para style="q1" vid="NAM 3:12">ka oyieng-gi</para>
  <para style="q2" vid="NAM 3:12">to olembgi lwar e dho jochiemo.<verse eid="NAM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13"/>Ne jolweny magi;</para>
  <para style="q2" vid="NAM 3:13">gin mana mon lilo!</para>
  <para style="q1" vid="NAM 3:13">Dhorangeye mag dalani</para>
  <para style="q2" vid="NAM 3:13">oyaw malich ni wasiki;</para>
  <para style="q2" vid="NAM 3:13">mach osewangʼogi.<verse eid="NAM 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14"/>Kanuru pi ka kinde mar agengʼa pok ochopo,</para>
  <para style="q2" vid="NAM 3:14">meduru keto ohinga obed motegno!</para>
  <para style="q1" vid="NAM 3:14">Nywasuru lowo</para>
  <para style="q2" vid="NAM 3:14">kendo chweyeuru motegno,</para>
  <para style="q2" vid="NAM 3:14">mondo matafarego ugergo kuonde momukore mag ohinga obed motegno!<verse eid="NAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15"/>Mach biro wangʼou kanyo,</para>
  <para style="q2" vid="NAM 3:15">ligangla biro ngʼadou matindo tindo,</para>
  <para style="q2" vid="NAM 3:15">mitieku mana ka dede mar bonyo momonjo piny.</para>
  <para style="q1" vid="NAM 3:15">Medreuru ameda mana ka dede,</para>
  <para style="q2" vid="NAM 3:15">medreuru ka det bonyo!<verse eid="NAM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16"/>Usemedo jolok ohala magu,</para>
  <para style="q2" vid="NAM 3:16">makoro githoth moloyo sulwe ma e polo,</para>
  <para style="q1" vid="NAM 3:16">kendo kaka det bonyo chamo piny,</para>
  <para style="q2" vid="NAM 3:16">e kaka giweyo piny duk</para>
  <para style="q2" vid="NAM 3:16">bangʼe to gihuyo ma gia.<verse eid="NAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17"/>Joritou chalo det bonyo,</para>
  <para style="q2" vid="NAM 3:17">jotendu to chalo gi det bonyo mochokore mathoth kabiro,</para>
  <para style="q2" vid="NAM 3:17">kendo piyo e kor ot ka piny ngʼich,</para>
  <para style="q1" vid="NAM 3:17">to ka chiengʼ owuok to gihuyo gidhi kuma mabor</para>
  <para style="q2" vid="NAM 3:17">maonge ngʼama ongʼeyo.<verse eid="NAM 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18"/>Yaye ruodh jo-Asuria, jotendu nindo otero;</para>
  <para style="q2" vid="NAM 3:18">ruodhi mau onindo piny mondo giywe.</para>
  <para style="q1" vid="NAM 3:18">Jogi to okere ewi gode</para>
  <para style="q2" vid="NAM 3:18">maonge ngʼama nyalo chokogi.<verse eid="NAM 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19"/>Onge gima nyalo chango adhondeni,</para>
  <para style="q2" vid="NAM 3:19">ihinyori marach.</para>
  <para style="q1" vid="NAM 3:19">Ji duto mowinjo wach man kuomi</para>
  <para style="q2" vid="NAM 3:19">pamo lwetgi kuom podho mari,</para>
  <para style="q1" vid="NAM 3:19">nimar ere ngʼama pok oneno</para>
  <para style="q2" vid="NAM 3:19">sand ma ok rum mane isandogo ji?<verse eid="NAM 3:19"/></para>
  <chapter eid="NAM 3"/>
</usx>
