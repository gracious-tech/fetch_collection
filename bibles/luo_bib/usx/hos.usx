<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HOS" style="id">- Biblica® Open New Luo Translation 2020</book>
  <para style="h">Hosea</para>
  <para style="toc1">Hosea</para>
  <para style="toc2">Hosea</para>
  <para style="toc3">Hos</para>
  <para style="mt1">Hosea</para>
  <chapter number="1" style="c" sid="HOS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1"/>Wach Jehova Nyasaye mane obiro ne Hosea wuod Beeri e ndalo loch Uzia, gi Jotham gi Ahaz kod Hezekia, ruodhi mag Juda, e ndalo loch Jeroboam wuod Jehoash ruodh Israel.<verse eid="HOS 1:1"/></para>
  <para style="b"/>
  <para style="s1">Chi Hosea gi nyithindgi</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2"/>Kane Jehova Nyasaye ochako miyo Hosea wachne monego owachi, Jehova Nyasaye nowachone niya, “Dhiyo ikend dhako ma jachode kendo inywol kode nyithindo mag dwanyruokne, nikech piny oseketho kotimo richo mar chode marachie moloyo mi giseweyo Jehova Nyasaye.” <verse eid="HOS 1:2"/><verse number="3" style="v" sid="HOS 1:3"/>Omiyo Hosea nodhi mokendo Gomer nyar Diblaim, mine omako ich monywolone wuowi.<verse eid="HOS 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 1:4"/>Eka Jehova Nyasaye nowachone Hosea niya, “Chak nyathi nying ni Jezreel nikech achiegni kumo dhood Jehu kuom nek mane otimore Jezreel kendo adhi tieko pinyruoth mar Israel. <verse eid="HOS 1:4"/><verse number="5" style="v" sid="HOS 1:5"/>E odiechiengno abiro ketho atungʼ mar pinyruodh Israel e Holo mar Jezreel.”<verse eid="HOS 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6"/>Gomer ne omako ich kendo mi onywolo nyathi ma nyako. Eka Jehova Nyasaye nowachone Hosea niya, “Luonge ni Lo-Ruhama nimar ok abi achak anyis hera ni dhood Israel kata mana ngʼwononegi. <verse eid="HOS 1:6"/><verse number="7" style="v" sid="HOS 1:7"/>Kata kamano, abiro nyiso herana ne dhood Juda kendo abiro resogi to ok abi resogi gi atungʼ, kata ligangla kata gige lweny kata gi farese kata gi jomoidho farese, to an Jehova Nyasaye ma Nyasachgi ema anaresgi.”<verse eid="HOS 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8"/>Bangʼ kane Gomer oseweyo dhodho Lo-Ruhama, nonywolo nyathi machielo ma wuowi. <verse eid="HOS 1:8"/><verse number="9" style="v" sid="HOS 1:9"/>Eka Jehova Nyasaye nowacho niya, “Luonge ni Lo-Ami nimar ok un joga, An bende ok An Nyasachu.<verse eid="HOS 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 1:10"/>“To kata obedo kamano, jo-Israel nobed mathoth ka kwoyo manie dho nam ma ok nyal pim kata kwano. Kama ne owachnegi ni, ‘Ok un joga,’ ibiro luongogi ni ‘yawuot Nyasaye mangima.’ <verse eid="HOS 1:10"/><verse number="11" style="v" sid="HOS 1:11"/>Jo-Juda gi jo-Israel nochak riwre kendo giniyier jatelo achiel kendo giniwuogi ka gia e pinje mane ginie wasumbini nimar odiechiengʼ mar Jezreel nobed maduongʼ miwuoro.”<verse eid="HOS 1:11"/></para>
  <chapter eid="HOS 1"/>
  <chapter number="2" style="c" sid="HOS 2"/>
  <para style="p">
    <verse number="1" style="v" sid="HOS 2:1"/>“Luonguru oweteu ni ‘Joga,’ kendo luonguru nyimineu ni ‘Joma ahero.’ ”<verse eid="HOS 2:1"/></para>
  <para style="s1">Jo-Israel okum kendo oduogi</para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 2:2"/>“Kwer minu, kwere,</para>
  <para style="q2" vid="HOS 2:2">nikech ok en jaoda,</para>
  <para style="q2" vid="HOS 2:2">kendo ok an chwore.</para>
  <para style="q1" vid="HOS 2:2">Onego owe wangʼ maneno mar chode</para>
  <para style="q2" vid="HOS 2:2">kendo gi yorene mag dwanyruok.<verse eid="HOS 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 2:3"/>Ka ok kamano to abiro lonye duk</para>
  <para style="q2" vid="HOS 2:3">modongʼ kaka ne onywole;</para>
  <para style="q1" vid="HOS 2:3">anakete ochal kaka lop ongoro,</para>
  <para style="q2" vid="HOS 2:3">analoke kaka lowo motwo mobaro okak,</para>
  <para style="q2" vid="HOS 2:3">kendo ananege kod riyo mar pi.<verse eid="HOS 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 2:4"/>Ok anaher nyithinde,</para>
  <para style="q2" vid="HOS 2:4">nikech gin nyithindo mane oyud e yor chode.<verse eid="HOS 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 2:5"/>Min-gi ok osebedo ja-ratiro</para>
  <para style="q2" vid="HOS 2:5">kendo osemako ich gi anjawo.</para>
  <para style="q1" vid="HOS 2:5">Owacho ni, ‘Abiro luwo bangʼ joherana,</para>
  <para style="q2" vid="HOS 2:5">mamiya chiemba kod piga,</para>
  <para style="q2" vid="HOS 2:5">yie rombe gi pamba michweyogo lewni, mo kod math.’<verse eid="HOS 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 2:6"/>Omiyo anagengʼ yore kod bungu maduongʼ mar kudho;</para>
  <para style="q2" vid="HOS 2:6">abiro dinone chuth ma ok noyud yo mowuok godo oko.<verse eid="HOS 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 2:7"/>Enolaw bangʼ jochodenego to ok nomakgi;</para>
  <para style="q2" vid="HOS 2:7">enomanygi to ok noyudgi.</para>
  <para style="q1" vid="HOS 2:7">Bangʼe to enowachi niya,</para>
  <para style="q2" vid="HOS 2:7">Abiro dokne chwora mokwongo,</para>
  <para style="q2" vid="HOS 2:7">nimar ndalono ne awinjo maber moloyo sani.<verse eid="HOS 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 2:8"/>Ok osengʼeyo adier ni an</para>
  <para style="q2" vid="HOS 2:8">ema ne amiye cham, divai manyien kod mo,</para>
  <para style="q1" vid="HOS 2:8">an bende ema ne adhiale gi fedha gi dhahabu mangʼenygo</para>
  <para style="q2" vid="HOS 2:8">mane gitiyo nego Baal.<verse eid="HOS 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 2:9"/>“Kuom mano abiro kawo chamba ka osechiek,</para>
  <para style="q2" vid="HOS 2:9">gi divaina manyien ka oseikore.</para>
  <para style="q1" vid="HOS 2:9">Bende anakaw yie rombona gi pambana mitwangʼo godo lewni</para>
  <para style="q2" vid="HOS 2:9">mane onego oum-go duge.<verse eid="HOS 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 2:10"/>Koro abiro nyiso ayanga gombo mare mar chode</para>
  <para style="q2" vid="HOS 2:10">e lela e nyim joherane;</para>
  <para style="q2" vid="HOS 2:10">kendo onge ngʼama nogole e lweta.<verse eid="HOS 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 2:11"/>Nyasi duto ma en-go anakethi:</para>
  <para style="q2" vid="HOS 2:11">nyasi mar higa ka higa, mar dwe ka dwe,</para>
  <para style="q2" vid="HOS 2:11">mar Sabato kod nyasi motimo juma ka juma.<verse eid="HOS 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 2:12"/>Anaketh yiendene mag mzabibu gi yiend ngʼopene</para>
  <para style="q2" vid="HOS 2:12">mane owacho ni ne chudone moa kuom joherane.</para>
  <para style="q1" vid="HOS 2:12">Abiro ketogi bunge,</para>
  <para style="q2" vid="HOS 2:12">kendo le mag bungu nokethgi.”<verse eid="HOS 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 2:13"/>Jehova Nyasaye wacho niya,</para>
  <para style="q1" vid="HOS 2:13">“Anakume kuom ndalo duto</para>
  <para style="q2" vid="HOS 2:13">mane owangʼo ubani ne Baal;</para>
  <para style="q1" vid="HOS 2:13">korwakore gi gik mabeyo ahinya</para>
  <para style="q2" vid="HOS 2:13">kolombogo joherane,</para>
  <para style="q2" vid="HOS 2:13">to an ne wiye owil koda.<verse eid="HOS 2:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 2:14"/>“Kuom mano abiro hoye,</para>
  <para style="q2" vid="HOS 2:14">mi adhi kode e piny motimo ongoro,</para>
  <para style="q2" vid="HOS 2:14">kendo abiro wuoyo kode gi muolo.<verse eid="HOS 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 2:15"/>Kanyo abiro dwokone puothe mar mzabibu,</para>
  <para style="q2" vid="HOS 2:15">Kendo analos holo mar Akor obed dhood geno.</para>
  <para style="q1" vid="HOS 2:15">Kanyo nowerie mana kaka nower kapod otin,</para>
  <para style="q2" vid="HOS 2:15">mana ka chiengʼ mane owuok koa Misri.”<verse eid="HOS 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 2:16"/>Jehova Nyasaye owacho niya,</para>
  <para style="q2" vid="HOS 2:16">“Odiechiengʼno iniluonga ni ‘chwora,’</para>
  <para style="q2" vid="HOS 2:16">to ok inichak iluonga ni ‘jatenda.’<verse eid="HOS 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 2:17"/>Abiro golo nyinge mag Baal oa e dhoge.</para>
  <para style="q2" vid="HOS 2:17">Nying Baal ok nochak owuo kuomgi kendo.<verse eid="HOS 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 2:18"/>Chiengʼno anaketnegi singruok</para>
  <para style="q2" vid="HOS 2:18">e kindgi gi le mag thim gi winy manie kor polo,</para>
  <para style="q2" vid="HOS 2:18">gi chwech mamol e lowo,</para>
  <para style="q1" vid="HOS 2:18">atungʼ gi ligangla to abiro turo,</para>
  <para style="q2" vid="HOS 2:18">kendo lweny bende anatiek e piny,</para>
  <para style="q2" vid="HOS 2:18">mondo gik moko duto obed gi kwe.<verse eid="HOS 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 2:19"/>Abiro timo kodi singruok mar kend mondo ibed mara chuth;</para>
  <para style="q2" vid="HOS 2:19">abiro timo kodi singruok mar kend e yo maler kendo maratiro,</para>
  <para style="q2" vid="HOS 2:19">gihera kod kech.<verse eid="HOS 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="HOS 2:20"/>Abiro timo kodi singruok mar kend e yo mar adiera,</para>
  <para style="q2" vid="HOS 2:20">kendo ibiro yie kuom Jehova Nyasaye.”<verse eid="HOS 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="HOS 2:21"/>Jehova Nyasaye wacho niya,</para>
  <para style="q2" vid="HOS 2:21">“E odiechiengno abiro dwoko kwayou ma boche polo,</para>
  <para style="q2" vid="HOS 2:21">nochiw koth ne piny,<verse eid="HOS 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="HOS 2:22"/>kendo cham biro nyak e piny,</para>
  <para style="q2" vid="HOS 2:22">kaachiel gi divai manyien kod mo zeituni,</para>
  <para style="q2" vid="HOS 2:22">mi giduto ginyag Jezreel.<verse eid="HOS 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="HOS 2:23"/>Abiro pidhe e piny ne an awuon;</para>
  <para style="q2" vid="HOS 2:23">abiro nyiso herana ni ngʼat mane aluongo ni ‘Ok jaherana.’</para>
  <para style="q1" vid="HOS 2:23">Anawach ni joma iluongo ni,</para>
  <para style="q2" vid="HOS 2:23">‘Joma ok joga,’ ni, ‘Un joga’;</para>
  <para style="q2" vid="HOS 2:23">kendo ginidwoka ni, ‘In Nyasachwa.’ ”<verse eid="HOS 2:23"/></para>
  <chapter eid="HOS 2"/>
  <chapter number="3" style="c" sid="HOS 3"/>
  <para style="s1">Hosea otimo winjruok gi chiege</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1"/>Jehova Nyasaye nowachona niya, “Dhiyo, inyis herani ni chiegi kendo, kata obedo ni ohere gi ngʼama chielo, kendo en jachode. Here kaka Nyasaye ohero jo-Israel, kata obedo ni gisebaro ka gihero nyiseche moko kendo gihero chiwonigi misengini mag mzabibu motwo.”<verse eid="HOS 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2"/>Omiyo ne angʼiewe kuom shekel apar gabich mag fedha gi gunde ariyo mag shairi. <verse eid="HOS 3:2"/><verse number="3" style="v" sid="HOS 3:3"/>Eka ne awachone niya, “Nyaka idag koda kuom ndalo mathoth; nyaka iwe timbegi mag chode kata riwori gi ngʼato, to abiro dak kodi.”<verse eid="HOS 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4"/>Nimar jo-Israel biro dak ndalo mangʼeny ka gionge gi ruoth kata jotelo, ka ok gitim misango maonge kido moro milamo, kata law akor mar dolo miluongo ni efod kata nyiseche manono. <verse eid="HOS 3:4"/><verse number="5" style="v" sid="HOS 3:5"/>To bangʼe jo-Israel biro duogo ka gidwaro Jehova Nyasaye ma Nyasachgi gi Daudi ruodhgi. Ginibi ka gitetni e nyim Jehova Nyasaye kendo e gwethne e ndalo mogik.<verse eid="HOS 3:5"/></para>
  <chapter eid="HOS 3"/>
  <chapter number="4" style="c" sid="HOS 4"/>
  <para style="s1">Bura mondonjnego jo-Israel</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 4:1"/>Winjuru wach Jehova Nyasaye, un jo-Israel,</para>
  <para style="q2" vid="HOS 4:1">nikech Jehova Nyasaye nigi wach modonjonugo,</para>
  <para style="q2" vid="HOS 4:1">un ji modak e piny:</para>
  <para style="q1" vid="HOS 4:1">“Onge adiera, onge hera,</para>
  <para style="q2" vid="HOS 4:1">bende udagi yie ni Nyasaye nitie e piny.<verse eid="HOS 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 4:2"/>Nitie mana kwongʼ, miriambo kod nek,</para>
  <para style="q2" vid="HOS 4:2">kuo gi chode;</para>
  <para style="q1" vid="HOS 4:2">kendo giketho singruok duto,</para>
  <para style="q2" vid="HOS 4:2">kendo chwero remo timore monwore.<verse eid="HOS 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 4:3"/>Nikech ma, piny opongʼ gi kuyo</para>
  <para style="q2" vid="HOS 4:3">kendo ji modak e iye dhero kendo tho;</para>
  <para style="q1" vid="HOS 4:3">ondiegi manie thim gi winy mafuyo e kor polo</para>
  <para style="q2" vid="HOS 4:3">gi rech manie nembe tho.<verse eid="HOS 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 4:4"/>“Kik ngʼato kel wach mar donjo,</para>
  <para style="q2" vid="HOS 4:4">kik ngʼato donjne wadgi,</para>
  <para style="q1" vid="HOS 4:4">nimar jou chalo</para>
  <para style="q2" vid="HOS 4:4">mana ka joma donjo ni jadolo.<verse eid="HOS 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 4:5"/>Uchwanyoru odiechiengʼ gotieno</para>
  <para style="q2" vid="HOS 4:5">to jonabi bende chwanyore mana kaka un.</para>
  <para style="q1" vid="HOS 4:5">Omiyo abiro tieko minu.<verse eid="HOS 4:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 4:6"/>Joga itieko nikech chando ngʼeyo.</para>
  <para style="b" vid="HOS 4:6"/>
  <para style="q1" vid="HOS 4:6">“Nikech utamoru dwaro ngʼeyo,</para>
  <para style="q2" vid="HOS 4:6">an bende adagiu kaka jodolona;</para>
  <para style="q1" vid="HOS 4:6">nikech usejwangʼo chike mag Nyasachu,</para>
  <para style="q2" vid="HOS 4:6">an bende anajwangʼ nyithindu.<verse eid="HOS 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 4:7"/>Kaka jodolo medore,</para>
  <para style="q2" vid="HOS 4:7">e kaka gimedo timo richo e nyima;</para>
  <para style="q2" vid="HOS 4:7">gisewilo duongʼ margi gi gima kelo wichkuot.<verse eid="HOS 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 4:8"/>Giyiengʼ gi richo mag joga,</para>
  <para style="q2" vid="HOS 4:8">bende gimor gi timbegi maricho.<verse eid="HOS 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 4:9"/>Kendo obiro bet ni: Kaka ji chalo e</para>
  <para style="q2" vid="HOS 4:9">kaka jodolo bende chalo.</para>
  <para style="q1" vid="HOS 4:9">To abiro kumogi kuom yoregigo,</para>
  <para style="q2" vid="HOS 4:9">kendo anachulgi machal gi timbegi.<verse eid="HOS 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 4:10"/>“Gibiro chiemo to ok giniyiengʼ;</para>
  <para style="q2" vid="HOS 4:10">gibiro chodo to ok gini nywolre,</para>
  <para style="q1" vid="HOS 4:10">nikech giseweyo Jehova Nyasaye,</para>
  <para style="q2" vid="HOS 4:10">mondo gichiwre <verse eid="HOS 4:10"/><verse number="11" style="v" sid="HOS 4:11"/>ne chode,</para>
  <para style="q1" vid="HOS 4:11">ne kongʼo machon kod kongʼo manyien,</para>
  <para style="q2" vid="HOS 4:11">magolo winjo mar joga.<verse eid="HOS 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 4:12"/>Gipenjo wach kuom nyasaye molos gi bao</para>
  <para style="q2" vid="HOS 4:12">kendo idwokogi gi yien mopa.</para>
  <para style="q1" vid="HOS 4:12">Chuny mar chode terogi mabor;</para>
  <para style="q2" vid="HOS 4:12">ok gin jo-adier ne Nyasachgi.<verse eid="HOS 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 4:13"/>Gitimo misango ewi gode maboyo</para>
  <para style="q2" vid="HOS 4:13">kendo gitimo Sewni kuonde motingʼore gi malo,</para>
  <para style="q1" vid="HOS 4:13">e tiend yiend ober, gi omburi kod yiende mamoko madongo dongo kendo boyo,</para>
  <para style="q2" vid="HOS 4:13">kama otimo tipo maber.</para>
  <para style="q1" vid="HOS 4:13">Emomiyo nyiu lokore ochode</para>
  <para style="q2" vid="HOS 4:13">to mond yawuotu to donjo e chode.<verse eid="HOS 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 4:14"/>“Ok anakum nyiu</para>
  <para style="q2" vid="HOS 4:14">ka gibedo ochode,</para>
  <para style="q1" vid="HOS 4:14">kata mond yawuotu</para>
  <para style="q2" vid="HOS 4:14">ka terore,</para>
  <para style="q1" vid="HOS 4:14">nikech chwo giwegi</para>
  <para style="q2" vid="HOS 4:14">ema dhi ir mon ma jochode,</para>
  <para style="q2" vid="HOS 4:14">gi mon manie hekalu mar Baal.</para>
  <para style="q1" vid="HOS 4:14">Joma onge ngʼeyo</para>
  <para style="q2" vid="HOS 4:14">biro yudo chandruok!<verse eid="HOS 4:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 4:15"/>“Yaye Israel, kata obedo ni utimo anjawo mar chode,</para>
  <para style="q2" vid="HOS 4:15">kik umi Juda donj e timbego.</para>
  <para style="b" vid="HOS 4:15"/>
  <para style="q1" vid="HOS 4:15">“Kik udhi Gilgal;</para>
  <para style="q2" vid="HOS 4:15">kik udhi Beth Aven.</para>
  <para style="q2" vid="HOS 4:15">Kendo kik ukwongʼru kuwacho niya,</para>
  <para style="q1" vid="HOS 4:15">‘Akwongʼora gi nying Jehova Nyasaye mangima!’<verse eid="HOS 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 4:16"/>Jo-Israel wigi tek</para>
  <para style="q2" vid="HOS 4:16">mana ka roya bwongʼ ma wiye tek.</para>
  <para style="q1" vid="HOS 4:16">Ere kaka Jehova Nyasaye nyalo kwayogi e lek</para>
  <para style="q2" vid="HOS 4:16">kaka ikwayo rombe e lek man-gi lum?<verse eid="HOS 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 4:17"/>Jo-Efraim oriwore gi nyiseche manono;</para>
  <para style="q2" vid="HOS 4:17">weyeuru kamano!<verse eid="HOS 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 4:18"/>Kata ka kong-gi orumo,</para>
  <para style="q2" vid="HOS 4:18">to gidhi nyime gi timbegi mag chode;</para>
  <para style="q2" vid="HOS 4:18">jotendgi ohero timbe makelo wichkuot.<verse eid="HOS 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 4:19"/>Kalausi biro tingʼogi matergi mabor,</para>
  <para style="q2" vid="HOS 4:19">kendo misenginigi nokelnegi wichkuot.”<verse eid="HOS 4:19"/></para>
  <chapter eid="HOS 4"/>
  <chapter number="5" style="c" sid="HOS 5"/>
  <para style="s1">Kum ni jo-Israel</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 5:1"/>“Winjuru ma, un jodolo!</para>
  <para style="q2" vid="HOS 5:1">Chikuru itu, un jo-Israel!</para>
  <para style="q1" vid="HOS 5:1">Winjuru, yaye jood ruoth!</para>
  <para style="q2" vid="HOS 5:1">Kumni obironu:</para>
  <para style="q1" vid="HOS 5:1">Usebedo obadho e Mizpa,</para>
  <para style="q2" vid="HOS 5:1">gogo mopedhi ewi Tabor.<verse eid="HOS 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 5:2"/>Joma ongʼanyo ni e tho malich.</para>
  <para style="q2" vid="HOS 5:2">Abiro kumogi giduto.<verse eid="HOS 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 5:3"/>Angʼeyo gik moko duto kuom Efraim;</para>
  <para style="q2" vid="HOS 5:3">onge gima opondona kuom jo-Israel.</para>
  <para style="q1" vid="HOS 5:3">Efraim, un to usedoko kaka ochot;</para>
  <para style="q2" vid="HOS 5:3">to jo-Israel timo timbe modwanyore.<verse eid="HOS 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 5:4"/>“Timbegi omonogi</para>
  <para style="q2" vid="HOS 5:4">duogo ir Nyasachgi.</para>
  <para style="q1" vid="HOS 5:4">Tim marach mar chode ni e chunygi;</para>
  <para style="q2" vid="HOS 5:4">ok giyie kuom Jehova Nyasaye.<verse eid="HOS 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 5:5"/>Sungruok mar jo-Israel nyiso rachgi;</para>
  <para style="q2" vid="HOS 5:5">jo-Israel kaachiel gi Efraim podho e richogi;</para>
  <para style="q2" vid="HOS 5:5">kendo jo-Juda bende podho kodgi.<verse eid="HOS 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 5:6"/>Ka gidhi gi kweth dhogi kaachiel gi chiachgi</para>
  <para style="q2" vid="HOS 5:6">mondo gitim misengni ni Jehova Nyasaye,</para>
  <para style="q1" vid="HOS 5:6">to ok giniyude</para>
  <para style="q2" vid="HOS 5:6">nikech osewuok moa kuomgi.<verse eid="HOS 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 5:7"/>Gisebedo joma ok jo-adiera ni Jehova Nyasaye;</para>
  <para style="q2" vid="HOS 5:7">ginywolo nyithindo ma kimirwa.</para>
  <para style="q1" vid="HOS 5:7">Sewni ma gitimo ka dwe owuok</para>
  <para style="q2" vid="HOS 5:7">biro tiekogi kaachiel gi puothegi.<verse eid="HOS 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 5:8"/>“Gouru turumbete e dala mar Gibea,</para>
  <para style="q2" vid="HOS 5:8">gouru abu e dala mar Rama.</para>
  <para style="q1" vid="HOS 5:8">Gouru nduru mar lweny e dala mar Beth Aven;</para>
  <para style="q2" vid="HOS 5:8">yaye, jo-Benjamin teluru.<verse eid="HOS 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 5:9"/>Efraim biro bet gunda</para>
  <para style="q2" vid="HOS 5:9">ka chiengʼ makumogie ochopo.</para>
  <para style="q1" vid="HOS 5:9">Alando gima nyaka timre</para>
  <para style="q2" vid="HOS 5:9">e kind dhout Israel.<verse eid="HOS 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 5:10"/>Jotend Juda chalo gi joma</para>
  <para style="q2" vid="HOS 5:10">ochoro kite man e kiewo.</para>
  <para style="q1" vid="HOS 5:10">Abiro olo mirimba kuomgi</para>
  <para style="q2" vid="HOS 5:10">mana ka pi oula.<verse eid="HOS 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 5:11"/>Jo-Efraim ibiro toyo</para>
  <para style="q2" vid="HOS 5:11">ka bura oloyogi,</para>
  <para style="q1" vid="HOS 5:11">nikech giketo chunygi mar luwo nyiseche manono.<verse eid="HOS 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 5:12"/>Achalo gi oguyo ne jo-Efraim,</para>
  <para style="q2" vid="HOS 5:12">achalo gima otop ne jo-Juda.<verse eid="HOS 5:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 5:13"/>“Ka Efraim noneno tuone,</para>
  <para style="q2" vid="HOS 5:13">kendo Juda oneno adhondene,</para>
  <para style="q1" vid="HOS 5:13">eka Efraim nodwaro kony kuom Asuria,</para>
  <para style="q2" vid="HOS 5:13">kendo gikwayo kony ir ruoth maduongʼ.</para>
  <para style="q1" vid="HOS 5:13">To ok onyal thiedhou,</para>
  <para style="q2" vid="HOS 5:13">ok onyal thiedho adhondeu.<verse eid="HOS 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 5:14"/>Abiro bedo ka sibuor ni Efraim,</para>
  <para style="q2" vid="HOS 5:14">kaka sibuor malich ni Juda.</para>
  <para style="q1" vid="HOS 5:14">Abiro kidhogi matindo tindo bangʼe to abiro weyogi.</para>
  <para style="q2" vid="HOS 5:14">Anatingʼ-gi matergi mabor,</para>
  <para style="q2" vid="HOS 5:14">maonge ngʼama nyalo resogi.<verse eid="HOS 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 5:15"/>Bangʼe to anadog kar dakna,</para>
  <para style="q2" vid="HOS 5:15">nyaka chop kinde maginiyie ni giseketho.</para>
  <para style="q1" vid="HOS 5:15">Giniduog ira ka gidwara gi chunygi duto</para>
  <para style="q2" vid="HOS 5:15">nikech thagruok malit magiseyudo.”<verse eid="HOS 5:15"/></para>
  <chapter eid="HOS 5"/>
  <chapter number="6" style="c" sid="HOS 6"/>
  <para style="s1">Jo-Israel odagi lokore</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 6:1"/>“Biuru mondo wadog ir Jehova Nyasaye.</para>
  <para style="q1" vid="HOS 6:1">Osekidhowa matindo tindo</para>
  <para style="q2" vid="HOS 6:1">to obiro changowa;</para>
  <para style="q1" vid="HOS 6:1">osehinyowa</para>
  <para style="q2" vid="HOS 6:1">to obiro tweyo adhondewa.<verse eid="HOS 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 6:2"/>Bangʼ ndalo ariyo obiro duogo chunywa</para>
  <para style="q2" vid="HOS 6:2">to e odiechiengʼ mar adek obiro resowa,</para>
  <para style="q2" vid="HOS 6:2">mondo omi wadag kode.<verse eid="HOS 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 6:3"/>Waluonguru Jehova Nyasaye;</para>
  <para style="q2" vid="HOS 6:3">wadhiuru nyime gi luongo nyinge.</para>
  <para style="q1" vid="HOS 6:3">Mana kaka chiengʼ wuok,</para>
  <para style="q2" vid="HOS 6:3">e kaka obiro wuok;</para>
  <para style="q1" vid="HOS 6:3">enobi irwa mana ka kodh chwiri,</para>
  <para style="q2" vid="HOS 6:3">mana ka koth mabiro bangʼ chwiri mamiyo lowo bedo mangʼich.”<verse eid="HOS 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 6:4"/>“Angʼo madatimni Efraim?</para>
  <para style="q2" vid="HOS 6:4">Angʼo ma datim kodi, in Juda?</para>
  <para style="q1" vid="HOS 6:4">Herani chalo gi ongʼwengʼo mar okinyi,</para>
  <para style="q2" vid="HOS 6:4">kata gi thoo mar okinyi malal nono ka nyango tegno.<verse eid="HOS 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 6:5"/>Emomiyo an kaachiel gi jonabi maga wangʼadou matindo tindo,</para>
  <para style="q2" vid="HOS 6:5">ne anegou gi weche mawuok e dhoga;</para>
  <para style="q2" vid="HOS 6:5">buche mane angʼadonu nobiro kuomo mapiyo mana ka mil polo.<verse eid="HOS 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 6:6"/>Nimar adwaro ni ukech joweteu, to ok ni uchiwna misango,</para>
  <para style="q2" vid="HOS 6:6">kendo ngʼeyo Nyasaye ber moloyo misengini miwangʼo pep.<verse eid="HOS 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 6:7"/>Mana kaka Adam, giseketho singruok mane atimo kodgi,</para>
  <para style="q2" vid="HOS 6:7">ne ok gibedo jo-adier koda e ndalono.<verse eid="HOS 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 6:8"/>Gilead en dala machwo ma jo-mahundu odakie,</para>
  <para style="q2" vid="HOS 6:8">en dala mosechwerie remb ji.<verse eid="HOS 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 6:9"/>Jodolo chalo mana gi jomecho</para>
  <para style="q2" vid="HOS 6:9">ma pondo ne ji e dir yo,</para>
  <para style="q1" vid="HOS 6:9">ka girito ngʼat makadho</para>
  <para style="q2" vid="HOS 6:9">mondo gima.</para>
  <para style="q1" vid="HOS 6:9">Gineko e yo madhi Shekem,</para>
  <para style="q2" vid="HOS 6:9">gitimo timbe mahundu makwodo wich.<verse eid="HOS 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 6:10"/>Aseneno gima lich</para>
  <para style="q2" vid="HOS 6:10">e od Israel.</para>
  <para style="q1" vid="HOS 6:10">Kanyo Efraim osechiwore ne chode</para>
  <para style="q2" vid="HOS 6:10">kendo Israel osedwanyore.<verse eid="HOS 6:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 6:11"/>“To un bende jo-Juda</para>
  <para style="q2" vid="HOS 6:11">kinde ma ingʼadonue bura osechopo.</para>
  <para style="b" vid="HOS 6:11"/>
  <para style="q1" vid="HOS 6:11">“Abiro gwedho ogandana e kinde manaduogie ka gia e twech,<verse eid="HOS 6:11"/></para>
  <chapter eid="HOS 6"/>
  <chapter number="7" style="c" sid="HOS 7"/>
  <para style="q2">
    <verse number="1" style="v" sid="HOS 7:1"/>e kinde ka kinde madwaro changoe Israel,</para>
  <para style="q1" vid="HOS 7:1">to richo mag Efraim elore</para>
  <para style="q2" vid="HOS 7:1">kendo timbe mahundu mag Samaria fwenyore.</para>
  <para style="q1" vid="HOS 7:1">Gihero wacho miriambo,</para>
  <para style="q2" vid="HOS 7:1">jokwoge turo udi,</para>
  <para style="q2" vid="HOS 7:1">jonjore mayo ji e yore;<verse eid="HOS 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 7:2"/>to ok gisefwenyo</para>
  <para style="q2" vid="HOS 7:2">ni aparo timbegi duto maricho.</para>
  <para style="q1" vid="HOS 7:2">Richogi oduodogi,</para>
  <para style="q2" vid="HOS 7:2">kendo ni e wangʼa ndalo duto.<verse eid="HOS 7:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 7:3"/>“Gimoro ruoth gi timbegi marichogo,</para>
  <para style="q2" vid="HOS 7:3">yawuot ruoth bende gimiyo mor gi miriambo.<verse eid="HOS 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 7:4"/>Giduto gin joma terore,</para>
  <para style="q2" vid="HOS 7:4">giore ka kendo,</para>
  <para style="q1" vid="HOS 7:4">ma jated makati oweyo chwaloe mach</para>
  <para style="q2" vid="HOS 7:4">nyaka otiek dwelo mi makati kuodi moromo tedo.<verse eid="HOS 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 7:5"/>E odiechiengʼ mar nyasi ruodhwa</para>
  <para style="q2" vid="HOS 7:5">yawuot ruoth madho divai mamer,</para>
  <para style="q2" vid="HOS 7:5">mi riw lwetgi gi jo-ajara.<verse eid="HOS 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 7:6"/>Chunygi chalo gi kendo,</para>
  <para style="q2" vid="HOS 7:6">gidhi ire ka gisechano timo timbe mochido.</para>
  <para style="q1" vid="HOS 7:6">Gombogi liet ka maa otieno,</para>
  <para style="q2" vid="HOS 7:6">kochopo okinyi to omuoch ka mach maliel.<verse eid="HOS 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 7:7"/>Giduto giliet ka kendo,</para>
  <para style="q2" vid="HOS 7:7">gikidho jotendgi.</para>
  <para style="q1" vid="HOS 7:7">Ruodhigi bende gitieko,</para>
  <para style="q2" vid="HOS 7:7">to onge ngʼato kuomgi maluonga.<verse eid="HOS 7:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 7:8"/>“Efraim riwore gi ogendini,</para>
  <para style="q2" vid="HOS 7:8">kendo ochalo gi makati ma ok okuot.<verse eid="HOS 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 7:9"/>Ogendini tieko tekone,</para>
  <para style="q2" vid="HOS 7:9">to ok ofweny.</para>
  <para style="q1" vid="HOS 7:9">Lwar okuorore e yie wiye,</para>
  <para style="q2" vid="HOS 7:9">to ok ongʼeyo.<verse eid="HOS 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 7:10"/>Tok teko mar jo-Israel bedonegi janeno ka ngʼadonegi bura,</para>
  <para style="q2" vid="HOS 7:10">to kata magi duto timorene,</para>
  <para style="q1" vid="HOS 7:10">to ok oduogi ir Jehova Nyasaye ma Nyasache,</para>
  <para style="q2" vid="HOS 7:10">kata mana manye.<verse eid="HOS 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 7:11"/>“Efraim chalo kaka akuch odugla</para>
  <para style="q2" vid="HOS 7:11">mawuondo yot kendo mofuwo,</para>
  <para style="q1" vid="HOS 7:11">giluongo Misri</para>
  <para style="q2" vid="HOS 7:11">to gilokore gidhi Asuria.<verse eid="HOS 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 7:12"/>Ka gidhi, to abiro bolo goka kuomgi;</para>
  <para style="q2" vid="HOS 7:12">analwargi piny ka winy mafuyo malo.</para>
  <para style="q1" vid="HOS 7:12">Ka anenogi ka gichokore kanyakla,</para>
  <para style="q2" vid="HOS 7:12">to anamakgi duto.<verse eid="HOS 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 7:13"/>Okwongʼ-gi,</para>
  <para style="q2" vid="HOS 7:13">nikech gisebedo mabor koda!</para>
  <para style="q1" vid="HOS 7:13">Kethruok ne gin,</para>
  <para style="q2" vid="HOS 7:13">nikech gisekweda!</para>
  <para style="q1" vid="HOS 7:13">Asedwaro mondo aduog-gi ira</para>
  <para style="q2" vid="HOS 7:13">to giriambo kuoma.<verse eid="HOS 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 7:14"/>Ok giywagna koa e chunygi</para>
  <para style="q2" vid="HOS 7:14">makmana gidengo e kitendinigi.</para>
  <para style="q1" vid="HOS 7:14">Gichokore kanyakla ne cham kod divai manyien</para>
  <para style="q2" vid="HOS 7:14">to giringo gijwangʼa.<verse eid="HOS 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 7:15"/>Ne atiegogi ma amiyo gibedo motegno</para>
  <para style="q2" vid="HOS 7:15">to gichano gik maricho kuoma.<verse eid="HOS 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 7:16"/>Gitamore duogo ir Nyasaye Man Malo Moloyo;</para>
  <para style="q2" vid="HOS 7:16">gichalo atungʼ ma ok nyal tigo.</para>
  <para style="q1" vid="HOS 7:16">Jotendgi noneg gi ligangla</para>
  <para style="q2" vid="HOS 7:16">nikech wechegi mag nyadhi.</para>
  <para style="q1" vid="HOS 7:16">Kuom mano nojargi</para>
  <para style="q2" vid="HOS 7:16">e piny Misri.”<verse eid="HOS 7:16"/></para>
  <chapter eid="HOS 7"/>
  <chapter number="8" style="c" sid="HOS 8"/>
  <para style="s1">Jo-Israel biro kayo kalausi</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 8:1"/>“Ket turumbete e dhogi mondo igo!</para>
  <para style="q2" vid="HOS 8:1">Ongo ni ewi od Jehova Nyasaye,</para>
  <para style="q1" vid="HOS 8:1">nikech ji oseketho singruokna</para>
  <para style="q2" vid="HOS 8:1">kendo gisekwedo chikna.<verse eid="HOS 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 8:2"/>Jo-Israel noywakna niya,</para>
  <para style="q2" vid="HOS 8:2">‘Yaye Nyasachwa, wayangi!’<verse eid="HOS 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 8:3"/>To wasigu biro lawo Israel</para>
  <para style="q2" vid="HOS 8:3">nikech gisekwedo gima ber.<verse eid="HOS 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 8:4"/>Giketo ruodhi e loch ka ok gipenja;</para>
  <para style="q2" vid="HOS 8:4">kendo giyiero jotelo ka ok gingʼeyo parona.</para>
  <para style="q1" vid="HOS 8:4">Giloso nyiseche manono</para>
  <para style="q2" vid="HOS 8:4">kuom fedha gi dhahabu ma gin-go,</para>
  <para style="q2" vid="HOS 8:4">to magi kelonegi mana kethruok.<verse eid="HOS 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 8:5"/>Yaye Samaria, wit oko nyasachi mar nyaroya!</para>
  <para style="q2" vid="HOS 8:5">Mirimba ger kodgi.</para>
  <para style="q1" vid="HOS 8:5">Nyaka karangʼo ma ok ginyal bedo maler?<verse eid="HOS 8:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 8:6"/>Gin joma oa Israel!</para>
  <para style="q1" vid="HOS 8:6">Nyaroyani oselos mana gi lwet dhano omiyo</para>
  <para style="q2" vid="HOS 8:6">ok en Nyasaye.</para>
  <para style="q1" vid="HOS 8:6">Nyaroya mar Samaria-no</para>
  <para style="q2" vid="HOS 8:6">noto matindo tindo.<verse eid="HOS 8:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 8:7"/>“Gichwoyo yamo</para>
  <para style="q2" vid="HOS 8:7">to gikayo kalausi.</para>
  <para style="q1" vid="HOS 8:7">Gin gi cham ma ok ket wiye;</para>
  <para style="q2" vid="HOS 8:7">kendo ok onyal kelo mogo.</para>
  <para style="q1" vid="HOS 8:7">To kane onyalo nyago cham,</para>
  <para style="q2" vid="HOS 8:7">to jopinje mamoko dochame duto.<verse eid="HOS 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 8:8"/>Israel osetiek duto;</para>
  <para style="q2" vid="HOS 8:8">kendo sani en e kind ogendini,</para>
  <para style="q2" vid="HOS 8:8">mana kaka gima nono.<verse eid="HOS 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 8:9"/>Gisedhi nyaka Asuria</para>
  <para style="q2" vid="HOS 8:9">mana kaka kanyna mar bungu mabayo abaya.</para>
  <para style="q2" vid="HOS 8:9">Efraim oseusore ne joherane.<verse eid="HOS 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 8:10"/>Kata obedo ni giseusore kendgi e kind ogendini,</para>
  <para style="q2" vid="HOS 8:10">abiro chokogi kaachiel.</para>
  <para style="q1" vid="HOS 8:10">Gibiro lal nono</para>
  <para style="q2" vid="HOS 8:10">kendo enosandgi e bwo loch mar ruoth maratego.<verse eid="HOS 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 8:11"/>“Kata ka obedo ni Efraim nogero kende mangʼeny mag misango mar golo richo,</para>
  <para style="q2" vid="HOS 8:11">kendegi osebedo mar timo richo.<verse eid="HOS 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 8:12"/>Ne andiko negi gik mangʼeny mag chikena,</para>
  <para style="q2" vid="HOS 8:12">to ne gikawogi kaka gigo ma welo kuomgi.<verse eid="HOS 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 8:13"/>Gichiwo misengni mokelna</para>
  <para style="q2" vid="HOS 8:13">kendo gichamo ring misenginigo,</para>
  <para style="q2" vid="HOS 8:13">to Jehova Nyasaye ok mor kodgi.</para>
  <para style="q1" vid="HOS 8:13">Omiyo sani obiro paro anjawo ma gitimo</para>
  <para style="q2" vid="HOS 8:13">kendo enokumgi kuom richogi.</para>
  <para style="q2" vid="HOS 8:13">Ginidogi Misri.<verse eid="HOS 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 8:14"/>Jo-Israel wigi osewil gi Jachwechgi,</para>
  <para style="q2" vid="HOS 8:14">mi gigero ute mag ruodhi;</para>
  <para style="q2" vid="HOS 8:14">Juda osechielo mier madongo mangʼeny.</para>
  <para style="q1" vid="HOS 8:14">To anaor mach e miechgi madongogo</para>
  <para style="q2" vid="HOS 8:14">mitiek kargi mar pondono.”<verse eid="HOS 8:14"/></para>
  <chapter eid="HOS 8"/>
  <chapter number="9" style="c" sid="HOS 9"/>
  <para style="s1">Kum ne jo-Israel</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 9:1"/>Kik umor, yaye Israel;</para>
  <para style="q2" vid="HOS 9:1">bende kik ubed gi ilo kaka ogendini mamoko.</para>
  <para style="q1" vid="HOS 9:1">Nimar ok usebedo jo-adiera ne Nyasachu;</para>
  <para style="q2" vid="HOS 9:1">usehero chudo mar ochot michulougo,</para>
  <para style="q2" vid="HOS 9:1">e kuonde dino cham.<verse eid="HOS 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 9:2"/>Kuonde ma idinoe cham kod kuonde mibiyoe divai ok nopidh ji;</para>
  <para style="q2" vid="HOS 9:2">kendo divai manyien ok nokonygi.<verse eid="HOS 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 9:3"/>Ok ginidongʼ e piny Jehova Nyasaye;</para>
  <para style="q2" vid="HOS 9:3">Efraim nodog Misri,</para>
  <para style="q2" vid="HOS 9:3">kendo ginicham chiemo ma ok opwodhi e piny Asuria.<verse eid="HOS 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 9:4"/>Ok gini olne Jehova Nyasaye misango mar divai,</para>
  <para style="q2" vid="HOS 9:4">bende misengini ma gichiwo ok nomor Jehova Nyasaye ngangʼ.</para>
  <para style="q1" vid="HOS 9:4">Misengini machalo kamano nochal negi mana kaka chiemb joma ywak;</para>
  <para style="q2" vid="HOS 9:4">kendo jogo mochamogi nobed mogak.</para>
  <para style="q1" vid="HOS 9:4">Chiemoni nobed margi giwegi;</para>
  <para style="q2" vid="HOS 9:4">omiyo ok nokele e hekalu mar Jehova Nyasaye.<verse eid="HOS 9:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 9:5"/>Unutim angʼo e odiechiengu mowal mar nyasi,</para>
  <para style="q2" vid="HOS 9:5">kata ka odiechienge nyasi mar Jehova Nyasaye ochopo?<verse eid="HOS 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 9:6"/>Kata ka gitony e kethruok,</para>
  <para style="q2" vid="HOS 9:6">Misri nochokgi,</para>
  <para style="q2" vid="HOS 9:6">kendo Memfis noikgi.</para>
  <para style="q1" vid="HOS 9:6">Mwandu mag fedha noum gi pedo</para>
  <para style="q2" vid="HOS 9:6">kendo kuthe noum hembegi.<verse eid="HOS 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 9:7"/>Kinde mag kum biro</para>
  <para style="q2" vid="HOS 9:7">kendo kinde mag ngʼado bura osechopo.</para>
  <para style="q2" vid="HOS 9:7">Omiyo jo-Israel nyaka ngʼe wachni.</para>
  <para style="q1" vid="HOS 9:7">Nikech richou ngʼeny</para>
  <para style="q2" vid="HOS 9:7">kendo kinyou lich miwuoro,</para>
  <para style="q1" vid="HOS 9:7">janabi ikwano ka ngʼama ofuwo,</para>
  <para style="q2" vid="HOS 9:7">to ngʼat matiyo gi much Nyasaye ka janeko.<verse eid="HOS 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 9:8"/>Janabi, kaachiel gi Nyasacha</para>
  <para style="q2" vid="HOS 9:8">e jarit mar Efraim,</para>
  <para style="q1" vid="HOS 9:8">kata kamano obadho rite e yorene duto,</para>
  <para style="q2" vid="HOS 9:8">kendo akweda bende rite e od Nyasache.<verse eid="HOS 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 9:9"/>Gisedonjo matut e timbe mag miganga</para>
  <para style="q2" vid="HOS 9:9">mana ka ndalo mag Gibea.</para>
  <para style="q1" vid="HOS 9:9">Nyasaye nopar timbegi mamono</para>
  <para style="q2" vid="HOS 9:9">kendo enokumgi e richogi.<verse eid="HOS 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 9:10"/>“Kane ayudo Israel</para>
  <para style="q2" vid="HOS 9:10">ne ochalo mana kayudo olemb mzabibu e piny motwo,</para>
  <para style="q1" vid="HOS 9:10">kane aneno kwereu,</para>
  <para style="q2" vid="HOS 9:10">ne chalo mana ka gima aneno olemo monyak mokwongo mar ngʼowu.</para>
  <para style="q1" vid="HOS 9:10">To kane gibiro Baal Peor,</para>
  <para style="q2" vid="HOS 9:10">negichiwore lamo nyiseche manono makwodo wich,</para>
  <para style="q2" vid="HOS 9:10">kendo negibedo modwanyore mana ka gima ne giherono.<verse eid="HOS 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 9:11"/>Duongʼ mar Efraim noweye mana ka winyo ma huyo mi lal nono,</para>
  <para style="q2" vid="HOS 9:11">omiyo ok ginichak ginywol nyithindo,</para>
  <para style="q2" vid="HOS 9:11">mondegi ok nobed ma yach kendo onge nyathi manomak ichne.<verse eid="HOS 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 9:12"/>Kata ka gipidho nyithindo,</para>
  <para style="q2" vid="HOS 9:12">to namigi gibed gi kuyo kuom moro ka moro.</para>
  <para style="q1" vid="HOS 9:12">Okwongʼ-gi,</para>
  <para style="q2" vid="HOS 9:12">ka alokora mi ajwangʼogi!<verse eid="HOS 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 9:13"/>Aseneno Efraim, mana kaka ne aneno Turo,</para>
  <para style="q2" vid="HOS 9:13">ka opidhi kama omiyo,</para>
  <para style="q1" vid="HOS 9:13">to Efraim nokel nyithinde</para>
  <para style="q2" vid="HOS 9:13">ni janek.”<verse eid="HOS 9:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 9:14"/>Chiwnegi, yaye Jehova Nyasaye,</para>
  <para style="q2" vid="HOS 9:14">en angʼo ma dimigi?</para>
  <para style="q1" vid="HOS 9:14">Migi mana iye magore piny</para>
  <para style="q2" vid="HOS 9:14">kendo thunde motwo.<verse eid="HOS 9:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 9:15"/>“Nikech timbegi mag anjawo e Gilgal,</para>
  <para style="q2" vid="HOS 9:15">ne ok aherogi kanyo.</para>
  <para style="q1" vid="HOS 9:15">Nikech timbegi mag richo,</para>
  <para style="q2" vid="HOS 9:15">abiro riembgi oko e oda.</para>
  <para style="q1" vid="HOS 9:15">Ok anachak ahergi;</para>
  <para style="q2" vid="HOS 9:15">jotendgi duto gin joma timbegi richo.<verse eid="HOS 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 9:16"/>Midekre osemako Efraim,</para>
  <para style="q2" vid="HOS 9:16">kendo tiendene ner,</para>
  <para style="q2" vid="HOS 9:16">ok ginyag olemo.</para>
  <para style="q1" vid="HOS 9:16">Kata ka ginywolo nyithindo,</para>
  <para style="q2" vid="HOS 9:16">to ananeg nyithindgi ma gihero ahinyago.”<verse eid="HOS 9:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 9:17"/>Nyasacha nokwedgi</para>
  <para style="q2" vid="HOS 9:17">nikech ok gisewinje,</para>
  <para style="q2" vid="HOS 9:17">ginibedi joma tangni e dier ogendini.<verse eid="HOS 9:17"/></para>
  <para style="b"/>
  <chapter eid="HOS 9"/>
  <chapter number="10" style="c" sid="HOS 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 10:1"/>Israel ne en mzabibu malandore;</para>
  <para style="q2" vid="HOS 10:1">ne onyago olembene owuon.</para>
  <para style="q1" vid="HOS 10:1">Ka olembene ne medore,</para>
  <para style="q2" vid="HOS 10:1">nomedo gero kende mag misango;</para>
  <para style="q1" vid="HOS 10:1">kendo ka pinye ne medo mewo,</para>
  <para style="q2" vid="HOS 10:1">to nomedo loso kido milamo.<verse eid="HOS 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 10:2"/>Chunygi opongʼ gi miriambo</para>
  <para style="q2" vid="HOS 10:2">kendo koro nyaka gitingʼ mana kum marom kodgi.</para>
  <para style="q1" vid="HOS 10:2">Jehova Nyasaye nomuk kendegi mag misango</para>
  <para style="q2" vid="HOS 10:2">kendo kitegi ma gilamo bende nokethi.<verse eid="HOS 10:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 10:3"/>Eka giniwachi, “Waonge ruoth</para>
  <para style="q2" vid="HOS 10:3">nikech watamore miyo Jehova Nyasaye luor.</para>
  <para style="q1" vid="HOS 10:3">To kata kane wan gi ruoth,</para>
  <para style="q2" vid="HOS 10:3">to dotimonwa angʼo?”<verse eid="HOS 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 10:4"/>Githoro wacho weche manono</para>
  <para style="q2" vid="HOS 10:4">ka gikwongʼore gi miriambo,</para>
  <para style="q2" vid="HOS 10:4">kendo giloso winjruok ma ok nyal konyogi;</para>
  <para style="q1" vid="HOS 10:4">emomiyo buche mag larruok medore</para>
  <para style="q2" vid="HOS 10:4">mana ka buya malandore e puothe mosepur.<verse eid="HOS 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 10:5"/>Ji modak Samaria luoro osemako</para>
  <para style="q2" vid="HOS 10:5">nikech nyaroya molos gi dhahabu mar Beth Aven.</para>
  <para style="q1" vid="HOS 10:5">Joge noywage,</para>
  <para style="q2" vid="HOS 10:5">kamano bende e kaka jodologe malamo nyiseche manono noywage,</para>
  <para style="q1" vid="HOS 10:5">mago mosebedo gi mor kuom berne</para>
  <para style="q2" vid="HOS 10:5">nikech osegole kuomgi kitere e twech.<verse eid="HOS 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 10:6"/>Enotingʼe kitere Asuria</para>
  <para style="q2" vid="HOS 10:6">kaka mich ne ruoth maduongʼ.</para>
  <para style="q1" vid="HOS 10:6">Efraim noma duongʼne to Israel nokuod wiye</para>
  <para style="q2" vid="HOS 10:6">nikech nyisechene molos gi bao.<verse eid="HOS 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 10:7"/>Samaria kod ruodhige nolew gi malo</para>
  <para style="q2" vid="HOS 10:7">mana ka bad yien malewo gi malo ewi pi.<verse eid="HOS 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 10:8"/>Kuonde motingʼore malo mag anjawo nokethi,</para>
  <para style="q2" vid="HOS 10:8">en emomiyo jo-Israel timo richo.</para>
  <para style="q1" vid="HOS 10:8">Kuthe kod buya ema biro dongo</para>
  <para style="q2" vid="HOS 10:8">maim kendegi mag misango.</para>
  <para style="q1" vid="HOS 10:8">Eka giniwach ne gode madongo niya, “Umwauru!”</para>
  <para style="q2" vid="HOS 10:8">Kendo ne gode matindo niya, “Rwombreuru kuomwa!”<verse eid="HOS 10:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 10:9"/>“Nyaka aa ndalo mar Gibea,</para>
  <para style="q2" vid="HOS 10:9">isebedo ka itimo richo, yaye Israel,</para>
  <para style="q2" vid="HOS 10:9">to kanyo ema isesike.</para>
  <para style="q1" vid="HOS 10:9">Donge lweny notieko</para>
  <para style="q2" vid="HOS 10:9">jotim richo man Gibea?<verse eid="HOS 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 10:10"/>Ka ahero to abiro kumogi;</para>
  <para style="q2" vid="HOS 10:10">ogendini nonywaknegi,</para>
  <para style="q2" vid="HOS 10:10">maketgi e twech kuom richogi duto.<verse eid="HOS 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 10:11"/>Efraim en nyaroya mobo</para>
  <para style="q2" vid="HOS 10:11">mohero dino cham;</para>
  <para style="q1" vid="HOS 10:11">omiyo anatwe jok</para>
  <para style="q2" vid="HOS 10:11">e ngʼute maberno.</para>
  <para style="q1" vid="HOS 10:11">Anariemb Efraim,</para>
  <para style="q2" vid="HOS 10:11">to Juda nyaka pur,</para>
  <para style="q2" vid="HOS 10:11">kendo Jakobo biro baro lowo.<verse eid="HOS 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 10:12"/>Chwouru adiera ne un uwegi,</para>
  <para style="q2" vid="HOS 10:12">kaa-uru olemo mar hera ma ok rum,</para>
  <para style="q1" vid="HOS 10:12">kendo baruru lopu mapok opur,</para>
  <para style="q2" vid="HOS 10:12">nimar en kinde mar manyo Jehova Nyasaye,</para>
  <para style="q1" vid="HOS 10:12">nyaka chop</para>
  <para style="q2" vid="HOS 10:12">ool tim makare kuomu.<verse eid="HOS 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 10:13"/>To nikech usechwoyo anjawo,</para>
  <para style="q2" vid="HOS 10:13">usekayo timbe maricho,</para>
  <para style="q2" vid="HOS 10:13">kendo usechamo olemb miriambo.</para>
  <para style="q1" vid="HOS 10:13">Nikech usegeno kuom tekou uwegi</para>
  <para style="q2" vid="HOS 10:13">kendo kuom jolwenju mangʼeny,<verse eid="HOS 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 10:14"/>kuom mano koko mar lweny biro monjo jou,</para>
  <para style="q2" vid="HOS 10:14">ma mi kuondeu mochiel motegno nomuki,</para>
  <para style="q1" vid="HOS 10:14">mana kaka Shalman nomuko Beth Arbel e odiechieng lweny,</para>
  <para style="q2" vid="HOS 10:14">kama mine kod nyithindgi nodhir mopodho.<verse eid="HOS 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 10:15"/>Ma e kaka notimre ne un bende, yaye Bethel,</para>
  <para style="q2" vid="HOS 10:15">nikech anjawo maru duongʼ.</para>
  <para style="q1" vid="HOS 10:15">Ka odiechiengno ochopo,</para>
  <para style="q2" vid="HOS 10:15">ruodh Israel notiek chuth.”<verse eid="HOS 10:15"/></para>
  <chapter eid="HOS 10"/>
  <chapter number="11" style="c" sid="HOS 11"/>
  <para style="s1">Hera ma Nyasaye oherogo Israel</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 11:1"/>“Ka Israel ne pod nyathi, ne ahere,</para>
  <para style="q2" vid="HOS 11:1">kendo ne aluongo wuoda ka agolo Misri.<verse eid="HOS 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 11:2"/>To kaka ne amedo luongo Israel</para>
  <para style="q2" vid="HOS 11:2">e kaka nomedo dhi mabor koda.</para>
  <para style="q1" vid="HOS 11:2">Negichiwo misengini ne Baal</para>
  <para style="q2" vid="HOS 11:2">kendo wangʼo ubani ne kido molosi.<verse eid="HOS 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 11:3"/>An owuon ema napuonjo Efraim wuotho,</para>
  <para style="q2" vid="HOS 11:3">ka amakogi gi bedegi,</para>
  <para style="q1" vid="HOS 11:3">to ne ok gifwenyo ni ne en</para>
  <para style="q2" vid="HOS 11:3">An mane ochangogi.<verse eid="HOS 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 11:4"/>Ne atelonegi gi ngʼwono mathoth</para>
  <para style="q2" vid="HOS 11:4">kaachiel gihera ma ok rum;</para>
  <para style="q1" vid="HOS 11:4">ne agolo jok mapek e ngʼutgi</para>
  <para style="q2" vid="HOS 11:4">kendo akulora piny mondo apidhgi.<verse eid="HOS 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 11:5"/>“Donge ginidog Misri</para>
  <para style="q2" vid="HOS 11:5">kendo Asuria nobedi gi loch kuomgi,</para>
  <para style="q2" vid="HOS 11:5">nikech gitamore weyo richogi?<verse eid="HOS 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 11:6"/>Ligangla nomil e miechgi madongo</para>
  <para style="q2" vid="HOS 11:6">manoketh lodi mag rangeyegi,</para>
  <para style="q2" vid="HOS 11:6">kendo chenro duto magin-go norum.<verse eid="HOS 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 11:7"/>Joga oramo chuth mondo oweya.</para>
  <para style="q2" vid="HOS 11:7">Kata giluong Nyasaye Man Malo Moloyo,</para>
  <para style="q2" vid="HOS 11:7">to ok notingʼ-gi malo e yo moro amora.<verse eid="HOS 11:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 11:8"/>“Ere kaka anyalo jwangʼou, Efraim?</para>
  <para style="q2" vid="HOS 11:8">Ere kaka dabolu Israel?</para>
  <para style="q1" vid="HOS 11:8">Ere kaka datiu ka Adma?</para>
  <para style="q2" vid="HOS 11:8">Ere kaka damiu ubed machal gi Zeboim?</para>
  <para style="q1" vid="HOS 11:8">Ok anyal timonu kamano;</para>
  <para style="q2" vid="HOS 11:8">nikech aseloko pacha kendo akechou.<verse eid="HOS 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 11:9"/>Ok anaol mirimba mager</para>
  <para style="q2" vid="HOS 11:9">bende ok analokra mi aketh Efraim bende.</para>
  <para style="q1" vid="HOS 11:9">Nimar an Nyasaye, ok an dhano,</para>
  <para style="q2" vid="HOS 11:9">Jal Maler e dieru.</para>
  <para style="q2" vid="HOS 11:9">Ok anabi gi mirima.<verse eid="HOS 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 11:10"/>Gibiro luwo Jehova Nyasaye,</para>
  <para style="q2" vid="HOS 11:10">noruti ka sibuor.</para>
  <para style="q1" vid="HOS 11:10">Kuruto,</para>
  <para style="q2" vid="HOS 11:10">to nyithinde duto nobi ire katetni kagiwuok yo podho chiengʼ.<verse eid="HOS 11:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 11:11"/>Ginibi ire ka gitetni</para>
  <para style="q2" vid="HOS 11:11">ka winy moa Misri,</para>
  <para style="q2" vid="HOS 11:11">ka akuche moa Asuria.</para>
  <para style="q1" vid="HOS 11:11">Anami gibed e miechgi,”</para>
  <para style="q2" vid="HOS 11:11">Jehova Nyasaye owacho.<verse eid="HOS 11:11"/></para>
  <para style="s1">Richo jo-Israel</para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 11:12"/>Efraim oselwora gi miriambo,</para>
  <para style="q2" vid="HOS 11:12">od jo-Israel en kar wuond.</para>
  <para style="q1" vid="HOS 11:12">Juda ok winj Nyasaye;</para>
  <para style="q2" vid="HOS 11:12">adier ok giwinj Jal Maler ma ja-adiera.<verse eid="HOS 11:12"/></para>
  <chapter eid="HOS 11"/>
  <chapter number="12" style="c" sid="HOS 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 12:1"/>Efraim geno gima onge,</para>
  <para style="q2" vid="HOS 12:1">olawo yamb wuok chiengʼ odiechiengʼ duto,</para>
  <para style="q2" vid="HOS 12:1">kendo omedo miriambo kod gero.</para>
  <para style="q1" vid="HOS 12:1">Oketo winjruok gi Asuria</para>
  <para style="q2" vid="HOS 12:1">kendo ooro mor zeituni ne jo-Misri.<verse eid="HOS 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 12:2"/>Jehova Nyasaye nigi bura kuom jo-Juda;</para>
  <para style="q2" vid="HOS 12:2">enokum Jakobo kaluwore gi yorene;</para>
  <para style="q2" vid="HOS 12:2">kendo enochule kaluwore gi timbene.<verse eid="HOS 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 12:3"/>Kane pod en ei min nomako tiend owadgi,</para>
  <para style="q2" vid="HOS 12:3">kaka dhano nomako amen gi Nyasaye.<verse eid="HOS 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 12:4"/>Ne oii gi malaika mi oloye;</para>
  <para style="q2" vid="HOS 12:4">eka noywak kendo kwayo mondo otimne ngʼwono.</para>
  <para style="q1" vid="HOS 12:4">Noyude Bethel</para>
  <para style="q2" vid="HOS 12:4">kendo mowuoyo kode kanyo.<verse eid="HOS 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 12:5"/>Jehova Nyasaye Maratego,</para>
  <para style="q2" vid="HOS 12:5">Jehova Nyasaye e nyinge mongʼerego!<verse eid="HOS 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 12:6"/>To nyaka uduog ir Nyasachu;</para>
  <para style="q2" vid="HOS 12:6">beduru johera kendo joma ngʼado bura makare,</para>
  <para style="q2" vid="HOS 12:6">bende keturu chunyu kuom Nyasachu kinde duto.<verse eid="HOS 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 12:7"/>Jalok ohala tiyo gi ratinde mag miriambo;</para>
  <para style="q2" vid="HOS 12:7">ohero mecho.<verse eid="HOS 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 12:8"/>Efraim sungore kawacho ni,</para>
  <para style="q2" vid="HOS 12:8">“An jamoko momewo, kendo asebedo ja-mwandu.</para>
  <para style="q1" vid="HOS 12:8">Gi mwanduna duto ok giniyud gimoro kuoma</para>
  <para style="q2" vid="HOS 12:8">ma miganga kata richo.”<verse eid="HOS 12:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 12:9"/>“An Jehova Nyasaye Nyasachu mane ogolou e piny Misri,</para>
  <para style="q2" vid="HOS 12:9">anami udagi e hembeu kendo,</para>
  <para style="q1" vid="HOS 12:9">mana kaka ndalo</para>
  <para style="q2" vid="HOS 12:9">mane utimoe nyasi mag sawo mau.<verse eid="HOS 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 12:10"/>Ne awuoyo kod jonabi,</para>
  <para style="q2" vid="HOS 12:10">ka anyisogi fweny mangʼeny,</para>
  <para style="q2" vid="HOS 12:10">kendo kawacho ngeche kokalo kuomgi.”<verse eid="HOS 12:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 12:11"/>Bende Gilead nigi anjawo?</para>
  <para style="q2" vid="HOS 12:11">Joge gin joma nono!</para>
  <para style="q1" vid="HOS 12:11">Bende gitimo misengini gi rwedhi, Gilgal?</para>
  <para style="q2" vid="HOS 12:11">Kendegi mag misengini biro chalo,</para>
  <para style="q2" vid="HOS 12:11">kaka kite modhurore e puodho mopur.<verse eid="HOS 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 12:12"/>Jakobo noringo modhi e piny mar Aram;</para>
  <para style="q2" vid="HOS 12:12">Israel notiyo mondo oyud dhako,</para>
  <para style="q2" vid="HOS 12:12">kendo nochulo nengo mare kokwayo rombe.<verse eid="HOS 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 12:13"/>Jehova Nyasaye nokonyore gi janabi ma ogolo Israel oa Misri,</para>
  <para style="q2" vid="HOS 12:13">adier ne ooro janabi mondo orite.<verse eid="HOS 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 12:14"/>To Efraim osemiye obedo mager mobedo gi mirima;</para>
  <para style="q2" vid="HOS 12:14">Ruodhe nowe timbene maricho mag chwero remo e wiye,</para>
  <para style="q2" vid="HOS 12:14">kendo nochule kuom ngʼanyone.<verse eid="HOS 12:14"/></para>
  <chapter eid="HOS 12"/>
  <chapter number="13" style="c" sid="HOS 13"/>
  <para style="s1">Mirimb Jehova Nyasaye kuom jo-Israel</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 13:1"/>Kane Efraim owuoyo, to ji ne tetni,</para>
  <para style="q2" vid="HOS 13:1">nodhiale e piny Israel.</para>
  <para style="q2" vid="HOS 13:1">To notimo richo kuom lamo Baal, mi notho.<verse eid="HOS 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 13:2"/>Koro gimedo timo richo,</para>
  <para style="q2" vid="HOS 13:2">bende giloso nyisechegi mag fedha mondo gilam,</para>
  <para style="q1" vid="HOS 13:2">ma gin kido molos gi rieko mangʼeny,</para>
  <para style="q2" vid="HOS 13:2">magi duto gin tich jopa bepe.</para>
  <para style="q1" vid="HOS 13:2">Wachore kuom jogi niya,</para>
  <para style="q2" vid="HOS 13:2">“Gitimo misango gi dhano,</para>
  <para style="q2" vid="HOS 13:2">kendo ginyodho kido molos mar nyaroya.”<verse eid="HOS 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 13:3"/>Emomiyo ginichal mana kaka ongʼwengʼo mokinyi,</para>
  <para style="q2" vid="HOS 13:3">bende kaka thoo mar okinyi malal nono ka nyango owuok,</para>
  <para style="q2" vid="HOS 13:3">bende kaka mihudhwe ma yamo keyo kar dino,</para>
  <para style="q2" vid="HOS 13:3">bende kaka iro mawuok e dirisa.<verse eid="HOS 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 13:4"/>“To An e Jehova Nyasaye ma Nyasachu</para>
  <para style="q2" vid="HOS 13:4">mane ogolou ua e piny Misri.</para>
  <para style="q1" vid="HOS 13:4">Ok unyal yango Nyasaye moro amora ma ok An,</para>
  <para style="q2" vid="HOS 13:4">onge Jawar machielo makmana An.<verse eid="HOS 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 13:5"/>Ne aritou e piny motwo,</para>
  <para style="q2" vid="HOS 13:5">maliel ka mach.<verse eid="HOS 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 13:6"/>Kane apidhogi ne giyiengʼ chuth;</para>
  <para style="q2" vid="HOS 13:6">kane giseyiengʼ to sunga nomakogi;</para>
  <para style="q2" vid="HOS 13:6">ma wigi owil koda.<verse eid="HOS 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 13:7"/>Omiyo anabi irgi ka sibuor,</para>
  <para style="q2" vid="HOS 13:7">kendo ka kwach abiro buto negi e bath yo.<verse eid="HOS 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 13:8"/>Anamonjgi mi ayiechgi matindo tindo</para>
  <para style="q2" vid="HOS 13:8">mana ka ondiek ma omaa nyithinde.</para>
  <para style="q1" vid="HOS 13:8">Anatiekgi mana ka sibuor,</para>
  <para style="q2" vid="HOS 13:8">bende le mag bungu noyiechgi matindo tindo.<verse eid="HOS 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 13:9"/>“Osetieku yaye Israel, nikech ok udwara,</para>
  <para style="q2" vid="HOS 13:9">ok udwar jakonyu.<verse eid="HOS 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 13:10"/>Ere ruodhu mondo koro oresu?</para>
  <para style="q2" vid="HOS 13:10">Ere jotendu e miechu,</para>
  <para style="q1" vid="HOS 13:10">mane usekwayo ni,</para>
  <para style="q2" vid="HOS 13:10">‘Miwa ruodh kod jotendwa?’<verse eid="HOS 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 13:11"/>Kuom ich wangʼ mare ne amiyou ruoth</para>
  <para style="q2" vid="HOS 13:11">kendo e mirimba ne agole oko.<verse eid="HOS 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 13:12"/>Timbe mamono mag Efraim osekan,</para>
  <para style="q2" vid="HOS 13:12">kendo richoge osendik e kitabu.<verse eid="HOS 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 13:13"/>Rem machalo gi mar dhako mamuoch kayo nobine,</para>
  <para style="q2" vid="HOS 13:13">to en nyathi maonge gi rieko,</para>
  <para style="q1" vid="HOS 13:13">ma ka sa ochopo monego owuog e ich</para>
  <para style="q2" vid="HOS 13:13">to okia kama iwuok godo.<verse eid="HOS 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 13:14"/>“Abiro resogi kuom teko mar piny joma otho</para>
  <para style="q2" vid="HOS 13:14">kendo anakonygi kuom tho.</para>
  <para style="q1" vid="HOS 13:14">In tho, ere masicheni duto,</para>
  <para style="q2" vid="HOS 13:14">kata in piny joma otho, ere kethruokni?</para>
  <para style="b" vid="HOS 13:14"/>
  <para style="q1" vid="HOS 13:14">“Ok anakeche,<verse eid="HOS 13:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="HOS 13:15"/>kata ka obedo ni odhi maber kamano e kind owetene.</para>
  <para style="q1" vid="HOS 13:15">Yamb yor wuok chiengʼ moa ir Jehova Nyasaye nobi,</para>
  <para style="q2" vid="HOS 13:15">kakudho koa e piny motwo,</para>
  <para style="q1" vid="HOS 13:15">ma pigene mag sokni mamol nodwon,</para>
  <para style="q2" vid="HOS 13:15">kod yewni mokuny bende nodwon.</para>
  <para style="q1" vid="HOS 13:15">Mwandune manie dechege</para>
  <para style="q2" vid="HOS 13:15">noyaki duto.<verse eid="HOS 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 13:16"/>Jo-Samaria nokum kuom richogi</para>
  <para style="q2" vid="HOS 13:16">nikech gisengʼanyo ne Nyasachgi.</para>
  <para style="q1" vid="HOS 13:16">Noneg-gi gi ligangla;</para>
  <para style="q2" vid="HOS 13:16">nyithindgi matindo nochwad piny,</para>
  <para style="q2" vid="HOS 13:16">to mondgi mapek nobar iyegi.”<verse eid="HOS 13:16"/></para>
  <chapter eid="HOS 13"/>
  <chapter number="14" style="c" sid="HOS 14"/>
  <para style="s1">Lokruok kuom richo kelo gweth</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 14:1"/>Dwoguru ir Jehova Nyasaye ma Nyasachu, yaye Israel.</para>
  <para style="q2" vid="HOS 14:1">Richou ema osemiyo upodho.<verse eid="HOS 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 14:2"/>Kaw wechegi</para>
  <para style="q2" vid="HOS 14:2">kendo uduog ir Jehova Nyasaye!</para>
  <para style="q1" vid="HOS 14:2">Wachne kama:</para>
  <para style="q2" vid="HOS 14:2">“Wenwa richowa duto,</para>
  <para style="q1" vid="HOS 14:2">kendo yie irwakwa gi ngʼwono,</para>
  <para style="q2" vid="HOS 14:2">mi wanapaki gi dhowa.<verse eid="HOS 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 14:3"/>Asuria ok nyal resowa,</para>
  <para style="q2" vid="HOS 14:3">bende ok wana idhi faresegi mag lweny.</para>
  <para style="q1" vid="HOS 14:3">Ok wanachak wawach kendo ni,</para>
  <para style="q2" vid="HOS 14:3">‘Nyisechewa’ ne gik mwaloso gi lwetwa wawegi,</para>
  <para style="q2" vid="HOS 14:3">nimar kuomi, ema, nyithi kiye yude kech.”<verse eid="HOS 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 14:4"/>“Anachang-gi kuom baro margi mane gibarogo,</para>
  <para style="q2" vid="HOS 14:4">kendo anahergi maonge achuna,</para>
  <para style="q2" vid="HOS 14:4">nimar mirimba osewuok kuomgi.<verse eid="HOS 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 14:5"/>Anachal mana ka thoo mar okinyi ne Israel;</para>
  <para style="q2" vid="HOS 14:5">kendo nolodhi mana ka ondanyo,</para>
  <para style="q1" vid="HOS 14:5">kendo tiende nokar</para>
  <para style="q2" vid="HOS 14:5">mana ka yiend Lebanon;<verse eid="HOS 14:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 14:6"/>bade nolodhi makee.</para>
  <para style="q1" vid="HOS 14:6">Enobed maber ka yiend zeituni,</para>
  <para style="q2" vid="HOS 14:6">kendo nodungʼ mangʼwe ngʼar ka yiend Lebanon.<verse eid="HOS 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 14:7"/>Ji nochak odag e tipone.</para>
  <para style="q2" vid="HOS 14:7">Nonyaa maber mana ka cham,</para>
  <para style="q1" vid="HOS 14:7">kendo nonyag maber ka mzabibu</para>
  <para style="q2" vid="HOS 14:7">mi nobed gi huma ka divai moa Lebanon.<verse eid="HOS 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 14:8"/>Yaye Efraim en angʼo ma datim gi nyiseche manonogi kendo?</para>
  <para style="q2" vid="HOS 14:8">Anadwoke kendo rite,</para>
  <para style="q1" vid="HOS 14:8">achalo gi obudo mangʼich,</para>
  <para style="q2" vid="HOS 14:8">nyak mari aa kuoma.”<verse eid="HOS 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 14:9"/>En ngʼat mane mariek?</para>
  <para style="q2" vid="HOS 14:9">Obiro fwenyo tiend gigi.</para>
  <para style="q1" vid="HOS 14:9">En ngʼat mane manyalo fwenyo tiend wechegi?</para>
  <para style="q2" vid="HOS 14:9">Obiro ngʼeyogi.</para>
  <para style="q1" vid="HOS 14:9">Yore mag Jehova Nyasaye nikare,</para>
  <para style="q2" vid="HOS 14:9">joma nikare ema wuothoe,</para>
  <para style="q2" vid="HOS 14:9">to joma jendeke to chwanyore.<verse eid="HOS 14:9"/></para>
  <chapter eid="HOS 14"/>
</usx>
