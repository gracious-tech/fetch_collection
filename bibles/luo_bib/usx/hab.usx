<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Biblica® Open New Luo Translation 2020</book>
  <para style="h">Habakuk</para>
  <para style="toc1">Habakuk</para>
  <para style="toc2">Habakuk</para>
  <para style="toc3">Hab</para>
  <para style="mt1">Habakuk</para>
  <chapter number="1" style="c" sid="HAB 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1"/>Ote mane omi janabi Habakuk.<verse eid="HAB 1:1"/></para>
  <para style="b"/>
  <para style="s1">Ywak mar Habakuk</para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 1:2"/>Yaye Jehova Nyasaye, abiro luongi nyaka karangʼo mondo ikonya</para>
  <para style="q2" vid="HAB 1:2">to ok iwinji?</para>
  <para style="q1" vid="HAB 1:2">Koso nyaka karangʼo maywakni kawacho,</para>
  <para style="q2" vid="HAB 1:2">“Timbe maricho omedore!”</para>
  <para style="q2" vid="HAB 1:2">To kata kamano ok ires ji?<verse eid="HAB 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 1:3"/>En angʼo momiyo iweya mondo ane timbe maricho?</para>
  <para style="q2" vid="HAB 1:3">Koso en angʼo momiyo idhil gi timbe maricho?</para>
  <para style="q1" vid="HAB 1:3">Kethruok kod timbe maricho ochoma pile;</para>
  <para style="q2" vid="HAB 1:3">lwenje mangʼeny nitie kendo sigu medore.<verse eid="HAB 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 1:4"/>Kuom mano chik ok nyal tiyo,</para>
  <para style="q2" vid="HAB 1:4">kendo adiera ok nenre.</para>
  <para style="q1" vid="HAB 1:4">Joma richo olworo joma kare,</para>
  <para style="q2" vid="HAB 1:4">kuom mano adiera ok nyal betie.<verse eid="HAB 1:4"/></para>
  <para style="s1">Jehova Nyasaye odwoko Habakuk</para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 1:5"/>“Rang kendo inon ogendini mag piny</para>
  <para style="q2" vid="HAB 1:5">mondo ibed gi bwok maduongʼ.</para>
  <para style="q1" vid="HAB 1:5">Nimar abiro timo gimoro e ndalou</para>
  <para style="q2" vid="HAB 1:5">ma ok ubi yiego,</para>
  <para style="q2" vid="HAB 1:5">kata ka owachni.<verse eid="HAB 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 1:6"/>Atingʼo jo-Babulon malo,</para>
  <para style="q2" vid="HAB 1:6">en oganda maonge gi ngʼwono kendo mager,</para>
  <para style="q1" vid="HAB 1:6">gin oganda mayweyo piny duto</para>
  <para style="q2" vid="HAB 1:6">kendo gikawo kuonde dak ma ok mekgi.<verse eid="HAB 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 1:7"/>Gin joma ji oluoro kendo magoyo ji gi kihondko,</para>
  <para style="q2" vid="HAB 1:7">giloso chikegi giwegi,</para>
  <para style="q2" vid="HAB 1:7">kendo gichuno luor mag-gi giwegi.<verse eid="HAB 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 1:8"/>Faresegi ringo mapiyo moloyo kwach,</para>
  <para style="q2" vid="HAB 1:8">kendo giger moloyo guo sudhe e sa ma piny imoree.</para>
  <para style="q1" vid="HAB 1:8">Faresegi mag lweny lengʼore ka gitingʼo wiyegi malo;</para>
  <para style="q2" vid="HAB 1:8">joidh faresegi aa kuma bor.</para>
  <para style="q1" vid="HAB 1:8">Gihuyo ka achuth madwaro kawo chiemo,<verse eid="HAB 1:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="HAB 1:9"/>giduto gibiro monjou ne lweny.</para>
  <para style="q1" vid="HAB 1:9">Jolwenjgi dhi nyime mana ka yamb piny motwo</para>
  <para style="q2" vid="HAB 1:9">kendo gichoko joma otwe ka kwoyo.<verse eid="HAB 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 1:10"/>Ginyiero ruodhi</para>
  <para style="q2" vid="HAB 1:10">kendo gijaro jotelo.</para>
  <para style="q1" vid="HAB 1:10">Ginyiero mier mochiel gi ohinga motegno;</para>
  <para style="q2" vid="HAB 1:10">gigero pidhe mag lowo ma giidhogo ohinga kendo gimako mier mochiel motegno.<verse eid="HAB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 1:11"/>Gikadho ka yamo,</para>
  <para style="q2" vid="HAB 1:11">ka gidhi kamoro machielo.</para>
  <para style="q1" vid="HAB 1:11">To kata kamano gin joketho,</para>
  <para style="q2" vid="HAB 1:11">nikech gikwano tekregi giwegi ka nyasachgi.”<verse eid="HAB 1:11"/></para>
  <para style="s1">Ywak Habakuk mar ariyo</para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 1:12"/>Yaye Jehova Nyasaye, donge in ema nyaka nene?</para>
  <para style="q2" vid="HAB 1:12">Yaye, Nyasacha, Nyasaye Maler, ok wanatho.</para>
  <para style="q1" vid="HAB 1:12">Yaye Jehova Nyasaye, iseyierogi mondo gibednwa jongʼad bura.</para>
  <para style="q2" vid="HAB 1:12">Yaye Nyasaye ma Lwanda, isewalogi mondo gikel kum.<verse eid="HAB 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 1:13"/>Wengeni ler ma ok nyal ngʼiyo richo,</para>
  <para style="q2" vid="HAB 1:13">ok inyal bedo mamor gi gima rach.</para>
  <para style="q1" vid="HAB 1:13">To en angʼo momiyo koro ibedo mamor gi jo-andhoga?</para>
  <para style="q2" vid="HAB 1:13">Angʼo momiyo ilingʼ alingʼa ka jomaricho,</para>
  <para style="q2" vid="HAB 1:13">tieko joma kare moloyogi?<verse eid="HAB 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 1:14"/>Isemiyo dhano obedo machalo gi rech manie nam,</para>
  <para style="q2" vid="HAB 1:14">mana kaka gik mochwe modak e nam maonge jatendgi.<verse eid="HAB 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 1:15"/>Jaricho ywayogi ka makogi gi olowu,</para>
  <para style="q2" vid="HAB 1:15">kendo omakogi gi gogo,</para>
  <para style="q1" vid="HAB 1:15">kochokogi gi obadho mochiko,</para>
  <para style="q2" vid="HAB 1:15">kendo obedo mamor kuom lupo.<verse eid="HAB 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 1:16"/>Emomiyo, ochiwo misango kuom gogo mar lupo</para>
  <para style="q2" vid="HAB 1:16">kendo owangʼo ubani ne obadho mar chiko rech,</para>
  <para style="q1" vid="HAB 1:16">nikech gogo mare miyo odak e ngima maber</para>
  <para style="q2" vid="HAB 1:16">kendo ochamo chiemo moyier maber.<verse eid="HAB 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 1:17"/>Bende ber mondo odhi nyime kogolo gik momako e gogo mare,</para>
  <para style="q2" vid="HAB 1:17">kotieko ogendini ka oonge ngʼwono?<verse eid="HAB 1:17"/></para>
  <para style="b"/>
  <chapter eid="HAB 1"/>
  <chapter number="2" style="c" sid="HAB 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="HAB 2:1"/>Abiro chungʼ kara mar rito</para>
  <para style="q2" vid="HAB 2:1">kendo abiro bedo ewi kuonde moger motingʼore mag rito.</para>
  <para style="q1" vid="HAB 2:1">Abiro ngʼicho mondo ane gima obiro wachona,</para>
  <para style="q2" vid="HAB 2:1">kendo kuom dwoko mabiro chiwo kuom ywagni.<verse eid="HAB 2:1"/></para>
  <para style="s1">Jehova Nyasaye odwoko Habakuk</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2"/>Eka Jehova Nyasaye nodwoke niya,</para>
  <para style="q1" vid="HAB 2:2">“Ndik fwenyni</para>
  <para style="q2" vid="HAB 2:2">kendo iler tiende maber kama indike,</para>
  <para style="q2" vid="HAB 2:2">mondo jaland wach oring katere.<verse eid="HAB 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3"/>Nikech fwenyni rito kinde moketi;</para>
  <para style="q2" vid="HAB 2:3">owuoyo kuom ndalo giko,</para>
  <para style="q2" vid="HAB 2:3">kendo ok nobed miriambo.</para>
  <para style="q1" vid="HAB 2:3">Kata obedo ni onyalo deko kapok ochopo, rite arita,</para>
  <para style="q2" vid="HAB 2:3">adier obiro chopo ma ok odeko.<verse eid="HAB 2:3"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4"/>“Ne kaka osungore;</para>
  <para style="q2" vid="HAB 2:4">dwarone ok nikare.</para>
  <para style="q2" vid="HAB 2:4">To ngʼat makare nobed mangima kuom yie mare,<verse eid="HAB 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5"/>chutho, divai momadho ndhoge;</para>
  <para style="q2" vid="HAB 2:5">en jasunga kendo osiko otimo gik maricho ma ok ool.</para>
  <para style="q1" vid="HAB 2:5">Nikech owuor ka liel mamuonyo ji</para>
  <para style="q2" vid="HAB 2:5">kendo kaka tho ok rom e kaka en bende ok orom,</para>
  <para style="q1" vid="HAB 2:5">ochoko ogendini duto mondo obi ire,</para>
  <para style="q2" vid="HAB 2:5">kendo omako ji duto wasumbini.<verse eid="HAB 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 2:6"/>“To donge jogi biro kwede ka ngʼongʼone kendo jare kawacho niya,</para>
  <para style="q1" vid="HAB 2:6">“ ‘Inine malit in ngʼama choko gik mokwal</para>
  <para style="q2" vid="HAB 2:6">kendo mabedo ja-mwandu gi gige mecho.</para>
  <para style="q2" vid="HAB 2:6">Nyaka karangʼo ma gigi nodhi nyime katimore?’<verse eid="HAB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7"/>To donge jogopeu biro poyou?</para>
  <para style="q2" vid="HAB 2:7">Donge gibiro chiewo ma gimi utetni?</para>
  <para style="q2" vid="HAB 2:7">Eka unubed wasumbinigi.<verse eid="HAB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8"/>Nikech useyako ogendini mangʼeny,</para>
  <para style="q2" vid="HAB 2:8">joma odongʼ biro mayou.</para>
  <para style="q1" vid="HAB 2:8">Nimar usechwero remb dhano,</para>
  <para style="q2" vid="HAB 2:8">useketho pinje, mier madongo kod ji duto manie igi.<verse eid="HAB 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9"/>“Ngʼat mayudo mwandu gi yore ma ok owinjore none malit</para>
  <para style="q2" vid="HAB 2:9">kendo ogero ode kama otingʼore gi malo,</para>
  <para style="q2" vid="HAB 2:9">mondo otony ne kethruok!<verse eid="HAB 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10"/>Isechano kethruok mar ogendini mangʼeny,</para>
  <para style="q2" vid="HAB 2:10">ma osemiyo odi owuon wichkuot kendo iwito ngimani.<verse eid="HAB 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11"/>Kite mag kor ot noywagnu matek</para>
  <para style="q2" vid="HAB 2:11">to yiend tado nokow ywagno.<verse eid="HAB 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12"/>“Ngʼat magero dalane gi remo</para>
  <para style="q2" vid="HAB 2:12">kendo guro dala maduongʼ gi gige mecho enone malit!<verse eid="HAB 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13"/>Donge Jehova Nyasaye Maratego osechiko</para>
  <para style="q2" vid="HAB 2:13">ni tije ogendini maricho biro bedo ramok mach,</para>
  <para style="q2" vid="HAB 2:13">ogendini tiyo ma ol kayiem nono?<verse eid="HAB 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 2:14"/>Nimar piny biro pongʼ gi ngʼeyo mar duongʼ Jehova Nyasaye</para>
  <para style="q2" vid="HAB 2:14">kaka pi kwako nam.<verse eid="HAB 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15"/>“Enone malit ngʼat mamiyo jobathe math,</para>
  <para style="q2" vid="HAB 2:15">ka omedogi ameda nyaka gimer,</para>
  <para style="q2" vid="HAB 2:15">mondo one dug-gi.<verse eid="HAB 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16"/>Wichkuot nomaki kar bedo gi pak.</para>
  <para style="q2" vid="HAB 2:16">Koro en kindeni mar mer! Methi kendo dongʼ duk!</para>
  <para style="q1" vid="HAB 2:16">Okombe moa e lwet Jehova Nyasaye ma korachwich bironi,</para>
  <para style="q2" vid="HAB 2:16">kendo wichkuot biro umo duongʼ ma in-go.<verse eid="HAB 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17"/>Timbe mahundu ma isetimone Lebanon nonyori</para>
  <para style="q2" vid="HAB 2:17">kendo le mane inego marach biro miyi bwok.</para>
  <para style="q1" vid="HAB 2:17">Nimar isechwero remb dhano,</para>
  <para style="q2" vid="HAB 2:17">iseketho pinje gi mier madongo,</para>
  <para style="q2" vid="HAB 2:17">kendo gi ji duto manie igi.<verse eid="HAB 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18"/>“En ohala manade miyudo kuom nyiseche manono</para>
  <para style="q2" vid="HAB 2:18">nimar dhano ema opayogi?</para>
  <para style="q1" vid="HAB 2:18">Kata kido mapuonjo miriambo?</para>
  <para style="q2" vid="HAB 2:18">Ngʼat malose oketo genone,</para>
  <para style="q1" vid="HAB 2:18">kuom gima oloso owuon;</para>
  <para style="q2" vid="HAB 2:18">oloso nyiseche manono ma ok nyal wuoyo.<verse eid="HAB 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19"/>Enone malit ngʼat mawachone yien ni, ‘Bed mangima!’</para>
  <para style="q2" vid="HAB 2:19">Kata ni kite maonge ngima ni, ‘Chiew!’</para>
  <para style="q1" vid="HAB 2:19">Bende gik ma kamago dingʼadnu rieko?</para>
  <para style="q2" vid="HAB 2:19">Kata obedo ni obawgi gi dhahabu gi fedha;</para>
  <para style="q2" vid="HAB 2:19">to gionge gi ngima nikech gin gik motho.”<verse eid="HAB 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20"/>To Jehova Nyasaye nitie e hekalune maler;</para>
  <para style="q2" vid="HAB 2:20">piny duto mondo olingʼ e nyime.<verse eid="HAB 2:20"/></para>
  <chapter eid="HAB 2"/>
  <chapter number="3" style="c" sid="HAB 3"/>
  <para style="s1">Lemo mar Habakuk</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 3:1"/>Lemo mane Habakuk janabi olamo e dwond <char style="tl">Shigionot</char><note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="fq" closed="false">Shigionot </char><char style="ft" closed="false">en kit wer mane Habakuk otiyogo kalamo Jehova Nyasaye.</char></note> ema:<verse eid="HAB 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2"/>Jehova Nyasaye, asewinjo humbi;</para>
  <para style="q2" vid="HAB 3:2">achungʼ e nyimi ka an-gi luoro kuom gik misetimo, yaye Jehova Nyasaye.</para>
  <para style="q1" vid="HAB 3:2">Mad itimgi kendo e kindewa,</para>
  <para style="q2" vid="HAB 3:2">mi gingʼere e ndalowani;</para>
  <para style="q2" vid="HAB 3:2">ka in gi mirima to mad ipar ngʼwono.<verse eid="HAB 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3"/>Nyasaye nobiro koa Teman,</para>
  <para style="q2" vid="HAB 3:3">Nyasaye Maler moa e got mar Paran. <char style="qs">Sela</char><note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="fq" closed="false">Sela </char><char style="ft" closed="false">tiend wachni ok ongʼere.</char></note></para>
  <para style="q1" vid="HAB 3:3">Duongʼne noumo polo,</para>
  <para style="q2" vid="HAB 3:3">kendo pakne nopongʼo piny.<verse eid="HAB 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4"/>Berne ne chalo kawuok chiengʼ;</para>
  <para style="q2" vid="HAB 3:4">kendo ler ne mil ka wuok e lwete,</para>
  <para style="q2" vid="HAB 3:4">kama tekone opandie.<verse eid="HAB 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5"/>Masira mar tuoche notelo e nyime;</para>
  <para style="q2" vid="HAB 3:5">to midekre noluwe.<verse eid="HAB 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6"/>Ne ochungʼ kendo noyiengo piny,</para>
  <para style="q2" vid="HAB 3:6">ne ongʼicho mi ogendini otetni.</para>
  <para style="q1" vid="HAB 3:6">Gode machon nomukore</para>
  <para style="q2" vid="HAB 3:6">kendo gode matindo manyaka nene bende nopodho.</para>
  <para style="q1" vid="HAB 3:6">Yorene osiko manyaka chiengʼ.<verse eid="HAB 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7"/>Ne aneno hemb jo-Kushan ka nigi chandruok,</para>
  <para style="q2" vid="HAB 3:7">kuonde dak mag jo-Midian nigi kihondko.<verse eid="HAB 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8"/>Mirima nomaki gi aore, yaye Jehova Nyasaye?</para>
  <para style="q2" vid="HAB 3:8">Koso mirima nomaki gi aore matindo?</para>
  <para style="q1" vid="HAB 3:8">Koso ne ikecho gi nam</para>
  <para style="q2" vid="HAB 3:8">kane iidho farese,</para>
  <para style="q2" vid="HAB 3:8">ma en gachi mar loch?<verse eid="HAB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9"/>Isechiko atungʼ mari,</para>
  <para style="q2" vid="HAB 3:9">kendo iluongo mondo omedi aserni mangʼeny. <char style="qs">Sela</char></para>
  <para style="q1" vid="HAB 3:9">Ipogo piny gi aore,<verse eid="HAB 3:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="HAB 3:10"/>gode ne oneni ma otetni giluoro;</para>
  <para style="q1" vid="HAB 3:10">oula nomwomo karidore.</para>
  <para style="q2" vid="HAB 3:10">Kude matut bende mor matek;</para>
  <para style="q2" vid="HAB 3:10">apaka ne tingʼore malo.<verse eid="HAB 3:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11"/>Wangʼ chiengʼ gi dwe nochungʼ kargi e kor polo</para>
  <para style="q2" vid="HAB 3:11">ka gineno asernigi mibayo;</para>
  <para style="q2" vid="HAB 3:11">ka mil polo machalo tongʼ mobaa.<verse eid="HAB 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12"/>E mirimbi ne iwuotho e piny duto,</para>
  <para style="q2" vid="HAB 3:12">to kuom mirimbi ne inyono ogendini.<verse eid="HAB 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13"/>Ne ibiro mondo ires jogi,</para>
  <para style="q2" vid="HAB 3:13">mondo iwar ngʼatno mowal.</para>
  <para style="q1" vid="HAB 3:13">Ne inyono jatend piny richo,</para>
  <para style="q2" vid="HAB 3:13">ne ilonye duk koa e tiende piny nyaka e wiye. <char style="qs">Sela</char><verse eid="HAB 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14"/>Gi tonge owuon isechwoyo wiye,</para>
  <para style="q2" vid="HAB 3:14">kane jolwenje omonjowa mondo gikewa,</para>
  <para style="q1" vid="HAB 3:14">ka gin gi ilo ka gima gichiegni tieko</para>
  <para style="q2" vid="HAB 3:14">joma onge gi nyalo kama ne giponde.<verse eid="HAB 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15"/>To ne inyono nam gi faresegi,</para>
  <para style="q2" vid="HAB 3:15">ka iduwo pi.<verse eid="HAB 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16"/>Ne awinjo ma chunya noridore,</para>
  <para style="q2" vid="HAB 3:16">dhoga nomoko kane awinjo kokono;</para>
  <para style="q1" vid="HAB 3:16">chokena nonyosore</para>
  <para style="q2" vid="HAB 3:16">kendo tiendena notetni.</para>
  <para style="q1" vid="HAB 3:16">To kata kamano abiro rito ka ahora ni odiechieng masira</para>
  <para style="q2" vid="HAB 3:16">mabiro mako oganda ma monjowa chopi.<verse eid="HAB 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17"/>Kata obedo ni yadh ngʼowu ok nyal thiewo</para>
  <para style="q2" vid="HAB 3:17">bende kata obedo ni onge olemo ewi yadh zeituni,</para>
  <para style="q1" vid="HAB 3:17">kata obedo ni yadh mzabibu ok nyag olemo</para>
  <para style="q2" vid="HAB 3:17">bende kata obedo ni puothe ok nyag cham,</para>
  <para style="q1" vid="HAB 3:17">kendo kata obedo ni rombe orumo e abila</para>
  <para style="q2" vid="HAB 3:17">mi dhok bende orumo duto e dipo,<verse eid="HAB 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18"/>to kata kamano pod abiro bedo gi ilo kuom Jehova Nyasaye,</para>
  <para style="q2" vid="HAB 3:18">kendo abiro bedo mamor kuom Nyasaye ma Jawarna.<verse eid="HAB 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19"/>Jehova Nyasaye Manyalo Gik Moko Duto e tekona;</para>
  <para style="q2" vid="HAB 3:19">en ema omiyo tienda bedo mayot ka tiend mwanda,</para>
  <para style="q2" vid="HAB 3:19">en ema omiyo awuotho kuonde motingʼore malo.</para>
  <para style="b" vid="HAB 3:19"/>
  <para style="q1" vid="HAB 3:19">Ne jatend wer. E thuma mar kamba.<verse eid="HAB 3:19"/></para>
  <chapter eid="HAB 3"/>
</usx>
