<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Biblica® Open New Luo Translation 2020</book>
  <para style="h">Wer Mamit</para>
  <para style="toc1">Wer Mamit Moloyo Wende Moko Duto</para>
  <para style="toc2">Wer Mamit</para>
  <para style="toc3">Wer</para>
  <para style="mt1">Wer Mamit Moloyo Wende Moko Duto</para>
  <chapter number="1" style="c" sid="SNG 1"/>
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1"/>Wer mamit moloyo wende moko nondiki gi ruoth Solomon.<verse eid="SNG 1:1"/></para>
  <para style="b"/>
  <para style="sp">Nyako</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2"/>Bi mondo inyodha gi dhogi,</para>
  <para style="q2" vid="SNG 1:2">nikech herani kelo mor moloyo divai.<verse eid="SNG 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3"/>Modhi miwirorigo dungʼ mamit;</para>
  <para style="q2" vid="SNG 1:3">kendo nyingi chalo gi mo mangʼwe ngʼar ma pukore oko.</para>
  <para style="q2" vid="SNG 1:3">Kare mano emomiyo nyiri duto oheri!<verse eid="SNG 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4"/>Kawa idhi koda, waret piyo waa kae!</para>
  <para style="q2" vid="SNG 1:4">Ruoth mondo odhi koda nyaka ei ode maiye.</para>
  <para style="sp" vid="SNG 1:4">Osiepe</para>
  <para style="q1" vid="SNG 1:4">Wail kendo chunywa mor kodi;</para>
  <para style="q2" vid="SNG 1:4">wabiro pako herani moloyo divai.</para>
  <para style="sp" vid="SNG 1:4">Nyako</para>
  <para style="q1" vid="SNG 1:4">Gitimo gima kare ka gipuoyi!<verse eid="SNG 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5"/>An nyako ma dichol kendo ma jaber,</para>
  <para style="q2" vid="SNG 1:5">yaye nyi Jerusalem,</para>
  <para style="q1" vid="SNG 1:5">an dichol mana ka hembe mag Kedar,</para>
  <para style="q2" vid="SNG 1:5">kendo mana ka pasia molier e hembe Solomon.<verse eid="SNG 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6"/>Kik uchaya nikech an dichol,</para>
  <para style="q2" vid="SNG 1:6">nimar chiengʼ ema oseloko denda kamano.</para>
  <para style="q1" vid="SNG 1:6">Yawuot minwa nokecho koda,</para>
  <para style="q2" vid="SNG 1:6">mine giketa jarit puothegi mag mzabibu;</para>
  <para style="q2" vid="SNG 1:6">to puotha awuon mar mzabibu to ne ajwangʼo.<verse eid="SNG 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7"/>Yaye jaherana, nyisane kuma ikwayoe jambi</para>
  <para style="q2" vid="SNG 1:7">kod kuma iweye rombi mondo oyweyee odiechiengʼ tir.</para>
  <para style="q1" vid="SNG 1:7">Angʼo momiyo dachal mana gi dhako moumo wangʼe</para>
  <para style="q2" vid="SNG 1:7">e dier jamb osiepeni?<verse eid="SNG 1:7"/></para>
  <para style="sp">Osiepe</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8"/>Ka ok ingʼeyo, yaye jaber moloyo mon mamoko,</para>
  <para style="q2" vid="SNG 1:8">lu bangʼ rombe kuonde ma gikwayoe,</para>
  <para style="q1" vid="SNG 1:8">mondo ikwa nyidiek ma pod tindo</para>
  <para style="q2" vid="SNG 1:8">e bath hembe mag jokwath.<verse eid="SNG 1:8"/></para>
  <para style="sp">Wuowi</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9"/>Jaherana, apimi mana gi faras madhako</para>
  <para style="q2" vid="SNG 1:9">motwe but achiel kuom geche Farao.<verse eid="SNG 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10"/>Lembi nenore maber ka sitadi olierie;</para>
  <para style="q2" vid="SNG 1:10">ngʼuti bende nenore maber ka olierie tigo ma nengogi tek.<verse eid="SNG 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11"/>Wabiro losoni thiwni mag dhahabu,</para>
  <para style="q2" vid="SNG 1:11">kod tigo mag fedha.<verse eid="SNG 1:11"/></para>
  <para style="sp">Nyako</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12"/>Kane ruoth chiemo e mesane,</para>
  <para style="q2" vid="SNG 1:12">mo mangʼwe ngʼar man-gi tik mamit nopongʼo ot kadonjo.<verse eid="SNG 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13"/>Jaherana chalona gi mo mane-mane mobo matin ma nengone tek,</para>
  <para style="q2" vid="SNG 1:13">mantie e kind thundena.<verse eid="SNG 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14"/>Jaherana chalona maua maber mothiewo,</para>
  <para style="q2" vid="SNG 1:14">moa e puoth mzabibu man En Gedi.<verse eid="SNG 1:14"/></para>
  <para style="sp">Wuowi</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15"/>Mano kaka ijaber, jaherana!</para>
  <para style="q2" vid="SNG 1:15">Yaye, mano kaka ijaber!</para>
  <para style="q2" vid="SNG 1:15">Wengeni neno mamuol ka akuru.<verse eid="SNG 1:15"/></para>
  <para style="sp">Nyako</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16"/>Mano kaka iber, jaherana!</para>
  <para style="q2" vid="SNG 1:16">Yaye, mano kaka berni olomba!</para>
  <para style="q2" vid="SNG 1:16">Kendo kitandawa bende yom ka lum mangʼich.<verse eid="SNG 1:16"/></para>
  <para style="sp">Wuowi</para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17"/>Bepe mag tat odwa gin mag sida;</para>
  <para style="q2" vid="SNG 1:17">kendo bede yien mokar mag obudo nobednwa tado.<verse eid="SNG 1:17"/></para>
  <chapter eid="SNG 1"/>
  <chapter number="2" style="c" sid="SNG 2"/>
  <para style="sp">Nyako</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1"/>An maua madungʼ tik mamit mag Sharon,</para>
  <para style="q2" vid="SNG 2:1">bende an ondanyo madongo e holo.<verse eid="SNG 2:1"/></para>
  <para style="sp">Wuowi</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2"/>Mana ka ondanyo motwi e dier kuthe</para>
  <para style="q2" vid="SNG 2:2">e kaka jaherana chalo e dier nyiri.<verse eid="SNG 2:2"/></para>
  <para style="sp">Nyako</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3"/>Mana kaka yiend olemo mayom manie dier yiende mamoko mag bungu,</para>
  <para style="q2" vid="SNG 2:3">e kaka jaherana chalo e dier chwo matindo.</para>
  <para style="q1" vid="SNG 2:3">Amor ka abet e tipone,</para>
  <para style="q2" vid="SNG 2:3">kendo olembe milimili e dhoga.<verse eid="SNG 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4"/>Osetera e od budho mare,</para>
  <para style="q2" vid="SNG 2:4">kendo herane oliero e wiya ka bendera.<verse eid="SNG 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5"/>Miya jip gi olemb mzabibu mosemo e chiengʼ,</para>
  <para style="q2" vid="SNG 2:5">duog chunya gi olemo mayom,</para>
  <para style="q2" vid="SNG 2:5">nikech hera onura.<verse eid="SNG 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6"/>Bade ma koracham oteno wiya</para>
  <para style="q2" vid="SNG 2:6">to bade ma korachwich okwaka.<verse eid="SNG 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7"/>Un nyi Jerusalem, asiemou gi nying nyakech kod mwanda manie e thim,</para>
  <para style="q2" vid="SNG 2:7">ni kik utug hera kata chiewe ka sa ne pok oromo.<verse eid="SNG 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8"/>Lingʼane,</para>
  <para style="q2" vid="SNG 2:8">awinjo dwond jaherana kabiro!</para>
  <para style="q1" vid="SNG 2:8">Kochikore ewi gode kobiro,</para>
  <para style="q2" vid="SNG 2:8">kendo obiro kolengʼore ewi gode matindo.<verse eid="SNG 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9"/>Jaherana chalo gi mwanda manie thim.</para>
  <para style="q2" vid="SNG 2:9">Nene kaka ochungʼ e tok ohinga,</para>
  <para style="q1" vid="SNG 2:9">kongʼicho gie dirise manie kor ohinga,</para>
  <para style="q2" vid="SNG 2:9">kendo kongʼicho gie bath dirisa.<verse eid="SNG 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10"/>Jaherana nowuoyo kendo nowachona niya,</para>
  <para style="q2" vid="SNG 2:10">“Aa malo jaherana, bi wadhiyo,</para>
  <para style="q2" vid="SNG 2:10">yaye jaber.<verse eid="SNG 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11"/>Ndalo chwiri osekalo;</para>
  <para style="q2" vid="SNG 2:11">koth osechok kendo oserumo.<verse eid="SNG 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12"/>Maua osechako thiewo e puothe;</para>
  <para style="q2" vid="SNG 2:12">kinde mag wer osechopo,</para>
  <para style="q1" vid="SNG 2:12">ndalo ma akuch oduglani werie mamit</para>
  <para style="q2" vid="SNG 2:12">koro winjore e gwengʼwa.<verse eid="SNG 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13"/>Yiend ngʼowu golo olembene mokwongo;</para>
  <para style="q2" vid="SNG 2:13">thiepe mag mzabibu keyo tikgi mamit.</para>
  <para style="q1" vid="SNG 2:13">Aa malo ibi, jaherana;</para>
  <para style="q2" vid="SNG 2:13">bi mondo wadhiyo, yaye jaber.”<verse eid="SNG 2:13"/></para>
  <para style="sp">Wuowi</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14"/>Yaye akucha manie buche manie kor lwanda;</para>
  <para style="q2" vid="SNG 2:14">kuonde mopondo manie kor gode,</para>
  <para style="q1" vid="SNG 2:14">yie aneye wangʼi,</para>
  <para style="q2" vid="SNG 2:14">kendo yie awinjie dwondi;</para>
  <para style="q1" vid="SNG 2:14">nimar dwondi mit,</para>
  <para style="q2" vid="SNG 2:14">kendo wangʼi ber neno.<verse eid="SNG 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15"/>Maknwauru nyithind bwe ma pod tindo,</para>
  <para style="q2" vid="SNG 2:15">maketho puothewa mag mzabibu;</para>
  <para style="q1" vid="SNG 2:15">nikech dipo ka giketho mzabibuwa mosechako thiewo.<verse eid="SNG 2:15"/></para>
  <para style="sp">Nyako</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16"/>Jaherana en mara kendo an mare;</para>
  <para style="q2" vid="SNG 2:16">odongo maber e dier ondanyo.<verse eid="SNG 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17"/>Nyaka chop piny yawre</para>
  <para style="q2" vid="SNG 2:17">kendo tipo mag gik moko lal,</para>
  <para style="q1" vid="SNG 2:17">duog ira, jaherana,</para>
  <para style="q2" vid="SNG 2:17">mana kaka mwanda gi le mamoko ringo kadok e gode.<verse eid="SNG 2:17"/></para>
  <para style="b"/>
  <chapter eid="SNG 2"/>
  <chapter number="3" style="c" sid="SNG 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1"/>Otieno duto kane an e kitandana,</para>
  <para style="q2" vid="SNG 3:1">ne amanyo ngʼat ma chunya ohero;</para>
  <para style="q2" vid="SNG 3:1">ne amanye to ne ok ayude.<verse eid="SNG 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2"/>Koro abiro aa malo kendo abiro wuotho koni gi koni e dala,</para>
  <para style="q2" vid="SNG 3:2">abiro menyo e yore kod kuonde duto mopondo mag dala;</para>
  <para style="q1" vid="SNG 3:2">abiro manyo ngʼat ma chunya ohero.</para>
  <para style="q2" vid="SNG 3:2">Omiyo ne amanye to ne ok ayude.<verse eid="SNG 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3"/>Jorito mag dala noyuda</para>
  <para style="q2" vid="SNG 3:3">ka girito dala,</para>
  <para style="q2" vid="SNG 3:3">mine apenjogi niya “Bende usenenonae ngʼat ma chunya ohero?”<verse eid="SNG 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4"/>Gikanyono, kane pok asudo mabor kodgi,</para>
  <para style="q2" vid="SNG 3:4">ne ayudo ngʼat ma chunya ohero.</para>
  <para style="q1" vid="SNG 3:4">Ne amake matek, kendo ne adagi weye thuolo mondo odhi</para>
  <para style="q2" vid="SNG 3:4">mine akele nyaka e od minwa, kama ne onywolae.<verse eid="SNG 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5"/>Un nyi Jerusalem, asiemou gi nying nyakech kod mwanda manie e thim,</para>
  <para style="q2" vid="SNG 3:5">ni kik utug hera kata chiewe ka sa ne pok oromo.<verse eid="SNG 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6"/>Mano to ngʼa mabiro koa e piny motimo ongoro</para>
  <para style="q2" vid="SNG 3:6">machalo ka iro madhwolore,</para>
  <para style="q1" vid="SNG 3:6">mowirore gi modhi mangʼwe ngʼar,</para>
  <para style="q2" vid="SNG 3:6">kendo molosi gi gik madungʼ mangʼwe ngʼar mag jo-ohala madongo?<verse eid="SNG 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7"/>Neuru, en gach Solomon,</para>
  <para style="q2" vid="SNG 3:7">kikowe gi jolweny piero auchiel,</para>
  <para style="q2" vid="SNG 3:7">ma gin jo-Israel maroteke,<verse eid="SNG 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8"/>giduto gimanore gi ligangla,</para>
  <para style="q2" vid="SNG 3:8">giduto gilony e kedo,</para>
  <para style="q1" vid="SNG 3:8">ka ngʼato ka ngʼato nigi liganglane e bathe,</para>
  <para style="q2" vid="SNG 3:8">koikore ne gik mabwogo ji gotieno.<verse eid="SNG 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9"/>Ruoth Solomon noloso garino ne en owuon;</para>
  <para style="q2" vid="SNG 3:9">nolose gi bepe moa Lebanon.<verse eid="SNG 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10"/>Sirnige noloso gi fedha,</para>
  <para style="q2" vid="SNG 3:10">to pinyne noloso gi dhahabu,</para>
  <para style="q1" vid="SNG 3:10">kombene ne olicho gi nanga maralik,</para>
  <para style="q2" vid="SNG 3:10">dier iye to nyi Jerusalem noumo gihera mogundho.<verse eid="SNG 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11"/>Wuoguru oko, un nyi Sayun,</para>
  <para style="q2" vid="SNG 3:11">wuoguru uneye Ruoth Solomon korwako osimbone mar loch,</para>
  <para style="q1" vid="SNG 3:11">osimbo mar loch mane min mare osidhone,</para>
  <para style="q2" vid="SNG 3:11">chiengʼ mane otimo arus, chiengʼno mane chunye oil.<verse eid="SNG 3:11"/></para>
  <chapter eid="SNG 3"/>
  <chapter number="4" style="c" sid="SNG 4"/>
  <para style="sp">Wuowi</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1"/>Mano kaka ijaber, jaherana!</para>
  <para style="q2" vid="SNG 4:1">Yaye, mano kaka ijaber!</para>
  <para style="q2" vid="SNG 4:1">Wengeni neno mamuol ka akuru.</para>
  <para style="q1" vid="SNG 4:1">Yie wiyi chalo gi kweth mag diek,</para>
  <para style="q2" vid="SNG 4:1">malor koa e Got Gilead.<verse eid="SNG 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2"/>Lekeni tar mana ka kweth mag rombe makoro eka oliel yiegi</para>
  <para style="q2" vid="SNG 4:2">kendo mowuok kar luok.</para>
  <para style="q1" vid="SNG 4:2">Moro ka moro wuotho gi nyithinde ma rude,</para>
  <para style="q2" vid="SNG 4:2">kendo onge moro man kende.<verse eid="SNG 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3"/>Pien dhogi chalo gi law marakwaro;</para>
  <para style="q2" vid="SNG 4:3">kendo dhogi ber ahinya.</para>
  <para style="q1" vid="SNG 4:3">Lembi moum gi law</para>
  <para style="q2" vid="SNG 4:3">yom machalo mana gi olemo mongʼinore.<verse eid="SNG 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4"/>Ngʼuti chalo gi osuch Daudi,</para>
  <para style="q2" vid="SNG 4:4">mochungʼ tir gi chia;</para>
  <para style="q1" vid="SNG 4:4">kuode alufu achiel oliero kuome,</para>
  <para style="q2" vid="SNG 4:4">ma kargi duto gin kuodi mag jokedo.<verse eid="SNG 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5"/>Thundeni chalo gi nyithi mwanda ariyo maromre</para>
  <para style="q2" vid="SNG 4:5">adier gichalo gi nyithind mwanda ma rude,</para>
  <para style="q2" vid="SNG 4:5">makwayo e kind ondanyo.<verse eid="SNG 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6"/>Ka piny oseyawore</para>
  <para style="q2" vid="SNG 4:6">kendo rumbi oserumo,</para>
  <para style="q1" vid="SNG 4:6">eka abiro dhi ewi got kuma gik madungʼ tik mangʼwe ngʼar yudoree</para>
  <para style="q2" vid="SNG 4:6">kendo nyaka ewi gode matindo miwangʼoe ubani.<verse eid="SNG 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7"/>Ijaber e yore duto, jaherana;</para>
  <para style="q2" vid="SNG 4:7">onge mbala moro amora e dendi.<verse eid="SNG 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8"/>Yaye jaherana, bi wadhi kodi ka waa e got Lebanon,</para>
  <para style="q2" vid="SNG 4:8">adier bi koda walor ka waa Lebanon.</para>
  <para style="q1" vid="SNG 4:8">Lor piny ia e chuny got Amana,</para>
  <para style="q2" vid="SNG 4:8">lor ia ewi got mar Senir gi Hermon,</para>
  <para style="q1" vid="SNG 4:8">wuog e bur sibuoche</para>
  <para style="q2" vid="SNG 4:8">kendo wuog ewi got kama kwach oloko miechgi.<verse eid="SNG 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9"/>Yaye jaherana,</para>
  <para style="q2" vid="SNG 4:9">ka aneno kaka ingʼiya,</para>
  <para style="q1" vid="SNG 4:9">kod tigo malich miliero</para>
  <para style="q2" vid="SNG 4:9">e ngʼuti, to chunya rumo.<verse eid="SNG 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10"/>Mano kaka herani miya mor, yaye osiepna, ma ahero;</para>
  <para style="q2" vid="SNG 4:10">mano kaka herani kelo mor mangʼeny moloyo divai,</para>
  <para style="q2" vid="SNG 4:10">kendo ngʼwe ngʼar moloyo modhi mamoko duto!<verse eid="SNG 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11"/>Yaye jaherana, pien dhogi mit ka mor kich;</para>
  <para style="q2" vid="SNG 4:11">lewi chalona chak kata mor kich.</para>
  <para style="q2" vid="SNG 4:11">Lewni mirwako dungʼ tik mamit mana ka tik mamit mar got Lebanon.<verse eid="SNG 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12"/>Yaye jaherana, ichalo gi puodho mochiel;</para>
  <para style="q2" vid="SNG 4:12">kendo ka soko molor dhoge modin motegno.<verse eid="SNG 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13"/>Yiende madongo e puothi gin olembe mongʼinore,</para>
  <para style="q2" vid="SNG 4:13">molembegi beyo,</para>
  <para style="q2" vid="SNG 4:13">kendo mit kaka olemb hena kod nad.<verse eid="SNG 4:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="SNG 4:14"/>Gin olembe mopogore opogore kaka nad kod safron,</para>
  <para style="q2" vid="SNG 4:14">gi kalmas kod sinamon,</para>
  <para style="q2" vid="SNG 4:14">kod yedhe mangʼwe ngʼar,</para>
  <para style="q2" vid="SNG 4:14">kaka ubani gi mane-mane,</para>
  <para style="q2" vid="SNG 4:14">kod apilo mamit mag tedo.<verse eid="SNG 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15"/>Ichalo gi puodho ma thidhna ni e iye,</para>
  <para style="q2" vid="SNG 4:15">bende ichalo gi soko mar pi mamol,</para>
  <para style="q2" vid="SNG 4:15">kendo ichalo gi aore mamol kawuok ewi gode mag Lebanon.<verse eid="SNG 4:15"/></para>
  <para style="sp">Nyako</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16"/>Wuogi ka ikudho, in yamb nyandwat,</para>
  <para style="q2" vid="SNG 4:16">bende in yamb milambo kudhi!</para>
  <para style="q1" vid="SNG 4:16">Kudhi e puotha,</para>
  <para style="q2" vid="SNG 4:16">mondo tikne okere malach.</para>
  <para style="q1" vid="SNG 4:16">We jaherana koro obi odonji e puothe</para>
  <para style="q2" vid="SNG 4:16">kendo obil olembene moyiedhi kendo mamit.<verse eid="SNG 4:16"/></para>
  <chapter eid="SNG 4"/>
  <chapter number="5" style="c" sid="SNG 5"/>
  <para style="sp">Wuowi</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1"/>Asebiro e puotha, yaye jaherana;</para>
  <para style="q2" vid="SNG 5:1">asechoko ubani gi modhi madungʼ tik mangʼwe ngʼar,</para>
  <para style="q1" vid="SNG 5:1">asechamo pednina kaachiel kod mor kich mara;</para>
  <para style="q2" vid="SNG 5:1">kendo asemadho divaina kod chak.</para>
  <para style="sp" vid="SNG 5:1">Osiepe</para>
  <para style="q1" vid="SNG 5:1">Yaye osiepena, chiemuru kendo methuru;</para>
  <para style="q2" vid="SNG 5:1">yaye joherana, methuru ma romu.<verse eid="SNG 5:1"/></para>
  <para style="sp">Nyako</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2"/>Ne anindo, to chunya ne neno.</para>
  <para style="q2" vid="SNG 5:2">Lingʼ uwinji! Jaherana dwongʼo kowacho niya,</para>
  <para style="q1" vid="SNG 5:2">“Yaye jaherana, yawna kendo winja maber,</para>
  <para style="q2" vid="SNG 5:2">yaye jaherana mamuol mana ka akuru.</para>
  <para style="q1" vid="SNG 5:2">Tho opongʼo wiya,</para>
  <para style="q2" vid="SNG 5:2">kendo yie wiya opongʼ gi ngʼich mar otieno.”<verse eid="SNG 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3"/>Aselonyo lepa,</para>
  <para style="q2" vid="SNG 5:3">koro idwaro ni achak arwakra kendo?</para>
  <para style="q1" vid="SNG 5:3">Aselwoko tienda,</para>
  <para style="q2" vid="SNG 5:3">koro idwaro ni achak anyon lowo kendo?<verse eid="SNG 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4"/>Jaherana nosoyo lwete e otuchi mar dhoot;</para>
  <para style="q2" vid="SNG 5:4">chunya nochako gwecho ka dware.<verse eid="SNG 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5"/>Ne aa malo mondo ayawne jaherana,</para>
  <para style="q2" vid="SNG 5:5">kendo lwetena ne ton mo mangʼwe ngʼar ma nengone tek.</para>
  <para style="q1" vid="SNG 5:5">Morno ma nengone tek mane ni e lith lweta nomieno</para>
  <para style="q2" vid="SNG 5:5">pata mar dhoot.<verse eid="SNG 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6"/>Ne ayawone jaherana,</para>
  <para style="q2" vid="SNG 5:6">mi ayudo ka jaherana osewuok kendo osea!</para>
  <para style="q2" vid="SNG 5:6">Chunya norumo kane odhi oyomba.</para>
  <para style="q1" vid="SNG 5:6">Ne amanye, to ne ok ayude.</para>
  <para style="q2" vid="SNG 5:6">Ne aluonge, to ne ok odwoka.<verse eid="SNG 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7"/>Jorito noromo koda</para>
  <para style="q2" vid="SNG 5:7">kane giwuotho gotieno e alwora mar dala.</para>
  <para style="q1" vid="SNG 5:7">Ne gigoya marach ma gihinya;</para>
  <para style="q2" vid="SNG 5:7">kendo jorito marichogo,</para>
  <para style="q2" vid="SNG 5:7">ne omaya lawa!<verse eid="SNG 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8"/>Amiyou chik, un nyi Jerusalem</para>
  <para style="q2" vid="SNG 5:8">ni ka uyudo jaherana,</para>
  <para style="q1" vid="SNG 5:8">to ubiro nyise nangʼo?</para>
  <para style="q2" vid="SNG 5:8">Nyiseuru ni hera ma aherego odwaro nega?<verse eid="SNG 5:8"/></para>
  <para style="sp">Osiepe</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9"/>Ere kaka jaherani oloyo chwo mamoko,</para>
  <para style="q2" vid="SNG 5:9">yaye jaber mogik e dier nyiri mabeyo duto?</para>
  <para style="q1" vid="SNG 5:9">Ere kaka jaherani oloyo chwo mamoko,</para>
  <para style="q2" vid="SNG 5:9">momiyo imiyowa chik ma kamano?<verse eid="SNG 5:9"/></para>
  <para style="sp">Nyako</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10"/>Jaherana rieny kendo rapudo,</para>
  <para style="q2" vid="SNG 5:10">oloyo chwo alufu apar.<verse eid="SNG 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11"/>Wiye chalo dhahabu maler,</para>
  <para style="q2" vid="SNG 5:11">yie wiye beyo kendo boyo,</para>
  <para style="q2" vid="SNG 5:11">bende yie wiyego ratengʼ ka yie agak.<verse eid="SNG 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12"/>Wengene chalo akuru</para>
  <para style="q2" vid="SNG 5:12">mopiyo but aore mamol,</para>
  <para style="q1" vid="SNG 5:12">moluoki gi chak,</para>
  <para style="q2" vid="SNG 5:12">kendo ochan kaka kite ma nengogi tek.<verse eid="SNG 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13"/>Lembe chalo gi apilo mokuogi</para>
  <para style="q2" vid="SNG 5:13">magolo suya mamit.</para>
  <para style="q1" vid="SNG 5:13">Pien dhoge chalo ondanyo,</para>
  <para style="q2" vid="SNG 5:13">ma mo madungʼ tik mangʼwe ngʼar tonie.<verse eid="SNG 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14"/>Bedene chalo gi luth mar dhahabu,</para>
  <para style="q2" vid="SNG 5:14">mokedi gi kite ma nengongi tek.</para>
  <para style="q1" vid="SNG 5:14">Dende chalo gi lak liech moywe maler,</para>
  <para style="q2" vid="SNG 5:14">mokedi gi kit safir.<verse eid="SNG 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15"/>Tiendene chalo gi sirni mag kit ombo</para>
  <para style="q2" vid="SNG 5:15">mochungʼ e mise mag dhahabu maler.</para>
  <para style="q1" vid="SNG 5:15">Onenore ka got mar Lebanon,</para>
  <para style="q2" vid="SNG 5:15">kendo ongʼongʼore ka bepe sida mag Lebanon.<verse eid="SNG 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16"/>Mano kaka dhoge mit nyodho,</para>
  <para style="q2" vid="SNG 5:16">kendo ober moloyo chwo mamoko.</para>
  <para style="q1" vid="SNG 5:16">Mano e jaherana, mano e osiepna,</para>
  <para style="q2" vid="SNG 5:16">yaye nyi Jerusalem.<verse eid="SNG 5:16"/></para>
  <chapter eid="SNG 5"/>
  <chapter number="6" style="c" sid="SNG 6"/>
  <para style="sp">Osiepe</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1"/>Jaherani olal kune,</para>
  <para style="q2" vid="SNG 6:1">yaye jaber mogik e dier nyiri mabeyo?</para>
  <para style="q1" vid="SNG 6:1">Jaherani ne oluwo kanye,</para>
  <para style="q2" vid="SNG 6:1">mondo wakonyi manye?<verse eid="SNG 6:1"/></para>
  <para style="sp">Nyako</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2"/>Jaherana osedhi e puothe,</para>
  <para style="q2" vid="SNG 6:2">kama gik mangʼwe ngʼar dongoe,</para>
  <para style="q1" vid="SNG 6:2">mondo omeny ei puothe</para>
  <para style="q2" vid="SNG 6:2">kendo ochok ondanyo.<verse eid="SNG 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3"/>Jaherana en mara kendo an bende an mare;</para>
  <para style="q2" vid="SNG 6:3">omiyo omenyo e dier ondanyo.<verse eid="SNG 6:3"/></para>
  <para style="sp">Wuowi</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4"/>Jaherana, ijaber mana ka Tirza,</para>
  <para style="q2" vid="SNG 6:4">ilongʼo mana ka Jerusalem,</para>
  <para style="q2" vid="SNG 6:4">ichanori mana ka jolweny motingʼo bendeche.<verse eid="SNG 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5"/>Gol wengegi kuoma;</para>
  <para style="q2" vid="SNG 6:5">nikech giberna.</para>
  <para style="q1" vid="SNG 6:5">Yie wiyi chalo kweth mag diek,</para>
  <para style="q2" vid="SNG 6:5">malor koa e got Gilead.<verse eid="SNG 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6"/>Lekeni tar mana ka kweth mag rombe</para>
  <para style="q2" vid="SNG 6:6">mowuok kar luok.</para>
  <para style="q1" vid="SNG 6:6">Moro ka moro wuotho gi nyithinde ma rude</para>
  <para style="q2" vid="SNG 6:6">kendo onge moro man kende.<verse eid="SNG 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7"/>Lembi ma iumo gi nanga</para>
  <para style="q2" vid="SNG 6:7">chalo gi olemo mongʼinore mochiek makwar.<verse eid="SNG 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8"/>Ruoth nigi mon piero auchiel</para>
  <para style="q2" vid="SNG 6:8">gi mon mamoko piero aboro,</para>
  <para style="q2" vid="SNG 6:8">kod nyiri mapok ongʼeyo chwo mokadho akwana.<verse eid="SNG 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9"/>To an ahero mana nyako achiel kende,</para>
  <para style="q2" vid="SNG 6:9">ma jaber ka akuru, en e nyar min kende,</para>
  <para style="q2" vid="SNG 6:9">mohero malich.</para>
  <para style="q1" vid="SNG 6:9">Jotich ma nyiri konene, to luonge ni nyako mogwedhi,</para>
  <para style="q2" vid="SNG 6:9">to mond ruoth kod mon mamoko konene to pake.<verse eid="SNG 6:9"/></para>
  <para style="sp">Osiepe</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10"/>Ma to en ngʼa mabiro apoya ka piny madwa ru?</para>
  <para style="q2" vid="SNG 6:10">Adier, ober ka dwe kendo ongʼangʼni ka wangʼ chiengʼ,</para>
  <para style="q2" vid="SNG 6:10">bende ochanore ka sulwe moriedo.<verse eid="SNG 6:10"/></para>
  <para style="sp">Wuowi</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11"/>Ne alor mwalo nyaka e puoth mananas,</para>
  <para style="q2" vid="SNG 6:11">mondo ane kaka gidongo e holo,</para>
  <para style="q1" vid="SNG 6:11">kendo mondo ane ka mzabibu osechako golo maua</para>
  <para style="q2" vid="SNG 6:11">kata ka olemo mongʼinore osechako chiek makwar.<verse eid="SNG 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12"/>Apoya nono, kapok angʼeyo,</para>
  <para style="q2" vid="SNG 6:12">gombona notingʼa motera nyaka dier geche joka ruoth.<verse eid="SNG 6:12"/></para>
  <para style="sp">Osiepe</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13"/>Yie iduogi, yie iduogi, yaye nyar jo-Shulam;</para>
  <para style="q2" vid="SNG 6:13">yie iduogi, yie iduogi, mondo waneni!</para>
  <para style="sp" vid="SNG 6:13">Wuowi</para>
  <para style="q1" vid="SNG 6:13">Ere gima omiyo ungʼiyo nyar jo-Shulam kamano,</para>
  <para style="q2" vid="SNG 6:13">mana ka gima omielo miend Mahanaim?<verse eid="SNG 6:13"/></para>
  <para style="b"/>
  <chapter eid="SNG 6"/>
  <chapter number="7" style="c" sid="SNG 7"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1"/>Mano kaka tiendeni beyo kirwako pat pat,</para>
  <para style="q2" vid="SNG 7:1">yaye nyar joka ruoth!</para>
  <para style="q1" vid="SNG 7:1">Tiendeni pichni ka kite ma nengogi tek,</para>
  <para style="q2" vid="SNG 7:1">ka gima jopecho molony ema opayo.<verse eid="SNG 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2"/>Pendi ogomo ka wend agwata,</para>
  <para style="q2" vid="SNG 7:2">ma divai moru maber ok rumie.</para>
  <para style="q1" vid="SNG 7:2">Nungoni chalo pidh ngano mochok kaachiel,</para>
  <para style="q2" vid="SNG 7:2">ma ondanyo olworo koni gi koni.<verse eid="SNG 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3"/>Thundeni chalo gi nyithind mwanda ariyo,</para>
  <para style="q2" vid="SNG 7:3">gichalo gi nyithind mwanda ma rude.<verse eid="SNG 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4"/>Ngʼuti chalo gi kar ngʼicho</para>
  <para style="q2" vid="SNG 7:4">motingʼore gi malo molos gi lak liech.</para>
  <para style="q1" vid="SNG 7:4">Wengeni nyawni ka pi Yawo mar Heshbon</para>
  <para style="q2" vid="SNG 7:4">but rangach mar Bath Rabim.</para>
  <para style="q1" vid="SNG 7:4">Umi chalo gi kar ngʼicho motingʼore gi malo</para>
  <para style="q2" vid="SNG 7:4">mar Lebanon momanyore gi Damaski.<verse eid="SNG 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5"/>Wiyi miyi duongʼ mana ka Got Karmel,</para>
  <para style="q2" vid="SNG 7:5">yie wiyi to ochanore ka orengo mar ruoth,</para>
  <para style="q2" vid="SNG 7:5">kendo omako pach ruoth.<verse eid="SNG 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6"/>Mano kaka ijaber kendo imiya mor,</para>
  <para style="q2" vid="SNG 7:6">mano kaka imora, yaye jaherana!<verse eid="SNG 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7"/>Dendi odongo mana ka othith,</para>
  <para style="q2" vid="SNG 7:7">to thundi to chalo mana ka olemo,</para>
  <para style="q2" vid="SNG 7:7">mogudore kanyachiel.<verse eid="SNG 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8"/>Ne awacho niya,</para>
  <para style="q2" vid="SNG 7:8">“Abiro lwenyo yiend othith;</para>
  <para style="q1" vid="SNG 7:8">nyaka amak olembe gi lweta.”</para>
  <para style="q2" vid="SNG 7:8">Mad thundeni chal gi olemb,</para>
  <para style="q1" vid="SNG 7:8">mzabibu mochokore kanyachiel,</para>
  <para style="q2" vid="SNG 7:8">to tik mar muchi chal gi olemo mayom,<verse eid="SNG 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 7:9"/>kendo dhogi chal mana gi divai mamit.</para>
  <para style="sp" vid="SNG 7:9">Nyako</para>
  <para style="q1" vid="SNG 7:9">Mad divai lor mos e dwond jaherana,</para>
  <para style="q2" vid="SNG 7:9">kamol mos e kind lewe kod lekene komadhe.<verse eid="SNG 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10"/>An mar jaherana,</para>
  <para style="q2" vid="SNG 7:10">kendo gombone ni kuoma.<verse eid="SNG 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11"/>Bi, jaherana, bi wadhi waba ei gwengʼ,</para>
  <para style="q2" vid="SNG 7:11">kendo wanind oko e bunge.<verse eid="SNG 7:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="SNG 7:12"/>Bi wamondi gokinyi wadhi,</para>
  <para style="q2" vid="SNG 7:12">e puothe mzabibu mondo wangʼiane,</para>
  <para style="q1" vid="SNG 7:12">ka mzabibu oseolo,</para>
  <para style="q2" vid="SNG 7:12">bende wangʼiane ka gisechako thiewo,</para>
  <para style="q1" vid="SNG 7:12">kendo ka olembe mongʼinore oselokore makwar;</para>
  <para style="q2" vid="SNG 7:12">kuno, ema abiro miyie herana.<verse eid="SNG 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13"/>Kuno ema inyalo winjoe tik mar mandrake,</para>
  <para style="q2" vid="SNG 7:13">kendo e odwa kanyo okanni gik mamit,</para>
  <para style="q1" vid="SNG 7:13">motingʼo gik machon gi manyien,</para>
  <para style="q2" vid="SNG 7:13">ma asebedo ka akanoni, yaye jaherana.<verse eid="SNG 7:13"/></para>
  <para style="b"/>
  <chapter eid="SNG 7"/>
  <chapter number="8" style="c" sid="SNG 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1"/>Ka dine ibedna owadwa mahie,</para>
  <para style="q2" vid="SNG 8:1">mane wadhodhogo thuno achiel,</para>
  <para style="q1" vid="SNG 8:1">to dine anyodhi, kapo ni ayudi oko,</para>
  <para style="q2" vid="SNG 8:1">kendo onge ngʼama dine ochaya.<verse eid="SNG 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2"/>Dine amako badi, mi akeli nyaka</para>
  <para style="q2" vid="SNG 8:2">e od minwa kama ne opuonjae.</para>
  <para style="q1" vid="SNG 8:2">Dine amiyi divai moketie yedhe madungʼ tik mamit mondo imadhi;</para>
  <para style="q2" vid="SNG 8:2">kendo dine amiyi olemo mongʼinore makwar.<verse eid="SNG 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3"/>Bade ma koracham oteno wiya,</para>
  <para style="q2" vid="SNG 8:3">to bade ma korachwich okwaka.<verse eid="SNG 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4"/>Un nyi Jerusalem, asiemou ni kik</para>
  <para style="q2" vid="SNG 8:4">utug hera kata chiewe ka sa ne pok oromo.<verse eid="SNG 8:4"/></para>
  <para style="sp">Osiepe</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5"/>Mano to ngʼa mabiro koa e piny motimo ongoro</para>
  <para style="q2" vid="SNG 8:5">koyiengore kuom jaherane?</para>
  <para style="sp" vid="SNG 8:5">Nyako</para>
  <para style="q1" vid="SNG 8:5">Ne achiewe e bwo yadh olemo mayom;</para>
  <para style="q2" vid="SNG 8:5">kanyo ema ne minu omake ichni,</para>
  <para style="q2" vid="SNG 8:5">kendo kanyo ema ngʼat mane muoch okayo nonywolie.<verse eid="SNG 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6"/>Para e chunyi kinde duto,</para>
  <para style="q2" vid="SNG 8:6">kendo wiyi kik wil koda;</para>
  <para style="q1" vid="SNG 8:6">nikech hera nigi teko mana ka tho, kendo nyiego ma</para>
  <para style="q2" vid="SNG 8:6">hera nigo tut mana ka bur tho.</para>
  <para style="q1" vid="SNG 8:6">Herano liel ka mach mabebni,</para>
  <para style="q2" vid="SNG 8:6">kendo mana ka ligek mach maduongʼ.<verse eid="SNG 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7"/>Pige mathoth ok nyal nego hera;</para>
  <para style="q2" vid="SNG 8:7">kendo kata aore maringo ok nyal ywere.</para>
  <para style="q1" vid="SNG 8:7">Ka dipo ni ngʼato dichiw mwandu duto mag ode</para>
  <para style="q2" vid="SNG 8:7">mondo oyud hera, to mano dibed fuwo maduongʼ.<verse eid="SNG 8:7"/></para>
  <para style="sp">Osiepe</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8"/>Wan gi nyaminwa moro matin,</para>
  <para style="q2" vid="SNG 8:8">kendo thundene pok obedo madongo.</para>
  <para style="q1" vid="SNG 8:8">Angʼo mwanyalo timone</para>
  <para style="q2" vid="SNG 8:8">nyaminwa chiengʼ ma wuowi obiro dware?<verse eid="SNG 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9"/>Ka dine bed ni en ohinga,</para>
  <para style="q2" vid="SNG 8:9">to dine wagero osuch fedha kuome.</para>
  <para style="q1" vid="SNG 8:9">To ka dine obed ni en dhoot,</para>
  <para style="q2" vid="SNG 8:9">to dine walore gi thigo mar bap sida.<verse eid="SNG 8:9"/></para>
  <para style="sp">Nyako</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10"/>An to an ohinga,</para>
  <para style="q2" vid="SNG 8:10">kendo thundena ochungʼ,</para>
  <para style="q1" vid="SNG 8:10">ka ohinga moger motingʼore gi malo.</para>
  <para style="q2" vid="SNG 8:10">Kuom mano, asebedone wangʼ monenogo,</para>
  <para style="q2" vid="SNG 8:10">kendo asemiyo obedo gi kwe.<verse eid="SNG 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11"/>Solomon ne nigi puoth</para>
  <para style="q2" vid="SNG 8:11">mzabibu kama iluongo ni Baal Hamon;</para>
  <para style="q1" vid="SNG 8:11">kendo ne oketo puotheno e lwet jopur.</para>
  <para style="q2" vid="SNG 8:11">Moro ka moro kuomgi nonego chul Solomon kilo,</para>
  <para style="q1" vid="SNG 8:11">apar gachiel gi nus mar fedha kuom olembene.<verse eid="SNG 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12"/>An to an gi puotha awuon mar mzabibu;</para>
  <para style="q2" vid="SNG 8:12">to in Solomon in to bed abeda gi kilo apar gachiel,</para>
  <para style="q1" vid="SNG 8:12">gi nusgo miyudo kuom jopur,</para>
  <para style="q2" vid="SNG 8:12">to un jopur un bende beduru abeda gi kilo,</para>
  <para style="q2" vid="SNG 8:12">ariyo gi nusgo moyudo kuom poku.<verse eid="SNG 8:12"/></para>
  <para style="sp">Wuowi</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13"/>In midak e puothe mzabibu</para>
  <para style="q2" vid="SNG 8:13">kaachiel gi osiepeni mabudhi,</para>
  <para style="q2" vid="SNG 8:13">yie awinjie dwondi gie puodho kuno!<verse eid="SNG 8:13"/></para>
  <para style="sp">Nyako</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14"/>Bi wadhi, jaherana,</para>
  <para style="q2" vid="SNG 8:14">kendo chal gi mwanda kata le,</para>
  <para style="q1" vid="SNG 8:14">mamoko manie thim mochungʼ</para>
  <para style="q2" vid="SNG 8:14">ewi gode mopongʼ gi yedhe madungʼ tik mangʼwe ngʼar.<verse eid="SNG 8:14"/></para>
  <chapter eid="SNG 8"/>
</usx>
