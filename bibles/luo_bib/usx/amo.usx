<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Biblica® Open New Luo Translation 2020</book>
  <para style="h">Amos</para>
  <para style="toc1">Amos</para>
  <para style="toc2">Amos</para>
  <para style="toc3">Amo</para>
  <para style="mt1">Amos</para>
  <chapter number="1" style="c" sid="AMO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1"/>Magi e weche Amos mane en achiel kuom jokwath mane odak Tekoa. Wechegi ne oneno kuom Israel higni ariyo kane piny pok oyiengni, kendo e kindeno Uzia ema ne ruodh Juda, to Jeroboam ma wuod Joash to ne ruodh Israel.<verse eid="AMO 1:1"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2"/>Nowacho niya,</para>
  <para style="q1" vid="AMO 1:2">“Jehova Nyasaye ruto koa Sayun,</para>
  <para style="q2" vid="AMO 1:2">kendo dwonde mor koa Jerusalem;</para>
  <para style="q1" vid="AMO 1:2">lege ma jokwath kwayoe two,</para>
  <para style="q2" vid="AMO 1:2">kendo wi got Karmel mosebedo ka ngʼich koro ner.”<verse eid="AMO 1:2"/></para>
  <para style="s1">Bura mibiro ngʼado ni ogendini modak mokiewo gi jo-Israel</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3"/>Jehova Nyasaye wacho niya,</para>
  <para style="q1" vid="AMO 1:3">“Jo-Damaski osebedo katimo richo mangʼeny,</para>
  <para style="q2" vid="AMO 1:3">omiyo ok abi weyo ma ok akumogi.</para>
  <para style="q1" vid="AMO 1:3">Nikech gisesando jo-Gilead,</para>
  <para style="q2" vid="AMO 1:3">ka gigoyogi kod gima bith molos gi nyinyo,<verse eid="AMO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4"/>kuom mano abiro oro mach e od Hazael,</para>
  <para style="q2" vid="AMO 1:4">ma biro wangʼo ohinga mochiel motegno mag Ben-Hadad.<verse eid="AMO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5"/>Abiro muko dhoranga Damaski,</para>
  <para style="q2" vid="AMO 1:5">kendo abiro riembo joma odak e Holo mar Aven,</para>
  <para style="q1" vid="AMO 1:5">kaachiel gi ngʼat motingʼo ludh Jehova Nyasaye man Beth Eden.</para>
  <para style="q2" vid="AMO 1:5">Jo-Aram ibiro dar miter mabor e twech e piny Kir,”</para>
  <para style="q2" vid="AMO 1:5">Jehova Nyasaye owacho.<verse eid="AMO 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6"/>Jehova Nyasaye wacho niya,</para>
  <para style="q1" vid="AMO 1:6">“Jo-Gaza osebedo katimo richo mangʼeny,</para>
  <para style="q2" vid="AMO 1:6">omiyo ok abi weyo ma ok akumogi.</para>
  <para style="q1" vid="AMO 1:6">Nikech gisemako ogendini duto</para>
  <para style="q2" vid="AMO 1:6">mi giterogi e twech e piny Edom,<verse eid="AMO 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7"/>kuom mano abiro oro mach</para>
  <para style="q2" vid="AMO 1:7">mi owangʼ ohinga mag Gaza mochiel motegno.<verse eid="AMO 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8"/>Abiro riembo ruodh Ashdod</para>
  <para style="q2" vid="AMO 1:8">kaachiel gi ngʼat motingʼo ludh Jehova Nyasaye man Ashkelon.</para>
  <para style="q1" vid="AMO 1:8">Abiro kumo dala mar Ekron,</para>
  <para style="q2" vid="AMO 1:8">kendo abiro nego jo-Filistia duto modongʼ,”</para>
  <para style="q2" vid="AMO 1:8">Jehova Nyasaye Manyalo Gik Moko Duto owacho.<verse eid="AMO 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9"/>Jehova Nyasaye wacho niya,</para>
  <para style="q1" vid="AMO 1:9">“Nikech richo adek ma jo-Turo osetimo,</para>
  <para style="q2" vid="AMO 1:9">kata richo angʼwen, omiyo ok abi weyo ma ok akumogi.</para>
  <para style="q1" vid="AMO 1:9">Nikech gisemako ogendini duto mi giterogi e twech e piny Edom,</para>
  <para style="q2" vid="AMO 1:9">ma ok girito winjruok mar osiep mane gitimo kodgi,<verse eid="AMO 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10"/>kuom mano abiro oro mach</para>
  <para style="q2" vid="AMO 1:10">mi wangʼ ohinga mag Turo mochiel motegno.”<verse eid="AMO 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11"/>Jehova Nyasaye wacho niya,</para>
  <para style="q1" vid="AMO 1:11">“Nikech richo adek ma jo-Edom osetimo,</para>
  <para style="q2" vid="AMO 1:11">kata richo angʼwen, omiyo ok abi weyo ma ok akumogi.</para>
  <para style="q1" vid="AMO 1:11">Nikech nolawo owadgi gi ligangla</para>
  <para style="q2" vid="AMO 1:11">ka oonge gi ngʼwono,</para>
  <para style="q1" vid="AMO 1:11">kendo ne osiko mana</para>
  <para style="q2" vid="AMO 1:11">ka omako kode sadha,<verse eid="AMO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12"/>kuom mano, abiro oro mach mi wangʼ Teman,</para>
  <para style="q2" vid="AMO 1:12">kendo enowangʼ ohinga mochiel motegno mag Bozra.”<verse eid="AMO 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13"/>Jehova Nyasaye wacho niya,</para>
  <para style="q1" vid="AMO 1:13">“Nikech richo adek ma jo-Amon osetimo,</para>
  <para style="q2" vid="AMO 1:13">kata richo angʼwen, omiyo ok abi weyo ma ok akumogi.</para>
  <para style="q1" vid="AMO 1:13">Nikech gisenego mine ma yach mag Gilead</para>
  <para style="q2" vid="AMO 1:13">mondo omi giyar tongʼ mag lopegi,<verse eid="AMO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14"/>kuom mano abiro moko mach e ohinga mag Raba</para>
  <para style="q2" vid="AMO 1:14">kendo abiro wangʼo kuonde mochiel motegno mag dalano.</para>
  <para style="q1" vid="AMO 1:14">Mahu nowinjre chiengʼ kedo</para>
  <para style="q2" vid="AMO 1:14">kendo lweny nobed mager.<verse eid="AMO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15"/>Ruodhigi kaachiel gi jodong-gi</para>
  <para style="q2" vid="AMO 1:15">ibiro daro miter e twech,”</para>
  <para style="q2" vid="AMO 1:15">Jehova Nyasaye owacho.<verse eid="AMO 1:15"/></para>
  <chapter eid="AMO 1"/>
  <chapter number="2" style="c" sid="AMO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1"/>Jehova Nyasaye wacho niya,</para>
  <para style="q1" vid="AMO 2:1">“Nikech richo adek ma jo-Moab osetimo, kata richo angʼwen,</para>
  <para style="q2" vid="AMO 2:1">omiyo ok abi weyo ma ok akumogi.</para>
  <para style="q1" vid="AMO 2:1">Nikech ne giwangʼo</para>
  <para style="q2" vid="AMO 2:1">choke mag ruodh Edom molokore buru,<verse eid="AMO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2"/>kuom mano abiro oro mach e piny Moab</para>
  <para style="q2" vid="AMO 2:2">mondo owangʼ kuonde mochiel motegno mag Kerioth.</para>
  <para style="q1" vid="AMO 2:2">Jo-Moab biro tho ei lweny mager,</para>
  <para style="q2" vid="AMO 2:2">ka jolweny giyo sigich lweny kendo tungʼ ywak.<verse eid="AMO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3"/>Abiro nego ruodh Moab</para>
  <para style="q2" vid="AMO 2:3">kaachiel gi jotend pinyno duto,”</para>
  <para style="q2" vid="AMO 2:3">Jehova Nyasaye owacho.<verse eid="AMO 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4"/>Jehova Nyasaye wacho niya,</para>
  <para style="q1" vid="AMO 2:4">“Nikech richo adek ma jo-Juda osetimo, kata richo angʼwen,</para>
  <para style="q2" vid="AMO 2:4">omiyo ok abi weyo ma ok akumogi.</para>
  <para style="q1" vid="AMO 2:4">Nikech gisetamore rito chike Jehova Nyasaye</para>
  <para style="q2" vid="AMO 2:4">kod buchene,</para>
  <para style="q1" vid="AMO 2:4">kendo osewuondgi</para>
  <para style="q2" vid="AMO 2:4">mi gisebaro giluwo bangʼ nyiseche manono mag kweregi,<verse eid="AMO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5"/>kuom mano abiro oro mach e piny Juda,</para>
  <para style="q2" vid="AMO 2:5">kod kuonde mochiel motegno mag Jerusalem.”<verse eid="AMO 2:5"/></para>
  <para style="s1">Bura ma ibiro ngʼadne jo-Israel</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6"/>Jehova Nyasaye wacho niya,</para>
  <para style="q1" vid="AMO 2:6">“Nikech richo adek ma jo-Israel osetimo, kata richo angʼwen,</para>
  <para style="q2" vid="AMO 2:6">omiyo ok abi weyo ma ok akumogi.</para>
  <para style="q1" vid="AMO 2:6">Nikech ungʼiewo joma kare gi fedha,</para>
  <para style="q2" vid="AMO 2:6">to joma odhier ma ok nyal chudo, to ungʼiewo gi pat pat.<verse eid="AMO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7"/>Unyono jochan piny mana ka buru</para>
  <para style="q2" vid="AMO 2:7">kendo ok ungʼad bura makare,</para>
  <para style="q2" vid="AMO 2:7">ne joma odhier.</para>
  <para style="q1" vid="AMO 2:7">Wuowi gi wuon mare terore gi nyako achiel</para>
  <para style="q2" vid="AMO 2:7">kendo udwanyo Nyinga Maler.<verse eid="AMO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8"/>Ginindo piny</para>
  <para style="q2" vid="AMO 2:8">e lewni mosing but kende mag misango.</para>
  <para style="q1" vid="AMO 2:8">Divai ma gikawo kuom joma gigoyo faini</para>
  <para style="q2" vid="AMO 2:8">gimadho e od nyasachgi.<verse eid="AMO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9"/>“Ne atieko jo-Amor mana ka gineno,</para>
  <para style="q2" vid="AMO 2:9">kata obedo nine gin roboche ka yiend sida,</para>
  <para style="q2" vid="AMO 2:9">kendo roteke ka yiend ober.</para>
  <para style="q1" vid="AMO 2:9">Ne aketho olembene</para>
  <para style="q2" vid="AMO 2:9">kod tiendene!<verse eid="AMO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10"/>Ne agolou e piny Misri,</para>
  <para style="q2" vid="AMO 2:10">mi atelonu higni piero angʼwen e thim,</para>
  <para style="q2" vid="AMO 2:10">ni mondo amiu piny jo-Amor.<verse eid="AMO 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11"/>“Ne awalo yawuotu mondo obed jonabi,</para>
  <para style="q2" vid="AMO 2:11">to moko e dieru naketo mondo obed jo-Nazir.</para>
  <para style="q1" vid="AMO 2:11">Donge mano en adier, yaye jo-Israel?”</para>
  <para style="q2" vid="AMO 2:11">Jehova Nyasaye owacho.<verse eid="AMO 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12"/>“Ne umiyo jo-Nazir omadho divai,</para>
  <para style="q2" vid="AMO 2:12">kendo nukwero jonabi ni kik gikor wach.<verse eid="AMO 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13"/>“Sani koro abiro diyou piny kama untie,</para>
  <para style="q2" vid="AMO 2:13">mana ka cham mopongʼo gari mayiecho gari.<verse eid="AMO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14"/>Joma ongʼeyo ngʼwech sani koro ok bi tony,</para>
  <para style="q2" vid="AMO 2:14">joma rateke abiro keto bedo mool,</para>
  <para style="q2" vid="AMO 2:14">bende nyaka jalweny manenore ni ger ok bi konyo ngimane.<verse eid="AMO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15"/>Kata jadir asere ok noyud thuolo mar ringo,</para>
  <para style="q2" vid="AMO 2:15">kendo jangʼwech ma jalweny ok noresre,</para>
  <para style="q2" vid="AMO 2:15">kaachiel gi jalweny moidho faras bende ok notony.<verse eid="AMO 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16"/>To kata mana jolweny mathuondi moloyo</para>
  <para style="q2" vid="AMO 2:16">noring duge chiengʼno,”</para>
  <para style="q2" vid="AMO 2:16">Jehova Nyasaye owacho.<verse eid="AMO 2:16"/></para>
  <chapter eid="AMO 2"/>
  <chapter number="3" style="c" sid="AMO 3"/>
  <para style="s1">Oluong joneno mondo ongʼad bura ni jo-Israel</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1"/>Un oganda jo-Israel duto mane agolo e piny Misri, winjuru wach ma an Jehova Nyasaye awachonu:<verse eid="AMO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2"/>“Un kende ema aseyiero</para>
  <para style="q2" vid="AMO 3:2">kuom ogendini duto manie piny;</para>
  <para style="q1" vid="AMO 3:2">mano emomiyo abiro kumou</para>
  <para style="q2" vid="AMO 3:2">kuom richou duto musetimo.”<verse eid="AMO 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3"/>Uparo ni ji ariyo nyalo wuotho kaachiel</para>
  <para style="q2" vid="AMO 3:3">kapok giwinjore?<verse eid="AMO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4"/>Bende sibuor nyalo ruto e thim</para>
  <para style="q2" vid="AMO 3:4">ka oonge gi gima ochamo?</para>
  <para style="q1" vid="AMO 3:4">Bende nyathi sibuor nyalo ngʼur e gono mare</para>
  <para style="q2" vid="AMO 3:4">kapok oyudo gima ochamo?<verse eid="AMO 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5"/>Koso winyo nyalo moko e obadho nade</para>
  <para style="q2" vid="AMO 3:5">ka ok ochike gi kudni?</para>
  <para style="q1" vid="AMO 3:5">Koso obadho dimeki nade</para>
  <para style="q2" vid="AMO 3:5">kaonge gima otuge?<verse eid="AMO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6"/>Bende tungʼ mar lweny nyalo ywak e dala</para>
  <para style="q2" vid="AMO 3:6">ma ok omiyo ji otetni?</para>
  <para style="q1" vid="AMO 3:6">Koso ere gima nyalo timore e dala</para>
  <para style="q2" vid="AMO 3:6">ma ok Jehova Nyasaye ema oyie mondo otimre?<verse eid="AMO 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7"/>Adier, onge gima Jehova Nyasaye Manyalo Gik Moko Duto nyalo timo e dala</para>
  <para style="q2" vid="AMO 3:7">ma ok ofwenyo, ne jotichne ma jonabi.<verse eid="AMO 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8"/>Ka sibuor oruto,</para>
  <para style="q2" vid="AMO 3:8">to ere ngʼama ok dibed maluor?</para>
  <para style="q1" vid="AMO 3:8">Kata ere janabi madilingʼ alingʼa</para>
  <para style="q2" vid="AMO 3:8">ma ok ohulo gima Jehova Nyasaye Manyalo Gik Moko Duto onyise?<verse eid="AMO 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9"/>Gouru milome e kuonde mochiel motegno mag Ashdod</para>
  <para style="q2" vid="AMO 3:9">kaachiel gi Misri:</para>
  <para style="q1" vid="AMO 3:9">“Chokreuru kanyakla e gode molworo Samaria,</para>
  <para style="q2" vid="AMO 3:9">mondo uneye timbe mamono matimore e dalano,</para>
  <para style="q2" vid="AMO 3:9">kendo kaka isando ji kuno.”<verse eid="AMO 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10"/>Jehova Nyasaye wacho niya, “Jogo ok ongʼeyo timo tim makare</para>
  <para style="q2" vid="AMO 3:10">kendo utegi madongogi opongʼ mana gi gik moyaki.”<verse eid="AMO 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11"/>Kuom mano, ma e gima Jehova Nyasaye Manyalo Gik Moko Duto wacho:</para>
  <para style="q1" vid="AMO 3:11">“Wasigu biro monjou</para>
  <para style="q2" vid="AMO 3:11">maketh kuondeu mochiel motegno,</para>
  <para style="q2" vid="AMO 3:11">kendo giyak mwandu magu.”<verse eid="AMO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12"/>Jehova Nyasaye wacho niya,</para>
  <para style="q1" vid="AMO 3:12">“Mana kaka jakwath reso lemo ariyo kata it rombo modongʼ ma sibuor pok ochamo,</para>
  <para style="q2" vid="AMO 3:12">e kaka Nyasaye nores,</para>
  <para style="q1" vid="AMO 3:12">jo-Israel manok modak Samaria</para>
  <para style="q2" vid="AMO 3:12">ka gin e dho kitandagi,</para>
  <para style="q2" vid="AMO 3:12">kaachiel gi man Damaski ka gibet e kombegi.”<verse eid="AMO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13"/>Ruoth Nyasaye, ma en Jehova Nyasaye Maratego wacho niya, “Koro chikuru itu mondo usiem nyikwa Jakobo.<verse eid="AMO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14"/>“Chiengʼ ma abiro kumoe nyithi Israel kuom richogi,</para>
  <para style="q2" vid="AMO 3:14">bende e ndalo ma abiro kethoe kende mag misango miwangʼoe liswa man Bethel,</para>
  <para style="q1" vid="AMO 3:14">kendo anangʼad tunge kendego mag misango</para>
  <para style="q2" vid="AMO 3:14">mi ginipodh piny.<verse eid="AMO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15"/>Anamuk udi mudakie e ndalo mag chwiri</para>
  <para style="q2" vid="AMO 3:15">kaachiel gi mago mudakie ndalo mag oro;</para>
  <para style="q1" vid="AMO 3:15">udi ma ukedo igi gi lak liech biro dongʼ gundni</para>
  <para style="q2" vid="AMO 3:15">kendo uteu madongo duto abiro ketho,”</para>
  <para style="q2" vid="AMO 3:15">Jehova Nyasaye owacho.<verse eid="AMO 3:15"/></para>
  <chapter eid="AMO 3"/>
  <chapter number="4" style="c" sid="AMO 4"/>
  <para style="s1">Jo-Israel otamore duogo ir Nyasaye</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1"/>Winjuru wachni, un mond Samaria machwe ka dwesni ma Bashan,</para>
  <para style="q2" vid="AMO 4:1">un mon masando jochan, un muthago joma odhier,</para>
  <para style="q1" vid="AMO 4:1">kendo uwachone chwou niya,</para>
  <para style="q2" vid="AMO 4:1">“Kelnwa gik ma wanyalo madho!”<verse eid="AMO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2"/>Jehova Nyasaye Manyalo Gik Moko Duto osesingore niya,</para>
  <para style="q2" vid="AMO 4:2">“Ndalo biro chopo ma wasigu noywau gi olope kendo ngʼato ka ngʼato kuomu,</para>
  <para style="q2" vid="AMO 4:2">nochal mana ka rech ma olowu omako.<verse eid="AMO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3"/>Ginigolu oko mar dala</para>
  <para style="q2" vid="AMO 4:3">ka giluwo kodu kuonde momukore mag ohinga,</para>
  <para style="q1" vid="AMO 4:3">kendo gibiro witou oko kuchomo Hamon,”</para>
  <para style="q2" vid="AMO 4:3">Jehova Nyasaye owacho.<verse eid="AMO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4"/>“Dhiuru Bethel mondo utim richo;</para>
  <para style="q2" vid="AMO 4:4">kendo dhiuru Gilgal mondo umed timoe richo.</para>
  <para style="q1" vid="AMO 4:4">Keluru misengini magu okinyi kokinyi</para>
  <para style="q2" vid="AMO 4:4">kendo keluru achiel kuom apar magu bangʼ higni adek ka higni adek.<verse eid="AMO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5"/>Chiwuru makati moketie thowi kaka misango mar dwoko erokamano,</para>
  <para style="q2" vid="AMO 4:5">kendo landuru wach kusungoru,</para>
  <para style="q2" vid="AMO 4:5">un jo-Israel kuom chiwo mar hera,</para>
  <para style="q1" vid="AMO 4:5">nimar mano ema uwinjo</para>
  <para style="q2" vid="AMO 4:5">ka morou ka usiko kutimo,”</para>
  <para style="q2" vid="AMO 4:5">Jehova Nyasaye Manyalo Gik Moko Duto owacho.<verse eid="AMO 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6"/>“Ne akelo kech e miechu duto,</para>
  <para style="q2" vid="AMO 4:6">kendo nubedo maonge chiemo,</para>
  <para style="q1" vid="AMO 4:6">to kata kamano pod utamoru duogo ira,”</para>
  <para style="q2" vid="AMO 4:6">Jehova Nyasaye owacho.<verse eid="AMO 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7"/>“Ne amako koth mondo kik chue</para>
  <para style="q2" vid="AMO 4:7">kane pod odongʼ dweche adek to piny chiek.</para>
  <para style="q1" vid="AMO 4:7">Ne amiyo koth ochwe e mier moko,</para>
  <para style="q2" vid="AMO 4:7">to ok e mier mamoko.</para>
  <para style="q1" vid="AMO 4:7">Ne ochwe e puothe moko,</para>
  <para style="q2" vid="AMO 4:7">to puothe mane ok ochweye, to ne wangʼ.<verse eid="AMO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8"/>Ji ne wuotho awuotha e mier kamanyo pi modho,</para>
  <para style="q2" vid="AMO 4:8">kendo ne ok ginyal yudo pi moromogi,</para>
  <para style="q1" vid="AMO 4:8">to kata kuom mago duto pod utamoru duogo ira,”</para>
  <para style="q2" vid="AMO 4:8">Jehova Nyasaye owacho.<verse eid="AMO 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9"/>“Kuom kinde mangʼeny ne aoro dera</para>
  <para style="q2" vid="AMO 4:9">mi oketho chambu gi puotheu mag mzabibu.</para>
  <para style="q1" vid="AMO 4:9">Bonyo noketho puotheu mag ngʼowu kod mag zeituni,</para>
  <para style="q2" vid="AMO 4:9">to kata kuom mago duto pod utamoru duogo ira,”</para>
  <para style="q2" vid="AMO 4:9">mano e wach Jehova Nyasaye.<verse eid="AMO 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10"/>“Ne akelonu tuoche mag buche</para>
  <para style="q2" vid="AMO 4:10">machal gi mane akelo ni jo-Misri.</para>
  <para style="q1" vid="AMO 4:10">Ne anego yawuotu mangʼeny kod ligangla</para>
  <para style="q2" vid="AMO 4:10">kaachiel gi fareseu mag lweny.</para>
  <para style="q1" vid="AMO 4:10">Bende ne amiyo tik marach mar joma otho othingʼou e kuondeu mag bworo,</para>
  <para style="q2" vid="AMO 4:10">to kata kuom mago duto pod ne utamoru duoga ira,”</para>
  <para style="q2" vid="AMO 4:10">Jehova Nyasaye owacho.<verse eid="AMO 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11"/>“Ne atieko jomoko kuomu mana kaka ne atieko Sodom gi Gomora,</para>
  <para style="q2" vid="AMO 4:11">kendo ne uchalo mana gi yien moyudh kawangʼ e mach,</para>
  <para style="q1" vid="AMO 4:11">to kata kuom mago duto pod ne utamoru duoga ira,”</para>
  <para style="q2" vid="AMO 4:11">Jehova Nyasaye owacho.<verse eid="AMO 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12"/>“Kuom mano, ma e gima abiro timonu un jo-Israel,</para>
  <para style="q2" vid="AMO 4:12">to nikech abiro timonu kama,</para>
  <para style="q2" vid="AMO 4:12">koro ikreuru mondo urom gi Nyasachu, yaye Israel.”<verse eid="AMO 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13"/>Jal mane ochweyo gode</para>
  <para style="q2" vid="AMO 4:13">bende ema nochweyo yamo,</para>
  <para style="q2" vid="AMO 4:13">onyiso dhano parone,</para>
  <para style="q1" vid="AMO 4:13">bende en ema oloko ler mar odiechiengʼ bedo mudho,</para>
  <para style="q2" vid="AMO 4:13">en e ruodh piny duto;</para>
  <para style="q2" vid="AMO 4:13">nyinge en Jehova Nyasaye, ma Nyasaye Maratego.<verse eid="AMO 4:13"/></para>
  <chapter eid="AMO 4"/>
  <chapter number="5" style="c" sid="AMO 5"/>
  <para style="s1">Oluong jo-Israel mondo olokre</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1"/>Chikuru itu un dhood Israel mondo uwinjie wende ywak ma asechuogonu:<verse eid="AMO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2"/>“Israel ma en nyako ngili koro osepodho,</para>
  <para style="q2" vid="AMO 5:2">kendo ok nochak oa malo,</para>
  <para style="q1" vid="AMO 5:2">nimar osepodho e pinye owuon</para>
  <para style="q2" vid="AMO 5:2">maonge ngʼama nyalo chunge.”<verse eid="AMO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3"/>Jehova Nyasaye Manyalo Gik Moko Duto wacho niya,</para>
  <para style="q1" vid="AMO 5:3">“Dala maduongʼ mane ooro joge mag lweny alufu achiel mondo oked ne jo-Israel,</para>
  <para style="q2" vid="AMO 5:3">mia achiel kende ema biro duogo,</para>
  <para style="q1" vid="AMO 5:3">to mano mooro joge mag lweny mia achiel,</para>
  <para style="q2" vid="AMO 5:3">apar kende ema biro duogo.”<verse eid="AMO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4"/>Jehova Nyasaye wacho ni dhood Israel niya,</para>
  <para style="q1" vid="AMO 5:4">“Dwarauru eka unubed mangima,<verse eid="AMO 5:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 5:5"/>kik udhi Bethel,</para>
  <para style="q1" vid="AMO 5:5">kendo kik udhi Gilgal,</para>
  <para style="q2" vid="AMO 5:5">to bende kik ukadhi nyaka Bersheba,</para>
  <para style="q1" vid="AMO 5:5">nimar jo-Gilgal duto ibiro daro matergi e twech,</para>
  <para style="q2" vid="AMO 5:5">kendo Bethel biro mana lal nono.”<verse eid="AMO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6"/>Dwaruru Jehova Nyasaye eka unubed mangima,</para>
  <para style="q2" vid="AMO 5:6">nono to obiro tieko joka Josef ka mach mawengʼo,</para>
  <para style="q1" vid="AMO 5:6">en mach mabiro wangʼo jo-Bethel</para>
  <para style="q2" vid="AMO 5:6">maonge ngʼama nyalo nego.<verse eid="AMO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7"/>Mano en wach manade ka uloko bura makare bedo lit,</para>
  <para style="q2" vid="AMO 5:7">kendo utuono joga gik monego giyudi.<verse eid="AMO 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8"/>Jehova Nyasaye ema nochweyo Yugni gi Ratego,</para>
  <para style="q2" vid="AMO 5:8">en ema omiyo piny ru,</para>
  <para style="q2" vid="AMO 5:8">kendo yuso,</para>
  <para style="q1" vid="AMO 5:8">en bende ema oluongo pi nam</para>
  <para style="q2" vid="AMO 5:8">mondo obi, kendo ologi e piny,</para>
  <para style="q2" vid="AMO 5:8">nyinge iluongo ni Jehova Nyasaye.<verse eid="AMO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9"/>En ema oketho mier mochiel motegno</para>
  <para style="q2" vid="AMO 5:9">kendo omuko ohinga mag dala.<verse eid="AMO 5:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10"/>Un umon gi ngʼama odonjo ni jaketho,</para>
  <para style="q2" vid="AMO 5:10">kendo usin gi ngʼat mawacho adiera.<verse eid="AMO 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11"/>Usethiro joma odhier</para>
  <para style="q2" vid="AMO 5:11">ma kata cham matin magin godo usechunogi ma gimiyou kaka asoya.</para>
  <para style="q1" vid="AMO 5:11">Kuom mano, usegero udi mabeyo mag kidi,</para>
  <para style="q2" vid="AMO 5:11">to ok unudagie,</para>
  <para style="q1" vid="AMO 5:11">to bende ok unumadhi divai</para>
  <para style="q2" vid="AMO 5:11">mag mzabibu mabeyo musepidho,<verse eid="AMO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12"/>nikech aneno ka un kod ketho mangʼeny</para>
  <para style="q2" vid="AMO 5:12">kendo richou sani okadho akwana,</para>
  <para style="q1" vid="AMO 5:12">nikech usando joma ungʼeyo ni onge gi ketho,</para>
  <para style="q2" vid="AMO 5:12">kendo uchamo asoya,</para>
  <para style="q1" vid="AMO 5:12">to kata mana joma odhier manie dieru</para>
  <para style="q2" vid="AMO 5:12">bende utamo mondo kik yud bura makare.<verse eid="AMO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13"/>Emomiyo ngʼat mariek lingʼ alingʼa e kinde ma kama</para>
  <para style="q2" vid="AMO 5:13">nikech gin kinde mag richo.<verse eid="AMO 5:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14"/>Dwaruru ber, to ok rach,</para>
  <para style="q2" vid="AMO 5:14">mondo ubed mangima,</para>
  <para style="q1" vid="AMO 5:14">eka Jehova Nyasaye, ma en Nyasaye Maratego nobed kodu</para>
  <para style="q2" vid="AMO 5:14">mana kaka uparono.<verse eid="AMO 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15"/>Beduru mamon gi timbe maricho, to heruru timbe mabeyo;</para>
  <para style="q2" vid="AMO 5:15">ngʼaduru bura makare e ute buche.</para>
  <para style="q1" vid="AMO 5:15">Ka utimo kamano, to dipo ka Jehova Nyasaye,</para>
  <para style="q2" vid="AMO 5:15">ma Nyasaye Maratego nyalo timo ngʼwono</para>
  <para style="q2" vid="AMO 5:15">ni joka Josef mane otony oa e twech.<verse eid="AMO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16"/>Kuom mano, Ruoth Nyasaye, ma en Jehova Nyasaye Maratego wacho niya,</para>
  <para style="q1" vid="AMO 5:16">“Ywak biro winjore e yore duto mag dala,</para>
  <para style="q2" vid="AMO 5:16">kendo ji magoyo nduru ibiro winjo kuonde mag chokruok;</para>
  <para style="q1" vid="AMO 5:16">jopur bende noluong mondo oywagi</para>
  <para style="q2" vid="AMO 5:16">kaachiel gi joma olony e ywak.<verse eid="AMO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17"/>E puothe duto mag mzabibu ywak nobedie,</para>
  <para style="q2" vid="AMO 5:17">nikech abiro biro mondo amiu kum,”</para>
  <para style="q2" vid="AMO 5:17">Jehova Nyasaye owacho.<verse eid="AMO 5:17"/></para>
  <para style="s1">Odiechiengʼ mar Jehova Nyasaye</para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18"/>Yaye unune malit un joma gombo</para>
  <para style="q2" vid="AMO 5:18">mondo odiechieng Jehova Nyasaye ochopi!</para>
  <para style="q1" vid="AMO 5:18">En angʼo momiyo ugombo odiechiengno mar Jehova Nyasaye mondo ochopi?</para>
  <para style="q2" vid="AMO 5:18">Enobed chiengʼ mudho to ok chiengʼ ler!<verse eid="AMO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19"/>Chiengʼno nochal mana gi ngʼat ma sibuor lawo,</para>
  <para style="q2" vid="AMO 5:19">to oromo gi ondiek,</para>
  <para style="q1" vid="AMO 5:19">kata nochal gi ngʼat modonjo e ot,</para>
  <para style="q2" vid="AMO 5:19">moyiengo lwete e kor ot, mi thuol okaye!<verse eid="AMO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20"/>Donge odiechiengno mar Jehova Nyasaye nobed odiechieng mudho mandiwa,</para>
  <para style="q2" vid="AMO 5:20">molil maonge chiengʼ ler, kendo ma chiengʼ ok norienyie?<verse eid="AMO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21"/>“Asin kendo amon gi sewni mutimona,</para>
  <para style="q2" vid="AMO 5:21">bende ok amor gi chokruok mau ma ulosona.<verse eid="AMO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22"/>Kata obedo ni ukelona misengini miwangʼo pep kod misengini mag cham,</para>
  <para style="q2" vid="AMO 5:22">to ok anayiego;</para>
  <para style="q1" vid="AMO 5:22">bende kata obedo ni ukelona misengini mag lalruok</para>
  <para style="q2" vid="AMO 5:22">to ok abi yiego.<verse eid="AMO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23"/>Weuru baro wiya gi wendeu mag pak,</para>
  <para style="q2" vid="AMO 5:23">nikech ok adwar winjo thumbe mugoyogo.<verse eid="AMO 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24"/>Weuru mondo bura makare ema mondo omol ka pi aora,</para>
  <para style="q2" vid="AMO 5:24">kendo tim makare ema omol ka aora ma ok dwon.<verse eid="AMO 5:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25"/>“Yaye jo-Israel, bende ne ukelona misengini kata chiwo moro amora</para>
  <para style="q2" vid="AMO 5:25">kuom higni piero angʼwen mane un e thim?<verse eid="AMO 5:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26"/>Ne utingʼo kuonde lemo mag ruodhu malo,</para>
  <para style="q2" vid="AMO 5:26">ne utingʼo nyiseche manono,</para>
  <para style="q2" vid="AMO 5:26">mag sulwe ma Sakuth gi Kaiwan,</para>
  <para style="q2" vid="AMO 5:26">mane uloso ni un uwegi,<verse eid="AMO 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27"/>omiyo abiro darou mi ateru e piny twech mabor mayombo Damaski,”</para>
  <para style="q2" vid="AMO 5:27">Jehova Nyasaye, ma nyinge en Nyasaye Maratego, ema owacho.<verse eid="AMO 5:27"/></para>
  <chapter eid="AMO 5"/>
  <chapter number="6" style="c" sid="AMO 6"/>
  <para style="s1">Osiem jo-Israel ne kum mabiro</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1"/>“Mano kaka unune malit un joma odak maber e Sayun,</para>
  <para style="q2" vid="AMO 6:1">kod un joma nigi geno ni gode mag Samaria nyalo resogi,</para>
  <para style="q1" vid="AMO 6:1">kaachiel gi un joma omi luor mag oganda maduongʼ,</para>
  <para style="q2" vid="AMO 6:1">ma jo-Israel dhi irgi</para>
  <para style="q2" vid="AMO 6:1">mondo oyud konyruok!<verse eid="AMO 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2"/>Dhiuru uneye Kalne, mi uchop nyaka Hamath,</para>
  <para style="q2" vid="AMO 6:2">eka bangʼe ulor udhi nyaka Gath manie piny jo-Filistia.</para>
  <para style="q1" vid="AMO 6:2">Uparo ni pinjego ber moloyo pinjeu?</para>
  <para style="q2" vid="AMO 6:2">Koso uparo ni nitiere piny maduongʼ moloyo pinyu?<verse eid="AMO 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3"/>Un joma ok odewo odiechieng bura mabiro,</para>
  <para style="q2" vid="AMO 6:3">to kata kamano timbeu medo mana kelonu chandruok!<verse eid="AMO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4"/>Un joma nindo e kitendini mokedi gi lak liech,</para>
  <para style="q2" vid="AMO 6:4">kendo utaroru e kombeu madongo,</para>
  <para style="q1" vid="AMO 6:4">kuchamo nyirombe mayom ma jambu onywolo,</para>
  <para style="q2" vid="AMO 6:4">kod nyirwethu machwe mopidh maber.<verse eid="AMO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5"/>Un joma goyo thum kaka Daudi nogoyo</para>
  <para style="q2" vid="AMO 6:5">kendo uchuogo wende mag nyatiti.<verse eid="AMO 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6"/>Un joma madho divai mangʼeny gi agwetni madongo,</para>
  <para style="q2" vid="AMO 6:6">kendo uwiroru gi modhi mangʼwe ngʼar ma nengogi tek,</para>
  <para style="q2" vid="AMO 6:6">to ok ane ka un gi lit kata ka joka Josef rumo kamano.<verse eid="AMO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7"/>Kuom mano, un e joma ibiro kuongo daro kitero e twech,</para>
  <para style="q2" vid="AMO 6:7">kendo mano ema biro bedo giko mar dhialruoku.”<verse eid="AMO 6:7"/></para>
  <para style="s1">Nyasaye osin gi sunga mar jo-Israel</para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8"/>Jehova Nyasaye Manyalo Gik Moko Duto, ma en Jehova Nyasaye Maratego, osekwongʼore kosingore owuon niya,</para>
  <para style="q1" vid="AMO 6:8">“Asin gi sunga mar joka Jakobo,</para>
  <para style="q2" vid="AMO 6:8">kendo asin nyaka gi ohinga mag-gi moger motegno;</para>
  <para style="q1" vid="AMO 6:8">omiyo abiro chiwo dalagi kod gik moko</para>
  <para style="q2" vid="AMO 6:8">manie iye e lwet wasigu.”<verse eid="AMO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9"/>Ka ji apar odongʼ kata e ot achiel, to gin bende gibiro tho. <verse eid="AMO 6:9"/><verse number="10" style="v" sid="AMO 6:10"/>To ka achiel kuom wede joma othogo obiro mondo okaw wadgi mondo owangʼ, to nopenj ngʼat motonyno niya, “Bende ngʼato ni kodi kanyo?” Ngʼatno nodwoke niya, “ooyo,” kendo nowachne niya, “Lingʼ thi nikech ok onego waluong nying Jehova Nyasaye ka.”<verse eid="AMO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11"/>Jehova Nyasaye osegolo chik,</para>
  <para style="q2" vid="AMO 6:11">kendo obiro muko udi madongo malokre pidhe,</para>
  <para style="q2" vid="AMO 6:11">to udi matindo obiro toyo matindo tindo.<verse eid="AMO 6:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12"/>Bende farese nyalo ringo e kite,</para>
  <para style="q2" vid="AMO 6:12">koso ngʼato nyalo puro wi kitego gi dhok?</para>
  <para style="q1" vid="AMO 6:12">Kata kamano, un to uloko bura makare bedo gima kech,</para>
  <para style="q2" vid="AMO 6:12">bende tim makare uloko gima rach.<verse eid="AMO 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13"/>Umor ka umonjo jo-Lo Debir ka upakoru niya,</para>
  <para style="q2" vid="AMO 6:13">“Donge ne waloyo jo-Karnaim gi tekowa wawegi?”<verse eid="AMO 6:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14"/>Omiyo Jehova Nyasaye ma en Nyasaye Maratego wacho niya,</para>
  <para style="q2" vid="AMO 6:14">“Yaye jo-Israel, abiro kelo oganda moro mondo omonju,</para>
  <para style="q1" vid="AMO 6:14">ka gisandou chakre Lebo Hamath nyaka</para>
  <para style="q2" vid="AMO 6:14">e holo mar Araba.”<verse eid="AMO 6:14"/></para>
  <chapter eid="AMO 6"/>
  <chapter number="7" style="c" sid="AMO 7"/>
  <para style="s1">Fweny adek</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1"/>Fweny mane Jehova Nyasaye Manyalo Gik Moko Duto okelona ema: Ne aneno rumbi mar det bonyo monywol e chakruok mar opon ka cham mar ruoth osekaa. <verse eid="AMO 7:1"/><verse number="2" style="v" sid="AMO 7:2"/>Kane bonyogo osechamo gimoro amora mangʼich e piny, ne aywak kawacho niya, “Yaye Jehova Nyasaye Manyalo Gik Moko Duto, ngʼwon-ne jogi ma joka Jakobo. Ere kaka ginyalo tony, to ginok kama?”<verse eid="AMO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3"/>Omiyo chuny Jehova Nyasaye nolendo mowacho niya,</para>
  <para style="p" vid="AMO 7:3">“Gima kamano ok bi timore.”<verse eid="AMO 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4"/>Fweny machielo mane Jehova Nyasaye Manyalo Gik Moko Duto okelona ema: Ne aneno kooro mach maduongʼ mondo owangʼ nam manie bwo piny, kendo otiek gik moko duto manie piny. <verse eid="AMO 7:4"/><verse number="5" style="v" sid="AMO 7:5"/>Eka ne aywak niya, “Yaye Jehova Nyasaye Manyalo Gik Moko Duto, ngʼuonne jogi ma joka Jakobo. Ere kaka ginyalo tony, to ginok kama?”<verse eid="AMO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6"/>Omiyo chuny Jehova Nyasaye nolendo.</para>
  <para style="p" vid="AMO 7:6">Jehova Nyasaye Manyalo Gik Moko Duto nowacho niya, “Mae bende ok bi timore.”<verse eid="AMO 7:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7"/>Fweny moro machielo mane okelona ema: Ne aneno Ruoth Nyasaye kochungʼ e kor ot kotingʼo tol mar rapim mipimogo kor ot e lwete mondo one ane ka kor ot oriere tir. <verse eid="AMO 7:7"/><verse number="8" style="v" sid="AMO 7:8"/>Kendo Jehova Nyasaye nopenja niya, “Amos, en angʼo mineno?”</para>
  <para style="p" vid="AMO 7:8">Ne adwoke niya, “Aneno tol mar rapim mipimogo kor ot.”</para>
  <para style="p" vid="AMO 7:8">Eka Ruoth Nyasaye nowachona niya, “Apimo chuny joga Israel gi rapim kendo ok anachak awenegi.<verse eid="AMO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9"/>“Kuonde lemo duto mag joka Isaka ibiro kethi</para>
  <para style="q2" vid="AMO 7:9">kendo kuonde maler duto mag Israel ibiro kethi;</para>
  <para style="q2" vid="AMO 7:9">kendo anabi gi ligangla mondo aked gi dhood Jeroboam.”<verse eid="AMO 7:9"/></para>
  <para style="s1">Amos kod Amazia</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10"/>Eka Amazia jadolo mar Bethel nooro wach ne Jeroboam ma ruodh Israel niya, “Amos, koro piem kodi ei Israel, kendo wechene biro ketho piny. <verse eid="AMO 7:10"/><verse number="11" style="v" sid="AMO 7:11"/>Amos wacho niya,</para>
  <para style="q1" vid="AMO 7:11">“ ‘Jeroboam ibiro nego gi ligangla</para>
  <para style="q2" vid="AMO 7:11">kendo nyithind Israel ibiro dar e pinygi,</para>
  <para style="q2" vid="AMO 7:11">mi tergi e twech e piny mabor.’ ”<verse eid="AMO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12"/>Eka Amazia nowachone Amos niya, “Dhi kucha, jakoroni! Dhiyo e piny jo-Juda mondo ikor weche kuno eka iyudgo kaka dichiem. <verse eid="AMO 7:12"/><verse number="13" style="v" sid="AMO 7:13"/>Kik ichak ikor wach moro amora e Bethel-ka nikech ma en kama ler mar lemo mar ruoth kod hekalu mar pinyruoth.”<verse eid="AMO 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14"/>Eka Amos nodwoko Amazia niya, “An ok an janabi, to bende ok an kata nyathi janabi. Anto an mana jakwath kendo jarit ngʼowu. <verse eid="AMO 7:14"/><verse number="15" style="v" sid="AMO 7:15"/>To Jehova Nyasaye ema noluonga ka akwayo rombe, mine owachona ni, ‘Dhiyo mondo ikor wach ne joga Israel.’ <verse eid="AMO 7:15"/><verse number="16" style="v" sid="AMO 7:16"/>Kuom mano, koro winj wach Jehova Nyasaye. Iwacho niya,</para>
  <para style="q1" vid="AMO 7:16">“ ‘Kik ikor wach kuom jo-Israel,</para>
  <para style="q2" vid="AMO 7:16">kendo ni kik iwach weche manono kuom joka Isaka.’<verse eid="AMO 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17"/>“ ‘Kuom mano, koro winji gima Jehova Nyasaye wacho:</para>
  <para style="q1" vid="AMO 7:17">“ ‘Kochakore sani to chiegi biro bedo jachode e dala mar Samaria,</para>
  <para style="q2" vid="AMO 7:17">kendo yawuoti kod nyigi, to koro ibiro negi gi ligangla.</para>
  <para style="q1" vid="AMO 7:17">Lopi ibiro kawo kendo pogi,</para>
  <para style="q2" vid="AMO 7:17">in iwuon, to initho e piny moro nono mabor gi ka,</para>
  <para style="q1" vid="AMO 7:17">kendo jo-Israel nodar,</para>
  <para style="q2" vid="AMO 7:17">mi tergi e twech!’ ”<verse eid="AMO 7:17"/></para>
  <chapter eid="AMO 7"/>
  <chapter number="8" style="c" sid="AMO 8"/>
  <para style="s1">Fweny mar angʼwen en atonga motingʼo olemo mochiek</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1"/>Fweny mane Jehova Nyasaye Manyalo Gik Moko Duto okelona ema: Ne aneno atonga mopongʼ gi olemo mochiek. <verse eid="AMO 8:1"/><verse number="2" style="v" sid="AMO 8:2"/>Eka Jehova Nyasaye nopenja niya, “Amos, ineno angʼo?”</para>
  <para style="p" vid="AMO 8:2">Ne adwoke niya, “Aneno atonga mopongʼ gi olemo mochiek.”</para>
  <para style="p" vid="AMO 8:2">Eka Jehova Nyasaye nowachona niya, “Mano e kaka joga Israel oseikore ni kum kendo ok anawegi ma ok akumogi.”<verse eid="AMO 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3"/>Jehova Nyasaye Manyalo Gik Moko Duto wacho niya, “Chiengʼno wende ma iwero e hekalu nolokre mag ywak, ka ringre joma otho opie kuonde duto, kendo piny to olingʼ thi!”<verse eid="AMO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4"/>Winjuru un joma sando jochan,</para>
  <para style="q2" vid="AMO 8:4">kendo mosiko mana kamayo joma odhier puothegi,<verse eid="AMO 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 8:5"/>kuwacho niya,</para>
  <para style="q1" vid="AMO 8:5">“Mad ndalo mag lemo mar dwe manyien rum piyo,</para>
  <para style="q2" vid="AMO 8:5">mondo wayud thuolo mar uso cham.”</para>
  <para style="p" vid="AMO 8:5">Bende upenjoru niya,</para>
  <para style="q1" vid="AMO 8:5">“Ndalo mag Sabato to biro rumo karangʼo</para>
  <para style="q2" vid="AMO 8:5">mondo wagol chambwa warundi,</para>
  <para style="q1" vid="AMO 8:5">eka wanyalo choro nengo malo,</para>
  <para style="q2" vid="AMO 8:5">kendo tiyo gi rapim ma ok nikare,</para>
  <para style="q2" vid="AMO 8:5">ma wawuondogo jongʼiewo!<verse eid="AMO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6"/>E kindeno wabiro uso cham maricho e nengo maber,</para>
  <para style="q2" vid="AMO 8:6">bangʼe wabiro ngʼiewo joma odhier e nengo marom,</para>
  <para style="q2" vid="AMO 8:6">gi nengo mingʼiewogo pat pat mondo gibed wasumbini magwa.”<verse eid="AMO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7"/>Jehova Nyasaye ma Nyasach joka Jakobo osekwongʼore ni wiye ok nowil gi timbegi maricho.<verse eid="AMO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8"/>“Donge gima kamano biro miyo piny yiengni</para>
  <para style="q2" vid="AMO 8:8">mi ji duto modak e iye ywagi?</para>
  <para style="q1" vid="AMO 8:8">Piny duto biro pongʼ ma oo oko</para>
  <para style="q2" vid="AMO 8:8">mana ka aora Nael manie piny Misri.”<verse eid="AMO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9"/>Jehova Nyasaye Manyalo Gik Moko Duto wacho niya,</para>
  <para style="q1" vid="AMO 8:9">“Chiengʼno anami chiengʼ podhi e chuny odiechiengʼ tir,</para>
  <para style="q2" vid="AMO 8:9">kendo anami piny lokre mudho godiechiengʼ.<verse eid="AMO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10"/>Sewni mau mag lemo nolokre ywak mar tho,</para>
  <para style="q2" vid="AMO 8:10">wendeu mag mor, to nolokre dengo.</para>
  <para style="q1" vid="AMO 8:10">Uduto anami urwakru gi pien gugru</para>
  <para style="q2" vid="AMO 8:10">ka ulielo wiyeu mapoth.</para>
  <para style="q1" vid="AMO 8:10">Unuchal kod joma ywago wuodgi ma miderma,</para>
  <para style="q2" vid="AMO 8:10">kendo odiechiengʼno nobed malit mapok ne kone e piny.”<verse eid="AMO 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11"/>Jehova Nyasaye Manyalo Gik Moko Duto wacho niya,</para>
  <para style="q2" vid="AMO 8:11">“Ndalo biro ma abiro kelo kech e piny,</para>
  <para style="q1" vid="AMO 8:11">to ok nobed kech mar chiemo, kata riyo mar pi,</para>
  <para style="q2" vid="AMO 8:11">to nobed riyo mar winjo wach Jehova Nyasaye.<verse eid="AMO 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12"/>Ji nowuoth kadawo kochakore nyandwat e dho nam achiel nyaka dho nam machielo</para>
  <para style="q2" vid="AMO 8:12">kendo ginidigni chakre yo nyandwat nyaka yo wuok chiengʼ,</para>
  <para style="q1" vid="AMO 8:12">ka gimanyo kama digiyudie wach Jehova Nyasaye,</para>
  <para style="q2" vid="AMO 8:12">to ok giniyudi kata matin.<verse eid="AMO 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13"/>“Chiengʼno</para>
  <para style="q1" vid="AMO 8:13">“nyiri mabeyo kod yawuowi maroteke</para>
  <para style="q2" vid="AMO 8:13">nopodh piny ni kech riyo.<verse eid="AMO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14"/>Ji duto makwongʼore gi nying Ashima,</para>
  <para style="q2" vid="AMO 8:14">ma nyasaye madhako mar Samaria,</para>
  <para style="q1" vid="AMO 8:14">kata makwongʼore gi nyasach Dan,</para>
  <para style="q2" vid="AMO 8:14">kendo gi nyasach Bersheba,</para>
  <para style="q1" vid="AMO 8:14">nopodh chuth,</para>
  <para style="q2" vid="AMO 8:14">ma ok ginichak gia malo.”<verse eid="AMO 8:14"/></para>
  <chapter eid="AMO 8"/>
  <chapter number="9" style="c" sid="AMO 9"/>
  <para style="s1">Israel ibiro kethi</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1"/>Ne aneno Ruoth Nyasaye kochungʼ e bath kendo mar misango, mi owachona niya,</para>
  <para style="q1" vid="AMO 9:1">“Muk sirni duto mag hekalu</para>
  <para style="q2" vid="AMO 9:1">mondo agola oyiengni.</para>
  <para style="q1" vid="AMO 9:1">Mukgi mondo gilwar ewi ji,</para>
  <para style="q2" vid="AMO 9:1">to joma otony,</para>
  <para style="q1" vid="AMO 9:1">to abiro tieko gi ligangla,</para>
  <para style="q2" vid="AMO 9:1">kendo onge ngʼat ma noringi kata notony.<verse eid="AMO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2"/>Kata dabed ni gikunyo bur matut mi gichopo nyaka e piny joma otho,</para>
  <para style="q2" vid="AMO 9:2">to kata mana kuno abiro chopoe mi agolgi oko.</para>
  <para style="q1" vid="AMO 9:2">Kata dabed ni giidho mi gichopo e polo,</para>
  <para style="q2" vid="AMO 9:2">to kata kuno abiro chopoe mi aduog-gi piny.<verse eid="AMO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3"/>Kata dabed ni gipondo ewi got Karmel,</para>
  <para style="q2" vid="AMO 9:3">to kata mana kuno anadwargi mi amakgi.</para>
  <para style="q1" vid="AMO 9:3">To kata dabed ni gipondona e bwo nam piny,</para>
  <para style="q2" vid="AMO 9:3">to kata mana kuno anachik thuol mikagi.<verse eid="AMO 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4"/>Kata dabed ni wasikgi oterogi e twech,</para>
  <para style="q2" vid="AMO 9:4">to kata mana kuno abiro oro ligangla mondo otiekgi.</para>
  <para style="b" vid="AMO 9:4"/>
  <para style="q1" vid="AMO 9:4">“Anachom wangʼa kuomgi</para>
  <para style="q2" vid="AMO 9:4">mondo atimnegi marach to ok maber.”<verse eid="AMO 9:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5"/>Ruoth Nyasaye, ma en Jehova Nyasaye Maratego,</para>
  <para style="q2" vid="AMO 9:5">ma komulo piny, to piny leny,</para>
  <para style="q2" vid="AMO 9:5">kendo ji duto modak e piny ywak.</para>
  <para style="q1" vid="AMO 9:5">Piny duto tingʼore malo,</para>
  <para style="q2" vid="AMO 9:5">bangʼe to opie ka aora Nael man Misri!<verse eid="AMO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6"/>Jehova Nyasaye gero ute e polo</para>
  <para style="q2" vid="AMO 9:6">kendo orenjo mise mag polo e piny,</para>
  <para style="q1" vid="AMO 9:6">bangʼe oluongo pi nam mondo obi</para>
  <para style="q2" vid="AMO 9:6">kendo oologi e piny, Jehova Nyasaye e nyinge.<verse eid="AMO 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7"/>“Donge jo-Israel chalo</para>
  <para style="q2" vid="AMO 9:7">mana gi jo-Kush?” Jehova Nyasaye owacho.</para>
  <para style="q1" vid="AMO 9:7">“Donge an ema ne agolo jo-Israel koa Misri,</para>
  <para style="q2" vid="AMO 9:7">jo-Filistia koa Kaftor,</para>
  <para style="q2" vid="AMO 9:7">kendo jo-Aram koa Kir?<verse eid="AMO 9:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8"/>“Adier wangʼ Jehova Nyasaye Manyalo Gik Moko Duto</para>
  <para style="q2" vid="AMO 9:8">rango pinyruoth motimo richo.</para>
  <para style="q1" vid="AMO 9:8">Abiro ketho pinyruodhno e wangʼ piny,</para>
  <para style="q2" vid="AMO 9:8">to kata kamano,</para>
  <para style="q1" vid="AMO 9:8">ok anatiek</para>
  <para style="q2" vid="AMO 9:8">joka Jakobo duto,”</para>
  <para style="q2" vid="AMO 9:8">Jehova Nyasaye ema owacho.<verse eid="AMO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9"/>“Anagol chik</para>
  <para style="q2" vid="AMO 9:9">kendo abiro piedho jo-Israel,</para>
  <para style="q2" vid="AMO 9:9">e kind ogendini duto,</para>
  <para style="q1" vid="AMO 9:9">ka cham mipiedho e odheru,</para>
  <para style="q2" vid="AMO 9:9">kendo kata wangʼ cham achiel ok nolwar piny.<verse eid="AMO 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10"/>Joga duto ma joketho</para>
  <para style="q2" vid="AMO 9:10">ibiro nego gi ligangla,</para>
  <para style="q1" vid="AMO 9:10">kata mana mago mawacho ni,</para>
  <para style="q2" vid="AMO 9:10">‘Masira ok noyudwa kata chopo kuomwa.’<verse eid="AMO 9:10"/></para>
  <para style="s1">Israel ibiro reso</para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 9:11"/>“Chiengʼno anachung od Daudi</para>
  <para style="q2" vid="AMO 9:11">mosepodho.</para>
  <para style="q1" vid="AMO 9:11">Analos ohingane kod</para>
  <para style="q2" vid="AMO 9:11">kuondene momukore duto.</para>
  <para style="q1" vid="AMO 9:11">Anachak agere</para>
  <para style="q2" vid="AMO 9:11">mi ochal kaka,</para>
  <para style="q2" vid="AMO 9:11">ne entie chon,<verse eid="AMO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12"/>mondo jo-Israel okaw jo-Edom modongʼ kaka margi</para>
  <para style="q2" vid="AMO 9:12">kod ogendini mamoko maluongo nyinga,”</para>
  <para style="q2" vid="AMO 9:12">Jehova Nyasaye mabiro miyo gima kamano timore ema owacho.<verse eid="AMO 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13"/>Jehova Nyasaye wacho niya,</para>
  <para style="q1" vid="AMO 9:13">“Ndalo biro ma cham biro bedo mangʼeny,</para>
  <para style="q2" vid="AMO 9:13">ibiro golo pur ka ji pod keyo,</para>
  <para style="q1" vid="AMO 9:13">kendo mzabibu nonyagi mathoth,</para>
  <para style="q2" vid="AMO 9:13">kendo gibiro keto kodhi ka ji pod loso divai.</para>
  <para style="q1" vid="AMO 9:13">Yiend mzabibu mangʼeny maber nonyag mathoth e gode duto</para>
  <para style="q2" vid="AMO 9:13">mi unubed gi divai mangʼeny.<verse eid="AMO 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 9:14"/>Bangʼe abiro miyo joga Israel duogi.</para>
  <para style="b" vid="AMO 9:14"/>
  <para style="q1" vid="AMO 9:14">“Kendo gibiro gero miechgi mane olokore gundni ma ginidagie,</para>
  <para style="q2" vid="AMO 9:14">eka gibiro pidho yiend mzabibu,</para>
  <para style="q2" vid="AMO 9:14">kendo madho divai mare.</para>
  <para style="q1" vid="AMO 9:14">Gibiro puro puothegi,</para>
  <para style="q2" vid="AMO 9:14">kendo chamo nyak margi.<verse eid="AMO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15"/>Abiro guro jo-Israel</para>
  <para style="q2" vid="AMO 9:15">e pinygi mane amiyogi,</para>
  <para style="q2" vid="AMO 9:15">kendo onge ngʼama nochak ogolgi kendo,”</para>
  <para style="m" vid="AMO 9:15">Jehova Nyasaye ma Nyasachi owacho.<verse eid="AMO 9:15"/></para>
  <chapter eid="AMO 9"/>
</usx>
