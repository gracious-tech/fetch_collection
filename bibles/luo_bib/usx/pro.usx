<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Biblica® Open New Luo Translation 2020</book>
  <para style="h">Ngeche</para>
  <para style="toc1">Ngeche</para>
  <para style="toc2">Ngeche</para>
  <para style="toc3">Nge</para>
  <para style="mt1">Ngeche</para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="ms1">Gima omiyo nondik kitabu mar Ngeche kod thoro mare</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1"/>Ngeche mag Solomon wuod Daudi, ruodh Israel:<verse eid="PRO 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2"/>mamiyo iyudo rieko kod ritruok makare,</para>
  <para style="q2" vid="PRO 1:2">kendo winjo tiend weche matut;<verse eid="PRO 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3"/>kendo miyo idak e ngima moritore kendo mobidhore</para>
  <para style="q2" vid="PRO 1:3">kitimo gima adiera kendo gima kare kendo mowinjore,<verse eid="PRO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4"/>gimiyo joma ngʼeyogi tin bedo mariek,</para>
  <para style="q2" vid="PRO 1:4">kendo gimiyo jomatindo ngʼeyo tiend weche kendo pogo tiend wach.<verse eid="PRO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5"/>Mad jomariek chik itgi mondo owinji kendo gimedgi e puonjruokgi,</para>
  <para style="q2" vid="PRO 1:5">to jogo mongʼeyo pogo tiend wach mad oyud gino ma chikogi,<verse eid="PRO 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6"/>mondo gingʼe ngeche, sigendini,</para>
  <para style="q2" vid="PRO 1:6">kod weche ma tiendgi tek mag jorieko.<verse eid="PRO 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7"/>Luoro Jehova Nyasaye e chakruok mar ngʼeyo</para>
  <para style="q2" vid="PRO 1:7">to joma ofuwo chayo rieko gi ritruok makare.<verse eid="PRO 1:7"/></para>
  <para style="ms1">Weche motelo: Jip mar rwako rieko</para>
  <para style="s1">Siem kuom hoch manono</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8"/>Wuoda, chik iti ni puonj wuonu,</para>
  <para style="q2" vid="PRO 1:8">kendo kik ijwangʼ puonj mar minu.<verse eid="PRO 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9"/>Ginibedni kaka kondo michwowo e wiyi,</para>
  <para style="q2" vid="PRO 1:9">kendo kaka thiwni miketo e ngʼuti mondo ineri maber.<verse eid="PRO 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10"/>Wuoda, ka joricho hoyoi mondo itim marach,</para>
  <para style="q2" vid="PRO 1:10">kik iyienegi.<verse eid="PRO 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11"/>Kagiwachoni niya, “Bi idhi kodwa;</para>
  <para style="q2" vid="PRO 1:11">mondo wabuti ni ngʼato wanegi,</para>
  <para style="q2" vid="PRO 1:11">kendo wamonj kayiem nono joma onge ketho;<verse eid="PRO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12"/>mondo wamuonygi ngili ka bur liel</para>
  <para style="q2" vid="PRO 1:12">mana ka joma omwony mangima gi bur;<verse eid="PRO 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13"/>wabiro yudo gik moko duto mabeyo ma nengogi tek,</para>
  <para style="q2" vid="PRO 1:13">mi wapongʼ utewa gi gik moyaki.<verse eid="PRO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14"/>In bende riwri kodwa e wachni,</para>
  <para style="q2" vid="PRO 1:14">kendo wanapog gigo duto mwayako.”<verse eid="PRO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15"/>Wuoda, kik idhi kodgi ngangʼ</para>
  <para style="q2" vid="PRO 1:15">kendo kik iwuoth e yoregigo,<verse eid="PRO 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16"/>nikech tiendgi reto piyo piyo mar timo richo</para>
  <para style="q2" vid="PRO 1:16">kendo gimwomore mondo gichwer remo.<verse eid="PRO 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17"/>Mano kaka en gima nono chiko obadho</para>
  <para style="q2" vid="PRO 1:17">ka winy duto neno.<verse eid="PRO 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18"/>Jogi ochiko obadho ne gin giwegi,</para>
  <para style="q2" vid="PRO 1:18">kendo gin ema ginimokie!<verse eid="PRO 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19"/>Mano e giko jogo duto mohero yudo gimoro moyud e yo marach;</para>
  <para style="q2" vid="PRO 1:19">gino kawo ngima jogo moyude.<verse eid="PRO 1:19"/></para>
  <para style="s1">Siem kuom tamruok kawo rieko</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20"/>Rieko goyo koko matek e yore mag dala,</para>
  <para style="q2" vid="PRO 1:20">ogoyo koko bende e kuonde chokruok;<verse eid="PRO 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21"/>oywak kogoyo koko e akerkeke mag yore motimo koko,</para>
  <para style="q2" vid="PRO 1:21">owuoyo e dhorangeye mag mier madongo kopenjo niya,<verse eid="PRO 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22"/>“Nyaka karangʼo ma un joma ngʼeyogi tin nusik kuhero yoreu mag ngʼeyo matin?”</para>
  <para style="q2" vid="PRO 1:22">Nyaka karangʼo ma jojaro pod nosik kamor,</para>
  <para style="q2" vid="PRO 1:22">e jaro kendo joma ofuwo nosiki kochayo puonj?<verse eid="PRO 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23"/>Ka dine uwinj siem mara,</para>
  <para style="q2" vid="PRO 1:23">dine abedo kodu thuolo,</para>
  <para style="q2" vid="PRO 1:23">kendo damiyo ungʼeyo pacha.<verse eid="PRO 1:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24"/>To nikech ne udaga kane aluongo</para>
  <para style="q2" vid="PRO 1:24">kendo onge ngʼama nodewa kane adwaro konyou,<verse eid="PRO 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25"/>nimar ne udagi puonj maga duto</para>
  <para style="q2" vid="PRO 1:25">kendo ne ok uwinjo siem mara.<verse eid="PRO 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26"/>An to ananyieru bangʼe ka un e chandruok;</para>
  <para style="q2" vid="PRO 1:26">Anajaru ajara ka masira oloyou,<verse eid="PRO 1:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27"/>ka masira machalo yamb ahiti obiro kuomu,</para>
  <para style="q2" vid="PRO 1:27">kendo ka chandruok oyweyou ka yamb kalausi.</para>
  <para style="q2" vid="PRO 1:27">Ka lit kod thagruok ohingou.<verse eid="PRO 1:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28"/>Giniluonga, to ok anadwokgi;</para>
  <para style="q2" vid="PRO 1:28">ginimanya to ok giniyuda.<verse eid="PRO 1:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29"/>Kaka ne ok gidwar puonj</para>
  <para style="q2" vid="PRO 1:29">kendo ok negiyiero luoro Jehova Nyasaye,<verse eid="PRO 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30"/>Kaka ne ok giyie gi puonjna</para>
  <para style="q2" vid="PRO 1:30">kendo gidagi siem mara,<verse eid="PRO 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31"/>kuom mano ginicham olemo mag yoregi</para>
  <para style="q2" vid="PRO 1:31">kendo giniyiengʼ gi olemo mar riekogi maricho.<verse eid="PRO 1:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32"/>Nikech yore mobam mag bayo mag jogo mangʼeyogi tin noneg-gi,</para>
  <para style="q2" vid="PRO 1:32">kendo bedo ma ok odewo gimoro mar joma ofuwo notiekgi.<verse eid="PRO 1:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33"/>To ngʼato angʼata mawinjo wachna nodag gi kwe</para>
  <para style="q2" vid="PRO 1:33">kendo mayom, maonge luoro mar hinyruok.<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="s1">Ber mar dak mobidhore mar rieko</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1"/>Wuoda, ka iyie rwako wechena</para>
  <para style="q2" vid="PRO 2:1">kendo kano chikena e chunyi;<verse eid="PRO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2"/>ka ichiko iti ni weche mag rieko</para>
  <para style="q2" vid="PRO 2:2">kendo kiketo chunyi mondo iwinj tiend weche,<verse eid="PRO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3"/>to ka imanyo ngʼeyo malingʼ-lingʼ,</para>
  <para style="q2" vid="PRO 2:3">kendo ikwayo ngʼeyo tiend wach,<verse eid="PRO 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4"/>to ka idware ka fedha</para>
  <para style="q2" vid="PRO 2:4">kendo imanye ka mwandu mopandi,<verse eid="PRO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5"/>eka iniwinj malongʼo tiend luoro Jehova Nyasaye,</para>
  <para style="q2" vid="PRO 2:5">kendo iniyud rieko mar ngʼeyo Nyasaye.<verse eid="PRO 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6"/>Jehova Nyasaye chiwo rieko</para>
  <para style="q2" vid="PRO 2:6">kendo ngʼeyo gi winjo aa e dhoge.<verse eid="PRO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7"/>Oiko loch ni joma kare,</para>
  <para style="q2" vid="PRO 2:7">en okumba ni jogo ma wuodhgi ler,<verse eid="PRO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8"/>nimar en okumba mar joma kare</para>
  <para style="q2" vid="PRO 2:8">kendo orito yor joge ma jo-adiera.<verse eid="PRO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9"/>Ka iwinjo wachna, eka iningʼe gima kare,</para>
  <para style="q2" vid="PRO 2:9">kendo mowinjore ma gin yore duto mabeyo.<verse eid="PRO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10"/>Nimar rieko nodonj e chunyi,</para>
  <para style="q2" vid="PRO 2:10">kendo ngʼeyo nomi ngimani bedo mamor.<verse eid="PRO 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11"/>Rieko mar pogo tiend wach noriti,</para>
  <para style="q2" vid="PRO 2:11">kendo winjo tiend wach nobedni okumba.<verse eid="PRO 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12"/>Rieko noresi kuom yore mag joma mono,</para>
  <para style="q2" vid="PRO 2:12">kuom jogo mawacho weche mochido,<verse eid="PRO 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13"/>jogo moweyo yore moriere mag bidhruok,</para>
  <para style="q2" vid="PRO 2:13">mondo giwuothi e yore mag mudho,<verse eid="PRO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14"/>joma mor kuom timo maricho</para>
  <para style="q2" vid="PRO 2:14">kendo giil e duwruok mar richo,<verse eid="PRO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15"/>jogo ma yoregi ogajore ogajore</para>
  <para style="q2" vid="PRO 2:15">kendo gin jowuond e yoregi.<verse eid="PRO 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16"/>Bende enoresi kuom dhako ma jachode,</para>
  <para style="q2" vid="PRO 2:16">kuom dhako mabayo gi wechege maywayo ji,<verse eid="PRO 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17"/>moseweyo chwore mane okende konyako,</para>
  <para style="q2" vid="PRO 2:17">kendo oketho singruok mane otimo e nyim Nyasaye.<verse eid="PRO 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18"/>Nikech ode tero ji e tho</para>
  <para style="q2" vid="PRO 2:18">to yorene tero ji e piny joma otho.<verse eid="PRO 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19"/>Onge ngʼato madhi ire maduogo</para>
  <para style="q2" vid="PRO 2:19">kata yudo yor ngima.<verse eid="PRO 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20"/>Kuom mano, iniluw yore joma beyo</para>
  <para style="q2" vid="PRO 2:20">kendo irit yore joma kare.<verse eid="PRO 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21"/>Nimar joma kare ema nodag e piny</para>
  <para style="q2" vid="PRO 2:21">kendo jogo maonge bura ema nosiki e piny;<verse eid="PRO 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22"/>to joma timbegi mono nogol oko e piny</para>
  <para style="q2" vid="PRO 2:22">kendo jogo ma ok jo-adiera ok nobedie ngangʼ.<verse eid="PRO 2:22"/></para>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="s1">Ber mamoko mag rieko</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1"/>Wuoda, kik wiyi wil kod puonjna</para>
  <para style="q2" vid="PRO 3:1">to ket chikena osik e chunyi,<verse eid="PRO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2"/>nimar gibiro miyo ngimani dhi maber midag higni mangʼeny</para>
  <para style="q2" vid="PRO 3:2">kendo ibed gi kwe kod mwandu.<verse eid="PRO 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3"/>Kik iwe hera kod adiera weyi;</para>
  <para style="q2" vid="PRO 3:3">twegi e ngʼuti,</para>
  <para style="q2" vid="PRO 3:3">kendo ndikgi e chunyi maiye.<verse eid="PRO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4"/>Eka iniyud ngʼwono kod nying maber</para>
  <para style="q2" vid="PRO 3:4">e nyim Nyasaye kod dhano.<verse eid="PRO 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5"/>Gen kuom Jehova Nyasaye gi chunyi duto,</para>
  <para style="q2" vid="PRO 3:5">kendo kik igen kuom ngʼeyoni iwuon;<verse eid="PRO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6"/>ket yoreni duto kuome</para>
  <para style="q2" vid="PRO 3:6">eka nomi yoregi oriere tir.<verse eid="PRO 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7"/>Kik ibed mariek e pachi iwuon</para>
  <para style="q2" vid="PRO 3:7">to luor Jehova Nyasaye eka inilo richo.<verse eid="PRO 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8"/>Tim ma kamano nomi ringri bedo gi ngima</para>
  <para style="q2" vid="PRO 3:8">kendo nobed chiemo ne chunyi.<verse eid="PRO 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9"/>Mi Jehova Nyasaye duongʼ gi mwanduni</para>
  <para style="q2" vid="PRO 3:9">kichiwone cham mabeyo ma ikayo e puotheni;<verse eid="PRO 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10"/>eka dechegi nopongʼ gi cham mogundho</para>
  <para style="q2" vid="PRO 3:10">kendo agulnigi nopongʼ gi divai manyien maonge kama ikanoe.<verse eid="PRO 3:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11"/>Wuoda, kik icha kum mar Jehova Nyasaye</para>
  <para style="q2" vid="PRO 3:11">kendo kik ingʼur kokweri kuom gik maricho;<verse eid="PRO 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12"/>nimar Jehova Nyasaye kumo jogo mohero</para>
  <para style="q2" vid="PRO 3:12">mana kaka wuoro chiko wuode ma omorgo.<verse eid="PRO 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13"/>En jahawi ngʼatno moyudo rieko,</para>
  <para style="q2" vid="PRO 3:13">ngʼatno man-gi winjo,<verse eid="PRO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14"/>nimar en gohala moloyo fedha</para>
  <para style="q2" vid="PRO 3:14">kendo okelo gik mabeyo moloyo dhahabu.<verse eid="PRO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15"/>Ober moloyo kite ma nengogi tek;</para>
  <para style="q2" vid="PRO 3:15">onge gimoro amora migombo ma dipim kode.<verse eid="PRO 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16"/>Ngima kuom ndalo mangʼeny ni e lwete korachwich;</para>
  <para style="q2" vid="PRO 3:16">to e lwete koracham nitiere mwandu kod duongʼ.<verse eid="PRO 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17"/>Yorene gin yore mag mor</para>
  <para style="q2" vid="PRO 3:17">kendo yorene duto gin mag kwe.<verse eid="PRO 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18"/>En yadh ngima ne jogo morwake;</para>
  <para style="q2" vid="PRO 3:18">jogo mopadore kuome biro yudo gweth.<verse eid="PRO 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19"/>Kuom rieko Jehova Nyasaye nochweyo mise mar piny</para>
  <para style="q2" vid="PRO 3:19">kendo noketo polo kama entie kuom lony mare;<verse eid="PRO 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20"/>kuom ngʼeyo mare ema nopogogo aore gi nembe,</para>
  <para style="q2" vid="PRO 3:20">kendo nomiyo boche polo okelo thoo.<verse eid="PRO 3:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21"/>Wuoda, rit ngʼado bura makare kod pogo tiend wach,</para>
  <para style="q2" vid="PRO 3:21">kik iwe gilalni.<verse eid="PRO 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22"/>Ginibedni ngima maber,</para>
  <para style="q2" vid="PRO 3:22">ka tigo maber mitweyo e ngʼuti.<verse eid="PRO 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23"/>Eka ibiro dhi e yoreni gi kwe</para>
  <para style="q2" vid="PRO 3:23">kendo tiendi ok nochwanyre;<verse eid="PRO 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24"/>ka inindo, to ok inibed maluor,</para>
  <para style="q2" vid="PRO 3:24">kendo ininind mayom nyaka piny ru.<verse eid="PRO 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25"/>Kik ibed giluoro mar masira ma ditimreni apoya nono</para>
  <para style="q2" vid="PRO 3:25">kata kethruok mamako jogo maricho,<verse eid="PRO 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26"/>nimar Jehova Nyasaye ema nomi ibed jachir</para>
  <para style="q2" vid="PRO 3:26">kendo norit tiendi mondo kik odonji e obadho.<verse eid="PRO 3:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27"/>Kik iwe timo maber ni jogo mowinjorego,</para>
  <para style="q2" vid="PRO 3:27">ka in kod nyalo mar timo kamano.<verse eid="PRO 3:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28"/>Ka inyalo konyo wadu kawuono,</para>
  <para style="q2" vid="PRO 3:28">to kik iwachne niya,</para>
  <para style="q2" vid="PRO 3:28">“Dogi iduog bangʼe kiny, eka akonyi.”<verse eid="PRO 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29"/>Kik ichan hinyo jabathi,</para>
  <para style="q2" vid="PRO 3:29">modak machiegni kodi gi kwe.<verse eid="PRO 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30"/>Kik ihangne ngʼato wach maonge gima omiyo,</para>
  <para style="q2" vid="PRO 3:30">kaonge gima rach mosetimoni.<verse eid="PRO 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31"/>Kik nyiego maki gi ja-mahundu,</para>
  <para style="q2" vid="PRO 3:31">kata wuotho e yore moro amora.<verse eid="PRO 3:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32"/>Nimar Jehova Nyasaye ger gi jaricho</para>
  <para style="q2" vid="PRO 3:32">to ogeno joma kare.<verse eid="PRO 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33"/>Kwongʼ mar Jehova Nyasaye ni e od jaricho,</para>
  <para style="q2" vid="PRO 3:33">to ogwedho dala ngʼat makare.<verse eid="PRO 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34"/>Ojaro jojaro masungore</para>
  <para style="q2" vid="PRO 3:34">to ochiwo ngʼwono ni joma obolore.<verse eid="PRO 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35"/>Joma riek yudo luor kaka girkeni</para>
  <para style="q2" vid="PRO 3:35">to joma ofuwo enonyis wichkuotgi ayanga.<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="s1">Ohala miyudo kuom bedo gi rieko</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1"/>Yawuota, winjuru puonj mag wuonu;</para>
  <para style="q2" vid="PRO 4:1">chikuru itu eka ubed gi ngʼeyo moloyo.<verse eid="PRO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2"/>Puonj mara mamiyou beyo,</para>
  <para style="q2" vid="PRO 4:2">omiyo kik ujwangʼ puonjna.<verse eid="PRO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3"/>Kane pod an wuowi e od wuora,</para>
  <para style="q2" vid="PRO 4:3">kane pod an rawera kendo nyathi achiel kende mar minwa,<verse eid="PRO 4:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 4:4"/>nopuonja kowacho niya,</para>
  <para style="q1" vid="PRO 4:4">“Mak matek wechena gi chunyi duto,</para>
  <para style="q2" vid="PRO 4:4">rit chikena eka inibed mangima.<verse eid="PRO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5"/>Yud rieko kod ngʼeyo matut,</para>
  <para style="q2" vid="PRO 4:5">wiyi kik wil kod wechena kata weyogi.<verse eid="PRO 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6"/>Kik ijwangʼ rieko to obiro bedoni ragengʼ;</para>
  <para style="q2" vid="PRO 4:6">here, to obiro ritoi.<verse eid="PRO 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7"/>Rieko nigi duongʼ moloyo, omiyo yud rieko.</para>
  <para style="q2" vid="PRO 4:7">Kata obedo ni mwanduni duto nyalo rumo,</para>
  <para style="q2" vid="PRO 4:7">to bed gi winjo tiend wach.<verse eid="PRO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8"/>Miye duongʼ, to enotingʼi malo;</para>
  <para style="q2" vid="PRO 4:8">rwake chutho, to obiro miyi duongʼ.<verse eid="PRO 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9"/>Enoket ogut ngʼwono e wiyi</para>
  <para style="q2" vid="PRO 4:9">kendo nosidhni osimbo mar duongʼ.”<verse eid="PRO 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10"/>Wuoda, winji kendo yie gima awacho</para>
  <para style="q2" vid="PRO 4:10">eka higni mag ngimani nobed mangʼeny.<verse eid="PRO 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11"/>Apuonji e yor rieko</para>
  <para style="q2" vid="PRO 4:11">kendo anyisi yo makare.<verse eid="PRO 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12"/>Ka iwuotho, to ok inikier</para>
  <para style="q2" vid="PRO 4:12">bende ka iringo, to ok inichwanyri.<verse eid="PRO 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13"/>Mak motegno gima isepuonjori,</para>
  <para style="q2" vid="PRO 4:13">kik iweye, olalni to irite maber, nikech en e ngimani.<verse eid="PRO 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14"/>Kik iwuothi e yor joma timbegi mono</para>
  <para style="q2" vid="PRO 4:14">kata kik iluw yor jomaricho.<verse eid="PRO 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15"/>Bed mabor gi yorno, kik iwuothie,</para>
  <para style="q2" vid="PRO 4:15">to wichri kendo iluw yori iwuon.<verse eid="PRO 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16"/>Nikech ok ginyal nindo nyaka gitim gima mono;</para>
  <para style="q2" vid="PRO 4:16">ayula wangʼ bende ok nyal terogi kapok gimiyo ngʼato opodho.<verse eid="PRO 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17"/>Timbe mamono e chiembgi ma gichamo,</para>
  <para style="q2" vid="PRO 4:17">to timbe ja-mahundu e divai ma gimadho.<verse eid="PRO 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18"/>Yor joma kare chalo ka ugwe mar kogwen,</para>
  <para style="q2" vid="PRO 4:18">omedo rieny maler nyaka chiengʼ wuogi.<verse eid="PRO 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19"/>To yor joricho chalo gi mudho mandiwa;</para>
  <para style="q2" vid="PRO 4:19">ok gingʼeyo gima miyo gichwanyore.<verse eid="PRO 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20"/>Wuoda, chik iti malongʼo ne gima awacho,</para>
  <para style="q2" vid="PRO 4:20">chik iti maber ne wechena.<verse eid="PRO 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21"/>Kik iwe gilal e wangʼi</para>
  <para style="q2" vid="PRO 4:21">to kan-gi e chunyi;<verse eid="PRO 4:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22"/>nikech gikelo ngima ni jogo moyudogo</para>
  <para style="q2" vid="PRO 4:22">kendo gin gi ngima maber ne ringre dhano duto.<verse eid="PRO 4:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23"/>To moloyo duto, rit chunyi,</para>
  <para style="q2" vid="PRO 4:23">nikech en e soko mar ngima.<verse eid="PRO 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24"/>Wach ma ok adiera kik aa e dhogi;</para>
  <para style="q2" vid="PRO 4:24">weche mag miganga kik wuogi e dhogi.<verse eid="PRO 4:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25"/>Rang mana nyimi tir,</para>
  <para style="q2" vid="PRO 4:25">ka ichomo wangʼi moriere tir e nyimi.<verse eid="PRO 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26"/>Rie yore tir monego iluw</para>
  <para style="q2" vid="PRO 4:26">kendo luw mana yore motegno.<verse eid="PRO 4:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27"/>Kik ibar kidhiyo korachwich kata koracham;</para>
  <para style="q2" vid="PRO 4:27">rit tiendi mondo kik idonji e richo.<verse eid="PRO 4:27"/></para>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="s1">Siem kuom terruok</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1"/>Wuoda, chik iti malongʼo ne riekona,</para>
  <para style="q2" vid="PRO 5:1">mondo iwinj maber puonj mago mopondo,<verse eid="PRO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2"/>eka isik kingʼeyo pogo tiend weche</para>
  <para style="q2" vid="PRO 5:2">kendo dhogi norit rieko.<verse eid="PRO 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3"/>Nimar dho jachode wacho weche mamit ka mor kich,</para>
  <para style="q2" vid="PRO 5:3">kendo wuoyone yom maloyo moo;<verse eid="PRO 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4"/>to gikone okech ka kedhno</para>
  <para style="q2" vid="PRO 5:4">kendo obith ka ligangla ma dhoge ariyo.<verse eid="PRO 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5"/>Tiendene ochomo kar tho,</para>
  <para style="q2" vid="PRO 5:5">to ondamo mage ochiko bur tir.<verse eid="PRO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6"/>Ok opar ngangʼ yor ngima; yorene ogondore,</para>
  <para style="q2" vid="PRO 5:6">to ok ongʼeyo kamano.<verse eid="PRO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7"/>Omiyo koro un yawuota, winjauru,</para>
  <para style="q2" vid="PRO 5:7">kik uwe gima awachonu.<verse eid="PRO 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8"/>Bed mabor gi dhako ma kamano,</para>
  <para style="q2" vid="PRO 5:8">kendo kik idhi machiegni gi dhoode,<verse eid="PRO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9"/>nono to jomoko nono ema inimi tekreni maber moloyo</para>
  <para style="q2" vid="PRO 5:9">kendo higni magi norum e lwet joma ger,<verse eid="PRO 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10"/>nono to jomoko nono, ema nocham mwanduni</para>
  <para style="q2" vid="PRO 5:10">kendo tichni matek nokony od ngʼat moro nono.<verse eid="PRO 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11"/>To e giko mar ngimani inichur achura,</para>
  <para style="q2" vid="PRO 5:11">ka ringri gi dendi chamore rumo.<verse eid="PRO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12"/>To iniwachi niya, “Mano kaka nasin gi puonj mar rieko!</para>
  <para style="q2" vid="PRO 5:12">Mano kaka chunya nokwedo siem mane omiya kuom gik mane atimo ma ok nikare!<verse eid="PRO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13"/>Ne ok anyal winjo kendo timo weche jopuonjna,</para>
  <para style="q2" vid="PRO 5:13">kata chiko ita ni jopuonjna.<verse eid="PRO 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14"/>Asechopo e giko mar kethruok marach</para>
  <para style="q2" vid="PRO 5:14">e dier chokruok mangima.”<verse eid="PRO 5:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15"/>Modh pi moa e dapigi iwuon,</para>
  <para style="q2" vid="PRO 5:15">pi mamol moa e sokoni iwuon.<verse eid="PRO 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16"/>Bende ber mondo soknigi omol ka oo oko e yore mag dala,</para>
  <para style="q2" vid="PRO 5:16">kata aoregi mag pi e kuonde chokruok manie dier dala?<verse eid="PRO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17"/>Ne ni gibedo magi iwuon</para>
  <para style="q2" vid="PRO 5:17">kendo kik iriwgi gi joma galagala.<verse eid="PRO 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18"/>Sokoni mondo ogwedhi,</para>
  <para style="q2" vid="PRO 5:18">kendo ibed mamor gi chiegi mane ikendo ka in wuowi.<verse eid="PRO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19"/>Ojaber ka mwanda, kendo olongʼo ka nyakech,</para>
  <para style="q2" vid="PRO 5:19">thundene mad romi kinde duto, mad herane omaki moloyo.<verse eid="PRO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20"/>Wuoda, ere gima omiyo jachode dikaw paroni?</para>
  <para style="q2" vid="PRO 5:20">Ere gima omiyo chie ngʼato nono dilombi?<verse eid="PRO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21"/>Yore mag dhano nenore ratiro e nyim Jehova Nyasaye,</para>
  <para style="q2" vid="PRO 5:21">kendo onono kamoro amora ma odhiyoe.<verse eid="PRO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22"/>Timbe mamono mag ngʼama jaricho obedone obadho mamake,</para>
  <para style="q2" vid="PRO 5:22">tonde mag richone tweye matek.<verse eid="PRO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23"/>Obiro tho nikech ok oyie mondo orieye,</para>
  <para style="q2" vid="PRO 5:23">obayo yo nikech fupe maduongʼ.<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="s1">Siem kuom fuwo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1"/>Wuoda, ka isechiwo singo ni jabathi,</para>
  <para style="q2" vid="PRO 6:1">kata ka isingori ni inichul ni ngʼat mikia gope,<verse eid="PRO 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2"/>ka diponi omaki nikech gima ne iwacho,</para>
  <para style="q2" vid="PRO 6:2">mi idwodori kod weche mane oa e dhogi,<verse eid="PRO 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3"/>to tim kama, wuoda, mondo ibed thuolo,</para>
  <para style="q2" vid="PRO 6:3">nikech isepodho e lwet jabathi:</para>
  <para style="q1" vid="PRO 6:3">Dhiyo kendo ibolri e nyime;</para>
  <para style="q2" vid="PRO 6:3">bangʼe to ikwa jabathino oweyi thuolo!<verse eid="PRO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4"/>Kik iwe nindo ohingi,</para>
  <para style="q2" vid="PRO 6:4">kata ayula wangʼ oteri.<verse eid="PRO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5"/>To resri ibed thuolo, mana kaka mwanda mayombo jadwar,</para>
  <para style="q2" vid="PRO 6:5">kata kaka winyo matony e obadho mar jamak winy.<verse eid="PRO 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6"/>In janyawo, dhi ir biye;</para>
  <para style="q2" vid="PRO 6:6">mondo ineye kendo ipar yoregi, mondo ibed mariek!<verse eid="PRO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7"/>Biye onge jatelo</para>
  <para style="q2" vid="PRO 6:7">kata jaloch kata ruoth,<verse eid="PRO 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8"/>to kata kamano, gikano chiembgi e ndalo oro,</para>
  <para style="q2" vid="PRO 6:8">kendo gichoko chiembgi e ndalo keyo.<verse eid="PRO 6:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9"/>In jasamuoyo, nyaka karangʼo ma ibiro bedo kinindo aninda kanyo?</para>
  <para style="q2" vid="PRO 6:9">Karangʼo mibiro chiewoe mondo ia e nindo?<verse eid="PRO 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10"/>Nindo matin, ayula wangʼ matin,</para>
  <para style="q2" vid="PRO 6:10">kwakruok matin kiyweyo,<verse eid="PRO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11"/>to dhier biro monji ka janjore</para>
  <para style="q2" vid="PRO 6:11">kendo chan ka jalweny momanore.<verse eid="PRO 6:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12"/>Ngʼat mamono kendo jaricho</para>
  <para style="q2" vid="PRO 6:12">mawuotho awuotha kowacho weche mogak,<verse eid="PRO 6:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PRO 6:13"/>oningʼo wangʼe,</para>
  <para style="q2" vid="PRO 6:13">owuoyo gi tiendene ka ogoro piny,</para>
  <para style="q2" vid="PRO 6:13">kendo ogwelo ji gi lith lwetene,<verse eid="PRO 6:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 6:14"/>ochano richo kod miriambo ei chunye,</para>
  <para style="q2" vid="PRO 6:14">kinde duto okelo miero.<verse eid="PRO 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15"/>Kuom mano, masira biro make maloye apoya nono;</para>
  <para style="q2" vid="PRO 6:15">notieke apoya nono, maonge resruok.<verse eid="PRO 6:15"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="16" style="v" sid="PRO 6:16"/>Nitie gik moko auchiel ma Jehova Nyasaye mon-go,</para>
  <para style="li2" vid="PRO 6:16">chutho gin gik moko abiriyo ma ok more:<verse eid="PRO 6:16"/></para>
  <para style="li3">
    <verse number="17" style="v" sid="PRO 6:17"/>wenge mag sunga,</para>
  <para style="li3" vid="PRO 6:17">lep mariambo,</para>
  <para style="li3" vid="PRO 6:17">lwedo machwero remo maonge ketho,<verse eid="PRO 6:17"/></para>
  <para style="li3">
    <verse number="18" style="v" sid="PRO 6:18"/>chuny machano chenro maricho,</para>
  <para style="li3" vid="PRO 6:18">tiende maringo kadhi e richo,<verse eid="PRO 6:18"/></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 6:19"/>jahang wach mawacho miriambo</para>
  <para style="li3" vid="PRO 6:19">kendo ngʼatno makelo miero e kind jowete.<verse eid="PRO 6:19"/></para>
  <para style="s1">Siem kuom terruok</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20"/>Wuoda, rit chike wuonu</para>
  <para style="q2" vid="PRO 6:20">kendo kik iwe puonj minu.<verse eid="PRO 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21"/>Kan-gi ka ipandogi e chunyi nyaka chiengʼ;</para>
  <para style="q2" vid="PRO 6:21">twegi e ngʼuti motegno.<verse eid="PRO 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22"/>Ka iwuotho, to gibiro chiki;</para>
  <para style="q2" vid="PRO 6:22">to ka inindo, to giniriti;</para>
  <para style="q2" vid="PRO 6:22">to ka ichiewo, to giniwuo kodi.<verse eid="PRO 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23"/>Nikech chikegi gin taya,</para>
  <para style="q2" vid="PRO 6:23">to puonjni en ler,</para>
  <para style="q1" vid="PRO 6:23">kendo kwer mikwerogo ngʼato kuom gima otimo marach</para>
  <para style="q2" vid="PRO 6:23">kelo mana ngima,<verse eid="PRO 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24"/>mamiyo ibedo mabor gi dhako mandhaga kaachiel</para>
  <para style="q2" vid="PRO 6:24">gi lep mayom mar dhako mabayo.<verse eid="PRO 6:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25"/>Kik ber mare mineno gi wangʼ omi chunyi gombe</para>
  <para style="q2" vid="PRO 6:25">kata weye oywayi kolombi gi wangʼe.<verse eid="PRO 6:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26"/>Nikech ochot nyalo miyo ibed matin maromo gi nengo makati,</para>
  <para style="q2" vid="PRO 6:26">to dhako ma jachode biro tieko ngimani.<verse eid="PRO 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27"/>Bende ngʼato nyalo tingʼo mach e kore,</para>
  <para style="q2" vid="PRO 6:27">ma lepe ok owangʼ?<verse eid="PRO 6:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28"/>Bende ngʼato nyalo wuotho e mirni mar mach maliel,</para>
  <para style="q2" vid="PRO 6:28">ma ok tiendene owangʼ?<verse eid="PRO 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29"/>Ma e kaka ngʼat ma terore gi chi ngʼat machielo chalo;</para>
  <para style="q2" vid="PRO 6:29">ngʼato angʼata ma omule ok notony ma ok okum.<verse eid="PRO 6:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30"/>Ji ok cha jakuo kokwalo chiemo</para>
  <para style="q2" vid="PRO 6:30">mondo ogaago kech kodenyo.<verse eid="PRO 6:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31"/>Kata kamano ka omake, to nyaka ochul nyadibiriyo,</para>
  <para style="q2" vid="PRO 6:31">kata obedo ni en nengo mapek kuome makawo mwandu mag ode duto.<verse eid="PRO 6:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32"/>To ngʼat ma terore gi chi ngʼat machielo onge gi rieko,</para>
  <para style="q2" vid="PRO 6:32">ngʼat matimo kamano ketho ngimane owuon.<verse eid="PRO 6:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33"/>Pokne en chwat kod wichkuot</para>
  <para style="q2" vid="PRO 6:33">kendo nobed gi wichkuot ma ok norum.<verse eid="PRO 6:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34"/>Nimar nyiego mamako chwor dhakono nyalo kelo tho,</para>
  <para style="q2" vid="PRO 6:34">omiyo ka ochulo kuor, to nobed maonge ngʼwono kata matin.<verse eid="PRO 6:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35"/>Ok enoyie chudo moro amora;</para>
  <para style="q2" vid="PRO 6:35">ok enoyie asoya kata obedo ni en gima duongʼ manade.<verse eid="PRO 6:35"/></para>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="s1">Siem kuom dhako ma jachode</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1"/>Wuoda, rit wechena</para>
  <para style="q2" vid="PRO 7:1">kendo ipand chikena e chunyi.<verse eid="PRO 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2"/>Rit chikena to ibiro bedo mangima;</para>
  <para style="q2" vid="PRO 7:2">rit puonjna mana kaka dirit tong wangʼi.<verse eid="PRO 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3"/>Twegi e lith lweti kendo ndikgi e chunyi maiye.<verse eid="PRO 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4"/>Wach ne rieko niya, “In e nyaminwa,”</para>
  <para style="q2" vid="PRO 7:4">to luong ngʼeyo tiend wach ni watni;<verse eid="PRO 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5"/>ginimi itangʼ ni dhako ma jachode,</para>
  <para style="q2" vid="PRO 7:5">inibed mabor gi dhako mabayo kaachiel,</para>
  <para style="q2" vid="PRO 7:5">kod wechene malombo ji.<verse eid="PRO 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6"/>Ka nangʼicho oko</para>
  <para style="q2" vid="PRO 7:6">gie dirisa mar oda,<verse eid="PRO 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7"/>ne aneno e dier joma ngʼeyogi tin,</para>
  <para style="q2" vid="PRO 7:7">ne afwenyo e dier yawuowi matindo,</para>
  <para style="q2" vid="PRO 7:7">rawera maonge gi rieko.<verse eid="PRO 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8"/>Ne owuotho e wangʼ yo makadho but od dhakono,</para>
  <para style="q2" vid="PRO 7:8">kowuotho kochiko od dhakono,<verse eid="PRO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9"/>ka piny ngʼiringʼiri, ka piny dwaro yuso,</para>
  <para style="q2" vid="PRO 7:9">e kindeno ma mudho mako piny.<verse eid="PRO 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10"/>Eka apoya nono dhakono nowuok mondo oromne,</para>
  <para style="q2" vid="PRO 7:10">korwakore kaka ochot mopongʼ gi paro marach.<verse eid="PRO 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11"/>En dhako ma wangʼe tek kendo maonge wichkuot,</para>
  <para style="q2" vid="PRO 7:11">tiendene susni ma ok obed e ot;<verse eid="PRO 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12"/>sani onene e yo, to bangʼ sa matin en kuonde chokruok,</para>
  <para style="q2" vid="PRO 7:12">kendo e kuonde mopondo duto oyudore.<verse eid="PRO 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13"/>Omiyo nokwake mi onyodhe,</para>
  <para style="q2" vid="PRO 7:13">gi wangʼ matek, nowachone niya:<verse eid="PRO 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14"/>“An gi misango mar lalruok e oda,</para>
  <para style="q2" vid="PRO 7:14">kawuononi asechopo singruok maga.<verse eid="PRO 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15"/>Omiyo ne abiro mondo arom kodi,</para>
  <para style="q2" vid="PRO 7:15">asemanyi to koro aseyudi!<verse eid="PRO 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16"/>Asepedho kitandana</para>
  <para style="q2" vid="PRO 7:16">gi suke mokikokiko moa Misri.<verse eid="PRO 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17"/>Asekiro moo e kitandana,</para>
  <para style="q2" vid="PRO 7:17">gin modhi mangʼeny mangʼwe ngʼar gi mane-mane kod obala ndago.<verse eid="PRO 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18"/>Bi, wadhi wayud mor mar hera nyaka piny ru,</para>
  <para style="q2" vid="PRO 7:18">mondo wabed mamor ka wawinjo maber e hera!<verse eid="PRO 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19"/>Chwora ok nitiere dala;</para>
  <para style="q2" vid="PRO 7:19">osedhiyo e wuoth mabor.<verse eid="PRO 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20"/>Nokawo mifukone mopongʼ gi pesa,</para>
  <para style="q2" vid="PRO 7:20">kendo ok obi duogo dala nyaka bangʼ ndalo mogwarore.”<verse eid="PRO 7:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21"/>Kamano, dhakono nowuonde gi weche mamit;</para>
  <para style="q2" vid="PRO 7:21">mi nohoye kendo odhi kode.<verse eid="PRO 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22"/>Gikanyono noluwe kodhi kode</para>
  <para style="q2" vid="PRO 7:22">mana ka rwadh bwoch mitero kar yengʼo,</para>
  <para style="q1" vid="PRO 7:22">kata ka mwanda madonjo e obeto<verse eid="PRO 7:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23"/>nyaka asere chwowe mahob chunye,</para>
  <para style="q1" vid="PRO 7:23">kata ka winyo madhiyo e obadho ma ochikne,</para>
  <para style="q2" vid="PRO 7:23">ka ok ongʼeyo ni ngimane ni e tho!<verse eid="PRO 7:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24"/>Koro un yawuota winjauru,</para>
  <para style="q2" vid="PRO 7:24">chikuru itu ne gima awacho.<verse eid="PRO 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25"/>Kik uyie mondo chunyu odhi e yorene,</para>
  <para style="q2" vid="PRO 7:25">kata bayo e yorene.<verse eid="PRO 7:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26"/>Oseketho ngima ji mangʼeny,</para>
  <para style="q2" vid="PRO 7:26">kendo osemiyo ji mathoth mak kwanre otho.<verse eid="PRO 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27"/>Ode en yo malach matero ji e liel,</para>
  <para style="q2" vid="PRO 7:27">otelo ni ji koterogi e kuonde mag tho.<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="s1">Luong mar rieko</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1"/>Donge rieko luongo?</para>
  <para style="q2" vid="PRO 8:1">Donge ngʼeyo tiend wach tingʼo dwonde ka goyo koko?<verse eid="PRO 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2"/>Ochungʼ e kuonde motingʼore e bath yo,</para>
  <para style="q2" vid="PRO 8:2">e akerkeke mag yore.<verse eid="PRO 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3"/>Oywak matek e bath dhorangeye</para>
  <para style="q2" vid="PRO 8:3">midonjogo e dala maduongʼ,<verse eid="PRO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4"/>kowacho niya, “Aluongou, yaye un ji,</para>
  <para style="q2" vid="PRO 8:4">aluongou un ji duto manie piny.<verse eid="PRO 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5"/>Un joma ngʼeyogi tin, nwangʼuru rieko;</para>
  <para style="q2" vid="PRO 8:5">to un joma ofuwo, nwangʼuru ngʼeyo.<verse eid="PRO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6"/>Winjuru, nikech an gi gik mabeyo mangʼeny madwaro nyisou;</para>
  <para style="q2" vid="PRO 8:6">ayawo dhoga mondo awach gima kare.<verse eid="PRO 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7"/>Dhoga wacho gima adiera</para>
  <para style="q2" vid="PRO 8:7">nikech dhoga kwedo gik maricho.<verse eid="PRO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8"/>Weche duto mawuok e dhoga gin kare,</para>
  <para style="q2" vid="PRO 8:8">onge moro kuomgi mobam kata modwanyore.<verse eid="PRO 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9"/>Ne jogo mongʼeyo pogo tiend wach,</para>
  <para style="q2" vid="PRO 8:9">gigi duto nikare, giber ni jogo man-gi ngʼeyo.<verse eid="PRO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10"/>Yier puonjna kar fedha</para>
  <para style="q2" vid="PRO 8:10">kendo ngʼeyo kar dhahabu mowal,<verse eid="PRO 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11"/>nikech rieko ber moloyo kite ma nengogi tek,</para>
  <para style="q2" vid="PRO 8:11">kendo gimoro amora madiher ok nyal romo kode.<verse eid="PRO 8:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12"/>“An, rieko, wadak kaachiel gi ngʼado bura makare;</para>
  <para style="q2" vid="PRO 8:12">an-gi ngʼeyo kod pogo tiend wach.<verse eid="PRO 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13"/>Luoro Jehova Nyasaye en sin gi richo;</para>
  <para style="q2" vid="PRO 8:13">amon gi sunga kod ngʼayi,</para>
  <para style="q2" vid="PRO 8:13">timbe maricho kod wuoyo mochido.<verse eid="PRO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14"/>Ngʼado rieko kod ngʼado bura malongʼo gin maga;</para>
  <para style="q2" vid="PRO 8:14">an-gi winjo tiend wach kod nyalo.<verse eid="PRO 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15"/>An ema amiyo ruodhi locho</para>
  <para style="q2" vid="PRO 8:15">kendo joloch loso chike makare.<verse eid="PRO 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16"/>Nikech an, amiyo yawuot ruodhi loch</para>
  <para style="q2" vid="PRO 8:16">kod joka ruodhi duto marito pinje.<verse eid="PRO 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17"/>Ahero jogo mohera,</para>
  <para style="q2" vid="PRO 8:17">to jogo ma manya yuda.<verse eid="PRO 8:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18"/>Mwandu gi luor ni kuoma,</para>
  <para style="q2" vid="PRO 8:18">mwandu mochwere kod mewo.<verse eid="PRO 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19"/>Olemba ber moloyo dhahabu maber,</para>
  <para style="q2" vid="PRO 8:19">gino machiwo oloyo fedha moyier.<verse eid="PRO 8:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20"/>Awuotho e yo mobidhore makare,</para>
  <para style="q2" vid="PRO 8:20">e yore mag bura makare,<verse eid="PRO 8:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21"/>kachiwo mwandu ni jogo mohera</para>
  <para style="q2" vid="PRO 8:21">kendo amiyo kuondegi mag keno bedo mopongʼ chutho.<verse eid="PRO 8:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22"/>“Jehova Nyasaye nokwongo chweya</para>
  <para style="q2" vid="PRO 8:22">kaka tichne mokwongo motelo ni tijene machon.<verse eid="PRO 8:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23"/>Noyiera aa chakruok manyaka chiengʼ,</para>
  <para style="q2" vid="PRO 8:23">kapok piny kobetie.<verse eid="PRO 8:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24"/>Kapok nembe kobetie,</para>
  <para style="q2" vid="PRO 8:24">nonywola kata ka sokni mopongʼ gi pi ne onge.<verse eid="PRO 8:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25"/>Nonywola ka gode madongo ne pok obedo kuonde ma gintie,</para>
  <para style="q2" vid="PRO 8:25">bende ka gode matindo ne pod onge,<verse eid="PRO 8:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26"/>kapok ne ochweyo piny kaachiel gi pewene</para>
  <para style="q2" vid="PRO 8:26">kata mana lowo mar piny.<verse eid="PRO 8:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27"/>Ne antie kane oketo polo kama entie,</para>
  <para style="q2" vid="PRO 8:27">kata kane oketo giko mar nembe,<verse eid="PRO 8:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28"/>kane oketo boche polo malo,</para>
  <para style="q2" vid="PRO 8:28">kendo kane oketo sokni mag nembe mogurore motegno,<verse eid="PRO 8:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29"/>kane ochiwo kuonde giko mag nam matin</para>
  <para style="q2" vid="PRO 8:29">mondo pi kik okadh kama oketee,</para>
  <para style="q1" vid="PRO 8:29">kendo kane oloso mise mar piny.<verse eid="PRO 8:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30"/>Ne an jatich molony mobedo bute.</para>
  <para style="q1" vid="PRO 8:30">Napongʼ gi mor mogundho odiechiengʼ ka odiechiengʼ</para>
  <para style="q2" vid="PRO 8:30">kamor e nyime kinde duto,<verse eid="PRO 8:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31"/>ka amor e pinye mangima</para>
  <para style="q2" vid="PRO 8:31">kendo ail gi ji duto.<verse eid="PRO 8:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32"/>“Omiyo koro yawuota, winjauru;</para>
  <para style="q2" vid="PRO 8:32">gin johawi jogo morito yorena.<verse eid="PRO 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33"/>Winjuru puonjna mondo ubed mariek,</para>
  <para style="q2" vid="PRO 8:33">kik uchagi.<verse eid="PRO 8:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34"/>En jahawi ngʼat mawinja,</para>
  <para style="q2" vid="PRO 8:34">marito pile e dhoutena korito e dhorangaya.<verse eid="PRO 8:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35"/>Nimar ngʼat monwangʼa oyudo ngima</para>
  <para style="q2" vid="PRO 8:35">kendo oyudo ngʼwono kuom Jehova Nyasaye.<verse eid="PRO 8:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36"/>To ngʼatno ma odaga hinyore kende owuon;</para>
  <para style="q2" vid="PRO 8:36">jogo duto mamon koda ohero tho.”<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="s1">Luong mag rwako rieko kod mag fuwo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1"/>Rieko osegero ode,</para>
  <para style="q2" vid="PRO 9:1">osechungo sirnige abiriyo.<verse eid="PRO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2"/>Oseiko ringe kendo oloso divai mare moru mamit,</para>
  <para style="q2" vid="PRO 9:2">bende osepedho mesa mare.<verse eid="PRO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3"/>Oseoro jotichne ma nyiri, kendo oluongo ji</para>
  <para style="q2" vid="PRO 9:3">ka en kuonde motingʼore e dala maduongʼ.<verse eid="PRO 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4"/>“Weuru ji duto mangʼeyogi tin obi kae!”</para>
  <para style="q2" vid="PRO 9:4">Owacho ni jogo maonge gi rieko mar ngʼado bura.<verse eid="PRO 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5"/>Biuru, chamuru chiemba</para>
  <para style="q2" vid="PRO 9:5">kendo madhuru divai ma aseruwo.<verse eid="PRO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6"/>Weuru yoreu maonge rieko, eka unubed mangima,</para>
  <para style="q2" vid="PRO 9:6">wuothuru e yor winjo kod ngʼeyo.<verse eid="PRO 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7"/>Ngʼat marieyo ja-ajara luongo mana wichkuot,</para>
  <para style="q2" vid="PRO 9:7">ngʼat makwero ngʼat marach yudo mana ayany.<verse eid="PRO 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8"/>Kik ikwer ngʼat ma jaro ji, nikech mano biro miyo obedo mamon kodi,</para>
  <para style="q2" vid="PRO 9:8">kirieyo ngʼat mariek, to obiro heri.<verse eid="PRO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9"/>Puonj ngʼat mariek, to obiro bedo mariek moloyo,</para>
  <para style="q2" vid="PRO 9:9">puonj ngʼat makare gimoro, to obiro medo puonjore.<verse eid="PRO 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10"/>Luoro Jehova Nyasaye e chakruok mar rieko,</para>
  <para style="q2" vid="PRO 9:10">to ngʼeyo Jal Maler miyo ngʼato ngʼeyo tiend wach.<verse eid="PRO 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11"/>Nimar kuoma ndalogi biro bedo mangʼeny,</para>
  <para style="q2" vid="PRO 9:11">kendo rieko biro medo hiki.<verse eid="PRO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12"/>Ka iriek, riekoni nomiyi ohala,</para>
  <para style="q2" vid="PRO 9:12">ka ijajaro, to in iwuon ema ibiro hinyori.<verse eid="PRO 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13"/>Dhako mofuwo en jakoko,</para>
  <para style="q2" vid="PRO 9:13">ok oritore kendo ngʼeyone tin.<verse eid="PRO 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14"/>Obedo e dhoode,</para>
  <para style="q2" vid="PRO 9:14">e kom kama otingʼore mar dala maduongʼ,<verse eid="PRO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15"/>koluongo jogo makadho,</para>
  <para style="q2" vid="PRO 9:15">madhi e yoregi.<verse eid="PRO 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16"/>Owacho ni jogo maonge gi rieko mar ngʼado bura niya,</para>
  <para style="q2" vid="PRO 9:16">“Weuru ji duto mangʼeyogi tin obi kae!”<verse eid="PRO 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17"/>Nomedo wachonegi niya, “Pi mokwal mit,</para>
  <para style="q2" vid="PRO 9:17">chiemo michamo apanda ema nigi ndhandhu moloyo!”<verse eid="PRO 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18"/>To ok gingʼeyo kata matin ni joma otho ni kuno;</para>
  <para style="q2" vid="PRO 9:18">bende ni joma lime ni e liel matut.<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="ms1">Ngeche mag Solomon</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1"/>Ngeche mag Solomon:</para>
  <para style="q1" vid="PRO 10:1">Wuowi mariek kelo mor ni wuon mare,</para>
  <para style="q2" vid="PRO 10:1">to wuowi mofuwo miyo min mare chuny lit.<verse eid="PRO 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2"/>Mwandu moyudi e yo marach onge gi ohala;</para>
  <para style="q2" vid="PRO 10:2">to tim makare reso ji e tho.<verse eid="PRO 10:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3"/>Jehova Nyasaye ok we ngʼat makare obed gi kech,</para>
  <para style="q2" vid="PRO 10:3">to oketho gombo mar joricho.<verse eid="PRO 10:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4"/>Lwedo manyap miyo ngʼato bedo jachan,</para>
  <para style="q2" vid="PRO 10:4">to lwedo ma jakinda kelo mwandu.<verse eid="PRO 10:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5"/>Ngʼat makayo cham e kinde oro en wuowi mariek,</para>
  <para style="q2" vid="PRO 10:5">to ngʼat ma nindo kinde keyo en wuowi makwodo wich.<verse eid="PRO 10:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6"/>Gweth sidho kondo mar loch ewi ngʼat makare,</para>
  <para style="q2" vid="PRO 10:6">to timbe mahundu opongʼ e dho ngʼat marach.<verse eid="PRO 10:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7"/>Paro miparogo ngʼat makare nobed gweth,</para>
  <para style="q2" vid="PRO 10:7">to nying ngʼat marach nolal.<verse eid="PRO 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8"/>Ngʼat mariek e chunye rwako chike,</para>
  <para style="q2" vid="PRO 10:8">to ngʼat mofuwo ma wachne ngʼeny dhi e kethruok.<verse eid="PRO 10:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9"/>Ngʼat mobidhore wuotho kaonge luoro,</para>
  <para style="q2" vid="PRO 10:9">to ngʼatno maluwo yore mobam ibiro yudo mapiyo.<verse eid="PRO 10:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10"/>Ngʼat madiemo wangʼe giwuond kelo kuyo,</para>
  <para style="q2" vid="PRO 10:10">to ngʼat mofuwo ma wachne ngʼeny dhi e kethruok.<verse eid="PRO 10:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11"/>Dho ngʼat makare en soko mar ngima,</para>
  <para style="q2" vid="PRO 10:11">to timbe mahundu opongʼo dho ngʼat marach.<verse eid="PRO 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12"/>Sigu kelo miero,</para>
  <para style="q2" vid="PRO 10:12">to hera umo maricho duto.<verse eid="PRO 10:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13"/>Rieko iyudo e dho jogo mongʼeyo tiend wach,</para>
  <para style="q2" vid="PRO 10:13">to luth en mar ngʼe ngʼatno maonge gi rieko mar ngʼado bura.<verse eid="PRO 10:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14"/>Joma riek okano ngʼeyo,</para>
  <para style="q2" vid="PRO 10:14">to dho joma ofuwo kelo kethruok.<verse eid="PRO 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15"/>Mwandu mar jomoko e ohinga mochiel motegno ma gigengʼorego,</para>
  <para style="q2" vid="PRO 10:15">to dhier e kethruok mar jochan.<verse eid="PRO 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16"/>Pok joma kare kelonegi ngima,</para>
  <para style="q2" vid="PRO 10:16">to mwandu ma joricho yudo kelonegi kum.<verse eid="PRO 10:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17"/>Ngʼat mawinjo weche mirieyego wuotho e yo madhiyo e ngima,</para>
  <para style="q2" vid="PRO 10:17">to ngʼat motamore kethone tero ji mamoko e yor lal.<verse eid="PRO 10:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18"/>Ngʼatno mapando sigu manie chunye,</para>
  <para style="q2" vid="PRO 10:18">dhoge nigi miriambo, to ngʼatno ma jakwoth ofuwo.<verse eid="PRO 10:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19"/>Ka weche ngʼeny, to richo ok nyal bare ma ok obetie,</para>
  <para style="q2" vid="PRO 10:19">to ngʼat marito lewe oriek.<verse eid="PRO 10:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20"/>Lew ngʼat makare en fedha mowal,</para>
  <para style="q2" vid="PRO 10:20">to chuny ngʼat marach nigi ohala matin.<verse eid="PRO 10:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21"/>Dho ngʼat makare konyo ji mangʼeny,</para>
  <para style="q2" vid="PRO 10:21">to ngʼat mofuwo tho nikech rem mar ngʼeyo ngʼado bura.<verse eid="PRO 10:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22"/>Gweth mar Jehova Nyasaye kelo mwandu,</para>
  <para style="q2" vid="PRO 10:22">kendo ok omed chandruok kuome.<verse eid="PRO 10:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23"/>Ngʼat mofuwo yudo mor e timbe maricho,</para>
  <para style="q2" vid="PRO 10:23">to ngʼat man-gi winjo bedo mamor kuom rieko.<verse eid="PRO 10:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24"/>Gima ngʼat marach oluoro biro loye;</para>
  <para style="q2" vid="PRO 10:24">to gima ngʼat makare dwaro ibiro miye.<verse eid="PRO 10:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25"/>Ka auka mager ofuto, to joricho otieko;</para>
  <para style="q2" vid="PRO 10:25">to joma kare chungo motegno nyaka chiengʼ.<verse eid="PRO 10:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26"/>Mana kaka kong awayo machamo lak kendo ka iro malungo wenge,</para>
  <para style="q2" vid="PRO 10:26">e kaka jasamuoyo ni jogo moore.<verse eid="PRO 10:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27"/>Luoro Jehova Nyasaye miyo idak amingʼa,</para>
  <para style="q2" vid="PRO 10:27">to higni mar ngʼat marach ingʼado bedo machwok.<verse eid="PRO 10:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28"/>Geno mar joma kare en mor,</para>
  <para style="q2" vid="PRO 10:28">to geno mar joricho nolal nono.<verse eid="PRO 10:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29"/>Yor Jehova Nyasaye e kar pondo ni joma kare,</para>
  <para style="q2" vid="PRO 10:29">to en kethruok ni jogo matimo richo.<verse eid="PRO 10:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30"/>Joma kare ok nopudh ngangʼ,</para>
  <para style="q2" vid="PRO 10:30">to joricho ok nodongʼ e piny.<verse eid="PRO 10:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31"/>Dho joma kare kelo rieko,</para>
  <para style="q2" vid="PRO 10:31">to lep mar richo nongʼad oko.<verse eid="PRO 10:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32"/>Lew joma kare ongʼeyo gima owinjore,</para>
  <para style="q2" vid="PRO 10:32">to dho joricho wacho mana gik mochido.<verse eid="PRO 10:32"/></para>
  <para style="b"/>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1"/>Jehova Nyasaye ok mor gi rapim ma ok nikare,</para>
  <para style="q2" vid="PRO 11:1">to rapim makare ema omorgo.<verse eid="PRO 11:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2"/>Ka sunga biro, eka wichkuot bende biro,</para>
  <para style="q2" vid="PRO 11:2">to muolo biro kod rieko.<verse eid="PRO 11:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3"/>Bidhruok mar joma kare telonegi,</para>
  <para style="q2" vid="PRO 11:3">to joma ok jo-adiera kethore gi timbegi mag achach.<verse eid="PRO 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4"/>Mwandu onge gi ohala e ndalo mar mirima,</para>
  <para style="q2" vid="PRO 11:4">to tim makare reso ngʼato e tho.<verse eid="PRO 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5"/>Tim makare mar joma kare maonge ketho loso yoregi moriere,</para>
  <para style="q2" vid="PRO 11:5">to joricho podho nikech richogi.<verse eid="PRO 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6"/>Tim makare mar joma kare resogi,</para>
  <para style="q2" vid="PRO 11:6">to jogo ma ok jo-adiera imako gi gombogi maricho.<verse eid="PRO 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7"/>Ka jaricho otho, to genone duto tho kode,</para>
  <para style="q2" vid="PRO 11:7">gigo duto mane ogeno kuom tekone bedo nono.<verse eid="PRO 11:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8"/>Ngʼat makare ireso kuom chandruok,</para>
  <para style="q2" vid="PRO 11:8">to chandruok biro mana ni jaricho.<verse eid="PRO 11:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9"/>Ngʼat ma ok ja-Nyasaye hinyo jabathe gi dhoge owuon,</para>
  <para style="q2" vid="PRO 11:9">to rieko miyo ngʼat makare tony.<verse eid="PRO 11:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10"/>Ka ngʼat makare mewo, dala maduongʼ bedo mamor,</para>
  <para style="q2" vid="PRO 11:10">ka joricho otho, to nitie koko mar mor.<verse eid="PRO 11:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11"/>Gweth mar joma kare kelo pak ne dala,</para>
  <para style="q2" vid="PRO 11:11">to kuom dho joricho dala kethore.<verse eid="PRO 11:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12"/>Ngʼat maonge gi rieko jaro jabathe,</para>
  <para style="q2" vid="PRO 11:12">to ngʼat man-gi winjo rito lewe.<verse eid="PRO 11:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13"/>Kuoth ketho genruok,</para>
  <para style="q2" vid="PRO 11:13">to ngʼat ma ja-ratiro rito wach malingʼ-lingʼ.<verse eid="PRO 11:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14"/>Oganda podho nimar onge puonj,</para>
  <para style="q2" vid="PRO 11:14">to jongʼad rieko mangʼeny miyo loch mar adier bedo.<verse eid="PRO 11:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15"/>Ngʼat machungʼ e gowi ni ngʼat mokia biro hinyore adier,</para>
  <para style="q2" vid="PRO 11:15">to ngʼat motamore chungʼ e gowi ni ngʼat mokia okonyore.<verse eid="PRO 11:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16"/>Dhako ma chunye ngʼwon yudo luor,</para>
  <para style="q2" vid="PRO 11:16">to ji ma kitgi richo yudo mana mwandu kende.<verse eid="PRO 11:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17"/>Ngʼat mangʼwon yudo ohala mana ne en owuon,</para>
  <para style="q2" vid="PRO 11:17">to ngʼat makwiny kelo chandruok ni en owuon.<verse eid="PRO 11:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18"/>Jaricho yudo ohala mar miriambo,</para>
  <para style="q2" vid="PRO 11:18">to ngʼat machwoyo gima kare kayo pok mar adiera.<verse eid="PRO 11:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19"/>Ngʼat man-gi tim makare kendo ma ja-adiera nobed mangima,</para>
  <para style="q2" vid="PRO 11:19">to ngʼat maluwo richo dhiyo e thone.<verse eid="PRO 11:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20"/>Jehova Nyasaye odagi jogo ma chunygi opongʼ gi richo,</para>
  <para style="q2" vid="PRO 11:20">to omor gi jogo ma yoregi ler.<verse eid="PRO 11:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21"/>Bed ka ingʼeyo ni jaricho ok notony ma ok okume,</para>
  <para style="q2" vid="PRO 11:21">to jogo makare nobed thuolo.<verse eid="PRO 11:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22"/>Mana ka tere mar dhahabu manie um anguro,</para>
  <para style="q2" vid="PRO 11:22">e kaka dhako ma jaber maonge rieko chalo.<verse eid="PRO 11:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23"/>Dwaro mar joma kare gik mana e ber kende,</para>
  <para style="q2" vid="PRO 11:23">to geno mar joricho gik mana e mirima.<verse eid="PRO 11:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24"/>Ngʼato achiel miyo ji ma ok odewo,</para>
  <para style="q2" vid="PRO 11:24">to bende pod mwandu medorene moloyo,</para>
  <para style="q1" vid="PRO 11:24">to ngʼat machielo kungo mokadhore,</para>
  <para style="q2" vid="PRO 11:24">to ochopo mana e chan.<verse eid="PRO 11:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25"/>Ngʼat mangʼwon biro bedo gi mwandu;</para>
  <para style="q2" vid="PRO 11:25">to ngʼat makweyo chuny ji ibiro kwe chunye bende.<verse eid="PRO 11:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26"/>Ji kwongʼo ngʼat mapando cham,</para>
  <para style="q2" vid="PRO 11:26">to gweth bedo ni ngʼatno moyie golo chambe mondo ji ongʼiew kuome.<verse eid="PRO 11:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27"/>Ngʼat madwaro ber winjo maber,</para>
  <para style="q2" vid="PRO 11:27">to kethruok biro ni ngʼatno madware.<verse eid="PRO 11:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28"/>Ngʼatno mogeno kuom mwandune biro podho;</para>
  <para style="q2" vid="PRO 11:28">to joma kare nodhi nyime mana ka oboke mangʼich.<verse eid="PRO 11:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29"/>Ngʼatno makelo chandruok ni joge ok nonwangʼ gimoro,</para>
  <para style="q2" vid="PRO 11:29">to ngʼat mofuwo nobed misumba ngʼat mariek.<verse eid="PRO 11:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30"/>Olemb joma kare en yadh ngima,</para>
  <para style="q2" vid="PRO 11:30">to ngʼatno ma reso chunje riek.<verse eid="PRO 11:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31"/>Ka joma kare yudo pokgi e piny,</para>
  <para style="q2" vid="PRO 11:31">to joma ok oluoro Nyasaye gi joricho diyud mangʼeny maromo nadi!<verse eid="PRO 11:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1"/>Ngʼat mohero puonj mar rieko ohero ngʼeyo,</para>
  <para style="q2" vid="PRO 12:1">to ngʼat ma ok winj puonj ofuwo.<verse eid="PRO 12:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2"/>Ngʼat maber yudo pwoch kuom Jehova Nyasaye,</para>
  <para style="q2" vid="PRO 12:2">to Jehova Nyasaye kwero ngʼat ma timbene richo.<verse eid="PRO 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3"/>Ngʼato ok nyal gerore motegno kuom richo,</para>
  <para style="q2" vid="PRO 12:3">to ngʼat makare ok nyal pudhi.<verse eid="PRO 12:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4"/>Dhako ma kite longʼo en osimbo mar chwore,</para>
  <para style="q2" vid="PRO 12:4">to dhako ma timbene richo chalo gi nyamuoda manie choke.<verse eid="PRO 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5"/>Chenro mar ngʼat makare nikare,</para>
  <para style="q2" vid="PRO 12:5">to puonj mar joricho en wuondruok.<verse eid="PRO 12:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6"/>Weche mag joricho opondo karito chwero remo,</para>
  <para style="q2" vid="PRO 12:6">to wach mar joma kare resogi.<verse eid="PRO 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7"/>Joricho osewiti kendo gilal nono,</para>
  <para style="q2" vid="PRO 12:7">to od ngʼat makare osiko ogurore motegno.<verse eid="PRO 12:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8"/>Ngʼato ipako kaluwore gi riekone,</para>
  <para style="q2" vid="PRO 12:8">to jogo man-gi paro mobam ichayo.<verse eid="PRO 12:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9"/>Ber bedo dhano adhana, to in gi jatich,</para>
  <para style="q2" vid="PRO 12:9">moloyo wuondori ni in ngʼato, to ionge chiemo.<verse eid="PRO 12:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10"/>Ngʼat makare chiwo kony ne gik ma jambe dwaro,</para>
  <para style="q2" vid="PRO 12:10">to timbe mag ngʼwono mag ngʼat marach gin mana gero.<verse eid="PRO 12:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11"/>Ngʼat matiyo e puothe biro bedo gi chiemo mogundho,</para>
  <para style="q2" vid="PRO 12:11">to ngʼat mabayo abaya onge gi rieko.<verse eid="PRO 12:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12"/>Joricho dwaro gik moyaki mag jogo mamono,</para>
  <para style="q2" vid="PRO 12:12">to tiend joma kare kelo mwandu.<verse eid="PRO 12:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13"/>Ngʼat marach imako mana gi wuoyone maricho,</para>
  <para style="q2" vid="PRO 12:13">to ngʼat makare tony ne chandruok.<verse eid="PRO 12:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14"/>Weche mabeyo mawuok e dho ngʼato miyo obedo gi gik mabeyo,</para>
  <para style="q2" vid="PRO 12:14">adiera, tich mar lwete kelone konyruok.<verse eid="PRO 12:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15"/>Yor ngʼat mofuwo nenorene ni nikare,</para>
  <para style="q2" vid="PRO 12:15">to ngʼat makare chiko ite ne puonj.<verse eid="PRO 12:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16"/>Ngʼat mofuwo nyiso mirimbe mapiyo,</para>
  <para style="q2" vid="PRO 12:16">to ngʼat mariek mwonyo ayany.<verse eid="PRO 12:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17"/>Janeno ma ja-adiera chiwo neno mobidhore,</para>
  <para style="q2" vid="PRO 12:17">to janeno ma hango wach wacho miriambo.<verse eid="PRO 12:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18"/>Weche mag muomruok chwoyo chuny mana kaka ligangla,</para>
  <para style="q2" vid="PRO 12:18">to lew ngʼat mariek kelo ngima.<verse eid="PRO 12:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19"/>Dhok ma ja-adiera osiko manyaka chiengʼ,</para>
  <para style="q2" vid="PRO 12:19">to lep mariambo bedo mana kuom kinde machwok.<verse eid="PRO 12:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20"/>Wuond ni e chuny jogo machano timo marach,</para>
  <para style="q2" vid="PRO 12:20">to mor en mar jogo mohero kwe.<verse eid="PRO 12:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21"/>Onge gima rach manyalo biro ni ngʼat makare;</para>
  <para style="q2" vid="PRO 12:21">to joricho ni kod thagruok mathoth.<verse eid="PRO 12:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22"/>Jehova Nyasaye mon kod dhok mariambo,</para>
  <para style="q2" vid="PRO 12:22">to omor gi jogo ma jo-adiera.<verse eid="PRO 12:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23"/>Ngʼat mariek orito ngʼeyone e iye,</para>
  <para style="q2" vid="PRO 12:23">to chuny joma ofuwo wuoyo ma ok opimo.<verse eid="PRO 12:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24"/>Tich matek miyo ngʼato bedo gi duongʼ,</para>
  <para style="q2" vid="PRO 12:24">to nyawo gikone en tich mar misumba.<verse eid="PRO 12:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25"/>Chuny maparore miyo ngʼato bedo mool,</para>
  <para style="q2" vid="PRO 12:25">to wach mamuol jiwe.<verse eid="PRO 12:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26"/>Ngʼat makare dak gi osiepene e yo mowinjore,</para>
  <para style="q2" vid="PRO 12:26">to yor ngʼat marach terogi kama rach.<verse eid="PRO 12:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27"/>Jasamuoyo ok nyal yudo dwarone,</para>
  <para style="q2" vid="PRO 12:27">to jakinda maratego ongʼeyo ber gige.<verse eid="PRO 12:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28"/>Yo makare nitie gi ngima,</para>
  <para style="q2" vid="PRO 12:28">e yorno nitie ngima mochwere.<verse eid="PRO 12:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1"/>Wuowi mariek winjo puonj wuon mare,</para>
  <para style="q2" vid="PRO 13:1">to ngʼat ma wangʼe tek ok winj wach kikwere.<verse eid="PRO 13:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2"/>Ngʼat makare yudo pok maber kaluwore gi gik mowacho,</para>
  <para style="q2" vid="PRO 13:2">to ngʼatno ma ok ja-adiera nigi gombo mar miero.<verse eid="PRO 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3"/>Ngʼatno morito dhoge orito ngimane,</para>
  <para style="q2" vid="PRO 13:3">to ngʼatno ma wuoyo karodho wach biro dhiyo e kethruok.<verse eid="PRO 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4"/>Jasamuoyo dwaro gimoro gi chunye duto to ok oyud gimoro,</para>
  <para style="q2" vid="PRO 13:4">to jakinda yudo gik moko duto modwaro.<verse eid="PRO 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5"/>Ngʼat makare mon kod gima ok adiera,</para>
  <para style="q2" vid="PRO 13:5">to joricho kelo wichkuot kod dwanyruok.<verse eid="PRO 13:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6"/>Tim makare rito ngʼat mobidhore,</para>
  <para style="q2" vid="PRO 13:6">timbe maricho to tieko jaricho.<verse eid="PRO 13:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7"/>Ngʼat moro wuondore ni en ja-mwandu,</para>
  <para style="q2" vid="PRO 13:7">to adiera oonge gimoro;</para>
  <para style="q1" vid="PRO 13:7">to ngʼat machielo wuondore ni en jachan,</para>
  <para style="q2" vid="PRO 13:7">to adiera en gi mwandu mangʼeny.<verse eid="PRO 13:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8"/>Mwandu ngʼato sa moro nyalo reso ngimane,</para>
  <para style="q2" vid="PRO 13:8">to jochan onge gima bwogo.<verse eid="PRO 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9"/>Ler mar ngʼat makare rieny maler,</para>
  <para style="q2" vid="PRO 13:9">to taya mar ngʼat marach inego.<verse eid="PRO 13:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10"/>Sunga nywolo mana dhawo,</para>
  <para style="q2" vid="PRO 13:10">to rieko iyudo kuom jogo moyie puonj.<verse eid="PRO 13:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11"/>Pesa moyud e yo ma ok kare lal nono,</para>
  <para style="q2" vid="PRO 13:11">to ngʼat makano pesa matin matin miyo omedore.<verse eid="PRO 13:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12"/>Gima igeno mobudho miyo chuny bedo matuo,</para>
  <para style="q2" vid="PRO 13:12">to gima igeno motimore en yath mar ngima.<verse eid="PRO 13:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13"/>Ngʼat ma jaro puonj biro yudo pokne,</para>
  <para style="q2" vid="PRO 13:13">to ngʼat moluoro chik imiyo pok maber.<verse eid="PRO 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14"/>Puonj mar ngʼat mariek en soko mar ngima</para>
  <para style="q2" vid="PRO 13:14">ma reso ngʼato e obadho mag tho.<verse eid="PRO 13:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15"/>Bedo gi winjo kelo luor,</para>
  <para style="q2" vid="PRO 13:15">to yor ngʼato ma ok ja-adier tek.<verse eid="PRO 13:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16"/>Ngʼato ka ngʼato mariek timo gik moko kuom ngʼeyo,</para>
  <para style="q2" vid="PRO 13:16">to ngʼat mofuwo nyiso mana fupe.<verse eid="PRO 13:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17"/>Jaote marach donjo e chandruok,</para>
  <para style="q2" vid="PRO 13:17">to jaote modimbore kelo konyruok.<verse eid="PRO 13:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18"/>Ngʼat modagi siem nwangʼo dhier kod wichkuot,</para>
  <para style="q2" vid="PRO 13:18">to ngʼato angʼata mawinjo kikwere to yudo duongʼ.<verse eid="PRO 13:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19"/>Geno mochopi en gima mit ne chuny,</para>
  <para style="q2" vid="PRO 13:19">to joma ofuwo ok dwar aa e richo.<verse eid="PRO 13:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20"/>Ngʼat mawuotho gi ngʼama riek bedo mariek,</para>
  <para style="q2" vid="PRO 13:20">to osiep joma ofuwo hinyore.<verse eid="PRO 13:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21"/>Chandruok luwo jaricho,</para>
  <para style="q2" vid="PRO 13:21">to mwandu e ohand ngʼat makare.<verse eid="PRO 13:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22"/>Ngʼat maber weyo mwandu ne nyithind nyithinde,</para>
  <para style="q2" vid="PRO 13:22">to mwandu jaricho okan ni joma kare.<verse eid="PRO 13:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23"/>Puoth ngʼat ma jachan sa moro nyalo nyago chiemo mangʼeny,</para>
  <para style="q2" vid="PRO 13:23">to tim ma ok kare tiekogi duto.<verse eid="PRO 13:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24"/>Ngʼat ma ok ti kod kede kuom chwado wuode, omon kod wuode,</para>
  <para style="q2" vid="PRO 13:24">to ngʼat mohere bedo motangʼ mondo orieye.<verse eid="PRO 13:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25"/>Joma kare chiemo moromo kaka chunygi dwaro,</para>
  <para style="q2" vid="PRO 13:25">to ii ngʼat marach nigi kech.<verse eid="PRO 13:25"/></para>
  <para style="b"/>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1"/>Dhako mariek gero ode,</para>
  <para style="q2" vid="PRO 14:1">to dhako mofuwo muko ode gi lwete owuon.<verse eid="PRO 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2"/>Ngʼat ma wuodhe oriere oluoro Jehova Nyasaye,</para>
  <para style="q2" vid="PRO 14:2">to ngʼat ma yorene achach ochaye.<verse eid="PRO 14:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3"/>Wuoyo mar ngʼama ofuwo kelone mana goch e ngʼeye,</para>
  <para style="q2" vid="PRO 14:3">to dho jomariek bedonegi ragengʼ.<verse eid="PRO 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4"/>Kama onge rwedhi, dipo bedo nono,</para>
  <para style="q2" vid="PRO 14:4">to kama rwath nitiere keyo mangʼeny bedoe.<verse eid="PRO 14:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5"/>Janeno ma ja-adiera ok riambi,</para>
  <para style="q2" vid="PRO 14:5">to janeno ma hango wach wacho mana miriambo.<verse eid="PRO 14:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6"/>Ngʼat ma jasunga nyalo dwaro rieko to ok oyud gimoro,</para>
  <para style="q2" vid="PRO 14:6">ngʼeyo tiend wach to biro mayot ne ngʼat ma ongʼeyo pogo tiend weche.<verse eid="PRO 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7"/>Bed mabor gi ngʼat mofuwo</para>
  <para style="q2" vid="PRO 14:7">nimar ok iniyud ngʼeyo tiend wach e dhoge.<verse eid="PRO 14:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8"/>Rieko mar jorieko en bedo gi paro ne yoregi,</para>
  <para style="q2" vid="PRO 14:8">to fup joma ofuwo en wuondruok.<verse eid="PRO 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9"/>Joma ofuwo jaro kowachnegi mondo giwe richo,</para>
  <para style="q2" vid="PRO 14:9">to ngʼwono iyudo kuom joma kare.<verse eid="PRO 14:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10"/>Chuny ka chuny ongʼeyo litne owuon,</para>
  <para style="q2" vid="PRO 14:10">to onge ngʼato machielo manyalo bedo e mor ma en-go.<verse eid="PRO 14:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11"/>Od ngʼat marach ibiro ketho</para>
  <para style="q2" vid="PRO 14:11">to kar dak mar ngʼat makare biro dhiyo nyime.<verse eid="PRO 14:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12"/>Nitie yo manenore ne dhano ni nikare,</para>
  <para style="q2" vid="PRO 14:12">to gikone otero mana ngʼato e tho.<verse eid="PRO 14:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13"/>Kata e kinde mar nyiero, chuny nyalo bedo gi lit,</para>
  <para style="q2" vid="PRO 14:13">to mor nyalo gik e kuyo.<verse eid="PRO 14:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14"/>Joma onge yie ibiro mi pok moromo gi timbegi,</para>
  <para style="q2" vid="PRO 14:14">to ngʼat maber bende pok moromo kode.<verse eid="PRO 14:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15"/>Ngʼat mangʼeyone tin thoro yie gimoro amora,</para>
  <para style="q2" vid="PRO 14:15">to ngʼat mariek paro gik motimo.<verse eid="PRO 14:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16"/>Ngʼat mariek oluoro Jehova Nyasaye kendo okwedo richo,</para>
  <para style="q2" vid="PRO 14:16">to ngʼama ofuwo wiye tek kendo omuomore.<verse eid="PRO 14:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17"/>Ngʼat ma iye wangʼ piyo timo gik mofuwo,</para>
  <para style="q2" vid="PRO 14:17">to ngʼat ma ja-miganga ji mon-go.<verse eid="PRO 14:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18"/>Joma ngʼeyogi tin nwangʼo fuwo,</para>
  <para style="q2" vid="PRO 14:18">to jomariek irwako nigi ogut ngʼeyo.<verse eid="PRO 14:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19"/>Joricho kulore e nyim joma beyo,</para>
  <para style="q2" vid="PRO 14:19">to jo-ajendeke e dhorangeye mag joma kare.<verse eid="PRO 14:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20"/>Jochan ok dwar kata gi jobutgi,</para>
  <para style="q2" vid="PRO 14:20">to jo-mwandu nigi osiepe mangʼeny.<verse eid="PRO 14:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21"/>Ngʼatno machayo jabute timo richo,</para>
  <para style="q2" vid="PRO 14:21">to ogwedhi ngʼatno mangʼwon gi jogo mochando.<verse eid="PRO 14:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22"/>Donge jogo machano marach lal nono?</para>
  <para style="q2" vid="PRO 14:22">To jogo machano gima ber yudo hera kendo imiyogi luor.<verse eid="PRO 14:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23"/>Tich matek duto kelo ohala,</para>
  <para style="q2" vid="PRO 14:23">to wuoyo awuoya maonge tim kelo dhier.<verse eid="PRO 14:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24"/>Mwandu jomariek e osimbo margi,</para>
  <para style="q2" vid="PRO 14:24">to fup joma ofuwo nyago mana fuwo.<verse eid="PRO 14:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25"/>Janeno ma ja-adiera reso ji e tho,</para>
  <para style="q2" vid="PRO 14:25">to janeno ma hango wach en jawuond.<verse eid="PRO 14:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26"/>Ngʼat moluoro Jehova Nyasaye nigi ohinga motegno,</para>
  <para style="q2" vid="PRO 14:26">kendo nyithinde noyud kar pondo.<verse eid="PRO 14:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27"/>Luoro Jehova Nyasaye en soko mar ngima,</para>
  <para style="q2" vid="PRO 14:27">ma reso ngʼato e obadho mag tho.<verse eid="PRO 14:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28"/>Ruoth ma joge ngʼeny ema yudo duongʼ,</para>
  <para style="q2" vid="PRO 14:28">to ruoth maonge jogo morito to podho.<verse eid="PRO 14:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29"/>Ngʼat ma terore mos nigi winjo,</para>
  <para style="q2" vid="PRO 14:29">to ngʼatno ma iye wangʼ piyo nyiso fupe.<verse eid="PRO 14:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30"/>Chuny man-gi kwe kelo ngima ni ringruok,</para>
  <para style="q2" vid="PRO 14:30">to nyiego towo choke.<verse eid="PRO 14:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31"/>Ngʼat masando jochan nyiso achaya ne Jal mane ochweyogi,</para>
  <para style="q2" vid="PRO 14:31">to ngʼato angʼata mangʼwon ni jogo mochando miyo Nyasaye luor.<verse eid="PRO 14:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32"/>Ka masira obiro, joricho itieko,</para>
  <para style="q2" vid="PRO 14:32">to kata e tho ngʼat makare nigi kar pondo.<verse eid="PRO 14:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33"/>Rieko odak e chuny ngʼat ma weche donjone,</para>
  <para style="q2" vid="PRO 14:33">to kata mana e dier joma ofuwo omiyo ingʼeye.<verse eid="PRO 14:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34"/>Tim makare tingʼo oganda malo,</para>
  <para style="q2" vid="PRO 14:34">to richo en wichkuot ne ji.<verse eid="PRO 14:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35"/>Ruoth mor gi jatich mariek,</para>
  <para style="q2" vid="PRO 14:35">to jatich makwodo wich yudo mirimbe.<verse eid="PRO 14:35"/></para>
  <para style="b"/>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1"/>Dwoko wach mamuol kweyo mirima,</para>
  <para style="q2" vid="PRO 15:1">to wach makwiny jimbo ich wangʼ.<verse eid="PRO 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2"/>Lew ngʼat mariek konyore gi rieko,</para>
  <para style="q2" vid="PRO 15:2">to dho ngʼat mofuwo hulo gik mofuwo.<verse eid="PRO 15:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3"/>Wenge Jehova Nyasaye ni kuonde duto,</para>
  <para style="q2" vid="PRO 15:3">karito joricho gi joma beyo.<verse eid="PRO 15:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4"/>Lep makelo ber en yath mar ngima,</para>
  <para style="q2" vid="PRO 15:4">to lep mar miriambo omiyo chuny bedo mool.<verse eid="PRO 15:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5"/>Ngʼat mofuwo chayo kum mar wuon mare,</para>
  <para style="q2" vid="PRO 15:5">to ngʼat mawinjo ka ikwere nyiso rieko.<verse eid="PRO 15:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6"/>Od ngʼat makare otingʼo mwandu maduongʼ,</para>
  <para style="q2" vid="PRO 15:6">to pok mar joricho kelo nigi chandruok.<verse eid="PRO 15:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7"/>Dho jomariek lando ngʼeyo,</para>
  <para style="q2" vid="PRO 15:7">to ngʼat mofuwo to wechene obam.<verse eid="PRO 15:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8"/>Jehova Nyasaye odagi misango mar jaricho,</para>
  <para style="q2" vid="PRO 15:8">to lamo mar ngʼat moriere tir miye mor.<verse eid="PRO 15:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9"/>Jehova Nyasaye odagi yore ngʼat marach,</para>
  <para style="q2" vid="PRO 15:9">to ohero jogo matimo gik makare.<verse eid="PRO 15:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10"/>Kum malit orito ngʼat maweyo yo,</para>
  <para style="q2" vid="PRO 15:10">ngʼat masin kikwere biro tho.<verse eid="PRO 15:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11"/>Jehova Nyasaye ongʼeyo gik moko matimore,</para>
  <para style="q2" vid="PRO 15:11">bed ni en Tho kata Kethruok,</para>
  <para style="q2" vid="PRO 15:11">omiyo dhano ok dipandne paro manie chunye!<verse eid="PRO 15:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12"/>Ngʼat ma jasunga dagi puonj,</para>
  <para style="q2" vid="PRO 15:12">ok odwar mondo ongʼadne rieko gi jomariek.<verse eid="PRO 15:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13"/>Chuny mamor miyo wangʼ bedo gi mor,</para>
  <para style="q2" vid="PRO 15:13">to chuny mokuyo miyo dhano bedo mool.<verse eid="PRO 15:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14"/>Chuny mongʼeyo pogo tiend weche dwaro ngʼeyo,</para>
  <para style="q2" vid="PRO 15:14">to dho ngʼat mofuwo chamo fuwo.<verse eid="PRO 15:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15"/>Ndalo duto mag ngʼat mahinyore gin thagruok,</para>
  <para style="q2" vid="PRO 15:15">to chuny mamor ni kod mor mosiko.<verse eid="PRO 15:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16"/>Ber bedo gi matin ka iluoro Jehova Nyasaye</para>
  <para style="q2" vid="PRO 15:16">moloyo mwandu mangʼeny kod koko.<verse eid="PRO 15:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17"/>Ber chamo alot kama hera nitie,</para>
  <para style="q2" vid="PRO 15:17">moloyo chamo ringʼo machwe kama achaya nitie.<verse eid="PRO 15:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18"/>Ngʼat ma iye wangʼ piyo medo miero,</para>
  <para style="q2" vid="PRO 15:18">to ngʼat ma terore mos kweyo dhawo.<verse eid="PRO 15:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19"/>Yor jasamuoyo olor gi kuthe,</para>
  <para style="q2" vid="PRO 15:19">to yor ngʼat moriere tir en yo malach.<verse eid="PRO 15:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20"/>Wuowi mariek miyo wuon mare mor,</para>
  <para style="q2" vid="PRO 15:20">to ngʼat mofuwo chayo min mare.<verse eid="PRO 15:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21"/>Fuwo moro ngʼat maonge gi rieko,</para>
  <para style="q2" vid="PRO 15:21">to ngʼat man-gi winjo wuotho moriere tir.<verse eid="PRO 15:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22"/>Chenro ok chopi nikech onge puonj makare,</para>
  <para style="q2" vid="PRO 15:22">to ka giyudo jongʼad rieko mangʼeny to gichopo.<verse eid="PRO 15:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23"/>Ngʼato yudo mor e dwoko mowinjore,</para>
  <para style="q2" vid="PRO 15:23">to mano ber manade kuom wach mochopo e sa midware.<verse eid="PRO 15:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24"/>Yor ngima telo kadhi malo ni ngʼat makare,</para>
  <para style="q2" vid="PRO 15:24">mondo ogengʼe kik odhi mwalo kar tho.<verse eid="PRO 15:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25"/>Jehova Nyasaye muko od ngʼat masungore,</para>
  <para style="q2" vid="PRO 15:25">to orito kiep dhako ma chwore otho ma ok omul.<verse eid="PRO 15:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26"/>Jehova Nyasaye odagi paro mar joricho,</para>
  <para style="q2" vid="PRO 15:26">to jogo ma chunygi ler miye mor.<verse eid="PRO 15:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27"/>Ngʼat ma jawuoro kelo chandruok ne joode,</para>
  <para style="q2" vid="PRO 15:27">to ngʼatno mamon gi asoya biro dak amingʼa.<verse eid="PRO 15:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28"/>Chuny ngʼat makare pimo dwokoge,</para>
  <para style="q2" vid="PRO 15:28">to dho ngʼat ma timbene richo hulo gik maricho.<verse eid="PRO 15:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29"/>Jehova Nyasaye bor gi ngʼat ma timbene richo,</para>
  <para style="q2" vid="PRO 15:29">to owinjo lamo mar ngʼat makare.<verse eid="PRO 15:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30"/>Neno mamor kelo mor ni chuny,</para>
  <para style="q2" vid="PRO 15:30">to wach maber miyo choke bedo gi ngima.<verse eid="PRO 15:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31"/>Ngʼat machiko ite kikwere</para>
  <para style="q2" vid="PRO 15:31">biro bedo thuolo e kind joma riek.<verse eid="PRO 15:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32"/>Ngʼat ma ok dew kum ochayore owuon,</para>
  <para style="q2" vid="PRO 15:32">to ngʼat mawinjo kikwere medo winjo wach.<verse eid="PRO 15:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33"/>Luoro Jehova Nyasaye puonjo dhano rieko,</para>
  <para style="q2" vid="PRO 15:33">to bedo mamuol kelo luor.<verse eid="PRO 15:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1"/>Chuny dhano chano gik modwaro timo,</para>
  <para style="q2" vid="PRO 16:1">to dwoko margi aa kuom Jehova Nyasaye.<verse eid="PRO 16:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2"/>Yore duto mag dhano nenorene ni longʼo,</para>
  <para style="q2" vid="PRO 16:2">to Jehova Nyasaye ema ongʼeyo mopondo mag chuny.<verse eid="PRO 16:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3"/>Ket gimoro amora mitimo e lwet Jehova Nyasaye,</para>
  <para style="q2" vid="PRO 16:3">to chenrogi biro dhi maber.<verse eid="PRO 16:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4"/>Gik moko duto ma Jehova Nyasaye timo oseketo gikogi,</para>
  <para style="q2" vid="PRO 16:4">kendo giko mar joricho en tho.<verse eid="PRO 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5"/>Jehova Nyasaye odagi ji duto man-gi sunga e chunygi.</para>
  <para style="q2" vid="PRO 16:5">Ngʼe ma malongʼo: Ok ginitony ni kum.<verse eid="PRO 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6"/>Nikech hera kod adiera ema omiyo richo otimne misango,</para>
  <para style="q2" vid="PRO 16:6">kuom luoro Jehova Nyasaye miyo ngʼato kwedo richo.<verse eid="PRO 16:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7"/>Ka yore ngʼato moro Jehova Nyasaye,</para>
  <para style="q2" vid="PRO 16:7">to omiyo kata wasike dak kode gi kwe.<verse eid="PRO 16:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8"/>Ber bedo gi matin kod tim makare,</para>
  <para style="q2" vid="PRO 16:8">moloyo mangʼeny kod tim ma ok kare.<verse eid="PRO 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9"/>E chuny dhano ochano yore,</para>
  <para style="q2" vid="PRO 16:9">to Jehova Nyasaye ema telone ondamo mage.<verse eid="PRO 16:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10"/>Ruoth wuoyo kaka chik mar Nyasaye dwaro,</para>
  <para style="q2" vid="PRO 16:10">to dhoge ok onego ndhog bura makare.<verse eid="PRO 16:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11"/>Rapim mopogore opogore makare aa kuom Jehova Nyasaye,</para>
  <para style="q2" vid="PRO 16:11">to gik mipimogo manie mifuke gin meke moloso.<verse eid="PRO 16:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12"/>Ruodhi mon gi timbe maricho,</para>
  <para style="q2" vid="PRO 16:12">nikech kom mar loch obedo mana kuom tim makare.<verse eid="PRO 16:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13"/>Ruodhi ohero joma wacho adiera</para>
  <para style="q2" vid="PRO 16:13">kendo gigeno ngʼat mawacho adiera.<verse eid="PRO 16:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14"/>Mirimb ruoth en jaote mar tho,</para>
  <para style="q2" vid="PRO 16:14">to ngʼat mariek biro hoye.<verse eid="PRO 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15"/>Ka wangʼ ruoth nenore mamor to nitiere ngima,</para>
  <para style="q2" vid="PRO 16:15">ngʼwonone chalo gi rumbi mag koth e ndalo chwiri.<verse eid="PRO 16:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16"/>To ber maromo nade yudo rieko moloyo dhahabu,</para>
  <para style="q2" vid="PRO 16:16">yiero ngʼeyo tiend wach moloyo fedha!<verse eid="PRO 16:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17"/>Yor ngʼat moriere tir kwedore gi richo;</para>
  <para style="q2" vid="PRO 16:17">ngʼat manono yorene orito ngimane!<verse eid="PRO 16:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18"/>Sunga kelo masira,</para>
  <para style="q2" vid="PRO 16:18">chuny mar ngʼayi kelo chwanyruok.<verse eid="PRO 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19"/>Ber bedo gi chuny mobolore e dier jochan,</para>
  <para style="q2" vid="PRO 16:19">moloyo pogo gik moyaki gi josunga.<verse eid="PRO 16:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20"/>Ngʼato angʼata mawinjo puonj dhi maber,</para>
  <para style="q2" vid="PRO 16:20">to ojahawi ngʼatno moketo genone kuom Jehova Nyasaye.<verse eid="PRO 16:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21"/>Ngʼat man-gi paro en ngʼat mariek,</para>
  <para style="q2" vid="PRO 16:21">kendo weche mowacho gin mana puonj.<verse eid="PRO 16:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22"/>Winjo wach en soko mar ngima ne jogo man kode,</para>
  <para style="q2" vid="PRO 16:22">to fuwo kelo kum ne joma ofuwo.<verse eid="PRO 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23"/>Ngʼat mariek rito weche mawuok e dhoge,</para>
  <para style="q2" vid="PRO 16:23">kendo wechene mowinjore kelo puonj makare.<verse eid="PRO 16:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24"/>Weche mag mor chalo gi mor kich</para>
  <para style="q2" vid="PRO 16:24">gimit ne chuny kendo gikelo ngima ni choke.<verse eid="PRO 16:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25"/>Nitie yo manenore ne dhano ni nikare,</para>
  <para style="q2" vid="PRO 16:25">to gikone otero mana ngʼato e tho.<verse eid="PRO 16:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26"/>Miluma ma jatich nigo miyo otiyo matek,</para>
  <para style="q2" vid="PRO 16:26">kendo kech makaye miyo omedo tiyo matek.<verse eid="PRO 16:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27"/>Ngʼat marach chano timo timbe maricho,</para>
  <para style="q2" vid="PRO 16:27">to wechene chalo mach mager.<verse eid="PRO 16:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28"/>Ngʼat ma timbene richo kelo mana miero,</para>
  <para style="q2" vid="PRO 16:28">to jakwoth pogo osiepe moherore.<verse eid="PRO 16:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29"/>Ngʼat ma ja-mahundu wuondo jabute</para>
  <para style="q2" vid="PRO 16:29">mi otere e yorno ma ok ber.<verse eid="PRO 16:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30"/>Tangʼ gi ngʼat ma buonjo kodi nikech onyalo bet ni ochano timoni marach,</para>
  <para style="q2" vid="PRO 16:30">ngʼatno maluwo dhoge ochomo timbe maricho.<verse eid="PRO 16:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31"/>Lwar en osimbo mar duongʼ</para>
  <para style="q2" vid="PRO 16:31">to iyude gi ngʼat man-gi ngima makare.<verse eid="PRO 16:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32"/>Ngʼat ma terore mos ber moloyo jalweny,</para>
  <para style="q2" vid="PRO 16:32">ngʼat makweyo mirimbe ber moloyo ngʼat mamonjo dala maduongʼ.<verse eid="PRO 16:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33"/>Igoyo ombulu mondo ongʼe gima ditim,</para>
  <para style="q2" vid="PRO 16:33">to kuom ngʼado weche duto Jehova Nyasaye ema tieko.<verse eid="PRO 16:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1"/>Ber bangʼo kuon gi kwe kod mor</para>
  <para style="q2" vid="PRO 17:1">moloyo ot mopongʼ gi chiemo mathoth kod dhawo.<verse eid="PRO 17:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2"/>Misumba mariek biro bedo gi loch kuom wuowi makwodo wich,</para>
  <para style="q2" vid="PRO 17:2">kendo obiro yudo pok mar girkeni machal mana gi owetene.<verse eid="PRO 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3"/>Dhahabu gi fedha itemo gi mach,</para>
  <para style="q2" vid="PRO 17:3">to Jehova Nyasaye ema temo chuny.<verse eid="PRO 17:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4"/>Ngʼat ma timbene richo chiko ite ne dhok mopongʼ gi richo,</para>
  <para style="q2" vid="PRO 17:4">ja-miriambo winjo lep mar ajara.<verse eid="PRO 17:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5"/>Ngʼat ma jaro jochan ochayo Jachwechgi;</para>
  <para style="q2" vid="PRO 17:5">ngʼat mamor gi masira ok notony ne kum.<verse eid="PRO 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6"/>Nyikwayo gin osimbo ne joma oti,</para>
  <para style="q2" vid="PRO 17:6">to jonywol e mor mar nyithindgi.<verse eid="PRO 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7"/>Lep mar sunga ok owinjore ne ngʼama ofuwo,</para>
  <para style="q2" vid="PRO 17:7">to en rach maromo nadi lep mariambo ne jaloch!<verse eid="PRO 17:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8"/>Asoya en bilo ne ngʼat machiwe,</para>
  <para style="q2" vid="PRO 17:8">kamoro amora modhiye, odhi maber.<verse eid="PRO 17:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9"/>Ngʼat ma umo ketho mewo hera,</para>
  <para style="q2" vid="PRO 17:9">to ngʼat mamedo timo gima kamano pogo osiepe moherore.<verse eid="PRO 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10"/>Puonj mar kwer konyo ngʼat mariek,</para>
  <para style="q2" vid="PRO 17:10">moloyo chwat nyadi mia ni ngʼat mofuwo.<verse eid="PRO 17:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11"/>Ngʼat ma jaricho ohero mana miero,</para>
  <para style="q2" vid="PRO 17:11">jaote makwiny ema ibiro orone.<verse eid="PRO 17:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12"/>Ber romo gi ondiek madhako moma nyithinde,</para>
  <para style="q2" vid="PRO 17:12">moloyo romo gi ngʼat mofuwo ei fupe.<verse eid="PRO 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13"/>Ka ngʼato chulo rach kar ber,</para>
  <para style="q2" vid="PRO 17:13">rach ok nowe ode.<verse eid="PRO 17:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14"/>Chako dhawo chalo gimuko yawo,</para>
  <para style="q2" vid="PRO 17:14">emomiyo we wach kapok dhawo owuok.<verse eid="PRO 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15"/>Jehova Nyasaye mon-gi ngʼama chwako jaketho</para>
  <para style="q2" vid="PRO 17:15">kata kumo ngʼat maonge ketho.<verse eid="PRO 17:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16"/>Ere tiende mondo ngʼat mofuwo obed gi pesa</para>
  <para style="q2" vid="PRO 17:16">nimar oonge gi dwaro mar bedo mariek?<verse eid="PRO 17:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17"/>En adier ni osiepni nyalo heri kinde duto,</para>
  <para style="q2" vid="PRO 17:17">to owadu ema konyi e chandruok.<verse eid="PRO 17:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18"/>Ngʼat maonge gi rieko</para>
  <para style="q2" vid="PRO 17:18">ema keto gir singo ne jabute.<verse eid="PRO 17:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19"/>Ngʼat mohero dhawo ohero richo;</para>
  <para style="q2" vid="PRO 17:19">ngʼat mogero ohinga mabor kelo mana hinyruok.<verse eid="PRO 17:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20"/>Ngʼat man-gi chuny marach ok nyal dhi maber;</para>
  <para style="q2" vid="PRO 17:20">ngʼat ma lewe riambo podho e chandruok.<verse eid="PRO 17:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21"/>Bedo gi ngʼat mofuwo kaka wuowi kelo kuyo;</para>
  <para style="q2" vid="PRO 17:21">onge mor ni wuoro ma wuon ngʼat mofuwo.<verse eid="PRO 17:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22"/>Chuny mamor en yath maber,</para>
  <para style="q2" vid="PRO 17:22">to chuny mool tuoyo choke.<verse eid="PRO 17:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23"/>Ngʼat ma timbene richo yie asoya kama opondo</para>
  <para style="q2" vid="PRO 17:23">mondo oketh gima kare.<verse eid="PRO 17:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24"/>Ngʼat mariek keto rieko mondo otel,</para>
  <para style="q2" vid="PRO 17:24">to wenge ngʼat mofuwo bayo nyaka giko piny.<verse eid="PRO 17:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25"/>Wuowi mofuwo kelo kuyo ni wuon mare</para>
  <para style="q2" vid="PRO 17:25">kod chuny lit ne ngʼat mane onywole.<verse eid="PRO 17:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26"/>Ok en gima ber kumo ngʼat maonge ketho</para>
  <para style="q2" vid="PRO 17:26">kata goyo joote nikech dimbruokgi.<verse eid="PRO 17:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27"/>Ngʼat man-gi ngʼeyo konyore gi weche kotangʼ;</para>
  <para style="q2" vid="PRO 17:27">to ngʼat man-gi winjo wach to ritore maber.<verse eid="PRO 17:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28"/>Kata ngʼat mofuwo ikwano ka ngʼat mariek ka olingʼ thi;</para>
  <para style="q2" vid="PRO 17:28">kendo ka ngʼat mongʼeyo ka orito lewe.<verse eid="PRO 17:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1"/>Ngʼat ma ok jahera dwaro mana gige</para>
  <para style="q2" vid="PRO 18:1">ok owinj puonj moro amora.<verse eid="PRO 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2"/>Ngʼat mofuwo ok mor kod winjo wach</para>
  <para style="q2" vid="PRO 18:2">to omor mana gi wacho paroge owuon.<verse eid="PRO 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3"/>Ka richo biro, e kaka achaya biro,</para>
  <para style="q2" vid="PRO 18:3">to wichkuot kelo duwruok.<verse eid="PRO 18:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4"/>Weche mag dho ngʼato tut ka nam,</para>
  <para style="q2" vid="PRO 18:4">to soko mar rieko en aora mabubni kamol.<verse eid="PRO 18:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5"/>Ok en gima ber chwako ngʼat ma timbene richo</para>
  <para style="q2" vid="PRO 18:5">kata ketho buch ngʼato maonge ketho.<verse eid="PRO 18:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6"/>Lew ngʼat mofuwo kelone dhawo,</para>
  <para style="q2" vid="PRO 18:6">to dhoge luongo goch.<verse eid="PRO 18:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7"/>Dho ngʼat mofuwo ema tieke,</para>
  <para style="q2" vid="PRO 18:7">to lewe ema bedo obadho ne ngimane.<verse eid="PRO 18:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8"/>Weche mag kuoth chalo gi chiemo mamit;</para>
  <para style="q2" vid="PRO 18:8">gidhiyo e chuny dhano ma iye.<verse eid="PRO 18:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9"/>Ngʼat ma jasamuoyo e tich</para>
  <para style="q2" vid="PRO 18:9">en owadgi ngʼat maketho gik moko.<verse eid="PRO 18:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10"/>Nying Jehova Nyasaye en ohinga maratego,</para>
  <para style="q2" vid="PRO 18:10">ngʼat makare ringo ma pond kanyo kendo yud resruok.<verse eid="PRO 18:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11"/>Mwandu mar jomoko e ohinga mochiel motegno ma gigengʼorego,</para>
  <para style="q2" vid="PRO 18:11">giparo ni en ohinga maonge ngʼama nyalo muko.<verse eid="PRO 18:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12"/>Kapok ngʼato opodho, to sunga bedo e chunye,</para>
  <para style="q2" vid="PRO 18:12">to muolo kelo pak.<verse eid="PRO 18:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13"/>Chik iti kapok idwoko wach;</para>
  <para style="q2" vid="PRO 18:13">ka ok itimo kamano to ibedo mofuwo kendo ikelo wichkuot.<verse eid="PRO 18:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14"/>Chuny ngʼato sire e tuo,</para>
  <para style="q2" vid="PRO 18:14">to chuny mool, en ngʼa manyalo konyo?<verse eid="PRO 18:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15"/>Chuny ma weche donjone yudo ngʼeyo;</para>
  <para style="q2" vid="PRO 18:15">to it mariek dwaro mondo weche odonjne.<verse eid="PRO 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16"/>Chiwo yawo yo ne ngʼat machiwo</para>
  <para style="q2" vid="PRO 18:16">kendo tere e nyim jomadongo.<verse eid="PRO 18:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17"/>Ngʼat mokwongo keto wachne nenore ni en kare,</para>
  <para style="q2" vid="PRO 18:17">nyaka ngʼat machielo bi maket penjo ne wachneno.<verse eid="PRO 18:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18"/>Goyo ombulu tieko larruok</para>
  <para style="q2" vid="PRO 18:18">kendo thego joma roteke.<verse eid="PRO 18:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19"/>Kiketho ne owadu to duoge iri tek</para>
  <para style="q2" vid="PRO 18:19">mana kadonjo e dala maduongʼ mochiel motegno;</para>
  <para style="q2" vid="PRO 18:19">to larruok chalo gi dhorangeye mag dala modin gi lodi.<verse eid="PRO 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20"/>Wach mawuok e dho ngʼato ema miyo ngʼato yiengʼ;</para>
  <para style="q2" vid="PRO 18:20">keyo mar dhoge ema miyo oyiengʼ.<verse eid="PRO 18:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21"/>Lep nigi teko mar ngima kod tho,</para>
  <para style="q2" vid="PRO 18:21">to jogo mohere biro chamo olembe.<verse eid="PRO 18:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22"/>Ngʼatno moyudo dhako onwangʼo gima ber</para>
  <para style="q2" vid="PRO 18:22">kendo oyudo ngʼwono moa kuom Jehova Nyasaye.<verse eid="PRO 18:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23"/>Ngʼat ma jachan ywak kokwayo ngʼwono,</para>
  <para style="q2" vid="PRO 18:23">to ngʼat ma jamoko dwoko gi gero.<verse eid="PRO 18:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24"/>Ngʼat man-gi osiepe mangʼeny nyalo chopo e kethruok</para>
  <para style="q2" vid="PRO 18:24">to nitie osiep moro masiko buti machiegni maloyo owadu.<verse eid="PRO 18:24"/></para>
  <para style="b"/>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1"/>Ber bedo jachan ma wuodhe ok nyal cha,</para>
  <para style="q2" vid="PRO 19:1">moloyo ngʼat mofuwo ma lewe timo richo.<verse eid="PRO 19:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2"/>Ok ber bedo gi gombo maonge gi ngʼeyo,</para>
  <para style="q2" vid="PRO 19:2">kata bedo ka irikni kae to ibayo yo.<verse eid="PRO 19:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3"/>Fuwo mar ngʼato owuon ketho ngimane;</para>
  <para style="q2" vid="PRO 19:3">to bende chunye bedo mager gi Jehova Nyasaye.<verse eid="PRO 19:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4"/>Mwandu kelo osiepe mangʼeny,</para>
  <para style="q2" vid="PRO 19:4">to osiep ngʼat ma jachan ringe.<verse eid="PRO 19:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5"/>Janeno ma ja-miriambo ok notony ma ok okum,</para>
  <para style="q2" vid="PRO 19:5">to ngʼatno malando miriambo ok nobed thuolo.<verse eid="PRO 19:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6"/>Ji mangʼeny temo mondo oyud pwoch kuom ruoth,</para>
  <para style="q2" vid="PRO 19:6">to ngʼato ka ngʼato bedo osiep ngʼat machiwo mich.<verse eid="PRO 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7"/>Ngʼat ma jachan wedene duto kwede,</para>
  <para style="q2" vid="PRO 19:7">osiepene to noringe maromo nadi!</para>
  <para style="q1" vid="PRO 19:7">Kata bed notemo sayogi</para>
  <para style="q2" vid="PRO 19:7">onge kama doyudgie.<verse eid="PRO 19:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8"/>Ngʼatno moyudo rieko ohero chunye owuon,</para>
  <para style="q2" vid="PRO 19:8">to ngʼat mohero winjo wach dhi maber.<verse eid="PRO 19:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9"/>Janeno ma ja-miriambo ok notony ma ok okume,</para>
  <para style="q2" vid="PRO 19:9">to ngʼatno malando miriambo biro lal nono.<verse eid="PRO 19:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10"/>Ok en gima owinjore mondo ngʼat mofuwo odagi e ber,</para>
  <para style="q2" vid="PRO 19:10">to en gima rach machalo nadi ka misumba ema omi loch kuom yawuot ruoth!<verse eid="PRO 19:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11"/>Ngʼat mariek iye ok wangʼ piyo;</para>
  <para style="q2" vid="PRO 19:11">oyudo duongʼ kuom weyo wach ma ok odewo ketho.<verse eid="PRO 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12"/>Gero mar ruoth chalo gi sibuor maruto,</para>
  <para style="q2" vid="PRO 19:12">to ka omor kodi to ochalo gi tho manie wi lum.<verse eid="PRO 19:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13"/>Wuowi mofuwo kelone wuon mare masira,</para>
  <para style="q2" vid="PRO 19:13">to dhako maralep chalo gi kodh ajiki.<verse eid="PRO 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14"/>Ute kod mwandu gin girkeni miyudo kuom jonywol,</para>
  <para style="q2" vid="PRO 19:14">to dhako mariek aa kuom Jehova Nyasaye.<verse eid="PRO 19:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15"/>Samuoyo kelo nindo matut,</para>
  <para style="q2" vid="PRO 19:15">to ngʼat ma ja-mifwadhi bedo gi kech.<verse eid="PRO 19:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16"/>Ngʼatno morito chike Jehova Nyasaye kendo timo gik mopuonje biro dak amingʼa,</para>
  <para style="q2" vid="PRO 19:16">to ngʼat mochayo chikene biro tho.<verse eid="PRO 19:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17"/>Ngʼat manyiso ngʼwono ne jochan, holo mana Jehova Nyasaye,</para>
  <para style="q2" vid="PRO 19:17">obiro gwedhe kuom gik mosetimo.<verse eid="PRO 19:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18"/>Kum wuodi, nikech mano e kama geno nitie;</para>
  <para style="q2" vid="PRO 19:18">kik ibed e winjruok kuom gima nyalo kelone tho.<verse eid="PRO 19:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19"/>Ngʼat ma ja-mirima nyaka yud kum, kendo ka ikonye,</para>
  <para style="q2" vid="PRO 19:19">to chuno ni nyaka itim kamano kendo.<verse eid="PRO 19:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20"/>Chik iti ka ingʼadoni rieko kendo rwak puonj,</para>
  <para style="q2" vid="PRO 19:20">to giko ni inibed mariek.<verse eid="PRO 19:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21"/>Dhano nigi chenro mangʼeny e chunye,</para>
  <para style="q2" vid="PRO 19:21">to dwaro mar Jehova Nyasaye ema timore.<verse eid="PRO 19:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22"/>Gima dhano dwaro en hera ma ok rum,</para>
  <para style="q2" vid="PRO 19:22">ber bedo jachan moloyo bedo ja-miriambo.<verse eid="PRO 19:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23"/>Luoro Jehova Nyasaye tero ji e ngima;</para>
  <para style="q2" vid="PRO 19:23">eka ngʼato yweyo kodhil, ma ok omule gi chandruok.<verse eid="PRO 19:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24"/>Jasamuoyo luto lwete malal ei tawo;</para>
  <para style="q2" vid="PRO 19:24">kendo ok onyal gole oko moduoge e dhoge!<verse eid="PRO 19:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25"/>Chwad jasunga mondo joma ngʼeyogi tin opuonjre;</para>
  <para style="q2" vid="PRO 19:25">kwer ngʼat man-gi rieko, to obiro medo fwenyo tiend weche.<verse eid="PRO 19:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26"/>Ngʼat mamayo wuon mare kendo riembo min mare</para>
  <para style="q2" vid="PRO 19:26">en wuowi makelo wichkuot kod dwanyruok.<verse eid="PRO 19:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27"/>Kidagi chiko iti ne puonj in wuoda,</para>
  <para style="q2" vid="PRO 19:27">to ibiro bayo mabor kuom weche mag ngʼeyo.<verse eid="PRO 19:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28"/>Janeno ma ja-jar ji ochayo adiera,</para>
  <para style="q2" vid="PRO 19:28">to dho ngʼat ma timbene richo golo mana richo.<verse eid="PRO 19:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29"/>Kum oket mana ne jo-achaya,</para>
  <para style="q2" vid="PRO 19:29">to chwat ne ngʼe joma ofuwo.<verse eid="PRO 19:29"/></para>
  <para style="b"/>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1"/>Divai en jajaro to kongʼo en koko;</para>
  <para style="q2" vid="PRO 20:1">ngʼat motelne kodgi onge rieko.<verse eid="PRO 20:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2"/>Mirimb ruoth chalo gi ruto mar sibuor;</para>
  <para style="q2" vid="PRO 20:2">ngʼat momiyo obedo gi gero lalo ngimane.<verse eid="PRO 20:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3"/>Enobed luor maduongʼ ne ngʼatno ma dagi dhawo,</para>
  <para style="q2" vid="PRO 20:3">to joma ofuwo duto ohero dhawo.<verse eid="PRO 20:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4"/>Jasamuoyo ok pur puothe e kinde mowinjore;</para>
  <para style="q2" vid="PRO 20:4">omiyo e kinde mar keyo omanyo, to ok oyud gimoro.<verse eid="PRO 20:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5"/>Dwaro mar chuny dhano chalo gi pi matut,</para>
  <para style="q2" vid="PRO 20:5">to ngʼat man-gi winjo twomogi.<verse eid="PRO 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6"/>Ji mangʼeny wacho ni gin gihera ma adiera;</para>
  <para style="q2" vid="PRO 20:6">to ngʼat ma ja-adiera, en ngʼa ma diyude?<verse eid="PRO 20:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7"/>Ngʼat makare nigi ngima ma ok ocha;</para>
  <para style="q2" vid="PRO 20:7">nyithinde nigi gweth bangʼe.<verse eid="PRO 20:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8"/>Ka ruoth obedo e kome mondo ongʼad bura;</para>
  <para style="q2" vid="PRO 20:8">opiedho weche maricho duto gi wangʼe.<verse eid="PRO 20:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9"/>En ngʼa manyalo wacho niya, “Aserito chunya maler;</para>
  <para style="q2" vid="PRO 20:9">aler kendo aonge richo?”<verse eid="PRO 20:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10"/>Rapim ma ok nikare gi pimo ma ok kare,</para>
  <para style="q2" vid="PRO 20:10">Jehova Nyasaye mon kodgi duto.<verse eid="PRO 20:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11"/>Kata mana nyathi ingʼeyo gi timbene,</para>
  <para style="q2" vid="PRO 20:11">omiyo ingʼeyo ka kite obidhore kata ni kare.<verse eid="PRO 20:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12"/>It mawinjo gi wangʼ maneno,</para>
  <para style="q2" vid="PRO 20:12">Jehova Nyasaye ema osechweyo gik moko ariyogo.<verse eid="PRO 20:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13"/>Kik iher nindo nono to ibiro bedo jachan,</para>
  <para style="q2" vid="PRO 20:13">bed kineno to ok ibi chando chiemo.<verse eid="PRO 20:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14"/>Jangʼiewo wacho niya, “Ok ber ngangʼ, ok ber ngangʼ!”</para>
  <para style="q2" vid="PRO 20:14">To bangʼe owuok odhiyo ka osungore ni ongʼiewo gi nengo mayot.<verse eid="PRO 20:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15"/>Dhahabu nitie, kendo kite ma nengogi tek bende nitie mogundho,</para>
  <para style="q2" vid="PRO 20:15">to dhok mawacho weche mag ngʼeyo gin kaka mula mabeyo mayudo tek.<verse eid="PRO 20:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16"/>Kaw law ngʼat mochungʼne ngʼat mokia kaka singo;</para>
  <para style="q2" vid="PRO 20:16">mak gino mosingorego, ka otimo kamano ni dhako majabayo.<verse eid="PRO 20:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17"/>Chiemo moyud e yo ma ok kare mit ne ngʼato,</para>
  <para style="q2" vid="PRO 20:17">to achien omuodore mana ka kuoyo.<verse eid="PRO 20:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18"/>Los chenro ka ikonyori gi ngʼado rieko;</para>
  <para style="q2" vid="PRO 20:18">ka ichako lweny to dwar ikruok maber.<verse eid="PRO 20:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19"/>Fuongʼo wach ketho genruok;</para>
  <para style="q2" vid="PRO 20:19">omiyo tangʼ ni ngʼato ma wuoyo mathoth.<verse eid="PRO 20:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20"/>Ka ngʼato okwongʼo wuon mare kata min mare,</para>
  <para style="q2" vid="PRO 20:20">to ngimane norum mana ka taya motho e mudho molil.<verse eid="PRO 20:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21"/>Mwandu moyud motelo e yo mayot</para>
  <para style="q2" vid="PRO 20:21">ok bi bedo konyruok e kinde machien.<verse eid="PRO 20:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22"/>Kik iwach niya, “Abiro chulo kuor kuom rachni motimna!”</para>
  <para style="q2" vid="PRO 20:22">Bed kirito Jehova Nyasaye to obiro resi.<verse eid="PRO 20:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23"/>Jehova Nyasaye mon gi rapim mag miriambo,</para>
  <para style="q2" vid="PRO 20:23">kendo rapim ma ok kare ok miye mor.<verse eid="PRO 20:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24"/>Okange mag ngʼato ichiko gi Jehova Nyasaye.</para>
  <para style="q2" vid="PRO 20:24">Ere kaka ngʼato nyalo ngʼeyo yore owuon?<verse eid="PRO 20:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25"/>En obadho ne ngʼato masingo gimoro ka ok oparo,</para>
  <para style="q2" vid="PRO 20:25">to achien eka oparo singruokne.<verse eid="PRO 20:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26"/>Ruoth mariek riembo joma timbegi richo;</para>
  <para style="q2" vid="PRO 20:26">okumogi ma ok okechogi.<verse eid="PRO 20:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27"/>Taya mar Jehova Nyasaye manyo chuny dhano,</para>
  <para style="q2" vid="PRO 20:27">kendo omanyo chunye ma iye.<verse eid="PRO 20:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28"/>Hera kod adiera miyo ruoth bedo gi kwe,</para>
  <para style="q2" vid="PRO 20:28">nikech hera, lochne bedo motegno.<verse eid="PRO 20:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29"/>Sunga ma yawuowi nigo e teko margi,</para>
  <para style="q2" vid="PRO 20:29">to lwar en duongʼ ne jodongo.<verse eid="PRO 20:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30"/>Goch kod adhonde pwodho richo,</para>
  <para style="q2" vid="PRO 20:30">to chwat loso maler chuny maiye.<verse eid="PRO 20:30"/></para>
  <para style="b"/>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1"/>Chuny ruoth ni e lwet Jehova Nyasaye,</para>
  <para style="q2" vid="PRO 21:1">ochike mana kaka kuonde ma pi luwo kendo kaka ohero owuon.<verse eid="PRO 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2"/>Yore duto mag dhano nenorene ni nikare,</para>
  <para style="q2" vid="PRO 21:2">to Jehova Nyasaye ema pimo chuny.<verse eid="PRO 21:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3"/>Timo gima kare kod mowinjore</para>
  <para style="q2" vid="PRO 21:3">ema Jehova Nyasaye oyiego moloyo misango.<verse eid="PRO 21:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4"/>Wangʼ teko, chuny mar sunga</para>
  <para style="q2" vid="PRO 21:4">kod taya mar jo-mahundu, gin richo!<verse eid="PRO 21:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5"/>Chenro mag ngʼat matiyo matek kelo ohala</para>
  <para style="q2" vid="PRO 21:5">to chutho e kaka rikni kelo chan.<verse eid="PRO 21:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6"/>Mwandu moyudi gi lep mariambo</para>
  <para style="q2" vid="PRO 21:6">en mana tho malal piyo kendo en obeto mar tho.<verse eid="PRO 21:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7"/>Timbe mahundu mar joricho biro terogi mabor magilal;</para>
  <para style="q2" vid="PRO 21:7">nimar gidagi timo gima kare.<verse eid="PRO 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8"/>Yor ngʼat ma jaketho ogondore,</para>
  <para style="q2" vid="PRO 21:8">to kit ngʼat makare oriere tir.<verse eid="PRO 21:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9"/>Ber dak e kona mar wi ot</para>
  <para style="q2" vid="PRO 21:9">moloyo dak gi dhako maralep.<verse eid="PRO 21:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10"/>Ngʼat ma timbene richo ohero richo;</para>
  <para style="q2" vid="PRO 21:10">jabute ok yud ngʼwono kuome.<verse eid="PRO 21:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11"/>Ka okum ngʼat ma jaro ji, to joma ngʼeyogi tin yudo rieko,</para>
  <para style="q2" vid="PRO 21:11">ka ngʼat mariek opuonji, to oyudo ngʼeyo.<verse eid="PRO 21:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12"/>Ngʼat Makare ongʼeyo od ngʼat ma timbene richo</para>
  <para style="q2" vid="PRO 21:12">kendo otero ngʼat marach e kethruok.<verse eid="PRO 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13"/>Ka ngʼato odino ite ne ywak mar jachan,</para>
  <para style="q2" vid="PRO 21:13">en owuon bende obiro ywak to ok nodwoke.<verse eid="PRO 21:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14"/>Mich mochiw lingʼ-lingʼ kweyo mirima</para>
  <para style="q2" vid="PRO 21:14">to asoya mopandi ei law jiwo mirima maduongʼ.<verse eid="PRO 21:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15"/>Ka adiera onenore, to joma timbegi nikare bedo mamor</para>
  <para style="q2" vid="PRO 21:15">to joma timbegi richo to yudo bwok.<verse eid="PRO 21:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16"/>Ngʼat moweyo yor winjo wach</para>
  <para style="q2" vid="PRO 21:16">dhiyo kar yweyo mar oganda mar joma otho.<verse eid="PRO 21:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17"/>Ngʼat mohero budho biro bedo jachan;</para>
  <para style="q2" vid="PRO 21:17">ngʼat mohero divai kod moo ok nyal bedo ja-mwandu.<verse eid="PRO 21:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18"/>Jomaricho bedo resruok mar joma kare;</para>
  <para style="q2" vid="PRO 21:18">to jogo ma ok jo-adiera ne joma oriere tir.<verse eid="PRO 21:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19"/>Ber dak e thim motwo</para>
  <para style="q2" vid="PRO 21:19">moloyo dak gi dhako ma jadhawo kendo ma ja-mirima.<verse eid="PRO 21:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20"/>Od ngʼat mariek opongʼ kod chiemo gi moo moyier,</para>
  <para style="q2" vid="PRO 21:20">to ngʼat mofuwo chamo gik moko duto ma en-go.<verse eid="PRO 21:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21"/>Ngʼatno maluwo tim makare kod hera</para>
  <para style="q2" vid="PRO 21:21">yudo ngima, mwandu gi luor.<verse eid="PRO 21:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22"/>Ngʼat mariek kawo dala ngʼat maratego</para>
  <para style="q2" vid="PRO 21:22">kendo omuko dhorangeye matek magiketoe genogi.<verse eid="PRO 21:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23"/>Ngʼatno marito dhoge kod lewe</para>
  <para style="q2" vid="PRO 21:23">ritore kuom masiche.<verse eid="PRO 21:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24"/>Ngʼat ma jasunga kendo jawuorre “Jajaro” e nyinge;</para>
  <para style="q2" vid="PRO 21:24">otingʼore malo ka osungore malich.<verse eid="PRO 21:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25"/>Dwaro mar jasamuoyo biro bedo thone owuon;</para>
  <para style="q2" vid="PRO 21:25">nikech lwetene odagi tich.<verse eid="PRO 21:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26"/>Odiechiengʼ duto odwaro mangʼeny,</para>
  <para style="q2" vid="PRO 21:26">to ngʼat makare chiwo maonge giko.<verse eid="PRO 21:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27"/>Misango mar jaricho ok ber,</para>
  <para style="q2" vid="PRO 21:27">onyalo bedo marach maromo nade ka ochiwe gi paro marach!<verse eid="PRO 21:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28"/>Janeno ma ja-miriambo biro lal;</para>
  <para style="q2" vid="PRO 21:28">to ngʼat mawinje ibiro tieko chutho.<verse eid="PRO 21:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29"/>Ngʼat ma jaricho wangʼe tek</para>
  <para style="q2" vid="PRO 21:29">to ngʼat moriere tir tiyo gi paro e yorene.<verse eid="PRO 21:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30"/>Onge rieko, onge neno matut,</para>
  <para style="q2" vid="PRO 21:30">onge chenro manyalo loyo Jehova Nyasaye.<verse eid="PRO 21:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31"/>Inyalo yiko faras ne ndalo mar lweny;</para>
  <para style="q2" vid="PRO 21:31">to loyo lweny en mar Jehova Nyasaye.<verse eid="PRO 21:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1"/>Nying maber oloyo bedo gi mwandu mathoth;</para>
  <para style="q2" vid="PRO 22:1">bedo gi pwoch ber moloyo fedha gi dhahabu.<verse eid="PRO 22:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2"/>Onge pogruok e kind jamoko kod jachan:</para>
  <para style="q2" vid="PRO 22:2">Nikech Jehova Nyasaye e Jachwechgi duto.<verse eid="PRO 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3"/>Ngʼat mariek neno masira kabiro kendo opondo,</para>
  <para style="q2" vid="PRO 22:3">to ngʼat mofuwo dhiyo adhiya nyime ma ohinyre.<verse eid="PRO 22:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4"/>Bolruok kod luoro Jehova Nyasaye</para>
  <para style="q2" vid="PRO 22:4">kelo mwandu gi luor kod dak amingʼa.<verse eid="PRO 22:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5"/>Yore joma timo richo opongʼ gi kudho kod obadho;</para>
  <para style="q2" vid="PRO 22:5">to ngʼat morito chunye obedo mabor kodgi.<verse eid="PRO 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6"/>Puonj nyathi e yo monego odhiye,</para>
  <para style="q2" vid="PRO 22:6">to ka obedo maduongʼ to ok obi baro oa kuome.<verse eid="PRO 22:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7"/>Jochan gin wasumb jo-mwandu,</para>
  <para style="q2" vid="PRO 22:7">to ngʼat moholo gimoro bedo misumba ngʼat mohole.<verse eid="PRO 22:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8"/>Ngʼatno mochwowo timbe richo kayo thagruok,</para>
  <para style="q2" vid="PRO 22:8">to ludhe mar mirima ibiro ketho.<verse eid="PRO 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9"/>Ngʼat mangʼwon noyud gweth,</para>
  <para style="q2" vid="PRO 22:9">nimar opogo chiembe kod jochan.<verse eid="PRO 22:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10"/>Riemb ngʼat ma jaro ji, to lweny bende aa,</para>
  <para style="q2" vid="PRO 22:10">dhawo kod kinyruok rumo.<verse eid="PRO 22:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11"/>Ngʼat ma chunye ler kendo ma wuoyo gi ngʼwono</para>
  <para style="q2" vid="PRO 22:11">biro bedo osiep ruoth.<verse eid="PRO 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12"/>Wangʼ Jehova Nyasaye rito ngʼeyo;</para>
  <para style="q2" vid="PRO 22:12">to orundo weche mag jogo ma ok jo-adiera.<verse eid="PRO 22:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13"/>Jasamuoyo wacho niya, “Sibuor ni oko!”</para>
  <para style="q2" vid="PRO 22:13">Kata, “Ibiro nega e yore mag dala!”<verse eid="PRO 22:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14"/>Dho dhako ma jachode en bur matut;</para>
  <para style="q2" vid="PRO 22:14">ngʼatno manie bwo mirimb Jehova Nyasaye biro lingʼore e iye.<verse eid="PRO 22:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15"/>Fuwo otwere e chuny nyathi,</para>
  <para style="q2" vid="PRO 22:15">to ludh kum biro riembe mabor kode.<verse eid="PRO 22:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16"/>Ngʼat mathiro jochan mondo mwandune omedre</para>
  <para style="q2" vid="PRO 22:16">kod ngʼat machiwo mich ne jomoko biro bedo jochan.<verse eid="PRO 22:16"/></para>
  <para style="ms1">Weche piero adek mag jomariek</para>
  <para style="s2">Wach Mokwongo</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17"/>Chik iti kendo iwinj weche mag jomariek;</para>
  <para style="q2" vid="PRO 22:17">ket chunyi ne gima apuonjo,<verse eid="PRO 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18"/>nimar en mor ka ikanogi ei chunyi</para>
  <para style="q2" vid="PRO 22:18">kendo bed kodgi moikore e dhogi.<verse eid="PRO 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19"/>Mondo omi ibed gi geno kuom Jehova Nyasaye;</para>
  <para style="q2" vid="PRO 22:19">apuonji tinendeni, in bende.<verse eid="PRO 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20"/>Donge asendikoni weche mowachi piero adek,</para>
  <para style="q2" vid="PRO 22:20">weche mag puonj kod ngʼeyo,<verse eid="PRO 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21"/>mapuonjou adiera gi weche migeno,</para>
  <para style="q2" vid="PRO 22:21">mondo ichiw dwoko mowinjore ne ngʼat mane oori?<verse eid="PRO 22:21"/></para>
  <para style="s2">Wach mar ariyo</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22"/>Kik ima jachan nikech gin jochan</para>
  <para style="q2" vid="PRO 22:22">kendo kik ihiny joma ochando man-gi dwaro e kar bura,<verse eid="PRO 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23"/>nimar Jehova Nyasaye biro chwako buchgi,</para>
  <para style="q2" vid="PRO 22:23">kendo tieko ngima joma tieko ngimagi.<verse eid="PRO 22:23"/></para>
  <para style="s2">Wach mar adek</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24"/>Kik imak osiep gi ngʼat ma iye wangʼ piyo;</para>
  <para style="q2" vid="PRO 22:24">kik iriwri bende gi ngʼatno makecho piyo,<verse eid="PRO 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25"/>dipo nono ka ipuonjori yorene,</para>
  <para style="q2" vid="PRO 22:25">ma iwuon idonj e obadho.<verse eid="PRO 22:25"/></para>
  <para style="s2">Wach mar angʼwen</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26"/>Kik ibed ngʼatno matimo singruok</para>
  <para style="q2" vid="PRO 22:26">kata machungʼ ne ngʼato e gope;<verse eid="PRO 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27"/>ka ionge gi yo kaka dichul,</para>
  <para style="q2" vid="PRO 22:27">nono to wuon gowino nyalo kawo kitandani.<verse eid="PRO 22:27"/></para>
  <para style="s2">Wach mar abich</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28"/>Kik igol kidi mar kiewo machon</para>
  <para style="q2" vid="PRO 22:28">mane oket gi kweregi.<verse eid="PRO 22:28"/></para>
  <para style="s2">Wach mar auchiel</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29"/>Bende ineno ngʼat molony e tije?</para>
  <para style="q2" vid="PRO 22:29">Obiro tiyo ne ruodhi,</para>
  <para style="q2" vid="PRO 22:29">ok onyal tiyo ne ji ma ok ongʼere.<verse eid="PRO 22:29"/></para>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="s2">Wach mar abiriyo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1"/>Ka ibedo mondo ichiem gi ruoth,</para>
  <para style="q2" vid="PRO 23:1">non maber gima ni e nyimi,<verse eid="PRO 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2"/>ka in jawuoro to dimbri</para>
  <para style="q2" vid="PRO 23:2">nono to onyalo keto pala e dwondi.<verse eid="PRO 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3"/>Kik igomb chiembe mamit,</para>
  <para style="q2" vid="PRO 23:3">nimar chiemono en mar wuondruok.<verse eid="PRO 23:3"/></para>
  <para style="s2">Wach mar aboro</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4"/>Kik iwe tich bari ndasi ni mondo ibed ja-mwandu,</para>
  <para style="q2" vid="PRO 23:4">bed gi rieko mondo iritri.<verse eid="PRO 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5"/>Ngʼi mwandu mana matin nono, to bangʼe gidhi,</para>
  <para style="q2" vid="PRO 23:5">nimar adiera gibiro bedo gi bwombe,</para>
  <para style="q2" vid="PRO 23:5">kendo gifu gidhi e kor polo ka ongo.<verse eid="PRO 23:5"/></para>
  <para style="s2">Wach mar ochiko</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6"/>Kik icham chiemb jagwondo,</para>
  <para style="q2" vid="PRO 23:6">kik igomb chiembe mamit,<verse eid="PRO 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7"/>nimar en ngʼat</para>
  <para style="q2" vid="PRO 23:7">mosiko paro nengo mochul.</para>
  <para style="q1" vid="PRO 23:7">Owachoni niya, “Chiem kendo methi,”</para>
  <para style="q2" vid="PRO 23:7">to chunye ok ni kodi.<verse eid="PRO 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8"/>Ibiro ngʼogo mano matin mane ichamo</para>
  <para style="q2" vid="PRO 23:8">kendo ibiro bedo ni iketho kindeni kuom pwoch mipuoyego.<verse eid="PRO 23:8"/></para>
  <para style="s2">Wach mar apar</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9"/>Kik iwuo ne ngʼat mofuwo,</para>
  <para style="q2" vid="PRO 23:9">nikech obiro chayo rieko mag wechegi.<verse eid="PRO 23:9"/></para>
  <para style="s2">Wach mar apar gachiel</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10"/>Kik igol kidi mar kiewo machon,</para>
  <para style="q2" vid="PRO 23:10">kata ima nyithindo maonge wuone puothegi;<verse eid="PRO 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11"/>nimar Jal moritogi en ratego;</para>
  <para style="q2" vid="PRO 23:11">obiro chwakogi e kindi kodgi.<verse eid="PRO 23:11"/></para>
  <para style="s2">Wach mar apar gariyo</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12"/>Ket chunyi ne puonj</para>
  <para style="q2" vid="PRO 23:12">to iti ne weche mag ngʼeyo.<verse eid="PRO 23:12"/></para>
  <para style="s2">Wach mar apar gadek</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13"/>Kik itamri kumo nyathi;</para>
  <para style="q2" vid="PRO 23:13">nimar chwat ok nyal nege.<verse eid="PRO 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14"/>Kikumo nyathi kod kede</para>
  <para style="q2" vid="PRO 23:14">to obiro reso chunye aa e tho.<verse eid="PRO 23:14"/></para>
  <para style="s2">Wach mar apar gangʼwen</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15"/>Wuoda, ka chunyi riek,</para>
  <para style="q2" vid="PRO 23:15">eka chunya biro bedo mamor,<verse eid="PRO 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16"/>chunya ma iye nobed mamor</para>
  <para style="q2" vid="PRO 23:16">ka lewi wacho gima nikare.<verse eid="PRO 23:16"/></para>
  <para style="s2">Wach mar apar gabich</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17"/>Kik ibed gi nyiego e chunyi nikech joricho;</para>
  <para style="q2" vid="PRO 23:17">to kinde duto bedi gi dwaro mar luoro Jehova Nyasaye moloyo.<verse eid="PRO 23:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18"/>Adier, ka itimo kamano to inibed gi geno e ndalo mabiro,</para>
  <para style="q2" vid="PRO 23:18">kendo genoni ok nongʼad oko.<verse eid="PRO 23:18"/></para>
  <para style="s2">Wach mar apar gauchiel</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19"/>Wuoda, winja, eka inibed mariek,</para>
  <para style="q2" vid="PRO 23:19">kendo ket chunyi e yo moriere tir.<verse eid="PRO 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20"/>Kik iriwri gi jogo ma madho kongʼo mangʼeny</para>
  <para style="q2" vid="PRO 23:20">kata jowuoro mohero ringʼo,<verse eid="PRO 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21"/>nimar jomer kod jowuoro bedo jochan,</para>
  <para style="q2" vid="PRO 23:21">kendo nongʼno rwakogi gi lewni moti.<verse eid="PRO 23:21"/></para>
  <para style="s2">Wach mar apar gabiriyo</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22"/>Winj wuonu, nikech en ema nonywoli,</para>
  <para style="q2" vid="PRO 23:22">kendo kik icha minu ka oti.<verse eid="PRO 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23"/>Adiera gi rieko gi puonjruok kod ngʼeyo tiend wach ema nyaka iyudi,</para>
  <para style="q2" vid="PRO 23:23">kata dabed ni ingʼiewogi gi nengo matek.<verse eid="PRO 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24"/>Wuon ngʼat makare nigi mor maduongʼ;</para>
  <para style="q2" vid="PRO 23:24">ngʼatno man-gi wuowi mariek obedo mamor kode.<verse eid="PRO 23:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25"/>Mad wuonu gi minu bed mamor;</para>
  <para style="q2" vid="PRO 23:25">mad minu mane onywoli bed gi ilo.<verse eid="PRO 23:25"/></para>
  <para style="s2">Wach mar apar gaboro</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26"/>Wuoda, miya chunyi, kendo ket wengegi orit yorena,<verse eid="PRO 23:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27"/>nimar dhako ma jachode en bur matut,</para>
  <para style="q2" vid="PRO 23:27">to dhako mabayo en soko madiny.<verse eid="PRO 23:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28"/>Ka jamecho obuto korito,</para>
  <para style="q2" vid="PRO 23:28">to omedo keto ji ma ok jo-adiera mangʼeny e kind ji.<verse eid="PRO 23:28"/></para>
  <para style="s2">Wach mar apar gochiko</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29"/>En ngʼa man-gi masira?</para>
  <para style="q2" vid="PRO 23:29">En ngʼa man-gi lit?</para>
  <para style="q1" vid="PRO 23:29">En ngʼa man-gi lweny?</para>
  <para style="q2" vid="PRO 23:29">En ngʼa man-gi ngʼur?</para>
  <para style="q1" vid="PRO 23:29">En ngʼa man-gi adhonde</para>
  <para style="q2" vid="PRO 23:29">ma ok owinjore?</para>
  <para style="q1" vid="PRO 23:29">En ngʼa man-gi wangʼ makwar</para>
  <para style="q2" vid="PRO 23:29">motimo remo?<verse eid="PRO 23:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30"/>Jogo madeko oko ka kongʼo,</para>
  <para style="q2" vid="PRO 23:30">madhi mondo gibil kongʼo mokik mayoreyore.<verse eid="PRO 23:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31"/>Kik ingʼi kongʼo kochiek mowalo,</para>
  <para style="q2" vid="PRO 23:31">ka obabni e kikombe,</para>
  <para style="q2" vid="PRO 23:31">ka omadhore mos kolor piny!<verse eid="PRO 23:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32"/>Bangʼe to okecho ka thuol</para>
  <para style="q2" vid="PRO 23:32">kendo oketo kwiri kaka fu.<verse eid="PRO 23:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33"/>Wengeni biro neno gik mayoreyore</para>
  <para style="q2" vid="PRO 23:33">to pachi paro gik morundore.<verse eid="PRO 23:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34"/>Ibiro chalo ngʼat ma nindo e nam mar apaka matek,</para>
  <para style="q2" vid="PRO 23:34">ka inindo ewi apaka.<verse eid="PRO 23:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35"/>Ibiro wacho niya, “Gigoya, to ok ahinyra!</para>
  <para style="q2" vid="PRO 23:35">Gigoya, to ok awinji!</para>
  <para style="q1" vid="PRO 23:35">Karangʼo ma abiro chiewoe</para>
  <para style="q2" vid="PRO 23:35">mondo adog ameth kendo?”<verse eid="PRO 23:35"/></para>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="s2">Wach mar piero ariyo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1"/>Kik nyiego maki gi joricho</para>
  <para style="q2" vid="PRO 24:1">bende kik iyie chunyi gomb bedo e chokruok margi;<verse eid="PRO 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2"/>nimar chunjegi chano timo mamono</para>
  <para style="q2" vid="PRO 24:2">to dhogi wacho mana gik makelo chandruok.<verse eid="PRO 24:2"/></para>
  <para style="s2">Wach mar piero ariyo gachiel</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3"/>Rieko ema igerogo ot,</para>
  <para style="q2" vid="PRO 24:3">to kuom winjo ogurore mosiko;<verse eid="PRO 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4"/>kuom ngʼeyo, utene maiye ipongʼo gi gik moko</para>
  <para style="q2" vid="PRO 24:4">ma ok yudo yot kod mwandu mabeyo.<verse eid="PRO 24:4"/></para>
  <para style="s2">Wach mar piero ariyo gariyo</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5"/>Ngʼat mariek nigi teko maduongʼ;</para>
  <para style="q2" vid="PRO 24:5">to ngʼat man-gi ngʼeyo medo teko;<verse eid="PRO 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6"/>nimar dhiyo e lweny dwaro ni ongʼadni rieko,</para>
  <para style="q2" vid="PRO 24:6">to bedo gi loch dwaro jongʼad rieko mangʼeny.<verse eid="PRO 24:6"/></para>
  <para style="s2">Wach mar piero ariyo gadek</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7"/>Rieko bor moyombo ngʼat mofuwo;</para>
  <para style="q2" vid="PRO 24:7">e kar bura mar alap oonge gi gima onyalo wacho.<verse eid="PRO 24:7"/></para>
  <para style="s2">Wach mar piero ariyo gangʼwen</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8"/>Ngʼat machano gima rach</para>
  <para style="q2" vid="PRO 24:8">biro ngʼere kaka ja-andhoga.<verse eid="PRO 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9"/>Andhoga mar fuwo en richo,</para>
  <para style="q2" vid="PRO 24:9">to ji mon kod ja-jar ji.<verse eid="PRO 24:9"/></para>
  <para style="s2">Wach mar piero ariyo gabich</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10"/>Ka tekri orumo mipodho e kinde mar lweny,</para>
  <para style="q2" vid="PRO 24:10">to mano kaka tekri tin!<verse eid="PRO 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11"/>Res jogo mitero kar tho;</para>
  <para style="q2" vid="PRO 24:11">mak jogo mawuotho ka tangni dhiyo kar yengʼo.<verse eid="PRO 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12"/>Ka iwacho niya, “Ne ok wangʼeyo gimoro kuom wachni,”</para>
  <para style="q2" vid="PRO 24:12">donge ngʼatno mapimo chuny dhano ongʼeyo wachno?</para>
  <para style="q1" vid="PRO 24:12">Donge ngʼat morito kendo ngʼiyo ngimani ongʼeyogo?</para>
  <para style="q2" vid="PRO 24:12">To donge obiro chulo ngʼato ka ngʼato mowinjore gi timbene?<verse eid="PRO 24:12"/></para>
  <para style="s2">Wach mar piero ariyo gauchiel</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13"/>Wuoda, cham mor kich, nimar ober;</para>
  <para style="q2" vid="PRO 24:13">mor kich moa e pedni mar kich nigi ndhandhu mamit.<verse eid="PRO 24:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14"/>Ngʼe bende ne rieko mit ni chunyi;</para>
  <para style="q2" vid="PRO 24:14">ka iyude, nitie geno mar ndalo mabiro kuomi,</para>
  <para style="q2" vid="PRO 24:14">to genoni ok nongʼad oko.<verse eid="PRO 24:14"/></para>
  <para style="s2">Wach mar piero ariyo gabiriyo</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15"/>Kik ibut ka ngʼat marach mondo iketh od ngʼat makare,</para>
  <para style="q2" vid="PRO 24:15">kik iyak dalane,<verse eid="PRO 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16"/>kata bedni ngʼat makare ogore piny nyadibiriyo,</para>
  <para style="q2" vid="PRO 24:16">pod obiro chungo kendo;</para>
  <para style="q2" vid="PRO 24:16">to joricho igoyo piny gi masira.<verse eid="PRO 24:16"/></para>
  <para style="s2">Wach mar piero ariyo gaboro</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17"/>Kik ibed mamor gi masiche mag jasiki,</para>
  <para style="q2" vid="PRO 24:17">ka ochwanyore, kik iyie chunyi bed mamor;<verse eid="PRO 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18"/>nimar Jehova Nyasaye biro neno</para>
  <para style="q2" vid="PRO 24:18">kendo golo mirimbe oko kuome.<verse eid="PRO 24:18"/></para>
  <para style="s2">Wach mar piero ariyo gochiko</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19"/>Kik ibed maluor nikech joricho</para>
  <para style="q2" vid="PRO 24:19">kata kik nyiego maki kod joma timbegi richo,<verse eid="PRO 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20"/>nimar jaricho onge gi geno mar ndalo mabiro,</para>
  <para style="q2" vid="PRO 24:20">kendo taya mar ngʼat marach ibiro nego.<verse eid="PRO 24:20"/></para>
  <para style="s2">Wach mar piero adek</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21"/>Wuoda, luor Jehova Nyasaye kod ruoth morito piny,</para>
  <para style="q2" vid="PRO 24:21">kendo kik iriwri gi joma kwede,<verse eid="PRO 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22"/>nimar ji ariyogo biro kelonegi chandruok apoya nono,</para>
  <para style="q2" vid="PRO 24:22">to en ngʼa ma dingʼe ni en chandruok manade ma ginyalo kelo?<verse eid="PRO 24:22"/></para>
  <para style="ms1">Weche mamoko mag jomariek</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23"/>Magi bende gin weche mag jomariek:</para>
  <para style="q1" vid="PRO 24:23">Luoro wangʼ kuom ngʼado bura ok ber:<verse eid="PRO 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24"/>Ngʼatno mowachone jaketho niya, “In kare ionge ketho”</para>
  <para style="q2" vid="PRO 24:24">ji biro kwongʼe to piny kwede.<verse eid="PRO 24:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25"/>To nobed maber gi jogo makumo joma oketho,</para>
  <para style="q2" vid="PRO 24:25">kendo gweth mogundho nobed kodgi.<verse eid="PRO 24:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26"/>Dwoko maratiro</para>
  <para style="q2" vid="PRO 24:26">nyiso ni mano osiepni mar adier.<verse eid="PRO 24:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27"/>Tiek tijeni ma oko kendo ik puothegi;</para>
  <para style="q2" vid="PRO 24:27">bangʼ mano,</para>
  <para style="q2" vid="PRO 24:27">eka iger odi.<verse eid="PRO 24:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28"/>Kik ibed janeno e wach jabuti</para>
  <para style="q2" vid="PRO 24:28">kaonge gima omiyo, kata tiyo gi dhogi mondo iriambi.<verse eid="PRO 24:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29"/>Kik iwach niya, “Abiro timone mana kaka osetimona;</para>
  <para style="q2" vid="PRO 24:29">abiro chulo ngʼatno mana kaka notimona.”<verse eid="PRO 24:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30"/>Nakadho but puoth jasamuoyo,</para>
  <para style="q2" vid="PRO 24:30">kakadho but puoth olemb mzabibu mar ngʼat maonge gi rieko;<verse eid="PRO 24:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31"/>kudho notwi kuonde duto,</para>
  <para style="q2" vid="PRO 24:31">puodho duto noim gi buya,</para>
  <para style="q2" vid="PRO 24:31">to ohinga mar kidi nomukore.<verse eid="PRO 24:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32"/>Naketo chunya nono gino mane aneno</para>
  <para style="q2" vid="PRO 24:32">to napuonjora kuom gino mane aneno.<verse eid="PRO 24:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33"/>Nindo matin, ayula wangʼ matin,</para>
  <para style="q2" vid="PRO 24:33">kwakruok matin kiyweyo,<verse eid="PRO 24:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34"/>to dhier biro monji ka janjore</para>
  <para style="q2" vid="PRO 24:34">kendo chan ka jalweny momanore.<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="ms1">Ngeche mamoko mag Solomon</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1"/>Magi e ngeche mamoko mag Solomon, mane jo-Hezekia ruodh Juda ondiko.<verse eid="PRO 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2"/>Wamiyo Nyasaye duongʼ kuom gik ma opando;</para>
  <para style="q2" vid="PRO 25:2">to lero tiend weche en duongʼ ni ruodhi.<verse eid="PRO 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3"/>Mana kaka polo bor kendo piny tut,</para>
  <para style="q2" vid="PRO 25:3">e kaka chuny ruodhi ngʼeyo tek.<verse eid="PRO 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4"/>Ka ogol chilo kuom fedha,</para>
  <para style="q2" vid="PRO 25:4">to jatheth koro nigi gimoro mar theth;<verse eid="PRO 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5"/>ka ogol ngʼat marach e nyim ruoth,</para>
  <para style="q2" vid="PRO 25:5">eka kom ruodhe ibiro guro motegno e tim makare.<verse eid="PRO 25:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6"/>Kik imiri duongʼ iwuon e nyim ruoth,</para>
  <para style="q2" vid="PRO 25:6">kata bedo kar jomadongo,<verse eid="PRO 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7"/>nimar ber moloyo owachni niya, “Bi ka,”</para>
  <para style="q2" vid="PRO 25:7">moloyo ka igoli e nyim jomadongo.<verse eid="PRO 25:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8"/>Gima wangʼi oseneno kik ikel mapiyo kirikni e nyim od bura;</para>
  <para style="q2" vid="PRO 25:8">nimar ibiro timo angʼo achien ka jabuti oketi e wichkuot?<verse eid="PRO 25:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9"/>Ka iloso wach manie kindi gi jabuti,</para>
  <para style="q2" vid="PRO 25:9">to kik idhi ihul wach malingʼ-lingʼ mar ngʼato;<verse eid="PRO 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10"/>nono to ngʼat moro mowinji biro keti e wichkuot;</para>
  <para style="q2" vid="PRO 25:10">mi huma mari marach ok nogiki.<verse eid="PRO 25:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11"/>Wach mowach e kinde mowinjore,</para>
  <para style="q2" vid="PRO 25:11">chalo gi olemo mar dhahabu moketie tawo molos gi fedha.<verse eid="PRO 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12"/>Mana kaka tere mar dhahabu kata tigo mar dhahabu maber</para>
  <para style="q2" vid="PRO 25:12">e kaka siem mar ngʼat mariek mokwerogo ngʼat machiko ite.<verse eid="PRO 25:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13"/>Mana kaka ngʼich mar pe e kinde mar keyo,</para>
  <para style="q2" vid="PRO 25:13">e kaka jaote ma ja-adiera chalo ne ngʼat moore,</para>
  <para style="q2" vid="PRO 25:13">omoro chuny ruodhe.<verse eid="PRO 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14"/>Kaka boche polo gi yamo maonge koth,</para>
  <para style="q2" vid="PRO 25:14">e kaka ngʼat mawuorore gi mich ma ok dochiw.<verse eid="PRO 25:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15"/>Horuok mos nyalo loko chuny ruoth,</para>
  <para style="q2" vid="PRO 25:15">to lep mamuol nyalo toyo chogo.<verse eid="PRO 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16"/>Ka iyudo mor kich, to cham mana moromo,</para>
  <para style="q2" vid="PRO 25:16">mathoth ahinya, nyalo miyo ingʼogi.<verse eid="PRO 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17"/>Kik iter tiendi pile e od jabuti,</para>
  <para style="q2" vid="PRO 25:17">dhiyo kuno pile, biro miyo ochayi.<verse eid="PRO 25:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18"/>Mana kaka arungu kata ligangla; kata asere mabith,</para>
  <para style="q2" vid="PRO 25:18">e kaka ngʼatno machiwo neno ma ok adiera kuom ngʼat ma gidakgo machiegni.<verse eid="PRO 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19"/>Mana kaka lak marach kata tielo mongʼol</para>
  <para style="q2" vid="PRO 25:19">e kaka keto geno kuom jogo ma ok jo-adiera e kinde mag chandruok.<verse eid="PRO 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20"/>Mana ka ngʼat ma lonyo law midongʼ duk e ndalo ngʼich,</para>
  <para style="q2" vid="PRO 25:20">kata kaka olo chumbi e adhola,</para>
  <para style="q2" vid="PRO 25:20">e kaka ngʼat ma wero wende ne chuny mool.<verse eid="PRO 25:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21"/>Ka jasiki odenyo, to miye chiemo ocham;</para>
  <para style="q2" vid="PRO 25:21">ka riyo oloye, miye pi omodhi.<verse eid="PRO 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22"/>Ka itimo kamano, ibiro choko chuk mach maliel e wiye,</para>
  <para style="q2" vid="PRO 25:22">kendo Jehova Nyasaye biro miyi pok.<verse eid="PRO 25:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23"/>Kaka yamb nyandwat kelo koth,</para>
  <para style="q2" vid="PRO 25:23">e kaka lep mafuongʼo wach kelo miero.<verse eid="PRO 25:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24"/>Ber dak e kona mar wi ot</para>
  <para style="q2" vid="PRO 25:24">moloyo dak gi dhako maralep.<verse eid="PRO 25:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25"/>Mana kaka pi mangʼich chalo ne chuny mool,</para>
  <para style="q2" vid="PRO 25:25">e kaka wach maber moa e piny mabor chalo.<verse eid="PRO 25:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26"/>Mana kaka soko motimo chwodho kata aora moduwore chalo</para>
  <para style="q2" vid="PRO 25:26">e kaka ngʼat makare machiwo thuolo ne jaricho.<verse eid="PRO 25:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27"/>Ok ber chamo mor kich mathoth,</para>
  <para style="q2" vid="PRO 25:27">kata ok en gima longʼo mondo ngʼato odwar luor monego miye owuon.<verse eid="PRO 25:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28"/>Mana kaka dala maduongʼ ma ohingane omukore mogore piny</para>
  <para style="q2" vid="PRO 25:28">e kaka ngʼatno ma ok nyal ritore owuon.<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1"/>Mana kaka pe e ndalo oro kata koth e kinde keyo,</para>
  <para style="q2" vid="PRO 26:1">e kaka luor ok owinjore ni ngʼat mofuwo.<verse eid="PRO 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2"/>Mana kaka oyundi mafuyo kata ka opija maringo</para>
  <para style="q2" vid="PRO 26:2">e kaka kwongʼ maonge gimomiyo kadho akadha.<verse eid="PRO 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3"/>Kaka faras owinjore gi chwat,</para>
  <para style="q2" vid="PRO 26:3">to dho punda owinjore gi tweyo</para>
  <para style="q2" vid="PRO 26:3">e kaka ngʼe joma ofuwo owinjore gi goch.<verse eid="PRO 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4"/>Kik idwok ngʼat mofuwo machalre gi fupe,</para>
  <para style="q2" vid="PRO 26:4">to dipo ka ibiro bedo machal kode.<verse eid="PRO 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5"/>Dwok ngʼat mofuwo koluwore gi fupe,</para>
  <para style="q2" vid="PRO 26:5">dipo ka obiro nenore e wangʼe owuon ni oriek.<verse eid="PRO 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6"/>Mana kaka ingʼado tiend ngʼato kata kelo masira,</para>
  <para style="q2" vid="PRO 26:6">chalo gioro ngʼama ofuwo mondo oter ote.<verse eid="PRO 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7"/>Mana ka tiend ngʼat mongʼol mawengni,</para>
  <para style="q2" vid="PRO 26:7">e kaka ngero moa e dho ngʼat mofuwo.<verse eid="PRO 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8"/>Mana kaka keto kidi e orujre</para>
  <para style="q2" vid="PRO 26:8">e kaka miyo ngʼat mofuwo luor.<verse eid="PRO 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9"/>Mana kaka bungu mar kudho e lwet ngʼat momer,</para>
  <para style="q2" vid="PRO 26:9">e kaka ngero moa e dho ngʼat mofuwo.<verse eid="PRO 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10"/>Mana kaka ngʼama thoro diro aserni adira</para>
  <para style="q2" vid="PRO 26:10">ema chalo gi ngʼat mandiko ngʼat mofuwo kata ngʼato angʼata moyudo e tich.<verse eid="PRO 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11"/>Kaka guok dok e ngʼokne mosengʼogo</para>
  <para style="q2" vid="PRO 26:11">e kaka ngʼat mofuwo nwoyo fupe.<verse eid="PRO 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12"/>Bende ineno ngʼato ma paro owuon ni oriek?</para>
  <para style="q2" vid="PRO 26:12">Ngʼat mofuwo nitiere gi geno moloye.<verse eid="PRO 26:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13"/>Jasamuoyo wacho niya, “Sibuor ni e wangʼ yo,</para>
  <para style="q2" vid="PRO 26:13">sibuor mager bayo e yore mag dala!”<verse eid="PRO 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14"/>Mana kaka dhoot marundore e pata,</para>
  <para style="q2" vid="PRO 26:14">e kaka jasamuoyo lokore aloka e kitandane.<verse eid="PRO 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15"/>Jasamuoyo luto lwete malal ei tawo;</para>
  <para style="q2" vid="PRO 26:15">onyap ahinya ma ok onyal gole oko moduoge e dhoge.<verse eid="PRO 26:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16"/>Jasamuoyo paro e chunye ni oriek</para>
  <para style="q2" vid="PRO 26:16">moloyo ji abiriyo ma dwoko wach gi rieko.<verse eid="PRO 26:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17"/>Mana kaka ngʼat mamako guok gi ite,</para>
  <para style="q2" vid="PRO 26:17">e kaka ngʼat makadho akadha madonjo e dhawo ma ok mare.<verse eid="PRO 26:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18"/>Mana kaka ngʼat ma janeko madiro</para>
  <para style="q2" vid="PRO 26:18">pil mach kata aserni mager,<verse eid="PRO 26:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19"/>e kaka ngʼato mawuondo jabute</para>
  <para style="q2" vid="PRO 26:19">kowacho niya, “Ne angeri angera!”<verse eid="PRO 26:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20"/>Ka yien onge to mach tho;</para>
  <para style="q2" vid="PRO 26:20">ka kuoth onge dhawo rumo.<verse eid="PRO 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21"/>Kaka makaa miyo mach ngʼangʼni,</para>
  <para style="q2" vid="PRO 26:21">to yien bende miyo mach liel,</para>
  <para style="q2" vid="PRO 26:21">e kaka ngʼat makwiny kelo miero.<verse eid="PRO 26:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22"/>Weche mag kuoth chalo gi chiemo mamit;</para>
  <para style="q2" vid="PRO 26:22">gidhiyo e chuny dhano ma iye.<verse eid="PRO 26:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23"/>Mana kaka range mangʼangʼni mowir e agulu mochwe chalo</para>
  <para style="q2" vid="PRO 26:23">e kaka lep mager mar chuny mopongʼ gi richo.<verse eid="PRO 26:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24"/>Jasigu wuondore koumore kod dhoge,</para>
  <para style="q2" vid="PRO 26:24">to ei chunye okano miriambo.<verse eid="PRO 26:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25"/>Kata bed ni wechene lombo chuny, kik iyie kode,</para>
  <para style="q2" vid="PRO 26:25">nimar gik maricho abiriyo opongʼo chunye.<verse eid="PRO 26:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26"/>Onyalo wuondore ni oonge wuond,</para>
  <para style="q2" vid="PRO 26:26">to timbene maricho biro nenore ratiro e nyim oganda.<verse eid="PRO 26:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27"/>Ka ngʼato okunyo bur, obiro lutore e iye;</para>
  <para style="q2" vid="PRO 26:27">to ka ngʼato ngʼielo kidi,</para>
  <para style="q2" vid="PRO 26:27">to kidino biro ngʼielore kaduogo ire.<verse eid="PRO 26:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28"/>Lep mariambo mon kod jogo mohinyo,</para>
  <para style="q2" vid="PRO 26:28">to dhok mawuondo ji kelo kethruok.<verse eid="PRO 26:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1"/>Kik isungri kuom kiny,</para>
  <para style="q2" vid="PRO 27:1">nikech ok ingʼeyo gima odiechiengʼ nyalo kelo.<verse eid="PRO 27:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2"/>We ngʼat moro ema opaki,</para>
  <para style="q2" vid="PRO 27:2">to ok dhogi iwuon; ngʼato machielo, to ok lewi iwuon.<verse eid="PRO 27:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3"/>Kidi pek to kuoyo bende pek,</para>
  <para style="q2" vid="PRO 27:3">to chandruok ma ngʼat mofuwo kelo pek moloyo gik moko ariyogo.<verse eid="PRO 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4"/>Mirima kwiny to gero pek moloyo,</para>
  <para style="q2" vid="PRO 27:4">to en ngʼa manyalo chomore gi nyiego?<verse eid="PRO 27:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5"/>Kwero ngʼato ratiro ber</para>
  <para style="q2" vid="PRO 27:5">moloyo hera mopandi.<verse eid="PRO 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6"/>Adhonde moa kuom osiep inyalo geno,</para>
  <para style="q2" vid="PRO 27:6">to jasigu medo mana nyoth mar masira.<verse eid="PRO 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7"/>Ngʼat moyiengʼ ok dwar mor kich,</para>
  <para style="q2" vid="PRO 27:7">to ngʼatno modenyo kata mana gima kech mitne.<verse eid="PRO 27:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8"/>Mana kaka winyo mabayo moa e ode</para>
  <para style="q2" vid="PRO 27:8">e kaka ngʼatno mabayo aa e dalane.<verse eid="PRO 27:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9"/>Moo mangʼwe ngʼar gi ubani kelo mor ne chuny,</para>
  <para style="q2" vid="PRO 27:9">to ber mar osiep ngʼato wuok kuom ngʼado rieko gi adiera.<verse eid="PRO 27:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10"/>Kik ijwangʼ osiepni kod osiep wuonu,</para>
  <para style="q2" vid="PRO 27:10">to kik idhi e od owadu ka chandruok omaki,</para>
  <para style="q2" vid="PRO 27:10">ber dhi ir jabuti machiegni moloyo owadu man mabor.<verse eid="PRO 27:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11"/>Bed mariek, wuoda kendo imi chunya mor</para>
  <para style="q2" vid="PRO 27:11">eka anyalo dwoko ngʼato moro amora machaya.<verse eid="PRO 27:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12"/>Ngʼat mariek neno masira kabiro kendo opondo,</para>
  <para style="q2" vid="PRO 27:12">to ngʼat mofuwo dhiyo adhiya nyime ma ohinyre.<verse eid="PRO 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13"/>Kaw law ngʼatno mochungʼne ngʼat mokia kaka singo;</para>
  <para style="q2" vid="PRO 27:13">kawe ka okete singo kar dhako mabayo.<verse eid="PRO 27:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14"/>Ka ngʼato ogwedho jabute e lela gokinyi mangʼich,</para>
  <para style="q2" vid="PRO 27:14">to ochalo mana gi ngʼama kwongʼe.<verse eid="PRO 27:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15"/>Dhako ma jakoko</para>
  <para style="q2" vid="PRO 27:15">chalo gi kodh ajiki,<verse eid="PRO 27:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16"/>kwerogo chalo gi gengʼo yamo</para>
  <para style="q2" vid="PRO 27:16">kata mako moo gi lwedo.<verse eid="PRO 27:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17"/>Kaka nyinyo piago nyinyo,</para>
  <para style="q2" vid="PRO 27:17">e kaka ngʼato piago nyawadgi.<verse eid="PRO 27:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18"/>Ngʼat mopidho ngʼowu biro chamo olembe,</para>
  <para style="q2" vid="PRO 27:18">to ngʼatno marito ruodhe ibiro miyo luor.<verse eid="PRO 27:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19"/>Kirango pi, to wangʼi iwuon ema ineno,</para>
  <para style="q2" vid="PRO 27:19">kendo kinono chunyi, to in iwuon ema inenori.<verse eid="PRO 27:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20"/>Tho kod kethruok ok rom ngangʼ,</para>
  <para style="q2" vid="PRO 27:20">to kata mana wenge dhano bende ok rom.<verse eid="PRO 27:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21"/>Dhahabu gi fedha itemo gi mach,</para>
  <para style="q2" vid="PRO 27:21">to dhano itemo gi pak moyudo.<verse eid="PRO 27:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22"/>Kata bed ni iyoko ngʼat mofuwo e pany,</para>
  <para style="q2" vid="PRO 27:22">iyoke kaka cham miswago,</para>
  <para style="q2" vid="PRO 27:22">ok inigol fupe oa kuome.<verse eid="PRO 27:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23"/>Bed ni ingʼeyo maber kaka jambi chalo;</para>
  <para style="q2" vid="PRO 27:23">bende rit maber kwethgi;<verse eid="PRO 27:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24"/>nimar mwandu ok sik mochwere,</para>
  <para style="q2" vid="PRO 27:24">to osimbo mar loch ok nobed ne tiengʼ ka tiengʼ.<verse eid="PRO 27:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25"/>Ka ongʼad lum oko eka manyien twi,</para>
  <para style="q2" vid="PRO 27:25">to ka ichoko ne jambi lum manie kor got,<verse eid="PRO 27:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26"/>eka iniyud yie rombe milosgo lewni,</para>
  <para style="q2" vid="PRO 27:26">kendo iningʼiew lowo gi pesa miyudo kuom diek.<verse eid="PRO 27:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27"/>Ibiro bedo gi chak mangʼeny mar diek</para>
  <para style="q2" vid="PRO 27:27">ma ibiro pidhorigo gi joodi kendo pidho nyiri matiyoni.<verse eid="PRO 27:27"/></para>
  <para style="b"/>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1"/>Jaricho ringo kaonge ngʼama lawe,</para>
  <para style="q2" vid="PRO 28:1">to joma kare jochir ka sibuor.<verse eid="PRO 28:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2"/>Ka piny toke tek, to en gi jotelo mangʼeny,</para>
  <para style="q2" vid="PRO 28:2">to ngʼat mawinjo wach kendo man-gi ngʼeyo rito chik.<verse eid="PRO 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3"/>Jatelo mahinyo jochan</para>
  <para style="q2" vid="PRO 28:3">chalo kaka kodh oula maywero cham oko.<verse eid="PRO 28:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4"/>Jogo ma ok rit chik pako ngʼat marach,</para>
  <para style="q2" vid="PRO 28:4">to jogo marito chik dagi jogo maricho.<verse eid="PRO 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5"/>Jomaricho ok ongʼeyo adiera,</para>
  <para style="q2" vid="PRO 28:5">to jogo madwaro Jehova Nyasaye ongʼeyo adiera chutho.<verse eid="PRO 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6"/>Ber ngʼat ma jachan ma wuodhe ok cha,</para>
  <para style="q2" vid="PRO 28:6">moloyo ngʼat ma ja-mwandu ma yorene richo.<verse eid="PRO 28:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7"/>Ngʼat marito chik en wuowi mariek,</para>
  <para style="q2" vid="PRO 28:7">to bedo osiep jawuoro kelo wichkuot ne wuon mare.<verse eid="PRO 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8"/>Ngʼat mamedo mwandu gi ohala ma malangʼ choko mwandu ne ngʼat machielo,</para>
  <para style="q2" vid="PRO 28:8">mabiro bedo mangʼwon gi jochan.<verse eid="PRO 28:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9"/>Ka ngʼato odino ite ne chik,</para>
  <para style="q2" vid="PRO 28:9">kata mana lemone bende richo.<verse eid="PRO 28:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10"/>Ngʼat matero ngʼat moriere tir e yo mar richo</para>
  <para style="q2" vid="PRO 28:10">biro podho e obetone owuon,</para>
  <para style="q2" vid="PRO 28:10">to ngʼat ma ok cha biro yudo pok maber.<verse eid="PRO 28:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11"/>Jamoko nyalo paro owuon ni oriek,</para>
  <para style="q2" vid="PRO 28:11">to jachan man-gi paro matut neno gik manie chuny jamokono.<verse eid="PRO 28:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12"/>Ka ngʼat makare oloyo, nitie mor maduongʼ,</para>
  <para style="q2" vid="PRO 28:12">to ka ngʼat marach omi teko mondo otel,</para>
  <para style="q2" vid="PRO 28:12">ji ringo dhiyo kar pondo.<verse eid="PRO 28:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13"/>Ngʼat mapando richone ok dhi maber,</para>
  <para style="q2" vid="PRO 28:13">to ngʼat ma hulo richone kendo oweyogi yudo ngʼwono.<verse eid="PRO 28:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14"/>En ngʼama ogwedhi ngʼat moluoro Jehova Nyasaye kinde duto,</para>
  <para style="q2" vid="PRO 28:14">to ngʼatno ma chunye tek donjo e chandruok.<verse eid="PRO 28:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15"/>Kaka sibuor maruto kata ondiek madwaro kecho</para>
  <para style="q2" vid="PRO 28:15">e kaka ngʼat marach motelone joma ok nyal.<verse eid="PRO 28:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16"/>Ruoth ma jasunga onge gi rieko,</para>
  <para style="q2" vid="PRO 28:16">to ngʼatno mamon gi gik moyud e yo marach biro dak amingʼa.<verse eid="PRO 28:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17"/>Ngʼat moneko chunye chandore</para>
  <para style="q2" vid="PRO 28:17">enobed gi kuyo nyaka otho;</para>
  <para style="q2" vid="PRO 28:17">omiyo kik ngʼato konye.<verse eid="PRO 28:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18"/>Ngʼatno ma ja-adiera ibiro rito maonge hinyruok,</para>
  <para style="q2" vid="PRO 28:18">to ngʼatno ma yorene richo biro podho apoya nono.<verse eid="PRO 28:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19"/>Ngʼat matiyo e puothe biro bedo gi chiemo mogundho,</para>
  <para style="q2" vid="PRO 28:19">to ngʼat mabayo abaya biro bedo jachan mochwere.<verse eid="PRO 28:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20"/>Ngʼat ma ja-adiera ibiro gwedho mangʼeny,</para>
  <para style="q2" vid="PRO 28:20">to ngʼat madwaro gi teko bedo ja-mwandu ok notony ma ok okume.<verse eid="PRO 28:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21"/>Dok ne ngʼato kayiem ka oketho ok ber,</para>
  <para style="q2" vid="PRO 28:21">to ngʼato biro timo marach mana ni mondo oyud asoya matin.<verse eid="PRO 28:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22"/>Ngʼat ma iye lit dwaro ahinya ni mondo obed gi mwandu</para>
  <para style="q2" vid="PRO 28:22">to ok ongʼeyo ni chan orite.<verse eid="PRO 28:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23"/>Ngʼatno makwero ngʼato gikone obiro yudo pwoch mangʼeny</para>
  <para style="q2" vid="PRO 28:23">moloyo ngʼatno man-gi lep mawuondo.<verse eid="PRO 28:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24"/>Ngʼat mamayo wuon mare kata min,</para>
  <para style="q2" vid="PRO 28:24">to owacho niya, “Timo kamano ok rach,”</para>
  <para style="q2" vid="PRO 28:24">ochal gi ngʼat maketho gimoro.<verse eid="PRO 28:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25"/>Ngʼat ma jawuoro thoro kelo miero,</para>
  <para style="q2" vid="PRO 28:25">to ngʼat mogeno kuom Jehova Nyasaye biro dhiyo maber.<verse eid="PRO 28:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26"/>Ngʼat moketo genone kuome owuon ofuwo,</para>
  <para style="q2" vid="PRO 28:26">to ngʼatno mawuotho e rieko, oritore maonge hinyruok.<verse eid="PRO 28:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27"/>Ngʼat mamiyo jochan ok nochand gimoro,</para>
  <para style="q2" vid="PRO 28:27">to ngʼat ma gengʼo wangʼe ne jochan noyud kwongʼ mangʼeny.<verse eid="PRO 28:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28"/>Ka jaricho oketi e teko mondo otel, ji dhiyo kar pondo;</para>
  <para style="q2" vid="PRO 28:28">to ka jaricho otho joma kare dhiyo nyime.<verse eid="PRO 28:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1"/>Ngʼat masiko katoke tek bangʼ siem mangʼeny</para>
  <para style="q2" vid="PRO 29:1">ibiro tieko apoya nono maonge konyruok.<verse eid="PRO 29:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2"/>Ka joma kare dhiyo nyime, ji mor,</para>
  <para style="q2" vid="PRO 29:2">ka joricho ema otelo e loch ji ywak ka gichur.<verse eid="PRO 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3"/>Ngʼat mohero rieko miyo wuon mare mor,</para>
  <para style="q2" vid="PRO 29:3">to ngʼat momako osiep kod jachode ketho mwandune.<verse eid="PRO 29:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4"/>Gi adiera ema ruoth miyo piny bet mochungʼ motegno,</para>
  <para style="q2" vid="PRO 29:4">to ngʼat mawuor ne asoya muke magoye piny.<verse eid="PRO 29:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5"/>Ngʼat mawuondo jabute</para>
  <para style="q2" vid="PRO 29:5">ochiko obadho e tiende.<verse eid="PRO 29:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6"/>Ngʼat marach dwodore e obadho mar richone owuon,</para>
  <para style="q2" vid="PRO 29:6">to ngʼat makare nyalo wer mobed mamor.<verse eid="PRO 29:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7"/>Ngʼat makare winjo ywak jochan mondo otimnegi gima kare,</para>
  <para style="q2" vid="PRO 29:7">to ngʼat marach ok dew gimoro.<verse eid="PRO 29:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8"/>Joma jaro ji kelo koko e dala,</para>
  <para style="q2" vid="PRO 29:8">to jomariek ringo aa e mirima.<verse eid="PRO 29:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9"/>Ka ngʼat mariek odhiyo gi ngʼat mofuwo e od bura,</para>
  <para style="q2" vid="PRO 29:9">to ngʼat mofuwo goyo koko kendo jero,</para>
  <para style="q2" vid="PRO 29:9">kendo kwe bedo maonge.<verse eid="PRO 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10"/>Joma ohero chwero remo mon kod jogo modimbore,</para>
  <para style="q2" vid="PRO 29:10">kendo gidwaro yo mar nego joma jo-ratiro.<verse eid="PRO 29:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11"/>Ngʼat mofuwo chiwore duto komwomore amwoma e mirimbe,</para>
  <para style="q2" vid="PRO 29:11">to ngʼat mariek ritore ka ogare.<verse eid="PRO 29:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12"/>Ka ruoth thoro chiko ite ne miriambo,</para>
  <para style="q2" vid="PRO 29:12">to jootene duto bedo joma timbegi richo.<verse eid="PRO 29:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13"/>Jachan gi ngʼat mahinyo ji nigi gimoro achiel machalre:</para>
  <para style="q2" vid="PRO 29:13">Jehova Nyasaye miyogi wenge maneno kargi ji ariyogo.<verse eid="PRO 29:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14"/>Ka ruoth ongʼado bura ne jochan kod adiera,</para>
  <para style="q2" vid="PRO 29:14">kom ruodhe biro bedo moritore ma ok hinyre.<verse eid="PRO 29:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15"/>Ka ichwado nyathi kendo ikwere eka ikonye bedo mariek</para>
  <para style="q2" vid="PRO 29:15">to nyathi ma owe aweya kelo wichkuot ne min mare.<verse eid="PRO 29:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16"/>Ka jaricho dhiyo nyime maber, e kaka richo bende medore,</para>
  <para style="q2" vid="PRO 29:16">to joma kare biro neno podho margi.<verse eid="PRO 29:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17"/>Kum wuodi, to obiro miyi kwe;</para>
  <para style="q2" vid="PRO 29:17">kendo obiro kelo mor ne chunyi.<verse eid="PRO 29:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18"/>Kama onge lek, to ji chunygi aa</para>
  <para style="q2" vid="PRO 29:18">to ngʼama orito chik en ngʼat mogwedhi.<verse eid="PRO 29:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19"/>Misumba ok nyal kony kirieye mana gi wach kende;</para>
  <para style="q2" vid="PRO 29:19">kata bed ni owinjo, to ok obi rwako.<verse eid="PRO 29:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20"/>Bende ineno ngʼato ma wuoyo ka rikni mapiyo piyo?</para>
  <para style="q2" vid="PRO 29:20">Nitie geno mathoth kuom ngʼat mofuwo maloye.<verse eid="PRO 29:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21"/>Ka ngʼato omiyo misumbane gik moko duto chakre ka en rawera,</para>
  <para style="q2" vid="PRO 29:21">obiro kelo kuyo e gikone.<verse eid="PRO 29:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22"/>Ngʼat ma iye owangʼ kelo masira,</para>
  <para style="q2" vid="PRO 29:22">to ngʼat makecho piyo timo richo mathoth.<verse eid="PRO 29:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23"/>Sunga ngʼato ema miyo opodho,</para>
  <para style="q2" vid="PRO 29:23">to ngʼat ma chunye muol yudo pak.<verse eid="PRO 29:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24"/>Ngʼat makonyo jakuo mondo okwal ema bedo jasike owuon;</para>
  <para style="q2" vid="PRO 29:24">nikech osekwongʼore kendo ok onyal bedo janeno.<verse eid="PRO 29:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25"/>Luoro mar dhano biro nyisore ni en gima duodo ngʼato,</para>
  <para style="q2" vid="PRO 29:25">to ngʼat mogeno kuom Jehova Nyasaye orite maonge hinyruok.<verse eid="PRO 29:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26"/>Ji mangʼeny dwaro mondo girom gi ruoth,</para>
  <para style="q2" vid="PRO 29:26">to en mana kuom Jehova Nyasaye ema adiera yudoree.<verse eid="PRO 29:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27"/>Joma kare mon gi joma ok jo-adiera,</para>
  <para style="q2" vid="PRO 29:27">to joricho mon gi joma oriere tir.<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="ms1">Weche mag Agur</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1"/>Magi e weche mag Agur wuod Jake, ma gin weche matut.</para>
  <para style="q1" vid="PRO 30:1">Magi e weche ma Agur wachone Ithiel;</para>
  <para style="q2" vid="PRO 30:1">adier owuoyo ne Ithiel niya,</para>
  <para style="b" vid="PRO 30:1"/>
  <para style="q1" vid="PRO 30:1">“Aol marumo, yaye Nyasaye,</para>
  <para style="q2" vid="PRO 30:1">to pod anyalo wuoyo.<verse eid="PRO 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2"/>Chutho afuwo ahinya ma ok awinjora bedo dhano;</para>
  <para style="q2" vid="PRO 30:2">ok an kod ngʼeyo tiend wach mar dhano.<verse eid="PRO 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3"/>Ok asepuonjora rieko,</para>
  <para style="q2" vid="PRO 30:3">kata ngʼeyo mar Nyasaye, ma en Jal Maler Moloyo, bende aongego.<verse eid="PRO 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4"/>En ngʼa mosedhi e polo kendo olor piny?</para>
  <para style="q2" vid="PRO 30:4">En ngʼa mosechoko yamo moketo ei lwete?</para>
  <para style="q1" vid="PRO 30:4">En ngʼa mosechoko pi gi lawe</para>
  <para style="q2" vid="PRO 30:4">kata mosepimo giko mar tungʼ piny?</para>
  <para style="q1" vid="PRO 30:4">Nyinge to en ngʼa, koso wuode to nyinge ngʼa?</para>
  <para style="q2" vid="PRO 30:4">Nyisa ane ka ingʼeyo!<verse eid="PRO 30:4"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5"/>“Wach ka wach moa kuom Nyasaye en adier;</para>
  <para style="q2" vid="PRO 30:5">Nyasaye en okumba ne jogo mopondo kuome.<verse eid="PRO 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6"/>Kik imed gimoro e wachne,</para>
  <para style="q2" vid="PRO 30:6">to nono obiro kwedi mi onyis ni in ja-miriambo.<verse eid="PRO 30:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7"/>“Gik moko ariyo makwayi; yaye Jehova Nyasaye;</para>
  <para style="q2" vid="PRO 30:7">kik itama biro buti kapok atho.<verse eid="PRO 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8"/>Mi wuond gi miriambo obed mabor koda;</para>
  <para style="q2" vid="PRO 30:8">kik imiya chan kata mwandu,</para>
  <para style="q2" vid="PRO 30:8">to miya mana chiemba mapile.<verse eid="PRO 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9"/>Nimar, ka ok kamano, to anyalo bedo gi mwandu mangʼeny mi akwedi</para>
  <para style="q2" vid="PRO 30:9">ka awacho ni, ‘Jehova Nyasaye to en ngʼa?’</para>
  <para style="q1" vid="PRO 30:9">Kata anyalo bedo jachan mi akwel,</para>
  <para style="q2" vid="PRO 30:9">mi ami nying Nyasacha wichkuot.<verse eid="PRO 30:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10"/>“Kik iwuo marach kuom jatich ne ngʼat mondike</para>
  <para style="q2" vid="PRO 30:10">nono to obiro kwongʼi, mi iyud chandruok.<verse eid="PRO 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11"/>“Nitie jogo makwongʼo wuonegi</para>
  <para style="q2" vid="PRO 30:11">kendo ok gwedh minegi;<verse eid="PRO 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12"/>jogo ma paro giwegi ni giler</para>
  <para style="q2" vid="PRO 30:12">to ok osepwodhgi kuom kethruokgi;<verse eid="PRO 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13"/>jogo ma wangʼ-gi tek masungore,</para>
  <para style="q2" vid="PRO 30:13">manenogi richo;<verse eid="PRO 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14"/>joma lekegi chalo gi ligangla</para>
  <para style="q2" vid="PRO 30:14">kendo nyipongʼ lekegi chalo pelni mabitho,</para>
  <para style="q1" vid="PRO 30:14">mar chamo jochan manie piny,</para>
  <para style="q2" vid="PRO 30:14">kod joma odhier manie dier ji.<verse eid="PRO 30:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15"/>“Chwe nigi nyiri ariyo.</para>
  <para style="q2" vid="PRO 30:15">Giywak ni, ‘Miwa! Miwa!’</para>
  <para style="b" vid="PRO 30:15"/>
  <para style="li1" vid="PRO 30:15">“Nitie gik moko adek ma ok rom ngangʼ!</para>
  <para style="li2" vid="PRO 30:15">Angʼwen ma ok wach ni, ‘Oromo!’<verse eid="PRO 30:15"/></para>
  <para style="li3">
    <verse number="16" style="v" sid="PRO 30:16"/>Gin liel,</para>
  <para style="li3" vid="PRO 30:16">ich ma ok onywol,</para>
  <para style="li3" vid="PRO 30:16">lowo ma pi ok rom,</para>
  <para style="li3" vid="PRO 30:16">kata mach ma ok wach ni, ‘Oromo!’<verse eid="PRO 30:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17"/>“Wangʼ ma jaro wuoro,</para>
  <para style="q2" vid="PRO 30:17">ma dagi winjo wach miyo,</para>
  <para style="q1" vid="PRO 30:17">ibiro lodho oko kod agak manie holo,</para>
  <para style="q2" vid="PRO 30:17">ibiro chamgi gi achudhe.<verse eid="PRO 30:17"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="18" style="v" sid="PRO 30:18"/>“Nitie gik moko adek mamiya awuoro ahinya,</para>
  <para style="li2" vid="PRO 30:18">angʼwen ma ok anyal ngʼeyo tiendgi.<verse eid="PRO 30:18"/></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 30:19"/>Yor ongo e kor polo,</para>
  <para style="li3" vid="PRO 30:19">yor thuol e kor lwanda,</para>
  <para style="li3" vid="PRO 30:19">yor yie ei nam mogingore</para>
  <para style="li3" vid="PRO 30:19">kod yor ngʼama wuowi gi nyako.<verse eid="PRO 30:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20"/>“Ma e yor dhako ma jachode:</para>
  <para style="q2" vid="PRO 30:20">Ochiemo to bangʼe oyweyo dhoge,</para>
  <para style="q2" vid="PRO 30:20">mi owach ni, ‘Ok asetimo gimoro marach.’<verse eid="PRO 30:20"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="21" style="v" sid="PRO 30:21"/>“Nitie gik moko adek mateto piny,</para>
  <para style="li2" vid="PRO 30:21">to kuom gik moko angʼwen piny ok nyal yiego:<verse eid="PRO 30:21"/></para>
  <para style="li3">
    <verse number="22" style="v" sid="PRO 30:22"/>misumba modoko ruodh piny,</para>
  <para style="li3" vid="PRO 30:22">kata ngʼat mofuwo mochiemo moyiengʼ,<verse eid="PRO 30:22"/></para>
  <para style="li3">
    <verse number="23" style="v" sid="PRO 30:23"/>moro en dhako ma ok oher to okende</para>
  <para style="li3" vid="PRO 30:23">eka mogik jatich ma nyako ma omayo dhako mondike dichwo.<verse eid="PRO 30:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="PRO 30:24"/>“Gik moko angʼwen matindo ni e piny,</para>
  <para style="li2" vid="PRO 30:24">to kata kamano giriek moloyo.<verse eid="PRO 30:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="PRO 30:25"/>Biye gin chwech ma tekregi tin,</para>
  <para style="li3" vid="PRO 30:25">to kata kamano gikano chiembgi e ndalo oro;<verse eid="PRO 30:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="PRO 30:26"/>aidha bende gin le man-gi teko matin,</para>
  <para style="li3" vid="PRO 30:26">to giloso gondgi e kind kite,<verse eid="PRO 30:26"/></para>
  <para style="li2">
    <verse number="27" style="v" sid="PRO 30:27"/>kata bonyo onge ruodhgi,</para>
  <para style="li3" vid="PRO 30:27">to ka giringo gidhiyo nyime kaachiel ka gichanore ka ogend lweny.<verse eid="PRO 30:27"/></para>
  <para style="li2">
    <verse number="28" style="v" sid="PRO 30:28"/>Kamano olele bende inyalo mako gi lwedo,</para>
  <para style="li3" vid="PRO 30:28">to iyude kodak e ute ruoth.<verse eid="PRO 30:28"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="29" style="v" sid="PRO 30:29"/>“Nitie gik moko adek ma wuodhgi lich ka irango,</para>
  <para style="li2" vid="PRO 30:29">chutho angʼwen maringo malich miwuoro.<verse eid="PRO 30:29"/></para>
  <para style="li3">
    <verse number="30" style="v" sid="PRO 30:30"/>Sibuor, en ratego moloyo kuom le duto, kendo onge gimoro moluoro,<verse eid="PRO 30:30"/></para>
  <para style="li3">
    <verse number="31" style="v" sid="PRO 30:31"/>thuon gweno magar ka dwaro gwere</para>
  <para style="li3" vid="PRO 30:31">gi wadgi, nywok,</para>
  <para style="li3" vid="PRO 30:31">kod ruoth gi oganda mar lweny moluoro bute.<verse eid="PRO 30:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32"/>“Ka isetimo tim fuwo ma imiyori duongʼ kendi,</para>
  <para style="q2" vid="PRO 30:32">kata ka isechano richo,</para>
  <para style="q2" vid="PRO 30:32">to um dhogi gi lweti!<verse eid="PRO 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33"/>Mana kaka puoyo chak kelo mo,</para>
  <para style="q2" vid="PRO 30:33">kendo goyo um chwero remo,</para>
  <para style="q2" vid="PRO 30:33">e kaka jiwo kecho kelo lweny.”<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="ms1">Weche mag Ruoth Lemuel</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1"/>Weche mag Ruoth Lemuel, ma gin weche matut ma min mare nopuonje.<verse eid="PRO 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2"/>Yaye wuoda, yaye wuoda mane anywolo!</para>
  <para style="q2" vid="PRO 31:2">Winja, in wuoda mane anywolo</para>
  <para style="q2" vid="PRO 31:2">bangʼ ka Nyasaye osewinjo lemo mane atimonego singruok.<verse eid="PRO 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3"/>Kik iket tekri kuom mon,</para>
  <para style="q2" vid="PRO 31:3">kata nyalo mari kuom jogo maketho ruodhi.<verse eid="PRO 31:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4"/>Ok en gima owinjore ne ruodhi, yaye Lemuel,</para>
  <para style="q2" vid="PRO 31:4">mondo ruodhi omadh math makech,</para>
  <para style="q2" vid="PRO 31:4">kata jotelo ogomb kongʼo gi chunygi duto,<verse eid="PRO 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5"/>nono ka gimetho to wigi diwil gi gima chik ochiko,</para>
  <para style="q2" vid="PRO 31:5">ma gihiny joma ok nyal ka gitamogi e ratichgi.<verse eid="PRO 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6"/>Chiw kongʼo ne jogo ma chunygi ool,</para>
  <para style="q2" vid="PRO 31:6">to math makech ne jogo ma chunygi lit.<verse eid="PRO 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7"/>Wegi mondo gimethi mondo wigi owil gi chan-gi</para>
  <para style="q2" vid="PRO 31:7">kendo kik gichak gipar chandruokgi kendo.<verse eid="PRO 31:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8"/>Wuo ka ichwako joma ok nyal wacho wachgi gin giwegi,</para>
  <para style="q2" vid="PRO 31:8">ka ichwako jogo maonge nyalo.<verse eid="PRO 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9"/>Wuo kendo ngʼad bura kare,</para>
  <para style="q2" vid="PRO 31:9">chwak ratich jogo ma jochan kod jogo mochando.<verse eid="PRO 31:9"/></para>
  <para style="ms1">Weche Mogik: Dhako ma kite longʼo</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10"/>Dhako ma kite longʼo en ngʼa manyalo nwangʼo?</para>
  <para style="q2" vid="PRO 31:10">Nengone oloyo kite ma nengogi tek.<verse eid="PRO 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11"/>Chwore ogenogo chutho</para>
  <para style="q2" vid="PRO 31:11">kendo onge gima oreme.<verse eid="PRO 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12"/>Okelone mana ber,</para>
  <para style="q2" vid="PRO 31:12">ok hinyruok ndalo duto mar ngimane.<verse eid="PRO 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13"/>Oyiero yie rombe kod tworo</para>
  <para style="q2" vid="PRO 31:13">kendo otiyo matek gi lwete.<verse eid="PRO 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14"/>Ochalo gi yiedhi mag ohala,</para>
  <para style="q2" vid="PRO 31:14">kokelo chiemo moa kuma bor.<verse eid="PRO 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15"/>Ochiewo aa e nindo ka pod piny mudho,</para>
  <para style="q2" vid="PRO 31:15">ochiwo chiemo ne joode to moko omiyo nyiri matiyone.<verse eid="PRO 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16"/>Omanyo puodho maber mi ongʼiew,</para>
  <para style="q2" vid="PRO 31:16">kendo kuom ohala moloko opidhogo puothe mag olembe.<verse eid="PRO 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17"/>Otiyo tijene gi teko duto;</para>
  <para style="q2" vid="PRO 31:17">kendo oratego e tije motiyo.<verse eid="PRO 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18"/>Oneno ni gik moloso miye ohala</para>
  <para style="q2" vid="PRO 31:18">to tache ok tho gotieno.<verse eid="PRO 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19"/>Ei lwete otingʼo yie rombe</para>
  <para style="q2" vid="PRO 31:19">kendo omako gir chwecho gi lith lwetene.<verse eid="PRO 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20"/>Oyawo bade ne joma jochan</para>
  <para style="q2" vid="PRO 31:20">kendo otero lwete ne jogo mochando.<verse eid="PRO 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21"/>Ka piny ngʼich, oonge luoro ne joode,</para>
  <para style="q2" vid="PRO 31:21">nikech giduto girwakore gi nengni mapichni.<verse eid="PRO 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22"/>Oloso raum ne kitandane,</para>
  <para style="q2" vid="PRO 31:22">orwakore gi lewni marep-rep maralik ma nengogi tek.<verse eid="PRO 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23"/>Chwore imiyo luor e dhoranga dala maduongʼ,</para>
  <para style="q2" vid="PRO 31:23">kama obedoe e dier jodongo mag gwengʼ.<verse eid="PRO 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24"/>Oloso lewni marep-rep mi ousgi,</para>
  <para style="q2" vid="PRO 31:24">kendo omiyo johala gik moko.<verse eid="PRO 31:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25"/>Orwakore gi teko kod dimbruok;</para>
  <para style="q2" vid="PRO 31:25">omiyo onyalo bedo mamor e ndalo mabiro.<verse eid="PRO 31:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26"/>Owuoyo gi rieko</para>
  <para style="q2" vid="PRO 31:26">kendo puonj mar adiera ni e lewe.<verse eid="PRO 31:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27"/>Orito weche mag ode</para>
  <para style="q2" vid="PRO 31:27">to ok ocham chiemb mifwadhi.<verse eid="PRO 31:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28"/>Nyithinde chungo kendo luonge ni en ngʼat mogwedhi,</para>
  <para style="q2" vid="PRO 31:28">chwore bende pake, kawacho niya,<verse eid="PRO 31:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29"/>“Mon mangʼeny timo gik mabeyo,</para>
  <para style="q2" vid="PRO 31:29">to in iloyogi duto.”<verse eid="PRO 31:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30"/>Ber mar wangʼ wuondo ji, to chia bende rumo;</para>
  <para style="q2" vid="PRO 31:30">to dhako moluoro Jehova Nyasaye yudo pak.<verse eid="PRO 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31"/>Miye pak moromo kode mondo onwangʼ</para>
  <para style="q2" vid="PRO 31:31">kendo we mondo tijene okelne pak e dhorangach mar dala maduongʼ.<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
