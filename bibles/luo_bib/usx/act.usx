<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Biblica® Open New Luo Translation 2020</book>
  <para style="h">Tich Joote</para>
  <para style="toc1">Tich Joote</para>
  <para style="toc2">Tich Joote</para>
  <para style="toc3">Joo</para>
  <para style="mt1">Tich Joote</para>
  <chapter number="1" style="c" sid="ACT 1"/>
  <para style="s1">Yesu oter e polo</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1"/>Ne osiepna Theofilo: E kitapa mokwongo ne andikoe gik moko duto mane Yesu otimo kendo opuonjo, <verse eid="ACT 1:1"/><verse number="2" style="v" sid="ACT 1:2"/>nyaka chop chiengʼ mane okawe motere e polo, bangʼ chiwo chik ni joote mane oseyiero kuom teko mar Roho Maler. <verse eid="ACT 1:2"/><verse number="3" style="v" sid="ACT 1:3"/>Bangʼ kane osesande, ne onyisore en owuon ne jogi, kendo nochiwo ranyisi mangʼeny masiro ni ongima. Ne ofwenyorenigi kuom ndalo piero angʼwen ka owuoyo kuom pinyruodh Nyasaye. <verse eid="ACT 1:3"/><verse number="4" style="v" sid="ACT 1:4"/>Chiengʼ moro achiel kane oyudo ochiemo kodgi, nowachonegi niya, <char style="wj">“Kik uwuog Jerusalem, to rituru mich mane Wuonwa osingore ni nomiu, ma usewinja ka awuoyo kuome;</char> <verse eid="ACT 1:4"/><verse number="5" style="v" sid="ACT 1:5"/><char style="wj">nimar Johana nobatiso ji gi pi, to un bangʼ kinde manok ibiro batisou gi Roho Maler.”</char><verse eid="ACT 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6"/>Kuom mano, kane gisechokore kaachiel, negipenje niya, “Ruoth, kindeni ema ibiro duogo pinyruoth e lwet jo-Israel koso?”<verse eid="ACT 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7"/>Nodwokogi niya, <char style="wj">“Ok en wachu mar ngʼeyo ndalo kata kinde ma Wuoro oseketo gi tekone owuon.</char> <verse eid="ACT 1:7"/><verse number="8" style="v" sid="ACT 1:8"/><char style="wj">To ubiro yudo teko ka Roho Maler obiro kuomu; kendo unubed joneno maga ei Jerusalem kendo ei Judea duto gi Samaria, kod tungʼ piny gi tungʼ piny.”</char><verse eid="ACT 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9"/>Bangʼ wacho mano, nokawe motere e polo, mana ka ginene, kendo polo noime mi olalnegi, makoro ne ok ginyal nene.<verse eid="ACT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10"/>Kane oyudo pod gichomo wengegi e polo, ka gingʼiyo kaka odhi, apoya nono, negipo ka ji ariyo morwako lewni marochere ochungʼ bathgi. <verse eid="ACT 1:10"/><verse number="11" style="v" sid="ACT 1:11"/>Jogi nowachonegi niya, “Jo-Galili, angʼo momiyo uchungʼ ka ungʼiyo polo? Yesu owuon-ni, makoro osegol kuomu oter e polo, biro duogo kendo, mana kaka usenene kodhino.”<verse eid="ACT 1:11"/></para>
  <para style="s1">Oyier Mathias mondo okaw kar Judas</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12"/>Bangʼ mano joote nowuok modok Jerusalem, ka gia ewi got miluongo ni Zeituni, ma en kama bor madirom kilomita achiel koa Jerusalem. <verse eid="ACT 1:12"/><verse number="13" style="v" sid="ACT 1:13"/>Kane gichopo, negidhi nyaka kama negidakie, ei ot man malo ewi gorofa. Joma ne ni kanyo ne gin:</para>
  <para style="b" vid="ACT 1:13"/>
  <para style="li1" vid="ACT 1:13">Petro gi Johana, Jakobo gi Andrea;</para>
  <para style="li1" vid="ACT 1:13">Filipo gi Thoma,</para>
  <para style="li1" vid="ACT 1:13">Bartholomayo gi Mathayo,</para>
  <para style="li1" vid="ACT 1:13">Jakobo wuod Alfayo, gi Simon ja-Zilote, kod Judas wuod Jakobo.<verse eid="ACT 1:13"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="14" style="v" sid="ACT 1:14"/>Giduto ne gin e achiel ka ginano e lamo, kaachiel gi mon moko, kod Maria min Yesu gi owete Yesu.<verse eid="ACT 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15"/>E kindeno Petro nochungʼ e kind joma oyie (mane nyalo romo ji mia gi piero ariyo) <verse eid="ACT 1:15"/><verse number="16" style="v" sid="ACT 1:16"/>mi nowachonegi niya, “Owetena, Ndiko nyaka ne chop kare, mana kaka Roho Maler nohulo chon gi dho Daudi, kuom Judas mane otelo ni joma nomako Yesu. <verse eid="ACT 1:16"/><verse number="17" style="v" sid="ACT 1:17"/>Chutho, Judas ne en achiel kuomwa, kendo en bende ne en-gi kare e tichwani.”<verse eid="ACT 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18"/>Judas nongʼiewo lowo gi pesa mane oyudo kuom richone, to kanyo ema noruomboree piny, kendo bund iye nobarore mi nyimbi iye opukore oko. <verse eid="ACT 1:18"/><verse number="19" style="v" sid="ACT 1:19"/>Ji duto mane ni Jerusalem nowinjo wachno, mine giluongo puodhono gi dhogi ni Akeldama, ma tiende ni, Puoth Remo.<verse eid="ACT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20"/>Petro nodhi nyime kawacho niya, “Ondik e Kitap Zaburi kama:</para>
  <para style="q1" vid="ACT 1:20">“ ‘Mad miechgi dongʼ gunda;</para>
  <para style="q2" vid="ACT 1:20">ngʼato angʼata kik yiene dag e iye,’<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 69:25">Zab 69:25</ref></char></char></note></para>
  <para style="m" vid="ACT 1:20">kendo ondik niya,</para>
  <para style="q1" vid="ACT 1:20">“ ‘Mad ngʼat machielo kaw tije.’<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 109:8">Zab 109:8</ref></char></char></note><verse eid="ACT 1:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="ACT 1:21"/>Kuom mano, ber mondo wayier ngʼato achiel e kind joma osebedo kodwa, chakre kinde mane Ruoth Yesu ochako bedo kodwa nyaka chop kinde mane okawe e dierwa. <verse eid="ACT 1:21"/><verse number="22" style="v" sid="ACT 1:22"/>Ngʼatno nyaka bed ngʼat mane nitie chakre ndalo Johana Ja-batiso nyaka odiechiengʼ mane okaw Yesu ogol e dierwa. Nimar achiel kuom jogi nyaka bed janeno kuom chierne kaachiel kodwa.”<verse eid="ACT 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23"/>Eka negichiwo nying ji ariyo: Josef miluongo ni Barsaba (ma bende niluongo ni Justo) kod Mathias. <verse eid="ACT 1:23"/><verse number="24" style="v" sid="ACT 1:24"/>Bangʼe ne gilemo niya, “Ruoth, ingʼeyo chuny ji duto. Nyiswae kuom ji ariyogi ngʼat miseyiero <verse eid="ACT 1:24"/><verse number="25" style="v" sid="ACT 1:25"/>mondo okaw tich mar bedo jaote mane Judas ojwangʼo oweyo kane odhi kare mane ochanne.” <verse eid="ACT 1:25"/><verse number="26" style="v" sid="ACT 1:26"/>Eka negigoyo ombulu, kendo ombulu nolwar kuom Mathias. Omiyo nomede kuom joote apar gachiel mamoko.<verse eid="ACT 1:26"/></para>
  <chapter eid="ACT 1"/>
  <chapter number="2" style="c" sid="ACT 2"/>
  <para style="s1">Biro mar Roho Maler chiengʼ Pentekost</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1"/>Ka chiengʼ Pentekost nochopo, noyudo ka gichokore kanyachiel giduto. <verse eid="ACT 2:1"/><verse number="2" style="v" sid="ACT 2:2"/>Apoya nono, koko machalo gi yamb kalausi makudho matek noa e polo mopongʼo ot mane gibetie. <verse eid="ACT 2:2"/><verse number="3" style="v" sid="ACT 2:3"/>Negineno gik machalo gi ligek mach, mane opiyo ewi ngʼato ka ngʼato kuomgi. <verse eid="ACT 2:3"/><verse number="4" style="v" sid="ACT 2:4"/>Giduto kar rombgi negipongʼ gi Roho Maler, mi gichako wuoyo gi dhok mayoreyore kaka Roho nomiyogi teko mar wuoyo.<verse eid="ACT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5"/>E sechego noyudo jo-Yahudi mathoth moluoro Nyasaye ni Jerusalem. Jogi noa e pinje duto manie bwo polo. <verse eid="ACT 2:5"/><verse number="6" style="v" sid="ACT 2:6"/>Kane giwinjo kit kokoni, ji mangʼeny nochokore kanyakla, ka gihum nono, nikech ngʼato ka ngʼato kuomgi ne winjo ka jogo wacho dhogi. <verse eid="ACT 2:6"/><verse number="7" style="v" sid="ACT 2:7"/>Negihum kendo giwuoro, mi gipenjo niya, “Donge joma wuoyogi duto gin jo-Galili? <verse eid="ACT 2:7"/><verse number="8" style="v" sid="ACT 2:8"/>Ka kamano, to ere kaka ngʼato ka ngʼato kuomwa winjogi mana e dhowa wawegi? <verse eid="ACT 2:8"/><verse number="9" style="v" sid="ACT 2:9"/>Kama wantiereni nitie jo-Parthia, Media, Elam, Mesopotamia, Judea, Kapadokia, Ponto, Asia, <verse eid="ACT 2:9"/><verse number="10" style="v" sid="ACT 2:10"/>Frugia, Pamfilia, Misri kod gwenge mag Libya mokiewo gi Kurene; kaachiel gi welo moa Rumi, mane otingʼo jo-Yahudi kod joma moko molokore mondo oluw din jo-Yahudi. <verse eid="ACT 2:10"/><verse number="11" style="v" sid="ACT 2:11"/>To moko bende gin jo-Krete gi jo-Arabu. Ere kaka wawinjogi ka gihulo gik madongo ma Nyasaye osetimo e dhowa wawegi!” <verse eid="ACT 2:11"/><verse number="12" style="v" sid="ACT 2:12"/>Negipenjore ka gihum kendo gidhier nono niya, “Gima timoreni to tiende angʼo?”<verse eid="ACT 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13"/>To jomoko kuomgi nojarogi kawacho niya, “Jogi osemadho kongʼo mangʼeny momerogi.”<verse eid="ACT 2:13"/></para>
  <para style="s1">Petro owuoyo gi oganda</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14"/>Eka Petro nochungʼ malo, kaachiel gi jopuonjre apar gachiel mamoko, motingʼo dwonde kowuoyo gi jogo niya, “Un jo-Yahudi wetena, kaachiel kod ji duto modak Jerusalem, weuru anyisu tiend wachni. Chikuru itu maber mondo uwinj gima awacho. <verse eid="ACT 2:14"/><verse number="15" style="v" sid="ACT 2:15"/>Jogi ok omer kaka uwachono nikech pod en mana sa adek okinyi sani ok ngʼato nyal merie! <verse eid="ACT 2:15"/><verse number="16" style="v" sid="ACT 2:16"/>Ooyo, gima timoreni en mana gima Janabi Joel nokoro chon kowacho ni,<verse eid="ACT 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17"/>“ ‘Nyasaye wacho kama: E ndalo giko</para>
  <para style="q2" vid="ACT 2:17">anaol Roho Maler mara kuom ji duto.</para>
  <para style="q1" vid="ACT 2:17">Yawuotu gi nyiu nokor wach,</para>
  <para style="q2" vid="ACT 2:17">jou matindo none fweny,</para>
  <para style="q2" vid="ACT 2:17">jodongu nolek lek.<verse eid="ACT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18"/>Kata mana jotichna machwo gi mamon,</para>
  <para style="q2" vid="ACT 2:18">bende naol Roho Maler mara kuomgi ndalono,</para>
  <para style="q2" vid="ACT 2:18">mi ginikor wach.<verse eid="ACT 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19"/>Anatim honni miwuoro e kor polo malo</para>
  <para style="q2" vid="ACT 2:19">kod ranyisi mathoth e piny mwalo,</para>
  <para style="q2" vid="ACT 2:19">remo gi mach kod iro madhwolore nobedie.<verse eid="ACT 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20"/>Wangʼ chiengʼ nolokre mudho</para>
  <para style="q2" vid="ACT 2:20">to dwe nolokre remo,</para>
  <para style="q2" vid="ACT 2:20">kapok odiechiengʼ maduongʼ kendo man-gi duongʼ mar Jehova Nyasaye ochopo.<verse eid="ACT 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21"/>To ngʼato ka ngʼato</para>
  <para style="q2" vid="ACT 2:21">maluongo nying Jehova Nyasaye noresi!’<note caller="+" style="f"><char style="fr" closed="false">2:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOL 2:28-32">Joe 2:28-32</ref></char></char></note>”<verse eid="ACT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22"/>Petro nomedo wachonegi niya, “Un jo-Israel, winjuru wachni: Yesu ja-Nazareth ne Nyasaye ochungo e dieru kaka ngʼat mowinjore miyo luor. Nyasaye notimo honni gi gik malich miwuoro kod ranyisi madongo e dieru kokalo kuome, mana kaka un uwegi ungʼeyo maber. <verse eid="ACT 2:22"/><verse number="23" style="v" sid="ACT 2:23"/>Yesuni ne ochiw e lwetu kaluwore gi chenro mar Nyasaye kod ngʼeyone mongirore, makmana un kukonyoru gi joma timbegi richo, ne unege ka ugure gi musmal e msalaba. <verse eid="ACT 2:23"/><verse number="24" style="v" sid="ACT 2:24"/>Kata kamano, Nyasaye nochiere oa kuom joma otho, mi ogonye oa e rem malit mar tho, nikech kata mana tho ne ok nyal loye. <verse eid="ACT 2:24"/><verse number="25" style="v" sid="ACT 2:25"/>Daudi bende nowuoyo kuome niya,</para>
  <para style="q1" vid="ACT 2:25">“ ‘Ne aneno Jehova Nyasaye e nyima ndalo duto.</para>
  <para style="q2" vid="ACT 2:25">Nikech ka entie e lweta korachwich,</para>
  <para style="q2" vid="ACT 2:25">to onge gima nyalo yienga.<verse eid="ACT 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26"/>Emomiyo chunya mor kendo lewa yot;</para>
  <para style="q2" vid="ACT 2:26">ringra bende nobed gi geno,<verse eid="ACT 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27"/>nikech ok inijwangʼa ei liel,</para>
  <para style="q2" vid="ACT 2:27">to bende ok niyie Ngʼati Maler ringre tow.<verse eid="ACT 2:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28"/>Isenyisa yore mag ngima;</para>
  <para style="q2" vid="ACT 2:28">kendo inipongʼa gi mor mogundho, ka an e nyimi.’<note caller="+" style="f"><char style="fr" closed="false">2:28 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 16:8-11">Zab 16:8-11</ref></char></char></note><verse eid="ACT 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29"/>“Owetena, anyalo wachonu ka an gichir ni Daudi kwarwa notho mi noyike, kendo liende ni kodwa nyaka kawuono. <verse eid="ACT 2:29"/><verse number="30" style="v" sid="ACT 2:30"/>To kaka ne en janabi, nongʼeyo ni Nyasaye nosesingore e yor kwongʼruok ni enoket achiel kuom nyikwaye e lochne. <verse eid="ACT 2:30"/><verse number="31" style="v" sid="ACT 2:31"/>Ne oneno gik mane biro timore nyime, omiyo nowuoyo kuom chier mar Kristo ni ne ok bi jwangʼo ringre ei liel mi ringre tow. <verse eid="ACT 2:31"/><verse number="32" style="v" sid="ACT 2:32"/>Yesuni ema Nyasaye osechiero oa kuom joma otho, kendo wan wawegi wan joneno kuom wachno. <verse eid="ACT 2:32"/><verse number="33" style="v" sid="ACT 2:33"/>Kaka koro en gi duongʼ, kobet e bad Nyasaye korachwich, Wuoro osemiye Roho Maler mane osingore ni nochiw, kendo oseoro gima koro uneno kendo uwinjoni.” <verse eid="ACT 2:33"/><verse number="34" style="v" sid="ACT 2:34"/>Daudi owuon to ne ok oidho odhi e polo, to en ema nowacho niya,</para>
  <para style="q1" vid="ACT 2:34">“ ‘Ruoth nowachone Ruodha ni,</para>
  <para style="q2" vid="ACT 2:34">“Bed e bada korachwich,<verse eid="ACT 2:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35"/>nyaka chop aket wasiki</para>
  <para style="q2" vid="ACT 2:35">e bwo tiendi.” ’<note caller="+" style="f"><char style="fr" closed="false">2:35 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:1">Zab 110:1</ref></char></char></note><verse eid="ACT 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36"/>“Emomiyo nyaka ungʼe wachni malongʼo, un jo-Israel duto ni Nyasaye oseketo Yesu mane uguro Ruoth kendo Kristo.”<verse eid="ACT 2:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37"/>Kane ji owinjo wachno, chunygi nongʼadonigi bura, mine giwachone Petro kod joote mamoko niya, “Owetewa, en angʼo ma dwatim?”<verse eid="ACT 2:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38"/>Petro nodwokogi niya, “Weuru richo kendo obatisu ngʼato ka ngʼato, e nying Yesu Kristo, mondo owenu richou. Ka mano otimore, to ubiro nwangʼo Roho Maler kaka mich. <verse eid="ACT 2:38"/><verse number="39" style="v" sid="ACT 2:39"/>Singruok mane Nyasaye otimono en maru kaachiel gi nyithindu; kendo en mar ji duto modak kuma bor, ma gin jogo duto ma Ruoth Nyasachwa noluong ire.”<verse eid="ACT 2:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40"/>Petro nomedo siemogi gi weche mamoko mathoth; komedo jiwogi kowacho niya, “Tonyuru ua kuom tiengʼ mokethoreni.” <verse eid="ACT 2:40"/><verse number="41" style="v" sid="ACT 2:41"/>Joma norwako weche Petro ne obatisi, kendo chiengʼno ji alufu adek nomedore e kwan mar joma oyie kuom Kristo.<verse eid="ACT 2:41"/></para>
  <para style="s1">Lalruok mar joma oyie kuom Kristo</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42"/>Joma oyie kuom Kristo noketo chunygi kuom puonj joote, kendo kuom lalruok, gi ngʼingo makati kod lamo. <verse eid="ACT 2:42"/><verse number="43" style="v" sid="ACT 2:43"/>Luoro nomako ji duto ka joote ne timo honni gi ranyisi mangʼeny. <verse eid="ACT 2:43"/><verse number="44" style="v" sid="ACT 2:44"/>Ji duto moyie kuom Kristo noriwore kanyakla kendo negikonyore gi mwandugi duto kaachiel. <verse eid="ACT 2:44"/><verse number="45" style="v" sid="ACT 2:45"/>Negiloko mwandugi kod gik mane gin-go pesa kendo ne gipogore kaka ne ngʼato ka ngʼato dwaro. <verse eid="ACT 2:45"/><verse number="46" style="v" sid="ACT 2:46"/>Negisiko giromo pile ka pile e laru mar hekalu, kendo ne gingʼingo makati e miechgi, ka gichiemo kaachiel gi chuny mamor. <verse eid="ACT 2:46"/><verse number="47" style="v" sid="ACT 2:47"/>Negisiko gipako Nyasaye, kendo ji duto ne mor kodgi. To Ruoth ne medo kwan mar joma oyie kuom Kristo e chokruokgi pile ka pile.<verse eid="ACT 2:47"/></para>
  <chapter eid="ACT 2"/>
  <chapter number="3" style="c" sid="ACT 3"/>
  <para style="s1">Petro ochango puth ma jakwecho</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1"/>Chiengʼ moro achiel, kar sa ochiko odhiambo, mane en sa mar lemo noyudo ka Petro gi Johana odhi e hekalu. <verse eid="ACT 3:1"/><verse number="2" style="v" sid="ACT 3:2"/>To e sechego noyudo otingʼ ngʼat moro maputh kitero e ranga hekalu miluongo ni Malongʼo, kama ne ojaketee pile pile, mondo okwa kony kuom joma donjo ei hekalu. <verse eid="ACT 3:2"/><verse number="3" style="v" sid="ACT 3:3"/>Kane ngʼatno oneno Petro gi Johana kadonjo ei hekalu, nokwayogi kony. <verse eid="ACT 3:3"/><verse number="4" style="v" sid="ACT 3:4"/>To Petro gi Johana ne ongʼiyo wangʼe tir, mi Petro owachone niya, “Ngʼiwa ane!” <verse eid="ACT 3:4"/><verse number="5" style="v" sid="ACT 3:5"/>Ngʼatno nongʼiyogi, kogeno yudo gimoro kuomgi.<verse eid="ACT 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 3:6"/>Eka Petro nowachone niya, “Fedha gi dhahabu aongego, to gima an-go ema amiyi. E nying Yesu Kristo ja-Nazareth, chungi iwuothi.” <verse eid="ACT 3:6"/><verse number="7" style="v" sid="ACT 3:7"/>Nomako bad ngʼatno, mi okonye aa malo, kendo gikanyo tiend ngʼatno gi ombongʼne noyudo teko. <verse eid="ACT 3:7"/><verse number="8" style="v" sid="ACT 3:8"/>Ngʼatno nochikore malo mi ochako wuoth. Bangʼe nodhi kodgi ei laru mar hekalu, kowuotho kendo kochikore kendo kopako Nyasaye. <verse eid="ACT 3:8"/><verse number="9" style="v" sid="ACT 3:9"/>Ka ji duto nonene kowuotho kendo kopako Nyasaye, <verse eid="ACT 3:9"/><verse number="10" style="v" sid="ACT 3:10"/>negifwenyo ni en e ngʼat mane jabedo kakwecho e dhoranga hekalu miluongo ni Malongʼo, omiyo ne giwuoro kendo dhogi nomoko kuom gima notimorene.<verse eid="ACT 3:10"/></para>
  <para style="s1">Petro olero ne ji wach</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11"/>Kane jakwechono pod otwere kuom Petro gi Johana, ji duto nohum nono. Negibiro gingʼwech ir jootego nyaka kama iluongo ni Agoch Solomon. <verse eid="ACT 3:11"/><verse number="12" style="v" sid="ACT 3:12"/>Kane Petro onenogi, nowachonegi niya, “Un jo-Israel, angʼo momiyo gima otimoreni obwogou? Angʼo momiyo uchomo wangʼu kungʼiyowa mana ka gima tekowa wawegi kata timwa makare ema omiyo ngʼatni owuotho? <verse eid="ACT 3:12"/><verse number="13" style="v" sid="ACT 3:13"/>Nyasach Ibrahim gi Isaka kod Jakobo, ma en Nyasach kwerewa, ema osemiyo Yesu jatichne duongʼ. Ne uchiwe mondo onege, kendo ne ukwede e nyim Pilato, kata obedo ni Pilato ne dwaro gonye. <verse eid="ACT 3:13"/><verse number="14" style="v" sid="ACT 3:14"/>Ne ukwedo Ngʼama Ler kendo makare, to ukwayo mondo ogonynu janek. <verse eid="ACT 3:14"/><verse number="15" style="v" sid="ACT 3:15"/>Ne unego wuon ngima, to Nyasaye nochiere oa kuom joma otho. Wan wawegi wan joneno kuom wachni. <verse eid="ACT 3:15"/><verse number="16" style="v" sid="ACT 3:16"/>Kuom yie e nying Yesu, ema ngʼat munenoni kendo ungʼeyoni oseyudoe chang. En mana nying Yesu, kaachiel kod yie maa kuome, ema osemiyo ngʼatni resruok moromo chuth, mana kaka un duto unenoni.<verse eid="ACT 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17"/>“To koro, owetena, angʼeyo ni ne utimo gigo ka ok ungʼeyo, mana kaka jotendu bende notimogi kane ok gingʼeyo. <verse eid="ACT 3:17"/><verse number="18" style="v" sid="ACT 3:18"/>To ma e yo ma Nyasaye nochopogo chenrone mane osenyiso chon gi dho jonabi duto, kowacho ni Kristo nyaka sandi. <verse eid="ACT 3:18"/><verse number="19" style="v" sid="ACT 3:19"/>Koro lokreuru uwe richou, udog ir Nyasaye, mondo richou owenu, eka Ruoth noduog chunyu mi uyud kwe, <verse eid="ACT 3:19"/><verse number="20" style="v" sid="ACT 3:20"/>bangʼe enoornu Yesu Kristo, Jal mane owalnu. <verse eid="ACT 3:20"/><verse number="21" style="v" sid="ACT 3:21"/>To pod nyaka obedie e polo nyaka chop kinde ma Nyasaye ketoe gik moko duto kare, mana kaka nosesingore chon gi dho jonabi mage maler. <verse eid="ACT 3:21"/><verse number="22" style="v" sid="ACT 3:22"/>Musa nowacho ni, ‘Jehova Nyasaye ma Nyasachu biro miyou janabi machal koda kowuok e dier ogandau, kendo un bende nyaka uwinj gimoro amora mowachonu. <verse eid="ACT 3:22"/><verse number="23" style="v" sid="ACT 3:23"/>Ngʼato angʼata ma ok winje, to nongʼad kare oko chuth e kind ogandane.’<note caller="+" style="f"><char style="fr" closed="false">3:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 18:15">Rap 18:15</ref>,<ref loc="DEU 18:18">18</ref>,<ref loc="DEU 18:19">19</ref></char></char></note><verse eid="ACT 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24"/>“Chutho, jonabi duto, kochakore ndalo Samuel gi jonabi mane oluwo bangʼe kaachiel gi ji duto mane owuoyo, bende nokoro gik matinde timore ndaloni. <verse eid="ACT 3:24"/><verse number="25" style="v" sid="ACT 3:25"/>To un e nyikwa jonabigo, kendo un e weg singruok ma Nyasaye notimo gi kwereu. Nyasaye nowachone Ibrahim ni, ‘joma ok jo-Yahudi duto mag piny noyud gweth koa kuom kothi.’<note caller="+" style="f"><char style="fr" closed="false">3:25 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 22:18">Chak 22:18</ref>; <ref loc="GEN 26:4">26:4</ref></char></char></note> <verse eid="ACT 3:25"/><verse number="26" style="v" sid="ACT 3:26"/>Kane Nyasaye ooro Jatichne, to noore mokwongo ne un, mondo ogwedhu, ka oloko ngʼato ka ngʼato weyo yorene maricho.”<verse eid="ACT 3:26"/></para>
  <chapter eid="ACT 3"/>
  <chapter number="4" style="c" sid="ACT 4"/>
  <para style="s1">Oter Petro gi Johana e nyim Sanhedrin</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1"/>Kane Petro gi Johana pod wuoyo gi ji, jodolo gi jatend jorit hekalu kod jo-Sadukai nobiro irgi. <verse eid="ACT 4:1"/><verse number="2" style="v" sid="ACT 4:2"/>Igi nowangʼ kendo chunygi nokethore nikech jootego ne puonjo ji ni joma osetho biro chier kuom Yesu. <verse eid="ACT 4:2"/><verse number="3" style="v" sid="ACT 4:3"/>Negimako Petro gi Johana, to kaka piny koro ne dwaro yuso, negiketogi e od twech nyaka kinyne. <verse eid="ACT 4:3"/><verse number="4" style="v" sid="ACT 4:4"/>Ji mangʼeny mane owinjo puonj jootego noyie, kendo kar romb chwo mane oyie nomedore moromo chwo alufu abich.<verse eid="ACT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5"/>Kinyne, jotend jo-Yahudi gi jodongo kod jopuonj Chik noromo Jerusalem. <verse eid="ACT 4:5"/><verse number="6" style="v" sid="ACT 4:6"/>Anas, jadolo maduongʼ, bende ne ni kanyo, kaachiel gi Kaifas, Johana, Aleksanda, kod jood jadolo maduongʼ mamoko. <verse eid="ACT 4:6"/><verse number="7" style="v" sid="ACT 4:7"/>Negigolo chik mondo okel Petro gi Johana e nyimgi, eka negichako penjogi niya, “En teko mane, kata nying ngʼa mane mutimogo gima utimoni?”<verse eid="ACT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8"/>Eka Petro mane oyudo opongʼ gi Roho Maler nowachonegi niya, “Jotelo gi jodongo mag oganda! <verse eid="ACT 4:8"/><verse number="9" style="v" sid="ACT 4:9"/>Ka dipo ni uluongowa e nyimu ka mondo waler gimomiyo otim tim maber ne puth, kendo mondo upenjwa kaka nende oyudo chang, <verse eid="ACT 4:9"/><verse number="10" style="v" sid="ACT 4:10"/>to gima onego ungʼe kaachiel gi jo-Israel duto ema: Kuom nying Yesu Kristo ja-Nazareth mane uguro un uwegi, to Nyasaye nochiere oa kuom joma otho ema omiyo ngʼatni ochungʼ e dieru kangima chuth. <verse eid="ACT 4:10"/><verse number="11" style="v" sid="ACT 4:11"/>Yesu ema Ndiko owuoyo kuome kawacho niya,</para>
  <para style="q1" vid="ACT 4:11">“ ‘Kidi ma un jogedo nudagi</para>
  <para style="q2" vid="ACT 4:11">ema koro osedoko kidi motegno moriwo kor ot.’<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:22">Zab 118:22</ref></char></char></note><verse eid="ACT 4:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12"/>Warruok ok nyal yud kuom ngʼat moro machielo; nikech onge nying moro machielo e bwo polo mosechiw ni mondo ji oyud warruok kuome.”<verse eid="ACT 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13"/>Kane gineno chir mane Petro gi Johana nigo, kendo kane ginwangʼo ni gin ji ajia ma ok osomo, ne giwuoro ahinya, eka negifwenyo ni jogi yande nigi Yesu. <verse eid="ACT 4:13"/><verse number="14" style="v" sid="ACT 4:14"/>To nikech ne pod gineno ka ngʼat mane osechangi ochungʼ e diergi kanyo, onge gima neginyalo wacho mondo gikwed gima nosetimoreno. <verse eid="ACT 4:14"/><verse number="15" style="v" sid="ACT 4:15"/>Kuom mano, negiriembogi oko mar buch Sanhedrin, eka bangʼe ne gikuotho e kindgi giwegi niya, <verse eid="ACT 4:15"/><verse number="16" style="v" sid="ACT 4:16"/>“Angʼo ma wanyalo timo ni jogi? Ji duto modak Jerusalem ongʼeyo maber ni gisetimo hono mongʼongʼore, kendo ok wanyal kwedo mano. <verse eid="ACT 4:16"/><verse number="17" style="v" sid="ACT 4:17"/>To mondo wagengʼ wachni kik landre malach e dier ji, nyaka wasiem jogi ni kik gichak giwuo kuom nyingni ne ngʼato angʼata.”<verse eid="ACT 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18"/>Eka ne gichak giluongogi mi gisiemogi ni kik giwuo kata puonjo e nying Yesu. <verse eid="ACT 4:18"/><verse number="19" style="v" sid="ACT 4:19"/>To Petro gi Johana nodwokogi niya, “Un ema ungʼad bura kendu, ka bende en gima ber e nyim Nyasaye mondo wawinju moloyo winjo Nyasaye. <verse eid="ACT 4:19"/><verse number="20" style="v" sid="ACT 4:20"/>Nikech ok wanyal lingʼ ma ok wawuoyo kuom gik ma waseneno kendo ma wasewinjo.”<verse eid="ACT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21"/>Bangʼ medo siemo jootego, ne giweyogi gidhi. Ne ok ginyal yudo yo ma ginyalo kumogigo nikech ji duto ne miyo Nyasaye duongʼ kuom gima nosetimoreno, <verse eid="ACT 4:21"/><verse number="22" style="v" sid="ACT 4:22"/>kendo ngʼat mane ochangi e yor honono ne hike oloyo piero angʼwen.<verse eid="ACT 4:22"/></para>
  <para style="s1">Joma oyie kuom Kristo olamo Nyasaye</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23"/>Kane osegony Petro gi Johana, negidok ir owete mamoko mi ginyisogi gik moko duto ma jodolo madongo gi jodong oganda nosewachonegi. <verse eid="ACT 4:23"/><verse number="24" style="v" sid="ACT 4:24"/>Bangʼ winjo wachgino, negitingʼo dwondgi malo kaachiel ka gilamo Nyasaye niya, “Yaye Ruoth Nyasaye Manyalo Gik Moko Duto, in ema nichweyo polo gi piny gi nam kod gik moko duto manie igi. <verse eid="ACT 4:24"/><verse number="25" style="v" sid="ACT 4:25"/>Ne iwuoyo kuom Roho Maler gi dho jatichni, ma en kwarwa Daudi, kiwacho niya:</para>
  <para style="q1" vid="ACT 4:25">“ ‘Angʼo momiyo ogendini igi owangʼ</para>
  <para style="q2" vid="ACT 4:25">kendo ji chano jiemo kayiem nono?<verse eid="ACT 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26"/>Ruodhi mag piny osebiro kanyakla</para>
  <para style="q2" vid="ACT 4:26">kendo jotelo pimo wach kaachiel,</para>
  <para style="q1" vid="ACT 4:26">mondo giked gi Jehova Nyasaye</para>
  <para style="q2" vid="ACT 4:26">kendo giked gi Ngʼate mowir.<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="fqa" closed="false">Ngʼate Mowiro </char><char style="ft" closed="false">en </char><char style="fqa" closed="false">Kristo </char><char style="ft" closed="false">ma </char><char style="fqa" closed="false">Jawar.</char></note>’<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:1">Zab 2:1</ref>,<ref loc="PSA 2:2">2</ref></char></char></note><verse eid="ACT 4:26"/></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27"/>Chutho, Herode gi Pontio Pilato noromo e dalani kod joma ok jo-Yahudi kaachiel gi jo-Israel mondo gilos yor hinyo Jatichni Maler ma isewiro, ma en Yesu. <verse eid="ACT 4:27"/><verse number="28" style="v" sid="ACT 4:28"/>Negitimo gima in iwuon ne isechano chon gi tekoni kod ngʼeyoni ni nyaka timre. <verse eid="ACT 4:28"/><verse number="29" style="v" sid="ACT 4:29"/>To koro Ruoth, winj siem ma gisiemowago, kendo mi jotichni teko mondo ohul wachni gi teko moloyo. <verse eid="ACT 4:29"/><verse number="30" style="v" sid="ACT 4:30"/>Rie badi mondo ichangi jotuo kendo itim honni kod ranyisi madongo e nying Yesu, Jatichni Maler.”<verse eid="ACT 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31"/>Kane giselamo, kama ne gichokoreno noyiengni, kendo Roho Maler nopongʼogi giduto, mi giyalo Wach Nyasaye gi chir.<verse eid="ACT 4:31"/></para>
  <para style="s1">Joma oyie opogo mwandugi gi jowetegi</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32"/>Joma oyie kuom Kristo duto ne timo gik moko gi chuny achiel kod paro achiel. Onge ngʼato kuomgi kata achiel mane okawo mwandune kaka gige owuon, to ngʼato ka ngʼato ne pogo gige duto ni nyawadgi, ka gikonyore ngʼato gi ngʼato. <verse eid="ACT 4:32"/><verse number="33" style="v" sid="ACT 4:33"/>Joote nodhi nyime gi hulo wach kuom chier mar Ruoth Yesu gi teko mangʼongo, kendo ngʼwono maduongʼ ne ni kodgi duto. <verse eid="ACT 4:33"/><verse number="34" style="v" sid="ACT 4:34"/>Onge ngʼato kuomgi mane ochando gimoro, nikech kinde ka kinde jogo mane nigi puothe kata udi ne loko gigegigo pesa, kendo negikelo pesa mane giyudo mi <verse eid="ACT 4:34"/><verse number="35" style="v" sid="ACT 4:35"/>giket e lwet joote eka joote ne pogo pesago kaka ne ngʼato ka ngʼato dwaro.<verse eid="ACT 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36"/>Kamano bende, e kaka Josef ma Ja-Lawi modak Saipras, mane joote ochako ni Barnaba (ma tiende ni “Ngʼat ma jiwo ji”), <verse eid="ACT 4:36"/><verse number="37" style="v" sid="ACT 4:37"/>noloko puothe pesa mi okelo oketo e lwet joote.<verse eid="ACT 4:37"/></para>
  <chapter eid="ACT 4"/>
  <chapter number="5" style="c" sid="ACT 5"/>
  <para style="s1">Anania gi Safira</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1"/>Koro ngʼat moro miluongo ni Anania, kaachiel gi chiege Safira, bende noloko puothgi moro pesa. <verse eid="ACT 5:1"/><verse number="2" style="v" sid="ACT 5:2"/>To Anania nodongʼ gi bath pesa moko lingʼ-lingʼ mondo okonyrego, ka chiege bende nongʼeyo wachno maber. Pesa modongʼ, to nokelo oketo e lwet joote.<verse eid="ACT 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 5:3"/>Eka Petro nowachone Anania niya, “Ere kaka iseweyone Satan thuolo e chunyi momiyo isewuondo Roho Maler, ka idongʼ gi bath pesa mane iyudo kuom puodho? <verse eid="ACT 5:3"/><verse number="4" style="v" sid="ACT 5:4"/>Donge puodhono ne en mari kane pok iloke pesa? Kata kane iseloke pesa, donge ne inyalo konyori gi pesago kaka ihero? En angʼo manomiyo iparo mondo itim gima kamano? Nyasaye ema isewuondo, to ok dhano!”<verse eid="ACT 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5"/>Kane Anania owinjo wachno, nogore piny motho. Ji duto mane owinjo gima notimoreno ne luoro omako. <verse eid="ACT 5:5"/><verse number="6" style="v" sid="ACT 5:6"/>Eka yawuowi nobiro moboyo ringre gi law, mine gikawe kendo tere oko mi giike.<verse eid="ACT 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7"/>Bangʼ seche adek, chiege bende nobiro kanyo, kokia gima nosetimore ne chwore. <verse eid="ACT 5:7"/><verse number="8" style="v" sid="ACT 5:8"/>Petro nopenje niya, “Nyisa ane ka bende ma e nengo mane Anania oyudo kuom puodho manende oloko pesa?”</para>
  <para style="p" vid="ACT 5:8">Safira nodwoke niya, “Ee, mano e nengone.”<verse eid="ACT 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9"/>To Petro nowachone niya, “Ere kaka ne unyalo winjoru mondo utem Roho mar Ruoth? Ne! Tiend joma ne oyiko chwori pod ni e dhoot, in bende gibiro tingʼi giteri oko.”<verse eid="ACT 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 5:10"/>Gikanyono Safira nogore piny e tiend Petro mi otho. Eka yawuowi nobiro modonjo, to kane giyude ka osetho, ne gitingʼe gitere oko mi giike e bath chwore. <verse eid="ACT 5:10"/><verse number="11" style="v" sid="ACT 5:11"/>Luoro maduongʼ nomako kanisa, kod ji duto mane owinjo gik mane otimore.<verse eid="ACT 5:11"/></para>
  <para style="s1">Joote ochango ji mangʼeny</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12"/>Joote notimo honni gi ranyisi mathoth e dier ji, to joma oyie kuom Kristo duto ne chokore gi chuny achiel e Agoch Solomon. <verse eid="ACT 5:12"/><verse number="13" style="v" sid="ACT 5:13"/>Onge ngʼato angʼata mane nyalo hedhore mondo oriwre kodgi, kata obedo ni ji ne omiyogi luor malich kamano. <verse eid="ACT 5:13"/><verse number="14" style="v" sid="ACT 5:14"/>To kata kamano, chwo gi mon mangʼeny nomedo yie kuom Ruoth, kendo mago manoyie nomedore e kwan joma noseyie kuom Kristo. <verse eid="ACT 5:14"/><verse number="15" style="v" sid="ACT 5:15"/>Kuom mano, ji nokelo joma tuo mi giketogi e bath yore ka gipielogi e kitendini kod pere, mondo kata mana tipo mar Petro oum moko kuomgi kokalo butgi. <verse eid="ACT 5:15"/><verse number="16" style="v" sid="ACT 5:16"/>Oganda mag ji mathoth moa e mier mokiewo gi Jerusalem bende nokelo jogi matuo gi joma jochiende sando, kendo jogo duto nochangi.<verse eid="ACT 5:16"/></para>
  <para style="s1">Joote osandi</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17"/>Eka jadolo maduongʼ gi joge, mane gin jokanyo mar buch jo-Sadukai, nyiego nomako. <verse eid="ACT 5:17"/><verse number="18" style="v" sid="ACT 5:18"/>Negimako joote mi giterogi e od twech. <verse eid="ACT 5:18"/><verse number="19" style="v" sid="ACT 5:19"/>To kane ochopo otieno, malaika mar Ruoth noyawo dhoudi duto mag od twech mogologi oko. <verse eid="ACT 5:19"/><verse number="20" style="v" sid="ACT 5:20"/>Malaikano nowachonegi niya, “Dhiuru uchungʼ ei hekalu mondo unyis ji weche duto kuom ngima manyien-ni.”<verse eid="ACT 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 5:21"/>Kane piny oyawore, negidonjo e hekalu mana kaka nonyisgi, mi gichako puonjo ji.</para>
  <para style="p" vid="ACT 5:21">To ka jadolo maduongʼ gi joge nochopo, negichoko jobuch Sanhedrin, ma en chokruok mar jodong Israel duto, mi gioro wach mondo ogol joote e od twech okel e nyimgi. <verse eid="ACT 5:21"/><verse number="22" style="v" sid="ACT 5:22"/>To kane askeche ochopo e od twech, ne ok giyudo jopuonjre kuno. Kuom mano negidwoko wach niya, <verse eid="ACT 5:22"/><verse number="23" style="v" sid="ACT 5:23"/>“Ne wayudo ka dhout od twech olor matek, kendo ka jorito ochungʼ e dhoudi; to kane wayawo dhoudigo, to ne ok wayudo ngʼato ei od twech.” <verse eid="ACT 5:23"/><verse number="24" style="v" sid="ACT 5:24"/>Kane jatend jorit hekalu gi jodolo madongo owinjo wachni, ne gidhier nono, ka giparore kuom gima wachni ne nyalo kelo.<verse eid="ACT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 5:25"/>Eka ngʼat moro nobiro mowachonegi niya, “Winjieuru! Joma ne uketo e od twech ka aneno kochungʼ ei hekalu ka puonjo ji.” <verse eid="ACT 5:25"/><verse number="26" style="v" sid="ACT 5:26"/>Kane jatend jorit hekalu owinjo wachno, nowuok mana gisano gi askechene mi gidhi giomo joote gikelo. Ne ok gitiyo githuon, nikech negiluor ni ji nyalo chielogi gi kite.<verse eid="ACT 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27"/>Kane gisekelo jootego, negiterogi e nyim jobuch Sanhedrin mondo jadolo maduongʼ onon-giane. <verse eid="ACT 5:27"/><verse number="28" style="v" sid="ACT 5:28"/>Jadolo maduongʼ nowachonegi niya, “Donge ne wasiemou ni kik uchak upuonj ji e nying ngʼatni, to koro ere kaka usepongʼo Jerusalem duto gi puonju, kuramo ni nyaka bura lowa nikech remb ngʼatni?”<verse eid="ACT 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29"/>Petro gi joote mamoko nodwokogi niya, “Nyaka wawinj mana Nyasaye kende, to ok dhano! <verse eid="ACT 5:29"/><verse number="30" style="v" sid="ACT 5:30"/>Nyasach kwerewa nochiero Yesu oa kuom joma otho, en e Yesu mane unego ka uguro e msalaba. <verse eid="ACT 5:30"/><verse number="31" style="v" sid="ACT 5:31"/>Nyasaye notingʼe malo mokete e bade owuon ma korachwich, kaka Ruoth kendo Jawar, mondo omi jo-Israel olokre owe richogi. <verse eid="ACT 5:31"/><verse number="32" style="v" sid="ACT 5:32"/>Wan, kaachiel gi Roho Maler, ma Nyasaye miyo joma omiye luor wasebedo joneno kuom wechegi.”<verse eid="ACT 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33"/>Kane giwinjo wachni, mirima mager nomakogi, kendo negidwaro nego joote. <verse eid="ACT 5:33"/><verse number="34" style="v" sid="ACT 5:34"/>To ja-Farisai moro ma nyinge Gamaliel, mane en japuonj chik ma ji duto ogeno, nochungʼ e nyim buch Sanhedrin mi ogolo chik mondo ogol joote oko matin. <verse eid="ACT 5:34"/><verse number="35" style="v" sid="ACT 5:35"/>Bangʼe nowuoyonigi kama: “Jo-Israel, paruru matut kuom gima udwaro timo ni jogi. <verse eid="ACT 5:35"/><verse number="36" style="v" sid="ACT 5:36"/>Pok odeko ka Theuda nyocha osieko ka, kowacho ni en ngʼat moro malich, kendo kar ji mia angʼwen noluwe. Ne onege, kendo jolupne ne oke, mi wachno orumo kamano. <verse eid="ACT 5:36"/><verse number="37" style="v" sid="ACT 5:37"/>Bangʼe achien Judas ja-Galili nothinyore e kinde mane ikwanoe ji, mi notelo ni oganda moro matin mane kwedo loch. En bende ne onege, mi jolupne olal nono. <verse eid="ACT 5:37"/><verse number="38" style="v" sid="ACT 5:38"/>Kuom mano, weuru jogi mos! Gonygiuru gidhi! Nikech kapo ni chenrogi kata timbegigi oa kuom dhano, to ok gibi dhi nyime. <verse eid="ACT 5:38"/><verse number="39" style="v" sid="ACT 5:39"/>To ka oa kuom Nyasaye, to ok ubi nyalo gengʼogi, nono to dipo ka unwangʼo ni ukedo mana gi Nyasaye!”<verse eid="ACT 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40"/>Negirwako weche Gamaliel, omiyo negiluongo joote irgi mi gigolo chik mondo ochwadgi. Eka negisiemogi matek ni kik giwuo kuom nying Yesu, bangʼe ne giweyogi gidhi.<verse eid="ACT 5:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 5:41"/>Joote ne oa e nyim buch Sanhedrin kamor ahinya, nikech ne okwan-gi kaka joma oromo yudo sand nikech Nyingno. <verse eid="ACT 5:41"/><verse number="42" style="v" sid="ACT 5:42"/>Odiechiengʼ kodiechiengʼ ei agolni mag hekalu kendo ot ka ot ne ok gilingʼ ma ok gipuonjo kendo gihulo Injili ni Yesu e Kristo.<verse eid="ACT 5:42"/></para>
  <chapter eid="ACT 5"/>
  <chapter number="6" style="c" sid="ACT 6"/>
  <para style="s1">Oyier ji abiriyo mondo okony joote</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1"/>E kindeno kar kwan mar jopuonjre ne medore, omiyo jo-Yahudi mane wacho dho jo-Yunani nochako ngʼur gi jo-Yahudi wetegi mane wacho dho Hibrania. Jo-Yahudi mane wacho dho jo-Yunani ne ywak ni mon ma chwogi othogi ne ojwangʼ kaluwore gi kony mar chiemo mane ipogo mon ma chwogi otho. <verse eid="ACT 6:1"/><verse number="2" style="v" sid="ACT 6:2"/>Wachno nomiyo joote apar gariyo ochoko jopuonjre duto kanyakla, mi giwachonegi niya, “Ok ber mondo wajwangʼ tich mar yalo Wach Nyasaye mondo wapog chiemo. <verse eid="ACT 6:2"/><verse number="3" style="v" sid="ACT 6:3"/>Kuom mano, owetewa, yieruru ji abiriyo e dieru ka; joma ongʼere ni opongʼ gi Roho Maler kod rieko mondo waket tijni e lwetgi, <verse eid="ACT 6:3"/><verse number="4" style="v" sid="ACT 6:4"/>eka wan wachiwre chuth ni tijwa mar lamo gi yalo Wach Nyasaye.”<verse eid="ACT 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5"/>Paroni nomoro joma oyie kuom Kristo duto kanyakla, omiyo ne giyiero Stefano, ngʼat mopongʼ gi yie kendo gi Roho Maler, gi Filipo, kod Prokoro, gi Nikanor, gi Timon, gi Parmenas, kod Nikolao ja-Antiokia, ngʼat mane olokore oluwo din jo-Yahudi. <verse eid="ACT 6:5"/><verse number="6" style="v" sid="ACT 6:6"/>Negikelo jogi mi joote oyieyo lwetgi kuomgi kendo olamonegi.<verse eid="ACT 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7"/>Omiyo Wach Nyasaye nomedo landore, kendo kwan jopuonjre mane ni Jerusalem nomedore ahinya, kendo ji mangʼeny kuom jodolo nolokore moluwo yieno.<verse eid="ACT 6:7"/></para>
  <para style="s1">Omak Stefano</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8"/>To Stefano mane en ngʼat mopongʼ gi ngʼwono kod teko mar Nyasaye, notimo ranyisi madongo miwuoro kod honni e dier ji. <verse eid="ACT 6:8"/><verse number="9" style="v" sid="ACT 6:9"/>Kata kamano, jomoko nochako kedo kode. Jogi ne gin jokanyo mar oganda mane iluongo ni sinagogi mar wasumbini mogony. Ne gin jo-Yahudi modak Kurene, gi Aleksandria kod gwenge mag Kilikia kod Asia. Jogi nochako mino wach gi Stefano, <verse eid="ACT 6:9"/><verse number="10" style="v" sid="ACT 6:10"/>to ne ok ginyal loyo riekone kod teko mar Roho mane owuoyogo.<verse eid="ACT 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 6:11"/>Bangʼe ne gisemo jomoko lingʼ-lingʼ mondo owach niya, “Ne wawinjo Stefano kawacho weche mag ayany kuom Musa gi Nyasaye.”<verse eid="ACT 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 6:12"/>Omiyo negitugo mirimb ji kaachiel gi jodong oganda kod jopuonj chik. Negimako Stefano mi gikele e nyim buch Sanhedrin. <verse eid="ACT 6:12"/><verse number="13" style="v" sid="ACT 6:13"/>Eka negichiwo joneno mag miriambo, mane ojimbo wach kuome kawacho niya, “Ngʼatni osiko wuoyo marach kuom kama ler, kendo kuom Chik. <verse eid="ACT 6:13"/><verse number="14" style="v" sid="ACT 6:14"/>Nikech ne wawinje gi itwa kowacho ni Yesu ma ja-Nazarethni biro ketho hekaluni mi olok tim mane Musa omiyowa mondo waluw.”<verse eid="ACT 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 6:15"/>Ji duto mane obedo e buch Sanhedrin ne ngʼiyo Stefano ma wengegi ok diemre, kendo negineno ka lela wangʼe chal gi lend wangʼ malaika.<verse eid="ACT 6:15"/></para>
  <chapter eid="ACT 6"/>
  <chapter number="7" style="c" sid="ACT 7"/>
  <para style="s1">Stefano owuoyo ne buch Sanhedrin</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1"/>Bangʼe jadolo maduongʼ nopenjo Stefano niya, “Weche modonjnigogi bende gin adier?”<verse eid="ACT 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2"/>Stefano nodwoko niya, “Owetena kod wuonena, winjauru! Nyasaye man-gi duongʼ maber nofwenyore ni wuonwa Ibrahim kane pod odak e piny Mesopotamia, kane pok odar odhi odak Haran. <verse eid="ACT 7:2"/><verse number="3" style="v" sid="ACT 7:3"/>Nyasaye nowachone ni, ‘Dar iwe pinyu gi jou mondo idhi e piny ma abiro nyisi!’<note caller="+" style="f"><char style="fr" closed="false">7:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 12:1">Chak 12:1</ref></char></char></note><verse eid="ACT 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 7:4"/>“Omiyo Ibrahim nodar oweyo piny jo-Kaldea mi odhi odak e piny Haran. Bangʼ tho wuon-gi, Nyasaye nooro Ibrahim e piny makoro udakieni. <verse eid="ACT 7:4"/><verse number="5" style="v" sid="ACT 7:5"/>To ne ok omiye girkeni moro e pinyni, kata lowo matin moromo tielo nyono. Nyasaye nosingorene ni en kaachiel gi nyikwaye mane biro aa bangʼe ne biro kawo lopni, kata obedo ni Ibrahim ne onge gi nyathi e kindeno. <verse eid="ACT 7:5"/><verse number="6" style="v" sid="ACT 7:6"/>Nyasaye nowuoyo kode kawacho ni, ‘Nyikwayi nobed jodak e piny moro ma ok margi, kendo nolokgi wasumbini mi nosandgi malit kuom higni mia angʼwen. <verse eid="ACT 7:6"/><verse number="7" style="v" sid="ACT 7:7"/>To anakum piny ma noketgi wasumbini, bangʼe giniwuogi gia e pinyno mi gibi gilama kae.’<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 15:13">Chak 15:13</ref>,<ref loc="GEN 15:14">14</ref></char></char></note> <verse eid="ACT 7:7"/><verse number="8" style="v" sid="ACT 7:8"/>Bangʼe Nyasaye notimo gi Ibrahim singruok kowacho ni yawuowi nyaka ter nyangu. Kane Ibrahim onywolo wuode ma Isaka, notere nyangu bangʼ ndalo aboro kosenywole. Achien Isaka nonywolo Jakobo, kendo Jakobo bende nodoko wuon kwerewa apar gariyo.<verse eid="ACT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9"/>“Nikech kwerewago ne nyiego omako gi Josef, ne giuse kaka misumba ne jo-Misri. To nikech Nyasaye ne ni kode, <verse eid="ACT 7:9"/><verse number="10" style="v" sid="ACT 7:10"/>nokonye e chandruok duto mane oyudo. Ne omiyo Josef rieko ma kinde gi Farao ruodh Misri obedo maber. Omiyo Farao nokete jatelo maduongʼ morito piny Misri duto, nyaka od ruoth bende.<verse eid="ACT 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11"/>“Eka kech maduongʼ nomako piny Misri gi Kanaan kendo nokelo chandruok maduongʼ e piny ma kata kwerewa ne ok nyal yudo chiemo. <verse eid="ACT 7:11"/><verse number="12" style="v" sid="ACT 7:12"/>Kane Jakobo owinjo ni cham ne nitie Misri, nooro kwerewa kuno e ote mokwongo. <verse eid="ACT 7:12"/><verse number="13" style="v" sid="ACT 7:13"/>To e ote mar ariyo, Josef nohulore ni owetene, mi Farao koro nongʼeyo jo-dalagi Josef. <verse eid="ACT 7:13"/><verse number="14" style="v" sid="ACT 7:14"/>Bangʼ mano, Josef nooro wach mondo okelne Jakobo wuon mare kaachiel gi wedene duto, mane romo kar kwan ji piero abiriyo gabich. <verse eid="ACT 7:14"/><verse number="15" style="v" sid="ACT 7:15"/>Kuom mano Jakobo nodhi Misri, kuno ema kwerewa duto kaachiel gi en nothoe. <verse eid="ACT 7:15"/><verse number="16" style="v" sid="ACT 7:16"/>Ringregi ne okel nyaka Shekem mine oyikgi e bur ma Ibrahim nosengʼiewo kuom yawuot Hamor man Shekem.<verse eid="ACT 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17"/>“Kane ndalo ochopo mondo Nyasaye ochop singruok mane otimo ni Ibrahim, noyudo ka kar kwan jowa mane odak Misri ne osemedore. <verse eid="ACT 7:17"/><verse number="18" style="v" sid="ACT 7:18"/>Bangʼe ruoth manyien mane ok ongʼeyo wach Josef nobedo e loch e piny Misri.<note caller="+" style="f"><char style="fr" closed="false">7:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 1:8">Wuo 1:8</ref></char></char></note> <verse eid="ACT 7:18"/><verse number="19" style="v" sid="ACT 7:19"/>Ruodhno nowuondo jowa mosando kwereu malit, ka ochunogi mondo giwit nyithindgi oko mondo otho.<verse eid="ACT 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 7:20"/>“Kindeno ema nonywolie Musa, nyathi mane jaber e nyim Nyasaye kendo nopidhe e od wuon-gi kuom dweche adek. <verse eid="ACT 7:20"/><verse number="21" style="v" sid="ACT 7:21"/>To kane owite oko, nyar Farao ne okwanye mi opidhe mana kaka nyathine owuon. <verse eid="ACT 7:21"/><verse number="22" style="v" sid="ACT 7:22"/>Musa ne oyudo puonjruok e kit rieko duto mag jo-Misri, kendo ne en ratego e kit wuoyone kod timbene.<verse eid="ACT 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23"/>“Kane Musa koro ja-higni piero angʼwen, noparo e chunye mondo odhi olim owetene ma jo-Israel. <verse eid="ACT 7:23"/><verse number="24" style="v" sid="ACT 7:24"/>Noneno ka ja-Misri moro goyo ja-Israel wadgi, omiyo ne odhi okonye mi nogoyo ja-Misrino monego. <verse eid="ACT 7:24"/><verse number="25" style="v" sid="ACT 7:25"/>Musa ne oparo ni owetene ma jo-Israel ne nyalo neno ni Nyasaye ema notiyo kode mondo ogolgi e twech, to ne ok gineno kamano. <verse eid="ACT 7:25"/><verse number="26" style="v" sid="ACT 7:26"/>Kinyne Musa noyudo jo-Israel ariyo ka dhawo. Notemo thegogi kowachonegi ni, ‘Joka ma, un owete; angʼo momiyo udwaro hinyoru kayiem?’<verse eid="ACT 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 7:27"/>“To ngʼat mane sando nyawadgino nodhiro Musa gichien kowachone ni, ‘En ngʼa ma oketi ruoth kendo jangʼadnwa bura? <verse eid="ACT 7:27"/><verse number="28" style="v" sid="ACT 7:28"/>Iparo mar nega kaka nyoro inego ja-Misri cha?’<note caller="+" style="f"><char style="fr" closed="false">7:28 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 2:14">Wuo 2:14</ref></char></char></note> <verse eid="ACT 7:28"/><verse number="29" style="v" sid="ACT 7:29"/>Kane Musa owinjo wachno, noringo odhi Midian, kama nodakie kaka japiny moro mi onywolo yawuowi ariyo.<verse eid="ACT 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30"/>“Bangʼ higni piero angʼwen, malaika nofwenyore ni Musa ei ligek mach maliel e bungu manie thim but Got Sinai. <verse eid="ACT 7:30"/><verse number="31" style="v" sid="ACT 7:31"/>Kane Musa oneno mach malielno, nodoko maluor. Kane osudo machiegni mondo onene maber, nowinjo dwond Ruoth Nyasaye kawacho niya, <verse eid="ACT 7:31"/><verse number="32" style="v" sid="ACT 7:32"/>‘An e Nyasach kwereni; ma Nyasach Ibrahim gi Isaka kod Jakobo.’<note caller="+" style="f"><char style="fr" closed="false">7:32 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 3:6">Wuo 3:6</ref></char></char></note> Omiyo Musa notetni ka luoro omake, kendo ne ok ohedhore ngʼiyo bunguno kendo.<verse eid="ACT 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33"/>“Eka Ruoth Nyasaye nowachone niya, ‘Lony wuoche e tiendi, nikech kama ichungoeni en Kama Ler! <verse eid="ACT 7:33"/><verse number="34" style="v" sid="ACT 7:34"/>Aseneno gi wangʼa kaka joga chandore malit e piny Misri. Asewinjo kaka gichur omiyo asebiro mondo agonygi gibed thuolo; koro bi mondo aori idogi Misri!’<note caller="+" style="f"><char style="fr" closed="false">7:34 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 3:5">Wuo 3:5</ref>,<ref loc="EXO 3:7">7</ref>,<ref loc="EXO 3:8">8</ref>,<ref loc="EXO 3:10">10</ref></char></char></note><verse eid="ACT 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35"/>“Ma e Musa mane oyudo gisekwedo kagiwacho ni, ‘En ngʼa ma oketi ruoth kendo jangʼadnwa bura?’ Nyasaye owuon mane ofwenyorene e kit malaika mane oneno e bungu noore mondo obed jatendgi kendo jaresgi. <verse eid="ACT 7:35"/><verse number="36" style="v" sid="ACT 7:36"/>Ne otelonegi kogologi Misri, kendo notimo honni madongo gi ranyisi e piny Misri, e Nam Makwar, kendo timo honni mamoko bende e thim kuom higni piero angʼwen.<verse eid="ACT 7:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 7:37"/>“Ma e Musa mane onyiso jo-Israel ni, ‘Nyasaye noyiernu janabi machal koda kowuok e dier ogandau.’<note caller="+" style="f"><char style="fr" closed="false">7:37 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 18:15">Rap 18:15</ref></char></char></note> <verse eid="ACT 7:37"/><verse number="38" style="v" sid="ACT 7:38"/>En owuon ne en kodgi e chokruok mane ni e thim, kaachiel gi kwerewa kod malaika mane owuoyo kode e Got Sinai; kendo ne omiye weche mangima makoro wawinjogi.<verse eid="ACT 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39"/>“To kwerewa notamore winjo wachne. Kar timo mano, to ne gikwede kendo chunygi nogombo dok Misri. <verse eid="ACT 7:39"/><verse number="40" style="v" sid="ACT 7:40"/>Neginyiso Harun ni, ‘Losnwa nyiseche moko mondo otelnwa, nikech wakia gima osetimo Musa mane ogolowa Misri!’<note caller="+" style="f"><char style="fr" closed="false">7:40 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 32:1">Wuo 32:1</ref></char></char></note> <verse eid="ACT 7:40"/><verse number="41" style="v" sid="ACT 7:41"/>E kindeno ema ne gilosoe kido milamo machalo gi nyaroya. Negitimone misango, mi gilosone sawo ka gimiyo gima lwetgi ema ne oloso duongʼ! <verse eid="ACT 7:41"/><verse number="42" style="v" sid="ACT 7:42"/>To Nyasaye nogolo pache kuomgi moweyogi mondo gilam chwech mag polo kaka nyisechegi, mana kaka ondiki e kitap jonabi niya,</para>
  <para style="q1" vid="ACT 7:42">“ ‘Yaye jo-Israel, bende ne ukelona misengini kata chiwo moro amora</para>
  <para style="q2" vid="ACT 7:42">kuom higni piero angʼwen mane un e thim?<verse eid="ACT 7:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43"/>Ne utingʼo malo hemb Molek</para>
  <para style="q2" vid="ACT 7:43">kod sulwe mar nyasachu ma Refan ma gin,</para>
  <para style="q2" vid="ACT 7:43">nyiseche manono mane uloso mondo ulam.</para>
  <para style="q1" vid="ACT 7:43">Omiyo abiro darou mi ateru e piny twech mabor mayombo Babulon.’<note caller="+" style="f"><char style="fr" closed="false">7:43 </char><char style="ft" closed="false"><char style="xt"><ref loc="AMO 5:25-27">Amo 5:25-27</ref></char></char></note><verse eid="ACT 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44"/>“Kwereu ne ni kod Hema miluongo ni Hemb Rapar. Hemano nolosi mana kaka Nyasaye nonyiso Musa mondo olose, koluwo ranyisi mane omiye. <verse eid="ACT 7:44"/><verse number="45" style="v" sid="ACT 7:45"/>Kane kwerewa oyudo Hemani, ne gitingʼe ka Joshua otelonegi, nyaka negichopo kode e piny ogendini mane Nyasaye oseriembo mondo owenegi. Hemani ne gibedogo nyaka chop kinde mag Daudi. <verse eid="ACT 7:45"/><verse number="46" style="v" sid="ACT 7:46"/>Daudi noyudo ngʼwono e wangʼ Nyasaye, omiyo nokwayo mondo ogerne Nyasach Jakobo kar dak. <verse eid="ACT 7:46"/><verse number="47" style="v" sid="ACT 7:47"/>To Solomon ema ne ogero ne Nyasaye odno.<verse eid="ACT 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48"/>“Kata kamano, Nyasaye Man Malo Moloyo ok dagi e udi ma dhano ogero, mana kaka janabi owacho niya,<verse eid="ACT 7:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49"/>“ ‘Polo e koma mar duongʼ</para>
  <para style="q2" vid="ACT 7:49">to piny e raten tienda.</para>
  <para style="q1" vid="ACT 7:49">Koro en ot machal nade ma dugerna?</para>
  <para style="q2" vid="ACT 7:49">Ruoth Nyasaye owacho.</para>
  <para style="q2" vid="ACT 7:49">Koso kar yweyo mara nobed kanye?<verse eid="ACT 7:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50"/>Donge lweta ema osechweyo gigi duto?’<note caller="+" style="f"><char style="fr" closed="false">7:50 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 66:1">Isa 66:1</ref>,<ref loc="ISA 66:2">2</ref></char></char></note><verse eid="ACT 7:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51"/>“Un joma tokgi tek, chunyu bor gi Nyasaye kendo udagi winjo wachne! Uchal mana gi kwereu. Usiko utamo Roho Maler tiyo! <verse eid="ACT 7:51"/><verse number="52" style="v" sid="ACT 7:52"/>Bende nitie janabi kata achiel ma kwereu ne ok osando? Neginego nyaka jonabi mane okoro biro mar Ngʼama Kare. To koro usendhoge mi unege. <verse eid="ACT 7:52"/><verse number="53" style="v" sid="ACT 7:53"/>Un e joma noyudo chik mane okel gi malaike to usetamoru rito chikno.”<verse eid="ACT 7:53"/></para>
  <para style="s1">Ochiel Stefano gi kite</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54"/>Kane jobura owinjo weche mane Stefano owacho, igi nongʼondore mi gikayone lekegi. <verse eid="ACT 7:54"/><verse number="55" style="v" sid="ACT 7:55"/>To Stefano, kopongʼ gi Roho Maler, nongʼiyo malo e polo mi oneno duongʼ mar Nyasaye, kod Yesu kochungʼ e bad Nyasaye korachwich. <verse eid="ACT 7:55"/><verse number="56" style="v" sid="ACT 7:56"/>Nowachonegi niya, “Neuru, aneno polo koyawore kendo ka Wuod Dhano ochungʼ e bad Nyasaye korachwich.”<verse eid="ACT 7:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57"/>Kane giwinjo wachno, mirima nomakgi matek mi gimwomore kuome gi chuny achiel. <verse eid="ACT 7:57"/><verse number="58" style="v" sid="ACT 7:58"/>Ne giywaye mi gigole oko mar dala maduongʼ kendo gichako chiele gi kite. Joneno mag miriambo nohangone wach moketo lepgi e tiend wuowi moro ma nyinge Saulo.<verse eid="ACT 7:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="ACT 7:59"/>Kane oyudo gichiele gi kite, Stefano nolamo kowacho niya, “Ruoth Yesu, kaw chunya.” <verse eid="ACT 7:59"/><verse number="60" style="v" sid="ACT 7:60"/>Eka nogoyo chonge piny mokok matek niya, “Ruoth, kik ikwan richoni e wigi.” Kane osewacho kamano, to chunye nochot.<verse eid="ACT 7:60"/></para>
  <chapter eid="ACT 7"/>
  <chapter number="8" style="c" sid="ACT 8"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1"/>Saulo mane oyudo ni kanyo noyie gi nek mar Stefano.</para>
  <para style="s1" vid="ACT 8:1">Kanisa oyudo sand</para>
  <para style="p" vid="ACT 8:1">Kochakore chiengʼno kanisa man Jerusalem nochako yudo sand malit kendo giduto negiringo mi gikere e pinje mag Judea gi Samaria, makmana joote kende ema nodongʼ Jerusalem. <verse eid="ACT 8:1"/><verse number="2" style="v" sid="ACT 8:2"/>Joma oluoro Nyasaye noyiko Stefano kendo ne giywage malit. <verse eid="ACT 8:2"/><verse number="3" style="v" sid="ACT 8:3"/>E kindeno Saulo nochako sando kanisa kodonjo e ot ka ot kendo omako chwo gi mon moter e od twech.<verse eid="ACT 8:3"/></para>
  <para style="s1">Filipo odhi Samaria</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4"/>Joma noke e pinje maokogo noyalo Injili kamoro amora mane gidhiye. <verse eid="ACT 8:4"/><verse number="5" style="v" sid="ACT 8:5"/>Filipo nodhi nyaka e dala mar Samaria mi olando Wach Kristo kuno. <verse eid="ACT 8:5"/><verse number="6" style="v" sid="ACT 8:6"/>Kane oganda owinjo yalo mar Filipo, kendo kane gineno honni mane otimo, negimedo chiko itgi mondo giwinj wechene. <verse eid="ACT 8:6"/><verse number="7" style="v" sid="ACT 8:7"/>Jochiende nowuok kuom ji mangʼeny ka giywak malit, kendo jo-athany kod pudhe nochangi. <verse eid="ACT 8:7"/><verse number="8" style="v" sid="ACT 8:8"/>Omiyo dalano nopongʼ gi mor maduongʼ.<verse eid="ACT 8:8"/></para>
  <para style="s1">Simon gi timbene mag jwok</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9"/>Ne nitie ngʼat moro miluongo ni Simon. Ngʼatni nosebedo katimo timbe jwok e dala mar Samaria, kendo timbene nomako dho ji duto. Nosungore ni en ngʼama lich, <verse eid="ACT 8:9"/><verse number="10" style="v" sid="ACT 8:10"/>kendo jo-Samaria duto, jomatindo gi jomadongo, noyie kode. Negiluwo bangʼe ka gikok niya, “Ngʼatni nigi teko Nyasaye miluongo ni Teko Maduongʼ.” <verse eid="ACT 8:10"/><verse number="11" style="v" sid="ACT 8:11"/>Ji ne luwe nikech kinde mathoth nosemako dho ji gi timbene mag jwok. <verse eid="ACT 8:11"/><verse number="12" style="v" sid="ACT 8:12"/>To kane Filipo oyalo ne jogo Injili mar pinyruoth Nyasaye, kod nying Yesu Kristo, ne giyie, mi giyudo batiso giduto, chwo gi mon. <verse eid="ACT 8:12"/><verse number="13" style="v" sid="ACT 8:13"/>Simon owuon bende noyie, bangʼe noyudo batiso, kendo nosiko koluwo bangʼ Filipo kamoro amora mane odhiye, kowuoro ranyisi madongo kod honni ma noneno ka Filipo timo.<verse eid="ACT 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14"/>Kane joote man Jerusalem owinjo ni jo-Samaria noserwako wach Nyasaye, negioro Petro gi Johana irgi. <verse eid="ACT 8:14"/><verse number="15" style="v" sid="ACT 8:15"/>Kane gichopo, ne gilamonegi mondo giyud Roho Maler, <verse eid="ACT 8:15"/><verse number="16" style="v" sid="ACT 8:16"/>nikech Roho Maler ne pok obiro kuom ngʼato angʼata kuomgi, to nosebatisgi mana e nying Ruoth Yesu. <verse eid="ACT 8:16"/><verse number="17" style="v" sid="ACT 8:17"/>Bangʼe Petro gi Johana noyieyo lwetgi kuomgi mi giyudo Roho Maler.<verse eid="ACT 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18"/>Kane Simon oneno ni ji ne yudo Roho Maler ka joote oyieyo lwetgi kuomgi, nomiyogi pesa kowacho niya, <verse eid="ACT 8:18"/><verse number="19" style="v" sid="ACT 8:19"/>“An bende miyaeuru teko ma un-goni mondo ngʼato angʼata ma ayieyo lweta kuome oyud Roho Maler.”<verse eid="ACT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20"/>To Petro nodwoke niya, “Mad pesagigo lal kodi nono, nikech chunyi wuondi ni inyalo ngʼiewo mich Nyasaye gi pesa! <verse eid="ACT 8:20"/><verse number="21" style="v" sid="ACT 8:21"/>Ionge gi migawo moro amora e tijwani, kendo kwan-ni onge e iye, nikech chunyi ok nikare e nyim Nyasaye. <verse eid="ACT 8:21"/><verse number="22" style="v" sid="ACT 8:22"/>Omiyo lokri iwe timni marachni, kendo ilam Ruoth Nyasaye, dipo ka oweyoni richoni kuom bedo gi paro marachno e chunyi. <verse eid="ACT 8:22"/><verse number="23" style="v" sid="ACT 8:23"/>Nikech aneno ka chunyi opongʼ gi nyiego mangʼeny, kendo richo oloki misumbane chuth.”<verse eid="ACT 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24"/>Eka Simon nodwoko niya, “Lamna Ruoth Nyasaye mondo gima rach misewacho kuomano kik timrena.”<verse eid="ACT 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25"/>Kane gisetimo neno kendo yalo wach Ruoth, Petro gi Johana nodok Jerusalem, ka giyalo Injili e miech Samaria mangʼeny.<verse eid="ACT 8:25"/></para>
  <para style="s1">Filipo gi ja-Ethiopia</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26"/>Malaika mar Ruoth nowacho ni Filipo niya, “Koro aa malo idhi yo milambo, kiluwo yo mongʼado i thim moa Jerusalem kadhi Gaza.” <verse eid="ACT 8:26"/><verse number="27" style="v" sid="ACT 8:27"/>Kuom mano, Filipo nochako wuoth, to kane oyudo odhi, noromo gi ja-Ethiopia mabwoch, mane en jatelo maduongʼ morito mwandu duto mag Kandake, “ruoth ma dhako mar jo-Ethiopia.” Ngʼatni noa lemo Jerusalem, <verse eid="ACT 8:27"/><verse number="28" style="v" sid="ACT 8:28"/>kendo koro nodok dala, koidho gache kendo kosomo kitap Janabi Isaya. <verse eid="ACT 8:28"/><verse number="29" style="v" sid="ACT 8:29"/>Roho Maler nowacho ni Filipo niya, “Dhiyo mondo ichungʼ machiegni gi gari cha.”<verse eid="ACT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 8:30"/>Eka Filipo noringo odhi nyaka but garino mi owinjo ka ngʼatno somo kitap Janabi Isaya. Filipo nopenje niya, “Bende iwinjo tiend gima isomono?”<verse eid="ACT 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31"/>Ja-Ethiopia nodwoko Filipo niya, “Ere kaka dawinj tiende kaonge ngʼama olerona tiende?” Omiyo norwako Filipo mondo oidh obed kode ei gari.<verse eid="ACT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 8:32"/>Kama noyudo ngʼatno somo ndiko kama wacho ni:</para>
  <para style="q1" vid="ACT 8:32">“Notere kar thone mana ka rombo mitero kar yengʼo,</para>
  <para style="q2" vid="ACT 8:32">kendo nolingʼ ka nyarombo manie lwet ngʼama ngʼado yiere,</para>
  <para style="q2" vid="ACT 8:32">omiyo en bende ne ok otingʼo dhoge.<verse eid="ACT 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33"/>Ne oyale angʼaya kimiye wichkuot.</para>
  <para style="q2" vid="ACT 8:33">Bende en gi kothe ma ji noparego?</para>
  <para style="q2" vid="ACT 8:33">Nikech ngimane nogol oko e piny.”<note caller="+" style="f"><char style="fr" closed="false">8:33 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:7">Isa 53:7</ref>,<ref loc="ISA 53:8">8</ref></char></char></note><verse eid="ACT 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34"/>Jatelono nopenjo Filipo niya, “Yie inyisae ni Janabi wuoyo kuom ngʼa e Ndikoni? Owuoyo kuome owuon, koso owuoyo kuom ngʼat machielo?” <verse eid="ACT 8:34"/><verse number="35" style="v" sid="ACT 8:35"/>Eka Filipo nochako gi Ndiko kama ne ja-Ethiopiano somo, mi odhi nyime gi yalone Injili mar Yesu.<verse eid="ACT 8:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 8:36"/>Kane gimedo dhi nyime, negichopo kama pi moro ne nitie. Ja-Ethiopia nowachone Filipo niya, “Pi eri, angʼo ma dimona yudo batiso?”</para>
  <para style="p" vid="ACT 8:36">[<verse eid="ACT 8:36"/><verse number="37" style="v" sid="ACT 8:37"/>Filipo nodwoke niya, “Inyalo yudo batiso, kiyie gi chunyi duto.”</para>
  <para style="p" vid="ACT 8:37">Nodwoke niya, “Ee, ayie ni Yesu Kristo en Wuod Nyasaye.”]<note caller="+" style="f"><char style="fr" closed="false">8:37 </char><char style="ft" closed="false">Loko moko machon mag Muma onge gi <char style="xt"><ref loc="ACT 8:37">Joo 8:37</ref></char>.</char></note> <verse eid="ACT 8:37"/><verse number="38" style="v" sid="ACT 8:38"/>Omiyo nochiwo chik mondo gari ochungʼ. Eka ne gilor gidhi e pi mi Filipo nobatise. <verse eid="ACT 8:38"/><verse number="39" style="v" sid="ACT 8:39"/>To kane giwuok e pi, Roho Maler mar Ruoth Nyasaye nokawo Filipo apoya, mi ja-Ethiopiano ne ok ochako onene kendo to nodhi e wuodhe kopongʼ gi mor. <verse eid="ACT 8:39"/><verse number="40" style="v" sid="ACT 8:40"/>Filipo nopo kochopo e dala mar Azoto, kendo nowuotho koni gi koni, koyalo Injili e mier duto nyaka nochopo Kaisaria.<verse eid="ACT 8:40"/></para>
  <chapter eid="ACT 8"/>
  <chapter number="9" style="c" sid="ACT 9"/>
  <para style="s1">Saulo olokore oyie kuom Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1"/>Kindeno Saulo ne pod siemo jopuonjre mag Ruoth, kochano mar negogi. Nodhi ir jadolo maduongʼ <verse eid="ACT 9:1"/><verse number="2" style="v" sid="ACT 9:2"/>mokwaye barupe mane nyalo miye teko mar donjo e sinagoke man Damaski, mondo ka oyudo joma luwo Yor Kristo, bed ni gin chwo kata mon, to omakgi otergi Jerusalem kaka joma otwe. <verse eid="ACT 9:2"/><verse number="3" style="v" sid="ACT 9:3"/>Kane oyudo owuotho ka ochiegni chopo Damaski, nopo ka ler moa e polo omenye molwore. <verse eid="ACT 9:3"/><verse number="4" style="v" sid="ACT 9:4"/>Nogore piny, mi owinjo dwol moro kawachone niya, <char style="wj">“Saulo, Saulo, isanda nangʼo?”</char><verse eid="ACT 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5"/>Saulo nopenjo niya, “In ngʼa, Ruoth?”</para>
  <para style="p" vid="ACT 9:5">Nodwoke niya, <char style="wj">“An Yesu ma isando.</char> <verse eid="ACT 9:5"/><verse number="6" style="v" sid="ACT 9:6"/><char style="wj">Koro aa malo idhi Damaski kendo ibiro nyisi gima nyaka itim.”</char><verse eid="ACT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7"/>Jogo mane ni e wuoth gi Saulo nochungʼ kanyo ka dhogi omoko; nikech ne giwinjo dwol to ok gine ngʼato. <verse eid="ACT 9:7"/><verse number="8" style="v" sid="ACT 9:8"/>Saulo nochungʼ oa malo, to kane oyawo wengene, to ne ok onyal neno gimoro. Omiyo negimako bade kagitaye gitere Damaski. <verse eid="ACT 9:8"/><verse number="9" style="v" sid="ACT 9:9"/>Nobedo muofu kuom ndalo adek, kendo ne ok ochiemo kata madho gimoro.<verse eid="ACT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10"/>Damaski kanyo ne nitie japuonjre moro miluongo ni Anania. Ruoth nowuoyo kode e fweny, kaluonge niya, <char style="wj">“Anania!”</char></para>
  <para style="p" vid="ACT 9:10">Nodwoko niya, “Antie, Ruoth.”<verse eid="ACT 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11"/>Ruoth nowachone niya, <char style="wj">“Wuogi idhi e od Judas, mantiere kama iluongo ni Yo Moriere Tir, mondo ipenjgi ngʼat moro ma ja-Tarso, miluongo ni Saulo nimar olemo kuno.</char> <verse eid="ACT 9:11"/><verse number="12" style="v" sid="ACT 9:12"/><char style="wj">Noneno ngʼat moro miluongo ni Anania e fweny ka obiro kendo noyieyo lwete kuome mondo ochak onen.”</char><verse eid="ACT 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13"/>To Anania nodwoko niya, “Ruoth, asewinjo weche mangʼeny kuom ngʼatno, gi timbene maricho mosebedo kotimo ni jogi maler modak Jerusalem. <verse eid="ACT 9:13"/><verse number="14" style="v" sid="ACT 9:14"/>Kendo Damaski bende osebire ka jodolo madongo omiye teko mar mako ji duto maluongo nyingi.”<verse eid="ACT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15"/>To Ruoth nowachone Anania niya, <char style="wj">“Dhiyo! Ngʼatni en gir tichna ma aseyiero mondo oter nyinga e dier joma ok jo-Yahudi ma ok jo-Yahudi kaachiel gi ruodhigi; kendo e dier jo-Israel.</char> <verse eid="ACT 9:15"/><verse number="16" style="v" sid="ACT 9:16"/><char style="wj">Abiro nyise masiche duto monego one nikech nyinga.”</char><verse eid="ACT 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17"/>Eka Anania nodhi e odno modonjo nyaka e iye. Noyieyo lwete kuom Saulo kowachone niya, “Owadwa Saulo, Ruoth, ma en Yesu manyocha ofwenyoreni ka in e yo ibiro ka, oseora iri mondo ichak inen kendo mondo ipongʼ gi Roho Maler.” <verse eid="ACT 9:17"/><verse number="18" style="v" sid="ACT 9:18"/>Gikanyono gima chalo gi ololo nolwar oa e wenge Saulo mi koro nonyalo neno. Noa malo mi nobatise, <verse eid="ACT 9:18"/><verse number="19" style="v" sid="ACT 9:19"/>kendo kane osechiemo matin, to tekone noduogo.</para>
  <para style="s1" vid="ACT 9:19">Saulo oyalo Injili Damaski gi Jerusalem</para>
  <para style="p" vid="ACT 9:19">Saulo nodak gi jopuonjre Damaski kuom ndalo mogwarore, <verse eid="ACT 9:19"/><verse number="20" style="v" sid="ACT 9:20"/>kendo bangʼ mano nochako yalo Injili e sinagoke, kowacho ni Yesu en Wuod Nyasaye. <verse eid="ACT 9:20"/><verse number="21" style="v" sid="ACT 9:21"/>Ji duto mane owinje nowuoro ka gipenjore niya, “Donge ma e ngʼat mane sando joma ne luongo Nying Yesu Jerusalem? Donge osebiro ka mana mondo okawgi kaka joma otwe mondo otergi ni Jodolo madongo?” <verse eid="ACT 9:21"/><verse number="22" style="v" sid="ACT 9:22"/>Kata kamano, Saulo nomedo gerore kuom yie kendo nomedo bedo gi teko mangʼeny, kendo twak mane ochiwo konyisogo ni Yesu e Kristo nodhiero jo-Yahudi mane odak Damaski.<verse eid="ACT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23"/>Bangʼ ndalo mangʼeny, jo-Yahudi nochano mondo oneg Saulo, <verse eid="ACT 9:23"/><verse number="24" style="v" sid="ACT 9:24"/>to Saulo nofwenyo wachno. Odiechiengʼ gotieno ne gibutone e rangeye mag dala maduongʼ mondo gimake apoya ginege, <verse eid="ACT 9:24"/><verse number="25" style="v" sid="ACT 9:25"/>to jolupne nokawe mokete e okapu, eka gilore piny kokalo e otuchi moro manie kor ohinga mar dala.<verse eid="ACT 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26"/>Kane obiro Jerusalem, notemo mondo odonji e kanyakla mar jopuonjre, to giduto ne giluore, nikech ne gichich kode ni sa moro pok nolokore adier. <verse eid="ACT 9:26"/><verse number="27" style="v" sid="ACT 9:27"/>To Barnaba nokawe motere ir joote. Nonyisogi kaka Saulo noseromo gi Ruoth kane oyudo en e wuodhe, kaka Ruoth nosewuoyo kode, kendo kaka Saulo noseyalo gi chir kuom nying Yesu e Damaski. <verse eid="ACT 9:27"/><verse number="28" style="v" sid="ACT 9:28"/>Kuom mano, Saulo nodak kodgi, kowuotho ei Jerusalem koni gi koni maonge ngʼama gengʼe, kendo kowuoyo gi chir kuom nying Ruoth. <verse eid="ACT 9:28"/><verse number="29" style="v" sid="ACT 9:29"/>Nowuoyo kendo nogoyo mbaka gi jo-Yahudi moluwo timbe jo-Yunani, to jogo notemo nege. <verse eid="ACT 9:29"/><verse number="30" style="v" sid="ACT 9:30"/>To kane jowete ofwenyo wachni, ne gigole kanyo mi gidhi kode nyaka Kaisaria, bangʼe giore nyaka Tarso.<verse eid="ACT 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31"/>Bangʼ lokruok Saulo, kanisa man Judea gi Galili kod Samaria nobedo gi kwe maonge luoro. Roho Maler nokonyogi, mi gibedo motegno kendo kwan joma oyie kuom Kristo nomedore pile. Joma oyie kuom Kristo nodak koluoro Ruoth Nyasaye.<verse eid="ACT 9:31"/></para>
  <para style="s1">Ainea gi Dorka</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32"/>Kane Petro wuotho ei piny koni gi koni, nodhi limo jomaler mane odak Lida. <verse eid="ACT 9:32"/><verse number="33" style="v" sid="ACT 9:33"/>Kuno nonwangʼoe ngʼat moro miluongo ni Ainea, mane osebedo kosiko onindo e kitandane kuom higni aboro, ka tuo mar athany onure. <verse eid="ACT 9:33"/><verse number="34" style="v" sid="ACT 9:34"/>Petro nowachone niya, “Ainea, Yesu Kristo osechangi; aa malo iban pieni.” Ainea noa malo mana gisano. <verse eid="ACT 9:34"/><verse number="35" style="v" sid="ACT 9:35"/>Ji duto mane odak Lida gi Sharon nonene moyie kuom Ruoth.<verse eid="ACT 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36"/>E dala mar Jopa ne nitie japuonjre moro miluongo ni Tabitha (ma dho jo-Yunani luongo bi Dorka tiende ni Nyakech) mane osiko katimo maber ni ji kendo nokonyo joma odhier. <verse eid="ACT 9:36"/><verse number="37" style="v" sid="ACT 9:37"/>E kindeno tuo nogoye mi otho, kendo noluok ringre bangʼe okete e ot man malo ewi gorofa. <verse eid="ACT 9:37"/><verse number="38" style="v" sid="ACT 9:38"/>Lida ne chiegni gi Jopa, omiyo ka jopuonjre nowinjo ni Petro ni kuno, ne giorone ji ariyo, ka gikwaye niya, “Yie ibi irwa piyo ma ok odeko!”<verse eid="ACT 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 9:39"/>Petro nodhi kodgi, kendo kane ochopo to ne gitere nyaka ei ot man malo e gorofa kama ne ringre Tabitha nitie. Mon duto ma chwogi otho mane ni kanyo nochungʼ olwore, ka giywak kendo ginyise lep kandho kod lewni mamoko mane Dorka otwangʼo kapod ongima.<verse eid="ACT 9:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 9:40"/>Petro nogologi oko duto, bangʼe nogoyo chonge piny molamo. Eka nowichore mochomo dhako mothono, kowacho niya, “Tabitha, aa malo!” Dhakono noyawo wengene, kendo kane oneno Petro, to nobet piny. <verse eid="ACT 9:40"/><verse number="41" style="v" sid="ACT 9:41"/>Petro nomako bade mi okonye chungʼ gi tiende. Bangʼe noluongo jopuonjre kod mon ma chwogi otho mane ni oko mi omiyogi Tabitha kangima. <verse eid="ACT 9:41"/><verse number="42" style="v" sid="ACT 9:42"/>Wachni nolandore e Jopa duto, mi ji mangʼeny noyie kuom Ruoth. <verse eid="ACT 9:42"/><verse number="43" style="v" sid="ACT 9:43"/>Petro nomedo dak Jopa e od janyongʼ piende moro miluongo ni Simon kuom kinde mogwarore.<verse eid="ACT 9:43"/></para>
  <chapter eid="ACT 9"/>
  <chapter number="10" style="c" sid="ACT 10"/>
  <para style="s1">Kornelio oluongo Petro</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1"/>Ne nitie jatend jolweny moro e dala mar Kaisaria mane nyinge Kornelio. Ngʼatni norito oganda lweny moro mar jo-Rumi miluongo ni Oganda Italia. <verse eid="ACT 10:1"/><verse number="2" style="v" sid="ACT 10:2"/>En kaachiel gi joode duto ne gin joma odimbore kendo moluoro Nyasaye. Ne okonyo joma odhier kendo olamo Nyasaye pile. <verse eid="ACT 10:2"/><verse number="3" style="v" sid="ACT 10:3"/>Chiengʼ moro achiel noneno fweny kar sa ochiko odhiambo. E fwenyno noneno malaika mar Nyasaye, mane obiro ire moluonge niya, “Kornelio!”<verse eid="ACT 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4"/>Kornelio nongʼiyo malaikano ka luoro omake, eka noyiene niya, “Iwacho nangʼo, Ruoth?”</para>
  <para style="p" vid="ACT 10:4">Malaika nodwoke niya, “Lemoni kod timbeni mag ngʼwono mikonyogo joma odhier osechopo e nyim Nyasaye kaka misango omiyo osepari. <verse eid="ACT 10:4"/><verse number="5" style="v" sid="ACT 10:5"/>Koro or jomoko Jopa mondo odhi oom ngʼat moro ma nyinge Simon, miluongo ni Petro. <verse eid="ACT 10:5"/><verse number="6" style="v" sid="ACT 10:6"/>En wendo Simon ma janyongʼ piende ma ode ni e dho nam.”<verse eid="ACT 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7"/>Kane malaika mane wuoyo kodeno osedhi, Kornelio noluongo jotichne ariyo kod achiel kuom jolweny modimbore ma en achiel kuom jomane rite. <verse eid="ACT 10:7"/><verse number="8" style="v" sid="ACT 10:8"/>Nonyisogi gik moko duto mane osetimore, eka noorogi nyaka Jopa.<verse eid="ACT 10:8"/></para>
  <para style="s1">Petro oneno fweny</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9"/>Kinyne kar odiechiengʼ tir, kane jootego chiegni chopo e dala mar Jopa, Petro noidho malo ewi tado mondo olem. <verse eid="ACT 10:9"/><verse number="10" style="v" sid="ACT 10:10"/>Kech ne kaye kendo nogombo chiemo mondo ocham, to kane pod iloso chiemo, ayula wangʼ notere. <verse eid="ACT 10:10"/><verse number="11" style="v" sid="ACT 10:11"/>Noneno polo koyawore, kendo ka gimoro machalo gi suka malach moyar iloro piny ka omake gi kondene angʼwen. <verse eid="ACT 10:11"/><verse number="12" style="v" sid="ACT 10:12"/>Sukano notingʼo kit le man-gi tiende angʼwen duto, kod le mamol duto mag piny kod koth winy duto mafuyo e kor polo. <verse eid="ACT 10:12"/><verse number="13" style="v" sid="ACT 10:13"/>Eka nowinjo dwol moro kawachone niya, <char style="wj">“Petro, aa malo, mondo ineg gimoro kuom gigo icham.”</char><verse eid="ACT 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14"/>Petro nodwoko niya, “Ooyo Ruoth! Ne pok achamo gimoro amora makwero kata mochido nyaka nene.”<verse eid="ACT 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15"/>Eka dwolno nowuoyo kode kendo mar ariyo niya, <char style="wj">“Kik iluong gimoro amora ma Nyasaye osepwodho ni ok ler.”</char><verse eid="ACT 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 10:16"/>Gima kama notimore nyadidek eka sukano nokaw mana gisano moter e polo.<verse eid="ACT 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17"/>Kane Petro pod wuoro kuom tiend fweny mane onenono, joote mane Kornelio ooro nochopo e od Simon, mochungʼ e dhorangach oko. <verse eid="ACT 10:17"/><verse number="18" style="v" sid="ACT 10:18"/>Negipenjo ka Simon miluongo ni Petro nodak kanyo.<verse eid="ACT 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19"/>Kane Petro pod paro kuom fweny mane oneno, Roho Maler nowachone niya, “Simon, welo moko adek dwari. <verse eid="ACT 10:19"/><verse number="20" style="v" sid="ACT 10:20"/>Omiyo aa malo ilor piny irgi. Kik ideki ma ok idhi kodgi nikech an ema aorogi.”<verse eid="ACT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 10:21"/>Petro nolor piny ir jogo monyisogi niya, “An e ngʼat mudwaro. Ere wach ma un-go?”<verse eid="ACT 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22"/>Negidwoke niya, “Oorwa gi jatend jolweny moro miluongo ni Kornelio. En ngʼat makare moluoro Nyasaye, kendo ma jo-Yahudi duto omiyo luor. Malaika maler nonyise mondo oluongi idhi ire e ode mondo owinj gima inyalo wachone.” <verse eid="ACT 10:22"/><verse number="23" style="v" sid="ACT 10:23"/>Eka Petro norwako jootego kaka wende.</para>
  <para style="s1" vid="ACT 10:23">Petro e od Kornelio</para>
  <para style="p" vid="ACT 10:23">Kinyne Petro nowuok gi jootego, kendo jowete moko moa Jopa bende nodhi kodgi. <verse eid="ACT 10:23"/><verse number="24" style="v" sid="ACT 10:24"/>Odiechiengʼ moluwo mano negichopo Kaisaria, kuma Kornelio ne jorite kaachiel gi wedene kod osiepene mane oluongo. <verse eid="ACT 10:24"/><verse number="25" style="v" sid="ACT 10:25"/>Kane Petro odonjo e ot, Kornelio noromone mi opodho e tiende kamiye duongʼ. <verse eid="ACT 10:25"/><verse number="26" style="v" sid="ACT 10:26"/>To Petro nowachone niya, “Aa malo, an mana dhano kaka in.”<verse eid="ACT 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 10:27"/>Petro nowuotho kochomo ot kod Kornelio, ka giwuoyo, to kane ochopo ei ot, nonwangʼo ka ji mangʼeny ochokore rite. <verse eid="ACT 10:27"/><verse number="28" style="v" sid="ACT 10:28"/>Nowachonegi niya, “Ungʼeyo maber ni chikwa ok oyie mondo ja-Yahudi obed e achiel kata mondo olim ngʼat moro ma ok ja-Yahudi. To Nyasaye osenyisa ni kik aluong ngʼato ni ogak kata ni ok ler. <verse eid="ACT 10:28"/><verse number="29" style="v" sid="ACT 10:29"/>Emomiyo, kane uluonga to abiro ma ok adagi. To koro nyisaneuru, en angʼo momiyo ne uluonga?”<verse eid="ACT 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30"/>Kornelio nodwoke niya, “Ndalo angʼwen mosekalo ne oyudo alamo Nyasaye e oda kar sa ochiko odhiambo. To napo ka ngʼat moro morwako lewni marieny ochungʼ buta mowachona niya, <verse eid="ACT 10:30"/><verse number="31" style="v" sid="ACT 10:31"/>‘Kornelio, lemoni kod timbene mag ngʼwono mikonyogo joma odhier osechopo e nyim Nyasaye, omiyo osepari. <verse eid="ACT 10:31"/><verse number="32" style="v" sid="ACT 10:32"/>Koro or jomoko Jopa mondo oomni Simon miluongo ni Petro. En wendo e od Simon ma janyongʼ piende, modak e dho nam.’ <verse eid="ACT 10:32"/><verse number="33" style="v" sid="ACT 10:33"/>Emomiyo ne aoroni wach piyo piyo mondo ibi, kendo isetimo maber kuom biro. Koro eri wan ka waduto e nyim Nyasaye, mondo wawinji weche duto ma Ruoth osechiki mondo inyiswa.”<verse eid="ACT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34"/>Eka Petro nochako wuoyo kowacho niya, “Sani koro ayie adier ni Nyasaye chiwo ni ji duto mana machalre ka ok odewo wangʼ ngʼato, <verse eid="ACT 10:34"/><verse number="35" style="v" sid="ACT 10:35"/>to orwako japiny moro amora moluore kendo timo dwarone, ma ok odewo oganda moaye! <verse eid="ACT 10:35"/><verse number="36" style="v" sid="ACT 10:36"/>Ungʼeyo ni ma e wach mane Nyasaye ooro ni jo-Israel, konyisogi Injili mar kwe kuom Yesu Kristo, ma en Ruodh ji duto. <verse eid="ACT 10:36"/><verse number="37" style="v" sid="ACT 10:37"/>Ungʼeyo gima osetimore e piny Judea duto, kochakore Galili, bangʼ batiso mane Johana oyalo; <verse eid="ACT 10:37"/><verse number="38" style="v" sid="ACT 10:38"/>kaka Nyasaye nowiro Yesu ja-Nazareth gi Roho Maler kod teko, kendo kaka nowuotho koni gi koni kotimo maber kendo kochango ji duto mane ni e bwo loch mar Satan, nikech Nyasaye ne ni kode.<verse eid="ACT 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 10:39"/>“Wan joneno kuom gik moko duto mane otimo e piny jo-Yahudi kendo ei Jerusalem. Neginege ka gigure e msalaba, <verse eid="ACT 10:39"/><verse number="40" style="v" sid="ACT 10:40"/>to Nyasaye nochiere oa kuom joma otho chiengʼ mar adek, momiyo onene. <verse eid="ACT 10:40"/><verse number="41" style="v" sid="ACT 10:41"/>Bangʼ kane osechier oa kuom joma otho, ne ok onene gi ji duto, makmana joneno ma Nyasaye noseyiero, ma gin wan mane wachiemo kendo wametho kode. <verse eid="ACT 10:41"/><verse number="42" style="v" sid="ACT 10:42"/>Nochikowa mondo wayal ni ji kendo mondo watim nende ni en ema Nyasaye oseyiere kaka jangʼad bura mar joma ngima gi joma otho. <verse eid="ACT 10:42"/><verse number="43" style="v" sid="ACT 10:43"/>Jonabi duto owuoyo kuome ni ngʼato angʼata moyie kuome yudo weruok mar richo e nyinge.”<verse eid="ACT 10:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44"/>Kane Petro pod wacho wechegi, Roho Maler nolor kuom ji duto mane oyudo winjo wachne. <verse eid="ACT 10:44"/><verse number="45" style="v" sid="ACT 10:45"/>Joma oyie kuom Kristo ma jo-Yahudi, mane obiro gi Petro, nowuoro ka Roho Maler nobiro nyaka kuom joma ok jo-Yahudi, <verse eid="ACT 10:45"/><verse number="46" style="v" sid="ACT 10:46"/>nikech ne giwinjogi ka giwuoyo gi dhok mayoreyore kendo ka gipako Nyasaye.</para>
  <para style="p" vid="ACT 10:46">Eka Petro nowuoyo kawacho niya, <verse eid="ACT 10:46"/><verse number="47" style="v" sid="ACT 10:47"/>“Ere ngʼama koro digengʼ jogi mondo kik obatisgi gi pi, ka gin bende giseyudo Roho Maler mana kaka waseyude?” <verse eid="ACT 10:47"/><verse number="48" style="v" sid="ACT 10:48"/>Kuom mano, nogolo chik mondo obatisgi e nying Yesu Kristo. Bangʼ mano ne gikwayo Petro mondo omed bet kodgi kuom ndalo moko.<verse eid="ACT 10:48"/></para>
  <chapter eid="ACT 10"/>
  <chapter number="11" style="c" sid="ACT 11"/>
  <para style="s1">Petro olero kit tije ne kanyakla mar joma oyie man Jerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1"/>Joote kod owete modak Judea duto nowinjo ni joma ok jo-Yahudi bende noserwako Wach Nyasaye. <verse eid="ACT 11:1"/><verse number="2" style="v" sid="ACT 11:2"/>Omiyo kane Petro odhi Jerusalem, to joma oyie kuom Kristo ma jo-Yahudi nokwere <verse eid="ACT 11:2"/><verse number="3" style="v" sid="ACT 11:3"/>kawacho niya, “Donge ne idhi e od joma ok jo-Yahudi mi ichiemo kodgi.”<verse eid="ACT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4"/>To Petro nochako leronegi tiend gik moko duto mane osetimore, e yo mawinjore maler, kowacho niya, <verse eid="ACT 11:4"/><verse number="5" style="v" sid="ACT 11:5"/>“Ne antiere e dala mar Jopa ka alemo, to ka ayula wangʼ notera, ne aneno fweny. Ne aneno gima chalo suka malach kiloro piny koa e polo, komak kondene angʼwen. Nolor sukano nyaka kama ne antie. <verse eid="ACT 11:5"/><verse number="6" style="v" sid="ACT 11:6"/>Ne angʼiyo iye mi aneno kit le mopidhi man-gi tiende angʼwen manie piny, gi le mager mag bungu, kod le mamol, gi winy mafuyo e kor polo. <verse eid="ACT 11:6"/><verse number="7" style="v" sid="ACT 11:7"/>Bangʼe nawinjo dwol moro kawachona ni, <char style="wj">‘Petro, aa malo, mondo ineg gimoro kuom gigo icham.’</char><verse eid="ACT 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 11:8"/>“An to ne adwoko ni, ‘Ooyo Ruoth! Onge gima kwero kata mochido mosedonjo e dhogani nyaka nene.’<verse eid="ACT 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 11:9"/>“Dwolno moa e polo nowuoyo koda kendo nyadiriyo kawachona ni, <char style="wj">‘Kik iluong gimoro amora ma Nyasaye osepwodho ni ok ler.’</char> <verse eid="ACT 11:9"/><verse number="10" style="v" sid="ACT 11:10"/>Gima kamano notimore nyadidek, eka sukano nokaw modwoki e polo kendo.<verse eid="ACT 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 11:11"/>“E sa nogo ji adek mane oor ira koa Kaisaria nobiro mochopo e ot mane antie. <verse eid="ACT 11:11"/><verse number="12" style="v" sid="ACT 11:12"/>Roho Maler nonyisa ni kik adeki ma ok adhi kodgi. Jowete auchielgi bende nodhi koda, mine wadonjo e od Kornelio. <verse eid="ACT 11:12"/><verse number="13" style="v" sid="ACT 11:13"/>Nonyisowa kaka ne oseneno malaika kofwenyore e ode mowachone ni, ‘Or jomoko Jopa mondo oluongni Simon miluongo ni Petro. <verse eid="ACT 11:13"/><verse number="14" style="v" sid="ACT 11:14"/>Obiro keloni wach mabiro miyo iyud warruok, in kaachiel gi joodi duto.’<verse eid="ACT 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15"/>“To e sa ma ne achako wuoyo, ema Roho Maler nolor kuomgi, mana kaka wan bende noselor kuomwa mokwongo. <verse eid="ACT 11:15"/><verse number="16" style="v" sid="ACT 11:16"/>Eka naparo kaka Ruoth nosewacho motelo ni, <char style="wj">‘Johana nobatiso ji gi pi, to un ibiro batisou gi Roho Maler.’</char> <verse eid="ACT 11:16"/><verse number="17" style="v" sid="ACT 11:17"/>Emomiyo ka Nyasaye nomiyogi mana mich achielno ma wan bende nomiyowa kane wayie kuom Ruoth Yesu Kristo, koro an to an ngʼa ma dine agengʼ tich Nyasaye!”<verse eid="ACT 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18"/>Kane giwinjo wachno, ne giweyo Petro mos mi gipako Nyasaye, kagiwacho niya, “Kara en adier ni Nyasaye osemiyo joma ok jo-Yahudi thuolo mondo gin bende gilokre giyud ngima.”<verse eid="ACT 11:18"/></para>
  <para style="s1">Kanisa man Antiokia</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19"/>Joma sand nokeyo nikech wach nek Stefano nodhi Foinike, Saipras nyaka Antiokia, ka gilando Injili ne jo-Yahudi kende. <verse eid="ACT 11:19"/><verse number="20" style="v" sid="ACT 11:20"/>To jomoko kuomgi mane oa Saipras kod Kurene, nodhi Antiokia ma gichako wuoyo gi jo-Yunani bende, ka ginyisogi Injili ma wuoyo kuom Ruoth Yesu. <verse eid="ACT 11:20"/><verse number="21" style="v" sid="ACT 11:21"/>Teko Nyasaye ne ni kodgi, omiyo ji mathoth noyie kendo olokore kuom Ruoth.<verse eid="ACT 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22"/>Wachni nolandore mochopo e it kanisa mane ni Jerusalem, omiyo negioro Barnaba e dala Antiokia. <verse eid="ACT 11:22"/><verse number="23" style="v" sid="ACT 11:23"/>Kane ochopo mi oneno kaka ngʼwono Nyasaye ne tiyo kuom jogo, nomor ahinya, kendo nojiwogi duto mondo gisiki kuom Ruoth gadiera kendo gi chunygi duto. <verse eid="ACT 11:23"/><verse number="24" style="v" sid="ACT 11:24"/>Barnaba ne en ngʼat maber, mopongʼ gi Roho Maler kod yie kendo ji ma kwan-gi thoth ahinya nolokore obiro ir Ruoth.<verse eid="ACT 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25"/>Bangʼe Barnaba nodhi Tarso mondo omany Saulo, <verse eid="ACT 11:25"/><verse number="26" style="v" sid="ACT 11:26"/>to kane oyude, nodok kode Antiokia. Kuom higa achiel mangima, Barnaba gi Saulo ne chokore gi kanisa ka gipuonjo ji ma kwan-gi ngʼeny ahinya. Antiokia kuno ema ne okuong luongoe jopuonjre ni jo-Kristo.<verse eid="ACT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27"/>E kindeno, jonabi moko nobiro Antiokia ka gia Jerusalem. <verse eid="ACT 11:27"/><verse number="28" style="v" sid="ACT 11:28"/>Achiel kuomgi, mane iluongo ni Agaba nochungʼ mokoro wach kuom Roho, ni kech marach ne biro landore mi kwak piny Rumi duto. Kejni nobet e kinde loch Klaudio. <verse eid="ACT 11:28"/><verse number="29" style="v" sid="ACT 11:29"/>Kuom mano, jopuonjre nowinjore mar oro kony kaluwore gi nyalo margi, ni jowete mane odak Judea. <verse eid="ACT 11:29"/><verse number="30" style="v" sid="ACT 11:30"/>Negitimo mano mi gioro Barnaba gi Saulo jotero konygigo ne jodong kanisa.<verse eid="ACT 11:30"/></para>
  <chapter eid="ACT 11"/>
  <chapter number="12" style="c" sid="ACT 12"/>
  <para style="s1">Malaika ogolo Petro e od twech</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1"/>E kindeno ruoth Herode nomako jo-Kristo moko, kendo nochano mar negogi. <verse eid="ACT 12:1"/><verse number="2" style="v" sid="ACT 12:2"/>Ne ogolo chik mi oneg Jakobo owad gi Johana gi ligangla. <verse eid="ACT 12:2"/><verse number="3" style="v" sid="ACT 12:3"/>Kane oneno ka timneno nomoro jo-Yahudi, nodhi nyime momako Petro bende. Mano notimore e ndalo Sap Makati ma ok oketie Thowi. <verse eid="ACT 12:3"/><verse number="4" style="v" sid="ACT 12:4"/>Kane osemake, nokete e od twech, kendo noketo migepe angʼwen mag askeche, ma moro ka moro otingʼo jorit angʼwen, mondo orite. Herode ne chano mondo ogole oko bangʼ Pasaka mondo oyale e nyim oganda.<verse eid="ACT 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 12:5"/>Kuom mano, Petro nokan e od twech, to kanisa to ne lamone Nyasaye ahinya.<verse eid="ACT 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6"/>Otieno motelone chiengʼ mane Herode chano goloe Petro oko mondo oyale, negikete onindo e kind askeche ariyo, ka otweye gi nyoroche ariyo, kendo ka askeche mamoko bende rite kochungʼ e dhood twech. <verse eid="ACT 12:6"/><verse number="7" style="v" sid="ACT 12:7"/>Apoya nono malaika mar Ruoth nofwenyore, mi ler norieny ei od twech. Noyuko Petro mochiewe kowacho niya, “Aa malo piyo.” Gikanyono nyoroche mane otwego Petro nolwar piny.<verse eid="ACT 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 12:8"/>Malaika nomedo wachone niya, “Rwak lepi gi wuocheni.” Petro notimo kamano. Malaika nochako okone niya, “Koro rwak kodi mondo iluwa!” <verse eid="ACT 12:8"/><verse number="9" style="v" sid="ACT 12:9"/>Petro noluwo bangʼe kowuok e od twech, to kata kamano pache ne pok odwogo mondo ofwenyne ni gima malaika ne timono en adier, to noparo mana ni oleko. <verse eid="ACT 12:9"/><verse number="10" style="v" sid="ACT 12:10"/>Ne gikalo jorit mokwongo, gi mar ariyo mi gichopo e ranga chuma mane iwuokgo e od twech kidonjo e dala maduongʼ. Rangano noyawrenigi kende mine gikadho. Kane gisewuotho mabor mochwalore gi od twech, to nopo ka malaika oseweye.<verse eid="ACT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11"/>Bangʼe pach Petro noduogo mi owacho niya, “Koro angʼeyo maonge kiawa ni Ruoth nooro malaikane mi oresa e twech Herode, kendo osemiyo atony e gimoro amora marach ma jo-Yahudi ne chano timona.”<verse eid="ACT 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12"/>Kane osengʼeyo gima notimorene, nodhi nyaka od Maria min Johana, ma niluongo bende ni Mariko, kendo kanyo ji nochokore mangʼeny ka gilamo Nyasaye. <verse eid="ACT 12:12"/><verse number="13" style="v" sid="ACT 12:13"/>Kane Petro oduongʼo dhoot ma oko, to nyako moro ma jatich miluongo ni Roda nobiro mondo oyawne. <verse eid="ACT 12:13"/><verse number="14" style="v" sid="ACT 12:14"/>To ka nochamo dwond Petro, nodoko mamor ahinya mi noringo odok ei ot kapok oyawone. Nonyiso jogo mane ni e ot kopongʼ gimor niya, “Petro ni e dhoot!”<verse eid="ACT 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 12:15"/>To jogo nokwere kawacho niya, “Wiyi rach!” Ka nyakono nomedo ramo ni Petro ne ni e dhoot adier, negiwachone niya, “Mano nyaka bedi mana malaikane!”<verse eid="ACT 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16"/>To Petro nomedo dwongʼo dhoot, kendo kane giyawo dhoot mi ginene, to dhogi nomoko. <verse eid="ACT 12:16"/><verse number="17" style="v" sid="ACT 12:17"/>Petro notingʼo lwete malo mondo gilingʼ, eka nonyisogi yo mane Ruoth ogolego e od twech. Nowachonegi niya, “Nyisuru Jakobo gi jowete mamoko gima nosetimore.” Bangʼe noa kanyo modhi kamachielo.<verse eid="ACT 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18"/>Kinyne gokinyi kihondko maduongʼ nomako jolweny mane oket mondo orite e od twech. Negipenjore niya, “Angʼo ma dibed nosetimore ni Petro?” <verse eid="ACT 12:18"/><verse number="19" style="v" sid="ACT 12:19"/>Herode nogolo chik mondo omany Petro, to ne ok ginyal yude. Kuom mano, nonono jorit od twech mondo ginyise kuma Petro odhiye, eka nogolo chik mondo oneg joritogi.</para>
  <para style="s1" vid="ACT 12:19">Tho mar Herode</para>
  <para style="p" vid="ACT 12:19">Kindeno Herode nodar Judea modhi odak Kaisaria kuom ndalo manok. <verse eid="ACT 12:19"/><verse number="20" style="v" sid="ACT 12:20"/>Noyudo en-gi mirima kod jo-Turo gi jo-Sidon. Kuom mano jo-Turo kod jo-Sidon ne joriwore mi giloso thuolo mar romo gi Herode. Ne gitudore gi Blasto, mane en jatich ruoth mogeno, eka negiyudo yo mar loso kwe gi ruoth, nikech chiembgi ne wuok e piny Herode.<verse eid="ACT 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21"/>Odiechiengʼ mane onego giromieno, Herode ne orwako lepe mag ruoth mi obet e kome mar loch mi ochako wuoyo gi ji. <verse eid="ACT 12:21"/><verse number="22" style="v" sid="ACT 12:22"/>To jogo nogoyo koko kawacho niya, “Mano dwond Nyasaye, ok en dwond dhano!” <verse eid="ACT 12:22"/><verse number="23" style="v" sid="ACT 12:23"/>Gikanyono malaika mar Ruoth nogoyo Herode piny, nikech ne ok omiyo Nyasaye duongʼ kendo kute nochamo ringre, mi otho.<verse eid="ACT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24"/>Wach Nyasaye nomedo dhi nyime kendo nomedo landore.<verse eid="ACT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25"/>Kane Barnaba gi Saulo nosetieko tijgi, negidwogo ka gia Jerusalem ka gin gi Johana ma bende iluongo ni Mariko.<verse eid="ACT 12:25"/></para>
  <chapter eid="ACT 12"/>
  <chapter number="13" style="c" sid="ACT 13"/>
  <para style="s1">Owal Barnaba gi Saulo e tich makende</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1"/>Kanisa mane ni Antiokia notingʼo jonabi gi jopuonj. Ne gin Barnaba gi Simeon miluongo ni Ratengʼ, gi Lukio ja-Kurene, gi Saulo kod Manaen mane odongo gi Herode ma ruoth. <verse eid="ACT 13:1"/><verse number="2" style="v" sid="ACT 13:2"/>Kane oyudo gilamo Ruoth Nyasaye kendo gitweyo chiemo, Roho Maler nowachonegi niya, “Walnauru Barnaba gi Saulo mondo gitina tich mane aluongogi mondo giti.” <verse eid="ACT 13:2"/><verse number="3" style="v" sid="ACT 13:3"/>Omiyo kane gimedo lemo kendo gitweyo chiemo, ne gigwedhogi mi giweyogi gidhi.<verse eid="ACT 13:3"/></para>
  <para style="s1">Barnaba gi Saulo oyalo Injili Saipras</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4"/>Ji ariyogo nowuok modhi ka Roho Maler otelonegi. Ne gilor nyaka Seleukia, bangʼe gikwangʼ ka gia kanyo nyaka Saipras. <verse eid="ACT 13:4"/><verse number="5" style="v" sid="ACT 13:5"/>Kane gichopo Salamis, ne giyalo Wach Nyasaye e sinagoke mag jo-Yahudi. Johana ne ni kodgi kaka jakonygi.<verse eid="ACT 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6"/>Ne giwuotho e chulano duto mi gichopo Pafo, kendo kanyo ne giyude ja-Yahudi moro ma ajwoga kendo mane wuondore ni janabi, ma nyinge Bar-Yesu. <verse eid="ACT 13:6"/><verse number="7" style="v" sid="ACT 13:7"/>Ajuogani ne otwere but ruodh chulano miluongo ni Sergio Paulo, mane en ngʼat mariek, kendo kaka nodwaro winjo Wach Nyasaye, nooro wach mondo oluongne Barnaba gi Saulo. <verse eid="ACT 13:7"/><verse number="8" style="v" sid="ACT 13:8"/>To ajuogano mane iluongo ni Elima (nikech mano e tiend nyinge) notamogi, kotemo gengʼo ruoth mondo kik olokre oyie kuom Yesu. <verse eid="ACT 13:8"/><verse number="9" style="v" sid="ACT 13:9"/>Eka Saulo, ma bende niluongo ni Paulo, nopongʼ gi Roho Maler, mi nongʼiyo wangʼ Elima tir, bangʼe owachone niya, <verse eid="ACT 13:9"/><verse number="10" style="v" sid="ACT 13:10"/>“In nyathi Satan, kendo ikedo gi gik mabeyo duto! Ipongʼ gi kit wuondruok duto gi yore mag wito ji. Iniwe timni mar loko adiera Ruoth Nyasaye doko miriambo karangʼo? <verse eid="ACT 13:10"/><verse number="11" style="v" sid="ACT 13:11"/>To winji, lwet Ruoth Nyasaye koro kedo kodi. Ibiro bedo muofu, kendo kuom kinde moromo ok ibi neno ler mar chiengʼ gi wangʼi.”</para>
  <para style="p" vid="ACT 13:11">Gikanyono mudho mandiwa nobiro moimo wangʼe, mi nochako tangni komulo gik moko gi lwete ka gi kacha, mondo oyudie ngʼato mane nyalo mako bade kataye. <verse eid="ACT 13:11"/><verse number="12" style="v" sid="ACT 13:12"/>Kane ruodhno oneno gima notimoreno, noyie kuom Yesu, kendo nohum nono kuom gik mane owinjo kuom Ruoth Yesu.<verse eid="ACT 13:12"/></para>
  <para style="s1">Paulo gi Barnaba ochopo Antiokia e piny Pisidia</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13"/>Paulo kod joma ne en-go ne oa Pafo mi okwangʼ nyaka Perga, e piny Pamfilia, kendo kanyo ema Johana noweyogie modok Jerusalem. <verse eid="ACT 13:13"/><verse number="14" style="v" sid="ACT 13:14"/>Kane gia Perga, to negimedo dhi nyaka negichopo Antiokia manie piny Pisidia. Chiengʼ Sabato negidonjo e sinagogi mi gibet piny. <verse eid="ACT 13:14"/><verse number="15" style="v" sid="ACT 13:15"/>To bangʼ kane osesom Ndiko moko mowuok e Chike Musa gi Jonabi, jotend sinagogi nooro wach ni Paulo gi joma ne en-go kagiwacho niya, “Owetewa, ka un gi wach ma udwaro jiwogo ji, to un thuolo mar timo mano.”<verse eid="ACT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16"/>Kuom mano, Paulo nochungʼ motingʼo bade, kowacho niya, “Un jo-Israel kod joma ok jo-Yahudi moluoro Nyasaye, winjauru! <verse eid="ACT 13:16"/><verse number="17" style="v" sid="ACT 13:17"/>Nyasach jo-Israel noyiero kwerewa kendo nomiyo ginyaa e thuolo mane gidak Misri. Nyasaye notelonigi kagologi Misri kuno gi tekone maduongʼ; <verse eid="ACT 13:17"/><verse number="18" style="v" sid="ACT 13:18"/>kendo nonano kodgi e thim kuom higni piero angʼwen, kata obedo ni timbegi ne richo kamano. <verse eid="ACT 13:18"/><verse number="19" style="v" sid="ACT 13:19"/>Nokedo gi pinje abiriyo mag jo-Kanaan moloyogi, mi opogo lopgi ni joge kaka girkeni. <verse eid="ACT 13:19"/><verse number="20" style="v" sid="ACT 13:20"/>Magi duto nokawo higni madirom mia angʼwen gi piero abich.</para>
  <para style="p" vid="ACT 13:20">“Bangʼ mano, Nyasaye nomiyogi jongʼad bura mane oritogi nyaka kinde mag Samuel janabi. <verse eid="ACT 13:20"/><verse number="21" style="v" sid="ACT 13:21"/>To achien jo-Israel nokwayo mondo omigi ruoth, mi Nyasaye nomiyogi Saulo wuod Kish, ma ja-dhood Benjamin. Saulo nobedo ruodh pinyno kuom higni piero angʼwen. <verse eid="ACT 13:21"/><verse number="22" style="v" sid="ACT 13:22"/>Bangʼ kane osegolo Saulo e ruoth, noketo Daudi obedo ruodhgi, kendo kuom Daudi ema ne Nyasaye owuoyoe kowacho ni, ‘Aseyudo Daudi wuod Jesse, ngʼat ma chunye chal gi mara, obiro timo gik moko duto ma adwaro mondo otim.’<verse eid="ACT 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23"/>“Nyasaye osekelo ni jo-Israel Jawar ma en Yesu, koa e koth Daudi, mana kaka nosingore ni notim. <verse eid="ACT 13:23"/><verse number="24" style="v" sid="ACT 13:24"/>Kapok ne Yesu obiro, Johana noyalo Injili ne jo-Israel duto mondo gilokre giwe richogi kendo giduto giyud batiso. <verse eid="ACT 13:24"/><verse number="25" style="v" sid="ACT 13:25"/>Kane oyudo Johana koro tieko tije, nowacho ni, ‘Uparo ni an ngʼa? Ok an Jal mane ugeno ni biro biro; to winjuru Jal moro biro bangʼa, kendo ok awinjora gonyo tond wuochene.’<verse eid="ACT 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26"/>“Owetena, ma nyikwa Ibrahim, kod un joma ok jo-Yahudi moluoro Nyasaye, wan ema oseornwa wach warruokni. <verse eid="ACT 13:26"/><verse number="27" style="v" sid="ACT 13:27"/>Jo-Jerusalem gi jotendgi ne ok ongʼeyo ni Yesu e Jawar, to kata kamano, kane gingʼadone buch tho, to negichopo mana weche jonabi misomo pile chiengʼ Sabato. <verse eid="ACT 13:27"/><verse number="28" style="v" sid="ACT 13:28"/>Kata obedo ni ne ok giyudo ketho moro kuome ma dine mi nege, ne gikwayo Pilato mondo ochiwe mondo onege. <verse eid="ACT 13:28"/><verse number="29" style="v" sid="ACT 13:29"/>Kane gisechopo weche duto mondiki kuome, ne gigole ewi yath mi gikete e liel. <verse eid="ACT 13:29"/><verse number="30" style="v" sid="ACT 13:30"/>To Nyasaye nochiere oa kuom joma otho, <verse eid="ACT 13:30"/><verse number="31" style="v" sid="ACT 13:31"/>kendo kuom ndalo mangʼeny, joma ne wuotho kode koa Galili nyaka Jerusalem nonene. Jogo ema koro odoko joneno mag wechegi ni jowa.<verse eid="ACT 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32"/>“Injili ma wanyisou ema: Gima Nyasaye nosingo ne kwerewa <verse eid="ACT 13:32"/><verse number="33" style="v" sid="ACT 13:33"/>osechoponwa, wan nyithindgi, kuom chiero Yesu. Mana kaka ondiki e Zaburi mar ariyo niya,</para>
  <para style="q1" vid="ACT 13:33">“ ‘In Wuoda;</para>
  <para style="q2" vid="ACT 13:33">kawuono asedoko Wuonu.’<note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:7">Zab 2:7</ref></char></char></note><verse eid="ACT 13:33"/></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34"/>To kuom chier mane Nyasaye ochierego oa kuom joma otho, mondo kik otow, to ondikie kama:</para>
  <para style="q1" vid="ACT 13:34">“ ‘Anamiu gweth maler kendo madier, mane asingone Daudi.’<note caller="+" style="f"><char style="fr" closed="false">13:34 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 55:3">Isa 55:3</ref></char></char></note><verse eid="ACT 13:34"/></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35"/>Kamoro machielo bende ondikie kama:</para>
  <para style="q1" vid="ACT 13:35">“ ‘Ok niyie Ngʼati Maler tow.’<note caller="+" style="f"><char style="fr" closed="false">13:35 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 16:10">Zab 16:10</ref></char></char></note><verse eid="ACT 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36"/>“Nimar kane Daudi osetimo dwaro Nyasaye e ndalone, to notho moike kama noyike kwerene, mi ringre notowo, <verse eid="ACT 13:36"/><verse number="37" style="v" sid="ACT 13:37"/>to Jal ma Nyasaye nochiero oa kuom joma otho to ringre ne ok otowo.<verse eid="ACT 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38"/>“Emomiyo, adwaro mondo ungʼe malongʼo, owetena, ni kuom Yesu ema iyalonue yor weyo richo. <verse eid="ACT 13:38"/><verse number="39" style="v" sid="ACT 13:39"/>Kuome ema ngʼato angʼata moyie iketo kare mi gony kuom gimoro amora ma Chik Musa ne ok nyal gonyoe ngʼato. <verse eid="ACT 13:39"/><verse number="40" style="v" sid="ACT 13:40"/>Omiyo tangʼuru, mondo gik mane jonabi okoro kik timrenu. Ne gikoro niya:<verse eid="ACT 13:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41"/>“ ‘Neuru, un joma obwono ji-gi,</para>
  <para style="q2" vid="ACT 13:41">beduru morwenyo nyaka thou,</para>
  <para style="q1" vid="ACT 13:41">nimar abiro timo gimoro e ndalou</para>
  <para style="q2" vid="ACT 13:41">ma ok ubi yiego,</para>
  <para style="q2" vid="ACT 13:41">kata ka ngʼato oleronu tiende.’<note caller="+" style="f"><char style="fr" closed="false">13:41 </char><char style="ft" closed="false"><char style="xt"><ref loc="HAB 1:5">Hab 1:5</ref></char></char></note>”<verse eid="ACT 13:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42"/>Kane oyudo Paulo gi Barnaba wuok e sinagogi, ji nokwayogi mondo gimed loso kuom wechegi chiengʼ Sabato moluwo mano. <verse eid="ACT 13:42"/><verse number="43" style="v" sid="ACT 13:43"/>To ka nosegony chokruok mondo odhiyo, jo-Yahudi mangʼeny gi ji ma nolokore oluwo din jo-Yahudi noluwo Paulo gi Barnaba, kendo negimedo wuoyo kodgi ka gijiwogi mondo gimed dhi nyime e ngʼwono mar Nyasaye.<verse eid="ACT 13:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44"/>Chiengʼ Sabato moluwo mano, chiegni ji duto modak Antiokia nochokore mondo owinj wach Ruoth. <verse eid="ACT 13:44"/><verse number="45" style="v" sid="ACT 13:45"/>To ka jo-Yahudi noneno ogandano, nyiego nomakogi mi gichako wuoyo marach kuom gik mane Paulo wacho.<verse eid="ACT 13:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 13:46"/>Eka Paulo gi Barnaba nomedo wuoyo gi chir kagiwacho niya, “Ne bernwa mondo un ema wayalnu Wach Nyasaye mokwongo. To nikech udage kendo nikech ok ukwanoru ka joma owinjore yudo ngima mochwere, koro waweyou mondo wayal wachni ni joma ok jo-Yahudi. <verse eid="ACT 13:46"/><verse number="47" style="v" sid="ACT 13:47"/>Ruoth Nyasaye osemiyowa chik niya,</para>
  <para style="q1" vid="ACT 13:47">“ ‘Asemiyo udoko ler ne Ogendini,</para>
  <para style="q2" vid="ACT 13:47">mondo uland warruok e tunge piny duto.’<note caller="+" style="f"><char style="fr" closed="false">13:47 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 49:6">Isa 49:6</ref></char></char></note>”<verse eid="ACT 13:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48"/>Kane joma ok jo-Yahudi owinjo wachno, negimor kendo negirwako wach Ruoth Nyasaye, kendo joma nochan-negi yudo ngima mochwere noyie kuom Yesu.<verse eid="ACT 13:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49"/>Wach Ruoth Nyasaye nolandore e gwengʼno duto. <verse eid="ACT 13:49"/><verse number="50" style="v" sid="ACT 13:50"/>To jo-Yahudi nokelo mirima e chuny mon moluoro Nyasaye man-gi nying kod joma chwo midewo mane odak e dalano. Jogi nothuwo ji mondo osand Paulo gi Barnaba, kendo negiriembogi e gwengʼno. <verse eid="ACT 13:50"/><verse number="51" style="v" sid="ACT 13:51"/>Kuom mano ne gitengʼo buch tiendgi ka gikwedo timgi eka negidhi Ikonio. <verse eid="ACT 13:51"/><verse number="52" style="v" sid="ACT 13:52"/>Jopuonjre mane ni Antiokia nodongʼ kopongʼ gi mor kod Roho Maler.<verse eid="ACT 13:52"/></para>
  <chapter eid="ACT 13"/>
  <chapter number="14" style="c" sid="ACT 14"/>
  <para style="s1">Paulo gi Barnaba ochopo Ikonio</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1"/>E Ikonio bende, Paulo gi Barnaba ne jodhi e sinagogi mar jo-Yahudi kaka negijatimo. Kanyo bende ne giyale gi teko, mi jo-Yahudi gi joma ok jo-Yahudi mathoth noyie kuom Yesu. <verse eid="ACT 14:1"/><verse number="2" style="v" sid="ACT 14:2"/>To jo-Yahudi moko ma notamore yie kuom Yesu noketho chuny joma ok jo-Yahudi, kendo negiketo kwiri marach e chunygi, mondo giked gi jowete. <verse eid="ACT 14:2"/><verse number="3" style="v" sid="ACT 14:3"/>Paulo gi Barnaba nobedo kuno kuom ndalo mogwarore, ka giwuoyo gi chir kuom Ruoth Yesu, kendo Nyasaye nodoko janeno kuom wach ngʼwonone, komiyo joote timo honni gi ranyisi. <verse eid="ACT 14:3"/><verse number="4" style="v" sid="ACT 14:4"/>Jo-dalano nopogore nyadiriyo ka moko odok ni jo-Yahudi, to moko nodok ni joote. <verse eid="ACT 14:4"/><verse number="5" style="v" sid="ACT 14:5"/>Eka joma ok jo-Yahudi kod jo-Yahudi, kaachiel gi jotendgi nochano lingʼ-lingʼ mondo gisand joote kendo gichielgi gi kite. <verse eid="ACT 14:5"/><verse number="6" style="v" sid="ACT 14:6"/>To joote nofwenyo gima negichano timo, omiyo negiringo gidhi Lustra gi Derbe, mier mag Lukaonia, kendo e mier molworogi, <verse eid="ACT 14:6"/><verse number="7" style="v" sid="ACT 14:7"/>mi kuno bende ne giyaloe Injili.<verse eid="ACT 14:7"/></para>
  <para style="s1">Paulo gi Barnaba ochopo Lustra gi Derbe</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8"/>E dala mar Lustra, ne nitiere ngʼat moro ma tiendeni ongʼol. Ngʼatni nongʼol nyaka aa nywolne kendo ne pok owuotho nyaka nene. <verse eid="ACT 14:8"/><verse number="9" style="v" sid="ACT 14:9"/>Nochiko ite kowinjo kaka Paulo ne wuoyo. Paulo nongʼiye tir moneno ka en-gi yie mane nyalo miyo ochangi, <verse eid="ACT 14:9"/><verse number="10" style="v" sid="ACT 14:10"/>mi nowachone giduol maduongʼ niya, “Chungʼ gi tiendi!” Gikanyono ngʼatno nochikore malo mochako wuoth.<verse eid="ACT 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11"/>Kane oganda mane ni kanyo oneno gima Paulo otimo, ne gikok gi dho jo-Lukaonia niya, “Nyiseche osekawo kit dhano mi obiro irwa ka!” <verse eid="ACT 14:11"/><verse number="12" style="v" sid="ACT 14:12"/>Negimiyo Barnaba nying ni Zeu, to Paulo negichako ni Hermes, nikech en ema ne en jayalo maduongʼ. <verse eid="ACT 14:12"/><verse number="13" style="v" sid="ACT 14:13"/>Jadolo mar Zeu, ma hekalune noger machiegni gi dalano, nokelo rwedhi kod maua mi giketo e dhoranga dalano mondo en, kaachiel gi oganda, gitim misango ni Paulo kod Barnaba.<verse eid="ACT 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14"/>To ka joote Paulo gi Barnaba nowinjo wachno, ne giyiecho lepgi mi giringo matek ka gichomo ogandano, ka gikok niya, <verse eid="ACT 14:14"/><verse number="15" style="v" sid="ACT 14:15"/>“Jowadwa, utimonwa kamano nikech angʼo? Wan mana ji kaka un. Wakelonu Injili manyisou mondo ua e gik manonogi mondo ungʼe Nyasaye Mangima, manochweyo polo gi piny gi nam kod gik moko duto manie igi. <verse eid="ACT 14:15"/><verse number="16" style="v" sid="ACT 14:16"/>Kinde mokalo Nyasaye noweyo ogendini duto mondo oluw yoregi giwegi. <verse eid="ACT 14:16"/><verse number="17" style="v" sid="ACT 14:17"/>To kata kamano, ok oseweyowa maonge yo ma dwangʼeyego. Osenyisou ngʼwonone komiyou koth moa e polo, kendo komiyo cham chieknu e kinde mowinjore; osebedo komiyou chiemo mathoth kendo opongʼo chunyu gi mor.” <verse eid="ACT 14:17"/><verse number="18" style="v" sid="ACT 14:18"/>To kata negisewuoyo kamano, jogo ne pod dwaro mana timonegi misango.<verse eid="ACT 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19"/>Bangʼe jo-Yahudi moko nobiro koa Antiokia kod Ikonio mi gisemo ji odoknigi. Negigoyo Paulo gi kite mi giywaye e lowo nyaka oko mar dala, ka giparo ni osetho. <verse eid="ACT 14:19"/><verse number="20" style="v" sid="ACT 14:20"/>To ka jopuonjre nobiro molwore kama noninde, noa malo modok ei dalano. Kinyne ne giwuok gi Barnaba mi gidhi Derbe.<verse eid="ACT 14:20"/></para>
  <para style="s1">Paulo gi Barnaba jodok Antiokia e piny Siria</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21"/>Paulo gi Barnaba ne joyalo Injili e dala mar Derbe mi giloko jopuonjre mangʼeny. Bangʼe negidok Lustra, gi Ikonio kod Antiokia, <verse eid="ACT 14:21"/><verse number="22" style="v" sid="ACT 14:22"/>ka gitego chuny jopuonjre kendo gijiwogi mondo gisiki e yie. Negipuonjogi kagiwacho niya, “Wan duto nyaka wane sand mathoth eka wadonji e pinyruoth Nyasaye.” <verse eid="ACT 14:22"/><verse number="23" style="v" sid="ACT 14:23"/>Kane giseketo jodongo e kanisa ka kanisa, mi gilamonegi ka gitweyo chiemo, negiketogi e lwet Ruoth Yesu mane giseyie kuome. <verse eid="ACT 14:23"/><verse number="24" style="v" sid="ACT 14:24"/>Negiluwo piny Pisidia mi gichopo Pamfilia, <verse eid="ACT 14:24"/><verse number="25" style="v" sid="ACT 14:25"/>to bangʼ yalo Injili Perga, negidhi mwalo nyaka Atalia.<verse eid="ACT 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 14:26"/>Kane gia Atalia, negikwangʼ mi gidok Antiokia, kuma ne giyudo e pwoch kuom tich maber mane gisetimo kuom ngʼwono mar Nyasaye. <verse eid="ACT 14:26"/><verse number="27" style="v" sid="ACT 14:27"/>Kane gichopo kuno, negichoko kanisa kaachiel mi ginyisogi gik moko duto ma Nyasaye nosetimo ka otiyo kodgi, kendo kaka noseyawo dhoot mar yie mondo joma ok jo-Yahudi oyud warruok. <verse eid="ACT 14:27"/><verse number="28" style="v" sid="ACT 14:28"/>Negibet gi jopuonjre kuno kuom ndalo mangʼeny.<verse eid="ACT 14:28"/></para>
  <chapter eid="ACT 14"/>
  <chapter number="15" style="c" sid="ACT 15"/>
  <para style="s1">Jobura oromo Jerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1"/>Jomoko moa Judea nobiro Antiokia kendo negipuonjo jowete kagiwacho niya, “Ka ok oteru nyangu kaluwore gi chik mane Musa opuonjo to ok unyal yudo warruok.” <verse eid="ACT 15:1"/><verse number="2" style="v" sid="ACT 15:2"/>Wachni nomiyo Paulo gi Barnaba odhawo kodgi matek ka kwerogi kuom puonjgino. Omiyo noyier Paulo gi Barnaba, kaachiel gi joma oyie mamoko, mondo gidhi nyaka Jerusalem gine joote gi jodongo kuom wachno. <verse eid="ACT 15:2"/><verse number="3" style="v" sid="ACT 15:3"/>Kanisa nokowogi, kendo kane oyudo gidhi, ka gikadho e dier Foinike kod Samaria, neginyiso ji kaka joma ok jo-Yahudi bende ne yudo warruok. Wachno nomiyo owete odoko mamor. <verse eid="ACT 15:3"/><verse number="4" style="v" sid="ACT 15:4"/>Kane gichopo Jerusalem, kanisa kaachiel gi joote kod jodongo norwakogi, kendo neginyisogi gik moko duto ma Nyasaye nosetimo, kotiyo kodgi.<verse eid="ACT 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 15:5"/>To jo-Farisai moko moyie kuom Kristo nochungʼ mowacho niya, “Joma ok jo-Yahudi nyaka ter nyangu kendo nyaka gilu chike Musa.”<verse eid="ACT 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6"/>Joote gi jodongo noketo bura mondo giwuo kuom wachno, <verse eid="ACT 15:6"/><verse number="7" style="v" sid="ACT 15:7"/>kendo bangʼ kane gisewuoyo amingʼa, Petro nochungʼ malo mowachonegi kama: “Owetewa, ungʼeyo kaka kinde mosekalo Nyasaye noyiero e dieru mondo joma ok jo-Yahudi owinj Injili mi giyie kuom Yesu, ka an awuon ema ayalonegi. <verse eid="ACT 15:7"/><verse number="8" style="v" sid="ACT 15:8"/>Nyasaye owuon mongʼeyo chuny ji, nonyiso ni oyie kodgi, ka nomiyogi Roho Maler, mana kaka wan bende nosemiyowa. <verse eid="ACT 15:8"/><verse number="9" style="v" sid="ACT 15:9"/>Ne ok otimonigi gima opogore gi ma notimonwa, nikech gin bende nopwodho chunygi kuom yie. <verse eid="ACT 15:9"/><verse number="10" style="v" sid="ACT 15:10"/>Ka en kamano, to koro marangʼo udwaro temo Nyasaye, kuketo jok mapek e ngʼut jopuonjre ma wan kata kwerewa ne ok nyal tingʼo? <verse eid="ACT 15:10"/><verse number="11" style="v" sid="ACT 15:11"/>Omiyo wayie ni kaka wayudo warruok kuom ngʼwono mar Ruodhwa Yesu, e kaka gin bende iwarogi.”<verse eid="ACT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12"/>Ji duto nolingʼ ka Paulo gi Barnaba ne hulonegi kuom honni gi ranyisi ma Nyasaye nosetimo e kind joma ok jo-Yahudi, kotiyo kodgi. <verse eid="ACT 15:12"/><verse number="13" style="v" sid="ACT 15:13"/>Kane gisetieko wuoyo, Jakobo nochungʼ mowuoyo kowacho niya, “Winjauru, owetena. <verse eid="ACT 15:13"/><verse number="14" style="v" sid="ACT 15:14"/>Simon osenyisowa kaka Nyasaye nokwongo olimo joma ok jo-Yahudi, kokawo joge owuon e diergi. <verse eid="ACT 15:14"/><verse number="15" style="v" sid="ACT 15:15"/>Weche mane jonabi okoro bende siro wachni mana kaka ondiki niya,<verse eid="ACT 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16"/>“ ‘Bangʼ mano anaduogi kendo,</para>
  <para style="q2" vid="ACT 15:16">mi ager kendo od Daudi mosepodho.</para>
  <para style="q1" vid="ACT 15:16">Anachak ager kuondene momukore,</para>
  <para style="q2" vid="ACT 15:16">mi alose obed maber,<verse eid="ACT 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17"/>mondo omi ji duto omany Jehova Nyasaye,</para>
  <para style="q2" vid="ACT 15:17">kaachiel gi ogendini duto miluongo gi nyinga,</para>
  <para style="q1" vid="ACT 15:17">Ruoth Nyasaye mane omiyo,’<note caller="+" style="f"><char style="fr" closed="false">15:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="AMO 9:11">Amo 9:11</ref>,<ref loc="AMO 9:12">12</ref></char></char></note><verse eid="ACT 15:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ACT 15:18"/>wechegi ongʼere chon, ema owacho.<verse eid="ACT 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19"/>“Kuom mano bucha wacho ni ok owinjore waket chik matek ni joma ok jo-Yahudi makoro olokore oyie kuom Nyasaye. <verse eid="ACT 15:19"/><verse number="20" style="v" sid="ACT 15:20"/>To owinjore wandiknegi mondo wanyisgi ni kik gicham chiemo motimgo misango ne nyiseche manono, kik giterre, kik gicham ring jamni mode kendo kik gicham remo. <verse eid="ACT 15:20"/><verse number="21" style="v" sid="ACT 15:21"/>Nikech chike Musa osebedo kiyalo nyaka nene e mier duto, kendo kisomo e sinagoke Sabato ka Sabato.”<verse eid="ACT 15:21"/></para>
  <para style="s1">Jobura ondiko baruwa ne joma oyie kuom Kristo ma ok jo-Yahudi</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22"/>Bangʼ mano joote gi jodongo kod kanisa, nongʼado wach mondo giyier jomoko kuomgi gior Antiokia kaachiel gi Paulo kod Barnaba. Ne giyiero Judas ma niluongo ni Barsaba gi Sila, mane gin jotelo e dier owete. <verse eid="ACT 15:22"/><verse number="23" style="v" sid="ACT 15:23"/>Jogi noor gi baruwa mondiki kama:</para>
  <para style="pmo" vid="ACT 15:23">Wan joote gi jodongo, ma wan oweteu kuom Ruoth,</para>
  <para style="pmo" vid="ACT 15:23">Ne un joma ok jo-Yahudi moyie man Antiokia gi Siria kod Kilikia:</para>
  <para style="pmo" vid="ACT 15:23">Wamosou,<verse eid="ACT 15:23"/></para>
  <para style="pm">
    <verse number="24" style="v" sid="ACT 15:24"/>Wasewinjo kaka jomoko noa kuomwa ka wan to ne ok waorogi, mi gichandou ka githago chunyu gi weche mane giwacho. <verse eid="ACT 15:24"/><verse number="25" style="v" sid="ACT 15:25"/>Kuom mano, ne wawinjore waduto mondo wayier jomoko waor iru kod osiepewa mwageno, Barnaba gi Paulo, <verse eid="ACT 15:25"/><verse number="26" style="v" sid="ACT 15:26"/>ma gin joma osechiwo ngimagi ni Ruodhwa Yesu Kristo. <verse eid="ACT 15:26"/><verse number="27" style="v" sid="ACT 15:27"/>Kaluwore gi mano, waoro bende Judas gi Sila mondo onyisu gi dhogi weche mwandikonu e baruwani. <verse eid="ACT 15:27"/><verse number="28" style="v" sid="ACT 15:28"/>En dwaro mar Roho Maler kod marwa bende mondo kik wamiu tingʼ mapek moloyo chike mwamiyou e baruwani. <verse eid="ACT 15:28"/><verse number="29" style="v" sid="ACT 15:29"/>Kik ucham chiemo motimgo misango ne nyiseche manono, kik ucham remo; kik ucham ring jamni mode bende kik uterru. Ka uritoru kuom gigo duto, to unudhi nyime maber.</para>
  <para style="pmc" vid="ACT 15:29">Oritiuru.<verse eid="ACT 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30"/>Kuom mano, joote noor modhi nyaka Antiokia. Bangʼ chopo, negichoko kanisa kaachiel mi gimiyogi baruwano. <verse eid="ACT 15:30"/><verse number="31" style="v" sid="ACT 15:31"/>Ka ji nosomo baruwano negidoko mamor nikech weche mane ni e iye nojiwogi maber. <verse eid="ACT 15:31"/><verse number="32" style="v" sid="ACT 15:32"/>Judas gi Sila, mane gin jonabi, nomedo wuoyo gi owete ka gijiwogi kendo gitegogi e yie. <verse eid="ACT 15:32"/><verse number="33" style="v" sid="ACT 15:33"/>Kane gisebet kodgi kuom ndalo moromo, owete nokowogi mondo gidhi gi kwe, kendo gidogi ir joma noorogi. [<verse eid="ACT 15:33"/><verse number="34" style="v" sid="ACT 15:34"/>Sila to noneno ni ber mondo odongʼ Antiokia.]<note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false">Loko moko machon mag Muma onge gi <char style="xt"><ref loc="ACT 15:34">Joo 15:34</ref></char>.</char></note> <verse eid="ACT 15:34"/><verse number="35" style="v" sid="ACT 15:35"/>Kaachiel gi Paulo gi Barnaba kod ji mamoko, ka gipuonjo kendo giyalo wach Ruoth.<verse eid="ACT 15:35"/></para>
  <para style="s1">Pogruok obet e kind Paulo gi Barnaba</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36"/>Bangʼ ndalo moko Paulo nowachone Barnaba niya, “Wadogi mondo walim jowete e mier matindo duto kuonde mwaseyale wach Ruoth, mondo wane kaka gidhi.” <verse eid="ACT 15:36"/><verse number="37" style="v" sid="ACT 15:37"/>Barnaba ne dwaro mondo Johana miluongo ni Mariko odhi kodgi, <verse eid="ACT 15:37"/><verse number="38" style="v" sid="ACT 15:38"/>to Paulo ne paro ni ne ok en gima ber mondo gidhi kode, nikech noseweyogi Pamfilia mi ok odhi kodgi nyime e tich. <verse eid="ACT 15:38"/><verse number="39" style="v" sid="ACT 15:39"/>Wachni nokelo pogruok e kind Paulo gi Barnaba, mine gipogore. Barnaba nokawo Mariko mi gikwangʼ gidhi Saipras, <verse eid="ACT 15:39"/><verse number="40" style="v" sid="ACT 15:40"/>to Paulo noyiero Sila gidhigo, ka owete oketogi e bwo ngʼwono mar Ruoth Nyasaye. <verse eid="ACT 15:40"/><verse number="41" style="v" sid="ACT 15:41"/>Nowuotho e piny Siria gi Kilikia kojiwo kanisni.<verse eid="ACT 15:41"/></para>
  <chapter eid="ACT 15"/>
  <chapter number="16" style="c" sid="ACT 16"/>
  <para style="s1">Timotheo odhi ir Paulo kod Sila</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1"/>Paulo nowuotho mochopo Derbe gi Lustra, kama japuonjre moro nodakie miluongo ni Timotheo. Min Timotheo ne ja-Yahudi moyie kuom Yesu, to wuon-gi ne ja-Yunani. <verse eid="ACT 16:1"/><verse number="2" style="v" sid="ACT 16:2"/>Owete man Lustra gi Ikonio ne wuoyo maber kuom Timotheo. <verse eid="ACT 16:2"/><verse number="3" style="v" sid="ACT 16:3"/>Paulo ne dwaro kawe mondo dhi kode e wuodhe mar yalo Injili, omiyo ne otere nyangu, nikech jo-Yahudi mane odak kanyo nongʼeyo ni wuon-gi ne en ja-Yunani. <verse eid="ACT 16:3"/><verse number="4" style="v" sid="ACT 16:4"/>Kane giwuotho e dala ka dala, neginyiso ji mondo oluw gima buch joote gi jodongo nongʼado Jerusalem. <verse eid="ACT 16:4"/><verse number="5" style="v" sid="ACT 16:5"/>Omiyo kanisa nobedo motegno e yie, kendo kwan joma oyie kuom Kristo ne medore pile.<verse eid="ACT 16:5"/></para>
  <para style="s1">Paulo oneno fweny mar ja-Makedonia</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6"/>Kaka Roho Maler nosegengʼogi ni kik giyal Injili e piny Asia, Paulo gi lange nowuotho e gwengʼ Frugia gi Galatia. <verse eid="ACT 16:6"/><verse number="7" style="v" sid="ACT 16:7"/>Kane gichopo e tongʼ piny Musia, ne gitemo mondo gidonj e piny Bithinia, to Roho mar Yesu ne ok oyienigi timo mano. <verse eid="ACT 16:7"/><verse number="8" style="v" sid="ACT 16:8"/>Omiyo negidhi nyaka Troa, ka giluwo Musia. <verse eid="ACT 16:8"/><verse number="9" style="v" sid="ACT 16:9"/>Otienono, Paulo noneno fweny mar ja-Makedonia kochungʼ kendo saye niya, “Bi loka Makedonia mondo ikonywa.” <verse eid="ACT 16:9"/><verse number="10" style="v" sid="ACT 16:10"/>Bangʼ kane Paulo oseneno fwenyno, ne waikore piyo piyo mondo wadhi e piny Makedonia, nikech ne wangʼeyo ni Nyasaye dwarowa loka kono mondo wayalnegi Injili.<verse eid="ACT 16:10"/></para>
  <para style="s1">Lidia oyudo warruok Filipi</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11"/>Bangʼ aa Troa, ne wakwangʼo yie kwachomo Samothraki kendo kinyne ne wadhi nyime nyaka Neapoli. <verse eid="ACT 16:11"/><verse number="12" style="v" sid="ACT 16:12"/>Kane waa kanyo, ne wadhi nyaka Filipi, mane en dala maduongʼ e bath piny Makedonia ma kono, kendo joma odakie ne ni e bwo loch jo-Rumi. Kanyo ne wadakie kuom ndalo mogwarore.<verse eid="ACT 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 16:13"/>Chiengʼ Sabato ne wawuok oko mar dalano mi wachopo e dho aora, kuma ne waparo ni diwayudie kar lemo. Ne wabet piny kanyo mi wawuoyo gi mon moko mane oyudo osechokore kanyo. <verse eid="ACT 16:13"/><verse number="14" style="v" sid="ACT 16:14"/>Achiel kuom joma nochiko itgi mowinjowa kwaloso ne en dhako moro moa Thuatira, ma nyinge Ludia, mane loko lewni makwar ma nengogi tek kendo noluoro Nyasaye. Ruoth noyawo chunye mondo orwak puonj Paulo. <verse eid="ACT 16:14"/><verse number="15" style="v" sid="ACT 16:15"/>Bangʼ kane osebatise, en kaachiel gi joode duto, norwakowa e ode kowacho niya, “Ka ukwana kaka ngʼat moyie kuom Ruoth Yesu, to biuru mondo ubed wenda.” Nomedo sayowa kamano mine wadhi!<verse eid="ACT 16:15"/></para>
  <para style="s1">Oter Paulo gi Sila e od twech</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16"/>Chiengʼ moro kane wadhi kar lemo, nyako moro ma jatich e ot, kendo man-gi jachien marach mane omiyo en gi teko mar koro gik mabiro timore, noromo kodwa. Nyakono ne kelo ni ruodhi mage pesa mangʼeny, kohulo ni ji gik mabiro timogi. <verse eid="ACT 16:16"/><verse number="17" style="v" sid="ACT 16:17"/>Kinde ka kinde ne oluwo bangʼ Paulo kod wan bende, kokok niya, “Jogi gin jotich Ruoth Nyasaye man Malo Moloyo, kendo ginyisou yor yudo warruok.” <verse eid="ACT 16:17"/><verse number="18" style="v" sid="ACT 16:18"/>Notimo kamano kuom ndalo mogwarore, to achien Paulo nosin kode, mi nolokore ochiko jachiendno niya, “Achiki e nying Yesu Kristo ni aa kuome!” Jachiendno noa kuom nyakono mana gisano.<verse eid="ACT 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19"/>Kane ruodhi mag nyako ma jatichno oneno kaka ohandgi mane giyudogo pesa orumo, negimako Paulo gi Sila mi giywayogi oko nyaka chuny chiro mondo jotelo oyalgi. <verse eid="ACT 16:19"/><verse number="20" style="v" sid="ACT 16:20"/>Negiterogi e nyim jongʼad bura, mi giwacho niya, “Jogi gin jo-Yahudi, to gisekelo koko e dalawa-ka, <verse eid="ACT 16:20"/><verse number="21" style="v" sid="ACT 16:21"/>ka gipuonjo ji mondo oluw timbe magalagala ma chikwa odagi mondo wan jo-Rumi wayiego kata waluw.”<verse eid="ACT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22"/>Ji mane ni kanyo duto nonywako ni Paulo gi Sila ka gidonjonegi, omiyo jongʼad bura nochiko mondo olony lepgi mondo ochwadgi. <verse eid="ACT 16:22"/><verse number="23" style="v" sid="ACT 16:23"/>Kane osechwadgi marach, norwakgi e od twech mi omi jarit od twech chik mondo oritgi motegno. <verse eid="ACT 16:23"/><verse number="24" style="v" sid="ACT 16:24"/>Jarit od twech nokawo chikno matek mi noketogi ei od twech maiye, kotweyo tiendegi e kind lodi mag yien.<verse eid="ACT 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25"/>To kar odiwuor tir, kane oyudo Paulo gi Sila jolemo kendo pako Nyasaye gi wende, ka joma otwe mamoko winjogi, <verse eid="ACT 16:25"/><verse number="26" style="v" sid="ACT 16:26"/>piny noyiengni matek apoya nono, mi mise mag od twech noyiengni. Gikanyono dhoudi duto mag od twech noyawore kendgi, mi nyoroche mane otwego jotwech nogonyore duto. <verse eid="ACT 16:26"/><verse number="27" style="v" sid="ACT 16:27"/>Ka jarit od twech nochiewo monwangʼo ka dhout od twech duto oyawore, nowuodho liganglane mondo onegrego, koparo ni joma otwe duto noseringo otony. <verse eid="ACT 16:27"/><verse number="28" style="v" sid="ACT 16:28"/>To Paulo nokok matek kawacho niya, “Kik ihinyri! Wantie waduto!”<verse eid="ACT 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29"/>Jarit od twech nokwayo taya, mi noringo ir Paulo gi Sila, mopodho e nyimgi kokirni. <verse eid="ACT 16:29"/><verse number="30" style="v" sid="ACT 16:30"/>Bangʼe nogologi oko eka openjogi niya, “Jodongo, atim angʼo mondo owara?”<verse eid="ACT 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31"/>Negidwoke niya, “Yie kuom Ruoth Yesu eka nikwo, in kaachiel gi joodi.” <verse eid="ACT 16:31"/><verse number="32" style="v" sid="ACT 16:32"/>Eka ne gipuonje Wach Ruoth, kod ji duto mane ni e ode. <verse eid="ACT 16:32"/><verse number="33" style="v" sid="ACT 16:33"/>E sa nogono mar otieno, jarit od twech nokawogi modhi olwokonegi adhondegi, bangʼe gikanyono nobatise, en kaachiel gi joode duto. <verse eid="ACT 16:33"/><verse number="34" style="v" sid="ACT 16:34"/>Eka jarit od twech noterogi e ode momiyogi chiemo. Joodno duto nopongʼ gi mor, nikech koro ne giseyie kuom Nyasaye.<verse eid="ACT 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35"/>Kane piny oyawore, jangʼad bura nooro askechene ir jarit od twech komiye chik niya, “Weuru jogo thuolo oa odhi.” <verse eid="ACT 16:35"/><verse number="36" style="v" sid="ACT 16:36"/>Omiyo jarit od twech nowachone Paulo niya, “Jangʼad bura osegolo chik mondo ogonyu, in kaachiel gi Sila. Koro unyalo aa mondo udhi kendo dhiuru gi kwe.”<verse eid="ACT 16:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37"/>To Paulo nowachone askechego niya, “Ne gichwadowa e lela ka ok gikwongo giyalowa, mi giterowa e od twech kata obedo ni wan jo-Rumi. To koro sani gidwaro golowa e od twech nangʼo lingʼ-lingʼ? Ooyo, gibi abiya mondo gin giwegi ema gigolwa.”<verse eid="ACT 16:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38"/>Askechego nodwoko wachno ni jongʼad bura, to kane giwinjo ni Paulo gi Sila ne gin jo-Rumi, luoro nomakogi. <verse eid="ACT 16:38"/><verse number="39" style="v" sid="ACT 16:39"/>Negibiro mi giywagore nigi, eka ne gigologi oko e od twech, ka gisayogi mondo gia e dalano. <verse eid="ACT 16:39"/><verse number="40" style="v" sid="ACT 16:40"/>Kane Paulo gi Sila osewuok e od twech, negidhi od Ludia, kendo kuno ne girome gi jowete mi gijiwogi. Bangʼe negia gidhi.<verse eid="ACT 16:40"/></para>
  <chapter eid="ACT 16"/>
  <chapter number="17" style="c" sid="ACT 17"/>
  <para style="s1">Paulo gi Sila ochopo Thesalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1"/>Kane gisekalo Amfipoli gi Apolonia, ne gitundo Thesalonika, kuma ne nitie sinagogi moro mar jo-Yahudi. <verse eid="ACT 17:1"/><verse number="2" style="v" sid="ACT 17:2"/>Kaka Paulo ne jatimo pile, ne odonjo e od lemono, kendo kuom Sabato adek moluwore, nopimo kodgi wach kuom weche mondiki e Muma. <verse eid="ACT 17:2"/><verse number="3" style="v" sid="ACT 17:3"/>Noleronigi tiendgi kendo nomiyo gingʼeyo gadiera ni Kristo ne nyaka sandi eka bangʼe ochier oa kuom joma otho. Nowachonegi niya, “Yesu ma ayalonuni e Kristo.” <verse eid="ACT 17:3"/><verse number="4" style="v" sid="ACT 17:4"/>Jomoko kuom jo-Yahudi ne wach oywayo kendo ne giyie mi giluwo Paulo gi Sila, mana kaka jo-Yunani moluoro Nyasaye mathoth kaachiel gi mon moko mongʼere bende noyie.<verse eid="ACT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5"/>To jo-Yahudi mamoko ne nyiego omako; omiyo negidhi gichoko acheje moko mane bayo e chiro kanyo, eka negichoko oganda maduongʼ mar joma achejego, kendo negichako lweny e dalano. Ne gimwomore e od Jason, ka gimanyo Paulo gi Sila, mondo gigolgi oko ni oganda. <verse eid="ACT 17:5"/><verse number="6" style="v" sid="ACT 17:6"/>To kane ok giyudogi, ne giywayo Jason kod jowete moko e nyim jotend dalano. Negigoyo koko kagiwacho niya, “Jok mosekelo chandruok e piny kuonde duto koro osechopo ka, <verse eid="ACT 17:6"/><verse number="7" style="v" sid="ACT 17:7"/>kendo Jason-ni ema oserwakogi e ode. Giduto gidagi luwo chike Kaisar, kagiwacho ni nitie ruoth machielo, miluongo ni Yesu.” <verse eid="ACT 17:7"/><verse number="8" style="v" sid="ACT 17:8"/>Kane giwinjo wechegi, oganda mane osechokore kanyo kod jotelo mag dalano nogoyo koko. <verse eid="ACT 17:8"/><verse number="9" style="v" sid="ACT 17:9"/>Jotelogo noketo ne Jason gi joge mamoko nengo mar singruok ni ok ginichak gikel koko kendo, bangʼe ne giweyogi gidhi.<verse eid="ACT 17:9"/></para>
  <para style="s1">Paulo gi Saulo ochopo Berea</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10"/>Kane piny oimore, jowete nooro Paulo gi Sila Berea. Kane gichopo, negidonjo e sinagogi mar jo-Yahudi. <verse eid="ACT 17:10"/><verse number="11" style="v" sid="ACT 17:11"/>To jo-Berea ne nigi kido maber moloyo jo-Thesalonika, nikech negirwako wach gi chuny mamor, kendo neginono Ndiko pile ka pile, mondo gine ane ka gik mane Paulo wacho gin adier. <verse eid="ACT 17:11"/><verse number="12" style="v" sid="ACT 17:12"/>Jo-Yahudi mathoth noyie, kaachiel gi mon mathoth ma jo-Yunani mongʼere, kod jo-Yunani mangʼeny machwo.<verse eid="ACT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13"/>Ka jo-Yahudi manodak Thesalonika nowinjo ni Paulo ne yalo wach Nyasaye Berea, negidhi kuno bende, kendo negichoko oganda mondo ochak koko, ka giketho chuny ji. <verse eid="ACT 17:13"/><verse number="14" style="v" sid="ACT 17:14"/>Jowete nooro Paulo e dho nam ma ok odeko, ka Sila gi Timotheo to jodong Berea. <verse eid="ACT 17:14"/><verse number="15" style="v" sid="ACT 17:15"/>Joma ne odhi gi Paulo notere nyaka Athene, bangʼe negidok Berea mi ginyiso Sila gi Timotheo yo mane ginyalo chopogo ir Paulo mapiyo.<verse eid="ACT 17:15"/></para>
  <para style="s1">Paulo gi Sila ochopo Athene</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16"/>Kane Paulo pod rito Sila gi Timotheo Athene, chunye nosin kane oneno kaka jo-dalano noketo chunygi kuom lamo kido mag nyiseche manono. <verse eid="ACT 17:16"/><verse number="17" style="v" sid="ACT 17:17"/>Omiyo nowuoyo kod jo-Yahudi gi jo-Yunani moluoro Nyasaye e sinagogi. Bende pile pile nowuoyo gi ji mane budho e chiro e dalano. <verse eid="ACT 17:17"/><verse number="18" style="v" sid="ACT 17:18"/>Jorieko moko mag Epikurio kod Stoiko nochako mino kode wach. Moko kuomgi nopenjo niya, “Angʼo ma jawach thoreni temo wacho?” To moko nowacho niya, “Chal ka gima oyalo kuom nyiseche moko ma welo.” Negiwacho kamano nikech Paulo ne yalo kuom Yesu kendo kuom chier. <verse eid="ACT 17:18"/><verse number="19" style="v" sid="ACT 17:19"/>Eka ne gikawe mi gidhi kode kar romo margi miluongo ni Areopago, bangʼe gipenje niya, “Donge dinyiswae tiend puonj manyien mikelo kaeni? <verse eid="ACT 17:19"/><verse number="20" style="v" sid="ACT 17:20"/>Isako itwa gi puonj manyien mapok wawinjo, omiyo wadwaro ngʼeyo tiendgi.” <verse eid="ACT 17:20"/><verse number="21" style="v" sid="ACT 17:21"/>(Jo-Athene duto kod jopinje mamoko mane odak kanyo nohero ketho sechegi kanyo ka gigoyo mbaka kendo giwinjo paro gi rieko manyien.)<verse eid="ACT 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22"/>Eka Paulo nochungʼ e nyim chokruok mane ni ei Areopago mochako wuoyo kowacho niya, “Un jo-Athene, ayudo ni un joma ohero lemo e ngimau duto. <verse eid="ACT 17:22"/><verse number="23" style="v" sid="ACT 17:23"/>Nikech kane awuotho kalworora ka anono malongʼo kuondeu mag lemo, to ne ayudo nyaka kendo mar misango mondikie niya,</para>
  <para style="pc" vid="ACT 17:23">‘Ne nyasaye ma ok ongʼe’.</para>
  <para style="m" vid="ACT 17:23">Koro gima ulamo kaka gima ok ongʼe ema adwaro yalonu.<verse eid="ACT 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 17:24"/>“Nyasaye mane ochweyo piny kaachiel gi gik moko duto manie iye en Ruodh polo gi piny, kendo ok odak ei hekalu ma oger gi lwet dhano, <verse eid="ACT 17:24"/><verse number="25" style="v" sid="ACT 17:25"/>bende ok tine gi lwet dhano ka gima odwaro gimoro kuom dhano nikech en owuon ema ochiwo ne dhano, ngima gi muya mi yweyo kod gik moko duto. <verse eid="ACT 17:25"/><verse number="26" style="v" sid="ACT 17:26"/>Koa kuom dhano achiel, nochweyo ogendini duto mag ji, mondo gipongʼ piny duto, kendo en ema oketo ni ngʼato ka ngʼato kar romb higni monego odag-go e piny, kod kuonde monego gidagie. <verse eid="ACT 17:26"/><verse number="27" style="v" sid="ACT 17:27"/>Nyasaye notimo ma mondo ji obed gi chuny madware kendo mondo kanyalore to gichop kuma entie, mi giyude, kata obedo ni ok en mabor kodwa. <verse eid="ACT 17:27"/><verse number="28" style="v" sid="ACT 17:28"/>‘Wangima nikech En, kendo wawuotho nikech En, kendo wantie nikech En.’ En mana kaka jowendu moko osewacho ni, ‘Wan bende wan kothe.’<verse eid="ACT 17:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29"/>“Ka wan koth Nyasaye kamano, to koro ok onego wapar ni Nyasaye chalo gi dhahabu kata gi fedha kata kidi, ma gin mana kido ma dhano oloso kendo oketo gi pache. <verse eid="ACT 17:29"/><verse number="30" style="v" sid="ACT 17:30"/>E kinde mokalo Nyasaye ne ok odewo fuwo machal kamano, to koro sani osegolo chik ni ji duto kamoro amora mondo olokre owe richo. <verse eid="ACT 17:30"/><verse number="31" style="v" sid="ACT 17:31"/>Nikech oseketo chiengʼ mobiro ngʼadoe bura ne piny duto gadiera, kokalo kuom ngʼat moseyiero. Bende osenyiso ji malongʼo ni obiro timo mano ni ji duto, nikech nochiere oa kuom joma otho.”<verse eid="ACT 17:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32"/>Kane jogo owinjo ka Paulo wuoyo kuom wach chier aa kuom joma otho, moko kuomgi nojare, to moko to nowachone niya, “Wabiro dwaro mondo iwuo kodwa kendo e wachni.” <verse eid="ACT 17:32"/><verse number="33" style="v" sid="ACT 17:33"/>Eka Paulo nowuok moweyo joburago. <verse eid="ACT 17:33"/><verse number="34" style="v" sid="ACT 17:34"/>Ji moko manok nodok kor Paulo, mi giyie kuom Kristo. Achiel kuom joma noyie ne en Dionusio, mane en jabuch Areopago, gi dhako moro ma nyinge Damaris, kod ji mamoko manok.<verse eid="ACT 17:34"/></para>
  <chapter eid="ACT 17"/>
  <chapter number="18" style="c" sid="ACT 18"/>
  <para style="s1">Paulo ochopo Korintho</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1"/>Bangʼ mano, Paulo noa Athene modhi Korintho. <verse eid="ACT 18:1"/><verse number="2" style="v" sid="ACT 18:2"/>Kuno nonwangʼo ja-Yahudi moro mane onywol Ponto miluongo ni Akula. Ngʼatno noyudo odar oa Italia gi chiege Priskila, nikech ruoth Klaudio nosegolo chik mondo jo-Yahudi duto odar oa Rumi. Paulo nodhi limogi, <verse eid="ACT 18:2"/><verse number="3" style="v" sid="ACT 18:3"/>mi odak kodgi kendo tiyo kodgi nikech en bende ne en jatwangʼ hema mana kaka gin. <verse eid="ACT 18:3"/><verse number="4" style="v" sid="ACT 18:4"/>To Sabato ka Sabato, ne opuonjo ji e sinagogi, kotemo loko jo-Yahudi gi jo-Yunani.<verse eid="ACT 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5"/>Kane Sila gi Timotheo obiro koa Makedonia, Paulo nochiwore ni tich mar lando Injili kende ma ok oriwo gi gimachielo; kotimo neno ne jo-Yahudi ni Yesu e Kristo. <verse eid="ACT 18:5"/><verse number="6" style="v" sid="ACT 18:6"/>To ka jo-Yahudi nodagi wachne mi ochako yanye, Paulo notengʼonigi lepe kosiemogi niya, “Rembu mondo odongʼ ewiu uwegi! An asetimo tichna kaka dwarore. Chakre kawuono abiro dhi lando Injili ne joma ok jo-Yahudi.”<verse eid="ACT 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7"/>Eka Paulo noa e sinagogi modhi e ot moro mane okiewo machiegni gi sinagogi. Wuon odno ne iluongo ni Titio Justo, kendo ne en ngʼat moluoro Nyasaye. <verse eid="ACT 18:7"/><verse number="8" style="v" sid="ACT 18:8"/>To Krispo, mane en jatend sinagogi, kod joode duto, noyie kuom Ruoth kendo jo-Korintho mamoko mangʼeny bende nowinjo Paulo moyie kendo obatisi.<verse eid="ACT 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9"/>Otieno moro Ruoth Nyasaye nowuoyo gi Paulo e yor fweny kawachone niya, <char style="wj">“Kik iluor. Dhi adhiya nyime gi wuoyo ma ok ilingʼ.</char> <verse eid="ACT 18:9"/><verse number="10" style="v" sid="ACT 18:10"/><char style="wj">An kodi, kendo onge ngʼato mabiro buki mi hinyi, nikech an gi ji mangʼeny e dalani.”</char> <verse eid="ACT 18:10"/><verse number="11" style="v" sid="ACT 18:11"/>Kuom mano, Paulo nodak kuno kuom higa achiel gi nus, kopuonjo ji wach Nyasaye.<verse eid="ACT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12"/>Kane oyudo Galio en ruodh Akaya, jo-Yahudi noriwo ni Paulo mi negimake gitere e od bura, <verse eid="ACT 18:12"/><verse number="13" style="v" sid="ACT 18:13"/>kendo gidonjone kagiwacho niya, “Ngʼatni loko ji mondo olam Nyasaye e yo ma chik ok oyie.”<verse eid="ACT 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14"/>To kane oyudo Paulo dwaro wuoyo, Galio nowacho ni jo-Yahudi niya, “Dine bedi ni ywaku ni kuom wach ketho chik kata tim achach ma ngʼatni osetimo, to dine awinjou. <verse eid="ACT 18:14"/><verse number="15" style="v" sid="ACT 18:15"/>To kaka chandruoku otenore gi weche gi nyinge kod chikeu uwegi, koro unyalo loso wecheugo kendu. Adagi bedo jangʼad bura e weche ma kamago.” <verse eid="ACT 18:15"/><verse number="16" style="v" sid="ACT 18:16"/>Bangʼ mano noriembogi gia e od bura. <verse eid="ACT 18:16"/><verse number="17" style="v" sid="ACT 18:17"/>Eka jo-Yunani duto nochako toyo mirimbgi kuom Sosthene, jaduongʼ sinagogi, mi gichako goye e nyim jobura; kendo Galio ne ok odewogi kata matin.<verse eid="ACT 18:17"/></para>
  <para style="s1">Priskila, Akula kod Apolo</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18"/>Paulo noweyo jowete e dala mar Korintho, kendo nokwangʼ kodhi Siria ka gin kaachiel gi Priskila kod Akula. Kane pok giwuok, ne oliel wi Paulo Kenkrea, nikech singruok moro mane osetimo. <verse eid="ACT 18:18"/><verse number="19" style="v" sid="ACT 18:19"/>Kane gichopo Efeso, Paulo noweyo Priskila gi Akula. Nodonjo e sinagogi ka en kende en owuon ei sinagogi mi owuoyo kod jo-Yahudi mane ni kanyo. <verse eid="ACT 18:19"/><verse number="20" style="v" sid="ACT 18:20"/>Jo-Yahudigo nokwaye mondo omed bedo kodgi kanyo to notamore. <verse eid="ACT 18:20"/><verse number="21" style="v" sid="ACT 18:21"/>To kane oweyogi mondo odhi, nowachonegi niya, “Ka en dwaro mar Nyasaye, to abiro duogo.” Bangʼe nokwangʼ oa Efeso. <verse eid="ACT 18:21"/><verse number="22" style="v" sid="ACT 18:22"/>Kane ogowo Kaisaria, nodhi mi omoso kanisa, eka bangʼe nodhi Antiokia.<verse eid="ACT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 18:23"/>Kane osebedo Antiokia kuom ndalo mogwarore, Paulo nowuok oa kanyo, mi nowuotho e gwenge duto mag piny Galatia gi Frugia, kojiwo jopuonjre duto.<verse eid="ACT 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24"/>E kindeno ja-Yahudi moro monywol Aleksandria, ma nyinge Apolo, nobiro Efeso. Ne en gi ngʼeyo matut e puonj mag Muma. <verse eid="ACT 18:24"/><verse number="25" style="v" sid="ACT 18:25"/>Ne osepuonje kuom yor Ruoth, kendo nopuonjo wach Yesu koketo chunye, kata obedo ni nongʼeyo mana batiso mar Johana kende. <verse eid="ACT 18:25"/><verse number="26" style="v" sid="ACT 18:26"/>Nochako wuoyo gi chir e sinagogi, to ka Priskila gi Akula nowinje, ne giluonge e dalagi mine gimedo lerone tiend weche moko kuom yor Nyasaye.<verse eid="ACT 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 18:27"/>Kane Apolo dwaro mondo odhi Akaya, jowete nojiwe mine gindiko baruwa ne jopuonjre man kuno mondo orwake maber. Kane ochopo kuno, nokelo konyruok mangʼeny ne joma noseyie kuom ngʼwono mar Ruoth Nyasaye. <verse eid="ACT 18:27"/><verse number="28" style="v" sid="ACT 18:28"/>Nimar nosiko koloyo jo-Yahudi gi wach moketi e lela konyisogi ratiro kaka Ndiko wacho ni Yesu e Kristo.<verse eid="ACT 18:28"/></para>
  <chapter eid="ACT 18"/>
  <chapter number="19" style="c" sid="ACT 19"/>
  <para style="s1">Paulo odhi Efeso</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1"/>Kane Apolo ni Korintho, Paulo nowuotho e gwenge mamalo, nyaka nochopo Efeso. Kuno noyude jopuonjre moko, <verse eid="ACT 19:1"/><verse number="2" style="v" sid="ACT 19:2"/>mi openjogi niya, “Bende ne uyudo Roho Maler chiengʼ mane uyie kuom Yesu?”</para>
  <para style="p" vid="ACT 19:2">Negidwoke niya, “Ooyo, kata mana winjo pok wawinjo ni nitie gimoro ni Roho Maler.”<verse eid="ACT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3"/>Paulo nomedo penjogi niya, “Ka kamano, to kare batiso mane mane uyudo?”</para>
  <para style="p" vid="ACT 19:3">Negidwoke niya, “Ne wayudo batiso mar Johana.”<verse eid="ACT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4"/>Paulo nowachonegi niya, “Batiso mar Johana ne en mar lokruok weyo richo. Nonyiso ji mondo oyie kuom Jal mane biro bangʼe, ma en Yesu.” <verse eid="ACT 19:4"/><verse number="5" style="v" sid="ACT 19:5"/>Bangʼ winjo mano, nobatisgi e nying Ruoth Yesu. <verse eid="ACT 19:5"/><verse number="6" style="v" sid="ACT 19:6"/>Kane Paulo oketo lwete kuomgi, Roho Maler nolor kuomgi, mine giwuoyo gi dhok mayoreyore kendo ne gikoro wach. <verse eid="ACT 19:6"/><verse number="7" style="v" sid="ACT 19:7"/>Kar romb jogo ne gin chwo apar gariyo.<verse eid="ACT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8"/>Paulo nodonjo e sinagogi mi opuonjo ji gi chir kuom dweche adek. Notemo wuoyo kodgi konyisogi adiera man kuom pinyruodh Nyasaye. <verse eid="ACT 19:8"/><verse number="9" style="v" sid="ACT 19:9"/>To jomoko kuomgi chunygi nodoko matek, ne gidagi yie kendo negichako wuoyo marach kuom jo-Kristo e lela. Omiyo Paulo noweyogi, mi okawo jopuonjre odhigo e od puonjruok mar ngʼat ma nyinge Turano, kuma ne gitwakie pile. <verse eid="ACT 19:9"/><verse number="10" style="v" sid="ACT 19:10"/>Paulo notimo mano kuom higni ariyo, mi jo-Yahudi duto gi jo-Yunani manodak e piny Asia nowinjo wach Ruoth.<verse eid="ACT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11"/>Nyasaye nomiyo Paulo otimo honni madongo, <verse eid="ACT 19:11"/><verse number="12" style="v" sid="ACT 19:12"/>kata mana kitembini kod lewni mane orere kuome noter ni jotuo, mine gichango kuom tuochegi kendo jochiende noa kuomgi.<verse eid="ACT 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13"/>To jo-Yahudi moko mane wuotho koni gi koni kagolo jochiende notemo tiyo gi nying Ruoth Yesu mondo giriemb jochiende kuom ji. Ne gitemo wacho niya, “E nying Yesu ma Paulo yalo, wachiki mondo iwuog oko!” <verse eid="ACT 19:13"/><verse number="14" style="v" sid="ACT 19:14"/>To jadolo maduongʼ moro mar jo-Yahudi miluongo ni Sekewa ne nigi yawuowi abiriyo mane timo kamano. <verse eid="ACT 19:14"/><verse number="15" style="v" sid="ACT 19:15"/>To chiengʼ moro achiel jachien nodwokogi niya, “Yesu to angʼeyo, kendo Paulo bende angʼeyo, to un, to un ngʼa gini?” <verse eid="ACT 19:15"/><verse number="16" style="v" sid="ACT 19:16"/>Eka ngʼat mane nigi jachien-no nopor kuomgi mohewogi duto. Nogoyogi marach mi giringo gia e odno ka gin duge kendo dendgi chwer remo.<verse eid="ACT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 19:17"/>Ka jo-Yahudi gi jo-Yunani mane odak Efeso nowinjo wachno luoro nomakogi, kendo nying Ruoth Yesu noyudo duongʼ. <verse eid="ACT 19:17"/><verse number="18" style="v" sid="ACT 19:18"/>Ji mangʼeny mane oyie kuom Yesu nobiro mohulo richogi e lela. <verse eid="ACT 19:18"/><verse number="19" style="v" sid="ACT 19:19"/>Jomoko kuomgi manosebedo katimo timbe jwok nokelo kitepegi mag thieth mi nowangʼ-gi e lela ka ji duto neno. Kane gikwano nengo kitepego duto mane giwangʼo, neginwangʼo ka nengogi oromo silingʼ alufu piero abich. <verse eid="ACT 19:19"/><verse number="20" style="v" sid="ACT 19:20"/>Kuom mano, Wach Ruoth nomedo landore kendo ne medo bedo gi teko.<verse eid="ACT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21"/>Kane gigo duto osetimore, Paulo nongʼado e chunye mondo odhi Jerusalem, kokadho Makedonia gi Akaya. Nowacho e chunye niya, “Bangʼ dhi Jerusalem, to nyaka alim Rumi bende.” <verse eid="ACT 19:21"/><verse number="22" style="v" sid="ACT 19:22"/>Nooro jokonyne moko ariyo, ma gin Timotheo gi Erasto, nyaka Makedonia, ka en to ne pod odongʼ e piny Asia kuom ndalo moko.<verse eid="ACT 19:22"/></para>
  <para style="s1">Koko owuok Efeso</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23"/>E kindeno koko maduongʼ nowuok kuom wach luwo Yor Kristo. <verse eid="ACT 19:23"/><verse number="24" style="v" sid="ACT 19:24"/>Ngʼat moro ma nyinge Demetrio, mane jathedh fedha, ne loso kido mag hekalu mar nyasaye madhako miluongo ni Artemis, kendo tichneno ne kelo ohala maduongʼ ni jotheth wetene. <verse eid="ACT 19:24"/><verse number="25" style="v" sid="ACT 19:25"/>Demetrio noluongo jotheth wetene duto, kod jotich mamoko ma tijgi ne chal gi margi, mi owachonegi niya, “Yawa, ungʼeyo ni tijwani kelonwa ohala maduongʼ. <verse eid="ACT 19:25"/><verse number="26" style="v" sid="ACT 19:26"/>To koro uneno kendo uwinjo kaka ngʼat miluongo ni Pauloni oseloko ji mathoth Efeso-ka, nyaka e piny Asia duto. Owacho ni nyiseche ma dhano oloso ok gin nyiseche mar adier. <verse eid="ACT 19:26"/><verse number="27" style="v" sid="ACT 19:27"/>Koro wan gi chandruok, ok mana nikech ji biro chayo tijwani mi ohandwani podhi, to bende nikech hekalu mar nyasaye madhako marahuma, ma en Artemis owuon, ibiro chayo, mi Artemis owuon, ma ji lamo e piny Asia, nyaka e piny duto, ok bi ngʼe duongʼne kaka nyasaye!”<verse eid="ACT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28"/>Kane giwinjo wachno, mirima nomakogi mi gichako goyo koko kagiwacho niya, “Artemis mar jo-Efeso duongʼ!” <verse eid="ACT 19:28"/><verse number="29" style="v" sid="ACT 19:29"/>Koko nolandore e dala duto kendo negimako Gayo gi Aristarko ma jo-Makedonia mane jowuodh Paulo kendo ne gimwomore kuomgi ka gichiko pawgi mar tugo. <verse eid="ACT 19:29"/><verse number="30" style="v" sid="ACT 19:30"/>Paulo ne dwaro dhi e diergi mondo owuo kodgi, to jopuonjre notame. <verse eid="ACT 19:30"/><verse number="31" style="v" sid="ACT 19:31"/>Kata moko kuom jotend pinyno mane osiepene, noorone wach kakwaye mondo kik odonj e paw tugono.<verse eid="ACT 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 19:32"/>Chokruok nonjawni. Ji moko ne wacho gimoro achiel, to jomoko ne wacho gimachielo. Ji mangʼeny ne ok ongʼeyo kata gima omiyo ne gin kanyo. <verse eid="ACT 19:32"/><verse number="33" style="v" sid="ACT 19:33"/>Jomoko kuomgi ne paro ni Aleksanda ema oluongo burani nikech negineno ka jo-Yahudi chwale nyime mondo owuo gi ji. Aleksanda notingʼo bade mondo owuo gi ji. <verse eid="ACT 19:33"/><verse number="34" style="v" sid="ACT 19:34"/>To ka ogandano nofwenyo nine en ja-Yahudi, ne gikok gi dwol achiel kuom seche ariyo kagiwacho niya, “Artemis mar jo-Efeso duongʼ!”<verse eid="ACT 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35"/>Bangʼe jagoro morito dalano nopieyo ji kawacho niya, “Un jo-Efeso, donge piny ngima ongʼeyo ni dala mar Efeso ema orito hekalu mar nyasaye marahuma miluongo ni Artemis, kaachiel gi kidone manolwar koa e polo? <verse eid="ACT 19:35"/><verse number="36" style="v" sid="ACT 19:36"/>Kuom mano, kaka wechegi gin adier chuth ma ngʼato ok nyal dagi, weuru goyo koko kendo kik utim tim moro ka ok uparo. <verse eid="ACT 19:36"/><verse number="37" style="v" sid="ACT 19:37"/>Usekelo jogi ka, kata obedo ni ok gisekwalo gimoro e hekalu, kata yanyo nyasachwa madhakoni. <verse eid="ACT 19:37"/><verse number="38" style="v" sid="ACT 19:38"/>Ka dipo ni Demetrio gi jotheth wetene nigi wach gi ngʼato kuomgi, to ute yalo bura oyaw dhogi, kendo joyal bura bende nitie. Kuno ema ginyalo dhi donjo ni joma okethonigi. <verse eid="ACT 19:38"/><verse number="39" style="v" sid="ACT 19:39"/>To ka dipo ni nitie wach moro machielo ma udwaro nolosi, to nyaka lose mana e chokruok ma chik oyiego. <verse eid="ACT 19:39"/><verse number="40" style="v" sid="ACT 19:40"/>To kaka weche chal sani, gik mutimogi biro ketowa e chandruok, nikech ibiro ngʼadnwa bura kaka joma kelo koko. Kuom mano, onge yo moro amora ma wanyalo tonygo e wachni, nikech wasegoyo koko maonge tiende.” <verse eid="ACT 19:40"/><verse number="41" style="v" sid="ACT 19:41"/>Bangʼ kane osewacho wechegi, nogonyo chokruok.<verse eid="ACT 19:41"/></para>
  <chapter eid="ACT 19"/>
  <chapter number="20" style="c" sid="ACT 20"/>
  <para style="s1">Paulo odhi Makedonia kod piny jo-Yunani</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1"/>Kane kokono oserumo, Paulo noluongo jopuonjre ire mojiwogi, to bangʼe nogoyonegi oriti, mi ochako wuodhe mar dhi Makedonia. <verse eid="ACT 20:1"/><verse number="2" style="v" sid="ACT 20:2"/>Nowuotho e gwengʼno kojiwo ji gi weche mangʼeny, eka nochopo e piny jo-Yunani, <verse eid="ACT 20:2"/><verse number="3" style="v" sid="ACT 20:3"/>kuma nobetie kuom dweche adek. To nikech jo-Yahudi ne chano timo ne marach kane oyudo oikore mar dhi Siria, noloko pache mondo odog chien, koluwo Makedonia. <verse eid="ACT 20:3"/><verse number="4" style="v" sid="ACT 20:4"/>Joma nodhi kode ne gin ji kaka Sopata wuod Puro ja-Berea, gi Aristarko kod Sekundo, ma ja-Thesalonika, gi Gayo ja-Derbe, kod Timotheo bende, gi Tukiko kod Trofimo mane gin jo-Asia. <verse eid="ACT 20:4"/><verse number="5" style="v" sid="ACT 20:5"/>Jogi notelo nyimwa mondo oritwa Troa. <verse eid="ACT 20:5"/><verse number="6" style="v" sid="ACT 20:6"/>Wan to ne wakwangʼ ka waa Filipi, bangʼ Sap Makati ma ok oketie Thowi, to bangʼ ndalo abich ne wachopo irgi Troa, kuma ne wabetie kuom ndalo abiriyo.<verse eid="ACT 20:6"/></para>
  <para style="s1">Paulo ochiero Yutiko e piny Troa</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7"/>To Chiengʼ mokwongo mar juma ne wachokore mondo wacham Sap Ruoth. Paulo nopuonjo ji nyaka odiwuor nikech nochano mar aa kinyne gokinyi. <verse eid="ACT 20:7"/><verse number="8" style="v" sid="ACT 20:8"/>Teche mangʼeny ne liel e od gorofa malo kuma ne wachokore. <verse eid="ACT 20:8"/><verse number="9" style="v" sid="ACT 20:9"/>To wuowi moro miluongo ni Yutiko nobet e dho dirisa, kendo nindo nomedo tere ka Paulo ne pod medo puonjo. Kane en e chuny nindo, nolwar gie dirisa koa e gorofa mar adek mi nokwanye piny mwalo kosetho. <verse eid="ACT 20:9"/><verse number="10" style="v" sid="ACT 20:10"/>Paulo nolor piny mi nokwako wuowino. Bangʼe nowacho ni ji niya, “Kik uluor. Ongima!” <verse eid="ACT 20:10"/><verse number="11" style="v" sid="ACT 20:11"/>Eka nodok malo kuma ne entie mi ongʼwenyo makati mochamo. Bangʼe nodhi nyime gipuonjo nyaka piny oru, eka owuok. <verse eid="ACT 20:11"/><verse number="12" style="v" sid="ACT 20:12"/>Ji nokawo wuowino motere dala kongima, kendo chunygi noyudo hoch maduongʼ.<verse eid="ACT 20:12"/></para>
  <para style="s1">Paulo ogoyo oriti ne jodong Efeso</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13"/>Wan to ne watelo nyime nyaka ei yie, mi wakwangʼ nyaka Asos, kuma ne wadhi kawoe Paulo. Nosechano kamano nikech ne odwaro ni mondo odhi kuno kowuotho gi tiende. <verse eid="ACT 20:13"/><verse number="14" style="v" sid="ACT 20:14"/>Kane oyudowa Asos, nodonjo kodwa e yie, mi wadhi nyaka Mitulene. <verse eid="ACT 20:14"/><verse number="15" style="v" sid="ACT 20:15"/>Kinyne ne wakwangʼ ka waa kanyo mi watundo machiegni Kios. To chiengʼ machielo ne wangʼado nam nyaka Samos, to bangʼe ne wachopo Mileto. <verse eid="ACT 20:15"/><verse number="16" style="v" sid="ACT 20:16"/>Paulo nosechano mondo okwangʼ kodhi ma ok oluwo Efeso, nikech ne ok odwar kawo thuolo malach e piny Asia. Nodwaro mondo ochop Jerusalem piyo, kapok chiengʼ Pentekost ochopo.<verse eid="ACT 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17"/>Kane wan Mileto, Paulo nooro wach Efeso mondo oluongne jodong kanisa. <verse eid="ACT 20:17"/><verse number="18" style="v" sid="ACT 20:18"/>Kane gisebiro, nowachonegi niya, “Ungʼeyo maber kaka ngimana ne chalo e kinde mane an kodu ka, kochakore odiechiengʼ mokwongo mane adonjo e piny Asia. <verse eid="ACT 20:18"/><verse number="19" style="v" sid="ACT 20:19"/>Ne atiyo ni Ruoth gi chuny mamuol, kendo gi pi wangʼ, kata obedo ni naneno masiche madongo ka jo-Yahudi chano mondo ohinya. <verse eid="ACT 20:19"/><verse number="20" style="v" sid="ACT 20:20"/>Bende ungʼeyo kaka ne ok aweyo mak anyisou wach moro amora mane nyalo konyou, to napuonjou e lela kendo e uteu, ka adonjo e ot ka ot. <verse eid="ACT 20:20"/><verse number="21" style="v" sid="ACT 20:21"/>Asenyiso jo-Yahudi kaachiel gi jo-Yunani ni nyaka gilokre giwe richogi kendo gidwog ir Nyasaye kendo giyie kuom Ruodhwa Yesu.<verse eid="ACT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22"/>“To sani koro Roho ochuna ni nyaka adhi Jerusalem, ka ok angʼeyo gima dhi timorena kuno. <verse eid="ACT 20:22"/><verse number="23" style="v" sid="ACT 20:23"/>Gima angʼeyo en mana gima Roho Maler nyisa e chunya ni sand kod twech orita e dala ka dala ma adhiye. <verse eid="ACT 20:23"/><verse number="24" style="v" sid="ACT 20:24"/>To kata obedo kamano, ok akwan ngimana ka gima lichna; gima ochuna maduongʼ en mana tieko ngʼweya kendo chopo tich ma Ruoth Yesu osemiya mondo atim, ma en tich mar lando Injili mar ngʼwono mar Nyasaye.<verse eid="ACT 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25"/>“Koro angʼeyo ni onge ngʼato kuomu maseyalone wach kuom pinyruoth manochak onena. <verse eid="ACT 20:25"/><verse number="26" style="v" sid="ACT 20:26"/>Emomiyo awachonu kawuono ni koro remb ngʼato ok ni e wiya, <verse eid="ACT 20:26"/><verse number="27" style="v" sid="ACT 20:27"/>nikech ne ok aweyo ma ok anyisou gik moko duto ma Nyasaye dwaro ni utim. <verse eid="ACT 20:27"/><verse number="28" style="v" sid="ACT 20:28"/>Koro tangʼuru kendo rituru kweth duto ma Roho Maler oketo e lwetu mondo uriti. Beduru jokwath mag Kanisa Nyasaye ma nongʼiewo gi rembe owuon. <verse eid="ACT 20:28"/><verse number="29" style="v" sid="ACT 20:29"/>Angʼeyo maber ni bangʼ ka asea, ondiegi mangemo biro monjou, kendo ok giniwe kweth Nyasaye ngangʼ. <verse eid="ACT 20:29"/><verse number="30" style="v" sid="ACT 20:30"/>Kata mana e dieru ka, jomoko biro wuokie kendo gibiro puonjo weche mobam ma gichwogo kendgi giwegi mondo giywago jopuonjre irgi. <verse eid="ACT 20:30"/><verse number="31" style="v" sid="ACT 20:31"/>Emomiyo beduru motangʼ! Paruru kaka kuom higni adek ne ok aweyo mak asiemo ngʼato ka ngʼato kuomu odiechiengʼ gotieno, ka pi wangʼa chwer.<verse eid="ACT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32"/>“Koro aketou e lwet Nyasaye, kendo kuom wach ngʼwonone, manyalo gerou, kendo manyalo miyo uyud gweth mosekan-nu kaachiel gi jomaler duto. <verse eid="ACT 20:32"/><verse number="33" style="v" sid="ACT 20:33"/>Pok agombo fedha kata dhahabu kata law ngʼato. <verse eid="ACT 20:33"/><verse number="34" style="v" sid="ACT 20:34"/>Un uwegi ungʼeyo ni lwetenagi osetiyo matek mi ochopo dwarona duto, nyaka dwaro mag jowadwa mwayalogo Injili. <verse eid="ACT 20:34"/><verse number="35" style="v" sid="ACT 20:35"/>Asenyisou gi yore duto ni nyaka wati matek wan wawegi mondo wakonygo joma chandore, ka waparo wach mane Ruoth Yesu owachonwa ni, <char style="wj">‘Chiwo kelo gweth moloyo kawo!’</char> ”<verse eid="ACT 20:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36"/>Kane Paulo osetieko wacho wechegi, nogoyo chonge piny kaachiel kodgi duto mi nolemo. <verse eid="ACT 20:36"/><verse number="37" style="v" sid="ACT 20:37"/>Ji duto ne oywak, ka gipodho kuome kendo ginyodhe. <verse eid="ACT 20:37"/><verse number="38" style="v" sid="ACT 20:38"/>Gima ne litnegi ahinya ne en gima nowacho ni ne ok gibi nene kendo. Bangʼ mano ne gikowe ei yie.<verse eid="ACT 20:38"/></para>
  <chapter eid="ACT 20"/>
  <chapter number="21" style="c" sid="ACT 21"/>
  <para style="s1">Wuodh Paulo kodhi Jerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1"/>Bangʼ kane wasegoyonegi oriti, ne wasiayo yie mi wakwangʼ e dier nam tir nyaka chula mar Kos. Kinyne ne watundo e chula mar Rodos, kendo kane waa kanyo, to ne wadhi mi wachopo Patara. <verse eid="ACT 21:1"/><verse number="2" style="v" sid="ACT 21:2"/>Kuno newanwangʼe yie madhi Foinike, mine waidho kendo wachako kwangʼ. <verse eid="ACT 21:2"/><verse number="3" style="v" sid="ACT 21:3"/>Kane wasechopo kama koro ne wanyalo nenogo Saipras, ka waluwo yo modok milambo mare, ne wakwangʼ kwachomo Siria, mine wagowo Turo kama ne idhi lorie gik mane yiewa otingʼo. <verse eid="ACT 21:3"/><verse number="4" style="v" sid="ACT 21:4"/>Ne wayudo jopuonjre kuno, kendo ne wabet kodgi kuom ndalo abiriyo. Kaka Roho Maler notelonigi, neginyiso Paulo ni kik odhi Jerusalem. <verse eid="ACT 21:4"/><verse number="5" style="v" sid="ACT 21:5"/>Kata kamano, ka ndalo mane onego wabedgo kodgi norumo, ne wawuok kendo wadhi nyime gi wuodhwa. Jopuonjre duto, kaachiel gi mondegi kod nyithindgi, ne okowowa nyaka oko mar dalano, kendo kane wachopo e dho nam, to ne wagoyo chongwa piny mi walemo. <verse eid="ACT 21:5"/><verse number="6" style="v" sid="ACT 21:6"/>Eka ne wagoyonegi oriti, bangʼe wadonjo e yie, ka gin to gidok miechgi.<verse eid="ACT 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7"/>Ne wadhi nyime gi wuodhwa ka waa Turo, nyaka ne wagowo Potolomai, kuma ne wamosoe jowete, kendo ne wabet kodgi kuom odiechiengʼ achiel. <verse eid="ACT 21:7"/><verse number="8" style="v" sid="ACT 21:8"/>Kinyne ne wawuok kanyo mi wachopo Kaisaria, kendo ne wabet e od Filipo jayalo, mane en achiel kuom jokony abiriyo. <verse eid="ACT 21:8"/><verse number="9" style="v" sid="ACT 21:9"/>Filipo ne nigi nyiri angʼwen mapok okendi mane gin johul wach.<verse eid="ACT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10"/>Kane wasebet kodgi kuom ndalo moko, janabi ma nyinge Agaba nobiro irwa koa Judea. <verse eid="ACT 21:10"/><verse number="11" style="v" sid="ACT 21:11"/>Kane ngʼatni ochopo irwa, nokawo okanda mar Paulo motweyogo bedene gi tiendene owuon, kendo owacho niya, “Roho Maler wacho kama: ‘Mana kaka atweyorani e kaka jo-Yahudi man Jerusalem biro tweyo wuon okandani mi gichiwe e lwet joma ok jo-Yahudi.’ ”<verse eid="ACT 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12"/>Kane wawinjo wachno, wan kaachiel gi ji duto, ne wasayo Paulo mondo kik odhi Jerusalem. <verse eid="ACT 21:12"/><verse number="13" style="v" sid="ACT 21:13"/>To nodwokowa kowacho niya, “Angʼo momiyo uywak kendo unego chunya? An aikora ok mana ni twech kende, to kata ni tho e Jerusalem kuno, nikech nying Ruoth Yesu.” <verse eid="ACT 21:13"/><verse number="14" style="v" sid="ACT 21:14"/>Kane wayudo ni ok onyal loko pache, to ne waweyo wachno, mi wawacho niya, “Ruoth Nyasaye mondo otim dwarone.”<verse eid="ACT 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15"/>Bangʼ mano ne waikore mi wadhi nyaka Jerusalem. <verse eid="ACT 21:15"/><verse number="16" style="v" sid="ACT 21:16"/>Jopuonjre moko moa Kaisaria bende nodhi kodwa nyaka dala Manason, kama nonego wadagie. Manason ne en ja-Saipras, kendo ne en achiel kuom jopuonjre mane okwongo yie kuom Ruoth.<verse eid="ACT 21:16"/></para>
  <para style="s1">Paulo ochopo Jerusalem</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17"/>Kane wachopo Jerusalem, jowete norwakowa gi mor. <verse eid="ACT 21:17"/><verse number="18" style="v" sid="ACT 21:18"/>Kinyne Paulo kaachiel kodwa nodhi mondo one Jakobo kendo jodongo duto nochokore kodwa. <verse eid="ACT 21:18"/><verse number="19" style="v" sid="ACT 21:19"/>Paulo nomosogi, eka nonyisogi weche duto kuom gik mane Nyasaye osetimo e kind joma ok jo-Yahudi e tichne mar lando Injili.<verse eid="ACT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 21:20"/>Kane giwinjo mano, negipako Nyasaye, eka giwacho ni Paulo niya, “Owadwa Paulo, inyalo neno kaka jo-Yahudi gana gi gana oseyie kuom Ruoth Yesu, kendo kargi giduto giketo chunygi kuom luwo Chik. <verse eid="ACT 21:20"/><verse number="21" style="v" sid="ACT 21:21"/>Osenyisgi ni ipuonjo jo-Yahudi modak e kind joma ok jo-Yahudi duto mondo kik gilu Chike Musa, kisemogi mondo kik giter nyithindgi nyangu kata kik gilu timbewa. <verse eid="ACT 21:21"/><verse number="22" style="v" sid="ACT 21:22"/>Koro wanyalo timo angʼo? Wangʼeyo ni gibiro ngʼeyo maonge kiawa ni isechopo ka, <verse eid="ACT 21:22"/><verse number="23" style="v" sid="ACT 21:23"/>omiyo yie kodwa mondo itim kaka wanyisi. Nitie chwo angʼwen e dierwa ka mosetimo singruok. <verse eid="ACT 21:23"/><verse number="24" style="v" sid="ACT 21:24"/>Kaw jogi mondo idhi ipwodhri kaachiel kodgi, bangʼe ichulnegi nengo mar misengini monego gichul bangʼ pwodhruok, eka oliel yie wigi. Kitimo kamano, to ji duto biro kawo weche duto ma ji wacho kuomi kaka miriambo, kendo gibiro kawi kaka ngʼat moluwo Chik Musa. <verse eid="ACT 21:24"/><verse number="25" style="v" sid="ACT 21:25"/>To kuom joma ok jo-Yahudi moyie, wasendikonegi kuom gimane buchwa ongʼado ni kik gicham chiemo motimgo misango ni nyiseche manono, kik ucham remo, gi ring jamni mode, kendo ni kik giterre.”<verse eid="ACT 21:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26"/>Kinyne Paulo nokawo jogo mi nopwodhore kaachiel kodgi, eka nodonjo e hekalu mondo onyisgi chiengʼ ma pwodhruokno norume, kod odiechiengʼ ma notimnie misango ni ngʼato ka ngʼato.<verse eid="ACT 21:26"/></para>
  <para style="s1">Omak Paulo</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27"/>Kane ndalo abiriyo mag pwodhruok chiegni rumo, jo-Yahudi moko moa e piny Asia noneno Paulo ei hekalu. Ne githuwo ji duto kode mi gimake, <verse eid="ACT 21:27"/><verse number="28" style="v" sid="ACT 21:28"/>ka gikok niya, “Jo-Israel, konywauru. Ma e ngʼat mapuonjo ji duto kamoro amora modhiye mondo gibed mamon kod jowa, gi chikewa kod hekaluwani. Kata sani osekelo nyaka jo-Yunani ei hekalu ka, mi odwanyo kama lerni.” <verse eid="ACT 21:28"/><verse number="29" style="v" sid="ACT 21:29"/>(Noyudo giseneno Trofimo ja-Efeso ka nigi Paulo e Jerusalem mi giparo ni dipo ka Paulo nosedonjo nyaka ei hekalu.)<verse eid="ACT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30"/>Wachno nomiyo koko ochakore ei Jerusalem duto, kendo ji moa koni gi koni nobiro karingo. Negimako Paulo mi giywaye gigole ei hekalu, bangʼe giloro dhorangeye duto. <verse eid="ACT 21:30"/><verse number="31" style="v" sid="ACT 21:31"/>Kane gichako goye mondo ginege, wach nochopo ni jatend lweny mar jo-Rumi, ni dala Jerusalem duto otimo koko. <verse eid="ACT 21:31"/><verse number="32" style="v" sid="ACT 21:32"/>Kuom mano, nokawo jotelo moko gi jolweny mi oringo odhi kodgi nyaka kuma ne oganda ochokore. Kane jokokogo oneno jatend lweny gi jolweny mane ni kode, ne giweyo goyo Paulo.<verse eid="ACT 21:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 21:33"/>Jatelono nobiro momako Paulo, kendo nogolo chik mondo otweye gi nyoroche ariyo. Bangʼe nopenjogi niya, “Ngʼatni en ngʼa? To osetimo angʼo?” <verse eid="ACT 21:33"/><verse number="34" style="v" sid="ACT 21:34"/>Jomoko e chokruokno nokok kawacho gimoro achiel to jomoko ne wacho gimachielo makoro jatend lweny ne ok nyal ngʼeyo malongʼo gima notimore nikech koko, omiyo nogolo chik mondo oter Paulo kama askeche odakie. <verse eid="ACT 21:34"/><verse number="35" style="v" sid="ACT 21:35"/>Kane Paulo ochopo e ndiri midonjogo ka jolweny, jogo koro ne ger marach mi nochuno askeche mondo otingʼe. <verse eid="ACT 21:35"/><verse number="36" style="v" sid="ACT 21:36"/>Ogandano mane oluwogi nosiko kakok niya, “Negeuru.”<verse eid="ACT 21:36"/></para>
  <para style="s1">Paulo owuoyo gi oganda</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37"/>Kane jolweny koro chiegni donjo gi Paulo kama gidakie, nokwayo jatendgi kowacho niya, “Yiena mondo awachni wach moro.”</para>
  <para style="p" vid="ACT 21:37">Jatend jolweny nodwoke kapenje niya, “Kare ingʼeyo dho jo-Yunani? <verse eid="ACT 21:37"/><verse number="38" style="v" sid="ACT 21:38"/>Donge aparo ni in e ja-Misri manyocha ochako koko e dalani kotelo ni jo-mahundu alufu angʼwen momanore gi gige lweny, nyaka e thim?”<verse eid="ACT 21:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39"/>Paulo nodwoke niya, “An ja-Yahudi monywol Tarso, e piny Kilikia. Kuom mano, ok aa e dala moro matin minyalo chayo. Kiyie, to miya thuolo awuo gi jogi.”<verse eid="ACT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40"/>Kane jatend lweny osemiye thuolo mondo owuo, Paulo nochungʼ e raidhi, motingʼo ni ji bade mondo gilingʼ. Kane giselingʼ nowuoyo kodgi gi dho jo-Hibrania kowacho niya:<verse eid="ACT 21:40"/></para>
  <chapter eid="ACT 21"/>
  <chapter number="22" style="c" sid="ACT 22"/>
  <para style="nb">
    <verse number="1" style="v" sid="ACT 22:1"/>“Owetena gi wuonena, koro winjuru wechena manyisou ni aonge ketho.”<verse eid="ACT 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 22:2"/>Kane giwinjo kowuoyonegi gi dho jo-Hibrania kamano, negilingʼ thi.</para>
  <para style="p" vid="ACT 22:2">Eka Paulo nowacho niya, <verse eid="ACT 22:2"/><verse number="3" style="v" sid="ACT 22:3"/>“An ja-Yahudi monywol Tarso, e piny Kilikia, to ne adongo Jerusalem ka. Ne ayudo tiegruok matut e chike mag kwerewa e bwo Gamaliel, kendo ne achiwora ne Nyasaye mana kaka koro un bende uchaloni. <verse eid="ACT 22:3"/><verse number="4" style="v" sid="ACT 22:4"/>Ne asando joma luwo Yor Kristo mi anego moko kuomgi, to ne amako chwo gi mon mi atero e od twech. <verse eid="ACT 22:4"/><verse number="5" style="v" sid="ACT 22:5"/>Jadolo maduongʼ gi jodongo duto nyalo bedo joneno ni awacho adier. Gin ema negimiya barupe mane omiya thuolo mar mako owetegi man Damaski, kendo ne adhi kuno mondo amak joma oyie mondo kel Jerusalem kaka joma otwe mondo okumgi.<verse eid="ACT 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6"/>“Kar dier odiechiengʼ tir kane achiegni chopo Damaski, ne apo ka ler mangʼangʼni moa e polo nomenya molwora. <verse eid="ACT 22:6"/><verse number="7" style="v" sid="ACT 22:7"/>Ne agora piny kendo ne awinjo dwol moro kawachona ni, <char style="wj">‘Saulo! Saulo! Isanda nangʼo?’</char> <verse eid="ACT 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 22:8"/>“Napenjo ni, ‘In ngʼa, Ruoth?’</para>
  <para style="p" vid="ACT 22:8">“To nodwoka ni, <char style="wj">‘An Yesu ja-Nazareth, ma isando.’</char> <verse eid="ACT 22:8"/><verse number="9" style="v" sid="ACT 22:9"/>Joma ne wan-go bende noneno lerno, to ne ok giwinjo dwond ngʼat mane wuoyo kodano.<verse eid="ACT 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 22:10"/>“Eka napenjo ni, ‘Atim angʼo, Ruoth.’ </para>
  <para style="p" vid="ACT 22:10">“To Ruoth nodwoka ni, <char style="wj">‘Aa malo mondo idonji Damaski. Kuno ema ibiro nyisi gik moko duto moseyieri mondo itim.’</char> <verse eid="ACT 22:10"/><verse number="11" style="v" sid="ACT 22:11"/>Joma ne awuothogo nomako bada kagitaya ka wachomo Damaski, nikech ler mangʼangʼni mane oserieny cha noseloka muofu.<verse eid="ACT 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12"/>“Ngʼat moro miluongo ni Anania nobiro mondo onena. Ne en ngʼat morito Chik Nyasaye gi chunye duto kendo ma jo-Yahudi duto modak e dalano nomiye luor. <verse eid="ACT 22:12"/><verse number="13" style="v" sid="ACT 22:13"/>Nochungʼ e batha mowachona niya, ‘Owadwa Saulo, nen!’ Kendo gikanyono ne aneno mi angʼiye.<verse eid="ACT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 22:14"/>“Eka nowachona ni, ‘Nyasach kwerewa oseyieri mondo ingʼe dwarone kendo ine Jatichne Makare, kendo iwinj dwonde kowuoyo kodi. <verse eid="ACT 22:14"/><verse number="15" style="v" sid="ACT 22:15"/>Ibiro bedo janeno ni ji duto, kuom gima iseneno kendo isewinjo. <verse eid="ACT 22:15"/><verse number="16" style="v" sid="ACT 22:16"/>Koro pod irito angʼo? Aa malo mondo obatisi, mondo olwokni richoni, kiluongo nying Ruoth Yesu.’ <verse eid="ACT 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17"/>“Kane aseduogo Jerusalem kendo kane oyudo alemo ei hekalu, nindo notera <verse eid="ACT 22:17"/><verse number="18" style="v" sid="ACT 22:18"/>kendo ne aneno Ruoth mowuoyo koda kowachona ni, <char style="wj">‘Wuog mapiyo ia Jerusalem sani sani nikech ok gibi yie gi neno mitimo kuoma.’</char><verse eid="ACT 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 22:19"/>“An to ne adwoke niya, ‘Ruoth, jogi ongʼeyo kaka nawuotho e sinagogi ka sinagogi mondo atwe kendo asandi joma oyie kuomi. <verse eid="ACT 22:19"/><verse number="20" style="v" sid="ACT 22:20"/>Kane ochwer remb jatichni Stefano, ne achungʼ kanyo kayie gi nekne kendo ne arito lep joma ne nege.’<verse eid="ACT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 22:21"/>“Eka Ruoth nowachona ni, <char style="wj">‘Wuogi idhiyo, nikech abiro ori kuma bor ir joma ok jo-Yahudi.’</char> ”<verse eid="ACT 22:21"/></para>
  <para style="s1">Paulo ja-Rumi</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22"/>Ogandano nochiko itgi kawinjo gik mane Paulo wacho, eka negichako kok giduto kagiwacho niya, “Neguru ngʼatni! Ok owinjore obed mangima!”<verse eid="ACT 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 22:23"/>Kane pod gikok ka gikwadho lepgi kendo gikiro bura e kor yamo, <verse eid="ACT 22:23"/><verse number="24" style="v" sid="ACT 22:24"/>jaduongʼ lweny nogolo chik mondo oter Paulo kama jolweny odakie. Nogolo chik mondo ochwade kendo onone kuom gima omiyo ji goyone koko kamano. <verse eid="ACT 22:24"/><verse number="25" style="v" sid="ACT 22:25"/>To kane oyudo gipiele piny mondo gichwade, Paulo nowacho ni jatend jolweny manoyudo ochungʼ kanyo niya, “Bende chik oyie mondo uchwad ngʼat ma ja-Rumi kapok oyale mi oyudi ni en jaketho?”<verse eid="ACT 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26"/>Kane jatelono owinjo mano, nodhi ir jatend jolweny maduongʼ monyise wachno. Nowachone niya, “Idwaro timo nangʼo? Ngʼatni en ja-Rumi?”<verse eid="ACT 22:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27"/>Jatend jolweny maduongʼ nodhi ir Paulo mopenje niya, “Nyisa ane! In ja-Rumi?”</para>
  <para style="p" vid="ACT 22:27">Paulo nodwoke niya, “Ee, an ja-Rumi.”<verse eid="ACT 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28"/>Eka jatend jolweny maduongʼ nowacho niya, “An awuon ne achulo pesa mangʼeny mondo abed ja-Rumi.”</para>
  <para style="p" vid="ACT 22:28">Paulo nodwoke niya, “An to ne onywola ja-Rumi.”<verse eid="ACT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29"/>Kane giwinjo kamano, to joma ne dwaro chwade noa bute kendo jatend jolweny maduongʼ bende ne luoro omako, kane ofwenyo ni nosetweyo Paulo, to kara ne en ja-Rumi.<verse eid="ACT 22:29"/></para>
  <para style="s1">Oter Paulo e buch jodong jo-Yahudi</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30"/>Nikech jatend jolweny maduongʼ ne dwaro ngʼeyo gimomiyo jo-Yahudi nedonjo ni Paulo, kinyne nogonye mogolo chik mondo jodolo madongo duto gi buch jodong jo-Sanhedrin orom. Eka nokelo Paulo mi ochunge e nyimgi mondo owuo.<verse eid="ACT 22:30"/></para>
  <chapter eid="ACT 22"/>
  <chapter number="23" style="c" sid="ACT 23"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1"/>Paulo nongʼiyo wach jobuch jo-Sanhedrin tir eka nowachonegi niya, “Owetena, asetimo tich mane Nyasaye omiya mondo atim gi chuny maler maonge ketho nyaka chil kawuono.” <verse eid="ACT 23:1"/><verse number="2" style="v" sid="ACT 23:2"/>Kane owacho kamano, to Anania jadolo maduongʼ nogolo chik ni joma nochungʼ bute mondo ogo dhoge. <verse eid="ACT 23:2"/><verse number="3" style="v" sid="ACT 23:3"/>Eka Paulo nowachone niya, “Nyasaye biro goyi, in kor ot mobuk matarni! Owinjore ingʼadna bura kaluwore gi Chik, to in iwuon ema iketho chik ka iwacho ni jogi mondo ogoya!”<verse eid="ACT 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4"/>Joma nochungʼ but Paulo nowachone niya, “Wangʼi tek manade minyalo yanyo jadolo maduongʼ mar Nyasaye?”<verse eid="ACT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5"/>To Paulo nodwoko niya, “Owetena, ne ok angʼeyo ni en jadolo maduongʼ, nikech ondiki ni, ‘Kik iwuo marach kuom jatend jou.’<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 22:28">Wuo 22:28</ref></char></char></note>”<verse eid="ACT 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6"/>Kaka Paulo nongʼeyo ni moko kuom jogo ne gin jo-Sadukai, to moko jo-Farisai, nokok ne bura mar Sanhedrin kowacho niya, “Owetena, an ja-Farisai kendo an wuod ja-Farisai. Achungʼ kae kawuono mondo oyala nikech geno ma an-go kuom chier mar joma otho!” <verse eid="ACT 23:6"/><verse number="7" style="v" sid="ACT 23:7"/>Bangʼ wacho kamano, pogruok nowuok e kind joburago, ka jo-Farisai kwedore gi jo-Sadukai. <verse eid="ACT 23:7"/><verse number="8" style="v" sid="ACT 23:8"/>(Mano notimore nikech jo-Sadukai wacho ni chier, kata malaike kata Roho onge, to jo-Farisai to oyie gi puonjgi duto.)<verse eid="ACT 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 23:9"/>Koko maduongʼ nowuok kendo jopuonj Chik moko mane gin jo-Farisai, nochungʼ malo mochako goyo mbaka matek kagiwacho niya, “Ok waneno gima rach ma ngʼatni osetimo. Donge nyalo bet ni roho kata malaika ema wuoyo kode?” <verse eid="ACT 23:9"/><verse number="10" style="v" sid="ACT 23:10"/>Pogruokno nomedo kelo dhawo gi dwokruok makwiny, mi jaduongʼ jolweny nodoko maluor ni jogo ne nyalo kidho Paulo matindo tindo. Omiyo nogolo chik mondo jolweny ogol Paulo oko githuon e nyim bura, mondo odwoke ei kama jolweny nodakie.<verse eid="ACT 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11"/>Otienono Ruoth Yesu nobiro mochungʼ but Paulo mowachone niya, <char style="wj">“Bed mana gi chir! Mana kaka isetimo nenda ei Jerusalem, e kaka nyaka itime e Rumi bende.”</char><verse eid="ACT 23:11"/></para>
  <para style="s1">Jo-Yahudi ochano mar nego Paulo</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12"/>Kinyne gokinyi jo-Yahudi nowuoyo e kindgi giwegi ka gikwongʼore ni ok ginichiem kata madho gimoro amora kapok ginego Paulo. <verse eid="ACT 23:12"/><verse number="13" style="v" sid="ACT 23:13"/>Joma notimo kwongʼruokni noloyo ji piero angʼwen. <verse eid="ACT 23:13"/><verse number="14" style="v" sid="ACT 23:14"/>Negidhi ir jodolo madongo gi jodongo mi giwachonegi niya, “Wasekwongʼore waduto ni ok wanacham kata madho gimoro kapok wanego Paulo. <verse eid="ACT 23:14"/><verse number="15" style="v" sid="ACT 23:15"/>Kuom mano, un kod jobuch Sanhedrin kwauru jatend jolweny maduongʼ mondo okelnugo e nyimu, ka uwuondoru ni udwaro medo nono wachne maber. Waikore mar nege kapok ochopo ka.”<verse eid="ACT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16"/>To ka wuod nyamin Paulo nofwenyo gima jogo ne chano timo, nodhi nyaka kama jolweny odakie monyiso Paulo wachno.<verse eid="ACT 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 23:17"/>Eka Paulo noluongo achiel kuom jotend jolweny, mowachone niya, “Kaw wuowino idhigo nyaka ir jatend jolweny maduongʼ nimar en-gi wach moro monego owachne.” <verse eid="ACT 23:17"/><verse number="18" style="v" sid="ACT 23:18"/>Omiyo notere ir jatend jolweny.</para>
  <para style="p" vid="ACT 23:18">Ne owachone niya, “Paulo ma otwecha ne oluonga ire mi okwaya mondo akel wuowini iri nikech, en-gi wach moro modwaro nyisi.”<verse eid="ACT 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19"/>Jatend jolweny nokawo wuowino komako bade, mi notere tenge eka openje niya, “En angʼo midwaro nyisa?”<verse eid="ACT 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20"/>Wuowino nodwoke niya, “Jo-Yahudi osewinjore mondo okwayi kiny iternegi Paulo e nyim jobuch Sanhedrin ka giwuondore ni gidwaro medo nono wachne maber. <verse eid="ACT 23:20"/><verse number="21" style="v" sid="ACT 23:21"/>Kik iyie gi kwayogino nikech ji moloyo piero angʼwen kuomgi osebutone. Gisekwongʼore ni ok ginicham kata madho gimoro kapok ginege. Kata sani giseikore, girito mana mondo iyie gi kwayogino.”<verse eid="ACT 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22"/>Jatend jolweny noweyo wuowino modhi, kosieme niya, “Kik inyis ngʼato ni isenyisa wachni.”<verse eid="ACT 23:22"/></para>
  <para style="s1">Oter Paulo Kaisaria</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23"/>Eka noluongo jotend askeche ariyo momiyogi chik niya, “Ikuru jolweny mia ariyo, gi mamoko piero abiriyo moidho farese kod mia ariyo motingʼo tonge mondo oikre mar dhi Kaisaria kawuono sa adek mar otieno. <verse eid="ACT 23:23"/><verse number="24" style="v" sid="ACT 23:24"/>Paulo bende ikneuru farase mondo obi oidhi otere nyaka ir ruoth Feliks, ma ok gimoro otime e yo.”<verse eid="ACT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 23:25"/>Bangʼe nondiko baruwa machalo kama:<verse eid="ACT 23:25"/></para>
  <para style="pmo">
    <verse number="26" style="v" sid="ACT 23:26"/>An Klaudio Lusio,</para>
  <para style="pmo" vid="ACT 23:26">amosi ahinya</para>
  <para style="pmo" vid="ACT 23:26">in ruoth Feliks.<verse eid="ACT 23:26"/></para>
  <para style="pm">
    <verse number="27" style="v" sid="ACT 23:27"/>Daher mar nyisi ni jo-Yahudi nomako ngʼatni kendo negidwaro nege, to ne aoro jolweny mondo okonye, nikech ne ayudo wach ni en ja-Rumi. <verse eid="ACT 23:27"/><verse number="28" style="v" sid="ACT 23:28"/>Ne adwaro ngʼeyo gimomiyo ne gidonjone, omiyo ne atere e nyim jobuch jodong jo-Sanhedrin. <verse eid="ACT 23:28"/><verse number="29" style="v" sid="ACT 23:29"/>Ne ayudo ni ne odonjne kaluwore gi weche moko mag chikegi, to ne ayudo ni onge ketho moro mosetimo manyalo miyo ngʼadne buch tho kata buch twech. <verse eid="ACT 23:29"/><verse number="30" style="v" sid="ACT 23:30"/>To kane awinjo ni jo-Yahudi chano mar nege lingʼ-lingʼ, to ne aore iri mapiyo. Bende ne agolo chik mondo joma odonjone obi iri mondo ginyisi gimomiyo gidonjone.<verse eid="ACT 23:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31"/>Jolweny nochopo chik mane omigi. Negikawo Paulo gotieno, mi gidhi kode nyaka Antipatris. <verse eid="ACT 23:31"/><verse number="32" style="v" sid="ACT 23:32"/>Kinyne negikete e lwet jolweny moidho farese mondo odhi kode, to gin negidwogo kama jolweny odakie. <verse eid="ACT 23:32"/><verse number="33" style="v" sid="ACT 23:33"/>Kane joidh farese ochopo Kaisaria, negimiyo ruoth baruwa mane jatend jolweny maduongʼ ondiko, eka negiketo Paulo e lwete. <verse eid="ACT 23:33"/><verse number="34" style="v" sid="ACT 23:34"/>Ruoth nosomo baruwano, eka nopenjo Paulo ni en japiny mane. Bangʼ ngʼeyo ni ne en japiny Kilikia, <verse eid="ACT 23:34"/><verse number="35" style="v" sid="ACT 23:35"/>nowachone niya, “Kiny nawinj wachni ka joma odonjoni ochopo ka.” Eka nogolo chik mondo okan Paulo maber e od bura mane ni e dala Herode.<verse eid="ACT 23:35"/></para>
  <chapter eid="ACT 23"/>
  <chapter number="24" style="c" sid="ACT 24"/>
  <para style="s1">Paulo oter e nyim Feliks</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1"/>Bangʼ ndalo abich, jadolo maduongʼ miluongi ni Anania nodhi nyaka Kaisaria, kaachiel gi jodongo moko, kod jangʼad bura mane iluongo ni Tertulo, mine gikelo weche mane gidonjonigo Paulo e nyim ruoth. <verse eid="ACT 24:1"/><verse number="2" style="v" sid="ACT 24:2"/>Kane oseluong Paulo odonjo iye, Tertulo nochako donjone e nyim Feliks kawacho niya, “Wasebedo ka wadak gi kwe e bwo lochni kuom kinde mangʼeny kendo paroni matut osekelo dongruok mathoth e pinywani. <verse eid="ACT 24:2"/><verse number="3" style="v" sid="ACT 24:3"/>Wamor kodi, moluor Feliks, nikech ber duto misekelonwa, osemiyo wadak maber kuonde duto kendo e yore duto. <verse eid="ACT 24:3"/><verse number="4" style="v" sid="ACT 24:4"/>Koro yienwa mondo wawach gima okelowa iri, kapok wakethoni seche mangʼeny.<verse eid="ACT 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 24:5"/>“Wasenwangʼo ni ngʼatni en jakel koko, kendo okelo dhawo e kind jo-Yahudi duto modak e pinyni. En jatend kanyakla mar joma ongʼanyo ma jo-Nazareth, <verse eid="ACT 24:5"/><verse number="6" style="v" sid="ACT 24:6"/>kendo nyocha osetemo mondo odwany hekalu, omiyo nyocha wamake [mondo wangʼadne bura kaluwore gi chikwa. <verse eid="ACT 24:6"/><verse number="7" style="v" sid="ACT 24:7"/>To jaduongʼ jolweny miluongo ni Lusio nobiro mokawe kuomwa githuon, <verse eid="ACT 24:7"/><verse number="8" style="v" sid="ACT 24:8"/>kendo nogolo chik ni joma nodonjone okele iri].<note caller="+" style="f"><char style="fr" closed="false">24:8 </char><char style="ft" closed="false">Loko moko machon mag Muma onge gi giko mar <char style="xt"><ref loc="ACT 24:6">Joo 24:6</ref></char> kaachiel gi <char style="xt"><ref loc="ACT 24:7">Joo 24:7</ref></char> duto kod chakruok mar <char style="xt"><ref loc="ACT 24:8">Joo 24:8</ref></char>.</char></note> Kuom mano, ka inone in iwuon, to ibiro ingʼeyo adiera kuom gik mwadonjonego duto.”<verse eid="ACT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 24:9"/>Jo-Yahudi duto mane ni kanyo noriwore gi Tertulo ka donjone, kendo ka giramo ni gik mane odonjnego ne gin adier.<verse eid="ACT 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10"/>Kane ruoth omiyo Paulo thuolo mondo owach kore, Paulo nodwoko niya, “Angʼeyo ni kuom higni mangʼeny isebedo jangʼad bura e pinywani, omiyo amor mar wuoyo e nyimi kuom wechegi. <verse eid="ACT 24:10"/><verse number="11" style="v" sid="ACT 24:11"/>Ibiro yudo ni nyocha adhi Jerusalem kuom ndalo apar gariyo mosekalo mondo alem. <verse eid="ACT 24:11"/><verse number="12" style="v" sid="ACT 24:12"/>Joma odonjonagi ne ok oyuda ka amino wach gi ngʼato angʼata e hekalu, kata ka aketho chuny ji mondo okel koko ei sinagogi kata kamoro amora ei Jerusalem. <verse eid="ACT 24:12"/><verse number="13" style="v" sid="ACT 24:13"/>Kata mana sani ok ginyal nyisi maler kuom ketho ma gidonjonago iri. <verse eid="ACT 24:13"/><verse number="14" style="v" sid="ACT 24:14"/>Kata kamano, ayie ni alamo Nyasach kwerewa, kendo an achiel kuom joma oluwo Yor Kristo, ma jo-Yahudi luongo ni kanyakla mar joma ongʼanyo. Ayie gi gik moko duto mowinjore gi Chik Musa kod gik mane Jonabi ondiko, <verse eid="ACT 24:14"/><verse number="15" style="v" sid="ACT 24:15"/>kendo an-gi geno kuom Nyasaye machalre gi jogi, ni nitie chier moikne joma beyo kod joma richo. <verse eid="ACT 24:15"/><verse number="16" style="v" sid="ACT 24:16"/>Omiyo atemo matek ndalo duto mondo kinda gi Nyasaye kod ji duto obed maber maonge bura.<verse eid="ACT 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17"/>“Bangʼ bedo maonge kuom higni mangʼeny, ne abiro Jerusalem mondo akelne ogandawa mich kendo atim ni Nyasaye misango. <verse eid="ACT 24:17"/><verse number="18" style="v" sid="ACT 24:18"/>Kane giyuda e hekalu ka adhi timo mano, negiyudo ka asepwodhora kendo aler. Onge chokruok mar ji mane ni koda, kata tim koko moro mane asechako. <verse eid="ACT 24:18"/><verse number="19" style="v" sid="ACT 24:19"/>To nitie jo-Yahudi moko moa e piny Asia mane onego bedi e nyimi ka, ka dipo ni giseneno ketho moro kuoma ma dimi gidonjna, <verse eid="ACT 24:19"/><verse number="20" style="v" sid="ACT 24:20"/>kata joma ochungʼ e nyimgi mondo owach ane ketho mane oyudago kane otera e nyim buch Sanhedrin, <verse eid="ACT 24:20"/><verse number="21" style="v" sid="ACT 24:21"/>ka ok en mana wach achiel mane agoyoe koko ka awacho ni, ‘Iyala kawuono nikech ayie ni joma otho biro chier!’ ”<verse eid="ACT 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22"/>Kaka Feliks nongʼeyo weche mangʼeny kuom Yor Kristo, noloro bura, kowachonegi niya, “Ka Lusio ma jaduongʼ jolweny obiro, eka abiro ngʼado buchuni.” <verse eid="ACT 24:22"/><verse number="23" style="v" sid="ACT 24:23"/>Bangʼe nogolo chik ni jatend jolweny mondo orit Paulo, ka omiye thuolo moromo, kendo mondo kik otam osiepene miye kony moro amora mane onyalo dwaro.<verse eid="ACT 24:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24"/>Bangʼ ndalo moko, Feliks nobiro gi chiege Drusila, mane en nyar jo-Yahudi. Nooro wach mondo oluongne Paulo, mi Paulo noyalone kuom wach yie kuom Kristo Yesu kolingʼ mos owinje. <verse eid="ACT 24:24"/><verse number="25" style="v" sid="ACT 24:25"/>To ka Paulo nodhi nyime kawuoyo kuom ngima maler gi ritruok kod chiengʼ bura mabiro, Feliks nobedo maluor mowacho niya, “Mano oromo! Koro inyalo aa. Ka adwari kendo, to abiro luongi.” <verse eid="ACT 24:25"/><verse number="26" style="v" sid="ACT 24:26"/>To kaka noparo bende ni Paulo ne nyalo miye asoya, nomedo orone wach kinde ka kinde mondo owuo kode, kogeno yudo gimoro.<verse eid="ACT 24:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27"/>Loch mar Feliks norumo bangʼ higni ariyo, eka Porkio Festo nokawo kare. To nikech Feliks ne dwaro mondo jo-Yahudi one ni en ngʼama ber, noweyo Paulo e od twech.<verse eid="ACT 24:27"/></para>
  <chapter eid="ACT 24"/>
  <chapter number="25" style="c" sid="ACT 25"/>
  <para style="s1">Paulo oter e nyim Festo</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1"/>Bangʼ ndalo adek ka Festo nosedonjo e loch, noa Kaisaria modhi nyaka Jerusalem, <verse eid="ACT 25:1"/><verse number="2" style="v" sid="ACT 25:2"/>kendo kuno jodolo madongo gi jotend jo-Yahudi nokel e nyime mi giwacho ketho mane gidonjonego Paulo. <verse eid="ACT 25:2"/><verse number="3" style="v" sid="ACT 25:3"/>Ne gitemo saye mondo otimnegi ngʼwono owe Paulo odogi Jerusalem nikech negichano butone mondo ginege gie yo kodhi. <verse eid="ACT 25:3"/><verse number="4" style="v" sid="ACT 25:4"/>Festo nodwokogi niya, “Paulo otwe Kaisaria, kendo an awuon abiro dhi ire kuno mapiyo, <verse eid="ACT 25:4"/><verse number="5" style="v" sid="ACT 25:5"/>kuom mano, oruru jotendu moko adhigo mondo gidhi gidonjne kuno, kaponi osetimo gimoro marach.”<verse eid="ACT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6"/>Bangʼ kane osebet kodgi kuom ndalo aboro kata apar, nolor odhi Kaisaria, eka kinyne nochoko bura mogolo chik mondo okel Paulo e nyime. <verse eid="ACT 25:6"/><verse number="7" style="v" sid="ACT 25:7"/>Kane Paulo odonjo, jo-Yahudi mane oyudo obiro koa Jerusalem nochungʼ olwore, ka gidonjone gi weche maricho ahinya, to ne ok ginyal nyiso ni wechego gin adier.<verse eid="ACT 25:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 25:8"/>Eka Paulo nowacho kore, kodwokogi niya, “Onge gima aseketho kuom chik jo-Yahudi, kata kuom hekalu, kata kuom Kaisar.”<verse eid="ACT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9"/>To Festo mane dwaro mondo omor jo-Yahudi nowachone Paulo niya, “Bende inyalo yie mondo idhi Jerusalem mondo kuno ema adhi ayalie kuom wechegi?”<verse eid="ACT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10"/>Paulo nodwoke niya, “Sani achungʼ iyala gi Buch Kaisar, kendo ka ema owinjore ongʼadnae bura. Onge gima rach ma asetimo ne jo-Yahudi, kata in bende ingʼeyo wachno maber. <verse eid="ACT 25:10"/><verse number="11" style="v" sid="ACT 25:11"/>Ka dipo ni asetimo gimoro mowinjore gi tho, to ok atamora mondo kik nega. To ka nyalo bet ni ketho ma jo-Yahudigi odonjonago gin miriambo, to onge ngʼato man-gi teko mar chiwa e lwetgi. Kuom mano, akwayo mondo otera e nyim Kaisar.”<verse eid="ACT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12"/>Kane Festo osekuotho gi jobuche, nongʼado bura kowacho niya, “Isekwayo mondo oteri e nyim Kaisar omiyo kuno ema ibiro dhiye!”<verse eid="ACT 25:12"/></para>
  <para style="s1">Festo onyiso Ruoth Agripa wach Paulo</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13"/>Bangʼ ndalo manok, ruoth Agripa kod Bernike nobiro Kaisaria mondo omos Festo. <verse eid="ACT 25:13"/><verse number="14" style="v" sid="ACT 25:14"/>Negibedo kanyo kuom ndalo mogwarore, omiyo Festo nopimo ne ruoth Agripa wach Paulo, kowachone niya, “Nitie ngʼat moro ka ma Feliks noweyo kotwe e od twech. <verse eid="ACT 25:14"/><verse number="15" style="v" sid="ACT 25:15"/>Kane adhi Jerusalem, jodolo madongo gi jodong jo-Yahudi nodonjone ka gidwaro mondo angʼadne buch tho.<verse eid="ACT 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 25:16"/>“Ne anyisogi ni ok en kit jo-Rumi mondo ochiw ngʼato angʼata ne joma odonjone, kapok omiye thuolo mar wacho kore kuom weche modonjnego. <verse eid="ACT 25:16"/><verse number="17" style="v" sid="ACT 25:17"/>Kane gibiro ka, to ne aluongo bura ma ok odeko, kendo agolo Chik mondo kel ngʼatno e nyima. <verse eid="ACT 25:17"/><verse number="18" style="v" sid="ACT 25:18"/>To ka joma nodonjone nochungʼ mondo owuo, ne ok gihulo gima oketho kata mahundu moro ma notimo kaka ne aparo. <verse eid="ACT 25:18"/><verse number="19" style="v" sid="ACT 25:19"/>Kar timo kamano, to ne gimino mana kode wach kuom kit lemogi kendo kuom ngʼat moro miluongo ni Yesu, mane osetho, to Paulo oramo ni ngʼatno ngima. <verse eid="ACT 25:19"/><verse number="20" style="v" sid="ACT 25:20"/>Kane amedo nono tiend wachni, to notamo wangʼa, omiyo napenje ka doyie odhi Jerusalem mondo oyale kuno kuom wechegi. <verse eid="ACT 25:20"/><verse number="21" style="v" sid="ACT 25:21"/>Eka Paulo nokwayo mondo buche oter e nyim Kaisar. Omiyo nyocha agolo chik mondo odwoke e od twech nyaka chop aore ir Kaisar.”<verse eid="ACT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22"/>Eka Agripa nowachone Festo niya, “Daher mondo awinje weche ngʼatno an bende.”</para>
  <para style="p" vid="ACT 25:22">Nodwoke niya, “Kiny niwinje.”<verse eid="ACT 25:22"/></para>
  <para style="s1">Oter Paulo e nyim Agripa</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23"/>Kinyne Agripa kod Bernike nobiro gi dhialruok maduongʼ ka gidonjo e od bura. Negidonjo kaachiel gi jodong jolweny madongo kod jodong dalano mamoko mogen. Eka Festo nogolo chik mondo okel Paulo e nyimgi, mi nokele. <verse eid="ACT 25:23"/><verse number="24" style="v" sid="ACT 25:24"/>Bangʼe Festo nowacho niya, “Ruoth Agripa kaachiel gi ji duto man kodwa ka, uneno ngʼatni! Jo-Yahudi duto osekwaya chakre Jerusalem nyaka Kaisaria ka gikok ni ok owinjore oweye obed mangima. <verse eid="ACT 25:24"/><verse number="25" style="v" sid="ACT 25:25"/>An to ne ayudo kaonge gima osetimo mowinjore githo, to nikech odwaro mondo Kaisar ema oyale, asengʼado mondo otere Rumi. <verse eid="ACT 25:25"/><verse number="26" style="v" sid="ACT 25:26"/>To kata kamano, aonge gi wach malongʼo ma anyalo ndiko ni Agripa kuome. Emomiyo asekele e nyimu uduto ka, to moloyo e nyimi, in Ruoth Agripa, mondo ka wasenone eka wayud wach ma dwandik kuome. <verse eid="ACT 25:26"/><verse number="27" style="v" sid="ACT 25:27"/>Nikech nenorena ni onge tiende oro ngʼat motwe ka ok oyang maler kethone mokwongo.”<verse eid="ACT 25:27"/></para>
  <chapter eid="ACT 25"/>
  <chapter number="26" style="c" sid="ACT 26"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1"/>Eka Agripa nowachone Paulo niya, “In thuolo mondo iwuo kuomi iwuon.”</para>
  <para style="p" vid="ACT 26:1">Eka Paulo notingʼo bade malo bangʼe ochako wuoyo kowacho niya, <verse eid="ACT 26:1"/><verse number="2" style="v" sid="ACT 26:2"/>“Akwanora kaka ngʼat mogwedhi, Ruoth Agripa, kuom yudo thuolo mar chungʼ e nyimi kawuono, mondo awuo kuom weche duto ma jo-Yahudi osedonjonago. <verse eid="ACT 26:2"/><verse number="3" style="v" sid="ACT 26:3"/>Moloyo mano, amor, nikech in ngʼat molony e chike jo-Yahudi duto kod mbakagi ma ok rum, kendo makelo miero. Kuom mano, akwayi mondo iyie iwinj wechena gi ngʼwono, ma ok ijok.<verse eid="ACT 26:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4"/>“Jo-Yahudi duto ongʼeyo ngimana kaka chalo nyaka aa e nyathi; bende gingʼeyo nyaka aa chakruok kaka ngimana osebet e pinywa kendo e Jerusalem. <verse eid="ACT 26:4"/><verse number="5" style="v" sid="ACT 26:5"/>Gisebedo ka gingʼeya kuom higni mangʼeny, kendo ginyalo timo nenda, ka gihero, ni kaluwore gi chike ma tiendgi tek mag ogandawa, naluwo kit jo-Farisai. <verse eid="ACT 26:5"/><verse number="6" style="v" sid="ACT 26:6"/>To koro sani iyala nikech geno ma an-go kuom singruok mane Nyasaye otimo ne kwerewa. <verse eid="ACT 26:6"/><verse number="7" style="v" sid="ACT 26:7"/>Mano e singruok ma dhoutwa apar gariyo geno mondo one kochopo kare, ka gisiko gitiyo ni Nyasaye odiechiengʼ gotieno. To koro ruoth Agripa, en mana wach genoni, emomiyo jo-Yahudi kwana kaka jaketho. <verse eid="ACT 26:7"/><verse number="8" style="v" sid="ACT 26:8"/>Ere gima omiyo, un jo-Yahudi, ok unyal yie ni Nyasaye chiero joma otho?<verse eid="ACT 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9"/>“Kata mana an awuon naketo chunya mar timo duto manyalo mondo akwed nying Yesu ja-Nazareth. <verse eid="ACT 26:9"/><verse number="10" style="v" sid="ACT 26:10"/>Chutho, mano e gima natimo Jerusalem, kuma nayudoe teko koa kuom jodolo madongo, mine atero jomaler mathoth e od twech; kendo kane inegogi, to nagoyo ombucha, ka ayie gi nekgi. <verse eid="ACT 26:10"/><verse number="11" style="v" sid="ACT 26:11"/>Kuom kinde mangʼeny ne adhi e sinagogi ka sinagogi mondo akawgi akumgi, kendo natemo chunogi mondo giyany Nyasaye. Nikech chunya ne rach kodgi ni nyaka atiekgi, ne adhi nyaka e mier ma oko mondo asandgi.<verse eid="ACT 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12"/>“Chiengʼ moro achiel kane adhi Damaski, ne an gi teko kod wach moa kuom jodolo madongo. <verse eid="ACT 26:12"/><verse number="13" style="v" sid="ACT 26:13"/>To ruoth Agripa, kane an e yo awuotho kar odiechiengʼ tir, ne aneno ler moa e polo mangʼangʼni moloyo wangʼ chiengʼ kendo nomenya kaachiel gi joma ne awuothogo. <verse eid="ACT 26:13"/><verse number="14" style="v" sid="ACT 26:14"/>Ne wapodho piny waduto, eka ne awinjo dwol moro kawuoyo koda gi dho jo-Hibrania ni, <char style="wj">‘Saulo, Saulo, isanda nangʼo? Riwi mabith migweyono biro mana hinyi in iwuon.’</char><verse eid="ACT 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15"/>“Eka napenjo ni, ‘In ngʼa, Ruoth?’</para>
  <para style="p" vid="ACT 26:15">“Ruoth to nodwoka ni, <char style="wj">‘An e Yesu misando.</char> <verse eid="ACT 26:15"/><verse number="16" style="v" sid="ACT 26:16"/><char style="wj">To koro aa malo ichungʼ gi tiendi. Asefwenyorani mondo awali kaka jatich kendo janeno kuom gik miseneno kuoma kendo kuom gik mamoko ma abiro nyisi.</char> <verse eid="ACT 26:16"/><verse number="17" style="v" sid="ACT 26:17"/><char style="wj">Abiro resi e lwet jou kendo kuom joma ok jo-Yahudi. Aori irgi</char> <verse eid="ACT 26:17"/><verse number="18" style="v" sid="ACT 26:18"/><char style="wj">mondo iyaw wengegi, kendo mondo ilokgi gia e mudho, giduogi e ler, kendo gia e teko Satan, giduogi ir Nyasaye; ka gitimo kamano eka richogi nowenegi, kendo gibedi e achiel gi ji duto mosepwodhi, nikech giyie kuoma.’</char><verse eid="ACT 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19"/>“Kuom mano, Ruoth Agripa, ne ok atamora timo kaka fweny moa e polo nonyisa. <verse eid="ACT 26:19"/><verse number="20" style="v" sid="ACT 26:20"/>Mokwongo ne anyiso joma nodak Damaski kendo joma odak Jerusalem nyaka joma odak Judea duto kaachiel gi joma ok jo-Yahudi ka ayalonegi mondo gilokre giwe richo kendo gidwog ir Nyasaye, mondo ginyis ni giseweyo richo adier gi kit ngimagi. <verse eid="ACT 26:20"/><verse number="21" style="v" sid="ACT 26:21"/>Mano e gima nomiyo jo-Yahudi omaka e laru mar hekalu kendo negitemo mondo ginega. <verse eid="ACT 26:21"/><verse number="22" style="v" sid="ACT 26:22"/>To Nyasaye osekonya e kindego duto, omiyo koro ahulo wechegi machalre, ni ji ajia kod joma ogen. Onge gima awacho mopogore gi mago mane jonabi kod Musa jowacho ni notimre. <verse eid="ACT 26:22"/><verse number="23" style="v" sid="ACT 26:23"/>Negiwacho ni Kristo nyaka sandi, kendo nyaka obed ngʼama okwongo chier oa kuom joma otho, mondo okel ler ni jo-Yahudi kaachiel gi joma ok jo-Yahudi.”<verse eid="ACT 26:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24"/>Kane Paulo dhi nyime gi wuoyo kamano, Festo nokok matek niya, “Wiyi okethore, Paulo! Somo misomo mangʼeny oseloki janeko!”<verse eid="ACT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25"/>To Paulo nodwoke niya, “Ok an janeko, Ruoth Festo. Gima awacho en adier kendo winjore maber. <verse eid="ACT 26:25"/><verse number="26" style="v" sid="ACT 26:26"/>Kata Ruoth Agripa ongʼeyo wechegi maler, omiyo anyalo wuoyo kode gi chir. Angʼeyo maonge kiawa ni wechegi duto ok opondone, nikech ok osetimgi lingʼ-lingʼ. <verse eid="ACT 26:26"/><verse number="27" style="v" sid="ACT 26:27"/>Ruoth Agripa, bende iyie kuom jonabi? Angʼeyo ni iyie kuomgi.”<verse eid="ACT 26:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28"/>Eka Agripa nowacho ni Paulo niya, “Iparo ni e sa machwokni inyalo loka abed ja-Kristo?”<verse eid="ACT 26:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29"/>Paulo nodwoke niya, “Kata obed sa machwok kata malach, to alamo Nyasaye ok mana ne in kende, to nyaka ni ji duto mawinjo wachna kawuono, mondo gichal koda, makmana nyoroche motweyagogi ema kik tweugo un bende.”<verse eid="ACT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30"/>Eka Ruoth Agripa gi Ruoth Festo, nochungʼ kaachiel gi Bernike gi ji duto ma nobet kodgi. <verse eid="ACT 26:30"/><verse number="31" style="v" sid="ACT 26:31"/>Negia e odno, kendo sa mane gidhi negiwuoyo kendgi kagiwacho niya, “Onge gima ngʼatni timo marach mowinjore gi tho kata tere e od twech.”<verse eid="ACT 26:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 26:32"/>Bangʼe Agripa nowacho ni Festo niya, “Ngʼatni dine wagonyo thuolo ka dine bed ni pok okwayo mondo otere e nyim Kaisar.”<verse eid="ACT 26:32"/></para>
  <chapter eid="ACT 26"/>
  <chapter number="27" style="c" sid="ACT 27"/>
  <para style="s1">Paulo okwangʼ kadhi Rumi</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1"/>Kane osengʼad wach ni onego okwangʼwa wadhi Italia, Paulo kod joma otwe mamoko noketi e lwet jatend jolweny moro ma nyinge Julias. Ngʼatno ema ne jatend oganda lweny mane iluongo ni Jorit Dala Ruoth. <verse eid="ACT 27:1"/><verse number="2" style="v" sid="ACT 27:2"/>Ne wadonjo ei yie moro moa Adramutio mane onego ogow e mier mamoko manie dho nam molworo piny Asia. Bangʼe ne wasiayo yie mi wawuok. Aristarko ja-Makedonia moa Thesalonika bende ne nikodwa.<verse eid="ACT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 27:3"/>Kinyne ne wagowo Sidon, kendo kanyo Julias notimo ngʼwono ni Paulo mi nomiye thuolo mar dhi ir osiepene mondo gimiye gik mane ochando. <verse eid="ACT 27:3"/><verse number="4" style="v" sid="ACT 27:4"/>Kane waa kanyo to ne wasiayo yie e nam kendo, to nikech yamo mager ne kudho kochomowa tir, ne waluwo bath chula mar Saipras koma ogengʼore gi yamo. <verse eid="ACT 27:4"/><verse number="5" style="v" sid="ACT 27:5"/>Kane wasekwangʼ wangʼado ataro mar nam, machiegni kod Kilikia gi Pamfilia, ne wagowo e dho wadh Mura, e piny Lukia. <verse eid="ACT 27:5"/><verse number="6" style="v" sid="ACT 27:6"/>Kanyo jatend jolweny nonwangʼo yie ja-Aleksandria moro madhi Italia, mi noketowa ei yieno. <verse eid="ACT 27:6"/><verse number="7" style="v" sid="ACT 27:7"/>Ne wakwangʼ mos gi thagruok kuom ndalo mangʼeny nikech kwangʼ ne rach, eka achien ne wachopo machiegni gi dho wadh Sinido. Kaka yamo koro nomedore ma ok wanyal chome tir, ne wakwangʼ kwagengʼore e bath Krete, mochomore gi sori mar Salmone. <verse eid="ACT 27:7"/><verse number="8" style="v" sid="ACT 27:8"/>Ne wamedo kwangʼ gi thagruok ka waluwo bath nam mine wachopo kamoro miluongo ni Mbita Mokwe, but dala mar Lasea.<verse eid="ACT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9"/>Kaka koro ne waseketho seche mathoth, to kwangʼ bende bedo marach, kendo kinde mag Sap Tweyo Chiemo bende nosekadho, Paulo nongʼado rieko ni jokwangʼ kowacho niya, <verse eid="ACT 27:9"/><verse number="10" style="v" sid="ACT 27:10"/>“Jowadwa, aneno ni ka wawuok ka, to wuodhwani biro bedo marach kendo yiewani kaachiel gi gik motingʼo biro kethore kendo wan bende wanyalo tho.” <verse eid="ACT 27:10"/><verse number="11" style="v" sid="ACT 27:11"/>To jatend jolweny ne ok odewo chik kata winjo gima Paulo ne owacho, makmana nowinjo mana wach wuon yie kod jatend yie. <verse eid="ACT 27:11"/><verse number="12" style="v" sid="ACT 27:12"/>Dho wath kanyo ne ok ber betie ndalo chwiri, omiyo thoth ji mane wan-go nongʼado wach mondo wadhi nyime gi kwangʼ, ka giparo ni ne wanyalo chopo Foinike mondo wabedie ndalo chwiri. Foinike ne en dho wadh Krete, momanyore gi milambo ma yo podho chiengʼ kod nyandwat ma yo podho chiengʼ.<verse eid="ACT 27:12"/></para>
  <para style="s1">Yamo mager</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13"/>Ka yamb milambo makudho mos nochako kudho, negiparo ni ne giseyudo gima negidwaro kendo ni wuodhgi koro ber, omiyo negibolo nanga e pi mine gichako kwangʼ ka giluwo tiend dho nam mar Krete. <verse eid="ACT 27:13"/><verse number="14" style="v" sid="ACT 27:14"/>To kane pok gikwangʼ mabor, yamb ahiti miluongo ni Yurakulo, nochako kudho matek koa e chulano. <verse eid="ACT 27:14"/><verse number="15" style="v" sid="ACT 27:15"/>Ahitino nomako yie motame muomo yamono, omiyo ne waweyo mondo yamo olok yie oterwa atera kuma okudho kochomo. <verse eid="ACT 27:15"/><verse number="16" style="v" sid="ACT 27:16"/>Kane oyudo wakalo e tiend chula moro matin miluongo ni Kauda, ne wabedo gi pek mar keto yie matin mar resruok kama ber, mondo kik okethre. <verse eid="ACT 27:16"/><verse number="17" style="v" sid="ACT 27:17"/>Kane chwo mane wan-go osekete ei yie maduongʼ mane wantie, negitweyo yie gi tonde molwore mondo kik obarre. To nikech negiluor ni yie ne nyalo terogi kuonde mathany-thany motimo kuoyo man e dho nam mar Afrika, ne giloro nanga mar yie mi giweye mondo yamo otere atera. <verse eid="ACT 27:17"/><verse number="18" style="v" sid="ACT 27:18"/>Ahiti nomedo goyo yie matek mi kinyne negichako wito gik mane ni ei yie e nam. <verse eid="ACT 27:18"/><verse number="19" style="v" sid="ACT 27:19"/>Odiechiengʼ mar adek, ne giwito ei nam gik moko duto michikogo yie. <verse eid="ACT 27:19"/><verse number="20" style="v" sid="ACT 27:20"/>Kuom ndalo mangʼeny, ne ok wanyal neno wangʼ chiengʼ kata sulwe, kendo yamo nomedo kudho matek mi geno duto mane oyudo wan-go ni dipo koreswa norumo chuth.<verse eid="ACT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21"/>Kane ji koro oseriyo kech kuom ndalo mangʼeny, Paulo nochungʼ malo e nyimgi mowachonegi niya, “Jowadwa ka dine uwinj wachna ma wawe kwangʼ ka waa Krete, to dine utony mi ok uneno chandruok gi lal maduongʼ ma kama. <verse eid="ACT 27:21"/><verse number="22" style="v" sid="ACT 27:22"/>To koro akwayou ni umed bedo gi chir, nikech kata ngʼat achiel kuomu ok bi tho, makmana yie kende ema biro kethore. <verse eid="ACT 27:22"/><verse number="23" style="v" sid="ACT 27:23"/>Otieno mokalo, malaika mar Nyasaye, ma an ngʼate, kendo ma atiyone, nochungʼ batha, <verse eid="ACT 27:23"/><verse number="24" style="v" sid="ACT 27:24"/>mowachona ni, ‘Kik iluor Paulo, ibiro chopo nyaka nyim Kaisar mi yali kuno, nikech Nyasaye osemiyi kuom ngʼwonone, ngima ji duto makwangʼ kodi.’ <verse eid="ACT 27:24"/><verse number="25" style="v" sid="ACT 27:25"/>Kuom mano, beduru gi chir, jowadwa, nikech ayie ni Nyasaye biro timo mana kaka nonyisa. <verse eid="ACT 27:25"/><verse number="26" style="v" sid="ACT 27:26"/>To ochunore ni yie nyaka moki e chula moro.”<verse eid="ACT 27:26"/></para>
  <para style="s1">Yie obarore</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27"/>Otieno mar apar gangʼwen ne pod watangni mana e dier Nam mangʼongo mar Mediterania.<note caller="+" style="f"><char style="fr" closed="false">27:27 </char><char style="ft" closed="false">Namni bende ongʼere gi nying mar </char><char style="fqa" closed="false">Adriatik.</char></note> To kane ochopo odiwuor tir, to jokwangʼ ne paro ni gisechopo e lowo motwo. <verse eid="ACT 27:27"/><verse number="28" style="v" sid="ACT 27:28"/>Omiyo ne giluto tol motwene kidi e pi, mi giyudo ni tut pigno romo fut mia achiel gi piero ariyo. Bangʼ mano negichako gipime mi ginwangʼo ni en fut piero ochiko. <verse eid="ACT 27:28"/><verse number="29" style="v" sid="ACT 27:29"/>Luoro nomakowa ni dipo ka watwomo lwanda. Omiyo negibolo nanga angʼwen yo kachien yie, eka gilemo mondo piny oyawre. <verse eid="ACT 27:29"/><verse number="30" style="v" sid="ACT 27:30"/>Jokwangʼ notemo mondo gitony gia e yie, kendo negitemo mondo giket yie matin mar resruok e pi, ka giwuondore ni gidwaro bolo nanga moko yo ka wi yie. <verse eid="ACT 27:30"/><verse number="31" style="v" sid="ACT 27:31"/>Eka Paulo nowachone jatend jolweny kod jolweny duto niya, “Ka jogi ok osiko kodwa ei yie ka, to ok ubi tony.” <verse eid="ACT 27:31"/><verse number="32" style="v" sid="ACT 27:32"/>Omiyo jolweny nongʼado tonde ma notwego yie matin mar resruok, mi giweyo yieno okwangʼ modhi.<verse eid="ACT 27:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33"/>Kane piny chiegni yawore, Paulo nosayo jokwangʼ duto mondo ochiem, kowachonegi niya, “Kuom ndalo apar gangʼwen mosekadho, usebedo ka unie chandruok ma ok nunyal chiemo. <verse eid="ACT 27:33"/><verse number="34" style="v" sid="ACT 27:34"/>Koro yieuru koda mondo uchamie gimoro matin mondo ubed mangima. Awachonu ni onge ngʼato kata achiel kuomu mabiro wito kata mana yie wiye achiel.” <verse eid="ACT 27:34"/><verse number="35" style="v" sid="ACT 27:35"/>Kane osewacho mano, nokawo makati mi ogoyo ni Nyasaye erokamano e nyimgi giduto. Eka nongʼingo makatino mochako chiemo. <verse eid="ACT 27:35"/><verse number="36" style="v" sid="ACT 27:36"/>Jogo chunygi noduogo, mi ngʼato ka ngʼato kuomgi nokawo chiemo mondo ocham. <verse eid="ACT 27:36"/><verse number="37" style="v" sid="ACT 27:37"/>Kar romb ji duto mane ni e yie ne gin mia ariyo gi piero abiriyo gauchiel. <verse eid="ACT 27:37"/><verse number="38" style="v" sid="ACT 27:38"/>Kane ji duto osechiemo moyiengʼ, ne giwito cham duto modongʼ e nam mondo yie odongʼ mayot.<verse eid="ACT 27:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39"/>Kane piny oseyawore, jokwangʼ ne ok ongʼeyo piny mane gintie, to negineno mbita moro motimo kwoyo; mi giparo mondo gichom yie kuno mondo kanyalore to gimoki bute. <verse eid="ACT 27:39"/><verse number="40" style="v" sid="ACT 27:40"/>Negingʼado tonde motwego nanga mi gibolo e nam bangʼe gingʼado tonde mane omakgo ngai. Bangʼ mano negichungo tanga yo ka wi yie, bangʼe gisiayo yie ka gichomo dho wath. <verse eid="ACT 27:40"/><verse number="41" style="v" sid="ACT 27:41"/>To gikanyo yie notuomo kuoyo mathany-thany momoko ti. Eka yo ka wiye nomako matek ma ok nyal yukni, kendo apaka nogoyo yo kachien yieno mi obarore matindo tindo.<verse eid="ACT 27:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42"/>Jolweny ne dwaro nego joma otwe mondo ogengʼ gi kik gigo abal mi giring gitony. <verse eid="ACT 27:42"/><verse number="43" style="v" sid="ACT 27:43"/>To nikech jatendgi ne dwaro reso ngima Paulo, notamogi ni kik gineg-gi. Nogol chik mondo ngʼato angʼata mane nyalo goyo abal nyaka e dho wath okuong ochikre e pi mondo odhiyo. <verse eid="ACT 27:43"/><verse number="44" style="v" sid="ACT 27:44"/>Eka joma odongʼ ne biro luwo bangʼ-gi ka jomoko omako mberni, to moko omako bepe mane owuok e yie mane osebarore. Kamano e kaka ne wachopo e lowo motwo waduto ka wangima.<verse eid="ACT 27:44"/></para>
  <chapter eid="ACT 27"/>
  <chapter number="28" style="c" sid="ACT 28"/>
  <para style="s1">Paulo ochopo Molta</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1"/>Kane wasechopo e lowo motwo ka wangima, ne wayudo ni chulano iluongo ni Malta. <verse eid="ACT 28:1"/><verse number="2" style="v" sid="ACT 28:2"/>Joma nodak e chulano norwakowa duto gi ngʼwono mathoth, mi gimokonwa mach mondo wao, nikech koth ne chue kendo piny ne ngʼich. <verse eid="ACT 28:2"/><verse number="3" style="v" sid="ACT 28:3"/>Paulo nodondo yien moko mokelo mondo omedi e mach, to kane oyudo oketo yien-go e mach, thuol moro ne liet mar mach ogolo momoko e lwete. <verse eid="ACT 28:3"/><verse number="4" style="v" sid="ACT 28:4"/>Kane jo-chulano oneno ka thuol oliero e lwet Paulo, ne giwuoyo kendgi kagiwacho niya, “Ngʼatni nyaka bed ni en janek, mano emomiyo kata obedo ni osetony e nam, to bura mar tho mongʼadne pod luwe.” <verse eid="ACT 28:4"/><verse number="5" style="v" sid="ACT 28:5"/>To Paulo notengʼo thuondno oko molwar e mach, kendo onge gima notime. <verse eid="ACT 28:5"/><verse number="6" style="v" sid="ACT 28:6"/>Jogo ne geno ni lwete biro kuot, kata ni nobiro gore piny apoya mi otho, to negirito gamingʼa mi ok gineno gima otime. Eka negiloko pachgi mi giwacho ni Paulo en nyasaye.<verse eid="ACT 28:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7"/>But kama newantiereno ne nitie puothe madongo mag ruodh chulano miluongo ni Publio. Ruodhno norwakowa, moritowa maber kaka wende kuom ndalo adek. <verse eid="ACT 28:7"/><verse number="8" style="v" sid="ACT 28:8"/>To wuon-gi nonindo e kitanda nikech notuo, ka en gi midhusi, kendo nodiewo. Paulo nodonjo kama noninde mondo onene, to bangʼ koselamone, noketo lwete kuome mochange. <verse eid="ACT 28:8"/><verse number="9" style="v" sid="ACT 28:9"/>Kane mano osetimore, joma tuo duto mane ni e chulano nobiro moyudo chang. <verse eid="ACT 28:9"/><verse number="10" style="v" sid="ACT 28:10"/>Joma nodak e chulano nomiyowa luor e yore mangʼeny kendo kane koro wadwaro aa, ne gikowowa gi gige konyruok duto mane wachando.<verse eid="ACT 28:10"/></para>
  <para style="s1">Paulo ochopo Rumi</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11"/>Bangʼ ka dweche adek nosekalo, ne waidho yie moro mane osebedo karito kanyo e ndalo chwiri. Ne en yie ja-Aleksandria mane oket ne kido mag nyiseche ariyo ma rude, miluongo ni, Kasta gi Poluko. <verse eid="ACT 28:11"/><verse number="12" style="v" sid="ACT 28:12"/>Ne wakwangʼ waa kanyo nyaka wachopo Sirakusa, kendo kuno ne wabede kuom ndalo adek. <verse eid="ACT 28:12"/><verse number="13" style="v" sid="ACT 28:13"/>Kane waa kanyo, ne wakwangʼ mi wachopo Regiam, to kinyne, ka yamb milambo nochako kudho, ne wadhi nyime nyaka ne wachopo Puteoli, bangʼ kwangʼ kuom ndalo ariyo. <verse eid="ACT 28:13"/><verse number="14" style="v" sid="ACT 28:14"/>Puteoli kanyo ne wayude owete moko ma norwakowa mondo wadag kodgi kuom juma achiel. Bangʼe ne wamedo kwangʼ nyaka Rumi. <verse eid="ACT 28:14"/><verse number="15" style="v" sid="ACT 28:15"/>Owete man kuno nosewinjo wach birowa, omiyo ne giwuotho mi gichweyo nyaka Chiro mar Apio, to moko noromonwa kama iluongo ni Tres Tabernae, tiende ni ute adek mag bworo. Kane Paulo oneno jogi, nogoyo ne Nyasaye erokamano, kendo noyudo jip mi chunye noduogo. <verse eid="ACT 28:15"/><verse number="16" style="v" sid="ACT 28:16"/>Kane wachopo Rumi, Paulo noyudo thuolo mar dak e ode kende gi askari marite.<verse eid="ACT 28:16"/></para>
  <para style="s1">Paulo oyalo Injili Rumi</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17"/>Bangʼ bedo Rumi kuom ndalo adek, Paulo noluongo jotend jo-Yahudi mane odak kanyo. To kane gisechokore, nowachonegi niya, “Owetena, kata obedo ni ok asetimo gimoro marach ni jo-Yahudi kata ne timbe machon mag kwerewa, to nomaka Jerusalem moketa e lwet jo-Rumi. <verse eid="ACT 28:17"/><verse number="18" style="v" sid="ACT 28:18"/>To Bangʼ yala, negidwaro weya, nikech negiyudo ni aonge gi ketho mowinjore gi tho. <verse eid="ACT 28:18"/><verse number="19" style="v" sid="ACT 28:19"/>To ka jo-Yahudi nodagi wachno, ne ochuna ni nyaka akwa thuolo mondo abi oyala e buch Kaisar, to ne ok atimo mano nikech an gi wach moro gi jo-Yahudi wetena. <verse eid="ACT 28:19"/><verse number="20" style="v" sid="ACT 28:20"/>Mano emomiyo asekwayo mondo ubi awuoye kodu matin. En mana nikech geno mar jo-Israel emomiyo otweya gi nyororo.”<verse eid="ACT 28:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21"/>Negidwoke niya, “Wan pok wayudo baruwa moro amora moa Judea ma wuoyo kuomi, kendo kata mana owete manyocha oa kuno machiegni pok okelonwa wach moro, kata wacho pok giwachonwa gimoro misetimo marach. <verse eid="ACT 28:21"/><verse number="22" style="v" sid="ACT 28:22"/>Kata kamano, wadwaro winjo paroni, nikech wangʼeyo ni ji wuoyo kuom kanyakla marach kuonde duto.”<verse eid="ACT 28:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23"/>Negichano mondo girom gi Paulo odiechiengʼ moro achiel, kendo ji koro ne medo biro mangʼeny ir Paulo kama nodakie. Chakre okinyi nyaka odhiambo, noleronigi tiend wach pinyruoth Nyasaye. Notimo kamano kotemo loko paro mane gin-go kuom Yesu, kokonyore gi weche mondiki e Chik Musa kod jonabi. <verse eid="ACT 28:23"/><verse number="24" style="v" sid="ACT 28:24"/>Moko kuomgi norwako wechene, to moko notamore yie. <verse eid="ACT 28:24"/><verse number="25" style="v" sid="ACT 28:25"/>Ne gipogore e kindgi giwegi mi gichako wuok ka Paulo nowachonegi weche mogik niya, “Roho Maler nowacho adier ni kwereu, kane owuoyo gi dho Isaya janabi, kowacho kama:<verse eid="ACT 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26"/>“ ‘Dhi ir jogo mondo iwachnegi ni,</para>
  <para style="q1" vid="ACT 28:26">“Ubiro siko kuwinjo weche miwacho,</para>
  <para style="q2" vid="ACT 28:26">to wach ok nodonjnu ngangʼ;</para>
  <para style="q2" vid="ACT 28:26">ubiro siko kungʼicho, to ok unune gimoro.”<verse eid="ACT 28:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27"/>Nikech chuny jogi osedinore;</para>
  <para style="q2" vid="ACT 28:27">gisedino itgi,</para>
  <para style="q2" vid="ACT 28:27">kendo gisemiyo wengegi.</para>
  <para style="q1" vid="ACT 28:27">Nono to dipo ka wengegi oneno,</para>
  <para style="q2" vid="ACT 28:27">kendo itgi owinjo wach,</para>
  <para style="q2" vid="ACT 28:27">mi chunygi ofwenyo tiend weche,</para>
  <para style="q1" vid="ACT 28:27">kendo gidwog ira mi achang-gi!’<note caller="+" style="f"><char style="fr" closed="false">28:27 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 6:9">Isa 6:9</ref>,<ref loc="ISA 6:10">10</ref></char></char></note>”<verse eid="ACT 28:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28"/>Paulo notieko kawachonegi niya, “Emomiyo adwaro ni ungʼe ni warruok mar Nyasaye osechopo ni joma ok jo-Yahudi, kendo gibiro rwake!” [<verse eid="ACT 28:28"/><verse number="29" style="v" sid="ACT 28:29"/>Bangʼ wacho mano, jo-Yahudi mane winje nowuok odhi, ka gigoyo mbaka matek e kindgi giwegi.]<note caller="+" style="f"><char style="fr" closed="false">28:29 </char><char style="ft" closed="false">Loko moko machon mag Muma onge gi <char style="xt"><ref loc="ACT 28:29">Joo 28:29</ref></char>.</char></note><verse eid="ACT 28:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30"/>Kuom higni ariyo, Paulo nodak e ode owuon mochulo, kendo norwako ji duto mane obiro ire mondo onene. <verse eid="ACT 28:30"/><verse number="31" style="v" sid="ACT 28:31"/>Noyalo kuom pinyruoth Nyasaye gichir ma ok ngʼato ogengʼe, kopuonjo ji kuom Ruoth Yesu Kristo.<verse eid="ACT 28:31"/></para>
  <chapter eid="ACT 28"/>
</usx>
