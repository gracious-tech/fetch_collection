<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Biblica® Open New Luo Translation 2020</book>
  <para style="h">1 Weche Mag Ndalo</para>
  <para style="toc1">Weche Mag Ndalo Mokwongo</para>
  <para style="toc2">1 Weche Mag Ndalo</para>
  <para style="toc3">1We</para>
  <para style="mt1">Weche Mag Ndalo Mokwongo</para>
  <chapter number="1" style="c" sid="1CH 1"/>
  <para style="s1">Nonro mar ndiko chakre Adam nyaka Ibrahim</para>
  <para style="s2">Yawuot Noa</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 1:1"/>Adam nonywolo Seth, Enosh.<verse eid="1CH 1:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 1:2"/>Kenan, Mahalalel. Mahalalel nonywolo Jared,<verse eid="1CH 1:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 1:3"/>Enok. Enok nonywolo Methusela, Lamek.</para>
  <para style="li1" vid="1CH 1:3">Lamek nonywolo Nowa.<verse eid="1CH 1:3"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="4" style="v" sid="1CH 1:4"/>To Nowa nonywolo Shem, Ham kod Jafeth.<verse eid="1CH 1:4"/></para>
  <para style="s2">Joka Jafeth</para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5"/>Yawuot Jafeth ne gin:</para>
  <para style="li2" vid="1CH 1:5">Gomer, Magog, Madai, Javan, Tubal, Meshek kod Tiras.<verse eid="1CH 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6"/>Yawuot Gomer ne gin:</para>
  <para style="li2" vid="1CH 1:6">Ashkenaz, Rifath kod Togarma<verse eid="1CH 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7"/>Yawuot Javan ne gin:</para>
  <para style="li2" vid="1CH 1:7">Elisha, Tarshish, jo-Kitim kod jo-Rodan.<verse eid="1CH 1:7"/></para>
  <para style="s2">Joka Ham</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8"/>Yawuot Ham ne gin:</para>
  <para style="li2" vid="1CH 1:8">Kush, Mizraim, Put kod Kanaan.<verse eid="1CH 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9"/>Yawuot Kush ne gin:</para>
  <para style="li2" vid="1CH 1:9">Seba, Havila, Sabta, Rama kod Sabteka.</para>
  <para style="li1" vid="1CH 1:9">Yawuot Rama ne gin:</para>
  <para style="li2" vid="1CH 1:9">Sheba kod Dedan.<verse eid="1CH 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10"/>Kush ne en wuon</para>
  <para style="li2" vid="1CH 1:10">Nimrod, mane en jalweny maratego e piny.<verse eid="1CH 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11"/>Mizraim ne en wuon</para>
  <para style="li2" vid="1CH 1:11">jo-Lud, jo-Anam, jo-Lehab, jo-Naftu, <verse eid="1CH 1:11"/><verse number="12" style="v" sid="1CH 1:12"/>Jo-Pathrus, jo-Kaslu (ma jo-Filistia nowuok kuomgi) kod jo-Kaftor.<verse eid="1CH 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13"/>Kanaan nonywolo</para>
  <para style="li2" vid="1CH 1:13">Sidon wuode makayo, kendo jo-Hiti, <verse eid="1CH 1:13"/><verse number="14" style="v" sid="1CH 1:14"/>jo-Jebus, jo-Amor, jo-Girgash, <verse eid="1CH 1:14"/><verse number="15" style="v" sid="1CH 1:15"/>jo-Hivi, jo-Arki, jo-Sini, <verse eid="1CH 1:15"/><verse number="16" style="v" sid="1CH 1:16"/>jo-Arvad, jo-Zemar kod jo-Hamath.<verse eid="1CH 1:16"/></para>
  <para style="s2">Joka Shem</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17"/>Shem nonywolo</para>
  <para style="li2" vid="1CH 1:17">Elam, Ashur, Arfaksad, Lud kod Aram.</para>
  <para style="li1" vid="1CH 1:17">Aram nonywolo</para>
  <para style="li2" vid="1CH 1:17">Uz, Hul, Gether kod Meshek.<verse eid="1CH 1:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18"/>Arfaksad nonywolo Shela,</para>
  <para style="li2" vid="1CH 1:18">to Shela nonywolo Eber.<verse eid="1CH 1:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19"/>Eber nonywolo yawuowi ariyo:</para>
  <para style="li2" vid="1CH 1:19">wuode makayo nochako ni Peleg, nikech e ndalono ema nopogie piny, owadgi to ne nyinge Joktan.<verse eid="1CH 1:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20"/>Joktan nonywolo</para>
  <para style="li2" vid="1CH 1:20">Almodad, Shelef, Hazarmaveth, gi Jera, <verse eid="1CH 1:20"/><verse number="21" style="v" sid="1CH 1:21"/>Hadoram, Uzal, Dikla, <verse eid="1CH 1:21"/><verse number="22" style="v" sid="1CH 1:22"/>Obal, Abimael (kata Ebal), gi Sheba, <verse eid="1CH 1:22"/><verse number="23" style="v" sid="1CH 1:23"/>Ofir, Havila kod Jobab. Jogo duto ne gin yawuot Joktan.<verse eid="1CH 1:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24"/>Shem nonywolo Arfaksad, Arfaksad nonywolo Shela.<verse eid="1CH 1:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 1:25"/>Shela nonywolo Eber, Eber nonywolo Peleg. Peleg nonywolo Reu,<verse eid="1CH 1:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 1:26"/>Reu nonywolo Serug. Serug nonywolo Nahor, to Nahor nonywolo Tera.<verse eid="1CH 1:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 1:27"/>Tera nonywolo Abram (ma bangʼe noluongo ni Ibrahim).<verse eid="1CH 1:27"/></para>
  <para style="s2">Joka Ibrahim</para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 1:28"/>Yawuot Ibrahim ne gin: Isaka gi Ishmael.<verse eid="1CH 1:28"/></para>
  <para style="s2">Nyikwa Hagar</para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29"/>Ishmael nonywolo</para>
  <para style="li2" vid="1CH 1:29">Nebayoth wuode makayo, Kedar, Adbel, Mibsam, <verse eid="1CH 1:29"/><verse number="30" style="v" sid="1CH 1:30"/>Mishma, Duma, Masa, Hadad, Tema, <verse eid="1CH 1:30"/><verse number="31" style="v" sid="1CH 1:31"/>Jetur, Nafish kod Kedema.</para>
  <para style="li4" vid="1CH 1:31">Jogo duto ne yawuot Ishmael.<verse eid="1CH 1:31"/></para>
  <para style="s2">Nyikwa Ketura</para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32"/>Ketura, ma chi Ibrahim machielo, nonywolo</para>
  <para style="li2" vid="1CH 1:32">Zimran, Jokshan, Medan, Midian, Ishbak kod Shua.</para>
  <para style="li1" vid="1CH 1:32">Yawuot Jokshan ne gin:</para>
  <para style="li2" vid="1CH 1:32">Sheba kod Dedan.<verse eid="1CH 1:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33"/>Midian nonywolo</para>
  <para style="li2" vid="1CH 1:33">Efa, Efer, Hanok, Abida kod Elda.</para>
  <para style="li4" vid="1CH 1:33">Magi duto ne gin nyikwa Ketura.<verse eid="1CH 1:33"/></para>
  <para style="s2">Nyikwa Sara</para>
  <para style="li4">
    <verse number="34" style="v" sid="1CH 1:34"/>Ibrahim nonywolo Isaka.</para>
  <para style="li1" vid="1CH 1:34">To Isaka nonywolo</para>
  <para style="li2" vid="1CH 1:34">Esau kod Israel.<verse eid="1CH 1:34"/></para>
  <para style="s1">Yawuot Esau</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35"/>Esau nonywolo</para>
  <para style="li2" vid="1CH 1:35">Elifaz, Reuel, Jeush, Jalam kod Kora.<verse eid="1CH 1:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36"/>Elifaz nonywolo</para>
  <para style="li2" vid="1CH 1:36">Teman, Omar, Zefo, Gatam kod Kenaz.</para>
  <para style="li2" vid="1CH 1:36">Timna ma ne en chi Elifaz machielo nonywolo Amalek.<verse eid="1CH 1:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37"/>Yawuot Reuel ne gin:</para>
  <para style="li2" vid="1CH 1:37">Nahath, Zera, Shama kod Miza.<verse eid="1CH 1:37"/></para>
  <para style="s2">Jo-Seir man Edom</para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38"/>Seir nonywolo</para>
  <para style="li2" vid="1CH 1:38">Lotan, Shobal, Zibeon, Ana, Dishon, Ezer kod Dishan.<verse eid="1CH 1:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39"/>Lotan nonywolo</para>
  <para style="li2" vid="1CH 1:39">Hori kod Homam. Timna ne en nyamin Lotan.<verse eid="1CH 1:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40"/>Shobal nonywolo</para>
  <para style="li2" vid="1CH 1:40">Alvan,<note caller="+" style="f"><char style="fr" closed="false">1:40 </char><char style="ft" closed="false">Nying machielo mar </char><char style="fq" closed="false">Alvan </char><char style="ft" closed="false">en </char><char style="fqa" closed="false">Alian.</char></note> Manahath, Ebal, Shefo kod Onam.</para>
  <para style="li1" vid="1CH 1:40">Zibeon nonywolo</para>
  <para style="li2" vid="1CH 1:40">Aiya kod Ana.<verse eid="1CH 1:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41"/>Ana nonywolo</para>
  <para style="li2" vid="1CH 1:41">Dishon.</para>
  <para style="li1" vid="1CH 1:41">Dishon nonywolo</para>
  <para style="li2" vid="1CH 1:41">Hemdan, Eshban, Ithran kod Keran.<verse eid="1CH 1:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42"/>Ezer nonywolo</para>
  <para style="li2" vid="1CH 1:42">Bilhan, Zavan kod Akan.</para>
  <para style="li1" vid="1CH 1:42">Dishan nonywolo</para>
  <para style="li2" vid="1CH 1:42">Uz kod Aran.<verse eid="1CH 1:42"/></para>
  <para style="s2">Ruodhi mag Edom</para>
  <para style="li4">
    <verse number="43" style="v" sid="1CH 1:43"/>Magi e ruodhi mane orito piny Edom kane jo-Israel ne pod onge kod ruodhi:</para>
  <para style="li1" vid="1CH 1:43">Bela wuod Beor ma dalane maduongʼ niluongo ni Dinhaba.<verse eid="1CH 1:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44"/>Kane Bela otho, Jobab wuod Zera mane ja-Bozra nobedo ruoth kare.<verse eid="1CH 1:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45"/>Kane Jobab otho, Husham mane oa e piny jo-Teman nobedo ruoth kare.<verse eid="1CH 1:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46"/>Kane Husham otho, Hadad wuod Bedad mane oloyo jo-Midian e piny jo-Moab nobedo ruoth kare. Dalane maduongʼ niluongo ni Avith.<verse eid="1CH 1:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47"/>Kane Hadad otho, Samla ja-Masreka nobedo ruoth kare.<verse eid="1CH 1:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48"/>Kane Samla otho, Shaul ja-Rehoboth man but aora nobedo ruoth kare.<verse eid="1CH 1:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49"/>Kane Shaul otho, Baal-Hanan wuod Akbor nobedo ruoth kare.<verse eid="1CH 1:49"/></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50"/>Kane Baal-Hanan otho, Hadad nobedo ruoth kare. Dalane maduongʼ niluongo ni Pau, kendo chiege niluongo ni Mehetabel nyar Matred ma nyar Me-Zahab. <verse eid="1CH 1:50"/><verse number="51" style="v" sid="1CH 1:51"/>Hadad bende ne otho.</para>
  <para style="b" vid="1CH 1:51"/>
  <para style="li4" vid="1CH 1:51">Jodong Edom ne gin:</para>
  <para style="li1" vid="1CH 1:51">Timna, Alva, Jetheth <verse eid="1CH 1:51"/><verse number="52" style="v" sid="1CH 1:52"/>Oholibama, Ela, Pinon <verse eid="1CH 1:52"/><verse number="53" style="v" sid="1CH 1:53"/>Kenaz, Teman, Mibzar <verse eid="1CH 1:53"/><verse number="54" style="v" sid="1CH 1:54"/>Magdiel kod Iram.</para>
  <para style="li4" vid="1CH 1:54">Magi e jodongo mag Edom.<verse eid="1CH 1:54"/></para>
  <chapter eid="1CH 1"/>
  <chapter number="2" style="c" sid="1CH 2"/>
  <para style="s1">Yawuot Israel</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 2:1"/>Magi e yawuot Israel: Reuben, Simeon, Lawi, Juda, Isakar, Zebulun, <verse eid="1CH 2:1"/><verse number="2" style="v" sid="1CH 2:2"/>Dan, Josef, Benjamin, Naftali, Gad kod Asher.<verse eid="1CH 2:2"/></para>
  <para style="s1">Juda</para>
  <para style="s2">Ne Yawuot Hezron</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3"/>Yawuot Juda ne gin:</para>
  <para style="li2" vid="1CH 2:3">Er, Onan kod Shela. Yawuowi adekgi nonywolo gi nyar jo-Kanaan mane nyar Shua.</para>
  <para style="li2" vid="1CH 2:3">(Timbe Er ma kach Juda ne richo e wangʼ Jehova Nyasaye, omiyo Jehova Nyasaye nonege.)<verse eid="1CH 2:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 2:4"/>Chi wuod Juda ma Tamar nonywolone Perez kod Zera.</para>
  <para style="li4" vid="1CH 2:4">Yawuot Juda duto ne gin yawuowi abich.<verse eid="1CH 2:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5"/>Yawuot Perez ne gin:</para>
  <para style="li2" vid="1CH 2:5">Hezron kod Hamul.<verse eid="1CH 2:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6"/>Yawuot Zera ne gin:</para>
  <para style="li2" vid="1CH 2:6">Zimri, Ethan, Heman, Kalkol kod Darda, ma gin yawuowi abich koriwore duto.<verse eid="1CH 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7"/>Wuod Karmi ne en:</para>
  <para style="li2" vid="1CH 2:7">Akar mane okelo chandruok ne Israel kuom ketho chik mane orito gigo mowal.<verse eid="1CH 2:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8"/>Wuod Ethan ne en:</para>
  <para style="li2" vid="1CH 2:8">Azaria.<verse eid="1CH 2:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9"/>Yawuowi mane Hezron onywolo ne gin:</para>
  <para style="li2" vid="1CH 2:9">Jeramel, Ram kod Kaleb.<verse eid="1CH 2:9"/></para>
  <para style="s2">Yawuot Ram wuod Hezron</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10"/>Ram nonywolo</para>
  <para style="li1" vid="1CH 2:10">Aminadab, to Aminadab nonywolo Nashon mane jatelo mar jo-Juda.<verse eid="1CH 2:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 2:11"/>Nashon nonywolo Salmon,</para>
  <para style="li1" vid="1CH 2:11">to Salmon nonywolo Boaz,<verse eid="1CH 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 2:12"/>Boaz nonywolo Obed,</para>
  <para style="li1" vid="1CH 2:12">to Obed nonywolo Jesse.<verse eid="1CH 2:12"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13"/>Jesse nonywolo</para>
  <para style="li2" vid="1CH 2:13">Eliab, wuode makayo; wuode mar ariyo Abinadab,</para>
  <para style="li2" vid="1CH 2:13">mar adek Shimea, <verse eid="1CH 2:13"/><verse number="14" style="v" sid="1CH 2:14"/>mar angʼwen Nethanel,</para>
  <para style="li2" vid="1CH 2:14">mar abich, Radai, <verse eid="1CH 2:14"/><verse number="15" style="v" sid="1CH 2:15"/>mar auchiel Ozem,</para>
  <para style="li2" vid="1CH 2:15">to mar abiriyo Daudi.<verse eid="1CH 2:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="1CH 2:16"/>Nyiminegi ne Zeruya kod Abigael.</para>
  <para style="li3" vid="1CH 2:16">Yawuot Zeruya adek ne gin Abishai, Joab kod Asahel.<verse eid="1CH 2:16"/></para>
  <para style="li3">
    <verse number="17" style="v" sid="1CH 2:17"/>Abigael ne en min Amasa ma wuon-gi ne en Jetha ja-Ishmael.<verse eid="1CH 2:17"/></para>
  <para style="s2">Kaleb Wuod Hezron</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18"/>Kaleb wuod Hezron ne nigi nyithindo mane onywolo gi chiege Azuba (ma bende ne iluongo ni Jerioth). Magi ema ne yawuote:</para>
  <para style="li2" vid="1CH 2:18">Jesher, Shobab kod Ardon.<verse eid="1CH 2:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 2:19"/>Kane Azuba otho, Kaleb nonywomo Efrath mane onywolone Hur.<verse eid="1CH 2:19"/></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 2:20"/>Hur ne onywolo Uri, to Uri ne onywolo Bezalel.<verse eid="1CH 2:20"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21"/>Bangʼe achien, ka Hezron ne ja-higni piero auchiel ne okendo nyar Makir ma wuon Gilead. Nobedo e achiel kode ma nonywolone Segub.<verse eid="1CH 2:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 2:22"/>Segub ne onywolo Jair, mane orito mier piero ariyo gadek man Gilead.<verse eid="1CH 2:22"/></para>
  <para style="li2">
    <verse number="23" style="v" sid="1CH 2:23"/>(Kata kamono, Geshur kod Aram ne omako Havoth Jair, kaachiel gi Kenath kod kuonde mag dak molwore, mane gin mier piero auchiel).</para>
  <para style="li4" vid="1CH 2:23">Magi duto ne gin nyikwa Makir wuon Gilead.<verse eid="1CH 2:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24"/>Kane Hezron osetho e Kaleb Efratha, Abija chi Hezron nonywolone Ashur wuon Tekoa.<verse eid="1CH 2:24"/></para>
  <para style="s2">Jeramel wuod Hezron</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25"/>Yawuot Jeramel wuod Hezron makayo ne gin:</para>
  <para style="li2" vid="1CH 2:25">Ram wuode makayo, Buna, Oren, Ozem kod Ahija. <verse eid="1CH 2:25"/><verse number="26" style="v" sid="1CH 2:26"/>Jeramel ne nigi dhako machielo mane iluongo ni Atara, ne en min Onam.<verse eid="1CH 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27"/>Yawuot Ram wuod Jeramel makayo ne gin:</para>
  <para style="li2" vid="1CH 2:27">Maaz, Jamin kod Eker.<verse eid="1CH 2:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28"/>Yawuot Onam ne gin:</para>
  <para style="li2" vid="1CH 2:28">Shamai kod Jada.</para>
  <para style="li1" vid="1CH 2:28">Yawuot Shamai ne gin:</para>
  <para style="li2" vid="1CH 2:28">Nadab kod Abishur. <verse eid="1CH 2:28"/><verse number="29" style="v" sid="1CH 2:29"/>Chi Abishur ne iluongo ni Abihail mane onywolone Aban kod Molid.<verse eid="1CH 2:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30"/>Yawuot Nadab ne gin:</para>
  <para style="li2" vid="1CH 2:30">Seled kod Apaim. Seled notho maonge nyithindo.<verse eid="1CH 2:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31"/>Wuod Apaim ne en:</para>
  <para style="li2" vid="1CH 2:31">Ishi mane wuon Sheshan. To Sheshan ne wuon Alai.<verse eid="1CH 2:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32"/>Yawuot Jada owadgi Shamai ne gin:</para>
  <para style="li2" vid="1CH 2:32">Jetha kod Jonathan. Jetha notho kaonge nyithindo.<verse eid="1CH 2:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33"/>Yawuot Jonathan ne gin:</para>
  <para style="li2" vid="1CH 2:33">Peleth kod Zazar.</para>
  <para style="li4" vid="1CH 2:33">Magi ema ne nyikwa Jeramel.<verse eid="1CH 2:33"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34"/>Sheshan ne onge gi yawuowi, nonywolo nyiri kende.</para>
  <para style="li2" vid="1CH 2:34">Ne en gi misumba ma ja-Misri miluongo ni Jarha. <verse eid="1CH 2:34"/><verse number="35" style="v" sid="1CH 2:35"/>Jarha nokendo nyar Sheshan kendo nonywolone Atai.<verse eid="1CH 2:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36"/>Atai nonywolo ne wuon Nathan,</para>
  <para style="li1" vid="1CH 2:36">to Nathan ne wuon Zabad,<verse eid="1CH 2:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 2:37"/>Zabad ne wuon Eflal,</para>
  <para style="li1" vid="1CH 2:37">to Eflal ne wuon Obed,<verse eid="1CH 2:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 2:38"/>Obed ne wuon Jehu,</para>
  <para style="li1" vid="1CH 2:38">to Jehu ne wuon Azaria,<verse eid="1CH 2:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 2:39"/>Azaria ne wuon Helez,</para>
  <para style="li1" vid="1CH 2:39">Helez ne wuon Eliasa,<verse eid="1CH 2:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 2:40"/>Eliasa ne wuon Sismai,</para>
  <para style="li1" vid="1CH 2:40">Sismai ne wuon Shalum,<verse eid="1CH 2:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 2:41"/>Shalum ne wuon Jekamia,</para>
  <para style="li1" vid="1CH 2:41">to Jekamia ne wuon Elishama.<verse eid="1CH 2:41"/></para>
  <para style="s2">Anywola Kaleb</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42"/>Yawuot Kaleb owadgi Jeramel ne gin:</para>
  <para style="li2" vid="1CH 2:42">Mesha mane wuode makayo mane wuon Zif</para>
  <para style="li2" vid="1CH 2:42">to gi wuode Maresha mane en wuon Hebron.<verse eid="1CH 2:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43"/>Yawuot Hebron ne gin:</para>
  <para style="li2" vid="1CH 2:43">Kora, Tapua, Rekem kod Shema.<verse eid="1CH 2:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 2:44"/>Shema nonywolo Raham,</para>
  <para style="li2" vid="1CH 2:44">to Raham nonywolo Jorkeam.</para>
  <para style="li1" vid="1CH 2:44">Rekem ne wuon Shamai.<verse eid="1CH 2:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 2:45"/>Wuod Shamai ne en Maon,</para>
  <para style="li2" vid="1CH 2:45">to Maon ne wuon Beth Zur.<verse eid="1CH 2:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46"/>Chi Kaleb machielo ma nyinge Efa ne min</para>
  <para style="li2" vid="1CH 2:46">Haran, Moza kod Gazez.</para>
  <para style="li2" vid="1CH 2:46">Haran ne wuon Gazez.<verse eid="1CH 2:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47"/>Yawuot Jadai ne gin:</para>
  <para style="li2" vid="1CH 2:47">Ragem, Jotham, Geshan, Pelet, Efa kod Shaf.<verse eid="1CH 2:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48"/>Chi Kaleb machielo ma nyinge Maaka ne min</para>
  <para style="li2" vid="1CH 2:48">Sheba kod Tirhana.<verse eid="1CH 2:48"/></para>
  <para style="li2">
    <verse number="49" style="v" sid="1CH 2:49"/>En bende nonywolo Shaf mane wuon Madmana</para>
  <para style="li2" vid="1CH 2:49">to Sheva nonywolo Makbena kod Gibea.</para>
  <para style="li1" vid="1CH 2:49">Nyar Kaleb niluongo ni Aksa.<verse eid="1CH 2:49"/></para>
  <para style="li4">
    <verse number="50" style="v" sid="1CH 2:50"/>Jogo duto ema ne nyikwa Kaleb.</para>
  <para style="b" vid="1CH 2:50"/>
  <para style="li1" vid="1CH 2:50">Yawuot Hur wuod Efratha makayo ne gin:</para>
  <para style="li2" vid="1CH 2:50">Shobal wuon Kiriath Jearim, <verse eid="1CH 2:50"/><verse number="51" style="v" sid="1CH 2:51"/>Salma wuon Bethlehem kod Haref wuon Beth Gader.<verse eid="1CH 2:51"/></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52"/>Nyikwa Shobal wuon Kiriath Jearim ne gin,</para>
  <para style="li2" vid="1CH 2:52">Haroe mane nus jo-Manahath, <verse eid="1CH 2:52"/><verse number="53" style="v" sid="1CH 2:53"/>to anywola Kiriath Jearim ne gin: jo-Ithri, jo-Puthi, jo-Shumath kod Mishrai. Kuomgi ema ne jo-Zorath gi jo-Eshtaol owuokie.<verse eid="1CH 2:53"/></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54"/>Nyikwa Salma ne gin:</para>
  <para style="li2" vid="1CH 2:54">jo-Bethlehem, jo-Netofath; Atroth Beth Joab, nus jo-Manahath, jo-Zor, <verse eid="1CH 2:54"/><verse number="55" style="v" sid="1CH 2:55"/>kod anywola mar jondiko mane odak Jabez: jo-Tira, jo-Shimea kod jo-Suka. Magi ne jo-Keni mane owuok e anywola mar Hamath, ma wuon jo-Rekab.<verse eid="1CH 2:55"/></para>
  <chapter eid="1CH 2"/>
  <chapter number="3" style="c" sid="1CH 3"/>
  <para style="s2">Yawuot Daudi</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 3:1"/>Magi e yawuot Daudi mane onywolo ka en Hebron:</para>
  <para style="b" vid="1CH 3:1"/>
  <para style="li1" vid="1CH 3:1">Amnon wuode makayo wuod Ahinoam nyar Jezreel,</para>
  <para style="li1" vid="1CH 3:1">mar ariyo ne en Daniel wuod Abigael nyar Karmel;<verse eid="1CH 3:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 3:2"/>mar adek ne en Abisalom wuod Maaka nyar Talmai ruodh Geshur,</para>
  <para style="li1" vid="1CH 3:2">mar angʼwen, Adonija wuod Hagith;<verse eid="1CH 3:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 3:3"/>mar abich ne en Shefatia wuod Abital;</para>
  <para style="li1" vid="1CH 3:3">to mar auchiel ne en Ithream wuod chiege miluongo ni Egla.<verse eid="1CH 3:3"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="4" style="v" sid="1CH 3:4"/>Yawuowi auchielgi ne onywol ni Daudi ka en Hebron, kuma ne obedoe ruoth kuom higni abiriyo gi dweche auchiel.</para>
  <para style="b" vid="1CH 3:4"/>
  <para style="b" vid="1CH 3:4"/>
  <para style="li4" vid="1CH 3:4">Daudi nobedo ruoth korito piny ka en Jerusalem kuom higni piero adek gadek, <verse eid="1CH 3:4"/><verse number="5" style="v" sid="1CH 3:5"/>kendo magi e nyithindo mane onywolne Jerusalem kuno:</para>
  <para style="b" vid="1CH 3:5"/>
  <para style="li1" vid="1CH 3:5">Shamua, Shobab, Nathan, Solomon. Nyithindo angʼwen-gi nonywolo gi Bathsheba nyar Amiel.<verse eid="1CH 3:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 3:6"/>Bende ne nitiere Ibhar, Elishua, Elifelet, <verse eid="1CH 3:6"/><verse number="7" style="v" sid="1CH 3:7"/>Noga, Nefeg, Jafia, <verse eid="1CH 3:7"/><verse number="8" style="v" sid="1CH 3:8"/>Elishama, Eliada, kod Elifelet; giduto ne gin ji ochiko.<verse eid="1CH 3:8"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 3:9"/>Magi duto ne gin yawuot Daudi, ka waweyo yawuote mane onywolo gi mondene mamoko. To Tamar ne nyamin-gi.<verse eid="1CH 3:9"/></para>
  <para style="s2">Ruodhi mag Juda</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10"/>Solomon nonywolo Rehoboam,</para>
  <para style="li1" vid="1CH 3:10">Rehoboam nonywolo Abija,</para>
  <para style="li1" vid="1CH 3:10">Abija nonywolo Asa,</para>
  <para style="li1" vid="1CH 3:10">Asa nonywolo Jehoshafat,<verse eid="1CH 3:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 3:11"/>Jehoshafat nonywolo Jehoram,</para>
  <para style="li1" vid="1CH 3:11">Jehoram nonywolo Ahazia,</para>
  <para style="li1" vid="1CH 3:11">Ahazia nonywolo Joash,<verse eid="1CH 3:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 3:12"/>Joash nonywolo Amazia,</para>
  <para style="li1" vid="1CH 3:12">Amazia nonywolo Azaria,</para>
  <para style="li1" vid="1CH 3:12">Azaria nonywolo Jotham,<verse eid="1CH 3:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 3:13"/>Jotham nonywolo Ahaz,</para>
  <para style="li1" vid="1CH 3:13">Ahaz nonywolo Hezekia,</para>
  <para style="li1" vid="1CH 3:13">Hezekia nonywolo Manase,<verse eid="1CH 3:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 3:14"/>Manase nonywolo Amon,</para>
  <para style="li1" vid="1CH 3:14">Amon nonywolo Josia.<verse eid="1CH 3:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15"/>Yawuot Josia ne gin:</para>
  <para style="li2" vid="1CH 3:15">Johanan wuode makayo,</para>
  <para style="li2" vid="1CH 3:15">Jehoyakim mar ariyo,</para>
  <para style="li2" vid="1CH 3:15">Zedekia mar adek,</para>
  <para style="li2" vid="1CH 3:15">kod Shalum mar angʼwen.<verse eid="1CH 3:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16"/>Joma nokawo loch bangʼ Jehoyakim ne gin yawuote miluongo ni:</para>
  <para style="li2" vid="1CH 3:16">Jehoyakin</para>
  <para style="li2" vid="1CH 3:16">kod Zedekia.<verse eid="1CH 3:16"/></para>
  <para style="s2">Nonro mar joka ruoth bangʼ ka gisewuok e twech</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17"/>Nyikwa Jehoyakin mane onywol ka en e twech ne gin:</para>
  <para style="li2" vid="1CH 3:17">Shealtiel, <verse eid="1CH 3:17"/><verse number="18" style="v" sid="1CH 3:18"/>Malkiram Pedaya, Shenazar, Jekamia, Hoshama kod Nedabia.<verse eid="1CH 3:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19"/>Yawuot Pedaya ne gin:</para>
  <para style="li2" vid="1CH 3:19">Zerubabel kod Shimei.</para>
  <para style="li1" vid="1CH 3:19">Yawuot Zerubabel ne gin:</para>
  <para style="li2" vid="1CH 3:19">Meshulam kod Hanania, to Shelomith ne nyamin-gi. <verse eid="1CH 3:19"/><verse number="20" style="v" sid="1CH 3:20"/>Yawuowi abich mamoko mane Zerubabel onywolo ne gin: Hashuba, Ohel, Berekia, Hasadia kod Jushab-Hesed.<verse eid="1CH 3:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21"/>Nyikwa Hanania ne gin:</para>
  <para style="li2" vid="1CH 3:21">Pelatia kod Jeshaya, gi yawuot Refaya ma joka Arnan, joka Obadia, kod joka Shekania.<verse eid="1CH 3:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22"/>Shekania nonywolo Shemaya:</para>
  <para style="li2" vid="1CH 3:22">Yawuot Shemaya ne gin: Hatush, Igal, Baria, Nearia kod Shafat. Giduto ne gin ji auchiel.<verse eid="1CH 3:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23"/>Yawuot Nearia ne gin:</para>
  <para style="li2" vid="1CH 3:23">Elioenai, Hizkia kod Azrikam; giduto ne gin yawuowi adek.<verse eid="1CH 3:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24"/>Yawuot Elioenai ne gin:</para>
  <para style="li2" vid="1CH 3:24">Hodavia, Eliashib, Pelaya, Akub, Johanan, Delaya kod Anani, giduto gin yawuowi abiriyo.<verse eid="1CH 3:24"/></para>
  <chapter eid="1CH 3"/>
  <chapter number="4" style="c" sid="1CH 4"/>
  <para style="s2">Nyikwa Juda mamoko</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1"/>Nyikwa Juda ne gin:</para>
  <para style="li2" vid="1CH 4:1">Perez, Hezron, Karmi, Hur gi Shobal.<verse eid="1CH 4:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2"/>Reaya wuod Shobal nonywolo Jahath, to Jahath nonywolo Ahumai kod Lahad. Magi ema ne anywola mar jo-Zorath.<verse eid="1CH 4:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3"/>Magi ema ne yawuot Etam:</para>
  <para style="li2" vid="1CH 4:3">Jezreel, Ishma kod Idbash, to nyamin-gi niluongo ni Hazelelponi. <verse eid="1CH 4:3"/><verse number="4" style="v" sid="1CH 4:4"/>Penuel nonywolo Gedor kod Ezer ma wuon Husha.</para>
  <para style="li1" vid="1CH 4:4">Magi ne nyikwa Hur, mane en wuod Efratha makayo mane wuon Bethlehem.<verse eid="1CH 4:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5"/>Ashur wuon Tekoa ne nigi mon ariyo, Hela kod Naara.<verse eid="1CH 4:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6"/>Naara nonywolone Ahuzam, Hefer, Temeni kod Hahashtari. Magi ema ne nyikwa Naara.<verse eid="1CH 4:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7"/>Yawuot Hela ne gin:</para>
  <para style="li2" vid="1CH 4:7">Zereth, Zohar, Ethnan <verse eid="1CH 4:7"/><verse number="8" style="v" sid="1CH 4:8"/>kod Koz, mane wuon Anub, to gi Hazobeba kod anywola mar Aharhel wuod Harum.<verse eid="1CH 4:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9"/>Jabez ne ngʼat marahuma moloyo owetene. Min-gi nochake Jabez, kowacho niya, “Ne anywole gi rem.” <verse eid="1CH 4:9"/><verse number="10" style="v" sid="1CH 4:10"/>Jabez noywagorene Nyasach Israel, “Yaye, yie igwedha mondo pinyruodha omedre! Mad lweti obed koda kendo orita mondo kik gima rach ohinya kendo abedi maonge rem.” To Nyasaye notimone mana kaka ne okwayono.<verse eid="1CH 4:10"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11"/>Kelub, owadgi Shuha nonywolo Mehir mane wuon Eshton. <verse eid="1CH 4:11"/><verse number="12" style="v" sid="1CH 4:12"/>Eshton nonywolo Beth Rafa, Pasea kod Tehina mane wuon Ir Nahash. Magi ne jo-Reka.<verse eid="1CH 4:12"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13"/>Yawuot Kenaz ne gin:</para>
  <para style="li2" vid="1CH 4:13">Othniel kod Seraya.</para>
  <para style="li1" vid="1CH 4:13">Yawuot Othniel ne gin:</para>
  <para style="li2" vid="1CH 4:13">Hahath kod Meonothai. <verse eid="1CH 4:13"/><verse number="14" style="v" sid="1CH 4:14"/>Meonothai nonywolo Ofra.</para>
  <para style="li1" vid="1CH 4:14">Seraya nonywolo Joab</para>
  <para style="li2" vid="1CH 4:14">mane wuon Ge Harashim. Kanyo niluongo ni Ge Harashim nikech joma nodak kanyo ne joma payo gik moko.<verse eid="1CH 4:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15"/>Kaleb ma wuod Jefune nonywolo:</para>
  <para style="li2" vid="1CH 4:15">Iru, Ela kod Naam.</para>
  <para style="li1" vid="1CH 4:15">Ela nonywolo</para>
  <para style="li2" vid="1CH 4:15">ne en Kenaz.<verse eid="1CH 4:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16"/>Yawuot Jehalelel ne gin:</para>
  <para style="li2" vid="1CH 4:16">Zif, Zifa, Tiria kod Asarel.<verse eid="1CH 4:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17"/>Yawuot Ezra ne gin:</para>
  <para style="li2" vid="1CH 4:17">Jetha, Mered, Efer kod Jalon.</para>
  <para style="li1" vid="1CH 4:17">Achiel kuom mond Mered nonywolo Miriam, Shamai kod Ishba mane wuon Eshtemoa. <verse eid="1CH 4:17"/><verse number="18" style="v" sid="1CH 4:18"/>Magi e nyithind Bithia nyar Farao mane Mered okendo.</para>
  <para style="li1" vid="1CH 4:18">Jaode ma nyar Juda to nonywolo Jered ma wuon Gedor, Heber nonywolo Soko, to Jekuthiel nonywolo Zanoa.<verse eid="1CH 4:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19"/>Yawuot jaod Hodia, nyamin Naham ne gin:</para>
  <para style="li2" vid="1CH 4:19">Keila ja-Garmi kod Eshtemoa ja-Maaka.<verse eid="1CH 4:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20"/>Yawuot Shimon ne gin:</para>
  <para style="li2" vid="1CH 4:20">Amnon, Rina, Ben-Hanan kod Tilon.</para>
  <para style="li1" vid="1CH 4:20">Nyikwa Ishi ne gin:</para>
  <para style="li2" vid="1CH 4:20">Zoheth kod Ben-Zoheth.<verse eid="1CH 4:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21"/>Yawuot Shela wuod Juda ne gin:</para>
  <para style="li2" vid="1CH 4:21">Er ma wuon Leka, Laada ma wuon Maresha kod jo-anywola maloso lewni Beth Ashbea;<verse eid="1CH 4:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 4:22"/>Jokim, jo-Kozeba kod Joash gi Saraf mane jatend Moab kod Jashubi Leham. Weche mondikgi noyud koa e kitepe mag ndalo machon. <verse eid="1CH 4:22"/><verse number="23" style="v" sid="1CH 4:23"/>Magi ne jo-chwe agulni mane odak Netaim kod Gedera, kendo negidak kanyo ka negitiyone ruoth.<verse eid="1CH 4:23"/></para>
  <para style="s1">Nyikwa Simeon</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24"/>Nyikwa Simeon ne gin:</para>
  <para style="li2" vid="1CH 4:24">Nemuel, Jamin, Jarib, Zera kod Shaul;<verse eid="1CH 4:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25"/>Shaul nonywolo Shalum, Shalum nonywolo Mibsam, to Mibsam nonywolo Mishma.<verse eid="1CH 4:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26"/>Joka Mishma ne gin:</para>
  <para style="li2" vid="1CH 4:26">Hamuel nonywolo Zakur, Zakur nonywolo Shimei.<verse eid="1CH 4:26"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27"/>Shimei ne nigi yawuowi apar gauchiel kod nyiri auchiel, owetene to ne onge gi nyithindo mangʼeny omiyo anywolagi duto ne ok obedo oganda maduongʼ kaka jo-Juda. <verse eid="1CH 4:27"/><verse number="28" style="v" sid="1CH 4:28"/>Negidak Bersheba, Molada, Hazar Shual, <verse eid="1CH 4:28"/><verse number="29" style="v" sid="1CH 4:29"/>Bilha, Ezem, Tolad, <verse eid="1CH 4:29"/><verse number="30" style="v" sid="1CH 4:30"/>Bethuel, Horma, Ziklag, <verse eid="1CH 4:30"/><verse number="31" style="v" sid="1CH 4:31"/>Beth Makaboth, Hazar Susim, Beth Biro kod Sharaim. Magi ne miechgi nyaka chop kinde loch Daudi. <verse eid="1CH 4:31"/><verse number="32" style="v" sid="1CH 4:32"/>Miechgi abich mamoko mane olworogi ne gin Etam, Ain, Rimon, Token kod Ashan, <verse eid="1CH 4:32"/><verse number="33" style="v" sid="1CH 4:33"/>kaachiel gi gwenge duto mokiewo kodgi mag dak nyaka chopi Baalath. Magi ne miechgi mag dak.</para>
  <para style="b" vid="1CH 4:33"/>
  <para style="li4" vid="1CH 4:33">Kendo negindiko nonro margi:<verse eid="1CH 4:33"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 4:34"/>Meshobab, Jamlek,</para>
  <para style="li1" vid="1CH 4:34">Josha wuod Amazia, <verse eid="1CH 4:34"/><verse number="35" style="v" sid="1CH 4:35"/>Joel,</para>
  <para style="li1" vid="1CH 4:35">Jehu wuod Joshibia, ma wuod Seraya ma wuod Asiel,<verse eid="1CH 4:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 4:36"/>to gi Elioenai, Jakoba, Jeshohaya,</para>
  <para style="li1" vid="1CH 4:36">Asaya, Adiel, Jesimiel, Benaya,<verse eid="1CH 4:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 4:37"/>kod Ziza wuod Shifi, ma wuod Alon, ma wuod Jedaya, wuod Shimri, wuod Shemaya.<verse eid="1CH 4:37"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="38" style="v" sid="1CH 4:38"/>Chwo mondik nying-gi malogo ne jotelo mar anywolagi.</para>
  <para style="b" vid="1CH 4:38"/>
  <para style="p" vid="1CH 4:38">Anywolagi nomedore ahinya <verse eid="1CH 4:38"/><verse number="39" style="v" sid="1CH 4:39"/>kendo negidak nyaka oko mar Gedor koma omanyore gi wuok chiengʼ mar holo ka gimanyo kar kwath ne jambgi. <verse eid="1CH 4:39"/><verse number="40" style="v" sid="1CH 4:40"/>Neginwangʼo kuonde kwath mabeyo, piny ne lach kendo kwe ne nitie. Jo-Ham moko nodak kae mokwongo.<verse eid="1CH 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41"/>Chwo ma nying-gi ondikgo nobiro e ndalo Hezekia ruodh Juda. Negimonjo jo-Ham kuma negidakie kod jo-Meun mane nitie kanyo ma gitiekogi duto mana kaka nyisore ratiro nyaka sani. Negidak ka nikech ne nitiere kar kwath ne jambgi. <verse eid="1CH 4:41"/><verse number="42" style="v" sid="1CH 4:42"/>To ji mia abich kuom jo-Simeon, ka otelnigi gi Pelatia, Nearia, Refaya kod Uziel, ma yawuot Ishi ne omonjo piny got Seir. <verse eid="1CH 4:42"/><verse number="43" style="v" sid="1CH 4:43"/>Neginego jo-Amalek mane otony odongʼ kendo pod gidak kanyo nyaka chil kawuono.<verse eid="1CH 4:43"/></para>
  <chapter eid="1CH 4"/>
  <chapter number="5" style="c" sid="1CH 5"/>
  <para style="s1">Nyikwa Reuben</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 5:1"/>Reuben ne en wuod Israel makayo, to kane oterore gi chi wuon mare, to duongʼ mar ngʼat makayo nomi yawuot Josef ma wuod Israel, omiyo nyinge ne ok nyal wuok mokwongo ka indiko nying nyikwa Israel kaluwore gi chik mar kayo. <verse eid="1CH 5:1"/><verse number="2" style="v" sid="1CH 5:2"/>Kata obedo ni Juda ema ne tek moloyo owetene kendo ruoth nowuok kuome, to duongʼ mar kayo ne mar Josef. <verse eid="1CH 5:2"/><verse number="3" style="v" sid="1CH 5:3"/>Yawuot Reuben wuod Israel makayo ne gin:</para>
  <para style="b" vid="1CH 5:3"/>
  <para style="li2" vid="1CH 5:3">Hanok, Palu, Hezron kod Karmi.<verse eid="1CH 5:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4"/>Joka Joel ne gin:</para>
  <para style="li2" vid="1CH 5:4">Joel nonywolo Shemaya, Shemaya nonywolo Gog,</para>
  <para style="li2" vid="1CH 5:4">Gog nonywolo Shimei, <verse eid="1CH 5:4"/><verse number="5" style="v" sid="1CH 5:5"/>Shimei nonywolo Mika,</para>
  <para style="li2" vid="1CH 5:5">Mika nonywolo Reaya, Reaya nonywolo Baal,<verse eid="1CH 5:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6"/>Baal nonywolo Beera mane Tiglath-Pilesa ruodh Asuria otero e twech. Beera ema ne jatend joka Reuben.<verse eid="1CH 5:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7"/>To owete kowuok e anywola, kaka ondikgi e chenro mar nywolgi ema:</para>
  <para style="li2" vid="1CH 5:7">Jeyel ne jatelo, Zekaria, <verse eid="1CH 5:7"/><verse number="8" style="v" sid="1CH 5:8"/>kod Bela wuod Azaz, ma wuod Shema, wuod Joel.</para>
  <para style="b" vid="1CH 5:8"/>
  <para style="p" vid="1CH 5:8">Negidak e gwengʼ kochakore Aroer nyaka Nebo kod Baal Meon. <verse eid="1CH 5:8"/><verse number="9" style="v" sid="1CH 5:9"/>Koa yo wuok chiengʼ, negidak e piny mokiewo gi thim kadhi nyaka Aora Yufrate nikech jambgi ne omedore e piny Gilead.<verse eid="1CH 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10"/>E ndalo loch Saulo, negikedo gi jo-Hagri mane giloyo ma gikawo kuondegi mag dak duto e piny machiegni gi Gilead.<verse eid="1CH 5:10"/></para>
  <para style="s1">Nyikwa Gad</para>
  <para style="li4">
    <verse number="11" style="v" sid="1CH 5:11"/>Jo-Gad nodak e bathgi e piny Bashan nyaka chop Saleka.<verse eid="1CH 5:11"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 5:12"/>Joel ne jatendgi ka iluwe gi Shafam, Janai kod Shafat, e piny Bashan.<verse eid="1CH 5:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13"/>Owetene abiriyo kaluwore gi anywolagi ne gin:</para>
  <para style="li2" vid="1CH 5:13">Mikael, Meshulam, Sheba, Jorai, Jakan, Zia kod Eber.<verse eid="1CH 5:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14"/>Magi ema ne yawuot Abihail wuod Huri, ma wuod Jaroa, wuod Gilead, wuod Mikael, wuod Jeshishai, wuod Jado, wuod Buz.<verse eid="1CH 5:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15"/>Ahi wuod Abdiel, wuod Guni ne en jatend anywolagi.<verse eid="1CH 5:15"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="16" style="v" sid="1CH 5:16"/>Joka Gad nodak Gilead, Bashan to gi mier mokiewo kode kod lek mar Sharon duto.<verse eid="1CH 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17"/>Magi duto ne ondiki e nonro margi mar nywol e ndalo loch Jotham ruodh Juda kod Jeroboam ruodh Israel.<verse eid="1CH 5:17"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18"/>Joka Reuben, joka Gad kod nus mar dhood joka Manase ne gin ji alufu piero angʼwen gangʼwen mia abiriyo gi piero auchiel (44,760) mane oyikore ni lweny. Jolweny molony mane nyalo tiyo gi gige lweny machalo kuodi, ligangla kod atungʼ, nomi tiegruok ne lweny. <verse eid="1CH 5:18"/><verse number="19" style="v" sid="1CH 5:19"/>Negikedo gi jo-Hagri, jo-Jetur, jo-Nafish kod jo-Nodab. <verse eid="1CH 5:19"/><verse number="20" style="v" sid="1CH 5:20"/>Ne okonygi kuom kedo kendo Nyasaye nomiyogi e lwetgi jo-Hagri, to gi jogo duto mane oriwore kodgi nikech ne giywagorene e ndalo lweny. To ne odwoko lamogi nikech negiketo yie margi kuome. <verse eid="1CH 5:20"/><verse number="21" style="v" sid="1CH 5:21"/>Negipeyo jamni mag jo-Hagri, ngamia alufu piero abich (50,000), rombe alufu mia ariyo gi piero abich (250,000), to gi punde alufu ariyo (2,000). To bende negimako ji alufu mia achiel (100,000) ma gitero e twech, <verse eid="1CH 5:21"/><verse number="22" style="v" sid="1CH 5:22"/>to mamoko mangʼeny to neginego, nikech lweny ne mar Nyasaye. Pinyni nobedo margi nyaka ne otergi e twech.<verse eid="1CH 5:22"/></para>
  <para style="s1">Nus mar dhood jo-Manase</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23"/>Nus mar dhood jo-Manase ne ngʼeny mokadho; negidak e piny jo-Bashan nyaka Baal Hermon, gi Senir ma en Got Hermon.<verse eid="1CH 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 5:24"/>Magi ema ne jotelo mar anywolagi: Efer, Ishi, Eliel Azriel, Jeremia, Hodavia kod Jadiel. Ne gin jolweny mathuondi kendo marahuma kendo jotend anywolagi. <verse eid="1CH 5:24"/><verse number="25" style="v" sid="1CH 5:25"/>To negiweyo Nyasach kweregi ma gindhogore kendgi gi nyiseche mag jopinyno mane Nyasaye owachonegi ni ginegi. <verse eid="1CH 5:25"/><verse number="26" style="v" sid="1CH 5:26"/>Omiyo Nyasach jo-Israel nojiwo chuny Pul ruodh jo-Asuria (ma bende iluongo ni Tiglath-Pilesa ruodh jo-Asuria), mane otero jo-Reuben, jo-Gad, kod nus mar dhood jo-Manase e twech. Ne oterogi Hala, Habor, Hera kod but aora Gozan kuma gidakie nyaka chil kawuono.<verse eid="1CH 5:26"/></para>
  <chapter eid="1CH 5"/>
  <chapter number="6" style="c" sid="1CH 6"/>
  <para style="s1">Lawi</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 6:1"/>Yawuot Lawi ne gin:</para>
  <para style="li2" vid="1CH 6:1">Gershon, Kohath kod Merari.<verse eid="1CH 6:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2"/>Yawuot Kohath ne gin:</para>
  <para style="li2" vid="1CH 6:2">Amram, Izhar, Hebron kod Uziel.<verse eid="1CH 6:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3"/>Nyithind Amram ne gin:</para>
  <para style="li2" vid="1CH 6:3">Harun, Musa kod Miriam.</para>
  <para style="li1" vid="1CH 6:3">Yawuot Harun ne gin:</para>
  <para style="li2" vid="1CH 6:3">Nadab, Abihu, Eliazar kod Ithamar<verse eid="1CH 6:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4"/>Eliazar nonywolo Finehas,</para>
  <para style="li2" vid="1CH 6:4">to Finehas nonywolo Abishua,<verse eid="1CH 6:4"/></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5"/>Abishua nonywolo Buki,</para>
  <para style="li2" vid="1CH 6:5">to Buki nonywolo Uzi,<verse eid="1CH 6:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6"/>Uzi nonywolo Zerahia,</para>
  <para style="li2" vid="1CH 6:6">to Zerahia nonywolo Merayoth,<verse eid="1CH 6:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7"/>Merayoth nonywolo Amaria,</para>
  <para style="li2" vid="1CH 6:7">to Amaria nonywolo Ahitub,<verse eid="1CH 6:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8"/>Ahitub nonywolo Zadok,</para>
  <para style="li2" vid="1CH 6:8">Zadok nonywolo Ahimaz,<verse eid="1CH 6:8"/></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9"/>Ahimaz nonywolo Azaria,</para>
  <para style="li2" vid="1CH 6:9">to Azaria nonywolo Johanan,<verse eid="1CH 6:9"/></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10"/>Johanan nonywolo Azaria.</para>
  <para style="li2" vid="1CH 6:10">En ema ne otiyo kaka jadolo e hekalu mane Solomon ogero Jerusalem.<verse eid="1CH 6:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11"/>Azaria nonywolo Amaria,</para>
  <para style="li2" vid="1CH 6:11">to Amaria nonywolo Ahitub,<verse eid="1CH 6:11"/></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12"/>Ahitub nonywolo Zadok,</para>
  <para style="li2" vid="1CH 6:12">to Zadok nonywolo Shalum,<verse eid="1CH 6:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13"/>Shalum nonywolo Hilkia,</para>
  <para style="li2" vid="1CH 6:13">to Hilkia nonywolo Azaria,<verse eid="1CH 6:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14"/>Azaria nonywolo Seraya,</para>
  <para style="li2" vid="1CH 6:14">to Seraya nonywolo Jehozadak.<verse eid="1CH 6:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 6:15"/>Jehozadak nodar kane Jehova Nyasaye otiyo gi Nebukadneza motero Juda gi Jerusalem e twech.<verse eid="1CH 6:15"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16"/>Yawuot Lawi ne gin:</para>
  <para style="li2" vid="1CH 6:16">Gershon, Kohath kod Merari.<verse eid="1CH 6:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17"/>Magi e nying yawuot Gershon:</para>
  <para style="li2" vid="1CH 6:17">Libni kod Shimei.<verse eid="1CH 6:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18"/>Yawuot Kohath ne gin:</para>
  <para style="li2" vid="1CH 6:18">Amram, Izhar, Hebron kod Uziel.<verse eid="1CH 6:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19"/>Yawuot Merari ne gin:</para>
  <para style="li2" vid="1CH 6:19">Mali kod Mushi.</para>
  <para style="b" vid="1CH 6:19"/>
  <para style="li4" vid="1CH 6:19">Dhout jo-Lawi kaluwore kweregi e magi:<verse eid="1CH 6:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20"/>Joka Gershon ne gin:</para>
  <para style="li2" vid="1CH 6:20">Gershon nonywolo Libni, Libni nonywolo Jahath,</para>
  <para style="li2" vid="1CH 6:20">Jahath nonywolo Zima, <verse eid="1CH 6:20"/><verse number="21" style="v" sid="1CH 6:21"/>Zima nonywolo Joa,</para>
  <para style="li2" vid="1CH 6:21">Joa nonywolo Ido, Ido nonywolo Zera</para>
  <para style="li2" vid="1CH 6:21">to Zera nonywolo Jeatherai.<verse eid="1CH 6:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22"/>Joka Kohath ne gin:</para>
  <para style="li2" vid="1CH 6:22">Kohath nonywolo Aminadab, Aminadab nonywolo Kora,</para>
  <para style="li2" vid="1CH 6:22">Kora nonywolo Asir, <verse eid="1CH 6:22"/><verse number="23" style="v" sid="1CH 6:23"/>Asir nonywolo Elkana,</para>
  <para style="li2" vid="1CH 6:23">Elkana nonywolo Ebiasaf, Ebiasaf nonywolo Asir,<verse eid="1CH 6:23"/></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24"/>Asir nonywolo Tahath, Tahath nonywolo Uriel,</para>
  <para style="li2" vid="1CH 6:24">Uriel nonywolo Uzia, to Uzia nonywolo Shaul.<verse eid="1CH 6:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25"/>Joka Elkana ne gin:</para>
  <para style="li2" vid="1CH 6:25">Elkana nonywolo Amasai, Amasai nonywolo Ahimoth,<verse eid="1CH 6:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26"/>Ahimoth nonywolo Elkana, Elkana nonywolo Zofai,</para>
  <para style="li2" vid="1CH 6:26">Zofai nonywolo Nahath, <verse eid="1CH 6:26"/><verse number="27" style="v" sid="1CH 6:27"/>Nahath nonywolo Eliab,</para>
  <para style="li2" vid="1CH 6:27">Eliab nonywolo Jeroham, Jehoram nonywolo Elkana,</para>
  <para style="li2" vid="1CH 6:27">to Elkana nonywolo Samuel.<verse eid="1CH 6:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28"/>Yawuot Samuel ne gin:</para>
  <para style="li2" vid="1CH 6:28">Joel wuowi makayo,</para>
  <para style="li2" vid="1CH 6:28">kod Abija, wuode mar ariyo.<verse eid="1CH 6:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29"/>Joka Merari ne gin:</para>
  <para style="li2" vid="1CH 6:29">Merari nonywolo Mali, Mali nonywolo Libni,</para>
  <para style="li2" vid="1CH 6:29">Libni nonywolo Shimei, Shimei nonywolo Uza<verse eid="1CH 6:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30"/>Uza nonywolo Shimea, Shimea nonywolo Hagia,</para>
  <para style="li2" vid="1CH 6:30">to Hagia nonywolo Asaya.<verse eid="1CH 6:30"/></para>
  <para style="s2">Jower mag hekalu</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31"/>Magi e joma Daudi noketo mondo ochungʼ ne weche mag wer e od Jehova Nyasaye bangʼ kane osekel Sandug Muma kanyo. <verse eid="1CH 6:31"/><verse number="32" style="v" sid="1CH 6:32"/>Negipako Nyasaye gi wer ka gigoyo thum e nyim kar romo gi Nyasaye, e Hemb Romo nyaka Solomon notieko gero hekalu mar Jehova Nyasaye Jerusalem. Negitiyo tijegi moluwore kod chike mane oketnegi.<verse eid="1CH 6:32"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="33" style="v" sid="1CH 6:33"/>Magi e joma notiyo kaachiel gi yawuotgi:</para>
  <para style="b" vid="1CH 6:33"/>
  <para style="li1" vid="1CH 6:33">Koa kuom jo-Kohath ne gin:</para>
  <para style="li2" vid="1CH 6:33">Heman jago thum,</para>
  <para style="li2" vid="1CH 6:33">ma wuod Joel, ma wuod Samuel,<verse eid="1CH 6:33"/></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34"/>wuod Elkana, wuod Jeroham,</para>
  <para style="li2" vid="1CH 6:34">wuod Eliel, wuod Toa,<verse eid="1CH 6:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35"/>wuod Zuf, wuod Elkana,</para>
  <para style="li2" vid="1CH 6:35">wuod Mahath, wuod Amasai,<verse eid="1CH 6:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36"/>wuod Elkana, wuod Joel,</para>
  <para style="li2" vid="1CH 6:36">wuod Azaria, wuod Zefania,<verse eid="1CH 6:36"/></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37"/>wuod Tahath, wuod Asir,</para>
  <para style="li2" vid="1CH 6:37">wuod Ebiasaf, wuod Kora,<verse eid="1CH 6:37"/></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38"/>wuod Izhar, wuod Kohath,</para>
  <para style="li2" vid="1CH 6:38">wuod Lawi, wuod Israel;<verse eid="1CH 6:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39"/>kod Asaf jatich kaachiel gi Heman mane otiyo kochungʼ e bade korachwich.</para>
  <para style="li2" vid="1CH 6:39">Asaf wuod Berekia, wuod Shimea,<verse eid="1CH 6:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40"/>wuod Mikael, wuod Baseya,</para>
  <para style="li2" vid="1CH 6:40">wuod Malkija, <verse eid="1CH 6:40"/><verse number="41" style="v" sid="1CH 6:41"/>wuod Ethni,</para>
  <para style="li2" vid="1CH 6:41">wuod Zera, wuod Adaya,<verse eid="1CH 6:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42"/>wuod Ethan, wuod Zima,</para>
  <para style="li2" vid="1CH 6:42">wuod Shimei <verse eid="1CH 6:42"/><verse number="43" style="v" sid="1CH 6:43"/>wuod Jahath,</para>
  <para style="li2" vid="1CH 6:43">wuod Gershon, wuod Lawi;<verse eid="1CH 6:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44"/>kendo koa kuom jotich kaachiel kodgi, joka Merari kochungʼ e bade koracham ne gin:</para>
  <para style="li2" vid="1CH 6:44">Ethan wuod Kishi, wuod Abdi,</para>
  <para style="li2" vid="1CH 6:44">wuod Maluk, <verse eid="1CH 6:44"/><verse number="45" style="v" sid="1CH 6:45"/>wuod Hashabia,</para>
  <para style="li2" vid="1CH 6:45">wuod Amazia, wuod Hilkia,<verse eid="1CH 6:45"/></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46"/>wuod Amzi, wuod Bani,</para>
  <para style="li2" vid="1CH 6:46">wuod Shemer, <verse eid="1CH 6:46"/><verse number="47" style="v" sid="1CH 6:47"/>wuod Mali,</para>
  <para style="li2" vid="1CH 6:47">wuod Mushi, wuod Merari,</para>
  <para style="li2" vid="1CH 6:47">wuod Lawi.<verse eid="1CH 6:47"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48"/>Jo-Lawi mamoko to ne omi tije mamoko duto e hema, e od Nyasaye. <verse eid="1CH 6:48"/><verse number="49" style="v" sid="1CH 6:49"/>To Harun gi joge ema ne chiwo misango e kendo mar misango miwangʼo pep, kendo ne giwangʼo ubani e kendo mar ubani, kendo negitimo misango mipwodhogo richo jo-Israel. Negitiyo tije duto mag Kama Ler Moloyo, kaka Musa jatich Nyasaye nochiko.<verse eid="1CH 6:49"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50"/>Magi e joka Harun:</para>
  <para style="li2" vid="1CH 6:50">Harun nonywolo Eliazar, Eliazar nonywolo Finehas,</para>
  <para style="li2" vid="1CH 6:50">Finehas nonywolo Abishua, <verse eid="1CH 6:50"/><verse number="51" style="v" sid="1CH 6:51"/>Abishua nonywolo Buki,</para>
  <para style="li2" vid="1CH 6:51">Buki nonywolo Uzi, Uzi nonywolo Zerahia,<verse eid="1CH 6:51"/></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52"/>Zerahia nonywolo Merayoth, Merayoth nonywolo Amaria,</para>
  <para style="li2" vid="1CH 6:52">Amaria nonywolo Ahitub, <verse eid="1CH 6:52"/><verse number="53" style="v" sid="1CH 6:53"/>Ahitub nonywolo Zadok,</para>
  <para style="li2" vid="1CH 6:53">to Zadok nonywolo Ahimaz.<verse eid="1CH 6:53"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="54" style="v" sid="1CH 6:54"/>Magi e kuondegi mane gidakie kod gwenge mane omigi (tiende ni, mane omi joka Harun mane jo-dhood Kohath nikech pok mokwongo ne margi).<verse eid="1CH 6:54"/></para>
  <para style="li1">
    <verse number="55" style="v" sid="1CH 6:55"/>Ne omigi Hebron ei Juda kaachiel gi kuonde kwath molwore. <verse eid="1CH 6:55"/><verse number="56" style="v" sid="1CH 6:56"/>(To pewe kod mier molworo dala maduongʼ nomi Kaleb wuod Jefune.) <verse eid="1CH 6:56"/><verse number="57" style="v" sid="1CH 6:57"/>Omiyo nyikwa Harun nomi Hebron (ma en dala mar pondo), kod Libna, Jatir, Eshtemoa, <verse eid="1CH 6:57"/><verse number="58" style="v" sid="1CH 6:58"/>Hilen, Debir, <verse eid="1CH 6:58"/><verse number="59" style="v" sid="1CH 6:59"/>Ashan, Juta kod Beth Shemesh to gi kuondegi mag kwath.<verse eid="1CH 6:59"/></para>
  <para style="li1">
    <verse number="60" style="v" sid="1CH 6:60"/>Kuom oganda mag Benjamin to ne omi Gibeon, Geba, Alemeth kod Anathoth, kaachiel gi kuondegi mag kwath.</para>
  <para style="li4" vid="1CH 6:60">Mier mane opog ne anywola Kohath ne gin apar gadek koriwore.<verse eid="1CH 6:60"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="61" style="v" sid="1CH 6:61"/>Joka Kohath mamoko to nopog mier apar koa e nus dhout oganda Manase.<verse eid="1CH 6:61"/></para>
  <para style="li1">
    <verse number="62" style="v" sid="1CH 6:62"/>Joka Gershon, kuom anywola ka anywola nopog mier apar gadek koa kuom oganda mar Isakar, Asher kod Naftali, kendo koa e nus mar dhout oganda Manase manodak Bashan.<verse eid="1CH 6:62"/></para>
  <para style="li1">
    <verse number="63" style="v" sid="1CH 6:63"/>Joka Merari kuom anywola ka anywola to nopog mier apar gariyo koa kuom oganda Reuben, Gad kod Zebulun.<verse eid="1CH 6:63"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="64" style="v" sid="1CH 6:64"/>Omiyo jo-Israel nomiyo jo-Lawi miechgi kod kuondegi mag kwath.<verse eid="1CH 6:64"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="65" style="v" sid="1CH 6:65"/>Koa kuom oganda Juda, Simeon, kod Benjamin negipogogi mier mondik malogo.<verse eid="1CH 6:65"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="66" style="v" sid="1CH 6:66"/>Dhood Kohath mamoko ne omi mier mag dak ei oganda Efraim.<verse eid="1CH 6:66"/></para>
  <para style="li1">
    <verse number="67" style="v" sid="1CH 6:67"/>E piny got mar Efraim nomigi Shekem (ma en dala maduongʼ mar pondo) kod Gezer, <verse eid="1CH 6:67"/><verse number="68" style="v" sid="1CH 6:68"/>Jokmeam, Beth Horon, <verse eid="1CH 6:68"/><verse number="69" style="v" sid="1CH 6:69"/>Aijalon to gi Gath Rimon, kaachiel gi kuonde kweth.<verse eid="1CH 6:69"/></para>
  <para style="li1">
    <verse number="70" style="v" sid="1CH 6:70"/>To koa kuom nus oganda Manase jo-Israel nochiwo Aner kod Biliam, kaachiel gi kuondegi mag kwath ne anywola dhout Kohath mane odongʼ.<verse eid="1CH 6:70"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="71" style="v" sid="1CH 6:71"/>Jo-Gershon nonwangʼo magi:</para>
  <para style="li1" vid="1CH 6:71">Koa kuom nus anywola mar joka Manase, neginwangʼo Golan man Bashan kod Ashtaroth bende, kaachiel gi kuondegi mag kwath;<verse eid="1CH 6:71"/></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72"/>koa kuom oganda Isakar neginwangʼo Kedesh, Daberath, <verse eid="1CH 6:72"/><verse number="73" style="v" sid="1CH 6:73"/>Ramoth kod Anem, kaachiel gi kuondegi mag kwath,<verse eid="1CH 6:73"/></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74"/>koa kuom oganda Asher neginwangʼo Mashal, Abdon, <verse eid="1CH 6:74"/><verse number="75" style="v" sid="1CH 6:75"/>Hukok kod Rehob, kaachiel gi kuondegi mag kwath;<verse eid="1CH 6:75"/></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76"/>kendo kuom oganda jo-Naftali neginwangʼo Kedesh ei Galili, Hamon kod Kiriathaim, kaachiel gi kuondegi mag kwath.<verse eid="1CH 6:76"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="77" style="v" sid="1CH 6:77"/>Jo-Merari (ma gin jo-Lawi modongʼ) nonwangʼo magi:</para>
  <para style="li1" vid="1CH 6:77">Koa kuom oganda Zebulun neginwangʼo Jokneam, Karta, Rimono kod Tabor kaachiel gi kuondegi mag kwath;<verse eid="1CH 6:77"/></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78"/>koa kuom oganda Reuben modak loka Jordan, yo wuok chiengʼ momanyore gi Jeriko neginwangʼo Bezer e piny thim mar Jazer, <verse eid="1CH 6:78"/><verse number="79" style="v" sid="1CH 6:79"/>Kedemoth kod Mefath kaachiel gi kuondegi mag kwath;<verse eid="1CH 6:79"/></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80"/>to koa kuom oganda Gad neginwangʼo Ramoth man Gilead, Mahanaim, <verse eid="1CH 6:80"/><verse number="81" style="v" sid="1CH 6:81"/>Heshbon kod Jazer kaachiel gi kuondegi mag kwath.<verse eid="1CH 6:81"/></para>
  <chapter eid="1CH 6"/>
  <chapter number="7" style="c" sid="1CH 7"/>
  <para style="s1">Isakar</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 7:1"/>Yawuot Isakar ne gin:</para>
  <para style="li2" vid="1CH 7:1">Tola, Pua, Jashub kod Shimron. Yawuot Isakar duto ne gin yawuowi angʼwen.<verse eid="1CH 7:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2"/>Yawuot Tola ne gin:</para>
  <para style="li2" vid="1CH 7:2">Uzi, Refaya, Jeriel, Jamai, Ibsam kod Samuel, mane en jotend anywolagi. Ndalo loch Daudi, joka Tola kokwan chwo ma jolweny koluwore gi nonro mar nywolgi ne gin ji alufu piero ariyo gariyo gi mia auchiel (22,600).<verse eid="1CH 7:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3"/>Wuod Uzi ne en:</para>
  <para style="li2" vid="1CH 7:3">Izrahia.</para>
  <para style="li1" vid="1CH 7:3">Yawuot Izrahia ne gin:</para>
  <para style="li2" vid="1CH 7:3">Mikael, Obadia, Joel kod Ishia. Yawuowi abichgo ne gin ruodhi. <verse eid="1CH 7:3"/><verse number="4" style="v" sid="1CH 7:4"/>Kaluwore gi nonro mar anywolagi ne gin gi chwo alufu piero adek gauchiel (36,000) mane nyalo dhi e lweny, nimar ne gin gi mon gi nyithindo mangʼeny.<verse eid="1CH 7:4"/></para>
  <para style="li4">
    <verse number="5" style="v" sid="1CH 7:5"/>Wede mag jo-Isakar machwo mane ni e lweny kokwan-gi kaluwore gi nonrogi mar nywolgi ne ji alufu piero aboro gabiriyo (87,000).<verse eid="1CH 7:5"/></para>
  <para style="s1">Benjamin</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6"/>Yawuot Benjamin ne gin adek:</para>
  <para style="li2" vid="1CH 7:6">Bela, Beker kod Jediael.<verse eid="1CH 7:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7"/>Yawuot Bela ne gin:</para>
  <para style="li2" vid="1CH 7:7">Ezbon, Uzi, Uziel, Jerimoth kod Iri, giduto yawuowi abichgo ne gin jotend anywolagi. E ndiko mar nonrogi mar nywol ne gin chwo ma jolweny maromo alufu piero ariyo gariyo gi piero adek gangʼwen (22,034).<verse eid="1CH 7:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8"/>Yawuot Beker ne gin:</para>
  <para style="li2" vid="1CH 7:8">Zemira, Joash, Eliezer, Elioenai, Omri, Jeremoth, Abija, Anathoth kod Alemeth. Magi duto ne gin yawuot Beker. <verse eid="1CH 7:8"/><verse number="9" style="v" sid="1CH 7:9"/>Nonro manie anywolagi, notingʼo nying jotend dhoutgi kod jolweny alufu piero ariyo gi mia ariyo (20,200).<verse eid="1CH 7:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10"/>Wuod Jediael ne en:</para>
  <para style="li2" vid="1CH 7:10">Bilhan.</para>
  <para style="li1" vid="1CH 7:10">Yawuot Bilhan ne gin:</para>
  <para style="li2" vid="1CH 7:10">Jeush, Benjamin, Ehud, Kenana, Zethan, Tarshish kod Ahishahar. <verse eid="1CH 7:10"/><verse number="11" style="v" sid="1CH 7:11"/>Yawuot Jediael duto ne gin jotend anywolagi. Ne nitiere ji ma jolweny alufu apar gabiriyo gi mia ariyo (17,200) mane oikore dhi e lweny.<verse eid="1CH 7:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12"/>Jo-Shup gi jo-Hup ne gin joka Ir, to jo-Hush to ne gin joka Aher.<verse eid="1CH 7:12"/></para>
  <para style="s1">Naftali</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13"/>Yawuot Naftali ne gin:</para>
  <para style="li2" vid="1CH 7:13">Jaziel, Guni, Jezer kod Shilem ma joka Bilha.<verse eid="1CH 7:13"/></para>
  <para style="s1">Manase</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14"/>Joka Manase ne gin:</para>
  <para style="li2" vid="1CH 7:14">Asriel ne nyakware koa kuom dhako machielo ma nyar Aram. Dhakoni nonywolo Makir mane wuon Gilead. <verse eid="1CH 7:14"/><verse number="15" style="v" sid="1CH 7:15"/>Makir ne okawo dhako koa kuom jo-Hup kod Shup. Nyamin Makir ne iluongo ni Maaka. Watne machielo ne ochak Zelofehad mane onywolo nyiri kende. <verse eid="1CH 7:15"/><verse number="16" style="v" sid="1CH 7:16"/>Jaod Makir ma Maaka ne onywolo wuowi mochake Peresh. Owadgi ne iluongo ni Sheresh, to yawuote ne Ulam kod Rakem.<verse eid="1CH 7:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17"/>Wuod Ulam ne en:</para>
  <para style="li2" vid="1CH 7:17">Bedan.</para>
  <para style="li1" vid="1CH 7:17">Magi ne yawuot Gilead ma wuod Makir, ma wuod Manase.<verse eid="1CH 7:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 7:18"/>Nyamin mare miluongo ni Hamoleketh nonywolo Ishhod, Abiezer kod Mala.<verse eid="1CH 7:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19"/>Yawuot Shemida ne gin:</para>
  <para style="li2" vid="1CH 7:19">Ahian, Shekem, Liki kod Aniam.<verse eid="1CH 7:19"/></para>
  <para style="s1">Efraim</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20"/>Joka Efraim e magi:</para>
  <para style="li2" vid="1CH 7:20">Shuthela ma nonywolo Bered,</para>
  <para style="li2" vid="1CH 7:20">Bered nonywolo Tahath, Tahath nonywolo Eleada,</para>
  <para style="li2" vid="1CH 7:20">Eleada nonywolo Tahath, <verse eid="1CH 7:20"/><verse number="21" style="v" sid="1CH 7:21"/>Tahath nonywolo Zabad</para>
  <para style="li2" vid="1CH 7:21">bangʼe Zabad nonywolo Shuthela.</para>
  <para style="li2" vid="1CH 7:21">Yawuot Efraim moko ne gin Ezer kod Elead mane onegi gi jo-Gath ma jopinyno kane gidhi peyo jambgi. <verse eid="1CH 7:21"/><verse number="22" style="v" sid="1CH 7:22"/>Efraim wuon-gi ne oywagogi kuom ndalo mangʼeny, to wedene ne obiro mondo ohoye. <verse eid="1CH 7:22"/><verse number="23" style="v" sid="1CH 7:23"/>Bangʼe negibedo e achiel gi chiege kendo, mine omako ich ma onywolo wuowi. Ne ochake ni Beria nikech ode noseyudo masira. <verse eid="1CH 7:23"/><verse number="24" style="v" sid="1CH 7:24"/>Neginywolo nyako ma nyinge Shera, mane ogero Mwalo gi Malo mar Beth Horon kaachiel gi Uzen Shera.<verse eid="1CH 7:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 7:25"/>Beria nonywolo Refa, to Refa nonywolo Reshef</para>
  <para style="li2" vid="1CH 7:25">Reshef nonywolo Tela, Tela nonywolo Tahan,<verse eid="1CH 7:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26"/>Tahan nonywolo Ladan, to Ladan nonywolo Amihud,</para>
  <para style="li2" vid="1CH 7:26">Amihud nonywolo Elishama, <verse eid="1CH 7:26"/><verse number="27" style="v" sid="1CH 7:27"/>Elishama nonywolo Nun,</para>
  <para style="li2" vid="1CH 7:27">bangʼe Nun nonywolo Joshua.<verse eid="1CH 7:27"/></para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 7:28"/>Lopgi gi kar dakgi ne oriwo Bethel to gi mier matindo molwore kaachiel gi Naaran man yo wuok chiengʼ, Gezer kod mieche matindo yo podho chiengʼ kod Shekem to gi mieche matindo nyaka chop Aya to gi mieche. <verse eid="1CH 7:28"/><verse number="29" style="v" sid="1CH 7:29"/>Kaluwore gi tongʼ jo-Manase ne nitiere Beth Shan, Tanak, Megido kod Dor, kaachiel gi miechgi matindo. Joka Josef wuod Israel ne odakie miergi.<verse eid="1CH 7:29"/></para>
  <para style="s1">Asher</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30"/>Asher nonywolo</para>
  <para style="li2" vid="1CH 7:30">Imna gi Ishva gi Ishvi kod Beria kod nyamin-gi ma nyinge Sera.<verse eid="1CH 7:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31"/>Yawuot Beria ne gin:</para>
  <para style="li2" vid="1CH 7:31">Heber kod Malkiel nonywolo Birzaith,<verse eid="1CH 7:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32"/>Heber nonywolo Jaflet gi Shomer gi Hotham gi nyamin-gi Shua.<verse eid="1CH 7:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33"/>Yawuot Jaflet ne gin:</para>
  <para style="li2" vid="1CH 7:33">Pasak, Bimhal kod Ashvath.</para>
  <para style="li4" vid="1CH 7:33">Magi ne yawuot Jaflet.<verse eid="1CH 7:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34"/>Yawuot Shomer ne gin:</para>
  <para style="li2" vid="1CH 7:34">Ahi, Roga, Huba kod Aram.<verse eid="1CH 7:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35"/>Yawuot Helem ne gin:</para>
  <para style="li2" vid="1CH 7:35">Zofa, Imna, Shelesh kod Amal.<verse eid="1CH 7:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36"/>Yawuot Zofa ne gin:</para>
  <para style="li2" vid="1CH 7:36">Sua, Harnefa, Shual, Beri, Imra. <verse eid="1CH 7:36"/><verse number="37" style="v" sid="1CH 7:37"/>Bezer, Hod, Shama, Shilsha, Ithran kod Beera.<verse eid="1CH 7:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38"/>Yawuot Jetha ne gin:</para>
  <para style="li2" vid="1CH 7:38">Jefune, Pispa kod Ara.<verse eid="1CH 7:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39"/>Yawuot Ula ne gin:</para>
  <para style="li2" vid="1CH 7:39">Ara, Haniel kod Rizia.<verse eid="1CH 7:39"/></para>
  <para style="li4">
    <verse number="40" style="v" sid="1CH 7:40"/>Magi duto ne gin joka Asher, jotend anywola, ji ma oyiedhi, jolweny mathuondi kendo jotelo mabeyo. Kar romb jomane oikore dhiyo e lweny, ka ondikgi ginonrogi mar anywolagi ne gin ji alufu piero ariyo gi auchiel (26,000).<verse eid="1CH 7:40"/></para>
  <chapter eid="1CH 7"/>
  <chapter number="8" style="c" sid="1CH 8"/>
  <para style="s1">Nonro mar Saulo ja-Benjamin</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 8:1"/>Benjamin nonywolo</para>
  <para style="li2" vid="1CH 8:1">Bela, wuode makayo,</para>
  <para style="li2" vid="1CH 8:1">Ashbel wuode mar ariyo, Ahara mar adek,<verse eid="1CH 8:1"/></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2"/>Noha mar angʼwen kod Rafa mar abich.<verse eid="1CH 8:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3"/>Yawuot Bela ne gin:</para>
  <para style="li2" vid="1CH 8:3">Adar, Gera, Abihud, <verse eid="1CH 8:3"/><verse number="4" style="v" sid="1CH 8:4"/>Abishua, Naaman, Ahoa, <verse eid="1CH 8:4"/><verse number="5" style="v" sid="1CH 8:5"/>Gera, Shefufan kod Huram.<verse eid="1CH 8:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6"/>Magi e joka Ehud mane jotend dhoudi mane odak Geba, to ne odargi otergi Manahath.<verse eid="1CH 8:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7"/>Naaman, Ahija to gi Gera mane odarogi kendo ne en wuon Uza kod Ahihud.<verse eid="1CH 8:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8"/>Yawuowi mane onywolne Shaharaim ei Moab bangʼe kane oseriembo monde, Hushim kod Baara. <verse eid="1CH 8:8"/><verse number="9" style="v" sid="1CH 8:9"/>Mane onywolne kod chiege Hodesh, ne gin Jobab, Zibia, Mesha, Malkam, <verse eid="1CH 8:9"/><verse number="10" style="v" sid="1CH 8:10"/>Jeuz, Sakia kod Mirma. Magi ne yawuote mane otelo ne anywolagi. <verse eid="1CH 8:10"/><verse number="11" style="v" sid="1CH 8:11"/>To mane onywolne kod chiege ma Hushim, ne gin Abitub kod Elpal.<verse eid="1CH 8:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12"/>Yawuot Elpal ne gin:</para>
  <para style="li2" vid="1CH 8:12">Eber, Misham, Shemed (mane ogero Ono kod Lod kaachiel gi mier molworogi), <verse eid="1CH 8:12"/><verse number="13" style="v" sid="1CH 8:13"/>to gi Beria kod Shema mane jotend anywola mar jogo mane odak Aijalon kod jogo mane oriembo joma nodak Gath.<verse eid="1CH 8:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14"/>Ahio, Shashak, Jeremoth, <verse eid="1CH 8:14"/><verse number="15" style="v" sid="1CH 8:15"/>Zebadia, Arad, Eder, <verse eid="1CH 8:15"/><verse number="16" style="v" sid="1CH 8:16"/>Mikael, Ishpa kod Joha ne yawuot Beria.<verse eid="1CH 8:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17"/>Zebadia, Meshulam, Hizki, Heber, <verse eid="1CH 8:17"/><verse number="18" style="v" sid="1CH 8:18"/>Ishmerai, Izlia kod Jobab ne gin yawuot Elpal,<verse eid="1CH 8:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19"/>Jakim, Zikri Zabdi, <verse eid="1CH 8:19"/><verse number="20" style="v" sid="1CH 8:20"/>Elienai, Zilethai, Eliel, <verse eid="1CH 8:20"/><verse number="21" style="v" sid="1CH 8:21"/>Adaya, Beraya kod Shimrath ne gin yawuot Shimei.<verse eid="1CH 8:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22"/>Ishpan, Eber, Eliel, <verse eid="1CH 8:22"/><verse number="23" style="v" sid="1CH 8:23"/>Abdon, Zikri, Hanan, <verse eid="1CH 8:23"/><verse number="24" style="v" sid="1CH 8:24"/>Hanania, Elam, Anthothija, <verse eid="1CH 8:24"/><verse number="25" style="v" sid="1CH 8:25"/>Ifdeya kod Penuel ne gin yawuot Shashak.<verse eid="1CH 8:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26"/>Shamsherai, Sheharia, Athalia, <verse eid="1CH 8:26"/><verse number="27" style="v" sid="1CH 8:27"/>Jareshia, Elija kod Zikri ne gin yawuot Jeroham.<verse eid="1CH 8:27"/></para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 8:28"/>Magi duto ne gin jotend anywola kendo ruodhi kaka ondikgi e nonro mar anywola kendo negidak Jerusalem.<verse eid="1CH 8:28"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29"/>Jeyel wuon Gibeon ne odak Gibeon.</para>
  <para style="li2" vid="1CH 8:29">Jaode niluongo ni Maaka, <verse eid="1CH 8:29"/><verse number="30" style="v" sid="1CH 8:30"/>to wuode makayo ne en Abdon, kiluwe gi Zur, Kish, Baal, Ner, Nadab, <verse eid="1CH 8:30"/><verse number="31" style="v" sid="1CH 8:31"/>Gedor, Ahio, Zeker <verse eid="1CH 8:31"/><verse number="32" style="v" sid="1CH 8:32"/>kod Mikloth mane wuon Shimea. Gin bende negidak machiegni gi wedegi Jerusalem.<verse eid="1CH 8:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33"/>Ner ne wuon Kish, Kish ne wuon Saulo, to Saulo ne wuon Jonathan, Malki-Shua, Abinadab kod Esh-Baal.<verse eid="1CH 8:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34"/>Wuod Jonathan ne en:</para>
  <para style="li2" vid="1CH 8:34">Merib-Baal mane wuon Mika.<verse eid="1CH 8:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35"/>Yawuot Mika ne gin:</para>
  <para style="li2" vid="1CH 8:35">Pithon, Melek, Tarea kod Ahaz.<verse eid="1CH 8:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36"/>Ahaz ne wuon Jehoada, Jehoada ne wuon Alemeth, Azmaveth kod Zimri, to Zimri ne wuon Moza. <verse eid="1CH 8:36"/><verse number="37" style="v" sid="1CH 8:37"/>Moza nonywolo Binea, Binea nonywolo Rafa, Rafa nonywolo Eliasa, to Eliasa nonywolo Azel.<verse eid="1CH 8:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38"/>Azel ne nigi yawuowi auchiel kendo magi e nying-gi:</para>
  <para style="li2" vid="1CH 8:38">Azrikam, Bokeru, Ishmael, Shearia, Obadia kod Hanan. Magi duto ne yawuot Azel.<verse eid="1CH 8:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39"/>Yawuot owadgi ma Eshek ne gin:</para>
  <para style="li2" vid="1CH 8:39">Ulam wuode makayo, Jeush wuode mar ariyo to gi Elifelet mar adek. <verse eid="1CH 8:39"/><verse number="40" style="v" sid="1CH 8:40"/>Yawuot Ulam ne thuondi ma jochir mane nyalo tiyo gi atungʼ. Ne gin gi yawuowi gi nyikwayo mangʼeny; giduto ne gin ji mia achiel gi piero abich.</para>
  <para style="li1" vid="1CH 8:40">Magi duto ne gin joka Benjamin.<verse eid="1CH 8:40"/></para>
  <para style="b"/>
  <chapter eid="1CH 8"/>
  <chapter number="9" style="c" sid="1CH 9"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1"/>Jo-Israel duto ne ochan nying-gi e ndiko mar nonro mar anywolagi e kitap ruodhi mag Israel. Oganda mar Juda ne oter e twech Babulon nikech ne ok gibedo jo-ratiro.<verse eid="1CH 9:1"/></para>
  <para style="s1">Ji modak Jerusalem</para>
  <para style="li4">
    <verse number="2" style="v" sid="1CH 9:2"/>Joma nokwongo dak kendo e kuondegi giwegi kod miechgi ne gin jo-Israel moko, jodolo, jo-Lawi kod jotij hekalu.<verse eid="1CH 9:2"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="3" style="v" sid="1CH 9:3"/>Joma noa Juda, Benjamin, Efraim kod Manase mane odak Jerusalem ne gin:<verse eid="1CH 9:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4"/>Uthai wuod Amihud, wuod Omri, wuod Imri, wuod Bani, joka Perez ma wuod Juda.<verse eid="1CH 9:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5"/>Joka Shilo ne gin:</para>
  <para style="li2" vid="1CH 9:5">Asaya makayo to gi yawuote.<verse eid="1CH 9:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6"/>Joka Zera:</para>
  <para style="li2" vid="1CH 9:6">Jeul.</para>
  <para style="li4" vid="1CH 9:6">Jo-Juda ne gin ji mia auchiel gi piero ochiko (690).<verse eid="1CH 9:6"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="7" style="v" sid="1CH 9:7"/>Joka Benjamin ne gin:</para>
  <para style="li1" vid="1CH 9:7">Salu wuod Meshulam, wuod Hodavia, wuod Hasenua;<verse eid="1CH 9:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 9:8"/>Ibneia wuod Jeroham;</para>
  <para style="li1" vid="1CH 9:8">Ela wuod Uzi, wuod Mikri</para>
  <para style="li1" vid="1CH 9:8">kod Meshulam wuod Shefatia, wuod Reuel, wuod Ibnija.<verse eid="1CH 9:8"/></para>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 9:9"/>Oganda joka Benjamin kaka ochan-gi e nonro mar anywolagi kwan-gi ne romo ji mia ochiko gi piero abich gauchiel (956). Jogi duto ne gin jotend anywolagi.<verse eid="1CH 9:9"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="10" style="v" sid="1CH 9:10"/>Koa kuom oganda jodolo ne gin:</para>
  <para style="li1" vid="1CH 9:10">Jedaya, Jehokarib, Jakin,<verse eid="1CH 9:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 9:11"/>Azaria wuod Hilkia, wuod Meshulam, wuod Zadok, wuod Merayoth, wuod Ahitub mane jatelo morito Od Nyasaye;<verse eid="1CH 9:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 9:12"/>Adaya wuod Jeroham, wuod Pashur, wuod Malkija</para>
  <para style="li1" vid="1CH 9:12">kod Maasai wuod Adiel, wuod Jazera, wuod Meshulam, wuod Meshilemith, wuod Imer.<verse eid="1CH 9:12"/></para>
  <para style="li4">
    <verse number="13" style="v" sid="1CH 9:13"/>Jodolo mane jotend anywolagi ne kwan-gi romo ji alufu achiel gi mia abiriyo kod piero auchiel (1,760). Ne gin joma niginyalo kendo molony e tij Od Nyasaye.<verse eid="1CH 9:13"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="14" style="v" sid="1CH 9:14"/>Joka Lawi ne gin:</para>
  <para style="li1" vid="1CH 9:14">Shemaya wuod Hashub, wuod Azrikam, wuod Hashabia ja-Merari;<verse eid="1CH 9:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 9:15"/>Bakbakar, Heresh, Galal kod Matania wuod Mika, wuod Zikri, wuod Asaf,<verse eid="1CH 9:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 9:16"/>Obadia wuod Shemaya, wuod Galal, wuod Jeduthun;</para>
  <para style="li1" vid="1CH 9:16">kod Berekia wuod Asa, wuod Elkana mane odak e mier matindo mag jo-Netofath.<verse eid="1CH 9:16"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="17" style="v" sid="1CH 9:17"/>Jorit rangeye ne gin:</para>
  <para style="li1" vid="1CH 9:17">Shalum, Akub, Talmon, Ahiman kod owetegi; Shalum jatendgi <verse eid="1CH 9:17"/><verse number="18" style="v" sid="1CH 9:18"/>noket e Rangaj Ruoth e yo wuok chiengʼ nyaka chil kawuono. Magi ema ne jorit dhorangeye mag kuonde bworo mag jo-Lawi.<verse eid="1CH 9:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 9:19"/>Shalum wuod Kore, ma wuod Ebiasaf, wuod Kora, to gi jorit rangeye kaachiel kode moa e anywolane, ma jokora, tijgi ne rito rangeye man gohinga mag Hema mana kaka wuonegi nosebedo katimo tijno mar rito rangach midonjogo e kar dak mar Jehova Nyasaye.<verse eid="1CH 9:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 9:20"/>E ndalo mokadho Finehas wuod Eliazar ema ne jatend jorit rangach kendo Jehova Nyasaye nenikode.<verse eid="1CH 9:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 9:21"/>Zekaria wuod Meshelemia ne jarit rangach madonjo e Hemb Romo.<verse eid="1CH 9:21"/></para>
  <para style="li4">
    <verse number="22" style="v" sid="1CH 9:22"/>Koriwore duto, jogo mane oyier mondo obed jorit rangeye man gohinga kar kwan-gi ne mia ariyo gi apar gariyo (212). Ne ondik nying-gi kaluwore gi nonro mar anywolagi e miechgi.</para>
  <para style="b" vid="1CH 9:22"/>
  <para style="p" vid="1CH 9:22">Jorit rangeye ne omii tijni mogen koa e lwet Daudi gi Samuel ma jakor wach. <verse eid="1CH 9:22"/><verse number="23" style="v" sid="1CH 9:23"/>Gin gi jogegi negitelone rit mar rangeye mag od Jehova Nyasaye, ma en ot miluongo ni Hema. <verse eid="1CH 9:23"/><verse number="24" style="v" sid="1CH 9:24"/>Jorit rangeye ne nitie e bethe angʼwen ma gin: yo wuok chiengʼ, yo podho chiengʼ, yo nyandwat kod yo milambo. <verse eid="1CH 9:24"/><verse number="25" style="v" sid="1CH 9:25"/>Owetegi modak e miechgi nyaka ne bi kinde ka kinde kakonyogi tich kuom ndalo abiriyo. <verse eid="1CH 9:25"/><verse number="26" style="v" sid="1CH 9:26"/>To jorit angʼwen madongo mag rangeye ma jo-Lawi ne otelo ne tich mar rito udi gi kuonde keno mag Od Nyasaye. <verse eid="1CH 9:26"/><verse number="27" style="v" sid="1CH 9:27"/>Negidak ka girito Od Nyasaye nikech nyaka negirite; kendo gin ema negitingʼo rayaw ma iyawego pile gokinyi.<verse eid="1CH 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28"/>Jomoko kuomgi ne rito gigo mane itiyogo ei hekalu, ne gikwanogi kane okelgi kar keno kendo kogolgi. <verse eid="1CH 9:28"/><verse number="29" style="v" sid="1CH 9:29"/>Moko kuomgi to ne omi tich mar rito gik miberogo ot to gi gik mamoko duto mowal mane itiyogo e kama ler mar lemo kaachiel gi mogo kod divai, gi mo, gi ubani kod gik moko mangʼwe ngʼar. <verse eid="1CH 9:29"/><verse number="30" style="v" sid="1CH 9:30"/>To jodolo mamoko ema ne omi tij ruwo gik mangʼwe ngʼar. <verse eid="1CH 9:30"/><verse number="31" style="v" sid="1CH 9:31"/>Ja-Lawi miluongo ni Matithia, wuod Shalum ja-Kora makayo, ema ne omi tij tedo makati mar chiwo. <verse eid="1CH 9:31"/><verse number="32" style="v" sid="1CH 9:32"/>To owetene mamoko mag jo-Kohath ne omi tij keto makati e mesa chiengʼ Sabato ka Sabato.<verse eid="1CH 9:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33"/>Jogo mane gin jothum kod jotelo mag dhood Lawi ne odak e ute mag hekalu kendo ne ok omigi tije mamoko nikech gin ema negirito tich odiechiengʼ gotieno.<verse eid="1CH 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34"/>Magi duto ne jotend anywola mag jo-Lawi, ruodhi kaka ondikgi e nonro mar anywolagi kendo negidak Jerusalem.<verse eid="1CH 9:34"/></para>
  <para style="s1">Nonro mar anywola Saulo</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35"/>Jeyel wuon Gibeon ne odak Gibeon.</para>
  <para style="li2" vid="1CH 9:35">Jaode niluongo ni Maaka, <verse eid="1CH 9:35"/><verse number="36" style="v" sid="1CH 9:36"/>to wuode makayo ne en Abdon, kiluwe gi Zur, Kish, Baal, Ner, Nadab, <verse eid="1CH 9:36"/><verse number="37" style="v" sid="1CH 9:37"/>Gedor, Ahio, Zekaria kod Mikloth. <verse eid="1CH 9:37"/><verse number="38" style="v" sid="1CH 9:38"/>Mikloth ne en wuon Shimeam. Gin bende negidak but wedegi man Jerusalem.<verse eid="1CH 9:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39"/>Ner ne wuon Kish, Kish ne wuon Saulo, to Saulo ne wuon Jonathan, Malki-Shua, Abinadab kod Esh-Baal.<verse eid="1CH 9:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40"/>Wuod Jonathan ne en:</para>
  <para style="li2" vid="1CH 9:40">Merib-Baal mane wuon Mika.<verse eid="1CH 9:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41"/>Yawuot Mika ne gin:</para>
  <para style="li2" vid="1CH 9:41">Pithon, Melek, Tarea kod Ahaz.<verse eid="1CH 9:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42"/>Ahaz ne wuon Jada, Jada ne wuon Alemeth, Azmaveth kod Zimri ne wuon Moza. <verse eid="1CH 9:42"/><verse number="43" style="v" sid="1CH 9:43"/>Moza ne wuon Binea, Binea ne wuon Refaya, Refaya ne wuon Eliasa, Eliasa ne wuon Azel.<verse eid="1CH 9:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44"/>Azel ne nigi yawuowi auchiel kendo magi e nying-gi:</para>
  <para style="li2" vid="1CH 9:44">Azrikam, Bokeru, Ishmael, Shearia, Obadia kod Hanan. Magi ema ne yawuot Azel.<verse eid="1CH 9:44"/></para>
  <chapter eid="1CH 9"/>
  <chapter number="10" style="c" sid="1CH 10"/>
  <para style="s1">Tho mar Saulo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1"/>Koro jo-Filistia ne kedo gi jo-Israel kendo jo-Israel noringo e nyimgi kendo joma ngʼeny nonegi e Got Gilboa. <verse eid="1CH 10:1"/><verse number="2" style="v" sid="1CH 10:2"/>Jo-Filistia nolawo Saulo gi yawuote matek ma neginego yawuote magin Jonathan, Abinadab kod Malki-Shua. <verse eid="1CH 10:2"/><verse number="3" style="v" sid="1CH 10:3"/>Lweny nobedo mager kama Saulo ne nitie kendo kane jodir asere ojuke, to ne gihinye.<verse eid="1CH 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4"/>Saulo nowacho ni jatingʼne gige lweny niya, “Wuodh liganglani mondo inega nono to joma ok oter nyangigi biro nega kendo yanya.”</para>
  <para style="p" vid="1CH 10:4">To jatingʼne gige lweny ne luoro omako kendo ne ok onyal timo kamano, omiyo Saulo nokawo liganglane owuon mochwoworego. <verse eid="1CH 10:4"/><verse number="5" style="v" sid="1CH 10:5"/>Kane jatingʼ gige lweny oneno ka Saulo osetho en bende nokawo liganglane mochwoworego motho kode. <verse eid="1CH 10:5"/><verse number="6" style="v" sid="1CH 10:6"/>Kamano, Saulo gi yawuote adek kod joode duto notho kaachiel.<verse eid="1CH 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7"/>Kane jo-Israel duto mane nitie e holo noneno ka jolweny oseringo, kendo ni Saulo gi yawuote bende nosetho, negijwangʼo miechgi ma giringo. Kendo jo-Filistia nobiro modak e miechgigo.<verse eid="1CH 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8"/>Kinyne kane jo-Filistia obiro mondo oyak gige joma otho, negiyudo Saulo gi yawuote kotho e Got Gilboa. <verse eid="1CH 10:8"/><verse number="9" style="v" sid="1CH 10:9"/>Ne gilonyo lepe kendo ne gikaw wiye gi gige mag lweny, bangʼe negioro joote e piny jo-Filistia duto mondo oter wach ne nyisechegi kendo ni jopinygi. <verse eid="1CH 10:9"/><verse number="10" style="v" sid="1CH 10:10"/>Negiketo gige mag lweny e hekalu mar nyisechegi, to wiye, to negiliero e hekalu mar Dagon.<verse eid="1CH 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11"/>Kane jo-Jabesh Gilead nowinjo gik moko duto mane jo-Filistia osetimo ni Saulo, <verse eid="1CH 10:11"/><verse number="12" style="v" sid="1CH 10:12"/>thuondigi duto nodhi mokawo ringre Saulo kod ringre yawuote ma gikelogi Jabesh. Eka ne giyiko chokegi e tiend yien maduongʼ mar ober man Jabesh, bangʼe to negitweyo chiemo kuom ndalo abiriyo.<verse eid="1CH 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13"/>Saulo notho nikech ne ok orito singruokne gi Jehova Nyasaye. Ne ok orito chike Jehova Nyasaye, kendo nodhi mana ir jo-nyakalondo mondo onyise wach, <verse eid="1CH 10:13"/><verse number="14" style="v" sid="1CH 10:14"/>kar penjo Jehova Nyasaye wach. Omiyo Jehova Nyasaye nonege mokawo loch omiyo Daudi wuod Jesse.<verse eid="1CH 10:14"/></para>
  <chapter eid="1CH 10"/>
  <chapter number="11" style="c" sid="1CH 11"/>
  <para style="s1">Daudi obedo ruodh Israel</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1"/>Jo-Israel duto nobiro Hebron ir Daudi ma giwacho niya, “Wan ogandani kendo wan remo achiel. <verse eid="1CH 11:1"/><verse number="2" style="v" sid="1CH 11:2"/>E ndalo mokadho kata ka Saulo ne ruoth in ema ne itelo ni jo-Israel e lwenjegi. Kendo Jehova Nyasaye ma Nyasachi nowachoni niya, ‘In ema nibed jakwadh joga Israel, kendo inibed jatendgi.’ ”<verse eid="1CH 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3"/>Kane jodong Israel duto osebiro ir Ruoth Daudi e Hebron, notimo kodgi singruok e nyim Jehova Nyasaye kodgi e Hebron kanyo, kendo ne giwiro Daudi mondo obed ruodh Israel mana kaka Jehova Nyasaye nosingore gi dho Samuel.<verse eid="1CH 11:3"/></para>
  <para style="s1">Daudi okawo dala mar Jerusalem</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4"/>Daudi gi jo-Israel duto nodhi Jerusalem (tiende ni, Jebus). Jo-Jebus mane odak kanyo <verse eid="1CH 11:4"/><verse number="5" style="v" sid="1CH 11:5"/>nowacho ni Daudi niya, “Ok inidonj ka.” To kata kamano Daudi noloyogi mokawo ohinga mar Sayun, ma en Dala Maduongʼ mar Daudi.<verse eid="1CH 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6"/>Daudi nosewacho niya, “Ngʼat ma nokwong kedo gi jo-Jebus ema nobed jatend jolweny.” Joab wuod Zeruya ema nodhi mokwongo nokete jatelo.<verse eid="1CH 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7"/>Eka Daudi nodak e dala mochiel gi ohinga moluonge ni Dala Maduongʼ mar Daudi. <verse eid="1CH 11:7"/><verse number="8" style="v" sid="1CH 11:8"/>Nogero dalano kolwore gi ohinga, to Joab to noloso kuonde mamoko mag dala mane okethore. <verse eid="1CH 11:8"/><verse number="9" style="v" sid="1CH 11:9"/>Kendo Daudi nomedo bedo gi teko ahinya, nikech Jehova Nyasaye Maratego ne ni kode.<verse eid="1CH 11:9"/></para>
  <para style="s1">Thuondi mag Daudi</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10"/>Magi e jotelo mag thuondi mag Daudi, gin, kaachiel gi jo-Israel negisiro lochne mobet gi teko ma ji oyie kode e pinygi duto mana kaka Jehova Nyasaye nosingore. <verse eid="1CH 11:10"/><verse number="11" style="v" sid="1CH 11:11"/>Magi e nyinge thuondi mag Daudi:</para>
  <para style="p" vid="1CH 11:11">Jashobeam ma ja-Hakmon mane jatelo mar thuondi, nonego ji mia adek dichiel.<verse eid="1CH 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12"/>Maluwe ne en Eliazar wuod Dodai ma ja-Ahohi, achiel kuom thuondi adek. <verse eid="1CH 11:12"/><verse number="13" style="v" sid="1CH 11:13"/>Ne en kod Daudi e Pas Damim kane jo-Filistia ochokore kanyo ne lweny. Ne nitiere puoth shairi kuno. Jolweny moko noringo jo-Filistia, <verse eid="1CH 11:13"/><verse number="14" style="v" sid="1CH 11:14"/>to gin negichungʼ kar tiendgi e dier puodhono ka girite kendo ginego jo-Filistia mi Jehova Nyasaye nomiyogi loch maduongʼ.<verse eid="1CH 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15"/>Adek kuom jotelo piero adek madongo nobiro ir Daudi e lwanda manie rogo man Adulam ka jolweny mag jo-Filistia to nojot e holo mar Refaim. <verse eid="1CH 11:15"/><verse number="16" style="v" sid="1CH 11:16"/>E kindeno Daudi nopondo e rogo kendo jo-Filistia to nochokore Bethlehem. <verse eid="1CH 11:16"/><verse number="17" style="v" sid="1CH 11:17"/>Daudi riyo noloyo mowacho niya, “Yaye, mad ne ngʼato kelnae pi soko man but ranga Bethlehem mondo amodhi!” <verse eid="1CH 11:17"/><verse number="18" style="v" sid="1CH 11:18"/>Eka thuondi adekgi nomwomo oganda lweny mar jo-Filistia ma gitwomo pi koa e soko manie but rangaj Bethlehem mi gikelone Daudi pi, to nodagi modho pigno, kendo noole piny e nyim Jehova Nyasaye. <verse eid="1CH 11:18"/><verse number="19" style="v" sid="1CH 11:19"/>Nowacho niya, “Nyasaye okwero ni mondo kik atim ma! Bende anyalo modho remb jogi mane odhi ome ka gichiwo ngimagi ne wasigu?” Daudi ne ok nyal modho pigno nikech negichiwo ngimagi mondo mi gikelne pi.</para>
  <para style="p" vid="1CH 11:19">Gik ma kamago ema ne thuondigi otimo.<verse eid="1CH 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20"/>Abishai owadgi Joab ne jatend thuondi adekgi. Ne otingʼo tonge mi onego ji mia adek, mano ema nomiyo obedo ngʼat marahuma ka thuondi adekgi. <verse eid="1CH 11:20"/><verse number="21" style="v" sid="1CH 11:21"/>Nomiye duongʼ moloyo thuondi adekgi nyadiriyo ma okete jatendgi kata obedo nine ok en achiel kuomgi.<verse eid="1CH 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22"/>Benaya wuod Jehoyada ne jalweny mathuon moa Kabzel, notimo timbe madongo. Nonego ji ariyo mag Moab mane ger ka sibuor. Chiengʼ moro nodonjo e bur ka piny otimo pe mi onego sibuor. <verse eid="1CH 11:22"/><verse number="23" style="v" sid="1CH 11:23"/>Bende en ema nonego ja-Misri ma borne ne fut abiriyo gi nus. Kata nobedo ni ja-Misrino ne nigi tongʼ machalo gi lodi e lwete, Benaya nodhi kedo kode kotingʼo arungu. Noyudho tongʼ e lwet ja-Misrino monege gi tonge owuon. <verse eid="1CH 11:23"/><verse number="24" style="v" sid="1CH 11:24"/>Mago e timbe mag thuon mane Benaya wuod Jehoyada otimo, en bende ne en rahuma ka thuondi adek ka. <verse eid="1CH 11:24"/><verse number="25" style="v" sid="1CH 11:25"/>Nomiye luor maduongʼ moloyo thuondi piero adekgo, to kata kamano ne ok en achiel kuom thuondi adekgo madongo. Daudi nokete jatend jolweny mane rite.<verse eid="1CH 11:25"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="26" style="v" sid="1CH 11:26"/>Thuondigo ne gin:</para>
  <para style="b" vid="1CH 11:26"/>
  <para style="li1" vid="1CH 11:26">Asahel owadgi Joab,</para>
  <para style="li1" vid="1CH 11:26">Elhanan wuod Dodo ma ja-Bethlehem,<verse eid="1CH 11:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 11:27"/>Shamoth ja-Haror,</para>
  <para style="li1" vid="1CH 11:27">Helez ja-Pelon,<verse eid="1CH 11:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 11:28"/>Ira wuod Ikesh ma ja-Tekoa,</para>
  <para style="li1" vid="1CH 11:28">Abiezer ma ja-Anathoth,<verse eid="1CH 11:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 11:29"/>Sibekai ma ja-Hushath,</para>
  <para style="li1" vid="1CH 11:29">Ilai ma ja-Ahohi,<verse eid="1CH 11:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 11:30"/>Maharai ma ja-Netofath,</para>
  <para style="li1" vid="1CH 11:30">Heled wuod Baana ja-Netofath,<verse eid="1CH 11:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 11:31"/>Ithai wuod Ribai mawuok Gibea e piny Benjamin,</para>
  <para style="li1" vid="1CH 11:31">Benaya ja-Pirathon,<verse eid="1CH 11:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 11:32"/>Hurai moa e holo man Gash,</para>
  <para style="li1" vid="1CH 11:32">Abiel ja-Arbath, gi<verse eid="1CH 11:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 11:33"/>Azmaveth ja-Beharum,</para>
  <para style="li1" vid="1CH 11:33">Eliaba ja-Shalbon,<verse eid="1CH 11:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 11:34"/>gi yawuot Hashem ja-Gizon,</para>
  <para style="li1" vid="1CH 11:34">Jonathan wuod Shage ja-Harar,<verse eid="1CH 11:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 11:35"/>Ahiam wuod Sakar ja-Harar,</para>
  <para style="li1" vid="1CH 11:35">Elifal wuod Ur,<verse eid="1CH 11:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 11:36"/>Hefer ja-Mekerath,</para>
  <para style="li1" vid="1CH 11:36">Ahija ja-Pelon,<verse eid="1CH 11:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 11:37"/>Hezro ja-Karmel,</para>
  <para style="li1" vid="1CH 11:37">Naarai wuod Ezbai,<verse eid="1CH 11:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 11:38"/>Joel owadgi Nathan,</para>
  <para style="li1" vid="1CH 11:38">Mibhar wuod Hagri,<verse eid="1CH 11:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 11:39"/>Zelek ja-Amon,</para>
  <para style="li1" vid="1CH 11:39">Naharai ja-Beroth mane jatingʼ gige lweny mag Joab wuod Zeruya,<verse eid="1CH 11:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 11:40"/>Ira ja-Ithri,</para>
  <para style="li1" vid="1CH 11:40">Gareb ja-Ithri,<verse eid="1CH 11:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 11:41"/>Uria ja-Hiti,</para>
  <para style="li1" vid="1CH 11:41">Zabad wuod Alai,<verse eid="1CH 11:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 11:42"/>Adina wuod Shiza e piny Reuben, mane jatend jo-Reuben to gi thuondi piero adek mane ni kode.<verse eid="1CH 11:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 11:43"/>Hanan wuod Maaka,</para>
  <para style="li1" vid="1CH 11:43">Joshafat ja-Mithni,<verse eid="1CH 11:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 11:44"/>Uzia ja-Ashterath,</para>
  <para style="li1" vid="1CH 11:44">Shama kod Jeyel yawuot Hotham ja-Aroer,<verse eid="1CH 11:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 11:45"/>Jediael wuod Shimri,</para>
  <para style="li1" vid="1CH 11:45">gi Joha owadgi ma ja-Tizi,<verse eid="1CH 11:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 11:46"/>Eliel ja-Mahavi,</para>
  <para style="li1" vid="1CH 11:46">Jeribai kod Joshavia ma yawuot Elnam,</para>
  <para style="li1" vid="1CH 11:46">Ithma ja-Moab,<verse eid="1CH 11:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 11:47"/>Eliel, Obed kod Jasiel ja-Mezoba.<verse eid="1CH 11:47"/></para>
  <chapter eid="1CH 11"/>
  <chapter number="12" style="c" sid="1CH 12"/>
  <para style="s1">Jolweny mane odhi moriwore gi Daudi</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 12:1"/>Magi e joma nobiro ir Daudi Ziklag kane Saulo wuod Kish oseriembe e nyime (jogi ne gin achiel kuom jolweny mane okonye e lweny; <verse eid="1CH 12:1"/><verse number="2" style="v" sid="1CH 12:2"/>mane omanore gi atungʼ mikedogo, kendo neginyalo diro asere kata orujre gi badgi korachwich kata koracham, bende ne gin wede Saulo koa e oganda mar Benjamin):<verse eid="1CH 12:2"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 12:3"/>Jogi ne gin: Ahiezer ma jatendgi gi Joash owadgi ma yawuot Shema ja-Gibea,</para>
  <para style="li1" vid="1CH 12:3">kod Jeziel gi Pelet yawuot Azmaveth;</para>
  <para style="li1" vid="1CH 12:3">Beraka gi Jehu jo-Anathoth, <verse eid="1CH 12:3"/><verse number="4" style="v" sid="1CH 12:4"/>gi Ishmaya ja-Gibeon, ngʼat maratego kuom thuondi piero adek, ma bende ne en jatelo mar thuondi piero adek,</para>
  <para style="li1" vid="1CH 12:4">kod Jeremia gi Jahaziel gi Johanan gi Jozabad ma ja-Gedera, <verse eid="1CH 12:4"/><verse number="5" style="v" sid="1CH 12:5"/>gi Eluzai gi Jerimoth gi Bealia gi Shemaria gi Shefatia ja-Haruf;<verse eid="1CH 12:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 12:6"/>kod Elkana gi Ishia gi Azarel gi Joezer kod Jashobeam ja-Kora,<verse eid="1CH 12:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 12:7"/>kod Joela gi Zebadia yawuot Jeroham ja-Gedor.<verse eid="1CH 12:7"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8"/>Joka Gad mamoko bende noluwo Daudi e kar pondo mare e thim. Ne gin thuondi mager kendo negiikore ne lweny kendo neginyalo kedo gi tongʼ kod kuot. Wengegi ne ger ka wenge sibuoche kendo tiendgi ne yot ka tiend mwanda maringo e got.<verse eid="1CH 12:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9"/>Ezer ne jatendgi,</para>
  <para style="li1" vid="1CH 12:9">Obadia ne jalupne e telo, Eliab ne mar adek,<verse eid="1CH 12:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10"/>Mishmana ngʼat mar angʼwen, Jeremia mar abich,<verse eid="1CH 12:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11"/>Atai mar auchiel, Eliel mar abiriyo,<verse eid="1CH 12:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12"/>Johanan mar aboro, Elzabad mar ochiko,<verse eid="1CH 12:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13"/>Jeremia mar apar, to Makbanai mar apar gachiel.<verse eid="1CH 12:13"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14"/>Joka Gad-gi ne gin jotend jolweny, ma ngʼat matin kuomgi ne ipimo gi ji mia achiel, to maduongʼ kuomgi to ne ipimo gi ji alufu achiel (1,000). <verse eid="1CH 12:14"/><verse number="15" style="v" sid="1CH 12:15"/>Gin ema negingʼado aora Jordan e dwe mokwongo kane aora opongʼ moo ma gimiyo jogo mane odak e holo oringo matek kadhi wuok chiengʼ to moko podho chiengʼ.<verse eid="1CH 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16"/>To joka Benjamin mamoko gi jo-Juda mamoko bende nobiro ir Daudi e kare mar pondo. <verse eid="1CH 12:16"/><verse number="17" style="v" sid="1CH 12:17"/>Daudi nodhi moromo nigi kendo nowachonegi niya, “Ka ubiro ira gi kwe mondo ukonya, to aikora mondo ariwra kodu, to ka ubiro mondo undhoga ne wasika kata obedo ni lweta onge remo, to Nyasach kwerewa ema obed jangʼadnu bura.”<verse eid="1CH 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18"/>Eka Roho nolor kuom Amasai mane jatend thuondi piero adekgi kowacho niya,</para>
  <para style="q1" vid="1CH 12:18">“Wan jogi, yaye Daudi!</para>
  <para style="q2" vid="1CH 12:18">Wan kodi, yaye wuod Jesse!</para>
  <para style="q1" vid="1CH 12:18">Lochi, bed jaloch</para>
  <para style="q2" vid="1CH 12:18">kendo joma konyi bende olochi,</para>
  <para style="q3" vid="1CH 12:18">nikech Nyasachi biro konyi.”</para>
  <para style="p" vid="1CH 12:18">Eka Daudi norwakogi ma oketogi jotelo mag jopecho.<verse eid="1CH 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19"/>Kane Daudi odhi Filistia mondo giked gi Saulo, jo-Manase moko noweyo Saulo moriwore gi Daudi. Daudi to gi joge ne ok okonyo jo-Filistia nimar ka jotendgi ne osewuoyo kendgi negiriembe kagiwacho niya, “Onyalo negowa ka dipo ni odok ir ruodhe Saulo.” <verse eid="1CH 12:19"/><verse number="20" style="v" sid="1CH 12:20"/>Joka Manase mane odok ir Daudi koa ir Saulo mane odhi Ziklag ne gin: Adna, Jozabad, Jediael, Mikael, Jozabad, Elihu kod Zilethai mane jotend jolweny alufu achiel (1,000) kuom joka Manase moro ka moro. <verse eid="1CH 12:20"/><verse number="21" style="v" sid="1CH 12:21"/>Negikonyo Daudi kuom joma ne monje nikech giduto ne gin jolweny mathuondi, kendo ne gin jotelo mag lweny. <verse eid="1CH 12:21"/><verse number="22" style="v" sid="1CH 12:22"/>Odiechiengʼ kodiechiengʼ ji ne medo biro ir Daudi mondo okonye, nyaka nobedo gi jolweny mangʼeny machalo gi jolweny mag Nyasaye.<verse eid="1CH 12:22"/></para>
  <para style="s1">Joma moko oriwore gi Daudi Hebron</para>
  <para style="li4">
    <verse number="23" style="v" sid="1CH 12:23"/>Magi e romb ji mane oikore ne kedo mane obiro ir Daudi Hebron mondo okaw pinyruodh Saulo mane omiye mana kaka Jehova Nyasaye nosewacho:<verse eid="1CH 12:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24"/>joka Juda, mane otingʼo kuodi gi tonge ne gin ji alufu auchiel gi mia aboro (6,800) mane oikore ne lweny;<verse eid="1CH 12:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25"/>joka Simeon ne gin ji alufu abiriyo gi mia achiel (7,100) mano oikore ne lweny,<verse eid="1CH 12:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26"/>joka Lawi ne gin ji alufu angʼwen gi mia auchiel (4,600), <verse eid="1CH 12:26"/><verse number="27" style="v" sid="1CH 12:27"/>Jehoyada mane en jatelo mar anywola mar joka Harun ne nigi ji alufu adek gi mia abiriyo (3,700), <verse eid="1CH 12:27"/><verse number="28" style="v" sid="1CH 12:28"/>Zadok, ma en wuowi mathuon ne nigi jotelo piero ariyo gariyo moa e anywolane;<verse eid="1CH 12:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29"/>joka Benjamin, ma gin jo-dhoodgi Saulo ne gin ji alufu adek (3,000) ma thothgi nosebedo koyie gi od Saulo nyaka kindeno;<verse eid="1CH 12:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30"/>joka Efraim, ma gin jolweny mathuondi kendo mane rahuma e dhoodgi ne gin ji alufu piero ariyo gi mia aboro (20,800),<verse eid="1CH 12:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31"/>nus mar joka Manase mane owal mondo obi kendo giket Daudi ruoth ne gin ji alufu apar gaboro (18,000);<verse eid="1CH 12:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32"/>joka Isakar mane obedo gi rieko kuom gima timore kendo nongʼeyo gima jo-Israel onego otim ne nigi jotelo mia ariyo (200) koriw gi anywolagi mane gitelonegi;<verse eid="1CH 12:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33"/>joka Zebulun ma gin jolweny molony kendo moikore ni kedo gi gige lweny mopogore opogore mondo omi gikony Daudi gi chuny achiel ne gin ji alufu piero abich (50,000);<verse eid="1CH 12:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34"/>joka Naftali ne nigi jotelo alufu achiel (1,000) kaachiel gi ji alufu piero adek gabiriyo (37,000) motingʼo kuode kod tonge;<verse eid="1CH 12:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35"/>joka Dan mane oikore ni kedo ne gin ji alufu piero ariyo gaboro gi mia auchiel (28,600);<verse eid="1CH 12:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36"/>joka Asher, ma gin jolweny molony kendo moikore ni kedo ne gin ji alufu piero angʼwen (40,000);<verse eid="1CH 12:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37"/>kendo koa yo wuok chiengʼ mar Jordan, joka Reuben, joka Gad kod nus mar dhood joka Manase ma gin jogo moikore gi gige lweny mopogore opogore noromo ji alufu mia achiel gi piero ariyo (120,000).<verse eid="1CH 12:37"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="38" style="v" sid="1CH 12:38"/>Jolwenygi duto nochiwore mondo giti kode.</para>
  <para style="b" vid="1CH 12:38"/>
  <para style="p" vid="1CH 12:38">Negibiro Hebron ka gingʼado e chunygi ni Daudi nyaka bed ruodh jo-Israel duto. To jo-Israel mamoko bende ne nigi paro achiel mondo Daudi oket ruoth. <verse eid="1CH 12:38"/><verse number="39" style="v" sid="1CH 12:39"/>Jogi nobedo gi Daudi ndalo adek ka gichiemo kendo metho nikech jowetegi noseikonigi gik moko. <verse eid="1CH 12:39"/><verse number="40" style="v" sid="1CH 12:40"/>Bende joma nokiewo kodgi koa ka joka Isakar, joka Zebulun nyaka ka jo-Naftali nobiro kotingʼo chiemo e punde, ngamia, pundane kod rwedhi. Negikelo gik moko mangʼeny machalo mogo, olembe mag ngʼowu gi mag mzabibu motwo mongʼin gi divai, gi mo, dhok kaachiel gi rombe nikech ne nitiere mor e Israel.<verse eid="1CH 12:40"/></para>
  <chapter eid="1CH 12"/>
  <chapter number="13" style="c" sid="1CH 13"/>
  <para style="s1">Duogo Sandug Muma</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1"/>Daudi noporo wach kod jotende, jotend lweny alufe kod jotend lweny miche. <verse eid="1CH 13:1"/><verse number="2" style="v" sid="1CH 13:2"/>Bangʼe nowachone riwruok duto mar jo-Israel niya, “Ka wachni bernu kendo ka en dwaro mar Jehova Nyasaye ma Nyasachwa, to waor wach ne jowetewa mamoko kamoro amora ma gintiere e kuonde mag Israel kaachiel gi jodolo gi jo-Lawi man kodgi e miechgi to gi lege mag kwath mondo gibi irwa. <verse eid="1CH 13:2"/><verse number="3" style="v" sid="1CH 13:3"/>Eka mondo waom Sandug Muma mar Nyasachwa ma wakel ka nikech ne ok wamanye e kinde loch Saulo.” <verse eid="1CH 13:3"/><verse number="4" style="v" sid="1CH 13:4"/>Chokruokni duto noyie mondo otim mano nikech mano nonenore makare ni ji duto.<verse eid="1CH 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5"/>Daudi nochoko jo-Israel duto chakre Aora Shihor man Misri nyaka Lebo Hamath mondo giom Sandug Muma mar Nyasaye Kiriath Jearim. <verse eid="1CH 13:5"/><verse number="6" style="v" sid="1CH 13:6"/>Daudi kod jo-Israel duto mane ni kode nodhi Baala e piny Juda, ma bende iluongo ni Kiriath Jearim mondo giom Sandug Muma mar Jehova Nyasaye, mobet e kind kerubi, en sanduku mar muma miluongo gi nyinge.<verse eid="1CH 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7"/>Negigolo Sandug Muma mar Nyasaye e od Abinadab ka otingʼe e gari manyien, to Uza gi Ahio ema ne chiko garino. <verse eid="1CH 13:7"/><verse number="8" style="v" sid="1CH 13:8"/>Daudi kod jo-Israel duto ne miel gi tekregi duto e nyim Nyasaye ka gimor gi-ilo ka giwer gi thumbe gi nyatiti gi orutu gi oyieke gi kayamba kod turumbete.<verse eid="1CH 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9"/>To kane gichopo ei kar dino mar Kidon, Uza norieyo bade mondo osir Sandug Muma mane dhi podho nikech rwedhi mane ywayo gari notangni. <verse eid="1CH 13:9"/><verse number="10" style="v" sid="1CH 13:10"/>To Jehova Nyasaye nokecho gi Uza kendo ne ochwade nikech nomako Sandug Muma omiyo notho e nyim Nyasaye.<verse eid="1CH 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11"/>Daudi nokecho nikech mirima mager mar Jehova Nyasaye nomwomore kuom Uza, omiyo nochak kanyo ni Perez Uza, nying ma pod iluongogo kanyo nyaka chil kawuono.<verse eid="1CH 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12"/>Luoro nomako Daudi chiengʼno nikech Jehova Nyasaye mopenjo niya, “Ere kaka dakel Sandug Muma mar Jehova Nyasaye ka?” <verse eid="1CH 13:12"/><verse number="13" style="v" sid="1CH 13:13"/>Omiyo ne ok okawo Sandug Muma mar Nyasaye mondo odhigo e Dala Maduongʼ mar Daudi, to nobaro otere e od Obed-Edom ja-Giti. <verse eid="1CH 13:13"/><verse number="14" style="v" sid="1CH 13:14"/>Sandug Muma mar Nyasaye nosiko kuno gi jood Obed-Edom e ode kuom dweche adek kendo Jehova Nyasaye nogwedho gimoro amora e ode mane en-go.<verse eid="1CH 13:14"/></para>
  <chapter eid="1CH 13"/>
  <chapter number="14" style="c" sid="1CH 14"/>
  <para style="s1">Jood Daudi gi anywolane</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1"/>Koro Hiram ruodh Turo nooro joote ir Daudi ka gitingʼo sirni mag yiend sida, kaachiel gi jogedo mag kite kod jopa bao mondo gigerne dala ruoth. <verse eid="1CH 14:1"/><verse number="2" style="v" sid="1CH 14:2"/>Kendo Daudi nongʼeyo ni Jehova Nyasaye osegure kaka ruodh Israel kendo ni osetingʼ pinyruodhe malo nikech joge Israel.<verse eid="1CH 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3"/>Daudi nomedo kendo mon mamoko Jerusalem kendo nonywolo yawuowi gi nyiri mangʼeny. <verse eid="1CH 14:3"/><verse number="4" style="v" sid="1CH 14:4"/>Magi e nying nyithindo mane onywolo ka en Jerusalem: Shamua, Shobab, Nathan, Solomon, <verse eid="1CH 14:4"/><verse number="5" style="v" sid="1CH 14:5"/>Ibhar, Elishua, Elpelet, <verse eid="1CH 14:5"/><verse number="6" style="v" sid="1CH 14:6"/>Noga, Nefeg, Jafia, <verse eid="1CH 14:6"/><verse number="7" style="v" sid="1CH 14:7"/>Elishama, Beliada kod Elifelet.<verse eid="1CH 14:7"/></para>
  <para style="s1">Daudi oloyo jo-Filistia</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8"/>Kane jo-Filistia owinjo ni Daudi osewir bedo ruodh jo-Israel, negiwuok kar rombgi mondo gidware, to ka Daudi nowinjo wachno omiyo nowuok mondo orom kodgi. <verse eid="1CH 14:8"/><verse number="9" style="v" sid="1CH 14:9"/>Koro jo-Filistia nosebiro ma gimonjo holo mar Refaim, <verse eid="1CH 14:9"/><verse number="10" style="v" sid="1CH 14:10"/>omiyo Daudi nopenjo Nyasaye niya, “Bende anyalo dhi mondo amonj jo-Filistia? Bende iniketgi e lweta?”</para>
  <para style="p" vid="1CH 14:10">Jehova Nyasaye nodwoke niya, “Dhiyo, nikech abiro chiwogi e lweti.”<verse eid="1CH 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11"/>Omiyo Daudi gi joge nodhi nyaka Baal Perazim kendo noloyogi kanyo. Eka nowacho niya, “Mana kaka pi muomo, e kaka Jehova Nyasaye osemwomore ni wasika gi lweta.” Mano emomiyo kanyo nochak ni Baal Perazim. <verse eid="1CH 14:11"/><verse number="12" style="v" sid="1CH 14:12"/>Jo-Filistia noweyo nyisechegi kanyo kendo Daudi nochiwo chik mondo wangʼ-gi gi mach.<verse eid="1CH 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13"/>Jo-Filistia nochako omonjo joma odak e holo kanyo, <verse eid="1CH 14:13"/><verse number="14" style="v" sid="1CH 14:14"/>omiyo Daudi nopenjo Nyasaye kendo, to Nyasaye nodwoke niya, “Kik ichomgi tir, to lwor gi yo ka ngʼegi kendo imonjgi kama omanyore gi omburi. <verse eid="1CH 14:14"/><verse number="15" style="v" sid="1CH 14:15"/>Kiwinjo ka wi omburi yiengni, iwuog mapiyo idhi e lweny nikech mano biro nyiso ni Nyasaye osetelo e nyimi mondo otiek jolweny mag jo-Filistia.” <verse eid="1CH 14:15"/><verse number="16" style="v" sid="1CH 14:16"/>Omiyo Daudi notimo kaka Nyasaye nochike kendo neginego jolweny mag jo-Filistia kochakore Gibeon nyaka Gezer.<verse eid="1CH 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17"/>Humb Daudi nolandore e piny duto kendo Jehova Nyasaye nomiyo ogendini duto oluore.<verse eid="1CH 14:17"/></para>
  <chapter eid="1CH 14"/>
  <chapter number="15" style="c" sid="1CH 15"/>
  <para style="s1">Okel Sandug Muma mar Nyasaye Jerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1"/>Kane Daudi osegero ute e Dala Maduongʼ mar Daudi, ne oloso kama Sandug Muma mar Nyasaye nyalo betie ma ogurone hema. <verse eid="1CH 15:1"/><verse number="2" style="v" sid="1CH 15:2"/>Bangʼe Daudi nowacho niya, “Onge ngʼato machielo manyalo tingʼo Sandug Muma mar Nyasaye makmana jo-Lawi nikech Jehova Nyasaye noyierogi mondo gitingʼ Sandug Muma mar Jehova Nyasaye kendo mondo gitine nyaka chiengʼ.”<verse eid="1CH 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3"/>Daudi nochoko jo-Israel duto Jerusalem mondo gikel Sandug Muma mar Jehova Nyasaye kama ne oselosone.<verse eid="1CH 15:3"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="4" style="v" sid="1CH 15:4"/>Ne ochoko bende nyikwa Harun kod jo-Lawi kanyakla.<verse eid="1CH 15:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5"/>Koa e nyikwa Kohath,</para>
  <para style="li2" vid="1CH 15:5">ne gin ji mia achiel gi piero ariyo kotelnegi gi Uriel,<verse eid="1CH 15:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6"/>koa e nyikwa Merari,</para>
  <para style="li2" vid="1CH 15:6">ne gin ji mia ariyo gi piero ariyo kotelnegi gi Asaya,<verse eid="1CH 15:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7"/>koa e nyikwa Gershon,</para>
  <para style="li2" vid="1CH 15:7">ne gin ji mia achiel gi piero adek kotelnegi gi Joel,<verse eid="1CH 15:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8"/>koa e nyikwa Elizafan,</para>
  <para style="li2" vid="1CH 15:8">ne gin ji mia ariyo kotelnegi gi Shemaya,<verse eid="1CH 15:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9"/>koa e nyikwa Hebron,</para>
  <para style="li2" vid="1CH 15:9">ne gin ji piero aboro kotelnegi gi Eliel<verse eid="1CH 15:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10"/>koa e nyikwa Uziel,</para>
  <para style="li2" vid="1CH 15:10">ne gin ji mia achiel gi apar gariyo kotelnegi gi Aminadab.<verse eid="1CH 15:10"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11"/>Bangʼe Daudi noluongo Zadok kod Abiathar ma jodolo kod Uriel, Asaya, Joel, Shemaya, Eliel kod Aminadab ma ja-Lawi. <verse eid="1CH 15:11"/><verse number="12" style="v" sid="1CH 15:12"/>Nowachonegi niya, “Un e jotend anywola mar jo-Lawi, un kaachiel gi joweteu ma jo-Lawi nyaka upwodhru mondo uom Sandug Muma mar Jehova Nyasaye, ma Nyasach Israel mondo ukele kama aseikone. <verse eid="1CH 15:12"/><verse number="13" style="v" sid="1CH 15:13"/>Jehova Nyasaye ma Nyasachwa ne iye owangʼ kodwa e kinde mokwongo nikech un jo-Lawi ne ok udhi ome bende ne ok wapenje kaka dine wakele e yo mowinjore.” <verse eid="1CH 15:13"/><verse number="14" style="v" sid="1CH 15:14"/>Omiyo jodolo kod jo-Lawi nopwodhore mondo mi gikel Sandug Muma mar Jehova Nyasaye ma Nyasach jo-Israel. <verse eid="1CH 15:14"/><verse number="15" style="v" sid="1CH 15:15"/>Jo-Lawi noliero Sandug Muma mar Nyasaye e gokgi gi ludhe, mana kaka Musa nochiko kaluwore gi wach Jehova Nyasaye.<verse eid="1CH 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16"/>Daudi nowachone jotend jo-Lawi mondo oyier jowetegi kaka jower mondo ower wende mag mor ka gigoyo thumbe machalo orutu, nyatiti gi ongengʼo.<verse eid="1CH 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17"/>Omiyo jo-Lawi noyiero Heman wuod Joel kuom owetene, Asaf wuod Berekia, to kuom owetegi ma joka Merari, negiyiero Ethan wuod Kushaya <verse eid="1CH 15:17"/><verse number="18" style="v" sid="1CH 15:18"/>kaachiel gi jowetene ma jolupne e tich, mane gin: Zekaria, Jaziel, Shemiramoth, Jehiel, Uni, Eliab, Benaya, Maseya, Matithia, Elifelehu, Mikneya, Obed-Edom kod Jeyel ma jorit rangeye.<verse eid="1CH 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19"/>To jogo thum ma Heman, Asaf kod Ethan nonego go ongengʼo mar mula, <verse eid="1CH 15:19"/><verse number="20" style="v" sid="1CH 15:20"/>Zekaria, Aziel, Shemiramoth, Jehiel, Uni, Eliab, Maseya kod Benaya nonego go nyatiti kaluwore gi chenro wer miluongo ni <char style="tl">alamoth</char>,<note caller="+" style="f"><char style="fr" closed="false">15:20 </char><char style="ft" closed="false">Kit wer mane jogi wero.</char></note> <verse eid="1CH 15:20"/><verse number="21" style="v" sid="1CH 15:21"/>to Matithia, Elifelehu, Mikneya, Obed-Edom, Jeyel kod Azazia to nonego go nyatiti kaluwore gi chenro miluongo ni <char style="tl">sheminith.</char><note caller="+" style="f"><char style="fr" closed="false">15:21 </char><char style="ft" closed="false">Kit wer mane jogi wero.</char></note> <verse eid="1CH 15:21"/><verse number="22" style="v" sid="1CH 15:22"/>Kenania jatend jo-Lawi notelo ne wer, mano ne tije nikech nolony e wer ahinya.<verse eid="1CH 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23"/>Berekia kod Elkana to ne gin jorit dhout od Sandug Muma mar Nyasaye. <verse eid="1CH 15:23"/><verse number="24" style="v" sid="1CH 15:24"/>Shabania, Joshafat, Nethanel, Amasai, Zekaria, Benaya kod Eliezer ma jodolo, to nonego go turumbete e nyim Sandug Muma mar Nyasaye. Obed-Edom kod Jehia bende ne jorit od Sandug Muma mar Nyasaye.<verse eid="1CH 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25"/>Omiyo Daudi kod jodong Israel kaachiel gi jotend lweny mane orito jolweny alufu achiel ne odhi mondo okel Sandug Muma mar singruok mar Jehova Nyasaye koa e od Obed-Edom gi ilo. <verse eid="1CH 15:25"/><verse number="26" style="v" sid="1CH 15:26"/>Negitimo misango gi rwedhi abiriyo kod rombe abiriyo nikech Nyasaye nokonyo jo-Lawi manotingʼo Sandug Muma mar singruok mar Jehova Nyasaye. <verse eid="1CH 15:26"/><verse number="27" style="v" sid="1CH 15:27"/>Daudi, jo-Lawi duto mane otingʼo Sandug Muma mar singruok mar Nyasaye, jower kaachiel gi Kenania mane otelo ne jower norwakore gi aroche mag bafta. Daudi bende norwako law mayom mar dolo miluongo ni efod. <verse eid="1CH 15:27"/><verse number="28" style="v" sid="1CH 15:28"/>Kamano jo-Israel nokelo Sandug Muma mar singruok mar Jehova Nyasaye ka gigoyo sigalagala gi tunge im, gi turumbete kod ongengʼo kendo ka gigoyo orutu kod nyatiti.<verse eid="1CH 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29"/>Kane Sandug Muma mar singruok mar Jehova Nyasaye ochopo e Dala Maduongʼ mar Daudi, ne oyudo ka Mikal nyar Saulo ne ngʼicho gie dirisa. To ka noneno Ruoth Daudi kamiel kendo tugo komor, nochaye gie chunye.<verse eid="1CH 15:29"/></para>
  <chapter eid="1CH 15"/>
  <chapter number="16" style="c" sid="1CH 16"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1"/>Negikelo Sandug Muma mar Nyasaye mi gikete ei hema mane Daudi ogurone, bangʼe negitimo misengini miwangʼo pep kod misengini mag lalruok e nyim Nyasaye. <verse eid="1CH 16:1"/><verse number="2" style="v" sid="1CH 16:2"/>Kane Daudi osetieko chiwo misango miwangʼo pep kod misango mar lalruok, ne ogwedho jo-Israel ka oluongo nying Jehova Nyasaye. <verse eid="1CH 16:2"/><verse number="3" style="v" sid="1CH 16:3"/>Bangʼe ngʼato ka ngʼato ma ja-Israel, dhako kata dichwo nomiyo makati achiel, gi ringʼo mayom kod olembe motwo mongʼin.<verse eid="1CH 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4"/>Noyiero jo-Lawi moko mondo oti e nyim Sandug Muma mar Jehova Nyasaye, mondo olem kendo ogo erokamano ka gipako Jehova Nyasaye ma Nyasach Israel. <verse eid="1CH 16:4"/><verse number="5" style="v" sid="1CH 16:5"/>Asaf ne jatendgi, Zekaria jalupne, kiluwogi kod Jeyel, Shemiramoth, Jehiel, Matithia, Eliab, Benaya, Obed-Edom gi Jeyel mane jogo orutu gi nyatiti ka Asaf to ne dwongʼo ongengʼo <verse eid="1CH 16:5"/><verse number="6" style="v" sid="1CH 16:6"/>to Benaya kod Jahaziel ma jodolo to ne goyo turumbete e sa ka sa e nyim sanduk singruok mar Nyasaye.<verse eid="1CH 16:6"/></para>
  <para style="s1">Zaburi mar Daudi mar goyo erokamano</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7"/>Chiengʼno ema ne Daudi omiyo Asaf kod jowetene zaburini mar goyo erokamano ni Jehova Nyasaye kama:<verse eid="1CH 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8"/>Pakuru Jehova Nyasaye,</para>
  <para style="q2" vid="1CH 16:8">luonguru nyinge,</para>
  <para style="q2" vid="1CH 16:8">landuru ne ogendini duto gima osetimo.<verse eid="1CH 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9"/>Werneuru, pakeuru gi wende,</para>
  <para style="q2" vid="1CH 16:9">nyisuru kuom tijene duto miwuoro.<verse eid="1CH 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10"/>Nyinge maler nigi duongʼ,</para>
  <para style="q2" vid="1CH 16:10">chuny joma manyo Jehova Nyasaye mondo obed mamor.<verse eid="1CH 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11"/>Ranguru Jehova Nyasaye gi tekone,</para>
  <para style="q2" vid="1CH 16:11">dwaruru wangʼe kinde duto.<verse eid="1CH 16:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12"/>Paruru gik miwuoro mosetimo,</para>
  <para style="q2" vid="1CH 16:12">honni mage kod buche mosengʼado,<verse eid="1CH 16:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13"/>yaye, un nyikwa Israel jatichne,</para>
  <para style="q2" vid="1CH 16:13">yaye, un yawuot Jakobo joge moyiero.<verse eid="1CH 16:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14"/>En e Jehova Nyasaye ma Nyasachwa;</para>
  <para style="q2" vid="1CH 16:14">buchene ni e piny duto.<verse eid="1CH 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15"/>Oparo singruokne nyaka chiengʼ,</para>
  <para style="q2" vid="1CH 16:15">weche mane osingo e tienge tara,<verse eid="1CH 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16"/>Singruok mane otimo gi Ibrahim,</para>
  <para style="q2" vid="1CH 16:16">muma mane okwongʼorego ni Isaka.<verse eid="1CH 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17"/>Ne ogure ne Jakobo kaka chik,</para>
  <para style="q2" vid="1CH 16:17">kendo nogure ni Israel kaka singruok mochwere:<verse eid="1CH 16:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18"/>Nowacho niya, “Anamiyi piny Kanaan kaka</para>
  <para style="q2" vid="1CH 16:18">girkeni mari.”<verse eid="1CH 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19"/>Kane pod gin ji manok e kar rombgi,</para>
  <para style="q2" vid="1CH 16:19">ne ginok ahinya kendo ne gin welo e pinyno,<verse eid="1CH 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20"/>ne giwuotho e kind ogendini mopogore,</para>
  <para style="q2" vid="1CH 16:20">ka gidhi e pinyruodhi mopogore opogore.<verse eid="1CH 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21"/>Ne ok oyie mondo ngʼato osandgi,</para>
  <para style="q2" vid="1CH 16:21">nokwero ruodhi kowachonegi niya,<verse eid="1CH 16:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22"/>“Kik umul joga ma awiro,</para>
  <para style="q2" vid="1CH 16:22">kik uhiny jonabi maga.”<verse eid="1CH 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23"/>Weruru ne Jehova Nyasaye un ji duto modak e piny,</para>
  <para style="q2" vid="1CH 16:23">landuru warruokne odiechiengʼ kodiechiengʼ.<verse eid="1CH 16:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24"/>Huluru duongʼne e kind ogendini</para>
  <para style="q2" vid="1CH 16:24">kendo landuru tijene miwuoro ne ji duto.<verse eid="1CH 16:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25"/>Nimar Jehova Nyasaye duongʼ kendo owinjore gi pak;</para>
  <para style="q2" vid="1CH 16:25">onego omiye luor moloyo nyiseche mamoko duto.<verse eid="1CH 16:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26"/>Nikech nyiseche duto mag ogendini gin mana gik ma dhano oloso,</para>
  <para style="q2" vid="1CH 16:26">to Jehova Nyasaye ema nochweyo polo.<verse eid="1CH 16:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27"/>Duongʼ kod pak nitiere e nyime;</para>
  <para style="q2" vid="1CH 16:27">teko kod mor nitiere kar dakne.<verse eid="1CH 16:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28"/>Pakuru Jehova Nyasaye, yaye ogendini manie piny,</para>
  <para style="q2" vid="1CH 16:28">wachuru ni Jehova Nyasaye duongʼ kendo en gi teko.<verse eid="1CH 16:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29"/>Miuru Jehova Nyasaye duongʼ mowinjore gi nyinge.</para>
  <para style="q2" vid="1CH 16:29">Keluru chiwo kendo ubi ire mondo.</para>
  <para style="q1" vid="1CH 16:29">Ulam Jehova Nyasaye e lerne marieny mar berne.<verse eid="1CH 16:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="1CH 16:30"/>Un ji duto manie piny, beduru gi e nyime!</para>
  <para style="q2" vid="1CH 16:30">Piny osegur motegno kendo ok noyienge.<verse eid="1CH 16:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31"/>Polo mondo obed moil,</para>
  <para style="q2" vid="1CH 16:31">piny mondo obed mamor,</para>
  <para style="q1" vid="1CH 16:31">we mondo giwachne e dier ogendini niya,</para>
  <para style="q2" vid="1CH 16:31">“Jehova Nyasaye olocho!”<verse eid="1CH 16:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32"/>Nam kod gik moko duto man e iye bende omor,</para>
  <para style="q2" vid="1CH 16:32">beduru mamor un pewe kod gik manie iwu.<verse eid="1CH 16:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33"/>Bangʼe yiende manie bungu nower,</para>
  <para style="q2" vid="1CH 16:33">giniwer gi mor e nyim Jehova Nyasaye,</para>
  <para style="q2" vid="1CH 16:33">nikech obiro ngʼadone piny bura.<verse eid="1CH 16:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34"/>Gouru erokamano ne Jehova Nyasaye nikech ober;</para>
  <para style="q2" vid="1CH 16:34">kendo herane osiko manyaka chiengʼ.<verse eid="1CH 16:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35"/>Ywaguru niya, “Reswa aa Nyasaye ma Jawarwa,</para>
  <para style="q2" vid="1CH 16:35">chokwa kendo reswa kuom ogendini,</para>
  <para style="q1" vid="1CH 16:35">mondo mi wadwok erokamano ne nyingi maler</para>
  <para style="q2" vid="1CH 16:35">kendo wabed mamor kwapaki.”<verse eid="1CH 16:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36"/>Pakuru Jehova Nyasaye, ma Nyasach Israel</para>
  <para style="q2" vid="1CH 16:36">mochwere manyaka chiengʼ.</para>
  <para style="m" vid="1CH 16:36">Eka ji duto nowacho niya, “Amin” kendo ni “Opak Jehova Nyasaye.”<verse eid="1CH 16:36"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37"/>Daudi ne oweyo Asaf kod jotich kaachiel kode e nyim Sandug Singruok mar Jehova Nyasaye mondo giti kanyo ndalo duto mana kaka ne dwarore pile ka pile kendo odiechiengʼ ka odiechiengʼ. <verse eid="1CH 16:37"/><verse number="38" style="v" sid="1CH 16:38"/>Ne oweyo bende Obed-Edom kod jowetene piero auchiel gaboro mondo joti kodgi. Obed-Edom wuod Jeduthun to gi Hosa bende ne jorit rangeye.<verse eid="1CH 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39"/>Daudi noweyo Zadok jadolo kod jowetene ma jodolo e nyim hekalu mar Jehova Nyasaye e kama otingʼore gi malo man Gibeon, <verse eid="1CH 16:39"/><verse number="40" style="v" sid="1CH 16:40"/>mondo gichiwne Jehova Nyasaye misengini pile pile e kendo mar misango miwangʼo pep, gitim kamano okinyi kod odhiambo mana kaka ondikgi duto e Chik Jehova Nyasaye mano mi jo-Israel. <verse eid="1CH 16:40"/><verse number="41" style="v" sid="1CH 16:41"/>Kaachiel kodgi ne gin Heman gi Jeduthun kod joma moko manoyier kendo oluong gi nyingegi mondo gi dwokne Jehova Nyasaye erokamano, “nikech herane osiko manyaka chiengʼ.” <verse eid="1CH 16:41"/><verse number="42" style="v" sid="1CH 16:42"/>Heman kod Jeduthun to ne tijgi en goyo turumbete kod ongengʼo kod goyo thumbe mamoko mag wend Nyasaye. Yawuot Jeduthun to ne rito rangach.<verse eid="1CH 16:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43"/>Eka ji duto noa ka ngʼato ka ngʼato dok e dalane, kendo Daudi bende nodhi dalane mondo ogwedh joge.<verse eid="1CH 16:43"/></para>
  <chapter eid="1CH 16"/>
  <chapter number="17" style="c" sid="1CH 17"/>
  <para style="s1">Singruok mar Nyasaye ne Daudi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1"/>Bangʼ ka Daudi nosedonjo e ode mar ruoth, nowacho ni Nathan janabi niya, “Koro anto adak e od ruoth moger gi yiend sida, to Sandug Muma mar singruok mar Jehova Nyasaye to osiko e bwo hema.”<verse eid="1CH 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2"/>Nathan nodwoko Daudi niya, “gimoro amora manie chunyi to dhi nyime mondo itim nikech Nyasaye ni kodi.”<verse eid="1CH 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3"/>Otienono wach mar Nyasaye nobiro ni Nathan kawacho niya,<verse eid="1CH 17:3"/></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4"/>“Dhiyo mondo inyis jatichna Daudi niya, ‘Ma e gima Jehova Nyasaye wacho: In ok nigerna ot mondo adagie. <verse eid="1CH 17:4"/><verse number="5" style="v" sid="1CH 17:5"/>Pok adak e ot chakre ndalo mane agolo jo-Israel e piny Misri nyaka kawuono. Asebedo kawuotho e kuonde mogurie hema ka adar e kuonde dak mopogore. <verse eid="1CH 17:5"/><verse number="6" style="v" sid="1CH 17:6"/>Kuonde duto masewuothoe gi jo-Israel duto, bende asewachoe ni jotendgi mane aketo jokwadh joga niya, “Angʼo momiyo pok ugerona ot mar yiend sida?” ’<verse eid="1CH 17:6"/></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7"/>“Omiyo koro wach ni jatichna Daudi niya, ‘Ma e gima Jehova Nyasaye Maratego wacho kama: Ne agoli e lek kuma ne ikwayoe rombe mondo ibed jatend joga Israel. <verse eid="1CH 17:7"/><verse number="8" style="v" sid="1CH 17:8"/>Asebedo kodi kuonde duto misedhiye, kendo asetieko wasiki duto e nyimi. Koro abiro miyo nyingi bed kaka humb jomadongo manie piny. <verse eid="1CH 17:8"/><verse number="9" style="v" sid="1CH 17:9"/>Kendo abiro chiwo piny ni joga Israel kendo abiro gurogi mondo gibed gi pinygi giwegi mondo kik chandgi kendo. Jomahundu ok nochak osandgi kendo kaka negitimonegi mokwongo, <verse eid="1CH 17:9"/><verse number="10" style="v" sid="1CH 17:10"/>kendo kaka gisetimo nyaka chakre ne ayier jotelo marito joga Israel. Bende abiro loyo wasiki duto.</para>
  <para style="pm" vid="1CH 17:10">“ ‘Awachoni ni Jehova Nyasaye biro geroni ot: <verse eid="1CH 17:10"/><verse number="11" style="v" sid="1CH 17:11"/>Ka ndaloni orumo mitho kendo iluwo kwereni, to abiro keto kothi moro mondo okaw kari, achiel kuom yawuoti minywolo kendo anagur pinyruodhe. <verse eid="1CH 17:11"/><verse number="12" style="v" sid="1CH 17:12"/>En ema noger ot ni nyinga kendo anagur lochne osik nyaka chiengʼ. <verse eid="1CH 17:12"/><verse number="13" style="v" sid="1CH 17:13"/>Anabed wuon-gi, to enobed wuoda. Ok nagol herana kuome kaka ne agolo herana kuom ruoth mane ikawo loch kuome. <verse eid="1CH 17:13"/><verse number="14" style="v" sid="1CH 17:14"/>Anakete motegno e oda kendo kuom pinyruodhe nyaka chiengʼ, lochne nogur motegno manyaka chiengʼ.’ ”<verse eid="1CH 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15"/>Nathan nonyiso Daudi weche duto mane ofwenyne.<verse eid="1CH 17:15"/></para>
  <para style="s1">Lemo mar Daudi</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16"/>Eka Ruoth Daudi nodonjo e hema mobet piny e nyim Jehova Nyasaye mowacho niya,</para>
  <para style="pm" vid="1CH 17:16">“An to an ngʼa, yaye Jehova Nyasaye, to jooda to gin ngʼa gini momiyo isetimona gigi duto? <verse eid="1CH 17:16"/><verse number="17" style="v" sid="1CH 17:17"/>To ka gima kamano ok oromo e nyim wangʼi, yaye Jehova Nyasaye, to isewuoyo kuom gima biro timore e od jatichni. Isengʼiya mana ka gima an ngʼat motingʼ malo moloyo ji duto, yaye Jehova Nyasaye.<verse eid="1CH 17:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18"/>“En angʼo ma Daudi dimed wachoni kuom duongʼ ma isemiyo jatichni? Nikech ingʼeyo jatichni, <verse eid="1CH 17:18"/><verse number="19" style="v" sid="1CH 17:19"/>yaye Jehova Nyasaye. Nikech wach misewacho kendo koluwore gi dwaroni, isetimo tim maduongʼni bende isemiyo singruok madongogi ongʼere.<verse eid="1CH 17:19"/></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20"/>“Yaye Jehova Nyasaye, onge ngʼama chalo kodi kendo onge Nyasaye moro makmana in, mana kaka wasewinjo gi itwa wawegi. <verse eid="1CH 17:20"/><verse number="21" style="v" sid="1CH 17:21"/>Ere oganda machal gi jogi Israel? Bende nitiere oganda moro mane Nyasache osedhi moreso ka gin wasumbini milokogi jogi? Donge isemiyo nyingi duongʼ kuom timbe madongo kendo malich, nimar iseriembo ogendini mamoko e nyim jogi mane ireso kigolo Misri? <verse eid="1CH 17:21"/><verse number="22" style="v" sid="1CH 17:22"/>Ne imiyo jogi ma jo-Israel obedo jogi iwuon nyaka chiengʼ to bende in Jehova Nyasaye isebedo Nyasachgi.<verse eid="1CH 17:22"/></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23"/>“To koro Jehova Nyasaye, mi singruok misetimo kuom jatichni kod ode mondo ogurre nyaka chiengʼ. Tim mana kaka ne isingori, <verse eid="1CH 17:23"/><verse number="24" style="v" sid="1CH 17:24"/>mondo mi ogurre kendo nyingi obed maduongʼ nyaka chiengʼ. Eka ji biro wacho ni, ‘Jehova Nyasaye Maratego, en Nyasach jo-Israel!’ Kendo dhood jatichni Daudi nogurre e nyimi.<verse eid="1CH 17:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25"/>“In, Nyasacha isefwenyo ni jatichni ni ibiro gerona ot omiyo jatichni osebet gi chir mondo olami. <verse eid="1CH 17:25"/><verse number="26" style="v" sid="1CH 17:26"/>Yaye Jehova Nyasaye, in e Nyasaye! Kendo isesingo gik mabeyogi ni jatichni. <verse eid="1CH 17:26"/><verse number="27" style="v" sid="1CH 17:27"/>Emomiyo iseyie mondo igwedh od jatichni mondo osik e nyimi nyaka chiengʼ nikech isegwedhe kendo inigwedhe nyaka chiengʼ, yaye Jehova Nyasaye.”<verse eid="1CH 17:27"/></para>
  <chapter eid="1CH 17"/>
  <chapter number="18" style="c" sid="1CH 18"/>
  <para style="s1">Lwenje mane Daudi oloyo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1"/>E kinde moko, Daudi noloyo jo-Filistia ma gibedo e bwo lochne kendo nokawo Gath to gi mier matindo molwore koa kuom jo-Filistia.<verse eid="1CH 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2"/>Daudi noloyo jo-Moab bende kendo negibedo e bwo lochne kendo negigolone osuru.<verse eid="1CH 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3"/>Bende Daudi nokedo gi Hadadezer ma ruodh Zoba nyaka ochopo Hamath kane odhi mondo ogur lochne e dho Aora Yufrate. <verse eid="1CH 18:3"/><verse number="4" style="v" sid="1CH 18:4"/>Daudi nomako geche lweny alufu achiel gi joidh farese alufu abiriyo, to gi jolweny mawuotho gi tiendgi alufu piero ariyo. Nongʼado odond farese duto makmana farese mia achiel kuomgi ema noweyo.<verse eid="1CH 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5"/>Kane jo-Aram moa Damaski obiro konyo Hadadezer ruodh Zoba, Daudi nonego ji alufu piero ariyo gariyo kuomgi. <verse eid="1CH 18:5"/><verse number="6" style="v" sid="1CH 18:6"/>Noketo kambi mag jolwenje e dala maduongʼ mar Damaski e piny jo-Aram kendo jo-Aram nobedo e bwo lochne kendo negikelone osuru. Jehova Nyasaye nomiyo Daudi olocho kamoro amora mane odhiye.<verse eid="1CH 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7"/>Daudi nokawo kuodi molos gi dhahabu mane otingʼ gi jotend lweny mag Hadadezer mi okelogi Jerusalem. <verse eid="1CH 18:7"/><verse number="8" style="v" sid="1CH 18:8"/>Chakre Teba kod Kun, mane gin miech Hadadezer, Daudi nokawo mula mangʼeny, mane Solomon olosogo gima iluongo ni Nam mar mula gi sirni, to gi gik mopogore opogore molos gi mula.<verse eid="1CH 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9"/>Kane Tou ruodh Hamath nowinjo ni Daudi noloyo jolweny duto mag Hadadezer ruodh Zoba, <verse eid="1CH 18:9"/><verse number="10" style="v" sid="1CH 18:10"/>nooro wuode Hadoram ir Ruoth Daudi mondo oterne omose kendo opake kuom locho e kedo kod Hadadezer mane osebedo kakedo gi Tou. Hadoram nokelo gik mopogore opogore ma olos gi dhahabu gi fedha kod mula.<verse eid="1CH 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11"/>Ruoth Daudi nochiwo gigi ne Jehova Nyasaye, mana kaka ne osetimo gi fedha kod dhahabu manokawo kuom ogendini duto: jo-Edom kod jo-Moab, jo-Amon kod jo-Filistia to gi jo-Amalek.<verse eid="1CH 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12"/>Abishai wuod Zeruya nonego jo-Edom alufu apar gaboro e Holo mar Chumbi. <verse eid="1CH 18:12"/><verse number="13" style="v" sid="1CH 18:13"/>Nogero kar kambi jolweny ei Edom kendo jo-Edom nobedo e bwo loch Daudi. Jehova Nyasaye nomiyo Daudi olocho kamoro amora mane odhiye.<verse eid="1CH 18:13"/></para>
  <para style="s1">Jodongo mag Daudi</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14"/>Daudi nobedo ruodh jo-Israel duto kotimo maber kendo makare ni joge duto.<verse eid="1CH 18:14"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 18:15"/>Joab ma wuod Zeruya ne jatend jolweny,</para>
  <para style="li1" vid="1CH 18:15">to Jehoshafat wuod Ahilud ne jachan weche,<verse eid="1CH 18:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 18:16"/>Zadok wuod Ahitub kod Abimelek wuod Abiathar to ne jodolo,</para>
  <para style="li1" vid="1CH 18:16">Shavsha ne jagoro;<verse eid="1CH 18:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 18:17"/>Benaya wuod Jehoyada to ne jatend joka Kereth kod joka Peleth,</para>
  <para style="li1" vid="1CH 18:17">to yawuot Daudi to ne gin jotelo madongo makonyo ruoth.<verse eid="1CH 18:17"/></para>
  <chapter eid="1CH 18"/>
  <chapter number="19" style="c" sid="1CH 19"/>
  <para style="s1">Kedo gi jo-Amon</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1"/>E kinde mamoko Nahash ruodh Amon notho mi wuode nobedo ruoth kare. <verse eid="1CH 19:1"/><verse number="2" style="v" sid="1CH 19:2"/>Daudi noparo e chunye kowacho niya, “Anatim ngʼwono ni Hanun wuod Nahash, nikech wuon mare bende notimona ngʼwono.” Omiyo Daudi nooro joote mondo otimne Hanun mos kuom tho wuon mare.</para>
  <para style="p" vid="1CH 19:2">Kane joote Daudi nobiro ir Hanun e piny jo-Amon mondo gitimne mos, <verse eid="1CH 19:2"/><verse number="3" style="v" sid="1CH 19:3"/>joka ruoth mag Amon nowachone Hanun niya, “Iparo ni Daudi miyo wuonu duongʼ ka ooro ji iri mondo ogoni mos? Donge joge osebiro mana mondo ginon kendo gicheng pinywa mondo onwangʼ yo ma onyalo loyego?” <verse eid="1CH 19:3"/><verse number="4" style="v" sid="1CH 19:4"/>Omiyo Hanun nomako joote Daudi molielogi, ma ongʼado lepgi koa e dier ngʼegi nyaka e nungogi kadhi piny, bangʼe to oriembogi.<verse eid="1CH 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5"/>Kane ngʼato obiro mi onyiso Daudi gima osetimore ne joge, ne ooro joote mondo oromnegi nikech ne giyudo wichkuot malich. Ruoth nowacho niya, “Beduru Jeriko nyaka yie tiku dongi eka bangʼe uduogi.”<verse eid="1CH 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6"/>Kane jo-Amon oneno ka gisechido chuny Daudi, Hanun kod jo-Amon nooro fedha madirom kilo alufu piero adek mondo giholgo geche gi joriembgi kuom jo-Aram-Naharaim, jo-Aram Maaka kod jo-Zoba. <verse eid="1CH 19:6"/><verse number="7" style="v" sid="1CH 19:7"/>Ne giholo geche alufu piero adek gariyo gi joriembgi kaachiel gi ruodh jo-Maaka gi jolweny mage kendo negibiro ma gigoyo kambi but Medeba, to jo-Amon nochoki e miechgi mi negiyworone lweny.<verse eid="1CH 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8"/>Kane Daudi owinjo wachno nooro Joab gi jokedo mag lweny duto. <verse eid="1CH 19:8"/><verse number="9" style="v" sid="1CH 19:9"/>Jo-Amon nobiro mi giriedo ne lweny e dhoranga dalagi maduongʼ kane ruodhi mane obiro konyogi ne nikendgi e pap.<verse eid="1CH 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10"/>Joab noneno ni wasigu ni yo ka nyime gi yo katoke, omiyo noyiero jolweny mabeyo moloyo ei Israel, moketogi mondo giked gi jo-Aram. <verse eid="1CH 19:10"/><verse number="11" style="v" sid="1CH 19:11"/>To joge mane odongʼ to noketo e bwo owadgi Abishai kendo nochomogi kuom jo-Amon. <verse eid="1CH 19:11"/><verse number="12" style="v" sid="1CH 19:12"/>Joab nowacho niya, “Ka jo-Aram dwaro loya, to ubi ukonya, to ka diponi jo-Amon tek moloyi, to anabi akonyi. <verse eid="1CH 19:12"/><verse number="13" style="v" sid="1CH 19:13"/>Bed motegno kendo wakeduru motegno ne jowa kendo ni mier madongo mag Nyasachwa. Jehova Nyasaye notim gima ber e nyim wangʼe.”<verse eid="1CH 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14"/>Eka Joab gi jolweny mane ni kode nodhi mondo oked gi jo-Aram kendo negiringo e nyimgi. <verse eid="1CH 19:14"/><verse number="15" style="v" sid="1CH 19:15"/>Kane jo-Amon oneno jo-Aram karingo gin bende negiringo e nyim owadgi ma Abishai mi gidhi ei dala maduongʼ. Eka Joab nodok Jerusalem.<verse eid="1CH 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16"/>Bangʼ kane jo-Aram oneno ni jo-Israel oseloyogi, negioro joote moomo jo-Aram mane ni loka Aora kotelnegi gi Shofak mane jatend jolwenj Hadadezer.<verse eid="1CH 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17"/>Kane onyis Daudi wachni, nochoko jo-Israel duto ma ongʼado aora Jordan, kendo nochomogi mi giriedo ne lweny momanyore kodgi. Daudi noriedo joge mondo girad e lweny kod jo-Aram mi gikedo kode. <verse eid="1CH 19:17"/><verse number="18" style="v" sid="1CH 19:18"/>To negiringo gia e nyim jo-Israel kendo Daudi nonego jolwenjgi alufu abiriyo ma joidho geche miywayo gi farese to gi jolweny mawuotho gi tiendgi alufu piero angʼwen. Bende nonego Shofak mane jatend jolwenjgi.<verse eid="1CH 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19"/>Kane jopiny mane nitie e bwo loch Hadadezer oneno ni jo-Israel oseloyogi negiloso kwe kod Daudi mi gibedo e bwo lochgi.</para>
  <para style="p" vid="1CH 19:19">Omiyo jo-Aram ne ok ochako oyie konyo jo-Amon kendo.<verse eid="1CH 19:19"/></para>
  <chapter eid="1CH 19"/>
  <chapter number="20" style="c" sid="1CH 20"/>
  <para style="s1">Okaw dala miluongo ni Raba</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1"/>E kinde chakruok oro, e ndalo ma ruodhi thoro wuok kadhi kedo, Joab nowuok gi jolwenjgo momanore gi gige lweny. Ne omuko moketho piny jo-Amon bangʼe odhi Raba ma olwore gi jolweny, Daudi to nodongʼ Jerusalem. Joab nomonjo Raba moweyo kokethe chuth. <verse eid="1CH 20:1"/><verse number="2" style="v" sid="1CH 20:2"/>Daudi nogolo osimbo ewi ruodhgi, ma pek mar dhahabu molosego nonwangʼ ni dirom kilo piero adek gangʼwen, kendo nochom kuome kite ma nengogi tek mi nosidhe ewi Daudi. Nokawo gik mangʼeny mane oyako e dala maduongʼno <verse eid="1CH 20:2"/><verse number="3" style="v" sid="1CH 20:3"/>kendo nodaro joma nodak kanyo moketogi e tich mar tiyogi musmende, kod tindo mag chuma kod ledhi. Daudi notimo mano ne mier duto mag jo-Amon. Bangʼe Daudi gi jolweny mage duto nodok Jerusalem.<verse eid="1CH 20:3"/></para>
  <para style="s1">Kedo gi jo-Filistia</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4"/>E kinde mamoko lweny nowuok Gezer e kindgi gi jo-Filistia. E ndalogo Sibekai ma ja-Hushath nonego Sipai mane en achiel kuom nyikwa Refai omiyo nolo jo-Filistia.<verse eid="1CH 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5"/>E lweny machielo gi jo-Filistia, Elhanan wuod Jair nonego Lami ma owadgi Goliath ja-Giti mane ni kod tongʼ ma bonde romo gi lodi.<verse eid="1CH 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6"/>Lweny machielo nochako owuok Gath, kama ne nitie ngʼat marabet mane nigi lith lwedo auchiel gi lith tielo auchiel koni gi koni, lith lwetene gi mag tiendene koriw to ne romo piero ariyo gangʼwen. En bende ne en nyakwar Rafa. <verse eid="1CH 20:6"/><verse number="7" style="v" sid="1CH 20:7"/>To kane othiano ni jo-Israel, Jonathan wuod Shimea ma owadgi Daudi nonege.<verse eid="1CH 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8"/>Magi ne nyikwa Rafa ja-Gath mane Daudi gi joge onego.<verse eid="1CH 20:8"/></para>
  <chapter eid="1CH 20"/>
  <chapter number="21" style="c" sid="1CH 21"/>
  <para style="s1">Daudi okwano joma nyalo dhiyo e lweny</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1"/>Satan ne dwaro hinyo jo-Israel omiyo nosundo Daudi mondo okwan jo-Israel. <verse eid="1CH 21:1"/><verse number="2" style="v" sid="1CH 21:2"/>Daudi nowachone Joab kaachiel gi jotend jolweny niya, “Dhiuru kendo ukwan jo-Israel kochakore Bersheba nyaka chop Dan, bangʼe to inyisa kar rombgi mondo mi angʼe ni gin ji adi.”<verse eid="1CH 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3"/>To Joab nodwoke niya, “Mad Jehova Nyasaye med jolweny madirom nyadi mia achiel. Ruodha kendo jatenda, to donge gin duto gin jo-ruoth? To en angʼo momiyo ruoth ma en ruodha didwar timo richo machal kama ni Israel?”<verse eid="1CH 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4"/>Kata kamano ruoth notamo Joab omiyo Joab nowuok modhi e piny jo-Israel duto, bangʼe noduogo Jerusalem. <verse eid="1CH 21:4"/><verse number="5" style="v" sid="1CH 21:5"/>Joab nokelo ne Daudi kar kwan jolweny kama: Kuom jo-Israel ne nitie ji tara achiel gi alufu mia achiel mane nyalo tingʼo ligangla koriwore gi jo-Juda alufu mia angʼwen gi piero abiriyo.<verse eid="1CH 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6"/>To Joab ne ok okwano jo-Lawi kod jo-Benjamin nikech nosin gi chik ruoth. <verse eid="1CH 21:6"/><verse number="7" style="v" sid="1CH 21:7"/>Chikni ne rach ahinya e nyim wangʼ Nyasaye omiyo nokumo jo-Israel.<verse eid="1CH 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8"/>Eka Daudi nowacho ni Nyasaye niya, “Asetimo richo maduongʼ kuom gima asetimoni. To koro akwayi mondo igol richoni kuom jatichni. Asetimo gima ofuwo ahinya.”<verse eid="1CH 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9"/>Jehova Nyasaye nowacho ne Gad ma jokor wach mar Daudi niya, <verse eid="1CH 21:9"/><verse number="10" style="v" sid="1CH 21:10"/>“Dhiyo iwach ni Daudi ni, ‘Ma e gima Jehova Nyasaye wacho: Aketo weche adek e nyimi. Yier achiel kuomgi monego atimni.’ ”<verse eid="1CH 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11"/>Omiyo Gad nodhi ir Daudi mowachone niya, “Ma e gima Jehova Nyasaye owacho: ‘Kaw achiel kuomgi: <verse eid="1CH 21:11"/><verse number="12" style="v" sid="1CH 21:12"/>higni adek mag kech, dweche adek ma wasiku biro lawoue gi ligangla ka negou kata ndalo adek mar ligangla mar Jehova Nyasaye (ma en ndalo mag dera marach e piny), ka malaika Jehova Nyasaye neko kamoro amora e piny Israel.’ Koro par ane mondo imiya dwoko matero ni ngʼama ne oora.”<verse eid="1CH 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13"/>Daudi nodwoko Gad niya, “An-gi chuny lit ahinya. Ber mondo alwar e lwet Jehova Nyasaye nikech ngʼwonone duongʼ, to kik iweya mondo alwar e lwet ji.”<verse eid="1CH 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14"/>Omiyo Jehova Nyasaye nokelo masira kuom jo-Israel kendo nonego jo-Israel alufu piero abiriyo. <verse eid="1CH 21:14"/><verse number="15" style="v" sid="1CH 21:15"/>Kendo Nyasaye nooro malaika mondo oketh Jerusalem. To kane malaikano timo kamano Jehova Nyasaye noneno mano mi okuyo nikech tim malichno mi nonyiso malaika mane nego ji niya, “Oromo! Koro dwok lweti.” Malaika mar Jehova Nyasaye noyudo ochungʼ e kar dino cham mar Arauna ja-Jebus.<verse eid="1CH 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16"/>Daudi nongʼiyo malo ma oneno malaika mar Jehova Nyasaye kochungo e kind polo gi piny ka otingʼo ligangla mager e lwete mane orieyo kuom Jerusalem. Bangʼe Daudi gi jodongo nopodho piny auma ka girwakore gi pien gugru.<verse eid="1CH 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17"/>Daudi nowacho ni Jehova Nyasaye niya, “Donge an ema nagolo chik mondo okwan joma nyalo dhi e lweny? An ma an jakwath ema asetimo richo kendo aseketho. Magi to gin mana rombe, angʼo magiseketho? Yaye Jehova Nyasaye ma Nyasacha, akwayi ni an ema ikuma kaachiel gi joga to kik iwe masira odongʼ kuom jogi.”<verse eid="1CH 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18"/>Bangʼe malaika mar Jehova Nyasaye nochiko Gad mondo onyis Daudi odhi malo kar dino cham ma Arauna ja-Jebus mondo oger kendo mar misango ni Jehova Nyasaye. <verse eid="1CH 21:18"/><verse number="19" style="v" sid="1CH 21:19"/>Omiyo Daudi nodhi malo kaluwore gi wach mane Gad osewachone kuom nying Jehova Nyasaye.<verse eid="1CH 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20"/>Kane Arauna dino ngano, notingʼo wangʼe ma oneno malaika, yawuote mane ni kode nopondo. <verse eid="1CH 21:20"/><verse number="21" style="v" sid="1CH 21:21"/>Bangʼe Daudi nodhi ire, kane Arauna ogoyo wangʼe monene, nowuok kar dino mokulore auma nyaka e lowo e nyim Daudi.<verse eid="1CH 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22"/>Daudi nonyise niya, “Yie imiya laru mar dino cham mondo angʼiew mondo agerie kendo mar misango ni Jehova Nyasaye eka tho manego ji orum. Yie iusnago e kar romb nengone duto.”<verse eid="1CH 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23"/>Arauna nowacho ne Daudi niya, “Kawe! Mad ruodha ma jatenda okawe kendo otim kode gima chunye dwaro. Ne, anamiyi rwedhi mondo ichiw kaka misango miwangʼo pep, kod gige dino kaka yien kaachiel gi ngano kaka cham michiwo; abiro chiwogi duto.”<verse eid="1CH 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24"/>To Ruoth Daudi nodwoko Arauna niya, “Ooyo, nyaka achuli nengone duto mowinjore kode.” Ok anayie ngangʼ kawo ne Jehova Nyasaye giri nono kata timo misango miwangʼo pep ma ok achuloe gimoro.<verse eid="1CH 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25"/>Omiyo Daudi nochulo Arauna pesa mag dhahabu ma dirom kilo abiriyo mane nengo kar dinono. <verse eid="1CH 21:25"/><verse number="26" style="v" sid="1CH 21:26"/>Daudi nogero kendo mar misango ni Jehova Nyasaye kanyo kendo nochiwo misango miwangʼo pep kod chiwo mar lalruok. Noluongo Jehova Nyasaye, kendo Jehova Nyasaye nodwoke gi mach moa e polo kalwar e kendo mar misango miwangʼo pep.<verse eid="1CH 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27"/>Eka Jehova Nyasaye nowuoyo gi malaika mine odwoko liganglane e olalo mare. <verse eid="1CH 21:27"/><verse number="28" style="v" sid="1CH 21:28"/>E sechego Daudi notimo misengini kanyo kane oneno ni Jehova Nyasaye osedwoke e laru mar dino mar Arauna ja-Jebus. <verse eid="1CH 21:28"/><verse number="29" style="v" sid="1CH 21:29"/>Hekalu mar Jehova Nyasaye mane Musa oloso e thim, kaachiel gi kendo mar misango miwangʼo pep e kindego ne pod nitiere e kar lemo man Gibeon. <verse eid="1CH 21:29"/><verse number="30" style="v" sid="1CH 21:30"/>Kata kamano, Daudi ne ok nyal dhiyo bute mondo openj Nyasaye nikech ne oluoro ligangla mar malaika mar Jehova Nyasaye.<verse eid="1CH 21:30"/></para>
  <chapter eid="1CH 21"/>
  <chapter number="22" style="c" sid="1CH 22"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1"/>Bangʼe Daudi nowacho niya, “Ma e kama od Jehova Nyasaye ma Nyasaye nobedie, kendo kae ema jo-Israel nogerie kendo mar misango miwangʼo pep.”<verse eid="1CH 22:1"/></para>
  <para style="s1">Ikruok mar gero hekalu</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2"/>Omiyo Daudi nogolo chik mondo ochok jodak duto manie piny jo-Israel kendo koa kuomgi noyiero jangʼad kite mondo opa kite migerogo od Nyasaye. <verse eid="1CH 22:2"/><verse number="3" style="v" sid="1CH 22:3"/>Noiko nyinyo modhuro mondo olosgo musmande migedogo kendo mirwakogo dhoudi mag rangeye gi mula mathoth mokadho apima. <verse eid="1CH 22:3"/><verse number="4" style="v" sid="1CH 22:4"/>Bende noiko yiend sida madongo ma ok kwan nikech jo-Sidon gi jo-Turo nokelone Daudi yiende mangʼeny mag sida.<verse eid="1CH 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5"/>Daudi nowacho niya, “Wuoda Solomon pod rawera mayot kendo en gi ngʼeyo matin, to ot monego ogerne Jehova Nyasaye nyaka bed miwuoro kendo ma humbe gi berne onego onere e piny mangima. Omiyo nyaka aikne gige gedo.” Kuom mano, Daudi noiko gik moko mangʼeny kapok otho.<verse eid="1CH 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6"/>Bangʼe noluongo wuode Solomon mochike ni mondo oger ot ne Jehova Nyasaye, ma Nyasach Israel. <verse eid="1CH 22:6"/><verse number="7" style="v" sid="1CH 22:7"/>Daudi nowachone Solomon niya, “Wuoda naparo e chunya mondo ager ot miluongo gi Nying Jehova Nyasaye, ma Nyasacha. <verse eid="1CH 22:7"/><verse number="8" style="v" sid="1CH 22:8"/>To wach Jehova Nyasaye nobirona kawacho ni, ‘Isechwero remo mangʼeny kendo isekedo lwenje mangʼeny. Ok iniger ot maluongo Nyinga nikech isechwero remo mangʼeny e nyima. <verse eid="1CH 22:8"/><verse number="9" style="v" sid="1CH 22:9"/>To ininywol wuowi manobed ngʼat mohero kwe maonge tungni, kendo anami obed gi kwe kuom jowasike molwore. Enochake ni Solomon, mi anakelni jo-Israel kwe e ndalo lochne. <verse eid="1CH 22:9"/><verse number="10" style="v" sid="1CH 22:10"/>En ema noger ot miluongo gi Nyinga. Enobed wuoda, to anabed wuon mare kendo anagur loch mar pinyruodhe mar Israel nyaka chiengʼ.’<verse eid="1CH 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11"/>“Koro wuoda, Jehova Nyasaye obed kodi, kendo mad ogwedhi mondo mi iger od Jehova Nyasaye, ma Nyasachi kaka nosewacho ni initim. <verse eid="1CH 22:11"/><verse number="12" style="v" sid="1CH 22:12"/>Mad Jehova Nyasaye omiyi rieko kod ngʼeyo e kinde moketi mondo irit jo-Israel kendo mondo mi irit chik Jehova Nyasaye, ma Nyasachi. <verse eid="1CH 22:12"/><verse number="13" style="v" sid="1CH 22:13"/>Bangʼe inine ber kimako chike kod buche ma Jehova Nyasaye nomiyo Musa ne jo-Israel. Bed motegno kendo gichir, kik iluor kata kik chunyi bed gi nyosruok.<verse eid="1CH 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14"/>“Aseneno lit malich mondo aikne od Jehova Nyasaye dhahabu ma pekne romo tan alufu adek mia abiriyo gi piero abich kaachiel gi fedha ma pekne romo tan alufu piero adek gabiriyo gi mia abich kaachiel gi mula kod nyinyo ma pekgi okadho apima kod yiende gi kite. In bende inyalo medo moko. <verse eid="1CH 22:14"/><verse number="15" style="v" sid="1CH 22:15"/>In gi jotich mangʼeny kaka jopa kite, jogedo gi jopa bao kaachiel gi ji molony e tije mopogore opogore, <verse eid="1CH 22:15"/><verse number="16" style="v" sid="1CH 22:16"/>mag dhahabu, kod fedha, mula kod nyinyo kaachiel gi jopecho mokadho akwana. Koro chak tich, mad Jehova Nyasaye obed kodi.”<verse eid="1CH 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17"/>Bangʼe Daudi nochiko jotend Israel duto mondo okony wuode Solomon. <verse eid="1CH 22:17"/><verse number="18" style="v" sid="1CH 22:18"/>Nowachonegi niya, “To donge Jehova Nyasaye ma Nyasachu ni kodu? To donge osemiyou kwe e alworau duto? Nimar osechiwo joma odak e pinyni e lweta ma pinyni koro nitie e bwo loch Jehova Nyasaye kaachiel gi joge. <verse eid="1CH 22:18"/><verse number="19" style="v" sid="1CH 22:19"/>Omiyo koro keturu chunyu gi ngimau kuom dwaro Jehova Nyasaye ma Nyasachu. Koro chakuru gero kama ler mar lemo mar Jehova Nyasaye mondo omi ukel Sandug Muma mar Singruok mar Jehova Nyasaye kod gigo mopwodhi mag Nyasaye ei hekalu mibiro gero ne Nying Jehova Nyasaye.”<verse eid="1CH 22:19"/></para>
  <chapter eid="1CH 22"/>
  <chapter number="23" style="c" sid="1CH 23"/>
  <para style="s1">Jo-Lawi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1"/>Kane Daudi koro oseti kendo hike ne ngʼeny, ne oketo wuode Solomon obedo ruodh Israel.<verse eid="1CH 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2"/>Bende ne ochoko jodongo duto mag jo-Israel kaachiel gi jodolo kod jo-Lawi. <verse eid="1CH 23:2"/><verse number="3" style="v" sid="1CH 23:3"/>Jo-Lawi machwo ma jo-higni piero adek kata moloyo kanyo nokwan, ne gin ji alufu piero adek gaboro. <verse eid="1CH 23:3"/><verse number="4" style="v" sid="1CH 23:4"/>Daudi nowacho niya, “Ji alufu piero ariyo gangʼwen kuomgi noket jorit tich e hekalu mar Jehova Nyasaye, to ji alufu auchiel kuomgi to noket jotelo kod jongʼad bura. <verse eid="1CH 23:4"/><verse number="5" style="v" sid="1CH 23:5"/>Ji alufu angʼwen, to noket jorit rangeye, kendo ji alufu angʼwen mamoko, to noket jopak Jehova Nyasaye gi thumbe ma asechiwo nikech tijni.”<verse eid="1CH 23:5"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="6" style="v" sid="1CH 23:6"/>Daudi nopogo jo-Lawi e migepe kaluwore gi yawuot Lawi ma gin Gershon, Kohath kod Merari.<verse eid="1CH 23:6"/></para>
  <para style="s1">Joka Gershom</para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 23:7"/>Koa kuom joka Gershon, ne gin:</para>
  <para style="li2" vid="1CH 23:7">Ladan kod Shimei.<verse eid="1CH 23:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8"/>Yawuot Ladan ne gin:</para>
  <para style="li2" vid="1CH 23:8">Jehiel wuode makayo, kiluwe gi Zetham kod Joel, giduto ne gin ji adek.<verse eid="1CH 23:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9"/>Yawuot Shimei ne gin:</para>
  <para style="li2" vid="1CH 23:9">Shelomoth, Haziel kod Haran, giduto ne gin ji adek.</para>
  <para style="li2" vid="1CH 23:9">Magi ema ne jotend anywola mar Ladan.<verse eid="1CH 23:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10"/>To yawuot Shimei ne gin:</para>
  <para style="li2" vid="1CH 23:10">Jahath, Ziza, Jeush kod Beria.</para>
  <para style="li2" vid="1CH 23:10">Magi ema ne yawuot Shimei, giduto ne gin ji angʼwen.<verse eid="1CH 23:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11"/>Jahath ema ne kayo, Ziza ne luwe, to Jeush kod Beria nokwan kaka dhoot achiel moriwgi e tich achiel nikech yawuotgi ne nok.<verse eid="1CH 23:11"/></para>
  <para style="s1">Joka Kohath</para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 23:12"/>Yawuot Kohath ne gin:</para>
  <para style="li2" vid="1CH 23:12">Amram, Izhar, Hebron kod Uziel, giduto ne gin ji angʼwen.<verse eid="1CH 23:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13"/>Yawuot Amram ne gin:</para>
  <para style="li2" vid="1CH 23:13">Harun kod Musa.</para>
  <para style="li2" vid="1CH 23:13">Harun gi nyikwaye to nowal nyaka chiengʼ mondo opwodh gik maler moloyo, kendo ochiw misango e nyim Jehova Nyasaye kendo mondo gitine kendo gigwedh ji e nyinge nyaka chiengʼ. <verse eid="1CH 23:13"/><verse number="14" style="v" sid="1CH 23:14"/>Yawuot Musa, ngʼat Nyasaye, to nokwan kaka achiel kuom dhood jo-Lawi.<verse eid="1CH 23:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15"/>Yawuot Musa ne gin:</para>
  <para style="li2" vid="1CH 23:15">Gershom kod Eliezer.<verse eid="1CH 23:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16"/>Nyikwa Gershom ne gin:</para>
  <para style="li2" vid="1CH 23:16">Shubael mane wuowi makayo.<verse eid="1CH 23:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17"/>Nyikwa Eliezer ne gin:</para>
  <para style="li2" vid="1CH 23:17">Rehabia mane wuowi makayo.</para>
  <para style="li2" vid="1CH 23:17">Eliezer ne onge gi yawuowi mamoko, to yawuot Rehabia ne ngʼeny moloyo.<verse eid="1CH 23:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18"/>Yawuot Izhar ne gin:</para>
  <para style="li2" vid="1CH 23:18">Shelomith mane wuowi makayo.<verse eid="1CH 23:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19"/>Yawuot Hebron ne gin:</para>
  <para style="li2" vid="1CH 23:19">Jeria mane wuowi makayo, Amaria mar ariyo,</para>
  <para style="li2" vid="1CH 23:19">Jahaziel mar adek gi Jekameam mar angʼwen.<verse eid="1CH 23:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20"/>Yawuot Uziel ne gin:</para>
  <para style="li2" vid="1CH 23:20">Mika mane wuowi makayo kod Ishia wuowi mar ariyo.<verse eid="1CH 23:20"/></para>
  <para style="s1">Joka Merari</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 23:21"/>Yawuot Merari ne gin:</para>
  <para style="li2" vid="1CH 23:21">Mali kod Mushi.</para>
  <para style="li1" vid="1CH 23:21">Yawuot Mali ne gin:</para>
  <para style="li2" vid="1CH 23:21">Eliazar kod Kish.<verse eid="1CH 23:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22"/>Eliazar notho kapok onywolo yawuowi, ne en mana gi nyiri kende. Owetegi ma yawuot Kish nokendogi.<verse eid="1CH 23:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23"/>Yawuot Mushi ne gin:</para>
  <para style="li2" vid="1CH 23:23">Mali, Eder kod Jerimoth, giduto ne gin ji adek.<verse eid="1CH 23:23"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="24" style="v" sid="1CH 23:24"/>Magi ema ne nyikwa Lawi kochan-gi kaluwore gi anywolagi mane gin jotelo mag anywola mana kaka nondik nying-gi kendo kokwan-gi ngʼato ka ngʼato, mane gin jotich mahikgi piero ariyo kata moloyo kanyo mane tiyo e hekalu mar Jehova Nyasaye. <verse eid="1CH 23:24"/><verse number="25" style="v" sid="1CH 23:25"/>Nimar Daudi nosewacho niya, “Nikech Jehova Nyasaye ma Nyasach Israel osemiyo joge yweyo kendo osebiro mondo odag Jerusalem nyaka chiengʼ, <verse eid="1CH 23:25"/><verse number="26" style="v" sid="1CH 23:26"/>onge tiende mondo jo-Lawi osik katingʼo Hemb Romo kata gige lemo mitiyogo e iye.” <verse eid="1CH 23:26"/><verse number="27" style="v" sid="1CH 23:27"/>Kaluwore gi chike mogik mar Daudi, jo-Lawi nokwan kochakore jo-higni piero ariyo kata moloyo kanyo.<verse eid="1CH 23:27"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28"/>Tij jo-Lawi ne en konyo nyikwa Harun tiyo e hekalu mar Jehova Nyasaye. Negirito laru, agulni mag od Nyasaye, luoko gik moko duto mopwodhi to gi timo tije mamoko e od Nyasaye. <verse eid="1CH 23:28"/><verse number="29" style="v" sid="1CH 23:29"/>Gin ema ne gitedo makati mane iketo e mesa, mogo mar chiwo mar cham, makati ma ok oketie thowi, losogi kendo pimogi, bende rito gik moko duto mane ipimogo ngʼeny kod pek gik moko. <verse eid="1CH 23:29"/><verse number="30" style="v" sid="1CH 23:30"/>Bende negichungʼ pile ka pile mondo gidwok erokamano kendo gipak Jehova Nyasaye. Nonego gitim kamano godhiambo bende, <verse eid="1CH 23:30"/><verse number="31" style="v" sid="1CH 23:31"/>kendo e kinde ka kinde manochiw misengini miwangʼo pep ne Jehova Nyasaye e odiechienge mag Sabato, kendo e Sawo mar Dwe manyien kendo e kinde mag sewni moyier. Nonego giti e nyim Jehova Nyasaye kinde ka kinde kaluwore gi kwan-gi kod yo mowinjore mane ochan-negi.<verse eid="1CH 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32"/>Kendo jo-Lawi notiyo tijegi mag Hemb Romo gi Kama Ler kotelnegi gi jowetegi ma gin nyikwa Harun mondo giti e hekalu mar Jehova Nyasaye.<verse eid="1CH 23:32"/></para>
  <chapter eid="1CH 23"/>
  <chapter number="24" style="c" sid="1CH 24"/>
  <para style="s1">Migepe mag jodolo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1"/>Magi e migepe mag yawuot Harun.</para>
  <para style="p" vid="1CH 24:1">Yawuot Harun ne gin: Nadab, Abihu, Eliazar kod Ithamar. <verse eid="1CH 24:1"/><verse number="2" style="v" sid="1CH 24:2"/>To Nadab kod Abihu notho motelone wuon-gi kendo ne gionge gi yawuowi; omiyo Eliazar kod Ithamar ema ne otiyo kaka jodolo. <verse eid="1CH 24:2"/><verse number="3" style="v" sid="1CH 24:3"/>Daudi nopogogi e migepe kaluwore kaka nopognigi tich kikonye gi Zadok ma nyakwar Eliazar kod Ahimelek ma nyakwar Ithamar. <verse eid="1CH 24:3"/><verse number="4" style="v" sid="1CH 24:4"/>Jotelo mangʼeny nonwangʼ e nyikwa Eliazar moloyo nyikwa Ithamar kendo nopog-gi kaluwore gi tichgi. Jotend anywola apar gauchiel nowuok kuom nyikwa, Eliazar to gi jotend anywola aboro nowuok kuom nyikwa Ithamar. <verse eid="1CH 24:4"/><verse number="5" style="v" sid="1CH 24:5"/>Negipogogi maonge dewo wangʼ ka gigoyo ombulu nikech ne nitie jotelo mag kama ler mar lemo, to gi mag Nyasaye e kind nyikwa Eliazar kod Ithamar.<verse eid="1CH 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6"/>Jagoro Shemaya wuod Nethanel ma ja-Lawi nondiko nying-gi e nyim ruoth, to gi jotelo, ne gin Zadok jadolo, Ahimelek wuod Abiathar kod jotend anywola mag jodolo kod mag jo-Lawi ka gikawo ngʼato achiel koa e anywola mar Eliazar, to machielo koa e anywola mar Ithamar.<verse eid="1CH 24:6"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7"/>Ombulu mokwongo nolwar ne Jehoyarib,</para>
  <para style="li1" vid="1CH 24:7">to mar ariyo ne Jedaya,<verse eid="1CH 24:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8"/>mar adek ne Harim,</para>
  <para style="li1" vid="1CH 24:8">to mar angʼwen ne Seorim,<verse eid="1CH 24:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9"/>mar abich ne Malkija,</para>
  <para style="li1" vid="1CH 24:9">to mar auchiel ne Mijamin,<verse eid="1CH 24:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10"/>mar abiriyo ne Hakoz,</para>
  <para style="li1" vid="1CH 24:10">to mar aboro ne Abija,<verse eid="1CH 24:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11"/>mar ochiko ne Jeshua,</para>
  <para style="li1" vid="1CH 24:11">to mar apar ne Shekania,<verse eid="1CH 24:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12"/>mar apar gachiel ne Eliashib,</para>
  <para style="li1" vid="1CH 24:12">to mar apar gariyo ne Jakim,<verse eid="1CH 24:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13"/>mar apar gadek ne Hupa,</para>
  <para style="li1" vid="1CH 24:13">to mar apar gangʼwen ne Jeshebeab,<verse eid="1CH 24:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14"/>mar apar gabich ne Bilga,</para>
  <para style="li1" vid="1CH 24:14">to mar apar gauchiel ne Imer,<verse eid="1CH 24:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15"/>mar apar gabiriyo ne Hezir,</para>
  <para style="li1" vid="1CH 24:15">to mar apar gaboro ne Hapizez,<verse eid="1CH 24:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16"/>mar apar gochiko ne Pethahia,</para>
  <para style="li1" vid="1CH 24:16">to mar piero ariyo ne Jehezkel,<verse eid="1CH 24:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17"/>mar piero ariyo gachiel ne Jakin,</para>
  <para style="li1" vid="1CH 24:17">to mar piero ariyo gariyo ne Gamul,<verse eid="1CH 24:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18"/>mar piero ariyo gadek ne Delaya</para>
  <para style="li1" vid="1CH 24:18">to mar piero ariyo gangʼwen ne Mazia.<verse eid="1CH 24:18"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19"/>Ma e kaka nochan-gi mondo giti kane gidonjo e hekalu mar Jehova Nyasaye kaluwore gi chike mane Jehova Nyasaye ma Nyasach Israel nochiko Harun kwargi.<verse eid="1CH 24:19"/></para>
  <para style="s1">Joka Lawi mamoko</para>
  <para style="li4">
    <verse number="20" style="v" sid="1CH 24:20"/>Nyikwa Lawi mamoko e magi:</para>
  <para style="b" vid="1CH 24:20"/>
  <para style="li1" vid="1CH 24:20">Koa kuom yawuot Amram noyier Shubael;</para>
  <para style="li2" vid="1CH 24:20">koa kuom yawuot Shubael noyier Jedeya.<verse eid="1CH 24:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 24:21"/>Koa kuom yawuot Rehabia noyier Ishia mokwongo.<verse eid="1CH 24:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22"/>Koa kuom Izhar noyier Shelomoth;</para>
  <para style="li2" vid="1CH 24:22">koa kuom yawuot Shelomoth noyier Jahath.<verse eid="1CH 24:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23"/>Yawuot Hebron mane oyier ne gin:</para>
  <para style="li2" vid="1CH 24:23">Jeria mokwongo, mar ariyo Amaria, mar adek Jahaziel kod mar angʼwen Jekameam.<verse eid="1CH 24:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24"/>Wuod Uziel mane oyier ne en, Mika,</para>
  <para style="li2" vid="1CH 24:24">to kuom yawuot Mika noyier Shamir.<verse eid="1CH 24:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 24:25"/>Owadgi Mika mane oyier ne en Ishia,</para>
  <para style="li2" vid="1CH 24:25">to kuom yawuot Ishia noyier Zekaria.<verse eid="1CH 24:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26"/>Yawuot Merari mane oyier ne gin: Mali kod Mushi.</para>
  <para style="li2" vid="1CH 24:26">To kuom yawuot Jazia noyier Beno.<verse eid="1CH 24:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27"/>Kuom yawuot Merari:</para>
  <para style="li2" vid="1CH 24:27">noyier Jazia: to kuom yawuot Jazia noyier Beno, Shoham, Zakur kod Ibri.<verse eid="1CH 24:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28"/>Koa kuom Mali noyier Eliazar mane ok onywolo yawuowi.<verse eid="1CH 24:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29"/>Koa kuom Kish, noyier wuod Kish miluongo ni Jeramel.<verse eid="1CH 24:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30"/>Koa kuom yawuot Mushi noyier Mali, Eder kod Jerimoth.</para>
  <para style="b" vid="1CH 24:30"/>
  <para style="li4" vid="1CH 24:30">Magi e jo-Lawi mane oyier kaluwore gi anywolagi.<verse eid="1CH 24:30"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31"/>Gin bende negigoyo ombulu mana kaka jowetegi ma nyikwa Harun notimo e nyim Ruoth Daudi kod Zadok, Ahimelek kaachiel gi jotelo mag anywola mag jodolo kod jo-Lawi. Jomadongo notimnegi mana machalre gi jomatindo.<verse eid="1CH 24:31"/></para>
  <chapter eid="1CH 24"/>
  <chapter number="25" style="c" sid="1CH 25"/>
  <para style="s1">Jower</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1"/>Daudi kaachiel gi jotend jolweny noyiero yawuot Asaf mamoko gi yawuot Heman gi yawuot Jeduthun ne tich koro wach ka gigoyo nyatiti, gi orutu kod ongengʼo. Ma e chenro mar jogo kaka negitiyo:<verse eid="1CH 25:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2"/>Koa kuom yawuot Asaf noyier:</para>
  <para style="li2" vid="1CH 25:2">Zakur, Josef, Nethania kod Asarela. Yawuot Asaf notelnigi gi Asaf mane jakor wach ni ruoth.<verse eid="1CH 25:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3"/>Koa kuom yawuot Jeduthun noyier:</para>
  <para style="li2" vid="1CH 25:3">Gedalia gi Zeri gi Jeshaya gi Shimei gi Hashabia kod Matithia. Giduto ne gin ji auchiel kendo notelnegi kod wuon-gi Jeduthun mane koro ka goyone Jehova Nyasaye erokamano kendo pake gi nyatiti.<verse eid="1CH 25:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4"/>Koa kuom yawuot Heman noyier:</para>
  <para style="li2" vid="1CH 25:4">Bukia, Matania, Uziel, Shubael kod Jerimoth, bende noyier Hanania, Hanani, Eliatha, Gidalti kod Romamti-Ezer, bangʼe noyier Joshbekasha, Malothi, Hothir, kod Mahazioth. <verse eid="1CH 25:4"/><verse number="5" style="v" sid="1CH 25:5"/>Magi duto ne gin yawuot Heman jakor wach ne ruoth mane Nyasaye omiye kaluwore gi singruok ni nobiro tingʼe malo. Nyasaye nomiyo Heman yawuowi apar gangʼwen kod nyiri adek.<verse eid="1CH 25:5"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6"/>Jogi duto notelnegi gi wuonegi e tijgi mar goyo thum e hekalu mar Jehova Nyasaye, ka gitiyo e od Nyasaye kuom goyo ongengʼo, orutu kod nyatiti.</para>
  <para style="p" vid="1CH 25:6">Asaf, Jeduthun, kod Heman to notelonegi kod ruoth. <verse eid="1CH 25:6"/><verse number="7" style="v" sid="1CH 25:7"/>Jogo duto kaachiel gi wedegi ne nigi tiegruok kod lony kuom goyo thum ne Jehova Nyasaye, giduto ne gin ji mia ariyo gi piero aboro gaboro. <verse eid="1CH 25:7"/><verse number="8" style="v" sid="1CH 25:8"/>Negipogo tijgi ka gigoyo ombulu, jomatindo gi jomadongo, jopuonj gi joma ipuonjo machalre.<verse eid="1CH 25:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 25:9"/>Pok mokwongo mar Asaf nodhine Josef gi yawuote kod wedene, giduto ji apar gariyo,</para>
  <para style="li1" vid="1CH 25:9">Pok mar ariyo ne mar Gedalia gi wedene kod yawuote, giduto ji apar gariyo,<verse eid="1CH 25:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 25:10"/>Pok mar adek ne mar Zakur gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 25:11"/>Pok mar angʼwen ne mar Izri gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 25:12"/>Pok mar abich ne mar Nethania gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 25:13"/>Pok mar auchiel ne mar Bukia gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 25:14"/>Pok mar abiriyo ne mar Jesarela gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 25:15"/>Pok mar aboro ne mar Jeshaya gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 25:16"/>Pok mar ochiko ne mar Matania gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 25:17"/>Pok mar apar ne mar Shimei gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 25:18"/>Pok mar apar gachiel ne mar Azarel gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 25:19"/>Pok mar apar gariyo ne mar Hashabia gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 25:20"/>Pok mar apar gadek ne mar Shubael gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 25:21"/>Pok mar apar gangʼwen ne mar Matithia gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 25:22"/>Pok mar apar gabich ne mar Jerimoth gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 25:23"/>Pok mar apar gauchiel, Hanania gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 25:24"/>Pok mar apar gabiriyo ne mar Joshbekasha gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 25:25"/>Pok mar apar gaboro ne mar Hanani gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 25:26"/>Pok mar apar gochiko ne mar Malothi gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 25:27"/>Pok mar piero ariyo ne mar Eliatha gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 25:28"/>Pok mar piero ariyo gachiel ne mar Hothir gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 25:29"/>Pok mar piero gariyo ne mar Gidalti gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 25:30"/>Pok mar piero ariyo gadek ne mar Mahazioth gi yawuote kod wedene, giduto ji apar gariyo,<verse eid="1CH 25:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 25:31"/>Pok mar piero gangʼwen ne mar Romamti-Ezer gi yawuote kod wedene, giduto ji apar gariyo.<verse eid="1CH 25:31"/></para>
  <chapter eid="1CH 25"/>
  <chapter number="26" style="c" sid="1CH 26"/>
  <para style="s1">Jorit rangeye</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 26:1"/>Magi e migepe mag jorit rangeye:</para>
  <para style="b" vid="1CH 26:1"/>
  <para style="li4" vid="1CH 26:1">Koa kuom joka Kora,</para>
  <para style="li1" vid="1CH 26:1">noyier Meshelemia wuod Kore, ma en achiel kuom yawuot Asaf. <verse eid="1CH 26:1"/><verse number="2" style="v" sid="1CH 26:2"/>Meshelemia ne nigi yawuowi,</para>
  <para style="li2" vid="1CH 26:2">wuowi makayo ne en Zekaria, mar ariyo ne en Jediael,</para>
  <para style="li2" vid="1CH 26:2">mar adek ne en Zebadia, mar angʼwen ne en Jathniel,<verse eid="1CH 26:2"/></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 26:3"/>mar abich ne en Elam, mar auchiel ne en Jehohanan,</para>
  <para style="li2" vid="1CH 26:3">to mar abiriyo ne en Eliehoenai.<verse eid="1CH 26:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4"/>Obed-Edom bende Nyasaye nogwedho gi yawuowi,</para>
  <para style="li2" vid="1CH 26:4">wuowi makayo ne en Shemaya, mar ariyo ne en Jehozabad,</para>
  <para style="li2" vid="1CH 26:4">mar adek ne en Joa, mar angʼwen ne en Sakar,</para>
  <para style="li2" vid="1CH 26:4">mar abich ne en Nethanel, <verse eid="1CH 26:4"/><verse number="5" style="v" sid="1CH 26:5"/>mar auchiel ne en Amiel,</para>
  <para style="li2" vid="1CH 26:5">mar abiriyo ne en Isakar, to mar aboro ne en Peulethai.</para>
  <para style="li2" vid="1CH 26:5">Nimar Nyasaye nosegwedho Obed-Edom.<verse eid="1CH 26:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6"/>Wuode ma Shemaya bende nonywolo yawuowi mane gin jotend dhood wuon-gi nikech ne gin joma olony. <verse eid="1CH 26:6"/><verse number="7" style="v" sid="1CH 26:7"/>Yawuot Shemaya ne gin,</para>
  <para style="li2" vid="1CH 26:7">Othni, Refael, Obed kod Elzabad;</para>
  <para style="li2" vid="1CH 26:7">Elihu kod Semakia ma wedene bende ne joma niginyalo.<verse eid="1CH 26:7"/></para>
  <para style="li4">
    <verse number="8" style="v" sid="1CH 26:8"/>Magi duto ne gin nyikwa Obed-Edom. Gin kaachiel gi yawuotgi to gi wedegi ne gin joma niginyalo kendo maroteke kuom tich. Koriw nyikwa Obed-Edom duto to ne gin ji piero auchiel gariyo.<verse eid="1CH 26:8"/></para>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 26:9"/>Meshelemia ne nigi yawuowi kod wedene, giduto ne gin ji apar gaboro man-gi nyalo.<verse eid="1CH 26:9"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 26:10"/>Hosa ja-Merari ne nigi yawuowi,</para>
  <para style="li2" vid="1CH 26:10">mokwongo Shimri (kata obedo ni ne ok en wuode makayo, wuon-gi noyiere mokwongo),<verse eid="1CH 26:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 26:11"/>mar ariyo ne en Hilkia, mar adek ne en Tabalia,</para>
  <para style="li2" vid="1CH 26:11">to mar angʼwen ne en Zekaria.</para>
  <para style="li4" vid="1CH 26:11">Yawuot Hosa kod wedene giduto ne gin ji apar gadek.<verse eid="1CH 26:11"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="12" style="v" sid="1CH 26:12"/>Migepegi mag jorit rangeye kokadho kuom jotendgi madongo ne nigi pok mar tiyo ei hekalu mar Jehova Nyasaye mana kaka wedegi bende notimo. <verse eid="1CH 26:12"/><verse number="13" style="v" sid="1CH 26:13"/>Nogo ombulu kaluwore gi anywolagi, jomatindo gi jomadongo machalre mondo oyud jorit rangeye.<verse eid="1CH 26:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 26:14"/>Ombulu mar Rangach ma yo Wuok Chiengʼ nolwar ne Shelemia.</para>
  <para style="li1" vid="1CH 26:14">Nogo ombulu ne wuode Zekaria, ma jangʼad bura mariek kendo noyudo Rangach ma yo Nyandwat.<verse eid="1CH 26:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 26:15"/>Ombulu mar Rangach ma yo Milambo nolwar ne Obed-Edom, to ombulu mar od keno nolwar ne yawuote.<verse eid="1CH 26:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 26:16"/>Ombulu mar Rangach ma yo Podho Chiengʼ to gi rangach miluongo ni Shaleketh man e yo mamalo nolwar ne Shupim kod Hosa.</para>
  <para style="b" vid="1CH 26:16"/>
  <para style="li4" vid="1CH 26:16">Arita duto noket machalre.<verse eid="1CH 26:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 26:17"/>Pile ka pile ne nitiere jo-Lawi auchiel marito rangach ma yo wuok chiengʼ,</para>
  <para style="li1" vid="1CH 26:17">angʼwen e rangach ma yo nyandwat,</para>
  <para style="li1" vid="1CH 26:17">angʼwen rangach ma yo milambo,</para>
  <para style="li1" vid="1CH 26:17">to gi ariyo ariyo mane rito od keno.<verse eid="1CH 26:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 26:18"/>Kuom laru mantie yo podho chiengʼ, angʼwen ne rito yo michopogo e laru to ariyo ne rito laruno.<verse eid="1CH 26:18"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="19" style="v" sid="1CH 26:19"/>Magi e migepe mag jorit rangeye mane gin nyikwa Kora kod Merari.<verse eid="1CH 26:19"/></para>
  <para style="s1">Jokeno kod jotelo mamoko</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20"/>To jowetegi moko ma jo-Lawi, kotelnegi gi Ahija, ne gin jorit kuonde keno mag od Nyasaye kod kuonde mikanoe gik mowal.<verse eid="1CH 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21"/>Nyikwa Ladan mane gin joka Gershon ma anywola mar Ladan kendo mane jotelo mag dhout Ladan ja-Gershon ne gin Jehiel, <verse eid="1CH 26:21"/><verse number="22" style="v" sid="1CH 26:22"/>yawuot Jehiel ne gin Zetham gi owadgi ma Joel. Gin ema ne gichungʼne keno mar hekalu mar Jehova Nyasaye.<verse eid="1CH 26:22"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="23" style="v" sid="1CH 26:23"/>Koa kuom jo-Amram, gi joka Izhar gi joka Hebron kod joka Uziel noyier,<verse eid="1CH 26:23"/></para>
  <para style="b"/>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 26:24"/>Shubael ma nyakwar Gershom wuod Musa mane jatelo manorito kuonde keno. <verse eid="1CH 26:24"/><verse number="25" style="v" sid="1CH 26:25"/>To wedene ma joka Eliezer noyier yawuote ma gin Rehabia, Jeshaya, Joram, Zikri kod Shelomith.<verse eid="1CH 26:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 26:26"/>Shelomith gi wedene to nochungʼne keno duto mag gik mane Ruoth Daudi owalo gi jotend dhoudi mane gin jotend jolweny alufe kod jotend jolweny miche to gi jotend jolweny mamoko. <verse eid="1CH 26:26"/><verse number="27" style="v" sid="1CH 26:27"/>Moko kuom gik mane ope e lweny nowal ne tij loso hekalu mar Jehova Nyasaye. <verse eid="1CH 26:27"/><verse number="28" style="v" sid="1CH 26:28"/>Bende gik moko duto manowal gi Samuel janen kod Saulo wuod Kish, Abner wuod Ner kod Joab wuod Zeruya kaachiel gi gik mamoko duto manowal norit gi Shelomith kod wedene.<verse eid="1CH 26:28"/></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 26:29"/>Kuom joka Izhar</para>
  <para style="li2" vid="1CH 26:29">noyier Kenania kod yawuote manomi tije oko mar hekalu kaka jotelo kendo jongʼad bura e piny Israel.<verse eid="1CH 26:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 26:30"/>Kuom joka Hebron</para>
  <para style="li2" vid="1CH 26:30">noyier Hashabia kod wedene. Ne gin ji alufu achiel mia abiriyo motegno, mane rito jo-Israel modak yo podho chiengʼ mar Jordan ka girito tije duto mag Jehova Nyasaye kendo ka gitiyone ruoth. <verse eid="1CH 26:30"/><verse number="31" style="v" sid="1CH 26:31"/>Kuom joka Hebron, Jeria ema ne jatendgi kaluwore gi nonro mar anywolagi.</para>
  <para style="li2" vid="1CH 26:31">E higa mar piero angʼwen mar loch Daudi nonon ndiko kendo noyud ni joma olony kuom nyikwa Hebron ne oa Jazer e piny Gilead. <verse eid="1CH 26:31"/><verse number="32" style="v" sid="1CH 26:32"/>Jeria ne nigi wedene alufu ariyo mia abiriyo mane gin joma olony kendo jotend anywola, omiyo Ruoth Daudi noketogi jotend jo-Reuben, jo-Gad kod nus dhood jo-Manase e yore duto mag tich Nyasaye to gi tije mag ruoth.<verse eid="1CH 26:32"/></para>
  <chapter eid="1CH 26"/>
  <chapter number="27" style="c" sid="1CH 27"/>
  <para style="s1">Migepe mag jolweny</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 27:1"/>Ma e chenro mar nying jo-Israel ma jotend anywola, jotend jolweny alufe kod jolweny miche to gi jotendgi; mane tiyone ruoth kaluwore kod tije duto mag migepe mag jolweny mane ni e tich dwe ka dwe kuom higa ngima. Migawo ka migawo notingʼo ji alufu piero ariyo gangʼwen (24,000).<verse eid="1CH 27:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2"/>Jatend migawo mokwongo mane tiyo e dwe mokwongo ne en Jashobeam wuod Zabdiel. Ne nitiere ji alufu piero ariyo gangʼwen (24,000) e migape. <verse eid="1CH 27:2"/><verse number="3" style="v" sid="1CH 27:3"/>Ne en nyakwar Perez kendo en ema ne en jatelo maduongʼ motelone jotend lweny mag dwe mokwongo.<verse eid="1CH 27:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4"/>Jatelo e migawo mar dwe mar ariyo ne en Dodai ja-Ahohi, Mikloth ne jatend migape. Ne nitiere ji alufu piero ariyo gangʼwen (24,000) e migape.<verse eid="1CH 27:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5"/>Jatend jolweny mar adek, e dwe mar adek ne en Benaya wuod Jehoyada ma jadolo. Ne en jatelo maduongʼ kendo notelo ne jolweny alufu piero ariyo gangʼwen (24,000) e migape. <verse eid="1CH 27:5"/><verse number="6" style="v" sid="1CH 27:6"/>Ma e Benaya mane achiel kuom thuondi piero adek madongo kendo en ema notelonegi. Wuode miluongo ni Amizabad notelo ne migape.<verse eid="1CH 27:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7"/>Jatelo mar angʼwen, e dwe mar angʼwen ne en Asahel owadgi Joab. Bangʼe Zebadia wuode nokawo kare. Ne nitiere ji alufu piero ariyo gangʼwen (24,000) e migape.<verse eid="1CH 27:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8"/>Jatelo mar abich e dwe mar abich ne en Shamhuth ma ja-Izra. Ne nitiere ji alufu piero ariyo gangʼwen (24,000) e migape.<verse eid="1CH 27:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9"/>Jatelo mar auchiel, e dwe mar auchiel ne en Ira wuod Ikesh ja-Tekoi. Ne nitiere ji alufu piero ariyo gangʼwen (24,000) e migape.<verse eid="1CH 27:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10"/>Jatelo mar abiriyo, e dwe mar abiriyo ne en Helez ja-Pelon ma ja-Efraim. Ne nitiere ji alufu piero ariyo gangʼwen (24,000) e migape.<verse eid="1CH 27:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11"/>Jatelo mar aboro, e dwe mar aboro ne en Sibekai ja-Hushath ma ja-Zera. Ne nitiere ji alufu piero ariyo gangʼwen (24,000) e migape.<verse eid="1CH 27:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12"/>Jatelo mar ochiko, e dwe mar ochiko ne en Abiezer ja-Anathoth ma ja-Benjamin. Ne nitiere ji alufu piero ariyo gangʼwen (24,000) e migape.<verse eid="1CH 27:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13"/>Jatelo mar apar, e dwe mar apar ne en Maharai ja-Netofath ma ja-Zera. Ne nitiere ji alufu piero ariyo gangʼwen (24,000) e migape.<verse eid="1CH 27:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 27:14"/>Jatelo mar apar gachiel, e dwe mar apar gachiel ne en Benaya ja-Pirathon ma ja-Efraim. Ne nitiere ji alufu piero ariyo gangʼwen (24,000) e migape.<verse eid="1CH 27:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15"/>Jatelo mar apar gariyo, e dwe mar apar gariyo ne en Heldai ja-Netofath koa e anywola mar Othniel. Ne nitiere ji alufu piero ariyo gangʼwen (24,000) e migape.<verse eid="1CH 27:15"/></para>
  <para style="s1">Jotend dhoudi</para>
  <para style="li4">
    <verse number="16" style="v" sid="1CH 27:16"/>Jotend dhout Israel ne gin:</para>
  <para style="b" vid="1CH 27:16"/>
  <para style="li1" vid="1CH 27:16">koa kuom jo-Reuben: Eliezer wuod Zikri notelonegi,</para>
  <para style="li1" vid="1CH 27:16">koa kuom jo-Simeon: Shefatia wuod Maaka notelonegi;<verse eid="1CH 27:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17"/>koa kuom jo-Lawi notelnigi gi Hashabia wuod Kemuel;</para>
  <para style="li1" vid="1CH 27:17">koa kuom joka Harun: Zadok notelonegi;<verse eid="1CH 27:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18"/>koa kuom jo-Juda: Elihu owadgi Daudi notelonegi;</para>
  <para style="li1" vid="1CH 27:18">koa kuom jo-Isakar: Omri wuod Mikael notelonegi;<verse eid="1CH 27:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19"/>koa kuom jo-Zebulun: Ishmaya wuod Obadia notelonegi;</para>
  <para style="li1" vid="1CH 27:19">koa kuom jo-Naftali: Jerimoth wuod Azriel notelonegi;<verse eid="1CH 27:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20"/>koa kuom jo-Efraim: Hoshea wuod Azazia notelonegi;</para>
  <para style="li1" vid="1CH 27:20">koa kuom nus mar dhood jo-Manase: Joel wuod Pedaya notelonegi;<verse eid="1CH 27:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21"/>koa kuom nus machielo mar jo-Manase mane ni e piny Gilead: Ido wuod Zekaria notelonegi;</para>
  <para style="li1" vid="1CH 27:21">koa kuom jo-Benjamin: Jasiel wuod Abner notelonegi;<verse eid="1CH 27:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22"/>koa kuom jo-Dan: Azarel wuod Jeroham notelonegi.</para>
  <para style="b" vid="1CH 27:22"/>
  <para style="li4" vid="1CH 27:22">Magi ema ne jotelo mane otelo ne dhout Israel.<verse eid="1CH 27:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23"/>Daudi ne ok okawo kwan ji ma jo-higni piero ariyo, kata matin ne mano nikech Jehova Nyasaye ne osesingore ni nomi jo-Israel bed mangʼeny mana ka sulwe manie kor polo. <verse eid="1CH 27:23"/><verse number="24" style="v" sid="1CH 27:24"/>Joab wuod Zeruya nochako kwano ji, to ne ok otieko. Kwenono nokelo mirimb Nyasaye kuom jo-Israel, omiyo ne ok ondik kwenono e kitap Weche mag Ndalo mag loch Ruoth Daudi.<verse eid="1CH 27:24"/></para>
  <para style="s1">Jodong ruoth</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 27:25"/>Azmaveth wuod Adiel ne jarit kuonde keno mar ruoth.</para>
  <para style="li1" vid="1CH 27:25">Jonathan wuod Uzia ne rito kuonde mag keno mag gwenge molwore, e mier madongo kod matindo, kendo e miech lweny mochiel gi ohinga.<verse eid="1CH 27:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 27:26"/>Ezri wuod Kelub ne rito jotich mane tiyo e puodho.<verse eid="1CH 27:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 27:27"/>Shimei ja-Rama to ne orito puothe mzabibu.</para>
  <para style="li1" vid="1CH 27:27">Zabdi ja-Shifmi to norito olemb mzabibu e kar loso divai.<verse eid="1CH 27:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 27:28"/>Baal-Hanan ja-Geder to norito yiend zeituni gi yiende ngʼowu mane ni e bwo gode e yo podho chiengʼ,</para>
  <para style="li1" vid="1CH 27:28">Joash nochungʼne kano mo zeituni.<verse eid="1CH 27:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 27:29"/>Shitrai ja-Sharon nochungʼne kweth mag dhok makwayo Sharon.</para>
  <para style="li1" vid="1CH 27:29">Shafat wuod Aldai to ne ochungʼ ne kweth dhok manie holo.<verse eid="1CH 27:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 27:30"/>Obil ja-Ishmael to nochungʼne ngamia,</para>
  <para style="li1" vid="1CH 27:30">Jedeya ma ja-Meronoth to nochungʼne punde.<verse eid="1CH 27:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 27:31"/>Jaziz ja-Hagri nochungʼne kweth rombe.</para>
  <para style="li4" vid="1CH 27:31">Magi duto ne jotelo mane orito mwandu mag Ruoth Daudi.<verse eid="1CH 27:31"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 27:32"/>Jonathan, owadgi wuon Daudi ne en jangʼad rieko, ngʼat man-gi paro matut, kendo jagoro.</para>
  <para style="li1" vid="1CH 27:32">Jehiel wuod Hakmon norito yawuot ruoth.<verse eid="1CH 27:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 27:33"/>Ahithofel ne en jangʼad rieko ne ruoth.</para>
  <para style="li1" vid="1CH 27:33">Hushai ja-Arki to ne en osiep ruoth.<verse eid="1CH 27:33"/></para>
  <para style="li4">
    <verse number="34" style="v" sid="1CH 27:34"/>(Jehoyada wuod Benaya kod Abiathar nokawo kar Ahithofel.)</para>
  <para style="li1" vid="1CH 27:34">Joab to ne jatend jolweny.<verse eid="1CH 27:34"/></para>
  <chapter eid="1CH 27"/>
  <chapter number="28" style="c" sid="1CH 28"/>
  <para style="s1">Daudi ochano gero hekalu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1"/>Daudi noluongo jotend Israel duto mondo ochokre Jerusalem. Noluongo jotend dhoudi gi jotend migepe mag jotich ruoth, jotelo morito migepe mag jolweny alufe gi migepe mag jolweny miche, to gi jotelo morito mwandu duto kod jamni mag ruoth gi mag yawuote kaachiel gi jotelo matiyo e dala ruoth, joma roteke to gi jolweny mathuondi.<verse eid="1CH 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2"/>Eka Ruoth Daudi nochungo kar tiende mowacho niya, “Winjauru jowetena kendo jothurwa. Ne achano e chunya mondo ager ot kaka kar yweyo mar Sandug Singruok mar Jehova Nyasaye mondo obed raten mar tiend Nyasachwa kendo ne an gi chenro mar gere. <verse eid="1CH 28:2"/><verse number="3" style="v" sid="1CH 28:3"/>To Nyasaye nowachona ni, ‘Ok iniger ot miluonge Nyinga nikech in jalweny kendo isechwero remo.’<verse eid="1CH 28:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4"/>“Kata kamano Jehova Nyasaye ma Nyasach Israel noyiera kuom anywolana mondo abed ruodh Israel manyaka chiengʼ. Noyiero Juda jatelo, to koa e dhood Juda noyiero anywolana, to kuom yawuot wuora duto, notimo ngʼwono mondo oketa ruodh Israel duto. <verse eid="1CH 28:4"/><verse number="5" style="v" sid="1CH 28:5"/>To kuom yawuota duto ma bende Jehova Nyasaye osemiya mangʼeny, noyiero wuoda Solomon mondo obedi e kom loch mar pinyruodh Jehova Nyasaye e Israel. <verse eid="1CH 28:5"/><verse number="6" style="v" sid="1CH 28:6"/>Nowachona niya, Wuodi Solomon e ngʼat manogerna ot gi laru mare nikech aseyiere mondo odok wuoda kendo anabed wuon-gi. <verse eid="1CH 28:6"/><verse number="7" style="v" sid="1CH 28:7"/>Ka orito chikena gi buchena ma ok obaro mana kaka iritogi sani, to anagur lochne nyaka chiengʼ.<verse eid="1CH 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8"/>“Omiyo achikou e nyim Israel duto kendo e nyim chokruok mar Jehova Nyasaye kendo ka Nyasachwa wacho kama: Beduru motangʼ mondo ulu chike duto mag Jehova Nyasaye ma Nyasachu mondo omi piny maberni osik maru kendo uchiwe kaka girkeni ne nyikwau nyaka chiengʼ.<verse eid="1CH 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9"/>“To in wuoda Solomon, par Nyasach wuonu kendo ichiwri mondo itine gi chunyi duto kendo imiye paroni duto nikech Jehova Nyasaye nono chuny ji duto kendo ongʼeyo paro duto mopondo. Kidware, to iniyude, to kiweye, to enojwangʼi nyaka chiengʼ. <verse eid="1CH 28:9"/><verse number="10" style="v" sid="1CH 28:10"/>Emomiyo par malongʼo nikech Jehova Nyasaye oseyieri mondo igerne ot kaka kama ler mar lemo. Bed motegno kendo itim tich.”<verse eid="1CH 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11"/>Bangʼe Daudi nonyiso wuode Solomon kit gedo mar agoch hekalu, kaka onego gere, kuondege mag keno, utege mamalo, agolnige maiye kod kar timo misango. <verse eid="1CH 28:11"/><verse number="12" style="v" sid="1CH 28:12"/>Ne omiye kit gedo duto mag laru mar hekalu mar Jehova Nyasaye to gi udi molwore kod mago mag keno mar hekalu mar Jehova Nyasaye kendo kuonde keno mag gik mopwodhi mana kaka Roho mar Nyasaye noketo e pache. <verse eid="1CH 28:12"/><verse number="13" style="v" sid="1CH 28:13"/>Bende nomiye chike mag migepe mag jodolo kod jo-Lawi to gi tije duto mag hekalu mar Jehova Nyasaye kaachiel gi gik moko duto mitiyogo e iye. <verse eid="1CH 28:13"/><verse number="14" style="v" sid="1CH 28:14"/>Bende nonyise pek mar dhahabu molosgo gige dhahabu monego tigo e tije mopogore opogore, to gi pek mar fedha molosgo gige fedha monego tigo tije mopogore opogore kaka: <verse eid="1CH 28:14"/><verse number="15" style="v" sid="1CH 28:15"/>pek mar rachungi mag teyni kod techegi molos gi dhahabu, kaachiel gi pek mar rachungi mar taya ka taya gi techene, pek fedha mar rachungi mar taya ka taya gi techene molos kod fedha mana kaka moro ka moro owinjore gi tije; <verse eid="1CH 28:15"/><verse number="16" style="v" sid="1CH 28:16"/>pek mar dhahabu mar mesa ka mesa miketoe makati mopwodhi kaachiel gi pek mar fedha mag mesni molos gi fedha; <verse eid="1CH 28:16"/><verse number="17" style="v" sid="1CH 28:17"/>pek mar dhahabu maler milosogo uma, bakunde mag kiro pi kod njage; pek mar dhahabu mar tawo ka tawo molos gi dhahabu kod pek mar fedha mar tawo ka tawo molos gi fedha; <verse eid="1CH 28:17"/><verse number="18" style="v" sid="1CH 28:18"/>kod pek dhahabu mopwodhi molosgo kendo mar misango miwangʼoe ubani. Bende nonyise kaka onego olos gach lweny, ma en kerubi molos gi dhahabu moyaro bwombegi kendo oumo Sandug Singruok mar Jehova Nyasaye.<verse eid="1CH 28:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19"/>Daudi nowacho niya, “Magi duto manie ndiko ne ayudo kuom lwet Jehova Nyasaye mane ni kuoma, kendo nomiya winjo matut kuom chenro mar gedo.”<verse eid="1CH 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20"/>Bangʼe Daudi nowachone Solomon niya, “Bed motegno kendo gichir kendo tim tijni. Kik ibed maluor kendo kik chunyi nyosre nikech Jehova Nyasaye ma Nyasacha nobed kodi. Ok enojwangʼi bende ok noweyi nyaka itiek tije mag hekalu mar Jehova Nyasaye.” <verse eid="1CH 28:20"/><verse number="21" style="v" sid="1CH 28:21"/>Migepe mag jodolo kod jo-Lawi oseikore ne tije duto mag hekalu mar Jehova Nyasaye, kendo joma ochiwore molony e tije mopogore opogore oikore konyi e tije duto. Jotelo kod ji duto nowinj weche duto miwacho.<verse eid="1CH 28:21"/></para>
  <chapter eid="1CH 28"/>
  <chapter number="29" style="c" sid="1CH 29"/>
  <para style="s1">Chiwo mag hekalu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1"/>Eka Ruoth Daudi nowacho ni chokruok duto niya, “Solomon wuoda ma Nyasaye oseyiero pod en rawera man-gi lony matin. To tijni en tich maduongʼ nikech ot malichni ok en mar dhano to en mar Jehova Nyasaye. <verse eid="1CH 29:1"/><verse number="2" style="v" sid="1CH 29:2"/>Kuom mwandu duto ma aseiko ne gero hekalu mar Nyasacha ma gin dhahabu kuom tije madwaro dhahabu, gi fedha kuom tije mag fedha, gi mula kuom tije mag mula, gi nyinyo kuom tije mag nyinyo, kaachiel gi yiende kuom tije mag yiende kod oniks milosogo ot, gi kite ma kitgi opogore opogore gi kite duto mabeyo kod kite mag ombo. Magi duto aseiko mangʼeny. <verse eid="1CH 29:2"/><verse number="3" style="v" sid="1CH 29:3"/>Ewi mago duto ma asechiwo ne hekalu mar Nyasacha achako agolo mwanduna awuon mag dhahabu kod mag fedha ne hekalu mar Nyasacha. To bende asechiwo moloyo mago ne hekalu malerni gik machalo kaka: <verse eid="1CH 29:3"/><verse number="4" style="v" sid="1CH 29:4"/>dhahabu moa Ofir ma pekne romo kilo alufu mia achiel, fedha mopwodhi ma pekne romo kilo alufu piero ariyo gangʼwen mondo obawgo kor udi, <verse eid="1CH 29:4"/><verse number="5" style="v" sid="1CH 29:5"/>mago notigo tije madwaro dhahabu kod fedha kod tije duto ma jotich molony dwaro timo. To koro ere ngʼat moyie mondo ochiwre ne Jehova Nyasaye kawuono?”<verse eid="1CH 29:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6"/>Eka jotend anywola gi jotelo mag dhout Israel, gi jotend migepe mag jolweny alufe to gi jotend migepe mag jolweny miche kaachiel gi jotelo mochungʼne tije ruoth nochiwore mamor. <verse eid="1CH 29:6"/><verse number="7" style="v" sid="1CH 29:7"/>Negichiwore ne tich mar hekalu mar Jehova Nyasaye ka gigolo dhahabu ma pekne romo kilo alufu mia achiel gi piero ochiko kod machielo ma pekne romo kilo piero aboro gangʼwen, gi fedha ma pekne romo kilo alufu mia adek gi piero abiriyo gabich kod mula ma pekne romo kilo alufu mia auchiel gi piero abiriyo gabich kaachiel gi nyinyo ma pekne romo kilo gana adek, alufu mia abiriyo gi piero abich. <verse eid="1CH 29:7"/><verse number="8" style="v" sid="1CH 29:8"/>Bende joma ne ni kod kite ma nengogi tek nochiwogi e kar keno mar hekalu mar Jehova Nyasaye ka jaritgi en Jehiel ja-Gershon. <verse eid="1CH 29:8"/><verse number="9" style="v" sid="1CH 29:9"/>Ji duto ne mor gi ilo kuom chiwo mar jotendgi nikech negichiwo gi mor kendo gi chuny achiel ni Jehova Nyasaye. Ruoth Daudi bende nomor ahinya.<verse eid="1CH 29:9"/></para>
  <para style="s1">Lemo mar Daudi</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10"/>Daudi nopako Jehova Nyasaye e nyim riwruok mar ji duto kowacho niya,</para>
  <para style="q1" vid="1CH 29:10">“Yaye Jehova Nyasaye ma Nyasach kwarwa Israel,</para>
  <para style="q2" vid="1CH 29:10">duongʼ odogni ndalo duto,</para>
  <para style="q2" vid="1CH 29:10">manyaka chiengʼ.<verse eid="1CH 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11"/>Yaye Jehova Nyasaye, duongʼ kod teko,</para>
  <para style="q2" vid="1CH 29:11">pak gi loch kod ber odogni,</para>
  <para style="q2" vid="1CH 29:11">nimar gik moko duto manie polo gi piny gin magi.</para>
  <para style="q1" vid="1CH 29:11">Yaye Jehova Nyasaye, pinyruoth en mari</para>
  <para style="q2" vid="1CH 29:11">kendo omiyi duongʼ moloyo gik moko duto.<verse eid="1CH 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12"/>Mwandu gi duongʼ aa kuomi;</para>
  <para style="q2" vid="1CH 29:12">kendo in e jarit gik moko duto.</para>
  <para style="q1" vid="1CH 29:12">E lweti nitiere teko gi nyalo</para>
  <para style="q2" vid="1CH 29:12">mondo omi itingʼ ji malo kendo imigi teko.<verse eid="1CH 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13"/>Koro, Nyasachwa, wadwokoni erokamano,</para>
  <para style="q2" vid="1CH 29:13">kendo wapako nyingi maduongʼ.<verse eid="1CH 29:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14"/>“An to an ngʼa, kata joga to gin ngʼa gini, mamiyo nyaka wachiw gi chuny achiel ka ma? Gik moko duto aa kuomi, kendo wasemiyi mana gima oa e lweti <verse eid="1CH 29:14"/><verse number="15" style="v" sid="1CH 29:15"/>Wan jodak kendo joma welo e nyim wangʼi, mana kaka kwerewa nobet. Ndalowa e piny ka chalo gi tipo, kendo waonge geno. <verse eid="1CH 29:15"/><verse number="16" style="v" sid="1CH 29:16"/>Yaye Jehova Nyasaye ma Nyasachwa, kuom gigi duto ma wasechiwo ne geroni hekalu ne Nyingi Maler, oa e lweti, kendo giduto gin magi. <verse eid="1CH 29:16"/><verse number="17" style="v" sid="1CH 29:17"/>Angʼeyo, Nyasacha, ni inono chuny ji kendo imor gi ngʼama timbene beyo. Asechiwo gigi duto gimor kod chuny makare. To bende aseneno kuom mor ma jogi man ka osechiworenigo. <verse eid="1CH 29:17"/><verse number="18" style="v" sid="1CH 29:18"/>Yaye Jehova Nyasaye, ma Nyasach kwerewa Ibrahim, Isaka kod Israel, mad herani osiki ei chuny jogi ndalo duto kendo imi chunygi osik kuomi. <verse eid="1CH 29:18"/><verse number="19" style="v" sid="1CH 29:19"/>Kony Solomon wuoda osik kogeno kuomi gi chunye duto mondo orit chikeni gi dwaroni kod gima iwacho kendo mondo otim gik moko duto kaluwore gi chenro mar gedo malichni ma asechiworane.”<verse eid="1CH 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20"/>Bangʼe Daudi nowachone chokruok duto niya, “Pakuru Jehova Nyasaye, ma Nyasachu.” Omiyo giduto negipako Jehova Nyasaye, ma Nyasach kweregi, negikulore piny auma kendo ginindo piny e nyim Jehova Nyasaye kendo e nyim ruoth Daudi.<verse eid="1CH 29:20"/></para>
  <para style="s1">Solomon obedo ruoth</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21"/>Kinyne negitimone Jehova Nyasaye misango kendo negichiwone misengini miwangʼo pep mag rwedhi alufu achiel gi imbe alufu achiel to gi nyiimbe alufu achiel kaachiel gi misango miolo piny to gi misengini mamoko mangʼeny ne jo-Israel duto. <verse eid="1CH 29:21"/><verse number="22" style="v" sid="1CH 29:22"/>Negichiemo kendo metho gimor maduongʼ odiechiengno e nyim Jehova Nyasaye.</para>
  <para style="p" vid="1CH 29:22">Bangʼe negichako giketo Solomon wuod Daudi kaka ruoth, kendo ne giwire gi mo e nyim Jehova Nyasaye mondo obed ruoth, to Zadok, to nowir kaka jadolo. <verse eid="1CH 29:22"/><verse number="23" style="v" sid="1CH 29:23"/>Omiyo Solomon nobedo e kom loch Jehova Nyasaye kaka ruoth kar Daudi wuon mare. Ne en gi gweth kendo jo-Israel nomiye luor. <verse eid="1CH 29:23"/><verse number="24" style="v" sid="1CH 29:24"/>Jotelo kod thuondi madongo kaachiel gi yawuot Ruoth Daudi nochiwore moyie bedo e bwo loch Ruoth Solomon.<verse eid="1CH 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25"/>Jehova Nyasaye notingʼo Solomon malo e nyim jo-Israel kendo nomiye duongʼ moloyo ruodhi duto mane osebedo e Israel motelone.<verse eid="1CH 29:25"/></para>
  <para style="s1">Tho mar Daudi</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26"/>Daudi wuod Jesse ne ruoth mar jo-Israel duto. <verse eid="1CH 29:26"/><verse number="27" style="v" sid="1CH 29:27"/>Nobedo ruodh Israel duto higni piero angʼwen, higni abiriyo ne en Hebron, to higni piero adek gadek ne en Jerusalem. <verse eid="1CH 29:27"/><verse number="28" style="v" sid="1CH 29:28"/>Nodak e ngima maber ka en-gi mwandu kod duongʼ, bangʼe notho ka hike noniangʼ moloyo. Wuode ma Solomon nobedo ruoth kare.<verse eid="1CH 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 29:29"/>Kaluwore gi gik moko mane Daudi otimo chakre kinde mane en ruoth nyaka giko; ondikgi e kitepe mag jonabi Samuel, Nathan kod Gad, <verse eid="1CH 29:29"/><verse number="30" style="v" sid="1CH 29:30"/>kaachiel gi weche mamoko mag lochne kod teko, to gi gik moko mane olwore gi jo-Israel kod loch jopinje mamoko.<verse eid="1CH 29:30"/></para>
  <chapter eid="1CH 29"/>
</usx>
