<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Nyagbo Old Testament</book>
  <para style="rem">Tutrugbu</para>
  <para style="rem">Translated by Lucas Jebbey and Rev. Charles Asem Bansah consultant Dr. Josiah Andor</para>
  <para style="rem">Reviewed By Tutrugbu Language Committe</para>
  <para style="rem">From March 2023—December 2023</para>
  <para style="h">Kesikpɛkpɛ</para>
  <para style="h">Kesikpɛkpɛ</para>
  <para style="toc1">Mose Keplukpa Geputɔ Kesikpɛkpɛ</para>
  <para style="toc2">Kesikpɛkpɛ</para>
  <para style="toc3">Kes.</para>
  <para style="mt1">Kesikpɛkpɛ</para>
  <para style="imt">Otugba Kibuiɛ</para>
  <para style="ip">Kinyeɛ gɛ bekulu asɛ <char style="bk">Kesikpɛkpɛ</char> nɔ esiɛ kɛlɛinu ɔsɛ "odekɔ." Keplukpa aɖɔaɖɔ nɛ kanɔnɔ mɛ tɛbhɛbhɛtɛ shu, banɔdzyrame odekɔ, ebuikpa bhɛbhɛtɛ kesikpɛkpɛ nɛ̀ bɔtɔɔ nɛ kanɔnɔ mɛ, nɛ Owusoso Akaa edzoɔ gɛ alɔkɔ akpà ishu aplɛnɔ banɔ. Bebu Kesikpɛkpɛ keplukpa akpɛ bɔwɔ̃pɛ tɔɔbhà mɛ:</para>
  <para style="ip">1) <char style="it">Kɛtakpu ibuiɛ 1-11</char> Enu kanɔnɔ mɛ tɛbhɛbhɛtɛ nɛ̀ banɔdzyrameɛ balɛ odekɔ ebui. Ɛkɛlɛ baɖɔaɖɔ nɛ Aɖam nɛ̀ Eva, Kain nɛ̀ Abɛl, Noah nɛ̀ budekelĩɛ, nɛ̀ kitití buvũ dzudzu nɛ Babilɔn shu.</para>
  <para style="ip">2)<char style="it">Kɛtakpu kibuiɛ 12-50</char> Enu atitì ebuiɛ gɛ bafɔnɔ nɛ Israelianɛ bashuĩnɔ gɛeputɔ shu. Agɛ yɛeputɔ yɛenu Abraham, anɔ gɛ betì yɛ nɛ yɛ tɛyɛyɛkɛŋã nɛ̀ batɔ̃lulu akɔ Owusoso Akaa shu. Kɛlɛ ideɛ bafɔnɔ ebui nɛ yɛeyianyɛ Isak nɛ̀ yɛeshui Yakɔb (gɛ bekulu tsyɛ asɛ Israeliɛ shu), nɛ̀ Yakɔ yɛ beyianyɛ lɔfɔ nɛ̀ taabha, bagɛ balɛ mɛ Israelianɛ egbogbo lɔfɔ nɛ̀ taabha edeɛ shu. Bebu awɔ̃ atɔɖɔ yɛeyianyɛ tenikpo shu, Yosɛf, nɛ̀ kɛgɛ kɔ so pɛ bagbana Yakɔb nɛ̀ yɛ beyianyɛ gɔgɔɛnɔ nɛ̀ balɛ bɔpã sɛ babazã Egipteɛ.</para>
  <para style="ip">Gɛ keplukpa aɖɔaɖɔ nɛ banɔ shu tsyɛ, kɛgɛ Owusoso Akaa abhɛtɛ shu so pɛ bafɔnɔ kalɛ. Batɔɖɔ kɛklagbu nɛ kalɛ kesikpɛkpɛ ebui nabha sɛ Owusoso Akaa yɛabhɛtɛ kanɔnɔ mɛ, kɛlɛ ɔgɔgɔɛ ɔkɔ ɔɖɔ kibui tɔtɔɖɔ lu sɛ Owusoso Akaa abazã kɛlɛ abha azaplɛnɔ yɛanɔnɔ. Nɛ keplukpa petee mɛɛ, Owusoso Akaa shu baɖɔ kaɖɔ, anɔ gɛ ekulu kebhu pɛ aapɔ̃ baatɔ̃ akɔ bagɛ batá kesi, agbanà yɛanɔnɔ kɛlɛ aplɛnɔ alɛ, pɛ akɔ balɛ odekɔ ɔgɛ yala. Bafɔnɔ atitì keplukpa alɛ tɛ babakà banɔnɔ gɛ tɛyɛkɛŋã ebuiɛ tɛ kɛkɔ sɛ tɛyɛyɛkɛŋã ɛlɛ zã nɛkpã.</para>
  <para style="iot">Keplukpa mɛ Ebuiɛ</para>
  <para style="io1">Kanɔnɔ mɛ nɛ̀ banɔdzryame tɛbhɛbhɛtɛ (1.1—2.25)</para>
  <para style="io1">Ebuikpa bhɛbhɛtɛ kesikpɛkpɛ nɛ̀ bɔtɔ mɔmɔ̃ (3.1-24)</para>
  <para style="io1">Odenɔ Aɖam abha amanà Noah abha (4.1—5.32)</para>
  <para style="io1">Noah nɛ̀ budekelĩ hohoeɛ (6.1—10.32)</para>
  <para style="io1">Babilɔn kititì buvũɔ tidzudzu (11.1-9)</para>
  <para style="io1">Odenɔ Shem abha amanà Abram abha (11.10-32)</para>
  <para style="io1">Bashuĩ nɔ: Abraham, Isak, Yakɔb (12.1—35.29)</para>
  <para style="io1">Esau yɛ bɔmɔ̃ɔ (36.1-43)</para>
  <para style="io1">Josɛf nɛ̀ yɛadzalɛ (37.1—45.28)</para>
  <para style="io1">Israelianɛ nɛ Egipte (46.1—50.26)</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s1">Kanɔnɔ mɛ tɛbhɛbhɛtɛ Ebuiɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />Nɛ kesikpɛkpɛ mɛ, Owusoso Akaa ebu kesi nɛ̀ kabha. <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />Kesiakpa azã tsyakpãtsyakpã, kɛlɛ kazã akpakpá, kɛlɛ otumũ ɔdã kalɛ kelĩ dzudzu nabha, kɛlɛ Owusoso Akaa ɔfɔfuía nɔ asanda nɛ buli na amɛ.<verse eid="GEN 1:2" /></para>
  <para style="b" />
  <para style="li">
    <verse number="3" style="v" sid="GEN 1:3" />Kɛlɛ Owusoso Akaa aɖɔ sɛ, "Kifu kueyi," kɛlɛ kifu kueyi. <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />Owusoso Akaa amɔ asɛ kifuɔ pɛ, kɛlɛ ebu kifuɔ ɔtɔ nɛ otumũɔ shu. <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />Owusoso Akaa ekulu kifúɔ asɛ "kelizaza," kɛlɛ ekulu otumũɔ asɛ "elishi." So ɔwlago ɔba, kɛlɛ kɛvɔlɔ ba-kɛlɛ dzi kiwiɛ gɛiputɔ.<verse eid="GEN 1:5" /></para>
  <para style="li">
    <verse number="6" style="v" sid="GEN 1:6" />Kɛlɛ Owusoso Akaa aɖɔ asɛ, "Kɔ ɔzãkɔ zã bulĩ nɛishi tɛ kidzo bu nɛ bulĩ neishi." <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />Kliso Owusoso Akaa ebu kidzo kpɛ kesiakpa bulĩɛ nɛ kititi bulĩɛ nɛishi. Kliso kɛba ɛlɛ mɛ ana. <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />Owusoso Akaa ekulu ɔzãkɔ geibu kidzo nɛ bulĩ neishi asɛ "kɛlɛ́ɛ mɛ." Kɛlɛ ɔwlago ɔba, kɛlɛ kɛvɔlɔ ɔba-kiwui bhala nɛ ɛlɛ.<verse eid="GEN 1:8" /></para>
  <para style="li">
    <verse number="9" style="v" sid="GEN 1:9" />Owusoso Akaa sɛ, "Kɔ bulĩɛ nɛ kɛlɛɛ nɔ mɛesiɛ eshogo nɛ ɔkɔ tenikpo tɛ kesiakpa kpakpa ekoeyi." Kɛlɛ kɛ ba ɛlɛ mɛ ana. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />Owusoso Akaa ekulu kesiakpa kpakpa nɔ asɛ "kesiakpa," kɛlɛ ekulu bulĩɛ gɛ eshogoɔ asɛ "bulĩkekpu." Kɛlɛ Owusoso Akaa amɔ asɛ kɛgɛ ebuɔ apɛ.<verse eid="GEN 1:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="GEN 1:11" />Kidegba Owusoso Akaa aɖɔ asɛ, "Kɔ kesiakpa ebu ayakpa-tɛwa gɛiyu eyuyu, nɛ̀ isi ediedi gɛiyu eyuyu pɛ beeyi akpasɛ balɛ mɛ nɛ kesiakpa naabha." Kɛlɛ kɛba ana. <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />Kesiakpa ebu ayakpa: tɛwa gɛiyu beeyi gɛ ashɔ̃ nɛ balɛ, nɛ̀ beesi ediedi gɛiyu eyuyu pɛ beeyi akpasɛ balɛ mɛ gɛ ashoɔ̃ nɛ balɛ. Kɛlɛ Owusoso Akaa amɔ asɛ apɛ. <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />Kliso ɔwlago ɔzɔ aba kɛlɛ kɛvɔlɔ ɔzɔ ba-kiwi kɛtɛramɛ nɛ ɛlɛ.<verse eid="GEN 1:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="GEN 1:14" />Kɛlɛ Owusoso Akaa aɖɔ asɛ, "Kifu kueyi nɛ kɛlɛɛ nɔ mɛ tɛ ebu kidzo akpɛ kelizaza nɛ̀ elishi nɛishi, tɛ bedzi kɛwɔ̀ akɔ ekukù nɛ ekpe, nɛ ewuie nɛ agɔ, <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />kɛlɛ asɛ baakani ekueyi nɛ kɛlɛɛ nɔ mɛ tɛ akɔ kifu nɛ kesiakpa nabha." Kɛlɛ kɛba ɛlɛ mɛ ana. <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />Owusoso Akaa abhɛtɛ kani taabha-kani gbagbla tɛ aŋa kelizaza nabha kɛlɛ kani bhuli nɔ tsyɛ tɛ aŋa elishi nabha. Abhɛtɛ awɔɛ tsyɛ. <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />Owusoso Akaa alɔkɔ balɛ akpɛ kɛlɛɛ nɔ mɛ tɛ bakɔ kifu nɛ kesiakpa nabha, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />tɛ baŋa kelizaza nɛ̀ elishi nabha tɛ bewuliɛ buidzo nɛ tibhuibhui nɛ otumu mɛ. Kɛlɛ Owusoso Akaa amɔ asɛ apɛ. <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />Kɛlɛ ɔwlago ɔzɔ ɔba kɛlɛ kɛvɔlɔ ɔzɔ ba-kiwui lɛlɛmɛ.<verse eid="GEN 1:19" /></para>
  <para style="li">
    <verse number="20" style="v" sid="GEN 1:20" />Kɛlɛ Owusoso Akaa aɖɔ asɛ, "Kɔ bulĩɛ bu kelĩ mɛ baagã, kɔ bɔzhɔɛ bupruɖu nɛ kesiakpa nabha nɛ kɛlɛɛ nɔ mɛ." <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />Kliso Owusoso Akaa ebu kelĩkekpu mɛ baagã gbagbla nɛ̀ kelĩ mɛ baagã kanyiaka, nɛ balɛ tɛzazã mɛ, nɛ bɔzhɔɛ kanyiaka gɛ bupruɖu. Kɛlɛ Owusoso Akaa amɔ asɛ apɛ. <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />Owusoso Akaa eyula tɔɖɔ baagã kɛlɛ aɖɔ asɛ, "Noyu tɛ no kpe tɔɖɔ tɛ noyuku bulĩɛ nɛ bulĩkekpuɔ mɛ, tɛ bɔzhɔɛ nɔ tsyɛ mɔ́ tɔɖɔ nɛ kesiakpa nabha." <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />Kɛlɛ ɔwlago zɔ ɔba kɛlɛ kɛvɔlɔ ɔzɔ ɔba-kiwui itrimiɛ nɛ ɛlɛ. <verse eid="GEN 1:23" /><verse number="24" style="v" sid="GEN 1:24" />Kɛlɛ Owusoso Akaa aɖɔ asɛ, "Kɔ kesiakpa bu baagã nɛ balɛ tɛzazã mɛ-bɔpã mɛ baagã, baagã gɛ beetsì nɛ kesiakpa, nɛ kifutu mɛ baagã, ediedi nɛ balɛ tɛzãzã mɛ." Kɛlɛ kɛba ɛlɛ mɛ ana. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />Owusoso Akaa abhɛtɛ kifutù mɛ baagã nɛ balɛ tɛzãzã mɛ nɛ̀ bɔpã mɛ baagã nɛ balɛ tɛzãzã mɛ, nɛ baagã gɛ betsì nɛ kesiakpa nɛ balɛ tɛzãzã mɛ. Kɛlɛ Owusoso Akaa amɔ asɛ apɛ.<verse eid="GEN 1:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="GEN 1:26" />Kɛlɛ Owusoso Akaa aɖɔ asɛ, "Nɔkɔ bɔ bhɛtɛ anɔdzrame nɛ bɔlɔ telɛlɛ mɛ, tɛ baŋã akpaa nɔ nɛ bulĩkekpuɔ mɛ, bɔzhɔɛ nɔ nɛ kɛlɛɛ nɔ mɛ, bɔpã mɛ baagã nyɔ̃ɔ nɛ kesiakpa nabha, nɛ baagã nyɔ̃ɔ gɛ beetsì nɛ kesiakpa."<verse eid="GEN 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 1:27" />Kliso Owusoso Akaa ebu anɔdzrame nɛ Owusoso Akaa yɛ tezazã mɛ-anyɛ nɛ adzɛ yebu balɛ.<verse eid="GEN 1:27" /></para>
  <para style="pi">
    <verse number="28" style="v" sid="GEN 1:28" />Owusoso Akaa eyula tɔɖɔ balɛ kɛlɛ aɖɔ etseɖe balɛ asɛ, "Noyu tɛ nɔmɔ tɔɖɔ; no yuku kesiakpa mɛ tɛ nɔmɔ ohumi nɛ kalɛ abha. Nɔŋã kɛlɛɛ mɛ bɔzhɔɛ nɔ nɛ baagã gɛ beetsì nɛ kesiakpa petee nabha." <verse eid="GEN 1:28" /><verse number="29" style="v" sid="GEN 1:29" />Kidegba Owusoso Akaa aɖɔ asɛ, "Ɛlɔkɔ tɛwa gɛ tiiyu pɛ beeyi akpasɛ balɛ mɛ nɛ kesiakpa nabha nyɔɔ, nɛ̀ busi kanyiaka gɛiyu pɛ beeyi akpasɛ balɛ mɛ akɔ wɔnɔ. Bedzi wɔnɔ ayɛ asɛ bɔŋaŋã ana. <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />Kɛlɛ kifutu mɛ baagã nyɔ̃ɔ nɛ kesiakpa nabha nɛ bɔzhɔɛ nɔ nɛ kɛlɛɛ nɔ mɛ nɛ baagã kanyiaka gɛ beetsì nɛ kesiakpa-kedɔ kanyiaka gɛ ofɔfuia ɔkpasɛ kɛlɛ mɛ-ɛlɔkɔ tɛwa kanyiaka kɔ asɛ bɔŋaŋa." Kɛlɛ kɛba ɛlɛ mɛ ana.<verse eid="GEN 1:30" /></para>
  <para style="pi">
    <verse number="31" style="v" sid="GEN 1:31" />Owusoso Akaa amɔ asɛ kɛkanyiaka gɛ abhɛtɛ apɛ piapii. Kɛlɛ ɔwlago ɔzɔ ɔba kɛlɛ kɛvɔlɔ ɔzɔ ɔba-kiwui holomiɛ.<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="pi">
    <verse number="1" style="v" sid="GEN 2:1" />Ɔgana kidzo ɛlɛ abha babhɛtɛ owusoso nɛ̀ kesiakpa beke nɛ̀ kɛsiaka gɛ kpasɛ balɛmɛɛ.<verse eid="GEN 2:1" /></para>
  <para style="b" />
  <para style="li">
    <verse number="2" style="v" sid="GEN 2:2" />Tɛ kiwui gegenemiɛ ba naa, Owusoso Akaa ɛxɔɛ gɛ áwɔa kibele; kliso emoele nɛ yɛ kanɔmɛbubu kɛxɔɛ wɔawɔa nyɔ̃ɔ ishu. <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />Kɛlɛ Owusoso Akaa eyula tɔɖɔ kiwui gegenemiɛ kɛlɛ adãlɛ kɛlɛ ishu, ɔmɔsɛ kiwui ɛlɛ nabha emoele nɛ yɛ kanɔmɛ tibubu kɛxɔé nyɔ̃ɔ gɛ awɔa ishu.<verse eid="GEN 2:3" /></para>
  <para style="s1">Aɖam nɛ̀ Eva</para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4" />Kitití nɛ̀ kesiakpa gɛ bebu balɛ ebuiɛ naalɛ.</para>
  <para style="b" vid="GEN 2:4" />
  <para style="p" vid="GEN 2:4">Kibe ɛlɛ gɛ Apalete Owusoso Akaa abhɛtɛ kesiakpa nɛ̀ kititíɛ. <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />gɛ tɛwa nɛ beesi bekeyi nɛ kesiakpa nabhaa, pɛ bɔŋaŋa beyie bekeyi, ɔmɔsɛ Apalete Owusoso Akaa aka sɛsɛ subha nɛ kesiakpa nabha, kɛlɛ anɔdzrame anana ma gɛ aba awa bɔyaa, <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />pɔ adzidza ekoeyi nɛ kesiakpa mɛ pɛ akpɛ bulĩ nɛ kesiakpa tisiɛ mɛ- <verse eid="GEN 2:6" /><verse number="7" style="v" sid="GEN 2:7" />Apalete Owusoso Akaa abhɔ anɔdzrame edenɔ tisi osubhu nɔ mɛ kɛlɛ afuiã ɛkpã ɔfɔfuĩa nɔ akpɛ yɛ anyɔtɔ̃ mɛ kɛlɛ anɔdzrameɛ ebedzi enunu.<verse eid="GEN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8" />Otsi Apalete Owusoso Akaa akpɛ bɔkã nɛ kiwuiɛ otukɔ, nɛ Eɖen; kɛlɛ alɔkɔ anɔdzrameɛ akpɛ ɛkɛlɛ. <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />Apalete Owusoso Akaa akɔ asɛ beesi ediedi bekoeyi nɛ tisie mɛ-beesi gɛ bapɔɔɖi nɛ̀ baagɛ bapɛ̃ kɔ bɔŋaŋa. Nɛ bɔkã yɛ kishitɛbha busi gɛ akɔ ɛkpã, kibuititi, kibui gbãŋgbã nɛ kibuikpa azã.<verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />Kelĩ gɛ akpɛ bulĩ nɛ bɔkaã mɛ azakpɛ denɔ Eɖen; denɔ bɔkã mɛ, kelĩɛ aya eku bulĩodi taãlɛ mɛ. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />Beekulu bulĩodiɛ gɛ eputɔɔ asɛ Pison; akpɛ kana Xavila kesiakpa nabha nyɔ̃ɔ, ɛkɛlɛ sikã ɔɖa dzadzã alɛ. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />(Sikã ɔɖaa dzadzã gɛ alɛ kesiakpa alɛ nabha pɛ; beesie gɛiyu kɛmatã huhuhuɔ nɛ onis keklagbu tsyɛ alɛ ɛkɛlɛ.) <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />Bulĩodi ɔbhala ɔlɛ kinyie ɔlo nu Gixɔn; lɔ kana Kush kesiakpaa nyɔɔ abha. <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />Bulĩodi ɔtrameɛ ɔlɛ kinyie ɔlo nu Tigris; lɔ kana Asiria nɛ yɛ kiwiɛ otuɔkɔ. Bulĩodi ɔlɛlɛ mɛ ɔlɛ onu Yufratis.<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />Apalete Owusoso Akaa alɔkɔ anyɛ akpɛ Eɖen bɔkaã mɛ tɛ awɔa bɔlɛmɛ. <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />Kɛlɛ Apalete Owusoso Akaa akpɛ ɔsha kɔ anyɛ asɛ, "Obɔla ɔŋã bɔdɔ̃ denɔ busi kanyiaka mɛ nɛ bɔkaã mɛ; <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />pɔɔ tɛŋã bɔdɔ̃ odenɔ busiɛ gɛ akɔ kibuititi nɛ̀ kɛgbaŋgbaŋ nɛ̀ kɛkpa shuɔ mɛ, obotsi gɛ onupɛ ɔŋã bɔdɔ̃ odenɔ busi ɛlɛ mɛ."<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />Apalete Owusoso Akaa aɖɔ asɛ, "Agɛ pɛ sɛ anyɛ yɛ tenikpo azã. Ɛba bhɛtɛ apɛplɛnɔ gɛ aba shɔ̃ akɔɛ."<verse eid="GEN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 2:19" />Otsiɛ nɔ Apalete Owusoso Akaa atɛ bhɛtɛ kifutumɛ baagã petee nɛ̀ kɛlɛɛmɛ bɔzhɔɛ nɔ nyɔ̃ɔ odenɔ tisiɛ mɛ. Alɔkɔ balɛ amana anɔdzrameɛ tɛ eɖi kinye nɔnɔ gɛ aba kɔ balɛ; kɛlɛ kinye kanyiaka gɛ akɔ baagã bedzi balɛ kinye. <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />Kliso anyɛ akɔ kinye kepi baagã, kifutumɛ bɔzhɔɛ nɔ nɛ kifutumɛ baagã.</para>
  <para style="p" vid="GEN 2:20">Pɔɔ apɛplɛnɔ kɔ Adam agɛ zã. <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />Kliso, Apalete Owusoso Akaa akɔ anyɛ eku taramɛ; kɛlɛ gɛ adɔ tara, ebu anyɛ yɛ kɛnxɔã tenikpo kɛlɛ alɔkɔ kɛdza dã ɛkɛlɛ. <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />Kidegba Apalete Owuŋsoso Akaa abhɛtɛ adzɛ odenɔ kɛnxɔã gɛ ebu odenɔ anyɛɛ mɛ, kɛlɛ alɔkɔɛ amana anyɛ.<verse eid="GEN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 2:23" />Anyɛ aɖɔ asɛ,</para>
  <para style="q1" vid="GEN 2:23">"Kɛnxɔã odenɔ mɛ kɛnxɔã mɛ</para>
  <para style="q2" vid="GEN 2:23">nɛ kɛdzya odenɔ mɛ kɛdzya mɛ otsi alɛ;</para>
  <para style="q1" vid="GEN 2:23">bebekului asɛ 'adzɛ,'</para>
  <para style="q2" vid="GEN 2:23">ɔmɔsɛ bebui odenɔ anyɛ mɛ."<verse eid="GEN 2:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="GEN 2:24" />Kliso anyɛ abashɛ̃ nɛ yɛakaa nɛ yɛelĩ ɔkɔ tɛ abhɛtɛ tenikpo nɛ yɛ edzini, tɛ babhɛtɛ ishudza tenikpo.<verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />Anyɛ nɛ adzɛ bazã kɛdɔ makpɛmakpɛ, kɛlɛ kiŋui gi yi balɛ.<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s1">Anɔdzrame Kesizhyizhyi</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />Otsiɛ nɔ eblidza edzi anɔwɔe adɛ kifutumɛ baagaã petee gɛ Apalete Owusoso Akaa abhɛtɛ. Ebisi adzɛ asɛ, "Kɛgbã bɔɖɔ Owusoso Akaa aɖɔ asɛ, 'Nɔtɛ ŋã bɔdɔ odenɔ busi kanyiaka abha nɛ bɔkaã mɛ dza'?''<verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />Adzɛ etseɖe eblidza asɛ, "Bɔbala ŋã busi eyuyu denɔ beesiɛ mɛ nɛ bɔkaã mɛ, <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />pɔɔ Owusoso Akaa aɖɔ asɛ, 'Nɔtɛ ŋã busi eyuyu odenɔ busiɛ gɛedzi bɔkaã kishitɛbha mɛ, kɛlɛ noti hunu ɔlɛ, onu ginɛ kanaa nobo tsi.' "<verse eid="GEN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />Eblidza etseɖe adzɛ asɛ, "Noti botsi." <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />"Ɔmɔsɛ Owusoso Akaa enyi asɛ nɔŋã bɔdɔ̃ denɔ busi nabhaa, wɔnɔ anhũ abakpa asɛ Owusoso Akaa ana, gɛ noboti kɛgbaŋgbaŋ nɛ kɛkpa shu."<verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />Gɛ adzɛ amɔ asɛ busi eyuyuɔ apɛ kɔ tɛŋãŋã kɛlɛ apɔɔ ɖiɛ, pɛ apɛ̃ kɔ bubuti mɔmɔ tsyɛ, apɔ̃ teli pɛ aŋãɛ. Akɔ yɛnyineɛ gɛ alɛ yɛɔbha tsyɛ teli pɛ aŋãɛ <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />Kɛlɛ balɛ taabha anhũɔ bakpa, kɛlɛ beti asɛ balɛ kɛdɔ makpɛmakpɛ; kliso bakamɛ awulakpa plɛnɔ baagɔlɔ kɛlɛ babhɛtɛ akpɛkpɛ kɔ balɛ kishu.<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />Kɛlɛ kidemɛ anyɛ nɛ̀ yɛedzini belũ Apalete Owusoso Akaa yɛɔdɔ̃ gɛ agã nɛ bɔkaã mɛ nɛ owlagoɔ mɛ, kɛlɛ bedi kpũ kɔ Apalete Owusoso Akaa nɛ beesie gɛ balɛ bɔkaã mɛ. <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />Pɔɔ Apalete Owusoso Akaa ekulu ebisi anyɛ sɛ, "Wɔɔ xɔ̃?"<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />Adɛmɛ asɛ, "Ilũ wɔdɔ̃ nɛ bɔkaã mɛ, kɛlɛ kifu dɛmɛ ɔmɔsɛ ɛlɛ kɛdɔ makpɛmakpɛ; kliso idi kpũ."<verse eid="GEN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11" />Kɛlɛ Owusoso Akaa ebisi asɛ, "Afa gɛ etseɖe wɔ asɛ ɔlɛ kɛdɔ makpɛmakpɛ dza? Ɔŋã bɔdɔ̃ denɔ busiɛ gɛ ɛkpɛ ɔsha kɔwɔ sɛ ɔtɛŋaã mɛ dza?"<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />Anyɛ ebuilɛulũ asɛ, "Adzɛɛ gɛ ɔlɔkɔ kpɛ ɛkɛlɛ plɛnɔ mɛ-yɛakɔ mɛ busi eyuyu denɔ busie mɛ, kɛlɛ mɛŋãɛ."<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />Kliso Apalete Owusoso Akaa ebisi adzɛɛ asɛ, "Keɖe nɛ alɛ gɛ ɔbhɛtɛ?"</para>
  <para style="p" vid="GEN 3:13">Adzɛɛ ebuilɛulũ asɛ, "Eblidzya yɛ awɛɛ mɛ, pɛ ɛŋã."<verse eid="GEN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />Kliso Apalete Owusoso Akaa etseɖe eblidzaa asɛ, "Gɛ ɔbhɛtɛ kanaana kibui ɛlɛ soɔ,</para>
  <para style="q1" vid="GEN 3:14">"Kibuiɖɔkpɛanɔ gɛ abadɛ kepi baagãã</para>
  <para style="q1" vid="GEN 3:14">nɛ̀ kifutumɛ baagãã nyɔɔ ayɛ abazã wɔ abha!</para>
  <para style="q2" vid="GEN 3:14">Obotsì nɛ wɔ kevũ naabha</para>
  <para style="q2" vid="GEN 3:14">kɛlɛ ɔbɔŋã osubhududu nɛ wɔ ɛkpã mɛ.<verse eid="GEN 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 3:15" />Kɛlɛ ɛbalɔkɔ anɔ tɛnyanyana</para>
  <para style="q2" vid="GEN 3:15">kpɛ ɛyamɛ kpɛ wɔ nɛ̀ adzɛ nɛishi,</para>
  <para style="q2" vid="GEN 3:15">kɛlɛ kpɛ wɔ kihwui nɔ nɛ yɛayɛ mɛ;</para>
  <para style="q1" vid="GEN 3:15">aba yɛɛ wɔ kɛtakpu,</para>
  <para style="q2" vid="GEN 3:15">kɛlɛ wɔtsyɛ obo nemì yɛ katsrɛkpɔ niede."<verse eid="GEN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />Otsi yɛaɖɔ etseɖe adzɛɛ tsyɛ asɛ,</para>
  <para style="q1" vid="GEN 3:16">"ebakɔ wɔ eyamumunɔ ishumɛ tɛtatãnɔ ekpe tɔɖɔ;</para>
  <para style="q2" vid="GEN 3:16">ishumɛ tɛtatãnɔ kɛtɛkɛtɛ mɛ wɔbɔzã pɛ ɔbɔmɔ beeyi.</para>
  <para style="q1" vid="GEN 3:16">Wɔ ishumɛ tɛpɛpɛnɔ abazã wɔ enyini abha,</para>
  <para style="q2" vid="GEN 3:16">kɛlɛ abaŋã wɔ abha."<verse eid="GEN 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />Otsi etseɖe Aɖam tsyɛ asɛ, "Gɛ olũ kɛgɛ wɔ edzini aɖɔ pɛ ɔdɛŋã bɔdɔ̃ denɔ busiɛ gɛ ɛkpɛ ɔsha kɔ wɔnɔ sɛ, 'Nɔtɛ ŋã bɔdɔ̃ denɔ yɛabhaa,'</para>
  <para style="q1" vid="GEN 3:17">"Baɖɔ kibui akpɛ kesiakpa nɛ wɔ kɛtakpu;</para>
  <para style="q2" vid="GEN 3:17">odenɔ bɔtɔ kɛtɛkɛtɛ mɛ flogo pɛ ɔbɔŋã bɔdɔ̃ odenɔ kalɛ mɛ</para>
  <para style="q2" vid="GEN 3:17">nɛ wɔ ekpã ewiɛ mɛ nyɔɔ.<verse eid="GEN 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 3:18" />Kesiakpa ebe bu ewu tɛwa kɔ wɔ,</para>
  <para style="q2" vid="GEN 3:18">kɛlɛ ɔbɔŋã ayakpamɛ tɛwa.<verse eid="GEN 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 3:19" />Nɛ wɔ ketu buhehetata mɛ</para>
  <para style="q2" vid="GEN 3:19">ɔbɔŋã wɔdɔ̃</para>
  <para style="q1" vid="GEN 3:19">odenɔ gɛ otsyina ɔvɛ tisiɛ mɛ,</para>
  <para style="q2" vid="GEN 3:19">ɔmɔsɛ tisi mɛ bebu wɔ;</para>
  <para style="q1" vid="GEN 3:19">kliso osubhududu wɔ onu</para>
  <para style="q2" vid="GEN 3:19">kɛlɛ osubhududu wɔ obotsyina odzi."<verse eid="GEN 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />Adam akɔ yɛedzini kinye asɛ Eva, ɔmɔsɛ ebedzi elĩ akɔ banɔdzrame galɛ nɛ ɛkpã nyɔɔ.<verse eid="GEN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 3:21" />Apalete Owusoso Akaa abhɛtɛ bagaã bupi akpɛkpɛ akɔ Adam nɛ yɛedzini kɛlɛ alɔkɔ akpɛ akɔ alɛ. <verse eid="GEN 3:21" /><verse number="22" style="v" sid="GEN 3:22" />Kɛlɛ Apalete Owusoso Akaa aɖɔ asɛ, "Otsialɛ anyɛ edzi bɔlɔmɛ ayɛ tenikpo, gɛ enyi kegbaŋgbaŋ nɛ̀ kɛkpa. Kɛma sɛ bakɔ yɛidzo tɛ akpɛ ahɔɛ nɛ ɛkpã busie mɛ tɛ alɔkɔ bɔdɔ̃ aŋã, tɛ abazã nɛ ɛkpã tihɔɔ." <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />Kliso Apalete Owusoso Akaa akaka yeɛbu nɛ Eden bɔkaã mɛ tɛ adɛwa kesiakpa mɛ gɛ bebu yɛ denɔ. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />Gɛ akaka anyɛ ebu bekeɛ, alɔkɔ kerubim agã bedzu bɔkaã bɔlɛ kiwuie otuɔkɔ kɛlɛ akɔ bhɛtɛ ilũgbu tɛbha gɛibu kifuɔ azã epo kidzoɔ gɛ ɔvɛ ɛkpã busieɛ ɔkɔ.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s1">Kain nɛ̀ Abel</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />Aɖam awɔsɔ̃ nɛ̀ yɛedzini Eva, kɛlɛ emunu ɛya kɛlɛ amɔ Kain. Aɖɔ asɛ, "Nɛ Apalete Akaa tɛpɛplɛnɔ mɛ ɛmɔ anyɛ." <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />Kɛlɛ kidemeɛ amɔ́ yɛadzya Abel.</para>
  <para style="p" vid="GEN 4:2">Otsiɛ nɔ Abel ezelu baagã, kɛlɛ Kain ázadɛ bɔya. <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />Nɛ kibe teli kidiɛ Kain alɔkɔ yɛ bɔya mɛ bɔdɔ̃ amana Apaleteɛ asɛ bɔdɔ̃kɔkɔ ana. <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />Pɔɔ Abel amana baagã gɛ ishumɛ gbaŋgbaŋ nɛ bɔbɔ zã balɛ ishu odenɔ yɛ baagã beeyie gɛeputɔ mɛ. Abel yɛ bɔdɔ̃kɔkɔ eku Apaleteɛ awɔ̃, <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />pɔɔ Kain yɛ bɔdɔ̃kɔkɔ egiku yɛ awɔ̃. Kliso Kain akpɛ ɔmɔpɔɛ, kɛlɛ yɛ bameɛ ku otumũ.<verse eid="GEN 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 4:6" />Kidegbaa Apaleteɛ ebisi Kain asɛ, "Kɛlɛso pɛ wɔ baameɛ eku otumũ ana? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />Ɔbhɛtɛ kibui gbangbã, batɛ bayɛkɛ wɔ dza? Pɔɔ ɔgɛ bhɛtɛ kibui gbangbã, kibuikpa bhɛbhɛtɛ aabata wɔ; kɛpɛ sɛtɛ yɛkɛ wɔ mɛ, pɔɔ kɛlɛ sɛ ɔŋã kɛlɛ abha."<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />Otsialɛ Kain etseɖe yɛadzya Abel asɛ, "Kɔ tɛ bɔvɛ ayakpa mɛ. Kɛlɛ gɛ bakpasɛ ayakpaa mɛɛ, Kain alɔ atɔ̃ yɛadzya kɛlɛ eyii.<verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />Kidegbaa Apaleteɛ ebisi Kain asɛ, "Fakɔ wɔadzya Abel alɛ?"</para>
  <para style="p" vid="GEN 4:9">Adɛmɛ akɔɛ asɛ, "Itinyi. Mɛɛ ɛbalɛ mɛadzyaa dza?"<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />Apaleteɛ ebisi yɛasɛ, "Keɖe wɔ bhɛtɛ ana dza? Oolũa! Wɔ adzya yɛ dzosu nɔ ebi yoyo akɔmɛ denɔ tisiɛ mɛ. <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />Otsi kibuiɖɔkpɛanɔ gɛ ede tisie mɛ, gɛ adãlɛ yɛ olũgbũɔ tɛ ayɛkɛ wɔ adzya yɛ dzosuu nɔ denɔ wɔ ahɔɛ mɛ, etsi ɖi wɔ abha. <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />Onu pɛ ɔwa kesiakpaa, kazaa kɔ wɔ bɔŋãŋã. Anyɔnyɔ̃elete gɛ yɛishumɛ gɛ yɔ obodzi nɛ kesiakpa nabha."<verse eid="GEN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13" />Kain etseɖe Apaleteɛ asɛ, "Mɛ baatɔ̃pɔpɔ̃ ekpe dɛ kana gɛ ɛbala. <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />Obuɔ ɔkaka mɛ ɔshɛnɔ nɛ kesiakpa nabha, kɛlɛ ɛbakpũ denɔ wɔshu; ɛbadzi anyɔnyɔ̃elete gɛ yɛ ishumɛ gɛ yɔ nɛ kesiakpa nabha, kɛlɛ anɔnyianɔ gɛ amɔ mɛ ebe yi mɛ."<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />Pɔɔ Apaleteɛ etseɖe asɛ, "Kɛma ɛlɛ mɛ ana; onupɛ anɔnyianɔ gɛ eyi Kain, abamɔ kɛlɛ tɛbuibuia bɔtɛ tegegene nɛ kɛlɛ abha tɛtɔtɔɖɔ." Kɛlideɛ, Apaleteɛ alɔkɔ kɛwɔ̃ tɔɖɔ Kain abha tɛ anɔnyianɔ tibe yii gɛ amɔɛ. <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />Kliso Kain ashɛ nɛ Apaleteɛ ɔbha kɛlɛ adɛ zã Nɔd kesiakpa nabha.<verse eid="GEN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />Kain awɔsɔ̃ nɛ yɛedzini kɛlɛ emunu ɛya kɛlɛ amɔ Enɔki. Kibeelɛ Kain aza bhɔ ɔma hohoe teli, kɛlɛ alɔkɔ yeyi anyɛɛ Enɔki kinyeɛ akɔ ɔmaa. <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />Bamɔ Iraɖi akɔ Enɔk, kɛlɛ Iraɖi edzi aka kɔ Mehudzael, kɛlɛ Mehudzael edzi aka akɔ Lamɛk.<verse eid="GEN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 4:19" />Lamɛk agbana baadzɛ taabha, tenikpo nɔ kinyeɛ kɛlinu Aɖa kɛlɛ abhala bekuli yɛasɛ Zila. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />Aɖah amɔ Dzabal; yɛedzi aka kɔ baagɛ baazã kɛpɔtɛ agbã buvũɔ mɛ pɛ beelu baagã. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />Yɛadzya kinyeɛ kɛlinu Dzubal; yɛedzi aka akɔ baagɛ beepho dzita nɛ buxole. <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />Zila tsyɛ amɔ eyianyɛ, Tubal-Kain, gɛ aafatɛ bɔxɔɛwadɔ̃ ediedi denɔ ɔɖatɛpɛ̃ nɛ kɛklagbuɔɖa mɛ. Tubal-Kain yɛadaa nɔ yɛedzi Naama.<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />Lamɛk etseɖe yɛedzini alɛ,</para>
  <para style="q1" vid="GEN 4:23">"Aɖa nɛ Zila, nolũ mɛ kaɖɔ;</para>
  <para style="q2" vid="GEN 4:23">Lamɛk yɛedzini alɛ, nolũ mɛ ebuieɛ.</para>
  <para style="q1" vid="GEN 4:23">Iyi anyɛ teli gɛ akpɛ kɛpɔ̃ nɛ mɛishu,</para>
  <para style="q2" vid="GEN 4:23">ayĩsɔ̃ gɛ akpɛ kibi nɛ mɛishu so.<verse eid="GEN 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 4:24" />Onu pɛ babhɛtɛ kɛkpa tɔɖɔ kɛkpa abha butegegene akɔ Kain,</para>
  <para style="q2" vid="GEN 4:24">kɛlɛ kekpa bhɛbhɛtɛ tɔɖɔ kɛkpa abha afɛtegegene nɛ̀ tegegene ba babhɛtɛ tɔɖɔ akɔ Lamek."<verse eid="GEN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />Aɖam nɛ yɛedzini baza wɔsɔ̃, kɛlɛ bamɔ anyɛ kɛlɛ bakɔ yɛinye asɛ Seeti, gɛ kɛliesi kɛlinu asɛ, "Owusoso Akaa aza kɔmɛ eyi bhlatɔ akpɛ Abel ɔzãkɔ, gɛ Kain eyíí so." <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />Seeti tsyɛ amɔ anyɛ, kɛlɛ akɔ yɛinye asɛ Enɔshi.</para>
  <para style="p" vid="GEN 4:26">Kibee elɛ mɛ baanɔ akpa Apalete yɛinyeɛ kulu.<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s1">Odenɔ Aɖam ɔdɛ kpɛ nɔ Noa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />Ebui gɛ bafɔ̃nɔ nɛ Aɖam yɛihui nɔ ishuɔ nɛ alɛ.</para>
  <para style="b" vid="GEN 5:1" />
  <para style="p" vid="GEN 5:1">Gɛ Owusoso Akaa abhɛtɛ anɔdzrameɛ, abhɛtɛ yɛ nɛ Owusoso Akaa tɛzãzã mɛ. <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />Abhɛtɛ balɛ anyɛ nɛ adzɛ kɛlɛ eyula alɛ. Kɛlɛ gɛ abhɛtɛ balɛ, ekulu alɛ asɛ "anɔdzrame."<verse eid="GEN 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 5:3" />Aɖam azã nɛ ɛkpã adɛ kpɛnɔ agɔ alafa zɛzɛ̃ nɛ afɛata, amɔ eyi anyɛ, nɛ yɛ tɛzãzã mɛ, gɛeyii piapii; kɛ lɛ akɔ yɛinye asɛ Seeti. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />Seeti yɛ tɛmɔmɔ kideɛ, Aɖam azãnɛ ɛkpã agɔ alafa taasɛ̃ kɛlɛ amɔ beeyi anyɛ nɛ̀ beeyi adzɛ bhlatɔ. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />Bálɔkɔ Aɖam yɛ agɔ petee aplɛnɔ baagɔlɔɔ, azãnɛ ɛkpã agɔ alafa teezhyita nɛ afɛata, kɛlɛ ebetsí.<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />Gɛ Seeti azãnɛ ɛkpã agɔ alafa zɛzɛ nɛ teetiɛ, ebedzi Enɔshi yɛaka, Seeti azãnɛ ɛkpã agɔ alafa taasɛ nɛ̀ tegegene kɛlɛ azamɔ beeyi anyɛ nɛ̀ beeyi adzɛ bhlatɔ. <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />Kɛlɛ gɛ ebedzi aka kɔ Enɔs, Seti azã nɛ ɛkpã agɔ alafa taasɛ̃ nɛ̀ tegegene kɛlɛ azamɔ beeyi anyɛ nɛ̀ beeyi adzɛ bhlatɔ. <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />Balɔkɔ Seeti yɛ agɔ petee aplɛnɔ baagɔlɔɔ, azã nɛ ɛkpã agɔ alafa teezhyita nɛ̀ kɛfɔ nɛ taabha, kɛlɛ ebetsí.<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />Gɛ Enɔshi azanɛ ɛkpã agɔ afɛtezhyitaa, ebedzi aka kɔ Kena. <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />Kɛlidemɛ gɛ ebedzi Kena yɛaka ebekeɛ, Enɔshi azanɛ ɛkpã agɔ alafa taasɛ̃ kɛlɛ azamɔ beeyi anyɛ nɛ̀ beeyi adzɛ bhlatɔ. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />Balɔkɔ Enɔshi yɛagɔ petee aplɛnɔ baagɔlɔɔ, azãnɛ ɛkpã agɔ alafa teezhyita nɛ̀ teeti, kɛlɛ ebetsí.<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />Gɛ Kena aŋã agɔ afetegegeneɛ, ebedzi Mahalalɛl yɛaka. <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />Kɛlɛ gɛ edzi aka akɔ Mahalalɛl ebekeɛ, Kena azãnɛ ɛkpã agɔ alafa taasɛ nɛ̀ afɛtaalɛ kɛlɛ azamɔ beeyi anyɛ nɛ̀ beeyi adzɛ bhlatɔ. <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />Balɔkɔ Kena yɛ agɔ petee aplɛnɔ baagɔlɔɔ, azãnɛ ɛkpã agɔ alafa teezhyita nɛ̀ kɛfɔ, kɛlɛ ebetsí.<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />Gɛ Mahalalɛl aŋã agɔ afɛteeholo nɛ̀ teetiɛ, ebedzi Dzaɖɛd yɛaka. <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />Kɛlɛ gɛ edzi aka akɔ Dzaɖɛd ebekeɛ, Mahalalɛl azãnɛ ɛkpã agɔ alafa taasɛ̃ nɛ̀ afɛata kɛlɛ azamɔ beeyi anyɛ nɛ̀ beeyi adzɛ bhlatɔ. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />Balɔkɔ Mahalɛl yɛ agɔ petee aplɛnɔ baagɔlɔɔ, azãnɛ ɛkpã agɔ alafa taasɛ̃ nɛ̀ afɛteezhyita nɛ̀ teeti, kɛlɛ ebetsí.<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />Gɛ Dzaɖɛd aŋã agɔ alafa zɛzɛ̃ nɛ̀ afɛteeholo nɛ̀ taabha, ebedzi Enɔki yɛaka. <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />Kɛlɛ gɛ edzi aka akɔ Enɔki ebekeɛ, Dzaɖɛd azãnɛ ɛkpã agɔ alafa taasɛ̃ kɛlɛ azamɔ beeyi anyɛ nɛ̀ beeyi adzɛ bhlatɔ. <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />Balɔkɔ Dzaɖɛd yɛagɔ petee aplɛnɔ baagɔlɔɔ, azãnɛ ɛkpã agɔ alafa teezhyita nɛ̀ afɛteeholo nɛ̀ taabha, kɛlɛ ebetsí.<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />Gɛ Enɔki aŋã agɔ afɛteeholo nɛ̀ teetiɛ, ebedzi Metusela yɛaka. <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />Kɛlɛ gɛ edzi aka akɔ Mɛtusela ebekeɛ, Enɔki azãnɛ ɛkpã agɔ alafa taasɛ kɛlɛ azamɔ beeyi anyɛ nɛ̀ beeyi adzɛ bhlatɔ. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />Balɔkɔ Enɔki yɛ agɔ petee aplɛnɔ baagɔlɔɔ, azãnɛ ɛkpã agɔ alafa taata nɛ̀ afɛteeholo nɛ̀ teeti. <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />Enɔki agã nɛ̀ Owusoso Akaa; kidegba agaa bazã, ɔmɔsɛ Owusoso Akaa alɔkɔɛ ashɛnɔ.<verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />Gɛ Mɛtusela aŋã agɔ alafa zɛzɛ̃ nɛ̀ afɛtaasɛ̃ nɛ̀ tegegeneɛ, ebedzi Lamɛk yɛaka. <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />Kɛlɛ gɛ edzi aka akɔ Lamɛk ebekeɛ, Mɛtusela azãnɛ ɛkpã agɔ alafa tegegene nɛ̀ taasɛ nɛ̀ taabha kɛlɛ azamɔ beeyi anyɛ nɛ beeyi adzɛ bhlatɔ. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />Balɔkɔ Mɛtusɛla yɛ agɔ petee aplɛnɔ baagɔlɔɔ, azãnɛ ɛkpã agɔ alafa teezhyita nɛ afɛteeholo nɛ teezhyita, kɛlɛ ebetsì.<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />Gɛ Lamɛk aŋã agɔ alafa zɛzɛ̃ nɛ̀ afɛtaasɛ nɛ̀ taabhaa, amɔ eyi anyɛ. <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />Akɔ yɛinye asɛ Noa kɛlɛ aɖɔ asɛ, "Yɛaba yɔ bɔlɔ kite nɛ bɔlɔ ahɔɛmɛ bɔtɔ kɛtɛkɛtɛ gɛenu kibui gɛ kɛba nɛ kibeɛ gɛ Apaleteɛ aɖɔ kibui akpɛ kesiakpaa." <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />Noa tɛmɔmɔ kideɛ, Lamɛk azãnɛ ɛkpã agɔ alafa teeti nɛ̀ afɛteezhyita nɛ̀ teeti kɛlɛ azamɔ beeyi anyɛ nɛ̀ beeyi adzɛ bhlatɔ. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />Balɔkɔ Lamɛk yɛ agɔ petee aplɛnɔ baagɔlɔɔ, azãnɛ ɛkpã agɔ alafa tegegene nɛ̀ afɛtegegene nɛ̀ tegegene, kɛlɛ ebetsí.<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />Gɛ Noa aŋã agɔ alafa teetiɛ, ebedzi Shɛm, Xam nɛ̀ Yafɛti balɛ aka.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s1">Banɔdzrame Kɛtakpumɛ Gagalĩ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />Gɛ banɔdzrameɛ tɛkakalà mɛ ewu kabha nɛ kesiakpa nabha pɛ bamɔ beyiadzɛ pɛ bekpeɛ, <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />Owusoso Akaa yɛeyialɛ amɔ asɛ badzɛɛ gɛ banɔdzrameɛ amɔɔ beyì bubite, kliso bagbana bagɛ bapɛ nɔ. <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />Kliso Apaleteɛ aɖɔ asɛ, "Mɛ ɔfɔfuiã nɔ lɔzɔkɔ zã anɔdzrame mɛ ɔvɛnɔ tihɔɔ, ɔmɔsɛ ishudza yɛete yɛenu, yɛewuiɛ abazã agɔ alafa nɛ̀ afɛtaabha."<verse eid="GEN 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 6:4" />Banɔ gɛ baɖama pɛ begbogblo bazã kesiakpa nabha nɛ kibe ɛlɛ nɛ̀ kibe kidegba mɛɛ, kibe ɛlɛ Owusoso Akaa yɛ beyianyɛ bavɛ beyiadzɛ gɛ banɔdzrame bamɔ balɛ ɔkɔ pɛ banɛ alɛ adɛmɔ beeyi. Balɛ edzì beyuta gɛ bayɛkɛ kinye, nɛ kibe kuku ɛlɛ mɛ.<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />Apaleteɛ amɔ̃ kana gɛ banɔdzrame kɛtakpumɛ gagalĩ nɛ kesiakpa nabha kiwu kabha, kɛlɛ yɛ kɛtakpu mɛ nɛ̀ kitemɛ tɛpɛpɛ dzi kibui kpa kibenyiabe. <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />Apaleteɛ abakpɛ ɔmɔpɔɛ sɛ abhɛtɛ anɔdzrame atɔɖɔ kesiakpa nabha, kɛlɛ yɛ kiteɛ mɛ bayukù nɛ̀ ɔmɔpɔɛ. <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />Kliso Apaleteɛ abaɖɔ asɛ, "Ɛbabu banɔnɔ gɛ ɛbhɛtɛ oyinɔ nɛ kesiakpa nabha-banɔdzryame nɛ̀ baagã, baagã gɛ etsì nɛ kesiakpaa nɛ̀ bɔzhyɔɛ nɔ gɛ bɔkpasɛ kɛlɛɛ nɔ mɛ-ɔmɔsɛ ɔmɔpɔɛ oyimɛ sɛ ɛbhɛtɛ alɛ." <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />Pɔ Apaleteɛ ebi Noa ashagabui.<verse eid="GEN 6:8" /></para>
  <para style="s1">Noa Yɛishu Ebui</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />Ebuiɛ gɛ Noa akpɛ awɔ̃ eluɔ naalɛ. Noa edzì anɔ dadãlɛ gɛ bagɛ mɔ kɛpɔ nanà nɛishu nɛ banɔ ɛshi nɛ yɛibeɛ, kɛlɛ azagã nɛ̀ Owusoso Akaa.<verse eid="GEN 6:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="GEN 6:10" />Beyianyɛ taata azã Noa ahɔɛ, Shɛm, Ham nɛ̀ Yafɛt.<verse eid="GEN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 6:11" />Otsi nɔ kanɔnɔ mɛ ebeku bɔtsɔ̃ nɛ Owusoso Akaa yɛamɛ, gɛ kɛtakpumɛ gagalĩ ebui azã kalɛ mɛ. <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />Owusoso Akaa amɔ kana gɛ kanɔnɔ mɛ ebeku bɔtsɔ̃, ɔmɔsɛ banɔdzrame nyɔɔ nɛ kanɔnɔ mɛ baza bhɛtɛ ebui fitifitì. <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />Kliso Owusoso Akaa etseɖe Noa asɛ, "ɛba bu banɔnɔ petee ɛkpã oyinɔ, ɔmɔsɛ kanɔnɔ nyɔɔ eyuku nɛ̀ kɛtakpumɛ gagãlĩ ebui nɛ anɔdzrame shu so. Ɛbazĩ balɛ petee nɛ̀ kesiakpa gɛ kɛtɛba tsyina. <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />Kliso bhɛtɛ aɖaka ohu, bu beevũ nɛ yɛmɛ, tɛ ɔlɔkɔ kɛmɔ̃ odeɖe yɛ mɛ nɛ̀ yɛishuɔ piapii. <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />Kana gɛ ɛpɛ ɔsɛ ɔbhɔ bɔlɛ naalɛ; Aɖaka ohuɔ tidzedze mɛ zã asɛ ɛhɔɛ alafa taalɛ nɛ̀ afɛeti, bɔlɛ tɛnɛnɛɛ mɛ tsyɛ zã ɛhɔɛ afɛtegegene nɛ̀ teeti tɛ bɔlɛ tɛɖaɖama mɛ zã ɛhɔɛ afɛtaalɛ nɛ̀ teeti. <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />Wa bɔlɛ, tɛ ɔkpɛ fɛsrɛ nɛ bɔlɛ ishu. Kpɛ opupu nɛ aɖaka ohuɔ nɛ yɛwɔã tɛ obu kesi ɔzã ɔkɔ, kishitɛbhà ɔzãkɔ nɛ̀ adamɛ ɔzãkɔ. <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />Ɛba manà budekelĩ nɛ kesiakpa nabha tɛ bɔbazĩ ɛkpã kanyiaka ɛdi gɛlɛ kitití niesi, nɛ̀ kɛdɔ kanyiaka gɛlɛ nɛkpã pɛ ɔfɔfuiã ɔkpasɛ ɛlɛ mɛ. Kɛdɔ kanyiaka gɛlɛ nɛkpã nɛ kesiakpa nabha bazĩ. <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />Pɔ ɛba bhɛtɛ mɛ olugbù nyanyã nɛ wɔ, kɛlɛ obotsoku aɖaka nɔ mɛ-wɔ nɛ̀ wɔ beyianyɛ nɛ̀ wɔedzini, ɔplɛnɔ wɔ beyianyɛ balɛ edzini alɛ. <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />Kɛlɛ ɔsɛ ɔlɔkɔ bagã gɛalɛ nɛkpã kanyiaka edi taabha, enyè nɛ̀ adzɛ tɛ bamɔ ɛkpã aplɛnɔ wɔ. <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />Bɔzhɔɛ kanyiaka taabha, agã kanyiaka edi taabha nɛ̀ kɛkanyiaka gɛetsì nɛ kesiakpa edi taabha tɛ babà wɔkɔ tɛ bamɔ ɛkpã. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />Kɛlɛ ɔsɛ ɔlɔkɔ bɔŋaŋã kanyiaka ɛdi gɛ babaŋã tsyɛ ɔbalɛ olu kɔ wɔ shu nɛ̀ balɛ."<verse eid="GEN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 6:22" />Noa abhɛtɛ kɛkanyiaka asɛ kanà gɛ Owusoso Akaa akpɛ ɔshaa ɔkɔɛ.<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s1">Budekelĩɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />Kɛlɛ Apaleteɛ etseɖe Noa asɛ, "Tsoku aɖaka nɔ mɛ, wɔ nɛ̀ wɔ bɔpaã ɔmɔsɛ ɛmɔ wɔ anɔ gɛ aabhɛtɛ kibui nɛ kɛlɛ ɔzãkɔ nɛ oboeyiɛ nɛishi. <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />Lɔkɔ agã kanyiaka gɛ yɛishu bhuiɛ balɛ tegegene, enye nɛ̀ adzɛ, nɛ̀ bagã kanyiaka gɛ balɛ ishu gɛibhuiɛ tsyɛ, enye nɛ̀ adzɛ, <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />lɔkɔ bɔzhɔɛ kanyiaka tsyɛ edi tegegene, enye nɛ̀ adzɛ tɛ balɛ idiɛ bazã nɛkpã ɔflanɔ nɛ kanɔnɔ mɛ petee. <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />Ewui tegegene edeɛ odenɔ otsiɛ nɔ, ɛba sɛsɛ subhà nɛ kesiakpa nabha gɛ abadɔ ewui afɛtaalɛ nɛ̀ elishi afɛtaalɛ, kɛlɛ ɛbabu agã kanyiaka ɛdi gɛ ɛbhɛtɛ nɛ kesiakpa nabha petee ɛkpã oyinɔ."<verse eid="GEN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 7:5" />Kɛlɛ Noa abhɛtɛ kɛkanyiaka asɛ gɛ Apaleteɛ akɔ yɛɔsha ana.<verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />Noa atɛŋã agɔ alafa teehlo nɛ kibeɛ gɛ budekelĩɛ ba kesiakpa nabha. <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />Kɛlɛ Noa nɛ̀ yɛ beyianyɛ nɛ̀ yɛedziniɛ nɛ̀ yɛ beyianyɛ balɛ edzinì alɛ betsoku aɖaka nɔ mɛ tɛ bebu balɛ ɛkpã eyinɔ nɛ budekeliɛ mɛ. <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />Bagã gɛ balɛ ishu bhui nɛ̀ bagɛ balɛ ishuɔ gɛibhui taabha, gɛenu bɔzhɔɛ nɛ̀ bagã kanyia ka ɛdi gɛetsì nɛ kesiakpa nabha, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />enyè nɛ̀ adzɛ baba Noa ɔkɔ kɛlɛ betsoku aɖaka nɔ mɛ asɛ gɛ Owusoso Akaa akɔ Noa ɔsha ana. <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />Kɛlɛ nɛ ewui tegegene edeɛ, budekelĩɛ ba kesiakpa nabha.<verse eid="GEN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11" />Nɛ Noa yɛagɔ alafa teehloɔ mɛ nɛ yɛkpã mɛɛ, nɛ woele bhalà yɛ kiwui lɔfɔ nɛ̀ tegegeneɛ nabhaa-nɛ kiwui ɛlɛ nabha beelĩɛ gɛ akpasɛ tisiɛ mɛ epú ekoeyi, kɛlɛ badãlɛ budekelĩ budulũɔ nɛ kititíɛ tsyɛ. <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />Kɛlɛ subha adɔ nɛ kesiakpa nabha ewui afɛtaalɛ nɛ̀ elishi afɛtaalɛ.<verse eid="GEN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 7:13" />Nɛ kiwui ɛlɛ nabha ɖii Noa yɛ beyianyɛ gɛenu Shɛm, Xam nɛ̀ Yafɛti, nɛ̀ yɛedziniɛ nɛ̀ yɛ beyianyɛ taata balɛ edzinì alɛ betsoku aɖaka nɔ mɛ. <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />Bayakpa mɛ baagã kanyiaka nɛ balɛ ediedi mɛ, kepi baagã kanyiaka nɛ balɛ ediedi mɛ, bagã kanyiaka ɛdi gɛ beetsì nɛ kesiakpa, nɛ̀ bɔzhɔɛ kanyiaka nɛ bɔlɛ ediedi mɛ, kɛkanyiaka gɛ bɔsɛ lɛ kɛlɛ ahɔɛ. <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />Baagã petee gɛ ɛkpã ɔfɔfuiã ɔkpasɛ alɛ mɛ edi taabha baba Noa ɔbhà kɛlɛ betsoku aɖaka nɔ mɛ. <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />Baagã ediediɛ gɛ betsokuɔ edzì enyè nɛ̀ badzɛ odenɔ baagã gɛ balɛ nɛkpã asɛ gɛ Owusoso Akaa atɔɖɔ akɔ Noa ana. Kɛlɛ Apaleteɛ adã opupuɔ akpii.<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />Nɛ ewui afɛtaalɛ mɛɛ, budekelĩɛ zikpè tɔɖɔ kesiakpa nabha, kɛlɛ gɛ buliɛ zikpe tɔɖɔɔ, bufeke aɖaka nɔ wunɔ nɛ kesiakpa nabha. <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />Buliɛ ebekpè kɛlɛ buyukù nɛ kesiakpa nabha, kɛlɛ aɖaka nɔ alɔasra nɛ budekelĩ nabha. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />Budekelĩɛ ebeyukù esiakpa nabha, kɛlɛ beetu ɖaɖama petee gɛ balɛ kitití niesiɛ bayala eku. <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />Beeliɛ ebeyukù adã beetúɔ gɛ tidzudzuɔ mɛ bakpè ɔdɛ bɔtsɛkpɔ afɛtaabha. <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />Agã kanyiaka ɛdi gɛazã nɛkpã nɛ kesiakpa nabha ɛkpã bakoeyì-bɔzhɔɛ nɔ, kepi baagã, ayakpa mɛ baagã, baagã petee gɛazã azaamɛ nɛ kesiakpa nabha, nɛ̀ banɔdzrameɛ petee etsí. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />Kɛdɔ kanyiaka ɛdi gɛzã kesiakpa kpakpaa nabha pɛ kɛlɛ ɛkpã ɔfɔfuiã nɔ okoeyi odenɔ balɛ kɛnyɔtɔ mɛɛ betsí. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />Agã kanyiaka ɛdi gɛ azã kesiakpa nabhaa ebetsí, banɔdzrame nɛ̀ baagaã nɛ̀ baagã gɛetsì nɛ kesiakpa nabha nɛ̀ bɔzhɔɛ nɔ gɛ kpasɛ kɛlɛɛ nɔ mɛ betsí nɛ kesiakpa nabha. Noa nɛ̀ bagɛ bazã yɛɔbha nɛ aɖaka nɔ mɛ yɛete balɛ atɔ.<verse eid="GEN 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 7:24" />Budekeliɛ zã kesiakpa nabha yɛanà ewui alafa zɛzɛ nɛ̀ afɛeti.<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />Pɔ Owusoso Akaa abakà Noa nɛ̀ ayakpamɛ baagã nɛ̀ kepi bagã gɛazã yɛɔbha nɛ aɖaka nɔ mɛ nɛibui, kɛlɛ asɛsɛ kɛlɛɛ nɛ kesiakpa nabha kɛlɛ bulĩkekpuɔ batsì. <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />Otsi tisi mɛ bulĩɛ nɛ̀ kitití budekelĩ budulũɔ ulũ badã, kɛlɛ subha ayɔlɔ tɛdɔdɔ odenɔ kɛlɛɛ nɔ mɛ. <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />Kɛbɔɛbɔɛ bulĩɛ batsì nɛ kesiakpa nabha. Nɛ ewui alafa zɛzɛ nɛ̀ afɛeti edeɛ, buliɛ bazhyi kesi, <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />kɛlɛ nɛ kiwui gegenemiɛ nɛ woele gegenemiɛ nabhaa, aɖaka nɔ abadɔ Aɖaɖat beetu nabha. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />Bulĩɛ odenɔ titsitsì abha ɔvɛnɔ woele lɔfɔ mɛ, kɛlɛ nɛ kiwuiɛ gɛiputɔ nɛ woele lɔfɔ mɛɛ, bakpà beetu nabha mɔ.<verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />Nɛ ewui afɛtaalɛ edeɛ, Noa adalɛ fɛsrɛ nɔ gɛ ebu nɛ aɖaka nɔ shuɔ <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />kɛlɛ ebu kipleke asɛsɛ, kɛlɛ ezepruru pɛ avɛ pɛ aba ɔvɛnɔ ɔsɛ gɛ bulĩɛ batsì nɛ kesiakpa nabha. <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />Kɛlɛ sɛsɛ abronimɛ tɛ̀ etì asɛ bulĩɛ titsì beke nɛ kesiakpa nabha dza. <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />Pɔ gɛ abronimɛ nɔ agɛmɔ ɔkɔ nanà tɛ̀ edzu yɛtsɛɖɛ, ɔmɔsɛ bulĩɛ yukù kesiakpa petee abha, klisoɔ etsyina aba Noa ɔkɔ nɛ aɖaka nɔ mɛ. Akpɛ yɛɔhɔɛ asɛsɛ pɛ anyanà abronimɛ nɔ kɛlɛ edzinì yɛ amanà yɛɔbhà nɛ aɖaka ohu nɔ mɛ. <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />Noa azã epo ewui tegegene aplɛnɔ, kɛlɛ aza sɛsɛ abronimɛ nɔ odenɔ aɖaka nɔ mɛ. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />Gɛ abronimɛ nɔ etsyina aba yɛɔkɔ nɛ ɔwlagoɔ mɛɛ, bɔbɔ busi kɛwɔlakpa gɛ bapɔ̃ avɔvɔɔ azã yɛolugbùɔ mɛ! Ɛkɛlɛ Noa ebetì asɛ buliɛ titsì beke nɛ kesiakpa nabha. <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />Azã epo ewui tegegene aplɛnɔ kɛlɛ ewuli aza sɛsɛ abronimɛ nɔ, pɔ kibelɛ xɔnɔɔ egetsyina aba yɛɔkɔ.<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />Nɛ kiwuiɛ gɛiputɔ nɛ woele nɔ gɛeputɔ nɛ Noa yɛagɔ alafa teehlo nɛ̀ toliɛ nabhaa, buliɛ tsì nɛ kesiakpa nabha. Kɛlɛ Noa akpà bɔdɔɔ̃ gɛ alɔkɔ edere aɖaka ohuɔ mɛɛ ɛkɛlɛ yɛamɔ asɛ kesiakpa nabha atɛ kpaá. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />Nɛ woele bhalaa yɛ ewui afɛtaabha nɛ̀ tegegene nabhaa, kesiakpa petee abha aba kpaá.<verse eid="GEN 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15" />Kidegbaa, Owusoso Akaa etseɖe Noa asɛ, <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />"Koeyì nɛ aɖaka ohuɔ mɛ, wɔ nɛ̀ woedzini, wɔ beyianyɛ nɛ̀ balɛ edzini alɛ. <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />Bu ɛkpã baagã kanyiaka gɛ alɛ wɔbha oyinɔ-bɔzhɔɛ nɔ, baagã nɛ̀ baagã petee gɛetsì nɛ kesiakpa nabha-sɛ tɛ beyuku nɛ kesiakpa nabha tɛ bamɔ be eyi tɛ bekpè atɔɖɔ."<verse eid="GEN 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 8:18" />Kliso Noa ebekoeyì aplɛnɔ yɛedziniɛ nɛ̀ yɛ beyianyɛ nɛ̀ balɛ edzini alɛ. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />Baagã petee nɛ̀ baagã gɛetsì nɛ kesiakpa nabha nɛ̀ bɔzhɔɛ nɔ tsyɛ petee-kɛkanyiaka gɛ kɛɛgã nɛ kesiakpa nabha-koeyì nɛ aɖaka ohuɔ mɛ, nɛ balɛ ediedi mɛ.<verse eid="GEN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />Kɛlɛ Noa abhɔ bɔdɔ̃ pɔpɔɛ osubha akɔ Apaleteɛ, kɛlɛ gɛ alɔkɔ baagã nɛ̀ bɔzhɔɛ nɔ gɛ balɛ ishu bhuiɛɛ, abhɛtɛ bɔdɔ̃ pɔpɔɛ nɛ osubha nabha. <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />Apaleteɛ elukũ tɛlɔlɔ̃ huhuhuɔ kɛlɛ aɖɔ nɛ yɛ kitúɔ mɛ asɛ: "Kɛza baɛlɛ mɛ oɖi ɔsɛ ɛbaɖɔ kibui ɔkpɛ kesiakpa oɖi nɛ anɔdzrame ɛtakpu, gɛ yɛ kitemɛ tɛtɔtɔɖɔ kɛkanyiaka kinu kibui zizĩ odenɔ yɛinuvɔbe xɔnɔ pɔ. Kɛlɛɛ ɛzaka bu baagã petee gɛ alɛ nɛkpã balɛ ɛkpã oyinɔ oɖi, asɛ gɛ ɛbhɛtɛ ana.<verse eid="GEN 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 8:22" />"Gɛ kesiakpa anyã lɛ koɔ,</para>
  <para style="q1" vid="GEN 8:22">kɛdɔ̃ɛ ɖabe nɛ̀ kɛdɔ̃ ɛpɔ̃ kibe,</para>
  <para style="q1" vid="GEN 8:22">tɛyɔyɔ nɛ̀ kɛkpɛkpɛ,</para>
  <para style="q1" vid="GEN 8:22">ekpé nɛ̀ ekukù,</para>
  <para style="q1" vid="GEN 8:22">kelizaza nɛ̀ elishi</para>
  <para style="q1" vid="GEN 8:22">batɛ bazɔkɔ yɔlɔ eɖi."<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s1">Owusoso Akaa Olugbù Nyanya nɛ̀ Noa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />Kidegbaa, Owusoso Akaa eyulà atɔɖɔ akɔ Noa nɛ̀ yɛ beyianyɛ pɛ etseɖe alɛ asɛ: "Nɔmɔ beeyi tɛ nokpe tɔɖɔ tɛ noyukù kesiakpa nabha. <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />Kifù sisi bazã kesiakpa bagãhoeɛ mɛ nɛ wɔnɔ ishu, bɔzhɔɛ nɔ gɛ kpasɛ kɛlɛɛ nɔ mɛ petee, baagã nyɔ̃ɔ gɛetsì nɛ kesiakpa, nɛ̀ akpàa nɔ gɛ lakpasɛ kelikekpuɔ mɛ; ɛlɔkɔ kpɛ wɔnɔ ahɔɛ. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />Kɛkanyiaka gɛ lɛ nɛ̀ ɛkpã pɛ kɛhuanà ishuɔ bedzì kɛŋaŋã akɔ wɔnɔ. Aasɛ kanà gɛ ɛlɔkɔ tɛwa wɔwɔ kɔ wɔnɔɔ, otsiɛ nɔ ɛlɔkɔ kɛkanyiaka kɔ wɔnɔ.<verse eid="GEN 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 9:4" />"Pɔ kɛma sɛ nɔŋã kɛdzya gɛ ɛkpã dzyosu akakpasɛ ɛlɛ mɛɛ. <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />Kɛlɛ kɔ wɔnɔ̃ ɛkpã dzyosu nɔ shuɔ ɛba bisi akɔnta gɛ titsyitsyina ma. Ɛbà bisi akɔnta odenɔ agã kanyiaka gɛ abalɛ̀ anɔdzrame dzyosu ɔkɔ. Kanake ɛba bisi akɔnta odenɔ anɔdzrame ɔkɔ nɛ yɛɔhagbo anɔdzrame ɛkpã dzyosu shu.<verse eid="GEN 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 9:6" />"Anɔnyianɔ gɛ abalɛ̀ anɔdzrame dzosu nɔ,</para>
  <para style="q2" vid="GEN 9:6">anɔdzrame yɛebebu yɛayɛ tsyɛ;</para>
  <para style="q1" vid="GEN 9:6">ɔmɔsɛ Owusoso Akaa tɛzazã mɛɛ,</para>
  <para style="q2" vid="GEN 9:6">Owusoso Akaa abhɛtɛ anɔdzrame.<verse eid="GEN 9:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="GEN 9:7" />Wɔnɔ pɔ, nɔmɔ beeyì tɛ wɔnɔ tɛkakalà mɛ kpe tɔɖɔ; nɔmɔ̃ tɔɖɔ nɛ kesiakpa nabha tɛ nokpe nɛ kalɛ abha."<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />Kidegbaa, Owusoso Akaa etseɖe Noa nɛ̀ yɛ beyianyɛ gɛazã yɛɔbha asɛ: <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />"Otsialɛ ɛbhɛtɛ mɛ olugbù nyanyã nɛ̀ wɔnɔ nɛ̀ wɔnɔ bɔmɔɔ gɛ baba nɛ̀ wɔnɔ kihui nɔ <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />nɛ̀ ɛkpã agã kanyiaka gɛazã wɔnɔ ɔbha-bɔzhɔɛ nɔ, kepi baagã, nɛ̀ ayakpa mɛ ayɛ tsyɛ petee, baagã alɛ petee gɛ bekoeyi aplɛnɔ wɔnɔ nɛ aɖaka ohuɔ mɛ-agã kanyiaka gɛ alɛ nɛkpã nɛ kesiakpa nabha. <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />Ɛbhɛtɛ mɛ olugbù nyanyã ɔlɛ nɛ wɔnɔ asɛ; kɛzakà ba ɛlɛ mɛ oɖi ɔsɛ bebè bhui ɛkpã petee abha ɔganà budekelĩ yiyí mɛ; kɛza baɛlɛ mɛ oɖi ɔsɛ budekeli bazĩ kesiakpa."<verse eid="GEN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 9:12" />Kɛlɛ Owusoso akaa aɖɔ asɛ, "Kibui ɛlɛ kɛlɛinu kɛwɔ̃ ɔkɔ olugbù nyanyã gɛ ɛɛbhɛtɛ̀ nɛ mɛ nɛ̀ wɔnɔ nɛ̀ agã kanyiaka gɛ alɛ wɔnɔ ɔbha, olugbù nyanyã ɔkɔ wɔnɔ bɔmɔ̃ɔ petee gɛ babaa. <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />Ɛtɛkpɛ mɛ enegeɛ nɛ ɔmɔlɔɔ̃ nɔ mɛ̀, kɛlɛ badzì kɛwɔ̃ ɔkɔ olugbù nyanyã nɛ mɛ nɛ̀ kesiakpa nɛishi. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />Kibenyiabe gɛ ɛmanà ɔmɔlɔ̃ nɛ kesiakpa nadamɛ pɛ enegeɛ ekoeyì nɛ ɔmɔlɔ̃ nɔ mɛɛ, <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />ɛbà bakà mɛ olugbù nyanyã gɛɔkpasɛ mɛ nɛ̀ wɔnɔ kishiɛ nɛ̀ bagaã ediediɛ petee gɛalɛ nɛkpaã. Kɛzakà baɛlɛ mɛ oɖi ɔsɛ bulĩ batsyina edzì budekelĩ pɛ bɔbazĩ ɛkpã nyɔ̃ɔ. <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />Kibenyiabe gɛ enegeɛ ekoeyi nɛ ɔmɔlɔ̃ nɔ mɛɛ, ɛbà mɔ yɛ, pɛ ɛba bakà olugbù nyanyã tihɔɔ nɔ gɛɔlɛ mɛ Owusoso Akaa nɛ̀ baagã ediediɛ petee gɛ alɛ nɛkpã nɛ kesiakpa nabha nɛishi."<verse eid="GEN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 9:17" />Kliso Owusoso Akaa etseɖe Noa asɛ, "Olugbũɔ gɛ nyã nɛ mɛ nɛ̀ ɛkpaã petee ishi nɛ kesiakpa nabha kɛlɛinu kɛwɔ̃ ɛlɛ gɛidzu esi."<verse eid="GEN 9:17" /></para>
  <para style="s1">Noa Yɛ Beyianyɛ</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />Noa yɛ beyianyɛ gɛ bekoeyì nɛ aɖaka ohuɔ mɛ balɛenu, Shɛm, Xam nɛ̀ Yafɛti. (Xam yɛedzì aka akɔ Kana.) <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />Banɔ alɛ balɛ edzì Noa yɛ beyianyɛ taata, kɛlɛ ɔgana balɛ abhaa banɔnɔ nyɔ̃ɔ gɛ bapɔ̃ɛ akanà nɛ kesiakpa nabha bede ekoeyi.<verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />Noa, anyɛ gɛedzì ayadɛ, avɛ ɛlɛ abha adɛ wuain bɔyà. <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />Gɛ awɔ̃ɛ yɛɔyà mɛ wuain teliɛ, abadɔ bunù gɛ awɔsɔ̃ yɛ kɛpɔtɛ kagbaa mɛ gɛ azã zhyoliaa. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />Xam gɛedzì Kana yɛaka, amɔ̃ yɛaka yɛ zhyoliaa mɛ kɛlɛ editseɖe yɛadza alɛ taabha gɛeli ɔtɔɔ̃. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />Pɔ Shɛm nɛ̀ Yafɛti xɔnɔ badɛ lɔkɔ kɛpɔtɛ atɔɖɔ balɛ owũdɔ pɛ bagã kideedè pɛ balɔkɔ ekumù balɛ aka zhyoliaa nɔ abha. Betsyina balɛ amɛ akpɛ kɛwɔã ɔsɛ tɛ batɛmɔ balɛ aka zhyoliaa.<verse eid="GEN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 9:24" />Gɛ Noa anyɛmɛ odenɔ yɛ bunù dɔdɔɔ mɛ pɛ ebetì kɛgɛ yɛeyianyɛ bhala abhɛtɛ yɛishuɔ, <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />aɖɔ asɛ,</para>
  <para style="q1" vid="GEN 9:25">"Baɖɔ kibui akpɛ wɔ Kana!</para>
  <para style="q2" vid="GEN 9:25">Banɔ dzidzi balɛ ebhului bhului nɔ</para>
  <para style="q2" vid="GEN 9:25">yɛebedzi ɔkɔ yɛadzya alɛ."<verse eid="GEN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 9:26" />Azaɖɔ tsyɛ asɛ,</para>
  <para style="q1" vid="GEN 9:26">"Beyulà atɔɖɔ akɔ Apaleteɛ, Shɛm yɛ Owusoso Akaa!</para>
  <para style="q2" vid="GEN 9:26">Tɛ Kana edzì anɔ dzidzì akɔ Shɛm.<verse eid="GEN 9:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 9:27" />Tɛ̀ Owusoso Akaa akɔ Yafɛti kɛkɔtɔ mɛ anɛ atɔɖɔ;</para>
  <para style="q2" vid="GEN 9:27">tɛ̀ Yafɛti azã Shɛm yɛ kɛpɔtɛ bɔgbaa mɛ,</para>
  <para style="q2" vid="GEN 9:27">kɛlɛ tɛ̀ Kana edzì yɛanɔ dzidzì."<verse eid="GEN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />Nɛ budekelĩ niedeɛ, Noa azazã nɛkpã agɔ alafa taata nɛ̀ afɛeti. <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />Balɔkɔ yɛagɔ petee ɔplɛnɔ bagɔlɔɔ, Noa azã nɛkpã agɔ alafa teezhyita nɛ̀ afɛeti, kɛlɛ ebe tsí.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s1">Amadiɛ Tɛkakalà</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />Kibuiɛ gɛ baɖɔ nɛ Shɛm, Xam nɛ̀ Yafɛti gɛenu Noa yɛ beyianyɛ gɛ balɛ tsyɛ bamɔ́ beyianyɛ nɛ budekelĩ niedeɛ shuɔ naalɛ.<verse eid="GEN 10:1" /></para>
  <para style="s2">Yafɛti Yɛihui nɔ</para>
  <para style="li1">
    <verse number="2" style="v" sid="GEN 10:2" />Yafɛti yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 10:2">Goma, Magɔg, Madai, Yavan, Tubal, Mɛshɛk nɛ̀ Tiɖas.<verse eid="GEN 10:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="GEN 10:3" />Goma yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 10:3">Askɛnaz, Ripat, nɛ̀ Togama.<verse eid="GEN 10:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="GEN 10:4" />Yavan yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 10:4">Elisa, Tashis, Kitimeyiɛ nɛ̀ Roɖanieyi. <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />(Ɔganà banɔ alɛ abha kelĩshu azazã anɔnɔ bayɛɛ eku balɛ kɛma ediedi nɛ̀ balɛ egbogbo egbogbo mɛ nɛ balɛ amadiɛ mɛ, bakanyiaka nɛ̀ balɛ buluhũ.)<verse eid="GEN 10:5" /></para>
  <para style="s2">Xamɛt Yɛihui nɔ</para>
  <para style="li1">
    <verse number="6" style="v" sid="GEN 10:6" />Xam yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 10:6">Kus, Misraim, Put nɛ̀ Kana.<verse eid="GEN 10:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="GEN 10:7" />Kus yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 10:7">Sɛba, Xavila, Sabta, Raama nɛ̀ Sabtɛka</para>
  <para style="li1" vid="GEN 10:7">Rama yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 10:7">Sɛba nɛ̀ Ɖedan.<verse eid="GEN 10:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="GEN 10:8" />Kus yɛedzì aka akɔ Nimrɔɖ, gɛ eshè pɛ ebedzì eyuta gɛ gbagbala ɔzã yɛahɔɛ nɛ kesiakpa nabha. <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />Edzì abhɛbhɛ gbagbla nɛ Apaleteɛ amɛ; kliso pɛ baɖɔ asɛ, "Asɛ Nimrɔɖ, abhɛbhɛ gbagbla nɛ Apaleteɛ amɛ." <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />Yɛ bukusiɔŋãkɔ ɛzãkɔ gɛiputɔ ɛlɛ inu, Babilonia, Eɖɛk, Akaɖ, nɛ̀ Kalnɛ nɛ Sina. <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />Odenɔ kesiakpa alɛ abha yɛalɔ avɛ Asiria, ɛkɛlɛ gɛ edidzù Ninɛvɛ, Rehobot Ir, Kala <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />nɛ̀ Rɛsɛn, gɛ akpasɛ Ninɛvɛ nɛ̀ Kala ishiɛ: ɔmã gbagbla naalɛ.<verse eid="GEN 10:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="GEN 10:13" />Mizraim yɛedzi aka akɔ Luɖɛanɛ, Anamɛanɛ, Lexabɛanɛ, Naftuanɛ,<verse eid="GEN 10:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="GEN 10:14" />Patrusɛanɛ, Kasluanɛ, (gɛ yɛ mɛ Filistɛanɛ ede ekoeyiɛ) nɛ̀ Kaftoɖɛanɛ.<verse eid="GEN 10:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="GEN 10:15" />Kana yɛedzì aka akɔ Sidɔn yɛeyianyɛ gɛ eputɔ, gɛede Xivɛanɛ,<verse eid="GEN 10:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="GEN 10:16" />Yebusɛanɛ, Amorɛanɛ, Girgasɛanɛ <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />Xavɛanɛ, Arkɛanɛ, Sinɛanɛ, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />Arvadanɛ, Zemaɖɔɖɛanɛ nɛ̀ Xamatɛanɛ.</para>
  <para style="b" vid="GEN 10:18" />
  <para style="p" vid="GEN 10:18">Kidegbaa, Kana egbogboɔ bapɔɛ akana <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />kɛlɛ Kana bubuɔ edenɔ Siɖɔn ɔvɛnɔ Geɖa ɔvɛnɔ odzololo ɔkɔ asɛ Gaza, kɛlɛ avɛnɔ Sodom, Gomoɖa, Aɖma, nɛ̀ Zɛbɔim, ɔdɛ kpɛnɔ Lasa fãa.<verse eid="GEN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 10:20" />Banɔ alɛ balɛenu Xam yɛ beyianyɛ nɛ balɛ egbogboɔ nɛ̀ balɛ beluhũɔ mɛ, nɛ balɛ kɛkɔtɔ nɛ̀ balɛ amadiɛ mɛ.<verse eid="GEN 10:20" /></para>
  <para style="s2">Sɛmɛanɛ</para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />Bamɔ bɛeyianyɛ akɔ Sɛm tsyɛ, gɛ yɛadza shesheɛ yɛedzì Yafɛti; Sɛm yɛedzì ashuĩ akɔ Ɛba yɛ beyianyɛ alɛ nyɔ̃ɔ.<verse eid="GEN 10:21" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="22" style="v" sid="GEN 10:22" />Sɛm yɛ beyianyɛ balɛenu;</para>
  <para style="li2" vid="GEN 10:22">Elam, Asha, Afaxaɖ, Luɖ nɛ̀ Aram.<verse eid="GEN 10:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 10:23" />Aram yɛ beyianyɛ balɛenu:</para>
  <para style="li2" vid="GEN 10:23">Uz, Xul, Gɛta nɛ̀ Mɛshɛk.<verse eid="GEN 10:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 10:24" />Afaxaɖ edzì aka akɔ Shɛla,</para>
  <para style="li2" vid="GEN 10:24">kɛlɛ Shɛla edzì aka akɔ Ɛba.<verse eid="GEN 10:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 10:25" />Bamɔ beyianyɛ taabha akɔ Ɛba; Bakɔ tenikpo kinye asɛ Pɛlɛg, ɔmɔsɛ nɛ yɛibeɛ baya kesiakpa mɛ akpɛ bɔwɔ̃pɛ taabhà; bakɔ yɛadzya nɛinye asɛ Yɔktani.<verse eid="GEN 10:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 10:26" />Yɔktani edzì aka akɔ Almoɖaɖ, Shɛlɛp, Xazamavɛti, Yɛra,<verse eid="GEN 10:26" /></para>
  <para style="li2">
    <verse number="27" style="v" sid="GEN 10:27" />Xoɖoam, Uzal, Diklah, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />Obal, Abimaɛl, Shɛba, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />Ɔfɛ, Xavila, nɛ̀ Yɔbab. Banɔ alɛ petee bedzì Yɔktani yɛ beyianyɛ.<verse eid="GEN 10:29" /></para>
  <para style="b" />
  <para style="m">
    <verse number="30" style="v" sid="GEN 10:30" />Kɛkɔtɔ mɛ gɛ bazã edzè edenɔ Mɛsha avɛnɔ ɔdɛtɔ̃ Sɛfar, nɛ kiwuiɛ otukɔɔ nɛ ketukpɔ kɛmadiɛ mɛ.<verse eid="GEN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 10:31" />Banɔ alɛ balɛenu Sɛm yɛ beyianyɛ nɛ balɛ egbogbo nɛ̀ beluhũɔ mɛ, nɛ balɛ kɛkɔtɔ nɛ̀ amadiɛ mɛ.<verse eid="GEN 10:31" /></para>
  <para style="b" />
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32" />Banɔ alɛ balɛenu Noa yɛ beyianyɛ ɔganà balɛ kihui nɔ nɛ balɛ amadiɛ mɛ. Ɔganà banɔ alɛ nabha amadiɛ ayɛɛ nɛ kesiakpa nabha nɛ budekelĩ niede.<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s1">Kititíuvũ Dzudzu nɛ Babel</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />Nɛ kibe ɛlɛ, buluhũ tenikpo, nɛ̀ kaɖɔɖɔ tenikpo idi kalɛ azã kanɔmɛ anɛ nyɔ̃ɔ ahɔɛ. <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />Gɛ baanɔ betu pɛ bavɛ kiwiɛ otukɔ ɛbeɛ, bedi ku kadadasi tieli abha nɛ Shina, kɛlɛ batsɛ nɛ ɛkɛlɛ.<verse eid="GEN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 11:3" />Betseɖe bagɔlɔ asɛ, "Nɔba tɛ bubhuĩ tisi tɛ bɔpɔɛ lɛ piapii." Kliso nɛ kɛglagbu inye mɛɛ, balɔkɔ aŋɔ anyana tisi bhubhui pɔpɔɛ plɛnɔ bagɔlɔ. <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />Kɛlidemɛɛ betseɖe bagɔlɔ asɛ, "Nɔba tɛ bubhuĩ ɔma gbagbla kɔ bɔlɔ ishu, nɛ̀ kititiuvũ gɛ bɔɖama dɛtɔ̃ owusoso nɔ, tɛ bɔbhɛtɛ kinye kɔ bɔlɔ ishu tɛ bɔtɛ pɔ̃ɛ kanà nɛ kanɔnɔ mɛ."<verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />Pɔ Apaleteɛ ezhyi aba esi tɛ ebeɖi ɔma gbagbla nɛ̀ kititiuvũ ɖaɖama gɛ babhɔ. <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />Apaleteɛ aɖɔ asɛ, "Onupɛ benu kidi tenikpo pɛ behu buluhũ tenikpo pɛ bakpɛ kibui lɛ niesiɛ, kɛlɛɛ kibui nana ma gɛ bapɛ asɛ abhɛtɛ pɛ batɛ bala. <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />Kliso nɔkɔ bɔvɛ tɛ bufutsù balɛ buluhũɔ mɛ tɛ betilũ bagɔlɔ esi."<verse eid="GEN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 11:8" />Kliso Apaleteɛ apɔɛ balɛ mɛ akanà kpɛ kesiakpa petee abha, kɛlɛ bayɔlɔ ɔma gbagbla tɛbhɔbhɔ. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />Klisoɔ bakɔ ɛkɛlɛ nɛinye asɛ Babel- ɔmɔsɛ ɛkɛlɛ Apaleteɛ efutsù kanɔnɔ buluhũɔ mɛ. Odenɔ ɛkɛlɛ Apaleteɛ apɔɛ balɛmɛ akana kpɛ kanɔnɔ mɛ petee.<verse eid="GEN 11:9" /></para>
  <para style="s1">Denɔ Shem Ɔvɛnɔ Abram</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />Shem yɛishui ebui naalɛ.</para>
  <para style="b" vid="GEN 11:10" />
  <para style="p" vid="GEN 11:10">Agɔ taabha nɛ budekelĩ yiyí nɛideɛ, gɛ Shem aŋã agɔ akpã zɛzɛɛ̃, amɔ Afaxaɖ. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />Kɛlɛ gɛ amɔ́ Afaxaɖ bekeɛ, Shem azazã nɛkpã agɔ akpã teeti kɛlɛ amɔ beyianyɛ nɛ̀ beyiadzɛ̃ bhlatɔ.<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />Gɛ afaxad azã nɛkpã agɔ afɛata nɛ̀ teetieɛ, amɔ́ Shɛla. <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />Kɛlɛ gɛ amɔ́ Shɛla ebekeɛ, Afaxaɖ azazã nɛkpã agɔ akpã taalɛ̃ nɛ̀ taata kɛlɛ azamɔ́ beyianyɛ nɛ̀ beyiadzɛ bhlatɔ.<verse eid="GEN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14" />Gɛ Shɛla aŋã agɔ afɛataa, amɔ́ Eba. <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />Kɛlɛ gɛ amɔ́ Eba ebekeɛ, Shɛla azazã nɛkpã agɔ akpã taalɛ̃ nɛ̀ taata kɛlɛ azamɔ́ beyianyɛ nɛ̀ beyiadzɛ bhlatɔ.<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />Gɛ Eba azã nɛ ɛkpã agɔ afɛtaata nɛ taalɛɛ̃, ebedzi aka kɔ Pɛlɛg. <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />Kɛlɛ gɛ amɔ́ Pɛlɛg ebekeɛ, Eba azazã nɛkpã agɔ akpã taalɛ̃ nɛ̀ afɛatata kɛlɛ azamɔ́ beyianyɛ nɛ̀ beyiadzɛ bhlatɔ.<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />Gɛ Pɛlɛg azã nɛkpã agɔ afɛata, amɔ́ Reu. <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />Kɛlɛ gɛ amɔ́ Reu ebekeɛ, Peleg azazã nɛkpã agɔ akpã taabha nɛ̀ teezhyita kɛlɛ azamɔ́ beyianyɛ nɛ̀ beyiadzɛ bhlatɔ.<verse eid="GEN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20" />Gɛ Reu azã nɛ ɛkpã agɔ afɛata nɛ̀ taabhaa, ebedzi aka akɔ Sɛɖug. <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />Kɛlɛ gɛ amɔ́ Sɛɖug ebekeɛ, Reu azazã nɛkpã agɔ akpã taabha nɛ̀ tegegene kɛlɛ azamɔ́ beyianyɛ nɛ beyiadzɛ bhlatɔ.<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />Gɛ Sɛɖug azã nɛkpã agɔ afɛata, amɔ́ Nahɔ. <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />Kɛlɛ gɛ amɔ́ Nahɔ ebekeɛ, Reu azazã nɛkpã agɔ akpã taabha kɛlɛ azamɔ́ beyianyɛ nɛ̀ beyiadzɛ bhlatɔ.<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />Gɛ Nahɔ azã nɛkpã agɔ afɛtaabha nɛ̀ teezhyitaa, amɔ́ Tɛɖa. <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />Kɛlɛ gɛ amɔ́ Tɛɖa ebekeɛ, Nahɔ azazã nɛkpã agɔ kɛkpã zɛzɛ̃, kɛfɔ nɛ̀ teezhyita kɛlɛ azamɔ́ beyianyɛ nɛ̀ beyiadzɛ bhlatɔ.<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />Gɛ Tɛɖa aŋã agɔ afɛtegegeneɛ, amɔ́ Abram, Nahɔ nɛ̀ Xaɖan.<verse eid="GEN 11:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />Tɛɖa yɛishu ebuiɛ naalɛ.</para>
  <para style="b" vid="GEN 11:27" />
  <para style="p" vid="GEN 11:27">Tɛɖa amɔ́ Abram, Nahɔ nɛ̀ Xaɖan. Kɛlɛ Xaɖan amɔ́ Lɔt. <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />Nɛ kibeɛ mɛ gɛ Xaran yɛaka Tɛɖa akalɛ nɛkpaã, Xaɖan etsí nɛ Ul nɛ Kaldeanɛ kesiakpa mɛ gɛ bamɔɛ nabha. <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />Abram nɛ̀ Nahɔ bagbana adzɛ. Abram yeɛdzini yɛinyeɛ kɛlɛ idzì Sarai, kɛlɛ Nahɔ yeɛdzini yɛinyiɛ kɛlɛ idzì Milka gɛ yɛakaa yɛedzi Xaɖan, gɛedzì aka akɔ Milka nɛ Yiska. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />Otsinɔ bɔmɔ̃ gɛzã Sarai shu nɛ kibe ɛlɛ mɛ soɔ; agɛ mɔ eyi nanà.<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />Tɛra alɔkɔ yɛeyianyɛ Abram, yɛeshui Lɔt gɛedzi Xaɖan yeyianyɛ, nɛ̀ yɛeyiɖidze Sarai, ɔplɛnɔ Abram yɛedziniɛ kɛlɛ balɛ petee betu odenɔ Ul nɛ Kaldea kesiakpa nabha pɛ bavɛ Kana. Pɔ gɛ beku Xaɖaniɛ, bebhuĩ kazã nɛ ɛkɛlɛ.<verse eid="GEN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 11:32" />Pɛlɛg azã nɛkpã agɔ akpã taabha nɛ̀ teeti, kɛlɛ etsí nɛ Xaɖan.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s1">Abram yɛ Tikukulu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />Apaleteɛ aɖɔ etseɖe Abram asɛ, "Tu ɔshɛ nɛ wɔ kesiakpa nabha, wɔeshopo alɛ nɛ̀ wɔakaa bɔpãmɛanɛ ɔbha tɛ ɔvɛ kesiakpa gɛ ɛbakasɛ wɔ nabha.<verse eid="GEN 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 12:2" />"Ɛbabhɛtɛ wɔ kɛmadi gbagbla</para>
  <para style="q2" vid="GEN 12:2">kɛlɛ ɛbayula wɔ;</para>
  <para style="q1" vid="GEN 12:2">Ɛbabhɛtɛ wɔ kinyeɛ tɛ kidzì kinye gbagbla,</para>
  <para style="q2" vid="GEN 12:2">kɛlɛ obodzi anɔ gɛ beyula.<verse eid="GEN 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 12:3" />Ɛba yula akɔ bagɛ eyula akɔ wɔ,</para>
  <para style="q2" vid="GEN 12:3">kɛlɛ anɔ̃ gɛ aɖɔ kibui akpɛ wɔɔ, ɛbaɖɔ kibui ɔkpɛ yɛ;</para>
  <para style="q1" vid="GEN 12:3">kɛlɛ banɔnɔ nyɔ̃ɔ nɛ kesiakpa nabha</para>
  <para style="q2" vid="GEN 12:3">bebe yula akɔ alɛ ɔgana wɔabha."<verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />Kliso Abram etu ashɛ asɛ kana gɛ Apaleteɛ etseɖe yɛ; kɛlɛ Lɔt tsyɛ avɛ aplɛnii. Abram atɛŋã agɔ afɛtegegene nɛ̀ teeti nɛ kibeɛ gɛ etu ashɛ nɛ Xaran. <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />Alɔkɔ yɛedzini Sarai, yɛadzyaeyi Lɔt, ɔplɛnɔ balɛ ahɔɛmɛɔdɔ̃ nɛ̀ baxɔ̃ɛdɛ gɛ amɔ̃ nɛ Xaran, kɛlɛ batɔnɔ Kana kesiakpa nɛidzo kɛlɛ bediku ɛkɛlɛ.<verse eid="GEN 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 12:6" />Abram agã kidzo afala nɛ kesiakpa mɛ ɔdɛkpɛnɔ ɛkɛlɛ gɛ Mɔɔrɛ busi gbagbala azã nɛ Shekɛm. Nɛ kibe ɛlɛ Kananɛ azã kesiakpa mɛ. <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />Apaleteɛ ebu yɛishu akasɛ Abram pɛ aɖɔ asɛ, "Wɔeyialɛ mɛbalɔkɔ kesiakpa alɛ kɔ." Kliso abhɔ bɔdɔ̃pɔpɔɛ osubha akɔ apaleteɛ nɛ ɛkɛlɛ.<verse eid="GEN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 12:8" />Denɔ ɛkɛlɛ, azagã ewu avɛ betuɔ mɛ nɛ Bɛtɛl yɛ kiwiɛotukɔ ɛbe kɛlɛ edzu yɛ kɛpɔtɛagba, gɛ Bɛtɛl azã kɛwɔ̃aa gɛvɛ kiwiɛ ɔdɔkɔ kɛlɛ Ai azã kɛwɔ̃aa gɛvɛ kiwiɛ otukɔ. Abhɔ bɔdɔ̃pɔpɔɛ osubha akɔ Apaleteɛ nɛ ɛkɛlɛ kɛlɛ akpɛ ketakpuesi kɔ Apaleteɛ. <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />Kidegbaa, Abram alɔ pɛ avɛ kidzogagã nabha ɔvɛnɔ oxuinɔ gɛɔvɛ kesiakpa kalɛ kesi ɔkɔ.<verse eid="GEN 12:9" /></para>
  <para style="s1">Abram avɛ Egipte</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />Otsinɔ bɔbhɛ badɔ nɛ kesiakpa nabha, kɛlɛ Abram etú ezhyi avɛ Egipte tɛ adɛzã ɛkɛlɛ kɛbɔɛ ɔmɔsɛ bɔbhɛ dɔdɔ nulũ gagalĩ. <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />Kibeɛ gɛ ebeku Egipteɛ, etseɖe yɛedzini Sarai asɛ, "Inyi adzɛ gɛeyi bubite nɔnɔ ɛdi gɛonu. <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />Onupɛ Egipteanɛ amɔ wɔɔ, babaɖɔ asɛ, 'Yɛedzini na alɛ.' Kɛlɛ́ɛ bebèyi mɛ pɔ babakɔ wɔ xɔnɔ ɔzã nɛkpã. <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />Ɖɔsɛ mɛadaa woɔnu, tɛ babhɛtɛ mɛ piapii nɛ wɔɛtakpu tɛ mɛ zã nɛkpã nɛ wɔɛtakpu.<verse eid="GEN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 12:14" />Gɛ beku Egipteɛ, Egipteanɛ amɔsɛ Sarai enu adzɛ gɛeyi bubite piapii. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />Kɛlɛ gɛ Farao yɛanɔ sheshèɛ amɔ Sarai, badɛ ɖɔ ebui gbangbã nɛishu etseɖe Farao, kɛlɛ bagbana yɛavɛnɔ yɛ ekusiupã mɛ. <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />Abhɛtɛ Abram piapii nɛ adzɛ nɛtakpu, kɛlɛ Abram amɔ ibhoshi, banɛtsyɔ̃ɛ, badikunye nɛ̀ badikudzɛ, badzɛ axɔɛdɛ, ɔplɛnɔ kipoasɔ akɔ yeishu.<verse eid="GEN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17" />Pɔ Apaleteɛ akɔ banyã kpà Farao nɛ̀ yɛɔpãmɛanɛ nabha adɔ nɛ Abram yɛedzini Sarai kɛtakpu. <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />Kliso Farao ekulu Abram amana yɛamɛ. Ebisiɛ yɛasɛ, "Kiɖe wɔ bhɛtɛ nɛ mɛishu ana?" "Kiɖeso pɛ ogi tseɖe mɛ ɔsɛ wɔedzini yɛenuɔ dza?" <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />Kiɖeso pɛ ɔɖɔsɛ, 'Mɛadaa yɛenu,' pɛ ɛlɔkɔɛ pɛ edzi mɛedzini dza? Kliso otsie nɔ, ɔmɔ wɔedzini. Gbana yɛ tɛ ɔshɛ!" <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />Kidegbaa, Farao akɔ yɛaxɔɛdɛ ɔsha nɛ Abram ishu, kɛlɛ bakpɛ yɛidzo yɛashɛ ɔplɛnɔ yɛedzini nɛ̀ kɛkanyiaka gɛ amɔ kɔ yɛishu nɛ ɛkɛlɛ.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s1">Abram nɛ̀ Lɔt Bebu Ɔtɔ Nɛ Bagɔlɔ Shu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />Kliso Abram alɔ nɛ Egipte nɛ Nɛgɛv ɔbha nɛ̀ yɛedzini nɛ̀ kɛkanyiaka gɛlɛ yɛahɔɛ, kɛlɛ Lɔt tsyɛ atɔnɔ yɛ. <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />Abram edzi ehoeyielete kibelɛ nɛ bagãlulu nɛ sikãfufu nɛ sikãdzadzã mɛ.<verse eid="GEN 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 13:3" />Odenɔ Nɛgɛveɛ, akana vɛ ɔkɔ tenikpo vɛnɔ ɔkɔ bhlatɔ ɔdɛ ɔkpɛnɔ gɛ ediku Bɛtɛl, nɛ ɔkɔtoli gɛɔzã Bɛtɛl nɛ̀ Ai kishiɛ, nɛ ɛkɛlɛ gɛ yɛ kɛpɔtɛ kagba azã abafala nɔ <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />nɛ ɛkɛlɛɛ gɛ abhɔ yɛ bɔdɔ̃pɔpɔɛ osubha gɛeputɔ. Ɛkɛlɛ Abram akpɛ ketakpuesi akɔ Apaleteɛ.<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />Otsinɔ baagã nɛ̀ kɛpɔtɛ bɔgba zã Lɔt tsyɛ ahɔɛ, gɛ azagã afla nɛ̀ Abram. <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />Pɔ kesiakpa nabha gɛ bazã aplɛnɔ bagɔlɔ nɛ̀ balɛ baagã egikpe kɔ balɛ taabha agaã kplumuɔ gɛ azã balɛ ahɔɛ kliso batika la gã nɛ̀ bagɔlɔ. <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />Kɛlɛ ebela ebeku Abram yɛ baagã agbagbana ɛleteɛ nɛ̀ Lɔt yayɛ nɛishi. Kananɛ nɛ̀ Perizaianɛ bazã kesiakpa nabha kibe ɛlɛ.<verse eid="GEN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8" />Kliso Abram etseɖe Lɔt asɛ, "Kɔ bɔyɔlɔ ebela galɛ bɔlɛishiɛ nɛ̀ bɔlɔ baagã gbagbana elete nɛishi ɔmɔsɛ bunu baadzya. <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />Sɛ kesiakpa petee alɛ wotugba? Kɔ bubu ɔtɔ nɛ baagɔlɔ shu. Ɔvɛ keŋaã mɛ ɛbavɛ kɛblɛkpɛ nɔ mɛ; ɔvɛ kɛblɛkpɛ nɔ mɛ, ebavɛ kɛŋaã mɛ."<verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />Lɔt ebu bamɛ ewunɔ kabha kɛlɛ amɔ Zoa ɔmã, kɛlɛ amɔ̃ asɛ bulĩ yuku Yɔɖan kadadasi kesiakpa petee mɛ piapii, asɛ Apaleteɛ bɔkã alo kesiakpa nɛ Egipte. (Kibe ɛlɛ ba fala flogo pɛ bezĩ Sodom nɛ̀ Gomoɖa.) <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />Kliso Lɔt ayɛkɛ Yɔɖan kɛdadaasiɛ petee gɛibu bamɛ vɛ kiwiɛ otukɔɛ be akɔ yɛeishu. Klisoɔ baadzya taabha bebu ɔtɔ nɛ bagɔlɔ shu. <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />Abram azã Kana kesiakpa nabha, kɛlɛ Lɔt tsyɛ azã kadadasiɛ ɛma gbagbla mɛ kɛlɛ edzu yɛ bɔgba nɛ Soɖom ɔbha. <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />Otsi Soɖom anɛ balɛ kɛtakpu mɛ gagãlĩ kɛlɛ ebuikpa ete baza bhɛtɛ nɛ Apaleteɛ ishu.<verse eid="GEN 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />Apaleteɛ aɖɔ etseɖe Abram nɛ Lɔt yɛ tɛshɛshɛ kideɛ asɛ, "Bu wɔ bamɛ owunɔ kabha tɛ oɖi bɔpiabha nɛ̀ bɔpialɛ, kiwiɛ otukɔ nɛ̀ kiwiɛ odɔkɔ odenɔ ɛkɛlɛ gɛ ɔlɛ. <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />Kesiakpa petee gɛ ɔɔmɔ, ɛba lɔkɔ kɔ wɔ nɛ wɔ kihui nɔ tihɔɔ. <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />Ɛba bhɛtɛ wɔ kihui nɔ asɛ kesiakpa osubhududu kliso onupɛ anɔ teli aba la osubududu nɔ akla, kɛlɛ babala wɔ kihui nɔ akla. <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />Gavɛ, gã fala nɛ kesiakpa mɛ odenɔ adaã mɛ ɔvɛnɔ kesiɛ tɛ odenɔ kɛwaã ɔvɛnɔ kɛwã, gɛ ɛbalɔkɔ kɔ wɔ."<verse eid="GEN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 13:18" />Abram àkpa yɛ kagba kɛlɛ avɛ adɛzã beesi gbagbla gɛazã Mamrɛ ɔbha nɛ Xɛbron, ɛkɛlɛ yɛabhɔ bɔdɔ̃pɔpɔɛ osubha kɔ Apaleteɛ.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s1">Abram Ebhui Lɔt Ebu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />Nɛ kibe ɛlɛ Amrafɛl gɛenu ekusi kɔ Shina, Ariok ekusi kɔ Elasa, Kɛdɔlaoma ekusi kɔ Elam nɛ̀ Tidal ekusi kɔ Gɔim <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />bavɛ adɛ ta keyu nɛ Bera, gɛenu ekusi kɔ Adma, Shemɛba ekusi kɔ Zebɔim, nɛ̀ ekusi kɔ Bela (gɛenu Zoa). <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />Bekusi gɔgɔ̃ɛ babhɛtɛ tenikpo nɛ Sidim (gɛenu bɔmɔɛ kelĩkekpuɔ) kɛdadasiɛ mɛ. <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />Agɔ lɔfɔ nɛ̀ taabha mɛɛ, bakpɛ kɛtakpuesi akɔ Kɛdɔlaoma pɔɔ nɛ kɛgɔ lɔfɔ nɛ̀ taata mɛɛ, balɔ kititi nɛ yɛishu.<verse eid="GEN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 14:5" />Nɛ kɛgɔ lɔfɔ nɛ̀ taalɛ̃ mɛ, Kɛdɔlaoma nɛ̀ bekusiɛ gɛenu belée akɔɛ avɛ keyu kɛlɛ baŋã Refaitianɛ, Zuzaitianɛ nɛ Xam, Emaitianɛ nɛ Shavɛ Kiriatam <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />nɛ Xoraitanɛ nɛ Sɛya, butú ɔmaa ɛmɛ, dɛ ɔkpɛnɔ Ɛl Paran nɛ oxuiɛ ɔbha. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />Kidegba betsyina avɛ En Mishpat (gɛenu Kaɖɛsh), kɛlɛ beté Amalekianɛ nɛ̀ Amorianɛ gɛ bazã Xazazin Tamar.<verse eid="GEN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8" />Kɛlɛ Sodom ekusiɛ, Gomoɖa ekusiɛ, Adma ekusie, Zebɔim ekusiɛ nɛ̀ Bela (gɛenu Zoa) ekusiɛ batsà ɔhà ekoeyi kɛlɛ bakpɛ keyu tatá esi nɛ̀ Sidim kɛdada mɛ <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />nɛ̀ Kɛdɔlaoma gɛenu Elam ekusiɛ, Tidal gɛenu Gɔim ekusiɛ, Amrafɛl gɛenu Shina ekusiɛ nɛ̀ Ariɔk gɛenu Elasa ekusiɛ-bekusi taalɛ̃ balɔkɔ keyu nɛ bekusi teeti shu. <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />Otsinɔ aŋɔzĩ zã Siddim kɛdada mɛ gbĩ, kliso gɛ Sodom nɛ̀ Gomoɖa bekusiɛ ebu tɛtsɛɖɛ mɛɛ, balɛ beyuta teli adɛ tsɛku ɛlɛ mɛ kɛlɛ bagɔgɔ̃ɛ nɔ ebu tɛtsɛɖɛ mɛ avɛ beetu nabha. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />Bekusi taalɛ̃ ayɛkɛ balɛ ahɔɛ mɛ bɔdɔ̃ nɛ̀ balɛ bɔŋaŋãa nɛ tɛgagalĩ mɛ; kɛlɛ bashɛ̃. <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />Baza gbana Abram yɛadzya eyiɛ pɛ bayɛkɛ yɛahɔɛ mɛ bɔdɔ̃ tsyɛ nɛ yɛahɔɛ ashɛ̃nɔ ɔmɔsɛ azã Sodom nɛ kibe ɛlɛ mɛ.<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />Kidegba anɔ tenikpo teli gɛebu tɛtsɛɖɛ mɛ edikpũ pɛ ashɛ̃ nɛ keyuɔ mɛɛ, abaɖɔ kibui ɛlɛ etseɖe Abram gɛenu, Hebrieyie. Kibe ɛlɛ mɛ Abram azã Mamrɛ beesi gbagbla Amorieyi ɔbha gɛenu Eshkɔl nɛ̀ Ana balɛ adzya, gɛenu ɛbhià akɔ Abram. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />Gɛ Abram ebelũ asɛ bevũ yɛadzya ɛyiɛ, ekulu beeyuta alafa taata nɛ̀ kɛfɔ nɛ̀ taasɛ̃ gɛ bamɔ́ nɛ yɛɔpãa mɛɛ, kɛlɛ bakpatɔnɔ alɛ ɔdɔkpɛ nɔ Dan. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />Nɛ elishiɛ mɛɛ, Abram ama yɛ beyuta ɔsɛ tɛ badɛtsyɔa kitelũ naalɛ, kɛlɛ bete alɛ, kɛlɛ bakpa tɔnɔ alɛ ɔdɛ kpɛnɔ Xoba, nɛ Damaskus kiwiɛ otukɔ. <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />Etsodzi amɔ yɛɔdɔ petee gɛ balɔkɔ kɛlɛ agbana yɛelĩeyiɛ Lot, nɛ̀ baadzɛ nɛ̀ baanɔ bhlatɔ amana kepi.<verse eid="GEN 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />Gɛ Abram etsyina aba nɛ kibeɛ gɛ adɛŋã Kɛdɔlaoma nɛ yɛ bekusi gɛenu bagɛ akpɛ abhalà akɔɛ nɔ, Sodom ekusiɛ abatsyana yɛ nɛ Shavɛ kɛdada mɛ (gɛenu ekusiɛ yɛ kɛdada mɛ).<verse eid="GEN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 14:18" />Kidegba Salɛm ekusie Mɛlkizɛdɛk amana abolo nɛ̀ bunu. Yɛedzi akpukpudzi akɔ Owusoso Akaa galɛ Kititíɛayɛ Fãa, <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />kɛlɛ eyula akɔ Abram, pɛ aɖɔ asɛ,</para>
  <para style="q1" vid="GEN 14:19">"Owusoso Akaa, Kititíɛayɛ Fãa nɔ eyula kɔ Abram,</para>
  <para style="q2" vid="GEN 14:19">Agɛ yɛabhɛtɛ kititi nɛ̀ kesiakpa.<verse eid="GEN 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 14:20" />Kɛlɛ bebeyula akɔ Owusoso Akaa Kititíɛayɛ Fãa nɔ,</para>
  <para style="q2" vid="GEN 14:20">agɛ alɔkɔ bagɛ atɛ adɛmɛ nɛ wɔ kpɛ wɔ ahɔɛ mɛ."</para>
  <para style="m" vid="GEN 14:20">Kɛlɛɛ Abram alɔkɔ yɛahɔɛ mɛ bɔdɔ̃ kanyiaka bɔlɛ kɛfɔ mɛ akɔɛ.<verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />Sodom ekusiɛ aɖɔ etseɖe Abram asɛ, "Lɔkɔ banɔdzrameɛ ɔkɔmɛ tɛ ɔlɔkɔ bɔdɔ̃ɔ kɔ ishu."<verse eid="GEN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22" />Pɔ Abram aɖɔ etseɖe Sodom ekusiɛ asɛ, "Ɛkpɛ ahɔɛ nɛ kititíɛ kɔ Apalete Akaa Kititíɛayɛ Fãa nɔ, gɛebu kititíɛ nɛ̀ kesiakpa, kɛlɛ ɛtanaɛ <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />sɛ ɛtɛba yɛkɛ kɛdɔ kanyiaka gɛenu wɔɛyɛ, wɔ oɖoti ohui pɛnɔsɛ wɔ ɔtsɛɖɛkɔlɔ ohui, tɛ ɔbɔɖɔ ɔsɛ, 'Mɛ bhɛtɛ Abram ehoeyi elete.' <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />Ɛtɛba yɛkɛ kɛdɔ̃ nyia kɛdɔ̃ dɛ bɔdɔ̃ɔ gɛ mɛ beyuta baŋã nɛ̀ baanɔnɔ gɛ bavɛ keyuɔ mɛ aplɛnɛ mɛ ɔŋãkɔ-bɔvɛ kɔ Ana, Eshkɔl nɛ Mamrɛ. Kɔ bamɔ balɛ ɔŋãkɔ.<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s1">Owusoso Akaa Olugbũ Nyanyã nɛ̀ Abram</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />Kɛlideɛ, Apalete ibuiɛ ba kɔ Abram nɛ bɔlalà mɛ ebuibubu kasɛ:</para>
  <para style="q1" vid="GEN 15:1">"Kifu ti yi wɔ, Abram.</para>
  <para style="q2" vid="GEN 15:1">Mɛinu wɔ ɔɖaɛtɛ̃,</para>
  <para style="q2" vid="GEN 15:1">wɔ kɛbhɛ babuia gbagbla."<verse eid="GEN 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2" />Pɔɔ Abram aɖɔ asɛ, "O, Ekusi Apalete, kiɖe wɔbɔ kɔmɛ gɛ eyi ama mɛahɔɛ kɛlɛ anunɔ gɛ ebedzi mɛ aŋãsie yɛenu Elieza gɛ ede Damaskɔs?" <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />Kɛlɛ Abram aɖɔ asɛ, "Ɔgɛ kɔ mɛ eyi nana; kliso mɛaxɔ̃ɛdɛ bedzi mɛ kaŋãsiɛ."<verse eid="GEN 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />Kidegba Apalete kibuiɛ ba kɔyɛ asɛ: "Anyɛ alɛ etibedzi wɔ kaŋãsiɛ, pɔ eyianyɛ ebede wɔ mɛ gɛebedzi wɔ kaŋãsiɛ. <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />Agbanaɛ yɛ avɛnɔ ɔtɔ̃ɔ kɛlɛ aɖɔ asɛ, "Ɖi kititíɛ tɛ ɔkala awɔ̃ɛ-onupɛ ɔbɔla alɛ ɔkala." Kelideɛ, etseɖe yɛasɛ, "Kana wɔ eyialɛ ebe kpe."<verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />Abram ayɛkɛ Apaleteɛ nabha ŋã, kliso alɔkɔ kɛlɛ akɔɛ asɛ kibui dadalɛ yɛabhɛtɛ.<verse eid="GEN 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7" />Etseɖee tsyɛ asɛ, "Mɛinu Apaleteɛ gɛebu wɔnɔ denɔ Ul nɛ Kaldeanɛ kesiakpa mɛ tɛ ɛ́balɔkɔ kesiakpa alɛ kɔwɔ tɛ edzi wɔayɛ."<verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />Pɔ Abram aɖɔ asɛ, "O Apalete Ohumielete, kɛlɛ mɛbati sɛ ɛba yɛkɛ kesiakpa alɛ?"<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />Kliso Apaleteɛ aɖɔ etseɖe yɛ asɛ, "Lɔkɔ nɛtsyɔɛyi, epidzya nɛ̀ obhoshinye, gɛ bayɛkɛ agɔ taata, plɛnɔ abronimɛeyi nɛ kɛkpakpoeyi."<verse eid="GEN 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 15:10" />Abram alɔkɔ bɔdɔ̃ petee amana yɛ, ebhũi baagã mɛ tabha tabha kɛlɛ elu baagã bhubhũi mɛ nɛ bagɔlɔ ɔbha pɔ egibhũi bɔzhyɔɛ nɔ mɛ. <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />Kidegba bɔzhyɔɛ gɛ bɔtã bɔdzya bábadɔ bagã tsitsi nabha, pɔ Abram ákaka balɛ ashɛ̃ nɔ.<verse eid="GEN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12" />Gɛ kiwiɛ kɛɛdɔɔ, Abram avɛnɔ taɖamɛ, kɛlɛ otumũ vĩĩ oku nɛ yɛabha. <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />Kidegba Apaleteɛ etseɖe yɛasɛ, "Ɛkɔ oti sɛ woeyialɛ ebedzi befù nɛ ɔma toli gɛ lotinu balɛ ɔyɛ mɛ, kɛlɛ baba lɔkɔ balɛ asɛ banɔ dzidzi kɛlɛ babakpɛ alɛ bɔtɔ agɔ akpã taalɛ̃. <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />Pɔ ɛbapɔ̃ batɔ̃ kɔ kɛmadiɛ gɛ babhɛtɛ alɛ asɛ banɔ dzidzi ana, kɛlɛ kidegbaa, bebè koeyi nɛ banɔesizazã mɛ kɛlɛ babashɛ nɛ balɛahwɛ mɛ bɔdɔ̃ gele. <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />Wɔ xɔnɔ ɔbɔ vɛ wɔ akaalɛ kepi nɛ ishu yɔyɔ mɛ kɛlɛ baba vɔbɔ wɔ nɛ wɔ tisheshè mɛ. <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />Nɛ bɔmɔ lɛlɛ̃ mɛ woeyialɛ ebetsodzi aba ɛkɛlɛ, ɔmɔsɛ Amorianɛ ebuikpa bhɛbhɛtɛ ekeku alɛ okukɔ.<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />Onupɛ kiwiɛ dɔ bekeɛ pɛ otumũ okuɔ, kitsikpi gɛ kifu ekoeyi nɛ kɛlɛ mɛ bagã bɔdzya bhubhui nɛishi. <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />Odenɔ kiwui ɛlɛ Apaleteɛ anyã olugbù nɛ̀ Abram kɛlɛ aɖɔ etseɖe yɛasɛ, "Eba lɔkɔ kesiakpa alɛ, odenɔ Egipte kelĩ gbagbla ɔdɛkpɛnɔ Yufratis kelĩ gbagbla ishu- <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />Kenaianɛ, Kenizianɛ, Kaɖmonianɛ, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />Xitianɛ, Perizaianɛ, Refaianɛ, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />Amorianɛ, Kanaianɛ, Gigashianɛ nɛ̀ Dzebusianɛ balɛ kesiakpa."<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s1">Haga nɛ̀ Ishmael</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />Otsinɔ, Sarai gɛenu Abram yɛedziniɛ agɛ mɔ̃ eyi nanà akɔɛ. Pɔ Egipte adzɛ axɔɛdɛ teli azã yɛahɔɛ gɛ beze kulu yɛasɛ Haga; <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />kliso etseɖe Abram asɛ, "Apaleteɛ agɛkɔ mɛ beeyí mɛmɔ̃. Vɛ tɛ, ɔdɛwɔsɔ̃ nɛ̀ mɛ adzɛ axɔɛdɛ; ɔdɛtsyɛ ɛbamɔ̃ kishopo ɔganà yɛabha." Abram tsyɛ adɛmɛ atɔɖɔ kibuiɛ gɛ Sarai aɖɔ nabha.<verse eid="GEN 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 16:3" />Klisoɔ nɛ Abram Kana tɛzazã nɛ kɛgɔ lɔfɔ mɛɛ, Sarai gɛenu yɛedziniɛ alɔkɔ yɛ Egipte adzɛ axɔɛdɛ gɛenu Haga akɔ yɛenyineɛ ɔsɛ tɛ edzì yɛedzinì. <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />Awɔsɔ̃ nɛ̀ Haga, kɛlɛ emunù ɛya.</para>
  <para style="p" vid="GEN 16:4">Gɛ amɔ̃ asɛ emunu ɛya ebekeɛ, akpà olugbù dzu nɛ̀ yɛapãlĩɛ. <verse eid="GEN 16:4" /><verse number="5" style="v" sid="GEN 16:5" />Kɛlɛ Sarai etseɖe Abram asɛ, "Wɔkɔ mɛ ɛtɔ bɔtɔ ɔlɛ. Ɛlɔkɔ mɛaxɔɛdɛ kpɛ wɔagbã mɛ, kɛlɛ otsiɛ gɛ etì asɛ emunù ɛya, akpà mɛ tɛɛlu kesi. Apaleteɛ yɛ ebebu bɔtsyɔa alɛ nɛ mɛ nɛ̀ wɔɛshi."<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />Abram aɖɔ asɛ, "Wɔ ahɔɛ mɛ waxɔɛdɛ akpasɛ, bhɛtɛ kɛgɛ pɛ̃ kɔwɔ ɔdɛ ɔsɛ ɔbhɛtɛ nɛ yɛɛ." Kɛlɛ mɛ Sarai awɔà Haga yɛ ɔnyɔnyɔ̃ɔ; klisoɔ ebu tɛtsɛɖɛmɛ ashɛ nɛ yɛɔbhà.<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />Apaleteɛ yɛaxɔɛdɛ adɛmɔ̃ Haga nɛ bulĩ tuli gɛ bude koeyi nɛ tisi mɛ nɛ oxuiɛ mɛ shu; kenu bulĩ tuli gɛili kidzoɔ gɛ vɛ Shur nɛwɔ̃a. <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />Kɛlɛ aɖɔ asɛ, "Haga, Sarai yɛaxɔɛdɛ, fakɔ wɔode, kɛlɛ fakɔ wɔɔvɛ?" Ebuiliulũ asɛ, "Iibu tɛtsɛɖɛmɛ ɔshɛ nɛ mɛapãlĩ Sarai tɛhɔɛ mɛ."<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />Kɛlɛ Apaleteɛ yɛaxɔɛdɛ etseɖe yɛasɛ, "Tsyina ɔvɛ wɔapãlĩɛ ɔkɔ tɛ odi zhyinì wɔ ishu esi akɔɛ." <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />Kɛlɛ Apaleteɛ axɔɛdɛ aɖɔ aplɛnɔ asɛ, "Ɛbàkɔ wɔeyi mɔmɔ alɛ ekpè atɔɖɔ gɛ tɛkakalà mɛ tɛbazã balɛ ishu."<verse eid="GEN 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 16:11" />Apaleteɛ yɛaxɔɛdɛ azaɖɔ aplɛnɔ asɛ:</para>
  <para style="q1" vid="GEN 16:11">Eyi alɛ wɔshu otsiɛ</para>
  <para style="q2" vid="GEN 16:11">kɛlɛ ɔbɔmɔ̃ eyianyɛ.</para>
  <para style="q1" vid="GEN 16:11">Tɛ ɔkɔ yɛinye ɔsɛ Ishmael,</para>
  <para style="q2" vid="GEN 16:11">ɔmɔsɛ Apaleteɛ elũ wɔ ɔwɔnyɔnɔ̃.<verse eid="GEN 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 16:12" />Ebedzi anyɛ asɛ ayakpamɛ adiku ana;</para>
  <para style="q2" vid="GEN 16:12">yɛɔhɔɛ ɔbɔpá nɛ anɔ kanyiaka shu</para>
  <para style="q2" vid="GEN 16:12">kɛlɛ akanyia ka ɔyɛ tsyɛ ɔbɔpà nɛ yɛishu,</para>
  <para style="q1" vid="GEN 16:12">abazã nɛkpã nɛ kitití lɔlɔ mɛ</para>
  <para style="q2" vid="GEN 16:12">nɛ yɛadzya alɛ ishu."<verse eid="GEN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />Yɛalɔkɔ kinye ɛlɛ akɔ Apaleteɛ gɛ aɖɔaɖɔ nɛ yɛɛ: "Wɔonu Owusoso Akaa gɛ ɔɔmɔ̃ mɛ," ɔmɔsɛ yɛaɖɔ asɛ, "Otsialɛ ɛmɔ agɛ yɛamɔ mɛ." <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />Kliso pɛ bekulu bulĩ ozĩɛ ɔlɛ asɛ, Biɛɛ Laxai Rɔi; lɔkɔ lɛ ɛkɛlɛ, nɛ Kadɛsh nɛ̀ Bɛrɛɖ kishiɛɛ.<verse eid="GEN 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15" />Klisoɔ, Haga abamɔ eyianyɛ akɔ Abram, kɛlɛ Abram alɔkɔ kinye Ishmael akɔ eyianyɛ gɛ amɔ̃. <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />Abram atɛŋã agɔ afɛtaasɛ nɛ̀ teehlo nɛ kibeɛ gɛ Haga amɔ́ Ishmael akɔɛ.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s1">Bɔnyɛnyɛ Tibhuibhui Olugbù Nyanyã</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />Gɛ Abram aŋã agɔ afɛtezhyita nɛ̀ tezhyitaa, Apaleteɛ ebu yɛishu akasii pɛ etseɖe yɛasɛ, "Mɛinu Owusoso Akaa Ohumi nyɔ̃ɔ elete; gã nɛ mɛamɛ tɛ kɛpɔ bubu tɛzã wɔ ishu. <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />Ɛba tɔɖɔ ahɔɛ nɛ olugbù nyanyã gɛ ɔkpasɛ mɛ nɛ wɔɛshi nabha, kɛlɛ ɛbakɔ wɔ tɛkakalà mɛ ekpe tɔɖɔ."<verse eid="GEN 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 17:3" />Abram akpɛ bamɛ niesi, kɛlɛ Owusoso Akaa etseɖe yɛasɛ, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />"Mɛ xɔnɔ, mɛ olugbù nyanyã nɛ wɔ naalɛ: Obodzì akaa akɔ amadi gelee. <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />Bezeke ekulu wɔ asɛ Abram; wɔɛnyeɛ badzì Abraham, ɔmɔsɛ ɛbhɛtɛ wɔ akaa akɔ amadi gelee. <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />Ɛbakɔ sɛ oyù eyuyu; ɛbabu amadi odenɔ wɔ mɛ, kɛlɛ beekusi ebede ekoeyi nɛ wɔ mɛ. <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />Ɛba bhɛtɛ mɛ olugbù nyanyã gɛoti bobele oɖi nɛ mɛ, wɔ nɛ̀ wɔ kihui nɔ nɛ wɔɛdeɛ akɔ bɔmɔɔ babaa, sɛ tɛ mɛidzì wɔ Owusoso Akaa nɛ̀ wɔɛhui nɔ gɛ babà nɛ wɔɛdeɛ balɛ Owusoso Akaa. <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />Kana kesiakpa petee, gɛ kalɛ abha wɔonù efù otsiɛ nɔ, ɛbalɔkɔ kalɛ kɔwɔ nɛ̀ wɔ kihui nɔ gɛababà nɛ wɔɛdeɛ tihɔɔ, kɛlɛ ɛbadzì balɛ Owusoso Akaa."<verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />Kɛlɛ mɛ Owusoso Akaa etseɖe Abraham asɛ, "Wɔ xɔnɔ̃, kɛlɛ ɔsɛ tɛ ɔnyanã mɛ olugbù nyanyã mɛ ovunũ, wɔ nɛ̀ wɔɛhui nɔ gɛ ababà nɛ wɔɛdeɛ akɔ bɔmɔɔ gɛ babaa. <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />Mɛ olugbù nyanyã nɛ wɔ nɛ̀ wɔɛhui nɔ gɛ babaa naalɛ, olugbù nyanyã gɛ kɛlɛ ɔsɛ nɔbhɛtɛ; Bebhui bɔnyɛnyɛ akɔ anɔnyɛ kanyiaka nɛ wɔnɔ ɛshi. <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />Kɛlɛ ɔsɛ nɔgã bɔnyɛnyɛ bhuibhui mɛ, kɛlɛ badzi olugbù nyanyã kɛwɔ̃ɔ nɛ mɛ nɛ̀ wɔɛshi. <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />Nɛ bɔmɔɔ̃ gɛbaba, bebhui bɔnyɛnyɛ akɔ anyɛ kanyiaka gɛ aŋã ewui taasɛ nɛ wɔnɔɛshi, bagɛ bamɔ́ nɛ wɔ bɔpãmɛ, pɛnɔsɛ pɛ bedzii nɛ̀ ehoeyi odenɔ efù ɔkɔ-bagɛ etinu wɔ eyimɔmɔ alɛ. <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />Onupɛ wɔpamɛ bamɔ́ alɛ pɛnɔsɛ balɔkɔ wɔ ehoeyi edzi alɛ tsyɛelo, kɛlɛ ɔsɛ bebhui bɔnyɛnyɛ akɔ balɛ. Kɛlɛ ɔsɛ mɛ olugbù nyanyã nɛ wɔ ishupiɛ dzi olugbù nyanyã tihɔɔ. <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />Anyɛ nɔnɔ gɛ begi bhui bɔnyɛnyɛ akɔɛ, pɛ begibhui bɔnyɛnyɛ akɔɛ nɛ ishudzya mɛ, bebèbu yɛɔtɔ nɛ yɛeshopo alɛ nɛishi; eboele mɛ olugbù nyanyã."<verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />Owusoso Akaa ewuli etseɖe Abraham asɛ, "Wɔedzinì Sarai xɔnɔ, ɔzɔkɔ okulu yɛɔsɛ Sarai, yɛinyeɛ badzi Sara. <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />Ɛbà yulà tɔɖɔ kɔɛ kɛlɛ ɛbakɔ wɔ eyianyɛ ɔganà yɛabha gɛ kɛtɛ batsyina. Ɛbà yula akɔɛ sɛ tɛ ebedzì elĩ akɔ amadiɛ; banɔ balɛ bekusi ebede koeyi nɛ yɛ mɛ."<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />Abraham atsɛ bamɛ akpɛ kesi; amɔɛmɔɛ kɛlɛ aɖɔ etseɖe yɛishu asɛ, "Bazabà mɔ eyianyɛ akɔ anɔnyɛ gɛ atɛŋã agɔ kɛkpã zɛzɛ dza? Sara azabamɔ̃ eyi gɛ atɛŋã agɔ afɛtezhyita dza?" <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />Kɛlɛ Abraham etseɖe Owusoso Akaa asɛ, "Onupɛ Ishmael abazã wɔ tiyuyulà esi xɔnɔ!"<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />Kɛlɛ mɛ Owusoso Akaa aɖɔ asɛ, "Ee, pɔ wɔedzini Sara abamɔ eyianyɛ akɔwɔ, tɛ okulu yɛɔsɛ Isak. Ɛba bhɛtɛ mɛ olugbù nyanyã nɛ yɛ gɛ ebedzì olugbù nyanyã tihɔɔ akɔ yɛ kihui nɔ gɛababà nɛ yɛedeɛ. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />Kɛlɛ Ishmael xɔnɔ, ilũ wuɛbuiɛ, ɛbà yulà kɔɛ gɛ kɛtaba tsyina; ɛbakɔ yɛeyu eyuyu gɛ ɛbakɔ yɛ tɛkakala mɛ kpe tɔɖɔ. Ebedzi akaa akɔ bekusi lɔfɔ nɛ̀ taabha, kɛlɛ ɛbà kɔ yɛebedzì kɛmadi hohoe. <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />Pɔ mɛ olugbù nyanyã, ɛbabhɛtɛ nɛ̀ Isak, gɛ Sara abamɔ akɔ wɔ kɛgɔana kibe ɛlɛ mɛ." <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />Gɛ aɖɔ kaɖɔ ebekeɛ nɛ̀ Abraham, Owusoso Akaa ashɛ ewu kabha nɛ yɛɔbhà.<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />Kiwui ɛlɛ nabha tsiɔ̃ Abraham alɔkɔ yɛeyianyɛ Ishmael nɛ̀ bagɛ bamɔ́ nɛ yɛɔpãmɛ petee, pɛnɔsɛ banɔ gɛ bedzì balɛ nɛ̀ ehoeyiɛ, anɔnyɛ kanyiaka nɛ yɛ bɔpãmɛ kɛlɛ ebhui bɔnyɛnyɛ akɔalɛ, asɛ gɛ Owusoso Akaa etseɖe yɛ. <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />Abraham atɛŋã agɔ afɛtezhyita nɛ̀ tezhyita gɛ ebhui bɔnyɛnyɛ, <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />kɛlɛ yɛeyianyɛ Ishmael atɛŋã agɔ lɔfɔ nɛ̀ taata, <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />bebhui bɔnyɛnyɛ akɔ Abraham nɛ̀ yɛeyianyɛ Ishmael nɛ kiwui tinikpo ɛlɛ nabha. <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />Kɛlɛ anyɛ kanyiaka nɛ Abraham bɔpãmɛ, nɛ̀ bagɛ bamɔ́ pɛnɔsɛ bedzì edenɔ efù ɔkɔ, bebhui bɔnyɛnyɛ akɔalɛ aplɛnii.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s1">Beefù Taata Teli</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />Apaleteɛ ebu yɛishu akasɛ Abraham nɛ Mamrɛ beesi gbagbala ɔbha nɛ kibeɛ gɛ azã kesi nɛ yɛ kɛpɔtɛ kagba niedulũɔ nɛ kibeɛ gɛ kiwuiɛ vũ kifuɔ. <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />Gɛ Abraham ebu bamɛ ewunɔ kabhaa, amɔ banyɛ taata teli gɛ balɔɛtiti nɛ kɛwɔã ɔkɔ toli. Kibeɛ gɛ amɔ alɛɛ, akɔ yɛ tɛtsɛɖɛ tsɔ̀ odenɔ yɛagba niedulũɔ pɛ adɛ tsyana alɛ kɛlɛ ezhyi ekumũ kesiakpa.<verse eid="GEN 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 18:3" />Aɖɔ asɛ, "Onupɛ ɔdɛmɛ mɛibuiɛ, mɛ apaleteɛ, tɛdɔ wɔaxɔɛdɛ ɔfala. <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />Nɔkɔ bamana bulĩ bɔbhlui tɛ nopulu wɔnɔ bɔtsɛɖɛkpɔ tɛ nomoele nɛ busi alɛ niesi. <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />Nɔkɔ mɛpɛ kɛdɔ teli kɔ wɔnɔ nɔŋã, sɛtɛ nɔmɔ ohumi tɛ nɔvɛ wɔnɔ kidzo gagã nabha-otsiɛ gɛ nɔba wɔnɔ axɔɛdɛ ɔkɔ."</para>
  <para style="p" vid="GEN 18:5">Bebuiliulũ asɛ, "Abɔ ana, bhɛtɛ asɛ ana gɛ ɔɖɔɔ." <verse eid="GEN 18:5" /><verse number="6" style="v" sid="GEN 18:6" />Kliso Abraham ebu tɛtsɛɖɛ mɛ avɛ Sara ɔbhà nɛ kɛpɔtɛ kagba mɛ. Etseɖe yɛasɛ, "Kɔ yatsɔ lɔkɔ bɔna butoroe tɔɔta tɛ ɔvɔ̃ yɛ tɛ ɔpɔɛ abolo teli."<verse eid="GEN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 18:7" />Kɛliedeɛ ebu tɛtsɛɖɛ mɛ avɛ nɛntsyɔɛza ɔbhà, ebu abhɛtɛ tibubu gbangbã gɛ egishè kɛlɛ alɔkɔ ɔlɛ akpɛ ahɔɛ akɔ yɛaxɔɛdɛ gɛ ebu tɛtsɛɖɛmɛ pɛ ediyii pɛ atɔɛ. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />Kɛlɛ adɛ lɔkɔ nɛntsyɔɛ bɔmɔlĩkpã nɛ bɔmɔlĩ nɛ̀ nɛntsyɔɛ eyiɛ gɛ batɔ, elu balɛ otugba. Nɛ kibeɛ mɛ gɛ baza aŋã bɔdɔ̃ɔ, azã kitití nɛ balɛ ɔbhà nɛ busi niesi.<verse eid="GEN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9" />Bebisi yɛasɛ, "Fakɔ wɔedzini Sara avɛ?" Aɖɔ asɛ, "Ɛkɛlɛɛ nɛ kɛpɔtɛ kagbaa mɛ."<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />Kɛlɛ Apaleteɛ aɖɔ asɛ, "Eba tsyina ba kɛgɔana epitalɛ gɛ ɛtɛba tsyina ɛlɛ, kɛlɛ Sara gɛenu wɔedziniɛ abamɔ eyianyɛ."</para>
  <para style="p" vid="GEN 18:10">Otsinɔ Sara azatatɔ elũ nɛ kɛpɔtɛ kagba kedulũɔ gɛazã yɛedeɛ aza. <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />Abraham nɛ̀ Sara betishè gɛ balɛ agɔ mɛ avɛ otugba, kɛlɛ Sara etishè afala eyi mɔmɔ̀ agɔ shu. <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />Kliso Sara amɔɛ akɔ yɛishu gɛ azanyɔ̃ kibuiɛ nɛ yɛishuɔ mɛ, "Gɛ ɛhɔlɔ̃ beke pɛ mɛ apaleteɛ etisheɛ, otsi mɛbà mɔ ɔdzyɛ ɔlɛ dza?"<verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />Kɛlɛ Apaleteɛ etseɖe Abraham asɛ, "Kiɖeso pɛ Sara amɔɛmɔɛ pɛ aɖɔ asɛ, 'Ɛzɛ balà mɔ eyi, otsiɛ gɛ itisheɛ dza?' <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />Kibui tili lɛ gɛ kɛgagãlĩ falanɔ ɔkɔ Apaleteɛ dza? Ɛba tsyina ba wɔkɔ nɛ kibe tɔtɔɖɔ nabha nɛ kɛgɔana, kɛlɛ Sara abamɔ eyianyɛ."<verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />Kifù yi Sara soɔ asɛ asɛnɛ aɖɔ asɛ, "Ɛgɛ mɔɛ kɛmɔɛ nanà." Pɔ anyɛ aɖɔ asɛ, "Kɛgbã, ɔmɔɛ kɛmɔɛ."<verse eid="GEN 18:15" /></para>
  <para style="s1">Abraham Eluitakpu esi akɔ Sodom</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />Kibeɛ gɛ beefuɔ alɔ asɛ bashɛɛ, beɖi kesiɛ asɛsɛ nɛ Sodom, kɛlɛ Abraham agã aplɛnɔ alɛ sɛtɛ akpɛ balɛ kidzo. <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />Kɛlɛ Apaleteɛ aɖɔ asɛ, "Ɛbàkpũ Abraham kibuiɛ gɛ ɛɛba babhɛtɛ dza? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />Abraham ebedzì ohumi kɛmadi gbagbla, kɛlɛ bebe yula amadiɛ petee nɛ kesiakpa nabha ɔganà yɛabha. <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />Pɔ mɛibu yɛ, tɛ aba kasɛ yɛeyialɛ nɛ̀ yɛ bɔpã gɛ babà nɛ yɛedeɛ tɛ banyanà Apalete nɛidzoɔ ovunũ nɛ kibui gbangbã nɛ̀ kibui gɛlɛ ɛlɛ ɔzãkɔ tɛbhɛbhɛtɛ mɛ, tɛ Apaleteɛ akɔ kɛgɛ aɖɔ elu akɔ Abraham baɛlɛ mɛ."<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />Kɛlɛ apaleteɛ aɖɔ asɛ, "Oziɛ gɛ bakpɛ nɛ Sodom nɛ̀ Gomoɖa shuɔ ɔgagalĩ kɛlɛ balɛ ebuikpa bhɛbhɛtɛ kɛfala kifú <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />kliso ɛba zhyivɛ tɛ mɛidiɖi ɔsɛ ebuiɛ gɛ babhɛtɛ kizĩ asɛ ozĩ kpɛkpɛ gɛ ɔbɔtɔnɔ mɛ dza. Kɛma ɛlɛ mɛ anaa, ɛba tì."<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />Banyɛ betsyina pɛ bavɛ Sodom kibé, pɔ Abraham xɔnɔ azã kitití nɛ Apaleteɛ namɛ. <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />Kɛlɛ mɛ Abraham etso buni pɛ aɖɔ asɛ, "Ɔbɔ gbã banɔ gbangbãa ɔtɛɛ ɔplɛnɔ banɔ kpa dza? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />Enu asɛ banɔ gbangbã afɛeti balɛ ɔmã gbagbla mɛ xɔ̃ɔ? Ɔbɔlà ɔmã mɛ ɔgbã ɔdɛ tɛɛ gɛ otiboɖi banɔ gbangbã afɛetiɛ gɛ bakpasɛ ɔlɛ mɛɛ soɔ dza? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />Kitsovɛ fãa nɛ wɔshu sɛtɛ ɔbhɛtɛ kibui ɛlɛ nɛidi-tɛ oyí banɔ gbangbã nɛ̀ banɔ kpaa, tɛ ɔbhɛtɛ banɔ gbangbã nɛ̀ bakpa tenikpo. Kitsovɛ fãa nɛ wɔshu! Kebhuekuluɔ akɔ kesiakpa petee, atɛ babhɛtɛ kibui gbangbã dza?"<verse eid="GEN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26" />Apaleteɛ aɖɔ asɛ, "Ɛmɔ banɔ gbangbã afɛeti nɛ Sodom ɔma gbagbla mɛɛ, ɛba shɛnɛ ahɔɛ ɔlɛ petee shu nɛ balɛ kɛtakpu so."<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />Kɛlɛ Abraham ewuli azaɖɔ asɛ, "Otsiɛ gɛ ɛkpité ana pɛ ɛɖɔ kaɖɔ nɛ̀ Apaleteɛ, itinu kɛdɔ nanà pɔ osubhududu nɛ̀ bɔtɔ̃, <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />enu asɛ banɔ gbangbã tɛkakalà ezhyi esi nɛ̀ banɔ teeti odenɔ banɔ afaeti mɛ xɔɔ? Ɔma gbagbla petee nɛ banɔ teetiɛ shu soɔ dza?"</para>
  <para style="p" vid="GEN 18:28">Aɖɔ asɛ, "Ɛmɔ baanɔ afɛtaalɛ nɛ̀ teeti nɛ ɛkɛlɛɛ, ɛtɛ bazĩ ɔlɛ."<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />Ezewuli aɖɔaɖɔ etseɖe yɛasɛ, "Enu asɛ banɔ afɛtaalɛ yete bamɔ nɛ ɛkɛlɛ xɔ̃ɔ?" Aɖɔ asɛ, "Nɛ banɔ afɛtaalɛ kɛtakpu soɔ, ɛtɛ babhɛtɛ ɛlɛ."<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />Kɛlɛ aɖɔ asɛ, "Kɛtɛ baɛlɛmɛ sɛ tɛ Apaleteɛ akpɛ ɔmɔpɔɛ, pɔ kɔ mɛɖɔ kaɖɔ. Enu asɛ banɔ afɛataa yete babamɔ̃ nɛ ɛkɛlɛ xɔ̃ɔ?"</para>
  <para style="p" vid="GEN 18:30">Ebuiliulũ asɛ, "Ɛtɛ babhɛtɛ ɛlɛ gɛ onupɛ ɛmɔ banɔ afɛata nɛ ɛkɛlɛ."<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />Abraham aɖɔ asɛ, "Otsiɛ gɛ ɛkpɛ kité ana pɛ ɛɖɔaɖɔ nɛ̀ Apaleteɛ, enu asɛ banɔ afɛtaabha yete babamɔ̃ nɛ ɛkɛlɛ xɔ̃ɔ?"</para>
  <para style="p" vid="GEN 18:31">Ebuiliulũ asɛ, "Nɛ banɔ afɛtaabha kɛtakpu soɔ, ɛtɛ bazĩ ɔlɛ."<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />Kɛlɛ aɖɔ asɛ, "Kɛtɛ baɛlɛmɛ sɛ tɛ Apaleteɛ akpɛ ɔmɔpɔɛ, pɔ kɔmɛ wuli ɖɔaɖɔ bɔɖɔ tenikpo. Enu asɛ banɔ lɔfɔ yete bamɔ̃ nɛ ɛkɛlɛ xɔ̃ɔ?" Ebuiliulũ asɛ, "Nɛ banɔ lɔfɔ kɛtakpuɔ soɔ, ɛtɛ bazĩ ɔlɛ."<verse eid="GEN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33" />Gɛ Apaleteɛ aɖɔ kaɖɔ nɛ̀ Abraham ebekeɛ, ashɛ, kɛlɛ Abraham etsyina avɛ bɔpã mɛ.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s1">Bezĩ Sodom nɛ̀ Gomora</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />Baxɔɛdɛ taabha edikú Sodom nɛ ɔwlagoɔ, gɛ Lɔt ezhyi azã kesi nɛ ɔmã gbagbala niedulũɔ. Kibeɛ gɛ amɔ balɛ, alɔ pɛ adɛ tsyana alɛ kɛlɛ ezhyini bamɛ ekumũ kesi akɔ alɛ. <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />Aɖɔ asɛ, "Mɛ apalete alɛ, ɛkpɛ kɛtakpu esi kɔ wɔnɔ, nɔvɛ wɔnɔ axɔɛdɛ bɔpamɛ. Nɔbɔ la wɔnɔ bɔtsɛɖɛkpɔ oplu tɛ nɔza elishiɛ tɛ nɔvɛ wɔnɔ kidzo gagã nabha nɛ kɛvɔlɔ plii.</para>
  <para style="p" vid="GEN 19:2">Bebuiliulũ asɛ, "Oho, bɔbadɛza befù ɔtsɛkɔɔ."<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />Pɔ etũilɛ akpɛ balɛ ulũ gagalĩ asɛ bavɛ bɔpãmɛ aplinii. Atɔ bɔdɔ̃ kɔalɛ, apɔɛ abolo gɛ bagɛ kpɛ kɛdɔ̃ nyanyã nɛ yɛ mɛ, kɛlɛ batã. <verse eid="GEN 19:3" /><verse number="4" style="v" sid="GEN 19:4" />Flogo tɛ badɛ wɔsɔ̃ kesiɛɛ, banyɛ nyɔ̃ɔ gɛede Sodom ɔmã gbagbla kampɛ kanyiaka-bunuvɔɛ nɛ̀ besheshè-bakpɛ kanà bɔpã. <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />Bekulu Lɔt asɛ, "Fakɔ banyɛ gɛ aba wɔkɔ oboɔ elishiɛ balɛ dza? Bu balɛ oyinɔ tɛ bɔwɔsɔ̃ naalɛ."<verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />Lɔt ekoeyi avɛ ɔtɔ̃ɔ tɛ atsyɔà nalɛ kɛlɛ adã opupuɔ nɛ yɛedeɛ <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />kɛlɛ aɖɔ asɛ, "Oho, mɛɔbhialɛ. Nɔtɛ bhɛtɛ kɛtakpumɛ gagalĩ kibui ɛlɛ. <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />Noɖi, beyiadzɛ taabha gɛ betinyɛ anyɛ alɛ mɛahɔɛ. Nɔkɔ mɛgbana alɛ oyinɔ mana wɔnɔ, kɛlɛ nɔbɔlà bhɛtɛ kɛgɛ nɔpɛ nɛ̀ balɛ. Pɔ nɔtɛ bhɛtɛ kibui nanà ɔvɛnɔ banyɛ alɛ shu, ɔmɔsɛ babatsɛ nɛ mɛ ovutɔ esi."<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />Baɖɔ etseɖe yɛasɛ, "Fala nɛ kidzo mɛ ɔkɔ ɔlɔ." Kɛlɛ baɖɔ asɛ, "Anɔ alɛ aba ɛkɛlɛ asɛ efù ana, otsinɔ apɛ asɛ abhɛtɛ asɛ kebhuekulu yɛenu! Bɔbà tũkpɛ kɔwɔ dɛ balɛ." Bazã etũilɛ akpɛ Lɔt ulũ kɛlɛ bagã avɛ otugba asɛ tɛ bayɛɛ opupuɔ.<verse eid="GEN 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 19:10" />Pɔ banyɛ gɛazã kɛmɛɛ bakpɛ ɔhɔɛ anyanà Lɔt kɛlɛ betsinì yɛ amanà bɔpã mɛ kɛlɛ badã opupuɔ. <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />Balɔkɔ anhũ pupú ehu banyɛ gɛazã bɔpã niedulũɔ, bunuvɔɛ nɛ̀ besheshè tɛ batɛ mɔ kedulũɔ.<verse eid="GEN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />Banyɛ ebisi Lɔt asɛ, "Banɔ bhlatɔ teli aka alɛ wɔahɔɛ nɛ ɛkɛlɛ-wɔ awɔà, beyianyɛ pɛnɔsɛ beyiadzɛ, pɛnɔsɛ anɔkanyiaka gɛ alɛ ɔmã gbagbla mɛ gɛenu wɔ ayɛ dza? Bu alɛ oyinɔ nɛ ɛkɛlɛ, <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />ɔmɔsɛ bɔbàzĩ ɛkɛlɛ. Ozĩ kpɛkpɛ ɔvɛ Apaleteɛ ɔkɔ nɛ ɛkɛlɛ banɔnɔ shuɔ okpè afalanɔ ifú, kliso akpɛ bɔlɔ ɔsɛ tɛ bɔbazĩ ɔlɛ."<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />Kliso Lɔt ekoeyì pɛ adɛ ɖɔaɖɔ akɔ yɛawɔ̀a, gɛ beti bisi yɛ beyiadzɛ nɛtɔ asɛ bagbanà. Aɖɔ asɛ, "Nɔkɔ yɛatsɔ tɛ nokoeyi nɛ ɛkɛlɛ, ɔmɔsɛ Apaleteɛ evili bezĩ ɔmã gbagbla!" Pɔ yɛawɔ̀a eɖi asɛ ɔwɔfu.<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />Nɛ olizatɔ gɛɔbaa mɛɛ, baxɔɛdɛ etuilɛ akpɛ Lɔt asɛ, "Kɔ yɛatsɔ̀! Gbana wɔ edziniɛ nɛ̀ wɔ eyiadzɛ taabha gɛ alɛ ɛkɛlɛ, onu gɛnɛ anaa, babagbã wɔnɔ̃ tsyɛ akpɛ gɛ onupɛ bapɔ̃ batɔ̃ akɔ ɔmã gbagbla."<verse eid="GEN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 19:16" />Gɛ kitiku yɛawɔ̃ɔ, banyɛ atahɔɛ nyanà yɛɔhɔɛ nɛ̀ yɛedziniɛ ahɔɛ ɔyɛ nɛ̀ yɛ beyìadzɛ taabha ɔyɛ kɛlɛ bagbana alɛ boeboeboe okoeyi nɛ ɔmã gbagbla mɛ, ɔmɔsɛ Apaleteɛ ebi alɛ ashagabui. <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />Gɛ anya gashu ebualɛ oyinɔ koɔ, balɛ anɔ tenikpo aɖɔ asɛ, "Nɔkɔ wɔnɔ tɛtsɛɖɛ tsɔ tɛ nɔobu wɔnɔ ɛkpã! Noti otsyina ɖi kide, kɛlɛ nɔtɛ wɔzã ɔkɔnanà nɛ kadadasiɛ mɛ! Nobu tɛtsɛɖɛ mɛ ɔvɛ beetu nabha onu gɛnanaa, babagbã wɔnɔ akpɛ!"<verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />Pɔ Lɔt etseɖe balɛ asɛ, "Oho, mɛ apalete alɛ, ɛkɔ wɔnɔɛtakpu! <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />Wɔnɔ axɔɛdɛ amɔ tɛdɛdɛmɛ nɔ nɛ wɔnɔ bamɛ, kɛlɛ nɔkasɛ mɛ ɛyamɛ gbangbã gɛ nobu mɛkpã. Pɔ ɛtɛ balà bu tɛtsɛɖɛ mɛ ɔvɛ beetu nabha; kibui kpa ɛlɛ banyanã mɛ, kɛlɛ ɛbà tsí. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />Noɖi, ɔmã toli nɔlɛ gɛ lotso ɔplɛnɔ bɔlɔ gɛ bɔbalà bu tɛtsɛɖɛ mɛ ɔvɛ, kɛlɛ lodzi bhlui tsyɛ. Kɔmɛ ibu tɛtsɛɖɛ vɛ ɔlɛ mɛ-lodzi bhlui piapi, kɛma ana dza? Kɛlɛ bebebu mɛkpã oyinɔ nɛ kɛlɛ mɛ."<verse eid="GEN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21" />Etseɖe yɛasɛ, "Abɔ ana, ɛba buidzo nɛ wɔ tibibisi ɛlɛ tsyɛ ishu kɔwɔ; ɛtɛ bayɛɛ ɔmã ɔlɛ ishu kibui gɛ ɔɖɔɔ. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />Pɔ kɔ wɔ tɛtsɛɖɛ tsɔ vɛ ɛkɛlɛ, ɔmɔsɛ ɛtɛ balà kɛnanà bhɛtɛ ɔdɛkpɛnɔ sɛ odiku ɔlɛ mɛ." (Kliso pɛ bekulu ɔmã ɔlɛ asɛ Zoa gɛ kɛlɛ esi kɛlɛinu ɔsɛ ɔmã bhlui).<verse eid="GEN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />Tɛ kibeɛ gɛ Lɔt ediku Zoa bànáa, kiwuiɛ tibi nɛ kesiakpa nabha. <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />Kɛlɛ mɛ Apaleteɛ akɔ iɖù gɛ atã adɔ atɔɖɔ Sodom nɛ̀ Gomoɖa abha-odenɔ Apaleteɛ ɔkɔ nɛ owusoso nɔ mɛ. <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />Klisoɔ ayɛɛ ɛmã gbagbla ɛlɛ nyɔ̃ɔ nɛ kadadasiɛ, nɛ̀ bagɛ bazã ɛmã gbagbla mɛ-nɛ̀ kifutùɔ tsyɛ gɛzã kesiakpa mɛ. <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />Pɔ Lɔt yɛedzini eɖi kide, kɛlɛ etsyina edzì bɔmɔɛteɖe.<verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />Kelizaza nɛvɔlɔ plii nɔ, Abraham alɔ pɛ etsyina avɛ ɛkɛlɛ gɛ azã nɛ Apaleteɛ namɛ. <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />Eɖi ezhyinɔ asisɛ Sodom nɛ̀ Gomoɖa, asisɛ kɛdasi kesiakpa nyɔ̃ɔ mɛ, kɛlɛ amɔ̃ ɔnyɔ̃ dodo gɛ lokoeyì blublublù odenɔ kesiakpa mɛ, asɛ ɔnyɔ̃ gɛ loode okoeyi nɛ ɔgbaa mɛ ana.<verse eid="GEN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 19:29" />Klisoɔ gɛ Owusoso Akaa ezĩ kadadasi ɛmã gbagbla gɛzã, abaka Abraham, kɛlɛ ebu Lɔt denɔ kibui kpa gɛyɛɛ ɛmã gbagbla mɛ gɛ Lɔt azãa.<verse eid="GEN 19:29" /></para>
  <para style="s1">Lɔt nɛ̀ Yɛ Beyiadzɛ</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />Lɔt nɛ̀ yɛ beyiadzɛ bashɛ nɛ Zoa kɛlɛ bedibhui kazã nɛ beetuɔ mɛ, ɔmɔsɛ esi kifù sɛ tɛ azã Zoa. Yɛ nɛ̀ yɛ beyiadzɛ taabha bazã aklagbu ozĩ mɛ. <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />Kiwui tinikpo tili, eyiadzɛ shesheɛ etseɖe yɛada bhlui nɔ asɛ, "Bɔlɔ aka eshè, kɛlɛ anyɛ nanà ama kibe ɛlɛ gɛ abawɔsɔ̃ nɛ bɔlɔ, asɛ gɛ ɔkɔɔ ɔlɛ nɛ kesiakpa nyɔ̃ɔ abha. <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />Kɔ bɔkɔ bɔlɔ akaa bunù yɛawɔɛ tɛ bɔwɔsɔ̃ niyɛ tɛ buvũ bɔlɔ bɔpã kihui nɔ dzù ɔganà bɔlɔ akaa mɛ."<verse eid="GEN 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 19:33" />Elishi alɛ bakɔ balɛ akaa bunu yɛawɔɛ, kɛlɛ yɛeyiadzɛ shesheɛ avɛ adɛ wɔsɔ̃ niyɛ. Egitì kibe nɔnɔ gɛ adzɛ awɔsɔ̃ niyɛ pɛnɔsɛ kibe nɔnɔ gɛ adzɛ alɔ.<verse eid="GEN 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34" />Kiwui bhalàa, eyiadzɛ shesheɛ etseɖe eyiadzɛ bhului nɔ asɛ, "Elishiɛ gɛ aba falaa, ɛwɔsɔ̃ nɛ̀ mɛaka. Kɔ bɔkɔɛ bunù tɛ ewuli awɔɛ oboɔ elishi, tɛ ɔvɛ ɔdɛ wɔsɔ̃ niyɛ tɛ buvũ bɔlɔ bɔpã kihui nɔ odzu ɔganà bɔlɔ akaa mɛ." <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />Klisoɔ, bakɔ balɛ akaa awɔɛ bunù elishi alɛ tsyɛ, kɛlɛ eyiadzɛ bhului nɔ avɛ adɛ wɔsɔ̃ niyɛ. Kɛlɛ tsyɛɛ, aza egitì kibeɛ gɛ adzɛɛ awɔsɔ̃ ni yɛ pɛnɔsɛ kibeɛ gɛ adzɛ alɔ.<verse eid="GEN 19:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 19:36" />Klisoɔ Lɔt yɛeyiadzɛɛ taabha emunu ɛya akɔ balɛ akaa. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />Eyiadzɛɛ shesheɛ amɔ eyianyɛ, kɛlɛ akɔ yɛ kinye asɛ Muab; yɛenu akaa akɔ oboɔ Muabuanɛ. <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />Eyiadzɛ bhlui nɔ tsyɛ amɔ eyianyɛ, kɛlɛ akɔ yɛ kinye asɛ Bɛn-Ammi; yɛenu akaa akɔ oboɔ Amonianɛ.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s1">Abraham nɛ̀ Abimɛlɛk</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />Otsiɛ nɔ, Abraham ashɛ nɛ ɛkɛlɛ avɛ Negɛv oxuiɛ bɔdɔ̃ mɛ kɛlɛ adɛzã Kaɖɛsh nɛ̀ Shɛɛ kishiɛ. Nɛ kibe guluĩ mɛɛ, adɛzã Gera. <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />ɛkɛlɛ Abraham aɖɔ nɛ yɛedzini Sara ishu asɛ, "Mɛada yɛenu." Kɛlɛ mɛ Abimɛlɛk gɛenu Gera ekusiɛ akpɛ anɔ nɛ Sara ɔkɔ kɛlɛ agbanà yɛ.<verse eid="GEN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 20:3" />Pɔ Owusoso Akaa ebu yɛishu akasɛ Abimɛlɛk nɛ bɔlalà mɛ elishi tenikpo pɛ etseɖe yɛasɛ, "Ɔshɔnɔ kɛdɔ tsitsí ana nɛ adzɛɛ gɛ ɔgbanà shu; enu adzɛ gɛ batɛ gbanà."<verse eid="GEN 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4" />Otsiɛ nɔ Abimɛlɛk eke hunũ yɛ kliso aɖɔ asɛ, "Apalete, obozĩ kɛmadi gɛ kɛgɛ bhɛtɛ kizizĩ nanà dza? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />Gɛnɛ butseɖe yɛetseɖe mɛ asɛ, 'Mɛada yɛenu' pɛ yɛtsyɛ aɖɔ asɛ, 'Mɛadza yɛenuɔ dza'? Ɛbhɛtɛ kibui ɛlɛ nɛ kɛtakpu gbangbã nɛ̀ ahɔɛ bhuibhui mɛ."<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />Kɛlɛ mɛ Owusoso Akaa etseɖe yɛ nɛ bɔlala mɛ asɛ, "Ee, inyi sɛ kɛtakpu gbangbã mɛ wɔ lɔkɔ ɔbhɛtɛ kliso pɛ ɛgɛ kɔwɔ kidzo sɛ tɛ ɔbhɛtɛ kibui kpa ɔmanà mɛishu. Kɛlɛ shu so pɛ ɛgɛkɔ wɔ kidzo sɛ tɛ ohunũ yɛ. <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />Otsiɛ nɔ, tsyina anyɛɛ yɛedziniɛ ɔvɛnɔ yɛ, ɔmɔsɛ ebuiɖɔluanɔ yɛenu, kɛlɛ ebekulu Owusoso Akaa nɛ wɔɛtakpu tɛ ɔzã nɛkpã. Pɔ onupɛ ɔgi tsyina yɛ ɔvɛnɔɔ, kɛzã tititì mɛ akɔwɔ asɛ, wɔ nɛ̀ wɔeshopo alɛ petee ebetsí."<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />Kelizaza kɛvɔlɔ plii nɔ, Abimɛlɛk ekulu yɛanɔshesheɛ petee, kɛlɛ gɛ etseɖe alɛ kɛgɛ ba kɛlɛ mɛɛ, kifù yialɛ gelee. <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />Kɛlɛ mɛ, Abimɛlɛk ekulu Abraham amanà yɛɔbhà pɛ aɖɔ asɛ, "Kibui ɖuwoelu wɔbhɛtɛ nɛ̀ bɔlɔ ana? Kizizĩ ɖuwoelu mɛbhɛtɛ nɛwɔ pɛ ɔmanà kiwuĩ gbagbla ɛlɛ ɔbɔ tɔɖɔ mɛ nɛ̀ mɛ bukusi ɔŋãkɔ nabha dza? Ɔbhɛtɛ nɛ̀ mɛ̀ ebui gɛ kɛma ɔsɛ babhɛtɛ." <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />Kɛlɛ Abimɛlɛk ebisi Abraham asɛ, "Kibui ɖuwoelu so pɛ ɔbhɛtɛ kibui ɛlɛ?<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />Abraham ebuiliulũ asɛ, "Ɛɖɔ tseɖe mɛishu ɔsɛ, 'Kɛgbã kɛlɛ ɛlɛ mɛ ɔsɛ Owusoso Akaa kifù sisi ma ɛkɛlɛ, kɛlɛ bebeyi mɛ nɛ mɛedzini kɛtakpu.' <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />Ɔlɔkɔ ɛplɛnɔ kɛlɛ̀ɛ, kɛlɛ ɛlɛ mɛ kɛgbã sɛ mɛada yɛenu, mɛaka yɛeyiadzɛ pɔ gɛnɛ mɛelĩ eyi, kɛlɛ ebedzì mɛedzini. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />Kɛlɛ gɛ Owusoso Akaa akɔ mɛzɛ nyɔ̃ nɛ mɛakaa bɔpãmɛ, itseɖe Sara sɛ, 'Kidzo ɛlɛ nabha wobo obù ɔkasɛ mɛ wɔaɖɔyɛ mɛinu: Ɔkɔnyiakɔ gɛ bɔvɛɛ, ɖɔ nɛ mɛishu ɔsɛ, "Mɛadzya yɛenu." ' "<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />Kɛlɛ mɛ Abimɛlɛk adɛ manà ibhoshi nɛ̀ banɛntsyɔɛ, banyɛ nɛ̀ badzɛ banɔ dzidzì pɛ alɔkɔ akɔ Abraham, kɛlɛ etsyina yɛedzini Sara akɔɛ. <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />Kɛlɛ Abimɛlɛk aɖɔ asɛ, "Mɛ kesiakpa eli wɔamɛ; zã ɔkɔnyiakɔ gɛ ɔpɛ."<verse eid="GEN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 20:16" />Kɛlɛ Sara aɖɔ etseɖe asɛ, "Ɛbakɔ wɔadzya sikàfufu ohotu zɛzɛ. Tɛ ɛlɔkɔ kpɛ kibui kpa gɛ ɛbhɛtɛ manà wɔ kɔ nulũ nɛ́ bagɛ balɛ wɔbhà petee amɛ; ibu bɔtsyɔa akɔ wɔ petee."<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17" />Kɛlɛ Abraham ekulu Owusoso Akaa, kɛlɛ Owusoso Akaa ebu eyi mamɔmamɔ bɔnyãa nɛ Abimɛlɛk, yɛedzini nɛ̀ yɛadzɛnuvɔɛ dzidziɛ balɛ ishumɛ tɛ bewuli amɔ eyi, <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />ɔmɔsɛ Owusoso Akaa atɛdã bɔmɔmɔ̃ kamɔmɔvũ kanyiaka nɛ Abimɛlɛk bɔpã mɛ nɛ Abraham yɛedzini Sara kɛtakpu.<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s1">Isak Tɛmɔmɔ̃</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />Otsinɔ, Apaleteɛ ebhui Sara ebu asɛ gɛ atɛɖɔ afala ana, kɛlɛ Apaleteɛ abhɛtɛ kɛgɛ atɔɖɔ elu akɔ Sara. <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />Sara emunù ɛya, kɛlɛ amɔ́ eyianyɛ akɔ Abraham, nɛ yɛ tishesheɛ mɛ, nɛ kibeɛ mɛ gɛ Owusoso Akaa atɔɖɔ elu akɔɛ. <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />Abraham akɔ eyianyɛ gɛ Sara amɔ́ akɔɛ nɛinye asɛ Isak. <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />Kibeɛ gɛ yɛeyianyɛ Isak aŋã ewui tasɛɛ, Abraham ebhui bɔnyɛnyɛ akɔɛ asɛ gɛ Owusoso Akaa etseɖe yɛasɛ abhɛtɛ. <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />Abraham atɛŋã agɔ kɛkpã zɛzɛ nɛ kibeɛ mɛ gɛ bamɔ yɛeyianyɛ Isak akɔɛ.<verse eid="GEN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 21:6" />Sara aɖɔ asɛ, "Owusoso Akaa akɔ mɛmɔɛ kɛmɔɛ, kɛlɛ anɔnyianɔ gɛ elũ kibui ɛlɛ tsyɛ abamɔɛ aplɛnɔ mɛ." <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />Kɛlɛ azaɖɔ aplɛnɔ asɛ, "Afana gɛ atɛɖɔ etseɖe Abraham eɖi asɛ kiwui tili Sara abakɔ eyi kɛmɔ dza? Pɔ ɛmɔ́ eyianyɛ akɔɛ nɛ yɛ tisheshe ɛlɛ mɛ."<verse eid="GEN 21:7" /></para>
  <para style="s1">Bakpɛ Haga nɛ̀ Ishmael Kidzo</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />Eyiɛ ebeshè kɛlɛ bebhuì kɛmɔ̃ akɔɛ, kɛlɛ nɛ kiwui ɛlɛ nabha gɛ bebhui kɛmɔ akɔ Isak ebekeɛ, Abraham atɔɖɔ ketsukpu pɛ ekulu banɔ̃. <verse eid="GEN 21:8" /><verse number="9" style="v" sid="GEN 21:9" />Pɔ Sara amɔ̃asɛ eyianyɛ gɛ Haga gɛedzi Egipte dziɛ amɔ̃ akɔ Abraham soɔ azamɔɛ yɛ, <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />kɛlɛ etseɖe Abraham asɛ, "Shɛnɛ̀ ahɔɛ nɛ adzɛ dzidzì alɛ́ nɛ̀ yɛeyianyɛ shu, ɔmɔsɛ adzɛ dzidzì alɛ́ yɛeyianyɛ atɛ bamɔ̃ ɔŋãkɔ ɔplɛnɔ mɛeyianyɛ Isak odenɔ kaŋãsi alɛ mɛ."<verse eid="GEN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 21:11" />Kibui ɛlɛ batɔɖɔ Abraham abha fala kifu ɔmɔsɛ kibuiɛ kpà ɔplɛnɔ yɛeyianyɛ. <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />Pɔ Owusoso Akaa etseɖe yɛasɛ, "Tɛkɔ kɛnana tɔɖɔ wɔabha nɛ anyɛnuvɔɛ nɔ nɛ̀ wɔadzɛ axɔɛdɛ shu. Lũ kibui nɔnɔ gɛ Sara etseɖe wɔ, ɔmɔsɛ ganà Isak abha babà kalà wɔeyì mɔmɔ̃ alɛ. <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />Ɛbakɔ adzɛ dzidziɛ yɛeyianyɛ tsyɛ edzì kɛmadi, ɔmɔsɛ wɔeyi mɔmɔ yɛenu."<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />Kelizaza kalɛ kɛvɔlɔ plii nɔ, Abraham alɔkɔ bɔŋaŋã tuli nɛ̀ agãpi kipulì gɛ bulĩ kpasɛ ɛlɛ mɛ pɛ alɔkɔ ɔlɛ akɔ Haga. Alɔkɔ bɔdɔ̃ atɔɖɔ yɛ iwũdɔ kɛlɛ akpɛ yɛ nɛ̀ anyɛnuvɔɛ nɔ kidzo. Atɔnɔ̃ yɛidzoɔ kɛlɛ adaa kanà nɛ Biɛshɛba oxui kesiakpa mɛ.<verse eid="GEN 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 21:15" />Gɛ buliɛ̃ nɛ agãpi kipuli nɔ mɛ beleɛ, alɔkɔ anyɛ nuvɔɛ nɔ elu kɛvɔkɔ̀ tinikpo nɔ tili esi. <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />Kɛlɛ avɛ adɛzã kɛwɔã nɛ okɔ toli, asɛ bɔnyɔ̃ tɛtatà tidzedze mɛ ana, ɔmɔsɛ abhɛtɛ ekpoɖekpoɖe mɛasɛ, "Ɛtɛ balà ɖi anuvɔ pɛ ebetsí." Kɛlɛ adɛzã kɛwɔã, kɛlɛ akpà yoyo bi.<verse eid="GEN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />Owusoso Akaa elũ gɛ anyɛnuvɔɛ nɔ eebieyo, kɛlɛ Owusoso Akaa yɛaxɔɛdɛ ekulu Haga odenɔ kititíɛ pɛ ebisi yɛasɛ, "Haga, kibui ɖuwoelu gɛba? Tɛosi kifù, Owusoso Akaa elũ gɛ anyɛnuvɔɛ nɔ eebieyo nɛ kibeɛ gɛ awɔsɔ̃ ɛkɛlɛ. <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />Feke anyɛnuvɔɛ nɔ wunɔ kabhà nɛ̀ yɛhɔɛɛ, ɔmɔsɛ ɛbakɔ̀ yɛedzì kɛmadi gbagbla."<verse eid="GEN 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 21:19" />Kɛlɛɛ, Owusoso Akaa adãlɛ yɛaŋuhũɔ pɛ amɔ̃ ozĩ toli gɛ bulĩ ɔkpasɛ ɔlɛ mɛ. Kliso avɛ edi shi bulĩɛ akpɛ agãpi kipuli nɔ mɛ kiyukù pɛ akɔ anyɛnuvɔ̃ɛ nɔ bulĩɛ pɛ awɔɛ.<verse eid="GEN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 21:20" />Owusoso Akaa azãplɛnɔ anyɛnuvɔɛ nɔ nɛ kibeɛ gɛ eesheɛ. Azã oxui kesiakpa mɛ kɛlɛ ebedzì anɔ gɛ azata bɔnyɔ̃. <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />Nɛ kibeɛ gɛ azã Para oxui kesiakpa mɛɛ, yɛelĩ amɔ adzɛ odenɔ Egipte akɔɛ yɛagbanà.<verse eid="GEN 21:21" /></para>
  <para style="s1">Olugbù Nyanyã nɛ Biɛshɛba</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />Nɛ kibe mɛɛ, Abimɛlɛk nɛ̀ Fikɔl gɛedzi yɛ keyuta gbagbala anɔlũazazã akɔ yɛ keyuta kɛzaa, betseɖe Abraham asɛ, "Owusoso Akaa alɛ aplɛnɔ wɔ nɛ kɛkanyiaka gɛ ɔbhɛtɛ mɛ." <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />Otsiɛnɔ, tanã bɔdɔ̃ kɔmɛ nɛ ɛkɛlɛ̀ nɛ Owusoso Akaa namɛ sɛ ɔtɛbɔ bhɛtɛ asɛnɛ kibui ɔmanà mɛ pɛnɔsɛ mɛeyialɛ pɛnɔsɛ mɛ kihui nɔkɔ. Bhɛtɛ ɛyamɛ gbangbã ɛlɛ nɛidi ɔkasɛ mɛ nɛ̀ kɛmadiɛ gɛ kɛlɛ mɛ wɔonu efùɔ asɛ gɛ mɛtsyɛ bhɛtɛ kɔwɔ ana."<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />Abraham aɖɔ asɛ, "Ɛtanà ɛlɛ."<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />Kɛlɛ Abraham aɖɔ kibui gɛ tɔɖɔ yɛabha akɔ Abimɛlɛk nɛ bulĩ ozĩ toli gɛ Abimɛlɛk yɛaxɔɛdɛ bedzu ahɔɛ nɛ ɔlɛ abha shu. <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />Pɔ Abimɛlɛk aɖɔ asɛ, "Itinyi anɔnɔ gɛ yɛabhɛtɛ kibui ɛlɛ. Ogitseɖe mɛ, pɔ obuɔ yete mɛilũ kibuiɛ."<verse eid="GEN 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27" />Kliso Abraham adɛ mana ibhoshi nɛ̀ banɛntsyɔɛ pɛ alɔkɔ akɔ Abimɛlɛk, kɛlɛ banyɛ taabha alɛ abhɛtɛ olugbù nyanyã. <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />Abraham ebú ibhoshi eyiadzɛ tegegene nɛ kɛzaa mɛ, <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />kɛlɛ Abimɛlɛk ebisi Abraham asɛ, "Ibhoshi eyiadzɛ tegegene alɛ gɛ obu olu ɔtɔ pɔ, kɛlɛ esi sɛ ɛlɛ?"<verse eid="GEN 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30" />Ebuiliulũ asɛ, "Yɛkɛ ibhoshi eyiadzɛ tegegene alɛ odenɔ mɛahɔɛ mɛ asɛ, ɔzã pɛ ɔmɔsɛ mɛibu bulĩ ozĩ ɔlɛ."<verse eid="GEN 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 21:31" />Kliso bekulu ɛkɛlɛ asɛ Biɛshɛba, ɔmɔsɛ banyɛ taabha atanà bɔdɔ̃ nɛ ɛkɛlɛ.<verse eid="GEN 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 21:32" />Gɛ babhɛtɛ olugbù nyanyã nɛ Biɛshɛba ebekeɛ, Abimɛlɛk nɛ̀ Fikɔl geɛdzi beyuta anɔluazazã gbagbala betsyina avɛ Filistiane kesiakpa nabha. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />Abraham edzu busi nɛ Biɛshɛba, ɛkɛlɛ yɛekulu Apaleteɛ nɛinyeɛ, Owusoso akaa gɛ alɛ nɛkpã tihɔɔ nɔ. <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />Kɛlɛ Abraham azã Filistiane kesiakpa nabha kibè dzololo.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s1">Befeke Abraham Eɖi</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />Ewui teli edeɛ, Owusoso Akaa efeke Abraham eɖí. Etseɖe yɛasɛ, "Abraham!" Ebuiliulũ asɛ, "Mɛ naalɛ."<verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />Kɛlɛ Owusoso Akaa aɖɔ asɛ, "Lɔkɔ wɔeyianyɛ, Isak, tenikpo nɔ gɛ yɛibui wɔdɛmɛ nɔ, tɛ nɔvɛ Moɖia bɔdɔ̃ mɛ. Lɔkɔ yɛɔbhɛtɛ bɔdɔ̃ pɔpɔɛ nɛ ɛkɛlɛ nɛ butúɔ tenikpo tuli abha gɛ ɛba tseɖe wɔ."<verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />Kelizaza kalɛ kɛvɔlɔ plii nɔ, Abraham alɔ kɛlɛ atɔɖɔ bɔdɔ̃ gɛ bɔlɛ abha yɛabazã nɛ yɛ adiku nabha. Agbana yɛaxɔɛdɛ taabha nɛ̀ yɛeyianyɛ Isak aplɛnɔ yɛishu. Kibeɛ gɛ ebhui bɔdzyɛɛ nɔ pɛ bukpè akɔ bɔdɔ̃ pɔpɔɛ nɔ, atɔnɔ̃ kidzo avɛ ɛkɛlɛ gɛ Owusoso Akaa etseɖe yɛɛ. <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />Nɛ kiwui teɖamɛ nabhaa, Abraham ebu bamɛ ewunɔ kabha kɛlɛ amɔ̃ ɛkɛlɛ asɛsɛ nɛ odzololokɔ. <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />Etseɖe yɛaxɔɛdɛ asɛ, "Nɔzã ɛkɛlɛ̀ ɔplɛnɔ adikuɔ tɛ mɛ nɛ̀ anyɛnuvɔɛ nɔ bɔvɛ kede ɔkɔ ɔlɛ. Bɔbàkpɛ kɛtakpuesi kɛlɛ, bɔbàtsyina bà wɔnɔ ɔbhà."<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />Kibe ɛlɛ mɛ Abraham alɔkɔ bɔdzyɛ nɔ gɛ abàlɔkɔ abhɛtɛ bɔdɔ̃ pɔpɔɛ nɔ atɔɖɔ yɛeyianyɛ Isak nabha, kɛlɛ yɛ xɔnɔ̃ alɔkɔ kifúɔ nɛ̀ kɛpãmi nɔ. Gɛ balɛ taabha bagã avɛɛ, <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />Isak aɖɔaɖɔ pɛ ebisi yɛaka Abraham asɛ,</para>
  <para style="p" vid="GEN 22:7">"Mɛakaa"</para>
  <para style="p" vid="GEN 22:7">Abraham ebuiliulũ asɛ, "Ee, mɛeyianyɛ." Isak ebisi yɛaka asɛ, "Gɛ kifúɔ nɛ̀ bɔdzɛɛ nɔ li ɛkɛlɛ pɔ, fakɔ obhoshi eyiɛ gɛ bɔba lɔkɔ bhɛtɛ bɔdɔ̃ pɔpɔɛ nɔ lɛ ɔlɛ dza?"<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />Abraham ebuiliulũ asɛ, "Mɛeyianyɛ, Owusoso Akaa abakɔ ɔlɔ obhoshi eyiɛ kɔ bɔdɔ̃ pɔpɔɛ nɔ nɛ yɛahɔɛ mɛ. Kɛlɛ balɛ taabha bagã avɛ kitsù.<verse eid="GEN 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9" />Gɛ bediku ɛkɛlɛ gɛ Owusoso Akaa etseɖe yɛɛ, Abraham abhɔ osubha nɛ ɛkɛlɛ pɛ alɔkɔ bɔdzyɛ nɔ atɔɖɔ ɔlɛ abha. Anyã yɛeyianyɛ Isak kɛlɛ alɔkɔ yɛatɔɖɔ bɔdzyɛɛ nabha, nɛ osubha nabha. <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />Kɛlɛ akpɛ yɛ ɔhɔɛ pɛ alɔkɔ kɛpami nɔ tɛ̀ ebhui yɛeyianyɛ. <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />Pɔ Apaleteɛ yɛaxɔɛdɛ akpɛ ozĩ ekulu yɛ asɛsɛ odenɔ kititíɛ asɛ, "Abraham! Abraham!" Ebuiliulũ asɛ, "Mɛ naalɛ."<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />Aɖɔ asɛ "Tɛkɔ wɔhɔɛ lɔpa nɛ anyɛnuvɔɛ nɔ shu. Tɛbhɛtɛ kibui nanà nɛ̀ yɛ. Otsialɛ inyi ɔsɛ oosì Owusoso Akaa nɛifù, ɔmɔsɛ ɔgɛ lɔkɔ wɔeyianyɛ ɔbhɛtɛ mɛ amumũ, wɔ eyianyɛ tenikpo nɔ."<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />Abraham ebu bamɛ ewunɔ kabha kɛlɛ nɛ kifutùkpɔɛ mɛ, amɔ obhoshinyè toli gɛ ehui akpakà ɔlɛ ashaa. Avɛ kɛlɛ edibu obhoshinyè kɛlɛ adɛwɔ̀a ɔlɛ shu axɔ̃ɛ asɛ bɔdɔ̃ pɔpɔɛ nɛ yɛeyianyɛ nulũ. <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />Kliso Abraham ekulu ɛkɛlɛ asɛ, Apaleteɛ Abakɔ. Kliso ɔdɛkpɛ nɔ obuɔ, baɖɔ asɛ, "Nɛ Apaleteɛ yɛ butú nabhaa babàkɔ kɛdɔ̃."<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />Apaleteɛ yɛaxɔɛdɛ eze kulu Abraham odenɔ kititíɛ bɔbhalà <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />kɛlɛ aɖɔ asɛ, "Ɛtanà mɛ kinyeɛ, Apaleteɛ ebu aɖɔ asɛ, gɛ ɔbhɛtɛ kibui ɛlɛ pɛ ɔgɛ lɔkɔ wɔeyianyɛ ɔbhɛtɛ mɛ amumũɔ, wɔ eyianyɛ tenikpo nɔ, <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />kliso ɛba yulà akɔ wɔ gɛ kɛtɛ bàtsyina, kɛlɛ ɛbabhɛtɛ wɔ kihui nɔ gɛ nobokpe asɛ awɔ̃ɛ nɛ kɛlɛɛ nɔ mɛ̀, nɛ̀ asɛ ayisɛɛ nɛ kelikekpu gbagbla nɔtɔ̃. Wɔ kihui nɔ bayɛkɛ bagɛ atɛaɖɔ wɔ balɛ ɛmã gbagbala, <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />kɛlɛ ganà wɔ bɔmɔ̃ɔ mɛɛ, bebeyula atɔɖɔ akɔ amadiɛ petee nɛ kesiakpa nabha ɔmɔsɛ olũ mɛ atɔ̃."<verse eid="GEN 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19" />Kɛlɛ mɛ, Abraham etsyina avɛ yɛaxɔɛdɛ ɔkɔ, kɛlɛ yɛ nɛ balɛ batɔnɔ̃ kidzo avɛ Biɛshɛba. Kɛlɛ Abraham azã Biɛshɛba.<verse eid="GEN 22:19" /></para>
  <para style="s1">Nahɔ Yɛ Beyianyɛ</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />Kibè tili edeɛ, betseɖe Abraham asɛ, "Milka tsyɛ enu eyielĩ; amɔ̃ beyianyɛ akɔ wɔadzya Nahɔ: <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />Uz gɛedzì eyianyɛ gɛeputɔɔ, Buz gɛenu yɛadzya, Kemuɛl (Aram yɛaka), <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />Kɛsɛd, Hazo, Pildas, Yiɖlaf nɛ̀ Betuɛl." <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />Betuɛl amɔ́ Rebeka. Milka amɔ̃ beyianyɛ taasɛ alɛ ɔkɔ Abraham yɛadzya Nahɔ. <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />Yɛagɔlɔ gɛ bezekulu asɛ Ruma tsyɛ amɔ beyianyɛ: Tɛba, Gaham, Tahash nɛ̀ Maaka.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s1">Sara yɛ Titsitsí</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />Sara azã nɛkpã aŋã agɔ kɛkpã zɛzɛ nɛ̀ afɛtaabha nɛ̀ tegegene. <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />Etsí nɛ Kiɖiat Aba (gɛenu Hɛbrɔn) nɛ Kana kesiakpa nabha, kɛlɛ Abraham avɛ adɛ wɔà ɔwɔnyɔnɔ̃ akɔ Sara kɛlɛ ebieyò akɔɛ.<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />Kɛlɛ Abraham ashɛ nɛ ekpúɔ ɔbhà kɛlɛ aɖɔaɖɔ akɔ Xitianɛ. Aɖɔ asɛ, <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />kesiakpa bhlatɔ abha anɔ nɛ̀ efu mɛinu nɛ́ wɔnɔɛshi. Nɔdɛ wɔnɔ kesiakpa tieli asɛ ɔvɔbɔ ɔkɔ kɔmɛ nɛ ɛkɛlɛ tɛ ɛbalà vɔbɔ mɛ bekpúɔ."<verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5" />Xitianɛ ebuiliulũ akɔ Abraham asɛ, <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />"Apalete, taatɔ̃ nɛ̀ bɔlɔ. Ekusieyi gɛ ohumi ɔlɛ yɛahɔɛ wɔonu nɛ bɔlɔɛshi. Vɔbɔ wɔekpúɔ nɛ bɔlɔ idzeɖe gbangbã ɔdɛ mɛ. Bɔlɔ ɔmayɛmɛ anɔnyianɔ atɛ baɖɔ asɛ agɛ dɛmɛ asɛ ɔtɛ vɔbɔ wɔekpú nɛ yɛ odzeɖe mɛ."<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />Kɛlɛ Abraham alɔ pɛ ezhyi ekumũ akɔ kesiakpa eleteɛ, gɛenu Xitianɛ. <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />Etseɖe balɛ asɛ, "Onupɛ nɔdɛmɛ ɔsɛ ɛvɔbɔ mɛ bekpúɔ, kɛlɛ nɔtaatɔ̃ nɛ̀ mɛ tɛ nɔɖɔ kibui ɛlɛ otseɖe Efrɔn gɛenu Zoha yɛeyianyɛ nɛ mɛinye mɛ, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />sɛ tɛ adɛ Makipela aklagbu ozĩɛ gɛonu yɛɔyɛ pɛ lɔlɛ yɛ kesiakpa bɔwɔatɔɔ akɔ mɛ. Notseɖe yɛ tɛ adɛ ɔlɛ akɔ mɛ kedziɛ petee asɛ kana gɛ nɔdɛ ɔvɔbɔkɔ akɔ wɔnɔ shu."<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />Efrɔn gɛenu Xitieyiɛ azã kesi nɛ yɛ banɔnɔ nɛishi, kɛlɛ ebuiliulũ akɔ Abraham asɛ tɛ Xitianɛ petee gɛaba ɔmã gbagbla niedulũɔ tsyɛ elũ. <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />Aɖɔ asɛ, "Oho, mɛ apalete. Taatɔ̃ nɛ mɛ; gɛ ɛkɔwɔ kesiakpa koɔ, ɛkɔwɔ aklagbu ozĩɛ tsyɛ gɛ lɔkpasɛ kalɛ mɛ. Ɛlɔkɔ ɛkɔwɔ̀ nɛ mɛ banɔnɔ naamɛ. Vɔbɔ wɔ bekpúɔ."<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />Abraham ezezhyi ekumũ nɛ kesiakpa eleteɛ naamɛ <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />kɛlɛ etseɖe Efrɔn tɛ elũ asɛ, "Nɔtaatɔ̃ nɛ̀ mɛ, onupɛ nɔdɛmɛ. Ɛbabuià kesiakpa nɛbhɛ. Yɛkɛ kɛbhɛ nɛ mɛahɔɛ mɛ, tɛ ɛbalà mɛ bekpúɔ vɔbɔ nɛ ɛkɛlɛ."<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />Efrɔn ebuiliulũ akɔ Abraham asɛ, <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />"Taatɔ̃ nɛ̀ mɛ, mɛ apalete; kesiakpa niedzi kalɛ enu shekel sikãfufu kɛkpã zɛzɛ, pɔ kibui ɖuwoe gɛka kpasɛ mɛ nɛ wɔɛshi? Vɔbɔ wɔ bekpúɔ."<verse eid="GEN 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 23:16" />Abraham adɛmɛ atɔɖɔ Efrɔn yɛebui nabha kɛlɛ akɔ yɛ kedziɛ gɛ etseɖe yɛ nɛ kibeɛ gɛ Xitianɛ aza taatɔ̃ nɛ yɛ: gɛenu shekɛl sikafufu akpã taalɛ, nɛ bupùɔ gɛzã yɛmɛ nɛ kibe ɛlɛ budzigãlete nɛishi.<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />Kliso Efrɔn kesiakpa nɛ Makipela gɛ etso ɔplɛnɔ Mamrɛ-kesiakpa nɛ̀ aklagbu ozĩɛ nɛ kalɛ abhà, nɛ̀ besiɛ petee nɛ kesiakpa mɛ nɛ kalɛ bubòɔ mɛ bashɛnɛ ahɔɛ nɛ ɔshà nulũ <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />akɔ Abraham sɛ tɛ kedzì yɛayɛ nɛ Xitianɛ petee gɛaba ɔmã niedulũɔ naamɛ. <verse eid="GEN 23:18" /><verse number="19" style="v" sid="GEN 23:19" />Kidegbaa, Abraham avɔbɔ yɛedzini Sara nɛ aklagbu ozĩɛ nɛ Makipela kesiakpa gɛetso aplɛnɔ Mamrɛ (gɛɔlɛ Hebrɔn) nɛ Kana kesiakpa nabha. <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />Klisoɔ kesiakpa nɛ̀ aklagbu ozĩɛ gɛɔkpasɛ kalɛ mɛ edzi gɛdɔ̀ gɛ Xitianɛ alɔkɔ akɔ Abraham asɛ ɔvɔbɔkɔ ana.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s1">Isak nɛ̀ Rebeka</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />Otsialɛ Abraham ebeshè gɛ yɛagɔ avɛ otugbà, kɛlɛ Apaleteɛ eyulà akɔɛ nɛ kidzò kanyiaka abha. <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />Etseɖe ekusi axɔɛdɛ nɛ bɔpãmɛ, anɔ gɛ yɛalɛ bɔdɔ̃ petee gɛlɛ yɛahɔɛ nulũɔ asɛ, "Kpɛ wɔ ɔhɔɛ nɛ mɛ kɛtsɛɖɛta niesi. <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />Ɛpɛ sɛ tɛ ɔlɔkɔ Apaleteɛ, gɛenu kitití Owusoso Akaa nɛ̀ kesiakpa abha Owusoso Akaa yɛinyeɛ ɔtanà bɔdɔ̃ nɔ sɛ, ɔtɛbɔ gbanà adzɛ ɔkɔ mɛeyianyɛ odenɔ Kana beyiadzɛ gɛ balɛ ishi mɛkpasɛ mɛ, <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />pɔ ɔbɔvɛ mɛ kɛmadiɛ mɛ gɛ ideɛ nɛ mɛeshopo alɛ mɛ tɛ ɔdɛ gbanà adzɛ ɔkɔ Isak."<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />Axɔɛdɛ ebisi yɛasɛ, "Pɛ adzɛɛ atɛapɛ asɛ ababa nimɛ gɛ onupɛ itsodzi ba kesiakpa alɛ nabha xɔ̃ɔ? Idzinɔ wɔeyianyɛ vɛnɔ kesiakpa gɛ kalɛ abha wodeɛ dza?"<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />Abraham aɖɔ asɛ, "Ɖi kɛlɛ ɔkɔ sɛ ogìdzìnɔ mɛeyianyɛ ɔvɛnɔ ɛkɛlɛ. <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />Apalete Owusoso Akaa gɛede kititíɛ, anɔ gɛ yɛebumɛ eyinɔ nɛ mɛakaa bɔpã mɛ, nɛ̀ kesiakpa gɛ kalɛ abha mɛideɛ mɛ, anɔ gɛ yɛaɖɔaɖɔ nɛ mɛ pɛ atɔɖɔ kibui elu akɔ mɛ odenɔ bɔdɔ̃ tatanã mɛ pɛ aaɖɔ asɛ, 'Wɔeyialɛ mɛ balɔkɔ kesiakpa alɛ akɔ'-abakpɛ yɛaxɔɛdɛ asɛsɛ kpɛ wɔotugbà tɛ ɔbɔmɔ̃ adzɛ ɔkɔ mɛeyianyɛ odenɔ ɛkɛlɛ́. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />Onupɛ adzɛ agɛpɛ asɛ aba aplɛnɔ wɔɔ, kɛlɛ́ mɛɔdɔ̃ tatanà ɛlɛ baboele nɛ wɔ shu. Kɛgɛ ɛpɛ yete kɛlɛinu ɔsɛ titsyina mɛeyianyɛ ɔvɛnɔ ɛkɛlɛ́." <verse eid="GEN 24:8" /><verse number="9" style="v" sid="GEN 24:9" />Kliso axɔɛdɛ akpɛ ɔhɔɛɛ nɛ yɛapalete Abraham yɛtsɛɖɛta niesi kɛlɛ atanà bɔdɔ̃ akɔɛ nɛ kibui ɛlɛ shu.<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />Kɛlɛ mɛ axɔɛdɛ alɔkɔ yɛapaleteɛ kipusɔ lɔfɔ pɛ ashɛ, gɛ alɔkɔ bɔdɔ̃ gbangbã ediedi odenɔ yɛapaleteɛ ɔkɔ evũnɔ. Atɔnɔ kidzo avɛ Aram Naharaim, kɛlɛ afala ediyì nɛ Nahɔ ɔmã mɛ. <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />Akɔ kipusɔ nɔ edzu ekuisi esi nɛ bulĩ ozĩɛ gɛɔlɛ ɔmã niedeɛ shu; ɔwlago ɔvɛlɛ na, nɛ kibeɛ gɛ badzɛ ekoeyi edishi bulĩɛ.<verse eid="GEN 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 24:12" />Kɛlɛ ekulu Owusoso Akaa asɛ, "Oo, Apaleteɛ gɛenu mɛapãka Abraham yɛ Owusoso Akaa, kɔmɛ kidzoɔ tɛpɛpɛ̃ obuɔ, tɛ ɔbhɛtɛ ɛyamɛ gbangbã ɔkɔ mɛapãka Abraham. <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />Ɖi, ɛlɔɛtiti nɛ bulĩ ɛlɛ gɛ bude koeyi nɛ tisiɛ mɛ shu, kɛlɛ beyiadzɛ gɛenu ɔmã mɛ eyiɛ aaba ebeshi bulĩɛ. <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />Kɔ kɛba ɛlɛ mɛ ɔsɛ onupɛ itseɖe adzɛnuvɔɛ teli sɛ, 'Ɛkɔ wɔɛ takpu, zhyini wɔ ketsukpu niesi tɛ mɛwɔ̃ɛ wɔliɛ tuliɛ,' pɛ aɖɔ asɛ, 'Wɔɛ, kɛlɛ ɛbakɔ wɔ kipusɔ nɔ tsyɛ'-kɔ yɛedzi anɔgɛ yɛ wobu ɔkɔ wɔaxɔɛdɛ Isak. Ɔganà kibui ɛlɛ nabha, ɛbatì ɔsɛ ɔbhɛtɛ ɛyamɛ gbangbã ɔkɔ mɛapaleteɛ."<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />Xego tɛ ebekulu Owusoso Akaa ebekeɛ, Rebeka ekoeyi aba nɛ̀ yɛetsukpuɔ nɛ yɛ owũdɔɔ. Yɛedzì Betuɛl gɛedzì Milka yɛeyianyɛ yɛeyi adzɛnuvɔɛ, gɛedzi Abraham yɛadza Nahɔ yɛedzini. <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />Adzɛnuvɔɛ nɔ eyi bubite, kebite gɛetinyi anyɛ; anyɛ nanà akawɔsɔ̃ nɛ̀ yɛeɖi. Ezhyi avɛ bulĩɛ gɛ bukoeyì nɛ tisiɛ mɛ shu, eshi bulĩɛ eyukù yɛ ketsukpuɔ mɛ pɛ etsyina aba.<verse eid="GEN 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 24:17" />Axɔɛdɛɛ ebu tɛtsɛɖɛ mɛ pɛ adɛ tɔnɔ yɛ pɛ aɖɔ asɛ, "Ɛkɔ wɔɛtakpu, kɔmɛ wɔ ketsukpumɛ bulĩ nɛbɔɛ."<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />Adzɛnuvɔɛ nɔ aɖɔ asɛ, "Mɛapalete, wɔ̃ɛ," kɛlɛ ezhyini ketsukpu niesi akpɛ yɛhɔɛ mɛ odunũ ɔlɛ kɛlɛ akɔɛ bulĩ.<verse eid="GEN 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 24:19" />Gɛ akɔɛ bulĩɛ yɛawɔ̃ɛ ebekeɛ, adzɛnuvɔɛ nɔ aɖɔ asɛ, "Ɛbàshi kɔ wɔ kipuasɔ nɔ tsyɛ bawɔɛ ɔvɛnɔ ɔsɛ bawɔɛ ebeke." <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />Kliso tsiɔ̃ ɔlɛ koɔ, etsyina bulĩɛ akpɛ kedzrepeɛ mɛ kɛlɛ ebu tɛtsɛɖɛ mɛ avɛ bulĩ oziɛ shu pɛ ewuli edishi bukpè pɛ abakɔ kipuasɔ nɔ tsyɛ petee bawɔ̃ɛ. <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />Nɛ kaɖɔ maɖɔmaɖɔ mɛɛ, anyɛ elu awɔ̃ eɖi kpakpamii tɛ etì asɛ Apaleteɛ abhɛtɛ yɛidzo gagãa mɛ sɛ kɛpɛ̃ pɛnɔsɛ kɛgɛ pɛ.<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />Gɛ kipuasɔ nɔ awɔ̃ɛ bulĩɛ ebekeɛ, anyɛ ebu kɛnyɔtɔ̃ sikãdzadzã kisikpɛ, gɛ kɛlɛ bupu mɛ bazã asɛ pɔ̃ɔ zɛzɛ ana nɛ̀ sikãdzadzã kahɔkpɔ kabhɛ gɛ kalɛ bupumɛ bazã asɛ pesewa lɔfɔ anà. <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />Kɛlɛ ebisi asɛ, "Afana yɛeyiadzɛ wɔonu? Ɛkɔwɔ kɛtakpu sɛ tɛ otseɖe mɛ, buvũ lɛ wɔakaa ahɔɛ nɛ bɔpãmɛ gɛ bɔbamɔ̃ ɔzakɔ elishi alɛ dza?"<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />Ebuiliulũ akɔɛ asɛ, "Betuɛl yɛeyiadzɛ mɛinu, eyianyɛ gɛ Milka amɔ́ akɔ Nahɔ." <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />Kɛlɛ aɖɔ aplɛnɔ asɛ, "Tɛwɔ̀a kpakpáa nɛ̀ baagã bɔŋaŋã gelee alɛ bɔlɔ ahɔɛ nɛ̀ buvũ tsyɛ kɔ wɔnɔ tɛ nɔza nɛ elishiɛ."<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />Kɛlɛ mɛ anyɛ ezhyi ekumũ pɛ akpɛ kɛtakpuiesi akɔ Apaleteɛ, <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />pɛ aaɖɔ asɛ, "Nɔkpɛ Apaleteɛ yɛinye nɛitití, mɛ apalete Abraham yɛ Owusoso Akaa, anɔ gɛ agɛ shɛnɛ ahɔɛ yɛ ɛyamɛ gbangbã nɛ̀ kibui abha tɛbhɛbhɛtɛ shu ɔkɔ mɛ apalete Abraham. Mɛxɔnɔɔ, Apaleteɛ agbanà mɛ nɛidzo gagã nabha ɔvɛnɔ mɛ apaleteɛ yɛeshopo alɛ ɔkɔ."<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />Adzɛnuvɔɛ nɔ ebu tɛtsɛɖɛ mɛ avɛ yɛelĩ bɔpãmɛanɛ ɔkɔ pɛ editseɖe alɛ ebui alɛ. <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />Otsinɔ, adzya teli azã Rebeka ahɔɛ gɛ bekulu asɛ Laban, kɛlɛ ebú tɛtsɛɖɛ mɛ tsiɔ̃ ɔlɛ ekoeyi avɛ anyɛ nɔbhà nɛ bulĩɛ gɛide okoeyi nɛ tisiɛ mɛ ɔbhà. <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />Odunũ ɔlɛ gɛ amɔ̃ kɛnyɔtɔ̃ sikãkisikpɛ nɔ nɛ̀ sikãkadzã kabhɛ nɛ yɛada kahɔkpɔ, pɛ etilũ kɛgɛ Rebeka etitseɖe yɛ nɛ kibuiɛ gɛ anyɛ etseɖe yɛ shu soɔ, avɛ anyɛ ɔbhà kɛlɛ amɔ yɛ gɛ alɔɛtití nɛ kipuasɔ nɔ balɛ ɔbhà nɛ bulĩɛ gɛ bukoeyi nɛ tisiɛ mɛ shu. <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />Aɖɔ asɛ, "Ba, wɔ anɔ gɛ Apaleteɛ eyulà akɔ. Kiɖeso pɛ oli kitití nɛ ɛkɛlɛ ana? Iti woese bɔpãmɛ lu, nɛ̀ ɔzãkɔ akɔ wɔ kipuasɔ nɔ."<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />Kliso anyɛ avɛ bɔpãmɛ, kɛlɛ batsɛ etukuɔ nɛ kipuasɔ nabha. Balɔkɔ tɛwɔ̀a kpakpa nɛ̀ bagã bɔŋaŋã amanà kipuasɔ nɔ, nɛ̀ bulĩ kɔ yɛ nɛ̀ banyɛɛ gɛ balɛ yɛ kedeɛ tɛ bepulu balɛ bɔtsɛɖɛkpɔ. <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />Kɛlɛ bedzù bɔŋaŋã nɛ yɛotugbaa, pɔ aɖɔ asɛ, "Ɛtɛbà ŋã bɔdɔ̃ ɔdɛkpɛnɔ gɛ itseɖe wɔnɔ kɛgɛ lɛ mɛahɔɛ sɛ mɛɖɔ." Laban aɖɔ asɛ, "Kɛɛlɛ́ tseɖe bɔlɔ."<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />Kliso aɖɔ asɛ, "Abraham yɛaxɔɛdɛ mɛinu. <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />Apaleteɛ eyulà akɔ mɛ apaleteɛ gelee, kɛlɛ ebedzì ehoeyi elete. Akɔɛ ibhoshì nɛ̀ banɛntsyɔɛ, sikãfufu nɛ̀ sikãdzadzã, banyɛ axɔɛdɛ nɛ̀ badzɛ axɔɛdɛ, nɛ̀ kipuasɔ nɛ̀ badiku. <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />Mɛ apaleteɛ yɛedzini Sara amɔ́ eyianyɛ akɔɛ nɛ yɛ tisheshè mɛ, kɛlɛ alɔkɔ kɛkanyiaka gɛlɛ yɛahɔɛ akɔ yɛ. <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />Kɛlɛ mɛ apaleteɛ akɔ mɛ tanã bɔdɔ̃ pɛ ɛɖɔ ɔsɛ, 'Kɛma ɔsɛ ɔgbanà adzɛ ɔkɔ mɛeyianyɛ odenɔ Kana beyiadzɛ mɛ, gɛ balɛ kesiakpa nabha mɛ lɛɛ mɛ, <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />pɔ, vɛ mɛaka beshopoɔ alɛ ɔkɔ nɛ̀ yɛ kigbogbo nɛishi tɛ ɔdɛ gbana adzɛ ɔkɔ mɛeyianyɛ.'<verse eid="GEN 24:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 24:39" />"Kɛlɛ ibisi mɛ apaleteɛ ɔsɛ, 'Kiɖe mɛbhɛtɛ onupɛ adzɛ agɛ dɛmɛ asɛ abà aplɛnɔ mɛ?'<verse eid="GEN 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 24:40" />"Ebuiliulũ asɛ, 'Apaleteɛ gɛ yɛamɛ mɛgãa, abakpɛ yɛaxɔɛdɛ aplɛnɔ wɔ kɛlɛ abakɔ asɛ wɔ kidzo gagãa babà ɛlɛ mɛ, sɛ tɛ ɔmɔ adzɛ ɔgbanà ɔkɔ mɛeyianyɛ odenɔ mɛahɔɛ kigbogboɔ mɛ, nɛ̀ mɛaka yɛishopo alɛ mɛ. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />Kɛlɛ, ɔvɛ mɛ kigbogboɔ mɛɛ, bebè boele wɔ nɛ mɛ tɛtatanã mɛ kɛlɛ onupɛ kɛba ɛlɛ mɛ ɔsɛ bagɛ lɔkɔ adzɛɛ akɔwɔ tsyɛɛ-bebè boele wɔ nɛ mɛ tɛtatanà mɛ.'<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />"Gɛ ɛba bulĩɛ gɛide tisiɛ mɛ koeyì shu obuɔ, ɛɖɔ ɔsɛ, 'O Apalete, mɛ apalete Abraham yɛ Owusoso Akaa, onupɛ ɔdɛmɛɛ, ɛkɔ wɔɛtakpu, kɔ kɛgɛ kɛlɛ shu sopɛ ɛgã kidzoɔ pɛ̃ kɔmɛ. <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />Ɖi, ɛlɔɛtití nɛ bulĩ gɛikoeyi nɛ tisiɛ mɛ shu; onupɛ adzɛnuvɔɛ teli ekoeyi asɛ ebeshi bulĩ pɛ itseɖe yɛɔsɛ, "Ɛkɔ wɔɛtakpu kɔmɛ wɔ ketsukpu mɛ bulĩɛ tuli," <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />kɛlɛ onupɛ aɖɔ etseɖe mɛ asɛ, "Wɔ̃ɛ, tɛ mɛishi akɔ wɔ kipuasɔ nɔ tsyɛ bawɔ̃ɛɛ," kɔ yɛedzì agɛ yɛ Apaleteɛ ebu akɔ mɛ apaleteɛ yɛeyianyɛɛ.'<verse eid="GEN 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 24:45" />"Flogo tɛ ɛyɔlɔ Owusoso Akaa tikukluɔ nɛ mɛ kituɔ mɛɛ, Rebeka ekoeyi aba, gɛ yɛ ketsukpuɔ etsiɖì yɛ owũdɔ. Ezhyi avɛ bulĩɛ gɛ bukoeyì nɛ tisiɛ mɛ shu kɛlɛ edishi bulĩ, kɛlɛ itseɖe yɛɔsɛ, 'Ɛkɔ wɔɛtakpu, kɔmɛ bulĩ tɛ mɛwɔ̃ɛ.'<verse eid="GEN 24:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 24:46" />"Ezhyini yɛ ketsukpu niesi tsiɔ̃ ɔlɛ odenɔ yɛ owũdɔ pɛ aɖɔ asɛ, 'Wɔ̃ɛ, tɛ mɛkɔ wɔ kipuasɔ nɔ tsyɛ.' Kliso gɛ ɛwɔ̃ɛ, akɔ mɛ kipuasɔ nɔ tsyɛ.<verse eid="GEN 24:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="GEN 24:47" />"Ibisi yɛɔsɛ, 'Afana yɛeyiadzɛ wɔonuɔ dza?'</para>
  <para style="p" vid="GEN 24:47">"Aɖɔ asɛ, 'Betuɛl, Nahɔ yɛeyianyɛ gɛ Milka amɔ̃ akɔɛ yɛeyiadzɛ mɛinu.'</para>
  <para style="p" vid="GEN 24:47">"Kɛlɛ ɛkpɛ kisikpɛ nɔ ɔkɔɛ nɛ kɛnyɔtɔ̃, pɛ ɛlɔkɔ kahɔkpɔ kabhɛ akpɛ yɛhɔɛɛ, <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />kɛlɛ mɛizhyi kumũ pɛ ɛkpɛ Apaleteɛ kinyeɛ nɛitití. Ɛkpɛ Apaleteɛ, mɛ apalete Abraham yɛ Owusoso Akaa nɛinye nɛitití, agɛ yɛagbana mɛ nɛidzo gbangbã nabha pɛ ɛbamɔ̃ mɛ apalete Abraham yɛadzya yɛeshui yɛeyi adzɛnuvɔɛ akɔ yɛeyianyɛ. <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />Otsiɛ nɔ onupɛ ɔ́bɔ kasɛ ɛyamɛ gbangbã nɛ̀ kibui abha tɛbhɛbhɛtɛ ɔkɔ mɛ apaleteɛ, tseɖe mɛ; onupɛ ɔtɛbɔ bhɛtɛ ana tsyɛɛ, tseɖe mɛ, tɛ mɛitì kidzo nɔnɔ gɛ ɛbalɔkɔ."<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />Laban nɛ̀ Betuɛl ebuiliulũ asɛ, "Apaleteɛ ɔkɔ kibui ɛlɛ de; bɔza la kɛnanà tseɖe wɔnɔ nɛ kidzo nanà abha. <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />Rebeka naalɛ; gbanà yɛ tɛ ɔshɛ, tɛ ɔkɔ yɛedzi wɔapaleteɛ yɛeyianyɛ yɛedzinì, asɛ kidzoɔ gɛ Apaleteɛ akasɛ."<verse eid="GEN 24:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 24:52" />Kibeɛ gɛ Abraham yɛaxɔɛdɛ elũ kibuiɛ gɛ baɖɔɔ, ezhyi ekumũ kesiakpa akɔ Apaleteɛ. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />Kɛlɛ axɔɛdɛ ebu sikãdzadzã nɛ̀ sikãfufu bɔdɔ̃ɔ eyinɔ, ɔplɛnɔ bakpɛkpɛ ediedi pɛ alɔkɔ akɔ Rebeka; azalɔkɔ bɔdɔ̃ gɛ yɛkɛ kedzi akɔ yɛadzya nɛ̀ yɛelĩɛ tsyɛ. <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />Kɛlɛ yɛ nɛ banyɛ gɛazã yɛɔbhà baŋã pɛ bawɔ̃ɛ pɛ baza elishiɛ nɛ ɛkɛlɛ. Gɛ balɔ kelizaza mɛ, aɖɔ asɛ, "Nɔkpɛ mɛidzo tɛ mɛvɛ mɛ apaleteɛ ɔkɔ."<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />Pɔ Rebeka yɛadzya nɛ̀ yɛelĩɛ ebuiliulũ asɛ, "Kɔ tɛ adzɛnuvɔɛ nɔ azã bɔlɔ ɔbhà asɛ ewui lɔfɔ pɛnɔsɛ kibe ana, flogo tɛ nɔshɛ."<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />Pɔ etseɖe alɛ asɛ, "Nɔtɛ vũmɛ odzù otsiɛ gɛ Apaleteɛ atɛkɔ mɛidzoɔ pɛ̃. Nɔkpɛ mɛidzo tɛ mɛvɛ mɛ apaleteɛ ɔkɔ."<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />Kɛlɛ baɖɔ asɛ, "Nɔkɔ bukulu adzɛnuvɔɛ nɔ tɛ bubisi yɛ kibui nɛ kɛlɛ shu oɖi." <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />Kliso bekulu Rebeka kɛlɛ bebisi yɛasɛ, "Wɔnɛ anyɛ alɛ ɔbɔshɛ dza?"</para>
  <para style="p" vid="GEN 24:58">Aɖɔ asɛ, "Ɛbavɛ." <verse eid="GEN 24:58" /><verse number="59" style="v" sid="GEN 24:59" />Kliso bakpɛ balɛ ada Rebeka kidzo ɔplɛnɔ agɛ yɛeɖi yɛabha nɛ̀ Abraham yɛaxɔɛdɛ nɛ̀ yɛ banyɛ. <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />Kɛlɛ beyulà akɔ Rebeka pɛ betseɖe yɛasɛ,</para>
  <para style="q1" vid="GEN 24:60">Bɔlɔ ada, kpè tɔɖɔ</para>
  <para style="q2" vid="GEN 24:60">vɛnɔ ihotu ɔdɛ tɔɖɔ ihotu abha;</para>
  <para style="q1" vid="GEN 24:60">tɛ wɔeyi mɔmɔ alɛ aŋã</para>
  <para style="q2" vid="GEN 24:60">bagɛ atɛaɖɔ wɔ nabha."<verse eid="GEN 24:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61" />Kɛlɛ Rebeka nɛ̀ bagɛ eɖi yɛabha babalɛ pɛ bewu eku balɛ kipusɔ nabha aplɛnɔ anyɛ. Kliso axɔɛdɛ agbanà Rebeka kɛlɛ ashɛ.<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />Otsinɔ Isak ede Biɛɛ Lahai Rɔi, ɔmɔsɛ azã Nɛgɛv oxui kesiakpa mɛ. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />Ekoeyi ɔwlago tenikpo avɛ ayakpa mɛ tɛ adɛnyɔ̃ yɛishu mɛeɖi, kɛlɛ gɛ ebu bamɛ ewunɔ kabhaa, amɔ kipuasɔ gɛ beetsò aaba. <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />Rebeka tsyɛ ebu bamɛ ewunɔ kabha kɛlɛ amɔ̃ Isak. Ezhyi nɛ yɛ kipusɔ nabha <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />kɛlɛ ebisi axɔɛdɛ asɛ, anyɛ ɖuwoe naalɛ gɛ akpasɛ ayakpa mɛ pɛ aba atsyana bɔlɔ dza?"</para>
  <para style="p" vid="GEN 24:65">Axɔɛdɛ ebuiliulũ akɔɛ asɛ, "Yɛenu mɛ apaleteɛ." Kliso alɔkɔ yɛ bamɛ kɛpɔtɛ adã yɛishuɔ.<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />Kɛlɛ axɔɛdɛ etseɖe Isak ebuiɛ petee gɛ abhɛtɛ. <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />Isak agbanà Rebeka avɛnɔ yɛelĩ Sara kɛpɔtɛ kagbaa mɛ, kɛlɛ agbanà yɛ. Kliso edzì yɛedzinì, kɛlɛ adɛmɛ yɛibui; kɛlɛ Isak amɔ ishumɛ dɔdɔ nɛ yɛelĩ butsí niede.<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s1">Abraham yɛ Titsitsí</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />Abraham azagbanà adzɛ bhlatɔ, gɛ bekulu asɛ Ketura. <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />Amɔ̃ Zimram, Yɔkshan, Mɛdan, Miɖian, Ishbak nɛ̀ Shua akɔ yɛ. <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />Yɔkshan amɔ́ Sheba nɛ̀ Dedan; kɛlɛ Dedan yɛihui nɔ balɛenu Ashuɖianɛ, Letushianɛ nɛ̀ Leumianɛ. <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />Miɖian yɛ beyianyɛ balɛenu; Ɛfa, Efea, Hanɔk, Abiɖa nɛ̀ Elɖaah. Banɔ alɛ nyɔ̃ɔ balɛedzì Ketura yɛ kihui nɔ.<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />Abraham ashɛnɛ ahɔɛ nɛ kɛkanyiaka gɛzã yɛahɔɛ shu akɔ Isak. <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />Pɔ nɛ kibeɛ gɛ azã nɛkpãa, azakɔ beyianyɛ gɛ amɔ̃ nɛ yɛ bagɔlɔ alɛ shuɔ bɔdɔ̃ kɛlɛ akpɛ alɛ kidzo asɛsɛ kesiakpa gɛalɛ kiwuiɛ otukɔɔ nɛ yɛeyianyɛ Isak ishu.<verse eid="GEN 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />Balɔkɔ akpɛ kitsùɔ, Abraham azã nɛkpã agɔ kɛkpã zɛzɛ nɛ̀ afɛtegegene nɛ̀ teeti. <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />Kɛlɛ Abraham afuĩa yɛ ɔfɔfuiã gɔgɔɛ pɛ etsí nɛ tisheshè gbangbã mɛ, anɔ sheshè gɛ aŋã agɔ gelee, kɛlɛ bavɔbɔ yɛ aplɛnɔ yɛeshopo alɛ. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />Yɛ beyianyɛ Isak nɛ̀ Ishmael badɛ vɔbɔ yɛ nɛ aklagbu ozĩɛ gɛɔlɛ Makipela gɛ etso aplɛnɔ Mamrɛ, nɛ Efrɔn gɛenu eyianyɛ kɔ Zoha gɛenu Hittieyiɛ yɛ kesiakpa mɛ, <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />kesiakpa gɛ Abraham edzì odenɔ Xitianɛ ɔkɔ. Ɛkɛlɛ bavɔbɔ Abraham aplɛnɔ yɛedzini Sara. <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />Nɛ Abraham butsí niedeɛ, Owusoso Akaa eyula akɔ yɛeyianyɛ Isak, anɔ gɛ azã Biɛɛ Lahai Rɔi ɔbhà nɛ kibe ɛlɛ mɛ.<verse eid="GEN 25:11" /></para>
  <para style="s1">Ishmael Yɛ Beyianyɛ</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />Ebuiɛ gɛ bamɔ̃ aɖɔ nɛ Abraham yɛeyianyɛ Ishmael gɛ Sara yɛaxɔɛdɛ Haga Egiptedziɛ amɔ̃ akɔ Abraham naalɛ.<verse eid="GEN 25:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="GEN 25:13" />Ishmael yɛ beyianyɛ nɛ kɛmɔ gɛ bamɔ̃ alɛ naalɛ: Nɛbaiot yeɛdzì eyikusi gɛ Ishmael amɔ̃, Kɛɖa, Aɖbel, Mibsan, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />Mishma, Duma, Massa, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />Haɖaɖ, Tɛma, Yetɔ, Nafish nɛ̀ Kedema. <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />Ishmael yɛ beyianyɛ, egbogbo ekusi lɔfɔ nɛ̀ taabha nɛ balɛ kɛkɔtɔ nɛ̀ balɛ kazãa banɔ alɛ enyeɛ naalɛ. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />Balɔkɔ akpɛ kitsùɔ, Ishmael azã nɛkpã agɔ kɛkpã zɛzɛ nɛ̀ afɛata nɛ̀ tegegene. Afuĩa ɔfɔfuĩa gɔgɔɛ kɛlɛ etsí, kɛlɛ balɔkɔ yɛadɛ vɔbɔ aplɛnɔ yɛeshopo alɛ. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />Yɛ kihui nɔ bhui kazã nɛ Havila ɔvɛnɔ Shɛɛ bɔdɔmɛ, gɛ etso ɔplɛnɔ Egipte buboɔ, onupɛ ɔvɛ Ashɛɛ kibé. Kɛlɛ bazã nɛ otití mɛ nɛ balɛ adzya alɛ petee shu.<verse eid="GEN 25:18" /></para>
  <para style="s1">Yakob nɛ̀ Esawu</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />Ebuiɛ gɛ bamɔ̃ aɖɔ nɛ Abraham yɛeyianyɛ Isak shuɔ naalɛ. Abraham amɔ́ Isak,</para>
  <para style="b" vid="GEN 25:19" />
  <para style="p" vid="GEN 25:19">Abraham ebedzì akaa akɔ Isak, <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />kɛlɛ Isak aŋã agɔ afɛtaalɛ nɛ kibèɛ gɛ agbanà Rebeka gɛenu eyiadzɛ akɔ Betuɛl Aramueyiɛ gɛede Paddan Aramu nɛ̀ ada akɔ Laban Aramueyiɛ.<verse eid="GEN 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 25:21" />Isak ekulu Apaleteɛ nɛ yɛedziniɛ kinye mɛ, ɔmɔsɛ yɛ kamɔmɔ̃vũɔ adã. Apaleteɛ adɛmɛ yɛ tikukuluɔ akɔɛ, kɛlɛ yɛedzinì Rebeka ebemunu ɛya. <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />Beyiɛ bawlɔãkɛ nɛ̀ bagɔlɔ nɛ ɛyamɛ, kɛlɛ aɖɔ asɛ, "Kiɖeso pɛ kibui ɛlɛ ba mɛabha ana? Klisoɔ, avɛ edibisi odenɔ Apaleteɛ ɔkɔ.<verse eid="GEN 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23" />Apaleteɛ etseɖe yɛasɛ,</para>
  <para style="q1" vid="GEN 25:23">Amadi taabha akpasɛ wɔ kamɔmɔ̃vũɔ mɛ,</para>
  <para style="q2" vid="GEN 25:23">kɛlɛ banɔ taabha gɛ akpasɛ wɔ mɛɛ ebebu bagɔlɔ ɔtɔ;</para>
  <para style="q1" vid="GEN 25:23">kɛmadi tinikpo bagagalĩ ɔdɛ kɛbhalaa,</para>
  <para style="q2" vid="GEN 25:23">kɛlɛ esheshèɛ abakpɛ kɛtakpuesi akɔ ebluibhlui nɔ."<verse eid="GEN 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />Gɛ kibeɛ na akɔɛ asɛ amɔɔ, taabha eyianyɛ balɛ azã yɛ kamɔmɔ̃vũɔ mɛ. <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />Agɛ ekoeyi eputɔ nɔ adzã, kɛlɛ yɛishupiɛ petee yì tɛkã asɛ tɛkã kɛpɔtɛ́; klisoɔ bakɔ yɛinye asɛ Esawu. <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />Kɛlɛ niedeɛ, yɛadzya ekoeyi, gɛ yɛɔhɔɛ anyanã Esawu katsɛɖɛkpɔ niede ovunũ; kliso bakɔ yɛinye asɛ Yakɔb. Isak aŋã agɔ afɛteehlo flogo pɛ Rebeka amɔ̃ alɛ.<verse eid="GEN 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />Banyɛnuvɔɛ nɔ eshè, kɛlɛ Esawu ebedzì abhɛbhɛ̃ gɛ atɛ́tafã, kifutù mɛ anyɛ, gɛ Yakɔb xɔnɔ edzì anɔ yɔyɔ, gɛ azã kɛpɔtɛ bɔgba nɛishi. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />Isak gɛ yɛ kineke zã kifutù mɛ bagã shuɔ, adɛmɛ Esawu kibui, pɔ Rebeka adɛmɛ Yakɔb ibui.<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />Kiwui tinikpo gɛ Yakɔb azagbã oɖutsu nɔ, Esawu ede ayakpa mɛ aba nɛ̀ bɔbhɛ. <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />Etseɖe Yakɔb asɛ, "Kɔ yɛatsɔ̀, kɔmɛ wɔ oɖutsu dzadzã telí! Bɔbhɛ dɛ mɛ́!" (Kliso pɛ bekulu yɛ tsyɛ asɛ Edom)<verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />Yakɔb ebuiliulũ akɔɛ asɛ, "Dɛ wɔ osheshe ɔŋãkɔ kɔmɛ flogo."<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />Esawu aɖɔ asɛ, "Ɖi, ɛba batsí. Kɛgbagbã ɖuwoe gɛlɛ osheshe ɔŋãkɔ akɔ mɛ?"<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />Pɔ Yakɔb aɖɔ asɛ, "Tanã bɔdɔ̃ akɔ mɛ kpɛ otugba." Klisoɔ atanà bɔdɔ̃ akɔɛ, kɛlɛ adɛ yɛ osheshè ɔŋãkɔ akɔ Yakɔb.<verse eid="GEN 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 25:34" />Kɛlɛ Yakɔb akɔ Esawu abolo teli nɛ̀ oɖutsu gbagbãa teli. Atã pɛ awɔ̃ɛ, kɛlɛ alɔ pɛ ashɛ.</para>
  <para style="p" vid="GEN 25:34">Kliso Esawu akpɛ yɛ osheshè ɔŋãkɔ nɔtsɔ̃.<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s1">Isak nɛ̀ Abimɛlɛk</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />Otsiɛnɔ bɔbhɛ dɔ nɛ kesiakpa nabha-gɛ bɔgã ɔtɔ nɛ bɔgɛ dɔ nɛ Abraham yɛibeɛ-kɛlɛ Isak avɛ Filisianɛ ekusi Abimɛlɛk ɔkɔ nɛ Geɖa. <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />Apaleteɛ ebu yɛishu akasɛ Isak kɛlɛ aɖɔ asɛ "Tizhyi ɔvɛ Egipte; zã kesiakpa gɛ kalɛ abha mɛba tseɖe wɔ ɔsɛ tɛ ɔzã. <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />Zã kesiakpa alɛ abha kɛbɔɛ, kɛlɛ ɛbazã plɛnɔ wɔ pɛ ɛba yulà akɔ wɔ. Ɔmɔsɛ wɔnɛ wɔ beshuialɛ mɛba lɔkɔ busiakpa alɛ akɔ tɛ ɛbhɛtɛ tɔɖɔ atabuɔ gɛ yɛ mɛka kɔ wɔ aka Abraham nabha. <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />Ɛbakɔ wɔeshuialɛ tɛkakalà mɛ kpe asɛ awɔɛ nɛ kɛlɛ́ɛ nɔ mɛ kɛlɛ ɛbà lɔkɔ busiakpa alɛ petee kɔ alɛ, kɛlɛ ɔgana wɔeyi mɔmɔ́ alɛ nabha, bebe yulà akɔ amadiɛ petee nɛ kesiakpa nabha, <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />ɔmɔsɛ Abraham elũatɔ̃ akɔ mɛ kɛlɛ abhɛtɛ atɔɖɔ kɛgɛ ibisi odenɔ yɛahɔɛ, mɛ ɛsha kɔkɔɔ, mɛ keplukpamɛ ɛshaa, nɛ̀ mɛ ɛsha kpɛkpɛ nabha." <verse eid="GEN 26:5" /><verse number="6" style="v" sid="GEN 26:6" />Klisoɔ Isak adɛzã Gɛɖa.<verse eid="GEN 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 26:7" />Gɛ banyɛ gɛazã ɛkɛlɛ ebisi asɛ tɛ betì yɛedziniɛ, aɖɔ asɛ, "Mɛada yɛenu," ɔmɔsɛ kifu ziyii tɛ aɖɔ asɛ, "Mɛedzini yɛenu." Eɖi asɛ, "Banyɛ nɛ ɛkɛlɛ ebeyìi mɛ nɛ Rebeka ɛtakpu, ɔmɔsɛ eyì bubite."<verse eid="GEN 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 26:8" />Gɛ Isak azã ɛkɛlɛ nɛ kibè dzololoɔ mɛɛ, Abimɛlɛk gɛedzì Filisteanɛ ekusiɛ eɖi kesiɛ asɛsɛ ɔganà fɛsrɛ nɔ mɛ kɛlɛ amɔ gɛ Isak aalahɔɛ nɛ yɛedzini Rebeka shu. <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />Kliso Abimɛlɛk ekulu Isak pɛ aɖɔ asɛ, "Wɔedzinì yɛenu kɛgbãa! Kiɖeso pɛ ɔɖɔ ɔsɛ, 'Mɛada yɛenu dza'?"</para>
  <para style="p" vid="GEN 26:9">Isak ebuiliulũ akɔɛ asɛ, "ɔmɔsɛ iɖi sɛ mɛkpã bakoeyì nɛ yɛtakpu."<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />Kɛlɛ mɛ Abimɛlɛk aɖɔ asɛ, "Kibui ɖuwoe lu idi nɛ ɛlɛ wɔbhɛtɛ nɛ̀ bɔlɔ ana? Banyɛ ɔmayɛmɛ teli ata wɔsɔ̃ nɛ̀ wɔedzini pɛ ɔtɔ mana kibui zizĩ nɛ bɔlɔ abha."<verse eid="GEN 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 26:11" />Kliso Abimɛlɛk akpɛ banɔnɔ petee ɔsha asɛ: "Anɔnɔ gɛ awɔà ɔfɔ̃ nɛ anyɛ alɛ alo yɛedzinu shuɔ, bebeyii gɛ kɛtɛ batsyina."<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />Isak awɔà kɛŋaŋã nɛ kesiakpa alɛ nabha nɛ kɛgɔ ɛlɛ mɛ, kɛlɛ nɛ kɛgɔ ɛlɛ mɛɛ, apɔ̃ bɔdɔeyi nɛ akpã edi tɔtɔɖɔ mɛ ɔmɔsɛ Apaleteɛ eyulà akɔɛ. <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />Anyɛ ebedzì ehoeyielete, kɛlɛ yɛehoeyi tɛmɔmɔ̃ zɛmɔ́ atɔɖɔ ɔdɛ kpɛnɔ gɛ ebedzì ehoeyielete gbagbala. <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />Baagã nɛ̀ baanɛntsyɔɛ azã yɛahɔɛ gbĩ nɛ̀ baxɔɛdɛ gɛ kɛkɔ ɔsɛ Filisteanɛ azakpɛ yɛawɔ̃. <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />Kliso bulĩ iziɛ gɛ yɛaka baxɔɛdɛ ebú nɛ yɛaka Abraham kibeɛ, Filisteanɛ etũ bɔdɔ̃ akpɛ ɛlɛ mɛ, kɛlɛ balɔkɔ tisi eyukú ɛlɛ mɛ.<verse eid="GEN 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16" />Kɛlɛ mɛ Abimɛlɛk etseɖe Isak asɛ, "Shɛ nɛ bɔlɔ ɔbhà; ohumi obokù wɔahɔɛ faanɔ ɔkɔ bɔlɔ."<verse eid="GEN 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 26:17" />Kliso Isak ashɛ nɛ ɛkɛlɛ pɛ edibhui kazã nɛ Gɛɖa kadadasiɛ pɛ atsɛ nɛ ɛkɛlɛ. <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />Isak edzinì bulĩ izĩɛ gɛ bebú nɛ yɛaka Abraham kibeɛ, pɛ Filisteanɛ etsú tisi adã ɛlɛ nɛ Abraham yɛ butsí niede, kɛlɛ akɔ ɛlɛ inye asɛ gɛ yɛaka akɔ ɛlɛ ana.<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />Isak yɛaxɔɛdɛ editsú kadadasiɛ kɛlɛ badɛ tɔnɔ̃ bulĩ ozĩ gɛ ɔdzyɛ ɔkpasɛ bɔlɛ mɛ nɛ ɛkɛlɛ. <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />Pɔɔ Gɛɖanɛ gɛeɖi banɛntsyɔɛ nabha akpɛ ebelà nɛ̀ bagɛ beɖì Isak yɛ banɛntsyɔɛ nabha pɛ baɖɔ asɛ, "Bulĩɛ nu bɔlɔ ɔyɛ!" Kliso pɛ akɔ bulĩ ozĩɛ nɛinye asɛ Isɛk, ɔmɔsɛ bawɔlãkɛ ebui nɛ yɛ nɛ ɔlɛ ɛtakpu. <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />Kliso betsú bulĩ ozĩ bhlatɔ, pɔ bazapɛ ebela nɛ ɔlɛ tsyɛ shu, kliso akɔ ɔlɛ inye asɛ Sitina (Gɛ kɛlɛ esi nu sɛ kitì lɔlɔ) <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />Ashɛ nɛ ɔlɛ ɔbha pɛ ezeditsú bulĩ ozĩ bhlatɔ, pɔ ananà agapɛ ebelà nɛ ɔlɛ xɔnɔ̃ ɛtakpu. Akɔ ɔlɛ inye asɛ Rehobɔt, pɛ aaɖɔ asɛ, "Otsialɛ Apaleteɛ akɔ ɔlɔ ɔzãkɔ kɛlɛ bɔlɔ axɔɛ wɔawɔa abapɛ̃ akɔ ɔlɔ nɛ kesiakpa nabha."<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />Odenɔ ɛkɛlɛɛ, ewu avɛ Biɛsheba. <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />Elishi alɛ Apaleteɛ ebu yɛishu akasɛ yɛ pɛ aɖɔ asɛ, "Mɛinu wɔakaa Abraham yɛ Owusoso Akaa. Tɛosi kifu ɔmɔsɛ ɛlɛ plɛnɔ wɔ; ɛba yulà akɔ wɔ kɛlɛ ɛbakɔ wɔ eshui alɛ tɛkakalà mɛ kpè atɔɖɔ nɛ mɛ axɔɛdɛ Abraham shu so."<verse eid="GEN 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 26:25" />Isak edzu bɔdɔ̃pɔpɔɛ osubha nɛ ɛkɛlɛ pɛ ekulu Apaleteɛ nɛinye. Ɛkɛlɛ yɛedzu yɛ kɛpɔtɛ kagbaa, pɛ ɛkɛlɛ yɛaxɔɛdɛ etsú bulĩ ozĩ.<verse eid="GEN 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />Kidegbaa, Abimɛlɛk alɔ ede Gɛɖa aba yɛɔkɔ, ɔplɛnɔ Ahuzati gɛenu anɔ̃ gɛ yɛehu buluhũ akɔɛ nɛ̀ Fikɔl agɛ yɛedzi yɛ keyuiza otugbazazã elete. <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />Isak ebisi alɛ asɛ, "Kiɖe sopɛ nɔba mɛɔkɔ, gɛ nɔtɛ ɔpɛ mɛamɛ ɔsɛ ɔmɔ̃ pɛ nɔtɛ kaka mɛ tsyɛ?"<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />Bebuiliulũ asɛ, "Bɔmɔ piapi ɔsɛ Apaleteɛ alɛ aplɛnɔ wɔ; kliso pɛ bɔɔɖɔ ɔsɛ, 'Kɛlɛ ɔsɛ olugbù tenikpo tɛbhɛbhɛtɛ gɛide bɔdɔ̃ tɛtatanà mɛ zã bɔlɔɛshi'-bɔlɔ nɛ̀ wɔɛshi. Kɔ bɔbhɛtɛ olugbùshɔshɔ̃ nɛ̀wɔ <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />sɛ ɔtɛ bɔbhɛtɛ kibui zizĩ nanà nɛ̀ bɔlɔ asɛ kanà gɛ bɔlɔ tsyɛ gɛ wɔa ɔfɔ̃ nɛ̀ wɔ, pɔ bɔbhɛtɛ wɔɛbui piapi pɛ bɔkpɛ wɔɛdzo nɛ ishu yɔyɔ mɛ. Kɛlɛ otsiɛ nɔ, Apaleteɛ eyulà akɔ wɔ."<verse eid="GEN 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 26:30" />Nɛ kɛlɛ mɛ, Isak atɔɖɔ kɛŋaŋã ketsukpuifú kɔalɛ, kɛlɛ baŋã pɛ bawɔ̃ɛ. <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />Kelizaza nɛvɔlɔ plii nɔ, banyɛ atanà bɔdɔ̃ akɔ bagɔlɔ. Kɛlɛ mɛ Isak adɛkpɛ balɛ kidzo, kɛlɛ bashɛ nɛ yɛɔbhà nɛ ishuyɔyɔ mɛ.<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />Kiwui ɛlɛ Isak yɔaxɔɛdɛ aba ebetseɖe yɛ kibui nɛ bulĩ oziɛ gɛ bebuɔ shu. Baɖɔ asɛ, "Bɔtɛ mɔ̃ bulĩ!" <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />Akɔ ɔlɛ kinye asɛ Siba, kɛlɛ bɔkpɛnɔ obuɔ, bekulu ɔmã ɔlɛ asɛ Biɛsheba.<verse eid="GEN 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />Gɛ Esawu aŋã agɔ afɛtaalɛ, agbanà Yuɖif, gɛedzì Biɛɖi gɛenu Xitieyiɛ yɛeyiadzɛ, nɛ̀ Basemati gɛedzi Elɔn gɛenu Xitieyiɛ yɛeyiadzɛ. <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />Baanɔ alɛ edzi ɔwɔnyɔnɔ̃ akɔ Isak nɛ̀ Rebeka.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s1">Yakɔb Ayɛkɛ Isak yɛ Tiyuyulà</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />Kibeɛ gɛ Isak eshè pɛ yɛanhũɔ̃ ezĩ pɛ atɛka mɔ̃ɔ, ekulu yɛeyianyɛ sheshèɛ Esawu pɛ etseɖe yɛasɛ, "Mɛeyianyɛ."</para>
  <para style="p" vid="GEN 27:1">Adɛmɛ akɔɛ asɛ, "Mɛ naalɛ."<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />Isak etseɖe yɛasɛ, "Otsialɛ idzì anɔ sheshè kɛlɛ itinyi kiwui nɔnɔ gɛ ɛbatsí. <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />Otsiɛ nɛ kibè ɛlɛ mɛɛ, lɔkɔ wɔ keyuta bɔdɔ̃ɔ-wɔ bɔnyɔ̃ nɛ̀ wɔ bɔnyɔ̃ ɔkpɛtɛ̀-tɛ ɔvɛ ayakpa mɛ tɛ ɔdɛtá ayakpa mɛ bagã teli ɔmanà mɛ. <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />Tɔ kɛŋaŋã dzyɛdzyɛ̃ nɔnɔ ɛbui gɛ ɛdɛmɛ́, tɛ ɔlɔkɔ ɔmana mɛ tɛ mɛŋã, sɛ tɛ ɛlɔkɔ mɛ tiyuyula kɔ wɔ flogo tɛ ɛbatsí."<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />Kibe ɛlɛ mɛ Rebeka azã taatɔ̃ gɛ Isak azaɖɔ kibuiɛ etseɖe yɛeyianyɛ Esawu. Kibeɛ gɛ Esawu ashɛ avɛ ayakpa mɛ tɛ adɛ ta bagãa tɛ alɔkɔ amanaa, <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />Rebeka etseɖe yɛeyianyɛ Yakɔb asɛ, "Ɖi, ilũ gɛ wɔaka etseɖe wɔadzya Esawu asɛ, <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />'Mana mɛ ayakpa mɛ baagã teli tɛ ɔbɔtɔ kɛŋaŋã dzyɛdzyɛ̃ teli akɔ mɛ tɛ mɛŋã, sɛ tɛ ɛbalɔkɔ mɛ tiyuyula kɔwɔ nɛ Apaleteɛ namɛ flogo tɛ ɛba tsí.' <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />Otsiɛ nɔ mɛeyianyɛ, taatɔ̃ piapi tɛ ɔbhɛtɛ kibui nɔnɔ gɛ itseɖe wɔ: <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />Vɛ baagã bɔkã mɛ tɛ obu beepigya taabha manà mɛ, sɛ tɛ ɛlɔkɔ tɔ kɛŋaŋã dzyɛdzyɛ̃ teli akɔ wɔaka, nɛ kana gɛ apɛ nulũ. <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />Tɛ ɔlɔkɔ ɔvɛnɔ wɔaka yɛaŋã, sɛ tɛ alɔkɔ yɛ tiyuyulà akɔ wɔ flogo tɛ ebetsí."<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />Yakɔb etseɖe yɛelĩ Rebeka asɛ, "Pɔ mɛadzya Esawu enu anyɛ gɛ tɛkã lɛ yɛishupiɛ, kɛlɛ mɛpɔ anyɛ gɛ yɛishupi dzi kplɔkplɔ mɛinu. <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />Kɛbaɛlɛ mɛ ɔsɛ mɛaka ehunũ mɛ xɔɔ? Aba mɔ mɛ asɛ ɛbhɛtɛ bɔshɛ mɛ ibui gɛ ɛba mana kibuiɖɔkpɛ anɔ nɛ mɛabha ɔdɛ tiyuyula."<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />Yɛelĩɛ etseɖe yɛasɛ, "Mɛeyianyɛ, kɔ tɛ kibuiɖɔkpɛ anɔ alɛ ba mɛabha. Wɔ xɔnɔ bhɛtɛ kɛgɛ ɛɖɔɔ, vɔ ɔdɛ mana mɛ baagã."<verse eid="GEN 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 27:14" />Kliso avɛ ediyi baagã amanà yɛelĩɛ, kɛlɛ atɔ bɔdɔ̃ dzyɛdzyɛ̃, asɛ gɛ yɛaka apɛ ana. <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />Kidegbaa, Rebeka adɛ lɔkɔ Esawu gɛenu yɛeyianyɛ kusiɛ yɛakpɛkpɛ gbangbã adɛ gɛ alɛ yɛahɔɛ nɛ bɔpãa mɛ, kɛlɛ alɔkɔ akpɛ akɔ yɛeyianyɛ eyideɛ Yakɔb. <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />Aza lɔkɔ epigyapi adã yɛhɔɛ nɛ̀ oli ɔkɔ gɛodzi kplɔkplɔ tsyɛ. <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />Kɛlɛ mɛ yɛalɔkɔ bɔŋaŋã dzyɛdzyɛ̃ gɛ atɔɔ nɛ̀ abolo nɔ gɛ abhɛtɛ akpɛ ahɔɛ akɔ yɛeyianyɛ Yakɔb.<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />Avɛ yɛaka kɔ pɛ aɖɔ asɛ, "Mɛaka."</para>
  <para style="p" vid="GEN 27:18">Adɛmɛ asɛ, "Ee yɛeyianyɛ, afa naalɛ̀?"<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />Yakɔb etseɖe yɛaka asɛ, "Mɛinu Esawu wɔ eyianyɛ kusiɛ. Ɛbhɛtɛ asɛ kana gɛ otseɖe mɛ. Ɛkɔ wɔɛtakpu, lɔzã kitití tɛ ɔtã mɛ ayakpɛ mɛ kɛdzya tili sɛ tɛ ɔkɔ mɛ wɔ tiyuyulaa."<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />Isak ebisi yeyianyɛ asɛ, "Kɛlɛ́ kɛzã pɛ ɔtɛ dɔmɔ agã odunũ ɔlɛ, mɛeyianyɛ?"</para>
  <para style="p" vid="GEN 27:20">Ebuiliulũ asɛ, "Apaleteɛ, wɔ Owusoso Akaa yɛakɔ kibuidzo."<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />Kɛlɛ Isak etseɖe Yakɔb asɛ, "Mɛeyianyɛ tso ɔplɛnɔ mɛ tɛ mɛihunũ wɔ, tɛ mɛiti ɔsɛ kɛgbã wonu mɛeyianyɛ Esawu pɛnɔsɛ sɛ gɛnɛ yɛ dza."<verse eid="GEN 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 27:22" />Yakɔb etso aplɛnɔ yɛaka Isak kɛlɛ ehunũ yɛ pɛ aɖɔ asɛ, "Oliɛ mɛ oyì Yakɔb ɔyɛ, pɔ ɛhɔɛ xɔnɔ nu Esawu ɛyɛ." <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />Agɛ mɔ anɔnɔ gɛ yɛenu, ɔmɔsɛ tɛkã zã yɛhɔɛ shu asɛ yɛadzya Esawu ɔyɛ ana; kliso eyulà akɔɛ. <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />Ebisi asɛ, "Wɔonu mɛeyianyɛ Esawu kɛgbãa dza?"</para>
  <para style="p" vid="GEN 27:24">Ebuiliulũ asɛ, "Yɛ mɛinu."<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />Kɛlɛ mɛ yɛaɖɔ asɛ, mɛeyianyɛ, manà mɛ kifutù mɛ ɛdzyaa teli mɛtã, tɛ ɛkɔwɔ mɛ tiyuyulàa."</para>
  <para style="p" vid="GEN 27:25">Yakɔb alɔkɔ amanà yɛ yɛatã, kɛlɛ amana yɛ wain teli tsyɛ yɛawɔ̃ɛ.<verse eid="GEN 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 27:26" />Kɛlɛ mɛ yɛaka Isak etseɖe yɛasɛ, "Mɛeyianyɛ, ba ɛkɛlɛ tɛ ɔkpɛ ahɔɛ nɛ mɛoli."<verse eid="GEN 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 27:27" />Kliso avɛ yɛɔbha adɛkpɛ ahɔɛ nɛ yɛoliɛ. Gɛ Isak alɔkɔ yɛakpɛkpɛ yɛufifiɛ, eyulà akɔɛ pɛ aɖɔ asɛ,</para>
  <para style="q1" vid="GEN 27:27">"Aa, mɛeyianyɛ nufifìɛ</para>
  <para style="q2" vid="GEN 27:27">dzi asɛ tɛlɔlɔ̃ gɛlɛ bɔyà</para>
  <para style="q2" vid="GEN 27:27">gɛ Apaleteɛ eyula.<verse eid="GEN 27:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="GEN 27:28" />Tɛ Owusoso Akaa akɔ wɔ kititi adzidza dɔdɔ</para>
  <para style="q2" vid="GEN 27:28">nɛ̀ kesiakpa ehoeyi bɔdɔ̃ mɔmɔ̃-</para>
  <para style="q2" vid="GEN 27:28">tɛ wɔ bɔdɔ̃ eyuyuɔ ekpe atɔɖɔ nɛ̀ wain vɔvɔ.<verse eid="GEN 27:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="GEN 27:29" />Tɛ amadiɛ edzi axɔɛdɛ akɔwɔ</para>
  <para style="q2" vid="GEN 27:29">tɛ banɔ akpɛ kɛtakpuesi akɔ wɔ.</para>
  <para style="q1" vid="GEN 27:29">Ŋã Bɔpalete nɛ wɔadzya alɛ nabha,</para>
  <para style="q2" vid="GEN 27:29">tɛ̀ wɔelĩ yɛeyianyɛ akpɛ kɛtakpuesi akɔ wɔ.</para>
  <para style="q1" vid="GEN 27:29">Tɛ baɖɔ kibui akpɛ banɔnɔ gɛ baaɖɔ kibui akpɛ wɔɔ</para>
  <para style="q2" vid="GEN 27:29">tɛ beyulà akɔ bagɛ beyulà akɔ wɔɔ."<verse eid="GEN 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />Gɛ Isak eyulà akɔɛ ebeke pɛ Yakɔb egitsyina kede beke nɛ yɛaka bhaa kɔo, yɛadzya Esawu tsyɛ ede baagã oyikɔ aba. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />Yɛtsyɛ adɛ tɔ bɔdɔ̃ dzyɛdzyɛ̃ teli kɛlɛ alɔkɔ ɔlɛ amanà yɛakaa. Kɛlɛ mɛ yɛetseɖe yɛasɛ, "Mɛaka, lɔzã kitití tɛ ɔtã mɛ kifutù mɛ bɔdzyaa teli, sɛ tɛ ɔkɔ mɛ wɔ tiyuyulàa."<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />Yɛaka Isak ebisi yɛasɛ, "Wɔonu afana?"</para>
  <para style="p" vid="GEN 27:32">Ebuiliulũ akɔɛ asɛ, "Mɛinu wɔeyianyɛ ekusi Esawu."<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />Isak eshuku gbagba pɛ aɖɔ asɛ, "Afa naalɛ gɛ ediyi kifutu mɛ baagã pɛ amana mɛ dza? Ɛtã beke yete pɛ oboku alɛ, kɛlɛ itiyulà kɔɛ-kɛlɛ bebe yulà akɔɛ kɛgbã tsyɛ!"<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />Gɛ Esawuɔ elũ ebuiɛ gɛ yɛaka aɖɔɔ, akpɛ ozĩ gagalĩ nɛ ɔmɔpɔɛ mɛ pɛ etseɖe yɛaka asɛ, "Yula kɔmɛ- mɛ tsyɛ mɛaka!"<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />Pɔ aɖɔ asɛ, "Wɔadzya atɛba ɔgana anɔ wɔɛwɔɛ mɛ pɛ ayɛkɛ wɔ tiyuyulà."<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />Esawu aɖɔ asɛ, "Gɛnɛ yɛ bekulù asɛ Yakɔb dza? Yɛawɔɛ mɛ bɔwɔɛ tɛbha ɛlɛ: Ayɛkɛ mɛ osheshe kɔɔ, kɛlɛ otsiɛ aza yɛkɛ mɛ tiyuyula tsyɛ!" Kɛlɛ mɛ yɛebisi asɛ, "Ɔgɛ balɛ tiyuyula nanà teli olu kɔ mɛ xɔnɔ dza?"<verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />Isak ebuiliulũ asɛ, "Ɛtɛ bhɛtɛ yɛ apalete nɛ wɔabha kɛlɛ ɛtɛ bhɛtɛ yɛeshopo alɛ petee sɛ badɛxɔɛ akɔɛ, kɛlɛ ɛtɛ kɔ sɛtɛ yɛ bɔdɔeyi nɛ̀ wain vɔvɔ apɛ̃ akɔɛ. Kliso kiɖe mɛzɛ babhɛtɛ kɔwɔ otsiɛ, mɛeyianyɛ?"<verse eid="GEN 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38" />Esawu ebisi yɛaka asɛ, "Mɛaka, tiyuyulà tinikpo yete tɛlɛ lɛ wɔahɔɛ dza? Yula kɔ mɛ tsyɛ, mɛaka!" Kibe ɛlɛ mɛ Esawu ebieyo nɛ̀ ozĩ.<verse eid="GEN 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39" />Yɛaka Isak ebuiliulũ akɔɛ asɛ,</para>
  <para style="q1" vid="GEN 27:39">"Wɔ ɔzãkɔ</para>
  <para style="q2" vid="GEN 27:39">lobo yide nɛ kesiakpa ehoeyi bɔdɔ̃ mɔmɔ shu,</para>
  <para style="q2" vid="GEN 27:39">lobo yide nɛ kititi adzidza dɔdɔ shu<verse eid="GEN 27:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="GEN 27:40" />Bɛtɛ wɔbɔ lɔkɔ zã wɔ ɛkpã nɔ</para>
  <para style="q2" vid="GEN 27:40">kɛlɛ ɔbɔdɛ axɔɛ akɔ wɔadza.</para>
  <para style="q1" vid="GEN 27:40">pɔ onupɛ ooshè nɛ bɔtɔ ɔlɛ mɛɛ,</para>
  <para style="q2" vid="GEN 27:40">obo bu yɛ kakɔɔ</para>
  <para style="q2" vid="GEN 27:40">nɛ wɔ oliɛ shu."<verse eid="GEN 27:40" /></para>
  <para style="s1">Yakɔb Ebu Tɛtsɛɖɛ Mɛ Avɛ Laban Ɔkɔ</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />Esawu adɛ kpɛ ebelà nɛ̀ yɛadza nɛ tiyuyulà gɛ yɛaka alɔkɔ akɔɛ shu. Etseɖe yɛishu asɛ, "Ewuiɛ gɛ bɔbabi yoyo nɛ mɛaka kɛtakpuɔ tsoo ba, kibe ɛlɛ mɛ ɛbayi mɛadzya Yakɔb."<verse eid="GEN 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42" />Gɛ bedi tseɖe Rebeka kibuiɛ gɛ yɛeyianyɛ kusiɛ Esawu aɖɔɔ, akpɛ anɔ nɛ yɛeyianyɛ degbaa Yakɔb ɔkɔ pɛ etseɖe yɛasɛ, "Wɔadza Esawu apɛ asɛ tɛ eyi wɔ tɛ alɔkɔ ayɔ ɔmɔpɔɛ nulũ nɔ. <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />Otsiɛ nɛ kibe ɛlɛ mɛ mɛeyianyɛ, bhɛtɛ kibui nɔnɔ gɛ itseɖe wɔ: Bu tɛtsɛɖɛ mɛ tsiɔ̃ ɔvɛ mɛadza Laban yɛɔkɔ nɛ Xaran. <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />Zã yɛɔbhà kibè bɔbhlui ɔvɛnɔ sɛ wɔadzya yɛ ɔmɔpɔɛ nɔ ulũ yɔ. <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />Onupɛ ɔmɔpɔɛ obele wɔadza mɛ nɛ wɔshuɔ pɛ adzɛkɛ kɛgɛ ɔbhɛtɛ nɛ yɛishuɔ, tsyɛ ɛba sɛsɛ wɔ ɔklasɔ̃ tɛ otsyina odenɔ ɛkɛlɛ ɔba. Kiɖe shu sopɛ wɔnɔ taabha obotsi kɔmɛ nɛ kiwui tinikpo abha?"<verse eid="GEN 27:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />Kɛlɛ mɛ Rebeka etseɖe Isak asɛ, "Ɛtɔ̀ nɛ ɛkpã zazã shu nɛ Xitia adzɛ alɛ so. Onupɛ Yakɔb agbana adzɛ nɛ badzɛ alɛ nɛ kesiakpa alɛ nabha mɛɛ, odenɔ Xitianɛ adzɛɛ gɛedzi anaa mɛɛ, kedzi azaazã mɛkpã zazã shu."<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />Kliso Isak eklu Yakɔb pɛ eyulà akɔɛ kɛlɛ akɔ yɛ ɔsha asɛ: "Tɛ gbanà Kanadzì. <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />Vɛ Paɖan Aram odunũ ɔlɛ́, vɛ wɔelũdzua Betuɛl bɔpãmɛ. Gbanà adzɛ kɔ wɔshu nɛ ɛkɛlɛ, odenɔ Laban gɛenu wɔelũdzua yɛ beyiadzɛ nɛishi. <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />Tɛ Owusoso Akaa Ohumielete eyulà akɔ wɔ tɛ akɔ wɔmɔ́ beeyi ɔvɛnɔ ɔsɛ balɛ tɛkakalà mɛ dzi ɔmã. <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />Tɛ akɔ wɔ nɛ̀ wɔeshui alɛ tiyuyulà gɛ akɔ Abraham, sɛ tɛ kesiakpa alɛ abha gɛ nɔotsiɖi otsiɛ asɛ befùɔ kedzì wɔnɔ ayɛ, kesiakpa gɛ Owusoso Akaa akɔ Abraham." <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />Kɛlɛ mɛ Isak akpɛ Yakɔb kidzo, kɛlɛ avɛ Paɖan Aram, nɛ Laban gɛenu Betuɛl yɛeyianyɛ gɛede Aɖamea, pɛenu Rebeka gɛenu Yakɔb nɛ̀ Esawuɔ balɛ elũdzua ɔkɔ.<verse eid="GEN 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />Otsiɛ nɔ Esawu etì asɛ Isak eyulà akɔ Yakɔb kɛlɛ asɛsɛ yɛ nɛ Paɖan Aram tɛ adɛ gbanà adzɛ nɛ ɛkɛlɛ, kɛlɛ gɛ eyulà akɔɛ ebekeɛ, akɔ yɛ ɔsha asɛ, "Tɛ gbanà Kanadzì," <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />kɛlɛ Yakɔb elũatɔ̃ akɔ yɛaka nɛ̀ yɛelĩ pɛ avɛ Paɖan Aram. <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />Kliso Esawu abamɔ kana gɛ Kanadzɛ kibui gɛzã yɛaka Isak uli; <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />kliso avɛ Ismael ɔkɔ pɛ agbanà Mahalat, gɛenu Nebaiot yɛada pɛenù Ishmael gɛenu Abraham yɛeyianyɛ yɛeyiadzɛ pɛ alɔkɔ aplɛnɔ yɛedziniɛ gɛalɛ yɛahɔɛ.<verse eid="GEN 28:9" /></para>
  <para style="s1">Yakɔb Bɔlalaa nɛ Bɛtɛl</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />Yakɔb ashɛ nɛ Biɛsheba kɛlɛ atɔnɔ kidzo avɛ Xaran. <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />Gɛ eku ɔkɔtoliɛ, aza ɛkɛlɛ elishi alɛ ɔmɔsɛ kiwuiɛ tɛdɔ̀. Gɛ alɔkɔ kɛklagbu tili nɛ ɛkɛlɛ, alɔkɔ ɛlɛ eseɖe, kɛlɛ awɔsɔ̃ kesi pɛ eku taɖa mɛ. <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />Aza bɔlalà teli gɛ amɔ antyurɛ gɛ etsiɖi kesiakpa nabha pɛ eli ewu kititíɛ, kɛlɛ Owusoso Akaa yɛaxɔɛdɛ ezewu pɛ bezezhyi nɛ yɛabha. <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />Apaleteɛ alɔɛtiti nɛ yɛadamɛ ɔkɔ ibeɛ pɛ aɖɔ asɛ: "Mɛinu Apaleteɛ, wɔaka Abraham nɛ̀ Isak balɛ Owusoso Akaa. Ɛba lɔkɔ kesiakpa gɛ kalɛ abha wɔ ɔwɔsɔ̃ akɔ wɔ nɛ̀ wɔeshui alɛ. <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />Wɔ eshui alɛ ebekpè asɛ kesiakpa abha osubhududu ana, kɛlɛ ɔbɔ nɛɛ ɔvɛ kiwuiɛ ɔdɔkɔ, kɛlɛ otukɔ, ɔvɛnɔ kesiakpa adamɛ ɔkɔ nɛ̀ kalɛ kesi ɔkɔɔ. Bebe yulà akɔ banɔnɔ petee nɛ kesiakpa nabha ɔganà wɔ nɛ̀ wɔ bɔmɔ̃ɔ nabha. <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />Ɛlɛ ɔplɛnɔ wɔ kɛlɛ mɛanhũ abazã wɔabha nɛ ɔkɔnyiakɔ gɛ ɔvɛɛ, kɛlɛ ɛbadzinì wɔ manà kesiakpa alɛ abha. Ɛtɛbà shɛnɛ ahɔɛ nɛ wɔshu ɔdɛkpɛnɔ ɔsɛ gɛ ɛbhɛtɛ kɛgɛ ɛɖɔlu sɛ ɛba bhɛtɛ kɔ wɔ beke."<verse eid="GEN 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16" />Kibeɛ mɛ gɛ Yakɔb anyɛmɛ odenɔ yɛ taɖa dɔdɔ mɛɛ, abhɛtɛ yɛ asɛ "Kɛgbã Apaleteɛ alɛ ɛkɛlɛ pɛ itinyi." <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />Kifù yii kɛlɛ aɖɔ asɛ, "Ɛkɛlɛ oku ifù! Ɛkɛlɛ̀ otinu ɔkɔ nanà ɔdɛ Owusoso Akaa yɛɔpãmɛ; ɛkɛlɛ ɔlɛ onu kitití kedulũɔ."<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />Kelizaza nɛvɔlɔ plii nɔ, Yakɔb alɔkɔ kɛklagbuɔ gɛ eseɖeɛ edzu kititi asɛ kɛklagbu osi pɛ abalɛ bɔbɔ atɔɖɔ kɛlɛ adamɛ. <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />Akɔ ɛkɛlɛ kinye asɛ Bɛtɛl, gɛ beze kulu ɔmã ɔlɛ asɛ Luz flogo.<verse eid="GEN 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 28:20" />Kɛlɛ Yakɔb aɖɔ kibui elu pɛ aɖɔ asɛ, "Onupɛ Owusoso Akaa abazã aplɛnɔ mɛ pɛ yɛanhũ abazã mɛabha nɛ mɛ kidzo ɛlɛ gɛ ɛgã mɛ pɛ abakɔ mɛ kɛŋaŋã mɛŋã nɛ̀ akpɛkpɛ mɛkpɛɛ, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />sɛ tɛ itsyina avɛ mɛaka bɔpãa mɛ̀ nɛ ishuyɔyɔ mɛɛ, kɛlɛ Apaleteɛ ebedzì mɛ Owusoso Akaa <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />kɛlɛ kɛklagbu ɛlɛ gɛ idzu kititíɛ asɛ kɛklagbu osiɛ badzì Owusoso Akaa bɔpãmɛ, kɛlɛ nɛ bɔdɔ̃ gɛ ɔkɔ mɛ petee mɛɛ, ɛbadzinì bɔlɛ edi lɔfɔ mɛ kɔ wɔ."<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s1">Yakɔb Ediku Paɖan Aram</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />Kɛlɛ mɛ Yakɔb avɛ yɛidzo gagã nabha pɛ ediku kiwui otukɔ banɔnɔ kesiakpa nabha. <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />Ɛkɛlɛ yɛamɔ bulĩ ozĩ nɛ kesiakpa mɛ, gɛ ibhoshi aza tɛta wɔsɔ̃ ɔlɛ ɔbhà ɔmɔsɛ bulĩ ozĩ ɔlɛ mɛ beeshi bulĩ akɔ ibhoshiɛ. Kɛklagbuɔ gɛ balɔkɔ adã bulĩ ozĩ nulũɔ gbogblo. <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />Kibeɛ mɛ gɛ ibhoshiɛ petee bashogo nɛ ɛkɛlɛɛ, ibhoshi agbagbana eleteɛ ebeglebè kɛklagbuɔ atsɛ nɛ ozĩ nulũ kã akɔ ibhoshiɛ nulĩ. Kɛlɛ mɛ bebèdzinì kɛklagbuɔ avɛnɔ adɛdã bulĩ ozĩ nulũ.<verse eid="GEN 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4" />Yakɔb ebisi ibhoshi agbagbana eleteɛ asɛ, "Mɛadzalɛ, fakɔ node?"</para>
  <para style="p" vid="GEN 29:4">Bebuiliulũ asɛ, "Bude Xaran."<verse eid="GEN 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5" />Ebisi alɛ asɛ, "Nonyi Laban, Nahɔ yɛeshui anyɛnuvɔɛ nɔ dza?"</para>
  <para style="p" vid="GEN 29:5">Bebuiliulũ asɛ, "Ee bunyi yɛ."<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />Kɛlɛ mɛ Yakɔb ebisi alɛ asɛ, "Alɛ piapii dza?"</para>
  <para style="p" vid="GEN 29:6">Baɖɔ asɛ "Ee alɛ piapii kɛlɛ yɛeyi adzɛnuvɔɛ Ratsɛl naalɛ yɛaba nɛ̀ ibhoshiɛ."<verse eid="GEN 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7" />Aɖɔ asɛ, "Noɖi mɔ, kiwuiɛ katsiɖì kititíɛ; kibe kaná ɔsɛ tɛ beshogo ibhoshiɛ. Nɔkɔ ibhoshi nulĩ tɛ nodzini ɛlɛ ɔgbana ɔvɛnɔ bɔdɔ̃ ɔŋãkɔ."<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />Bebuililũ asɛ, "Bɔtɛ balà, ɔdɛkpɛnɔ ɔsɛ ibhoshiɛ petee lɛba shogo pɛ buglebè kɛklagbuɔ tsɛ nɛ bulĩ ozĩ nulũ. Kɛlɛ bɔbà kɔ ibhoshiɛ nulĩ."<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />Kibeɛ gɛ azaɖɔaɖɔ naalɛ, Ratsɛl ebeku nɛ̀ yɛaka ibhoshiɛ ɔmɔsɛ adzɛ ibhoshi agbagbana elete yɛenu. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />Kibeɛ mɛ gɛ Yakɔb amɔ̃ Ratsɛl gɛenu yɛelũdzua Laban yɛeyi adzɛnuvɔɛ nɔ nɛ̀ Laban yɛibhoshiɛ, avɛ edi glebè kɛklagbuɔ atsɛ nɛ bulĩ ozĩ nulũ pɛ akɔ yɛelũdzua ibhoshiɛ nulĩ. <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />Kɛlɛ Yakɔb akpɛ ahɔɛ nɛ Raxɛl oliɛ pɛ ashuahɔɛ yoyo mɛ gagalĩi. <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />Etseɖe Ratsɛl asɛ eshopo yɛenu akɔ yɛakaa nɛ̀ eyianyɛ ɔkɔ Rebeka. Kliso ebu tɛtsɛɖɛ mɛ avɛ editseɖe yɛakaa.<verse eid="GEN 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 29:13" />Odunũ ɔlɛ gɛ Laban enyelũ ɔklasɔ̃ odenɔ Yakɔb gɛenu yɛada yɛeyianyɛ ɔkɔ koɔ, alɔ tsiɔ ɔlɛ pɛ adɛ tsyana yɛ. Anyana yɛakpɛ yɛetemɛ̀ pɛ akpɛ ahɔɛ nɛ yɛoli kɛlɛ agbana yɛavɛnɔ yɛɔpãmɛ, ɛkɛlɛ Yakɔb etseɖe yɛ ebui alɛ petee. <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />Kɛlɛ Laban etseɖe yɛasɛ, "Mɛahɔɛ ishudzya nɛ̀ dzyosu wɔonu."</para>
  <para style="s1" vid="GEN 29:14">Yakɔb Agbana Leya nɛ̀ Raxɛl</para>
  <para style="p" vid="GEN 29:14">Gɛ Yakɔb azã yɛɔbhà yɛana woele zɛzɛɛ, <verse eid="GEN 29:14" /><verse number="15" style="v" sid="GEN 29:15" />Laban etseɖe yɛasɛ, "Gɛnɛ sɛ gɛ eshopo wɔonu akɔmɛ so pɛ ɔbɔwɔa axɔɛ kɔmɛ kɛbhɛ mabuia mabuia. Tseɖe mɛ tɛshɛ nɔnɔ gɛ ɔbɔ yɛkɛ."<verse eid="GEN 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 29:16" />Otsi nɔ, beeyi adzɛnuvɔɛ taabha azã Laban ahɔɛ; eshesheɛ nɛinye kɛlɛinu Leya, kɛlɛ eyi anuvɔ nɛinye kɛlɛinu Ratsɛl. <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />Leya anhũɔ apɔɔɖi, pɔ Ratsɛl xɔnɔ̃ afɔ̀ kpɔkpɔlɔ piapi, kɛlɛ eyi bubite. <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />Yakɔb adɛmɛ Ratsɛl kibui pɛ aɖɔ asɛ, "Ɛbawɔà axɔɛ kɔwɔ agɔ tegegene tɛ mɛ gbanà wɔeyi adzɛnuvɔɛ eyideɛ Ratsɛl."<verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />Laban aɖɔ asɛ, "Apɛ akɔmɛ sɛ tɛ ɛlɔkɔ yɛ kɔwɔ ɔdɛ banyɛ bhlatɔ. Zã ɛkɛlɛ ɔplɛnɔ mɛ." <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />Kliso Yakɔb awɔa axɔɛ agɔ tegegene sɛ tɛ agbana Ratsɛl, pɔ azã akɔɛ asɛ ewui bhlui teli yete nɛ kana gɛ adɛmɛ yɛibui so.<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />Kɛlɛ mɛ Yakɔb etseɖe Laban asɛ, "Lɔkɔ mɛedzini akɔ mɛ. Mɛibeɛ na, kɛlɛ ɛpɛ sɛ tɛ ɛwɔsɔ̃ nɛ̀ yɛ."<verse eid="GEN 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 29:22" />Kliso Laban eshogo banɔnɔ petee gɛ balɛ ɛkɛlɛ pɛ edzu bɔ̃ŋaŋã ɔkpɔlɔ̃ kɔalɛ. <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />Pɔ gɛ ɔwlagoɔ ɔnaa, alɔkɔ yɛeyiadzɛ Leya akɔ Yakɔb, kɛlɛ Yakɔb awɔsɔ̃ nɛ̀ yɛ. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />Kɛlɛ Laban alɔkɔ yɛ adzɛaxɔɛdɛ Zilpa akɔ yɛeyiadzɛ sɛ tɛ adɛ axɔɛ akɔɛ.<verse eid="GEN 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 29:25" />Gɛ kɛvɔlɔ naa, Leya pɔ naalɛ! Kliso Yakɔb ebisi Laban asɛ, "Kibui ɖuwoe idi pɔ nɛlɛ wɔbhɛtɛ nɛ̀ mɛ ana? Ɛdɛ kanɔya kɔwɔ nɛ Raxɛl shu, ɛgɛ dɛ bɔyaa dza? Kiɖeso pɛ ɔwɔɛ mɛ?"<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />Laban ebuiliulũ asɛ, "kinu ɔkɔ̀ nɛ ɛkɛlɛ ɔsɛ tɛ bɔlɔkɔ eyideɛ kɔ anyɛ yɛagbana eputɔ akɔ eyi kusiɛ. <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />Bhɛtɛ eyiadzɛ alɛ tɛgbagbana ɔgɔnɛ ɔkɔɔ beke; kɛɛlɛ bɔbà lɔkɔ eyideɛ tsyɛ kɔwɔ, tɛ owuli ɔdɛ kanɔya agɔ tegegene."<verse eid="GEN 29:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28" />Kɛlɛ Yakɔb abhɛtɛ ana. Abhɛtɛ ɔgɔnɛ ɔkɔ ebeke nɛ Leya shu, kɛlɛ Laban alɔkɔ yɛeyiadzɛ Raxɛl akɔɛ asɛ tɛ edzi yɛedzinì. <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />Laban alɔkɔ Bilxah gɛenu yɛadzɛ axɔɛdɛ akɔ Ratsɛl asɛ tɛ edzi yɛaxɔɛdɛ. <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />Yakɔb awɔsɔ̃ nɛ̀ Ratsɛl tsyɛ, kɛlɛ adɛmɛ Ratsɛl ibui adɛ Leya. Kɛlɛ azadɛ kanɔya akɔ Laban agɔ tegegene aplɛnɔ.<verse eid="GEN 29:30" /></para>
  <para style="s1">Yakɔb Yɛeyialɛ</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />Gɛ Apaleteɛ amɔ asɛ agɛ dɛmɛ Leya yɛibui soɔ, adãlɛ yɛ kamɔmɔvũɔ nulũ, pɔ Ratsɛl yɛɔmɔ ohuiɛ nulũ dã. <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />Leya emunù ɛya kɛlɛ amɔ eyianyɛ. Akɔ yɛinye asɛ Rubɛn, ɔmɔsɛ aɖɔ asɛ, "Gɛ Apaleteɛ amɔ mɛ ɔwɔnyɔnɔ̃ so. Otsialɛ mɛenyine aba dɛmɛ mɛibui gɛ kɛtɛ batsyina."<verse eid="GEN 29:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 29:33" />Eze munù ɛya, kɛlɛ gɛ amɔ eyianyɛ, aɖɔ asɛ, "Ɔmɔsɛ gɛ Apaleteɛ elũ asɛ agɛ dɛmɛ mɛibui soɔ, aza kɔmɛ yɛalɛ̀ tsyɛ." Kliso akɔ yɛinye asɛ Simeɔn.<verse eid="GEN 29:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 29:34" />Eze munũ ɛya, kɛlɛ gɛ amɔ eyianyɛ aɖɔ asɛ, "Otsialɛ mɛenyine abakpa yɛishu aplɛnɔ mɛ, ɔmɔsɛ ɛmɔ beyianyɛ taata kɔɛ." Kliso akɔ yɛinye asɛ Levi.<verse eid="GEN 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 29:35" />Eze munu ɛya, kɛlɛ gɛ amɔ eyianyɛ, aɖɔ asɛ, "Kibèlɛ xɔnɔ̃ ɛbakpɛ Apaleteɛ inye nɛititi." Kliso akɔ yɛinye asɛ Yuɖa. Kɛlɛ ebhui bɔmɔ.<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />Gɛ Ratsɛl amɔ̃ asɛ atɛamɔ eyi nanà akɔ Yakɔbuɔ, alɔkɔ kawɔ̃dzã nɛ yɛada shu. Kliso etseɖe Yakɔb asɛ, "Kɔmɛ beeyi, onu gɛnanaa, ɛba tsí!"<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />Yakɔb abakpɛ ɔmɔpɔɛ nɛishu pɛ aɖɔ asɛ, "Mɛlɛ Owusoso Akaa ɔzãkɔ pɛ ɛdã kidzo kɔ wɔeyi mɔmɔ dza?"<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />Kɛlɛ aɖɔ asɛ, " Bilxa gɛenu mɛ adzɛ axɔɛdɛ naalɛ. Wɔsɔ̃ nɛ̀ yɛ tɛ amɔ beyi akɔmɛ sɛ tɛ ganà yɛabha mɛtsyɛ bakpɛ kigbogbo."<verse eid="GEN 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 30:4" />Kliso alɔkɔ yɛaxɔɛdɛ Bilxa akɔɛ asɛ yɛedzini ana. Yakɔb awɔsɔ̃ nɛyɛ, <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />kɛlɛ emunù ɛya pɛ amɔ eyianyɛ akɔɛ. <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />kɛlɛ Ratsɛl aɖɔ asɛ, "Owusoso, Akaa ebu bɔtsyɔa akɔ mɛ, ataatɔ̃ nɛ̀ mɛ kɛtakpu kɔkɔɔ pɛ akɔmɛ eyianyɛ." Nɛ kibui ɛlɛ shu soɔ, akɔ yɛinye asɛ Ɖan.<verse eid="GEN 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 30:7" />Ratsɛl yɛaxɔɛdɛ Bilxa ezemunũ ɛya kɛlɛ amɔ eyianyɛ bhalà akɔ Yakɔb. <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />Kɛlɛ Ratsɛl aɖɔ asɛ, "Kawlɔãkɛ gbagbla eku mɛ nɛ̀ mɛada ɛshi, kɛlɛ ɛŋã kabha." Kliso akɔ yɛinye asɛ Naftali.<verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />Kibeɛ gɛ Leya amɔ asɛ ebhui bɔmɔ̃ɔ, alɔkɔ yɛaxɔɛdɛ Zilpa akɔ Yakɔb asɛ tɛ edzi yɛedzinì. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />Leya yɛaxɔɛdɛ Zilpa amɔ́ eyianyɛ akɔ Yakɔb. <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />Kɛlɛ Leya aɖɔ asɛ, "Kibui gbangbã ɖuwoe lu nɛlɛ!" Kliso akɔ yɛinye asɛ Gad.<verse eid="GEN 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 30:12" />Leya yɛaxɔɛdɛ Zilpa amɔ́ eyianyɛ bhalà akɔ Yakɔb. <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />Kɛlɛ Leya aɖɔ asɛ, "Same ɖuwoe lu gɛ eku mɛ ana! Baadzɛ bebe kulu mɛ asɛ same." Kliso Akɔ yɛinye asɛ Asha.<verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />Nɛ agɔlɛ́ kɛpɔbeɛ, Reubɛn avɛ ayakpa mɛ kɛlɛ adɛmɔ bɔmɔ̃mɔtɛwɔa, gɛ apɔ̃ teli amanà yɛelĩ Leya. Ratsɛl etseɖe Leya asɛ, "Ɛkɔ wɔɛtakpu, kɔmɛ wɔ eyianyɛ yɛ bɔmɔ̃mɔtɛwɔa teli."<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />Pɔ etseɖe yɛasɛ, "Kɛka kpè kɔwɔ gɛ ɔyɛkɛ mɛenyineɛ ɔshɛnɔ dza? Ɔbɔ yɛkɛ mɛeyianyɛ bɔmɔ̃mɔtɛwɔa tsyɛ dza?"</para>
  <para style="p" vid="GEN 30:15">Ratsɛl aɖɔ asɛ, "Abɔ ana, abalà wɔsɔ̃ nɛ̀ wɔ obuɔ elishi tɛ mɛ yɛkɛ wɔeyianyɛ bɔmɔ̃mɔtɛwɔa tuli kpɛ kɛlɛ ulũ."<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />Kliso kibeɛ gɛ Yakɔb ede ayakpamɛ aba ɔwlago ɔlɛɛ, Leya ekoeyi adɛ tsyana yɛ pɛ aɖɔ asɛ, "Kɛlɛ ɔsɛ tɛ ɔwɔsɔ̃ nɛ̀ mɛ. Ɛlɔkɔ mɛeyianyɛ bɔmɔ̃mɔtɛwɔa lɔkɔ buia kɛbhɛ nɛ wɔ tɛwɔwɔsɔ̃ nɛ mɛ kɛtakpu." Kliso awɔsɔ̃ nɛ̀ yɛ elishi alɛ.<verse eid="GEN 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17" />Owusoso Akaa ataatɔ̃ nɛ̀ Leya kibuiɛ kɛlɛ emunù ɛya kɛlɛ amɔ̃ eyianyɛ trimiɛ akɔ Yakɔb. <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />Kɛlɛ Leya aɖɔ asɛ, "Owusoso Akaa abuia kɛlɛ ɛbhɛ akpɛ kɛlɛ ulũ akɔmɛ gɛ ɛlɔkɔ mɛaxɔɛdɛ kɔ mɛenyineɛ." Kliso akɔ yɛinye asɛ Isaka.<verse eid="GEN 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 30:19" />Leya eze munu ɛya kɛlɛ amɔ eyianyɛ hlomiɛ akɔ Yakɔb. <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />Kɛlɛ Leya aɖɔ asɛ, "Owusoso Akaa akɔ mɛ gɛ yɛkɛ kedzi otsialɛ, mɛenyineɛ ababhɛtɛ mɛ piapii, ɔmɔsɛ ɛmɔ beyianyɛ teehlo akɔɛ." Kliso akɔ yɛinye asɛ Zebulɔn.<verse eid="GEN 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 30:21" />Kibe teli ideɛ, amɔ́ eyiadzɛ kɛlɛ akɔ yɛinye asɛ Ɖina.<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />Kɛlɛ Owusoso Akaa abakà Ratsɛl; ataatɔ̃ niyɛ kɛlɛ adãlɛ yɛ kamɔmɔ̃vũ nulũ. <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />Emunũ ɛya kɛlɛ amɔ̃ eyianyɛ, kɛlɛ aɖɔ asɛ, "Owusoso Akaa alɔkɔ mɛ awuĩ nɔ ashɛnɔ." <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />Akɔ yɛinye asɛ Yosɛf kɛlɛ aɖɔ asɛ, "Tɛ Apaleteɛ ewuli akɔmɛ eyianyɛ bhlatɔ aplɛnɔ."<verse eid="GEN 30:24" /></para>
  <para style="s1">Yakɔb Baagã Bekpè Atɔɖɔ</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />Gɛ Ratsɛl amɔ́ Yosɛf ebekeɛ, Yakɔb etseɖe Laban asɛ, "Kpɛ mɛidzo tɛ itsyina vɛ mɛepi. <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />Lɔkɔ mɛedzini alɛ nɛ̀ mɛeyialɛ gɛ balɛ shu mɛdɛ axɔɛ akɔwɔ kɔmɛ tɛ mɛtɔnɔ kidzo. Onyi kɛxɔɛ gɛ ɛwɔa kɔwɔ kɛlɛ tikpèkpe mɛ."<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />Pɔ Laban etseɖe yɛasɛ, "Onupɛ iku awɔ̃ nɛ wɔ anhũɔ mɛ, ɛkɔ wɔɛtakpu tɛ ɔzã. Ɛmɔ odenɔ bɔdɔ̃ bibisi mɛ ɔsɛ Apaleteɛ eyula akɔmɛ nɛ wɔɛtakpu." <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />Aɖɔ aplɛnɔ asɛ, "Tseɖe mɛ wɔaxɔɛ wɔawɔà abhɛɛ, tɛ mɛbuia alɛ."<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />Yakɔb etseɖe yɛasɛ, "Onyi kana gɛ ɛwɔà axɔɛ kɔwɔ, nɛ̀ kana gɛ wɔaagã apɛ̃ akɔ wɔ ɔganà mɛ bɔdɔ̃abha ɖiɖi mɛ. <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />Baagã bhlui nɔ gɛ bazã wɔahɔɛ flogo pɛ ɛbaa bekpe atɔɖɔ, kɛlɛ Apaleteɛ eyulà akɔwɔ nɛ ɔkɔnyiakɔ gɛ ɛdɛ. Pɔ otsiɛ nɔ, kibe ɖuwoe lu mɛba babhɛtɛ kibui teli akɔ mɛtsyɛ mɛɔpã?"<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />Ebisi asɛ, "Kiɖe mɛbà kɔwɔ?"</para>
  <para style="p" vid="GEN 30:31">Yakɔb ebuiliulũ asɛ, "Tɛkɔ mɛ kɛdɔ̃ nanà. Pɔ onupɛ ɔbɔ bhɛtɛ kibui tenikpo ɛlɛ ɔkɔ mɛ, ɛbavɛ ɛlɛ abha zɛ gbanà wɔ baagã pɛ ɛba ziɖi alɛ abha: <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />Kɔ mɛ nyɔ̃ wɔ baagã petee mɛ obuɔ tɛ ibu ibhoshi kanyiaka gɛ ɛlɛ ishuɔ idzi wlãwlã, pɛnɔsɛ ɛgɛ kpɛ ebì, obhoshi eyi tutũ kanyiaka nɛ̀ bepigya kanyiaka gɛ akpɛ ebì pɛnɔsɛ bedzì wlãwlã. Balɛ ebedzi mɛbhɛ babuià. <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />Kɛlɛ mɛ ɛkpã gbangbã babu mɛulũ kivũ mɛ, kibenyiabe gɛ oɖi kɛbhɛ gɛ ɔbuia kɔmɛ. Bɔbà lɔkɔ ɛlɛ ɔsɛ epigya kanyiaka gɛ alɛ mɛɔkɔ pɛ etidzì wlãwlã pɛnɔsɛ ebì amã alɛ shu pɛnɔsɛ nɛ̀ obhoshi kanyiaka gɛ lɔgɛ nɔ, babà lɔkɔ alɛ asɛ bezuɖu alɛ."<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />Laban aɖɔ asɛ, "Ɛdɛmɛ, kɔ kɛzã asɛ kana gɛ ɔɖɔ." <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />Kiwui ɛlɛ ɖii Laban edibu bepigyanyeɛ petee gɛ bedzi wlãwlã pɛnɔsɛ bakpɛ ebì, nɛ̀ bepigyadzɛɛ tsyɛ petee gɛ bedzì wlãwlã pɛnɔsɛ bakpɛ ebì (bagɛ adɔ ebì fufuɔ petee) nɛ̀ ibhoshi eyi tutũɔ petee, kɛlɛ alɔkɔ alɛ akpɛ yɛ beyianyɛ ahɔɛ. <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />Kɛlɛ ebu ewui taata kidzo gagã nɛ yɛ nɛ̀ Yakɔb ishi, gɛ Yakɔb azã ɛlɛ abha pɛ ezeɖi Laban yɛaagã gɔgɔɛ nabha.<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />Pɔ, Yakɔb, edibhui beesiusiwɔɛ wɔwɔ odenɔ pɔpla, almɔnɖ nɛ pleyne beesi shu, kɛlɛ ebu idi fufu nɛ ɛlɛishu gɛ akpà balɛakɔlɔ pɛ ebu balɛ kɛmɛɛ ofufúɔ ɔkɔ akasɛ. <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />Kɛlɛ alɔkɔ busiwɔɛ nɔ gɛ akpà akɔlɔ nɛ bɔlɛ shuɔ akpɛ ɛzɔɔ nɔ mɛ gɛ akpɛ bulĩɛ akɔ baagã, tɛ bazã balɛ otugbà gɛ baba sɛ tɛ bawɔ̃ɛ bulĩɛ. Kibeɛ gɛ bagãa bekù kevudeɛ pɛ babà bulĩ ɔwɔɛkɔɔ, <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />beewu bagɔlɔ abha nɛ busiwɛ nɔ otugbà. Kɛlɛ bamɔ̃ beyi gɛ idì lɛ balɛ ishu pɛnɔsɛ pɛ bedzi wlãwlã pɛnɔsɛ bakpɛ ebi. <verse eid="GEN 30:39" /><verse number="40" style="v" sid="GEN 30:40" />Yakɔb ebu bagãa gɛ bekesheɛ elu ɔtɔ nɛ balɛ ishu ahɔɛ mɛ, pɔ akɔ bagɔgɔ̃ betsyinà bamɛ akpɛ Laban baagã gɛ idiɛ lɛ balɛ pɛenɔ́ betutũɔ. Kliso ebu baagã ɔtɔ akɔ yɛishu kɛlɛ agɛ lɔkɔ alɛ akpɛ Laban yɛagãa mɛ. <verse eid="GEN 30:40" /><verse number="41" style="v" sid="GEN 30:41" />Kibenyiabe gɛ baagã dzɛɛ gɛalɛ ishumɛ gagalĩ eku kevudeɛ, bebeewu balɛ abha nɛ busiwɔɛ nɔbha, <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />pɔ onupɛ baagã balɛ ishumɛ gɛ gagãlĩɛ, agɛza lɔkɔ balɛ akpɛ ɛkɛlɛ. Klisoɔ baagã gɛ balɛ ishumɛ gɛ gagãlĩɛ avɛ Laban ɔkɔ kɛlɛ bagɛ balɛishumɛ gagalĩɛ bavɛ Yakɔb ɔkɔ. <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />Nɛ kidzo ɛlɛ nabhaa, anyɛ amɔ́ atɔɖɔ nɛ ehoeyi mɔmɔ̃ mɛ nyagãa, kɛlɛ ibhoshiza gbagbla, baadzɛ axɔ̃ɛdɛ nɛ̀ baanyɛ axɔɛdɛ, nɛ kipuasɔɔ nɛ̀ badiku babazã yɛahɔɛ.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s1">Yakɔb Ebu Tɛtsɛɖɛ Mɛ Ashɛ Nɛ Laban Ɔkɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />Yakɔb elũ asɛ Laban yɛeyianyɛ alɛ baaɖɔ asɛ, "Yakɔb ayɛkɛ kɛkanyiaka gɛ lɛ bɔlɔ aka ahɔɛ, kɛlɛ amɔ̃ ehoeyi bɔdɔ̃ ɔlɛ petee odenɔ kɛgɛ inu bɔlɔ akaa ayɛ mɛ." <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />Kɛlɛ Yakɔb elu anhũ esi amɔ asɛ Laban ɛkpã gɛ tsyina nɛ yɛishu.<verse eid="GEN 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 31:3" />Kɛlɛ Apaleteɛ etseɖe Yakɔb asɛ, tsyina ɔvɛ wɔaka alɛ kesiakpa nabha nɛ̀ wɔeshopo alɛ ɔkɔ, kɛlɛ ɛbazã aplɛnɔ wɔ."<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />Kliso Yakɔb asɛsɛ Ratsɛl nɛ̀ Leya ɔklasɔ̃ asɛ bekoeyi aba ayakpa mɛ nɛ ɛkɛlɛ gɛ yɛ baagã azãa. <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />Etseɖe balɛ asɛ, "Ɛmɔsɛ wɔnɔ akaa ɛkpã gɛ edzi mana mɛishuɔ abhama asɛ kana gɛ lɛzãa, pɔ mɛakaa yɛ Owusoso Akaa azã aplɛnɔ mɛ. <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />Nɔonyi ɔsɛ ɛlɔkɔ mɛ ohumi nɔ petee wɔa axɔ̃ɛ akɔ wɔnɔ akaa, <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />pɔ wɔnɔ akaa edzyinì mɛakpɛ gɛ atsaɖakɛ mɛxɔɛ wɔwɔa kɛbhɛ babuia kibenyiabe. Pɔ, Owusoso Akaa egibu kidzo akɔɛ asɛ tɛ ezĩ mɛ. <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />Onupɛ aɖɔ asɛ, 'Baagã gɛedzi wlãwlã bedzi wɔ kɛbhɛ babuia nɔ,' kɛɛlɛ baagãa petee abamɔ̃ eyi gɛedzi wlãwlã; kɛlɛ onupɛ aɖɔ asɛ, 'Bagɛ batsà odiɛ balɛenu wɔ kɛbhɛ babuia nɔ,' kɛɛlɛ baagãa petee abamɔ́ eyi gɛ batsà odi. <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />Kliso Owusoso Akaa ayɛkɛ bagãa petee nɛ wɔaka ahɔɛ akɔ mɛ.<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />"Nɛ baagã tɛmɔmɔ ibeɛ, ɛza bɔlalà kiwui tenikpo, nɛ bɔl mɛ ibu bamɛ wunɔ kabha pɛ ɛmɔsɛ bagãnyɛe gɛ beewu baadzɛɛ nabhaa ishuɔ tsà odi, bedzì wlãwlã pɛnɔsɛ bakpɛ ebi. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />Owusoso Akaa yɛaxɔɛdɛ etseɖe mɛ nɛ bɔlaláa mɛ asɛ, 'Yakɔb.' Ɛdɛmɛ ɔsɛ, 'Mɛ naalɛ.' <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />Kɛlɛ aɖɔ asɛ, 'Bu bamɛ wunɔ kabha tɛ ɔmɔ ɔsɛ baagãnyeɛ gɛ beewu baadzɛ nabha balɛ ishuɔ tsà odì, wlãwlã pɛnɔsɛ bakpɛ ebì, pɔ ɛmɔ ebuiɛ petee gɛ Laban aabhɛtɛ amanà wɔ shu. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />Mɛinu Bɛtɛl yɛ Owusoso Akaa, nɛ ɛkɛlɛ gɛ ɔbàlɛ bɔbɔ nɛ kɛklagbu osi nabha nɛ ɛkɛlɛ gɛ ɔɖɔ kibui olu akɔ mɛ. Otsiɛ nɔ, shɛ nɛ kesiakpa alɛ nabha tsiɔ̃ɔ tɛ otsyina ɔvɛ kesiakpa gɛ ode nabha.' "<verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />Kɛlɛ Ratsɛl nɛ̀ Leah ebuiliulũ asɛ, "Ɔŋãkɔ teli ɔkɔ lɛ bɔlɔ ahɔɛ nɛ bɔlɔ akaa yɛɔdɔ̃ mɛ dza? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />Atia lɔkɔ ɔlɔ asɛ beefù bunuɔ dza? Gɛnɛ gɛ adɛ̀ bɔlɔ yete, pɔ awɔà kɛgɛ babuià nɛ bɔlɔ ɛtakpu tsyɛ ishu axɔ̃ɛ ebeke. <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />Kɛgbã ehoeyi bɔdɔ̃ɔ petee gɛ Owusoso Akaa ayɛkɛ nɛ bɔlɔ akaa ahɔɛ nu bɔlɔ nɛ̀ bɔlɔ eyialɛ ɔyɛ. Kliso bhɛtɛ tɔɖɔ kɛkanyiaka gɛ Owusoso Akaa etseɖe wɔ nabha."<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />Kɛlɛ Yakɔb alɔkɔ yɛeyialɛ nɛ̀ yɛedzinì alɛ atɔɖɔ kipuasɔ nabha, <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />kɛlɛ akakà yɛ kepi baagã petee akpɛ yɛotugbà, aplɛnɔ bɔdɔ̃ petee gɛ amɔ̃ nɛ Paɖan Aram, tɛ avɛ yɛaka Isak ɔkɔ nɛ Kana kesiakpa nabha.<verse eid="GEN 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 31:19" />Gɛ Laban avɛ adɛtsɛ̀ tɛkã nɛ ibhoshiɛ shuɔ, Ratsɛl ezuɖu yɛaka yɛɔpã ibudiɛ. <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />Ɔplɛnɔ kɛlɛ́ɛ, Yakɔb awɔɛ Laban gɛenu Arameaeyiɛ gɛ egitseɖe yɛ asɛ ebu tɛtsɛɖɛ mɛ ashɛ. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />Ebu tɛtsɛɖɛ mɛ ashɛ nɛ̀ bɔdɔ̃ petee gɛ amɔ̃ɔ, kɛlɛ nɛ kelĩ tsatsakɛ niedeɛ, ebu bamɛ asɛsɛ ketukpɔ kesiakpa Giliad nabha.<verse eid="GEN 31:21" /></para>
  <para style="s1">Laban Akpà Tɔnɔ Yakɔb</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />Nɛ kiwui tɛɖamɛ nabhaa, betseɖe Laban asɛ Yakɔb ebu tɛtsɛɖɛ mɛ ashɛ. <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />Gɛ agbana yɛeshopo alɛ aplɛnɔ yɛishuɔɔ, akpà tɔnɔ Yakɔb nɛ ewui tegegene mɛ kɛlɛ adɛ tɔnɔ yɛ nɛ Giliad ketukpɔ kesiakpa mɛ. <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />Kɛlɛ Owusoso Akaa ebu yɛishu akasɛ Laban Aramaeyiɛ nɛ bɔlalà mɛ elishi teli pɛ etseɖe yɛasɛ, "Ɖi piapi tɛ ɔtɛɖɔ kibui nanà otseɖe Yakɔb, kibui piapii pɛnɔsɛ kɛkpá."<verse eid="GEN 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 31:25" />Yakɔb etidzu kɛpɔtɛ kagba nɛ Giliad ketukpɔ kesiakpa mɛ flogo pɛ Laban nɛ̀ yɛeshopo alɛ adɛtɔnɔ yɛ. Kɛlɛ Laban nɛ̀ yɛeshopo alɛ tsyɛ eshogo nɛ ɛkɛlɛ. <verse eid="GEN 31:25" /><verse number="26" style="v" sid="GEN 31:26" />Kɛlɛ Laban etseɖe Yakɔb asɛ, "Kiɖe wɔbhɛtɛ ana? Ɔwɔɛ mɛ, kɛlɛ ɔgbana mɛeyiadzɛ alɛ ɔshɛnɔ asɛ bagɛ bevũ nɛ keyù mɛ. <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />Kiɖe so pɛ obu tɛtsɛɖɛ mɛ ɔshɛ nɛ tikpukpũ mɛ pɛ ɔwɔɛ mɛ? Kiɖe so pɛ ogitseɖe mɛ, sɛ tɛ mɛkpɛ wɔɛdzo nɛ same mɔmɔ̃ mɛ nɛ̀ ɛdzɛ zhãzhã atɔɖɔ ɛdzɛ bhobho bɔdɔ̃ abha dza? <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />Ɔgɛ kɔ mɛkpɛ ɔhɔɛ yete tsyɛ nɛ mɛeshui alɛ nɛ̀ mɛeyiadzɛ alɛ oli pɛ ɛɖɔ ɔsɛ basɛnɛ alɛ. Ɔbhɛtɛ bɔwɔaga ibui. <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />Ohumi ɔlɛ mɛahɔɛ ɔsɛ tɛ ɛwɔà ɔfɔ̃ nɛ̀ wɔ; pɔ elishiɛ gɛ abafalaa, wɔaka yɛ Owusoso Akaa etseɖe mɛasɛ. 'Ɖi piapi ɔsɛ ɔgɛ ɖɔ kibui nanà ɔkpɛ Yakɔb ɔkɔ, kɛpiapi pɛnɔsɛ kɛkpà.' <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />Otsinɔ ɔtɛ shɛ ɔmɔsɛ ɔpɛ ɔsɛ tɛ otsyina ɔvɛ wɔakaa ɔpãmɛ. Pɔ kiɖe sopɛ ozuɖu mɛ ibudiɛ?"<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />Yakɔb ebuiliulũ ɔkɔ Laban asɛ, "Kifù ziyí mɛ, ɔmɔsɛ abhɛtɛ mɛ asɛ ɔbɔ yɛkɛ wɔeyiadzɛ alɛ nɛ mɛahɔɛ nɛ tɛgagalĩ mɛ. <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />Pɔ onupɛ ɔmɔ̃ anɔteli gɛ yɛahɔɛ wɔ ibudiɛ lɛɛ, atɛbà zanà nɛkpã. Nɛ bɔlɔ eshopo alɛ namɛɛ, ɖikɔ wɔshu sɛpɔ wɔɛdɔ̃ teli ana lɛ ɛkɛlɛ nɛ mɛɔbha; kɛlɛ onu anaa, lɔkɔ ɛlɛ." Otsinɔ Yakɔb etinyi asɛ Ratsɛl yɛezuɖu ibudiɛ.<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />Kliso Laban avɛ Yakɔb kɛpɔtɛ kagbaa mɛ nɛ̀ Leya kɛpɔtɛ kagbaa mɛ nɛ̀ badzɛ axɔɛdɛ kɛpɔtɛ kagbaa mɛ, pɔ agɛmɔ̃ kɛdɔ̃ nanà. Gɛ ekoeyi nɛ Leya kɛpɔtɛ kagbaa mɛ ebekeɛ, etsoku Ratsɛl kɛpɔtɛ kagbaa mɛ. <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />Otsiɛ nɔ Ratsɛl alɔkɔ bɔpãmɛ ibudiɛ anyà akpɛ kɛpɔtɛ nabha gɛ baazã nɛ kipusɔ nabha mɛ kɛlɛ azã kɛlɛ abha. Laban apɔ̃ɛ kɛdɔ kanyiaka mɛ nɛ kɛpɔtɛ kagbaa mɛ pɔ agɛmɔ kɛdɔ̃ nanà.<verse eid="GEN 31:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 31:35" />Ratsɛl etseɖe yɛaka asɛ, "Tɛkpɛ ɔmɔpɔɛ, mɛ apalete, sɛ ɛtɛ balà lɔzã kitití nɛ wɔamɛ, iiku kevude." Klisoɔ anyɔ̃ pɔ agɛmɔ bɔpãmɛ ibudiɛɛ.<verse eid="GEN 31:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 31:36" />Yakɔb akpɛ ɔmɔpɔɛ kɛlɛ alɔkɔ kibui nɛ Laban ishu. Ebisi yɛasɛ, "Ɔfɔ̃ ɖuwoe mɛwɔa? Kibui kpa ɖuwoe mɛbhɛtɛ so pɛ ɔkpatɔ̃nɔ mɛ? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />Otsi nɔ gɛ ɔnyɔ̃ mɛ bɔdɔ̃ nyɔɔ mɛɛ, kiɖe wɔmɔ̃ gɛinu wɔ bɔpãmɛ bɔdɔ̃? Lɔkɔ ɛlɛ olù ɛkɛlɛ nɛ wɔeshopo alɛ nɛ̀ mɛayɛ namɛ, tɛ bebhui kibui mɛ nɛ bɔlɔ taabha nɛishi.<verse eid="GEN 31:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 31:38" />"Ɛzã wɔbhà agɔ afɛtaabha naalɛ. Wɔ ibhoshiɛ nɛ beepigyaa nɛyá gɛiyi ɖi, pɛnɔsɛ ɛtã obhoshi nyè odenɔ wɔ baagã mɛ. <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />Ɛgɛ manà wɔ agã nanà gɛ bagãhoe atsyɔ̃ɛ yɛmɛ eɖi; ɛlɔkɔ kɛbhɛ ɛlɛ kɔ mɛishu. Kɛlɛ obisi kɛbhɛ babuià odenɔ mɛahɔɛ nɛ kɛkanyiaka gɛ bezuɖu keliza pɛnɔsɛ elishi. <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />Mɛ tɛzãzãa mɛ naalɛ: kɛkpɛkpɛ tãmɛ nɛ kelizaza mɛ, kɛlɛ bɔbɔlɔ nɛ elishiɛ, kɛlɛ taɖa ebu tɛtsɛɖɛ odenɔ mɛanhũ mɛ. <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />Kana kɛzã nɛ agɔ afɛtaabha mɛ gɛ ɛzã wɔ bɔpãamɛ. Ɛwɔà axɔɛ akɔwɔ agɔ lɔfɔ nɛ̀ taalɛ nɛ wɔ beyiadzɛ nɛtakpu nɛ̀ agɔ teehlo nɛ wɔ baagã nɛtakpu pɔ otsyina mɛ kɛbhɛ babuia kibenyiabe. <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />Onupɛ mɛaka yɛ Owusoso Akaa nɛ̀ Abraham yɛ Owusoso Akaa, nɛ̀ kifu sisí ɔkɔ Isak yɛ Owusoso Akaa gɛzã plɛnɔ mɛɛ, ɔtɔ kpɛ mɛidzo ahɔɛ kpakpa kɛgbã. Pɔ Owusoso Akaa amɔ̃ mɛɔtɔ mɛ bɔtɔɔ mɛ, kɛlɛ kivu elishiɛ, etseɖenɛ wɔ."<verse eid="GEN 31:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />Laban ebuiliulũ akɔ Yakɔb asɛ, "Baadzɛ benu mɛeyiadzɛ, bunuvɔɛ nɔ benu mɛeyialɛ, kɛlɛ baagã enu mɛ baagã. Kɛkanyiaka gɛ ɔmɔ̃ɔ nu mɛayɛ. Pɔ kiɖe mɛba bhɛtɛ obuɔ nɛ̀ mɛ beyiadzɛ alɛ shu, pɛnɔsɛ nɛ̀ bunuvɔɛ nɔ gɛ bamɔ̃? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />Ba otsialɛ tɛ bɔbhɛtɛ olugbùnyanyã, wɔ nɛ mɛ, tɛ kidzi kibuiamɔmɔ̃ nɛ mɛ nɛ̀ wɔɛshi."<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />Kliso Yakɔb alɔkɔ kɛklagbu pɛ edzu kɛlɛ kititi asɛ kɛklagbu osi. <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />Etseɖe yɛeshopo alɛ asɛ, "Noshogo aklagbu teli." Kliso balɔkɔ aklagbuɔ pɛ belu alɛ akpɛ kitsù kɛlɛ baŋãdɔ̃ nɛ ɛkɛlɛ nɛ kitsuɔ shu. <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />Laban ekulu ɛlɛ asɛ Yega Sahaduta, kɛlɛ Yakɔb ekulu alɛ ɔsɛ Galid.<verse eid="GEN 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="GEN 31:48" />Laban aɖɔ asɛ, "Kitsù ɛlɛ kinu kibuiamɔmɔlu nɛ wɔ nɛ̀ mɛishi obuɔ." Kliso pɛ bekulu ɛkɛlɛ asɛ Galiɖ. <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />Bekulu ɛlɛ tsyɛ ɔsɛ, Mizpa ɔmɔsɛ aɖɔ asɛ, "Tɛ Apaleteɛ awuhũ azã mɛ nɛ wɔɛshi gɛ onupɛ bɔshɛ nɛ bagɔlɔ ɔbhà. <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />Ɔwa ɔfɔ̃ mɛeyiadzɛɛ pɛnɔsɛ ɔdɛ lɔkɔ baadzɛ bhlatɔ ɔplɛnɔ naalɛ, pɔ anɔ nanà ama bɔlɔ ɔbhà tsyɛelo, baka ɔsɛ Owusoso Akaa yɛenu kibuiamɔmɔ nɛ wɔ nɛ mɛishi."<verse eid="GEN 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 31:51" />Laban ezetseɖe Yakɔb asɛ, "Kitsùɔ nɛɛlɛ, kɛlɛ kɛklagbu osiɛ nɔɔlɛ gɛ idzu nɛ mɛ nɛ wɔɛshi. <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />Kitsù ɛlɛ kɛlɛinu kibuiamɔmɔ, kɛlɛ kɛklagbu osi ɔlɛ kinu kibuiamɔmɔ sɛ, ɛtɛbà dɔfalà kitsù ɛlɛ ba wɔkɔ tɛba bhɛtɛ kibui kpa nɛ̀ wɔ. Kɛlɛ wɔtsyɛ ɔtɛ bɔdɔ falà kitsù ɛlɛ nɛ̀ kɛklagbu osi ɔlɛ ɔba mɛɔkɔ pɛ ɔbɔbhɛtɛ kibui kpa nɛ mɛ. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />Tɛ Abraham yɛ Owososo Akaa nɛ̀ Nahɔ yɛ Owusoso Akaa, balɛ akaa yɛ Owusoso Akaa ebhui kibui mɛ nɛ bɔlɔɛshi."</para>
  <para style="p" vid="GEN 31:53">Kliso Yakɔb atanà bɔdɔ̃ nɛ Isak yɛ Owusoso Akaa yɛinye mɛ. <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />Abhɛtɛ bɔdɔ̃ pɔpɔɛ nɛ ɛkɛlɛ nɛ ketukpɔ kesiakpa mɛ kɛlɛ ekulu yɛeshopo alɛ amanà bɔdɔ̃ ɔŋãkɔ. Gɛ baŋã bɔdɔ̃ɔ ebekeɛ, baza ɛkɛlɛ.<verse eid="GEN 31:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 31:55" />Kelizaza ɛvɔlɔ plii nɔ, Laban akpɛ ahɔɛ nɛ yɛeshuialɛ nɛ̀ yɛeyiadzɛ alɛ oli pɛ eyulà akɔ alɛ. Kɛlɛ etsyina avɛ bɔpãmɛ.<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s1">Yakɔb Abalɛ tɛ Adɛtsyana Esawu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />Yakɔb tsyɛ atɔnɔ yɛidzo, kɛlɛ Owusoso Akaa yɛaxɔɛdɛ atsyana yɛ. <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />Gɛ Yakɔb amɔ̃ alɛɛ, aɖɔ asɛ "Owusoso Akaa oshogo ɔkɔ nɔlɛ!" Kliso akɔ ɛkɛlɛ nɛinye asɛ Mahanaim.<verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />Yakɔb eputɔ asɛsɛ banɔkpɛkpɛ nɛ yɛadza Esawu ɔkɔ nɛ Seya kesiakpa nabha nɛ Edom esiakpa mɛ. <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />Akɔ balɛ ɔsha asɛ, "Kibuiɛ gɛ kɛlɛ ɔsɛ nɔɖɔ otseɖe mɛ apalete Esawu nɛlɛ: 'Wɔ axɔɛdɛ Yakɔb aaɖɔ asɛ, ɛzã Laban ɔkɔ bɔkpɛnɔ otsiɛ. <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />Banɛtsyɔɛ nɛ̀ badiku alɛ mɛahɔɛ, ibhoshi, beepigya, baanyɛ axɔɛdɛ nɛ̀ baadzɛ axɔɛdɛ. Otsinɔ ɛsɛsɛ mɛ apaleteɛ ɔklasɔ ɔlɛ, sɛ tɛ ɛmɔ kɛwɔ̃ kuku odenɔ wɔ anhũɔ mɛ.' "<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />Gɛ baxɔɛdɛ etsyina aba Yakɔb ɔkɔ, baɖɔ asɛ, "Bɔdɛ wɔadza Esawu ɔkɔ kɛlɛ otsiɛnɔ aaba abatsyana wɔ, kɛlɛ banyɛ akpã tãalɛ alɛ aplɛnii."<verse eid="GEN 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 32:7" />Nɛ kifu sisi nɛ̀ ɔwɔ̃nyɔnɔ̃ gbagbala mɛɛ, Yakɔb ebu banɔnɔ gɛ azã yɛɔbhà akpɛ kitsù tɔɔbhà mɛ, kanà tsyɛ yɛabhɛtɛ akɔ ibhoshi, nɛ̀ banɛntsyɔɛ nɛ̀ kipuasɔ. <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />Eɖi asɛ, "Onupɛ Esawu alɔadɔ kitsù tenikpo abhaa, kitsuɔ gɛbatɔɔ abablɛkɛ."<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />Kɛlɛ Yakɔb ekulu Akaa asɛ, "O mɛaka Abraham yɛ Owusoso Akaa, mɛaka Isak yɛ Owusoso Akaa, O Apalete, gɛ etseɖe mɛ asɛ, 'Tsyina ɔvɛ wɔ kesiakpa mɛ nɛ̀ wɔeshopo alɛ ɔkɔ, tɛ mɛkɔ yɛapɛ akɔ wɔ.' <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />Ɛgɛ shɔ̃ ɔsɛ tɛ ɛmɔ ɛyamɛ gbangbã nɛ̀ kibui abhà tɛbhɛbhɛtɛ petee gɛ ɔkasɛ wɔaxɔɛdɛ flogo. Mɛ osivuvũɔ yete ɔlɛ ɔzã mɛ ahɔɛ gɛ ɛtsakɛ Yɔɖaniɛ, pɔ otsinɔ ɛbadzì etsù taabha. <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />Ikulu wɔ Owusoso Akaa, yɛkɛ ɔkɔ mɛ, odenɔ mɛadza Esawu ahɔɛ mɛ, ɔmɔsɛ isifu sɛ ababa lɔdɔ mɛabha, nɛ̀ beelĩɛ nɛ̀ balɛ eyialɛ tsyɛ. <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />Pɔ ɔtɛɖɔ ɔsɛ, 'Ɛbakɔ yɛapɛ akɔ wɔ, kɛlɛ ɛbabhɛtɛ wɔɛhui nɔ asɛ kelikekpu shu ayisɛ, gɛ batɛ balà akalà.' "<verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />Aza ɛkɛlɛ, kɛlɛ odenɔ kɛgɛ lɛ yɛahɔɛɛ, ebu kɛdɔ̃ kɔkɔ kɔ yɛadza Esawu. <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />Beepigya adzɛ akpã taabha nɛ̀ beepigyakɔlɛ afɛtaabha, ibhoshidzɛ akpã taabha nɛ̀ ibhoshinye afɛtaabha, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />kipuasɔdzɛ afɛata nɛ̀ balɛ eyialɛ, banɛntsyɔɛdzɛ afɛtaalɛ nɛ̀ banɛtyɔɛnye lɔfɔ. Badikudzɛ afɛtaabha nɛ̀ badikunye lɔfɔ. <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />Alɔkɔ alɛ akpɛ ahɔɛ akɔ yɛaxɔɛdɛ, kɛza kanyiaka zã kɛlɛ ishu ahɔɛ mɛ, kɛlɛ etseɖe yɛaxɔɛdɛ asɛ, "Nɔoputɔ kɔmɛ, tɛ nɔkɔ kishì zã bagã nɛishi."<verse eid="GEN 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17" />Akɔ anɔnɔ gɛ yɛalɛ otugba ɔsha asɛ: "Onupɛ mɛadza Esawu atsyana wɔ pɛ ebisi asɛ, 'Fakɔ anɛ nɔonù nɛ̀ faakɔ nɔɔvɛ, nɛ̀ afanà agã naalɛ nyɔ̃ɔ gɛ alɛ wɔnɔ otugbaa?' <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />kɛɛlɛ nɔbɔɖɔ ɔsɛ, benu wɔaxɔɛdɛ Yakɔb ayɛ. Benu kɛdɔ̃ kɔkɔ akɔ mɛapalete Esawu, kɛlɛ alɛ kideɛ aaba.' "<verse eid="GEN 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 32:19" />Akɔ ɔsha otugba anɔ bhalà, nɛ̀ ataɖamɛ, nɛ̀ banɔ bhlatɔ nyɔ̃ɔ gɛalɛ baagã kɛza niedeɛ tsyɛ ɔsɛ: "Nɔɖɔ kibui tinikpo ɛlɛ ɔkɔ Esawu gɛ nɔtsyana yɛ. <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />Kɛlɛ nɔoɖi ɛlɛ ɔkɔ ɛgbã ɔsɛ, 'Wɔaxɔɛdɛ Yakɔb alɛ bɔlɔ kideɛ aabà.' Ɔmɔsɛ eɖi asɛ, "Ɛbà yɔ yɛishumɛ nɛ̀ bɔdɔ̃ kɔkɔ ɔlɛ gɛ ɛsɛsɛ kpɛ otugbaa; kidegba ɛbamɔ yɛɛ, ogilu awɔ̃ɔ abayɛkɛ mɛ." <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />Kliso Yakɔb yɛɔdɔ̃ kɔkɔ vɛ otugba akɔ yɛ, pɔ yɛxɔnɔ aza oshogo ɔkɔ elishi alɛ.<verse eid="GEN 32:21" /></para>
  <para style="s1">Yakɔb Awlãkɛ nɛ̀ Owusoso Akaa</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />Elishi alɛ Yakɔb alɔ kɛlɛ agbanà yɛedzini alɛ taabha, yɛ baadzɛ axɔɛdɛ taabha nɛ̀ yɛeyianyɛ lɔfɔ nɛ̀ tooliɛ kɛlɛ batsakɛ Yabɔk kelĩɛ ɛkɛlɛ gɛ logidzuɔ̃. <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />Gɛ atsakɛ alɛ nɛ̀ keliɛ ebekeɛ, alɔkɔ yɛɔdɔ̃ tsyɛ petee atsakɛ. <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />Kliso atɔ̀ Yakɔb yete, kɛlɛ anyɛ teli aba wlãkɛ niyɛ ɔdɛkpɛnɔ kelizaza. <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />Gɛ anyɛ amɔ̃ asɛ atɛalà yɛabha ŋãa, ehunɔ Yakɔb kɛtsɛɖɛta kɛxɔa tsyɔakɔ mɛ sɛtɛ kɛtsɛɖɛ dua gɛ awlakɛ nɛ anyɛ. <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />Kɛlɛ anyɛ aɖɔ asɛ, "Kɔmɛ shɛ, ɔmɔsɛ kelì aza."</para>
  <para style="p" vid="GEN 32:26">Pɔ Yakɔb ebuiliulũ asɛ, "Ɛtɛ bakɔ wɔ shɛ ɔdɛkpɛnɔ ɔsɛ oyulà akɔmɛ."<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />Anyɛ ebisi yɛasɛ, "Kiɖe bekulu wɔ?"</para>
  <para style="p" vid="GEN 32:27">Ebuliulũ asɛ, "Yakɔb."<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />Kɛlɛ anyɛ aɖɔ asɛ, "Bezekulu wɔ asɛ Yakɔb, pɔ Israɛl ɔmɔsɛ ɔwlãkɛ nɛ̀ Owusoso Akaa nɛ̀ banɔdzyrame pɛ ɔŋã kabha."<verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />Yakɔb aɖɔ asɛ, "Ɛkɔ wɔɛtakpu kulu wɔɛinyeɛ kɔmɛ."</para>
  <para style="p" vid="GEN 32:29">Pɔ ebuiliulũ asɛ, "Kiɖe sopɛ obisi mɛinye?" Kɛlɛ eyulà akɔɛ nɛ ɛkɛlɛ.<verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />Kliso Yakɔb akɔ ɛkɛlɛ nɛinye asɛ Peniel, pɛ aaɖɔ asɛ, "Ɔmɔsɛ ɛmɔ̃ Owusoso Akaa bamɛ nɛ̀ amɛ, kɛlɛ ɛkalɛ nɛ ɛkpã pɔ."<verse eid="GEN 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 32:31" />Kiwuíɛ titú nɛ yɛadamɛ gɛ agãfalà nɛ Pɛniel kɛlɛ eze kplitsò nɛ yɛ kɛtsɛɖɛtà kɛxɔa shu. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />Kliso bɔkpɛnɔ obuɔ Israelianɛ atɛŋã agã kɛdzaa gɛnyanã kɛtsɛɖɛta ɔtsyɔakɔ, ɔmɔsɛ ehunũ Yakɔb kɛtsɛɖɛta ɔtsyɔakɔ nɛ kɛdzyaa gɛnyanã kɛxɔa ɔbhà.<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s1">Yakɔb Atsyana Esawu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />Gɛ Yakɔb ebu bamɛ ewunɔ kabha, Esawu naalɛ gɛ aaba nɛ̀ yɛ banyɛ akpã taalɛ; kliso ebu beyiɛ mɛ akɔ Leya, Ratsɛl, nɛ̀ badzɛ axɔɛdɛ taabha. <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />Alɔkɔ badzɛ axɔɛdɛ nɛ̀ balɛ eyialɛ akpɛ otugba, pɛ otsi Leya nɛ̀ yɛeyialɛ, kɛlɛ Ratsɛl nɛ̀ Yosɛf azã kideɛ. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />Yakɔb afala vɛ otugbaa pɛ edizhi ekumũ nɛ kesiakpa bɔtɛ tigegene gɛetso aplɛnɔ yɛadzaa.<verse eid="GEN 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 33:4" />Pɔ Esawu ebu tɛtsɛɖɛ mɛ adɛ tsyana Yakɔb pɛ evũ yɛakpɛ etemɛ; akpɛ ahɔɛ nɛ yɛoliɛ pɛ amɔkɔ̃ yɛolugbùɔ. Kɛlɛ bebi yoyo. <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />Kɛlɛ Esawu ebu bamɛ ewunɔ kabha pɛ amɔ̃ baadzɛ nɛ̀ beeyiɛ. Ebisi yɛasɛ, "Banɔ ɖuwoelu naalɛ nɛ wɔbhà?"</para>
  <para style="p" vid="GEN 33:5">Yakɔb ebuiliulũ asɛ, "Balɛenu beeyiɛ gɛ Owusoso Akaa akɔ wɔaxɔɛdɛ ɔganà yɛanɔabha tiɖiɖi mɛ."<verse eid="GEN 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 33:6" />Kɛlɛ baadzɛ axɔɛdɛ nɛ̀ balɛ eyialɛ tsyɛ betso aplɛnɔ yɛ pɛ bezhyi ekumũ. <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />Balɛ edeɛ, Leya nɛ̀ yɛeyialɛ aba ezhyi ekumũ. Gɔgɔɛ nɔ, Yosef nɛ̀ Ratsɛl tsyɛ aba, kɛlɛ balɛ tsyɛ edizhi ekumũ.<verse eid="GEN 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8" />Esawu ebisi yɛasɛ, "Baagã alɛ petee gɛ ɛɛmɔ̃ niesi sɛlɛ?"</para>
  <para style="p" vid="GEN 33:8">Aɖɔ asɛ "Tɛ mɛmɔ̃ kɛwɔ̃ kuku nɛ wɔamɛ, mɛ apalete."<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />Pɔ Esawu ebuiliulũ asɛ, "Balɛ mɛtsyɛ ahɔɛ nɛ tikpekpe mɛ kukuuku, mɛadza. Balɛ̀ kɛgɛ lɛ wɔahɔɛ akɔ wɔ ishu."<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />Yakɔb ebuiliulũ asɛ, "Oho ɛkɔ wɔɛtakpu. Onupɛ ɛmɔ̃ kɛwɔ̀ kuku nɛ wɔanhũɔ mɛɛ, yɛkɛ bɔdɔ̃ kɔkɔ ɔlɛ odenɔ mɛahɔɛ mɛ. Ɔmɔsɛ tɛmɛ mɔ wɔamɛɛ edzi asɛ ɛɛmɔ̃ Owusoso Akaa namɛ, nɛ otsiɛ gɛ ɔyɛkɛ mɛ nɛ̀ ɛyamɛ. <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />Ɛkɔ wɔɛtakpu, yɛkɛ bɔdɔ̃ kɔkɔ ɔlɛ gɛ ɛmanà wɔ, ɔmɔsɛ Owusoso Akaa eɖi mɛ ashagabui kɛlɛ kɛkanyiaka gɛ ɛpɛnɔ lɛ mɛahɔɛ." Kliso gɛ Yakɔb ezetũilɛ akpɛ yɛulũɔ, Asawu abayɛkɛ.<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />Kɛlɛ Esawu aɖɔ asɛ, "Kɔ bɔtɔnɔ̃ bɔlɔ kidzo; ɛbakpɛ abhalà akɔ wɔ."<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />Pɔ Yakɔb etseɖe yɛasɛ, "Mɛ apaleteɛ enyi asɛ mɛeyialɛ eke shè, pɔ kɛlɛ ɔsɛ iɖi ibhoshidzɛ nɛ̀ banɛtsyɔɛdzɛ gɛ baakɔ̀ balɛ eyialɛ kɛmɔ̃ɔ nabha flogo. Onupɛ ɛlɔkɔ tɛgagalĩ gbanà alɛ nɛ kiwui tinikpo mɛɛ, bagãa petee ebetsí. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />Klisoɔ, kɔ tɛ apaleteɛ eputɔ akɔ yɛaxɔɛdɛ, nɛ kibeɛ gɛ ɛɛgã kɛbɔɛbɔɛ nɛ̀ baagã gɛalɛ mɛ otugbãa nɛ̀ beeyiɛ tɛgagã nulũ, ɔdɛkpɛnɔ ɔsɛ idiku mɛ apeleteɛ ɔkɔ nɛ Sɛya."<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />Esawu aɖɔ asɛ, "Kɛlɛ kɔmɛ shɛnɛ ahɔɛ mɛ banyɛ teli shu kɔwɔ."</para>
  <para style="p" vid="GEN 33:15">Yakɔb ebisi asɛ, "Pɔ kiɖe sopɛ ɔbɔ bhɛtɛ ana? Kɔmɛ mɔ kɛwɔ̃ kuku odenɔ mɛ apaleteɛ awuhũɔ mɛ."<verse eid="GEN 33:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16" />Kliso kiwui ɛlɛ nabha Esawu akpɛ yɛidzo gagã niesi etsyina aba Sɛya. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />Pɔɔ, Yakɔb xɔnɔ̃ afala avɛ Sukɔt, ɛkɛlɛ yɛadɛ bhɔ ɔzãkɔ akɔ yɛishu pɛ awɔá bɔgbà akɔ yɛ bagãa. Kliso pɛ bekulu ɛkɛlɛ asɛ Sukɔt.<verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />Kidegba gɛ Yakɔb ede Paɖan Aram ebekuɔ, ediku Shikɛm gɛenu ɔmã gbagbala nɛ Kana piapi kɛlɛ ebhui kazã nɛ amã ɔlɛ ɔmɔkɔ nɔbhà. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />Gɛ alɔkɔ sikãfufu kɛkpã zɛzɛɛ, edzi kesiakpa nɛ Xamɔ gɛ yɛamɔ Shikɛm yeyianyɛ alɛ ahɔɛ. Kesiakpa alɛ abha yɛedzu yɛ kɛpɔtɛ kagbaa. <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />Ɛkɛlɛ yɛedzu bɔdɔ̃pɔpɔɛ osubha gɛ akɔ ɔlɛinye asɛ Ɛl Elohi Israɛl.<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s1">Ɖina nɛ̀ Shikɛmanɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />Otsiɛ nɔ, Ɖina gɛ Leya amɔ̃ akɔ Yakɔb ekoeyi avɛ asɛ tɛ ediɖi badzɛ galɛ kesiakpa nabha. <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />Kibeɛ mɛ gɛ Sikɛm gɛenu Xamɔ gɛede Xivite pɛenu ekusi nɛ kibe ɛlɛ mɛ yɛeyianyɛ amɔ̃ yɛɛ, evũi apɛɛ. <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />Yɛ kituɔ nyanà Ɖina gɛenu Yakɔb yɛeyiadzɛ, kɛlɛ yɛibui zã yɛuli kɛlɛ aɖɔ kaɖɔ akɔɛ nɛ kineke dzyɛdzyɛ̃. <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />Kɛlɛ Shikɛm editseɖe yɛaka Xamɔ asɛ, "Pɛɛ adzɛnuvɔɛ alɛ akɔ mɛ tɛ edzi mɛedzinì."<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />Kibeɛ mɛ gɛ Yakɔb elũ asɛ bapɛɛ yɛeyiadzɛ nɛ tɛgagalĩ mɛɛ, yɛeyianyɛ alɛ azã ayakpa mɛ nɛ̀ yɛ baagã; kliso adã olugbù nɛibui nabha ɔdɛkpɛnɔ sɛ baba bɔpã mɛ.<verse eid="GEN 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 34:6" />Kɛlɛ Sikɛm yɛaka gɛenu Xamɔ avɛ asɛ adɛɖɔ kaɖɔ nɛ̀ Yakɔb. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />Otsiɛ nɔ gɛ Yakɔb beyianyɛ elũ kɛgɛ baɛlɛ mɛ koɔ kɛlɛ bekoeyì nɛ ayakpa mɛ aba. Ɔwɔnyɔnɔ̃ nɛ̀ ɔmɔpɔɛ oyuku balɛ mɛ, ɔmɔsɛ Shikɛm abhɛtɛ awuĩ ebui nɛ Israɛl gɛ apɛ́ɛ Yakɔb yɛeyiadzɛ-kibui gɛ kɛma ɔsɛ babhɛtɛ.<verse eid="GEN 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 34:8" />Pɔ Hamɔ etseɖe balɛ asɛ, "Wɔeyiadzɛ nɛibui zã mɛeyianyɛ Shikɛm nuuli. Ɛkɔ wɔɛtakpu, nɔlɔkɔ yɛɔkɔɛ tɛ edzi yɛedzini. <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />Nɔkɔ bɔgbana bagɔlɔ, nɔkɔ ɔlɔ wɔnɔ beyiadzɛ bɔgbana tɛ wɔnɔ tsyɛ nɔgbanà bɔlɔ beyiadzɛ." <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />Nɔbɔ làtsɛ nɛ bɔlɔɛshi; kesiakpa eli akɔ wɔnɔ. Nɔzã kalɛ abha, nɔgã kedzi nɛ kalɛ mɛ, tɛ nɔpɛ bɔdɔ̃ mɔmɔ̃ nɛ kalɛ mɛ."<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />Kɛlɛ Shikɛm etseɖe Ɖina yɛaka nɛ̀ yɛadza alɛ asɛ, "Nɔkɔ mɛmɔ̃ kɛwɔ̃ kukú nɛ wɔnɔ anhũɔ mɛ kɛlɛ ɛbakɔ wɔnɔ kɛkanyiaka gɛ nobisiɛ. <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />Nɔbhɛtɛ kɛbhɛ nɛ adzɛ shu nɛ̀ bɔdɔ̃ kɔkɔ gɛ kɛlɛ ɔsɛ tɛ ɛmanà nɛ kana gɛ nɔpɛ ɔsɛ tɛ kikpeɛ mɛ, kɛlɛ ɛbabuia kɛkanyiaka gɛ nobisiɛ. Nɔkɔmɛ adzɛnuvɔɛ tɛ edzi mɛedzini yetee ko."<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />Gɛ bapɛ́ɛ balɛ ada Ɖina nɛ tɛgagalĩ mɛ soɔ, Yakɔb yɛeyianyɛ ebuiliulũ nɛ tɛwɔɛwɔɛ mɛ gɛ bazaɖɔ kaɖɔ akɔ Shikɛm nɛ̀ yɛaka Xamɔ. <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />Betseɖe alɛ asɛ, "Bɔtɛ balà kana kibui ɛlɛ ɔbhɛtɛ; bɔtɛ balà lɔkɔ bɔlɔ ada kɔ anyɛ nɔnɔ̃ gɛ begibhui bɔnyɛnyɛ akɔɛ. Kɛbadzi awuĩ ebui akɔ ɔlɔ. <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />Bɔbà kɔwɔ kidzo nɛ kibui tinikpo shu: sɛ nɔzã asɛ bɔlɔ ana tɛ nɔobhui bɔnyɛnyɛ akɔ wɔ beyianyɛ petee. <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />Kɛlɛ bɔbà lɔkɔ wɔnɔ bɔlɔ beyiadzɛ akɔ bɔlɔ shu pɛ bɔbà gbana wɔnɔ beyiadzɛ akɔ bɔlɔ ishu. Bɔba tsɛ nɛ wɔnɔɛshi kɛlɛ bɔbadzi banɔ tenikpo nɛ̀ wɔnɔ̃. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />Pɔ onupɛ nɔtɛ bɔdɛmɛ ɔsɛ bebhui bɔnyɛnyɛ akɔ wɔnɔɔ, bɔbà yɛkɛ bɔlɔ ada nɔ shɛnɔ."<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />Balɛ kibuiɛ gɛ bakpɛ manà pɛ̃ akɔ Xamɔ nɛ̀ yɛeyianyɛ Shikɛm. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />Ayisɔ̃ gɛenu anunɔ̃ gɛ bakpɛ kɛtakpuiesi akɔ adɛ petee nɛ yɛaka bɔpã mɛ egizĩ kibe nanà nɛ kibuiɛ gɛ baɖɔ shu amɔsɛ Yakɔb yɛeyiadzɛ nɛibui zã yɛuli. <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />Kliso Xamɔ nɛ̀ yɛeyianyɛ Shikɛm avɛ balɛ ɔmã gbagbla niedulũɔ pɛ badɛ ɖɔ kaɖɔ akɔ balɛ ɔmamɛ banɔnɔ. <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />Baɖɔ asɛ, "Banyɛ alɛ evũ bɔlɔ ɛbhia. Nɔkɔ bazã bɔlɔ kesiakpa nabha tɛ bagã kedzi nɛ kalɛ mɛ; kesiakpa etiɖì kɔalɛ tsyɛ. Bɔbalà gbanà balɛ ɛyiadzɛ pɛ balɛ tsyɛ agbanà bɔlɔ ayɛ. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />Pɔ banyɛ alɛ abapɛ asɛ azã aplɛnɔ ɔlɔ asɛ banɔ tenikpo ana nɛ kibui ɛlɛ shu asɛ, bɔlɔ banyɛ ebhui bɔnyɛnyɛ asɛ gɛ balɛ tsyɛ alɛ ana. <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />Balɛ bɔpãmɛ baagã, balɛ bɔdɔ̃mɔmɔ nɛ̀ balɛ bagã bhlatɔ petee eti bedzi bɔlɔ ayɛ dza? Kliso nɔkɔ bɔdɛmɛ kɔalɛ, tɛ bàtsɛ̀ nɛ bɔlɔɛshi."<verse eid="GEN 34:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 34:24" />Banyɛ petee gɛ ekoeyi adɛ ɔmã gbagbla niedulũɔ adɛmɛ atɔɖɔ kibuiɛ gɛ Hamɔ nɛ yɛeyianyɛ Shikɛm aɖɔ nabha, kɛlɛ bebhui bɔnyɛnyɛ akɔ anyɛ kanyiaka nɛ amã gbagbla mɛ.<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />Ewui taatà ede gɛ balɛ petee azã ishutatã mɛɛ, Yakɔb yɛeyianyɛ taabha, Simeɔn nɛ̀ Levi gɛenu Ɖina yɛadzalɛ alɛ balɔkɔ balɛ babɛtɛɛ pɛ balɔadɔ ɔmã nabha nɛ ɔlɛ matimatì mɛ pɛ beyi anɔnyɛ kanyiaka. <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />Beyí Xamɔ nɛ̀ yɛeyianyɛ Shikɛm kɛlɛ bagbanà Ɖina okoeyi nɛ Shikɛm bɔpãmɛ pɛ bashɛ. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />Yakɔb yɛ beyianyɛ avɛ ɔmã gbagbala mɛ gɛ banɔnɔ etsí eliɛ kɛlɛ balɔkɔ kɛdɔ̃ kanyiaka nɛ ɔmã mɛ gɛ bevũ balɛ ada apɛ́ɛ nɔ. <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />Bayɛkɛ balɛ baagã azãa, banɛntsyɔɛ, badikuɔ nɛ̀ kɛkanyiaka gɛinu balɛ ɛyɛ nɛ ɔmã mɛ nɛ̀ ayakpa mɛ. <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />Balɔkɔ balɛ ehoeyi bɔdɔ̃ petee nɛ̀ balɛ baadzɛ petee nɛ̀ beyiɛ. Balɔkɔ kɛkanyiaka gɛzã balɛ bapãmɛ ashɛnɔ.<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />Kɛlɛ Yakɔb etseɖe Simeɔn nɛ̀ Levi asɛ, "Nɔ manà buluhũ nɛ mɛabha gɛ nɔbhɛtɛ mɛ kɛdɔ̃ lɔlɔ̃ nɛ Kanananɛ nɛ̀ Perizianɛ nɛ̀ banɔnɔ gɛ balɛ kesiakpa alɛ nabha. Bɔlɔ tɛkakalà mɛ gikpe, kɛlɛ onupɛ beshogo ovolo nɛ mɛishu pɛ balɔ adɔ mɛabhaa, bebezĩ mɛ nɛ̀ mɛɔpãmɛanɛ petee."<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />Pɔ bebuiliulũ asɛ, "Kana kɛlɛ ɔsɛ abhɛtɛ bɔlɔ ada asɛ kedulũazazã elete dza?"<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s1">Yakɔb Etsyina Avɛ Bɛtɛl</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />Kɛlɛ Owusoso Akaa etseɖe Yakɔb asɛ, "Wu vɛ Bɛtɛl tɛ ɔdɛtsɛ nɛ ɛkɛlɛ, tɛ odzu bɔdɔ̃pɔpɔɛ osubha nɛ ɛkɛlɛ akɔ Owusoso Akaa gɛebu yɛishu akasɛ wɔ nɛ kibeɛ gɛ ozobù tɛtsɛɖɛ mɛ ɔshɛ nɛ wɔadza Esawu ɔbhà."<verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />Kliso Yakɔb etseɖe yɛɔpãmɛ anɛ nɛ̀ bagɛ azã yɛɔkɔ petee asɛ, "Nɔ shɛnɛ ahɔɛ nɛ ɛmabhlatɔ mɛ ibudiɛ petee gɛlɛ wɔnɔ ahɔɛ shu, tɛ nɔbhɛtɛ ishu libhui tɛ nɔtsaɖakɛ wɔnɔ bakpɛkpɛ. <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />Kɛlɛ nɔba, tɛ buwu ɔvɛ Bɛtɛl, nɛ ɛkɛlɛ gɛ ɛbabhɔ bɔdɔ̃pɔpɔɛ osubha akɔ Owusoso Akaa, agɛ yɛadɛmɛ akɔmɛ nɛ mɛ bɔtɔ kibeɛ, nɛ̀ agɛ yɛazã mɛishu nɛ ɔkɔnyiakɔ gɛ ɛdɛ." <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />Kliso balɔkɔ ɛmabhlatɔ mɛ ibudiɛ gɛzã balɛ ahɔɛ petee nɛ̀ batɔ̃ kisikpɛ nɔ gɛzã balɛ atɔ̃ɔ, kɛlɛ Yakɔb avɔbɔ ɛlɛ nɛ odidosiɛ niesi nɛ Shikɛm. <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />Kɛlɛ batɔnɔ kidzo, kɛlɛ kifusisi nɛ̀ Owusoso Akaa dɔ ɛmã petee gɛzã ɛkɛlɛ nabha sɛ tɛ ananà atɛ kpatɔnɔ̃ alɛ.<verse eid="GEN 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 35:6" />Yakɔb nɛ̀ banɔnɔ petee gɛazã yɛishuɔ ediyì nɛ Luz, (gɛenu Bɛtɛl) nɛ Kana kesiakpa nabha. <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />Ɛkɛlɛ yɛabhɔ bɔdɔ̃pɔpɔɛ osubha, pɛ akɔ ɛkɛlɛ nɛinye asɛ Ɛl Bɛtɛl, ɔmɔsɛ ɛkɛlɛ Owusoso Akaa ebu yɛishu akasɛ yɛ nɛ kibeɛ gɛ ezebu tɛtsɛɖɛ mɛ ashɛ nɛ yɛadza ɔbhà.<verse eid="GEN 35:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 35:8" />Otsiɛ nɔ Debora gɛ yɛeɖi Rebeka abha ebetsí kɛlɛ bavɔbɔ yɛ nɛ odidosiɛ gɛɔzã Bɛtɛl niesi. Kliso bakɔ ɛkɛlɛ nɛinye asɛ Alɔn Bakut.<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />Kidegba gɛ Yakɔb etsyina ede Paɖan Aram, Owusoso Akaa ezebu yɛishu akasɛ yɛ pɛ eyulà akɔɛ. <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />Owusoso Akaa etseɖe yɛasɛ, "Wɔɛnyeɛ kɛlɛinu Yakɔb pɔ bezeke kulu wɔ asɛ Yakɔb; wɔɛinyeɛ ebedzi Israɛl." Kliso akɔ yɛinye asɛ Israɛl.<verse eid="GEN 35:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 35:11" />Kɛlɛ Owusoso Akaa etseɖe yɛasɛ, "Mɛinu Owusoso Akaa ohumi petee eleteɛ; mɔ beeyi tɛ wɔ tɛkakalà mɛ kpe tɔɖɔ. Amadi nɛ̀ ɛmã ebekoeyi odenɔ wɔ mɛ, kɛlɛ beekusi ebekoeyi odenɔ wɔ mɛ. <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />Kesiakpa gɛ ɛkɔ Abraham nɛ̀ Isak, mɛlɔkɔ kɔwɔ tsyɛ, kɛlɛ ɛbalɔkɔ kesiakpa alɛ akɔ wɔ kihui nɔ gɛ ababà nɛ wɔɛdeɛ." <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />Kɛlɛ Owusoso Akaa ashɛ ewu kabha nɛ ɛkɛlɛ gɛ aɖɔ kaɖɔ nɛ yɛ.<verse eid="GEN 35:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 35:14" />Yakɔb edzu kɛklagbu osi nɛ ɛkɛlɛ gɛ Owusoso Akaa aɖɔ kaɖɔ nɛ yɛ, kɛlɛ abalɛ̀ bunù asɛ bɔdɔ̃ kɔkɔ ana nɛ kɛlɛ abhà; azabalɛ bɔbɔ tsyɛ nɛ kɛlɛ abha. <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />Yakɔb akɔ ɛkɛlɛ gɛ Owusoso Akaa aɖɔaɖɔ nɛyɛ nɛinye asɛ Bɛtɛl.<verse eid="GEN 35:15" /></para>
  <para style="s1">Raxɛl nɛ̀ Isak Balɛ Titsitsí</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />Kɛlɛ bavɛ kidzo gagã nabha odenɔ Betɛl. Gɛ atɔ kɛbɔɛ tɛ beku Efratiɛ, bɔmɔ̃ vũ Ratsɛl, gɛ agagalĩ akɔɛ. <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />Kɛlɛ gɛ eyimɔmɔ̃ agagãlĩ akɔɛ nɔ, adzɛ gɛ ayɛkɛ bɔmɔ̃ɔ akɔɛ etseɖe yɛasɛ, "Tɛosifu, ɔmɔsɛ ɔmɔ̃ eyianyɛ bhlatɔ." <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />Gɛ afuĩa gɔgɔɛ nɔ-ɔmɔsɛ avɛlɛ dã olugbù-akɔ yɛeyianyɛ nɛinye asɛ, Ben-Oni. Pɔ yɛaka akɔ yɛinye asɛ Bɛnyamin.<verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />Klisoɔ Ratsɛl etsí kɛlɛ bavɔbɔ yɛ nɛ kidzoɔ gɛvɛ Efratiɛ (gɛenu Betlehem). <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />Yakɔb edzu kɛklagbu osi nɛ yɛ odzeɖe nabha, kɛlɛ bɔkpɛnɔ obuɔ kɛklagbu osi ɔlɛ gɛ edzuɔ dzi kɛwɔ̃ akɔ Ratsɛl odzeɖeɛ.<verse eid="GEN 35:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 35:21" />Israɛl ezewuli avɛ otugba edidzu yɛpɔtɛ kagba nɛ Migdal Elda otugba. <verse eid="GEN 35:21" /><verse number="22" style="v" sid="GEN 35:22" />Kibeɛ gɛ Israɛl azã kɛma ɛlɛ mɛ, Reuben avɛ adɛ wɔsɔ̃ nɛ̀ yɛaka yɛagɔlɔ Bilxa, kɛlɛ Israɛl elũ kibuiɛ.</para>
  <para style="b" vid="GEN 35:22" />
  <para style="m" vid="GEN 35:22">Yakɔb amɔ̃ beyianyɛ lɔfɔ nɛ̀ taabha.<verse eid="GEN 35:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 35:23" />Leya yɛeyialɛ balɛedzì:</para>
  <para style="li2" vid="GEN 35:23">Reuben yɛedzì Yakɔb yɛeyianyɛ gɛ eputɔɔ,</para>
  <para style="li2" vid="GEN 35:23">Simeon, Levi, Yuɖah, Isaka nɛ̀ Zebulon.<verse eid="GEN 35:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 35:24" />Ratsɛl yɛeyianyɛ balɛedzì:</para>
  <para style="li2" vid="GEN 35:24">Yosɛf nɛ̀ Bɛnyamin.<verse eid="GEN 35:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 35:25" />Ratsɛl yɛadzɛ axɔɛdɛ Bilxa yɛeyianyɛ balɛedzì:</para>
  <para style="li2" vid="GEN 35:25">Ɖan nɛ̀ Naftali.<verse eid="GEN 35:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 35:26" />Leya yɛadzɛ axɔɛdɛ Zilpa yɛeyianyɛ balɛedzì:</para>
  <para style="li2" vid="GEN 35:26">Gad nɛ̀ Asha.</para>
  <para style="p" vid="GEN 35:26">Banɔ alɛ balɛedzì Yakɔb yɛeyianyɛ gɛ bamɔ́ akɔɛ nɛ Paɖan Aram.<verse eid="GEN 35:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />Yakɔb avɛ kepi nɛ yɛaka Isak ɔkɔ nɛ Mamrɛ, gɛ etsò aplɛnɔ Kiriat Arba (gɛenu Hebrɔn), nɛ ɛkɛlɛ gɛ Abraham nɛ̀ Isak azãa. <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />Isak azã nɛkpã agɔ kɛkpã zɛzɛ nɛ̀ afɛtaasɛ. <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />Kɛlɛ yɛafuiã gɔgɔɛ pɛ etsí kɛlɛ balɔkɔ yɛavɛnɔ yɛeshopo alɛ, anɔ gɛ eshè nɛ̀ agɔ geleee. Kɛlɛ yɛeyianyɛ Esawu nɛ̀ Yakɔb avɔbɔ yɛ.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s1">Esawu Yɛ Kihui Nɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />Esawu Yɛishu Ebuiɛ Naalɛ (gɛenu, Edɔm).<verse eid="GEN 36:1" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="2" style="v" sid="GEN 36:2" />Esawu agbana yɛedzini alɛ odenɔ Kana badzɛ nɛishi: Elɔn Ada Xitieyiɛ yɛeyiadzɛ Elɔn, nɛ̀ Oholibama gɛenu Ana yɛeyiadzɛ pɛenu eshui tsyɛ akɔ Zibeon gɛenu Hivieyiɛ- <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />ɔplɛnɔ Bɔsmat, Ishmael yɛeyiadzɛ gɛenu Nebaiot yɛada.<verse eid="GEN 36:3" /></para>
  <para style="pi1">
    <verse number="4" style="v" sid="GEN 36:4" />Ada amɔ́ Elipãz akɔ Esawu, kɛlɛ Bɔsmat amɔ́ Rauɛl, <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />kɛlɛ Oholibama amɔ́ Yerus, Yalam nɛ̀ Kora. Banɔ alɛ balɛedzi beyianyɛ akɔ Esawu, gɛ bamɔ̃ akɔ yɛ nɛ Kana.<verse eid="GEN 36:5" /></para>
  <para style="pi1">
    <verse number="6" style="v" sid="GEN 36:6" />Esawu alɔkɔ yɛedzinì alɛ, yɛ beyianyɛ nɛ̀ beyiadzɛ nɛ̀ banɔnɔ petee gɛalɛ yɛɔpãmɛ, yɛ bɔpãmɛ bagãa nɛ̀ baagã bhlatɔ nɛ̀ bɔdɔ̃ petee gɛ amɔ̃ nɛ Kana, kɛlɛ avɛ kesiakpa tieli abha gɛazã odzololo ɔkɔ nɛ yɛadza Yakɔb ɔbhà. <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />Balɛ bɔdɔ̃ gɛ bamɔ̃ɔ kpe faanɔ ɔsɛ tɛ bazã bagɔlɔ ɔbhà; kesiakpa gɛ kalɛ abha bazã atɛ balà balɛ taabhà nabhà eɖi nɛ balɛ bɔpãmɛ bagãa shu so. <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />Kliso Esawu (gɛenu Eɖom) edi bhui kazã nɛ Sɛya ketukpɔ kesiakpa nabha.<verse eid="GEN 36:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />Esawu gɛedzi akaa akɔ Eɖomanɛ nɛ Sɛya ketukpɔ kesiakpa nabha yɛishu ebuiɛ nalɛ.<verse eid="GEN 36:9" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="10" style="v" sid="GEN 36:10" />Esawu yɛ beyianyɛ nɛinye naalɛ:</para>
  <para style="li2" vid="GEN 36:10">Elipãz, Esawu yɛedzini Ada yɛeyianyɛ, nɛ̀ Rauɛl, Esawu yɛedzini Bɔsmat yɛeyianyɛ.<verse eid="GEN 36:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="GEN 36:11" />Elifat yɛ beyianyɛ:</para>
  <para style="li2" vid="GEN 36:11">Teman, Omaɖ, Zepo, Gatam nɛ̀ Kɛnaz.<verse eid="GEN 36:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="GEN 36:12" />Agɔlɔ teli tsyɛ azã Esawu yɛeyianyɛ Elipãz ahɔɛ gɛ bezekulu asɛ Timna, gɛ amɔ̃ Amalɛk akɔɛ. Banɔ alɛ balɛedzì beshui akɔ Esawu yɛedzinì Ada.<verse eid="GEN 36:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 36:13" />Rauɛl yɛ beyianyɛ:</para>
  <para style="li2" vid="GEN 36:13">Naxat, Zera, Sama nɛ̀ Mizza. Banɔ alɛ balɛedzi beshui akɔ Esawu yɛedzini Bɔsmat.<verse eid="GEN 36:13" /></para>
  <para style="li4">
    <verse number="14" style="v" sid="GEN 36:14" />Esawu yɛedzinì Oholibama gɛenu Ana yɛeyiadzɛɛ yɛeyianyɛɛ naalɛ, Ana yɛeyiadzɛ pɛenu eshui akɔ Zibeɔn gɛ amɔ̃ akɔ Esawu.</para>
  <para style="li2" vid="GEN 36:14">Yeus, Yalam nɛ̀ Kora.<verse eid="GEN 36:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />Bagɛ edzì beekusi nɛ Esawu yɛeshopo alɛ nɛishi naalɛ:</para>
  <para style="li1" vid="GEN 36:15">Elipãz yɛ beyianyɛ gɛedzi beyiɛ gɛ Esawu eputɔ amɔ̃.</para>
  <para style="li2" vid="GEN 36:15">Beekusi Teman, Omaɖ, Zepo, Kɛnaz, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />Kora, Gatam, nɛ̀ Amalɛk. Banɔ alɛ balɛ edekoeyì nɛ Elipãz nɛ Eɖom mɛ; balɛedzi beshui akɔ Aɖa.<verse eid="GEN 36:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="GEN 36:17" />Esawu yɛeyianyɛ Rauɛl yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 36:17">Beekusi Naxat, Zera, Sama nɛ̀ Mizza. Banɔ alɛ balɛedzì beekusi gɛede koeyi nɛ Rauɛl nɛ Eɖom mɛ: balɛedzì beshui akɔ Esawu yɛedzinì Bɔsmat.<verse eid="GEN 36:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="GEN 36:18" />Esawu yɛedzinì Oholibama yɛeyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 36:18">Beekusi Yerus, Yalam, nɛ̀ Kora. Banɔ alɛ balɛedzì bekusiɛ gɛede koeyì nɛ Esawu yɛedzinì Oholibama gɛedzì Ana yɛeyiadzɛ mɛ.<verse eid="GEN 36:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 36:19" />Banɔ alɛ balɛedzì Esawu (gɛedzì Eɖom), kɛlɛ banɔ alɛ balɛ edzì bekusiɛ kɔalɛ.<verse eid="GEN 36:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />Sɛya gɛedzì Horieyiɛ pɛ bazã kesiakpa mɛ yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 36:20">Lɔtan, Sobal, Zibeɔn, Ana, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />Ɖishɔn, Eza nɛ̀ Ɖishan. Sɛya beyianyɛ alɛ nɛ Eɖom balɛedzì Horianɛ bekusiɛ.<verse eid="GEN 36:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 36:22" />Lotan yɛ beyianyɛ:</para>
  <para style="li2" vid="GEN 36:22">Hori nɛ̀ Hemam. Timna edzi Lotan yɛada.<verse eid="GEN 36:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 36:23" />Sobal yɛ beyianyɛ:</para>
  <para style="li2" vid="GEN 36:23">Alvan, Manahat, Ebal, Shepo nɛ̀ Onam.<verse eid="GEN 36:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 36:24" />Zibeɔn yɛ beyianyɛ:</para>
  <para style="li2" vid="GEN 36:24">Aiah nɛ̀ Ana. Ana alɛ yɛenu anunɔ gɛ adɛmɔ̃ bulĩɛ gɛ buvũ kifúɔ nɛ oxuiɛ mɛ nɛ kibeɛ gɛ aakɔ yɛaka Zibeɔn badiku nɔŋaŋãa.<verse eid="GEN 36:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 36:25" />Ana yɛeyialɛ:</para>
  <para style="li2" vid="GEN 36:25">Ɖisɔn nɛ̀ Oholibama gɛenu Ana yɛeyiadzɛ.<verse eid="GEN 36:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 36:26" />Ɖisɔn yɛ beyianyɛ:</para>
  <para style="li2" vid="GEN 36:26">Hemɖan, Eshban, Yitran nɛ̀ Karan.<verse eid="GEN 36:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="GEN 36:27" />Eza yɛ beyianyɛ:</para>
  <para style="li2" vid="GEN 36:27">Bilxan, Zaawan nɛ̀ Ákan.<verse eid="GEN 36:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="GEN 36:28" />Ɖisan yɛ beyianyɛ:</para>
  <para style="li2" vid="GEN 36:28">Uz nɛ̀ Aran.<verse eid="GEN 36:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="GEN 36:29" />Banɔ alɛ balɛedzì Horianɛ bekusiɛ:</para>
  <para style="li2" vid="GEN 36:29">Lotan, Shobal, Zibeɔn, Ana, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />Ɖishon, Eza nɛ̀ Ɖishan. Banɔ alɛ balɛedzì Horianɛ bekusiɛ, nɛ balɛ egbogbo mɛ nɛ Sɛya kesiakpa nabha.<verse eid="GEN 36:30" /></para>
  <para style="s1">Eɖom Beekusiɛ</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />Banɔ alɛ balɛ edzì bekusiɛ gɛaŋã bukusi nɛ Edɔm flogo pɛ Israɛlanɛ ekusi kanyiaka abaŋã bukusi:<verse eid="GEN 36:31" /></para>
  <para style="li2">
    <verse number="32" style="v" sid="GEN 36:32" />Bela gɛedzì Bayɔ yɛeyianyɛ ebedzì ekusi nɛ Edɔm. Bakɔ yɛ ɔmã gbagbla nɛinye ɔsɛ Ɖinhaba.<verse eid="GEN 36:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="GEN 36:33" />Kibeɛ gɛ Bɛla etsíɛ, Yɔbab gɛedzì Zera yɛeyianyɛ pɛ ede Bɔzra ayɛkɛ yɛɔzãkɔ asɛ ekusi.<verse eid="GEN 36:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="GEN 36:34" />Kibeɛ gɛ Yɔbab etsíɛ, Xusham gɛede Temananɛ kesiakpa nabha ayɛkɛ ɔzãkɔ asɛ ekusi.<verse eid="GEN 36:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="GEN 36:35" />Kibeɛ gɛ Xusham etsíɛ, Haɖaɖ gɛedzì Beɖaɖ, gɛ eté Medianɛ nɛ Moab kesiakpa nabha ayɛkɛ yɛɔzãkɔ asɛ ekusi. Bakɔ yɛɔmã gbagbla nɛinye ɔsɛ Avit.<verse eid="GEN 36:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="GEN 36:36" />Kibeɛ gɛ Haɖaɖ etsíɛ, Samla gɛede Masreka ayɛkɛ ɔzãkɔ asɛ ekusi nɛ yɛede.<verse eid="GEN 36:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="GEN 36:37" />Kibeɛ gɛ Samla etsíɛ, Shaol gɛede Raxobot nɛ keliɛ shuɔ ayɛkɛ yɛɔzãkɔ asɛ ekusi nɛ yɛede.<verse eid="GEN 36:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="GEN 36:38" />Kibeɛ gɛ Shaul etsíɛ, Baal-Xana gɛedzì eyianyɛ akɔ Akbɔ ayɛkɛ ɔzãkɔ nɛ yɛede asɛ ekusi.<verse eid="GEN 36:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="GEN 36:39" />Kibeɛ gɛ Baal-Hana gɛedzì eyianyɛ akɔ Akbɔ etsíɛ, Haɖaɖ ayɛkɛ yɛɔzãkɔ asɛ ekusi nɛ yɛede. Bekulu ɔmã gbagbala nɛinye ɔsɛ Pau, kɛlɛ yɛedzinì nɛinye kɛlɛ idzì Mehetabɛl gɛedzì eyiadzɛ akɔ Matrɛɖ, gɛ yɛtsyɛ edzì eyiadzɛ akɔ Mezaxab.<verse eid="GEN 36:39" /></para>
  <para style="b" />
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40" />Banɔ alɛ balɛedzì bekusiɛ gɛede ekoyì nɛ Esawu mɛ, nɛ balɛ enye nɛ̀ balɛ egbogbo nɛ̀ kɛma mɛ gɛ bazãa:</para>
  <para style="li2" vid="GEN 36:40">Timna, Alva, Yetɛt, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />Oholibama, Ela, Pinɔn, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />Kanaz, Teman, Mibza, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />Magdiɛl nɛ̀ Airam. Banɔ alɛ balɛedzì bekusiɛ nɛ Eɖom, nɛ kana gɛ bebhui bɔzã nulũ nɛ busiakpa mɛ gɛ bazãa.</para>
  <para style="p" vid="GEN 36:43">Esawu naalɛ gɛedzi akaa akɔ Eɖomanɛ.<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s1">Yosɛf yɛ Balaláa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />Yakɔb azã kesiakpa gɛ kalɛ abha yɛaka azã nɛ Kana.<verse eid="GEN 37:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="GEN 37:2" />Yakɔb yɛishu ebuiɛ naalɛ.</para>
  <para style="b" vid="GEN 37:2" />
  <para style="p" vid="GEN 37:2">Yosef ayisɔ̃ gɛ aŋã agɔ lɔfɔ nɛ̀ tegegene, ezeɖi baagã nabha ɔplɛnɔ yɛadzalɛ, Bilxa yɛeyianyɛ nɛ̀ Zilpa yɛeyianyɛ, yɛakaa edzinalɛ, gɛ alɔkɔ balɛishu ibui gɛinu kibui kpa amanà balɛ akaa.<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />Otsi nɔ Israɛl adɛmɛ Yosɛf kibui ɔdɛ yɛadzya gɔgɔɛ alɛ, ɔmɔsɛ yɛ bamɔ akɔɛ nɛ yɛ tishesheɛ mɛ; kɛlɛ abhɛtɛ akpɛkpɛ gɛ sikã bɔdɔ̃ zã yɛishu gelee akɔɛ. <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />Gɛ yɛadzalɛ amɔ̃ asɛ balɛ akaa adɛmɛ yɛibui adɛ akanyiaka nɛ balɛishiɛ, batɔɖɔ yɛelu kɛlɛ bazatɛ kanyã ɔkpɛ yɛɔkɔ.<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />Yosɛf aza bɔlala, kɛlɛ gɛ aɖɔ bɔlalaa etseɖe yɛadza alɛɛ, baza anyanã yɛakpɛ ɛyamɛ adɛ. <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />Etseɖe alɛ asɛ, "Nɔtaatɔ tɛ nɔolũ bɔlala lɛ gɛ ɛzaa. <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />Budzìbu agɔ̃lɛ nɛ bayaa mɛ pɛ bɔɔnyã alɛ asɛ agɔlɛsà, kɛlɛ odunũ nɔ mɛ agɔlɛsà ɔlɔ ɔzã kitití, kɛlɛ wɔnɔ agɔlɛsà shogo nɛ mɛ ɔyɛ shu kɛlɛ lɛizhi ekumũ ɔkɔ ɔlɛ."<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />Yɛadzalɛ etseɖe yɛasɛ, "Bɔpɛ wɔpɛ ɔsɛ tɛ ɔŋã bukusi nɛ bɔlɔ abha dza? Ɔbɔŋã bɔlɔ abha kɛgbã dza?" Kɛlɛ baza nyanã yɛakpɛ ɛyamɛ adɛ nɛ yɛ bɔlalá nɛ̀ kɛgɛ aɖɔɔ shu.<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />Kɛlɛ azaza bɔlalà bhlatɔ, kɛlɛ aɖɔ ɔlɛ etseɖe yɛadza alɛ. Aɖɔ asɛ, "Nɔtaatɔ tɛ nɔolũ, iwuli za bɔlalà bhlatɔ kɛlɛ nɛ kibe ɛlɛ mɛ xɔnɔ̃ ɛmɔ̃ kiwuiɛ́ nɛ̀ woele nɔ nɛ̀ awɔɛ lɔfɔ nɛ̀ tooli gɛ lezezhyi ekumũ akɔ mɛ."<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />Gɛ etseɖe yɛaka nɛ̀ yɛadzalɛ kibui ɛlɛɛ, yɛaka etseɖe nii pɛ aɖɔ asɛ, "Bɔlalà ɖuwoelu nɔɔlɛ pɔ wɔza? Pɔ wɔelĩ nɛ̀ mɛ nɛ̀ wɔadza alɛ ezhyi ekumũ akɔwɔ dza?" <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />Yɛadza alɛ azakpɛ yɛawɔ̃, pɔ yɛakaa xɔnɔ evũ kibuiɛ akpɛ yɛtakpu mɛ.<verse eid="GEN 37:11" /></para>
  <para style="s1">Yosɛf Yɛadzalɛ Adɛ yɛ</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />Otsinɔ yɛadzyalɛ agbana balɛ akaa baagã avɛnɔ bɔdɔ̃ ɔŋãkɔ nɛ Shikɛm ɔbhà, <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />kɛlɛ Israɛl etseɖe Yosɛf asɛ, "Asɛ kanà gɛ onyiɛ, wɔadzalɛ agbanà baagã avɛnɔ bɔdɔ̃ ɔŋãkɔ nɛ Sekɛm ɔbhà. Ba, ɛbakpɛ wɔ kɛxɔɛ nɛ balɛ ɔkɔ."</para>
  <para style="p" vid="GEN 37:13">Ebuiliulũ asɛ, "Yoo ilũ."<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />Kliso etseɖe yɛasɛ, "Vɛ tɛ odi lu awɔ̃ oɖi ɔsɛ kɛkanyiaka vɛ kɛlɛ abha piapii nɛ̀ wɔadzalɛ nɛ̀ baagã nɛishi dza, tɛ obotseɖe mɛ." Kɛlɛ akpɛ yɛidzo odenɔ Hebrɔn kadadasiɛ.</para>
  <para style="p" vid="GEN 37:14">Kibeɛ gɛ Yosɛf ediku Shikɛmuɔ, <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />anyɛ teli gɛ amɔ̃ yɛ gɛ anyɔ̃ akanà nɛ bayaa mɛ ebisi yɛasɛ, "Kiɖe wɔpɛɛ?"<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />Ebuiliulũ asɛ, "Ɛpɛɛ mɛadzalɛ. Ɔbɔlà kasɛ mɛ ɛkɛlɛ gɛ bakɔ balɛ bagãa nɔŋaŋãa dza?"<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />Anyɛ ebuiliulũ akɔɛ asɛ, "Batɛ shɛ nɛ ɛkɛlɛ̀. Ilũ gɛ baɖɔ asɛ 'Nɔkɔ tɛ bɔvɛ Dotan.' "</para>
  <para style="p" vid="GEN 37:17">Kliso Yosɛf atɔnɔ̃ yɛadzalɛ niede kɛlɛ adɛ mɔ alɛ nɛ Dotan ɔbhà. <verse eid="GEN 37:17" /><verse number="18" style="v" sid="GEN 37:18" />Pɔ batɛ mɔ yɛasɛsɛ nɛ odzololokɔ, kliso flogo tɛ ebeku balɛ ɔbhàa, batɛ nyã ɛlɛ asɛ bebeyii.<verse eid="GEN 37:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 37:19" />Baɖɔ etseɖe bagɔlɔ asɛ, "Bɔlalàzaza eleteɛ yɛaba alɛ mɔ̃! <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />Nɔbà tsiɔ̃ tɛ buyii tɛ bɔlɔkɔ yɛ tɛɔkpɛ ozĩ ɔlɛ mɛ tɛ bɔɖɔ ɔsɛ agãhohoe teli yɛevũ yɛatã. Kɛlɛ́ɛ bɔbà ɖi kɛgɛ bade koeyi nɛ yɛ balalà mɛ."<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />Gɛ Rubɛn elũ kibui ɛlɛ, apɛ asɛ tɛ ayɛkɛ yɛ odenɔ yɛadza alɛ ahɔɛ mɛ. Aɖɔ asɛ, Nɔtɛ kɔ bubú yɛkpã oyinɔ. <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />Nɔtɛ balɛ dzyosu nanà esi. Nɔtɛɛ yɛɔkpɛ ozĩɛ mɛ nɛ ɛkɛlɛ nɛ oxuiɛ mɛ, pɔ nɔtɛkɔ ɔsɛ wɔnɔ ɔhɔɛ lɔpà nɛ yɛishu." Rubɛn aɖɔ kibui ɛlɛ asɛ tɛ ebù yɛ odenɔ balɛ ahɔɛ mɛ tɛ edzinì yɛavɛnɔ yɛakaa.<verse eid="GEN 37:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 37:23" />Kliso gɛ Yosɛf eku yɛadzalɛ ɔbhàa, batsyɔ̃ɛ akpɛkpɛ nɛ yɛishu, akpɛkpɛ gɛ bakpɛ sikã bɔdɔ̃ nɛishu pɛ azakpɛɛ- <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />kɛlɛ bagbanà yɛadɛ tsɛkpɛ ɔzĩɛ mɛ. Otsinɔ kɛdɔ̃ nanà gɛzã ɔzĩɛ mɛ; bulĩ nanà gɛzã ɔlɛ mɛ.<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />Gɛ bezhyi azã kesi asɛ tɛ baŋã bɔdɔ̃ɔ, bebu bamɛ wunɔ kabha kɛlɛ bamɔ̃ beedzigãelete kɛza tili gɛinu Ishmael yɛeshui alɛ gɛede Gilaɖ pɛ baaba. Bakpɛ ɔsà, kivee, babɔ gɛalɔ̃ huhuuhu nɛ̀ aɖuɖo etuku atɔɖɔ balɛ kipuasɔ nɔ abha, pɛ balɔkɔ avɛnɔ Egipte.<verse eid="GEN 37:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 37:26" />Yuɖa etseɖe yɛadzalɛ asɛ, "Kiɖe bɔbà mɔ nɛ kɛlɛ mɛ gɛ onupɛ buyí bɔlɔ adza, pɛ bɔlɔkɔ bɔdɔ̃ dã yɛ dzyosu abha? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />Nɔba, nɔkɔ bɔdɛ yɛ ɔkɔ Ishmael yɛeshui alɛ tɛ bɔlɔ ahɔɛ ɔtɛ bapá nɛ yɛishu; nɛidzo kanyiaka abha tsyɛɛ, bɔlɔ adzya yɛenu, bɔlɔ ahɔɛ ishudza nɛ̀ dzyosu." Yɛadzalɛ adɛmɛ atɔɖɔ kɛlɛ abhà.<verse eid="GEN 37:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 37:28" />Kliso gɛ Miɖianɛ edzigãeleteɛ ebeku ɛkɛlɛɛ, Yosɛf yɛadzalɛ edibui oyinɔ nɛ ɔzĩɛ mɛ kɛlɛ badɛ yɛkɛ sikãfufù ehoeyi afɛtaabha akɔ Ishmael yɛeshui alɛ, gɛ balɔkɔ yɛavɛnɔ Egipte.<verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />Gɛ Rubɛn etsodzi avɛ ɔzĩɛ shu pɛ amɔ̃ asɛ Yosɛf amã ɔlɛ mɛɛ, atsyɔ̃ɛ yɛakpɛkpɛ mɛ. <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />Etsyina avɛ yɛadzalɛ ɔbhà kɛlɛ aɖɔ asɛ, "Anyɛnuvɔɛ nɔ abhamã ɛkɛlɛ́! Kiɖe mɛbà bhɛtɛ otsiɛ?"<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />Kɛlɛ balɔkɔ Yosɛf yɛakpɛkpɛ, bebhui epigya teli kɛlɛ batsɛ yɛakpɛkpɛ nɔ akpɛ dzyosu nɔ mɛ. <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />Balɔkɔ akpɛkpɛ gɛ sikãdɔ̃ zã yɛishuɔ edzinɔ avɛnɔ balɛ akaa kɛlɛ betseɖe yɛasɛ, "Bɔdɛ mɔ kɛdɔ̃ ɛlɛ. Lu awɔ̃ oɖi yɛ sɛ gɛnɛ wɔeyianyɛ akpɛkpɛ dza."<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />Amɔ̃ asɛ yɛdɔ nyinyi kɛlɛ aɖɔ asɛ, "Mɛeyianyɛ akpɛkpɛ yɛenu! Agãhoe teli evũ yɛatã. Batsã Yosɛf mɛ wuliwuli kɛgbã."<verse eid="GEN 37:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 37:34" />Kɛlɛ Yakɔb atsyɔ̃ɛ yɛahɔɛ akpɛkpɛ mɛ, adɛ lɔkɔ kɛpɔtɛ tutũ adã kɛlɛ awɔã ɔwɔnyɔ̃nɔ̃ akɔ yɛeyianyɛ ewui gelee. <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />Yɛeyianyɛ nɛ̀ beyiadzɛɛ petee abayɔ yɛishu mɛ, pɔ agɛ dɛmɛ asɛ bayɔ yɛishu mɛ tsyɛ. Aɖɔ asɛ, "Oho, nɛ mɛ ɔwɔnyɔ̃nɔ ɛlɛ mɛɛ, mɛtsyɛ bavɛ odzeɖeɛ mɛ ɔplɛnɔ mɛeyianyɛ." Kliso yɛakaa ebieyo akɔɛ.<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />Pɔ nɛ kibe ɛlɛ mɛ, Miɖianɛ tsyɛ atɛdɛ Yosɛf nɛ Egipte akɔ Potifa, Farao yɛ keyuta anɔ̃, agɛ yɛalɛ otugbà akɔ bagɛ eepo yɛɔpã nulũ azazã.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s1">Yuɖa Nɛ̀ Tama</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />Nɛ Kibe ɛlɛ mɛɛ, Yuɖa ashɛ nɛ yɛadzalɛ ɔbhà kɛlɛ ezhyi avɛ adɛzã Adulam anyɛ teli gɛ bekulu asɛ Xira ɔkɔ. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />Ɛkɛlɛ Yuɖa atsyanà Kana anyɛ gɛ bakɔ yɛinye asɛ Sua yɛeyi adzɛnuvɔɛ. Agbanà yɛ kɛlɛ awɔsɔ̃ nɛ yɛ; <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />emunù ɛya kɛlɛ amɔ̃ eyianyɛ gɛ bakɔ yɛinye asɛ Er. <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />Eze emunù ɛya kɛlɛ amɔ́ eyianyɛ gɛ bakɔ yɛinye asɛ Onan. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />Ezamɔ̃ eyianyɛ kɛlɛ akɔ yɛinye asɛ, Shila. Nɛ Kezib yɛamɔ̃ yɛ.<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />Yuɖa agbanà adzɛ akɔ Aaɖi gɛedzi yɛeyi kusiɛ, kɛlɛ yɛinye kɛlɛinu Tama. <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />Pɔ Yuɖa yɛeyianyɛ ekusiɛ yɛtakpumɛ gagalĩ nɛ Apaleteɛ namɛ; Kliso Apaleteɛ eyíi.<verse eid="GEN 38:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 38:8" />Kɛlɛ Yuɖa etseɖe Onan asɛ, "Wɔsɔ̃ nɛ̀ wɔadza edzinì tɛ ɔwɔa yɛxɔɛ nɛ yɛishu asɛ yɛakunta ana tɛ ɔmɔ̃ eyì ɔkɔ wɔadzaa." <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />Pɔ Onan enyì asɛ beeyiɛ etibèdzi yɛayɛ; klisoɔ kibenyiabè gɛ awɔsɔ̃ nɛ̀ yɛadza edziniɛ, ezebu yɛɔbalɛ lu kesiakpa tɛ kɛtɛ kɔ yɛamɔ́ eyi akɔ yɛadzaa. <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />Kibuiɛ gɛ abhɛtɛ kinu kɛtakpumɛ gagalĩ ibui nɛ Apaleteɛ namɛ soɔ, eyíi tsyɛ.<verse eid="GEN 38:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 38:11" />Kɛlɛ Yuɖa etseɖe yɛeyridze Tama asɛ, "Zã asɛ anyɛ gɛ yɛenyine tsí ana nɛ wɔaka bɔpãmɛ ɔvɛnɔ ɔsɛ mɛeyianyɛ Shela eshè." Ɔmɔsɛ eɖi asɛ, "Yɛtsɛ ebetsí asɛ yɛadzalɛ ana." Kliso Tama adɛzã yɛaka bɔpãmɛ.<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />Nɛ kibe dzololo mɛɛ, Yuɖa yɛedziniɛ gɛenu Sua yɛeyiadzɛ etsí. Gɛ Yuɖa azã ɔwɔnyɔnɔ̃ mɛ ebekeɛ, ewu avɛ Timna, nɛ banyɛ gɛ baatsɛ̀ tɛkãa akɔ yɛibhoshiɛ ɔkɔ, kɛlɛ yɛɔbhia gɛ bekulu asɛ Xira pɛenu Adulameyiɛ avɛ nɛ yɛ.<verse eid="GEN 38:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 38:13" />Kibeɛ gɛ betseɖe Tama asɛ, "Wɔanɔ̃ akpɛsɛ kidzoɔ mɛ aba Timna abatsɛ tɛkã akɔ yɛibhoshiɛ," <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />ebu yɛɔdɔ̃ kpɛkpɛ gɛ kasɛ asɛ yɛenyine etsíɛ nɛishu, alɔkɔ kɛpɔtɛ ekumũ yɛamɛ tɛ batɛmɔ̃ asɛ yɛ kɛlɛ adɛzã kedulũɔ gɛavɛ Enayim, gɛalɛ kidzoɔ gɛilí ɔvɛ Tima shu. Pɔ gɛ Shela eshè otsialɛ tsyɛ, baka lɔkɔ yɛakɔ yɛ asɛ yɛedzinì ana.<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />Gɛ Yuɖa amɔ̃ yɛɛ, eɖi asɛ kedulũ azazã elete yɛenu, ɔmɔsɛ adã bɔdɔ̃ nɛ yɛamɛ. <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />Gɛ egiti asɛ yɛeyiridzeɛ naalɛ, avɛ yɛɔbhà nɛ kidzoɔ shu pɛ etseɖe yɛasɛ, "Ba otsiɛ tɛ mɛ wɔsɔ̃ nɛ wɔ."</para>
  <para style="p" vid="GEN 38:16">Kɛlɛ ebuiliulũ asɛ, "Kɛlɛ kiɖe wɔtsyɛ ɔbɔ kɔmɛ tɛ ɛdɛ wɔsɔ̃ nɛ̀ wɔ?"<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />Aɖɔ asɛ, "Ɛba sɛsɛ wɔ epigyaeyi odenɔ mɛ baagã nɛishi."</para>
  <para style="p" vid="GEN 38:17">Adzɛ ebisi yɛasɛ, "Kiɖe ɔbɔ kɔmɛ kede kɛdɔ̃ ɔdɛkpɛnɔ sɛ ɔsɛsɛ yɛ?"<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />Yuɖa ebisi yɛasɛ, "Kɛklagbu tɔtɔɖɔ ibui idɔ̃ ɖuwoelu wɔpɛ ɔsɛ ɛkɔ wɔ?"</para>
  <para style="p" vid="GEN 38:18">Adzɛ ebuiliulũ asɛ, "Kɔmɛ wɔ kisikpɛ nɔ gɛ wɔɛnyeɛ tsiɖi kɛlɛ abha nɛ̀ wɔ osivuvũɔ gɛɔlɛ wɔahɔɛ mɛ flogo." Kliso alɔkɔ akɔɛ kɛlɛ adɛ wɔsɔ̃ nɛ̀ yɛ, kɛlɛ emunũ ɛya akɔɛ. <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />Kibeɛ gɛ adzɛ ashɛ ebekeɛ, ebu yɛ kɛpɔtɛ gɛ ekumũ nɛ yɛamɛ elú, kɛlɛ edzinɔ yɛɔdɔ̃ gɛ akpɛ nɛ yɛedziniɛ butsiɛ shuɔ akpɛ.<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />Kibe ɛlɛ mɛ pɔ, Yuɖa atɛ lɔkɔ epigyaeyiɛ asɛsɛ yɛ ɔganà yɛɔbhia gɛenu Aɖulameyiɛ nabha ɔsɛ tɛ edzinì kede bɔdɔ̃ ayɛkɛ nɛ adzɛ ahɔɛ, pɔ agɛmɔ̃ yɛ. <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />Ebisi banyɛɛ gɛazã ɛkɛlɛ asɛ, "Fakɔ kedulũ zazã eleteɛ gɛazã kidzoɔ shu nɛ Enayimuɔ alɛ dza?"</para>
  <para style="p" vid="GEN 38:21">Bebuiliulũ asɛ, "Kedulũ zazã elete bɔpã nanà agɛzã ɛkɛlɛ̀."<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />Kliso etsyina avɛ Yuɖa ɔkɔ editseɖe yɛasɛ, "Ɛgɛdɛ mɔ yɛ. Lɔkɔ ɔplɛnɔɔ, banyɛ gɛazã ɛkɛlɛ aɖɔ asɛ, 'Kedulũ zazã elete bɔpã nanà agɛzã ɛkɛlɛ̀.'"<verse eid="GEN 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23" />Kɛlɛ Yuɖa aɖɔ asɛ, "Kɔ yɛalɔkɔ kɛgɛ lɛ yɛahɔɛ balɛ, onu gɛnanaa babàmɔɛ bɔlɔ. Nɛ kɛkanyiaka mɛɛ, ɛsɛsɛ yɛ epigyaeyi alɛ pɔ ɔgɛ dɔmɔ̃ yɛ."<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />Nɛ bewoele taata kedeɛ, betseɖe Yuɖa asɛ, "Wɔ eyiridze Tama adɔ ɔshà nɛ kedulũ zazã kibui shu, kɛlɛ nɛ kibui ɛlɛ shu soɔ, emunù ɛya otsiɛ."</para>
  <para style="p" vid="GEN 38:24">Yuɖa aɖɔ asɛ, "Nɔobu yɛ oyinɔ tɛ bɔpɔɛ yɛ tɛ etsí!"<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />Nɛ kibeɛ mɛ gɛ beebu yɛ oyinɔɔ, asɛsɛ yɛanɔ̃ ɔklasɔ̃. Aɖɔ asɛ, "Imunù ɛya akɔ anyɛ gɛ yɛɔdɔ̃ nɔɔlɛ." Azaɖɔ aplɛnɔ asɛ, "Ɖi sɛ ɔbɔla bakà anunɔ gɛ yɛinye kɛlɛ itsiɖi ohui nabha nɛ̀ osivuvũ ɔlɛ abha."<verse eid="GEN 38:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26" />Yuɖa abakà bɔdɔ̃ kɛlɛ aɖɔ asɛ, "Adzɛ alɛ ishu bhui ɔdɛ mɛ, ɔmɔsɛ ɛgɛ lɔkɔ yɛ kɔ mɛeyianyɛ Shela." Kɛlɛ aga wɔsɔ̃ nɛ̀ yɛ.<verse eid="GEN 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27" />Gɛ kibeɛ na ɔsɛ tɛ amɔ̃ eyiɛɛ, taabhà eyianyɛ balɛ azã yɛ kamɔmɔ̃vũɔ mɛ. <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />Gɛ aamɔ̃ beyiɛɛ, tenikpo nɔ akpɛ yɛɔhɔɛ asɛsɛ; kliso bɔmɔ̃asɔsɔlɛ eleteɛ alɔkɔ keputakpã dzadzã anyã yɛ kahɔkpɔ nulũ pɛ aɖɔ asɛ, "Yɛalɛ yɛeputɔ aba." <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />Pɔ gɛ edzinɔ yɛɔhɔɛ avɛnɔ, yɛadzya ekoeyì kɛlɛ adzɛ aɖɔ asɛ, "Kliso kana wɔ opú okoeyi." Kɛlɛ bakɔ yɛinye asɛ Pɛrɛz. <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />Kɛlɛ yɛadza gɛ keputakpã dzadzã azã yɛahɔkpɔ nulũɔ ekoeyì kɛlɛ bakɔ yɛinye asɛ Zɛra.<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s1">Yosɛf nɛ̀ Pɔtifa Yɛedzini</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />Otsi nɔ balɔkɔ Yosɛf avɛnɔ Egipte. Pɔtifa, Egipte eyi gɛenu Faɖawo ɔzãkɔanɔ gbagbala, gɛeɖi bagɛ beepo yɛ nabha, edzii nɛ Ishmaelanɛ gɛ balɔkɔ yɛ avɛnɔ ɛkɛlɛ́ ahɔɛ.<verse eid="GEN 39:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 39:2" />Apalete azãplɛnɔ Yosɛf kɛlɛ ebui apɛ̃ akɔɛ, kɛlɛ azã yɛ Egipte apaleteɛ bɔpã mɛ. <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />Gɛ yɛ apaleteɛ amɔsɛ Apalete alɛ aplɛnɔ yɛ, pɛ Apalete akɔ asɛ kɛkanyiaka gɛ abhɛtɛ kɛdɔ kɛlɛ abhaa, <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />Yosɛf eku awɔ̃ nɛ yɛanhũɔ mɛ kɛlɛ ebedzi yɛ apɛplɛnɔ. Pɔtifa alɔkɔ yɛedzu yɛ bɔpã nulũ, kɛlɛ alɔkɔ yɛ kɛkanyiaka akpɛ yɛahɔɛ mɛ. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />Odenɔ kibeɛ gɛ akɔ asɛ eɖi yɛ bɔpã nɛ kɛkanyiaka gɛlɛ yɛahɔɛ nabhaa, Apalete eyula Egipte eyie bɔpã nɛ Yosɛf kɛtakpu. Apalete yɛ tiyuyula azã kɛkanyiaka gɛ kɛlɛ Pɔtifa ahɔɛ, nɛ bɔpã mɛ nɛ̀ ayakpa mɛ. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />Kliso alɔkɔ yɛ kɛkanyiaka akpɛ Yosɛf ahɔɛ; gɛ Yosɛf yɛeɖi yɛ bɔdɔ̃ nabhaa, ebuamɛ nɛ kɛkanyiaka abhà ɔdɛ yɛ kɛŋaŋã gɛ aŋã yete.</para>
  <para style="p" vid="GEN 39:6">Otsi nɔ Yosɛf amɔ ishumɛ piapii kɛlɛ eyu buyinsɔ, <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />kɛlɛ nɛ kibe teli idiɛ, yɛ apaleteɛ yɛedziniɛ ebhui awɔ̃ nɛ̀ Yosɛf kɛlɛ aɖɔ asɛ, "Ba tɛ ɔbɔ wɔsɔ̃ nɛ mɛ!"<verse eid="GEN 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 39:8" />Pɔɔ agɛ dɛmɛ. Etseɖe yɛasɛ, "Nɛ mɛ bɔdɔ̃abhaɖiɖiɛ mɛ, mɛ apaleteɛ ebuamɛ nɛ kɛkanyiaka shu nɛ bɔpã mɛ; yɛ kɛkanyiaka alɔkɔ akpɛ mɛ ahɔɛ. <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />Anɔ nanà agɛ mɔ ohumi nɛ bɔpã ɔlɛ mɛ adɛ mɛ. Mɛ apaleteɛ ebuidzo nɛ yɛ kɛkanyiaka ishu akɔmɛ ɔdɛ wɔ yete, ɔmɔsɛ wɔonu yɛedzini. Kiɖeso pɛ ɛbabhɛtɛ kɛtakpumɛ gagalĩ lɛ pɛ ɛbaŋã kɛpɔ nɛ Owusoso Akaa ishu?" <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />Gɛ eze bisi odenɔ Yosɛf ɔkɔ kiwui ɔvɛnɔ kiwui mɛ tsyɛɛ, agɛdɛmɛ asɛ tɛ awɔsɔ̃ nɛ̀ yɛ pɛnɔsɛ tɛ azã plɛnɔ yɛ.<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />Kiwui tenikpo avɛ yɛaxɔɛ ɔwa ɔkɔ nɛ bɔpã mɛ, kɛlɛ baxɔɛdɛ ɔmayɛmɛ nanà agɛ zã bɔpã mɛ. <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />Adzɛ atahɔɛ anyanà yɛ kabha akpɛkpɛ kɛlɛ etseɖe yɛasɛ, "Ba tɛ ɔbɔ wɔsɔ̃ nɛ mɛ!" Pɔɔ etso ekoeyì nɛ kabha akpɛkpɛ mɛ akpɛ yɛahɔɛ mɛ pɛ ebu tɛtsɛɖɛ mɛ ekoeyi nɛ bɔpã mɛ.<verse eid="GEN 39:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 39:13" />Gɛ amɔ asɛ yɛ kabha akpɛkpɛɛ awɔ yɛahɔɛ mɛɛ pɛ ebú tɛtsɛɖɛ mɛ ekoeyi nɛ bɔpã mɛɛ, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />ekulu yɛ bɔpãmɛ axɔɛdɛ. "Noɖi mɔ," aɖɔ etseɖe balɛ asɛ, "Bamana Hebrieyialɛ sɛ tɛ aba pɛ́ɛ bɔlɔ! Aba ɛkɛlɛ sɛ tɛ awɔsɔ̃ nɛ mɛ, pɔɔ ɛkpɛ ozĩ. <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />Gɛelũ sɛ ɛkpɛ ozĩ tɛ banɔ aba aplɛnɔ mɛɛ, ashɛ ayɔlɔ yɛ kabha akpɛkpɛ nɛ mɛɔbha pɛ ebú tɛtsɛɖɛ mɛ ekoeyi nɛ bɔpã mɛ."<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />Abálɛ kabha akpɛkpɛ ɔdɛkpɛnɔ kibeɛ gɛ yɛ apaleteɛ aba bɔpã mɛ. <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />Kɛlɛ aɖɔ kibui ɛlɛ etseɖe yɛ: "Hebrieyi axɔɛdɛ alɛ gɛ ɔmana bɔlɔ ebetsoku mɛabhà sɛ tɛ apɛ́ɛ mɛ. <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />Pɔɔ gɛ ɛkpɛ ozĩ tɛ banɔ aba plɛnɔ mɛ soɔ, ashɛ yɔlɔ yɛ kabha akpɛkpɛ nɛ mɛɔbha kɛlɛ ebu tɛtsɛɖɛ mɛ ekoeyi nɛ bɔpã mɛ."<verse eid="GEN 39:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />Gɛ yɛ apaleteɛ elũ kibuiɛ gɛ yɛedzini etseɖe yɛ, pɛ aɖɔ asɛ, "Kana wɔ axɔɛdɛ dzidziɛ abhɛtɛ amana mɛɔkɔɔ," ɔmɔpɔɛ tsuifu nɛ yɛ mɛ. <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />Yosɛf yɛ apaleteɛ alɔkɔ yɛ adɛkpɛ ɔɖa buvũ mɛ, nɛ ɛkɛlɛ gɛ baadã ekusiɛ yɛ ebuikpa bhɛbhɛtɛanɛ akpɛ.</para>
  <para style="p" vid="GEN 39:20">Pɔɔ gɛ Yosɛf azã ɔɖa buvũɔ mɛɛ, <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />Apalete azã plɛnɔ yɛ; abhɛtɛ ɛyamɛ gbangbã akɔ yɛ kɛlɛ akɔ asɛ tɛ anunɔ gɛ eeɖi ɔɖa buvũmɛanɛ nabha adɛmɛ yɛ kibui. <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />Kliso ɔɖa buvũabha eɖiɖileteɛ alɔkɔ kɛkanyiaka gɛ babhɛtɛ nɛ ɔɖa buvũɔmɛ akpɛ yɛahɔɛ. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />Ɔɖa buvũabha eɖiɖileteɛ egelu awɔ̃ nɛ kɛkanyiaaka mɛ gɛ alɔkɔ akpɛ Yosɛf ahɔɛ, ɔmɔsɛ Apalete azã aplɛnɔ Yosɛf kɛlɛ akɔ yɛ kɛkanyiaka gɛ abhɛtɛ dɔ kɛlɛ abha akɔɛ.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s1">Bunùeshishi elete nɛ̀ Aboloapɔpɔɛ elete</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />Kibe teli kidiɛ, Egipte ekusiɛ yɛ bunueshishi elete eshesheɛ nɛ̀ aboloapɔpɔɛ elete eshesheɛ babhɛtɛ kibui kpa nɛ balɛ apalete, Egipte ekusiɛ ishu. <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />Faɖawo akpɛ ɔmɔpɔɛ nɛ yɛ ɔzãkɔanɔ taabha ishu, gɛenu bunueshishi elete eshesheɛ nɛ̀ aboloapɔpɔɛ elete eshesheɛ, <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />kɛlɛ akpɛ balɛ buvũ nɛ banɔepopo elete eshesheɛ yɛ bɔpã mɛ, nɛ ɔɖa buvũɔ mɛ gɛ badã Yosɛf tsyɛ akpɛɛ. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />Banɔepopoelete eshesheɛ alɔkɔ balɛ akpɛ Yosɛf ahɔɛ kɛlɛ eɖi balɛ abha.</para>
  <para style="p" vid="GEN 40:4">Gɛ bazã buvũ nɛ kibe teli kidiɛ, <verse eid="GEN 40:4" /><verse number="5" style="v" sid="GEN 40:5" />banyɛ edi taabha-Egipte ekusiɛ yɛ bunueshishi elete nɛ̀ aboloapɔpɔɛ eleteɛ, gɛ bakpɛ buvũɔɔ-ɔmaimɛ kanyiaka azá bɔlala elishi tenikpo, kɛlɛ bɔlala kanyiaka nɛ̀ bɔlɛ kesi bubú.<verse eid="GEN 40:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 40:6" />Gɛ Yosɛf aba balɛ ɔbha kɛvɔlɔɔ, amɔsɛ balɛ ishumɛ gbã. <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />Kliso ebisi Faɖawo yɛ ɔzãkɔanɔnɔ gɛ akpasɛ buvũ nɛ yɛ apaleteɛ bɔpã mɛ asɛ, "Kiɖe sopɛ wɔnɔ baamɛɛ beku otumũ ana obuɔ?"<verse eid="GEN 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8" />Bebuiliulũ asɛ, "Bɔlɔ taabhaa zá bɔlala, pɔɔ anɔ nanà amá gɛ ebebu balɛ esi."</para>
  <para style="p" vid="GEN 40:8">Kɛlɛ, Yosɛf etseɖe balɛ asɛ, "Kesi bubuɔ pɔ gɛnɛ Owusoso Akaa ayɛ dza? Notseɖe mɛ wɔnɔ balala."<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />Kliso bunueshishi elete eshesheɛ etseɖe Yosɛf yɛ bɔlala. Etseɖe yɛasɛ, "nɛ mɛ bɔlala mɛɛ, ɛmɔ wain kihui nɛ mɛ otugba, <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />kɛlɛ bɔshɛ tɔɔta zã wain kihui nabha. Kibeɛ gɛ ata eyiɛ, eyiɛ efu, kɛlɛ yɛ efufuɔ eyù beyuyu gɛ beshe akɔ tɛpɔ̃pɔ. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />Faɖawo kayintse nɔ azã mɛ ahɔɛ mɛ, kɛlɛ mɛlɔkɔ wain eyuyuɔ, ɛ́kã alɛ kpɛ Faɖawo kayintse nɔ mɛ kɛlɛ mɛlɔkɔ kayintse nɔ kpɛ yɛahɔɛ mɛ."<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />Yosɛf etseɖee yɛasɛ kɛlɛ kesi bubuɔ naalɛ, "Bɔshɛɛ tɔɔta enu ewui taata. <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />Nɛ ewui taata mɛɛ, Faɖawo ebebu wɔ kɛtakpuɔ wunɔ kabha kɛlɛ ebedzinɛ wɔ edzu wɔ ɔzãkɔ, kɛlɛ ɔbɔ lɔkɔ Faɖawo kayintse nɔ kpɛ yɛahɔɛ mɛ, asɛ kana gɛ ɔzɔbhɛtɛ baflanɔ gɛ odzi yɛ bunueshishi eleteɛ. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />Pɔɔ, onu pɛ kɛkanyiaka vɛ kɛlɛ abha piapi kɔ wɔɔ, bakà mɛ tɛ ɔkasɛ mɛ ɛyamɛ gbangbã; ɖɔ mɛibui otseɖe Faɖawo tɛ ebumɛ oyinɔ nɛ ɔɖavũ ɛlɛ mɛ. <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />Ɔmɔsɛ tɛgagalĩ mɛ balɔkɔ mɛ ashɛnɔ nɛ Hebrianɛ kesiakpa nabha, kɛlɛ nɛ ɛkɛlɛ tsyɛ ɛgɛ bhɛtɛ kibui nanà gɛ shɔnɔ ɔsɛ tɛ bakpɛ mɛ buvũ flogo."<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />Gɛ aboloapɔpɔɛlete eshesheɛ amɔsɛ Yosɛf akɔ kesi bubu gbangbãa, etseɖe Yosɛf asɛ, "Mɛ tsyɛ ɛza bɔlala; Abolo bɔshɔɛ tɔɔta bazã mɛ kɛtakpu nabha. <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />Bɔdɔ̃pɔpɔɛ ediedi azã adãmɛ kɛshɔɛ nɔ mɛ kɔ Faɖawo, pɔɔ bɔzhɔɛ nɔ zɛŋã bɔdɔ̃ odenɔ kɛshɔɛ nɔ mɛ nɛ mɛ kɛtakpuɔ."<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />Yosɛf etseɖee yɛasɛ "Kɛlɛ kesi bubuɔ naalɛ, "Bɔshɔɛ tɔɔta bunu ewui taata. <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />Nɛ ewui taata mɛɛ Faɖawo ebebu wɔ kɛtakpuɔ wunɔ kabha kɛlɛ aba kpɛ wɔ asɔ̃ nɛ busi abha. Kɛlɛ bɔzyɔɛ nɔ batsyuĩ wɔ ishudzaa shɛnɔ."<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />Otsinɔ kiwui taɖamɛ kɛlɛinu Faɖawo yɛ kidzewui, kɛlɛ atɔɖɔ ketsukpu kɔ yɛ banɔgbagbla petee. Ebu bunueshishi elete eshesheɛ nɛ̀ abolopɔpɔɛ elete eshesheɛ balɛ kɛtakpu wunɔ kabha nɛ yɛ ɔzãkɔanɔ gbagbla namɛ: <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />Edzinɔ bunueshishi elete eshesheɛ edzu yɛ ɔzãkɔ kukuɔ, kɛlɛ aza lɔkɔ kayintse akpɛ Faɖawo yɛ ahɔɛ mɛ, <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />pɔɔ akpɛ aboloapɔpɔɛ elete eshesheɛ asɔ̃ asɛ kana gɛ Yosɛf aɖɔ etseɖe balɛ nɛ yɛ kesi bubuɔ mɛ.<verse eid="GEN 40:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 40:23" />Pɔɔ, bunueshishi elete otugbaanɔ, agɛ baka Yosɛf; adzɛkɛ yɛibui.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s1">Faɖawo Balaláa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />Gɛ agɔ taabha bafalaa, Faɖawo aza bɔlalá: Alɔɛtiti nɛ Nail kelĩɛ ishu, <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />kɛlɛ odenɔ kelĩɛ mɛ banɛntsyɔɛ tegegene bekoeyi, balɛ ishupiɛ apɛ̃ kɛlɛ beluubɔ́, kɛlɛ bazatã bɔdɔ̃ nɛ bulĩɛ tɛwa ɛmɛ. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />Kɛlɛ idiɛ, banɛntsyɔɛ tegegene bhlatɔ gɛ begɛiyunɔ kɛlɛ bazhyɔlɛ, bekoe nɛ Nail kelĩɛ mɛ kɛlɛ babalɔ baagɛ balɛ kelĩɛ ishu ɔbha. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />Kɛlɛ banɛntsyɔɛ nɔ gɛ begiyiunɔɔ bevũ banɛntsyɔɛ tegegeneɛ gɛ balɛ ishupiɛ pɛ̃ pɛ beluubɔ́ atã. Kɛlɛ Faɖawo anyɛmɛ.<verse eid="GEN 41:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 41:5" />Aza vɛnɔ taɖamɛ kɛlɛ azaza bɔlala bhala: Nikpè atakpu tegegene, gɛ bakpɛ eyi pɛ bapɛ̃ piapii nɔ, betsiɖi osi tenikpo abha. <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />Nɛ́ balɛ kidiɛ, nikpè atakpu tegegene bhlatɔ beyì ekoeyi-gɛ begi gbogblo kɛlɛ bakpáa odenɔ kɛlɛɛ nɔ gɛide kiwuiɛ otukɔɔ mɛ. <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />Nikpè atakpuɔ gɛ legi gbogbloɔ bamɛnɛ nikpè atakpuɔ tegegeneɛ, gɛ lakpɛ eyi pɛ atakpúɔ leyúkuɔ. Kɛlɛ Faɖawo anyɛmɛ; bɔlalá naalɛ.<verse eid="GEN 41:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 41:8" />Yɛ ekpeɖekpeɖeɛ mɛ akpɛ yɛuluhũ nɛ kɛvɔlɔ mɛ, kliso ekulu yɛ bakpukpudziɛ nɛ̀ Egipte bebutinɛ. Faɖawo etseɖe balɛ yɛ balalá, pɔɔ ananà agɛlà bale kesi ebu akɔɛ.<verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />Kɛlɛ mɛɛ bunueshishi eleteɛ otugbaanɔ etseɖe Faɖawo asɛ, "Obuɔ, babakamɛ mɛ kesitatá. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />Faɖawo atɛ akpɛ ɔmɔpɔɛ nɛ yɛ baxɔɛdɛɛ ishu eɖi, kɛlɛ akpɛ mɛ nɛ̀ abolopɔpɔɛ eleteɛ otugbanɔ buvũ nɛ banɔepopoelete otugbanɔ yɛ bɔpã mɛ. <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />Bɔlɔ ɔmayɛmɛ akanyiaka azá bɔlala nɛ elishi tenikpo, kɛlɛ kesi bubu azã kɔ bɔlala kanyiaka. <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />Otsinɔ Hɛbrieyi teli azã ɛkɛlɛ nɛ̀ bɔlɔ, axɔɛdɛ akɔ banɔepopoelete otugbanɔ. Bɔɖɔ bɔlɔ bɔlala tseɖe yɛ, kɛlɛ ebu balɛ esi akɔ bɔlɔ, akɔ anɔ kanyiaka yɛ bɔlalaa kesi bubu. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />Kɛlɛ ebuiɛ aba alɛ mɛ asɛ kana gɛ ebu balɛ kesi akɔ bɔlɔ: bedzini mɛedzu mɛ ɔzãkɔ, kɛlɛ anɔ bhala xɔnɔ bakpɛ yɛasɔ̃."<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />Kliso Faɖawo akpɛ banɔ nɛ Yosef ede, kɛlɛ bebu yɛ amana tsĩɔ ɔlɛ odenɔ ɔɖa buvũɔ mɛ. Gɛ ashɛ yɛɔtɔ̃mɛɛ pɛ etsyina yɛ bakpɛkpɛ ebekeɛ, aba Faɖawo amɛ.<verse eid="GEN 41:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 41:15" />Faɖawo etseɖe Yosɛf asɛ, "Ɛza bɔlala, kɛlɛ ananà agɛ la bɔlɛ kesi ebu. Pɔɔ ilũ baɖɔ nɛ wɔishu asɛ olũ bɔlalaa ɔbɔla bɔlɔ kesi ebu."<verse eid="GEN 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16" />Yosɛf etseɖe Faɖawo asɛ, "ɛtɛ balà bhɛtɛ, pɔɔ Owusoso Akaa abakɔ Faɖawo kesi bubu asɛ kana gɛ apɛ nɔ."<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />Kɛlɛ Faɖawo etseɖe Yosɛf asɛ, "Nɛ mɛ bɔlala mɛɛ, ɛlɔɛtiti nɛ Nail ogbogboɔ, <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />odenɔ kelĩɛ mɛɛ banɛntsyɔɛ tegegene, gɛ beluubɔ́ pɛ ishupiɛ apɛ̃, kɛlɛ batã bɔdɔ̃ nɛ bulĩ tɛwa mɛ. <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />Balɛ kidiɛ, banɛtsyɔɛ tegegene bhlatɔ ekoeyi-bazã kpɛkpɛlɛɛ kɛlɛ begɛiyu bɔnɔ ɛkamɔ̃ banɛtsyɔɛ gɛ begiyì bɔnɔ nɛ Egipte kesiakpaa alɛ petee abhaa. <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />Banɛtsyɔɛ gɛ bedzi kpɛkpɛlɛɛ, pɛ begɛiyu bɔnɔ batã banɛtsyɔɛ tegegene gɛ beluubɔ́ pɛ bekoeyi akpɛ otugbaa. <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />Pɔɔ gɛ batã balɛ bekeɛ tsyɛ, ananà agɛmɔ asɛ batã kɛdɔ nanà; balɛ bɔnɔmayimayi azã asɛ kana gɛ bazã kpɛ otugbaa. Kɛlɛ ɛnyɛmɛ.<verse eid="GEN 41:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 41:22" />"Nɛ mɛ balala mɛɛ ɛmɔ tsyɛ sɛ nikpè atakpu tegegene, gɛ bekoeyi piapii pɛ bapɛ̃, bezeshè nɛ osi tenikpo abha. <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />Nɛ balɛ niedeɛ, atakpu tegegene bhlatɔ epú koeyi-gɛ awalakpa egumũ atɔɖɔ lazhɔlɛ̃ batãpɔɛ nɛ kiwuiotukɔ kɛlɛɛ nɔ ishu. <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />Nikpe atakpu gɛ azhɔlɛ̃ bamɛnɛ atakpuɔ gɛ bapɛ̃ɛ. Ɛɖɔ bɔlɛ tseɖe bakpukpudziɛ, pɔɔ balɛ ɔmayɛmɛ ananà agɛ la bɔlɛ kesi ebu akɔmɛ."<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />Kɛlɛ Yosɛf etseɖe Faɖawo asɛ, "Faɖawo balala benu tenikpo kɛlɛ bashɔ̃. Owusoso Akaa ebu akasɛ Faɖawo kɛgɛ apɛ asɛ tɛ abhɛtɛ. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />Banɛtsyɔɛ gbangbã tegegeneɛ benu agɔ tegegene, kɛlɛ nikpe gbangbã tegegene benu agɔ tegegene; bɔlaláa enu tenikpo kɛlɛ bashɔ̃. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />Banɛtsyɔɛ tegegene kpɛkpɛlɛɛ nɔ gɛ begɛiyu bunɔɔ pɛ bekoeyi kidegbaa benu agɔ tegegene, bashɔ̃ nɛ̀ nikpe atakpuɔ gɛ lazhɔlɛ̃ pɛ latãpɔɛ odenɔ kɛlɛ́ɛ nɔ gɛide kiwuiotukɔ: Benu bɔbhɛ dɔdɔ agɔ tegegene.<verse eid="GEN 41:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 41:28" />"Edzi asɛ kana gɛ itseɖe Faɖawo: Owusoso Akaa ebu akasɛ Faɖawo kɛgɛ apɛ asɛ tɛ abhɛtɛ. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />Agɔ tegegene aaba gɛ bɔŋaŋã gelee bazã Egipte kesiakpa petee mɛ, <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />pɔɔ bɔbhɛ dɔdɔ agɔ tegegene aba kpatɔnɔ alɛ. Kɛlɛ babadzɛkɛ bɔŋaŋã gelee ibe nɛ Egipte, kɛlɛ bɔbhɛ dɔdɔ bazĩ kesiakpa falanɔ. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />Batɛ babaka bɔŋaŋã gelee kibeɛ nɛ kesiakpa nabha, ɔmɔsɛ bɔbhɛ dɔdɔ gɛ bakpà tɔnɔ bɔlɛ aba gagalĩ falanɔ kifu. <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />Kibui nɔnɔ shu sopɛ bakɔ Faɖawo balalaa yɛedi taabha kɛlɛinu ɔsɛ Owusoso Akaa atɔɖɔ ɛlɛ gagãlĩ, kɛlɛ Owusoso Akaa aba bhɛtɛ kɛlɛ odunũ.<verse eid="GEN 41:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33" />"Otsinɔ kɔ Faɖawo apɛ anɔ gɛenu etinɛ pɛ bubuti lɛ yɛahɔɛ tɛ alɔkɔ Egipte kesiakpa akpɛ yɛahɔɛ mɛ. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />Kɔ Faɖawo apɛ bɔdɔ̃abha eɖiɖielete tɛ beɖi kesiakpa nabha tɛ bebu bɔdɔ̃pɔ̃pɔ̃ bɔlɛ teeti mɛ odenɔ Egipteanɛ balɛ bɔdɔ̃pɔpɔ̃ mɛ nɛ agɔ tegegeneɛ gɛ bɔŋaŋã gelee abazãa mɛ. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />Balɔkɔ bɔŋaŋã nɛ agɔ alɛ mɛ gɛ abaa akpɛ kitsu tɛ babalɛ bɔdɔ̃eyi nɛ Faɖawo yɛ ohumi esi nɛ ɛmã gbagblaa mɛ asɛ bɔŋaŋã. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />Bà balɛ bɔŋaŋã alɛ elu akɔ kɛmadiɛ petee, tɛ bawɔa bɔlɛ ishu axɔ̃ɛ nɛ agɔ tegegeneɛ gɛ bɔphɛ dɔdɔ bàba Egipte mɛ, tɛ bɔbhɛ dɔdɔ tɛbazĩ kɛmadiɛ."<verse eid="GEN 41:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />Kibui tɔtɔɖɔ ku Faɖawo nɛ̀ yɛɔzãkɔanɔ petee awɔ̃. <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />Kliso Faɖawo ebisi alɛ asɛ, "Bɔbalá amɔ anɔ asɛ anyɛ alɛ, gɛ Owusoso Akaa ofuafuĩa nɔ ɔkpasɛ yɛ mɛ ana dza?"<verse eid="GEN 41:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 41:39" />Kɛlɛ Faɖawo etseɖe Yosɛf asɛ, "Gɛ Owusoso Akaa ebu ebui alɛ nyɔɔ akasɛ wɔɔ, ananà ama gɛenu etinɛ pɛ bubuti lɛ yɛahɔɛ aasɛ wɔ ana. <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />Oboɖi mɛ bukusi bɔpã nabha, kɛlɛ mɛ anɔnyianɔ abakpɛ kɛtakpuesi akɔ wɔ ɛshaa. Bukusi ɔŋãkɔ yete bɔlɛ bakɔ asɛ ɛɖama dɛ wɔ."<verse eid="GEN 41:40" /></para>
  <para style="s1">Egipte Akpasɛ Yosɛf Ahɔɛ mɛ</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 41:41" />Kliso Faɖawo etseɖe Yosef asɛ, "Ɛlɔkɔ wɔ dzu Egipte kesiakpa petee kpɛ ulũ." <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />Kɛlɛ Faɖawo ebu yɛ kesikpɛ nɔ odenɔ yɛ kɛwɔɛ nɔ kɛlɛ alɔkɔ akpɛ Yosɛf yɛ kɛwɔɛ nɔ. Akpɛ akpɛkpɛ odenɔ kɛpɔtɛ gbangbã mɛ akɔɛ kɛlɛ alɔkɔ sikã kɔwala akpɛ yɛ oliɛ. <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />Akɔ asɛ bekũ yɛ nɛ ɔɖapa ohuɔ mɛ asɛ ɔmã ekusiɛ yɛ abhala ana, kɛlɛ banyɛɛ bakpɛ ozĩ nɛ yɛ otugba asɛ "Nɔkɔ yɛidzo!" Kliso alɔkɔ yɛedzu Egipte kesiakpa petee akpɛ yɛahɔɛ.<verse eid="GEN 41:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="GEN 41:44" />Kɛlɛ Faɖawo etseɖe Yosɛf asɛ, "Mɛinu Faɖawo, pɔɔ ɔgɛɖɔ kibuiɛ, ananà atɛba efeke yɛɔhɔɛ pɛnɔsɛ yɛ ɔtsɛɖɛ nɛ Egipte petee." <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />Faɖawo akɔ Yosɛf kinye asɛ Zafɛnaf-Pania kɛlɛ alɔkɔ Asɛnɛnaf gɛenu Pɔtifɛra, akpukpudzi akɔ Oni yɛeyiadzɛ akɔɛ asɛ edzi yɛedzini. Kɛlɛ Yosɛf agã afala nɛ Egipte kesiakpa petee abha.<verse eid="GEN 41:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 41:46" />Yosɛf aŋã agɔ afɛata pɛ etsoku Faɖawo Egipte ekusiɛ yɛaxɔɛ mɛ. Kɛlɛ Yosɛf ashɛ nɛ Faɖawo ɔbhà pɛ azagã kidzo fala nɛ Egipte. <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />Nɛ bɔŋaŋã gelee agɔ tegegeneɛ mɛɛ, kesiakpa ebu bɔŋaŋã gbĩ. <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />Yosɛf abalɛ bɔŋaŋã petee gɛ bebu nɛ bɔŋaŋã gelee agɔ tegegeneɛ mɛ nɛ Egipte, kɛlɛ abalɛ ɔlɛ nɛ ɛma gbagblaa mɛ. Nɛ ɔma gbagbla akanyiaka mɛɛ, abalɛ́ bɔŋaŋãa gɛebu nɛ bayàa gɛ bakanà ɔlɛ shu. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />Yosɛf abalɛ bɔdɔ̃eyi gelee, aasɛ kelĩ shu ayinsɛ; bɔdɔ̃ɔ kpe kliso ayɔlɔ bɔlɛ tɛkakalà mɛ ɔmɔsɛ bukpe ɔfala nɔ ifu.<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />Kpɛ otugba kɔ bɔbhɛ dɔdɔ agɔɔ, Asenɛnaf gɛenu Pɔtifɛra, akpukpudzi akɔ Oni yɛeyiadzɛ amɔ beeyi tabbha akɔɛ. <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />Yosɛf akɔ yɛeyi ekusiɛ nɛinye asɛ Manase kɛlɛ aɖɔ asɛ, "Owusoso Akaa yɛabhɛtɛ sopɛ ɛdzɛkɛ mɛ bɔtɔ petee gɛ ɛmɔ̃ nɛ mɛaka ɔpãa." <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />Akɔ eyi bhala nɛinye asɛ Efraim kɛlɛ aɖɔ asɛ, "Owusoso Akaa yɛabhɛtɛ sopɛ iyu eyuyũ nɛ mɛ bɔtɔ kesiakpaa nabha."<verse eid="GEN 41:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />Bɔŋaŋã gelee agɔ tegegene nɛ Egipte aba fala, <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />kɛlɛ agɔ tegegene bɔbhɛ dɔdɔ akpɛ kesi, asɛ kana gɛ Yosɛf aɖɔ. Bɔbhɛ dɔ nɛ kesiakpa akanyiaka abha, pɔɔ nɛ Egipte kesiakpa petee abhaa, bɔŋaŋã azã. <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />Gɛ Egipteanɛ nyɔɔ akpà bɔbhɛ dɔdɔ̃ lukũɔ, bebieyo asɛsɛ Faɖawo sɛ akɔ balɛ bɔŋaŋà. Kɛlɛ Faɖawo etseɖe Egipteanɛ petee asɛ, "Nɔvɛ Yosɛf ɔkɔ tɛ nɔbhɛtɛ kɛ gɛ etseɖe wɔnɔ."<verse eid="GEN 41:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 41:56" />Gɛ bɔbhɛ dɔdɔ yɛkɛ kɛmadiɛ petee nɔ, Yosɛf adalɛ iwoleɛ nulũ kɛlɛ adɛ bɔdɔ̃eyi akɔ Egipteanɛ, ɔmɔsɛ bɔbhɛ dɔdɔ nulũ gagãlĩ ɔfalanɔ nɛ Egipte petee. <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />Kɛlɛ kɛmadi kanyiaka abá Egipte tɛ bebedzi bɔdɔ̃eyiɛ odenɔ Yosɛf ɔkɔ, ɔmɔsɛ bɔbhɛ dɔdɔ nulũ gagãlĩ nɛ kanɔnɔ mɛ petee.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s1">Yosɛf Yɛadzyalɛ Bavɛ Egipte</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />Gɛ Yakɔb eti sɛ bɔdɔ̃eyi azã Egipteɛ, etseɖe yɛ beyianyɛ asɛ, "Kiɖeso pɛ nooɖi wɔnɔ baagɔlɔ ana yete?" <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />Avɛ kɛlɛ abha sɛ, "Ilũ sɛ bɔdɔ̃eyi lɛ Egipte. Nɔ ozhi ɔvɛ ɛkɛlɛ tɛ nɔodzi teli ɔmana bɔlɔ, tɛ bɔbazã nɛ ɛ́kpa kɛlɛ bɔtɛbatsi."<verse eid="GEN 42:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 42:3" />Kɛlɛ Yosɛf yɛdzya lɛ lɔfɔɔ bavɛ tɛ bedidzi bɔŋaŋã eyiɛ nɛ Egipte. <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />Pɔɔ Yakɔb agɛ kpɛ Bɛndzamin, Yosɛf yɛadza, ɔplɛnɔ yɛadzya abhlatɔɔ, ɔmɔsɛ esi kifu asɛ kizizĩ baba yɛabha. <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />Kliso Israɛl yɛ beyianyɛ bazã banɔnɔ gɛ bavɛ edi dzi bɔŋaŋã eyiɛ mɛ, ɔmɔsɛ bɔbhɛ dɔ nɛ Kana kesiakpa nabha tsyɛ.<verse eid="GEN 42:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6" />Otsinɔ Yosɛf yɛedzi kɛmadi ekusi akɔ kesiakpa, anɔnɔ gɛ adɛ bɔdɔ̃eyi akɔ kɛmadi mɛ anɛ. Kliso gɛ Yosɛf yɛadalɛ edikuɔ, bezhyi ekumũ akɔɛ gɛ batsɛ́ balɛ bamɛ akpɛ esi. <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />Gɛ Yosɛf amɔ yɛadzalɛɛ koɔ, eti sɛ balɛ, pɔ abhɛtɛ yɛishu aasɛ efu ana kɛlɛ ata kanyã akpɛ balɛ ɔkɔ. Ebisi balɛ asɛ, "Fakɔ nɔode?"</para>
  <para style="p" vid="GEN 42:7">Bebuiliulũ asɛ, "Budè Kana kesiakpa nabha, pɛ bɔbadzi bɔdɔ̃eyi."<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />Yosɛf eti asɛ yɛadzalɛ, pɔɔ balɛ xɔnɔ begitì asɛ yɛ. <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />Kɛlɛ ábaka yɛ balala nɛ balɛ ishu kɛlɛ etseɖe balɛ asɛ, "Bawɔ̃nyɔnɔanɛ nonu! Nɔba sɛ tɛ noboɖi bɔlɔ kesiakpa mɛ ɛkɛlɛ gɛ betie epoɔ."<verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />Bebuiliulũ asɛ, "Oho, mɛ apalete. Wɔ axɔɛdɛ babá sɛ tɛ bebedzi bɔŋaŋã. <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />Bɔlɔ petee anyɛ tenikpo yɛeyianyɛ bunù. Wɔ baxɔɛdɛ enu banɔ gɛ betitsyina kineke, pɛnɔsɛ bawɔ̃nyɔnɔanɛ."<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />Etseɖe balɛ asɛ, "Oho! nɔba sɛ tɛ noboɖi bɔlɔ kesiakpa ɛkɛlɛ gɛ beti epoɔ."<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />Pɔ bebuiliulũ asɛ, "Wɔaxɔdɛ baadza lɔfɔ nɛ̀ taabha, beyianyɛ odenɔ anyɛ tenikpo yɛɔkɔ, gɛ balɛ Kana kesiakpa nabha. Ebhulibhuli nɔ alɛ bɔlɔ akaa yɛɔkɔ otsiɛ, kɛlɛ tenikpo abhama."<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />Yosɛf etseɖe balɛ asɛ, "Kɛlɛ ana asɛ gɛ itseɖe wɔnɔ: Bawɔ̃nyɔnɔanɛ nonu! <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />Kɛlɛ kidzo ɛlɛ nabha bebefeke wɔnɔ eɖi: Gɛ Faɖawo alɛ nɛ ɛkpaa, nɔtɛbɔshɛ nɛ ɛkɛlɛ oɖi ɔdɛkpɛnɔ sɛ wɔnɔ adza bhulii nɔ aba ɛkɛlɛ. <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />Nɔkpɛ wɔnɔ ɔmayɛmɛ tenikpo tɛ adɛ gbana wɔnɔ adza mana; wɔnɔ bagɔgɔ̃ɔ babàkpɛ wɔnɔ buvũ, tɛ befeke wɔnɔ kibuiɖɔɖɔ eɖi asɛ nɔɖɔ kibui gbã dza. Onu pɛ gɛnɛ kanaa, kɛlɛ́ɛ gɛ Faɖawo alɛ nɛ ɛkpaa, bawɔ̃nyɔnɔanɛ nonu!" <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />Kɛlɛ akpɛ balɛ petee buvũ ewui taata.<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />Nɛ kiwui tɛɖamɛ nabhaa, Yosef etseɖe balɛ asɛ, "Nɔ bhɛtɛ anii kɛɛlɛ nɔbɔzã nɛkpã, ɔmɔsɛ isi Owusoso Akaa kifu: <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />Onupɛ nonu banɔ gɛ betitsyina kinekeɛ, nɔkɔ wɔnɔ adza tenikpo azã buvũ nɛ ɛkɛlɛ, gɛ wɔnɔ bagɔgɔ̃ xɔnɔ ɔbɔshɛ pɛ nɔbɔ lɔkɔ bɔdɔ̃ɛbeyi ɔvɛnɔ wɔnɔ bapãa gɛ badɔ ɔbhɛɛ. <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />Pɔ kɛlɛ sɛ nɔgbanà wɔnɔ adza bhuli nɔ ɔmanà mɛ, tɛ bapɔɛ wɔnɔ ebuiɖɔɖɔ shu tɛ nɔtɛ obotsi." Kɛlɛ baavɛ ɛlɛ abha asɛ abhɛtɛ.<verse eid="GEN 42:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 42:21" />Betseɖe bagɔlɔ asɛ, "Kɛgbã baapɔ̃ batɔ̃ akɔ ɔlɔ nɛ bɔlɔ adzaa ishu. Bɔmɔ kana gɛ awɔnyɔnɔ ɔzã yɛmɛɛ gɛ akɔɛtakpu nɔlɔ akɔ yɛkpã, pɔ bɔgɛ dɛmɛ sɛ ilũ; kliso pɛ ɔwɔ̃nyɔnɔ ɔlɛ aba bɔlɔ abha."<verse eid="GEN 42:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22" />Rubɛn ebuiliulũ asɛ, "Ɛgɛitseɖe wɔnɔ asɛ nɔtɛ bhɛtɛ kibui kpa nɛ anyɛnuvɔɛ nɔ shu? Pɔ nɔgɛ dɛmɛ sɛtɛ nɔolũ! Otsiɛ kɛna asɛ tɛ bebisi yɛ dzyosu nɔ odenɔ bɔlɔ ahɔɛ mɛ." <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />Begitì asɛ Yosɛf abalà elũ balɛ baliesi ɔmɔsɛ aza wɔa bulũhũ esi bubu elete ishu axɔɛ.<verse eid="GEN 42:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 42:24" />Etsyina nɛ balɛ ɔbha kɛlɛ ashuahɔɛ yoyo mɛ, pɔ etsyina ba balɛ ɔbha kɛlɛ ewlui aɖɔaɖɔ akpɛ balɔkɔ. Akɔ bebu Simeɔn nɛ balɛ ishi kɛlɛ banyã yɛ nɛ balɛ amɛ.<verse eid="GEN 42:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />Yosɛf akpɛ ɔsha asɛ bakpɛ bɔdɔ̃eyiɛ leyuku balɛ ɛkpɛtɛ mɛ, tɛ balɔkɔ balɛ ɔmayɛmɛ akanyiaka yɛ ehoeyi etsyina akpɛ yɛ ɔkpɛtɛ mɛ akɔɛ, tɛ bakɔ balɛ bɔŋaŋã akɔ balɛ kidzo gagã. Gɛ babhɛtɛ ana akɔ balɛ ebekeɛ, <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />bakpɛ balɛ bɔdɔ̃eyie etuku atɔɖɔ balɛ adiku nabha kɛlɛ bashɛ.<verse eid="GEN 42:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 42:27" />Nɛ ɛkɛlɛ gɛ batsɛ sɛtɛ bazã elishiɛ, balɛ ɔmayɛmɛ tenikpo adalɛ yɛ ɔkpɛtɛ tɛ akɔ yɛ adiku nɔ bɔŋaŋã, kɛlɛ amɔ yɛ ehoeyiɛ nɛ yɛ ɔkpɛtɛ nielũ. <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />Etseɖe yɛadzalɛ asɛ, "Betsyina mɛ ehoeyi akɔ mɛ, ɔmɔ alɛ nɛ mɛ ɔkpɛtɛɛ mɛ."</para>
  <para style="p" vid="GEN 42:28">Balɛ kiteɛ zhyieku balɛ ɛyamɛ kɛlɛ betsyina bamɛ akpɛ baagɔlɔ pɛ beshuku, pɛ baɖɔ asɛ, "Keɖe nɛlɛ gɛ Owusoso Akaa abhɛtɛ nɛ ɔlɔ?"<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />Gɛ bedeku balɛ akaa yɛɔkɔ nɛ Kana kesiakpa nabha, betseɖe yɛ kɛgɛ ɛlɛ ba balɛ abha petee. Baɖɔ asɛ, <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />"Anyɛ gɛ yɛenu apalete nɛ kesiakpa nabha atɛ kanya akpɛ bɔlɔkɔ kɛlɛ abhɛtɛ bɔlɔ asɛ gɛ bɔnyɔ̃awɔ̃ nɛ kesiakpa nabha. <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />Pɔ butseɖe yɛ asɛ, 'Bunu banɔ gɛ bɔtɛ tsaɖakɛ kineke; butinu bɔnyɔ̃awɔ̃nɔanɛ. <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />Badza lɔfɔ nɛ̀ taabha bunu, akaa tenikpo yɛeyianyɛ. Tenikpo abhama, kɛlɛ ebhulibhuli nɔ alɛ bɔlɔ akaa ɔbha nɛ Kana otsiɛ.'<verse eid="GEN 42:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 42:33" />"Kɛlɛ anyɛ gɛ yɛenu apaleteɛ nɛ kesiakpa nabha etseɖe bɔlɔ asɛ, 'Kidzo ɛlɛ nabha mɛba tisɛ nonu baanɔ gɛ batɛ atsaɖakɛ kineke: Nɔshɛ̃ nahɔɛ wɔnɔ adza tenikpo nɛ mɛɔbhà nɛ ɛkɛlɛ, tɛ nɔ lɔkɔ bɔŋaŋã akɔ wɔnɔ bapãa gɛadɔ bɔbhɛ tɛ nɔshɛ. <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />Pɔ nɔgbanà wɔnɔ adza bhuli nɔ manà tɛ mɛiti sɛ notinu awɔnyɔ̃nyɔ̃nɔanɛ pɔɔ banɔ gɛ batɛ tsaɖakɛ kineke. Kɛɛlɛ ɛbatsyina wɔnɔ adza akɔ wɔnɔ, tɛ nɔlà kedzi gã nɛ kesiakpa nabha.' "<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />Gɛ beetsyina bɔdɔ̃eyi ebu nɛ balɛ ɛkpɛtɛ mɛɛ, balɛ ɔmayɛmɛ akanyiaka amɔ̃ yɛ ehoeyiɛ ɔkpɛtɛ mɛ! Gɛ balɛ nɛ̀ balɛ aka amɔ ehoeyi nɛ ɛkpɛtɛɛ mɛɛ, kifu dɛ alɛ. <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />Balɛ akaa Yakob etseɖe balɛ asɛ, "Nɔpɔ̃ mɛeyialɛ tɛɛ nɛ mɛishu. Yosɛf abhama kɛlɛ Simeɔn abhama, kɛlɛ otsiɛ, nɔkɔ pɛ ɔsɛ tɛ nɔlɔkɔ Bɛndzamin. Kɛkanyiaka lɔɛtiti nɛ mɛishu!"<verse eid="GEN 42:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37" />Kɛlɛ Rubɛn etseɖe yɛaka asɛ, "Ɔbɔlà oyi mɛ beyianyɛ taabha gɛ igidzini yɛ mana wɔ. Lɔkɔ yɛ ɔkpɛ mɛahɔɛ mɛ, kɛlɛ ɛ́badzini yɛ mana."<verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />Pɔ Yakɔb aɖɔ asɛ, "Mɛyianyɛ atɛba vɛ ɛkɛlɛ nɛ wɔnɔ; yɛadza etsi kɛlɛ yɛ tenikpo yɛagɔ̃. Onu pɛ kizĩzĩ teli abhɛtɛ yɛ nɛ kidzo ɛlɛ gɛ nɔgã mɛɛ, nobo zhyini mɛ kɛtakpu fufuliɛ akpɛ odzeɖe mɛ nɛ ɔwɔnyɔ̃nɔ mɛ."<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s1">Egipte Kidzogagã Bɔbhalà</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />Otsinɔ bɔbhɛ dɔdɔ wuli ka gagãlĩi nɛ kesiakpa mɛ. <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />Kliso gɛ baŋã bɔdɔ̃ eyiɛ petee gɛ bedzi odenɔ Egipte, balɛ akaa etseɖe alɛ asɛ, "Notsyina ɔvɛ tɛ nodi dzi bɔŋaŋã ɔbɔ aplɛnɔ akɔ ɔlɔ."<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />Pɔ Yuɖa etseɖe yɛasɛ, "Anyɛ akpɛ ɔlɔ ɔsha piapii, 'Nɔzɔ mɔ mɛamɛ odɛkpɛnɔ sɛ wɔnɔ adza aba aplɛnɔ wɔnɔ.' <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />Onupɛ obɔkpɛ bɔlɔ adza tɛ avɛ aplɛnɔ bɔlɔɔ, bɔba zhi vɛ tɛ budzi bɔŋaŋã akɔ wɔ. <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />Pɔ onupɛ ɔtɛ bɔkpɛ yɛ, bɔtɛ bazhi vɛ, ɔmɔsɛ anyɛ etseɖe bɔlɔ asɛ, 'Nɔzɔ mɔ mɛamɛ odɛkpɛnɔ sɛ wɔnɔ adza aba aplɛnɔ wɔnɔ.' "<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />Israɛl ebisi asɛ, "Kiɖeso pɛ ɔmana buluhũ ɛlɛ nɛ mɛabha pɛ notseɖe anyɛ asɛ adza bhlatɔ alɛ wɔnɔ ahɔɛ dza?"<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />Bebuiliulũ asɛ, "Anyɛ ebisi bɔlɔ kibui nɛ bɔlɔ nɛ̀ bɔlɔ kigbogboɔ ishu piapii. Ebisi bɔlɔ asɛ, 'Wɔnɔ akaa akalɛ nɛ ɛkpã dza? Wɔnɔ adza bhlatɔ akaa lɛ dza?' Bubu yɛebui bibisi nulũ yete. Kɛlɛ bɔbalà pɛ bɔbà tisɛ abaɖɔ asɛ, 'Nɔlɔkɔ wɔnɔ adza mana ɛkɛlɛ dza'?"<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />Kɛlɛ Yuɖa etseɖe yɛaka Israɛl asɛ, "Kpɛ anyɛnuvɔɛ nɔ aplɛnɔ mɛ, kɛlɛ bɔbavɛ tsiɔ̃ɔ, tɛ bɔlɔ nɛ wɔ nɛ̀ wɔeyialɛ bɔbazã nɛ ɛkpã tɛ butitsí. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />Ɛbalɔkɔ yɛ tɛzazã piapii nɔ akpɛ mɛishu ahɔɛ mɛ; ɔbɔlà obumɛ kɛpɔ gɛ onupɛ kibui tili bhɛtɛ yɛ. Onupɛ ɛgidzini yɛ mana wɔ piapii pɛ ɛlɔkɔ yɛ badzu wɔ baamɛ, ɛbalɔkɔ kɛpɔ bubuɔ tɔɖɔ mɛishu abha nɛ wɔamɛ nɛ mɛ ɛkpã petee mɛ. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />Kɛlɛ idzi lɛ, onupɛ gɛnɛ kibeɛ butizĩɛ, tsyɛalo bɔtɛ vɛ ba bɔtɛtɛbha."<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />Kɛlɛ balɛ akaa Israɛl etseɖe balɛ asɛ, "Kɛba zã ana, nɔbhɛtɛ kɛɛlɛ: Nɔlɔkɔ bɔdɔ̃ gbangbã dɛ nɛ kesiakpa nabha teli ɔkpɛ wɔnɔ ɛkpɛtɛ mɛ tɛ nɔlɔkɔ ɔvɛnɔ anyɛ asɛ bɔdɔ̃kɔkɔ ana-bɔwɔabɔ huhuuhu, beetsí, kaalĩ nɛ̀ ɔsà baabɔ huhuhu, aɖuɖo beesieyuyu. <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />Nɔlɔkɔ ehoeyi tɛkakalà mɛ edi taabha vunɔ, kɛlɛ sɛ nodzinɔ ehoeyiɛ gɛ balɔkɔ akpɛ wɔnɔ ɛkpɛtɛ nulũ ovɛnɔ. Ogilũ awɔ̃ kesitatá kinu. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />Nɔlɔkɔ wɔadza tsyɛ tɛ notsyina ɔvɛ anyɛ ɔkɔ tsiɔ̃ɔ. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />Kɛlɛ tɛ Owusoso Akaa eɖi wɔnɔ ashagabui nɛ anyɛ namɛ tɛ akɔ wɔadza bhlatɔɔ nɛ̀ Bɛndzamin betsina aba nɛ wɔ. Mɛ xɔnɔ, onupɛ betsiɛɛ, mɛ betsí akɔ."<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />Kliso baanyɛ alɔkɔ bɔdɔ̃kɔkɔ nɛ̀ ehoeyi tɛkakalà mɛ edi taabha nɛ̀ Bɛndzamin tsyɛ. Bebu tɛtsɛɖɛmɛ pɛ bavɛ Egipte kɛlɛ balɔkɔ balɛ ishu akasɛ Yosɛf. <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />Gɛ Yosɛf amɔ Bɛndzamin nɛ̀ balɛɛ, etseɖe agɛ eepo yɛɔpã asɛ, "Lɔkɔ baanyɛ alɛ ɔvɛnɔ mɛ bɔpã mɛ, yi agã tɛ ɔtɔ bɔdɔ̃; tɛ bàŋã bɔdɔ̃ nɛ mɛ kemuze."<verse eid="GEN 43:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 43:17" />Anyɛ abhɛtɛ asɛ kana gɛ Yosɛf etseɖe yɛ kɛlɛ agbana alɛ avɛnɔ Yosɛf yɛ bɔpã mɛ. <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />Otsinɔ kifu yíi baanyɛ gɛ bagbanà alɛ avɛnɔ yɛ bɔpã mɛ. Beɖi asɛ, "Bamana bɔlɔ nɛ ɛkɛlɛ nɛ ehoeyiɛ gɛ bedzinɔ akpɛ bɔlɔ ɛkpɛtɛ mɛ shu nɛ kibeɛ gɛ buputɔ baa. Apɛ asɛ tɛ alɔadɔ bɔlɔ abha tɛ amɔ ohumi nɛ bɔlɔ abha tɛ evũ bɔlɔ asɛ banɔdzidzi tɛ ayɛkɛ bɔlɔ badikuɔ."<verse eid="GEN 43:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 43:19" />Kliso bavɛ agɛ yɛepo Yosɛf yɛɔpã mɛ kɛlɛ baɖɔaɖɔ nɛ yɛ nɛ bɔpã niedulũɔ. <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />Baɖɔ asɛ, "Bɔkɔ wɔɛtakpu, apalete, bɔtɛ ba ɛkɛlɛ akpɛ otugba pɛ bɔbadzi bɔŋaŋã. <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />Pɔ nɛ ɛkɛlɛɛ gɛ bɔtsɛ sɛtɛ za elishiɛ, bɔdãlɛ bɔlɔ ɛkpɛtɛ kɛlɛ anɔnyianɔ amɔ yɛ ehoeyi gɛ abuia-nɛ alɛ bupu mɛ ana-anɔyianɔ ɔkpɛtɛ nulũ. Kliso budzinì alɛ manà. <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />Bɔzɛ lɔkɔ ehoeyi tsyɛ plɛnɔ manà tɛ bɔbadzi bɔŋaŋã. Butinyi anunɔ gɛ yɛalɔkɔ ehoeyiɛ akpɛ bɔlɔ ɛkpɛtɛ mɛ."<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />Aɖɔ asɛ, "Abɔ ana. Notisi kifu. Wɔnɔ Owusoso Akaa, wɔnɔ akaa yɛ Owusoso akaa akɔnɔ kidziyɛyɛkɛ bɔdɔ̃ nɛ wɔnɔ ɛkpɛtɛɛ mɛ; Ɛyɛkɛ wɔnɔ ehoeyiɛ." Kɛɛlɛ ebu Simeɔn eyinɔ amana balɛ ɔbha.<verse eid="GEN 43:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24" />Agɛ epo bɔpã agbana balɛ avɛnɔ Yosɛf yɛ bɔpã mɛ, akɔ balɛ bulĩ tɛ bepulu balɛ bɔtsɛɖɛkpɔ kɛlɛ ebhuĩ tɛwa akɔ balɛ adikuɔ. <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />Babalɛ̀ bɔdɔ̃kɔkɔ pɛ bezepo Yosɛf yɛ tɛbaba nɛ kemuze, ɔmɔsɛ belũ asɛ babaŋã bɔdɔ̃ nɛ ɛkɛlɛ.<verse eid="GEN 43:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 43:26" />Gɛ Yosɛf aba bɔpã mɛ, balɔkɔ bɔdɔ̃kɔkɔ gɛ bamana bɔpã akpɛ yɛahɔɛ mɛ, kɛlɛ bezhyi ekumũ akɔɛ nɛ kesiakpa. <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />Ebisi balɛ tɛzãzã mɛ, kɛlɛ aɖɔ asɛ, "Kɛlɛ wɔnɔ aka sheshe gɛ yɛibui notseɖe mɛ alɛ? Aka alɛ nɛ ɛkpã dza?"<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />Bebuiliulũ asɛ, "Wɔ axɔɛdɛ bɔlɔ akaa aka alɛ nɛ ɛkpã kɛlɛ alɛ piapii." Kɛlɛ bezhyikumũ akɔ yɛ asɛ kitití kpɛkpɛ ana akɔɛ.<verse eid="GEN 43:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29" />Gɛ ebhui awɔ̃ afala nɔ pɛ amɔ yɛadzya Bɛndzamin, yɛelĩeyi anyɛ, ebisi asɛ, "Wɔnɔ adza bhuli nɔ naalɛ, agɛ yɛishuibui nɔɖɔ otseɖe mɛɛ?" Kɛlɛ aɖɔ asɛ, "Owusoso Akaa ebhui wɔebú, mɛeyianyɛ." <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />Yɛishumɛ hɔà gɛ amɔ̃ yɛadzaa, ebu tɛtsɛtsɛɖɛ mɛ ekoeyi adɛpɛ ɔkɔ teli tɛ ebieyò. Avɛ yɛ buvũɔ mɛ pɛ ede bieyo nɛ ɛkɛlɛ.<verse eid="GEN 43:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 43:31" />Gɛ epulu baamɛ ebekeɛ, ekoeyi aba, nɛ ishu nyanyanã mɛ, aɖɔ asɛ, "Noshi bɔŋaŋãa."<verse eid="GEN 43:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 43:32" />Bakpɛ yɛɔyɛ ɔtɔ, yɛadzalɛ yɛɔyɛ ɔtɔ, kɛlɛ Egipteanɛ teli gɛ baŋã bɔdɔ̃ nɛ yɛɔyɛ ɔtɔ, ɔmɔsɛ Egipteanɛ batɛbala bɔdɔ̃ ŋã nɛ̀ Hebrianɛ, gɛenu ogũ kɔ Egipteanɛ. <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />Banyɛ azã kesi nɛ balɛ tisheshe ulũ, odenɔ eyì kusiɛ nabha ɔdɛkpɛnɔ anuvɔɔ nabha; kɛlɛ bezeɖi baagɔlɔ kibì teli idi. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />Gɛ bakpɛ bɔŋaŋã odenɔ Yosɛf yɛɔkpɔlɔ̃ nabha, Bɛndzamin yɛɔdɔ̃ kpè edì teeti ɔdɛ anɔnyianɔ ɔyɛ. Kliso baŋã pɛ batã nɛ kifù masimasi mɛ nɛ yɛ.<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s1">Yosɛf Efeke Yɛadzalɛ Eɖi</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />Otsinɔ Yosɛf akɔ agɛ yɛepo yɛɔpã ɔsha asɛ, "Kpɛ bɔŋaŋã buyukù baanyɛ ɛkpɛtɛɛ as kana gɛ babala etuku, tɛ ɔlɔkɔ balɛ anɔkanyiaka yɛ ehoeyi akpɛ yɛɔkpɛtɛ nulũ. <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />Kɛlɛ́ɛ lɔkɔ mɛ sikãfufù kayintse nɔ ɔkpɛ ebhulibhuli nɔ yɛ ɔkpɛtɛ nulũ, ɔplɛnɔ yɛehoeyiɛ gɛ abuià akɔ bɔdɔ̃eyiɛ." Kɛlɛ abhɛtɛ asɛ kana gɛ Yosɛf aɖɔ.<verse eid="GEN 44:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 44:3" />Gɛ keliɛ mapɔ̃ɔ, bakpɛ baanyɛ nɛidzo nɛ̀ balɛ adikuɔ. <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />Begiku odzlolo ɔkɔ odenɔ ɔma gbagbla mɛ flogo pɛ Yosɛf etseɖe agɛ yɛepo yɛɔpã asɛ, "Kpatɔnɔ baanyɛ odunũ ɔlɛ, kɛlɛ onupɛ ɔtɔnɔ balɛ, tseɖe balɛ asɛ, 'Kiɖeso pɛ nɔlɔkɔ kibui kpa buia kɛbhɛ̃ akɔ kɛgbangbã dza? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />Gɛnɛ mɛ apaleteɛ yɛ kayintse nɔ gɛ aawuɛ̃ bulĩɛ nɔ pɛ alɔkɔ ebisi bɔdɔ̃ nɔ naalɛ? Kɛtakpumɛ gagãlĩ kibui nɛlɛ nɔbhɛtɛ.' "<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />Gɛ atɔnɔ alɛɛ, edzinì kibuiɛ gɛ etseɖe yɛɛ etseɖe alɛ. <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />Pɔ betseɖe yɛasɛ, "Kliso pɛ bɔlɔ apalete abaɖɔ ebui kidi? Kitso ɔvɛ nɛ wɔ baxɔɛdɛ ɔbhà sɛtɛ babhɛtɛ kibui teli ana! <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />Budzinì ehoeyi gɛ bɔmɔ nɛ bɔlɔ ɛkpɛtɛ nulũ tsyɛ manà wɔ odenɔ Kana kesiakpa. Kliso kiɖeso pɛ bɔba zuɖu sikãfufú pɛnɔsɛ sikãdzadzã odenɔ wɔ apalete bɔpã mɛ dza? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />Onupɛ bɔmɔɛ nɛ wɔaxɔɛdɛɛ teli ɔkɔɔ, ebetsí; kɛlɛ bɔlɔ agɔagɔ̃ɔ ebedzì bɔlɔ apalete yɛanɔdzidzi."<verse eid="GEN 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10" />Aɖɔ asɛ, "Apɛ ana, otsiɛ, kɛzã asɛ kana gɛ ɔɖɔ. Anɔnyianɔ ahɔɛ gɛ bɔmɔɛɛ bedzi mɛanɔ dzidzi; wɔnɔ baagɔgɔ̃ɔ balà shɛ̃ nɛ kɛpɔmabumabu mɛ."<verse eid="GEN 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 44:11" />Akanyiaka ezhyini yɛ ɔkpɛtɛ kesi pɛ adãlɛ ɔlɛ. <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />Kɛlɛ bɔpã epopoelete avɛ kɛlɛ abha tɛ apɛ bɔdɔ̃, odenɔ ebhulibhuli naabha odɛkpɛnɔ esheshe naabha. Kɛlɛ amɔ kayintse nɔ nɛ Bɛndzamin yɛ ɔkpɛtɛ mɛ. <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />Gɛ kɛba kɛlɛmɛ ana, batsyɔɛ balɛ akpɛkpɛ. Kɛlɛ balɛ nyɔɔ anya balɛ etukuɔ atɔɖɔ balɛ adiku nabha kɛlɛ betsyina avɛ ɔma gbagbla mɛ.<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />Yosɛf ewlui azã bɔpã mɛ flogo pɛ Yuɖa nɛ yɛadzya alɛɛ ebeku, kɛlɛ bedzyi ekumu kesi akɔɛ. <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />Yosɛf etseɖe balɛ asɛ, "Keɖe nɛlɛ gɛ nɔbhɛtɛ? Notinyi ɔsɛ anyɛ asɛ mɛ ana ɛɛmɔ bɔdɔ̃ nɛ bɔdɔ̃ bibisi mɛ?"<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />Yuɖa ebuiliulũ asɛ, "Keɖe bɔbala aɖɔ mɛ apalete? Kɛ́lɛ bɔbala kasɛ bɔlɔ ishubhuibhui? Owusoso Akaa efeke bɔdɔ̃ nɛ wɔ axɔɛdɛ balɛ kɛpɔbubu abha. Otsiɛ budzi mɛ apalete banɔdzidzi-bɔlɔ nɛ anɔnɔ gɛ yɛahɔɛ bamɔ kayintse nɔ."<verse eid="GEN 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17" />Pɔ Yosɛf aɖɔ asɛ, "Kitso vɛ nɛ mɛishu sɛ ɛba bhɛtɛ kibui ɛlɛ nɛidi! Anɔnɔ gɛ yɛahɔɛ bamɔ kayintse nɔ yete yɛebedzi mɛ anɔdzidzi. Wɔnɔ bagɔgɔ̃ɔ xɔnɔ, notsyina vɛ wɔnɔ akaa yɛɔkɔ nɛ ishu yɔyɔ mɛ.<verse eid="GEN 44:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />Kɛlɛ Yuɖa etso avɛ yɛɔbha kɛlɛ aɖɔ asɛ: "Ɛkɔ wɔɛtakpu, mɛ apalete, kɔ wɔ axɔɛdɛ aɖɔ kibui tinikpo mɛ apalete. Tɛkpɛ ɔmɔpɔɛ nɛ wɔ axɔɛdɛ ishu, kɔ wɔaxɔɛdɛ aɖɔ kibui tenikpo akɔ mɛ apalete, gɛ wɔ nɛ Faɖawo nɔshɔ̃. <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />Mɛ apalete ebisi yɛaxɔɛdɛ asɛ, 'Aka pɛnɔsɛ adza alɛ wɔnɔ ahɔɛ dza?' <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />Kɛlɛ bubuiliulũ asɛ, 'Aka gɛenu anɔsheshe alɛ bɔlɔ ahɔɛ, kɛlɛ anyɛanuvɔ gɛ bamɔ akɔ yɛ nɛ yɛ tisheshe mɛ tsyɛ alɛ. Yɛadzya etsí, kɛlɛ yɛete yɛenu yɛelĩeyiɛ anyɛ gɛ atɔ, kɛlɛ yɛaka dɛmɛ yɛibui.'<verse eid="GEN 44:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 44:21" />"Kɛlɛ wɔɖɔ tseɖe wɔaxɔɛdɛ asɛ, 'Nozhyini yɛ ɔmana tɛ mɛ mɔ yɛakɔ mɛishu.' <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />Kɛlɛ butseɖe mɛ apalete asɛ, anyɛnuvɔɛ nɔ atɛ balà ashɛ nɛ yɛaka ɔbhà, ɔmɔ ashɛ̃ nɛ yɛɔbhaa, yɛaka obetsi.' <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />Pɔɔ otseɖe wɔ axɔɛdɛ asɛ, 'Odɛkpɛnɔ gɛ wɔnɔ adzya bhuli nɔ ezhyi aba nɛ bɔlɔɔ, bɔzɛba mɔ wɔamɛ ɖi.' <verse eid="GEN 44:23" /><verse number="24" style="v" sid="GEN 44:24" />Gɛ butsyina vɛ wɔ axɔɛdɛ bɔlɔ aka yɛɔkɔ, butseɖee kɛgɛ mɛ apaleteɛ aɖɔ.<verse eid="GEN 44:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 44:25" />"Kɛlɛ bɔlɔ aka aɖɔ asɛ, 'Notsyina vɛ tɛ nodeodzi bɔŋaŋã teli mana.' <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />Pɔ bɔɖɔ asɛ, 'Bɔtɛ bala zhi ɔvɛ. Onupɛ bɔlɔ adzya bhuli nɔ aplɛnɔ bɔlɔ kɛlɛ bɔbavɛ. Bɔtɛ bala mɔ anyɛ nɔ baamɛ odɛkpɛnɔ sɛ bɔ gbana bɔlɔ adzya bhuli nɔ aplɛnɔ bɔlɔ.'<verse eid="GEN 44:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 44:27" />"Wɔaxɔɛdɛ mɛaka etseɖe bɔlɔ asɛ, 'Nonyi sɛ mɛedzini amɔ beyianyɛ taabha akɔ mɛ. <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />Tenikpo ashɛ̃ nɛ mɛɔbha, kɛlɛ mɛɖɔsɛ, "Batsyɔɛ yɛakpɛ bɔpɛ̃ mɛ kɛgbã." Kɛlɛ ɛkaa mɔ yɛ oɖi. <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />Ɔgbana yɛalɛ tsyɛ ɔshɛ̃ nɔ pɛ kɛdɔ̃ zĩzĩ bhɛtɛ yɛ, nobo zhyini mɛ kɛtakpu fufuliɛ akpɛ odzeɖe mɛ nɛ ɔwɔ̃nyɔnɔ mɛ.'<verse eid="GEN 44:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30" />"Kliso otsiɛ nɔ, onupɛ anyɛnuvɔɛ nɔ agɛ plɛnɔ bɔlɔ pɛ itsyina vɛ wɔaxɔɛdɛ mɛ aka yɛɔkɔ, kɛlɛ onu mɛakpã gɛ yɛkpã bhɛtɛ tenikpo nɛ anyɛnuvɔɛ nɛkpã, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />amɔ asɛ anyɛnuvɔɛ nɔ ama ɛkɛlɛ́ɛ, ebetsí. Wɔ axɔɛdɛ ebe zhyinɔ bɔlɔ aka yɛ kɛtakpu fufuliɛ akpɛ odzeɖe mɛ nɛ ɔwɔ̃nyɔnɔ mɛ. <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />Wɔ axɔɛdɛ yɛalɔkɔ anyɛnuvɔɛ nɔ yɛ ɛ́kpã akpɛ ishuahɔɛ mɛ akɔ mɛaka. Ɛɖɔ sɛ, 'Mɛaka onupɛ ɛgidzini yɛ mana wɔ, ɛbayɛkɛ kɛpɔɔ tɔɖɔ mɛishu abha, nɛ mɛ ɛ́kpã mɛ petee!'<verse eid="GEN 44:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 44:33" />"Otsinɔ, ɛ́kɔ wɔɛtakpu kɔ wɔ axɔɛdɛ azã ɛkɛlɛ asɛ mɛ apalete yɛanɔ dzidzi nɛ anyɛnuvɔɛ nɔ kinye mɛ, tɛ ɔkɔ anyɛnuvɔɛ etsyina avɛ nɛ yɛadzalɛ. <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />Kɛ́lɛ́ batsyina vɛ mɛ aka yɛɔkɔ gɛ anyɛnuvɔɛ nɔ ama mɛɔbha? Oho! Tɛkɔ mɛmɔ ɔwɔnyɔnɔɔ gɛ lɔbɔba mɛaka abha."<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s1">Yosɛf Ebu Yɛishu Akasɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />Kɛlɛ Yosɛf agalà yɛishu anyanà evunũ nɛ bagɛ eepo yɛ nyɔɔ namɛ, kɛlɛ ebieyoyò, "Kɔ anɔnyianɔ ashɛ̃ nɛ mɛɔbha!" Kliso ananà agɛzã Yosɛf ɔbhà gɛebu yɛishu akasɛ yɛadzalɛ. <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />Kɛlɛ ebieyò nyagãa akɔ asɛ Egipteanɛ belũ yɛɔdɔ̃, kɛlɛ Faɖawo bɔpã belũiɛlɛ ɔdɔ̃.<verse eid="GEN 45:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 45:3" />Yosɛf etseɖe yɛadzalɛ asɛ, "Mɛinu Yosɛf! Mɛ akaa kalɛ nɛ ɛkpã dza?" Pɔ yɛadzalɛ bagɛ là ebuiliulũ akɔɛ, ɔmɔsɛ kifu dɛ balɛ nɛ yɛamɛ.<verse eid="GEN 45:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 45:4" />Kɛlɛ Yosɛf etseɖe yɛadzalɛ asɛ "Notsoba mɛɔba." Gɛ babhɛtɛ ana bekeɛ, aɖɔ asɛ "Mɛinu wɔnɔ adza Yosɛf, agɛ nɔdɛ ɔkpɛ Egipteɛ! <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />Kɛlɛ otsiɛ nɔ, nɔtɛ kɔ ɔwɔnyɔ̃nɔ aba wɔnɔ abha kɛlɛ ɔmɔpɔɛ otiyì wɔnɔ ishu sɛ nɔdɛ mɛ akpɛ ɛkɛlɛ̀, ɔmɔsɛ tɛ mɛibu ɛkpã kliso pɛ Owusoso Akaa asɛsɛ mɛ akpɛ otugba. <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />Agɔ taabha nyɔɔ naalɛ gɛ bɔbhɛ̃ dɔ nɛ kesiakpa nabha, kɛlɛ agɔ teetiɛ gɛ alɛ otugbaa bɔdɔ̃wɔawɔa nɛ bɔdɔpɔ̃pɔ̃ tɛ bazã. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />Pɔ Owusoso Akaa asɛsɛ mɛ akpɛ wɔnɔ otugba asɛ tɛ ɛbalɛ akɔ wɔnɔ asɛ banɔ gɛ bagɔ̃ nɛ kesiakpa nabha kɛlɛ tɛ mɛibu wɔnɔ ɛ́kpã nɛ tibubu gbagbla mɛ.<verse eid="GEN 45:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 45:8" />"Klisoɔ, gɛinu wɔnɔ sɛsɛ mɛ nɛ ɛkɛlɛ, pɔ Owusoso Akaa. Yɛ abhɛtɛ mɛ akaa akɔ Faɖawo, apalete akɔ yɔɔpã petee nɛ̀ ekusi akɔ Egipte nyɔ̃ɔ. <verse eid="GEN 45:8" /><verse number="9" style="v" sid="GEN 45:9" />Otsinɔ wɔnɔ nobu tsɛtsɛɖɛ mɛ tɛ notsyina vɛ mɛ akaa ɔbha tɛ notseɖe yɛ asɛ, 'Kibui ɛlɛ woeyianyɛ Yosɛf aaɖɔ: Owusoso Akaa abhɛtɛ mɛ apalete nɛ Egipte petee abha. Zhyi ɔba mɛɔbha; tɛwɔ kide. <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />Nɔ bɔzã Goshɛn yɛ kɛkɔtɔmɛ tɛ notso ɔplɛnɔ mɛ-wɔnɔ, wɔnɔ beyialɛ nɛ̀ wɔnɔ beshuialɛ, wɔnɔ baagã azaa nɛ̀ banɛntsyɔɛ nɛ̀ wɔnɔ ahɔɛ mɛ bɔdɔ̃ petee. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />Ɛba ɖi wɔnɔ abha nɛ ɛkɛlɛ́, ɔmɔsɛ bɔbhɛ̃ agɔ teeti alɛ otugba abá. Onu gɛnɛ anaa, wɔnɔ nɛ̀ wɔnɔ bɔpã nɛ̀ banɔ kanyiaka gɛenu wɔnɔ ayɛ abadɔ kitsyuì.'<verse eid="GEN 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12" />"Nɔbɔ mɔkɔ wɔnɔ ishu, kana mɛadza Bndzamin tsyɛ, asɛ mɛ ɛɖɔaɖɔ akɔ wɔnɔ kɛgbã. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />Notseɖe mɛaka nɛ kanà gɛ bakpɛ mɛ nɛititì nɛ Egipte nɛ̀ kɛkanyiaka gɛ nɔ̀mɔ. Kɛlɛ nɔgbanà yɛ ozhyinɔ ɛkɛlɛ odunũ."<verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />Kɛlɛ atahɔɛ akpɛ yɛadza Bɛndzamin shu kɛlɛ ebieyò, kɛlɛ Bendzamin anyanã yɛakpɛ kitẽ mɛ, kɛlɛ ebi yoyo. <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />Kɛlɛ akpɛ ahɔɛ nɛ yɛadzalɛ petee iliɛ pɛ ebieyò atɔɖɔ balɛ abha. Kidegbaa, yeadzalɛ aɖɔaɖɔ nɛ yɛ.<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />Gɛ kibuiɛ diyi nɛ Faɖawo yɛ bukusi bɔpã mɛ asɛ Yosɛf yeadzalɛ abaa, kiku Faɖawo nɛ yɛɔzãkɔanɛ awɔ̃. <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />Faɖawo etseɖe Yosɛf asɛ, "Tseɖe wɔadzalɛ asɛ, 'Bhɛtɛ kɛɛlɛ: Nɔkpɛ etukù akɔ wɔnɔ baagã tɛ notsyina ɔvɛ Kana kesiakpa nabha, <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />tɛ nɔlɔkɔ wɔnɔ akaa nɛ̀ wɔnɔ baapã tsyina mana mɛ. Ɛbakɔ wɔnɔ Egipte kesiakpa kalɛ ɔgbangbã kɔ kɛlɛ nɔbɔ ŋã kesiakpa kalɛ bɔbɔ ɔkɔ.'<verse eid="GEN 45:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 45:19" />"Ɛkpɛ ɔsha tsyɛ sɛ tɛ otseɖe balɛ asɛ, 'Bhɛtɛ kɛɛlɛ: Nɔlɔkɔ ihuɔ gɛ baagã eeteɛ odenɔ Egipte akɔ wɔnɔ beyialɛ nɛ wɔnɔ edzinialɛ, tɛ nɔgbanà wɔnɔ akaa tɛ nɔba. <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />Notì lu awɔ̃ nɛ wɔnɔ bahɔɛmɛ bɔdɔ̃ɔ nabha, ɔmɔsɛ bɔdɔ̃ gbangbã dɛ nɛ Egipte peteeɛ ebedzi wɔnɔ ayɛ.' "<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />Kliso Israɛl yɛeyianyɛ abhɛtɛ ana. Yosɛf akɔ balɛ ihuɔ gɛ baagã beeteɛ, asɛ kana gɛ Faɖawo akɔ yɛɔsha, kɛlɛ akɔ balɛ bɔdɔ̃ ŋãŋã tsyɛ akɔ balɛ kidzo gagã. <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />Akɔ balɛ ɔmayɛmɛ akanyiaka akpɛkpɛ vɔvɔ, pɔ Bɛndzamin xɔnɔ alɔkɔ ehoeyi akpã taata nɛ̀ akpɛkpɛ vɔvɔ edi teeti akɔ yɛ. <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />Kɛlɛ bɔdɔ̃ ɔlɛ yɛasɛsɛ yɛaka: akpɛ etuku akɔ badiku lɔfɔ nɛ̀ Egipte bɔdɔ̃ gbangbã, kɛlɛ bakpɛ etuku akɔ badikudzɛ lɔfɔ nɛ̀ bɔdɔ̃ɛeyi nɛ̀ abolo nɛ bɔdɔ̃ŋãŋã bhlatɔ akɔɖɔ akɔ yɛidzoɔ tɛgagã. <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />Kɛlɛ akpɛ yɛadzalɛ kidzo, kɛlɛ gɛ baa shɛ̃ɛ, etseɖe balɛ asɛ, "Nɔtɛ pɛ ebela nɛ kidzoɔ mɛ!"<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />Kliso bewù avɛ Egipte kɛlɛ bediku balɛ akaa ɔkɔ nɛ Kana kesiakpa nabha. <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />Betseɖe yɛasɛ, "Yosɛf akalɛ nɛkpã! Kibui gbã, yɛaŋã bukusi nɛ Egipte petee abha." Kibuiɛ yalɛ Yakɔb nyagãa; agɛ yɛkɛ balɛ abha ŋã. <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />Pɔ gɛ betseɖe ebuiɛ nyɔɔ gɛ Yosɛf etseɖe balɛ, kɛlɛ gɛ amɔ ihuɔ gɛ baagã beeteɛ gɛ Yosɛf asɛsɛ sɛ tɛ betuku yɛamanà, balɛ aka yɛ ɔfɔfuia nɔ otsodzi mɔ ɛkpã. <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />Kɛlɛ Israɛl aɖɔ asɛ, "Ɛmɔsɛ kɛgbã! Mɛeyianyɛ Yosɛf aka lɛ nɛkpã. Ɛbavɛ dɛ mɔɛ flogo tɛ itsí."<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s1">Yakɔb Avɛ Egipte</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />Kliso Israɛl alɔ atɔnɔ kidzo nɛ̀ kɛkanyiaka gɛ kɛlɛ yɛahɔɛ, kɛlɛ gɛ ediku Biɛshɛba, apɔɛ bɔdɔ̃ akɔ yɛaka Isak yɛ Owusoso Akaa.<verse eid="GEN 46:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 46:2" />Kɛlɛ Owusoso Akaa aɖɔaɖɔ akɔ Israɛl nɛ bɔlalá mɛ nɛ elishi asɛ, "Yakɔb! Yakɔb!</para>
  <para style="p" vid="GEN 46:2">"Ebuiliulũ asɛ, "Mɛ naalɛ."<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />Aɖɔ asɛ, "Mɛinu Owusoso Akaa, Owusoso Akaa akɔ wɔaka. Kifu tiyì wɔ tɛ ozhyi ɔvɛ Egipte, ɔmɔsɛ ɛbabhɛtɛ wɔ kɛmadi gbagbla nɛ ɛkɛlɛ. <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />Ɛba vɛ Egipte nɛ wɔ, kɛlɛ ɛba dzini wɔ mana. Kɛlɛ Yosɛf yɛahɔɛ yɛabadã wɔ aŋuhu."<verse eid="GEN 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5" />Kɛlɛ Yakɔb ashɛ nɛ Biɛshɛba, kɛlɛ Israɛl yɛeyianyɛ alɛ bagbanà balɛ akaa Yakɔb nɛ̀ balɛ eyialɛ nɛ̀ balɛ edzini alɛ akpɛ ihuɔ gɛ baagã eeteɛ gɛ Faɖawo asɛsɛ asɛ tɛ betuku yɛ. <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />Balɔkɔ balɛ kepi baagã nɛ̀ bɔdɔ̃ gɛ bamɔ nɛ Kana tsyɛ, kɛlɛ Yakɔb nɛ̀ yɛ hihui nɔ petee bavɛ Egipte. <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />Alɔkɔ aplɛnɔ yɛɔmɔɔ avɛ Egipte nɛ̀ yɛeyianyɛ alɛ, yɛ beshui nɔ nɛ̀ yɛeyiadzɛ alɛ nɛ̀ yɛeshui badɛnuvɔɛ-yɛ kihui nɔ petee.<verse eid="GEN 46:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />Banɔ alɛ enyeɛ alɛ enu Israɛl yɛeyialɛ (Yakɔb nɛ̀ yɛ bɔmɔɔ) gɛ bavɛ Egipte.:</para>
  <para style="b" vid="GEN 46:8" />
  <para style="li1" vid="GEN 46:8">Rubɛn eyi kusi akɔ Yakɔb.<verse eid="GEN 46:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="GEN 46:9" />Rubɛn yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 46:9">Hanɔk, Palu, Hɛzrɔn nɛ̀ Karmi.<verse eid="GEN 46:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="GEN 46:10" />Simeɔn yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 46:10">Yemuɛl, Yamin, Ohaɖ,, Yakin, Zoha, nɛ̀ Shɔl Kanadzi yɛeyianyɛ.<verse eid="GEN 46:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="GEN 46:11" />Levi yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 46:11">Gɛsɔn, Kohat nɛ̀ Mɛrari.<verse eid="GEN 46:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="GEN 46:12" />Yuɖa yɛ bɛeyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 46:12">Er, Onan, Shila, Pɛrɛz, nɛ̀ Zɛra (pɔ Er nɛ̀ Onan betsí nɛ Kana kesiakpa mɛ).</para>
  <para style="li2" vid="GEN 46:12">Pɛrɛz yɛ beyianyɛ naalɛ:</para>
  <para style="li3" vid="GEN 46:12">Hɛzrɔn nɛ̀ Hamul.<verse eid="GEN 46:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 46:13" />Isaka yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 46:13">Tolà, Puah, Yashuɖ nɛ̀ Shimrɔn.<verse eid="GEN 46:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 46:14" />Zebulɔn yɛ beyianyɛ naallɛ:</para>
  <para style="li2" vid="GEN 46:14">Sɛrɛɖ,, Elɔn nɛ̀ Yaaliil.<verse eid="GEN 46:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 46:15" />Banɔ alɛ balɛenu beyianyɛ gɛ Leya amɔ́ akɔ Yakɔb nɛ Paɖan Aram ɔplɛnɔ yɛeyidzɛ Ɖina. Yɛ beyianyɛ alɛ nɛ̀ beyiadzɛ alɛ petee tɛkakalà mɛ lɛ afɛata nɛ̀ taata.<verse eid="GEN 46:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="GEN 46:16" />Gad yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 46:16">Zɛfɔn, Hagi, Shuni, Ɛzbɔn, Ɛri, Aroɖi nɛ̀ Areli.<verse eid="GEN 46:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="GEN 46:17" />Asha yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 46:17">Imna, Ishva, Ishvi nɛ̀ Bɛria.</para>
  <para style="li2" vid="GEN 46:17">Balɛ ada yɛedzì Sɛra</para>
  <para style="li2" vid="GEN 46:17">Bɛɖia yɛ bɛeyianyɛ naalɛ:</para>
  <para style="li3" vid="GEN 46:17">Hɛba nɛ̀ Malkia.<verse eid="GEN 46:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 46:18" />Bunuvɔɛ alɛ Zilpa amɔ́ akɔ Yakɔb, gɛ Laban alɔkɔ akɔ yɛeyiadzɛ Leya-kɛfɔ nɛ̀ teehlo nɛ tɛkakalà mɛ petee.<verse eid="GEN 46:18" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="19" style="v" sid="GEN 46:19" />Yakɔb yɛedzini Ratsɛl yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 46:19">Yosɛf nɛ̀ Bɛndzamin. <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />Nɛ Egipteɛ Asɛnaf gɛenu Potifɛra On yɛakpukpudzi yɛeyiadzɛɛ amɔ́ Manase nɛ̀ Efraim akɔ Yosɛf.<verse eid="GEN 46:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="GEN 46:21" />Bɛndzamin yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 46:21">Bɛla, Bɛka, Ashbɛl, Gɛɖa, Neeman, Ɛhi, Rosh, Mupin, Hupin nɛ̀ Aaɖ.<verse eid="GEN 46:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 46:22" />Beyiɛanyɛ gɛ Ratsɛl amɔ́ akɔ Yakɔb naalɛ-kɛfɔ nɛ̀ taalɛ nɛ tɛkakalà mɛ petee.<verse eid="GEN 46:22" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="23" style="v" sid="GEN 46:23" />Ɖan yɛeyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 46:23">Hushin.<verse eid="GEN 46:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 46:24" />Naftali yɛ beyianyɛ naalɛ:</para>
  <para style="li2" vid="GEN 46:24">Yaziɛl, Guni, Yɛza, Shilɛm.<verse eid="GEN 46:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 46:25" />Beyianyɛ alɛ balɛenu Bilxa, gɛ Laban alɔkɔ akɔ yɛeyiadzɛ Ratsɛl pɛ amɔ́ akɔ Yakɔb-tegegene nɛ tɛkakalà mɛ petee.<verse eid="GEN 46:25" /></para>
  <para style="b" />
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />Bagɛ avɛ Egipte nɛ̀ Yakɔb petee-bagɛ enu yɛ bɔmɔ́ɔ gɛ onu bagɛ kalà yɛeyiridze alɛ-balɛ tɛkakalà mɛ lɛ banɔ afeteehlo nɛ̀ teehlo. <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />Odenɔ beyianyɛ taabha gɛ bamɔ́ akɔ Yosɛf nɛ Egipteɛ, Yakɔb yɛeshopo alɛ, gɛ bavɛ Egipte, balɛ tɛkakalà mɛ petee lɛ afɛtegegene.<verse eid="GEN 46:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />Otsi Yakɔb akpɛ Yuɖa nɛ Yosɛf ɔkɔ akpɛ otugbà tɛ akasɛ yɛidzoɔ gɛ abagã vɛ Gɔshɛn. Gɛ bediku Gɔshɛn kɛkɔtɔ mɛɛ, <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />Yosɛf abalɛ̀ ohuɔ gɛ baagã eeteɛ babalɛ ohuɔ elu akɔɛ kɛlɛ avɛ Gɔshɛn tɛ adɛtsyanà yɛaka Israɛl. Gɛ Yosɛf eku yɔɛbhà kɔo, atáhɔɛ akpɛ yɛaka ishu, kɛlɛ ebieyo kibe dzlolo.<verse eid="GEN 46:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 46:30" />Israɛl etseɖe Yosɛf asɛ, "Otsiɛnɔ ɛbalà tsí, gɛ ɛmɔ̃ kɔ mɛishu sɛ ɔkɔ lɛ nɛkpã."<verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />Kɛlɛ Yosɛf etseɖe yɛadzalɛ nɛ̀ yɛaka bɔpãmɛ anɛ asɛ, "Ɛbà wuvɛ tɛ ɛɖɔaɖɔ akɔ Faɖawo kɛlɛ ɛbatseɖe yɛ sɛ, 'Mɛadzalɛ nɛ̀ mɛaka yɛɔpã, gɛ bazã Kana kesiakpa nabha, babá mɛɔkɔ. <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />Baanyɛ benu ibhoshi agbagbanà elete; beɖi kepi agãa abha, kɛlɛ balɔkɔ balɛ baagã azaa amanà nɛ̀ banɛntsyɔɛ nɛ̀ kɛkanyiaka gɛlɛ balɛ ahɔɛ.' <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />Onupɛ Faɖawo ekulu nɔ pɛ ebisiɛ sɛ, 'Kɛxɔ̃ɛ ɖuwoelu awɔawɔa nonu?' <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />nɔ builɛulũ ɔsɛ, 'Wɔaxɔɛdɛɛ beeɖi kepi aagã abha odenɔ balɛ bunuvɔmɛ bɔkpɛnɔ otsiɛ, asɛ kana gɛ bɔlɔ akaa alɛ abhɛtɛ.' Kɛlɛ babà kɔ wɔnɔ kidzo tɛ nɔzã Gɔshɛn kɛkɔtɔ mɛ, ɔmɔsɛ ibhoshi agbagbana elete petee benù ogũ ɔkɔ Egipteanɛ."<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />Yosɛf avɛ editseɖe Faɖawo asɛ, "Mɛaka nɛ̀ mɛadza alɛ nɛ̀ balɛ bagãa azaa nɛ̀ banɛntsyɔɛ nɛ̀ kɛkanyiaka gɛlɛ balɛ ahɔɛ, bede Kana kesiakpa nabha kɛlɛ balɛ Gɔshɛn otsialɛ." <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />Ebu yɛadza alɛ ɔmaiyɛmɛ banɔ teeti kɛlɛ ebu balɛ akasɛ Faɖao.<verse eid="GEN 47:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 47:3" />Faɖao ebisi yɛadzyalɛ asɛ, "Kɛxɔɛ ɖuwoe awɔawɔa nɔonu?"</para>
  <para style="p" vid="GEN 47:3">Bebuiliulũ akɔ Faɖao asɛ, "Wɔaxɔɛdɛ enu ibhoshi abha eɖiɖi elete asɛ kana gɛ bɔlɔ akalɛ tsyɛ azãa." <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />Betseɖe tsyɛ asɛ, bɔba sɛ tɛ bɔbazã ɛkɛlɛ kɛbɔɛ, ɔmɔsɛ bɔbhɛ dɔdɔ nulũ gagãlĩ nɛ Kana kɛlɛ tɛwɔa mã akɔ wɔaxɔɛdɛ yɛ baagã kɛzaa. Kliso otsiɛ nɔ, ɛkɔ wɔɛtakpu kɔ tɛ wɔaxɔɛdɛ ebhui kazã nɛ Gɔshɛn."<verse eid="GEN 47:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 47:5" />Faɖao etseɖe Yosɛf asɛ, "Wɔaka nɛ̀ wɔadza alɛ aba wɔkɔ, <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />kɛlɛ Egipte kesiakpa eli wɔamɛ; kɔ wɔaka nɛ̀ wɔadza alɛ batsɛ nɛ kesiakpa kalɛ ɔgbagbã ɔkɔ adɛ. Kɔ bazã Gɔshɛn. Kɛlɛ onyi balɛ mɛ ɔmaiyɛmɛ teli gɛ enyi kɛxɔ ɛlɛ piapii nɔ, lɔkɔ yɛodzu mɛ ibhoshi nulũ."<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />Kɛlɛ Yosɛf agbana yɛaka Yakɔb amana kɛmɛɛ kɛlɛ ebu yɛakasɛ Faɖao. Gɛ Yakɔb eyula akɔ Faɖao ebekeɛ, <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />Faɖao ebisi yɛasɛ, "Agɔ taashɛ wɔtɛŋã?"<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />Kɛlɛ Yakɔb etseɖe Faɖao asɛ, agɔ gɛ ɛgã kidzoɔ kɛkpã zɛzɛ nɛ̀ afɛata. Mɛ agɔ egi kpè kɛlɛ alɛ mɛ agagãlĩ, gɛ lagɛ shɔ nɛ̀ mɛakaalɛ kidzo gagã agɔɔ." <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />Kɛlɛ Yakɔb eyula akɔ Faɖao pɛ ashɛ nɛ yɛamɛ.<verse eid="GEN 47:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 47:11" />Kliso Yosɛf ebhui kazã akɔ yɛaka nɛ̀ yɛadzalɛ nɛ Egipte, kɛlɛ akɔ alɛ ahɔɛmɛ bɔdɔ̃ nɛ̀ kesiakpa kalɛ bɔbɔ olukɔɔ, nɛ Ramese kɛkɔtɔ mɛ asɛ gɛ Faɖao akpɛ ɛlɛ nɛ yɛulũɔ. <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />Yosɛf akɔ yɛaka nɛ̀ yɛadza alɛ nɛ̀ yɛakapã petee bɔŋaŋã tsyɛ nɛ balɛ eyialɛ tɛkakalà ulũ.<verse eid="GEN 47:12" /></para>
  <para style="s1">Yosɛf Nɛ̀ Bɔbhɛ Dɔdɔ</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />Bɔŋaŋã gɛzã, pɔ nɛ kɛkɔtɔ mɛ nyɔ̃ɔ nɔ bɔbhɛ dɔdɔ nulũ gagãlĩ, kɛlɛ Egipte nɛ̀ Kana banɔnɔ petee azhɔlɛ nɛ bɔbhɛ dɔdɔ shu so. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />Yosɛf ayɛkɛ ehoeyiɛ petee gɛ babamɔ̃ nɛ Egipte nɛ̀ Kana akɔ kɛbhɛ babuia nɛ bɔdɔeyiɛ gɛ bezedziɛ, kɛlɛ alɔkɔ bɔlɛ amanà Faɖao yɛ bukusipãmɛ. <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />Gɛ Egipteanɛ nɛ̀ Kananɛ ehoeyiɛ ebeleɛ, Egipteanɛ petee aba Yosɛf ɔkɔ kɛlɛ baɖɔ asɛ, "Kɔ bɔlɔ bɔŋaŋã. Kiɖe sopɛ kɛlɛ ɔsɛ butsí nɛ wɔamɛ? Bɔlɔ ehoeyiɛ ebele."<verse eid="GEN 47:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16" />Yosɛf aɖɔ asɛ, "Kɛɛlɛ́ nɔdɛ manà mɛ wɔnɔ kepi bagãa. Ɛbadɛ bɔŋaŋã akɔ wɔnɔ tɛ nɔlɔkɔ wɔnɔ kepi baagã ɔbuia kɛbhɛ nɔ, gɛ wɔnɔ ehoeyiɛ ebeleɛ." <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />Klisoɔ balɔkɔ balɛ kepi bagãa amanà Yosɛf kɛlɛ akɔalɛ bɔŋaŋã alɔkɔ atsaɖakɛ nɛ̀ balɛ basɔ nɔ, balɛ ibhoshiɛ nɛ̀ beepidzyaa, balɛ banɛntsyɔɛ nɛ̀ badikuɔ. Kɛlɛ agbanà alɛ afalanɔ nɛ kɛgɔ ɛlɛ mɛ nɛ̀ bɔŋaŋã gɛ alɔkɔ atsaɖakɛ nɛ̀ balɛ kepi bagãa petee.<verse eid="GEN 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18" />Gɛ kɛgɔ ɛlɛ falaa, baba yɛɔkɔ kɛgɔ gɛkpatɔnɔ̃ ɛlɛ mɛ pɛ baɖɔ asɛ, "Bɔtɛ balà lɔkɔ kpũ bɔlɔ apaleteɛ asɛ odenɔ gɛ bɔlɔ ehoeyiɛ ebele kɛlɛ bɔlɔ kepi bagãa enu wɔayɛɛ, kɛdɔ̃ nanà gɛtɔ ɔkɔ bɔlɔ apalete ɔdɛ bɔlɔ ishudzyaa nɛ̀ bɔlɔ kesiakpa. <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />Kiɖe sopɛ kɛlɛ sɛ butsí nɛ wɔamɛ--bɔlɔ nɛ̀ bɔlɔ kesiakpa tsyɛ? Dzi bɔlɔ nɛ bɔlɔ kesiakpa tɛ ɔlɔkɔ tsaɖakɛ akɔ bɔŋaŋã, tɛ bɔlɔ nɛ̀ bɔlɔ kesiakpa azã ohokuimɛ ɔkɔ Faɖao. Kɔ bɔlɔ bɔdɔeyi tɛ bɔzã nɛkpã tɛ butitsí, tɛ kesiakpa atɛ bawɔ akpakpa."<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />Klisoɔ Yosɛf edzi kesiakpa petee nɛ Egipte akɔ Faɖao. Egipteanɛ akanyiaka, badɛ balɛ ayakpa ɔmɔsɛ bɔbhɛ dɔdɔ nulũ gagãlĩ kɔalɛ faanɔ. Kesiakpa ebedzi Faɖawo ayɛ. <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />Kɛlɛ Yosɛf abhɛtɛ banɔnɔ bedzi axɔɛdɛdɛ elete, odenɔ Egipte kampɛ tienikpo mɛ ɔvɛnɔ kabhlatɔ. <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />Pɔ, egidzì bakpukpudziɛ busiakpa xɔnɔ, ɔmɔsɛ baza yɛkɛ bɔŋaŋã kɔkɔ edenɔ Faɖawo ɔkɔ ɔmɔsɛ bamɔ̃ bɔŋaŋã gɛ bukpè odenɔ bɔŋaŋã kɔkɔ gɛ Farao akɔalɛ mɛ. Kliso pɛ bagɛ dɛ balɛ busiakpa.<verse eid="GEN 47:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 47:23" />Yosɛf etseɖe banɔnɔ asɛ, "Otsiɛnɔ gɛ idzi wɔnɔ nɛ̀ wɔnɔ busiakpa oboɔ akɔ Faɖawo, bɔdɔeyiɛ naalɛ akɔ wɔnɔ sɛ tɛ nɔlà alɛ ɔɖa nɛ kesiakpa. <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />Pɔ onupɛ bɔdɔ̃pɔpɔ̃ baa, nɔlɔkɔ bɔlɛ mɛ kampɛ̃ itiɛ akɔ Faɖawo. Bɔmpɛ tɔɔlɛ nɛ itiɛ mɛɛ, nɔbɔ là balɛ asɛ bɔdɔeyi akɔ wɔnɔ bayaa nɛ̀ bɔŋaŋã akɔ wɔnɔ ishu nɛ̀ wɔnɔ bɔpãa nɛ̀ wɔnɔ beyialɛ."<verse eid="GEN 47:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25" />Baɖɔ asɛ, "Obu bɔlɔ ɛkpã. Tɛ bɔmɔ̃ awɔ̃kuku nɛ bɔlɔ apaleteɛ namɛ, bɔbazã ohokuimɛ akɔ Faɖawo."<verse eid="GEN 47:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 47:26" />Kliso Yosɛf akpɛ ɛlɛ asɛ ɔsha nɛ kesiakpa gɛalɛ Egipteɛ-kɛkanu ɔsha obuɔ-sɛ bɔdɔ̃pɔpɔ̃ bɔlɛ itiɛ bunu Faɖawo yɛ. Bakpukpudzi busiakpa yete bɔlɛ gɛidzi Faɖawo ɔyɛ.<verse eid="GEN 47:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />Otsialɛ Israelianɛ batsɛ nɛ Egipte nɛ Gɔshɛn kɛkɔtɔ mɛ. Bamɔ bɔdɔ̃ akɔ ishu nɛ ɛkɛlɛ beyù pɛ bekpè atɔɖɔ gbi nɛ tɛkakalà mɛ.<verse eid="GEN 47:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 47:28" />Yakɔb azã Egipte agɔ kɛfɔ nɛ̀ tegegene, kɛlɛ yɛ ɛkpã agɔ azã kɛkpã zɛzɛ nɛ̀ afɛtaalɛ nɛ̀ tegegene. <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />Gɛ kibeɛ tsooba akɔ Israel tɛ etsíɛɛ, ekulu yɛeyianyɛ Yosɛf kɛlɛ etseɖe yɛasɛ, "Onupɛ ɛmɔ̃ awɔkuku nɛ wɔ anhũɔ mɛɛ, lɔkɔ wɔ ɔhɔɛ kpɛ mɛ kɛtsɛɖɛta niesi, tɛ ɔɖɔ kibui olu ɔsɛ, ɔbɔ kasɛ mɛ ɛyamɛ gbangbã nɛ̀ kibui abha tɛbhɛbhɛtɛ. Tɛ vɔbɔ mɛ nɛ̀ Egipte, <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />pɔ onupɛ ɛvɛ baaka ɔkɔɔ, tuku mɛ okoeyi nɔ nɛ Egipte tɛ ɔdɛ vɔbɔ mɛ nɛ ɛkɛlɛ gɛ bavɔbɔ balɛ."</para>
  <para style="p" vid="GEN 47:30">Ebuiliulũ asɛ, "Ɛba bhɛtɛ asɛ kana gɛ ɔɖɔɔ.<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />Aɖɔ asɛ, "Tanà bɔdɔ̃ kɔmɛ." Kɛlɛ Yosɛf atanà bɔdɔ̃ akɔɛ, kɛlɛ Israel abhɛtɛ kɛtakpuesi kpɛkpɛ gɛ akpà atɔɖɔ osivuvũɔ nabha.<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s1">Manase nɛ̀ Efraim</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />Kibe teli ideɛ, betseɖe Yosɛf asɛ, "Wɔ akaa ishumɛ zĩ." Kliso agbanà yɛeyianyɛ taabha Manase nɛ̀ Efraim aplɛnɔ yɛishu. <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />Gɛ betseɖe Yakɔb asɛ, "Wɔeyianyɛ Yosɛf aba wɔkɔɔ" Israɛl akpɛ kemí alɔ azã nɛ yɛ ɛpã nabha.<verse eid="GEN 48:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 48:3" />Yakɔb etseɖe Yosɛf asɛ, "Owusoso Akaa Ohumi Petee Eleteɛ ebú yɛishu akasɛ mɛ nɛ Luz nɛ Kana kesiakpa nabha, ɛkɛlɛ yɛeyulà akɔ mɛ <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />kɛlɛ etseɖe mɛ asɛ, 'Ɛbakɔ wɔ oyù eyuyù kɛlɛ ɛbakɔ wɔ tɛkakalà mɛ kpè tɔɖɔ. Ɛbakɔ wɔodzì ɔmã, kɛlɛ ɛba lɔkɔ kesiakpa alɛ akɔ wɔ asɛ wɔahɔɛmɛ kɛdɔ̃ tihɔɔ akɔ wɔ kihui nɔ gɛ babà nɛ wɔɛdeɛ.'<verse eid="GEN 48:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5" />"Otsinɔ, kɛlɛ, wɔ beyianyɛ taabha gɛ bamɔ́ akɔ wɔ nɛ Egipte flogo pɛ ɛba wɔkɔ nɛ ɛkɛlɛ̀ babà kalà alɛ sɛ mɛ ayɛ; Efraim nɛ̀ Manase ebedzì mɛ ayɛ asɛ kana gɛ Ruben nɛ̀ Simeɔn enu mɛ ayɛ ana. <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />Beyi kanyiaka gɛ bazamɔ́ akɔ wɔ nɛ baalɛ niedeɛ ebedzì wɔ ayɛ; nɛ kampɛ nɔnɔ gɛedzi balɛ kaŋãsiɛ, babà kalà alɛ akpɛ balɛ adza alɛ enye niesi. <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />Gɛ itsyina ide Paɖan pɛ ɛbaa, nɛ mɛ ɔwɔnyɔnɔ mɛɛ, Raxɛl etsí nɛ Kana kesiakpa nabha gɛ bɔka tsiɖi kidzo nabha vɛɛ, tidzedze bhlui odenɔ Efrat. Kliso ɛvɔbɔ yɛ nɛ ɛkɛlɛ nɛ kidzoɔ gɛili ɔvɛ Efrat shu" (Gɛenu Betlɛxɛm).<verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />Gɛ Israɛl amɔ̀ Yosɛf yɛ beyianyɛ, ebisi asɛ, "Fakɔ anɛ naalɛ?"<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />Yosɛf etseɖe yɛaka asɛ, "Balɛenu beyianyɛ gɛ Owusoso Akaa akɔ mɛ nɛ ɛkɛlɛ̀."</para>
  <para style="p" vid="GEN 48:9">Kɛlɛ Israɛl aɖɔ asɛ, "Gbanà balɛ ɔmanà mɛ tɛ mɛiyulà akɔ alɛ." <verse eid="GEN 48:9" /><verse number="10" style="v" sid="GEN 48:10" />Otsiɛ nɔ Israɛl yɛanhũɔ eelĩ nɛ tisheshèɛ shu so, kɛlɛ atɛka mɔ piapii. Kliso Yosɛf agbanà yɛeyianyɛ etso aplɛnɔ yɛ, kɛlɛ yɛaka akpɛ ahɔɛ nɛ balɛ oliɛ pɛ anyanà balɛ akpɛ etemɛ.<verse eid="GEN 48:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 48:11" />Israɛl etseɖe Yosɛf asɛ, "Ɛgaa ɖi kidzo mɛ sɛ iwuli bamɔ wɔamɛ, kɛlɛ otsiɛnɔ Owusoso Akaa akɔmɛ kidzo tɛ mɛmɔ wɔeyialɛ tsyɛ."<verse eid="GEN 48:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 48:12" />Kɛlɛ Yosɛf atsɛ alɛ nɛ yɛaka ekuisi nɔ pɛ ezhyinɔ bamɛ ekumu kesi. <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />Kɛlɛ Yosɛf agbanà balɛ taabha, Efraim akpɛ yɛŋã mɛ gɛvɛ Israɛl kɛblɛkpɛ ɔhɔɛ mɛ, kɛlɛ akpɛ Manase nɛ yɛ kɛblɛkpɛ nɔ mɛ gɛvɛ yɛaka kɛŋã ɔhɔɛ mɛ, kɛlɛ agbanà alɛ aplɛnɔ yɛishu. <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />Pɔ Israɛl akpɛ yɛŋã ɔhɔɛ sɛsɛ kɛlɛ alɔkɔ ɔlɛ atɔɖɔ Efraim yɛtakpú nabha, flogo nɔ yɛenu anuvɔ, kɛlɛ gɛ akpɛ yɛhɔɛ tsakɛ bagɔlɔɔ, atɔɖɔ yɛ kɛblɛkpɛ ɔhɔɛ nɛ Manase kɛtakpuɔ, flogo nɔ manaseɛ yɛenu esheshèɛ.<verse eid="GEN 48:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 48:15" />Kɛlɛ yɛeyulà akɔ Yosɛf pɛ aɖɔ asɛ,</para>
  <para style="q1" vid="GEN 48:15">Tɛ Owusoso Akaa gɛ yɛamɛ mɛakaalɛ agãa</para>
  <para style="q2" vid="GEN 48:15">Mɛakalɛ Abraham nɛ̀ Isak</para>
  <para style="q1" vid="GEN 48:15">Owusoso Akaa gɛedzi mɛ obhoshi gbagbana elete</para>
  <para style="q2" vid="GEN 48:15">nɛ mɛ ɛkpãa petee mɛ bɔkpɛnɔ obuɔ,<verse eid="GEN 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 48:16" />Akaa axɔɛdɛ gɛ ebú mɛ odenɔ ɔfɔ̃wɔawɔa kanyiaka mɛ</para>
  <para style="q2" vid="GEN 48:16">eyulà akɔ banyɛnuvɔɛ alɛ.</para>
  <para style="q1" vid="GEN 48:16">Balɔkɔ mɛinyieɛ ekulu balɛ nɔ</para>
  <para style="q2" vid="GEN 48:16">nɛ̀ mɛakalɛ Abraham nɛ̀ Isak balɛ enyeɛ,</para>
  <para style="q1" vid="GEN 48:16">kɛlɛ bekpè atɔɖɔ gelee</para>
  <para style="q2" vid="GEN 48:16">nɛ kesiakpa nabha."<verse eid="GEN 48:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />Gɛ Yosɛf amɔ sɛ yɛaka aalɔkɔ yɛŋã ɔhɔɛ atɔɖɔ Efraim yɛtakpúɔ, kɛgɛ zã yɛuli, kliso anyanà yɛaka ɔhɔɛ atsɛ nɛ Efraim kɛtakpúɔ avɛnɔ Manase ɛtakpúɔ. <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />Yosɛf etsɖe yɛasɛ, "Oho, mɛakaa, yɛalɛ yɛenu eyì kusiɛ, tɔɖɔ wɔ kɛŋã ɔhɔɛ nɛ yɛtakpúɔ."<verse eid="GEN 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19" />Pɔ yɛakaa agɛ dɛmɛ kɛlɛ aɖɔ asɛ, "Inyi, mɛeyianyɛ, inyi. Yɛtsyɛ ebedzi ɔmã, kɛlɛ ebedzi anɔ gbagbla. Kɛlɛ ana tsyɛelo, yɛadza anuvɔ ebedzi anɔ gbagbla adɛ yɛ, kɛlɛ yɛ kihui nɔ badzì amadi kɛza." <verse eid="GEN 48:19" /><verse number="20" style="v" sid="GEN 48:20" />Eyulà akɔ balɛ nɛ kiwui ɛlɛ nabha kɛlɛ aɖɔ asɛ,</para>
  <para style="q1" vid="GEN 48:20">"Nɛ wɔɛnyeɛ mɛ Israɛl abaɖɔaɖɔ nɛ tiyuyulà ɛlɛ shu:</para>
  <para style="q2" vid="GEN 48:20">'Tɛ Owusoso Akaa abhɛtɛ wɔ asɛ Efraim nɛ̀ Manase.' "</para>
  <para style="m" vid="GEN 48:20">Kliso abhɛtɛ Efraim kɛtakpù akɔ Manase.<verse eid="GEN 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21" />Kɛlɛ Israɛl etseɖe Yosɛf asɛ, "Ɛba otsìkɔ, pɔ Owusoso Akaa abazã aplɛnɛ wɔ kɛlɛ ebedzinì wɔ agbanà amanà wɔakaalɛ kesiakpa nabha." <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />Kɛlɛ wɔ asɛ anɔ gɛ avɛ otugbà ɔdɛ wɔadza alɛ ana, ɛkɔ wɔ beetu kesiakpa alɛ gɛ ɛyɛkɛ odenɔ Amorianɛ ahɔɛ nɛ̀ mɛ bɛtɛ̀ nɛ̀ mɛ̀ bɔnyɔ̃.<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s1">Yakɔb Eyulà Yɛ Beyianyɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />Kidegba Yakɔb ekulu yɛ beyianyɛ kɛlɛ aɖɔ asɛ: "No shogo nɛ mɛɔbha tɛ ɛbala itseɖe wɔnɔ kɛ gɛ babá wɔnɔ abha nɛ ewui gɛ aba ba mɛ.<verse eid="GEN 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2" />"Noshogo tɛ nɔtaatɔ̃, Yakɔb beyianyɛ;</para>
  <para style="q2" vid="GEN 49:2">nɔtaatɔ̃ wɔnɔaka Israɛl.<verse eid="GEN 49:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3" />"Rubɛn, wonu mɛeyikusi,</para>
  <para style="q2" vid="GEN 49:3">mɛ ohumi, mɛ ohumi eyuyu gɛeputɔ aba,</para>
  <para style="q2" vid="GEN 49:3">ɔɔnà nɛ kɛtakpuesi kpɛkpɛ mɛ, ɔɔna nɛ ohumi mɛ.<verse eid="GEN 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4" />Ɔgɛdɔ fɔɔ̃ asɛ kelĩkpɛkpɛ ana,</para>
  <para style="q2" vid="GEN 49:4">ɔɔzɔkɔ na,</para>
  <para style="q2" vid="GEN 49:4">ɔmɔsɛ owu wɔaka ɛpã abha, nɛ mɛ ɛpã bɔdɔ̃ nabha kɛlɛ ɔkpɛ yɛɔtsɔ̃.<verse eid="GEN 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5" />"Simeɔn nɛ̀ Levi benu baadzya-</para>
  <para style="q2" vid="GEN 49:5">balɛ bɛtɛ benu bɔdɔ̃zĩzĩ eyuta bɔdɔ̃.<verse eid="GEN 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6" />Tɛkɔ mɛiku balɛ ɔhamɛ,</para>
  <para style="q2" vid="GEN 49:6">tɛkɔ mɛitsoku balɛ tishoshogomɛ,</para>
  <para style="q1" vid="GEN 49:6">ɔmɔsɛ beyí baanyɛ nɛ ɔmɔpɔɛ mɛ</para>
  <para style="q2" vid="GEN 49:6">kɛlɛ bagbã nɛntsyɔɛ tɛtsɛtsɛɖɛ aasɛ kana gɛ ba pɛ.<verse eid="GEN 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7" />Kibuiɖɔkpɛanɔ edzi balɛ ɔmɔpɔɛ, lokuifù,</para>
  <para style="q2" vid="GEN 49:7">kɛlɛ balɛ ɔmɔpɔɛ kpɛkpɛ, kɛtakpumɛ gagalĩ!</para>
  <para style="q1" vid="GEN 49:7">Ɛba pɔ̃ɛalɛ mɛ kanà nɛ Yakɔb mɛ</para>
  <para style="q2" vid="GEN 49:7">kɛlɛ ɛba hɔɛalɛ nɛ Israɛl mɛ.<verse eid="GEN 49:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8" />"Yuɖa, wɔadzalɛ abakpɛ wɔ nɛititi;</para>
  <para style="q2" vid="GEN 49:8">wɔahɔɛ bazã baagɛ batɛaɖɔwɔ balɛ oli;</para>
  <para style="q2" vid="GEN 49:8">wɔaka yɛ beyianyɛ bebè zhyiekumũ akɔwɔ.<verse eid="GEN 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9" />Onu dzata eyi, O Yuɖa;</para>
  <para style="q2" vid="GEN 49:9">otsyinaba odenɔ agã gɛ ovũɔɔ, mɛeyianyɛ.</para>
  <para style="q1" vid="GEN 49:9">Aasɛ dzata ana gɛ aabhɛ̃ kɛlɛ ezhyi eli kesi,</para>
  <para style="q2" vid="GEN 49:9">aasɛ dzataelĩ-afa gɛ abala hɔana yɛ?<verse eid="GEN 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10" />Akɔfra atɛba shɛ nɛ Yuɖah ɔkɔ,</para>
  <para style="q2" vid="GEN 49:10">pɛnɔsɛ dzaŋgbɛ nɛ yɛ ɛtsɛɖɛ ishi,</para>
  <para style="q1" vid="GEN 49:10">ɔdɛkpɛnɔ gɛ aba agɛ yɛayɛ yɛenuɔ ɔkɔ</para>
  <para style="q2" vid="GEN 49:10">kɛlɛ kɛmadiɛ baatɔ̃ lulu enu yɛayɛ.<verse eid="GEN 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11" />Aba kpaka yɛ adiku nɛ wain kihui ishu,</para>
  <para style="q2" vid="GEN 49:11">yɛ adiku eyi nɛ bɔshɛ̀ɛ gbangbã ishu;</para>
  <para style="q1" vid="GEN 49:11">ebepulu yɛ apɔtɛ nɛ wain mɛ,</para>
  <para style="q2" vid="GEN 49:11">yɛ akpɛkpɛ nɛ wain eyuyu dzyosu mɛ,<verse eid="GEN 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12" />Yɛ anhũɔ aba nɔ tũtũũtũ adɛ wain,</para>
  <para style="q2" vid="GEN 49:12">yɛ eneɛ befuli adɛ bɔmɔlĩ.<verse eid="GEN 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13" />"Zebulun ábà zã bulĩkekpu tɔ̃</para>
  <para style="q2" vid="GEN 49:13">kɛlɛ ebedzi ɔtsɛkɔ akɔ kelĩ ihuɔ;</para>
  <para style="q2" vid="GEN 49:13">yɛ buboɔ aba nɛ̀ avɛ Sidɔn.<verse eid="GEN 49:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14" />"Isaka enu adiku kpɛkpɛlɛ</para>
  <para style="q2" vid="GEN 49:14">gɛ awɔsɔ̃ adiku ɛkpɛtɛ taabha ishi.<verse eid="GEN 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15" />Kibe nɔnɔ gɛ amɔ̃ kana gɛ yɛ omoelè ɔkɔ ɔpɛɛ</para>
  <para style="q2" vid="GEN 49:15">nɛ̀ kana gɛ yɛ kesiakpa alɔdzɛ̃,</para>
  <para style="q1" vid="GEN 49:15">ebezhyini yɛ owudɔ niesi akɔ kitukuɔ</para>
  <para style="q2" vid="GEN 49:15">kɛlɛ aba wɔa kɛxɔɛ gɛ batɔɖɔ yɛabha.<verse eid="GEN 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16" />"Ɖan aba ebe kulu kebhu gbangbã akɔ yɛanɔnɔ</para>
  <para style="q2" vid="GEN 49:16">asɛ Israɛl kigbogbɔ tenikpo.<verse eid="GEN 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17" />Ɖan ebedzì eblidzya nɛ kidzo ishu,</para>
  <para style="q2" vid="GEN 49:17">eblidza gɛ eyi ashà nɛ kidzo kɛwɔã</para>
  <para style="q1" vid="GEN 49:17">gɛenemi ɛsɔ yɛ katsɛɖɛkpɔ edeɛ</para>
  <para style="q2" vid="GEN 49:17">sɛtɛ agɛ yɛekũ yɛ adɔ oboe avɛ kide.<verse eid="GEN 49:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18" />"Iɖi kidzomɛ akɔ wɔ tibubuɔ, O Apalete.<verse eid="GEN 49:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19" />"Beyutaɛza abalɔ adɔ Gaɖ abha,</para>
  <para style="q2" vid="GEN 49:19">pɔ abalɔ adɔ balɛ abha gɛ beebu tɛtsɛɖɛ mɛ.<verse eid="GEN 49:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20" />"Asha yɛ bɔŋaŋã baluubɔ,</para>
  <para style="q2" vid="GEN 49:20">abakɔ bɔŋaŋã edi gɛ abashɔ̃ akɔ ekusi.<verse eid="GEN 49:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21" />"Naftali enu asabho gɛ beboele</para>
  <para style="q2" vid="GEN 49:21">gɛ amɔ́ beeyi gɛ beyì bɔnɔ.<verse eid="GEN 49:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22" />"Yosɛf enu kihui gɛiyu eyuyù.</para>
  <para style="q2" vid="GEN 49:22">kihui gɛiyu eyuyù gɛalɛ bulĩ gɛ bukoeyi nɛ kesiakpa mɛɔbha,</para>
  <para style="q2" vid="GEN 49:22">gɛ kɛlɛ bɔsha buwu ɔgã kigili abha.<verse eid="GEN 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23" />Nɛ ishumɛ pɔpɔɛ mɛɛ, bɔnyɔ̃ atata eleteɛ alɔadɔ yɛabha;</para>
  <para style="q2" vid="GEN 49:23">batá yɛ nɛ tɛmaɖɔ́maɖɔ́ mɛ.<verse eid="GEN 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24" />Pɔ yɛ bɔnyɔ̃ɔ gɛishukù,</para>
  <para style="q2" vid="GEN 49:24">yɛ ɛhɔɛ gagãliɛ zɛ hɔà piapii,</para>
  <para style="q1" vid="GEN 49:24">nɛ Yakɔb yɛ Ohumi eleteɛ ɔhɔɛ gagãlĩ kɛtakpu,</para>
  <para style="q2" vid="GEN 49:24">nɛ ibhoshi Agbagbana elete, Israɛl yɛ Ɔxɔàa kɛtakpu so,<verse eid="GEN 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25" />nɛ wɔaka yɛ Owusoso Akaa, gɛ aplɛnɔ wɔ kɛtakpu</para>
  <para style="q2" vid="GEN 49:25">nɛ Ohumielete gɛ eyulà akɔ wɔ kɛtakpu</para>
  <para style="q1" vid="GEN 49:25">nɛ̀ tiyuyulà gɛede owusoso nɔ gɛalɛ kabhaa</para>
  <para style="q2" vid="GEN 49:25">tiyuyulà gɛede kesiakpa mɛ nɛ̀ kesiɛ ɔkɔ</para>
  <para style="q2" vid="GEN 49:25">tiyuyulà gɛede kɛmɔ́ nɛ̀ kamɔmɔvũ mɛ<verse eid="GEN 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26" />Wɔaka tiyuyulà egbogblo</para>
  <para style="q2" vid="GEN 49:26">ɔdɛ beetùkukuɔ tiyuyulà,</para>
  <para style="q2" vid="GEN 49:26">adɛ beetukpɔ sheshe bɔdɔ̃kɔkɔ.</para>
  <para style="q1" vid="GEN 49:26">Kɔ baalɛ nyɔ̃ɔ bemoelè nɛ Yosɛf yɛtakpu nabha,</para>
  <para style="q2" vid="GEN 49:26">nɛ ekusieyiɛ yɛ ketúɔ nɛ yɛadzalɛ nɛishi.<verse eid="GEN 49:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27" />"Bɛndzamin enu kifutùmɛ ebu gɛ bɔbhɛ yi;</para>
  <para style="q2" vid="GEN 49:27">nɛ kɛvɔlɔ mɛ aatã agãvuvũɔ,</para>
  <para style="q2" vid="GEN 49:27">ɔwlagoɔ aapɔ̃ɛ keyudɔ̃ mɛ."<verse eid="GEN 49:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />Israɛl yɛ egbogbo lɔfɔ nɛ̀ taabha nyɔ̃ɔ naalɛ, kɛlɛ kibui ɛlɛ balɛ akaa etseɖe balɛ gɛ eyulà akɔalɛ, pɛ akɔ anɔnyianɔ yɛ tiyuyulà gɛ ashɔ̃ akɔɛ.<verse eid="GEN 49:28" /></para>
  <para style="s1">Yosɛf Yɛ Titsitsí</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />Kɛlɛ akpɛ ɛsha ɛlɛ akɔalɛ: "Atɔ kɛbɔɛ gɛ ɛbavɛ mɛashuĩalɛ ɔkɔ. Nɔvɔbɔ mɛ nɛ mɛakalɛ ɔbhã nɛ kɛklagbu ozĩɛ gɛlɛ Efrɔn Hetieyie yɛ ayakpaa mɛ, <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />kɛklagbu ozĩɛ nɛ Makipɛla ayakpaa mɛ, nɛ Mamrɛ gɛalɛ Kana, gɛ Abraham edzì akɔ ɔvɔbɔkɔ odenɔ Efrɔn Xitieyiɛ, ɔplɛnɔ ayakpaa. <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />Ɛkɛlɛ bavɔbɔ Abraham nɛ̀ yɛedzinì Sara, ɛkɛlɛ́ bavɔbɔ Isak nɛ̀ yɛedzini Rebeka, ɛkɛlɛ mɛvɔbɔ Leya. <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />bedzi ayakpaa nɛ kɛklagbu ozĩ gɛ akpasɛ kalɛ mɛɛ odenɔ Xitianɛ ɔkɔ."<verse eid="GEN 49:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33" />Kibeɛ gɛ Yakɔb ayɔlɔ ɛsha akpɛ akɔ yɛ beyianyɛ, efeke yɛtsɛɖɛ atɔɖɔ ɛpã nabha, pɛ afuĩa gɔgɔɛ kɛlɛ avɛ yɛashuĩalɛ ɔkɔ.<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />Yosɛf ezhyiadɔ yɛaka abha kɛlɛ ebieyo atɔɖɔ yɛabha kɛlɛ akpɛ ahɔɛ nɛ yɛ oliɛ. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />Kɛlɛ Yosɛf akpɛ yɛ baawabhɛtɛ eleteɛ sɛ tɛ banyã yɛaka Israɛl abalɛ nɛ bɔwɔa mɛ. Kliso baawɔabhɛtɛ eleteɛ banyã yɛ abalɛ nɛ bɔwɔa mɛ, <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />kɛlɛ balɔkɔ ewui afɛtaalɛ nyɔ̃ɔ, omɔsɛ kibe ɛlɛ kɛlɛ̀ balɔkɔ pɛ banyã ekpu abalɛ̀ nɛ bɔwɔa mɛ. Kɛlɛ Egiteanɛ bazã ɔwɔnyɔ̃nɔmɛ akɔ yɛ ewui afɛtegegene.<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />Gɛ ɔwɔnyɔ̃nɔ ewuiɛ aba afalaa, Yosɛf etseɖe Faɖawo bɔpã sɛ, "Onu pɛ ɛmɔ bɔwɔ̃kuku nɛ wɔnɔ anhũɔ mɛ, notseɖe Faɖawo kɔmɛ. Notseɖe yɛɔsɛ, <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />'Mɛaka akɔ mɛ tanà bɔdɔ̃ kɛlɛ aɖɔsɛ, "Mɛ kitsibee na; vɔbɔ mɛ nɛ ozĩɛ gɛ ibukɔ mɛishu nɛ Kana kesiakpa nabha mɛ." Otsiɛ nɔ kɔ mɛ vɛ tɛ ɛdɛ vɔbɔ mɛaka; kɛɛlɛ ebatsyina ba.' "<verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />Faɖawo aɖɔ asɛ, "Vɛ tɛ ɔdɛ vɔbɔ wɔakaa, asɛ kana gɛ ɔtana bɔdɔ̃ sɛ ɔbɔbhɛtɛ."<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />Kliso Yosɛf avɛ yɛaka vɔbɔ kɔ. Faɖawo yɛaxɔɛdɛ ɔzãkɔanɔ nyɔ̃ɔ atɔnɔ yɛ avɛ-baanɔ gbagbla nɛ yɛ bɔpã mɛ nɛ̀ Egipte baanɔ gbagbla nyɔ̃ɔ- <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />ɔlɔkɔ aplɛnɔ Yosɛf yɛ bɔpãmɛanɛ petee nɛ̀ yɛadzalɛ nɛ̀ baagɛ benu yɛaka bɔpãmɛanɛ. Balɛ eyialɛ nɛ̀ banɛntsyɔɛ yete balɛ awɔ Goshin. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />Ɛɖapakaihuɔ nɛ̀ baagɛ bazã ɛsɔ nabha tsyɛ avɛ aplɛnɔ yɛ. Kɛza gbagbla kidzi.<verse eid="GEN 50:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10" />Kibeɛ gɛ beku Atad amɔohukɔ, nɛ Yɔɖan kelĩɛ shuɔ, ishukpakpamɛ nɛ ozĩkpɛkpɛ mɛ nyagãa; ɛkɛlɛɛ Yosɛf alɔkɔ ewui tegegene biyoyo akɔ yɛaka. <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />Gɛ Kananɛ gɛ bazã ɛkɛlɛ amɔ ɔwɔnyɔnɔ nɛ Atad amɔohukɔɔ, baɖɔ asɛ, "Egipteanɛ baagbã tɛwɔ̃nɔ." Kliso pɛ bekulu ɛkɛlɛ nɛ Yɔɖan ɔbha asɛ Abɛl Mizraim.<verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />Kliso Yakɔb yeyiayɛalɛ abhɛtɛ asɛ kana gɛ akpɛ ɔsha kɔalɛ: <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />Betukù yɛ ɔvɛnɔ Kana kesiakpa nabha kɛlɛ bavɔbɔɛ nɛ kɛklagbu ozĩɛ gɛalɛ Makipɛla ayakpa mɛ, nɛ Mamrɛ, gɛ Abraham edzi akɔ ɔvɔbɔkɔ odenɔ Xitieyi Ɛfron ɔkɔ, gɛɔplɛnɔ ayakpaa. <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />Gɛ avɔbɔ yɛaka ebekeɛ, Yosɛf etsyina vɛ Egipte, ɔplɛnɔ yɛadzalɛ nɛ̀ banɔnɔ nyɔ̃ɔ gɛ batɔnɔ yɛ avɛ yɛaka ɔvɔbɔ kɔ.<verse eid="GEN 50:14" /></para>
  <para style="s1">Yosɛf Ayɔ Yɛadzyalɛ Kitú</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />Kibeɛ gɛ Yosɛf yɛadzyalɛ amɔ asɛ balɛ aka etsíɛ, baɖɔ asɛ, "Ebedzi asɛ Yosɛf anyana kibui evunɔ nɛ bɔlɔ ishu kɛlɛ ababuia kɛbhɛ kɔ bɔlɔ nɛ ebuikpa nyɔ̃ɔ gɛ bɔbhɛtɛ nɛ yɛishu xɔ̃ɔ?" <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />Kliso basɛsɛ Yosɛf ɔklasɔ̃, gɛ baaɖɔ asɛ, "Wɔakaa aɖɔ ebui bhɛbhɛtɛ alɛ elu akpɛ bɔlɔ ahɔɛ flogo pɛ etsi: <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />'Kibuilɛ mɛpɛ sɛ nɔɖɔ otseɖe Yosɛf: Ibisi wɔ sɛ ɔlɔkɔ wɔadzalɛ ebuikpa bhɛbhɛtɛ nɛ̀ ebuikpa gɛ babhɛtɛ manà wɔishu nyagãa nɔ otsye alɛ.' Otsinɔ ɛkɔ wɔɛtakpu sɛ ɔlɔkɔ wɔakaa yɛ Owusoso Akaa axɔɛdɛ ebuikpa bhɛbhɛtɛ otsye alɛ." Gɛ balɛ ɔklasɔ̃ ode ku yɛɔkɔɔ, Yosɛf ebieyo.<verse eid="GEN 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18" />Yɛadzalɛ aba kidegba kɛlɛ bezhyiadɔ nɛ yɛotugba. Baɖɔ asɛ, "Wɔ banɔdzidzi bunu."<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />Pɔ Yosɛf etseɖe balɛ asɛ, "Notoosi kifu. Ɛlɛ́ Owusoso Akaa yɛɔzãkɔ dza? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />Wɔnɔ nɔtɔɖɔ sɛtɛ nozĩ mɛ, pɔ Owusoso Akaa atɔɖɔ kɛlɛ akɔ kɛgbangbã sɛ kɛgɛ aabhɛtɛ otsiɛnɔ baɛlɛ mɛ, gɛenu baanɔ gelee ɛkpã bubú. <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />Kliso, noti si kifu. Ebaɖi wɔnɔ nɛ̀ wɔnɔ eyiale abha."<verse eid="GEN 50:21" /></para>
  <para style="s1">Yosɛf Yɛ Titsitsí</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />Yosɛf azã Egipte, ɔlɔkɔ plɛnɔ yɛaka bɔpãmɛanɛ petee. Azã nɛ ɛkpã agɔ kɛkpã zɛzɛ̃ nɛ kɛfɔ <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />kɛlɛ amɔ̀ Ephraim yɛ baagblenɛ. Manase yɛeyianyɛ Makiɛ yeyialɛ tsyɛ bamɔ́ alɛ atɔɖɔ Yosɛf yɛ ekluisi abha.<verse eid="GEN 50:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 50:24" />Kɛlɛ Yosɛf etseɖe yɛadzalɛ asɛ, "Eba batsí. Pɔ Owusoso Akaa aba aplɛnɔ wɔnɔ tɛ ebu wɔnɔ ekoeyi nɛ kesiakpa alɛ nabha ovɛnɔ kesiakpa gɛ aɖɔ elu nɛ bɔdɔ̃ tɛtata nã mɛ akɔ Abraham, Isak nɛ̀ Yakɔb sɛ abakɔ alɛ." <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />Kɛlɛ Yosɛf akɔ Israɛl yɛ beyianyɛ batanà bɔdɔ̃ kɛlɛ aɖɔ asɛ, "Owusoso Akaa aba aplɛnɔ wɔnɔ gɛ kɛtɛ batsyina, kɛɛlɛ́ tɛ nɔlɔkɔ mɛaxɔa ɔshɛnɔ nɛ ɛkɛlɛ."<verse eid="GEN 50:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 50:26" />Kliso Yosɛf etsí gɛ aŋã agɔ kɛkpã zɛ̃zɛ nɛ̀ kɛfɔ. Kɛlɛ gɛ babalɛ yɛ nɛ bɔwɔa mɛ ebekeɛ, balɔkɔ yɛ akpɛ bekpu aɖaka mɛ nɛ Egipte.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>