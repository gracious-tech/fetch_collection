<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- 2 TIMOTI - Tonga Translation Project</book>
  <para style="h">2 Timoti</para>
  <para style="toc1">Lugwalo LwaPawulu kuliTimoti</para>
  <para style="toc2">2 Timoti</para>
  <para style="toc3">2 Tim</para>
  <para style="mt2">Lugwalo Lwachibili LwaPawulu Kuli</para>
  <para style="mt1">TIMOTI</para>
  <para style="imt">Manjililo</para>
  <para style="ip">
    <char style="bk">Lugwalo lwaTimoti lwachibili</char> ndugwalo lwachibili luzwa kumutumwa Pawulu kaluya kuli sikwiiya wakwe Timoti. Timoti wachibili lwakalembwa kakuli kwaba afwiifwi akumamanino abuumi bwaPawulu. Wakali muntolongo kuRoma muchiindi nchicheechi (2 Timoti 1:16). Pawulu wakali abulidilano buli afwiifwi aTimoti alimwi wakalikuvuzya kwaamba kuti mwana wakwe (BaFilipu 2:22, 1 Timoti 1:2,18).</para>
  <para style="ip">Oolu nduulumwi lwamagwalo aane azwa kuli Pawulu alangene amuntu peepe kumbungano. Magwalo aambi atatu alimbuli lolu nguTimoti mutaanzi aTayitasi aFilimoni. Muchiindi eecho Timoti wachibili naakalembwa, nchichiindi banaKkirisitu babweendelezi bwaba Roma nibakapenzegwa. Eechi ngachilaba nchicho chakapa kuti Pawulu abe muntolongo alimwi wakali kulayilila Timoti kuti akakatile mubuyumuyumu. Mbuli muli Timoti mutaanzi kale, Pawulu upa Timoti machenjezyo mayingi atala abayiisyi babeji (1 Timoti 1:16-18). Alubo waambila Timoti kuti kunembo kuyooba zyiindi ziyumu (2 Timoti 3:1).</para>
  <para style="iot">Bwiime</para>
  <para style="io1">Pawulu utalika akujuzya Timoti (2 Timoti 1:1-2) eelyo mpawo akumusungwaazya (2 Timoti 1:3-18)</para>
  <para style="io1">Eelyo uzundikizya Timoti kuti akakatile (2 Timoti 2:1-13)</para>
  <para style="io1">Chitobela umupa malayilile biyo (2 Timoti 2:14-26)</para>
  <para style="io1">Eelyo umuchenjezya atala azintu zichiza anzila yakuvwiila (2 Timoti 3:1—4:8)</para>
  <para style="io1">Pawulu umanisya amajwi aakwe kuli Timoti. (2 Timoti 4:9-24)</para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />Ime Pawulu, mutumwa waKkirisitu Jesu akuyanda kwaLeza mukwiinda muchisyomezyo chabuumi oobo buli muli Kkirisitu Jesu.<verse eid="2TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TI 1:2" />Kuli Timoti, mwana wangu ngundiyandisya:</para>
  <para style="p" vid="2TI 1:2">Luzyalo aluse aluumuno luzwa kuli Leza Taata akuli Kkirisitu Jesu Mwami wesu lube anduwe.<verse eid="2TI 1:2" /></para>
  <para style="s">Kupa Kulumba ansungwazyo</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />Ndilumba Leza ooyo ngundibelekela amoyo ululeme, mbuli mbubakachita bamataata, nindikuyeeya lyoonse munkombyo zyangu sikati amansiku. <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />Mbuli mbundiyeeya misozi yako, ndilaachiyandisyo chakuti ndizookubone, kuchitila kuti ndikazuzigwe alukondo. <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" /><note caller="-" style="x"><char style="xo" closed="false">1:5. </char><char style="xt" closed="false"><ref loc="ACT 16:1">Inch 16:1</ref>.</char></note>Ngandayeezegwa alusyomo lwako lwini, lusyomo oolo lwakali mulibanyookulu Loyisi lutaanzi abanyoko Yunisi alimwi lino, ndili achoonzyo, luli muli nduwe. <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />Nkikaako ndakuyibalusya kuti ufulilizye mulilo wachipo chaLeza nchwakajana mukwiinda mukubikkwa maboko aangu; <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />nkaambo Leza teewakatupa muuya wabuyoofu pe pesi muuya wanguzu aluyando akulizyotolola.<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />Eelyo utabi abweeme akupa bukamboni kuMwami wesu, nikuba bwangu ndimwaange wakwe, pesi kwaabana mumapenzi nkaambo kamakani mabotu munguzu zyaLeza, <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />ooyo wakatufutula akutwiita kuti tupone buumi busalala, peepe nkaambo kamilimu yesu pesi nkaambo kamabambe aakwe aluzyalo oolo ndwakatupa muli Kkirisitu Jesu kuzwa kumatalikilo. <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />Lino luzyalo oolu lwakayubunwa mukwiinda mukuliboniya kwamufutuli wesu Kkirisitu Jesu, wakazunda lufu mpawo weeta buumi akutabola kumumuni mukwiinda mumakani mabotu.<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />Nkaambo kamakani mabotu aaya ndakasalwa kuti ndibe mukambawusi amutumwa amuyiisi, <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />nkaambo kacheechi ndiliikupenzegwa mbuli mbundibede. Pesi tandikwe bweme, nkaambo ndilimwizi ooyo ngundakasyoma, alimwi ndili achoonzyo kuti ulakonzya kukwabilila eecho nchaakandisyoma mane Buzuba oobo. <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />Tobela mukondo wamajwi akasimpe ngwakamvwa kulindime, mulusyomo aluyando luli muli Kkirisitu Jesu; <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />kwabilila chintu eecho nchuwakasyomegwa mukwiinda mulugwasyo lwaMuuya Usalala ukkede mulindiswe.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />Ulizi kuti boonse bali muEziya bakandichija, kubalilizya aamwi aFayijilasi aHemojenzi. <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />Ngakube kuti Mwami ape luse kuŋanda yaOnesiforasi, nkaambo chiindi chiingi wakandibukulusya; teewakaba abweeme pe abwaange bwangu, <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />naakasika muRoma wakandiyanduula kapati alimwi wakandijana. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />Ngakube kuti Mwami amupe kuti ajane luse luzwa kuMwami Buzuba oobo, alimwi uluuzi kabotu mulimu woonse ngwakachita kuEfeso.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">Silumamba Mubotu waKkirisitu Jesu</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />Eelyo iwe, mwanaangu, ube mukozu muluzyalo luli muli Kkirisitu Jesu, <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />alimwi eezyo nzwakamvwa kulindime kunembo lyabakamboni bayingi, uziyiisye kubantu basyomekede bayookonzya kuyiisya bamwi lubo.<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />Waabilane mukupenzegwa mbuli silumamba mubotu waKkirisitu Jesu. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />Taakwe silumamba uli mumulimu uchelezegwa akuchita zimbi, mbuli kuti impalamo yakwe njakubotezya simalelo wakwe. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />Sikuchijaana tajani musini pe kunze akuti wachijaana zyeendelene amalayilile. <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />Mulimi ubeleka anguzu nguuyelede lutaanzi kujana chaabilo chazilyo. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />Yeeyesya atala azintu nzindaamba, nkaambo Mwami uyookupa kumvwisisisya muzintu zyoonse.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />Yeeya Jesu Kkirisitu, wakabusigwa kuzwa kubafu, walunyungu lwaDevidi, mbuli mbwakambawukwa mumakani mabotu aangu, <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />makani mabotu aayo ngindifwabila akwaangwa anketani mbuli sikutyola mulawu. Pesi jwi lyaLeza talyaangidwe pe anketani. <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />Nkikaako ndilakakatila zintu zyoonse nkaambo kabasale, kuchitila kuti alabo bakajane lufutuko muli Kkirisitu Jesu abulemu butamani. <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />Kwaamba ooku nkwachoonzyo:</para>
  <para style="q1" vid="2TI 2:11">Kuti twafwa anguwe,</para>
  <para style="q2" vid="2TI 2:11">tuyoopona aamwi anguwe lubo.<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />Kuti twakakatila,</para>
  <para style="q2" vid="2TI 2:12">tuyooyendelezya aamwi anguwe lubo;</para>
  <para style="q1" vid="2TI 2:12">kuti twamutama,</para>
  <para style="q2" vid="2TI 2:12">alakwe uyootutama alubo;<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />kuti katutasyomeki,</para>
  <para style="q2" vid="2TI 2:13">we unookkede kasyomekede,</para>
  <para style="q2" vid="2TI 2:13">nkaambo takonzyi kulitama.<verse eid="2TI 2:13" /></para>
  <para style="s">Simulimu Mubotu</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />Kubayeezya zintu eezi, akubalayilila kunembo lyaLeza kuti baleke kukazyana atala amajwi, aayo atagwasyi, pesi anyonganiya aabo baswiilizyi. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />Chita changuzu kuti ulitondeezye kuli Leza mbuli umwi wakasalwa, simulimu utakwe bweeme, ujata kabotu ijwi lyakasimpe. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />Uleke kwaambuula kutakwe bunaLeza, nkaambo kuyoozulida bantu mukuyabuya kubija, <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />alimwi majwi aabo ayooyendelela mbuli chilonda chisasabuka. Akati kabo kuli Himeniyasi aFiletasi, <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />aabo bakasunzuluka kuzwa kukasimpe akujatilila kuti kubuka kwakayinda kale. Baliikunyonyoona lusyomo lwabamwi. <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" /><note caller="-" style="x"><char style="xo" closed="false">2:19. </char><char style="xt" closed="false"><ref loc="NUM 16:5">My 16:5</ref>; <ref loc="ISA 26:13">Ay 26:13</ref>.</char></note> Pesi intalisyo yaLeza iliimvwi nji, kayijisi chisinizyo chamajwi aaya: “Mwami ulibazi bakwe,” alimwi, “Muleke woonse muntu wiita zina lyaMwami aleke bubi.”<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />Muŋanda mpati mulizibelesyo peepe zyangolide ansiliva luzutu pe pesi lubo azyazisamu azyabulongo, azimwi zibelesegwa mubulemu, azimwi zitali zyabulemu. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />Kuti umwi walisalazya kuzwa kuzintu eezyo zyabubi zitakwe bulemu, eelyo uyooba chibelesyo chabulemu, chisalazidwe akuba amulimu kuli simalelo waŋanda, chibambililwa kubelesegwa kufumbwa mulimu mubotu. <verse eid="2TI 2:21" /><verse number="22" style="v" sid="2TI 2:22" />Aboobo siya zisusi zyabukubusi akudunamina bululami alusyomo aluyando aluumuno, abaabo bayita zina lyaMwami kuzwa kumoyo ululeme. <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />Utabi achakuchita azyabufubafuba, akukazyana kwabiyo, ulizi kuti zizyala nkondo. <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />Alimwi mulanda waMwami teelede kuba sikukazyana pe pesi abe abuuya kumuntu woonse, weelede kuba muntu ukonzya kuyiisya amoyo mulamfu, <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />ululamika aabo bamukazya mukulibombya. Ambweni Leza ngoolabapa kuti bakasanduke akuyooziba kasimpe, <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />alimwi ngabalakonzya kuyeeya kabotu mpawo bachije kuzwa kukakole kaSikuchenga, ooyo wakabatola mubuzike kuti bachite kuyanda kwakwe.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">Mazuba Akumamanino</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />Pesi mvwisisisya eechi, kuti mumazuba akumamanino kuyooza zyiindi zikataazya. <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />Nkaambo bantu bayooba basikuliyanda, abasimuyanda mali, abasikulisumpula, abalyuuma akaango, abasikutukila Leza, abatalemeki bazyali babo, abatalumbi, abataluleme, <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />batakwe luyando, abatalekeleli, abasikubeja, abatalizyotololi, abasibukali, abasula bubotu, <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />abasikwaaba bamwi, abatayeeyi, abayumumutwe, abasikuyanda bubi kwiinda kuyanda Leza, <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />kabajisi chiimo chabukombi pesi kabakaka nguzu zyabo. Kubatantamuka bantu bali boobo. <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />Nkaambo akati kabo kuli baabo bayinka mumaanda kukweeneena banakazi bakompeme, balemedwe azibi akuleesegwa azisusi zyamubili. <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />Banakazi aaba balayiiya chiindi choonse pesi tabasiki kuluzibo lwakasimpe. <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" /><note caller="-" style="x"><char style="xo" closed="false">3:8. </char><char style="xt" closed="false"><ref loc="EXO 7:11">Kul 7:11</ref>.</char></note> Mbuli Janesi aJamburesi bakakazya Mozesi, aboobo alabo bantu aaba bakazya kasimpe, mbantu balamizeezo ikompeme alimwi lusyomo lwabo talugwasyi pe; <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />pesi tabakwe kuyoosika kule pe, nkaambo bufubafuba bwabo buyooba antanganana kuli boonse, mbuli kwakali bwabaalumi aabo babili.<verse eid="2TI 3:9" /></para>
  <para style="s">Malayilile Akumamanino</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />Lino wakatobelezya kuyiisya kwangu akupona kwangu akudunamina kwangu mubuumi alusyomo lwangu amoyo mulamfu aluyando lwangu akukakatila kwangu, <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" /><note caller="-" style="x"><char style="xo" closed="false">3:11. </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">Inch 13:14-52</ref>; <ref loc="ACT 14:1-20">Inch 14:1-20</ref>; <ref loc="ACT 16:1-5">16:1-5</ref>.</char></note>akupenzegwa kwangu amapenzi angu nzyakandiwida kuAntiyokki, akuIkkoniyamu akuLisitira, nkupenzegwa kuli biyeni nkundakakakatila; anukuti kuli nzyoonse Mwami wakandivuna. <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />Nichoonzyo aabo boonse bayanda kupona buumi bwabuLeza muli Kkirisitu Jesu bayoopenzegwa, <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />kakuli bantu babi abasikweena bayooyindilila, basikweena abasikweenwa. <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />Pesi mbuli nduwe, inkilila kunembo muli nchuwakayiiya anchuwakasyoma kapati, kuzi kuli ooyo nkwakachiyiiya <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />alimwi biyeni kuzwa kubuniini bwako ulaazi malembe asalala akonzya kukulayilila kulufutuko mukwiinda mulusyomo muliKkirisitu Jesu. <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />Woonse malembe akayoyelwa aLeza alimwi<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">Nikuba</char><char style="fq" closed="false">Woonse malembe akayoyelwa aLeza alimwi</char></note> alabeleka kukuyiisya akukukalalila akukululamika akukulayilila mubululami, <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />kuchitila kuti muntu waLeza azulile, alibambile nkaambo kamulimu mubotu woonse.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />Ndakulayilila kunembo lyaLeza alya Kkirisitu Jesu uyoobeteka bapona abafu, alimwi akuliboniya kwakwe abwami bwakwe, <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />kambawuka ijwi, ulibambile muchiindi cheelede amuchiindi chiteelede, ukombelezye, akukalalila akusungwazya, utakachilwi mukuba amoyo mulamfu amukulayilila. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />Nkaambo chiindi chiyobuza bantu nibayooleka kukakatila injiisyo yachoonzyo, pesi kabajisi matwi ayanda kuswiilila bayoobunganiya bayiisyi babo kuti kukeelele ziyandisyo zyabo, <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />alimwi bayooleya kukuswiilila kukasimpe akusweekela munjiisyo italuleme pe. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />Pesi mbuli nduwe, ulibatamike lyoonse, kakatila kupenzegwa, chita mulimu wabukambawusi bwamakani mabotu, uzuzukizye mulimu wako.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />Nkaambo ndili muchiimo chakubbomwedwa kale mbuli chipayizyo chakunywa; alimwi chiindi chakweenda kwangu chasika. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />Ndakalwana kulwana kubotu, ndakamanisya mwiindilano, ndakabamba lusyomo. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />Nkikaako ndibambidilwe musini wabusalali, ooyo Mwami, mubetesi ululeme, ngwayoondipa muBuzuba oobo, alimwi peepe kulindime luzutu pesi lubo akuli baabo boonse bakayanda kuliboniya kwakwe.<verse eid="2TI 4:8" /></para>
  <para style="s">Makani aPawulu Mwini</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />Sungwaala kuza kulindime akufwambana, <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />nkaambo Demasi, mukuyanda nyika eeyi yalino, wakandiloboka mpawo waya kuTesalonika; Kireseni wakaya kuGalatiya aTayitasi kuDalimatiya. <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />Lukku aliikke nguuli andime. Bweza Makko mpawo uze aawe; nkaambo uli alugwasyo lupati kumulimu wangu. <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />Tayikkikkasi ndakamutuma kuEfeso. <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />Nutazooze, weete chikobela nchindakasiila Kkapasi kuTuroyasi, alubo amabbuku, alimwi atala azyoonse kapati azikwiye.<verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />Alekizanda sikufula wakandichitila bubi bupati; Mwami uyoomuliya nkaambo kamilimu yakwe. <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />Umuchenjelele iwe lwako, nkaambo wakakazyana kapati amakani eesu.<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />Kukulikwabilila kwangu lutaanzi taakwe wakandigwasya pe; boonse bakandichija. Batapegwi mulandu atala anzizyo! <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />Pesi Mwami wakandiimikilila mpawo wakandipa nguzu zyakukambawuka makani mubuzwide, kuti boonse batali baJuda baamvwe. Aboobo ndakavunwa kuzwa kumulomo wamulavu. <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />Mwami uyoondivuna kububi boonse akunditola kubwami bwakwe bwakujulu kandilondokede. Kulinguwe ngakube bulemu lyoonse alyoonse. Ameni.<verse eid="2TI 4:18" /></para>
  <para style="s">Kujuzya Kwakumamanino</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />Ujuzye Purisikka aAkkwila aŋanda yaOnesiforasi. <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />Erasitasi wakachaala muKkorinte; Turofimasi ndakamusiya kachiswa kuMiletasi. <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />Weezye changuzu kuti usike kakutanasika mupeyo.</para>
  <para style="p" vid="2TI 4:21">Eyubbulasi ulamujuzya, mbumbubo aPudenzi aLinasi aKkilawudiya aboonse bakwesu.<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />Mwami abe amuuya wako.</para>
  <para style="p" vid="2TI 4:22">Luzyalo lube andinywe.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>