<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- 2 BATESALONIKA - Tonga Translation Project</book>
  <para style="h">2 BaTesalonika</para>
  <para style="toc1">Lugwalo LwachibiliLwaPawulu kuBaTesalonika</para>
  <para style="toc2">2 BaTesalonika</para>
  <para style="toc3">2 Tes</para>
  <para style="mt2">Lugwalo Lwachibili LwaPawulu Ku</para>
  <para style="mt1">BATESALONIKA</para>
  <para style="imt">Manjililo</para>
  <para style="ip">Lugwalo lwachibili kuBaTesalonika lwakalembwa aMutumwa Pawulu (2 BaTesalonika 1:1). Wakalemba lugwalo oolu muchiindi chifwiifwi naakamana lugwalo lwaBaTesalonika lutaanzi, mumunyaka wamakumi musanu alaamunyaka uumwi kaali Kkirisitu wazyalwa. Pawulu wakachili muKkorinte naakalemba lugwalo oolu kumbungano yakuTesalonika. Imbungano njakatalika kali mulweendo lwakwe lwakukambawuka kwachibili (Inchito 17:1-10). Mubbuku lyaInchito kwaambwa kuti imbungano eeyi yakali abaJuda bache abaGirikki bayingi.</para>
  <para style="ip">Imbungano yakuTesalonika yakajata kapati azyiindi zyakumamanino, akuboola kwaKkirisitu kwachibili, nkaambo Pawulu wakalemba zyiingi atala anzizyo mumagwalo aaya aabili ngaakalembela BaTesalonika. Chisela chalugwalo chaBaTesalonika bachibili kulembedwe azyamamanino azyiindi. Pawulu wakapa machenjezyo lubo atala abantu batolo. Muntu woonse weelede kubelekela chakulya chakwe (2 BaTesalonika 3:6-10).</para>
  <para style="iot">Bwiime</para>
  <para style="io1">Pawulu utalika lugwalo akulungununa lwakwe abasimulimunyina (2 BaTesalonika 1:1-2)</para>
  <para style="io1">Eelyo ulumba Leza ankaambo kambungano yamuTesalonika akubakombela (2 BaTesalonika 1:3-12)</para>
  <para style="io1">Muchaandano chachibili, Pawulu waambuula atala amamanino azyiindi.</para>
  <para style="io1">Eelyo waambuula atala abutolo abubotu bwakubeleka (2 BaTesalonika 3:1-15)</para>
  <para style="io1">Pawulu umanisya akujuzya imbungano lubo (2 BaTesalonika 3:16-18)</para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />Ime Pawulu aSilivanasi aTimoti,</para>
  <para style="p" vid="2TH 1:1">Kumbungano yakuTesalonika kuli bali muliLeza Taata wesu aMwami Jesu Kkirisitu:<verse eid="2TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2" />Luzyalo aluumuno luzwa kuli Leza Taata aMwami Jesu Kkirisitu lube kulindinywe.<verse eid="2TH 1:2" /></para>
  <para style="s">Lubeta Kukuboola KwaKkirisitu</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />Nibakwesu, tweelede kulumba Leza lyoonse ankaambo kanu, mbuli mbukweelede, nkaambo lusyomo lwanu luliikukomena kapati, alimwi luyando lwanu kuli umwi awumwi luliikuvuzyana. <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />Nkikaako iswe lwesu tulalikankayizya nkaambo kanu mumbungano zyaLeza ankaambo kakukakatila kwanu alusyomo mukupenzegwa kwanu koonse mumasukuusyo ngimuliikuswaniya.<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />Eechi nchichitondezyo chalubeta lusalala lwaLeza, kuti mukachitwe beelela mubwami bwaLeza, oobo mbumufwabila. <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />Leza uliluleme, nichoonzyo ulabweedezya amapenzi kuli baabo bamupenzya, <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />akupa kulyookezya kulindinywe nimupenzegwa akulindiswe lubo, eelyo Mwami Jesu nayooyubununwa kuzwa kujulu abaangelo bakwe basinguzu <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />mumabangabanga amulilo, uyoopa chisubulo kuli baabo batazi Leza, akuli baabo bataswiilili makani mabotu aMwami wesu Jesu. <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />Bayoopenzegwa achisubulo chakunyonyoonwa kwalyoonse akupambulwa kuzwa kunembo lyaMwami akuzwa kubulemu bwanguzu zyakwe, <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />nayoboola mubuzuba oobo kuti akalemekwe mubasalali bakwe, akugamba kuzwa kuli boonse basyoma, nkaambo bukamboni bwesu kuli ndinywe bwakasyomwa.<verse eid="2TH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11" />Ankaambo kacheechi tulamukombela lyoonse, kuti Leza wesu amuchite kuti mweelele kulwiito lwakwe, alimwi kuti anguzu zyakwe azuzikizye chiyandisyo chanu chazintu zibotu zyoonse akuzuzikizya milimu yanu yalusyomo, <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />kuchitila kuti zina lyaMwami wesu Jesu likapegwe bulemu mulindinywe, andinywe mulinguwe, mukwiinda kuluzyalo lwaLeza wesu aMwami Jesu Kkirisitu.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">Sikuchenga</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />Nibakwesu, lino atala akuboola kwaMwami wesu Jesu Kkirisitu akubunganisigwa kwesu kuti tukamutambule, tulamukumbila, <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />kuti mutafwambani kuyoowa nikuba kupengaana, nikuba amuuya nikuba ajwi, nikuba alugwalo lubaanga luzwa kulindiswe, lwaamba kuti buzuba bwaMwami bwasika. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />Kutabi nikuba muntu umweena nikuba munzila ilibiyeni; nkaambo buzuba oobo tabukwe kuyooza pe, kunze kwakuti mupapi akaze lutaanzi, alimwi muntu ukompeme ayubununwe, mwana walunyonyoono, <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />ukazya akulisumpula atala azintu zyoonse zitegwa leza nikuba chikombwa, kuchitila kuti akabweze chuuno chakwe muŋanda yaLeza, kalyaamba kuti nguLeza.<verse eid="2TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5" />Tamuyeeyina kuti nindakachili andinywe ndakamwaambila eechi? <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />Alimwi mulichizi eecho chilookumukasya lino kuchitila kuti akayubununwe muchiindi chakwe cheelede. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />Nkaambo nsiinswa yabukompami iliikubeleka kale; luzutu ooyo uyikasya lino uyoochita boobo mane akazwe munzila. <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />Eelyo alimwi ooyo mukompami uyooyubununwa, alimwi Mwami Jesu uyoomunyonyoona aluyooyo lwamulomo wakwe akumunyonyoona abulemu bwakuboola kwakwe. <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />Kuboola kwawukompeme amulimu waSatani kubelesya nguzu zyoonse azitoondezyo zyakulisumpula amalele, <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />alimwi alweeno loonse lwabubi lwabaabo bayoonyonyoonwa, nkaambo bakakaka kuyanda kasimpe alimwi kuti bafutulwe. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />Nkikaako Leza uyoobatumina nguzu zyalweeno, ziyoobachita kuti basyome zyakubeja, <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />kuchitila kuti boonse bakapegwe mulandu aabo batasyomede kasimpe pesi bakali kubotelwa mububi.<verse eid="2TH 2:12" /></para>
  <para style="s">Mwakasalilwa Lufutuko</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />Nibakwesu nimuyandwa aMwami, tweelede kupa kulumba kuli Leza lyoonse nkaambo kanu, Leza wakamusala kuzwa kumatalikilo kuti mufutulwe, mukwiinda mukusalazigwa aMuuya amukusyoma mukasimpe. <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />Kuli cheechi wakamwiita mukwiinda mumakani mabotu eesu, kuchitila kuti mukajane bulemu bwaMwami wesu Jesu Kkirisitu. <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />Nkikaako bakwesu, ngamwimikile nji mpawo mujatisisye kuziyanza nzitwakamuyiisya, nikuba ajwi lyamulomo nikuba alugwalo.<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />Lino Mwami wesu Jesu Kkirisitu lwakwe, aLeza Taata wesu, wakatuyanda aluzyalo lwakwe wakatupa kuumbuluzigwa kutamani abulangilizi bubotu, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />asungwazye myoyo yanu kumilimu yoonse mibotu njimuchita.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">Mutukombele</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />Nibakwesu, kumamanino, mutukombele, kuti ijwi lyaMwami lyeendelele kunembo chakufwambana akulemekwa, mbuli mbulyakachita akati kanu, <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />alimwi kuti tukavunwe kuzwa kubusofwazi abantu babi; nkaambo teesi boonse pe bali alusyomo.<verse eid="2TH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3" />Pesi Mwami ulisyomekede; uyoomusimya alimwi akumukwabilila kumubi. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />Alimwi tujisi busichaamba muMwami atala andinywe, kuti muliikuchita alimwi muyoochita zintu nzitumulayilila.<verse eid="2TH 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 3:5" />Mwami alulamike myoyo yanu kuluyando lwaLeza akukukakatila kwaKkirisitu.<verse eid="2TH 3:5" /></para>
  <para style="s">Inchenjezyo atala abutolo</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />Nibakwesu, lino tulamulayilila, muzina lyaMwami wesu Jesu Kkirisitu, kuti musosoloke kuzwa kumukwesu upona mubutolo amuli ziteendelani aziyanza eezyo nzimwakatambula kuzwa kuli ndiswe. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />Nkaambo inywe lwanu mulizi mbumweelede kutwiiya; teetwakali batolo pe nitwakali andinywe, <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />teetwakalya chakulya chawumwi katutaliyide pe, pesi twakabeleka amachise akuminwa sikati amansiku, kuti tutalemezyi naba umwi akati kanu. <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />Tatwaambi kuti tatukwe cheelelo kulugwasyo oolo, pesi twakamupa kuti kube chitondeezyo chakutobela. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />Nkaambo nikuba nitwakali andinywe, twakamupa mulayizyo ooyu: Kuti kufumbwa umwi utayandi kubeleka, atalyi.<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />Nkaambo tumvwa kuti bamwi akati kanu bapona mubutolo, batayandi kubeleka, kabayanda kunjilila mumilimu yabamwi. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />Lino bantu baliboobo tulabalayilila akusungwazya muMwami Jesu Kkirisitu kuti bachite mulimu wabo muchuumunizi akujana kupona kwabo.<verse eid="2TH 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13" />Pesi bakwesu, mutakatali pe kuchita kabotu. <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />Kuti umwi wakaka kuswiilila nzitwaamba mulugwalo oolu, mumuchenjelele muntu ooyo, alimwi mutabi achakwiita anguwe, kuti abe abweeme. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />Mutamulangi mbuli sinkondonyokwe pe, pesi mumuchenjezye mbuli mukwesu.<verse eid="2TH 3:15" /></para>
  <para style="s">Makani Akumamanisizyo</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />Lino Mwami waluumuno lwakwe amupe luumuno kuzyiindi zyoonse munzila zyoonse. Mwami abe andinywe moonse.<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />Ime, Pawulu, ndilemba injuzyo eeyi aluboko lwangu. Eechi niimpa mumagwalo aangu woonse; niinzila njindilemba aayo.<verse eid="2TH 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18" />Luzyalo lwaMwami wesu Jesu Kkirisitu lube andinywe moonse.<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>