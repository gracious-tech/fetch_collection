<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">-Tonga Translation Project</book>
  <para style="h">2 Joni</para>
  <para style="toc1">Lugwalo Lachibili Lwakalembwa aJoni</para>
  <para style="toc2">2 Joni</para>
  <para style="toc3">2 Jn</para>
  <para style="mt2">Lugwalo Lwachibili Lwa</para>
  <para style="mt1">JONI</para>
  <para style="imt">Manjililo</para>
  <para style="ip">
    <char style="bk">Lugwalo lwachibili lwaJoni </char> lwakalembwa amutumwa Joni akati kachiindi chamunyaka ilimakumi alimusanu kuyoosika kumwaanda Jesu kaali wazyalwa. Joni taliyubununi mbuli mulembi pe, anukuti ulyaamba kuti mwaalu. Eezyo zilimuli Joni wachibili zilikozyene azili mumakani mabotu aJoni. Eechi chili antanganana munzila njasinizya lulayo lwaJesu kukuyandana amunzila mbayelanisya kuyanda Jesu akutobela milayizyo yakwe (2 Joni 1:5-6, Joni 15:9-10). Kulasyomwa kuti Joni wakalemba makani mabotu mukwiinda muli Joni amumagwalo aatatu Joni mutaanzi, Joni wachibili, alimwi wachitatu kachikkala muEfeso.</para>
  <para style="ip">
    <char style="bk">Joni </char> ulemba lugwalo lwakwe kumwanakazi musale abana bakwe. Zikonzya kuti wakali kutondeka kumbungano. Joni wakalemba lugwalo oolu kuti asungwazye mbungano akubachenjezya atala abayiisyi babeji.</para>
  <para style="iot">Bwiime</para>
  <para style="io1">Joni upa manjililo alugwalo lwakwe akwaamba kuti ndulwani akujuzya basikulutambula (2 Joni 1:1-3)</para>
  <para style="io1">Eelyo usungwazya mbungano akubayeezya mulayizyo mupati loko (2 Joni 1:4-6)</para>
  <para style="io1">Chitobela uchenjezya atala abayiisyi babeji (2 Joni 1:7-11)</para>
  <para style="io1">Joni umanisya lugwalo lwakwe akweeta kujuzya kuzwa kubasyomi bamumbungano nkwakali kukkala (2 Joni 1:12-13)</para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />Kuzwa kuMwaalu.</para>
  <para style="p" vid="2JN 1:1">Kumwanakazi wakasalwa abana bakwe, aabo mbindiyandisya, alimwi peepe lwangu luzutu pesi aboonse bazi kasimpe, <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />ankaambo kakasimpe aako kakkalilide mulindiswe alimwi kayooba andiswe kwalyoonse.<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />Luzyalo, luse aluumuno luyooba andiswe, kuzwa kuli Leza Taata alimwi akuli Jesu Kkirisitu Mwana Mulombe waWisi, mukasimpe aluyando.<verse eid="2JN 1:3" /></para>
  <para style="s">Kasimpe Aluyando</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />Ndakabotelwa kapati kujana bamwi babana bako kabapona mukasimpe, mbuli mbutwakalayililwa aTaata. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />Alimwi lino ndakukumbila, yoomwanakazi, kutali kuti ndiliikukulembela mulawu mupya pe, pesi ooyo ngutwakalaawo kuzwa kumatalikilo, kuti tuyandane. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />Alimwi oolu nduluyando, kuti tutobele milawu yakwe, ooyu nguumulawu, mbuli mbumwakamvwa kuzwa kumatilikilo, kuti tupone muluyando.<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />Nkaambo basikuchenga bazula kale munyika, bantu batakwe kuyoozumina kuboola kwaJesu Kkirisitu mumubili, ooyo uli boobo ngusikuchenga alimwi ukazya Kkirisitu. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />Ngamulilingule, kuti mutasweekelwi nzimwakabelekela,<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">amwi malembe aamba kuti nzitwakabelekela</char></note> pesi kuti mukajane mpindu izulide.<verse eid="2JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9" />Kufumbwa uyinka anembo alimwi katakkalilili munjiisyo yaKkirisitu takwe Leza pe, ooyo ukkalilila munjiisyo ulaabo boonse Taata aMwana Mulombe. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />Kuti umwi waza kulindinywe alimwi katayeti eeyi njiisyo, mutamutambuli muŋanda nikuba kumujuzya, <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />nkaambo ooyo umujuzya, waabana mulimu wakwe mubi.<verse eid="2JN 1:11" /></para>
  <para style="s">Majwi Akumamanino</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />Nikuba kuti ndijisi zyiingi zyakumulembela, tandikwe kubelesya mulende apepa pe, pesi ndili abulangilizi bwakuza kuti ndizoomubone alimwi ndizoowambuule andinywe katulangene, kuchitila kuti lukondo lwesu lukazulile.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />Bana bamwananyokwe musale balakujuzya.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>