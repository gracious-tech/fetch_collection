<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- MAKKO - Tonga Translation Project</book>
  <para style="h">Makko</para>
  <para style="toc1">Makani Mabotu aKalembwa aMakko</para>
  <para style="toc2">Makko</para>
  <para style="toc3">Mkk</para>
  <para style="mt2">Makani Mabotu Akalembwa a</para>
  <para style="mt1">MAKKO</para>
  <para style="imt">Manjililo</para>
  <para style="ip">
    <char style="bk">Makani Mabotu akalembwa aMakko</char> ndimwi lyamabbuku aane muChizuminano Chipya apandulula atala abuumi bwaJesu Kkirisitu. Limwi alimwi liyiitwa kuti “makani mabotu,” chaamba kuti “makani mabotu.” Akalembwa aMateyu, Makko, Lukku aJoni kali wafwa Jesu. Makani Mabotu mukwiinda a<char style="bk">Makko </char> ndifwiifwi mumabbuku aane woonse amakani mabotu. Alubo kuli kusyoma kuti nditaanzi mulembwa kumakani mabotu woonse muchiindi chamunyaka ilimakumi alimusanu akkumi limwi aminyaka ili musanu kukuyosika kumakumi alimusanu amakumi abili Jesu kaliwazyalwa. Basikufunkununa bayiingi basyoma kuti lyakalembwa muRoma kakuli kuyandwa kusungilizya BanaKkiristu bakakkede mumo.</para>
  <para style="ip">
    <char style="bk">Makko </char>alubo kabamuzi kuti nguJoni Makko, wakali kweenda aamwi aMutumwa Pawulu aBbanabbasi pesi wakabatyoompa moyo nakachija mulimu waLeza (Inchito 13:13). Mukuya kwachiindi<char style="bk">Makko </char>wakazoyeenda lubo aamwi aBbanabbasi (Inchito 15:37-39). <char style="bk">Makko</char> bakalimuzi kali mweenzunyina uli afwiifwi loko aPita (1 Pita 5:13). Nikuba kuti <char style="bk">Makko</char> takali mukamboni wakabona buumi bwaJesu, basikufunkununa basyoma kuti <char style="bk">Makko</char> wakalemba bukamboni bwiingi bwaPita alimwi mpajana “Makani Mabotu” <char style="bk">Makko</char> ngakalemba. Mu “Makani Mabotu” aaya, <char style="bk">Makko</char> ulemba loko kalangene atala abasikwiiya anjisyo yaJesu kumazuba amamanino.</para>
  <para style="iot">Bwiime:</para>
  <para style="io1">Makko utupa manjililo abbuku muchandano (Makko 1:1-13)</para>
  <para style="io1">Eelyo Makko ulapandulula mulimu waJesu naakachili kuGalili muchandano (Makko 1:14—8:21)</para>
  <para style="io1">Chitobela waambuula atala alweendo lwaJesu kuJerusalemu (Makko 8:22—10:52)</para>
  <para style="io1">Makko usimpa bbuku akulemba atala aJesu chiindi naakali muJerusalemu, alimwi kabika amwi kufwa kwakwe akubuka kwakwe (Makko 11:1—16:8).</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Kukambawuka KwaJoni MuBbapatizi</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mateyu 3:1-12</ref>; <ref loc="LUK 3:1-18">Lukku 3:1-18</ref>; <ref loc="JHN 1:19-28">Joni 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Matalikilo amakani mabotu aJesu Kkirisitu, Mwana waLeza. <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />Mbuli mbukulembedwe mubbuku lyaAyizaya musinsimi kuti,</para>
  <para style="q1" vid="MRK 1:2">Leza wakati, ‘Ndiyootuma mutumwa wangu kunembo lyako,</para>
  <para style="q2" vid="MRK 1:2">uyoobamba nzila yako.’<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />Ijwi lya ooyo woompolola munkanda kaliti;</para>
  <para style="q2" vid="MRK 1:3">‘Amubambe nzila yaMwami,</para>
  <para style="q2" vid="MRK 1:3">mululamike nzila zyakwe!’ ”<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Ayizaya 40:3</char></note><verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />Joni mubbapatizyi wakaliboniya munkanda, kakambawuka lubbapatizyo lwakusanduka kwakulekelelwa kwazibi. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Alimwi bantu boonse bamuchilikiti chaJudiya abaantu boonse bamuJerusalem bakayiinka kulinguwe, kabalukuzumina zibi zyabo; mpawo John wakabbapatizigwa mumulonga waJorodani.<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />Joni wakali kusama zisamo zyaboya bwankamela, amukumba wachikwiye muchibuno chakwe, alimwi walikulya nsozi abuchi bwamugani. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Alimwi wakakambawuka, kaliikuti, “Musule lyangu kuzoosika umwi ulaanguzu kwiinda ndime, ooyu ulaansangu nzinditeeleli kutuntumanina akwaangununa. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Ndamubbapatizya ameenda, pesi uyoomubbapatizya aMuuya Usalala.”<verse eid="MRK 1:8" /></para>
  <para style="s">Kubbapatizigwa Akusunkwa KwaJesu</para>
  <para style="r">(<ref loc="MAT 3:13-4:11">Mateyu 3:13—4:11</ref>; <ref loc="LUK 3:21">Lukku 3:21</ref>,<ref loc="LUK 3:22">22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Mumazuba aayo Jesu wakaza kazwa kuNazareta yakuGalili alimwi wakabbapatizigwa aJoni mumulonga Jorodani. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Alimwi aawo naakazwa mumeenda, mpawawo wakabona ijulu kalijulikide aMuuya kuuselukila alinguwe mbuli nziba. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Alimwi ijwi lyakasika kuzwa kujulu kaliti, “Uli Mwana wangu ngundiyandisya; anduwe ndibotelwa loko.”<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Mpawawo Muuya wakamutola munkanda. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Alimwi wakali munkanda kwamazuba alimakumi aane, kaliikusunkwa aSatani, alimwi wakali aamwi abanyama bamusokwe; alimwi baangelo bakamukutawukila.<verse eid="MRK 1:13" /></para>
  <para style="s">Kwiitwa KwaBasikwiiya Bane</para>
  <para style="r">(<ref loc="MAT 4:12-22">Mateyu 4:12-22</ref>; <ref loc="LUK 4:14">Lukku 4:14</ref>,<ref loc="LUK 4:15">15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Lino Joni kali waangwa, Jesu wakaza muGalili, kakambawuka makani mabotu aLeza, <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />mpawo kalookuti, “Chiindi chazuzikizigwa, alimwi bwami bwaLeza buli afwiifwi; amusanduke alimwi musyome mumakani mabotu!”<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Alimwi Jesu naakalikweenda kumbali alwizi lwakuGalili, wakabona Sayimoni mukulana wakwe Enduru kabali kuwaala nsabwe mulwizi; nkaambo bakali bazubi babaswi. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Mpawo Jesu wakati kulimbabo, “Munditobele ndiyoomuchita basikuzuba bantu.” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Mpawawo bakasiya nsabwe zyabo alimwi bamutobela.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Alimwi naakaya kunembo buniini, wakabona Jakkobbu mwana waZebbedi aJoni mwanike wakwe, bakali mubwaato bwabo kababamba nsabwe zyabo. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Mpawawo wakabayita, mpawo bakasiya wisi Zebbedi mubwaato abalanda, mpawo bamutobela.<verse eid="MRK 1:20" /></para>
  <para style="s">Jesu Muuya Mubi</para>
  <para style="r">(<ref loc="LUK 4:31-37">Lukku 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Mpawo Jesu abasikwiiya bakwe bakaya muKkapenawumi; alimwi muzuba bwasabata nibwakasika Jesu wakanjila muchikombelo mpawo wayiisya. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Alimwi bantu bakamumvwa bakagamba kukuyiisya kwakwe, nkaambo wakabayiisya mbuli umwi wakalijisi ulabweendelezi, alimwi peepe mbuli bayiisyi bamulawu.<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />Eelyo kwakali mwaalumi muchikombelo chabo ooyo wakalinjidwe muuya mubi, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />alimwi wakoompolola wati, “Uyandaanzi kuli ndiswe, Jesu waNazareti? Sa wazida kutunyonyoona na? Ndilizi kuti nduweni, Usalala waLeza!”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Pesi Jesu wakamukalalila, kati, “Umuna, alimwi zwa mulinguwe!”<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />Mpawo muuya mubi, wakamuzazamya changuzu alimwi kakwiila ajwi pati, wazwa mulinguwe. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />Alimwi boonse bakagamba, mane bakabuzyaniya akati kabo kabati, “Niinzi eechi? Injiisyo mpya! Anguzu ulalayilila nikuba myuuya mibi, alimwi ilamuswiilila!”<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />Alimwi impuwo yakwe yakazulila chakufwambana koonsekoonse kumasena woonse azyungulukide Galili.<verse eid="MRK 1:28" /></para>
  <para style="s">Jesu Uponiya Bantu Bayiingi</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mateyu 8:14-17</ref>; <ref loc="LUK 4:38-41">Lukku 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Alimwi mpawawo Jesu abasikwiiya bakwe aamwi aJakkobbu aJoni nibakazwa muchikombelo, mpawo bakanjila kuŋanda yaSayimoni aEnduru. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Lino banyinazyala aSayimoni bakalilede bakali kukasala mubili, alimwi mpawawo Jesu bakamwaambila atala ambabo. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Alimwi wakaza, mpawo wabakajata aluboko, wabagwasya kunyampuka, kukasala kwamubili kwakamana, mpawo bakatalika kubakutawukila.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Goko eelyo, nilyakabbila zuba, bakamweetela boonse bakali kuchiswa nikuba bakalinjidwe abasikazwa. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Alimwi chisi choonse chakali bungene aamwi kunembo lyamulyango waŋanda. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Alimwi wakasilika bayingi bakali amalwazi asiyenesiyene, akutanda basikazwa bayiingi; alimwi taakali kuzumizya basikazwa kuti baambuule, nkaambo bakalimuzi.<verse eid="MRK 1:34" /></para>
  <para style="s">Jesu Ukambawuka MuGalili</para>
  <para style="r">(<ref loc="LUK 4:42-44">Lukku 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Alimwi chifumofumo, Jesu wakabuka wazwa muŋanda mpawo waya kubusena mbwaakakuba aliikke, alimwi ooko nkwakukomba. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Mpawo Sayimoni abaabo mbakalaabo bakazwa bakuyanduula Jesu, <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />alimwi bakamujana, mpawo bakati kulinguwe, “Boonse balookukuyanduula.”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Mpawo wakati kulimbabo, “Atwiinke kumyuunzi imwi izyungulukide, kuti tukakambawuke alako; nkaambo nchichicho nchindakazida.”<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />Alimwi wakayinka muGalili yoonse, kali kukambawuka muzikombelo zyabo akutanda basikazwa.<verse eid="MRK 1:39" /></para>
  <para style="s">Jesu Uponiya Mwaalumi Wakali aChipele</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mateyu 8:1-4</ref>; <ref loc="LUK 5:12-16">Lukku 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Alimwi sichipele wakasika kuli Jesu wamukumbila, alimwi kafugeme wakati kulinguwe, “Na koyanda, ulakonzya kundisalazya.”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Mpawo Jesu kazwide aluse, wakatandabika luboko lyakwe mpawo wamuguma, mpawo wati kulinguwe, “Ndilayanda, kusalala!” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Alimwi mpawawo chipele chakamana, mpawo wakasalazigwa. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Alimwi wakamulayilila chakusinizya, mpawawo wakeenda, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />mpawo Jesu wakati kulinguwe, “Ubone kuti taakwe kufumbwa nguwaambila pe, pesi kuya, ukalitondeezye kumupayizi, alimwi ukape chipayizyo eecho Mozesi nchakalayilila, mbuli bukamboni kubantu.”<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Pesi wakayinka mpawo wakatalika kubaambila kawangunukide, alimwi akumwaya milumbe, mane Jesu taakachili kukonzya pe kunjila mudolopo zili antanganana, pesi wakali kunze mumasena atakwe bantu; nikuboobo bantu bakaza kulinguwe kuzwa koonsekoonse.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Jesu Uponiya Mwaalumi Ulebukide</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mateyu 9:1-8</ref>; <ref loc="LUK 5:17-26">Lukku 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Nikwakayinda mazuba Jesu wakabweeda kuKkapenawumi, bantu bakamvwa kuti wakali muŋanda. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Alimwi bayingi bakali bungene aamwi, mane tekwakachili busena pe bwakali bwachala, nikuba afwiifwi amulyango; mpawo wakabakambawukila ijwi. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Mpawo baalumi bane bakasika kabanyampwide ulebukide, bakamweeta kuli Jesu. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Alimwi nibakakachilwa kumweeta afwiifwi anguwe nkaambo kakuvula kwankamu, bakagwisya chiluli; mpawo nibakajula, bakaselusya buyalangwe oobo mbwakalilede alimbubo ulebukide. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Alimwi Jesu naakabona lusyomo lwabo, wakati kuli ulebukide, “Mwanaangu, zibi zyako zyalekelelwa.”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Lino bamwi bayiisyi bamulawu bakalikkede mpawawo, kabaliyeeya lwabo kuti, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“Nkaamboonzi ooyu mwaalumi naambuula oobu? Ulikusampawula! Ngwani ukonzya kulekelela zibi pesi Leza aliikke?”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Mpawawo Jesu, kazi muMuuya wakwe kuti eechi nchiinchicho nchibaliikuyeeya, wakati kulimbabo, “Nkaamboonzi nimuyeeya zintu ziliboobu? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Nchiichili chuuba, kwaambila ulebukide kuti, ‘Zibi zyako zyalekelelwa,’ nikuba kwaamba kuti, ‘Buka, bweza buyalangwe bwako mpawo weende?’ <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Pesi kuti muzizibe kuti Mwana aMuntu ulaanguzu zyakulekelela zibi anyika.” Jesu wakati kuli ulebukide, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“Ndakwaambila, buka, bweza buyalangwe bwako mpawo uye kuŋanda.”<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />Mpawo wakabuka, wakabweza buyalangwe alimwi weenda kunembo lyabo boonse. Eechi chakabagambya boonse alimwi bakalumbayizya Leza, kabati, “Tatuna chibona pe chili mbuli eechi!”<verse eid="MRK 2:12" /></para>
  <para style="s">Kwiitwa KwaLevi</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mateyu 9:9-13</ref>; <ref loc="LUK 5:27-32">Lukku 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Alubo Jesu wakaya kumbali alwizi lyaGalili, mpawo wakabayiisya. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Alimwi naakali kuyobweenda, wakabona Levi mwana waAlifasi kakkede aŋanda yabasimutelo, alimwi wakati kulinguwe, “Nditobele.” Mpawo wakabuka wamutobela.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Alimwi naakalikkede kuliikulya muŋanda yakwe, basimutelo bayingi abasizibi bakalikkede aJesu abasikwiiya bakwe; nkaambo bakali bayingi bakamutobela. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Alimwi bayiisyi bamulawu bakali baFarisi, nibakabona kuti uliikulya abasizibi abasimutelo, bakati kuli basikwiiya bakwe, “Nkaamboonzi nalya abasimutelo abasizibi?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Alimwi Jesu naakachimvwa eechi, wakati kulimbabo, “Aabo balikabotu tabayandi musilisi, pesi aabo bachiswa, teendakazida basalali pe, pesi basizibi.”<verse eid="MRK 2:17" /></para>
  <para style="s">Mubuzyo Atala aKulyiimya</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mateyu 9:14-17</ref>; <ref loc="LUK 5:33-39">Lukku 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Lino basikwiiya baJoni abaFarisi bakali kulyiimya; mpawo bantu bakaza kulinguwe kabati, “Nkaamboonzi basikwiiya baJoni abasikwiiya babaFarisi nibalyiimya, pesi basikwiiya bako tabalyiimyi pe?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Alimwi Jesu wakati kulimbabo, “Ngabalalyiimya biyeni basikutambwa kupobwe lyakukwatana, sikukwata kabali aawe? Kufumbwa kabachili aamwi asikukwata, tabakonzyi pe kulyiimya. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Mazuba ayoosika, aawo sikukwata nayootolwa, alimwi eelyo bayoolyiimya mubuzuba oobo.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />Taakwe naba umwi usuma chigamba chipya achisamo chikulukulu, kuti wachita oobo, chigamba chiladeluka kuzwa kulinchicho, chipya kuzwa kuchikulukulu, alimwi chilayindilila kudeluka. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Alimwi taakwe kufumbwa utila wayini mupya mumunkuli mukulukulu; kuti wachita oobo, wayini ulabbalula munkuli, mpawo wayini ulatika, alimwi wayini amunkuli ulanyonyooka; pesi wayini mupya ngwamunkuli mupya.”<verse eid="MRK 2:22" /></para>
  <para style="s">Mubuzyo Atala aSabata</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mateyu 12:1-8</ref>; <ref loc="LUK 6:1-5">Lukku 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Muli imwi Sabata Jesu abasikwiiya bakwe nibakali kuyabweenda mumyuunda yamayila; basikwiiya bakwe bakatalika kupulula mayila. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Alimwi baFarisi bakati kulinguwe, “Laanga, nkaamboonzi basikwiiya bako nibaliikuchita zitali mumulawu musabata?”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Mpawo wakati kulimbaabo, “Tee mwakabala na eezyo Devidi nzyakachita, naakabula akuba aanzala, we abaabo mbaakali aabo, <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />ambakanjila muŋanda yaLeza, aawo Abbiyata nakali Mupayizi Mupati, mpawo wakalya chinkwa chisalala, chitazumizigwi kufumbwa uumwi kunze kwabapayizi kuti balye, alubo wakachipa kuli aabo mbaakali aabo.”<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Mpawo wakati kulimbaabo, “Sabata lwakachitilwa muntu, peepe muntu kuSabata; <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />aboobo Mwana aMuntu nguMwami nikuba waSabata.”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Mwaalumi Wakali Aluboko Lulebukide</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mateyu 12:9-14</ref>; <ref loc="LUK 6:6-11">Lukku 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Alubo Jesu wakanjila muchikombelo, mpawo kwakali mwaalumi wakanyanide luboko nkuko. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Bamwi baabo bakali kuyandula kaambo, kuti kujana ulamuponiya na mubuzuba bwaSabata, kuchitila kuti bamupe mulandu. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Mpawo Jesu wakati kumwaalumi wakanyanide luboko, “Kuza okuno.” <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Mpawo wakati kulimbabo, “Chili mumulawu naa kuchita chibotu na chibi muSabata, kufutula buumi na kujaya?”</para>
  <para style="p" vid="MRK 3:4">Pesi bakawumunisya. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />Alimwi wakabalanga boonse chakunyema, kawuside nkaambo kakuyuma kwamyoyo yabo, mpawo wakati kumwaalumi ooyo, “Tandabika luboko kwako.” Walutandabika, mpawo luboko lwakwe lwakalulamikwa. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />BaFarisi bakazwa kunze, mpawo bakabungana abankamu itegwa baHerodi nkaambo kakwe, kabali kuyanduula kuti balamujaya biyeni.<verse eid="MRK 3:6" /></para>
  <para style="s">Makamu Atobela Jesu</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Jesu wakazwa abasikwiiya bakwe baya kulwizi lwaGalili, mpawo nkamu mpati izwa kuGalili yakamutobela, alubo kabazwa kuJudiya, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />amuJerusalema aIdumiya akuzwa kunembo aJorodani, azyeengelede Taya aSidoni ankamu mpati, kaliikumvwa eezyo zyoonse nzyakachita, wakaza kulinguwe. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Alimwi wakaambila basikwiiya bakwe kuti bamubambile bwaato nkaambo kankamu, kuti ngabalamusyanikizya. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Nkaambo Jesu wakali waponiya bayiingi, aboobo bakali amalwazi bakalikuchundana kabaya kunembo kuti bamugume. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Alimwi kufumbwa myuuya mibi niyakali kumubona, bakali kuwida aansi kunembo lyakwe alimwi kabakwiila kabati, “Nduwe Mwana waLeza.”<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />Alimwi wakabalayilila changuzu kuti itaambili muntu atala anguwe.<verse eid="MRK 3:12" /></para>
  <para style="s">Jesu Usala Batumwa Balikkumi Ababili</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mateyu 10:1-4</ref>; <ref loc="LUK 6:12-16">Lukku 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Mpawo wakatanta achilundu, alimwi wakayita aabo mbakalikuyanda; mpawo bakaza kulinguwe. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Alimwi wakasala balikkumi ababili, aabo mbakayiita kuti mbatumwa kuti babe anguwe, alimwi kuti abatume kuti bakakambawuke, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />akuti babe abweendelezi bwakutanda myuuya mibi:<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />Aaya ngiimazina abaabo mbakasala, Sayimoni ooyo ngwakati nguPita, <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Jakkobbu aJoni bana baZebbedi, (aabo bana mbaakati mbaaBboyanejizi, chaamba kuti, “Bana bandabe”); <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />Enduru, aFilipu, aBbatolomewu, aMateyu, aTomasi, aJakkobbu mwana waAlifasi, aTediyasi, aSayimoni muKkenani, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />aJudasi Isikkariyoti, sikumwaaba.<verse eid="MRK 3:19" /></para>
  <para style="s">Jesu aBbelizabbelu</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mateyu 12:22-32</ref>; <ref loc="LUK 11:14-23">Lukku 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Mpawo Jesu wakaya kumuunzi. Alimwi nkamu mpati yakamubungana, zyakuti Jesu abasikwiiya bakwe teebakakonzya pe kulya. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Alimwi bampuli yakwe nibakachimvwa, bakayinka kuyoomubweza, nkaambo bantu bakali kuti, “Wapenga!”<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Mpawo bayiisyi bamulawu bakazwa kuJerusalemu bakati, “Unjidwe Bbelizabbali, alimwi amwami wamyuuya mibi utanda myuuya mibi.”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Alimwi Jesu wakabayita, mpawo wakaambuula kulimbabo muzikozyanisyo kati, “Satani ulakonzya biyeni kutanda Satani? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Kuti bwami bwapambukana abulikke, bwaami oobo tabukonzyi kwimikila. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Alimwi kuti mpuli yapambukana, eeyo mpuli tayikonzyi kwimikila pe. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Alimwi naa Satani walikazya mwini alimwi kapambukene, takonzyi kwimikila, pesi ulasika kumamanino.<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />“Pesi taakwe ukonzya kunjila muŋanda yamwaalumi singuzu akunyanzya lubono lwakwe, kunze akuti atalike kwaanga mwaalumi singuzu, eelyo nichoonzyo ulakonzya kubba.<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />“Kasimpe, ndamwaambila, zibi zyoonse ziyoolekelelwa bana bamuntu, alimwi kufumbwa kusampawula nkubachita; <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />pesi kufumbwa usampawula Muuya Usalala takonzyi kulekelelwa pe, pesi ulaamulandu wachibi chitamani.” <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />nkaambo bakaamba kuti, “Ulaa muuya mubi.”<verse eid="MRK 3:30" /></para>
  <para style="s">Bayina aJesu Abanike Bakwe</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mateyu 12:46-50</ref>; <ref loc="LUK 8:19-21">Lukku 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Mpawo banyina Jesu abanike bakwe bakasika; alimwi kabayimvwi anze bakatuma umwi kuti amwiite. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Alimwi nkamu yakamubunganina; mpawo bakati kulinguwe, “Banyoko, bakulana abanike bako balaanze, baliikukulanguula.”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Wakabavwiila wati, “Mbaani baama abakwesu bangu?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Alimwi kalanga aabo bakakkede kabamuzyungulukide, wakati, “Mbaba baama abakwesu! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Kufumbwa uuchita kuyanda kwaLeza nguumwanike wangu, amuchizi, abaama.”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Mukozyano Wasikumiza</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mateyu 13:1-9</ref>; <ref loc="LUK 8:4-8">Lukku 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Alubo Jesu wakatalika kuyiisya kumbali alwizi lwaGalili. Alimwi nkamu mpati yamuzyungulukide mane wakanjila mubwaato, mpawo wakkala muli mbubo nkali mulwizi, alimwi inkamu yoonse yakali kunkomwe yalwizi. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Alimwi wakabayiisya zintu zyiingi muzikozyanisyo, kati kulimbabo,<verse eid="MRK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3" />“Amuswiilizye! Sikuminza wakayinka kukumiza. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Alimwi aawo naakali kumiza mbuto, imwi yakawida munzila, mpawo tuyuni twakasika twiilya. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Imwi mbuto yakawida amwaala, aawo atakwe muse myiingi, alimwi mpawawo yakamena, mbukunga takwe niyakali amuse unikide; <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />mpawo izuba nilyakabala yakawumpwa, mbukunga teyakali amiyanda pe yakayuma. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Imwi mbuto yakawida akati kamaamvwa, mpawo maamvwa akakomena akuyisyanikizya, alimwi teeyakazyala pe. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Alimwi imwi mbuto yakawida mumuse mubotu mpawo yakamena yakomena yakazyala, mpawo imwi yakazyala makumi aatatu imwi yakazyala makumi alimusanu akkumi alimwi imwi mwaanda.”<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Alimwi Jesu wakati, “Ooyo ulaamatwi akumvwa, ngamvwe!”<verse eid="MRK 4:9" /></para>
  <para style="s">Mulimu Wachikozyano Eechi</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mateyu 13:10-17</ref>; <ref loc="LUK 8:9">Lukku 8:9</ref>,<ref loc="LUK 8:10">10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Alimwi Jesu naakaba aliikke, abaabo mbaakali aabo abalikkumi ababili bakabuzya atala azikozyanisyo. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Alimwi wakati kulimbabo, “Kulindinywe kulipedwe insiinswa yaBwami bwaLeza. Pesi kulibaabo balikunze zyoonse zili mumikozyanisyo, <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />kuchitila kuti,</para>
  <para style="q1" vid="MRK 4:12">‘Lyoonse kababona</para>
  <para style="q2" vid="MRK 4:12">pesi kabatabonesesyi pe,</para>
  <para style="q1" vid="MRK 4:12">alimwi ngabalamvwa</para>
  <para style="q2" vid="MRK 4:12">pesi kabatamvwisisisyi;</para>
  <para style="q1" vid="MRK 4:12">ambweni balasanduka lubo,</para>
  <para style="q2" vid="MRK 4:12">akulekelelwa.’ ”<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">Ayizaya 6:9-10 </char></note><verse eid="MRK 4:12" /></para>
  <para style="s">Jesu Upandulula Mukozyano Wasikumiza</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mateyu 13:18-23</ref>; <ref loc="LUK 8:11-15">Lukku 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Alimwi Jesu wakati kulimbabo, “Tamuliikumvwisisisya na chikozyanisyo eechi? Eelyo muyozimvwisisisya biyeni zikozyanisyo zimwi zyoonse? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Sikumiza umiza ijwi. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Bamwi bantu bali mbuli mbuto eeyo bakawida munzila, aawo ijwi mpulyakamizwa; nibamvwa, mpawo Satani ulasika mpawo aawo wabweza ijwi lyakamizwa muli mbabo. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Bamwi bantu bali mbuli mbuto eeyo yakawida amwaala, mbaabo, nibamvwa ijwi, mpawo aawo balalitambula chakukondwa; <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Alimwi tabajisi muyanda mulimbabo, pesi ilapona kwakayindi kaniini; eelyo, kuti masukuusyo nikuba kupenzegwa kwasika ankaambo kajwi, mpawo aawo balafwambana kuwa. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Bamwi balimbuli mbuto yakawida mumaamvwa mbaabo bamvwa ijwi, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />pesi zisusi zyanyika, alukondo lyabuvubi, aziyandisyo zimwi, zilanjila akuzyasyanikizya ijwi, zilachita kuti batazyali michelo. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Pesi bamwi bali mbuli mbuto yakamizwa mumuse mubotu, mbaabo baamvwa ijwi akulitambula akuzyala michelo, ilimakumi aatatu, ayilimakumi musanu akkumi limwi aliyimwaanda.”<verse eid="MRK 4:20" /></para>
  <para style="s">Chimwinikisyo aChibikilo Chalyo</para>
  <para style="r">(<ref loc="LUK 8:16-18">Lukku 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Mpawo Jesu wakati kulimbabo, “Sena chimwinikisyo nga chileetwa mpawo kuti mulitibbike alusuwo, na kulibika muchinkuma chabulo peepe achibikilo chimwinikisyo? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Nkaambo takukwe chisisidwe, kuunze akuti chayubununwa; takwe nikuba chisisidwe, kuunze cheetwa antanganana. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Naakuti kufumbwa muntu kajisi matwi akumvwa, ngamvwe!”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Mpawo Jesu wakati kulimbabo, “Ngamuchenjele kulizezyo nzimumvwa. Mweelo ngumupa ngunguwo ngumuyoojana, ambubo mbumuyopegwa. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Nkaambo kuli ooyo uujisi uyoopegwa zyiindilide; alimwi kuli ooyo uutajisi, nikuba eezyo nzyalaazyo uyoonyanzigwa.”<verse eid="MRK 4:25" /></para>
  <para style="s">Mukozyanisyo Wambuto Ikomena</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Alimwi Jesu wakati, “Bwami bwaLeza buli mbuli muntu wamiza mbuto aanyika, <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />mpawo uloona akubuka mansiku asikati, ambuto ilatunga akukomena, takwizi pe kuti zichitika biyeni. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Inyika lyayo ichita kuti imbuto ikomene mpawo izyale michelo, lutaanzi munsonga, kakutobela miyungi mane miyungi yatuba. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Pesi kuti mayila atuba, mpawawo ulabelesya kafulo, nkaambo chiindi chakutebula chasika.”<verse eid="MRK 4:29" /></para>
  <para style="s">Chikozyanisyo Chambuto Niini Loko</para>
  <para style="r">(<ref loc="MAT 13:31">Mateyu 13:31</ref>,<ref loc="MAT 13:32">32</ref>,<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18">Lukku 13:18</ref>,<ref loc="LUK 13:19">19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Alimwi Jesu wakati, “Tulabukonzyanisya aanzi bwami bwaLeza, nikuba kuti tubelesye chikozyanisyoonzi alimbubo? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Buli mbuuli inseke yambuto niini, nimbuuto niini loko kumbuto zyoonse zili anyika; <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Pesi niyabyalwa ilakomena mpawo inga yakomena kwiinda ziteyo zyoonse, kilaamitabi mipati, kuchitila kuti bayuni bamumulengalenga bakonzye kuyaka zisaba mumweenzule yazyo.”<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Azikozyanisyo zyiingi ziliboobu wakaambula ijwi kulimbaabo, mbuuli mbubakali kukonzya kulimvwa. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Taakwe nakaambula pe kulimbaabo katabelesezye chikozyanisyo, pesi mukavwiindi kuli abasikwiiya bakwe wakapandulula zyoonse.<verse eid="MRK 4:34" /></para>
  <para style="s">Jesu Wuumuzya Guwo</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mateyu 8:23-27</ref>; <ref loc="LUK 8:22-25">Lukku 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Mubuzuba oobo nilyakaba goko, Jesu wakati kulimbaabo, “Atuzubuke tuye mutala.” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Alimwi wakasiya makamu, bakamubweeza banjila aawe mubwaato, mbuli mbwakalibede. Alimwi aambi maato akali anguwe. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Mpawo iguwo pati lyakanyamuka, alimwi mayuwe akanjila mubwaato, kusikila bwaato bwakali bwamba kuzula. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Pesi Jesu wakali musule abwaato, kalede amuchego; alimwi bakamubusya mpawo bati kulinguwe, “Omuyiisyi, tulikataazyi na kuti tuliikunyonyooka?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Mpawo wakabuka walayilila iguwo, mpawo wati kulwizi, “Umuna! Batama!” Alimwi iguwo lyakabatama, mpawo kwakaba luumuno lupati. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Wakati kulimbabo, “Nkaamboonzi nimuyoowa? Tamujisi lusyomo na?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Alimwi bakalizwide kuyoowa, mpawo bakati kuli umwi awumwi, “Ngwani lino ooyu, nikuba iguwo alwizi zilamuswiliila?”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">Jesu Uponiya Mwaalumi Ulamyuuya Mibi</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mateyu 8:28-34</ref>; <ref loc="LUK 8:26-39">Lukku 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Eelyo Jesu abasikwiiya bakwe bakayiinka mutala eliya yalwizi, kunyika yabaGerasenesi. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Alimwi Jesu naakazwa mubwaato, wakaswaniya mwaalumi wakazwa kuzibuunda wakala muuya mubi, <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Mwaalumi ooyu wakali kukkala kuzibumda; alimwi takukwe wakali kukonzya kumwaanga pe, nikuba anketani. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Chiindi chiingi wakali kunoonga waangwa anketani kumaboko akumawulu, pesi nketani walizidunsula, alimwi zyakumawulu wakali kuzidunsula; alimwi takwe wakajisi nguuzu zyakumuzunda. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Sikati amansiku akati kazibuunda alimwi aziluundu wakali kulila choonse chiindi, mpawo kali kuli chudulula amabwe.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Alimwi nakabona Jesu kulaale, wakachijana mpawo wakafugama, <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />alimwi kalokoompolola ajwi pati, wakati, “Ulaanzi atala andime, Jesu, Mwana aLeza Usumpukide? Ndakukumbila aLeza, utandipenzyi.” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Nkaambo wakali wati kulinguwe, “Kuzwa kumwaalumi ooyu, iwe muuya mubi!”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Alimwi Jesu wakamubuzya wati , “Nduweni izina lyako?”</para>
  <para style="p" vid="MRK 5:9">Wakavwiila wati, “Izina lyangu ndime Ligiyoni; nkaambo tuli bayiingi.” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Alimwi Ligiyoni wakali kunoonga kakumbila Jesu kapati kuti atabatandili kunze abusena.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Lino butaanga lupati lwangulube lyakali kuchela kumbali achilundu, <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />alimwi yakamukumbila kuti, “Alimwi myuuya mibi yakamukumbila kuti, “Tutandile mungulube, atunjile muli nzizyo.” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Aboobo wakazizumizya kuti zyeende. Mpawo myuuya mibi yakazwa, mpawo yanjila mungulube; alimwi butanga bwangulube bwakali kunoba zyuulu zibili, zyakakunuka chakufwambana kunkomwe yalwizi, mpawo zyanikila mulwizi.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Bembeli bakachija, alimwi bakwaambila bali muchisi amunyika. Alimwi bantu bakaza kukuzoboona eecho chakali chachitika. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Alimwi bakaza kuli Jesu, mpawo bakaboona wakali amyuuya kakkede awo, kazweete alimwi kaluleme, mwaalumi wakali aligiyoni; alimwi bakayoowa. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Alimwi aabo bakaziboona bakaamba zyakachitika kuli ulamyuuya mubi akungulube.<verse eid="MRK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17" />Alimwi bakatalika kumukumbila Jesu kuti ayeende kuzwa mubusena bwabo.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Mpawo nakali kunjila mubwaato, mwaalumi wakali njidwe myuuya mibi wakamukumbila kuti aabe aawe.<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />Pesi wakakaka, alimwi wakati kulinguwe, “Kuuya kuŋanda kumpuli yakulindinywe, mpawo ukabaambile eezyo Mwami nzyakuchitila, mpawo anzila njakufwida sule.”<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />Alimwi wakeenda mpawo wakatalika kwaamba muDikkapolisi (Madolopo alikkumi) eezyo Jesu nzyakamuchitila aayo; alimwi bantu boonse bakagambwa.<verse eid="MRK 5:20" /></para>
  <para style="s">Mwana Musimbi WaJayirasi aMwanakazi Wakaguma Chikobela ChaJesu</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mateyu 9:18-26</ref>; <ref loc="LUK 8:40-56">Lukku 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Alimwi aawo Jesu kali wataluka lubo mubwaato mutala, inkamu mpati yakamuzyungulukila; alimwi wakali kumbali alwizi. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Eelyo kwakaza umwi mupati wachikombelo, izina lyakwe nguJayirasi; alimwi nakamubona, wakawida kumawulu aJesu, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />alimwi wakamukumbila, kati, “Mwanaangu musimbi muniini wabaachimo chakufwa. Kuuza alimwi uzomubike maboko, kuchitila kuti aabe kabotu, mpawo apone.”<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />Alimwi Jesu wakeenda aawe. Mpawo inkamu mpati yakamutobela mpawo bakamusyanikizya koonsekoonse.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Alimwi kwakali mwanakazi wakala kalobola kwaminyaka ilikkumi ayibili, <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />alimwi wakali wafwaaba kukuyandula kusilikwa kubasilisyi bayiingi, alimwi wakali wabelesya zyoonse zyakajisi, mpawo takwe nakapona pe pesi zyakali kwinkilila anembo. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Wakamvwa impuwo atala aJesu, mpawo wakaza kuzwa kusule lyakwe munkamu alimwi wakajata chisamo chaJesu. <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />Nkaambo wakati, “Kuti nindajata chisamo chakwe, ndilapona.”<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />Mpawaawo kalobola kakamana; alimwi wakamvwa mumubili wakwe kuti wapona kuzwa kubulwazi oobu. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Alimwi Jesu wakamvwa kuti inguzu zyazwa mulinguwe, mpawawo wakachengunukila kunkamu, mpawo wati “Ngwani wajata zisamo zyaangu?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Alimwi basikwiya bakwe bakati kulinguwe, “Ulibwene inkamu mbilikusyanikizyaniya alinduwe, alwimi ulikuti, ‘Ngwani wandijata?’ ”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Alimwi wakalangalanga kaliikuyanduula kuti abone kuti ngwani wazichita.<verse eid="MRK 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 5:33" />Pesi mwanakazi, kazi zyakachitwa kulinguwe, wakasika mukuyoowa akukankama mpawo wawida kunembo lyakwe, alimwi wamwaambila kasimpe koonse. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Mpawo wakati kulinguwe, “Musimbi, lusyomo lwako lwakuponiya; kuya muluumuno mpawo upone mubulwazi bwako.”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Naakachili kwambuula, kwakaza bazwa kuŋanda yamweendelezi wachikombelo kati, “Mwana aako musimbi wafwa. Nkaamboonzi nuchipenzya Muyiisi?”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Pesi taakaswiilizya pe nzibakaamba, Jesu wakati kumweendelezi wachikombelo, “Utayoowi, syoma biyo.” <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Alimwi taakwe ngwakazumizya pe kuti bamutobele kunze kwa Pita aJakkobbu aJoni mwanike waJakkobbu. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Nibakasika kunganda yamweendelezi wachikombelo, wakabona lupyopyongano, alimwi bantu kabalila akoomoka kupati. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Alimwi naakanjila, wakati kuli mbabo, “Nkaamboonzi nimulila akoomoka? Mwana tafwide pe pesi uliikoona.”<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />Mpawo bakamuseka. Pesi wakabaandila aanze boonse, mpawo wakayita wisi amwana abanyina abaabo mbakali aabo, mpawo banjila omo mwana mwakalibede. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Naakamubweza aluboko wakati kuli nguwe, “Talita kkumi” chaamba kuti, “Kasimbi, ndati kuli nduwe, buka.”<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />Alimwi mpawo aawo musimbi wakabuka mpawo weenda, (wakali aminyaka ilikkumi ayibili yakuzyalwa), alimwi bakazula kugambwa. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Alimwi wakabalayilila kuti kutabi umwi uziba eechi, mpawo wakabaambila kuti bamupe chakulya.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">Jesu Ulakakwa KuNazareti</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mateyu 13:53-58</ref>; <ref loc="LUK 4:16-30">Lukku 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Jesu wakazwa aawo mpawo wakaya kunyika yakulimbabo; abasikwiiya bakwe bakamutobela. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Mpawo muSabata wakatalika kuyiisya muchikombelo; alimwi bantu bayiingi bakamumvwa bakagamba, kabaamba kuti,</para>
  <para style="p" vid="MRK 6:2">“Ooyu mwaalumi wakazijana kuli zintu zyoonse eezi? Mbusongoonzi mbwapedwe? Mulimu mupati ulibuyeni uchitwa amaboko akwe! <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Tee nguumubezi na ooyu, teensi mwana waMeri na alimwi tee mukulana waJakkobbu aJozefu aJudasi aSayimoni, bachizi bakwe tee aabo mbitulaabo aano na?” Mpawo bakamupa mulandu.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />Alimwi Jesu wakati kulimbaabo, “Musinsimi takwe bulemu muchisi chakwe, akati kanzubo zyakwe, abaŋanda yakwe.” <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />Takwe kuyookonzya pe kuchita mulimi mupati, kunze kwakubika maboko atala abantu bache bachiswa akubaponiya. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Alimwi wakagamba nkaambo kakubula lusyomo kwabo.</para>
  <para style="s" vid="MRK 6:6">Jesu Utuma Basikwiiya Balikkumi aBabili</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">Mateyu 10:5-15</ref>; <ref loc="LUK 9:1-6">Lukku 9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">Alimwi wakali kuya buyiisya mumyuunzi. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />Mpawo wakayita kulinguwe balikkumi ababili, mpawo wakatalika kubatuma babilibabili, mpawo wakabapa nguzu atala myuuya mibi. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Wakabalayilila kuti batabwezi chintu mulweendo lwabo; peepe chakulya, nikuba chikwama, nikuba mali mumikumba yabo, kunze amusako; <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />pesi amusame nsangu alimwi mutabwezi zisamo zibili. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Mpawo wakati kulimbaabo, “Oomo mumuyoonjila muŋanda, mukakkale mumo mane mukazwe dolopo oobo. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Alimwi naa busena tee bwamutambula pe nikuba kuleka kumumvwa, nimutakuzwe, mukakunkumune lusuko luli kumawulu aanu bukabe bukamboni alimbabo.”<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Aboobo bakazwa mpawo baakukambawuka kuti bantu beelede kusanduka. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Alimwi bakatanda basikazwa bayiingi, mpawo bakabananika bayiingi mafuta aabo bakalikuchiswa alimwi bakabaponiya.<verse eid="MRK 6:13" /></para>
  <para style="s">Kufwa KwaJoni Mubbapatizyi</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mateyu 14:1-12</ref>; <ref loc="LUK 9:1-9">Lukku 9:1-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Mwami Herodi wakamvwa atala acheechi; nkaambo izina lyaJesu lyakali lyazibikana. Bamwi bakati, “Joni muBbapatizyi wabusigwa kuzwa kubafu; nkikaako nguzu eezi zilikubeleka mulinguwe.”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Pesi bamwi bakati, “NguElayija.”</para>
  <para style="p" vid="MRK 6:15">Alimwi bamwi bakati, “Musinsimi, mbuli uumwi wabasinsimi bachiindi.”<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Pesi Herodi naakachimvwa eechi wakati, “Joni, ooyo ngundakadyunkula mutwe, wakabusigwa kuzwa bafu!” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />Nkaambo Herodi wakali watuma kuti bajate Joni, alimwi bakamwaanga bamubikka muntolongo nkaambo kaHerodiyasi, mwanakazi wamukulana wakwe Filipu; nkaambo wakali wamukwata. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Nkaambo Joni wakali wati kuli Herodi, “Tachili mumulawu pe kuti ukwate mwanakazi wamukulana wako!”<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />Aboobo Herodiyasi wakali antiili anguwe, alimwi wakali kuyanda kumujeya. Pesi tee wakakonzya pe, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />nkaambo Herodi wakali kuyoowa Joni nkaambo wakalizi kuti muntu ululeme kali musalali, alimwi wakamubaamba kabotu. Naakamumvwa, wakapengana, alimwi kali wakamumvwa chakukondwa.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Pesi mweenya wakaba aawo Herodi naakachita pobwe lyakuzyalwa kwakwe kubapati babeendelezi abasilutwe babasilumamba, abazulwidi babantu muGalili. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Aawo mwana musimbi waHerodiyasi naakanjila mpawo wazyana, wakabotezya Herodi abeenzu bakwe;</para>
  <para style="p" vid="MRK 6:22">mpawo mwami wakati kumusimbi, “Ndikumbile kufumbwa nchuyanda, alimwi ndilakupa nchicho.” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Mpawo wakamusyomezya achikonke wati, “Kufumbwa nchuyoondikumbila, ndiyookupa, nikuba chisela chabwaami bwangu!”<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Alimwi wakeenda, mpawo waakuti kuli banyina, “Ndikakumbileenzi?”</para>
  <para style="p" vid="MRK 6:24">Mpawo wakavwiila wati, “Mutwe waJoni muBbapatizi.”<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Mpawaawo wakanjila chakufwambaana kumwami akukumbila, kati, “Ndiyanda kuti undipe mutwe waJoni linoobu mundido!”<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Mpawo mwami wakawusa chakwiindilila; nkaambo kachikonke chakwe abeenzu bakwe teewakayanda kutyola chizuminano chakwe pe. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Alimwi mpawaawo mwami wakatuma mulindizi wabasilumamba mpawo wamulayilila kuti akeete mutwe waJoni. Wakayinka mpawo waakumudunsula mutwe muntolongo; <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />mpawo wakeeta mutwe waJoni mundido, alimwi wakapa musimbi; mpawo musimbi wakapa bayina. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Basikwiiya baJoni nibakamvwa atala anchicho, bakaza mpawo babweza mutunta wakwe, alimwi bakubamba muchibunda.<verse eid="MRK 6:29" /></para>
  <para style="s">Jesu Usanina Zyuulu Zilimusanu Zyabantu</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mateyu 14:13-21</ref>; <ref loc="LUK 9:10-17">Lukku 9:10-17</ref>; <ref loc="JHN 6:1-14">Joni 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Batumwa bakabweeda kuli Jesu mpawo bamwaambila zyoonse nzibakachita akuyiisya. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Nkaambo bayingi bakalikuza alimwi kabeenda, mpawo wakati kulimbabo, “Amweende kubusena busitikide, mpawo mukalyookezye buniini.” nkaambo teebakali achiindi chakulyookezya pe nikuba kulya.<verse eid="MRK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32" />Aboobo bakanjila mubwaato bazubuka baya kubusena busitikide abaliikke. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Pesi bantu bayingi bakababona kabeenda, alimwi bakali bazi, mpawo bakachijaana amawulu kuzwa mumadolopo woonse, alimwi bakabayindila kusika kubusena oobo. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Jesu kachiya bweenda kunkomwe wakabona nkamu mpati yabantu, wakabafwida luzyalo, nkaambo bakali mbuli mbelele zitakwe mweembeli. Mpawo wakatanguna kubayiisya zintu zyiingi.<verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />Lino muchiindi eechi lyakali lyabagoko, eelyo basikwiiya bakwe bakaza kulinguwe. Bakati, “Okuno mbusena busitikide, alubo lyamba kubbila kale. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Mwayiisya bantu aaba baye mumyuunzi izyungulukide nyika eeyi bakalyulile chakulya.”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Pesi Jesu wakabavwiila wati, “Mubape chintu chimwi chakulya.”</para>
  <para style="p" vid="MRK 6:37">Bakati kulinguwe, “Ziyanda makkobili alimyaanda iibili yamali!<note caller="+" style="f"><char style="fr" closed="false">6:37 </char><char style="ft" closed="false">Ikkobili limwi lyakali mpindu yamuntu uumwi abuzuba </char></note> Tubelesye mali iilibobu na kuti tuule chakulya tubape balye?”<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />Wakababuzya wati, “Mujisi zinkwa zingee? mwiinke mukalange.”</para>
  <para style="p" vid="MRK 6:38">Nibakalanguula bakati, “Tujisi zinkwa zilimusanu abaswi babili.”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Eelyo Jesu wakalayilila basikwiiya kuti baambile bantu boonse kuti bakkale muzibunga zibunga abwizu butete. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Mpawo bakakkala aansi muzibunga zyamyaanda azibunga zyamakumi musanu <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Jesu wakabweza zinkwa zilimusanu abaswi babili mpawo wakalanga kujulu, wakapa kulumba eelyo wakakwamuna zinkwa, mpawo wakapa basikwiiya bakwe kuti baabile bantu. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Bakalya boonse mpawo bakkuta, <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />alimwi basikwiiya bakabwezelela bufwefwelenga bwazinkwa abaswi bwakachala bazuzya zisuwo zilikkumi azibili <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Imweelwe wabaluumi bakalya wakali kusika kuzyuulu zili musanu.<verse eid="MRK 6:44" /></para>
  <para style="s">Jesu Uleenda Atala Ameenda</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mateyu 14:22-33</ref>; <ref loc="JHN 6:15-21">Joni 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Mpawawo Jesu wakaambila basikwiiya bakwe kuti banjile mubwaato batunge nembo kukuya mutala alwizi kuBbetisayida, naakachala kali wakamwayisa bantu. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Eelyo naakabalaya, wakaya kuchilundu kuti akakombe.<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />Lino nilyakaba goko, abwaato bwakali akati kalwizi, mpawo wakachaala alikke kunze alwizi. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Wakabona basikwiiya kabalokuzundaana chabuyumuyumu kukuyamba abwaato, nkaambo muuwo wakabalwanisya. Achiindi chakubuchedo wakeenda atala ameenda, kaya kulimbabo. Wakali waamba kubayinda kumbali. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Pesi nibakamubona keenda atala alwizi, bakayeeya anga ncheelo, bakakwiila, <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />nkaambo boonse nibakamubona bakayoowa.</para>
  <para style="p" vid="MRK 6:50">Mpawawo Jesu wakati kulimbabo, “Mujate moyo! Ndime, mutayoowi pe.” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Eelyo wakanjila mubwaato ambabo, mpawo muuwo wakamana. Bakagamba loko, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />mbukunga teebakamvwisisisya pe atala amalele azinkwa; nkaambo mizeezo yabo yakali kujatila kule.<verse eid="MRK 6:52" /></para>
  <para style="s">Jesu Uponiya Bantu Bachiswa MuGenesareti</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mateyu 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Jesu aBasikwiiya nibakazubukila lwizi, bakasika kunyika kuGenesareti ooko kubakanga bwaato kunkomwe yalwizi. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Nibakachili kuzwa biyo mubwaato bantu bakamuziba Jesu mpawawo. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Bakachijaana muchisi choonse alimwi bakanyampula bachiswa abuyalagwe akubatola ooko kufumbwa nkubakamvwa kuti nkwabede. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />kufumbwa kumyuunzi nkwakali kuya, kumadolopo akumasena oonse, bakali kubikka bachiswa kuzisambalilo. Bakamukumbila kuti bagume moombe wachisamo chakwe, alimwi kufumbwa boonse bakaguma bakaponesegwa.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Injisyo yaBamataata</para>
  <para style="r">(<ref loc="MAT 15:1-9">Mateyu 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Bafarisi abamwi bayiisyi bamulawu bakali bazwa kuJelusalemu bakabunganina Jesu, <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />bakabona bamwi basikwiiya bakwe kabaliikulya chakulya amaboko “atasalali,” nkukuti, atasambide zyeendelana achiyanza chabo.<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />(Bafarisi abaJuda boonse tabalyi chakulya kabatasambide maboko aabo pe, mbuli ziyanza zyaabamataata. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Nibazwa kuzisambalilo tabalyi pe kunze akuti basambe maboko aabo. Balabamba azimwi ziyanza zyiingi, zili mbuli kusanzya nkomechi, nongo zyameenda azilongo.)<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Aboobo bafarisi abalembi bamulawu bakabuzya Jesu bati, “Nkaamboonzi basikwiiya bako nibatalondoli ziyanza zyabamataata, balalya amaboko atasalali?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Jesu wakabavwiila wati, “Isaya wakali kwaamba kabotu naakasinsima atala andinywe nibasikuupawupa; mbuli mbukulembedwe kuti,</para>
  <para style="q1" vid="MRK 7:6">‘Aaba bantu bandilemeka amilomo yabo,</para>
  <para style="q2" vid="MRK 7:6">pesi myoyo yabo ilikule andime.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Bandikomba chabiyo, injiisyo zyabo milawu yanjiisyo zyabantu!’<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false">Iyizaya 29:13 </char></note><verse eid="MRK 7:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8" />Mwakaleka milawu yaLeza, mpawo mwajatisisya kuziyanza zyabantu.”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Mpawo wakamba kuti kulimbabo, “Mujisi nzila inembene yakusunzulusya mulawu waLeza akuubikka ambali kuti mulondole kabotu ziyanza zyanu. <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Mozesi wakati, ‘Lemeka wuso abanyoko,’ alimwi, ‘Kufumbwa muntu utukila wisi abayina, weelede kujeegwa.’ <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Pesi nywe mulati na muntu waamba kuli wisi abayina, kuti kufumbwa zilibiyeni nzimwaleelede kugwasigwa kulindime ngu ‘Kkobbani’ (nkukwaamba kuti, nchipo chaLeza), <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />eelyo mutamuzumizyi kuti achite chimwi chintu kuli wisi nibaba bayina. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Aboobo mulalobya ijwi lyaLeza nkaambo kaziyanza zyanu nzimwakabamba. Alimwi mulachita zintu zyiingi zili mbuli eezyo.”<verse eid="MRK 7:13" /></para>
  <para style="s">Zintu Zisofwazya Muntu</para>
  <para style="r">(<ref loc="MAT 15:10-20">Mateyu 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Eelyo Jesu wakayita makamu abantu wati, “Amundiswiilizye moonse mumvwisisisye eechi. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Taakwe chili kunze amuntu chikonzya ‘kumusofwaazya’ kuti chanjila mulinguwe. Pesi chisofwaazya muntu ncheecho chizwa mukati mumoyo wamuntu ‘nchiimusofwaazya.’ <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />Kufumbwa muntu ulaa matwi akumvwa ngamvwe.”<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Jesu kali wasiya makamu abantu wakunjila muŋanda, mpawo basikwiiya bakwe bakamubuzya atala achikozyano eechi. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Wakati kulimbabo, “Anu mulibafubafuba na? Tamubwene na kuti taakwe chinjila mumuntu chili kunze chinga chilamusofwaazya, <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />mbukunga tachinjili mumoyo wakwe pesi mubula biyo, mpawo chazwa aanze.” (Mukwaamba oobu, Jesu wakasalazya zyakulya zyoonse.)<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Wakeendelela anembo kaamba kuti, “Chizwa mumuntu nchiichita kuti asofwaale. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Nkaambo mukati, kamyoyo yabantu, muzwa mizeezo mibi, buyangwe, kubba, bujayi, bwaamu, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />butangazu, luuni, lweeno, malali, ibbivwe, kusinga, kulipunayizya abufubafuba. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Zibi eezi zyoonse zizwa mumoyo nzisofwaazya muntu.”<verse eid="MRK 7:23" /></para>
  <para style="s">Lusyomo LwaMwanakazi</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mateyu 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Jesu wakasiya busena oobo akuya kuchilikiti chaTaya. Wakanjila muŋanda alimwi teewakayanda kuti naba uumwi muntu azibe kuti mpali, nikuba boobo wakakachilwa kuyuba. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Mpawawo umwi mwanakazi wakali amwana wakalinjidwe muuya mubi, naakamvwa biyo atala aJesu wakaza wawida kumawulu aakwe. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Mwanakazi ooyo wakali wamusyobo wabaGilikki wakazyalilwa kuSayilofonisiya. Wakakumbila Jesu kuti atande muuya mubi uzwe kumwana wakwe musimbi.<verse eid="MRK 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27" />Jesu wakati kulinguwe, “Lutaanzi leka bana balye zyoonse nzibayanda, nkaambo tachili chibotu pe kubweza chakulya chabana mpawo usoweele bankala.”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />Wakamuvwiila wati, “Iiyi Mwami, pesi alabo bankala balabwezelela bufwefwelenge bulosegwa abana munsi lyatebuli!”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Mpawo wakamwaambila kuti, “Mbwasandula oobo, kuya biyo, muuya mubi wazwa kale mumwana wako musimbi!”<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Eelyo wakabweeda kuŋanda wajana mwana ulilede abulo, muuya mubi kuuli wazwa kale.<verse eid="MRK 7:30" /></para>
  <para style="s">Jesu Uponesya Musinkematwi KaliSyataambi</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Eelyo Jesu wakazwa kuchilikiti chaTaya wakeenda wayinda muSidoni, kaya kulwizi lwaGalili mpawo wanjila muchisi chaDekkapolisi chamadolopo alikkumi. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Ooko, bamwi bantu bakamweetela mwaalumi musinkematwi kalisyataambi, mpawo bakamukumbila kuti amubikke luboko lwakwe amuponesye.<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />Eelyo wakamugwisya mubantu bayiingi wamutola kumbali, Jesu wakamunjizya minwe mumatwi. Mpawo Jesu wakaswida wadompa lulimi lwamwaluumi ooyo. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Mpawo wakalungumana walanga kujulu, mukweefula kupati wakati kulinguwe, “Efata!” (nkukwaamba kuti, “Sinkuka”).<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />Nizyakachitwa eezi mwaalumi oolya wakasinkuka matwi aakwe, lulimi lwakwe lwakaangunuka mpawo watalika kwaambuula kabotu.<verse eid="MRK 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36" />Eelyo Jesu wakabalayilila kuti, bataambili bantu, pesi naakali kubalayilila oobu, bantu nibakayindilila loko kwaambuula azyakachitika. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Bantu bakazula kugamba kabaamba kuti, “Uchita kabotu loko muzintu zyoonse, Uchita basinkematwi kuti bamvwe aabo syataambi kuti baambuule.”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Jesu Usanina Zyuulu Zyone Zyabantu</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mateyu 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Mumazuba aayo imwi nkamu mpati yakabungana. Mbukunga teebakali akulya pe, Jesu wakiita basikwiiya bakwe eelyo wakati, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“Ndabaaluse abantu aaba, baba amazuba aatatu kabala andime alimwi kabatakwe chakulya. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Kuti ndababweedezya kumyuunzi yabo anzala, bayoosuntuka munzila, nkaambo bamwi babo bazwakule.”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Alimwi basikwiiya bakwe bakavwiila bati, “Pesi nkokuuli munkanda iloobu nkutunga tuyookonzya kujana chakulya chizulila bantu boonse aaba?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Jesu wakabuzya kuti, “Mujisi zinkwa zingene?”</para>
  <para style="p" vid="MRK 8:5">Bakamuvwiila bati, “Zilimusanu azibili.”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Wakaambila makamu kuti akkale aansi. Naakabweza zinkwa zilimusanu azibili wakalumba, wakwamuuna wapa basikwiiya bakwe kuti baabile bantu, mpawo bakachita oobo. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Bakalaabaswi bache buyo abalo; alimwi wakalumba kuli Leza waambila basikwiiya bakwe kuti baabile bantu. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Eelyo bantu bakalya bakkuta. Nibakamana basikwiiya bakabwezelela zisuwo zilimusanu azibili zyabufwefwelenga bwakachaala. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Lino bakaliwo bakali baalumi bakalikukonzya kuba zyulu zine. Jesu wakabamwayisya <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />alimwi mpawawo wanjiila mubwaato abasikwiiya bakwe wakusika kuchilikiti chaDalamanuta.<verse eid="MRK 8:10" /></para>
  <para style="s">Bafarisi Bakumbila Chigambyo</para>
  <para style="r">(<ref loc="MAT 16:1-4">Mateyu 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Lino bamwi Bafarisi bakasika kabalikukazyaniya awe. Bakatalika kumusunka Jesu kabayanduula chitondeezyo chizwa kujulu. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Jesu wakawuusa kapati mpawo wati, “Nkaamboonzi zyalane eeli niliyanduula chitondeezyo? Ndamwaambila kasimpe tachiwo chitondeezyo chiyoopegwa zyalane eeli.”<verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />Mpawo wakabasiya, wanjila mubwaato waya mutaleeliya.<verse eid="MRK 8:13" /></para>
  <para style="s">Bumena BwabaFarisi abwaHerodi</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mateyu 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Basikwiiya bakwe bakali baluba kuza azinkwa, kunze achinkwa chomwe luzutu nchibakali aacho mubwaato. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Lino Jesu wakabachenjezya wati. “Ngamuchenjele bumena bwaBafarisi abwaHerodi.”<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Eelyo bakayiizya akati kabo kabati, “Waamba oobu nkaambo tatukwe chiinkwa pe.”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Jesu kazi nzibakali kwiizya, wakati kulimbabo:“Nkaamboonzi nimulokwambuula ataala akubula chinkwa? Tamuna bona pe nekuba kumvwisisya? Mizeezo yanu ijatila kule na? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Mulijisi meso, tamuboni na? Amatwi mulijisi tamumvwi na? Alubo tamuyibalukwi na? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Nindakakwamuna zinkwa zilimusanu kuli balizyuulu zilimusanu, nzingee zisuwo zwabufwefwelenga nzimwaka bunganiya?”</para>
  <para style="p" vid="MRK 8:19">Bakamuvwiila bati, “Ikkumi azibili,”.<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />“Nindakakwamuna zilimusanu azibili kuli bali zyulu zine, nzingaana zisuwo zyabufwefwelenga nzimwaka bunganiya?”</para>
  <para style="p" vid="MRK 8:20">Bakamvwiila bati, “Musanu azibili.”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Wakati kulimbabo, “Alino tamuna mvwisisisya pe?”<verse eid="MRK 8:21" /></para>
  <para style="s">Jesu Usilika Mwaalumi Moofu Kubusena BwaBbetisayida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Eelyo Jesu abasikwiiya bakwe nibakasika kuBbetisayida, alimwi bamwi bantu bakeeta mwaalumi moofu mpawo bakakumbila Jesu kuti amugume. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Aboobo Jesu wakabweza mwaalumi moofu aluboko wamutola anze amuunzi. Lino naakaswida mumenso amwaalumi wakabika maanza alinguwe, Jesu wakabuzya wati, “Kuli nchubwene na?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Lino wakalanga kujulu wati, “Ndibwene bantu; kabali mbuli misamu yeenda.”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Jesu wakamubika lubo maboko kumeso aakwe. Eelyo imeeso aakwe akajulika, wakabona, alimwi wakabona oobotu. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Jesu wakati, “ Kuya kuŋanda, pesi utabwedi mumuunzi.”<verse eid="MRK 8:26" /></para>
  <para style="s">Pita Mbwaamba Atala aJesu</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mateyu 16:13-20</ref>; <ref loc="LUK 9:18-21">Lukku 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Jesu abasikwiiya bakwe bakaya kumyuunzi iili afwiifwi abusena butegwa Sizariya Filipi. Nibakali kuyoobwenda munzila wakabuzya kulibasikwiiya wati, “Bantu bati ndimeni?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Bakamuvwiila bati, “Bamwi bati nduwe Joni muBbapatizyi; bamwi bati Elayija; awalo bamwi, bati uli uumwi wabasinsimi.”<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />Wakati, “Anu nywebo? Muti ndiime ni?”</para>
  <para style="p" vid="MRK 8:29">Pita wakavwiila wati, “Nduwe Kkirisitu.”<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />Jesu wakabachenjezya wati, “Mutabuzyi bantu atala andime.”<verse eid="MRK 8:30" /></para>
  <para style="s">Jesu Upandulula Atala Amapenzi Alufu Lwakwe</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mateyu 16:21-28</ref>; <ref loc="LUK 9:22-27">Lukku 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Eelyo Jesu wakatalika kubayiisya kuti Mwana waMuntu uyoopenzegwa muzintu zyiingi eelyo uyookakwa abaalu, abapayizi bapati abayiisyi bamulawu, nkabela weelede kuti ajeegwe, kwakwiinda mazuba aatatu akakubuke lubo. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Wakaambuula antanganana, atala azeezi, eelyo Pita wakamutola Jesu kumbali awalo watalika kumukalalila.<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />Aawo Jesu naakachebuka wakalanga kuli basikwiiya bakwe. Wakakalalila Pita wati, “Zwaa kusule lyangu, Satani! Tukwee muzeezo wamabaambe aLeza, pesi mizeezo yabantu!”<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Eelyo Jesu wakayiita nkamu antoomwe abasikwiiya bakwe wati, “Na muntu kayanda kunditobela, weelede kulitakata abweze chiingano chakwe anditobele. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Nkaambo uyanda kuyobola buumi bwakwe bulamusweekela, pesi ooyo uusweekelwa buumi bwakwe nkaambo kangu amakani mabotu uyoobuyobola. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Nkaambo chigwasyaanzi kuti muntu ajane nyika yoonse, pesi wasweekelwa buumi bwakwe? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Nkaambo nchichiili muntu nchaakonzya kupa kuti ajane buumi bwakwe? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Na muntu kafwa bweeme atala andime ajwi lyangu muleeli zyalane lyabwaamu abubi, Mwana waMuntu uyomufwida bweeme nayooza mubulemu bwaWisi antoomwe abaangelo basalala.”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Alimwi wakati kulimbabo, “Ndamwaambila kasimpe, bamwi bayiimvwi aano tabakoyoofwa kabatana kubona Bwami bwaLeza kabuza anguzu.”<verse eid="MRK 9:1" /></para>
  <para style="s">Kusanduka KwaJesu Atala Achilundu</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mateyu 17:1-13</ref>; <ref loc="LUK 9:28-36">Lukku 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Nikwakayinda mazuba alimusanu alimwi Jesu wakabweza Pita, Jakkobbu aJoni wayiinka aabo kuchilundu chilamfu, ooko nkubakali abaliikke. Nibakali nkuko Jesu wakasanduka kunembo lyabo, <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />zisamo zyakwe zyakanjenjema kazituba buu, taakwe sikusapa waansi aano ukonzya kuzitubya mbubo pe. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Mpawawo kwakaliboniya anembo lyabo Elayija aMozesi, kabali kwaambuula aJesu. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />Pita wakati kuli Jesu, “Muyiisyi, nchibotu kuti tube aano. Ngatuyake zitumba zitatu, chimwi chako, chimwi chaMozesi achaElayija.” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Pita wakabula zyakwaamba, nkaambo bakali baankamana.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Eelyo joba lyakabavumba, ijwi lyakazwa mujoba kaliti, “Ooyu Mwana wangu, ngundiyanda. Amumuswiilile!” <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />Mpawawo, nibakalangalanga, taakwe uumbi ngubakabona wakalaabo kunze kwaJesu luzutu.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Nibakali kuseluka kuzwa kuchilundu, Jesu wakabalayilila kuti bataambili nikuba uumwi muntu eezyo nzibakabona mane Mwana waMuntu akabuke kubafu. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Bakakasisa kaambo mumyoyo yabo, kababuzyaniya kuti, “Kubuka kubafu chaambayi?” <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />Eelyo bakabuzya kulinguwe bati, “Nkaamboonzi bayiisyi bamulawu nibamba kuti Elayija uleelede kutalika kuza?”<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Jesu wakavwiila wati, “Ninchoonzyo, Elayija uyootalika kuza, alimwi azoobweedezye zintu mbuli mbuzyakabede. Nkaamboonzi nikulembedwe kuti Mwana waMuntu weelede kuti apenzegwe akutakatwa? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Pesi ndamwaambila kuti, Elayija wakasika kale, bakachita zyoonse nzibakalikuyanda, mbuli mbukulembedwe atala anguwe.”<verse eid="MRK 9:13" /></para>
  <para style="s">Kusilikwa Kwamulombe Wakalinjidwe Amuuya Mubi</para>
  <para style="r">(<ref loc="MAT 17:14-21">Mateyu 17:14-21</ref>; <ref loc="LUK 9:37-43">Lukku 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Alimwi Jesu, Pita, aJakkobbu, aJoni nibakasika kuli bamwi babasikwiiya, bakabona nkamu mpati yabantu kiibazyungulukide, abayiisyi bamulawu kabaliikukazyaniya ambabo. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Muchiindi bantu nibakaboona Jesu, bakagamba chakwiindilila, bakamuchijaanina kuyoomujuzya. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Wakababuzya wati, “Niinzi nchimuliikukazyaniya ambabo?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Mwaalumi wakali munkamu yabantu wakavwiila wati, “Muyiisi, ndakweetela mwanaangu, uujiswi muuya wasyataambi uchita kuti ataambuli pe. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Naa zyamubukila mwanaangu, nga wamusuntula. Umugwisya fulo kumulomo, akuluma ntwinyo mpawo ingawayuma chwa. Ndabakumbila basikwiiya bako kuti buutande muuya pesi taakwe nibakonzya pe.”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Jesu wakavwiila wati, “Inywee nimulizyalane litasyomi, ndeelede kukkala chiindi chilamfu biyeni anywebo? Kuyooba lili kandimuchitila moyo mulamfu. Mweete mulombe ooyo kulindime.” <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Lino bakamweeta kuliJesu.</para>
  <para style="p" vid="MRK 9:20">Muuya nuwakabona Jesu, mpawawo wakasuntula mulombe wamuzazamya chabukali. Wakawida aansi wabumbuluka, wazwa fulo mumulomo. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />Jesu wakabuzya kuliwisi wamulombe wati, “Wabaachiindi chilibiyeni kaliboobu?</para>
  <para style="p" vid="MRK 9:21">Wakasandula wati, Kuzwa kubuniini bwakwe,” <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />“Chiindi chiingi ukkala kuumuwisizya mumulilo nikuba mumeenda kuuyanda kumujeya. Kuti kukonzya kuchita chintu, kutufwida luse utugwasye!”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Jesu wakati, “Waambaanzi, kuti nkuti kukonzya kuchita chintu? Zyoonse zilakonzeka naa kusyoma.”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Mpawawo wisi wamulombe wakoompolola wati, “Ndasyoma; ndigwasye ndizunde kutasyoma kwangu!”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Jesu naakabona nkamu yabantu kabalookuchijanina kuli ooyu mulombe, wakulayilila muuya mubi, wakati, “Iwe nomuuya wakutamvwa asyataambi, ndakulayilila, ndati zwaa mulinguwe utabooli lubo.”<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Muuya wakakwiila, wakamuzazamya changuzu wazwa. Mwana mulombe wakalangika anga mutunta zyakuti bantu bayiingi bakati, “Wafwa.” <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Pesi Jesu wakamujata kuboko wamwiimikizya amawulu aakwe, mpawo mulombe wakayiimikila.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Jesu naakanjila muŋanda, basikwiiya bakwe bakamubuzya chakumbali bati, “Nkaamboonzi nitwakachilwa kuutanda muuya mubi?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />Wakabavwiila wati, “Musyobo wamuuya uliboobu uzwa akukomba luzutu.”<verse eid="MRK 9:29" /></para>
  <para style="s">Jesu Waambuula Atala Alufu Lwakwe Lubo</para>
  <para style="r">(<ref loc="MAT 17:22">Mateyu 17:22</ref>,<ref loc="MAT 17:23">23</ref>; <ref loc="LUK 9:43-45">Lukku 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Jesu abasikwiiya bakwe bakazwa kubusena oobo mpawo bayinda mumunzi waGalili. Jesu takayanda kuti kube nikuba uumwi uziba eechi, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />nkaambo wakali kuyiisya basikwiiya bakwe. Wakati kulimbabo, “Mwana waMuntu uyoowabwa mumaanza abantu. Bayoomujeya, nikwakwiinda mazuba ataatu uyoobuka kubafu.”<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />Pesi taakwe nibakamvwisisisya nzyaakalikwaamba pe alimwi bakayoowa kubuzya atala anzizyo.<verse eid="MRK 9:32" /></para>
  <para style="s">Ngwani Mupati?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mateyu 18:1-5</ref>; <ref loc="LUK 9:46-48">Lukku 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Jesu abasikwiiya bakwe bakasika kubusena butegwa Kkapenawumi. Naakanjila muŋanda wakabuzya wati, “Niinzi nzimwali kukazyaniya atala anzizyo munzila?”<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />Pesi bakawumuna nkaambo munzila bakali kukazyaniya atala akuti ngwani mupati akati kabo. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />Nibakakkala aansi, Jesu wakayita basikwiiya bakwe balikkumi ababili wati, “Naa umwi kayanda kuba mutaanzi, weelede kuba wakumamaninizyo, kali mulanda waboonse.” <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />Wakabweza mwana muniini wamwiimikizya akati kabo. Wakamubukata mumaanza aakwe, wakati kulimbabo, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“Kufumbwa ooyo utambula umwi wabana baniini muzina lyangu watambula ndime; eelyo kufumbwa utambula ndime tatambuli ndime pesi ooyo wakandituma.”<verse eid="MRK 9:37" /></para>
  <para style="s">Ooyo Utatulwani Aswebo Ulaaswebo</para>
  <para style="r">(<ref loc="LUK 9:49">Lukku 9:49</ref>,<ref loc="LUK 9:50">50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Joni wakati, “Muyiisyi, twabona mwaluumi katanda myuuya mibi muzina lyako mpawo twamwaambila kuti aleke nkaambo teewesu pe.”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Jesu wakavwiila wati, “Mutamukasyi pe, taakwe uuchita chigambyo muzina lyangu mpawo aambuule bubi atala andime. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Nkaambo ooyo utalwani aswebo ulaaswebo. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Ndimwaambila kasimpe, kufumbwa uyoomupa meenda akunywa muzina lyangu nkaambo muli bangu takoyoosweekelwa bulumbu bwakwe pe.<verse eid="MRK 9:41" /></para>
  <para style="s">Uuchita Umwi Kuti Abisye</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mateyu 18:6-9</ref>; <ref loc="LUK 17:1">Lukku 17:1</ref>,<ref loc="LUK 17:2">2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“Kufumbwa muntu uuchita kuti umwi wabaaba baniini basyoma kulindime babisye, chili mbubo kuti aangwe ziyo munsingo yakwe mpawo awaalilwe mulwizi. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Naakuti kuboko kwako kukupa kuti ubisye, kugonke. Chili mbubo kuti ukanjile mubuumi butamani kutakwaako kwiinda kuti ube amaboko abili ukaye kubbila lyamulilo litamani, <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" /><note caller="+" style="f"><char style="fr" closed="false">9:44 </char><char style="ft" closed="false">amwi malembe alaembedwe kuti, ‘ooko mvwinyu zyabo nkuzitafwi.’ </char></note> <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Alimwi na chituta chako kachikupa kuti ubisye, chigonke. Chili mbubo kuti ukanjile mubuumi butamani kolemene kwiinda kuti ube azituta zibili ukawaalilwe mubbila lyamulilo, <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" /><note caller="+" style="f"><char style="fr" closed="false">9:46 </char><char style="ft" closed="false">amwi malembe alaembedwe kuti, ‘ooko mvwinyu zyabo nkuzitafwi.</char></note> <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Na iliso lyako kalikupa kuti ubisye, linonkole. Chili mbubo kuti ukanjile kubwaami bwaLeza kulaaliso limwi kwiinda kuti ube ameso abili alimwi ukawaalilwe mubbila lyamulilo, <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />ooko mvwinyu zyabo nkuzitafwi.<note caller="+" style="f"><char style="fr" closed="false">9:48 </char><char style="ft" closed="false">Iyizaya 66:24</char></note><verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />Muntu woonse uyoosunkwa amulilo.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />“Munyo mubotu, pesi kuti wasampuka, kujana wuuchita buti kuti ube amuya lubo?</para>
  <para style="p" vid="MRK 9:50">“Amube munyo mulindinywe, alimwi mube aluumuno akati kanu.”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Jesu Uyiisya Atala Makani Akulekana</para>
  <para style="r">(<ref loc="MAT 19:1-12">Mateyu 19:1-12</ref>; <ref loc="LUK 16:18">Lukku 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Jesu wakazwa kubusena oobo mpawo waya kuchilikiti chitegwa Judiya wakazubukila mutala amulonga utegwa Jorodani. Aboobo nkamu yabantu yakaza kulinguwe, wakabayiisya mbuli mbaakali kuchita lubbe.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Bamwi baFarisi bakaza kukumusunka akubuzya mibuzyo kabati, “Chili mumulawu na kuti mwaalumi aleke mwanakazi wakwe?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Wakabavwiila wati, “Ani Mozesi wakamulayilila nzi?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Bakati “Mozesi wakali kuzumizya kuti mwaalumi alembe lugwalo lwakumuleka mpawo amwaande.”<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Jesu wakavwiila wati, “Nkaambo kakuyuma kwamyoyo yanu Mozesi nchakamulembela mulawu ooyu. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Pesi kumatalikilo akulenga Leza wakabachita mwaalumi amwanakazi.’<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false">Matalikilo 1:27</char></note> <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />‘Nkaambo kaako mwaalumi uyoosiya wisi abayina akakakatile kumwanakazi wakwe, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />aaba babili bayooba mubili uumwi.’ Tabachili babili, pesi mubili uumwi.<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">Matalikilo2:24</char></note> <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Nkikaako eezyo Leza nzyakamantaniya aamwi, taakwe muntu weelede kubapambula pe.”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Nibakali muŋanda lubo, basikwiiya bakabuzya Jesu atala amakani akulekana. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Wakabawviila wati, “Kufumbwa muntu uuleka mwanakazi wakwe akukwaata uumbi unooli wachitila mwanakazi wakwe bwaamu. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Alubo naa mwanakazi walekana amulumi wakwe waakukwatwa awumbi mwaalumi, unooli wachita bwaamu.”<verse eid="MRK 10:12" /></para>
  <para style="s">Jesu Ulongezya Bana Baniini</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mateyu 19:13-15</ref>; <ref loc="LUK 18:15-17">Lukku 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Bantu bakali kweeta bana baniini kuli Jesu kuti abaampe akubalongezya, pesi basikwiiya bakwe bakabakalalila. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Jesu naakabona kabaliikubakalalila bana, wakanyema. Wakati kulimbabo, “Amubaleke bana baniini baze kulindime, alimwi mutabakasyi, nkaambo bwami bwaLeza mbubwabo bali oobu. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Ndimwaambila kasimpe, ooyo utatambuli bwami bwaLeza mbuli mwana muniini takoyoobunjila pe.” <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Eelyo wakabweza bana baniini wakababukatila mumaboko akwe, wakabaampa wabalongezya.<verse eid="MRK 10:16" /></para>
  <para style="s">Mwaalumi Muvubi</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mateyu 19:16-30</ref>; <ref loc="LUK 18:18-30">Lukku 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Jesu naakatalika lweendo lwakwe, mwaalumi wakamuchijanina wafugama kunembo lyakwe, mpawo wakabuzya wati, “Muyiisyi Mubotu, ndichite biyeni kuti ndikajane buumi butamani?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Jesu wakamuvwiila wati, “Nkaamboonzi nundiita kuti mubotu? Taakwe nikuba uumwi mubotu kunze kwaLeza aliikke. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Uliizi milawu mbiiyamba, ‘Utajayi, utachiti bwaamu, utaabbi, utapi bumboni bwakubeja, utajani lubono anzila yalweeno, lemeka wuso abanyoko.’ ” <note caller="+" style="f"><char style="fr" closed="false">10:19 </char><char style="ft" closed="false">Kulonga 20:12; Detoronomi 5:16-20</char></note><verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Wakamuvwiila wati, “Muyiisyi, yoonse eeyi milawu ndalikwiibamba kuzwa kubukubusi bwangu.”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Jesu wakamulanga alimwi wakamuyanda, wati, “Nchintu chimwi nchubula, kuya, ukawuzye lubono loonse ndulaalo, mali ukape bachete, mpawo uyoolujana lubono kujulu. Mpawo uze unditobele.” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Kumajwi aaya mwaalumi ooyu wakawusa. Eelyo wakeenda chakuusa, nkaambo wakali abuvubi bwiingi.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Jesu naakalangalanga wakati kuli basikwiiya bakwe, “Nchiyumu biyeni kuti muvubi akanjile bwami bwaLeza!”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Basikwiiya bakwe bakagamba kumajwi aakwe, pesi Jesu wakayindulula wati, “Nibana, nchiyumu biyeni kunjila mubwaami bwaLeza! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Nchuuba kuti nkamela yiinde mupuli yaneleti kwiinda kuti mwaalumi muvubi anjile mubwaami bwaLeza.”<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Basikwiiya bakayindilila kugamba amajwi aakwe, bakati kuli uumwi awumwi, “Lino ngwani ukonzya kufutulwa?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Jesu naakabalanga wakati kulimbabo, “Kumuntu eechi tazikonzeki, pesi peepe aLeza; zintu zyoonse zilakonzeka aLeza!”<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Pita wakati kulinguwe, “Twakasiya zintu zyoonse kuti tukutobele!”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Jesu wakamuvwiila wati, “Ndilikukwaambila kasimpe, tawo pe wakasiya muunzi nikuba bakulana wakwe nikuba banikwe bakwe, nikuba bachizi wakwe nibaba banyina nikuba wisi nibaba bana nikuba myuunda nkaambo kangu ankaambo kamakani mabotu, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />uyookachilwa kutambula muli cheechino chiindi (maanda, bakulana nikuba banike bakwe, bachizi, manyina, bana, amyuunda) zipetedwe mwaanda, antoomwe akupenzegwa. Amuchiindi chitobela bayojana buumi butamani. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Pesi bataanzi bayiingi bayooba bakumamanino, bakumamanino bayooba bataanzi."<verse eid="MRK 10:31" /></para>
  <para style="s">Jesu Waamba Lwachitatu Atala Alufu Lwakwe</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mateyu 20:17-19</ref>; <ref loc="LUK 18:31-34">Lukku 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Jesu abasikwiiya bakwe bakali munzila kabatansya kuya kuJerusalemu, alimwi Jesu kalikuzulwida. Eezi zyakabagambya basikwiiya, abaabo bakali kutobela bakayoowa. Alimwi wakabweza balikkumi ababili wabayitila kumbali, wakatalika kupandulula atala aziyoochitika kulinguwe. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />Wakati, “Amulange tuyoobuya kuJerusalemu, awalo Mwana waMuntu uyoowabwa kubapayizi bapati abayiisyi bamulawu. Bayoomupa chisubulo chalufu, bayoomwaaba mumaanza abatamuzi pe Leza, <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />aabo bayoomuniyaka akumuswida mate, bayomuuma akumujeya. Mubuzuba bwachitatu uyoobuka.”<verse eid="MRK 10:34" /></para>
  <para style="s">Chikumbizyo ChaJakkobbu aJoni</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mateyu 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Eelyo Jakkobbu aJoni, bana baZebbedii, bakaza kuli Jesu bati, “Muyiisyi, tukumbila kuti utuchitile kufumbwa nzitutakumbile.”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Jesu wakabavwiila wati, “Niinzi nchimuyanda kuti ndimuchitile?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />Bakati, “Tukumbila kuti iswe mubulemu bwako, utuzumizye kuti umwi akakkale kululyo lwako umwi kulumwesi.”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Jesu wakati,“Tamuzizi pe nzimuliikukumbila. Muyeeya kuti nga mulanywa muchinywido chimwi na andime, nikuba kubbapatizigwa alubbapatizyo ndundiya kukubbapatizigwa aalo?”<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />Bakamuvwiila bati, “Tulakonzya.”</para>
  <para style="p" vid="MRK 10:39">Jesu wakati kulimbabo, “Muyoonywa muchinywido chimwi andime nikuba kubbapatizigwa alubbapatizyo ndundeelede kubbapatizigwa aalo. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Pesi kuti umwi akakkale kululyo umwi kulumwesi teezyangu pe kuti ndimupe. Aaya masena ngaabaabo Leza mbakasala kale, abambilidwe mbabo.”<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Aawo basikwiya bamwi balikkumi nibakamvwa atala ayaaya makani, bakanyemena Jakkobbu aJoni. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Jesu wakabayita wakababunganiya aamwi kulinguwe wasikuti, “Mulizi kuti aabo bategwa mbazulwidi babatamuzi pe Leza beendelezya bantu changuzu, abapati bachisi babelesya nguzu nzibapedwe atala lyabantu. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Pesi takuliboobo kulindinywe. Kufumbwa, uyanda kuba mupati akati kanu weelede atalike aabe mulanda wanu, <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />ayooyo uyanda kuba mutaanzi, weelede aabe muzike kuli boonse. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Nkaambo nikuba Mwana waMuntu taakwe naakaza kuti azokutawukilwe, pesi wakaza kuzokutawukila, akuti ape buumi bwakwe mbuli chinunuzyo chabiingi.”<verse eid="MRK 10:45" /></para>
  <para style="s">Jesu Mbwaponiya Bbatimayasi Moofu</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mateyu 20:29-34</ref>; <ref loc="LUK 18:35-43">Lukku 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Jesu abasikwiiya bakwe ankamu mpati nibakasika kubusena butegwa Jerikko, nibakali kuzwa muchisi, umwi mwaalumi moofu, uutegwa Bbatimayasi chaamba kuti, mwana waTimayasi, wakali kkede kumbali anzila kaliikukumbila bayinda. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Bbatimiyasi naakamvwa kuti nguJesu waNazareti wakali kuyabwiinda, wakatalika koompolola kati, “Jesu, Mwana waDevidi, kondifwida luse!”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Mpawo bantu bayingi bakamukalalila kabati awumune, pesi wakiinkila anembo akoompololisya kati, “Mwana waDevidi kondifwida luse!”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Jesu wakayimikila mpawo wati, “Ngamumwiite kuti aze okuno.”</para>
  <para style="p" vid="MRK 10:49">Aboobo bakamwiita mwaalumi moofu bati, “Sangalilwa, nyampuka, ulookukwiita.”<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />Aboobo wakawaalila aansi nsasiko yakwe, wakasotoka wikiimila amawulu aakwe mpawo wakaza kuli Jesu nkwaakabede.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Jesu wakabuzya wati, “Uyanda kuti ndikuchitileenzi?”</para>
  <para style="p" vid="MRK 10:51">Mwaalumi moofu wakati, “Muyiisi, ndiyanda kuti ndibone.”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Jesu wakati, “Kuya, lusyomo lwako lwakuponiya.”</para>
  <para style="p" vid="MRK 10:52">Alimwi mpawawo wakabona, mpawo watobela Jesu nkwakalikuya.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Jesu Kanjila MuJelusalemu</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mateyu 21:1-11</ref>; <ref loc="LUK 19:28-40">Lukku 19:28-40</ref>; <ref loc="JHN 12:12-19">Joni 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Alimwi Jesu abasikwiiya bakwe nibakaamba kunjila muJerusalemu kumyuunzi itegwa Betipeji aBbetani iili afwiifwi aChilundu chama Oliva, Jesu wakatuma basikwiiya bakwe babili kunembo lyakwe. <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />Jesu wakati kulimbabo, “Ngamwiinke kumuunzi ulikunembo lyanu, mbumutakanjile biyo, muyojana mwana wambongolo waangidwe nkuko, utanatantwa nikuba muntu uumwi. Mukamwaangunune mumweete okuno. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Kuti umwi waakumubuzya wati, ‘Muchitilaanzi eechi?’ Mukamwaambile kuti, ‘Mwami nguulikumuyanda alimwi ulamuboozya aano muchiindi chifwiifwi.’ ”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Basikwiiya bakayinka bakamujana mwana wambongolo kaangilidwe mukazila kumulyango. Nibakali kumwaangununa, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />bamwi bantu bakayiimvwi mpawo bakabuzya kuti, “Muchitaanzi, nimwaangununa mwana wambongolo ooyu?”<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />Bakavwiila mbuli Jesu mbaakabalayilila, mpawo bantu bakabazumizya kuti beende. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Nibakamweeta mwana wambongolo kuli Jesu bakayala nsasiko amusana wambongolo, eelyo Jesu wakakkala alinguwe. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Bantu bayingi bakayala nsasiko zyabo mumugwagwa, bamwi bakayala matabi ngibakatemede mumyuunda. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Bakazula abakali musule lyaJesu bakoompolola kabati, “Hosanna! Ulilongezezegwe ooyo uza muzina lyaMwami!<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">Intembawuzyo 118:25-26</char></note> <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />Bulilongezezegwe bwami bwataata wesu Devidi buyoobuza! Hosanna mujulu lyamajulu!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Jesu wakanjila mu Jelusalema akwiinka muŋanda yaLeza. Wakalangalanga zintu zyoonse, pesi nkaambo kakuti lyakali lyabagoko, wakayinka kuBbetani abalikkumi ababili.<verse eid="MRK 11:11" /></para>
  <para style="s">Jesu Utuka Mukuyu</para>
  <para style="r">(<ref loc="MAT 21:18">Mateyu 21:18</ref>,<ref loc="MAT 21:19">19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Mubuzuba butobela Jesu abasikwiiya bakwe nibakazwa muBbetani, Jesu wakaba anzala. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Mukubona mukuyu amatu aawo chakule, wakayiinka kuti akabone kuti ulamichelo na. Naakasika mpawo wakajana matu luzutu, kakutakwe michelo, nkaambo teensi chakali chiindi chankuyu pe. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Eelyo Jesu wakaambila mukuyu kuti, “Kutazoobi nikuba uumwi uzoolya michelo kulinduwe lubo.”</para>
  <para style="p" vid="MRK 11:14">Basikwiiya bakamumvwa kaamba makani aayo.<verse eid="MRK 11:14" /></para>
  <para style="s">Jesu Unjila Mulubuwa Lwaŋanda YaLeza.</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mateyu 21:12-17</ref>; <ref loc="LUK 19:45-48">Lukku 19:45-48</ref>; <ref loc="JHN 2:13-22">Joni 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Jesu abasikwiiya bakwe nibakkasika muJelusalema, Jesu wakanjila muŋanda yaLeza mpawo wakabatanda bakali kuula akuuzya oomo. Wakatonta matebuli abasikubbindawuka mali azyuuno zyabaabo bakalikuuzya nkwilimba. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Mpawo taakwe naakazumizya nikuba uumwi kuti abweze zyakalikuuzigwa mulubuwa lwaŋanda yaLeza. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Mpawo wakabayiisya wati, “Takulembedwe na kuti, ŋanda yangu iyootegwa niŋanda yakukombela kwamanyika woonse?’<note caller="+" style="f"><char style="fr" closed="false">11:17 </char><char style="ft" closed="false">Ayizaya 56:7</char></note> Pesi nywebo mwayichita chifuko chabasikubba.”<note caller="+" style="f"><char style="fr" closed="false">11:17 </char><char style="ft" closed="false">Jeremiya 7:11</char></note><verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Bapayizi bapati abayiisyi bamulawu bakaamvwa makani aaya eelyo bakayanduula inzila zyakumujaya aazyo, mukuti bakali kumuyoowa, nkaambo bantu boonse bakaba akugamba kunjiisyo yakwe.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Nilyakaba goko, Jesu abasikwiiya bakwe bakazwa muchisi.<verse eid="MRK 11:19" /></para>
  <para style="s">Chiiyo Chamusamu WaMukuyu</para>
  <para style="r">(<ref loc="MAT 21:20-22">Mateyu 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Jesu abasikwiiya bakwe chifumo, nkabayoobubweenda, bakabona mukuyu wakayuma kuzwa kumiyanda. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Pita wakayeeya mpawo wakati kuli Jesu, “Muyiisi, laanga! Mukuyu nguwakatuka wakayuma!”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Jesu wakavwiila kuti, “Amube alusyomo muli Leza. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Ndamwaambila kasimpe kuti, naa umwi wati kuchilundu eechi, ‘Kuya ukaliwaalile mulwizi,’ mpawo katadooneki mumoyo wakwe pesi kasyoma kuti eezyo nzyawamba ziyochitika, ziyoomuchitikila mbubo. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Nkikaako ndamwaambila kuti, kufumbwa nchimuyookumbila mukukomba, amusyome kuti mwachijana, mpawo chiyooba chanu. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Mpawo naa wayimikila kulikukomba, na kuwangilide umwi moyo, mulekelele, kuchitila kuti Wuso uulikujulu akulekelele zibi zyako.” <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Pesi kuti inywe kamutalekeleli bantu bali amilandu kulindinywe, alakwe Wuso uulikujulu takoyoomulekelela milandu yanu.”<verse eid="MRK 11:26" /></para>
  <para style="s">Jesu Mbwabuzigwa Atala Abweendelezi Bwakwe</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mateyu 21:23-27</ref>; <ref loc="LUK 20:1-8">Lukku 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Jesu abasikwiiya bakwe bakasika lubo kuJerusalemu, eelyo Jesu naakayobweenda mulubuwa lwaŋanda yaLeza, bapayizi bapati, abayiisyi bamulawu abaalu bambungano bakaza kulinguwe. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />Bakabuzya bati, “Mubwendeelezi buli mbuchita zintu ziliboobu? Alimwi ngwani ukupa bweendelezi bwakuchita zintu eezi?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Jesu wakabavwiila wati, “Ndiyoobuzya mubuzyo uumwi. Mundivwiile, eelyo ndiyoomwaambila kuti mubweendelezi bwani mundiilikuchita zintu eezi. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Kubbapatizya kwaJoni, kwakali kuzwa kujulu na, naakuti kwakazwa kubantu? Mundaambile!”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Bakakazyaniya akati kabo atala amakani aaya mpawo bakati, “Twaamba kuti, ‘Kuzwa kujulu,’ ulatubuzya kuti, ‘Nkaamboonzi nimwakatamusyoma?’ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Pesi twaamba kuti, ‘Kuzwa kubantu.’ ” (bakayoowa nkamu yabantu nkaambo boonse wakalizi kuti Joni musinsimi mwinimwini.) <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Alimwi bakamuvwiila Jesu kabati, “Tatuzi pe.”</para>
  <para style="p" vid="MRK 11:33">Jesu wakabaambila kuti, “Aboobo nsikoomwaambila pe kuti mbweendeleziinzi nziindi chitaazyo.”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Chikozyanisyo ChaBasikuyalila Muunda Wamasansa</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mateyu 21:33-46</ref>; <ref loc="LUK 20:9-19">Lukku 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Eelyo Jesu wakatalika kubaambila chikozyanisyo wakati, “Umwi mwaalumi wakabyala misamu yamasansa mumuunda. Wakiiyakila lubaya, wakaasya dindi lyakudinina masaansa, akuyaka sanza lyasikulinda. Alimwi wakajana kuyalizya bamwi balimi mpawo wakaya mulweendo. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Muchiindi chakutebula wakatuma umwi wabalanda bakwe kulibasikuyalilamuunda kuyoobweza imwi michelo yamasansa. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Pesi basikuyalila aabo bakakumujata, akumuuma, akumwaanda katakwe nchalaacho pe. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Wakatuma uumbi mulanda; ooyu mwaalumi bakamudonkola mumutwe akumusampawula. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Wakatuma uumbi, alubo ooyu bakakumujaya. Wakatuma bambi bayingi; bamwi bakabawuma, bamwi bakabajeya.<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />Kwakasyaala umwi biyo wakutuma, kali mwanaangu ngwaakali kuyandisya. Wakamutuma kali wakumaninsizya, wakati, ‘Bayoomulemeka mwanaangu.’<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />Pesi basikuyalila bakaambilana kuti, ‘Ooyu ngusimulya lukono. Muze tumujeye, mpawo lukono luyooba lwesu.’ <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Nkabela bakamujata akumujeya, akumuwaalila kunze amuunda wamasansa.”<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />Lino Jesu wakabuzya wati, “Ulachita buti muni muunda? Ulasika akujeya basikuyalila akape bambi muunda wamasansa. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Tamuna kwaabala na malembe? Awaamba kuti</para>
  <para style="q1" vid="MRK 12:10">‘ibbwe lyakasowedwe aaba sikuyaka</para>
  <para style="q2" vid="MRK 12:10">ndilyakazooba bbwe lyachooko;<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Mwami ngwaachichita eechi,</para>
  <para style="q2" vid="MRK 12:11">alimwi chileebeka mumeso eesu.’”<note caller="+" style="f"><char style="fr" closed="false">12:11 </char><char style="ft" closed="false">Intembawuzyo 18:22-23</char></note><verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Eelyo bakayanduula nzila yakumwaanga aayo nkaambo bakaziba kuti wakali kwaamba mbabo muchikozyanisyo eechi. Pesi bakayoowa nkamu yabantu yakaliwo; nkikaako bakamusiya beenda.<verse eid="MRK 12:12" /></para>
  <para style="s">Mubuzyo Atala Akuliya Mitelo</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mateyu 22:15-22</ref>; <ref loc="LUK 20:20-26">Lukku 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Lino bamwi babaFarisi abaHeroda bakatumwa kuli Jesu kuti bakamujate amakani aakwe. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Bakasika kulinguwe bakati, “Muyisyi, tulizi kuti ulimwaalumi usyomekede. Tuyungwi abantu pe nikuba kulanga chiwa chamuntu; pesi uyiisya nzila yaLeza mbuli mbiibede mukasimpe.Twaambile chileelede na kuliya kuli Siza (mweendelezi wabaRoma) nakuti peepe?<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />Tweelede kuti tuliye na, naakuti peepe?” Pesi Jesu wakalizi kuupawupa kwabo, wakababuzya wati, “Nkaamboonzi nimulikweezya kunditeya?” Wakati, “Ngamundeetele kkobili lyanu ndilibone mbulibede.” <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />Eelyo bakalyeeta kkobili, alimwi wakababuzya wati, “Mbubwani busyu oobu? Alimwi ndizina lyani lilembedwe mpawo?”</para>
  <para style="p" vid="MRK 12:16">Bakavwiia bati, “Nzizya Siza.”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Mpawo Jesu wakati kulimbabo, “Ngamupe Siza zyaSiza, alimwi mupe Leza zyaLeza.”</para>
  <para style="p" vid="MRK 12:17">Mpawo bakagamba atala Jesu.<verse eid="MRK 12:17" /></para>
  <para style="s">Mubuzyo Atala Akubuka Kuzwa Kubafu</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mateyu 22:23-33</ref>; <ref loc="LUK 20:27-40">Lukku 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Eelyo bamwi BaSejusi, baamba kuti taakwe bubuke kuzwa kubafu, bakaza kuli Jesu amubuzyo. <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />Bakati, “Muyiisi, Mozesi wakatulembela kuti na mwaalumi wafwa wasiya mwanakazi wakwe katakwe bana anguwe, umwi mwanike wakwe weelede kukwata mukamufu mpawo azyalile sikufwa. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Lino bakali musanu ababili banike bakwe. Mutaanzi wakakwata mpawo wafwa katakwe naakaba abana pe. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Wachibili wakakwata mukamufu, pesi alakwe wakafwa katasiyide mwana pe. chakaba mbuboobo akuli wataatu. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />alimwi boonse, balimusanu ababili takwe pe wakasiya mwana. Kumamanino, alakwe mwanakazi wakafwa. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Kububuke bwabafu, ooyu mwanakazi uyooba wani, mbukunga boonse kabali musanu ababili bakalimukwete?”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Jesu wakabavwiila wati, “Tamuli kulubizya na nkaambo tamwaazi pe Malembe nikuba manguzu aLeza? <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Bafu nibayoobuka, tabakoyookwata nikuba kukwatanisigwa; pesi bayooba mbuli baangelo kujulu. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Lino mukwaamba atala abafu nibayoobuka temwakabala na mubbuku lyaMozesi, kumakani achiteyo, Leza mbwaakaamba kulinguwe kuti, ‘Ndime Leza waAbburahamu, Leza waAyizekki, alubo Leza waJakkobbu?’<note caller="+" style="f"><char style="fr" closed="false">12:26 </char><char style="ft" closed="false">Kulonga 3:6</char></note> <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Tali Leza wabafwide pe, pesi ngwabapona. Mwalubizya kapati!”<verse eid="MRK 12:27" /></para>
  <para style="s">Mulawu Mupati</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mateyu 22:34-40</ref>; <ref loc="LUK 10:25-28">Lukku 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Umwi wabayisyi bamulawu wakasika mpawo wamvwa kabaliikukazyaniya. Nkabwene kuti Jesu wakali wabavwiila obotu, wakabuzya Jesu wati, “Nguuli mulawu mupati kwiinda iimwi akati kamilawu yoonse?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Jesu wakamuvwiila wati, “Mupati loko ngooyu, ‘Swiilila, iwe Izirayeli, Mwami Leza wesu, Mwami ngumwi. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Yanda Mwami Leza wako amoyo wako woonse, amuuya wako woonse, alimwi amizeezo yako yoonse, amanguzu aako woonse.’ <note caller="+" style="f"><char style="fr" closed="false">12:30 </char><char style="ft" closed="false">Deturonony 6:4</char></note> <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />alimwi wabili ngooyu, ‘Yanda simayakilani wako mbuli mbuuliyanda.’<note caller="+" style="f"><char style="fr" closed="false">12:31 </char><char style="ft" closed="false">Levetikkasi 19:18</char></note> Takukwe mulawu mupati wiinda eeyi.”<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Mwaalumi wakavwiila kati, “Waamba kabotu, Muyiisyi! Nkaambo takukwe uumbi leza kunze kwakwe. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Alimwi kumuyanda amoyo wako woonse, akumvwisisisya kwako koonse amanguzu aako woonse, mpawo akuyanda basimayakilani bako mbuli mbuuliyanda nchiichi pati kwiinda zyuumpilizyo azipayizyo.”<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />Jesu naakabona kuti wakavwiila chabusongo, wakati kuli nguwe, “Tulikule pe abwami bwaLeza.” Kuzwaawo takwe pe nikuba uumwi abusichaamba bwakumubuzya iimbi mibuzyo.<verse eid="MRK 12:34" /></para>
  <para style="s">Mubuzyo Atala aMesiya</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mateyu 22:41-46</ref>; <ref loc="LUK 20:41-44">Lukku 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Aawo Jesu naakali kuyiisya mulubuwa lwaŋanda yaLeza, wakabuzya mubuzyo wakati, “Ibiyeni bayiisyi bamulawu nibaamba kuti Kkirisitu ndunyungu lwaDevidi? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Devidi lwakwe, kaambuzigwa aMuuya Usalala, wakaamba kuti:</para>
  <para style="q1" vid="MRK 12:36">‘Mwami wakati kuMwami wangu:</para>
  <para style="q2" vid="MRK 12:36">Kkala kuluboko lwangu lwakululyo</para>
  <para style="q2" vid="MRK 12:36">mane kusikila basinkondonyokwe ndikababikke kunsi azituta zyako.’<note caller="+" style="f"><char style="fr" closed="false">12:36 </char><char style="ft" closed="false">Intembawuzyo 110:1</char></note><verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />Devidi lwakwe umwiita kuti ‘Mwami’; aboobo Kkirisitu nguulaba lunyungu lwaDevidi biyeni?”</para>
  <para style="s" vid="MRK 12:37">Jesu Uchenjezya Atala Abayiisyi Bamulawu</para>
  <para style="r" vid="MRK 12:37">(<ref loc="MAT 23:1-36">Mateyu 23:1-36</ref>; <ref loc="LUK 20:45-47">Lukku 20:45-47</ref>)</para>
  <para style="p" vid="MRK 12:37">Inkamu mpati yabantu yakamuswiilizya Jesu akukondwa. <verse eid="MRK 12:37" /><verse number="38" style="v" sid="MRK 12:38" />Eelyo Jesu naakalikuyiisya wakati, “Amubachenjelele bayiisyi bamulawu. Balayandisya kweendeenda kabasamide zisamo zilamfu, akujuzigwa mumasena akusambalila, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />alubo balayandisya kupegwa zyuuno zyabulemu muzikombelo akulemekwa kapati mumapobwe. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Baleenena maanda aaba mukabafu, alimwi balayandisya kukomba nkombyo ndamfu mumeso abantu chakweebwa. Bantu bali boobu bayoopegwa chisubulo chiindilide.”<verse eid="MRK 12:40" /></para>
  <para style="s">Chipo Chamukamufu</para>
  <para style="r">(<ref loc="LUK 21:1-4">Lukku 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Jesu wakakkala kubbazu lyakalangene abusena bwakali kubikwa zipo, kalikulangilizya bantu nibakalibikka mali muchiyobwedo muŋanda yaLeza. Bavubi bayingi bakalikubikka imali nyingi; <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />pesi umwi mukamufu muchete wakaza wabika biyo tukkobili tubili, tutakwe bulemu pe. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Jesu naakayita basikwiiya bakwe, wakati, “Ndiliikumwaambila kasimpe kuti, ooyu mukamufu wabika kwiinda bamwi boonse muchiyobwedo. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Boonse aaba bapa zyeendelana alubono lwabo, pesi wee mubuchete bwakwe wabika zyoonse nzyaalangilide mubuumi bwakwe kuti apone anzizyo.”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Kunyonyoonwa Kwaŋanda yaLeza</para>
  <para style="r">(<ref loc="MAT 21:1">Mateyu 21:1</ref>,<ref loc="MAT 21:2">2</ref>; <ref loc="LUK 21:5">Lukku 21:5</ref>,<ref loc="LUK 21:6">6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Alimwi Jesu naakali kuzwa muŋanda yaLeza, umwi wabasikwiiya bakwe wakati kulinguwe, “Muyiisi, laanga! Mabwe meebesi amaanda meebesi!”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />Jesu wakavwiila wati, “Ulaabwene na maanda mapati woonse aaya? Takwe pe bbwe niliba limwi liyoochaala kalili aatala alimwi; woonse ayoowalilwa aansi.”<verse eid="MRK 13:2" /></para>
  <para style="s">Mapenzi aMasukusyo</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mateyu 24:3-14</ref>; <ref loc="LUK 21:7-19">Lukku 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Jesu naakakkede aChilundu chamaOliva chilangene aŋanda yaLeza, Pita, Jakkobbu, aJoni aEnduru bakamubuzya kavwiindi bakati, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“Twaambile, ndiilili niziyoochitika zintu eezi? Alubo nzeezili zitondeezyo nzituyoobona aazyo kuti zyaamba kuzuzikizigwa?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Jesu wakabaambila kuti, “Amuchenjele kuti kutabi umwi umweeni. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Mbayingi bayooza muzina lyangu, kabalyaamba kuti, ‘Ndiindime Kkirisitu!’ eelyo bayooyena bayingi. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Mwayoomvwa aatala ankondo ampuwo zyankondo, mutakayoowi. Eezyo zintu zyeelede kuchitika, pesi mamanino achiyobuza. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />alimwi nyika iyoobukilana anyika nyina, alubo bwami abwaminyina. kuyooba iyooteketa kwanyika mumabbazu asiyenesiyene, alubo kuyooba bbalangwe. Eezi ziyooba mbuli kumyongwa kutaanzi kwamwanakazi uyanda kutumbuka.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />Mweelede kukkala kamulibambilide. Muyoowabwa kubeendelezi bamyuunzi akuumwa muzikombelo. Nkaambo kangu muyoyima kunembo lyabasilutwe bazilikiti abami mbuli bakamboni kulimbabo. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Mpawo makani mabotu ayeelede kuyookambawukwa kumikowa yoonse. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Kufumbwa mpumuyoowangwa akutolwa kukubetekwa, mutakalikataazyi kuti muyoowamba kamutyeni. Mukaambe biyo eezyo nzimutanooli mwapegwa kuli cheecho chiindi, nkaambo tamunooli ndinywe batanoowambule, pesi unooli nguMuuya USalala. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />Bana bamuntu uumwi bayoowuzyaniya kulufu, alubo wisi uyoochita mbubo kumwanaakwe. Bana bayoolwana abazyali babo mane bakabajazye. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Bantu boonse bayoomusula nkaambo kandime, pesi ooyo uyookakatila mane kumamanino uyoovunwa.<verse eid="MRK 13:13" /></para>
  <para style="s">Chiteelede Abusena</para>
  <para style="r">(<ref loc="MAT 24:15-28">Mateyu 24:15-28</ref>; <ref loc="LUK 21:20-24">Lukku 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />“Mwaakubona chisesemyo chalunyonyooko chiima aabusena mpuchiteelede, (mubali akumvwisisisya) mpawo abalabo bali muJudiya bakachijile muzilundu. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Ooyo uli achiluli ataseluki naa kunjila muŋanda kuyoogwisya chimwi chintu. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Uyoojanwa kumuunda atakabooli kuŋanda kuyoobweza nsasiko yakwe. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Kuyooba kufwaba kupati kuli aayo mazuba kubanakazi bamitide abanyonsya. <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Kamukomba kuli Leza kuti eezi zitakachitiki muchiindi chamupeyo. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Nkaambo ayooba mazuba amapenzi mapati kwiindilila bantu ngibakaswene kuzwa kutamatalikilo, aawo Leza naakalenga nyika kusika sunu, alubo mapenzi aali boobu takoyoochitika limbi pe. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />kuti Mwami taakafwiinsya mazuba aayo, nikunga taakwe wali kuyoopona pe. Pesi ankaambo kabantu bakwe mbaakasala uyoowafwiinsya.<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />Kuchiindi eecho naa umwi waamba kuti, ‘Mulange, ngooyu Kkirisitu!’ na kalikwaamba kuti ‘Mulange, nguulya nkwabede!’ tamweelede kusyoma pe. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Nkaambo kuyooyubunuka baKkirisitu babeji abasinsimi babeji alimwi bayoochita zigambyo amalele kuti bakeenene nikuba basale baLeza, naa kazikonzeka. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Aboobo amukakkale kamulibambilide nkaambo ndamwaambila kazitanakusika pe.<verse eid="MRK 13:23" /></para>
  <para style="s">Kuboola KwaMwana aMuntu</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mateyu 24:29-31</ref>; <ref loc="LUK 21:25-28">Lukku 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />Pesi mumazuba aayo, mapenzi aayo nayoomana, izuba liyoobola, kuyooba mudima mupati, amweezi uyoobola. <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />Nyenyeezi alazyo ziyooloka, nkaambo julu liyooteketa.<verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />“Muchiindi eecho bantu bayoobona Mwana waMuntu kazwida mumayoba anguzu mpati abulemu. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Alubo uyootuma baangelo bakwe kuti bakabunganiye basale baLeza kuzwa kumabazu aane, kuzwa nkwiimanina nyika kuyoosika kumamanino ajulu.<verse eid="MRK 13:27" /></para>
  <para style="s">Chiiyo ChaMukuyu</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mateyu 24:32-35</ref>; <ref loc="LUK 21:29-33">Lukku 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />“Lino amwiiye chiiyo kuzwa kumukuyu, aawo mitabi yawo niitalika kutunga ndelema amatu naasyuuka ngamwaziba kuti mayiinza abaafwiifwi. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Mbubonya oobo, mwaakuzibona zintu eezi kazichitika, mukazibe kuti chiindi chaba afwiifwi, chaba amulyango. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Ndamwaambila kasimpe, izyalane eeli talikuyooyinda mane zintu zyoonse eezi zikakuchitike. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Julu anyika ziyooyinda, pesi majwi aangu taakoyooyinda.<verse eid="MRK 13:31" /></para>
  <para style="s">Takwe Uzi Buzuba nikuba Chiindi</para>
  <para style="r">(<ref loc="MAT 24:36-44">Mateyu 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />Jesu wakati, “Taakwe naba uumwi uuzi eelyo zuba nichiba chiindi, nibaba baangelo balikujulu nikuba Mwana waMuntu, pesi Taata alike nguuzi. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Mulibambilile, muchenjele, nkaambo tamuchizi chiindi eecho nichiyoosika. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Chili mbuli muntu wakeenda lweendo, wakasiya ŋanda yakwe wapa balanda bakwe nguzu, akubaabila umwi awumwi milimu yakuchita mpawo wakaambila mulindizi waamulyango kuti akkale kalangide. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />“Nkikaako mukkale kamulibambilide nkaambo tamuchizi chiindi naboola muna aŋanda, naakuti linoli goko, nikuba aakati kamansiku, kubuchedo naakuti chifumofumo. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Kuti waboola chakufwambaana, mutazumini kuti mujanike kamulikoona pe. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Eezi nzindili kwaamba kulindinywe, ndiikwaambila bantu boonse: ‘Amulibambile!’ ”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Kubelelela Jesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mateyu 26:1-5</ref>; <ref loc="LUK 22:1">Lukku 22:1</ref>,<ref loc="LUK 22:2">2</ref>; <ref loc="JHN 11:45-53">Joni 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Lino kwakali kwachaala mazuba abili kuti kuchitwe Pobwe lyaKwiindilila aPobwe lyaChinkwa chitakwe Bumena. Aboobo bapayizi bapati abayiisyi bamulawu bakali kuyanduula nzila yakwaanga Jesu mukavwindi akumujeya. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Pesi bakati, “Kutabi muchiindi chaPobwe nkaambo bantu ngabalanyongana.”<verse eid="MRK 14:2" /></para>
  <para style="s">Kunanikwa KwaJesu KuBbetani</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mateyu 26:6-13</ref>; <ref loc="JHN 12:1-8">Joni 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Jesu naakachili muBbetani muŋanda yamwaalumi uzibikene kuti Sayimoni wakali achipele kakkede aansi kayeeme atebuli, kwakasika mwanakazi kajisi kankuli kamafuta amuulo udula anunkilila akachitidwe amuunde. Wakapwasula kankuli kamafuta akwaatila amutwe waJesu.<verse eid="MRK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4" />Bamwi babo bakaliwo aawo bakaambilana chamoyo uuchisa kuti, “Mafuta aaya anyonywedwaanzi? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Mafuta aaya aleelede kuuzigwa amuulo wiinda mpindu yamubelesi njeleede kujana mumunyaka woonse mpawo mali ipegwe bachete.” Bakakalalila mwanakazi ooyu chaluuni.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />Jesu wakaamba kuti, “Ngamumuleke, mukatazizyaanzi? Wandichitila chintu chibotu. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Bachete munooli aabo alimwi muyobagwasya kuchiindi nimuyanda. Pesi tamukwe kuyooba andime pe chiindi choonse. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Wachita nzyaakonzya; watila mafuta amubili wangu kubambila kuzikkwa kwangu. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Ndamwaambila kasimpe kuti eezi nzyaachita mwanakazi ooyu uyooyibalukilwa nzizyo munyika yoonse kufumbwa makani mabotu nkwaayo kambawukwa.”<verse eid="MRK 14:9" /></para>
  <para style="s">Judasi Uzumina KwaabaJesu</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mateyu 26:14-16</ref>; <ref loc="LUK 22:3-6">Lukku 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Eelyo Judasi Isikkariyoti umwi wabasikwiiya balikkumi ababili, wakayinka kubapayizi bapati uyoowaba Jesu kuli mbabo. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Bakakondwa nibakamvwa eechi, bakamusyomezya kumupa mali. Kuzwa aawo wakalanguula mweenya wakumuumwaba.<verse eid="MRK 14:11" /></para>
  <para style="s">Jesu Ulya Ipobwe LyaKwindilila Abasikwiiya Bakwe</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mateyu 26:17-25</ref>; <ref loc="LUK 22:7-14">Lukku 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Joni 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Lino bwakali buzuba butaanzi bwaPobwe lyaChinkwa chitakwe Bumena, mbuli chiyanza chabo, aawo nibakali kupayila kabelele kaPobwe lyaKwiindilila. Basikwiiya bakwe Jesu bakamubuzya bati, “Nkukuuli nkuyanda kuti twiinke tukabambe Pobwe lyaKwiindilila ukalye?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Eelyo Jesu wakatuma bamwi babasikwiiya bakwe babili, wabaambila kuti, “Ngamwiinke mugunzi alimwi muyooswanana amwaalumi unyampwide nongo yameenda, mukamutobele. <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />Nayoonjila muŋanda mukaambe kuli muna aŋanda kuti, ‘Muyiisi ubuzya kuti, muumuli muŋanda yabweenzu bwangu mundikonzya kuyoolida Pobwe lyaKwiindilila abasikwiiya bangu? <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Alimwi uyoomutondeezya muŋanda yamujulu mpati ibambikene kale, mukatubambile mumo.”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Basikwiiya bakazwa, bakayinka muchisi bakakujana zintu mbuli mbubonya mbuli Jesu mbwaakabaambila. Eelyo bakabamba Pobwe lyaKwiindilila.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Lino nilyakaba goko, Jesu wakasika abasikwiiya bakwe balikkumi ababili. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Alimwi kabachiyeeme atebuli kabaliikulya, Jesu wakaamba kuti, “Ndamwaambila kasimpe, umwi wanu uyoondaaba, ooyo ngundilya aamwi anguwe.”<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Eelyo bakawusa akwaamba uumwi awumwi kulinguwe kuti, “Kasimpe teendime naa?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />Jesu wakabavwiila wati, “Nguumwi wanu inywe nimulikkumi ababili, usunsa aamwi andime mundido. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Mwana waMuntu uyooyinka mbubonya mbuuli mbukulembedwe atala anguwe. Pesi maawee kuli ooyo waaba Mwana waMuntu! Chakali kuba mbubo naatakazyalwa pe!”<verse eid="MRK 14:21" /></para>
  <para style="s">Mulalilo WaMwami</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mateyu 26:26-30</ref>; <ref loc="LUK 22:14-20">Lukku 22:14-20</ref>; <ref loc="1CO 11:23-25">1 BaKkorinte 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Alimwi Jesu abasikwiiya bakwe nibakali kulya, Jesu wakabweza chinkwa, walumba akuchikwamuna mpawo wakapa basikwiiya bakwe, wakati, “Ooyu ngumubili wangu, amuulye.”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Eelyo wakabweza kanywido, walumba akubapa, alimwi boonse bakanywa kuli nkako.<verse eid="MRK 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 14:24" />Wakati kulimbabo, “Oobu mbuubulowa bwangu bwachizuminano, oobo butililwa bayiingi. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Ndamwaambila kasimpe, tandikwe kuyoonywa lubo kumcheelo wamasansa kuyoosika mubuzuba oobo mbundiyoonywa wayini mupya Mubwami bwaLeza.”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Eelyo bakayimba lwiimbo, akuzwa bayinka kuChilundu chamaOlivu.<verse eid="MRK 14:26" /></para>
  <para style="s">Jesu Waamba Pita Mbayoomutama Jesu</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mateyu 26:31-35</ref>; <ref loc="LUK 22:31-34">Lukku 22:31-34</ref>; <ref loc="JHN 13:36-38">Joni 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Jesu wakabaambila kuti, “Moonse muyoondichija, nkaambo kulilembedwe kuti, ‘Ndiyoowuma mweembeli, alimwi mbelele ziyoomwayika.’<note caller="+" style="f"><char style="fr" closed="false">14:27 </char><char style="ft" closed="false">Zakkariya13:7</char></note> <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />Pesi nindakubuka, ndiyooyinka kunembo lyanu kuGalili.”<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Pita wakati, “Nikuba kuti bamwi boonse bakuchija, ime tandiyookuchija pe.”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Jesu wakavwiila kati, “Ndakwaambila kasimpe, iiyi sunu, mansiku mukuku kutakunalila tubili iwe lwako Pita uyoonditama tutatu.”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Pesi Pita wakasungwaala kwaamba kuti, “Nikuba kandeelede kufwa aamwi anduwe, tandikwe kuyookutama pe.”</para>
  <para style="p" vid="MRK 14:31">Alimwi boonse bakaamba mbubonya.<verse eid="MRK 14:31" /></para>
  <para style="s">Kukomba KwaJesu Muchilili Chitegwa Getisemani</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mateyu 26:36-46</ref>; <ref loc="LUK 22:39-46">Lukku 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Eelyo Jesu abasikwiiya bakwe bakayinka kuchilili chakalikutegwa Getisemani, alimwi Jesu wakati kuli basikwiiya bakwe, “Ngamukkale ano, ndichiya kuyookomba.” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Wakabweza Pita, Jakkobbu aJoni weenda aabo, alimwi wakatalika kulemenwa mumoyo akuusa. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Wakaamba kuti kulimbabo, “Muuya wangu walemenwa, ndawusila kufwa. Mukkale aawa akulindila.”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Nakeenda kasinzo, wakavundama aansi akukomba kuti naa kachikonzeka, eechi chiindi chimwiinde. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Alimwi wakati, “Abba, Taata zyoonse zintu zilakonzeka kulinduwe. Gwisya kanywido aaka kuzwa kulindime. Nikuba boobo kutabi kuyanda kwangu, pesi akube kuyanda kwako.”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Eelyo wakabweeda kuli basikwiiya bakwe alimwi wakabajana balokoona. “Mpawo wakaamba kuti kuli Pita, “Sayimoni, ulikoona na? Wakachilwa na kulindila kwahola limwi biyo? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Alimwi wakati kulimbabo, “Amulindile akukomba kuti mutawidi mumisunko. Muuya ulayanda pesi mubili tuukwe nguzu.”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Alimwi wakayinka waakukomba, wakwiiindulula majwi ngaakakombede kale. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Naakaboola kuli mbabo, wakajana baliikoona lubo, nkaambo zyakabazunda ŋonzi. Bakiibula nsandulo yakumupa.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Naakabweeda kachitatu, wakabaambila kuti, “Sena muchilede akulyookezya? Kwazulila! Chiindi chasika. Amulange, Mwana waMuntu waabwa mumaanza abasizibi. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Amubuke! Tweende! Sikundaaba waba afwiifwi!”<verse eid="MRK 14:42" /></para>
  <para style="s">Kwaangwa KwaJesu</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mateyu 26:47-56</ref>; <ref loc="LUK 22:47-53">Lukku 22:47-53</ref>; <ref loc="JHN 18:3-12">Joni 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Aawo Jesu naakachili kwaambuula, Judasi, umwi wabalikkumi ababili, wakaliboniya. Wakali abantu bayingi bakali amapanga amakoli, bakatumidwe abapayizi bapati, abayiisyi bamulawu abaalu babantu. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Lino sikumwaaba wakalibambide kale chitondeezyo ambabo chakuti, “Ooyo mwaalumi ngundiyoojuzya ngunguwe; mumwaange akumutola chakumulinda.”<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />Naakayinka kuli Jesu, Judasi wakaamba kuti, “Muyiisi!” mpawawo wakamujuzya. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Mpawawo bantu bakajata Jesu akumwaanga. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Mpawo umwi wabaabo bakaliimvwi afwiifwi wakasomona panga lyakwe, wakkwapula kutwi kwamulanda wamupayizi mupati. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Jesu wakati kulimbabo, “Sena ndilimupapi, nimuza amapanga amakoli kuzoondijata? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Mazuba woonse ndakali andinywe kandiliyiisya muŋanda yaLeza, tamukwe nimwakandanga pe. Pesi Malembe ayelede kuzuzikizigwa.”<verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />Alimwi basikwiiya bakwe boonse bakamusiya mpawo bakachija.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Mwaaluumi mukubusi wakalisamide chisamo chinteetema luzutu alakwe wakali kutobela Jesu. Nibakamujata, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />wakachija kalichintanda, wakasiya mudabba.<verse eid="MRK 14:52" /></para>
  <para style="s">Jesu Kunembo Lyankuta</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mateyu 26:57-68</ref>; <ref loc="LUK 22:54">Lukku 22:54</ref>,<ref loc="LUK 22:55">55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13">Joni 18:13</ref>,<ref loc="JHN 18:14">14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Eelyo Jesu bamukatola kumupayizi mupati, akuba abapati babapayizi boonse, baalu abayiisyi bamulawu bakabungana aamwi. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Pita wakamutobela kali kule, kuyoosika kulubuwa lwaŋanda yamupayizi mupati. Nkukonya wakakkala abalindizi alimwi wakayota mulilo. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />Lino bapayizi bapati ankamu yoonse yaBasinkuta mpati iitegwa Sanihedilini bakalikuyanduula bukamboni atala aJesu kuti bamujaye, pesi taakwe nibakabujana pe. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Bayingi bakapa bukamboni bwakubeja atala anguwe, pesi twaambo twabo tetwakali kweendelana pe.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Eelyo bamwi bakayimikila bapa bukamboni bwakubeja atala anguwe bakati, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“Twakamumvwa kaamba kuti, ‘Ndiyoomweya ŋanda yaLeza eeyi yakachitwa amaboko abantu, mpawo mumazuba aatatu ndiyooyaka iimbi, itayakwi amaboko abantu pe.’ ” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Pesi bukamboni bwabo teebwakeendelana pe.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Mpawo mupayizi mupati wakayimikila kunembo lyabo akubuzya Jesu, “Sena tukwe nsandulo? Oobu bukamboni mbwanzi, aaba bantu mbubaliikupa atala anduwe?”<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />Pesi Jesu wakawumuna alimwi tapede nsandulo pe. Mupayizi Mupati wakamubuzya lubo, “Sena nduwe Kkirisitu, Mwana waLeza Ulongezezegwe?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Jesu wakati, “Ndime, alimwi uyoobona Mwana waMuntu kakkede kuluboko lwalulyo lwaSinguzu akuboola mumayoba amujulu.”<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Mupayizi Mupati wakadeluula zisamo zyakwe mpawo wati, “Nkaamboonzi nituchiyanda bakamboni bambi? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Mwamumvwa mbwasampawula. Mutyeni?”</para>
  <para style="p" vid="MRK 14:64">Boonse bakamupa mulandu weelede lufu. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />Eelyo bamwi bakatalika kumuswida mate; bamuvumba kubusyu, bamuuma antuku zyabo, akwaamba kuti “Aamba!” Mpawo balindizi bakamubweza bakamumata mabayi.<verse eid="MRK 14:65" /></para>
  <para style="s">Pita Mbwaatama Jesu</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mateyu 26:69-75</ref>; <ref loc="LUK 22:56-62">Lukku 22:56-62</ref>; <ref loc="JHN 18:15-18">Joni 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Pita naakachili mulubuwa lwaŋanda yamupayizi, umwi musimbi, mulanda waMupayizi Mupati wakasika. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Naakabona Pita kayota mulilo, wakamuzilikila wakati, “Ayebo mwakali aamwi ayooyu Jesu muna Nazareti.”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Pesi wakaka. Wati, “Taakwe nchindizi pe nikuba kumvwisisisya atala anchulookwaamba,” mpawo wakazwa weenda waya kumulyango walubuwa.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />Aawo mulanda musimbi naakamubona, wakaamba lubo kulibaabo boonse bakali muzyungulukide, “Alakwe ooyu muntu nguumwi wabo.” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Pesi wakakaka lubo.</para>
  <para style="p" vid="MRK 14:70">Nikwakayinda kayindi kaniini, aabo bakaliimvwi afwiifwi bakaamba kuti kuli Pita, “Kasimpe uli uumwi wabo, nkaambo uli muna Galili.”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Eelyo Pita wakati, “Pesi ndikonka kuti ndaamba kasimpe! Leza andipe chisubulo kuti kandili ndime! Tandimwizi pe ooyo mwaalumi ngumwaambuula atala anguwe!”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Mpawawo mukuku wakalila kachibili. Eelyo Pita wakayeeya majwi Jesu wakakokolika wamwaambila: “Mukombwe katanaakukokolika tubili uyoonditama tutatu.” Alimwi wakawusa akulila.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Jesu kunembo LyaPayileti</para>
  <para style="r">(<ref loc="MAT 27:1">Mateyu 27:1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Lukku 23:1-5</ref>; <ref loc="JHN 18:28-38">Joni 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Chifumofumo, bapayizi bapati abaalu, abayiisyi bamulawu ankuta yoonse bakachita mabambe aabo. Mpawo bakamwaanga Jesu bamutola akuyoomupeda kuli Payileti. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Payileti wakamubuzya kuti,“Uli Mwami waba Juda na?”</para>
  <para style="p" vid="MRK 15:2">Jesu wakavwiila wati, “Kuli mbuli mbwaamba.”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Bapayizi bapati bakamutamikizya Jesu twaambo twiingi. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Lino Payileti wakamubuzya lubo wati, “Tusanduli na? Laanga twavula twaambo ntubaliikukutamikizya.”<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Pesi Jesu taakwe naakamuvwiila pe, mpawo Payileti wakagamba.<verse eid="MRK 15:5" /></para>
  <para style="s">Jesu Upegwa Chisubulo Chalufu</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mateyu 27:15-26</ref>; <ref loc="LUK 23:13-25">Lukku 23:13-25</ref>; <ref loc="JHN 18:39-19:16">Joni 18:39—19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Lino chakali chiyanza chaPayileti kuti kuchiindi chaPobwe lyaKwiindilila kwaangununa mwaange muntolongo ngubakanoonga bamukumbila. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Mwaalumi utegwa Bbarabbasi wakali muntolongo, kali antoomwe abamwi bakali amilandu wabupapi, bakajaya bantu muchiindi chakupapa. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Makamu abantu akasika kuli Payileti akumumukumbila kuti achite mbuli mbaanoonga kachita. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />Payileti wakababuzya kuti, “Muyanda kuti ndimwaangunwide Mwami waJuda naa?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Payileti nkaazi kale kuti lyakalibbivwe lyabapati babapayizi nchibakeeta Jesu kulinguwe.<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />Pesi bapayizi bapati bakayunga makamu abantu kuti Payileti aangunune Bbarabbasi. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Payileti wakababuzya lubo wati, “Ndichite biyeni, kuli ooyu ngumuti Mwami wabaJuda?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Bakoompolola bati, “Ngagankaminwe!”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Payileti wakabuzya kuti, “Nkaamboonzi? Wakachita mulanduunzi?”</para>
  <para style="p" vid="MRK 15:14">Pesi boonse bakoompolola bati, “Ngagankaminwe!”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Payileti wakabaangunwida Bbarabbasi kuzwa muntolongo, kayanda kubotezya bantu, wakalayilila basilumamba kuti bakwipuule Jesu, akubazumizya kuti bakamugankamine.<verse eid="MRK 15:15" /></para>
  <para style="s">Basilumamba Baweela aJesu</para>
  <para style="r">(<ref loc="MAT 27:27-31">Mateyu 27:27-31</ref>; <ref loc="JHN 19:2">Joni 19:2</ref>,<ref loc="JHN 19:3">3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Basilumamba bakatola Jesu kulubuwa lwaŋanda yamweendelezi, alimwi bakayita nkamu yoonse yabasilumamba nyina. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Bakamusamika chisamo chakamoomvwe, mpawo bamusamika musini wamaamvwa ngibakazambilila kuba nkata. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Alimwi bakatalika kumujuzya chakumuwela kabati, “Bulemeku kulinduwe, nuMwami wabaJuda!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Bakali kwiindulula kabamuuma amutwe amusako, kabamuswida mate. Kabafugeme amazwi aabo, bakakotamika mitwe yabo chakweenena kumulemeka. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Alimwi nibakamana kumuniyaka, bakamuzuununa chisamo chakamoomvwe akumusamika zisamo zyakwe. Eelyo bakamugwisya aanze bamutola kuti bakamugankamina.<verse eid="MRK 15:20" /></para>
  <para style="s">Kugankaminwa KwaJesu</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mateyu 27:32-44</ref>; <ref loc="LUK 23:26-43">Lukku 23:26-43</ref>; <ref loc="JHN 19:17-27">Joni 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Umwi mwaalumi uzwa kuSayirini, utegwa Sayimoni, wisi waAlekizanda aLufasi, wakali kuyabwiinda kazwa mumyuunzi kaya muchisi, mpawo basilumamba bakamwaangila kuti anyampule chiingano. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Eelyo Jesu bakamweeta kubusena butegwa Gologota “chaamba kuti Busena bwaChoompo.” <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Alimwi bakamupa wayini isweenene amusamu utegwa mili, pesi taakayinywa pe. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Mpawo bakamugankamina, , bakawuma nkakata kuti babone naa uumwi awumwi ulabweza chili alimwi bakaabana zyakusama zyakwe. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />Kwakali achikasalizi chazuba nibakamugankamina. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Bulembwi bwamulandu wakwe bwakali lembedwe boobu, “MWAMI WABAJUDA.” <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Jesu bakamugankamina aamwi ababbi babili, umwi kululyo lwakwe uumwi kulumwesi lwakwe. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />Mpawo malembe akazuzikizigwa aamba kuti, “Uyoobalwa aamwi a basizibi.”<note caller="+" style="f"><char style="fr" closed="false">15:28 </char><char style="ft" closed="false">aamwi malembe takwe munchaali pe ooyu. Iyizaya 53:12 </char></note><verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />Aabo bakali kwiinda awo mpaakagankamidwe bakali kumutukila. Bakali kutikiniya mitwe yabo kabaamba kuti, “Iwe, nuyoomwaya ŋanda yaLeza akwiiyaka mumazuba aatatu, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />seluka kuzwa achiingano ulifutule!”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Abalabo bamwi bapayizi bapati abalembi bakamuwela kabaambilana kuti, “Wakali kufutula bamwi pesi wakachilwa kulifutula! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Mumuleke Kkirisitu ooyu, Mwami waIzirayeli, aseluke lino kuzwa achiingano, kuti tubone, alimwi tusyome.”</para>
  <para style="p" vid="MRK 15:32">Abalabo mbaakagankaminwa aabo, bakamutukila.<verse eid="MRK 15:32" /></para>
  <para style="s">Lufu LwaJesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mateyu 27:45-56</ref>; <ref loc="LUK 23:44-49">Lukku 23:44-49</ref>; <ref loc="JHN 19:28-30">Joni 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Kuchiindi chakalanga bweeseme kwakaba mudima mupati munyika yoonse kuyoosika nilyakakunama. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Mpawo kuchiindi eecho Jesu wakoompolola ajwi pati wati, “Eloyi, Eloyi, lama sabbakkitani?” nkukuti, “Leza wangu, Leza wangu, wandisiyilaanzi?”<note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false">Intembawuzyo 22:1</char></note><verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Eelyo kuli bamwi bakaliimvwi afwiifwi nibakamvwa boobo, bakaamba kuti, “Amuswiilile, ulikwiita Elayija.” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />Umwi mwaalumi wakachijaana, waakunika nsinsa muwayini waangilila akasamu kalamfu, mpawo wapa Jesu kuti anywe. Wakati, “Lino amumusiye aliikke tubone na Elayija ulasika kuzoomuselusya.”<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Alimwi Jesu wakoompolola ajwi pati, mpawo wafwa.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Mpawo aawo mudabba wakusitikizya akuganuna muŋanda yaLeza wakadeluka kuzwa kujulu kuyoosika aansi. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Eelyo silutwe wamwaanda wabasilumamba, wakaliimvwi kunembo lyaJesu, wakamvwa koompolola kwakwe akubona mbwaakafwa, wakaamba kuti, “Choonzyo ooyu mwaalumi waliMwana waLeza!”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Bamwi banakazi bakali kulangilizya kabali kulekule. Akati kabo kwakali Meri wakuMagadala, Salome aMeri banyina aJakkobbu muniini aJozefu. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Muchiindi eecho Jesu naakali muGalili banakazi aaba bakamutobela akumukutawukila. Abamwi banakazi bayiingi bakatansya aawe kuJerusalema bakaliwo.<verse eid="MRK 15:41" /></para>
  <para style="s">Kulazikwa KwaJesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mateyu 27:57-61</ref>; <ref loc="LUK 23:50-56">Lukku 23:50-56</ref>; <ref loc="JHN 19:38-42">Joni 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Bwakali buzuba bwakulibambila, (nkukuti, buzuba butegwa Sabata kabutanaatalika). Nikwakaba goko, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Jozefu waku Arimatiya, umwi wabasilutwe Basinkuta Mpati wakala ampuwo, wakali kulindila bwami bwaLeza, wakalipeda kwiinka kuli Payileti kuyookumbila mutunta waJesu. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Payileti wakagamba kumvwa kuti Jesu wakali wafwa kale. Wakayita silutwe wamwaanda wabasilumamba, wakabuzya kuti Jesu wafwa kale naa. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Naakamvwa kuli silutwe wamwaanda kuti mbukubede, wakazumizya Jozefu kuti akabweze mutunta. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Lino Jozefu wakawula mudabba uuntetema, mpawo wakuuselusya mutunta, wawuputila mulinguwo, akuubikka muchibunda chakasyidwe mubbwe pati. Mpawo bakakunkulisya bbwe bajala mulyango wa achibunda. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Meri wakuMagadala aMeri banyina aJozefu bakabona mpaakalazikwa.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Kubuka KwaJesu</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mateyu 28:1-8</ref>; <ref loc="LUK 24:1-12">Lukku 24:1-12</ref>; <ref loc="JHN 20:1-10">Joni 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Nibwakamana buzuba bwaSabata, Meri wakuMagadala, Meri banyina Jakkobbu, aSalome bakawula butopozyo kuti bayiinke kuyoonanika mutunta waJesu. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Chifumofumo mubuzuba butaanzi bwamviki, zuba mbulyakapasula biyo bakayinka kuchibunda. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Alimwi bakabuzyaniya uumwi awumwi kuti, “Ngwani utaakatukunkulisizye bbwe kuzwa kumulyango wachibunda?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Pesi nibakalanga, bakabona bbwe pati kalili lyakunkulisigwa. Eeli bbwe lyakali pati loko. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Aboobo nibakanjila muchibunda, bakabona mwaalumi mukubusi, kasamide chisamo chituba ulikkede kulubazu lwakululyo, mpawo bakagamba.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />Wakati, “Mutagambi, mulanguula Jesu muNazareti, wakagankaminwa achiingano. Wabuka, Tawo pe aano! Amulange abusena mpubakamubikide. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Pesi kamuya, mukaambile basikwiiya bakwe, aamwi aPita kuti ulookwiinda kunembo lyanu kuya kuGalili. Nkukooko muyoomubona, mbuli mbwaakamwaambila.’ ”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Banakazi bakazwa muchibunda kabagambide akukankama, bakachija. Taakwe nikuba uumwi ngubakaambila pe, nkaambo bakaliyoowede.<verse eid="MRK 16:8" /></para>
  <para style="s">Jesu Uliboniya Kuli Meri WakuGadalini</para>
  <para style="r">(<ref loc="MAT 28:9">Mateyu 28:9</ref>,<ref loc="MAT 28:10">10</ref>; <ref loc="JHN 20:11-18">Joni 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />Eelyo Jesu naakabuka chifumo mumazuba butaanzi bwamviki, wakatanguna kulitondeezya lutaanzi kuli Meri wakuMagadala, uulya wakali amyuuya mibi iili musanu ayibili eeyo njaakaanda. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Meri wakayinka akuyoowambila bakali aaJesu, aabo bakali koomoka akulila. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Eelyo nibakamvwa kuti Jesu muumi, alimwi kuti Meri wamubona, teebazisyoma pe.<verse eid="MRK 16:11" /></para>
  <para style="s">Jesu Uliboniya Kuli Basikwiiya Babili</para>
  <para style="r">(<ref loc="LUK 24:13-35">Lukku 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Kuzwa aawo Jesu wakalitondeezya muchiimo chimbi kuli bamwi babasikwiiya babili nibakali kuya kumuunzi. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Aaba babili bakabweeda alimwi bakwaambila bamwi; pesi tabakwe nibakabasyoma pe.<verse eid="MRK 16:13" /></para>
  <para style="s">Jesu Uliboniya Kuli BaliKkumi Awumwi</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mateyu 28:16-20</ref>; <ref loc="LUK 24:36-49">Lukku 24:36-49</ref>; <ref loc="JHN 20:19-23">Joni 20:19-23</ref>; <ref loc="ACT 1:6-8">Inchito 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Musule lyaaya Jesu wakaliboniya kuli balikkumi awumwi nibakali kulya, wakabakalalila nkaambo kakubula lusyomo abusichinguni bwabo bwakukaka kusyoma aabo bakamubona kuzwa kuchiindi naakabuka. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Wakaamba kuti kulimbabo, “Kamuya munyika yoonse alimwi mukakambawuke makani mabotu kuzilengwa zyoonse. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Kufumbwa uusyoma alimwi wabbapatizigwa uyoofutulwa, pesi kufumbwa uutasyomi uyoobasimulandu. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Alimwi zitondeezyo eezi ziyoobatobela boonse basyoma, alimwi muzina lyangu bayoowanda myuuya mibi; bayoowambuula myaambo mipya; <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />bayoobweza inzoka amaboko aabo; alimwi nibayoonywa zijeya, tazikwe kuyoobachisa pe; bayoobika maboko aabo abachiswa, eelyo bachiswa bayoopona.”<verse eid="MRK 16:18" /></para>
  <para style="s">Jesu Utolwa Kujulu</para>
  <para style="r">(<ref loc="LUK 24:50-53">Lukku 24:50-53</ref>; <ref loc="ACT 1:9-11">Inchito 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Mwami Jesu naakamana kubaambila, wakatolwa kujulu mpawo wakakukkala kuluboko lwalulyo lwaLeza. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Eelyo basikwiiya bakazwa baya kuyookambawuka koonsekoonse, eelyo Mwami wakabeleka ambabo mukusinizya ijwi lyakwe azitondeezyo zyakalikubatobela.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>