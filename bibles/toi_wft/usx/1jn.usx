<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Tonga Translation Project</book>
  <para style="h">1 Joni</para>
  <para style="toc1">lungwalo Lutaanzi Lwakalembwa aJoni</para>
  <para style="toc2">1 Joni</para>
  <para style="toc3">1 Jn</para>
  <para style="mt2">Lugwalo Lutaanzi Lwa</para>
  <para style="mt1">JONI</para>
  <para style="imt">Manjililo</para>
  <para style="ip">
    <char style="bk">Lugwalo lutaanzi lwaJoni </char> lwakalembwa amutumwa Joni akati kaminyaka ilimakumi alimusanu kuyoosika kuminyaka ilimwaanda Kkirisitu kaali wazyalwa. Joni talilungununi mbuli mulembi pe, pesi chaandano chitaanzi chilatondeezya kuti nguukamboni wabuumi akubuka kwaJesu (1 Joni 1:1-3). Nzila njaakalembaayo muli Joni mutaanzi alubo ilikozyene loko anzila njaakalemba aayo mumakani mabotu mukwiinda muli Joni. Kulasyomwa kuti Joni wakalemba makani mabotu aJoni amagwalo aatatu alimbuli Joni mutaanzi, wachibili awachitatu naakachili kukkala muEfeso.</para>
  <para style="ip">Joni wakalemba lugwalo oolu kuli banaKkirisitu boonse alimwi kuchiindi eecho imbungano yakalijisi penzi kuzwa kunkamu yabantu bakali anjiisyo yakubeja naakuti bategwa “Basinotikki.” Bakalikusyoma kuti Jesu wakali Leza uzwide pesi teewakali muntu susu pe naakali anyika. Nkaambo kacheechi Joni ulemba atala akuba kamboni kubuumi bwaJesu alimwi akuti maboko aakwe akamujata Jesu (1 Joni 1:1-3). Joni wakalemba lugwalo oolu kuti azuzukizye lukondo lwakwe (1 Joni 1:4), kuti akwabilile basyomi kuti batabisyi (1 Joni 2:1), kuti akwabilile basyomi kunjiisyo yakubeja (1 Joni 2:26), akusinizya kubasyomi kuti bakafutulwa (1 Joni 5:13).</para>
  <para style="iot">Bwiime</para>
  <para style="io1">Joni upa manjililo alugwalo lwakwe achintu chimwi nchaakalulembela (1 Joni 1:1-4)</para>
  <para style="io1">Eelyo upandulula kuti Leza mumuni biyeni akuti tweelede kupona mbuli Jesu mbwakapona (1 Joni 1:5—3:10)</para>
  <para style="io1">Chitobela ulatuyeezya atala amulayizyo wakuyandana (1 Joni 3:11—5:12)</para>
  <para style="io1">Umanisya lugwalo lwakwe muli (1 Joni 5:13-21)</para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">Ijwi lyaBuumi</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />Tuliikumulembela atala ajwi lyabuumi, eelyo lyakaliwo kuzwa kumatalikilo, nditwakamvwa, akubona ameso eesu, nditwakalanga mpawo twalijata amaboko eesu, <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />buumi oobo bwakayubununwa, alimwi twakabubona, mpawo tulibakamboni kuli mbubo, akumwaambila buumi oobo butamani bwakali aTaata alimwi bwakayubununwa kulindiswe. <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />Tuliikumwaambila eecho nchitwakabona akumvwa, kuchitila kuti mube abulidilano mbutuli laabo iswe aTaata aMwana wakwe Mulombe Jesu Kkirisitu. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />Tuliikumulembela eechi kuchitila kuti lukondo lwesu<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">Aamwi magwalo achiindi aamba kuti lwabo</char></note> luzulile.<verse eid="1JN 1:4" /></para>
  <para style="s">Leza nguMumuni</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />Aaya ngiimakani ngitwakamvwa kuzwa kuMwana wakwe Mulombe alimwi ngitumwaambila, kuti Leza mumuni alimwi mulinguwe tamukwe mudima pe abuniini. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />Naa twaamba kuti tuli abulidilano anguwe pesi katucheenda mumudima, tulabeja alimwi tatuponi mukasimpe pe, <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />pesi naa tweendela mumumuni, mbuli lwakwe mbwali mumumuni, tuli abulyidilano umwi awumwi, alimwi bulowa bwaJesu, Mwana wakwe mulombe bulatusalazya kuzwa kuzibi choonse.<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />Naa twaamba kuti tatukwe chibi, twalyeena lwesu, alimwi kasimpe takali mulindiswe pe. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />Naa twalyaamba zibi zyesu kuliLeza, ulasyomeka alimwi uliluleme, mpawo uyoolekelela zibi zyesu akutusalazya kuzwa mukutalulama kwesu koonse. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />Naa twaamba kuti tatubisizye pe, tuliikumuchita mubeji, alimwi ijwi lyakwe talili mulindiswe pe.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">Kkirisitu Simwiimaakati Wesu</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />Nibana bangu nimuyandwa, ndiliikumulembela eechi kuchitila kuti mutabisyi, pesi kuti umwi wachita chibi, tujisi simwiimaakati aTaata, Jesu Kkirisitu ululeme. <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />Alimwi lwakwe nguuchipayizyo chazibi zyesu, alimwi peepe wazyesu luzutu, pesi alubo wazibi zyanyika yoonse.<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />Mpawo acheechi ngatulaba achoonzyo chakuti tulimwizi, naa twabamba milawu yakwe. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />Ooyo waamba kuti, “Ndilimwizi” pesi katalemeki milawu yakwe mubeji, alimwi kasimpe takali mulinguwe pe, <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />pesi kufumbwa ubamba ijwi lyakwe, luyando lwaLeza lwakasimpe mulinguwe luliluleme. Acheechi tujisi choonzyo kuti tuli mulinguwe. <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />Ooyo waamba kuti ulikkalilide muliLeza weelede kweenda munzila ikozyene ayakeenda aJesu Kkirisitu.<verse eid="1JN 2:6" /></para>
  <para style="s">Mulawu Mupya</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />Nimuyandwa, tandimulembeli mulawu mupya pe, pesi mulawu mukulukulu ngumwakalaawo kuzwa kumatalikilo. Mulawu ooyu mukulukulu ndiijwi eelyo ndimwakamvwa. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />Anukuti mulawu ngundilikumulembela mupya, ooyo wachoonzyo mulinguwe amulindinywe, nkaambo mudima uliikwiiinda alimwi mumuni wachoonzyo ulookumwinika kale.<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />Ooyo waamba kuti ulimumumuni alimwi kasula munyina uchili mumudima alino. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />Ooyo uyanda munyina ulakkalilila mumumuni, alimwi mulinguwo<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">ngachilaamba lubo kuti mulinguwe</char></note> taakwe chimuchita kuti alebwe pe. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />Pesi ooyo usula munyina ulimumudima alimwi weenda mumudima, mpawo takwizipe ooko ankwaya, nkaambo mudima wakawofwazya meso aakwe.<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />Ndiliikumulembela, nibana bangu nimuyandwa, nkaambo zibi zyanu zyalekelelwa ankaambo kakwe. <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />Ndiliikumulembela, nimataata, nkaambo mulimuzi ooyo wakaliwo kuzwa kumatalikilo. Ndiliikumulembela, nibaalumi bakubusi, nkaambo mwakamuzunda mubi.<verse eid="1JN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14" />Ndiliikumulembela nibana bangu, nkaambo mulimuzi Taata. Ndiliikumulembela, nimataata, nkaambo mulimuzi wakaliwo kuzwa kumatalikilo. Ndiliikumulembela, nibaalumi bakubusi, nkaambo muli bayumu, alimwi ijwi lyaLeza lilikkalilide mulindinywe, alimwi mwakamuzunda mubi.<verse eid="1JN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />Mutayandi nyika nikuba zintu zilimunyika. Naa umwi wayanda nyika, luyando lulimbuli lwaTaata taluli mulinguwe pe. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />Nkaambo kufumbwa zyoonse zilimunyika, kulombozya kwamubili akulombozya kwameso akulisumpula kwabuumi, tazizwi kuli Taata pesi munyika. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />Alimwi nyika ilayinda, akulombozya kwayo, pesi ooyo uchita kuyanda kwaLeza ulakkalilila kwalyoonse.<verse eid="1JN 2:17" /></para>
  <para style="s">Sikumukazya waKkirisitu</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />Nibana bangu, chaba chiindi chamamanino, alimwi mbuli mbumwakamvwa kuti sikumukazya waKkirisitu ulasika, aboobo lino basikumukazya bakwe Kkirisitu basika kale, nkikaako tulizi kuti nchiindi chakumamanino. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />Bakatuchija, pesi teebakali besu pe, nkaambo nikunga bakali besu, nikuli bakayinkilila anembo andiswe, pesi bakatuloboka, kuti chibe antanganana kuti boonse teebakali besu pe.<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />Pesi mwakananikwa aWusalala, alimwi moonse mulizi<note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="ft" closed="false">mulizi kasimpe</char></note> kasimpe. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />Ndiliikumulembela, peepe ankaambo kakuti tamukazi pe kasimpe, pesi ankaambo kakuti mulikazi, alimwi mulizi kuti taakwe kubeja mukasimpe.<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />Eelyo ngwani mubeji? Ngooyo ukaka kuti Jesu nguuKkirisitu. Muntu uliboobo ngusikukazya Kkirisitu, ukaka Taata aMwana Mulombe. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />Taakwe ukaka Mwana Mulombe ujisi Wisi. Ooyo uzumina Mwana Mulombe uli aWisi lubo.<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />Amulange eecho nchimwakamvwa kuzwa kumatalikilo chikkalilile mulindinywe. Kuti eecho nchimwakamvwa chakkalilila mulindinywe, eelyo muyookkalilila muMwana Mulombe amuli Wisi. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />Alimwi eechi nchiinchicho nchakatusyomezya, kutupa buumi butamani.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />Ndiliikumulembela zintu atala abaabo balikweezya kumuchenga, <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />pesi bunanike mbumwakatambula kuzwa kuli Kkirisitu bulikkalilide mulindinywe, alimwi takuchiyandi umwi muntu pe kuti amuyiisye, nkaambo bunanike bwakwe mbuumuyiisya atala azyoonse, alimwi nichoonzyo, mpawo taakwe kubeja pe, mbuli mbubwakamuyiisya, mukkalilile mulinguwe.<verse eid="1JN 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />Alimwi lino, nibana, mukkalilile mulinguwe, kuchitila kuti naa waakuliboniya tukabe abusichaamba, alimwi tutakabi abweeme kukuboola kwakwe. <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />Naa kamuzi kuti uliluleme, muyooba achoonzyo kuti woonse uchita chibotu mwana waLeza.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">Bana BaLeza</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />Amulange kuti nduyando lupati biyeni Taata ndwaakatupa, lwakuti twiitwe kuti bana baLeza, aboobo tulimbabo. Nyika tiituzi pe nkaambo teeyakamuziba pe. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />Nibayandwa, lino tulibana baLeza, takuna yubununwa pe kuti tuyoobaanzi, pesi tulizi kuti nayooliboniya tuyoba mbuli nguwe, nkaambo tuzomubona mbuli mbwabede. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />Alimwi kufumbwa ulaabulangilizi muli Kkirisitu ulalisalazya mbuli mbwasalala alakwe.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />Kufumbwa uchita chibi ulaamulandu wakutyola mulawu waLeza, nkaambo chibi nkutyola mulawu. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />Mulizi kuti wakaliboniya kuti agwisye zibi, mpawo mulinguwe tamukwe chibi pe. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />Taakwe ukkalilila mulinguwe unooya buchita chibi pe, taakwe pe ubisya wakamubona nikuba kumuziba.<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />Nibana bangu nimuyandwa, kutabi umweena. Kufumbwa uchita ziluleme, uliluleme, mbuli Kkirisitu mbwaluleme. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />Kufumbwa uchita chibi nguwaSikuchenga mupati, nkaambo Sikuchenga wakabisya kuzwa kumatalikilo. Zyakachita kuti Mwana Mulombe waLeza ayubununwe nkuti alobye milimu yaSikuchenga.<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />Taakwe uzyalwa kwaLeza unooya buchita chibi pe, nkaambo chiimo chaLeza chilikkalilide mulinguwe, alimwi taakwe nachinooya bubisya pe nkaambo uzyedwe kwaLeza. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />Acheechi kulabonwa kuti mbaani bana baLeza, alimwi mbaani bana baSikuchenga, kufumbwa utachiti chibotu teesi waLeza pe, nikuba utayandi munyina.<verse eid="1JN 3:10" /></para>
  <para style="s">Kuyandana</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />Nkaambo aaya ngimakani ngimwakamvwa kuzwa kumatalikilo, kuti tweelede kuyandana. <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />Alimwi peepe kuba mbuli Kkayini pe wakali wamubi alimwi wakajeya mwanike wakwe. Alimwi nkaamboonzi naakamujeya? Nkaambo milimu yakwe mwini yakali mibi mpawo yamwanike wakwe yakali luleme.<verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />Nibakwesu, mutagambi, kuti nyika yamusula. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />Tulizi kuti twakayinda kuzwa kulufu katuya mubuumi, nkaambo tulabayanda bakwesu. Kufumbwa utakwe luyando ulakkalilila mulufu. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />Kufumbwa usula mukulana wakwe mujayi, alimwi mulizi kuti taakwe mujayi uli abuumi butamani bukkalilila mulinguwe. <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />Mbumbuboobu Jesu Kkirisitu mbutuzi chaamba luyando, kuti wakatula buumi bwakwe nkaambo kandiswe, mpawo tweelede kutula buumi bwesu nkaambo kabakwesu. <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />Pesi kuti umwi ulijisi zintu zyanyika mpawo wabona munyina kabulide, pesi katakwe luzyalo anguwe, luyando lwaLeza lulakkalilila biyeni mulinguwe? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />Nibana bangu nimuyandwa, tutayandi mumajwi biyo nikuba kwaambuula pesi mukuchita amukasimpe.<verse eid="1JN 3:18" /></para>
  <para style="s">Bukozu Kunembo LyaLeza</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />Acheechi tuyooziba kuti tuli bakasimpe, akuba achoonzyo mumyoyo yesu kunembo lyakwe, <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />kufumbwa myoyo yesu niitupa milandu, nkaambo tulizi kuti Leza mupati kwiinda myoyo yesu, alimwi uzi zyoonse. <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />Nibayandwa, kuti myoyo yesu kayitatupi mulandu, tuli abusichaamba kunembo lyaLeza, <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />alimwi tulatambula kulinguwe kufumbwa nchitukumbila, nkaambo tubamba milawu yakwe akuchita zimubotezya. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />Alimwi ooyu nguumulawu wakwe, kuti tweelede kusyoma muzina lyaMwana wakwe Mulombe Jesu Kkirisitu akuyanda umwi awumwi, mbuli mbwakatulayilila. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />Boonse baswiilila milawu yakwe balakkalilila mulinguwe, alakwe mulimbabo. Alimwi acheechi tulizi kuti ulakkalilila mulindiswe, aMuuya ngwaakatupa.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">Muuya Wakasimpe Amuuya Walweeno</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />Nimuyandwa, mutasyomi kufumbwa muuya, pesi ngamweezye myuuya kuti naa njakwa Leza, nkaambo basinsimi babeji bayingi bakazula kale munyika. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />Acheechi mulaziba Muuya waLeza, muuya woonse waamba kuti Jesu Kkirisitu wakaza mumubili nguuwa Leza, <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />alimwi muuya woonse utazumini Jesu teesi waLeza pe. Ooyu nguumuuya wakukazyaniya, ooyo ngumwakamvwa kuti uliikuza, alimwi lino ulimunyika kale.<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />Nibana bangu bayandika, muli bakwaLeza, alimwi mwakabazunda, nkaambo ooyo ulimulindinywe mupati kwiinda ooyo ulimunyika. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />Nkikaako mbanyika, nzibaamba nzyanyika, mpawo nyika ilabaswiilila. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />Tuli bakwaLeza. Kufumbwa uzi Leza ulatuswiilila, alimwi ooyo utali waLeza tatuswiilili pe. Acheechi tuluuziba Muuya wakasimpe amuuya walweeno.<verse eid="1JN 4:6" /></para>
  <para style="s">Leza Nduyando</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />Nimuyandwa, ngatuyandane, nkaambo luyando luzwa Leza, alimwi ooyo uyanda ulizyedwe kwaLeza alimwi ulimwizi Leza. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />Ooyo utakwe luyando tamwizi pe Leza, nkaambo Leza nduyando. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />Muli eechi luyando lwaLeza lwakachitwa kuti luboneke akati kesu, kuti Leza wakatuma Mwana wakwe Mulombe umwi luzutu munyika, kuchitila kuti tukapone mukwiinda mulinguwe. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />Muli eechi muuli luyando lwakasimpe, peepe kuti twakayanda Leza pesi kuti wakatuyanda akutuma Mwana wakwe Mulombe kuti abe chipayizyo chazibi zyesu.<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />Nimuyandwa, mbukunga Leza wakatuyanda oobo, iswe aswebo tweelede kuyandana. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />Taakwe muntu walinabona Leza pe, kuti twayandana, Leza ulakkalilila mulindiswe alimwi luyando lwakwe luliluleme mulindiswe.<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />Acheechi tulizi kuti tulakkalilila mulinguwe alimwi alakwe mulindiswe, nkaambo wakatupa Muuya wakwe. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />Alimwi twakabona akwaamba kuti Taata wakatuma Mwana wakwe Mulombe mbuli Mufutuli wanyika. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />Kufumbwa uzumina kuti Jesu Mwana Mulombe waLeza, Leza ulakkalilila mulinguwe, alimwi alakwe muliLeza. <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />Aboobo tulizi akusyoma luyando Leza ndwalaalo kulindiswe.</para>
  <para style="p" vid="1JN 4:16">Leza nduyando, alimwi ooyo ukkalilila muluyando ulakkalilila muli Leza, mpawo Leza ulakkalilila mulinguwe. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />Muli eechi luyando lulazuzikizigwa andiswe, kuti tukabe abusichaamba nkaambo kabuzuba bwalubeta, nkaambo mbuli mbwali boobo andiswe mbutubede munyika eeyi. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />Taakwe kuyoowa pe muluyando, pesi luyando lwakasimpe lulatanda buyoofu. Nkaambo kuyoowa kuli achakuchita achisubulo, alimwi kufumbwa uyoowa taluleme pe muluyando.<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />Tulayanda, nkaambo Leza wakaba mutaanzi kutuyanda. <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />Kuti umwi waamba kuti, “Ndilamuyanda Leza,” mpawo kasula munyina wakwe, mubeji, nkaambo kufumbwa utayandi munyina wakwe ooyo ngwakabona, teenga ulayanda Leza pe ooyo ngwatabwene. <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />Alimwi ooyu mulawu ngutulaawo uzwa kulinguwe, wakuti ooyo uyanda Leza uleelede ayande munyina wakwe lubo.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">Kuzunda Nyika Kwesu</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />Woonse usyoma kuti Jesu nguKkirisitu wakazyalwa aLeza, alimwi woonse uyanda muzyali ulayanda mwana. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />Acheechi tulizi kuti tulabayanda bana baLeza, kuti twayanda Leza akuswiilila milawu yakwe. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />Nkaambo oolu nduyando lwaLeza, kuti tubambe milawu yakwe. Alimwi milawu yakwe tiili miyumu pe. <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />Nkaambo kufumbwa woonse uzyalwa kwaLeza ulayizunda nyika, alimwi lusyomo lwesu oolu, nduuluzundo luzunda nyika. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />Ngwani ooyo uzunda nyika pesi ngooyo usyoma kuti Jesu Mwana Mulombe waLeza?<verse eid="1JN 5:5" /></para>
  <para style="s">Bukamboni Atala aJesu Kkirisitu</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />Jesu Kkirisitu ooyu, nguuwe wakaza ameenda abulowa, peepe ameenda luzutu pesi ameenda abulowa. Alimwi Muuya nguukamboni, nkaambo Muuya nkasimpe. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />Kuli bakamboni batatu, <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />Muuya, meenda, abulowa mpawo eezi zitatu zilazuminana. <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />Kuti twatambula bukamboni bwabantu, bukamboni bwaLeza mbupati, nkaambo oobu mbuubukamboni bwaLeza oobo mbwakapa atala aMwana wakwe Mulombe. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />Kufumbwa usyoma muMwana Mulombe waLeza uli abukamboni mulinguwe. Kufumbwa utasyomi Leza wamuchita mubeji, nkaambo teewasyoma mubukamboni oobo Leza mbwakapa kuMwana wakwe Mulombe. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />Mpawo oobu mbuubukamboni, kuti Leza wakatupa buumi butamani, alimwi buumi oobu buli muMwana wakwe Mulombe. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />Kufumbwa uli aMwana Mulombe ulaabuumi, kufumbwa utakwe Mwana Mulombe waLeza taakwe buumi pe.<verse eid="1JN 5:12" /></para>
  <para style="s">Buumi Butamani</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />Ndalemba eezi kulindinywe nimusyoma muzina lyaMwana Mulombe waLeza, kuti mukazibe kuti mulijisi buumi butamani. <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />Alimwi oobu mbubusichaamba mbutuli aabo mulinguwe, kuti naa twakumbila kufumbwa mukwiinda mukuyanda kwakwe ulatumvwa. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />Alimwi kuti katuzi kuti ulatumvwa mukufumbwa nchitukumbila, tulizi kuti twajana eezyo nzitukumbila kulinguwe.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />Kuti umwi wabona munyina kachita chibi eecho chitatoli kulufu, uyoomukumbilila, alimwi Leza uyoomupa buumi. Ndiliikwamba atala abaabo chibi chabo chitatoli kulufu. Kuli chibi chitola kulufu, tandaambi kuti umwi weelede kukombela eecho pe. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />Koonse kubisya nchibi, pesi kuli chibi chitatoli kulufu pe.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />Tulizi kuti woonse uzyedwe kwaLeza tachinooyo bisyi pe, pesi ooyo Mwana Mulombe waLeza ulamubamba, alimwi mubi tamugumi pe.<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />Tulizi kuti tuli bakwaLeza, alimwi nyika yoonse ilimunguzu zyamubi.<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />Mpawo tulizi kuti Mwana Mulombe waLeza wakasika alimwi wakatupa kumvwisisisya, kuti tumuzibe ooyo wachoonzyo, alimwi tuli mulinguwe ooyo wachoonzyo, muMwana wakwe Mulombe Jesu Kkirisitu. Ooyu nguLeza wachoonzyo abuumi butamani.<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />Nibana bangu nimuyandwa, ngamusosoloke kuzwa kumituni.<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>