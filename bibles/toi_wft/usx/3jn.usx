<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Tonga Translation Project</book>
  <para style="h">3 Joni</para>
  <para style="toc1">Lugwalo Lwachitatu Lwakalembwa aJoni</para>
  <para style="toc2">3 Joni</para>
  <para style="toc3">3 Jn</para>
  <para style="mt2">Lugwalo Lwachitatu Lwa</para>
  <para style="mt1">JONI</para>
  <para style="imt">Manjililo</para>
  <para style="ip">
    <char style="bk">Lugwalo lwachitatu lwaJoni </char> lwakalembwa amutumwa Joni akati kaminyaka ilimakumi alimusanu kuyoosika kuminyaka ilimwaanda, Kkirisitu kaali wazyalwa. Joni talyaambi pe kuti nguumulembi, pesi ulyaamba kuti mwaalu (3 Joni 1:1). Uchita mbuboobo muli Joni wachibili (2 Joni 1:1). Kusyomegwa kuti Joni wakalemba makani mabotu mukwiinda muli Joni amagwalo aatatu Joni mutaanzi, wachibili aJoni wachitatu naakali kukkala muEfeso.</para>
  <para style="ip">Joni wakalemba lugwalo oolu kumusyomi utegwa Geyiyasi. Upandulula Geyiyasi mbuli mweenzunyina alimwi ulamulayilila kuti abe usamawusya babunyina muli Kkirisitu aabo bayabwiinda mubusena oobo.</para>
  <para style="iot">Bwiime</para>
  <para style="io1">Joni upa manjililo alugwalo lwakwe (3 Joni 1:1)</para>
  <para style="io1">Eelyo usungwazya Geyiyasi alimwi ulamulayilila kuti asamawusye babunyina (3 Joni 1:2-8)</para>
  <para style="io1">Chitobela, waambuula atala abaalumi bambi babili, Diyoterefisi aDemetiriyasi (3 Joni 1:9-12)</para>
  <para style="io1">Kumamanino umanisya lugwalo lwakwe (3 Joni 1:13-14)</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Kuzwa kumwaalu.</para>
  <para style="p" vid="3JN 1:1">Kuli uyandwa Geyiyasi, ooyo ngundiyanda mukasimpe.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Nuuyandwa, ndakomba kuti zyoonse zikweendele kabotu alimwi kuti upone kabotu, mbuli mbundizi kuti ulikabotu mumuuya wako. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Nkaambo ndakabotelwa kapati aawo bamwi babakwesu nibakasika alimwi bapa bukamboni atala akusyomeka kwako mumakani mabotu akasimpe, mbuli choonzyo mbupona mukasimpe. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Taakwe lukondo lupati ndundinga ndilabaalo lwiinda oolu, kumvwa kuti bana bangu bapona mukasimpe.<verse eid="3JN 1:4" /></para>
  <para style="s">Geyiyasi Ulalumbilizigwa</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Nuuyandwa, nchintu chibotu nchuchita naa wawutawukila kubakwesu, kapati banakweenda, <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />aabo bakapa bukamboni atala aluyando lwako kunembo lyambungano. Uyoochita kabotu kuti wabagwasya mulweendo lwabo munzila ilemeka Leza. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Nkaambo bakali mulilolu lweendo ankaambo kakwe alimwi taakwe nibakatambula lugwasyo pe luzwa kulibaabo batazi Leza. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Aboobo tweelede kugwasya bantu baliboobo, kuti tukabe basimulimunyina ankaambo kakasimpe.<verse eid="3JN 1:8" /></para>
  <para style="s">Diyoterefisi aDemetiriyasi</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Ndakalemba lugwalo lufwiifwi kumbungano, pesi Diyoterefisi, uyanda kulibikka mutaanzi, tatambuli bweendelezi bwesu pe. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Aboobo kuti ndasika, ndizomweetela eezyo nzyaliikuchita, waambula majwi mabi atala andiswe. Alimwi teembubo luzutu, ulakaka kutambula babunyina, alimwi lubo ukasya aabo bayanda kubatambula mpawo ulabatanda mumbungano.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Nuuyandwa, utatobeli bubi pesi utobele bubotu. Ooyo uchita chibotu nguuwakwa Leza, ooyo uchita bubi tanabona Leza pe.<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />Demetiriyasi ujisi bukamboni bubotu kuzwa kubantu boonse, akukasimpe lwako, andiswe tulapa bukamboni atala anguwe, alimwi mulizi kuti bukamboni bwangu mbwakasimpe.<verse eid="3JN 1:12" /></para>
  <para style="s">Kujuzya KwaKumamanino</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Ndalijisi zyiingi zyakukulembela, pesi tandikwe kulemba achilembyo amulende pe. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Ndilangilila kukubona kufwambana, mpawo tuzowambuule katulangene.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />Luumuno lube kulinduwe.</para>
  <para style="p" vid="3JN 1:15">Beenzunyokwe boonse balakujuzya. Ujuzye beenzuma boonse, umwi awumwi.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>