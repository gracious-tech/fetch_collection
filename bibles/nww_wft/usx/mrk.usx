<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">MRK-NDWEWE Bible Version</book>
  <para style="h">Maliki</para>
  <para style="toc1">Nhalo ghwa Maha handa paghutyekwite na Maliki</para>
  <para style="toc2">Maliki</para>
  <para style="toc3">Malk</para>
  <para style="mt2">Nhalo ghwa Maha handa paghutyekwite na</para>
  <para style="mt1">Maliki</para>
  <para style="imt">Ulongoleho</para>
  <para style="ip">
    <char style="bk">Nhalo ghwa Maha handa paghutyekwite na Maliki</char> ndo kimoo kya hitabho ncheche mu Ninganilo lya Hyono hyene hina kulubhulila ulami ghwa Yesu Kilisto. Kila kimo kingukemwa, “Injili,” Mana yake “Nhalo ghwa Maha.” Mbole ya kughwegha kwa Yesu Kilisto yikityekwa na Matayu na Maliki na Lukasi na Yohana. Nhalo ghwa Maha handa paghutyekwite na Maliki ghubha nhupitaho kupitingana kwa Mihalo ya maha hyoha ncheche. Bhubho yinguhyubhalilwa kukita ghukityekwa kalongohi ya mihalo hyoha mu ngungwa ya 65-70 Mbole ya kubhelekwa Yesu. Bhana kusoma atangalo bhanguhyubhalila kukita kikityekwa akwo Loma kwa kya kubhakamula mabhokoa Akaakilisto ghwa ako Loma.</para>
  <para style="ip">
    <char style="bk">Maliki</char> kangumanjika bhubho handa Yohana Maliki, kakibhegha na nhangwo na nndumitumi Paulo na Balinaba peni nhwanganwo bhabhe ghukipechenganika na mwanga ghwabhe ghwa kindume (Andumitumi 13:13). Mboli yake Maliki Kakibhegha mumwanja na Balinaba (Akaandundame 15:37-39). Maliki kangumanyika bhubho handa nghanja ghwa Petili (Petili gwa ulongohi 5:13). Hata yingabhe Maliki kakibha nnyimiho ghwa mehu ng'obhe ghwa ulamo ghwa Yesu, Bhanakusoma bhanguhyubhalila kukita Maliki kakipata mihalo miyoloho kuhuma mu uyimiho ghwa Petili na aki ndo kitumbilo kya Nhalo ghwa Maha handa paghutyekitwe na Maliki. Mu Nhalo aghu ghwa Maha Maliki kakilinga ghuhundwa na mahundo gha Yesu mu uhiko.</para>
  <para style="iot">Ghahabheghite</para>
  <para style="io1">Maliki kangukikambuha kitabho mu Nlyango 1:1-13.</para>
  <para style="io1">Maliki kangulubhulila Undumi ghwa Yesu ku Galilaya Nlyango 1:14–8:21</para>
  <para style="io1">Mwanja ghwa Yesu kughenda ku Yelusalemu Nlyango 8:22–10:52</para>
  <para style="io1">Maliki kanguyomolela kwa kutyeka pala Yesu pakabheghite ku Yelusalemu, pamamo na kiho kyake na kuhyuka kwake Nlyango 11:1-16:8</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Yohana Ynakubatisa kangualandamiha bhandu</para>
  <para style="r">
    <ref loc="MAT 3:1-12">Matayu 3:1-12</ref>; <ref loc="LUK 3:1-18">Lukasi 3:1-18</ref>; <ref loc="JHN 1:19-28">Yohane 1:19-28</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Aghu ndo ulongohi ghwa Nhalo ghwa Maha ghwa Yesu Kilisto, Mwana ghwa Chapanga <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />Ghukiyanda handa payityekwite mukitabho kya mbuye ghwa Chapanga ywakakemitwe Isaya,</para>
  <para style="q" vid="MRK 1:2">“Chapanga kakighomba ‘Nannlaghiha ndumitumi ghwangu muulongolo ghwako</para>
  <para style="q" vid="MRK 1:2">katayitendekeha njila yako.’<verse eid="MRK 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MRK 1:3" />Lilobhe lya mundu lingukema kukibhala;</para>
  <para style="q" vid="MRK 1:3">‘Muyitendekhe njila ya Bambo,</para>
  <para style="q" vid="MRK 1:3">muyighololehe ndyangilo yake.’ ”<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />Yohana yunakubatisa kakibwitukila kukibhala, pakabatisa na kubhalandamiha bhandu pakighomba, “Mulipetule kyakya ulemwa ghwenu na mbatiswe na mwene Chapanga kataghulekekeha ulemwa ghwenu.” <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Bhandu atangalo bhakinng'endela kuhuma ku nnima ghwa Yudea na bhoha bha kitami kya Yelusalemu bhakinng'endela na bhakilipetula uhokelo ghwabhe naywo kakiabatisa mulukemba lwa Yoludani.<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />Yohana kakihwala lipinda litendekehitwe kwa mayuni gha nnyama ywakakemitwe ngamia na nkungi ghwa liyula mukibhuno kyake. Hilyo hyaki hikibhegha mapalala na bhuchi. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Naywo Yohane kakialandamiha bhandu pakaaghombela “Ywakapala kuhika mbole ya nenga kabhegha na makakala makulu kupitingana kwa nenga, nenga yiteghekwa ng'obhe hokame na kulegheha ngoyi gha makobasi ghake. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Nenga ndabhabatisa kwa machi, peni ywombe kataabatisa kwa Nhuki ghwa Chapanga.”<verse eid="MRK 1:8" /></para>
  <para style="s">Kubatiswa na kung'ehwa kwa Yesu</para>
  <para style="r">
    <ref loc="MAT 3:13-4:11">Matayu 3:13—4:11</ref>; <ref loc="LUK 3:21">Lukasi 3:21</ref>,<ref loc="LUK 3:22">22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Mumanjubha agho Yesu kakihika kuhuma Nasaleti kitami kya ku Galilaya naywo kakibatiswa na Yohana mulukemba lwa Yoludani. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Kamu Yesu pakahumite mumachi, kakibhona luhingu lukiyughuka na Nhuki ghwa Chapanga kakinhulukila unani ghwake handa ngunda. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Lilobhe likiyihwanika kuhuma kunani; “Ghwenga ndo! Mwana ghwangu yunughupala nungunoghelwa na ghwenga.”<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Pala pala! Nhuki ghwa Chapanga kakinlongoha kughenda kukibhala, <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />kakitama akwo manjubha alobaini kunu pakang'ehwa na Nchipila, kakibhegha papamu na anyama bha kunhitu, nabho mahoka bha Chapanga bhakihika kuntumikila.<verse eid="MRK 1:13" /></para>
  <para style="s">Yesu kanguakema aghomeha homba ncheche</para>
  <para style="r">
    <ref loc="MAT 4:12-22">Matayu 4:12-22</ref>; <ref loc="LUK 4:14-15">Lukasi 4:14-15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Yohana pakabhopwite kukibhopo, Yesu kakighenda ku Galilaya, kakiyanda kulandamiha Nhalo ghwa Maha ghwa Chapanga, <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />kunu pakaghomba, “Uhiko uhika kala, na Ghubhutwa ghwa Chapanga ghunguheghelela; Mulipetule na kuhyubhalila Nhalo ghwa Maha ghwa Chapanga.”<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Yesu pakabheghite mukutyanga mumbwegha ya lihibha lya Galilaya, kakiabhona Simoni na Andelea nnongo ghwake paatagha njaho hyabhe mulihibha; mana bhakibhegha aghomeha homba.<figure style="fig" file="07 Fishing.jpg" size="col" ref="1:16">Mundu kangughomeha homba kwa njaho</figure> <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Yesu kakiaghombela, “Munhikile, na nenga ndabhahunda kunnyeghela bhandu handa aghomeha homba paayegha homba.” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Pala pala, bhakiyileka njaho hyabhe na bhakintughila.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Pakatyangite kya mandina, kakiabhona Yakobu na Yohana, bhoha bhana bha Sebedayo. Nabho bhubho bhakibhegha mubhwato, paatandambuha njaho hyabhe. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Pala pala, kakiakema, nabho bhakinleka tate ghwabhe Zebedayo mubhwato papamu na andumitumi bhabhe, bhakighenda na kuntughila Yesu.<verse eid="MRK 1:20" /></para>
  <para style="s">Yesu kangulibhuha lindilu kwa mundu</para>
  <para style="r">
    <ref loc="LUK 4:31-37">Lukasi 4:31-37</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Yesu na ahundwa bhake bhakilongohana mbaka ku Kapelinaumu, palihikite linjubha lya kupumulila Yesu kakiyingila mu kitutubhi kya kukonganila Akaayahudi, na kakiyanda kuhunda. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Bhandu bhakikangacha munu kya mahundo ghake, mana kakibha mukubhahunda handa mundu yuna makakala, kiyaha kakilihwana ng'obhe na ahunda bha malaghilo.<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />Peni apo, pakibhegha mundu yunamandilo mu kitutubhi kya ngonganilo yabhe, naywo kakikyota kyobho <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />“Ghuna niki na twenga Yesu ghwa Nasaleti? Ghuhika kutukanjaghana? Manya kukita ghwenga ndo! Ghani, Nng'anyimo ghwa Chapanga!”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Yesu kakinlakalila, pakighomba, “Ghunyamale, Na ghunneke mundu ayu.”<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />Ghala mandilu ghakinnyukayuka kakikyota kyobho na kakinmuka. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />Bhandu bhoha bhakikangacha na kukonyekehana, “Ayi ndo mihalo ghani? Ndo Mahundo gha hyono? Kangi ghana makakala gha utabhala kanguakwilikiha mandilo nabho bhangu nnyitikila!”<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />Mihalo yake yikikwila kanongola nongola mumilima hyoha ya Galilaya.<verse eid="MRK 1:28" /></para>
  <para style="s">Yesu kangualamiha bhandu atangalo</para>
  <para style="r">
    <ref loc="MAT 8:14-17">Matayu 8:14-17</ref>; <ref loc="LUK 4:38-41">Lukasi 4:38-41</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Bhakibhuka mu kitutubhi kya kukonganila bhakighenda papamu na Jakobu na Yohana mbaka kulubhagha lwa Simoni na Andelea. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Na ma ghwa nhumbu ghwa Simoni kakibha na nhehemela tepatepa paulili, bhakinkambukiha Yesu mihalo yake. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Ndo Yesu kakinng'endela, na kunkamula kibhoko na kunnyinula. Mbole nhehemela ghukinnekekeha, naywo kakiyanda kuakeyela.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Payihikite makimuhi, na luchubha palutipikiti, bhakinng'eghela Yesu bhandu bhananhehemela na bhaakwelitwe na mandilo. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Bhandu bhoha bha kitami kila bhakikwemukila paulongolo ghwa kitutubhi kya Simoni. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Yesu kakialamiha atamwa atangalo na bhana mihehemela nhanganganiko na kakiabhuha mandilo atangalo, peni kakibhaleka ng'obhe ghala mandilu bhaghombe kiyaha bhakimanya kukita ywombe ndo ghani.<verse eid="MRK 1:34" /></para>
  <para style="s">Yesu kangulandamiha Ku nnima ghwa Galilaya</para>
  <para style="r">
    <ref loc="LUK 4:42-44">Lukasi 4:42-44</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Malabhila putiputi pangeha kukali na lubhindu, Yesu kakibhuka ngati kaghende panga bhandu kakan'tundamile Chapanga. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Simoni na ayake bhakighenda kunpalaha, <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Paammonite, bhakinng'ombela “Bhandu bhoha angughupalaha!”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Yesu kakiayanga, “Tughende pamoo pangi pa hitami hya nng'eghela, ngalandamihe na akwo nakwo, kiyaha akyo ndo kinikihikilite.”<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />Kakitindila Galilaya hyoha, kakilandamiha muhitutubhi ya kukonganikila Akaayahudi na kughabhuha mandilo.<verse eid="MRK 1:39" /></para>
  <para style="s">Yesu kangunlamiha mundu yunamaloha</para>
  <para style="r">
    <ref loc="MAT 8:1-4">Matayu 8:1-4</ref>; <ref loc="LUK 5:12-16">Lukasi 5:12-16</ref></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Mundu yumu ywakabheghite na maloha kakinng'endela Yesu, kakinchutamila mayughwa na kunnyupa, na kung'ombela, “Paghupala, ghwahotola kunghulula!”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Yesu kakimmonela luhungu, kakigholoha kibhoko kyake kakinnyabhika kunu pakanng'ombela “Ningupala ghululika!” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Kamu maloha ghakinbhuka naywo kakighululika. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Mbole ya kunkanikiha, Yesu kakinlekekeha kaghende kunu pakanng'ombela <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />“Ghukotoo kunng'ombela mundu ywoheli yula mihalo ayi peni ghughende ghukalilahe kwa ndundame bha Chapanga na ghukatule matulo kya kughululikwa kwako handa pakakwilikihite Musa yibhe uyimiho kwa bhombe kukita ghulama.”<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Peni yula mundu kakibhuka kakiyanda kualubhulila bhandu mihalo ya kulamihwa kwa mwene kya nga uhiho. Hinu Yesu kakilepelwa kuyingila kangi mumilima kya nga uhiho, peni kakitama panje ya kitami mbande ya nga bhandu. Hata naha bhandu bhakintughila Yesu kuhuma mumbande hyoha.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Yesu kangunlamiha mundu yunaulelebhaho</para>
  <para style="r">
    <ref loc="MAT 9:1-8">Matayu 9:1-8</ref>; <ref loc="LUK 5:17-26">Lukasi 5:17-26</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Mbole ya masiku gha mandina, Yesu kakibhuya ku Kapelinaumu, bhandu bhakiyihwa kukita kakibha ukaya. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Hino bhakikwemukana bhandu atangalo, bhakimema kupitingana kunlyango mbaka paulongolo ghwa kitutubhi. Yesu kakibha pakialandamiha lilagho lyake. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Lisaa lilalila bhandu ncheche bhakihika na bhakinng'egha mundu nlelebhaho kwa Yesu. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Kiyaha ya lumati lwa bhandu bhakilepelwa kunheghekeha pakabheghite Yesu. Hinu bhakihotola lunyakaha lubheghite unani pakabheghite Yesu, paahotolite kala bhakinhuluha aywo mundu pakaghonjite mulikahe. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Yesu pakabhoniti uhyubhalilo ghwabhe kakinng'ombela yula nlelebhaho “Mwana ghwangu, ‘ghulekekehwa ulemwa ghwako.’” <verse eid="MRK 2:5" /><verse number="6" style="v" sid="MRK 2:6" />Amoo bha ahunda bha malaghilo bhaatamite pautamo aghwo, bhakihwacha mumyoyo yabhe. <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“Yibha bhuli mundu ayu kangughomba naha? Ayu kangunkundula Chapanga! Kahone mundu ywakulekekeha ulemwa maha nga Chapanga ghweka chake.” <verse eid="MRK 2:7" /><verse number="8" style="v" sid="MRK 2:8" />Kamu Yesu kakighamanya mahwachilo gha myoyo yabhe, kakiakonya, “Bhuli munguhwacha habhu mumyoyo yenu? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Kingiki kya kunoghelwa muno, kunng'ombela mundu nlelebhaho, ‘Ghulekekehwa ulemwa ghwako ebu kunng'ombela ghuyinuke ghutole likahe lyako ghutyange?’ <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Hinu nungupala mmanye kukita Mwana ghwa Mundu kabhegha na makakala gha utabhala ghwa kualekekeha bhandu ulemwa ghwabhe munnima” Ndo Yesu kakinng'ombela yula nlelebhaho. <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“Ningughughombela ghuyime, ghutole likahe lyako ghughende ukaya kwako.” <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />Kamu, kakiyima na kakitola likahe lyake na kakibhuka. Bhandu bhoha bhakikangacha na kunkwiha Chapanga paakilongela, “Twenga tuyibhona ng'obhe mihalo handa ayi.”<verse eid="MRK 2:12" /></para>
  <para style="s">Yesu kangunkema Lawi</para>
  <para style="r">
    <ref loc="MAT 9:9-13">Matayu 9:9-13</ref>; <ref loc="LUK 5:27-32">Lukasi 5:27-32</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Yesu kakighenda kangi mumbwegha bwegha ya lihibha lya Galilaya. Lumati lukulu lwa bhandu lukinhikila naywo kakiyanda kuahunda. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Pakabheghite mukutyanga kakinmona Lawi mwana ghwa Alufayu kakitama pakitutubhi kya lusumulo sumu, Yesu kakinng'ombela “Ghunndughile” Lawi kakiyimuka na kuntughila.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Mbole yake Yesu kakitama mukulyegha hilyo, mulubhagha lwa Lawi, kakibha papamu na bhanakusumula sumu atangalo na bhana ulemwa bhakibhegha mukulyegha papamu na ahundwa bhake, mana kukibha na bhandu atangalo bhaantughiliti <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Amoo ahunda bha malaghilo na Akaafalisayu paammonite pakalyegha papamu na asumula lusumu na bhanaulemwa bhakiakonya ahundwa bhake, “Kiyaha niki Yesu kangulyegha papamu na bhanakusumula sumu na bhana ulemwa?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Yesu pakayihwite kakiaghombela, “Bhandu bha ngautamwa ampala ng'obhe nng'anga, maha atamwa. Hika ng'obhe kubhakema bhandu bha maha, ngati bhana ulemwa.”<verse eid="MRK 2:17" /></para>
  <para style="s">Yesu kangukonywa ya kya kulikunga kulyegha</para>
  <para style="r">
    <ref loc="MAT 9:14-17">Matayu 9:14-17</ref>; <ref loc="LUK 5:33-39">Lukasi 5:33-39</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Hinu, ahundwa bha Yohana na ahundwa bha akaafalisayo bhakulikunga kulyegha. Amoo bhandu bhakinhikila Yesu kunkonyekeha, “Bhuli ahundwa bha Yohana na ahundwa bha Akaafalisayo bhangulikunga kulyegha, peni bhuli ahundwa bhako bhangulikunga kulyegha ng'obhe?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Yesu kakiayanga “Ahenja bha bambo yuna chekwa ya kutolela bhahotola bhuli kulikunga kulyegha pala bambo yuna chekwa ya kutolela paabheghite papamo nabho? Kiyaha yuna chekwa ya kutolela lisiku alyo kabhegha papamu na bhombe kabhone kulikunga kulyegha. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Peni lisiku lyahika kwa yuna chekwa ya kutolela kubhuhwa mubhombe; peniapwo ndo bhatahotola kulikunga kulyegha hilyo.”<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“Bhandu apabhikagha ng'obhe kipabhiko kya hyono mulikama. Handa paatenda naha akyo kipabhiko kya hyono kyalakatukanga likama alyo nalyo lyakanjabhanika munu. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Na kabhone mundu yuna kubhika difwai ya hyono mu mihako ihakalite ya mayula handa paatenda naha yila difwai ya hyono yahibalula yila mihako ihakalite gha mayula kangi divai yayitika pahi na nhako ghula ghuhakalite ghwa metukana. Divai ya hyono yingubhikwa mu mihako hya hyono.”<verse eid="MRK 2:22" /></para>
  <para style="s">Yesu kanguhunda ya kya Lisiku lya Kupughwa</para>
  <para style="r">
    <ref loc="MAT 12:1-8">Matayu 12:1-8</ref>; <ref loc="LUK 6:1-5">Lukasi 6:1-5</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Lisiku limu lya Kupughwa, Yesu kakibha mukutyanga mumighunda ya mapemba. Paabheghite mukutyanga ahundwa bhake bhakiyanda kubena mahonjo gha mapemba. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Akaafalisayo bhakinkonya Yesu, “Ghulole! Kiyaha niki ahundwa bhako angutenda nhalo ghwanga kunoghelwa lisiku lya kupughwa?” <verse eid="MRK 2:24" /><verse number="25" style="v" sid="MRK 2:25" />Yesu kakiayanga, “Mukali kusoma ng'obhe yakatendite Daudi na ayake paabheghite na njala? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Daudi kakiyingila mukitutubhi kya Chapanga, kakilyegha yila mangate yibheghite yakya Chapanga. Nhalo aghu ghukitendwa paabheghite Abitai ndundame nkulu. Na ndo andundame ghweka chabhe bhakiyeghekehwa kulyegha mangate ayo ya kya Chapanga. Peni Daudi kakilyegha, kangi kakiapegha ayake” <verse eid="MRK 2:26" /><verse number="27" style="v" sid="MRK 2:27" />Yesu kakibhaghombela “Lisiku lya kupughwa likitendekwa kwa kya bhandu na ng'obhe bhandu kwa kya Lisiku lya kupughwa. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Hila hila Mwana ghwa Mundu ndo Bambo ghwa Lisiku lya Kupughwa.”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Yesu kangunlamiha mundu yuna ulelebhalo ghwa kibhoko</para>
  <para style="r">
    <ref loc="MAT 12:9-14">Matayu 12:9-14</ref>; <ref loc="LUK 6:6-11">Lukasi 6:6-11</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Yesu kakiyingila kangi mu kitutubhi kya kukonganila Akaayahudi, na akwo pakibha na mundu yumo yunaulelebhaho ghwa kibhoko. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Amwo, amoo bhandu bhangi bhakintyegha kanlamihe mundu ayo lisiku lya kupughwa apati ngupukiho ya kuntakila. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Yesu kakinng'ombela mundu yula ywakalelebhukite kibhoko, “Ghuhike apa paulongolo” <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Mbole kakiakonya bhandu, “Hinu lyoki likunoghelwa kutendwa mu lisiku lya kupughwa, kutenda mihalo ya maha ebu mahakataho, kulopoha ubhumi ebu kukoma?” Peni bhombe bhakinyamala jii. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />Yesu kakialolekeha bhoha kwa kiyaghabhu, na kakikukulika kwa hyeta ya myoyo yabhe, na kakinng'ombela yula mundu, “Ghugholohe kibhoko kyako!” Kakikigholoha kibhoko kyake na kikibha kya maha kangi. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Kamu Akaafalisayo bhakighenda panji kutenda ngokeho pamoo na bhandu bha kimati kya Helode bhakipalaha njila ya kunkanjaghana Yesu.<verse eid="MRK 3:6" /></para>
  <para style="s">Lumati lwa bhandu mubwegha ya lihibha</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Yesu kakibhuka papamu na ahundwa bhake kakighenda kumbwegha ya lihibha Galilaya na bhandu atangalo kuhuma kunnima ghwa Galilaya, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />ku Idumea kumwambo ya lukemba Yoludani, kiyaha bhakiyihwa mihalo miyoloho yakatendite, <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Kiyaha ya kya lumati lukulu lwa bhandu Yesu kakiaghombela ahundwa bhake, bhanyeghele bhwato atame amwo ngati lumati lwa bhandu lukotoke kunnyuka. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Kiyaha Kakialamiha atamwa bha mahele, ndo bhala bhana utamwa bhakiyukana ngati anbyale. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Bhandu bha abheghite na mandilo paanmonite Yesu bhakilitagha pahi pa ulongolo ghwa maghulu ghake na bhakikyota kyobho, “Ghwenga ndo Mwana ghwa Chapanga.”<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />Peni Yesu kakiakwilikiha ghala mandilu kwa lilakali bhakotoke kummanyiha kwa bhandu.<verse eid="MRK 3:12" /></para>
  <para style="s">Yesu kanguahaghula Andumitumi mbinda mabhoko yimo na abhili</para>
  <para style="r">
    <ref loc="MAT 10:1-4">Matayu 10:1-4</ref>; <ref loc="LUK 6:12-16">Lukasi 6:12-16</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Yesu kakihubhuka kukitumbi, kakiakema bhala abhahaghulite nabho bhakighenda naywo. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Kakiahaghula mbinda mabhoko yimo na abhili ndo abha bhakiakema Andumitumi, ngati abheghe papamu na ywombe, kakaalaghihe kulandamiha <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />kangi abheghe na makakala gha kughabhinga bhinga mandilu.<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />Abha ndo bhala mbinda mabhoko yimo na abhili akabhahaghuliti, Simoni ywene Yesu kakinpegha lihina lya Petili, <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Yakobu na Yohani bhana bha Zebedayu, bhombe kakibhapegha lihina Boanelege, mana yake ndo bhana bha lulundumo, <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />Andelea na Filipi na Batolomayo na Matayo na Tomasi na Yakobu mwana ghwa Alufayo na Tadayo na Simoni Nkananayu na <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />Yuda Isikaliyoti, ywene ywakankilukite Yesu.<verse eid="MRK 3:19" /></para>
  <para style="s">Yesu na Belisebuli</para>
  <para style="r">
    <ref loc="MAT 12:22-32">Matayu 12:22-32</ref>; <ref loc="LUK 1:14-23">Lukasi 1:14-23</ref>; <ref loc="LUK 12:10">12:10</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Mbole Yesu kakibhuya ukaya, lumati lwa bhandu lukikwemuka kangi, mbaka mwene na ahundwa bhake bhakilepelwa kulyegha hilyo. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Paayihwite alongo bhake mihalo ayi bhakighenda kuntola, mana bhandu bhakighomba, “Kayingilwa na nng'uluka.”<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Ahunda bha malaghilo bhakihika kuhuma ku Yelusalemu, bhakighomba, “Ayu kana Belisebuli! Kangi kangubhabhinga bhinga mandilo kwa makakala gha nkulu ghwa mandilo.”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Hinu Yesu kakibhakema bhombe na kubhaghombela kwa mihwanu, “Nchipila katahotola bhuli kunbhinga bhinga Nchipila nnyake? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Handa ghubhutwa ghumo ghumegheka mulumati hinakupingikana, ghubhutwa agwo ghwalama ng'obhe. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Na handa lubhagha lumo lutamegheka mulumati lumati lunakupingikana, lubhagha alwo lutatengeleheka ng'obhe. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Na handa ghubhutwa ghwa nchipila ghutapwilinganika mu himati hichoko hichoko kabhone kuhotola na uhiko ghwake ghuhika.”<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />“Kabhone mundu ywohele yula ywakahotola kuyingila kukitutubhi kya mundu yuna makakala na kunpoka utopelo ghwake, mbaka kakantute na kammope mundu aywo, ndo katahotola kunpoka utopelo ghwake.”<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />“Kulyaghila nungubhaghombela gha hoto bhandu bhatalekekehwa ulemwa ghwabhe ghwoha na ngundulo hyabhe hyoha kwa Chapanga. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Peni yunakunkundula Nhuki ghwa Chapanga kabhone kulekekehwa, kana nongwa ya ulemwa ghwa masiku ghoha.” <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Yesu kakighomba habhu kiyaha bhombe bhakighomba, “Kana lindilo.”<verse eid="MRK 3:30" /></para>
  <para style="s">Ma na alongo bhake Yesu.</para>
  <para style="r">
    <ref loc="MAT 12:46-50">Matayu 12:46-50</ref>; <ref loc="LUK 8:19-21">Lukasi 8:19-21</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Ma ghwake Yesu na alongo bhake bhakihika papamu na bhakiyima panji, bhakinlaghila mundu kankeme. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Lumati lwa bhandu lukibha palukintindila. Ndo, bhandu bhakinng'ombela, “Ma ghwako na alongo bhako bhabhegha panji, bhangukukema.”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Yesu kakiayanga, “Ma ghwangu na alongo bhangu ndo a ghani?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Apa kakialolekeha bhala bhandu bhaantindilite, na kakighomba, “Abha ndo ma ghwangu na ndo alongo bhangu. <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Mundu ywohele ywakatenda ghakaghapala Chapanga, aywo ndo nlongo ghwangu na nhacha ghwangu na ndo ma ghwangu.”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Ndambulo ya mundu nkweta mbeyu</para>
  <para style="r">
    <ref loc="MAT 13:1-9">Matayu 13:1-9</ref>; <ref loc="LUK 8:4-8">Lukasi 8:4-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Yesu kakiyanda kangi kuhunda mumbwegha ya lihibha lya Galilaya. Lumati lukulu lwa bhandu lukinkwemukila mbaka ywombe kakilamula kuhubhuka mubhwato ghuubheghite mulihibha na kakitama amo, lumati lwoha lukibhegha kuuyumu ya mbwegha ya lihibha. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Kakihunda mihalo miyoloho kwa ndambulo, mumahundo ghake kakilongela, <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />“Nnyihwani! Pakibhegha nkweta mbeyu yumo kakighenda kukweta mbeyu hyaki. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Pakabheghite mukukweta mbeyu, yingi yikiponeka munjila, hiyuni hikihika kuhonyola. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Yingi yikiponeka mumaganga pa nga lutupi nnyoloho, yikimela kwa kulopokeha, kiyaha lutupi lukibha luchoko. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Luchubha paluyakiti yikiyuma mana ngigha hyake hikibha hupitaho hikinyaluka. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Yingi yikiponeka pamikongo yina mihomi, nayo yikikula na yikiyipepechula, nahyo hikipapa ng'obhe mapambika. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Yimoo yingi yikiponeka mulutupi lwa maha, yikimela, yikikula na yikipapa mapambika, yimu mbinda mabhoko ndatu, yimu mbinda mabhoko sita, na yimu mbinda mabhoko kumi.” <verse eid="MRK 4:8" /><verse number="9" style="v" sid="MRK 4:9" />Mbole kakiaghombela, “Ywakabhegite na makutu kakayihwe.”<verse eid="MRK 4:9" /></para>
  <para style="s">Nningo ghwa kuhunda kwa mandambulo</para>
  <para style="r">
    <ref loc="MAT 13:10-17">Matayu 13:10-17</ref>; <ref loc="LUK 8:9-10">Lukasi 8:9-10</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Yesu pakabheghite pa ghweka chake, amoo bhangi bhaannyihwanilite bhakinng'endela papamo na bhala ahundwa mbinda mabhoko yimo na abhili, bhakinkonya kumanyika kya mandambulo ghala. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Yesu kakibhaghombela, “Mwenga mulekekehwa kumanya mbwepo ya ghubhutwa ghwa Chapanga, peni bhala bha abheghite panji bhataghombelwa kilibhi kyohele kwa mandambulo. <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />Ngati,</para>
  <para style="q" vid="MRK 4:12">‘Kulola bhaayolola hoto, peni kahone kuyibhona.</para>
  <para style="q" vid="MRK 4:12">Kuyihwa baayihwanila, peni kahobhe kumanya.</para>
  <para style="q" vid="MRK 4:12">Hela bhumbho bhangankilibhukiliti Chapanga,</para>
  <para style="q" vid="MRK 4:12">naywo nge kabhalekekehite.’ ”<verse eid="MRK 4:12" /></para>
  <para style="s">Yesu kangufwambula ndambulo ya nkweta mbeyu</para>
  <para style="r">
    <ref loc="MAT 13:18-23">Matayu 13:18-23</ref>; <ref loc="LUK 8:11-15">Lukasi 8:11-15</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Mbole Yesu kakibhakonya, “Muyimanya ng'obhe ndambulo ayi? Mutaghamanya bhuli mandambulo mamoo ghangi? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Nkweta mbeyu aywo kakikweta lilagho lya Chapanga. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Bhandu bhangi ndo handa mbeyu yiponikite munjila; Kamu paaliyihwa lilagho, Nchipila kahika na kulibhuha lilagho lila liikwetitwe mumyoyo yabhe. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Bhandu bhangi ndo handa mbeyu yila yiponikite mumaganga. Kamu paayihwa lilagho alyo bhangulipokela kwa uyelelo. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Peni lingubhayingila ng'obhe na kubhegha na ngigha mumyoyo yabhe. Bhahyatilagha behi ng'o, mbole ya mapungwo na luhuyu kya lilagho alyo, kamu bhangulileka lila lilagho. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Bhandu bhangi ndo handa hila mbeyu hiponikite mumikongo yina mihomi. Abha ndo nhwano ghwa bhala bhaaliyihwanila alyo lilagho, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />Peni bhwaghalili ghwa nnima aghu, tama ya utopelo na tama ya hyoheli hila payihika na kuliyuka lila lilagho na kulitenda likotoke kupapa. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Peni amo bhangi abhegha handa mbeyu hikwetwite mulutupi lwa maha. Ndo bhandu bhayihwanilite lilagho alyo, na kulikingama na kupapa mapambika gha maha na bhangi mbinda ndatu bhangi mbinda mabhoko sita na bhangi mbinda mabhoko kumi.”<verse eid="MRK 4:20" /></para>
  <para style="s">Limbamba ligubikitwe</para>
  <para style="r">
    <ref loc="LUK 8:16-18">Lukasi 8:16-18</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Kakiaghombela “Bhuli hino limbamba lyakwatwa na kugubikwa pahi mulijamanda ebu pahi palihungu lya ulili? Ng'obhe, lyakwatwa na kubhikwa kunane mwa kinyuta kyake. <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Kiyaha kahobhe kilibhi kyoheli kila kinakuhihwa kya nga kuhwimulighwa, ebu nhalo ghwoheli ghwa lupwepo ghwangayeghwa pakindandabhanji. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Mundu yuna makutu gha kuyihwa, kayihwe.”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Kakiaghombela kangi, “Mmanye maha ghamuliyihwa, malaghilo ghala gha mumubhatosa bhangi, Chapanga kataatosa mwenga kangi na kupitingana. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Kiyaha yuna kilibhi katayonjokehwa kingi, naywo ywa nga kilibhi kangi, katapokwa hata kilibhi kichoko kyakabheghite nakyo.”<verse eid="MRK 4:25" /></para>
  <para style="s">Ndambulo ya mbeyu payimela na kukula</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Yesu kakiaghombela “Ghubhutwa ghwa Chapanga ghulihwana na mundu ywakakwetite mbeyu munng'unda, <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Mbole ya kukweta, pakabheghite mukughonja ebhu pakabheghite meho, mbeyu yikumela na kukula kya nga kumanya payikula. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Mana lutupi lunguyitenda mbeyu imele yibhe nmela; mbole lukibha lihonjo mbole mbunje mulihonjo. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Peni mbeyu pa iyelite, kamu, nkweta mbeyu aywo katayingila mung'unda na kikwakwa kya kubenela mabeno.” <figure style="fig" file="12 Sickle.jpg" size="col" ref="4:29">Mundu kangubena kwa kikwakwa</figure><verse eid="MRK 4:29" /></para>
  <para style="s">Ndambulo ya mbeyu ya nhaladali</para>
  <para style="r">
    <ref loc="MAT 13:31-32">Matayu 13:31-32</ref>; <ref loc="MAT 13:34">13:34</ref>; <ref loc="LUK 13:18-19">Lukasi 13:18-19</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Yesu kakighomba kangi, “Tughulandanihe na niki Ghubhutwa ghwa Chapanga? Ebu tughukambuhe na nhwanu ghani? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Gubhegha handa mbunje ya nhaladali, yene ndo njoko njoko munu kupitingana na mbeyu hyoha yinakukwetwa mulutupi. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Peni payikwetwa kala, yingumela na ghubhegha nkongo nkulu kupitingana na mikongo hyoha ya mumighunda. Matambalilo ghake ghangubhegha makulu na hiyuni anguchenga hiyumba hyabhe mumatambaliho agho.”<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Kwa mandambulo ghangi mayoloho, Yesu kakighomba nabho lilagho lyake handa pabhahotolite kuyihwa na kumanya. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Kakilongela ngo'bhe kyanga ndambulo, Peni pakabheghite na ahundwa bhake kakiahotolela hoto ya hilibhi hyoha ya ndambulo yila.<verse eid="MRK 4:34" /></para>
  <para style="s">Yesu kangukwilikiha likusi liyime</para>
  <para style="r">
    <ref loc="MAT 8:23-27">Matayu 8:23-27</ref>; <ref loc="LUK 8:22-25">Lukasi 8:22-25</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Lisiku alyo makimuhi, Yesu kakiaghombela ahundwa bhake, “Tuyomboke tughende kumwambo ya lihibha.” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Bhakiluleka lula lumati lwa bhandu, bhakibhuka naywo mumbwato ghwakabheghite. Kangi yikibhegha na mibhwato miyoloho yikintughila. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Kamu likibhegha liyegha likulu lukiyanda kupula, na liyuka lya machi likilututa bhwato ghula mbaka machi ghakiyanda kumema mubhwato.<figure style="fig" file="09 Boat in Storm.jpg" size="col" ref="4:37">Bhwato ghungututwa na liyuka </figure> <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Yesu kakibhegha kunyuma ya libhwato pakighonja munhaghamilo, ahundwa bhake bhakinnyumuha mung'ono na bhaking'ombela, “Nhunda, ghungubhona ng'obhe hamba tungupala kuhwegha?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Yesu kakiyumuka na kakililakalila lila liyegha na kakilikwilikiha liyuka lya machi mulihibha “Ghuyime, ghutengeleke,” kamu kamu liyuka likiyima tuli na kukibha tuli maha muno.<verse eid="MRK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40" />Mbole Yesu kakiaghombela ahundwa bhake, “Kiyaha niki mukuyoghopa? Nkali na uhyubhalilo ng'obhe?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Nabho bhakiyoghopa muno, bhakikonyekeana, “Ayu ndo ghani? Mwene likusi na mayuka gha machi ghangunnyihwa!”<verse eid="MRK 4:41" /></para>
  <para style="b" />
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">Yesu kangunlamiha mundu yuna lindilu</para>
  <para style="r">
    <ref loc="MAT 8:28-34">Matayu 8:28-34</ref>; <ref loc="LUK 8:26-39">Lukasi 8:26-39</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Yesu na ahundwa bhake bhakiyomboka kumwambo ya lihibha Galilaya na bhakihika kunnima ghwa Akaagelasi. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Yesu pakahulukite mubhwato kamu kakikongana na mundu yuna lindilu pakahuma kumandogholo. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Mundu ayo masiku ghoha kakitama akwo kumandogholo, kahone mundu ywakahotolite kunkanikiha ebhu kunmopa kwa nnyololo <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Pipipi bhakimmopa nnyololo mumabhoko na kingongolo maghulu peni kakimetulanga akyo kingongolo mumaghulu ghake na kahone mundu yuna makakala gha kunkanikiha. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Pakilo na pamuhi kakibhegha kumandogholo na kuhitumbi pakakyota kyobho na kulikachanga kwa maganga.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Pakanmonite Yesu kya kutali, kakintughila na kakinchutamila mayughwa pakibhungi kyake. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Kakikyota kyobho kwa makakala na pakighomba, “Ghuna niki na nenga, Yesu, Mwana ghwa Chapanga abheghite kunani muno? Nungukuyupa kwa Lihina lya Chapanga ghukotoke kumbamanda.” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Kakilongela naha kiyaha Yesu kakibha pakinng'ombela “Ghumbhuke ayo mundu ghwenga lindilu!”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Yesu kakinkonya “Lihina lyako ghani?” Mwene kakinnyanga “Lihina lyangu machonda, kiyaha tubhegha atangalo” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Kakinnyupa muno Yesu kakotoke kubhatagha kutali na nnima ghula.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Ugheghela na pala pauhelelo ghwa kitumbi bhakibhegha maghulubhe atangalo bhakihakilwa. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Ghala mandilu bhakinnyupa paaghomba, “Ghutuyeghe kwa bhala maghulubhe, ghutulekekehe tubhayingile.” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Yesu kakibhalekekeha. Ndo ghala mandilu ghakinbhuka yula mundu na kubhayingila bhala maghulubhe. Lula lumati lukibhegha na maghulubhe elufu ibhili, ndo lukihelela kungende na bhakidibala mu lihibha.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Bhala bhandu bhaabheghite mukuhakila bhala maghulubhe, bhakitughila kukitami na kuhijiji hyoha kulubhulila nnando agho. Bhandu bhakighenda kulola ghaghabwitukilite. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Bhakihika kwa Yesu na bhakinmona yula mundu ywakabheghite na lumati lwa mandilu, kakihwala lipinda, na luhala lwake lukimmuyila, bhandu bhoha kiyoghopa. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Bhala bha bhakabhonite nlando aghwo bhakiaghombela na bhandu amo bhangi, ghaabwitukilite kwa yula mundu ywakabheghite na mandilu na ghaghabwitukilite kwa lula lumati lwa maghulubhe.<verse eid="MRK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17" />Hinu, bhandu bhakiyanda kunyupa Yesu kabhuke munnima ghwabhe.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Yesu pakabheghite mukuyingila mubhwato, yula mundu ywakabheghite na mandilu kakinnyupa Yesu kaghende papamu naywo. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Yesu kakinkanikiha, ndo kakinng'ombela “Ghughende ukaya kwa aghanja bhako ghukaaghombele milandu mikulu yakakutendilite Bambo, na pakakubhonelite luhungu.” <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Yula mundu kakighenda na kakiyanda kulandamiha ako ku Dekapoli, mana yake nnima ghuna hitami mbinda mabhoko yimo, ghala ghakatendelitwe na Yesu, na bhandu bhoha bhakikangacha.<verse eid="MRK 5:20" /></para>
  <para style="s">Yesu kangunlamiha nhinja ghwa Jailu na nhumbu yumo</para>
  <para style="r">
    <ref loc="MAT 9:18-26">Matayu 9:18-26</ref>; <ref loc="LUK 8:40-56">Lukasi 8:40-56</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Yesu pakayombokite kangi kwa bhwato kughenda kumwambo ya lihibha Galilaya. Bhandu atangalo akikwemukala na mwene kakibhegha umbwegha ya lihibha. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Ndo kilongohi yumo ywa kitutubhi kyakukonganila Akaayahudi ywakakemitwe Jailu, kakinhikila pala, na pakanmonite Yesu kakichutamila mayughwa pakibhungi kyake, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />kannpembeleha pakalongela, “Nhinja ghwangu nndokwa kangutamwa tepatepa paulili, Ningughuyupa ghuhike na ghunnyabhike kibhoko kyako ngati kalame kabhe bha maha.” <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />Ndo Yesu kakighenda papamu naywo, bhandu atangalo bhakinntughila na bhakinnyuka mbande hyoha.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Apwo pakibhegha ndala yumu yuna liholobhela mungungwa mbinda libhoko yimo na hibhili. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />Ndala aywo kakipungwa muno kwa kughenda kwa aghanga atangalo. Na kakiyomola hilibhi hyoha hyakabheghite naywo, peni mbole ya kulama ndo utamwa ghukintopela muno. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Naywo kakibhegha pakayihwite mihalo ya Yesu na kakinhikila Yesu kya kuhyetu ya lumati lwa bhandu na kakilibyala lipinda lyake, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />kiyaha kakighomba mumwoyo ghwake, “Handa nda hotola kulibyala lipinda lyake, kulyaghila ndalama.” <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Kamu, liholobhela lyake likiketuka, naywo kakighubhona mmili ghwake ghulama. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Kamu, Yesu kakimanya kukita makakala ghake ghakinlamiha mundu. Kakilupilukila lula lumati na kakilukonyekeha, “Ndo ghani aywo ywakabyalite lipinda lyangu?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Ahundwa bhake bhakinnyanga, “Ghumwene ghungubhona lumati lwa bhandu palighuyuka, hinu yibhegha bhuli ghungukonyekeha, ndo ghani aywo ywakakuyabyalite?”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Peni Yesu kakilolekeha mbande hyoha ngati kammone aywo ywakanbyalite. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Yula nndala kakimanya kila kinbwitukllite kakinyingilwa lyogha, kakiloghoya na kakighwila mumaghulu ghake na kakinlubhulila hyoha hyakanbwitukilite. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Yesu kakinng'ombela, “Nhinja, uhyubhalilo ghwako ghukulopoha. Ghughende kwa uhihimilo, na ghulame kulukulu utamwa ghwako.” <verse eid="MRK 5:34" /><verse number="35" style="v" sid="MRK 5:35" />Pakabheghite mukughomba, Bhandu bhakihika kuhuma kulubhagha lwa yula kilongohi ghwa kitutubhi kya kukonganika Akaayahudi bhakinng'ombela, “Nhinja ghwako kahwegha kala, kiyaha niki kunng'aha nhunda?” <verse eid="MRK 5:35" /><verse number="36" style="v" sid="MRK 5:36" />Pakayihwite agho Yesu kakinng'ombela aywo nkulu ghwa kitutubhi kya kukonganikila Akaayahudi, “Ghukotoke kuyoghopa ghwenga ghuhyubhalile tu” <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Kakinlekekeha ng'obhe mundu yumooyungi ywa kulongohana naywo maha nga Petili na Yakobu na Yohana nnongo ghwake Yakobu. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Pakahikite mulubhagha lwa yula kilongohi ghwa kitutubhi kya kukonganila Akaayahudi, Yesu kakibhona bhulwa, bhandu kwa bhakilila ngukuliko na kwa lilobhe likulu. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Pakayingilite munyumba kati, kakiaghombela, “Kiyaha niki mungutenda bhulwa na kulila? Nhinja kahwegha ng'obhe, ngati kaghonja hela.”<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />Bhala bhandu bhakinheka kwa uyuyuho. Peni mwene kakiabhuha bhoa panje, kakibhatola tate na ma ghwa yula nhinja papamu na bhala ahundwa bhake andatu. Kakiyingila munyumbakati mbaka pala pakabheghite yula nhinja <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Kakinkamula kibhoko yula nhinja na kaking'ombela, “Talita komu!” Mana hyaki “Nhinja nungughughombela yumuka.”<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />Kamu yula nhinja kakiyima, na kakiyanda kutyanga, aywo nhinja kakibhegha na ngungwa mbinda mabhoko yimo na hibhili. Bhandu paaghabhonite agha bhakikangacha muno <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Yesu kakialaghila kwa lilakali bhakotoke kung'ombela mundu nhalo ghula, na kakiaghombela bhanpeghe yula nhinja hilyo.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">Yesu anlema akwo Nazaleth</para>
  <para style="r">
    <ref loc="MAT 13:53-58">Matayu 13:53-58</ref>; <ref loc="LUK 4:16-30">Lukasi 4:16-30</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Yesu kakibhuka akwo na kakighenda kukitami kyabhe, na ahundwa bhake bhakintughila. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Palihikite lisiku lya kupughwa, kakiyanda kuhunda mu kitutubhi kya kukonganila Akaayahudi, na bhandu atangalo paayihwite bhakikangacha. Bhakikonya, “Mundu ayu kayihopola kwoki mihalu ayi hyoha? Nnole ndo mahala gha bhuli ghakabheghite nagho? Nnole ndendelo ya mihabho ghakayitenda. <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Aywo ndo yula nhongola hilibhi hya mikongo ng'obhe? Mwana ghwa Malia? Alongo bhake ndo Yakobu na Yosefu, Yuda na Simoni ng'obhe? Ahacha bhake ndo abha ng'obhe tubhegha nabho papamu?” Nabho bhakiyaghabhihwa munu kwa kya ywombe bhakinhyula <verse eid="MRK 6:3" /><verse number="4" style="v" sid="MRK 6:4" />Yesu kakiaghombela, “Mbuyi ghwa Chapanga kanguhokamilwa kwoha, ngati ng'obhe mukitami kyake na mu aghanja bhake na alongo bhake.” <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />Ndo kakitenda ng'obhe nhabho ghwoheli ghula, peni kakiayabhikila mabhoko atamwa bha mandina na kakialamiha. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Na Yesu kakikangacha Muno kiyaha bhakihyubhalila ng'obhe?</para>
  <para style="s" vid="MRK 6:6">Yesu kangualaghila bhala ahundwa mbinda maboko yimo na abhili</para>
  <para style="r" vid="MRK 6:6">
    <ref loc="MAT 10:5-15">Matayu 10:5-15</ref>; <ref loc="LUK 9:1-6">Lukasi 9:1-6</ref></para>
  <para style="p" vid="MRK 6:6">Mbole Yesu kakihityangila hijiji hya ugheghela pakiahunda bhandu. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />Kakiakema bhala ahundwa mbinda mabhoko yimo na abhili, na kakialaghiha abhili abhili na kakiapegha makakala gha kughabhuha mandilu. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Kakialaghiha pakighomba, “Nkotoke kutola kyoheli mumwanja maha ntole lukongocho weka chake. Nkotoke kutola lingate, ebu nhako ghwa mapinda, ebhu ngalabha. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Nhwale tabhalanda, peni nkotoke kuhwala lipinda lingi.” <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Kangi kakiaghombela, “Kitutubhi kyoheli kila kya abhakingama ntame apwo nkotoke kubhuka bhuka, mbaka lisiku lila lya kubhuka mukitami akyo. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Handa poheli pala paabhalema kubhakingama ebu kubhayihwa, npumunde lihu mumaghulu ghenu ngati yibhe uyimiho kwa bhombe.”<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Ndo bhakibhuka na kughenda kulandamiha bhandu ngati bhalipetule na kuleka ulemwa ghwabhe. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Bhakiabhinga bhinga mandilu mayoloho, na bhakiapakala mahuta gha nseituni atamwa atangalo na kualamiha.<verse eid="MRK 6:13" /></para>
  <para style="s">Kiho kya Yohana yunakubatisa</para>
  <para style="r">
    <ref loc="MAT 14:1-12">Matayu 14:1-12</ref>; <ref loc="LUK 9:7-9">Lukasi 9:7-9</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Hinu mutwa Herode kakiyihwa mihalu ayi, kiyaha mihalu ya Yesu yikimanyikwa poheli. Bhandu bhangi bhakighomba, “Yohana yunakubatisa kakihyuka kuhuma kumambi ndo mana makakala ghake ghakutenda mihabho mu mwene!”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Bhandu bhangi bhakighomba, “Mundu ayu ndo! Eliya” na amoo bhandu bhakighomba, “Mundu ayu ndo mbuyi, handa mmoo yumo ghwa mambuye bha makachu.”<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Peni Helode pakayihitwe nhalu aghu, kakighomba, “Aywo ndo Yohana yunakubatisa, yununndumulite mutwe, hinu kahyuka!” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />Kiyaha Helode kakikwilikiha Yohana yunakubatisa kakamulwe na kabhikwe mukibhopo. Kakitenda naha kiyaha kakintola Helodia nndala ghwa Filipo nnongo ghwake mwene Helode. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Yohana kakinng'ombela Helode, “Yinoghela ng'obhe kwa ghwenga kuntola nndala ghwa nnongo ghwako.” <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />Ndo Helodia kakibha na kihyongololo na Yohana kakipala kunkoma. Peni kakihotola ng'obhe. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />Kiyaha Helode kakinnyoghopa Yohana kakimanya kukita ndi mundu ghwa maha na nng'anyimo, kakinpingikiha. Herode kakinoghelwa kunnyihwanila Yohana peni kakihyononeka muno pakayomolite kunnyihwa.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Lisiku limu Helodia kakipata ling'ebu muchekwa hwachilo ya lisiku lya kubhelekwa kwa Herode. Helode kakialalika aghohi bha libalasa lyake, alongohi ghwa machonda ghwa mikoha, na alongohi ghwa ako ku Galilaya. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Ndo nhinja ghwake Helodia kakiyingila kukina, na Helode kakiyelelwa papamu na bhandu bha abheghite mu hilyo. Mutwa Helode kaking'ombela yuna nhinja, “Ghunyupe kyoheli kighukipala na nenga ndaghupegha.” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Kangi kakinlapila yula nnhinja “Ndaghupegha lyoheli lila lyakapala kuyupa, hata ngabhee lihinda lya ghubhutwa ghwangu.”<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Yula nhinja kakighenda panji kunkonya ma ghwake, “Nyupe niki?” Maghwake kakinyanga, “Ghuyupe mutwe ghwa Yohana Yunakubatisa.”<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Kamu yula nhinja kakibhuya kanongola kaking'ombela mutwa, “Mbala ghumbeghe hinu apa mutwe ghwa Yohana Yunakubatisa mukipalo.”<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Mutwa kakihyononeka muno, peni kiyaha kakilapila muulongolo ghwa ahenja kakilepelwa kunkanila. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Kamu mutwa kakinlaghila yumoo ywa machonda na kakinkwilikiha kakangheghele mutwe ghwa Yohana. Kakighenda kukibhopo na kakinndumula mutwe ghwa Yohana Yunakubatisa. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />Mbole yula lichonda kakiyegha mutwe mukipalo na kakinpegha yula nhinja, na yula nhinja kakinpegha ma ghwake. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Ahundwa bha Yohana paayihwite nhalo ghula, bhakighenda kughutola ntumba ghwake, bhakinkulila.<verse eid="MRK 6:29" /></para>
  <para style="s">Yesu kangualyegheha hilyo bhandu Elfu nhano</para>
  <para style="r">
    <ref loc="MAT 14:13-21">Matayu 14:13-21</ref>; <ref loc="LUK 9:10-17">Lukasi 9:10-17</ref>; <ref loc="JHN 6:1-14">Yohane 6:1-14</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Bhala andumitumi bha Yesu bhakibhuya na bhakinng'ombela mihalu hyoha yaatendite na kuhunda. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Pakibhegha bhandu atangalo muno bhaghenditeghe na kubhuka kwa Yesu mbaka Yesu na andumitumi bhake mbaka bhakilepelwa kulyegha, kakiaghombela ahundwa bhake, “Tughende pa nga bhandu, ngati makapughwe” <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Ndo bhakibhuka ghweka chabhe mu mbhwato bhakighenda kutama pa nga bhandu. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Peni bhandu atangalo bhakiabhona paaghenda, na bhakipamanya paaghendite, nabho bhakighenda kwa maghulu kuhuma mu kila hitami, nabho bhakilongola kuhika. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Yesu pakahikite ku nnima nnyumu na kulubhona lula lumati lwa bhandu, kakiabhonela luhungu kiyaha bhakibhegha handa mene bha nga nhakila. Hino kakiyanda kubhahunda mihalo miyoloho.<verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />Makimuhi paghaheleliti, ahundwa bhake bhakinng'endela na bhakinng'ombela, “Apa patutamite ndo pakibhala na hinu lubhindu lunguyanda kuyingila. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Hino ghualaghe bhandu aghende mumighunda na mu hijiji hya kubhwegha bhakahemele hilyo.”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Peni Yesu kakiayanga “Mubhapeghe mwenga hilyo.” Bhakinnkonya, “Nhunda ghungubhona ng'obhe kukita yingutupala tubheghe na ngalabha nyoloho ndo twahotola kubhahemelela bhandu abha hilyo?” <verse eid="MRK 6:37" /><verse number="38" style="v" sid="MRK 6:38" />Yesu kakiakonyekeha, “Ng'ende mukalolekehe yibhegha mangate milingi?” Bhakighenda na paabhuyite bhakinng'ombela, “Yibhegha mangate nhano na homba abhili.” <verse eid="MRK 6:38" /><verse number="39" style="v" sid="MRK 6:39" />Ndo Yesu kakiakwilikiha bhaatamihe bhandu mu himati himati mumanyahi mabhihi. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Nabho bhakitama muhimati hya bhandu mbinda mabhoko kumi na bhangi mbinda mabhoko nhano. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Mbole Yesu kakiyitola yila mangate nhano na bhala homba abhili kakilolekeha kuluhingu, kakinnumba Chapanga, kakiyimetula yila mangate, na kakiapegha ahundwa bhake bhabhapeghe bhandu bhoha. Hila hila bhakiapegha bhandu bhoha bhala homba abhili. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Bhandu bhoha bhakilyegha na bhakiyukuta. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Ahundwa bhake bhakihiyola mahighalo gha hipalamande hya mangate na homba, na bhakimemekeha hikapu mbinda mabhoko yimo na hibhili.<verse eid="MRK 6:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 6:44" />Mbalango ya bhandu alumi bha alyeghite bhakibhegha elfu nhano.<verse eid="MRK 6:44" /></para>
  <para style="s">Yesu kangutyanga unani mwa machi</para>
  <para style="r">
    <ref loc="MAT 14:22-33">Matayu 14:22-33</ref>; <ref loc="JHN 6:15-21">Yohane 6:15-21</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Kamu, Yesu kakiakwilikia ahundwa bhake ayingile mu mbhwato bhalongole kughenda ku Betisaida kumwambo ya lihibha, mwene pakabheghite mukualagha lumati lula lwa bhandu. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Mbole ya kualagha bhandu, mwene kakighenda kukitumbi kunntundamila Chapanga.<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />Payihikite makimuhi ghula bhwato ghukibhegha pakati ya lihibha, na Yesu kakibhegha ghweka chake munnima nnyumu. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Kakiabhona ahundwa bhake mu bhwato bhakighayaghaya pa bhakibhyatula kwa makakala, kiyaha likibhegha liyegha likiapingika. Ugheghela na kuchegha Yesu kakiaghendela ahundwa bhake pakityanga unani mwa machi. Ywombe hamba kakapaliteghe kubhayomboka. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Peni paanmonite pakityanga unani mwa machi bhakihwacha kakibha lihoka, bhakitula kyobho. <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />Kiyaha bhoha paanmonite bhakiyoghopa muno. Mbole Yesu kakighomba nabho, “Nkotoke kuyoghopa! Ndo nenga!” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Kakihubhuka mubhwato ghwa abheghite na lila liyegha likiyima! Bhala ahundwa bhakikangacha muno. <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />Kiyaha bhakimanya ng'obhe nhalo ghwa yila mangate abhalyeghitehe bhandu elfu n'hano, ndo mahala ghabhe ghakighubhanikwa.<verse eid="MRK 6:52" /></para>
  <para style="s">Yesu kangualamiha atamwa akwo Genesaleti</para>
  <para style="r">
    <ref loc="MAT 14:34-36">Matayu 14:34-36</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Paayombokiti lihibha, bhakihika nnima ghwa Genesaleti, bhakipaghika bhwato ghwabhe <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Pabhahulukite kuhuma mu bhwato ghula, bhandu bhakinmanya Yesu, <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Bhakighenda mu nnima ghwoha kanongola nongola, bhakiayegha atamwa mumikahe yabhe na bhakiayegha kwoheli paayihwite kukita Yesu kakibhegha. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Na kwoheli kula pakaghendite Yesu, yibhe muhijiji na muhitami ebu mumighunda bhandu bhakiabhika atamwa bhabhe pa hindangabhanji na bhakinpembeleha kabhategheke bhabyale lipinda lyake na bhoha bhaanbyalite lipinda lyake bhakilama.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Mahundo kuhuma kwa aghohi</para>
  <para style="r">
    <ref loc="MAT 15:1-9">Matayu 15:1-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Akaafalisayo na amoo bha Ahunda bha malaghilo bhaahumite ku Yelusalemu bhakikwemukila kuulongolo ghwa Yesu. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />Bhakiabhona amoo bha ahundwa bha Yesu bhakilyegha hilyo kwa mabhoko ghabhe kya nga kukuha handa mughapalite malaghilo gha Akaayahudi.<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />Akaafalisayo na Akaayahudi bhoha kahone kulyegha hilyo mbaka akuhe mabhoko ghabhe mbaka ku kingogho kiyaha angukamulila hitohe hya aghohi bhabhe. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Paahuma ku hindandabhanji kahone kulyegha mbaka akuhe. Kangi yibhegha hitohe hingi hiyoloho hya ahalite handa bhula kughulula ndebho, hibhigha na hilibhi hya mahabha.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Hino bhala ahunda bha malaghilo na Akaafalisayu bhakinkonya Yesu, “Yibha bhuli ahundwa bhako bhangutughila ng'obhe mihumu ya aghohi bhetu mbole yake angulyegha kwa mabhoko ghana kinyakali?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Yesu kakiayanga, “Mbuye Isaya kakilondola hoto ya kya mwenga, mwenga maafyangu, handa pakatyekite,</para>
  <para style="q" vid="MRK 7:6">Chapanga kangulongela, ‘Bhandu abha bhangunyikitila kwa milomo yabhe,</para>
  <para style="q" vid="MRK 7:6">peni miyoyo yabhe yibhegha kutali na nenga.<verse eid="MRK 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MRK 7:7" />Bhangundundamila yaghi,</para>
  <para style="q" vid="MRK 7:7">paakihunda hitohe hya anabhandu paakighomba agho ndo malaghilo gha Chapanga.’<verse eid="MRK 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MRK 7:8" />Mwenga muyileka malaghilo gha Chapanga na kuyikamula mihumu ya anabhandu.”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Yesu kakiaghombela, “Mwenga mmegha na njenjelo ya kuyilema ngwilikiho ya Chapanga ngati muyikamule mihumu yenu! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Kwa nhwano, Musa kakighomba, ‘Ghubhayikitile tate na ma ghwako’ na ‘ywoheli ywakanligha tate ghwake ebu ma ghwake kakomwe’ <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Peni mwenga mungughomba, mundu ywakanng'ombiliti tate ghwake ebu ma ghwake kukita, ‘Kila kya kukutanga ghwenga ndo Kolibani’ kukita kibhibhegha lilumbo lya kya Chapanga, <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />Mbole ya agha kangukwilika ng'obhe kuntanga tate ebu ma ghwake. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Kwa njenjelo ayi mwenga munguyuyuha lilagho lya Chapanga kwa mihumu yenu yimulibhikilite. Mwenga mukutenda mihalu miyoloho yakya njenjelo ayo.”<verse eid="MRK 7:13" /></para>
  <para style="s">Mihalo yinakun'bhika kakatende ulemwa kwa kya Chapanga</para>
  <para style="r">
    <ref loc="MAT 15:10-20">Matayu 15:10-20</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Yesu kakilukema kangi lula lumati lwa bhandu na kakiaghombela, “Nnyihwanile, bhoha na mmanye nlando aghu. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Kahone kilibhi kina kunyingiha mundu kakatende ulemwa kwa kya Chapanga, peni kina kummuka ndo kina kunbhika mundu kakatende ulemwa kwa kya Chapanga. <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />Handa mundu ywoheli yuna makutu gha kuyihwa, na kayihwe.”<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Pakalulekiti lula lumati lwa bhandu na kuyingila munyumba kati, ahundwa bhake bhakinkonya mana ya ndambulo yila. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Kakiayanga, “Na mwenga mmanya ng'obhe? Mmanya ng'obhe kukita kilibhi kinakunnnyingila kahone kunbhika mundu kakatende ulemwa kwa kya Chapanga? <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Kiyaha mundu pakalyegha kilibhi kingunnyingila ng'obhe mu mwoyo maha mulutumbo, mbole kingummuka panji ya mmili bhake.” Kya kulongela naha Yesu kakihiteghekeha hilyo hyoha kukita hya maha kwa kulyeghwa.<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Kakighendelela kughomba, “Kila kinakummuka mundu ndo kingunbhika kabhe na ulemwa kwa Chapanga. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Kiyaha kuhuma mumwoyo ghwa mundu kungubhuka, hwachilo ya mahakataho na utyahe na bhwihi na kukoma na <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />lumatamata na tama ya uhakata na ukiluko na uhwangi na tama ya utopelo na malili na maligho na lukilu na ubhughabhugha. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Mihalu ayi hyoha yinguhuma mu mwoyo ghwa mundu naywo na ndo yina kunbhika mundu kabhe nhokela.”<verse eid="MRK 7:23" /></para>
  <para style="s">Kuhyubhalila kwa nndala Nsilofoinike</para>
  <para style="r">
    <ref loc="MAT 15:21-28">Matayu 15:21-28</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Ndo Yesu kakibhuka akwo na kakighenda ku nnima ghubheghite ugheghela na Tilo. Kakiyingila mu kitutubhi kimo, na mwene kakipala ng'obhe bhandu amanye kukita kabhegha amo. Peni kakihotola ng'obhe kulihiha. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Peni nndala yumo ywakabheghite na nhinja nndokwa naywo kakibhegha na mandilu kakiyihwa mihalu ya Yesu na kakinhikila na kakichutamila mayughwa muulongolo ghwa Yesu. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Hinu aywo nndala kakibhegha ng'obhe Nnyahudi, nkolannima ghwa ku Foinike ya akwo Silia. Kakinnyupa Yesu kakaghabhuhe mandilu kwa nhinja ghwake.<verse eid="MRK 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27" />Yesu kaking'ombela, “Ghubhaleke bhana ayukute huti, yibhegha maha ng'obhe kutola hilyo ya bhana na kuataghila kabhwa.”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />Peni yula nndala kakinnyanga, “Bambo, na akabhwa abheghite pahi pakindangabhala alyeghagha mahighalo gha hilyo hya bhana.”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Ndo Yesu kakinnyanga, “Kiyaha ya kya liyango alyo, ghughende kulubhagha lwako na yula lindilu kammuka kala nhinja ghwako.”<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Kakibhuya kulubhagha lwake na kakinmona nhinja ghwake kakighonja paulili, na lila lindilu likimmuka kala.<verse eid="MRK 7:30" /></para>
  <para style="s">Yesu kangunlamiha mundu ywanga kuyihwa na yuna kimama</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Mbole Yesu kakibhuka ako ugheghela na Tilo, kakipitila Sidoni mbaka Dekapoli nnima ghuna hitami mbinda mabhoko yimo mbaka kakihika kulihibha Galilaya. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Akwo bhandu bhakinnyeghela mundu yumu ywa nga kuyihwa na kana kimama, bhakinnyupa kakannyabhikile kibhoko kyake ngati kakannlamihe. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />Mbole Yesu kakinnyegha yula ywa nga kuyihwa kutali na bhandu, Yesu kakinnyingiha hikonji hyake mu makutu ghake, kakihuna mata muhikonji hyaki na kakilubyala lulimi lwa yula mundu. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Mbole kakilolekeha kunani kuluhingo kakitweta kwa makakala kakinng'ombela, “Efata!” Mana yake “Hughuka.”<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />Kamu, makutu ghake ghakihughuka na lulimi lwake lukilekekehwa kakiyanda kulongela maha. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Yesu kakibhakwilikiha bhakotoo kunnongela mundu ywohele mihalo aywo. Peni paabhakanikihite ndo bhakiyonjokeha kulandamiha munu mihalu aywo. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Bhandu bhoha bhakikangacha munu, bhakilongela “Katenda mihalo hyoha yinakunoghela munu, kabhatangatila bha nga kuyihwa, kuyihwa, na bhana kimama bhalongele.”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Yesu kangualyegheha bhandu Elfu ncheche.</para>
  <para style="r">
    <ref loc="MAT 15:32-39">Matayu 15:32-39</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Mumasiku agho, lumati lukulu lwa bhandu lukikwemuka kangi, na bhakibhegha ng'obhe na hilyo. Hino Yesu kakiakema ahundwa bhake na kakiaghombela, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“Nungulubhonela luhungu lumati alu lwa bhandu, kiyaha hino bhabhegha na nenga kwa masiku mandatu na kibhahone kya kulyegha. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Handa panialagha aghende ukaya kwabhe kya nga kulyegha, bha hima kwa njala munjila, mana amoo bhangi ahumila kutali.”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Ahundwa bhake bhakinkonya, “Apa pakibhala twahumbula kwoki mangati gha kukwila kulyegha lumati lwoha alu?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Yesu kakiakonya, “Mubha na mangate milingi?” Ahundwa bhake akinnyanga, “Tubhegha na mangate saba.”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Kakiakwilikiha bhandu bhoha atami pahi. Ndo kakiyitola yila mangate saba, kakinnumba Chapanga kakiyimetulanga yila mangate, kakiapegha ahundwa bhake abhaghabhanikihe bhandu, nabho bhakiaghabhanikiha bhandu. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Hilahila bhombe bhakibhegha na hihomba hya mandina, Yesu kakinnumba Chapanga kwa kya bhala homba na kakiakwilikiha ahundwa bhake abhapeghe bhandu ubwabhu abhu. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Bhandu bhala bhakilyegha na kuyukuta na mbole yake ahundwa bhakikungana hipalamande hihighalite na bhakimemekeha hikapu nhano na ibhili. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Bhandu bha alyeghite akibhegha elfu ncheche. Ndo Yesu kakialagha. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Kamu kakihubhuka mubhwato papamo na ahundwa bhake na kakighenda ku kitami kya Dalumanuta.<verse eid="MRK 8:10" /></para>
  <para style="s">Akaafalisayo bhangupala nhabho</para>
  <para style="r">
    <ref loc="MAT 12:38-42">Matayu 12:38-42</ref>; <ref loc="MAT 16:1-4">16:1-4</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Amoo bha Akaafalisayo bhakinhikila Yesu, na bhakiyanda kughombana naywo kwa kunng'eha na bhakinpala katende nhabho ghwa kunmanyiha kwa bhene kukita makakala ghake ghakuhuma kwa Chapanga.<verse eid="MRK 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 8:12" />Peni Yesu kakikukulika mumwoyo na kakiaghombela, “Kiyaha niki kibheleko aki kingupala nhabho? Kulyaghila, nungubhaghombela, kya kamuhwa ng'obhe nhabho ghwoheli.”<verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />Mbole kakibhaleka, kakihubhuka ku bhwato, na kakiyomboka kumwambo yingi ya lihibha.<verse eid="MRK 8:13" /></para>
  <para style="s">Linjakamu lya Akaafalisayo na Helode.</para>
  <para style="r">
    <ref loc="MAT 16:5-12">Matayu 16:5-12</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Ahundwa bhake bhakilibhalila kuyegha mangate ya kukwila, na bhakibhegha na lingate limo mubhwato. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Yesu kakiatakilila, “Nhingukihe, na linjakamu lya Akaafalisayo na linjakamu lya Helode.”<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Bhakiyanda kughombana bhene kwa bhene, bhakighomba, “Kangulongela naha kiyaha tuyegha ng'obhe mangate.”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Yesu kakighamanya maghombano ghabhe, na kakiakonya, “Kiyaha niki mungughombana nhalo ghwa nga kuyegha mangate? Nkali kundambula ebu kumanya ng'obhe? Yibha bhuli mioyo yenu yibha na unonopo naha? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Bhuli mmegha na meho peni mungulepelwa kubhona! Bhuli mmegha na makutu peni mungulepelwa kuyihwa? Bhuli nde mungundambula ng'obhe? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Pala pametulite mangate nhano na kubhalyegheha bhandu Elfu nhano, mukikungana mahighalo gha hikapu hilingi?” Ahundwa akinnyanga, “Mbinda mabhoko yimo na hibhili.”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />“Na pametulite yila mangate nhano na ibhili na kualyegheha bhandu elfu ncheche, mukikungana mahighalo gha mangate, hikapu hilingi himemekihitwe?” Akinnyanga “Nhano na ibhili.”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Ndo kakiakonya “Nde nkali kumanya?”<verse eid="MRK 8:21" /></para>
  <para style="s">Yesu kangunlamiha mundu ywangakubhona ku Betisaida.</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Yesu na ahundwa bhake bhakihika ku Betisaida, amoo bhandu bhakinnyegha mundu ywa nga kubhona, bhakinnyupa kakan'yabhike. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Yesu kakinkamula kibhoko ywa nga kubhona aywo, kakinnyegha panji ya kijiji. Kakinhunila mata mu meho ghake yula ywa nga kubhona na kunmikila mabhoko mu meho, kakinkonya “Ghungubhona kilibhi kyoheli?” <verse eid="MRK 8:23" /><verse number="24" style="v" sid="MRK 8:24" />Yula ywa nga kubhona kakilola, kakilongela, “Ningubhona bhandu angubhonekana handa mikongo yinakutyanga.”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Yesu kakinmikila kangi mabhoko ghake mumeho yula ghwa nga kulola. Naywo kakihulutula meho, kubhona kwake hinu kukimmuyila, kakilola hilibhi hyoha telatela. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Yesu kakinlagha kabhuye ukaya kwake na kakinkwilikiha, “Ghukotoo kuyingila kukijiji.”<verse eid="MRK 8:26" /></para>
  <para style="s">Petili kangunnyimiha Yesu kukita ndo Kilisto.</para>
  <para style="r">
    <ref loc="MAT 16:13-20">Matayu 16:13-20</ref>; <ref loc="LUK 9:18-21">Lukasi 9:18-21</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Yesu na ahundwa bhake bhakibhuka na kughenda nng'eghela mwa hijiji hya Kaisaliya Filipi. Paabheghite munjila, Yesu kakiakonya, “Bhandu angulongela nenga ndo ghani?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Bhakinnyanga, “Amoo bhandu angulongela ghwenga ndo Yohana yunakubatisa, bhangi angulongela ghwenga ndo Eliya na bhangi angulongela ghwenga ndo yumoo yumo ywa mambuye ghwa Chapanga.” <verse eid="MRK 8:28" /><verse number="29" style="v" sid="MRK 8:29" />Yesu kakiakonya, “Mwenga mungulongela nenga ndo ghani?” Petili kakinnyanga, “Ghwenga ndo Kilisto ywakahaghulitwe na Chapanga.” <verse eid="MRK 8:29" /><verse number="30" style="v" sid="MRK 8:30" />Mbole Yesu kakiakanikiha, “Akotoke kunng'ombela mundu ywohele mihalo ya nenga.”<verse eid="MRK 8:30" /></para>
  <para style="s">Yesu kangulondola nhalo ghwa kimbamanda, kughwegha na kuhyuka kwa ywombe.</para>
  <para style="r">
    <ref loc="MAT 16:21-28">Matayu 16:21-28</ref>; <ref loc="LUK 9:22-27">Lukasi 9:22-27</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Hino Yesu kakiyanda kuhunda ahundwa bhake, “Mwana ghwa Mundu katambamandwa na katalemwa na aghohi, na mandundame akulu na ahunda bha malaghilo. Kukita katakomwa, na mbole ya masiku mandatu katahyuka.” <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Yesu kakilongela habhu kya nga uhiho. Ndo Petili kakinkemela pambwegha na kakiyanda kunlakalila. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />Peni Yesu kakikilibhuka na kualolekeha ahundwa bhake, kakinlakalila Petili na kakilongela. “Ghubhuke kughulongolo ghwangu Nchipila! Ghwenga ghwangahwacha gha Chapanga ngati gha anabhandu.” <verse eid="MRK 8:33" /><verse number="34" style="v" sid="MRK 8:34" />Mbole kakilukema lula lumati lwa bhandu na ahundwa bhake, kakiaghombela, “Mundu ywohele ywakapala kundughila, mbaka kalileme mwene, kalutole lupingika lwake, kandughile nenga. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Mana mundu ywohele ywakapala kuulopoha ubhumii ghwake katauhobheha, peni mundu ywaka uhobheha ubhumi ghwake kwa kya nenga na kwa kya Mihalo ya Maha kataulopoha. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Mundu katamota niki handa kataghukamula nnima ghwoha na kuuhobheha ubhumi ghwake? Kabhone kumota kyoheli. <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Ebu mundu katabhika kilibhi ghani kihegheke ubhumi ghwake? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Mundu ywoheli ywakanmonela honi nenga na mahundo ghangu mukibheleko kya utyahe na kya uhokelo. Mwana ghwa Mundu katammonela honi pakalonda kubhuya muukulu ghwa Tate ghwake papamu na mahoka bha Chapanga.”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Yesu kakighendelela kubhaghombela, “Kulyaghila nungubhaghombela, amoo bhandu bhaayimite apa bhatahwegha ng'obhe mbaka paalonda kughubhona Ghubhutwa ghwa Chapanga paghuhika kwa makakala.”<verse eid="MRK 9:1" /></para>
  <para style="s">Yesu kangughalambuka kibhungi</para>
  <para style="r">
    <ref loc="MAT 17:1-13">Matayu 17:1-13</ref>; <ref loc="LUK 9:28-36">Lukasi 9:28-36</ref></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Mbole ya nhano na yimo, Yesu kakighenda papamu na Petili na Yakobu na Yohana mbaka kukitumbi kitandamaho kwa nga bhandu, kakighalambuka kibhungi mu ulongolo ghwabhe. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Mapinda ghake ghaking'anyima ng'anyi, kahone mundu ywoheli ywa kahotola kung'anyihya handa bhula, pannima apa, <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />bhakibwitukila Eliya na Musa, bhakibha pa ayobhela na Yesu <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />Petili kakinng'ombela Yesu. “Nhunda, inoghela twenga tutame apa, tuchenge higubi hindatu, kimo kya ghwenga na kimo kingi kya Musa na kingi kangi kya Eliya.” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Petili na ayake bhakimanya ng'obhe kya kughomba kiyaha bhakiyoghopa muno.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Ndo likibwitukila lihundi likibhagubika na lilobhe likiyihwanika kuhuma mu lila lihundi palighomba, “Ayu ndo Mwana ghwangu yununpala munnyihwanile ywombe.” <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />Kamu paalyungite mehu kunu na kunu bhakimmona ng'obhe mundu ywoheli papamu naywo; ngati nga Yesu ghweka chake.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Paabheghite mukuhelela kuhuma kukitumbi, Yesu kakiakwilikiha, “Nkotoo kunng'ombela mundu ywohele mihalu muyibhonite mbaka Mwana ghwa Mundu pakalonda kuhyuka.”<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />Bhakilikamula lilaghilo alyo na bhakighombana, “Akwo kuhyuka mana yake ndo niki?” <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />Bhakinkonya, “Bhuli ahunda bha malaghilo angulongela, Eliya kahiki huti?” <verse eid="MRK 9:11" /><verse number="12" style="v" sid="MRK 9:12" />Yesu kakiayanga “Tela, Eliya katalongola huti kutengeleha mihalu hyoha. Bhuli hino yityekwa kukita Mwana ghwa Mundu inogha kambamandike muno na kuyuyuhwa? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Peni nungunng'ombela, Eliya kahika kala nabho antendela bhaghapalite handa muyityekitwe ya kya ywombe.”<verse eid="MRK 9:13" /></para>
  <para style="s">Yesu kangunnamiha nhongolo yuna lindilu</para>
  <para style="r">
    <ref loc="MAT 17:14-21">Matayu 17:14-21</ref>; <ref loc="LUK 9:37-43a">Lukasi 9:37-43a</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Pabhaahikiliti bhala ahundwa bhangi, bhakiabhona bhatindilwa na lumati lukulu lwa bhandu. Na amoo ahunda bha malaghilo bhakighombana na bhombe. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Kamu bhandu bhala paammonite Yesu bhakikangacha munu, bhakintughila annamuhe <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Yesu kakiakonya ahundwa bhake, “Mungughombana nabho niki?” <verse eid="MRK 9:16" /><verse number="17" style="v" sid="MRK 9:17" />Mundu yumo ywa mulumati kakinnyanga, “Nhunda nunnyegha kwa ghwenga mwana ghwangu kana lindilo lyakantendite kabhe ywa nga kulongela. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Pipipi aywo lindilo pakankwehagha mwana ghwangu, kannghwihagha pahi na kuntenda kahumwe na lihuluhulu munnomo na kuhyagha meno, mbole mmili ghwake ghungukakama. Nikibhayupa ahundwa bhako bhammuhe aywo lindilu peni bhakilepelwa.” <verse eid="MRK 9:18" /><verse number="19" style="v" sid="MRK 9:19" />Yesu kakiaghombela, “Mwenga kibheleko kya nga uhyubhalilo nda tama na mwenga mbaka pakiki? Ndabhalimbilila mbaka pakiki? Munnyeghe aywo nhongolo kwa nenga.” <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Bhombe bhakinnghegha yula nhongolo Yesu. Kamu lila lindilu pakammonite Yesu kakinkweha kihilika naywo nhongolo kakighwegha pahi kakibingilika na kuhumiha lihuluhulu pa ngulu. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />Yesu kakinkonya tate ghwa yula nhongolo “Nnando aghu ghuntandila pakiki?” Naywo kakinnyanga, “Kutandila pa ukakombo ghwake. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />Pipipi lindilu aywo likinnghwiha mumwoto na mumachi ngati kankanjaghane yomo, hinu handa ghwa hotola chonde ghutubhonele luhungu ghututange.” <verse eid="MRK 9:22" /><verse number="23" style="v" sid="MRK 9:23" />Yesu kakinng'ombela, “Ena handa ghwa hyubhalila, mihalo hyoha yahotoleka kwa mundu yunakuhyubhalila.” <verse eid="MRK 9:23" /><verse number="24" style="v" sid="MRK 9:24" />Kamu, tate ghwa yula nhongolo kakinlilila Yesu, “Ninguhyubhalila, peni uhyubhalilo ghwangu ukwila ng'obhe, ghundange.” <verse eid="MRK 9:24" /><verse number="25" style="v" sid="MRK 9:25" />Yesu pakabhonite lumati lwa bhandu lukinkwemukila papamu kanongola, kakinkwlikiha yula lindilu, kakinng'ombela, “Ghwenga lindilu ghwanga kughomba na kuyihwa, nungughukwilikiha, ghummuke nhongolo ayu na ukotoo kunnyingila kangi.” <verse eid="MRK 9:25" /><verse number="26" style="v" sid="MRK 9:26" />Yula lindilu kakikyota kyobho, kakinnghwiha, kakinloghoheya kwa makakala na kakimmuka. Yula nhongolo kakibhegha handa ntumba bhandu bhakilongela “Kahwegha!” <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Peni Yesu kakinkamula kibhoko yula kakombo, kakinnyinula naywo kakiyima.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Mbole, Yesu kakiyingila munyumba kati, ahundwa bhake bhakinkonyekeha mwa bhabheghite pa ghweka chabhe, “Bhuli twenga tukihotola ng'obhe kunmuha yula lindilu?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />Yesu kakiayanga, “Ndendo ya kya naha kahone kubhuka maha kwa kunnyupa Chapanga na kulikunga.”<verse eid="MRK 9:29" /></para>
  <para style="s">Yesu kangulongela kangi ya kya kuhwegha</para>
  <para style="r">
    <ref loc="MAT 17:22-23">Matayu 17:22-23</ref>; <ref loc="LUK 9:43b-45">Lukasi 9:43b-45</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Yesu na ahundwa bhake bhakibhuka akwo bhakipitila ku Galilaya. Yesu kakilema mundu ywohele kamanye kwa kabheghite. <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />Kiyaha kakibha mu kuahunda ahundwa bhake. Kakiaghombela, “Mwana ghwa Mundu katakilukwa na kukamuhwa kwa bhandu nabho bhatankoma mbole ya lisiku lya ndatu katahyuka.” <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Peni, ahundwa bhake bhakimanya ng'obhe kila kyakaahundite, nabho bhakihyoghopa kunkonya.<verse eid="MRK 9:32" /></para>
  <para style="s">Ghani ywakabheghite Nkulu?</para>
  <para style="r">
    <ref loc="MAT 18:1-5">Matayu 18:1-5</ref>; <ref loc="LUK 9:46-48">Lukasi 9:46-48</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Hinu bhakihika ku Kapelinaumu mbole ya kuyingila mu kitutubhi Yesu kakiakonya ahundwa bhake, “Mukighombana kingiki munjila?”<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />Peni bhene bhakinnyamala, kiyaha panjila pala bhakighombana ya kya ghani ndo nkulu mubhombe. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />Yesu kakitama pahi na kakibhakema bhala ahundwa mbinda mabhoko yimo na abhili na kakiaghombela, “Handa mundu ywoheli ywakapala kubhegha kilongohi inogha kabheghe ghwa kundahe dokwa na kabhe ndumitumi ghwa bhoha.” <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />Mbole kakintola mwana nndokwa kakinnyimiha pakati yabhe, kakinpakata na kakiaghombela, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“Mundu hyowele ywakankemela yumoo, ywa abha bhana adokwa kwa lihina lyangu, kangungemela nenga. Naywo ywaka ngemela nenga kangunkema yula ywakanaghilite.”<verse eid="MRK 9:37" /></para>
  <para style="s">Ywa nga kutupingika kabhegha papamu na twenga</para>
  <para style="r">
    <ref loc="LUK 9:49-50">Lukasi 9:49-50</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Yohana kaking'ombela “Nhunda, tunmona mundu kangubhua mandilo kwa lihina lyako, twenga tukinkanikiha kiyaha ywombe kabha mukimati kyetu ng'obhe.” <verse eid="MRK 9:38" /><verse number="39" style="v" sid="MRK 9:39" />Yesu kakighomba, “Mangankanila, kahone ywohele ywakatenda mihabho kwa lihina lyangu mbole kahotole kukambuka lya uhakata kwa nenga. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Kiyaha ywakabhegha tela na twenga kabha mu mbande yatu. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Kulyaghila nunguaghombela, ywohele ywakanpegha mwenga nteko ghwa machi gha kunywegha kiyaha mwenga ndo bhandu bha Kilisto kulyaghila kahone kuhobha lilumbo lyake.”<verse eid="MRK 9:41" /></para>
  <para style="s">Unyeghelehi ghwa kutenda ulemwa</para>
  <para style="r">
    <ref loc="MAT 18:6-9">Matayu 18:6-9</ref>; <ref loc="LUK 17:1-2">Lukasi 17:1-2</ref></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“Mundu ywohele ywakannyegheleha yumoo ywa adokwa abha bhatenda ulemwa, yingunnoghela mundu aywo kabhopelwe liganga likulu lya kuhyagila muntandala ghwake na kuchumbukihwa mulihibha. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Kibhoko kyakyo pakighunyegheleha ghutende ulemwa ghukilumuhe. Mbaha ghuyingile mu ubhumi kya nga kibhoko kimo chepa kuyingila na mabhoko mabhili na kuchumbukihwa mumwoto ghwa masiku ghoha ghwa nga kuhimika. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />Amwo, mahinje ghake anguhwegha ng'obhe na mwoto ghwake ghwa nga kuhimika. <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Na kighulu kyako pakighunnyegheleha kutenda ulemwa, ghukilumule, mbaha ghuyingile muulami kya nga kighulu kimo, chepa kuyingihwa na maghulu ghako ghoha mabhili na ghutaghwe mumwoto ghwa masiku ghoha ghwa nga kuhimika. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />Amwo, mahinye ghake kahone kuhwegha na mwoto ghwake ghwa nga kuhimika masiku ghoha. <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Na liho lyako palighunyegheleha ghutende ulemwa, ghulitupule, mbaha ghuyingile mu Ghubhutwa ghwa Chapanga na liho limo ndu chepa kubhegha na meho ghoha mabhili na ghutaghwe mu mwoto ghwa masiku ghoha ghwa nga kuhimika. <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />Amwo, ‘Mahinye ghake kahone kuhwegha na mwoto ghwake ghwa nga kuhimika.’ ”<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />“Mana mundu ywohele kaalungwa mwinyo kwa mwoto.”<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />“Mwinyo ntema ghwa maha peni handa payiluluka, ghwalungihwa na niki?”</para>
  <para style="p" vid="MRK 9:50">“Mmeghe na mwinyo mu mwenga, na ntame kwa uhihimilo nkati yenu.”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Yesu kangukonywa ya kya kutolana na kulekana</para>
  <para style="r">
    <ref loc="MAT 19:1-12">Matayu 19:1-12</ref>; <ref loc="LUK 16:18">Lukasi 16:18</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Yesu kakiyomboka lukemba lwa Yoludani na kakighenda ku nnma ghwa Yudea. Lumati lwa bhandu lukintughila, naywo kakibhahunda handa kitohe kyake.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Hino Akaafalisayo bhakinng'endela kunng'eha na bhakinkonya, “Bhuli, malaghilo ghanguyegheka mundu nnume kunleka nndala ghwake?” <verse eid="MRK 10:2" /><verse number="3" style="v" sid="MRK 10:3" />Yesu kakiayanga, “Musa kakiakwilikiha niki?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Bhombe bhakinnyanga, “Musa kakitegheka kukita mundu katantyekela lihamba lya kunleka nndala ghwake na kunleka.”<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Yesu kakiaghombela, “Musa kakityeka laghilo alyo lya kya unonopo ghwa myoyo yenu <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Peni kutandila ubhumbilo ghwa nnima, ‘Chapanga kakiabhumba mundu nnume na mundu nndala.’ <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />‘Ndo nnume katanleka tate ghwake na ma ghwake naywo katalungana na nndala ghwake. <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />Abha abhili bhatabhegha mmmili ghumo.’ Hinu abho abhili ng'obhe ngati mmili ghumo. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Hinu, kyakakilungite Chapanga, anamundu kakotoo kupwilinganiha.”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Pakayingilite munyumba kati, ahundwa bhake bhakinkonya ya kya nhalo ghula. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Mwene kakiaghombela, “Ywakanleka nndala ghwake na kutola yungi, kangutenda utyahe. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Na nndala ywakanleka nnume ghwake na kakatolelwa na nnume yungi, kangutenda utyahe.”<verse eid="MRK 10:12" /></para>
  <para style="s">Yesu kanguanonela bhana adokwa</para>
  <para style="r">
    <ref loc="MAT 19:13-15">Matayu 19:13-15</ref>; <ref loc="LUK 18:15-17">Lukasi 18:15-17</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Bhandu bhakinnyeghela Yesu bhana adokwa ngati kabhayabhike mabhoko ghake unani mwabhe, ahundwa bhake bhakialakalila. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Yesu pakabhonite naha kakikalala na kakiaghombela ahundwa bhake, “Mubhategheke bhana ahike kwa nenga, nkotoke kuakanikiha, kiyaha Ghubhutwa ghwa Chapanga ndo ghwa bhandu bha abheghite handa abha.” <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Kulyaghila nunguaghombela, mundu ywoheli ywa nga kukingama Ghubhutwa ghwa Chapanga handa bhana adokwa kahone kuyingila amwo. <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Ndo kakiatola bhala bhana mu mabhoko ghake kakiapakata, kakiayabhika mabhoko ngati abhanonele.<verse eid="MRK 10:16" /></para>
  <para style="s">Mundu yunautopelo</para>
  <para style="r">
    <ref loc="MAT 19:16-30">Matayu 19:16-30</ref>; <ref loc="LUK 18:18-30">Lukasi 18:18-30</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Yesu pakabheghite mu kubhuka, mundu yumo kakintughila, kakitundamila mayughwa mu ulongolo ghwake na kakinkonya, “Nhunda ghwa maha, ndende niki nighuhale ubhumi ghwa masiku ghoha ghwa nga uhiko?” <verse eid="MRK 10:17" /><verse number="18" style="v" sid="MRK 10:18" />Yesu kakinnyanga, “Kiyaha niki ghungungema ghwa maha? Kahone mundu ghwa maha, ngati nga Chapanga ghweka chake. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Ghungughamanya malaghilo, ‘Kukoma kata, utyahe kata, kuyibha kata, unyimiho ghwa uhwangi kata, ukubhuhi kata, ghubhayikitile tate ghwako na ma ghwako.’”<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Mwene kakinnyanga, “Nhunda, malaghilo agha hyoha nikighakamula tangu pa meghite nhongolo.” <verse eid="MRK 10:20" /><verse number="21" style="v" sid="MRK 10:21" />Yesu kakinlolekeha na kakinpala, ndo kakinng'ombela “Ghupelelwa na kilibhi kimo ghughende ghukahemengane hyoha hiubheghite nahyo na ghubhapeghe ngalabha ahyo bhandu kapukwa, ghwabhegha na utopelo nnyoloho ku luhingu, mbole ghundughile.” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Yula mundu pakayihwite agho, kakukulika muno na kakibhuka kunu pakahyononeka, kiyaha kakibha na utopelo nnyoloho.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Yesu kakilolekeha mbande hyoha, kakiaghombela ahundwa bhake, “Kya bhuli yabhegha unonopo kwa bhana utopelo kuyingila mu Ghubhutwa ghwa Chapanga!”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Ahundwa bhake bhakikangacha muno kwa malagho agho, Yesu kakiaghombela kangi, “Bhana bhangu, kya bhuli yabhegha unonopo mundu yuna kuhyubhalila utopelo kuyingila mu Ghubhutwa ghwa Chapanga. <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Yabhegha unonopo kwa yunautopelo kuyingiha mu Ghubhutwa ghwa Chapanga mbaha ya nnyama ngamia kuhotola kuyingila mu lilanga lya sasia.” <figure style="fig" file="14 Camel.jpg" size="col" ref="10:25">Ngamia</figure><verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Ahundwa bhake bhakikangacha muno bhakikonyana, “Ndo ghani aywo ywakahotola kulopoka?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Yesu kakiahulutulila meho na kakiayanga, “Kwa anamundu ali kahone, peni kwa Chapanga ng'obhe; hyoha kwa Chapanga yahotolwa.” <verse eid="MRK 10:27" /><verse number="28" style="v" sid="MRK 10:28" />Petili kunng'ombela, “Twenga tuhileka hyoha na kughutughila ghwenga!”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Yesu kakiaghombela, “Kulyaghila nunguaghombela mundu ywohele ywakalekite lubhagha lwake ebu nnongo ghwake ebu nhacha ebu maghwake ebu tate ghwake ebu bhana bhake ebu mighunda kwa kya nenga na kwa kya Nhalo ghwa Maha, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />mwene katakamuhwa mala mbinda mabhoko kumi mu masiku agha, kitutubhi na nnongo ghwake na nhacha ghwake na Ma ghwake na tate ghwake na bhana bhake na mighunda papamo na himbamanda, mbole ndo ubhumi ghwa nga kupela munnima ghwalonda kuhika. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Peni bhandu atangalo bhabheghite kuulongolo bhaabhegha ghwa kundahe na bha kundahe bhaabhegha bha ulongolo.”<verse eid="MRK 10:31" /></para>
  <para style="s">Yesu kangulongela paundatu ya kya kuhwegha na uhyuko ghwake</para>
  <para style="r">
    <ref loc="MAT 20:17-19">Matayu 20:17-19</ref>; <ref loc="LUK 18:31-34">Lukasi 18:31-34</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Yesu na ahundwa bhake bhakibhegha munjila kughenda ku Yelusalemu na Yesu kakialongolela. Ahundwa bhakibha na bhwaghalihi, na bhandu bhaatughilite bhakimememwa bhakiyoghopa. Yesu kakiatola kangi bhala ahundwa mbinda mabhoko yimo na abhili kya ghweka na lula lumati na kakiaghombela ghala ghaalonda kunhikila. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />Kakilongela, “Nnyihwe tunguhubhuka kughenda ku Yelusalemu, na akwo Mwana ghwa Mundu katakilukwa na katakamuhwa kwa hilongohi bha andundame na ahunda bha malaghilo. Bhene bhatantosa kiho, na kunkamuha kwa bhandu abheghite ng'obhe Akaayahudi. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />Bhene bhatanhyula, bhatanhunila mata, bhatantuta minjupuchupu na kunkoma. Peni lisiku lya ndatu kaahyuka.”<verse eid="MRK 10:34" /></para>
  <para style="s">Yakobu na Yohana bhangunnyupa Yesu</para>
  <para style="r">
    <ref loc="MAT 20:20-28">Matayu 20:20-28</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Ndo, Yakobu na Yohana, bhana bha Zebedayo, bhaking'endela Yesu na bhakinng'ombela, “Nhunda, tungupala ghututendele lyoheli lila litupala kukuyupa.” <verse eid="MRK 10:35" /><verse number="36" style="v" sid="MRK 10:36" />Naywo Kakibhaghombela, “Hinu, mungupala nibhatendele nhalo ghani?” <verse eid="MRK 10:36" /><verse number="37" style="v" sid="MRK 10:37" />Bhakinng'ombela, “paghutama mu kitebho kyako kya ukulu kya Ghubhutwa ghwako tungupala ghututamihe yumu mbande yako ya nnilo na yungi mu mbande ya nngiya.”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Yesu kakiaghombela, “Mungumanya ng'obhe kimukiyupa. Kulyaghila mahotola kulimbilia kimbamanda kya kya nenga na mabhegha kala kwa kiho kya nonda kuhwegha nenga.”<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />Bhakinnyanga “Twahotola” Ndo Yesu kakiaghombela, “Nteko ghwa nlonda kuywegha nenga manywela na ubatiso ghwa kya nenga mabatisighwa, <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Peni kutama mbande yangu ya nnilo ebu ya ngiya, aghu ndo nnando ghwa nenga ng'obhe kuapegha ngati aghu ndo ya bhala bhaabhikilitwe kala na Chapanga.”<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Bhala ahundwa bhangi mbinda mabhoko yimo paayihwite nhalo agho bhakiyanda kubhayaghabhalila Yakobu na Yohana. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Yesu kakiakema ahundwa bhake papamu na kakiaghombela, “Mungumanya kukita atabhala bha bhandu bha milima yingi bhangubhatabhala bhandu kwa makakala, nabho akulu bhanguangwiliha bhandu bhabhe. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Peni kwa mwenga kata. Mbole yake ywoheli ywakapala kubhegha nkulu mumabhene ndo yinguntama kabheghe nndumitumi ghwenu. <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />Na mundu ywoheli ywakapala kubhegha kilongohi, yinguntama kakaatumikile bhangi. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Kiyaha hata Mwana ghwa Mundu kakihika kutendelwa lihengo ng'obhe, ngati kakihika kutenda lihengo na kuubhuha ubhumi ghwake ghubheghe ukombohi kwa bhandu atangalo.”<verse eid="MRK 10:45" /></para>
  <para style="s">Yesu kangunlamiha Balitimayo mundu ywanga kubhona</para>
  <para style="r">
    <ref loc="MAT 20:29-34">Matayu 20:29-34</ref>; <ref loc="LUK 18:35-43">Lukasi 18:35-43</ref></para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Ndo bhakihika Yeliko, pala Yesu pakabhukite mukitami na ahundwa bhake papamu na lumati lukulu lwa bhandu, ywangakubhona lihina lyake Balitimayu, mwana ghwa Timayu, kakitama mumbhwegha ya njila pakiyupa utangwo. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Balitimayu pakayihwite kukita ndo Yesu ghwa ku Nasaleti ywakabheghite mukupita, kakiyanda kukweha lilobhe pakaghomba, “Yesu, Mwana ghwa Daudi, ghumonele luhungu!”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Bhandu atangalo bhakinlakalila na kung'ombela kanyamale, peni mwene kakighendelela kukweha lilobhe pakighomba, “Mwana ghwa Daudi ghunmonele luhungu!”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Yesu kakiyima na kulongela, “Munkeme” Ndo bhakinkema yula ywanga kubhona bhaking'ombela, “Ghulikunge mwoyo, ghuyime, kangughukema.”<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />Kakilitagha lipinda lyake, na kakihumba na kung'endela Yesu.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Yesu kakinkonya, “Ghungupala nukutendele niki?” Yula ywanga kubhona kakinnyanga, “Nhunda ghwangu mbala kubhona.”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Yesu kaking'ombela, “Ghughende, hyubhalilo yako yikulamiha.” Kamu yula ywanga kubhona kakilola, naywo kakintughila Yesu na kakighenda naywo papamu.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Yesu kanguyingila ku Yelusalemu kwa chekwa</para>
  <para style="r">
    <ref loc="MAT 21:1-11">Matayu 21:1-11</ref>; <ref loc="LUK 19:28-40">Lukasi 19:28-40</ref>; <ref loc="JHN 12:12-19">Yohane 12:12-19</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Pabhaheghelelite ku Yelusalem bhakihika ku hitami hya Betifage na ku Betania ugheghela na kitumbi kya Miseituni, Yesu kakibhalaghila abhili mu ahundwa bhake, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />kakiaghombela, “Nng'ende mbaka kukitami kya kuulongolo ghwenu na kamu pannyingila pakitami akyo matammona mwanakaputa kabhopelelwa lughoyi, kakali na kutendelwa lihengo. Mummopole mung'eghele apa. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Handa mundu ywohele pakabhakonya, bhuli mungunmopola? Munnyange, ‘Bambo kangunpala na hamba katammuyila.’ ”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Bhakighenda na bhakimmona mwanakaputa kabhopolelwa mumbwegha ya njila, ugheghela ghwa nlyango ghwa kitutubhi. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />Pabhabheghite mukummopola bhandu bhaayimiti paugheghela bhakiakonya, “Yibha bhuli mungummopola mwanakaputa?”<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />Bhakiayanga handa bhula pakabhalaghiliti Yesu, nabho bhandu bhala bhakibhategheka. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Bhakinnyeghela Yesu yula mwanakaputa, bhakiyalila nghubho hyabhe pang'ongo ghwake naywo Yesu kakihubhuka. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Bhandu bha atangalo bhakiyalila ngubho hyabhe munjila na amoo bhangi bhakiyalila hiputila hya mikongo bhayadumulite mumighunda ya kya kunhokamila. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Mbole bhala bhaalongolite kuulongolo na bhala bhaabheghite kukihongo unyuma bhakiyimba malobhe paaghombite, “Lilumbo! Kanonelwe mwene aywo ywakahika kwa lihina lya Bambo! <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />Ghunoneleghwa Ghubhutwa ghuupala kuhika ghwa tate ghwetu Daudi!”</para>
  <para style="q1" vid="MRK 11:10">“Lilumbo kwa mwene ywakabheghite kunani kunani muno!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Yesu kakighenda ku Yelusalemu na kakiyingila Kitutubhi kya Chapanga. Kakilolekeha hilibhi hyoha hiibheghite, peni kiyaha yikiyingila makimuhi, kakighenda ku Betania papamu na bhala mbinda mabhoko yimo na abhili.<verse eid="MRK 11:11" /></para>
  <para style="s">Yesu kangughukotola nkongo ghwa ntini</para>
  <para style="r">
    <ref loc="MAT 21:18-19">Matayu 21:18-19</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Kilabho yake pabhabheghite mukubhuka ku Betania Yesu yikinbhina njala. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Pakaghubhoniti nkongo ghwa ntini kya kutali ghubheghite na mahamba manyelemba, kakighughendela kakaghulole kukita ghukipambika, pakaghuhikiliti kakighabhona ngamahamba ghweka kiyaha yikibha kihuku kya nga kupambika. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Yesu kakighughombela ghula nkongo ghwa ntini, “Kuyandila lelo mbaka masiku ghoha ghapala kuhika mundu ywohele katalyegha ng'obhe mapambiko kuhuma kwa ghwenga” Ahundwa bhake bhakiyihwa paakighomba agha.<verse eid="MRK 11:14" /></para>
  <para style="s">Yesu kanguking'anyiha kitutubhi kya Chapanga</para>
  <para style="r">
    <ref loc="MAT 21:12-17">Matayu 21:12-17</ref>; <ref loc="LUK 19:45-48">Lukasi 19:45-48</ref>; <ref loc="JHN 2:13-22">Yohane 2:13-22</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Pakahikite ku Yelusalemu Yesu kakiyingila mu Kitutubhi kya Chapanga kakiyanda kubhabhinga bhinga bhala bhaabheghite mukuhemela na kuhemengana hilibhi munyumba kati ya Kitutubhi kya Chapanga. Kakihipalangula hindambi hya bhala bhaabheghite mukuhemengana ngalabha na hitebho hya bhanakuhemela ngunda. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Hangi kakintegheka ng'obhe mundu ywohele kutola kilibhi kyoheli kupitila lubhigho lwa Kitutubhi kya Chapanga. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Mbole kakibhahunda, “Yityekwa, ‘Kitutubhi kyangu kyaabhegha Kitutubhi kya kutundamila bhandu bha milima hyoha, peni mwenga mukitenda yibhe mbaku ya kuahiha apoka!’”<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Akulu bha mandundame na ahunda bha malaghilo pakayihwite mihalo ayi bhakiyanda kunpalahila luhila lwa kunkoma, peni bhakinnyoghopa, kiyaha bhandu bhohabhakikangacha kwa mahundo ghake. <verse eid="MRK 11:18" /><verse number="19" style="v" sid="MRK 11:19" />Payihikite makimuhi, Yesu na ahundwa bhake bhakibhuka mu kitami.<verse eid="MRK 11:19" /></para>
  <para style="s">Lihundo lya kya nkongo ghwa ntini</para>
  <para style="r">
    <ref loc="MAT 21:20-22">Matayu 21:20-22</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Malabhila ghake, paabheghite mukutyanga mu njila, bhakighubhona ghula ntini ghunyaluka kala kuhumila kunani mbaka pa kitepo. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Petili kakighuhwachila na kaking'ombela Yesu, “Nhunda, ghulole ghula ntini ghu ghukotolite ghunyaluka!”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Yesu kakiayanga, “Munhyubhalile Chapanga.” <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Kulyaghila ningubhaghombela mundu ywohele ywakalonda kukighombela kitumbi aki, ghutupuke ghukataghwe kulihibha, na kakotoo kubhona bhwaghalihi mumwoyo ghwake ngati kahyubhalile kukita ghatatendekwa, katatendeghwa nnando aghwo. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Ngati hino ningubhaghombela kyoheli kimukiyupa na kutundamila, nhyubhalile kukita maakingama nakyo kyabhegha kyenu. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Pammegha mukutundamila, munnekekehe mundu ywohele ywakabhatenditi uhokelo ghwoheli, ngati Tate ghwenu ywakabheghite kuluhingu kabhalekekehe ulemwa ghwenu. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Peni pamubhalekekeha ng'obhe bhangi, hata Tate ghwenu ywakabheghite kuluhingu katabhalekekeha ng'obhe ulemwa ghwenu.<verse eid="MRK 11:26" /></para>
  <para style="s">Ngonyekeho ya kya makakala gha Yesu</para>
  <para style="r">
    <ref loc="MAT 21:23-27">Matayu 21:23-27</ref>; <ref loc="LUK 2:1-8">Lukasi 2:1-8</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Yesu na ahundwa bhake bhakihika kangi ku Yelusalemu, pakabheghite mukutyanga ku Kitutubhi kya Chapanga, Akulu bha mandundame na ahunda bha malaghilo na aghohi bhakinng'endela, <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />Bhakinkonya, “Ghukitenda mihalo ayi kwa ngwiliho ya ghani? Na ywakakukamuhite makakala agha ndi ghani?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Yesu kakiayanga, “Ndabhakonya ngonyo yimo, na nenga nda bhakambuha kukita ndi kwa makakala gha ghani ningutenda mihalo ayi. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Mung'ombele, makakala gha Yohana yunakubatisa ghukihuma kuluhingo kwa Chapanga, ebu kwa anabhandu?”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Bhakighombana, pabhakighomba, “Handa patulongela, ghukihuma kuluhingu kwa Chapanga, katatukonya, mona mukighuhyubhalila ng'obhe? <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Peni patughomba, ‘ghukihuma kwa anabhandu.’” Bhakihyoghopa bhandu, mana bhandu bhoha bhakihyubhalila kukita Yohana kakibha ndo mbuye ghwa Chapanga. <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Ngati hino, bhakinnyanga Yesu, bhakighomba, kukita “Tungumanya ng'obhe.” Yesu kakibhayanga “Hata nenga ndabhaghombela ng'obhe kukita nungughatenda agha kwa gwiliho ya ghani.”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Ndambulo ya nngunda ghwa mizabibu na akandakanda</para>
  <para style="r">
    <ref loc="MAT 21:33-46">Matayu 21:33-46</ref>; <ref loc="LUK 20:9-19">Lukasi 20:9-19</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Yesu kakiyanda kughomba nabho kwa mandambulo, pakibhaghombela, “Mundu yumo kakikanda nng'unda ghwa misabibu, kakichenga lubhigho kughutindila ghula ng'unda, na kakitendekeha pa kukama sabibu, hilahila kakichenga kilingo na kakiapegha bhandu bhanpeghe sumu, ywombe kakibhuka kughenda kunnima ghungi.<figure style="fig" file="04 Winepress.jpg" size="col" ref="12:1">Bhandu abhili bhangukama sabibu pa kukamila difwai</figure> <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Mumanjubha gha mabeno kakinlaghila nndumitumi ghwake kwa bhala akulima bhake kakatole lusumulo lwake. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Bhala akandakanda bhakinkamula yula nndumitumi, bhakintuta na bhakinbhuyiha mabhoko gha yaghi kya nga kilibhi. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Kangi yula nkola nngunda kakinlaghila nndumitumi yungi kwa bhombe, bhala akandakanda bhakintuta mumutwe na kuntendela mihalo ya honi. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Kangi yula nkola nng'unda kakinlaghila nndumitumi yungi, aywo bhakinkoma. Kakialaghila andumitumi bhangi atangalo, bhala akandakanda bhakiatuta bhala andumitumi na amoo bhangi bhakiakoma. <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />Nkolang'unda kakihighala na mundu yumo ndundundu ghwa kunlaghiha, aywo ndo mwana ywakanpaliti. Muuhiko kakinlaghila pakaghomba, ‘Bhatanhokamila mwana ghwangu.’ <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />Peni bhala akandakanda bhakighombana, paakighomba, ‘Aywo ndo yunakuhala, nhiki tunkome, na lipala lyake lya bhegha lyetu.’ <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Ndo bhakinkamula, bhakinkoma na kuntagha panje ya ghula ng'unda ghwa misabibu.”<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />Yesu kakiakonya “Munguhwacha yula nkolang'unda katatenda niki? Katahika na kubhakoma bhala akandakanda, mbole katabhapegha akandakanda bhangi ghula ng'unda ghwa misabibu. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Mukisoma ng'obhe Matyeko agha,</para>
  <para style="q" vid="MRK 12:10">‘Liganga bhalilemite bhana utendehi ghwa kuchenga</para>
  <para style="q" vid="MRK 12:10">hinu libhegha liganga likulu lya pambwegha;<verse eid="MRK 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MRK 12:11" />Bambo kaghutenda nhalu aghu</para>
  <para style="q" vid="MRK 12:11">nayo ndo ngangahyo mumehu ghetu!’ ”<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Akulu bha mandundame, ahunda bha malaghilo na aghohi pabhamanyite kukita kakighomba ndambulo yila kwa kya bhombe bhakipala kunkamula, peni bhakiluyoghopa lula lumati lwa bhandu. Bhakinneka na bhakibhuka.<verse eid="MRK 12:12" /></para>
  <para style="s">Nhalo ghwa kukamuha kodi kwa Kaisari</para>
  <para style="r">
    <ref loc="MAT 22:15-22">Matayu 22:15-22</ref>; <ref loc="LUK 20:20-26">Lukasi 20:20-26</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Mbole, bhakialaghila Akaafalisayo na kimati kya Helode ngati bhanhikile Yesu bhantyeghe kwa mihalo yake. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Bhaking'endela Yesu bhakinng'ombela, “Nhunda, tungumanya kukita ghwenga ghu mundu ghwa kuyubhalilwa ghunakulongela hoto. Ghunguayoghopa ng'obhe ukulu ghwa bhene, peni ghwenga ghunguhunda hoto ya Chapanga telatela. Hinu yinguteghekwa kunpegha mutwa nkulu ghwa Akaaloma kodi ebu ng'obhe? Hinu tunpeghe ebu tukotoo kunpegha?”<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />Peni Yesu kakimanya ufyangu ghwa bhombe na kakiakonya, “Bhuli mukupala kuntyegha? Munyeghele ayo ngalabha niyilole.”<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />Bhakinnyeghela ngalabha na mwene kakiakonya, “Kibhungi aki na lihina lityekitwe ali lya ghani?” Bhene akinnyanga “Ndi lya Mutwa nkulu ghwa Akaaloma.”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Ndo Yesu kakiaghombela, “Munmpeghe Mutwa nkulu ghwa Akaaloma hya kya mwene na Chapanga hya kya Chapanga.” Na bhene bhakibhughanikwa muno naywo.<verse eid="MRK 12:17" /></para>
  <para style="s">Ngonyo ya kya uhyuko</para>
  <para style="r">
    <ref loc="MAT 22:23-33">Matayu 22:23-33</ref>; <ref loc="LUK 20:27-40">Lukasi 20:27-40</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Mbole, Akaasadukayu, bhala bhanakughomba kahone uhyuko bhakinhikila Yesu na bhakinkonya, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“Nhunda, Musa kakitutyekela kukita handa mundu pakahwegha na kunleka nndala kya nga mwana, ndo nlongo ghwake katantolela yula nndala nnekwa ngati kakanpapile nnongo ghwake bhana. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Ndo bhakibhegha alongo nhano na abhili. Yula ghwa ulongohi kakitolela nndala na kakihwegha kya nga mwana ywohele. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Ghwa ubhili kakinhala yula nnekwa peni naywo kakihwegha kya nga kunneka mwana ywoheli, yikibhegha ubhwabhu abhu kwa yula ghwa ndatu. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Ndo bhoha nhano na abhili muulongo ghula bhakighwegha kya nga kunneka mwana na muuhiko ghwa hyoha na yula nndala kakihwegha. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Ngati hino, palisiku lya bhandu kuhyuka, nndala yula katabhegha ghwa ghani kiyaha kakitolelwa na alongo bhoha nhano na abhili?”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Yesu kakiayanga, “Mwenga munguhokela kiyaha mungumanya ng'obhe Matyeko Mang'anyimo ebu ngwiliho ya Chapanga. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Bhaahweghite paalonda kuhyuka, kahone kutolela ebu kutolelwa kiyaha bhatabhegha handa mahoka bha Chapanga. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Na kwa mihalo ya kya uhyuko ghwa bha aghweghite, nde nsoma ng'obhe mu kitabho kya Musa akwo Chapanga pakalongilite na Musa kuhuma mukiputila kiyakiteghe mwoto pakaghomba, ‘Nenga ndo Chapanga ghwa Ibulahimu, na Chapanga ghwa Isaka na Chapanga ghwa Yakobu.’ <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Hinu, mwene ndo Chapanga ghwa aghweghite ng'obhe ngati ndo Chapanga ghwa bhanakukeka. Mwenga nhokela muno!”<verse eid="MRK 12:27" /></para>
  <para style="s">Laghilo Ngulu</para>
  <para style="r">
    <ref loc="MAT 22:34-40">Matayu 22:34-40</ref>; <ref loc="LUK 10:25-28">Lukasi 10:25-28</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Nhunda yumu ghwa malaghilo kakihika na kakiyihwa paaghombaniti. Kakibhona kukita Yesu kakiayanga tela bhala Akaasadukayo, naywo kakinkonya, “Mungwilikiho hyoha yibheghite ngulu ndo yoki?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Yesu kakinnyanga. “Nnyihwanile mwenga bhandu bha Isilaeli, ngwiliho ngulu ndo ayi, Bambo Chapanga ghwetu, ndo Bambo yumo. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Ghunpale Bambo Chapanga ghwako kwa mwoyo ghwako ghwoha na kwa nhuki ghwako ghwoha na kwa mahala ghako ghoha na kwa makakala ghako ghoha. <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Na ya kabhili ndi ayi, ghunpale nng'eghela ghwako handa mughulipala ghumwene, kahone ngwilikiho yingi ngulu kupitingana kwa ahi.”<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Yula nhunda ghwa malaghilo kaking'ombela Yesu, “Kulyaghila nhunda ghuyanga maha kukita Chapanga ndo yumu kahone yungi ngati nga ywombe. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Kunpala Chapanga kwa mwoyo ghwoha na kwa mahala ghoha na makakala ghoha na kunpala nng'eghela ghwako handa mughulipala ghumwene ndi tela kya na lumu kulandana ng'obhe na kuyambika nyambi ya kuyocholela na matulo.”<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />Naywo Yesu pakabhonite kukita kakiyanga kwa mahala, kaking'ombela, “Ghwenga ghubhegha kutali ng'obhe na Ghubhutwa ghwa Chapanga.” Kuyandila pala kahone mundu ywakayighite kunkonya Yesu nkonyo kangi.<verse eid="MRK 12:34" /></para>
  <para style="s">Kilisto ywakahaghulitwe na Chapanga ndo mwana ghwa ghani?</para>
  <para style="r">
    <ref loc="MAT 22:41-46">Matayu 22:41-46</ref>; <ref loc="LUK 20:41-44">Lukasi 20:41-44</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Yesu pakabheghite mukuhunda akwo ku Kitutubhi kya Chapanga kakikonya, “Yibha bhuli ahunda bha malaghilo angulongela kukita Kilisto ywakahaghulitwe na Chapanga ndo Mwana ghwa Daudi? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Mana Daudi mwene kakikambuka pakalonguhitwe na Nhuki ghwa Chapanga pakighomba.</para>
  <para style="q" vid="MRK 12:36">‘Bambo kaking'ombela Bambo ghwangu,</para>
  <para style="q" vid="MRK 12:36">ghutame mu kibhoko kyangu kya nnilo,</para>
  <para style="q" vid="MRK 12:36">mbaka panonda kubhabhika amyanja bhako pahi ya ngwiliho yako.’<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />Daudi mwene kangunkema Kilisto ywakahaghulitwe na Chapanga, ‘Bambo’ yabhegha bhuli hino ywombe kabhe mwana ghwake?”</para>
  <para style="s" vid="MRK 12:37">Yesu kanguandakila bhandu kya ahunda bha Malaghilo</para>
  <para style="r" vid="MRK 12:37">
    <ref loc="MAT 23:1-36">Matayu 23:1-36</ref>; <ref loc="LUK 20:45-47">Lukasi 20:45-47</ref></para>
  <para style="p" vid="MRK 12:37">Lula lumati lwoha lwa nbhandu bhakinnyihwa kwa uyelelo <verse eid="MRK 12:37" /><verse number="38" style="v" sid="MRK 12:38" />Yesu pakabheghiteghe mu kuahunda, kakilongela, “Mulindakile na ahunda bha malaghilo. Bhombe apalagha kutyanga paahwala mapinda matandamaho na kulamuhwa kwa kuhokamilwa mu hindandabhanji, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />na kutama muhitebho hya kuulongolo mu Kitutbhi kya kukonganila Akaayahudi na muhitebho hya ulongolo mu chekwa. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Anguapugha ahumbu alekwa kunu bhangulikupukiha kulandulila malandulo matandamaho lisiku lya uhiko kyabhabhona kimbamanda kikulu!”<verse eid="MRK 12:40" /></para>
  <para style="s">Litulo lya nndala nnekwa</para>
  <para style="r">
    <ref loc="LUK 21:1-4">Lukasi 21:1-4</ref></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Mbole Yesu kakitama ugheghela na kipalamande kya abhikiteghe matulo, kakilulolekeha lumati lwa bhandu pa abheghite mukubhika ngalabha mulijamanda lya kitutubhi kya Chapanga. Na bhana utopelo atangalo bhakiyingiha ngalabha nyoloho. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Peni nndala nlekwa yumo kapukwa, kakihika na kakibhika ngalabha ibhili njoko hya lihabha. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Yesu kakiakema ahundwa bhake kakiaghombela, “Kulyaghila nunguaghombela nndala nlekwa ayu kapukwa kabhika ngalabha nyoloho mulijamanda lya nyambi kupitingana kwa bhangi bhoha bhabhikiti. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Kiyaha bhangi bhoha bhakibhika uyonjokeho ghwa mota hyabhe, peni ayu nhumbu nlekwa mu ukapukwa ghwake kakitola hyoha hyakabheghite nahyo hata kila kyakakipalite nde kya kulama.”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Yesu kangulongela kya ngachangwo ya Kitutubhi kya Chapanga</para>
  <para style="r">
    <ref loc="MAT 24:1-2">Matayu 24:1-2</ref>; <ref loc="LUK 21:5-6">Lukasi 21:5-6</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Yesu pakabheghite mu kuhuma ku Kitutubhi kya Chapanga, yumoo ywa ahundwa bhake kakinng'ombela, “Nhunda, ghulole huti maganga agha mughabheghiti makulu na hitutubhi ahi muhinnyelembekite.”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />Yesu kakinnyanga, “Ghuhibhona hitutubhi ahi muhibheghite ngulu? Kahone hata liganga limo lya kulonda kuhighala unani mwa liganga lingi, ghoha ghatahangulighwa.”<verse eid="MRK 13:2" /></para>
  <para style="s">Kupungwa na himbamanda</para>
  <para style="r">
    <ref loc="MAT 24:3-14">Matayu 24:3-14</ref>; <ref loc="LUK 21:7-19">Lukasi 21:7-19</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Yesu pakatamite ku Kitumbi kya Mizeituni paakilola Kitutubhi kya Chapanga Petili na Yakobu na Yohana na Andelea bhakinkonya mu lupwepo, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“Chonde, ghutughombele mihalu ayi yabhegha pakiki, na naho yake yabhegha bhuli payiheghelela kubwitukila?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Yesu kakiaghombela, “Mulindakile, mundu ywoheli kakotoke kuakuluha. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Kiyaha atangalo bhaahika kukambuka kwa lihina lyangu, paalongela, ‘Nenga ndo Kilisto’ nabho bhataahokeha bhandu atangalo. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Pannyihwa kyobho ya mikoha paugheghela ebu mihalo ya mikoha kya kutali, nkotoo kubhegha na bhwagalili. Mihalu ayi mbaka yihumbuke peni uhiko ghwake ukali hela. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Mana bhandu bha nnima ghumo ghwatutana na bhandu bha nnima ghungi; na ghubhutwa ghwatutana na ghubhutwa ghungi. Kwabhegha na migwangwaliko mbande nhanganganiko lung'ahi lwa njala. Mihalu aywo yingulihwana na lihingila lya ulongohi.”<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />“Peni mwenga mulindakile, mana bhatabhakokela mu njengakaya, na kuatuta mu Hitutubhi ya kukonganila Akaayahudi; bhatabhayegha hilongohi na abhatwa kwa mihalo ya nenga ngati mubhaghombele Nhalo ghwa Maha. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Peni mbaka Mihalo ya Maha yilandamihwe huti kwa bhandu bha milima hyoha kukali na kuhika ghula uhiko. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Nabho paabhakamula na kubhakokela mu njengakaya, nkotoo kubhegha na bhwaghalili ya kya kulongela; Uhiko pauhika, nnongele kyohele kya kya mukamuhitwe ngati mwenga ng'obhe munpala kulongela ngati Nhuki ghwa Chapanga. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />Nnongo katankiluka nnongo ghwake ngati kakakomwe, na tate katankiluka mwana ghwake. Bhana bhataakiluka tate na ma ghwabhe na kuakoma. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Bhandu bhoha bhataakalalila mwenga kwa kya nenga. Peni yunakulimbilila kunhyubhalila mbaka kuuhiko katalopoka.”<verse eid="MRK 13:13" /></para>
  <para style="s">Lung'ahe lukulu</para>
  <para style="r">
    <ref loc="MAT 24:15-28">Matayu 24:15-28</ref>; <ref loc="LUK 21:20-24">Lukasi 21:20-24</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />“Pamulibhona ‘Kilibhi kinakunnyaghabhiha Chapanga’ kiyima pautamiho ghwake ng'obhe, yunakusoma kamanyeghe nhalo aghu, hino bhala bhaabheghite ku Yudea bhatughile ku hitumbi. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Ywakabheghite kulinyakaha ya kitutubhi kakotoho kuhuluka kuyingila munyumba kati mwaki kakatole kilibhi. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Naywo ywakabheghite kunng'unda kakotoo kubhuya ukaya kutola kyoheli. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Peni kibhabhone bhombe bhana ndumbo na bhanakuyongeha bhana masiku agho! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Nnyupe kwa Chapanga ngati mihalo ayi yikotoo kubwitukila pakipepo. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Mana mumasiku agho lutabhegha lung'ahe lukulu lwa nga kubhonekana, tangu ulongohi pala Chapanga pakabhumbite nnima mbaka lelo. Na kubhegha kangi ng'obhe mumasiku gha pala kuhika. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Handa Bambo kangahupitahiti ng'obhe masiku agho, Kahone kulopoka mundu ywohele. Peni kwa kya bhandu ahaghulwa, bhakabhahaghulite, kaghahupia masiku agho.”<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />“Hinu mundu ywohele pakaaghombela, ‘Nnole, Kilisto ywakahaghulitwe na Chapanga kabhegha apa!’ Ebu, ‘Kabhegha kula’ mangahyubhalila. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Mana bha bwitukila akina kilisto bhanga kuhaghulwa na Chapanga na mambuye bha uhwangi. Nabho bhatatenda naho na mihabho ngati bhabhahokehe ahaghulwa bha Chapanga. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Peni mwenga mulindakile, nenga niabhaghombela ghoha ghakali na kubwitukila.”<verse eid="MRK 13:23" /></para>
  <para style="s">Kuhika kwa Mwana ghwa Mundu</para>
  <para style="r">
    <ref loc="MAT 24:29-31">Matayu 24:29-31</ref>; <ref loc="LUK 21:25-28">Lukasi 21:25-28</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />“Peni mumasiku agho, mbole ya lung'ahe alwo, luchubha lwayingihwa lubhindo, na lubhalamwehi kabhone kumulika, <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />ndondwa hyaponeka kuhuma kunani na makakala gha kunani pamahundi ghatayukana. <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />Ndo bhandu bhatammona Mwana ghwa Mundu pakihika mumahundi kwa makakala mayoloho na ukulu. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Mbole katabhalaghiha mahoka bha Chapanga abhakwemukihe bhandu ahaghulwa bhake kuhuma mumbande hyoha ya nnima kuyandila kuuhiko ghwa nnima mbaka kuuhiko ghwa kunani.”<verse eid="MRK 13:27" /></para>
  <para style="s">Lihundo lya kya Ntini</para>
  <para style="r">
    <ref loc="MAT 24:32-35">Matayu 24:32-35</ref>; <ref loc="LUK 21:29-33">Lukasi 21:29-33</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />“Mughulole nkongo ghwa ntini na mulihunde ndambulo ayi; kamu pa mubhabhona mapanyo ghake paghatomola mahamba mmanye kukita pamabeno paheghela <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Ubhwabhu abhu, pamuyibhona mihalu ayi payitendeka, mmanye kukita Kilisto ywakahaghulitwe na Chapanga kabha ugheghela mwa nlyango! <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Kulyaghila nungubhaghombela, kibheleko aki kyapitingana ng'obhe mbaka mihalu ayi hyoha yibwituke. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Luhingu na nnima hyapitingana, peni malagho ghangu kahone kupita kata.”<verse eid="MRK 13:31" /></para>
  <para style="s">Kahone yunakumanya lisiku ebu lisaa</para>
  <para style="r">
    <ref loc="MAT 24:36-44">Matayu 24:36-44</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />“Peni kwa mihalo ya lisiku lila na lisaa kahone ywa kumanya, hata mahoka bha Chapanga, ebu Mwana, maha nga Tate ghweka chake ndo yunakumanya. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Mulindakile, mmeghe kala, kiyaha mmanya ng'obhe lisaa alyo lya hika pakiki. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Yabhegha handa mundu ywakabheghite mumwanja ywakabhalekiti andumitumi bhalulolekehe maha alwo lubhagha lwake kila mundu na lihengo lyake, naywo kakinkwilikiha lichonda ghwa ku nlyango ‘Ghukotoo kughonja.’ <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />Hinu mbheghe kala mana, mmanya ng'obhe mabhuyo gha nkola lubhagha, kukita makimuhi, ebu pakilu pa pakati, ebu pangeha ya kubhika njogolo, ebu malabhila pakuchegha. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Handa pakabhuya kwa kinunu kabhayitukite nng'onja. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Na ali linibhaghombela mwenga, nungubhaghombela bhoha, mmbheghe kala!”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Lukilu lwa kunkoma Yesu</para>
  <para style="r">
    <ref loc="MAT 26:1-5">Matayu 26:1-5</ref>; <ref loc="LUK 22:1-2">Lukasi 22:1-2</ref>; <ref loc="JHN 11:45-53">Yohane 11:45-53</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Yikibha masiku mabhili yikali na kuyingiha chekwa ya Pasaka na ya mangate ya nga kuyingihwa linjacha. Akaandundame akulu na ahunda bha malaghilo bhakipalaha njila ya kunkamula Yesu kwa njenjelo ngati bhankome. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Mana bhakighomba, “Tukotoo kunkamula lisiku lya chekwa ya Pasaka, kiyaha bhandu bhaatenda bhulwa.”<verse eid="MRK 14:2" /></para>
  <para style="s">Yesu kangunpopokehehwa mahuta ku Betania</para>
  <para style="r">
    <ref loc="MAT 26:6-13">Matayu 26:6-13</ref>; <ref loc="JHN 12:1-8">Yohane 12:1-8</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Yesu pakabheghite akwo ku Betania kulubhagha lwa Simoni ywakabheghite na maloha, pakabheghite mukindangabhala pakalyegha hilyo kakihika nndala yumo ywakabheghite na kyupa kya liganga lya alabasita kina mahuta ghanakunungila munu gha ngalabha ngulu, kakakimetula kila kyupa na kakinpopohela Yesu mumutwe ghwake <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Bhandu amoo bhangi bhaabheghite pala bhakighombana bhene kwa mabhene, “Kiyaha niki mahuta agha gha ngalabha ngulu ghangunyanyanganwa hela? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Mahuta agha ghangahemelitwe kwa ngalabha ngulu na ngalabha ahyo bhangabhapeghite kapukwa.” Bhakinlakalila munu yula nndala.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />Peni Yesu kakiaghombela, “Bhuli mungunng'aha? Munneke, kiyaha kanndendela nnando ghunakuhalala. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Makapukwa mmegha nabho masiku ghoha na mahotola kubhatanga masiku ghoheli ghamughapalite. Peni nenga kahone kubhegha papamu masiku ghoha. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Nndala ayu kandendela kila kakahotolite, kalongolela kuntyelemeka mahuta mmili ghwangu kyakummika kala kya kungulila. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Kulyaghila nenga nungubhaghombela pohele pala pannima payilandamihwa Nhalo ghwa Maha, nnando aghu ghwakatendite nndala ayu ghwakambukwa kwa uhwacho ghwake.”<verse eid="MRK 14:9" /></para>
  <para style="s">Yuda kanguyitikila kunkiluka Yesu</para>
  <para style="r">
    <ref loc="MAT 26:14-16">Matayu 26:14-16</ref>; <ref loc="LUK 22:3-6">Lukasi 22:3-6</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Ndo Yuda Isikaliyote yumoo ywa bhala ahundwa mbinda mabhoko yimo na abhili kakighenda kwa andundame akulu ngati kakankiluke Yesu. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Mandundame akulu pakayihwite nhalo aghwo bhakiyelelwa munu, bhakinnagha kunpegha ngalabha. Hinu Yuda kakiyanda kupalaha ling'ebu lya kunkiluka Yesu.<verse eid="MRK 14:11" /></para>
  <para style="s">Yesu kangulyegha hilyo ya Pasaka papamu na Ahundwa bhake</para>
  <para style="r">
    <ref loc="MAT 26:17-25">Matayu 26:17-25</ref>; <ref loc="LUK 22:7-14">Lukasi 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yohane 13:21-30</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Lisiku lya ulongohi lya chekwa ya mangate ya nga kuyingihwa linjacha, lisiku paanhinjite mwana mene ahundwa bhake bhakinkonya Yesu, “Ghungupala tughutendekehele kwoki pakulyegha Pasaka?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Hinu Yesu kakialaghila abhili muahundwa bhake, kakiaghombela, “Nng'ende kukitami, na akwo ma mmona nnume yumo yunakuyegha kibhigha kya machi ndo muntughile, <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />mbaka ku lubhagha lwakayingila munng'ombele yula nkola kaya pakayingiliti yula yuna kibhigha ‘Nhunda kangukonya, kyumba kati kyake kibhegha kwoki kya ahenja kyene kikapala kulyegha Pasaka papamu na ahundwa bhangu?’ <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Naywo katabhalaha chumba kati kikulu muligholofa lyake na maabhona hilibhi hyoha hibhegha kala kwa kya twenga.”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Bhala ahundwa bhakibhuka, bhakighenda kukitami, na bhakibhona hilibhi hyoha tela tela handa Yesu pakaaghombilite na bhakitendekeha hilyo hya Pasaka amwo.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Payihikite makimuhi, Yesu kakihika papamu na ahundwa bhake mbinda mabhoko yimo na abhili. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Paabheghite mukulyegha hilyo Yesu kakiaghombela, “Kulyaghila nungubhaghombela yumoo ywenu yunakulyegha papamu na nenga katangiluka.”<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Apa ahundwa bhake bhakiyanda kuhyononeka, bhakinkonya yumu mbole ya yumu “Ngati nenga ng'obhe?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />Yesu kakiayanga, “Ndi yumoo ywenu mwenga mbinda mabhoko yimo na abhili, yuna kuchwika lingate papamu na nenga mukipumbulu. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Kiyaha Mwana ghwa Mundu katakomwa handa yityekitwe. Peni kimmone Mundu yula ywakankiluka mwana ghwa Mundu mbaha mundu aywo kangalepelitwe kubhelekwa!”<verse eid="MRK 14:21" /></para>
  <para style="s">Mulyo ghwa Bambo</para>
  <para style="r">
    <ref loc="MAT 26:26-30">Matayu 26:26-30</ref>; <ref loc="LUK 22:14-20">Lukasi 22:14-20</ref>; <ref loc="1CO 11:23-25">1Akaakolinto 11:23-25</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Paabheghite mukulyegha Yesu kakitola lingate, kakilumba, kakilimetula na kuapegha ahundwa bhake pakighomba. “Mughutole nlyeghe aghu ndo mmili ghwangu.”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Mbole kakitola nteko ghwa difwai, Kakinnumba Chapanga na kakibhapegha bhoha bhakinyweghela nteko aghwo. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Kakiaghombela, “Aghu ndo mwahi ghwangu ghwa Ninganilo, ghuuchecheka kwa kya bhandu bha ayaloho. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Kulyaghila ningubhaghombela, nda nywegha kangi ng'obhe difwai ya lisabibu mbaka lisiku lila linonda kunywegha ya hyono mu Ghubhutwa ghwa Chapanga.”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Paayimbite kala nhambo, bhakibhuka bhakighenda kukitumbi kya Miseituni.<verse eid="MRK 14:26" /></para>
  <para style="s">Yesu kangulondola kukita Petili katankana</para>
  <para style="r">
    <ref loc="MAT 26:31-35">Matayu 26:31-35</ref>; <ref loc="LUK 22:31-34">Lukasi 22:31-34</ref>; <ref loc="JHN 13:36-38">Yohane 13:36-38</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Yesu kakibhaghombela ahundwa bhake, “Mabhoha mwenga mataneka, Mana matyeko ghaghomba, ‘Ndantuta yunakuhakila, na mene nabho bhatapwilinganika.’ <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />Peni mbole ya kuhyuka, ndabhalongolela kula ku Galilaya.”<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Petili kakighombela Yesu, “Hata handa bhoha bhataghuleka, nenga ndaghuleka ng'obhe.”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Yesu kakinng'ombela Petili, “Kulyaghila ningughughombela uhiku aghu ghwanganila pandatu, ukakali na kubhika njogholo pabhili.”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Peni Petili kakighendelela kughomba, “Hata payinoghela kuhwegha papamu na ghwenga, ndaghuleka ng'obhe.” Nabho ahundwa bhangi bhoha bhakighomba bhu bhwabhu abho.<verse eid="MRK 14:31" /></para>
  <para style="s">Yesu kanguyupa pakitogholo kya Getisamene</para>
  <para style="r">
    <ref loc="MAT 26:36-46">Matayu 26:36-46</ref>; <ref loc="LUK 22:39-46">Lukasi 22:39-46</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Bhakihika mukitogholo kya Getisemani, Yesu kakibhaghombela ahundwa bhake, “Ntame apa, nenga pang'enda kuyupa. <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Mbole kakibhatola Petili na Yakobu na Yohana. Naywo Yesu kakiyanda kuhyononeka na kughayaghaya.” <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Kakibhaghombela, “Mwoyo ghwangu ghubha na luhyononeko ugheghela na kuhwegha. Ntami apa na nkilukihe.”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Kakighenda ulongolo pamandina, kakighwegha pahi makukama, kakiyupa kukita, handa yahotoleka kuyingila lisaa alyo lya kimbamanda linhyetuke. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Kakilongela, “Tate ghwangu, kwa ghwenga mihalo hyoha yinguhotoleka. Ghumuhile nteko aghu peni yikotoke kubhegha kimbala nenga ngati kila ghukipalite ghwenga.”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Kakibhuya kwa ahundwa bhake bhala andatu kakibhabhona akighonja, kakinkonya Petili, “Simoni, ghukighonja? Ghulepelwa kukiluha hata lisaa limu? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Nkiluhe na kuyupa mangayingila mumayigho. Nhuki ghungupala peni mmili ghubhegha nnelebhu.”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Kakighenda kangi kuyupa pakighomba malagho ghaghalaghala. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Mbole kakibhuya kwa ahundwa bhake, kakibhabhona akighonja kangi kiyaha mehu ghabhe ghakitopelwa na ng'ono nabho bhakimanya ng'obhe kya kunng'ombela.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Kakibhabhuyila pandatu, na kakiakonya, “Nkali makaghonja na kupumulila? Hinu muyimuke, Lisaa lihika kala Mwana ghwa Mundu kangukamuhwa mumabhoko gha bhandu bhana ulemwa. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Nnyumuke tughende! Nnole, yula ywakunngiluka kaheghelela.”<verse eid="MRK 14:42" /></para>
  <para style="s">Yesu kangukamulwa</para>
  <para style="r">
    <ref loc="MAT 26:47-56">Matayu 26:47-56</ref>; <ref loc="LUK 22:47-53">Lukasi 22:47-53</ref>; <ref loc="JHN 18:3-12">Yohane 18:3-12</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Yesu pakabheghite akali mukughomba, Yuda, yumoo ywa bhala ahundwa mbinda mabhoko yimo na abhili, kakihika papamu na lumati lwa bhandu bhaabheghite na mikechelo na hinduku. Bhandu abho bhakilaghilwa na andundame akulu ahunda bha malaghilo na aghohi. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Yuda Isikaliyote nkiluka kakibhapegha naho bhala bhandu kukita, “Yula yunonda kunhyubhatila, ndo mwene, munkamule na munng'eghe kindakila.”<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />Hino Yuda pakahikite, kakinng'endela Yesu na kaking'ombela “Nhunda!” Mbole kakinhyubhatila. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Bhala bhandu bhakinkamula Yesu, na bhakinbhika kindakila. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Ndo yumoo ywa bhala bhaayimite apo papamu na Yesu kakihomola kikechelo kyake kakintuta ndumitumi ghwa Ndundame Nkulu na kakinkechula likutu. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Yesu kakiakonya, “Nhika na mikechelo na hinduku handa kukita nenga ndi npoka? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Masiku ghoha nikibhegha papamu na mwenga panibhahunda mu Kitutubhi kya Chapanga, kya nga kungamula. Peni hino Matyeko ghanakung'anyima mbaka ghakamale.”<verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />Ndo ahundwa bhake bhoha bhakinneka na kutukumbuka lubhilo.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Kakibha na nhongolo yumu ywakabheghite kanguntughila Yesu kakihwala nng'ololi nhuhu, nabho bhakiyigha kunkamula. <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />Peni mwene kakityelembuka kakighuleka ghula nnghololi kakitugha kyanga lipinda.<verse eid="MRK 14:52" /></para>
  <para style="s">Yesu kuulongolo ghwa bhandu bha Libalasa likulu</para>
  <para style="r">
    <ref loc="MAT 26:57-68">Matayu 26:57-68</ref>; <ref loc="LUK 22:54-55">Lukasi 22:54-55</ref>; <ref loc="LUK 22:63-71">22:63-71</ref>; <ref loc="JHN 18:13-14">Yohane 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Bhakinnyegha Yesu kwa Ndundame Nkulu nabho andundame akulu, aghohi na ahunda bha malaghilo bhakikongongana papamu. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Petili kakintughila Yesu kya kutalii, mbaka kulubhigho lwa Ndundame Nkulu. Akwo kakitama papamu na amachonda bha kupingikiha paakiyota mwoto. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />Mandundame akulu na bhandu bhoha bha libalasa likulu bhakipalaha uyimiho ghwa kunkokeha Yesu ngati ankome, peni bhakilepelwa. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Bhandu atangalo bhakighomba uyimiho ghwa uhwangi kwa kya Yesu, peni uyimiho ghwabhe ghukiponingana.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Ndo bhangi bhakiyima bhakilongela uyimiho ghwa uhwangi kwa kya ywombe pakilongela, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“Tukinnyihwa mundu ayu pakalongela, ‘Ndakihalulanga kitutubhi lya Chapanga ali liichengitwe na bhandu na mumasiku mandatu ndalichenga lingi lya nga kuchengwa kwa mabhoko gha anabhandu’” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Peni hata habhu unyimiho ghwabe ghukiponingana.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Ndundame Nkulu kakiyima nga paulongolo ghwabhe, kakinkonya Yesu, “Bhuli ghwenga ghuyanga ng'obhe? Ulemwa niki ghwaaghughombela?”<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />Peni ywombe kakinyamala jii na kakighomba ng'obhe hata lilagho limo. Ndundame Nkulu kakinkonya kangi, “Ghwenga ndo Kilisto, Mwana ghwa Chapanga Nkwiho?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Yesu kakiyanga. “Ena nenga ndo mwene, kangi matammona Mwana ghwa Mundu katama mukibhoko kya nnilo kya Chapanga yunamakakala, pakahika mumahundi gha kuluhingu.”<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Ndundame Nkulu kakilikachula lipinda lyake pakilongela; “Tughupalaha uyimiho ghwoki kangi? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Mwenga munyihwa pakanlighite Chapanga npimaki?” Bhoha bhakilamula kukita yinnoghela kakomwe.<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />Amoo bhangi bhakiyanda kunhunila mata, bhakinngubika mehu ghake na bhakintuta na kung'ombela “Ghulondole kukita ghani ywakakutulite!” Amachonda bhakintola na bhakintuta mambande.<verse eid="MRK 14:65" /></para>
  <para style="s">Petili kangunkana Yesu</para>
  <para style="r">
    <ref loc="MAT 26:69-75">Matayu 26:69-75</ref>; <ref loc="LUK 22:56-62">Lukasi 22:56-62</ref>; <ref loc="JHN 18:15-18">Yohane 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref></para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Petili pakabheghiteghe pahi kulubhigho, yumoo ywa akaandumitumi nndala ghwa Ndundame Nkulu kakihika. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Paka mmonite Petili pakayota mwoto, kakinnolekeha kaking'ombela, “Hata ghwenga ghukibha papamu na Yesu ghwa ku Nasaleti.”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Peni Petili kakimaka pakighomba, “Nummanya ng'obhe hangi ghughaghomba nigughamanya ng'obhe.” Mbole kakibhuka kakighenda pakuyingilila. Apa njogholo kakibhika.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />Yula nndumitumi nndala pakammonite kangi Petili, kakiaghombela bhala ayimite nabho, “Mundu ayu ndi yumoo ywabhe.” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Petili kakimaka kangi.</para>
  <para style="p" vid="MRK 14:70">Mbole pamandina bhandu bha ayimite apwo bhakinng'ombela Petili, “Kulyaghila ghwenga ndi yumoo ywabhe, mana ghwenga ndi Nngalilaya.”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Peni Petili kakiyanda kukotola na kulapa pakighomba, “Nenga nunmanya ng'obhe mundu aywo yumunnghomba mihalu yake.”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Apa njogholo kakibhika paabhili, Petili kakihwachila kya aghombite Yesu “Ikali na njogholo kubhika paubhili ghwa nnganila pandatu” Petili kakilila munu kakipopoheka mahohi.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Yesu kanguyeghwa kwa Pilato</para>
  <para style="r">
    <ref loc="MAT 27:1-2">Matayu 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Lukasi 23:1-5</ref>; <ref loc="JHN 18:28-38">Yohane 18:28-38</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Malabhila putiputi, akaandundame hilongohi, papamu na aghohi, na ahunda bha Malaghilo na aghohi bha Libalasa lyoha bhakipatana kala malobhe, bhakinmopa Yesu na kunnyegha na kunkamuha kwa Pilato. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Pilato kakinkonya, “Ghwenga ndo Mutwa ghwa Akaayahudi?”</para>
  <para style="p" vid="MRK 15:2">Yesu kakinnyanga, “Ena yibha handa ghughombite.”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Hilongohi bha Andundame bhakinkokela Yesu kwa mihalo miyoloho. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Pilato kakinkonya kangi, “Bhuli, ghubhegha na kya kuyanga ng'obhe? Ghulole nongwa nyoloho bhaghuyegheliti ya kya ghwenga.” <verse eid="MRK 15:4" /><verse number="5" style="v" sid="MRK 15:5" />Peni Yesu kakiyanga ng'obhe kyoheli, ndo Pilato kakikangacha.<verse eid="MRK 15:5" /></para>
  <para style="s">Pilato kanguntosa Yesu ngati kahweghe</para>
  <para style="r">
    <ref loc="MAT 27:15-26">Matayu 27:15-26</ref>; <ref loc="LUK 23:13-25">Lukasi 23:13-25</ref>; <ref loc="JHN 18:39-19:16">Yohane 18:39—19:16</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Yikibhegha hitohe yabhe pachekwa ya Pasaka Pilato kunmopolela ywakabheghite mu kibhopo ywohele ywene bhandu bhaanpalite. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Mumasiku agho kakibhegha mundu yumo ywaankemiteghe Balaba ywakabhopitwe papamu na akiluka bhangi, bhakiakoma bhandu mu bhulwa nkulu. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Lula lumati lwa bhandu lukihika kwa Pilato na lukipala kabhatendele handa muyibheghite hitohe hyaki. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />Pilato kakiakonya, “Mungupala nibhahughulile ayu Mutwa ghwa Akaayahudi?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Pilato kakilongela bhula kiyaha kakimanya kukita alongohi ghwa Andundame bhakinnyegha Yesu kwa mwene kwa luhila.<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />Peni hilongohi bha andundame bhakilukokeha lula lumati lwa bhandu bhannyupe Pilato kabhabhopolele Balaba mbole ya Yesu. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Pilato kakiakonya kangi, “Hinu mungupala nintendele niki ayu yumunkema Mutwa ghwa Akaayahudi?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Bhakituta kyobho kunu bhakighomba “Ghummangalile palupingika!”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Pilato kakiakonya, “Kiyaha niki? Katenda uhakata niki?”</para>
  <para style="p" vid="MRK 15:14">Peni bhene bhakituta kyobho kwa makakala makulu, pabhakighomba, “Ghummangalile!”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Pilato pakipala kulunogheha lula lumati lwa bhandu, kakibhahughulila Balaba, na mbole ya kuntegheka Yesu kututwa hinjupunjupu mbole kakinbhuha kabamandwe.<verse eid="MRK 15:15" /></para>
  <para style="s">Amachonda bhangunhwangila Yesu</para>
  <para style="r">
    <ref loc="MAT 27:27-31">Matayu 27:27-31</ref>; <ref loc="JHN 19:2-3">Yohane 19:2-3</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Amachonda bhakinyegha Yesu mbaka kuludamu lwa nyumbakati lwa kitutubhi kya nkulu ghwa nnima ghwa Yudea, akwo bhakikongana kimati kyoha kya machonda. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Bhakinhwaliha Yesu lipinda lya salabati na kilemba kya ghubhutwa kipyokolitwe kwa mihomi na bhakinhwika mumutwe. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Bhakiyanda kunnjambuha kwa uyuyuho, “Mwika, Mutwa ghwa Akaayahudi.” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Bhakintuta nhimbati ghwa nndenge kumutwe, bhakinhunila mata, bhakichutama mayughwa mukibhungi kyake na bhakinhokamila. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Paayomolite kuntendela lihwangila bhakinhula lila lipinda lya salabati na bhakinhwalia mapinda ghake. Mbole bhakinpiha panje bhakammangalile.<verse eid="MRK 15:20" /></para>
  <para style="s">Yesu kangumangalilwa mulupingika.</para>
  <para style="r">
    <ref loc="MAT 27:32-44">Matayu 27:32-44</ref>; <ref loc="LUK 23:26-43">Lukasi 23:26-43</ref>; <ref loc="JHN 19:17-27">Yohane 19:17-27</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Mundu yumo kuhuma ku Kilene, lihina lyake Simoni, tate ghwabhe Alekisanda na Lufo, kakibha mumwanja kuhuma panje ya kitami, amachonda bhakinkwilikiha kulughegha lula lupingika lwa Yesu. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Ndo bhakinng'egha Yesu mbaka ku Goligota mana yake, pa Huhu ya Mutwe. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Nabho bhakinpegha bhwengu ghuhanganganikite na ntela ghukemitwe manemane, peni kinywegha ng'obhe. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Ndo bhakimmangalila mulupingika, na bhakighabhana mapinda ghake mumabhwombe kwa kutenda uhaghulo ngati ghani kapati kyoki. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />Ndo yikibhegha malabhila ya saa ndatu paamangalite mulupingika. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Bhakityeka Matyeko gha nongwa yake, “Mutwa ghwa Akaayahudi.”<verse eid="MRK 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 15:27" />Papamu na ywombe bhakibhangalilwa apoka abhili, yumoo mumbande yake ya nnilo na yungi mumbande ya ngiya kila mundu mulupingika lwake. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />Na matyeko mang'anyimo ghakitengeleheka ghaghombite “Kakibhalangwa papamu na bhanauhokelo.”<verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />Bhandu bha apitite ugheghela na apwo bhakinokola mitwe yabhe kwa lihwangila na bhakinligha paakighomba “Aaah, ghwenga ghwakukikanjaghana Kitutubhi kya Chapanga na kukichenga mumasiku mandatu! <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />Hino ghulilopohe ghumwene, ghuhuluke mulipingika.”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Ubhwabhu abhu Hilongohi bha andundame papamu na ahunda bha malaghilo bhakintendela lihwangila mubhombe paakighomba, “Ywene kakialopoha bhandu bhangi, peni kahotola ng'obhe kulilopoha mwene! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Maka ayu, Kilisto ywakahaghulitwe na Chapanga, Mutwa ghwa Akaayahudi, kahuluke hinu kuhuma mulipingika, ngati tubhone na kuhyubhalila.”</para>
  <para style="p" vid="MRK 15:32">Bhala abhili bhaabhangalitwe papamu naywo nabho bhakinligha.<verse eid="MRK 15:32" /></para>
  <para style="s">Yesu kangughwegha palupingika.</para>
  <para style="r">
    <ref loc="MAT 27:45-56">Matayu 27:45-56</ref>; <ref loc="LUK 23:44-49">Lukasi 23:44-49</ref>; <ref loc="JHN 19:28-30">Yohane 19:28-30</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Paihikite saa nhano na yimu mbaka saa nhano na nchehe pamuhi kukibhegha na lubhindu lukulu lukighubika nnima ghoha. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Mulisaa lya nhano na ncheche makimuhi Yesu kakilila kwa lilobhe likulu pakilongela “Eloi, Eloi, lama sabakitani?” Mana hyaki, “Eeeh Chapanga, Chapanga ghwangu bhuli ghunguneka?”<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Bhandu amoo bhangi ayimite paugheghela paayihwite mihalo aywo bhakighomba, “Munnyihwe kangunkema Eliya.” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />Mundu yumo kakitugha lubhilo, kaghenda kutola libhoya na kuchwika mu difwai yichachandikite, kakilibhika mulidenge, kakinpegha kanyweghe pakighomba, “Hinu, munleke, ngati tubhone kukita Eliya katahika kunhuluha apwo palupingika.”<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Mbole Yesu kakilila kwa lilobhe likulu na kakighwegha.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Na lipasia likulu lya kitutubhi kya Chapanga lukibaluka mbande hibhili kuhumila unani mbaka pahi yake. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Hino yumoo ywa akulu bha amachonda ayimite apwo muulongolo ghwa lupingika ghwa Yesu, pakabhonine pakaghonjite ntumba, kakighomba, “Kulyaghila mundu ayu kakibhegha Mwana ghwa Chapanga!”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Hilahila akibhegha adala amoo bhangi kya kutali, na mubhene akibhegha, Malia mundu nndala ghwa ku Magidala, Malia ma ywabhe Yakobu nndokwa na Yosefu papamu na Salome. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Adala abha ndo bhantughilite Yesu na kuntangatila paabheghite ku Galilaya. Kangi bhakibhegha adala bhangi atangalo bhahikite papamu naywo ku Yelusalemu.<verse eid="MRK 15:41" /></para>
  <para style="s">Yesu kangubhikwa mu lindogholo</para>
  <para style="r">
    <ref loc="MAT 27:57-61">Matayu 27:57-61</ref>; <ref loc="LUK 23:50-56">Lukasi 23:50-56</ref>; <ref loc="JHN 19:38-42">Yohane 19:38-42</ref></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Payihikite makimuhi, kiyaha likibhegha lisiku lya Makunganiko, lisiku limo kukali na kuhika Lisiku lya Kupughwa. <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Yosefu ghwa Alimataya mundu ghwa kuhokamilwa mu njenga kaya ngulu ya Akaayahudi, naywo kakighupala muno Ghubhutwa ghwa Chapanga. Kaking'endela Pilato kya nga lyogha na kakighupala mmili ghwa Yesu. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Pilato kakikangacha pakayihwite kukita Yesu kahwegha kala. Ndo kakinkema yula kilongohi ghwa amachonda, na kakinkonya kukita handa Yesu kahwegha kala. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Pilato pakayihwite nhalo ghwa kuhwegha kwa Yesu kuhuma kwa nkulu ghwa machonda, Pilato kakintegheka Yosefu kakaghutole ntumba aghwo. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Apo Yosefu kakihemela sanda, kakighuhuluha mmili ghwa Yesu kuhuma mulupingika, mbole kakighunyengeleha sanda na kakimmika mulindogholo lihongolitwe mulitalabha na kakilibhilingiha liganga na kulitata lindogholo alyo. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Malia mundu nndala ghwa ku Magidala na Malia ma ghwake Yosefu bhakipabhona apwo pakaghonjihitwe.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Kuhyuka kwa Yesu</para>
  <para style="r">
    <ref loc="MAT 28:1-8">Matayu 28:1-8</ref>; <ref loc="LUK 24:1-12">Lukasi 24:1-12</ref>; <ref loc="JHN 20:1-10">Yohane 20:1-10</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Paliyomokite linjubha lya kupumulila, Malia nndala ghwa ku Magidala, Malia mama ghwake Yakobu na Salome bhakihemela hilibhi hya kunungilila ngati bhakampakale mmili ghwa Yesu. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Malabhila puti puti, lisiku lya ulongohi lya juma ndo Jumapili, kamu palubalikiti luchubha bhakighenda kulindogholo. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Munjila bhakikonyana, “Ghani ghwa kutubhilingihila lila liganga panlyango ghwa lindogholo?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Peni paalolekihite, bhakilibhona lila liganga likulu munu, likibhilingihwa kala kuhuma panlyango ghwa lindogholo. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Paabheghite mukuyingila mula mulindogholo, Bhakimmona nhongolo yumo ywakahwalite lighwanda lihuhu na kakitama mu mbande ya nnilo, nabho bhakibhughanikwa muno.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />Naywo kakiaghombela, “Nkoto kubhughanika. Mungunpalaha Yesu, ghwa Nasaleti ywakabhangalilitwe mulipingika. Kahyuka, Kabhegha ng'obhe apa, nnole apa paanng'onjihite. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Hino nng'ende mukabhaghombele ahundwa bhake papamu na Petili, kukita, ‘Kabhalongolela kughenda ku Galilaya, akwo ndi bhatammona handa pakabhaghombilite.’ ”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Ndo bhakibhuka na bhakitugha lubhilo kuhuma mula mulindogholo bhakibha na bhwaghalihi nkulu na nkangacho, nabho bhaking'ombela ng'obhe mundu ywohele lilagho lyoheli kiyaha bhakiyoghopa munu.<verse eid="MRK 16:8" /></para>
  <para style="s">Yesu kangunbwitukila Malia mundu nndala ghwa Magidala</para>
  <para style="r">
    <ref loc="MAT 28:9-10">Matayu 28:9-10</ref>; <ref loc="JHN 20:11-18">Yohane 20:11-18</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />Yesu pakahyukiti ngeha puti puti lisiku lya ulongohi lya juma, kakimbwitukila huti Malia mundu nndala ghwa Magidala, ywakabhuhitwe mandilu nhano na abhili na Yesu. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Malia kakighenda kubhaghombela bhala bhaabhegite mu kulongohana na Yesu, abho akibhegha akali bhangukukulika na kulila; <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />peni paayihwite kukita Yesu kakali kangukeka na kukita Malia kakimmona, bhakinhyubhalila ng'obhe.<verse eid="MRK 16:11" /></para>
  <para style="s">Yesu kanguabhwitukila ahundwa abhili</para>
  <para style="r">
    <ref loc="LUK 24:13-35">Lukasi 24:13-35</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Mbole Yesu kakiabwitukila abhili muahundwa bhake paabheghite mukughenda panje ya kitami na kakibhegha mu kibhungi kingi. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Nabho bhakibhuya na kubhaghombela ayabhe. Peni nabho bhakihyubhalila ng'obhe.<verse eid="MRK 16:13" /></para>
  <para style="s">Yesu kanguabwitukila ahundwa mbinda mabhoko yimo na yumo</para>
  <para style="r">
    <ref loc="MAT 28:16-20">Matayu 28:16-20</ref>; <ref loc="LUK 24:36-49">Lukasi 24:36-49</ref>; <ref loc="JHN 20:19-23">Yohane 20:19-23</ref>; <ref loc="ACT 1:6-8">Mandendelo 1:6-8</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Mbole Yesu kakiabwitukia bhala ahundwa bhake mbinda maboko yimo na yumo, paabheghite mukulyegha hilyo. Kakiandakila kwa ghwagahyubhalila ghwabhe na unonopo ghwa myoyo yabhe, Kiyaha bhakibhahyubhalila ng'obhe bhala bhammonite mbole ya kuhyuka. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Kakiaghombela, “Nng'ende kumilima hyoha, mukalandamihe Nhalo ghwa Maha kwa bhandu bhoha. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Ywohele ywakahyubhalila na kubatiswa katalopoka. Peni ywohele ywa nga kuhyubhalila katatoswa. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Nayo mihabho ayi yabhegha papamu na bhala bhanakuyubhalila. Kwa lihina lyangu bhabhuha mandilu, na bhayobhela kwa nongelo ya hyono, <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />handa paakamula mayoka, ebu paanywegha lusungu lwoheli, bhaatebhaha ng'obhe, bhatayabhika mabhoko ghabhe kwa atamwa nabho bhatalama.”<verse eid="MRK 16:18" /></para>
  <para style="s">Yesu kangutolwa kuluhingu kwa Chapanga</para>
  <para style="r">
    <ref loc="LUK 24:50-53">Lukasi 24:50-53</ref>; <ref loc="ACT 1:9-11">Mandendelo 1:9-11</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Mbole ya kughomba agha Bambo Yesu, kakitolwa kunani kuluhingu na kakitama mumbande ya nnilo ghwa Chapanga. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Ndo ahundwa bhake bhakibhuka, bhakilandamiha kwoha, naywo Bambo kakitenda lihengo papamu nabho na kutengelekeha nhalo ghwake kwa mihabho yilongohanite nabho.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>