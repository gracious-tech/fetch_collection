<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOB" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">אִיובֿ</para>
  <para style="toc2">אִיובֿ</para>
  <para style="toc1">אִיובֿ</para>
  <para style="mt1">אִיובֿ</para>
  <chapter number="1" style="c" pubnumber="א" sid="JOB 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 1:1" />עס איז געװען אַ מאַן אין לאַנד עוץ װאָס זײַן נאָמען איז געװען אִיובֿ; און דער דאָזיקער מאַן איז געװען ערלעך און רעכטפֿאַרטיק, און אַ ירא אלֹקים, און אָפּגעקערט פֿון שלעכטס. <verse eid="JOB 1:1" /><verse number="2" style="v" sid="JOB 1:2" />און עס זײַנען געבאָרן געװאָרן בײַ אים זיבן זין און דרײַ טעכטער. <verse eid="JOB 1:2" /><verse number="3" style="v" sid="JOB 1:3" />און זײַן אײגנס איז געװען זיבן טױזנט שאָף, און דרײַ טױזנט קעמלען, און פֿינף הונדערט געשפּאַן רינדער, און פֿינף הונדערט אײזעלינס, און זײער אַ סך קנעכט; און דער דאָזיקער מאַן איז געװען גרעסער פֿון אַלע קינדער פֿון מזרח.<verse eid="JOB 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOB 1:4" />און זײַנע זין פֿלעגן גײן און מאַכן אַ מאָלצײַט בײַ איטלעכן אין הױז אין זײַן טאָג, און זײ פֿלעגן שיקן און רופֿן זײערע דרײַ שװעסטער, צו עסן און צו טרינקען מיט זײ. <verse eid="JOB 1:4" /><verse number="5" style="v" sid="JOB 1:5" />און עס איז געװען, אַז װי די טעג פֿון דעם מאָלצײַט האָבן זיך אַרומגעדרײט, אַזױ האָט אִיובֿ געשיקט און האָט זײ געהײליקט, און ער פֿלעגט זיך פֿעדערן אין דער פֿרי, און אױפֿברענגען בראַנדאָפּפֿער לױט דער צאָל פֿון זײ אַלעמען, װאָרעם אִיובֿ האָט געזאָגט: אפֿשר האָבן מײַנע קינדער געזינדיקט, און זײ האָבן געלעסטערט אלֹקים אין זײער האַרצן. אַזױ פֿלעגט אִיובֿ טאָן אַלע מאָל.<verse eid="JOB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 1:6" />און עס איז געװען דער טאָג, װען די זין פֿון אלֹקים זײַנען געקומען זיך שטעלן פֿאַר ה׳, און אױך דער שׂטן איז געקומען צװישן זײ. <verse eid="JOB 1:6" /><verse number="7" style="v" sid="JOB 1:7" />האָט ה׳ געזאָגט צום שׂטן: פֿון װאַנען קומסטו? האָט דער שׂטן געענטפֿערט ה׳, און האָט געזאָגט: פֿון װאַנדערן איבער דער ערד און פֿון אַרומגײן אױף איר. <verse eid="JOB 1:7" /><verse number="8" style="v" sid="JOB 1:8" />האָט ה׳ געזאָגט צום שׂטן: האָסטו אַכט געטאָן אױף מײַן קנעכט אִיובֿן, אַז עס איז נישטאָ אַזאַ װי ער אױף דער ערד, אַ מאַן ערלעך און רעכטפֿאַרטיק, ירא אלֹקים און אָפּגעקערט פֿון שלעכטס? <verse eid="JOB 1:8" /><verse number="9" style="v" sid="JOB 1:9" />האָט דער שׂטן געענטפֿערט ה׳, און האָט געזאָגט: איז דען אומזיסט אִיובֿ אַ ירא אלֹקים? <verse eid="JOB 1:9" /><verse number="10" style="v" sid="JOB 1:10" />האָסטו נישט אַרומגעצאַמט אים און זײַן הױזגעזינט און אַלץ װאָס איז זײַנס רונד אַרום? די אַרבעט פֿון זײַנע הענט האָסטו געבענטשט, און זײַן אײגנס איז פֿאַרשפּרײט איבערן לאַנד. <verse eid="JOB 1:10" /><verse number="11" style="v" sid="JOB 1:11" />אָבער שטרעק אַקאָרשט אױס דײַן האַנט, און ריר אָן עפּעס װאָס איז זײַנס, אױב ער װעט נישט אין דײַן פּנים דיך לעסטערן. <verse eid="JOB 1:11" /><verse number="12" style="v" sid="JOB 1:12" />האָט ה׳ געזאָגט צום שׂטן: אָט איז אַלץ װאָס איז זײַנס אין דײַן האַנט, נאָר אױף אים זאָלסטו נישט אױסשטרעקן דײַן האַנט.</para>
  <para style="p" vid="JOB 1:12">איז דער שׂטן אַרױסגעגאַנגען פֿון פֿאַר ה׳.<verse eid="JOB 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOB 1:13" />און עס איז געװען אײן טאָג, װי זײַנע זין און זײַנע טעכטער עסן און טרינקען װײַן אין הױז פֿון זײער עלטסטן ברודער, <verse eid="JOB 1:13" /><verse number="14" style="v" sid="JOB 1:14" />אַזױ איז אַ שליח געקומען צו אִיובֿן, און האָט געזאָגט: די רינדער האָבן געאַקערט, און די אײזעלינס האָבן זיך געפֿיטערט לעבן זײ, <verse eid="JOB 1:14" /><verse number="15" style="v" sid="JOB 1:15" />זײַנען באַפֿאַלן שבֿאָער, און האָבן זײ צוגענומען, און די יונגען האָבן זײ דערשלאָגן מיטן שאַרף פֿון שװערד און נאָר איך אַלײן בין אַנטרונען געװאָרן דיר אָנצוזאָגן. <verse eid="JOB 1:15" /><verse number="16" style="v" sid="JOB 1:16" />װי דער רעדט נאָך, אַזױ איז אָנגעקומען אַן אַנדערער, און האָט געזאָגט: אַ פֿײַער פֿון אלֹקים איז אַראָפּגעפֿאַלן פֿון הימל, און האָט אָנגעצונדן די שאָף און די יונגען, און האָט זײ פֿאַרצערט, און נאָר איך אַלײן בין אַנטרונען געװאָרן דיר אָנצוזאָגן. <verse eid="JOB 1:16" /><verse number="17" style="v" sid="JOB 1:17" />װי דער רעדט נאָך, אַזױ איז אָנגעקומען אַן אַנדערער, און האָט געזאָגט: כַּשׂדים האָבן געמאַכט דרײַ מחנות, און זײַנען אָנגעפֿאַלן אױף די קעמלען, און האָבן זײ צוגענומען, און די יונגען האָבן זײ דערשלאָגן מיטן שאַרף פֿון שװערד, און נאָר איך אַלײן בין אַנטרונען געװאָרן דיר אָנצוזאָגן. <verse eid="JOB 1:17" /><verse number="18" style="v" sid="JOB 1:18" />װי דער רעדט נאָך, אַזױ איז אָנגעקומען אַן אַנדערער, און האָט געזאָגט: דײַנע זין און דײַנע טעכטער האָבן געגעסן און געטרונקען װײַן אין הױז פֿון זײער עלטסטן ברודער, <verse eid="JOB 1:18" /><verse number="19" style="v" sid="JOB 1:19" />ערשט אַ גרױסער װינט איז אָנגעקומען פֿון דער זײַט פֿון מדבר, און האָט אָנגעכאַפּט די פֿיר װינקלען פֿון הױז, און עס איז אײַנגעפֿאַלן אױף די יונגעלײַט, און זײ זײַנען געשטאָרבן, און נאָר איך אַלײן בין אַנטרונען געװאָרן דיר אָנצוזאָגן.<verse eid="JOB 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOB 1:20" />איז אִיובֿ אױפֿגעשטאַנען, און האָט צעריסן זײַן מאַנטל, און האָט אָפּגעשאָרן זײַן קאָפּ, און איז געפֿאַלן אױף דער ערד, און האָט זיך געבוקט. <verse eid="JOB 1:20" /><verse number="21" style="v" sid="JOB 1:21" />און ער האָט געזאָגט: נאַקעט בין איך אַרױסגעגאַנגען פֿון מײַן מוטערס לײַב, און נאַקעט װעל איך זיך אומקערן אַהין; ה׳ האָט געגעבן, און ה׳ האָט צוגענומען, געלױבט זאָל זײַן דער נאָמען פֿון ה׳.<verse eid="JOB 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOB 1:22" />בײַ אַלעם דעם האָט אִיובֿ נישט געזינדיקט, און נישט געגעבן קײן לעסטערונג צו אלֹקים.<verse eid="JOB 1:22" /></para>
  <chapter eid="JOB 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="JOB 2" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 2:1" />און עס איז געװען דער טאָג װען די זין פֿון אלֹקים זײַנען געקומען זיך שטעלן פֿאַר ה׳, און אױך דער שׂטן איז געקומען צװישן זײ, זיך צו שטעלן פֿאַר ה׳. <verse eid="JOB 2:1" /><verse number="2" style="v" sid="JOB 2:2" />האָט ה׳ געזאָגט צום שׂטן: פֿון װאַנען קומסטו? האָט דער שׂטן געענטפֿערט ה׳, און האָט געזאָגט: פֿון װאַנדערן איבער דער ערד און פֿון אַרומגײן אױף איר. <verse eid="JOB 2:2" /><verse number="3" style="v" sid="JOB 2:3" />האָט ה׳ געזאָגט צום שׂטן: האָסטו אַכט געטאָן אױף מײַן קנעכט אִיובֿן, אַז עס איז נישטאָ אַזאַ װי ער אױף דער ערד, אַ מאַן ערלעך און רעכטפֿאַרטיק, ירא אלֹקים, און אָפּגעקערט פֿון שלעכטס? און ער האַלט זיך נאָך אַלץ בײַ זײַן פֿרומקײט; און דו האָסט מיך אָנגערעדט אױף אים, אים אומצוברענגען אומזיסט. <verse eid="JOB 2:3" /><verse number="4" style="v" sid="JOB 2:4" />האָט דער שׂטן געענטפֿערט ה׳, און האָט געזאָגט: הױט פֿאַר הױט, און אַלץ װאָס אַ מענטש האָט, װעט ער אַװעקגעבן פֿאַר זײַן נפֿש. <verse eid="JOB 2:4" /><verse number="5" style="v" sid="JOB 2:5" />אָבער שטרעק אַקאָרשט אױס דײַן האַנט, און ריר אָן זײַן בײן און זײַן פֿלײש, אױב ער װעט נישט אין דײַן פּנים דיך לעסטערן. <verse eid="JOB 2:5" /><verse number="6" style="v" sid="JOB 2:6" />האָט ה׳ געזאָגט צום שׂטן: אָט איז ער אין דײַן האַנט, נאָר זײַן נפֿש היט.<verse eid="JOB 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOB 2:7" />איז דער שׂטן אַרױסגעגאַנגען פֿון פֿאַר ה׳, און ער האָט געפּלאָגט אִיובֿן מיט אַ בײזן אױסשלאָג פֿון זײַן פֿוסטריט ביז זײַן שאַרבן. <verse eid="JOB 2:7" /><verse number="8" style="v" sid="JOB 2:8" />האָט ער זיך גענומען אַ שערבל זיך צו קראַצן דערמיט; און ער איז געזעסן אין אַש. <verse eid="JOB 2:8" /><verse number="9" style="v" sid="JOB 2:9" />האָט זײַן װײַב צו אים געזאָגט: האַלטסט זיך נאָך אַלץ בײַ דײַן פֿרומקײט? לעסטער אלֹקים, און שטאַרב. <verse eid="JOB 2:9" /><verse number="10" style="v" sid="JOB 2:10" />האָט ער צו איר געזאָגט: אַזױ װי עס רעדט אײנע פֿון די נידערטרעכטיקע רעדסטו. זאָלן מיר דאָס גוטע יאָ אָננעמען פֿון אלֹקים, און דאָס שלעכטע זאָלן מיר נישט אָננעמען? בײַ אַלעם דעם האָט אִיובֿ נישט געזינדיקט מיט זײַנע ליפּן.<verse eid="JOB 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JOB 2:11" />און אִיובֿס דרײַ גוטע פֿרײַנט האָבן געהערט פֿון אַל דעם דאָזיקן בײז װאָס איז געקומען אױף אים, און זײ זײַנען געקומען איטלעכער פֿון זײַן אָרט, אֶליפַֿז דער תֵּימָני, און בִלדַד דער שוחי, און צופֿר דער נַעַמָתי; און זײ האָבן אָפּגערעדט אין אײנעם צו גײן אים באַדױערן און אים טרײסטן. <verse eid="JOB 2:11" /><verse number="12" style="v" sid="JOB 2:12" />און אַז זײ האָבן אױפֿגעהױבן זײערע אױגן פֿון דער װײַטן, האָבן זײ אים נישט דערקענט, און זײ האָבן אױפֿגעהױבן זײער קֹול און האָבן געװײנט; און זײ האָבן איטלעכער צעריסן זײַן מאַנטל, און געװאָרפֿן שטױב איבער זײערע קעפּ צום הימל. <verse eid="JOB 2:12" /><verse number="13" style="v" sid="JOB 2:13" />און זײ זײַנען געזעסן מיט אים אױף דער ערד זיבן טעג און זיבן נעכט, און קײנער האָט נישט גערעדט צו אים אַ װאָרט, װאָרעם זײ האָבן געזען אַז דער װײטאָג איז זײער גרױס.<verse eid="JOB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" altnumber="1" sid="JOB 2:14" /> <char style="vp">3.1</char> דערנאָך האָט אִיובֿ געעפֿנט זײַן מױל, און האָט געשאָלטן זײַן טאָג.<verse eid="JOB 2:14" /></para>
  <chapter eid="JOB 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="JOB 3" />
  <para style="p">
    <verse number="1" style="v" altnumber="2" sid="JOB 3:1" /> <char style="vp">3.2</char> און אִיובֿ האָט זיך אָפּגערופֿן, און האָט געזאָגט:<verse eid="JOB 3:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" altnumber="3" sid="JOB 3:2" /> אונטערגײן זאָל דער טאָג</para>
  <para style="q" vid="JOB 3:2">װאָס איך בין אין אים געבאָרן געװאָרן,</para>
  <para style="q" vid="JOB 3:2">און די נאַכט װאָס האָט אָנגעזאָגט:</para>
  <para style="q" vid="JOB 3:2">אַ זָכָר איז אַנטפֿאַנגען געװאָרן.<verse eid="JOB 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="4" sid="JOB 3:3" /> יענער טאָג זאָל זײַן חושך,</para>
  <para style="q" vid="JOB 3:3">נישט פֿרעגן זאָל אױף אים אֱלוֹהַּ פֿון אױבן,</para>
  <para style="q" vid="JOB 3:3">און נישט שײַנען זאָל אױף אים אַ ליכטיקײט.<verse eid="JOB 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="5" sid="JOB 3:4" /> צונעמען פֿאַר זיך זאָלן אים חושך און טױטשאָטן,</para>
  <para style="q" vid="JOB 3:4">אַ װאָלקעניש זאָל רוען אױף אים,</para>
  <para style="q" vid="JOB 3:4">כמאַרעס פֿון טאָג זאָלן אים שרעקן.<verse eid="JOB 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="6" sid="JOB 3:5" /> יענע נאַכט, אַ שטאָקפֿינצטערניש זאָל זי נעמען,</para>
  <para style="q" vid="JOB 3:5">זי זאָל זיך נישט פֿרײען אין די טעג פֿון יאָר,</para>
  <para style="q" vid="JOB 3:5">אין דער צאָל פֿון חדשים זאָל זי נישט אַרײַנגײן.<verse eid="JOB 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="7" sid="JOB 3:6" /> אָט יענע נאַכט זאָל זײַן װיסט,</para>
  <para style="q" vid="JOB 3:6">נישט קומען אין איר זאָל אַ געזאַנג.<verse eid="JOB 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="8" sid="JOB 3:7" /> פֿלוכן זאָלן זי די װאָס שילטן דעם טאָג,</para>
  <para style="q" vid="JOB 3:7">די װאָס זײַנען גרײט דעם לִויָתן אױפֿצוּװעקן.<verse eid="JOB 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="9" sid="JOB 3:8" /> פֿינצטער זאָלן װערן אירע אָװנטשטערן,</para>
  <para style="q" vid="JOB 3:8">זי זאָל האָפֿן אױף ליכט, און נישטאָ,</para>
  <para style="q" vid="JOB 3:8">און נישט אָנזען די ברעמען פֿון פֿרימאָרגן.<verse eid="JOB 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="10" sid="JOB 3:9" /> װײַל זי האָט נישט פֿאַרשלאָסן די טירן פֿון מײַן מוטערלײַב,</para>
  <para style="q" vid="JOB 3:9">און פֿאַרבאָרגן מאַטערניש פֿון מײַנע אױגן.<verse eid="JOB 3:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="11" sid="JOB 3:10" /> פֿאַר װאָס בין איך נישט פֿון טראַכט געשטאָרבן?</para>
  <para style="q" vid="JOB 3:10">אַרױס פֿון לײַב און פֿאַרגאַנגען?<verse eid="JOB 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="12" sid="JOB 3:11" /> אַלמַאי האָבן מיך קני צוגענומען?</para>
  <para style="q" vid="JOB 3:11">און נאָך װאָס בריסט, איך זאָל זײגן?<verse eid="JOB 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="13" sid="JOB 3:12" /> װאָרעם איך װאָלט אַצונד געלעגן און געװען שטיל,</para>
  <para style="q" vid="JOB 3:12">איך װאָלט געשלאָפֿן, איך װאָלט רו געהאַט דענצמאָל;<verse eid="JOB 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="14" sid="JOB 3:13" /> מיט מלכים און יוֹעצים פֿון דער ערד,</para>
  <para style="q" vid="JOB 3:13">װאָס פֿאַרבױען װיסטענישן פֿאַר זיך;<verse eid="JOB 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="15" sid="JOB 3:14" /> אָדער מיט שׂרָרות װאָס האָבן גאָלד,</para>
  <para style="q" vid="JOB 3:14">װאָס פֿילן זײערע הײַזער מיט זילבער.<verse eid="JOB 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="16" sid="JOB 3:15" /> אָדער איך װאָלט גאָרנישט געװען, װי אַ באַהאַלטענער מפּיל,</para>
  <para style="q" vid="JOB 3:15">װי קינדער װאָס האָבן דעם שײַן נישט געזען.<verse eid="JOB 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="17" sid="JOB 3:16" /> דאָרט הערן אױף די רשעים צו רודערן,</para>
  <para style="q" vid="JOB 3:16">און דאָרט רוען די מידע אָן כּוֹח.<verse eid="JOB 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="18" sid="JOB 3:17" /> אין אײנעם באַרוט זײַנען די געפֿאַנגענע,</para>
  <para style="q" vid="JOB 3:17">זײ הערן נישט דעם קֹול פֿון אַ דריקער.<verse eid="JOB 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="19" sid="JOB 3:18" /> קלײן און גרױס איז דאָרטן,</para>
  <para style="q" vid="JOB 3:18">און דער קנעכט איז פֿרײַ פֿון זײַן האַר.<verse eid="JOB 3:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" altnumber="20" sid="JOB 3:19" /> פֿאַר װאָס גיט ער ליכט דעם װאָס מאַטערט זיך,</para>
  <para style="q" vid="JOB 3:19">און לעבן די פֿאַרביטערטע אין געמיט?<verse eid="JOB 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" altnumber="21" sid="JOB 3:20" /> די װאָס האַרן אױפֿן טױט, און ער קומט נישט,</para>
  <para style="q" vid="JOB 3:20">און זײ אַקערן נאָך אים מער װי נאָך אוֹצרות;<verse eid="JOB 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="22" sid="JOB 3:21" /> די װאָס װאָלטן זיך פֿרײען מיט שׂימחה,</para>
  <para style="q" vid="JOB 3:21">װאָס װאָלטן קװעלן, אַז זײ װאָלטן געפֿינען דעם קבֿר;<verse eid="JOB 3:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="23" sid="JOB 3:22" /> צו דעם מאַן װאָס זײַן װעג איז פֿאַרבאָרגן,</para>
  <para style="q" vid="JOB 3:22">און אֱלוֹהַּ האָט פֿאַרצאַמט פֿאַר אים?<verse eid="JOB 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="24" sid="JOB 3:23" /> װאָרעם גלײַך װי מײַן ברױט קומט מײַן זיפֿצן,</para>
  <para style="q" vid="JOB 3:23">און אַזױ װי װאַסער גיסן זיך מײַנע געשרײען.<verse eid="JOB 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" altnumber="25" sid="JOB 3:24" /> װאָרעם די אַנגסט װאָס איך האָב געאַנגסט איז מיר אָנגעקומען,</para>
  <para style="q" vid="JOB 3:24">און װאָס איך האָב געפֿאָרכט איז מיר געשען.<verse eid="JOB 3:24" /></para>
  <para style="q">
    <verse number="25" style="v" altnumber="26" sid="JOB 3:25" /> איך האָב קײן שלװה און קײן רו</para>
  <para style="q" vid="JOB 3:25">און קײן מנוחה נישט,</para>
  <para style="q" vid="JOB 3:25">און ציטערניש איז געקומען.<verse eid="JOB 3:25" /></para>
  <chapter eid="JOB 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="JOB 4" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 4:1" />האָט געענטפֿערט אֶליפַֿז דער תֵּימָני, און האָט געזאָגט:<verse eid="JOB 4:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 4:2" />אַז מע פּרוּװט אַ װאָרט צו דיר װעט דיך פֿאַרדריסן?</para>
  <para style="q" vid="JOB 4:2">אָבער װער קען זיך אײַנהאַלטן פֿון רײד?<verse eid="JOB 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 4:3" />זע, האָסט געלערנט פֿילן,</para>
  <para style="q" vid="JOB 4:3">און שלאַפֿע הענט פֿלעגסטו שטאַרקן.<verse eid="JOB 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 4:4" />דעם געשטרױכלטן פֿלעגן אױפֿשטעלן דײַנע רײד,</para>
  <para style="q" vid="JOB 4:4">און געבײגטע קני פֿלעגסטו פֿעסטיקן.<verse eid="JOB 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 4:5" />אָבער אַצונד קומט עס צו דיר, װערסטו אָפּהענטיק,</para>
  <para style="q" vid="JOB 4:5">עס רירט דיך אָן, און װערסט דערשראָקן.<verse eid="JOB 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 4:6" />איז נישט דײַן יִרְאַת דײַן בטחון,</para>
  <para style="q" vid="JOB 4:6">דײַן האָפֿענונג די ערלעכקײט פֿון דײַנע װעגן?<verse eid="JOB 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 4:7" />דערמאָן זיך נאָר, װער איז אומשולדיק אונטערגעגאַנגען?</para>
  <para style="q" vid="JOB 4:7">און װוּ זײַנען רעכטפֿאַרטיקע פֿאַרטיליקט געװאָרן?<verse eid="JOB 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 4:8" />װעדליק איך האָב געזען, איז די װאָס אַקערן אומרעכט,</para>
  <para style="q" vid="JOB 4:8">און זײען אומגליק, זײ שנײַדן עס.<verse eid="JOB 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 4:9" />פֿון דעם הױך פֿון אֱלוֹהַּ גײען זײ אונטער,</para>
  <para style="q" vid="JOB 4:9">און פֿון דעם אָטעם פֿון זײַן צאָרן װערן זײ פֿאַרלענדט.<verse eid="JOB 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 4:10" />אַ געבריל פֿון לײב, אַ קֹול פֿון װילדלײב –</para>
  <para style="q" vid="JOB 4:10">אָבער די צײן פֿון די יונגלײבן װערן צעבראָכן;<verse eid="JOB 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 4:11" />דער אַלטער לײב גײט אױס אָן שפּײַז,</para>
  <para style="q" vid="JOB 4:11">און די קינדער פֿון דער לײבינטע װערן צעשפּרײט.<verse eid="JOB 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 4:12" />און צו מיר פֿלעגט אַ װאָרט זיך פֿאַרגנבֿען,</para>
  <para style="q" vid="JOB 4:12">און מײַן אױער האָט פֿאַרנומען אַ קװינט דערפֿון.<verse eid="JOB 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 4:13" />אין געדאַנקען, פֿון זעונגען פֿון דער נאַכט,</para>
  <para style="q" vid="JOB 4:13">װען אַ טיפֿער שלאָף פֿאַלט אױף מענטשן,<verse eid="JOB 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 4:14" />האָט מיך אַ פַּחד געטראָפֿן און אַ ציטערניש,</para>
  <para style="q" vid="JOB 4:14">און האָט אַלע מײַנע בײנער שױדערט.<verse eid="JOB 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 4:15" />און אַ גײַסט פֿלעגט פֿאַר מײַן פּנים אַריבער;</para>
  <para style="q" vid="JOB 4:15">קאַפּױר שטעלן פֿלעגט עס די האָר פֿון מײַן לײַב.<verse eid="JOB 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 4:16" />ער פֿלעגט שטײן, אָבער איך פֿלעג נישט דערקענען זײַן אָנבליק;</para>
  <para style="q" vid="JOB 4:16">אַ געשטאַלט איז געװען פֿאַר מײַנע אױגן;</para>
  <para style="q" vid="JOB 4:16">אַ שטילקײט און אַ שטים פֿלעג איך הערן:<verse eid="JOB 4:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 4:17" />קען אַ מענטש פֿאַר אֱלוֹהַּ זײַן גערעכט?</para>
  <para style="q" vid="JOB 4:17">צי קען פֿאַר זײַן באַשעפֿער רײן זײַן אַ מאַן?<verse eid="JOB 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 4:18" />זע, אין זײַנע קנעכט גלױבט ער נישט,</para>
  <para style="q" vid="JOB 4:18">און אין זײַנע מלאָכים מערקט ער אַ פֿאַרזע,<verse eid="JOB 4:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 4:19" />הײַנט װי שױן די װױנער אין הײַזער פֿון לײם,</para>
  <para style="q" vid="JOB 4:19">װאָס זײער גרונט איז אין שטױב?</para>
  <para style="q" vid="JOB 4:19">מע צעדריקט זײ גלײַך װי אַ מאָיל.<verse eid="JOB 4:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 4:20" />צװישן מאָרגן און אָװנט װערן זײ צעשטױסן,</para>
  <para style="q" vid="JOB 4:20">אומגעמערקט גײען זײ אונטער אױף אײביק.<verse eid="JOB 4:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 4:21" />פֿאַר װאָר, אָפּגעריסן װערט זײער געצעלטשטריק בײַ זײ,</para>
  <para style="q" vid="JOB 4:21">זײ שטאַרבן, און אָן חכמה.<verse eid="JOB 4:21" /></para>
  <chapter eid="JOB 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="JOB 5" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 5:1" />רוף אַקאָרשט, אױב איז דאָ װער זאָל דיר ענטפֿערן?</para>
  <para style="q" vid="JOB 5:1">און צו װעמען פֿון די הײליקע װעסטו זיך קערן?<verse eid="JOB 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 5:2" />װאָרעם דעם נאַרן הרגעט דער כּעס,</para>
  <para style="q" vid="JOB 5:2">און דעם נישט קלוגן טײט די קנאה.<verse eid="JOB 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 5:3" />זע איך אַ נאַרן אײַנגעװאָרצלט,</para>
  <para style="q" vid="JOB 5:3">רוף איך תּיכּף זײַן װױנונג פֿאַרשאָלטן.<verse eid="JOB 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 5:4" />זײַנע קינדער װעלן װײַט זײַן פֿון הילף,</para>
  <para style="q" vid="JOB 5:4">און זײ װעלן צעדריקט װערן אין טױער,</para>
  <para style="q" vid="JOB 5:4">און קײנער װעט נישט מציל זײַן.<verse eid="JOB 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 5:5" />װאָרעם זײַן שניט װעט דער הונגעריקער אױפֿעסן,</para>
  <para style="q" vid="JOB 5:5">און ביז פֿון די דערנער װעט ער עס אַװעקנעמען;</para>
  <para style="q" vid="JOB 5:5">און אײַנשלינגען װעט די נעץ זײער פֿאַרמעג.<verse eid="JOB 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 5:6" />פֿאַר װאָר, נישט פֿון שטױב קומט אַרױס אומגליק,</para>
  <para style="q" vid="JOB 5:6">און נישט פֿון דער ערד שפּראָצט מאַטערניש.<verse eid="JOB 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 5:7" />נײַערט אַ מענטש איז צו מאַטערניש געבאָרן;</para>
  <para style="q" vid="JOB 5:7">אַזױ װי פֿונקען פֿליִען אַרױף.<verse eid="JOB 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 5:8" />אָבער איך װאָלט געזוכט אֵל,</para>
  <para style="q" vid="JOB 5:8">און צו אלֹקים װאָלט איך געשטעלט מײַן טענה;<verse eid="JOB 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 5:9" />דער װאָס טוט גרױסע זאַכן נישט צו דערפֿאָרשן,</para>
  <para style="q" vid="JOB 5:9">װוּנדער אַזש אָן אַ צאָל;<verse eid="JOB 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 5:10" />דער װאָס גיט רעגן אױפֿן געזיכט פֿון דער ערד,</para>
  <para style="q" vid="JOB 5:10">און שיקט װאַסער אױפֿן געזיכט פֿון די פֿעלדער;<verse eid="JOB 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 5:11" />ער שטעלט די נידעריקע אין דער הײך,</para>
  <para style="q" vid="JOB 5:11">און די פֿינצטערע װערן דערהױבן דורך הילף.<verse eid="JOB 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 5:12" />ער פֿאַרשטערט די מחשבֿות פֿון די ליסטיקע,</para>
  <para style="q" vid="JOB 5:12">אַז זײערע הענט זאָלן נישט אױפֿטאָן ממשות.<verse eid="JOB 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 5:13" />ער פֿאַנגט קלוגע אין זײער ליסטיקײט,</para>
  <para style="q" vid="JOB 5:13">און די עצה פֿון די פֿאַרשפּיצטע װערט צעטומלט.<verse eid="JOB 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 5:14" />בײַ טאָג באַגעגענען זײ פֿינצטערניש,</para>
  <para style="q" vid="JOB 5:14">און אַזױ װי בײַ נאַכט טאַפּן זײ אין מיטן טאָג.<verse eid="JOB 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 5:15" />און ער העלפֿט פֿון דער שװערד – פֿון זײער מױל,</para>
  <para style="q" vid="JOB 5:15">און פֿון דעם שטאַרקנס האַנט דעם אבֿיון.<verse eid="JOB 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 5:16" />און דער אָרעמאַן קריגט האָפֿענונג,</para>
  <para style="q" vid="JOB 5:16">און אומגערעכטיקײט מאַכט צו איר מױל.<verse eid="JOB 5:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="JOB 5:17" />זע, װױל איז דעם מענטשן װאָס אֱלוֹהַּ שטראָפֿט אים,</para>
  <para style="q" vid="JOB 5:17">און דעם מוסר פֿון שַדַי זאָלסטו נישט פֿאַראַכטן.<verse eid="JOB 5:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 5:18" />װאָרעם ער מאַכט װײ טאָן, און ער פֿאַרבינדט,</para>
  <para style="q" vid="JOB 5:18">ער פֿאַרװוּנדט, און זײַנע הענט טאָן עס װידער הײלן.<verse eid="JOB 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 5:19" />אין זעקס צרות װעט ער דיך מציל זײַן,</para>
  <para style="q" vid="JOB 5:19">און אין זיבן װעט דיך נישט אָנרירן קײן בײז.<verse eid="JOB 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 5:20" />אין הונגער װעט ער דיך אױסלײזן פֿון טױט,</para>
  <para style="q" vid="JOB 5:20">און אין מלחמה פֿון דער מאַכט פֿון שװערד.<verse eid="JOB 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 5:21" />פֿאַר דער רוט פֿון דער צונג װעסטו זײַן פֿאַרבאָרגן,</para>
  <para style="q" vid="JOB 5:21">און װעסט נישט מורא האָבן פֿאַר פֿאַרװיסטונג, אַז זי קומט.<verse eid="JOB 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 5:22" />פֿון פֿאַרװיסטונג און פֿון הונגער װעסטו לאַכן,</para>
  <para style="q" vid="JOB 5:22">און פֿאַר די חיות פֿון דער ערד װעסטו נישט מורא האָבן.<verse eid="JOB 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 5:23" />װאָרעם מיט די שטײנער פֿון פֿעלד װעט זײַן דײַן ברית,</para>
  <para style="q" vid="JOB 5:23">און די חיה פֿון פֿעלד װעט זײַן שלום מיט דיר.<verse eid="JOB 5:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 5:24" />און װעסט װיסן אַז דײַן געצעלט איז בשלום,</para>
  <para style="q" vid="JOB 5:24">און װעסט נאָכזען דײַן װױנונג, און בײַ דיר װעט נישט פֿעלן.<verse eid="JOB 5:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 5:25" />און װעסט װיסן אַז דײַן זאָמען װעט זײַן פֿיל,</para>
  <para style="q" vid="JOB 5:25">און דײַנע שפּראָצונגען װי גראָז פֿון דער ערד.<verse eid="JOB 5:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 5:26" />װעסט קומען אין פֿולער עלטער צום קבֿר,</para>
  <para style="q" vid="JOB 5:26">װי אַ שײן תּבֿואה קומט אַרײַן אין זײַן צײַט.<verse eid="JOB 5:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 5:27" />זע, דאָס האָבן מיר אױסגעפֿאָרשט, אַזױ איז דאָס,</para>
  <para style="q" vid="JOB 5:27">הער עס צו, און דו מערק דיר.<verse eid="JOB 5:27" /></para>
  <chapter eid="JOB 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="JOB 6" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 6:1" />האָט געענטפֿערט אִיובֿ, און האָט געזאָגט:<verse eid="JOB 6:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 6:2" />װען געװױגן זאָל געװױגן װערן מײַן כּעס,</para>
  <para style="q" vid="JOB 6:2">און מײַן בראָך װאָלט מען נעמען אױפֿן װאָגשאָל באַגלײַך!<verse eid="JOB 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 6:3" />װאָרעם שװערער פֿון דעם זאַמד פֿון ימען װאָלט עס זײַן אַצונד;</para>
  <para style="q" vid="JOB 6:3">דערום זײַנען מײַנע װערטער צעמישט.<verse eid="JOB 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 6:4" />װאָרעם אין מיר זײַנען די פֿײַלן פֿון שַדַי,</para>
  <para style="q" vid="JOB 6:4">װאָס זײער גיפֿט טרינקט מײַן רוּחַ;</para>
  <para style="q" vid="JOB 6:4">שרעקענישן פֿון אֱלוֹהַּ שטעלן זיך אױס קעגן מיר.<verse eid="JOB 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 6:5" />שרײַט דען אַ װאַלדאײזל אױף גראָז?</para>
  <para style="q" vid="JOB 6:5">צי מרוקעט אַן אָקס אױף זײַן פֿוטער?<verse eid="JOB 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 6:6" />װערט אומבאַטעמטס געגעסן אָן זאַלץ?</para>
  <para style="q" vid="JOB 6:6">צי איז דאָ אַ טעם אין דאָס װײַסל פֿון אײ?<verse eid="JOB 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 6:7" />װאָס מײַן זעל האָט נישט געװאָלט אָנרירן,</para>
  <para style="q" vid="JOB 6:7">דאָס זײַנען די צושפּײַזן פֿון מײַן ברױט.<verse eid="JOB 6:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="JOB 6:8" />הלװאַי קומט אָן מײַן פֿאַרלאַנג,</para>
  <para style="q" vid="JOB 6:8">און מײַן האָפֿענונג גיט אֱלוֹהַּ!<verse eid="JOB 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 6:9" />און אֱלוֹהַּ װיליקט אײַן און צעדריקט מיך,</para>
  <para style="q" vid="JOB 6:9">לאָזט לױז זײַן האַנט און דערענדיקט מיך!<verse eid="JOB 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 6:10" />װאָלט דאָס נאָך געװען מײַן נחמה,</para>
  <para style="q" vid="JOB 6:10">און איך װאָלט געטאַנצט אין יסורים;</para>
  <para style="q" vid="JOB 6:10">זאָל ער זײַן אומדערבאַרעמדיק;</para>
  <para style="q" vid="JOB 6:10">הגם איך האָב נישט געלײקנט</para>
  <para style="q" vid="JOB 6:10">אָן די װערטער פֿון הײליקן.<verse eid="JOB 6:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="JOB 6:11" />װאָס איז מײַן כּוֹח, אַז איך זאָל האָפֿן?</para>
  <para style="q" vid="JOB 6:11">און װאָס מײַן סוף, אַז איך זאָל אײַנהאַלטן מײַן געמיט?<verse eid="JOB 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 6:12" />איז דער כּוֹח פֿון שטײנער מײַן כּוֹח?</para>
  <para style="q" vid="JOB 6:12">איז מײַן לײַב פֿון קופּער?<verse eid="JOB 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 6:13" />איז דען פֿאַר מיר קײן הילף נישטאָ,</para>
  <para style="q" vid="JOB 6:13">און אַן עצה איז פֿאַרשטױסן פֿון מיר?<verse eid="JOB 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 6:14" />דעם װאָס גײט אײַן קומט רַחמָנות פֿון זײַן חבֿר,</para>
  <para style="q" vid="JOB 6:14">אַפֿילו ער פֿאַרלאָזט די מורא פֿאַרן שַדַי.<verse eid="JOB 6:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 6:15" />מײַנע ברידער האָבן געפֿעלשט װי אַ טײַך,</para>
  <para style="q" vid="JOB 6:15">װי דער שטראָם פֿון טײַכן װאָס גײען אַװעק,<verse eid="JOB 6:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 6:16" />װאָס זײַנען טונקל פֿון אײַז –</para>
  <para style="q" vid="JOB 6:16">אױף זײ באַהאַלט זיך דער שנײ.<verse eid="JOB 6:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 6:17" />בעת זײ װערן צעװאַרעמט, װערן זײ פֿאַרשװוּנדן,</para>
  <para style="q" vid="JOB 6:17">װי עס װערט הײס, צעגײען זײ פֿון זײער אָרט.<verse eid="JOB 6:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 6:18" />עס דרײען זיך די װעגן פֿון זײער װאַנדער,</para>
  <para style="q" vid="JOB 6:18">זײ פֿאַרגײען אין נישט און װערן פֿאַרלאָרן.<verse eid="JOB 6:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 6:19" />די קאַראַװאַנען פֿון תֵּימאָ האָבן אױסגעקוקט,</para>
  <para style="q" vid="JOB 6:19">די מחנות פֿון שבֿאָ האָבן געהאָפֿט אױף זײ,<verse eid="JOB 6:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 6:20" />אָבער זײ האָבן זיך געשעמט װאָס זײ האָבן זיך פֿאַרזיכערט,</para>
  <para style="q" vid="JOB 6:20">זײ זײַנען אָנגעקומען ביז אַהין און אין שאַנד געבליבן.<verse eid="JOB 6:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 6:21" />פֿאַר װאָר, אַצונד זײַט איר מיט אים,</para>
  <para style="q" vid="JOB 6:21">איר האָט דערזען דעם בראָך, און זיך דערשראָקן.<verse eid="JOB 6:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 6:22" />האָב איך דען געזאָגט: גיט מיר װאָס,</para>
  <para style="q" vid="JOB 6:22">און פֿון אײַער פֿאַרמעג שענקט פֿאַר מיר?<verse eid="JOB 6:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 6:23" />אָדער: מאַכט מיך אַנטרינען פֿון שׂונאס האַנט,</para>
  <para style="q" vid="JOB 6:23">און פֿון דער האַנט פֿון געװאַלטטוער זאָלט איר מיך אױסלײזן?<verse eid="JOB 6:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="JOB 6:24" />לערנט מיך, און איך װעל שװײַגן,</para>
  <para style="q" vid="JOB 6:24">און װאָס איך האָב פֿאַרזען, גיט מיר צו פֿאַרשטײן.<verse eid="JOB 6:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 6:25" />װי שטאַרק זײַנען ריכטיקע װערטער!</para>
  <para style="q" vid="JOB 6:25">אָבער װאָס באַװײַזט דאָס באַװײַזן פֿון אײַך?<verse eid="JOB 6:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 6:26" />רעכנט איר װערטער פֿאַר אַ באַװײַז,</para>
  <para style="q" vid="JOB 6:26">און פֿאַר װינט די רײד פֿון פֿאַרצװײפֿלטן?<verse eid="JOB 6:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 6:27" />אַפֿילו אױף אַ יתום װאָלט איר גורל װאַרפֿן,</para>
  <para style="q" vid="JOB 6:27">און איר װאָלט גראָבן אױף אײַער חבֿר.<verse eid="JOB 6:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 6:28" />און אַצונד באַװיליקט, קערט אײַך צו מיר;</para>
  <para style="q" vid="JOB 6:28">און צי װעל איך אײַך אין פּנים אַ ליגן זאָגן?<verse eid="JOB 6:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 6:29" />קערט אײַך אום, איך בעט אײַך, זאָל קײן עװלה נישט געשען,</para>
  <para style="q" vid="JOB 6:29">יאָ, קערט אײַך װידער אום, איך בין גערעכט דערין.<verse eid="JOB 6:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 6:30" />איז אין מײַן צונג דאָ אומרעכט?</para>
  <para style="q" vid="JOB 6:30">צי שפּירט נישט מײַן גומען פֿאַרברעכן?<verse eid="JOB 6:30" /></para>
  <chapter eid="JOB 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="JOB 7" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 7:1" />פֿאַר װאָר, דינסטצײַט האָט דער מענטש אױף דער ערד,</para>
  <para style="q" vid="JOB 7:1">און װי טעג פֿון אַ געדונגענעם זײַנען זײַנע טעג.<verse eid="JOB 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 7:2" />װי אַ קנעכט װאָס שמאַכט נאָך שאָטן,</para>
  <para style="q" vid="JOB 7:2">און װי אַ געדונגענער װאָס האַרט אױף זײַן לױן,<verse eid="JOB 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 7:3" />אַזױ האָב איך מיר צוגעטײלט געקריגן חדשים פֿון אומגליק,</para>
  <para style="q" vid="JOB 7:3">און נעכט פֿון מאַטערניש האָט מען מיר צוגעצײלט.<verse eid="JOB 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 7:4" />אַז איך לײג זיך, זאָג איך: װען װעל איך אױפֿשטײן?</para>
  <para style="q" vid="JOB 7:4">און די נאַכט ציט זיך, און איך װער זאַט מיט װאַרפֿעניש ביזן פֿרימאָרגן.<verse eid="JOB 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 7:5" />מײַן לײַב איז באַקלײדט מיט װערעם און שטיקער ערד,</para>
  <para style="q" vid="JOB 7:5">מײַן הױט פּלאַצט און װערט צעקראָכן.<verse eid="JOB 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 7:6" />מײַנע טעג זײַנען פֿלינקער פֿון אַ װעבשיפֿל,</para>
  <para style="q" vid="JOB 7:6">און װערן פֿאַרלענדט אָן אַ האָפֿענונג.<verse eid="JOB 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 7:7" />געדענק, אַז אַ הױך איז מײַן לעבן,</para>
  <para style="q" vid="JOB 7:7">מײַן אױג װעט נישט אָנזען מער גוטס.<verse eid="JOB 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 7:8" />מיך װעט מער נישט אָנקוקן דאָס אױג פֿון מײַן זעער,</para>
  <para style="q" vid="JOB 7:8">דײַנע אױגן זײַנען אױף מיר, און שױן בין איך נישטאָ.<verse eid="JOB 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 7:9" />פֿאַרלענדט װערט אַ װאָלקן און פֿאַרגײט,</para>
  <para style="q" vid="JOB 7:9">אַזױ דער װאָס נידערט אין שְׁאֹול, װעט נישט אַרױפֿקומען.<verse eid="JOB 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 7:10" />ער װעט זיך מער נישט אומקערן אין זײַן הױז,</para>
  <para style="q" vid="JOB 7:10">און זײַן אָרט װעט אים מער נישט קענען.<verse eid="JOB 7:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="JOB 7:11" />דערום װעל איך נישט פֿאַרמײַדן מײַן מױל,</para>
  <para style="q" vid="JOB 7:11">איך װעל רעדן אין דער קלעמעניש פֿון מײַן געמיט,</para>
  <para style="q" vid="JOB 7:11">איך װעל קלאָגן אין דער ביטערקײט פֿון מײַן זעל.<verse eid="JOB 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 7:12" />בין איך אַ ים, אָדער אַ ים-חיה,</para>
  <para style="q" vid="JOB 7:12">װאָס דו שטעלסט אַ װאַך איבער מיר?<verse eid="JOB 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 7:13" />אַז איך זאָג: מײַן בעט װעט מיך טרײסטן,</para>
  <para style="q" vid="JOB 7:13">מײַן געלעגער װעט מיטטראָגן מײַן קלאָג,<verse eid="JOB 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 7:14" />שרעקסטו מיך מיט חלומות,</para>
  <para style="q" vid="JOB 7:14">און מיט זעונגען גרױלסטו מיך.<verse eid="JOB 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 7:15" />און מײַן זעל װיל בעסער דערװאַרגעניש,</para>
  <para style="q" vid="JOB 7:15">טױט, אײדער די דאָזיקע בײנער מײַנע.<verse eid="JOB 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 7:16" />מיר איז נימאס; איך װעל אײביק נישט לעבן,</para>
  <para style="q" vid="JOB 7:16">לאָז אָפּ פֿון מיר, װאָרעם אַ הױך זײַנען מײַנע טעג.<verse eid="JOB 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 7:17" />װאָס איז דער מענטש, אַז דו זאָלסט אים גרײסן,</para>
  <para style="q" vid="JOB 7:17">און אַז דו זאָלסט לײגן אױף אים דײַן האַרץ,<verse eid="JOB 7:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 7:18" />און אים דערמאָנען אַלע פֿרימאָרגן,</para>
  <para style="q" vid="JOB 7:18">אַלע רגע אים פּרוּװן?<verse eid="JOB 7:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 7:19" />װי לאַנג װעסטו זיך נישט אָפּקערן פֿון מיר?</para>
  <para style="q" vid="JOB 7:19">מיך נישט אָפּלאָזן ביז איך שלינג אַראָפּ מײַן שפּײַעכץ?<verse eid="JOB 7:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 7:20" />אַז איך זינדיק,</para>
  <para style="q" vid="JOB 7:20">װאָס טו איך דיר, היטער פֿון דעם מענטשן?</para>
  <para style="q" vid="JOB 7:20">פֿאַר װאָס האָסטו מיך געמאַכט פֿאַר דײַן צילברעט,</para>
  <para style="q" vid="JOB 7:20">אַז איך בין געװאָרן זיך אַלײן צו לאַסט?<verse eid="JOB 7:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 7:21" />און װאָס פֿאַרגיסטו נישט מײַן פֿאַרברעך,</para>
  <para style="q" vid="JOB 7:21">און טוסט נישט אָפּ מײַן זינד?</para>
  <para style="q" vid="JOB 7:21">װאָרעם אַצונד װעל איך ליגן אין שטױב,</para>
  <para style="q" vid="JOB 7:21">און װעסט מיך זוכן, און איך װעל נישט זײַן.<verse eid="JOB 7:21" /></para>
  <chapter eid="JOB 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="JOB 8" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 8:1" />האָט געענטפֿערט בִלדַד דער שוחי, און האָט געזאָגט:<verse eid="JOB 8:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 8:2" />ביז װאַנען װעסטו רעדן דאָס דאָזיקע,</para>
  <para style="q" vid="JOB 8:2">און װי אַ שטאַרקער װינט װעלן זײַן די װערטער פֿון דײַן מױל?<verse eid="JOB 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 8:3" />װעט דען אֵל פֿאַרדרײען דעם משפּט?</para>
  <para style="q" vid="JOB 8:3">און װעט שַדַי פֿאַרדרײען די גערעכטיקײט?<verse eid="JOB 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 8:4" />אַז דײַנע קינדער האָבן געזינדיקט צו אים,</para>
  <para style="q" vid="JOB 8:4">האָט ער זײ אַװעקגעשיקט פֿאַר זײער פֿאַרברעך.<verse eid="JOB 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 8:5" />אַז דו װאָלסט זוכן אֵל,</para>
  <para style="q" vid="JOB 8:5">און צום שַדַי בעטן,<verse eid="JOB 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 8:6" />אַז דו װאָלסט זײַן רײן און רעכטפֿאַרטיק,</para>
  <para style="q" vid="JOB 8:6">װאָלט ער אַצונד זיך דערװעקן פֿאַר דיר,</para>
  <para style="q" vid="JOB 8:6">און גאַנץ מאַכן דײַן גערעכטע װױנונג.<verse eid="JOB 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 8:7" />און אױב דײַן אָנהײב װעט זײַן קלײן,</para>
  <para style="q" vid="JOB 8:7">װעט דײַן סוף זײַן זײער גרױס.<verse eid="JOB 8:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="JOB 8:8" />װאָרעם פֿרעג אַקאָרשט דעם פֿריִערדיקן דור,</para>
  <para style="q" vid="JOB 8:8">און מערק װאָס זײערע עלטערן האָבן אױסגעפֿאָרשט<verse eid="JOB 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 8:9" />– װאָרעם מיר זײַנען פֿון נעכטן, און װײסן גאָרנישט,</para>
  <para style="q" vid="JOB 8:9">װײַל אַ שאָטן זײַנען אונדזערע טעג אױף דער ערד –<verse eid="JOB 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 8:10" />פֿאַר װאָר, זײ װעלן דיך לערנען, זײ װעלן דיר זאָגן,</para>
  <para style="q" vid="JOB 8:10">און פֿון זײער האַרצן אַרױסברענגען װערטער?<verse eid="JOB 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 8:11" />קען אױסװאַקסן ראָר אָן אַ זומפּ?</para>
  <para style="q" vid="JOB 8:11">קען גרױס װערן טײַכגראָז אָן װאַסער?<verse eid="JOB 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 8:12" />נאָך איז עס אין זײַן גרינקײט, נישט אָפּגעשניטן,</para>
  <para style="q" vid="JOB 8:12">און װי גאָרע הײ װערט עס פֿאַרטריקנט.<verse eid="JOB 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 8:13" />אַזױ זײַנען די װעגן פֿון אַלע ג-טפֿאַרגעסער,</para>
  <para style="q" vid="JOB 8:13">און די האָפֿענונג פֿון דעם זינדיקן גײט אונטער.<verse eid="JOB 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 8:14" />װאָרעם זומערפֿאָדעם איז זײַן פֿאַרזיכערונג,</para>
  <para style="q" vid="JOB 8:14">און שפּינװעבס זײַן בטחון.<verse eid="JOB 8:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 8:15" />ער לענט זיך אָן אױף זײַן הױז,</para>
  <para style="q" vid="JOB 8:15">אָבער עס האָט נישט קײן באַשטאַנד,</para>
  <para style="q" vid="JOB 8:15">ער האַלט זיך דעראָן,</para>
  <para style="q" vid="JOB 8:15">אָבער עס בלײַבט נישט שטײן.<verse eid="JOB 8:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 8:16" />זאַפֿטיק איז ער פֿאַר דער זון,</para>
  <para style="q" vid="JOB 8:16">און איבער זײַן גאָרטן גײט אַרױס זײַן שפּראָץ.<verse eid="JOB 8:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 8:17" />אין אַ הױפֿן פֿלעכטן זיך זײַנע װאָרצלען,</para>
  <para style="q" vid="JOB 8:17">צװישן שטײנער רײַסט ער זיך דורך.<verse eid="JOB 8:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 8:18" />אָבער פֿאַרטיליקט מען אים פֿון זײַן אָרט,</para>
  <para style="q" vid="JOB 8:18">פֿאַרלײקנט ער אים: איך האָב דיך נישט געזען.<verse eid="JOB 8:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 8:19" />אָט דאָס איז די פֿרײד פֿון זײַן װעג,</para>
  <para style="q" vid="JOB 8:19">און פֿון דער ערד שפּראָצט אַן אַנדערער אַרױס.<verse eid="JOB 8:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 8:20" />זע, אֵל פֿאַראַכט נישט דעם אומשולדיקן,</para>
  <para style="q" vid="JOB 8:20">און װעט נישט אױפֿהאַלטן די האַנט פֿון דעם שלעכטסטוער;<verse eid="JOB 8:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 8:21" />ביז ער װעט אָנפֿילן מיט געלעכטער דײַן מױל,</para>
  <para style="q" vid="JOB 8:21">און דײַנע ליפּן מיט שאַלונג.<verse eid="JOB 8:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 8:22" />דײַנע שָׂונאים װעלן זיך אָנקלײדן מיט שאַנד,</para>
  <para style="q" vid="JOB 8:22">און דאָס געצעלט פֿון די רשעים װעט מער נישט זײַן.<verse eid="JOB 8:22" /></para>
  <chapter eid="JOB 8" />
  <chapter number="9" style="c" pubnumber="ט" sid="JOB 9" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 9:1" />האָט געענטפֿערט אִיובֿ, און האָט געזאָגט:<verse eid="JOB 9:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 9:2" />אמת, איך װײס אַז אַזױ איז עס;</para>
  <para style="q" vid="JOB 9:2">אָבער װי קען אַ מענטש גערעכט זײַן פֿאַר אֵל?<verse eid="JOB 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 9:3" />אַז ער זאָל װעלן זיך קריגן מיט אים,</para>
  <para style="q" vid="JOB 9:3">װאָלט ער אים נישט געקענט ענטפֿערן אײנס פֿון טױזנט.<verse eid="JOB 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 9:4" />קלוג אין האַרצן, און שטאַרק אין כּוֹח –</para>
  <para style="q" vid="JOB 9:4">װער קען זיך עקשנען קעגן אים און אַרױס גאַנץ?<verse eid="JOB 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 9:5" />דער װאָס רוקט איבער בערג, און זײ מערקן נישט,</para>
  <para style="q" vid="JOB 9:5">װען ער קערט זײ איבער אין זײַן צאָרן.<verse eid="JOB 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 9:6" />דער װאָס טרײסלט אױף די ערד פֿון איר אָרט,</para>
  <para style="q" vid="JOB 9:6">אַז אירע זײַלן ציטערן.<verse eid="JOB 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 9:7" />דער װאָס הײסט דער זון, און זי שײַנט נישט,</para>
  <para style="q" vid="JOB 9:7">און די שטערן פֿאַרחתמעט ער.<verse eid="JOB 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 9:8" />ער האָט אױסגעשפּרײט די הימלען אַלײן,</para>
  <para style="q" vid="JOB 9:8">און ער טרעט אױף די הײכן פֿון ים.<verse eid="JOB 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 9:9" />ער האָט געמאַכט דעם בערשטערן,</para>
  <para style="q" vid="JOB 9:9">דעם אָריאָן און דעם זיבנשטערן,</para>
  <para style="q" vid="JOB 9:9">און די קאַמערן פֿון דָרום.<verse eid="JOB 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 9:10" />ער טוט גרױסע זאַכן אַזש נישט צו דערפֿאָרשן,</para>
  <para style="q" vid="JOB 9:10">און װוּנדער אַזש אָן אַ צאָל.<verse eid="JOB 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 9:11" />אָט גײט ער מיר פֿאַרבײַ, און איך זע נישט,</para>
  <para style="q" vid="JOB 9:11">און ער ציט דורך, און איך מערק אים נישט.<verse eid="JOB 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 9:12" />אָט כאַפּט ער אַװעק – װער קען אים אָפּהאַלטן?</para>
  <para style="q" vid="JOB 9:12">װער קען אים זאָגן: װאָס טוסטו?<verse eid="JOB 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 9:13" />אֱלוֹהַּ קערט נישט אָפּ זײַן צאָרן;</para>
  <para style="q" vid="JOB 9:13">אונטער אים האָבן זיך געבױגן די העלפֿער פֿון רַהַבֿ.<verse eid="JOB 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 9:14" />הײַנט װי שױן קען איך אים ענטפֿערן,</para>
  <para style="q" vid="JOB 9:14">קלײַבן מײַנע װערטער קעגן אים?<verse eid="JOB 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 9:15" />װאָס אַפֿילו איך זאָל גערעכט זײַן, קען איך נישט ענטפֿערן;</para>
  <para style="q" vid="JOB 9:15">בעטן מוז איך זיך בײַ דעם װאָס משפּט מיך.<verse eid="JOB 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 9:16" />אַפֿילו איך זאָל רופֿן און ער זאָל ענטפֿערן,</para>
  <para style="q" vid="JOB 9:16">װאָלט איך נישט גלױבן אַז ער האָט פֿאַרנומען מײַן קֹול.<verse eid="JOB 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 9:17" />ער װאָס צערײבט מיך מיט שטורעמװינט,</para>
  <para style="q" vid="JOB 9:17">און מערט מײַנע װוּנדן בחנם.<verse eid="JOB 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 9:18" />ער לאָזט מיך מײַן אָטעם נישט אָפּציִען,</para>
  <para style="q" vid="JOB 9:18">נײַערט ער זעטיקט מיך מיט ביטערנישן.<verse eid="JOB 9:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 9:19" />אױב אין כּוֹח, איז ער מאַכטיקער,</para>
  <para style="q" vid="JOB 9:19">און אױב אױף אַ משפּט: װער קען מיך לאָדן?<verse eid="JOB 9:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 9:20" />אַפֿילו איך זאָל זײַן גערעכט, װעט מײַן מױל מיך פֿאַרשולדיקן;</para>
  <para style="q" vid="JOB 9:20">איך מעג זײַן אומשולדיק, װעט ער מיך מאַכן פֿאַר קרום.<verse eid="JOB 9:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JOB 9:21" />איך בין אומשולדיק;</para>
  <para style="q" vid="JOB 9:21">מיך אַרט נישט מײַן נפֿש,</para>
  <para style="q" vid="JOB 9:21">מיר איז נימאס מײַן לעבן.<verse eid="JOB 9:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 9:22" />עס איז אַלץ אײנס, דערום זאָג איך:</para>
  <para style="q" vid="JOB 9:22">דעם אומשולדיקן אַזױ װי דעם רשע פֿאַרלענדט ער.<verse eid="JOB 9:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 9:23" />װען די רוט טײט פּלוצלינג,</para>
  <para style="q" vid="JOB 9:23">שפּאָט ער אױף דעם גוססן פֿון די אומשולדיקע.<verse eid="JOB 9:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 9:24" />די ערד איז איבערגעגעבן אין דער האַנט פֿון רשע;</para>
  <para style="q" vid="JOB 9:24">דעם פּנים פֿון אירע ריכטער פֿאַרדעקט ער;</para>
  <para style="q" vid="JOB 9:24">אױב נישט, װער דען איז דאָס?<verse eid="JOB 9:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 9:25" />און מײַנע טעג זײַנען פֿלינקער פֿון אַ לױפֿער,</para>
  <para style="q" vid="JOB 9:25">זײ זײַנען אַנטלאָפֿן, נישט אָנגעזען גוטס.<verse eid="JOB 9:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 9:26" />זײ זײַנען אַװעק גלײַך װי ראָרשיפֿן,</para>
  <para style="q" vid="JOB 9:26">װי אַן אָדלער װאָס שװעבט אױפֿן עסן.<verse eid="JOB 9:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 9:27" />אַז איך זאָג, איך װעל פֿאַרגעסן מײַן קלאָג,</para>
  <para style="q" vid="JOB 9:27">אַװעקװאַרפֿן מײַן אומעטיק פּנים, און זיך אױפֿמונטערן,<verse eid="JOB 9:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 9:28" />שרעק איך זיך פֿאַר אַלע מײַנע װײטאָגן,</para>
  <para style="q" vid="JOB 9:28">איך װײס אַז דו װעסט מיר נישט שענקען.<verse eid="JOB 9:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 9:29" />שולדיק מוז איך בלײַבן,</para>
  <para style="q" vid="JOB 9:29">טאָ נאָך װאָס זאָל איך מיך מיִען אומנישט?<verse eid="JOB 9:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 9:30" />אַז איך װאָלט זיך געװאַשן מיט שנײװאַסער,</para>
  <para style="q" vid="JOB 9:30">און גערײניקט מיט לױג מײַנע הענט,<verse eid="JOB 9:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 9:31" />װעסטו דענצמאָל אין אַ גראָבן מיך אײַנטונקען,</para>
  <para style="q" vid="JOB 9:31">אַז מײַנע קלײדער װעלן זיך עקלען מיט מיר.<verse eid="JOB 9:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 9:32" />װאָרעם נישט אַ מענטש װי איך איז ער, איך זאָל אים ענטפֿערן,</para>
  <para style="q" vid="JOB 9:32">מיר זאָלן אין אײנעם צום משפּט גײן.<verse eid="JOB 9:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 9:33" />נישטאָ צװישן אונדז קײן אַנטשײדער,</para>
  <para style="q" vid="JOB 9:33">װאָס זאָל לײגן זײַן האַנט אױף אונדז בײדן.<verse eid="JOB 9:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 9:34" />זאָל ער אָפּטאָן פֿון מיר זײַן רוט,</para>
  <para style="q" vid="JOB 9:34">און זײַן אימה זאָל מיך נישט שרעקן,<verse eid="JOB 9:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 9:35" />װעל איך רעדן, און נישט מורא האָבן פֿאַר אים;</para>
  <para style="q" vid="JOB 9:35">אָבער עס איז נישט װי בײַ מיר.<verse eid="JOB 9:35" /></para>
  <chapter eid="JOB 9" />
  <chapter number="10" style="c" pubnumber="י" sid="JOB 10" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 10:1" />מיר אַלײן עקלט מײַן לעבן;</para>
  <para style="q" vid="JOB 10:1">איך װעל פֿון מיר לױז לאָזן מײַן קלאָג,</para>
  <para style="q" vid="JOB 10:1">איך װעל רעדן אין דער ביטערקײט פֿון מײַן זעל.<verse eid="JOB 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 10:2" />איך װעל זאָגן צו אֱלוֹהַּ: זאָלסט מיך נישט שולדיק מאַכן;</para>
  <para style="q" vid="JOB 10:2">לאָז מיך װיסן פֿאַר װאָס דו קריגסט זיך מיט מיר.<verse eid="JOB 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 10:3" />איז דיר גוט אַז דו דריקסט,</para>
  <para style="q" vid="JOB 10:3">אַז דו פֿאַראַכטסט די מי פֿון דײַנע הענט,</para>
  <para style="q" vid="JOB 10:3">און דעם באַראָט פֿון די רשעים באַשײַנסטו?<verse eid="JOB 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 10:4" />זײַנען אױגן פֿון פֿלײש בײַ דיר?</para>
  <para style="q" vid="JOB 10:4">צי זעסטו װי אַ מענטש זעט?<verse eid="JOB 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 10:5" />זײַנען װי די טעג פֿון אַ מענטשן דײַנע טעג,</para>
  <para style="q" vid="JOB 10:5">צי דײַנע יאָרן װי די טעג פֿון אַ מאַן?<verse eid="JOB 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 10:6" />אַז דו זוכסט מײַן זינד,</para>
  <para style="q" vid="JOB 10:6">און פֿאָרשט מײַן חטא,<verse eid="JOB 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 10:7" />הגם דו װײסט אַז איך בין נישט שולדיק,</para>
  <para style="q" vid="JOB 10:7">נאָר נישטאָ װער זאָל מציל זײַן פֿון דײַן האַנט.<verse eid="JOB 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 10:8" />דײַנע הענט האָבן מיך געפֿורעמט און געמאַכט</para>
  <para style="q" vid="JOB 10:8">מיט אַלעם מיט אַנאַנדער, דאָך טוסט דו מיך פֿאַרדאַרבן.<verse eid="JOB 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 10:9" />געדענק פֿאָרט, אַז װי לײם האָסטו מיך געמאַכט,</para>
  <para style="q" vid="JOB 10:9">און צו שטױב װעסטו מיך אומקערן.<verse eid="JOB 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 10:10" />פֿאַר װאָר, װי מילך האָסטו מיך אױסגעגאָסן,</para>
  <para style="q" vid="JOB 10:10">און װי קעז האָסטו מיך פֿאַרגליװערט.<verse eid="JOB 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 10:11" />מיט הױט און פֿלײש האָסטו מיך באַקלײדט,</para>
  <para style="q" vid="JOB 10:11">און מיט בײנער און אָדערן געפֿלאָכטן.<verse eid="JOB 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 10:12" />לעבן און גענאָד האָסטו מיר באַשערט,</para>
  <para style="q" vid="JOB 10:12">און דײַן אָבאַכט האָט אָפּגעהיט מײַן גײַסט.<verse eid="JOB 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 10:13" />אָבער דאָס האָסטו באַהאַלטן אין דײַן האַרצן,</para>
  <para style="q" vid="JOB 10:13">איך װײס אַז דאָס האָסטו געהאַט אין זינען:<verse eid="JOB 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 10:14" />אַז איך זינדיק, װעסטו מיך היטן,</para>
  <para style="q" vid="JOB 10:14">און פֿון מײַן חטא מיך נישט רײן מאַכן.<verse eid="JOB 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 10:15" />אַז איך בין שולדיק, איז װײ צו מיר,</para>
  <para style="q" vid="JOB 10:15">און בין איך גערעכט, קען איך נישט אױפֿהײבן דעם קאָפּ,</para>
  <para style="q" vid="JOB 10:15">זאַט מיט שאַנד, און זעענדיק מײַן פּײַן.<verse eid="JOB 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 10:16" />און הײבט ער זיך אױף, יאָגסטו מיך װי אַ לײב,</para>
  <para style="q" vid="JOB 10:16">און אַלץ װידער באַגײסטו זיך משונה קעגן מיר.<verse eid="JOB 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 10:17" />באַנײַסט דײַנע עדות קעגן מיר,</para>
  <para style="q" vid="JOB 10:17">און מערסט דײַן כּעס אױף מיר;</para>
  <para style="q" vid="JOB 10:17">געביטן נאָכאַנאַנד װערט דער חיל קעגן מיר.<verse eid="JOB 10:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JOB 10:18" />און נאָך װאָס האָסטו מיך פֿון טראַכט אַרױסגעצױגן?</para>
  <para style="q" vid="JOB 10:18">איך װאָלט פֿאַרגאַנגען, און אַן אױג װאָלט מיך נישט אָנגעזען.<verse eid="JOB 10:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 10:19" />װי נישט געװען װאָלט איך געװען,</para>
  <para style="q" vid="JOB 10:19">פֿון מוטערלײַב װאָלט איך צום קבֿר געבראַכט געװאָרן.<verse eid="JOB 10:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 10:20" />מײַנע טעג זײַנען דאָך װינציק, טאָ הער אױף,</para>
  <para style="q" vid="JOB 10:20">און טו זיך אָפּ פֿון מיר, איך זאָל זיך אױפֿמונטערן אַ ביסל,<verse eid="JOB 10:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 10:21" />אײדער איך גײ אַװעק זיך נישט אומצוקערן,</para>
  <para style="q" vid="JOB 10:21">אין אַ לאַנד פֿון חושך און טױטשאָטן,<verse eid="JOB 10:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 10:22" />אַ לאַנד טונקל װי די פֿינצטערניש אַלײן,</para>
  <para style="q" vid="JOB 10:22">טױטשאָטן אָן אָרדענונג,</para>
  <para style="q" vid="JOB 10:22">װוּ אַפֿילו אַז עס שײַנט, איז װי פֿינצטערניש.<verse eid="JOB 10:22" /></para>
  <chapter eid="JOB 10" />
  <chapter number="11" style="c" pubnumber="יא" sid="JOB 11" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 11:1" />האָט געענטפֿערט צופֿר דער נַעַמָתי, און האָט געזאָגט:<verse eid="JOB 11:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 11:2" />זאָל דער פֿילרעדעװדיקער בלײַבן נישט געענטפֿערט?</para>
  <para style="q" vid="JOB 11:2">און צי זאָל דער ליפּנמענטש בלײַבן גערעכט?<verse eid="JOB 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 11:3" />דײַנע פּלױדערײַען מאַכן מענטשן שװײַגן,</para>
  <para style="q" vid="JOB 11:3">און דו שפּאָטסט, און זאָל דיך קײנער נישט פֿאַרשעמען?<verse eid="JOB 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 11:4" />און דו זאָגסט: לױטער איז מײַן לערנונג,</para>
  <para style="q" vid="JOB 11:4">און רײן בין איך אין דײַנע אױגן.<verse eid="JOB 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 11:5" />אָבער הלװאַי רעדט אֱלוֹהַּ,</para>
  <para style="q" vid="JOB 11:5">און עפֿנט זײַנע ליפּן מיט דיר,<verse eid="JOB 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 11:6" />און דערצײלט דיר די פֿאַרבאָרגענישן פֿון קלוגשאַפֿט,</para>
  <para style="q" vid="JOB 11:6">װי פֿילפֿאַכיק די חכמה איז,</para>
  <para style="q" vid="JOB 11:6">און װאָלסט װיסן אַז אֱלוֹהַּ מאָנט פֿון דיר</para>
  <para style="q" vid="JOB 11:6">װינציקער װי דײַן זינד.<verse eid="JOB 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 11:7" />װילסטו די דערפֿאָרשונג פֿון אֱלוֹהַּ געפֿינען?</para>
  <para style="q" vid="JOB 11:7">צי דעם ציל פֿון שַדַי געפֿינען?<verse eid="JOB 11:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 11:8" />עס איז הױך װי די הימלען, װאָס קענסטו אױפֿטאָן?</para>
  <para style="q" vid="JOB 11:8">טיפֿער פֿון שְׁאֹול, װאָס קענסטו װיסן?<verse eid="JOB 11:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 11:9" />לענגער פֿון דער ערד איז די מאָס דערפֿון,</para>
  <para style="q" vid="JOB 11:9">און ברײטער פֿון ים.<verse eid="JOB 11:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 11:10" />אַז ער גײט פֿאַרבײַ און פֿאַרשליסט,</para>
  <para style="q" vid="JOB 11:10">אָדער ער זאַמלט אײַן, װער קען אים אָפּהאַלטן?<verse eid="JOB 11:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 11:11" />װאָרעם ער װײס די פֿאַלשע לײַט,</para>
  <para style="q" vid="JOB 11:11">און ער זעט דאָס אומרעכט, אָן צו מאָל אַ קוק טאָן.<verse eid="JOB 11:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 11:12" />אָבער דער פּוסטער מענטש װעט קריגן שׂכל,</para>
  <para style="q" vid="JOB 11:12">װען אַ יונגער װאַלדאײזל װעט איבערגעבאָרן װערן אין אַ מענטשן.<verse eid="JOB 11:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 11:13" />אַז דו װעסט צוקערן דײַן האַרץ,</para>
  <para style="q" vid="JOB 11:13">און אױסשפּרײטן צו אים דײַנע הענט –<verse eid="JOB 11:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 11:14" />אױב אומרעכט איז אין דײַן האַנט, דערװײַטער עס,</para>
  <para style="q" vid="JOB 11:14">און זאָלסט נישט לאָזן רוען אין דײַנע געצעלטן אַן עװלה –<verse eid="JOB 11:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 11:15" />דענצמאָל װעסטו אױפֿהײבן דײַן פּנים אָן אַ פֿלעק,</para>
  <para style="q" vid="JOB 11:15">און װעסט פֿעסט זײַן, און נישט מורא האָבן.<verse eid="JOB 11:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 11:16" />װאָרעם די מאַטערניש װעסטו פֿאַרגעסן;</para>
  <para style="q" vid="JOB 11:16">װי װאַסער װאָס איז אַװעק װעסטו עס דערמאָנען.<verse eid="JOB 11:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 11:17" />און העלער װי מיטן טאָג װעט אױפֿשטײן דײַן לעבן,</para>
  <para style="q" vid="JOB 11:17">די פֿינצטערניש װעט װי דער מאָרגן װערן.<verse eid="JOB 11:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 11:18" />און װעסט זײַן זיכער, װײַל האָפֿענונג איז דאָ,</para>
  <para style="q" vid="JOB 11:18">און װעסט זיך אַרומקוקן, און ליגן אין זיכערקײט.<verse eid="JOB 11:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 11:19" />און װעסט הױערן, און קײנער װעט נישט שרעקן,</para>
  <para style="q" vid="JOB 11:19">און פֿיל װעלן זוכן דײַן לײַטזעליקײט.<verse eid="JOB 11:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 11:20" />אָבער די אױגן פֿון די רשעים װעלן אױסגײן,</para>
  <para style="q" vid="JOB 11:20">און אַנטרינונג װעט זײַן פֿאַרלאָרן פֿון זײ,</para>
  <para style="q" vid="JOB 11:20">און זײער האָפֿענונג – אַן אױסהױכעניש פֿון דער נשמה.<verse eid="JOB 11:20" /></para>
  <chapter eid="JOB 11" />
  <chapter number="12" style="c" pubnumber="יב" sid="JOB 12" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 12:1" />האָט געענטפֿערט אִיובֿ, און האָט געזאָגט:<verse eid="JOB 12:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 12:2" />אמת יאָ, איר זײַט די לײַט,</para>
  <para style="q" vid="JOB 12:2">און מיט אײַך װעט אָפּשטאַרבן די חכמה!<verse eid="JOB 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 12:3" />איך האָב אױך פֿאַרשטאַנדיקײט אַזױ װי איר,</para>
  <para style="q" vid="JOB 12:3">איך פֿאַל נישט אַראָפּ קעגן אײַך;</para>
  <para style="q" vid="JOB 12:3">און װער װײס נישט אַזעלכע זאַכן װי די דאָזיקע?<verse eid="JOB 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 12:4" />אַ געלעכטער בײַם חבֿר בין איך געװאָרן –</para>
  <para style="q" vid="JOB 12:4">דער װאָס האָט גערופֿן צו אֱלוֹהַּ, און ער האָט אים געענטפֿערט;</para>
  <para style="q" vid="JOB 12:4">אַ געלעכטער – דער גערעכטער, דער פֿרומער.<verse eid="JOB 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 12:5" />דעם אומגליקלעכן קומט פֿאַראַכטונג,</para>
  <para style="q" vid="JOB 12:5">װעדליק די געדאַנקען פֿון דעם גליקלעכן,</para>
  <para style="q" vid="JOB 12:5">אַ שטױס – די װאָס זײער פֿוס גליטשט זיך אױס.<verse eid="JOB 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 12:6" />בשלװה זײַנען די געצעלטן פֿון די רױבער,</para>
  <para style="q" vid="JOB 12:6">און אין זיכערקײט די װאָס דערצערענען אֵל,</para>
  <para style="q" vid="JOB 12:6">דער װאָס ברענגט זײַן אֱלוֹהַּ אין זײַן פֿױסט.<verse eid="JOB 12:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 12:7" />אָבער פֿרעג אַקאָרשט די בהמות, און זײ װעלן דיך לערנען,</para>
  <para style="q" vid="JOB 12:7">און דעם פֿױגל פֿון הימל, און ער װעט דיר זאָגן;<verse eid="JOB 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 12:8" />אָדער רעד צו דער ערד, און זי װעט דיך לערנען,</para>
  <para style="q" vid="JOB 12:8">און דיר װעלן דערצײלן די פֿישן פֿון ים.<verse eid="JOB 12:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 12:9" />װער צװישן אַלע דאָזיקע װײס נישט,</para>
  <para style="q" vid="JOB 12:9">אַז די האַנט פֿון ה׳ האָט דאָס געמאַכט?<verse eid="JOB 12:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 12:10" />אַז אין זײַן האַנט איז די זעל פֿון יעטװעדער לעבעדיקן,</para>
  <para style="q" vid="JOB 12:10">און דער גײַסט פֿון יעטװעדער מענטשנס לײַב.<verse eid="JOB 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 12:11" />דאַרף נישט דאָס אױער פּרוּװן װערטער,</para>
  <para style="q" vid="JOB 12:11">אַזױ װי דער גומען פֿאַרזוכט זײַן שפּײַז?<verse eid="JOB 12:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 12:12" />איז בײַ גרײַזן די חכמה,</para>
  <para style="q" vid="JOB 12:12">און אין אַריכת-ימים פֿאַרשטאַנדיקײט? –<verse eid="JOB 12:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 12:13" />בײַ אים איז חכמה און גבֿורה,</para>
  <para style="q" vid="JOB 12:13">ער האָט עצות און פֿאַרשטאַנדיקײט.<verse eid="JOB 12:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 12:14" />זע, ער צעשטערט, און עס װערט נישט אָפּגעבױט,</para>
  <para style="q" vid="JOB 12:14">ער פֿאַרשליסט אַ מענטשן, און עס װערט נישט געעפֿנט.<verse eid="JOB 12:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 12:15" />זע, ער פֿאַרהאַלט װאַסערן, און זײ װערן אױסגעטריקנט,</para>
  <para style="q" vid="JOB 12:15">און ער שיקט זײ אַרױס, און זײ קערן איבער די ערד.<verse eid="JOB 12:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 12:16" />בײַ אים איז מאַכט און קלוגשאַפֿט,</para>
  <para style="q" vid="JOB 12:16">זײַנער איז אי דער פֿאַרפֿירטער אי דער פֿאַרפֿירער.<verse eid="JOB 12:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 12:17" />ער מאַכט אומגײן די יוֹעצים באַנומענע,</para>
  <para style="q" vid="JOB 12:17">און די ריכטער באַנאַרישט ער.<verse eid="JOB 12:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 12:18" />די מוסר פֿון די מלכים מאַכט ער לױז,</para>
  <para style="q" vid="JOB 12:18">און אױף זײערע לענדן בינדט ער אַ שטריקגאַרטל.<verse eid="JOB 12:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 12:19" />ער מאַכט אומגײן די כּהנים באַנומענע,</para>
  <para style="q" vid="JOB 12:19">און די מאַכטיקע פֿאַרדרײט ער.<verse eid="JOB 12:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 12:20" />ער נעמט אָפּ דעם לשון בײַ די באַרעדעװדיקע,</para>
  <para style="q" vid="JOB 12:20">און דעם שׂכל פֿון די זקנים נעמט ער אַװעק.<verse eid="JOB 12:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 12:21" />ער גיסט פֿאַראַכטונג אױף פֿירשטן,</para>
  <para style="q" vid="JOB 12:21">און דעם אָנגורט פֿון די שטאַרקע מאַכט ער לױז.<verse eid="JOB 12:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 12:22" />ער אַנטפּלעקט טיפֿענישן פֿון דער פֿינצטער,</para>
  <para style="q" vid="JOB 12:22">און ברענגט אַרױס אין ליכט דעם שאָטן פֿון טױט.<verse eid="JOB 12:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 12:23" />ער דערהײכט די פֿעלקער, און ברענגט זײ אונטער,</para>
  <para style="q" vid="JOB 12:23">ער שפּרײט אױס די פֿעלקער, און פֿירט זײ אַװעק.<verse eid="JOB 12:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 12:24" />ער טוט אָפּ דעם שׂכל פֿון די הױפּטלײַט פֿון דעם פֿאָלק פֿון לאַנד,</para>
  <para style="q" vid="JOB 12:24">און מאַכט זײ בלאָנדזשען אין אַ װיסטעניש אָן אַ װעג.<verse eid="JOB 12:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 12:25" />זײ טאַפּן אין חושך אָן ליכט,</para>
  <para style="q" vid="JOB 12:25">און ער מאַכט זײ װאַקלען װי אַ שיכּער.<verse eid="JOB 12:25" /></para>
  <chapter eid="JOB 12" />
  <chapter number="13" style="c" pubnumber="יג" sid="JOB 13" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 13:1" />זע, אַלץ האָט געזען מײַן אױג,</para>
  <para style="q" vid="JOB 13:1">מײַן אױער האָט געהערט און זיך געמערקט.<verse eid="JOB 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 13:2" />װי איר װײסט, װײס איך אױך,</para>
  <para style="q" vid="JOB 13:2">איך פֿאַל נישט אַראָפּ קעגן אײַך.<verse eid="JOB 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 13:3" />אָבער איך װיל צום שַדַי רעדן,</para>
  <para style="q" vid="JOB 13:3">און טענהן צו אֵל װיל איך.<verse eid="JOB 13:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 13:4" />איר אָבער זײַט שמירער פֿון ליגן,</para>
  <para style="q" vid="JOB 13:4">נישטיקע רופֿאים זײַט איר אַלע.<verse eid="JOB 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 13:5" />הלװאַי װאָלט איר שװײַגן געשװיגן,</para>
  <para style="q" vid="JOB 13:5">װאָלט דאָס פֿון אײַך אַ חכמה געװען.<verse eid="JOB 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 13:6" />הערט אַקאָרשט מײַן טענה,</para>
  <para style="q" vid="JOB 13:6">און די קריג פֿון מײַנע ליפּן פֿאַרנעמט.<verse eid="JOB 13:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 13:7" />װילט איר פֿאַר אֵל רעדן אומרעכט,</para>
  <para style="q" vid="JOB 13:7">און פֿאַר אים רעדן באַטרוג?<verse eid="JOB 13:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 13:8" />װילט איר זײַן פּנים שאַנעװען,</para>
  <para style="q" vid="JOB 13:8">צי װילט איר פֿאַר אֵל זיך קריגן?<verse eid="JOB 13:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 13:9" />װעט גוט זײַן אַז ער װעט אײַך אױספֿאָרשן?</para>
  <para style="q" vid="JOB 13:9">צי װי מע נאַרט אַ מענטשן װעט איר אים אָפּנאַרן?<verse eid="JOB 13:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 13:10" />שטראָפֿן װעט ער אײַך שטראָפֿן,</para>
  <para style="q" vid="JOB 13:10">אױב איר װעט אין פֿאַרבאָרגעניש שאַנעװען.<verse eid="JOB 13:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 13:11" />פֿאַר װאָר, זײַן גרױסקײט װעט אײַך דערשרעקן,</para>
  <para style="q" vid="JOB 13:11">און זײַן פַּחד װעט פֿאַלן אױף אײַך.<verse eid="JOB 13:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 13:12" />אײַערע בײַשפּילן זײַנען געגליכן צו אַש,</para>
  <para style="q" vid="JOB 13:12">צו הױפֿנס לײם אײַערע רײד הױפֿנס.<verse eid="JOB 13:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JOB 13:13" />לאָזט מיך אָפּ, און איך װעל רעדן,</para>
  <para style="q" vid="JOB 13:13">און זאָל קומען אױף מיר װאָס װיל.<verse eid="JOB 13:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 13:14" />מעג זײַן װאָס, איך װעל נעמען מײַן פֿלײש אין מײַנע צײן,</para>
  <para style="q" vid="JOB 13:14">און מײַן לעבן װעל איך אײַנשטעלן אין מײַן האַנט.<verse eid="JOB 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 13:15" />אָט װעט ער מיך טײטן – איך ריכט זיך אױף אים –</para>
  <para style="q" vid="JOB 13:15">אָבער מײַנע װעגן װעל איך אױפֿװײַזן פֿאַר אים.<verse eid="JOB 13:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 13:16" />שױן דאָס װעט מיר זײַן אַ הילף,</para>
  <para style="q" vid="JOB 13:16">װאָס פֿאַר אים קען קײן פֿאַלשער נישט קומען.<verse eid="JOB 13:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 13:17" />הערן הערט צו מײַן װאָרט,</para>
  <para style="q" vid="JOB 13:17">און מײַן אַרױסזאָג מיט אײַערע אױערן.<verse eid="JOB 13:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 13:18" />אָט, איך בעט אײַך, לײג איך פֿאַר דעם משפּט;</para>
  <para style="q" vid="JOB 13:18">איך װײס אַז איך װעל זײַן גערעכט.<verse eid="JOB 13:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 13:19" />װער איז דער װאָס קען קריגן מיט מיר?</para>
  <para style="q" vid="JOB 13:19">װאָרעם דענצמאָל װאָלט איך שװײַגן און פֿאַרגײן.<verse eid="JOB 13:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="JOB 13:20" />נאָר צװײ זאַכן זאָלסטו נישט טאָן מיט מיר,</para>
  <para style="q" vid="JOB 13:20">דענצמאָל װעל איך פֿאַר דײַן פּנים זיך נישט פֿאַרבאָרגן:<verse eid="JOB 13:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 13:21" />דײַן האַנט דערװײַטער פֿון מיר,</para>
  <para style="q" vid="JOB 13:21">און דײַן אימה זאָל מיך נישט שרעקן.<verse eid="JOB 13:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 13:22" />און רוף, און איך װעל דיר ענטפֿערן,</para>
  <para style="q" vid="JOB 13:22">צי איך װעל רעדן, און ענטפֿער דו מיר.<verse eid="JOB 13:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 13:23" />װיפֿל האָב איך זינד און חטאָים?</para>
  <para style="q" vid="JOB 13:23">מײַן פֿאַרברעך און מײַן חטא לאָז מיך װיסן.<verse eid="JOB 13:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 13:24" />פֿאַר װאָס פֿאַרבאָרגסטו דײַן פּנים,</para>
  <para style="q" vid="JOB 13:24">און רעכנסט מיך פֿאַר אַ שׂונא צו דיר?<verse eid="JOB 13:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 13:25" />צי אַ געטריבן בלאַט װילסטו אײַנשרעקן,</para>
  <para style="q" vid="JOB 13:25">און אַ פֿאַרטריקנטן שטרױ װילסטו נאָכיאָגן?<verse eid="JOB 13:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 13:26" />װאָס דו שרײַבסט מיר אָן ביטערנישן,</para>
  <para style="q" vid="JOB 13:26">און מאַכסט מיך יַרשען די זינד פֿון מײַן יוגנט;<verse eid="JOB 13:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 13:27" />און טוסט אַרײַן אין אַ קלאָץ מײַנע פֿיס,</para>
  <para style="q" vid="JOB 13:27">און היטסט אַלע מײַנע שטעגן;</para>
  <para style="q" vid="JOB 13:27">אַרום מײַנע פֿוסטריט גריבלסטו זיך.<verse eid="JOB 13:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 13:28" />און איך בין װי אַ לאָגל װאָס צעקריכט,</para>
  <para style="q" vid="JOB 13:28">װי אַ בגד װאָס מאָיל האָט אים צעפֿרעסן.<verse eid="JOB 13:28" /></para>
  <chapter eid="JOB 13" />
  <chapter number="14" style="c" pubnumber="יד" sid="JOB 14" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 14:1" />דער מענטש, געבאָרן פֿון אַ פֿרױ,</para>
  <para style="q" vid="JOB 14:1">האָט קורצע טעג און זאַט פֿאַרדראָס.<verse eid="JOB 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 14:2" />װי אַ בלום קומט ער אַרױס און װערט פֿאַרשניטן,</para>
  <para style="q" vid="JOB 14:2">און ער אַנטלױפֿט װי אַ שאָטן און באַשטײט נישט.<verse eid="JOB 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 14:3" />און אױף אַזעלכן האַלטסטו אָפֿן דײַנע אױגן?</para>
  <para style="q" vid="JOB 14:3">און מיך װילסטו ברענגען צום משפּט מיט דיר?<verse eid="JOB 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 14:4" />װער קען מאַכן רײן פֿון אומרײן?</para>
  <para style="q" vid="JOB 14:4">קײן אײנער נישט.<verse eid="JOB 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 14:5" />אױב זײַנע טעג זײַנען צוגעשניטן,</para>
  <para style="q" vid="JOB 14:5">די צאָל פֿון זײַנע חדשים איז בײַ דיר,</para>
  <para style="q" vid="JOB 14:5">גרענעצן האָסטו אים געמאַכט װאָס ער קען נישט אַריבער,<verse eid="JOB 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 14:6" />קער זיך אָפּ פֿון אים, כּדי ער זאָל האָבן רו,</para>
  <para style="q" vid="JOB 14:6">ביז ער װעט דערפֿילן װי אַ געדונגענער זײַן טאָג.<verse eid="JOB 14:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="JOB 14:7" />װאָרעם פֿאַר אַ בױם איז דאָ אַ האָפֿענונג;</para>
  <para style="q" vid="JOB 14:7">אַז ער װערט אָפּגעשניטן, באַנײַט ער זיך װידער,</para>
  <para style="q" vid="JOB 14:7">און זײַן שפּראָץ הערט נישט אױף.<verse eid="JOB 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 14:8" />אַז אַלט אין דער ערד װערט זײַן װאָרצל,</para>
  <para style="q" vid="JOB 14:8">און אין שטױב שטאַרבט אָפּ זײַן שטאַם,<verse eid="JOB 14:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 14:9" />פֿון רֵיח פֿון װאַסער בליט ער אױף,</para>
  <para style="q" vid="JOB 14:9">און לאָזט ריטלעך אַרױס װי אַ פֿלאַנצונג.<verse eid="JOB 14:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 14:10" />אָבער אַ מאַן שטאַרבט און פֿאַלט אַװעק,</para>
  <para style="q" vid="JOB 14:10">און פֿאַרגאַנגען דער מענטש, און װוּ איז ער?<verse eid="JOB 14:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 14:11" />װאַסערן גײען אַװעק פֿון ים,</para>
  <para style="q" vid="JOB 14:11">און אַ טײַך װערט אױסגעטריקנט און טרוקן;<verse eid="JOB 14:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 14:12" />און דער מענטש לײגט זיך און שטײט נישט אױף;</para>
  <para style="q" vid="JOB 14:12">ביז קײן הימל װעט נישט זײַן װעלן זײ זיך נישט אױפֿכאַפּן,</para>
  <para style="q" vid="JOB 14:12">און נישט אױפֿװאַכן פֿון זײער שלאָף.<verse eid="JOB 14:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 14:13" />װען דו װאָלסט מיך אין שְׁאֹול באַהאַלטן,</para>
  <para style="q" vid="JOB 14:13">מיך פֿאַרבאָרגן ביז דײַן צאָרן װעט אָפּגײן,</para>
  <para style="q" vid="JOB 14:13">מיר שטעלן אַ צײַט, און זיך דערמאָנען אָן מיר! –<verse eid="JOB 14:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 14:14" />אַז אַ מענטש שטאַרבט, װעט ער דען לעבעדיק װערן? –</para>
  <para style="q" vid="JOB 14:14">אַלע טעג פֿון מײַן דינסטצײַט װאָלט איך געהאַרט</para>
  <para style="q" vid="JOB 14:14">ביז מײַן אױסבײַט װעט קומען.<verse eid="JOB 14:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 14:15" />װאָלסט גערופֿן, און איך װאָלט דיר געענטפֿערט,</para>
  <para style="q" vid="JOB 14:15">װען דו װאָלסט געגלוסט צו דעם װערק פֿון דײַנע הענט.<verse eid="JOB 14:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 14:16" />אָבער אַצונד צײלסטו מײַנע טריט,</para>
  <para style="q" vid="JOB 14:16">װאַרטסט צו מאָל נישט אױף מײַן חטא.<verse eid="JOB 14:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 14:17" />פֿאַרחתמעט אין אַ בײַטל איז מײַן פֿאַרברעך,</para>
  <para style="q" vid="JOB 14:17">און דו לײגסט נאָך צו צו מײַן זינד.<verse eid="JOB 14:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 14:18" />יאָ פֿאַר װאָר, אַ געפֿאַלענער באַרג צעברעקלט זיך,</para>
  <para style="q" vid="JOB 14:18">און אַ פֿעלדז װערט פֿאַררוקט פֿון זײַן אָרט;<verse eid="JOB 14:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 14:19" />װאַסער צערײַבט שטײנער,</para>
  <para style="q" vid="JOB 14:19">אירע פֿלײצונגען שװענקען אַװעק דעם שטױב פֿון דער ערד;</para>
  <para style="q" vid="JOB 14:19">אַזױ ברענגסטו אונטער די האָפֿענונג פֿון דעם מענטשן.<verse eid="JOB 14:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 14:20" />שטאַרקסט אים אײביק איבער, און ער פֿאַרגײט,</para>
  <para style="q" vid="JOB 14:20">פֿאַרענדערסט זײַן פּנים, און שיקסט אים אַװעק.<verse eid="JOB 14:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 14:21" />זײַנע קינדער האָבן כּבֿוד, און ער װײס נישט,</para>
  <para style="q" vid="JOB 14:21">און זײ װערן צו קלײן, און ער מערקט זײ נישט.<verse eid="JOB 14:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 14:22" />נאָר זײַן פֿלײש װײטאָקט אױף אים,</para>
  <para style="q" vid="JOB 14:22">און זײַן זעל טרױערט אױף אים.<verse eid="JOB 14:22" /></para>
  <chapter eid="JOB 14" />
  <chapter number="15" style="c" pubnumber="טו" sid="JOB 15" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 15:1" />האָט געענטפֿערט אֶליפַֿז דער תֵּימָני, און האָט געזאָגט:<verse eid="JOB 15:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 15:2" />װעט אַ חכם ענטפֿערן מיט קענשאַפֿט פֿון לופֿט,</para>
  <para style="q" vid="JOB 15:2">און אָנפֿילן מיט מזרח-װינט זײַן בױך?<verse eid="JOB 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 15:3" />טענהן רײד װאָס טױגן נישט,</para>
  <para style="q" vid="JOB 15:3">און װערטער װאָס מע ברענגט קײן נוץ נישט מיט זײ?<verse eid="JOB 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 15:4" />אױך פֿאַרשטערסטו די יִרְאַת,</para>
  <para style="q" vid="JOB 15:4">און מינערסט די פֿרומקײט פֿאַר אֵל.<verse eid="JOB 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 15:5" />װאָרעם דײַן זינד לערנט דײַן מױל,</para>
  <para style="q" vid="JOB 15:5">און קלײַבסט אױס די צונג פֿון די ליסטיקע.<verse eid="JOB 15:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 15:6" />דײַן אײגן מױל מאַכט דיך שולדיק, און נישט איך,</para>
  <para style="q" vid="JOB 15:6">און דײַנע ליפּן זאָגן עדות קעגן דיר.<verse eid="JOB 15:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="JOB 15:7" />ביסטו דער ערשטער מענטש געבאָרן געװאָרן?</para>
  <para style="q" vid="JOB 15:7">אָדער ביסטו פֿאַר די בערג באַשאַפֿן געװאָרן?<verse eid="JOB 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 15:8" />האָסטו דעם סָוד פֿון אֱלוֹהַּ אײַנגעהערט,</para>
  <para style="q" vid="JOB 15:8">און אַװעקגענומען צו זיך די חכמה?<verse eid="JOB 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 15:9" />װאָס אַזױנס װײסטו, װאָס מיר װײסן נישט?</para>
  <para style="q" vid="JOB 15:9">פֿאַרשטײסטו, װאָס בײַ אונדז איז נישטאָ?<verse eid="JOB 15:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 15:10" />אי אַ גראָער קאָפּ אי אַ גרײַז איז דאָ צװישן אונדז,</para>
  <para style="q" vid="JOB 15:10">עלטער פֿון דײַן פֿאָטער אין טעג.<verse eid="JOB 15:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 15:11" />זײַנען דיר װינציק די טרײסטונגען פֿון אֵל,</para>
  <para style="q" vid="JOB 15:11">און דאָס װאָרט װאָס איז מילד צו דיר?<verse eid="JOB 15:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 15:12" />װאָס נעמט דיך דײַן האַרץ,</para>
  <para style="q" vid="JOB 15:12">און װאָס װינקען דײַנע אױגן,<verse eid="JOB 15:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 15:13" />אַז דו קערסט קעגן אֵל דײַן גײַסט,</para>
  <para style="q" vid="JOB 15:13">און לאָזט אַרױס רײד פֿון דײַן מױל?<verse eid="JOB 15:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 15:14" />װאָס איז אַ מענטש, אַז ער זאָל זײַן רײן?</para>
  <para style="q" vid="JOB 15:14">און קען דען גערעכט זײַן אַ געבאָרענער פֿון אַ פֿרױ?<verse eid="JOB 15:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 15:15" />זע, אין זײַנע הײליקע גלױבט ער נישט,</para>
  <para style="q" vid="JOB 15:15">און די הימלען זײַנען נישט רײן אין זײַנע אױגן,<verse eid="JOB 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 15:16" />הײַנט װי שױן דער אומװערדיקער און פֿאַרדאָרבענער,</para>
  <para style="q" vid="JOB 15:16">דער מענטש, װאָס טרינקט אומרעכט װי װאַסער?<verse eid="JOB 15:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="JOB 15:17" />איך װעל דיר באַשײדן, הער מיר צו,</para>
  <para style="q" vid="JOB 15:17">און װאָס איך האָב געזען װעל איך דערצײלן;<verse eid="JOB 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 15:18" />װאָס די חכמים גיבן איבער –</para>
  <para style="q" vid="JOB 15:18">און פֿאַרהױלן נישט – פֿון זײערע עלטערן,<verse eid="JOB 15:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 15:19" />װאָס צו זײ אַלײן איז געגעבן געװאָרן דאָס לאַנד,</para>
  <para style="q" vid="JOB 15:19">און קײן פֿרעמדער איז נישט דורכגעגאַנגען צװישן זײ.<verse eid="JOB 15:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 15:20" />אַלע זײַנע טעג איז אין ציטערניש דער רשע,</para>
  <para style="q" vid="JOB 15:20">און געצײלטע יאָרן זײַנען אָנגעברײט דעם געװאַלטטוער.<verse eid="JOB 15:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 15:21" />אַ קֹול פֿון אַנגסטן איז אין זײַנע אױערן:</para>
  <para style="q" vid="JOB 15:21">אין מיטן שלום װעט קומען אַ פֿאַרװיסטער אױף אים.<verse eid="JOB 15:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 15:22" />ער גלױבט נישט זיך אױסצודרײען פֿון פֿינצטערניש,</para>
  <para style="q" vid="JOB 15:22">און ער איז אױסגעקליבן פֿאַרן שװערד.<verse eid="JOB 15:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 15:23" />ער װאָגלט אום נאָך ברױט: װוּ איז עס?</para>
  <para style="q" vid="JOB 15:23">ער װײס אַז לעבן אים איז אָנגעברײט דער טאָג פֿון פֿינצטערניש.<verse eid="JOB 15:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 15:24" />אים שרעקן אַנגסט און דריקעניש,</para>
  <para style="q" vid="JOB 15:24">זײ כאַפּן אים אָן װי אַ מלך אָנגעברײט צום קריג.<verse eid="JOB 15:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 15:25" />װײַל ער האָט אױסגעשטרעקט קעגן אֵל זײַן האַנט,</para>
  <para style="q" vid="JOB 15:25">און קעגן שַדַי זיך געשטאַרקט;<verse eid="JOB 15:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 15:26" />געלאָפֿן קעגן אים מיט אַ שטאָלצן האַלדז,</para>
  <para style="q" vid="JOB 15:26">מיט די דיקע רוקנס פֿון זײַנע שילדן.<verse eid="JOB 15:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 15:27" />װײַל ער האָט באַדעקט זײַן פּנים מיט זײַן פֿעטס,</para>
  <para style="q" vid="JOB 15:27">און אָנגעלײגט פּלאָסטן אױפֿן לענד;<verse eid="JOB 15:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 15:28" />און ער האָט באַװױנט פֿאַרװיסטע שטעט,</para>
  <para style="q" vid="JOB 15:28">הײַזער װאָס מע זיצט נישט אין זײ,</para>
  <para style="q" vid="JOB 15:28">װאָס זײַנען געװען אָנגעברײט אױף הױפֿנס.<verse eid="JOB 15:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 15:29" />ער װעט נישט רײַך זײַן, און נישט באַשטײן װעט זײַן פֿאַרמעג,</para>
  <para style="q" vid="JOB 15:29">און נישט נײַגן װעט זיך צו דער ערד זײער תּבֿואה.<verse eid="JOB 15:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 15:30" />ער װעט זיך נישט אָפּטאָן פֿון פֿינצטערניש;</para>
  <para style="q" vid="JOB 15:30">זײַן שפּראָץ װעט פֿאַרטריקענען אַ פֿלאַם,<verse eid="JOB 15:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 15:31" />און ער װעט אָפּגעטאָן װערן דורך אַ הױך פֿון זײַן מױל.</para>
  <para style="q" vid="JOB 15:31">זאָל נישט טרױען אױף נישט דער פֿאַרנאַרטער,</para>
  <para style="q" vid="JOB 15:31">װאָרעם נישט װעט זײַן זײַן אײַנבײַט.<verse eid="JOB 15:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 15:32" />אײדער זײַן טאָג קומט, װעט עס דערפֿילט װערן,</para>
  <para style="q" vid="JOB 15:32">און זײַן צװײַג װעט נישט גרין זײַן.<verse eid="JOB 15:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 15:33" />ער װעט אָפּשאָקלען װי אַ װײַנשטאָק זײַן אומצײַטיקס,</para>
  <para style="q" vid="JOB 15:33">און אַראָפּװאַרפֿן װי אַן אײלבערטבױם זײַן בליִונג.<verse eid="JOB 15:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 15:34" />װאָרעם דאָס געזעמל פֿון די זינדיקע בלײַבט װיסט,</para>
  <para style="q" vid="JOB 15:34">און אַ פֿײַער פֿאַרצערט די געצעלטן פֿון שוחד.<verse eid="JOB 15:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 15:35" />זײ טראָגן אומרעכט און געבערן אומגליק,</para>
  <para style="q" vid="JOB 15:35">און זײער לײַב ברײט אָן פֿאַר זיך אָפּנאַרונג.<verse eid="JOB 15:35" /></para>
  <chapter eid="JOB 15" />
  <chapter number="16" style="c" pubnumber="טז" sid="JOB 16" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 16:1" />האָט געענטפֿערט אִיובֿ, און האָט געזאָגט:<verse eid="JOB 16:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 16:2" />איך האָב געהערט פֿיל אַזױנס;</para>
  <para style="q" vid="JOB 16:2">צרהדיקע טרײסטער זײַט איר אַלע.<verse eid="JOB 16:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 16:3" />װעט זײַן אַ סוף צו די װינטיקע רײד?</para>
  <para style="q" vid="JOB 16:3">אָדער װאָס שפּאַרט דיך אַז דו זאָלסט ענטפֿערן?<verse eid="JOB 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 16:4" />איך װאָלט אױך געקענט רעדן װי איר</para>
  <para style="q" vid="JOB 16:4">אַז איר װאָלט געװען אױף מײַן אָרט;</para>
  <para style="q" vid="JOB 16:4">איך װאָלט געקניפּט װערטער אױף אײַך,</para>
  <para style="q" vid="JOB 16:4">און געשאָקלט אױף אײַך מײַן קאָפּ.<verse eid="JOB 16:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 16:5" />איך װאָלט אײַך געשטאַרקט מיט מײַן מױל,</para>
  <para style="q" vid="JOB 16:5">און דער באַדױער פֿון מײַנע ליפּן װאָלט אײַך געלינדערט.<verse eid="JOB 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 16:6" />אַז סײַ איך רעד, װערט נישט געמינערט מײַן װײטאָג,</para>
  <para style="q" vid="JOB 16:6">און סײַ איך הער אױף, גײט ער פֿון מיר נישט אַװעק;<verse eid="JOB 16:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 16:7" />פֿאַר װאָר, אַצונד האָט ער מיך פֿאַרמאַטערט;</para>
  <para style="q" vid="JOB 16:7">האָסט צעגרױלט מײַן גאַנצע געזעלנשאַפֿט.<verse eid="JOB 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 16:8" />און האָסט מיך צעקנײטשט –</para>
  <para style="q" vid="JOB 16:8">צום עדות איז עס געװאָרן;</para>
  <para style="q" vid="JOB 16:8">און מײַן מאָגערקײט שטײט אױף קעגן מיר,</para>
  <para style="q" vid="JOB 16:8">מיר אין פּנים קלאָגט זי אָן.<verse eid="JOB 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 16:9" />זײַן צאָרן האָט פֿאַרצוקט מיט פֿײַנטשאַפֿט,</para>
  <para style="q" vid="JOB 16:9">ער האָט געקריצט אױף מיר מיט זײַנע צײן;</para>
  <para style="q" vid="JOB 16:9">מײַן שׂונא שלײַפֿט זײַנע אױגן אױף מיר.<verse eid="JOB 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 16:10" />מע שפּאַרט אױף דאָס מױל אױף מיר,</para>
  <para style="q" vid="JOB 16:10">מיט שאַנד פּאַטשט מען מײַנע באַקן;</para>
  <para style="q" vid="JOB 16:10">אין אײנעם קלײַבן זײ זיך אױף מיר.<verse eid="JOB 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 16:11" />אֵל ענטפֿערט מיך איבער צום פֿאַרברעכער,</para>
  <para style="q" vid="JOB 16:11">און אין די הענט פֿון רשעים װאַרפֿט ער מיך.<verse eid="JOB 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 16:12" />רויִק בין איך געװען, און ער האָט מיך צעברעקלט,</para>
  <para style="q" vid="JOB 16:12">און מיך אָנגענומען בײַם געניק, און מיך צעפּיצלט;</para>
  <para style="q" vid="JOB 16:12">און ער האָט מיך אױפֿגעשטעלט פֿאַר זײַן צילברעט.<verse eid="JOB 16:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 16:13" />מיך רינגלען אַרום זײַנע שיסער,</para>
  <para style="q" vid="JOB 16:13">ער שפּאַלט מײַנע נירן, און דערבאַרעמט נישט,</para>
  <para style="q" vid="JOB 16:13">ער גיסט אױס צו דער ערד מײַן גאַל.<verse eid="JOB 16:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 16:14" />ער צעברעכט מיך אַ בראָך אױף אַ בראָך,</para>
  <para style="q" vid="JOB 16:14">ער לױפֿט קעגן מיר װי אַ קריגסמאַן.<verse eid="JOB 16:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 16:15" />זאַק האָב איך אױפֿגענײט אױף מײַן הױט,</para>
  <para style="q" vid="JOB 16:15">און געװעלגערט אין אַש מײַן האָרן.<verse eid="JOB 16:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 16:16" />מײַן פּנים איז רױט פֿון געװײן,</para>
  <para style="q" vid="JOB 16:16">און אױף מײַנע ברעמען איז שאָטן פֿון טױט,<verse eid="JOB 16:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 16:17" />פֿאַר קײן אומרעכט, נישט אין מײַנע הענט,</para>
  <para style="q" vid="JOB 16:17">בעת מײַן תּפֿילה איז רײן.<verse eid="JOB 16:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 16:18" />ערד, זאָלסט נישט צודעקן מײַן בלוט,</para>
  <para style="q" vid="JOB 16:18">און זאָל נישט קײן אָרט זײַן פֿאַר מײַן געשרײ!<verse eid="JOB 16:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 16:19" />אַפֿילו איצט אָט איז אין הימל מײַן עדות-זאָגער,</para>
  <para style="q" vid="JOB 16:19">און מײַן מליץ איז אױך אין דער הײך.<verse eid="JOB 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 16:20" />מײַנע פֿירשפּעכערס זענען מײַנע שפּעטערס;</para>
  <para style="q" vid="JOB 16:20">צו אֱלוֹהַּ טוט טריפֿן מײַן אױג,<verse eid="JOB 16:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 16:21" />הלװאַי אַז ער זאָל משפּטן צװישן אַ מאַן מיט אֱלוֹהַּ,</para>
  <para style="q" vid="JOB 16:21">װי צװישן אַ מענטשנקינד און זײַן חבֿר.<verse eid="JOB 16:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 16:22" />װאָרעם די געצײלטע יאָרן גײען,</para>
  <para style="q" vid="JOB 16:22">און איך װעל אַװעק אױף אַ װעג פֿון װאַנען איך װעל זיך נישט אומקערן.<verse eid="JOB 16:22" /></para>
  <chapter eid="JOB 16" />
  <chapter number="17" style="c" pubnumber="יז" sid="JOB 17" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 17:1" />מײַן גײַסט איז צעװײטאָקט,</para>
  <para style="q" vid="JOB 17:1">מײַנע טעג זײַנען פֿאַרלאָשן,</para>
  <para style="q" vid="JOB 17:1">דער קבֿר איז פֿאַר מיר.<verse eid="JOB 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 17:2" />פֿאַר װאָר, שפּעטער זײַנען מיט מיר,</para>
  <para style="q" vid="JOB 17:2">און אױף זײער ערגערן מוז רוען מײַן אױג.<verse eid="JOB 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 17:3" />קער זיך צו, איך בעט דיך,</para>
  <para style="q" vid="JOB 17:3">זײַ עָרבֿ פֿאַר מיר בײַ דיר אַלײן;</para>
  <para style="q" vid="JOB 17:3">װער דען זאָל מיר אַ האַנטשלאָג געבן?<verse eid="JOB 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 17:4" />װאָרעם זײער האַרץ האָסטו פֿאַרבאָרגן פֿון שׂכל,</para>
  <para style="q" vid="JOB 17:4">צום ריכטיקן טוסטו זײ נישט דערהײבן.<verse eid="JOB 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 17:5" />דער װאָס מסרט פֿון חֵלֶק װעגן חבֿרים,</para>
  <para style="q" vid="JOB 17:5">אַזש אױסגײן זאָלן די אױגן פֿון זײַנע קינדער!<verse eid="JOB 17:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="JOB 17:6" />יאָ, ער האָט מיך געשטעלט פֿאַר אַ װערטל בײַ לײַט,</para>
  <para style="q" vid="JOB 17:6">און צו שפּײַען אין פּנים בין איך געװאָרן.<verse eid="JOB 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 17:7" />און טונקל פֿון ערגערניש איז מײַן אױג,</para>
  <para style="q" vid="JOB 17:7">און מײַנע גלידער זײַנען װי אַ שאָטן אַלע.<verse eid="JOB 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 17:8" />די רעכטפֿאַרטיקע װערן צעגרױלט דעריבער,</para>
  <para style="q" vid="JOB 17:8">און דער אומשולדיקער װערט אױפֿן זינדיקן אױפֿגעבראַכט.<verse eid="JOB 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 17:9" />און דער גערעכטער זאָל אָנהאַלטן זײַן װעג,</para>
  <para style="q" vid="JOB 17:9">און דער װאָס האָט רײנע הענט זאָל מערן שטאַרקײט!<verse eid="JOB 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 17:10" />איר אַלע אָבער קומט אַקאָרשט װידער אַהער,</para>
  <para style="q" vid="JOB 17:10">און איך װעל נישט געפֿינען אַ קלוגן צװישן אײַך.<verse eid="JOB 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 17:11" />מײַנע טעג זײַנען פֿאַרגאַנגען,</para>
  <para style="q" vid="JOB 17:11">מײַנע געדאַנקען זײַנען צעריסן –</para>
  <para style="q" vid="JOB 17:11">די טראַכטענישן פֿון מײַן האַרצן.<verse eid="JOB 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 17:12" />נאַכט פֿאַר טאָג מאַכן זײ:</para>
  <para style="q" vid="JOB 17:12">נאָנט איז דאָס ליכט װײַל עס איז פֿינצטער.<verse eid="JOB 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 17:13" />אַז איך ריכט זיך אױף דער שְׁאֹול װי מײַן הײם,</para>
  <para style="q" vid="JOB 17:13">אין פֿינצטערניש בעט איך אױס מײַן געלעגער,<verse eid="JOB 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 17:14" />צום קבֿר רוף איך: ביסט מײַן פֿאָטער!</para>
  <para style="q" vid="JOB 17:14">מײַן מוטער און מײַן שװעסטער צום װאָרעם,<verse eid="JOB 17:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 17:15" />הײַנט װוּ דען איז מײַן האָפֿענונג?</para>
  <para style="q" vid="JOB 17:15">יאָ, מײַן האָפֿענונג װער װעט זי אָנזען?<verse eid="JOB 17:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 17:16" />צו די ריגלען פֿון שְׁאֹול װעט זי נידערן,</para>
  <para style="q" vid="JOB 17:16">װען אין אײנעם אין שטױב װעלן מיר רוען.<verse eid="JOB 17:16" /></para>
  <chapter eid="JOB 17" />
  <chapter number="18" style="c" pubnumber="יח" sid="JOB 18" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 18:1" />האָט געענטפֿערט בִלדַד דער שוחי, און האָט געזאָגט:<verse eid="JOB 18:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 18:2" />ביז װאַנען װעט איר מאַכן געיעגן אױף װערטער?</para>
  <para style="q" vid="JOB 18:2">באַטראַכט, און דערנאָך װעלן מיר רעדן.<verse eid="JOB 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 18:3" />פֿאַר װאָס װערן מיר גערעכנט װי בהמות,</para>
  <para style="q" vid="JOB 18:3">געהאַלטן פֿאַר פֿאַרשטאָפּט אין אײַערע אױגן?<verse eid="JOB 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 18:4" />דו װאָס פֿאַרצוקסט זיך אַלײן אין דײַן צאָרן,</para>
  <para style="q" vid="JOB 18:4">זאָל פֿון דײַנעט װעגן פֿאַרלאָזט װערן די ערד,</para>
  <para style="q" vid="JOB 18:4">און אַ פֿעלדז אַװעקגערוקט װערן פֿון זײַן אָרט?<verse eid="JOB 18:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="JOB 18:5" />יאָ, דאָס ליכט פֿון די רשעים װעט פֿאַרלאָשן װערן,</para>
  <para style="q" vid="JOB 18:5">און נישט שײַנען װעט דער פֿונק פֿון זײַן פֿײַער.<verse eid="JOB 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 18:6" />די ליכטיקײט װעט פֿינצטער װערן אין זײַן געצעלט,</para>
  <para style="q" vid="JOB 18:6">און זײַן ליכט װעט פֿאַרלאָשן װערן איבער אים.<verse eid="JOB 18:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 18:7" />די שפּרײַזן פֿון זײַן מאַכט װעלן געענגט װערן,</para>
  <para style="q" vid="JOB 18:7">און אים װעט אַנידערװאַרפֿן זײַן אײגענע עצה.<verse eid="JOB 18:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 18:8" />װאָרעם ער װערט געטריבן פֿון זײַנע פֿיס אין דער נעץ,</para>
  <para style="q" vid="JOB 18:8">און אױף אַ פּאַסטקע גײט ער אום.<verse eid="JOB 18:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 18:9" />כאַפּן פֿאַרן טריט װעט אַ פֿאַנגנעץ,</para>
  <para style="q" vid="JOB 18:9">פֿעסט װעט אים האַלטן דער קנופּ.<verse eid="JOB 18:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 18:10" />באַהאַלטן אין דער ערד איז אַ שטריק פֿאַר אים,</para>
  <para style="q" vid="JOB 18:10">און אַ כאַפּשטײַג פֿאַר אים איז אױפֿן שטעג.<verse eid="JOB 18:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 18:11" />רונד אַרום גרױלן אים שרעקענישן,</para>
  <para style="q" vid="JOB 18:11">און זײ יאָגן אים אױף זײַנע טריט.<verse eid="JOB 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 18:12" />הונגעריק װעט זײַן זײַן אומגליק,</para>
  <para style="q" vid="JOB 18:12">און דער בראָך איז אָנגעברײט בײַ זײַן זײַט.<verse eid="JOB 18:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 18:13" />אױפֿעסן װעט די גלידער פֿון זײַן לײַב,</para>
  <para style="q" vid="JOB 18:13">אױפֿעסן װעט זײַנע גלידער דער בכוֹר פֿון טױט.<verse eid="JOB 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 18:14" />אױסגעריסן װעט װערן פֿון זײַן געצעלט זײַן פֿאַרזיכערונג,</para>
  <para style="q" vid="JOB 18:14">און עס װעט אים מאַכן שפּרײַזן צו דעם מלך פֿון שרעקעניש.<verse eid="JOB 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 18:15" />רוען װעט אין זײַן געצעלט נישט זײַן האָב;</para>
  <para style="q" vid="JOB 18:15">אױף זײַן װױנונג װעט אױסגעשפּרײט װערן שװעבל.<verse eid="JOB 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 18:16" />פֿון אונטן װעלן טריקענען זײַנע װאָרצלען,</para>
  <para style="q" vid="JOB 18:16">און פֿון אױבן װעט פֿאַרװעלקט װערן זײַן צװײַג.<verse eid="JOB 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 18:17" />זײַן זָכר גײט אונטער פֿון דער ערד,</para>
  <para style="q" vid="JOB 18:17">און ער האָט נישט קײן נאָמען דערױסן.<verse eid="JOB 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 18:18" />מע װעט אים שטױסן פֿון ליכט אין פֿינצטערניש</para>
  <para style="q" vid="JOB 18:18">און פֿון דער װעלט װעט מען אים פֿאַרװאָגלען.<verse eid="JOB 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 18:19" />ער האָט נישט קײן קינד און קײן אײניקל צװישן זײַן פֿאָלק,</para>
  <para style="q" vid="JOB 18:19">און קײן איבערבלײַב אין זײַנע װױנונגען.<verse eid="JOB 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 18:20" />איבער זײַן שטראָפֿטאָג װערן צעגרױלט די שפּעטערדיקע,</para>
  <para style="q" vid="JOB 18:20">און די פֿריִערדיקע נעמט אָן אַ שױדער.<verse eid="JOB 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 18:21" />יאָ, דאָס זײַנען די װױנונגען פֿון דעם פֿאַרברעכער,</para>
  <para style="q" vid="JOB 18:21">און דאָס איז דער אָרט פֿון דעם װאָס װײס נישט פֿון אֵל.<verse eid="JOB 18:21" /></para>
  <chapter eid="JOB 18" />
  <chapter number="19" style="c" pubnumber="יט" sid="JOB 19" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 19:1" />האָט געענטפֿערט אִיובֿ, און האָט געזאָגט:<verse eid="JOB 19:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 19:2" />ביז װאַנען װעט איר באַטריבן מײַן זעל,</para>
  <para style="q" vid="JOB 19:2">און מיך צעדריקן מיט װערטער?<verse eid="JOB 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 19:3" />שױן צען מאָל אַז איר באַלײדיקט מיך,</para>
  <para style="q" vid="JOB 19:3">איר שעמט אײַך נישט מיך צו פּײַניקן.<verse eid="JOB 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 19:4" />און אַז איך האָב שױן יאָ פֿאַרזען,</para>
  <para style="q" vid="JOB 19:4">װעט בײַ מיר דאָך בלײַבן מײַן פֿאַרזע.<verse eid="JOB 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 19:5" />אױב איר װילט אין דער אמת זיך גרײסן קעגן מיר,</para>
  <para style="q" vid="JOB 19:5">און מיר פֿאָרװאַרפֿן מײַן שאַנד,<verse eid="JOB 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 19:6" />טאָ װײסט אַז אֱלוֹהַּ האָט מיך געקריװדעט,</para>
  <para style="q" vid="JOB 19:6">און זײַן נעץ אַרומגעלײגט אַרום מיר.<verse eid="JOB 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 19:7" />אָט שרײַ איך געװאַלט, און װער נישט געענטפֿערט,</para>
  <para style="q" vid="JOB 19:7">איך רוף, און נישטאָ קײן גערעכטיקײט.<verse eid="JOB 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 19:8" />מײַן װעג האָט ער פֿאַרצאַמט, אַז איך קען נישט דורכגײן,</para>
  <para style="q" vid="JOB 19:8">און אױף מײַנע שטעגן האָט ער אַ פֿינצטערניש אַרױפֿגעטאָן.<verse eid="JOB 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 19:9" />מײַן כּבֿוד האָט ער אױסגעטאָן פֿון מיר,</para>
  <para style="q" vid="JOB 19:9">און אַראָפּגענומען די קרױן פֿון מײַן קאָפּ.<verse eid="JOB 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 19:10" />ער צעשטױסט מיך רונד אַרום, אַז איך פֿאַרגײ,</para>
  <para style="q" vid="JOB 19:10">און ער האָט אױסגעריסן װי אַ בױם מײַן האָפֿענונג.<verse eid="JOB 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 19:11" />און ער האָט אָנגעצונדן זײַן צאָרן אױף מיר,</para>
  <para style="q" vid="JOB 19:11">און ער רעכנט מיך פֿאַר זײַנעם אַ שׂונא.<verse eid="JOB 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 19:12" />אין אײנעם קומען אױף מיר זײַנע מחנות,</para>
  <para style="q" vid="JOB 19:12">און זײ טרעטן אױס זײער װעג קעגן מיר,</para>
  <para style="q" vid="JOB 19:12">און זײ לאַגערן אַרום מײַן געצעלט.<verse eid="JOB 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 19:13" />מײַנע ברידער האָט ער דערװײַטערט פֿון מיר,</para>
  <para style="q" vid="JOB 19:13">און מײַנע באַקענטע זײַנען אין גאַנצן פֿאַרפֿרעמדט פֿון מיר.<verse eid="JOB 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 19:14" />מײַנע קרובֿים האַלטן זיך צוריק,</para>
  <para style="q" vid="JOB 19:14">און מײַנע גוטע פֿרײַנט האָבן מיך פֿאַרגעסן.<verse eid="JOB 19:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 19:15" />מײַנע הױזװױנער און מײַנע דינסטן רעכענען מיך פֿאַר אַ פֿרעמדן,</para>
  <para style="q" vid="JOB 19:15">אַן אומבאַקענטער בין איך געװאָרן אין זײערע אױגן.<verse eid="JOB 19:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 19:16" />איך רוף מײַן קנעכט, און ער ענטפֿערט נישט,</para>
  <para style="q" vid="JOB 19:16">איך בעט זיך בײַ אים מיטן מױל.<verse eid="JOB 19:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 19:17" />מײַן אָטעם איז צוּװידער מײַן װײַב,</para>
  <para style="q" vid="JOB 19:17">און איך פֿאַרעקל מײַן ברידער.<verse eid="JOB 19:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 19:18" />אַפֿילו ייִנגלעך פֿאַראַכטן מיך,</para>
  <para style="q" vid="JOB 19:18">איך שטעל זיך, און זײ רעדן מיר אַקעגן.<verse eid="JOB 19:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 19:19" />מיך פֿאַראומװערדיקן אַלע מײַנע פֿאַרטרױטע,</para>
  <para style="q" vid="JOB 19:19">און די װאָס איך האָב ליב, קערן זיך קעגן מיר.<verse eid="JOB 19:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 19:20" />צו מײַן הױט און צו מײַן פֿלײש</para>
  <para style="q" vid="JOB 19:20">איז צוגעקלעפּט מײַן געבײן,</para>
  <para style="q" vid="JOB 19:20">און איך בין אַרױס מיט די יאַסלעס פֿון מײַנע צײן.<verse eid="JOB 19:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 19:21" />דערבאַרעמט אײַך אױף מיר,</para>
  <para style="q" vid="JOB 19:21">דערבאַרעמט אײַך אױף מיר, איר חבֿרים מײַנע,</para>
  <para style="q" vid="JOB 19:21">װאָרעם די האַנט פֿון אֱלוֹהַּ האָט מיך געטראָפֿן.<verse eid="JOB 19:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 19:22" />פֿאַר װאָס רודפֿט איר מיך אַזױ װי אֵל,</para>
  <para style="q" vid="JOB 19:22">און קענט זיך נישט אָנזעטן מיט מײַן פֿלײש?<verse eid="JOB 19:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 19:23" />הלװאַי װערן נאָר אױפֿגעשריבן מײַנע װערטער!</para>
  <para style="q" vid="JOB 19:23">הלװאַי װערן זי אין אַ בוך פֿאַרצײכנט!<verse eid="JOB 19:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 19:24" />מיט אַן אײַזערנער פּען און בלײַ</para>
  <para style="q" vid="JOB 19:24">אױף אײביק אין פֿעלדז אײַנגעהאַקט!<verse eid="JOB 19:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 19:25" />װאָרעם איך װײס, מײַן אױסלײזער לעבט,</para>
  <para style="q" vid="JOB 19:25">און דאָס ער װעט אין די לעצטע טעג אױפֿשטײן אױף דער ערד.<verse eid="JOB 19:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 19:26" />און כאָטש די װאָרעם װעלן דערנאָך מײַנע הױט פֿאַרדאָרבן,</para>
  <para style="q" vid="JOB 19:26">דאָך װעל איך אין מײַן פֿלײש ג-ט זען!<verse eid="JOB 19:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 19:27" />אַז איך אַלײן זאָל זען פֿאַר מיר,</para>
  <para style="q" vid="JOB 19:27">און מײַנע אױגן זאָלן אָנקוקן, און נישט קײן אַנדערער –</para>
  <para style="q" vid="JOB 19:27">גײען אױס מײַנע נירן אין מײַן לײַב.<verse eid="JOB 19:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 19:28" />װען איר זאָגט: װי װעלן מיר אים רודפֿן!</para>
  <para style="q" vid="JOB 19:28">אַזױ װי דער װאָרצל פֿון דער זאַך װאָלט זיך געפֿונען אין מיר,<verse eid="JOB 19:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 19:29" />האָט מורא פֿאַר דער שװערד,</para>
  <para style="q" vid="JOB 19:29">װאָרעם מיט גרימצאָרן זײַנען די שטראָפֿן פֿון דער שװערד;</para>
  <para style="q" vid="JOB 19:29">דערום זאָלט איר װיסן אַז אַ משפּט איז פֿאַראַן.<verse eid="JOB 19:29" /></para>
  <chapter eid="JOB 19" />
  <chapter number="20" style="c" pubnumber="כ" sid="JOB 20" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 20:1" />האָט געענטפֿערט צופֿר דער נַעַמָתי, און האָט געזאָגט:<verse eid="JOB 20:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 20:2" />דערום ענטפֿערן מיר מײַנע געדאַנקען –</para>
  <para style="q" vid="JOB 20:2">פֿון װעגן װאָס איך שפּיר אין מיר:<verse eid="JOB 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 20:3" />דעם שטראָף פֿון מײַן שאַנד האָב איך געהערט,</para>
  <para style="q" vid="JOB 20:3">און אַ גײַסט פֿון מײַן פֿאַרשטאַנד ענטפֿערט מיר.<verse eid="JOB 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 20:4" />װײסטו דאָס װאָס איז פֿון אײביק אָן,</para>
  <para style="q" vid="JOB 20:4">פֿון זינט דער מענטש איז געמאַכט אױף דער ערד?<verse eid="JOB 20:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 20:5" />אַז דאָס געזאַנג פֿון רשעים איז אױף קורצן,</para>
  <para style="q" vid="JOB 20:5">און די שׂימחה פֿון זינדיקן אױף אַ רגע?<verse eid="JOB 20:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 20:6" />װען ביזן הימל זאָל אַרױפֿגײן זײַן הײך,</para>
  <para style="q" vid="JOB 20:6">און זײַן קאָפּ זאָל ביזן װאָלקן דערגרײכן,<verse eid="JOB 20:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 20:7" />װעט ער װי זײַן אײגן קױט אױף אײביק אונטערגײן;</para>
  <para style="q" vid="JOB 20:7">זײַנע זעער װעלן זאָגן: װוּ איז ער?<verse eid="JOB 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 20:8" />װי אַ חלום װעט ער אַװעקפֿליען, און מע װעט אים נישט געפֿינען,</para>
  <para style="q" vid="JOB 20:8">און ער װעט פֿאַריאָגט װערן װי אַ זעונג פֿון דער נאַכט.<verse eid="JOB 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 20:9" />דאָס אױג האָט אים אָנגעקוקט, און נישט מער,</para>
  <para style="q" vid="JOB 20:9">און מער װעט אים נישט אָנזען זײַן אָרט.<verse eid="JOB 20:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 20:10" />זײַנע קינדער װעלן פֿאַרגיטיקן די אָרימע,</para>
  <para style="q" vid="JOB 20:10">יאָ, זײַנע אײגענע הענט װעלן צוריקגעבן זײַן גוטס.<verse eid="JOB 20:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 20:11" />זײַנע בײנער זײַנען פֿול מיט זײַן יוגנט,</para>
  <para style="q" vid="JOB 20:11">אָבער מיט אים אין שטױב װעט זי זיך לײגן.<verse eid="JOB 20:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="JOB 20:12" />הגם זיס איז דאָס בײז אין זײַן מױל,</para>
  <para style="q" vid="JOB 20:12">ער באַהאַלט עס אונטער זײַן צונג,<verse eid="JOB 20:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 20:13" />ער שױנט עס, און לאָזט עס נישט אָפּ,</para>
  <para style="q" vid="JOB 20:13">און האַלט עס צו אױף זײַן גומען,<verse eid="JOB 20:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 20:14" />װערט זײַן שפּײַז פֿאַרקערט אין זײַנע אינגעװײד,</para>
  <para style="q" vid="JOB 20:14">גאַל פֿון שלאַנגען איז אינעװײניק בײַ אים.<verse eid="JOB 20:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 20:15" />פֿאַרמעג האָט ער אײַנגעשלונגען, און װעט עס אױסברעכן,</para>
  <para style="q" vid="JOB 20:15">פֿון זײַן בױך װעט עס אֵל אַרױסטרײַבן.<verse eid="JOB 20:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 20:16" />גיפֿט פֿון שלאַנגען פֿלעגט ער זױגן,</para>
  <para style="q" vid="JOB 20:16">װעט די צונג פֿון אַ נאָטער אים הרגען.<verse eid="JOB 20:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 20:17" />ער װעט נישט אָנזען די בעכן,</para>
  <para style="q" vid="JOB 20:17">די טײַכנשטראָמען פֿון האָניק און שמאַנט.<verse eid="JOB 20:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 20:18" />ער גיט צוריק זײַן מי, און װעט עס נישט אַראָפּשלינגען,</para>
  <para style="q" vid="JOB 20:18">װי שטאַרק זײַן פֿאַרמעג, װעט ער זיך דערמיט נישט אָנפֿרײען.<verse eid="JOB 20:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 20:19" />װײַל ער האָט צעדריקט, הפֿקר געלאָזט די אָרימע,</para>
  <para style="q" vid="JOB 20:19">געגזלט אַ הױז װאָס ער האָט נישט געבױט.<verse eid="JOB 20:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="JOB 20:20" />װײַל ער האָט נישט געװוּסט קײן רו אין זײַן לײַב,</para>
  <para style="q" vid="JOB 20:20">װעט ער מיט זײַן שאַץ נישט אַנטרונען װערן.<verse eid="JOB 20:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 20:21" />נישטאָ קײן איבערבלײַב פֿון זײַן פֿרעסערײַ,</para>
  <para style="q" vid="JOB 20:21">דערום װעט זײַן גוטס נישט געװערן.<verse eid="JOB 20:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 20:22" />װען זײַן קראָפּ איז פֿול, װעט אים ענג װערן,</para>
  <para style="q" vid="JOB 20:22">װוּ אַ האַנט פֿון אַן אומגליקלעכן, װעט קומען אױף אים.<verse eid="JOB 20:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 20:23" />ער װעט האַלטן בײַ אָנפֿילן זײַן בױך,</para>
  <para style="q" vid="JOB 20:23">װעט ער אָנשיקן אױף אים זײַן גרימצאָרן,</para>
  <para style="q" vid="JOB 20:23">און מאַכן רעגענען אױף אים מיט זײַן שפּײַז.<verse eid="JOB 20:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 20:24" />ער װעט אַנטלױפֿן פֿון אַן אײַזערנעם װאַפֿן,</para>
  <para style="q" vid="JOB 20:24">װעט אים דורכלעכערן אַ קופּערנער בױגן.<verse eid="JOB 20:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 20:25" />ער טוט אַ צי, און עס קומט אַרױס פֿון לײַב,</para>
  <para style="q" vid="JOB 20:25">יאָ, די בליציקע פֿײַל גײט אַרױס פֿון זײַן גאַל;</para>
  <para style="q" vid="JOB 20:25">אימות זײַנען אױף אים.<verse eid="JOB 20:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 20:26" />גאָרע פֿינצטערניש איז באַהאַלטן פֿאַר זײַנע אוֹצרות,</para>
  <para style="q" vid="JOB 20:26">אים װעט פֿאַרצערן אַ פֿײַער פֿון קײנעם נישט אױפֿגעבלאָזן;</para>
  <para style="q" vid="JOB 20:26">עס װעט אָפּעסן דעם איבערבלײַב אין זײַן געצעלט.<verse eid="JOB 20:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 20:27" />די הימלען אַנטפּלעקן זײַן זינד,</para>
  <para style="q" vid="JOB 20:27">און די ערד שטעלט זיך אױף קעגן אים.<verse eid="JOB 20:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 20:28" />אַװעק װעט דער אײַנקום פֿון זײַן הױז,</para>
  <para style="q" vid="JOB 20:28">עס װערט צערונען אין טאָג פֿון זײַן צאָרן.<verse eid="JOB 20:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 20:29" />דאָס איז דער חלק פֿון דעם שלעכטן מענטשן פֿון אלֹקים,</para>
  <para style="q" vid="JOB 20:29">און זײַן באַשערטע ירושה פֿון אֵל.<verse eid="JOB 20:29" /></para>
  <chapter eid="JOB 20" />
  <chapter number="21" style="c" pubnumber="כא" sid="JOB 21" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 21:1" />האָט געענטפֿערט אִיובֿ, און האָט געזאָגט:<verse eid="JOB 21:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 21:2" />הערן הערט צו מײַן װאָרט,</para>
  <para style="q" vid="JOB 21:2">און זאָל דאָס זײַן אײַערע טרײסטונגען.<verse eid="JOB 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 21:3" />לאָזט מיך אַז איך זאָל רעדן;</para>
  <para style="q" vid="JOB 21:3">און נאָך מײַן רעדן װעסטו אָפּלאַכן.<verse eid="JOB 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 21:4" />איז קעגן אַ מענטשן מײַן קלאָג?</para>
  <para style="q" vid="JOB 21:4">און פֿאַר װאָס זאָל נישט קורץ װערן מײַן געמיט?<verse eid="JOB 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 21:5" />קערט זיך צו מיר, און װערט באַנומען,</para>
  <para style="q" vid="JOB 21:5">און טוט אַרױף די האַנט אױפֿן מױל.<verse eid="JOB 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 21:6" />אַז װי איך דערמאָן זיך אַזױ װער איך דערשראָקן,</para>
  <para style="q" vid="JOB 21:6">און מײַן לײַב נעמט אָן אַ שױדער.<verse eid="JOB 21:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="JOB 21:7" />פֿאַר װאָס לעבן די רשעים,</para>
  <para style="q" vid="JOB 21:7">עלטערן זיך, און זײַנען שטאַרק אין קראַפֿט?<verse eid="JOB 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 21:8" />זײער זאָמען שטײט פֿעסט פֿאַר זײער פּנים בײַ זײ,</para>
  <para style="q" vid="JOB 21:8">און זײערע שפּראָצן פֿאַר זײערע אױגן.<verse eid="JOB 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 21:9" />זײערע הײַזער זײַנען בשלום, אָן אַנגסט,</para>
  <para style="q" vid="JOB 21:9">און די רוט פֿון אֱלוֹהַּ איז נישט אױף זײ.<verse eid="JOB 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 21:10" />זײַן אָקס באַפֿרוכפּערט און פֿאַרפֿעלט נישט,</para>
  <para style="q" vid="JOB 21:10">זײַן קו קעלבט זיך און פֿאַרװאַרפֿט נישט.<verse eid="JOB 21:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 21:11" />זײ שיקן אַרױס װי שאָף זײער יונגװאַרג,</para>
  <para style="q" vid="JOB 21:11">און זײערע קינדער טאַנצן אַרום.<verse eid="JOB 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 21:12" />זײ זינגען מיט פּױק און האַרף,</para>
  <para style="q" vid="JOB 21:12">און פֿרײען זיך צום קֹול פֿון דער פֿלײט.<verse eid="JOB 21:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 21:13" />זײ פֿאַרברענגען אין גוטס זײערע טעג,</para>
  <para style="q" vid="JOB 21:13">און רויִק נידערן זײ אין שְׁאֹול.<verse eid="JOB 21:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 21:14" />און זײ זאָגן צו אֵל: קער זיך אָפּ פֿון אונדז,</para>
  <para style="q" vid="JOB 21:14">און מיר װילן נישט װיסן פֿון דײַנע װעגן.<verse eid="JOB 21:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 21:15" />װאָס איז שַדַי, אַז מיר זאָלן אים דינען?</para>
  <para style="q" vid="JOB 21:15">און װאָס װעלן מיר נוצן, אַז מיר װעלן בעטן צו אים? –<verse eid="JOB 21:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 21:16" />זײער גוטס איז דאָך נישט אין זײער האַנט;</para>
  <para style="q" vid="JOB 21:16">דער באַראָט פֿון די רשעים איז װײַט פֿון מיר.<verse eid="JOB 21:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="JOB 21:17" />װי אָפֿט איז דאָס אַז דאָס ליכט פֿון רשעים זאָל פֿאַרלאָשן װערן,</para>
  <para style="q" vid="JOB 21:17">און עס זאָל קומען אױף זײ אַ בראָך?</para>
  <para style="q" vid="JOB 21:17">ער זאָל זײ אױסטײלן יסורים אין זײַן צאָרן?<verse eid="JOB 21:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 21:18" />זײ זאָלן װערן װי שטרױ פֿאַרן װינט,</para>
  <para style="q" vid="JOB 21:18">און װי שפּרײ װאָס דער שטורעם גנבֿעט אים אַװעק?<verse eid="JOB 21:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 21:19" />אֱלוֹהַּ באַהאַלט זײַן אומרעכט פֿאַר זײַנע קינדער –</para>
  <para style="q" vid="JOB 21:19">זאָל ער אים אַלײן באַצאָלן אַז ער זאָל װיסן.<verse eid="JOB 21:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 21:20" />זאָלן זײַנע אױגן זען זײַן אומגליק,</para>
  <para style="q" vid="JOB 21:20">און פֿון גרימצאָרן פֿון שַדַי זאָל ער טרינקען.<verse eid="JOB 21:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 21:21" />װאָרעם װאָס קימערט אים זײַן הױזגעזינט נאָך אים,</para>
  <para style="q" vid="JOB 21:21">װען די צאָל פֿון זײַנע חדשים איז געענדיקט?<verse eid="JOB 21:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="JOB 21:22" />קען מען אֵל לערנען פֿאַרשטאַנדיקײט,</para>
  <para style="q" vid="JOB 21:22">אַז ער משפּט די העכסטע?<verse eid="JOB 21:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 21:23" />דער שטאַרבט אין זײַן רעכטער שטאַרקײט,</para>
  <para style="q" vid="JOB 21:23">אין גאַנצן רויִק און בשלװה;<verse eid="JOB 21:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 21:24" />זײַנע עמערס זײַנען פֿול מיט מילך,</para>
  <para style="q" vid="JOB 21:24">און דער מאַרך פֿון זײַנע בײנער איז געזעפֿטיקט.<verse eid="JOB 21:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 21:25" />און דער שטאַרבט אין אַ ביטער נפֿש,</para>
  <para style="q" vid="JOB 21:25">און האָט נישט פֿאַרזוכט קײן גוטס.<verse eid="JOB 21:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 21:26" />אין אײנעם אין שטױב ליגן זײ,</para>
  <para style="q" vid="JOB 21:26">און װערעם דעקן זײ צו.<verse eid="JOB 21:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="JOB 21:27" />איך װײס דאָך אײַערע מחשבֿות,</para>
  <para style="q" vid="JOB 21:27">און װי איר קליגט זיך מיט געװאַלט אַקעגן מיר,<verse eid="JOB 21:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 21:28" />אַז איר זאָגט: װוּ איז דאָס הױז פֿון דעם שׂרָרה?</para>
  <para style="q" vid="JOB 21:28">און װוּ דאָס געצעלט פֿון דעם רָשעס װױנונג?<verse eid="JOB 21:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 21:29" />האָט איר נישט געפֿרעגט בײַ די װעגפֿאָרער?</para>
  <para style="q" vid="JOB 21:29">איר װעט דאָך נישט פֿאַרלײקענען זײערע באַװײַזן,<verse eid="JOB 21:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 21:30" />אַז אין דעם טאָג פֿון בראָך װערט געשױנט דער שלעכטער,</para>
  <para style="q" vid="JOB 21:30">אין דעם טאָג װען שטראָפֿן װערן געבראַכט.<verse eid="JOB 21:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 21:31" />װער זאָגט אים אין פּנים זײַן װעג?</para>
  <para style="q" vid="JOB 21:31">און װאָס ער האָט געטאָן װער באַצאָלט אים?<verse eid="JOB 21:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 21:32" />װאָרעם ער װערט געבראַכט צו קבֿורה,</para>
  <para style="q" vid="JOB 21:32">און אױפֿן בערגל פּאַסט מען אױף.<verse eid="JOB 21:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 21:33" />זיס זײַנען אים די שטיקער ערד פֿון טאָל,</para>
  <para style="q" vid="JOB 21:33">און נאָך אים ציִען זיך אַלע מענטשן,</para>
  <para style="q" vid="JOB 21:33">און אים פֿאַרױס אָן אַ צאָל.<verse eid="JOB 21:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 21:34" />און װי װילט איר מיך טרײסטן מיט גאָרנישט,</para>
  <para style="q" vid="JOB 21:34">אַז אײַערע תּשובֿות בלײַבן אַן אָפּנאַר?<verse eid="JOB 21:34" /></para>
  <chapter eid="JOB 21" />
  <chapter number="22" style="c" pubnumber="כב" sid="JOB 22" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 22:1" />האָט געענטפֿערט אֶליפַֿז דער תֵּימָני, און האָט געזאָגט:<verse eid="JOB 22:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 22:2" />ברענגט דען דער מענטש אַ נוץ אֵל?</para>
  <para style="q" vid="JOB 22:2">נײַערט זיך אַלײן ברענגט אַ נוץ דער פֿאַרשטאַנדיקער.<verse eid="JOB 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 22:3" />האָט שַדַי אַ טובֿה אַז דו ביסט אַ צדיק?</para>
  <para style="q" vid="JOB 22:3">אָדער אַ געװין אַז דו ביסט ערלעך אין דײַנע װעגן?<verse eid="JOB 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 22:4" />צי װעגן דײַן יִרְאַת שטראָפֿט ער דיך,</para>
  <para style="q" vid="JOB 22:4">און גײט צום משפּט מיט דיר?<verse eid="JOB 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 22:5" />איז נישט דײַן שלעכטיקײט גרױס,</para>
  <para style="q" vid="JOB 22:5">און אָן אַ שיעור דײַנע זינד?<verse eid="JOB 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 22:6" />װאָרעם פֿלעגסט נעמען אַ משכּון בײַ דײַנע ברידער אומזיסט,</para>
  <para style="q" vid="JOB 22:6">און די בגדים פֿון די נאַקעטע פֿלעגסטו אױסטאָן.<verse eid="JOB 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 22:7" />אַ טרונק װאַסער דעם פֿאַרשמאַכטן פֿלעגסטו נישט געבן,</para>
  <para style="q" vid="JOB 22:7">און פֿון דעם הונגעריקן פֿלעגסטו פֿאַרמײַדן ברױט.<verse eid="JOB 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 22:8" />יאָ, דעם מאַן מיטן אָרעם, אים געהערט די ערד,</para>
  <para style="q" vid="JOB 22:8">און דער אָנגעזעענער, ער מעג װױנען אױף איר.<verse eid="JOB 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 22:9" />אַלמנות האָסטו אַװעקגעשיקט מיט לײדיקן,</para>
  <para style="q" vid="JOB 22:9">און די אָרעמס פֿון יתומים פֿלעגן צעדריקט װערן.<verse eid="JOB 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 22:10" />דערום זײַנען נעצן רונד אַרום דיר,</para>
  <para style="q" vid="JOB 22:10">און דיך שרעקט אַ פּלוצימדיקער פַּחד,<verse eid="JOB 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 22:11" />אָדער אַ פֿינצטערניש, אַז דו קענסט נישט זען,</para>
  <para style="q" vid="JOB 22:11">און אַ פֿלײצונג װאַסער פֿאַרדעקט דיך.<verse eid="JOB 22:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 22:12" />פֿאַר װאָר, אֱלוֹהַּ איז אין דער הײך פֿון די הימלען,</para>
  <para style="q" vid="JOB 22:12">און זע, די העכסטע שטערן װי דערהױבן זײ זײַנען;<verse eid="JOB 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 22:13" />און דו זאָגסט: װאָס װײס אֵל?</para>
  <para style="q" vid="JOB 22:13">צי קען ער דורכן נעבל משפּטן?<verse eid="JOB 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 22:14" />װאָלקנס זײַנען אים אַ פֿאַרבאָרגעניש, און ער זעט נישט,</para>
  <para style="q" vid="JOB 22:14">און איבער דעם צירקל פֿון הימל גײט ער אום.<verse eid="JOB 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 22:15" />װילסטו אָנהאַלטן דעם אַלטן װעג,</para>
  <para style="q" vid="JOB 22:15">װאָס די לײַט פֿון אומרעכט האָבן געטרעטן?<verse eid="JOB 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 22:16" />די װאָס זײַנען אײַנגעגאַנגען פֿאַר דער צײַט,</para>
  <para style="q" vid="JOB 22:16">װאָס זײער גרונטפֿעסט איז װי אַ טײַך צערונען געװאָרן;<verse eid="JOB 22:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 22:17" />די װאָס האָבן געזאָגט צו אֵל: קער זיך אָפּ פֿון אונדז!</para>
  <para style="q" vid="JOB 22:17">און װאָס קען זײ טאָן שַדַי?<verse eid="JOB 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 22:18" />בעת ער האָט אָנגעפֿילט זײערע הײַזער מיט גוטס –</para>
  <para style="q" vid="JOB 22:18">יאָ, די טראַכטונג פֿון די רשעים איז װײַט פֿון מיר. –<verse eid="JOB 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 22:19" />די גערעכטע האָבן געזען, און זיך געפֿרײט,</para>
  <para style="q" vid="JOB 22:19">און דער אומשולדיקער האָט געשפּעט פֿון זײ:<verse eid="JOB 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 22:20" />פֿאַר װאָר, פֿאַרטיליקט געװאָרן איז זײער באַשטאַנד,</para>
  <para style="q" vid="JOB 22:20">און זײער שפֿע האָט פֿאַרצערט דאָס פֿײַער.<verse eid="JOB 22:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JOB 22:21" />באַקען זיך נאָר מיט אים, און זײַ אין פֿריד –</para>
  <para style="q" vid="JOB 22:21">דורך דעם װעט דיר אָנקומען גוטס.<verse eid="JOB 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 22:22" />נעם נאָר צו לערנונג פֿון זײַן מױל,</para>
  <para style="q" vid="JOB 22:22">און טו אַרײַן זײַנע װערטער אין דײַן האַרצן.<verse eid="JOB 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 22:23" />אַז דו װעסט זיך אומקערן צום שַדַי,</para>
  <para style="q" vid="JOB 22:23">װעסטו אױפֿגעריכט װערן –</para>
  <para style="q" vid="JOB 22:23">אַז דו װעסט דערװײַטערן אומרעכט פֿון דײַנע געצעלטן.<verse eid="JOB 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 22:24" />און װאַרף אין שטױב דאָס גאָלדאַרץ,</para>
  <para style="q" vid="JOB 22:24">און צװישן געשטײן פֿון די טאָלן דאָס אוֹפֿיר-גאָלד;<verse eid="JOB 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 22:25" />און שַדַי זאָל זײַן דײַן גאָלדאַרץ,</para>
  <para style="q" vid="JOB 22:25">און קרוּװעס זילבער בײַ דיר.<verse eid="JOB 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 22:26" />װאָרעם דענצמאָל װעסטו מיטן שַדַי זיך קװיקן,</para>
  <para style="q" vid="JOB 22:26">און װעסט אױפֿהײבן צו אֱלוֹהַּ דײַן פּנים.<verse eid="JOB 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 22:27" />װעסט בעטן צו אים, און ער װעט דיך צוהערן,</para>
  <para style="q" vid="JOB 22:27">און דײַנע נדרים װעסטו באַצאָלן.<verse eid="JOB 22:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 22:28" />און װעסט באַשליסן אַ זאַך, און זי װעט דיר צו שטאַנד קומען,</para>
  <para style="q" vid="JOB 22:28">און אױף דײַנע װעגן װעט שײַנען אַ ליכטיקײט.<verse eid="JOB 22:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="JOB 22:29" />אַז מע האָט דיך דערנידערט, האָסטו געזאָלט זאָגן:</para>
  <para style="q" vid="JOB 22:29">עס איז אַ דערהײבונג;</para>
  <para style="q" vid="JOB 22:29">װאָרעם ער העלפֿט דעם װאָס האַלט נידעריק די אױגן.<verse eid="JOB 22:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 22:30" />װוּ אַן אומשולדיקן מאַכט ער אַנטרינען,</para>
  <para style="q" vid="JOB 22:30">און װעסט אַנטרונען װערן דורך דער רײנקײט פֿון דײַנע הענט.<verse eid="JOB 22:30" /></para>
  <chapter eid="JOB 22" />
  <chapter number="23" style="c" pubnumber="כג" sid="JOB 23" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 23:1" />האָט געענטפֿערט אִיובֿ, און האָט געזאָגט:<verse eid="JOB 23:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 23:2" />הײַנט אױך איז ביטער מײַן קלאָג,</para>
  <para style="q" vid="JOB 23:2">מײַן האַנט איז שװער פֿון װעגן מײַן זיפֿצן.<verse eid="JOB 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 23:3" />הלװאַי װײס איך װוּ איך געפֿין אים,</para>
  <para style="q" vid="JOB 23:3">װי איך קום צו זײַן אָרט!<verse eid="JOB 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 23:4" />איך װאָלט פֿאָרגעלײגט פֿאַר אים דעם משפּט,</para>
  <para style="q" vid="JOB 23:4">און מײַן מױל װאָלט איך אָנגעפֿילט מיט טענות.<verse eid="JOB 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 23:5" />איך װאָלט װיסן װאָס ער װאָלט מיר ענטפֿערן,</para>
  <para style="q" vid="JOB 23:5">און פֿאַרשטײן װאָס ער װאָלט מיר זאָגן.<verse eid="JOB 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 23:6" />װאָלט ער מיט גרױס כּוֹח געקריגט מיט מיר?</para>
  <para style="q" vid="JOB 23:6">נײן; נײַערט אַכט געטאָן װאָלט ער אױף מיר.<verse eid="JOB 23:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 23:7" />דענצמאָל װאָלט דער רעכטפֿאַרטיקער געטענהט מיט אים,</para>
  <para style="q" vid="JOB 23:7">און איך װאָלט אױף אײביק אַנטרונען פֿון מײַן ריכטער.<verse eid="JOB 23:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="JOB 23:8" />זע, איך גײ פֿאַרױס, און ער איז נישטאָ,</para>
  <para style="q" vid="JOB 23:8">און אַהינטער, און איך מערק אים נישט;<verse eid="JOB 23:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 23:9" />לינקס אַז ער איז פֿאַרטאָן, זע איך נישט,</para>
  <para style="q" vid="JOB 23:9">ער פֿאַרדרײט זיך רעכטס, און איך מערק נישט.<verse eid="JOB 23:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="JOB 23:10" />אָבער ער װײס דעם װעג װאָס בײַ מיר,</para>
  <para style="q" vid="JOB 23:10">ער האָט מיך געפּרוּװט, איך בין װי גאָלד אַרױס.<verse eid="JOB 23:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 23:11" />אָן זײַן טריט האָט זיך געהאַלטן מײַן פֿוס,</para>
  <para style="q" vid="JOB 23:11">זײַן װעג האָב איך געהיט, און זיך נישט אָפּגענײגט.<verse eid="JOB 23:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 23:12" />װוּ אַ געבאָט פֿון זײַנע ליפּן, האָב איך זיך נישט אָפּגעקערט;</para>
  <para style="q" vid="JOB 23:12">מער װי מײַן אױסקומעניש האָב איך געהיט די װערטער פֿון זײַן מױל.<verse eid="JOB 23:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 23:13" />אָבער ער האַלט זיך בײַ אײנס, און װער קען אים אָפּהאַלטן?</para>
  <para style="q" vid="JOB 23:13">און זײַן זעל באַגערט, און ער טוט.<verse eid="JOB 23:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 23:14" />יאָ, ער װעט אױספֿירן װאָס מיר איז באַשערט,</para>
  <para style="q" vid="JOB 23:14">און פֿיל אַזױנס איז נאָך דאָ בײַ אים.<verse eid="JOB 23:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 23:15" />דערום בין איך דערשראָקן פֿאַר אים;</para>
  <para style="q" vid="JOB 23:15">איך באַטראַכט, און האָב מורא פֿאַר אים.<verse eid="JOB 23:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 23:16" />און אֵל האָט שלאַף געמאַכט מײַן האַרץ,</para>
  <para style="q" vid="JOB 23:16">און שַדַי האָט מיך אײַנגעשראָקן.<verse eid="JOB 23:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 23:17" />װאָרעם איך בין נישט אױסגעמעקט געװאָרן פֿון דעם חושך,</para>
  <para style="q" vid="JOB 23:17">און פֿאַר מײַן פּנים האָט פֿאַרדעקט אַ פֿינצטערניש.<verse eid="JOB 23:17" /></para>
  <chapter eid="JOB 23" />
  <chapter number="24" style="c" pubnumber="כד" sid="JOB 24" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 24:1" />פֿאַר װאָס זײַנען נישט אָפּגעלײגט</para>
  <para style="q" vid="JOB 24:1">פֿון שַדַי באַשטימטע צײַטן,</para>
  <para style="q" vid="JOB 24:1">און די װאָס קענען אים, זעען נישט זײַנע טעג?<verse eid="JOB 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 24:2" />גרענעצן פֿאַררוקט מען,</para>
  <para style="q" vid="JOB 24:2">אַ סטאַדע גזלט מען און מע פֿיטערט.<verse eid="JOB 24:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 24:3" />דעם אײזל פֿון יתומים פֿירט מען אַװעק,</para>
  <para style="q" vid="JOB 24:3">מע נעמט אין משכּון דעם אָקס פֿון דער אַלמנה.<verse eid="JOB 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 24:4" />מע שטױסט אַראָפּ אבֿיוֹנים פֿון װעג,</para>
  <para style="q" vid="JOB 24:4">באַהאַלטן מוזען זיך אַלע אָרימע פֿון לאַנד.<verse eid="JOB 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 24:5" />זע, װי װילדע אײזלען אין מדבר,</para>
  <para style="q" vid="JOB 24:5">גײען זײ אַרױס צו זײער אַרבעט, זוכנדיק שפּײַז;</para>
  <para style="q" vid="JOB 24:5">די סטעפּ גיט אים ברױט פֿאַר די קינדער.<verse eid="JOB 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 24:6" />אױפֿן פֿעלד שנײַדן זײ זײַן פֿוטער,</para>
  <para style="q" vid="JOB 24:6">און דעם װײַנגאָרטן פֿון רשע קלײַבן זײ אָפּ.<verse eid="JOB 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 24:7" />נאַקעט נעכטיקן זײ, אָן אַ מלבוש</para>
  <para style="q" vid="JOB 24:7">און אָן אַ צודעק פֿון קעלט.<verse eid="JOB 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 24:8" />פֿון דעם רעגנגוס פֿון די בערג װערן זײ דורכגענעצט,</para>
  <para style="q" vid="JOB 24:8">און אָן אַ שיצונג טוליען זײ זיך צום פֿעלדז.<verse eid="JOB 24:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="JOB 24:9" />מע רױבט פֿון דער ברוסט דעם יתום,</para>
  <para style="q" vid="JOB 24:9">און בײַם אָרעמאַן נעמט מען אַ משכּון.<verse eid="JOB 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 24:10" />נאַקעט גײען זײ, אָן אַ מלבוש,</para>
  <para style="q" vid="JOB 24:10">און זײ נעמען פֿון די הונגעריקע זײערע געטרײד גאַרבן.<verse eid="JOB 24:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 24:11" />צװישן די מױערן פֿון יענע, פּרעסן זײ אײל;</para>
  <para style="q" vid="JOB 24:11">קעלטערס טרעטן זײ און זײַנען דאָרשטיק.<verse eid="JOB 24:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 24:12" />פֿון שטאָט קרעכצן די מענטשן,</para>
  <para style="q" vid="JOB 24:12">און די זעל פֿון גוססע שרײַט,</para>
  <para style="q" vid="JOB 24:12">און אֱלוֹהַּ מאַכט נישט קײן פֿאָרװוּרף.<verse eid="JOB 24:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JOB 24:13" />זײ זײַנען װידערשפּעניקער אָן ליכט,</para>
  <para style="q" vid="JOB 24:13">זײ קענען נישט זײַנע װעגן,</para>
  <para style="q" vid="JOB 24:13">און װײַלן נישט אױף זײַנע שטעגן.<verse eid="JOB 24:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 24:14" />מיטן שײַן שטײט אױף דער מערדער,</para>
  <para style="q" vid="JOB 24:14">צו טײטן דעם אָרעמאַן און דעם אבֿיון;</para>
  <para style="q" vid="JOB 24:14">און בײַ נאַכט איז ער װי אַ גנבֿ.<verse eid="JOB 24:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 24:15" />און דאָס אױג פֿון נואף װאַרט אױף פֿאַרנאַכט,</para>
  <para style="q" vid="JOB 24:15">אַזױ צו זאָגן: מיך װעט נישט אָנזען אַן אױג;</para>
  <para style="q" vid="JOB 24:15">און אַ צודעק אױפֿן פּנים טוט ער אָן.<verse eid="JOB 24:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 24:16" />זײ גראָבן אונטער אין דער פֿינצטער הײַזער,</para>
  <para style="q" vid="JOB 24:16">בײַ טאָג פֿאַרשליסן זײ זיך אײַן;</para>
  <para style="q" vid="JOB 24:16">זײ װײסן נישט פֿון ליכטיקײט,<verse eid="JOB 24:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 24:17" />װאָרעם בײַ זײ אַלעמען איז טױטשאָטן פֿרימאָרגן,</para>
  <para style="q" vid="JOB 24:17">װײַל זײ זײַנען באַקאַנט מיט די שרעקענישן פֿון טױטשאָטן.<verse eid="JOB 24:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JOB 24:18" />ער גײט לײַכט אַװעק אױפֿן װאַסער;</para>
  <para style="q" vid="JOB 24:18">פֿאַרשאָלטן איז זײער חלק אױף דער ערד;</para>
  <para style="q" vid="JOB 24:18">ער פֿאַרקערט נישט אױפֿן װעג פֿון װײַנגערטנער.<verse eid="JOB 24:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 24:19" />טריקעניש און היץ רױבן אַװעק שנײװאַסער;</para>
  <para style="q" vid="JOB 24:19">און שְׁאֹול – די װאָס האָבן געזינדיקט.<verse eid="JOB 24:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 24:20" />דער טראַכט פֿאַרגעסט אָן אים,</para>
  <para style="q" vid="JOB 24:20">דער װאָרעם לאָבט זיך מיט אים,</para>
  <para style="q" vid="JOB 24:20">ער װערט מער נישט געדאַכט;</para>
  <para style="q" vid="JOB 24:20">און צעבראָכן װי אַ האָלץ װערט אומגערעכטיקײט.<verse eid="JOB 24:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JOB 24:21" />ער חבֿרט זיך מיט דער עקרה װאָס געבערט נישט;</para>
  <para style="q" vid="JOB 24:21">און די אַלמנה באַגיטיקט ער נישט.<verse eid="JOB 24:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 24:22" />און ער שלעפּט אַראָפּ די מאַכטיקע מיט זײַן כּוֹח;</para>
  <para style="q" vid="JOB 24:22">ער שטײט אױף, און מע איז נישט זיכער מיטן לעבן.<verse eid="JOB 24:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="JOB 24:23" />לאָזט אים אין זיכערקײט, ער זאָל זיך אָנלענען,</para>
  <para style="q" vid="JOB 24:23">אָבער זײַנע אױגן זײַנען אױף זײערע װעגן.<verse eid="JOB 24:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 24:24" />זײ װערן דערהױבן אַ װײַלע, און שױן זײַנען זײ נישטאָ;</para>
  <para style="q" vid="JOB 24:24">יאָ, זײ װערן דערנידערט, װי אַלע װערן זײ אײַנגעזאַמלט,</para>
  <para style="q" vid="JOB 24:24">און װי אַ שפּיץ זאַנג װערן זײ אָפּגעשניטן.<verse eid="JOB 24:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="JOB 24:25" />און אױב נישט אַזױ, דען, װער װיל מיר אָפּלײקענען,</para>
  <para style="q" vid="JOB 24:25">און מאַכן צו נישט מײַן װאָרט?<verse eid="JOB 24:25" /></para>
  <chapter eid="JOB 24" />
  <chapter number="25" style="c" pubnumber="כה" sid="JOB 25" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 25:1" />האָט געענטפֿערט בִלדַד דער שוחי, און האָט געזאָגט:<verse eid="JOB 25:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 25:2" />געװעלטיקײט און פֿאָרכטיקײט זײַנען בײַ אים;</para>
  <para style="q" vid="JOB 25:2">ער שאַפֿט שלום אין זײַנע הײכן.<verse eid="JOB 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 25:3" />איז דאָ אַ צאָל צו זײַנע מחנות?</para>
  <para style="q" vid="JOB 25:3">און אױף װעמען גײט נישט אױף זײַן ליכט?<verse eid="JOB 25:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 25:4" />און װי קען דען אַ מענטש גערעכט זײַן מיט אֵל?</para>
  <para style="q" vid="JOB 25:4">און װי קען רײן זײַן אַ געבאָרענער פֿון אַ פֿרױ?<verse eid="JOB 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 25:5" />זע, אַזש די לבֿנה איז נישט העל,</para>
  <para style="q" vid="JOB 25:5">און די שטערן זײַנען נישט רײן אין זײַנע אױגן,<verse eid="JOB 25:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 25:6" />הײַנט װי שױן אַ מענטש אַ װאָרעם,</para>
  <para style="q" vid="JOB 25:6">און אַ מענטשנקינד אַ מילב?<verse eid="JOB 25:6" /></para>
  <chapter eid="JOB 25" />
  <chapter number="26" style="c" pubnumber="כו" sid="JOB 26" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 26:1" />האָט געענטפֿערט אִיובֿ, און האָט געזאָגט:<verse eid="JOB 26:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 26:2" />װי האָסטו געהאָלפֿן דעם װאָס אָן כּוֹח!</para>
  <para style="q" vid="JOB 26:2">בײַגעשטאַנען דעם אָרעם אָן מאַכט!<verse eid="JOB 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 26:3" />װי האָסטו געעצהט דעם װאָס אָן חכמה,</para>
  <para style="q" vid="JOB 26:3">און קלוגשאַפֿט אַ סך געלאָזט װיסן!<verse eid="JOB 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 26:4" />מיט װעמעס הילף האָסטו געזאָגט די װערטער?</para>
  <para style="q" vid="JOB 26:4">און װעמעס אָטעם איז אַרױסגעגאַנגען פֿון דיר?<verse eid="JOB 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 26:5" />די מתים ציטערן,</para>
  <para style="q" vid="JOB 26:5">די װאַסערן פֿון אונטן מיט זײערע באַװױנער.<verse eid="JOB 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 26:6" />נאַקעט איז שְׁאֹול פֿאַר אים,</para>
  <para style="q" vid="JOB 26:6">און אָן אַ צודעק איז דער אָפּגרונט.<verse eid="JOB 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 26:7" />ער שפּרײט אױס דעם צפֿון איבער דעם תּוהו,</para>
  <para style="q" vid="JOB 26:7">ער הענגט אױף די ערד אױף גאָרנישט.<verse eid="JOB 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 26:8" />ער בינדט אײַן די װאַסערן אין זײַנע כמאַרעס,</para>
  <para style="q" vid="JOB 26:8">און נישט צעפּלאַצט װערט דער װאָלקן אונטער זײ.<verse eid="JOB 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 26:9" />ער פֿאַרדעקט דעם פּנים פֿונעם טראָן,</para>
  <para style="q" vid="JOB 26:9">ער פֿאַרשפּרײט זײַן װאָלקן איבער אים.<verse eid="JOB 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 26:10" />ער האָט געצירקלט אַ גרענעץ אױפֿן װאַסער,</para>
  <para style="q" vid="JOB 26:10">ביז צום סוף פֿון ליכט און פֿינצטערניש.<verse eid="JOB 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 26:11" />די זײַלן פֿון הימל טרײסלען זיך,</para>
  <para style="q" vid="JOB 26:11">און װערן צעטומלט פֿון זײַן אָנגעשרײ.<verse eid="JOB 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 26:12" />מיט זײַן כּוֹח צערודערט ער דעם ים,</para>
  <para style="q" vid="JOB 26:12">און מיט זײַן פֿאַרשטאַנדיקײט צעהאַקט ער רַהַבֿ.<verse eid="JOB 26:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 26:13" />דורך זײַן אָטעם װערט לױטער דער הימל;</para>
  <para style="q" vid="JOB 26:13">זײַן האַנט האָט אַרײַנגעשטאָכט די לױפֿיקע שלאַנג.<verse eid="JOB 26:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 26:14" />זע, דאָס זײַנען טײל פֿון זײַנע װעגן;</para>
  <para style="q" vid="JOB 26:14">און װאָס פֿאַר אַ קלײן מורמל הערן מיר פֿון אים!</para>
  <para style="q" vid="JOB 26:14">אָבער דעם דונער פֿון זײַנע גבֿורות װער קען פֿאַרשטײן?<verse eid="JOB 26:14" /></para>
  <chapter eid="JOB 26" />
  <chapter number="27" style="c" pubnumber="כז" sid="JOB 27" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 27:1" />און אִיובֿ האָט װידער אױפֿגעהױבן זײַן גערײד, און האָט געזאָגט:<verse eid="JOB 27:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 27:2" />אַזױ װי עס לעבט אֵל װאָס האָט צוגענומען מײַן רעכט,</para>
  <para style="q" vid="JOB 27:2">און דער פֿון שַדַי װאָס האָט פֿאַרביטערט מײַן זעל,<verse eid="JOB 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 27:3" />אַז אױב כּל-זמן מײַן אָטעם איז אין מיר,</para>
  <para style="q" vid="JOB 27:3">און דער הױך פֿון אֱלוֹהַּ אין מײַן נאָז,<verse eid="JOB 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 27:4" />אױב מײַנע ליפּן װעלן רעדן אומרעכט,</para>
  <para style="q" vid="JOB 27:4">און אױב מײַן צונג װעט אַרױסלאָזן באַטרוג!<verse eid="JOB 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 27:5" />חלילה מיר, אַז איך זאָל אײַך געבן גערעכט!</para>
  <para style="q" vid="JOB 27:5">ביז איך װעל אױסגײן װעל איך נישט לאָזן אָפּנעמען</para>
  <para style="q" vid="JOB 27:5">מײַן ערלעכקײט פֿון מיר.<verse eid="JOB 27:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 27:6" />אָן מײַן גערעכטיקײט האַלט איך זיך און װעל זי נישט אָפּלאָזן;</para>
  <para style="q" vid="JOB 27:6">מײַן האַרץ האָט פֿון מײַן לעבטאָג אָן מיר נישט פֿאָרצוּװאַרפֿן.<verse eid="JOB 27:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="JOB 27:7" />זאָל װערן פֿון מײַן פֿײַנט װי פֿון רשע,</para>
  <para style="q" vid="JOB 27:7">און פֿון מײַן קעגנשטײער װי פֿון דעם פֿאַרברעכער!<verse eid="JOB 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 27:8" />װאָרעם װאָס איז די האָפֿענונג פֿון דעם זינדיקן, אַז ער האַװעט,</para>
  <para style="q" vid="JOB 27:8">אױב אֱלוֹהַּ נעמט אַװעק זײַן זעל?<verse eid="JOB 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 27:9" />װעט אֵל הערן זײַן געשרײ,</para>
  <para style="q" vid="JOB 27:9">אַז אױף אים װעט קומען אַ צרה?<verse eid="JOB 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 27:10" />צי קען ער זיך קװיקן מיטן פֿון שַדַי,</para>
  <para style="q" vid="JOB 27:10">רופֿן צו אֱלוֹהַּ אין יעטװעדער צײַט?<verse eid="JOB 27:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 27:11" />איך װעל אײַך לערנען װעגן דער האַנט פֿון אֵל,</para>
  <para style="q" vid="JOB 27:11">װאָס איז בײַם פֿון שַדַי װעל איך נישט פֿאַרהױלן.<verse eid="JOB 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 27:12" />אָט האָט איר אַלע געזען,</para>
  <para style="q" vid="JOB 27:12">און פֿאַר װאָס דען פּלױדערט איר נישטיקס?<verse eid="JOB 27:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 27:13" />דאָס איז דער חלק פֿון דעם שלעכטן מענטשן בײַ אֵל,</para>
  <para style="q" vid="JOB 27:13">און די אַרב װאָס די געװאַלטטוער קריגן פֿון שַדַי.<verse eid="JOB 27:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 27:14" />אױב זײַנע קינדער מערן זיך, איז דאָס פֿאַרן שװערד,</para>
  <para style="q" vid="JOB 27:14">און זײַנע שפּראָצן װעלן נישט האָבן ברױט צו זאַט.<verse eid="JOB 27:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 27:15" />די װאָס בלײַבן פֿון אים װעלן פֿון פּעסט באַגראָבן װערן,</para>
  <para style="q" vid="JOB 27:15">און זײַנע אַלמנות װעלן צו מאָל נישט באַװײנען.<verse eid="JOB 27:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 27:16" />אַז ער זאָל אָנזאַמלען װי שטױב זילבער,</para>
  <para style="q" vid="JOB 27:16">און װי לײם אָנגרײטן מלבושים,<verse eid="JOB 27:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 27:17" />װעט ער אָנגרײטן, און דער גערעכטער װעט אָנטאָן,</para>
  <para style="q" vid="JOB 27:17">און מיטן זילבער װעלן די אומשולדיקע זיך טײלן.<verse eid="JOB 27:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 27:18" />ער בױט װי אַ מאָיל זײַן הױז,</para>
  <para style="q" vid="JOB 27:18">און װי אַ בײַדל װאָס דער װעכטער מאַכט.<verse eid="JOB 27:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 27:19" />ער לײגט זיך אַן עושר, און שױן איז נישטאָ װאָס אױפֿצוקלײַבן,</para>
  <para style="q" vid="JOB 27:19">ער עפֿנט זײַנע אױגן, און עס איז נישטאָ.<verse eid="JOB 27:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 27:20" />װי װאַסערן יאָגן אים אָן שרעקענישן,</para>
  <para style="q" vid="JOB 27:20">איבער נאַכט גנבֿעט אים אַװעק אַ שטורעם.<verse eid="JOB 27:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 27:21" />דער מזרח-װינט הײבט אים אױף, אַז ער מוז גײן,</para>
  <para style="q" vid="JOB 27:21">און ער שטורעמט אים אַװעק פֿון זײַן אָרט.<verse eid="JOB 27:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 27:22" />און ער שלײַדערט אױף אים און דערבאַרעמט זיך נישט;</para>
  <para style="q" vid="JOB 27:22">לױפֿנדיק װאָלט ער אַנטלאָפֿן פֿון זײַן האַנט.<verse eid="JOB 27:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 27:23" />מע פּאַטשט איבער אים די הענט,</para>
  <para style="q" vid="JOB 27:23">און מע שמוצערט אױף אים פֿון זײַן אָרט.<verse eid="JOB 27:23" /></para>
  <chapter eid="JOB 27" />
  <chapter number="28" style="c" pubnumber="כח" sid="JOB 28" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 28:1" />יאָ, פֿאַראַן אַ גרעבערײַ פֿאַר זילבער,</para>
  <para style="q" vid="JOB 28:1">און אַן אָרט װוּ גאָלד טוט מען לײַטערן.<verse eid="JOB 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 28:2" />אײַזן װערט פֿון דער ערד גענומען,</para>
  <para style="q" vid="JOB 28:2">און פֿון שטײן שמעלצט מען קופּער.<verse eid="JOB 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 28:3" />דער מענטש מאַכט אַ סוף צו פֿינצטערניש,</para>
  <para style="q" vid="JOB 28:3">און ביז יעטװעדער עק פֿאָרשט ער אױס</para>
  <para style="q" vid="JOB 28:3">שטײנער פֿון פֿינצטערניש און טױטשאָטן.<verse eid="JOB 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 28:4" />ער ברעכט אַ שאַכט װײַט פֿון אַ באַװױנער;</para>
  <para style="q" vid="JOB 28:4">פֿאַרגעסן פֿון אַ פֿאַרבײַגײערס פֿוס;</para>
  <para style="q" vid="JOB 28:4">אָפּגעצערט, װײַט פֿון מענטשן װאַנדערן זײ.<verse eid="JOB 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 28:5" />די ערד, פֿון איר קומט אַרױס ברױט,</para>
  <para style="q" vid="JOB 28:5">אָבער אונטער איר איז איבערגעקערט װי פֿון פֿײַער.<verse eid="JOB 28:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 28:6" />דער אָרט פֿון סאַפּיר זײַנען אירע שטײנער,</para>
  <para style="q" vid="JOB 28:6">און שטױבן פֿון גאָלד זײַנען דערין.<verse eid="JOB 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 28:7" />דעם שטעג, אים װײס נישט קײן רױבפֿױגל,</para>
  <para style="q" vid="JOB 28:7">און נישט אָנגעקוקט האָט אים דאָס אױג פֿון אַ פֿאַלק.<verse eid="JOB 28:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 28:8" />נישט באַטרעטן האָבן אים חיות שטאָלצע,</para>
  <para style="q" vid="JOB 28:8">נישט געשפּרײַזט האָט אױף אים דער לײב.<verse eid="JOB 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 28:9" />צום קיזלשטײן שטרעקט ער אױס זײַן האַנט,</para>
  <para style="q" vid="JOB 28:9">ער קערט אום פֿון װאָרצל די בערג.<verse eid="JOB 28:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 28:10" />אין פֿעלדזן האַקט ער גראָבנס,</para>
  <para style="q" vid="JOB 28:10">און אַל דאָס טײַערסטע קוקט אָן זײַן אױג.<verse eid="JOB 28:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 28:11" />פֿלוסן פֿאַרבינדט ער נישט צו רינען,</para>
  <para style="q" vid="JOB 28:11">און פֿאַרבאָרגנס ברענגט ער אַרױס אין ליכט.<verse eid="JOB 28:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 28:12" />אָבער די חכמה פֿון װאַנען קען געפֿונען װערן,</para>
  <para style="q" vid="JOB 28:12">און װוּ איז דער אָרט פֿון פֿאַרשטאַנדיקײט?<verse eid="JOB 28:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 28:13" />קײן מענטש װײס נישט איר װערדע,</para>
  <para style="q" vid="JOB 28:13">און זי געפֿינט זיך נישט אין לאַנד פֿון די לעבעדיקע.<verse eid="JOB 28:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 28:14" />דער תּהום זאָגט: נישט אין מיר;</para>
  <para style="q" vid="JOB 28:14">און דער ים זאָגט: נישט בײַ מיר.<verse eid="JOB 28:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 28:15" />פֿאַר איר קען נישט געגעבן װערן פֿײַנגאָלד,</para>
  <para style="q" vid="JOB 28:15">און זילבער קען נישט געװױגן װערן פֿאַר איר מקח.<verse eid="JOB 28:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 28:16" />זי קען נישט אָפּגעשאַצט װערן מיט אוֹפֿיר-גאָלד,</para>
  <para style="q" vid="JOB 28:16">מיט טײַערן אָניקל און סאַפּירשטײן.<verse eid="JOB 28:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 28:17" />גאָלד און גלאָז זײַנען נישט איר גלײַכן,</para>
  <para style="q" vid="JOB 28:17">און כּלים פֿון גינגאָלד איר אױסבײַט.<verse eid="JOB 28:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 28:18" />אַבֿנים טובֿות און קריסטאָל דאַרפֿן נישט דערמאָנט װערן,</para>
  <para style="q" vid="JOB 28:18">און מער פֿון קאַרעלן איז דער באַטרעף פֿון חכמה.<verse eid="JOB 28:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 28:19" />טאָפּאַז פֿון כּוּש איז נישט איר גלײַכן,</para>
  <para style="q" vid="JOB 28:19">מיט רײנעם גאָלד קען זי נישט אָפּגעשאַצט װערן.<verse eid="JOB 28:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 28:20" />טאָ פֿון װאַנען קומט די חכמה?</para>
  <para style="q" vid="JOB 28:20">און װוּ איז דער אָרט פֿון פֿאַרשטאַנדיקײט?<verse eid="JOB 28:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 28:21" />אַז זי איז פֿאַרהױלן פֿון די אױגן פֿון יעטװעדער לעבעדיקן,</para>
  <para style="q" vid="JOB 28:21">און פֿון פֿױגל פֿון הימל איז זי פֿאַרבאָרגן.<verse eid="JOB 28:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 28:22" />אונטערגאַנג און טױט זאָגן:</para>
  <para style="q" vid="JOB 28:22">מיט אונדזערע אױערן האָבן מיר געהערט איר הערונג.<verse eid="JOB 28:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 28:23" />אלֹקים פֿאַרשטײט איר װעג,</para>
  <para style="q" vid="JOB 28:23">און ער װײס איר אָרט.<verse eid="JOB 28:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 28:24" />װאָרעם ער קוקט ביז די עקן ערד,</para>
  <para style="q" vid="JOB 28:24">אונטערן גאַנצן הימל זעט ער.<verse eid="JOB 28:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 28:25" />װען ער האָט געמאַכט פֿאַרן װינט אַ װאָג,</para>
  <para style="q" vid="JOB 28:25">און װאַסערן מאַרקירט מיט אַ מאָס,<verse eid="JOB 28:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 28:26" />װען ער האָט געמאַכט פֿאַרן רעגן אַ געזעץ,</para>
  <para style="q" vid="JOB 28:26">און אַ װעג פֿאַרן דונערגעװיטער,<verse eid="JOB 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 28:27" />דענצמאָל האָט ער זי געזען און זי באַרעכנט,</para>
  <para style="q" vid="JOB 28:27">זי אױפֿגעשטעלט און אױך זי אױסגעפֿאָרשט.<verse eid="JOB 28:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 28:28" />און ער האָט געזאָגט צום מענטשן:</para>
  <para style="q" vid="JOB 28:28">זע, מורא פֿאַר אֲדֹנָי דאָס איז חכמה,</para>
  <para style="q" vid="JOB 28:28">און זיך אָפּקערן פֿון שלעכטס איז פֿאַרשטאַנדיקײט.<verse eid="JOB 28:28" /></para>
  <chapter eid="JOB 28" />
  <chapter number="29" style="c" pubnumber="כט" sid="JOB 29" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 29:1" />און אִיובֿ האָט װידער אױפֿגעהױבן זײַן גערײד,</para>
  <para style="q" vid="JOB 29:1">און האָט געזאָגט:<verse eid="JOB 29:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 29:2" />װער מאַכט מיך אַזױ װי אין די חדשים פֿון אַ מאָל,</para>
  <para style="q" vid="JOB 29:2">װי אין די טעג װאָס אֱלוֹהַּ האָט מיך אָפּגעהיט!<verse eid="JOB 29:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 29:3" />װען זײַן ליכט האָט געשײַנט איבער מײַן קאָפּ,</para>
  <para style="q" vid="JOB 29:3">װען פֿאַר זײַן שײַן פֿלעג איך גײן אין דער פֿינצטער.<verse eid="JOB 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 29:4" />אַזױ װי איך בין געװען אין די טעג פֿון מײַן יוגנט,</para>
  <para style="q" vid="JOB 29:4">װען די פֿאַרטרױטקײט פֿון אֱלוֹהַּ איז געװען אױף מײַן געצעלט;<verse eid="JOB 29:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 29:5" />װען שַדַי איז נאָך געװען מיט מיר;</para>
  <para style="q" vid="JOB 29:5">רונד אַרום מיר מײַנע קינדער.<verse eid="JOB 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 29:6" />װען מײַנע טריט האָבן זיך געבאָדן אין שמאַנט,</para>
  <para style="q" vid="JOB 29:6">און דער פֿעלדז האָט געגאָסן בײַ מיר בעכן מיט אײל.<verse eid="JOB 29:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 29:7" />אַז איך בין אַרױסגעגאַנגען צום טױער אין שטאָט,</para>
  <para style="q" vid="JOB 29:7">אױפֿגעשטעלט אין מאַרק מײַן זיץ,<verse eid="JOB 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 29:8" />האָבן יונגעלײַט געזען און זיך באַהאַלטן,</para>
  <para style="q" vid="JOB 29:8">און גרײַזן האָבן זיך אױפֿגעהױבן און געשטאַנען.<verse eid="JOB 29:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 29:9" />האַרן האָבן זיך אײַנגעהאַלטן פֿון װערטער,</para>
  <para style="q" vid="JOB 29:9">און די האַנט פֿלעגן זײ אַרױפֿטאָן אױף זײער מױל.<verse eid="JOB 29:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 29:10" />דער קֹול פֿון גרױסע לײַט האָט זיך באַהאַלטן,</para>
  <para style="q" vid="JOB 29:10">און זײער צונג האָט זיך צוגעקלעפּט צו זײער גומען.<verse eid="JOB 29:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 29:11" />װאָרעם װוּ אַן אױער האָט געהערט, האָט מיך געלױבט,</para>
  <para style="q" vid="JOB 29:11">און װוּ אַן אױג האָט געזען, האָט מיר צוגעשטימט.<verse eid="JOB 29:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 29:12" />װײַל איך פֿלעג ראַטעװען דעם אָרעמאַן װאָס האָט געשריִען,</para>
  <para style="q" vid="JOB 29:12">און דעם יתום װאָס האָט נישט קײן העלפֿער.<verse eid="JOB 29:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 29:13" />די ברכה פֿון דעם אומגליקלעכן פֿלעגט קומען אױף מיר,</para>
  <para style="q" vid="JOB 29:13">און דאָס האַרץ פֿון דער אַלמנה פֿלעג איך דערפֿרײען.<verse eid="JOB 29:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 29:14" />איך האָב אָנגעטאָן רעכטפֿאַרטיקײט, און זי האָט מיך אָנגעטאָן,</para>
  <para style="q" vid="JOB 29:14">װי אַ מאַנטל און אַ הױב איז געװען מײַן גערעכטיקײט.<verse eid="JOB 29:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 29:15" />אױגן בין איך געװען פֿאַרן בלינדן,</para>
  <para style="q" vid="JOB 29:15">און פֿיס פֿאַרן הינקעדיקן בין איך געװען.<verse eid="JOB 29:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 29:16" />איך בין געװען אַ פֿאָטער פֿאַר די באַדערפֿטיקע,</para>
  <para style="q" vid="JOB 29:16">און דעם משפּט פֿון דעם װאָס איך האָב נישט געקענט,</para>
  <para style="q" vid="JOB 29:16">פֿלעג איך אױספֿאָרשן.<verse eid="JOB 29:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 29:17" />און איך האָב צעבראָכן די באַקצײן פֿון דעם פֿאַרברעכער,</para>
  <para style="q" vid="JOB 29:17">און פֿון זײַנע צײנער אַרױסגעװאָרפֿן דעם רױב.<verse eid="JOB 29:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 29:18" />און איך האָב געזאָגט: בײַ מײַן נעסט װעל איך פֿאַרגײן,</para>
  <para style="q" vid="JOB 29:18">און װי דער זאַמד װעל איך מערן טעג.<verse eid="JOB 29:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 29:19" />מײַן װאָרצל װעט זײַן אָפֿן צום װאַסער,</para>
  <para style="q" vid="JOB 29:19">און דער טױ װעט נעכטיקן אױף מײַן צװײַג.<verse eid="JOB 29:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 29:20" />מײַן כּבֿוד װעט בלײַבן פֿריש בײַ מיר,</para>
  <para style="q" vid="JOB 29:20">און מײַן בױגן װעט אין מײַן האַנט זיך באַנײַען.<verse eid="JOB 29:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JOB 29:21" />צו מיר האָט מען זיך צוגעהערט און געװאַרט,</para>
  <para style="q" vid="JOB 29:21">און מע פֿלעגט האַרן אױף מײַן עצה.<verse eid="JOB 29:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 29:22" />נאָך מײַן זאָג פֿלעגט מען מער נישט רעדן,</para>
  <para style="q" vid="JOB 29:22">און אױף זײ פֿלעגט טריפֿן מײַן װאָרט.<verse eid="JOB 29:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 29:23" />און זײ האָבן געװאַרט װי אױף רעגן אױף מיר,</para>
  <para style="q" vid="JOB 29:23">און אױפֿגעשפּאַרט זײער מױל װי אױף שפּעטרעגן.<verse eid="JOB 29:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 29:24" />אַז איך פֿלעג לאַכן צו זײ, פֿלעגט זיך זײ נישט גלױבן;</para>
  <para style="q" vid="JOB 29:24">און דאָס ליכט פֿון מײַן פּנים פֿלעגן זײ נישט מינערן.<verse eid="JOB 29:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 29:25" />איך פֿלעג אױסקלײַבן זײער װעג,</para>
  <para style="q" vid="JOB 29:25">און פֿלעג זיצן אױבן אָן,</para>
  <para style="q" vid="JOB 29:25">און רוען װי אַ מלך צװישן חיל,</para>
  <para style="q" vid="JOB 29:25">װי דער װאָס טוט טרױערער טרײסטן.<verse eid="JOB 29:25" /></para>
  <chapter eid="JOB 29" />
  <chapter number="30" style="c" pubnumber="ל" sid="JOB 30" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 30:1" />און אַצונד לאַכן פֿון מיר ייִנגערע פֿון מיר אין טעג,</para>
  <para style="q" vid="JOB 30:1">װאָס איך האָב מיך געמיאוסט צו שטעלן זײערע פֿאָטערס</para>
  <para style="q" vid="JOB 30:1">מיט די הינט פֿון מײַנע שאָף –<verse eid="JOB 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 30:2" />יאָ, צו װאָס מיר דער כּוֹח פֿון זײערע הענט?</para>
  <para style="q" vid="JOB 30:2">זײער פֿרישקײט איז געװען פֿאַרלאָרן –<verse eid="JOB 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 30:3" />די װאָס זײַנען פֿון נױט און הונגער אײַנגעדאַרט,</para>
  <para style="q" vid="JOB 30:3">װאָס נאָגן די טריקעניש אין פֿינצטערער װיסטקײט און װיסטעניש.<verse eid="JOB 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 30:4" />די װאָס רײַסן זאַלצקרײַטעכץ מיט װערמוט,</para>
  <para style="q" vid="JOB 30:4">און װאָרצל פֿון בעזעמבײמלעך זיך אָנצוּװאַרעמען.<verse eid="JOB 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 30:5" />פֿון צװישן מענטשן װערן זײ פֿאַרטריבן,</para>
  <para style="q" vid="JOB 30:5">מע שרײַט אױף זײ װי אױף אַ גנבֿ.<verse eid="JOB 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 30:6" />אין מוֹראדיקע טאָלן מוזען זײ װױנען,</para>
  <para style="q" vid="JOB 30:6">אין לעכער פֿון דער ערד און פֿעלדזן.<verse eid="JOB 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 30:7" />צװישן די בײמלעך ברומען זײ,</para>
  <para style="q" vid="JOB 30:7">אונטער אַ דאָרן זײַנען זײ צונױפֿגענורעט.<verse eid="JOB 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 30:8" />געמײנע יונגען און יונגען אָן אַ נאָמען,</para>
  <para style="q" vid="JOB 30:8">װאָס זײַנען אױסגעשטױסן פֿון לאַנד.<verse eid="JOB 30:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="JOB 30:9" />און אַצונד בין איך זײער לידל געװאָרן,</para>
  <para style="q" vid="JOB 30:9">און איך בין פֿאַר אַ װערטל בײַ זײ.<verse eid="JOB 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 30:10" />זײ פֿאַראומװערדיקן מיך, זײ דערװײַטערן זיך פֿון מיר,</para>
  <para style="q" vid="JOB 30:10">און זײ האַלטן זיך נישט אָפּ מיר אין פּנים צו שפּײַען.<verse eid="JOB 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 30:11" />װאָרעם מײַן בױגנשטריק האָט ער לױז געמאַכט און מיך געבױגן,</para>
  <para style="q" vid="JOB 30:11">און זײ װאַרפֿן אַראָפּ די צאַם פֿאַר מיר.<verse eid="JOB 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 30:12" />אױף רעכטס שטעלט זיך אױף דאָס יונגװאַרג;</para>
  <para style="q" vid="JOB 30:12">זײ שטױסן מײַנע פֿיס,</para>
  <para style="q" vid="JOB 30:12">און טרעטן אױס קעגן מיר זײערע װעגן פֿון אומגליק.<verse eid="JOB 30:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 30:13" />זײ האָבן צעריסן מײַן שטעג,</para>
  <para style="q" vid="JOB 30:13">זײ העלפֿן מײַן בראָך; קײן העלפֿער זאָל זײ נישט זײַן!<verse eid="JOB 30:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 30:14" />װי אַ ברײטער װאַסערבראָך קומען זײ,</para>
  <para style="q" vid="JOB 30:14">מיט שטורעם קײַקלען זײ זיך אַרױף.<verse eid="JOB 30:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 30:15" />שרעקענישן זײַנען געקערט קעגן מיר,</para>
  <para style="q" vid="JOB 30:15">זײ יאָגן װי אַ װינט מײַן גדוּלה,</para>
  <para style="q" vid="JOB 30:15">און װי אַ װאָלקן איז אַװעק מײַן הילף.<verse eid="JOB 30:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 30:16" />און אַצונד צעגיסט זיך אין מיר מײַן זעל,</para>
  <para style="q" vid="JOB 30:16">טעג פֿון פּײַן האָבן מיך אָנגענומען.<verse eid="JOB 30:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 30:17" />די נאַכט בױערט מײַנע בײנער פֿון מיר,</para>
  <para style="q" vid="JOB 30:17">און מײַנע אָדערן ליגן נישט אײַן.<verse eid="JOB 30:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 30:18" />פֿון גרױס שטאַרקײט פֿון מײַן קרענק איז מײַן מלבוש פֿאַרביטן;</para>
  <para style="q" vid="JOB 30:18">װי דער קאָלנער פֿון מײַן מאַנטל גורט זי מיך אַרום.<verse eid="JOB 30:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 30:19" />ער האָט מיך געװאָרפֿן אין קױט,</para>
  <para style="q" vid="JOB 30:19">און איך בין געגליכן צו שטױב און אַש.<verse eid="JOB 30:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 30:20" />איך שרײַ צו דיר, און דו ענטפֿערסט מיר נישט,</para>
  <para style="q" vid="JOB 30:20">איך שטײ, און דו קוקסט מיך אָן.<verse eid="JOB 30:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 30:21" />ביסט פֿאַרקערט געװאָרן אין אַן אַכזר צו מיר,</para>
  <para style="q" vid="JOB 30:21">מיט דער מאַכט פֿון דײַן האַנט פֿײַנטסטו מיך.<verse eid="JOB 30:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 30:22" />הײבסט מיך אױף אױפֿן װינט, מאַכסט מיך רײַטן דערױף,</para>
  <para style="q" vid="JOB 30:22">און מאַכסט צעגײן מײַן קראַפֿט.<verse eid="JOB 30:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 30:23" />יאָ, איך װײס, װעסט צום טױט מיך ברענגען,</para>
  <para style="q" vid="JOB 30:23">און צום זאַמלהױז פֿון אַלע לעבעדיקע.<verse eid="JOB 30:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 30:24" />װען ער װעט נישט שטרעקן זײַנע הענט צו די װאָס זענען אין די גרוב,</para>
  <para style="q" vid="JOB 30:24">כאָטש זײ שרײַען אין דער בראָך?<verse eid="JOB 30:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 30:25" />צי האָב איך נישט געװײנט פֿאַרן שװער געדריקטן?</para>
  <para style="q" vid="JOB 30:25">מײַן זעל האָט דאָך געקומערט פֿאַרן אבֿיון.<verse eid="JOB 30:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 30:26" />אָבער איך האָב געהאָפֿט אױף גוטס,</para>
  <para style="q" vid="JOB 30:26">און שלעכטס איז געקומען;</para>
  <para style="q" vid="JOB 30:26">און איך האָב געהאַרט אױף ליכט,</para>
  <para style="q" vid="JOB 30:26">און פֿינצטערניש איז געקומען.<verse eid="JOB 30:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 30:27" />מײַנע אינגעװײד קאָכן און רוען נישט;</para>
  <para style="q" vid="JOB 30:27">טעג פֿון פּײַן זײַנען געקומען אױף מיר.<verse eid="JOB 30:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 30:28" />פֿינצטער גײ איך אום, אָן זון;</para>
  <para style="q" vid="JOB 30:28">איך שטײ אױף אין אַ געזעמל און שרײַ.<verse eid="JOB 30:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 30:29" />איך בין געװאָרן אַ ברודער צו שאַקאַלן,</para>
  <para style="q" vid="JOB 30:29">און אַ חבֿר צו שטרױספֿױגלען.<verse eid="JOB 30:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 30:30" />מײַן הױט איז שװאַרץ געװאָרן אױף מיר,</para>
  <para style="q" vid="JOB 30:30">און מײַן געבײן איז צעברענט פֿון היץ.<verse eid="JOB 30:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 30:31" />און געװאָרן צו טרױער איז מײַן האַרף,</para>
  <para style="q" vid="JOB 30:31">און מײַן פֿלײט צו אַ קֹול פֿון געװײן.<verse eid="JOB 30:31" /></para>
  <chapter eid="JOB 30" />
  <chapter number="31" style="c" pubnumber="לא" sid="JOB 31" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 31:1" />אַ ברית האָב איך געשלאָסן מיט מײַנע אױגן;</para>
  <para style="q" vid="JOB 31:1">און װאָס זאָל איך קוקן אױף אַ יונגפֿרױ?<verse eid="JOB 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 31:2" />װאָרעם װאָס איז דער חלק פֿון אֱלוֹהַּ פֿון אױבן,</para>
  <para style="q" vid="JOB 31:2">און די אַרב פֿון שַדַי פֿון דער הײך?<verse eid="JOB 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 31:3" />אױב נישט אַ בראָך פֿאַרן פֿאַרברעכער,</para>
  <para style="q" vid="JOB 31:3">און אומגליק פֿאַר די טוער פֿון אומרעכט?<verse eid="JOB 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 31:4" />זעט ער דען נישט אַלע מײַנע װעגן,</para>
  <para style="q" vid="JOB 31:4">און צײלט אַלע מײַנע טריט?<verse eid="JOB 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 31:5" />אױב איך בין אומגעגאַנגען מיט ליגן,</para>
  <para style="q" vid="JOB 31:5">און געאײַלט צו באַטרוג האָט מײַן פֿוס –<verse eid="JOB 31:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 31:6" />זאָל ער מיך װעגן אױף ריכטיקע װאָגשאָלן,</para>
  <para style="q" vid="JOB 31:6">און אֱלוֹהַּ װעט װיסן מײַן אומשולד –<verse eid="JOB 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 31:7" />אױב מײַן טריט האָט זיך אָפּגענײגט פֿון װעג,</para>
  <para style="q" vid="JOB 31:7">און נאָך מײַנע אױגן איז געגאַנגען מײַן האַרץ,</para>
  <para style="q" vid="JOB 31:7">און אין מײַנע הענט האָט זיך אָנגעקלעפּט אַ פֿלעק,<verse eid="JOB 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 31:8" />זאָל איך זײען, און אַן אַנדערער זאָל עסן,</para>
  <para style="q" vid="JOB 31:8">און מײַנע שפּראָצונגען זאָלן אױסגעװאָרצלט װערן.<verse eid="JOB 31:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="JOB 31:9" />אױב מײַן האַרץ איז פֿאַרפֿירט געװאָרן נאָך אַ פֿרױ,</para>
  <para style="q" vid="JOB 31:9">און איך האָב געלױערט בײַ דער טיר פֿון מײַן חבֿר,<verse eid="JOB 31:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 31:10" />זאָל מאָלן פֿאַר אַן אַנדערן מײַן װײַב,</para>
  <para style="q" vid="JOB 31:10">און אַנדערע זאָלן קניִען איבער איר.<verse eid="JOB 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 31:11" />װאָרעם דאָס איז אַ שענדלעכקײט,</para>
  <para style="q" vid="JOB 31:11">און דאָס איז אַ זינד צום פֿאַרמשפּטן.<verse eid="JOB 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 31:12" />װאָרעם דאָס איז אַ פֿײַער װאָס פֿאַרצערט ביז אונטערגאַנג,</para>
  <para style="q" vid="JOB 31:12">און מײַן גאַנצע תּבֿואה װאָלט עס אױסגעװאָרצלט.<verse eid="JOB 31:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JOB 31:13" />אױב איך פֿלעג פֿאַראַכטן דאָס רעכט פֿון מײַן קנעכט און מײַן דינסט</para>
  <para style="q" vid="JOB 31:13">אין זײער קריג מיט מיר –<verse eid="JOB 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 31:14" />װאָס װאָלט איך דען געטאָן, אַז אֵל זאָל אױפֿשטײן?</para>
  <para style="q" vid="JOB 31:14">און אַז ער װאָלט געמאָנט, װאָס װאָלט איך אים געענטפֿערט?<verse eid="JOB 31:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 31:15" />האָט נישט דער װאָס האָט מיך אין מוטערלײַב באַשאַפֿן, אים באַשאַפֿן?</para>
  <para style="q" vid="JOB 31:15">און דער אײגענער אים אין טראַכט געפֿורעמט?<verse eid="JOB 31:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="JOB 31:16" />אױב איך פֿלעג פֿאַרמײַדן דעם פֿאַרלאַנג פֿון די אָרימע,</para>
  <para style="q" vid="JOB 31:16">און די אױגן פֿון דער אַלמנה לאָזן אױסגײן;<verse eid="JOB 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 31:17" />אָדער איך פֿלעג עסן מײַן ביסן אַלײן,</para>
  <para style="q" vid="JOB 31:17">און דער יתום האָט דערפֿון נישט געגעסן –<verse eid="JOB 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 31:18" />נײן, פֿון מײַן יוגנט אָן איז ער אױפֿגעװאַקסן</para>
  <para style="q" vid="JOB 31:18">בײַ מיר װי בײַ אַ פֿאָטער,</para>
  <para style="q" vid="JOB 31:18">און פֿון מײַן מוטערלײַב אָן פֿלעג איך זי פֿירן.<verse eid="JOB 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 31:19" />אױב איך פֿלעג צוזען אַן אומגליקלעכן אָן אַ מלבוש</para>
  <para style="q" vid="JOB 31:19">און אָן אַ צודעק דעם אבֿיון;<verse eid="JOB 31:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 31:20" />אױב זײַנע לענדן האָבן מיך נישט געבענטשט,</para>
  <para style="q" vid="JOB 31:20">װײַל מיטן אָפּשער פֿון מײַנע שאָף פֿלעגט ער זיך דערװאַרעמען;<verse eid="JOB 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 31:21" />אױב איך האָב געהױבן אױף אַ יתום מײַן האַנט,</para>
  <para style="q" vid="JOB 31:21">װײַל איך פֿלעג זען מײַנע העלפֿער אין טױער,<verse eid="JOB 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 31:22" />זאָל מײַן אַקסל פֿון זײַן נאַקן אַראָפּפֿאַלן,</para>
  <para style="q" vid="JOB 31:22">און מײַן אָרעם זאָל פֿון געלענק אױסגעבראָכן װערן.<verse eid="JOB 31:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 31:23" />װאָרעם דער בראָך פֿון אֵל איז געװען מײַן שרעק,</para>
  <para style="q" vid="JOB 31:23">און פֿון װעגן זײַן גרױסקײט פֿלעג איך זיך נישט דערװעגן.<verse eid="JOB 31:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="JOB 31:24" />אױב איך האָב געמאַכט גאָלד מײַן האָפֿענונג,</para>
  <para style="q" vid="JOB 31:24">און אױף גינגאָלד געזאָגט מײַן בטחון;<verse eid="JOB 31:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 31:25" />אױב איך פֿלעג זיך פֿרײען װײַל מײַן פֿאַרמעג איז גרױס,</para>
  <para style="q" vid="JOB 31:25">און װײַל מײַן האַנט האָט דערגרײכט אַ סך;<verse eid="JOB 31:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 31:26" />אױב איך פֿלעג צוקוקן די זון װי זי שײַנט,</para>
  <para style="q" vid="JOB 31:26">אָדער די לבֿנה פּראַכטיק גײענדיק,<verse eid="JOB 31:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 31:27" />און מײַן האַרץ איז פֿאַרפֿירט געװאָרן אין פֿאַרבאָרגעניש,</para>
  <para style="q" vid="JOB 31:27">און מײַן מױל האָט געקושט מײַן האַנט;<verse eid="JOB 31:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 31:28" />װאָלט דאָס אױך געװען אַ זינד צום פֿאַרמשפּטן,</para>
  <para style="q" vid="JOB 31:28">װאָרעם איך װאָלט געלײקנט אָן אֵל אין דער הײך.<verse eid="JOB 31:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="JOB 31:29" />אױב איך פֿלעג זיך פֿרײען אױף דעם בראָך פֿון מײַן שׂונא,</para>
  <para style="q" vid="JOB 31:29">און בין געװען אױפֿגעראַמט אַז אים האָט געטראָפֿן בײז –<verse eid="JOB 31:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 31:30" />אַז איך האָב צו מאָל נישט געלאָזט מײַן גומען זינדיקן,</para>
  <para style="q" vid="JOB 31:30">צו בעטן אַ קללה אױף זײַן לעבן –<verse eid="JOB 31:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 31:31" />אױב די מענטשן פֿון מײַן געצעלט האָבן נישט געזאָגט:</para>
  <para style="q" vid="JOB 31:31">װער קען װײַזן אײנעם װאָס האָט זיך נישט אָנגעזעט מיט פֿלײש בײַ אים? –<verse eid="JOB 31:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 31:32" />אױף דער גאַס פֿלעגט נישט נעכטיקן אַ פֿרעמדער,</para>
  <para style="q" vid="JOB 31:32">מײַנע טירן צום װעג פֿלעג איך עפֿענען –<verse eid="JOB 31:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 31:33" />אױב איך האָב פֿאַרדעקט</para>
  <para style="q" vid="JOB 31:33">אַזױ װי אָדָם מײַנע פֿאַרברעכן,</para>
  <para style="q" vid="JOB 31:33">צו באַהאַלטן אין מײַן בוזעם מײַן זינד,<verse eid="JOB 31:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 31:34" />װײַל איך פֿלעג מורא האָבן פֿאַרן גרױסן המון,</para>
  <para style="q" vid="JOB 31:34">און די פֿאַראַכטונג פֿון משפּחות פֿלעגט מיך שרעקן,</para>
  <para style="q" vid="JOB 31:34">און איך האָב געשװיגן און בין פֿון טיר נישט אַרױס –<verse eid="JOB 31:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 31:35" />הלװאַי קריג איך ער זאָל מיר צוהערן!</para>
  <para style="q" vid="JOB 31:35">אָט איז מײַן אונטערשריפֿט, זאָל שַדַי מיר ענטפֿערן,</para>
  <para style="q" vid="JOB 31:35">און אַ געשריפֿטס זאָל אָנשרײַבן מײַן בַעַל-דין.<verse eid="JOB 31:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="JOB 31:36" />פֿאַר װאָר, איך װעל עס אױף מײַן אַקסל טראָגן!</para>
  <para style="q" vid="JOB 31:36">איך װעל עס מיר אָנבינדן אַזױ װי אַ קרױן.<verse eid="JOB 31:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="JOB 31:37" />די צאָל פֿון מײַנע טריט װעל איך אים דערצײלן;</para>
  <para style="q" vid="JOB 31:37">אַזױ װי אַ פֿירשט װעל איך צו אים גענענען.<verse eid="JOB 31:37" /></para>
  <para style="b" />
  <para style="q">
    <verse number="38" style="v" sid="JOB 31:38" />אױב מײַן ערד שרײַט אױס קעגן מיר,</para>
  <para style="q" vid="JOB 31:38">און אַלע אירע בײטן װײנען;<verse eid="JOB 31:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="JOB 31:39" />אױב איר קראַפֿט האָב איך געגעסן אָן געלט,</para>
  <para style="q" vid="JOB 31:39">און די נשמה פֿון אירע אַרבעטער געלאָזט אױסהױכן,<verse eid="JOB 31:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="JOB 31:40" />זאָל אַנשטאָט װײץ אױפֿגײן אַ דאָרן.</para>
  <para style="q" vid="JOB 31:40">און אַנשטאָט גערשט װילדגעװעקס.</para>
  <para style="b" vid="JOB 31:40" />
  <para style="p" vid="JOB 31:40">געענדיקט די װערטער פֿון אִיובֿן.<verse eid="JOB 31:40" /></para>
  <chapter eid="JOB 31" />
  <chapter number="32" style="c" pubnumber="לב" sid="JOB 32" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 32:1" />און די דאָזיקע דרײַ מענער האָבן אױפֿגעהערט ענטפֿערן אִיובֿן, װײַל ער איז געװען גערעכט אין זײַנע אױגן.<verse eid="JOB 32:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOB 32:2" />האָט געגרימט דער צאָרן פֿון אֶליהוא דעם זון פֿון בַרַכאֵל דעם בוזי פֿון דער משפּחה רָם; אױף אִיובֿן האָט געגרימט זײַן צאָרן פֿאַר װאָס ער מאַכט זיך גערעכטער פֿון אלֹקים, <verse eid="JOB 32:2" /><verse number="3" style="v" sid="JOB 32:3" />און אױף זײַנע דרײַ גוטע פֿרײַנט האָט געגרימט זײַן צאָרן פֿאַר װאָס זײ האָבן נישט געפֿונען אַן ענטפֿער, פֿון דעסט װעגן האָבן זײ באַשולדיקט אִיובֿן. <verse eid="JOB 32:3" /><verse number="4" style="v" sid="JOB 32:4" />און אֶליהוא האָט אָפּגעװאַרט מיט רײד אַקעגן אִיובֿן, װײַל זײ זײַנען געװען עלטער פֿון אים אין טעג. <verse eid="JOB 32:4" /><verse number="5" style="v" sid="JOB 32:5" />אָבער אַז אֶליהוא האָט געזען אַז קײן ענטפֿער איז נישטאָ אין מױל פֿון די דרײַ מענער האָט געגרימט זײַן צאָרן.<verse eid="JOB 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 32:6" />און אֶליהוא דער זון פֿון בַרַכאֵל דעם בוזי האָט זיך אָפּגערופֿן און האָט געזאָגט:</para>
  <para style="b" vid="JOB 32:6" />
  <para style="q" vid="JOB 32:6">ייִנגער בין איך פֿון אײַך אין טעג,</para>
  <para style="q" vid="JOB 32:6">און איר זײַט גרײַזן,</para>
  <para style="q" vid="JOB 32:6">דערום האָב איך מיך געשײַט און מורא געהאַט</para>
  <para style="q" vid="JOB 32:6">אײַך אַרױסזאָגן מײַן געדאַנק.<verse eid="JOB 32:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 32:7" />איך האָב געזאָגט: טעג זאָלן רעדן,</para>
  <para style="q" vid="JOB 32:7">און פֿיל יאָרן זאָלן מאַכן װיסן חכמה.<verse eid="JOB 32:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 32:8" />אָבער עס איז רוּחַ אין מענטשן,</para>
  <para style="q" vid="JOB 32:8">און דער אָטעם פֿון שַדַי װאָס מאַכט זײ פֿאַרשטאַנדיק.<verse eid="JOB 32:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 32:9" />נישט די גרױסע זײַנען חכמים,</para>
  <para style="q" vid="JOB 32:9">און נישט די זקנים פֿאַרשטײען װאָס איז גערעכט.<verse eid="JOB 32:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 32:10" />דערום זאָג איך: הער מיר צו,</para>
  <para style="q" vid="JOB 32:10">לאָמיך אױך אַרױסזאָגן מײַן געדאַנק.<verse eid="JOB 32:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="JOB 32:11" />זעט, איך האָב אָפּגעװאַרט אױף אײַערע רײד,</para>
  <para style="q" vid="JOB 32:11">איך האָב צוגעהאָרכט צו אײַערע חָכמות,</para>
  <para style="q" vid="JOB 32:11">בעת איר האָט געזוכט װערטער.<verse eid="JOB 32:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 32:12" />אָבער איך האָב זיך צוגעקוקט צו אײַך,</para>
  <para style="q" vid="JOB 32:12">ערשט נישטאָ װער זאָל באַװײַזן אִיובֿן,</para>
  <para style="q" vid="JOB 32:12">װער זאָל ענטפֿערן זײַנע װערטער, פֿון אײַך.<verse eid="JOB 32:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 32:13" />אפֿשר װעט איר זאָגן: מיר האָבן אָנגעטראָפֿן חכמה,</para>
  <para style="q" vid="JOB 32:13">אֵל קען אים אָפּשלאָגן, נישט אַ מענטש;<verse eid="JOB 32:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 32:14" />אָבער נישט ער האָט אָנגעריכט צו מיר די װערטער,</para>
  <para style="q" vid="JOB 32:14">און נישט מיט אײַערע רײד װעל איך אים ענטפֿערן.<verse eid="JOB 32:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 32:15" />זײ זײַנען דערשראָקן, זײ ענטפֿערן מער נישט,</para>
  <para style="q" vid="JOB 32:15">אָפּגענומען זײַנען די װערטער פֿון זײ.<verse eid="JOB 32:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 32:16" />און איך זאָל װאַרטן, װײַל זײ רעדן נישט,</para>
  <para style="q" vid="JOB 32:16">װײַל זײ שטײען און ענטפֿערן מער נישט?<verse eid="JOB 32:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 32:17" />איך אױך װעל ענטפֿערן מײַן חלק,</para>
  <para style="q" vid="JOB 32:17">איך אױך װעל אַרױסזאָגן מײַן געדאַנק.<verse eid="JOB 32:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 32:18" />װאָרעם איך בין פֿול מיט װערטער,</para>
  <para style="q" vid="JOB 32:18">מיך דריקט דער גײַסט פֿון מײַן לײַב.<verse eid="JOB 32:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 32:19" />זע, מײַן לײַב איז װי װײַן װאָס איז נישט געעפֿנט,</para>
  <para style="q" vid="JOB 32:19">װי נײַע לאָגלען װערט ער צעפּלאַצט.<verse eid="JOB 32:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 32:20" />איך װעל רעדן, און מיר װעט פֿרײַער װערן,</para>
  <para style="q" vid="JOB 32:20">איך װעל עפֿענען מײַנע ליפּן און ענטפֿערן.<verse eid="JOB 32:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 32:21" />לאָמיך נאָר נישט שױנען קײן מאַנס פּנים,</para>
  <para style="q" vid="JOB 32:21">און קײן מענטשן נישט חנפֿען.<verse eid="JOB 32:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 32:22" />װאָרעם איך װײס נישט װי צו חנפֿען;</para>
  <para style="q" vid="JOB 32:22">באַלד װאָלט מיך אַװעקנעמען מײַן באַשעפֿער.<verse eid="JOB 32:22" /></para>
  <chapter eid="JOB 32" />
  <chapter number="33" style="c" pubnumber="לג" sid="JOB 33" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 33:1" />אָבער הער אַקאָרשט, אִיובֿ, מײַנע רײד,</para>
  <para style="q" vid="JOB 33:1">און אַלע מײַנע װערטער פֿאַרנעם.<verse eid="JOB 33:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 33:2" />זע נאָר, איך האָב געעפֿנט מײַן מױל,</para>
  <para style="q" vid="JOB 33:2">מײַן צונג רעדט אין מײַן גומען.<verse eid="JOB 33:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 33:3" />אױפֿריכטיק פֿון מײַן האַרצן זײַנען מײַנע װערטער,</para>
  <para style="q" vid="JOB 33:3">און װאָס מײַנע ליפּן װײסן, זאָגן זײ קלאָר.<verse eid="JOB 33:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 33:4" />דער רוּחַ פֿון אֵל האָט מיך געמאַכט,</para>
  <para style="q" vid="JOB 33:4">און דער נְשָׁמָה פֿון שַדַי האַלט מיך בײַם לעבן.<verse eid="JOB 33:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 33:5" />אױב דו קענסט, ענטפֿער מיר,</para>
  <para style="q" vid="JOB 33:5">ברײט דיך אָן קעגן מיר, שטעל זיך אַװעק.<verse eid="JOB 33:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 33:6" />זע, איך בין אַזױ װי דו בײַ אֵל,</para>
  <para style="q" vid="JOB 33:6">איך אױך בין פֿון לײם געפֿורעמט געװאָרן.<verse eid="JOB 33:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 33:7" />זע, מײַן אימה שרעקט דיך נישט,</para>
  <para style="q" vid="JOB 33:7">און מײַן לאַסט דריקט נישט אױף דיר.<verse eid="JOB 33:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="JOB 33:8" />יאָ, האָסט געזאָגט אין מײַנע אױערן,</para>
  <para style="q" vid="JOB 33:8">און דעם קֹול פֿון די װערטער האָב איך געהערט:<verse eid="JOB 33:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 33:9" />רײן בין איך, אָן אַ פֿאַרברעך,</para>
  <para style="q" vid="JOB 33:9">לױטער בין איך, און האָב נישט קײן זינד:<verse eid="JOB 33:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 33:10" />זע, בילבולים געפֿינט ער אױף מיר,</para>
  <para style="q" vid="JOB 33:10">ער רעכנט מיך פֿאַר זײַן שׂונא;<verse eid="JOB 33:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 33:11" />ער טוט אַרײַן אין אַ קלאָץ מײַנע פֿיס,</para>
  <para style="q" vid="JOB 33:11">ער היט אַלע מײַנע שטעגן.<verse eid="JOB 33:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="JOB 33:12" />אָט אין דעם ביסטו נישט גערעכט, װעל איך דיר ענטפֿערן,</para>
  <para style="q" vid="JOB 33:12">װאָרעם אֱלוֹהַּ איז גרעסער פֿון מענטשן.<verse eid="JOB 33:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 33:13" />פֿאַר װאָס קריגסטו זיך מיט אים,</para>
  <para style="q" vid="JOB 33:13">װאָס ער פֿאַרענטפֿערט נישט אַלע זײַנע מעשׂים?<verse eid="JOB 33:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 33:14" />װאָרעם אױף אײן שטײגער רעדט אֵל,</para>
  <para style="q" vid="JOB 33:14">און אױף צװײ, הגם מע מערקט עס נישט.<verse eid="JOB 33:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 33:15" />אין אַ חלום, אַ זעונג פֿון דער נאַכט,</para>
  <para style="q" vid="JOB 33:15">װען אַ טיפֿער שלאָף פֿאַלט אױף מענטשן,</para>
  <para style="q" vid="JOB 33:15">אין שלומער אױפֿן געלעגער,<verse eid="JOB 33:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 33:16" />דענצמאָל אַנטפּלעקט ער דעם אױער פֿון מענטשן,</para>
  <para style="q" vid="JOB 33:16">און פֿאַרחתמעט מיט אַ מוסר צו זײ,<verse eid="JOB 33:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 33:17" />כּדי דער מענטש זאָל אַװעקװאַרפֿן זײַן טאָן;</para>
  <para style="q" vid="JOB 33:17">און ער באַשירעמט פֿון האָפֿערדיקײט דעם מאַן.<verse eid="JOB 33:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 33:18" />ער פֿאַרמײַדט זײַן זעל פֿון שַחַת,</para>
  <para style="q" vid="JOB 33:18">און זײַן לעבן פֿון אומקומען דורכן שװערד.<verse eid="JOB 33:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 33:19" />אָדער ער װערט געשטראָפֿט מיט װײטאָג אױף זײַן געלעגער,</para>
  <para style="q" vid="JOB 33:19">און אַלע זײַנע בײנער װערן שטײַף.<verse eid="JOB 33:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 33:20" />און זײַן לעבן מאַכט אים זיך עקלען מיט ברױט,</para>
  <para style="q" vid="JOB 33:20">און זײַן זעל מיטן גלוסטיקסטן מאכל.<verse eid="JOB 33:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 33:21" />אָפּגעצערט װערט זײַן פֿלײש פֿון פּנים,</para>
  <para style="q" vid="JOB 33:21">און אײַנגעדאַרט זײַנע בײנער, נישט אָנצוקוקן.<verse eid="JOB 33:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 33:22" />און זײַן זעל גענענט צו דער שַחַת,</para>
  <para style="q" vid="JOB 33:22">און זײַן לעבן צו די טײטער.<verse eid="JOB 33:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 33:23" />אױב עס איז דאָ פֿאַר אים אַ מלאך,</para>
  <para style="q" vid="JOB 33:23">אַ מליץ-יושר אַפֿילו אײנער פֿון טױזנט,</para>
  <para style="q" vid="JOB 33:23">כּדי דעם מענטשן אַנצוּזאגען זײַנע גערעכטפערטיקונג,<verse eid="JOB 33:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 33:24" />לײַטזעליקט ער אים, און זאָגט:</para>
  <para style="q" vid="JOB 33:24">לײז אים אױס פֿון נידערן אין גרוב;</para>
  <para style="q" vid="JOB 33:24">איך האָב געפֿונען אַן אױסלײז.<verse eid="JOB 33:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 33:25" />זײַן לײַב װערט פֿרישער װי ייִנגלװײַז,</para>
  <para style="q" vid="JOB 33:25">ער קערט זיך אום צו די טעג פֿון זײַן יוגנט.<verse eid="JOB 33:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 33:26" />ער בעט צו אֱלוֹהַּ, און ער באַװיליקט אים,</para>
  <para style="q" vid="JOB 33:26">און ער זעט זײַן פּנים מיט חֵן,</para>
  <para style="q" vid="JOB 33:26">און קערט אום דעם מענטשן זײַן גערעכטיקײט.<verse eid="JOB 33:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 33:27" />ער קומט פֿאַר מענטשן װאָס זאָגט:</para>
  <para style="q" vid="JOB 33:27">איך האָב געזינדיקט, און װאָס איז רעכט האָב איך פֿאַרדרײט,</para>
  <para style="q" vid="JOB 33:27">און עס איז מיר נישט באַצאָלט.<verse eid="JOB 33:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 33:28" />אַזױ לײזט ער אױס זײַן זעל פֿון גײן אין גרוב,</para>
  <para style="q" vid="JOB 33:28">און זײַן לעבן זעט די ליכטיקײט.<verse eid="JOB 33:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="JOB 33:29" />זע, דאָס אַלץ טוט אֵל,</para>
  <para style="q" vid="JOB 33:29">צװײ מאָל, דרײַ מאָל, מיט אַ מענטשן,<verse eid="JOB 33:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 33:30" />כּדי אומצוקערן זײַן זעל פֿון גרוב,</para>
  <para style="q" vid="JOB 33:30">דערלוכטן צו װערן אין ליכט פֿון לעבן.<verse eid="JOB 33:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="JOB 33:31" />פֿאַרנעם, אִיובֿ, הער מיר צו;</para>
  <para style="q" vid="JOB 33:31">שװײַג, און איך װעל רעדן.<verse eid="JOB 33:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 33:32" />אױב דו האָסט װערטער, ענטפֿער מיר,</para>
  <para style="q" vid="JOB 33:32">רעד, װאָרעם איך װעל דיך גערעכט מאַכן.<verse eid="JOB 33:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 33:33" />אױב נישט, הער דו מיר צו;</para>
  <para style="q" vid="JOB 33:33">שװײַג, און איך װעל דיך לערנען חכמה.<verse eid="JOB 33:33" /></para>
  <chapter eid="JOB 33" />
  <chapter number="34" style="c" pubnumber="לד" sid="JOB 34" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 34:1" />און אֶליהוא האָט זיך אָפּגערופֿן און האָט געזאָגט:<verse eid="JOB 34:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 34:2" />הערט, חכמים, מײַנע װערטער,</para>
  <para style="q" vid="JOB 34:2">און איר קענער, לײגט צו דאָס אױער צו מיר.<verse eid="JOB 34:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 34:3" />װאָרעם דאָס אױער דאַרף פּרוּװן װערטער,</para>
  <para style="q" vid="JOB 34:3">אַזױ װי דער גומען פֿאַרזוכט עסן.<verse eid="JOB 34:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 34:4" />לאָמיר אונדז אױסװײלן דאָס גערעכטע,</para>
  <para style="q" vid="JOB 34:4">לאָמיר געװאָר װערן צװישן אונדז װאָס איז גוט.<verse eid="JOB 34:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 34:5" />װאָרעם אִיובֿ זאָגט: איך בין גערעכט,</para>
  <para style="q" vid="JOB 34:5">נאָר אֵל האָט אָפּגעטאָן מײַן רעכט;<verse eid="JOB 34:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 34:6" />בײַ מײַן גערעכטיקײט װער איך געהאַלטן פֿאַר אַ ליגנער,</para>
  <para style="q" vid="JOB 34:6">מסוכּן איז מײַן װוּנד, אָן אַ פֿאַרברעך.<verse eid="JOB 34:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 34:7" />װאָסער מענטש װי אִיובֿ</para>
  <para style="q" vid="JOB 34:7">טרינקט געשפּעט אַזױ װי װאַסער,<verse eid="JOB 34:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 34:8" />און פֿירט זיך אין חבֿרותא מיט טוער פֿון אומרעכט,</para>
  <para style="q" vid="JOB 34:8">און גײט אום מיט שלעכטע לײַט?<verse eid="JOB 34:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 34:9" />װאָרעם ער זאָגט: דעם מענטשן קומט גאָרנישט אַרױס</para>
  <para style="q" vid="JOB 34:9">װען ער זוכט װױלגעפֿעלן אלֹקים.<verse eid="JOB 34:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 34:10" />דערום, לײַט מיט פֿאַרשטאַנדיקײט, הערט מיר צו:</para>
  <para style="q" vid="JOB 34:10">װײַט איז אֵל פֿון אומרעכט,</para>
  <para style="q" vid="JOB 34:10">און שַדַי פֿון אַן עװלה.<verse eid="JOB 34:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 34:11" />נאָר די טוּונג פֿון מענטשן באַצאָלט ער אים,</para>
  <para style="q" vid="JOB 34:11">און לױט איטלעכנס װעג שיקט ער אים צו.<verse eid="JOB 34:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 34:12" />יאָ פֿאַר װאָר, אֵל טוט נישט קײן אומרעכט,</para>
  <para style="q" vid="JOB 34:12">און שַדַי פֿאַרדרײט נישט גערעכטיקײט.<verse eid="JOB 34:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 34:13" />װער האָט אים באַפֿױלן איבער דער ערד?</para>
  <para style="q" vid="JOB 34:13">און װער האָט געמאַכט די װעלט אין גאַנצן?<verse eid="JOB 34:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 34:14" />אַז ער זאָל קערן זײַן האַרץ אױף אים,</para>
  <para style="q" vid="JOB 34:14">אַז ער זאָל זײַן הױך און זײַן אָטעם אײַנזאַמלען צו זיך,<verse eid="JOB 34:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 34:15" />װאָלט פֿאַרגײן יעטװעדער לײַב אין אײנעם,</para>
  <para style="q" vid="JOB 34:15">און דער מענטש װאָלט צו שטױב זיך אומקערן.<verse eid="JOB 34:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 34:16" />און אױב דו האָסט פֿאַרשטאַנדיקײט, הער דאָס צו;</para>
  <para style="q" vid="JOB 34:16">פֿאַרנעם דעם קֹול פֿון מײַנע װערטער.<verse eid="JOB 34:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 34:17" />צי קען גאָר אַ פֿײַנט פֿון גערעכטיקײט הערשן?</para>
  <para style="q" vid="JOB 34:17">אָדער װילסטו דעם מאַכטיקן גערעכטן באַשולדיקן? –<verse eid="JOB 34:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 34:18" />קען מען זאָגן צו אַ מלך נידערטרעכטיקער?</para>
  <para style="q" vid="JOB 34:18">רשע צו פֿירשטן? –<verse eid="JOB 34:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 34:19" />דעם װאָס שאַנעװעט נישט דעם פּנים פֿון האַרן,</para>
  <para style="q" vid="JOB 34:19">און אַכט נישט אױפֿן רײַכן מער װי אױפֿן אָרעמאַן,</para>
  <para style="q" vid="JOB 34:19">װײַל דאָס װערק פֿון זײַנע הענט זײַנען זײ אַלע.<verse eid="JOB 34:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 34:20" />אין אַ רגע שטאַרבן זײ, אין האַלבע נאַכט;</para>
  <para style="q" vid="JOB 34:20">לײַט װערן צעטרײסלט און פֿאַרגײען,</para>
  <para style="q" vid="JOB 34:20">און מע טוט אָפּ דעם מאַכטיקן װי נישט מיט דער האַנט.<verse eid="JOB 34:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JOB 34:21" />װאָרעם זײַנע אױגן זײַנען אױף די װעגן פֿון דעם מענטשן,</para>
  <para style="q" vid="JOB 34:21">און אַלע זײַנע טריט זעט ער.<verse eid="JOB 34:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 34:22" />נישטאָ קײן פֿינצטערניש און קײן טױטשאָטן,</para>
  <para style="q" vid="JOB 34:22">פֿאַר די טוער פֿון אומרעכט זיך דאָרטן צו פֿאַרבאָרגן.<verse eid="JOB 34:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 34:23" />װאָרעם ער מאַכט נישט דעם מענטשן אַ צײַט,</para>
  <para style="q" vid="JOB 34:23">צו קומען פֿאַר אֵל צום משפּט.<verse eid="JOB 34:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 34:24" />ער צעברעכט מאַכטיקע אָן אַן אױספֿאָרשונג,</para>
  <para style="q" vid="JOB 34:24">און שטעלט אױף אַנדערע אַנשטאָט זײ.<verse eid="JOB 34:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 34:25" />פֿאַר װאָר, ער קען זײערע מעשׂים,</para>
  <para style="q" vid="JOB 34:25">דערום מאַכט ער אַן איבערקער איבער נאַכט,</para>
  <para style="q" vid="JOB 34:25">און זײ װערן צעדריקט.<verse eid="JOB 34:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 34:26" />װײַל זײ זײַנען רשעים, שלאָגט ער זײ,</para>
  <para style="q" vid="JOB 34:26">אין אַן אָרט װוּ מע זעט.<verse eid="JOB 34:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 34:27" />דערפֿאַר װאָס זײ האָבן זיך אָפּגעקערט פֿון אים,</para>
  <para style="q" vid="JOB 34:27">און אױף אַלע זײַנע װעגן נישט געאַכט.<verse eid="JOB 34:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 34:28" />זײ האָבן געמאַכט קומען צו אים דאָס געשרײ פֿון דעם אָרעמאַן,</para>
  <para style="q" vid="JOB 34:28">און דאָס געשרײ פֿון די געדריקטע פֿלעגט ער הערן. –<verse eid="JOB 34:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 34:29" />אָבער אַז ער שװײַגט, װער קען אים באַשולדיקן?</para>
  <para style="q" vid="JOB 34:29">און פֿאַרבאָרגט ער דעם פּנים, װער קען אים װעלן זען?</para>
  <para style="q" vid="JOB 34:29">סײַ בײַ אַ פֿאָלק סײַ בײַ אַ מענטשן אַלץ אײנס. –<verse eid="JOB 34:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 34:30" />כּדי דער זינדיקער מענטש זאָל נישט קיניגן,</para>
  <para style="q" vid="JOB 34:30">כּדי קײן שטרױכלונגען זאָלן נישט זײַן פֿאַרן פֿאָלק.<verse eid="JOB 34:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 34:31" />װאָרעם האָט ער דען צו אֵל געזאָגט:</para>
  <para style="q" vid="JOB 34:31">איך האָב געליטן, איך װעל מער נישט שלעכטס טאָן;<verse eid="JOB 34:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 34:32" />איך זע נישט, לערן דו מיך;</para>
  <para style="q" vid="JOB 34:32">אױב איך האָב געטאָן אומרעכט, װעל איך מער נישט טאָן?<verse eid="JOB 34:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 34:33" />זאָל ער פֿאַרגעלטן אַזױ װי דיר קומט אױס:</para>
  <para style="q" vid="JOB 34:33">אױב דיר געפֿעלט נישט, טאָ קלײַב דו אױס, און נישט איך?</para>
  <para style="q" vid="JOB 34:33">און װאָס װײסטו צו רעדן?<verse eid="JOB 34:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 34:34" />לײַט מיט פֿאַרשטאַנדיקײט װעלן מיר זאָגן,</para>
  <para style="q" vid="JOB 34:34">און דער קלוגער מאַן װאָס װעט מיר צוהערן:<verse eid="JOB 34:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 34:35" />אִיובֿ רעדט אָן אַ זינען,</para>
  <para style="q" vid="JOB 34:35">און זײַנע רײד זײַנען אָן שׂכל.<verse eid="JOB 34:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="JOB 34:36" />איך װינטש אִיובֿ זאָל אײביק געפּרוּװט װערן,</para>
  <para style="q" vid="JOB 34:36">פֿאַר ענטפֿערן אַזױ װי זינדיקע לײַט.<verse eid="JOB 34:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="JOB 34:37" />װאָרעם ער לײגט נאָך צו װידערשפּעניקײט צו זײַן חטא;</para>
  <para style="q" vid="JOB 34:37">ער פּאַטשט זײַנע הענט צװישן אונדז,</para>
  <para style="q" vid="JOB 34:37">און מערט זײַנע רײד קעגן אֵל.<verse eid="JOB 34:37" /></para>
  <chapter eid="JOB 34" />
  <chapter number="35" style="c" pubnumber="לה" sid="JOB 35" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 35:1" />און אֶליהוא האָט זיך אָפּגערופֿן און האָט געזאָגט:<verse eid="JOB 35:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 35:2" />רעכנסטו דאָס פֿאַר רעכט, אַז דו זאָגסט:</para>
  <para style="q" vid="JOB 35:2">איך בין גערעכטער פֿון אֵל?<verse eid="JOB 35:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 35:3" />װען דו זאָגסט: װאָס קומט דיר אַרױס?</para>
  <para style="q" vid="JOB 35:3">װאָסער נוץ האָב איך דערפֿון מער װי פֿון מײַן זינדיקן?<verse eid="JOB 35:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 35:4" />װעל איך דיר ענטפֿערן װערטער,</para>
  <para style="q" vid="JOB 35:4">און דײַנע חבֿרים מיט דיר.<verse eid="JOB 35:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 35:5" />לוג צו די הימלען, און זע,</para>
  <para style="q" vid="JOB 35:5">און קוק אױף די װאָלקנס װאָס זײַנען הױך איבער דיר.<verse eid="JOB 35:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 35:6" />אַז דו זינדיקסט, װאָס װירקסטו אױף אים?</para>
  <para style="q" vid="JOB 35:6">און זײַנען פֿיל דײַנע פֿאַרברעכן, װאָס טוסטו אים?<verse eid="JOB 35:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 35:7" />אַז דו ביסט גערעכט, װאָס גיסטו אים?</para>
  <para style="q" vid="JOB 35:7">אָדער װאָס נעמט ער פֿון דײַן האַנט?<verse eid="JOB 35:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 35:8" />אַ מאַן װי דו גײט אָן דײַן שלעכטיקײט,</para>
  <para style="q" vid="JOB 35:8">און אַ מענטשנקינד דײַן גערעכטיקײט.<verse eid="JOB 35:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 35:9" />פֿון װעגן די פֿיל רױבערײַען שרײַט מען,</para>
  <para style="q" vid="JOB 35:9">מע קלאָגט זיך װעגן דעם אָרעם פֿון די שטאַרקע,<verse eid="JOB 35:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 35:10" />און מע זאָגט נישט: װוּ איז אֱלוֹהַּ מײַן באַשעפֿער,</para>
  <para style="q" vid="JOB 35:10">װאָס גיט געזאַנגען אין דער נאַכט;<verse eid="JOB 35:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 35:11" />װאָס לערנט אונדז מער פֿון בהמות פֿון דער ערד,</para>
  <para style="q" vid="JOB 35:11">און מאַכט אונדז קליגער פֿון פֿױגל פֿון הימל?<verse eid="JOB 35:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 35:12" />אָן שרײַט מען, און ער ענטפֿערט נישט,</para>
  <para style="q" vid="JOB 35:12">װעגן דער האָפֿערדיקײט פֿון די רשעים.<verse eid="JOB 35:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 35:13" />אָבער פֿאַלש איז, אַז אֵל הערט נישט צו,</para>
  <para style="q" vid="JOB 35:13">און שַדַי קוקט עס נישט אָן.<verse eid="JOB 35:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 35:14" />הגם דו זאָגסט, דו קענסט אים נישט זען,</para>
  <para style="q" vid="JOB 35:14">איז דער משפּט פֿאַר אים,</para>
  <para style="q" vid="JOB 35:14">און דאַרפֿסט האַרן אױף אים.<verse eid="JOB 35:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 35:15" />און אַצונד, האָט דען פֿאַר גאָרנישט געשטראָפֿט זײַן צאָרן?</para>
  <para style="q" vid="JOB 35:15">און װײס ער נישט װױל פֿון דער מוטװיליקײט?<verse eid="JOB 35:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 35:16" />אָבער אִיובֿ עפֿנט מיט נאַרישקײט זײַן מױל,</para>
  <para style="q" vid="JOB 35:16">אָן פֿאַרשטאַנדיקײט מערט ער װערטער.<verse eid="JOB 35:16" /></para>
  <chapter eid="JOB 35" />
  <chapter number="36" style="c" pubnumber="לו" sid="JOB 36" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 36:1" />און אֶליהוא האָט װײַטער געזאָגט:<verse eid="JOB 36:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 36:2" />װאַרט מיר אַ װײַלע, און איך װעל דיר זאָגן,</para>
  <para style="q" vid="JOB 36:2">װאָרעם פֿאַראַן נאָך װערטער װעגן אֱלוֹהַּ.<verse eid="JOB 36:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 36:3" />איך װעל אױפֿהײבן מײַן געדאַנק װײַט אַהין,</para>
  <para style="q" vid="JOB 36:3">און מײַן באַשעפֿער װעל איך געבן גערעכטיקײט.<verse eid="JOB 36:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 36:4" />װאָרעם פֿאַר װאָר, נישט פֿאַלש זײַנען מײַנע װערטער,</para>
  <para style="q" vid="JOB 36:4">אױפֿריכטיק אין געדאַנקען בין איך צו דיר.<verse eid="JOB 36:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 36:5" />זע, אֵל איז מאַכטיק, אָבער ער פֿאַראַכט קײנעם נישט;</para>
  <para style="q" vid="JOB 36:5">ער איז מאַכטיק אין כּוֹח פֿון פֿאַרשטאַנדיקײט.<verse eid="JOB 36:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 36:6" />ער לאָזט נישט דעם רשע בלײַבן לעבן,</para>
  <para style="q" vid="JOB 36:6">און גיט די אָרימע זײער רעכט.<verse eid="JOB 36:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 36:7" />ער נעמט נישט אַראָפּ זײַנע אױגן פֿון דעם צדיק;</para>
  <para style="q" vid="JOB 36:7">און מיט מלכים אױפֿן טראָן זעצט ער זײ אױף אײביק,</para>
  <para style="q" vid="JOB 36:7">און זײ װערן דערהײכט.<verse eid="JOB 36:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 36:8" />און אױב זײ זײַנען געשמידט אין קײטן,</para>
  <para style="q" vid="JOB 36:8">באַצװוּנגען אין שטריק פֿון פּײַן,<verse eid="JOB 36:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 36:9" />רעדט ער זײ אױס זײער טוּונג,</para>
  <para style="q" vid="JOB 36:9">און זײערע פֿאַרברעכן װען זײ שטאַרקן זיך.<verse eid="JOB 36:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 36:10" />ער אַנטפּלעקט זײער אױער פֿאַר מוסר,</para>
  <para style="q" vid="JOB 36:10">און הײסט, אַז זײ זאָלן זיך אומקערן פֿון אומרעכט.<verse eid="JOB 36:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 36:11" />אױב זײ הערן, און דינען,</para>
  <para style="q" vid="JOB 36:11">ענדיקן זײ זײערע טעג אין גוטס,</para>
  <para style="q" vid="JOB 36:11">און זײערע יאָרן אין נַחַת.<verse eid="JOB 36:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 36:12" />און אױב זײ הערן נישט, קומען זײ אום דורכן שװערד,</para>
  <para style="q" vid="JOB 36:12">און פֿאַרגײען אָן פֿאַרשטאַנדיקײט.<verse eid="JOB 36:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 36:13" />אָבער די זינדיקע אין האַרצן לײגן אָן צאָרן;</para>
  <para style="q" vid="JOB 36:13">זײ שרײַען נישט צו אים װען ער בינדט זײ.<verse eid="JOB 36:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 36:14" />אין יוגנט שטאַרבט זײער זעל,</para>
  <para style="q" vid="JOB 36:14">און זײער לעבן – װי די שאַנדיונגען.<verse eid="JOB 36:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 36:15" />ער ראַטעװעט דעם געדריקטן דורך זײַן געדריקטקײט,</para>
  <para style="q" vid="JOB 36:15">און אַנטפּלעקט דורך דער נױט זײער אױער.<verse eid="JOB 36:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 36:16" />און אױך דיך װאָלט ער אַרױסגעצױגן פֿון דער קלעם,</para>
  <para style="q" vid="JOB 36:16">אין דערברײטערניש װוּ קײן ענגשאַפֿט איז נישטאָ;</para>
  <para style="q" vid="JOB 36:16">און דאָס געדעק פֿון דײַן טיש װאָלט פֿול זײַן מיט פֿעטקײט.<verse eid="JOB 36:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 36:17" />װײַל אָבער ביסט פֿול מיט דער טענה פֿון דעם רשע</para>
  <para style="q" vid="JOB 36:17">האַלט דיך דער משפּט און די גערעכטיקײט.<verse eid="JOB 36:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 36:18" />פֿאַר װאָר, עס איז דאָ צאָרן, אַזױ היט זיך אַז דו זאָלסט נישט אַװעקגענומען װערן מיט אַ שלאָג,</para>
  <para style="q" vid="JOB 36:18">װאָס אַפֿילו אַ גרױסע אױסלײזונג װעט דיך נישט דערפֿון קענען באַפֿרײַען.<verse eid="JOB 36:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 36:19" />זאָל ער דען שאַצן דײַן רײַכטום?</para>
  <para style="q" vid="JOB 36:19">נײן, קײן שום גאָלד און קײן שום כּוֹח.<verse eid="JOB 36:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 36:20" />זאָלסט נישט געלוסטן די נאַכט,</para>
  <para style="q" vid="JOB 36:20">װען פֿעלקער װערן פֿאַרשװוּנדן אױפֿן אָרט.<verse eid="JOB 36:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 36:21" />היט זיך זאָלסט זיך נישט קערן צו אומרעכט,</para>
  <para style="q" vid="JOB 36:21">הגם דו װאָלסט דאָס אױסדערװײלט אײדער פּײַן.<verse eid="JOB 36:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="JOB 36:22" />זע, אֵל איז דערהױבן אין זײַן שטאַרקײט;</para>
  <para style="q" vid="JOB 36:22">װער איז אַזאַ לערער װי ער?<verse eid="JOB 36:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 36:23" />װער האָט אים באַפֿױלן זײַן װעג?</para>
  <para style="q" vid="JOB 36:23">און װער קען זאָגן: דו טוסט אַן עװלה?<verse eid="JOB 36:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 36:24" />געדענק, אַז דו זאָלסט גרײסן זײַן װערק</para>
  <para style="q" vid="JOB 36:24">װאָס מענטשן האָבן באַזונגען.<verse eid="JOB 36:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 36:25" />אַלע מענטשנקינדער האָבן עס געזען,</para>
  <para style="q" vid="JOB 36:25">דער מענטש קוקט עס אָן פֿון דער װײַטן.<verse eid="JOB 36:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 36:26" />זע, אֵל איז גרױס, און מיר פֿאַרשטײען נישט,</para>
  <para style="q" vid="JOB 36:26">די צאָל פֿון זײַנע יאָרן איז נישט צו דערפֿאָרשן.<verse eid="JOB 36:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 36:27" />װאָרעם ער ציט אָפּ די טראָפּנס װאַסער,</para>
  <para style="q" vid="JOB 36:27">זײ זאָלן זײַען רעגן פֿון זײַן נעפּל;<verse eid="JOB 36:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 36:28" />װען די הימלען פֿליסן,</para>
  <para style="q" vid="JOB 36:28">און טריפֿן אױף מענטשן אַ סך.<verse eid="JOB 36:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 36:29" />יאָ, צי פֿאַרשטײט מען די שפּרײטונגען פֿון װאָלקן,</para>
  <para style="q" vid="JOB 36:29">די געפּילדערס פֿון זײַן געצעלט?<verse eid="JOB 36:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 36:30" />זע, ער שפּרײט אױס דערױף זײַן ליכט;</para>
  <para style="q" vid="JOB 36:30">און די װאָרצלען פֿון ים דעקט ער צו.<verse eid="JOB 36:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 36:31" />װאָרעם דערמיט משפּט ער פֿעלקער,</para>
  <para style="q" vid="JOB 36:31">גיט ער שפּײַז אין שפֿע.<verse eid="JOB 36:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 36:32" />ער שפּרײט אױס אױפֿן הימלװעלב דעם בליץ,</para>
  <para style="q" vid="JOB 36:32">און באַפֿעלט אים ער זאָל טרעפֿן.<verse eid="JOB 36:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 36:33" />עס זאָגט אָן װעגן אים</para>
  <para style="q" vid="JOB 36:33">דער צאָרן, דער כּעס פֿון דעם שטורעם.<verse eid="JOB 36:33" /></para>
  <chapter eid="JOB 36" />
  <chapter number="37" style="c" pubnumber="לז" sid="JOB 37" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 37:1" />יאָ, דערפֿון ציטערט מײַן האַרץ,</para>
  <para style="q" vid="JOB 37:1">און שפּרינגט אױף פֿון זײַן אָרט.<verse eid="JOB 37:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 37:2" />הערט, הערט די אומרו פֿון זײַן קֹול,</para>
  <para style="q" vid="JOB 37:2">און דעם ברום װאָס גײט אַרױס פֿון זײַן מױל.<verse eid="JOB 37:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 37:3" />אונטערן גאַנצן הימל לאָזט ער אים לױז,</para>
  <para style="q" vid="JOB 37:3">און זײַן בליץ איז ביז די ברעגן פֿון דער ערד.<verse eid="JOB 37:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 37:4" />הינטער דעם ברילט אַ קֹול;</para>
  <para style="q" vid="JOB 37:4">ער דונערט מיט דעם קֹול פֿון זײַן גרױסקײט;</para>
  <para style="q" vid="JOB 37:4">און מע קען זײ נישט אָפּהאַלטן, װען זײַן קֹול װערט געהערט.<verse eid="JOB 37:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 37:5" />אֵל דונערט װוּנדערלעך מיט זײַן קֹול,</para>
  <para style="q" vid="JOB 37:5">ער טוט גרױסע זאַכן און מיר פֿאַרשטײען נישט.<verse eid="JOB 37:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 37:6" />װאָרעם ער זאָגט צום שנײ: פֿאַל אױף דער ערד!</para>
  <para style="q" vid="JOB 37:6">דאָס גלײַכן צום גוסרעגן,</para>
  <para style="q" vid="JOB 37:6">צום גוס פֿון זײַנע מאַכטיקע רעגנס.<verse eid="JOB 37:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 37:7" />ער פֿאַרחתמעט די האַנט פֿון יעטװעדער מענטשן,</para>
  <para style="q" vid="JOB 37:7">אַז אַלע מענטשן פֿון זײַן באַשאַף זאָלן װיסן.<verse eid="JOB 37:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 37:8" />און די חיה גײט אַרײַן אין באַהעלטעניש,</para>
  <para style="q" vid="JOB 37:8">און רוט אין אירע נאָרעס.<verse eid="JOB 37:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 37:9" />פֿון דער קאַמער קומט דער שטורעם,</para>
  <para style="q" vid="JOB 37:9">און פֿון צפֿון-װינטן די קעלט.<verse eid="JOB 37:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 37:10" />פֿון דעם אָטעם פֿון אֵל גיט עס אײַז,</para>
  <para style="q" vid="JOB 37:10">און ברײטע װאַסערן װערן פֿעסט.<verse eid="JOB 37:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 37:11" />יאָ, ער לאָדט אָן מיט פֿײַכטיקײט דעם װאָלקן,</para>
  <para style="q" vid="JOB 37:11">ער שפּרײט פֿונאַנדער זײַן בליצכמאַרע.<verse eid="JOB 37:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 37:12" />און דאָס דרײט זיך רונד אַרום דורך זײַן קירעװען</para>
  <para style="q" vid="JOB 37:12">כּדי זײ זאָלן טאָן אַלץ װאָס ער באַפֿעלט זײ</para>
  <para style="q" vid="JOB 37:12">אױפֿן געזיכט פֿון דער ערדישער װעלט;<verse eid="JOB 37:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 37:13" />סײַ ער שיקט עס פֿאַר אַ שטראָף,</para>
  <para style="q" vid="JOB 37:13">סײַ פֿאַר זײַן ערד, סײַ פֿאַר גענאָד.<verse eid="JOB 37:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JOB 37:14" />פֿאַרנעם דאָס דאָזיקע, אִיובֿ,</para>
  <para style="q" vid="JOB 37:14">שטײ און באַטראַכט די װוּנדער פֿון אֵל.<verse eid="JOB 37:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 37:15" />װײסטו װי אֱלוֹהַּ לײגט עס אַרױף אױף זײ,</para>
  <para style="q" vid="JOB 37:15">און מאַכט לײַכטן דעם בליץ פֿון זײַן כמאַרע?<verse eid="JOB 37:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 37:16" />פֿאַרשטײסטו דעם מִשקוֹלֶת פֿונעם װאָלקן,</para>
  <para style="q" vid="JOB 37:16">די װוּנדער פֿון דעם אַלװײסיקן?<verse eid="JOB 37:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 37:17" />װי אַזױ דײַנע בגדים װערן הײס,</para>
  <para style="q" vid="JOB 37:17">װען די ערד ליגט שטיל פֿון דָרום-װינט?<verse eid="JOB 37:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 37:18" />קענסטו אױסשפּרײטן די הימלען מיט אים,</para>
  <para style="q" vid="JOB 37:18">פֿעסט װי אַ געגאָסענער שפּיגל?<verse eid="JOB 37:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 37:19" />מאַך אונדז װיסן װאָס מיר זאָלן זאָגן צו אים;</para>
  <para style="q" vid="JOB 37:19">מיר װײסן קײן לאַד נישט פֿון װעגן דער פֿינצטערניש.<verse eid="JOB 37:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 37:20" />דאַרף אים דערצײלט װערן אַז איך רעד?</para>
  <para style="q" vid="JOB 37:20">צי דאַרף אַ מענטש אים אױסזאָגן, װען עס איז פֿאַרהױלן?<verse eid="JOB 37:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JOB 37:21" />און אָקערשט האָט מען נישט געזען אַ העלן שײַן אין הימל,</para>
  <para style="q" vid="JOB 37:21">איז אַ װינט אַריבער, און האָט אים אױסגעלײַטערט.<verse eid="JOB 37:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 37:22" />פֿון צפֿון קומט אַ גילדערנע ליכטיקײט,</para>
  <para style="q" vid="JOB 37:22">אַ מוֹראדיקער גלאַנץ איז אַרום אֱלוֹהַּ.<verse eid="JOB 37:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 37:23" />שַדַי, אים קענען מיר נישט אױסגעפֿינען;</para>
  <para style="q" vid="JOB 37:23">ער איז גרױס אין כּוֹח,</para>
  <para style="q" vid="JOB 37:23">אָבער רעכט און פֿולע גערעכטיקײט</para>
  <para style="q" vid="JOB 37:23">קריװדעט ער נישט.<verse eid="JOB 37:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 37:24" />דערום פֿאָרכטן אים די מענטשן;</para>
  <para style="q" vid="JOB 37:24">ער קוקט זיך נישט אום אױף אַלע קלוגהאַרציקע.<verse eid="JOB 37:24" /></para>
  <chapter eid="JOB 37" />
  <chapter number="38" style="c" pubnumber="לח" sid="JOB 38" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 38:1" />און ה׳ האָט געענטפֿערט אִיובֿן פֿון שטורעם,</para>
  <para style="q" vid="JOB 38:1">און האָט געזאָגט:<verse eid="JOB 38:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 38:2" />װער פֿאַרטונקלט דאָס די כּװנה</para>
  <para style="q" vid="JOB 38:2">מיט װערטער אָן פֿאַרשטאַנדיקײט?<verse eid="JOB 38:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 38:3" />גורט אַקאָרשט אָן װי אַ מאַן דײַנע לענדן,</para>
  <para style="q" vid="JOB 38:3">און איך װעל דיך פֿרעגן, און דו מאַך מיך װיסן.<verse eid="JOB 38:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 38:4" />װוּ ביסטו געװען װען איך האָב געגרונטפֿעסט די ערד;</para>
  <para style="q" vid="JOB 38:4">זאָג, אױב דו װײסט פֿאַרשטאַנדיקײט.<verse eid="JOB 38:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 38:5" />װער האָט געמאַכט אירע מאָסן, אױב דו װײסט?</para>
  <para style="q" vid="JOB 38:5">אָדער װער האָט געצױגן אַ מעסטשנור אױף איר?<verse eid="JOB 38:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 38:6" />אױף װאָס זײַנען אירע גרונטמױערן אַרױפֿגעזעצט?</para>
  <para style="q" vid="JOB 38:6">אָדער װער האָט געלײגט איר װינקלשטײן?<verse eid="JOB 38:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 38:7" />װען די מאָרגנשטערן האָבן אין אײנעם געזונגען,</para>
  <para style="q" vid="JOB 38:7">און אַלע זין פֿון אלֹקים האָבן געשאַלט.<verse eid="JOB 38:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 38:8" />און װער האָט פֿאַרצאַמט מיט טירן דעם ים,</para>
  <para style="q" vid="JOB 38:8">װען ער האָט אױסגעבראָכן און איז פֿון טראַכט אַרױס?<verse eid="JOB 38:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 38:9" />װען איך האָב געמאַכט דעם װאָלקן פֿאַר זײַן מלבוש,</para>
  <para style="q" vid="JOB 38:9">און דעם נעבל פֿאַר זײַן װיקלשנור,<verse eid="JOB 38:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 38:10" />און איך האָב באַשטימט פֿאַר אים מײַן געזעץ,</para>
  <para style="q" vid="JOB 38:10">און געמאַכט ריגלען און טירן,<verse eid="JOB 38:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 38:11" />און געזאָגט: ביז אַהער זאָלסטו קומען און נישט װײַטער,</para>
  <para style="q" vid="JOB 38:11">און דאָ װעט מען פֿאַרהאַלטן דעם שטאָלץ פֿון דײַנע אינדן?<verse eid="JOB 38:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="JOB 38:12" />האָסטו זינט דײַן לעבטאָג באַפֿױלן דעם פֿרימאָרגן?</para>
  <para style="q" vid="JOB 38:12">אָנגעװיזן דעם באַגינען זײַן אָרט?<verse eid="JOB 38:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 38:13" />כּדי אָנצונעמען די ברעגן פֿון דער ערד,</para>
  <para style="q" vid="JOB 38:13">אַז די רשעים זאָלן אַראָפּגעשאָקלט װערן פֿון איר.<verse eid="JOB 38:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 38:14" />זי שעמערירט אַזױ װי זיגלװאַקס,</para>
  <para style="q" vid="JOB 38:14">און עס ליגט אַזױ װי אַ מלבוש.<verse eid="JOB 38:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 38:15" />און פֿון די רשעים װערט פֿאַרמיטן זײער ליכט,</para>
  <para style="q" vid="JOB 38:15">און דער אױפֿגעהױבענער אָרעם װערט צעבראָכן.<verse eid="JOB 38:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 38:16" />ביסטו געקומען צו די קװאַלן פֿון ים,</para>
  <para style="q" vid="JOB 38:16">און אױפֿן גרונט פֿון תּהום אומגעגאַנגען?<verse eid="JOB 38:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 38:17" />זײַנען דיר אַנטפּלעקט געװאָרן די טױערן פֿון טױט,</para>
  <para style="q" vid="JOB 38:17">און האָסטו די טױערן פֿון טױטשאָטן געזען?<verse eid="JOB 38:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 38:18" />האָסטו איבערגעקוקט ביז די ברײטקײטן פֿון דער ערד?</para>
  <para style="q" vid="JOB 38:18">זאָג, אױב דו װײסט דאָס אַלץ.<verse eid="JOB 38:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="JOB 38:19" />אױף װאָסער װעג רוט דאָס ליכט?</para>
  <para style="q" vid="JOB 38:19">און די פֿינצטערניש, װוּ איז איר אָרט,<verse eid="JOB 38:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 38:20" />אַז דו זאָלסט זי נעמען צו איר געמאַרק,</para>
  <para style="q" vid="JOB 38:20">און אַז דו זאָלסט פֿאַרשטײן די שטעגן צו איר הױז?<verse eid="JOB 38:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 38:21" />דו װײסט דאָס, װאָרעם דו ביסט דענצמאָל שױן געװען געבאָרן,</para>
  <para style="q" vid="JOB 38:21">און די צאָל פֿון דײַנע טעג איז גרױס!<verse eid="JOB 38:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="JOB 38:22" />ביסטו געקומען צו די אוֹצרות פֿון שנײ,</para>
  <para style="q" vid="JOB 38:22">אָדער האָסטו די אוֹצרות פֿון האָגל געזען,<verse eid="JOB 38:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 38:23" />װאָס איך האָב באַהאַלטן פֿאַר אַ צײַט פֿון נױט,</para>
  <para style="q" vid="JOB 38:23">פֿאַרן טאָג פֿון קריג און מלחמה?<verse eid="JOB 38:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="JOB 38:24" />אױף װאָסער װעג צעטײלט זיך דאָס ליכט,</para>
  <para style="q" vid="JOB 38:24">צעשפּרײט זיך דער מזרח-װינט איבער דער ערד?<verse eid="JOB 38:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 38:25" />װער האָט דורכגעהאַקט פֿאַר דער פֿלײצונג אַ גראָבן,</para>
  <para style="q" vid="JOB 38:25">און אַ װעג פֿאַרן דונערגעװיטער?<verse eid="JOB 38:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 38:26" />צו מאַכן רעגענען אױף אַ לאַנד אָן אַ מענטשן,</para>
  <para style="q" vid="JOB 38:26">אַ מדבר אָן אַ מוטערמענטשן דערין;<verse eid="JOB 38:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 38:27" />אָנצוזעטן אַ װיסטקײט און אַ װיסטעניש,</para>
  <para style="q" vid="JOB 38:27">און מאַכן שפּראָצן אַן אױסװאַקס פֿון גראָז.<verse eid="JOB 38:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 38:28" />האָט דער רעגן אַ פֿאָטער?</para>
  <para style="q" vid="JOB 38:28">אָדער װער האָט געבאָרן די טראָפּנס טױ?<verse eid="JOB 38:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 38:29" />פֿון װעמעס בױך איז אַרױס דער אײַז?</para>
  <para style="q" vid="JOB 38:29">און דער פֿראָסט פֿון הימל, װער האָט אים געבאָרן?<verse eid="JOB 38:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 38:30" />אַזױ װי שטײן װערן װאַסערן פֿאַרגליװערט,</para>
  <para style="q" vid="JOB 38:30">און דער פּנים פֿון תּהום װערט פֿאַרשטאַרט.<verse eid="JOB 38:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="JOB 38:31" />קענסטו בינדן די קײטן פֿון זיבנשטערן,</para>
  <para style="q" vid="JOB 38:31">אָדער די שטריק פֿון אָריאָן לױז מאַכן?<verse eid="JOB 38:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 38:32" />קענסטו אַרױסברענגען די מזלות אין זײער צײַט,</para>
  <para style="q" vid="JOB 38:32">און דעם בער מיט זײַנע קינדער אַרױספֿירן?<verse eid="JOB 38:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 38:33" />װײסטו די געזעצן פֿון הימל?</para>
  <para style="q" vid="JOB 38:33">צי מאַכסטו זײַן געװעלטיקונג אױף דער ערד?<verse eid="JOB 38:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 38:34" />קענסטו אױפֿהײבן צום װאָלקן דײַן קֹול,</para>
  <para style="q" vid="JOB 38:34">אַז אַ שפֿע פֿון װאַסער זאָל דיך באַדעקן?<verse eid="JOB 38:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 38:35" />קענסטו אַרױסשיקן בליצן, זײ זאָלן גײן,</para>
  <para style="q" vid="JOB 38:35">און זאָגן צו דיר: דאָ זײַנען מיר?<verse eid="JOB 38:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="JOB 38:36" />װער האָט אַרײַנגעטאָן אין די נירן חכמה?</para>
  <para style="q" vid="JOB 38:36">אָדער װער האָט געגעבן דעם גײַסט פֿאַרשטאַנדיקײט?<verse eid="JOB 38:36" /></para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" sid="JOB 38:37" />װער צײלט איבער די װאָלקנס מיט חכמה?</para>
  <para style="q" vid="JOB 38:37">און די לאָגלען פֿון הימל װער גיסט אױס?<verse eid="JOB 38:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="JOB 38:38" />װען דער שטױב איז צונױפֿגעגאָסן װי קלומפּ,</para>
  <para style="q" vid="JOB 38:38">און די גרודעס זײַנען צוזאַמענגעבאַקן.<verse eid="JOB 38:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="JOB 38:39" />קענסטו פֿאַנגען פֿאַר דער לײבינטע רױב,</para>
  <para style="q" vid="JOB 38:39">און דעם באַגער פֿון די יונגלײבן אָנפֿילן,<verse eid="JOB 38:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="JOB 38:40" />װען זײ בײגן זיך אין די נאָרעס,</para>
  <para style="q" vid="JOB 38:40">װען זײ זיצן אין צודעק אױף דער לױער?<verse eid="JOB 38:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="JOB 38:41" />װער גרײט אָן דעם ראָב זײַן שפּײַז,</para>
  <para style="q" vid="JOB 38:41">װען זײַנע קינדער שרײַען צו אֵל,</para>
  <para style="q" vid="JOB 38:41">װען זײ װאַנדערן אום אָן עסן?<verse eid="JOB 38:41" /></para>
  <chapter eid="JOB 38" />
  <chapter number="39" style="c" pubnumber="לט" sid="JOB 39" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 39:1" />װײסטו די צײַט װען די שטײנציגן געבערן?</para>
  <para style="q" vid="JOB 39:1">גיסטו אַכטונג װען די הינדינס האָבן װײען?<verse eid="JOB 39:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 39:2" />צײלסטו די חדשים װען זײ דאַרפֿן דערפֿילן,</para>
  <para style="q" vid="JOB 39:2">און װײסטו די צײַט פֿון זײער געבערן?<verse eid="JOB 39:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 39:3" />זײ קניִען, זײ לאָזן דורכברעכן זײערע קינדער,</para>
  <para style="q" vid="JOB 39:3">זײ װאַרפֿן אַרױס זײערע געבורטן.<verse eid="JOB 39:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 39:4" />זײערע יונגע װערן שטאַרק, זײ װאַקסן אױפֿן פֿרײַען,</para>
  <para style="q" vid="JOB 39:4">זײ גײען אַװעק, און קערן זיך נישט אום צו זײ.<verse eid="JOB 39:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="JOB 39:5" />װער האָט אַרױסגעלאָזט דעם װאַלדאײזל פֿרײַ,</para>
  <para style="q" vid="JOB 39:5">און די בינד פֿון דעם װילדאײזל װער האָט לױז געמאַכט,<verse eid="JOB 39:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 39:6" />װאָס איך האָב געמאַכט דעם מדבר פֿאַר זײַן הױז,</para>
  <para style="q" vid="JOB 39:6">און זאַלציק לאַנד פֿאַר זײַנע װױנונגען?<verse eid="JOB 39:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 39:7" />ער לאַכט פֿון דעם טומל פֿון שטאָט,</para>
  <para style="q" vid="JOB 39:7">ער הערט נישט קײן טרײַבערס געשרײען.<verse eid="JOB 39:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 39:8" />די נישטערונג פֿון די בערג איז זײַן פֿיטערונג,</para>
  <para style="q" vid="JOB 39:8">און איטלעך גראָז זוכט ער נאָך.<verse eid="JOB 39:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="JOB 39:9" />װעט דער װיזלטיר װעלן דיר דינען?</para>
  <para style="q" vid="JOB 39:9">צי װעט ער נעכטיקן בײַ דײַן קאָריטע?<verse eid="JOB 39:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 39:10" />קענסטו צובינדן דעם װיזלטיר מיט זײַן שטריק צו דער בײַט?</para>
  <para style="q" vid="JOB 39:10">צי װעט ער בראָנעװען די טאָלן הינטער דיר?<verse eid="JOB 39:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 39:11" />קענסטו זיך פֿאַרזיכערן אױף אים, װײַל זײַן כּוֹח איז גרױס,</para>
  <para style="q" vid="JOB 39:11">און איבערלאָזן אױף אים דײַן מי?<verse eid="JOB 39:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 39:12" />קענסטו אים אָנטרױען, אַז ער װעט אָפּברענגען דײַן זאָמען,</para>
  <para style="q" vid="JOB 39:12">און אײַנזאַמלען די תּבֿואה פֿון דײַן דרעש-שײַער?<verse eid="JOB 39:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JOB 39:13" />דער פֿליגל פֿון שטרױספֿױגל קלאַפּט לוסטיק –</para>
  <para style="q" vid="JOB 39:13">צי איז דאָס דער פֿלעדער און פֿעדער פֿון שטאָרך?<verse eid="JOB 39:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 39:14" />פֿאַר װאָר, זי לאָזט איבער צו דער ערד אירע אײַער,</para>
  <para style="q" vid="JOB 39:14">און אין שטױב לאָזט זי זײ אױסבריִען.<verse eid="JOB 39:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 39:15" />און זי פֿאַרגעסט אַז אַ פֿוס קען זײ צעקװעטשן,</para>
  <para style="q" vid="JOB 39:15">און אַ חיה פֿון פֿעלד קען זײ צעטרעטן.<verse eid="JOB 39:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 39:16" />זי איז האַרט צו אירע קינדער װי צו נישט אירע;</para>
  <para style="q" vid="JOB 39:16">אומנישט מעג זײַן איר מי, זי איז אָן אַנגסט,<verse eid="JOB 39:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 39:17" />װאָרעם אֱלוֹהַּ האָט זי געמינערט פֿון חכמה,</para>
  <para style="q" vid="JOB 39:17">און איר נישט אײַנגעטײלט מיט שׂכל.<verse eid="JOB 39:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 39:18" />אַצונד הײבט זי די פֿליגלען אין דער הײך,</para>
  <para style="q" vid="JOB 39:18">זי לאַכט פֿון פֿערד און פֿון זײַן רײַטער.<verse eid="JOB 39:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 39:19" />גיסטו דעם פֿערד גבֿורה?</para>
  <para style="q" vid="JOB 39:19">באַקלײדסטו זײַן האַלדז מיט שטורעם?<verse eid="JOB 39:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 39:20" />מאַכסטו אים שפּרינגען װי אַ הײשעריק?</para>
  <para style="q" vid="JOB 39:20">דער הילך פֿון זײַן הירזשען איז אַן אימה.<verse eid="JOB 39:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 39:21" />ער גראַבלט אין טאָל, און פֿרײט זיך מיטן כּוֹח,</para>
  <para style="q" vid="JOB 39:21">ער גײט אַרױס דעם װאַפֿן אַנטקעגן.<verse eid="JOB 39:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 39:22" />ער לאַכט פֿון אַנגסט, און װערט נישט דערשראָקן,</para>
  <para style="q" vid="JOB 39:22">און ער קערט נישט צוריק פֿאַר אַ שװערד.<verse eid="JOB 39:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 39:23" />לעבן אים קלינגט דער פֿײַלבײַטל,</para>
  <para style="q" vid="JOB 39:23">דער פֿלאַמיקער שפּיז און די פּיקע.<verse eid="JOB 39:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 39:24" />מיט רַעש און רוגזה שלינגט ער די ערד,</para>
  <para style="q" vid="JOB 39:24">און קען נישט אײַנשטײן בײַם קֹול פֿון אַ שופֿר.<verse eid="JOB 39:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 39:25" />װי נאָר אַ שופֿר, זאָגט ער: אַהאַ!</para>
  <para style="q" vid="JOB 39:25">און פֿון װײַטן דערשמעקט ער מלחמה,</para>
  <para style="q" vid="JOB 39:25">דעם דונער פֿון די הױפּטלײַט און די שאַלונג.<verse eid="JOB 39:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="JOB 39:26" />דורך דײַן שׂכל פֿליט דען דער שפּאַרבער,</para>
  <para style="q" vid="JOB 39:26">שפּרײט זײַנע פֿליגלען קײן דָרום?<verse eid="JOB 39:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 39:27" />צי אױף דײַן באַפֿעל הײבט זיך אױף דער אָדלער,</para>
  <para style="q" vid="JOB 39:27">און מאַכט זײַן נעסט אין דער הײך?<verse eid="JOB 39:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 39:28" />אױף אַ פֿעלדז רוט ער און װײַלט,</para>
  <para style="q" vid="JOB 39:28">אױף אַ שפּיץ פֿעלדז און אַ באַרגפֿעסטונג.<verse eid="JOB 39:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 39:29" />פֿון דאָרטן קוקט ער אױס זײַן עסן,</para>
  <para style="q" vid="JOB 39:29">פֿון װײַטן זעען זײַנע אױגן.<verse eid="JOB 39:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 39:30" />און זײַנע יונגע זופּן בלוט,</para>
  <para style="q" vid="JOB 39:30">און װוּ דערשלאָגענע דאָרטן איז ער.<verse eid="JOB 39:30" /></para>
  <chapter eid="JOB 39" />
  <chapter number="40" style="c" pubnumber="מ" sid="JOB 40" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 40:1" />און ה׳ האָט געענטפֿערט אִיובֿן, און האָט געזאָגט:<verse eid="JOB 40:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 40:2" />װיל זיך קריגן מיטן שַדַי דער טאַדלער?</para>
  <para style="q" vid="JOB 40:2">דער װאָס װיכּוחט זיך מיט אֱלוֹהַּ זאָל עס ענטפֿערן.<verse eid="JOB 40:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="JOB 40:3" />האָט אִיובֿ געענטפֿערט ה׳ און האָט געזאָגט:<verse eid="JOB 40:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 40:4" />זע, װינציק װאָס בין איך; װאָס קען איך דיר ענטפֿערן?</para>
  <para style="q" vid="JOB 40:4">איך טו אַרױף מײַן האַנט אױף מײַן מױל.<verse eid="JOB 40:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 40:5" />אײן מאָל האָב איך גערעדט, און װעל מער נישט ענטפֿערן;</para>
  <para style="q" vid="JOB 40:5">יאָ, צװײ מאָל און װעל עס נישט װידער טאָן.<verse eid="JOB 40:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="JOB 40:6" />האָט ה׳ געענטפֿערט אִיובֿן פֿון שטורעם און האָט געזאָגט:<verse eid="JOB 40:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 40:7" />גורט אַקאָרשט אָן װי אַ מאַן דײַנע לענדן;</para>
  <para style="q" vid="JOB 40:7">איך װעל דיך פֿרעגן, און דו מאַך מיך װיסן.<verse eid="JOB 40:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 40:8" />צי װילסטו אױך פֿאַרשטערן מײַן משפּט?</para>
  <para style="q" vid="JOB 40:8">װילסטו מיך באַשולדיקן כּדי דו זאָלסט גערעכט זײַן?<verse eid="JOB 40:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 40:9" />אָדער צי האָסטו אַן אָרעם װי הָאֵל,</para>
  <para style="q" vid="JOB 40:9">און מיט אַ קֹול װי ער קענסטו דונערן?<verse eid="JOB 40:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 40:10" />ציר זיך אַקאָרשט אָן מיט שטאָלץ און הױכקײט,</para>
  <para style="q" vid="JOB 40:10">און גלאַנץ און שײנקײט זאָלסטו אָנטאָן.<verse eid="JOB 40:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 40:11" />פֿאַרשפּרײט דעם גרים פֿון דײַן צאָרן,</para>
  <para style="q" vid="JOB 40:11">און זע װוּ אַ שטאָלצער און דערנידער אים.<verse eid="JOB 40:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 40:12" />זע װוּ אַ שטאָלצער און מאַך אים אונטערטעניק,</para>
  <para style="q" vid="JOB 40:12">און צעטרעט די רשעים אױף זײער אָרט.<verse eid="JOB 40:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 40:13" />באַהאַלט זײ אין שטױב אין אײנעם,</para>
  <para style="q" vid="JOB 40:13">זײער פּנים פֿאַרדעקן אין פֿאַרבאָרגעניש.<verse eid="JOB 40:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 40:14" />און איך אױך װעל דיר מודה זײַן,</para>
  <para style="q" vid="JOB 40:14">אַז דײַן רעכטע האַנט קען דיר העלפֿן.<verse eid="JOB 40:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="JOB 40:15" />זע נאָר דעם װאַסערפֿערד װאָס איך האָב געמאַכט לעבן דיר;</para>
  <para style="q" vid="JOB 40:15">גראָז װי אַ רינד עסט ער.<verse eid="JOB 40:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 40:16" />זע נאָר, זײַן כּוֹח איז אין זײַנע לענדן,</para>
  <para style="q" vid="JOB 40:16">און זײַן שטאַרקײט אין די פֿלײשפֿעדים פֿון זײַן בױך.<verse eid="JOB 40:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 40:17" />ער שטעלט אױף זײַן עק װי אַ צעדערבױם,</para>
  <para style="q" vid="JOB 40:17">די אָדערן פֿון זײַנע דיכן זײַנען װי צװײַגן.<verse eid="JOB 40:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 40:18" />זײַנע בײנער זײַנען רערן פֿון קופּער,</para>
  <para style="q" vid="JOB 40:18">זײַנע קנאָכנס װי אײַזערנע שטאַנגען.<verse eid="JOB 40:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 40:19" />ער איז די פּער פֿון דרכי־אֵל,</para>
  <para style="q" vid="JOB 40:19">בלױז זײַן באַשעפֿער קען ברענגען זײַן שװערד.<verse eid="JOB 40:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 40:20" />װאָרעם פֿוטער טראָגן אים די בערג,</para>
  <para style="q" vid="JOB 40:20">װאָס אַלע חיות פֿון פֿעלד שפּילן זיך דאָרטן.<verse eid="JOB 40:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 40:21" />אונטער לאָטוסבײמער ליגט ער,</para>
  <para style="q" vid="JOB 40:21">אין פֿאַרבאָרגעניש פֿון ראָר און זומפּ.<verse eid="JOB 40:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 40:22" />לאָטוסבײמער באַשירעמען אים מיט זײער שאָטן,</para>
  <para style="q" vid="JOB 40:22">אים רינגלען אַרום װערבעס פֿון טײַך.<verse eid="JOB 40:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 40:23" />זע, דער טײַך פֿלײצט אַריבער, און ער אײַלט זיך נישט,</para>
  <para style="q" vid="JOB 40:23">ער איז זיכער, װען אַ יַרדן שפּאַרט זיך אין זײַן מױל.<verse eid="JOB 40:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 40:24" />קען מען פֿאַר זײַנע אױגן אים כאַפּן,</para>
  <para style="q" vid="JOB 40:24">מיט פּאַסטקעס דורכלעכערן די נאָז?<verse eid="JOB 40:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" altnumber="41:1" sid="JOB 40:25" /> קענסטו אַרױסציען דעם לִויָתן מיט אַ װענדע,</para>
  <para style="q" vid="JOB 40:25">און מיט אַ שטריק אַראָפּשלעפּן זײַן צונג?<verse eid="JOB 40:25" /></para>
  <para style="q">
    <verse number="26" style="v" altnumber="41:2" sid="JOB 40:26" /> קענסטו אַרײַנטאָן אַ ראָר אין זײַן נאָז,</para>
  <para style="q" vid="JOB 40:26">אָדער מיט אַ דאָרן דורכבױערן זײַן קינבאַק?<verse eid="JOB 40:26" /></para>
  <para style="q">
    <verse number="27" style="v" altnumber="41:3" sid="JOB 40:27" /> װעט ער זיך פֿיל בעטן בײַ דיר?</para>
  <para style="q" vid="JOB 40:27">צי װעט ער רעדן צו דיר װײך?<verse eid="JOB 40:27" /></para>
  <para style="q">
    <verse number="28" style="v" altnumber="41:4" sid="JOB 40:28" /> װעט ער שליסן אַ ברית מיט דיר,</para>
  <para style="q" vid="JOB 40:28">זאָלסט אים נעמען פֿאַר אַן אײביקן קנעכט?<verse eid="JOB 40:28" /></para>
  <para style="q">
    <verse number="29" style="v" altnumber="41:5" sid="JOB 40:29" /> קענסטו זיך שפּילן מיט אים װי מיט אַ פֿױגל,</para>
  <para style="q" vid="JOB 40:29">און אים צובינדן פֿאַר דײַנע מײדלעך?<verse eid="JOB 40:29" /></para>
  <para style="q">
    <verse number="30" style="v" altnumber="41:6" sid="JOB 40:30" /> װעלן זיך דינגען שותּפֿים איבער אים?</para>
  <para style="q" vid="JOB 40:30">װעלן זײ אים צעטײלן צװישן די הענדלער?<verse eid="JOB 40:30" /></para>
  <para style="q">
    <verse number="31" style="v" altnumber="41:7" sid="JOB 40:31" /> קענסטו אָנפֿילן מיט שטעכערס זײַן פֿעל,</para>
  <para style="q" vid="JOB 40:31">און מיט פֿישהאָקן זײַן קאָפּ?<verse eid="JOB 40:31" /></para>
  <para style="q">
    <verse number="32" style="v" altnumber="41:8" sid="JOB 40:32" /> טו אַרױף אױף אים דײַן האַנט!</para>
  <para style="q" vid="JOB 40:32">דערמאָן זיך די מלחמה, װעסטו עס מער נישט טאָן.<verse eid="JOB 40:32" /></para>
  <chapter eid="JOB 40" />
  <chapter number="41" style="c" pubnumber="מא" sid="JOB 41" />
  <para style="q">
    <verse number="1" style="v" altnumber="41:9" sid="JOB 41:1" /> זע, די האָפֿענונג װערט צום נאַרן;</para>
  <para style="q" vid="JOB 41:1">שױן פֿון זײַן אָנבליק װערט מען דאָך אַנידערגעשלײַדערט.<verse eid="JOB 41:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="41:10" sid="JOB 41:2" /> נישטאָ דער אַכזר אױף זיך װאָס זאָל אים װעלן אױפֿרײצן;</para>
  <para style="q" vid="JOB 41:2">הײַנט װער איז דער װאָס קען זיך שטעלן פֿאַר מיר?<verse eid="JOB 41:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="41:11" sid="JOB 41:3" /> װער עס טרעט אַרױס אַקעגן מיר, דעם באַצאָל איך;</para>
  <para style="q" vid="JOB 41:3">װאָס אונטערן גאַנצן הימל איז מײַן.<verse eid="JOB 41:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="12" sid="JOB 41:4" /> זאָל איך אים פֿאַרשװײַגן זײַנע פּלױדערײַען,</para>
  <para style="q" vid="JOB 41:4">און דאָס האָפֿערדיקע רעדן, און זײַן שײנעם מַעַנה-לשון?<verse eid="JOB 41:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="13" sid="JOB 41:5" /> װער האָט אָפּגעדעקט זײַן אױסנװײניקסט מלבוש?</para>
  <para style="q" vid="JOB 41:5">צו זײַן טאָפּעלן געביס װער קען צוקומען?<verse eid="JOB 41:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="14" sid="JOB 41:6" /> די טירן פֿון זײַן פּנים װער האָט געעפֿנט?</para>
  <para style="q" vid="JOB 41:6">אַרום זײַנע צײן איז אַן אימה.<verse eid="JOB 41:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="15" sid="JOB 41:7" /> שטאָלץ זײַנען די פּאַנצערשופּן,</para>
  <para style="q" vid="JOB 41:7">צונױפֿגעשלאָסן װי מיט אַ זיגל אַ פֿעסטן;<verse eid="JOB 41:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="16" sid="JOB 41:8" /> אײנע צו דער אַנדערער זײַנען זײ נאָנט,</para>
  <para style="q" vid="JOB 41:8">אַז אַ לופֿט קען נישט דורכגײן צװישן זײ.<verse eid="JOB 41:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="17" sid="JOB 41:9" /> אײנע צו דער צװײטער איז באַהעפֿט,</para>
  <para style="q" vid="JOB 41:9">זײ האַלטן זיך פֿעסט און צעשײדן זיך נישט.<verse eid="JOB 41:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="18" sid="JOB 41:10" /> זײַן ניסן שטראַלט אַרױס אַ ליכט,</para>
  <para style="q" vid="JOB 41:10">און זײַנע אױגן זײַנען װי די ברעמען פֿון פֿרימאָרגן.<verse eid="JOB 41:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="19" sid="JOB 41:11" /> פֿון זײַן מױל גײען פֿלאַמען,</para>
  <para style="q" vid="JOB 41:11">פֿונקען פֿײַער רײַסן זיך אַרױס.<verse eid="JOB 41:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="20" sid="JOB 41:12" /> פֿון זײַנע נאָזלעכער גײט אַ רױך,</para>
  <para style="q" vid="JOB 41:12">װי פֿון אַ קאָכיקן טאָפּ און ברענעדיקן ראָר.<verse eid="JOB 41:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="21" sid="JOB 41:13" /> זײַן אָטעם גליט װי קױלן,</para>
  <para style="q" vid="JOB 41:13">און אַ פֿלאַקער גײט אַרױס פֿון זײַן מױל.<verse eid="JOB 41:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="22" sid="JOB 41:14" /> אױף זײַן האַלדז רוט די שטאַרקײט,</para>
  <para style="q" vid="JOB 41:14">און אים פֿאַרױס טאַנצט די אַנגסט.<verse eid="JOB 41:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="23" sid="JOB 41:15" /> די קנײטשן פֿון זײַן פֿלײש זײַנען באַהעפֿט;</para>
  <para style="q" vid="JOB 41:15">עס איז פֿעסט אױף אים, עס רירט זיך נישט.<verse eid="JOB 41:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="24" sid="JOB 41:16" /> זײַן האַרץ איז פֿעסט װי שטײן,</para>
  <para style="q" vid="JOB 41:16">יאָ, פֿעסט װי אַן אונטערשטער מילשטײן.<verse eid="JOB 41:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="25" sid="JOB 41:17" /> פֿאַר זײַן הײב שרעקן זיך די מאַכטיקע,</para>
  <para style="q" vid="JOB 41:17">פֿון צעבראָכנקײט װערן זײ אױסער זיך.<verse eid="JOB 41:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="26" sid="JOB 41:18" /> װיל מען אים אָנקריגן, קען קײן שװערד נישט באַשטײן,</para>
  <para style="q" vid="JOB 41:18">קײן שפּיז, קײן װאַרפֿשפּיז, און קײן פֿײַל.<verse eid="JOB 41:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="27" sid="JOB 41:19" /> ער באַטראַכט אײַזן פֿאַר שטרױ,</para>
  <para style="q" vid="JOB 41:19">און קופּער פֿאַר האָלץ פֿאַרפֿױלטן.<verse eid="JOB 41:19" /></para>
  <para style="q">
    <verse number="20" style="v" altnumber="28" sid="JOB 41:20" /> אים פֿאַריאָגט נישט דער זון פֿון בױגן;</para>
  <para style="q" vid="JOB 41:20">פֿאַרקערט אין שפּרײ װערן פֿאַר אים שלײַדער-שטײנער.<verse eid="JOB 41:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="29" sid="JOB 41:21" /> װי שפּרײ זײַנען פֿלעקער גערעכנט,</para>
  <para style="q" vid="JOB 41:21">און ער לאַכט פֿון רַעש פֿון דער פּיקע.<verse eid="JOB 41:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="30" sid="JOB 41:22" /> זײַן אונטערזײַט איז שפּיציקע שאַרבנס;</para>
  <para style="q" vid="JOB 41:22">ער בעט אױס אַ דרעששליטן אױפֿן קױט.<verse eid="JOB 41:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="31" sid="JOB 41:23" /> ער צעקאָכט װי אַ טאָפּ די טיפֿעניש,</para>
  <para style="q" vid="JOB 41:23">ער מאַכט דעם ים װי זוד.<verse eid="JOB 41:23" /></para>
  <para style="q">
    <verse number="24" style="v" altnumber="32" sid="JOB 41:24" /> הינטער זיך לאָזט ער אַ ליכטיקן שטעג;</para>
  <para style="q" vid="JOB 41:24">מע מײנט דער תּהום איז גרײַזגראָ.<verse eid="JOB 41:24" /></para>
  <para style="q">
    <verse number="25" style="v" altnumber="33" sid="JOB 41:25" /> נישטאָ אױף דער ערד זײַן גלײַכן,</para>
  <para style="q" vid="JOB 41:25">געמאַכט צו זײַן אָן אַ מורא.<verse eid="JOB 41:25" /></para>
  <para style="q">
    <verse number="26" style="v" altnumber="34" sid="JOB 41:26" /> אױף יעטװעדער העכסטן קוקט ער אַראָפּ,</para>
  <para style="q" vid="JOB 41:26">ער איז דער מלך איבער אַלע שטאָלצע חיות.<verse eid="JOB 41:26" /></para>
  <chapter eid="JOB 41" />
  <chapter number="42" style="c" pubnumber="מב" sid="JOB 42" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 42:1" />האָט אִיובֿ געענטפֿערט ה׳ און האָט געזאָגט:<verse eid="JOB 42:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOB 42:2" />איך װײס אַז אַלץ קענסטו טאָן,</para>
  <para style="q" vid="JOB 42:2">און קײן טראַכטונג איז נישט פֿאַרמיטן פֿון דיר.<verse eid="JOB 42:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 42:3" />װער קען דאָס פֿאַרהױלן די כּװנה אָן פֿאַרשטאַנדיקײט?</para>
  <para style="q" vid="JOB 42:3">דערום זאָג איך אַז איך פֿאַרשטײ נישט;</para>
  <para style="q" vid="JOB 42:3">װוּנדער זײַנען דאָס פֿאַר מיר, און איך װײס נישט.<verse eid="JOB 42:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 42:4" />הער, איך בעט דיך, און איך װעל רעדן;</para>
  <para style="q" vid="JOB 42:4">איך װעל דיך פֿרעגן, און דו מאַך מיך װיסן.<verse eid="JOB 42:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 42:5" />מיט געהער פֿון אױער האָב איך פֿון דיר געהערט,</para>
  <para style="q" vid="JOB 42:5">און אַצונד האָט מײַן אױג דיך געזען.<verse eid="JOB 42:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 42:6" />דערום פֿאַראַכט איך מײַנע רײד</para>
  <para style="q" vid="JOB 42:6">און האָב חרטה, אין שטױב און אַש.<verse eid="JOB 42:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="JOB 42:7" />און עס איז געװען נאָך דעם װי ה׳ האָט גערעדט די דאָזיקע װערטער צו אִיובֿן, האָט ה׳ געזאָגט צו אֶליפַֿז דעם תֵּימָני: מײַן צאָרן גרימט אױף דיר און אױף דײַנע צװײ גוטע פֿרײַנט, פֿאַר װאָס איר האָט נישט גערעדט װעגן מיר אַזױ אױפֿריכטיק װי מײַן קנעכט אִיובֿ. <verse eid="JOB 42:7" /><verse number="8" style="v" sid="JOB 42:8" />און אַצונד נעמט אײַך זיבן אָקסן און זיבן װידערס, און גײט צו מײַן קנעכט אִיובֿן, און איר זאָלט אױפֿברענגען אַ בראַנדאָפּפֿער פֿאַר אײַך, און אִיובֿ מײַן קנעכט װעט מתפּלל זײַן פֿאַר אײַך, װאָרעם בלױז זײַן פּנים װעל איך אױפֿנעמען, אײַך נישט אָנצוטאָן קײן שאַנד, װײַל איר האָט נישט גערעדט װעגן מיר אַזױ אױפֿריכטיק װי מײַן קנעכט אִיובֿ.<verse eid="JOB 42:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOB 42:9" />איז אֶליפַֿז דער תֵּימָני, און בִלדַד דער שוחי, און צופֿר דער נַעַמָתי, געגאַנגען, און זײ האָבן געטאָן אַזױ װי ה׳ האָט צו זײ גערעדט; און ה׳ האָט געשױנט אִיובֿס פּנים.<verse eid="JOB 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOB 42:10" />און ה׳ האָט אומקערט אִיובֿס געפֿאַנגענשאַפֿט, אַז ער האָט מתפּלל געװען פֿאַר זײַנע גוטע פֿרײַנט; און ה׳ האָט געמערט אַלץ װאָס אִיובֿ האָט געהאַט טאָפּל. <verse eid="JOB 42:10" /><verse number="11" style="v" sid="JOB 42:11" />און אַלע זײַנע ברידער, און אַלע זײַנע שװעסטער, און אַלע זײַנע באַקענטע פֿון פֿריִער, זײַנען געקומען צו אים, און האָבן געגעסן מיט אים ברױט אין זײַן הױז, און זײ האָבן אים באַדױערט, און אים געטרײסט אױף אַל דעם בײז װאָס ה׳ האָט אױף אים געבראַכט; און זײ האָבן אים געגעבן איטלעכער אַ קשׂיטה, און איטלעכער אַ גילדערנעם נאָזרינג.<verse eid="JOB 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOB 42:12" />און ה׳ האָט געבענטשט אִיובֿס לעצט מער װי זײַן אָנהײב, און ער האָט געהאַט פֿערצן טױזנט שאָף, און זעקס טױזנט קעמלען, און טױזנט געשפּאַן רינדער, און טױזנט אײזעלינס. <verse eid="JOB 42:12" /><verse number="13" style="v" sid="JOB 42:13" />און ער האָט געהאַט זיבן זין און דרײַ טעכטער. <verse eid="JOB 42:13" /><verse number="14" style="v" sid="JOB 42:14" />און ער האָט גערופֿן דעם נאָמען פֿון אײנער ימִימה, און דעם נאָמען פֿון דער צװײטער קציעָה, און דעם נאָמען פֿון דער דריטער קֶרֶן-הַפּוך. <verse eid="JOB 42:14" /><verse number="15" style="v" sid="JOB 42:15" />און אין גאַנצן לאַנד האָבן זיך נישט געפֿונען אַזעלכע שײנע פֿרױען װי אִיובֿס טעכטער. און זײער פֿאָטער האָט זײ געגעבן אַ נחלה צװישן זײערע ברידער.<verse eid="JOB 42:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOB 42:16" />און אִיובֿ האָט געלעבט נאָך דעם הונדערט און פֿערציק יאָר; און ער האָט געזען זײַנע קינדער און זײַנע קינדס-קינדער, פֿיר דורות. <verse eid="JOB 42:16" /><verse number="17" style="v" sid="JOB 42:17" />און אִיובֿ איז געשטאָרבן אַלט און זאַט מיט טעג.<verse eid="JOB 42:17" /></para>
  <chapter eid="JOB 42" />
</usx>