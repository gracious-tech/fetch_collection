<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">חֲבַֿקוּק</para>
  <para style="toc2">חֲבַֿקוּק</para>
  <para style="toc1">חֲבַֿקוּק</para>
  <para style="mt1">חֲבַֿקוּק</para>
  <chapter number="1" style="c" pubnumber="א" sid="HAB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />די נבֿואה װאָס חֲבַֿקוּק דער נבֿיא האָט געזען.<verse eid="HAB 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="HAB 1:2" />ביז װאַנען, ה׳, װעל איך רופֿן,</para>
  <para style="q" vid="HAB 1:2">און דו װעסט נישט הערן?</para>
  <para style="q" vid="HAB 1:2">שרײַען צו דיר געװאַלט,</para>
  <para style="q" vid="HAB 1:2">און דו װעסט נישט העלפֿן?<verse eid="HAB 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 1:3" />פֿאַר װאָס לאָזטו מיך זען אומרעכט,</para>
  <para style="q" vid="HAB 1:3">און קוקסט-צו אומגליק?</para>
  <para style="q" vid="HAB 1:3">און רױב און גזלה זײַנען פֿאַר מיר,</para>
  <para style="q" vid="HAB 1:3">און עס איז קריג, און שטרײַט הײבט זיך אױף.<verse eid="HAB 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 1:4" />דערום איז אָפּגעשלאַפֿט די תּורה,</para>
  <para style="q" vid="HAB 1:4">און קײן מאָל קומט נישט אַרױס אַ משפּט;</para>
  <para style="q" vid="HAB 1:4">װײַל דער רשע רינגלט אַרום דעם צדיק,</para>
  <para style="q" vid="HAB 1:4">דערום קומט אַרױס דער משפּט פֿאַרדרײט.<verse eid="HAB 1:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="HAB 1:5" />זעט בײַ די פֿעלקער און קוקט-צו,</para>
  <para style="q" vid="HAB 1:5">און װוּנדערן פֿאַרװוּנדערט אײַך,</para>
  <para style="q" vid="HAB 1:5">װאָרעם אַ טוּונג טוט מען אין אײַערע טעג</para>
  <para style="q" vid="HAB 1:5">איר װעט נישט גלױבן, אַז עס װעט דערצײלט װערן.<verse eid="HAB 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 1:6" />װאָרעם זעט, איך מאַך אױפֿשטײן די כַּשׂדים,</para>
  <para style="q" vid="HAB 1:6">דאָס ביטערע און דאָס האַסטיקע פֿאָלק,</para>
  <para style="q" vid="HAB 1:6">װאָס גײט איבער דער ברײט פֿון דער ערד,</para>
  <para style="q" vid="HAB 1:6">צו אַרבן װױנונגען נישט זײַנע.<verse eid="HAB 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 1:7" />פֿאָרכטיק און מוראדיק איז ער,</para>
  <para style="q" vid="HAB 1:7">פֿון אים אַלײן גײט אַרױס זײַן רעכט און זײַן מאַכט.<verse eid="HAB 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 1:8" />און פֿלינקער פֿון לעמפּערטן זײַנען זײַנע פֿערד,</para>
  <para style="q" vid="HAB 1:8">און שאַרפֿער פֿון אָװנטװעלף;</para>
  <para style="q" vid="HAB 1:8">און זײַנע רײַטער פֿאַרשפּרײטן זיך,</para>
  <para style="q" vid="HAB 1:8">יאָ, זײַנע רײַטער קומען פֿון דער װײַטן,</para>
  <para style="q" vid="HAB 1:8">זײ פֿליען װי אַן אָדלער װאָס אײַלט צו פֿאַרצערן.<verse eid="HAB 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 1:9" />זײ אַלע קומען אױף רױב,</para>
  <para style="q" vid="HAB 1:9">דאָס ציען פֿון זײערע פּנימער איז פֿאַרױס צו;</para>
  <para style="q" vid="HAB 1:9">און ער זאַמלט װי זאַמד געפֿאַנגענע.<verse eid="HAB 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 1:10" />און ער שפּאָט פֿון מלכים,</para>
  <para style="q" vid="HAB 1:10">און פֿירשטן זײַנען אַ שפּילכל בײַ אים;</para>
  <para style="q" vid="HAB 1:10">ער לאַכט פֿון איטלעכער פֿעסטונג,</para>
  <para style="q" vid="HAB 1:10">װאָרעם ער שיט אָן ערד, און באַצװינגט זי.<verse eid="HAB 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 1:11" />דענצמאָל גײט אים אַריבער װי דער װינט,</para>
  <para style="q" vid="HAB 1:11">און ער טרעט איבער און פֿאַרשולדיקט װערען;</para>
  <para style="q" vid="HAB 1:11">זײַן דאָזיקער כּוֹח װערט בײַ אים צום ג-ט.<verse eid="HAB 1:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="HAB 1:12" />פֿאַר װאָר, דו ביסט דאָך פֿון אײביק אָן,</para>
  <para style="q" vid="HAB 1:12">ה׳ מײַן ג-ט, מײַן הײליקער,</para>
  <para style="q" vid="HAB 1:12">לאָמיר נישט אומקומען;</para>
  <para style="q" vid="HAB 1:12">ה׳, דו האָסט אים פֿאַר אַ משפּט געמאַכט,</para>
  <para style="q" vid="HAB 1:12">און דו, פֿעלדז, האָסט אים צו שטראָפֿן געשטעלט.<verse eid="HAB 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 1:13" />דײַנע אױגן זײַנען צו רײן צו זען שלעכטס,</para>
  <para style="q" vid="HAB 1:13">און צוקוקן אומרעכט קענסטו נישט;</para>
  <para style="q" vid="HAB 1:13">פֿאַר װאָס קוקסטו-צו די װאָס פֿעלשן,</para>
  <para style="q" vid="HAB 1:13">שװײַגסט װען דער רשע שלינגט אײַן</para>
  <para style="q" vid="HAB 1:13">דעם װאָס איז גערעכטער פֿון אים?<verse eid="HAB 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 1:14" />און האָסט געמאַכט מענטשן װי די פֿישן פֿון ים,</para>
  <para style="q" vid="HAB 1:14">װי שרצים אָן אַ געװעלטיקער איבער זײ;<verse eid="HAB 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 1:15" />ער ציט זײ אַלע אַרױף מיט אַ װענטקע,</para>
  <para style="q" vid="HAB 1:15">ער שלעפּט זײ אַרױף אין דער נעץ,</para>
  <para style="q" vid="HAB 1:15">און ער זאַמלט זײ אײַן אין זײַן פֿאַנגנעץ;</para>
  <para style="q" vid="HAB 1:15">דערום פֿרײט ער זיך און קװעלט.<verse eid="HAB 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HAB 1:16" />דערום שלאַכט ער צו זײַן נעץ,</para>
  <para style="q" vid="HAB 1:16">און רײכערט צו זײַן פֿאַנגנעץ,</para>
  <para style="q" vid="HAB 1:16">װאָרעם דורך זײ איז פֿעט זײַן חלק,</para>
  <para style="q" vid="HAB 1:16">און זײַן עסן איז זאַפֿטיק.<verse eid="HAB 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 1:17" />זאָל ער דערום אױסלײדיקן זײַן נעץ,</para>
  <para style="q" vid="HAB 1:17">און תּמיד הרגען פֿעלקער אָן דערבאַרעמונג?<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="HAB 2" />
  <para style="q">
    <verse number="1" style="v" sid="HAB 2:1" />איך שטײ אױף מײַן װאַך,</para>
  <para style="q" vid="HAB 2:1">און איך שטעל זיך אױפֿן טורעם,</para>
  <para style="q" vid="HAB 2:1">און קוק צו זען װאָס ה׳ װעט מיט מיר רעדן,</para>
  <para style="q" vid="HAB 2:1">און איך זאָל ענטפֿערן, אױף דער טענה צו מיר.<verse eid="HAB 2:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="HAB 2:2" />האָט מיר ה׳ געענטפֿערט און געזאָגט:</para>
  <para style="q" vid="HAB 2:2">פֿאַרשרײַב די זעונג,</para>
  <para style="q" vid="HAB 2:2">און פֿאַרצײכן קלאָר אױף טאָװלען,</para>
  <para style="q" vid="HAB 2:2">כּדי מע זאָל עס געלױפֿיק לײענען.<verse eid="HAB 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 2:3" />װאָרעם די זעונג איז נאָך אױף אַ צײַט,</para>
  <para style="q" vid="HAB 2:3">און זי רעדט פֿון דעם קֶץ, און זאָגט נישט קײן ליגן;</para>
  <para style="q" vid="HAB 2:3">אױב ער װעט זיך זאַמען, טו האַרן אױף אים,</para>
  <para style="q" vid="HAB 2:3">װאָרעם קומען װעט ער קומען, ער װעט נישט פֿאַרשפּעטיקן.<verse eid="HAB 2:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="HAB 2:4" />זע, האָפֿערדיק, נישט רעכטפֿאַרטיק, איז זײַן זעל אין אים,</para>
  <para style="q" vid="HAB 2:4">אָבער דער גערעכטער לעבט מיט זײַן אמוּנה.<verse eid="HAB 2:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="HAB 2:5" />און פֿאַר װאָר, װי דער װײַן טוט פֿעלשן,</para>
  <para style="q" vid="HAB 2:5">אַזױ װעט דער שטאָלצער מענטש נישט אָנהאַלטן;</para>
  <para style="q" vid="HAB 2:5">דער װאָס מאַכט ברײט װי די אונטערערד זײַן באַגער,</para>
  <para style="q" vid="HAB 2:5">און ער װעט װי דער טױט נישט זאַט,</para>
  <para style="q" vid="HAB 2:5">און זאַמלט צו זיך אַלע פֿעלקער,</para>
  <para style="q" vid="HAB 2:5">און קלײַבט צו זיך אַלע אומות.<verse eid="HAB 2:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="HAB 2:6" />פֿאַר װאָר, די אַלע װעלן אױפֿהײבן אַ משל אױף אים,</para>
  <para style="q" vid="HAB 2:6">און אַ שפּאָטרעטעניש איבער אים,</para>
  <para style="q" vid="HAB 2:6">און מע װעט זאָגן: װײ, דער װאָס מערט נישט-זײַנס –</para>
  <para style="q" vid="HAB 2:6">ביז װאַנען? – און לאָדט אױף זיך חובֿות!<verse eid="HAB 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 2:7" />פֿאַר װאָר, פּלוצלינג װעלן אױפֿשטײן דײַנע צינזמאָנער,</para>
  <para style="q" vid="HAB 2:7">און דערװעקן װעלן זיך דײַנע אױפֿטרײסלער,</para>
  <para style="q" vid="HAB 2:7">און װעסט װערן צו רױב פֿאַר זײ.<verse eid="HAB 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 2:8" />װײַל דו האָסט באַרױבט פֿיל פֿעלקער,</para>
  <para style="q" vid="HAB 2:8">װעלן דיך באַרױבן אַלע איבעריקע אומות;</para>
  <para style="q" vid="HAB 2:8">פֿון װעגן מענטשנס בלוט, און דעם אומרעכט צום לאַנד,</para>
  <para style="q" vid="HAB 2:8">צו דער שטאָט און אַלע װױנער אין איר.<verse eid="HAB 2:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="HAB 2:9" />װײ, דער װאָס האַװעט נאָך בײזן געװין פֿאַר זײַן הױז,</para>
  <para style="q" vid="HAB 2:9">צו מאַכן אין דער הײך זײַן נעסט,</para>
  <para style="q" vid="HAB 2:9">ניצול צו װערן פֿון דער האַנט פֿון בײז!<verse eid="HAB 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 2:10" />האָסט באַראָטן שאַנד פֿאַר דײַן הױז;</para>
  <para style="q" vid="HAB 2:10">פֿאַרשניטן פֿיל פֿעלקער, און פֿאַרזינדיקט דײַן זעל.<verse eid="HAB 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 2:11" />װאָרעם אַ שטײן פֿון דער װאַנט װעט שרײַען,</para>
  <para style="q" vid="HAB 2:11">און אַ באַלקן פֿון דעם האָלץ װעט אים ענטפֿערן.<verse eid="HAB 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 2:12" />װײ, דער װאָס בױט אַ שטאָט מיט בלוט,</para>
  <para style="q" vid="HAB 2:12">און שטעלט אױף אַ כּרַך אױף אומרעכט!<verse eid="HAB 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 2:13" />פֿאַר װאָר, זע, עס איז פֿון ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="HAB 2:13">אַז פֿעלקער זאָלן זיך מאַטערן פֿאַרן פֿײַער,</para>
  <para style="q" vid="HAB 2:13">און אומות זאָלן זיך מיען אומנישט.<verse eid="HAB 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 2:14" />װאָרעם די ערד װעט פֿול װערן מיט דער קענונג פֿון ה׳ס פּראַכט,</para>
  <para style="q" vid="HAB 2:14">אַזױ װי די װאַסערן באַדעקן דעם ים.<verse eid="HAB 2:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="HAB 2:15" />װײ, דער װאָס טרינקט אָן זײַן חבֿר!</para>
  <para style="q" vid="HAB 2:15">מישסט-צו דײַן גיפֿט, און מאַכסט אױך שיכּור,</para>
  <para style="q" vid="HAB 2:15">כּדי צו קוקן אױף זײער נאַקעטקײט!<verse eid="HAB 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HAB 2:16" />האָסט זיך געזעטיקט מיט שאַנד אַנשטאָט כּבֿוד –</para>
  <para style="q" vid="HAB 2:16">טרינק דו אױך און װער אָפּגעדעקט.</para>
  <para style="q" vid="HAB 2:16">אומדרײען װעט זיך צו דיר דער בעכער פֿון ה׳ס רעכטער האַנט,</para>
  <para style="q" vid="HAB 2:16">און קױט װעט זײַן אױף דײַן כּבֿוד.<verse eid="HAB 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 2:17" />װאָרעם דאָס אומרעכט צום לבֿנוֹן װעט דיך צודעקן,</para>
  <para style="q" vid="HAB 2:17">און די פֿאַרװיסטונג פֿון די חיות װאָס האָט זײ צעבראָכן;</para>
  <para style="q" vid="HAB 2:17">פֿון װעגן מענטשנס בלוט, און דעם אומרעכט צום לאַנד,</para>
  <para style="q" vid="HAB 2:17">צו דער שטאָט און אַלע װױנער אין איר.<verse eid="HAB 2:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="HAB 2:18" />װאָס נוצט דער געשניצטער געץ,</para>
  <para style="q" vid="HAB 2:18">אַז זײַן פֿורעמער האָט אים אױסגעשניצט?</para>
  <para style="q" vid="HAB 2:18">װאָס דער געגאָסענער געץ, און דער פֿאַלשער לערער,</para>
  <para style="q" vid="HAB 2:18">אַז דער פֿורעמער פֿון זײַן פֿורעמונג האָט זיך פֿאַרזיכערט דערױף,</para>
  <para style="q" vid="HAB 2:18">צו מאַכן אָפּגעטער שטומע?<verse eid="HAB 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HAB 2:19" />װײ, דער װאָס זאָגט צו אַ האָלץ: כאַפּ זיך אױף!</para>
  <para style="q" vid="HAB 2:19">דערװעק דיך! צו אַ שטײן אַ שטומען. ער זאָל לערנען?</para>
  <para style="q" vid="HAB 2:19">זע, ער איז אײַנגעפֿאַסט אין גאָלד און זילבער,</para>
  <para style="q" vid="HAB 2:19">און אַ שום אָטעם איז אין אים נישטאָ.<verse eid="HAB 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="HAB 2:20" />אָבער ה׳ איז אין זײַן הײליקן הֵיכל;</para>
  <para style="q" vid="HAB 2:20">שטיל פֿאַר אים, די גאַנצע ערד!<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="HAB 3" />
  <para style="q">
    <verse number="1" style="v" sid="HAB 3:1" />אַ תּפֿילה פֿון חֲבַֿקוּק דעם נבֿיא אױף שִגיוֹנות.<verse eid="HAB 3:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="HAB 3:2" />ה׳, איך האָב געהערט דײַן הערונג; איך שרעק מיך;</para>
  <para style="q" vid="HAB 3:2">ה׳, לעב אױף דײַן װערק אין די נאָנטע יאָרן,</para>
  <para style="q" vid="HAB 3:2">אין די נאָנטע יאָרן מאַך עס באַקאַנט;</para>
  <para style="q" vid="HAB 3:2">אין צאָרן געדענק אָן דערבאַרעמען.<verse eid="HAB 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 3:3" />אֱלוֹהַּ קומט פֿון תֵּימָן,</para>
  <para style="q" vid="HAB 3:3">און דער הײליקער פֿון באַרג פּאָרָן.</para>
  <para style="q" vid="HAB 3:3">סֶלָה.</para>
  <para style="q" vid="HAB 3:3">זײַן גלאַנץ באַדעקט די הימלען,</para>
  <para style="q" vid="HAB 3:3">און מיט זײַן ליכטיקײט איז פֿול די ערד.<verse eid="HAB 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 3:4" />און דער שימער איז װי זונליכט,</para>
  <para style="q" vid="HAB 3:4">שטראַלן האָט ער פֿון זײַן זײַט;</para>
  <para style="q" vid="HAB 3:4">און דאָרטן איז די באַהעלטעניש פֿון זײַן מאַכט.<verse eid="HAB 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HAB 3:5" />אים פֿאַרױס גײט די פּעסט,</para>
  <para style="q" vid="HAB 3:5">און דער בליץ גײט אַרױס נאָך זײַנע פֿיס.<verse eid="HAB 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 3:6" />ער שטײט אױף, און צעטרײסלט די ערד,</para>
  <para style="q" vid="HAB 3:6">ער גיט אַ קוק, און מאַכט שפּרינגען די פֿעלקער,</para>
  <para style="q" vid="HAB 3:6">און די אײביקע בערג װערן צעפּיצלט,</para>
  <para style="q" vid="HAB 3:6">די אוראַלטע הײכן פֿאַלן אַנידער;</para>
  <para style="q" vid="HAB 3:6">דאָס זײַנען זײַנע אײביקע װעגן.<verse eid="HAB 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 3:7" />אונטער אומגליק זע איך די געצעלטן פֿון כּושַן,</para>
  <para style="q" vid="HAB 3:7">די פֿאָרהאַנגען פֿון מִדיָן-לאַנד ציטערן.<verse eid="HAB 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 3:8" />האָט אױף די טײַכן, ה׳,</para>
  <para style="q" vid="HAB 3:8">האָט אױף די טײַכן געגרימט דײַן צאָרן?</para>
  <para style="q" vid="HAB 3:8">צי איז אױף דעם ים דײַן כּעס?</para>
  <para style="q" vid="HAB 3:8">װאָס דו רײַטסט אױף דײַנע פֿערד,</para>
  <para style="q" vid="HAB 3:8">אױף דײַנע רײַטװעגן פֿון זיג?<verse eid="HAB 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 3:9" />בלױז אַנטבלױזט איז דײַן בױגן,</para>
  <para style="q" vid="HAB 3:9">באַשװאָרן די פֿײַלן פֿון דײַן װאָרט. סֶלָה.</para>
  <para style="q" vid="HAB 3:9">אין טײַכן צעשפּאַלטסטו די ערד.<verse eid="HAB 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 3:10" />געזען דיך – ציטערן די בערג,</para>
  <para style="q" vid="HAB 3:10">אַ פֿלײצונג װאַסער איז אַריבערגעגאַנגען,</para>
  <para style="q" vid="HAB 3:10">דער תּהום האָט אַרױסגעלאָזט זײַן קֹול,</para>
  <para style="q" vid="HAB 3:10">ער האָט אױפֿגעהױבן אין דער הײך זײַנע הענט.<verse eid="HAB 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 3:11" />די זון, די לבֿנה, האָט זיך אָפּגעשטעלט אין איר װױנונג,</para>
  <para style="q" vid="HAB 3:11">פֿאַר דעם שײַן פֿון דײַנע פֿײַלן װאָס לױפֿן,</para>
  <para style="q" vid="HAB 3:11">פֿאַר דעם שימער פֿון דײַן בליציקן שפּיז.<verse eid="HAB 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 3:12" />מיט צאָרן שפּרײַזטו איבער דער ערד,</para>
  <para style="q" vid="HAB 3:12">מיט כּעס דרעשסטו די אומות.<verse eid="HAB 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 3:13" />ביסט אַרױס צו הילף דײַן פֿאָלק,</para>
  <para style="q" vid="HAB 3:13">צו הילף דײַן געזאַלבטן;</para>
  <para style="q" vid="HAB 3:13">האָסט צעהאַקט דעם קאָפּ, פֿון דעם רשעס הױז,</para>
  <para style="q" vid="HAB 3:13">האָסט אױפֿגעדעקט דעם גרונט ביזן האַלדז.</para>
  <para style="q" vid="HAB 3:13">סֶלָה.<verse eid="HAB 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 3:14" />האָסט צעלעכערט מיט זײַנע פֿײַלן דעם קאָפּ פֿון זײַנע קריגערס,</para>
  <para style="q" vid="HAB 3:14">װאָס שטורעמען מיך צו צעשפּרײטן;</para>
  <para style="q" vid="HAB 3:14">װאָס זײער פֿרײד איז װי אױפֿצועסן דעם אָרעמאַן אין פֿאַרבאָרגעניש.<verse eid="HAB 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 3:15" />האָסט געטרעטן דעם ים מיט דײַנע פֿערד,</para>
  <para style="q" vid="HAB 3:15">דעם שױם פֿון די גרױסע װאַסערן.<verse eid="HAB 3:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="HAB 3:16" />איך האָב געהערט, און מײַן לײַב האָט געציטערט,</para>
  <para style="q" vid="HAB 3:16">פֿון דעם קֹול האָבן מײַנע ליפּן געקלאַפּט;</para>
  <para style="q" vid="HAB 3:16">אַ פֿױלונג איז אַרײַן אין מײַנע בײנער,</para>
  <para style="q" vid="HAB 3:16">און איך ציטער אױף מײַן אָרט:</para>
  <para style="q" vid="HAB 3:16">אַז איך זאָל זײַן באַרוט אין טאָג פֿון נױט,</para>
  <para style="q" vid="HAB 3:16">װען מע קומט אױפֿן פֿאָלק אים צו באַפֿאַלן.<verse eid="HAB 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 3:17" />פֿאַר װאָר, דער פֿײַגנבױם בליט נישט,</para>
  <para style="q" vid="HAB 3:17">און נישטאָ קײן פֿרוכט אױף די װײַנשטאָקן,</para>
  <para style="q" vid="HAB 3:17">געפֿעלשט האָט דער אײַנקום פֿון אײלבערטבױם,</para>
  <para style="q" vid="HAB 3:17">און די פֿעלדער גיבן נישט קײן שפּײַז,</para>
  <para style="q" vid="HAB 3:17">אָפּגעשניטן פֿון געהעפֿט איז די שאָף,</para>
  <para style="q" vid="HAB 3:17">און נישטאָ קײן רינדער אין די שטאַלן,<verse eid="HAB 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="HAB 3:18" />אָבער איך װעל מיך פֿרײען מיט ה׳,</para>
  <para style="q" vid="HAB 3:18">און לוסטיק זײַן מיט דעם ג-ט פֿון מײַן הילף.<verse eid="HAB 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HAB 3:19" />ה׳ אֲדֹנָי איז מײַן שטאַרקײט,</para>
  <para style="q" vid="HAB 3:19">און ער מאַכט מײַנע פֿיס װי די הינדן,</para>
  <para style="q" vid="HAB 3:19">און אױף מײַנע הײכן מאַכט ער מיך טרעטן.</para>
  <para style="b" vid="HAB 3:19" />
  <para style="q" vid="HAB 3:19">פֿאַר דעם געזאַנגמײַסטער. מיט מײַן סטרונעשפּיל.<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>