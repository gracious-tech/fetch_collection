<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">יוֹאֵל</para>
  <para style="toc2">יוֹאֵל</para>
  <para style="toc1">יוֹאֵל</para>
  <para style="mt1">יוֹאֵל</para>
  <chapter number="1" style="c" pubnumber="א" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />דאָס װאָרט פֿון ה׳ װאָס איז געװען צו יוֹאֵל דעם זון פֿון פּתואֵלן:<verse eid="JOL 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOL 1:2" />הערט דאָס צו, איר זקנים,</para>
  <para style="q" vid="JOL 1:2">און פֿאַרנעמט אַלע באַװױנער פֿון לאַנד:</para>
  <para style="q" vid="JOL 1:2">איז אַזױ װאָס געשען אין אײַערע טעג,</para>
  <para style="q" vid="JOL 1:2">צי אין די טעג פֿון אײַערע עלטערן?<verse eid="JOL 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 1:3" />דערצײלט װעגן דעם אײַערע קינדער,</para>
  <para style="q" vid="JOL 1:3">און אײַערע קינדער צו זײערע קינדער,</para>
  <para style="q" vid="JOL 1:3">און זײערע קינדער צו דעם אַנדער דור.<verse eid="JOL 1:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="JOL 1:4" />װאָס איז געבליבן פֿון דעם װאָרעם</para>
  <para style="q" vid="JOL 1:4">האָט אױפֿגעגעסן דער הײשעריק,</para>
  <para style="q" vid="JOL 1:4">און װאָס איז געבליבן פֿון דעם הײשעריק</para>
  <para style="q" vid="JOL 1:4">האָט אױפֿגעגעסן דער גראָזפֿרעסער,</para>
  <para style="q" vid="JOL 1:4">און װאָס איז געבליבן פֿון דעם גראָזפֿרעסער</para>
  <para style="q" vid="JOL 1:4">האָט אױפֿגעגעסן דער גריל.<verse eid="JOL 1:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="JOL 1:5" />כאַפּט זיך אױף, שיכּורים, און װײנט,</para>
  <para style="q" vid="JOL 1:5">און יאָמערט, אַלע טרינקער פֿון װײַן,</para>
  <para style="q" vid="JOL 1:5">אױף דער טרױבנזאַפֿט װאָס זי איז פֿאַרשניטן געװאָרן</para>
  <para style="q" vid="JOL 1:5">פֿון אײַער מױל.<verse eid="JOL 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 1:6" />װאָרעם אַ פֿאָלק איז אַרױפֿגעקומען אױף מײַן לאַנד,</para>
  <para style="q" vid="JOL 1:6">מאַכטיק און אָן אַ צאָל;</para>
  <para style="q" vid="JOL 1:6">זײַנע צײן זײַנען צײן פֿון אַ לײב,</para>
  <para style="q" vid="JOL 1:6">און באַקצײנער פֿון אַ לײבנטע האָט ער.<verse eid="JOL 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 1:7" />ער האָט געמאַכט מײַן װײַנשטאָק צו װיסט,</para>
  <para style="q" vid="JOL 1:7">און צו שפּענדלעך מײַן פֿײַגנבױם;</para>
  <para style="q" vid="JOL 1:7">אָפּגעהױלט הױל האָט ער אים און אַנידערגעװאָרפֿן,</para>
  <para style="q" vid="JOL 1:7">זײַנע צװײַגן זײַנען װײַס געװאָרן.<verse eid="JOL 1:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="JOL 1:8" />קלאָג װי אַ יונגפֿרױ אָנגעגורט מיט זאַק</para>
  <para style="q" vid="JOL 1:8">נאָך דעם מאַן פֿון איר יוגנט.<verse eid="JOL 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 1:9" />פֿאַרשניטן געװאָרן איז אַ שפּײַזאָפּפֿער און אַ גיסאָפּפֿער</para>
  <para style="q" vid="JOL 1:9">פֿון דעם הױז פֿון ה׳;</para>
  <para style="q" vid="JOL 1:9">עס טרױערן די כּהנים,</para>
  <para style="q" vid="JOL 1:9">די באַדינער פֿון ה׳.<verse eid="JOL 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 1:10" />פֿאַרװיסט געװאָרן איז דאָס פֿעלד,</para>
  <para style="q" vid="JOL 1:10">עס טרױערט די ערד,</para>
  <para style="q" vid="JOL 1:10">װאָרעם פֿאַרװיסט געװאָרן איז די תּבֿואה,</para>
  <para style="q" vid="JOL 1:10">אױסגעטריקנט האָט דער װײַן,</para>
  <para style="q" vid="JOL 1:10">אײַנגעגאַנגען איז דאָס אײל.<verse eid="JOL 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 1:11" />צו שאַנד זײַנען די אַקערלײַט,</para>
  <para style="q" vid="JOL 1:11">עס יאָמערן די װײַנגערטנירער,</para>
  <para style="q" vid="JOL 1:11">אױפֿן װײץ און אױפֿן גערשטן;</para>
  <para style="q" vid="JOL 1:11">װאָרעם דער שניט פֿון פֿעלד איז פֿאַרלאָרן.<verse eid="JOL 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 1:12" />דער װײַנשטאָק איז פֿאַרטריקנט,</para>
  <para style="q" vid="JOL 1:12">און דער פֿײַגנבױם איז פֿאַרװעלקט;</para>
  <para style="q" vid="JOL 1:12">דער מילגרױם, אױך דער טײטלבױם און דער עפּלבױם,</para>
  <para style="q" vid="JOL 1:12">אַלע בײמער פֿון פֿעלד, זײַנען פֿאַרטריקנט;</para>
  <para style="q" vid="JOL 1:12">יאָ, אױסגעטריקנט האָט די פֿרײד פֿון די מענטשנקינדער.<verse eid="JOL 1:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JOL 1:13" />גורט אײַך אָן און קלאָגט, איר כּהנים,</para>
  <para style="q" vid="JOL 1:13">יאָמערט, איר באַדינער פֿון מזבח;</para>
  <para style="q" vid="JOL 1:13">קומט נעכטיקט אין זאַקקלײדער, באַדינער פֿון מײַן ג-ט,</para>
  <para style="q" vid="JOL 1:13">װאָרעם פֿאַרמיטן איז פֿון דעם הױז פֿון אלוקיכם</para>
  <para style="q" vid="JOL 1:13">אַ שפּײַזאָפּפֿער און אַ גיסאָפּפֿער.<verse eid="JOL 1:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JOL 1:14" />הײליקט אַ פֿאַסטטאָג, רופֿט אַן אײַנזאַמלונג,</para>
  <para style="q" vid="JOL 1:14">קלײַבט צונױף די עלטסטע, אַלע באַװױנער פֿון לאַנד,</para>
  <para style="q" vid="JOL 1:14">אין הױז פֿון ה׳ אלוקיכם,</para>
  <para style="q" vid="JOL 1:14">און טוט שרײַען צו ה׳.<verse eid="JOL 1:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="JOL 1:15" />װײ אױף דעם טאָג!</para>
  <para style="q" vid="JOL 1:15">װאָרעם נאָנט איז דער טאָג פֿון ה׳,</para>
  <para style="q" vid="JOL 1:15">און װי אַ בראָך פֿון שַדַי קומט ער.<verse eid="JOL 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 1:16" />פֿאַר װאָר, פֿאַר אונדזערע אױגן</para>
  <para style="q" vid="JOL 1:16">איז פֿאַרשניטן די שפּײַז;</para>
  <para style="q" vid="JOL 1:16">פֿון אונדזער ג-טס הױז, די פֿרײד און די לוסטיקײט.<verse eid="JOL 1:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="JOL 1:17" />אײַנגעדאַרט זײַנען די זאָמען אונטער זײערע גרודעס,</para>
  <para style="q" vid="JOL 1:17">װיסט געװאָרן זײַנען די שפּײַכלערס,</para>
  <para style="q" vid="JOL 1:17">אײַנגעפֿאַלן זײַנען די שײַערן</para>
  <para style="q" vid="JOL 1:17">װאָרעם אױסגעטריקנט איז די תּבֿואה.<verse eid="JOL 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 1:18" />װי קרעכצט די בהמה!</para>
  <para style="q" vid="JOL 1:18">צעטומלט זײַנען די סטאַדעס רינדער,</para>
  <para style="q" vid="JOL 1:18">װאָרעם נישטאָ פֿאַר זײ קײן פֿיטערונג;</para>
  <para style="q" vid="JOL 1:18">אַפֿילו די סטאַדעס שאָף זײַנען פֿאַרװיסט.<verse eid="JOL 1:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="JOL 1:19" />צו דיר, ה׳, טו איך רופֿן,</para>
  <para style="q" vid="JOL 1:19">װאָרעם אַ פֿײַער האָט פֿאַרצערט</para>
  <para style="q" vid="JOL 1:19">די פֿיטערפּלעצער פֿון מדבר,</para>
  <para style="q" vid="JOL 1:19">און אַ פֿלאַם האָט צעפֿלאַקערט</para>
  <para style="q" vid="JOL 1:19">אַלע בײמער פֿון פֿעלד.<verse eid="JOL 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 1:20" />אַפֿילו די בהמות פֿון פֿעלד שרײַען צו דיר,</para>
  <para style="q" vid="JOL 1:20">װאָרעם אױסגעטריקנט זײַנען די גראָבנס װאַסער,</para>
  <para style="q" vid="JOL 1:20">און אַ פֿײַער האָט פֿאַרצערט די פֿיטערפּלעצער פֿון מדבר.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="JOL 2" />
  <para style="q">
    <verse number="1" style="v" sid="JOL 2:1" />בלאָזט אַ שופֿר אין צִיוֹן,</para>
  <para style="q" vid="JOL 2:1">און שאַלט אױף מײַן הײליקן באַרג,</para>
  <para style="q" vid="JOL 2:1">זאָלן ציטערן אַלע באַװױנער פֿון לאַנד,</para>
  <para style="q" vid="JOL 2:1">װאָרעם דער טאָג פֿון ה׳ קומט אָן,</para>
  <para style="q" vid="JOL 2:1">װאָרעם ער איז נאָנט;<verse eid="JOL 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 2:2" />אַ טאָג פֿון חוֹשך און פֿינצטערניש,</para>
  <para style="q" vid="JOL 2:2">אַ טאָג פֿון װאָלקן און נעבל,</para>
  <para style="q" vid="JOL 2:2">װי אַ שװאַרצקײט אױסגעשפּרײט אױף די בערג;</para>
  <para style="q" vid="JOL 2:2">אַ גרױס פֿאָלק און אַ מאַכטיקס,</para>
  <para style="q" vid="JOL 2:2">אַזאַ װי ער איז נישט געװען פֿון אײביק אָן</para>
  <para style="q" vid="JOL 2:2">און װעט נאָך אים מער נישט זײַן</para>
  <para style="q" vid="JOL 2:2">ביז די יאָרן פֿון דור-דורות.<verse eid="JOL 2:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="JOL 2:3" />אים פֿאַרױס פֿאַרצערט אַ פֿײַער,</para>
  <para style="q" vid="JOL 2:3">און הינטער אים פֿלאַקערט אַ פֿלאַם;</para>
  <para style="q" vid="JOL 2:3">װי דער גאָרטן פֿון עֵדֶן איז דאָס לאַנד פֿאַר אים,</para>
  <para style="q" vid="JOL 2:3">און הינטער אים אַ מדבר אַ װיסטער,</para>
  <para style="q" vid="JOL 2:3">און צו מאָל קײן אַנטרינונג איז נישטאָ פֿון אים.<verse eid="JOL 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 2:4" />װי דאָס אױסזען פֿון פֿערד איז זײַן אױסזען,</para>
  <para style="q" vid="JOL 2:4">און װי רײַטער אַזױ לױפֿן זײ.<verse eid="JOL 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 2:5" />װי דאָס גערױש פֿון רײַטװעגן,</para>
  <para style="q" vid="JOL 2:5">איז זײער שפּרינגען אױף די שפּיצן בערג;</para>
  <para style="q" vid="JOL 2:5">װי דער קנאַל פֿון אַ פֿלאַמפֿײַער װאָס פֿאַרצערט שטרױ;</para>
  <para style="q" vid="JOL 2:5">װי אַ פֿאָלק אַ מאַכטיקס געגרײט צו מלחמה.<verse eid="JOL 2:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="JOL 2:6" />פֿאַר אים ציטערן פֿעלקער,</para>
  <para style="q" vid="JOL 2:6">אַלע פּנימער האָבן אָנגענומען אַ פֿינצטערניש.<verse eid="JOL 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 2:7" />װי גיבוֹרים לױפֿן זײ,</para>
  <para style="q" vid="JOL 2:7">װי מלחמה-לײַט קלעטערן זײ אױף דער מױער,</para>
  <para style="q" vid="JOL 2:7">און איטלעכער אין זײַנע װעגן גײען זײ,</para>
  <para style="q" vid="JOL 2:7">און זײ פּלאָנטערן נישט זײערע שטעגן.<verse eid="JOL 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 2:8" />און אײנער דעם אַנדערן שטױסן זײ נישט,</para>
  <para style="q" vid="JOL 2:8">איטלעכער אין זײַן שליאַך גײען זײ,</para>
  <para style="q" vid="JOL 2:8">און דורך װאָפֿן װאַרפֿן זײ זיך,</para>
  <para style="q" vid="JOL 2:8">און װערן נישט געשעדיקט.<verse eid="JOL 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 2:9" />זײ שפּרינגען אױף דער שטאָט,</para>
  <para style="q" vid="JOL 2:9">זײ לױפֿן אױף דער מױער,</para>
  <para style="q" vid="JOL 2:9">זײ גײען אַרױף אין די הײַזער,</para>
  <para style="q" vid="JOL 2:9">זײ קומען דורך די פֿענצטער װי אַ גנבֿ.<verse eid="JOL 2:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="JOL 2:10" />פֿאַר אים ציטערט די ערד,</para>
  <para style="q" vid="JOL 2:10">שטורעמען די הימלען;</para>
  <para style="q" vid="JOL 2:10">די זון און די לבֿנה װערן שװאַרץ,</para>
  <para style="q" vid="JOL 2:10">און די שטערן נעמען אַרײַן זײער שײַן.<verse eid="JOL 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 2:11" />און ה׳ לאָזט אַרױס זײַן קֹול פֿאַרױס פֿאַר זײַן חיל;</para>
  <para style="q" vid="JOL 2:11">װאָרעם זײער גרױס איז זײַן מחנה,</para>
  <para style="q" vid="JOL 2:11">װאָרעם מאַכטיק איז דער װאָס טוט זײַן באַפֿעל;</para>
  <para style="q" vid="JOL 2:11">װאָרעם גרױס איז דער טאָג פֿון ה׳ און מוראדיק זײער,</para>
  <para style="q" vid="JOL 2:11">און װער קען אים אױסהאַלטן?<verse eid="JOL 2:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="JOL 2:12" />אָבער נאָך איצט, זאָגט ה׳,</para>
  <para style="q" vid="JOL 2:12">קערט אײַך אום צו מיר מיט אײַער גאַנצן האַרצן,</para>
  <para style="q" vid="JOL 2:12">און מיט פֿאַסטן און מיט געװײן און מיט קלאָג;<verse eid="JOL 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 2:13" />און צערײַסט אײַער האַרץ און נישט אײַערע קלײדער,</para>
  <para style="q" vid="JOL 2:13">און קערט אײַך אום צו ה׳ אלוקיכם,</para>
  <para style="q" vid="JOL 2:13">װאָרעם ער איז לײַטזעליק און דערבאַרעמדיק,</para>
  <para style="q" vid="JOL 2:13">אײַנגעהאַלטן אין צאָרן, און רײַך אין גענאָד,</para>
  <para style="q" vid="JOL 2:13">און ער האָט חרטה אױף דעם בײז.<verse eid="JOL 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 2:14" />װער װײס, אפֿשר װידער װעט ער חרטה האָבן,</para>
  <para style="q" vid="JOL 2:14">און לאָזן אַ ברכה הינטער זיך –</para>
  <para style="q" vid="JOL 2:14">אַ שפּײַזאָפּפֿער און אַ גיסאָפּפֿער</para>
  <para style="q" vid="JOL 2:14">פֿאַר ה׳ אלוקיכם.<verse eid="JOL 2:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="JOL 2:15" />בלאָזט אַ שופֿר אין צִיוֹן,</para>
  <para style="q" vid="JOL 2:15">הײליקט אַ פֿאַסטטאָג, רופֿט אַן אײַנזאַמלונג;<verse eid="JOL 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 2:16" />זאַמלט אײַן דאָס פֿאָלק,</para>
  <para style="q" vid="JOL 2:16">פֿאַררופֿט די עדה,</para>
  <para style="q" vid="JOL 2:16">קלײַבט צונױף די זקנים,</para>
  <para style="q" vid="JOL 2:16">זאַמלט אײַן די קלײנע קינדער,</para>
  <para style="q" vid="JOL 2:16">און די װאָס זײגן די ברוסט;</para>
  <para style="q" vid="JOL 2:16">זאָל דער חתן אַרױסגײן פֿון זײַן קאַמער,</para>
  <para style="q" vid="JOL 2:16">און די כּלה פֿון איר געצעלט.<verse eid="JOL 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 2:17" />צװישן דעם פּאָליש און דעם מזבח</para>
  <para style="q" vid="JOL 2:17">זאָלן װײנען די כּהנים, די דינער פֿון ה׳,</para>
  <para style="q" vid="JOL 2:17">און זאָלן זײ זאָגן:</para>
  <para style="q" vid="JOL 2:17">דערבאַרים זיך ה׳ אױף דײַן פֿאָלק,</para>
  <para style="q" vid="JOL 2:17">און זאָלסט נישט געבן דײַן אַרב צו שאַנד,</para>
  <para style="q" vid="JOL 2:17">אַז פֿעלקער זאָלן זיך װערטלען איבער זײ;</para>
  <para style="q" vid="JOL 2:17">נאָך װאָס זאָל מען זאָגן צװישן די אומות:</para>
  <para style="q" vid="JOL 2:17">װוּ איז זײער ג-ט?<verse eid="JOL 2:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JOL 2:18" />און ה׳ האָט זיך אײפֿער פֿאַר זײַן לאַנד,</para>
  <para style="q" vid="JOL 2:18">און האָט זיך דערבאַרעמט אױף זײַן פֿאָלק.<verse eid="JOL 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 2:19" />און ה׳ האָט געענטפֿערט און געזאָגט צו זײַן פֿאָלק:</para>
  <para style="q" vid="JOL 2:19">זעט, איך שיק אײַך תּבֿואה און װײַן און אײל,</para>
  <para style="q" vid="JOL 2:19">און איר װעט זײ האָבן צו זאַט;</para>
  <para style="q" vid="JOL 2:19">און איך װעל אײַך מער נישט געבן צו שאַנד בײַ די פֿעלקער.<verse eid="JOL 2:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="JOL 2:20" />און דעם צפֿונדיקן װעל איך דערװײַטערן פֿון אײַך,</para>
  <para style="q" vid="JOL 2:20">און װעל אים פֿאַרשטױסן אין אַ לאַנד פֿון טריקעניש און װיסטעניש,</para>
  <para style="q" vid="JOL 2:20">מיט זײַן פּנים צום פֿעדערשטן ים,</para>
  <para style="q" vid="JOL 2:20">און זײַן עק צום הינטערשטן ים;</para>
  <para style="q" vid="JOL 2:20">און זײַן פֿױלגערוך װעט אױפֿגײן,</para>
  <para style="q" vid="JOL 2:20">און זײַן געשטאַנק װעט אױפֿגײן,</para>
  <para style="q" vid="JOL 2:20">װײַל ער האָט גרױס זיך פֿאַרנומען.<verse eid="JOL 2:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JOL 2:21" />זאָלסט נישט מורא האָבן, ערד,</para>
  <para style="q" vid="JOL 2:21">פֿרײ זיך און זײ לוסטיק,</para>
  <para style="q" vid="JOL 2:21">װאָרעם גרױס געטאָן האָט ה׳.<verse eid="JOL 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOL 2:22" />איר זאָלט נישט מורא האָבן, בהמות פֿון פֿעלד,</para>
  <para style="q" vid="JOL 2:22">װאָרעם די פֿיטערפּלעצער פֿון מדבר זײַנען באַגראָזט,</para>
  <para style="q" vid="JOL 2:22">װאָרעם דער בױם טראָגט זײַן פֿרוכט,</para>
  <para style="q" vid="JOL 2:22">דער פֿײַגנבױם און דער װײַנשטאָק גיבן זײער קריפֿט.<verse eid="JOL 2:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="JOL 2:23" />און איר קינדער פֿון צִיוֹן,</para>
  <para style="q" vid="JOL 2:23">זײַט לוסטיק און פֿרײט זיך מיט ה׳ אלוקיכם,</para>
  <para style="q" vid="JOL 2:23">װאָרעם ער גיט אײַך דעם פֿרירעגן ריכטיק;</para>
  <para style="q" vid="JOL 2:23">יאָ, ער מאַכט נידערן פֿאַר אײַך רעגן,</para>
  <para style="q" vid="JOL 2:23">פֿרירעגן און שפּעטרעגן אין ערשטן חודש.<verse eid="JOL 2:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="JOL 2:24" />און די דרעשן װעלן פֿול זײַן מיט תּבֿואה,</para>
  <para style="q" vid="JOL 2:24">און די קעלטערן װעלן איבערלױפֿן מיט װײַן און אײל.<verse eid="JOL 2:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOL 2:25" />און איך װעל אײַך אָפּצאָלן די יאָרן</para>
  <para style="q" vid="JOL 2:25">װאָס דער הײשעריק האָט אױפֿגעגעסן,</para>
  <para style="q" vid="JOL 2:25">דער גראָזפֿרעסער, און דער גריל, און דער װאָרעם,</para>
  <para style="q" vid="JOL 2:25">מײַן גרױס חיל װאָס איך האָב אָנגעשיקט אױף אײַך.<verse eid="JOL 2:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="JOL 2:26" />און עסן װעט איר עסן און זאַט זײַן,</para>
  <para style="q" vid="JOL 2:26">און איר װעט לױבן דעם נאָמען פֿון ה׳ אלוקיכם,</para>
  <para style="q" vid="JOL 2:26">װאָס האָט געטאָן מיט אײַך װוּנדערלעך;</para>
  <para style="q" vid="JOL 2:26">און מײַן פֿאָלק װעט אױף אײביק נישט פֿאַרשעמט װערן.<verse eid="JOL 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOL 2:27" />און איר װעט װיסן אַז איך בין צװישן יִשׂרָאֵל,</para>
  <para style="q" vid="JOL 2:27">און איך בין ה׳ אלוקיכם, און מער איז נישטאָ;</para>
  <para style="q" vid="JOL 2:27">און מײַן פֿאָלק װעט אױף אײביק נישט פֿאַרשעמט װערן.<verse eid="JOL 2:27" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="JOL 3" />
  <para style="q">
    <verse number="1" style="v" pubnumber="2.28" sid="JOL 3:1" /> און עס װעט זײַן נאָך דעם,</para>
  <para style="q" vid="JOL 3:1">װעל איך אױסגיסן מײַן גײַסט אױף יעטװעדער לײַב,</para>
  <para style="q" vid="JOL 3:1">און אײַערע זין און אײַערע טעכטער װעלן נבֿיאות זאָגן,</para>
  <para style="q" vid="JOL 3:1">אײַערע זקנים װעלן חלומות חלומען,</para>
  <para style="q" vid="JOL 3:1">אײַערע בחורים װעלן זעונגען זען.<verse eid="JOL 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" pubnumber="2.29" sid="JOL 3:2" /> און אױך אױף די קנעכט און אױף די דינסטן</para>
  <para style="q" vid="JOL 3:2">װעל איך אױסגיסן מײַן גײַסט אין יענע טעג.<verse eid="JOL 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" pubnumber="2.30" sid="JOL 3:3" /> און איך װעל װײַזן װוּנדער אין הימל און אױף דער ערד,</para>
  <para style="q" vid="JOL 3:3">בלוט און פֿײַער און זײַלן רױך.<verse eid="JOL 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" pubnumber="2.31" sid="JOL 3:4" /> די זון װעט פֿאַרקערט װערן אין פֿינצטערניש, און די לבֿנה אין בלוט, אײדער עס קומט דער טאָג פֿון ה׳, דער גרױסער און דער מוֹראדיקער. <verse eid="JOL 3:4" /><verse number="5" style="v" pubnumber="2.32" sid="JOL 3:5" /> און עס װעט זײַן, איטלעכער װאָס װעט רופֿן דעם נאָמען פֿון הָאָדוֹן, װעט געראַטעװעט װערן; װאָרעם אױף באַרג צִיוֹן און אין ירושָלַיִם װעט זײַן אַן אַנטרינונג, אַזױ װי ה׳ האָט געזאָגט; און די געבליבענע װעלן זײַן די װאָס ה׳ טוט רופֿן.<verse eid="JOL 3:5" /></para>
  <chapter eid="JOL 3" />
  <chapter number="4" style="c" altnumber="3" pubnumber="ד" sid="JOL 4" />
  <para style="p">
    <verse number="1" style="v" pubnumber="3.1" sid="JOL 4:1" /> װאָרעם זע, אין יענע טעג און אין יענער צײַט, אַז איך װעל אומקערן די געפֿאַנגענשאַפֿט פֿון יהוּדה און ירושָלַיִם, <verse eid="JOL 4:1" /><verse number="2" style="v" pubnumber="3.2" sid="JOL 4:2" /> װעל איך אײַנזאַמלען אַלע פֿעלקער, און איך װעל זײ מאַכן נידערן אין טאָל פֿון יהוֹשָפָֿט, און איך װעל זיך דאָרטן משפּטן מיט זײ פֿאַר מײַן פֿאָלק און מײַן אַרב יִשׂרָאֵל, װאָס זײ האָבן זײ צעשפּרײט צװישן די פֿעלקער, און צעטײלט מײַן לאַנד. <verse eid="JOL 4:2" /><verse number="3" style="v" pubnumber="3.3" sid="JOL 4:3" /> און אױף מײַן פֿאָלק האָבן זײ גורל געװאָרפֿן, און געגעבן אַ ייִנגל פֿאַר אַ זוֹנה, און אַ מײדל פֿאַרקױפֿט פֿאַר װײַן, און געטרונקען.<verse eid="JOL 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="3.4" sid="JOL 4:4" /> און װאָס זײַט איר מיר גאָר, צוֹר און צידון און אַלע געגנטן פֿון פּלֶשֶת? צי פֿאַרגעלטונג צאָלט איר דאָס אָפּ פֿון מײַנעטװעגן? איז, אױב איר פֿאַרגעלט דאָס פֿון מײַנעטװעגן, װעל איך אײַליק גיך אומקערן אײַער פֿאַרגעלטונג אױף אײַער קאָפּ; <verse eid="JOL 4:4" /><verse number="5" style="v" pubnumber="3.5" sid="JOL 4:5" /> װאָס מײַן זילבער און מײַן גאָלד האָט איר צוגענומען, און מײַנע בעסטע גלוסטיקײטן געבראַכט אין אײַערע פּאַלאַצן <verse eid="JOL 4:5" /><verse number="6" style="v" pubnumber="3.6" sid="JOL 4:6" /> און די קינדער פֿון יהוּדה און די קינדער פֿון ירושָלַיִם האָט איר פֿאַרקױפֿט צו די קינדער פֿון די יוָנים, כּדי זײ צו דערװײַטערן פֿון זײער געמאַרק. <verse eid="JOL 4:6" /><verse number="7" style="v" pubnumber="3.7" sid="JOL 4:7" /> זעט, איך דערװעק זײ פֿון דעם אָרט װאָס איר האָט זײ פֿאַרקױפֿט דאָרטן, און איך װעל אומקערן אײַער טוּונג אױף אײַער קאָפּ. <verse eid="JOL 4:7" /><verse number="8" style="v" pubnumber="3.8" sid="JOL 4:8" /> און איך װעל פֿאַרקױפֿן אײַערע זין און אײַערע טעכטער אין דער האַנט פֿון די קינדער פֿון יהוּדה, און זײ װעלן זײ פֿאַרקױפֿן צו די שבֿאים, צו אַ װײַטן פֿאָלק, װאָרעם ה׳ האָט גערעדט.<verse eid="JOL 4:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" pubnumber="3.9" sid="JOL 4:9" /> רופֿט דאָס אױס צװישן די פֿעלקער,</para>
  <para style="q" vid="JOL 4:9">ברײט אָן אַ מלחמה,</para>
  <para style="q" vid="JOL 4:9">װעקט אױף די גיבוֹרים;</para>
  <para style="q" vid="JOL 4:9">זאָלן גענענען, זאָלן אַרױפֿגײן אַלע מענער פֿון מלחמה.<verse eid="JOL 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" pubnumber="3.10" sid="JOL 4:10" /> שמידט אײַערע אַקעראײַזנס אױף שװערדן,</para>
  <para style="q" vid="JOL 4:10">און אײַערע צװײַגמעסערס אױף שפּיזן;</para>
  <para style="q" vid="JOL 4:10">דער שלאַפֿער זאָל זאָגן: אַ גיבור בין איך.<verse eid="JOL 4:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" pubnumber="3.11" sid="JOL 4:11" /> אײַלט און קומט אַלע פֿעלקער פֿון רונד אַרום,</para>
  <para style="q" vid="JOL 4:11">און לאָמען זיך אײַנזאַמלען;</para>
  <para style="q" vid="JOL 4:11">אַהין מאַך נידערן, ה׳, דײַנע גיבוֹרים!<verse eid="JOL 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" pubnumber="3.12" sid="JOL 4:12" /> זאָלן זיך דערװעקן די פֿעלקער און אַרױפֿגײן צום טאָל פֿון יהוֹשָפָֿט,</para>
  <para style="q" vid="JOL 4:12">װאָרעם דאָרטן װעל איך זיצן צו משפּטן</para>
  <para style="q" vid="JOL 4:12">אַלע פֿעלקער פֿון רונד אַרום.<verse eid="JOL 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" pubnumber="3.13" sid="JOL 4:13" /> לײגט צו דעם שנײַדמעסער, װאָרעם צײַטיק איז דער שניט;</para>
  <para style="q" vid="JOL 4:13">קומט טרעט, װאָרעם פֿול איז דער קעלטער,</para>
  <para style="q" vid="JOL 4:13">די קובלען לױפֿן איבער, װאָרעם גרױס איז זײער בײז.<verse eid="JOL 4:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" pubnumber="3.14" sid="JOL 4:14" /> מחנות, מחנות אין טאָל פֿון גזר!</para>
  <para style="q" vid="JOL 4:14">װאָרעם נאָנט איז דער טאָג פֿון ה׳ אין טאָל פֿון גזר.<verse eid="JOL 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" pubnumber="3.15" sid="JOL 4:15" /> די זון און די לבֿנה װערן שװאַרץ,</para>
  <para style="q" vid="JOL 4:15">און די שטערן נעמען אַרײַן זײער שײַן.<verse eid="JOL 4:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" pubnumber="3.16" sid="JOL 4:16" /> און ה׳ װעט ברילן פֿון צִיוֹן,</para>
  <para style="q" vid="JOL 4:16">און פֿון ירושָלַיִם װעט ער אַרױסלאָזן זײַן קֹול,</para>
  <para style="q" vid="JOL 4:16">און שטורעמען װעלן הימל און ערד;</para>
  <para style="q" vid="JOL 4:16">אָבער ה׳ װעט זײַן אַ באַשיצונג פֿאַר זײַן פֿאָלק,</para>
  <para style="q" vid="JOL 4:16">און אַ פֿעסטונג פֿאַר די קינדער פֿון יִשׂרָאֵל.<verse eid="JOL 4:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" pubnumber="3.17" sid="JOL 4:17" /> און איר װעט װיסן אַז איך, ה׳ אלוקיכם,</para>
  <para style="q" vid="JOL 4:17">רו אױף צִיוֹן, מײַן הײליקן באַרג;</para>
  <para style="q" vid="JOL 4:17">און ירושָלַיִם װעט זײַן הײליק,</para>
  <para style="q" vid="JOL 4:17">און פֿרעמדע װעלן מער נישט דורכגײן אין איר.<verse eid="JOL 4:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" pubnumber="3.18" sid="JOL 4:18" /> און עס װעט זײַן אין יענעם טאָג,</para>
  <para style="q" vid="JOL 4:18">װעלן די בערג טריפֿן זאַפֿט,</para>
  <para style="q" vid="JOL 4:18">און די הײכן װעלן איבערגײן מיט מילך,</para>
  <para style="q" vid="JOL 4:18">און אַלע גראָבנס פֿון יהוּדה װעלן איבערגײן מיט װאַסער.</para>
  <para style="q" vid="JOL 4:18">און אַ קװאַל װעט אַרױסגײן פֿון ה׳ס הױז,</para>
  <para style="q" vid="JOL 4:18">און װעט אָנטרינקען דעם טאָל שִטים.<verse eid="JOL 4:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" pubnumber="3.19" sid="JOL 4:19" /> מִצרַיִם װעט אַ װיסטעניש װערן,</para>
  <para style="q" vid="JOL 4:19">און אֶדוֹם װעט אַ װיסטער מדבר װערן,</para>
  <para style="q" vid="JOL 4:19">פֿאַר דעם אומרעכט צו די קינדער פֿון יהוּדה,</para>
  <para style="q" vid="JOL 4:19">װאָס זײ האָבן פֿאַרגאָסן אומשולדיק בלוט אין זײער לאַנד.<verse eid="JOL 4:19" /></para>
  <para style="q">
    <verse number="20" style="v" pubnumber="3.20" sid="JOL 4:20" /> אָבער יהוּדה װעט זײַן אײביק באַזעצט,</para>
  <para style="q" vid="JOL 4:20">און ירושָלַיִם אױף דור-דורות.<verse eid="JOL 4:20" /></para>
  <para style="q">
    <verse number="21" style="v" pubnumber="3.21" sid="JOL 4:21" /> װאָרעם איך װעל רײניק זײער בלוט,</para>
  <para style="q2" vid="JOL 4:21">װאָס איך האָב נאָך נישט גערײניקן,</para>
  <para style="q1" vid="JOL 4:21">און ה׳ װעט װױנען אין צִיוֹן.<verse eid="JOL 4:21" /></para>
  <chapter eid="JOL 4" />
</usx>