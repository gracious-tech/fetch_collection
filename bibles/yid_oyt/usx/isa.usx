<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ISA" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">יְשַעְיָה</para>
  <para style="toc2">יְשַעְיָה</para>
  <para style="toc1">יְשַעְיָה</para>
  <para style="mt1">יְשַעְיָה</para>
  <chapter number="1" style="c" pubnumber="א" sid="ISA 1" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1" />די זעונג פֿון ישַעיָהו דעם זון פֿון אָמוצן, װאָס ער האָט געזען אױף יהוּדה און ירושָלַיִם, אין די טעג פֿון עוּזִיָהו, יוֹתָם, אָחָז, יחִזקִיָהו, די מלכים פֿון יהוּדה.<verse eid="ISA 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 1:2" />הערט איר הימלען, און פֿאַרנעם דו ערד,</para>
  <para style="q" vid="ISA 1:2">װאָרעם ה׳ האָט גערעדט:</para>
  <para style="q" vid="ISA 1:2">קינדער האָב איך דערצױגן און אױפֿגעבראַכט,</para>
  <para style="q" vid="ISA 1:2">און זײ האָבן געבראָכן אָן מיר.<verse eid="ISA 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 1:3" />אַן אָקס װײס זײַן בַעַל־הבית,</para>
  <para style="q" vid="ISA 1:3">און אַן אײזל די קאָריטע פֿון זײַן האַר;</para>
  <para style="q" vid="ISA 1:3">יִשׂרָאֵל װײס נישט,</para>
  <para style="q" vid="ISA 1:3">מײַן פֿאָלק קוקט זיך נישט אום.<verse eid="ISA 1:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 1:4" />װײ, זינדיקע אומה,</para>
  <para style="q" vid="ISA 1:4">פֿאָלק מיט פֿאַרברעכן באַשװערט,</para>
  <para style="q" vid="ISA 1:4">זאָמען פֿון שלעכטסטוער, קינדער פֿאַרדאָרבענע!</para>
  <para style="q" vid="ISA 1:4">פֿאַרלאָזט האָבן זײ ה׳,</para>
  <para style="q" vid="ISA 1:4">געלעסטערט דעם הײליקן פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="ISA 1:4">אַהינטער זיך אָפּגעקערט.<verse eid="ISA 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 1:5" />װוּ נאָך װילט איר געשלאָגן װערן,</para>
  <para style="q" vid="ISA 1:5">װאָס איר קערט אײַך נאָך מער אָפּ?</para>
  <para style="q" vid="ISA 1:5">דער גאַנצער קאָפּ איז קראַנק,</para>
  <para style="q" vid="ISA 1:5">און דאָס גאַנצע האַרץ איז אין װײטאָג;<verse eid="ISA 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 1:6" />פֿון פֿוסטריט ביזן קאָפּ</para>
  <para style="q" vid="ISA 1:6">איז אין אים קײן גאַנץ גליד נישטאָ,</para>
  <para style="q" vid="ISA 1:6">נאָר אַ ריס און אַ בײל און אַן אײַטעריק װוּנד;</para>
  <para style="q" vid="ISA 1:6">נישט אױסגעדריקט זײַנען זײ געװאָרן,</para>
  <para style="q" vid="ISA 1:6">און נישט פֿאַרבונדן, און נישט מיט אײל דערװײכט.<verse eid="ISA 1:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 1:7" />אײַער לאַנד איז אַ װיסטעניש,</para>
  <para style="q" vid="ISA 1:7">אײַערע שטעט זײַנען אין פֿײַער פֿאַרברענט;</para>
  <para style="q" vid="ISA 1:7">אײַער ערד – פֿרעמדע פֿאַרצערן זי אײַך אַנטקעגן,</para>
  <para style="q" vid="ISA 1:7">און װיסט איז זי װי דער איבערקער פֿון אַ פֿלײצונג.<verse eid="ISA 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 1:8" />און געבליבן איז טאָכטער צִיוֹן,</para>
  <para style="q" vid="ISA 1:8">װי אַ בײַדל אין אַ װײַנגאָרטן,</para>
  <para style="q" vid="ISA 1:8">װי אַ נאַכטלעג אין אַ פּלוצערפֿעלד,</para>
  <para style="q" vid="ISA 1:8">װי אַ װאַכבוד פֿון ריטלעך.<verse eid="ISA 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 1:9" />װען נישט ה׳ צבָֿאוֹת</para>
  <para style="q" vid="ISA 1:9">װאָלט אונדז אַ קלײן איבערבלײַב געלאָזט,</para>
  <para style="q" vid="ISA 1:9">װאָלטן מיר װי סדוֹם געװאָרן,</para>
  <para style="q" vid="ISA 1:9">צו עַמוֹרָה װאָלטן מיר געװען געגליכן.<verse eid="ISA 1:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 1:10" />הערט דאָס װאָרט פֿון ה׳,</para>
  <para style="q" vid="ISA 1:10">איר האַרן פֿון סדוֹם;</para>
  <para style="q" vid="ISA 1:10">פֿאַרנעמט די תּורה פֿון אלוקינו,</para>
  <para style="q" vid="ISA 1:10">איר פֿאָלק פֿון עַמוֹרָה.<verse eid="ISA 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 1:11" />צו װאָס מיר</para>
  <para style="q" vid="ISA 1:11">אײַערע פֿיל שלאַכטאָפּפֿער? זאָגט ה׳,</para>
  <para style="q" vid="ISA 1:11">איך בין זאַט מיט בראַנדאָפּפֿער פֿון װידערס,</para>
  <para style="q" vid="ISA 1:11">און מיט פֿעטס פֿון געשטאָפּטע;</para>
  <para style="q" vid="ISA 1:11">און בלוט פֿון אָקסן און שעפּסן און בעק</para>
  <para style="q" vid="ISA 1:11">װיל איך נישט פֿאַרלאַנגען.<verse eid="ISA 1:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 1:12" />אַז איר קומט זיך װײַזן פֿאַר מיר,</para>
  <para style="q" vid="ISA 1:12">װער בעט דאָס פֿון אײַך מײַנע הױפֿן צו טרעטן?<verse eid="ISA 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 1:13" />נישט ברענגט מער קָרְבֳנוֹת אומזיסט,</para>
  <para style="q" vid="ISA 1:13">אַן אומװערדיקע דעמפֿונג איז דאָס מיר;</para>
  <para style="q" vid="ISA 1:13">ראָש-חודש און שבת, רופֿן אַ פֿאַרזאַמלונגע –</para>
  <para style="q" vid="ISA 1:13">אומרעכט מיט אײַנזאַמלונג קען איך נישט לײַדן;<verse eid="ISA 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 1:14" />אײַערע ראָש-חודשן און אײַערע יוֹם-טובֿים</para>
  <para style="q" vid="ISA 1:14">האָט פֿײַנט מײַן זעל;</para>
  <para style="q" vid="ISA 1:14">זײ זײַנען מיר צו לאַסט געװאָרן,</para>
  <para style="q" vid="ISA 1:14">איך קען זײ נישט פֿאַרטראָגן.<verse eid="ISA 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 1:15" />און אַז איר שפּרײט אױס אײַערע הענט,</para>
  <para style="q" vid="ISA 1:15">װעל איך פֿאַרהױלן מײַנע אױגן פֿון אײַך;</para>
  <para style="q" vid="ISA 1:15">און פֿיל איר זאָלט נישט תּפֿילה טאָן,</para>
  <para style="q" vid="ISA 1:15">הער איך נישט צו;</para>
  <para style="q" vid="ISA 1:15">אײַערע הענט זײַנען פֿול מיט בלוט.<verse eid="ISA 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 1:16" />װאַשט אײַך, רײניקט אײַך,</para>
  <para style="q" vid="ISA 1:16">טוט אָפּ אײַערע שלעכטע מעשׂים</para>
  <para style="q" vid="ISA 1:16">פֿון קעגן מײַנע אױגן,</para>
  <para style="q" vid="ISA 1:16">הערט אױף שלעכטס טאָן;<verse eid="ISA 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 1:17" />לערנט גוטס טאָן,</para>
  <para style="q" vid="ISA 1:17">זוכט גערעכטיקײט,</para>
  <para style="q" vid="ISA 1:17">שטאַרקט דעם געדריקטן,</para>
  <para style="q" vid="ISA 1:17">טוט רעכט דעם יתום,</para>
  <para style="q" vid="ISA 1:17">נעמט זיך אָן פֿאַר דער אַלמנה.<verse eid="ISA 1:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 1:18" />קומט נאָר, און לאָמיר זיך דורכרעדן,</para>
  <para style="q" vid="ISA 1:18">זאָגט ה׳:</para>
  <para style="q" vid="ISA 1:18">אױב אײַערע זינד װעלן װי קאַרמין זײַן,</para>
  <para style="q" vid="ISA 1:18">װעלן זײ װײַס װי שנײ װערן;</para>
  <para style="q" vid="ISA 1:18">אױב זײ װעלן רױט זײַן װי װערמילפֿאַרב,</para>
  <para style="q" vid="ISA 1:18">װעלן זײ װי װאָל װערן.<verse eid="ISA 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 1:19" />אױב איר װעט װעלן און װעט צוהערן,</para>
  <para style="q" vid="ISA 1:19">װעט איר עסן דאָס גוטס פֿונעם לאַנד;<verse eid="ISA 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 1:20" />אָבער אַז איר װעט נישט װעלן, און װעט װידערשפּעניקן,</para>
  <para style="q" vid="ISA 1:20">װעט איר פֿון דער שװערד געגעסן װערן;</para>
  <para style="q" vid="ISA 1:20">װאָרעם דאָס מױל פֿון ה׳ האָט גערעדט.<verse eid="ISA 1:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 1:21" />װי איז אַ זוֹנה געװאָרן די געטרײַע שטאָט!</para>
  <para style="q" vid="ISA 1:21">געװען פֿול מיט גערעכטיקײט,</para>
  <para style="q" vid="ISA 1:21">רעכטפֿאַרטיקײט פֿלעגט רוען אין איר,</para>
  <para style="q" vid="ISA 1:21">און אַצונדערטאָ – מערדערס.<verse eid="ISA 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 1:22" />דײַן זילבער איז פּסולת געװאָרן,</para>
  <para style="q" vid="ISA 1:22">דײַן טראַנק איז מיט װאַסער געמישט.<verse eid="ISA 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 1:23" />דײַנע האַרן זײַנען אָפּקערערס,</para>
  <para style="q" vid="ISA 1:23">און חבֿרים פֿון גנבֿים;</para>
  <para style="q" vid="ISA 1:23">איטלעכער האָט ליב שוחד,</para>
  <para style="q" vid="ISA 1:23">און יאָגט זיך נאָך געצאָלט;</para>
  <para style="q" vid="ISA 1:23">דעם יתום טוען זײ נישט קײן רעכט,</para>
  <para style="q" vid="ISA 1:23">און דער שטרײַט פֿון דער אַלמנה גײט זײ נישט אָן.<verse eid="ISA 1:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 1:24" />דערום זאָגט דער האַר,</para>
  <para style="q" vid="ISA 1:24">ה׳ צבָֿאוֹת, דער מאַכטיקער פֿון יִשׂרָאֵל:</para>
  <para style="q" vid="ISA 1:24">אָ, איך װעל זיך שטילן אָן מײַנע פֿײַנט,</para>
  <para style="q" vid="ISA 1:24">און זיך נוקם זײַן אָן מײַנע שׂונאים.<verse eid="ISA 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 1:25" />און איך װעל קערן מײַן האַנט אױף דיר,</para>
  <para style="q" vid="ISA 1:25">און לײַטערן װי מיט לױג דײַנע פּסולת,</para>
  <para style="q" vid="ISA 1:25">און אָפּטאָן אַלע דײַנע בלײַען.<verse eid="ISA 1:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 1:26" />און איך װעל אומקערן דײַנע ריכטער װי צוערשט,</para>
  <para style="q" vid="ISA 1:26">און דײַנע יוֹעצים װי אין אָנהײב;</para>
  <para style="q" vid="ISA 1:26">דערנאָך װעט מען דיך רופֿן</para>
  <para style="q" vid="ISA 1:26">דער כּרך פֿון גערעכטיקײט, די געטרײַע שטאָט.<verse eid="ISA 1:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="ISA 1:27" />צִיוֹן װעט דורך גערעכטיקײט דערלײזט װערן,</para>
  <para style="q" vid="ISA 1:27">און אירע צוריקגעקערטע דורך רעכטפֿאַרטיקײט.<verse eid="ISA 1:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 1:28" />און אַ בראָך אױף די פֿאַרברעכער און זינדיקע אין אײנעם;</para>
  <para style="q" vid="ISA 1:28">און די װאָס פֿאַרלאָזן ה׳, װעלן פֿאַרלענדט װערן.<verse eid="ISA 1:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 1:29" />װאָרעם מע װעט צו שאַנד װערן</para>
  <para style="q" vid="ISA 1:29">פֿון די אײכנבײמער װאָס איר האָט געגלוסט,</para>
  <para style="q" vid="ISA 1:29">און איר װעט זיך שעמען</para>
  <para style="q" vid="ISA 1:29">מיט די גערטנער װאָס איר האָט אױסדערװײלט.<verse eid="ISA 1:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 1:30" />װאָרעם איר װעט זײַן װי אַ טערעבינט</para>
  <para style="q" vid="ISA 1:30">װאָס זײַן בלאַט װערט פֿאַרװעלקט,</para>
  <para style="q" vid="ISA 1:30">און װי אַ גאָרטן</para>
  <para style="q" vid="ISA 1:30">װאָס האָט נישט קײן װאַסער.<verse eid="ISA 1:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 1:31" />און דער שטאַרקער װעט װערן װי פֿלאַקסשטרױ,</para>
  <para style="q" vid="ISA 1:31">און זײַן װערק אַ פֿונק</para>
  <para style="q" vid="ISA 1:31">און בײדע אין אײנעם װעלן ברענען,</para>
  <para style="q" vid="ISA 1:31">און קײן לעשער װעט נישט זײַן.<verse eid="ISA 1:31" /></para>
  <chapter eid="ISA 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="ISA 2" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1" />דאָס װאָרט װאָס ישַעיָהו דער זון פֿון אָמוצן האָט געזען אױף יהוּדה און ירושָלַיִם.<verse eid="ISA 2:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 2:2" />און עס װעט זײַן אין סוף פֿון די טעג,</para>
  <para style="q" vid="ISA 2:2">װעט שטײן פֿעסט דער באַרג פֿון ה׳ס הױז</para>
  <para style="q" vid="ISA 2:2">אױבן אָן פֿון די בערג,</para>
  <para style="q" vid="ISA 2:2">און דערהױבן איבער די הײכן;</para>
  <para style="q" vid="ISA 2:2">און אַלע פֿעלקער װעלן צו אים שטראָמען.<verse eid="ISA 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 2:3" />און פֿיל אומות װעלן גײן און װעלן זאָגן:</para>
  <para style="q" vid="ISA 2:3">קומט, און לאָמיר אַרױפֿגײן צום באַרג פֿון ה׳,</para>
  <para style="q" vid="ISA 2:3">צום הױז פֿון דעם אלוקי יעקבֿ;</para>
  <para style="q" vid="ISA 2:3">און ער װעט אונדז לערנען פֿון זײַנע װעגן,</para>
  <para style="q" vid="ISA 2:3">און מיר װעלן גײן אין זײַנע שטעגן;</para>
  <para style="q" vid="ISA 2:3">װאָרעם פֿון צִיוֹן װעט אַרױסגײן אַ תּורה,</para>
  <para style="q" vid="ISA 2:3">און ה׳ס װאָרט פֿון ירושָלַיִם.<verse eid="ISA 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 2:4" />און ער װעט משפּטן צװישן די פֿעלקער,</para>
  <para style="q" vid="ISA 2:4">און אַנטשײדן איבער פֿיל אומות;</para>
  <para style="q" vid="ISA 2:4">און זײ װעלן שמידן זײערע שװערדן אױף אַקעראײַזנס,</para>
  <para style="q" vid="ISA 2:4">און זײערע שפּיזן אױף צװײַגמעסערס;</para>
  <para style="q" vid="ISA 2:4">אַ פֿאָלק קעגן אַ פֿאָלק װעט נישט הײבן אַ שװערד,</para>
  <para style="q" vid="ISA 2:4">און מע װעט נישט מער לערנען מלחמה.<verse eid="ISA 2:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 2:5" />הױז פֿון יעקבֿ, קומט, און לאָמיר גײן</para>
  <para style="q" vid="ISA 2:5">אין דעם ליכט פֿון ה׳.<verse eid="ISA 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 2:6" />װאָרעם האָסט פֿאַרלאָזט דײַן פֿאָלק, דאָס הױז פֿון יעקבֿ,</para>
  <para style="q" vid="ISA 2:6">װײַל זײ זײַנען פֿול מיט כּישוף פֿון מזרח,</para>
  <para style="q" vid="ISA 2:6">און מיט װאָרזאָגער אַזױ װי די פּלִשתּים,</para>
  <para style="q" vid="ISA 2:6">און מיט פֿרעמדגעבאָרענע זאַכן גיבן זײ זיך אָפּ.<verse eid="ISA 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 2:7" />און אָנגעפֿילט געװאָרן איז זײַן לאַנד מיט זילבער און גאָלד,</para>
  <para style="q" vid="ISA 2:7">און נישטאָ קײן שיעור צו זײַנע אוֹצרות;</para>
  <para style="q" vid="ISA 2:7">און אָנגעפֿילט געװאָרן איז זײַן לאַנד מיט פֿערד,</para>
  <para style="q" vid="ISA 2:7">און נישטאָ קײן שיעור צו זײַנע רײַטװעגן.<verse eid="ISA 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 2:8" />און אָנגעפֿילט געװאָרן איז זײַן לאַנד מיט אָפּגעטער;</para>
  <para style="q" vid="ISA 2:8">צום װערק פֿון זײערע הענט טוען זײ זיך בוקן,</para>
  <para style="q" vid="ISA 2:8">צו װאָס זײערע פֿינגער האָבן געמאַכט.<verse eid="ISA 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 2:9" />און געבױגן איז דער מענטש,</para>
  <para style="q" vid="ISA 2:9">און נידעריק איז דער מאַן,</para>
  <para style="q" vid="ISA 2:9">און דו קענסט זײ נישט פֿאַרגעבן.<verse eid="ISA 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 2:10" />גײ אַרײַן אין פֿעלדז,</para>
  <para style="q" vid="ISA 2:10">און באַהאַלט זיך אין שטױב,</para>
  <para style="q" vid="ISA 2:10">פֿאַר דער פֿאָרכטיקײט פֿון ה׳,</para>
  <para style="q" vid="ISA 2:10">און פֿאַר דער פּראַכט פֿון זײַן גרױסקײט.<verse eid="ISA 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 2:11" />די האָפֿערדיקע אױגן פֿון מענטשן װערן דערנידערט,</para>
  <para style="q" vid="ISA 2:11">און די הױכקײט פֿון לײַט װעט געבױגן װערן,</para>
  <para style="q" vid="ISA 2:11">און ה׳ אַלײן װעט זײַן דערהױבן אין יענעם טאָג.<verse eid="ISA 2:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 2:12" />װאָרעם אַ טאָג איז דאָ בײַ ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ISA 2:12">אױף אַלעם שטאָלצן און הױכן,</para>
  <para style="q" vid="ISA 2:12">און אױף אַלעם דערהױבענעם,</para>
  <para style="q" vid="ISA 2:12">עס זאָל דערנידערט װערן;<verse eid="ISA 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 2:13" />און אױף אַלע צעדערן פֿון לבֿנוֹן,</para>
  <para style="q" vid="ISA 2:13">די הױכע און דערהױבענע,</para>
  <para style="q" vid="ISA 2:13">און אױף אַלע אײכנבײמער פֿון בָשָן;<verse eid="ISA 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 2:14" />און אױף אַלע הױכע בערג,</para>
  <para style="q" vid="ISA 2:14">און אױף אַלע דערהױבענע הײכן;<verse eid="ISA 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 2:15" />און אױף יעטװעדער הױכן טורעם,</para>
  <para style="q" vid="ISA 2:15">און אױף יעטװעדער באַפֿעסטיקטער מױער;<verse eid="ISA 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 2:16" />און אױף אַלע שיפֿן פֿון תַּרְשִיש,</para>
  <para style="q" vid="ISA 2:16">און אױף אַלע גלוסטיקע שיפֿן.<verse eid="ISA 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 2:17" />און די האָפֿערדיקײט פֿון מענטשן װעט געבױגן װערן,</para>
  <para style="q" vid="ISA 2:17">און די הױכקײט פֿון לײַט װעט דערנידערט װערן,</para>
  <para style="q" vid="ISA 2:17">און ה׳ אַלײן װעט זײַן דערהױבן אין יענעם טאָג.<verse eid="ISA 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 2:18" />און די אָפּגעטער װעלן אין גאַנצן פֿאַרגײן.<verse eid="ISA 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 2:19" />און מע װעט אַרײַנגײן אין הײלן פֿון פֿעלדזן,</para>
  <para style="q" vid="ISA 2:19">און אין לעכער פֿון דער ערד,</para>
  <para style="q" vid="ISA 2:19">פֿאַר דער פֿאָרכטיקײט פֿון ה׳,</para>
  <para style="q" vid="ISA 2:19">און פֿאַר דער פּראַכט פֿון זײַן גרױסקײט,</para>
  <para style="q" vid="ISA 2:19">װען ער שטײט אױף די ערד אױפֿצוטרײסלען.<verse eid="ISA 2:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 2:20" />אין יענעם טאָג װעט אַװעקװאַרפֿן דער מענטש</para>
  <para style="q" vid="ISA 2:20">זײַנע אָפּגעטער פֿון זילבער, און זײַנע אָפּגעטער פֿון גאָלד,</para>
  <para style="q" vid="ISA 2:20">װאָס זײ האָבן זיך געמאַכט, זיך צו בוקן,</para>
  <para style="q" vid="ISA 2:20">פֿאַר די קראָטן און פֿאַר די פֿלעדערמײַז;<verse eid="ISA 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 2:21" />כּדי אַרײַנצוגײן אין לעכער פֿון פֿעלדזן,</para>
  <para style="q" vid="ISA 2:21">און אין שפּאַלטן פֿון שטײנער,</para>
  <para style="q" vid="ISA 2:21">פֿאַר דער פֿאָרכטיקײט פֿון ה׳,</para>
  <para style="q" vid="ISA 2:21">און פֿאַר דער פּראַכט פֿון זײַן גרױסקײט,</para>
  <para style="q" vid="ISA 2:21">װען ער שטײט אױף די ערד אױפֿצוטרײסלען.<verse eid="ISA 2:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 2:22" />פֿאַרמײַדט אײַך פֿונעם מענטשן װאָס אַ אָטעם איז אין זײַן נאָז,</para>
  <para style="q" vid="ISA 2:22">װאָרעם װאָס איז ער גערעכנט?<verse eid="ISA 2:22" /></para>
  <chapter eid="ISA 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="ISA 3" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 3:1" />װאָרעם זע, דער האַר, ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ISA 3:1">טוט אָפּ פֿון ירושָלַיִם און פֿון יהוּדה</para>
  <para style="q" vid="ISA 3:1">אַן אונטערלען און אַן אָנלען;</para>
  <para style="q" vid="ISA 3:1">יעטװעדער אונטערלען פֿון ברױט,</para>
  <para style="q" vid="ISA 3:1">און יעטװעדער אונטערלען פֿון װאַסער.<verse eid="ISA 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 3:2" />דעם גיבור און דעם מאַן פֿון מלחמה,</para>
  <para style="q" vid="ISA 3:2">דעם ריכטער און דעם נבֿיא,</para>
  <para style="q" vid="ISA 3:2">און דעם װאָרזאָגער און דעם עלטסטן;<verse eid="ISA 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 3:3" />דעם הױפּטמאַן פֿון פֿופֿציק,</para>
  <para style="q" vid="ISA 3:3">און דעם אָנגעזעענעם און דעם בַעַל-יוֹעץ,</para>
  <para style="q" vid="ISA 3:3">און דעם קלוגן צױבערער,</para>
  <para style="q" vid="ISA 3:3">און דעם שפּרוכקענער.<verse eid="ISA 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 3:4" />און איך װעל מאַכן ייִנגלעך פֿאַר זײערע האַרן,</para>
  <para style="q" vid="ISA 3:4">און קינדער װעלן געװעלטיקן איבער זײ.<verse eid="ISA 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 3:5" />און דאָס פֿאָלק װעט זיך דריקן,</para>
  <para style="q" vid="ISA 3:5">אײנער דעם אַנדערן,</para>
  <para style="q" vid="ISA 3:5">און איטלעכער זײַן חבֿר;</para>
  <para style="q" vid="ISA 3:5">אַ ייִנגל װעט זיך גרײסן קעגן זקן,</para>
  <para style="q" vid="ISA 3:5">און דער ניבֿזה קעגן נִכבד.<verse eid="ISA 3:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 3:6" />אַז עמעצער װעט אָנכאַפּן</para>
  <para style="q" vid="ISA 3:6">זײַן ברודער פֿון זײַן פֿאָטערס הױז:</para>
  <para style="q" vid="ISA 3:6">אַ בגד האָסטו, אַ האַר זאָלסטו אונדז זײַן,</para>
  <para style="q" vid="ISA 3:6">און די דאָזיקע שטרױכלעניש זאָל זײַן אונטער דײַן האַנט,<verse eid="ISA 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 3:7" />װעט ער שװערן אין יענעם טאָג, אַזױ צו זאָגן:</para>
  <para style="q" vid="ISA 3:7">איך װעל נישט זײַן קײן הײלער,</para>
  <para style="q" vid="ISA 3:7">אַז אין מײַן הױז איז נישטאָ קײן ברױט און קײן בגד;</para>
  <para style="q" vid="ISA 3:7">איר װעט מיך נישט מאַכן פֿאַרן האַר פֿון פֿאָלק.<verse eid="ISA 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 3:8" />װאָרעם געשטרױכלט איז ירושָלַיִם,</para>
  <para style="q" vid="ISA 3:8">און יהוּדה איז געפֿאַלן;</para>
  <para style="q" vid="ISA 3:8">װײַל זײער צונג און זײערע מעשׂים זײַנען קעגן ה׳,</para>
  <para style="q" vid="ISA 3:8">צו װידערשפּעניקן די אױגן פֿון זײַן כּבֿוד.<verse eid="ISA 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 3:9" />דער אָנבליק פֿון זײער פּנים זאָגט עדות אױף זײ;</para>
  <para style="q" vid="ISA 3:9">און זײער זינד זאָגן זײ אױס װי סדוֹם, זײ פֿאַרלײקענען נישט.</para>
  <para style="q" vid="ISA 3:9">װײ צו זײער זעל,</para>
  <para style="q" vid="ISA 3:9">װאָס זײ האָבן זיך אַלײן בײז געטאָן.<verse eid="ISA 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 3:10" />זאָגט דעם גערעכטן אַז אים װעט זײַן גוט,</para>
  <para style="q" vid="ISA 3:10">װײַל די פֿרוכט פֿון זײערע מעשׂים װעלן זײ עסן.<verse eid="ISA 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 3:11" />װײ צו דעם רשע, אים װעט זײַן שלעכט,</para>
  <para style="q" vid="ISA 3:11">װאָרעם די טוּונג פֿון זײַנע הענט װעט אים געשען.<verse eid="ISA 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 3:12" />מײַן פֿאָלק – זײַנע באַצװינגער זײַנען קינדער,</para>
  <para style="q" vid="ISA 3:12">און װײַבער געװעלטיקן איבער אים.</para>
  <para style="q" vid="ISA 3:12">מײַן פֿאָלק! דײַנע האַרן זײַנען פֿאַרפֿירער,</para>
  <para style="q" vid="ISA 3:12">און דעם װעג פֿון דײַנע שטעגן האָבן זײ צעמישט.<verse eid="ISA 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 3:13" />ה׳ שטײט אױף זיך צו קריגן,</para>
  <para style="q" vid="ISA 3:13">און ער שטעלט זיך צו משפּטן די פֿעלקער.<verse eid="ISA 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 3:14" />ה׳ װעט גײן אין אַ משפּט</para>
  <para style="q" vid="ISA 3:14">מיט די עלטסטע פֿון זײַן פֿאָלק און זײַנע האַרן:</para>
  <para style="q" vid="ISA 3:14">דאָס האָט איר אָפּגעגעסן דעם װײַנגאָרטן,</para>
  <para style="q" vid="ISA 3:14">די גזלה פֿון אָרעמאַן איז אין אײַערע הײַזער.<verse eid="ISA 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 3:15" />װאָס מײנט איר, װאָס איר צעדריקט מײַן פֿאָלק,</para>
  <para style="q" vid="ISA 3:15">און דעם פּנים פֿון די אָרימע צעמאָלט איר?</para>
  <para style="q" vid="ISA 3:15">זאָגט דער אֲדֹנָי, ה׳ צבָֿאוֹת.<verse eid="ISA 3:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 3:16" />און ה׳ האָט געזאָגט:</para>
  <para style="q" vid="ISA 3:16">װײַל די טעכטער פֿון צִיוֹן זײַנען האָפֿערדיק,</para>
  <para style="q" vid="ISA 3:16">און גײען פֿאַרריסן דעם האַלדז,</para>
  <para style="q" vid="ISA 3:16">און װינקענדיק מיט די אױגן;</para>
  <para style="q" vid="ISA 3:16">גײען שװעבנדיק גײען זײ,</para>
  <para style="q" vid="ISA 3:16">און מיט זײערע פֿוסרינגען קלינגען זײ;<verse eid="ISA 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 3:17" />דערום װעט אֲדֹנָי קרעציק מאַכן</para>
  <para style="q" vid="ISA 3:17">דעם קאָפּ פֿון די טעכטער פֿון צִיוֹן,</para>
  <para style="q" vid="ISA 3:17">און ה׳ װעט זײער שאַנד אַנטפּלעקן.<verse eid="ISA 3:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="ISA 3:18" />אין יענעם טאָג װעט אֲדֹנָי אָפּטאָן די שײנקײט פֿון די פֿוסרינגען, און די שטערנבענדער, און די לבֿנהלעך; <verse eid="ISA 3:18" /><verse number="19" style="v" sid="ISA 3:19" />די באָמבערלעך, און די אָרעמבענדער, און די שלײערס; <verse eid="ISA 3:19" /><verse number="20" style="v" sid="ISA 3:20" />די קאָפּטיכער, און די טריטקײטלעך, און די גאַרטלען, און די לײַבלעך, און די קמיעות; <verse eid="ISA 3:20" /><verse number="21" style="v" sid="ISA 3:21" />די פֿינגערלעך, און די נאָזרינגען; <verse eid="ISA 3:21" /><verse number="22" style="v" sid="ISA 3:22" />די פֿאַרטיכטער, און די מאַנטלען, און די איבערדעקן, און די בײַטלען; <verse eid="ISA 3:22" /><verse number="23" style="v" sid="ISA 3:23" />די טולן, און די לײַנענע טיכער, און די הױבן, און די דעקטיכער.<verse eid="ISA 3:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 3:24" />און עס װעט זײַן,</para>
  <para style="q" vid="ISA 3:24">אַנשטאָט בשׂמים װעט זײַן צעפֿױלטקײט,</para>
  <para style="q" vid="ISA 3:24">און אַנשטאָט אַ גאַרטל, אַ שטריק,</para>
  <para style="q" vid="ISA 3:24">און אַנשטאָט קרױזן, אַ פּליך,</para>
  <para style="q" vid="ISA 3:24">און אַנשטאָט אַ ברוסטטוך, אַ זאַקגורט;</para>
  <para style="q" vid="ISA 3:24">אַ בראַנד אַנשטאָט שײנקײט.<verse eid="ISA 3:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 3:25" />דײַנע מענער װעלן דורכן שװערד פֿאַלן,</para>
  <para style="q" vid="ISA 3:25">און דײַנע גיבוֹרים אין מלחמה.<verse eid="ISA 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 3:26" />און קלאָגן און טרױערן װעלן אירע טױערן,</para>
  <para style="q" vid="ISA 3:26">און אױסגעלײדיקט װעט זי װערן,</para>
  <para style="q" vid="ISA 3:26">אױף דער ערד װעט זי זיצן.<verse eid="ISA 3:26" /></para>
  <chapter eid="ISA 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="ISA 4" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 4:1" />און זיבן װײַבער װעלן אָנהאַלטן אײן מאַן אין יענעם טאָג, אַזױ צו זאָגן: אונדזער ברױט װעלן מיר עסן, און אונדזער קלײד װעלן מיר אָנטאָן, נאָר דײַן נאָמען זאָל גערופֿן װערן אױף אונדז; טו אָפּ אונדזער שאַנד.<verse eid="ISA 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 4:2" />אין יענעם טאָג װעט די צמח פֿון ה׳ זײַן פֿאַר אַ שײנקײט און פֿאַר אַ כּבֿוד, און די פֿרוכט פֿון לאַנד פֿאַר אַ שטאָלץ און פֿאַר אַ צירונג, פֿאַר די אַנטרונענע פֿון יִשׂרָאֵל. <verse eid="ISA 4:2" /><verse number="3" style="v" sid="ISA 4:3" />און עס װעט זײַן, דער װאָס איז געבליבן אין צִיוֹן, און דער װאָס האָט זיך אָפּגעשטעלט אין ירושָלַיִם, װעט הײליקער געזאָגט װערן צו אים – איטלעכער װאָס איז פֿאַרשריבן צום לעבן אין ירושָלַיִם; <verse eid="ISA 4:3" /><verse number="4" style="v" sid="ISA 4:4" />װען אֲדֹנָי האָט אָפּגעװאַשן דעם קױט פֿון די טעכטער פֿון צִיוֹן, און דאָס בלוט פֿון ירושָלַיִם שװענקט ער אָפּ פֿון איר מיט, מיט אַ גײַסט פֿון גערעכטיקײט, און מיט אַ גײַסט פֿון פֿאַרברענונג. <verse eid="ISA 4:4" /><verse number="5" style="v" sid="ISA 4:5" />און ה׳ װעט באַשאַפֿן אױפֿן גאַנצן פּלאַץ פֿון באַרג צִיוֹן, און אױף אירע זאַמלערטער, אַ װאָלקן און רױך בײַ טאָג, און אַ שײַן פֿון פֿלאַמפֿײַער בײַ נאַכט; װאָרעם, איבער אַל דער פּראַכטיקײט װעט זײַן אַ חופּה. <verse eid="ISA 4:5" /><verse number="6" style="v" sid="ISA 4:6" />און אַן איבערדעק װעט זײַן פֿאַר אַ שאָטן פֿון היץ בײַ טאָג, און פֿאַר אַ באַשיצונג און פֿאַר אַ פֿאַרבאָרגעניש פֿון גוס און פֿון רעגן.<verse eid="ISA 4:6" /></para>
  <chapter eid="ISA 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="ISA 5" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 5:1" />לאָמיך זינגען פֿון מײַן ליבן פֿרײַנט,</para>
  <para style="q" vid="ISA 5:1">דאָס געזאַנג פֿון מײַן באַליבטן אױף זײַן װײַנגאָרטן.</para>
  <para style="q" vid="ISA 5:1">אַ װײַנגאָרטן האָט מײַן ליבער פֿרײַנט געהאַט,</para>
  <para style="q" vid="ISA 5:1">אױף אַ בערגל אַ פֿעטן.<verse eid="ISA 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 5:2" />און ער האָט אים צעגראָבן און אים אױסגעשטײנט,</para>
  <para style="q" vid="ISA 5:2">און אים באַפֿלאַנצט מיט טײַערן װײַנשטאָק,</para>
  <para style="q" vid="ISA 5:2">און אױסגעבױט אַ טורעם אין אים,</para>
  <para style="q" vid="ISA 5:2">און אױך אַ קעלטער אױסגעהאַקט דערין;</para>
  <para style="q" vid="ISA 5:2">און ער האָט געהאָפֿט ער זאָל װײַנטרױבן ברענגען,</para>
  <para style="q" vid="ISA 5:2">און ער האָט װילדטרױבן געבראַכט.<verse eid="ISA 5:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 5:3" />און אַצונד, איר באַװױנער פֿון ירושָלַיִם,</para>
  <para style="q" vid="ISA 5:3">און מענער פֿון יהוּדה,</para>
  <para style="q" vid="ISA 5:3">משפּט, איך בעט אײַך, צװישן מיר און צװישן מײַן װײַנגאָרטן.<verse eid="ISA 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 5:4" />װאָס נאָך איז געװען צו טאָן פֿאַר מײַן װײַנגאָרטן,</para>
  <para style="q" vid="ISA 5:4">װאָס איך האָב אין אים נישט געטאָן?</para>
  <para style="q" vid="ISA 5:4">פֿאַר װאָס, אַז איך האָב געהאָפֿט ער זאָל װײַנטרױבן ברענגען,</para>
  <para style="q" vid="ISA 5:4">האָט ער װילדטרױבן געבראַכט?<verse eid="ISA 5:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 5:5" />און אַצונד, לאָמיך אײַך לאָזן װיסן,</para>
  <para style="q" vid="ISA 5:5">װאָס איך װעל טאָן צו מײַן װײַנגאָרטן:</para>
  <para style="q" vid="ISA 5:5">אָפּטאָן זײַן צאַם,</para>
  <para style="q" vid="ISA 5:5">און ער זאָל אָפּגעגעסן װערן;</para>
  <para style="q" vid="ISA 5:5">צעברעכן זײַן פּלױט,</para>
  <para style="q" vid="ISA 5:5">און ער זאָל צעטרעטן װערן.<verse eid="ISA 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 5:6" />און איך װעל אים מאַכן אַ װיסטעניש;</para>
  <para style="q" vid="ISA 5:6">נישט באַשניטן און נישט אַרומגעגראָבן װעט ער װערן,</para>
  <para style="q" vid="ISA 5:6">און ער װעט פֿאַרװאַקסן מיט דערנער און װילדגעװעקס,</para>
  <para style="q" vid="ISA 5:6">און אױך די װאָלקנס װעל איך באַפֿעלן,</para>
  <para style="q" vid="ISA 5:6">נישט צו רעגענען אױף אים קײן רעגן.<verse eid="ISA 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 5:7" />װאָרעם דער װײַנגאָרטן פֿון ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ISA 5:7">איז דאָס הױז פֿון יִשׂרָאֵל;</para>
  <para style="q" vid="ISA 5:7">און די מענער פֿון יהוּדה,</para>
  <para style="q" vid="ISA 5:7">זײַן געצערטלטע פֿלאַנצונג;</para>
  <para style="q" vid="ISA 5:7">און ער האָט געהאָפֿט אױף גערעכטיקײט,</para>
  <para style="q" vid="ISA 5:7">ערשט עס איז שלעכטיקײט,</para>
  <para style="q" vid="ISA 5:7">אױף צידקות, ערשט עס איז אַ יאָמערײַ.<verse eid="ISA 5:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 5:8" />װײ, די װאָס רוקן אַ הױז צו אַ הױז,</para>
  <para style="q" vid="ISA 5:8">גענענען אַ פֿעלד צו אַ פֿעלד, ביז נישטאָ מער קײן אָרט,</para>
  <para style="q" vid="ISA 5:8">און איר אַלײן בלײַבט זיצן אין לאַנד!<verse eid="ISA 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 5:9" />אין מײַנע אױערן ה׳ צבָֿאוֹת:</para>
  <para style="q" vid="ISA 5:9">אױב פֿיל הײַזער װיסט װערן,</para>
  <para style="q" vid="ISA 5:9">גרױסע און שײנע, אָן אַ באַװױנער!<verse eid="ISA 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 5:10" />װאָרעם צען אַקער װײַנגאָרטן װעלן ברענגען אײן בַת,</para>
  <para style="q" vid="ISA 5:10">און אַ חוֹמֶר זאָמען װעט ברענגען אַן אֵיפֿה.<verse eid="ISA 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 5:11" />װײ, די װאָס פֿעדערן זיך אין דער פֿרי,</para>
  <para style="q" vid="ISA 5:11">דעם טרונק נאָכצױאָגן, די װאָס שפּעטיקן זיך בײַ נאַכט,</para>
  <para style="q" vid="ISA 5:11">ביז דער װײַן צינדט זײ אָן!<verse eid="ISA 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 5:12" />און מיט האַרף און גיטאַר, מיט פּױק און פֿלײט,</para>
  <para style="q" vid="ISA 5:12">און מיט װײַן, איז זײער מאָלצײַט;</para>
  <para style="q" vid="ISA 5:12">און דאָס װערק פֿון ה׳ קוקן זײ נישט אָן,</para>
  <para style="q" vid="ISA 5:12">און די טואונג פֿון זײַנע הענט זעען זײ נישט.<verse eid="ISA 5:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 5:13" />דערום גײט אין גלות מײַן פֿאָלק,</para>
  <para style="q" vid="ISA 5:13">פֿון נישט פֿאַרשטאַנדיקײט;</para>
  <para style="q" vid="ISA 5:13">און זײַנע נכבדים װערן הונגערלײט,</para>
  <para style="q" vid="ISA 5:13">און זײַן המון פֿון דאָרשט פֿאַרטריקנט.<verse eid="ISA 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 5:14" />דערום האָט די שְׁאֹול אױסגעברײט איר שלונד,</para>
  <para style="q" vid="ISA 5:14">און אױפֿגעשפּאַרט איר מױל אָן אַ מאָס:</para>
  <para style="q" vid="ISA 5:14">און נידערן װעט איר פּראַכט,</para>
  <para style="q" vid="ISA 5:14">און איר טומל און איר גערױש,</para>
  <para style="q" vid="ISA 5:14">און װוּ אַ לוּסטיקער אין איר.<verse eid="ISA 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 5:15" />און געבױגן װערט דער מענטש,</para>
  <para style="q" vid="ISA 5:15">און דערנידערט װערט דער מאַן,</para>
  <para style="q" vid="ISA 5:15">און די אױגן פֿון די הױכע װעלז דערנידערט װערן.<verse eid="ISA 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 5:16" />און ה׳ צבָֿאוֹת װערט דערהײכט דורך גערעכטיקײט,</para>
  <para style="q" vid="ISA 5:16">און הָאֵל דער הײליקער װערט געהײליקט דורך רעכטפֿאַרתיקײט.<verse eid="ISA 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 5:17" />און די שאָף װעלן זיך פּאַשען װי אױף זײער פֿיטערפּלאַץ,</para>
  <para style="q" vid="ISA 5:17">און די חורבֿות פֿון די רײַכע װעלן פֿאַרצערט װערן פֿון װאַנדערער.<verse eid="ISA 5:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 5:18" />װײ, די װאָס שלעפּן דעם פֿאַרברעך מיט שנוּרן פֿון נישטיקײט,</para>
  <para style="q" vid="ISA 5:18">און װי מיט אַ װאָגנשטריק די זינד!<verse eid="ISA 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 5:19" />די װאָס זאָגן: זאָל ער אײַלן װאָס גיכער זײַן װערק,</para>
  <para style="q" vid="ISA 5:19">כּדי מיר זאָלן זען;</para>
  <para style="q" vid="ISA 5:19">און זאָל גענענען און קומען דער באַראָט פֿון דעם הײליקן פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="ISA 5:19">און לאָמיר געװױר װערן.<verse eid="ISA 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 5:20" />װײ, די װאָס זאָגן אױף שלעכטס גוּט,</para>
  <para style="q" vid="ISA 5:20">און אױף גוּט שלעכט;</para>
  <para style="q" vid="ISA 5:20">װאָס מאַכן פֿינצטערניש פֿאַר ליכטיקײט,</para>
  <para style="q" vid="ISA 5:20">און ליכטיקײט פֿאַר פֿינצטערניש;</para>
  <para style="q" vid="ISA 5:20">װאָס מאַכן ביטער פֿאַר זיס,</para>
  <para style="q" vid="ISA 5:20">און זיס פֿאַר ביטער!<verse eid="ISA 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 5:21" />װײ, די װאָס זײַנען חכמים אין זײערע אױגן,</para>
  <para style="q" vid="ISA 5:21">און פֿאַרשטאַנדיק אין זײער אָנגעזיכט!<verse eid="ISA 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 5:22" />װײ, די גיבוֹרים אױף טרינקען װײַן,</para>
  <para style="q" vid="ISA 5:22">און העלדישע לײַט אױף מישן דעם טרוּנק;<verse eid="ISA 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 5:23" />װאָס מאַכן גערעכט דעם שוּלדיקן אום שוחד,</para>
  <para style="q" vid="ISA 5:23">און דאָס רעכט פֿון גערעכטן נעמען זײ פֿון אים אַװעק!<verse eid="ISA 5:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 5:24" />דערום, אַזױ װי די צונג פֿון פֿײַער פֿאַרצערט שטרױ,</para>
  <para style="q" vid="ISA 5:24">און שפּרײ צעקריכט אין אַ פֿלאַם,</para>
  <para style="q" vid="ISA 5:24">אַזױ װעט זײער װאָרצל װי אַ צעפֿױלונג װערן,</para>
  <para style="q" vid="ISA 5:24">און זײער בליִונג װעט װי שטױב אױפֿגײן;</para>
  <para style="q" vid="ISA 5:24">װײַל זײ האָבן פֿאַראַכט די תּורה פֿון ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ISA 5:24">און געלעסטערט דאָס װאָרט פֿון דעם הײליקן פֿון יִשׂרָאֵל.<verse eid="ISA 5:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 5:25" />דערום האָט געגרימט דער צאָרן פֿון ה׳ אױף זײַן פֿאָלק,</para>
  <para style="q" vid="ISA 5:25">און ער האָט אױסגעשטרעקט זײַן האַנט אױף אים,</para>
  <para style="q" vid="ISA 5:25">און האָט אים געשלאָגן, אַז די בערג האָבן געציטערט;</para>
  <para style="q" vid="ISA 5:25">און זײערע טױטע לײבער זײַנען געװאָרן װי מיסט אין דער מיט פֿון די גאַסן.</para>
  <para style="q" vid="ISA 5:25">בײַ אַלעם דעם איז נישט אָפּגעגאַנגען זײַן כּעס.</para>
  <para style="q" vid="ISA 5:25">און זײַן האַנט איז נאָך אױסגעשטרעקט.<verse eid="ISA 5:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="ISA 5:26" />און ער װעט אױפֿהײבן אַ פֿאָן צו די פֿעלקער פֿון דער װײַט,</para>
  <para style="q" vid="ISA 5:26">און װעט שטוּצערן צו אים פֿון עק ערד,</para>
  <para style="q" vid="ISA 5:26">און זע, אײַליק פֿלינק װעט ער קומען;<verse eid="ISA 5:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 5:27" />נישטאָ קײן מידער און קײן שטרױכלער בײַ אים,</para>
  <para style="q" vid="ISA 5:27">ער שלוּמערט נישט און שלאָפֿט נישט,</para>
  <para style="q" vid="ISA 5:27">און נישט אָפּגעבוּנדן איז דער גאַרטל פֿון זײַנע לענדן,</para>
  <para style="q" vid="ISA 5:27">און נישט צעריסן אַ בענדל פֿון זײַנע שיך.<verse eid="ISA 5:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 5:28" />װאָס זײַנע פֿײַלן זײַנען געשאַרפֿט,</para>
  <para style="q" vid="ISA 5:28">און אַלע זײַנע בױגנס געשפּאַנט;</para>
  <para style="q" vid="ISA 5:28">די קלױען פֿון זײַנע פֿערד זײַנען װי קיזל גערעכנט,</para>
  <para style="q" vid="ISA 5:28">און זײַנע רעדער װי דער שטורעמװינט.<verse eid="ISA 5:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 5:29" />אָ בריל האָט ער װי די לײבינטע,</para>
  <para style="q" vid="ISA 5:29">און ער ברילט װי יונגלײבן,</para>
  <para style="q" vid="ISA 5:29">און ברוּמט, און כאַפּט רױב,</para>
  <para style="q" vid="ISA 5:29">און טראָגט אַװעק, און נישטאָ װער זאָל מציל זײַן.<verse eid="ISA 5:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 5:30" />און ער װעט ברוּמען אױף אים אין יענעם טאָג,</para>
  <para style="q" vid="ISA 5:30">אַזױ װי די ברומונג פֿון ים;</para>
  <para style="q" vid="ISA 5:30">און מע װעט אַ קוק טאָן צו דער ערד,</para>
  <para style="q" vid="ISA 5:30">ערשט אַן ענגע פֿינצטערניש,</para>
  <para style="q" vid="ISA 5:30">און דאָס ליכט איז פֿינצטער אין אירע הימלען.<verse eid="ISA 5:30" /></para>
  <chapter eid="ISA 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="ISA 6" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1" />אין דעם יאָר װאָס דער מלך עוּזִיָהו איז געשטאָרבן, האָב איך געזען אֲדֹנָי זיצן אױף אַ טראָן דערהױבענעם און זײער הױך, און זײַנע קיניגלעך מאַנטל האָבן אָנגעפֿילט דעם הֵיכל. <verse eid="ISA 6:1" /><verse number="2" style="v" sid="ISA 6:2" />שׂרָפֿים זײַנען געשטאַנען איבער אים; צו זעקס פֿליגלען, צו זעקס פֿליגלען האָט איטלעכער געהאַט: מיט צװײ האָט ער פֿאַרדעקט זײַן פּנים, און מיט צװײ האָט ער פֿאַרדעקט זײַנע פֿיס, און מיט צװײ איז ער געפֿלױגן. <verse eid="ISA 6:2" /><verse number="3" style="v" sid="ISA 6:3" />און אײנער האָט גערופֿן צום אַנדערן, און האָט געזאָגט:</para>
  <para style="q" vid="ISA 6:3">הײליק, הײליק, הײליק איז ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ISA 6:3">די גאַנצע ערד איז פֿול מיט זײַן פּראַכט.<verse eid="ISA 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 6:4" />און די בײַשטידלעך פֿון די שװעלן האָבן זיך געטרײסלט פֿון דעם קֹול פֿון די רופֿער, און דאָס הױז איז פֿול געװאָרן מיט רױך. <verse eid="ISA 6:4" /><verse number="5" style="v" sid="ISA 6:5" />האָב איך געזאָגט: װײ מיר, װאָרעם איך בין פֿאַרשניטן; װײַל אַ מענטש מיט אומרײנע ליפּן בין איך, און צװישן אַ פֿאָלק מיט אומרײנע ליפּן זיץ איך; װאָרעם דעם קיניג ה׳ צבָֿאוֹת האָבן געזען מײַנע אױגן.<verse eid="ISA 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 6:6" />איז צוגעפֿלױגן צו מיר אײנער פֿון די שׂרָפֿים, און אין זײַן האַנט איז געװען אַן אָנגעברענטער שטײן, װאָס ער האָט מיט אַ פֿײַערצװאַנג גענומען פֿון מזבח; <verse eid="ISA 6:6" /><verse number="7" style="v" sid="ISA 6:7" />און ער האָט אים צוגערירט צו מײַן מױל, און האָט געזאָגט: זע, דאָס דאָזיקע האָט אָנגערירט אױף דײַנע ליפּן, אָפּטאָן װעט זיך דײַן פֿאַרברעך, און דײַן זינד װעט פֿאַרגעבן װערן.<verse eid="ISA 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 6:8" />און איך האָב געהערט דעם קֹול פֿון אֲדֹנָי װי ער זאָגט: װעמען זאָל איך שיקן, און װער זאָל אונדז גײן?</para>
  <para style="p" vid="ISA 6:8">האָב איך געזאָגט: דאָ בין איך; שיק מיך. <verse eid="ISA 6:8" /><verse number="9" style="v" sid="ISA 6:9" />האָט ער געזאָגט: גײ און זאָלסט זאָגן צו דעם דאָזיקן פֿאָלק:</para>
  <para style="b" vid="ISA 6:9" />
  <para style="q" vid="ISA 6:9">הערן זאָלט איר הערן, אָבער נישט פֿאַרשטײן,</para>
  <para style="q" vid="ISA 6:9">און זען זאָלט איר זען, אָבער נישט מערקן.<verse eid="ISA 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 6:10" />מאַך פֿעט דאָס האַרץ פֿון דעם דאָזיקן פֿאָלק,</para>
  <para style="q" vid="ISA 6:10">און זײַנע אױערן מאַך שװער,</para>
  <para style="q" vid="ISA 6:10">און זײַנע אױגן פֿאַרקלעפּ,</para>
  <para style="q" vid="ISA 6:10">טאָמער װעט ער זען מיט זײַנע אױגן,</para>
  <para style="q" vid="ISA 6:10">און מיט זײַנע אױערן הערן,</para>
  <para style="q" vid="ISA 6:10">און זײַן האַרץ װעט פֿאַרשטײן,</para>
  <para style="q" vid="ISA 6:10">און ער װעט זיך אומקערן, און געהײלט װערן.<verse eid="ISA 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 6:11" />האָב איך געזאָגט: ביז װאַנען, אֲדֹנָי?</para>
  <para style="q" vid="ISA 6:11">און ער האָט געזאָגט:</para>
  <para style="q" vid="ISA 6:11">ביז אַז שטעט װעלן זײַן װיסט אָן אַ באַװױנער,</para>
  <para style="q" vid="ISA 6:11">און הײַזער אָן אַ מענטשן</para>
  <para style="q" vid="ISA 6:11">און די ערד װעט פֿאַרװיסט װערן אין אַ װיסטעניש;<verse eid="ISA 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 6:12" />און ה׳ װעט דערװײַטערן די מענטשן,</para>
  <para style="q" vid="ISA 6:12">און די פֿאַרלאָזנקײט װעט זײַן גרױס אין לאַנד.<verse eid="ISA 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 6:13" />און בלײַבט נאָך אַ צענט-חלק דרינען,</para>
  <para style="q" vid="ISA 6:13">װעט עס װידער אױסגעראַמט װערן;</para>
  <para style="q" vid="ISA 6:13">װי אַ טערעבינט און װי אַן אײכנבױם,</para>
  <para style="q" vid="ISA 6:13">װאָס נאָר זײער שטאַם בלײַבט װען בלעטער צעפֿאַלן;</para>
  <para style="q" vid="ISA 6:13">דער הײליקער זאָמען װעט זײַן איר שטאַם.<verse eid="ISA 6:13" /></para>
  <chapter eid="ISA 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="ISA 7" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1" />און עס איז געװען אין די טעג פֿון אָחָז דעם זון פֿון יוֹתָם דעם זון פֿון עוּזִיָהון, דעם מלך פֿון יהוּדה, איז רצין דער מלך פֿון אַרָם, און פֶּקַח דער זון פֿון רמַליָהון, דער מלך פֿון יִשׂרָאֵל, אַרױפֿגעגאַנגען אױף ירושָלַיִם, אין מלחמה אױף איר, אָבער זײ האָבן זי נישט געקענט בײַקומען. <verse eid="ISA 7:1" /><verse number="2" style="v" sid="ISA 7:2" />און עס איז אָנגעזאָגט געװאָרן אין הױז פֿון דָוִד, אַזױ צו זאָגן: אַרָם לאַגערט אין אײנעם מיט אפֿרים. און זײַן האַרץ און דאָס האַרץ פֿון זײַן פֿאָלק האָט זיך געטרײסלט, אַזױ װי עס טרײסלען זיך די בײמער פֿון װאַלד פֿאַרן װינט.<verse eid="ISA 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 7:3" />האָט ה׳ געזאָגט צו ישַעיָהון: גײ אַקאָרשט אַרױס אַנטקעגן אָחָזן, דו און דײַן זון שאָר-יָשובֿ, בײַם ברעג גראָבן פֿון דעם אױבערשטן טײַך, אױף דעם װעג פֿון װעשערפֿעלד, <verse eid="ISA 7:3" /><verse number="4" style="v" sid="ISA 7:4" />און זאָלסט זאָגן צו אים: זײַ געזעצט און רויִק, זאָלסט נישט מורא האָבן, און דײַן האַרץ זאָל נישט שלאַף װערן, פֿאַר די דאָזיקע צװײ רײכערדיקע עקן פֿײַערהעלצער; איבער דעם גרימצאָרן פֿון רצין און אַרָם, און דעם זון פֿון רמַליָהון. <verse eid="ISA 7:4" /><verse number="5" style="v" sid="ISA 7:5" />װײַל אַרָם האָט באַראָטן אױף דיר בײז, אפֿרים און דער זון פֿון רמַליָהון, אַזױ צו זאָגן: <verse eid="ISA 7:5" /><verse number="6" style="v" sid="ISA 7:6" />לאָמיר אַרױפֿגײן אױף יהוּדה און זי אײַנשרעקן – און לאָמיר זי אײַנברעכן פֿאַר אונדז, און לאָמיר מאַכן פֿאַר אַ מלך אין איר דעם זון פֿון טָבֿאֵלן –<verse eid="ISA 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 7:7" />האָט אֲדֹנָי ה׳ אַזױ געזאָגט:</para>
  <para style="b" vid="ISA 7:7" />
  <para style="q" vid="ISA 7:7">עס װעט נישט באַשטײן, און װעט נישט געשען.<verse eid="ISA 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 7:8" />װאָרעם דער קאָפּ פֿון אַרָם איז דַמֶשֶׂק,</para>
  <para style="q" vid="ISA 7:8">און דער קאָפּ פֿון דַמֶשֶׂק איז רצין;</para>
  <para style="q" vid="ISA 7:8">און אין נאָך פֿינף און זעכציק יאָר</para>
  <para style="q" vid="ISA 7:8">װעט אפֿרים צעבראָכן װערן פֿאַר אױס פֿאָלק.<verse eid="ISA 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 7:9" />און דער קאָפּ פֿון אפֿרים איז שוֹמרוֹן,</para>
  <para style="q" vid="ISA 7:9">און דער קאָפּ פֿון שוֹמרוֹן איז דער זון פֿון רמַליָהון.</para>
  <para style="q" vid="ISA 7:9">און װען איר װעט נישט גלױבן,</para>
  <para style="q" vid="ISA 7:9">אַזױ װעט איר נישט באַשטײן קענען.<verse eid="ISA 7:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10" />און ה׳ האָט װידער גערעדט צו אָחָזן, אַזױ צו זאָגן: <verse eid="ISA 7:10" /><verse number="11" style="v" sid="ISA 7:11" />בעט דיר אַ צײכן פֿון ה׳ דײַן ג-ט; בעט פֿון דער טיפֿעניש, אָדער פֿון אױבן אין דער הײך. <verse eid="ISA 7:11" /><verse number="12" style="v" sid="ISA 7:12" />האָט אָחָז געזאָגט: איך װעל נישט בעטן, און נישט פּרוּװן ה׳. <verse eid="ISA 7:12" /><verse number="13" style="v" sid="ISA 7:13" />האָט ער געזאָגט: הערט אַקאָרשט, איר הױז פֿון דָוִד: איז אײַך װינציק מיד צו מאַכן מענטשן, אַז איר װילט אױך מײַן ג-ט מיד מאַכן? <verse eid="ISA 7:13" /><verse number="14" style="v" sid="ISA 7:14" />דערום װעט אֲדֹנָי אַלײן אײַך געבן אַ צײכן: אָט װערט די עלמה יונגפֿרױ בתולה טראָגעדיק, און זי געבערט אַ זון, און װעט רופֿן זײַן נאָמען עִמָנוּאֵל. <verse eid="ISA 7:14" /><verse number="15" style="v" sid="ISA 7:15" />שמאַנט און האָניק װעט ער עסן, װען ער װעט װיסן פֿײַנט צו האָבן שלעכטס, און אױסצוקלײַבן גוטס. – <verse eid="ISA 7:15" /><verse number="16" style="v" sid="ISA 7:16" />יאָ, נאָך אײדער דער ייִנגל װעט װיסן פֿײַנט צו האָבן שלעכטס, און אױסצוקלײַבן גוטס, װעט פֿאַרלאָזן װערן די ערד װאָס דו שרעקסט זיך פֿאַר אירע צװײ מלכים. – <verse eid="ISA 7:16" /><verse number="17" style="v" sid="ISA 7:17" />ה׳ װעט ברענגען אױף דיר, און אױף דײַן פֿאָלק, און אױף דײַן פֿאָטערס הױז, טעג װאָס זײַנען נישט געװען פֿון דעם טאָג װאָס אפֿרים האָט זיך אָפּגעקערט פֿון יהוּדה – דעם מלך פֿון אשור.<verse eid="ISA 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 7:18" />און עס װעט זײַן אין יענעם טאָג, װעט ה׳ אַ שמוצער טאָן צו דער פֿליג װאָס אין עק טײַכן פֿון מִצרַיִם, און צו דער בין װאָס אין לאַנד אשור. <verse eid="ISA 7:18" /><verse number="19" style="v" sid="ISA 7:19" />און זײ װעלן קומען, און װעלן אַלע רוען אין די װיסטע טאָלן און אין די שפּאַלטן פֿון פֿעלדזן, און אין אַלע דערנער און אין אַלע װילדע בײמלעך.<verse eid="ISA 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 7:20" />אין יענעם טאָג װעט אֲדֹנָי אָפּגאָלן מיט דעם גאָלמעסער געדונגען אױף יענער זײַט טײַך – מיט דעם מלך פֿון אשור, דעם קאָפּ און די האָר פֿון די פֿיס, און אױך די באָרד װעט עס אַראָפּנעמען.<verse eid="ISA 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 7:21" />און עס װעט זײַן אין יענעם טאָג, אַז אַ מאַן װעט אױפֿהאָדעװען אַ יונגע קו און צװײ שאָף, <verse eid="ISA 7:21" /><verse number="22" style="v" sid="ISA 7:22" />איז, פֿון פֿיל מילך װאָס זײ װעלן געבן, װעט ער עסן שמאַנט; װאָרעם שמאַנט און האָניק װעט עסן איטלעכער װאָס איז געבליבן אין לאַנד.<verse eid="ISA 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 7:23" />און עס װעט זײַן אין יענעם טאָג, איז, איטלעכער אָרט װוּ עס זײַנען דאָ טױזנט װײַנשטאָקן װערט טױזנט זילבערשטיק, װעט פֿאַר דערנער און פֿאַר װילדגעװעקס זײַן. <verse eid="ISA 7:23" /><verse number="24" style="v" sid="ISA 7:24" />מיט פֿײַלן און מיט בױגן װעט מען קומען אַהין, װאָרעם דערנער און װילדגעװעקס װעט זײַן דאָס גאַנצע לאַנד. <verse eid="ISA 7:24" /><verse number="25" style="v" sid="ISA 7:25" />און אַלע בערג װאָס װערן מיט אַ גראָבאײַזן געגראָבן, װעסטו אַהין נישט קומען אױס מורא פֿאַר דערנער און װילדגעװעקס, נאָר עס װעט זײַן פֿאַר אָקסן אַרױסצולאָזן, און פֿאַר שאָף צום טרעטן.<verse eid="ISA 7:25" /></para>
  <chapter eid="ISA 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="ISA 8" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1" />און ה׳ האָט צו מיר געזאָגט: נעם דיר אַ גרױסן טאָװל, און שרײַב אָן דערױף מיטן שריפֿט פֿון פֿאָלק: מַהֵר-שָלָל-חָש-בַז. <verse eid="ISA 8:1" /><verse number="2" style="v" sid="ISA 8:2" />און איך זאָל מיר שטעלן באַגלױבטע עדות, אוּרִיה דעם כּהן, און זכַריָהו דעם זון פֿון יבֶרֶכיָהון.<verse eid="ISA 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 8:3" />און איך האָב גענענט צו דער נבֿיאה, און זי איז טראָגעדיק געװאָרן, און האָט געבאָרן אַ זון. און ה׳ האָט צו מיר געזאָגט: רוף זײַן נאָמען: מַהֵר-שָלָל-חָש-בַז. <verse eid="ISA 8:3" /><verse number="4" style="v" sid="ISA 8:4" />װאָרעם אײדער דער ייִנגל װעט װיסן צו רופֿן טאַטע און מאַמע, װעט מען אַװעקטראָגן דעם פֿאַרמעג פֿון דַמֶשֶׂק, און דעם זאַקרױב פֿון שוֹמרוֹן, פֿאַרױס פֿאַר דעם מלך פֿון אשור.<verse eid="ISA 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5" />און ה׳ האָט נאָך װידער צו מיר גערעדט, אַזױ צו זאָגן:<verse eid="ISA 8:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 8:6" />װײַל דאָס דאָזיקע פֿאָלק האָט פֿאַראַכט</para>
  <para style="q" vid="ISA 8:6">די װאַסערן פֿון שִלוֹחַ װאָס גײען פּאַמעלעך,</para>
  <para style="q" vid="ISA 8:6">און זיך געפֿרײט מיט רצין און דעם זון פֿון רמַליָהון,<verse eid="ISA 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 8:7" />דרומעך זע, אֲדֹנָי ברענגט אַרױף אױף זײ</para>
  <para style="q" vid="ISA 8:7">די גרױסע און מאַכטיקע װאַסערן פֿון טײַך,</para>
  <para style="q" vid="ISA 8:7">דעם מלך פֿון אשור מיט זײַן גאַנצער מחנה,</para>
  <para style="q" vid="ISA 8:7">און ער װעט איבערלױפֿן איבער אַלע זײַנע גראָבנס,</para>
  <para style="q" vid="ISA 8:7">און אַריבערגײן איבער זײַנע אַלע ברעגן;<verse eid="ISA 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 8:8" />און ער װעט דורכציִען דורך יהוּדה,</para>
  <para style="q" vid="ISA 8:8">פֿלײצנדיק װעט ער דורכשטראָמען,</para>
  <para style="q" vid="ISA 8:8">ביזן האַלדז װעט ער גרײכן,</para>
  <para style="q" vid="ISA 8:8">און די שפּרײטונגען פֿון זײַנע פֿליגלען</para>
  <para style="q" vid="ISA 8:8">װעלן אָנפֿילן די ברײט פֿון דײַן לאַנד, עִמָנוּאֵל!<verse eid="ISA 8:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 8:9" />ליאַרעמט, איר פֿעלקער, אָבער איר װעט צעבראָכן װערן;</para>
  <para style="q" vid="ISA 8:9">יאָ, פֿאַרנעמט אַלע װײַטענישן פֿון דער ערד;</para>
  <para style="q" vid="ISA 8:9">גורט אײַך אָן, אָבער איר װעט צעבראָכן װערן,</para>
  <para style="q" vid="ISA 8:9">גורט אײַך אָן, אָבער איר װעט צעבראָכן װערן.<verse eid="ISA 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 8:10" />עצהט אַן עצה, און זי װעט פֿאַרשטערט װערן,</para>
  <para style="q" vid="ISA 8:10">רעדט אָפּ אַ זאַך, און זי װעט נישט באַשטײן,</para>
  <para style="q" vid="ISA 8:10">װאָרעם אֵל איז מיט אונדז.<verse eid="ISA 8:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11" />װאָרעם אַזױ האָט געזאָגט ה׳ צו מיר מיט אַ שטאַרקער האַנט, און ער האָט מיך געװאָרנט, נישט צו גײן אין װעג פֿון דעם דאָזיקן פֿאָלק, אַזױ צו זאָגן: <verse eid="ISA 8:11" /><verse number="12" style="v" sid="ISA 8:12" />איר זאָלט נישט זאָגן בונט אױף אַלץ װאָס דאָס דאָזיקע פֿאָלק זאָגט בונט, און זײַן מורא זאָלט איר נישט מורא האָבן, און נישט פֿאָרכטן. <verse eid="ISA 8:12" /><verse number="13" style="v" sid="ISA 8:13" />ה׳ צבָֿאוֹת, אים זאָלט איר הײליקן, און ער זאָל זײַן אײַער מורא, און ער אײַער פֿאָרכט. <verse eid="ISA 8:13" /><verse number="14" style="v" sid="ISA 8:14" />און ער װעט זײַן פֿאַר אַ מִקדָש, אָבער אױך פֿאַר אַ שטײן פֿון אָנשטױסונג, און פֿאַר אַ פֿעלדז פֿון שטרױכלונג, פֿאַר בײדע הײַזער פֿון יִשׂרָאֵל; פֿאַר אַ נעץ און פֿאַר אַ פּאַסטקע פֿאַר דעם באַװױנער פֿון ירושָלַיִם. <verse eid="ISA 8:14" /><verse number="15" style="v" sid="ISA 8:15" />און פֿיל צװישן זײ װעלן געשטרױכלט װערן, און פֿאַלן און צעבראָכן װערן, און געפֿאַנגען און באַצװוּנגען װערן.<verse eid="ISA 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 8:16" />פֿאַרבינדן די װאָרעניש, פֿאַרחתמען די לערנונג צװישן מײַנע לערנערס! <verse eid="ISA 8:16" /><verse number="17" style="v" sid="ISA 8:17" />און איך װעל האָפֿן אױף ה׳ װאָס פֿאַרבאָרגט זײַן פּנים פֿון דעם הױז פֿון יעקבֿ, און װעל האָפֿן צו אים. <verse eid="ISA 8:17" /><verse number="18" style="v" sid="ISA 8:18" />אָט בין איך און די קינדער װאָס ה׳ האָט מיר געגעבן, פֿאַר סימנים און פֿאַר צײכנס אין יִשׂרָאֵל פֿון ה׳ צבָֿאוֹת װאָס רוט אױף באַרג צִיוֹן.<verse eid="ISA 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 8:19" />און אַז זײ װעלן זאָגן צו אײַך: פֿרעגט בײַ די גײַסטער און בײַ די רוחות װאָס פּיפּסן און װאָס מורמלען, זאָלט איר זאָגן: דאַרף נישט אַ פֿאָלק פֿרעגן בײַ זײַן ג-ט? צו װאָס פֿרעגן פֿאַר די לעבעדיקע בײַ די טױטע? <verse eid="ISA 8:19" /><verse number="20" style="v" sid="ISA 8:20" />צו דער תּורה און צו דעם עדות, װען זײ זאָגן נישט אַזױ װי דאָס דאָזיקע װאָרט, אַזױ איז עס װײַל זײ האָט נישט קײן מאָרגן ליכט. <verse eid="ISA 8:20" /><verse number="21" style="v" sid="ISA 8:21" />און דורכגײן װעט דורך דאַנען אַ געדריקטער און אַ הונגעריקער; און עס װעט זײַן, אַז ער װעט הונגערן, װעט ער צערענען, און װעט שילטן זײַן מלך און זײַן ג-ט; און ער װעט זיך קערן צו דער הײך, <verse eid="ISA 8:21" /><verse number="22" style="v" sid="ISA 8:22" />און װעט קוקן צו דער ערד, ערשט נױט און פֿינצטערניש, אַנגסטיקע טונקלעניש, און חושכניש אױסגעשפּרײט.<verse eid="ISA 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="9.1" sid="ISA 8:23" /> װאָרעם עס בלײַבט נישט פֿינצטער, װוּ עס איז איצט יסורים: אין ערשטן מאָל האָט ער געבראַכט דאָס לאַנד זבֿולון און דאָס לאַנד נַפֿתָּלי אין חרפּה, און אין דעם לעצטן ברענגט ער כּבֿוד דעם װעג בײַם ים, פֿון דער אַנדער זײַט יַרדן, דעם גָליל פֿון די גוֹיִם.<verse eid="ISA 8:23" /></para>
  <chapter eid="ISA 8" />
  <chapter number="9" style="c" pubnumber="ט" sid="ISA 9" />
  <para style="q">
    <verse number="1" style="v" pubnumber="9.2" sid="ISA 9:1" /> דאָס פֿאָלק װאָס איז געגאַנגען אין פֿינצטערניש,</para>
  <para style="q" vid="ISA 9:1">האָט דערזען אַ גרױס ליכטיקײט;</para>
  <para style="q" vid="ISA 9:1">די װאָס זײַנען געזעסן אין לאַנד פֿון טױטשאָטן,</para>
  <para style="q" vid="ISA 9:1">אױף זײ האָט אַ ליכטיקײט געשײַנט.<verse eid="ISA 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" pubnumber="9.3" sid="ISA 9:2" /> האָסט געמערט דאָס פֿאָלק,</para>
  <para style="q" vid="ISA 9:2">האָסט געגרײסט זײַן פֿרײד;</para>
  <para style="q" vid="ISA 9:2">זײ פֿרײען זיך פֿאַר דיר, װי די פֿרײד בײַם שניט,</para>
  <para style="q" vid="ISA 9:2">װי מען קװעלט װען מע טײלט זיך מיט רױב.<verse eid="ISA 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" pubnumber="9.4" sid="ISA 9:3" /> װאָרעם דעם יאָך פֿון זײַן לאַסט,</para>
  <para style="q" vid="ISA 9:3">און דעם שטאַנג פֿון זײַן נאַקן,</para>
  <para style="q" vid="ISA 9:3">די רוט פֿון זײַן דריקער,</para>
  <para style="q" vid="ISA 9:3">האָסטו צעבראָכן װי אין טאָג פֿון מִדיָן.<verse eid="ISA 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" pubnumber="9.5" sid="ISA 9:4" /> װאָרעם יעטװעדער שוך װאָס האָט געשאַרט מיט רַעש,</para>
  <para style="q" vid="ISA 9:4">און יעטװעדער מאַנטל געװעלגערט אין בלוט,</para>
  <para style="q" vid="ISA 9:4">װעט זײַן צו בראַנד,</para>
  <para style="q" vid="ISA 9:4">אַ שפּײַז פֿאַרן פֿײַער.<verse eid="ISA 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" pubnumber="9.6" sid="ISA 9:5" /> װאָרעם אַ קינד איז אונדז געבאָרן געװאָרן,</para>
  <para style="q" vid="ISA 9:5">אַ זון איז אונדז געגעבן געװאָרן,</para>
  <para style="q" vid="ISA 9:5">און די הערשאַפֿט איז אױף זײַן אַקסל;</para>
  <para style="q" vid="ISA 9:5">און מע רופֿט זײַן נאָמען:</para>
  <para style="q" vid="ISA 9:5">פֶּלֶא-יוֹעץ אֵל-גִבור,</para>
  <para style="q" vid="ISA 9:5">אַבֿי-עד שַׂר-שלום;<verse eid="ISA 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" pubnumber="9.7" sid="ISA 9:6" /> צו מערן די הערשאַפֿט,</para>
  <para style="q" vid="ISA 9:6">און צו שלום אָן שיעור,</para>
  <para style="q" vid="ISA 9:6">אױף דעם טראָן פֿון דָוִד,</para>
  <para style="q" vid="ISA 9:6">און אױף זײַן מלוכה;</para>
  <para style="q" vid="ISA 9:6">זי צו פֿעסטיקן און זי אונטערצולענען</para>
  <para style="q" vid="ISA 9:6">מיט רעכט און גערעכטיקײט,</para>
  <para style="q" vid="ISA 9:6">פֿון אַצונד און ביז אײביק;</para>
  <para style="q" vid="ISA 9:6">דאָס אָננעמען זיך פֿון ה׳ צבָֿאוֹת טוט דאָס דאָזיקע.<verse eid="ISA 9:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" pubnumber="9.8" sid="ISA 9:7" /> אֲדֹנָי האָט אַ װאָרט געשיקט אין יעקבֿ,</para>
  <para style="q" vid="ISA 9:7">און עס איז געפֿאַלן אין יִשׂרָאֵל.<verse eid="ISA 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" pubnumber="9.9" sid="ISA 9:8" /> און װיסן װעט דאָס גאַנצע פֿאָלק,</para>
  <para style="q" vid="ISA 9:8">אפֿרים און דער באַװױנער פֿון שוֹמרוֹן,</para>
  <para style="q" vid="ISA 9:8">װאָס זאָגט מיט גַאַװה און מיט גדלות פֿון האַרצן:<verse eid="ISA 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" pubnumber="9.10" sid="ISA 9:9" /> ציגל זײַנען אײַנגעפֿאַלן,</para>
  <para style="q" vid="ISA 9:9">און געהאַקטע שטײנער װעלן מיר בױען;</para>
  <para style="q" vid="ISA 9:9">װילדע פֿײַגנבײמער זײַנען אָפּגעהאַקט געװאָרן,</para>
  <para style="q" vid="ISA 9:9">און מיט צעדערן װעלן מיר זײ פֿאַרבײַטען.<verse eid="ISA 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" pubnumber="9.11" sid="ISA 9:10" /> דערום דערהײבט ה׳ די פֿײַנט פֿון רצין אױף אים,</para>
  <para style="q" vid="ISA 9:10">און זײַנע שׂונאים װעט ער אָנרײצן;<verse eid="ISA 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" pubnumber="9.12" sid="ISA 9:11" /> אַרָם פֿון פֿאָרנט, און פּלִשתּים פֿון הינטן;</para>
  <para style="q" vid="ISA 9:11">און זײ עסן יִשׂרָאֵל מיטן גאַנצן מױל.</para>
  <para style="b" vid="ISA 9:11" />
  <para style="q" vid="ISA 9:11">בײַ אַלעם דעם איז נישט אָפּגעגאַנגען זײַן כּעס,</para>
  <para style="q" vid="ISA 9:11">און זײַן האַנט איז נאָך אױסגעשטרעקט.<verse eid="ISA 9:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" pubnumber="9.13" sid="ISA 9:12" /> אָבער דאָס פֿאָלק קערט זיך נישט צו זײַן שלעגער,</para>
  <para style="q" vid="ISA 9:12">און ה׳ צבָֿאוֹת זוכן זײ נישט.<verse eid="ISA 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" pubnumber="9.14" sid="ISA 9:13" /> און ה׳ פֿאַרשנײַדט פֿון יִשׂרָאֵל קאָפּ און עק,</para>
  <para style="q" vid="ISA 9:13">טײטלצװײַג און טײַכריטל, אין אײן טאָג.<verse eid="ISA 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" pubnumber="9.15" sid="ISA 9:14" /> דער זקן און דער אָנגעזעענער, דאָס איז דער קאָפּ,</para>
  <para style="q" vid="ISA 9:14">און דער נבֿיא װאָס לערנט ליגן, דאָס איז דער עק.<verse eid="ISA 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" pubnumber="9.16" sid="ISA 9:15" /> און די האַרן פֿון דעם דאָזיקן פֿאָלק זײַנען פֿאַרפֿירער,</para>
  <para style="q" vid="ISA 9:15">און זײערע געפֿירטע זײַנען צעמישט.<verse eid="ISA 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" pubnumber="9.17" sid="ISA 9:16" /> דערום פֿרײט זיך נישט אֲדֹנָי מיט זײַנע יונגע לײַט,</para>
  <para style="q" vid="ISA 9:16">און זײַנע יתומים און אַלמנות דערבאַרעמט ער נישט;</para>
  <para style="q" vid="ISA 9:16">װאָרעם איטלעכער איז זינדיק און טוט שלעכטס,</para>
  <para style="q" vid="ISA 9:16">און איטלעך מױל רעדט שענדלעכקײט.</para>
  <para style="b" vid="ISA 9:16" />
  <para style="q" vid="ISA 9:16">בײַ אַלעם דעם איז נישט אָפּגעגאַנגען זײַן כּעס,</para>
  <para style="q" vid="ISA 9:16">און זײַן האַנט איז נאָך אױסגעשטרעקט.<verse eid="ISA 9:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" pubnumber="9.18" sid="ISA 9:17" /> װאָרעם די שלעכטיקײט ברענט װי אַ פֿײַער,</para>
  <para style="q" vid="ISA 9:17">זי פֿאַרצערט דערנער און װילדגעװעקס,</para>
  <para style="q" vid="ISA 9:17">און צינדט די געצװײַגן פֿון װאַלד,</para>
  <para style="q" vid="ISA 9:17">ביז זײ קנױלן זיך אין זײַלן פֿון רױך.<verse eid="ISA 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" pubnumber="9.19" sid="ISA 9:18" /> דורך דעם צאָרן פֿון ה׳ צבָֿאוֹת</para>
  <para style="q" vid="ISA 9:18">איז צעפֿלאַקערט דאָס לאַנד,</para>
  <para style="q" vid="ISA 9:18">און דאָס פֿאָלק איז װי שפּײַז פֿאַרן פֿײַער;</para>
  <para style="q" vid="ISA 9:18">זײ דערבאַרעמען זיך נישט קײנער אױף זײַן ברודער,<verse eid="ISA 9:18" /></para>
  <para style="q">
    <verse number="19" style="v" pubnumber="9.20" sid="ISA 9:19" /> און מע רײַסט רעכטס, און בלײַבט הונגעריק,</para>
  <para style="q" vid="ISA 9:19">און מע עסט לינקס, און װערט נישט זאַט;</para>
  <para style="q" vid="ISA 9:19">זײ עסן איטלעכער דאָס פֿלײש פֿון זײַן אָרעם:<verse eid="ISA 9:19" /></para>
  <para style="q">
    <verse number="20" style="v" pubnumber="9.21" sid="ISA 9:20" /> מנַשֶה אפֿרימען, און אפֿרים מנַשֶהן,</para>
  <para style="q" vid="ISA 9:20">זײ אין אײנעם אױף יהוּדה.</para>
  <para style="b" vid="ISA 9:20" />
  <para style="q" vid="ISA 9:20">בײַ אַלעם דעם איז נישט אָפּגעגאַנגען זײַן כּעס,</para>
  <para style="q" vid="ISA 9:20">און זײַן האַנט איז נאָך אױסגעשטרעקט.<verse eid="ISA 9:20" /></para>
  <chapter eid="ISA 9" />
  <chapter number="10" style="c" pubnumber="י" sid="ISA 10" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 10:1" />װײ, די װאָס מאַכן אומגערעכטע געזעץ,</para>
  <para style="q" vid="ISA 10:1">און שרײַבער װאָס האָבן אומרעכט געשריבן,<verse eid="ISA 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 10:2" />כּדי אָפּצונײגן פֿון משפּט די באַדערפֿטיקע,</para>
  <para style="q" vid="ISA 10:2">און גזלען דאָס רעכט פֿון די אָרימע פֿון מײַן פֿאָלק;</para>
  <para style="q" vid="ISA 10:2">כּדי אַלמנות זאָלן זײַן זײער רױב,</para>
  <para style="q" vid="ISA 10:2">און יתומים זאָלן זײ באַראַבעװען!<verse eid="ISA 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 10:3" />און װאָס װעט איר טאָן אין טאָג פֿון רעכנשאַפֿט,</para>
  <para style="q" vid="ISA 10:3">און אין דער פֿאַרװיסטונג װאָס קומט פֿון דער װײַט?</para>
  <para style="q" vid="ISA 10:3">צו װעמען װעט איר לױפֿן נאָך הילף?</para>
  <para style="q" vid="ISA 10:3">און װוּ װעט איר איבערלאָזן אײַער רײַכטום?<verse eid="ISA 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 10:4" />נישט אַנדערש װי קניִען אונטער געפֿאַנגענע,</para>
  <para style="q" vid="ISA 10:4">און אונטער הרוּגים צו פֿאַלן.</para>
  <para style="b" vid="ISA 10:4" />
  <para style="q" vid="ISA 10:4">בײַ אַלעם דעם איז נישט אָפּגעגאַנגען זײַן כּעס,</para>
  <para style="q" vid="ISA 10:4">און זײַן האַנט איז נאָך אױסגעשטרעקט.<verse eid="ISA 10:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 10:5" />װײ, אשור, די רוט פֿון מײַן צאָרן,</para>
  <para style="q" vid="ISA 10:5">װאָס מײַן כּעס איז אַ שטעקן אין זײער האַנט!<verse eid="ISA 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 10:6" />אױף אַ זינדיקן פֿאָלק טו איך אים שיקן,</para>
  <para style="q" vid="ISA 10:6">און אױף דער אומה פֿון מײַן צאָרן טו איך אים באַפֿעלן,</para>
  <para style="q" vid="ISA 10:6">צו רױבן זאַקרױב, און צו ראַבעװען רױב,</para>
  <para style="q" vid="ISA 10:6">און זי מאַכן צו טרעטן װי קױט פֿון די גאַסן.<verse eid="ISA 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 10:7" />אָבער נישט אַזױ מײנט ער,</para>
  <para style="q" vid="ISA 10:7">און נישט אַזױ טראַכט זײַן האַרץ,</para>
  <para style="q" vid="ISA 10:7">נײַערט צו פֿאַרטיליקן איז אין זײַן האַרצן,</para>
  <para style="q" vid="ISA 10:7">און צו פֿאַרשנײַדן פֿעלקער נישט װינציק.<verse eid="ISA 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 10:8" />װאָרעם ער זאָגט:</para>
  <para style="q" vid="ISA 10:8">זײַנען נישט מײַנע האַרן מלכים אַלע?<verse eid="ISA 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 10:9" />איז נישט װי כַּרכּמיש כַּלנו?</para>
  <para style="q" vid="ISA 10:9">צי איז נישט װי אַרפַּד חַמָת?</para>
  <para style="q" vid="ISA 10:9">צי איז נישט װי דַמֶשֶׂק שוֹמרוֹן?<verse eid="ISA 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 10:10" />אַזױ װי מײַן האַנט האָט דערגרײכט</para>
  <para style="q" vid="ISA 10:10">די קיניגרײַכן פֿון די אָפּגעטער,</para>
  <para style="q" vid="ISA 10:10">װאָס זײערע געצן זײַנען מער געװען</para>
  <para style="q" vid="ISA 10:10">װי פֿון ירושָלַיִם און פֿון שוֹמרוֹן –<verse eid="ISA 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 10:11" />פֿאַר װאָר, אַזױ װי איך האָב געטאָן</para>
  <para style="q" vid="ISA 10:11">צו שוֹמרוֹן און צו אירע אָפּגעטער,</para>
  <para style="q" vid="ISA 10:11">אַזױ װעל איך טאָן צו ירושָלַיִם</para>
  <para style="q" vid="ISA 10:11">און צו אירע געצנבילדער.<verse eid="ISA 10:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="ISA 10:12" />אָבער עס װעט זײַן, אַז אֲדֹנָי װעט ענדיקן אַל זײַן װערק אױף באַרג צִיוֹן און אױף ירושָלַיִם, װעל איך זיך רעכענען פֿאַר דער פֿרוכט פֿון דעם שטאָלצן האַרצן פֿון דעם מלך פֿון אשור, און פֿאַר דער רימערײַ פֿון זײַנע האָפֿערדיקע אױגן.<verse eid="ISA 10:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 10:13" />װאָרעם ער האָט געזאָגט:</para>
  <para style="q" vid="ISA 10:13">מיט כּוֹח פֿון מײַן האַנט האָב איך אױפֿגעטאָן,</para>
  <para style="q" vid="ISA 10:13">און מיט מײַן חכמה, װײַל איך בין פֿאַרשטאַנדיק;</para>
  <para style="q" vid="ISA 10:13">און איך טו אָפּ די געמאַרקן פֿון פֿעלקער,</para>
  <para style="q" vid="ISA 10:13">און זײערע שאַצן האָב איך צערױבט,</para>
  <para style="q" vid="ISA 10:13">און מאַכטיק טו איך נידערן די באַװױנער.<verse eid="ISA 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 10:14" />און מײַן האַנט האָט געפֿונען װי אַ נעסט</para>
  <para style="q" vid="ISA 10:14">דעם פֿאַרמעג פֿון די פֿעלקער,</para>
  <para style="q" vid="ISA 10:14">און װי מע קלײַבט אױף אײַער פֿאַרלאָזענע,</para>
  <para style="q" vid="ISA 10:14">האָב איך די גאַנצע ערד אױפֿגעקליבן;</para>
  <para style="q" vid="ISA 10:14">און נישט געװען װער זאָל אַ פֿליגל רירן,</para>
  <para style="q" vid="ISA 10:14">אָדער עפֿענען אַ מױל און אַ פּיפּס טאָן.<verse eid="ISA 10:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 10:15" />קען די האַק זיך רימען קעגן דעם װאָס האַקט מיט איר?</para>
  <para style="q" vid="ISA 10:15">קען די זעג זיך גרײסן קעגן דעם װאָס ציט זי?</para>
  <para style="q" vid="ISA 10:15">װי אַ רוט זאָל פֿאָכן מיט אירע אױפֿהײבער,</para>
  <para style="q" vid="ISA 10:15">װי אַ שטעקן זאָל אױפֿהײבן</para>
  <para style="q" vid="ISA 10:15">דעם װאָס נישט האָלץ!<verse eid="ISA 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 10:16" />דערום װעט דער האַר, ה׳ צבָֿאוֹת</para>
  <para style="q" vid="ISA 10:16">אָנשיקן אַ מאָגערקײט דערױף זײַן פֿעטקײט;</para>
  <para style="q" vid="ISA 10:16">און אַנשטאָט זײַן פּראַכט װעט זיך צעברענען אַ בראַנד,</para>
  <para style="q" vid="ISA 10:16">װי די בראַנד פֿון אַ פֿײַער.<verse eid="ISA 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 10:17" />און דאָס ליכט פֿון יִשׂרָאֵל װעט זײַן אַ פֿײַער,</para>
  <para style="q" vid="ISA 10:17">און זײַן הײליקער אַ פֿלאַם,</para>
  <para style="q" vid="ISA 10:17">און זי װעט ברענען און פֿאַרצערן זײַנע דערנער</para>
  <para style="q" vid="ISA 10:17">און זײַן װילדגעװעקס אין אײן טאָג.<verse eid="ISA 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 10:18" />און די פּראַכט פֿון זײַן װאַלד און זײַן פֿרוכטגאָרטן</para>
  <para style="q" vid="ISA 10:18">װעט ער לײַב און זעל פֿאַרלענדן;</para>
  <para style="q" vid="ISA 10:18">און עס װעט זײַן װי דאָס אױסגײן פֿון אַ גוסס.<verse eid="ISA 10:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 10:19" />און דער רעשט בײמער פֿון זײַן װאַלד װעלן זײַן געצײלטע,</para>
  <para style="q" vid="ISA 10:19">און אַ ייִנגל װעט זײ קענען אױפֿשרײַבן.<verse eid="ISA 10:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="ISA 10:20" />און עס װעט זײַן אין יענעם טאָג, װעט דער איבערבלײַב פֿון יִשׂרָאֵל, און די אַנטרונענע פֿון הױז פֿון יעקבֿ, זיך מער נישט אָנלענען אױף זײער שלעגער, נאָר זיך אָנלענען מיט אמת אױף ה׳, דעם הײליקן פֿון יִשׂרָאֵל. <verse eid="ISA 10:20" /><verse number="21" style="v" sid="ISA 10:21" />אַן איבערבלײַב װעט זיך אומקערן, אַן איבערבלײַב פֿון יעקבֿ, צו אֵל-גִבור. <verse eid="ISA 10:21" /><verse number="22" style="v" sid="ISA 10:22" />װאָרעם אױב דײַן פֿאָלק, יִשׂרָאֵל, זאָל זײַן װי זאַמד פֿון ים, װעט נאָר אַן איבערבלײַב פֿון אים זיך אומקערן; אַ פֿאַרלענדונג איז נִגזר געװאָרן, זי פֿלײצט מיט גערעכטיקײט. <verse eid="ISA 10:22" /><verse number="23" style="v" sid="ISA 10:23" />װאָרעם אַ פֿאַרלענדעניש און אַ גזר מאַכט אֲדֹנָי, ה׳ צבָֿאוֹת, אין גאַנצן לאַנד.<verse eid="ISA 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 10:24" />פֿאַר װאָר, אַזױ האָט געזאָגט אֲדֹנָי, ה׳ צבָֿאוֹת: זאָלסט נישט מורא האָבן, מײַן פֿאָלק, באַװױנער פֿון צִיוֹן, פֿאַר אשור װאָס שלאָגט דיך מיט דער רוט, און הײבט זײַן שטעקן אױף דיר, אױפֿן שטײגער פֿון מִצרַיִם. <verse eid="ISA 10:24" /><verse number="25" style="v" sid="ISA 10:25" />װאָרעם נאָך אַ קלײן װײַל, און דער כּעס װעט זיך ענדיקן, און מײַן צאָרן װעט זײַן צו זײער פֿאַרטיליקונג. <verse eid="ISA 10:25" /><verse number="26" style="v" sid="ISA 10:26" />און ה׳ צבָֿאוֹת װעט דערװעקן אױף אים אַ רוט, אַזױ װי אין דעם שלאַק פֿון מִדיָן אין צור-עוֹרֵבֿ, און װי זײַן שטעקן איבערן ים; און ער װעט זי אױפֿהײבן אױפֿן שטײגער פֿון מִצרַיִם. <verse eid="ISA 10:26" /><verse number="27" style="v" sid="ISA 10:27" />און עס װעט זײַן אין יענעם טאָג, װעט אָפּגעטאָן װערן זײַן לאַסט פֿון דײַן רוקן, און זײַן יאָך פֿון דײַן האַלדז, און דער יאָך װעט צעבראָכן װערן פֿונעם פֿעטס.<verse eid="ISA 10:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="ISA 10:28" />ער איז געקומען אױף עַיָת,</para>
  <para style="q" vid="ISA 10:28">ער איז דורכגעגאַנגען מִגרון,</para>
  <para style="q" vid="ISA 10:28">אין מִכמָש לאָזט ער איבער זײַן געפּעק;<verse eid="ISA 10:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 10:29" />זײ זײַנען אַריבער דעם איבערפֿאָר,</para>
  <para style="q" vid="ISA 10:29">אין גֶבַֿע האָבן זײ נאַכטלעג געהאַלטן.</para>
  <para style="q" vid="ISA 10:29">רָמָה טוט ציטערן,</para>
  <para style="q" vid="ISA 10:29">גבֿעת-שָאול איז אַנטלאָפֿן.<verse eid="ISA 10:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 10:30" />שרײַ אױפֿן קֹול, טאָכטער גַלים!</para>
  <para style="q" vid="ISA 10:30">האָרך, לַיִש! אָרימע עַנָתוֹת!<verse eid="ISA 10:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 10:31" />מַדמֵנָה װאָגלט,</para>
  <para style="q" vid="ISA 10:31">די װױנער פֿון גֵבֿים אַנטרינען.<verse eid="ISA 10:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="ISA 10:32" />נאָך הײַנט װעט ער זיך אָפּשטעלן אין נוֹבֿ;</para>
  <para style="q" vid="ISA 10:32">ער פֿאָכט זײַן האַנט אױפֿן באַרג פֿון טאָכטער צִיוֹן,</para>
  <para style="q" vid="ISA 10:32">אױף דעם הױכן אָרט פֿון ירושָלַיִם.<verse eid="ISA 10:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" sid="ISA 10:33" />זע, דער האַר, ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ISA 10:33">ברעכט אָפּ די צװײַגן מיט מוֹראדיקײט,</para>
  <para style="q" vid="ISA 10:33">און די הױכגעװאַקסענע װערן אָפּגעשניטן,</para>
  <para style="q" vid="ISA 10:33">און די דערהױבענע װעלן דערנידערט װערן.<verse eid="ISA 10:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="ISA 10:34" />און ער װעט אָפּהאַקן די געצװײַגן פֿון װאַלד מיט אַן אײַזן,</para>
  <para style="q" vid="ISA 10:34">און דער לבֿנוֹן װעט דורך אַ מאַכטיקן פֿאַלן.<verse eid="ISA 10:34" /></para>
  <chapter eid="ISA 10" />
  <chapter number="11" style="c" pubnumber="יא" sid="ISA 11" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 11:1" />און אַ רוט װעט אַרױס פֿון דעם בױם שטאַם פֿון יִשַי,</para>
  <para style="q" vid="ISA 11:1">און אַ צװײַג פֿון זײַנע װאָרצלען װעט שפּראָצן.<verse eid="ISA 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 11:2" />און רוען װעט אױף אים דער גײַסט פֿון ה׳,</para>
  <para style="q" vid="ISA 11:2">דער גײַסט פֿון חכמה און פֿאַרשטאַנדיקײט,</para>
  <para style="q" vid="ISA 11:2">דער גײַסט פֿון עצה און גבֿורה,</para>
  <para style="q" vid="ISA 11:2">דער גײַסט פֿון דערקענונג און גאָצפֿאָרכטיקײט.<verse eid="ISA 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 11:3" />און זײַן קװיקונג װעט זײַן אין פֿאָרכט פֿון ה׳;</para>
  <para style="q" vid="ISA 11:3">און נישט נאָך דער אױסזען פֿון זײַנע אױגן װעט ער משפּטן,</para>
  <para style="q" vid="ISA 11:3">און נישט נאָך דער הערונג פֿון זײַנע אױערן װעט ער אַנטשײדן;<verse eid="ISA 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 11:4" />נאָר ער װעט משפּטן מיט גערעכטיקײט די אָרימע,</para>
  <para style="q" vid="ISA 11:4">און אַנטשײדן מיט יושר פֿאַר די געדריקטע פֿון לאַנד;</para>
  <para style="q" vid="ISA 11:4">און ער װעט שלאָגן דאָס לאַנד מיט דער רוט פֿון זײַן מױל,</para>
  <para style="q" vid="ISA 11:4">און מיטן אָטעם פֿון זײַנע ליפּן װעט ער טײטן דעם רשע.<verse eid="ISA 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 11:5" />און גערעכטיקײט װעט זײַן דער אָנגורט פֿון זײַנע לענדן,</para>
  <para style="q" vid="ISA 11:5">און טרײַשאַפֿט דער גאַרטל פֿון זײַנע דיכן.<verse eid="ISA 11:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 11:6" />און אַ װאָלף װעט הױזן מיט אַ שעפּס,</para>
  <para style="q" vid="ISA 11:6">און אַ לעמפּערט מיט אַ ציקעלע װעט הױערן,</para>
  <para style="q" vid="ISA 11:6">און אַ קאַלב און אַ יונגלײב און אַ פֿעט רינד בײַנאַנד;</para>
  <para style="q" vid="ISA 11:6">און אַ קלײן ייִנגל װעט זײ פֿירן.<verse eid="ISA 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 11:7" />און אַ קו מיט אַ בער װעלן זיך פֿיטערן,</para>
  <para style="q" vid="ISA 11:7">בײַנאַנד װעלן הױערן זײערע יונגע;</para>
  <para style="q" vid="ISA 11:7">און אַ לײב װעט װי אַ רינד עסן שטרױ.<verse eid="ISA 11:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 11:8" />און אַ זױגעדיקער װעט זיך שפּילן</para>
  <para style="q" vid="ISA 11:8">אױפֿן לאָך פֿון אַ שלאַנג,</para>
  <para style="q" vid="ISA 11:8">און אױף דער נאָרע פֿון אַ נאָטער</para>
  <para style="q" vid="ISA 11:8">װעט אַן אַנטװױנטער זײַן האַנט לײגן.<verse eid="ISA 11:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 11:9" />זײ װעלן נישט בײז טאָן און נישט פֿאַרדאַרבן</para>
  <para style="q" vid="ISA 11:9">אױף מײַן גאַנצן הײליקן באַרג;</para>
  <para style="q" vid="ISA 11:9">װאָרעם די ערד װעט זײַן פֿול מיט דערקענונג פֿון ה׳,</para>
  <para style="q" vid="ISA 11:9">װי די װאַסערן באַדעקן דעם ים.<verse eid="ISA 11:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="ISA 11:10" />און עס װעט זײַן אין יענעם טאָג: דער װאָרצל פֿון יִשַי, װאָס שטײט פֿאַר אַ פֿאָן פֿון די פֿעלקער – צו אים װעלן די אומות זיך װענדן, און זײַן רוּונג װעט זײַן אַ פּראַכטיקײט.<verse eid="ISA 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 11:11" />און עס װעט זײַן אין יענעם טאָג, װעט אֲדֹנָי װידער אױסשטרעקן זײַן האַנט, אַ צװײט מאָל, אױסצוקױפֿן דעם איבערבלײַב פֿון זײַן פֿאָלק, װאָס װעט בלײַבן פֿון אשור, און פֿון מִצרַיִם, און פֿון פַּתרוֹס, און פֿון כּוּש, און פֿון עֵילָם, און פֿון שִנעָר, און פֿון חַמָת, און פֿון די אינדזלען פֿון ים.<verse eid="ISA 11:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 11:12" />און ער װעט אױפֿהײבן אַ פֿאָן צו די פֿעלקער,</para>
  <para style="q" vid="ISA 11:12">און װעט אײַנזאַמלען די פֿאַרשטױסענע פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="ISA 11:12">און די צעשפּרײטע פֿון יהוּדה װעט ער אױפֿקלײַבן</para>
  <para style="q" vid="ISA 11:12">פֿון די פֿיר עקן פֿון דער ערד.<verse eid="ISA 11:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 11:13" />און אָפּגעטאָן װעט װערן די קנאה פֿון אפֿרים,</para>
  <para style="q" vid="ISA 11:13">און די פֿײַנט פֿון יהוּדה װעלן פֿאַרשניטן װערן;</para>
  <para style="q" vid="ISA 11:13">אפֿרים װעט נישט מקנא זײַן יהוּדה,</para>
  <para style="q" vid="ISA 11:13">און יהוּדה װעט נישט פֿײַנטן אפֿרים.<verse eid="ISA 11:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 11:14" />און זײ װעלן אָנפֿליִען בײַנאַנד אױף די פּלִשתּים צו מערבֿ,</para>
  <para style="q" vid="ISA 11:14">אין אײנעם װעלן זײ רױבן די קינדער פֿון מזרח,</para>
  <para style="q" vid="ISA 11:14">אױף אֶדוֹם און מוֹאָבֿ װעלן זײ שטרעקן זײער האַנט,</para>
  <para style="q" vid="ISA 11:14">און די קינדער פֿון עַמוֹן װעלן געהאָרכן צו זײ.<verse eid="ISA 11:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 11:15" />און ה׳ װעט פֿאַרװיסטן די צונג פֿון דעם ים פֿון מִצרַיִם;</para>
  <para style="q" vid="ISA 11:15">און ער װעט פֿאָכן זײַן האַנט אױפֿן טײַך מיט זײַן הײסן װינט,</para>
  <para style="q" vid="ISA 11:15">און װעט אים צעשלאָגן אױף זיבן בעכן,</para>
  <para style="q" vid="ISA 11:15">און מאַכן מיט שיך אַריבערצושפּרײַזן.<verse eid="ISA 11:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 11:16" />און אַ װעג װעט זײַן פֿאַר דעם איבערבלײַב פֿון זײַן פֿאָלק,</para>
  <para style="q" vid="ISA 11:16">װאָס װעט בלײַבן פֿון אשור,</para>
  <para style="q" vid="ISA 11:16">אַזױ װי עס איז געװען פֿאַר יִשׂרָאֵל</para>
  <para style="q" vid="ISA 11:16">אין טאָג פֿון זײַן אַרױפֿגײן פֿון לאַנד מִצרַיִם.<verse eid="ISA 11:16" /></para>
  <chapter eid="ISA 11" />
  <chapter number="12" style="c" pubnumber="יב" sid="ISA 12" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 12:1" />און װעסט זאָגן אין יענעם טאָג:</para>
  <para style="q" vid="ISA 12:1">איך דאַנק דיר, ה׳,</para>
  <para style="q" vid="ISA 12:1">הגם דו האָסט געצערנט אױף מיר;</para>
  <para style="q" vid="ISA 12:1">אָפּגעגאַנגען איז דײַן כּעס,</para>
  <para style="q" vid="ISA 12:1">און דו האָסט מיך געטרײסט.<verse eid="ISA 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 12:2" />זע, אֵל איז מײַן ישועה;</para>
  <para style="q" vid="ISA 12:2">איך בין זיכער און אַנגסט נישט,</para>
  <para style="q" vid="ISA 12:2">װאָרעם מײַן שטאַרקײט און געזאַנג איז ג-ט ה׳,</para>
  <para style="q" vid="ISA 12:2">און ער איז מיר געװען אַ ישועה.<verse eid="ISA 12:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="ISA 12:3" />און איר װעט שעפּן װאַסער מיט שׂימחה, פֿון די קװאַלן פֿון ישועה. <verse eid="ISA 12:3" /><verse number="4" style="v" sid="ISA 12:4" />און אין יענעם טאָג װעט איר זאָגן:</para>
  <para style="b" vid="ISA 12:4" />
  <para style="q" vid="ISA 12:4">דאַנקט צו ה׳, רופֿט אױס זײַן נאָמען,</para>
  <para style="q" vid="ISA 12:4">לאָזט װיסן צװישן די פֿעלקער זײַנע טוּונגען,</para>
  <para style="q" vid="ISA 12:4">דערצײלט אַז דערהױבן איז זײַן נאָמען.<verse eid="ISA 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 12:5" />זינגט צו ה׳ װאָרעם ער האָט אױפֿגעטאָן גרױס,</para>
  <para style="q" vid="ISA 12:5">באַװוּסט זאָל דאָס זײַן אױף דער גאַנצער ערד.<verse eid="ISA 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 12:6" />שרײַ אױס און זינג, באַװױנערין פֿון צִיוֹן,</para>
  <para style="q" vid="ISA 12:6">װאָרעם גרױס צװישן דיר איז דער הײליקער פֿון יִשׂרָאֵל.<verse eid="ISA 12:6" /></para>
  <chapter eid="ISA 12" />
  <chapter number="13" style="c" pubnumber="יג" sid="ISA 13" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1" />די נבֿואה אױף בָבֿל, װאָס ישַעיָהו דער זון פֿון אָמוצן האָט געזען:<verse eid="ISA 13:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 13:2" />אױף אַ הױכן באַרג שטעלט אױף אַ פֿאָן,</para>
  <para style="q" vid="ISA 13:2">הײבט אױף דעם קֹול צו זײ,</para>
  <para style="q" vid="ISA 13:2">פֿאָכט מיט דער האַנט,</para>
  <para style="q" vid="ISA 13:2">זײ זאָלן קומען אין די טױערן פֿון פֿירשטן.<verse eid="ISA 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 13:3" />איך האָב באַפֿױלן מײַנע געהײליקטע,</para>
  <para style="q" vid="ISA 13:3">יאָ, גערופֿן מײַנע גיבוֹרים פֿאַר מײַן צאָרן,</para>
  <para style="q" vid="ISA 13:3">מײַנע שטאָלצלוסטיקע.<verse eid="ISA 13:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 13:4" />האָרך! אַ טומל אױף די בערג,</para>
  <para style="q" vid="ISA 13:4">גלײַך װי פֿון פֿאָלק אַ סך.</para>
  <para style="q" vid="ISA 13:4">האָרך! אַ גערױש פֿון מלוכות, פֿון אומות פֿאַרזאַמלטע.</para>
  <para style="q" vid="ISA 13:4">ה׳ צבָֿאוֹת באַפֿעלט אַ חיל פֿון מלחמה.<verse eid="ISA 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 13:5" />זײ קומען פֿון אַ לאַנד אַ װײַטן,</para>
  <para style="q" vid="ISA 13:5">פֿון עק פֿונעם הימל –</para>
  <para style="q" vid="ISA 13:5">ה׳ און די געצײַג פֿון זײַן צאָרן,</para>
  <para style="q" vid="ISA 13:5">די גאַנצע ערד צו צעשטערן.<verse eid="ISA 13:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 13:6" />יאָמערט, װאָרעם נאָנט איז דער טאָג פֿון ה׳,</para>
  <para style="q" vid="ISA 13:6">װי אַ בראָך פֿון שַדַי װעט ער קומען.<verse eid="ISA 13:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 13:7" />דערום װעלן אַלע הענט שלאַף װערן,</para>
  <para style="q" vid="ISA 13:7">און איטלעך האַרץ פֿון אַ מענטשן װעט צעגײן.<verse eid="ISA 13:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 13:8" />און זײ װעלן דערשראָקן װערן;</para>
  <para style="q" vid="ISA 13:8">יסורים און װײען װעלן זײ קריגן,</para>
  <para style="q" vid="ISA 13:8">װי אַ געװינערין װעלן זײ זיך דרײען;</para>
  <para style="q" vid="ISA 13:8">אײנער אױפֿן אַנדערן װעלן זײ גאַפֿן,</para>
  <para style="q" vid="ISA 13:8">זײערע פּנימער, פּנימער פֿון פֿלאַמען.<verse eid="ISA 13:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 13:9" />זע, דער טאָג פֿון ה׳ קומט,</para>
  <para style="q" vid="ISA 13:9">אומדערבאַרעמדיק מיט כּעס און גרימצאָרן,</para>
  <para style="q" vid="ISA 13:9">צו מאַכן די ערד פֿאַר אַ װיסטעניש,</para>
  <para style="q" vid="ISA 13:9">און פֿאַרטיליקן אירע זינדיקע פֿון איר.<verse eid="ISA 13:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 13:10" />װאָרעם די שטערן פֿון הימל און זײַנע מזלות</para>
  <para style="q" vid="ISA 13:10">װעלן נישט שײַנען זײער ליכט;</para>
  <para style="q" vid="ISA 13:10">די זון װעט זײַן פֿינצטער אין איר אױפֿגאַנג,</para>
  <para style="q" vid="ISA 13:10">און די לבֿנה װעט נישט שימערן איר ליכט.<verse eid="ISA 13:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 13:11" />און איך װעל זיך רעכענען מיט דער װעלט פֿאַרן בײז,</para>
  <para style="q" vid="ISA 13:11">און מיט די רשעים פֿאַר זײער זינד;</para>
  <para style="q" vid="ISA 13:11">און איך װעל פֿאַרשטערן דעם שטאָלץ פֿון די מוטװיליקע,</para>
  <para style="q" vid="ISA 13:11">און די גאװה פֿון די מאַכטיקע װעל איך דערנידערן.<verse eid="ISA 13:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 13:12" />איך װעל מאַכן אַ מאַן זעלטענער פֿון גינגאָלד,</para>
  <para style="q" vid="ISA 13:12">און אַ מענטשן, פֿון אוֹפֿיר-גאָלד.<verse eid="ISA 13:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 13:13" />װעגן דעם װעל איך מאַכן ציטערן די הימלען,</para>
  <para style="q" vid="ISA 13:13">און די ערד װעט אױפֿשטורעמען פֿון איר אָרט,</para>
  <para style="q" vid="ISA 13:13">אין דעם כּעס פֿון ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ISA 13:13">און אין דעם טאָג פֿון זײַן גרימצאָרן.<verse eid="ISA 13:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 13:14" />און עס װעט זײַן: אַזױ װי אַ הירש אַ געיאָגטער,</para>
  <para style="q" vid="ISA 13:14">און אַזױ װי שאָף אָן אַן אײַנזאַמלער,</para>
  <para style="q" vid="ISA 13:14">װעלן זײ איטלעכער צו זײַן פֿאָלק זיך קערן,</para>
  <para style="q" vid="ISA 13:14">און איטלעכער צו זײַן לאַנד װעלן זײ אַנטלױפֿן.<verse eid="ISA 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 13:15" />איטלעכער װאָס װערט געפֿונען,</para>
  <para style="q" vid="ISA 13:15">װעט דערשטאָכן װערן,</para>
  <para style="q" vid="ISA 13:15">און איטלעכער װאָס װערט געכאַפּט,</para>
  <para style="q" vid="ISA 13:15">װעט פֿאַלן דורכן שװערד.<verse eid="ISA 13:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 13:16" />און זײערע קלײנע קינדער װעלן צעהאַקט װערן</para>
  <para style="q" vid="ISA 13:16">פֿאַר זײערע אױגן;</para>
  <para style="q" vid="ISA 13:16">זײערע הײַזער װעלן צערױבט װערן,</para>
  <para style="q" vid="ISA 13:16">און זײערע װײַבער װעלן געשענדט װערן.<verse eid="ISA 13:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 13:17" />זע, איך דערװעק אױף זײ מָדַי,</para>
  <para style="q" vid="ISA 13:17">װאָס זילבער אַכטן זײ נישט,</para>
  <para style="q" vid="ISA 13:17">און גאָלד, דאָס װילן זײ נישט.<verse eid="ISA 13:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 13:18" />און בױגנס װעלן צעהאַקן ייִנגלעך,</para>
  <para style="q" vid="ISA 13:18">און אױף פֿרוכט פֿון לײַב װעלן זײ נישט רַחמָנות האָבן,</para>
  <para style="q" vid="ISA 13:18">אױף קינדער װעט זיך נישט דערבאַרעמען זײער אױג.<verse eid="ISA 13:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 13:19" />און בָבֿל, דאָס שײנדל פֿון מלוכות,</para>
  <para style="q" vid="ISA 13:19">די שטאָלצע פּראַכט פֿון די כַּשׂדים,</para>
  <para style="q" vid="ISA 13:19">װעט זײַן װי ג-טס איבערקערעניש</para>
  <para style="q" vid="ISA 13:19">פֿון סדוֹם און עַמוֹרָה.<verse eid="ISA 13:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 13:20" />זי װעט אײביק נישט באַזעצט װערן,</para>
  <para style="q" vid="ISA 13:20">און נישט באַװױנט זײַן אױף דור-דורות;</para>
  <para style="q" vid="ISA 13:20">און קײן אַראַבער װעט דאָרט נישט אױפֿשטעלן אַ געצעלט,</para>
  <para style="q" vid="ISA 13:20">און קײן פּאַסטוכער װעלן דאָרט נישט מאַכן הױערן.<verse eid="ISA 13:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 13:21" />נאָר װילדע קעץ װעלן דאָרטן הױערן,</para>
  <para style="q" vid="ISA 13:21">און זײערע הײַזער װעלן פֿול זײַן מיט קלאָג-חיות;</para>
  <para style="q" vid="ISA 13:21">און שטרױספֿױגלען װעלן דאָרט רוען,</para>
  <para style="q" vid="ISA 13:21">און שֵדים װעלן דאָרט אומטאַנצן.<verse eid="ISA 13:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 13:22" />און שאַקאַלן װעלן װױען אין זײערע פּאַלאַצן</para>
  <para style="q" vid="ISA 13:22">און מדבר-הינט אין די פּאַלײַען פֿון תּענוג;</para>
  <para style="q" vid="ISA 13:22">און נאָנט איז איר צײַט צו קומען,</para>
  <para style="q" vid="ISA 13:22">און אירע טעג װעלן זיך נישט פֿאַרציִען.<verse eid="ISA 13:22" /></para>
  <chapter eid="ISA 13" />
  <chapter number="14" style="c" pubnumber="יד" sid="ISA 14" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 14:1" />װאָרעם ה׳ װעט דערבאַרעמען יעקבֿ, און װעט װידער אױסדערװײלן יִשׂרָאֵל, און זײ באַרוען אױף זײער ערד; און פֿרעמדע װעלן זיך באַהעפֿטן צו זײ, און װעלן צושטײן צום הױז פֿון יעקבֿ. <verse eid="ISA 14:1" /><verse number="2" style="v" sid="ISA 14:2" />און פֿעלקער װעלן זײ נעמען, און װעלן זײ ברענגען אױף זײער אָרט, און דאָס הױז פֿון יִשׂרָאֵל װעט זײ אַרבן אױף ה׳ס ערד פֿאַר קנעכט און פֿאַר דינסטן; און זײ װעלן װערן די פֿאַנגערס פֿון זײערע פֿאַנגערס, און װעלן געװעלטיקן איבער זײערע דריקער.<verse eid="ISA 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3" />און עס װעט זײַן, אין דעם טאָג װאָס ה׳ באַרוט דיך פֿון דײַן פּײַן און פֿון דײַן ציטערניש, און פֿון דער שװערער אַרבעט װאָס מע האָט געאַרבעט מיט דיר, <verse eid="ISA 14:3" /><verse number="4" style="v" sid="ISA 14:4" />װעסטו אױפֿהײבן דעם דאָזיקן משל אױפֿן מלך פֿון בָבֿל, און זאָגן:</para>
  <para style="b" vid="ISA 14:4" />
  <para style="q" vid="ISA 14:4">װי האָט אױפֿגעהערט דער דריקער,</para>
  <para style="q" vid="ISA 14:4">אױפֿגעהערט די גאָלדגײציקע!<verse eid="ISA 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 14:5" />צעבראָכן האָט ה׳ דעם שטעקן פֿון די רשעים,</para>
  <para style="q" vid="ISA 14:5">די רוט פֿון די געװעלטיקער,<verse eid="ISA 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 14:6" />װאָס האָט געשלאָגן די פֿעלקער מיט כּעס,</para>
  <para style="q" vid="ISA 14:6">שלעק אָן אַן אױפֿהער,</para>
  <para style="q" vid="ISA 14:6">װאָס האָט געװעלטיקט מיט צאָרן אױף די אומות,</para>
  <para style="q" vid="ISA 14:6">גערודפֿט אָן אָפּהאַלט.<verse eid="ISA 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 14:7" />רויִק באַרוט איז די גאַנצע ערד,</para>
  <para style="q" vid="ISA 14:7">זײ ברעכן אױס אין געזאַנג.<verse eid="ISA 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 14:8" />אַפֿילו די ציפּרעסן פֿרײען זיך איבער דיר,</para>
  <para style="q" vid="ISA 14:8">די צעדערן פֿון לבֿנוֹן:</para>
  <para style="q" vid="ISA 14:8">פֿון זינט דו האָסט זיך אַװעקגעלײגט,</para>
  <para style="q" vid="ISA 14:8">קומט נישט דער העקער אױף אונדז.<verse eid="ISA 14:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 14:9" />די שְׁאֹול פֿון אונטן ציטערט אױף צוליב דיר,</para>
  <para style="q" vid="ISA 14:9">אַנטקעגן דײַן קומען;</para>
  <para style="q" vid="ISA 14:9">זי װעקט די טױטע צוליב דיר,</para>
  <para style="q" vid="ISA 14:9">אַלע האַרן פֿון דער ערד;</para>
  <para style="q" vid="ISA 14:9">זי מאַכט אױפֿשטײן פֿון זײערע טראָנען</para>
  <para style="q" vid="ISA 14:9">אַלע מלכים פֿון די פֿעלקער.<verse eid="ISA 14:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 14:10" />זײ אַלע רופֿן זיך אָפּ, און זאָגן צו דיר:</para>
  <para style="q" vid="ISA 14:10">דו אױך ביסט אַװעקגעפֿאַלן װי מיר,</para>
  <para style="q" vid="ISA 14:10">געגליכן געװאָרן צו אונדז!<verse eid="ISA 14:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 14:11" />גענידערט אין שְׁאֹול איז דײַן שטאָלץ,</para>
  <para style="q" vid="ISA 14:11">די ברומונג פֿון דײַנע האַרפֿן;</para>
  <para style="q" vid="ISA 14:11">אונטער דיר זײַנען װערעם געבעט,</para>
  <para style="q" vid="ISA 14:11">און דײַן צודעק איז װערעם.<verse eid="ISA 14:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 14:12" />װי ביסטו פֿון הימל געפֿאַלן,</para>
  <para style="q" vid="ISA 14:12">דו ליכטיקער מאָרגנשטערן!</para>
  <para style="q" vid="ISA 14:12">װי ביסטו אָפּגעהאַקט געװאָרן צו דער ערד,</para>
  <para style="q" vid="ISA 14:12">דו גורל-װאַרפֿער אױף פֿעלקער!<verse eid="ISA 14:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 14:13" />און דו האָסט געזאָגט אין דײַן האַרצן:</para>
  <para style="q" vid="ISA 14:13">אין הימל װעל איך אַרױפֿגײן,</para>
  <para style="q" vid="ISA 14:13">איבער די שטערן פֿון אֵל</para>
  <para style="q" vid="ISA 14:13">װעל איך מײַן טראָן דערהײבן;</para>
  <para style="q" vid="ISA 14:13">און איך װעל זיצן אױפֿן באַרג פֿון אײַנזאַמלונג,</para>
  <para style="q" vid="ISA 14:13">אין די עקן פֿון צפֿון.<verse eid="ISA 14:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 14:14" />איך װעל אַרױפֿגײן איבער די הײכן פֿון װאָלקן,</para>
  <para style="q" vid="ISA 14:14">איך װעל צום עליון זיך גלײַכן.<verse eid="ISA 14:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 14:15" />אָבער אין שְׁאֹול װעסטו גענידערט װערן,</para>
  <para style="q" vid="ISA 14:15">אין די עקן פֿון גרוב.<verse eid="ISA 14:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 14:16" />דײַנע זעער װעלן דיך באַטראַכטן,</para>
  <para style="q" vid="ISA 14:16">זײ װעלן דיך אָנקוקן:</para>
  <para style="q" vid="ISA 14:16">איז דאָס דער מאַן װאָס האָט געמאַכט ציטערן די ערד,</para>
  <para style="q" vid="ISA 14:16">װאָס האָט אױפֿגעשטורעמט מלוכות,<verse eid="ISA 14:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 14:17" />געמאַכט די װעלט װי אַ מדבר,</para>
  <para style="q" vid="ISA 14:17">און צעשטערט אירע שטעט;</para>
  <para style="q" vid="ISA 14:17">זײַנע געפֿאַנגענע נישט פֿרײַ געלאָזט אַהײם?<verse eid="ISA 14:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 14:18" />אַלע מלכים פֿון די פֿעלקער ליגן אין כּבֿוד אַלע,</para>
  <para style="q" vid="ISA 14:18">איטלעכער אין זײַן הײם.<verse eid="ISA 14:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 14:19" />און דו ביסט אַװעקגעװאָרפֿן װײַט פֿון דײַן קבֿר,</para>
  <para style="q" vid="ISA 14:19">װי אַן אומװערדיק ריטל,</para>
  <para style="q" vid="ISA 14:19">אַרומגעטאָן מיט הרוּגים, פֿון שװערד דערשטאָכענע,</para>
  <para style="q" vid="ISA 14:19">װאָס נידערן צו די שטײנער פֿון גרוב,</para>
  <para style="q" vid="ISA 14:19">װי אַ פּגר אַ צעטרעטענער.<verse eid="ISA 14:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 14:20" />װעסט נישט בײַנאַנד זײַן מיט זײ אין קבֿר,</para>
  <para style="q" vid="ISA 14:20">װאָרעם דײַן לאַנד האָסטו אומגעבראַכט,</para>
  <para style="q" vid="ISA 14:20">דײַן פֿאָלק האָסטו געהרגעט;</para>
  <para style="q" vid="ISA 14:20">אױף אײביק זאָל נישט אָנגערופֿן װערן</para>
  <para style="q" vid="ISA 14:20">דער זאָמען פֿון שלעכטסטוער.<verse eid="ISA 14:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 14:21" />ברײט אָן אױף זײַנע קינדער אַ שחיטה,</para>
  <para style="q" vid="ISA 14:21">פֿאַר דער זינד פֿון זײערע עלטערן,</para>
  <para style="q" vid="ISA 14:21">זײ זאָלן נישט אױפֿשטײן און יַרשען די ערד,</para>
  <para style="q" vid="ISA 14:21">און אָנפֿילן דאָס געזיכט פֿון דער װעלט מיט שטעט.<verse eid="ISA 14:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 14:22" />און איך װעל אױפֿשטײן אױף זײ,</para>
  <para style="q" vid="ISA 14:22">זאָגט ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ISA 14:22">און װעל פֿאַרשנײַדן פֿון בָבֿל אַ נאָמען און אַן איבערבלײַב,</para>
  <para style="q" vid="ISA 14:22">און אַ קינד און אַ קינדסקינד, זאָגט ה׳.<verse eid="ISA 14:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 14:23" />און איך װעל זײ מאַכן צום אַרב פֿאַרן זומפּבושל,</para>
  <para style="q" vid="ISA 14:23">און געמױזעכצן װאַסער;</para>
  <para style="q" vid="ISA 14:23">און איך װעל זײ אַװעקבעזעמען מיטן בעזעם פֿון פֿאַרטיליקונג,</para>
  <para style="q" vid="ISA 14:23">זאָגט ה׳ צבָֿאוֹת.<verse eid="ISA 14:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 14:24" />געשװאָרן האָט ה׳ צבָֿאוֹת, אַזױ צו זאָגן:</para>
  <para style="q" vid="ISA 14:24">פֿאַר װאָר, װי איך האָב געטראַכט, אַזױ װעט געשען,</para>
  <para style="q" vid="ISA 14:24">און װי איך האָב באַראָטן, דאָס װעט באַשטײן:<verse eid="ISA 14:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 14:25" />איך זאָל צעברעכן אשור אין מײַן לאַנד,</para>
  <para style="q" vid="ISA 14:25">און אױף מײַנע בערג אים צעטרעטן;</para>
  <para style="q" vid="ISA 14:25">און אָפּגעטאָן זאָל װערן פֿון זײ זײַן יאָך,</para>
  <para style="q" vid="ISA 14:25">און זײַן לאַסט זאָל אָפּגעטאָן װערן פֿון זײער רוקן.<verse eid="ISA 14:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 14:26" />דאָס איז דער באַראָט װאָס איז באַראָטן</para>
  <para style="q" vid="ISA 14:26">אױף דער גאַנצער ערד,</para>
  <para style="q" vid="ISA 14:26">און דאָס איז די האַנט</para>
  <para style="q" vid="ISA 14:26">װאָס איז אױסגעשטרעקט אױף אַלע פֿעלקער.<verse eid="ISA 14:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 14:27" />װאָרעם ה׳ צבָֿאוֹת האָט באַראָטן,</para>
  <para style="q" vid="ISA 14:27">און װער װעט פֿאַרשטערן?</para>
  <para style="q" vid="ISA 14:27">און זײַן האַנט איז אױסגעשטרעקט</para>
  <para style="q" vid="ISA 14:27">און װער װעט זי אָפּהאַלטן?<verse eid="ISA 14:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="ISA 14:28" />אין דעם יאָר װאָס דער מלך אָחָז איז געשטאָרבן, איז געװען די דאָזיקע נבֿואה:<verse eid="ISA 14:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="ISA 14:29" />נישט פֿרײט זיך גאַנץ פּלֶשֶת,</para>
  <para style="q" vid="ISA 14:29">װאָס די רוט פֿון דײַן שלעגער איז צעבראָכן;</para>
  <para style="q" vid="ISA 14:29">װאָרעם פֿון װאָרצל פֿון דער שלאַנג װעט אַרױס אַ נאָטער,</para>
  <para style="q" vid="ISA 14:29">און זײַן פֿרוכט איז אַ פֿליִעדיקער לינדװאָרעם.<verse eid="ISA 14:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 14:30" />און די אָרימסטע פֿון די אָרימע װעלן זיך פֿיטערן,</para>
  <para style="q" vid="ISA 14:30">און די באַדערפֿטיקע װעלן הױערן אין זיכערקײט;</para>
  <para style="q" vid="ISA 14:30">און איך װעל טײטן מיט הונגער דײַן װאָרצל,</para>
  <para style="q" vid="ISA 14:30">און דײַן איבערבלײַב װעט מען אױסהרגען.<verse eid="ISA 14:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 14:31" />יאָמער, דו טױער, שרײַ, דו שטאָט,</para>
  <para style="q" vid="ISA 14:31">װער צעגאַנגען, גאַנץ פּלֶשֶת,</para>
  <para style="q" vid="ISA 14:31">װאָרעם פֿון צפֿון קומט אַ רױך,</para>
  <para style="q" vid="ISA 14:31">און נישטאָ קײן אָפּגעשטאַנענער אין זײַנע מחנות.<verse eid="ISA 14:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="ISA 14:32" />און װאָס זאָל מען ענטפֿערן די שלוחים פֿון דעם פֿאָלק? –</para>
  <para style="q" vid="ISA 14:32">אַז ה׳ האָט געגרונטפֿעסט צִיוֹן,</para>
  <para style="q" vid="ISA 14:32">און אין איר װעלן זיך שיצן די אָרימע פֿון זײַן פֿאָלק.<verse eid="ISA 14:32" /></para>
  <chapter eid="ISA 14" />
  <chapter number="15" style="c" pubnumber="טו" sid="ISA 15" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 15:1" />די נבֿואה אױף מוֹאָבֿ:</para>
  <para style="b" vid="ISA 15:1" />
  <para style="q" vid="ISA 15:1">פֿאַר װאָר, איבער נאַכט איז פֿאַרװיסט געװאָרן עָר-מואָבֿ,</para>
  <para style="q" vid="ISA 15:1">פֿאַרשניטן געװאָרן;</para>
  <para style="q" vid="ISA 15:1">פֿאַר װאָר, איבער נאַכט איז פֿאַרװיסט געװאָרן קיר-מואָבֿ,</para>
  <para style="q" vid="ISA 15:1">פֿאַרשניטן געװאָרן.<verse eid="ISA 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 15:2" />ער איז אַרױפֿגעגאַנגען קײן בַיִת און דיבֿוֹן,</para>
  <para style="q" vid="ISA 15:2">אױף די בָמות צו װײנען;</para>
  <para style="q" vid="ISA 15:2">אױף נבֿוֹ און אױף מֵידבֿאָ טוט יאָמערן מוֹאָבֿ;</para>
  <para style="q" vid="ISA 15:2">אױף אַלע זײַנע קעפּ איז אַ פּליך,</para>
  <para style="q" vid="ISA 15:2">יעטװעדער באָרד איז אָפּגעשניטן.<verse eid="ISA 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 15:3" />אין זײַנע גאַסן גורט מען אָן זאַק;</para>
  <para style="q" vid="ISA 15:3">אױף אירע דעכער און אין אירע מערק,</para>
  <para style="q" vid="ISA 15:3">טוט איטלעכער יאָמערן, צעגײט אין געװײן.<verse eid="ISA 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 15:4" />און קלאָגן טוט חֶשבוֹן און אֶלעָלֵה,</para>
  <para style="q" vid="ISA 15:4">ביז יַהַץ װערט געהערט זײער קֹול;</para>
  <para style="q" vid="ISA 15:4">דערום שרײַען די באַװאָפֿנטע פֿון מוֹאָבֿ;</para>
  <para style="q" vid="ISA 15:4">זײַן זעל טוט אים ציטערן.<verse eid="ISA 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 15:5" />מײַן האַרץ אױף מוֹאָבֿ טוט קלאָגן,</para>
  <para style="q" vid="ISA 15:5">אירע אַנטלאָפֿענע גרײכן ביז צוֹעַר,</para>
  <para style="q" vid="ISA 15:5">דער עגלת־שלישיה;</para>
  <para style="q" vid="ISA 15:5">װאָרעם דער אַרױפֿגאַנג פֿון לוחית,</para>
  <para style="q" vid="ISA 15:5">אים גײט מען אַרױף מיט געװײן;</para>
  <para style="q" vid="ISA 15:5">װאָרעם אױף דעם װעג פֿון חוֹרוֹנַיִם</para>
  <para style="q" vid="ISA 15:5">אַ בראָכגעשרײ הײבן זײ אױף.<verse eid="ISA 15:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 15:6" />װאָרעם די װאַסערן פֿון נִמרים װעלן אַ װיסטעניש װערן;</para>
  <para style="q" vid="ISA 15:6">װאָרעם פֿאַרדאַרט איז דאָס קרײַטעכץ,</para>
  <para style="q" vid="ISA 15:6">פֿאַרלענדט איז דאָס גראָז,</para>
  <para style="q" vid="ISA 15:6">קײן גרינס איז נישטאָ.<verse eid="ISA 15:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 15:7" />דערום, די שפֿע װאָס זײ האָבן אָנגעזאַמלט,</para>
  <para style="q" vid="ISA 15:7">און דאָס װאָס זײ האָבן באַהאַלטן,</para>
  <para style="q" vid="ISA 15:7">װעלן זײ צום טײַך פֿון די װערבעס אַװעקטראָגן.<verse eid="ISA 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 15:8" />װאָרעם דאָס געשרײ האָט אַרומגערינגלט</para>
  <para style="q" vid="ISA 15:8">דעם געמאַרק פֿון מוֹאָבֿ;</para>
  <para style="q" vid="ISA 15:8">ביז אֶגלַיִם גײט איר יללה.</para>
  <para style="q" vid="ISA 15:8">און ביז באֵר-אֵלים, איר יללה.<verse eid="ISA 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 15:9" />װאָרעם די װאַסערן פֿון דימון זײַנען פֿול מיט בלוט;</para>
  <para style="q" vid="ISA 15:9">װאָרעם איך װעל דימון נאָך געבן אַ צולאָג:</para>
  <para style="q" vid="ISA 15:9">אַ לײב פֿאַר די אַנטרונענע פֿון מוֹאָבֿ,</para>
  <para style="q" vid="ISA 15:9">און פֿאַר דעם איבערבלײַב פֿון לאַנד.<verse eid="ISA 15:9" /></para>
  <chapter eid="ISA 15" />
  <chapter number="16" style="c" pubnumber="טז" sid="ISA 16" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 16:1" />שיקט לעמער צום געװעלטיקער פֿון לאַנד,</para>
  <para style="q" vid="ISA 16:1">פֿון די פֿעלדזן װאָס צום מדבר,</para>
  <para style="q" vid="ISA 16:1">צום באַרג פֿון טאָכטער צִיוֹן.<verse eid="ISA 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 16:2" />און עס װעט זײַן:</para>
  <para style="q" vid="ISA 16:2">װי אַ פֿױגל אַ פֿאַרװאָגלטער, װי אַ נעסט אַ צעטריבענער,</para>
  <para style="q" vid="ISA 16:2">װעלן זײַן די טעכטער פֿון מוֹאָבֿ,</para>
  <para style="q" vid="ISA 16:2">בײַ די איבערפֿאָרן פֿון אַרנוֹן.<verse eid="ISA 16:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 16:3" />נעם אײן עצה, טהואַ משפּט;</para>
  <para style="q" vid="ISA 16:3">מאַך דײַן שאָטן װי די נאַכט, אין מיטן העלן טאָג;</para>
  <para style="q" vid="ISA 16:3">פֿאַרבאָרג די פֿאַרשטױסענע,</para>
  <para style="q" vid="ISA 16:3">דעם פֿאַרװאָגלטן זאָלסטו נישט אַנטפּלעקן.<verse eid="ISA 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 16:4" />מײַנע פֿאַרשטױסענע זאָלן װױנען בײַ דיר – מוֹאָבֿ;</para>
  <para style="q" vid="ISA 16:4">זײַ זײ אַ פֿאַרבאָרגעניש פֿון דעם רױבער,</para>
  <para style="q" vid="ISA 16:4">ביז אַװעק איז די דריקונג,</para>
  <para style="q" vid="ISA 16:4">געענדיקט דער רױב,</para>
  <para style="q" vid="ISA 16:4">פֿאַרלענדט די צעטרעטער אױסן לאַנד;<verse eid="ISA 16:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 16:5" />װאָרעם אױפֿגעשטעלט אױף גענאָד איז דער טראָן,</para>
  <para style="q" vid="ISA 16:5">און אױף אים זיצט מיט אמת, אין דָוִדס געצעלט,</para>
  <para style="q" vid="ISA 16:5">אַ ריכטער װאָס זוכט רעכט,</para>
  <para style="q" vid="ISA 16:5">און איז גיך אױף גערעכטיקײט.<verse eid="ISA 16:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 16:6" />מיר האָבן געהערט די שטאָלצקײט פֿון מוֹאָבֿ,</para>
  <para style="q" vid="ISA 16:6">װי זײער שטאָלץ ער איז;</para>
  <para style="q" vid="ISA 16:6">זײַן גאװה און זײַן שטאָלצקײט און זײַן חוצפּה,</para>
  <para style="q" vid="ISA 16:6">זײַנע באַרימערײַען אָן אַ האַפֿט.<verse eid="ISA 16:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 16:7" />דערום װעט יאָמערן מוֹאָבֿ אױף מוֹאָבֿ,</para>
  <para style="q" vid="ISA 16:7">איטלעכער װעט יאָמערן;</para>
  <para style="q" vid="ISA 16:7">נאָך די ראָזינקעקוכנס פֿון קיר-חַרֶשֶׂת װעט איר זיפֿצן,</para>
  <para style="q" vid="ISA 16:7">אין גאַנצן דערשלאָגענע.<verse eid="ISA 16:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 16:8" />װאָרעם די פֿעלדער פֿון חֶשבוֹן זײַנען פֿאַרװעלקט,</para>
  <para style="q" vid="ISA 16:8">דער װײַנשטאָק פֿון שִׂבֿמָה,</para>
  <para style="q" vid="ISA 16:8">װאָס זײַנע רױטטרױבן האָבן פֿאַרטומלט די האַרן פֿון די פֿעלקער;</para>
  <para style="q" vid="ISA 16:8">ביז יַעְזֵר האָבן זײ דערגרײכט,</para>
  <para style="q" vid="ISA 16:8">ביזן מדבר האָבן זײ געװאַנדערט;</para>
  <para style="q" vid="ISA 16:8">אירע צװײַגן האָבן זיך צעשפּרײט,</para>
  <para style="q" vid="ISA 16:8">ביז צום ים זײַנען זײ אַריבער.<verse eid="ISA 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 16:9" />דערום באַװײן איך אין דעם געװײן פֿון יַעְזֵר,</para>
  <para style="q" vid="ISA 16:9">דעם װײַנשטאָק פֿון שִׂבֿמָה;</para>
  <para style="q" vid="ISA 16:9">איך טרינק דיך אָן מיט מײַנע טרערן,</para>
  <para style="q" vid="ISA 16:9">חֶשבוֹן און אֶלעָלֵה;</para>
  <para style="q" vid="ISA 16:9">װאָרעם אױף דײַן האַרבסטונג און אױף דײַן שניט</para>
  <para style="q" vid="ISA 16:9">איז אַ קריגגעשרײ געפֿאַלן.<verse eid="ISA 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 16:10" />און אײַנגעטאָן איז די פֿרײד</para>
  <para style="q" vid="ISA 16:10">און די לוסטיקײט פֿון דעם פֿרוכטגאָרטן;</para>
  <para style="q" vid="ISA 16:10">און אין די װײַנגערטנער װערט נישט געזונגען,</para>
  <para style="q" vid="ISA 16:10">װערט נישט געשאַלט;</para>
  <para style="q" vid="ISA 16:10">קײן װײַן אין די קעלטערן טרעט נישט דער טרעטער;</para>
  <para style="q" vid="ISA 16:10">איך האָב געמאַכט אױפֿהערן הֵידָד!<verse eid="ISA 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 16:11" />דערום ברומען װי אַ האַרף מײַנע געדערים אױף מוֹאָבֿ,</para>
  <para style="q" vid="ISA 16:11">און מײַנע אינגעװײד אױף קיר-חֶרֶשׂ.<verse eid="ISA 16:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="ISA 16:12" />און עס װעט זײַן, אַז עס װעט זיך אַרױסװײַזן אַז מוֹאָבֿ האָט זיך אומזיסט אײַנגעמיט אױף דער בָמָה, װעט ער אַרײַנגײן אין זײַן הײליקטום תּפֿילה טאָן, אָבער ער װעט גאָרנישט אױסריכטן.<verse eid="ISA 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 16:13" />דאָס איז דאָס װאָרט װאָס ה׳ האָט גערעדט אױף מוֹאָבֿ אַ מאָל. <verse eid="ISA 16:13" /><verse number="14" style="v" sid="ISA 16:14" />אָבער אַצונד האָט ה׳ גערעדט, אַזױ צו זאָגן: אין דרײַ יאָר, װי די יאָרן פֿון אַ געדונגענעם, װעט גרינגעשאַצט װערן דער כּבֿוד פֿון מוֹאָבֿ, בײַ אַל דעם גרױסן טומל; און דער איבערבלײַב װעט זײַן אַ קלײן װינציקײט אָן שטאַרקײט.<verse eid="ISA 16:14" /></para>
  <chapter eid="ISA 16" />
  <chapter number="17" style="c" pubnumber="יז" sid="ISA 17" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 17:1" />די נבֿואה אױף דַמֶשֶׂק:</para>
  <para style="b" vid="ISA 17:1" />
  <para style="q" vid="ISA 17:1">זע דַמֶשֶׂק װערט אױס שטאָט,</para>
  <para style="q" vid="ISA 17:1">און װעט װערן אַ חורבֿה-הױפֿן.<verse eid="ISA 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 17:2" />פֿאַרלאָזן די שטעט פֿון עַרוֹעֵר,</para>
  <para style="q" vid="ISA 17:2">פֿאַר סטאַדעס װעלן זײ זײַן;</para>
  <para style="q" vid="ISA 17:2">און זײ װעלן הױערן,</para>
  <para style="q" vid="ISA 17:2">און קײנער װעט נישט אָפּשרעקן.<verse eid="ISA 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 17:3" />און אָפּגעטאָן װעט װערן אַ פֿעסטונג פֿון אפֿרים,</para>
  <para style="q" vid="ISA 17:3">און אַ מלוכה פֿון דַמֶשֶׂק;</para>
  <para style="q" vid="ISA 17:3">און דער איבערבלײַב פֿון אַרָם</para>
  <para style="q" vid="ISA 17:3">װעט װערן װי די פּראַכט פֿון די קינדער פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="ISA 17:3">זאָגט ה׳ צבָֿאוֹת.<verse eid="ISA 17:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 17:4" />און עס װעט זײַן אין יענעם טאָג,</para>
  <para style="q" vid="ISA 17:4">װעט פֿאַראָרימט װערן די פּראַכט פֿון יעקבֿ,</para>
  <para style="q" vid="ISA 17:4">און די פֿעטקײט פֿון זײַן לײַב װעט אָפּגעצערט װערן.<verse eid="ISA 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 17:5" />און עס װעט זײַן װי אַ שניטער זאַמלט תּבֿואה,</para>
  <para style="q" vid="ISA 17:5">און שנײַדט מיט זײַן אָרעם די זאַנגען;</para>
  <para style="q" vid="ISA 17:5">און עס װעט זײַן װי מע קלײַבט זאַנגען</para>
  <para style="q" vid="ISA 17:5">אין טאָל פֿון רפֿאים.<verse eid="ISA 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 17:6" />נאָר אַ נאָכקלײַב װעט בלײַבן אױף אים,</para>
  <para style="q" vid="ISA 17:6">װי בײַם אָפּקלאַפּן אַן אײלבערטבױם,</para>
  <para style="q" vid="ISA 17:6">צװײ דרײַ פּערלעך אױבן בײַם שפּיץ,</para>
  <para style="q" vid="ISA 17:6">פֿיר פֿינף אױף זײַנע צװײַגן, אױב פֿרוכטיק,</para>
  <para style="q" vid="ISA 17:6">זאָגט ה׳, אלוקי יִשׂרָאֵל.<verse eid="ISA 17:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="ISA 17:7" />אין יענעם טאָג װעט דער מענטש זיך קערן צו זײַן באַשעפֿער, און זײַנע אױגן װעלן קוקן צום הײליקן פֿון יִשׂרָאֵל. <verse eid="ISA 17:7" /><verse number="8" style="v" sid="ISA 17:8" />און ער װעט זיך נישט קערן צו די מזבחות, די װערק פֿון זײַנע הענט, און נישט אָנקוקן װאָס זײַנע פֿינגער האָבן געמאַכט, און די געצנבײמער און די זונזײַלן. <verse eid="ISA 17:8" /><verse number="9" style="v" sid="ISA 17:9" />אין יענעם טאָג װעלן זײַנע פֿעסטע שטעט זײַן װי די פֿאַרלאָזנקײט פֿון די װעלדער און די באַרגשפּיצן, װאָס מע האָט פֿאַרלאָזן פֿון װעגן די קינדער פֿון יִשׂרָאֵל; און עס װעט זײַן אַ װיסטעניש.<verse eid="ISA 17:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 17:10" />װאָרעם האָסט פֿאַרגעסן דעם ג-ט פֿון דײַן הילף,</para>
  <para style="q" vid="ISA 17:10">און דעם פֿעלדז פֿון דײַן שטאַרקײט האָסטו נישט דערמאָנט;</para>
  <para style="q" vid="ISA 17:10">דערום האָסטו ליבלעכע פֿלאַנצן געפֿלאַנצט,</para>
  <para style="q" vid="ISA 17:10">און אַ פֿרעמדן צװײַג אײַנגעזעצט דרינען;<verse eid="ISA 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 17:11" />אין טאָג פֿון דײַן פֿלאַנצונג האָסט עס געמאַכט װאַקסן,</para>
  <para style="q" vid="ISA 17:11">און פֿרימאָרגנס האָסטו דײַן זאָמען געמאַכט בליִען –</para>
  <para style="q" vid="ISA 17:11">אַ הױפֿן ריטלעך אין טאָג פֿון שטאַרקע</para>
  <para style="q" vid="ISA 17:11">קראַנקשאַפֿט און װײטאָג.<verse eid="ISA 17:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 17:12" />װײ, די ברומונג פֿון פֿיל אומות,</para>
  <para style="q" vid="ISA 17:12">װאָס ברומען װי דאָס ברומען פֿון ימען;</para>
  <para style="q" vid="ISA 17:12">און די רױשונג פֿון פֿעלקער,</para>
  <para style="q" vid="ISA 17:12">װאָס רױשן װי די רױשונג פֿון מאַכטיקע װאַסערן!<verse eid="ISA 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 17:13" />די פֿעלקער רױשן װי די רױשונג פֿון פֿיל װאַסערן,</para>
  <para style="q" vid="ISA 17:13">אָבער ער װעט אָנשרײַען אױף זײ,</para>
  <para style="q" vid="ISA 17:13">און זײ װעלן אַנטלױפֿן אין דער װײַט,</para>
  <para style="q" vid="ISA 17:13">און געיאָגט װערן װי שפּרײ פֿון די בערג פֿאַרן װינט,</para>
  <para style="q" vid="ISA 17:13">און װי אַ שטױבראָד פֿאַרן שטורעם.<verse eid="ISA 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 17:14" />צו אָװנטצײַט, זע, אַ שרעקעניש!</para>
  <para style="q" vid="ISA 17:14">אײדער פֿרימאָרגן זײַנען זײ נישטאָ.</para>
  <para style="q" vid="ISA 17:14">דאָס איז דער חלק פֿון אונדזערע רױבער,</para>
  <para style="q" vid="ISA 17:14">און דער גורל פֿאַר אונדזערע אױסרױבער.<verse eid="ISA 17:14" /></para>
  <chapter eid="ISA 17" />
  <chapter number="18" style="c" pubnumber="יח" sid="ISA 18" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 18:1" />אָ, דאָס לאַנד פֿון פֿליגלזשומערײַ,</para>
  <para style="q" vid="ISA 18:1">װאָס פֿון יענער זײַט טײַכן פֿון כּוּש;<verse eid="ISA 18:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 18:2" />װאָס שיקט איבערן ים שלוחים,</para>
  <para style="q" vid="ISA 18:2">און אין שיפֿן פֿון יאַמש אױפֿן װאַסער!</para>
  <para style="q" vid="ISA 18:2">גײט, שלוחים פֿלינקע, צו דער הױכער און גלאַנציקער אומה,</para>
  <para style="q" vid="ISA 18:2">צו אַ פֿאָלק מוראדיק פֿון אײביק אָן,</para>
  <para style="q" vid="ISA 18:2">אַן אומה פֿון מאַכט און צעטרעטונג,</para>
  <para style="q" vid="ISA 18:2">װאָס טײַכן שנײַדן דורך איר לאַנד.<verse eid="ISA 18:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 18:3" />איר אַלע װױנער פֿון דער װעלט,</para>
  <para style="q" vid="ISA 18:3">און איר װאָס רוט אױף דער ערד,</para>
  <para style="q" vid="ISA 18:3">װען מע הײבט אױף אַ פֿאָן אױף די בערג, װעט איר זען,</para>
  <para style="q" vid="ISA 18:3">און װען מע בלאָזט אַ שופֿר, װעט איר הערן.<verse eid="ISA 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 18:4" />װאָרעם אַזױ האָט ה׳ געזאָגט צו מיר:</para>
  <para style="q" vid="ISA 18:4">איך װעל רויִק צוקוקן אין מײַן אָרט,</para>
  <para style="q" vid="ISA 18:4">װי קלאָרע היץ אין זונליכט,</para>
  <para style="q" vid="ISA 18:4">װי אַ טױװאָלקן אין דער היץ פֿון שניט.<verse eid="ISA 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 18:5" />װאָרעם פֿאַרן שניט, װען געענדיקט די בליִעכץ,</para>
  <para style="q" vid="ISA 18:5">און דער שפּראָץ װערט אַ װײַנטרױב װאָס צײַטיקט זיך,</para>
  <para style="q" vid="ISA 18:5">װעט ער אָפּשנײַדן די הענגלעך מיט צװײַגמעסערס,</para>
  <para style="q" vid="ISA 18:5">און די צװײַגן טוט ער אָפּ און װאַרפֿט אַװעק.<verse eid="ISA 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 18:6" />זײ װעלן איבערגעלאָזט װערן אין אײנעם</para>
  <para style="q" vid="ISA 18:6">פֿאַרן רױבפֿױגל פֿון די בערג,</para>
  <para style="q" vid="ISA 18:6">און פֿאַר דער חיה פֿון דער ערד;</para>
  <para style="q" vid="ISA 18:6">און װעט זומערן דערױף דער רױבפֿױגל,</para>
  <para style="q" vid="ISA 18:6">און איטלעך חיה פֿון דער ערד װעט דערױף װינטערן.<verse eid="ISA 18:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 18:7" />אין יענער צײַט װעט געבראַכט װערן</para>
  <para style="q" vid="ISA 18:7">אַ מתּנה צו ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ISA 18:7">פֿון דער הױכער און גלאַנציקער אומה,</para>
  <para style="q" vid="ISA 18:7">פֿון אַן אומה מוראדיק פֿון אײביק אָן,</para>
  <para style="q" vid="ISA 18:7">אַ פֿאָלק פֿון מאַכט און צעטרעטונג,</para>
  <para style="q" vid="ISA 18:7">װאָס טײַכן שנײַדן דורך זײַן לאַנד,</para>
  <para style="q" vid="ISA 18:7">צום אָרט פֿון דעם נאָמען פֿון ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ISA 18:7">צום באַרג צִיוֹן.<verse eid="ISA 18:7" /></para>
  <chapter eid="ISA 18" />
  <chapter number="19" style="c" pubnumber="יט" sid="ISA 19" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 19:1" />די נבֿואה אױף מִצרַיִם:</para>
  <para style="b" vid="ISA 19:1" />
  <para style="q" vid="ISA 19:1">זע, ה׳ רײַט אױף אַ װאָלקן אַ פֿלינקן,</para>
  <para style="q" vid="ISA 19:1">און ער קומט קײן מִצרַיִם;</para>
  <para style="q" vid="ISA 19:1">און די אָפּגעטער פֿון מִצרַיִם װעלן זיך טרײסלען פֿאַר אים,</para>
  <para style="q" vid="ISA 19:1">און דאָס האַרץ פֿון מִצרַיִם װעט צעגײן אין אים.<verse eid="ISA 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 19:2" />און איך װעל אָנרײצן מִצרַיִם אױף מִצרַיִם,</para>
  <para style="q" vid="ISA 19:2">און זײ װעלן מלחמה האַלטן איטלעכער קעגן זײַן ברודער,</para>
  <para style="q" vid="ISA 19:2">אַ שטאָט קעגן אַ שטאָט, אַ קיניגרײַך קעגן אַ קיניגרײַך.<verse eid="ISA 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 19:3" />און אױסגעלײדיקט װעט װערן דער גײַסט פֿון מִצרַיִם אין איר,</para>
  <para style="q" vid="ISA 19:3">און איר עצה װעל איך צונישט מאַכן;</para>
  <para style="q" vid="ISA 19:3">און זײ װעלן פֿאָרשן בײַ די אָפּגעטער, און בײַ די פּרעפּלער,</para>
  <para style="q" vid="ISA 19:3">און בײַ די גײַסטער, און בײַ די רוחות.<verse eid="ISA 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 19:4" />און איך װעל איבערענטפֿערן מִצרַיִם</para>
  <para style="q" vid="ISA 19:4">אין דער האַנט פֿון אַ האַרטן האַר,</para>
  <para style="q" vid="ISA 19:4">און אַ שטרענגער מלך װעט געװעלטיקן איבער זײ,</para>
  <para style="q" vid="ISA 19:4">זאָגט דער האַר, ה׳ צבָֿאוֹת.<verse eid="ISA 19:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 19:5" />און די װאַסערן װעלן אױסגײן פֿון ים,</para>
  <para style="q" vid="ISA 19:5">און דער טײַך װעט אױסגעטריקנט און טרוקן װערן.<verse eid="ISA 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 19:6" />און דומפּיק װעלן װערן די טײַכן,</para>
  <para style="q" vid="ISA 19:6">פֿאַרמינערט און אױסגעטריקנט װערן די פֿלוסן פֿון מִצרַיִם;</para>
  <para style="q" vid="ISA 19:6">רוהרן און אַיִר װערן פֿאַרװעלקט.<verse eid="ISA 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 19:7" />הױל װערט בײַם נילוס, בײַם ראַנד פֿונעם נילוס,</para>
  <para style="q" vid="ISA 19:7">און אַל דאָס פֿאַרזײטע בײַם נילוס</para>
  <para style="q" vid="ISA 19:7">װערט פֿאַרטריקנט, פֿאַרװײט, און נישטאָ.<verse eid="ISA 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 19:8" />און קלאָגן װעלן די פֿישער,</para>
  <para style="q" vid="ISA 19:8">און טרױערן װעלן אַלע װאָס װאַרפֿן אַ װענטקע אין נילוס,</para>
  <para style="q" vid="ISA 19:8">און די װאָס שפּרײטן אַ נעץ אױפֿן װאַסער װערן פֿאַרשניטן.<verse eid="ISA 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 19:9" />און פֿאַרשעמט װעלן װערן</para>
  <para style="q" vid="ISA 19:9">די אַרבעטער פֿון געקאַמטן פֿלאַקס,</para>
  <para style="q" vid="ISA 19:9">און די װעבער פֿון װײסצײַג.<verse eid="ISA 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 19:10" />און אירע גרינדונגן װעלן זײַן צעדריקט;</para>
  <para style="q" vid="ISA 19:10">אַלע לױנאַרבעטער באַטריבט אין געמיט.<verse eid="ISA 19:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 19:11" />לױטער נאַרן זײַנען די האַרן פֿון צוֹעַן,</para>
  <para style="q" vid="ISA 19:11">די קליגסטע יוֹעצים פֿון פַּרעהן זײַנען אַ נאַרישער באַראָט.</para>
  <para style="q" vid="ISA 19:11">װי קענט איר זאָגן צו פַּרעהן:</para>
  <para style="q" vid="ISA 19:11">אַ זון פֿון חכמים בין איך,</para>
  <para style="q" vid="ISA 19:11">אַ זון פֿון מלכים פֿאַרצײַטיקע?<verse eid="ISA 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 19:12" />װוּ זײַנען זײ דען דײַנע חכמים?</para>
  <para style="q" vid="ISA 19:12">זאָלן זײ אַקאָרשט דיר זאָגן;</para>
  <para style="q" vid="ISA 19:12">און לאָמען װיסן װאָס ה׳ צבָֿאוֹת</para>
  <para style="q" vid="ISA 19:12">האָט באַראָטן אױף מִצרַיִם.<verse eid="ISA 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 19:13" />פֿאַרנאַרישט זײַנען די האַרן פֿון צוֹעַן,</para>
  <para style="q" vid="ISA 19:13">אָפּגענאַרט זײַנען די האַרן פֿון נוֹף;</para>
  <para style="q" vid="ISA 19:13">פֿאַרפֿירט האָבן מִצרַיִם</para>
  <para style="q" vid="ISA 19:13">די פּנֵי פֿון אירע שבֿטים.<verse eid="ISA 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 19:14" />ה׳ האָט אַרײַנגעגאָסן אין איר</para>
  <para style="q" vid="ISA 19:14">אַ גײַסט פֿון פֿאַרדרײעניש;</para>
  <para style="q" vid="ISA 19:14">און זײ האָבן געמאַכט מִצרַיִם זיך װאַקלען אין אַל זײַן טוּונג</para>
  <para style="q" vid="ISA 19:14">װי אַ שכּור טוט זיך װאַקלען בײַ זײַן ברעכן.<verse eid="ISA 19:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 19:15" />און אין מִצרַיִם װעט נישט זײַן אַן אױפֿטו</para>
  <para style="q" vid="ISA 19:15">װאָס אַ קאָפּ אָדער אַן עק,</para>
  <para style="q" vid="ISA 19:15">אַ טײטלצװײַג אָדער אַ טײַכריטל זאָל אױפֿטאָן.<verse eid="ISA 19:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="ISA 19:16" />אין יענעם טאָג װעט מִצרַיִם זײַן אַזױ װי װײַבער, און ער װעט ציטערן און אַנגסטן פֿאַרן פֿאָך פֿון דער האַנט פֿון ה׳ צבָֿאוֹת, װאָס ער טוט פֿאָכן אױף אים. <verse eid="ISA 19:16" /><verse number="17" style="v" sid="ISA 19:17" />און דאָס לאַנד פֿון יהוּדה װעט װערן פֿאַר מִצרַיִם אַ שרעקעניש; װען נאָר מע װעט עס אים דערמאָנען, װעט ער אַנגסטן פֿאַר דעם באַראָט פֿון ה׳ צבָֿאוֹת, װאָס ער טוט באַראָטן אױף אים.<verse eid="ISA 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 19:18" />אין יענעם טאָג װעלן זײַן אין לאַנד מִצרַיִם פֿינף שטעט װאָס רעדן די שפּראַך פֿון כּנַעַן, און שװערן צו ה׳ צבָֿאוֹת; די שטאָט פֿון צעשטערונג װעט אײנע גערופֿן װערן.<verse eid="ISA 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 19:19" />אין יענעם טאָג װעט זײַן אַ מזבח צו ה׳ אין מיטן לאַנד מִצרַיִם, און אַ זײַלשטײן צו ה׳ בײַ איר געמאַרק. <verse eid="ISA 19:19" /><verse number="20" style="v" sid="ISA 19:20" />און עס װעט זײַן צום צײכן און צום עדות פֿאַר ה׳ צבָֿאוֹת אין לאַנד מִצרַיִם; אַז זײ װעלן שרײַען צו ה׳ פֿון װעגן דריקער, װעט ער זײ שיקן אַ העלפֿער און אַ שטרײַטער, און ער װעט זײ מציל זײַן. <verse eid="ISA 19:20" /><verse number="21" style="v" sid="ISA 19:21" />און ה׳ װעט זיך לאָזן דערקענען צו מִצרַיִם, און די מִצרַיִם װעלן דערקענען ה׳ אין יענעם טאָג, און דינען מיט שלאַכטאָפּפֿער און שפּײַזאָפּפֿער, און מנדר זײַן אַ נדר צו ה׳ און באַצאָלן. <verse eid="ISA 19:21" /><verse number="22" style="v" sid="ISA 19:22" />און ה׳ װעט פּלאָגן מִצרַיִם – פּלאָגן און הײלן; און אַז זײ װעלן זיך אומקערן צו ה׳, װעט ער זיך איבערבעטן צו זײ, און זײ הײלן.<verse eid="ISA 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 19:23" />אין יענעם טאָג װעט זײַן אַ װעג פֿון מִצרַיִם קײן אשור, און אשור װעט קומען אין מִצרַיִם, און מִצרַיִם אין אשור, און מִצרַיִם װעט דינען ה׳ מיט אשור.<verse eid="ISA 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 19:24" />אין יענעם טאָג װעט יִשׂרָאֵל זײַן אַ דריטער צו מִצרַיִם און צו אשור, אַ בענטשונג אין מיטן פֿון דער ערד; <verse eid="ISA 19:24" /><verse number="25" style="v" sid="ISA 19:25" />װײַל ה׳ צבָֿאוֹת האָט אים געבענטשט, אַזױ צו זאָגן: געבענטשט זאָל זײַן מײַן פֿאָלק מִצרַיִם, און דאָס װערק פֿון מײַנע הענט, אשור, און מײַן אַרבונג, יִשׂרָאֵל.<verse eid="ISA 19:25" /></para>
  <chapter eid="ISA 19" />
  <chapter number="20" style="c" pubnumber="כ" sid="ISA 20" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1" />אין דעם יאָר װאָס תַּרתָּן איז געקומען קײן אַשדוֹד, װען סַרגון דער מלך פֿון אשור האָט אים געשיקט, און ער האָט מלחמה געהאַלטן מיט אַשדוֹד, און האָט זי באַצװוּנגען; <verse eid="ISA 20:1" /><verse number="2" style="v" sid="ISA 20:2" />אין יענער צײַט האָט ה׳ גערעדט דורך ישַעיָהו דעם זון פֿון אָמוצן, אַזױ צו זאָגן: גײ, און זאָלסט אָפּבינדן דאָס זאַק פֿון דײַנע לענדן, און דײַן שוך זאָלסטו אַראָפּציִען פֿון דײַן פֿוס. האָט ער אַזױ געטאָן: אַרומגעגאַנגען נאַקעט און באָרװעס.<verse eid="ISA 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 20:3" />און ה׳ האָט געזאָגט: אַזױ װי מײַן קנעכט ישַעיָהו איז אַרומגעגאַנגען נאַקעט און באָרװעס דרײַ יאָר, פֿאַר אַ סימן און אַ צײכן אױף מִצרַיִם און אױף כּוּש, <verse eid="ISA 20:3" /><verse number="4" style="v" sid="ISA 20:4" />אַזױ װעט דער מלך פֿון אשור אַװעקפֿירן די געפֿאַנגענע פֿון מִצרַיִם, און די פֿאַרטריבענע פֿון כּוּש, יונגע און אַלטע, נאַקעט און באָרװעס, מיט אָפּגעדעקטן הינטער-לײַב, צו דער שאַנד פֿון מִצרַיִם. <verse eid="ISA 20:4" /><verse number="5" style="v" sid="ISA 20:5" />און זײ װעלן זײַן צעבראָכן און פֿאַרשעמט פֿון װעגן כּוּש, זײער אױסקוק, און פֿון װעגן מִצרַיִם, זײער באַרעמונג. <verse eid="ISA 20:5" /><verse number="6" style="v" sid="ISA 20:6" />און דער באַװױנער פֿון דאָזיקן ברעגלאַנד װעט זאָגן אין יענעם טאָג: זע, אַזױ איז געװאָרן פֿון אונדזער אױסקוק, װאָס מיר זײַנען אַהין געלאָפֿן נאָך הילף, ניצול צו װערן פֿון מלך פֿון אשור, און װי װעלן מיר אַנטרונען װערן?<verse eid="ISA 20:6" /></para>
  <chapter eid="ISA 20" />
  <chapter number="21" style="c" pubnumber="כא" sid="ISA 21" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 21:1" />די נבֿואה אױף דעם מדבר בײַם ים:</para>
  <para style="b" vid="ISA 21:1" />
  <para style="q" vid="ISA 21:1">װי שטורעמס אין דָרום װעט עס דורכגײן;</para>
  <para style="q" vid="ISA 21:1">פֿון מדבר קומט עס, פֿון אַ מוראדיקן לאַנד.<verse eid="ISA 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 21:2" />אַ שװערע זעונג איז מיר אָנגעזאָגט געװאָרן:</para>
  <para style="q" vid="ISA 21:2">דער פֿעלשער פֿעלשט, און דער רױבער רױבט.</para>
  <para style="q" vid="ISA 21:2">גײ, אַרױף עֵילָם! באַלעגער, מָדַי!</para>
  <para style="q" vid="ISA 21:2">אַלע זיפֿצן װאָס דורך איר מאַך איך אױפֿהערן.<verse eid="ISA 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 21:3" />דערום זײַנען מײַנע לענדן פֿול מיט ציטערניש,</para>
  <para style="q" vid="ISA 21:3">װײען האָבן מיך אָנגענומען</para>
  <para style="q" vid="ISA 21:3">װי װײען פֿון אַ געװינערין;</para>
  <para style="q" vid="ISA 21:3">איך בין צעקרימט און קען נישט הערן,</para>
  <para style="q" vid="ISA 21:3">איך בין צעטומלט און קען נישט זען.<verse eid="ISA 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 21:4" />צעדולט איז מײַן האַרץ,</para>
  <para style="q" vid="ISA 21:4">אַן אַנגסט האָט מיך צעגרױלט;</para>
  <para style="q" vid="ISA 21:4">מײַן גלוסטיקן אָװנט</para>
  <para style="q" vid="ISA 21:4">האָט מען מיר צו שױדער געמאַכט.<verse eid="ISA 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 21:5" />מע גרײט דעם טיש, מע דעקט די דעקע,</para>
  <para style="q" vid="ISA 21:5">מע עסט, מע טרינקט –</para>
  <para style="q" vid="ISA 21:5">שטײט אױף, איר האַרן, באַזאַלבט דעם שילד!<verse eid="ISA 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 21:6" />װאָרעם אַזױ האָט צו מיר אֲדֹנָי געזאָגט:</para>
  <para style="q" vid="ISA 21:6">גײ שטעל אַ װעכטער;</para>
  <para style="q" vid="ISA 21:6">װאָס ער װעט זען זאָל ער זאָגן.<verse eid="ISA 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 21:7" />און אַז ער װעט זען אַ גערײַט, געשפּאַנען פֿערד,</para>
  <para style="q" vid="ISA 21:7">אַ גערײַט אײזלען, אַ גערײַט קעמלען,</para>
  <para style="q" vid="ISA 21:7">זאָל ער האָרכן אַ האָרכונג, אַ האָרכונג אַ גרױסע.<verse eid="ISA 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 21:8" />האָט ער אױסגעשריִען װי אַ לײב:</para>
  <para style="q" vid="ISA 21:8">אױפֿן װאַכטורעם, אֲדֹנָי, שטײ איך תּמיד בײַ טאָג,</para>
  <para style="q" vid="ISA 21:8">און אױף מײַן היטונג בין איך געשטעלט אַלע נעכט.<verse eid="ISA 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 21:9" />און זע, אָט איז געקומען אַ גערײַט מענטשן,</para>
  <para style="q" vid="ISA 21:9">געשפּאַנען פֿערד; און ער האָט אױסגערופֿן און געזאָגט:</para>
  <para style="q" vid="ISA 21:9">געפֿאַלן, געפֿאַלן איז בָבֿל,</para>
  <para style="q" vid="ISA 21:9">און אַלע אירע שניצגעטער</para>
  <para style="q" vid="ISA 21:9">האָט מען צעבראָכן צו דער ערד.<verse eid="ISA 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 21:10" />דו געדראָשענע מײַנע, און קינד פֿון מײַן שײַער,</para>
  <para style="q" vid="ISA 21:10">װאָס איך האָב געהערט פֿון ה׳ צבָֿאוֹת אלוקי יִשׂרָאֵל,</para>
  <para style="q" vid="ISA 21:10">אײַך האָב איך דערצײלט.<verse eid="ISA 21:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="ISA 21:11" />די נבֿואה אױף דוּמָה.</para>
  <para style="b" vid="ISA 21:11" />
  <para style="q" vid="ISA 21:11">צו מיר רופֿט מען פֿון שֵׂעִיר:</para>
  <para style="q" vid="ISA 21:11">װעכטער, װאָס פֿון דער נאַכט?</para>
  <para style="q" vid="ISA 21:11">װעכטער, װאָס פֿון דער נאַכט?<verse eid="ISA 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 21:12" />זאָגט דער װעכטער: געקומען פֿרימאָרגן און אױך נאַכט;</para>
  <para style="q" vid="ISA 21:12">אױב איר װילט פֿרעגן, פֿרעגט,</para>
  <para style="q" vid="ISA 21:12">קומט װידער צו גײן.<verse eid="ISA 21:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="ISA 21:13" />די נבֿואה אױף עַרָבֿ:</para>
  <para style="b" vid="ISA 21:13" />
  <para style="q" vid="ISA 21:13">װי אין װאַלד װעט איר נעכטיקן אין עַרָבֿ,</para>
  <para style="q" vid="ISA 21:13">קאַראַװאַנען פֿון דעדָנים.<verse eid="ISA 21:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 21:14" />ברענגט װאַסער אַנטקעגן דעם דאָרשטיקן;</para>
  <para style="q" vid="ISA 21:14">די באַװױנער פֿון לאַנד תֵּימאָ</para>
  <para style="q" vid="ISA 21:14">זאָלן באַגעגענען מיט ברױט פֿאַר אים דעם פֿאַרװאָגלטן.<verse eid="ISA 21:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 21:15" />װאָרעם פֿון שװערדן זײַנען זײ אַנטלאָפֿן,</para>
  <para style="q" vid="ISA 21:15">פֿון דער געצױגענער שװערד,</para>
  <para style="q" vid="ISA 21:15">און פֿון דעם געשפּאַנטן בױגן,</para>
  <para style="q" vid="ISA 21:15">און פֿון דער שװערער מלחמה.<verse eid="ISA 21:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="ISA 21:16" />װאָרעם אַזױ האָט צו מיר אֲדֹנָי געזאָגט: אין נאָך אַ יאָר, װי די יאָרן פֿון אַ געדונגענעם, װעט פֿאַרלענדט װערן די גאַנצע פּראַכט פֿון קֵדָר, <verse eid="ISA 21:16" /><verse number="17" style="v" sid="ISA 21:17" />און די געבליבענע צאָל בױגנלײַט, די גיבוֹרים פֿון די קינדער פֿון קֵדָר, װעלן זײַן װינציק, װאָרעם ה׳ אלוקי יִשׂרָאֵל האָט גערעדט.<verse eid="ISA 21:17" /></para>
  <chapter eid="ISA 21" />
  <chapter number="22" style="c" pubnumber="כב" sid="ISA 22" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 22:1" />די נבֿואה אױף דעם טאָל פֿון זעונג:</para>
  <para style="b" vid="ISA 22:1" />
  <para style="q" vid="ISA 22:1">װאָס איז דיר דען</para>
  <para style="q" vid="ISA 22:1">װאָס דו ביסט אין גאַנצן אױף די דעכער אַרױף,<verse eid="ISA 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 22:2" />דו פֿולע מיט טומל,</para>
  <para style="q" vid="ISA 22:2">דו רױשיקע שטאָט, דו לוסטיקער כּרך?</para>
  <para style="q" vid="ISA 22:2">דײַנע דערשלאָגענע זײַנען נישט פֿון שװערד דערשלאָגן,</para>
  <para style="q" vid="ISA 22:2">און נישט אין מלחמה געטײטע.<verse eid="ISA 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 22:3" />אַלע דײַנע האַרן זײַנען אין אײנעם אַנטלאָפֿן,</para>
  <para style="q" vid="ISA 22:3">אָן אַ בױגן זײַנען זײ געפֿאַנגען געװאָרן;</para>
  <para style="q" vid="ISA 22:3">אַלע דײַנע געפֿונענע זײַנען אין אײנעם געפֿאַנגען געװאָרן –</para>
  <para style="q" vid="ISA 22:3">די װאָס זײַנען אין דער װײַט אַנטלאָפֿן.<verse eid="ISA 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 22:4" />דערום האָב איך געזאָגט:</para>
  <para style="q" vid="ISA 22:4">קערט אײַך אָפּ פֿון מיר, לאָמיך ביטערלעך װײנען;</para>
  <para style="q" vid="ISA 22:4">איר זאָלט נישט צושטײן מיך צו טרײסטן,</para>
  <para style="q" vid="ISA 22:4">אױף דעם בראָך פֿון דער טאָכטער מײַן פֿאָלק.<verse eid="ISA 22:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 22:5" />װאָרעם אַ טאָג פֿון טומל און טרעטונג און צעטומלטקײט</para>
  <para style="q" vid="ISA 22:5">איז בײַ אֲדֹנָי, ה׳ צבָֿאוֹת, אין טאָל פֿון זעונג;</para>
  <para style="q" vid="ISA 22:5">מע ברעכט מױערן, און אַ געשרײ ביזן באַרג.<verse eid="ISA 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 22:6" />און עֵילָם טראָגט דעם פֿײַלבײַטל,</para>
  <para style="q" vid="ISA 22:6">מיט אַ מחנה מענטשן רײַטער,</para>
  <para style="q" vid="ISA 22:6">און קיר האָט אַנטבלױזט דעם שילד.<verse eid="ISA 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 22:7" />און עס איז געװען,</para>
  <para style="q" vid="ISA 22:7">אַז דײַנע בעסטע טאָלן זײַנען פֿול געװאָרן מיט רײַטװעגן,</para>
  <para style="q" vid="ISA 22:7">און די רײַטער האָבן שטעלן זיך אױסגעשטעלט קעגן טױער,<verse eid="ISA 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 22:8" />און דעם צודעק פֿון יהוּדה האָט מען אָפּגעדעקט.</para>
  <para style="b" vid="ISA 22:8" />
  <para style="p" vid="ISA 22:8">אין יענעם טאָג האָסטו אױסגעקוקט אױפֿן װאַפֿן פֿון װאַלד-הױז. <verse eid="ISA 22:8" /><verse number="9" style="v" sid="ISA 22:9" />און די שפּאַלטן פֿון דָוִדס-שטאָט האָט איר געזען אַז זײ זײַנען פֿיל; און איר האָט אײַנגעזאַמלט דאָס װאַסער פֿון אונטערשטן טײַך. <verse eid="ISA 22:9" /><verse number="10" style="v" sid="ISA 22:10" />און די הײַזער פֿון ירושָלַיִם האָט איר פֿאַרצײכנט, און אײַנגעװאָרפֿן די הײַזער צו באַפֿעסטיקן די מױער. <verse eid="ISA 22:10" /><verse number="11" style="v" sid="ISA 22:11" />און אַ זאַמלאָרט צװישן די צװײ מױערן האָט איר געמאַכט, פֿאַר דעם װאַסער פֿון אַלטן טײַך. און איר האָט נישט געקוקט צו דעם װאָס האָט עס געטאָן, און דעם װאָס האָט עס באַשערט פֿון לאַנג אָן האָט איר נישט געזען.<verse eid="ISA 22:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 22:12" />און אֲדֹנָי, ה׳ צבָֿאוֹת, האָט גערופֿן אין יענעם טאָג,</para>
  <para style="q" vid="ISA 22:12">צו געװײן און צו קלאָג און צו פּליכעניש,</para>
  <para style="q" vid="ISA 22:12">און צום אָנגורטן זאַק;<verse eid="ISA 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 22:13" />ערשט עס איז שָׂשׂון-וּשׂימחה,</para>
  <para style="q" vid="ISA 22:13">קױלן רינדער און שעכטן שאָף,</para>
  <para style="q" vid="ISA 22:13">עסן פֿלײש, און טרינקען װײַן;</para>
  <para style="q" vid="ISA 22:13">עסן און טרינקען, װאָרעם מאָרגן װעלן מיר שטאַרבן.<verse eid="ISA 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 22:14" />און ה׳ צבָֿאוֹת האָט זיך אַנטפּלעקט אין מײַנע אױערן:</para>
  <para style="q" vid="ISA 22:14">אױב די דאָזיקע זינד װעט אײַך פֿאַרגעבן װערן</para>
  <para style="q" vid="ISA 22:14">ביז איר װעט שטאַרבן!</para>
  <para style="q" vid="ISA 22:14">האָט געזאָגט אֲדֹנָי, ה׳ צבָֿאוֹת.<verse eid="ISA 22:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="ISA 22:15" />אַזױ האָט געזאָגט אֲדֹנָי, ה׳ צבָֿאוֹת: גײ קום צו דעם דאָזיקן אױפֿזעער, צו שֶבֿנאָ װאָס איבערן פּאַלאַץ: <verse eid="ISA 22:15" /><verse number="16" style="v" sid="ISA 22:16" />װאָס האָסטו דאָ, און װעמען האָסטו דאָ, װאָס דו האָסט דיר דאָ אַ קבֿר אױסגעהאַקט, דו װאָס האָסט אױסגעהאַקט אין דער הײך דײַן קבֿר, זיך אױסגעשניטן אין פֿעלדז אַ װױנונג? <verse eid="ISA 22:16" /><verse number="17" style="v" sid="ISA 22:17" />זע, ה׳ שלײַדערט דיך אַ מאַכטיקן שלײַדער, און דרײט דיך אום דרײענדיק; <verse eid="ISA 22:17" /><verse number="18" style="v" sid="ISA 22:18" />קוליִען אין אַ קֹול װעט ער דיך אַװעקקוליען, װי אַ באַל, אין אַ ברײטרױמיק לאַנד. דאָרטן װעסטו שטאַרבן, און דאָרטן װעלן זײַן דײַנע פּראַכטיקע רײַטװעגן, דו שאַנד פֿון דעם הױז פֿון דײַן האַר! <verse eid="ISA 22:18" /><verse number="19" style="v" sid="ISA 22:19" />און איך װעל דיך אַראָפּשטױסן פֿון דײַן שטאַנד, און פֿון דײַן שטעל װעט מען דיך אַראָפּװאַרפֿן. <verse eid="ISA 22:19" /><verse number="20" style="v" sid="ISA 22:20" />און עס װעט זײַן אין יענעם טאָג, װעל איך רופֿן מײַן קנעכט אֶליָקים דעם זון פֿון חִלקִיָהון. <verse eid="ISA 22:20" /><verse number="21" style="v" sid="ISA 22:21" />און איך װעל אים אָנטאָן דײַן מאַנטל, און דײַן גאַרטל װעל איך אים אַרומבינדן, און דײַן ממשלה װעל איך געבן אין זײַן האַנט; און ער װעט זײַן פֿאַר אַ פֿאָטער צום באַװױנער פֿון ירושָלַיִם, און צום הױז פֿון יהוּדה. <verse eid="ISA 22:21" /><verse number="22" style="v" sid="ISA 22:22" />און איך װעל געבן דעם שליסל פֿון דָוִדס הױז אױף זײַן אַקסל, און ער װעט עפֿענען, און קײנער װעט נישט פֿאַרשליסן, און ער װעט פֿאַרשליסן, און קײנער װעט נישט עפֿענען. <verse eid="ISA 22:22" /><verse number="23" style="v" sid="ISA 22:23" />און איך װעל אים באַפֿעסטיקן װי אַ פֿלעקל אין אַ זיכערן אָרט; און ער װעט זײַן אַ טראָן פֿון כּבֿוד פֿאַר זײַן פֿאָטערס הױז. <verse eid="ISA 22:23" /><verse number="24" style="v" sid="ISA 22:24" />און דאָס גאַנצע געזעמל פֿון זײַן פֿאָטערס הױז, קינד און קײט, װעלן אָנהענגען אױף אים אַלע קלײנע געפֿעסן, פֿון די בעקנגעפֿעסן און ביז אַלע קרוגגעפֿעסן. <verse eid="ISA 22:24" /><verse number="25" style="v" sid="ISA 22:25" />אין יענעם טאָג, זאָגט ה׳ צבָֿאוֹת, װעט אָפּגעטאָן װערן דאָס פֿלעקל װאָס איז באַפֿעסטיקט אין אַ זיכערן אָרט, און װעט אָפּגעהאַקט װערן און אַראָפּפֿאַלן, און די משׂא װאָס אױף אים װעט פֿאַרשניטן װערן; װאָרעם ה׳ האָט גערעדט.<verse eid="ISA 22:25" /></para>
  <chapter eid="ISA 22" />
  <chapter number="23" style="c" pubnumber="כג" sid="ISA 23" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 23:1" />די נבֿואה אױף צוֹר:</para>
  <para style="b" vid="ISA 23:1" />
  <para style="q" vid="ISA 23:1">יאָמערט איר שיפֿן פֿון תַּרְשִיש,</para>
  <para style="q" vid="ISA 23:1">װאָרעם זי איז פֿאַרװיסט, אָן אַ הױז, אָן אַן אײַנגאַנג;</para>
  <para style="q" vid="ISA 23:1">פֿון לאַנד פֿון די כִּתּים</para>
  <para style="q" vid="ISA 23:1">איז דאָס זײ אַנטפּלעקט געװאָרן.<verse eid="ISA 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 23:2" />זײַט שטיל, איר באַװױנער פֿון אינדזל;</para>
  <para style="q" vid="ISA 23:2">דו װאָס די סוחרים פֿון צידון,</para>
  <para style="q" vid="ISA 23:2">די ים-פֿאָרער, האָבן דיך אָנגעפֿילט.<verse eid="ISA 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 23:3" />און איבער גרױסע װאַסערן איז דער זאָמען פֿון שיחוֹר,</para>
  <para style="q" vid="ISA 23:3">דער שניט פֿון נילוס, איר אײַנקום געװען;</para>
  <para style="q" vid="ISA 23:3">און זי איז געװען דער מאַרק פֿון די פֿעלקער.<verse eid="ISA 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 23:4" />שעם זיך צידון, װאָרעם דער ים האָט געזאָגט,</para>
  <para style="q" vid="ISA 23:4">די פֿעסטונג פֿון ים, אַזױ צו זאָגן:</para>
  <para style="q" vid="ISA 23:4">װי איך װאָלט גאָרנישט געװײטאָקט און נישט געבאָרן,</para>
  <para style="q" vid="ISA 23:4">און קײן בחורים נישט דערצױגן,</para>
  <para style="q" vid="ISA 23:4">אָדער יונגפֿרױען אױפֿגעבראַכט.<verse eid="ISA 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 23:5" />אַז מע װעט הערן אין מִצרַיִם,</para>
  <para style="q" vid="ISA 23:5">װעט מען ציטערן בײַ דער הערונג פֿון צוֹר.<verse eid="ISA 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 23:6" />גײט אַריבער קײן תַּרְשִיש,</para>
  <para style="q" vid="ISA 23:6">יאָמערט, איר באַװױנער פֿון אינדזל.<verse eid="ISA 23:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 23:7" />איז דאָס אײַך די פֿרײלעכע שטאָט,</para>
  <para style="q" vid="ISA 23:7">װאָס פֿון פֿריִע פֿאַרצײַטיקע טעג פֿלעגן זי פֿירן אירע פֿיס</para>
  <para style="q" vid="ISA 23:7">אין דער װײַטן צו װױנען?<verse eid="ISA 23:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 23:8" />װער האָט דאָס באַראָטן אױף צוֹר דער באַקרױנטער,</para>
  <para style="q" vid="ISA 23:8">װאָס אירע סוחרים זײַנען געװען שׂרָרות,</para>
  <para style="q" vid="ISA 23:8">אירע האַנדלסלײַט די נִכבָדים פֿון דער ערד?<verse eid="ISA 23:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 23:9" />ה׳ צבָֿאוֹת האָט דאָס באַראָטן,</para>
  <para style="q" vid="ISA 23:9">צו פֿאַרשװעכן דעם שטאָלץ פֿון אַל דער שײנקײט,</para>
  <para style="q" vid="ISA 23:9">צו מאַכן גרינגגעשאַצט אַלע נִכבָדים פֿון דער ערד.<verse eid="ISA 23:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 23:10" />איבערפֿלײץ דײַן לאַנד װי דער נילוס, טאָכטער תַּרְשִיש,</para>
  <para style="q" vid="ISA 23:10">נישטאָ מער קײן אײַנצאַם.<verse eid="ISA 23:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 23:11" />ער האָט אױסגעשטרעקט זײַן האַנט איבערן ים,</para>
  <para style="q" vid="ISA 23:11">ער האָט געמאַכט ציטערן מלוכות;</para>
  <para style="q" vid="ISA 23:11">ה׳ האָט באַפֿױלן װעגן כּנַעַן,</para>
  <para style="q" vid="ISA 23:11">צו פֿאַרטיליקן אירע פֿעסטונגען.<verse eid="ISA 23:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 23:12" />און ער האָט געזאָגט: װעסט נישט מער לוסטיק זײַן,</para>
  <para style="q" vid="ISA 23:12">געשענדטע יונגפֿרױ טאָכטער צידון.</para>
  <para style="q" vid="ISA 23:12">שטײ אױף, גײ אַריבער קײן כִּתּים;</para>
  <para style="q" vid="ISA 23:12">אױך דאָרט װעסטו קײן מנוחה נישט האָבן.<verse eid="ISA 23:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="ISA 23:13" />זע, דאָס לאַנד פֿון די כַּשׂדים – די דאָזיקע אומה איז נאָך נישט געװען װען אשור האָט עס געגרונטפֿעסט פֿאַר מדבר-באַשעפֿענישן – זײ האָבן אױפֿגעשטעלט זײערע באַלעגערטורעמס, זײ האָבן אײַנגעװאָרפֿן אירע פּאַלאַצן; מע האָט זײ געמאַכט פֿאַר אַ חורבֿה.<verse eid="ISA 23:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 23:14" />יאָמערט איר שיפֿן פֿון תַּרְשִיש,</para>
  <para style="q" vid="ISA 23:14">װאָרעם פֿאַרװיסט געװאָרן איז אײַער פֿעסטונג.<verse eid="ISA 23:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="ISA 23:15" />און עס װעט זײַן אין יענעם טאָג: װעט צוֹר זײַן פֿאַרגעסן זיבעציק יאָר, אַזױ װי די טעג פֿון אײן מלך; צום סוף פֿון זיבעציק יאָר װעט געשען מיט צוֹר אַזױ װי אין געזאַנג פֿון דער זוֹנה:<verse eid="ISA 23:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 23:16" />נעם אַ האַרף,</para>
  <para style="q" vid="ISA 23:16">גײ אום אין שטאָט,</para>
  <para style="q" vid="ISA 23:16">פֿאַרגעסענע זוֹנה;</para>
  <para style="q" vid="ISA 23:16">שפּיל שײן,</para>
  <para style="q" vid="ISA 23:16">זינג פֿיל,</para>
  <para style="q" vid="ISA 23:16">כּדי זאָלסט דערמאָנט װערן.<verse eid="ISA 23:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="ISA 23:17" />און עס װעט זײַן צום סוף פֿון זיבעציק יאָר, װעט ה׳ זיך דערמאָנען אָן צוֹר, און זי װעט זיך אומקערן צו איר זוֹנה-לױן, און װעט װידער פֿאַרקערן מיט אַלע קיניגרײַכן פֿון דער װעלט אױפֿן געזיכט פֿון דער ערד. <verse eid="ISA 23:17" /><verse number="18" style="v" sid="ISA 23:18" />אָבער איר פֿאַרדינסט און איר זוֹנה-לױן װעט זײַן הײליק צו ה׳; ער װעט נישט באַהאַלטן און נישט אײַנגעשלאָסן װערן; נײַערט פֿאַר די װאָס זיצן פֿאַר ה׳ װעט זײַן איר פֿאַרדינסט, צו עסן צו זאַט, און פֿאַר אַ צודעק אַ שײנעם.<verse eid="ISA 23:18" /></para>
  <chapter eid="ISA 23" />
  <chapter number="24" style="c" pubnumber="כד" sid="ISA 24" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 24:1" />זע, ה׳ לײדיקט אױס די ערד און פֿאַרװיסט זי,</para>
  <para style="q" vid="ISA 24:1">און װעט צעדרײען איר פּנים,</para>
  <para style="q" vid="ISA 24:1">און צעשפּרײטן אירע באַװױנער.<verse eid="ISA 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 24:2" />און עס װעט זײַן,</para>
  <para style="q" vid="ISA 24:2">אַזױ דאָס פֿאָלק אַזױ דער כּהן,</para>
  <para style="q" vid="ISA 24:2">אַזױ דער קנעכט אַזױ זײַן האַר,</para>
  <para style="q" vid="ISA 24:2">אַזױ די דינסט אַזױ איר האַרינטע,</para>
  <para style="q" vid="ISA 24:2">אַזױ דער קױפֿער אַזױ דער פֿאַרקױפֿער,</para>
  <para style="q" vid="ISA 24:2">אַזױ דער מלװה אַזױ דער לײַער,</para>
  <para style="q" vid="ISA 24:2">אַזױ דער מאָנער אַזױ דער װאָס מע מאָנט פֿון אים.<verse eid="ISA 24:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 24:3" />אױסגעלײדיקט װעט אױסגעלײדיקט װערן די ערד,</para>
  <para style="q" vid="ISA 24:3">און צערױבט װעט זי צערױבט װערן;</para>
  <para style="q" vid="ISA 24:3">װאָרעם ה׳ האָט גערעדט דאָס דאָזיקע װאָרט.<verse eid="ISA 24:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 24:4" />פֿאַראָבֿלט, פֿאַרװעלקט איז די ערד,</para>
  <para style="q" vid="ISA 24:4">פֿאַרשניטן, פֿאַרװעלקט איז די װעלט,</para>
  <para style="q" vid="ISA 24:4">פֿאַרשניטן די הױכע לײַט פֿון דער ערד.<verse eid="ISA 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 24:5" />און די ערד איז זינדיק אונטער אירע באַװױנער,</para>
  <para style="q" vid="ISA 24:5">װאָרעם זײ האָבן עובֿר געװען אױף די תּורות,</para>
  <para style="q" vid="ISA 24:5">איבערגעטרעטן דאָס געזעץ,</para>
  <para style="q" vid="ISA 24:5">פֿאַרשטערט דעם אײביקן ברית.<verse eid="ISA 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 24:6" />דערום עסט אױף אַ קללה די ערד,</para>
  <para style="q" vid="ISA 24:6">און פֿאַרשולדיקט זײַנען די װױנער דערין;</para>
  <para style="q" vid="ISA 24:6">דערום גײען אײַן די באַװױנער פֿון דער ערד,</para>
  <para style="q" vid="ISA 24:6">און מענטשן בלײַבן װינציק.<verse eid="ISA 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 24:7" />עס טרױערט דער װײַן, פֿאַרװעלקט איז דער װײַנשטאָק,</para>
  <para style="q" vid="ISA 24:7">עס זיפֿצן אַלע פֿרײלעכע הערצער.<verse eid="ISA 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 24:8" />אױפֿגעהערט האָט די פֿרײד פֿון די פּױקן,</para>
  <para style="q" vid="ISA 24:8">פֿאַרמיטן איז דער ליאַרעם פֿון די לוסטיקע,</para>
  <para style="q" vid="ISA 24:8">אױפֿגעהערט האָט די פֿרײד פֿון דער האַרף.<verse eid="ISA 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 24:9" />מע טרינקט נישט קײן װײַן מיט געזאַנג,</para>
  <para style="q" vid="ISA 24:9">ביטער איז דער טרונק זײַנע טרינקער.<verse eid="ISA 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 24:10" />צעבראָכן איז די נישטיקע שטאָט,</para>
  <para style="q" vid="ISA 24:10">פֿאַרשלאָסן איטלעך הױז נישט אַרײַנצוגײן.<verse eid="ISA 24:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 24:11" />אַ װײגעשרײ אין די גאַסן בײַם װײַן;</para>
  <para style="q" vid="ISA 24:11">פֿאַרפֿינצטערט איז איטלעכע שׂימחה,</para>
  <para style="q" vid="ISA 24:11">פֿאַרװאָגעלט די פֿרײד פֿונעם לאַנד.<verse eid="ISA 24:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 24:12" />געבליבן איז אַ װיסטקײט אין שטאָט,</para>
  <para style="q" vid="ISA 24:12">און צעהאַקט אין אַ חורבֿה איז דער טױער.<verse eid="ISA 24:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 24:13" />װאָרעם אַזױ װעט עס זײַן אין מיטן פֿון דער ערד,</para>
  <para style="q" vid="ISA 24:13">צװישן די פֿעלקער; װי בײַם אָפּקלאַפּן אַן אײלבערטבױם,</para>
  <para style="q" vid="ISA 24:13">װי אַ נאָכקלײַב װען די לעז איז געענדיקט.<verse eid="ISA 24:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 24:14" />די דאָזיקע װעלן אױפֿהײבן זײער קֹול אין געזאַנג,</para>
  <para style="q" vid="ISA 24:14">װעגן דער גרױסקײט פֿון ה׳ טוען זײ שאַלן פֿון אים.<verse eid="ISA 24:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 24:15" />דערום טוט ערלעכן ה׳ אין די לענדער פֿון ליכט,</para>
  <para style="q" vid="ISA 24:15">אױף די אינזלען פֿון ים, דעם נאָמען פֿון ה׳ אלוקי יִשׂרָאֵל.<verse eid="ISA 24:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 24:16" />פֿון עק ערד האָבן מיר געזאַנגען געהערט:</para>
  <para style="q" vid="ISA 24:16">פּראַכט צו דעם גערעכטן!</para>
  <para style="q" vid="ISA 24:16">אָבער איך זאָג: איך גײ אײַן,</para>
  <para style="q" vid="ISA 24:16">איך גײ אײַן, װײ איז מיר!</para>
  <para style="q" vid="ISA 24:16">די פֿעלשער טוען פֿעלשן,</para>
  <para style="q" vid="ISA 24:16">יאָ, אַ פֿעלשונג פֿעלשן די פֿעלשער.<verse eid="ISA 24:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 24:17" />אַ גרױל און אַ גרוב און אַ נעץ</para>
  <para style="q" vid="ISA 24:17">אױף דיר, באַװױנער פֿון דער ערד.<verse eid="ISA 24:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 24:18" />און עס װעט זײַן,</para>
  <para style="q" vid="ISA 24:18">דער װאָס אַנטלױפֿט פֿון דעם קֹול פֿון גרױל,</para>
  <para style="q" vid="ISA 24:18">װעט אַרײַנפֿאַלן אין גרוב,</para>
  <para style="q" vid="ISA 24:18">און דער װאָס קומט אַרױף פֿון גרוב,</para>
  <para style="q" vid="ISA 24:18">װעט געפֿאַנגען װערן אין נעץ;</para>
  <para style="q" vid="ISA 24:18">װאָרעם די פֿענצטער פֿון דער הײך האָבן זיך געעפֿנט,</para>
  <para style="q" vid="ISA 24:18">און עס שטורעמען די גרונטפֿעסטן פֿון דער ערד.<verse eid="ISA 24:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 24:19" />ברעכן צעברעכט זיך די ערד,</para>
  <para style="q" vid="ISA 24:19">ברעקלען צעברעקלט זיך די ערד,</para>
  <para style="q" vid="ISA 24:19">װאַקלען טוט זיך װאַקלען די ערד.<verse eid="ISA 24:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 24:20" />שאָקלען װי אַ שיכּורער װעט זיך שאָקלען די ערד,</para>
  <para style="q" vid="ISA 24:20">און װעט זיך טרײסלען װי אַ נאַכטבײַדל;</para>
  <para style="q" vid="ISA 24:20">און שװער װעט זײַן איר פֿאַרברעך אױף איר,</para>
  <para style="q" vid="ISA 24:20">און זי װעט פֿאַלן, און מער נישט אױפֿשטײן.<verse eid="ISA 24:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 24:21" />און עס װעט זײַן אין יענעם טאָג,</para>
  <para style="q" vid="ISA 24:21">װעט ה׳ זיך רעכענען מיט דעם חיל</para>
  <para style="q" vid="ISA 24:21">פֿון דער הײך אין דער הײך,</para>
  <para style="q" vid="ISA 24:21">און מיט די מלכים פֿון דער ערד</para>
  <para style="q" vid="ISA 24:21">אױף דער ערד.<verse eid="ISA 24:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 24:22" />און זײ װעלן אײַנגעזאַמלט װערן</para>
  <para style="q" vid="ISA 24:22">װי מע זאַמלט געפֿאַנגענע אין תּפֿיסה,</para>
  <para style="q" vid="ISA 24:22">און זײ װעלן אײַנגעשלאָסן װערן אין פֿעסטונג,</para>
  <para style="q" vid="ISA 24:22">און ערשט נאָך פֿיל טעג װעלן זײ דערמאָנט װערן.<verse eid="ISA 24:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 24:23" />און די לבֿנה װעט זיך שעמען,</para>
  <para style="q" vid="ISA 24:23">און די זון װעט פֿאַרשעמט װערן,</para>
  <para style="q" vid="ISA 24:23">װאָרעם ה׳ צבָֿאוֹת טוט קיניגן</para>
  <para style="q" vid="ISA 24:23">אױף באַרג צִיוֹן, און אין ירושָלַיִם;</para>
  <para style="q" vid="ISA 24:23">און אַנטקעגן זײַנע עלטסטע װעט זײַן אַ פּראַכטיקײט.<verse eid="ISA 24:23" /></para>
  <chapter eid="ISA 24" />
  <chapter number="25" style="c" pubnumber="כה" sid="ISA 25" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 25:1" />ה׳, דו ביסט מײַן ג-ט,</para>
  <para style="q" vid="ISA 25:1">איך װעל דיך דערהײבן,</para>
  <para style="q" vid="ISA 25:1">איך װעל לױבן דײַן נאָמען,</para>
  <para style="q" vid="ISA 25:1">װאָרעם האָסט אױפֿגעטאָן װוּנדער;</para>
  <para style="q" vid="ISA 25:1">די באַראָטן פֿון לאַנג אָן –</para>
  <para style="q" vid="ISA 25:1">מיט טרײַער געטרײַשאַפֿט.<verse eid="ISA 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 25:2" />װאָרעם האָסט געמאַכט פֿון אַ שטאָט אַ הױפֿן,</para>
  <para style="q" vid="ISA 25:2">אַ באַפֿעסטיקטן כּרך פֿאַר אַ חורבֿה,</para>
  <para style="q" vid="ISA 25:2">די פּאַלאַצן פֿון פֿרעמדע פֿאַר אױס שטאָט,</para>
  <para style="q" vid="ISA 25:2">זײ זאָלן אײביק נישט אָפּגעבױט װערן.<verse eid="ISA 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 25:3" />דערום װעט דיך ערלעכן די שטאַרקע אומה,</para>
  <para style="q" vid="ISA 25:3">דער כּרך פֿון מאַכטיקע פֿעלקער װעט דיך פֿאָרכטן.<verse eid="ISA 25:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 25:4" />װאָרעם ביסט געװען אַ פֿעסטונג דעם אָרעמאַן,</para>
  <para style="q" vid="ISA 25:4">אַ פֿעסטונג דעם באַדערפֿטיקן אין זײַן נױט,</para>
  <para style="q" vid="ISA 25:4">אַ שוץ פֿון גוסרעגן,</para>
  <para style="q" vid="ISA 25:4">אַ שאָטן פֿון היץ;</para>
  <para style="q" vid="ISA 25:4">װאָרעם דער צאָרן פֿון די מאַכטיקע</para>
  <para style="q" vid="ISA 25:4">איז װי אַ גוסרעגן אױף אַ װאַנט.<verse eid="ISA 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 25:5" />אַזױ װי היץ אין אַ טרוקענעם לאַנד,</para>
  <para style="q" vid="ISA 25:5">דאָס גערױש פֿון די פֿרעמדע אונטערטעניקסטו;</para>
  <para style="q" vid="ISA 25:5">װי היץ דורך אַ װאָלקנשאָטן,</para>
  <para style="q" vid="ISA 25:5">װערט דאָס געזאַנג פֿון די מאַכטיקע פֿאַרדריקט.<verse eid="ISA 25:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 25:6" />און ה׳ צבָֿאוֹת װעט מאַכן</para>
  <para style="q" vid="ISA 25:6">פֿאַר אַלע פֿעלקער אױף דעם דאָזיקן באַרג,</para>
  <para style="q" vid="ISA 25:6">אַ מאָלצײַט פֿון פֿעטשפּײַזן,</para>
  <para style="q" vid="ISA 25:6">אַ מאָלצײַט פֿון הײװנװײַנען,</para>
  <para style="q" vid="ISA 25:6">פֿעטשפּײַזן מאַרכיקע,</para>
  <para style="q" vid="ISA 25:6">הײװנװײַנען געלײַטערטע.<verse eid="ISA 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 25:7" />און ער װעט פֿאַרטיליקן אױף דעם דאָזיקן באַרג</para>
  <para style="q" vid="ISA 25:7">דעם צודעק װאָס דעקט צו אַלע פֿעלקער,</para>
  <para style="q" vid="ISA 25:7">און דעם שלײער װאָס איז געשלײערט אױף אַלע אומות.<verse eid="ISA 25:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 25:8" />ער װעט פֿאַרטיליקן דעם טױט אױף אײביק;</para>
  <para style="q" vid="ISA 25:8">און אֲדֹנָי ה׳ װעט אָפּװישן</para>
  <para style="q" vid="ISA 25:8">די טרער פֿון איטלעכן פּנים,</para>
  <para style="q" vid="ISA 25:8">און די שאַנד פֿון זײַן פֿאָלק</para>
  <para style="q" vid="ISA 25:8">װעט ער אָפּטאָן פֿון דער גאַנצער ערד;</para>
  <para style="q" vid="ISA 25:8">װאָרעם ה׳ האָט גערעדט.<verse eid="ISA 25:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 25:9" />און מע װעט זאָגן אין יענעם טאָג:</para>
  <para style="q" vid="ISA 25:9">זע, דאָס איז אלוקינו,</para>
  <para style="q" vid="ISA 25:9">װאָס מיר האָבן געהאָפֿט צו אים ער זאָל אונדז העלפֿן,</para>
  <para style="q" vid="ISA 25:9">דאָס איז ה׳ װאָס מיר האָבן געהאָפֿט צו אים,</para>
  <para style="q" vid="ISA 25:9">לאָמיר לוסטיק זײַן און זיך פֿרײען מיט זײַן הילף.<verse eid="ISA 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 25:10" />װאָרעם די האַנט פֿון ה׳ װעט רוען אױף דעם דאָזיקן באַרג,</para>
  <para style="q" vid="ISA 25:10">און מוֹאָבֿ װעט צעטרעטן װערן אױף זײַן אָרט,</para>
  <para style="q" vid="ISA 25:10">װי שטרױ װערט צעטרעטן אין מיסטהױפֿן.<verse eid="ISA 25:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 25:11" />און ער װעט אױסשפּרײטן דערין זײַנע הענט,</para>
  <para style="q" vid="ISA 25:11">װי אַ שװימער שפּרײט אױס צום שװימען;</para>
  <para style="q" vid="ISA 25:11">אָבער מע װעט דערנידערן זײַן גאװה</para>
  <para style="q" vid="ISA 25:11">מיט די קונצן פֿון זײַנע הענט:<verse eid="ISA 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 25:12" />און די הױכע פֿעסטונג פֿון דײַנע מױערן</para>
  <para style="q" vid="ISA 25:12">בײגט ער, דערנידערט ער,</para>
  <para style="q" vid="ISA 25:12">ברענגט ער צו דער ערד ביזן שטױב.<verse eid="ISA 25:12" /></para>
  <chapter eid="ISA 25" />
  <chapter number="26" style="c" pubnumber="כו" sid="ISA 26" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 26:1" />אין יענעם טאָג װעט געזונגען װערן</para>
  <para style="q" vid="ISA 26:1">דאָס דאָזיקע געזאַנג אין לאַנד יהוּדה:</para>
  <para style="b" vid="ISA 26:1" />
  <para style="q" vid="ISA 26:1">אַ שטאַרקע שטאָט האָבן מיר;</para>
  <para style="q" vid="ISA 26:1">מױערן און פֿעסטונגען מאַכט ער פֿאַר הילף.<verse eid="ISA 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 26:2" />עפֿנט די טױערן,</para>
  <para style="q" vid="ISA 26:2">און זאָל אַרײַנגײן דאָס גערעכטע פֿאָלק,</para>
  <para style="q" vid="ISA 26:2">װאָס היט אָפּ װאָרהײט.<verse eid="ISA 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 26:3" />דאָס געמיט װאָס פֿאַרלאָזט זיך</para>
  <para style="q" vid="ISA 26:3">באַהיטסטו אין שלום;</para>
  <para style="q" vid="ISA 26:3">אין שלום, װײַל עס גלױבט אין דיר.<verse eid="ISA 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 26:4" />פֿאַרזיכערט אײַך אױף ה׳ ביז אײביק,</para>
  <para style="q" vid="ISA 26:4">װאָרעם אין ג-ט ה׳ איז אַן אײביקער פֿעלדז.<verse eid="ISA 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 26:5" />װאָרעם ער האָט געבײגט די װאָס זיצן אין דער הײך,</para>
  <para style="q" vid="ISA 26:5">די דערהױבענע שטאָט;</para>
  <para style="q" vid="ISA 26:5">ער דערנידערט זי, ער דערנידערט זי ביז דער ערד,</para>
  <para style="q" vid="ISA 26:5">ער ברענגט זי ביזן שטױב.<verse eid="ISA 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 26:6" />דער פֿוס װעט זי צעטרעטן,</para>
  <para style="q" vid="ISA 26:6">די פֿיס פֿון דעם אָרימען,</para>
  <para style="q" vid="ISA 26:6">די טריט פֿון באַדערפֿטיקע.<verse eid="ISA 26:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 26:7" />דער װעג פֿון גערעכטן איז גלײַך;</para>
  <para style="q" vid="ISA 26:7">דו רעכטפֿאַרטיקער, מאַכסט גלאַט דעם שטעג פֿון גערעכטן;<verse eid="ISA 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 26:8" />יאָ, אױף דעם װעג פֿון דײַנע משפּטים</para>
  <para style="q" vid="ISA 26:8">האָבן מיר געהאָפֿט אױף דיר, ה׳;</para>
  <para style="q" vid="ISA 26:8">צו דײַן נאָמען און צו דײַן געדעכעניש</para>
  <para style="q" vid="ISA 26:8">איז די גלוסטונג פֿון דער זעל.<verse eid="ISA 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 26:9" />מיט מײַן זעל האָב איך דיך געגלוסט בײַ נאַכט,</para>
  <para style="q" vid="ISA 26:9">יאָ, מיט מײַן גײַסט אין מיר האָב איך דיך געזוכט,</para>
  <para style="q" vid="ISA 26:9">װאָרעם אַז דײַנע משפּטים זײַנען אױף דער ערד,</para>
  <para style="q" vid="ISA 26:9">לערנען גערעכטיקײט די באַװױנער פֿון דער װעלט.<verse eid="ISA 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 26:10" />װערט דער רשע געלײַטזעליקט,</para>
  <para style="q" vid="ISA 26:10">לערנט ער נישט גערעכטיקײט;</para>
  <para style="q" vid="ISA 26:10">אין לאַנד פֿון ערלעכקײט טוט ער אומרעכט,</para>
  <para style="q" vid="ISA 26:10">און ער זעט נישט די גרױסקײט פֿון ה׳.<verse eid="ISA 26:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 26:11" />ה׳, אױפֿגעהױבן איז דײַן האַנט,</para>
  <para style="q" vid="ISA 26:11">אָבער זײ זעען נישט;</para>
  <para style="q" vid="ISA 26:11">זאָלן זײ זען און זיך שעמען</para>
  <para style="q" vid="ISA 26:11">דײַן אָננעמען זיך פֿאַרן פֿאָלק;</para>
  <para style="q" vid="ISA 26:11">יאָ, אַ פֿײַער זאָל דײַנע פֿײַנט פֿאַרצערן.<verse eid="ISA 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 26:12" />ה׳, באַשער אונדז שלום,</para>
  <para style="q" vid="ISA 26:12">װאָרעם אױך אַלע אונדזערע אױפֿטוען</para>
  <para style="q" vid="ISA 26:12">האָסט דו אױסגעפֿירט פֿאַר אונדז.<verse eid="ISA 26:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 26:13" />ה׳ אלוקינו,</para>
  <para style="q" vid="ISA 26:13">האַרן אַחוץ דיר האָבן געהערשט איבער אונדז.</para>
  <para style="q" vid="ISA 26:13">אָבער נאָר דיך האָבן מיר דערמאָנט – דײַן נאָמען.<verse eid="ISA 26:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 26:14" />די מתים װעלן נישט לעבעדיק װערן,</para>
  <para style="q" vid="ISA 26:14">די טױטע װעלן נישט אױפֿשטײן;</para>
  <para style="q" vid="ISA 26:14">פֿאַר װאָר האָסט געשטראָפֿט און זײ פֿאַרטיליקט,</para>
  <para style="q" vid="ISA 26:14">און אונטערגעבראַכט יעטװעדער דערמאָנונג פֿון זײ.<verse eid="ISA 26:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 26:15" />דו האָסט געמערט דאָס פֿאָלק, ה׳,</para>
  <para style="q" vid="ISA 26:15">דו האָסט געמערט דאָס פֿאָלק, עס איז דײַן כּבֿוד;</para>
  <para style="q" vid="ISA 26:15">האָסט דערגרײכט אַלע װײַטע עקן פֿון דער לאַנד.<verse eid="ISA 26:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 26:16" />ה׳, אין נױט האָבן זײ דיך דערמאָנט,</para>
  <para style="q" vid="ISA 26:16">זײ האָבן אױסגעגאָסן אַ שטיל געבעט,</para>
  <para style="q" vid="ISA 26:16">װען דײַן שטראָף איז געװען אױף זײ.<verse eid="ISA 26:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 26:17" />װי אַ טראָגעדיקע װאָס גײט צו קינד,</para>
  <para style="q" vid="ISA 26:17">דרײט זיך, שרײַט אין אירע װײען,</para>
  <para style="q" vid="ISA 26:17">אַזױ זײַנען מיר געװען פֿאַר דיר, ה׳.<verse eid="ISA 26:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 26:18" />מיר האָבן געטראָגן, מיר האָבן געװײטאָקט,</para>
  <para style="q" vid="ISA 26:18">און אַזױ װי מיר װאָלטן װינט געבאָרן;</para>
  <para style="q" vid="ISA 26:18">קײן ישועות האָבן מיר נישט אױסגעװירקט אין לאַנד,</para>
  <para style="q" vid="ISA 26:18">און נישט אױפֿגעלעבט האָבן די באַװױנער פֿון דער װעלט.<verse eid="ISA 26:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 26:19" />דײַנע טױטע װעלן זײ זײַן לעבעדיק,</para>
  <para style="q" vid="ISA 26:19">צוזאַמען מיט מײַן טױטן לײַב װעלע זײ אױפֿשטײן;</para>
  <para style="q" vid="ISA 26:19">װאַכט אױף, און זינגט, איר װאָס רוט אין דעם שטױב!</para>
  <para style="q" vid="ISA 26:19">װאָרעם דײַן טױ איז װי דער טױ פֿון פֿרימאָרגן,</para>
  <para style="q" vid="ISA 26:19">און די ערד װעט אַרױסװאַרפֿן די טױטע.<verse eid="ISA 26:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 26:20" />קום, מײַן פֿאָלק, גײ אַרײַן אין דײַנע קאַמערן,</para>
  <para style="q" vid="ISA 26:20">און פֿאַרשליס דײַן טיר הינטער דיר;</para>
  <para style="q" vid="ISA 26:20">באַהאַלט זיך אױף אַ קלײן װײַלע,</para>
  <para style="q" vid="ISA 26:20">ביז דער צאָרן װעט אַריבער.<verse eid="ISA 26:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 26:21" />װאָרעם זע, ה׳ גײט אַרױס פֿון זײַן אָרט,</para>
  <para style="q" vid="ISA 26:21">צו באַשטראָפֿן די באַװױנער פֿון דער ערד פֿאַר זײער זינד,</para>
  <para style="q" vid="ISA 26:21">און די ערד װעט אַנטפּלעקן איר בלוט,</para>
  <para style="q" vid="ISA 26:21">און װעט מער נישט פֿאַרדעקן אירע הרוּגים.<verse eid="ISA 26:21" /></para>
  <chapter eid="ISA 26" />
  <chapter number="27" style="c" pubnumber="כז" sid="ISA 27" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 27:1" />אין יענעם טאָג װעט ה׳ באַשטראָפֿן</para>
  <para style="q" vid="ISA 27:1">מיט זײַן האַרטער און גרױסער און שטאַרקער שװערד,</para>
  <para style="q" vid="ISA 27:1">דעם לִויָתן, די לױפֿיקע שלאַנג,</para>
  <para style="q" vid="ISA 27:1">און דעם לִויָתן, די געדרײטע שלאַנג;</para>
  <para style="q" vid="ISA 27:1">און ער װעט טײטן דעם קראָקאָדיל װאָס אין ים.<verse eid="ISA 27:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 27:2" />אין יענעם טאָג זינגט צו איר:</para>
  <para style="q" vid="ISA 27:2">װײַנגאָרטן פֿון שױמיקן װײַן!<verse eid="ISA 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 27:3" />איך ה׳ בין זײַן היטער,</para>
  <para style="q" vid="ISA 27:3">אַלע רגע באַװאַסער איך אים;</para>
  <para style="q" vid="ISA 27:3">טאָמער װעט מען אים בײז טאָן,</para>
  <para style="q" vid="ISA 27:3">אים היט איך בײַ נאַכט און בײַ טאָג.<verse eid="ISA 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 27:4" />קײן צאָרן איז נישטאָ אין מיר;</para>
  <para style="q" vid="ISA 27:4">װען דאָס איז מיר דערנער און װילדגעװעקס!</para>
  <para style="q" vid="ISA 27:4">איך װאָלט אין מלחמה געטרעטן דערױף;</para>
  <para style="q" vid="ISA 27:4">איך װאָלט עס פֿאַרברענט מיט אַנאַנדער.<verse eid="ISA 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 27:5" />װען ער זאָל זיך נאָר האַלטן אָן מײַן שטאַרקײט,</para>
  <para style="q" vid="ISA 27:5">מאַכן שלום מיט מיר,</para>
  <para style="q" vid="ISA 27:5">מיט מיר שלום מאַכן!<verse eid="ISA 27:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 27:6" />אין די קומעדיקע טעג װעט זיך אײַנװאָרצלען יעקבֿ,</para>
  <para style="q" vid="ISA 27:6">שפּראָצן און בליִען װעט יִשׂרָאֵל,</para>
  <para style="q" vid="ISA 27:6">און דאָס געזיכט פֿון דער װעלט װעט פֿול זײַן מיט פֿרוכט.<verse eid="ISA 27:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 27:7" />האָט ער אים געשלאָגן װי ער האָט זײַן שלעגער געשלאָגן?</para>
  <para style="q" vid="ISA 27:7">אָדער איז ער װי די טײטונג פֿון זײַנע געטײטע געטײט געװאָרן?<verse eid="ISA 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 27:8" />װען פֿול די מאָס, באַשטראָפֿסטו זי מיט אַװעקשיקן;</para>
  <para style="q" vid="ISA 27:8">ער האָט זי פֿאַרטריבן אין זײַן שװער געמיט</para>
  <para style="q" vid="ISA 27:8">אין טאָג פֿון מזרח-װינט.<verse eid="ISA 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 27:9" />דערום װעט דערמיט פֿאַרגעבן װערן די זינד פֿון יעקבֿ,</para>
  <para style="q" vid="ISA 27:9">און דאָס איז אַל דער אָפּצאָל פֿאַר אָפּטאָן זײַן חטא:</para>
  <para style="q" vid="ISA 27:9">װען ער װעט מאַכן אַלע מזבח-שטײנער</para>
  <para style="q" vid="ISA 27:9">װי קאַלכשטײנער צעהאַקטע,</para>
  <para style="q" vid="ISA 27:9">אַז מער זאָלן נישט אױפֿשטײן</para>
  <para style="q" vid="ISA 27:9">קײן געצנבײמער און קײן זונזײַלן.<verse eid="ISA 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 27:10" />װאָרעם די באַפֿעסטיקטע שטאָט איז אַלײן,</para>
  <para style="q" vid="ISA 27:10">אַ װױנונג אַװעקגעװאָרפֿן און פֿאַרלאָזט װי אַ מדבר;</para>
  <para style="q" vid="ISA 27:10">דאָרט װעט זיך פֿיטערן אַ קאַלב, און דאָרט װעט עס הױערן,</para>
  <para style="q" vid="ISA 27:10">און פֿאַרלענדן אירע צװײַגן.<verse eid="ISA 27:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 27:11" />װען אירע ריטלעך זײַנען פֿאַרדאַרט,</para>
  <para style="q" vid="ISA 27:11">װעלן זײ אָפּגעבראָכן װערן;</para>
  <para style="q" vid="ISA 27:11">װײַבער קומען און צינדן זי אָן.</para>
  <para style="q" vid="ISA 27:11">װאָרעם אַ פֿאָלק אָן פֿאַרשטאַנדיקײט איז דאָס;</para>
  <para style="q" vid="ISA 27:11">דערום װעט אים נישט דערבאַרעמען זײַן בורא,</para>
  <para style="q" vid="ISA 27:11">און זײַן באַשעפֿער װעט אים נישט לײַטזעליקן.<verse eid="ISA 27:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="ISA 27:12" />און עס װעט זײַן אין יענעם טאָג, װעט ה׳ אָפּקלאַפּן זײַן פֿרוכט פֿון שטראָם פֿון דעם טײַך, ביז דעם טײַך פֿון מִצרַיִם, און איר װעט אױפֿגעקליבן װערן אײנציק-אײנציקװײַז, קינדער פֿון יִשׂרָאֵל. <verse eid="ISA 27:12" /><verse number="13" style="v" sid="ISA 27:13" />און עס װעט זײַן אין יענעם טאָג, װעט געבלאָזן װערן אין אַ גרױסן שופֿר, און עס װעלן קומען די פֿאַרלאָרענע אין לאַנד אשור, און די פֿאַרשטױסענע אין לאַנד מִצרַיִם, און זײ װעלן זיך בוקן צו ה׳ אױפֿן הײליקן באַרג אין ירושָלַיִם.<verse eid="ISA 27:13" /></para>
  <chapter eid="ISA 27" />
  <chapter number="28" style="c" pubnumber="כח" sid="ISA 28" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 28:1" />װײ, די שטאָלצע קרױן</para>
  <para style="q" vid="ISA 28:1">פֿון די שכּורים פֿון אפֿרים,</para>
  <para style="q" vid="ISA 28:1">און די װעלקעדיקע בליִעכץ</para>
  <para style="q" vid="ISA 28:1">פֿון זײַן פּראַכטיקער שײנקײט,</para>
  <para style="q" vid="ISA 28:1">װאָס אױפֿן שטאָלצבאַזאַלבטן קאָפּ</para>
  <para style="q" vid="ISA 28:1">פֿון די װײַנפֿאַרטומלטע!<verse eid="ISA 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 28:2" />זע, אֲדֹנָי האָט אַ שטאַרקן און אַ מאַכטיקן,</para>
  <para style="q" vid="ISA 28:2">װי אַ האָגלגעװיטער, אַ שטורעם פֿון צעשטערונג,</para>
  <para style="q" vid="ISA 28:2">װי אַ שטראָם פֿון שטאַרקע, פֿלײציקע װאַסערן,</para>
  <para style="q" vid="ISA 28:2">װאָס לײגט צו דער ערד מיט געװאַלט.<verse eid="ISA 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 28:3" />מיט די פֿיס װעט צעטרעטן װערן</para>
  <para style="q" vid="ISA 28:3">די שטאָלצע קרױן פֿון די שכּורים פֿון אפֿרים.<verse eid="ISA 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 28:4" />און די װעלקעדיקע בליִעכץ פֿון זײַן פּראַכטיקער שײנקײט,</para>
  <para style="q" vid="ISA 28:4">װאָס אױפֿן שטאָלצבאַזאַלבטן קאָפּ,</para>
  <para style="q" vid="ISA 28:4">װעט זײַן װי אַן ערשטפֿרוכט פֿאַר זומער,</para>
  <para style="q" vid="ISA 28:4">װאָס אַז דער זעער דערזעט זי,</para>
  <para style="q" vid="ISA 28:4">שלינגט ער זי אײַן װען זי איז נאָך אין זײַן האַנט.<verse eid="ISA 28:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 28:5" />אין יענעם טאָג װעט ה׳ צבָֿאוֹת זײַן</para>
  <para style="q" vid="ISA 28:5">פֿאַר אַ קרױן פֿון שײנקײט,</para>
  <para style="q" vid="ISA 28:5">און פֿאַר אַ קראַנץ פֿון פּראַכטיקײט,</para>
  <para style="q" vid="ISA 28:5">פֿאַר דעם איבערבלײַב פֿון זײַן פֿאָלק,<verse eid="ISA 28:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 28:6" />און פֿאַר אַ גײַסט פֿון משפּט</para>
  <para style="q" vid="ISA 28:6">פֿאַר דעם װאָס זיצט איבערן משפּט,</para>
  <para style="q" vid="ISA 28:6">און פֿאַר גבֿורה צו די</para>
  <para style="q" vid="ISA 28:6">װאָס שלאָגן צוריק די מלחמה בײַם טױער.<verse eid="ISA 28:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 28:7" />און אױך די דאָזיקע װאַקלען זיך פֿון װײַן,</para>
  <para style="q" vid="ISA 28:7">און שאָקלען זיך פֿון טרונק;</para>
  <para style="q" vid="ISA 28:7">דער כּהן און דער נבֿיא װאַקלען זיך פֿון טרונק,</para>
  <para style="q" vid="ISA 28:7">זײ זײַנען צעמישט פֿון װײַן,</para>
  <para style="q" vid="ISA 28:7">זײ שאָקלען זיך פֿון טרונק,</para>
  <para style="q" vid="ISA 28:7">זײ װאַקלען זיך אין דער זעונג,</para>
  <para style="q" vid="ISA 28:7">זײ װערן געשטרױכלט בײַם משפּט.<verse eid="ISA 28:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 28:8" />װאָרעם אַלע טישן זײַנען פֿול מיט שמוציקער מײקעכץ,</para>
  <para style="q" vid="ISA 28:8">ביז נישטאָ אַן אָרט אַ רײנער.<verse eid="ISA 28:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 28:9" />װעמען זאָל מען לערנען װיסן?</para>
  <para style="q" vid="ISA 28:9">און װעמען געבן צו פֿאַרשטײן די הערונג?</para>
  <para style="q" vid="ISA 28:9">פֿון מילך אַנטװױנטע?</para>
  <para style="q" vid="ISA 28:9">פֿון ברוסט אַװעקגענומענע?<verse eid="ISA 28:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 28:10" />װאָרעם עס איז אַ געבאָט צו אַ געבאָט, אַ געבאָט צו אַ געבאָט,</para>
  <para style="q" vid="ISA 28:10">אַ שטריך צו אַ שטריך, אַ שטריך צו אַ שטריך,</para>
  <para style="q" vid="ISA 28:10">אַ ביסל דאָ, אַ ביסעל דאָרט.<verse eid="ISA 28:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 28:11" />װאָרעם מיט אַ שטאַמלדיקער ליפּ, און מיט אַ פֿרעמדן לשון,</para>
  <para style="q" vid="ISA 28:11">מוז מען רעדן צו דעם דאָזיקן פֿאָלק,<verse eid="ISA 28:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 28:12" />װאָס מע האָט צו זײ געזאָגט: דאָס איז די רוּונג,</para>
  <para style="q" vid="ISA 28:12">מאַכט רוען דעם מידן;</para>
  <para style="q" vid="ISA 28:12">און דאָס איז די מנוחה;</para>
  <para style="q" vid="ISA 28:12">אָבער זײ האָבן נישט געװאָלט הערן.<verse eid="ISA 28:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 28:13" />און דאָס װאָרט פֿון ה׳ איז בײַ זײ</para>
  <para style="q" vid="ISA 28:13">אַ געבאָט צו אַ געבאָט, אַ געבאָט צו אַ געבאָט,</para>
  <para style="q" vid="ISA 28:13">אַ שטריך צו אַ שטריך, אַ שטריך צו אַ שטריך,</para>
  <para style="q" vid="ISA 28:13">אַ ביסל דאָ, אַ ביסל דאָרט;</para>
  <para style="q" vid="ISA 28:13">כּדי זײ זאָלן גײן און געשטרױכלט װערן אַהינטער,</para>
  <para style="q" vid="ISA 28:13">און צעבראָכן און געפֿאַנגען און באַצװוּנגען װערן.<verse eid="ISA 28:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 28:14" />דערום הערט דאָס װאָרט פֿון ה׳, איר לײַט פֿון געשפּעט,</para>
  <para style="q" vid="ISA 28:14">איר װערטלזאָגער פֿון דאָזיקן פֿאָלק װאָס אין ירושָלַיִם:<verse eid="ISA 28:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 28:15" />װײַל איר האָט געזאָגט:</para>
  <para style="q" vid="ISA 28:15">מיר האָבן געשלאָסן אַ ברית מיטן טױט,</para>
  <para style="q" vid="ISA 28:15">און מיט שְׁאֹול האָבן מיר אַן אָפּמאַך געמאַכט;</para>
  <para style="q" vid="ISA 28:15">אַז די פֿלײציקע רוט װעט דורכגײן,</para>
  <para style="q" vid="ISA 28:15">װעט זי צו אונדז נישט קומען,</para>
  <para style="q" vid="ISA 28:15">װאָרעם מיר האָבן ליגן געמאַכט אונדזער באַשיצונג,</para>
  <para style="q" vid="ISA 28:15">און אין פֿאַלשקײט האָבן מיר זיך פֿאַרבאָרגן;<verse eid="ISA 28:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 28:16" />דערום האָט אֲדֹנָי ה׳ אַזױ געזאָגט:</para>
  <para style="q" vid="ISA 28:16">זע, איך גרונטפֿעסט אין צִיוֹן אַ שטײן,</para>
  <para style="q" vid="ISA 28:16">אַ געפּרוּװטן שטײן, אַ טײַערן װינקל, אַ פֿעסטן גרונטפֿעסט;</para>
  <para style="q" vid="ISA 28:16">דער װאָס גלױבט, זאָל נישט אײַלן.<verse eid="ISA 28:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 28:17" />און איך װעל מאַכן גערעכטיקײט פֿאַר אַ מעסטשנור,</para>
  <para style="q" vid="ISA 28:17">און רעכטפֿאַרטיקײט פֿאַר אַ בױגעװיכט;</para>
  <para style="q" vid="ISA 28:17">און אַ האָגל װעט אַװעקקערן די באַשיצונג פֿון ליגן,</para>
  <para style="q" vid="ISA 28:17">און די פֿאַרבאָרגעניש װעלן װאַסערן אַװעקפֿלײצן.<verse eid="ISA 28:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 28:18" />און אָפּגעמעקט װעט װערן אײַער ברית מיטן טױט,</para>
  <para style="q" vid="ISA 28:18">און אײַער אָפּמאַך מיט דער שְׁאֹול װעט נישט באַשטײן.</para>
  <para style="q" vid="ISA 28:18">אַז די פֿלײציקע רוט װעט דורכגײן,</para>
  <para style="q" vid="ISA 28:18">װעט איר פֿון איר צעטרעטן װערן.<verse eid="ISA 28:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 28:19" />װי אָפֿט זי גײט דורך װעט זי אײַך נעמען;</para>
  <para style="q" vid="ISA 28:19">װאָרעם פֿרימאָרגן אין פֿרימאָרגן װעט זי דורכגײן,</para>
  <para style="q" vid="ISA 28:19">בײַ טאָג און בײַ נאַכט;</para>
  <para style="q" vid="ISA 28:19">און אַ הױלע שרעק װעט זײַן צו באַנעמען די הערונג.<verse eid="ISA 28:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 28:20" />װאָרעם דאָס בעט איז צו קורץ זיך אױסצוציִען,</para>
  <para style="q" vid="ISA 28:20">און דער צודעק צו שמאָל אַז מע דרײט זיך צונױף.<verse eid="ISA 28:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 28:21" />װאָרעם אַזױ װי אױף באַרג פּרָצים װעט ה׳ אױפֿשטײן,</para>
  <para style="q" vid="ISA 28:21">אַזױ װי אין טאָל פֿון גִבֿעוֹן װעט ער צערענען,</para>
  <para style="q" vid="ISA 28:21">צו טאָן זײַן טוּונג – פֿרעמד איז זײַן טוּונג,</para>
  <para style="q" vid="ISA 28:21">און צו װערקן זײַן װערק – אױסטערליש איז זײַן װערק.<verse eid="ISA 28:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 28:22" />און אַצונד זאָלט איר נישט שפּעטן,</para>
  <para style="q" vid="ISA 28:22">כּדי אײַערע בינדשטריק זאָלן נישט פֿעסטער װערן;</para>
  <para style="q" vid="ISA 28:22">װאָרעם אַ פֿאַרלענדונג און אַ גזר</para>
  <para style="q" vid="ISA 28:22">האָב איך געהערט פֿון אֲדֹנָי, ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ISA 28:22">אױפֿן גאַנצן לאַנד.<verse eid="ISA 28:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="ISA 28:23" />לײגט צו דאָס אױער, און הערט מײַן קֹול,</para>
  <para style="q" vid="ISA 28:23">פֿאַרנעמט און הערט מײַן װאָרט;<verse eid="ISA 28:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 28:24" />אַקערט דען נאָכאַנאַנד דער אַקערער אױף צו זײען,</para>
  <para style="q" vid="ISA 28:24">און עפֿנט און צעהאַקט זײַן ערד?<verse eid="ISA 28:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 28:25" />פֿאַר װאָר, אַז ער האָט אױסגעגליכן איר אײבערפֿלעך,</para>
  <para style="q" vid="ISA 28:25">צעשפּרײט ער שװאַרצקימל, און קימל װאַרפֿט ער אױס,</para>
  <para style="q" vid="ISA 28:25">און טוט אַרײַן װײץ אין שורות,</para>
  <para style="q" vid="ISA 28:25">און גערשט אױפֿן אָנגעצײכנטן אָרט,</para>
  <para style="q" vid="ISA 28:25">און טונקלװײץ בײַם ראַנד דערפֿון.<verse eid="ISA 28:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 28:26" />װאָרעם אים האָט ריכטיק געלערנט,</para>
  <para style="q" vid="ISA 28:26">אים טוט װײַזן זײַן ג-ט.<verse eid="ISA 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 28:27" />יאָ, נישט מיט אַ דרעששליטן װערט שװאַרצקימל געדראָשן,</para>
  <para style="q" vid="ISA 28:27">און אַ ראָד פֿון אַ װאָגן װערט נישט אױף קימל געדרײט;</para>
  <para style="q" vid="ISA 28:27">נײַערט מיט אַ שטעקן װערט שװאַרצקימל געקלאַפּט,</para>
  <para style="q" vid="ISA 28:27">און קימל מיט אַ רוט.<verse eid="ISA 28:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 28:28" />װערט ברױטקאָרן צעדריקט?</para>
  <para style="q" vid="ISA 28:28">פֿאַר װאָר, נישט אײביק דרעשן דרעשט ער עס;</para>
  <para style="q" vid="ISA 28:28">הגם עס רײַשט דער װאַלץ פֿון זײַן װאָגן מיט זײַנע צאַקן –</para>
  <para style="q" vid="ISA 28:28">צעדריקן װעט ער עס נישט.<verse eid="ISA 28:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 28:29" />דאָס אױך איז אַרױס פֿון ה׳ צבָֿאוֹת;</para>
  <para style="q" vid="ISA 28:29">װוּנדערלעך איז ער אין באַראָט, גרױס איז ער אין חכמה.<verse eid="ISA 28:29" /></para>
  <chapter eid="ISA 28" />
  <chapter number="29" style="c" pubnumber="כט" sid="ISA 29" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 29:1" />װײ, אַריאֵל, אַריאֵל, שטאָט װוּ דָוִד האָט גערוט!</para>
  <para style="q" vid="ISA 29:1">מערט אַ יאָר אױף אַ יאָר,</para>
  <para style="q" vid="ISA 29:1">זאָלן די יוֹם-טובֿים זיך אַרומדרײען,<verse eid="ISA 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 29:2" />און איך װעל דריקן אַריאֵל,</para>
  <para style="q" vid="ISA 29:2">און עס װעט זײַן אַ קלאָג און אַ קלאָגעניש,</para>
  <para style="q" vid="ISA 29:2">און ער װעט מיר זײַן אַזױ װי אַן אַריאֵל.<verse eid="ISA 29:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 29:3" />און איך װעל לאַגערן אַרום דיר װי אַ ראָד,</para>
  <para style="q" vid="ISA 29:3">און װעל דיך באַלעגערן מיט אַן ערדװאַל,</para>
  <para style="q" vid="ISA 29:3">און אױפֿשטעלן אױף דיר באַלעגערװערק.<verse eid="ISA 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 29:4" />און נידעריק פֿון דער ערד װעסטו רעדן,</para>
  <para style="q" vid="ISA 29:4">און טיף פֿון שטױב װעט קומען דײַן װאָרט;</para>
  <para style="q" vid="ISA 29:4">און װי אַ גײַסט פֿון דער ערד װעט זײַן דײַן קֹול,</para>
  <para style="q" vid="ISA 29:4">און פֿון שטױב װעט פּיפּסן דײַן װאָרט.<verse eid="ISA 29:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 29:5" />אָבער די דינע שטױב װעט װערן דער המון פֿון דײַנע פֿײַנט,</para>
  <para style="q" vid="ISA 29:5">און װי שפּרײ װאָס פֿאַרגײט דער המון פֿון די מאַכטיקע;</para>
  <para style="q" vid="ISA 29:5">און פּלוצים-פּלוצלינג װעט עס געשען.<verse eid="ISA 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 29:6" />פֿון ה׳ צבָֿאוֹת װעט קומען די שטראָף,</para>
  <para style="q" vid="ISA 29:6">מיט דונער און מיט ערדציטערניש און גרױס געפּילדער,</para>
  <para style="q" vid="ISA 29:6">שטורעם און געװיטער און פֿלאַמפֿײַער װאָס פֿאַרצערט.<verse eid="ISA 29:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 29:7" />און אַזױ װי אַ חלום, אַ זעונג פֿון דער נאַכט,</para>
  <para style="q" vid="ISA 29:7">װעט זײַן דער המון פֿון אַלע פֿעלקער</para>
  <para style="q" vid="ISA 29:7">װאָס האַלטן מלחמה אױף אַריאֵל –</para>
  <para style="q" vid="ISA 29:7">אי אַלע װאָס האַלטן מלחמה אױף איר,</para>
  <para style="q" vid="ISA 29:7">אי די באַלעגערפֿעסטונג אַרום איר,</para>
  <para style="q" vid="ISA 29:7">אי די װאָס דריקן זי.<verse eid="ISA 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 29:8" />און עס װעט זײַן:</para>
  <para style="q" vid="ISA 29:8">אַזױ װי אַ הונגעריקן חלומט זיך, ערשט ער עסט,</para>
  <para style="q" vid="ISA 29:8">און ער כאַפּט זיך אױף, און זײַן לײַב איז לײדיק,</para>
  <para style="q" vid="ISA 29:8">און אַזױ װי אַ דאָרשטיקן חלומט זיך, ערשט ער טרינקט,</para>
  <para style="q" vid="ISA 29:8">און ער כאַפּט זיך אױף, ערשט ער איז שלאַף,</para>
  <para style="q" vid="ISA 29:8">און זײַן זעל איז פֿאַרשמאַכט,</para>
  <para style="q" vid="ISA 29:8">אַזױ װעט זײַן דער המון פֿון אַלע פֿעלקער,</para>
  <para style="q" vid="ISA 29:8">װאָס האַלטן מלחמה אױף באַרג צִיוֹן.<verse eid="ISA 29:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 29:9" />פֿאַרדולט אײַך און זײַט צעדולט!</para>
  <para style="q" vid="ISA 29:9">פֿאַרבלענדט אײַך און זײַט בלינד!</para>
  <para style="q" vid="ISA 29:9">איר װאָס זײַט שכּור און נישט פֿון װײַן,</para>
  <para style="q" vid="ISA 29:9">װאָס שאָקלט זיך און נישט פֿון טרונק.<verse eid="ISA 29:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 29:10" />װאָרעם ה׳ האָט אױסגעגאָסן אױף אײַך</para>
  <para style="q" vid="ISA 29:10">אַ גײַסט פֿון הינערפּלעט,</para>
  <para style="q" vid="ISA 29:10">און האָט צוגעמאַכט אײַערע אױגן, די נבֿיאים,</para>
  <para style="q" vid="ISA 29:10">און אײַערע קעפּ, די זעערס, האָט ער פֿאַרדעקט.<verse eid="ISA 29:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="ISA 29:11" />און די זעונג פֿון אַלץ דינג איז פֿאַר אײַך אַזױ װי װערטער פֿון אַ פֿאַרחתמעטן געשריפֿטס, װאָס אַז מע גיט עס צו דעם װאָס קען געשריפֿטס, אַזױ צו זאָגן: לײען דאָס, איך בעט דיך, זאָגט ער: איך קען נישט, װאָרעם עס איז פֿאַרחתמעט. <verse eid="ISA 29:11" /><verse number="12" style="v" sid="ISA 29:12" />און אַז דאָס געשריפֿטס װערט געגעבן צו דעם װאָס קען נישט קײן געשריפֿטס, אַזױ צו זאָגן: לײען דאָס, איך בעט דיך, זאָגט ער: איך קען נישט קײן געשריפֿטס.<verse eid="ISA 29:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 29:13" />און אֲדֹנָי האָט געזאָגט:</para>
  <para style="q" vid="ISA 29:13">װײַל דאָס דאָזיקע פֿאָלק האָט גענענט מיט זײַן מױל,</para>
  <para style="q" vid="ISA 29:13">און מיט זײַנע ליפּן מיך געערלעכט,</para>
  <para style="q" vid="ISA 29:13">אָבער זײַן האַרץ האָט ער דערװײַטערט פֿון מיר,</para>
  <para style="q" vid="ISA 29:13">און זײער מורא פֿאַר מיר</para>
  <para style="q" vid="ISA 29:13">איז װי אַן אײַנגעלערנט געבאָט פֿון מענטשן,<verse eid="ISA 29:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 29:14" />דערום זע, איך טו נאָך מער פֿאַרװוּנדערן דאָס דאָזיקע פֿאָלק,</para>
  <para style="q" vid="ISA 29:14">װוּנדערלעך פֿאַרװוּנדערן;</para>
  <para style="q" vid="ISA 29:14">און פֿאַרלאָרן װערן װעט די חכמה פֿון זײַנע חכמים,</para>
  <para style="q" vid="ISA 29:14">און די פֿאַרשטאַנדיקײט פֿון זײַנע פֿאַרשטאַנדיקע װעט פֿאַרהױלן װערן.<verse eid="ISA 29:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 29:15" />װײ, די װאָס פֿאַרהױלן טיף זײער באַראָט פֿון ה׳,</para>
  <para style="q" vid="ISA 29:15">און אין דער פֿינצטער זײַנען זײערע מעשׂים,</para>
  <para style="q" vid="ISA 29:15">און זײ זאָגן: װער זעט אונדז?</para>
  <para style="q" vid="ISA 29:15">און װער װײס אונדז?<verse eid="ISA 29:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 29:16" />די פֿאַרקערטקײט אײַערע!</para>
  <para style="q" vid="ISA 29:16">צי איז דער טעפּער װי לײם גערעכנט,</para>
  <para style="q" vid="ISA 29:16">אַז דאָס װערק זאָל זאָגן אױף זײַן מײַנסטער:</para>
  <para style="q" vid="ISA 29:16">ער האָט מיך נישט געמאַכט?</para>
  <para style="q" vid="ISA 29:16">און דער באַשאַף זאָל זאָגן אױף זײַן באַשעפֿער:</para>
  <para style="q" vid="ISA 29:16">ער פֿאַרשטײט נישט?<verse eid="ISA 29:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 29:17" />פֿאַר װאָר, אין נאָך אַ קלײן װײַלע,</para>
  <para style="q" vid="ISA 29:17">װעט דער לבֿנוֹן פֿאַרקערט װערן אין אַ פֿרוכטגאָרטן,</para>
  <para style="q" vid="ISA 29:17">און דער פֿרוכטגאָרטן װעט פֿאַר אַ װאַלד גערעכנט װערן.<verse eid="ISA 29:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 29:18" />און די טױבע אין יענעם טאָג</para>
  <para style="q" vid="ISA 29:18">װעלן הערן די װערטער פֿון אַ בוך,</para>
  <para style="q" vid="ISA 29:18">און פֿון חושך און פֿינצטערניש</para>
  <para style="q" vid="ISA 29:18">װעלן זען די אױגן פֿון בלינדע.<verse eid="ISA 29:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 29:19" />און די פֿאַרליטענע װעלן מערן זײער שׂימחה אין ה׳,</para>
  <para style="q" vid="ISA 29:19">און די באַדערפֿטיקע צװישן מענטשן</para>
  <para style="q" vid="ISA 29:19">װעלן מיטן הײליקן פֿון יִשׂרָאֵל זיך פֿרײען.<verse eid="ISA 29:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 29:20" />װאָרעם אַװעק דער מאַכטיקער,</para>
  <para style="q" vid="ISA 29:20">און פֿאַרלענדט װעט זײַן דער שפּעטער,</para>
  <para style="q" vid="ISA 29:20">און פֿאַרשניטן אַלע װאָס לױערן אױף אומרעכט;<verse eid="ISA 29:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 29:21" />די װאָס מאַכן שולדיק אַ מענטשן מיט אַ װאָרט,</para>
  <para style="q" vid="ISA 29:21">און דעם שטראָפֿזאָגער לײגן זײ אַ שטרױכלונג אין טױער,</para>
  <para style="q" vid="ISA 29:21">און פֿאַרדרײען מיט נישט דעם גערעכטן.<verse eid="ISA 29:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="ISA 29:22" />דערום האָט ה׳, װאָס האָט אױסגעלײזט אבֿרהמען, אַזױ געזאָגט אױפֿן הױז פֿון יעקבֿ:</para>
  <para style="b" vid="ISA 29:22" />
  <para style="q" vid="ISA 29:22">אַצונד װעט נישט פֿאַרשעמט װערן יעקבֿ,</para>
  <para style="q" vid="ISA 29:22">און אַצונד װעט זײַן פּנים נישט בלאַס װערן;<verse eid="ISA 29:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 29:23" />יאָ, אַז ער װעט זען זײַנע קינדער,</para>
  <para style="q" vid="ISA 29:23">דאָס װערק פֿון מײַנע הענט, אין זײַן מיט,</para>
  <para style="q" vid="ISA 29:23">װי זײ הײליקן מײַן נאָמען;</para>
  <para style="q" vid="ISA 29:23">װאָרעם זײ װעלן הײליקן דעם הײליקן פֿון יעקבֿ,</para>
  <para style="q" vid="ISA 29:23">און אלוקי יִשׂרָאֵל װעלן זײ פֿאָרכטן.<verse eid="ISA 29:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 29:24" />און די פֿאַרפֿירטע אין גײַסט װעלן װיסן צו פֿאַרשטײן,</para>
  <para style="q" vid="ISA 29:24">און די מורמלער װעלן לערנען אַ מוסר.<verse eid="ISA 29:24" /></para>
  <chapter eid="ISA 29" />
  <chapter number="30" style="c" pubnumber="ל" sid="ISA 30" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 30:1" />װײ, קינדער אָפּקערער, זאָגט ה׳,</para>
  <para style="q" vid="ISA 30:1">צו מאַכן עצות װאָס נישט פֿון מיר,</para>
  <para style="q" vid="ISA 30:1">און צו װעבן געװעבן װאָס נישט מײַן גײַסט,</para>
  <para style="q" vid="ISA 30:1">כּדי צו מערן זינד אױף זינד!<verse eid="ISA 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 30:2" />די װאָס גײען נידערן קײן מִצרַיִם,</para>
  <para style="q" vid="ISA 30:2">און מײַן מױל האָבן זײ נישט געפֿרעגט;</para>
  <para style="q" vid="ISA 30:2">זיך צו שיצן אין דער באַשיצונג פֿון פַּרעהן,</para>
  <para style="q" vid="ISA 30:2">און זיך צו באַשירעמען אין שאָטן פֿון מִצרַיִם.<verse eid="ISA 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 30:3" />אָבער די באַשיצונג פֿון פַּרעהן װעט אײַך װערן צו בושה,</para>
  <para style="q" vid="ISA 30:3">און די באַשירעמונג אין שאָטן פֿון מִצרַיִם צו שאַנד.<verse eid="ISA 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 30:4" />װאָרעם אין צוֹעַן זײַנען געװען זײַנע האַרן,</para>
  <para style="q" vid="ISA 30:4">און זײַנע שלוחים טוען קײן חָנֵס דערגרײכן.<verse eid="ISA 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 30:5" />אַלע װעלן זײ זיך שעמען</para>
  <para style="q" vid="ISA 30:5">איבער דעם פֿאָלק װאָס קען זײ נישט נוצן,</para>
  <para style="q" vid="ISA 30:5">װאָס זײַנען נישט צו הילף און נישט צו נוץ,</para>
  <para style="q" vid="ISA 30:5">נאָר צו בושה און צו חרפּה.<verse eid="ISA 30:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="ISA 30:6" />די נבֿואה אױפֿן בהמות פֿון דָרום:</para>
  <para style="b" vid="ISA 30:6" />
  <para style="q" vid="ISA 30:6">דורך אַ לאַנד פֿון נױט און אַנגסט,</para>
  <para style="q" vid="ISA 30:6">װאָס די לײבינטע און דער לײב איז פֿון דאָרטן,</para>
  <para style="q" vid="ISA 30:6">דער פּיפּערנאָטער און דער פֿליִעדיקער לינדװאָרעם,</para>
  <para style="q" vid="ISA 30:6">פֿירן זײ אױפֿן רוקן פֿון יונגאײזלען זײערע פֿאַרמעגנס,</para>
  <para style="q" vid="ISA 30:6">און אױפֿן הױקער פֿון קעמלען זײערע אוֹצרות,</para>
  <para style="q" vid="ISA 30:6">צו אַ פֿאָלק װאָס קען נישט נוצן.<verse eid="ISA 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 30:7" />און מִצרַיִם איז הבֿל און לײדיקײט;</para>
  <para style="q" vid="ISA 30:7">דערפֿאַר האָב איך דאָס גערופֿן: רַהַב — זײ זײַנען אין רו.<verse eid="ISA 30:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 30:8" />אַצונד קום פֿאַרשרײַב עס אױף אַ טאָװל בײַ זײ,</para>
  <para style="q" vid="ISA 30:8">און אין אַ בוך פֿאַרצײכן עס,</para>
  <para style="q" vid="ISA 30:8">און עס זאָל זײַן ביזן לעצטן טאָג,</para>
  <para style="q" vid="ISA 30:8">אױף אײביק און שטענדיק.<verse eid="ISA 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 30:9" />װאָרעם אַ װידערשפּעניק פֿאָלק איז דאָס,</para>
  <para style="q" vid="ISA 30:9">קינדער לײקענער,</para>
  <para style="q" vid="ISA 30:9">קינדער װאָס װילן נישט הערן</para>
  <para style="q" vid="ISA 30:9">די לערנונג פֿון ה׳;<verse eid="ISA 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 30:10" />װאָס זאָגן צו די נבֿיאים: איר זאָלט נישט נבֿיאות זאָגן;</para>
  <para style="q" vid="ISA 30:10">און צו די זעערס:</para>
  <para style="q" vid="ISA 30:10">איר זאָלט אונדז נישט זען די ריכטיקײט;</para>
  <para style="q" vid="ISA 30:10">רעדט אונדז גלאַטע רײד,</para>
  <para style="q" vid="ISA 30:10">זעט גענאַרענישן.<verse eid="ISA 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 30:11" />קערט אײַך אָפּ פֿון װעג,</para>
  <para style="q" vid="ISA 30:11">נײַגט אײַך אָפּ פֿון שטעג,</para>
  <para style="q" vid="ISA 30:11">טוט אָפּ פֿון אונדזער פּנים דעם הײליקן פֿון יִשׂרָאֵל!<verse eid="ISA 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 30:12" />דערום האָט דער הײליקער פֿון יִשׂרָאֵל אַזױ געזאָגט:</para>
  <para style="q" vid="ISA 30:12">װײַל איר פֿאַראַכט דאָס דאָזיקע װאָרט,</para>
  <para style="q" vid="ISA 30:12">און איר האָט אײַך פֿאַרזיכערט אױף רױב און באַטרוג,</para>
  <para style="q" vid="ISA 30:12">און אײַך אָנגעלענט דערױף,<verse eid="ISA 30:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 30:13" />דערום װעט אײַך זײַן די דאָזיקע זינד</para>
  <para style="q" vid="ISA 30:13">אַזױ װי אַן אָנקרײטיקער בראָך</para>
  <para style="q" vid="ISA 30:13">אַנטפּלעקט אין אַ הױכער מױער,</para>
  <para style="q" vid="ISA 30:13">װאָס פּלוצים-פּלוצלינג װעט קומען איר צעברעכעניש.<verse eid="ISA 30:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 30:14" />און ער װעט זי צעברעכן װי מע צעברעכט</para>
  <para style="q" vid="ISA 30:14">אַ טעפּערגעפֿעס צעהאַקן און נישט שױנען;</para>
  <para style="q" vid="ISA 30:14">און אין אירע שטיקער װעט זיך נישט געפֿינען אַ שאַרבן</para>
  <para style="q" vid="ISA 30:14">אױף אַרױסשאַרן פֿײַער פֿון אױװן,</para>
  <para style="q" vid="ISA 30:14">אָדער אָנשעפּן װאַסער פֿון גרוב.<verse eid="ISA 30:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 30:15" />װאָרעם אַזױ האָט געזאָגט</para>
  <para style="q" vid="ISA 30:15">אֲדֹנָי ה׳, דער הײליקער פֿון יִשׂרָאֵל:</para>
  <para style="q" vid="ISA 30:15">דורך תּשובֿה און מנוחה װעט איר געהאָלפֿן װערן,</para>
  <para style="q" vid="ISA 30:15">אין רו און זיכערקײט װעט זײַן אײַער גבֿורה;</para>
  <para style="q" vid="ISA 30:15">אָבער איר האָט נישט געװאָלט.<verse eid="ISA 30:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 30:16" />און איר האָט געזאָגט:</para>
  <para style="q" vid="ISA 30:16">נײן, נײַערט אױף פֿערד װעלן מיר לױפֿן;</para>
  <para style="q" vid="ISA 30:16">דערום װעט איר לױפֿן;</para>
  <para style="q" vid="ISA 30:16">און: אױף פֿלינקע װעלן מיר רײַטן;</para>
  <para style="q" vid="ISA 30:16">דערום װעלן פֿלינק זײַן אײַערע נאָכיאָגערס.<verse eid="ISA 30:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 30:17" />אַ טױזנט פֿאַר דעם אָנגעשרײ פֿון אײנעם,</para>
  <para style="q" vid="ISA 30:17">פֿאַר דעם אָנגעשרײ פֿון פֿינף װעט איר אַלע אַנטלױפֿן;</para>
  <para style="q" vid="ISA 30:17">ביז װאַנען איר װעט בלײַבן װי אַ שטאַנג אױף אַ שפּיץ באַרג,</para>
  <para style="q" vid="ISA 30:17">און װי אַ פֿאָן אױף אַ הױכן אָרט.<verse eid="ISA 30:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 30:18" />אָבער פֿון דעסט װעגן טוט ה׳ האַרן</para>
  <para style="q" vid="ISA 30:18">אײַך צו לײַטזעליקן,</para>
  <para style="q" vid="ISA 30:18">און פֿון דעסט װעגן טוט ער גאַרן</para>
  <para style="q" vid="ISA 30:18">אײַך צו דערבאַרעמען;</para>
  <para style="q" vid="ISA 30:18">װאָרעם אַ ג-ט פֿון גערעכטיקײט איז ה׳,</para>
  <para style="q" vid="ISA 30:18">װױל צו די װאָס האַרן אױף אים.<verse eid="ISA 30:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="ISA 30:19" />װאָרעם דו פֿאָלק װאָס זיצסט אין צִיוֹן, אין ירושָלַיִם, װײנען װעסטו מער נישט װײנען; לײַטזעליקן װעט ער דיך לײַטזעליקן אױף דעם קֹול פֿון דײַן געשרײ, װי ער װעט הערן, טוט ער דיר ענטפֿערן. <verse eid="ISA 30:19" /><verse number="20" style="v" sid="ISA 30:20" />און אֲדֹנָי װעט אײַך געבן קאַרג ברױט און קנאַפּ װאַסער, אָבער דײַן לערער װעט מער נישט זײַן פֿאַרהױלן, און דײַנע אױגן װעלן זען דײַן לערער. <verse eid="ISA 30:20" /><verse number="21" style="v" sid="ISA 30:21" />און דײַנע אױערן װעלן הערן אַ װאָרט הינטער דיר, אַזױ צו זאָגן: דאָס איז דער װעג, גײט אױף אים, סײַ איר װעט זיך קערן רעכטס, און סײַ איר װעט זיך קערן לינקס. <verse eid="ISA 30:21" /><verse number="22" style="v" sid="ISA 30:22" />און איר װעט פֿאַראומרײניקן דעם איבערצוג פֿון דײַנע זילבערגעצן, און דעם באַקלײד פֿון דײַן געגאָסענעם גאָלדגעץ. אַװעקװאַרפֿן װעסטו זײ אַזױ װי אומרײנס; אַרױס! װעסטו זאָגן דערצו. <verse eid="ISA 30:22" /><verse number="23" style="v" sid="ISA 30:23" />און ער װעט געבן רעגן פֿאַר דײַן זריעה װאָס דו װעסט זײען אין דער ערד, און דאָס ברױט פֿון דער תּבֿואה פֿון דער ערד װעט זײַן פֿעט און זאַפֿטיק. דײַן פֿיך װעט זיך פֿיטערן אין יענעם טאָג אױף אַ לאָנקע אַ ברײטער. <verse eid="ISA 30:23" /><verse number="24" style="v" sid="ISA 30:24" />און די רינדער און די יונגאײזלען װאָס באַאַרבעטן די ערד, װעלן עסן געשמאַקע פֿוטער, װאָס מע װינטשופֿלט מיט אַ װינטגאַפֿל און מיט אַ װינטשופֿל. <verse eid="ISA 30:24" /><verse number="25" style="v" sid="ISA 30:25" />און אױף יעטװעדער הױכן באַרג, און אױף יעטװעדער דערהױבענעם בערגל, װעלן זײַן בעכן, שטראָמען װאַסער, אין דעם טאָג פֿון גרױס טײטונג, װען טורעמס טוען פֿאַלן. <verse eid="ISA 30:25" /><verse number="26" style="v" sid="ISA 30:26" />און דאָס ליכט פֿון דער לבֿנה װעט זײַן װי דאָס ליכט פֿון דער זון, און דאָס ליכט פֿון דער זון װעט זײַן זיבנפֿאַך – װי דאָס ליכט פֿון זיבן טעג, אין דעם טאָג װאָס ה׳ פֿאַרבינדט דעם בראָך פֿון זײַן פֿאָלק, און דעם ריס פֿון זײַן װוּנד טוט ער הײלן.<verse eid="ISA 30:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="ISA 30:27" />זע, דער נאָמען פֿון ה׳ קומט אָן פֿון דער װײַט,</para>
  <para style="q" vid="ISA 30:27">זײַן צאָרן ברענט, און אַ שװערער רױך הײבט זיך אױף;</para>
  <para style="q" vid="ISA 30:27">זײַנע ליפּן זײַנען פֿול מיט צאָרן,</para>
  <para style="q" vid="ISA 30:27">און זײַן צונג װי אַ פֿײַער װאָס פֿאַרצערט;<verse eid="ISA 30:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 30:28" />און זײַן אָטעם װי אַ פֿלײציקער שטראָם,</para>
  <para style="q" vid="ISA 30:28">װאָס גרײכט ביז צום האַלדז;</para>
  <para style="q" vid="ISA 30:28">צו זיפּן די פֿעלקער אין אַ זיפּ פֿון פֿאַרװיסטונג,</para>
  <para style="q" vid="ISA 30:28">מיט אַ פֿאַרפֿיריקער צאַם אױף די באַקן פֿון די אומות.<verse eid="ISA 30:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="ISA 30:29" />אַ געזאַנג װעט בײַ אײַך זײַן, װי אין דער נאַכט װאָס אַ יוֹם-טובֿ װערט געהײליקט, און אַ האַרציקע שׂימחה, װי בײַ דעם װאָס גײט מיט אַ פֿלײט, צו קומען אױפֿן באַרג פֿון ה׳, צום פֿעלדז פֿון יִשׂרָאֵל. <verse eid="ISA 30:29" /><verse number="30" style="v" sid="ISA 30:30" />און ה׳ װעט לאָזן הערן דעם הילך פֿון זײַן קֹול, און װעט װײַזן דעם אַראָפּלאָז פֿון זײַן אָרעם, מיט גרימצאָרן און פֿלאַמפֿײַער װאָס פֿאַרצערט, מיט װאָלקנבראָך און פֿלײצונג און האָגלשטײן. <verse eid="ISA 30:30" /><verse number="31" style="v" sid="ISA 30:31" />װאָרעם פֿון דעם קֹול פֿון ה׳ װעט צעבראָכן װערן אשור, די רוט מיט װאָס ער פֿלעגט שלאָגן. <verse eid="ISA 30:31" /><verse number="32" style="v" sid="ISA 30:32" />און װוּ נאָר עס גײט דורך דער שטעקן פֿון באַשערונג, װאָס ה׳ װעט אַראָפּלאָזן אױף אים, װעט עס זײַן מיט פּױקן און מיט האַרפֿן; און מיט אױפֿגעהױבענע מלחמות װעט ער מלחמה האַלטן אױף זײ. <verse eid="ISA 30:32" /><verse number="33" style="v" sid="ISA 30:33" />װאָרעם אָנגעגרײט פֿון נעכטן איז דער פֿײַעראָרט, יאָ, פֿאַרן מלך איז ער צוגעגרײט, טיף איז ער, ברײט איז ער; זײַן הױפֿן האָט פֿײַער און האָלץ אַ סך, ה׳ס אָטעם טוט ברענען װי אַ טײַך שװעבל דערין.<verse eid="ISA 30:33" /></para>
  <chapter eid="ISA 30" />
  <chapter number="31" style="c" pubnumber="לא" sid="ISA 31" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 31:1" />װײ, די װאָס נידערן קײן מִצרַיִם נאָך הילף,</para>
  <para style="q" vid="ISA 31:1">און אױף פֿערד פֿאַרלאָזן זײ זיך;</para>
  <para style="q" vid="ISA 31:1">און זײ פֿאַרזיכערן זיך אױף רײַטװעגן, װײַל זײ זײַנען פֿיל,</para>
  <para style="q" vid="ISA 31:1">און אױף רײַטער, װײַל זײ זײַנען מאַכטיק זײער;</para>
  <para style="q" vid="ISA 31:1">און זײ קערן זיך נישט צו דעם הײליקן פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="ISA 31:1">און ה׳ טוען זײ נישט זוכן!<verse eid="ISA 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 31:2" />אָבער פֿאַר װאָר, ער איז קלוג, און ער ברענגט דאָס בײז,</para>
  <para style="q" vid="ISA 31:2">און זײַנע װערטער טוט ער נישט אָפּ.</para>
  <para style="q" vid="ISA 31:2">און ער װעט אױפֿשטײן קעגן הױז פֿון די שלעכטסטוער,</para>
  <para style="q" vid="ISA 31:2">און קעגן דער הילף פֿון די װאָס װערקן אומרעכט.<verse eid="ISA 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 31:3" />און די מִצרַיִם זײַנען מענטשן, און נישט אֵל,</para>
  <para style="q" vid="ISA 31:3">און זײערע פֿערד זײַנען פֿלײש, און נישט גײַסט;</para>
  <para style="q" vid="ISA 31:3">און ה׳ װעט אױסשטרעקן זײַן האַנט,</para>
  <para style="q" vid="ISA 31:3">און שטרױכלען װעט דער העלפֿער,</para>
  <para style="q" vid="ISA 31:3">און פֿאַלן װעט דער געהאָלפֿענער,</para>
  <para style="q" vid="ISA 31:3">און אַלע אין אײנעם װעלן זײ פֿאַרלענדט װערן.<verse eid="ISA 31:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 31:4" />װאָרעם אַזױ האָט געזאָגט ה׳ צו מיר:</para>
  <para style="q" vid="ISA 31:4">אַזױ װי דער לײב און דער יונגלײב ברומט איבער זײַן רױב,</para>
  <para style="q" vid="ISA 31:4">הגם אַ פֿולע פּאַסטוכער זײַנען אײַנגעזאַמלט אַרום אים;</para>
  <para style="q" vid="ISA 31:4">פֿאַר זײער קֹול דערשרעקט ער זיך נישט,</para>
  <para style="q" vid="ISA 31:4">און פֿאַר זײער ליאַרעם בײגט ער זיך נישט;</para>
  <para style="q" vid="ISA 31:4">אַזױ װעט ה׳ צבָֿאוֹת נידערן,</para>
  <para style="q" vid="ISA 31:4">צו האַלטן מלחמה אױפֿן באַרג פֿון צִיוֹן</para>
  <para style="q" vid="ISA 31:4">און אױף איר הױכן אָרט.<verse eid="ISA 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 31:5" />װי פֿױגלען פֿלאַטערנדיק,</para>
  <para style="q" vid="ISA 31:5">אַזױ װעט ה׳ צבָֿאוֹת באַשירעמען ירושָלַיִם,</para>
  <para style="q" vid="ISA 31:5">באַשירעמען און מציל זײַן,</para>
  <para style="q" vid="ISA 31:5">פֿאַרשױנען און ראַטעװען.<verse eid="ISA 31:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="ISA 31:6" />קערט אײַך אום צו װעמען איר האָט טיף װידערשפּעניקט, קינדער פֿון יִשׂרָאֵל. <verse eid="ISA 31:6" /><verse number="7" style="v" sid="ISA 31:7" />פֿאַר װאָר, אין יענעם טאָג װעלן זײ פֿאַראַכטן איטלעכער זײַנע אָפּגעטער פֿון זילבער, און זײַנע אָפּגעטער פֿון גאָלד, װאָס אײַערע הענט האָבן אײַך געמאַכט צו זינד.<verse eid="ISA 31:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 31:8" />און אשור װעט פֿאַלן דורך דער שװערד פֿון נישט אַ מאַן,</para>
  <para style="q" vid="ISA 31:8">און די שװערד פֿון נישט אַ מענטשן װעט אים פֿאַרצערן;</para>
  <para style="q" vid="ISA 31:8">און ער װעט אַנטלױפֿן פֿאַרן שװערד,</para>
  <para style="q" vid="ISA 31:8">און זײַנע יונגע לײַט װעלן צו צינדז װערן.<verse eid="ISA 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 31:9" />און זײַן פֿעלדז װעט פֿון מורא פֿאַרגײן,</para>
  <para style="q" vid="ISA 31:9">און אַנגסטן פֿאַר דער פֿאָן װעלן זײַנע האַרן,</para>
  <para style="q" vid="ISA 31:9">זאָגט ה׳, װאָס זײַן פֿײַער איז אין צִיוֹן,</para>
  <para style="q" vid="ISA 31:9">און זײַן אױװן אין ירושָלַיִם.<verse eid="ISA 31:9" /></para>
  <chapter eid="ISA 31" />
  <chapter number="32" style="c" pubnumber="לב" sid="ISA 32" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 32:1" />זע, מיט רעכטפֿאַרטיקײט װעט קיניגן דער קיניג,</para>
  <para style="q" vid="ISA 32:1">און האַרן – זײ װעלן הערשן מיט גערעכטיקײט.<verse eid="ISA 32:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 32:2" />און איטלעכער װעט זײַן</para>
  <para style="q" vid="ISA 32:2">װי אַ באַהעלטעניש פֿון װינט,</para>
  <para style="q" vid="ISA 32:2">און אַ פֿאַרבאָרגעניש פֿון גוסרעגן;</para>
  <para style="q" vid="ISA 32:2">װי אַ בעכן װאַסער אין אַ טריקעניש,</para>
  <para style="q" vid="ISA 32:2">װי דער שאָטן פֿון אַ שװערן פֿעלדז</para>
  <para style="q" vid="ISA 32:2">אין אַ פֿאַרשמאַכטן לאַנד.<verse eid="ISA 32:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 32:3" />און נישט פֿאַרקלעפּט זײַן װעלן די אױגן פֿון די זעער,</para>
  <para style="q" vid="ISA 32:3">און די אױערן פֿון די הערער װעלן פֿאַרנעמען.<verse eid="ISA 32:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 32:4" />און דאָס האַרץ פֿון די איבעראײַלטע װעט פֿאַרשטײן צו װיסן,</para>
  <para style="q" vid="ISA 32:4">און די צונג פֿון די שטאַמלער װעט רעדן געלױפֿיק קלאָר.<verse eid="ISA 32:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 32:5" />און דעם געמײנעם װעט מען נישט רופֿן מער אַדלמאַן,</para>
  <para style="q" vid="ISA 32:5">און אױפֿן גײציקן װעט מען נישט זאָגן מער נַדיבֿן.<verse eid="ISA 32:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 32:6" />װאָרעם דער געמײנער רעדט געמײן,</para>
  <para style="q" vid="ISA 32:6">און זײַן האַרץ אַרבעט אומרעכט, צו טאָן פֿאַלשקײט,</para>
  <para style="q" vid="ISA 32:6">און צו רעדן װעגן ה׳ מיט גענאַר;</para>
  <para style="q" vid="ISA 32:6">צו לאָזן לײדיק דעם לײַב פֿון דעם הונגעריקן,</para>
  <para style="q" vid="ISA 32:6">און דעם טראַנק פֿון דעם דאָרשטיקן צו מינערן.<verse eid="ISA 32:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 32:7" />און דער גײציקער, זײַנע געצײַג זײַנען שלעכט,</para>
  <para style="q" vid="ISA 32:7">בײזע מחשבֿות באַראָט ער,</para>
  <para style="q" vid="ISA 32:7">אומצוברענגען דעם אָרעמאַן מיט רײד פֿון ליגן,</para>
  <para style="q" vid="ISA 32:7">אַפֿילו װען דער אבֿיון טענהט גערעכט.<verse eid="ISA 32:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 32:8" />אָבער דער אַדלמאַן באַראָט אַדלקײט,</para>
  <para style="q" vid="ISA 32:8">און אױף אַדלקײט װעט ער באַשטײן.<verse eid="ISA 32:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 32:9" />איר רויִקע װײַבער, שטײט אױף,</para>
  <para style="q" vid="ISA 32:9">הערט מײַן קֹול, איר זיכערע טעכטער,</para>
  <para style="q" vid="ISA 32:9">פֿאַרנעמט מײַן זאָג.<verse eid="ISA 32:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 32:10" />טעג און יאָרן װעט איר ציטערן,</para>
  <para style="q" vid="ISA 32:10">איר זיכערע,</para>
  <para style="q" vid="ISA 32:10">װאָרעם די לעז איז פֿאַרלענדט,</para>
  <para style="q" vid="ISA 32:10">קײן אײַנזאַמלונג װעט נישט קומען.<verse eid="ISA 32:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 32:11" />שױדערט, איר רויִקע,</para>
  <para style="q" vid="ISA 32:11">ציטערט, איר זיכערע;</para>
  <para style="q" vid="ISA 32:11">טוט אײַך אױס און אַנטבלױזט אײַך,</para>
  <para style="q" vid="ISA 32:11">און גורט זאַק אױף די לענדן,<verse eid="ISA 32:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 32:12" />אױף די בריסט זיך שלאָגנדיק,</para>
  <para style="q" vid="ISA 32:12">איבער די גלוסטיקע פֿעלדער,</para>
  <para style="q" vid="ISA 32:12">איבערן פֿרוכטיקן װײַנשטאָק;<verse eid="ISA 32:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 32:13" />איבער דער ערד פֿון מײַן פֿאָלק,</para>
  <para style="q" vid="ISA 32:13">פֿאַרװאַקסן מיט דערנער און װילדגעװעקס;</para>
  <para style="q" vid="ISA 32:13">יאָ, איבער אַלע הײַזער פֿון לוסטיקײט,</para>
  <para style="q" vid="ISA 32:13">איבערן פֿרײלעכן כּרך.<verse eid="ISA 32:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 32:14" />װאָרעם דער פּאַלאַץ איז פֿאַרלאָזט,</para>
  <para style="q" vid="ISA 32:14">דער טומל פֿון שטאָט האָט אױפֿגעהערט;</para>
  <para style="q" vid="ISA 32:14">דער ערדװאַל און דער טורעם זײַנען פֿאַר הײלן אױף אײביק,</para>
  <para style="q" vid="ISA 32:14">אַ פֿרײד פֿאַר װאַלדאײזלען,</para>
  <para style="q" vid="ISA 32:14">אַ פֿיטערונג פֿאַר סטאַדעס.<verse eid="ISA 32:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 32:15" />ביז אױסגעגאָסן װעט װערן אױף אונדז</para>
  <para style="q" vid="ISA 32:15">דער רוּחַ הקדש פֿון דער הײך,</para>
  <para style="q" vid="ISA 32:15">און דער מדבר װעט װערן אַ פֿרוכטגאָרטן,</para>
  <para style="q" vid="ISA 32:15">און דער פֿרוכטגאָרטן װעט פֿאַר אַ װאַלד גערעכנט װערן.<verse eid="ISA 32:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 32:16" />און אין מדבר װעט רוען גערעכטיקײט,</para>
  <para style="q" vid="ISA 32:16">און רעכטפֿאַרטיקײט װעט װױנען אין פֿרוכטגאָרטן.<verse eid="ISA 32:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 32:17" />און דאָס װערק פֿון רעכטפֿאַרטיקײט װעט זײַן שלום,</para>
  <para style="q" vid="ISA 32:17">און דער אױפֿטו פֿון רעכטפֿאַרטיקײט –</para>
  <para style="q" vid="ISA 32:17">רו און זיכערקײט אױף אײביק.<verse eid="ISA 32:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 32:18" />און מײַן פֿאָלק װעט זיצן אין אַ װױנונג פֿון שלום,</para>
  <para style="q" vid="ISA 32:18">און אין װױנערטער זיכערע,</para>
  <para style="q" vid="ISA 32:18">און אין רוּונגען שטילע.<verse eid="ISA 32:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 32:19" />און מע װעט זיך צעשפּרײטן</para>
  <para style="q" vid="ISA 32:19">אױף דעם אַראָפּגאַנג פֿון װאַלד,</para>
  <para style="q" vid="ISA 32:19">און ביז אין דער נידערונג װעט נידערן די שטאָט.<verse eid="ISA 32:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 32:20" />װױל צו אײַך װאָס זײט בײַ אַלע װאַסערן,</para>
  <para style="q" vid="ISA 32:20">װאָס לאָזט אַרױס פֿרײַ דעם פֿוס פֿון דעם אָקס און דעם אײזל.<verse eid="ISA 32:20" /></para>
  <chapter eid="ISA 32" />
  <chapter number="33" style="c" pubnumber="לג" sid="ISA 33" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 33:1" />װײ, דו פֿאַרװיסטער װאָס װערסט נישט פֿאַרװיסט,</para>
  <para style="q" vid="ISA 33:1">און דו פֿעלשער װאָס מע פֿעלשט נישט אָן דיר!</para>
  <para style="q" vid="ISA 33:1">אַז דו װעסט אױפֿהערן פֿאַרװיסטן, װעסטו פֿאַרװיסט װערן,</para>
  <para style="q" vid="ISA 33:1">אַז דו װעסט ענדיקן פֿעלשן, װעט מען פֿעלשן אָן דיר.<verse eid="ISA 33:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 33:2" />ה׳ לײַטזעליק אונדז,</para>
  <para style="q" vid="ISA 33:2">צו דיר האָבן מיר געהאָפֿט;</para>
  <para style="q" vid="ISA 33:2">זײַ זײער אָרעם אַלע פֿרימאָרגן,</para>
  <para style="q" vid="ISA 33:2">און אונדזער הילף אין צײַט פֿון נױט.<verse eid="ISA 33:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 33:3" />פֿון קֹול פֿון דעם טומל זײַנען די אומות אַנטלאָפֿן,</para>
  <para style="q" vid="ISA 33:3">פֿון דײַן אױפֿהײבן זיך װערן די פֿעלקער צעשפּרײט.<verse eid="ISA 33:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 33:4" />און אױפֿגעקליבן װעט װערן אײַער רױב</para>
  <para style="q" vid="ISA 33:4">װי דער הײשעריק קלײַבט אױף,</para>
  <para style="q" vid="ISA 33:4">װי גרילן שפּרינגען,</para>
  <para style="q" vid="ISA 33:4">טוט מען שפּרינגען דערױף.<verse eid="ISA 33:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 33:5" />דערהױבן איז ה׳, װאָרעם ער רוט אין דער הײך;</para>
  <para style="q" vid="ISA 33:5">ער פֿילט אָן צִיוֹן מיט רעכט און גערעכטיקײט.<verse eid="ISA 33:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 33:6" />און די זיכערקײט פֿון דײַנע צײַטן װעט זײַן</para>
  <para style="q" vid="ISA 33:6">אַ שאַץ מיט ישועות, חכמה און דערקענונג;</para>
  <para style="q" vid="ISA 33:6">מורא פֿאַר ה׳, דאָס װעט זײַן זײַן אוצר.<verse eid="ISA 33:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 33:7" />זע, זײערע העלדן קלאָגן דרױסן,</para>
  <para style="q" vid="ISA 33:7">די שלוחים פֿון שלום טוען ביטער װײנען.<verse eid="ISA 33:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 33:8" />פֿאַרװיסט זײַנען די װעגן,</para>
  <para style="q" vid="ISA 33:8">אױפֿגעהערט דער װעגפֿאָרער;</para>
  <para style="q" vid="ISA 33:8">ער האָט פֿאַרשטערט דעם ברית,</para>
  <para style="q" vid="ISA 33:8">ער האָט פֿאַראַכט די שטעט,</para>
  <para style="q" vid="ISA 33:8">ער אַכט נישט אױף קײן מענטשן.<verse eid="ISA 33:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 33:9" />פֿאַרטרױערט, פֿאַרשניטן איז דאָס לאַנד,</para>
  <para style="q" vid="ISA 33:9">פֿאַרשעמט איז דער לבֿנוֹן, פֿאַרװעלקט;</para>
  <para style="q" vid="ISA 33:9">דער שָרוֹן איז װי אַ מדבר געװאָרן,</para>
  <para style="q" vid="ISA 33:9">און אָפּגעטרײסלט איז בָשָן און כַּרמֶל.<verse eid="ISA 33:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 33:10" />אַצונד װעל איך אױפֿשטײן, זאָגט ה׳,</para>
  <para style="q" vid="ISA 33:10">אַצונד װעל איך זיך דערהײכן,</para>
  <para style="q" vid="ISA 33:10">אַצונד װעל איך זיך אױפֿהײבן.<verse eid="ISA 33:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 33:11" />איר טראָגט שפּרײ, װעט איר געבערן שטרױ;</para>
  <para style="q" vid="ISA 33:11">אײַער אָטעם – אַ פֿײַער װאָס װעט אײַך פֿאַרצערן.<verse eid="ISA 33:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 33:12" />און די פֿעלקער װעלן זײַן װי קאַלך פֿאַרברענטע,</para>
  <para style="q" vid="ISA 33:12">װי דערנער אָפּגעהאַקטע װאָס װערן אין פֿײַער געצונדן.<verse eid="ISA 33:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 33:13" />הערט, איר װײַטע, װאָס איך האָב געטאָן,</para>
  <para style="q" vid="ISA 33:13">און װײסט, איר נאָנטע, מײַן גבֿורה.<verse eid="ISA 33:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 33:14" />עס אַנגסטן אין צִיוֹן די זינדיקע,</para>
  <para style="q" vid="ISA 33:14">אַ ציטערניש האָט אָנגענומען די פֿאַלשע:</para>
  <para style="q" vid="ISA 33:14">װער פֿון אונדז קען װײַלן אין דעם פֿײַער װאָס פֿאַרצערט?</para>
  <para style="q" vid="ISA 33:14">װער פֿון אונדז קען װײַלן אין די אײביקע בראַנדן?<verse eid="ISA 33:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 33:15" />דער װאָס גײט אין רעכטפֿאַרטיקײט, און רעדט ערלעך,</para>
  <para style="q" vid="ISA 33:15">דער װאָס פֿאַראַכט דעם געװין פֿון רױב,</para>
  <para style="q" vid="ISA 33:15">דער װאָס שאָקלט אָפּ זײַנע הענט פֿון אָננעמען שוחד,</para>
  <para style="q" vid="ISA 33:15">דער װאָס פֿאַרשטאָפּט זײַן אױער פֿון הערן װעגן בלוט,</para>
  <para style="q" vid="ISA 33:15">און פֿאַרדריקט זײַנע אױגן פֿון קוקן אױף שלעכטס.<verse eid="ISA 33:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 33:16" />ער װעט רוען אין דער הײך;</para>
  <para style="q" vid="ISA 33:16">פֿעסטונגען פֿון פֿעלדזן װעלן זײַן זײַן באַשיצונג;</para>
  <para style="q" vid="ISA 33:16">זײַן ברױט איז געגעבן, זײַן װאַסער איז זיכער.<verse eid="ISA 33:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 33:17" />דעם מלך אין זײַן שײנקײט װעלן אָנקוקן דײַנע אױגן;</para>
  <para style="q" vid="ISA 33:17">זײ װעלן זען אַ לאַנד פֿון װײַטענישן.<verse eid="ISA 33:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 33:18" />דײַן האַרץ װעט טראַכטן אָן דער אימה:</para>
  <para style="q" vid="ISA 33:18">װוּ איז דער װאָס האָט געצײלט?</para>
  <para style="q" vid="ISA 33:18">װוּ דער װאָס האָט געװױגן?</para>
  <para style="q" vid="ISA 33:18">װוּ דער װאָס האָט די טורעמס געצײלט?<verse eid="ISA 33:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 33:19" />דאָס פֿאַרשײַטע פֿאָלק װעסטו מער נישט זען,</para>
  <para style="q" vid="ISA 33:19">דאָס פֿאָלק מיט אַ טונקעלער שפּראַך, נישט צו פֿאַרשטײן,</para>
  <para style="q" vid="ISA 33:19">מיט אַ שטאַמלדיקן לשון, נישט קלוג צו װערן.<verse eid="ISA 33:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 33:20" />קוק אָן צִיוֹן, די שטאָט פֿון אונדזער אײַנזאַמלונג;</para>
  <para style="q" vid="ISA 33:20">דײַנע אױגן װעלן זען ירושָלַיִם,</para>
  <para style="q" vid="ISA 33:20">אַ װױנונג אַ רויִקע,</para>
  <para style="q" vid="ISA 33:20">אַ געצעלט װאָס װעט נישט אַװעקגערוקט װערן,</para>
  <para style="q" vid="ISA 33:20">װאָס זײַנע פֿלעקלעך װעלן אײביק נישט אַרױסגעצױגן װערן,</para>
  <para style="q" vid="ISA 33:20">און אַלע זײַנע שטריק װעלן נישט אָפּגעריסן װערן.<verse eid="ISA 33:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 33:21" />נאָר דאָרטן װעט ה׳ אונדז זײַן מאַכטיק,</para>
  <para style="q" vid="ISA 33:21">װי אַן אָרט פֿון טײַכן, שטראָמען ברײטרױמיקע,</para>
  <para style="q" vid="ISA 33:21">װאָס קײן רודערשיף קען אױף אים נישט גײן,</para>
  <para style="q" vid="ISA 33:21">און קײן שטאַרקער אָקרענט קען אים נישט איבערפֿאָרן.<verse eid="ISA 33:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 33:22" />װאָרעם ה׳ איז אונדזער ריכטער,</para>
  <para style="q" vid="ISA 33:22">ה׳ איז אונדזער געזעצגעבער,</para>
  <para style="q" vid="ISA 33:22">ה׳ איז אונדזער מלך;</para>
  <para style="q" vid="ISA 33:22">ער װעט אונדז העלפֿן.<verse eid="ISA 33:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="ISA 33:23" />לױז געװאָרן זײַנען דײַנע שטריק,</para>
  <para style="q" vid="ISA 33:23">זײ האַלטן נישט פֿעסט זײער מאַסט,</para>
  <para style="q" vid="ISA 33:23">זײ שפּרײטן דעם זאַגל נישט אױס.</para>
  <para style="q" vid="ISA 33:23">דענצמאָל װערט פֿאַנג פֿון פֿיל זאַקרױב צעטײלט,</para>
  <para style="q" vid="ISA 33:23">הינקעדיקע רױבן רױב.<verse eid="ISA 33:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 33:24" />און קײן אײַנװױנער װעט נישט זאָגן: איך בין קראַנק;</para>
  <para style="q" vid="ISA 33:24">דעם פֿאָלק װאָס זיצט דערין איז פֿאַרגעבן די זינד.<verse eid="ISA 33:24" /></para>
  <chapter eid="ISA 33" />
  <chapter number="34" style="c" pubnumber="לד" sid="ISA 34" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 34:1" />גענענט, איר פֿעלקער, צו הערן,</para>
  <para style="q" vid="ISA 34:1">און איר אומות, פֿאַרנעמט;</para>
  <para style="q" vid="ISA 34:1">זאָל הערן די ערד און איר פֿולקײט,</para>
  <para style="q" vid="ISA 34:1">די װעלט און אַלע אירע שפּראָצונגען.<verse eid="ISA 34:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 34:2" />װאָרעם ה׳ האָט אַ כּעס אױף אַלע פֿעלקער,</para>
  <para style="q" vid="ISA 34:2">און אַ גרימצאָרן אױף זײער גאַנצן חיל;</para>
  <para style="q" vid="ISA 34:2">ער האָט זײ צו חרם געמאַכט,</para>
  <para style="q" vid="ISA 34:2">זײ איבערגעגעבן צו דער שחיטה.<verse eid="ISA 34:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 34:3" />און זײערע דערשלאָגענע װעלן זיך װאַלגערן,</para>
  <para style="q" vid="ISA 34:3">– און פֿון זײערע פּגָרים װעט אױפֿגײן אַ געשטאַנק,</para>
  <para style="q" vid="ISA 34:3">און די בערג װעלן צעגײן פֿון זײער בלוט.<verse eid="ISA 34:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 34:4" />און דער גאַנצער חיל פֿון הימל װעט צעקריכן,</para>
  <para style="q" vid="ISA 34:4">און די הימלען װעלן װי אַ מגילה זיך אױפֿװיקלען,</para>
  <para style="q" vid="ISA 34:4">און זײער גאַנץ חיל װעט אַראָפּװעלקן,</para>
  <para style="q" vid="ISA 34:4">װי אַ בלאַט װעלקט פֿון װײַנשטאָק,</para>
  <para style="q" vid="ISA 34:4">און װי פֿאַרװעלקט פֿון אַ פֿײַגנבױם.<verse eid="ISA 34:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 34:5" />װאָרעם אָנגעטרונקען אין הימל האָט זיך מײַן שװערד,</para>
  <para style="q" vid="ISA 34:5">אָט װעט זי אױף אֶדוֹם אַראָפּנידערן,</para>
  <para style="q" vid="ISA 34:5">און אױף דעם פֿאָלק פֿון מײַן חרם, צום משפּט.<verse eid="ISA 34:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 34:6" />ג-טס שװערד איז פֿול מיט בלוט,</para>
  <para style="q" vid="ISA 34:6">געזעפֿטיקט מיט פֿעטס,</para>
  <para style="q" vid="ISA 34:6">מיט בלוט פֿון לעמער און בעק,</para>
  <para style="q" vid="ISA 34:6">מיט נירנפֿעטס פֿון װידערס;</para>
  <para style="q" vid="ISA 34:6">װאָרעם ה׳ האָט אַ שלאַכטונג אין בָצרָה,</para>
  <para style="q" vid="ISA 34:6">און אַ גרױסע שעכטונג אין לאַנד אֶדוֹם.<verse eid="ISA 34:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 34:7" />און נידערן װעלן װיזלטירן מיט זײ,</para>
  <para style="q" vid="ISA 34:7">און בולן מיט אָקסן;</para>
  <para style="q" vid="ISA 34:7">און אָנטרינקען װעט זיך זײער ערד מיט בלוט,</para>
  <para style="q" vid="ISA 34:7">און זײער שטױב װעט זיך זעפֿטיקן מיט פֿעטס.<verse eid="ISA 34:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 34:8" />װאָרעם אַ טאָג פֿון נקמה איז בײַ ה׳,</para>
  <para style="q" vid="ISA 34:8">אַ יאָר פֿון באַצאָלונג פֿאַר דעם קריג פֿון צִיוֹן.<verse eid="ISA 34:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 34:9" />און פֿאַרקערט װערן אין פּעך װעלן אירע שטראָמען,</para>
  <para style="q" vid="ISA 34:9">און איר שטױב אין שװעבל,</para>
  <para style="q" vid="ISA 34:9">און איר ערד װעט װערן ברענענדיקע פּעך.<verse eid="ISA 34:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 34:10" />טאָג און נאַכט װעט זי נישט פֿאַרלאָשן װערן,</para>
  <para style="q" vid="ISA 34:10">אױף אײביק װעט אױפֿגײן איר רױך;</para>
  <para style="q" vid="ISA 34:10">פֿון דור צו דור װעט זי װיסט זײַן,</para>
  <para style="q" vid="ISA 34:10">אױף אײביקאײביקײטן װעט קײנער נישט דורכגײן דורך איר.<verse eid="ISA 34:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 34:11" />און יַרשען װעלן זי דער פּעליקאַן און דער זומפּבושל,</para>
  <para style="q" vid="ISA 34:11">און די סאָװע און דער ראָב װעלן רוען אין איר;</para>
  <para style="q" vid="ISA 34:11">און ער װעט ציִען אױף איר אַ שנור פֿון װיסטקײט,</para>
  <para style="q" vid="ISA 34:11">און אַ גרונטװאָג פֿון לײדיקײט.<verse eid="ISA 34:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 34:12" />פֿון אירע אַדללײַט װעט נישט זײַן דאָרט</para>
  <para style="q" vid="ISA 34:12">װער עס זאָל אַ מלוכה אױסרופֿן;</para>
  <para style="q" vid="ISA 34:12">און אַלע אירע שׂרָרות װעלן װערן צו נישט.<verse eid="ISA 34:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 34:13" />און אױפֿגײן װעלן דערנער אין אירע פּאַלאַצן,</para>
  <para style="q" vid="ISA 34:13">און קראָפּיװע און שטעכגעװעקס אין אירע פֿעסטונגען;</para>
  <para style="q" vid="ISA 34:13">און זי װעט זײַן אַ װױנונג פֿון שאַקאַלן,</para>
  <para style="q" vid="ISA 34:13">אַ געהעפֿט פֿאַר שטרױספֿױגלען.<verse eid="ISA 34:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 34:14" />און װילדע קעץ װעלן אָנטרעפֿן מדבר-הינט,</para>
  <para style="q" vid="ISA 34:14">און אַ שד װעט רופֿן צו זײַן חבֿר;</para>
  <para style="q" vid="ISA 34:14">יאָ, דאָרטן טוט לילית רוען,</para>
  <para style="q" vid="ISA 34:14">און געפֿינט איר מנוחה.<verse eid="ISA 34:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 34:15" />דאָרט מאַכט די פֿײַלשלאַנג איר נעסט, און לײגט,</para>
  <para style="q" vid="ISA 34:15">און בריט און װאַרעמט אין איר שאָטן;</para>
  <para style="q" vid="ISA 34:15">יאָ, דאָרט זאַמלען זיך האַביכפֿױגלען</para>
  <para style="q" vid="ISA 34:15">אײנער צום אַנדערן.<verse eid="ISA 34:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 34:16" />פֿאָרשט אין ה׳ס בוך, און לײענט;</para>
  <para style="q" vid="ISA 34:16">קײנס פֿון די דאָזיקע איז נישט געמינערט,</para>
  <para style="q" vid="ISA 34:16">קײנס פֿעלט נישט צום אַנדערן.</para>
  <para style="q" vid="ISA 34:16">װאָרעם מײַן מױל האָט באַפֿױלן,</para>
  <para style="q" vid="ISA 34:16">און זײַן רוּחַ האָט זײ אײַנגעזאַמלט.<verse eid="ISA 34:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 34:17" />און ער האָט זײ געװאָרפֿן אַ גורל,</para>
  <para style="q" vid="ISA 34:17">און זײַן האַנט האָט עס זײ צעטײלט מיט אַ שנור;</para>
  <para style="q" vid="ISA 34:17">ביז אײביק װעלן זײ עס יַרשען,</para>
  <para style="q" vid="ISA 34:17">אױף דור-דורות װעלן זײ רוען דערין.<verse eid="ISA 34:17" /></para>
  <chapter eid="ISA 34" />
  <chapter number="35" style="c" pubnumber="לה" sid="ISA 35" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 35:1" />לוסטיק זײַן װעלן דער מדבר און די טריקעניש,</para>
  <para style="q" vid="ISA 35:1">און פֿרײען װעט זיך די װיסטע,</para>
  <para style="q" vid="ISA 35:1">און בליִען װי אַ רױז.<verse eid="ISA 35:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 35:2" />בליִען װעט זי בליִען, און זיך פֿרײען,</para>
  <para style="q" vid="ISA 35:2">יאָ, מיט פֿרײד און געזאַנג;</para>
  <para style="q" vid="ISA 35:2">די פּראַכט פֿון לבֿנוֹן איז איר געגעבן,</para>
  <para style="q" vid="ISA 35:2">די שײנקײט פֿון כַּרמֶל און שָרוֹן;</para>
  <para style="q" vid="ISA 35:2">זײ װעלן זען די פּראַכט פֿון ה׳,</para>
  <para style="q" vid="ISA 35:2">די שײנקײט פֿון אלוקינו.<verse eid="ISA 35:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 35:3" />שטאַרקט די שלאַפֿע הענט,</para>
  <para style="q" vid="ISA 35:3">און די שטרױכלדיקע קני טוט פֿעסטיקן.<verse eid="ISA 35:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 35:4" />זאָגט צו די אומרויִקע הערצער:</para>
  <para style="q" vid="ISA 35:4">זײַט שטאַרק, האָט נישט מורא;</para>
  <para style="q" vid="ISA 35:4">אָט איז אלוקיכם, ער װעט קומען מיט נקמה,</para>
  <para style="q" vid="ISA 35:4">מיט פֿאַרגעלטונג פֿון אלֹקים</para>
  <para style="q" vid="ISA 35:4">װעט ער קומען און אײַך העלפֿן.<verse eid="ISA 35:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 35:5" />דענצמאָל װעלן אױפֿגעמאַכט װערן די אױגן פֿון בלינדע,</para>
  <para style="q" vid="ISA 35:5">און די אױערן פֿון טױבע װעלן געעפֿנט װערן.<verse eid="ISA 35:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 35:6" />דענצמאָל װעט אַ הינקעדיקער שפּרינגען װי אַ הינד,</para>
  <para style="q" vid="ISA 35:6">און די צונג פֿון אַ שטומען װעט זינגען;</para>
  <para style="q" vid="ISA 35:6">װאָרעם אין מדבר ברעכן אױס װאַסערן,</para>
  <para style="q" vid="ISA 35:6">און בעכן אין דער װיסטע.<verse eid="ISA 35:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 35:7" />און דאָס הײסע געזעמדן װעט װערן אַ טײַך,</para>
  <para style="q" vid="ISA 35:7">און דער דאָרשטיקער לאַנד — קװאַלן װאַסער;</para>
  <para style="q" vid="ISA 35:7">אין װױנאָרט פֿון שאַקאַלן, װוּ זײ האָבן לײגן, װעט זײַן גראָז,</para>
  <para style="q" vid="ISA 35:7">מיט ראָר און יאַמש.<verse eid="ISA 35:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 35:8" />און דאָרט װעט זײַן אַ שטעג און אַ װעג,</para>
  <para style="q" vid="ISA 35:8">און דער הײליקער װעג װעט מען אים רופֿן;</para>
  <para style="q" vid="ISA 35:8">נישט דורכגײן װעט אים אַן אומרײנער,</para>
  <para style="q" vid="ISA 35:8">נײַערט פֿאַר זײ װעט ער זײַן;</para>
  <para style="q" vid="ISA 35:8">װעגגײער אַפֿילו אומגעניטע װעלן נישט בלאָנדזשען.<verse eid="ISA 35:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 35:9" />דאָרט װעט נישט זײַן קײן לײב,</para>
  <para style="q" vid="ISA 35:9">און קײן װילדע חיה װעט נישט אַרױפֿגײן אױף אים –</para>
  <para style="q" vid="ISA 35:9">זײ װעלן זיך דאָרט נישט געפֿינען.</para>
  <para style="q" vid="ISA 35:9">און די אױסגעלײזטע װעלן גײן,<verse eid="ISA 35:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 35:10" />און די דערלײזטע פֿון ה׳ װעלן צוריקקערן,</para>
  <para style="q" vid="ISA 35:10">און װעלן קומען קײן צִיוֹן מיט געזאַנג,</para>
  <para style="q" vid="ISA 35:10">און אַן אײביקע שׂימחה װעט זײַן אױף זײער קאָפּ;</para>
  <para style="q" vid="ISA 35:10">שָׂשׂון און שׂימחה װעט זײ באַקומען,</para>
  <para style="q" vid="ISA 35:10">און אַנטלױפֿן װעלן טרױער און זיפֿצעניש.<verse eid="ISA 35:10" /></para>
  <chapter eid="ISA 35" />
  <chapter number="36" style="c" pubnumber="לו" sid="ISA 36" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1" />און עס איז געװען אין פֿערצנטן יאָר פֿון מלך חִזקִיָהון, איז אַרױפֿגעגאַנגען סַנחֵריבֿ דער מלך פֿון אשור אױף אַלע באַפֿעסטיקטע שטעט פֿון יהוּדה, און האָט זײ אײַנגענומען. <verse eid="ISA 36:1" /><verse number="2" style="v" sid="ISA 36:2" />און דער מלך פֿון אשור האָט געשיקט רַבֿשָקֵהן פֿון לָכיש קײן ירושָלַיִם צום מלך חִזקִיָהון מיט אַ גרױסן חיל. און ער האָט זיך געשטעלט בײַ דעם גראָבן פֿון דעם אױבערשטן טײַך אױפֿן װעג פֿון װעשערפֿעלד. <verse eid="ISA 36:2" /><verse number="3" style="v" sid="ISA 36:3" />איז אַרױסגעגאַנגען צו אים אֶליָקים דער זון פֿון חִלקִיָהון, װאָס איבערן פּאַלאַץ, און שֶבֿנאָ דער שרײַבער, און יוֹאָח דער זון פֿון אָסָפֿן, דער דערמאָנער.<verse eid="ISA 36:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 36:4" />און רַבֿשָקֵה האָט צו זײ געזאָגט: זאָגט אַקאָרשט צו חִזקִיָהון: אַזױ האָט געזאָגט דער גרױסער מלך, דער מלך פֿון אשור: װאָס איז די דאָזיקע פֿאַרזיכערונג װאָס דו פֿאַרזיכערסט זיך? <verse eid="ISA 36:4" /><verse number="5" style="v" sid="ISA 36:5" />דו זאָגסט, אָבער עס איז נאָר אַ װאָרט פֿון די ליפּן, איך האָב עצה און שטאַרקײט צו מלחמה. איצט, אױף װעמען האָסטו זיך פֿאַרלאָזט, אַז דו האָסט זיך קעגן מיר געבונטעװעט? <verse eid="ISA 36:5" /><verse number="6" style="v" sid="ISA 36:6" />זע, דו פֿאַרזיכערסט זיך אױף דעם שטעקן פֿון דעם דאָזיקן צעבראָכענעם ראָר – אױף מִצרַיִם – װאָס אַז אַ מענטש לענט זיך אױף אים אָן, גײט ער אים אַרײַן אין דער האַנט, און לעכערט זי דורך; אַזױ איז פַּרעה דער מלך פֿון מִצרַיִם פֿאַר אַלע װאָס פֿאַרזיכערן זיך אױף אים. <verse eid="ISA 36:6" /><verse number="7" style="v" sid="ISA 36:7" />און אַז דו װעסט מיר זאָגן: מיר פֿאַרזיכערן זיך אױף ה׳ אלוקינו; איז דאָס נישט דער װאָס חִזקִיָהו האָט אָפּגעטאָן זײַנע בָמות און זײַנע מזבחות, און האָט געזאָגט צו יהוּדה און צו ירושָלַיִם: פֿאַר דעם דאָזיקן מזבח זאָלט איר זיך בוקן? <verse eid="ISA 36:7" /><verse number="8" style="v" sid="ISA 36:8" />און אַצונד, פֿאַרװעט זיך אַקאָרשט מיט מײַן האַר דעם מלך פֿון אשור, און איך װעל דיר געבן צװײ טױזנט פֿערד, אױב דו קענסט דיר אַרױפֿזעצן רײַטער אױף זײ. <verse eid="ISA 36:8" /><verse number="9" style="v" sid="ISA 36:9" />הײַנט װי קענסטו אָפּשטױסן דעם פּנים פֿון אַ הױפּטמאַן, אײנעם פֿון די קלענסטע קנעכט פֿון מײַן האַר? פֿון דעסט װעגן פֿאַרזיכערסטו זיך אױף מִצרַיִם װעגן רײַטװעגן און רײַטער. <verse eid="ISA 36:9" /><verse number="10" style="v" sid="ISA 36:10" />און אַצונד, בין איך דען אָן ה׳ אַרױפֿגעקומען אױף דעם דאָזיקן לאַנד, עס צו פֿאַרװיסטן? ה׳ האָט צו מיר געזאָגט: גײ אַרױף אױף דעם דאָזיקן לאַנד, און פֿאַרװיסט עס.<verse eid="ISA 36:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11" />האָט אֶליָקים און שֶבֿנאָ און יוֹאָח געזאָגט צו רַבֿשָקֵהן: רעד, איך בעט דיך, צו דײַנע קנעכט אַראַמיש, װאָרעם מיר פֿאַרשטײען עס, און רעד נישט צו אונדז יהוּדיש אין די אױערן פֿון דעם דאָזיקן פֿאָלק װאָס אױף דער מױער.<verse eid="ISA 36:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 36:12" />האָט רַבֿשָקֵה געזאָגט: האָט דען צו דײַן האַר און צו דיר מיך געשיקט מײַן האַר צו רעדן די דאָזיקע װערטער, און נישט צו די מענטשן װאָס זיצן אױף דער מױער, צו עסן זײער קױט, און צו טרינקען זײער לײַב-װאַסער, בײַ אײַך?<verse eid="ISA 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 36:13" />און רַבֿשָקֵה האָט זיך געשטעלט, און האָט אױסגערופֿן אױף אַ הױכן קֹול, אױף יהוּדיש, און האָט געזאָגט: הערט די װערטער פֿון דעם גרױסן מלך, דעם מלך פֿון אשור: <verse eid="ISA 36:13" /><verse number="14" style="v" sid="ISA 36:14" />אַזױ האָט געזאָגט דער מלך: זאָל אײַך חִזקִיָהו נישט נאַרן, װאָרעם ער קען אײַך נישט מציל זײַן. <verse eid="ISA 36:14" /><verse number="15" style="v" sid="ISA 36:15" />און זאָל אײַך חִזקִיָהו נישט פֿאַרזיכערן אױף ה׳, אַזױ צו זאָגן: מציל זײַן װעט אונדז מציל זײַן ג-ט; די דאָזיקע שטאָט װעט נישט איבערגעגעבן װערן אין דער האַנט פֿון דעם מלך פֿון אשור. <verse eid="ISA 36:15" /><verse number="16" style="v" sid="ISA 36:16" />איר זאָלט זיך נישט צוהערן צו חִזקִיָהון, װאָרעם אַזױ האָט געזאָגט דער מלך פֿון אשור: מאַכט מיט מיר שלום, און קומט אַרױס צו מיר, און עסט איטלעכער פֿון זײַן װײַנשטאָק און איטלעכער פֿון זײַן פֿײַגנבױם, און טרינקט איטלעכער דאָס װאַסער פֿון זײַן ברונעם; <verse eid="ISA 36:16" /><verse number="17" style="v" sid="ISA 36:17" />ביז איך קום, און װעל אײַך נעמען אין אַ לאַנד אַזױ װי אײַער לאַנד, אַ לאַנד פֿון תּבֿואה און װײַן, אַ לאַנד פֿון ברױט און װײַנגערטנער. <verse eid="ISA 36:17" /><verse number="18" style="v" sid="ISA 36:18" />זאָל אײַך נאָר חִזקִיָהו נישט אײַנרעדן, אַזױ צו זאָגן: ה׳ װעט אונדז מציל זײַן. האָבן דען מציל געװען די ג‑טער פֿון די פֿעלקער איטלעכער זײַן לאַנד פֿון דער האַנט פֿון דעם מלך פֿון אשור? <verse eid="ISA 36:18" /><verse number="19" style="v" sid="ISA 36:19" />װוּ זײַנען די ג‑טער פֿון חַמָת און אַרפַּד? װוּ זײַנען די ג‑טער פֿון ספֿרוַיִם? און האָבן זײ דען מציל געװען שוֹמרוֹן פֿון מײַן האַנט? <verse eid="ISA 36:19" /><verse number="20" style="v" sid="ISA 36:20" />װער זײַנען צװישן אַלע ג‑טער פֿון די דאָזיקע לענדער, װאָס האָבן מציל געװען זײער לאַנד פֿון מײַן האַנט, אַז ה׳ זאָל מציל זײַן ירושָלַיִם פֿון מײַן האַנט?<verse eid="ISA 36:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 36:21" />האָבן זײ געשװיגן, און האָבן אים אַ װאָרט נישט געענטפֿערט, װאָרעם דער באַפֿעל פֿון מלך איז געװען, אַזױ צו זאָגן: איר זאָלט אים נישט ענטפֿערן.<verse eid="ISA 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 36:22" />איז געקומען אֶליָקים דער זון פֿון חִלקִיָהון, װאָס איבערן פּאַלאַץ, און שֶבֿנאָ דער שרײַבער, און יוֹאָח דער זון פֿון אָסָפֿן, דער דערמאָנער, צו חִזקִיָהון, מיט צעריסענע קלײדער, און זײ האָבן אים דערצײלט די װערטער פֿון רַבֿשָקֵהן.<verse eid="ISA 36:22" /></para>
  <chapter eid="ISA 36" />
  <chapter number="37" style="c" pubnumber="לז" sid="ISA 37" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1" />און עס איז געװען, װי דער מלך חִזקִיָהו האָט עס געהערט, אַזױ האָט ער צעריסן זײַנע קלײדער, און זיך צוגעדעקט מיט זאַק, און ער איז געקומען אין הױז פֿון ה׳. <verse eid="ISA 37:1" /><verse number="2" style="v" sid="ISA 37:2" />און ער האָט געשיקט אֶליָקימען װאָס איבערן פּאַלאַץ, און שֶבֿנאָ דעם שרײַבער, און די עלטסטע פֿון די כּהנים, צוגעדעקטע מיט זאַקקלײדער, צו ישַעיָהו הנבֿיא דעם זון פֿון אָמוצן. <verse eid="ISA 37:2" /><verse number="3" style="v" sid="ISA 37:3" />און זײ האָבן צו אים געזאָגט: אַזױ האָט געזאָגט חִזקִיָהו: אַ טאָג פֿון נױט און שטראָף און שמאַך איז דער הײַנטיקער טאָג; װאָרעם די קינדער זײַנען געקומען צום מוטערמױל, און נישטאָ קײן כּוֹח צו געבערן. <verse eid="ISA 37:3" /><verse number="4" style="v" sid="ISA 37:4" />אפֿשר װעט ה׳ דײַן ג-ט הערן די װערטער פֿון רַבֿשָקֵהן, װאָס זײַן האַר דער מלך פֿון אשור האָט אים געשיקט צו לעסטערן דעם לעבעדיקן אלֹקים, און ער װעט שטראָפֿן פֿאַר די רײד װאָס ה׳ דײַן ג-ט האָט געהערט; דערום זאָלסטו אױפֿהײבן אַ תּפֿילה פֿאַר דעם איבערבלײַב װאָס געפֿינט זיך דאָ.<verse eid="ISA 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5" />און װי די קנעכט פֿון חִזקִיָהון זײַנען געקומען צו ישַעיָהון, <verse eid="ISA 37:5" /><verse number="6" style="v" sid="ISA 37:6" />האָט ישַעיָהו צו זײ געזאָגט: אַזױ זאָלט איר זאָגן צו אײַער האַר: אַזױ האָט ה׳ געזאָגט: זאָלסט נישט מורא האָבן פֿאַר די װערטער װאָס דו האָסט געהערט, מיט װאָס די יונגען פֿון דעם מלך פֿון אשור האָבן מיך געשענדט. <verse eid="ISA 37:6" /><verse number="7" style="v" sid="ISA 37:7" />זע, איך גיב אַרײַן אין אים אַ גײַסט, און ער װעט הערן אַ הערונג, און װעט זיך אומקערן צו זײַן לאַנד; און איך װעל אים מאַכן פֿאַלן דורכן שװערד אין זײַן לאַנד.<verse eid="ISA 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8" />און רַבֿשָקֵה האָט זיך אומגעקערט, און האָט געפֿונען דעם מלך פֿון אשור מלחמה האַלטנדיק אױף לִבֿנָה; װאָרעם ער האָט געהאַט געהערט אַז ער האָט אַװעקגעצױגן פֿון לָכיש.<verse eid="ISA 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 37:9" />און האָט געהערט אױף תִּרהָקָה דעם מלך פֿון כּוּש, אַזױ צו זאָגן: ער איז אַרױסגעגאַנגען מלחמה צו האַלטן מיט דיר. און װי ער האָט דאָס געהערט, האָט ער געשיקט שלוחים צו חִזקִיָהון, אַזױ צו זאָגן: <verse eid="ISA 37:9" /><verse number="10" style="v" sid="ISA 37:10" />אַזױ זאָלט איר זאָגן צו חִזקִיָהו דעם מלך פֿון יהוּדה, אַזױ צו זאָגן: זאָל דיר נישט נאַרן דײַן ג-ט װאָס דו פֿאַרזיכערסט זיך אױף אים, אַזױ צו זאָגן: ירושָלַיִם װעט נישט איבערגעגעבן װערן אין דער האַנט פֿון דעם מלך פֿון אשור. <verse eid="ISA 37:10" /><verse number="11" style="v" sid="ISA 37:11" />אָט האָסטו געהערט װאָס די מלכים פֿון אשור האָבן געטאָן צו אַלע לענדער, זײ צו פֿאַרװיסטן, און דו װילסט ניצול װערן? <verse eid="ISA 37:11" /><verse number="12" style="v" sid="ISA 37:12" />האָבן די ג‑טער פֿון די פֿעלקער מציל געװען די װאָס מײַנע עלטערן האָבן צעשטערט, גוֹזָן, און חָרָן, און רֶצֶף, און די קינדער פֿון עֵדֶן װאָס אין תּלַשָׂר? <verse eid="ISA 37:12" /><verse number="13" style="v" sid="ISA 37:13" />װוּ איז דער מלך פֿון חַמָת, און דער מלך פֿון אַרפַּד, און דער מלך פֿון דער שטאָט ספֿרוַיִם, פֿון הֵנַע, און עִוָה?<verse eid="ISA 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14" />האָט חִזקִיָהו צוגענומען דעם בריװ פֿון דער האַנט פֿון די שלוחים, און האָט אים איבערגעלײענט, און ער איז אַרױפֿגעגאַנגען אין הױז פֿון ה׳. <verse eid="ISA 37:14" /><verse number="15" style="v" sid="ISA 37:15" />און חִזקִיָהו האָט אים אױסגעשפּרײט פֿאַר ה׳. און חִזקִיָהו האָט מתפּלל געװען צו ה׳, אַזױ צו זאָגן: <verse eid="ISA 37:15" /><verse number="16" style="v" sid="ISA 37:16" />ה׳ צבָֿאוֹת, אלוקי יִשׂרָאֵל װאָס זיצסט איבער די כּרובֿים; דו אַלײן ביסט דער אלֹקים איבער אַלע קיניגרײַכן פֿון דער ערד; דו האָסט געמאַכט די הימלען און די ערד. <verse eid="ISA 37:16" /><verse number="17" style="v" sid="ISA 37:17" />נײַג, ה׳, דײַן אױער, און הער; עפֿן, ה׳, דײַנע אױגן, און זע; און הער די אַלע װערטער פֿון סַנחֵריבֿן, װאָס האָט געשיקט צו לעסטערן דעם לעבעדיקן אלֹקים. <verse eid="ISA 37:17" /><verse number="18" style="v" sid="ISA 37:18" />אמת, ה׳, די מלכים פֿון אשור האָבן חרובֿ געמאַכט די אַלע מדינות מיט זײער לאַנד, <verse eid="ISA 37:18" /><verse number="19" style="v" sid="ISA 37:19" />און זײ האָבן איבערגעגעבן זײערע ג‑טער צום פֿײַער; װאָרעם זײ זײַנען קײן ג‑טער נישט געװען, נאָר בלױז דאָס װערק פֿון אַ מענטשנס הענט, האָלץ און שטײן; דערום האָבן זײ זײ אונטערגעבראַכט. <verse eid="ISA 37:19" /><verse number="20" style="v" sid="ISA 37:20" />און אַצונד, ה׳ אלוקינו, העלף אונדז פֿון זײַן האַנט, און זאָלן אַלע קיניגרײַכן פֿון דער ערד װיסן אַז דו אַלײן ביסט ה׳.<verse eid="ISA 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21" />האָט ישַעיָהו דער זון פֿון אָמוצן געשיקט צו חִזקִיָהון, אַזױ צו זאָגן: אַזױ האָט געזאָגט ה׳ אלוקי יִשׂרָאֵל: װאָס דו האָסט מתפּלל געװען צו מיר װעגן סַנחֵריבֿ דעם מלך פֿון אשור – <verse eid="ISA 37:21" /><verse number="22" style="v" sid="ISA 37:22" />איז דאָס דאָס װאָרט װאָס ה׳ האָט װעגן אים גערעדט:</para>
  <para style="b" vid="ISA 37:22" />
  <para style="q" vid="ISA 37:22">עס פֿאַראַכט דיך, עס שפּאָט פֿון דיר</para>
  <para style="q" vid="ISA 37:22">די יונגפֿרױ טאָכטער צִיוֹן;</para>
  <para style="q" vid="ISA 37:22">עס שאָקלט דעם קאָפּ הינטער דיר</para>
  <para style="q" vid="ISA 37:22">די טאָכטער ירושָלַיִם.<verse eid="ISA 37:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 37:23" />װעמען האָסטו געלעסטערט און געשענדט?</para>
  <para style="q" vid="ISA 37:23">און אױף װעמען האָסטו דײַן קֹול אױפֿגעהױבן?</para>
  <para style="q" vid="ISA 37:23">יאָ, האָסט געהױבן דײַנע אױגן אין דער הײך,</para>
  <para style="q" vid="ISA 37:23">אַקעגן דעם הײליקן פֿון יִשׂרָאֵל.<verse eid="ISA 37:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 37:24" />דורך דײַנע קנעכט האָסטו געלעסטערט אֲדֹנָי,</para>
  <para style="q" vid="ISA 37:24">און געזאָגט: מיט מײַנע פֿיל רײַטװעגן</para>
  <para style="q" vid="ISA 37:24">בין איך צו דער הײך פֿון די בערג אַרױף,</para>
  <para style="q" vid="ISA 37:24">צו די װינקלען פֿון לבֿנוֹן;</para>
  <para style="q" vid="ISA 37:24">און איך האַק אָפּ זײַנע הױכע צעדערן,</para>
  <para style="q" vid="ISA 37:24">זײַנע געקליבענע ציפּרעסבײמער;</para>
  <para style="q" vid="ISA 37:24">און איך קום צו זײַן העכסטן שפּיץ,</para>
  <para style="q" vid="ISA 37:24">צום װאַלד פֿון זײַן פֿרוכטגאָרטן.<verse eid="ISA 37:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 37:25" />איך האָב געגראָבן און געטרונקען װאַסער,</para>
  <para style="q" vid="ISA 37:25">און טריקן אױס מיט מײַנע פֿוסטריט</para>
  <para style="q" vid="ISA 37:25">אַלע טײַכן פֿון מִצרַיִם.<verse eid="ISA 37:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="ISA 37:26" />האָסטו דען נישט געהערט?</para>
  <para style="q" vid="ISA 37:26">פֿון לאַנג אָן האָב איך עס צוגעגרײט,</para>
  <para style="q" vid="ISA 37:26">פֿון אַלטע טעג האָב איך עס געפֿורעמט;</para>
  <para style="q" vid="ISA 37:26">אַצונד האָב איך עס געבראַכט עס זאָל געשען,</para>
  <para style="q" vid="ISA 37:26">צו פֿאַרװיסטן אױף חורבֿה-הױפֿנס</para>
  <para style="q" vid="ISA 37:26">באַפֿעסטיקטע שטעט.<verse eid="ISA 37:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 37:27" />דערום זײַנען זײערע באַװױנער קורצמאַכטיק,</para>
  <para style="q" vid="ISA 37:27">זײ זײַנען צעבראָכן און פֿאַרשעמט;</para>
  <para style="q" vid="ISA 37:27">זײ זײַנען געװאָרן גראָז פֿון פֿעלד,</para>
  <para style="q" vid="ISA 37:27">און קרײַטעכץ גרינע,</para>
  <para style="q" vid="ISA 37:27">מאַך פֿון די דעכער,</para>
  <para style="q" vid="ISA 37:27">און אַ פֿעלד אײדער אױפֿגעװאַקסן.<verse eid="ISA 37:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="ISA 37:28" />אָבער איך װײס דײַן זיצן</para>
  <para style="q" vid="ISA 37:28">און דײַן גײן און דײַן קומען,</para>
  <para style="q" vid="ISA 37:28">און דײַן שטורעמען קעגן מיר.<verse eid="ISA 37:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 37:29" />װײַל דײַן שטורעמען קעגן מיר</para>
  <para style="q" vid="ISA 37:29">און דײַן ליאַרעם איז אַרױף אין מײַנע אױערן,</para>
  <para style="q" vid="ISA 37:29">דערום װעל איך אַרײַנטאָן מײַן רינג אין דײַן נאָז,</para>
  <para style="q" vid="ISA 37:29">און מײַן צאַם אין דײַנע ליפּן,</para>
  <para style="q" vid="ISA 37:29">און איך װעל דיך אומקערן אױף דעם װעג</para>
  <para style="q" vid="ISA 37:29">װאָס דו ביסט געקומען אױף אים.<verse eid="ISA 37:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="ISA 37:30" />און דאָס װעט דיר זײַן דער צײכן: איר װעט עסן הײַיאָר נאָכװוּקס, און אױפֿן צװײטן יאָר װידערװוּקס; און אױפֿן דריטן יאָר זײט און שנײַדט, און פֿלאַנצט װײַנגערטנער, און עסט זײער פֿרוכט. <verse eid="ISA 37:30" /><verse number="31" style="v" sid="ISA 37:31" />און דער אַנטרונענער איבערבלײַב פֿון דעם הױז פֿון יהוּדה װעט װידער װאָרצלען אונטן, און טראָגן פֿרוכט אױבן. <verse eid="ISA 37:31" /><verse number="32" style="v" sid="ISA 37:32" />װאָרעם פֿון ירושָלַיִם װעט אַרױסקומען אַן איבערבלײַב, און אַן אַנטרינונג פֿון באַרג צִיוֹן; דאָס אָננעמען זיך פֿון ה׳ צבָֿאוֹת װעט דאָס טאָן.<verse eid="ISA 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 37:33" />פֿאַר װאָר, אַזױ האָט ה׳ געזאָגט אױף דעם מלך פֿון אשור: ער װעט נישט אַרײַנקומען אין דער דאָזיקער שטאָט, און נישט אַרײַנשיסן אַהין אַ פֿײַל, און נישט קומען פֿאַר איר מיט אַ שילד, און נישט אָנשיטן אַרום איר אַן ערדװאַל. <verse eid="ISA 37:33" /><verse number="34" style="v" sid="ISA 37:34" />אױף דעם װעג װאָס ער איז געקומען, אױף אים װעט ער זיך אומקערן, און אין דער דאָזיקער שטאָט װעט ער נישט אַרײַנקומען, זאָגט ה׳. <verse eid="ISA 37:34" /><verse number="35" style="v" sid="ISA 37:35" />און איך װעל באַשירעמען די דאָזיקע שטאָט, זי צו העלפֿן, פֿון מײַנעט װעגן און פֿון מײַן קנעכט דָוִדס װעגן.<verse eid="ISA 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36" />און אַ מלאך פֿון ה׳ איז אַרױסגעגאַנגען, און האָט געשלאָגן אין דעם לאַגער פֿון אשור הונדערט און פֿינף און אַכציק טױזנט; און אַז מע איז אױפֿגעשטאַנען אין דער פֿרי, ערשט זײ זײַנען אַלע טױטע פּגָרים. <verse eid="ISA 37:36" /><verse number="37" style="v" sid="ISA 37:37" />און סַנחֵריבֿ דער מלך פֿון אשור האָט אַװעקגעצױגן, און איז געגאַנגען און האָט זיך אומגעקערט; און ער איז געבליבן אין נינוֵה. <verse eid="ISA 37:37" /><verse number="38" style="v" sid="ISA 37:38" />און עס איז געװען, װי ער בוקט זיך אין הױז פֿון זײַן ג-ט נִסרוך, אַזױ האָבן זײַנע זין אַדרַמֶלֶך און שַׂראֶצֶר אים דערשלאָגן מיטן שװערד; און זײ זײַנען אַנטרונען געװאָרן אין לאַנד אַרָרָט. און זײַן זון אֵסַר-חַדוֹן איז געװאָרן מלך אױף זײַן אָרט.<verse eid="ISA 37:38" /></para>
  <chapter eid="ISA 37" />
  <chapter number="38" style="c" pubnumber="לח" sid="ISA 38" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1" />אין יענער צײַט איז חִזקִיָהו קראַנק געװאָרן צו שטאַרבן; איז צו אים געקומען ישַעיָהו הנבֿיא דער זון פֿון אָמוצן, און האָט צו אים געזאָגט: אַזױ האָט ה׳ געזאָגט: מאַך דײַן צַװָאֶה װעגן דײַן הױזגעזינט, װאָרעם דו שטאַרבסט, און װעסט נישט גענעזן װערן.<verse eid="ISA 38:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 38:2" />האָט חִזקִיָהו אומגעדרײט זײַן פּנים צו דער װאַנט, און האָט מתפּלל געװען צו ה׳, <verse eid="ISA 38:2" /><verse number="3" style="v" sid="ISA 38:3" />און האָט געזאָגט: איך בעט דיך, ה׳, געדענק װי איך בין געגאַנגען פֿאַר דיר מיט אמת און מיט אַ גאַנצן האַרצן, און װאָס איז גוט אין דײַנע אױגן האָב איך געטאָן. און חִזקִיָהו האָט געװײנט אַ גרױס געװײן.<verse eid="ISA 38:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 38:4" />איז דאָס װאָרט פֿון ה׳ געװען צו ישַעיָהון, אַזױ צו זאָגן: <verse eid="ISA 38:4" /><verse number="5" style="v" sid="ISA 38:5" />גײ און זאָלסט זאָגן צו חִזקִיָהון: אַזױ האָט געזאָגט ה׳ דער ג-ט פֿון דײַן פֿאָטער דָוִד: איך האָב געהערט דײַן תּפֿילה, איך האָב געזען דײַן טרער; זע, איך לײג‑צו צו דײַנע טעג פֿופֿצן יאָר. <verse eid="ISA 38:5" /><verse number="6" style="v" sid="ISA 38:6" />און פֿון דער האַנט פֿון דעם מלך פֿון אשור װעל איך דיך און די דאָזיקע שטאָט מציל זײַן, און איך װעל באַשירעמען די דאָזיקע שטאָט.<verse eid="ISA 38:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 38:7" />און דאָס װעט דיר זײַן אַ צײכן פֿון ה׳, אַז ה׳ װעט טאָן די דאָזיקע זאַך װאָס ער האָט גערעדט: <verse eid="ISA 38:7" /><verse number="8" style="v" sid="ISA 38:8" />זע, איך קער אום דעם שאָטן פֿון די שטאַפּלען װאָס האָט אַראָפּגענידערט אױף די זונשטאַפּלען פֿון אָחָזן, צוריק צען שטאַפּלען. און די זון האָט זיך אומגעקערט צען שטאַפּלען, אױף די שטאַפּלען װאָס זי האָט אַראָפּגענידערט.<verse eid="ISA 38:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9" />אַ געשריפֿטס פֿון חִזקִיָהו דעם מלך פֿון יהוּדה, װען ער איז קראַנק געװען, און איז גענעזן געװאָרן פֿון זײַן קראַנקשאַפֿט.<verse eid="ISA 38:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 38:10" />איך האָב געװעסט געזאָגט: אין מיטן פֿון מײַנע טעג</para>
  <para style="q" vid="ISA 38:10">װעל איך אַװעקגײן אין די טױערן פֿון שְׁאֹול;</para>
  <para style="q" vid="ISA 38:10">איך װער געמינערט דעם רעשט פֿון מײַנע יאָרן.<verse eid="ISA 38:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 38:11" />איך האָב געזאָגט: איך װעל נישט זען ה׳,</para>
  <para style="q" vid="ISA 38:11">ה׳ אין לאַנד פֿון די לעבעדיקע;</para>
  <para style="q" vid="ISA 38:11">איך װעל מער אַ מענטשן נישט אָנקוקן</para>
  <para style="q" vid="ISA 38:11">מיט די באַװױנער פֿון דער װעלט.<verse eid="ISA 38:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 38:12" />מײַן װױנונג איז אַװעקגערוקט און אָפּגעטאָן פֿון מיר,</para>
  <para style="q" vid="ISA 38:12">אַזױ װי אַ פּאַסטוכגעצעלט;</para>
  <para style="q" vid="ISA 38:12">איך האָב אױפֿגעװיקלט װי אַ װעבער מײַן לעבן;</para>
  <para style="q" vid="ISA 38:12">פֿון דער צױט װעט ער מיך אָפּרײַסן;</para>
  <para style="q" vid="ISA 38:12">פֿון טאָג ביז נאַכט װעסטו מיך ענדיקן.<verse eid="ISA 38:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 38:13" />איך האָב געטראַכט ביז פֿרימאָרגן,</para>
  <para style="q" vid="ISA 38:13">װי אַ לײב, אַזױ װעט ער אַלע מײַנע בײנער צעברעכן;</para>
  <para style="q" vid="ISA 38:13">פֿון טאָג ביז נאַכט װעסטו מיך ענדיקן.<verse eid="ISA 38:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 38:14" />װי אַ שװאַלב, װי אַ בושל, אַזױ האָב איך געפּיפּסט,</para>
  <para style="q" vid="ISA 38:14">איך האָב געברומט װי אַ טױב;</para>
  <para style="q" vid="ISA 38:14">מײַנע אױגן זײַנען אױסגעגאַנגען צו דער הײך:</para>
  <para style="q" vid="ISA 38:14">אֲדֹנָי, געדריקט בין איך, שטעל זיך אײַן פֿאַר מיר.<verse eid="ISA 38:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 38:15" />װאָס זאָל איך רעדן?</para>
  <para style="q" vid="ISA 38:15">אַז ער האָט מיר געזאָגט, און ער האָט געטאָן;</para>
  <para style="q" vid="ISA 38:15">זאַכט װעל איך גײן אַלע מײַנע יאָרן,</para>
  <para style="q" vid="ISA 38:15">איבער דער ביטערניש פֿון מײַן זעל.<verse eid="ISA 38:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 38:16" />אֲדֹנָי, דערױף לעבט מען,</para>
  <para style="q" vid="ISA 38:16">און אין גאַנצן דערין איז דאָס לעבן פֿון מײַן גײַסט;</para>
  <para style="q" vid="ISA 38:16">דערום שטאַרק מיך, און לאָז מיך לעבן.<verse eid="ISA 38:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 38:17" />זע, צום גוטן איז מיר פֿאַרביטן געװאָרן די ביטערניש,</para>
  <para style="q" vid="ISA 38:17">און דו האָסט געגלוסט מײַן זעל,</para>
  <para style="q" vid="ISA 38:17">פֿון דער גרוב פֿון אונטערגאַנג;</para>
  <para style="q" vid="ISA 38:17">װאָרעם האָסט אַװעקגעװאָרפֿן הינטער דײַן רוקן</para>
  <para style="q" vid="ISA 38:17">אַלע מײַנע זינד.<verse eid="ISA 38:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 38:18" />װאָרעם נישט די שְׁאֹול טוט דיך לױבן,</para>
  <para style="q" vid="ISA 38:18">נישט דער טױט טוט דיך רימען;</para>
  <para style="q" vid="ISA 38:18">עס האָפֿן נישט אױף דײַן אמת</para>
  <para style="q" vid="ISA 38:18">די װאָס נידערן אין גרוב.<verse eid="ISA 38:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 38:19" />דער לעבעדיקער, דער לעבעדיקער,</para>
  <para style="q" vid="ISA 38:19">ער טוט דיך לױבן, אַזױ װי איך הײַנט;</para>
  <para style="q" vid="ISA 38:19">אַ פֿאָטער מאַכט װיסן די קינדער דײַן אמת.<verse eid="ISA 38:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 38:20" />ה׳ איז דאָ מיך צו העלפֿן;</para>
  <para style="q" vid="ISA 38:20">און מײַנע געזאַנגען װעלן מיר זינגען,</para>
  <para style="q" vid="ISA 38:20">אַלע טעג פֿון אונדזער לעבן אין הױז פֿון ה׳.<verse eid="ISA 38:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="ISA 38:21" />און ישַעיָהו האָט געזאָגט: זאָל מען נעמען געפּרעסטע פֿײַגן, און אָנרײַבן אױף דעם אױסשלאָג, און ער װעט גענעזן װערן.<verse eid="ISA 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 38:22" />האָט חִזקִיָהו געזאָגט: װאָס איז דער צײכן אַז איך װעל אַרױפֿגײן אין הױז פֿון ה׳?<verse eid="ISA 38:22" /></para>
  <chapter eid="ISA 38" />
  <chapter number="39" style="c" pubnumber="לט" sid="ISA 39" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1" />אין יענער צײַט האָט מרודַך-באַלְאַדָן דער זון פֿון באַלְאַדָנען, דער מלך פֿון בָבֿל, געשיקט אַ בריװ און אַ מתּנה צו חִזקִיָהון; װאָרעם ער האָט געהערט אַז ער איז געװען קראַנק, און איז געזונט געװאָרן. <verse eid="ISA 39:1" /><verse number="2" style="v" sid="ISA 39:2" />האָט חִזקִיָהו זיך דערפֿרײט מיט זײ, און ער האָט זײ געװיזן זײַן שאַצהױז, דאָס זילבער, און דאָס גאָלד, און די בשׂמים, און דאָס גוטע אײל, און דאָס גאַנצע הױז פֿון זײַנע װאָפֿן, און אַלץ װאָס האָט זיך געפֿונען אין זײַנע שאַצקאַמערן; נישט געװען אַ זאַך אין זײַן הױז, און אין זײַן גאַנצער געװעלטיקײט, װאָס חִזקִיָהו האָט זײ נישט געװיזן. <verse eid="ISA 39:2" /><verse number="3" style="v" sid="ISA 39:3" />איז ישַעיָהו הנבֿיא געקומען צום מלך חִזקִיָהון, און האָט צו אים געזאָגט: װאָס האָבן די דאָזיקע מענער געזאָגט? און פֿון װאַנען קומען זײ צו דיר? האָט חִזקִיָהו געזאָגט: פֿון אַ װײַטן לאַנד זײַנען זײ צו מיר געקומען, פֿון בָבֿל. <verse eid="ISA 39:3" /><verse number="4" style="v" sid="ISA 39:4" />האָט ער געזאָגט: װאָס האָבן זײ געזען אין דײַן הױז? האָט חִזקִיָהו געזאָגט: אַלץ װאָס אין מײַן הױז האָבן זײ געזען; נישט געװען אַ זאַך אין מײַנע שאַצקאַמערן װאָס איך האָב זײ נישט געװיזן.<verse eid="ISA 39:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 39:5" />האָט ישַעיָהו געזאָגט צו חִזקִיָהון: הער דאָס װאָרט פֿון ה׳ צבָֿאוֹת: <verse eid="ISA 39:5" /><verse number="6" style="v" sid="ISA 39:6" />זע, טעג קומען, און אַלץ װאָס אין דײַן הױז, און װאָס דײַנע עלטערן האָבן אָנגעקליבן ביז הײַנטיקן טאָג, װעט אַװעקגעטראָגן װערן קײן בָבֿל; קײן זאַך װעט נישט איבערבלײַבן, זאָגט ה׳. <verse eid="ISA 39:6" /><verse number="7" style="v" sid="ISA 39:7" />און פֿון דײַנע זין װאָס װעלן אַרױסגײן פֿון דיר, װאָס דו װעסט געבערן, װעט מען נעמען, און זײ װעלן זײַן הױפֿדינער אין פּאַלאַץ פֿון דעם מלך פֿון בָבֿל.<verse eid="ISA 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 39:8" />האָט חִזקִיָהו געזאָגט צו ישַעיָהון: גוט איז דאָס װאָרט פֿון ה׳ װאָס דו האָסט גערעדט. און ער האָט געזאָגט: אױב שלום און זיכערקײט װעט זײַן אין מײַנע טעג!<verse eid="ISA 39:8" /></para>
  <chapter eid="ISA 39" />
  <chapter number="40" style="c" pubnumber="מ" sid="ISA 40" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 40:1" />טרײסט, טרײסט מײַן פֿאָלק, זאָגט אלוקיכם.<verse eid="ISA 40:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 40:2" />רעדט צום האַרצן פֿון ירושָלַיִם,</para>
  <para style="q" vid="ISA 40:2">און רופֿט צו איר,</para>
  <para style="q" vid="ISA 40:2">אַז זי האָט דערפֿילט איר צײַט,</para>
  <para style="q" vid="ISA 40:2">אַז אָפּגעצאָלט איז איר פֿאַרברעך;</para>
  <para style="q" vid="ISA 40:2">אַז זי האָט געקריגן פֿון ה׳ס האַנט</para>
  <para style="q" vid="ISA 40:2">טאָפּל פֿאַר אַלע אירע זינד.<verse eid="ISA 40:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 40:3" />אַ קֹול רופֿט אין דער מדבר:</para>
  <para style="q" vid="ISA 40:3">מאַכט צורעכט דעם װעג פֿון ה׳,</para>
  <para style="q" vid="ISA 40:3">מאַכט גראָד אין דער װיסטע</para>
  <para style="q" vid="ISA 40:3">אַ שטעג פֿאַר אלוקינו.<verse eid="ISA 40:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 40:4" />יעטװעדער טאָל זאָל דערהױבן װערן,</para>
  <para style="q" vid="ISA 40:4">און יעטװעדער באַרג און הײך זאָל דערנידערט װערן;</para>
  <para style="q" vid="ISA 40:4">און דאָס קרומע זאָל װערן גלײַך,</para>
  <para style="q" vid="ISA 40:4">און די באַרגקײטן אַ פּלױן.<verse eid="ISA 40:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 40:5" />און דער כּבֿוד פֿון ה׳ װעט אַנטפּלעקט װערן,</para>
  <para style="q" vid="ISA 40:5">און אַלע לײַבער אין אײנעם װעלן זען;</para>
  <para style="q" vid="ISA 40:5">װאָרעם דאָס מױל פֿון ה׳ האָט גערעדט.<verse eid="ISA 40:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 40:6" />אַ קֹול זאָגט: רוף!</para>
  <para style="q" vid="ISA 40:6">און ער זאָגט: װאָס זאָל איך רופֿן?</para>
  <para style="q" vid="ISA 40:6">אַלע לײַבער זײַנען גראָז,</para>
  <para style="q" vid="ISA 40:6">און אַל זײער חן װי אַ בלום פֿון פֿעלד;<verse eid="ISA 40:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 40:7" />פֿאַרטריקנט װערט דאָס גראָז,</para>
  <para style="q" vid="ISA 40:7">פֿאַרװעלקט װערט די בלום,</para>
  <para style="q" vid="ISA 40:7">אַז דער הױך פֿון ה׳ בלאָזט דערױף;</para>
  <para style="q" vid="ISA 40:7">פֿאַר װאָר, גראָז איז דאָס פֿאָלק.<verse eid="ISA 40:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 40:8" />פֿאַרטריקנט װערט דאָס גראָז,</para>
  <para style="q" vid="ISA 40:8">פֿאַרװעלקט װערט די בלום,</para>
  <para style="q" vid="ISA 40:8">אָבער דאָס װאָרט פֿון אלוקינו װעט אױף אײביק באַשטײן.<verse eid="ISA 40:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 40:9" />אױף אַ הױכן באַרג גײ דיר אַרױף,</para>
  <para style="q" vid="ISA 40:9">מבֿשׂרת פֿון צִיוֹן;</para>
  <para style="q" vid="ISA 40:9">הײב אױף מיט כּוֹח דײַן קֹול,</para>
  <para style="q" vid="ISA 40:9">מבֿשׂרת פֿון ירושָלַיִם;</para>
  <para style="q" vid="ISA 40:9">הײב אױף, האָב נישט מורא,</para>
  <para style="q" vid="ISA 40:9">זאָג צו די שטעט פֿון יהוּדה: אָט איז אלוקיכם!<verse eid="ISA 40:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 40:10" />זע, אֲדֹנָי ה׳ קומט אַ מאַכטיקער,</para>
  <para style="q" vid="ISA 40:10">און זײַן אָרעם געװעלטיקט פֿאַר אים;</para>
  <para style="q" vid="ISA 40:10">זע, זײַן שׂכַר איז מיט אים,</para>
  <para style="q" vid="ISA 40:10">און זײַן לױן אים פֿאַרױס;<verse eid="ISA 40:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 40:11" />װי אַ פּאַסטוך װעט ער פֿיטערן זײַן סטאַדע,</para>
  <para style="q" vid="ISA 40:11">מיט זײַן אָרעם װעט ער אײַנזאַמלען די לעמער,</para>
  <para style="q" vid="ISA 40:11">און אין זײַן בוזעם זײ טראָגן;</para>
  <para style="q" vid="ISA 40:11">די זײגעדיקע װעט ער פֿירן.<verse eid="ISA 40:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 40:12" />װער האָט געמאָסטן די װאַסערן מיט זײַן האַנטפֿול,</para>
  <para style="q" vid="ISA 40:12">און די הימלען מיט אַ שפּאַן אױסגעמאָסטן,</para>
  <para style="q" vid="ISA 40:12">און באַפֿאַסט אין אַ דרײַטל דעם שטױב פֿון דער ערד,</para>
  <para style="q" vid="ISA 40:12">און אָפּגעװױגן מיט אַ װאָג די בערג,</para>
  <para style="q" vid="ISA 40:12">און די הײכן מיט װאָגשאָלן?<verse eid="ISA 40:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 40:13" />װער האָט אָנגעװיזן דעם גײַסט פֿון ה׳?</para>
  <para style="q" vid="ISA 40:13">און װער איז זײַן בַעַל-עצה װאָס האָט אים צוגעװײַזן?<verse eid="ISA 40:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 40:14" />מיט װעמען האָט ער זיך מיועץ געװען,</para>
  <para style="q" vid="ISA 40:14">װאָס האָט אים געגעבן צו פֿאַרשטײן,</para>
  <para style="q" vid="ISA 40:14">און אים געלערנט דעם װעג פֿון גערעכטיקײט,</para>
  <para style="q" vid="ISA 40:14">און אים געלערנט קענשאַפֿט,</para>
  <para style="q" vid="ISA 40:14">און דעם װעג פֿון פֿאַרשטאַנדיקײט אים געמאַכט װיסן?<verse eid="ISA 40:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 40:15" />זע, פֿעלקער זײַנען װי אַ טריף פֿון אַן עמער,</para>
  <para style="q" vid="ISA 40:15">און װי שטױב פֿון װאָגשאָלן זײַנען זײ גערעכנט;</para>
  <para style="q" vid="ISA 40:15">זע, אינדזלען הײבט ער אױף װי אַ זעמדל.<verse eid="ISA 40:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 40:16" />און דער לבֿנוֹן איז נישט גענוג ברענװאַרג,</para>
  <para style="q" vid="ISA 40:16">און זײַנע חיות נישט גענוג בראַנדאָפּפֿער.<verse eid="ISA 40:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 40:17" />אַלע פֿעלקער זײַנען װי גאָרניט קעגן אים,</para>
  <para style="q" vid="ISA 40:17">פֿון נישט און גאָרנישט זײַנען זײ גערעכנט בײַ אים.<verse eid="ISA 40:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 40:18" />און צו װעמען קענט איר צוגלײַכן אֵל?</para>
  <para style="q" vid="ISA 40:18">און װאָסער געשטאַלט קענט איר אים גלײַך שטעלן?<verse eid="ISA 40:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 40:19" />דעם געץ װאָס אַ מײַנסטער האָט אױסגעגאָסן,</para>
  <para style="q" vid="ISA 40:19">און אַ שמעלצער ציט אים איבער מיט גאָלד,</para>
  <para style="q" vid="ISA 40:19">און שמעלצט-צו קײטלעך פֿון זילבער?<verse eid="ISA 40:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 40:20" />אַ שטײנדעמב װערט אױסגעקליבן,</para>
  <para style="q" vid="ISA 40:20">האָלץ װאָס פֿױלט נישט װײלט מען אױס;</para>
  <para style="q" vid="ISA 40:20">אַ קלוגן מײַנסטער זוכט מען זיך,</para>
  <para style="q" vid="ISA 40:20">אױפֿצושטעלן אַ געץ װאָס זאָל זיך נישט װאַקלען.<verse eid="ISA 40:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 40:21" />װײסט איר דען נישט?</para>
  <para style="q" vid="ISA 40:21">הערט איר דען נישט?</para>
  <para style="q" vid="ISA 40:21">איז אײַך פֿון אָנהײב אָן נישט דערצײלט געװאָרן?</para>
  <para style="q" vid="ISA 40:21">פֿאַרשטײט איר נישט די גרונטפֿעסטן פֿון דער ערד?<verse eid="ISA 40:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 40:22" />ער איז דער װאָס זיצט איבער דעם צירקל פֿון דער ערד,</para>
  <para style="q" vid="ISA 40:22">און אירע באַװױנער זײַנען װי הײשעריקן;</para>
  <para style="q" vid="ISA 40:22">דער װאָס שפּרײט װי אַ טול די הימלען,</para>
  <para style="q" vid="ISA 40:22">און ציט זײ אױס װי אַ געצעלט צום װױנען;<verse eid="ISA 40:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 40:23" />דער װאָס פֿאַרקערט פֿירשטן צו ניװעץ,</para>
  <para style="q" vid="ISA 40:23">װאָס מאַכט װי גאָרניט די ריכטער פֿון דער ערד.<verse eid="ISA 40:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 40:24" />נאָך צו מאָל נישט אײַנגעפֿלאַנצט זײַנען זײ,</para>
  <para style="q" vid="ISA 40:24">נאָך צו מאָל נישט פֿאַרזײט זײַנען זײ,</para>
  <para style="q" vid="ISA 40:24">נאָך צו מאָל נישט אײַנגעװאָרצלט אין דער ערד זײער שטאַם,</para>
  <para style="q" vid="ISA 40:24">און שױן טוט ער אַ בלאָז אױף זײ, און זײ װערן פֿאַרטריקנט,</para>
  <para style="q" vid="ISA 40:24">און אַ שטורעם טראָגט זײ װי שטרױ אַװעק.<verse eid="ISA 40:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="ISA 40:25" />און צו װעמען קענט איר מיך צוגלײַכן, איך זאָל גלײַך זײַן?</para>
  <para style="q" vid="ISA 40:25">זאָגט דער הײליקער.<verse eid="ISA 40:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 40:26" />הײבט אױף אין דער הײך אײַערע אױגן, און זעט:</para>
  <para style="q" vid="ISA 40:26">װער האָט באַשאַפֿן די דאָזיקע?</para>
  <para style="q" vid="ISA 40:26">ער, װאָס פֿירט אַרױס מיט אַ צאָל זײער חיל,</para>
  <para style="q" vid="ISA 40:26">זײ אַלע רופֿט ער מיטן נאָמען;</para>
  <para style="q" vid="ISA 40:26">דורך גרױס מאַכט, און װײַל ער איז שטאַרק אין כּוֹח,</para>
  <para style="q" vid="ISA 40:26">איז קײנער נישט געמינערט.<verse eid="ISA 40:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="ISA 40:27" />פֿאַר װאָס זאָלסטו זאָגן יעקבֿ,</para>
  <para style="q" vid="ISA 40:27">און זאָלסטו רעדן, יִשׂרָאֵל:</para>
  <para style="q" vid="ISA 40:27">פֿאַרבאָרגן איז מײַן װעג פֿון ה׳,</para>
  <para style="q" vid="ISA 40:27">און פֿון מײַן ג-ט איז מײַן משפּט אַװעק.<verse eid="ISA 40:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 40:28" />װײסטו דען נישט?</para>
  <para style="q" vid="ISA 40:28">צי האָסטו נישט געהערט?</para>
  <para style="q" vid="ISA 40:28">ה׳ איז דער אײביקער אלֹקים,</para>
  <para style="q" vid="ISA 40:28">דער באַשעפֿער פֿון די עקן פֿון דער ערד.</para>
  <para style="q" vid="ISA 40:28">ער װערט נישט מיד און נישט מאַט;</para>
  <para style="q" vid="ISA 40:28">נישט צו דערפֿאָרשן איז זײַן פֿאַרשטאַנדיקײט.<verse eid="ISA 40:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 40:29" />ער גיט דעם מידן כּוֹח,</para>
  <para style="q" vid="ISA 40:29">און דעם אוממאַכטיקן מערט ער שטאַרקײט.<verse eid="ISA 40:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 40:30" />און יונגע לײַט װעלן מיד און מאַט װערן,</para>
  <para style="q" vid="ISA 40:30">און יונגע װעלן שטרױכלען געשטרױכלט װערן;<verse eid="ISA 40:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 40:31" />אָבער די װאָס האָפֿן אױף ה׳ װעלן באַנײַען דעם כּוֹח,</para>
  <para style="q" vid="ISA 40:31">זײ װעלן אױפֿהײבן פֿליגלען װי די אָדלערס;</para>
  <para style="q" vid="ISA 40:31">זײ װעלן לױפֿן און נישט מיד װערן,</para>
  <para style="q" vid="ISA 40:31">זײ װעלן גײן און נישט מאַט װערן.<verse eid="ISA 40:31" /></para>
  <chapter eid="ISA 40" />
  <chapter number="41" style="c" pubnumber="מא" sid="ISA 41" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 41:1" />שװײַגט פֿאַר מיר, איר אינדזלען,</para>
  <para style="q" vid="ISA 41:1">און זאָלן די פֿעלקער באַנײַען דעם כּוֹח;</para>
  <para style="q" vid="ISA 41:1">זאָלן זײ זיך נענטערן, דענצמאָל זאָלן זײ רעדן;</para>
  <para style="q" vid="ISA 41:1">בײַנאַנד לאָמיר צום משפּט גענענען.<verse eid="ISA 41:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 41:2" />װער האָט דערװעקט פֿון מזרח דעם גערעכטן,</para>
  <para style="q" vid="ISA 41:2">רופֿט אים צו זײַן פֿוס?</para>
  <para style="q" vid="ISA 41:2">ער גיט פֿאַר אים פֿעלקער,</para>
  <para style="q" vid="ISA 41:2">און מאַכט אים געװעלטיגן איבער מלכים;</para>
  <para style="q" vid="ISA 41:2">ער מאַכט װי שטױב זײַער שװערד,</para>
  <para style="q" vid="ISA 41:2">װי צװײעטע שטרױ זײַער בױגן.<verse eid="ISA 41:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 41:3" />ער פֿאָלגט זײ נאָך,</para>
  <para style="q" vid="ISA 41:3">ער גײט דורך בשלום, אױף אַ װעג</para>
  <para style="q" vid="ISA 41:3">װאָס מיט זײַנע פֿיס איז ער נישט געגאַנגען.<verse eid="ISA 41:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 41:4" />װער האָט דאָס געטאָן און אױסגעפֿירט?</para>
  <para style="q" vid="ISA 41:4">דער װאָס רופֿט די דורות פֿון אָנהױב אָן;</para>
  <para style="q" vid="ISA 41:4">איך, דער אײביקער, בין דער ערשטער,</para>
  <para style="q" vid="ISA 41:4">און מיט די לעצטע בין איך דערזעלבער.<verse eid="ISA 41:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 41:5" />די אינדזלען האָבן געזען, און האָבן מורא,</para>
  <para style="q" vid="ISA 41:5">די עקן פֿון דער ערד טוען ציטערן;</para>
  <para style="q" vid="ISA 41:5">זײ האָבן גענענט און זײַנען געקומען.<verse eid="ISA 41:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 41:6" />אײנער העלפֿט דעם אַנדערן,</para>
  <para style="q" vid="ISA 41:6">און ער זאָגט צו זײַן ברודער: זײַ שטאַרק;<verse eid="ISA 41:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 41:7" />און דער טישלער שטאַרקט דעם שמעלצער,</para>
  <para style="q" vid="ISA 41:7">דער װאָס גלעט מיטן האַמער,</para>
  <para style="q" vid="ISA 41:7">דעם װאָס קלאַפּט אױפֿן אַמבאָס;</para>
  <para style="q" vid="ISA 41:7">ער זאָגט אױפֿן צונױפֿלײט: ער איז גוט;</para>
  <para style="q" vid="ISA 41:7">און באַפֿעסטיקט עס מיט נעגל,</para>
  <para style="q" vid="ISA 41:7">עס זאָל זיך נישט װאַקלען.<verse eid="ISA 41:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 41:8" />און דו יִשׂרָאֵל מײַן קנעכט,</para>
  <para style="q" vid="ISA 41:8">יעקבֿ, װאָס איך האָב דיך אױסדערװײלט,</para>
  <para style="q" vid="ISA 41:8">דער זאָמען פֿון אבֿרהם מײַן ליבהאָבער,<verse eid="ISA 41:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 41:9" />װאָס איך האָב דיך אָנגענומען פֿון די עקן ערד,</para>
  <para style="q" vid="ISA 41:9">און פֿון אירע ברעגן דיך גערופֿן,</para>
  <para style="q" vid="ISA 41:9">און געזאָגט צו דיר: מײַן קנעכט ביסטו,</para>
  <para style="q" vid="ISA 41:9">איך האָב דיך אױסדערװײלט און דיך נישט פֿאַראַכט;<verse eid="ISA 41:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 41:10" />זאָלסט נישט מורא האָבן, װאָרעם איך בין מיט דיר,</para>
  <para style="q" vid="ISA 41:10">זאָלסט זיך נישט אומקוקן, װאָרעם איך בין דײַן ג-ט;</para>
  <para style="q" vid="ISA 41:10">איך שטאַרק דיך און איך העלף דיך,</para>
  <para style="q" vid="ISA 41:10">און איך לען דיך אונטער מיט דער רעכטער האַנט פֿון מײַן גערעכטיקײט.<verse eid="ISA 41:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 41:11" />זע, פֿאַרשעמט און צו שאַנד װעלן װערן</para>
  <para style="q" vid="ISA 41:11">אַלע װאָס זײַנען אָנגעצונדן אױף דיר;</para>
  <para style="q" vid="ISA 41:11">װי נישט װעלן װערן</para>
  <para style="q" vid="ISA 41:11">און אונטערגײן די מענטשן אין קריג מיט דיר;<verse eid="ISA 41:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 41:12" />װעסט זײ זוכן און זײ נישט געפֿינען,</para>
  <para style="q" vid="ISA 41:12">די מענטשן אין שטרײַט מיט דיר;</para>
  <para style="q" vid="ISA 41:12">װי נישט און װי גאָרנישט װעלן װערן</para>
  <para style="q" vid="ISA 41:12">די מענטשן אין מלחמה מיט דיר.<verse eid="ISA 41:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 41:13" />װאָרעם איך בין ה׳ דײַן ג-ט</para>
  <para style="q" vid="ISA 41:13">װאָס האַלט דײַן רעכטע האַנט,</para>
  <para style="q" vid="ISA 41:13">דער װאָס זאָגט צו דיר:</para>
  <para style="q" vid="ISA 41:13">זאָלסט נישט מורא האָבן, איך העלף דיך.<verse eid="ISA 41:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 41:14" />זאָלסט נישט מורא האָבן, װאָרעם יעקבֿ, הײפֿעלע יִשׂרָאֵל;</para>
  <para style="q" vid="ISA 41:14">איך העלף דיך, זאָגט ה׳,</para>
  <para style="q" vid="ISA 41:14">און דײַן אױסלײזער איז דער הײליקער פֿון יִשׂרָאֵל.<verse eid="ISA 41:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 41:15" />זע, איך מאַך דיך פֿאַר אַ דרעששליטן אַ נײַעם,</para>
  <para style="q" vid="ISA 41:15">מיט שפּיצן אַ סך;</para>
  <para style="q" vid="ISA 41:15">װעסט דרעשן בערג און צעמאָלן,</para>
  <para style="q" vid="ISA 41:15">– און הײכן װעסטו װי שפּרײ מאַכן.<verse eid="ISA 41:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 41:16" />װעסט זײ װינטשופֿלען,</para>
  <para style="q" vid="ISA 41:16">און אַ װינט װעט זײ אַװעקטראָגן,</para>
  <para style="q" vid="ISA 41:16">און אַ שטורעם װעט זײ צעשפּרײטן;</para>
  <para style="q" vid="ISA 41:16">און דו װעסט זיך פֿרײען מיט ה׳,</para>
  <para style="q" vid="ISA 41:16">מיט דעם הײליקן פֿון יִשׂרָאֵל װעסטו זיך רימען.<verse eid="ISA 41:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 41:17" />די אָרימע און באַדערפֿטיקע זוכן װאַסער און נישטאָ,</para>
  <para style="q" vid="ISA 41:17">זײער צונג איז פֿאַרטריקנט פֿון דאָרשט;</para>
  <para style="q" vid="ISA 41:17">איך, ה׳, װעל זײ ענטפֿערן,</para>
  <para style="q" vid="ISA 41:17">איך, אלוקי יִשׂרָאֵל, װעל זײ נישט פֿאַרלאָזן.<verse eid="ISA 41:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 41:18" />איך װעל עפֿענען שטראָמען אױף הױכע ערטער,</para>
  <para style="q" vid="ISA 41:18">און קװאַלן אין מיטן פֿון טאָלן;</para>
  <para style="q" vid="ISA 41:18">איך װעל מאַכן דעם מדבר פֿאַר אַ געמױזעכץ װאַסער,</para>
  <para style="q" vid="ISA 41:18">און טרוקן לאַנד פֿאַר אױסגאַנגען װאַסער.<verse eid="ISA 41:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 41:19" />איך װעל געבן אין מדבר צעדער,</para>
  <para style="q" vid="ISA 41:19">אַקאַציע, און מירט, און אײלבױם;</para>
  <para style="q" vid="ISA 41:19">איך װעל אײַנזעצן אין דער װיסטע ציפּרעס,</para>
  <para style="q" vid="ISA 41:19">טענענבױם און בוקסנבױם אין אײנעם;<verse eid="ISA 41:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 41:20" />כּדי זײ זאָלן זען און װיסן,</para>
  <para style="q" vid="ISA 41:20">און באַטראַכטן און פֿאַרשטײן צוגלײַך,</para>
  <para style="q" vid="ISA 41:20">אַז די האַנט פֿון ה׳ האָט דאָס געטאָן,</para>
  <para style="q" vid="ISA 41:20">און דער הײליקער פֿון יִשׂרָאֵל האָט עס געשאַפֿן.<verse eid="ISA 41:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 41:21" />ברענגט אַהער אײַער קריג, זאָגט ה׳,</para>
  <para style="q" vid="ISA 41:21">גענענט אײַערע טענות, זאָגט דער קיניג פֿון יעקבֿ.<verse eid="ISA 41:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 41:22" />זאָלן זײ גענענען און אונדז זאָגן</para>
  <para style="q" vid="ISA 41:22">די זאַכן װאָס געשעען;</para>
  <para style="q" vid="ISA 41:22">די פֿריִערדיקע – װאָס זײַנען זײ?</para>
  <para style="q" vid="ISA 41:22">זאָגט, כּדי מיר זאָלן צולײגן אונדזער האַרץ,</para>
  <para style="q" vid="ISA 41:22">און דערקענען זײער אױסלאָזן;</para>
  <para style="q" vid="ISA 41:22">אָדער די קומעדיקע לאָזט אונדז הערן.<verse eid="ISA 41:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 41:23" />דערצײלט אונדז װאָס װעט קומען שפּעטער,</para>
  <para style="q" vid="ISA 41:23">און מיר װעלן װיסן אַז איר זײַט ג‑טער;</para>
  <para style="q" vid="ISA 41:23">יאָ, טוט גוטס אָדער טוט שלעכטס,</para>
  <para style="q" vid="ISA 41:23">און מיר װעלן זיך אומקוקן און זען צוגלײַך.<verse eid="ISA 41:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 41:24" />זעט, איר זײַט פֿון נישט,</para>
  <para style="q" vid="ISA 41:24">און אײַער װערק פֿון גאָרנישט;</para>
  <para style="q" vid="ISA 41:24">אומװערדיק איז דער װאָס טוט אײַך אױסװײלן.<verse eid="ISA 41:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="ISA 41:25" />איך האָב דערװעקט פֿון צפֿון, און ער איז געקומען,</para>
  <para style="q" vid="ISA 41:25">פֿון זונאױפֿגאַנג דעם װאָס רופֿט מײַן נאָמען;</para>
  <para style="q" vid="ISA 41:25">און ער גײט אױף פֿירשטן װי אױף קױט,</para>
  <para style="q" vid="ISA 41:25">און װי אַ טעפּער טרעט לײם.<verse eid="ISA 41:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 41:26" />װער האָט אָנגעזאָגט פֿון אָנהײב, אַז מיר זאָלן װיסן,</para>
  <para style="q" vid="ISA 41:26">און פֿון פֿריִער, אַז מיר זאָלן זאָגן: ער איז גערעכט?</para>
  <para style="q" vid="ISA 41:26">קײנער צו מאָל האָט נישט אָנגעזאָגט,</para>
  <para style="q" vid="ISA 41:26">קײנער צו מאָל האָט נישט געלאָזט הערן,</para>
  <para style="q" vid="ISA 41:26">קײנער צו מאָל האָט נישט געהערט אײַערע װערטער.<verse eid="ISA 41:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 41:27" />אַן ערשטער קײן צִיוֹן: זע, אָן זײַנען זײ!</para>
  <para style="q" vid="ISA 41:27">און ירושָלַיִם װעל איך געבן אַ מבֿשׂר.<verse eid="ISA 41:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 41:28" />אָבער איך קוק, און קײנער איז נישטאָ,</para>
  <para style="q" vid="ISA 41:28">און פֿון די דאָזיקע איז נישטאָ קײן יוֹעץ,</para>
  <para style="q" vid="ISA 41:28">װאָס איך זאָל זײ פֿרעגן,</para>
  <para style="q" vid="ISA 41:28">און זײ זאָלן ענטפֿערן אַ װאָרט.<verse eid="ISA 41:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 41:29" />זע, זײ אַלע זײַנען בײזס,</para>
  <para style="q" vid="ISA 41:29">נישטיק זײַנען זײערע װערק,</para>
  <para style="q" vid="ISA 41:29">װינט און װיסטקײט זײערע געצן.<verse eid="ISA 41:29" /></para>
  <chapter eid="ISA 41" />
  <chapter number="42" style="c" pubnumber="מב" sid="ISA 42" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 42:1" />אָט איז מײַן קנעכט װאָס איך לען אים אונטער,</para>
  <para style="q" vid="ISA 42:1">מײַן אױסדערװײלטער װאָס מײַן זעל באַגערט;</para>
  <para style="q" vid="ISA 42:1">איך האָב אַרױפֿגעטאָן מײַן גײַסט אױף אים,</para>
  <para style="q" vid="ISA 42:1">אַ משפּט צו די פֿעלקער װעט ער אַרױסלאָזן.<verse eid="ISA 42:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 42:2" />ער װעט נישט שרײַען, און נישט הילכן,</para>
  <para style="q" vid="ISA 42:2">און נישט לאָזן הערן אין גאַס זײַן קֹול.<verse eid="ISA 42:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 42:3" />אַן אײַנגעבראָכן שטעקל װעט ער נישט צעברעכן,</para>
  <para style="q" vid="ISA 42:3">און אַ טונקעלן קנױט װעט ער נישט פֿאַרלעשן;</para>
  <para style="q" vid="ISA 42:3">לױטן אמת װעט ער אַרױסלאָזן אַ משפּט.<verse eid="ISA 42:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 42:4" />ער װעט נישט מאַט װערן און נישט געבראָכן װערן,</para>
  <para style="q" vid="ISA 42:4">ביז ער װעט טאָן אױף דער ערד גערעכטיקײט;</para>
  <para style="q" vid="ISA 42:4">און אינדזלען װעלן װאַרטן אױף זײַן תּורה.<verse eid="ISA 42:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 42:5" />אַזױ האָט געזאָגט הָאֵל ה׳,</para>
  <para style="q" vid="ISA 42:5">װאָס האָט באַשאַפֿן די הימלען און זײ אױסגעצױגן,</para>
  <para style="q" vid="ISA 42:5">װאָס האָט אױסגעשפּרײט די ערד מיט אירע שפּראָצונגען,</para>
  <para style="q" vid="ISA 42:5">װאָס גיט אָטעם דעם פֿאָלק אױף איר,</para>
  <para style="q" vid="ISA 42:5">און אַ גײַסט די װאָס גײען אױף איר:<verse eid="ISA 42:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 42:6" />איך ה׳ האָב דיך גערופֿן אין גערעכטיקײט,</para>
  <para style="q" vid="ISA 42:6">און איך װעל אָננעמען דײַן האַנט, און דיך היטן,</para>
  <para style="q" vid="ISA 42:6">און דיך מאַכן פֿאַר אַ ברית מיט די פֿעלקער,</para>
  <para style="q" vid="ISA 42:6">פֿאַר אַ ליכט פֿון די אומות;<verse eid="ISA 42:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 42:7" />צו עפֿענען בלינדע אױגן,</para>
  <para style="q" vid="ISA 42:7">אַרױסצוציען פֿון געפֿענקעניש דעם געפֿאַנגענעם,</para>
  <para style="q" vid="ISA 42:7">פֿון תּפֿיסה די װאָס זיצן אין פֿינצטערניש.<verse eid="ISA 42:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 42:8" />איך בין ה׳, דאָס איז מײַן נאָמען;</para>
  <para style="q" vid="ISA 42:8">און מײַן כּבֿוד װעל איך צו קײן אַנדערן נישט געבן,</para>
  <para style="q" vid="ISA 42:8">און מײַן לױב – צו קײן געצן.<verse eid="ISA 42:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 42:9" />דאָס פֿריִערדיקע, זע, איז אָנגעקומען,</para>
  <para style="q" vid="ISA 42:9">און נײַס װעל איך אָנזאָגן;</para>
  <para style="q" vid="ISA 42:9">אײדער עס שפּראָצט אַרױס</para>
  <para style="q" vid="ISA 42:9">װעל איך עס אײַך מאַכן הערן.<verse eid="ISA 42:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 42:10" />זינגט צו ה׳ אַ נײַ געזאַנג,</para>
  <para style="q" vid="ISA 42:10">זײַן לױב פֿון עק פֿון דער ערד,</para>
  <para style="q" vid="ISA 42:10">איר װאָס נידערט אױפֿן ים און זײַן פֿולקײט,</para>
  <para style="q" vid="ISA 42:10">אינדזלען און זײערע באַװױנער.<verse eid="ISA 42:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 42:11" />זאָלן הילכן דער מדבר און זײַנע שטעט,</para>
  <para style="q" vid="ISA 42:11">די דערפֿער װאָס קֵדָר באַװױנט;</para>
  <para style="q" vid="ISA 42:11">זאָלן זינגען די באַװױנער פֿון פֿעלדז,</para>
  <para style="q" vid="ISA 42:11">פֿון שפּיץ בערג זאָלן זײ שרײַען.<verse eid="ISA 42:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 42:12" />זאָלן זײ טאָן כּבֿוד צו ה׳,</para>
  <para style="q" vid="ISA 42:12">און זײַן לױב אין די אינדזלען דערצײלן.<verse eid="ISA 42:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 42:13" />ה׳ װעט אַרױסגײן װי אַ גיבור,</para>
  <para style="q" vid="ISA 42:13">װי אַ קריגסמאַן װעט ער װעקן זײַן קִנְאָה;</para>
  <para style="q" vid="ISA 42:13">ער װעט שאַלן און װעט שרײַען,</para>
  <para style="q" vid="ISA 42:13">איבער די פֿײַנט זײַנע װעט ער זיך שטאַרקן.<verse eid="ISA 42:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 42:14" />איך האָב געשװיגן פֿון לאַנג אָן,</para>
  <para style="q" vid="ISA 42:14">איך פֿלעג שטיל זײַן, זיך אײַנהאַלטן;</para>
  <para style="q" vid="ISA 42:14">אַצונד װעל איך שרײַען װי אַ געװינערין,</para>
  <para style="q" vid="ISA 42:14">איך װעל העשען און סאָפּען אין אײנעם.<verse eid="ISA 42:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 42:15" />איך װעל פֿאַרװיסטן די בערג און די הײכן,</para>
  <para style="q" vid="ISA 42:15">און אַל זײער גראָז װעל איך פֿאַרדאַרן;</para>
  <para style="q" vid="ISA 42:15">און איך װעל מאַכן טײַכן פֿאַר אינדזלען,</para>
  <para style="q" vid="ISA 42:15">און געמױזעכץ װעל איך פֿאַרטריקענען.<verse eid="ISA 42:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 42:16" />און איך װעל מאַכן גײן בלינדע</para>
  <para style="q" vid="ISA 42:16">אױף אַ װעג װאָס זײ האָבן נישט געװוּסט,</para>
  <para style="q" vid="ISA 42:16">אױף שטעגן װאָס זײ האָבן נישט געװוּסט</para>
  <para style="q" vid="ISA 42:16">װעל איך זײ פֿירן;</para>
  <para style="q" vid="ISA 42:16">איך װעל מאַכן זײ פֿאַרױס פֿינצטערניש צו ליכט,</para>
  <para style="q" vid="ISA 42:16">און קרומענישן פֿאַר אַ פּלױן.</para>
  <para style="q" vid="ISA 42:16">די דאָזיקע זאַכן, זײ טו איך,</para>
  <para style="q" vid="ISA 42:16">און לאָז זײ נישט אױס.<verse eid="ISA 42:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 42:17" />אָפּטרעטן אַהינטער, שעמען װעלן זיך שעמען,</para>
  <para style="q" vid="ISA 42:17">די װאָס פֿאַרזיכערן זיך אױפֿן געשניצטן בילד,</para>
  <para style="q" vid="ISA 42:17">די װאָס זאָגן צו געגאָסענע געצן:</para>
  <para style="q" vid="ISA 42:17">איר זײַט אונדזערע ג‑טער.<verse eid="ISA 42:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 42:18" />איר טױבע הערט,</para>
  <para style="q" vid="ISA 42:18">און איר בלינדע, קוקט זעט.<verse eid="ISA 42:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 42:19" />װער איז בלינד אױב נישט מײַן קנעכט?</para>
  <para style="q" vid="ISA 42:19">אָדער טױב װי מײַן שליח װאָס איך שיק?</para>
  <para style="q" vid="ISA 42:19">װער איז בלינד װי דער װאָס איז פֿרום,</para>
  <para style="q" vid="ISA 42:19">און בלינד װי דער קנעכט פֿון ה׳?<verse eid="ISA 42:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 42:20" />געזען פֿיל, אָבער דו מערקסט נישט;</para>
  <para style="q" vid="ISA 42:20">אָפֿן די אױערן, אָבער ער הערט נישט.<verse eid="ISA 42:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 42:21" />ה׳ האָט באַװיליקט פֿון װעגן זײַן גערעכטיקײט,</para>
  <para style="q" vid="ISA 42:21">ער זאָל גרײסן די תּורה און פּראַכטיקן.<verse eid="ISA 42:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 42:22" />אָבער עס איז אַ באַרױבט און באַראַבעװעט פֿאָלק,</para>
  <para style="q" vid="ISA 42:22">געפֿאַנגען אין לעכער האָט מען זײ אַלע,</para>
  <para style="q" vid="ISA 42:22">און אין תּפֿיסות זײַנען זײ באַהאַלטן;</para>
  <para style="q" vid="ISA 42:22">זײ זײַנען געװאָרן צו רױב,</para>
  <para style="q" vid="ISA 42:22">און נישטאָ װער זאָל מציל זײַן,</para>
  <para style="q" vid="ISA 42:22">צו אױסרױבונג, און נישטאָ װער זאָל זאָגן: קער אום!<verse eid="ISA 42:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 42:23" />װער צװישן אײַך װיל פֿאַרנעמען דאָס דאָזיקע,</para>
  <para style="q" vid="ISA 42:23">האָרכן און פֿאַרשטײן פֿאַרױס?<verse eid="ISA 42:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 42:24" />װער האָט געגעבן צו אױסרױבונג יעקבֿ,</para>
  <para style="q" vid="ISA 42:24">און יִשׂרָאֵל צו רױבער?</para>
  <para style="q" vid="ISA 42:24">איז דאָס נישט ה׳, װאָס מיר האָבן געזינדיקט צו אים,</para>
  <para style="q" vid="ISA 42:24">און אין זײַנע װעגן האָט מען נישט געװאָלט גײן,</para>
  <para style="q" vid="ISA 42:24">און זײַן תּורה האָט מען נישט צוגעהערט?<verse eid="ISA 42:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 42:25" />דערום האָט ער אױסגעגאָסן אױף אים</para>
  <para style="q" vid="ISA 42:25">דעם גרים פֿון זײַן צאָרן,</para>
  <para style="q" vid="ISA 42:25">און די שטאַרקײט פֿון מלחמה;</para>
  <para style="q" vid="ISA 42:25">און זי האָט אים אָנגעצונדן רונד אַרום,</para>
  <para style="q" vid="ISA 42:25">און ער האָט נישט געמערקט,</para>
  <para style="q" vid="ISA 42:25">און זי האָט אים געברענט,</para>
  <para style="q" vid="ISA 42:25">און ער נעמט נישט צום האַרצן.<verse eid="ISA 42:25" /></para>
  <chapter eid="ISA 42" />
  <chapter number="43" style="c" pubnumber="מג" sid="ISA 43" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 43:1" />און אַצונד האָט אַזױ געזאָגט ה׳ דײַן בורא, יעקבֿ,</para>
  <para style="q" vid="ISA 43:1">און דײַן פֿורעמער, יִשׂרָאֵל;</para>
  <para style="q" vid="ISA 43:1">זאָלסט נישט מורא האָבן, װאָרעם איך לײז דיך אױס,</para>
  <para style="q" vid="ISA 43:1">איך רוף דיך בײַם נאָמען, מײַנער ביסטו.<verse eid="ISA 43:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 43:2" />אַז דו װעסט גײן דורך װאַסער, בין איך מיט דיר,</para>
  <para style="q" vid="ISA 43:2">און אַז דורך טײַכן, װעלן זײ דיך נישט פֿאַרפֿלײצן;</para>
  <para style="q" vid="ISA 43:2">און דו װעסט גײן דורך פֿײַער, װעסטו נישט אָנגעברענט װערן,</para>
  <para style="q" vid="ISA 43:2">און קײן פֿלאַם װעט דיך נישט אָנצינדן.<verse eid="ISA 43:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 43:3" />װאָרעם איך בין ה׳ דײַן ג-ט,</para>
  <para style="q" vid="ISA 43:3">דער הײליקער פֿון יִשׂרָאֵל, דײַן העלפֿער;</para>
  <para style="q" vid="ISA 43:3">איך גיב מִצרַיִם פֿאַר דײַן אױסלײז,</para>
  <para style="q" vid="ISA 43:3">כּוּש און סבֿאָ אַנשטאָט דיר.<verse eid="ISA 43:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 43:4" />װײַל טײַער ביסטו אין מײַנע אױגן,</para>
  <para style="q" vid="ISA 43:4">געאַכט, און איך האָב דיך ליב;</para>
  <para style="q" vid="ISA 43:4">דערום גיב איך מענטשן אַנשטאָט דיר,</para>
  <para style="q" vid="ISA 43:4">און פֿעלקער אַנשטאָט דײַן לעבן.<verse eid="ISA 43:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 43:5" />זאָלסט נישט מורא האָבן,</para>
  <para style="q" vid="ISA 43:5">װאָרעם איך בין מיט דיר;</para>
  <para style="q" vid="ISA 43:5">פֿון מזרח װעל איך ברענגען דײַן זאָמען,</para>
  <para style="q" vid="ISA 43:5">און פֿון מערבֿ װעל איך דיך אײַנזאַמלען;<verse eid="ISA 43:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 43:6" />איך װעל זאָגן צו צפֿון: גיב אַהער!</para>
  <para style="q" vid="ISA 43:6">און צו דָרום: זאָלסט נישט צוריקהאַלטן!</para>
  <para style="q" vid="ISA 43:6">ברענג מײַנע זין פֿון דער װײַט,</para>
  <para style="q" vid="ISA 43:6">און מײַנע טעכטער פֿון עק ערד;<verse eid="ISA 43:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 43:7" />איטלעכן װאָס װערט גערופֿן מיט מײַן נאָמען,</para>
  <para style="q" vid="ISA 43:7">און װאָס איך האָב אים פֿאַר מײַן כּבֿוד באַשאַפֿן,</para>
  <para style="q" vid="ISA 43:7">אים געפֿורעמט און אים געמאַכט.<verse eid="ISA 43:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 43:8" />ציט אַרױס דאָס פֿאָלק װאָס איז בלינד, און האָט אױגן,</para>
  <para style="q" vid="ISA 43:8">און די װאָס זײַנען טױב, און האָבן אױערן.<verse eid="ISA 43:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 43:9" />אַלע פֿעלקער זאָלן זיך אײַנזאַמלען אין אײנעם,</para>
  <para style="q" vid="ISA 43:9">און לאָזן זיך אױפֿקלײַבן די אומות;</para>
  <para style="q" vid="ISA 43:9">װער צװישן זײ קען דאָס זאָגן,</para>
  <para style="q" vid="ISA 43:9">און פֿאַרױסגעזענס אונדז לאָזן הערן?</para>
  <para style="q" vid="ISA 43:9">זאָלן זײ ברענגען זײערע עדות, און גערעכט זײַן,</para>
  <para style="q" vid="ISA 43:9">און זאָל מען הערן און זאָגן: עס איז אמת.<verse eid="ISA 43:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 43:10" />איר זײַט מײַנע עדות, זאָגט ה׳,</para>
  <para style="q" vid="ISA 43:10">און מײַן קנעכט װאָס איך האָב אױסדערװײלט,</para>
  <para style="q" vid="ISA 43:10">כּדי איר זאָלט װיסן, און גלױבן אין מיר,</para>
  <para style="q" vid="ISA 43:10">און פֿאַרשטײן אַז איך בין דאָס;</para>
  <para style="q" vid="ISA 43:10">פֿאַר מיר איז נישט געשאַפֿן געװאָרן קײן אֵל,</para>
  <para style="q" vid="ISA 43:10">און נאָך מיר װעט נישט זײַן.<verse eid="ISA 43:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 43:11" />איך, איך בין ה׳,</para>
  <para style="q" vid="ISA 43:11">און חוץ מיר איז קײן העלפֿער נישטאָ.<verse eid="ISA 43:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 43:12" />איך האָב אָנגעזאָגט און געהאָלפֿן,</para>
  <para style="q" vid="ISA 43:12">און איך האָב געמאַכט הערן,</para>
  <para style="q" vid="ISA 43:12">און נישט אַ פֿרעמדער איז געװען צװישן אײַך;</para>
  <para style="q" vid="ISA 43:12">און איר זײַט מײַנע עדות, זאָגט ה׳,</para>
  <para style="q" vid="ISA 43:12">אַז איך בין אֵל.<verse eid="ISA 43:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 43:13" />אױך הײַנט בין איך דער אײגענער,</para>
  <para style="q" vid="ISA 43:13">און נישטאָ װער זאָל מציל זײַן פֿון מײַן האַנט;</para>
  <para style="q" vid="ISA 43:13">איך טו, און װער קען עס אָפּהאַלטן?<verse eid="ISA 43:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 43:14" />אַזױ האָט געזאָגט ה׳ אײַער אױסלײזער,</para>
  <para style="q" vid="ISA 43:14">דער הײליקער פֿון יִשׂרָאֵל:</para>
  <para style="q" vid="ISA 43:14">פֿון אײַערט װעגן שיק איך קײן בָבֿל,</para>
  <para style="q" vid="ISA 43:14">און װעל זײ אַלע מאַכן נידערן אַנטלאָפֿענע,</para>
  <para style="q" vid="ISA 43:14">און די כַּשׂדים – אין זײערע לוסטיקע שיפֿן.<verse eid="ISA 43:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 43:15" />איך בין ה׳, אײַער הײליקער,</para>
  <para style="q" vid="ISA 43:15">דער באַשעפֿער פֿון יִשׂרָאֵל, אײַער קיניג.<verse eid="ISA 43:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 43:16" />אַזױ האָט ה׳ געזאָגט,</para>
  <para style="q" vid="ISA 43:16">דער װאָס האָט געגעבן דורכן ים אַ װעג,</para>
  <para style="q" vid="ISA 43:16">און דורך מאַכטיקע װאַסערן אַ שטעג;<verse eid="ISA 43:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 43:17" />װאָס האָט געלאָזט אַרױסציען</para>
  <para style="q" vid="ISA 43:17">רײַטװעגן און פֿערד, חיל און שטאַרקײט,</para>
  <para style="q" vid="ISA 43:17">זײ זאָלן ליגן אין אײנעם, זײ זאָלן נישט אױפֿשטײן –</para>
  <para style="q" vid="ISA 43:17">זײ האָבן געצאַנקט, זײ האָבן װי אַ קנױט זיך אױסגעלאָשן:<verse eid="ISA 43:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 43:18" />איר זאָלט נישט דערמאָנען דאָס פֿריִערדיקע,</para>
  <para style="q" vid="ISA 43:18">און דאָס אַמאָליקע זאָלט איר נישט באַרטראַכטן.<verse eid="ISA 43:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 43:19" />אָט טו איך אַ נײַס;</para>
  <para style="q" vid="ISA 43:19">אַצונד שפּראָצט עס; דערקענט איר עס נישט?</para>
  <para style="q" vid="ISA 43:19">יאָ, איך װעל מאַכן אין מדבר אַ װעג,</para>
  <para style="q" vid="ISA 43:19">אין דער װיסטעניש טײַכן.<verse eid="ISA 43:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 43:20" />ערלעכן װעט מיך די חיה פֿון פֿעלד,</para>
  <para style="q" vid="ISA 43:20">שאַקאַלן און שטרױספֿױגלען,</para>
  <para style="q" vid="ISA 43:20">װײַל איך גיב אין מדבר װאַסער,</para>
  <para style="q" vid="ISA 43:20">טײַכן אין דער װיסטעניש,</para>
  <para style="q" vid="ISA 43:20">אָנצוטרינקען מײַן פֿאָלק, מײַן אױסדערװײלטס;<verse eid="ISA 43:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 43:21" />דאָס פֿאָלק װאָס איך האָב מיר באַשאַפֿן,</para>
  <para style="q" vid="ISA 43:21">זײ זאָלן דערצײלן מײַן לױב.<verse eid="ISA 43:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 43:22" />און מיך האָסטו נישט גערופֿן, יעקבֿ,</para>
  <para style="q" vid="ISA 43:22">אַז דו זאָלסט זײַן מיד פֿון מיר, יִשׂרָאֵל;<verse eid="ISA 43:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 43:23" />האָסט מיר נישט געבראַכט דאָס לאַם פֿון דײַנע בראַנדאָפּפֿער,</para>
  <para style="q" vid="ISA 43:23">און מיט דײַנע שלאַכטאָפּפֿער האָסטו מיך נישט געערלעכט;</para>
  <para style="q" vid="ISA 43:23">איך האָב דיך נישט באַשװערט מיט שפּײַזאָפּפֿער,</para>
  <para style="q" vid="ISA 43:23">און דיך נישט מיד געמאַכט מיט װײַרעך.<verse eid="ISA 43:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 43:24" />האָסט מיר נישט געקױפֿט פֿאַר געלט געװירצראָר,</para>
  <para style="q" vid="ISA 43:24">און מיט פֿעטס פֿון דײַנע שלאַכטאָפּפֿער מיך נישט געזעט;</para>
  <para style="q" vid="ISA 43:24">נײַערט האָסט מיך באַשװערט מיט דײַנע חטאָים,</para>
  <para style="q" vid="ISA 43:24">מיך מיד געמאַכט מיט דײַנע זינד.<verse eid="ISA 43:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="ISA 43:25" />איך, איך בין דער װאָס מעק אױס</para>
  <para style="q" vid="ISA 43:25">דײַנע איבערטרעטן פֿון מײַנעט װעגן,</para>
  <para style="q" vid="ISA 43:25">און דײַנע חטאָים װעל איך נישט דערמאָנען.<verse eid="ISA 43:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 43:26" />דערמאָן מיר, לאָמיר זיך משפּטן מיט אַנאַנדער,</para>
  <para style="q" vid="ISA 43:26">דערצײל דו, כּדי זאָלסט גערעכט זײַן.<verse eid="ISA 43:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 43:27" />דײַן ערשטער פֿאָטער האָט געזינדיקט,</para>
  <para style="q" vid="ISA 43:27">און דײַנע פֿירשפּרעכער האָבן געבראָכן אָן מיר.<verse eid="ISA 43:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 43:28" />דערום האָב איך פֿאַרשװעכט די האַרן פֿון הײליקטום,</para>
  <para style="q" vid="ISA 43:28">און געגעבן צו פֿאַרװיסטונג יעקבֿ,</para>
  <para style="q" vid="ISA 43:28">און יִשׂרָאֵל צו לעסטערונג.<verse eid="ISA 43:28" /></para>
  <chapter eid="ISA 43" />
  <chapter number="44" style="c" pubnumber="מד" sid="ISA 44" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 44:1" />און אַצונד, הער, יעקבֿ מײַן קנעכט,</para>
  <para style="q" vid="ISA 44:1">און יִשׂרָאֵל, װעמען איך האָב אױסדערװײלט;<verse eid="ISA 44:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 44:2" />אַזױ האָט געזאָגט ה׳ דײַן באַשעפֿער,</para>
  <para style="q" vid="ISA 44:2">און דײַן פֿורעמער פֿון מוטערלײַב, װאָס העלפֿט דיך:</para>
  <para style="q" vid="ISA 44:2">זאָלסט נישט מורא האָבן, מײַן קנעכט יעקבֿ,</para>
  <para style="q" vid="ISA 44:2">און ישוּרוּן, װעמען איך האָב אױסדערװײלט.<verse eid="ISA 44:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 44:3" />װאָרעם איך װעל גיסן װאַסער אױף דאָרשטיק לאַנד,</para>
  <para style="q" vid="ISA 44:3">און פֿלוסן אױף טריקעניש;</para>
  <para style="q" vid="ISA 44:3">איך װעל אױסגיסן מײַן גײַסט אױף דײַן זאָמען,</para>
  <para style="q" vid="ISA 44:3">און מײַן ברכה אױף דײַנע שפּראָצן.<verse eid="ISA 44:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 44:4" />און זײ װעלן שפּראָצן װי צװישן גראָז,</para>
  <para style="q" vid="ISA 44:4">װי װערבעס בײַ בעכן װאַסער.<verse eid="ISA 44:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 44:5" />דער װעט זאָגן: איך געהער צו ה׳;</para>
  <para style="q" vid="ISA 44:5">און דער װעט זיך רופֿן מיטן נאָמען פֿון יעקבֿ,</para>
  <para style="q" vid="ISA 44:5">און דער װעט אױפֿשברײַבן אױף זײַן האַנט צו ה׳,</para>
  <para style="q" vid="ISA 44:5">און מיטן נאָמען יִשׂרָאֵל זיך טיטלען.<verse eid="ISA 44:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 44:6" />אַזױ האָט געזאָגט ה׳, דער קיניג פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="ISA 44:6">און זײַן אױסלײזער, ה׳ צבָֿאוֹת:</para>
  <para style="q" vid="ISA 44:6">איך בין דער ערשטער, און איך בין דער לעצטער,</para>
  <para style="q" vid="ISA 44:6">און חוץ מיר איז נישטאָ קײן אלֹקים.<verse eid="ISA 44:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 44:7" />און װער װי איך קען פֿאַרױסרופֿן –</para>
  <para style="q" vid="ISA 44:7">זאָל ער עס זאָגן און אױסלײגן פֿאַר מיר –</para>
  <para style="q" vid="ISA 44:7">פֿון זינט איך האָב באַשאַפֿן דאָס עלטסטע פֿאָלק?</para>
  <para style="q" vid="ISA 44:7">און דאָס קומעדיקע און װאָס װעט געשען</para>
  <para style="q" vid="ISA 44:7">זאָלן זײ דערצײלן.<verse eid="ISA 44:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 44:8" />איר זאָלט נישט אַנגסטן און נישט פֿאָרכטן;</para>
  <para style="q" vid="ISA 44:8">פֿאַר װאָר, פֿון לאַנג אָן</para>
  <para style="q" vid="ISA 44:8">האָב איך דיך געלאָזט הערן און דערצײלט,</para>
  <para style="q" vid="ISA 44:8">און איר זײַט מײַנע עדות.</para>
  <para style="q" vid="ISA 44:8">איז דען דאָ אַ ג-ט אַחוץ מיר,</para>
  <para style="q" vid="ISA 44:8">אַז נישטאָ אַ פֿעלדז איך זאָל נישט װיסן?<verse eid="ISA 44:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="ISA 44:9" />די פֿורעמער פֿון אַ געץ זײַנען נישטיק אַלע, און זײערע גלוסטיקע בילדער נוצן נישט; און זײ אַלײן זײַנען זײערע עדות, אַז זײ הערן נישט און װײסן נישט; דערום װעלן זײ פֿאַרשעמט װערן. <verse eid="ISA 44:9" /><verse number="10" style="v" sid="ISA 44:10" />װער פֿורעמט עס אַ ג-ט, און גיסט אױס אַ געץ װאָס נוצט נישט! <verse eid="ISA 44:10" /><verse number="11" style="v" sid="ISA 44:11" />זע, אַלע באַהעפֿטע אין אים װעלן זיך שעמען, און די מײַנסטערס – זײ מער פֿון אַלע מענטשן; זאָלן זײ אױפֿשטײן; אָבער זײ װעלן מורא האָבן, זאָלן זײ אַלע זיך אײַנזאַמלען, זיך שעמען, אין אײנעם.<verse eid="ISA 44:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 44:12" />דער אײַזנשמיד אַ האַק, און אַרבעט אױף קױלן, און מיט האַמערס טוט ער זי פֿורעמען, און אַרבעט זי אױס מיט זײַן שטאַרקן אָרעם; אױך װערט ער הונגעריק, און איז אָן כּוֹח, ער טרינקט נישט קײן װאַסער, און װערט פֿאַרשמאַכט. <verse eid="ISA 44:12" /><verse number="13" style="v" sid="ISA 44:13" />דער האָלצמײנסטער ציט אױס אַ שנור; ער צײכנט עס מיט אַ שטיפֿט, ער מאַכט עס מיט הובלען צורעכט, און מיט אַ צירקל צײכנט ער עס אַרום, און ער מאַכט עס לױט דער געשטאַלט פֿון אַ מאַן, לױט דער שײנקײט פֿון אַ מענטשן, אױף צו װױנען אין אַ הױז. <verse eid="ISA 44:13" /><verse number="14" style="v" sid="ISA 44:14" />ער האַקט זיך אױס צעדערן, און נעמט אַ האַרטדעמב אָדער אַן אײכנבױם, און װײלט זיך אױס צװישן די בײמער פֿון װאַלד; ער פֿלאַנצט אַ פֿיכטבױם, און דער רעגן מאַכט װאַקסן. <verse eid="ISA 44:14" /><verse number="15" style="v" sid="ISA 44:15" />און עס איז פֿאַר דעם מענטשן אױף צו ברענען; און ער נעמט דערפֿון, און װאַרעמט זיך, אױך הײצט ער, און באַקט ברױט; דערצו מאַכט ער אַ ג-ט און בוקט זיך; מאַכט עס צום געץ, און קניט דערצו. <verse eid="ISA 44:15" /><verse number="16" style="v" sid="ISA 44:16" />טײל דערפֿון האָט ער פֿאַרברענט אין פֿײַער, אױף טײל דערפֿון עסט ער פֿלײש – בראָט בראָטן און זעטיקט זיך, אױך װאַרעמט ער זיך, און זאָגט: אַה! מיר איז װאַרעם, איך שפּיר דאָס פֿײַער; <verse eid="ISA 44:16" /><verse number="17" style="v" sid="ISA 44:17" />און דעם איבערבלײַב דערפֿון מאַכט ער פֿאַר אַ ג-ט – פֿאַר זײַן געץ; קניט צו אים און בוקט זיך און טוט תּפֿילה צו אים, און זאָגט: ראַטעװע מיך, װאָרעם מײַן ג-ט ביסטו.<verse eid="ISA 44:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 44:18" />זײ װײסן נישט, און זײ פֿאַרשטײען נישט, װאָרעם פֿאַרקלעפּט פֿון צו זען זײַנען זײערע אױגן, פֿון צו פֿאַרשטײן – זײערע הערצער. <verse eid="ISA 44:18" /><verse number="19" style="v" sid="ISA 44:19" />און קײנער איבערלײגט נישט אין זײַן האַרצן, און נישטאָ קײן דערקענונג און קײן שׂכל צו זאָגן: טײל דערפֿון האָב איך פֿאַרברענט אין פֿײַער, און אױך געבאַקט אױף זײַנע קױלן ברױט, געבראָטן פֿלײש און געגעסן; און דעם רעשט דערפֿון זאָל איך פֿאַר אַן אומװערדיקײט מאַכן? צו אַ שײַט האָלץ זאָל איך קניִען? <verse eid="ISA 44:19" /><verse number="20" style="v" sid="ISA 44:20" />ער יאָגט זיך נאָך אַש, אַ פֿאַרנאַרט האַרץ האָט אים אַראָפּגעפֿירט, און ער איז נישט מציל זײַן נפֿש, און זאָגט נישט: פֿאַר װאָר, ליגן איז אין מײַן רעכטער האַנט.<verse eid="ISA 44:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 44:21" />געדענק דאָס דאָזיקע, יעקבֿ, און יִשׂרָאֵל,</para>
  <para style="q" vid="ISA 44:21">אַז מײַן קנעכט ביסטו;</para>
  <para style="q" vid="ISA 44:21">איך האָבן דיך געפֿורעמט, אַ קנעכט ביסטו מיר;</para>
  <para style="q" vid="ISA 44:21">יִשׂרָאֵל, זאָלסט מיך נישט פֿאַרגעסן.<verse eid="ISA 44:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 44:22" />איך האָב אָפּגעמעקט װי אַ כמאַרע דײַנע פֿאַרברעכן,</para>
  <para style="q" vid="ISA 44:22">און װי אַ װאָלקן דײַנע זינד;</para>
  <para style="q" vid="ISA 44:22">קער זיך אום צו מיר, װאָרעם איך האָב דיך אױסגעלײזט.<verse eid="ISA 44:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="ISA 44:23" />זינגט איר הימלען, װאָרעם ה׳ האָט אױפֿגעטאָן;</para>
  <para style="q" vid="ISA 44:23">שאַלט, איר טיפֿענישן פֿון דער ערד,</para>
  <para style="q" vid="ISA 44:23">ברעכט אױס, איר בערג, אין געזאַנג,</para>
  <para style="q" vid="ISA 44:23">דער װאַלד און יעטװעדער בױם אין אים;</para>
  <para style="q" vid="ISA 44:23">װאָרעם ה׳ האָט אױסגעלײזט יעקבֿ,</para>
  <para style="q" vid="ISA 44:23">און מיט יִשׂרָאֵל טוט ער זיך רימען.<verse eid="ISA 44:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 44:24" />אַזױ האָט געזאָגט ה׳ דײַן אױסלײזער,</para>
  <para style="q" vid="ISA 44:24">און דײַן פֿורעמער פֿון מוטערלײַב:</para>
  <para style="q" vid="ISA 44:24">איך בין ה׳ װאָס האָב אַלץ דינג געמאַכט,</para>
  <para style="q" vid="ISA 44:24">װאָס האָב אױסגעצױגן די הימלען אַלײן,</para>
  <para style="q" vid="ISA 44:24">װאָס האָב אױסגעשפּרײט די ערד פֿון מיר זעלבערט;<verse eid="ISA 44:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 44:25" />װאָס פֿאַרשטערט די צײכנס פֿון די ליגנערס,</para>
  <para style="q" vid="ISA 44:25">און די װאָרזאָגער מאַכט ער צעדולט;</para>
  <para style="q" vid="ISA 44:25">װאָס קערט די חכמים אַהינטער,</para>
  <para style="q" vid="ISA 44:25">און זײער שׂכל באַנאַרישט ער;<verse eid="ISA 44:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 44:26" />װאָס איז מקײם דאָס װאָרט פֿון זײַן קנעכט,</para>
  <para style="q" vid="ISA 44:26">און דעם באַראָט פֿון זײַנע שלוחים פֿירט ער אױס;</para>
  <para style="q" vid="ISA 44:26">װאָס זאָגט אױף ירושָלַיִם: זײ זאָל באַזעצט װערן;</para>
  <para style="q" vid="ISA 44:26">און אױף די שטעט פֿון יהוּדה: זײ זאָלן אָפּגעבױט װערן,</para>
  <para style="q" vid="ISA 44:26">און אירע חורבֿות װעל איך אױפֿריכטן;<verse eid="ISA 44:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 44:27" />װאָס זאָגט צו דער טיפֿעניש: װער טרוקן,</para>
  <para style="q" vid="ISA 44:27">און דײַנע טײַכן װעל איך אױסטריקענען;<verse eid="ISA 44:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 44:28" />װאָס זאָגט אױף כּוֹרֶשן: ער איז מײַן פּאַסטוך,</para>
  <para style="q" vid="ISA 44:28">און אַל מײַן באַגער װעט ער אױספֿירן,</para>
  <para style="q" vid="ISA 44:28">צו זאָגן אױף ירושָלַיִם: זי זאָל געבױט װערן,</para>
  <para style="q" vid="ISA 44:28">און צום הֵיכל: זאָלסט געגרונטפֿעסט װערן.<verse eid="ISA 44:28" /></para>
  <chapter eid="ISA 44" />
  <chapter number="45" style="c" pubnumber="מה" sid="ISA 45" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 45:1" />אַזױ האָט געזאָגט ה׳ צו זײַן געזאַלבטן,</para>
  <para style="q" vid="ISA 45:1">צו כּוֹרֶשן װאָס איך האַלט זײַן רעכטע האַנט,</para>
  <para style="q" vid="ISA 45:1">צו מאַכן אונטערטעניק פֿאַר אים פֿעלקער,</para>
  <para style="q" vid="ISA 45:1">און איך זאָל לױז מאַכן די לענדן פֿון מלכים;</para>
  <para style="q" vid="ISA 45:1">צו עפֿענען פֿאַר אים טירן,</para>
  <para style="q" vid="ISA 45:1">און טױערן זאָלן נישט פֿאַרשלאָסן זײַן:<verse eid="ISA 45:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 45:2" />איך װעל גײן דיר פֿאַרױס,</para>
  <para style="q" vid="ISA 45:2">און קרומע ערטער װעל איך אױסגלײַכן;</para>
  <para style="q" vid="ISA 45:2">קופּערנע טירן װעל איך צעברעכן,</para>
  <para style="q" vid="ISA 45:2">און אײַזערנע ריגלען װעל איך צעהאַקן.<verse eid="ISA 45:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 45:3" />און איך װעל דיר געבן די אוֹצרות פֿון דער פֿינצטערניש,</para>
  <para style="q" vid="ISA 45:3">און די שאַצן פֿון פֿאַרבאָרגענישן,</para>
  <para style="q" vid="ISA 45:3">כּדי זאָלסט װיסן אַז איך בין ה׳,</para>
  <para style="q" vid="ISA 45:3">װאָס רופֿט דיך בײַם נאָמען, אלוקי יִשׂרָאֵל.<verse eid="ISA 45:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 45:4" />פֿון װעגן דעם קנעכט מײַנעם יעקבֿ,</para>
  <para style="q" vid="ISA 45:4">און יִשׂרָאֵל מײַן אױסדערװײלטן,</para>
  <para style="q" vid="ISA 45:4">האָב איך דיך גערופֿן בײַ דײַן נאָמען,</para>
  <para style="q" vid="ISA 45:4">דיך באַטיטלט, הגם דו האָסט מיך נישט געקענט.<verse eid="ISA 45:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 45:5" />איך בין ה׳, און מער איז נישטאָ,</para>
  <para style="q" vid="ISA 45:5">חוץ מיר איז קײן אלֹקים נישט פֿאַראַן;</para>
  <para style="q" vid="ISA 45:5">איך האָב דיך באַגורט, הגם דו האָסט מיך נישט געקענט;<verse eid="ISA 45:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 45:6" />כּדי מע זאָל װיסן פֿון אױפֿגאַנג פֿון זון</para>
  <para style="q" vid="ISA 45:6">און פֿון איר אונטערגאַנג,</para>
  <para style="q" vid="ISA 45:6">אַז נישטאָ אױסער מיר;</para>
  <para style="q" vid="ISA 45:6">איך בין ה׳, און מער איז נישטאָ;<verse eid="ISA 45:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 45:7" />דער װאָס פֿורעמט ליכט, און באַשאַפֿט פֿינצטערניש,</para>
  <para style="q" vid="ISA 45:7">מאַכט פֿריד, און באַשאַפֿט בײז;</para>
  <para style="q" vid="ISA 45:7">איך ה׳ מאַך אַל די דאָזיקע.<verse eid="ISA 45:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 45:8" />טריפֿט, איר הימלען, פֿון אױבן,</para>
  <para style="q" vid="ISA 45:8">און די װאָלקנס זאָלן רינען גערעכטיקײט;</para>
  <para style="q" vid="ISA 45:8">זאָל די ערד זיך עפֿענען,</para>
  <para style="q" vid="ISA 45:8">און ישועות זאָלן זיך פֿרוכפּערן.</para>
  <para style="q" vid="ISA 45:8">און רעכטפֿאַרטיקײט זאָל זײ מאַכן שפּראָצן באַגלײַך;</para>
  <para style="q" vid="ISA 45:8">איך ה׳ האָב דאָס באַשאַפֿן.<verse eid="ISA 45:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 45:9" />װײ, דער װאָס קריגט זיך מיט זײַן באַשעפֿער –</para>
  <para style="q" vid="ISA 45:9">אַ שערבל צװישן שערבלעך פֿון דער ערד!</para>
  <para style="q" vid="ISA 45:9">װעט דען זאָגן דער לײם צו זײַן פֿורעמער: װאָס טוסטו?</para>
  <para style="q" vid="ISA 45:9">אָדער: דײַן אַרבעט איז אָן הענט?<verse eid="ISA 45:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 45:10" />װײ, דער װאָס זאָגט צו דעם פֿאָטער:</para>
  <para style="q" vid="ISA 45:10">נאָך װאָס מאַכסטו געבערן?</para>
  <para style="q" vid="ISA 45:10">און צו דער פֿרױ:</para>
  <para style="q" vid="ISA 45:10">נאָך װאָס האָסטו װײען?<verse eid="ISA 45:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 45:11" />אַזױ האָט ה׳ געזאָגט,</para>
  <para style="q" vid="ISA 45:11">דער הײליקער פֿון יִשׂרָאֵל און זײַן פֿורעמער:</para>
  <para style="q" vid="ISA 45:11">פֿרעגט מיך דאָס קומעדיקע,</para>
  <para style="q" vid="ISA 45:11">באַפֿעלט מיר װעגן מײַנע קינדער</para>
  <para style="q" vid="ISA 45:11">און װעגן דעם װערק פֿון מײַנע הענט?<verse eid="ISA 45:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 45:12" />איך האָב געמאַכט די ערד,</para>
  <para style="q" vid="ISA 45:12">און דעם מענטשן אױף איר באַשאַפֿן;</para>
  <para style="q" vid="ISA 45:12">איך – מײַנע הענט האָבן אױסגעצױגן די הימלען,</para>
  <para style="q" vid="ISA 45:12">און זײער גאַנצן חיל האָב איך באַפֿױלן.<verse eid="ISA 45:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 45:13" />איך האָב אים דערװעקט מיט גערעכטיקײט,</para>
  <para style="q" vid="ISA 45:13">און אַלע זײַנע װעגן װעל איך אױסגלײַכן;</para>
  <para style="q" vid="ISA 45:13">ער װעט בױען מײַן שטאָט,</para>
  <para style="q" vid="ISA 45:13">און מײַנע פֿאַרטריבענע װעט ער אַרױסלאָזן,</para>
  <para style="q" vid="ISA 45:13">נישט אום געצאָלט, און נישט אום שוחד,</para>
  <para style="q" vid="ISA 45:13">זאָגט ה׳ צבָֿאוֹת.<verse eid="ISA 45:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 45:14" />אַזױ האָט ה׳ געזאָגט:</para>
  <para style="q" vid="ISA 45:14">די מי פֿון מִצרַיִם, און דער מסחר פֿון כּוּש,</para>
  <para style="q" vid="ISA 45:14">און די סבֿאים, די װוּקסיקע לײַט,</para>
  <para style="q" vid="ISA 45:14">װעלן איבערגײן צו דיר, און דײַנע װעלן זײ װערן;</para>
  <para style="q" vid="ISA 45:14">הינטער דיר װעלן זײ גײן,</para>
  <para style="q" vid="ISA 45:14">אין קײטן װעלן זײ אַריבערקומען,</para>
  <para style="q" vid="ISA 45:14">און בוקן װעלן זײ זיך צו דיר;</para>
  <para style="q" vid="ISA 45:14">בעטן װעלן זײ זיך בײַ דיר:</para>
  <para style="q" vid="ISA 45:14">נאָר בײַ דיר איז אֵל,</para>
  <para style="q" vid="ISA 45:14">און אַחוּץ דיר איז נישט דאָ קײן אלֹקים.<verse eid="ISA 45:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 45:15" />פֿאַר װאָר, ביסט אַן אֵל װאָס פֿאַרבאָרגט זיך,</para>
  <para style="q" vid="ISA 45:15">אלוקי יִשׂרָאֵל, דו העלפֿער.<verse eid="ISA 45:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 45:16" />פֿאַרשעמט און אױך צו שאַנד װערן זײ אַלע,</para>
  <para style="q" vid="ISA 45:16">מיט שאַנד גײען אַװעק אין אײנעם</para>
  <para style="q" vid="ISA 45:16">אַלע מײַנסטערס פֿון געצנבילדער.<verse eid="ISA 45:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 45:17" />יִשׂרָאֵל װערט געהאָלפֿן פֿון ה׳</para>
  <para style="q" vid="ISA 45:17">אַן אײביקע הילף;</para>
  <para style="q" vid="ISA 45:17">איר װעט נישט פֿאַרשעמט</para>
  <para style="q" vid="ISA 45:17">און נישט האָבן מיט װאָס זיך צו שעמען ביז אײביקאײביקײטן.<verse eid="ISA 45:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 45:18" />װאָרעם אַזױ האָט געזאָגט ה׳ דער באַשעפֿער פֿון די הימלען,</para>
  <para style="q" vid="ISA 45:18">– ער, האלֹקים, װאָס האָט געפֿורעמט די ערד און זי געמאַכט;</para>
  <para style="q" vid="ISA 45:18">ער װאָס האָט זי אױפֿגעשטעלט,</para>
  <para style="q" vid="ISA 45:18">נישט פֿאַר אַ װיסטעניש זי באַשאַפֿן,</para>
  <para style="q" vid="ISA 45:18">נאָר צום װױנען זי געפֿורעמט:</para>
  <para style="q" vid="ISA 45:18">איך בין ה׳, און אַחוּץ איז נישט דאָ קײן אלֹקים.<verse eid="ISA 45:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 45:19" />נישט אין פֿאַרבאָרגעניש האָב איך גערעדט,</para>
  <para style="q" vid="ISA 45:19">אין אַן אָרט פֿון פֿינצטערלאַנד;</para>
  <para style="q" vid="ISA 45:19">איך האָב נישט געזאָגט צו דעם זאָמען פֿון יעקבֿ:</para>
  <para style="q" vid="ISA 45:19">אין װיסטעניש זוכט מיך;</para>
  <para style="q" vid="ISA 45:19">איך ה׳ רעד גערעכטיקײט,</para>
  <para style="q" vid="ISA 45:19">זאָג אָן די ריכטיקײט.<verse eid="ISA 45:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 45:20" />זאַמלט אײַך אײַן און קומט גענענט אין אײנעם,</para>
  <para style="q" vid="ISA 45:20">איר אַנטרונענע פֿון די פֿעלקער;</para>
  <para style="q" vid="ISA 45:20">אָן פֿאַרשטאַנד זײַנען די װאָס טראָגן זײער האָלצגעשניץ,</para>
  <para style="q" vid="ISA 45:20">און טוען תּפֿילה צו אַן אֵל װאָס העלפֿט נישט.<verse eid="ISA 45:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 45:21" />זאָגט אָן, און מאַכט זײ גענענען,</para>
  <para style="q" vid="ISA 45:21">און לאָמען האַלטן אַן עצה אין אײנעם:</para>
  <para style="q" vid="ISA 45:21">װער האָט דאָס געלאָזט הערן פֿון פֿאַרצײַטן,</para>
  <para style="q" vid="ISA 45:21">פֿון לאַנג אָן דאָס אָנגעזאָגט?</para>
  <para style="q" vid="ISA 45:21">פֿאַר װאָר, איך ה׳,</para>
  <para style="q" vid="ISA 45:21">און נישטאָ מער קײן אלֹקים אַחוץ מיר,</para>
  <para style="q" vid="ISA 45:21">אַן אֵל אַ גערעכטער און אַ העלפֿער;</para>
  <para style="q" vid="ISA 45:21">און אַחוּץ איז נישט דאָ קײן אלֹקים.<verse eid="ISA 45:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 45:22" />קערט אײַך צו מיר, און װערט געהאָלפֿן,</para>
  <para style="q" vid="ISA 45:22">אַלע עקן פֿון דער ערד;</para>
  <para style="q" vid="ISA 45:22">װאָרעם איך בין אֵל,</para>
  <para style="q" vid="ISA 45:22">און אַחוּץ איז נישט דאָ קײן אלֹקים.<verse eid="ISA 45:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 45:23" />איך האָב געשװאָרן בײַ מיר:</para>
  <para style="q" vid="ISA 45:23">אַ װאָרט איז אַרױס פֿון מײַן מױל אין גערעכטיקײט,</para>
  <para style="q" vid="ISA 45:23">און װעט זיך נישט אומקערן,</para>
  <para style="q" vid="ISA 45:23">אַז צו מיר זאָל זיך בײגן יעטװעדער קני,</para>
  <para style="q" vid="ISA 45:23">זאָל שװערן יעטװעדער צונג.<verse eid="ISA 45:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 45:24" />נאָר אין ה׳ – װעט מען זאָגן פֿון מיר –</para>
  <para style="q" vid="ISA 45:24">גערעכטיקײט און שטאַרקײט;</para>
  <para style="q" vid="ISA 45:24">צו אים װעלן קומען און זיך שעמען</para>
  <para style="q" vid="ISA 45:24">אַלע װאָס זײַנען אָנגעצונדן אױף אים.<verse eid="ISA 45:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 45:25" />דורך ה׳ װעט דער גאַנצער זאָמען</para>
  <para style="q" vid="ISA 45:25">פֿון יִשׂרָאֵל גערעכט װערן</para>
  <para style="q" vid="ISA 45:25">און זיך רימען אין אים.<verse eid="ISA 45:25" /></para>
  <chapter eid="ISA 45" />
  <chapter number="46" style="c" pubnumber="מו" sid="ISA 46" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 46:1" />געקניט איז בֵל, געבױגן איז נבֿוֹ;</para>
  <para style="q" vid="ISA 46:1">זײערע געצן זײַנען אױף בהמות און אױף לאַסטפֿי;</para>
  <para style="q" vid="ISA 46:1">די װאָס איר פֿלעגט זיך אומטראָגן מיט זײ,</para>
  <para style="q" vid="ISA 46:1">זײַנען אױפֿגעלאָדן, אַ משׂא אױף מידע בהמות.<verse eid="ISA 46:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 46:2" />זײ זײַנען געבױגן, געקניט אין אײנעם;</para>
  <para style="q" vid="ISA 46:2">זײ האָבן נישט געקענט ראַטעװען די משׂא,</para>
  <para style="q" vid="ISA 46:2">און זײ אַלײן זײַנען אין געפֿאַנגענשאַפֿט אַװעק.<verse eid="ISA 46:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 46:3" />הערט מיר צו, איר הױז פֿון יעקבֿ,</para>
  <para style="q" vid="ISA 46:3">און דער גאַנצער איבערבלײַב פֿון הױז יִשׂרָאֵל,</para>
  <para style="q" vid="ISA 46:3">איר געפּעסטעטע פֿון מוטערלײַב,</para>
  <para style="q" vid="ISA 46:3">איר געטראָגענע פֿון געבערמוטער:<verse eid="ISA 46:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 46:4" />אַפֿילו ביז עלטער בין איך דער אײגענער,</para>
  <para style="q" vid="ISA 46:4">און ביז גראָע האָר װעל איך טראָגן;</para>
  <para style="q" vid="ISA 46:4">איך האָב געמאַכט, און איך װעל טראָגן,</para>
  <para style="q" vid="ISA 46:4">און איך װעל אױף זיך נעמען און װעל ראַטעװען.<verse eid="ISA 46:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 46:5" />צו װעמען װילט איר מיך צוגלײַכן און גלײַכשטעלן,</para>
  <para style="q" vid="ISA 46:5">און מיך פֿאַרגלײַכן, אַז מיר זאָלן גלײַך זײַן?<verse eid="ISA 46:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 46:6" />איר װאָס שיט גאָלד פֿון בײַטל,</para>
  <para style="q" vid="ISA 46:6">און װעגט זילבער אױפֿן װאָגשטאַנג;</para>
  <para style="q" vid="ISA 46:6">װאָס דינגט אַ שמעלצער ער זאָל דערפֿון מאַכן אַ ג-ט,</para>
  <para style="q" vid="ISA 46:6">מע זאָל זיך קניִען און בוקן.<verse eid="ISA 46:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 46:7" />מע נעמט אים אױפֿן אַקסל, מע טראָגט אים,</para>
  <para style="q" vid="ISA 46:7">און מע שטעלט אים אַװעק אױף זײַן פּלאַץ,</para>
  <para style="q" vid="ISA 46:7">און ער שטײט, ער רירט זיך נישט פֿון זײַן אָרט;</para>
  <para style="q" vid="ISA 46:7">אַפֿילו עמעצער שרײַט צו אים, ענטפֿערט ער נישט,</para>
  <para style="q" vid="ISA 46:7">פֿון זײַן נױט טוט ער נישט העלפֿן.<verse eid="ISA 46:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 46:8" />געדענקט דאָס, און מינטערט אײַך אױף,</para>
  <para style="q" vid="ISA 46:8">נעמט, איר פֿאַרברעכער, צום האַרצן.<verse eid="ISA 46:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 46:9" />געדענקט דאָס פֿריִערדיקע פֿון אײביק אָן:</para>
  <para style="q" vid="ISA 46:9">אַז איך בין אֵל, און מער איז נישטאָ,</para>
  <para style="q" vid="ISA 46:9">אלֹקים, און נישטאָ מײַן גלײַכן.<verse eid="ISA 46:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 46:10" />איך זאָג אָן פֿון אָנהײב דעם סוף,</para>
  <para style="q" vid="ISA 46:10">און פֿון פֿאַרצײַטן, װאָס איז נאָך נישט געשען;</para>
  <para style="q" vid="ISA 46:10">איך זאָג: מײַן באַראָט זאָל באַשטײן,</para>
  <para style="q" vid="ISA 46:10">און אַל מײַן באַגער װעל איך טאָן.<verse eid="ISA 46:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 46:11" />איך רוף פֿון מזרח דעם רױבפֿױגל,</para>
  <para style="q" vid="ISA 46:11">פֿון אַ װײַטן לאַנד דעם מאַן פֿון מײַן באַראָט;</para>
  <para style="q" vid="ISA 46:11">יאָ, איך האָב גערעדט, און איך װעל עס ברענגען,</para>
  <para style="q" vid="ISA 46:11">איך האָב באַשערט, און איך װעל עס טאָן.<verse eid="ISA 46:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 46:12" />הערט מיר צו, איר שטאַרקהאַרציקע,</para>
  <para style="q" vid="ISA 46:12">װאָס שפּירט זיך װײַט פֿון גערעכטיקײט:<verse eid="ISA 46:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 46:13" />איז דערנענטערן מײַן גערעכטיקײט,</para>
  <para style="q" vid="ISA 46:13">זי איז נישט װײַט,</para>
  <para style="q" vid="ISA 46:13">און מײַן ישועה װעט נישט זאַמען;</para>
  <para style="q" vid="ISA 46:13">און איך װעל געבן אין צִיוֹן אַ ישועה</para>
  <para style="q" vid="ISA 46:13">פֿאַר יִשׂרָאֵל מײַן צירונג.<verse eid="ISA 46:13" /></para>
  <chapter eid="ISA 46" />
  <chapter number="47" style="c" pubnumber="מז" sid="ISA 47" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 47:1" />נידער אַראָפּ און זיץ אין שטױב</para>
  <para style="q" vid="ISA 47:1">יונגפֿרױ טאָכטער בָבֿל;</para>
  <para style="q" vid="ISA 47:1">זיץ אױף דער ערד אָן אַ טראָן,</para>
  <para style="q" vid="ISA 47:1">טאָכטער פֿון כַּשׂדים;</para>
  <para style="q" vid="ISA 47:1">װאָרעם מער װעט מען דיך נישט רופֿן</para>
  <para style="q" vid="ISA 47:1">אײדעלע און פֿאַרצערטלטע.<verse eid="ISA 47:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 47:2" />נעם אַ זשאָרנע, און מאָל מעל;</para>
  <para style="q" vid="ISA 47:2">דעק אָפּ דײַן שלײער, הײב אױף די שלעפּ,</para>
  <para style="q" vid="ISA 47:2">אַנטפּלעק די היפֿט, גײ טײַכן אַריבער.<verse eid="ISA 47:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 47:3" />אָפּגעדעקט װעט װערן דײַן נאַקעטקײט,</para>
  <para style="q" vid="ISA 47:3">אױך געזען װערן װעט דײַן שאַנד;</para>
  <para style="q" vid="ISA 47:3">נקמה װעל איך נעמען,</para>
  <para style="q" vid="ISA 47:3">און נישט לאָזן אַ מענטשן זיך אָפּבעטן.<verse eid="ISA 47:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 47:4" />אונדזער אױסלײזער – ה׳ צבָֿאוֹת איז זײַן נאָמען,</para>
  <para style="q" vid="ISA 47:4">דער הײליקער פֿון יִשׂרָאֵל.<verse eid="ISA 47:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 47:5" />זיץ שטיל, און גײ אַרײַן אין פֿינצטערניש,</para>
  <para style="q" vid="ISA 47:5">טאָכטער פֿון כַּשׂדים,</para>
  <para style="q" vid="ISA 47:5">װאָרעם מער װעט מען דיך נישט רופֿן</para>
  <para style="q" vid="ISA 47:5">האַרינטע פֿון קיניגרײַכן.<verse eid="ISA 47:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 47:6" />איך האָב געצערנט אױף מײַן פֿאָלק,</para>
  <para style="q" vid="ISA 47:6">איך האָב פֿאַרשװעכט מײַן אַרב,</para>
  <para style="q" vid="ISA 47:6">און זײ געגעבן אין דײַן האַנט;</para>
  <para style="q" vid="ISA 47:6">האָסטו זײ קײן רַחמָנות נישט געשענקט,</para>
  <para style="q" vid="ISA 47:6">אױף אַ זקן האָסטו באַשװערט דײַן יאָך ביז גאָר.<verse eid="ISA 47:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 47:7" />און האָסט געזאָגט:</para>
  <para style="q" vid="ISA 47:7">אױף אײביק װעל איך אַ האַרינטע זײַן;</para>
  <para style="q" vid="ISA 47:7">אַזױ אַז דו האָסט דאָס נישט גענומען צום האַרצן,</para>
  <para style="q" vid="ISA 47:7">נישט געדאַכט אָן דעם סוף דערפֿון.<verse eid="ISA 47:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 47:8" />און אַצונד הער דאָס צו, דו װױלטאָגערין,</para>
  <para style="q" vid="ISA 47:8">– װאָס זיצט אין זיכערקײט,</para>
  <para style="q" vid="ISA 47:8">װאָס זאָגט אין איר האַרצן:</para>
  <para style="q" vid="ISA 47:8">איך, און חוץ מיר איז נישטאָ מער.</para>
  <para style="q" vid="ISA 47:8">איך װעל נישט זיצן אַן אַלמנה,</para>
  <para style="q" vid="ISA 47:8">און נישט װיסן פֿון בלײַבן אָן קינדער:<verse eid="ISA 47:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 47:9" />אָבער די דאָזיקע בײדע װעלן קומען אױף דיר</para>
  <para style="q" vid="ISA 47:9">אין אַ רגע אין אײן טאָג:</para>
  <para style="q" vid="ISA 47:9">בלײַבן אָן קינדער און אַלמנהשאַפֿט;</para>
  <para style="q" vid="ISA 47:9">אין זײער פֿולער מאָס קומען זײ אױף דיר,</para>
  <para style="q" vid="ISA 47:9">בײַ אַל דײַנע פֿיל כּישופֿן,</para>
  <para style="q" vid="ISA 47:9">בײַ אַל דער גרױס שטאַרקײט פֿון דײַנע שפּרוכן.<verse eid="ISA 47:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 47:10" />און ביסט געװען זיכער אין דײַן שלעכטיקײט,</para>
  <para style="q" vid="ISA 47:10">האָסט געזאָגט: קײנער זעט מיך נישט;</para>
  <para style="q" vid="ISA 47:10">דײַן חכמה און דײַן קענשאַפֿט,</para>
  <para style="q" vid="ISA 47:10">זי האָט דיך פֿאַרפֿירט;</para>
  <para style="q" vid="ISA 47:10">און האָסט געזאָגט אין דײַן האַרצן:</para>
  <para style="q" vid="ISA 47:10">איך, און חוץ מיר איז נישטאָ מער.<verse eid="ISA 47:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 47:11" />אָבער קומען װעט אױף דיר אַ בײז</para>
  <para style="q" vid="ISA 47:11">װאָס דו װעסט נישט װיסן װי עס אָפּצושפּרעכן,</para>
  <para style="q" vid="ISA 47:11">און אָנפֿאַלן װעט אױף דיר אַ בראָך</para>
  <para style="q" vid="ISA 47:11">װאָס דו װעסט אים נישט קענען אָפּטאָן,</para>
  <para style="q" vid="ISA 47:11">און קומען װעט אױף דיר פּלוצלינג אַ פֿאַרװיסטונג,</para>
  <para style="q" vid="ISA 47:11">אַז דו װעסט גאָרנישט מערקן.<verse eid="ISA 47:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 47:12" />שטײ אַקאָרשט אױף מיט דײַנע שפּרוכן,</para>
  <para style="q" vid="ISA 47:12">און מיט דײַנע פֿיל כּישופֿן,</para>
  <para style="q" vid="ISA 47:12">אױף װאָס דו האָסט זיך געמיט פֿון דײַן יוגנט אָן;</para>
  <para style="q" vid="ISA 47:12">אפֿשר װעסטו קענען נוצן,</para>
  <para style="q" vid="ISA 47:12">אפֿשר װעסטו אָנשרעקן.<verse eid="ISA 47:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 47:13" />ביסט מיד פֿון דײַנע פֿיל עצות;</para>
  <para style="q" vid="ISA 47:13">זאָלן די הימלקוקער,</para>
  <para style="q" vid="ISA 47:13">די שטערנזעער,</para>
  <para style="q" vid="ISA 47:13">די פֿאַרױסזאָגער פֿון די חדשים,</para>
  <para style="q" vid="ISA 47:13">אַקאָרשט אױפֿשטײן און דיך העלפֿן</para>
  <para style="q" vid="ISA 47:13">פֿון די װאָס װעלן קומען אױף דיר.<verse eid="ISA 47:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 47:14" />זע, זײ װערן אַזױ װי שטרױ,</para>
  <para style="q" vid="ISA 47:14">אַ פֿײַער טוט זײ פֿאַרברענען,</para>
  <para style="q" vid="ISA 47:14">זײ װעלן זיך אַלײן נישט מציל זײַן</para>
  <para style="q" vid="ISA 47:14">פֿון דער מאַכט פֿון דער פֿלאַם;</para>
  <para style="q" vid="ISA 47:14">נישט אַ קױל זיך צו װאַרעמען װעט עס זײַן –</para>
  <para style="q" vid="ISA 47:14">אַ פֿײַער צו זיצן פֿאַר אים.<verse eid="ISA 47:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 47:15" />אַזױ װערן צו דיר די װאָס דו האָסט זיך געמיט אום זײ;</para>
  <para style="q" vid="ISA 47:15">די װאָס האָבן געהאַנדלט מיט דיר פֿון דײַן יוגנט אָן,</para>
  <para style="q" vid="ISA 47:15">װאַנדערן איטלעכער אין זײַן זײַט,</para>
  <para style="q" vid="ISA 47:15">קײנער העלפֿט דיך נישט.<verse eid="ISA 47:15" /></para>
  <chapter eid="ISA 47" />
  <chapter number="48" style="c" pubnumber="מח" sid="ISA 48" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 48:1" />הערט דאָס צו, איר הױז פֿון יעקבֿ,</para>
  <para style="q" vid="ISA 48:1">די װאָס װערן גערופֿן מיטן נאָמען יִשׂרָאֵל,</para>
  <para style="q" vid="ISA 48:1">און פֿון קװאַל פֿון יהוּדה זײַנען זײ אַרױס;</para>
  <para style="q" vid="ISA 48:1">װאָס שװערן בײַם נאָמען ה׳,</para>
  <para style="q" vid="ISA 48:1">און אלוקי יִשׂרָאֵל דערמאָנען זײ –</para>
  <para style="q" vid="ISA 48:1">נישט מיט אמת, און נישט מיט גערעכטיקײט.<verse eid="ISA 48:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 48:2" />װאָרעם אױף דער הײליקער שטאָט רופֿן זײ זיך,</para>
  <para style="q" vid="ISA 48:2">און אױף אלוקי יִשׂרָאֵל לענען זײ זיך,</para>
  <para style="q" vid="ISA 48:2">װאָס ה׳ צבָֿאוֹת איז זײַן נאָמען.<verse eid="ISA 48:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 48:3" />דאָס פֿריִערדיקע האָב איך פֿון אַ מאָל אָנגעזאָגט,</para>
  <para style="q" vid="ISA 48:3">און פֿון מױל איז עס אַרױס,</para>
  <para style="q" vid="ISA 48:3">און איך האָב עס געלאָזט הערן;</para>
  <para style="q" vid="ISA 48:3">פּלוצעם האָב איך געטאָן, און עס איז געשען.<verse eid="ISA 48:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 48:4" />װײַל איך האָב געװוּסט אַז האַרט ביסטו,</para>
  <para style="q" vid="ISA 48:4">און אַן אײַזערנער אָדער איז דײַן נאַקן,</para>
  <para style="q" vid="ISA 48:4">און דײַן שטערן איז קופּער;<verse eid="ISA 48:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 48:5" />דערום האָב איך דיר אָנגעזאָגט פֿון אַ מאָל,</para>
  <para style="q" vid="ISA 48:5">אײדער עס איז געקומען, האָב איך דיך געלאָזט הערן;</para>
  <para style="q" vid="ISA 48:5">כּדי זאָלסט נישט זאָגן: מײַן געץ האָט עס געטאָן,</para>
  <para style="q" vid="ISA 48:5">און מײַן געשניצט און מײַן געגאָסן בילד האָט עס באַפֿױלן.<verse eid="ISA 48:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 48:6" />האָסט געהערט, זע, אַל דאָס דאָזיקע,</para>
  <para style="q" vid="ISA 48:6">און איר װעט עס דאָך צוגעבן;</para>
  <para style="q" vid="ISA 48:6">איך האָב דיך געלאָזט הערן נײַסן אַצונד,</para>
  <para style="q" vid="ISA 48:6">און פֿאַרבאָרגנס װאָס דו האָסט נישט געװוּסט.<verse eid="ISA 48:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 48:7" />אַצונד איז עס באַשאַפֿן געװאָרן, און נישט פֿון אַ מאָל,</para>
  <para style="q" vid="ISA 48:7">און אַ טאָג פֿריִער האָסטו פֿון דעם נישט געהערט;</para>
  <para style="q" vid="ISA 48:7">כּדי זאָלסט נישט זאָגן: זע, איך האָב עס געװוּסט.<verse eid="ISA 48:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 48:8" />נישט צו מאָל געהערט האָסטו, נישט צו מאָל געװוּסט האָסטו,</para>
  <para style="q" vid="ISA 48:8">נישט צו מאָל געעפֿנט האָט זיך דײַן אױער פֿון אַ מאָל;</para>
  <para style="q" vid="ISA 48:8">װאָרעם איך האָב געװוּסט אַז פֿעלשן װעסטו פֿעלשן,</para>
  <para style="q" vid="ISA 48:8">און פֿאַרברעכער פֿון מוטערלײַב האָט מען דיך גערופֿן.<verse eid="ISA 48:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 48:9" />פֿון מײַן נאָמען װעגן װעל איך אײַנהאַלטן מײַן צאָרן,</para>
  <para style="q" vid="ISA 48:9">פֿון מײַן לױב װעגן װעל איך מיך צאַמען קעגן דיר,</para>
  <para style="q" vid="ISA 48:9">כּדי דיך נישט צו פֿאַרשנײַדן.<verse eid="ISA 48:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 48:10" />זע, איך האָב דיך געלײַטערט, אָבער נישט װי זילבער,</para>
  <para style="q" vid="ISA 48:10">איך האָב דיך געפּרוּװט אין שמעלצאױװן פֿון פּײַן.<verse eid="ISA 48:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 48:11" />פֿון מײַנעט װעגן, פֿון מײַנעט װעגן װעל איך טאָן;</para>
  <para style="q" vid="ISA 48:11">װאָרעם װי זאָל מײַן נאָמען פֿאַרשװעכט װערן?</para>
  <para style="q" vid="ISA 48:11">און מײַן כּבֿוד װעל איך קײן אַנדערן נישט געבן.<verse eid="ISA 48:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 48:12" />הער מיר צו, יעקבֿ,</para>
  <para style="q" vid="ISA 48:12">און יִשׂרָאֵל מײַן גערופֿענער:</para>
  <para style="q" vid="ISA 48:12">איך בין דאָס; איך בין דער ערשטער,</para>
  <para style="q" vid="ISA 48:12">איך בין אױך דער לעצטער.<verse eid="ISA 48:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 48:13" />יאָ, מײַן האַנט האָט געגרונטפֿעסט די ערד,</para>
  <para style="q" vid="ISA 48:13">און מײַן רעכטע האָט אױסגעשפּרײט די הימלען;</para>
  <para style="q" vid="ISA 48:13">איך רוף צו זײ,</para>
  <para style="q" vid="ISA 48:13">שטעלן זײ זיך אױף אין אײנעם.<verse eid="ISA 48:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 48:14" />זאַמלט אײַך אײַן, איר אַלע, און הערט:</para>
  <para style="q" vid="ISA 48:14">װער צװישן זײ האָט פֿאַרױסגעזאָגט דאָס דאָזיקע?</para>
  <para style="q" vid="ISA 48:14">דער װאָס ה׳ האָט אים ליב, װעט טאָן זײַן באַגער אין בָבֿל,</para>
  <para style="q" vid="ISA 48:14">און זײַן אָרעם װעט זײַן אױף די כַּשׂדים.<verse eid="ISA 48:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 48:15" />איך, איך האָב גערעדט, און האָב אים גערופֿן,</para>
  <para style="q" vid="ISA 48:15">אים געבראַכט, און ער װעט באַגליקן אױף זײַן װעג.<verse eid="ISA 48:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 48:16" />גענענט צו מיר, הערט דאָס צו:</para>
  <para style="q" vid="ISA 48:16">פֿון אָנהײב אָן האָב איך נישט אין פֿאַרבאָרגעניש גערעדט,</para>
  <para style="q" vid="ISA 48:16">פֿון זינט עס געשעט בין איך דערבײַ;</para>
  <para style="q" vid="ISA 48:16">און אַצונד האָט אֲדֹנָי ה׳ מיך געשיקט מיט זײַן גײַסט.<verse eid="ISA 48:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 48:17" />אַזױ האָט געזאָגט ה׳ דײַן אױסלײזער,</para>
  <para style="q" vid="ISA 48:17">דער הײליקער פֿון יִשׂרָאֵל.</para>
  <para style="q" vid="ISA 48:17">איך, ה׳ דײַן ג-ט, לערן דיך צו נוץ,</para>
  <para style="q" vid="ISA 48:17">פֿיר דיך אױף דעם װעג װאָס דו זאָלסט גײן.<verse eid="ISA 48:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 48:18" />הלװאַי װאָלסטו פֿאַרנומען מײַנע געבאָט,</para>
  <para style="q" vid="ISA 48:18">װאָלט געװען װי אַ טײַך דײַן שלום,</para>
  <para style="q" vid="ISA 48:18">און דײַן הילף װי די אינדן פֿון ים;<verse eid="ISA 48:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 48:19" />און געװען װי זאַמד װאָלט דײַן זאָמען,</para>
  <para style="q" vid="ISA 48:19">און די שפּראָצן פֿון דײַן לײַב װי זײַנע קערנער;</para>
  <para style="q" vid="ISA 48:19">נישט פֿאַרשניטן און נישט פֿאַרטיליקט</para>
  <para style="q" vid="ISA 48:19">װאָלט װערן זײַן נאָמען פֿון פֿאַר מיר.<verse eid="ISA 48:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 48:20" />גײט אַרױס פֿון בָבֿל,</para>
  <para style="q" vid="ISA 48:20">אַנטלױפֿט פֿון די כַּשׂדים,</para>
  <para style="q" vid="ISA 48:20">מיט אַ קֹול פֿון געזאַנג;</para>
  <para style="q" vid="ISA 48:20">זאָגט אָן, מאַכט דאָס הערן,</para>
  <para style="q" vid="ISA 48:20">טראָגט עס פֿונאַנדער ביז צום עק פֿון דער ערד;</para>
  <para style="q" vid="ISA 48:20">זאָגט: ה׳ האָט אױסגעלײזט יעקבֿ זײַן קנעכט.<verse eid="ISA 48:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 48:21" />און זײ האָבן נישט געדאָרשט</para>
  <para style="q" vid="ISA 48:21">װען ער האָט זײ דורך װיסטענישן געפֿירט;</para>
  <para style="q" vid="ISA 48:21">װאַסער פֿון פֿעלדז האָט ער געמאַכט רינען פֿאַר זײ;</para>
  <para style="q" vid="ISA 48:21">יאָ, אַ פֿעלדז האָט ער געשפּאָלטן,</para>
  <para style="q" vid="ISA 48:21">און װאַסער האָט געפֿלאָסן.<verse eid="ISA 48:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 48:22" />נישטאָ קײן שלום, זאָגט ה׳,</para>
  <para style="q" vid="ISA 48:22">פֿאַר די רשעים.<verse eid="ISA 48:22" /></para>
  <chapter eid="ISA 48" />
  <chapter number="49" style="c" pubnumber="מט" sid="ISA 49" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 49:1" />הערט מיר צו, איר אינדזלען,</para>
  <para style="q" vid="ISA 49:1">און פֿאַרנעמט, איר פֿעלקער פֿון דער װײַט:</para>
  <para style="q" vid="ISA 49:1">ה׳ האָט מיך פֿון טראַכט גערופֿן,</para>
  <para style="q" vid="ISA 49:1">פֿון מײַן מוטערס לײַב האָט ער מײַן נאָמען דערמאָנט.<verse eid="ISA 49:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 49:2" />און ער האָט געמאַכט מײַן מױל װי אַ שאַרפֿע שװערד,</para>
  <para style="q" vid="ISA 49:2">אין שאָטן פֿון זײַן האַנט האָט ער מיך באַהאַלטן;</para>
  <para style="q" vid="ISA 49:2">און ער האָט מיך געמאַכט פֿאַר אַ בלאַנקער פֿײַל,</para>
  <para style="q" vid="ISA 49:2">אין זײַן פֿײַלבײַטל האָט ער מיך פֿאַרבאָרגן.<verse eid="ISA 49:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 49:3" />און ער האָט צו מיר געזאָגט: מײַן קנעכט ביסטו, אָ יִשׂרָאֵל,</para>
  <para style="q" vid="ISA 49:3">װאָס איך רים זיך מיט דיר.<verse eid="ISA 49:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 49:4" />און איך האָב געװעסט געזאָגט: אומנישט האָב איך מיך געמיט,</para>
  <para style="q" vid="ISA 49:4">אױף נישט און ניװעץ האָב איך מײַן כּוֹח פֿאַרלענדט;</para>
  <para style="q" vid="ISA 49:4">אָבער מײַן משפּט איז בײַ ה׳,</para>
  <para style="q" vid="ISA 49:4">און מײַן לױן בײַ מײַן ג-ט.<verse eid="ISA 49:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 49:5" />און אַצונד האָט ה׳ געזאָגט –</para>
  <para style="q" vid="ISA 49:5">דער װאָס האָט מיך געפֿורעמט פֿון טראַכט</para>
  <para style="q" vid="ISA 49:5">פֿאַר אַ קנעכט צו אים –</para>
  <para style="q" vid="ISA 49:5">אומצוקערן צו זיך יעקבֿ,</para>
  <para style="q" vid="ISA 49:5">און יִשׂרָאֵל זאָל אײַנגעזאַמלט װערן צו אים;</para>
  <para style="q" vid="ISA 49:5">און איך בין געערט אין די אױגן פֿון ה׳,</para>
  <para style="q" vid="ISA 49:5">און מײַן ג-ט איז מײַן שטאַרקײט.<verse eid="ISA 49:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 49:6" />און ער האָט געזאָגט:</para>
  <para style="q" vid="ISA 49:6">קנאַפּ איז – װײַל דו ביסט מײַן קנעכט –</para>
  <para style="q" vid="ISA 49:6">אױפֿצוריכטן די שטאַמען פֿון יעקבֿ,</para>
  <para style="q" vid="ISA 49:6">און די צװײַגן פֿון יִשׂרָאֵל אומצוקערן;</para>
  <para style="q" vid="ISA 49:6">נאָר איך װעל דיך מאַכן פֿאַר אַ ליכט פֿון די פֿעלקער.</para>
  <para style="q" vid="ISA 49:6">אַז מײַן הילף זאָל זײַן ביז צום עק פֿון דער ערד.<verse eid="ISA 49:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 49:7" />אַזױ האָט ה׳ געזאָגט,</para>
  <para style="q" vid="ISA 49:7">דער אױסלײזער פֿון יִשׂרָאֵל, און זײַן הײליקער,</para>
  <para style="q" vid="ISA 49:7">צו דעם װאָס איז פֿאַראַכטעט אין זײַן נפֿש,</para>
  <para style="q" vid="ISA 49:7">צו דעם פֿאַרומװערדיקטן פֿון פֿעלקער,</para>
  <para style="q" vid="ISA 49:7">צו דעם קנעכט פֿון געװעלטיקער:</para>
  <para style="q" vid="ISA 49:7">מלכים װעלן זען און װעלן אױפֿשטײן,</para>
  <para style="q" vid="ISA 49:7">שׂרָרות – און װעלן זיך בוקן,</para>
  <para style="q" vid="ISA 49:7">פֿון װעגן ה׳ װאָס איז געטרײַ,</para>
  <para style="q" vid="ISA 49:7">דעם הײליקן פֿון יִשׂרָאֵל װאָס האָט דיך אױסדערװײלט.<verse eid="ISA 49:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 49:8" />אַזױ האָט ה׳ געזאָגט:</para>
  <para style="q" vid="ISA 49:8">אין צײַט פֿון באַװיליקונג טו איך דיר ענטפֿערן,</para>
  <para style="q" vid="ISA 49:8">און אין טאָג פֿון ישועה טו איך דיך העלפֿן;</para>
  <para style="q" vid="ISA 49:8">און איך װעל דיך היטן,</para>
  <para style="q" vid="ISA 49:8">און דיך מאַכן פֿאַר אַ ברית צו די אומות,</para>
  <para style="q" vid="ISA 49:8">כּדי דו זאָלסט אױפֿריכטן דאָס לאַנד,</para>
  <para style="q" vid="ISA 49:8">אַז דו זאָלסט זײ מאַכן ירשענען די װיסטע נַחלות;<verse eid="ISA 49:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 49:9" />צו זאָגן צו די געפֿאַנגענע: גײט אַרױס!</para>
  <para style="q" vid="ISA 49:9">צו די װאָס אין פֿינצטערניש: אַנטפּלעקט אײַך!</para>
  <para style="q" vid="ISA 49:9">בײַ די װעגן װעלן זײ זיך פֿיטערן,</para>
  <para style="q" vid="ISA 49:9">און אױף אַלע הױכע ערטער װעט זײַן זײער פֿיטערונג.<verse eid="ISA 49:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 49:10" />זײ װעלן נישט הונגערן און נישט דאָרשטן,</para>
  <para style="q" vid="ISA 49:10">און נישט פּלאָגן װעט זײ היץ און זון,</para>
  <para style="q" vid="ISA 49:10">װאָרעם זײער דערבאַרעמער װעט זײ באַלײטן,</para>
  <para style="q" vid="ISA 49:10">און בײַ קװאַלן װאַסער װעט ער זײ פֿירן.<verse eid="ISA 49:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 49:11" />און איך װעל מאַכן אַלע מײַנע בערג פֿאַר אַ װעג,</para>
  <para style="q" vid="ISA 49:11">און מײַנע שטעגן װעלן דערהײכט װערן.<verse eid="ISA 49:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 49:12" />זע, די װעלן קומען פֿון דער װײַטן,</para>
  <para style="q" vid="ISA 49:12">און זע, יענע פֿון צפֿון און פֿון מערבֿ,</para>
  <para style="q" vid="ISA 49:12">און די, פֿון לאַנד סינים.<verse eid="ISA 49:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 49:13" />זינגט, איר הימלען, און פֿרײ זיך, דו ערד,</para>
  <para style="q" vid="ISA 49:13">און ברעכט אױס, איר בערג, אין געזאַנג,</para>
  <para style="q" vid="ISA 49:13">װאָרעם ה׳ האָט געטרײסט זײַן פֿאָלק,</para>
  <para style="q" vid="ISA 49:13">און זײַנע אָרימע טוט ער דערבאַרעמען.<verse eid="ISA 49:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 49:14" />און צִיוֹן האָט געזאָגט: פֿאַרלאָזן האָט מיך ה׳,</para>
  <para style="q" vid="ISA 49:14">און אֲדֹנָי האָט פֿאַרגעסן אָן מיר.<verse eid="ISA 49:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 49:15" />קען אַ פֿרױ פֿאַרגעסן איר ברוסטקינד,</para>
  <para style="q" vid="ISA 49:15">נישט צו דערבאַרעמען דעם זון פֿון איר לײַב?</para>
  <para style="q" vid="ISA 49:15">אַפֿילו די דאָזיקע זאָלן פֿאַרגעסן,</para>
  <para style="q" vid="ISA 49:15">װעל איך אָן דיר נישט פֿאַרגעסן.<verse eid="ISA 49:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 49:16" />זע, אױף די האַנטפֿלעכן האָב איך דיך אױסגעקריצט,</para>
  <para style="q" vid="ISA 49:16">דײַנע מױערן זײַנען תּמיד פֿאַר מיר.<verse eid="ISA 49:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 49:17" />אײַליק קומען דײַנע קינדער;</para>
  <para style="q" vid="ISA 49:17">דײַנע צעשטערער און דײַנע פֿאַרװיסטער</para>
  <para style="q" vid="ISA 49:17">װעלן אַרױס פֿון דיר.<verse eid="ISA 49:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 49:18" />הײב אױף רונד אַרום דײַנע אױגן, און זע:</para>
  <para style="q" vid="ISA 49:18">זײ אַלע זײַנען אײַנגעזאַמלט, און קומען צו דיר.</para>
  <para style="q" vid="ISA 49:18">אַזױ װי איך לעב, זאָגט ה׳,</para>
  <para style="q" vid="ISA 49:18">אַז זײ אַלע װעסטו װי אַ צירונג אָנטאָן,</para>
  <para style="q" vid="ISA 49:18">און װעסט זײ אָנקניפּן אַזױ װי אַ כּלה;<verse eid="ISA 49:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="ISA 49:19" />װאָרעם דײַנע חורבֿות און דײַנע װיסטענישן,</para>
  <para style="q" vid="ISA 49:19">און דײַן לאַנד דאָס צעשטערטע –</para>
  <para style="q" vid="ISA 49:19">פֿאַר װאָר, װעסט אַצונד ענג זײַן פֿון װױנער,</para>
  <para style="q" vid="ISA 49:19">און דערװײַטערט װעלן זײַן דײַנע אומברענגער.<verse eid="ISA 49:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 49:20" />זאָגן װעלן נאָך אין דײַנע אױערן</para>
  <para style="q" vid="ISA 49:20">דײַנע אָנגעװאָרענע קינדער:</para>
  <para style="q" vid="ISA 49:20">ענג איז מיר דער אָרט,</para>
  <para style="q" vid="ISA 49:20">טרעט מיר אָפּ, איך זאָל קענען װױנען.<verse eid="ISA 49:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 49:21" />און װעסט זאָגן אין דײַן האַרצן:</para>
  <para style="q" vid="ISA 49:21">װער האָט מיר די דאָזיקע געבאָרן?</para>
  <para style="q" vid="ISA 49:21">איך בין געװען אָן קינדער און עקרה,</para>
  <para style="q" vid="ISA 49:21">פֿאַרטריבן און פֿאַרװאָגעלט;</para>
  <para style="q" vid="ISA 49:21">און די דאָזיקע װער האָט אױפֿגעצױגן?</para>
  <para style="q" vid="ISA 49:21">זע, איך בין דאָך געבליבן אַלײן,</para>
  <para style="q" vid="ISA 49:21">די דאָזיקע װוּ זײַנען געװען?<verse eid="ISA 49:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 49:22" />אַזױ האָט געזאָגט אֲדֹנָי ה׳:</para>
  <para style="q" vid="ISA 49:22">זע, איך װעל אױפֿהײבן צו די פֿעלקער מײַן האַנט,</para>
  <para style="q" vid="ISA 49:22">און צו די אומות װעל איך אױפֿשטעלן מײַן פֿאָן,</para>
  <para style="q" vid="ISA 49:22">און זײ װעלן ברענגען דײַנע זין אין בוזעם,</para>
  <para style="q" vid="ISA 49:22">און דײַנע טעכטער װעלן אױפֿן אַקסל געטראָגן װערן.<verse eid="ISA 49:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 49:23" />און מלכים װעלן זײַן דײַנע דערציִער,</para>
  <para style="q" vid="ISA 49:23">און זײער שׂרָרהטעס דײַנע נאַס ניאַניע;</para>
  <para style="q" vid="ISA 49:23">מיטן פּנים צו דער ערד װעלן זײ זיך בוקן צו דיר,</para>
  <para style="q" vid="ISA 49:23">און דעם שטױב פֿון דײַנע פֿיס װעלן זײ לעקן;</para>
  <para style="q" vid="ISA 49:23">און װעסט װיסן אַז איך בין ה׳,</para>
  <para style="q" vid="ISA 49:23">װאָס נישט פֿאַרשעמט װערן די װאָס האָפֿן צו מיר.<verse eid="ISA 49:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 49:24" />װערט אַװעקגענומען פֿון דעם גיבור דער רױב,</para>
  <para style="q" vid="ISA 49:24">צי װערט דער פֿאַנג פֿון דעם זיגער אַנטרונען?<verse eid="ISA 49:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 49:25" />פֿאַר װאָר, אַזױ זאָגט ה׳:</para>
  <para style="q" vid="ISA 49:25">אַפֿילו דער פֿאַנג פֿון דעם גיבור זאָל אַװעקגענומען װערן,</para>
  <para style="q" vid="ISA 49:25">און דער רױב פֿון דעם שטאַרקן זאָל אַנטרונען װערן,</para>
  <para style="q" vid="ISA 49:25">אָבער מיט דײַנע קריגער װעל איך קריגן,</para>
  <para style="q" vid="ISA 49:25">און דײַנע קינדער װעל איך העלפֿן.<verse eid="ISA 49:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 49:26" />און איך װעל מאַכן עסן דײַנע דריקער זײער פֿלײש,</para>
  <para style="q" vid="ISA 49:26">און װי טרױבנזאַפֿט װעלן זײ זײער בלוט שיכּורן;</para>
  <para style="q" vid="ISA 49:26">און אַלע לײַבער װעלן װיסן אַז איך ה׳ בין דײַן העלפֿער,</para>
  <para style="q" vid="ISA 49:26">און דײַן אױסלײזער גֹּואֵל איז דער מאַכטיקער פֿון יעקבֿ.<verse eid="ISA 49:26" /></para>
  <chapter eid="ISA 49" />
  <chapter number="50" style="c" pubnumber="נ" sid="ISA 50" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 50:1" />אַזױ האָט ה׳ געזאָגט:</para>
  <para style="q" vid="ISA 50:1">װוּ איז דער גט פֿון אײַער מוטער,</para>
  <para style="q" vid="ISA 50:1">אַז איך האָב זי אַװעקגעשיקט?</para>
  <para style="q" vid="ISA 50:1">אָדער װער איז פֿון מײַנע מאָנער,</para>
  <para style="q" vid="ISA 50:1">װאָס איך האָב אײַך פֿאַרקױפֿט צו אים?</para>
  <para style="q" vid="ISA 50:1">זעט, איבער אײַערע זינד זײַט איר פֿאַרקױפֿט געװאָרן,</para>
  <para style="q" vid="ISA 50:1">און איבער אײַערע פֿאַרברעכן איז אײַער מוטער אַװעקגעשיקט געװאָרן.<verse eid="ISA 50:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 50:2" />פֿאַר װאָס בין איך געקומען, און קײן מענטש איז נישט געװען?</para>
  <para style="q" vid="ISA 50:2">גערופֿן, און קײנער האָט נישט געענטפֿערט?</para>
  <para style="q" vid="ISA 50:2">איז דען קורץ מײַן האַנט אױסצולײזן,</para>
  <para style="q" vid="ISA 50:2">צי נישטאָ קײן כּוֹח אין מיר, אײַך מציל צו זײַן?</para>
  <para style="q" vid="ISA 50:2">זעט, מיט מײַן אָנגעשרײ טריקן איך אױס דעם ים.</para>
  <para style="q" vid="ISA 50:2">איך מאַך פֿון טײַכן אַ מדבר;</para>
  <para style="q" vid="ISA 50:2">זײערע פֿיש װערן דומפּיק אָן װאַסער,</para>
  <para style="q" vid="ISA 50:2">און שטאַרבן פֿון דאָרשטיקײט.<verse eid="ISA 50:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 50:3" />איך קלײד די הימלען אין שװאַרצקײט,</para>
  <para style="q" vid="ISA 50:3">און מאַך זאַק זײער צודעק.<verse eid="ISA 50:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 50:4" />אֲדֹנָי ה׳ האָט מיר געגעבן</para>
  <para style="q" vid="ISA 50:4">אַ צונג פֿון געלערנטע,</para>
  <para style="q" vid="ISA 50:4">צו װיסן צו העלפֿן דעם מידן מיט אַ װאָרט;</para>
  <para style="q" vid="ISA 50:4">ער װעקט פֿרימאָרגן אין פֿרימאָרגן,</para>
  <para style="q" vid="ISA 50:4">ער װעקט מיר דאָס אױער,</para>
  <para style="q" vid="ISA 50:4">צו הערן אַזױ װי די געלערנטע.<verse eid="ISA 50:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 50:5" />אֲדֹנָי ה׳ האָט מיר געעפֿנט דאָס אױער,</para>
  <para style="q" vid="ISA 50:5">און איך האָב נישט װידערשפּעניקט,</para>
  <para style="q" vid="ISA 50:5">נישט אָפּגעטרעטן אַהינטער.<verse eid="ISA 50:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 50:6" />מײַן רוקן האָב איך געגעבן צו די שלעגער,</para>
  <para style="q" vid="ISA 50:6">און מײַנע באַקן צו די װאָס רײסן אױס דעם באַרט;</para>
  <para style="q" vid="ISA 50:6">איך האָב נישט פֿאַרבאָרגן מײַן פּנים</para>
  <para style="q" vid="ISA 50:6">פֿון שאַנדן און שפּײַעכץ.<verse eid="ISA 50:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 50:7" />אָבער אֲדֹנָי ה׳ װעט מיר העלפֿן,</para>
  <para style="q" vid="ISA 50:7">דערום בין איך נישט פֿאַרשעמט;</para>
  <para style="q" vid="ISA 50:7">דערום האָב איך געמאַכט מײַן פּנים װי קיזל,</para>
  <para style="q" vid="ISA 50:7">און איך װײס אַז איך װעל נישט אין ביוש בלײַבן.<verse eid="ISA 50:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 50:8" />נאָנט איז מײַן גערעכטגעבער;</para>
  <para style="q" vid="ISA 50:8">װער װיל זיך לאָדן מיט מיר?</para>
  <para style="q" vid="ISA 50:8">לאָמיר זיך שטעלן בײַנאַנד;</para>
  <para style="q" vid="ISA 50:8">װער איז מײַן בַעַל-דין?</para>
  <para style="q" vid="ISA 50:8">זאָל ער גענענען צו מיר.<verse eid="ISA 50:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 50:9" />זע, אֲדֹנָי ה׳ װעט מיר העלפֿן;</para>
  <para style="q" vid="ISA 50:9">װער איז דער װאָס װעט מיך אומגערעכט מאַכן?</para>
  <para style="q" vid="ISA 50:9">זע, זײ אַלע װעלן װי אַ בגד צעפֿאַלן,</para>
  <para style="q" vid="ISA 50:9">מאָיל װעט זײ אױפֿעסן.<verse eid="ISA 50:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 50:10" />װער איז צװישן אײַך װאָס האָט מורא פֿאַר ה׳,</para>
  <para style="q" vid="ISA 50:10">װאָס הערט צו דעם קֹול פֿון זײַן קנעכט?</para>
  <para style="q" vid="ISA 50:10">װאָס איז געגאַנגען אין פֿינצטערניש,</para>
  <para style="q" vid="ISA 50:10">און האָט קײן ליכט נישט געהאַט?</para>
  <para style="q" vid="ISA 50:10">זאָל ער זיך פֿאַרזיכערן אױף דעם נאָמען פֿון ה׳,</para>
  <para style="q" vid="ISA 50:10">און זיך אָנלענען אױף זײַן ג-ט.<verse eid="ISA 50:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 50:11" />אָט איר אַלע װאָס צינדט אָן אַ פֿײַער,</para>
  <para style="q" vid="ISA 50:11">װאָס גורט אָן פֿונקען –</para>
  <para style="q" vid="ISA 50:11">גײט אין דער פֿלאַם פֿון אײַער פֿײַער,</para>
  <para style="q" vid="ISA 50:11">און אין די פֿונקען װאָס איר האָט אָנגעצונדן!</para>
  <para style="q" vid="ISA 50:11">פֿון מײַן האַנט געשעט דאָס אײַך,</para>
  <para style="q" vid="ISA 50:11">אין װײטאָג װעט איר ליגן.<verse eid="ISA 50:11" /></para>
  <chapter eid="ISA 50" />
  <chapter number="51" style="c" pubnumber="נא" sid="ISA 51" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 51:1" />הערט מיר צו, איר װאָס יאָגט זיך נאָך גערעכטיקײט,</para>
  <para style="q" vid="ISA 51:1">איר װאָס זוכט ה׳:</para>
  <para style="q" vid="ISA 51:1">קוקט אױף דעם פֿעלדז פֿון װאַנען איר זײַט אױסגעהאַקט,</para>
  <para style="q" vid="ISA 51:1">און אױף דער ברונעמגרוב פֿון װאַנען איר זײַט אױסגעגראָבן;<verse eid="ISA 51:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 51:2" />קוקט אױף אבֿרהם אײַער פֿאָטער,</para>
  <para style="q" vid="ISA 51:2">און אױף שׂרהן װאָס האָט אײַך געבאָרן;</para>
  <para style="q" vid="ISA 51:2">הגם אײנער, האָב איך אים גערופֿן,</para>
  <para style="q" vid="ISA 51:2">כּדי איך זאָל אים בענטשן, און זאָל אים מערן.<verse eid="ISA 51:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 51:3" />פֿאַר װאָר, ה׳ טוט טרײסטן צִיוֹן,</para>
  <para style="q" vid="ISA 51:3">ער טרײסט אַלע אירע חורבֿות;</para>
  <para style="q" vid="ISA 51:3">ער װעט מאַכן אירע מדבר אַזױ װי עֵדֶן,</para>
  <para style="q" vid="ISA 51:3">און אירע װיסטע ערטער אַזױ װי דעם גאָרטן פֿון ה׳,</para>
  <para style="q" vid="ISA 51:3">פֿרײד און שׂימחה װעט אין איר געפֿונען װערן,</para>
  <para style="q" vid="ISA 51:3">לױב און אַ קֹול פֿון געזאַנג.<verse eid="ISA 51:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 51:4" />האָרכט צו מיר, מײַן פֿאָלק,</para>
  <para style="q" vid="ISA 51:4">און פֿאַרנעמט צו מיר, מײַן אומה,</para>
  <para style="q" vid="ISA 51:4">װאָרעם אַ תּורה װעט אַרױסגײן פֿון מיר,</para>
  <para style="q" vid="ISA 51:4">און מײַן משפּט װעל איך צום ליכט פֿון די פֿעלקער אַרױסלאָזן.<verse eid="ISA 51:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 51:5" />נאָנט איז מײַן גערעכטיקײט,</para>
  <para style="q" vid="ISA 51:5">אַרױס איז מײַן הילף,</para>
  <para style="q" vid="ISA 51:5">און מײַנע אָרעמס װעלן משפּטן די פֿעלקער;</para>
  <para style="q" vid="ISA 51:5">די אינדזלען װעלן האָפֿן אױף מיר,</para>
  <para style="q" vid="ISA 51:5">און אױף מײַן אָרעם װעלן זײ האָפֿן.<verse eid="ISA 51:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 51:6" />הײבט אױף צו די הימלען אײַערע אױגן,</para>
  <para style="q" vid="ISA 51:6">און קוקט אױף דער ערד פֿון אונטן,</para>
  <para style="q" vid="ISA 51:6">װאָרעם די הימלען װערן װי רױך צעקראָכן,</para>
  <para style="q" vid="ISA 51:6">און די ערד װעט װי אַ בגד צעפֿאַלן,</para>
  <para style="q" vid="ISA 51:6">און אירע באַװױנער װעלן װי אומגעציפֿער שטאַרבן;</para>
  <para style="q" vid="ISA 51:6">אָבער מײַן הילף װעט זײַן אײביק,</para>
  <para style="q" vid="ISA 51:6">און מײַן גערעכטיקײט װעט נישט אָפּגעבראָכן װערן.<verse eid="ISA 51:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 51:7" />הערט מיר צו, איר װאָס װײסט גערעכטיקײט,</para>
  <para style="q" vid="ISA 51:7">דאָס פֿאָלק װאָס מײַן תּורה איז אין זײער האַרצן:</para>
  <para style="q" vid="ISA 51:7">איר זאָלט נישט מורא האָבן פֿאַרן שמאַך פֿון מענטשן,</para>
  <para style="q" vid="ISA 51:7">און פֿאַר זײערע לעסטערונגען זאָלט איר נישט אַנגסטן.<verse eid="ISA 51:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 51:8" />װאָרעם אַזױ װי אַ בגד װעט זײ מאָיל אױפֿעסן,</para>
  <para style="q" vid="ISA 51:8">און אַזױ װי װאָל װעט זײ דער װאָרעם אױפֿעסן,</para>
  <para style="q" vid="ISA 51:8">אָבער מײַן גערעכטיקײט װעט זײַן אײביק,</para>
  <para style="q" vid="ISA 51:8">און מײַן הילף אױף דור-דורות.<verse eid="ISA 51:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 51:9" />דערװעק דיך, דערװעק דיך,</para>
  <para style="q" vid="ISA 51:9">באַקלײד דיך מיט שטאַרקײט, דו אָרעם פֿון ה׳;</para>
  <para style="q" vid="ISA 51:9">דערװעק דיך װי אין די טעג פֿון אַ מאָל,</para>
  <para style="q" vid="ISA 51:9">אין די דורות פֿון פֿאַרצײַטן.</para>
  <para style="q" vid="ISA 51:9">ביסטו נישט דער װאָס האָט צעהאַקט רַהַבֿ,</para>
  <para style="q" vid="ISA 51:9">װאָס האָט אַרײַנגעשטאָכן די שלאַנג?<verse eid="ISA 51:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 51:10" />ביסטו נישט דער װאָס האָט אױסגעטריקנט דעם ים,</para>
  <para style="q" vid="ISA 51:10">די װאַסערן פֿון דעם תּהום דעם גרױסן;</para>
  <para style="q" vid="ISA 51:10">װאָס האָט געמאַכט די טיפֿענישן פֿון ים פֿאַר אַ װעג,</para>
  <para style="q" vid="ISA 51:10">פֿאַר די אױסגעלײזטע אַריבערצוגײן?<verse eid="ISA 51:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 51:11" />און די דערלײזטע פֿון ה׳ זאָלן זיך אומקערן,</para>
  <para style="q" vid="ISA 51:11">און קומען קײן צִיוֹן מיט געזאַנג,</para>
  <para style="q" vid="ISA 51:11">און אַן אײביקע שׂימחה זאָל זײַן אױף זײער קאָפּ;</para>
  <para style="q" vid="ISA 51:11">שָׂשׂון-וּשׂימחה זאָל זײ אָניאָגן,</para>
  <para style="q" vid="ISA 51:11">אַנטלױפֿן זאָלן טרױער און זיפֿצעניש.<verse eid="ISA 51:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 51:12" />איך, איך בין אײַער טרײסטער;</para>
  <para style="q" vid="ISA 51:12">װער ביסטו, זאָלסט מורא האָבן פֿאַר אַ מענטשן װאָס שטאַרבט,</para>
  <para style="q" vid="ISA 51:12">און פֿאַר אַ מענטשנקינד װאָס װערט צו גראָז געמאַכט?<verse eid="ISA 51:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 51:13" />און האָסט פֿאַרגעסן אָן ה׳ דײַן באַשעפֿער,</para>
  <para style="q" vid="ISA 51:13">װאָס האָט אױסגעשפּרײט די הימלען,</para>
  <para style="q" vid="ISA 51:13">און געגרונטפֿעסט די ערד;</para>
  <para style="q" vid="ISA 51:13">און האָסט געאַנגסט נאָכאַנאַנד אַ גאַנצן טאָג</para>
  <para style="q" vid="ISA 51:13">פֿאַרן גרימצאָרן פֿון דעם דריקער,</para>
  <para style="q" vid="ISA 51:13">װי ער האָט זיך אָנגעברײט אומצוברענגען;</para>
  <para style="q" vid="ISA 51:13">אָבער װוּ איז דער גרימצאָרן פֿון דעם דריקער?<verse eid="ISA 51:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 51:14" />גיך װערט דער געפֿאַנגענער אָפּגעבונדן,</para>
  <para style="q" vid="ISA 51:14">און ער װעט נישט שטאַרבן אין גרוב,</para>
  <para style="q" vid="ISA 51:14">און נישט געמינערט װערן װעט זײַן ברױט.<verse eid="ISA 51:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 51:15" />װאָרעם איך בין ה׳ דײַן ג-ט,</para>
  <para style="q" vid="ISA 51:15">װאָס צערודערט דעם ים, און זײַנע אינדן ברומען,</para>
  <para style="q" vid="ISA 51:15">װאָס ה׳ צבָֿאוֹת איז זײַן נאָמען.<verse eid="ISA 51:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 51:16" />און איך האָב אַרײַנגעטאָן מײַנע װערטער אין דײַן מױל,</para>
  <para style="q" vid="ISA 51:16">און מיטן שאָטן פֿון מײַן האַנט האָב איך דיך צוגעדעקט,</para>
  <para style="q" vid="ISA 51:16">כּדי צו פֿלאַנצן די הימלען, און צו גרונטפֿעסטן די ערד,</para>
  <para style="q" vid="ISA 51:16">און זאָגן צו צִיוֹן: מײַן פֿאָלק ביסטו.<verse eid="ISA 51:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 51:17" />דערװעק דיך, דערװעק דיך, שטײ אױף, ירושָלַיִם,</para>
  <para style="q" vid="ISA 51:17">דו װאָס האָסט געטרונקען פֿון ה׳ס האַנט</para>
  <para style="q" vid="ISA 51:17">דעם כָּוס פֿון זײַן גרימצאָרן; דעם בעכער,</para>
  <para style="q" vid="ISA 51:17">דעם כָּוס פֿון פֿאַרטומלעניש, געטרונקען און אױסגעזױגן.<verse eid="ISA 51:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 51:18" />נישטאָ װער זאָל זי פֿירן,</para>
  <para style="q" vid="ISA 51:18">פֿון אַלע זין װאָס זי האָט געבאָרן,</para>
  <para style="q" vid="ISA 51:18">און נישטאָ װער זאָל האַלטן איר האַנט,</para>
  <para style="q" vid="ISA 51:18">פֿון אַלע זין װאָס זי האָט אױפֿגעצױגן.<verse eid="ISA 51:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 51:19" />די בײדע האָבן דיך געטראָפֿן –</para>
  <para style="q" vid="ISA 51:19">װער קען דיך באַקלאָגן?</para>
  <para style="q" vid="ISA 51:19">פֿאַרװיסטונג און בראָך, און הונגער און שװערד –</para>
  <para style="q" vid="ISA 51:19">װי קען איך דיך טרײסטן?<verse eid="ISA 51:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 51:20" />דײַנע זין ליגן געחלשטע אין אַלע עק גאַסן,</para>
  <para style="q" vid="ISA 51:20">װי אַ װילדציג אין נעץ;</para>
  <para style="q" vid="ISA 51:20">פֿול מיט דעם גרימצאָרן פֿון ה׳,</para>
  <para style="q" vid="ISA 51:20">מיט דעם אָנגעשרײ פֿון דײַן ג-ט.<verse eid="ISA 51:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 51:21" />דערום הער נאָר צו דאָס דאָזיקע, דו אָרימע,</para>
  <para style="q" vid="ISA 51:21">און פֿאַרשיכּורטע, אָבער נישט פֿון װײַן;<verse eid="ISA 51:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 51:22" />אַזױ האָט געזאָגט דײַן האַר ה׳,</para>
  <para style="q" vid="ISA 51:22">און דײַן ג-ט װאָס נעמט זיך אָן פֿאַר זײַן פֿאָלק:</para>
  <para style="q" vid="ISA 51:22">זע, איך האָב אַװעקגענומען פֿון דײַן האַנט</para>
  <para style="q" vid="ISA 51:22">דעם כָּוס פֿון פֿאַרטומלעניש,</para>
  <para style="q" vid="ISA 51:22">דעם בעכער, דעם כָּוס פֿון מײַן גרימצאָרן;</para>
  <para style="q" vid="ISA 51:22">װעסט אים מער װידער נישט טרינקען.<verse eid="ISA 51:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 51:23" />און איך װעל אים אַרײַנטאָן אין דער האַנט פֿון דײַנע װײטוער,</para>
  <para style="q" vid="ISA 51:23">װאָס האָבן געזאָגט צו דײַן זעל:</para>
  <para style="q" vid="ISA 51:23">בײג זיך אײַן, מיר זאָלן אַריבערגײן;</para>
  <para style="q" vid="ISA 51:23">און האָסט געמאַכט װי די ערד דײַן רוקן,</para>
  <para style="q" vid="ISA 51:23">און װי די גאַס פֿאַר אַריבערגײער.<verse eid="ISA 51:23" /></para>
  <chapter eid="ISA 51" />
  <chapter number="52" style="c" pubnumber="נב" sid="ISA 52" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 52:1" />דערװעק דיך, דערװעק דיך,</para>
  <para style="q" vid="ISA 52:1">טו אָן דײַן שטאַרקײט, צִיוֹן;</para>
  <para style="q" vid="ISA 52:1">טו אָן דײַנע פּראַכטיקע בגדים,</para>
  <para style="q" vid="ISA 52:1">ירושָלַיִם, דו הײליקע שטאָט;</para>
  <para style="q" vid="ISA 52:1">װאָרעם מער װידער װעט נישט קומען אין דיר</para>
  <para style="q" vid="ISA 52:1">קײן עָרל און קײן טמא.<verse eid="ISA 52:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 52:2" />שאָקל דיך אָפּ פֿון שטױב,</para>
  <para style="q" vid="ISA 52:2">הײב דיך אױף, זעץ דיך, ירושָלַיִם;</para>
  <para style="q" vid="ISA 52:2">מאַך דיר לױז די בינדשטריק פֿון דײַן האַלדז,</para>
  <para style="q" vid="ISA 52:2">געפֿאַנגענע טאָכטער צִיוֹן.<verse eid="ISA 52:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="ISA 52:3" />װאָרעם אַזױ האָט ה׳ געזאָגט: אומזיסט זײַט איר פֿאַרקױפֿט געװאָרן, און נישט פֿאַר געלט װעט איר אױסגעלײזט װערן. <verse eid="ISA 52:3" /><verse number="4" style="v" sid="ISA 52:4" />װאָרעם אַזױ האָט געזאָגט אֲדֹנָי ה׳: קײן מִצרַיִם האָט גענידערט מײַן פֿאָלק צוערשט, דאָרטן צו װױנען, און אשור האָט אים פֿאַר גאָרנישט געדריקט. <verse eid="ISA 52:4" /><verse number="5" style="v" sid="ISA 52:5" />און אַצונד, װאָס האָב איך דאָ, זאָגט ה׳, װען מײַן פֿאָלק איז אַװעקגענומען געװאָרן פֿאַר אומזיסט? זײַנע געװעלטיקער רימען זיך, זאָגט ה׳, און תּמיד אַ גאַנצן טאָג װערט מײַן נאָמען געלעסטערט. <verse eid="ISA 52:5" /><verse number="6" style="v" sid="ISA 52:6" />דערום װעט מײַן פֿאָלק געװאָר װערן מײַן נאָמען; פֿאַר װאָר, אין יענעם טאָג – אַז איך בין דער װאָס רעדט; דאָ בין איך.<verse eid="ISA 52:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 52:7" />װי שײן זײַנען אױף די בערג די פֿיס פֿון דעם מבֿשׂר</para>
  <para style="q" vid="ISA 52:7">װאָס לאָזט הערן שלום, װאָס איז מבֿשׂר גוטעם,</para>
  <para style="q" vid="ISA 52:7">װאָס לאָזט הערן הילף:</para>
  <para style="q" vid="ISA 52:7">װאָס זאָגט צו צִיוֹן: דײַן ג-ט טוט קיניגן.<verse eid="ISA 52:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 52:8" />האָרך! דײַנע װעכטער הײבן אױף זײער קֹול,</para>
  <para style="q" vid="ISA 52:8">זײ זינגען אין אײנעם,</para>
  <para style="q" vid="ISA 52:8">װאָרעם אױג אין אױג זעען זײ</para>
  <para style="q" vid="ISA 52:8">װי ה׳ קערט זיך אום קײן צִיוֹן.<verse eid="ISA 52:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 52:9" />ברעכט אױס, זינגט אין אײנעם,</para>
  <para style="q" vid="ISA 52:9">איר חורבֿות פֿון ירושָלַיִם,</para>
  <para style="q" vid="ISA 52:9">װאָרעם ה׳ האָט געטרײסט זײַן פֿאָלק,</para>
  <para style="q" vid="ISA 52:9">ער האָט אױסגעלײזט ירושָלַיִם.<verse eid="ISA 52:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 52:10" />ה׳ האָט אַנטבלױזט זײַן הײליקן אָרעם</para>
  <para style="q" vid="ISA 52:10">פֿאַר די אױגן פֿון אַלע פֿעלקער,</para>
  <para style="q" vid="ISA 52:10">און אַלע עקן פֿון דער ערד</para>
  <para style="q" vid="ISA 52:10">װעלן זען די ישועה פֿון אלוקינו.<verse eid="ISA 52:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 52:11" />טוט אײַך אָפּ, טוט אײַך אָפּ, גײט אַרױס פֿון דאָרטן,</para>
  <para style="q" vid="ISA 52:11">אומרײנס זאָלט איר נישט אָנרירן;</para>
  <para style="q" vid="ISA 52:11">גײט אַרױס פֿון איר מיט,</para>
  <para style="q" vid="ISA 52:11">רײניקט אײַך, איר טרעגער פֿון די כּלים פֿון ה׳!<verse eid="ISA 52:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 52:12" />פֿאַר װאָר, נישט אין אײַלעניש װעט איר אַרױס,</para>
  <para style="q" vid="ISA 52:12">און נישט אין געלאַף װעט איר גײן;</para>
  <para style="q" vid="ISA 52:12">װאָרעם אײַך פֿאַרױס גײט ה׳,</para>
  <para style="q" vid="ISA 52:12">און אײַך נאָכבאַלײט אלוקי יִשׂרָאֵל.<verse eid="ISA 52:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 52:13" />זע, באַגליקן װעט מײַן קנעכט,</para>
  <para style="q" vid="ISA 52:13">ער װעט זײַן דערהױבענעם און זײַן זײער הױך.<verse eid="ISA 52:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 52:14" />אַזױ װי פֿיל האָבן געגאַפֿט אױף דיר –</para>
  <para style="q" vid="ISA 52:14">אַזױ פֿאַרקריפּלט, נישט פֿון אַ מענטשן איז געװען זײַן אױסזען,</para>
  <para style="q" vid="ISA 52:14">און זײַן געשטאַלט נישט פֿון מענטשנקינדער –<verse eid="ISA 52:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 52:15" />אַזױ װעט ער באַשפּרענקלען פֿיל פֿעלקער,</para>
  <para style="q" vid="ISA 52:15">מלכים װעלן צומאַכן זײער מױל פֿאַר אים;</para>
  <para style="q" vid="ISA 52:15">װאָרעם װאָס זײ איז נישט דערצײלט געװאָרן,</para>
  <para style="q" vid="ISA 52:15">װעלן זײ זען,</para>
  <para style="q" vid="ISA 52:15">און װאָס זײ האָבן נישט געהערט</para>
  <para style="q" vid="ISA 52:15">װעלן זײ אָנקוקן.<verse eid="ISA 52:15" /></para>
  <chapter eid="ISA 52" />
  <chapter number="53" style="c" pubnumber="נג" sid="ISA 53" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 53:1" />װער װאָלט געגלױבט װאָס מיר האָבן געהערט?</para>
  <para style="q" vid="ISA 53:1">און דער אָרעם פֿון ה׳ האָט זיך אױף װעמען אַנטפּלעקט?<verse eid="ISA 53:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 53:2" />װאָרעם ער איז אױפֿגעגאַנגען װי אַ שפּראָץ גלײַך אַרױף,</para>
  <para style="q" vid="ISA 53:2">און װי אַ װאָרצל פֿון טרוקענער ערד;</para>
  <para style="q" vid="ISA 53:2">ער האָט קײן געשטאַלט נישט געהאַט און קײן פּראַכט,</para>
  <para style="q" vid="ISA 53:2">אַז מיר זאָלן אים אָנקוקן,</para>
  <para style="q" vid="ISA 53:2">און קײן אױסזען, אַז מיר זאָלן אים גלוסטן.<verse eid="ISA 53:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 53:3" />ער איז געװען פֿאַראַכט, און פֿאַרװאָרפֿן פֿון מענטשן,</para>
  <para style="q" vid="ISA 53:3">אַ מענטש מיט װײטיקן און צו יסורים באַקענט,</para>
  <para style="q" vid="ISA 53:3">און װי אײנער װאָס מע פֿאַרבאָרגט דעם פּנים פֿון אים;</para>
  <para style="q" vid="ISA 53:3">פֿאַראַכט, און מיר האָבן אים גערעכנט פֿאַר גאָרנישט.<verse eid="ISA 53:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 53:4" />פֿאַר װאָר ער האָט אַװעקגעטראָגן אונדזערע יסורים,</para>
  <para style="q" vid="ISA 53:4">און אונדזערע װײטיקן, זײ האָט ער געטראָגן,</para>
  <para style="q" vid="ISA 53:4">אָבער מיר האָבן אים גערעכנט אַלס אײנער,</para>
  <para style="q" vid="ISA 53:4">װאָס איז געפּלעגט פֿון אלֹקים און געפּײַניקטן.<verse eid="ISA 53:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 53:5" />און ער איז אַרײַנגעשטאָכן געװען איבער אונדזערע איבערטרעטן,</para>
  <para style="q" vid="ISA 53:5">ער איז צעשטױסן געװאָרן װעגן אונדזערע אומגערעכטיקײטן;</para>
  <para style="q" vid="ISA 53:5">די שטראָף פֿאַר אונדזער פֿרידן איז געװען אױף אים,</para>
  <para style="q" vid="ISA 53:5">און דורך זײַנע בײלן זײַנען מיר געהײלט געװאָרן.<verse eid="ISA 53:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 53:6" />מיר אַלע האָבן װי שאָף געבלאָנדזשעט,</para>
  <para style="q" vid="ISA 53:6">איטלעכער מענטש האָט זיך צו זײַן װעג געקערט;</para>
  <para style="q" vid="ISA 53:6">און ה׳ האָט געפּלאָגן אױף אים</para>
  <para style="q" vid="ISA 53:6">די זינד פֿון אונדז אַלעמען.<verse eid="ISA 53:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 53:7" />ער איז געדריקט געװאָרן, און ער איז צעפּײַניקט,</para>
  <para style="q" vid="ISA 53:7">און ער נישט אױפֿגעמאַכט זײַן מױל,</para>
  <para style="q" vid="ISA 53:7">װי אַ לאַם װאָס װערט צו דער שחיטה געפֿירט,</para>
  <para style="q" vid="ISA 53:7">און װי אַ שעפּס װאָס איז שטום פֿאַר אירע שערער;</para>
  <para style="q" vid="ISA 53:7">יאָ, ער נישט אױפֿגעמאַכט זײַן מױל.<verse eid="ISA 53:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 53:8" />דורך דריקונג תּפֿיסה און דורך שטראָף איז ער אַװעקגענומען געװאָרן,</para>
  <para style="q" vid="ISA 53:8">און מיט זײַן דור װער האָט באַמערקט?</para>
  <para style="q" vid="ISA 53:8">װאָרעם ער איז אָפּגעשניטן געװאָרן</para>
  <para style="q" vid="ISA 53:8">פֿון לאַנד פֿון די לעבעדיקע,</para>
  <para style="q" vid="ISA 53:8">פֿאַר דעם איבערטרעטן פֿון מײַן פֿאָלק.<verse eid="ISA 53:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 53:9" />און מע האָט געמאַכט מיט רשעים זײַן קבֿר,</para>
  <para style="q" vid="ISA 53:9">און מיטן די רײַכע אין זײַן טױט,</para>
  <para style="q" vid="ISA 53:9">הגם ער האָט קײן אומרעכט נישט געטאָן,</para>
  <para style="q" vid="ISA 53:9">און קײן באַטרוג איז נישט געװען אין זײַן מױל.<verse eid="ISA 53:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 53:10" />אָבער ה׳ האָט אים געװאָלט צעשטױסן,</para>
  <para style="q" vid="ISA 53:10">און האָט אים דערטראָגט יסורים;</para>
  <para style="q" vid="ISA 53:10">װען דו װעסט מאַכן זײַן נשמה אַלס אַ שולדאָפּפֿער;</para>
  <para style="q" vid="ISA 53:10">כּדי ער זאָל זען זאָמען</para>
  <para style="q" vid="ISA 53:10">און דערלענגערן זײַנע טעג,</para>
  <para style="q" vid="ISA 53:10">און דער רָצון פֿון ה׳ דורך זײַן האַנט זאָל געלינגען.<verse eid="ISA 53:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 53:11" />פֿון װעגן דעם יסורים פֿון זײַן נפֿש װעט ער זען און זאַט װערן;</para>
  <para style="q" vid="ISA 53:11">דורך דערקענטעניש פֿון אים</para>
  <para style="q" vid="ISA 53:11">װעט מײַן גערעכטער קנעכט פֿיל גערעכט מאַכן,</para>
  <para style="q" vid="ISA 53:11">און זײערע זינד װעט ער טראָגן.<verse eid="ISA 53:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 53:12" />דערום װעל איך אים אײַנטײלן צװישן די גרױסע,</para>
  <para style="q" vid="ISA 53:12">און מיט מאַכטיקע װעט ער טײלן רױב;</para>
  <para style="q" vid="ISA 53:12">דערפֿאַר װאָס ער האָט אױסגעגאָסן צום טױט זײַן נשמה,</para>
  <para style="q" vid="ISA 53:12">און איז מיט פֿאַרברעכער געצײלט געװאָרן,</para>
  <para style="q" vid="ISA 53:12">און דעם חטא פֿון פֿיל האָט ער געטראָגן,</para>
  <para style="q" vid="ISA 53:12">און ער האָט געבעטן פֿאַר די איבערשפּרײַזערס.<verse eid="ISA 53:12" /></para>
  <chapter eid="ISA 53" />
  <chapter number="54" style="c" pubnumber="נד" sid="ISA 54" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 54:1" />זינג, דו עקרה, װאָס האָט נישט געבאָרן,</para>
  <para style="q" vid="ISA 54:1">ברעך אױס אין געזאַנג און שרײַ אױס,</para>
  <para style="q" vid="ISA 54:1">דו װאָס האָסט נישט געװײטאָקט;</para>
  <para style="q" vid="ISA 54:1">װאָרעם מער זײַנען די קינדער פֿון דער װיסטער,</para>
  <para style="q" vid="ISA 54:1">װי די קינדער פֿון דער באַמאַנטער, זאָגט ה׳.<verse eid="ISA 54:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 54:2" />ברײט אױס דעם אָרט פֿון דײַן געצעלט,</para>
  <para style="q" vid="ISA 54:2">און די אומהאַנגען פֿון דײַנע װױנונגען זאָל מען אױסשטרעקן;</para>
  <para style="q" vid="ISA 54:2">נישט שפּאָר, מאַך לאַנג דײַנע שטריק,</para>
  <para style="q" vid="ISA 54:2">און דײַנע פֿלעקלעך באַפֿעסטיק.<verse eid="ISA 54:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 54:3" />װאָרעם רעכטס און לינקס װעסטו זיך שפּרײטן,</para>
  <para style="q" vid="ISA 54:3">און דײַן זאָמען װעט אַרבן די פֿעלקער,</para>
  <para style="q" vid="ISA 54:3">און שטעט פֿאַרװיסטע װעלן זײ באַזעצן.<verse eid="ISA 54:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 54:4" />זאָלסט נישט מורא האָבן,</para>
  <para style="q" vid="ISA 54:4">װאָרעם װעסט נישט אין ביוש בלײַבן,</para>
  <para style="q" vid="ISA 54:4">און זאָלסט נישט פֿאַרשעמט זײַן,</para>
  <para style="q" vid="ISA 54:4">װאָרעם װעסט נישט צו שאַנד װערן.</para>
  <para style="q" vid="ISA 54:4">װאָרעם דעם ביוש פֿון דײַן יוגנט װעסטו פֿאַרגעסן,</para>
  <para style="q" vid="ISA 54:4">און די חרפּה פֿון דײַן אַלמנהשאַפֿט װעסטו מער נישט דערמאָנען.<verse eid="ISA 54:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 54:5" />װאָרעם דײַן באַשעפֿער איז דײַן מאַן,</para>
  <para style="q" vid="ISA 54:5">ה׳ צבָֿאוֹת איז זײַן נאָמען;</para>
  <para style="q" vid="ISA 54:5">און דײַן אױסלײזער איז דער הײליקער פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="ISA 54:5">אלֹקים פֿון דער גאַנצער ערד װערט ער גערופֿן.<verse eid="ISA 54:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 54:6" />װאָרעם װי אַ װײַב פֿאַרלאָזן און פֿאַראומערט אין געמיט</para>
  <para style="q" vid="ISA 54:6">טוט דיך צוריקרופֿן ה׳;</para>
  <para style="q" vid="ISA 54:6">און אַ יוגנטװײַב, קען זי דען נמאס װערן?</para>
  <para style="q" vid="ISA 54:6">זאָגט דײַן ג-ט.<verse eid="ISA 54:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 54:7" />אױף אַ קלײן רגע האָב איך דיך פֿאַרלאָזן,</para>
  <para style="q" vid="ISA 54:7">אָבער מיט גרױס דערבאַרעמונג װעל איך דיך אײַנזאַמלען.<verse eid="ISA 54:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 54:8" />אין אױסגוס פֿון כּעס</para>
  <para style="q" vid="ISA 54:8">האָב איך אַ רגע פֿאַרבאָרגן מײַן פּנים פֿון דיר,</para>
  <para style="q" vid="ISA 54:8">אָבער מיט אײביקער גענאָד</para>
  <para style="q" vid="ISA 54:8">טו איך דיך דערבאַרעמען,</para>
  <para style="q" vid="ISA 54:8">זאָגט דײַן אױסלײזער, ה׳.<verse eid="ISA 54:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 54:9" />װאָרעם דאָס געװיסער פֿון נֹח איז דאָס מיר:</para>
  <para style="q" vid="ISA 54:9">אַזױ װי איך האָב געשװאָרן אַז דאָס געװיסער פֿון נֹח</para>
  <para style="q" vid="ISA 54:9">זאָל מער נישט אַריבערגײן איבער דער ערד,</para>
  <para style="q" vid="ISA 54:9">אַזױ האָב איך געשװאָרן נישט צו צערענען אױף דיר,</para>
  <para style="q" vid="ISA 54:9">און נישט אָנצושרײַען אױף דיר.<verse eid="ISA 54:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 54:10" />װאָרעם די בערג מעגן זיך אָפּטאָן,</para>
  <para style="q" vid="ISA 54:10">און די הײכן מעגן זיך װאַקלען,</para>
  <para style="q" vid="ISA 54:10">אָבער מײַן גענאָד װעט זיך פֿון דיר נישט אָפּטאָן,</para>
  <para style="q" vid="ISA 54:10">און מײַן ברית פֿון שלום װעט זיך נישט װאַקלען,</para>
  <para style="q" vid="ISA 54:10">זאָגט דײַן דערבאַרעמער, ה׳.<verse eid="ISA 54:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 54:11" />דו אָרימע, פֿון שטורעם געטריבענע, דו נישט געטרײסטע,</para>
  <para style="q" vid="ISA 54:11">זע, איך לײג אױס דײַנע שטײנער אין פֿאַרבן,</para>
  <para style="q" vid="ISA 54:11">און װעל דיך גרונטפֿעסטן מיט סאַפּירשטײנער.<verse eid="ISA 54:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 54:12" />און איך װעל מאַכן דײַנע טורעמשפּיצן פֿון רובין,</para>
  <para style="q" vid="ISA 54:12">און דײַנע טױערן פֿון גאַרפֿונקלשטײנער,</para>
  <para style="q" vid="ISA 54:12">און דײַן גאַנצן געמאַרק פֿון גלוסטיקע שטײנער.<verse eid="ISA 54:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 54:13" />און אַלע דײַנע קינדער װעלן זײַן געלערנטע פֿון ה׳;</para>
  <para style="q" vid="ISA 54:13">און גרױס װעט זײַן דער שלום פֿון דײַנע קינדער.<verse eid="ISA 54:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 54:14" />אױף גערעכטיקײט װעסטו אױפֿגעשטעלט װערן;</para>
  <para style="q" vid="ISA 54:14">זײַ װײַט פֿון דריקונג,</para>
  <para style="q" vid="ISA 54:14">װאָרעם דאַרפֿסט נישט מורא האָבן,</para>
  <para style="q" vid="ISA 54:14">און פֿון אַ בראָך,</para>
  <para style="q" vid="ISA 54:14">װאָרעם ער װעט נישט גענענען צו דיר.<verse eid="ISA 54:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 54:15" />זע, זאַמלען מעג מען זיך זאַמלען, אָבער אָן מײַן װילן;</para>
  <para style="q" vid="ISA 54:15">װער עס זאַמלט זיך אױף דיר, װעט פֿאַלן פֿון װעגן דיר.<verse eid="ISA 54:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 54:16" />זע, איך האָב באַשאַפֿן דעם מײַנסטער,</para>
  <para style="q" vid="ISA 54:16">װאָס בלאָזט אין דעם קױלפֿײַער,</para>
  <para style="q" vid="ISA 54:16">און ברענגט אַרױס אַ געצײַג פֿאַר זײַן אַרבעט;</para>
  <para style="q" vid="ISA 54:16">און איך האָב באַשאַפֿן דעם פֿאַרװיסטער צו צעשטערן.<verse eid="ISA 54:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 54:17" />איטלעך געצײַג װאָס װעט געפֿורעמט װערן</para>
  <para style="q" vid="ISA 54:17">קעגן דיר, װעט נישט געלינגען,</para>
  <para style="q" vid="ISA 54:17">און איטלעך צונג װאָס װעט זיך שטעלן אין משפּט מיט דיר,</para>
  <para style="q" vid="ISA 54:17">װעסטו שולדיק מאַכן.</para>
  <para style="q" vid="ISA 54:17">דאָס איז די אַרב פֿון די קנעכט פֿון ה׳,</para>
  <para style="q" vid="ISA 54:17">און זײער גערעכטער לױן פֿון מיר, זאָגט ה׳.<verse eid="ISA 54:17" /></para>
  <chapter eid="ISA 54" />
  <chapter number="55" style="c" pubnumber="נה" sid="ISA 55" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 55:1" />העי, אַלע דאָרשטיקע, קומט נאָך װאַסער,</para>
  <para style="q" vid="ISA 55:1">צו מאָל דער װאָס האָט נישט קײן געלט;</para>
  <para style="q" vid="ISA 55:1">קומט שאַפֿט אײַך אײַן און עסט,</para>
  <para style="q" vid="ISA 55:1">און קומט שאַפֿט אײַך אײַן אָן געלט</para>
  <para style="q" vid="ISA 55:1">און אָן געצאָלט װײַן און מילך.<verse eid="ISA 55:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 55:2" />נאָך װאָס זאָלט איר געלט צאָלן פֿאַר נישט-ברױט?</para>
  <para style="q" vid="ISA 55:2">און אײַער מי פֿאַר װאָס זעטיקט נישט?</para>
  <para style="q" vid="ISA 55:2">הערן הערט מיר צו, און עסט גוטס,</para>
  <para style="q" vid="ISA 55:2">און אײַער זעל װעט זיך קװיקן מיט פֿעטס.<verse eid="ISA 55:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 55:3" />נײַגט אײַער אױער, און קומט צו מיר,</para>
  <para style="q" vid="ISA 55:3">הערט, און אײַער זעל װעט לעבן;</para>
  <para style="q" vid="ISA 55:3">און איך װעל אײַך שליסן אַן אײביקן ברית,</para>
  <para style="q" vid="ISA 55:3">װי די געטרײַע חסדים צו דָוִדן.<verse eid="ISA 55:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 55:4" />זע, אַן עדות צו די פֿעלקער האָב איך אים געמאַכט,</para>
  <para style="q" vid="ISA 55:4">אַ פֿירשט און באַפֿעלער פֿון די אומות.<verse eid="ISA 55:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 55:5" />זע, אַ פֿאָלק װאָס דו קענסט נישט, װעסטו רופֿן,</para>
  <para style="q" vid="ISA 55:5">און אַ פֿאָלק װאָס קען דיך נישט, װעט לױפֿן צו דיר,</para>
  <para style="q" vid="ISA 55:5">פֿון װעגן ה׳ דײַן ג-ט,</para>
  <para style="q" vid="ISA 55:5">און צוליב דעם הײליקן פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="ISA 55:5">װײַל ער האָט דיך באַשײנט.<verse eid="ISA 55:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 55:6" />זוכט ה׳ װען ער קען געפֿונען װערן,</para>
  <para style="q" vid="ISA 55:6">רופֿט אים װען ער איז נאָנט.<verse eid="ISA 55:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 55:7" />זאָל דער רשע פֿאַרלאָזן זײַן װעג,</para>
  <para style="q" vid="ISA 55:7">און דער מאַן פֿון אומרעכט זײַנע טראַכטונגען;</para>
  <para style="q" vid="ISA 55:7">און זאָל ער זיך אומקערן צו ה׳,</para>
  <para style="q" vid="ISA 55:7">און ער װעט אים דערבאַרעמען,</para>
  <para style="q" vid="ISA 55:7">און צו אלוקינו, װאָרעם ער פֿאַרגיט אַ סך.<verse eid="ISA 55:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 55:8" />װאָרעם נישט מײַנע טראַכטונגען זײַנען אײַערע טראַכטונגען,</para>
  <para style="q" vid="ISA 55:8">און נישט אײַערע װעגן זײַנען מײַנע װעגן, זאָגט ה׳.<verse eid="ISA 55:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 55:9" />װאָרעם װי דער הימל איז העכער פֿון דער ערד,</para>
  <para style="q" vid="ISA 55:9">אַזױ זײַנען מײַנע װעגן העכער פֿון אײַערע װעגן,</para>
  <para style="q" vid="ISA 55:9">און מײַנע טראַכטונגען פֿון אײַערע טראַכטונגען.<verse eid="ISA 55:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 55:10" />װאָרעם אַזױ װי עס נידערט פֿון הימל</para>
  <para style="q" vid="ISA 55:10">דער רעגן און דער שנײ,</para>
  <para style="q" vid="ISA 55:10">און קערט זיך אַהין צו נישט אום,</para>
  <para style="q" vid="ISA 55:10">נײַערט ער טרינקט אָן די ערד,</para>
  <para style="q" vid="ISA 55:10">און באַפֿרוכט זי און באַשפּראָצט זי,</para>
  <para style="q" vid="ISA 55:10">און גיט זריעה צו דעם זײער,</para>
  <para style="q" vid="ISA 55:10">און ברױט צו דעם עסער;<verse eid="ISA 55:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 55:11" />אַזױ װעט זײַן מײַן װאָרט װאָס גײט אַרױס פֿון מײַן מױל:</para>
  <para style="q" vid="ISA 55:11">עס װעט זיך נישט אומקערן צו מיר לײדיק,</para>
  <para style="q" vid="ISA 55:11">נײַערט עס װעט טאָן װאָס איך האָב געװאָלט,</para>
  <para style="q" vid="ISA 55:11">און באַגליקן אום װאָס איך האָב עס געשיקט.<verse eid="ISA 55:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 55:12" />װאָרעם מיט שׂימחה װעט איר אַרױסגײן,</para>
  <para style="q" vid="ISA 55:12">און בשלום װעט איר געפֿירט װערן;</para>
  <para style="q" vid="ISA 55:12">די בערג און די הײכן</para>
  <para style="q" vid="ISA 55:12">װעלן אױסברעכן פֿאַר אײַך אין געזאַנג,</para>
  <para style="q" vid="ISA 55:12">און אַלע בײמער פֿון פֿעלד װעלן קלאַפּן די הענט.<verse eid="ISA 55:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 55:13" />אַנשטאָטן דאָרן װעט אױפֿגײן אַ ציפּרעס,</para>
  <para style="q" vid="ISA 55:13">און אַנשטאָטן װילדגעװעקס װעט אױפֿגײן אַ מירט;</para>
  <para style="q" vid="ISA 55:13">און עס װעט זײַן פֿאַר אַ נאָמען צו ה׳,</para>
  <para style="q" vid="ISA 55:13">פֿאַר אַן אײביקן צײכן װאָס װעט נישט פֿאַרשניטן װערן.<verse eid="ISA 55:13" /></para>
  <chapter eid="ISA 55" />
  <chapter number="56" style="c" pubnumber="נו" sid="ISA 56" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 56:1" />אַזױ האָט ה׳ געזאָגט:</para>
  <para style="q" vid="ISA 56:1">היט רעכט, און טוט גערעכטיקײט,</para>
  <para style="q" vid="ISA 56:1">װאָרעם נאָנט איז מײַן הילף צו קומען,</para>
  <para style="q" vid="ISA 56:1">און מײַן גערעכטיקײט זיך צו אַנטפּלעקן.<verse eid="ISA 56:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 56:2" />װױל צו דעם מאַן װאָס טוט דאָס דאָזיקע,</para>
  <para style="q" vid="ISA 56:2">און דעם מענטשנקינד װאָס האַלט זיך דעראָן!</para>
  <para style="q" vid="ISA 56:2">װאָס היט שבת, אים נישט צו פֿאַרשװעכן,</para>
  <para style="q" vid="ISA 56:2">און היט זײַן האַנט פֿון צו טאָן אַ שום בײז.<verse eid="ISA 56:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 56:3" />און נישט זאָגן זאָל דער פֿרעמד-געבאָרענער,</para>
  <para style="q" vid="ISA 56:3">װאָס באַהעפֿט זיך צו ה׳, אַזױ צו זאָגן:</para>
  <para style="q" vid="ISA 56:3">אָפּזונדערן װעט מיך אָפּזונדערן ה׳ פֿון זײַן פֿאָלק;</para>
  <para style="q" vid="ISA 56:3">און נישט זאָגן זאָל דער סָריס:</para>
  <para style="q" vid="ISA 56:3">זע, איך בין אַ טרוקענער בױם.<verse eid="ISA 56:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 56:4" />װאָרעם אַזױ האָט ה׳ געזאָגט</para>
  <para style="q" vid="ISA 56:4">אױף די סָריסים װאָס היטן מײַנע שבתים,</para>
  <para style="q" vid="ISA 56:4">און װײלן אױס דאָס װאָס איך װיל,</para>
  <para style="q" vid="ISA 56:4">און האַלטן זיך אָן מײַן ברית:<verse eid="ISA 56:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 56:5" />זײ װעל איך געבן אין מײַן הױז</para>
  <para style="q" vid="ISA 56:5">און אין מײַנע מױערן אַן אָנדענק און אַ נאָמען,</para>
  <para style="q" vid="ISA 56:5">בעסער פֿון זין און פֿון טעכטער;</para>
  <para style="q" vid="ISA 56:5">אַן אײביקן נאָמען װעל איך זײ געבן,</para>
  <para style="q" vid="ISA 56:5">װאָס װעט נישט פֿאַרשניטן װערן.<verse eid="ISA 56:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 56:6" />און די פֿרעמדגעבאָרענע װאָס באַהעפֿטן זיך צו ה׳,</para>
  <para style="q" vid="ISA 56:6">אים צו טאָן דינסט,</para>
  <para style="q" vid="ISA 56:6">און ליב צו האָבן דעם נאָמען פֿון ה׳,</para>
  <para style="q" vid="ISA 56:6">אים צו זײַן פֿאַר קנעכט;</para>
  <para style="q" vid="ISA 56:6">איטלעכער װאָס היט שבת אים נישט צו פֿאַרשװעכן,</para>
  <para style="q" vid="ISA 56:6">און װאָס האַלטן מײַן ברית.<verse eid="ISA 56:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 56:7" />זײ װעל איך ברענגען צו מײַן הײליקן באַרג,</para>
  <para style="q" vid="ISA 56:7">און װעל זײ דערפֿרײען אין מײַן הױז פֿון געבעט;</para>
  <para style="q" vid="ISA 56:7">זײערע בראַנדאָפּפֿער און זײערע שלאַכטאָפּפֿער</para>
  <para style="q" vid="ISA 56:7">װעלן זײַן צו באַװיליקונג אױף מײַן מזבח;</para>
  <para style="q" vid="ISA 56:7">װאָרעם מײַן הױז װעט גערופֿן װערן</para>
  <para style="q" vid="ISA 56:7">דאָס הױז פֿון געבעט פֿאַר אַלע פֿעלקער.<verse eid="ISA 56:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 56:8" />אַזױ זאָגט אֲדֹנָי ה׳,</para>
  <para style="q" vid="ISA 56:8">דער װאָס זאַמלט אײַן די פֿאַרשטױסענע פֿון יִשׂרָאֵל זאָגט:</para>
  <para style="q" vid="ISA 56:8">איך װעל נאָך אײַנזאַמלען צו אים,</para>
  <para style="q" vid="ISA 56:8">צו זײַנע געזאַמעלטע.<verse eid="ISA 56:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 56:9" />אַלע חיות פֿון פֿעלד, קומט אַהער עסן,</para>
  <para style="q" vid="ISA 56:9">אַלע חיות אין װאַלד!<verse eid="ISA 56:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 56:10" />זײַנע װעכטער זײַנען בלינדע אַלע,</para>
  <para style="q" vid="ISA 56:10">זײ װײסן גאָרניט;</para>
  <para style="q" vid="ISA 56:10">שטומע הינט זײַנען זײ אַלע, זײ קענען נישט בילן;</para>
  <para style="q" vid="ISA 56:10">זײ ליגן און חלומען, זײ האָבן ליב שלאָפֿן.<verse eid="ISA 56:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 56:11" />און די הינט זײַנען װילד זשעדנע, זײ װײסן נישט פֿון זעט;</para>
  <para style="q" vid="ISA 56:11">און יענע זײַנען פּאַסטוכער װאָס װײסן נישט אַכט צו געבן;</para>
  <para style="q" vid="ISA 56:11">זײ אַלע קערן זיך צו זײער װעג,</para>
  <para style="q" vid="ISA 56:11">איטלעכער צו זײַן גײַציקײט, פֿון עק צו עק.<verse eid="ISA 56:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 56:12" />קומט, איך װעל ברענגען װײַן,</para>
  <para style="q" vid="ISA 56:12">און לאָמיר זױפֿן דעם טרונק;</para>
  <para style="q" vid="ISA 56:12">און װי דער אַזױ זאָל זײַן מאָרגעדיקער טאָג,</para>
  <para style="q" vid="ISA 56:12">און גרעסער נאָך פֿיל.<verse eid="ISA 56:12" /></para>
  <chapter eid="ISA 56" />
  <chapter number="57" style="c" pubnumber="נז" sid="ISA 57" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 57:1" />דער גערעכטער גײט אונטער,</para>
  <para style="q" vid="ISA 57:1">און קײן מענטש נעמט נישט צום האַרצן,</para>
  <para style="q" vid="ISA 57:1">און פֿרומע לײַט װערן אַװעקגענומען,</para>
  <para style="q" vid="ISA 57:1">און קײנער באַטראַכט נישט, אַז פֿון װעגן דער שלעכטיקײט</para>
  <para style="q" vid="ISA 57:1">איז אַװעקגענומען געװאָרן דער גערעכטער.<verse eid="ISA 57:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 57:2" />ער גײט צו זײַן פֿריד;</para>
  <para style="q" vid="ISA 57:2">אױף זײערע קבֿר-געלעגערס רוען</para>
  <para style="q" vid="ISA 57:2">די װאָס זײַנען געגאַנגען אין זײער ערלעכקײט.<verse eid="ISA 57:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 57:3" />און איר גענענט אַהער,</para>
  <para style="q" vid="ISA 57:3">זין פֿון אַ כּישופֿמאַכערין,</para>
  <para style="q" vid="ISA 57:3">זאָמען פֿון אַ נואף און אַ זוֹנה.<verse eid="ISA 57:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 57:4" />אױף װעמען מאַכט איר אײַך לוסטיק?</para>
  <para style="q" vid="ISA 57:4">אױף װעמען רײַסט איר אױף דאָס מױל,</para>
  <para style="q" vid="ISA 57:4">שטעקט איר אַרױס אַ צונג?</para>
  <para style="q" vid="ISA 57:4">פֿאַר װאָר, איר זײַט קינדער פֿון פֿאַרברעך,</para>
  <para style="q" vid="ISA 57:4">זאָמען פֿון ליגן,<verse eid="ISA 57:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 57:5" />איר װאָס דערהיצט אײַך צװישן די אײכנבײמער,</para>
  <para style="q" vid="ISA 57:5">אונטער יעטװעדער צװײַגהאַפֿטיקן בױם;</para>
  <para style="q" vid="ISA 57:5">װאָס שעכט די קינדער אין די טאָלן,</para>
  <para style="q" vid="ISA 57:5">אונטער די שפּאַלטן פֿון די פֿעלדזן.<verse eid="ISA 57:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 57:6" />צװישן די גלאַטע שטײנער פֿון טאָל איז דײַן טײל,</para>
  <para style="q" vid="ISA 57:6">זײ, זײ זײַנען דײַן גורל;</para>
  <para style="q" vid="ISA 57:6">צו זײ אױך האָסטו געגאָסן גיסאָפּפֿער,</para>
  <para style="q" vid="ISA 57:6">האָסטו אױפֿגעבראַכט שפּײַזאָפּפֿער.</para>
  <para style="q" vid="ISA 57:6">זאָל איך װעגן דעם זיך באַרוען?<verse eid="ISA 57:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 57:7" />אױף אַ הױכן און דערהױבענעם באַרג</para>
  <para style="q" vid="ISA 57:7">האָסטו דײַן געלעגער געמאַכט;</para>
  <para style="q" vid="ISA 57:7">אַהין אױך ביסטו אַרױפֿגעגאַנגען שלאַכטאָפּפֿער צו שלאַכטן.<verse eid="ISA 57:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 57:8" />און הינטער דער טיר און דעם מְזוּזָה</para>
  <para style="q" vid="ISA 57:8">האָסטו אַרױפֿגעטאָן דײַן דערמאָנצײכן,</para>
  <para style="q" vid="ISA 57:8">װאָרעם פֿון מיר ביסטו אָפֿן אַװעקגעגאַנגען;</para>
  <para style="q" vid="ISA 57:8">האָסט ברײט געמאַכט דײַן געלעגער,</para>
  <para style="q" vid="ISA 57:8">און האָסט דיר מיט זײ אַ בונד געמאַכט</para>
  <para style="q" vid="ISA 57:8">װאָס דו האָסט זײער געלעגער ליב געהאַט,</para>
  <para style="q" vid="ISA 57:8">זײער האַנט געזען.<verse eid="ISA 57:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 57:9" />און ביסט געגאַנגען צום מלך מיט זאַלב,</para>
  <para style="q" vid="ISA 57:9">און האָסט געמערט דײַנע בשׂמים;</para>
  <para style="q" vid="ISA 57:9">און האָסט געשיקט דײַנע שלוחים ביז אין דער װײַט,</para>
  <para style="q" vid="ISA 57:9">און ביז אין שְׁאֹול געמאַכט נידערן.<verse eid="ISA 57:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 57:10" />פֿון דײַנע פֿיל װעגן ביסטו מיד געװאָרן,</para>
  <para style="q" vid="ISA 57:10">אָבער האָסט נישט געזאָגט: פֿאַרפֿאַלן!</para>
  <para style="q" vid="ISA 57:10">שטאַרקײט אין דײַן האַנט האָסטו געפֿונען,</para>
  <para style="q" vid="ISA 57:10">דערום האָסטו זיך נישט געקימערט.<verse eid="ISA 57:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 57:11" />און פֿאַר װעמען האָסטו זיך געשראָקן און מורא געהאַט,</para>
  <para style="q" vid="ISA 57:11">אַז דו זאָלסט זיך פֿאַרשטעלן?</para>
  <para style="q" vid="ISA 57:11">אַז אָן מיר האָסטו נישט געדאַכט,</para>
  <para style="q" vid="ISA 57:11">נישט גענומען זיך צום האַרצן;</para>
  <para style="q" vid="ISA 57:11">פֿאַר װאָר, איך שװײַג, און פֿון אײביק אָן,</para>
  <para style="q" vid="ISA 57:11">דערום האָסטו נישט מורא פֿאַר מיר.<verse eid="ISA 57:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 57:12" />װעל איך דערצײלן דײַן גערעכטיקײט,</para>
  <para style="q" vid="ISA 57:12">און דײַנע מעשׂים, זײ װעלן דיר נישט גוטס טאָן.<verse eid="ISA 57:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 57:13" />אַז דו שרײַסט, זאָלן דײַנע געזעמלען דיך מציל זײַן;</para>
  <para style="q" vid="ISA 57:13">אָבער זײ אַלעמען װעט דער װינט אַװעקטראָגן,</para>
  <para style="q" vid="ISA 57:13">װעט אַ הױך אַװעקנעמען;</para>
  <para style="q" vid="ISA 57:13">און דער װאָס באַשיצט זיך אין מיר װעט אַרבן דאָס לאַנד,</para>
  <para style="q" vid="ISA 57:13">און יַרשען מײַן הײליקן באַרג.<verse eid="ISA 57:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 57:14" />און ער װעט זאָגן:</para>
  <para style="q" vid="ISA 57:14">טרעט אױס, טרעט אױס, ראַמט אָפּ דעם װעג,</para>
  <para style="q" vid="ISA 57:14">הײבט אױף די שטרױכלונג</para>
  <para style="q" vid="ISA 57:14">פֿון דעם װעג פֿון מײַן פֿאָלק.<verse eid="ISA 57:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 57:15" />װאָרעם אַזױ זאָגט דער הױכער און דערהױבענער,</para>
  <para style="q" vid="ISA 57:15">דער װאָס װױנט אין אײביקײט, און הײליק איז זײַן נאָמען:</para>
  <para style="q" vid="ISA 57:15">אין הױכקײט און הײליקײט טו איך רוען,</para>
  <para style="q" vid="ISA 57:15">אָבער אױך בײַם דערשלאָגענעם און געפֿאַלענעם אין געמיט,</para>
  <para style="q" vid="ISA 57:15">אױפֿצולעבן דאָס געמיט פֿון געפֿאַלענע,</para>
  <para style="q" vid="ISA 57:15">און אױפֿצולעבן דאָס האַרץ פֿון דערשלאָגענע.<verse eid="ISA 57:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 57:16" />װאָרעם נישט אײביק טו איך קריגן,</para>
  <para style="q" vid="ISA 57:16">און נישט תּמיד טו איך צערענען;</para>
  <para style="q" vid="ISA 57:16">װאָרעם דער גײַסט װאָס באַקלײדט זיך, איז פֿון מיר,</para>
  <para style="q" vid="ISA 57:16">און די נשמות האָב איך געמאַכט.<verse eid="ISA 57:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 57:17" />פֿאַר דער זינד פֿון זײַן גײַציקײט</para>
  <para style="q" vid="ISA 57:17">האָב איך געצערנט, און אים געשלאָגן,</para>
  <para style="q" vid="ISA 57:17">מיך פֿאַרבאָרגן און געצערנט,</para>
  <para style="q" vid="ISA 57:17">װײַל ער איז אָפּקערעריש געגאַנגען</para>
  <para style="q" vid="ISA 57:17">אין װעג פֿון זײַן האַרצן.<verse eid="ISA 57:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 57:18" />איך האָב געזען זײַנע װעגן,</para>
  <para style="q" vid="ISA 57:18">אָבער איך װעל אים הײלן, און װעל אים פֿירן,</para>
  <para style="q" vid="ISA 57:18">און װעל באַצאָלן נחמות</para>
  <para style="q" vid="ISA 57:18">אים און זײַנע טרױערער.<verse eid="ISA 57:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 57:19" />איך באַשאַף אַ ליפּנפֿרוכט:</para>
  <para style="q" vid="ISA 57:19">שלום, שלום צום נאָנטן און צום װײַטן!</para>
  <para style="q" vid="ISA 57:19">זאָגט ה׳,</para>
  <para style="q" vid="ISA 57:19">און איך װעל אים הײלן.<verse eid="ISA 57:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 57:20" />אָבער די רשעים זײַנען װי אַ ים אַ געטריבענער,</para>
  <para style="q" vid="ISA 57:20">װאָס קען זיך נישט אײַנשטילן,</para>
  <para style="q" vid="ISA 57:20">און זײַנע װאַסערן טרײַבן קױט און לײם.<verse eid="ISA 57:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 57:21" />נישטאָ קײן שלום, זאָגט מײַן ג-ט,</para>
  <para style="q" vid="ISA 57:21">פֿאַר די רשעים.<verse eid="ISA 57:21" /></para>
  <chapter eid="ISA 57" />
  <chapter number="58" style="c" pubnumber="נח" sid="ISA 58" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 58:1" />רוף מיט קעל, זאָלסט נישט צוריקהאַלטן,</para>
  <para style="q" vid="ISA 58:1">אַזױ װי אַ שופֿר הײב אױף דײַן קֹול,</para>
  <para style="q" vid="ISA 58:1">און זאָג מײַן פֿאָלק זײער פֿאַרברעך,</para>
  <para style="q" vid="ISA 58:1">און דעם הױז פֿון יעקבֿ זײערע זינד.<verse eid="ISA 58:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 58:2" />און זײ זוכן מיך נאָך טאָג פֿאַר טאָג,</para>
  <para style="q" vid="ISA 58:2">און װיסן מײַנע װעגן באַגערן זײ!</para>
  <para style="q" vid="ISA 58:2">אַזױ װי אַ פֿאָלק װאָס טוט גערעכטיקײט,</para>
  <para style="q" vid="ISA 58:2">און פֿאַרלאָזט נישט דאָס געזעץ פֿון זײַן ג-ט,</para>
  <para style="q" vid="ISA 58:2">פֿאַרלאַנגען זײ פֿון מיר משפּטים גערעכטע,</para>
  <para style="q" vid="ISA 58:2">די נאָנטקײט פֿון ה׳ באַגערן זײ.<verse eid="ISA 58:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 58:3" />פֿאַר װאָס פֿאַסטן מיר, און דו זעסט נישט?</para>
  <para style="q" vid="ISA 58:3">פּײַניקן מיר אונדזער זעל, און דו מערקסט נישט?</para>
  <para style="q" vid="ISA 58:3">זעט, אין טאָג פֿון אײַער פֿאַסטן געפֿינט איר אַן עסק,</para>
  <para style="q" vid="ISA 58:3">און אַלע אײַערע אַרבעטער טוט איר דריקן.<verse eid="ISA 58:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 58:4" />איר פֿאַסט דאָך נאָר פֿאַר קריג און שטרײַט,</para>
  <para style="q" vid="ISA 58:4">און צו שלאָגן מיטן פֿױסט פֿון אומרעכט;</para>
  <para style="q" vid="ISA 58:4">איר פֿאַסט נישט אין אַזאַ טאָג</para>
  <para style="q" vid="ISA 58:4">צו מאַכן הערן אין דער הײך אײַער קֹול.<verse eid="ISA 58:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 58:5" />איז אַזאַ דאָס פֿאַסטן װאָס איך האָב אױסגעװײלט?</para>
  <para style="q" vid="ISA 58:5">אַ טאָג פֿאַר אַ מענטשן צו פּײַניקן זײַן זעל?</para>
  <para style="q" vid="ISA 58:5">צו בײגן װי אַ װאַסערריטל זײַן קאָפּ,</para>
  <para style="q" vid="ISA 58:5">און זאַק און אַש זאָל ער זיך אױסבעטן?</para>
  <para style="q" vid="ISA 58:5">צי דאָס רופֿסטו פֿאַסטן,</para>
  <para style="q" vid="ISA 58:5">און אַ טאָג פֿון באַװיליקונג צו ה׳?<verse eid="ISA 58:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 58:6" />איז נישט דאָס דאָס פֿאַסטן װאָס איך האָב אױסגעװײלט:</para>
  <para style="q" vid="ISA 58:6">לױז מאַכן די קײטן פֿון אומרעכט,</para>
  <para style="q" vid="ISA 58:6">אָפּבינדן די בינדשטריק פֿון יאָך,</para>
  <para style="q" vid="ISA 58:6">און אַרױסלאָזן פֿרײַ די געדריקטע,</para>
  <para style="q" vid="ISA 58:6">און יעטװעדער יאָך זאָלט איר צעברעכן?<verse eid="ISA 58:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 58:7" />איז עס נישט, אָפּצוברעכן פֿון דײַן ברױט דעם הונגעריקן,</para>
  <para style="q" vid="ISA 58:7">און פֿאַרװאָגלטע אָרימע זאָלסטו אַרײַנברענגען אין הױז?</para>
  <para style="q" vid="ISA 58:7">אַז דו זעסט אַ נאַקעטן, זאָלסטו אים באַדעקן,</para>
  <para style="q" vid="ISA 58:7">און פֿון דײַן אײגן פֿלײש זאָלסטו זיך נישט פֿאַרהױלן?<verse eid="ISA 58:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 58:8" />דענצמאָל װעט אױסברעכן װי דער פֿרימאָרגן דײַן ליכט,</para>
  <para style="q" vid="ISA 58:8">און דײַן הײלונג װעט אַרױסשפּראָצן גיך;</para>
  <para style="q" vid="ISA 58:8">און דיר פֿאַרױס װעט גײן דײַן גערעכטיקײט,</para>
  <para style="q" vid="ISA 58:8">און די פּראַכט פֿון ה׳ װעט דיך נאָכבאַלײטן.<verse eid="ISA 58:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 58:9" />דענצמאָל װעסטו רופֿן, און ה׳ װעט ענטפֿערן;</para>
  <para style="q" vid="ISA 58:9">װעסט שרײַען, און ער װעט זאָגן: דאָ בין איך!</para>
  <para style="q" vid="ISA 58:9">אַז דו װעסט אָפּטאָן פֿון צװישן דיר פֿאַריאָכונג,</para>
  <para style="q" vid="ISA 58:9">טײטלען מיטן פֿינגער, און רעדן אומרעכט;<verse eid="ISA 58:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 58:10" />און װעסט אױסשטרעקן צום הונגעריקן דײַן זעל,</para>
  <para style="q" vid="ISA 58:10">און די געדריקטע זעל װעסטו זעטן;</para>
  <para style="q" vid="ISA 58:10">דענצמאָל װעט אױפֿשײַנען אין חושך דײַן ליכט,</para>
  <para style="q" vid="ISA 58:10">און דײַן פֿינצטערקײט װי מיטן טאָג.<verse eid="ISA 58:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 58:11" />און ה׳ װעט דיך פֿירן תּמיד,</para>
  <para style="q" vid="ISA 58:11">און װעט זעטן אין טריקענישן דײַן זעל,</para>
  <para style="q" vid="ISA 58:11">און דײַנע בײנער װעט ער שטאַרקן;</para>
  <para style="q" vid="ISA 58:11">און װעסט זײַן װי אַ גאָרטן אַן אָנגעטרונקענער,</para>
  <para style="q" vid="ISA 58:11">און װי אַן אױסגאַנג װאַסער</para>
  <para style="q" vid="ISA 58:11">װאָס זײַנע װאַסערן טוען נישט פֿעלשן.<verse eid="ISA 58:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 58:12" />און מע װעט אָפּבױען בײַ דיר אײביקע חורבֿות,</para>
  <para style="q" vid="ISA 58:12">גרונטפֿעסטן פֿון דור-דורות װעסטו אױפֿשטעלן;</para>
  <para style="q" vid="ISA 58:12">און מע װעט דיך רופֿן פֿאַרמױערער פֿון בראָכן,</para>
  <para style="q" vid="ISA 58:12">באַנײַער פֿון װעגן צום װױנען.<verse eid="ISA 58:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 58:13" />אַז דו װעסט אָפּהאַלטן צוליב שבת דײַן פֿוס,</para>
  <para style="q" vid="ISA 58:13">פֿון טאָן דײַנע עסקים אין מײַן הײליקן טאָג;</para>
  <para style="q" vid="ISA 58:13">און װעסט רופֿן שבת אַ תּענוג,</para>
  <para style="q" vid="ISA 58:13">דעם הײליקן פֿון ה׳, געערלעכט;</para>
  <para style="q" vid="ISA 58:13">און װעסט אים ערלעכן, נישט צו טאָן דײַנע גאַנגען,</para>
  <para style="q" vid="ISA 58:13">נישט צו געפֿינען דיר אַן עסק, אָדער אָפּרעדן אַ זאַך.<verse eid="ISA 58:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 58:14" />דענצמאָל װעסטו זיך קװיקן מיט ה׳,</para>
  <para style="q" vid="ISA 58:14">און איך װעל דיך אַרױפֿזעצן אױף די הײכן פֿון דער ערד,</para>
  <para style="q" vid="ISA 58:14">און דיך מאַכן עסן די אַרב פֿון דײַן פֿאָטער יעקבֿ;</para>
  <para style="q" vid="ISA 58:14">װאָרעם דאָס מױל פֿון ה׳ האָט גערעדט.<verse eid="ISA 58:14" /></para>
  <chapter eid="ISA 58" />
  <chapter number="59" style="c" pubnumber="נט" sid="ISA 59" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 59:1" />זעט, די האַנט פֿון ה׳ איז נישט קורץ צו העלפֿן,</para>
  <para style="q" vid="ISA 59:1">און זײַן אױער איז נישט שװער צו הערן;<verse eid="ISA 59:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 59:2" />נאָר אײַערע זינד פֿלעגן צעשײדן צװישן אײַך און אלוקיכם,</para>
  <para style="q" vid="ISA 59:2">און אײַערע חטאָים האָבן פֿאַרבאָרגן זײַן פּנים פֿון אײַך,</para>
  <para style="q" vid="ISA 59:2">נישט צוצוהערן.<verse eid="ISA 59:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 59:3" />װאָרעם אײַערע הענט זײַנען באַפֿלעקט מיט בלוט,</para>
  <para style="q" vid="ISA 59:3">און אײַערע פֿינגער מיט זינד;</para>
  <para style="q" vid="ISA 59:3">אײַערע ליפּן זאָגן ליגן,</para>
  <para style="q" vid="ISA 59:3">אײַערע צונג רעדט אומרעכט.<verse eid="ISA 59:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 59:4" />קײנער לאָדט נישט מיט גערעכטיקײט,</para>
  <para style="q" vid="ISA 59:4">און קײנער טענהט נישט מיט אמת;</para>
  <para style="q" vid="ISA 59:4">מע פֿאַרזיכערט זיך אױף נישט, און מע רעדט פֿאַלש,</para>
  <para style="q" vid="ISA 59:4">מע טראָגט אומגליק, און מע געבערט אומרעכט.<verse eid="ISA 59:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 59:5" />אײַער פֿון אַ שלאַנג בריִען זײ אױס,</para>
  <para style="q" vid="ISA 59:5">און שפּינװעבס טוען זײ װעבן;</para>
  <para style="q" vid="ISA 59:5">דער װאָס עסט פֿון זײערע אײַער שטאַרבט,</para>
  <para style="q" vid="ISA 59:5">און דאָס צעדריקטע ברעכט אױס אין אַן אָטערשלאַנג.<verse eid="ISA 59:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 59:6" />זײערע געװעבן זײַנען נישט אױף אַ בגד,</para>
  <para style="q" vid="ISA 59:6">און מען קען זיך נישט צודעקן מיט זײערע אַרבעט;</para>
  <para style="q" vid="ISA 59:6">זײערע אַרבעט איז אַרבעט פֿון אומרעכט,</para>
  <para style="q" vid="ISA 59:6">און אױפֿטו פֿון רױב איז אין זײערע הענט.<verse eid="ISA 59:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 59:7" />זײערע פֿיס לױפֿן צו שלעכטס,</para>
  <para style="q" vid="ISA 59:7">און זײ אײַלן צו פֿאַרגיסן אומשולדיק בלוט;</para>
  <para style="q" vid="ISA 59:7">זײערע טראַכטונגען זײַנען טראַכטונגען פֿון אומרעכט,</para>
  <para style="q" vid="ISA 59:7">פֿאַרװיסטונג און בראָך זײַנען אין זײערע שליאַכן.<verse eid="ISA 59:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 59:8" />דעם װעג פֿון שלום װײסן זײ נישט,</para>
  <para style="q" vid="ISA 59:8">און נישטאָ קײן גערעכטיקײט אין זײערע גענג;</para>
  <para style="q" vid="ISA 59:8">זײ האָבן פֿאַרקרימט זײערע שטעגן,</para>
  <para style="q" vid="ISA 59:8">קײנער װאָס טרעט דערױף װײס נישט פֿון שלום.<verse eid="ISA 59:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 59:9" />דערום איז גערעכטיקײט װײַט פֿון אונדז,</para>
  <para style="q" vid="ISA 59:9">און אונדז דערגרײכט נישט קײן הילף;</para>
  <para style="q" vid="ISA 59:9">מיר האָפֿן אױף ליכט, ערשט עס איז חושך,</para>
  <para style="q" vid="ISA 59:9">אױף שײַן, און מיר גײען אין פֿינצטערניש.<verse eid="ISA 59:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 59:10" />מיר טאַפּן װי בלינדע אָן דער װאַנט,</para>
  <para style="q" vid="ISA 59:10">און אַזױ װי אָן אױגן טאַפּן מיר אַרום;</para>
  <para style="q" vid="ISA 59:10">מיר שטרױכלען אין מיטן טאָג, װי אין אָװנט,</para>
  <para style="q" vid="ISA 59:10">מיר זײַנען צװישן געזונטע אַזױ װי די מתים.<verse eid="ISA 59:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 59:11" />מיר ברומען װי די בערן אַלע,</para>
  <para style="q" vid="ISA 59:11">און קלאָגן װי די טױבן קלאָגן מיר;</para>
  <para style="q" vid="ISA 59:11">מיר האָפֿן אױף גערעכטיקײט, און נישטאָ,</para>
  <para style="q" vid="ISA 59:11">אױף אַ ישועה, און זי איז װײַט פֿון אונדז.<verse eid="ISA 59:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 59:12" />װאָרעם פֿיל זײַנען אונדזערע פֿאַרברעכן פֿאַר דיר,</para>
  <para style="q" vid="ISA 59:12">און אונדזערע חטאָים זאָגן עדות קעגן אונדז;</para>
  <para style="q" vid="ISA 59:12">װאָרעם אונדזערע פֿאַרברעכן זײַנען בײַ אונדז,</para>
  <para style="q" vid="ISA 59:12">און אונדזערע זינד – זײ װײסן מיר װױל:<verse eid="ISA 59:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 59:13" />ברעכן און לײקענען אָן ה׳,</para>
  <para style="q" vid="ISA 59:13">און זיך אָפּקערן פֿון הינטער אלוקינו,</para>
  <para style="q" vid="ISA 59:13">רעדן רױב און אָפּקערונג,</para>
  <para style="q" vid="ISA 59:13">טראָגן און אַרױסברענגען פֿון האַרצן פֿאַלשע רײד.<verse eid="ISA 59:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 59:14" />און אָפּגעטרעטן אַהינטער איז גערעכטיקײט,</para>
  <para style="q" vid="ISA 59:14">און רעכטפֿאַרטיקײט שטײט פֿון דער װײַטן,</para>
  <para style="q" vid="ISA 59:14">װאָרעם געשטרױכלט אין גאַס איז דער אמת,</para>
  <para style="q" vid="ISA 59:14">און ערלעכקײט קען נישט אַרײַנקומען.<verse eid="ISA 59:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 59:15" />און דער אמת פֿעלט,</para>
  <para style="q" vid="ISA 59:15">און דער װאָס קערט זיך אָפּ פֿון בײז,</para>
  <para style="q" vid="ISA 59:15">װערט פֿאַר משוגע געהאַלטן.</para>
  <para style="b" vid="ISA 59:15" />
  <para style="q" vid="ISA 59:15">און ה׳ האָט געזען,</para>
  <para style="q" vid="ISA 59:15">און עס איז געװען שלעכט אין זײַנע אױגן,</para>
  <para style="q" vid="ISA 59:15">װאָס קײן גערעכטיקײט איז נישטאָ.<verse eid="ISA 59:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 59:16" />און ער האָט געזען, אַז קײן מענטש איז נישטאָ,</para>
  <para style="q" vid="ISA 59:16">און זיך פֿאַרװוּנדערט, װאָס קײנער שטעלט זיך נישט אײַן;</para>
  <para style="q" vid="ISA 59:16">האָט אים זײַן אָרעם געהאָלפֿן,</para>
  <para style="q" vid="ISA 59:16">און זײַן גערעכטיקײט, זי האָט אים אונטערגעלענט.<verse eid="ISA 59:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 59:17" />און ער האָט אָנגעטאָן גערעכטיקײט װי אַ שילד,</para>
  <para style="q" vid="ISA 59:17">און אַ קיװער פֿון הילף אױף זײַן קאָפּ;</para>
  <para style="q" vid="ISA 59:17">און ער האָט אָנגעטאָן קלײדער פֿון נקמה צום מלבוש,</para>
  <para style="q" vid="ISA 59:17">און זיך אײַנגעװיקלט װי אין אַ מאַנטל אין צאָרן.<verse eid="ISA 59:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 59:18" />אַזױ װי נאָך די טוּונגען, אַזױערנאָך װעט ער באַצאָלן,</para>
  <para style="q" vid="ISA 59:18">גרימצאָרן צו זײַנע פֿײַנט, פֿאַרגעלטונג צו זײַנע שׂונאים;</para>
  <para style="q" vid="ISA 59:18">צו די אינדזלען װעט ער פֿאַרגעלטונג באַצאָלן.<verse eid="ISA 59:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 59:19" />און מע װעט מורא האָבן פֿאַרן נאָמען ה׳ פֿון מערבֿ,</para>
  <para style="q" vid="ISA 59:19">און פֿון אױפֿגאַנג פֿון זון פֿאַר זײַן כּבֿוד;</para>
  <para style="q" vid="ISA 59:19">װאָרעם דער פֿײַנט װעט אַרײַנקומען װי אַ טײַך,</para>
  <para style="q" vid="ISA 59:19">און דער רוּחַ פֿון ה׳ װעט זיך אױפֿהײבן אַ פֿאָן קעגן אים.<verse eid="ISA 59:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 59:20" />און דער אױסלײזער װעט קומען צו צִיוֹן,</para>
  <para style="q" vid="ISA 59:20">און צו אים װאָס טוען אַװעקנעמען זינד אין יעקבֿ,</para>
  <para style="q" vid="ISA 59:20">זאָגט ה׳.<verse eid="ISA 59:20" /></para>
  <para style="b" />
  <para style="m">
    <verse number="21" style="v" sid="ISA 59:21" />און איך – דאָס איז מײַן ברית מיט זײ, זאָגט ה׳: מײַן גײַסט װאָס אױף דיר, און מײַנע װערטער װאָס איך האָב אַרײַנגעטאָן אין דײַן מױל, װעלן זיך נישט אָפּטאָן פֿון דײַן מױל, און פֿון דעם מױל פֿון דײַנע קינדער, און פֿון דעם מױל פֿון דײַנע קינדס-קינדער, זאָגט ה׳, פֿון אַצונד און ביז אײביק.<verse eid="ISA 59:21" /></para>
  <chapter eid="ISA 59" />
  <chapter number="60" style="c" pubnumber="ס" sid="ISA 60" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 60:1" />שטײ אױף, לײַכט אױף, װאָרעם דײַן ליכט איז געקומען,</para>
  <para style="q" vid="ISA 60:1">און די פּראַכט פֿון ה׳ שײַנט אױף איבער דיר.<verse eid="ISA 60:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 60:2" />װאָרעם זע, פֿינצטערניש װעט באַדעקן די ערד,</para>
  <para style="q" vid="ISA 60:2">און אַ נעבל די פֿעלקער,</para>
  <para style="q" vid="ISA 60:2">אָבער אױף דיר װעט אױפֿשײַנען ה׳,</para>
  <para style="q" vid="ISA 60:2">און זײַן פּראַכט װעט זיך װײַזן אױף דיר.<verse eid="ISA 60:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 60:3" />און פֿעלקער װעלן גײן פֿאַר דײַן ליכט,</para>
  <para style="q" vid="ISA 60:3">און מלכים פֿאַר דער העלקײט פֿון דײַן שײַן.<verse eid="ISA 60:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 60:4" />הײב אױף רונד אַרום דײַנע אױגן, און זע:</para>
  <para style="q" vid="ISA 60:4">זײ אַלע זײַנען אײַנגעזאַמלט, זײ קומען צו דיר:</para>
  <para style="q" vid="ISA 60:4">דײַנע זין קומען אָן פֿון דער װײַט,</para>
  <para style="q" vid="ISA 60:4">און דײַנע טעכטער װערן אױפֿן זײַט געטראָגן.<verse eid="ISA 60:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 60:5" />דענצמאָל װעסטו זען און װעסט לײַכטן,</para>
  <para style="q" vid="ISA 60:5">און ציטערן און ברײט װערן װעט דײַן האַרץ;</para>
  <para style="q" vid="ISA 60:5">װאָרעם איבערגײן צו דיר װעט די רײַכקײט פֿון ים,</para>
  <para style="q" vid="ISA 60:5">דער פֿאַרמעג פֿון די פֿעלקער װעט קומען צו דיר.<verse eid="ISA 60:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 60:6" />אַ שפֿע פֿון קעמלען װעט דיך באַדעקן,</para>
  <para style="q" vid="ISA 60:6">יונגקעמלען פֿון מִדיָן און עֵיפֿה,</para>
  <para style="q" vid="ISA 60:6">אַלע פֿון שבֿאָ געקומען;</para>
  <para style="q" vid="ISA 60:6">גאָלד און װײַרעך װעלן זײ טראָגן,</para>
  <para style="q" vid="ISA 60:6">און זײ װעלן מבֿשׂר זײַן דעם לױבן פֿון ה׳.<verse eid="ISA 60:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 60:7" />אַלע שאָף פֿון קֵדָר װעלן אײַנגעזאַמלט װערן צו דיר,</para>
  <para style="q" vid="ISA 60:7">די װידערס פֿון נבָֿיוֹת װעלן זײַן דיר צו דינסט;</para>
  <para style="q" vid="ISA 60:7">זײ װעלן אױפֿגײן מיט באַװיליקונג אױף מײַן מזבח;</para>
  <para style="q" vid="ISA 60:7">און מײַן הױז פֿון שײנקײט װעל איך באַשײנען.<verse eid="ISA 60:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 60:8" />װער זײַנען די דאָזיקע װאָס פֿליִען װי אַ װאָלקן,</para>
  <para style="q" vid="ISA 60:8">און װי די טױבן צו זײערע פֿענצטער?<verse eid="ISA 60:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 60:9" />פֿאַר װאָר, צו מיר װעלן די אינדזלען זיך האָפֿן,</para>
  <para style="q" vid="ISA 60:9">און די שיפֿן פֿון תַּרְשִיש צוערשט,</para>
  <para style="q" vid="ISA 60:9">צו ברענגען דײַנע קינדער פֿון דער װײַט,</para>
  <para style="q" vid="ISA 60:9">זײער גאָלד און זײער זילבער מיט זײ,</para>
  <para style="q" vid="ISA 60:9">צום נאָמען פֿון ה׳ דײַן ג-ט,</para>
  <para style="q" vid="ISA 60:9">און צום הײליקן פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="ISA 60:9">װײַל ער האָט דיך באַשײנט.<verse eid="ISA 60:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 60:10" />און פֿרעמדגעבאָרענע װעלן בױען דײַנע מױערן,</para>
  <para style="q" vid="ISA 60:10">און זײערע מלכים װעלן דיך באַדינען;</para>
  <para style="q" vid="ISA 60:10">װאָרעם אין מײַן צאָרן האָב איך דיך געשלאָגן,</para>
  <para style="q" vid="ISA 60:10">און אין מײַן באַװיליקונג האָב איך דיך דערבאַרעמט.<verse eid="ISA 60:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 60:11" />און אָפֿן װעלן זײַן דײַנע טױערן תּמיד,</para>
  <para style="q" vid="ISA 60:11">טאָג און נאַכט װעלן זײ נישט פֿאַרשלאָסן װערן,</para>
  <para style="q" vid="ISA 60:11">כּדי צו ברענגען דעם פֿאַרמעג פֿון די פֿעלקער צו דיר;</para>
  <para style="q" vid="ISA 60:11">און זײערע מלכים װעלן מיטפֿאָרן.<verse eid="ISA 60:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 60:12" />װאָרעם דאָס פֿאָלק און דאָס קיניגרײַך,</para>
  <para style="q" vid="ISA 60:12">װאָס װעלן דיר נישט דינען, װעלן אונטערגײן,</para>
  <para style="q" vid="ISA 60:12">און די פֿעלקער װעלן װיסט פֿאַרװיסט װערן.<verse eid="ISA 60:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 60:13" />די פּראַכט פֿון לבֿנוֹן װעט קומען צו דיר,</para>
  <para style="q" vid="ISA 60:13">ציפּרעס, טענענבױם, און בוקסנבױם אין אײנעם,</para>
  <para style="q" vid="ISA 60:13">צו באַשײנען דעם אָרט פֿון מײַן מִקדָש;</para>
  <para style="q" vid="ISA 60:13">און דעם אָרט פֿון מײַנע פֿיס װעל איך ערלעכן.<verse eid="ISA 60:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 60:14" />און געבױגן װעלן קומען צו דיר</para>
  <para style="q" vid="ISA 60:14">די זין פֿון דײַנע פּײַניקער,</para>
  <para style="q" vid="ISA 60:14">און בוקן זיך צו דײַנע פֿוסטריט</para>
  <para style="q" vid="ISA 60:14">װעלן אַלע דײַנע לעסטערער;</para>
  <para style="q" vid="ISA 60:14">און זײ װעלן דיך רופֿן די שטאָט פֿון ה׳,</para>
  <para style="q" vid="ISA 60:14">צִיוֹן פֿון דעם הײליקן פֿון יִשׂרָאֵל.<verse eid="ISA 60:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 60:15" />אַנשטאָט דײַן זײַן פֿאַרלאָזט און פֿאַרהאַסט,</para>
  <para style="q" vid="ISA 60:15">און אָן אַ דורכגײער,</para>
  <para style="q" vid="ISA 60:15">װעל איך דיך מאַכן צום אײביקן גרױסקײט,</para>
  <para style="q" vid="ISA 60:15">אַ פֿרײד אױף דור-דורות.<verse eid="ISA 60:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 60:16" />און װעסט זײגן דאָס מילך פֿון די פֿעלקער,</para>
  <para style="q" vid="ISA 60:16">און די ברוסט פֿון מלכים װעסטו זײגן;</para>
  <para style="q" vid="ISA 60:16">און דו װעסט װיסן אַז איך ה׳ בין דײַן העלפֿער,</para>
  <para style="q" vid="ISA 60:16">און דײַן דערלײזער, דער שטאַרקער פֿון יעקבֿ.<verse eid="ISA 60:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 60:17" />אַנשטאָטן קופּער װעל איך ברענגען גאָלד,</para>
  <para style="q" vid="ISA 60:17">און אַנשטאָטן אײַזן װעל איך ברענגען זילבער,</para>
  <para style="q" vid="ISA 60:17">און אַנשטאָט די האָלצן, קופּער,</para>
  <para style="q" vid="ISA 60:17">און אַנשטאָט די שטײנער, אײַזן;</para>
  <para style="q" vid="ISA 60:17">און איך װעל מאַכן פֿאַר דײַן אױפֿזעער שלום,</para>
  <para style="q" vid="ISA 60:17">און פֿאַר דײַנע הערשער גערעכטיקײט.<verse eid="ISA 60:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 60:18" />מער װעט נישט געהערט װערן רױב אין דײַן לאַנד</para>
  <para style="q" vid="ISA 60:18">פֿאַרװיסטונג און בראָך אין דײַנע געמאַרקן;</para>
  <para style="q" vid="ISA 60:18">און װעסט רופֿן דײַנע מױערן ישועה,</para>
  <para style="q" vid="ISA 60:18">און דײַנע טױערן לױב.<verse eid="ISA 60:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="ISA 60:19" />די זון װעט דיר מער נישט זײַן פֿאַר ליכט בײַ טאָג,</para>
  <para style="q" vid="ISA 60:19">און פֿאַר העלקײט װעט דיר נישט שײַנען די לבֿנה,</para>
  <para style="q" vid="ISA 60:19">נאָר ה׳ װעט דיר זײַן פֿאַר אַן אײביקן ליכט,</para>
  <para style="q" vid="ISA 60:19">און דײַן ג-ט פֿאַר דײַן שײנקײט.<verse eid="ISA 60:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 60:20" />נישט אונטערגײן װעט דײַן זון מער,</para>
  <para style="q" vid="ISA 60:20">און דײַן לבֿנה װעט נישט אײַנגעטאָן װערן,</para>
  <para style="q" vid="ISA 60:20">װאָרעם ה׳ װעט דיר זײַן פֿאַר אַן אײביקן ליכט,</para>
  <para style="q" vid="ISA 60:20">און געענדיקט װעלן זײַן די טעג פֿון דײַן טרױער.<verse eid="ISA 60:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 60:21" />און דײַן פֿאָלק װעלן זײַן אַלע גערעכטע,</para>
  <para style="q" vid="ISA 60:21">אױף אײביק װעלן זײ אַרבן דאָס לאַנד –</para>
  <para style="q" vid="ISA 60:21">דער צװײַג פֿון מײַן פֿלאַנצונג,</para>
  <para style="q" vid="ISA 60:21">דאָס װערק פֿון מײַנע הענט זיך צום רימען.<verse eid="ISA 60:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 60:22" />דער קלענסטער װעט װערן צו טױזנט,</para>
  <para style="q" vid="ISA 60:22">און דער מינדסטער צום מאַכטיקן פֿאָלק;</para>
  <para style="q" vid="ISA 60:22">איך ה׳ װעל דאָס אײַלן אין זײַן צײַט.<verse eid="ISA 60:22" /></para>
  <chapter eid="ISA 60" />
  <chapter number="61" style="c" pubnumber="סא" sid="ISA 61" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 61:1" />דער גײַסט פֿון אֲדֹנָי ה׳ איז אױף מיר,</para>
  <para style="q" vid="ISA 61:1">װײַל ה׳ האָט מיך געזאַלבט</para>
  <para style="q" vid="ISA 61:1">צו ברענגען בשׂורה צו די פֿאַרליטענע;</para>
  <para style="q" vid="ISA 61:1">מיך געשיקט צו פֿאַרבינדן די צעבראָכענע הערצער,</para>
  <para style="q" vid="ISA 61:1">אױסצורופֿן פֿרײַשאַפֿט צו די געפֿאַנגענע,</para>
  <para style="q" vid="ISA 61:1">און לױזלאָזונג צו די געבונדענע;<verse eid="ISA 61:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 61:2" />אױסצורופֿן אַ יאָר פֿון באַװיליקונג פֿון ה׳,</para>
  <para style="q" vid="ISA 61:2">און אַ טאָג פֿון נקמה פֿון אלוקינו;</para>
  <para style="q" vid="ISA 61:2">צו טרײסטן אַלע טרױערער;<verse eid="ISA 61:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 61:3" />צו באַשערן די טרױערער פֿון צִיוֹן,</para>
  <para style="q" vid="ISA 61:3">זײ צו געבן אַ הױב אַנשטאָט שטױב,</para>
  <para style="q" vid="ISA 61:3">אײל פֿון פֿרײד אַנשטאָט טרױער,</para>
  <para style="q" vid="ISA 61:3">אַ מאַנטל פֿון לױב אַנשטאָט אַ באַטריבט געמיט;</para>
  <para style="q" vid="ISA 61:3">און מע װעט זײ רופֿן די אײכנבײמער פֿון גערעכטיקײט,</para>
  <para style="q" vid="ISA 61:3">די פֿלאַנצונג פֿון ה׳ זיך צום רימען.<verse eid="ISA 61:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 61:4" />און זײ װעלן אָפּבױען אײביקע חורבֿות,</para>
  <para style="q" vid="ISA 61:4">װיסטענישן פֿון פֿאַרצײַטן װעלן זײ אױפֿריכטן,</para>
  <para style="q" vid="ISA 61:4">און זײ װעלן באַנײַען חרבֿע שטעט,</para>
  <para style="q" vid="ISA 61:4">װיסטענישן פֿון דור-דורות.<verse eid="ISA 61:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 61:5" />און פֿרעמדע װעלן שטײן און פֿיטערן אײַערע שאָף,</para>
  <para style="q" vid="ISA 61:5">און פֿרעמדגעבאָרענע װעלן זײַן</para>
  <para style="q" vid="ISA 61:5">אײַערע אַקערלײַט און אײַערע װײַנגערטנירער.<verse eid="ISA 61:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 61:6" />און איר װעט כּהנים פֿון ה׳ גערופֿן װערן,</para>
  <para style="q" vid="ISA 61:6">דינער פֿון אלוקינו װעט געזאָגט װערן אױף אײַך.</para>
  <para style="q" vid="ISA 61:6">דעם פֿאַרמעג פֿון די פֿעלקער װעט איר עסן,</para>
  <para style="q" vid="ISA 61:6">און זײער פּראַכט װעט איר איבערנעמען.<verse eid="ISA 61:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 61:7" />פֿאַר אײַער טאָפּעלער בושה,</para>
  <para style="q" vid="ISA 61:7">און װײַל מע פֿלעגט זינגען: שאַנד איז זײער חלק,</para>
  <para style="q" vid="ISA 61:7">דערום װעלן זײ יַרשען טאָפּל אין זײער לאַנד;</para>
  <para style="q" vid="ISA 61:7">אַן אײביקע פֿרײד װעט בײַ זײ זײַן.<verse eid="ISA 61:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 61:8" />װאָרעם איך ה׳ האָב ליב גערעכטיקײט;</para>
  <para style="q" vid="ISA 61:8">איך האָב פֿײַנט גזלה מיט אומרעכט,</para>
  <para style="q" vid="ISA 61:8">און איך װעל געבן װאָרהאַפֿטיק זײער לױן,</para>
  <para style="q" vid="ISA 61:8">און אַן אײביקן ברית װעל איך זײ שליסן.<verse eid="ISA 61:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 61:9" />און באַװוּסט בײַ די פֿעלקער װעט זײַן זײער זאָמען,</para>
  <para style="q" vid="ISA 61:9">און זײערע שפּראָצן צװישן די אומות;</para>
  <para style="q" vid="ISA 61:9">אַלע װאָס זעען זײ װעלן זײ דערקענען,</para>
  <para style="q" vid="ISA 61:9">אַז זײ זײַנען דער זאָמען װאָס ה׳ האָט געבענטשט.<verse eid="ISA 61:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 61:10" />פֿרײען פֿרײ איך זיך מיט ה׳,</para>
  <para style="q" vid="ISA 61:10">לוסטיק איז מײַן זעל מיט מײַן ג-ט,</para>
  <para style="q" vid="ISA 61:10">װאָרעם ער האָט מיר אָנגעטאָן קלײדער פֿון הילף,</para>
  <para style="q" vid="ISA 61:10">אַ מאַנטל פֿון גערעכטיקײט מיר אַרומגעװיקלט,</para>
  <para style="q" vid="ISA 61:10">װי אַ חתן טוט אָן אַ כּהן-הױב,</para>
  <para style="q" vid="ISA 61:10">און װי אַ כּלה צירט זיך אָן מיט אירע תַּכשיטין.<verse eid="ISA 61:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 61:11" />װאָרעם װי די ערד לאָזט אַרױס איר שפּראָצונג,</para>
  <para style="q" vid="ISA 61:11">און װי אַ גאָרטן מאַכט שפּראָצן זײַנע זאָמען,</para>
  <para style="q" vid="ISA 61:11">אַזױ װעט אֲדֹנָי ה׳ מאַכן שפּראָצן זיג און לױב,</para>
  <para style="q" vid="ISA 61:11">אַנטקעגן פֿאַר אַלע פֿעלקער.<verse eid="ISA 61:11" /></para>
  <chapter eid="ISA 61" />
  <chapter number="62" style="c" pubnumber="סב" sid="ISA 62" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 62:1" />פֿון װעגן צִיוֹן װעל איך נישט שװײַגן,</para>
  <para style="q" vid="ISA 62:1">און פֿון װעגן ירושָלַיִם װעל איך נישט רוען,</para>
  <para style="q" vid="ISA 62:1">ביז אַרױס װי דער שײַן װעט איר גערעכטיקײט,</para>
  <para style="q" vid="ISA 62:1">און איר הילף װי אַ פֿלאַם װאָס ברענט.<verse eid="ISA 62:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 62:2" />און די פֿעלקער װעלן זען דײַן גערעכטיקײט,</para>
  <para style="q" vid="ISA 62:2">און אַלע מלכים דײַן כּבֿוד;</para>
  <para style="q" vid="ISA 62:2">און מע װעט דיך רופֿן אַ נײַעם נאָמען,</para>
  <para style="q" vid="ISA 62:2">װאָס דאָס מױל פֿון ה׳ װעט אים אָנרופֿן.<verse eid="ISA 62:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 62:3" />און װעסט זײַן אַ קרױן פֿון שײנקײט</para>
  <para style="q" vid="ISA 62:3">אין דער האַנט פֿון ה׳,</para>
  <para style="q" vid="ISA 62:3">און אַ מַלכותדיקע הױב</para>
  <para style="q" vid="ISA 62:3">אין דער האַנטפֿלעך פֿון דײַן ג-ט.<verse eid="ISA 62:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 62:4" />אױף דיר װעט מער נישט געזאָגט װערן פֿאַרלאָזטע,</para>
  <para style="q" vid="ISA 62:4">און אױף דײַן לאַנד װעט מער נישט געזאָגט װערן װיסטעניש,</para>
  <para style="q" vid="ISA 62:4">נאָר דיך װעט מען רופֿן מײַן-גלוסט-צו-איר,</para>
  <para style="q" vid="ISA 62:4">און דאָס לאַנד דײַנס באַמאַנטע;</para>
  <para style="q" vid="ISA 62:4">װאָרעם ה׳ טוט דיך גלוסטן,</para>
  <para style="q" vid="ISA 62:4">און דײַן לאַנד װעט באַמאַנט װערן.<verse eid="ISA 62:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 62:5" />װאָרעם װי אַ בחור באַמאַנט אַ יונגפֿרױ,</para>
  <para style="q" vid="ISA 62:5">װעלן דיך באַמאַנען דײַנע קינדער;</para>
  <para style="q" vid="ISA 62:5">און װי די פֿרײד פֿון אַ חתן מיט דער כּלה,</para>
  <para style="q" vid="ISA 62:5">װעט זיך פֿרײען מיט דיר דײַן ג-ט.<verse eid="ISA 62:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 62:6" />אױף דײַנע מױערן, ירושָלַיִם, האָב איך אױפֿגעשטעלט שָומרים,</para>
  <para style="q" vid="ISA 62:6">אַ גאַנצן טאָג און אַ גאַנצע נאַכט, זײ זאָלן תּמיד נישט שװײַגן.</para>
  <para style="q" vid="ISA 62:6">איר דערמאָנער פֿון ה׳, קײן רו נישט צו אײַך!<verse eid="ISA 62:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 62:7" />און איר זאָלט נישט געבן קײן רו צו אים,</para>
  <para style="q" vid="ISA 62:7">ביז ער װעט אױפֿריכטן, און ביז ער װעט מאַכן ירושָלַיִם</para>
  <para style="q" vid="ISA 62:7">אַ לױב אױף דער ערד.<verse eid="ISA 62:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 62:8" />ה׳ האָט געשװאָרן בײַ זײַן רעכטער האַנט,</para>
  <para style="q" vid="ISA 62:8">און בײַ זײַן מאַכטיקן אָרעם:</para>
  <para style="q" vid="ISA 62:8">אױב איך װעל מער געבן דײַן תּבֿואה</para>
  <para style="q" vid="ISA 62:8">פֿאַר שפּײַז צו דײַנע פֿײַנט!</para>
  <para style="q" vid="ISA 62:8">און אױב פֿרעמדגעבאָרענע װעלן טרינקען דײַן װײַן</para>
  <para style="q" vid="ISA 62:8">װאָס דו האָסט זיך געמיט אױף אים!<verse eid="ISA 62:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 62:9" />נײַערט אירע אַרײַננעמער װעלן זי עסן,</para>
  <para style="q" vid="ISA 62:9">און װעלן לױבן ה׳;</para>
  <para style="q" vid="ISA 62:9">און זײַנע אײַנזאַמלער װעלן אים טרינקען</para>
  <para style="q" vid="ISA 62:9">אין די הױפֿן פֿון מײַן הײליקטום.<verse eid="ISA 62:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 62:10" />גײט דורך, גײט דורך דורך די טױערן,</para>
  <para style="q" vid="ISA 62:10">ראַמט אָפּ דעם װעג פֿון דעם פֿאָלק!</para>
  <para style="q" vid="ISA 62:10">טרעט אױס, טרעט אױס דעם שטעג,</para>
  <para style="q" vid="ISA 62:10">רײניקט אָפּ פֿון שטײנער!</para>
  <para style="q" vid="ISA 62:10">הײבט אױף אַ פֿאָן צו די פֿעלקער!<verse eid="ISA 62:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 62:11" />זע, ה׳ האָט געמאַכט הערן</para>
  <para style="q" vid="ISA 62:11">ביז צום עק פֿון דער ערד:</para>
  <para style="q" vid="ISA 62:11">זאָגט צו טאָכטער צִיוֹן: זע, דײַן הילף איז געקומען;</para>
  <para style="q" vid="ISA 62:11">זע, זײַן לױן איז מיט אים,</para>
  <para style="q" vid="ISA 62:11">און זײַן פֿאַרגעלטונג אים פֿאַרױס.<verse eid="ISA 62:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 62:12" />און מע װעט זײ רופֿן דאָס הײליקע פֿאָלק,</para>
  <para style="q" vid="ISA 62:12">די אױסדערלײזטע פֿון ה׳;</para>
  <para style="q" vid="ISA 62:12">און דיך װעט מען רופֿן געזוכטע,</para>
  <para style="q" vid="ISA 62:12">נישט פֿאַרלאָזענע שטאָט.<verse eid="ISA 62:12" /></para>
  <chapter eid="ISA 62" />
  <chapter number="63" style="c" pubnumber="סג" sid="ISA 63" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 63:1" />װער איז דער װאָס קומט פֿון אֶדוֹם,</para>
  <para style="q" vid="ISA 63:1">אין גערױטיקטע בגדים פֿון בָצרָה?</para>
  <para style="q" vid="ISA 63:1">דער װאָס איז פּראַכטיק אין זײַן מלבוש,</para>
  <para style="q" vid="ISA 63:1">אױסגעבױגן אין זײַן גרױס שטאַרקײט?</para>
  <para style="q" vid="ISA 63:1">איך װאָס רעד מיט גערעכטיקײט,</para>
  <para style="q" vid="ISA 63:1">װאָס בין מאַכטיק צו העלפֿן.<verse eid="ISA 63:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 63:2" />פֿאַר װאָס איז רױט אױף דײַן קלײד,</para>
  <para style="q" vid="ISA 63:2">און דײַנע בגדים װי בײַם טרעטער אין אַ קעלטער?<verse eid="ISA 63:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 63:3" />איך האָב געטרעטן אַ קעלטער אַלײן,</para>
  <para style="q" vid="ISA 63:3">און פֿון די פֿעלקער איז קײנער מיט מיר נישט געװען;</para>
  <para style="q" vid="ISA 63:3">און איך האָב זײ געטרעטן אין מײַן כּעס,</para>
  <para style="q" vid="ISA 63:3">און זײ געטראַמפּלט אין מײַן גרימצאָרן;</para>
  <para style="q" vid="ISA 63:3">האָט געשפּריצט זײער זאַפֿט אױף מײַנע בגדים,</para>
  <para style="q" vid="ISA 63:3">און אַלע מײַנע קלײדער האָב איך באַפֿלעקט.<verse eid="ISA 63:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 63:4" />װאָרעם אַ טאָג פֿון נקמה איז אין מײַן האַרצן,</para>
  <para style="q" vid="ISA 63:4">און מײַן יאָר פֿון דערלײזונג איז געקומען.<verse eid="ISA 63:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 63:5" />און איך האָב מיך אומגעקוקט,</para>
  <para style="q" vid="ISA 63:5">און נישט געװען קײן העלפֿער,</para>
  <para style="q" vid="ISA 63:5">און איך האָב מיך געװוּנדערט,</para>
  <para style="q" vid="ISA 63:5">און נישט געװען קײן אונטערלענער;</para>
  <para style="q" vid="ISA 63:5">האָט מיך מײַן אָרעם געהאָלפֿן,</para>
  <para style="q" vid="ISA 63:5">און מײַן גרימצאָרן, ער האָט מיך אונטערגעלענט.<verse eid="ISA 63:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 63:6" />און איך האָב געטרעטן די פֿעלקער אין מײַן כּעס,</para>
  <para style="q" vid="ISA 63:6">און זײ פֿאַרשיכּורט מיט מײַן גרימצאָרן,</para>
  <para style="q" vid="ISA 63:6">און געמאַכט נידערן צו דער ערד זײער זאַפֿט.<verse eid="ISA 63:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 63:7" />די חסדים פֿון ה׳ װעל איך דערמאָנען,</para>
  <para style="q" vid="ISA 63:7">די לױבונגען פֿון ה׳,</para>
  <para style="q" vid="ISA 63:7">װעדליק אַלץ װאָס ה׳ האָט אונדז געטאָן,</para>
  <para style="q" vid="ISA 63:7">און די פֿיל טובֿות צום הױז פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="ISA 63:7">װאָס ער האָט געטאָן צו זײ לױט זײַן באַרעמהאַרציקײט,</para>
  <para style="q" vid="ISA 63:7">און לױט זײַנע פֿיל חסדים.<verse eid="ISA 63:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 63:8" />װאָרעם ער האָט געזאָגט: זײ זײַנען פֿאָרט מײַן פֿאָלק,</para>
  <para style="q" vid="ISA 63:8">קינדער װאָס װעלן נישט פֿעלשן;</para>
  <para style="q" vid="ISA 63:8">און ער איז זײ געװען פֿאַר אַ העלפֿער.<verse eid="ISA 63:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 63:9" />אין אַל זײער לײַד האָט ער געליטן,</para>
  <para style="q" vid="ISA 63:9">און דער מלאך פֿון זײַן פּנים האָט זײ געהאָלפֿן;</para>
  <para style="q" vid="ISA 63:9">אין זײַן ליבשאַפֿט און אין זײַן דערבאַרעמונג</para>
  <para style="q" vid="ISA 63:9">האָט ער זײ אױסגעלײזט,</para>
  <para style="q" vid="ISA 63:9">און זײ געהױבן און זײ געטראָגן</para>
  <para style="q" vid="ISA 63:9">אַלע טעג פֿון פֿאַרצײַטן.<verse eid="ISA 63:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 63:10" />אָבער זײ האָבן װידערשפּעניקט</para>
  <para style="q" vid="ISA 63:10">און באַטריבט זײַן הײליקן גײַסט,</para>
  <para style="q" vid="ISA 63:10">און ער איז זײ פֿאַרקערט געװאָרן אין אַ פֿײַנט;</para>
  <para style="q" vid="ISA 63:10">ער האָט מלחמה געהאַלטן אױף זײ.<verse eid="ISA 63:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 63:11" />און זײַן פֿאָלק האָט געדאַכט</para>
  <para style="q" vid="ISA 63:11">אָן די טעג פֿון פֿאַרצײַטן, פֿון משהן:</para>
  <para style="q" vid="ISA 63:11">װוּ איז דער װאָס האָט זײ אױפֿגעבראַכט פֿון ים,</para>
  <para style="q" vid="ISA 63:11">דורך דעם פּאַסטוך פֿון זײַנע שאָף?</para>
  <para style="q" vid="ISA 63:11">װוּ איז דער װאָס האָט זײ אַרײַנגעטאָן אין אים</para>
  <para style="q" vid="ISA 63:11">זײַן הײליקן גײַסט?<verse eid="ISA 63:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 63:12" />װוּ איז ער, װאָס האָט באַלײט די רעכטע האַנט פֿון משהן</para>
  <para style="q" vid="ISA 63:12">מיט דעם אָרעם פֿון זײַן פּראַכט?</para>
  <para style="q" vid="ISA 63:12">װאָס האָט געשפּאָלטן די װאַסערן פֿון פֿאַר זײ,</para>
  <para style="q" vid="ISA 63:12">זיך צו מאַכן אַן אײביקן נאָמען?<verse eid="ISA 63:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 63:13" />װאָס האָט זײ געפֿירט דורך תּהומען</para>
  <para style="q" vid="ISA 63:13">װי אַ פֿערד דורך אַ סטעפּ,</para>
  <para style="q" vid="ISA 63:13">זײ זאָלן נישט געשטרױכלט װערן?<verse eid="ISA 63:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 63:14" />װי פֿיך װאָס טוט נידערן אין טאָל,</para>
  <para style="q" vid="ISA 63:14">האָט דער גײַסט פֿון ה׳ זײ באַרוט;</para>
  <para style="q" vid="ISA 63:14">אַזױ האָסטו געפֿירט דײַן פֿאָלק,</para>
  <para style="q" vid="ISA 63:14">דיר צו מאַכן אַ פּראַכטיקן נאָמען.<verse eid="ISA 63:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 63:15" />לוג פֿון הימל און זע,</para>
  <para style="q" vid="ISA 63:15">פֿון דײַן הײליקער און פּראַכטיקער װױנונג;</para>
  <para style="q" vid="ISA 63:15">װוּ איז דײַן אָננעמען זיך און דײַנע גבֿורות?</para>
  <para style="q" vid="ISA 63:15">די ברומונג פֿון דײַנע אינגעװײד און דײַן באַרעמהאַרציקײט</para>
  <para style="q" vid="ISA 63:15">האַלטן זיך אײַן קעגן מיר.<verse eid="ISA 63:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 63:16" />פֿאַר װאָר, דו ביסט אונדזער פֿאָטער;</para>
  <para style="q" vid="ISA 63:16">װאָרעם אבֿרהם װײס אונדז נישט,</para>
  <para style="q" vid="ISA 63:16">און יִשׂרָאֵל קען אונדז נישט;</para>
  <para style="q" vid="ISA 63:16">דו, ה׳, ביסט אונדזער פֿאָטער,</para>
  <para style="q" vid="ISA 63:16">אונדזער אױסלײזער איז דײַן נאָמען פֿון אײביק אָן.<verse eid="ISA 63:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 63:17" />פֿאַר װאָס, ה׳, לאָזטו אונדז בלאָנדזשען פֿון דײַנע װעגן,</para>
  <para style="q" vid="ISA 63:17">מאַכסט האַרט אונדזער האַרץ, נישט מורא צו האָבן פֿאַר דיר?</para>
  <para style="q" vid="ISA 63:17">קער זיך אום פֿון װעגן דײַנע קנעכט,</para>
  <para style="q" vid="ISA 63:17">די שבֿטים פֿון דײַן אַרב.<verse eid="ISA 63:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 63:18" />כּמעט פֿאַרטריבן האָבן זײ דײַן הײליק פֿאָלק;</para>
  <para style="q" vid="ISA 63:18">אונדזערע פֿײַנט האָבן צעטרעטן דײַן הײליקטום.<verse eid="ISA 63:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 63:19" />מיר זײַנען געװאָרן װי די</para>
  <para style="q" vid="ISA 63:19">װאָס דו האָסט קײן מאָל נישט געװעלטיקט אױף זײ,</para>
  <para style="q" vid="ISA 63:19">װאָס דײַן נאָמען איז נישט גערופֿן געװאָרן אױף זײ.</para>
  <para style="b" vid="ISA 63:19" />
  <para style="q" vid="ISA 63:19">
    <char style="va">64.1</char>הלװאַי צערײַסטו די הימלען און נידערסט אַראָפּ,</para>
  <para style="q" vid="ISA 63:19">די בערג זאָלן זיך טרײסלען פֿאַר דיר;<verse eid="ISA 63:19" /></para>
  <chapter eid="ISA 63" />
  <chapter number="64" style="c" pubnumber="סד" sid="ISA 64" />
  <para style="q">
    <verse number="1" style="v" pubnumber="64.2" sid="ISA 64:1" /> אַזױ װי פֿײַער צינדט אָן טרוקענע צװײַגן,</para>
  <para style="q" vid="ISA 64:1">װי פֿײַער טוט װאַסער צעבלעזלען –</para>
  <para style="q" vid="ISA 64:1">כּדי צו מאַכן װיסן דײַן נאָמען צו דײַנע פֿײַנט;</para>
  <para style="q" vid="ISA 64:1">די פֿעלקער זאָלן ציטערן פֿאַר דיר,<verse eid="ISA 64:1" /></para>
  <para style="q">
    <verse number="2" style="v" pubnumber="64.3" sid="ISA 64:2" /> װען דו טוסט פֿאָרכטיקע זאַכן</para>
  <para style="q" vid="ISA 64:2">װאָס מיר האָבן צו מאָל נישט געהאָפֿט –</para>
  <para style="q" vid="ISA 64:2">הלװאַי נידערסטו אַראָפּ,</para>
  <para style="q" vid="ISA 64:2">די בערג זאָלן זיך טרײסלען פֿאַר דיר! –<verse eid="ISA 64:2" /></para>
  <para style="q">
    <verse number="3" style="v" pubnumber="64.4" sid="ISA 64:3" /> און װאָס זײ האָבן קײן מאָל נישט געהערט, נישט פֿאַרנומען,</para>
  <para style="q" vid="ISA 64:3">װאָס קײן אױג האָט נישט געזען,</para>
  <para style="q" vid="ISA 64:3">אַז אַ ג-ט אַחוץ דיר זאָל טאָן</para>
  <para style="q" vid="ISA 64:3">פֿאַר דעם װאָס טוט האַרן אױף אים.<verse eid="ISA 64:3" /></para>
  <para style="q">
    <verse number="4" style="v" pubnumber="64.5" sid="ISA 64:4" /> האָסט טרעפֿסט דעם װאָס האָט זיך געפֿרײט צו טאָן רעכט,</para>
  <para style="q" vid="ISA 64:4">די װאָס האָבן געדאַכט אָן דיר מיט דײַנע װעגן;</para>
  <para style="q" vid="ISA 64:4">זע, דו האָסט געצערנט, װײַל מיר האָבן געזינדיקט,</para>
  <para style="q" vid="ISA 64:4">דורך זײ אָבער פֿלעגן מיר אײביק געהאָלפֿן װערן.<verse eid="ISA 64:4" /></para>
  <para style="q">
    <verse number="5" style="v" pubnumber="64.6" sid="ISA 64:5" /> און מיר זײַנען געװאָרן װי אַ טמא אַלע,</para>
  <para style="q" vid="ISA 64:5">און אַלע אונדזערע גערעכטיקײטן איז װי אַ באַפֿלעקט קלײד</para>
  <para style="q" vid="ISA 64:5">און מיר װעלקן אַזױ װי אַ בלאַט אַלע,</para>
  <para style="q" vid="ISA 64:5">און אונדזער זינד טראָגט אונדז װי דער װינט אַװעק.<verse eid="ISA 64:5" /></para>
  <para style="q">
    <verse number="6" style="v" pubnumber="64.7" sid="ISA 64:6" /> און נישטאָ װער זאָל רופֿן דײַן נאָמען,</para>
  <para style="q" vid="ISA 64:6">װער זאָל זיך דערװעקן זיך צו האַלטן אָן דיר;</para>
  <para style="q" vid="ISA 64:6">װאָרעם האָסט פֿאַרבאָרגן דײַן פּנים צו אונדז,</para>
  <para style="q" vid="ISA 64:6">און אונדז געמאַכט צעגײן דורך אונדזערע זינד.<verse eid="ISA 64:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" pubnumber="64.8" sid="ISA 64:7" /> און אַצונד, ה׳, דו ביסט אונדזער פֿאָטער,</para>
  <para style="q" vid="ISA 64:7">מיר זײַנען דער לײם, און דו ביסט אונדזער טעפּער,</para>
  <para style="q" vid="ISA 64:7">און דאָס װערק פֿון דײַנע הענט זײַנען מיר אַלע.<verse eid="ISA 64:7" /></para>
  <para style="q">
    <verse number="8" style="v" pubnumber="64.9" sid="ISA 64:8" /> נישט צערענען זאָלסטו, ה׳, ביז גאָר,</para>
  <para style="q" vid="ISA 64:8">און נישט אױף אײביק געדענקען די זינד;</para>
  <para style="q" vid="ISA 64:8">זע, לוג, איך בעט דיך, דײַן פֿאָלק זײַנען מיר אַלע.<verse eid="ISA 64:8" /></para>
  <para style="q">
    <verse number="9" style="v" pubnumber="64.10" sid="ISA 64:9" /> דײַנע הײליקע שטעט זײַנען געװאָרן אַ מדבר,</para>
  <para style="q" vid="ISA 64:9">צִיוֹן איז אַ מדבר געװאָרן,</para>
  <para style="q" vid="ISA 64:9">ירושָלַיִם אַ װיסטעניש;<verse eid="ISA 64:9" /></para>
  <para style="q">
    <verse number="10" style="v" pubnumber="64.11" sid="ISA 64:10" /> אונדזער הײליק און אונדזער פּראַכטיק הױז,</para>
  <para style="q" vid="ISA 64:10">װוּ אונדזערע עלטערן האָבן דיך געלױבט,</para>
  <para style="q" vid="ISA 64:10">איז אַװעק אין בראַנדפֿײַער,</para>
  <para style="q" vid="ISA 64:10">און אַלע אונדזערע גלוסטיקײטן זײַנען געװאָרן צו װיסט.<verse eid="ISA 64:10" /></para>
  <para style="q">
    <verse number="11" style="v" pubnumber="64.12" sid="ISA 64:11" /> װילסטו אױף דעם זיך אײַנהאַלטן, ה׳?</para>
  <para style="q" vid="ISA 64:11">װילסטו שװײַגן און אונדז פּײַניקן ביז גאָר?<verse eid="ISA 64:11" /></para>
  <chapter eid="ISA 64" />
  <chapter number="65" style="c" pubnumber="סה" sid="ISA 65" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 65:1" />איך בין געװען צו דערבעטן</para>
  <para style="q" vid="ISA 65:1">פֿאַר די װאָס האָבן נישט געפֿרעגט;</para>
  <para style="q" vid="ISA 65:1">איך בין געװען צו געפֿינען</para>
  <para style="q" vid="ISA 65:1">פֿאַר די װאָס האָבן מיך נישט געזוכט;</para>
  <para style="q" vid="ISA 65:1">איך האָב געזאָגט: דאָ בין איך, דאָ בין איך!</para>
  <para style="q" vid="ISA 65:1">צו אַ פֿאָלק װאָס רופֿט זיך נישט אױף מײַן נאָמען.<verse eid="ISA 65:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 65:2" />איך האָב אױסגעשפּרײט מײַנע הענט אַ גאַנצן טאָג</para>
  <para style="q" vid="ISA 65:2">צו אַ פֿאָלק אַן אָפּקערער</para>
  <para style="q" vid="ISA 65:2">װאָס גײט אױפֿן נישט גוטן װעג,</para>
  <para style="q" vid="ISA 65:2">נאָך די טראַכטונגען זײערע;<verse eid="ISA 65:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 65:3" />צו אַ פֿאָלק װאָס דערצערנט מיך</para>
  <para style="q" vid="ISA 65:3">אין מײַן פּנים נאָכאַנאַנד;</para>
  <para style="q" vid="ISA 65:3">װאָס שלאַכטן אין די גערטנער,</para>
  <para style="q" vid="ISA 65:3">און רײכערן אױף די ציגל;<verse eid="ISA 65:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 65:4" />װאָס זיצן צװישן די קבֿרים,</para>
  <para style="q" vid="ISA 65:4">און אין באַהעלטענישן נעכטיקן זײ;</para>
  <para style="q" vid="ISA 65:4">װאָס עסן פֿלײש פֿון חזיר,</para>
  <para style="q" vid="ISA 65:4">און זופּ פֿון אומװערדיקײטן איז אין זײערע כּלים;<verse eid="ISA 65:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 65:5" />װאָס זאָגן: רוק דיך אָפּ, זאָלסט נישט גענענען צו מיר,</para>
  <para style="q" vid="ISA 65:5">װאָרעם איך בין דיר הײליק.</para>
  <para style="q" vid="ISA 65:5">די דאָזיקע זײַנען אַ רױך אין מײַן נאָז,</para>
  <para style="q" vid="ISA 65:5">אַ פֿײַער װאָס ברענט אַ גאַנצן טאָג.<verse eid="ISA 65:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 65:6" />זע, אױפֿגעשריבן איז דאָס פֿאַר מיר;</para>
  <para style="q" vid="ISA 65:6">איך װעל נישט שװײַגן סײַדן איך האָב אָפּגעצאָלט,</para>
  <para style="q" vid="ISA 65:6">יאָ, אָפּגעצאָלט אין זײער בוזעם,<verse eid="ISA 65:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 65:7" />אײַערע זינד אין אײנעם מיט די זינד</para>
  <para style="q" vid="ISA 65:7">פֿון אײַערע עלטערן, זאָגט ה׳,</para>
  <para style="q" vid="ISA 65:7">װאָס האָבן גערײכערט אױף די בערג,</para>
  <para style="q" vid="ISA 65:7">און אױף די הײכן מיך געלעסטערט;</para>
  <para style="q" vid="ISA 65:7">דערום װעל איך אָפּמעסטן צוערשט</para>
  <para style="q" vid="ISA 65:7">זײער לױט אין זײער בוזעם.<verse eid="ISA 65:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 65:8" />אַזױ האָט ה׳ געזאָגט:</para>
  <para style="q" vid="ISA 65:8">אַזױ װי אַז דער װײַן געפֿינט זיך אין הענגל,</para>
  <para style="q" vid="ISA 65:8">זאָגט מען: זאָלסט עס נישט צעשטערן,</para>
  <para style="q" vid="ISA 65:8">װאָרעם אַ בענטשונג איז אין אים;</para>
  <para style="q" vid="ISA 65:8">אַזױ װעל איך טאָן פֿון װעגן מײַנע קנעכט,</para>
  <para style="q" vid="ISA 65:8">נישט צו צעשטערן אין גאַנצן.<verse eid="ISA 65:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 65:9" />און איך װעל אַרױסברענגען פֿון יעקבֿ אַ זאָמען,</para>
  <para style="q" vid="ISA 65:9">און פֿון יהוּדה דעם יוֹרש פֿון מײַנע בערג;</para>
  <para style="q" vid="ISA 65:9">און ירשען װעלן עס מײַנע אױסדערװײלטע,</para>
  <para style="q" vid="ISA 65:9">און מײַנע קנעכט װעלן דאָרט װױנען.<verse eid="ISA 65:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 65:10" />און דער שָרוֹן װעט זײַן פֿאַר אַ פֿיטערפּלאַץ פֿון שאָף,</para>
  <para style="q" vid="ISA 65:10">און דער טאָל עָכוֹר פֿאַר אַ הױערונג פֿון רינדער,</para>
  <para style="q" vid="ISA 65:10">פֿאַר מײַן פֿאָלק װאָס האָט מיך געזוכט.<verse eid="ISA 65:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 65:11" />אָבער איר װאָס פֿאַרלאָזט ה׳,</para>
  <para style="q" vid="ISA 65:11">װאָס פֿאַרגעסט אָן מײַן הײליקן באַרג,</para>
  <para style="q" vid="ISA 65:11">װאָס גרײט אַ טיש צום מזל,</para>
  <para style="q" vid="ISA 65:11">און פֿילט אָן אַ מישטראַנק צום באַשער,<verse eid="ISA 65:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 65:12" />איך װעל אײַך באַשערן צום שװערד,</para>
  <para style="q" vid="ISA 65:12">און איר אַלע װעט קניִען צו דער שחיטה;</para>
  <para style="q" vid="ISA 65:12">װײַל איך האָב גערופֿן און איר האָט נישט געענטפֿערט,</para>
  <para style="q" vid="ISA 65:12">גערעדט, און איר האָט נישט געהערט;</para>
  <para style="q" vid="ISA 65:12">נאָר איר האָט געטאָן װאָס איז שלעכט אין מײַנע אױגן,</para>
  <para style="q" vid="ISA 65:12">און װאָס איך האָב נישט געװאָלט, האָט איר אױסגעװײלט.<verse eid="ISA 65:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 65:13" />דערום האָט אֲדֹנָי ה׳ אַזױ געזאָגט:</para>
  <para style="q" vid="ISA 65:13">זע, מײַנע קנעכט װעלן עסן,</para>
  <para style="q" vid="ISA 65:13">און איר װעט זײַן הונגעריק;</para>
  <para style="q" vid="ISA 65:13">זע, מײַנע קנעכט װעלן טרינקען,</para>
  <para style="q" vid="ISA 65:13">און איר װעט זײַן דאָרשטיק;</para>
  <para style="q" vid="ISA 65:13">זע, מײַנע קנעכט װעלן זיך פֿרײען,</para>
  <para style="q" vid="ISA 65:13">און איר װעט פֿאַרשעמט װערן.<verse eid="ISA 65:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 65:14" />זע, מײַנע קנעכט װעלן זינגען פֿון האַרצפֿרײד,</para>
  <para style="q" vid="ISA 65:14">און איר װעט שרײַען פֿון האַרצװײ,</para>
  <para style="q" vid="ISA 65:14">און פֿון אַ צעבראָכן געמיט װעט איר יאָמערן.<verse eid="ISA 65:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 65:15" />און איר װעט לאָזן אײַער נאָמען</para>
  <para style="q" vid="ISA 65:15">פֿאַר אַ קללה צו מײַנע אױסדערװײלטע:</para>
  <para style="q" vid="ISA 65:15">אַזױ זאָל אֲדֹנָי ה׳ דיך טײטן!</para>
  <para style="q" vid="ISA 65:15">און זײַנע קנעכט װעט ער רופֿן אַן אַנדער נאָמען;<verse eid="ISA 65:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 65:16" />אַז דער װאָס בענטשט זיך אױף דער ערד,</para>
  <para style="q" vid="ISA 65:16">װעט זיך בענטשן בײַם אלֹקים פֿון אמת,</para>
  <para style="q" vid="ISA 65:16">און דער װאָס שװערט אױף דער ערד,</para>
  <para style="q" vid="ISA 65:16">װעט שװערן בײַם אלֹקים פֿון אמת;</para>
  <para style="q" vid="ISA 65:16">װײַל פֿאַרגעסן זײַנען די פֿריִערדיקע צרות,</para>
  <para style="q" vid="ISA 65:16">און װײַל זײ זײַנען פֿאַרבאָרגן פֿון מײַנע אױגן.<verse eid="ISA 65:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 65:17" />װאָרעם זע, איך באַשאַף הימלען נײַע,</para>
  <para style="q" vid="ISA 65:17">און אַן ערד אַ נײַע;</para>
  <para style="q" vid="ISA 65:17">און דאָס פֿריִערדיקע װעט נישט געדאַכט װערן,</para>
  <para style="q" vid="ISA 65:17">און אױפֿן זינען נישט אין דעם האַרץ אױפֿקומען.<verse eid="ISA 65:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 65:18" />נאָר זײַט לוסטיק און פֿרײט זיך ביז אײביק</para>
  <para style="q" vid="ISA 65:18">מיט דעם װאָס איך באַשאַף;</para>
  <para style="q" vid="ISA 65:18">װאָרעם זע, איך באַשאַף ירושָלַיִם פֿאַר אַ לוסטיקײט,</para>
  <para style="q" vid="ISA 65:18">און איר פֿאָלק פֿאַר אַ פֿרײד.<verse eid="ISA 65:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 65:19" />און איך װעל זיך פֿרײען מיט ירושָלַיִם,</para>
  <para style="q" vid="ISA 65:19">און װעל לוסטיק זײַן מיט מײַן פֿאָלק;</para>
  <para style="q" vid="ISA 65:19">און נישט געהערט װערן װעט אין איר מער</para>
  <para style="q" vid="ISA 65:19">אַ קֹול פֿון געװײן, און אַ קֹול פֿון געשרײ.<verse eid="ISA 65:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 65:20" />מער װעט נישט זײַן פֿון דאָרטן</para>
  <para style="q" vid="ISA 65:20">אַ קינד אין טעג, אָדער אַ זקן,</para>
  <para style="q" vid="ISA 65:20">װאָס װעט נישט דערפֿילן זײַנע טעג;</para>
  <para style="q" vid="ISA 65:20">װאָרעם דער ייִנגסטער װעט צו הונדערט יאָר שטאַרבן,</para>
  <para style="q" vid="ISA 65:20">און אַ זינדיקער װעט מיט הונדערט יאָר געשאָלטן װערן.<verse eid="ISA 65:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 65:21" />און זײ װעלן בױען הײַזער און באַװױנען,</para>
  <para style="q" vid="ISA 65:21">און פֿלאַנצן װײַנגערטנער און עסן זײער פֿרוכט.<verse eid="ISA 65:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 65:22" />זײ װעלן נישט בױען,</para>
  <para style="q" vid="ISA 65:22">און אַן אַנדערער זאָל באַװױנען,</para>
  <para style="q" vid="ISA 65:22">זײ װעלן נישט פֿלאַנצן,</para>
  <para style="q" vid="ISA 65:22">און אַן אַנדערער זאָל עסן;</para>
  <para style="q" vid="ISA 65:22">װאָרעם אַזױ װי די טעג פֿון אַ בױם</para>
  <para style="q" vid="ISA 65:22">װעלן זײַן די טעג פֿון מײַן פֿאָלק,</para>
  <para style="q" vid="ISA 65:22">און מײַנע אױסדערװײלטע װעלן פֿאַרנוצן</para>
  <para style="q" vid="ISA 65:22">דאָס װערק פֿון זײערע הענט.<verse eid="ISA 65:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 65:23" />זײ װעלן זיך נישט מיען אומנישט,</para>
  <para style="q" vid="ISA 65:23">זײ װעלן נישט געבערן פֿאַר אַ בהלה,</para>
  <para style="q" vid="ISA 65:23">װאָרעם אַ זאָמען געבענטשט פֿון ה׳ זײַנען זײ,</para>
  <para style="q" vid="ISA 65:23">און זײערע שפּראָצן מיט זײ.<verse eid="ISA 65:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 65:24" />און עס װעט זײַן,</para>
  <para style="q" vid="ISA 65:24">אײדער זײ רופֿן, װעל איך ענטפֿערן,</para>
  <para style="q" vid="ISA 65:24">װי זײ רעדן נאָך, אַזױ װעל איך צוהערן.<verse eid="ISA 65:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 65:25" />אַ װאָלף און אַ לאַם װעלן זיך פֿיטערן אין אײנעם,</para>
  <para style="q" vid="ISA 65:25">און אַ לײב װעט װי אַ רינד עסן שטרױ;</para>
  <para style="q" vid="ISA 65:25">און אַ שלאַנג – איר שפּײַז װעט זײַן שטױב;</para>
  <para style="q" vid="ISA 65:25">זײ װעלן נישט בײז טאָן און נישט פֿאַרדאַרבן</para>
  <para style="q" vid="ISA 65:25">אױף מײַן גאַנצן הײליקן באַרג,</para>
  <para style="q" vid="ISA 65:25">זאָגט ה׳.<verse eid="ISA 65:25" /></para>
  <chapter eid="ISA 65" />
  <chapter number="66" style="c" pubnumber="סו" sid="ISA 66" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 66:1" />אַזױ האָט ה׳ געזאָגט:</para>
  <para style="q" vid="ISA 66:1">דער הימל איז מײַן טראָן,</para>
  <para style="q" vid="ISA 66:1">און די ערד איז מײַן פֿוסבענקל;</para>
  <para style="q" vid="ISA 66:1">װוּ איז דאָס הױז װאָס איר קענט מיר בױען?</para>
  <para style="q" vid="ISA 66:1">און װוּ דער אָרט פֿון מײַן רוּונג?<verse eid="ISA 66:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 66:2" />אַז די אַלע האָט מײַן האַנט געמאַכט,</para>
  <para style="q" vid="ISA 66:2">און אַזױ זײַנען די אַלע געװאָרן,</para>
  <para style="q" vid="ISA 66:2">זאָגט ה׳.</para>
  <para style="q" vid="ISA 66:2">אָבער אױף אַזעלכן טו איך קוקן:</para>
  <para style="q" vid="ISA 66:2">אױף דעם אָרעמאַן און דערשלאָגענעם אין געמיט,</para>
  <para style="q" vid="ISA 66:2">און דעם װאָס ציטערט איבער מײַן װאָרט.<verse eid="ISA 66:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 66:3" />דער װאָס שעכט אַן אָקס,</para>
  <para style="q" vid="ISA 66:3">דערשלאָגט אַ מענטשן;</para>
  <para style="q" vid="ISA 66:3">דער װאָס שלאַכט אַ שעפּס,</para>
  <para style="q" vid="ISA 66:3">האַקט אָפּ דאָס געניק פֿון אַ הונט;</para>
  <para style="q" vid="ISA 66:3">דער װאָס ברענגט אױף אַ שפּײַזאָפּפֿער,</para>
  <para style="q" vid="ISA 66:3">ברענגט אױף בלוט פֿון אַ חזיר;</para>
  <para style="q" vid="ISA 66:3">דער װאָס רײכערט װײַרעך,</para>
  <para style="q" vid="ISA 66:3">בענטשט אַן אָפּגאָט.</para>
  <para style="q" vid="ISA 66:3">אַזױ װי זײ האָבן אױסגעװײלט זײערע װעגן,</para>
  <para style="q" vid="ISA 66:3">און זײערע אומװערדיקײטן האָט באַגערט זײער זעל,<verse eid="ISA 66:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 66:4" />אַזױ װעל איך אױך אױסװײלן געשפּעטן איבער זײ,</para>
  <para style="q" vid="ISA 66:4">און זײערע שרעקענישן װעל איך ברענגען אױף זײ;</para>
  <para style="q" vid="ISA 66:4">װײַל איך האָב גערופֿן, און קײנער האָט נישט געענטפֿערט,</para>
  <para style="q" vid="ISA 66:4">גערעדט, און זײ האָבן נישט געהערט;</para>
  <para style="q" vid="ISA 66:4">נאָר זײ האָבן געטאָן װאָס איז שלעכט אין מײַנע אױגן,</para>
  <para style="q" vid="ISA 66:4">און װאָס איך האָב נישט געװאָלט האָבן זײ אױסגעװײלט.<verse eid="ISA 66:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 66:5" />הערט דאָס װאָרט פֿון ה׳,</para>
  <para style="q" vid="ISA 66:5">איר װאָס ציטערט איבער זײַן װאָרט:</para>
  <para style="q" vid="ISA 66:5">עס האָבן געזאָגט אײַערע ברידער װאָס האָבן אײַך פֿײַנט,</para>
  <para style="q" vid="ISA 66:5">די װאָס פֿאַרשטױסן אײַך פֿון װעגן מײַן נאָמען:</para>
  <para style="q" vid="ISA 66:5">זאָל ה׳ געערלעכט װערן,</para>
  <para style="q" vid="ISA 66:5">און לאָמיר זען אײַער שׂימחה!</para>
  <para style="q" vid="ISA 66:5">אָבער זײ װעלן פֿאַרשעמט װערן.<verse eid="ISA 66:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 66:6" />אַ קֹול פֿון טומל פֿון דער שטאָט,</para>
  <para style="q" vid="ISA 66:6">אַ קֹול פֿון דעם הֵיכל!</para>
  <para style="q" vid="ISA 66:6">אַ קֹול פֿון ה׳ װאָס באַצאָלט</para>
  <para style="q" vid="ISA 66:6">פֿאַרגעלטונג צו זײַנע פֿײַנט.<verse eid="ISA 66:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 66:7" />אײדער זי האָט געװײטאָקט,</para>
  <para style="q" vid="ISA 66:7">האָט זי געבאָרן;</para>
  <para style="q" vid="ISA 66:7">אײדער װײעניש איז געקומען אױף איר,</para>
  <para style="q" vid="ISA 66:7">אַזױ האָט זי אַ ייִנגל געהאַט.<verse eid="ISA 66:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 66:8" />װער האָט געהערט אַזױנס?</para>
  <para style="q" vid="ISA 66:8">װער האָט געזען אַזױ-װאָס?</para>
  <para style="q" vid="ISA 66:8">װערט אַ לאַנד אױסגעװײטאָקט אין אײן טאָג?</para>
  <para style="q" vid="ISA 66:8">װערט געבאָרן אַ פֿאָלק מיט אײן מאָל?</para>
  <para style="q" vid="ISA 66:8">װאָרעם װי צִיוֹן האָט געװײטאָקט,</para>
  <para style="q" vid="ISA 66:8">אַזױ האָט זי אירע קינדער געבאָרן.<verse eid="ISA 66:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 66:9" />װעל איך ביז געבורט ברענגען,</para>
  <para style="q" vid="ISA 66:9">און נישט מאַכן געבערן? זאָגט ה׳;</para>
  <para style="q" vid="ISA 66:9">װעל איך, װאָס מאַך געבערן, פֿאַרהאַלטן?</para>
  <para style="q" vid="ISA 66:9">זאָגט דײַן ג-ט.<verse eid="ISA 66:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 66:10" />פֿרײט זיך מיט ירושָלַיִם,</para>
  <para style="q" vid="ISA 66:10">און קװעלט אָן אין איר, אַלע אירע ליבהאָבער;</para>
  <para style="q" vid="ISA 66:10">לוסטיקט אײַך לוסטיק מיט איר,</para>
  <para style="q" vid="ISA 66:10">איר אַלע װאָס טרױערט אױף איר;<verse eid="ISA 66:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 66:11" />װײַל איר װעט זײגן און זיך זעטן</para>
  <para style="q" vid="ISA 66:11">פֿון דער ברוסט פֿון אירע נחמות,</para>
  <para style="q" vid="ISA 66:11">װײַל איר װעט זופּן און זיך קװיקן</para>
  <para style="q" vid="ISA 66:11">פֿון דעם זױגנאָפּל פֿון איר שפֿע.<verse eid="ISA 66:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 66:12" />װאָרעם אַזױ האָט ה׳ געזאָגט:</para>
  <para style="q" vid="ISA 66:12">זע, איך נײַג צו איר שלום װי אַ טײַך,</para>
  <para style="q" vid="ISA 66:12">און װי אַ פֿלײציקן שטראָם די רײַכקײט פֿון די פֿעלקער,</para>
  <para style="q" vid="ISA 66:12">און איר װעט זײגן דערפֿון.</para>
  <para style="q" vid="ISA 66:12">אױפֿן זײַט װעט איר געטראָגן װערן,</para>
  <para style="q" vid="ISA 66:12">און אױף די קני װעט איר געצערטלט װערן.<verse eid="ISA 66:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 66:13" />װי אײנער װאָס זײַן מוטער טוט אים טרײסטן,</para>
  <para style="q" vid="ISA 66:13">אַזױ װעל איך אײַך טרײסטן;</para>
  <para style="q" vid="ISA 66:13">און אין ירושָלַיִם װעט איר געטרײסט װערן.<verse eid="ISA 66:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 66:14" />און איר װעט זען, און אײַער האַרץ װעט זיך פֿרײען,</para>
  <para style="q" vid="ISA 66:14">און אײַערע בײנער װעלן װי גראָז בליִען;</para>
  <para style="q" vid="ISA 66:14">און די האַנט פֿון ה׳ װעט דערװוּסט װערן בײַ זײַנע קנעכט,</para>
  <para style="q" vid="ISA 66:14">און ער װעט צערענען אױף זײַנע פֿײַנט.<verse eid="ISA 66:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 66:15" />װאָרעם זע, ה׳ װעט קומען מיט פֿײַער,</para>
  <para style="q" vid="ISA 66:15">און װי אַ שטורעמװינט זײַנע רײַטװעגן,</para>
  <para style="q" vid="ISA 66:15">אױסצולאָזן מיט גרים זײַן צאָרן,</para>
  <para style="q" vid="ISA 66:15">און זײַן אָנגעשרײ מיט פֿלאַמען פֿײַער.<verse eid="ISA 66:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 66:16" />װאָרעם מיט פֿײַער טוט זיך משפּטן ה׳,</para>
  <para style="q" vid="ISA 66:16">און מיט זײַן שװערד, מיט אַלע לײַבער;</para>
  <para style="q" vid="ISA 66:16">און פֿיל װעלן זײַן די דערשלאָגענע פֿון ה׳.<verse eid="ISA 66:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="ISA 66:17" />די װאָס הײליקן זיך און רײניקן זיך צו גײן אין די גערטנער, הינטער אײנער אין מיטן, די װאָס עסן פֿלײש פֿון חזיר, און אומװערדיקײטן און מײַז, װעלן אין אײנעם פֿאַרלענדט װערן, זאָגט ה׳. <verse eid="ISA 66:17" /><verse number="18" style="v" sid="ISA 66:18" />װאָרעם זײערע מעשׂים און זײערע טראַכטונגען; די צײַט קומט אײַנצוזאַמלען אַלע פֿעלקער און לשונות, זײ זאָלן קומען און זען מײַן כּבֿוד. <verse eid="ISA 66:18" /><verse number="19" style="v" sid="ISA 66:19" />און איך װעל טאָן צװישן זײ אַ װוּנדערצײכן, און איך װעל שיקן פֿון זײ אַנטרונענע צו די פֿעלקער, צו תַּרְשִיש, פּול, און לוד, די בױגנשפּאַנערס, צו תּובַֿל און יָוָן, די װײַטע אינדזלען, װאָס האָבן נישט געהערט מײַן הערונג, און נישט געזען מײַן כּבֿוד; און זײ װעלן דערצײלן מײַן כּבֿוד צװישן די פֿעלקער. <verse eid="ISA 66:19" /><verse number="20" style="v" sid="ISA 66:20" />און זײ װעלן ברענגען אַלע אײַערע ברידער, פֿון אַלע פֿעלקער, אַ מתּנה צו ה׳, אױף פֿערד און אױף קאָטשן און אױף טראָגװעגן, און אױף מױלאײזלען, און אױף יאָגקעמלען, צו מײַן הײליקן באַרג ירושָלַיִם, זאָגט ה׳, אַזױ װי די קינדער פֿון יִשׂרָאֵל ברענגען דאָס שפּײַזאָפּפֿער אין אַ רײנער כּלי אין הױז פֿון ה׳. <verse eid="ISA 66:20" /><verse number="21" style="v" sid="ISA 66:21" />און אױך פֿון זײ װעל איך נעמען פֿאַר כּהנים און פֿאַר לוִיִים, זאָגט ה׳.<verse eid="ISA 66:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 66:22" />װאָרעם װי די נײַע הימלען,</para>
  <para style="q" vid="ISA 66:22">און די נײַע ערד, װאָס איך מאַך,</para>
  <para style="q" vid="ISA 66:22">װעלן באַשטײן פֿאַר מיר, זאָגט ה׳,</para>
  <para style="q" vid="ISA 66:22">אַזױ װעט באַשטײן אײַער זאָמען און אײַער נאָמען.<verse eid="ISA 66:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 66:23" />און עס װעט זײַן,</para>
  <para style="q" vid="ISA 66:23">ראָש-חודש אין ראָש-חודש,</para>
  <para style="q" vid="ISA 66:23">און שבת אין שבת,</para>
  <para style="q" vid="ISA 66:23">װעלן קומען אַלע לײַבער,</para>
  <para style="q" vid="ISA 66:23">זיך בוקן פֿאַר מיר, זאָגט ה׳.<verse eid="ISA 66:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="ISA 66:24" />און זײ װעלן אַרױסגײן און װעלן קוקן אױף די פּגָרים פֿון די מענטשן װאָס האָבן געבראָכן אָן מיר; װאָרעם זײער װאָרעם װעט נישט שטאַרבן, און זײער פֿײַער װעט נישט פֿאַרלאָשן װערן, און זײ װעלן זײַן אַן פֿאַרשעמען פֿאַר אַלע פֿלײש.<verse eid="ISA 66:24" /></para>
  <chapter eid="ISA 66" />
</usx>