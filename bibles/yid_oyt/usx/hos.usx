<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HOS" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">הוֹשֵעַ</para>
  <para style="toc2">הוֹשֵעַ</para>
  <para style="toc1">הוֹשֵעַ</para>
  <para style="mt1">הוֹשֵעַ</para>
  <chapter number="1" style="c" pubnumber="א" sid="HOS 1" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1" />דאָס װאָרט פֿון ה׳ װאָס איז געװען צו הוֹשֵעַ דעם זון פֿון באֵרין, אין די טעג פֿון עוּזִיָה, יוֹתָם, אָחָז, יחִזקִיָה, די מלכים פֿון יהוּדה, און אין די טעג פֿון יָרָבֿעָם דעם זון פֿון יוֹאָשן, דעם מלך פֿון יִשׂרָאֵל.<verse eid="HOS 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2" />דאָס ערשטע װאָס ה׳ האָט גערעדט צו הוֹשֵעַן, האָט ה׳ געזאָגט צו הוֹשֵעַן: גײ נעם דיר אַ װײַב אַ זוֹנה, און קינדער פֿון אַ זוֹנה, װאָרעם מזַנה טוט מזַנה זײַן דאָס לאַנד, אַװעק פֿון הינטער ה׳. <verse eid="HOS 1:2" /><verse number="3" style="v" sid="HOS 1:3" />איז ער געגאַנגען און האָט גענומען גוֹמֶר די טאָכטער פֿון דִבלַימען, און זי איז טראָגעדיק געװאָרן, און האָט אים געבאָרן אַ זון.<verse eid="HOS 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 1:4" />און ה׳ האָט צו אים געזאָגט: רוף זײַן נאָמען יִזרְעֶאל, װאָרעם נאָך אַ קלײן װײַלע, און איך װעל זיך רעכענען פֿאַר דעם בלוט פֿון יִזרְעֶאל מיט דעם הױז פֿון יֵהוּא, און איך װעל פֿאַרשטערן די מלוכה פֿון דעם הױז פֿון יִשׂרָאֵל. <verse eid="HOS 1:4" /><verse number="5" style="v" sid="HOS 1:5" />און עס װעט זײַן אין יענעם טאָג, װעל איך צעברעכן דעם בױגן פֿון יִשׂרָאֵל אין טאָל יִזרְעֶאל.<verse eid="HOS 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6" />און זי איז װידער טראָגעדיק געװאָרן, און האָט געבאָרן אַ טאָכטער. און ער האָט צו אים געזאָגט: רוף איר נאָמען לוא-רוּחָמָה, װאָרעם איך װעל מער װידער נישט רחמנות האָבן אױף דעם הױז פֿון יִשׂרָאֵל, אַז פֿאַרגעבן זאָל איך זײ פֿאַרגעבן. <verse eid="HOS 1:6" /><verse number="7" style="v" sid="HOS 1:7" />אָבער אױף דעם הױז פֿון יהוּדה װעל איך רחמנות האָבן, און איך װעל זײ העלפֿן דורך ה׳ זײער ג-ט, און איך װעל זײ נישט העלפֿן דורך בױגן און דורך שװערד און דורך מלחמה, דורך פֿערד און דורך רײַטער.<verse eid="HOS 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8" />און זי האָט אַנטװױנט לוא-רוּחָמָהן, און זי איז טראָגעדיק געװאָרן, און האָט געבאָרן אַ זון. <verse eid="HOS 1:8" /><verse number="9" style="v" sid="HOS 1:9" />און ער האָט געזאָגט: רוף זײַן נאָמען נישט-מײַן-פֿאָלק, װאָרעם איר זײט נישט מײַן פֿאָלק, און איך בין נישט אײַערע.<verse eid="HOS 1:9" /></para>
  <chapter eid="HOS 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="HOS 2" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1.10" sid="HOS 2:1" /> און די צאָל פֿון די קינדער פֿון יִשׂרָאֵל װעט זײַן אַזױ װי די זאַמד פֿון ים, װאָס קען נישט געמאָסטן און נישט געצײלט װערן; און עס װעט זײַן, אַנשטאָט װאָס צו זײ פֿלעגט געזאָגט װערן: איר זײַט נישט מײַן פֿאָלק, װעט צו זײ געזאָגט װערן: קינדער פֿון דעם לעבעדיקן אֵל. <verse eid="HOS 2:1" /><verse number="2" style="v" pubnumber="1.11" sid="HOS 2:2" /> און די קינדער פֿון יהוּדה און די קינדער פֿון יִשׂרָאֵל װעלן זיך אײַנזאַמלען אין אײנעם, און זײ װעלן זיך מאַכן אײן הױפּטמאַן, און זײ װעלן אַרױפֿגײן פֿון דעם לאַנד, װאָרעם גרױס װעט זײַן דער טאָג פֿון יִזרְעֶאל.<verse eid="HOS 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="2.1" sid="HOS 2:3" /> זאָגט צו אײַערע ברידער: עַמי, און צו אײַער שװעסטער: רוחמָה.<verse eid="HOS 2:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" pubnumber="2.2" sid="HOS 2:4" /> קריגט אײַך מיט אײַער מוטער, קריגט אײַך,</para>
  <para style="q" vid="HOS 2:4">װאָרעם זי איז נישט מײַן װײַב,</para>
  <para style="q" vid="HOS 2:4">און איך בין נישט איר מאַן;</para>
  <para style="q" vid="HOS 2:4">און זאָל זי אָפּטאָן איר זנות פֿון איר פּנים,</para>
  <para style="q" vid="HOS 2:4">און איר ניאוף פֿון צװישן אירע בריסט.<verse eid="HOS 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" pubnumber="2.3" sid="HOS 2:5" /> אַניט װעל איך זי אױסטאָן אַ נאַקעטע,</para>
  <para style="q" vid="HOS 2:5">און זי לאָזן שטײן װי אין טאָג פֿון איר געבאָרנשאַפֿט;</para>
  <para style="q" vid="HOS 2:5">און איך װעל זי מאַכן װי אַ מדבר,</para>
  <para style="q" vid="HOS 2:5">און זי לאָזן װערן װי אַ טרוקן לאַנד,</para>
  <para style="q" vid="HOS 2:5">און זי טײטן מיט דאָרשט.<verse eid="HOS 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" pubnumber="2.4" sid="HOS 2:6" /> און אירע קינדער װעל איך נישט דערבאַרעמען,</para>
  <para style="q" vid="HOS 2:6">װאָרעם קינדער פֿון זנות זײַנען זײ.<verse eid="HOS 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" pubnumber="2.5" sid="HOS 2:7" /> װאָרעם מזַנה געװען האָט זײער מוטער,</para>
  <para style="q" vid="HOS 2:7">פֿאַרמיאוסט האָט זיך זײער געװינערין.</para>
  <para style="q" vid="HOS 2:7">װאָרעם זי האָט געזאָגט: איך װעל גײן נאָך מײַנע ליבהאָבער,</para>
  <para style="q" vid="HOS 2:7">די װאָס גיבן מײַן ברױט און מײַן װאַסער,</para>
  <para style="q" vid="HOS 2:7">מײַן װאָל און מײַן פֿלאַקס, מײַן אײל און מײַן טראַנק.<verse eid="HOS 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" pubnumber="2.6" sid="HOS 2:8" /> דערום זע, איך פֿאַרשטעל דײַן װעג מיט דערנער,</para>
  <para style="q" vid="HOS 2:8">און װעל פֿאַרצאַמען אַ צאַם אַרום איר,</para>
  <para style="q" vid="HOS 2:8">אַז זי זאָל אירע שטעגן נישט געפֿינען.<verse eid="HOS 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" pubnumber="2.7" sid="HOS 2:9" /> און זי װעט נאָכיאָגן אירע ליבהאָבער</para>
  <para style="q" vid="HOS 2:9">און זײ נישט דערגרײכן,</para>
  <para style="q" vid="HOS 2:9">און זי װעט זײ זוכן און נישט געפֿינען;</para>
  <para style="q" vid="HOS 2:9">און זי װעט זאָגן:</para>
  <para style="q" vid="HOS 2:9">איך װעל גײן און זיך אומקערן צו מײַן ערשטן מאַן,</para>
  <para style="q" vid="HOS 2:9">װאָרעם דענצמאָל איז מיר בעסער געװען װי אַצונד.<verse eid="HOS 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" pubnumber="2.8" sid="HOS 2:10" /> און זי װײס נישט, אַז דאָס האָב איך איר געגעבן</para>
  <para style="q" vid="HOS 2:10">די תּבֿואה, דעם װײַן, און דאָס אײל;</para>
  <para style="q" vid="HOS 2:10">און דאָס זילבער און גאָלד װאָס איך האָב איר געמערט,</para>
  <para style="q" vid="HOS 2:10">האָבן זײ פֿאַרטאָן אױף בַעַל.<verse eid="HOS 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" pubnumber="2.9" sid="HOS 2:11" /> דערום װעל איך צוריקנעמען</para>
  <para style="q" vid="HOS 2:11">מײַן תּבֿואה אין איר צײַט,</para>
  <para style="q" vid="HOS 2:11">און מײַן װײַן אין זײַן געשטעלטער צײַט,</para>
  <para style="q" vid="HOS 2:11">און איך װעל אַװעקרײַסן מײַן װאָל און מײַן פֿלאַקס,</para>
  <para style="q" vid="HOS 2:11">װאָס איז געװען איר נאַקעטקײט צו פֿאַרדעקן.<verse eid="HOS 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" pubnumber="2.10" sid="HOS 2:12" /> און אַצונד װעל איך אַנטפּלעקן איר שאַנד</para>
  <para style="q" vid="HOS 2:12">פֿאַר די אױגן פֿון אירע ליבהאָבער,</para>
  <para style="q" vid="HOS 2:12">און קײנער װעט זי נישט מציל זײַן פֿון מײַן האַנט.<verse eid="HOS 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" pubnumber="2.11" sid="HOS 2:13" /> און איך װעל מאַכן אױפֿהערן איר גאַנצע פֿרײד;</para>
  <para style="q" vid="HOS 2:13">איר יוֹם-טובֿ, איר ראָש-חודש, און איר שבת,</para>
  <para style="q" vid="HOS 2:13">און אַלע אירע פֿײַערטעג.<verse eid="HOS 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" pubnumber="2.12" sid="HOS 2:14" /> און איך װעל פֿאַרװיסטן איר װײַנשטאָק און איר פֿײַגנבױם,</para>
  <para style="q" vid="HOS 2:14">װאָס זי האָט געזאָגט: אַ מתּנה זײַנען זײ מיר,</para>
  <para style="q" vid="HOS 2:14">װאָס מײַנע ליבהאָבער האָבן מיר געגעבן;</para>
  <para style="q" vid="HOS 2:14">און איך װעל זײ מאַכן פֿאַר אַ װאַלד,</para>
  <para style="q" vid="HOS 2:14">און די חיה פֿון פֿעלד װעט זײ אױפֿעסן.<verse eid="HOS 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" pubnumber="2.13" sid="HOS 2:15" /> און איך װעל זיך רעכענען מיט איר</para>
  <para style="q" vid="HOS 2:15">פֿאַר די טעג פֿון די בַעַל-געטער,</para>
  <para style="q" vid="HOS 2:15">װאָס זי האָט גערײכערט צו זײ,</para>
  <para style="q" vid="HOS 2:15">און אָנגעטאָן אירע אױרינגען און איר צירונג,</para>
  <para style="q" vid="HOS 2:15">און געגאַנגען נאָך אירע ליבהאָבער,</para>
  <para style="q" vid="HOS 2:15">און אָן מיר האָט זי פֿאַרגעסן, זאָגט ה׳.<verse eid="HOS 2:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" pubnumber="2.14" sid="HOS 2:16" /> אָבער זע, איך רעד זי איבער,</para>
  <para style="q" vid="HOS 2:16">און װעל זי אַװעקפֿירן אין מדבר,</para>
  <para style="q" vid="HOS 2:16">און װעל רעדן צו איר האַרצן.<verse eid="HOS 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" pubnumber="2.15" sid="HOS 2:17" /> און איך װעל צו איר פֿון דאָרט אָפּגעבן אירע װײַנגערטנער,</para>
  <para style="q" vid="HOS 2:17">און דעם טאָל עָכוֹר פֿאַר אַ טיר פֿון האָפֿענונג;</para>
  <para style="q" vid="HOS 2:17">און זי װעט דאָרטן אָפּרופֿן זיך װי אין די טעג פֿון איר יוגנט</para>
  <para style="q" vid="HOS 2:17">און װי אין טאָג פֿון איר אַרױפֿגײן פֿון לאַנד מִצרַיִם.<verse eid="HOS 2:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" pubnumber="2.16" sid="HOS 2:18" /> און עס װעט זײַן אין יענעם טאָג, זאָגט ה׳, װעסטו רופֿן: מײַן מאַן, און װעסט מיך מער נישט רופֿן: מײַן בַעַל. <verse eid="HOS 2:18" /><verse number="19" style="v" pubnumber="2.17" sid="HOS 2:19" /> און איך װעל אָפּטאָן די נעמען פֿון די בַעַל-געטער פֿון איר מױל, און זײ װעלן מער נישט געדאַכט װערן מיט זײער נאָמען. <verse eid="HOS 2:19" /><verse number="20" style="v" pubnumber="2.18" sid="HOS 2:20" /> און איך װעל זײ שליסן אַ ברית אין יענעם טאָג, מיט דער חיה פֿון פֿעלד, און מיט דעם פֿױגל פֿון הימל, און מיט דעם שרץ פֿון דער ערד. און אַ בױגן און שװערד און מלחמה װעל איך צעברעכן פֿון לאַנד, און איך װעל זײ מאַכן ליגן אין זיכערקײט. <verse eid="HOS 2:20" /><verse number="21" style="v" pubnumber="2.19" sid="HOS 2:21" /> און איך װעל דיך פֿאַרקנַסן צו מיר אױף אײביק, און דיך פֿאַרקנַסן צו מיר מיט רעכט און מיט גערעכטיקײט, און מיט גענאָד און מיט באַרעמהאַרציקײט. <verse eid="HOS 2:21" /><verse number="22" style="v" pubnumber="2.20" sid="HOS 2:22" /> און איך װעל דיך פֿאַרקנַסן צו מיר מיט טרײַשאַפֿט, און װעסט דערקענען ה׳.<verse eid="HOS 2:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" pubnumber="2.21" sid="HOS 2:23" /> און עס װעט זײַן אין יענעם טאָג,</para>
  <para style="q" vid="HOS 2:23">װעל איך ענטפֿערן, זאָגט ה׳,</para>
  <para style="q" vid="HOS 2:23">װעל איך ענטפֿערן די הימלען,</para>
  <para style="q" vid="HOS 2:23">און זײ װעלן ענטפֿערן דער ערד,<verse eid="HOS 2:23" /></para>
  <para style="q">
    <verse number="24" style="v" pubnumber="2.22" sid="HOS 2:24" /> און די ערד װעט ענטפֿערן דער תּבֿואה,</para>
  <para style="q" vid="HOS 2:24">און דעם װײַן, און דעם אײל,</para>
  <para style="q" vid="HOS 2:24">און זײ װעלן ענטפֿערן יִזרְעֶאל.<verse eid="HOS 2:24" /></para>
  <para style="q">
    <verse number="25" style="v" pubnumber="2.23" sid="HOS 2:25" /> און איך װעל זי מיר אײַנזײען אין לאַנד,</para>
  <para style="q" vid="HOS 2:25">און איך װעל דערבאַרעמען די נישט דערבאַרעמטע,</para>
  <para style="q" vid="HOS 2:25">און װעל זאָגן צו נישט-מײַן-פֿאָלק: מײַן פֿאָלק ביסטו,</para>
  <para style="q" vid="HOS 2:25">און ער װעט זאָגן: מײַן ג-ט.<verse eid="HOS 2:25" /></para>
  <chapter eid="HOS 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="HOS 3" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1" />און ה׳ האָט צו מיר געזאָגט: גײ װידער האָב ליב אַ פֿרױ, געליבט פֿון אַ ליבהאָבער, אָבער אַ נואפֿטע; אַזױ װי ה׳ האָט ליב די קינדער פֿון יִשׂרָאֵל, און זײ קערן זיך צו פֿרעמדער ג‑טער, און האָבן ליב ראָזינקעסקוכנס.<verse eid="HOS 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2" />האָב איך זי מיר געקױפֿט פֿאַר פֿופֿצן זילבערשטיק, און אַ חוֹמֶר גערשטן, און אַ לֶתֶך גערשטן. <verse eid="HOS 3:2" /><verse number="3" style="v" sid="HOS 3:3" />און איך האָב צו איר געזאָגט: פֿיל טעג זאָלסטו מיר זיצן אַלײן, זאָלסט נישט מזַנה זײַן, און נישט געהערן צו קײן מאַן, און דעס גלײַכן איך קעגן דיר. <verse eid="HOS 3:3" /><verse number="4" style="v" sid="HOS 3:4" />װאָרעם פֿיל טעג װעלן די קינדער פֿון יִשׂרָאֵל זיצן אָן אַ מלך, און אָן אַ האַר, און אָן אַ שלאַכטאָפּפֿער, און אָן אַ זײַלשטײן, און אָן אַן אֵפֿוֹד און תּרָפֿים. <verse eid="HOS 3:4" /><verse number="5" style="v" sid="HOS 3:5" />דערנאָך װעלן די קינדער פֿון יִשׂרָאֵל זיך אומקערן, און זײ װעלן זוכן ה׳ זײער ג-ט, און דָוִד זײער מלך, און זײ װעלן אַנגסטן צו ה׳ און צו זײַן גוטס, אין סוף פֿון די טעג.<verse eid="HOS 3:5" /></para>
  <chapter eid="HOS 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="HOS 4" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 4:1" />הערט דאָס װאָרט פֿון ה׳, איר קינדער פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="HOS 4:1">װאָרעם ה׳ האָט אַ קריג מיט די באַװױנער פֿון לאַנד,</para>
  <para style="q" vid="HOS 4:1">װײַל קײן אמת און קײן גענאָד,</para>
  <para style="q" vid="HOS 4:1">און קײן דערקענונג פֿון אלֹקים איז נישטאָ אין לאַנד.<verse eid="HOS 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 4:2" />שװערן און לײקענען און טײטן</para>
  <para style="q" vid="HOS 4:2">און גנבֿען און מזנה זײַן, זײַנען פֿאַרשפּרײט,</para>
  <para style="q" vid="HOS 4:2">און בלוט אָן בלוט רירט זיך אָן.<verse eid="HOS 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 4:3" />דערום װער טרױערן דאָס לאַנד,</para>
  <para style="q" vid="HOS 4:3">און פֿאַרװעלקט װערן װעט איטלעכער װױנער דערין,</para>
  <para style="q" vid="HOS 4:3">מיט דער חיה פֿון פֿעלד, און מיטן פֿױגל פֿון הימל;</para>
  <para style="q" vid="HOS 4:3">און אַפֿילו די פֿישן פֿון ים װעלן אײַנגעטאָן װערן.<verse eid="HOS 4:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="HOS 4:4" />אָבער קײנער טאָר זיך נישט קריגן,</para>
  <para style="q" vid="HOS 4:4">און נישט שטראָפֿן טאָר קײנער,</para>
  <para style="q" vid="HOS 4:4">װאָרעם דײַן פֿאָלק זײַנען אַזעלכע</para>
  <para style="q" vid="HOS 4:4">װאָס קריגן זיך מיטן כּהן.<verse eid="HOS 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 4:5" />דערום װעסטו שטרױכלען בײַ טאָג,</para>
  <para style="q" vid="HOS 4:5">און אױך דער נבֿיא װעט געשטרױכלט װערן מיט דיר בײַ נאַכט,</para>
  <para style="q" vid="HOS 4:5">און איך װעל פֿאַרשנײַדן דײַן מוטער.<verse eid="HOS 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 4:6" />פֿאַרשניטן װערט מײַן פֿאָלק פֿון נישט װיסנשאַפֿט;</para>
  <para style="q" vid="HOS 4:6">װײַל דו האָסט פֿאַראַכט װיסנשאַפֿט,</para>
  <para style="q" vid="HOS 4:6">דערום האָב איך דיך פֿאַראַכט פֿון צו זײַן מיר אַ כּהן;</para>
  <para style="q" vid="HOS 4:6">אַז דו האָסט פֿאַרגעסן די תּורה פֿון דײַן ג-ט,</para>
  <para style="q" vid="HOS 4:6">װעל איך אױך פֿאַרגעסן אָן דײַנע קינדער.<verse eid="HOS 4:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HOS 4:7" />װי זײ האָבן זיך געמערט, אַזױ האָבן זײ געזינדיקט צו מיר;</para>
  <para style="q" vid="HOS 4:7">װעל איך זײער כּבֿוד אױף שאַנד אומבײַטן.<verse eid="HOS 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 4:8" />זײ עסן אױף די זינדאָפּפֿער פֿון מײַן פֿאָלק,</para>
  <para style="q" vid="HOS 4:8">און אױף זײער פֿאַרברעך קוקן זײ אױס.<verse eid="HOS 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 4:9" />דערום װעט זײַן, אַזױ דאָס פֿאָלק אַזױ דער כּהן,</para>
  <para style="q" vid="HOS 4:9">און איך װעל זיך רעכענען מיט אים פֿאַר זײַנע װעגן,</para>
  <para style="q" vid="HOS 4:9">און זײַנע מעשׂים װעל איך אים אומקערן.<verse eid="HOS 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 4:10" />און זײ װעלן עסן און נישט זאַט װערן,</para>
  <para style="q" vid="HOS 4:10">זײ זײַנען מזַנה, אָבער זײ װעלן זיך נישט מערן;</para>
  <para style="q" vid="HOS 4:10">װײַל זײ האָבן אױפֿגעהערט אױף ה׳ צו אַכטן.<verse eid="HOS 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 4:11" />זנות און װײַן און טרױבנזאַפֿט</para>
  <para style="q" vid="HOS 4:11">פֿאַרקנעכטיקן דאָס האַרץ.<verse eid="HOS 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 4:12" />מײַן פֿאָלק פֿרעגט בײַ זײ האָלץ,</para>
  <para style="q" vid="HOS 4:12">און זײַן שטעקן באַשײדט אים;</para>
  <para style="q" vid="HOS 4:12">װאָרעם אַ גײַסט פֿון זנות האָט פֿאַרפֿירט,</para>
  <para style="q" vid="HOS 4:12">און זײ האָבן זיך אָפּגעקערט פֿון אונטער זײער ג-ט.<verse eid="HOS 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 4:13" />אױף די שפּיצן בערג שלאַכטן זײ,</para>
  <para style="q" vid="HOS 4:13">און אױף די הײכן רײכערן זײ,</para>
  <para style="q" vid="HOS 4:13">אונטער אײכנבױם און טאָפּאָליע און טערעבינט,</para>
  <para style="q" vid="HOS 4:13">װײַל זײַן שאָטן איז גוט.</para>
  <para style="q" vid="HOS 4:13">דערום זײַנען אײַערע טעכטער מזַנה,</para>
  <para style="q" vid="HOS 4:13">און אײַערע שניר זײַנען אומגעטרײַ.<verse eid="HOS 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 4:14" />איך פֿאַרדענק נישט אײַערע טעכטער װאָס זײ זײַנען מזַנה,</para>
  <para style="q" vid="HOS 4:14">און אײַערע שניר װאָס זײ זײַנען אומגעטרײַ,</para>
  <para style="q" vid="HOS 4:14">װײַל די מענטשן אַלײן גײען מיט זוֹנות אַװעק,</para>
  <para style="q" vid="HOS 4:14">און מיט שאַנדװײַבער ברענגען זײ שלאַכטאָפּפֿער;</para>
  <para style="q" vid="HOS 4:14">און דאָס פֿאָלק װאָס פֿאַרשטײט נישט, װערט געשטרױכלט.<verse eid="HOS 4:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="HOS 4:15" />אױב דו יִשׂרָאֵל ביסט מזַנה,</para>
  <para style="q" vid="HOS 4:15">זאָל זיך יהוּדה נישט פֿאַרשולדיקן;</para>
  <para style="q" vid="HOS 4:15">און קומט נישט קײן גִלגָל,</para>
  <para style="q" vid="HOS 4:15">און גײט נישט אַרױף קײן בֵית-אָוֶן,</para>
  <para style="q" vid="HOS 4:15">און שװערט נישט: אַזױ װי ה׳ לעבט!<verse eid="HOS 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HOS 4:16" />װאָרעם אַזױ װי אַ װידערשפּעניקע קו</para>
  <para style="q" vid="HOS 4:16">האָט װידערשפּעניקט יִשׂרָאֵל;</para>
  <para style="q" vid="HOS 4:16">זאָל ה׳ זײ אַצונד פֿיטערן</para>
  <para style="q" vid="HOS 4:16">װי אַ שעפּס אין דערברײטערניש?<verse eid="HOS 4:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="HOS 4:17" />באַהעפֿט צו געצנבילדער איז אפֿרים,</para>
  <para style="q" vid="HOS 4:17">לאָז אים צו רו.<verse eid="HOS 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="HOS 4:18" />גײט אָפּ זײער שִכּרות,</para>
  <para style="q" vid="HOS 4:18">זײַנען זײ אין זנות פֿאַרזונקען;</para>
  <para style="q" vid="HOS 4:18">אײַנגעליבט אין שאַנד זײַנען אירע באַשיצער.<verse eid="HOS 4:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HOS 4:19" />דער װינט האָט זײ אײַנגעבונדן אין זײַנע פֿליגלען;</para>
  <para style="q" vid="HOS 4:19">און זײ װעלן זיך שעמען מיט זײערע שלאַכטאָפּפֿער.<verse eid="HOS 4:19" /></para>
  <chapter eid="HOS 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="HOS 5" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 5:1" />הערט דאָס צו, איר כּהנים,</para>
  <para style="q" vid="HOS 5:1">און פֿאַרנעמט, איר הױז פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="HOS 5:1">און איר הױז פֿון מלך, לײגט צו דאָס אױער,</para>
  <para style="q" vid="HOS 5:1">װאָרעם אױף אײַך איז אַ משפּט פֿאַראַן,</para>
  <para style="q" vid="HOS 5:1">װײַל אַ פּאַסטקע זײַט איר געװען פֿאַר מִצפָּה,</para>
  <para style="q" vid="HOS 5:1">און אַן אױסגעשפּרײטע נעץ אױף תָּבֿוֹר.<verse eid="HOS 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 5:2" />און די אָפּקערער זײַנען אין שעכטן פֿאַרטיפֿט,</para>
  <para style="q" vid="HOS 5:2">און איך בין געװען אַ שטראָף בײַ זײ אַלעמען.<verse eid="HOS 5:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="HOS 5:3" />איך קען אפֿרים,</para>
  <para style="q" vid="HOS 5:3">און יִשׂרָאֵל איז נישט פֿאַרהױלן פֿון מיר;</para>
  <para style="q" vid="HOS 5:3">װאָרעם אַצונד האָסטו מזַנה געװען, אפֿרים,</para>
  <para style="q" vid="HOS 5:3">פֿאַראומרײניקט געװאָרן איז יִשׂרָאֵל.<verse eid="HOS 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 5:4" />זײערע מעשׂים לאָזן זײ נישט</para>
  <para style="q" vid="HOS 5:4">זיך אומצוקערן צו זײער ג-ט,</para>
  <para style="q" vid="HOS 5:4">װאָרעם אַ גײַסט פֿון זנות איז אין זײ,</para>
  <para style="q" vid="HOS 5:4">און ה׳ קענען זײ נישט.<verse eid="HOS 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 5:5" />און דער שטאָלץ פֿון יִשׂרָאֵל װעט דערשׁפּאַַלט װערן פֿאַר זײַן פּנים,</para>
  <para style="q" vid="HOS 5:5">און יִשׂרָאֵל און אפֿרים װעלן געשטרױכלט װערן דורך זײער זינד,</para>
  <para style="q" vid="HOS 5:5">אױך יהוּדה טוט שטרױכלען מיט זײ.<verse eid="HOS 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 5:6" />מיט זײערע שאָף און מיט זײערע רינדער</para>
  <para style="q" vid="HOS 5:6">װעלן זײ גײן זוכן ה׳,</para>
  <para style="q" vid="HOS 5:6">אָבער זײ װעלן נישט געפֿינען –</para>
  <para style="q" vid="HOS 5:6">ער האָט זיך אָפּגעטאָן פֿון זײ.<verse eid="HOS 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 5:7" />זײ האָבן אָן ה׳ געפֿעלשט,</para>
  <para style="q" vid="HOS 5:7">װאָרעם פֿרעמדע קינדער האָבן זײ געבאָרן;</para>
  <para style="q" vid="HOS 5:7">אַצונד װעט זײ אַ חודש פֿאַרצערן מיט זײערע פֿעלדער.<verse eid="HOS 5:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="HOS 5:8" />בלאָזט אַ שופֿר אין גִבֿעָה, אַ טרומײטער אין רָמָה;</para>
  <para style="q" vid="HOS 5:8">שאַלט אין בֵית-אָוֶן: קוק זיך אום, בנימין!<verse eid="HOS 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 5:9" />אפֿרים װעט צו װיסט װערן אין טאָג פֿון שטראָף;</para>
  <para style="q" vid="HOS 5:9">אין די שבֿטים פֿון יִשׂרָאֵל טו איך עס צו װיסן אױף זיכער.<verse eid="HOS 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 5:10" />די האַרן פֿון יהוּדה זײַנען װי גרענעצפֿאַרכאַפּער,</para>
  <para style="q" vid="HOS 5:10">אױף זײ װעל איך אױסגיסן װי װאַסער מײַן צאָרן.<verse eid="HOS 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 5:11" />געדריקט װערט אפֿרים, צעבראָכן פֿון משפּט,</para>
  <para style="q" vid="HOS 5:11">װײַל ער איז װילנדיק געגאַנגען נאָך געבאָט.<verse eid="HOS 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 5:12" />און איך בין װי אַ מילב צו אפֿרים,</para>
  <para style="q" vid="HOS 5:12">און װי אַ פֿױלונג צו דעם הױז פֿון יהוּדה.<verse eid="HOS 5:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="HOS 5:13" />און אפֿרים האָט געזען זײַן קראַנקשאַפֿט,</para>
  <para style="q" vid="HOS 5:13">און יהוּדה זײַן װוּנד;</para>
  <para style="q" vid="HOS 5:13">איז אפֿרים געגאַנגען צו אשור,</para>
  <para style="q" vid="HOS 5:13">און האָט געשיקט צום מלך יָרֵב;</para>
  <para style="q" vid="HOS 5:13">אָבער ער קען אײַך נישט הײלן,</para>
  <para style="q" vid="HOS 5:13">און ער װעט נישט אָפּטאָן פֿון אײַך די װוּנד.<verse eid="HOS 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 5:14" />װאָרעם איך װעל זײַן װי אַ לײב צו אפֿרים,</para>
  <para style="q" vid="HOS 5:14">און װי אַ יונגלײב צום הױז פֿון יהוּדה;</para>
  <para style="q" vid="HOS 5:14">איך, איך װעל פֿאַרצוקן און אַװעקגײן,</para>
  <para style="q" vid="HOS 5:14">אַװעקטראָגן, און קײנער װעט נישט מציל זײַן.<verse eid="HOS 5:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="HOS 5:15" />איך װעל גײן, איך װעל זיך אומקערן צו מײַן אָרט,</para>
  <para style="q" vid="HOS 5:15">ביז זײ װעלן זיך שפּירן שולדיקן,</para>
  <para style="q" vid="HOS 5:15">און זוכן מײַן פּנים;</para>
  <para style="q" vid="HOS 5:15">אין זײער נױט װעלן זײ מיך פֿאָרשן.<verse eid="HOS 5:15" /></para>
  <chapter eid="HOS 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="HOS 6" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 6:1" />קומט און לאָמיר זיך אומקערן צו ה׳,</para>
  <para style="q" vid="HOS 6:1">װאָרעם ער האָט פֿאַרצוקט, און ער װעט אונדז הײלן,</para>
  <para style="q" vid="HOS 6:1">ער שלאָגט און ער װעט אונדז פֿאַרבינדן,<verse eid="HOS 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 6:2" />נאָך צװײ טעג װעט ער אונדז אױפֿלעבן,</para>
  <para style="q" vid="HOS 6:2">אױפֿן דריטן טאָג װעט ער אונדז אױפֿריכטן,</para>
  <para style="q" vid="HOS 6:2">און מיר װעלן לעבן פֿאַר אים.<verse eid="HOS 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 6:3" />און לאָמיר דערקענען, לאָמיר זיך יאָגן צו דערקענען ה׳;</para>
  <para style="q" vid="HOS 6:3">זיכער װי דער באַגינען איז זײַן אַרױסגאַנג;</para>
  <para style="q" vid="HOS 6:3">און ער װעט קומען צו אונדז װי דער רעגן,</para>
  <para style="q" vid="HOS 6:3">און װי שפּעטרעגן װאָס באַװאַסערט די ערד.<verse eid="HOS 6:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="HOS 6:4" />װאָס זאָל איך טאָן צו דיר, אפֿרים?</para>
  <para style="q" vid="HOS 6:4">װאָס זאָל איך טאָן צו דיר, יהוּדה?</para>
  <para style="q" vid="HOS 6:4">אַז אײַער גוצקײט איז װי אַ פֿרימאָרגנװאָלקן,</para>
  <para style="q" vid="HOS 6:4">און װי דער טױ װאָס פֿאַרגײט אין דער פֿרי.<verse eid="HOS 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 6:5" />דערום האָב איך געהאַקט דורך די נבֿיאים,</para>
  <para style="q" vid="HOS 6:5">זײ געהרגעט מיט די װערטער פֿון מײַן מױל;</para>
  <para style="q" vid="HOS 6:5">כּדי דײַן משפּט זאָל װי דאָס ליכט אַרױס.<verse eid="HOS 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 6:6" />װאָרעם חֶסֶד האָב איך באַגערט און נישט שלאַכטאָפּפֿער,</para>
  <para style="q" vid="HOS 6:6">און דערקענונג פֿון אלֹקים אײדער בראַנדאָפּפֿער.<verse eid="HOS 6:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HOS 6:7" />אָבער זײ װי אָדָם האָבן איבערגעטרעטן דעם ברית;</para>
  <para style="q" vid="HOS 6:7">אָן האָבן זײ געפֿעלשט אָן מיר.<verse eid="HOS 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 6:8" />גִלעָד איז אַ שטאָט פֿון אומרעכטטוער,</para>
  <para style="q" vid="HOS 6:8">אױסגעטרעטן מיט בלוט.<verse eid="HOS 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 6:9" />און װי באַנדעס װאָס לױערן אױף מענטשן,</para>
  <para style="q" vid="HOS 6:9">איז די חבֿרה פֿון די כּהנים;</para>
  <para style="q" vid="HOS 6:9">זײ טײטן אױפֿן װעג קײן שכֶם,</para>
  <para style="q" vid="HOS 6:9">יאָ, שענדלעכקײט באַגײען זײ.<verse eid="HOS 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 6:10" />אין הױז פֿון יִשׂרָאֵל האָב איך שױדערהאַפֿטיקס געזען,</para>
  <para style="q" vid="HOS 6:10">אָן איז זנות בײַ אפֿרים,</para>
  <para style="q" vid="HOS 6:10">פֿאַראומרײניקט איז יִשׂרָאֵל.<verse eid="HOS 6:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="HOS 6:11" />אױך אױף דיר, יהוּדה, האָט מען אַ שניט באַשערט.</para>
  <para style="b" vid="HOS 6:11" />
  <para style="q" vid="HOS 6:11">אַז איך װיל אומקערן די געפֿאַנגענשאַפֿט פֿון מײַן פֿאָלק,<verse eid="HOS 6:11" /></para>
  <chapter eid="HOS 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="HOS 7" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 7:1" />װי איך װיל הײלן יִשׂרָאֵל,</para>
  <para style="q" vid="HOS 7:1">אַזױ װערט אַנטפּלעקט די זינד פֿון אפֿרים,</para>
  <para style="q" vid="HOS 7:1">און די בײזן פֿון שוֹמרוֹן;</para>
  <para style="q" vid="HOS 7:1">װאָרעם זײ באַגײען פֿאַלשקײט,</para>
  <para style="q" vid="HOS 7:1">און אַ גנבֿ ברעכט אײַן,</para>
  <para style="q" vid="HOS 7:1">אַ באַנדע באַפֿאַלט אױף דער גאַס.<verse eid="HOS 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 7:2" />און זאָלן זײ זיך נישט טראַכטן אין זײער האַרצן,</para>
  <para style="q" vid="HOS 7:2">אַל דאָס בײז זײערס געדענק איך;</para>
  <para style="q" vid="HOS 7:2">אַצונד האָבן זײערע מעשׂים זײ אַרומגערינגלט,</para>
  <para style="q" vid="HOS 7:2">אַקעגן מײַן פּנים זײַנען זײ.<verse eid="HOS 7:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="HOS 7:3" />מיט זײער בײז דערפֿרײען זײ דעם מלך,</para>
  <para style="q" vid="HOS 7:3">און מיט זײערע ליגנס די האַרן.<verse eid="HOS 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 7:4" />אַלע זײַנען זײ נוֹאפֿים,</para>
  <para style="q" vid="HOS 7:4">װי אַן אױװן אָנגעהײצט פֿון בעקער,</para>
  <para style="q" vid="HOS 7:4">װאָס מע הערט בלױז אױף שאַרן</para>
  <para style="q" vid="HOS 7:4">פֿון פֿאַרקנעטן דעם טײג ביז זײַן זױער װערן.<verse eid="HOS 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 7:5" />אין דעם טאָג פֿון אונדזער מלך,</para>
  <para style="q" vid="HOS 7:5">זײַנען די האַרן קראַנק פֿון װײַנדערהיצונג;</para>
  <para style="q" vid="HOS 7:5">ער אַלײן שטרעקט אױס זײַן האַנט מיט די שפּעטער.<verse eid="HOS 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 7:6" />װאָרעם זײ האָבן צוגעברײט זײער האַרץ</para>
  <para style="q" vid="HOS 7:6">װי אַן אױװן אין זײער לױער;</para>
  <para style="q" vid="HOS 7:6">אַ גאַנצע נאַכט שלאָפֿט זײער בעקער,</para>
  <para style="q" vid="HOS 7:6">פֿרימאָרגנס ברענט ער אַזױ װי פֿלאַמפֿײַער.<verse eid="HOS 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 7:7" />זײ אַלע גליען װי אַן אױװן,</para>
  <para style="q" vid="HOS 7:7">און זײ פֿאַרצערן זײערע ריכטער;</para>
  <para style="q" vid="HOS 7:7">אַלע זײערע מלכים זײַנען געפֿאַלן,</para>
  <para style="q" vid="HOS 7:7">קײנער צװישן זײ רופֿט נישט צו מיר.<verse eid="HOS 7:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="HOS 7:8" />אפֿרים, ער מישט זיך מיט די פֿעלקער,</para>
  <para style="q" vid="HOS 7:8">אפֿרים איז געװאָרן אַ נישט איבערגעקערטער קוכן.<verse eid="HOS 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 7:9" />פֿרעמדע האָבן אױפֿגעגעסן זײַן כּוֹח,</para>
  <para style="q" vid="HOS 7:9">און ער מערקט נישט;</para>
  <para style="q" vid="HOS 7:9">שױן גראָע האָר דורכגעשפּריצט בײַ אים,</para>
  <para style="q" vid="HOS 7:9">און ער מערקט נישט.<verse eid="HOS 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 7:10" />און דער שטאָלץ פֿון יִשׂרָאֵל איז געבױגן פֿאַר זײַן פּנים,</para>
  <para style="q" vid="HOS 7:10">אָבער זײ קערן זיך נישט אום צו ה׳ זײער ג-ט,</para>
  <para style="q" vid="HOS 7:10">און זײ זוכן אים נישט בײַ אַלעם דעם.<verse eid="HOS 7:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="HOS 7:11" />און אפֿרים איז געװאָרן װי אַ נאַרישע טױב, אָן שׂכל,</para>
  <para style="q" vid="HOS 7:11">מִצרַיִם האָבן זײ גערופֿן,</para>
  <para style="q" vid="HOS 7:11">קײן אשור זײַנען זײ געגאַנגען.<verse eid="HOS 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 7:12" />װי זײ װעלן גײן, װעל איך אױסשפּרײטן אױף זײ מײַן נעץ,</para>
  <para style="q" vid="HOS 7:12">װי פֿױגלען פֿון הימל װעל איך זײ אַראָפּנידערן;</para>
  <para style="q" vid="HOS 7:12">איך װעל זײ שטראָפֿן װי איך האָב געלאָזט הערן זײער עדה.<verse eid="HOS 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 7:13" />װײ צו זײ, װאָס זײ זײַנען אַװעק פֿון מיר!</para>
  <para style="q" vid="HOS 7:13">פֿאַרװיסטונג אױף זײ, װאָס זײ האָבן געבראָכן אָן מיר!</para>
  <para style="q" vid="HOS 7:13">און איך זאָל זײ אױסלײזן,</para>
  <para style="q" vid="HOS 7:13">װען זײ האָבן גערעדט ליגנס אױף מיר?<verse eid="HOS 7:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="HOS 7:14" />און זײ שרײַען נישט צו מיר מיט זײער האַרצן,</para>
  <para style="q" vid="HOS 7:14">אַז זײ יאָמערן אױף זײערע געלעגערס;</para>
  <para style="q" vid="HOS 7:14">װעגן תּבֿואה און װײַן רודלען זײ זיך,</para>
  <para style="q" vid="HOS 7:14">אָן מיר װידערשפּעניקן זײ.<verse eid="HOS 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 7:15" />און איך האָב געלערנט,</para>
  <para style="q" vid="HOS 7:15">געשטאַרקט זײערע אָרעמס,</para>
  <para style="q" vid="HOS 7:15">אָבער זײ טראַכטן שלעכטס אױף מיר.<verse eid="HOS 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HOS 7:16" />זײ קערן זיך, אָבער נישט צו דער הײך,</para>
  <para style="q" vid="HOS 7:16">װי אַ פֿאַלשער בױגן זײַנען זײ געװאָרן.</para>
  <para style="q" vid="HOS 7:16">װעלן פֿאַלן דורכן שװערד זײערע האַרן</para>
  <para style="q" vid="HOS 7:16">פֿאַר דעם צאָרן פֿון זײער צונג;</para>
  <para style="q" vid="HOS 7:16">דאָס װעט זײַן אַ שפּאָט פֿון זײ אין לאַנד מִצרַיִם.<verse eid="HOS 7:16" /></para>
  <chapter eid="HOS 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="HOS 8" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 8:1" />צו דײַן גומען אַ שופֿר!</para>
  <para style="q" vid="HOS 8:1">װי אַן אָדלער קומט אױף ה׳ס הױז;</para>
  <para style="q" vid="HOS 8:1">װײַל זײ האָבן איבערגעטרעטן מײַן ברית,</para>
  <para style="q" vid="HOS 8:1">און קעגן מײַן תּורה פֿאַרבראָכן.<verse eid="HOS 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 8:2" />קען יִשׂרָאֵל דען שרײַען צו מיר:</para>
  <para style="q" vid="HOS 8:2">מײַן ג-ט, מיר קענען דיך?<verse eid="HOS 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 8:3" />יִשׂרָאֵל האָט פֿאַרלאָזט דאָס גוטס,</para>
  <para style="q" vid="HOS 8:3">זאָל אים דער פֿײַנט נאָכיאָגן.<verse eid="HOS 8:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="HOS 8:4" />זײ האָבן געמאַכט מלכים, אָבער אָן מיר,</para>
  <para style="q" vid="HOS 8:4">געמאַכט האַרן, און איך האָב נישט געװוּסט;</para>
  <para style="q" vid="HOS 8:4">פֿון זײער זילבער און זײער גאָלד</para>
  <para style="q" vid="HOS 8:4">האָבן זײ זיך געצנבילדער געמאַכט;</para>
  <para style="q" vid="HOS 8:4">דערום װעט ער פֿאַרשניטן װערן.<verse eid="HOS 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 8:5" />פֿאַרלאָזן װערט דײַן קאַלב, שוֹמרוֹן;</para>
  <para style="q" vid="HOS 8:5">מײַן צאָרן טוט גרימען אױף זײ;</para>
  <para style="q" vid="HOS 8:5">ביז װאַנען נאָך װעלן זײ נישט קענען זיך רײניקן?<verse eid="HOS 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 8:6" />װאָרעם עס קומט פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="HOS 8:6">און דאָס האָט אַ מײַנסטער געמאַכט,</para>
  <para style="q" vid="HOS 8:6">און קײן ג-ט איז דאָס נישט;</para>
  <para style="q" vid="HOS 8:6">פֿאַר װאָר, שפּענדלעך װעט װערן דאָס קאַלב פֿון שוֹמרוֹן.<verse eid="HOS 8:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HOS 8:7" />װאָרעם װינט זײען זײ,</para>
  <para style="q" vid="HOS 8:7">און שטורעם װעלן זײ שנײַדן;</para>
  <para style="q" vid="HOS 8:7">קײן זאַנג האָט עס נישט –</para>
  <para style="q" vid="HOS 8:7">אַ שפּראָצונג װאָס ברענגט נישט קײן מעל;</para>
  <para style="q" vid="HOS 8:7">טאָמער װעט עס ברענגען, װעלן עס פֿרעמדע אײַנשלינגען.<verse eid="HOS 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 8:8" />אײַנגעשלונגען געװאָרן איז יִשׂרָאֵל,</para>
  <para style="q" vid="HOS 8:8">אַצונד זײַנען זײ געװאָרן צװישן די פֿעלקער,</para>
  <para style="q" vid="HOS 8:8">װי אַ נישטװערטיקע כּלי.<verse eid="HOS 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 8:9" />װאָרעם זײ זײַנען אַרױפֿגעגאַנגען צו אשור,</para>
  <para style="q" vid="HOS 8:9">אַ װילדאײזל באַזונדער פֿאַר זיך;</para>
  <para style="q" vid="HOS 8:9">אפֿרים האָט ליבשאַפֿט געדונגען.<verse eid="HOS 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 8:10" />אָבער הגם זײ דינגען צװישן די פֿעלקער,</para>
  <para style="q" vid="HOS 8:10">װעל איך אַצונדערט זײ אײַנזאַמלען;</para>
  <para style="q" vid="HOS 8:10">און זײ װעלן אָנהײבן מינער װערן</para>
  <para style="q" vid="HOS 8:10">פֿון דער משׂא פֿון מלך און האַרן.<verse eid="HOS 8:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="HOS 8:11" />װאָרעם אפֿרים האָט געמערט מזבחות צום זינדיקן,</para>
  <para style="q" vid="HOS 8:11">בײַ אים זײַנען מזבחות צום זינדיקן געװען.<verse eid="HOS 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 8:12" />װי פֿיל פֿון מײַן תּורה איך זאָל אים שרײַבן,</para>
  <para style="q" vid="HOS 8:12">איז דאָס בײַ אים װי פֿרעמד פֿאַררעכנט.<verse eid="HOS 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 8:13" />מײַנע בראַנדאָפּפֿער זאָלן זײ שלאַכטן פֿאַר פֿלײש און עסן,</para>
  <para style="q" vid="HOS 8:13">ה׳ טוט זײ נישט באַפֿיליקן.</para>
  <para style="q" vid="HOS 8:13">אַצונד װעט ער געדענקען זײער פֿאַרברעך,</para>
  <para style="q" vid="HOS 8:13">און װעט רעכענען זײערע זינד;</para>
  <para style="q" vid="HOS 8:13">קײן מִצרַיִם װעלן זײ זיך אומקערן.<verse eid="HOS 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 8:14" />װאָרעם יִשׂרָאֵל האָט פֿאַרגעסן אָן זײַן באַשעפֿער,</para>
  <para style="q" vid="HOS 8:14">און האָט היכלות געבױט,</para>
  <para style="q" vid="HOS 8:14">און יהוּדה האָט געמערט באַפֿעסטיקטע שטעט:</para>
  <para style="q" vid="HOS 8:14">דערום װעל איך שיקן אַ פֿײַער אין זײַנע שטעט,</para>
  <para style="q" vid="HOS 8:14">און עס װעט פֿאַרצערן אירע פּאַלאַצן.<verse eid="HOS 8:14" /></para>
  <chapter eid="HOS 8" />
  <chapter number="9" style="c" pubnumber="ט" sid="HOS 9" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 9:1" />נישט פֿרײען זאָלסטו זיך, יִשׂרָאֵל,</para>
  <para style="q" vid="HOS 9:1">מיט שׂימחה אַזױ װי די פֿעלקער,</para>
  <para style="q" vid="HOS 9:1">װאָרעם האָסט זיך אָפּגעקערט פֿון דײַן ג-ט,</para>
  <para style="q" vid="HOS 9:1">האָסט ליב געהאַט זוֹנה-לױן אױף אַלע תּבֿואה דרעש-שײַער.<verse eid="HOS 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 9:2" />דער דרעש-שײַער און דער קעלטער װעט זײ נישט שפּײַזן,</para>
  <para style="q" vid="HOS 9:2">און דער פֿרישװײַן װעט פֿעלשן אָן זײ.<verse eid="HOS 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 9:3" />זײ װעלן נישט זיצן אין לאַנד פֿון ה׳,</para>
  <para style="q" vid="HOS 9:3">און אפֿרים װעט זיך קײן מִצרַיִם אומקערן,</para>
  <para style="q" vid="HOS 9:3">און אין אשור װעלן זײ אומרײנס עסן.<verse eid="HOS 9:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="HOS 9:4" />זײ װעלן נישט גיסן צו ה׳ װײַן,</para>
  <para style="q" vid="HOS 9:4">און נישט אָנגעלײגט װעלן אים זײַן זײערע שלאַכטאָפּפֿער,</para>
  <para style="q" vid="HOS 9:4">אַזױ װי ברױט פֿון אַבֿלות װעט עס זײ זײַן,</para>
  <para style="q" vid="HOS 9:4">אַלע װאָס עסן עס װעלן זיך פֿאַראומרײניקן;</para>
  <para style="q" vid="HOS 9:4">װאָרעם זײער ברױט װעט זײַן פֿאַר זײער לײַב,</para>
  <para style="q" vid="HOS 9:4">עס װעט נישט קומען אין הױז פֿון ה׳.<verse eid="HOS 9:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="HOS 9:5" />װאָס װעט איר טאָן אין אַ יוֹם-טובֿ,</para>
  <para style="q" vid="HOS 9:5">און אין אַ פֿײַערטאָג פֿון ה׳?<verse eid="HOS 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 9:6" />װאָרעם זע, זײ זײַנען אַװעק פֿון דעם בראָך,</para>
  <para style="q" vid="HOS 9:6">װעט מִצרַיִם זײ אײַנזאַמלען,</para>
  <para style="q" vid="HOS 9:6">מוֹף װעט זײ באַגראָבן;</para>
  <para style="q" vid="HOS 9:6">די שאַצן פֿון זײער זילבער, זײ װעט שטעכגעװעקס ירשען,</para>
  <para style="q" vid="HOS 9:6">דערנער װעלן זײַן אין זײערע געצעלטן.<verse eid="HOS 9:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HOS 9:7" />געקומען זײַנען די טעג פֿון רעכנשאַפֿט,</para>
  <para style="q" vid="HOS 9:7">געקומען די טעג פֿון באַצאָלונג;</para>
  <para style="q" vid="HOS 9:7">געװאָר װערן װעט יִשׂרָאֵל.</para>
  <para style="q" vid="HOS 9:7">אַ נאַר איז דער נבֿיא,</para>
  <para style="q" vid="HOS 9:7">משוגע איז דער מאַן פֿון גײַסט!</para>
  <para style="q" vid="HOS 9:7">פֿון װעגן דײַן גרױס זינד,</para>
  <para style="q" vid="HOS 9:7">און װײַל גרױס איז די פֿײַנטשאַפֿט.<verse eid="HOS 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 9:8" />דער װעכטער פֿון אפֿרים איז מיט מײַן ג-ט,</para>
  <para style="q" vid="HOS 9:8">דעם נבֿיא שטעלט ער אַ פּאַסטקע אױף אַלע זײַנע װעגן,</para>
  <para style="q" vid="HOS 9:8">פֿײַנטשאַפֿט אין הױז פֿון זײַן ג-ט.<verse eid="HOS 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 9:9" />טיף פֿאַרדאָרבן זײַנען זײ,</para>
  <para style="q" vid="HOS 9:9">אַזױ װי אין די טעג פֿון גִבֿעָה;</para>
  <para style="q" vid="HOS 9:9">ער װעט געדענקען זײער פֿאַרברעך,</para>
  <para style="q" vid="HOS 9:9">ער װעט רעכענען זײערע זינד.<verse eid="HOS 9:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="HOS 9:10" />װי װײַנטרױבן אין מדבר האָב איך געפֿונען יִשׂרָאֵל,</para>
  <para style="q" vid="HOS 9:10">װי אַן ערשטפֿרוכט פֿון פֿײַגנבױם אין זײַן אָנהײב</para>
  <para style="q" vid="HOS 9:10">האָב איך געזען אײַערע עלטערן;</para>
  <para style="q" vid="HOS 9:10">זײַנען זײ געקומען קײן בַעַל-פּעוֹר,</para>
  <para style="q" vid="HOS 9:10">און זיך אָפּגעשײדט צום שאַנדגעץ,</para>
  <para style="q" vid="HOS 9:10">און געװאָרן אומװערדיק װי דאָס װאָס זײ האָבן ליב געקראָגן.<verse eid="HOS 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 9:11" />אפֿרים – װי אַ פֿױגל װעט זײער כּבֿוד אַװעקפֿליען,</para>
  <para style="q" vid="HOS 9:11">אױס געבורט, און אױס מוטערלײַב, און אױס טראָגשאַפֿט!<verse eid="HOS 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 9:12" />אַפֿילו אַז זײ װעלן אױפֿברענגען זײערע קינדער,</para>
  <para style="q" vid="HOS 9:12">װעל איך זײ באַרױבן פֿון זײ,</para>
  <para style="q" vid="HOS 9:12">אַז קײן מענטש זאָל נישט בלײַבן;</para>
  <para style="q" vid="HOS 9:12">יאָ, װײ אױך צו זײ װען איך טו זיך אָפּ פֿון זײ!<verse eid="HOS 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 9:13" />אפֿרים, װי איך האָב צוֹר געזען,</para>
  <para style="q" vid="HOS 9:13">איז געפֿלאַנצט אין אַ שײנעם אָרט,</para>
  <para style="q" vid="HOS 9:13">אָבער אפֿרים װעט אַרױספֿירן</para>
  <para style="q" vid="HOS 9:13">זײַנע קינדער צום טײטער<verse eid="HOS 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 9:14" />גיב זײ, ה׳, װאָס דו דאַרפֿסט זײ געבן!</para>
  <para style="q" vid="HOS 9:14">גיב זײ אַ טראַכט װאָס פֿאַרװאַרפֿט, און בריסט פֿאַרדאַרטע!<verse eid="HOS 9:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="HOS 9:15" />אַל דאָס בײז זײערס איז אין גִלגָל,</para>
  <para style="q" vid="HOS 9:15">יאָ, דאָרט האָב איך זײ פֿײַנט געקראָגן;</para>
  <para style="q" vid="HOS 9:15">פֿאַר די בײזע מעשׂים זײערע</para>
  <para style="q" vid="HOS 9:15">װעל איך זײ פֿון מײַן הױז אַרױסטרײַבן;</para>
  <para style="q" vid="HOS 9:15">איך װעל זײ מער נישט ליב האָבן;</para>
  <para style="q" vid="HOS 9:15">אַלע זײערע האַרן זײַנען אָפּקערער.<verse eid="HOS 9:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="HOS 9:16" />געשלאָגן געװאָרן איז אפֿרים,</para>
  <para style="q" vid="HOS 9:16">זײער װאָרצל איז פֿאַרטריקנט,</para>
  <para style="q" vid="HOS 9:16">קײן פֿרוכט װעלן זײ נישט ברענגען;</para>
  <para style="q" vid="HOS 9:16">אַפֿילו אַז זײ װעלן געבערן,</para>
  <para style="q" vid="HOS 9:16">װעל איך טײטן די גלוסטיקע פֿון זײער לײַב.<verse eid="HOS 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HOS 9:17" />פֿאַראַכטן װעט זי מײַן ג-ט,</para>
  <para style="q" vid="HOS 9:17">װײַל זײ האָבן נישט צוגעהערט צו אים,</para>
  <para style="q" vid="HOS 9:17">און זײ װעלן אומװאָגלען צװישן די פֿעלקער.<verse eid="HOS 9:17" /></para>
  <chapter eid="HOS 9" />
  <chapter number="10" style="c" pubnumber="י" sid="HOS 10" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 10:1" />אַ פֿרוכטבאַר װײַנשטאָק איז יִשׂרָאֵל געװען,</para>
  <para style="q" vid="HOS 10:1">זײַן פֿרוכט פֿלעגט אַ װערדע האָבן;</para>
  <para style="q" vid="HOS 10:1">איז, װאָס מערער זײַן פֿרוכט, האָט ער מזבחות געמערט,</para>
  <para style="q" vid="HOS 10:1">װאָס שענער זײַן לאַנד, האָבן זײ שענערע זײַלשטײנער געמאַכט.<verse eid="HOS 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 10:2" />זײער האַרץ איז צעטײלט;</para>
  <para style="q" vid="HOS 10:2">אַצונד װעלן זײ זײער שולד לײַדן;</para>
  <para style="q" vid="HOS 10:2">ער װעט צעברעכן זײערע מזבחות,</para>
  <para style="q" vid="HOS 10:2">ער װעט פֿאַרװיסטן זײערע זײַלשטײנער.<verse eid="HOS 10:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="HOS 10:3" />פֿאַר װאָר, אַצונד װעלן זײ זאָגן:</para>
  <para style="q" vid="HOS 10:3">נישטאָ קײן מלך בײַ אונדז,</para>
  <para style="q" vid="HOS 10:3">װײַל מיר האָבן נישט מורא געהאַט פֿאַר ה׳;</para>
  <para style="q" vid="HOS 10:3">און דער מלך, װאָס קען טאָן פֿאַר אונדז?<verse eid="HOS 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 10:4" />זײ רעדן גערײדן,</para>
  <para style="q" vid="HOS 10:4">שװערן פֿאַלש, שליסן אַ ברית,</para>
  <para style="q" vid="HOS 10:4">אָבער דער משפּט װעט שפּראָצן װי ביטערקרױט</para>
  <para style="q" vid="HOS 10:4">אױף די בײַטן פֿון פֿעלד.<verse eid="HOS 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 10:5" />אום די קעלבער פֿון בֵית-אָוֶן</para>
  <para style="q" vid="HOS 10:5">װעלן אַנגסטן די װױנער פֿון שוֹמרוֹן;</para>
  <para style="q" vid="HOS 10:5">װאָרעם זײַן פֿאָלק טוט אױף אים טרױערן,</para>
  <para style="q" vid="HOS 10:5">און זײַנע פּריסטער װעלן ציטערן װעגן אים,</para>
  <para style="q" vid="HOS 10:5">װעגן זײַן כּבֿוד װאָס איז אַװעק פֿון אים.<verse eid="HOS 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 10:6" />אים אױך װעט מען קײן אשור אַװעקפֿירן,</para>
  <para style="q" vid="HOS 10:6">אַ מתּנה צום מלך שטרײטער;</para>
  <para style="q" vid="HOS 10:6">שאַנד װעט קריגן אפֿרים,</para>
  <para style="q" vid="HOS 10:6">און יִשׂרָאֵל װעט זיך שעמען מיט זײַן באַראָט.<verse eid="HOS 10:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HOS 10:7" />פֿאַרשניטן װערט דער מלך פֿון שוֹמרוֹן,</para>
  <para style="q" vid="HOS 10:7">אַזױ װי צװײַגל אױפֿן װאַסער.<verse eid="HOS 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 10:8" />און פֿאַרטיליקט װערן װעלן</para>
  <para style="q" vid="HOS 10:8">די בָמות פֿון אָוֶן, די זינד פֿון יִשׂרָאֵל;</para>
  <para style="q" vid="HOS 10:8">דערנער און װילדגעװעקס װעלן אױפֿגײן אױף זײערע מזבחות</para>
  <para style="q" vid="HOS 10:8">און זײ װעלן זאָגן צו די בערג: דעקט אונדז צו!</para>
  <para style="q" vid="HOS 10:8">און צו די הײכן: פֿאַלט אױף אונדז אַרױף!<verse eid="HOS 10:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="HOS 10:9" />מער װי אין די טעג פֿון גִבֿעָה</para>
  <para style="q" vid="HOS 10:9">האָסטו געזינדיקט, יִשׂרָאֵל;</para>
  <para style="q" vid="HOS 10:9">דאָרט האָט מען זיך אַקעגנגעשטעלט;</para>
  <para style="q" vid="HOS 10:9">פֿאַר זײ אָבער װעט נישט קלעקן</para>
  <para style="q" vid="HOS 10:9">אַ מלחמה װי אין גִבֿעָה אַקעגן די פֿאַרברעכער.<verse eid="HOS 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 10:10" />װען איך טו באַגערן, װעל איך זײ שטראָפֿן,</para>
  <para style="q" vid="HOS 10:10">און פֿעלקער װעלן זיך אײַנזאַמלען קעגן זײ,</para>
  <para style="q" vid="HOS 10:10">װען מע שפּאַנט זײ אין זײערע צװײ יאָכרינגען.<verse eid="HOS 10:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="HOS 10:11" />און אפֿרים איז אַ קאַלב אַ געניטס,</para>
  <para style="q" vid="HOS 10:11">צו דרעשן האָט עס ליב;</para>
  <para style="q" vid="HOS 10:11">אָבער איך בין אַריבערגעגאַנגען איבער איר פֿעטן האַלדז:</para>
  <para style="q" vid="HOS 10:11">איך װעל אײַנשפּאַנען אפֿרים,</para>
  <para style="q" vid="HOS 10:11">אַקערן זאָל יהוּדה,</para>
  <para style="q" vid="HOS 10:11">בראָנעװען זאָל יעקבֿ.<verse eid="HOS 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 10:12" />זײַט אײַך פֿאַר גערעכטיקײט,</para>
  <para style="q" vid="HOS 10:12">װעט איר שנײַדן לױט גענאָד;</para>
  <para style="q" vid="HOS 10:12">אַקערט אײַך אַן אַקער,</para>
  <para style="q" vid="HOS 10:12">װאָרעם עס איז צײַט צו זוכן ה׳,</para>
  <para style="q" vid="HOS 10:12">ביז ער װעט קומען און רעגענען אױף אײַך גערעכטיקײט.<verse eid="HOS 10:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="HOS 10:13" />איר האָט געאַקערט שלעכטס,</para>
  <para style="q" vid="HOS 10:13">האָט איר אומרעכט געשניטן,</para>
  <para style="q" vid="HOS 10:13">האָט איר געגעסן די פֿרוכט פֿון ליגן;</para>
  <para style="q" vid="HOS 10:13">װאָרעם האָסט זיך פֿאַרזיכערט אױף דײַן װעג,</para>
  <para style="q" vid="HOS 10:13">אױף די פֿיל גיבוֹרים דײַנע.<verse eid="HOS 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 10:14" />דערום װעט אױפֿשטײן אַ חורבֿן אױף דײַנע מחנות,</para>
  <para style="q" vid="HOS 10:14">און אַלע דײַנע פֿעסטונגען װעלן פֿאַרװיסט װערן,</para>
  <para style="q" vid="HOS 10:14">װי שַלמַן האָט פֿאַרװיסט בֵית-אַרבֵאל, אין טאָג פֿון מלחמה –</para>
  <para style="q" vid="HOS 10:14">מוטערס מיט קינדער זײַנען צעהאַקט געװאָרן.<verse eid="HOS 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 10:15" />אַזױ האָט געטאָן צו אײַך, בֵית-אֵל,</para>
  <para style="q" vid="HOS 10:15">פֿון װעגן אײַער בײזער שלעכטיקײט;</para>
  <para style="q" vid="HOS 10:15">אין אַ פֿרימאָרגן פֿאַרשניטן װערט פֿאַרשניטן</para>
  <para style="q" vid="HOS 10:15">דער מלך פֿון יִשׂרָאֵל.<verse eid="HOS 10:15" /></para>
  <chapter eid="HOS 10" />
  <chapter number="11" style="c" pubnumber="יא" sid="HOS 11" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 11:1" />אַז יִשׂרָאֵל איז יונג געװען האָב איך אים ליב געהאַט,</para>
  <para style="q" vid="HOS 11:1">און פֿון מִצרַיִם האָב איך גערופֿן מײַן זון.<verse eid="HOS 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 11:2" />װי זײ האָבן גערופֿן צו זײ,</para>
  <para style="q" vid="HOS 11:2">אַזױ זײַנען זײ אַװעק פֿון זײ;</para>
  <para style="q" vid="HOS 11:2">צו די בַעַל-געטער האָבן זײ געשלאַכט,</para>
  <para style="q" vid="HOS 11:2">און צו די געצן האָבן זײ גערײכערט.<verse eid="HOS 11:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="HOS 11:3" />און איך האָב געלערנט גײן אפֿרים,</para>
  <para style="q" vid="HOS 11:3">זײ פֿאַר זײערע אָרעמס גענומען,</para>
  <para style="q" vid="HOS 11:3">אָבער זײ האָבן נישט געמערקט</para>
  <para style="q" vid="HOS 11:3">אַז איך האָב זײ געװאַלט הײלן.<verse eid="HOS 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 11:4" />מיט מענטשלעכע שטריק האָב איך זײ צוגעצױגן,</para>
  <para style="q" vid="HOS 11:4">מיט שנורן פֿון ליבשאַפֿט,</para>
  <para style="q" vid="HOS 11:4">און איך בין זײ געװען</para>
  <para style="q" vid="HOS 11:4">װי די אַראָפּנעמער פֿון דעם יאָך אױף זײערע קינבאַקן:</para>
  <para style="q" vid="HOS 11:4">און עסן פֿלעג איך אים דערלאַנגען.<verse eid="HOS 11:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="HOS 11:5" />ער װעט זיך נישט אומקערן קײן לאַנד מִצרַיִם,</para>
  <para style="q" vid="HOS 11:5">אָבער אשור, ער װעט זײַן מלך זײַן,</para>
  <para style="q" vid="HOS 11:5">װײַל זײ האָבן נישט געװאָלט צוריקקערן.<verse eid="HOS 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 11:6" />און אַ שװערד װעט פֿאַלן אין זײַנע שטעט,</para>
  <para style="q" vid="HOS 11:6">און װעט פֿאַרלענדן זײַנע ריגלען און פֿאַרצערן,</para>
  <para style="q" vid="HOS 11:6">פֿון װעגן זײערע באַראָטונגען.<verse eid="HOS 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 11:7" />און מײַן פֿאָלק קװענקלט זיך אומצוקערן צו מיר,</para>
  <para style="q" vid="HOS 11:7">און מע רופֿט אים צו דער הײך,</para>
  <para style="q" vid="HOS 11:7">אָבער ער טוט זיך נישט דערהײבן.<verse eid="HOS 11:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="HOS 11:8" />װי קען איך דיך איבערגעבן, אפֿרים?</para>
  <para style="q" vid="HOS 11:8">דיך איבערענטפֿערן, יִשׂרָאֵל?</para>
  <para style="q" vid="HOS 11:8">װי קען איך דיך מאַכן װי אַדמָה?</para>
  <para style="q" vid="HOS 11:8">דיך לאָזן װערן װי צבֿואים?</para>
  <para style="q" vid="HOS 11:8">מײַן האַרץ קערט זיך אום אין מיר,</para>
  <para style="q" vid="HOS 11:8">מײַן גאַנצע רחמנות צינדט זיך אָן.<verse eid="HOS 11:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 11:9" />איך װעל נישט אױספֿירן מײַן גרימצאָרן,</para>
  <para style="q" vid="HOS 11:9">איך װעל מער נישט אומברענגען אפֿרים;</para>
  <para style="q" vid="HOS 11:9">װאָרעם אֵל בין איך און נישט אַ מענטש –</para>
  <para style="q" vid="HOS 11:9">דער הײליקער צװישן דיר –</para>
  <para style="q" vid="HOS 11:9">און איך װעל נישט קומען מיט צאָרן.<verse eid="HOS 11:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="HOS 11:10" />נאָך ה׳ װעלן זײ גײן –</para>
  <para style="q" vid="HOS 11:10">אַזױ װי אַ לײב װעט ער ברילן;</para>
  <para style="q" vid="HOS 11:10">יאָ, ער װעט ברילן,</para>
  <para style="q" vid="HOS 11:10">און די קינדער װעלן אײַלן פֿון מערבֿ.<verse eid="HOS 11:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 11:11" />זײ װעלן אײַלן װי אַ פֿױגל, פֿון מִצרַיִם,</para>
  <para style="q" vid="HOS 11:11">און װי אַ טױב, פֿון לאַנד אשור,</para>
  <para style="q" vid="HOS 11:11">און איך װעל זײ באַזעצן אין זײערע הײַזער,</para>
  <para style="q" vid="HOS 11:11">זאָגט ה׳.<verse eid="HOS 11:11" /></para>
  <chapter eid="HOS 11" />
  <chapter number="12" style="c" pubnumber="יב" sid="HOS 12" />
  <para style="q">
    <verse number="1" style="v" pubnumber="11.12" sid="HOS 12:1" /> אַרומגערינגלט מיט ליגן האָט מיך אפֿרים,</para>
  <para style="q" vid="HOS 12:1">און מיט באַטרוג דאָס הױז פֿון יִשׂרָאֵל;</para>
  <para style="q" vid="HOS 12:1">און יהוּדה הערשט נאָך מיט אֵל,</para>
  <para style="q" vid="HOS 12:1">און מיט דעם הײליקן געטרײַען.<verse eid="HOS 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" pubnumber="12.1" sid="HOS 12:2" /> אפֿרים לױפֿט נאָך װינט, און יאָגט זיך נאָך מזרח-װינט,</para>
  <para style="q" vid="HOS 12:2">אַ גאַנצן טאָג מערט ער ליגן און רױב;</para>
  <para style="q" vid="HOS 12:2">און אַ ברית מיט אשור שליסן זײ,</para>
  <para style="q" vid="HOS 12:2">און אײל װערט קײן מִצרַיִם געפֿירט.<verse eid="HOS 12:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="HOS 12:3" /> אָבער ה׳ האָט אַ קריג מיט יהוּדה,</para>
  <para style="q" vid="HOS 12:3">און װעט זיך רעכענען מיט יעקבֿ לױט זײַנע װעגן,</para>
  <para style="q" vid="HOS 12:3">לױט זײַנע מעשׂים װעט ער אים אומקערן.<verse eid="HOS 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="HOS 12:4" /> אין מוטערלײַב האָט ער בײַם טריט געכאַפּט זײַן ברודער,</para>
  <para style="q" vid="HOS 12:4">און מיט זײַן כּוֹח האָט ער זיך געראַנגלט מיט ג-ט;<verse eid="HOS 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="HOS 12:5" /> יאָ, ער האָט געשטריטן קעגן אַ מלאך און איז בײַגעקומען;</para>
  <para style="q" vid="HOS 12:5">ער האָט געװײנט און זיך געבעטן בײַ אים:</para>
  <para style="q" vid="HOS 12:5">אין בֵית-אֵל װעט ער אים טרעפֿן,</para>
  <para style="q" vid="HOS 12:5">און דאָרטן װעט ער רעדן מיט אים.<verse eid="HOS 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="HOS 12:6" /> און ה׳ איז אלוקי צבָֿאוֹת,</para>
  <para style="q" vid="HOS 12:6">ה׳ איז זײַן געדעכעניש.<verse eid="HOS 12:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="HOS 12:7" /> דערום זאָלסט דו צו דײַן ג-ט זיך אומקערן;</para>
  <para style="q" vid="HOS 12:7">פֿרומקײט און גערעכטיקײט היט אָפּ,</para>
  <para style="q" vid="HOS 12:7">און האָף צו דײַן ג-ט תּמיד.<verse eid="HOS 12:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="HOS 12:8" /> כּנַעַן האָט פֿאַלשע װאָגשאָלן אין זײַן האַנט,</para>
  <para style="q" vid="HOS 12:8">צו באַרױבן האָט ער ליב.<verse eid="HOS 12:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="HOS 12:9" /> און אפֿרים זאָגט: פֿאַר װאָר, איך בין רײַך,</para>
  <para style="q" vid="HOS 12:9">איך האָב מיר דערגרײכט אַ פֿאַרמעג;</para>
  <para style="q" vid="HOS 12:9">אין אַל מײַן מי װעט מען בײַ מיר נישט געפֿינען</para>
  <para style="q" vid="HOS 12:9">אַן אומרעכט װאָס איז אַ זינד.<verse eid="HOS 12:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="HOS 12:10" /> אָבער איך בין ה׳ דײַן ג-ט פֿון לאַנד מִצרַיִם אָן,</para>
  <para style="q" vid="HOS 12:10">איך װעל דיך װידער מאַכן װױנען אין געצעלטן,</para>
  <para style="q" vid="HOS 12:10">װי אין די טעג פֿון יענער צײַט.<verse eid="HOS 12:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="HOS 12:11" /> און איך האָב גערעדט צו די נבֿיאים,</para>
  <para style="q" vid="HOS 12:11">און איך האָב זעאונגען געמערט,</para>
  <para style="q" vid="HOS 12:11">און דורך די נבֿיאים פֿלעג איך משלים געבן.<verse eid="HOS 12:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="HOS 12:12" /> אַז גִלעָד איז נישטיקײט,</para>
  <para style="q" vid="HOS 12:12">לױטער פֿאַלשקײט זײַנען זײ געװאָרן!</para>
  <para style="q" vid="HOS 12:12">אין גִלגָל האָבן זײ אָקסן געשלאַכט;</para>
  <para style="q" vid="HOS 12:12">יאָ, זײערע מזבחות זײַנען װי הױפֿנס</para>
  <para style="q" vid="HOS 12:12">אױף די בײַטן פֿון פֿעלד.<verse eid="HOS 12:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="HOS 12:13" /> און יעקבֿ איז אַנטלאָפֿן אין פֿעלד פֿון אַרָם,</para>
  <para style="q" vid="HOS 12:13">און יִשׂרָאֵל האָט געדינט אום אַ װײַב,</para>
  <para style="q" vid="HOS 12:13">און אום אַ װײַב האָט ער שאָף געהיט.<verse eid="HOS 12:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="HOS 12:14" /> און דורך אַ נבֿיא האָט ה׳ אױפֿגעבראַכט יִשׂרָאֵל פֿון מִצרַיִם,</para>
  <para style="q" vid="HOS 12:14">און דורך אַ נבֿיא איז ער אָפּגעהיט געװאָרן.<verse eid="HOS 12:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="HOS 12:15" /> ביטער דערצערנט האָט אפֿרים,</para>
  <para style="q" vid="HOS 12:15">דערום װעט ער אױסלאָזן זײַן בלוט אױף אים,</para>
  <para style="q" vid="HOS 12:15">און זײַן לעסטערונג װעט אים אומקערן זײַן האַר.<verse eid="HOS 12:15" /></para>
  <chapter eid="HOS 12" />
  <chapter number="13" style="c" pubnumber="יג" sid="HOS 13" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 13:1" />אַז אפֿרים האָט גערעדט איז געװען אַ ציטערניש,</para>
  <para style="q" vid="HOS 13:1">דער הױב איז ער געװען אין יִשׂרָאֵל;</para>
  <para style="q" vid="HOS 13:1">האָט ער זיך פֿאַרשולדיקט מיט בַעַל, און איז געשטאָרבן.<verse eid="HOS 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 13:2" />און אַצונד זינדיקן זײ אַלץ מער,</para>
  <para style="q" vid="HOS 13:2">און האָבן זיך געמאַכט אַ געגאָסן בילד פֿון זײער זילבער,</para>
  <para style="q" vid="HOS 13:2">געצן לױט זײער שׂכל,</para>
  <para style="q" vid="HOS 13:2">דאָס װערק פֿון מײַנסטערס אַלע.</para>
  <para style="q" vid="HOS 13:2">אױף זײ קען מען זאָגן:</para>
  <para style="q" vid="HOS 13:2">מענטשן שעכטן זײ, קעלבער קושן זײ.<verse eid="HOS 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 13:3" />דערום װעלן זײ זײַן װי אַ פֿרימאָרגנװאָלקן,</para>
  <para style="q" vid="HOS 13:3">און װי דער טױ װאָס פֿאַרגײט אין דער פֿרי,</para>
  <para style="q" vid="HOS 13:3">װי שפּרײ װאָס װערט אַװעקגעבלאָזן פֿון דרעש-שײַער,</para>
  <para style="q" vid="HOS 13:3">און װי רױך דורכן פֿענצטער.<verse eid="HOS 13:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="HOS 13:4" />און איך בין ה׳ דײַן ג-ט פֿון לאַנד מִצרַיִם אָן,</para>
  <para style="q" vid="HOS 13:4">און קײן ג-ט אַחוץ מיר קענסט דו נישט,</para>
  <para style="q" vid="HOS 13:4">און נישטאָ קײן העלפֿער אױסער מיר.<verse eid="HOS 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 13:5" />איך האָב דיך דערקענט אין דער מדבר,</para>
  <para style="q" vid="HOS 13:5">אין אַ לאַנד פֿון טריקעניש.<verse eid="HOS 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 13:6" />װי זײ האָבן זיך געפֿיטערט, אַזױ זײַנען זײ זאַט געװאָרן;</para>
  <para style="q" vid="HOS 13:6">זײ זײַנען זאַט געװאָרן, און זײער האַרץ האָט זיך דערהױבן,</para>
  <para style="q" vid="HOS 13:6">דערפֿאַר האָבן זײ פֿאַרגעסן אָן מיר.<verse eid="HOS 13:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 13:7" />דערום בין איך צו זײ װי אַ לײב געװאָרן,</para>
  <para style="q" vid="HOS 13:7">װי אַ לעמפּערט אױפֿן װעג װעל איך לױערן;<verse eid="HOS 13:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 13:8" />איך װעל זײ באַגעגענען װי אַ בערינטע פֿון קינדער באַרױבט,</para>
  <para style="q" vid="HOS 13:8">און איך װעל אױפֿרײַסן דעם שײד פֿון זײער האַרצן,</para>
  <para style="q" vid="HOS 13:8">און װעל זײ אױפֿעסן דאָרטן װי אַ לײבינטע;</para>
  <para style="q" vid="HOS 13:8">די חיה פֿון פֿעלד װעט זײ צערײַסן.<verse eid="HOS 13:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="HOS 13:9" />אױ, ישׂראל, דו האָסט זיך אַלײן פֿאַרדאָרבן, װײַל דײַן הילף איז אין מיר,</para>
  <para style="q" vid="HOS 13:9">װאָס דו ביסט קעגן מיר, קעגן דײַן הילף.<verse eid="HOS 13:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 13:10" />װוּ דען איז דײַן מלך,</para>
  <para style="q" vid="HOS 13:10">ער זאָל דיך העלפֿן אין אַלע דײַנע שטעט?</para>
  <para style="q" vid="HOS 13:10">און דײַנע ריכטער, װאָס דו האָסט געזאָגט:</para>
  <para style="q" vid="HOS 13:10">גיב מיר אַ מלך און האַרן?<verse eid="HOS 13:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 13:11" />איך גיב דיר אַ מלך אין מײַן כּעס,</para>
  <para style="q" vid="HOS 13:11">און נעם אַװעק אין מײַן גרימצאָרן.<verse eid="HOS 13:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="HOS 13:12" />אײַנגעבונדן איז די זינד פֿון אפֿרים,</para>
  <para style="q" vid="HOS 13:12">באַהאַלטן איז זײַן חטא.<verse eid="HOS 13:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 13:13" />װײען פֿון אַ געװינערין װעלן קומען אױף אים;</para>
  <para style="q" vid="HOS 13:13">אַ נישט קלוג קינד איז ער,</para>
  <para style="q" vid="HOS 13:13">װאָרעם עס איז צײַט, ער זאָל נישט שטײן בלײַבן</para>
  <para style="q" vid="HOS 13:13">אין דעם געבעראָרט פֿון קינדער.<verse eid="HOS 13:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="HOS 13:14" />זאָל איך פֿון דער האַנט פֿון שְׁאֹול זײ אױסלײזן?</para>
  <para style="q" vid="HOS 13:14">זאָל איך פֿון טױט זײ אױסקױפֿן?</para>
  <para style="q" vid="HOS 13:14">װוּ זײַנען דײַנע מגפֿות, טױט?</para>
  <para style="q" vid="HOS 13:14">װוּ דײַן פּעסט, אונטערערד?</para>
  <para style="q" vid="HOS 13:14">דערבאַרעמונג זאָל פֿאַרבאָרגן זײַן פֿון מײַנע אױגן.<verse eid="HOS 13:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="HOS 13:15" />װאָרעם ער מעג װעט זײַן פֿרוכטבאַר צװישן די ברידער,</para>
  <para style="q" vid="HOS 13:15">דאָך װעט קומען אַ מזרח-װינט,</para>
  <para style="q" vid="HOS 13:15">אַ שטורעם פֿון ה׳ פֿון מדבר גײט אױף</para>
  <para style="q" vid="HOS 13:15">און טרוקן װערן װעט זײַן ברונעם,</para>
  <para style="q" vid="HOS 13:15">און אױסטריקענען װעט זײַן קװאַל;</para>
  <para style="q" vid="HOS 13:15">ער װעט צערױבן דעם שאַץ פֿון אַלע גלוסטיקע זאַכן.<verse eid="HOS 13:15" /></para>
  <chapter eid="HOS 13" />
  <chapter number="14" style="c" pubnumber="יד" sid="HOS 14" />
  <para style="q">
    <verse number="1" style="v" pubnumber="13.16" sid="HOS 14:1" /> פֿאַרשולדיקט איז שוֹמרוֹן,</para>
  <para style="q" vid="HOS 14:1">װאָרעם זי האָט װידערשפּעניקט אָן איר ג-ט;</para>
  <para style="q" vid="HOS 14:1">דורכן שװערד װעלן זײ פֿאַלן,</para>
  <para style="q" vid="HOS 14:1">זײערע קלײנע קינדער װעלן צעהאַקט װערן,</para>
  <para style="q" vid="HOS 14:1">און זײַנע טראָגעדיקע װעלן אױפֿגעשפּאָלטן װערן.<verse eid="HOS 14:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" pubnumber="14.1" sid="HOS 14:2" /> קער זיך אום, יִשׂרָאֵל, צו ה׳ דײַן ג-ט,</para>
  <para style="q" vid="HOS 14:2">װאָרעם האָסט געשטרױכלט דורך דײַנע זינד.<verse eid="HOS 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="HOS 14:3" /> נעמט מיט אײַך װערטער,</para>
  <para style="q" vid="HOS 14:3">און קערט אײַך אום צו ה׳;</para>
  <para style="q" vid="HOS 14:3">זאָגט צו אים: פֿאַרגיב אַלע זינד,</para>
  <para style="q" vid="HOS 14:3">און נעם אָן דאָס גוטע;</para>
  <para style="q" vid="HOS 14:3">און לאָמיר צאָלן אַנשטאָט אָקסן מיט אונדזערע ליפּן.<verse eid="HOS 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="HOS 14:4" /> אשור װעט אונדז נישט העלפֿן,</para>
  <para style="q" vid="HOS 14:4">אױף פֿערד װעלן מיר נישט רײַטן,</para>
  <para style="q" vid="HOS 14:4">און מיר װעלן מער נישט זאָגן: אלוקינו,</para>
  <para style="q" vid="HOS 14:4">צום װערק פֿון אונדזערע הענט;</para>
  <para style="q" vid="HOS 14:4">װאָרעם דורך דיר װערט דערבאַרעמט דער עלנדער.<verse eid="HOS 14:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="HOS 14:5" /> איך װעל הײלן זײער אָפּקערונג,</para>
  <para style="q" vid="HOS 14:5">איך װעל זײ ליב האָבן האַרציק,</para>
  <para style="q" vid="HOS 14:5">װאָרעם מײַן צאָרן האָט זיך אָפּגעקערט פֿון אים.<verse eid="HOS 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="HOS 14:6" /> איך װעל זײַן װי דער טױ צו יִשׂרָאֵל;</para>
  <para style="q" vid="HOS 14:6">ער װעט בליען װי אַ ליליע,</para>
  <para style="q" vid="HOS 14:6">און שלאָגן זײַנע װאָרצלען װי דער לבֿנוֹן.<verse eid="HOS 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="HOS 14:7" /> זײַנע צװײַגן װעלן זיך שפּרײטן,</para>
  <para style="q" vid="HOS 14:7">און זײַן גלאַנץ װעט זײַן װי פֿון אײלבערטבױם,</para>
  <para style="q" vid="HOS 14:7">און אַ ריח װעט ער האָבן װי דער לבֿנוֹן.<verse eid="HOS 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="HOS 14:8" /> די װאָס זיצן אין זײַן שאָטן</para>
  <para style="q" vid="HOS 14:8">װעלן װידער אױפֿברענגען תּבֿואה,</para>
  <para style="q" vid="HOS 14:8">און זײ װעלן בליען װי אַ װײַנשטאָק;</para>
  <para style="q" vid="HOS 14:8">זײַן דופֿט װי דער װײַן פֿון לבֿנוֹן.<verse eid="HOS 14:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="HOS 14:9" /> אפֿרים װעט זאָגן:</para>
  <para style="q" vid="HOS 14:9">װאָס קער איך זיך אָן מער מיט געצנבילדער.</para>
  <para style="q" vid="HOS 14:9">איך ענטפֿער, און װעל אים אָנקוקן;</para>
  <para style="q" vid="HOS 14:9">איך בין װי אַ צװײַגהאַפֿטיקער ציפּרעס;</para>
  <para style="q" vid="HOS 14:9">פֿון מיר װערט געקראָגן דײַן פֿרוכט.<verse eid="HOS 14:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="HOS 14:10" /> װער קלוג איז זאָל דאָס פֿאַרשטײן,</para>
  <para style="q" vid="HOS 14:10">װער פֿאַרשטאַנדיק זאָל עס מערקן,</para>
  <para style="q" vid="HOS 14:10">װאָרעם רעכטפֿאַרטיק זײַנען די װעגן פֿון ה׳,</para>
  <para style="q" vid="HOS 14:10">און די גערעכטע גײען אין זײ,</para>
  <para style="q" vid="HOS 14:10">און די פֿאַרברעכער װערן געשטרױכלט אין זײ.<verse eid="HOS 14:10" /></para>
  <chapter eid="HOS 14" />
</usx>