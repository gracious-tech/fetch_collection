<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2KI" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">מְלָכִים ב</para>
  <para style="toc2">מְלָכִים ב</para>
  <para style="toc1">מְלָכִים ב</para>
  <para style="mt1">מְלָכִים ב</para>
  <chapter number="1" style="c" pubnumber="א" sid="2KI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 1:1" />און מוֹאָבֿ האָט װידערשפּעניקט אָן יִשׂרָאֵל נאָך אַחאָבֿס טױט.<verse eid="2KI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 1:2" />און אַחַזיָה איז אַרױסגעפֿאַלן דורך דער גראַטע פֿון זײַן אױבערשטוב װאָס אין שוֹמרוֹן, און איז קראַנק געװאָרן. און ער האָט געשיקט שלוחים, און האָט זײ אָנגעזאָגט: גײט פֿרעגט בײַ בַעַל-זבֿוּבֿ דעם ג-ט פֿון עֶקרוֹן, אױב איך װעל גענעזן װערן פֿון דער דאָזיקער קראַנקשאַפֿט.<verse eid="2KI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 1:3" />און אַ מלאך פֿון ה׳ האָט גערעדט צו אֵלִיָהו דעם תִּשבי: שטײ אױף, גײ אַרױף אַנטקעגן די שלוחים פֿון דעם מלך פֿון שוֹמרוֹן, און רעד צו זײ: צי װײַל אין יִשׂרָאֵל איז קײן ג-ט נישטאָ, גײט איר פֿרעגן בײַ בַעַל-זבֿוּבֿ דעם ג-ט פֿון עֶקרוֹן? <verse eid="2KI 1:3" /><verse number="4" style="v" sid="2KI 1:4" />דרומעך האָט ה׳ אַזױ געזאָגט: דאָס בעט װאָס דו ביסט אַרױף אַהין, דערפֿון װעסטו נישט אַראָפּנידערן, נײַערט שטאַרבן װעסטו שטאַרבן. איז אֵלִיָהו געגאַנגען.<verse eid="2KI 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 1:5" />און די שלוחים האָבן זיך אומגעקערט צו אים, און ער האָט צו זײ געזאָגט: װאָס עפּעס האָט איר זיך אומגעקערט? <verse eid="2KI 1:5" /><verse number="6" style="v" sid="2KI 1:6" />האָבן זײ צו אים געזאָגט: אַ מאַן איז אַרױפֿגעקומען אונדז אַנטקעגן, און ער האָט צו אונדז געזאָגט: גײט קערט אײַך אום צו דעם מלך װאָס האָט אײַך געשיקט, און איר זאָלט רעדן צו אים: אַזױ האָט ה׳ געזאָגט: צי װײַל אין יִשׂרָאֵל איז קײן ג-ט נישטאָ, שיקסטו פֿרעגן בײַ בַעַל-זבֿוּבֿ דעם ג-ט פֿון עֶקרוֹן? דערום, דאָס בעט װאָס דו ביסט אַרױף אַהין, דערפֿון װעסטו נישט אַראָפּנידערן, נײַערט שטאַרבן װעסטו שטאַרבן.<verse eid="2KI 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 1:7" />האָט ער צו זײ גערעדט: װאָס איז דאָס אױסזען פֿון דעם מאַן װאָס איז אײַך אַרױפֿגעקומען אַנטקעגן; און האָט צו אײַך גערעדט די דאָזיקע רײד? <verse eid="2KI 1:7" /><verse number="8" style="v" sid="2KI 1:8" />האָבן זײ צו אים געזאָגט: אַ האָריקער מאַן מיט אַ פֿעלענעם גאַרטל אָנגעגורט אױף זײַנע לענדן. האָט ער געזאָגט דאָס איז אֵלִיָהו דער תִּשבי.<verse eid="2KI 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 1:9" />און ער האָט צו אים געשיקט אַ הױפּטמאַן פֿון פֿופֿציק מיט זײַנע פֿופֿציק. איז ער אַרױפֿגעגאַנגען צו אים, ערשט ער זיצט אױפֿן שפּיץ באַרג. האָט ער צו אים גערעדט: מאַן פֿון ג-ט, דער מלך האָט געזאָגט: נידער אַראָפּ. <verse eid="2KI 1:9" /><verse number="10" style="v" sid="2KI 1:10" />האָט אֵלִיָהו געענטפֿערט צו דעם הױפּטמאַן פֿון די פֿופֿציק: איז, אױב איך בין אַ מאַן פֿון ג-ט, זאָל אַראָפּנידערן אַ פֿײַער פֿון הימל, און פֿאַרצערן דיך און דײַנע פֿופֿציק. האָט אַראָפּגענידערט אַ פֿײַער פֿון הימל, און האָט פֿאַרצערט אים און זײַנע פֿופֿציק.<verse eid="2KI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 1:11" />האָט ער װידער געשיקט צו אים אַן אַנדער הױפּטמאַן פֿון פֿופֿציק מיט זײַנע פֿופֿציק. און ער האָט זיך אָפּגערופֿן און גערעדט צו אים: מאַן פֿון ג-ט, אַזױ האָט דער מלך געזאָגט: אײַל זיך נידער אַראָפּ. <verse eid="2KI 1:11" /><verse number="12" style="v" sid="2KI 1:12" />האָט אֵלִיָהו געענטפֿערט און האָט צו זײ גערעדט: אױב איך בין אַ מאַן פֿון ג-ט, זאָל אַראָפּנידערן אַ פֿײַער פֿון הימל, און פֿאַרצערן דיך און דײַנע פֿופֿציק. האָט אַראָפּגענידערט אַ פֿײַער פֿון הימל, און האָט פֿאַרצערט אים און זײַנע פֿופֿציק.<verse eid="2KI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 1:13" />האָט ער װידער געשיקט צו אים אַ הױפּטמאַן פֿון דריטע פֿופֿציק מיט זײַנע פֿופֿציק, און דער דריטער הױפּטמאַן פֿון פֿופֿציק איז אַרױפֿגעגאַנגען, און ער איז געקומען און האָט זיך געבוקט אױף זײַנע קני פֿאַר אֵלִיָהון, און ער האָט זיך בײַ אים געבעטן, און האָט צו אים גערעדט: מאַן פֿון ג-ט, זאָל, איך בעט דיך, מײַן נפֿש, און די נפֿשות פֿון די דאָזיקע פֿופֿציק קנעכט דײַנע, זײַן װערדיק אין דײַנע אױגן. <verse eid="2KI 1:13" /><verse number="14" style="v" sid="2KI 1:14" />זע, אַ פֿײַער האָט אַראָפּגענידערט פֿון הימל, און האָט פֿאַרצערט די צװײ פֿריִערדיקע הױפּטלײַט פֿון פֿופֿציק מיט זײערע פֿופֿציקן; און אַצונד, זאָל מײַן נפֿש זײַן װערדיק אין דײַנע אױגן.<verse eid="2KI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 1:15" />האָט אַ מלאך פֿון ה׳ גערעדט צו אֵלִיָהון: נידער אַראָפּ מיט אים; זאָלסט נישט מורא האָבן פֿאַר אים. איז ער אױפֿגעשטאַנען און האָט אַראָפּגענידערט מיט אים צום מלך.<verse eid="2KI 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 1:16" />און ער האָט צו אים גערעדט: אַזױ האָט ה׳ געזאָגט: אַזױ װי דו האָסט געשיקט שלוחים צו פֿרעגן בײַ בַעַל-זבֿוּבֿ דעם ג-ט פֿון עֶקרוֹן, איז דאָס װײַל אין יִשׂרָאֵל איז קײן ג-ט נישטאָ צו פֿרעגן זײַן װאָרט? דערום, דאָס בעט װאָס דו ביסט אַרױף אַהין, דערפֿון װעסטו נישט אַראָפּנידערן, נײַערט שטאַרבן װעסטו שטאַרבן.<verse eid="2KI 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 1:17" />און ער איז געשטאָרבן אַזױ װי דאָס װאָרט פֿון ה׳ װאָס אֵלִיָהו האָט גערעדט. און יהוֹרָם איז געװאָרן מלך אױף זײַן אָרט אין צװײטן יאָר פֿון יהוֹרָם דעם זון פֿון יהוֹשָפֿטן, דעם מלך פֿון יהוּדה; װײַל ער האָט קײן זון נישט געהאַט.<verse eid="2KI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 1:18" />און די איבעריקע זאַכן פֿון אַחַזיָהון װאָס ער האָט געטאָן, זײ זײַנען שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יִשׂרָאֵל.<verse eid="2KI 1:18" /></para>
  <chapter eid="2KI 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="2KI 2" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 2:1" />און עס איז געװען, װען ה׳ האָט געזאָלט אַרױפֿנעמען אֵלִיָהון אין אַ שטורעמװינט אױפֿן הימל, זײַנען אֶלישע און אֵלִיָהו געגאַנגען פֿון גִלגָל. <verse eid="2KI 2:1" /><verse number="2" style="v" sid="2KI 2:2" />האָט אֵלִיָהו געזאָגט צו אֶלישען: בלײַב דאָ, איך בעט דיך, װאָרעם ה׳ האָט מיך געשיקט ביז בֵית-אֵל. האָט אֶלישע געזאָגט: אַזױ װי ה׳ לעבט, און אַזױ װי דײַן זעל לעבט, אױב איך װעל דיך פֿאַרלאָזן! און זײ האָבן אַראָפּגענידערט קײן בֵית-אֵל.<verse eid="2KI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 2:3" />זײַנען אַרױסגעגאַנגען די יונגע נבֿיאים װאָס אין בֵית-אֵל צו אֶלישען, און האָבן צו אים געזאָגט: װײסטו אַז הײַנט נעמט ה׳ אַװעק דײַן האַר פֿון דײַן קאָפּ? האָט ער געזאָגט: יאָ, איך װײס; שװײַגט.<verse eid="2KI 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 2:4" />האָט אֵלִיָהו צו אים געזאָגט: אֶלישע, בלײַב דאָ, איך בעט דיך, װאָרעם ה׳ האָט מיך געשיקט קײן יריחוֹ. האָט ער געזאָגט: אַזױ װי ה׳ לעבט, און אַזױ װי דײַן זעל לעבט, אױב איך װעל דיך פֿאַרלאָזן. און זײ זײַנען געקומען קײן יריחוֹ.<verse eid="2KI 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 2:5" />האָבן גענענט די יונגע נבֿיאים װאָס אין יריחוֹ צו אֶלישען, און האָבן צו אים געזאָגט: װײסטו אַז הײַנט נעמט ה׳ אַװעק דײַן האַר פֿון דײַן קאָפּ? האָט ער געזאָגט: יאָ, איך װײס; שװײַגט.<verse eid="2KI 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 2:6" />האָט אֵלִיָהו צו אים געזאָגט: בלײַב דאָ, איך בעט דיך, װאָרעם ה׳ האָט מיך געשיקט ביזן יַרדן. האָט ער געזאָגט: אַזױ װי ה׳ לעבט, און אַזױ װי דײַן זעל לעבט, אױב איך װעל דיך פֿאַרלאָזן! און זײ זײַנען בײדע געגאַנגען.<verse eid="2KI 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 2:7" />זײַנען פֿופֿציק מאַן פֿון די יונגע נבֿיאים געגאַנגען, און האָבן זיך געשטעלט אַקעגן איבער פֿון דער װײַטן; און זײ בײדע זײַנען געשטאַנען בײַם יַרדן. <verse eid="2KI 2:7" /><verse number="8" style="v" sid="2KI 2:8" />האָט אֵלִיָהו גענומען זײַן מאַנטל, און צונױפֿגעװיקלט, און געשלאָגן דאָס װאַסער, און עס האָט זיך צעטײלט אַהין און אַהער, און זײ זײַנען בײדע אַריבערגעגאַנגען אין טריקעניש. <verse eid="2KI 2:8" /><verse number="9" style="v" sid="2KI 2:9" />און עס איז געװען, װי זײ זײַנען אַריבערגעגאַנגען, אַזױ האָט אֵלִיָהו געזאָגט צו אֶלישען: בעט װאָס איך זאָל דיר טאָן, אײדער איך װעל אַװעקגענומען װערן פֿון דיר. האָט אֶלישע געזאָגט: זאָל, איך בעט דיך, אַ צװײעדיקער טײל פֿון דײַן גײַסט זײַן אױף מיר.<verse eid="2KI 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 2:10" />האָט ער געזאָגט: האָסט אַ שװערע זאַך געבעטן. אױב דו װעסט מיך זען װען איך װער אַװעקגענומען פֿון דיר, װעט דיר אַזױ געשען, אױב אָבער נישט, װעט עס נישט געשען.<verse eid="2KI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 2:11" />און עס איז געװען, װי זײ גײען אַזױ, גײען און רעדן, ערשט אַ פֿײַערדיקער רײַטװאָגן מיט פֿײַערדיקע פֿערד, און זײ האָבן פֿונאַנדערגעשײדט צװישן זײ בײדן, און אֵלִיָהו איז אַרױף מיט אַ שטורעמװינט אין הימל. <verse eid="2KI 2:11" /><verse number="12" style="v" sid="2KI 2:12" />און װי אֶלישע האָט עס געזען, אַזױ האָט ער געשריִען: פֿאָטער מײַנער, פֿאָטער מײַנער, רײַטװעגן און רײַטער פֿון יִשׂרָאֵל! און ער האָט אים מער נישט געזען. האָט ער אָנגענומען זײַנע קלײדער, און האָט זײ צעריסן אױף צװײ שטיקער. <verse eid="2KI 2:12" /><verse number="13" style="v" sid="2KI 2:13" />און ער האָט אױפֿגעהױבן אֵלִיָהוס מאַנטל װאָס איז אַראָפּגעפֿאַלן פֿון אים, און האָט זיך אומגעקערט און זיך געשטעלט בײַם ברעג יַרדן. <verse eid="2KI 2:13" /><verse number="14" style="v" sid="2KI 2:14" />און ער האָט גענומען אֵלִיָהוס מאַנטל װאָס איז אַראָפּגעפֿאַלן פֿון אים, און האָט געשלאָגן דאָס װאַסער, און האָט געזאָגט: װוּ איז ה׳ אלוקי אֵלִיָהון? און אַז ער אױך האָט געשלאָגן דאָס װאַסער, האָט דאָס װאַסער זיך צעטײלט אַהין און אַהער, און אֶלישע איז אַריבערגעגאַנגען.<verse eid="2KI 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 2:15" />און די יונגע נבֿיאים װאָס פֿון יריחוֹ האָבן אים געזען פֿון אַ קעגן איבער, און זײ האָבן געזאָגט: דער גײַסט פֿון אֵלִיָהון רוט אױף אֶלישען. און זײ זײַנען אים געקומען אַנטקעגן, און האָבן זיך געבוקט פֿאַר אים צו דער ערד. <verse eid="2KI 2:15" /><verse number="16" style="v" sid="2KI 2:16" />און זײ האָבן צו אים געזאָגט: אָט, איך בעט דיך, זײַנען צװישן דײַנע קנעכט פֿופֿציק מאַן, העלדישע יונגען; זאָלן זײ גײן, איך בעט דיך, און זוכן דײַן האַר; טאָמער האָט אים דער גײַסט פֿון ה׳ פֿאַרטראָגן און אים פֿאַרװאָרפֿן אױף אײנעם פֿון די בערג, אָדער אין אײנעם פֿון די טאָלן. האָט ער געזאָגט: איר זאָלט נישט שיקן. <verse eid="2KI 2:16" /><verse number="17" style="v" sid="2KI 2:17" />זײַנען זײ צוגעשטאַנען צו אים ביז ער האָט זיך געשעמט, און ער האָט געזאָגט: שיקט. און זײ האָבן געשיקט פֿופֿציק מאַן, און זײ האָבן געזוכט דרײַ טעג, און האָבן אים נישט געפֿונען. <verse eid="2KI 2:17" /><verse number="18" style="v" sid="2KI 2:18" />האָבן זײ זיך אומגעקערט צו אים, װי ער איז געזעסן אין יריחוֹ; און ער האָט צו זײ געזאָגט: האָב איך אײַך נישט געזאָגט: איר זאָלט נישט גײן?<verse eid="2KI 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 2:19" />און די מענטשן פֿון דער שטאָט האָבן געזאָגט צו אֶלישען: זע נאָר, דער אָרט פֿון דער שטאָט איז אַ גוטער, אַזױ װי מײַן האַר זעט, אָבער דאָס װאַסער איז שלעכט, און דאָס לאַנד פֿאַרװאַרפֿט. <verse eid="2KI 2:19" /><verse number="20" style="v" sid="2KI 2:20" />האָט ער געזאָגט: ברענגט מיר אַ נײַע שיסל, און טוט אַרײַן אַהין זאַלץ. האָבן זײ עס אים געבראַכט. <verse eid="2KI 2:20" /><verse number="21" style="v" sid="2KI 2:21" />און ער איז אַרױסגעגאַנגען צו דעם אַרױסגאַנג פֿונעם װאַסער, און האָט אַהין אַרײַנגעװאָרפֿן זאַלץ, און געזאָגט: אַזױ האָט ה׳ געזאָגט: איך האָב געהײלט דאָס דאָזיקע װאַסער; מער זאָל פֿון דאָרטן נישט זײַן קײן טױט און קײן פֿאַרװאַרפֿערין. <verse eid="2KI 2:21" /><verse number="22" style="v" sid="2KI 2:22" />און דאָס װאַסער איז געהײלט געװאָרן ביז אױף הײַנטיקן טאָג, אַזױ װי דאָס װאָרט װאָס אֶלישע האָט גערעדט.<verse eid="2KI 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 2:23" />און ער איז אַרױפֿגעגאַנגען פֿון דאָרטן קײן בֵית-אֵל. און װי ער גײט אַרױף מיטן װעג, אַזױ זײַנען אַרױסגעגאַנגען פֿון שטאָט קלײנע ייִנגלעך, און האָבן געשפּעט פֿון אים, און האָבן צו אים געזאָגט: גײ אַרױף, פּליכקאָפּ! גײ אַרױף, פּליכקאָפּ! <verse eid="2KI 2:23" /><verse number="24" style="v" sid="2KI 2:24" />האָט ער זיך אומגעקערט הינטער זיך, און האָט זײ דערזען, און ער האָט זײ געשלאָגן אין נאָמען פֿון ה׳. זײַנען אַרױסגעקומען צװײ בערינטעס פֿון װאַלד, און האָבן צעריסן פֿון זײ צװײ און פֿערציק קינדער. <verse eid="2KI 2:24" /><verse number="25" style="v" sid="2KI 2:25" />און ער איז אַװעקגעגאַנגען פֿון דאָרטן צום באַרג כַּרמֶל, און פֿון דאָרטן האָט ער זיך אומגעקערט קײן שוֹמרוֹן.<verse eid="2KI 2:25" /></para>
  <chapter eid="2KI 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="2KI 3" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 3:1" />און יהוֹרָם דער זון פֿון אַחאָבֿן איז געװאָרן מלך איבער יִשׂרָאֵל אין שוֹמרוֹן אין אַכצענטן יאָר פֿון יהוֹשָפֿט דעם מלך פֿון יהוּדה; און ער האָט געקיניגט צװעלף יאָר.<verse eid="2KI 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 3:2" />און ער האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳, נאָר נישט אַזױ װי זײַן פֿאָטער און װי זײַן מוטער; װאָרעם ער האָט אָפּגעטאָן דעם זײַלשטײן פֿון בַעַל װאָס זײַן פֿאָטער האָט געמאַכט. <verse eid="2KI 3:2" /><verse number="3" style="v" sid="2KI 3:3" />אָבער ער איז געװען באַהעפֿט אָן די זינד פֿון יָרָבֿעָם דעם זון פֿון נבָֿטן, װאָס ער האָט געמאַכט זינדיקן יִשׂרָאֵל; ער האָט זיך נישט אָפּגעקערט דערפֿון.<verse eid="2KI 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 3:4" />און מֵישַע דער מלך פֿון מוֹאָבֿ האָט געהאַלטן שאָף, און ער פֿלעגט צאָלן דעם מלך פֿון יִשׂרָאֵל די װאָל פֿון הונדערט טױזנט לעמער און הונדערט טױזנט װידערס. <verse eid="2KI 3:4" /><verse number="5" style="v" sid="2KI 3:5" />און עס איז געװען, װי אַחאָבֿ איז געשטאָרבן, אַזױ האָט דער מלך פֿון מוֹאָבֿ װידערשפּעניקט אָן דעם מלך פֿון יִשׂרָאֵל. <verse eid="2KI 3:5" /><verse number="6" style="v" sid="2KI 3:6" />איז דער מלך יהוֹרָם אַרױסגעגאַנגען אין יענעם טאָג פֿון שוֹמרוֹן, און האָט איבערגעצײלט גאַנץ יִשׂרָאֵל. <verse eid="2KI 3:6" /><verse number="7" style="v" sid="2KI 3:7" />און ער איז געגאַנגען און האָט געשיקט צו יהוֹשָפֿט דעם מלך פֿון יהוּדה, אַזױ צו זאָגן: דער מלך פֿון מוֹאָבֿ האָט װידערשפּעניקט אָן מיר; װעסטו גײן מיט מיר אַקעגן מוֹאָבֿ אױף מלחמה? האָט ער געזאָגט: איך װעל אַרױפֿגײן; אַזױ װי דו אַזױ איך; אַזױ װי דײַן פֿאָלק אַזױ מײַן פֿאָלק; אַזױ װי דײַנע פֿערד אַזױ מײַנע פֿערד. <verse eid="2KI 3:7" /><verse number="8" style="v" sid="2KI 3:8" />האָט ער געפֿרעגט: מיט װאָסער װעג זאָלן מיר אַרױפֿגײן? האָט ער געזאָגט: מיטן װעג פֿון דעם מדבר פֿון אֶדוֹם.<verse eid="2KI 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 3:9" />איז געגאַנגען דער מלך פֿון יִשׂרָאֵל, און דער מלך פֿון יהוּדה, און דער מלך פֿון אֶדוֹם, און זײ האָבן זיך אַרומגעדרײט זיבן טעג װעגס, און עס איז נישט געװען קײן װאַסער פֿאַרן חיל, און פֿאַר די בהמות װאָס הינטער זײ. <verse eid="2KI 3:9" /><verse number="10" style="v" sid="2KI 3:10" />האָט דער מלך פֿון יִשׂרָאֵל געזאָגט: װײ! װאָרעם ה׳ האָט צונױפֿגערופֿן די דאָזיקע דרײַ מלכים, זײ צו געבן אין דער האַנט פֿון מוֹאָבֿ. <verse eid="2KI 3:10" /><verse number="11" style="v" sid="2KI 3:11" />האָט יהוֹשָפֿט געזאָגט: איז דאָ נישטאָ אַ נבֿיא פֿון ה׳, אַז מיר זאָלן פֿרעגן דורך אים בײַ ה׳? האָט זיך אָפּגערופֿן אײנער פֿון די קנעכט פֿון דעם מלך פֿון יִשׂרָאֵל, און האָט געזאָגט: דאָ איז דאָ אֶלישע דער זון פֿון שָפֿטן, װאָס האָט געגאָסן װאַסער אױף די הענט פֿון אֵלִיָהון. <verse eid="2KI 3:11" /><verse number="12" style="v" sid="2KI 3:12" />האָט יהוֹשָפֿט געזאָגט: בײַ אים איז דאָ דאָס װאָרט פֿון ה׳. און דער מלך פֿון יִשׂרָאֵל און יהוֹשָפֿט און דער מלך פֿון אֶדוֹם האָבן אַראָפּגענידערט צו אים. <verse eid="2KI 3:12" /><verse number="13" style="v" sid="2KI 3:13" />האָט אֶלישע געזאָגט צו דעם מלך פֿון יִשׂרָאֵל: װאָס קער איך זיך אָן מיט דיר? גײ צו די נבֿיאים פֿון דײַן פֿאָטער, און צו די נבֿיאים פֿון דײַן מוטער. האָט דער מלך פֿון יִשׂרָאֵל צו אים געזאָגט: ניטע! װאָרעם ה׳ האָט צונױפֿגערופֿן די דאָזיקע דרײַ מלכים, זײ צו געבן אין דער האַנט פֿון מוֹאָבֿ. <verse eid="2KI 3:13" /><verse number="14" style="v" sid="2KI 3:14" />האָט אֶלישע געזאָגט: אַזױ װי עס לעבט ה׳ צבָֿאוֹת װאָס איך שטײ פֿאַר אים, אַז װען איך שױן נישט דעם פּנים פֿון יהוֹשָפֿט דעם מלך פֿון יהוּדה, אױב איך װאָלט געקוקט אױף דיר, און אױב איך װאָלט דיך אָנגעזען! <verse eid="2KI 3:14" /><verse number="15" style="v" sid="2KI 3:15" />און אַצונד, ברענגט מיר אַ שפּילער. און עס איז געװען, װי דער שפּילער האָט געשפּילט, אַזױ איז אױף אים געװען די האַנט פֿון ה׳. <verse eid="2KI 3:15" /><verse number="16" style="v" sid="2KI 3:16" />און ער האָט געזאָגט: אַזױ האָט ה׳ געזאָגט: מאַכט דעם דאָזיקן טאָל גריבער אױף גריבער. <verse eid="2KI 3:16" /><verse number="17" style="v" sid="2KI 3:17" />װאָרעם אַזױ האָט ה׳ געזאָגט: איר װעט נישט זען קײן װינט, און נישט זען קײן רעגן, און דער דאָזיקער טאָל װעט אָנגעפֿילט װערן מיט װאַסער, און איר װעט טרינקען, איר און אײַערע פֿיך און אײַערע בהמות. <verse eid="2KI 3:17" /><verse number="18" style="v" sid="2KI 3:18" />און דאָס איז נאָך װינציק אין די אױגן פֿון ה׳; ער װעט אײַך געבן מוֹאָבֿ אין אײַער האַנט. <verse eid="2KI 3:18" /><verse number="19" style="v" sid="2KI 3:19" />און איר װעט שלאָגן יעטװעדער באַפֿעסטיקטע שטאָט, און יעטװעדער אױסדערװײלטע שטאָט; און יעטװעדער גוטן בױם װעט איר אײַנװאַרפֿן, און יעטװעדער קװאַל װאַסער װעט איר פֿאַרשטאָפּן, און יעטװעדער גוט שטיק פֿעלד װעט איר פֿאַרדאַרבן מיט שטײנער.<verse eid="2KI 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 3:20" />און עס איז געװען אין דער פֿרי, װען מע ברענגט אױף דעם קָרבָּן, ערשט װאַסער קומט אַרױס פֿון דעם װעג פֿון אֶדוֹם, און דאָס לאַנד איז פֿול געװאָרן מיטן װאַסער.<verse eid="2KI 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 3:21" />און גאַנץ מוֹאָבֿ האָבן געהערט אַז די מלכים זײַנען אַרױפֿגעקומען מלחמה צו האַלטן אױף זײ, און זײ האָבן זיך אײַנגעזאַמלט, פֿון איטלעכן װאָס גורט אָן אַן אָנגורט און העכער; און זײ האָבן זיך געשטעלט בײַם געמאַרק. <verse eid="2KI 3:21" /><verse number="22" style="v" sid="2KI 3:22" />און װי זײ האָבן זיך געפֿעדערט אין דער פֿרי, אַזױ האָט די זון געשײַנט אױפֿן װאַסער, און די מוֹאָבֿים האָבן געזען פֿון װײַטן דאָס װאַסער רױט אַזױ װי בלוט. <verse eid="2KI 3:22" /><verse number="23" style="v" sid="2KI 3:23" />האָבן זײ געזאָגט: בלוט איז דאָס; צעקריגן האָבן זיך צעקריגט די מלכים, און זײ האָבן געשלאָגן אײנער דעם אַנדערן. און אַצונד, צום רױב, מוֹאָבֿ!<verse eid="2KI 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 3:24" />און זײ זײַנען געקומען אין לאַגער פֿון יִשׂרָאֵל, און די יִשׂרָאֵל זײַנען אױפֿגעשטאַנען און האָבן געשלאָגן מוֹאָבֿ. <verse eid="2KI 3:24" /><verse number="25" style="v" sid="2KI 3:25" />און די שטעט האָבן זײ צעשטערט, און װוּ נאָר אַ גוט שטיק פֿעלד, האָבן זײ איטלעכער געװאָרפֿן אַ שטײן און האָבן עס אָנגעפֿילט, און יעטװעדער קװאַל װאַסער האָבן זײ פֿאַרשטאָפּט. און יעטװעדער גוטן בױם האָבן זײ אײַנגעװאָרפֿן, ביז זײ האָבן בלױז איבערגעלאָזן אירע מױערשטײנער אין קיר-חַרֶשֶת; און די שלײדערער האָבן זי אַרומגערינגלט, און האָבן זי צעשלאָגן.<verse eid="2KI 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 3:26" />און דער מלך פֿון מוֹאָבֿ האָט געזען אַז די מלחמה איז שטאַרקער פֿון אים, און ער האָט גענומען מיט זיך זיבן הונדערט מאַן װאָס ציִען אַ שװערד, כּדי דורכצוברעכן צו דעם מלך פֿון אֶדוֹם, אָבער זײ האָבן נישט געקענט. <verse eid="2KI 3:26" /><verse number="27" style="v" sid="2KI 3:27" />האָט ער גענומען זײַן זון דעם בכוֹר װאָס האָט געזאָלט קיניגן אַנשטאָט אים, און האָט אים אױפֿגעבראַכט פֿאַר אַ בראַנדאָפּפֿער אױף דער מױער. און עס איז געװאָרן אַ גרױסער צאָרן אױף יִשׂרָאֵל; און זײ האָבן אַװעקגעצױגן פֿון אים, און האָבן זיך אומגעקערט אין לאַנד.<verse eid="2KI 3:27" /></para>
  <chapter eid="2KI 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="2KI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 4:1" />און אײנע אַ פֿרױ פֿון די װײַבער פֿון די יונגע נבֿיאים האָט געשריִען צו אֶלישע, אַזױ צו זאָגן: דײַן קנעכט, מײַן מאַן, איז טױט; און דו װײסט אַז דײַן קנעכט איז געװען אַ ירא ה׳; און דער בַעַל-חובֿ איז געקומען נעמען צו זיך מײַנע צװײ קינדער פֿאַר קנעכט. <verse eid="2KI 4:1" /><verse number="2" style="v" sid="2KI 4:2" />האָט אֶלישע צו איר געזאָגט: װאָס זאָל איך דיר טאָן? זאָג מיר װאָס האָסטו אין הױז? האָט זי געזאָגט: דײַן דינסט האָט גאָרנישט אין הױז, נאָר בלױז אַ קריגל אײל. <verse eid="2KI 4:2" /><verse number="3" style="v" sid="2KI 4:3" />האָט ער געזאָגט: גײ באָרג דיר כּלים פֿון דערױסן, פֿון אַלע דײַנע שכנים, לײדיקע כּלים; זאָלסט נישט קאַרגן. <verse eid="2KI 4:3" /><verse number="4" style="v" sid="2KI 4:4" />און זאָלסט אַרײַנגײן און פֿאַרשליסן די טיר הינטער דיר און הינטער דײַנע זין, און זאָלסט אָנגיסן אין אַלע די דאָזיקע כּלים; און די פֿולע זאָלסטו אַװעקרוקן.<verse eid="2KI 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 4:5" />איז זי אַװעקגעגאַנגען פֿון אים, און זי האָט פֿאַרשלאָסן די טיר הינטער זיך און הינטער אירע זין: זײ האָבן איר דערלאַנגט, און זי האָט אָנגעגאָסן. <verse eid="2KI 4:5" /><verse number="6" style="v" sid="2KI 4:6" />און עס איז געװען, װי די כּלים זײַנען געװאָרן פֿול, אַזױ האָט זי געזאָגט צו איר זון: דערלאַנג מיר נאָך אַ כּלי. האָט ער צו איר געזאָגט: נישטאָ מער קײן כּלי. און דאָס אײל האָט זיך אָפּגעשטעלט.<verse eid="2KI 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 4:7" />איז זי געקומען, און האָט דערצײלט דעם מאַן פֿון ג-ט, און ער האָט געזאָגט: גײ פֿאַרקױף דאָס אײל, און באַצאָל דײַן חובֿ, און דו מיט דײַנע זין װעסט לעבן אױף דעם רעשט.<verse eid="2KI 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 4:8" />און עס איז געװען אײן טאָג, איז אֶלישע אַריבערגעגאַנגען קײן שוּנֵם, און דאָרטן איז געװען אַ רײַכע פֿרױ, האָט זי אים פֿאַרהאַלטן צו עסן ברױט. און עס איז געװען, אַז װען נאָר ער איז דורכגעגאַנגען, פֿלעגט ער פֿאַרקערן אַהין צו עסן ברױט. <verse eid="2KI 4:8" /><verse number="9" style="v" sid="2KI 4:9" />האָט זי געזאָגט צו איר מאַן: זע, איך בעט דיך, איך װײס אַז דאָס איז אַ הײליקער מאַן פֿון ג-ט װאָס גײט דורך בײַ אונדז תּמיד. <verse eid="2KI 4:9" /><verse number="10" style="v" sid="2KI 4:10" />לאָמיר מאַכן, איך בעט דיך, אַ קלײן געמױערט אײבערסטיבל, און לאָמיר דאָרטן אַװעקשטעלן פֿאַר אים אַ בעט, און אַ טיש און אַ שטול, און אַ לאָמפּ, און עס װעט זײַן, װי ער קומט צו אונדז, אַזױ װעט ער אײַנקערן אַהין.<verse eid="2KI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 4:11" />און עס איז געװען אײן טאָג, איז ער אַהין געקומען, און ער האָט אײַנגעקערט אין דער אױבערשטוב, און האָט זיך דאָרטן געלײגט. <verse eid="2KI 4:11" /><verse number="12" style="v" sid="2KI 4:12" />און ער האָט געזאָגט צו זײַן יונג גֵיחזי: רוף די דאָזיקע שוּנַמית. האָט ער זי גערופֿן, און זי האָט זיך געשטעלט פֿאַר אים.<verse eid="2KI 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 4:13" />האָט ער צו אים געזאָגט: זאָג אַקאָרשט צו איר: זע, דו האָסט געזאָרגט פֿון אונדזערט װעגן די דאָזיקע גאַנצע זאָרג; װאָס איז דאָ צו טאָן פֿאַר דיר? איז דאָ צו רעדן פֿאַר דיר צום מלך אָדער צום האַר פֿון חיל? האָט זי געזאָגט: צװישן מײַן שטאַם זיץ איך.<verse eid="2KI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 4:14" />האָט ער געזאָגט: װאָס איז פֿאָרט דאָ צו טאָן פֿאַר איר? האָט גֵיחזי געזאָגט: פֿאַר װאָר זי האָט נישט קײן קינד, און איר מאַן איז אַלט. <verse eid="2KI 4:14" /><verse number="15" style="v" sid="2KI 4:15" />האָט ער געזאָגט: רוף זי, און ער האָט זי גערופֿן, און זי האָט זיך געשטעלט אין טיר. <verse eid="2KI 4:15" /><verse number="16" style="v" sid="2KI 4:16" />האָט ער געזאָגט: אין דער צײַט, אַזױ װי איצט איבער אַ יאָר, װעסטו האַלדזן אַ זון. האָט זי געזאָגט: נײן, מײַן האַר מאַן פֿון ג-ט! זאָלסט נישט נאַרן דײַן דינסט.<verse eid="2KI 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 4:17" />און די פֿרױ איז טראָגעדיק געװאָרן, און זי האָט געבאָרן אַ זון אין דער צײַט אין אַ יאָר אַרום, אַזױ װי אֶלישע האָט צו איר גערעדט.<verse eid="2KI 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 4:18" />און דאָס קינד איז אױפֿגעװאַקסן; און עס איז געװען אײן טאָג, איז ער אַרױסגעגאַנגען צו זײַן פֿאָטער בײַ די שניטערס. <verse eid="2KI 4:18" /><verse number="19" style="v" sid="2KI 4:19" />און ער האָט געזאָגט צו זײַן פֿאָטער: מײַן קאָפּ, מײַן קאָפּ! האָט ער געזאָגט צום יונג: טראָג אים אַװעק צו זײַן מוטער. <verse eid="2KI 4:19" /><verse number="20" style="v" sid="2KI 4:20" />האָט ער אים אַװעקגעטראָגן און אים געבראַכט צו זײַן מוטער. און ער איז געזעסן אױף אירע קני ביז האַלבן טאָג, און איז געשטאָרבן. <verse eid="2KI 4:20" /><verse number="21" style="v" sid="2KI 4:21" />איז זי אַרױפֿגעגאַנגען, און האָט אים אַװעקגעלײגט אױפֿן בעט פֿון דעם מאַן פֿון ג-ט, און זי האָט אים פֿאַרשלאָסן, און איז אַרױסגעגאַנגען.<verse eid="2KI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 4:22" />און זי האָט גערופֿן צו איר מאַן און האָט געזאָגט: שיק מיר, איך בעט דיך, אײנעם פֿון די יונגען מיט אײנער פֿון די אײזעלינס, און איך װעל אַריבערלױפֿן צום מאַן פֿון ג-ט, און װעל זיך אומקערן. <verse eid="2KI 4:22" /><verse number="23" style="v" sid="2KI 4:23" />האָט ער צו איר געזאָגט: פֿאַר װאָס גײסטו צו אים הײַנט, נישט ראָש-חודש און נישט שבת? האָט זי געזאָגט: עס איז פֿריד.<verse eid="2KI 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 4:24" />און זי האָט אָנגעזאָטלט די אײזעלין, און האָט געזאָגט צו איר יונג: טרײַב און גײ; זאָלסט מיך נישט אױפֿהאַלטן אין רײַטן, סײַדן איך האָב דיר געהײסן.<verse eid="2KI 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 4:25" />און זי איז געגאַנגען און געקומען צום מאַן פֿון ג-ט אױפֿן באַרג כַּרמֶל. און עס איז געװען, װי דער מאַן פֿון ג-ט האָט זי דערזען פֿון װײַטן, אַזױ האָט ער געזאָגט צו זײַן יונג גֵיחזין: אָן איז יענע שוּנַמית. <verse eid="2KI 4:25" /><verse number="26" style="v" sid="2KI 4:26" />אַצונד לױף אַקאָרשט איר אַנטקעגן, און זאָג צו איר: איז פֿריד צו דיר? איז פֿריד צו דײַן מאַן? איז פֿריד צום קינד? האָט זי געזאָגט: פֿריד.<verse eid="2KI 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 4:27" />און זי איז געקומען צום מאַן פֿון ג-ט אױפֿן באַרג, און זי האָט זיך אָנגענומען אָן זײַנע פֿיס; האָט גֵיחזי גענענט זי אַװעקצושטױסן, אָבער דער מאַן פֿון ג-ט האָט געזאָגט: לאָז זי אָפּ, װאָרעם איר זעל איז פֿאַרביטערט, און ה׳ האָט פֿאַרהױלן פֿון מיר, און האָט מיר נישט דערצײלט.<verse eid="2KI 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 4:28" />האָט זי געזאָגט: האָב איך דען געבעטן אַ זון בײַ מײַן האַר? האָב איך נישט געזאָגט: זאָלסט מיך נישט גענאַרן?<verse eid="2KI 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 4:29" />האָט ער געזאָגט צו גֵיחזין: גורט אָן דײַנע לענדן, און נעם מײַן שטעקן אין דײַן האַנט, און גײ; אַז דו װעסט אָנטרעפֿן עמיצן, זאָלסטו אים נישט באַגריסן, און אַז עמעצער װעט דיך באַגריסן, זאָלסטו אים נישט ענטפֿערן; און זאָלסט אַרױפֿטאָן מײַן שטעקן אױפֿן ייִנגלס פּנים.<verse eid="2KI 4:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 4:30" />האָט געזאָגט די מוטער פֿון ייִנגל: אַזױ װי ה׳ לעבט, און אַזױ װי דײַן זעל לעבט, אױב איך װעל דיך אָפּלאָזן! איז ער אױפֿגעשטאַנען און איז געגאַנגען נאָך איר.<verse eid="2KI 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 4:31" />און גֵיחזי איז אַװעקגעגאַנגען זײ פֿאַרױס, און האָט אַרױפֿגעטאָן דעם שטעקן אױפֿן ייִנגלס פּנים, אָבער קײן קֹול און קײן הערונג. האָט ער זיך אומגעקערט אים אַנטקעגן, און האָט אים דערצײלט, אַזױ צו זאָגן: דער ייִנגל האָט זיך נישט אױפֿגעכאַפּט.<verse eid="2KI 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 4:32" />און אֶלישע איז געקומען אין הױז, ערשט דער ייִנגל איז טױט, אַװעקגעלײגט אױף זײַן בעט. <verse eid="2KI 4:32" /><verse number="33" style="v" sid="2KI 4:33" />איז ער אַרײַנגעגאַנגען און האָט פֿאַרשלאָסן די טיר הינטער זײ צװײען, און ער האָט מתפּלל געװען צו ה׳. <verse eid="2KI 4:33" /><verse number="34" style="v" sid="2KI 4:34" />און ער איז אַרױף און האָט זיך געלײגט איבערן קינד, און האָט אַרױפֿגעטאָן זײַן מױל אױף זײַן מױל, און זײַנע אױגן אױף זײַנע אױגן, און זײַנע הענט אױף זײַנע הענט, און ער האָט זיך אױסגעצױגן אױף אים, ביז דער לײַב פֿון ייִנגל איז געװאָרן װאַרעם. <verse eid="2KI 4:34" /><verse number="35" style="v" sid="2KI 4:35" />און ער האָט זיך אומגעקערט, און איז אומגעגאַנגען אין הױז אײן מאָל אַהין און אײן מאָל אַהער; און ער איז אַרױף און האָט זיך אױסגעצױגן אױף אים; און דער ייִנגל האָט גענאָסן ביז זיבן מאָל, און דער ייִנגל האָט אױפֿגעמאַכט זײַנע אױגן.<verse eid="2KI 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 4:36" />האָט ער גערופֿן גֵיחזין, און האָט געזאָגט: רוף די דאָזיקע שוּנַמית. האָט ער זי גערופֿן, און זי איז אַרײַנגעקומען צו אים; האָט ער געזאָגט: נעם דײַן זון.<verse eid="2KI 4:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2KI 4:37" />איז זי צוגעקומען, און איז געפֿאַלן צו זײַנע פֿיס, און האָט זיך געבוקט צו דער ערד. און זי האָט גענומען איר זון, און איז אַרױסגעגאַנגען.<verse eid="2KI 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2KI 4:38" />און אֶלישע האָט זיך אומגעקערט קײן גִלגָל; און אַ הונגער איז געװען אין לאַנד; און די יונגע נבֿיאים זײַנען געזעסן פֿאַר אים; האָט ער געזאָגט צו זײַן יונג: שטעל צו דעם גרױסן טאָפּ, און קאָך אָפּ אַ געקעכטס פֿאַר די יונגע נבֿיאים. <verse eid="2KI 4:38" /><verse number="39" style="v" sid="2KI 4:39" />איז אײנער אַרױסגעגאַנגען אין פֿעלד קלײַבן קרײַטעכער, און ער האָט געפֿונען אַ פֿעלדבײמל און האָט אָנגעקליבן דערפֿון װילדע אוגערקעס אַ פֿול קלײד זײַנס. און ער איז געקומען און האָט עס אַרײַנגעשניטן אין טאָפּ געקעכטס; װײַל זײ האָבן עס נישט געקענט. <verse eid="2KI 4:39" /><verse number="40" style="v" sid="2KI 4:40" />האָט מען אַרײַנגעגאָסן די מענטשן צום עסן; און עס איז געװען, װי זײ האָבן געגעסן פֿון דעם געקעכטס, אַזױ האָבן זײ אױסגעשריִען און געזאָגט: טױט איז אין טאָפּ, מאַן פֿון ג-ט. און זײ האָבן נישט געקענט עסן. <verse eid="2KI 4:40" /><verse number="41" style="v" sid="2KI 4:41" />האָט ער געזאָגט: טאָ ברענגט מעל. און ער האָט אַרײַנגעשאָטן אין טאָפּ, און האָט געזאָגט: גיס אַרײַן פֿאַר די מענטשן, און זאָלן זײ עסן. און קײן שום בײז איז אין טאָפּ נישט געװען.<verse eid="2KI 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="2KI 4:42" />און אַ מאַן איז געקומען פֿון בַעַל-שָלִשָה, און האָט געבראַכט דעם מאַן פֿון ג-ט ברױט פֿון ערשטער תּבֿואה, צװאַנציק גערשטענע ברױטן, און פֿרישע זאַנגען אין זײַן זאַק. האָט ער געזאָגט: גיב די מענטשן און זאָלן זײ עסן. <verse eid="2KI 4:42" /><verse number="43" style="v" sid="2KI 4:43" />האָט זײַן משרת געזאָגט: װי קען איך דאָס דערלאַנגען פֿאַר הונדערט מאַן? האָט ער געזאָגט: גיב די מענטשן, און זאָלן זײ עסן. װאָרעם אַזױ האָט ה׳ געזאָגט: זײ װעלן עסן און נאָך איבערלאָזן. <verse eid="2KI 4:43" /><verse number="44" style="v" sid="2KI 4:44" />און ער האָט דערלאַנגט פֿאַר זײ, און זײ האָבן געגעסן און נאָך איבערגעלאָזן, אַזױ װי דאָס װאָרט פֿון ה׳.<verse eid="2KI 4:44" /></para>
  <chapter eid="2KI 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="2KI 5" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 5:1" />און נַעֲמָן דער חיל-לידער פֿון דעם מלך פֿון אַרָם איז געװען אַ גרױסער מאַן בײַ זײַן האַר, און אָנגעזען, װאָרעם דורך אים האָט ה׳ געגעבן אַ גרױסע ישועה צו אַרָם. און דער מאַן איז געװען אַ העלדישער גיבור, אָבער אַ מצוֹרע.<verse eid="2KI 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 5:2" />און די אַרַמים זײַנען אַרױסגעגאַנגען אין באַנדעס, און האָבן געפֿאַנגען פֿון לאַנד יִשׂרָאֵל אַ קלײן מײדל; און זי האָט באַדינט נַעֲמָנס װײַב. <verse eid="2KI 5:2" /><verse number="3" style="v" sid="2KI 5:3" />האָט זי געזאָגט צו איר האַרינטע: הלװאַי איז מײַן האַר בײַ דעם נבֿיא װאָס אין שוֹמרוֹן; ער װאָלט אים דענצמאָל אױסגעהײלט פֿון זײַן צרעת.<verse eid="2KI 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 5:4" />איז ער געקומען און האָט דערצײלט זײַן האַר, אַזױ צו זאָגן: אַזױ און אַזױ האָט גערעדט די מײדל װאָס פֿון לאַנד יִשׂרָאֵל. <verse eid="2KI 5:4" /><verse number="5" style="v" sid="2KI 5:5" />האָט דער מלך פֿון אַרָם געזאָגט: קום גײ, און איך װעל שיקן אַ בריװ צו דעם מלך פֿון יִשׂרָאֵל. איז ער געגאַנגען און ער האָט גענומען מיט זיך צען צענטנער זילבער, און זעקס טױזנט גאָלדשטיק, און צען גאַנג קלײדער. <verse eid="2KI 5:5" /><verse number="6" style="v" sid="2KI 5:6" />און ער האָט געבראַכט דעם בריװ צו דעם מלך פֿון יִשׂרָאֵל, אַזױ צו זאָגן: און אַצונד, װי דער דאָזיקער בריװ קומט צו דיר, אָט האָב איך דיר געשיקט מײַן קנעכט נַעֲמָנען, זאָלסטו אים אױסהײלן פֿון זײַן צרעת.<verse eid="2KI 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 5:7" />און עס איז געװען, װי דער מלך פֿון יִשׂרָאֵל האָט איבערגעלײענט דעם בריװ, אַזױ האָט ער צעריסן זײַנע קלײדער, און האָט געזאָגט: בין איך דען האלֹקים צו טײטן און צו מאַכן לעבעדיק, אַז דער דאָזיקער שיקט צו מיר, צו הײלן אַ מענטש פֿון זײַן צרעת? יאָ, מערקט נאָר, איך בעט אײַך, און זעט, אַז אַן אױסרײד ער זוכט אַקעגן מיר.<verse eid="2KI 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 5:8" />און עס איז געװען, װי אֶלישע דער מאַן פֿון ג-ט האָט געהערט אַז דער מלך פֿון יִשׂרָאֵל האָט צעריסן זײַנע קלײדער, האָט ער געשיקט צום מלך, אַזױ צו זאָגן: פֿאַר װאָס האָסטו צעריסן דײַנע קלײדער? זאָל ער אַקאָרשט קומען צו מיר, און ער װעט װיסן אַז עס איז דאָ אַ נבֿיא אין יִשׂרָאֵל.<verse eid="2KI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 5:9" />איז נַעֲמָן געקומען מיט זײַנע פֿערד און מיט זײַנע רײַטװעגן, און האָט זיך געשטעלט פֿאַר דעם אײַנגאַנג פֿון אֶלישעס הױז.<verse eid="2KI 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 5:10" />האָט אֶלישע געשיקט צו אים אַ שליח, אַזױ צו זאָגן: גײ, און זאָלסט זיך באָדן זיבן מאָל אין יַרדן, און דײַן לײַב װעט זיך אומקערן צו דיר, און װעסט װערן רײן.<verse eid="2KI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 5:11" />האָט נַעֲמָן געצערנט, און ער איז אַװעקגעגאַנגען, און האָט געזאָגט: זע, איך האָב געמײנט, אַרױסגײן װעט ער אַרױסגײן צו מיר, און װעט זיך אַװעקשטעלן און װעט רופֿן דעם נאָמען פֿון ה׳ זײַן ג-ט, און פֿאָכן מיט זײַן האַנט אױף דעם אָרט, און אַװעקנעמען די צרעת. <verse eid="2KI 5:11" /><verse number="12" style="v" sid="2KI 5:12" />זײַנען נישט אַמָנָה און פַּרפַּר, די טײַכן פֿון דַמֶשֶׂק בעסער פֿון אַלע װאַסערן פֿון יִשׂרָאֵל? קען איך זיך נישט באָדן אין זײ, און װערן רײן? און ער האָט זיך אומגעקערט און איז אַװעקגעגאַנגען מיט גרימצאָרן.<verse eid="2KI 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 5:13" />האָבן זײַנע קנעכט גענענט, און האָבן גערעדט און צו אים געזאָגט: מײַן פֿאָטער, אַז דער נבֿיא װאָלט דיר געהײסן אַ גרױסע זאַך, װאָלסטו דען נישט געטאָן? הײַנט װי אַז ער זאָגט דיר נאָר: באָד זיך, און װער רײן?<verse eid="2KI 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 5:14" />האָט ער אַראָפּגענידערט און זיך געטוֹבֿלט אין יַרדן זיבן מאָל, אַזױ װי דאָס װאָרט פֿון דעם מאַן פֿון ג-ט, און זײַן לײַב האָט זיך אומגעקערט אַזױ װי דער לײַב פֿון אַ קלײן ייִנגל, און ער איז געװאָרן רײן.<verse eid="2KI 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 5:15" />האָט ער זיך אומגעקערט צום מאַן פֿון ג-ט, ער מיט זײַן גאַנצער מחנה, און ער איז געקומען און האָט זיך געשטעלט פֿאַר אים, און האָט געזאָגט: אָט אַצונד װײס איך אַז נישטאָ קײן ג-ט אױף דער גאַנצער ערד נאָר בלױז אין יִשׂרָאֵל. און אַצונד, נעם אָן, איך בעט דיך, אַ מתּנה פֿון דײַן קנעכט. <verse eid="2KI 5:15" /><verse number="16" style="v" sid="2KI 5:16" />האָט ער געזאָגט: אַזױ װי עס לעבט ה׳ װאָס איך שטײ פֿאַר אים, אױב איך װעל נעמען! און ער איז צוגעשטאַנען צו אים צו נעמען, אָבער ער האָט נישט געװאָלט. <verse eid="2KI 5:16" /><verse number="17" style="v" sid="2KI 5:17" />האָט נַעֲמָן געזאָגט: אױב דאָס נישט, זאָל, איך בעט דיך, געגעבן װערן דײַן קנעכט ערד, די משׂא פֿון צװײ מױלאײזלען; װאָרעם דײַן קנעכט װעט מער נישט מאַכן בראַנדאָפּפֿער אָדער שלאַכטאָפּפֿער צו אַנדערע ג‑טער נאָר בלױז צו ה׳. <verse eid="2KI 5:17" /><verse number="18" style="v" sid="2KI 5:18" />פֿאַר דער דאָזיקער זאַך זאָל ה׳ פֿאַרגעבן דײַן קנעכט: װען מײַן האַר קומט אין הױז פֿון רִמוֹן זיך דאָרטן צו בוקן, און ער איז אָנגעלענט אױף מײַן האַנט, און איך װעל זיך בוקן אין הױז פֿון רִמוֹן, װען איך מוז זיך בוקן אין הױז פֿון רִמוֹן, זאָל ה׳ פֿאַרגעבן דײַן קנעכט אין דער דאָזיקער זאַך. <verse eid="2KI 5:18" /><verse number="19" style="v" sid="2KI 5:19" />האָט ער צו אים געזאָגט: גײ בשלום. און ער איז אַװעקגעגאַנגען פֿון אים אַ שטרעק לאַנד.<verse eid="2KI 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 5:20" />און גֵיחזי, דער יונג פֿון אֶלישע דעם מאַן פֿון ג-ט, האָט געזאָגט: אָט האָט מײַן האַר אָפּגעזאָגט דעם דאָזיקן נַעֲמָן דעם אַרַמי, אָנצונעמען פֿון זײַן האַנט דאָס װאָס ער האָט געבראַכט. אַזױ װי ה׳ לעבט, אַז איך מוז אים נאָכלױפֿן, און נעמען פֿון אים עפּעס!<verse eid="2KI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 5:21" />און גֵיחזי האָט נאָכגעיאָגט נַעֲמָנען; און װי נַעֲמָן האָט געזען עמיצן לױפֿן נאָך אים, אַזױ איז ער אַראָפּגעשפּרונגען פֿון רײַטװאָגן אים אַנטקעגן, און האָט געזאָגט: איז פֿריד? <verse eid="2KI 5:21" /><verse number="22" style="v" sid="2KI 5:22" />האָט ער געזאָגט: פֿריד. מײַן האַר האָט מיך געשיקט אַזױ צו זאָגן: אָט אַקאָרשט אַצונד זײַנען געקומען צו מיר צװײ יונגעלײַט פֿון דעם געבערג פֿון אפֿרים, פֿון די יונגע נבֿיאים. גיב פֿאַר זײ, איך בעט דיך, אַ צענטנער זילבער און צװײ גאַנג קלײדער. <verse eid="2KI 5:22" /><verse number="23" style="v" sid="2KI 5:23" />האָט נַעֲמָן געזאָגט: באַװיליק, נעם צװײ צענטנער. און ער איז צוגעשטאַנען צו אים, און האָט אײַנגעבונדן צװײ צענטנער זילבער אין צװײ זעקלעך, און צװײ גאַנג קלײדער, און געגעבן צו צװײ פֿון זײַנע יונגען, און זײ האָבן עס געטראָגן אים פֿאַרױס. <verse eid="2KI 5:23" /><verse number="24" style="v" sid="2KI 5:24" />און װי ער איז געקומען צום בערגל, אַזױ האָט ער עס צוגענומען פֿון זײער האַנט, און באַהאַלטן אין הױז; און ער האָט אַװעקגעשיקט די מענטשן, און זײ זײַנען אַװעקגעגאַנגען.<verse eid="2KI 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 5:25" />און ער איז געקומען און האָט זיך געשטעלט פֿאַר זײַן האַר. האָט אֶלישע צו אים געזאָגט: פֿון װאַנען, גֵיחזי? האָט ער געזאָגט: דײַן קנעכט איז אין ערגעץ נישט געגאַנגען. <verse eid="2KI 5:25" /><verse number="26" style="v" sid="2KI 5:26" />האָט ער צו אים געזאָגט: איז נישט מײַן האַרץ מיטגעגאַנגען װען אַ מאַן האָט זיך אומגעדרײט פֿון זײַן רײַטװאָגן דיר אַנטקעגן? איז דאָס אַ צײַט צו נעמען זילבער, און נעמען קלײדער, אָדער אײלבערטגערטנער און װײַנגערטנער, אָדער שאָף און רינדער, אָדער קנעכט און דינסטן? <verse eid="2KI 5:26" /><verse number="27" style="v" sid="2KI 5:27" />דערום זאָל נַעֲמָנס צרעת זיך באַהעפֿטן אָן דיר און אָן דײַן זאָמען אױף אײביק. און ער איז אַרױסגעגאַנגען פֿון פֿאַר אים מצוֹרע װי שנײ.<verse eid="2KI 5:27" /></para>
  <chapter eid="2KI 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="2KI 6" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 6:1" />און די יונגע נבֿיאים האָבן געזאָגט צו אֶלישע. זע נאָר, דער אָרט װוּ מיר זיצן פֿאַר דיר איז צו ענג פֿאַר אונדז.<verse eid="2KI 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 6:2" />לאָמיר גײן ביזן יַרדן, און לאָמיר נעמען פֿון דאָרטן איטלעכער פֿון אונדז אײן קלאָץ, און לאָמיר אונדז דאָרטן מאַכן אַן אָרט צו װױנען דאָרטן. האָט ער געזאָגט: גײט. <verse eid="2KI 6:2" /><verse number="3" style="v" sid="2KI 6:3" />האָט אײנער געזאָגט: באַװיליק, איך בעט דיך, און גײ מיט דײַנע קנעכט. האָט ער געזאָגט: איך װעל גײן.<verse eid="2KI 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 6:4" />איז ער געגאַנגען מיט זײ, און זײ זײַנען געקומען צום יַרדן, און זײ האָבן אָפּגעהאַקט די בײמער. <verse eid="2KI 6:4" /><verse number="5" style="v" sid="2KI 6:5" />און עס איז געװען, װי אײנער װאַרפֿט אום אַ קלאָץ, אַזױ איז דער אײַזן אַרײַנגעפֿאַלן אין װאַסער, און ער האָט אױסגעשריִען און געזאָגט: װײ, מײַן האַר, װאָרעם ער איז אַ געליִענער. <verse eid="2KI 6:5" /><verse number="6" style="v" sid="2KI 6:6" />האָט דער מאַן פֿון ג-ט געזאָגט: װוּ איז ער אַרײַנגעפֿאַלן? האָט ער אים געװיזן דעם אָרט, און ער האָט אָפּגעשניטן אַ העלצל, און האָט עס אַהין אַרײַנגעװאָרפֿן, און דער אײַזן איז אַרױפֿגעשװוּמען. <verse eid="2KI 6:6" /><verse number="7" style="v" sid="2KI 6:7" />און ער האָט געזאָגט: הײב דיר אים אַרױס; האָט ער אױסגעשטרעקט זײַן האַנט, און האָט אים אַרױסגענומען.<verse eid="2KI 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 6:8" />און דער מלך פֿון אַרָם האָט געהאַלטן מלחמה אױף יִשׂרָאֵל, און ער האָט אָפּגערעדט מיט זײַנע קנעכט, אַזױ צו זאָגן: אין יענעם און יענעם אָרט װעט זײַן מײַן לאַגערונג.<verse eid="2KI 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 6:9" />האָט דער מאַן פֿון ג-ט געשיקט צו דעם מלך פֿון יִשׂרָאֵל, אַזױ צו זאָגן: היט זיך פֿאַרבײַצוגײן דעם דאָזיקן אָרט, װאָרעם אַהין לאָזן זיך אַראָפּ די אַרַמים. <verse eid="2KI 6:9" /><verse number="10" style="v" sid="2KI 6:10" />און דער מלך פֿון יִשׂרָאֵל האָט געשיקט צו דעם אָרט װאָס דער מאַן פֿון ג-ט האָט אים געזאָגט און אים געװאָרנט; און ער האָט זיך דאָרטן אױסגעהיט נישט אײן מאָל און נישט צװײ מאָל.<verse eid="2KI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 6:11" />איז אױפֿגערודערט געװאָרן דאָס האַרץ פֿון דעם מלך פֿון אַרָם איבער דער דאָזיקער זאַך, און ער האָט גערופֿן זײַנע קנעכט, און האָט צו זײ געזאָגט: קענט איר מיר נישט זאָגן, װער פֿון אונדזערע איז מיט דעם מלך פֿון יִשׂרָאֵל? <verse eid="2KI 6:11" /><verse number="12" style="v" sid="2KI 6:12" />האָט אײנער פֿון זײַנע קנעכט געזאָגט: נײן, מײַן האַר מלך, נײַערט אֶלישע דער נבֿיא װאָס אין יִשׂרָאֵל דערצײלט דעם מלך פֿון יִשׂרָאֵל די רײד װאָס דו רעדסט אין דײַן שלאָפֿקאַמער. <verse eid="2KI 6:12" /><verse number="13" style="v" sid="2KI 6:13" />האָט ער געזאָגט: גײט און זעט װוּ ער איז, און איך װעל שיקן און װעל אים נעמען. איז אים אָנגעזאָגט געװאָרן, אַזױ צו זאָגן: ער איז אין דוֹתָן. <verse eid="2KI 6:13" /><verse number="14" style="v" sid="2KI 6:14" />און ער האָט געשיקט אַהין פֿערד און רײַטװעגן און אַ גרױסן חיל, און זײ זײַנען געקומען בײַ נאַכט, און האָבן אַרומגערינגלט די שטאָט. <verse eid="2KI 6:14" /><verse number="15" style="v" sid="2KI 6:15" />און דער משרת פֿון דעם מאַן פֿון ג-ט האָט זיך געפֿעדערט אױפֿצושטײן, און ער איז אַרױסגעגאַנגען, ערשט אַ חיל רינגלט אַרום די שטאָט, מיט פֿערד און רײַטװעגן. האָט זײַן יונג צו אים געזאָגט: װײ, מײַן האַר, װאָס זאָלן מיר טאָן? <verse eid="2KI 6:15" /><verse number="16" style="v" sid="2KI 6:16" />האָט ער געזאָגט: זאָלסט נישט מורא האָבן; װאָרעם די װאָס מיט אונדז זײַנען מער װי די װאָס מיט זײ.<verse eid="2KI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 6:17" />און אֶלישע האָט מתפּלל געװען און האָט געזאָגט: ה׳ עפֿן, איך בעט דיך, זײַנע אױגן, און זאָל ער זען. האָט ג-ט געעפֿנט די אױגן פֿון דעם יונג, און ער האָט געזען, ערשט דער באַרג איז פֿול מיט פֿערד און רײַטװעגן פֿײַערדיקע רונד אַרום אֶלישען.<verse eid="2KI 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 6:18" />און װי זײ האָבן אַראָפּגענידערט צו אים, אַזױ האָט אֶלישע מתפּלל געװען צו ה׳, און האָט געזאָגט: שלאָג, איך בעט דיך, דאָס דאָזיקע פֿאָלק מיט בלינדקײט. האָט ער זײ געשלאָגן מיט בלינדקײט, אַזױ װי דאָס װאָרט פֿון אֶלישען. <verse eid="2KI 6:18" /><verse number="19" style="v" sid="2KI 6:19" />און אֶלישע האָט צו זײ געזאָגט: נישט דאָס איז דער װעג, און נישט דאָס איז די שטאָט. גײט מיר נאָך און איך װעל אײַך פֿירן צו דעם מאַן װאָס איר זוכט. און ער האָט זײ אַװעקגעפֿירט קײן שוֹמרוֹן.<verse eid="2KI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 6:20" />און עס איז געװען, װי זײ זײַנען געקומען קײן שוֹמרוֹן, אַזױ האָט אֶלישע געזאָגט: ה׳, עפֿן די אױגן פֿון די דאָזיקע, זײ זאָלן זען. האָט ה׳ געעפֿנט זײערע אױגן, און זײ האָבן געזען, ערשט זײ זײַנען אין מיטן שוֹמרוֹן. <verse eid="2KI 6:20" /><verse number="21" style="v" sid="2KI 6:21" />און דער מלך פֿון יִשׂרָאֵל האָט געזאָגט צו אֶלישען, װען ער האָט זײ געזען: זאָל איך דערשלאָגן? זאָל איך דערשלאָגן, מײַן פֿאָטער? <verse eid="2KI 6:21" /><verse number="22" style="v" sid="2KI 6:22" />האָט ער געזאָגט: זאָלסט נישט דערשלאָגן. צי די װאָס דו האָסט געפֿאַנגען מיט דײַן שװערד און מיט דײַן בױגן דערשלאָגסט דאָס? שטעל פֿאַר זײ ברױט און װאַסער, און זאָלן זײ עסן און טרינקען, און גײן צו זײער האַר.<verse eid="2KI 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 6:23" />האָט ער זײ געמאַכט אַ גרױסן מאָלצײַט און זײ האָבן געגעסן און געטרונקען, און ער האָט זײ אַװעקגעשיקט, און זײ זײַנען אַװעקגעגאַנגען צו זײער האַר. און די באַנדעס פֿון אַרָם זײַנען מער װידער נישט געקומען אין לאַנד פֿון יִשׂרָאֵל.<verse eid="2KI 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 6:24" />און עס איז געװען נאָך דעם, האָט בֶן-הַדַד דער מלך פֿון אַרָם אײַנגעזאַמלט זײַן גאַנצן חיל, און ער איז אַרױפֿגעגאַנגען און האָט געלעגערט אױף שוֹמרוֹן. <verse eid="2KI 6:24" /><verse number="25" style="v" sid="2KI 6:25" />און עס איז געװאָרן אַ גרױסער הונגער אין שוֹמרוֹן, בעת-אָט זײ האָבן געלעגערט אױף איר, ביז אַ קאָפּ פֿון אַן אײזל איז געװען אַכציק זילבערסטיק און אַ פֿערטל קַבֿ טױבנמיסט פֿינף זילבערסטיק. <verse eid="2KI 6:25" /><verse number="26" style="v" sid="2KI 6:26" />און עס איז געװען, װי דער מלך פֿון יִשׂרָאֵל איז פֿאַרבײַגעגאַנגען אױף דער מױער, האָט אַ פֿרױ געשריִען צו אים, אַזױ צו זאָגן: העלף, מײַן האַר מלך. <verse eid="2KI 6:26" /><verse number="27" style="v" sid="2KI 6:27" />האָט ער געזאָגט: אַז ה׳ העלפֿט דיר נישט, פֿון װאַנען זאָל איך דיר העלפֿן? פֿון דרעש-שײַער צי פֿון קעלטער? <verse eid="2KI 6:27" /><verse number="28" style="v" sid="2KI 6:28" />און דער מלך האָט צו איר געזאָגט: װאָס איז דיר? האָט זי געזאָגט: די דאָזיקע פֿרױ האָט צו מיר געזאָגט: גיב אַהער דײַן זון, און מיר װעלן אים הײַנט אױפֿעסן, און מײַן זון װעלן מיר אױפֿעסן מאָרגן. <verse eid="2KI 6:28" /><verse number="29" style="v" sid="2KI 6:29" />האָבן מיר אָפּגעקאָכט מײַן זון, און מיר האָבן אים אױפֿגעגעסן; און אַז איך האָב צו איר געזאָגט אױפֿן אַנדערן טאָג: גיב אַהער דײַן זון, און מיר װעלן אים אױפֿעסן, האָט זי באַהאַלטן איר זון.<verse eid="2KI 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 6:30" />און עס איז געװען, װי דער מלך האָט געהערט די װערטער פֿון דער פֿרױ, אַזױ האָט ער צעריסן זײַנע קלײדער, בעת ער איז פֿאַרבײַגעגאַנגען אױף דער מױער, און דאָס פֿאָלק האָט געזען, ערשט זאַק איז אױף זײַן לײַב פֿון אונטן. <verse eid="2KI 6:30" /><verse number="31" style="v" sid="2KI 6:31" />און ער האָט געזאָגט: זאָל מיר אלֹקים טאָן אַזױ און נאָך מער, אױב דער קאָפּ פֿון אֶלישע דעם זון פֿון שָפֿטן װעט בלײַבן אױף אים הײַנט!<verse eid="2KI 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 6:32" />און אֶלישע איז געזעסן אין זײַן הױז, און די עלטסטע זײַנען געזעסן מיט אים. און האָט געשיקט פֿון זיך אַ מאַן. אָבער אײדער דער שליח איז אָנגעקומען צו אים, האָט ער געזאָגט צו די עלטסטע: איר זעט װי דער דאָזיקער זון פֿון דעם רוצֵח שיקט אַראָפּצונעמען מײַן קאָפּ? זעט, װי דער שליח קומט, פֿאַרשליסט די טיר, און איר זאָלט זיך אָנשפּאַרן אָן דער טיר אַקעגן אים. פֿאַר װאָר, דער שאָרך פֿון זײַן האַרס פֿיס איז הינטער אים.<verse eid="2KI 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2KI 6:33" />װי ער רעדט נאָך מיט זײ, ערשט דער שליח נידערט אַראָפּ צו אים. און האָט געזאָגט: זע, דאָס דאָזיקע בײז איז פֿון ה׳; װאָס קען איך נאָך האָפֿן פֿון ה׳?<verse eid="2KI 6:33" /></para>
  <chapter eid="2KI 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="2KI 7" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 7:1" />האָט אֶלישע געזאָגט: הערט דאָס װאָרט פֿון ה׳: אַזױ האָט ה׳ געזאָגט: מאָרגן אין דער צײַט װעט אַ סְאָה זעמלמעל זײַן פֿאַר אַ שקל, און צװײ סְאָה גערשטן פֿאַר אַ שקל, אין דעם מױער פֿון שוֹמרוֹן.<verse eid="2KI 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 7:2" />האָט דער הױפּטמאַן װאָס דער מלך איז געװען אָנגעלענט אױף זײַן האַנט געענטפֿערט דעם מאַן פֿון ג-ט, און האָט געזאָגט: אַפֿילו ה׳ זאָל מאַכן פֿענצטער אין הימל, קען דען דאָזיקע זאַך געשען? האָט ער געזאָגט: אָט װעסטו זען מיט דײַנע אױגן, אָבער עסן דערפֿון װעסטו נישט.<verse eid="2KI 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 7:3" />און פֿיר מענטשן מצוֹרָעִים, זײַנען געװען בײַם אײַנגאַנג פֿון טױער; האָבן זײ געזאָגט אײנער צום אַנדערן: װאָס זיצן מיר דאָ ביז מיר װעלן שטאַרבן? <verse eid="2KI 7:3" /><verse number="4" style="v" sid="2KI 7:4" />זאָלן מיר זאָגן: מיר װעלן אַרײַנגײן אין שטאָט, איז דער הונגער אין שטאָט, און מיר װעלן דאָרטן שטאַרבן; און אױב מיר װעלן דאָ זיצן, װעלן מיר אױך שטאַרבן. דערום קומט אַצונד און לאָמיר צופֿאַלן צו דעם לאַגער פֿון אַרָם; אױב זײ װעלן אונדז לאָזן לעבן, װעלן מיר לעבן, און אױב זײ װעלן אונדז טײטן, װעלן מיר שטאַרבן.<verse eid="2KI 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 7:5" />זײַנען זײ אױפֿגעשטאַנען אין אָװנט צו גײן צו דעם לאַגער פֿון אַרָם, און זײ זײַנען געקומען צום עק לאַגער פֿון אַרָם, ערשט דאָרטן איז קײן מענטש נישטאָ. <verse eid="2KI 7:5" /><verse number="6" style="v" sid="2KI 7:6" />װאָרעם אֲדֹנָי האָט געמאַכט הערן אין דעם לאַגער פֿון אַרָם אַ ליאַרעם פֿון רײַטװעגן, און אַ ליאַרעם פֿון פֿערד, אַ ליאַרעם פֿון אַ גרױסן חיל, און זײ האָבן געזאָגט אײנער צום אַנדערן: זע, דער מלך פֿון יִשׂרָאֵל האָט אָנגעדונגען אױף אונדז די מלכים פֿון די חִתּים, און די מלכים פֿון מִצרַיִם, צו קומען אױף אונדז. <verse eid="2KI 7:6" /><verse number="7" style="v" sid="2KI 7:7" />און זײ זײַנען אױפֿגעשטאַנען און זײַנען אַנטלאָפֿן אין אָװנט, און האָבן איבערגעלאָזט זײערע געצעלטן, און זײערע פֿערד און זײערע אײזלען, דעם לאַגער אַזױ װי ער איז, און זײַנען אַנטלאָפֿן אום זײער לעבן.<verse eid="2KI 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 7:8" />און די דאָזיקע מצוֹרָעִים זײַנען געקומען צום עק לאַגער, און זײַנען אַרײַנגעגאַנגען אין אײן געצעלט, און האָבן געגעסן און געטרונקען, און אַרױסגעטראָגן פֿון דאָרטן זילבער און גאָלד, און בגדים, און זײ זײַנען געגאַנגען און האָבן באַהאַלטן; און זײ זײַנען צוריקגעקומען און זײַנען אַרײַנגעגאַנגען אין אַן אַנדער געצעלט, און האָבן אַרױסגעטראָגן פֿון דאָרטן, און זײַנען געגאַנגען און האָבן באַהאַלטן.<verse eid="2KI 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 7:9" />און זײ האָבן געזאָגט אײנער צום אַנדערן: מיר טוען נישט רעכט; הײַנטיקער טאָג איז אַ טאָג פֿון בשׂורה, און מיר שװײַגן. אַז מיר װעלן װאַרטן ביז ליכט פֿון פֿרימאָרגן, װעט אונדז טרעפֿן אַ שטראָף. דערום קומט אַצונד, און לאָמיר אַרײַנגײן און דערצײלן אין הױז פֿון מלך.<verse eid="2KI 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 7:10" />זײַנען זײ געגאַנגען און האָבן גערופֿן צו די טױערלײַט פֿון שטאָט, און זײ האָבן זײ דערצײלט, אַזױ צו זאָגן: מיר זײַנען געקומען אין לאַגער פֿון אַרָם, ערשט דאָרטן איז נישטאָ קײן מאַן און קײן קֹול פֿון אַ מענטשן; נאָר די פֿערד זײַנען צוגעבונדן, און די אײזלען זײַנען צוגעבונדן, און די געצעלטן אַזױ װי זײ זײַנען געװען.<verse eid="2KI 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 7:11" />האָבן די טױערלײַט גערופֿן, און מע האָט אָנגעזאָגט אינעװײניק אין מלכס הױז. <verse eid="2KI 7:11" /><verse number="12" style="v" sid="2KI 7:12" />איז דער מלך אױפֿגעשטאַנען אין דער נאַכט, און ער האָט געזאָגט צו זײַנע קנעכט: לאָמיר אײַך זאָגן װאָס די אַרַמים אונדז האָבן דאָ געטאָן: זײ װײסן אַז מיר זײַנען הונגעריקע, דערום זײַנען זײ אַרױסגעגאַנגען פֿון לאַגער זיך צו באַהאַלטן אין פֿעלד, אַזױ צו זאָגן: װי זײ װעלן אַרױסגײן פֿון שטאָט, אַזױ װעלן מיר זײ כאַפּן לעבעדיקערהײט, און מיר װעלן אַרײַנגײן אין שטאָט.<verse eid="2KI 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 7:13" />האָט זיך אָנגערופֿן אײנער פֿון זײַנע קנעכט און האָט געזאָגט: טאָ זאָל מען, איך בעט דיך, נעמען פֿינף פֿון די געבליבענע פֿערד װאָס זײַנען דאָ געבליבן – זײ זײַנען דאָך אַזױ װי דער גאַנצער המון פֿון יִשׂרָאֵל װאָס גײען אױס – און לאָמיר שיקן און זען.<verse eid="2KI 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 7:14" />האָבן זײ גענומען צװײ רײַטװעגן מיט פֿערד, און דער מלך האָט זײ געשיקט נאָך דעם חיל פֿון אַרָם, אַזױ צו זאָגן: גײט און זעט.<verse eid="2KI 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 7:15" />זײַנען זײ געגאַנגען נאָך זײ ביזן יַרדן; ערשט דער גאַנצער װעג איז פֿול מיט בגדים און זאַכן װאָס די אַרַמים האָבן אַװעקגעװאָרפֿן אין זײער אײַלעניש. האָבן די שלוחים זיך אומגעקערט, און האָבן דערצײלט דעם מלך. <verse eid="2KI 7:15" /><verse number="16" style="v" sid="2KI 7:16" />איז אַרױסגעגאַנגען דאָס גאַנצע פֿאָלק און זײ האָבן אױסגערױבט דעם לאַגער פֿון אַרָם; און אַ סְאָה זעמלמעל איז געװען פֿאַר אַ שקל, און צװײ סְאָה גערשטן פֿאַר אַ שקל, אַזױ װי דאָס װאָרט פֿון ה׳.<verse eid="2KI 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 7:17" />און דער מלך האָט אױפֿגעזעצט דעם הױפּטמאַן װאָס ער איז געװען אָנגעלענט אױף זײַן האַנט, איבער דעם טױער. האָט אים דאָס פֿאָלק צעטרעטן אין טױער, און ער איז געשטאָרבן. אַזױ װי עס האָט גערעדט דער מאַן פֿון ג-ט, װאָס ער האָט גערעדט װען דער מלך האָט אַראָפּגענידערט צו אים. <verse eid="2KI 7:17" /><verse number="18" style="v" sid="2KI 7:18" />װאָרעם עס איז געװען, אַז דער מאַן פֿון ג-ט האָט גערעדט צום מלך, אַזױ צו זאָגן: צװײ סְאָה גערשטן װעלן זײַן פֿאַר אַ שקל, און אַ סְאָה זעמלמעל פֿאַר אַ שקל, מאָרגן אין דער צײַט אין טױער פֿון שוֹמרוֹן, <verse eid="2KI 7:18" /><verse number="19" style="v" sid="2KI 7:19" />האָט דער הױפּטמאַן זיך אָפּגערופֿן צום מאַן פֿון ג-ט, און האָט געזאָגט: און אַפֿילו ה׳ זאָל מאַכן פֿענצטער אין הימל, קען דען געשען אַזױ װי די דאָזיקע זאַך? האָט ער געזאָגט: אָט װעסטו זען מיט דײַנע אױגן, אָבער עסן דערפֿון װעסטו נישט. <verse eid="2KI 7:19" /><verse number="20" style="v" sid="2KI 7:20" />און אים איז אַזױ געשען און דאָס פֿאָלק האָט אים צעטרעטן אין טױער, און ער איז געשטאָרבן.<verse eid="2KI 7:20" /></para>
  <chapter eid="2KI 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="2KI 8" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 8:1" />און אֶלישע האָט גערעדט צו דער פֿרױ װאָס ער האָט לעבעדיק געמאַכט איר זון, אַזױ צו זאָגן: שטײ אױף און גײ, דו און דײַן הױזגעזינט, און האַלט זיך אױף װוּ דו װעסט זיך אױפֿהאַלטן, װאָרעם ה׳ האָט גערופֿן אַ הונגער, און ער קומט אױך איבערן לאַנד אױף זיבן יאָר.<verse eid="2KI 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 8:2" />איז די פֿרױ אױפֿגעשטאַנען, און האָט געטאָן אַזױ װי דאָס װאָרט פֿון דעם מאַן פֿון ג-ט, און זי איז געגאַנגען מיט איר הױזגעזינט, און האָט זיך אױפֿגעהאַלטן אין לאַנד פֿון די פּלִשתּים זיבן יאָר. <verse eid="2KI 8:2" /><verse number="3" style="v" sid="2KI 8:3" />און עס איז געװען צום סוף פֿון די זיבן יאָר, האָט די פֿרױ זיך אומגעקערט פֿון לאַנד פֿון די פּלִשתּים, און זי איז אַרױסגעגאַנגען שרײַען צום מלך װעגן איר הױז און װעגן איר פֿעלד. <verse eid="2KI 8:3" /><verse number="4" style="v" sid="2KI 8:4" />און דער מלך האָט גראָד גערעדט צו גֵיחזי דעם יונג פֿון דעם מאַן פֿון ג-ט, אַזױ צו זאָגן: דערצײל מיר אַקאָרשט אַלע גרױסע זאַכן װאָס אֶלישע האָט געטאָן.<verse eid="2KI 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 8:5" />און עס איז געװען װי ער דערצײלט אַזױ דעם מלך, אַז ער האָט לעבעדיק געמאַכט דעם טױטן, ערשט די פֿרױ װאָס ער האָט לעבעדיק געמאַכט איר זון, שרײַט צום מלך װעגן איר הױז און װעגן איר פֿעלד. האָט גֵיחזי געזאָגט: מײַן האַר מלך, דאָס איז די פֿרױ, און דאָס איז איר זון װאָס אֶלישע האָט לעבעדיק געמאַכט. <verse eid="2KI 8:5" /><verse number="6" style="v" sid="2KI 8:6" />האָט דער מלך אױסגעפֿרעגט די פֿרױ, און זי האָט אים דערצײלט. און דער מלך האָט איר מיטגעגעבן אַ הױפֿדינער, אַזױ צו זאָגן: קער אום אַלץ װאָס איז אירס, און אַלע אײַנקומענישן פֿון דעם פֿעלד, פֿון דעם טאָג װאָס זי האָט פֿאַרלאָזן דאָס לאַנד און ביז אַצונד.<verse eid="2KI 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 8:7" />און אֶלישע איז געקומען קײן דַמֶשֶׂק; און בֶן-הַדַד דער מלך פֿון אַרָם איז געװען קראַנק; איז אים דערצײלט געװאָרן, אַזױ צו זאָגן: דער מאַן פֿון ג-ט איז געקומען אַהער. <verse eid="2KI 8:7" /><verse number="8" style="v" sid="2KI 8:8" />האָט דער מלך געזאָגט צו חַזָאֵלן: נעם אין דײַן האַנט אַ מתּנה, און גײ אַנטקעגן דעם מאַן פֿון ג-ט, און זאָלסט פֿרעגן דורך אים בײַ ה׳, אַזױ צו זאָגן: װעל איך גענעזן װערן פֿון דער דאָזיקער קראַנקשאַפֿט?<verse eid="2KI 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 8:9" />איז חַזָאֵל געגאַנגען אים אַנטקעגן; און ער האָט מיטגענומען אַ מתּנה אין זײַן האַנט, און פֿון אַל דאָס גוטס פֿון דַמֶשֶׂק, אַ משׂא פֿון פֿערציק קעמלען, און ער איז געקומען און האָט זיך געשטעלט פֿאַר אים, און האָט געזאָגט: דײַן זון בֶן-הַדַד דער מלך פֿון אַרָם האָט מיך געשיקט צו דיר, אַזױ צו זאָגן: װעל איך גענעזן װערן פֿון דער דאָזיקער קראַנקשאַפֿט? <verse eid="2KI 8:9" /><verse number="10" style="v" sid="2KI 8:10" />האָט אֶלישע צו אים געזאָגט: גײ, זאָג צו אים: גענעזן װעסטו גענעזן װערן; אָבער ה׳ האָט מיר באַװיזן אַז שטאַרבן װעט ער שטאַרבן.<verse eid="2KI 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 8:11" />און ער האָט אָנגעשטעלט זײַן פּנים, און באַטראַכט ביז ער האָט זיך פֿאַרשעמט; און דער מאַן פֿון ג-ט האָט געװײנט.<verse eid="2KI 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 8:12" />האָט חַזָאֵל געזאָגט: פֿאַר װאָס װײנט מײַן האַר? האָט ער געזאָגט: װײַל איך װײס דאָס בײז װאָס דו װעסט אָנטאָן די קינדער פֿון יִשׂרָאֵל. זײערע פֿעסטונגען װעסטו אַװעקלאָזן אין פֿײַער, און זײערע יונגעלײַט װעסטו הרגען מיטן שװערד, און זײערע קלײנע קינדער װעסטו צעהאַקן, און זײערע טראָגעדיקע װעסטו אױפֿשפּאַלטן. <verse eid="2KI 8:12" /><verse number="13" style="v" sid="2KI 8:13" />האָט חַזָאֵל געזאָגט: אָבער װער איז דײַן קנעכט דער הונט, אַז ער זאָל טאָן די דאָזיקע גרױסע זאַך? האָט אֶלישע געזאָגט: ה׳ האָט מיר געװיזן דיך װי דער מלך איבער אַרָם.<verse eid="2KI 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 8:14" />איז ער אַװעקגעגאַנגען פֿון אֶלישען, און איז געקומען צו זײַן האַר; האָט ער אים געפֿרעגט: װאָס האָט אֶלישע געזאָגט? האָט ער געזאָגט: ער האָט מיר געזאָגט, גענעזן װעסטו גענעזן װערן.<verse eid="2KI 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 8:15" />און עס איז געװען אױף מאָרגן, האָט ער גענומען דאָס שטריקטוך און אײַנגעטונקט אין װאַסער, און פֿאַרשפּרײט אױף זײַן פּנים, און ער איז געשטאָרבן. און חַזָאֵל איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 8:16" />און אין פֿינפֿטן יאָר פֿון יוֹרָם דעם זון פֿון אַחאָבֿן, דעם מלך פֿון יִשׂרָאֵל װען יהוֹשָפֿט איז געװען דער מלך פֿון יהוּדה, איז יהוֹרָם דער זון פֿון יהוֹשָפֿט דעם מלך פֿון יהוּדה געװאָרן מלך. <verse eid="2KI 8:16" /><verse number="17" style="v" sid="2KI 8:17" />צװײ און דרײַסיק יאָר איז ער אַלט געװען, אַז ער איז געװאָרן מלך, און אַכט יאָר האָט ער געקיניגט אין ירושָלַיִם. <verse eid="2KI 8:17" /><verse number="18" style="v" sid="2KI 8:18" />און ער איז געגאַנגען אין דעם װעג פֿון די מלכים פֿון יִשׂרָאֵל, אַזױ װי דאָס הױז פֿון אַחאָבֿ האָט געטאָן; װאָרעם ער האָט געהאַט אַחאָבֿס טאָכטער פֿאַר אַ װײַב; און ער האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳. <verse eid="2KI 8:18" /><verse number="19" style="v" sid="2KI 8:19" />אָבער ה׳ האָט נישט געװאָלט אומברענגען יהוּדה פֿון זײַן קנעכט דָוִדס װעגן, אַזױ װי ער האָט אים צוגעזאָגט, צו געבן אים און זײַנע קינדער אַ ליכט אַלע טעג.<verse eid="2KI 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 8:20" />אין זײַנע טעג איז אֶדוֹם אָפּגעפֿאַלן פֿון אונטער דער האַנט פֿון יהוּדה, און זײ האָבן געמאַכט איבער זיך אַ מלך. <verse eid="2KI 8:20" /><verse number="21" style="v" sid="2KI 8:21" />איז יוֹרָם אַריבערגעגאַנגען קײן צָעִיר און אַלע רײַטװעגן מיט אים, און ער איז אױפֿגעשטאַנען בײַ נאַכט, און האָט געשלאָגן די אַדוֹמים װאָס האָבן אים אַרומגערינגלט, און די הױפּטלײַט פֿון די רײַטװעגן; און דאָס פֿאָלק איז אַנטלאָפֿן צו זײַנע געצעלטן. <verse eid="2KI 8:21" /><verse number="22" style="v" sid="2KI 8:22" />אָבער אֶדוֹם איז אָפּגעפֿאַלן פֿון אונטער דער האַנט פֿון יהוּדה ביז אױף הײַנטיקן טאָג. דענצמאָל אין דער אײגענער צײַט איז אָפּגעפֿאַלן לִבֿנָה.<verse eid="2KI 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 8:23" />און די איבעריקע זאַכן װעגן יוֹרָמען, און אַלץ װאָס ער האָט געטאָן, דאָס איז שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יהוּדה.<verse eid="2KI 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 8:24" />און יוֹרָם האָט זיך געלײגט מיט זײַנע עלטערן, און ער איז באַגראָבן געװאָרן לעבן זײַנע עלטערן אין דָוִדס-שטאָט. און זײַן זון אַחַזיָהו איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 8:25" />אין צװעלפֿטן יאָר פֿון יוֹרָם דעם זון פֿון אַחאָבֿן, דעם מלך פֿון יִשׂרָאֵל, איז געװאָרן מלך אַחַזיָהו דער זון פֿון יהוֹרָם דעם מלך פֿון יהוּדה. <verse eid="2KI 8:25" /><verse number="26" style="v" sid="2KI 8:26" />צװײ און צװאַנציק יאָר איז אַחַזיָהו אַלט געװען, אַז ער איז געװאָרן מלך, און אײן יאָר האָט ער געקיניגט אין ירושָלַיִם. און דער נאָמען פֿון זײַן מוטער איז געװען עַתַליָהו די טאָכטער פֿון עָמרי דעם מלך פֿון יִשׂרָאֵל.<verse eid="2KI 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 8:27" />און ער איז געגאַנגען אין דעם װעג פֿון אַחאָבֿס הױז, און האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳, אַזױ װי דאָס הױז פֿון אַחאָבֿ, װאָרעם ער איז געװען אַן אײדים פֿון אַחאָבֿס הױז.<verse eid="2KI 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 8:28" />און ער איז געגאַנגען מיט יוֹרָם דעם זון פֿון אַחאָבֿן אױף מלחמה מיט חַזָאֵל דעם מלך פֿון אַרָם, אין רָמוֹת-גִלעָד; און די אַרַמים האָבן פֿאַרװוּנדט יוֹרָמען. <verse eid="2KI 8:28" /><verse number="29" style="v" sid="2KI 8:29" />און דער מלך יוֹרָם האָט זיך אומגעקערט זיך צו הײלן אין יִזרְעֶאל פֿון די װוּנדן װאָס די אַרַמים האָבן אים פֿאַרװוּנדט אין רָמָה, װען ער האָט מלחמה געהאַלטן מיט חַזָאֵל דעם מלך פֿון אַרָם. און אַחַזיָהו דער זון פֿון יהוֹרָמען, דער מלך פֿון יהוּדה, האָט אַראָפּגענידערט צו זען יוֹרָם דעם זון פֿון אַחאָבֿן אין יִזרְעֶאל, װען ער איז געװען קראַנק.<verse eid="2KI 8:29" /></para>
  <chapter eid="2KI 8" />
  <chapter number="9" style="c" pubnumber="ט" sid="2KI 9" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 9:1" />און אֶלישע דער נבֿיא האָט גערופֿן אײנעם פֿון די יונגע נבֿיאים, און האָט צו אים געזאָגט: גורט אָן דײַנע לענדן, און נעם דאָס דאָזיקע קריגל אײל אין דײַן האַנט, און גײ קײן רָמוֹת-גִלעָד.<verse eid="2KI 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 9:2" />און אַז דו װעסט קומען אַהין, קוק זיך אַרום אױף יֵהוּא דעם זון פֿון יהוֹשָפֿט דעם זון פֿון נִמשין; און זאָלסט אַרײַנגײן, און אים מאַכן אױפֿשטײן פֿון צװישן זײַנע ברידער, און זאָלסט אים אַרײַנפֿירן אין אַ קאַמער הינטער אַ קאַמער. <verse eid="2KI 9:2" /><verse number="3" style="v" sid="2KI 9:3" />און זאָלסט נעמען דאָס קריגל אײל, און אַרױפֿגיסן אױף זײַן קאָפּ, און זאָגן: אַזױ האָט ה׳ געזאָגט. איך האָב דיך געזאַלבט פֿאַר אַ מלך איבער יִשׂרָאֵל. און זאָלסט עפֿענען די טיר און אַנטלױפֿן, און נישט װאַרטן.<verse eid="2KI 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 9:4" />איז דער יונגערמאַן דער יונגער נבֿיא געגאַנגען קײן רָמוֹת-גִלעָד. <verse eid="2KI 9:4" /><verse number="5" style="v" sid="2KI 9:5" />און װי ער איז געקומען, ערשט די הױפּטלײַט פֿון חיל זיצן. האָט ער געזאָגט: איך האָב אַ װאָרט צו דיר, הױפּטמאַן. האָט יֵהוּא געזאָגט: צו װעמען פֿון אונדז אַלעמען? האָט ער געזאָגט: צו דיר, הױפּטמאַן.<verse eid="2KI 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 9:6" />איז ער אױפֿגעשטאַנען, און ער איז אַרײַנגעגאַנגען אין הױז. און ער האָט אַרױפֿגעגאָסן דאָס אײל אױף זײַן קאָפּ, און האָט צו אים געזאָגט: אַזױ האָט געזאָגט ה׳ אלוקי יִשׂרָאֵל: איך האָב דיך געזאַלבט פֿאַר אַ מלך איבער דעם פֿאָלק פֿון ג-ט, איבער יִשׂרָאֵל. <verse eid="2KI 9:6" /><verse number="7" style="v" sid="2KI 9:7" />און זאָלסט דערשלאָגן דאָס הױז פֿון אַחאָבֿ דײַן האַר, כּדי איך זאָל זיך נוקם זײַן פֿאַר דעם בלוט פֿון מײַנע קנעכט די נבֿיאים, און פֿאַר דעם בלוט פֿון אַלע קנעכט פֿון ה׳, פֿון אִיזֶבֿלס האַנט. <verse eid="2KI 9:7" /><verse number="8" style="v" sid="2KI 9:8" />און דאָס גאַנצע הױז פֿון אַחאָבֿ זאָל אונטערגײן; און איך װעל פֿאַרשנײַדן פֿון אַחאָבֿן יעטװעדער מאַנספּאַרשױן און קינד און קײט, צװישן יִשׂרָאֵל.<verse eid="2KI 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 9:9" />און איך װעל מאַכן דאָס הױז פֿון אַחאָבֿ אַזױ װי דאָס הױז פֿון יָרָבֿעָם דעם זון פֿון נבָֿטן, און אַזױ װי דאָס הױז פֿון בַעְשָא דעם זון פֿון אַחִיָהן. <verse eid="2KI 9:9" /><verse number="10" style="v" sid="2KI 9:10" />און די הינט װעלן עסן אִיזֶבֿלען אין דעם שטיק לאַנד פֿון יִזרְעֶאל, און קײן באַגרעבער װעט נישט זײַן. און ער האָט געעפֿנט די טיר, און איז אַנטלאָפֿן.<verse eid="2KI 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 9:11" />און יֵהוּא איז אַרױסגעגאַנגען צו די קנעכט פֿון זײַן האַר; האָט מען צו אים געזאָגט: איז פֿריד? װעגן װאָס איז דער דאָזיקער משוגענער געקומען צו דיר? האָט ער צו זײ געזאָגט: איר קענט דאָך דעם מאַן און זײַן רעדן. <verse eid="2KI 9:11" /><verse number="12" style="v" sid="2KI 9:12" />האָבן זײ געזאָגט: אַ ליגן! דערצײל אונדז אַקאָרשט. האָט ער געזאָגט: אַזױ און אַזױ האָט ער גערעדט צו מיר, אַזױ צו זאָגן: אַזױ האָט ה׳ געזאָגט: איך האָב דיך געזאַלבט פֿאַר אַ מלך איבער יִשׂרָאֵל.<verse eid="2KI 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 9:13" />האָבן זײ געאײַלט און גענומען איטלעכער זײַן בגד, און אונטערגעלײגט אונטער אים אױף דער אױבערשטער טרעפּ, און זײ האָבן געבלאָזן אין שופֿר, און געזאָגט: יֵהוּא איז מלך!<verse eid="2KI 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 9:14" />אַזױ האָט יֵהוּא דער זון פֿון יהוֹשָפֿט דעם זון פֿון נִמשין געמאַכט אַ בונט אױף יוֹרָמען. – און יוֹרָם האָט געהאַט געהיט רָמוֹת-גִלעָד פֿון חַזָאֵל דעם מלך פֿון אַרָם, ער און גאַנץ יִשׂרָאֵל. <verse eid="2KI 9:14" /><verse number="15" style="v" sid="2KI 9:15" />און דער מלך יהוֹרָם האָט זיך אומגעקערט זיך צו הײלן אין יִזרְעֶאל פֿון די װוּנדן װאָס די אַרַמים האָבן אים פֿאַרװוּנדט, װען ער האָט מלחמה געהאַלטן מיט חַזָאֵל דעם מלך פֿון אַרָם. – און יֵהוּא האָט געזאָגט: אױב דאָס איז אײַער װילן, זאָל נישט אַרױס אַן אַנטרונענער פֿון שטאָט צו גײן אָנזאָגן אין יִזרְעֶאל.<verse eid="2KI 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 9:16" />און יֵהוּא האָט זיך געזעצט אױף אַ רײַטװאָגן, און איז אַװעק קײן יִזרְעֶאל, װײַל יוֹרָם איז דאָרטן געלעגן. און אַחַזיָהו דער מלך פֿון יהוּדה האָט אַראָפּגענידערט צו זען יוֹרָמען.<verse eid="2KI 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 9:17" />און דער װעכטער איז געשטאַנען אױף דעם טורעם אין יִזרְעֶאל, און ער האָט געזען די מחנה פֿון יֵהוּאן בײַ זײַן אָנקומען. האָט ער געזאָגט: אַ מחנה זע איך. האָט יהוֹרָם געזאָגט: נעם אַ רײַטער און שיק זײ אַנטקעגן, און זאָל ער זאָגן: איז פֿריד?<verse eid="2KI 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 9:18" />איז דער רײַטער אױפֿן פֿערד אַװעק אים אַנטקעגן, און האָט געזאָגט: אַזױ האָט דער מלך געזאָגט: איז פֿריד? האָט יֵהוּא געזאָגט: װאָס קערסטו זיך אָן מיט פֿריד? דרײַ זיך אױס הינטער מיר. האָט דער װעכטער אָנגעזאָגט אַזױ צו זאָגן: דער שליח איז אָנגעקומען ביז זײ, אָבער ער קערט זיך נישט צוריק.<verse eid="2KI 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 9:19" />האָט ער געשיקט אַ צװײטן רײַטער אױף אַ פֿערד. און ער איז געקומען צו זײ, און האָט געזאָגט: אַזױ האָט געזאָגט דער מלך: איז פֿריד? האָט יֵהוּא געזאָגט: װאָס קערסטו זיך אָן מיט פֿריד? דרײַ זיך אױס הינטער מיר.<verse eid="2KI 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 9:20" />האָט דער װעכטער אָנגעזאָגט, אַזױ צו זאָגן: ער איז אָנגעקומען ביז צו זײ, אָבער ער קערט זיך נישט צוריק. און דאָס טרײַבן איז אַזױ װי דאָס טרײַבן פֿון יֵהוּא דעם זון פֿון נִמשין, װאָרעם ער טרײַבט משוּגענערװײַז.<verse eid="2KI 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 9:21" />האָט יהוֹרָם געזאָגט: שפּאַן אײַן. האָט מען אײַנגעשפּאַנט זײַן רײַטװאָגן, און יהוֹרָם דער מלך פֿון יִשׂרָאֵל און אַחַזיָהו דער מלך פֿון יהוּדה זײַנען אַרױס איטלעכער אין זײַן רײַטװאָגן, און זײַנען אַרױס אַנטקעגן יֵהוּאן, און האָבן אים געטראָפֿן אין דעם שטיק לאַנד פֿון נָבֿוֹת דעם יִזרעאֵלי.<verse eid="2KI 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 9:22" />און עס איז געװען, װי יהוֹרָם האָט געזען יֵהוּאן, אַזױ האָט ער געזאָגט: איז פֿריד, יֵהוּא? האָט ער געענטפֿערט: װאָס פֿאַר פֿריד, בײַ די זנותן פֿון דײַן מוטער אִיזֶבֿלען און אירע פֿיל כּישופֿן.<verse eid="2KI 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 9:23" />האָט יהוֹרָם פֿאַרקריװעט זײַנע הענט, און איז אַנטלאָפֿן, און ער האָט געזאָגט צו אַחַזיָהון: באַטרוג, אַחַזיָהו!<verse eid="2KI 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 9:24" />און יֵהוּא האָט אָנגעצױגן מיט זײַן האַנט דעם בױגן, און האָט געטראָפֿן יהוֹרָמען צװישן זײַנע אָרעמס, און די פֿײַל איז אים אַרױסגעגאַנגען דורכן האַרצן, און ער האָט זיך אַראָפּגעלאָזן אין זײַן רײַטװאָגן. <verse eid="2KI 9:24" /><verse number="25" style="v" sid="2KI 9:25" />האָט ער געזאָגט צו בִדקַר זײַן עלטסטן: נעם, װאַרף אים אַװעק אין דעם שטיק פֿעלד פֿון נָבֿוֹת דעם יִזרעאֵלי. װאָרעם געדענק װי איך און דו זײַנען געריטן בײַנאַנד הינטער זײַן פֿאָטער אַחאָבֿן, און ה׳ האָט אױפֿגעהױבן אױף אים די דאָזיקע נבֿואה: <verse eid="2KI 9:25" /><verse number="26" style="v" sid="2KI 9:26" />פֿאַר װאָר, איך האָב נעכטן געזען דאָס בלוט פֿון נָבֿוֹתן, און דאָס בלוט פֿון זײַנע קינדער, זאָגט ה׳, און איך װעל דיר אָפּצאָלן אין דעם דאָזיקן שטיק לאַנד, זאָגט ג-ט. און אַצונד נעם, װאַרף אים אַװעק אין דעם שטיק לאַנד, אַזױ װי דאָס װאָרט פֿון ה׳.<verse eid="2KI 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 9:27" />און װי אַחַזיָהו דער מלך פֿון יהוּדה האָט דערזען, אַזױ איז ער אַנטלאָפֿן דורך דעם גאָרטנהױז. אָבער יֵהוּא האָט אים נאָכגעיאָגט, און האָט געזאָגט: שלאָגט אים אױך אױפֿן רײַטװאָגן. אױף דעם אַרױפֿגאַנג פֿון גור װאָס לעבן יִבֿלְעָם. און ער איז אַנטלאָפֿן קײן מגִדוֹ, און איז דאָרטן געשטאָרבן. <verse eid="2KI 9:27" /><verse number="28" style="v" sid="2KI 9:28" />און זײַנע קנעכט האָבן אים געבראַכט צופֿירן קײן ירושָלַיִם, און האָבן אים באַגראָבן אין זײַן קבֿר לעבן זײַנע עלטערן אין דָוִדס-שטאָט.<verse eid="2KI 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 9:29" />און אין עלפֿטן יאָר פֿון יוֹרָם דעם זון פֿון אַחאָבֿן איז אַחַזיָה געװאָרן מלך איבער יהוּדה.<verse eid="2KI 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 9:30" />און יֵהוּא איז געקומען קײן יִזרְעֶאל. און אִיזֶבֿל האָט דערהערט, און זי האָט אַרױפֿגעטאָן פֿאַרב אױף אירע אױגן, און האָט פֿאַרפּוצט איר קאָפּ, און אַרױסגעקוקט דורכן פֿענצטער. <verse eid="2KI 9:30" /><verse number="31" style="v" sid="2KI 9:31" />און װי יֵהוּא איז אַרײַנגעקומען אין טױער, אַזױ האָט זי געזאָגט: װאָס מאַכט זִמרי דער מערדער פֿון זײַן האַר?<verse eid="2KI 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 9:32" />האָט ער אױפֿגעהױבן זײַן פּנים צום פֿענצטער, און האָט געזאָגט: װער איז מיט מיר, װער? האָבן אַרױסגעקוקט צו אים צװײ דרײַ הױפֿדינער. <verse eid="2KI 9:32" /><verse number="33" style="v" sid="2KI 9:33" />האָט ער געזאָגט: שלײַדערט זי אַראָפּ. און זײ האָבן זי אַראָפּגעשלײַדערט; און פֿון איר בלוט האָט אַרױפֿגעשפּריצט אױף דער װאַנט און אױף די פֿערד. און מע האָט זי צעטרעטן.<verse eid="2KI 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 9:34" />און ער איז אַרײַנגעגאַנגען, און האָט געגעסן און געטרונקען, און ער האָט געזאָגט: באַשטאַט, איך בעט אײַך, די דאָזיקע פֿאַרשאָלטענע, און באַגראָבט זי, װאָרעם אַ מלכס טאָכטער איז זי.<verse eid="2KI 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 9:35" />זײַנען זײ געגאַנגען זי באַגראָבן, אָבער זײ האָבן מער פֿון איר נישט געפֿונען, װי בלױז דעם שאַרבן, און די פֿיס, און די האַנטפֿלעכן. <verse eid="2KI 9:35" /><verse number="36" style="v" sid="2KI 9:36" />האָבן זײ זיך אומגעקערט, און האָבן אים דערצײלט. האָט ער געזאָגט: דאָס איז דאָס װאָרט פֿון ה׳ װאָס ער האָט גערעדט דורך זײַן קנעכט אֵלִיָהו דעם תִּשבי, אַזױ צו זאָגן: אין דעם שטיק לאַנד פֿון יִזרְעֶאל װעלן די הינט עסן דאָס פֿלײש פֿון אִיזֶבֿלען. <verse eid="2KI 9:36" /><verse number="37" style="v" sid="2KI 9:37" />און דער טױטער לײַב פֿון אִיזֶבֿלען װעט זײַן אױפֿן שטיק לאַנד פֿון יִזרְעֶאל אַזױ װי מיסט אױפֿן פֿרײַען פֿעלד, אַז מע װעט ניט קענען זאָגן: דאָס איז אִיזֶבֿל.<verse eid="2KI 9:37" /></para>
  <chapter eid="2KI 9" />
  <chapter number="10" style="c" pubnumber="י" sid="2KI 10" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 10:1" />און אַחאָבֿ האָט געהאַט זיבעציק זין אין שוֹמרוֹן. האָט יֵהוּא געשריבן בריװ, און האָט געשיקט קײן שוֹמרוֹן צו די האַרן פֿון יִזרְעֶאל, די עלטסטע, און צו די װאָס זײַנען געװען דערציִער בײַ אַחאָבֿן, אַזױ צו זאָגן: <verse eid="2KI 10:1" /><verse number="2" style="v" sid="2KI 10:2" />און אַצונד, װי עס קומט צו אײַך דער דאָזיקער בריװ, אַזױ װי בײַ אײַך זײַנען די זין פֿון אײַער האַר, און בײַ אײַך זײַנען דאָ רײַטװעגן און פֿערד, און אַ פֿעסטונגשטאָט און װאַפֿן.<verse eid="2KI 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 10:3" />זאָלט איר זען דעם בעסטן און גלײַכסטן פֿון אײַער האַרס זין, און אַרױפֿזעצן אױף זײַן פֿאָטערס טראָן; און האַלט מלחמה פֿאַר אײַער האַרס הױז.<verse eid="2KI 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 10:4" />האָבן זײ זײער שטאַרק מורא געקריגן, און זײ האָבן געזאָגט: אָט זײַנען די צװײ מלכים נישט באַשטאַנען פֿאַר אים, און װי װעלן מיר באַשטײן?<verse eid="2KI 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 10:5" />און דער װאָס איבער דעם פּאַלאַץ, און דער װאָס איבער דער שטאָט, און די עלטסטע, און די דערציִער, האָבן געשיקט צו יֵהוּאן, אַזױ צו זאָגן: דײַנע קנעכט זײַנען מיר; און אַלץ װאָס דו װעסט אונדז זאָגן, װעלן מיר טאָן. מיר װעלן קײנעם נישט מאַכן פֿאַר אַ מלך. װאָס איז גוט אין דײַנע אױגן, טו.<verse eid="2KI 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 10:6" />האָט ער געשריבן צו זײ אַ בריװ אַ צװײט מאָל, אַזױ צו זאָגן: אױב איר זײַט מיט מיר, און איר װילט צוהערן צו מײַן קֹול, נעמט די קעפּ פֿון די מאַנספּאַרשױנען, אײַער האַרס זין, און קומט צו מיר מאָרגן אַרום דער צײַט קײן יִזרְעֶאל. און די זין פֿון מלך, זיבעציק פּאַרשױן, זײַנען געװען בײַ די גרױסע לײַט פֿון דער שטאָט, װאָס האָבן זײ אױפֿגעצױגן. <verse eid="2KI 10:6" /><verse number="7" style="v" sid="2KI 10:7" />און עס איז געװען, װי דער בריװ איז אָנגעקומען צו זײ, אַזױ האָבן זײ גענומען די זין פֿון מלך, און זײ געשאָכטן, זיבעציק פּאַרשױן; און זײ האָבן אַרײַנגעטאָן זײערע קעפּ אין קערב, און אַװעקגעשיקט צו אים קײן יִזרְעֶאל.<verse eid="2KI 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 10:8" />איז געקומען אַ שליח, און האָט אים אָנגעזאָגט, אַזױ צו זאָגן: מע האָט געבראַכט די קעפּ פֿון דעם מלכס זין. האָט ער געזאָגט: מאַכט זײ אין צװײ הױפֿנס בײַם אײַנגאַנג פֿון טױער, ביז אין דער פֿרי.<verse eid="2KI 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 10:9" />און עס איז געװען אין דער פֿרי, איז ער אַרױסגעגאַנגען, און האָט זיך אַװעקגעשטעלט, און האָט געזאָגט צום גאַנצן פֿאָלק, איר זײַט אומשולדיק; אָט האָב איך געמאַכט אַ בונט אַקעגן מײַן האַר, און האָב אים געהרגעט. אָבער װער האָט דערשלאָגן אַלע די דאָזיקע? <verse eid="2KI 10:9" /><verse number="10" style="v" sid="2KI 10:10" />זײַט װיסן דען, אַז גאָרנישט װעט פֿאַלן צו דער ערד פֿון דעם װאָרט פֿון ה׳ װאָס ג-ט האָט גערעדט אױף דעם הױז פֿון אַחאָבֿ; און ג-ט האָט געטאָן װאָס ער האָט גערעדט דורך זײַן קנעכט אֵלִיָהון.<verse eid="2KI 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 10:11" />און יֵהוּא האָט דערשלאָגן אַלע װאָס זײַנען געבליבן פֿון אַחאָבֿס הױז אין יִזרְעֶאל, און אַלע זײַנע גרױסע לײַט, און זײַנע גוטע פֿרײַנט, און זײַנע כּהנים, ביז ער האָט נישט געלאָזן פֿון אים אַן איבערבלײַב.<verse eid="2KI 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 10:12" />און ער איז אױפֿגעשטאַנען און איז אַװעק, און איז געגאַנגען קײן שוֹמרוֹן. װי ער איז בײַם בֵית־עֵקֶד פֿון די פּאַסטוכער אין דעם װעג. <verse eid="2KI 10:12" /><verse number="13" style="v" sid="2KI 10:13" />אַזױ האָט יֵהוּא אָנגעטראָפֿן די ברידער פֿון אַחַזיָהו דעם מלך פֿון יהוּדה, און ער האָט געזאָגט: װער זײַט איר? האָבן זײ געזאָגט: די ברידער פֿון אַחַזיָהון זײַנען מיר, און מיר האָבן אַראָפּגענידערט אױף דעם פֿריד פֿון די קינדער פֿון מלך און די קינדער פֿון דער מוטער-מלכּה.<verse eid="2KI 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 10:14" />האָט ער געזאָגט: כאַפּט זײ לעבעדיקערהײט. און מע האָט זײ געכאַפּט לעבעדיקערהײט, און זײ געשאָכטן בײַ דער ברונעם פֿון דעם בֵית־עֵקֶד, צװײ און פֿערציק מאַן. און ער האָט קײנעם פֿון זײ נישט איבערגעלאָזט.<verse eid="2KI 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 10:15" />און װי ער איז אַװעקגעגאַנגען פֿון דאָרטן, אַזױ האָט ער אָנגעטראָפֿן יהוֹנָדָב דעם זון פֿון רֵכָבֿן אים אַנטקעגן. האָט ער אים באַגריסט, און האָט צו אים געזאָגט: איז דײַן האַרץ אױפֿריכטיק, אַזױ װי מײַן האַרץ איז צו דײַן האַרצן? האָט יהוֹנָדָב געזאָגט: יאָ. אױב יאָ, גיב דײַן האַנט. האָט ער געגעבן זײַן האַנט; און ער האָט אים אַרױפֿגענומען צו זיך אױפֿן רײַטװאָגן. <verse eid="2KI 10:15" /><verse number="16" style="v" sid="2KI 10:16" />און ער האָט געזאָגט: קום מיט מיר, און זע װי איך נעם זיך אָן פֿון ה׳ס װעגן. און מע האָט אים געפֿירט אין זײַן רײַטװאָגן.<verse eid="2KI 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 10:17" />און ער איז געקומען קײן שוֹמרוֹן, און האָט דערשלאָגן אַלע װאָס זײַנען געבליבן פֿון אַחאָבֿן אין שוֹמרוֹן. ביז ער האָט אים פֿאַרטיליקט; אַזױ װי דאָס װאָרט פֿון ה׳ װאָס ער האָט גערעדט צו אֵלִיָהון.<verse eid="2KI 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 10:18" />און יֵהוּא האָט אײַנגעזאַמלט דאָס גאַנצע פֿאָלק, און האָט צו זײ געזאָגט: אַחאָבֿ האָט געדינט בַעַל אַ ביסל, יֵהוּא װעט אים דינען פֿיל. <verse eid="2KI 10:18" /><verse number="19" style="v" sid="2KI 10:19" />און אַצונד, רופֿט צו מיר אַלע נבֿיאים פֿון בַעַל, אַלע זײַנע דינער, און אַלע זײַנע כּהנים; קײנער זאָל נישט פֿעלן; װאָרעם אַ גרױסע אָפּפֿערשלאַכטונג צו בַעַל איז בײַ מיר. קײנער װאָס װעט פֿעלן, װעט נישט בלײַבן לעבן. און יֵהוּא האָט דאָס געטאָן מיט באַטרוג, כּדי אונטערצוברענגען די דינער פֿון בַעַל.<verse eid="2KI 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 10:20" />און יֵהוּא האָט געזאָגט: הײליקט אַן אײַנזאַמלונג צו בַעַל. האָבן זײ עס אױסגערופֿן. <verse eid="2KI 10:20" /><verse number="21" style="v" sid="2KI 10:21" />און יֵהוּא האָט געשיקט אין גאַנץ יִשׂרָאֵל, און אַלע דינער פֿון בַעַל זײַנען געקומען, און עס איז נישט געבליבן אַ מענטש װאָס איז נישט געקומען. און זײ זײַנען אַרײַנגעגאַנגען אין הױז פֿון בַעַל; און דאָס הױז פֿון בַעַל איז געװאָרן אָנגעפֿילט פֿון עק צו עק.<verse eid="2KI 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 10:22" />האָט ער געזאָגט צו דעם מאַן װאָס איבער דער קלײדער-קאַמער: גיב אַרױס מלבושים צו אַלע דינער פֿון בַעַל. און ער האָט זײ אַרױסגעגעבן די מלבושים.<verse eid="2KI 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 10:23" />און יֵהוּא איז אַרײַנגעגאַנגען מיט יהוֹנָדָב דעם זון פֿון רֵכָבֿן אין הױז פֿון בַעַל, און ער האָט געזאָגט צו די דינער פֿון בַעַל: זוכט נאָך און זעט, אַז דאָ זאָל נישט זײַן מיט אײַך פֿון די קנעכט פֿון ה׳, נאָר בלױז בַעַל-דינער אַלײן. <verse eid="2KI 10:23" /><verse number="24" style="v" sid="2KI 10:24" />און זײ זײַנען אַרײַנגעגאַנגען צו מאַכן שלאַכטאָפּפֿער און בראַנדאָפּפֿער. און יֵהוּא האָט זיך געשטעלט דרױסן אַכציק מאַן, און אָנגעזאָגט: אױב עמעצער װעט אַנטרונען װערן פֿון די מענטשן װאָס איך גיב איבער אױף אײַערע הענט, איז דײַן נפֿש פֿאַר יענעמס נפֿש.<verse eid="2KI 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 10:25" />און עס איז געװען, װי ער האָט געענדיקט מאַכן דאָס בראַנדאָפּפֿער, אַזױ האָט יֵהוּא געזאָגט צו די לױפֿערס און צו די הױפּטלײַט: גײט אַרײַן דערשלאָגט זײ; קײנער זאָל נישט אַרױס. האָבן זײ זײ דערשלאָגן מיטן שאַרף פֿון שװערד; און די לױפֿערס און די הױפּטלײַט האָבן זײ אַרױסגעװאָרפֿן, און זײַנען אַװעקגעגאַנגען צו דער שטאָט פֿון בַעַלס הױז. <verse eid="2KI 10:25" /><verse number="26" style="v" sid="2KI 10:26" />און זײ האָבן אַרױסגענומען די זײַלשטײנער פֿון בַעַלס הױז, און זײ פֿאַרברענט. <verse eid="2KI 10:26" /><verse number="27" style="v" sid="2KI 10:27" />און זײ האָבן צעבראָכן דעם זײַלשטײן פֿון בַעַל, און האָבן צעבראָכן דאָס הױז פֿון בַעַל, און האָבן עס געמאַכט פֿאַר אָפּטריטן ביז אױף הײַנטיקן טאָג.<verse eid="2KI 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 10:28" />און יֵהוּא האָט פֿאַרטיליקט בַעַל פֿון יִשׂרָאֵל. <verse eid="2KI 10:28" /><verse number="29" style="v" sid="2KI 10:29" />אָבער פֿון די זינד פֿון יָרָבֿעָם דעם זון פֿון נבָֿטן, מיט װאָס ער האָט געמאַכט זינדיקן יִשׂרָאֵל, פֿון הינטער זײ האָט זיך יֵהוּא נישט אָפּגעקערט – פֿון די גילדערנע קעלבער װאָס אין בֵית-אֵל און װאָס אין דָן.<verse eid="2KI 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 10:30" />און ה׳ האָט געזאָגט צו יֵהוּאן: װײַל דו האָסט זיך גוט באַגאַנגען צו טאָן װאָס איז רעכטפֿאַרטיק אין מײַנע אױגן – געטאָן צו אַחאָבֿס הױז אַזױ װי אַלץ אין מײַן האַרצן, װעלן דיר קינדער פֿון פֿירטן דור זיצן אױף דעם טראָן פֿון יִשׂרָאֵל.<verse eid="2KI 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 10:31" />אָבער יֵהוּא האָט נישט געהיט צו גײן אין דער תּורה פֿון ה׳ אלוקי יִשׂרָאֵל מיט זײַן גאַנצן האַרצן; ער האָט זיך נישט אָפּגעקערט פֿון די זינד פֿון יָרָבֿעָמען, װאָס ער האָט געמאַכט זינדיקן יִשׂרָאֵל.<verse eid="2KI 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 10:32" />אין יענע טעג האָט ה׳ אָנגעהױבן אָפּצוהאַקן פֿון יִשׂרָאֵל. און חַזָאֵל האָט זײ געשלאָגן אין גאַנצן געמאַרק פֿון יִשׂרָאֵל: <verse eid="2KI 10:32" /><verse number="33" style="v" sid="2KI 10:33" />פֿון יַרדן צו זונאױפֿגאַנג, דאָס גאַנצע לאַנד גִלעָד, די גָדים, און די ראובֿנים, און די מנַשים, פֿון עַרוֹעֵר װאָס בײַם טאָל אַרנוֹן-גִלעָד און בָשָן.<verse eid="2KI 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 10:34" />און די איבעריקע זאַכן װעגן יֵהוּאן, און אַלץ װאָס ער האָט געטאָן, און זײַן גאַנצע גבֿוּרהשאַפֿט, דאָס איז שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יִשׂרָאֵל.<verse eid="2KI 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 10:35" />און יֵהוּא האָט זיך געלײגט מיט זײַנע עלטערן, און מע האָט אים באַגראָבן אין שוֹמרוֹן. און זײַן זון יהוֹאָחָז איז געװאָרן מלך אױף זײַן אָרט. <verse eid="2KI 10:35" /><verse number="36" style="v" sid="2KI 10:36" />און די טעג װאָס יֵהוּא האָט געקיניגט איבער יִשׂרָאֵל אין שוֹמרוֹן, זײַנען געװען אַכט און צװאַנציק יאָר.<verse eid="2KI 10:36" /></para>
  <chapter eid="2KI 10" />
  <chapter number="11" style="c" pubnumber="יא" sid="2KI 11" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 11:1" />און װי עַתַליָה די מוטער פֿון אַחַזיָהון האָט געזען אַז איר זון איז טױט, אַזױ איז זי אױפֿגעשטאַנען, און האָט אומגעבראַכט דעם גאַנצן קיניגלעכן אָפּשטאַם. <verse eid="2KI 11:1" /><verse number="2" style="v" sid="2KI 11:2" />האָט יהוֹשֶבֿע די טאָכטער פֿון מלך יוֹרָם, אַחַזיָהוס שװעסטער, גענומען יוֹאָש דעם זון פֿון אַחַזיָהן, און האָט אים אַרױסגעגנבֿעט פֿון צװישן דעם מלכס קינדער װאָס האָבן געזאָלט געטײט װערן, אים און זײַן נאַם, אין אַ שלאָפֿקאַמער; און מע האָט אים באַהאַלטן פֿון עַתַליָהון, און ער איז נישט געטײט געװאָרן. <verse eid="2KI 11:2" /><verse number="3" style="v" sid="2KI 11:3" />און ער איז געװען באַהאַלטן בײַ איר אין הױז פֿון ה׳ זעקס יאָר. און עַתַליָה האָט געקיניגט איבערן לאַנד.<verse eid="2KI 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 11:4" />און אױפֿן זיבעטן יאָר האָט יהוֹיָדָע געשיקט און האָט גענומען די הױפּטלײַט איבער די הונדערטן, פֿון די כָּרים און פֿון די לױפֿערס, און ער האָט זײ געבראַכט צו זיך אין הױז פֿון ה׳, און ער האָט מיט זײ געשלאָסן אַ ברית, און האָט זײ באַשװאָרן אין הױז פֿון ה׳, און זײ געװיזן דעם מלכס זון. <verse eid="2KI 11:4" /><verse number="5" style="v" sid="2KI 11:5" />און ער האָט זײ באַפֿױלן, אַזױ צו זאָגן: דאָס איז די זאַך װאָס איר זאָלט טאָן: אַ דריטל פֿון אײַך, די װאָס קומען אַרײַן שבת און היטן די היטונג פֿון דעם מלכס הױז – <verse eid="2KI 11:5" /><verse number="6" style="v" sid="2KI 11:6" />נאָך אַ דריטל איז געװען בײַם טױער סור, און אַ דריטל בײַם טױער הינטער די לױפֿערס – זאָלט היטן די היטונג פֿון פּאַלאַץ פֿאַר אַן אָפּצאַם. <verse eid="2KI 11:6" /><verse number="7" style="v" sid="2KI 11:7" />און צװײ טײלן פֿון אײַך, אַלע װאָס גײען אַרױס שבת, זאָלן היטן די היטונג פֿון ה׳ס הױז אַרום דעם מלך. <verse eid="2KI 11:7" /><verse number="8" style="v" sid="2KI 11:8" />און איר זאָלט אַרומרינגלען דעם מלך רונד אַרום, איטלעכער מיט זײַנע װאַפֿן אין זײַן האַנט. און װער עס קומט אַרײַן אין די רײען, זאָל געטײט װערן. און זײַט מיט דעם מלך בײַ זײַן אַרױסגײן און בײַ זײַן אַרײַנגײן.<verse eid="2KI 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 11:9" />האָבן די הױפּטלײַט פֿון די הונדערטן געטאָן אַזױ װי אַלץ װאָס יהוֹיָדָע דער כּהן האָט באַפֿױלן, און זײ האָבן גענומען איטלעכער זײַנע מענטשן, די װאָס קומען אַרײַן שבת, מיט די װאָס גײען אַרױס שבת, און זײ זײַנען געקומען צו יהוֹיָדָע דעם כּהן. <verse eid="2KI 11:9" /><verse number="10" style="v" sid="2KI 11:10" />און דער כּהן האָט געגעבן די הױפּטלײַט פֿון די הונדערטן די שפּיזן און די שילדן װאָס פֿון מלך דָוִד, װאָס אין הױז פֿון ה׳. <verse eid="2KI 11:10" /><verse number="11" style="v" sid="2KI 11:11" />און די לױפֿערס האָבן זיך געשטעלט איטלעכער מיט זײַנע װאַפֿן אין זײַן האַנט, פֿון דער רעכטער זײַט פֿון הױז ביז דער לינקער זײַט פֿון הױז, בײַם מזבח, און בײַם הױז, לעבן מלך רונד אַרום. <verse eid="2KI 11:11" /><verse number="12" style="v" sid="2KI 11:12" />און ער האָט אַרױסגעפֿירט דעם מלכס זון, און האָט אָנגעטאָן אױף אים די קרױן און די צײגנים; און זײ האָבן אים געמאַכט פֿאַר אַ מלך, און האָבן אים געזאַלבט; און זײ האָבן געקלאַפּט די הענט, און געזאָגט: לעבן זאָל דער מלך!<verse eid="2KI 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 11:13" />און עַתַליָה האָט געהערט דעם קֹול פֿון די לױפֿערס און דעם פֿאָלק, און זי איז געקומען צו דעם פֿאָלק אין הױז פֿון ה׳. <verse eid="2KI 11:13" /><verse number="14" style="v" sid="2KI 11:14" />און זי האָט געזען, ערשט דער מלך שטײט אױף דער בימה, אַזױ װי דער שטײגער, און די האַרן און די טרומײטערערס לעבן מלך, און דאָס גאַנצע פֿאָלק פֿון לאַנד פֿרײט זיך, און בלאָזט אין טרומײטן; האָט עַתַליָה צעריסן אירע קלײדער, און האָט אַרױסגערופֿן: אַ בונט! אַ בונט!<verse eid="2KI 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 11:15" />האָט יהוֹיָדָע דער כּהן באַפֿױלן די הױפּטלײַט פֿון די הונדערטן, די אױפֿזעער פֿון חיל, און ער האָט צו זײ געזאָגט: פֿירט זי אַרױס ביז אינעװײניק פֿון די רײען; און דעם װאָס גײט איר נאָך, טײט מיטן שװערד. װאָרעם דער כּהן האָט געזאָגט: זי זאָל נישט געטײט װערן אין הױז פֿון ה׳.<verse eid="2KI 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 11:16" />האָבן זײ געמאַכט פֿאַר איר אָרט, און זי איז אַרײַנגעגאַנגען דורך דעם פֿערדאײַנגאַנג אין מלכס הױז, און איז דאָרטן געטײט געװאָרן.<verse eid="2KI 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 11:17" />און יהוֹיָדָע האָט געשלאָסן אַ ברית צװישן ה׳ און צװישן דעם מלך און דעם פֿאָלק, צו זײַן דאָס פֿאָלק פֿון ה׳; אױך צװישן דעם מלך און צװישן דעם פֿאָלק. <verse eid="2KI 11:17" /><verse number="18" style="v" sid="2KI 11:18" />און דאָס גאַנצע פֿאָלק פֿון לאַנד איז אַרײַנגעגאַנגען אין הױז פֿון בַעַל, און זײ האָבן עס אײַנגעװאָרפֿן; זײַנע מזבחות און זײַנע בילדער האָבן זײ גוט צעבראָכן, און מַתּן דעם כּהן פֿון בַעַל האָבן זײ געהרגעט פֿאַר די מזבחות.</para>
  <para style="p" vid="2KI 11:18">און דער כּהן האָט געמאַכט אױפֿזעער איבער דעם הױז פֿון ה׳. <verse eid="2KI 11:18" /><verse number="19" style="v" sid="2KI 11:19" />און ער האָט גענומען די הױפּטלײַט פֿון די הונדערטן, און די כָּרים, און די לױפֿערס, און דאָס גאַנצע פֿאָלק פֿון לאַנד, און זײ האָבן אַראָפּגעבראַכט דעם מלך פֿון ה׳ס הױז, און זײ זײַנען אַרײַנגעגאַנגען דורך דעם טױער פֿון די לױפֿערס אין מלכס הױז. און ער האָט זיך געזעצט אױפֿן טראָן פֿון די מלכים. <verse eid="2KI 11:19" /><verse number="20" style="v" sid="2KI 11:20" />און דאָס גאַנצע פֿאָלק פֿון לאַנד האָט זיך געפֿרײט, און די שטאָט איז געװען רויִק. און עַתַליָהון האָבן זײ געטײט מיטן שװערד אין מלכס הױז.<verse eid="2KI 11:20" /></para>
  <chapter eid="2KI 11" />
  <chapter number="12" style="c" pubnumber="יב" sid="2KI 12" />
  <para style="p">
    <verse number="1" style="v" pubnumber="11.21" sid="2KI 12:1" /> זיבן יאָר איז יהואש אַלט געװען, אַז ער איז געװאָרן מלך. <verse eid="2KI 12:1" /><verse number="2" style="v" pubnumber="12.1" sid="2KI 12:2" /> אין זיבעטן יאָר פֿון יֵהוּאן איז יהואש געװאָרן מלך, און פֿערציק יאָר האָט ער געקיניגט אין ירושָלַיִם, און דער נאָמען פֿון זײַן מוטער איז געװען צִבֿיָה פֿון באֵר-שֶבַֿע. <verse eid="2KI 12:2" /><verse number="3" style="v" altnumber="2" sid="2KI 12:3" /> און יהואש האָט געטאָן װאָס איז רעכטפֿאַרטיק אין די אױגן פֿון ה׳ אַלע זײַנע טעג, אַזױ װי יהוֹיָדָע דער כּהן האָט אים געלערנט.<verse eid="2KI 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" altnumber="3" sid="2KI 12:4" /> נאָר די בָמות זײַנען נישט אָפּגעטאָן געװאָרן; דאָס פֿאָלק האָט נאָך אַלץ געשלאַכט און גערײכערט אױף די בָמות.<verse eid="2KI 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" altnumber="4" sid="2KI 12:5" /> און יהואש האָט געזאָגט צו די כּהנים: אַל דאָס געהײליקטע זילבער װאָס װערט געבראַכט אין ה׳ס הױז אין גאַנגבאַרן געלט, דאָס געלט פֿון נפֿשות לױט איטלעכנס אָפּשאַצונג, אַל דאָס געלט װאָס עמיצן קומט אַרױף אױפֿן האַרצן צו ברענגען אין הױז פֿון ה׳, <verse eid="2KI 12:5" /><verse number="6" style="v" altnumber="5" sid="2KI 12:6" /> זאָלן די כּהנים נעמען פֿאַר זיך, איטלעכער פֿון זײַן געבער; און זײ זאָלן פֿאַרריכטן די צעבראָכענע ערטער פֿון הױז, װוּ נאָר אַ צעבראָכענער אָרט װעט זיך דאָרטן געפֿינען.<verse eid="2KI 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" altnumber="6" sid="2KI 12:7" /> אָבער עס איז געװען אין דרײַ און צװאַנציקסטן יאָר פֿון מלך יהואש, האָבן די כּהנים נאָך נישט געהאַט פֿאַרריכט די צעבראָכענע ערטער פֿון הױז. <verse eid="2KI 12:7" /><verse number="8" style="v" altnumber="7" sid="2KI 12:8" /> האָט דער מלך יהואש גערופֿן יהוֹיָדָע דעם כּהן, און די כּהנים, און ער האָט צו זײ געזאָגט: פֿאַר װאָס פֿאַרריכט איר נישט די צעבראָכענע ערטער פֿון הױז? און אַצונד, זאָלט איר מער נישט נעמען קײן געלט פֿון אײַערע געבער, נײַערט אױף די צעבראָכענע ערטער פֿון הױז זאָלט איר עס אָפּגעבן.<verse eid="2KI 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" altnumber="8" sid="2KI 12:9" /> האָבן די כּהנים אײַנגעװיליקט, נישט צו נעמען דאָס געלט פֿון דעם פֿאָלק, און נישט צו פֿאַרריכטן די צעבראָכענע ערטער פֿון הױז.<verse eid="2KI 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" altnumber="9" sid="2KI 12:10" /> און יהוֹיָדָע דער כּהן האָט גענומען אַ קאַסטן, און האָט אױסגעשניטן אַ לאָך אין זײַן טירל, און האָט אים אַװעקגעשטעלט לעבן מזבח, אױף דער רעכטער זײַט װי מע קומט אַרײַן אין הױז פֿון ה׳; און אַהין פֿלעגן די כּהנים װאָס היטן די שװעל, אַרײַנטאָן דאָס גאַנצע געלט װאָס איז געבראַכט געװאָרן אין הױז פֿון ה׳. <verse eid="2KI 12:10" /><verse number="11" style="v" altnumber="10" sid="2KI 12:11" /> און עס איז געװען, װי זײ האָבן געזען אַז אין קאַסטן איז דאָ פֿיל געלט, אַזױ איז אַרױפֿגעקומען דער שרײַבער פֿון מלך, און דער כּהן-גָדול, און זײ האָבן אײַנגעבונדן און איבערגעצײלט דאָס געלט װאָס האָט זיך געפֿונען אין הױז פֿון ה׳. <verse eid="2KI 12:11" /><verse number="12" style="v" altnumber="11" sid="2KI 12:12" /> און זײ פֿלעגן איבערגעבן דאָס אױסגעצײלטע געלט אין די הענט פֿון די װערקמײַנסטערס װאָס זײַנען געװען געשטעלט איבער דעם הױז פֿון ה׳; און זײ האָבן עס אױסגעצאָלט צו די האָלצמײַנסטערס און צו די בױמײַנסטערס װאָס האָבן געאַרבעט אין הױז פֿון ה׳, <verse eid="2KI 12:12" /><verse number="13" style="v" altnumber="12" sid="2KI 12:13" /> און צו די מױערער, און צו די שטײנהעקער, און אױף צו קױפֿן האָלץ און געהאַקטע שטײנער, צו פֿאַרריכטן די צעבראָכענע ערטער פֿון ה׳ס הױז, און אױף אַלץ װאָס איז אַװעקגעגאַנגען אױפֿן הױז, צום פֿאַרריכטן.<verse eid="2KI 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" altnumber="13" sid="2KI 12:14" /> אָבער קײן זילבערנע בעקנס, שנײַצמעסערס, שפּרענגבעקנס, טרומײטן, קײן שום גילדערנע כּלי און זילבערנע כּלי, פֿלעגט נישט געמאַכט װערן פֿאַר דעם הױז פֿון ה׳ פֿון דעם געלט װאָס איז געבראַכט געװאָרן אין הױז פֿון ה׳. <verse eid="2KI 12:14" /><verse number="15" style="v" altnumber="14" sid="2KI 12:15" /> נײַערט צו די װערקמײַנסטערס פֿלעגט מען עס געבן, און זײ פֿלעגן דערמיט פֿאַרריכטן דאָס הױז פֿון ה׳. <verse eid="2KI 12:15" /><verse number="16" style="v" altnumber="15" sid="2KI 12:16" /> און מע פֿלעגט זיך נישט רעכענען מיט די מענטשן װאָס מע פֿלעגט געבן דאָס געלט אױף זײער האַנט, אױף צו געבן צו די בַעַל-מלאָכות, נײַערט אױף נאמנות האָבן זײ געאַרבעט.<verse eid="2KI 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" altnumber="16" sid="2KI 12:17" /> דאָס געלט פֿון שולדאָפּפֿער און דאָס געלט פֿון זינדאָפּפֿער פֿלעגט נישט געבראַכט װערן אין הױז פֿון ה׳; דאָס פֿלעגט געהערן צו די כּהנים.<verse eid="2KI 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" altnumber="17" sid="2KI 12:18" /> דענצמאָל איז אַרױפֿגעגאַנגען חַזָאֵל דער מלך פֿון אַרָם, און האָט געהאַלטן מלחמה אױף גַת, און האָט זי באַצװוּנגען. און חַזָאֵל האָט געקערט זײַן פּנים אַרױפֿצוגײן אױף ירושָלַיִם.<verse eid="2KI 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" altnumber="18" sid="2KI 12:19" /> האָט יהואש דער מלך פֿון יהוּדה גענומען אַלע הײליקע זאַכן װאָס יהוֹשָפֿט, און יהוֹרָם, און אַחַזיָהו, זײַנע עלטערן, די מלכים פֿון יהוּדה, האָבן געהײליקט, און זײַנע אײגענע געהײליקטע זאַכן, און דאָס גאַנצע גאָלד װאָס האָט זיך געפֿונען אין די שאַצקאַמערן פֿון ה׳ס הױז און פֿון מלכס הױז, און ער האָט עס אַװעקגעשיקט צו חַזָאֵל דעם מלך פֿון אַרָם. און ער האָט אָפּגעצױגן פֿון ירושָלַיִם.<verse eid="2KI 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" altnumber="19" sid="2KI 12:20" /> און די איבעריקע זאַכן װעגן יוֹאָשן, און אַלץ װאָס ער האָט געטאָן, דאָס איז שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יהוּדה.<verse eid="2KI 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" altnumber="20" sid="2KI 12:21" /> און זײַנע קנעכט זײַנען אױפֿגעשטאַנען און האָבן געבונטעװעט אַ בונט, און האָבן דערשלאָגן יוֹאָשן אין בֵית-מִלוא װאָס נידערט אַראָפּ צו סִלאָ. <verse eid="2KI 12:21" /><verse number="22" style="v" altnumber="21" sid="2KI 12:22" /> יוֹזכר דער זון פֿון שִמעָתן, און יוֹזָבָֿד דער זון פֿון שומרן, זײַנע קנעכט, האָבן אים געשלאָגן, און ער איז געשטאָרבן. און מע האָט אים באַגראָבן לעבן זײַנע עלטערן אין דָוִדס-שטאָט. און זײַן זון אַמַציָה איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 12:22" /></para>
  <chapter eid="2KI 12" />
  <chapter number="13" style="c" pubnumber="יג" sid="2KI 13" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 13:1" />אין דרײַ און צװאַנציקסטן יאָר פֿון יוֹאָש דעם זון פֿון אַחַזיָהון, דעם מלך פֿון יהוּדה, איז יהוֹאָחָז דער זון פֿון יֵהוּאן געװאָרן מלך איבער יִשׂרָאֵל אין שוֹמרוֹן, זיבעצן יאָר. <verse eid="2KI 13:1" /><verse number="2" style="v" sid="2KI 13:2" />און ער האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳, און איז געגאַנגען נאָך די זינד פֿון יָרָבֿעָם דעם זון פֿון נבָֿטן, װאָס ער האָט געמאַכט זינדיקן יִשׂרָאֵל; ער האָט זיך נישט אָפּגעקערט דערפֿון. <verse eid="2KI 13:2" /><verse number="3" style="v" sid="2KI 13:3" />און דער צאָרן פֿון ה׳ האָט געגרימט אױף יִשׂרָאֵל, און ער האָט זײ געגעבן אין דער האַנט פֿון חַזָאֵל דעם מלך פֿון אַרָם, און אין דער האַנט פֿון בֶן-הַדַד דעם זון פֿון חַזָאֵלן, אַלע טעג.<verse eid="2KI 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 13:4" />האָט יהוֹאָחָז געבעטן צו ה׳, און ה׳ האָט צוגעהערט צו אים, װאָרעם ער האָט געזען די דריקונג פֿון יִשׂרָאֵל, אַז דער מלך פֿון אַרָם האָט זײ געדריקט – <verse eid="2KI 13:4" /><verse number="5" style="v" sid="2KI 13:5" />און ה׳ האָט געגעבן יִשׂרָאֵל אַ העלפֿער, און זײ זײַנען אַרױס פֿון אונטער דער האַנט פֿון אַרָם; און די קינדער פֿון יִשׂרָאֵל זײַנען געזעסן אין זײערע געצעלטן אַזױ װי נעכטן-אײערנעכטן. <verse eid="2KI 13:5" /><verse number="6" style="v" sid="2KI 13:6" />אָבער זײ האָבן זיך נישט אָפּגעקערט פֿון די זינד פֿון דעם הױז פֿון יָרָבֿעָמען, װאָס ער האָט געמאַכט זינדיקן יִשׂרָאֵל; זײ זײַנען געגאַנגען דערין; און אױך די אַשֵרָה איז געבליבן שטײן אין שוֹמרוֹן. – <verse eid="2KI 13:6" /><verse number="7" style="v" sid="2KI 13:7" />װאָרעם ער האָט נישט איבערגעלאָזן יהוֹאָחָזן קײן מאַנשאַפֿט, נאָר בלױז פֿופֿציק רײַטער, און צען רײַטװעגן, און צען טױזנט פֿוסגײער. װײַל דער מלך פֿון אַרָם האָט זײ אומגעבראַכט, און זײ געמאַכט אַזױ װי שטױב צום טרעטן.<verse eid="2KI 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 13:8" />און די איבעריקע זאַכן װעגן יהוֹאָחָזן, און אַלץ װאָס ער האָט געטאָן, און זײַן גבֿוּרהשאַפֿט, דאָס איז שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יִשׂרָאֵל.<verse eid="2KI 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 13:9" />און יהוֹאָחָז האָט זיך געלײגט מיט זײַנע עלטערן, און מע האָט אים באַגראָבן אין שוֹמרוֹן. און זײַן זון יוֹאָש איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 13:10" />אין זיבן און דרײַסיקסטן יאָר פֿון יוֹאָש דעם מלך פֿון יהוּדה איז יהואש דער זון פֿון יהוֹאָחָזן געװאָרן מלך איבער יִשׂרָאֵל אין שוֹמרוֹן, זעכצן יאָר. <verse eid="2KI 13:10" /><verse number="11" style="v" sid="2KI 13:11" />און ער האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳; ער האָט זיך נישט אָפּגעקערט פֿון אַלע זינד פֿון יָרָבֿעָם דעם זון פֿון נבָֿטן, װאָס ער האָט געמאַכט זינדיקן יִשׂרָאֵל; ער איז געגאַנגען דערין.<verse eid="2KI 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 13:12" />און די איבעריקע זאַכן װעגן יוֹאָשן, און אַלץ װאָס ער האָט געטאָן, און זײַן גבֿוּרהשאַפֿט, װי ער האָט מלחמה געהאַלטן מיט אַמַציָה דעם מלך פֿון יהוּדה, דאָס איז שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יִשׂרָאֵל.<verse eid="2KI 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 13:13" />און יוֹאָש האָט זיך געלײגט מיט זײַנע עלטערן; און יָרָבֿעָם האָט זיך געזעצט אױף זײַן טראָן. און יוֹאָש איז באַגראָבן געװאָרן אין שוֹמרוֹן לעבן די מלכים פֿון יִשׂרָאֵל.<verse eid="2KI 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 13:14" />און אֶלישע איז קראַנק געװאָרן אױף דער קראַנקשאַפֿט װאָס ער האָט געזאָלט פֿון איר שטאַרבן; און יוֹאָש דער מלך פֿון יִשׂרָאֵל האָט אַראָפּגענידערט צו אים, און ער האָט געװײנט אױף זײַן פּנים, און האָט געזאָגט: פֿאָטער מײַנער, פֿאָטער מײַנער, רײַטװעגן און רײַטער פֿון יִשׂרָאֵל!<verse eid="2KI 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 13:15" />האָט אֶלישע צו אים געזאָגט: ברענג אַ בױגן און פֿײַלן. האָט ער אים געבראַכט אַ בױגן און פֿײַלן. <verse eid="2KI 13:15" /><verse number="16" style="v" sid="2KI 13:16" />האָט ער געזאָגט צו דעם מלך פֿון יִשׂרָאֵל: לײג אַרױף דײַן האַנט אױפֿן בױגן. האָט ער אַרױפֿגעלײגט זײַן האַנט, און אֶלישע האָט אַרױפֿגעטאָן זײַנע הענט אױף די הענט פֿון מלך. <verse eid="2KI 13:16" /><verse number="17" style="v" sid="2KI 13:17" />און ער האָט געזאָגט: עפֿן דעם פֿענצטער צו מזרח; האָט ער געעפֿנט. האָט אֶלישע געזאָגט: שיס; און ער האָט געשאָסן. האָט ער געזאָגט: אַ פֿײַל פֿון ישועה פֿון ה׳, און אַ פֿײַל פֿון ישועה אַקעגן אַרָם; און װעסט שלאָגן אַרָם אין אַפֿק ביז צו פֿאַרלענדן.<verse eid="2KI 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 13:18" />און ער האָט געזאָגט: נעם די פֿײַלן; און ער האָט זײ גענומען. האָט ער געזאָגט צו דעם מלך פֿון יִשׂרָאֵל: שלאָג אָן דער ערד; און ער האָט געשלאָגן דרײַ מאָל און האָט זיך אָפּגעשטעלט.<verse eid="2KI 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 13:19" />האָט געצערנט אױף אים דער מאַן פֿון ג-ט, און האָט געזאָגט: געזאָלט שלאָגן פֿינף אָדער זעקס מאָל; דענצמאָל װאָלסטו געשלאָגן אַרָם ביז צום פֿאַרלענדן; אָבער אַצונד װעסטו נאָר דרײַ מאָל שלאָגן אַרָם.<verse eid="2KI 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 13:20" />און אֶלישע איז געשטאָרבן, און מע האָט אים באַגראָבן. און באַנדעס פֿון מוֹאָבֿ פֿלעגן קומען אין לאַנד בײַם אָנקום פֿון יאָר.<verse eid="2KI 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 13:21" />און עס איז געװען, מע באַגראָבט אַזױ אַ מענטשן, ערשט זײ דערזען אַ באַנדע. האָבן זײ אַרײַנגעװאָרפֿן דעם מאַן אין אֶלישעס קבֿר. און דער מאַן האָט זיך געקײַקלט ביז ער האָט זיך אָנגערירט אָן אֶלישעס בײנער, און איז לעבעדיק געװאָרן, און האָט זיך געשטעלט אױף זײַנע פֿיס.<verse eid="2KI 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 13:22" />און חַזָאֵל דער מלך פֿון אַרָם האָט געדריקט יִשׂרָאֵל אַלע טעג פֿון יהוֹאָחָזן. <verse eid="2KI 13:22" /><verse number="23" style="v" sid="2KI 13:23" />אָבער ה׳ האָט זײ געלײַטזעליקט און זיך דערבאַרעמט אױף זײ, און האָט זיך צוגעקערט צו זײ פֿון װעגן זײַן ברית מיט אבֿרהם, יִצחָק, און יעקבֿ, און ער האָט זײ נישט געװאָלט אומברענגען, און האָט זײ נישט אַװעקגעװאָרפֿן פֿון זײַן פּנים ביז אַצונד.<verse eid="2KI 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 13:24" />און חַזָאֵל דער מלך פֿון אַרָם איז געשטאָרבן. און זײַן זון בֶן-הַדַד איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 13:25" />און יהואש דער זון פֿון יהוֹאָחָזן האָט צוריקגעקערט פֿון דער האַנט פֿון בֶן-הַדַד דעם זון פֿון חַזָאֵלן די שטעט װאָס ער האָט געהאַט צוגענומען פֿון דער האַנט פֿון זײַן פֿאָטער יהוֹאָחָזן אין מלחמה. דרײַ מאָל האָט אים יוֹאָש געשלאָגן, און האָט צוריקגעקערט די שטעט פֿון יִשׂרָאֵל.<verse eid="2KI 13:25" /></para>
  <chapter eid="2KI 13" />
  <chapter number="14" style="c" pubnumber="יד" sid="2KI 14" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 14:1" />אין צװײטן יאָר פֿון יוֹאָש דעם זון פֿון יוֹאָחָזן, דעם מלך פֿון יִשׂרָאֵל, איז אַמַציָהו דער זון פֿון יוֹאָש דעם מלך פֿון יהוּדה געװאָרן מלך. <verse eid="2KI 14:1" /><verse number="2" style="v" sid="2KI 14:2" />פֿינף און צװאַנציק יאָר איז ער אַלט געװען, אַז ער איז געװאָרן מלך, און נײַן און צװאַנציק יאָר האָט ער געקיניגט אין ירושָלַיִם. און דער נאָמען פֿון זײַן מוטער איז געװען יְהוֹעַדִּין פֿון ירושָלַיִם. <verse eid="2KI 14:2" /><verse number="3" style="v" sid="2KI 14:3" />און ער האָט געטאָן װאָס איז רעכטפֿאַרטיק אין די אױגן פֿון ה׳, אָבער נישט אַזױ װי זײַן פֿאָטער דָוִד; ער האָט געטאָן װי אַלץ װאָס זײַן פֿאָטער יוֹאָש האָט געטאָן. <verse eid="2KI 14:3" /><verse number="4" style="v" sid="2KI 14:4" />נאָר די בָמות זײַנען נישט אָפּגעטאָן געװאָרן; דאָס פֿאָלק האָט נאָך אַלץ געשלאַכט און גערײכערט אױף די בָמות.<verse eid="2KI 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 14:5" />און עס איז געװען, װי די מלוכה איז געװען באַפֿעסטיקט אין זײַן האַנט, אַזױ האָט ער דערשלאָגן זײַנע קנעכט װאָס האָבן דערשלאָגן זײַן פֿאָטער דעם מלך. <verse eid="2KI 14:5" /><verse number="6" style="v" sid="2KI 14:6" />אָבער די קינדער פֿון די דערשלעגער האָט ער נישט געטײט, אַזױ װי עס שטײט געשריבן אין בוך פֿון תּוֹרת-משה, װאָס ה׳ האָט באַפֿױלן, אַזױ צו זאָגן: פֿאָטערס זאָלן נישט געטײט װערן פֿאַר קינדער, און קינדער זאָלן נישט געטײט װערן פֿאַר פֿאָטערס; נײַערט יעטװעדער פֿאַר זײַן זינד זאָל געטײט װערן.<verse eid="2KI 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 14:7" />ער האָט געשלאָגן פֿון אֶדוֹם אין טאָל פֿון זאַלץ צען טױזנט, און אײַנגענומען סֶלַע אין מלחמה, און גערופֿן איר נאָמען יָקתְאֵל ביז אױף הײַנטיקן טאָג.<verse eid="2KI 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 14:8" />דענצמאָל האָט אַמַציָה געשיקט שלוחים צו יהואש דעם זון פֿון יהוֹאָחָז דעם זון פֿון יֵהוּאן, דעם מלך פֿון יִשׂרָאֵל, אַזױ צו זאָגן: קום לאָמיר זיך אָנקוקן אין פּנים.<verse eid="2KI 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 14:9" />האָט יהואש דער מלך פֿון יִשׂרָאֵל געשיקט צו אַמַציָהו דעם מלך פֿון יהוּדה, אַזױ צו זאָגן: דער דאָרן װאָס אין לבֿנוֹן האָט געשיקט צו דעם צעדערבױם װאָס אין לבֿנוֹן, אַזױ צו זאָגן: גיב דײַן טאָכטער צו מײַן זון פֿאַר אַ װײַב. איז פֿאַרבײַגעגאַנגען אַ װילדע חיה װאָס אין לבֿנוֹן, און האָט צעטרעטן דעם דאָרן. <verse eid="2KI 14:9" /><verse number="10" style="v" sid="2KI 14:10" />שלאָגן האָסטו געשלאָגן אֶדוֹם, און דײַן האַרץ האָט דיך דערהױבן; האַלט דײַן כּבֿוד, און זיץ אין דער הײם. און נאָך װאָס זאָלסטו זיך רײצן מיט בײז, און פֿאַלן דו און יהוּדה מיט דיר?<verse eid="2KI 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 14:11" />אָבער אַמַציָהו האָט נישט צוגעהערט. און יהואש דער מלך פֿון יִשׂרָאֵל איז אַרױסגעגאַנגען. און זײ האָבן זיך אָנגעקוקט אין פּנים, ער און אַמַציָהו דער מלך פֿון יהוּדה, אין בֵית-שֶמֶש װאָס געהערט צו יהוּדה. <verse eid="2KI 14:11" /><verse number="12" style="v" sid="2KI 14:12" />און יהוּדה איז געשלאָגן געװאָרן פֿאַר יִשׂרָאֵל. און זײ זײַנען אַנטלאָפֿן איטלעכער צו זײַנע געצעלטן.<verse eid="2KI 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 14:13" />און אַמַציָהו דעם מלך פֿון יהוּדה, דעם זון פֿון יהואש דעם זון פֿון אַחַזיָהון, האָט יהואש דער מלך פֿון יִשׂרָאֵל געכאַפּט אין בֵית-שֶמֶש. און ער איז געקומען קײן ירושָלַיִם, און האָט דורכגעבראָכן די מױער פֿון ירושָלַיִם פֿון דעם טױער פֿון אפֿרים ביז דעם װינקלטױער, פֿיר הונדערט אײלן. <verse eid="2KI 14:13" /><verse number="14" style="v" sid="2KI 14:14" />און ער האָט צוגענומען דאָס גאַנצע גאָלד און זילבער, און אַלע כּלים, װאָס האָבן זיך געפֿונען אין הױז פֿון ה׳ און אין די שאַצקאַמערן פֿון מלכס הױז, און משכּון-קינדער, און האָט זיך אומגעקערט קײן שוֹמרוֹן.<verse eid="2KI 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 14:15" />און די איבעריקע זאַכן פֿון יהואשען װאָס ער האָט געטאָן, און זײַן גבֿוּרהשאַפֿט, און װי ער האָט מלחמה געהאַלטן מיט אַמַציָהו דעם מלך פֿון יהוּדה, דאָס איז שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יִשׂרָאֵל.<verse eid="2KI 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 14:16" />און יהואש האָט זיך געלײגט מיט זײַנע עלטערן, און ער איז באַגראָבן געװאָרן אין שוֹמרוֹן לעבן די מלכים פֿון יִשׂרָאֵל. און זײַן זון יָרָבֿעָם איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 14:17" />און אַמַציָהו דער זון פֿון יוֹאָשן, דער מלך פֿון יהוּדה, האָט געלעבט נאָך דעם טױט פֿון יהואש דעם זון פֿון יהוֹאָחָזן, דעם מלך פֿון יִשׂרָאֵל, פֿופֿצן יאָר.<verse eid="2KI 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 14:18" />און די איבעריקע זאַכן װעגן אַמַציָהון, זײ זײַנען שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יהוּדה.<verse eid="2KI 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 14:19" />און מע האָט געבונטעװעט אױף אים אַ בונט אין ירושָלַיִם, און ער איז אַנטלאָפֿן קײן לָכיש; אָבער מע האָט נאָכגעשיקט נאָך אים קײן לָכיש, און מע האָט אים דאָרטן געטײט. <verse eid="2KI 14:19" /><verse number="20" style="v" sid="2KI 14:20" />און מע האָט אים געבראַכט אױף פֿערד. און ער איז באַגראָבן געװאָרן אין ירושָלַיִם לעבן זײַנע עלטערן אין דָוִדס-שטאָט.<verse eid="2KI 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 14:21" />און דאָס גאַנצע פֿאָלק פֿון יהוּדה האָט גענומען עַזַריָהן, װאָס איז געװען זעכצן יאָר אַלט, און זײ האָבן אים געמאַכט פֿאַר מלך אױפֿן אָרט פֿון זײַן פֿאָטער אַמַציָהון.<verse eid="2KI 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 14:22" />ער האָט אַרומגעבױט אֵילַת און האָט זי צוריקגעקערט צו יהוּדה. נאָך דעם װי דער מלך האָט זיך געלײגט מיט זײַנע עלטערן.<verse eid="2KI 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 14:23" />אין פֿופֿצנטן יאָר פֿון אַמַציָהו דעם זון פֿון יוֹאָשן, דעם מלך פֿון יהוּדה, איז יָרָבֿעָם דער זון פֿון יוֹאָש דעם מלך פֿון יִשׂרָאֵל געװאָרן מלך אין שוֹמרוֹן, אײן און פֿערציק יאָר. <verse eid="2KI 14:23" /><verse number="24" style="v" sid="2KI 14:24" />און ער האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳; ער האָט זיך נישט אָפּגעקערט פֿון אַלע זינד פֿון יָרָבֿעָם דעם זון פֿון נבָֿטן, װאָס ער האָט געמאַכט זינדיקן יִשׂרָאֵל.<verse eid="2KI 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 14:25" />ער האָט צוריקגעשטעלט דעם געמאַרק פֿון יִשׂרָאֵל, פֿון װוּ מע קומט קײן חַמָת ביז דעם ים פֿון פּלױן, אַזױ װי דאָס װאָרט פֿון ה׳ אלוקי יִשׂרָאֵל, װאָס ער האָט גערעדט דורך זײַן קנעכט יוֹנה דעם זון פֿון אַמִתַּין, דעם נבֿיא, װאָס פֿון גַת-חֵפֿר. <verse eid="2KI 14:25" /><verse number="26" style="v" sid="2KI 14:26" />װאָרעם ה׳ האָט געזען די פּײַן פֿון יִשׂרָאֵל, אַז זי איז זײער ביטער, און קײן מוטערמענטש איז נישטאָ, און נישטאָ װער זאָל העלפֿן יִשׂרָאֵל. <verse eid="2KI 14:26" /><verse number="27" style="v" sid="2KI 14:27" />און ה׳ האָט נישט געװאָלט אױסמעקן דעם נאָמען פֿון יִשׂרָאֵל פֿון אונטערן הימל, און ער האָט זײ געהאָלפֿן דורך דער האַנט פֿון יָרָבֿעָם דעם זון פֿון יוֹאָשן.<verse eid="2KI 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 14:28" />און די איבעריקע זאַכן װעגן יָרָבֿעָמען, און אַלץ װאָס ער האָט געטאָן, און זײַן גבֿוּרהשאַפֿט, װי ער האָט מלחמה געהאַלטן, און װי ער האָט צוריקגעקערט דַמֶשֶׂק און חַמָת צו יהוּדה און יִשׂרָאֵל, דאָס איז שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יִשׂרָאֵל.<verse eid="2KI 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 14:29" />און יָרָבֿעָם האָט זיך געלײגט מיט זײַנע עלטערן, מיט די מלכים פֿון יִשׂרָאֵל. און זײַן זון זכַריָה איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 14:29" /></para>
  <chapter eid="2KI 14" />
  <chapter number="15" style="c" pubnumber="טו" sid="2KI 15" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 15:1" />אין זיבן און צװאַנציקסטן יאָר פֿון יָרָבֿעָם דעם מלך פֿון יִשׂרָאֵל, איז עַזַריָה דער זון פֿון אַמַציָה דעם מלך פֿון יהוּדה געװאָרן מלך. <verse eid="2KI 15:1" /><verse number="2" style="v" sid="2KI 15:2" />זעכצן יאָר איז ער אַלט געװען, אַז ער איז געװאָרן מלך, און צװײ און פֿופֿציק יאָר האָט ער געקיניגט אין ירושָלַיִם, און דער נאָמען פֿון זײַן מוטער איז געװען יכָליָהו פֿון ירושָלַיִם.<verse eid="2KI 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 15:3" />און ער האָט געטאָן װאָס איז רעכטפֿאַרטיק אין די אױגן פֿון ה׳, אַזױ װי אַלץ װאָס זײַן פֿאָטער אַמַציָהו האָט געטאָן. <verse eid="2KI 15:3" /><verse number="4" style="v" sid="2KI 15:4" />נאָר די בָמות זײַנען נישט אָפּגעטאָן געװאָרן; דאָס פֿאָלק האָט נאָך אַלץ געשלאַכט און גערײכערט אױף די בָמות.<verse eid="2KI 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 15:5" />און ה׳ האָט געפּלאָגט דעם מלך, און ער איז געװען אַ מצוֹרע ביז דעם טאָג פֿון זײַן טױט. און ער איז געזעסן אין דעם אָפּגעזונדערטן הױז. און יוֹתָם דעם מלכס זון איז געװען איבערן פּאַלאַץ; ער האָט געמשפּט דאָס פֿאָלק פֿון לאַנד.<verse eid="2KI 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 15:6" />און די איבעריקע זאַכן װעגן עַזַריָהון, און אַלץ װאָס ער האָט געטאָן, דאָס איז שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יהוּדה.<verse eid="2KI 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 15:7" />און עַזַריָה האָט זיך געלײגט מיט זײַנע עלטערן, און מע האָט אים באַגראָבן לעבן זײַנע עלטערן אין דָוִדס-שטאָט. און זײַן זון יוֹתָם איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 15:8" />אין אַכט און דרײַסיקסטן יאָר פֿון עַזַריָהו דעם מלך פֿון יהוּדה, האָט זכַריָהו דער זון פֿון יָרָבֿעָמען געקיניגט איבער יִשׂרָאֵל אין שוֹמרוֹן זעקס חדשים. <verse eid="2KI 15:8" /><verse number="9" style="v" sid="2KI 15:9" />און ער האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳, אַזױ װי זײַנע עלטערן האָבן געטאָן; ער האָט זיך נישט אָפּגעקערט פֿון די זינד פֿון יָרָבֿעָם דעם זון פֿון נבָֿטן, װאָס ער האָט געמאַכט זינדיקן יִשׂרָאֵל.<verse eid="2KI 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 15:10" />און שַלום דער זון פֿון יָבֵֿשן האָט געמאַכט אַ בונט אױף אים, און האָט אים געשלאָגן אַנטקעגן פֿאַרן פֿאָלק, און אים געטײט, און איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 15:11" />און די איבעריקע זאַכן װעגן זכַריָהן, זײ זײַנען באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יִשׂרָאֵל.<verse eid="2KI 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 15:12" />דאָס איז געװען דאָס װאָרט פֿון ה׳ װאָס ער האָט גערעדט צו יֵהוּאן, אַזױ צו זאָגן: קינדער ביזן פֿירטן דור װעלן דיר זיצן אױפֿן טראָן פֿון יִשׂרָאֵל; און אַזױ איז געשען.<verse eid="2KI 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 15:13" />שַלום דער זון פֿון יָבֵֿשן איז געװאָרן מלך אין נײַן און דרײַסיקסטן יאָר פֿון עוּזִיָה דעם מלך פֿון יהוּדה; און ער האָט געקיניגט אַ חודש צײַט אין שוֹמרוֹן.<verse eid="2KI 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 15:14" />איז אַרױפֿגעגאַנגען מנַחֵם דער זון פֿון גָדין, פֿון תִּרצָה, און ער איז געקומען קײן שוֹמרוֹן, און האָט געשלאָגן שַלום דעם זון פֿון יָבֵֿשן אין שוֹמרוֹן, און האָט אים געטײט, און איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 15:15" />און די איבעריקע זאַכן װעגן שַלומען, און זײַן בונט װאָס ער האָט געבונטעװעט, דאָס איז באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יִשׂרָאֵל.<verse eid="2KI 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 15:16" />דענצמאָל האָט מנַחֵם געשלאָגן תִּפֿסַח מיט אַלע װאָס אין איר, און אירע געמאַרקן פֿון תִּרצָה אָן. װײַל מע האָט אים נישט געעפֿנט. האָט ער זי געשלאָגן; אַלע אירע טראָגעדיקע האָט ער אױפֿגעשפּאָלטן.<verse eid="2KI 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 15:17" />אין נײַן און דרײַסיקסטן יאָר פֿון עַזַריָה דעם מלך פֿון יהוּדה איז מנַחֵם דער זון פֿון גָדין געװאָרן מלך איבער יִשׂרָאֵל, צען יאָר אין שוֹמרוֹן.<verse eid="2KI 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 15:18" />און ער האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳; ער האָט אַלע זײַנע טעג זיך נישט אָפּגעקערט פֿון די זינד פֿון יָרָבֿעָם דעם זון פֿון נבָֿטן, װאָס ער האָט געמאַכט זינדיקן יִשׂרָאֵל.<verse eid="2KI 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 15:19" />איז געקומען פּול דער מלך פֿון אשור אױפֿן לאַנד. און מנַחֵם האָט געגעבן פּולן טױזנט צענטנער זילבער, אַז זײַן האַנט זאָל זײַן מיט אים צו באַפֿעסטיקן די מלוכה אין זײַן האַנט. <verse eid="2KI 15:19" /><verse number="20" style="v" sid="2KI 15:20" />און מנַחֵם האָט אױסגעװאָרפֿן דאָס געלט אױף יִשׂרָאֵל, אױף אַלע װױלפֿאַרמעגלעכע, פֿופֿציק שקָלים זילבער אױף יעטװעדער מאַן. כּדי צו געבן דעם מלך פֿון אשור. און דער מלך פֿון אשור האָט זיך אומגעקערט, און האָט זיך נישט אָפּגעשטעלט דאָרטן אין לאַנד.<verse eid="2KI 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 15:21" />און די איבעריקע זאַכן װעגן מנַחֵמען, און אַלץ װאָס ער האָט געטאָן, דאָס איז שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יִשׂרָאֵל.<verse eid="2KI 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 15:22" />און מנַחֵם האָט זיך געלײגט מיט זײַנע עלטערן, און זײַן זון פּקַחיָה איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 15:23" />אין פֿופֿציקסטן יאָר פֿון עַזַריָה דעם מלך פֿון יהוּדה איז פּקַחיָה דער זון פֿון מנַחֵמען געװאָרן מלך איבער יִשׂרָאֵל אין שוֹמרוֹן, צװײ יאָר.<verse eid="2KI 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 15:24" />און ער האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳; ער האָט זיך נישט אָפּגעקערט פֿון די זינד פֿון יָרָבֿעָם דעם זון פֿון נבָֿטן, װאָס ער האָט געמאַכט זינדיקן יִשׂרָאֵל.<verse eid="2KI 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 15:25" />און זײַן הױפּטמאַן פֶּקַח דער זון פֿון רמַליָהון האָט געמאַכט אַ בונט אױף אים, און האָט אים דערשלאָגן אין שוֹמרוֹן, אין פּאַלאַץ פֿון מלכס הױז, בײַ אַרגוֹבֿ און בײַ אַריֵה; און מיט אים זײַנען געװען פֿופֿציק מאַן פֿון די גִלעָדער; און ער האָט אים געטײט, און איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 15:26" />און די איבעריקע זאַכן װעגן פּקַחיָהן, און אַלץ װאָס ער האָט געטאָן, דאָס איז באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יִשׂרָאֵל.<verse eid="2KI 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 15:27" />אין צװײ און פֿופֿציקסטן יאָר פֿון עַזַריָה דעם מלך פֿון יהוּדה, איז פֶּקַח דער זון פֿון רמַליָהון געװאָרן מלך איבער יִשׂרָאֵל אין שוֹמרוֹן, צװאַנציק יאָר.<verse eid="2KI 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 15:28" />און ער האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳; ער האָט זיך נישט אָפּגעקערט פֿון די זינד פֿון יָרָבֿעָם דעם זון פֿון נבָֿטן, װאָס ער האָט געמאַכט זינדיקן יִשׂרָאֵל.<verse eid="2KI 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 15:29" />אין די טעג פֿון פֶּקַח דעם מלך פֿון יִשׂרָאֵל, איז געקומען תִּגלַת-פִּלאֶסֶר דער מלך פֿון אשור, און האָט גענומען עִיוֹן, און אָבֿל-בֵית-מעכָה, און יָנוֹחַ, און קֶדֶש, און חָצוֹר, און גִלעָד, און גָליל, דאָס גאַנצע לאַנד נַפֿתָּלי; און ער האָט זײ פֿאַרטריבן קײן אשור.<verse eid="2KI 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 15:30" />און הוֹשֵעַ דער זון פֿון אֵלָהן האָט געבונטעװעט אַ בונט אױף פֶּקַח דעם זון פֿון רמַליָהון, און ער האָט אים געשלאָגן און אים געטײט, און איז געװאָרן מלך אױף זײַן אָרט, אין צװאַנציקסטן יאָר פֿון יוֹתָם דעם זון פֿון עוּזִיָהן.<verse eid="2KI 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 15:31" />און די איבעריקע זאַכן װעגן פֶּקַחן, און אַלץ װאָס ער האָט געטאָן, דאָס איז באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יִשׂרָאֵל.<verse eid="2KI 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 15:32" />אין צװײטן יאָר פֿון פֶּקַח דעם זון פֿון רמַליָהון, דעם מלך פֿון יִשׂרָאֵל, איז יוֹתָם דער זון פֿון עוּזִיָהו דעם מלך פֿון יהוּדה געװאָרן מלך. <verse eid="2KI 15:32" /><verse number="33" style="v" sid="2KI 15:33" />פֿינף און צװאַנציק יאָר איז ער אַלט געװען, אַז ער איז געװאָרן מלך, און זעכצן יאָר האָט ער געקיניגט אין ירושָלַיִם. און דער נאָמען פֿון זײַן מוטער איז געװען ירוּשאָ די טאָכטער פֿון צָדוֹקן.<verse eid="2KI 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 15:34" />און ער האָט געטאָן װאָס איז רעכטפֿאַרטיק אין די אױגן פֿון ה׳; ער האָט געטאָן אַזױ װי אַלץ װאָס זײַן פֿאָטער עוּזִיָהו האָט געטאָן.<verse eid="2KI 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 15:35" />נאָר די בָמות זײַנען נישט אָפּגעטאָן געװאָרן; דאָס פֿאָלק האָט נאָך אַלץ געשלאַכט און גערײכערט אױף די בָמות.</para>
  <para style="p" vid="2KI 15:35">ער האָט געבױט דאָס אױבערשטע טױער פֿון ה׳ס הױז.<verse eid="2KI 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 15:36" />און די איבעריקע זאַכן װעגן יוֹתָמען, און אַלץ װאָס ער האָט געטאָן, דאָס איז שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יהוּדה.<verse eid="2KI 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2KI 15:37" />אין יענע טעג האָט ה׳ אָנגעהױבן אָנשיקן אױף יהוּדה רצין דעם מלך פֿון אַרָם, און פֶּקַח דעם זון פֿון רמַליָהון.<verse eid="2KI 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2KI 15:38" />און יוֹתָם האָט זיך געלײגט מיט זײַנע עלטערן, און ער איז באַגראָבן געװאָרן לעבן זײַנע עלטערן אין זײַן פֿאָטער דָוִדס-שטאָט. און זײַן זון אָחָז איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 15:38" /></para>
  <chapter eid="2KI 15" />
  <chapter number="16" style="c" pubnumber="טז" sid="2KI 16" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 16:1" />אין זיבעצנטן יאָר פֿון פֶּקַח דעם זון פֿון רמַליָהון, איז אָחָז דער זון פֿון יוֹתָם דעם מלך פֿון יהוּדה געװאָרן מלך. <verse eid="2KI 16:1" /><verse number="2" style="v" sid="2KI 16:2" />צװאַנציק יאָר איז אָחָז אַלט געװען, אַז ער איז געװאָרן מלך, און זעכצן יאָר האָט ער געקיניגט אין ירושָלַיִם. און ער האָט נישט געטאָן װאָס איז רעכטפֿאַרטיק אין די אױגן פֿון ה׳ זײַן ג-ט, אַזױ װי זײַן פֿאָטער דָוִד. <verse eid="2KI 16:2" /><verse number="3" style="v" sid="2KI 16:3" />נײַערט ער איז געגאַנגען אין דעם װעג פֿון די מלכים פֿון יִשׂרָאֵל. און ער האָט אױך געמאַכט דורכגײן זײַן זון דורכן פֿײַער, אַזױ װי די אומװערדיקײטן פֿון די פֿעלקער װאָס ה׳ האָט זײ פֿאַרטריבן פֿון פֿאַר די קינדער פֿון יִשׂרָאֵל. <verse eid="2KI 16:3" /><verse number="4" style="v" sid="2KI 16:4" />און ער האָט געשלאַכט און גערײכערט אױף די בָמות, און אױף די בערגלעך, און אונטער יעטװעדער צװײַגהאַפֿטיקן בױם.<verse eid="2KI 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 16:5" />דענצמאָל איז אַרױפֿגעקומען רצין דער מלך פֿון אַרָם, און פֶּקַח דער זון פֿון רמַליָהון, דער מלך פֿון יִשׂרָאֵל, קײן ירושָלַיִם אױף מלחמה; און זײ האָבן געלעגערט אױף אָחָזן, און נישט געקענט בײַקומען.<verse eid="2KI 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 16:6" />אין יענער צײַט האָט רצין דער מלך פֿון אַרָם צוריקגעקערט אֵילַת צו אַרָם, און האָט אַרױסגעװאָרפֿן די מענער פֿון יהוּדה פֿון אֵילַת. און די אַדוֹמים זײַנען געקומען קײן אֵילַת, און זײַנען דאָרטן געבליבן זיצן ביז אױף הײַנטיקן טאָג.<verse eid="2KI 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 16:7" />און אָחָז האָט געשיקט שלוחים צו תִּגלַת-פִּלאֶסֶר דעם מלך פֿון אשור, אַזױ צו זאָגן: דײַן קנעכט און דײַן זון בין איך; קום אַרױף און העלף מיר פֿון דער האַנט פֿון דעם מלך פֿון אַרָם, און פֿון דער האַנט פֿון דעם מלך פֿון יִשׂרָאֵל, װאָס זײַנען אױפֿגעשטאַנען אױף מיר.<verse eid="2KI 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 16:8" />און אָחָז האָט גענומען דאָס זילבער און דאָס גאָלד װאָס האָט זיך געפֿונען אין ה׳ס הױז און אין די שאַצקאַמערן פֿון מלכס הױז, און האָט געשיקט צום מלך פֿון אשור שוחד. <verse eid="2KI 16:8" /><verse number="9" style="v" sid="2KI 16:9" />און דער מלך פֿון אשור האָט צוגעהערט צו אים, און דער מלך פֿון אשור איז אַרױפֿגעגאַנגען אױף דַמֶשֶׂק, און האָט זי אײַנגענומען, און האָט פֿאַרטריבן אירע באַװױנער קײן קיר, און רצינען האָט ער געטײט.<verse eid="2KI 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 16:10" />און דער מלך אָחָז איז געגאַנגען קײן דַמֶשֶׂק אַנטקעגן תִּגלַת-פִּלאֶסֶר דעם מלך פֿון אשור, און ער האָט געזען דעם מזבח װאָס אין דַמֶשֶׂק. און דער מלך אָחָז האָט געשיקט צו אוּרִיה דעם כּהן די געשטאַלט פֿון דעם מזבח און זײַן געבױ לױט זײַן גאַנצער אַרבעט. <verse eid="2KI 16:10" /><verse number="11" style="v" sid="2KI 16:11" />און אוּרִיה דער כּהן האָט אױפֿגעבױט דעם מזבח; אַזױ װי אַלץ װאָס דער מלך אָחָז האָט געשיקט פֿון דַמֶשֶׂק. אַזױ האָט אוּרִיה דער כּהן געמאַכט, אײדער דער מלך אָחָז איז געקומען פֿון דַמֶשֶׂק. <verse eid="2KI 16:11" /><verse number="12" style="v" sid="2KI 16:12" />און אַז דער מלך איז געקומען פֿון דַמֶשֶׂק, האָט דער מלך געזען דעם מזבח; און דער מלך האָט גענענט צום מזבח, און האָט אױפֿגעבראַכט אױף אים. <verse eid="2KI 16:12" /><verse number="13" style="v" sid="2KI 16:13" />און ער האָט געדעמפֿט זײַן בראַנדאָפּפֿער און זײַן שפּײַזאָפּפֿער, און געגאָסן זײַן גיסאָפּפֿער, און געשפּרענגט דאָס בלוט פֿון זײַן פֿרידאָפּפֿער, אױפֿן מזבח. <verse eid="2KI 16:13" /><verse number="14" style="v" sid="2KI 16:14" />און דעם קופּערנעם מזבח װאָס פֿאַר ג-ט האָט ער צוגערוקט פֿון פֿאַר דעם הױז, פֿון צװישן דעם מזבח און צװישן דעם הױז פֿון ה׳, און האָט אים אַװעקגעשטעלט בײַם זײַט פֿון דעם מזבח צו צפֿון.<verse eid="2KI 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 16:15" />און דער מלך אָחָז האָט באַפֿױלן אוּרִיה דעם כּהן, אַזױ צו זאָגן: אױף דעם גרױסן מזבח דעמף דאָס בראַנדאָפּפֿער פֿון אין דער פֿרי, און דאָס שפּײַזאָפּפֿער פֿון אָװנט, און דאָס בראַנדאָפּפֿער פֿון מלך און זײַן שפּײַזאָפּפֿער, און דאָס בראַנדאָפּפֿער פֿון דעם גאַנצן פֿאָלק פֿון לאַנד, און זײער שפּײַזאָפּפֿער און זײערע גיסאָפּפֿער; און איטלעך בלוט פֿון בראַנדאָפּפֿער און איטלעך בלוט פֿון שלאַכטאָפּפֿער זאָלסטו שפּרענגען אױף אים. און װעגן דעם קופּערנעם מזבח װעל איך דאַרפֿן נאָכקוקן.<verse eid="2KI 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 16:16" />און אוּרִיה דער כּהן האָט געטאָן אַזױ װי אַלץ װאָס דער מלך אָחָז האָט באַפֿױלן.<verse eid="2KI 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 16:17" />און דער מלך אָחָז האָט אָפּגעהאַקט די ראַמען פֿון די געשטעלן, און האָט אָפּגעטאָן פֿון זײ דעם האַנטפֿאַס. און דעם ים האָט ער אַראָפּגענומען פֿון די קופּערנע רינדער װאָס אונטער אים, און האָט אים אַװעקגעשטעלט אױף אַ געפֿלאַסטער פֿון שטײנער. <verse eid="2KI 16:17" /><verse number="18" style="v" sid="2KI 16:18" />און דער איבערדעק פֿאַר שבת װאָס מע האָט אָנגעבױט אָן הױז, און דעם מלכס אײַנגאַנג דערױסן, האָט ער איבערגעשטעלט אין הױז פֿון ה׳ װעגן דעם מלך פֿון אשור.<verse eid="2KI 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 16:19" />און די איבעריקע זאַכן פֿון אָחָזן װאָס ער האָט געטאָן, זײ זײַנען שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יהוּדה.<verse eid="2KI 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 16:20" />און אָחָז האָט זיך געלײגט מיט זײַנע עלטערן, און ער איז באַגראָבן געװאָרן לעבן זײַנע עלטערן אין דָוִדס-שטאָט. און זײַן זון חִזקִיָהו איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 16:20" /></para>
  <chapter eid="2KI 16" />
  <chapter number="17" style="c" pubnumber="יז" sid="2KI 17" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 17:1" />אין צװעלפֿטן יאָר פֿון אָחָז דעם מלך פֿון יהוּדה, איז הוֹשֵעַ דער זון פֿון אֵלָהן געװאָרן מלך אין שוֹמרוֹן איבער יִשׂרָאֵל, נײַן יאָר.<verse eid="2KI 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 17:2" />און ער האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳, נאָר נישט אַזױ װי די מלכים פֿון יִשׂרָאֵל װאָס זײַנען געװען פֿאַר אים.<verse eid="2KI 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 17:3" />אױף אים איז אַרױפֿגעגאַנגען שַלמַנאֶסֶר דער מלך פֿון אשור, און הוֹשֵעַ איז געװאָרן אַ קנעכט צו אים, און אים געצאָלט מִנְחָה.<verse eid="2KI 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 17:4" />און דער מלך פֿון אשור האָט אױסגעפֿונען אין הוֹשֵעַן אַ בונט, װײַל ער האָט געשיקט שלוחים צו סוֹא דעם מלך פֿון מִצרַיִם, און האָט נישט אַרױפֿגעבראַכט מִנְחָה צו דעם מלך פֿון אשור אַזױ װי יאָר אין יאָר. און דער מלך פֿון אשור האָט אים פֿאַרהאַלטן, און האָט אים אַרײַנגעשפּאַרט אין תּפֿיסה.<verse eid="2KI 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 17:5" />און דער מלך פֿון אשור איז אַרױפֿגעגאַנגען אױפֿן גאַנצן לאַנד, און איז אַרױפֿגעגאַנגען אױף שוֹמרוֹן, און האָט געלעגערט אױף איר דרײַ יאָר. <verse eid="2KI 17:5" /><verse number="6" style="v" sid="2KI 17:6" />אין נײַנטן יאָר פֿון הוֹשֵעַן האָט דער מלך פֿון אשור באַצװוּנגען שוֹמרוֹן, און האָט פֿאַרטריבן יִשׂרָאֵל קײן אשור, און זײ באַזעצט אין חַלַח, און בײַם טײַך חָבֿוֹר, אין גוֹזָן, און אין די שטעט פֿון מָדַי.<verse eid="2KI 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 17:7" />און דאָס איז געשען װײַל די קינדער פֿון יִשׂרָאֵל האָבן געזינדיקט צו ה׳ זײער ג-ט װאָס האָט זײ אױפֿגעבראַכט פֿון לאַנד מִצרַיִם, פֿון אונטער דער האַנט פֿון פַּרעה דעם מלך פֿון מִצרַיִם, און זײ האָבן געפֿאָרכט פֿרעמדע ג‑טער. <verse eid="2KI 17:7" /><verse number="8" style="v" sid="2KI 17:8" />און זײ זײַנען געגאַנגען אין די געזעצן פֿון די פֿעלקער װאָס ה׳ האָט פֿאַרטריבן פֿון פֿאַר די קינדער פֿון יִשׂרָאֵל; דעס גלײַכן די מלכים פֿון יִשׂרָאֵל, װאָס זײ האָבן געמאַכט. <verse eid="2KI 17:8" /><verse number="9" style="v" sid="2KI 17:9" />און די קינדער פֿון יִשׂרָאֵל האָבן צוגעטראַכט זאַכן װאָס נישט ריכטיק צו ה׳ זײער ג-ט, און זײ האָבן זיך געבױט בָמות אין אַלע זײערע שטעט, פֿון אַ װעכטערטורעם ביז אַ פֿעסטונגשטאָט. <verse eid="2KI 17:9" /><verse number="10" style="v" sid="2KI 17:10" />און זײ האָבן זיך אױפֿגעשטעלט זײַלשטײנער און געצנשטאַנגען אױף יעטװעדער הױכן בערגל און אונטער יעטװעדער צװײַגהאַפֿטיקן בױם. <verse eid="2KI 17:10" /><verse number="11" style="v" sid="2KI 17:11" />און זײ האָבן דאָרטן גערײכערט אױף אַלע בָמות, אַזױ װי די פֿעלקער װאָס ה׳ האָט פֿאַרטריבן פֿון פֿאַר זײ; און זײ האָבן געטאָן שלעכטע זאַכן צו דערצערענען ה׳. <verse eid="2KI 17:11" /><verse number="12" style="v" sid="2KI 17:12" />און זײ האָבן געדינט די אָפּגעטער, װאָס ה׳ האָט זײ אָנגעזאָגט: איר זאָלט נישט טאָן די דאָזיקע זאַך. <verse eid="2KI 17:12" /><verse number="13" style="v" sid="2KI 17:13" />און ה׳ האָט געװאָרנט יִשׂרָאֵל און יהוּדה דורך איטלעכן נבֿיא, איטלעכן זעער, אַזױ צו זאָגן: קערט אײַך אום פֿון אײַערע שלעכטע װעגן, און היט מײַנע געבאָט, מײַנע געזעצן, לױט דער גאַנצער תּורה װאָס איך האָב באַפֿױלן אײַערע עלטערן, און װאָס איך האָב געשיקט צו אײַך דורך מײַנע קנעכט, די נבֿיאים. <verse eid="2KI 17:13" /><verse number="14" style="v" sid="2KI 17:14" />אָבער זײ האָבן נישט צוגעהערט, און זײ האָבן האַרט געמאַכט זײער נאַקן, אַזױ װי דער נאַקן פֿון זײערע עלטערן װאָס האָבן נישט געגלױבט אין ה׳ זײער ג-ט. <verse eid="2KI 17:14" /><verse number="15" style="v" sid="2KI 17:15" />און זײ האָבן פֿאַראַכט זײַנע געזעצן און זײַן ברית װאָס ער האָט געשלאָסן מיט זײערע עלטערן, און זײַנע װאָרענישן, צײגנים װאָס ער האָט זײ געװאָרנט, און זײ זײַנען געגאַנגען נאָך נישטיקײט און געװאָרן נישטיק, און נאָך די פֿעלקער װאָס רונד אַרום זײ, װאָס ה׳ האָט זײ באַפֿױלן נישט צו טאָן אַזױ װי זײ. <verse eid="2KI 17:15" /><verse number="16" style="v" sid="2KI 17:16" />און זײ האָבן פֿאַרלאָזן אַלע געבאָט פֿון ה׳ זײער ג-ט, און האָבן זיך געמאַכט געגאָסענע געצן – צװײ קעלבער, און געמאַכט אַן אַשֵרָה, און זיך געבוקט צו דעם גאַנצן חיל פֿון הימל, און געדינט בַעַל. <verse eid="2KI 17:16" /><verse number="17" style="v" sid="2KI 17:17" />און זײ האָבן געמאַכט דורכגײן זײערע זין און זײערע טעכטער דורכן פֿײַער, און האָבן געברױכט װאָרזאָגערײַ און געצױבערט, און זיך אָפּגעגעבן צו טאָן װאָס איז שלעכט אין די אױגן פֿון ה׳, אים צו דערצערענען. <verse eid="2KI 17:17" /><verse number="18" style="v" sid="2KI 17:18" />און ה׳ האָט זײער געצערנט אױף יִשׂרָאֵל, און ער האָט זײ אָפּגעטאָן פֿון זײַן פּנים; עס איז נישט געבליבן אַחוץ שבֿט יהוּדה אַלײן. <verse eid="2KI 17:18" /><verse number="19" style="v" sid="2KI 17:19" />האָט אױך יהוּדה נישט געהיט די געבאָט פֿון ה׳ זײער ג-ט, און זײ זײַנען געגאַנגען אין די געזעצן פֿון יִשׂרָאֵל, װאָס יענע האָבן געמאַכט. <verse eid="2KI 17:19" /><verse number="20" style="v" sid="2KI 17:20" />און ה׳ האָט פֿאַראַכט דעם גאַנצן זאָמען פֿון יִשׂרָאֵל, און ער האָט זײ געפּײַניקט, און האָט זײ געגעבן אין דער האַנט פֿון אױסרױבער, ביז ער האָט זײ אַװעקגעװאָרפֿן פֿון זײַן פּנים. <verse eid="2KI 17:20" /><verse number="21" style="v" sid="2KI 17:21" />װאָרעם אַז ער האָט אָפּגעריסן יִשׂרָאֵל פֿון דעם הױז פֿון דָוִד, און זײ האָבן געמאַכט פֿאַר אַ מלך יָרָבֿעָם דעם זון פֿון נבָֿטן, האָט יָרָבֿעָם אָפּגעפֿירט יִשׂרָאֵל פֿון הינטער ה׳, און ער האָט זײ געמאַכט זינדיקן אַ גרױסע זינד. <verse eid="2KI 17:21" /><verse number="22" style="v" sid="2KI 17:22" />און די קינדער פֿון יִשׂרָאֵל זײַנען געגאַנגען אין אַלע זינד פֿון יָרָבֿעָמען װאָס ער האָט געטאָן; זײ האָבן זיך נישט אָפּגעקערט דערפֿון. <verse eid="2KI 17:22" /><verse number="23" style="v" sid="2KI 17:23" />ביז ה׳ האָט אָפּגעטאָן יִשׂרָאֵל פֿון זײַן פּנים, אַזױ װי ער האָט גערעדט דורך אַלע זײַנע קנעכט די נבֿיאים, און יִשׂרָאֵל איז פֿאַרטריבן געװאָרן פֿון זײַן ערד קײן אשור אױף הײַנטיקן טאָג.<verse eid="2KI 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 17:24" />און דער מלך פֿון אשור האָט געבראַכט מענטשן פֿון בָבֿל, און פֿון כּוּתָה, און פֿון עַוָא, און פֿון חַמָת, און פֿון ספֿרוַיִם, און באַזעצט אין די שטעט פֿון שוֹמרוֹן אַנשטאָט די קינדער פֿון יִשׂרָאֵל. און זײ האָבן געאַרבט שוֹמרוֹן, און זײַנען געזעסן אין אירע שטעט.<verse eid="2KI 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 17:25" />און עס איז געװען אין אָנהײב פֿון זײער זיצן דאָרטן, האָבן זײ נישט געפֿאָרכט ה׳, און ה׳ האָט אָנגעשיקט אױף זײ לײבן, און זײ פֿלעגן אױסהרגען צװישן זײ. <verse eid="2KI 17:25" /><verse number="26" style="v" sid="2KI 17:26" />האָט מען אָנגעזאָגט דעם מלך פֿון אשור, אַזױ צו זאָגן: די פֿעלקער װאָס דו האָסט אַװעקגעפֿירט, און באַזעצט אין די שטעט פֿון שוֹמרוֹן, װײסן נישט דעם שטײגער פֿון דעם ג-ט פֿון לאַנד; דערום האָט ער אָנגעשיקט אױף זײ לײבן, און זע, זײ טײטן זײ, אַזױ װי זײ װײסן נישט דעם שטײגער פֿון דעם ג-ט פֿון לאַנד.<verse eid="2KI 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 17:27" />האָט דער מלך פֿון אשור באַפֿױלן, אַזױ צו זאָגן: פֿירט אַװעק אַהין אײנעם פֿון די כּהנים װאָס איר האָט פֿאַרטריבן פֿון דאָרטן; און זאָלן זײ גײן און זיך באַזעצן דאָרטן, און ער זאָל זײ לערנען דעם שטײגער פֿון דעם ג-ט פֿון לאַנד.<verse eid="2KI 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 17:28" />איז געקומען אײנער פֿון די כּהנים װאָס מע האָט געהאַט פֿאַרטריבן פֿון שוֹמרוֹן, און ער האָט זיך באַזעצט אין בֵית-אֵל, און האָט זײ געלערנט װי זײ זאָלן פֿאָרכטן ה׳. <verse eid="2KI 17:28" /><verse number="29" style="v" sid="2KI 17:29" />אָבער איטלעך פֿאָלק פֿלעגט אױך מאַכן זײַנע אײגענע ג‑טער, און זײ האָבן זײ אַװעקגעשטעלט אין די הײַזער פֿון די בָמות װאָס די שוֹמרוֹנים האָבן געמאַכט; איטלעך פֿאָלק אין זײערע שטעט װאָס זײ זײַנען דאָרטן געזעסן. <verse eid="2KI 17:29" /><verse number="30" style="v" sid="2KI 17:30" />און די מענטשן פֿון בָבֿל האָבן געמאַכט סוכּוֹת-בנוֹת, און די מענטשן פֿון כּוּת האָבן געמאַכט נֵרגַל, און די מענטשן פֿון חַמָת האָבן געמאַכט אַשימאָ <verse eid="2KI 17:30" /><verse number="31" style="v" sid="2KI 17:31" />און די עַוִים האָבן געמאַכט נִבֿחַז און תַּרתָּק, און די ספֿרוַיִם האָבן פֿאַרברענט זײערע קינדער אין פֿײַער צו אַדרַמֶלֶך און עַנַמֶלֶך, די ג‑טער פֿון ספֿרוַיִם. <verse eid="2KI 17:31" /><verse number="32" style="v" sid="2KI 17:32" />דערבײַ פֿלעגן זײ פֿאָרכטן ה׳, און זײ האָבן זיך געמאַכט פֿון צװישן זיך כּהנים פֿון בָמות, װאָס פֿלעגן מקריבֿ זײַן פֿאַר זײ אין די הײַזער פֿון די בָמות. <verse eid="2KI 17:32" /><verse number="33" style="v" sid="2KI 17:33" />ה׳ פֿלעגן זײ פֿאָרכטן, אָבער זײערע ג‑טער פֿלעגן זײ דינען, אַזױ װי דער שטײגער פֿון די פֿעלקער װאָס מע האָט זײ פֿון דאָרטן אַװעקגעפֿירט.<verse eid="2KI 17:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 17:34" />ביז אױף הײַנטיקן טאָג טוען זײ אַזױ װי די פֿריִערדיקע שטײגערס; זײ פֿאָרכטן נישט ה׳, און זײ טוען נישט אַזױ װי זײערע חוקים און װי זײער געזעץ, און אַזױ װי די תּורה און װי דאָס געבאָט װאָס ג-ט האָט געבאָטן די קינדער פֿון יעקבֿ, װאָס ער האָט געמאַכט זײַן נאָמען יִשׂרָאֵל; <verse eid="2KI 17:34" /><verse number="35" style="v" sid="2KI 17:35" />װאָס ה׳ האָט מיט זײ געשלאָסן אַ ברית, און האָט זײ באַפֿױלן, אַזױ צו זאָגן: איר זאָלט נישט פֿאָרכטן פֿרעמדע ג‑טער, און איר זאָלט זיך נישט בוקן צו זײ, און זײ נישט דינען, און נישט שלאַכטן צו זײ. <verse eid="2KI 17:35" /><verse number="36" style="v" sid="2KI 17:36" />נײַערט ה׳ װאָס האָט אײַך אױפֿגעבראַכט פֿון לאַנד מִצרַיִם מיט גרױס שטאַרקײט, און מיט אַן אױסגעשטרעכטן אָרעם, אים זאָלט איר פֿאָרכטן, און צו אים זאָלט איר זיך בוקן, און צו אים זאָלט איר שלאַכטן. <verse eid="2KI 17:36" /><verse number="37" style="v" sid="2KI 17:37" />און די חוקים און די געזעצן, און די תּורה און דאָס געבאָט, װאָס ער האָט פֿאַר אײַך געשריבן, זאָלט איר היטן צו טאָן אַלע טאָג; און איר זאָלט נישט פֿאָרכטן פֿרעמדע ג‑טער. <verse eid="2KI 17:37" /><verse number="38" style="v" sid="2KI 17:38" />און דעם ברית װאָס איך האָב געשלאָסן מיט אײַך, זאָלט איר נישט פֿאַרגעסן; און איר זאָלט נישט פֿאָרכטן פֿרעמדע ג‑טער. <verse eid="2KI 17:38" /><verse number="39" style="v" sid="2KI 17:39" />נײַערט ה׳ אלוקיכם זאָלט איר פֿאָרכטן, און ער װעט אײַך מציל זײַן פֿון דער האַנט פֿון אַלע אײַערע פֿײַנט. <verse eid="2KI 17:39" /><verse number="40" style="v" sid="2KI 17:40" />אָבער זײ האָבן נישט צוגעהערט, נײַערט זײ טוען אַזױ װי זײער פֿריִערדיקער שטײגער.<verse eid="2KI 17:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="2KI 17:41" />און די דאָזיקע פֿעלקער פֿלעגן פֿאָרכטן ה׳, אָבער זײערע געצן פֿלעגן זײ דינען; דעס גלײַכן זײערע קינדער און זײערע קינדס-קינדער – אַזױ װי זײערע עלטערן האָבן געטאָן, אַזױ טוען זײ ביז אױף הײַנטיקן טאָג.<verse eid="2KI 17:41" /></para>
  <chapter eid="2KI 17" />
  <chapter number="18" style="c" pubnumber="יח" sid="2KI 18" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 18:1" />און עס איז געװען אין דריטן יאָר פֿון הוֹשֵעַ דעם זון פֿון אֵלָהן, דעם מלך פֿון יִשׂרָאֵל, איז חִזקִיָה דער זון פֿון אָחָז דעם מלך פֿון יהוּדה געװאָרן מלך. <verse eid="2KI 18:1" /><verse number="2" style="v" sid="2KI 18:2" />פֿינף און צװאַנציק יאָר איז ער אַלט געװען, אַז ער איז געװאָרן מלך, און נײַן און צװאַנציק יאָר האָט ער געקיניגט אין ירושָלַיִם. און דער נאָמען פֿון זײַן מוטער איז געװען אַבֿי די טאָכטער פֿון זכַריָהן.<verse eid="2KI 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 18:3" />און ער האָט געטאָן װאָס איז רעכטפֿאַרטיק אין די אױגן פֿון ה׳, אַזױ װי אַלץ װאָס זײַן פֿאָטער דָוִד האָט געטאָן. <verse eid="2KI 18:3" /><verse number="4" style="v" sid="2KI 18:4" />ער האָט אָפּגעטאָן די בָמות, און צעבראָכן די זײַלשטײנער, און אָפּגעהאַקט די אַשֵרָה. און ער האָט צעהאַקט די קופּערנע שלאַנג װאָס משה האָט געמאַכט; װאָרעם ביז יענע טעג פֿלעגן די קינדער פֿון יִשׂרָאֵל רײכערן צו איר, און מע האָט זי גערופֿן נחוּשתּן. <verse eid="2KI 18:4" /><verse number="5" style="v" sid="2KI 18:5" />ער האָט זיך פֿאַרזיכערט אױף ה׳ אלוקי יִשׂרָאֵל, און נאָך אים איז נישט געװען אַזאַ װי ער צװישן אַלע מלכים פֿון יהוּדה, אױך נישט צװישן די װאָס זײַנען געװען פֿאַר אים. <verse eid="2KI 18:5" /><verse number="6" style="v" sid="2KI 18:6" />װאָרעם ער האָט זיך באַהעפֿט אָן ה׳, ער האָט זיך נישט אָפּגעקערט פֿון הינטער אים, און ער האָט געהיט זײַנע געבאָט װאָס ה׳ האָט געבאָטן משהן. <verse eid="2KI 18:6" /><verse number="7" style="v" sid="2KI 18:7" />און ה׳ פֿלעגט זײַן מיט אים; אומעטום װי ער פֿלעגט אַרױסגײן, פֿלעגט ער באַגליקן. און ער האָט װידערשפּעניקט אָן דעם מלך פֿון אשור, און האָט אים נישט געדינט. <verse eid="2KI 18:7" /><verse number="8" style="v" sid="2KI 18:8" />ער האָט געשלאָגן די פּלִשתּים ביז עַזָה און אירע געמאַרקן, פֿון אַ װעכטערטורעם ביז אַ פֿעסטונגשטאָט.<verse eid="2KI 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 18:9" />און עס איז געװען אין פֿירטן יאָר פֿון מלך חִזקִיָהון – דאָס איז דאָס זיבעטע יאָר פֿון הוֹשֵעַ דעם זון פֿון אֵלָהן, דעם מלך פֿון יִשׂרָאֵל – איז אַרױפֿגעגאַנגען שַלמַנאֶסֶר דער מלך פֿון אשור אױף שוֹמרוֹן, און האָט געלעגערט אױף איר. <verse eid="2KI 18:9" /><verse number="10" style="v" sid="2KI 18:10" />און זײ האָבן זי באַצװוּנגען צום סוף פֿון דרײַ יאָר; אין זעקסטן יאָר פֿון חִזקִיָהן – דאָס איז דאָס נײַנטע יאָר פֿון הוֹשֵעַ דעם מלך פֿון יִשׂרָאֵל – איז שוֹמרוֹן באַצװוּנגען געװאָרן. <verse eid="2KI 18:10" /><verse number="11" style="v" sid="2KI 18:11" />און דער מלך פֿון אשור האָט פֿאַרטריבן יִשׂרָאֵל קײן אשור, און האָט זײ אַװעקגעפֿירט אין חַלַח, און אין גוֹזָן, בײַם טײַך חָבֿוֹר, און אין די שטעט פֿון מָדַי. <verse eid="2KI 18:11" /><verse number="12" style="v" sid="2KI 18:12" />פֿאַר װאָס זײ האָבן נישט צוגעהערט צו דעם קֹול פֿון ה׳ זײער ג-ט, און האָבן איבערגעטרעטן זײַן ברית, אַלץ װאָס משה דער קנעכט פֿון ה׳ האָט זײ באַפֿױלן, און זײ האָבן נישט צוגעהערט און נישט געטאָן.<verse eid="2KI 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 18:13" />און אין פֿערצנטן יאָר פֿון מלך חִזקִיָהן, איז אַרױפֿגעגאַנגען סַנחֵריבֿ דער מלך פֿון אשור אױף אַלע באַפֿעסטיקטע שטעט פֿון יהוּדה, און האָט זײ אײַנגענומען.<verse eid="2KI 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 18:14" />האָט חִזקִיָה דער מלך פֿון יהוּדה געשיקט צו דעם מלך פֿון אשור קײן לָכיש, אַזױ צו זאָגן: איך האָב געזינדיקט; קער זיך אָפּ פֿון מיר; װאָס דו װעסט אױף מיר אַרױפֿלײגן, װעל איך טראָגן. האָט דער מלך פֿון אשור אַרױפֿגעלײגט אױף חִזקִיָה דעם מלך פֿון יהוּדה דרײַ הונדערט צענטנער זילבער און דרײַסיק צענטנער גאָלד.<verse eid="2KI 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 18:15" />און חִזקִיָה האָט אַװעקגעגעבן דאָס גאַנצע זילבער װאָס האָט זיך געפֿונען אין הױז פֿון ה׳ און אין די שאַצקאַמערן פֿון מלכס הױז. <verse eid="2KI 18:15" /><verse number="16" style="v" sid="2KI 18:16" />אין יענער צײַט האָט חִזקִיָה אַרומגעהאַקט די טירן פֿון דעם הֵיכל פֿון ה׳, און די בײַשטידלעך װאָס חִזקִיָה דער מלך פֿון יהוּדה האָט געהאַט איבערגעצױגן, און ער האָט עס געגעבן דעם מלך פֿון אשור.<verse eid="2KI 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 18:17" />און דער מלך פֿון אשור האָט געשיקט תַּרתָּנען, און רבֿ-סָריסן, און רַבֿשָקֵהן, פֿון לָכיש צום מלך חִזקִיָהון מיט אַ גרױסן חיל קײן ירושָלַיִם. און זײ זײַנען אַרױפֿגעגאַנגען, אַזױ זײַנען זײ געקומען און האָבן זיך געשטעלט בײַ דעם גראָבן פֿון דעם אױבערשטן טײַך װאָס אױפֿן װעג פֿון װעשערפֿעלד. <verse eid="2KI 18:17" /><verse number="18" style="v" sid="2KI 18:18" />און זײ האָבן גערופֿן צום מלך; איז אַרױסגעגאַנגען צו זײ אֶליָקים דער זון פֿון חִלקִיָהון, װאָס איבערן פּאַלאַץ, און שֶבֿנאָ דער שרײַבער, און יוֹאָח דער זון פֿון אָסָפֿן, דער דערמאָנער.<verse eid="2KI 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 18:19" />און רַבֿשָקֵה האָט צו זײ געזאָגט: זאָגט אַקאָרשט צו חִזקִיָהון אַזױ האָט געזאָגט דער גרױסער מלך, דער מלך פֿון אשור: װאָס איז די דאָזיקע פֿאַרזיכערונג װאָס דו פֿאַרזיכערסט זיך? <verse eid="2KI 18:19" /><verse number="20" style="v" sid="2KI 18:20" />מײנסטו הױל ליפּגערײד איז אַן עצה און גבֿורה פֿאַר מלחמה? אַצונד, אױף װעמען פֿאַרזיכערסטו זיך, װאָס דו האָסט װידערשפּעניקט אָן מיר? <verse eid="2KI 18:20" /><verse number="21" style="v" sid="2KI 18:21" />אַצונד זע, דו פֿאַרזיכערסט זיך אױף דעם שטעקן פֿון דעם דאָזיקן צעבראָכענעם ראָר – אױף מִצרַיִם – װאָס אַז אַ מענטש לענט זיך אױף אים אָן, גײט ער אים אַרײַן אין דער האַנט, און לעכערט זי דורך; אַזױ איז פַּרעה דער מלך פֿון מִצרַיִם פֿאַר אַלע װאָס פֿאַרזיכערן זיך אױף אים. <verse eid="2KI 18:21" /><verse number="22" style="v" sid="2KI 18:22" />און אַז איר װעט מיר זאָגן: מיר פֿאַרזיכערן זיך אױף ה׳ אלוקינו – איז דאָס נישט דער װאָס חִזקִיָהו האָט אָפּגעטאָן זײַנע בָמות און זײַנע מזבחות, און האָט געזאָגט צו יהוּדה און צו ירושָלַיִם: פֿאַר דעם דאָזיקן מזבח זאָלט איר זיך בוקן אין ירושָלַיִם?<verse eid="2KI 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 18:23" />און אַצונד, פֿאַרװעט זיך אַקאָרשט מיט מײַן האַר דעם מלך פֿון אשור, און איך װעל דיר געבן צװײ טױזנט פֿערד, אױב דו קענסט דיר אַרױפֿזעצן רײַטער אױף זײ. <verse eid="2KI 18:23" /><verse number="24" style="v" sid="2KI 18:24" />הײַנט װי קענסטו אָפּשטױסן דעם פּנים פֿון אַ הױפּטמאַן, אײנעם פֿון די קלענסטע קנעכט פֿון מײַן האַר? פֿון דעסט װעגן פֿאַרזיכערסטו זיך אױף מִצרַיִם װעגן רײַטװעגן און רײַטער. <verse eid="2KI 18:24" /><verse number="25" style="v" sid="2KI 18:25" />אַצונד, בין איך דען אָן ה׳ אַרױפֿגעקומען אױף דעם דאָזיקן אָרט, אים צו פֿאַרװיסטן? ה׳ האָט צו מיר געזאָגט: גײ אַרױף אױף דעם דאָזיקן לאַנד, און פֿאַרװיסט עס.<verse eid="2KI 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 18:26" />האָט אֶליָקים דער זון פֿון חִלקִיָהון, און שֶבֿנאָ, און יוֹאָח, געזאָגט צו רַבֿשָקֵהן: רעד, איך בעט דיך, צו דײַנע קנעכט אַראַמיש, װאָרעם מיר פֿאַרשטײן עס, און רעד נישט צו אונדז יהוּדיש אין די אױערן פֿון דעם פֿאָלק װאָס אױף דער מױער.<verse eid="2KI 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 18:27" />האָט רַבֿשָקֵה צו זײ געזאָגט: האָט דען צו דײַן האַר און צו דיר מיך געשיקט מײַן האַר צו רעדן די דאָזיקע װערטער, און נישט צו די מענטשן װאָס זיצן אױף דער מױער, צו עסן זײער קױט, און צו טרינקען זײער לײַב װאַסער, בײַ אײַך?<verse eid="2KI 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 18:28" />און רַבֿשָקֵה האָט זיך געשטעלט, און האָט אױסגערופֿן אױף אַ הױכן קֹול אױף יהוּדיש, און האָט גערעדט און געזאָגט: הערט דאָס װאָרט פֿון דעם גרױסן מלך, דעם מלך פֿון אשור. <verse eid="2KI 18:28" /><verse number="29" style="v" sid="2KI 18:29" />אַזױ האָט געזאָגט דער מלך: זאָל אײַך חִזקִיָהו נישט נאַרן, װאָרעם ער קען אײַך נישט מציל זײַן פֿון זײַן האַנט. <verse eid="2KI 18:29" /><verse number="30" style="v" sid="2KI 18:30" />און זאָל אײַך חִזקִיָהו נישט פֿאַרזיכערן אױף ה׳, אַזױ צו זאָגן: מציל זײַן װעט אונדז מציל זײַן ה׳, און די דאָזיקע שטאָט װעט נישט איבערגעבן װערן אין דער האַנט פֿון דעם מלך פֿון אשור. <verse eid="2KI 18:30" /><verse number="31" style="v" sid="2KI 18:31" />איר זאָלט נישט צוהערן צו חִזקִיָהון, װאָרעם אַזױ האָט געזאָגט דער מלך פֿון אשור: מאַכט מיט מיר שלום, און קומט אַרױס צו מיר, און עסט איטלעכער פֿון זײַן װײַנשטאָק און איטלעכער פֿון זײַן פֿײַגנבױם, און טרינקט איטלעכער דאָס װאַסער פֿון זײַן ברונעם. <verse eid="2KI 18:31" /><verse number="32" style="v" sid="2KI 18:32" />ביז איך קום, און װעל אײַך נעמען אין אַ לאַנד אַזױ װי אײַער לאַנד, אַ לאַנד פֿון תּבֿואה און װײַן, אַ לאַנד פֿון ברױט און װײַנגערטנער, אַ לאַנד פֿון אײלבערטן און האָניק, כּדי איר זאָלט לעבן און נישט שטאַרבן; און איר זאָלט נישט צוהערן צו חִזקִיָהון, אַז ער װעט אײַך אײַנרעדן, אַזױ צו זאָגן: ה׳ װעט אונדז מציל זײַן. <verse eid="2KI 18:32" /><verse number="33" style="v" sid="2KI 18:33" />האָבן מציל דען מציל געװען די ג‑טער פֿון די פֿעלקער איטלעכער זײַן לאַנד פֿון דער האַנט פֿון דעם מלך פֿון אשור? <verse eid="2KI 18:33" /><verse number="34" style="v" sid="2KI 18:34" />װוּ זײַנען די ג‑טער פֿון חַמָת, און אַרפַּד? װוּ זײַנען די ג‑טער פֿון ספֿרוַיִם, הֵנַע, און עִוָה? האָבן זײ דען מציל געװען שוֹמרוֹן פֿון מײַן האַנט? <verse eid="2KI 18:34" /><verse number="35" style="v" sid="2KI 18:35" />װער זײַנען צװישן אַלע ג‑טער פֿון די לענדער װאָס האָבן מציל געװען זײער לאַנד פֿון מײַן האַנט, אַז ה׳ זאָל מציל זײַן ירושָלַיִם פֿון מײַן האַנט?<verse eid="2KI 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 18:36" />האָט דאָס פֿאָלק געשװיגן, און זײ האָבן אים אַ װאָרט נישט געענטפֿערט, װאָרעם דער באַפֿעל פֿון מלך איז געװען, אַזױ צו זאָגן: איר זאָלט אים נישט ענטפֿערן.<verse eid="2KI 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2KI 18:37" />איז געקומען אֶליָקים דער זון פֿון חִלקִיָהן, װאָס איבערן פּאַלאַץ, און שֶבֿנאָ דער שרײַבער, און יוֹאָח דער זון פֿון אָסָפֿן, דער דערמאָנער, צו חִזקִיָהון, מיט צעריסענע קלײדער, און זײ האָבן אים דערצײלט די װערטער פֿון רַבֿשָקֵהן.<verse eid="2KI 18:37" /></para>
  <chapter eid="2KI 18" />
  <chapter number="19" style="c" pubnumber="יט" sid="2KI 19" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 19:1" />און עס איז געװען, װי דער מלך חִזקִיָהו האָט עס געהערט, אַזױ האָט ער צעריסן זײַנע קלײדער, און זיך צוגעדעקט מיט זאַק, און ער איז געקומען אין הױז פֿון ה׳. <verse eid="2KI 19:1" /><verse number="2" style="v" sid="2KI 19:2" />און ער האָט געשיקט אֶליָקימען װאָס איבערן פּאַלאַץ, און שֶבֿנאָ דעם שרײַבער, און די עלטסטע פֿון די כּהנים, צוגעדעקט מיט זאַקקלײדער, צו ישַעיָהו הנבֿיא דעם זון פֿון אָמוצן. <verse eid="2KI 19:2" /><verse number="3" style="v" sid="2KI 19:3" />און זײ האָבן צו אים געזאָגט: אַזױ האָט געזאָגט חִזקִיָהו: אַ טאָג פֿון נױט און שטראָף און שמאַך איז הײַנטיקער טאָג, װאָרעם די קינדער זײַנען געקומען צום מוטערמױל, און נישטאָ קײן כּוֹח צו געבערן. <verse eid="2KI 19:3" /><verse number="4" style="v" sid="2KI 19:4" />אפֿשר װעט ה׳ דײַן ג-ט הערן אַלע װערטער פֿון רַבֿשָקֵהן, װאָס זײַן האַר דער מלך פֿון אשור האָט אים געשיקט צו לעסטערן דעם לעבעדיקן אלֹקים, און ער װעט שטראָפֿן פֿאַר די רײד װאָס ה׳ דײַן ג-ט האָט געהערט; דערום זאָלסטו אױפֿהײבן אַ תּפֿילה פֿאַר דעם איבערבלײַב װאָס געפֿינט זיך דאָ.<verse eid="2KI 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 19:5" />און װי די קנעכט פֿון מלך חִזקִיָהון זײַנען געקומען צו ישַעיָהון, <verse eid="2KI 19:5" /><verse number="6" style="v" sid="2KI 19:6" />האָט ישַעיָהו צו זײ געזאָגט: אַזױ זאָלט איר זאָגן צו אײַער האַר: אַזױ האָט ה׳ געזאָגט: זאָלסט נישט מורא האָבן פֿאַר די װערטער װאָס דו האָסט געהערט, מיט װאָס די יונגען פֿון דעם מלך פֿון אשור האָבן מיך געשענדט. <verse eid="2KI 19:6" /><verse number="7" style="v" sid="2KI 19:7" />זע, איך גיב אַרײַן אין אים אַ גײַסט, און ער װעט הערן אַ הערונג, און װעט זיך אומקערן צו זײַן לאַנד; און איך װעל אים מאַכן פֿאַלן דורכן שװערד אין זײַן לאַנד.<verse eid="2KI 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 19:8" />און רַבֿשָקֵה האָט זיך אומגעקערט, און האָט געפֿונען דעם מלך פֿון אשור מלחמה האַלטנדיק אױף לִבֿנָה; װאָרעם ער האָט געהאַט געהערט אַז ער האָט אַװעקגעצױגן פֿון לָכיש.<verse eid="2KI 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 19:9" />און האָט געהערט אױף תִּרהָקָה דעם מלך פֿון כּוּש, אַזױ צו זאָגן: ער איז אַרױסגעגאַנגען מלחמה צו האַלטן מיט דיר. און ער האָט װידער געשיקט שלוחים צו חִזקִיָהון, אַזױ צו זאָגן: <verse eid="2KI 19:9" /><verse number="10" style="v" sid="2KI 19:10" />אַזױ זאָלט איר זאָגן צו חִזקִיָהון דעם מלך פֿון יהוּדה, אַזױ צו זאָגן: זאָל דיך נישט נאַרן דײַן ג-ט, װאָס דו פֿאַרזיכערסט זיך אױף אים, אַזױ צו זאָגן: ירושָלַיִם װעט נישט איבערגעגעבן װערן אין דער האַנט פֿון דעם מלך פֿון אשור. <verse eid="2KI 19:10" /><verse number="11" style="v" sid="2KI 19:11" />אָט האָסטו געהערט װאָס די מלכים פֿון אשור האָבן געטאָן צו אַלע לענדער, זײ צו פֿאַרװיסטן, און דו װילסט ניצול װערן? <verse eid="2KI 19:11" /><verse number="12" style="v" sid="2KI 19:12" />האָבן די ג‑טער פֿון די פֿעלקער מציל געװען די װאָס מײַנע עלטערן האָבן צעשטערט, גוֹזָן, און חָרָן, און רֶצֶף, אױף די קינדער פֿון עֵדֶן װאָס אין תּלַשָׂר? <verse eid="2KI 19:12" /><verse number="13" style="v" sid="2KI 19:13" />װוּ איז דער מלך פֿון חַמָת, און דער מלך פֿון אַרפַּד, און דער מלך פֿון דער שטאָט ספֿרוַיִם, פֿון הֵנַע, און עִוָה?<verse eid="2KI 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 19:14" />האָט חִזקִיָהו צוגענומען דעם בריװ פֿון דער האַנט פֿון די שלוחים, און האָט אים איבערגעלײענט; און ער איז אַרױפֿגעגאַנגען אין הױז פֿון ה׳; און חִזקִיָהו האָט אים אױסגעשפּרײט פֿאַר ג-ט.<verse eid="2KI 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 19:15" />און חִזקִיָהו האָט מתפּלל געװען צו ג-ט, און האָט געזאָגט: ה׳ דו אלוקי יִשׂרָאֵל װאָס זיצט איבער די כּרובֿים, דו אַלײן ביסט דער ג-ט איבער אַלע קיניגרײַכן פֿון דער ערד; דו האָסט געמאַכט די הימלען און די ערד. <verse eid="2KI 19:15" /><verse number="16" style="v" sid="2KI 19:16" />נײַג, ה׳, דײַן אױער, און הער; עפֿן, ה׳, דײַנע אױגן און זע; און הער די װערטער פֿון סַנחֵריבֿן װאָס האָט אים געשיקט צו לעסטערן דעם לעבעדיקן אלֹקים. <verse eid="2KI 19:16" /><verse number="17" style="v" sid="2KI 19:17" />אמת, ה׳, די מלכים פֿון אשור האָבן חרובֿ געמאַכט די פֿעלקער און זײער לאַנד, <verse eid="2KI 19:17" /><verse number="18" style="v" sid="2KI 19:18" />און זײ האָבן איבערגעגעבן זײערע ג‑טער צום פֿײַער; װאָרעם זײ זײַנען קײן ג‑טער נישט געװען; נאָר בלױז דאָס װערק פֿון אַ מענטשנס האַנט, האָלץ און שטײן; דערום האָבן זײ זײ אונטערגעבראַכט. <verse eid="2KI 19:18" /><verse number="19" style="v" sid="2KI 19:19" />און אַצונד, ה׳ אלוקינו, העלף אונדז, איך בעט דיך, פֿון זײַן האַנט, און זאָלן אַלע קיניגרײַכן פֿון דער ערד װיסן, אַז דו ה׳ אַלײן ביסט אלֹקים.<verse eid="2KI 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 19:20" />האָט ישַעיָהו דער זון פֿון אָמוצן געשיקט צו חִזקִיָהון, אַזױ צו זאָגן: אַזױ האָט געזאָגט ה׳ אלוקי יִשׂרָאֵל: װאָס דו האָסט מתפּלל געװען צו מיר װעגן סַנחֵריבֿ דעם מלך פֿון אשור, האָב איך צוגעהערט. <verse eid="2KI 19:20" /><verse number="21" style="v" sid="2KI 19:21" />דאָס איז דאָס װאָרט װאָס ה׳ האָט װעגן אים גערעדט:</para>
  <para style="b" vid="2KI 19:21" />
  <para style="q" vid="2KI 19:21">עס פֿאַראַכט דיך, עס שפּאָט פֿון דיר</para>
  <para style="q" vid="2KI 19:21">די יונגפֿרױ טאָכטער צִיוֹן;</para>
  <para style="q" vid="2KI 19:21">עס שאָקלט דעם קאָפּ הינטער דיר</para>
  <para style="q" vid="2KI 19:21">די טאָכטער ירושָלַיִם.<verse eid="2KI 19:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="2KI 19:22" />װעמען האָסטו געלעסטערט און געשענדט?</para>
  <para style="q" vid="2KI 19:22">און אױף װעמען האָסטו דײַן קֹול אױפֿגעהױבן?</para>
  <para style="q" vid="2KI 19:22">יאָ, האָסט געהױבן דײַנע אױגן אין דער הײך</para>
  <para style="q" vid="2KI 19:22">אַקעגן דעם הײליקן פֿון יִשׂרָאֵל.<verse eid="2KI 19:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="2KI 19:23" />דורך דײַנע שלוחים האָסטו געלעסטערט אֲדֹנָי,</para>
  <para style="q" vid="2KI 19:23">און געזאָגט: מיט מײַנע פֿיל רײַטװעגן</para>
  <para style="q" vid="2KI 19:23">בין איך צו דער הײך פֿון די בערג אַרױף,</para>
  <para style="q" vid="2KI 19:23">צו די װינקלען פֿון לבֿנוֹן;</para>
  <para style="q" vid="2KI 19:23">און איך האַק אָפּ זײַנע הױכע צעדערן,</para>
  <para style="q" vid="2KI 19:23">זײַנע געקליבענע ציפּרעסבײמער;</para>
  <para style="q" vid="2KI 19:23">און איך קום צו זײַן עקסטן האַרבעריק,</para>
  <para style="q" vid="2KI 19:23">צום װאַלד פֿון זײַן פֿרוכטגאָרטן.<verse eid="2KI 19:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="2KI 19:24" />איך האָב געגראָבן און געטרונקען װאַסערן פֿרעמדע,</para>
  <para style="q" vid="2KI 19:24">און טריקן אױס מיט מײַנע פֿוסטריט</para>
  <para style="q" vid="2KI 19:24">אַלע טײַכן פֿון מִצרַיִם.<verse eid="2KI 19:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="2KI 19:25" />האָסטו דען נישט געהערט?</para>
  <para style="q" vid="2KI 19:25">פֿון לאַנג אָן האָב איך עס צוגעגרײט,</para>
  <para style="q" vid="2KI 19:25">פֿון אַלטע טעג האָב איך עס געפֿורעמט;</para>
  <para style="q" vid="2KI 19:25">אַצונד האָב איך עס געבראַכט עס זאָל געשען,</para>
  <para style="q" vid="2KI 19:25">כּדי צו פֿאַרװיסטן אױף חורבֿה-הױפֿנס</para>
  <para style="q" vid="2KI 19:25">באַפֿעסטיקטע שטעט.<verse eid="2KI 19:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="2KI 19:26" />דערום זײַנען זײערע באַװױנער קורצמאַכטיק,</para>
  <para style="q" vid="2KI 19:26">זײ זײַנען צעבראָכן און פֿאַרשעמט;</para>
  <para style="q" vid="2KI 19:26">זײ זײַנען געװאָרן גראָז פֿון דעם פֿעלד,</para>
  <para style="q" vid="2KI 19:26">און קרײַטעכץ גרינע,</para>
  <para style="q" vid="2KI 19:26">מאַך פֿון די דעכער,</para>
  <para style="q" vid="2KI 19:26">און תּבֿואה פֿאַרדאַרט אײדער אױפֿגעװאַקסן.<verse eid="2KI 19:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="2KI 19:27" />אָבער איך װײס דײַן זיצן,</para>
  <para style="q" vid="2KI 19:27">און דײַן גײן און דײַן קומען,</para>
  <para style="q" vid="2KI 19:27">און דײַן שטורעמען קעגן מיר.<verse eid="2KI 19:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="2KI 19:28" />װײַל דײַן שטורעמען קעגן מיר</para>
  <para style="q" vid="2KI 19:28">און דײַן ליאַרעם איז אַרױף אין מײַנע אױערן,</para>
  <para style="q" vid="2KI 19:28">דערום, װעל איך אַרײַנטאָן מײַן רינג אין דײַן נאָז,</para>
  <para style="q" vid="2KI 19:28">און מײַן צאַם אין דײַנע ליפּן,</para>
  <para style="q" vid="2KI 19:28">און איך װעל דיך אומקערן אױף דעם װעג</para>
  <para style="q" vid="2KI 19:28">װאָס דו ביסט געקומען אױף אים.<verse eid="2KI 19:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="2KI 19:29" />און דאָס װעט דיר זײַן דער צײכן: איר װעט עסן הײַיאָר נאָכװוּקס, און אױפֿן צװײטן יאָר װידערװוּקס; און אױפֿן דריטן יאָר, זיִיִט און שנײַדט, און פֿלאַנצט װײַנגערטנער, און עסט זײער פֿרוכט. <verse eid="2KI 19:29" /><verse number="30" style="v" sid="2KI 19:30" />און דער אַנטרונענער איבערבלײַב פֿון דעם הױז פֿון יהוּדה װעט װידער װאָרצלען אונטן, און טראָגן פֿרוכט אױבן. <verse eid="2KI 19:30" /><verse number="31" style="v" sid="2KI 19:31" />װאָרעם פֿון ירושָלַיִם װעט אַרױסקומען אַן איבערבלײַב, און אַן אַנטרינונג פֿון באַרג צִיוֹן; דאָס אָננעמען זיך פֿון ה׳ צבָֿאוֹת װעט דאָס טאָן.<verse eid="2KI 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 19:32" />פֿאַר װאָר, אַזױ האָט ה׳ געזאָגט אױפֿן מלך פֿון אשור: ער װעט נישט אַרײַנקומען אין דער דאָזיקער שטאָט, און נישט אַרײַנשיסן אַהין אַ פֿײַל, און נישט קומען פֿאַר איר מיט אַ שילד, און נישט אָנשיטן אַרום איר אַן ערדװאַל. <verse eid="2KI 19:32" /><verse number="33" style="v" sid="2KI 19:33" />אױף דעם װעג װאָס ער איז געקומען, אױף אים װעט ער זיך אומקערן, און אין דער דאָזיקער שטאָט װעט ער נישט אַרײַנקומען, זאָגט ה׳. <verse eid="2KI 19:33" /><verse number="34" style="v" sid="2KI 19:34" />און איך װעל באַשירעמען די דאָזיקע שטאָט, זי צו העלפֿן, פֿון מײַנעט װעגן און פֿון מײַן קנעכט דָוִדס װעגן.<verse eid="2KI 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 19:35" />און עס איז געװען אין יענער נאַכט, איז אַרױסגעגאַנגען אַ מלאך פֿון ה׳ און האָט געשלאָגן אין לאַגער פֿון אשור הונדערט און פֿינף און אַכציק טױזנט. און אַז מע האָט זיך געפֿעדערט אין דער פֿרי, ערשט זײ זײַנען אַלע טױטע פּגָרים.<verse eid="2KI 19:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 19:36" />און סַנחֵריבֿ דער מלך פֿון אשור האָט אַװעקגעצױגן, און איז געגאַנגען און האָט זיך אומגעקערט; און ער איז געבליבן אין נינוֵה.<verse eid="2KI 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2KI 19:37" />און עס איז געװען, װי ער בוקט זיך אין הױז פֿון זײַן ג-ט נִסרוך, אַזױ האָבן זײַנע זין אַדרַמֶלֶך און שַׂראֶצֶר אים דערשלאָגן מיטן שװערד; און זײ זײַנען אַנטרונען געװאָרן אין לאַנד אַרָרָט. און זײַן זון אֵסַר-חַדוֹן איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 19:37" /></para>
  <chapter eid="2KI 19" />
  <chapter number="20" style="c" pubnumber="כ" sid="2KI 20" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 20:1" />אין יענע טעג איז חִזקִיָהו קראַנק געװאָרן צום שטאַרבן; איז צו אים געקומען ישַעיָהו הנבֿיא דער זון פֿון אָמוצן, און האָט צו אים געזאָגט: אַזױ האָט ה׳ געזאָגט: מאַך דײַן צַװָאֶה װעגן דײַן הױזגעזינט, װאָרעם דו שטאַרבסט, און װעסט נישט גענעזן װערן.<verse eid="2KI 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 20:2" />האָט ער אומגעדרײט זײַן פּנים צו דער װאַנט, און האָט מתפּלל געװען צו ה׳, אַזױ צו זאָגן: <verse eid="2KI 20:2" /><verse number="3" style="v" sid="2KI 20:3" />איך בעט דיך, ה׳, געדענק װי איך בין געגאַנגען פֿאַר דיר מיט אמת, און מיט אַ גאַנצן האַרצן, און װאָס איז גוט אין דײַנע אױגן האָב איך געטאָן. און חִזקִיָהו האָט געװײנט אַ גרױס געװײן.<verse eid="2KI 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 20:4" />און עס איז געװען, װען ישַעיָהו איז נאָך נישט געװען אַרױסגעגאַנגען פֿון דעם מיטלסטן הױף, איז דאָס װאָרט פֿון ה׳ געװען צו אים, אַזױ צו זאָגן: <verse eid="2KI 20:4" /><verse number="5" style="v" sid="2KI 20:5" />קער זיך אום, און זאָלסט זאָגן צו חִזקִיָהו דעם פֿירשט פֿון מײַן פֿאָלק: אַזױ האָט געזאָגט ה׳ דער ג-ט פֿון דײַן פֿאָטער דָוִדן: איך האָב געהערט דײַן תּפֿילה, איך האָב געזען דײַן טרער; זע, איך הײל דיך; אױפֿן דריטן טאָג װעסטו אַרױפֿגײן אין הױז פֿון ה׳. <verse eid="2KI 20:5" /><verse number="6" style="v" sid="2KI 20:6" />און איך װעל צולײגן צו דײַנע טעג פֿופֿצן יאָר, און פֿון דער האַנט פֿון דעם מלך פֿון אשור װעל איך דיך און די דאָזיקע שטאָט מציל זײַן, און איך װעל באַשירעמען די דאָזיקע שטאָט פֿון מײַנעט װעגן און פֿון מײַן קנעכט דָוִדס װעגן.<verse eid="2KI 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 20:7" />און ישַעיָהו האָט געזאָגט: נעם געפּרעסטע פֿײַגן. און זײ האָבן גענומען און אַרױפֿגעטאָן אױפֿן אױסשלאָג, און ער איז גענעזן געװאָרן.<verse eid="2KI 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 20:8" />און חִזקִיָהו האָט געזאָגט צו ישַעיָהון: װאָס איז דער צײכן אַז ג-ט װעט מיך הײלן, און איך װעל אַרױפֿגײן אױפֿן דריטן טאָג אין הױז פֿון ה׳? <verse eid="2KI 20:8" /><verse number="9" style="v" sid="2KI 20:9" />האָט ישַעיָהו געזאָגט: דאָס װעט דיר זײַן דער צײכן פֿון ה׳, אַז ה׳ װעט טאָן די זאַך װאָס ער האָט גערעדט: זאָל דער שאָטן גײן צען שטאַפּלען װײַטער, אָדער זיך אומקערן צען שטאַפּלען? <verse eid="2KI 20:9" /><verse number="10" style="v" sid="2KI 20:10" />האָט יחִזקִיָהו געזאָגט: גרינג איז דעם שאָטן זיך אַראָפּצוגײן צען שטאַפּלען; נײן, נײַערט דער שאָטן זאָל זיך אומקערן אױף צוריק צען שטאַפּלען.<verse eid="2KI 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 20:11" />האָט ישַעיָהו הנבֿיא גערופֿן צו ה׳, און ער האָט אומגעקערט דעם שאָטן צען שטאַפּלען צוריק אױף די שטאַפּלען װאָס ער האָט געהאַט אַראָפּגענידערט אױף די שטאַפּלען פֿון אָחָזן.<verse eid="2KI 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 20:12" />אין יענער צײַט האָט ברֹאדַך-באַלְאַדָן דער זון פֿון באַלְאַדָנען, דער מלך פֿון בָבֿל, געשיקט אַ בריװ און אַ מתּנה צו חִזקִיָהון, װאָרעם ער האָט געהערט אַז חִזקִיָהו איז געװען קראַנק. <verse eid="2KI 20:12" /><verse number="13" style="v" sid="2KI 20:13" />און חִזקִיָהו האָט זײ צוגעהערט, און ער האָט זײ געװיזן זײַן גאַנץ שאַצהױז, דאָס זילבער און דאָס גאָלד, און די בשׂמים, און דאָס גוטע אײל, און דאָס גאַנצע הױז פֿון זײַנע װאַפֿן, און אַלץ װאָס האָט זיך געפֿונען אין זײַנע שאַצקאַמערן; נישט געװען אַ זאַך אין זײַן הױז, און אין זײַן גאַנצער געװעלטיקײט, װאָס חִזקִיָהו האָט זײ נישט געװיזן.<verse eid="2KI 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 20:14" />איז ישַעיָהו הנבֿיא געקומען צום מלך יחִזקִיָהו, און האָט צו אים געזאָגט: װאָס האָבן די דאָזיקע מענטשן געזאָגט? און פֿון װאַנען קומען זײ צו דיר? האָט חִזקִיָהו געזאָגט: פֿון אַ װײַטן לאַנד זײַנען זײ געקומען, פֿון בָבֿל. <verse eid="2KI 20:14" /><verse number="15" style="v" sid="2KI 20:15" />האָט ער געזאָגט: װאָס האָבן זײ געזען אין דײַן הױז? האָט חִזקִיָהו געזאָגט: אַלץ װאָס איז אין מײַן הױז האָבן זײ געזען: נישט געװען אַ זאַך אין מײַנע שאַצקאַמערן װאָס איך האָב זײ נישט געװיזן.<verse eid="2KI 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 20:16" />האָט ישַעיָהו געזאָגט צו חִזקִיָהון: הער דאָס װאָרט פֿון ה׳: <verse eid="2KI 20:16" /><verse number="17" style="v" sid="2KI 20:17" />זע, טעג קומען, און אַלץ װאָס אין דײַן הױז, און װאָס דײַנע עלטערן האָבן אָנגעקליבן ביז הײַנטיקן טאָג, װעט אַװעקגעטראָגן װערן קײן בָבֿל; קײן זאַך װעט נישט איבערבלײַבן, זאָגט ה׳. <verse eid="2KI 20:17" /><verse number="18" style="v" sid="2KI 20:18" />און פֿון דײַנע זין װאָס װעלן אַרױסגײן פֿון דיר, װאָס דו װעסט געבערן, װעט מען נעמען, און זײ װעלן זײַן הױפֿדינער אין פּאַלאַץ פֿון דעם מלך פֿון בָבֿל.<verse eid="2KI 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 20:19" />האָט חִזקִיָהו געזאָגט צו ישַעיָהון: גוט איז דאָס װאָרט פֿון ה׳ װאָס דו האָסט גערעדט. און ער האָט געזאָגט. פֿאַר װאָר, אױב שלום און זיכערקײט װעט זײַן אין מײַנע טעג!<verse eid="2KI 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 20:20" />און די איבעריקע זאַכן װעגן חִזקִיָהון, און זײַן גאַנצע גבֿוּרהשאַפֿט, און װי ער האָט געמאַכט דעם טײַך און דעם גראָבן, און אַרײַנגעבראַכט װאַסער אין שטאָט, דאָס איז שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יהוּדה.<verse eid="2KI 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 20:21" />און חִזקִיָהו האָט זיך געלײגט מיט זײַנע עלטערן, און זײַן זון מנַשֶה איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 20:21" /></para>
  <chapter eid="2KI 20" />
  <chapter number="21" style="c" pubnumber="כא" sid="2KI 21" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 21:1" />צװעלף יאָר איז מנַשֶה אַלט געװען, אַז ער איז געװאָרן מלך, און פֿינף און פֿופֿציק יאָר האָט ער געקיניגט אין ירושָלַיִם. און דער נאָמען פֿון זײַן מוטער איז געװען חֶפֿצי-בֿה.<verse eid="2KI 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 21:2" />און ער האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳, אַזױ װי די אומװערדיקײטן פֿון די פֿעלקער װאָס ג-ט האָט פֿאַרטריבן פֿון פֿאַר די קינדער פֿון יִשׂרָאֵל. <verse eid="2KI 21:2" /><verse number="3" style="v" sid="2KI 21:3" />און ער האָט אָפּגעבױט די בָמות װאָס זײַן פֿאָטער חִזקִיָהו האָט צעשטערט, און ער האָט אױפֿגעשטעלט מזבחות צו בַעַל, און האָט געמאַכט אַן אַשֵרָה, און װי אַחאָבֿ דער מלך פֿון יִשׂרָאֵל האָט געטאָן, און ער האָט זיך געבוקט צום גאַנצן חיל פֿון הימל, און זײ געדינט. <verse eid="2KI 21:3" /><verse number="4" style="v" sid="2KI 21:4" />און ער האָט געבױט מזבחות אין הױז פֿון ה׳, װאָס ג-ט האָט געזאָגט: אין ירושָלַיִם װעל איך טאָן מײַן נאָמען. <verse eid="2KI 21:4" /><verse number="5" style="v" sid="2KI 21:5" />און ער האָט געבױט מזבחות צום גאַנצן חיל פֿון הימל אין בײדע הױפֿן פֿון ה׳ס הױז. <verse eid="2KI 21:5" /><verse number="6" style="v" sid="2KI 21:6" />און ער האָט געמאַכט דורכגײן זײַן זון דורכן פֿײַער, און האָט געברױכט צײכנזעערײַ און געצױבערט, און אײַנגעשאַפֿט גײַסטערזעער און טױטנבאַשװערער; ער האָט געמערט צו טאָן שלעכטס אין די אױגן פֿון ה׳, צו דערצערענען. <verse eid="2KI 21:6" /><verse number="7" style="v" sid="2KI 21:7" />און ער האָט אַרײַנגעשטעלט דעם געץ פֿון דער אַשֵרָה װאָס ער האָט געמאַכט, אין דעם הױז װאָס ה׳ האָט געזאָגט צו דָוִדן און צו זײַן זון שלמהן: אין דעם דאָזיקן הױז און אין ירושָלַיִם װאָס איך האָב אױסדערװײלט פֿון אַלע שבֿטים פֿון יִשׂרָאֵל, װעל איך טאָן מײַן נאָמען אױף אײביק, <verse eid="2KI 21:7" /><verse number="8" style="v" sid="2KI 21:8" />און איך װעל מער נישט פֿאַרװאָגלען דעם פֿוס פֿון יִשׂרָאֵל פֿון דער ערד װאָס איך האָב געגעבן זײערע עלטערן, אױב זײ װעלן נאָר היטן צו טאָן אַזױ װי אַלץ װאָס איך האָב זײ באַפֿױלן, און לױט דער גאַנצער תּורה װאָס מײַן קנעכט משה האָט זײ באַפֿױלן. <verse eid="2KI 21:8" /><verse number="9" style="v" sid="2KI 21:9" />אָבער זײ האָבן נישט צוגעהערט; און מנַשֶה האָט זײ פֿאַרפֿירט צו טאָן מער שלעכטס װי די פֿעלקער װאָס ה׳ האָט פֿאַרטיליקט פֿון פֿאַר די קינדער פֿון יִשׂרָאֵל.<verse eid="2KI 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 21:10" />און ה׳ האָט גערעדט דורך זײַנע קנעכט די נבֿיאים, אַזױ צו זאָגן: <verse eid="2KI 21:10" /><verse number="11" style="v" sid="2KI 21:11" />װײַל מנַשֶה דער מלך פֿון יהוּדה האָט געטאָן די דאָזיקע אומװערדיקײטן, איז באַגאַנגען ערגערס װי אַלץ װאָס די אֶמוֹרים װאָס פֿאַר אים האָבן געטאָן, און האָט אױך געמאַכט זינדיקן יהוּדה מיט זײַנע אָפּגעטער, <verse eid="2KI 21:11" /><verse number="12" style="v" sid="2KI 21:12" />דערום האָט אַזױ געזאָגט ה׳ אלוקי יִשׂרָאֵל: זע, איך ברענג אַן אומגליק אױף ירושָלַיִם און יהוּדה, אַז איטלעכער װאָס הערט עס, װעלן קלינגען זײַנע בײדע אױערן. <verse eid="2KI 21:12" /><verse number="13" style="v" sid="2KI 21:13" />און איך װעל ציִען אױף ירושָלַיִם די מעסטשנור פֿון שוֹמרוֹן, און די װאָגשנור פֿון אַחאָבֿס הױז; און איך װעל אױסװישן ירושָלַיִם, אַזױ װי מע װישט אױס אַ שיסל, אױסגעװישט און אומגעקערט אױף איר פּנים. <verse eid="2KI 21:13" /><verse number="14" style="v" sid="2KI 21:14" />און איך װעל אַװעקװאַרפֿן דעם איבערבלײַב פֿון מײַן אַרב, און װעל זײ געבן אין דער האַנט פֿון זײערע פֿײַנט, און זײ װעלן זײַן צו רױב און צו אױסרױבונג פֿאַר אַלע זײערע פֿײַנט. <verse eid="2KI 21:14" /><verse number="15" style="v" sid="2KI 21:15" />װײַל זײ האָבן געטאָן װאָס איז שלעכט אין מײַנע אױגן, און האָבן מיך דערצערנט פֿון דעם טאָג װאָס זײערע עלטערן זײַנען אַרױסגעגאַנגען פֿון מִצרַיִם און ביז אױף הײַנטיקן טאָג.<verse eid="2KI 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 21:16" />און אױך אומשולדיק בלוט האָט מנַשֶה פֿאַרגאָסן זײער פֿיל, ביז ער האָט אָנגעפֿילט ירושָלַיִם פֿון עק צו עק; אַחוץ זײַן זינד װאָס ער האָט געמאַכט זינדיקן יהוּדה, צו טאָן װאָס איז שלעכט אין די אױגן פֿון ה׳.<verse eid="2KI 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 21:17" />און די איבעריקע זאַכן װעגן מנַשֶהן, און אַלץ װאָס ער האָט געטאָן, און זײַן זינד װאָס ער האָט געזינדיקט, דאָס איז שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יהוּדה.<verse eid="2KI 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 21:18" />און מנַשֶה האָט זיך געלײגט מיט זײַנע עלטערן, און ער איז באַגראָבן געװאָרן אין דעם גאָרטן פֿון זײַן הױז, אין דעם גאָרטן פֿון עוּזאָן. און זײַן זון אָמוֹן איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 21:19" />צװײ און צװאַנציק יאָר איז אָמוֹן אַלט געװען. אַז ער איז געװאָרן מלך, און צװײ יאָר האָט ער געקיניגט אין ירושָלַיִם. און דער נאָמען פֿון זײַן מוטער איז געװען משולֶמֶת די טאָכטער פֿון חָרוצן, פֿון יָטבֿה.<verse eid="2KI 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 21:20" />און ער האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳, אַזױ װי זײַן פֿאָטער מנַשֶה האָט געטאָן. <verse eid="2KI 21:20" /><verse number="21" style="v" sid="2KI 21:21" />און ער איז געגאַנגען אין אַל דעם װעג װאָס זײַן פֿאָטער איז געגאַנגען, און ער האָט געדינט די אָפּגעטער װאָס זײַן פֿאָטער האָט געדינט, און האָט זיך צו זײ געבוקט. <verse eid="2KI 21:21" /><verse number="22" style="v" sid="2KI 21:22" />און ער האָט פֿאַרלאָזן ה׳ דעם ג-ט פֿון זײַנע עלטערן, און איז נישט געגאַנגען אין דעם װעג פֿון ה׳.<verse eid="2KI 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 21:23" />און די קנעכט פֿון אָמוֹנען האָבן געמאַכט אַ בונט אױף אים, און האָבן געטײט דעם מלך אין זײַן הױז. <verse eid="2KI 21:23" /><verse number="24" style="v" sid="2KI 21:24" />און דאָס פֿאָלק פֿון לאַנד האָט דערשלאָגן אַלע װאָס האָבן געמאַכט דעם בונט אױף דעם מלך אָמוֹן. און דאָס פֿאָלק פֿון לאַנד האָט געמאַכט זײַן זון יֹאשִיָהון פֿאַר מלך אױף זײַן אָרט.<verse eid="2KI 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 21:25" />און די איבעריקע זאַכן פֿון אָמוֹנען װאָס ער האָט געטאָן, זײ זײַנען שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יהוּדה.<verse eid="2KI 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 21:26" />און מע האָט אים באַגראָבן אין זײַן קבֿר, אין דעם גאָרטן פֿון עוּזאָן. און זײַן זון יֹאשִיָהו איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 21:26" /></para>
  <chapter eid="2KI 21" />
  <chapter number="22" style="c" pubnumber="כב" sid="2KI 22" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 22:1" />אַכט יאָר איז יֹאשִיָהו אַלט געװען, אַז ער איז געװאָרן מלך, און אײן און דרײַסיק יאָר האָט ער געקיניגט אין ירושָלַיִם. און דער נאָמען פֿון זײַן מוטער איז געװען ידידָה די טאָכטער פֿון עַדָיָהן, פֿון בָצקַת.<verse eid="2KI 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 22:2" />און ער האָט געטאָן װאָס איז רעכטפֿאַרטיק אין די אױגן פֿון ה׳, און ער איז געגאַנגען אין אַל דעם װעג פֿון זײַן פֿאָטער דָוִדן, און האָט זיך נישט אָפּגעקערט רעכטס אָדער לינקס.<verse eid="2KI 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 22:3" />און עס איז געװען אין אַכצענטן יאָר פֿון מלך יֹאשִיָהו, האָט דער מלך געשיקט שָפָֿן דעם זון פֿון אַצַליָהו, דעם זון פֿון משולָמען, דעם שרײַבער, אין הױז פֿון ה׳, אַזױ צו זאָגן: <verse eid="2KI 22:3" /><verse number="4" style="v" sid="2KI 22:4" />גײ אַרױף צו חִלקִיָהו דעם כּהן-גָדול, און זאָל ער צונױפֿצײלן דאָס געלט װאָס איז געבראַכט געװאָרן אין הױז פֿון ה׳, װאָס די שװעלהיטערס האָבן געזאַמלט פֿון פֿאָלק. <verse eid="2KI 22:4" /><verse number="5" style="v" sid="2KI 22:5" />און זאָל מען עס געבן אױף דער האַנט פֿון די װערקמײַנסטערס װאָס זײַנען געשטעלט איבער דעם הױז פֿון ה׳; און זײ זאָלן עס געבן צו די בַעַל-מלאָכות, װאָס אין הױז פֿון ה׳, אױף צו פֿאַרריכטן די צעבראָכענע ערטער פֿון הױז; <verse eid="2KI 22:5" /><verse number="6" style="v" sid="2KI 22:6" />צו די האָלצמײַנסטערס, און צו די בױמײַנסטערס, און צו די מױערער, און אױף צו קױפֿן האָלץ און געהאַקטע שטײנער, צו פֿאַרריכטן דאָס הױז. <verse eid="2KI 22:6" /><verse number="7" style="v" sid="2KI 22:7" />און מע זאָל זיך נישט רעכענען מיט זײ װעגן דעם געלט װאָס װערט געגעבן אױף זײער האַנט, נײַערט אױף נאמנות זאָלן זײ אַרבעטן.<verse eid="2KI 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 22:8" />און חִלקִיָהו דער כּהן-גָדול האָט געזאָגט צו שָפָֿן דעם שרײַבער: דאָס בוך פֿון דער תּורה האָב איך געפֿונען אין הױז פֿון ה׳. און חִלקִיָהו האָט געגעבן דאָס בוך צו שָפָֿנען, און ער האָט עס איבערגעלײענט.<verse eid="2KI 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 22:9" />און שָפָֿן דער שרײַבער איז געקומען צום מלך, און האָט געבראַכט דעם מלך אַן ענטפֿער, און האָט געזאָגט: דײַנע קנעכט האָבן איבערגעצײלט דאָס געלט װאָס האָט זיך געפֿונען אין הױז, און זײ האָבן עס געגעבן אױף דער האַנט פֿון די װערקמײַנסטערס װאָס זײַנען געשטעלט איבער דעם הױז פֿון ה׳.<verse eid="2KI 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 22:10" />און שָפָֿן דער שרײַבער האָט דערצײלט דעם מלך, אַזױ צו זאָגן: חִלקִיָהו דער כּהן האָט מיר געגעבן אַ בוך. און שָפָֿן האָט עס געלײענט פֿאַרן מלך. <verse eid="2KI 22:10" /><verse number="11" style="v" sid="2KI 22:11" />און עס איז געװען, װי דער מלך האָט געהערט די װערטער פֿון דעם בוך פֿון דער תּורה, אַזױ האָט ער צעריסן זײַנע קלײדער. <verse eid="2KI 22:11" /><verse number="12" style="v" sid="2KI 22:12" />און דער מלך האָט באַפֿױלן חִלקִיָהו דעם כּהן, און אַחיקָם דעם זון פֿון שָפָֿנען, און עַכבוֹר דעם זון פֿון מיכָיָה, און שָפָֿן דעם שרײַבער, און עַשָׂיָה דעם מלכס דינער אַזױ צו זאָגן: <verse eid="2KI 22:12" /><verse number="13" style="v" sid="2KI 22:13" />גײט פֿרעגט בײַ ה׳ פֿאַר מיר, און פֿאַר דעם פֿאָלק, און פֿאַר גאַנץ יהוּדה, װעגן די װערטער פֿון דעם דאָזיקן געפֿונענעם בוך, װאָרעם גרױס איז דער גרימצאָרן פֿון ה׳ װאָס איז אָנגעצונדן אױף אונדז, פֿאַר װאָס אונדזערע עלטערן האָבן נישט צוגעהערט צו די װערטער פֿון דעם דאָזיקן בוך, צו טאָן אַזױ װי אַלץ װאָס איז אָנגעשריבן פֿאַר אונדז.<verse eid="2KI 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 22:14" />איז געגאַנגען חִלקִיָהו דער כּהן, און אַחיקָם, און עַכבוֹר, און שָפָֿן, און עַשָׂיָה, צו חוּלדָה דער נבֿיאה, דער װײַב פֿון שַלום דעם זון פֿון תִּקוָה דעם זון פֿון חַרחַסן, דעם קלײדער-היטער – און זי האָט געװױנט אין ירושָלַיִם, אין צװײטן שטאָטפֿערטל – און זײ האָבן גערעדט צו איר. <verse eid="2KI 22:14" /><verse number="15" style="v" sid="2KI 22:15" />האָט זי צו זײ געזאָגט: אַזױ האָט געזאָגט ה׳ אלוקי יִשׂרָאֵל: זאָגט צו דעם מאַן װאָס האָט אײַך געשיקט צו מיר: <verse eid="2KI 22:15" /><verse number="16" style="v" sid="2KI 22:16" />אַזױ האָט ה׳ געזאָגט: זע, איך ברענג אַן אומגליק אױף דעם דאָזיקן אָרט און אױף זײַנע באַװױנער – אַלע װערטער פֿון דעם בוך װאָס דער מלך פֿון יהוּדה האָט געלײענט; <verse eid="2KI 22:16" /><verse number="17" style="v" sid="2KI 22:17" />דערפֿאַר װאָס זײ האָבן מיך פֿאַרלאָזן, און האָבן גערײכערט צו פֿרעמדע ג‑טער, כּדי מיך צו דערצערענען מיט אַלע מעשׂים פֿון זײערע הענט, דערום װעט מײַן גרימצאָרן זיך אָנצינדן אױף דעם דאָזיקן אָרט, און װעט נישט פֿאַרלאָשן װערן. <verse eid="2KI 22:17" /><verse number="18" style="v" sid="2KI 22:18" />און צו דעם מלך פֿון יהוּדה װאָס שיקט אײַך פֿרעגן בײַ ג-ט, צו אים זאָלט איר אַזױ זאָגן: אַזױ האָט געזאָגט ה׳ אלוקי יִשׂרָאֵל: װעגן די װערטער װאָס דו האָסט געהערט, <verse eid="2KI 22:18" /><verse number="19" style="v" sid="2KI 22:19" />איז, װײַל דײַן האַרץ איז װײך געװאָרן, און ביסט געװאָרן אונטערטעניק פֿאַר ה׳ װען דו האָסט געהערט װאָס איך האָב גערעדט אױף דעם דאָזיקן אָרט און אױף זײַנע באַװױנער, אַז זײ װעלן װערן פֿאַר אַ שרעק און פֿאַר אַ קללה, און האָסט צעריסן דײַנע קלײדער, און האָסט געװײנט פֿאַר מיר, האָב איך אױך צוגעהערט, זאָגט ה׳. <verse eid="2KI 22:19" /><verse number="20" style="v" sid="2KI 22:20" />דערום זע, איך זאַמל דיך אײַן צו דײַנע עלטערן, און װעסט אײַנגעזאַמלט װערן אין דײַן קבֿר בשלום, און דײַנע אױגן װעלן נישט זען דאָס גאַנצע בײז װאָס איך ברענג אױף דעם דאָזיקן אָרט. און זײ האָבן געבראַכט צום מלך דעם ענטפֿער.<verse eid="2KI 22:20" /></para>
  <chapter eid="2KI 22" />
  <chapter number="23" style="c" pubnumber="כג" sid="2KI 23" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 23:1" />און דער מלך האָט געשיקט, און מע האָט אײַנגעזאַמלט צו אים אַלע עלטסטע פֿון יהוּדה און ירושָלַיִם. <verse eid="2KI 23:1" /><verse number="2" style="v" sid="2KI 23:2" />און דער מלך איז אַרױפֿגעגאַנגען אין הױז פֿון ה׳, און אַלע מענער פֿון יהוּדה און אַלע באַװױנער פֿון ירושָלַיִם מיט אים, און די כּהנים, און די נבֿיאים, און דאָס גאַנצע פֿאָלק פֿון קלײן ביז גרױס. און ער האָט געלײענט אין זײערע אױערן אַלע װערטער פֿון דעם בוך פֿון ברית װאָס איז געפֿונען געװאָרן אין הױז פֿון ה׳. <verse eid="2KI 23:2" /><verse number="3" style="v" sid="2KI 23:3" />און דער מלך האָט זיך געשטעלט אױף אַ בימה, און ער האָט געשלאָסן אַ ברית פֿאַר ה׳, צו גײן נאָך ה׳, און צו היטן זײַנע געבאָט און זײַנע צײגנים און זײַנע געזעצן מיטן גאַנצן האַרצן און מיט דער גאַנצער זעל, מקײם צו זײַן די װערטער פֿון דעם דאָזיקן ברית װאָס שטײען געשריבן אין דעם דאָזיקן בוך. און דאָס גאַנצע פֿאָלק איז צוגעשטאַנען אונטער דעם ברית.<verse eid="2KI 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 23:4" />און דער מלך האָט באַפֿױלן חִלקִיָהו דעם כּהן-גָדול, און די אונטער-כּהנים, און די שװעלהיטערס, אַרױסצוטראָגן פֿון דעם הֵיכל פֿון ה׳ אַלע כּלים װאָס זײַנען געמאַכט געװאָרן פֿאַר בַעַל, און פֿאַר דער אַשֵרָה, און פֿאַר דעם גאַנצן חיל פֿון הימל; און ער האָט זײ פֿאַרברענט דרױסן פֿון ירושָלַיִם אין די פֿעלדער פֿון קִדרוֹן, און האָט אַװעקגעטראָגן זײער אַש קײן בֵית-אֵל. <verse eid="2KI 23:4" /><verse number="5" style="v" sid="2KI 23:5" />און ער האָט אָפּגעשאַפֿט די פּריסטער װאָס די מלכים פֿון יהוּדה האָבן אױפֿגעזעצט, און װאָס האָבן גערײכערט אױף די בָמות, אין די שטעט פֿון יהוּדה און אין די אַרומיקע ערטער פֿון ירושָלַיִם; און די װאָס האָבן גערײכערט צו בַעַל, צו דער זון, און צו דער לבֿנה, און צו די מזלות, און צום גאַנצן חיל פֿון הימל. <verse eid="2KI 23:5" /><verse number="6" style="v" sid="2KI 23:6" />און ער האָט אַרױסגעטראָגן די אַשֵרָה פֿון דעם הױז פֿון ה׳ דרױסן פֿון ירושָלַיִם צום טײַך קִדרוֹן, און האָט זי פֿאַרברענט בײַם טײַך קִדרוֹן, און צעמאָלן אױף שטױב, און צעװאָרפֿן איר שטױב אױף די קבֿרים פֿון די קינדער פֿון פֿאָלק. <verse eid="2KI 23:6" /><verse number="7" style="v" sid="2KI 23:7" />און ער האָט צעבראָכן די הײַזער פֿון די שאַנדמענער װאָס אין הױז פֿון ה׳, װאָס די װײַבער פֿלעגן דאָרטן װעבן צודעקן פֿאַר דער אַשֵרָה. <verse eid="2KI 23:7" /><verse number="8" style="v" sid="2KI 23:8" />און ער האָט צונױפֿגעבראַכט אַלע כּהנים פֿון די שטעט פֿון יהוּדה, און האָט פֿאַראומרײניקט די בָמות װאָס די כּהנים האָבן דאָרטן גערײכערט, פֿון גֶבַֿע ביז באֵר-שֶבַֿע; און ער האָט צעבראָכן די בָמות פֿון די טױערן װאָס בײַם טױעראײַנגאַנג פֿון יְהוֹשועַ דעם שטאָטהאַר, װאָס אױף דער לינקער זײַט פֿון דעם װאָס קומט אַרײַן אין שטאָטטױער. <verse eid="2KI 23:8" /><verse number="9" style="v" sid="2KI 23:9" />אָבער די כּהנים פֿון די בָמות זײַנען נישט אַרױפֿגעגאַנגען צום מזבח פֿון ה׳ אין ירושָלַיִם; נײַערט זײ האָבן געגעסן דאָס אומגעזײַערטע ברױט צװישן זײערע ברידער.<verse eid="2KI 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 23:10" />און ער האָט פֿאַראומרײניקט תּוֹפֶת װאָס אין טאָל פֿון בן-הִנוֹם, אַז קײנער זאָל נישט מאַכן דורכגײן זײַן זון אָדער זײַן טאָכטער דורכן פֿײַער צו מוֹלֶך. <verse eid="2KI 23:10" /><verse number="11" style="v" sid="2KI 23:11" />און ער האָט אָפּגעשאַפֿט די פֿערד װאָס די מלכים פֿון יהוּדה האָבן געגעבן צו דער זון בײַם אײַנגאַנג פֿון דעם הױז פֿון ה׳, לעבן דער קאַמער פֿון נְתַן־מֶלֶך דעם הױפֿדינער, װאָס אין די פֿאָרהױפֿן; און די רײַטװעגן פֿון דער זון האָט ער פֿאַרברענט אין פֿײַער. <verse eid="2KI 23:11" /><verse number="12" style="v" sid="2KI 23:12" />און די מזבחות װאָס אױפֿן דאַך פֿון אָחָזעס אױבערשטוב, װאָס די מלכים פֿון יהוּדה האָבן געמאַכט, און די מזבחות װאָס מנַשֶה האָט געמאַכט אין בײדע הױפֿן פֿון ה׳ס הױז, האָט צעבראָכן דער מלך און צעהאַקט פֿון דאָרטן, און אַרײַנגעװאָרפֿן זײער שטױב אין טײַך קִדרוֹן. <verse eid="2KI 23:12" /><verse number="13" style="v" sid="2KI 23:13" />אױך די בָמות װאָס פֿאַר ירושָלַיִם, װאָס אױף דער רעכטער זײַט פֿון דעם באַרג פֿון משחית, װאָס שלמה דער מלך פֿון יִשׂרָאֵל האָט געבױט צו עַשְׁתֹּרֶת, דער אומװערדיקײט פֿון די צידוֹנים, און צו כּמוֹש, דער אומװערדיקײט פֿון מוֹאָבֿ, און צו מִלכּום, דער אומװערדיקײט פֿון די קינדער פֿון עַמוֹן, האָט דער מלך פֿאַראומרײניקט. <verse eid="2KI 23:13" /><verse number="14" style="v" sid="2KI 23:14" />און ער האָט צעבראָכן די זײַלשטײנער, און אָפּגעהאַקט די געצנבײמער, און אָנגעפֿילט זײער אָרט מיט בײנער פֿון מענטשן.<verse eid="2KI 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 23:15" />און אױך דעם מזבח װאָס אין בֵית-אֵל, די בָמָה װאָס יָרָבֿעָם דער זון פֿון נבָֿטן װאָס האָט געמאַכט זינדיקן יִשׂרָאֵל, האָט געמאַכט, אױך יענעם מזבח און די בָמָה האָט ער צעבראָכן; און ער האָט פֿאַרברענט די בָמָה, און צעמאָלן אױף שטױב; און ער האָט פֿאַרברענט די אַשֵרָה.<verse eid="2KI 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 23:16" />און װי יֹאשִיָהו האָט זיך אומגעדרײט, אַזױ האָט ער געזען די קבֿרים װאָס דאָרטן אױפֿן באַרג, און ער האָט געשיקט, און האָט אַרױסגענומען די בײנער פֿון די קבֿרים, און פֿאַרברענט אױפֿן מזבח, און האָט אים פֿאַראומרײניקט, אַזױ װי דאָס װאָרט פֿון ה׳ װאָס עס האָט אױסגערופֿן דער מאַן פֿון ג-ט װאָס האָט אױסגערופֿן די דאָזיקע זאַכן.<verse eid="2KI 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 23:17" />און ער האָט געזאָגט: װאָס איז יענער צײכן װאָס איך זע? האָבן די מענטשן פֿון שטאָט צו אים געזאָגט: דאָס איז דער קבֿר פֿון דעם מאַן פֿון ג-ט װאָס איז געקומען פֿון יהוּדה, און האָט אױסגערופֿן די דאָזיקע זאַכן װאָס דו האָסט געטאָן צו דעם דאָזיקן מזבח אין בֵית-אֵל. <verse eid="2KI 23:17" /><verse number="18" style="v" sid="2KI 23:18" />האָט ער צו זײ געזאָגט: לאָזט אים אין רו; קײנער זאָל נישט רירן זײַנע בײנער. האָבן זײ אױסגעלאָזט זײַנע בײנער מיט די בײנער פֿון דעם נבֿיא װאָס איז אַרױסגעקומען פֿון שוֹמרוֹן.<verse eid="2KI 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 23:19" />און אױך אַלע הײַזער פֿון די בָמות װאָס אין די שטעט פֿון שוֹמרוֹן, װאָס די מלכים פֿון יִשׂרָאֵל האָבן געמאַכט צו דערצערענען, האָט יֹאשִיָהו אָפּגעטאָן, און ער האָט געטאָן צו זײ אַזױ װי אַלע טוּונגען װאָס ער האָט געטאָן אין בֵית-אֵל. <verse eid="2KI 23:19" /><verse number="20" style="v" sid="2KI 23:20" />און ער האָט געשלאַכט אַלע כּהנים פֿון די בָמות װאָס זײַנען דאָרטן געװען, אױף די מזבחות, און האָט פֿאַרברענט בײנער פֿון מענטשן אױף זײ. און ער האָט זיך אומגעקערט קײן ירושָלַיִם.<verse eid="2KI 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 23:21" />און דער מלך האָט באַפֿױלן דעם גאַנצן פֿאָלק, אַזױ צו זאָגן: מאַכט אַ קָרבָּן-פֶּסַח צו ה׳ אלוקיכם, אַזױ װי עס שטײט געשריבן אין דעם דאָזיקן בוך פֿון ברית. <verse eid="2KI 23:21" /><verse number="22" style="v" sid="2KI 23:22" />װאָרעם אַזאַ װי דער דאָזיקער קָרבָּן-פֶּסַח איז נישט געמאַכט געװאָרן פֿון די טעג פֿון די שוֹפֿטים װאָס האָבן געמשפּט יִשׂרָאֵל, און אין אַלע טעג פֿון די מלכים פֿון יִשׂרָאֵל, און די מלכים פֿון יהוּדה. <verse eid="2KI 23:22" /><verse number="23" style="v" sid="2KI 23:23" />נאָר אין אַכצענטן יאָר פֿון מלך יֹאשִיָהון איז געמאַכט געװאָרן דער דאָזיקער קָרבָּן-פֶּסַח צו ה׳ אין ירושָלַיִם.<verse eid="2KI 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 23:24" />און אױך די גײַסטערזעער און די טױטנבאַשװערער, און די תּרָפֿים, און די אָפּגעטער, און אַלע אומװערדיקײטן, װאָס זײַנען געזען געװאָרן אין לאַנד יהוּדה און אין ירושָלַיִם, האָט יֹאשִיָהו אױסגעראַמט, כּדי מקײם צו זײַן די װערטער פֿון דער תּורה װאָס שטײען געשריבן אין דעם בוך װאָס חִלקִיָהו דער כּהן האָט געפֿונען אין הױז פֿון ה׳.<verse eid="2KI 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 23:25" />און אַזאַ װי ער איז נישט געװען קײן מלך פֿאַר אים, װאָס זאָל זיך אומקערן צו ה׳ מיט זײַן גאַנצן האַרצן און מיט זײַן גאַנצער זעל און מיט זײַן גאַנצן כּוֹח, לױט דער גאַנצער תּורה פֿון משהן; און נאָך אים איז נישט אױפֿגעשטאַנען אַזאַ װי ער.<verse eid="2KI 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 23:26" />אָבער ה׳ האָט זיך נישט אָפּגעקערט פֿון זײַן גרױסן גרימצאָרן װען זײַן צאָרן האָט געגרימט אױף יהוּדה, פֿאַר אַלע דערצערענונגען װאָס מנַשֶה האָט אים דערצערנט. <verse eid="2KI 23:26" /><verse number="27" style="v" sid="2KI 23:27" />און ה׳ האָט געזאָגט: אױך יהוּדה װעל איך אָפּטאָן פֿון מײַן פּנים, אַזױ װי איך האָב אָפּגעטאָן יִשׂרָאֵל; און איך װעל פֿאַראַכטן די דאָזיקע שטאָט װאָס איך האָב אױסדערװײלט, ירושָלַיִם, און דאָס הױז װאָס איך האָב געזאָגט: מײַן נאָמען זאָל דאָרטן זײַן.<verse eid="2KI 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 23:28" />און די איבעריקע זאַכן װעגן יֹאשִיָהון, און אַלץ װאָס ער האָט געטאָן, דאָס איז שױן באַשריבן אין בוך פֿון די צײַטגעשעענישען פֿון די מלכים פֿון יהוּדה.<verse eid="2KI 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 23:29" />אין זײַנע טעג איז אַרױפֿגעגאַנגען פַּרעה-נכו דער מלך פֿון מִצרַיִם אױף דעם מלך פֿון אשור, בײַם טײַך פּרָת, און דער מלך יֹאשִיָהו איז אים געגאַנגען אַקעגן; און ער האָט אים געטײט אין מגִדוֹ, װי ער האָט אים דערזען. <verse eid="2KI 23:29" /><verse number="30" style="v" sid="2KI 23:30" />האָבן זײַנע קנעכט אים אַװעקגעפֿירט אַ טױטן פֿון מגִדוֹ, און זײ האָבן אים געבראַכט קײן ירושָלַיִם, און האָבן אים באַגראָבן אין זײַן קבֿר. און דאָס פֿאָלק פֿון לאַנד האָט גענומען יהוֹאָחָז דעם זון פֿון יֹאשִיָהון, און זײ האָבן אים געזאַלבט, און אים געמאַכט פֿאַר מלך אױף זײַן פֿאָטערס אָרט.<verse eid="2KI 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 23:31" />דרײַ און צװאַנציק יאָר איז יהוֹאָחָז אַלט געװען, אַז ער איז געװאָרן מלך, און דרײַ חדשים האָט ער געקיניגט אין ירושָלַיִם. און דער נאָמען פֿון זײַן מוטער איז געװען חַמוטַל, די טאָכטער פֿון יִרמיָהון, פֿון לִבֿנָה.<verse eid="2KI 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 23:32" />און ער האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳, אַזױ װי אַלץ װאָס זײַנע עלטערן האָבן געטאָן.<verse eid="2KI 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2KI 23:33" />און פַּרעה-נכו האָט אים אײַנגעשפּאַרט אין רִבֿלָה, אין לאַנד חַמָת, אַז ער זאָל נישט קיניגן אין ירושָלַיִם. און ער האָט אַרױפֿגעלײגט אַ שטראָף אױפֿן לאַנד, הונדערט צענטנער זילבער, און אַ צענטנער גאָלד.<verse eid="2KI 23:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 23:34" />און פַּרעה-נכו האָט געמאַכט אֶליָקים דעם זון פֿון יֹאשִיָהון פֿאַר מלך אױף דעם אָרט פֿון זײַן פֿאָטער יֹאשִיָהון, און ער האָט אומגעביטן זײַן נאָמען אױף יהוֹיָקים. און יהוֹאָחָזן האָט ער אַװעקגענומען; און ער איז געקומען קײן מִצרַיִם, און איז דאָרטן געשטאָרבן.<verse eid="2KI 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 23:35" />און דאָס זילבער און דאָס גאָלד האָט יהוֹיָקים געגעבן צו פַּרעהן; אָבער ער האָט אָפּגעשאַצט דאָס לאַנד, כּדי צו געבן דאָס געלט לױט דעם באַפֿעל פֿון פַּרעהן; פֿון איטלעכן לױט זײַן אָפּשאַצונג האָט ער אױפֿגעמאָנט דאָס זילבער און דאָס גאָלד פֿון דעם פֿאָלק פֿון לאַנד, כּדי צו געבן צו פַּרעה-נכון.<verse eid="2KI 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 23:36" />פֿינף און צװאַנציק יאָר איז יהוֹיָקים אַלט געװען, אַז ער איז געװאָרן מלך, און עלף יאָר האָט ער געקיניגט אין ירושָלַיִם. און דער נאָמען פֿון זײַן מוטער איז געװען זבֿוּדָה די טאָכטער פֿון פּדָיָה, פֿון רוּמָה.<verse eid="2KI 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2KI 23:37" />און ער האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳, אַזױ װי אַלץ װאָס זײַנע עלטערן האָבן געטאָן.<verse eid="2KI 23:37" /></para>
  <chapter eid="2KI 23" />
  <chapter number="24" style="c" pubnumber="כד" sid="2KI 24" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 24:1" />אין זײַנע טעג איז אַרױפֿגעגאַנגען נבֿוכַדנֶצַר דער מלך פֿון בָבֿל, און יהוֹיָקים איז געװען אַ קנעכט צו אים דרײַ יאָר; דערנאָך האָט ער זיך אָפּגעקערט און האָט װידערשפּעניקט אָן אים.<verse eid="2KI 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 24:2" />און ג-ט האָט אָנגעשיקט אױף אים באַנדעס פֿון כַּשׂדים, און באַנדעס פֿון אַרָם, און באַנדעס פֿון מוֹאָבֿ, און באַנדעס פֿון די קינדער פֿון עַמוֹן; און ער האָט זײ אָנגעשיקט אױף יהוּדה, כּדי עס אונטערצוברענגען, אַזױ װי דאָס װאָרט פֿון ה׳ װאָס ער האָט גערעדט דורך זײַנע קנעכט די נבֿיאים. <verse eid="2KI 24:2" /><verse number="3" style="v" sid="2KI 24:3" />נאָר לױט דעם מױל פֿון ה׳ איז דאָס געװען אױף יהוּדה, כּדי זײ אָפּצוטאָן פֿון זײַן פּנים, פֿאַר די זינד פֿון מנַשֶהן, לױט אַלץ װאָס ער האָט געטאָן. <verse eid="2KI 24:3" /><verse number="4" style="v" sid="2KI 24:4" />און אױך פֿאַר דעם אומשולדיקן בלוט װאָס ער האָט פֿאַרגאָסן, ביז ער האָט אָנגעפֿילט ירושָלַיִם מיט אומשולדיק בלוט; און ה׳ האָט נישט געװאָלט פֿאַרגעבן.<verse eid="2KI 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 24:5" />און די איבעריקע זאַכן װעגן יהוֹיָקימען, און אַלץ װאָס ער האָט געטאָן, דאָס איז שױן באַשריבן אין בוך פֿון די צײַטגעשעענישן פֿון די מלכים פֿון יהוּדה.<verse eid="2KI 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 24:6" />און יהוֹיָקים האָט זיך געלײגט מיט זײַנע עלטערן, און זײַן זון יהוֹיָכין איז געװאָרן מלך אױף זײַן אָרט.<verse eid="2KI 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 24:7" />און דער מלך פֿון מִצרַיִם איז מער װידער נישט אַרױסגעגאַנגען פֿון זײַן לאַנד, װאָרעם דער מלך פֿון בָבֿל האָט צוגענומען, פֿון דעם באַך פֿון מִצרַיִם ביז דעם טײַך פּרָת, אַלץ װאָס געהערט צום מלך פֿון מִצרַיִם.<verse eid="2KI 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 24:8" />אַכצן יאָר איז יהוֹיָכין אַלט געװען, אַז ער איז געװאָרן מלך, און דרײַ חדשים האָט ער געקיניגט אין ירושָלַיִם און דער נאָמען פֿון זײַן מוטער איז געװען נחוּשתּאָ די טאָכטער פֿון אֶלנָתָנען, פֿון ירושָלַיִם.<verse eid="2KI 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 24:9" />און ער האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳, אַזױ װי אַלץ װאָס זײַן פֿאָטער האָט געטאָן.<verse eid="2KI 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 24:10" />אין יענער צײַט זײַנען די קנעכט פֿון נבֿוכַדנֶאצַר דעם מלך פֿון בָבֿל אַרױפֿגעגאַנגען אױף ירושָלַיִם, און די שטאָט איז געקומען אין באַלעגערונג. <verse eid="2KI 24:10" /><verse number="11" style="v" sid="2KI 24:11" />און נבֿוכַדנֶאצַר דער מלך פֿון בָבֿל איז געקומען אױף דער שטאָט, בעת זײַנע קנעכט האָבן געלעגערט אױף איר.<verse eid="2KI 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 24:12" />איז יהוֹיָכין דער מלך פֿון יהוּדה אַרױסגעגאַנגען צו דעם מלך פֿון בָבֿל, ער, און זײַן מוטער, און זײַנע קנעכט, און זײַנע האַרן, און זײַנע הױפֿדינער; און דער מלך פֿון בָבֿל האָט אים אַװעקגענומען אין אַכטן יאָר פֿון זײַן מלוכה.<verse eid="2KI 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 24:13" />און ער האָט אַרױסגעצױגן פֿון דאָרטן אַלע אוֹצרות פֿון ה׳ס הױז, און די אוֹצרות פֿון מלכס הױז; און ער האָט צעהאַקט אַלע גילדערנע כּלים װאָס שלמה דער מלך פֿון יִשׂרָאֵל האָט געמאַכט אין דעם הֵיכל פֿון ה׳ – אַזױ װי ה׳ האָט אָנגעזאָגט. <verse eid="2KI 24:13" /><verse number="14" style="v" sid="2KI 24:14" />און ער האָט פֿאַרטריבן גאַנץ ירושָלַיִם, און אַלע האַרן, און אַלע העלדישע גיבוֹרים, צען טױזנט געפֿאַנגענע, און אַלע מײַנסטערס און שלעסערס; קײנער איז נישט געבליבן אַחוץ די אָרימסטע פֿון דעם פֿאָלק פֿון לאַנד; <verse eid="2KI 24:14" /><verse number="15" style="v" sid="2KI 24:15" />און ער האָט פֿאַרטריבן יהוֹיָכינען קײן בָבֿל; אױך דעם מלכס מוטער, און דעם מלכס װײַבער, און זײַנע הױפֿדינער, און די פּנֵי פֿון לאַנד, האָט ער אַװעקגעפֿירט אין גלות פֿון ירושָלַיִם קײן בָבֿל. <verse eid="2KI 24:15" /><verse number="16" style="v" sid="2KI 24:16" />און אַלע חילס-לײַט, זיבן טױזנט, און די מײַנסטערס און די שלעסערס, טױזנט, אַלע, גיבוֹרים װאָס טױגן צו מלחמה, זײ האָט דער מלך פֿון בָבֿל געבראַכט אין גלות קײן בָבֿל.<verse eid="2KI 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 24:17" />און דער מלך פֿון בָבֿל האָט געמאַכט פֿאַר מלך אַנשטאָט אים זײַן פֿעטער מַתַּניָהן, און ער האָט אומגעביטן זײַן נאָמען אױף צִדקִיָהו.<verse eid="2KI 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 24:18" />אײן און צװאַנציק יאָר איז צִדקִיָהו אַלט געװען, אַז ער איז געװאָרן מלך, און עלף יאָר האָט ער געקיניגט אין ירושָלַיִם. און דער נאָמען פֿון זײַן מוטער איז געװען חַמוטַל די טאָכטער פֿון יִרמיָהון, פֿון לִבֿנָה.<verse eid="2KI 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 24:19" />און ער האָט געטאָן װאָס איז שלעכט אין די אױגן פֿון ה׳, אַזױ װי אַלץ װאָס יהוֹיָקים האָט געטאָן. <verse eid="2KI 24:19" /><verse number="20" style="v" sid="2KI 24:20" />פֿאַר װאָר, פֿון װעגן דעם צאָרן פֿון ה׳ איז דאָס געשען אױף ירושָלַיִם און יהוּדה, ביז ער האָט זײ אַװעקגעװאָרפֿן פֿון זײַן פּנים.</para>
  <para style="p" vid="2KI 24:20">און צִדקִיָהו האָט װידערשפּעניקט אָן דעם מלך פֿון בָבֿל.<verse eid="2KI 24:20" /></para>
  <chapter eid="2KI 24" />
  <chapter number="25" style="c" pubnumber="כה" sid="2KI 25" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 25:1" />און עס איז געװען אין נײַנטן יאָר פֿון זײַן מלוכה, אין צענטן חודש, אין צענטן טאָג פֿון חודש, איז געקומען נבֿוכַדנֶאצַר דער מלך פֿון בָבֿל, ער און זײַן גאַנצער חיל, אױף ירושָלַיִם, און ער האָט געלעגערט אױף איר, און זײ האָבן געבױט באַלעגערװערק רונד אַרום איר. <verse eid="2KI 25:1" /><verse number="2" style="v" sid="2KI 25:2" />און די שטאָט איז געװען אין באַלעגערונג ביזן עלפֿטן יאָר פֿון מלך צִדקִיָהו. <verse eid="2KI 25:2" /><verse number="3" style="v" sid="2KI 25:3" />אין נײַנטן טאָג פֿון חודש האָט זיך געשטאַרקט דער הונגער אין שטאָט, און עס איז נישט געװען קײן ברױט פֿאַר דעם פֿאָלק פֿון לאַנד. <verse eid="2KI 25:3" /><verse number="4" style="v" sid="2KI 25:4" />און די שטאָט איז אײַנגעבראָכן געװאָרן, און אַלע מלחמה-לײַט בײַ נאַכט דורך דעם טױער צװישן די צװײ מױערן װאָס בײַם מלכס גאָרטן – און די כַּשׂדים זײַנען געװען רונד אַרום דער שטאָט – און איז אַװעק מיטן װעג פֿון פּלױן. <verse eid="2KI 25:4" /><verse number="5" style="v" sid="2KI 25:5" />אָבער דער חיל פֿון די כַּשׂדים האָט נאָכגעיאָגט דעם מלך, און זײ האָבן אים אָנגעיאָגט אין די פּלױנען פֿון יריחוֹ; און זײַן גאַנצער חיל איז צעלױפֿן פֿון אים. <verse eid="2KI 25:5" /><verse number="6" style="v" sid="2KI 25:6" />און זײ האָבן געכאַפּט דעם מלך, און האָבן אים אַרױפֿגעבראַכט צום מלך פֿון בָבֿל קײן רִבֿלָה; און מע האָט אַרױסגעזאָגט אױף אים אַ משפּט.<verse eid="2KI 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 25:7" />און צִדקִיָהוס זין האָט מען געשאָכטן פֿאַר זײַנע אױגן; און צִדקִיָהוס אױגן האָט ער בלינד געמאַכט, און ער האָט אים געשמידט אין קופּערנע קײטן, און געבראַכט קײן בָבֿל.<verse eid="2KI 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 25:8" />און אין פֿינפֿטן חודש, אין זיבעטן טאָג פֿון חודש – דאָס איז דאָס נײַנצנטע יאָר פֿון מלך נבֿוכַדנֶאצַר דעם מלך פֿון בָבֿל – איז געקומען נבֿוזַרְאַדָן דער הױפּט פֿון דעם לײַב-חיל, דער קנעכט פֿון דעם מלך פֿון בָבֿל, קײן ירושָלַיִם. <verse eid="2KI 25:8" /><verse number="9" style="v" sid="2KI 25:9" />און ער האָט פֿאַרברענט דאָס הױז פֿון ה׳, און דאָס הױז פֿון מלך; אױך אַלע הײַזער פֿון ירושָלַיִם, װוּ נאָר אַ הױז פֿון אַ גרױסן מאַן, האָט ער פֿאַרברענט אין פֿײַער. <verse eid="2KI 25:9" /><verse number="10" style="v" sid="2KI 25:10" />און די מױערן פֿון ירושָלַיִם רונד אַרום האָט דער גאַנצער חיל פֿון די כַּשׂדים װאָס מיט דעם הױפּט פֿון דעם לײַב-חיל אײַנגעװאָרפֿן. <verse eid="2KI 25:10" /><verse number="11" style="v" sid="2KI 25:11" />און דעם רעשט פֿון פֿאָלק װאָס איז געבליבן אין שטאָט, און די אַריבערגעלאָפֿענע װאָס זײַנען אַריבערגעלאָפֿן צו דעם מלך פֿון בָבֿל, און דעם רעשט פֿון המון, האָט נבֿוזַרְאַדָן דער הױפּט פֿון דעם לײַב-חיל פֿאַרטריבן. <verse eid="2KI 25:11" /><verse number="12" style="v" sid="2KI 25:12" />און דער הױפּט פֿון דעם לײַב-חיל איבערגעלאָזן פֿאַר װײַנגערטנירער און פֿאַר אַקערלײַט איטלעכע פֿון די אָרעם מענטשן.<verse eid="2KI 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 25:13" />און די קופּערנע זײַלן װאָס אין הױז פֿון ה׳, און די געשטעלן, און דעם קופּערנעם ים װאָס אין הױז פֿון ה׳, האָבן די כַּשׂדים צעבראָכן, און אַװעקגעטראָגן דאָס קופּער דערפֿון קײן בָבֿל. <verse eid="2KI 25:13" /><verse number="14" style="v" sid="2KI 25:14" />אױך די טעפּ, און די שופֿלען, און די שנײַצמעסערס, און די שאָלן, און אַלע קופּערנע כּלים װאָס מע פֿלעגט דינען מיט זײ, האָבן זײ צוגענומען. <verse eid="2KI 25:14" /><verse number="15" style="v" sid="2KI 25:15" />אױך די פֿײַערפֿאַנען, און די שפּרענגבעקנס, װאָס גאָלד, גאָלד, און װאָס זילבער, זילבער, האָט דער הױפּט פֿון דעם לײַב-חיל צוגענומען. <verse eid="2KI 25:15" /><verse number="16" style="v" sid="2KI 25:16" />די צװײ זײַלן, דעם אײן ים, און די געשטעלן, װאָס שלמה האָט געמאַכט פֿאַר ה׳ס הױז – דאָס קופּער פֿון אַלע די דאָזיקע כּלים איז נישט געװען אָפּצוּװעגן. <verse eid="2KI 25:16" /><verse number="17" style="v" sid="2KI 25:17" />אַכצן אײלן איז געװען די הײך פֿון אײן זײַל און אַ קופּערנע קרױן איז געװען אױף אים; און די הײך פֿון דער קרױן איז געװען דרײַ אײלן; און אַ נעצװערק פֿון מילגרױמען זײַנען געװען אױף דער קרױן רונד אַרום, אַלץ פֿון קופּער; און דעס גלײַכן צום צװײטן זײַל, איבער דעם נעצװערק.<verse eid="2KI 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 25:18" />און דער הױפּט פֿון דעם לײַב-חיל האָט גענומען שׂרָיָה דעם כּהן-גָדול, און צפַֿניָה דעם צװײטן כּהן, און די דרײַ שװעלהיטערס; <verse eid="2KI 25:18" /><verse number="19" style="v" sid="2KI 25:19" />און פֿון שטאָט האָט ער גענומען אײן הױפֿדינער װאָס איז געװען דער אױפֿזעער איבער די מלחמה-לײַט, און פֿינף מענער פֿון די װאָס פֿלעגן זען דעם מלכס פּנים, װאָס האָבן זיך געפֿונען אין שטאָט, און דעם שרײַבער פֿון דעם חיל-לידער װאָס האָט אױפֿגענומען אין חיל דאָס פֿאָלק פֿון לאַנד, און זעכציק מאַן פֿון דעם פֿאָלק פֿון לאַנד װאָס האָבן זיך געפֿונען אין שטאָט. <verse eid="2KI 25:19" /><verse number="20" style="v" sid="2KI 25:20" />און נבֿוזַרְאַדָן דער הױפּט פֿון דעם לײַב-חיל האָט זײ גענומען, און האָט זײ אַװעקגעפֿירט צו דעם מלך פֿון בָבֿל קײן רִבֿלָה. <verse eid="2KI 25:20" /><verse number="21" style="v" sid="2KI 25:21" />און דער מלך פֿון בָבֿל האָט זײ געשלאָגן און געטײט אין רִבֿלָה אין לאַנד חַמָת. אַזױ איז יהוּדה אַװעק אין גלות פֿון זײַן לאַנד.<verse eid="2KI 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 25:22" />און דאָס פֿאָלק װאָס איז געבליבן אין לאַנד יהוּדה, װאָס נבֿוכַדנֶאצַר דער מלך פֿון בָבֿל האָט איבערגעלאָזן – איבער זײ האָט ער אױפֿגעזעצט גדַליָהו דעם זון פֿון אַחיקָם דעם זון פֿון שָפָֿנען.<verse eid="2KI 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 25:23" />און װי אַלע הױפּטלײַט פֿון חיל, זײ מיט די מענטשן, האָבן געהערט, אַז דער מלך פֿון בָבֿל האָט אױפֿגעזעצט גדַליָהון, אַזױ זײַנען זײ געקומען צו גדַליָהון קײן מִצפָּה: און יִשמָעֵאל דער זון פֿון נתַניָהן, און יוֹחָנָן דער זון פֿון קָרֵחַן, און שׂרָיָה דער זון פֿון תַּנחוּמתן, פֿון נטוֹפֿה, און יַאֲזַניָהוּ דער זון פֿון דעם מַעֲכָתי, זײ מיט זײערע מענטשן. <verse eid="2KI 25:23" /><verse number="24" style="v" sid="2KI 25:24" />און גדַליָהו האָט געשװאָרן זײ און זײערע מענטשן, און האָט צו זײ געזאָגט: איר זאָלט נישט מורא האָבן פֿאַר די קנעכט פֿון די כַּשׂדים; זיצט אין לאַנד, און דינט דעם מלך פֿון בָבֿל, און אײַך װעט גוט זײַן.<verse eid="2KI 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 25:25" />אָבער עס איז געװען אין זיבעטן חודש, איז געקומען יִשמָעֵאל דער זון פֿון נתַניָה דעם זון פֿון אֶלישָמָען, פֿון קיניגלעכן אָפּשטאַם, און צען מענטשן מיט אים, און זײ האָבן געשלאָגן גדַליָהון, און ער איז געשטאָרבן; אױך די מענער פֿון יהוּדה און די כַּשׂדים װאָס זײַנען געװען מיט אים אין מִצפָּה. <verse eid="2KI 25:25" /><verse number="26" style="v" sid="2KI 25:26" />און דאָס גאַנצע פֿאָלק פֿון קלײן ביז גרױס, און די הױפּטלײַט פֿון חיל, זײַנען אױפֿגעשטאַנען און זײַנען אַװעק קײן מִצרַיִם, װאָרעם זײ האָבן מורא געהאַט פֿאַר די כַּשׂדים.<verse eid="2KI 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 25:27" />און עס איז געװען אין זיבן און דרײַסיקסטן יאָר נאָך דעם גלות פֿון יהוֹיָכין דעם מלך פֿון יהוּדה, אין צװעלפֿטן חודש, אין זיבן און צװאַנציקסטן טאָג פֿון חודש, האָט אֶוִיל-מרודַך דער מלך פֿון בָבֿל, אין דעם יאָר װאָס ער איז געװאָרן מלך, אױפֿגעהױבן דעם קאָפּ פֿון יהוֹיָכין דעם מלך פֿון יהוּדה, פֿון תּפֿיסה. <verse eid="2KI 25:27" /><verse number="28" style="v" sid="2KI 25:28" />און ער האָט גערעדט צו אים פֿרײַנטלעך, און האָט געשטעלט זײַן שטול איבער די שטולן פֿון די מלכים װאָס בײַ אים אין בָבֿל. <verse eid="2KI 25:28" /><verse number="29" style="v" sid="2KI 25:29" />און ער האָט אומגעביטן זײַנע תּפֿיסה-קלײדער, און ער האָט געגעסן בײַ אים ברױט תּמיד אַלע טעג פֿון זײַן לעבען. <verse eid="2KI 25:29" /><verse number="30" style="v" sid="2KI 25:30" />און זײַן אױסקומעניש, אַ שטענדיקע אױסקומעניש, איז אים געגעבן געװאָרן פֿון מלך טאָגטעגלעך אַלע טעג פֿון זײַן לעבן.<verse eid="2KI 25:30" /></para>
  <chapter eid="2KI 25" />
</usx>