<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">מִיכָה</para>
  <para style="toc2">מִיכָה</para>
  <para style="toc1">מִיכָה</para>
  <para style="mt1">מִיכָה</para>
  <chapter number="1" style="c" pubnumber="א" sid="MIC 1" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />דאָס װאָרט פֿון ה׳ װאָס איז געװען צו מִיכָהן פֿון מוֹרֶשֶת, אין די טעג פֿון יוֹתָם, אָחָז, יחִזקִיָה, די מלכים פֿון יהוּדה, װאָס ער האָט געזען אױף שוֹמרוֹן און ירושָלַיִם.<verse eid="MIC 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="MIC 1:2" />הערט איר פֿעלקער אַלע,</para>
  <para style="q" vid="MIC 1:2">פֿאַרנעם דו ערד און איר פֿולקײט;</para>
  <para style="q" vid="MIC 1:2">און אֲדֹנָי ה׳ װעט זײַן צום עדות קעגן אײַך,</para>
  <para style="q" vid="MIC 1:2">דער האַר פֿון זײַן הײליקן הֵיכל.<verse eid="MIC 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 1:3" />װאָרעם זע, ה׳ גײט אַרױס פֿון זײַן אָרט,</para>
  <para style="q" vid="MIC 1:3">און װעט נידערן און טרעטן אױף די הײכן פֿון דער ערד.<verse eid="MIC 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 1:4" />און די בערג װעלן צעגײן אונטער אים,</para>
  <para style="q" vid="MIC 1:4">און די טאָלן װעלן זיך שפּאַלטן,</para>
  <para style="q" vid="MIC 1:4">װי װאַקס פֿאַרן פֿײַער,</para>
  <para style="q" vid="MIC 1:4">װי װאַסער אױסגעגאָסן אין אַ נידערונג.<verse eid="MIC 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 1:5" />איבער דעם פֿאַרברעך פֿון יעקבֿ איז דאָס אַלץ,</para>
  <para style="q" vid="MIC 1:5">און איבער די זינד פֿון דעם הױז פֿון יִשׂרָאֵל.</para>
  <para style="q" vid="MIC 1:5">װער איז דער פֿאַרברעך פֿון יעקבֿ</para>
  <para style="q" vid="MIC 1:5">אױב נישט שוֹמרוֹן?</para>
  <para style="q" vid="MIC 1:5">און װער די בָמות פֿון יהוּדה</para>
  <para style="q" vid="MIC 1:5">אױב נישט ירושָלַיִם?<verse eid="MIC 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 1:6" />דערום װעל איך מאַכן שוֹמרוֹן פֿאַר אַ פֿעלדהױפֿן,</para>
  <para style="q" vid="MIC 1:6">פֿאַר פֿלאַנצונגען פֿון װײַנגערטנער.</para>
  <para style="q" vid="MIC 1:6">און איך װעל שלײַדערן צום טאָל אירע שטײנער,</para>
  <para style="q" vid="MIC 1:6">און אירע גרונטפֿעסטן װעל איך אַנטפּלעקן.<verse eid="MIC 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 1:7" />און אַלע אירע געשניצטע געצן װעלן צעהאַקט װערן,</para>
  <para style="q" vid="MIC 1:7">און אַלע אירע זוֹנה-לױנען װעלן פֿאַרברענט װערן אין פֿײַער,</para>
  <para style="q" vid="MIC 1:7">און אַלע אירע געצנבילדער װעל איך מאַכן צו װיסט;</para>
  <para style="q" vid="MIC 1:7">װאָרעם פֿון זוֹנה-לױן האָט זי זײ אױפֿגעקליבן,</para>
  <para style="q" vid="MIC 1:7">און צו זוֹנה-לױן זאָלן זײ װידער װערן.<verse eid="MIC 1:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="MIC 1:8" />דערױף װעל איך קלאָגן און יאָמערן,</para>
  <para style="q" vid="MIC 1:8">איך װעל אומגײן באָרװעס און נאַקעט,</para>
  <para style="q" vid="MIC 1:8">איך װעל מאַכן אַ קלאָג װי די שאַקאַלן,</para>
  <para style="q" vid="MIC 1:8">און אַ טרױער װי שטרױספֿױגלען.<verse eid="MIC 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 1:9" />װאָרעם שװער זײַנען אירע שלעק,</para>
  <para style="q" vid="MIC 1:9">װאָרעם עס איז געקומען ביז יהוּדה,</para>
  <para style="q" vid="MIC 1:9">עס גרײכט ביזן טױער פֿון מײַן פֿאָלק,</para>
  <para style="q" vid="MIC 1:9">ביז ירושָלַיִם.<verse eid="MIC 1:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="MIC 1:10" />נישט דערצײלן זאָלט איר אין גַת,</para>
  <para style="q" vid="MIC 1:10">װײנען זאָלט איר נישט װײנען;</para>
  <para style="q" vid="MIC 1:10">אין בֵית-לעָפֿרָה אין שטױב טו זיך קײַקלען.<verse eid="MIC 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 1:11" />גײ דיר אַװעק, באַװױנערין פֿון שָפֿיר,</para>
  <para style="q" vid="MIC 1:11">נאַקעט צו שאַנד;</para>
  <para style="q" vid="MIC 1:11">נישט אַרױסגײן דערװעגט זיך די באַװױנערין פֿון צַעֲנָן</para>
  <para style="q" vid="MIC 1:11">אַ קלאָג איז אין בֵית-אֵצֶל;</para>
  <para style="q" vid="MIC 1:11">מע נעמט פֿון אײַך אָפּ זײַן באַשטאַנד.<verse eid="MIC 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 1:12" />יאָ, געאַנגסט נאָך גוטס האָט די באַװױנערין פֿון מָרוֹת,</para>
  <para style="q" vid="MIC 1:12">אָבער גענידערט האָט בײז פֿון ה׳ צום טױער פֿון ירושָלַיִם.<verse eid="MIC 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 1:13" />שפּאַן דעם רײַטװאָגן צו די לױפֿפֿערד,</para>
  <para style="q" vid="MIC 1:13">באַװױנערין פֿון לָכיש;</para>
  <para style="q" vid="MIC 1:13">זי איז דער אָנהײב זינד געװען פֿאַר דער טאָכטער צִיוֹן;</para>
  <para style="q" vid="MIC 1:13">װאָרעם בײַ דיר זײַנען געפֿונען געװאָרן</para>
  <para style="q" vid="MIC 1:13">די פֿאַרברעכן פֿון יִשׂרָאֵל.<verse eid="MIC 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MIC 1:14" />דערום װעסטו געזענג-מתָּנות געבן צו מוֹרֶשֶת-גַת;</para>
  <para style="q" vid="MIC 1:14">די הײַזער פֿון אַכזיבֿ װעלן װערן צום אָפּנאַר</para>
  <para style="q" vid="MIC 1:14">פֿאַר די מלכים פֿון יִשׂרָאֵל.<verse eid="MIC 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MIC 1:15" />איך װעל נאָך ברענגען אַ יוֹרש אױף דיר,</para>
  <para style="q" vid="MIC 1:15">באַװױנערין פֿון מָרֵשָה,</para>
  <para style="q" vid="MIC 1:15">ביז קײן עַדולָם װעט קומען דער כּבֿוד פֿון יִשׂרָאֵל.<verse eid="MIC 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MIC 1:16" />מאַך דיר אַ פּליך און שער דיך אָפּ,</para>
  <para style="q" vid="MIC 1:16">איבער דײַנע געצערטלטע קינדער,</para>
  <para style="q" vid="MIC 1:16">מאַך ברײט דײַן פּליך װי דער גײערפֿױגל,</para>
  <para style="q" vid="MIC 1:16">װאָרעם זײ זײַנען אין גלות אַװעק פֿון דיר.<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="MIC 2" />
  <para style="q">
    <verse number="1" style="v" sid="MIC 2:1" />װײ צו די װאָס טראַכטן אומרעכט,</para>
  <para style="q" vid="MIC 2:1">און אַרבעטן אױס בײז אױף זײערע געלעגערס!</para>
  <para style="q" vid="MIC 2:1">אין ליכט פֿון פֿרימאָרגן פֿירן זײ עס אױס,</para>
  <para style="q" vid="MIC 2:1">װײַל עס איז אין דער מאַכט פֿון זײער האַנט.<verse eid="MIC 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 2:2" />און זײ גלוסטן פֿעלדער און גזלען,</para>
  <para style="q" vid="MIC 2:2">און הײַזער און נעמען צו;</para>
  <para style="q" vid="MIC 2:2">און באַרױבן אַ מאַן מיט זײַן הױז,</para>
  <para style="q" vid="MIC 2:2">און אַ מענטשן מיט זײַן נחלה.<verse eid="MIC 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 2:3" />דערום האָט ה׳ אַזױ געזאָגט:</para>
  <para style="q" vid="MIC 2:3">זע, איך טראַכט אױף דער דאָזיקער משפּחה אַ בײז</para>
  <para style="q" vid="MIC 2:3">װאָס איר װעט נישט קענען אָפּטאָן דערפֿון אײַערע העלדזער,</para>
  <para style="q" vid="MIC 2:3">און איר װעט נישט גײן מיט אַן אױפֿגעהױבענעם קאָפּ,</para>
  <para style="q" vid="MIC 2:3">װאָרעם אַ בײזע צײַט װעט דאָס זײַן.<verse eid="MIC 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 2:4" />אין יענעם טאָג װעט מען אױפֿהײבן אױף אײַך אַ שפּרוך,</para>
  <para style="q" vid="MIC 2:4">און מע װעט קלאָגן אַ קלאָג פֿון באַקלאָגעניש,</para>
  <para style="q" vid="MIC 2:4">מע װעט זאָגן: פֿאַרװיסטן פֿאַרװיסט זײַנען מיר געװאָרן;</para>
  <para style="q" vid="MIC 2:4">דעם טײל פֿון מײַן פֿאָלק טוט ער בײַטן.</para>
  <para style="q" vid="MIC 2:4">װי טוט ער מיך דערװײַטערן!</para>
  <para style="q" vid="MIC 2:4">דעם אַװעקרױבער צעטײלט ער אונדזערע פֿעלדער.<verse eid="MIC 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 2:5" />פֿאַר װאָר, קײנער פֿון דיר װעט נישט װאַרפֿן</para>
  <para style="q" vid="MIC 2:5">אַ שנור לױט גורל אין דער עדה פֿון ה׳.<verse eid="MIC 2:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="MIC 2:6" />איר זאָלט נישט דַרשען! דַרשען זײ;</para>
  <para style="q" vid="MIC 2:6">מע דאַרף נישט דַרשען צו די דאָזיקע,</para>
  <para style="q" vid="MIC 2:6">װעט מען קײן חרפּות נישט קריגן.<verse eid="MIC 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 2:7" />טו איך זיך דען בײַטן, הױז פֿון יעקבֿ?</para>
  <para style="q" vid="MIC 2:7">צי איז קורץ געװאָרן דאָס רוּחַ פֿון ה׳?</para>
  <para style="q" vid="MIC 2:7">זײַנען דאָס זײַנע טוּונגען?</para>
  <para style="q" vid="MIC 2:7">טוען נישט מײַנע װערטער גוטס מיט דעם װאָס גײט גלײַך?<verse eid="MIC 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 2:8" />אָבער מײַן פֿאָלק פֿון אַנוסטן שטעלט זיך אױף פֿאַר אַ פֿײַנט;</para>
  <para style="q" vid="MIC 2:8">פֿון דעם װאָס קומט אַנטקעגן ציט איר קלײד און מאַנטל אַראָפּ,</para>
  <para style="q" vid="MIC 2:8">פֿון רויִקע דורכגײער, אָפּגענײגטע פֿון מלחמה.<verse eid="MIC 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 2:9" />די װײַבער פֿון מײַן פֿאָלק פֿאַרטרײַבט איר פֿון זײער נחתדיקער הײם;</para>
  <para style="q" vid="MIC 2:9">פֿון זײערע עוֹפֿעלעך נעמט איר אַװעק מײַן צירונג אױף אײביק.<verse eid="MIC 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 2:10" />שטײט אױף און גײט,</para>
  <para style="q" vid="MIC 2:10">װאָרעם נישטאָ דאָ קײן רוּונג,</para>
  <para style="q" vid="MIC 2:10">פֿון װעגן דער טומאה װאָס צעשטערט, און אַ שטאַרקע צעשטערונג.<verse eid="MIC 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 2:11" />אַז אַ מאַן װאָס גײט אום מיט װינט און ליגן, זאָל פֿעלשן:</para>
  <para style="q" vid="MIC 2:11">איך װעל דיר דַרשען פֿון װײַן און פֿון טרונק,</para>
  <para style="q" vid="MIC 2:11">װאָלט ער װערן אַ דַרשן בײַ דעם דאָזיקן פֿאָלק.<verse eid="MIC 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 2:12" />זאַמלען אײַנזאַמלען װעל איך דיך, יעקבֿ, אין גאַנצן,</para>
  <para style="q" vid="MIC 2:12">קלײַבן אױפֿקלײַבן װעל איך דעם איבערבלײַב פֿון יִשׂרָאֵל.</para>
  <para style="q" vid="MIC 2:12">איך װעל זײ צונױפֿטאָן אין אײנעם װי שאָף אין געהעפֿט,</para>
  <para style="q" vid="MIC 2:12">װי אַ סטאַדע אין איר פֿיטערפּלאַץ;</para>
  <para style="q" vid="MIC 2:12">זײ װעלן רױשן מיט מענטשן.<verse eid="MIC 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 2:13" />דער דורכברעכער גײט אַרױף זײ פֿאַרױס,</para>
  <para style="q" vid="MIC 2:13">זײ ברעכן דורך און גײען װײַטער,</para>
  <para style="q" vid="MIC 2:13">דורך דעם טױער און אַרױס דורך אים,</para>
  <para style="q" vid="MIC 2:13">און זײער מלך גײט זײ פֿאַרױס,</para>
  <para style="q" vid="MIC 2:13">און ה׳ איז זײער אָנפֿירער.<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="MIC 3" />
  <para style="q">
    <verse number="1" style="v" sid="MIC 3:1" />און איך האָב געזאָגט:</para>
  <para style="q" vid="MIC 3:1">הערט אַקאָרשט צו, איר קעפּ פֿון יעקבֿ,</para>
  <para style="q" vid="MIC 3:1">און האַרן פֿון הױז פֿון יִשׂרָאֵל;</para>
  <para style="q" vid="MIC 3:1">ליגט נישט אױף אײַך צו װיסן גערעכטיקײט?<verse eid="MIC 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 3:2" />איר װאָס האָט פֿײַנט גוטס און האָט ליב שלעכטס,</para>
  <para style="q" vid="MIC 3:2">װאָס גזלט זײער הױט פֿון זײ,</para>
  <para style="q" vid="MIC 3:2">און זײער פֿלײש פֿון זײערע בײנער;<verse eid="MIC 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 3:3" />און װאָס האָט געגעסן דאָס פֿלײש פֿון מײַן פֿאָלק,</para>
  <para style="q" vid="MIC 3:3">און זײער הױט פֿון זײ אָפּגעשונדן,</para>
  <para style="q" vid="MIC 3:3">און זײערע בײנער צעבראָכן,</para>
  <para style="q" vid="MIC 3:3">און צעהאַקט אַזױ װי אין אַ טאָפּ,</para>
  <para style="q" vid="MIC 3:3">און װי פֿלײש אין אַ קעסל.<verse eid="MIC 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 3:4" />דערום װעלן זײ שרײַען צו ה׳,</para>
  <para style="q" vid="MIC 3:4">און ער װעט זײ נישט ענטפֿערן;</para>
  <para style="q" vid="MIC 3:4">און ער װעט פֿאַרבאָרגן זײַן פּנים פֿון זײ אין יענער צײַט,</para>
  <para style="q" vid="MIC 3:4">אַזױ װי זײ האָבן שלעכטס געטאָן אין זײערע מעשׂים.<verse eid="MIC 3:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="MIC 3:5" />אַזױ האָט ה׳ געזאָגט אױף די נבֿיאים װאָס פֿאַרפֿירן מײַן פֿאָלק,</para>
  <para style="q" vid="MIC 3:5">װאָס שרײַען: שלום! װען זײערע צײן האָבן צו בײַסן,</para>
  <para style="q" vid="MIC 3:5">און דער װאָס גיט זײ נישט אין מױל</para>
  <para style="q" vid="MIC 3:5">ברײטן זײ אָן אױף אים אַ מלחמה.<verse eid="MIC 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 3:6" />דערום װעט אײַך זײַן נאַכט, אָן אַ זעונג,</para>
  <para style="q" vid="MIC 3:6">און אײַך װעט זײַן פֿינצטער, אָן װאָרזאָגן,</para>
  <para style="q" vid="MIC 3:6">און אונטערגײן װעט די זון אױף די נבֿיאים,</para>
  <para style="q" vid="MIC 3:6">און שװאַרץ װערן װעט דער טאָג אױף זײ.<verse eid="MIC 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 3:7" />און די זעער װעלן זײַן צו שאַנד,</para>
  <para style="q" vid="MIC 3:7">און די װאָרזאָגער װעלן זיך שעמען,</para>
  <para style="q" vid="MIC 3:7">און זײ װעלן אַלע פֿאַרדעקן זײערע אױבערשטע ליפּ,</para>
  <para style="q" vid="MIC 3:7">װײַל קײן ענטפֿער פֿון אלֹקים װעט נישט זײַן.<verse eid="MIC 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 3:8" />אָבער פֿאַר װאָר, איך בין פֿול</para>
  <para style="q" vid="MIC 3:8">מיט כּוֹח דורך דעם גײַסט פֿון ה׳,</para>
  <para style="q" vid="MIC 3:8">און מיט גערעכטיקײט און גבֿורה,</para>
  <para style="q" vid="MIC 3:8">צו זאָגן יעקבֿן זײַן פֿאַרברעך,</para>
  <para style="q" vid="MIC 3:8">און יִשׂרָאֵלן זײַן זינד.<verse eid="MIC 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="MIC 3:9" />הערט דאָס צו אַקאָרשט, איר קעפּ פֿון דעם הױז פֿון יעקבֿ,</para>
  <para style="q" vid="MIC 3:9">און האַרן פֿון הױז פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="MIC 3:9">װאָס פֿאַראומװערדיקט גערעכטיקײט,</para>
  <para style="q" vid="MIC 3:9">און פֿאַרדרײט אַלץ װאָס איז גלײַך;<verse eid="MIC 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 3:10" />מע בױט צִיוֹן מיט בלוט,</para>
  <para style="q" vid="MIC 3:10">און ירושָלַיִם מיט אומרעכט.<verse eid="MIC 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 3:11" />אירע קעפּ משפּטן פֿאַר שוחד,</para>
  <para style="q" vid="MIC 3:11">און אירע כּהנים לערנען פֿאַר געצאָלט,</para>
  <para style="q" vid="MIC 3:11">און אירע נבֿיאים װאָרזאָגן פֿאַר געלט.</para>
  <para style="q" vid="MIC 3:11">און זײ לענען זיך אױף ה׳, אַזױ צו זאָגן:</para>
  <para style="q" vid="MIC 3:11">פֿאַר װאָר, ה׳ איז צװישן אונדז,</para>
  <para style="q" vid="MIC 3:11">אױף אונדז װעט נישט קומען קײן בײז.<verse eid="MIC 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 3:12" />דערום װעט איבער אײַך צִיוֹן װי אַ פֿעלד צעאַקערט װערן,</para>
  <para style="q" vid="MIC 3:12">און ירושָלַיִם װעט װערן הױפֿנס,</para>
  <para style="q" vid="MIC 3:12">און דער באַרג פֿון ה׳ס הױז – װאַלדיקע הײכן.<verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="MIC 4" />
  <para style="q">
    <verse number="1" style="v" sid="MIC 4:1" />און עס װעט זײַן אין סוף פֿון די טעג,</para>
  <para style="q" vid="MIC 4:1">װעט שטײן פֿעסט דער באַרג פֿון ה׳ס הױז,</para>
  <para style="q" vid="MIC 4:1">אױבנאָן פֿון די בערג,</para>
  <para style="q" vid="MIC 4:1">און ער װעט זײַן דערהױבן איבער די הײכן;</para>
  <para style="q" vid="MIC 4:1">און אומות װעלן צו אים שטראָמען.<verse eid="MIC 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 4:2" />און פֿיל פֿעלקער װעלן גײן און װעלן זאָגן:</para>
  <para style="q" vid="MIC 4:2">קומט און לאָמיר אַרױפֿגײן צום באַרג פֿון ה׳,</para>
  <para style="q" vid="MIC 4:2">און צום הױז פֿון אלוקי יעקבֿ,</para>
  <para style="q" vid="MIC 4:2">און ער װעט אונדז לערנען פֿון זײַנע װעגן,</para>
  <para style="q" vid="MIC 4:2">און מיר װעלן גײן אין זײַנע שטעגן;</para>
  <para style="q" vid="MIC 4:2">װאָרעם פֿון צִיוֹן װעט אַרױסגײן אַ תּורה,</para>
  <para style="q" vid="MIC 4:2">און ה׳ס װאָרט פֿון ירושָלַיִם.<verse eid="MIC 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 4:3" />און ער װעט משפּטן צװישן פֿיל אומות,</para>
  <para style="q" vid="MIC 4:3">און אַנטשײדן איבער מאַכטיקע פֿעלקער ביז אין דער װײַט;</para>
  <para style="q" vid="MIC 4:3">און זײ װעלן איבערשמידן זײערע שװערדן אױף אַקעראײַזנס,</para>
  <para style="q" vid="MIC 4:3">און זײערע שפּיזן אױף צװײַגמעסערס;</para>
  <para style="q" vid="MIC 4:3">אַ פֿאָלק קעגן אַ פֿאָלק װעט נישט הײבן אַ שװערד,</para>
  <para style="q" vid="MIC 4:3">און מע װעט נישט מער לערנען מלחמה.<verse eid="MIC 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 4:4" />און זײ װעלן זיצן איטלעכער</para>
  <para style="q" vid="MIC 4:4">אונטער זײַן װײַנשטאָק און אונטער זײַן פֿײַגנבױם,</para>
  <para style="q" vid="MIC 4:4">און קײנער װעט נישט שרעקן;</para>
  <para style="q" vid="MIC 4:4">װאָרעם דאָס מױל פֿון ה׳ צבָֿאוֹת האָט גערעדט.<verse eid="MIC 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 4:5" />װאָרעם אַלע פֿעלקער מעגן גײן</para>
  <para style="q" vid="MIC 4:5">איטלעכס אין נאָמען פֿון זײַן ג-ט,</para>
  <para style="q" vid="MIC 4:5">אָבער מיר װעלן גײן אין נאָמען פֿון ה׳</para>
  <para style="q" vid="MIC 4:5">אלוקינו אױף אײביק און שטענדיק.<verse eid="MIC 4:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="MIC 4:6" />אין יענעם טאָג, זאָגט ה׳,</para>
  <para style="q" vid="MIC 4:6">װעל איך אײַנזאַמלען די װאָס הינקט,</para>
  <para style="q" vid="MIC 4:6">און צונױפֿקלײַבן די װאָס איז פֿאַרשטױסן,</para>
  <para style="q" vid="MIC 4:6">און די װעמען איך האָב שלעכטס געטאָן.<verse eid="MIC 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 4:7" />און איך װעל מאַכן די הינקעדיקע פֿאַר אַן איבערבלײַב,</para>
  <para style="q" vid="MIC 4:7">און די דערװײַטערטע פֿאַר אַ מאַכטיקן פֿאָלק,</para>
  <para style="q" vid="MIC 4:7">און ה׳ װעט קיניגן איבער זײ אױפֿן באַרג צִיוֹן</para>
  <para style="q" vid="MIC 4:7">פֿון אַצונד און ביז אײביק.<verse eid="MIC 4:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="MIC 4:8" />און דו מִגדַל-עֵדֶר, פֿעסטונגבאַרג פֿון טאָכטער צִיוֹן,</para>
  <para style="q" vid="MIC 4:8">צו דיר װעט עס אָנקומען;</para>
  <para style="q" vid="MIC 4:8">יאָ, קומען װעט די פֿריִערדיקע ממשלה,</para>
  <para style="q" vid="MIC 4:8">די מלוכה פֿון טאָכטער ירושָלַיִם.<verse eid="MIC 4:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="MIC 4:9" />אַצונד נאָך װאָס שרײַסטו מיט געשרײען?</para>
  <para style="q" vid="MIC 4:9">איז קײן מלך נישטאָ אין דיר,</para>
  <para style="q" vid="MIC 4:9">איז דײַן בַעַל-יוֹעץ אונטערגעגאַנגען,</para>
  <para style="q" vid="MIC 4:9">װאָס װײעניש האָט דיך אָנגענומען װי אַ געװינערין?<verse eid="MIC 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 4:10" />דרײַ זיך און האָב װײען, טאָכטער צִיוֹן,</para>
  <para style="q" vid="MIC 4:10">אַזױ װי אַ געװינערין,</para>
  <para style="q" vid="MIC 4:10">װאָרעם אַצונד װעסטו אַרױסגײן פֿון דער שטאָט,</para>
  <para style="q" vid="MIC 4:10">און װעסט װױנען אין פֿעלד,</para>
  <para style="q" vid="MIC 4:10">און װעסט קומען קײן בָבֿל;</para>
  <para style="q" vid="MIC 4:10">דאָרטן װעסטו ניצול װערן,</para>
  <para style="q" vid="MIC 4:10">דאָרטן װעט דיך אױסלײזן ה׳</para>
  <para style="q" vid="MIC 4:10">פֿון דער האַנט פֿון דײַנע פֿײַנט.<verse eid="MIC 4:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="MIC 4:11" />און אַצונד האָבן זיך אײַנגעזאַמלט אױף דיר פֿיל פֿעלקער,</para>
  <para style="q" vid="MIC 4:11">װאָס זאָגן: זאָל זי פֿאַרשװעכט װערן,</para>
  <para style="q" vid="MIC 4:11">און זאָל אונדזער אױג זיך אָנקוקן אױף צִיוֹן.<verse eid="MIC 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 4:12" />אָבער זײ װײסן נישט די טראַכטונגען פֿון ה׳,</para>
  <para style="q" vid="MIC 4:12">און זײ פֿאַרשטײען נישט זײַן באַראָט,</para>
  <para style="q" vid="MIC 4:12">אַז ער האָט זײ אײַנגעזאַמלט װי אַ גאַרב אין דרעש-שײַער.<verse eid="MIC 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 4:13" />שטײ אױף און דרעש, טאָכטער צִיוֹן,</para>
  <para style="q" vid="MIC 4:13">װאָרעם דײַן האָרן װעל איך מאַכן אײַזן,</para>
  <para style="q" vid="MIC 4:13">און דײַנע קלױען װעל איך מאַכן קופּער,</para>
  <para style="q" vid="MIC 4:13">און װעסט צעשטױסן פֿיל פֿעלקער,</para>
  <para style="q" vid="MIC 4:13">און מאַכן חרם צו ה׳ זײער רױב,</para>
  <para style="q" vid="MIC 4:13">און זײער פֿאַרמעג צום האַר פֿון דער גאַנצער ערד.<verse eid="MIC 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" pubnumber="5.1" sid="MIC 4:14" /> איצט זאַמלט אײַך אײַן דײַנע חילות, אָ דו טאָכטער פֿון חילות,</para>
  <para style="q" vid="MIC 4:14">מען האָט אַ באַלאַגערונג איבער אונדז געמאַכט,</para>
  <para style="q" vid="MIC 4:14">זײ װעלן דעם שופֿט פֿון ישׂראל</para>
  <para style="q" vid="MIC 4:14">שלאָגן אױף די באַקן מיט אַ רוט.<verse eid="MIC 4:14" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="MIC 5" />
  <para style="q">
    <verse number="1" style="v" pubnumber="5.2" sid="MIC 5:1" /> און דו, בֵית-לֶחֶם אין אֶפֿרָת,</para>
  <para style="q" vid="MIC 5:1">װאָס קלײן ביסטו צװישן די טױזנטן פֿון יהוּדה,</para>
  <para style="q" vid="MIC 5:1">פֿון דיר װעט מיר אַרױסגײן</para>
  <para style="q" vid="MIC 5:1">דער װאָס װעט זײַן אַ געװעלטיקער איבער יִשׂרָאֵל,</para>
  <para style="q" vid="MIC 5:1">און זײַן אָפּשטאַם איז פֿון אײביק,</para>
  <para style="q" vid="MIC 5:1">פֿון די טעג פֿון אײביקײט.<verse eid="MIC 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" pubnumber="5.3" sid="MIC 5:2" /> פֿאַר װאָר, ער װעט זײ איבערגעבן צו זײערע פֿײַנט</para>
  <para style="q" vid="MIC 5:2">ביז דער צײַט אין איר יֹולֵדָה װען די פֿרױ געבורט;</para>
  <para style="q" vid="MIC 5:2">אָבער דער איבערבלײַב פֿון זײַנע ברידער</para>
  <para style="q" vid="MIC 5:2">װעט זיך אומקערן מיט די קינדער פֿון יִשׂרָאֵל.<verse eid="MIC 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="4" sid="MIC 5:3" /> און ער װעט אױפֿשטײן און פֿיטערן מיט מאַכט פֿון ה׳,</para>
  <para style="q" vid="MIC 5:3">מיטן נאָמען פֿון מאַיעסטעט פֿון ה׳ זײַן ג-ט;</para>
  <para style="q" vid="MIC 5:3">און זײ װעלן זיצן רואיק,</para>
  <para style="q" vid="MIC 5:3">װאָרעם ער װעט דענצמאָל זײַן גרױס ביז די עקן פֿון דער ערד.<verse eid="MIC 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="5" sid="MIC 5:4" /> און אַזאַ װעט זײַן דער שלום:</para>
  <para style="q" vid="MIC 5:4">אַז אשור װעט קומען אין אונדזער לאַנד,</para>
  <para style="q" vid="MIC 5:4">און אַז ער װעט טרעטן אין אונדזערע פּאַלאַצן,</para>
  <para style="q" vid="MIC 5:4">װעלן מיר אױפֿשטעלן אױף אים זיבן פּאַסטוכער,</para>
  <para style="q" vid="MIC 5:4">און אַכט פֿירשטלעכע לײַט.<verse eid="MIC 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="6" sid="MIC 5:5" /> און זײ װעלן צעברעכן דאָס לאַנד אשור מיטן שװערד,</para>
  <para style="q" vid="MIC 5:5">און לאַנד נִמרוֹד מיט אירע אײגענע קלינגען.</para>
  <para style="q" vid="MIC 5:5">און מע װעט אונדז מציל זײַן פֿון אשור,</para>
  <para style="q" vid="MIC 5:5">אַז ער װעט קומען אין אונדזער לאַנד,</para>
  <para style="q" vid="MIC 5:5">און אַז ער װעט טרעטן אין אונדזער גבֿול.<verse eid="MIC 5:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="7" sid="MIC 5:6" /> און דער איבערבלײַב פֿון יעקבֿ װעט זײַן צװישן די פֿיל אומות,</para>
  <para style="q" vid="MIC 5:6">װי טױ פֿון ה׳, װי שפּרײרעגן אױף גראָז,</para>
  <para style="q" vid="MIC 5:6">װאָס האָפֿט נישט אױף אַ מענטשן,</para>
  <para style="q" vid="MIC 5:6">און װאַרט נישט אױף מענטשנקינדער.<verse eid="MIC 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="8" sid="MIC 5:7" /> און דער איבערבלײַב פֿון יעקבֿ װעט זײַן צװישן די פֿעלקער,</para>
  <para style="q" vid="MIC 5:7">אין מיטן פֿון די פֿיל אומות,</para>
  <para style="q" vid="MIC 5:7">װי אַ לײב צװישן די חיות פֿון װאַלד,</para>
  <para style="q" vid="MIC 5:7">װי אַ יונגלײב צװישן סטאַדעס שאָף,</para>
  <para style="q" vid="MIC 5:7">װאָס אַז ער גײט דורך צעטרעט ער און פֿאַרצוקט,</para>
  <para style="q" vid="MIC 5:7">און נישטאָ װער זאָל מציל זײַן.<verse eid="MIC 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="9" sid="MIC 5:8" /> דײַן האַנט װעט זײַן דערהױבן איבער דײַנע דריקער,</para>
  <para style="q" vid="MIC 5:8">און אַלע דײַנע פֿײַנט װעלן פֿאַרשניטן װערן.<verse eid="MIC 5:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="10" sid="MIC 5:9" /> און עס װעט זײַן אין יענעם טאָג, זאָגט ה׳,</para>
  <para style="q" vid="MIC 5:9">װעל איך פֿאַרשנײַדן דײַנע פֿערד פֿון צװישן דיר,</para>
  <para style="q" vid="MIC 5:9">און איך װעל אונטערברענגען דײַנע רײַטװעגן.<verse eid="MIC 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="11" sid="MIC 5:10" /> און איך װעל פֿאַרשנײַדן די שטעט פֿון דײַן לאַנד,</para>
  <para style="q" vid="MIC 5:10">און צעשטערן אַלע דײַנע פֿעסטונגען.<verse eid="MIC 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="12" sid="MIC 5:11" /> און איך װעל פֿאַרשנײַדן די כּישופֿן, פֿון דײַן האַנט,</para>
  <para style="q" vid="MIC 5:11">און בײַ דיר װעלן נישט זײַן קײן װאָרזאָגערס.<verse eid="MIC 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="13" sid="MIC 5:12" /> און איך װעל פֿאַרשנײַדן דײַנע געשניצטע געצן</para>
  <para style="q" vid="MIC 5:12">און דײַנע זײַלשטײנער פֿון צװישן דיר,</para>
  <para style="q" vid="MIC 5:12">און װעסט זיך מער נישט בוקן צום װערק פֿון דײַנע הענט.<verse eid="MIC 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="14" sid="MIC 5:13" /> און איך װעל אױסרײַסן דײַנע געצנבײמער פֿון צװישן דיר;</para>
  <para style="q" vid="MIC 5:13">און איך װעל פֿאַרטיליקן דײַנע פֿײַנט.<verse eid="MIC 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="15" sid="MIC 5:14" /> און איך װעל נקמה נעמען</para>
  <para style="q" vid="MIC 5:14">מיט כּעס און מיט גרימצאָרן</para>
  <para style="q" vid="MIC 5:14">פֿון די פֿעלקער װאָס האָבן נישט צוגעהערט.<verse eid="MIC 5:14" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="MIC 6" />
  <para style="q">
    <verse number="1" style="v" sid="MIC 6:1" />הערט אַקאָרשט צו װאָס ה׳ זאָגט:</para>
  <para style="q" vid="MIC 6:1">שטײ אױף, טענה פֿאַר די בערג,</para>
  <para style="q" vid="MIC 6:1">און זאָלן הערן די הײכן דײַן קֹול.<verse eid="MIC 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 6:2" />הערט צו, איר בערג, דעם קריג פֿון ה׳,</para>
  <para style="q" vid="MIC 6:2">און איר מאַכטיקע, די גרונטפֿעסטן פֿון דער ערד;</para>
  <para style="q" vid="MIC 6:2">װאָרעם ה׳ האָט אַ קריג מיט זײַן פֿאָלק,</para>
  <para style="q" vid="MIC 6:2">און מיט יִשׂרָאֵל װעט ער אַ װיכּוח האָבן.<verse eid="MIC 6:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="MIC 6:3" />מײַן פֿאָלק, װאָס האָב איך דיר געטאָן?</para>
  <para style="q" vid="MIC 6:3">און מיט װאָס האָב איך דיך מיד געמאַכט?</para>
  <para style="q" vid="MIC 6:3">זאָג עדות אַקעגן מיר.<verse eid="MIC 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 6:4" />װאָרעם איך האָב דיך אױפֿגעבראַכט פֿון לאַנד מִצרַיִם,</para>
  <para style="q" vid="MIC 6:4">און פֿון דעם הױז פֿון קנעכטשאַפֿט דיך אױסגעלײזט,</para>
  <para style="q" vid="MIC 6:4">און דיר פֿאַרױס געשיקט משהן, אַהרֹנען, און מִריָמען.<verse eid="MIC 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 6:5" />מײַן פֿאָלק, דערמאָן זיך אַקאָרשט</para>
  <para style="q" vid="MIC 6:5">װאָס בָלָק דער מלך פֿון מוֹאָבֿ האָט באַראָטן,</para>
  <para style="q" vid="MIC 6:5">און װאָס אים האָט געענטפֿערט בִלעָם דער זון פֿון בעוֹרן;</para>
  <para style="q" vid="MIC 6:5">װאָס איך האָב געטאָן פֿון שִטים ביז גִלגָל,</para>
  <para style="q" vid="MIC 6:5">כּדי מע זאָל װיסן די גערעכטיקײט פֿון ה׳.<verse eid="MIC 6:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="MIC 6:6" />מיט װאָס זאָל איך קומען פֿאַר ה׳,</para>
  <para style="q" vid="MIC 6:6">און מיך בײגן פֿאַר דעם אַלע העכסטן אלֹקים?</para>
  <para style="q" vid="MIC 6:6">זאָל איך קומען פֿאַר אים מיט בראַנדאָפּפֿער,</para>
  <para style="q" vid="MIC 6:6">מיט קעלבער אײניאָריקע?<verse eid="MIC 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 6:7" />װעט ה׳ באַװיליקן טױזנטן װידערס,</para>
  <para style="q" vid="MIC 6:7">צען טױזנטן טײַכן מיט אײל?</para>
  <para style="q" vid="MIC 6:7">זאָל איך געבן מײַן בכוֹר פֿאַר מײַן פֿאַרברעך,</para>
  <para style="q" vid="MIC 6:7">די פֿרוכט פֿון מײַן לײַב פֿאַר דער זינד פֿון מײַן זעל?<verse eid="MIC 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 6:8" />מע האָט דיר אָנגעזאָגט, מענטש, װאָס איז גוט,</para>
  <para style="q" vid="MIC 6:8">און װאָס ה׳ פֿאַרלאַנגט פֿון דיר:</para>
  <para style="q" vid="MIC 6:8">נאָר בלױז טאָן גערעכטיקײט און ליב האָבן גענאָד,</para>
  <para style="q" vid="MIC 6:8">און אומגײן שטיל פֿאַר דײַן ג-ט.<verse eid="MIC 6:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="MIC 6:9" />האָרך! ה׳ רופֿט צו דער שטאָט –</para>
  <para style="q" vid="MIC 6:9">און דער קלוגער װעט אַכטן אױף דײַן נאָמען –</para>
  <para style="q" vid="MIC 6:9">הערט דעם שטעקן, און װער דאָס האָט באַשערט.<verse eid="MIC 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 6:10" />קען איך נאָכאַנאַנד פֿאַרגעסן דאָס הױז פֿון דעם אומגערעכטן,</para>
  <para style="q" vid="MIC 6:10">די שאַצן פֿון אומרעכט און די קאַרגע מאָס די פֿאַרשאָלטענע?<verse eid="MIC 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 6:11" />קען איך רײן מאַכן פֿאַר אומגערעכטע װאָגשאָלן,</para>
  <para style="q" vid="MIC 6:11">און פֿאַר אַ בײַטל מיט פֿאַלשע װאָגשטײנער?<verse eid="MIC 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 6:12" />װאָרעם אירע רײַכע לײַט זײַנען פֿול מיט רױב,</para>
  <para style="q" vid="MIC 6:12">און אירע באַװױנער רעדן פֿאַלש,</para>
  <para style="q" vid="MIC 6:12">און זײער צונג איז באַטרוג אין זײער מױל.<verse eid="MIC 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 6:13" />דערום האָב איך אױך דיך געשלאָגן ביז קראַנק,</para>
  <para style="q" vid="MIC 6:13">דיך פֿאַרװיסט פֿאַר דײַנע זינד.<verse eid="MIC 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MIC 6:14" />דו װעסט עסן און נישט זאַט װערן,</para>
  <para style="q" vid="MIC 6:14">און דײַן הונגער װעט זײַן אין דײַנע אינגעװײד;</para>
  <para style="q" vid="MIC 6:14">און װעסט טראָגעדיק װערן, און נישט געװינען,</para>
  <para style="q" vid="MIC 6:14">און װאָס דו װעסט געװינען װעל איך צום שװערד איבערגעבן.<verse eid="MIC 6:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MIC 6:15" />דו װעסט זײען, און נישט שנײַדן,</para>
  <para style="q" vid="MIC 6:15">דו װעסט טרעטן אײלבערטן, און זיך נישט זאַלבן מיט אײל,</para>
  <para style="q" vid="MIC 6:15">און טרױבנזאַפֿט, און נישט טרינקען קײן װײַן.<verse eid="MIC 6:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MIC 6:16" />װײַל אָפּגעהיט װערן די מינהגים פֿון עָמרין,</para>
  <para style="q" vid="MIC 6:16">און אַל די טועניש פֿון אַחאָבֿס הױז,</para>
  <para style="q" vid="MIC 6:16">און איר זײַט געגאַנגען אין זײערע עצות;</para>
  <para style="q" vid="MIC 6:16">דערום װעל איך דיך מאַכן פֿאַר אַ שרעק,</para>
  <para style="q" vid="MIC 6:16">און אירע באַװױנער פֿאַר אַ שמוצערונג;</para>
  <para style="q" vid="MIC 6:16">און די שאַנד פֿון מײַן פֿאָלק װעט איר טראָגן.<verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="MIC 7" />
  <para style="q">
    <verse number="1" style="v" sid="MIC 7:1" />װײ מיר, װאָס איך בין װי בײַם נאָכזאַמל פֿון זומער,</para>
  <para style="q" vid="MIC 7:1">װי בײַם נאָכקלײַב פֿון דער לעז!</para>
  <para style="q" vid="MIC 7:1">נישטאָ אַ הענגל צום עסן,</para>
  <para style="q" vid="MIC 7:1">אַן ערשטפֿרוכט װאָס מײַן זעל געלוסט.<verse eid="MIC 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 7:2" />אונטערגעגאַנגען איז דער פֿרומער פֿון לאַנד,</para>
  <para style="q" vid="MIC 7:2">און קײן רעכטפֿאַרטיקער צװישן מענטשן איז נישטאָ;</para>
  <para style="q" vid="MIC 7:2">אַלע לױערן זײ אױף בלוט,</para>
  <para style="q" vid="MIC 7:2">אײנער דעם אַנדערן פֿאַנגען זײ אין נעץ.<verse eid="MIC 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 7:3" />אױף שלעכטס טאָן זײַנען די הענט װאָס דאַרפֿן גוטס טאָן;</para>
  <para style="q" vid="MIC 7:3">דער שׂרָרה פֿאַרלאַנגט, און דער ריכטער איז פֿאַר באַצאָלט,</para>
  <para style="q" vid="MIC 7:3">און דער גרוסיער מאַן, ער רעדט די געריקײט פֿון זײַן זעל;</para>
  <para style="q" vid="MIC 7:3">אַזױ האָבן זײ עס פֿאַרדרײט.<verse eid="MIC 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 7:4" />דער בעסטער פֿון זײ איז װי אַ דאָרן,</para>
  <para style="q" vid="MIC 7:4">דער רעכטפֿאַרטיקער, ערגער פֿון אַ שטעכיקער צאַם.</para>
  <para style="q" vid="MIC 7:4">דער טאָג פֿון דײַנע זעער, דײַן רעכנשאַפֿט, איז געקומען;</para>
  <para style="q" vid="MIC 7:4">אַצונד װעט געשען זײער צעטומלעניש.<verse eid="MIC 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 7:5" />זאָלט איר נישט גלױבן אין אַ חבֿר,</para>
  <para style="q" vid="MIC 7:5">זאָלט איר אײַך נישט פֿאַרזיכערן אױף אַ גוטן פֿרײַנט;</para>
  <para style="q" vid="MIC 7:5">פֿון דער װאָס ליגט אין דײַן בוזעם,</para>
  <para style="q" vid="MIC 7:5">היט די טירן פֿון דײַן מױל.<verse eid="MIC 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 7:6" />װאָרעם אַ זון באַנַװלט אַ פֿאָטער,</para>
  <para style="q" vid="MIC 7:6">אַ טאָכטער שטעלט זיך קעגן איר מוטער,</para>
  <para style="q" vid="MIC 7:6">אַ שנור קעגן איר שװיגער,</para>
  <para style="q" vid="MIC 7:6">די שָׂונאים פֿון אַ מענטשן זײַנען זײַנע הױזלײַט.<verse eid="MIC 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 7:7" />אָבער איך קוק אױס אױף ה׳,</para>
  <para style="q" vid="MIC 7:7">איך האַר צום ה׳ פֿון מײַן הילף,</para>
  <para style="q" vid="MIC 7:7">מײַן ג-ט װעט מיך צוהערן.<verse eid="MIC 7:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="MIC 7:8" />נישט פֿרײען זאָלסטו זיך אױף מיר, מײַן שׂוֹנאטע,</para>
  <para style="q" vid="MIC 7:8">אַז איך בין געפֿאַלן, װעל איך אױפֿשטײן,</para>
  <para style="q" vid="MIC 7:8">אַז איך זיץ אין פֿינצטערניש, איז ה׳ מיר אַ ליכט.<verse eid="MIC 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 7:9" />דעם צאָרן פֿון ה׳ װעל איך טראָגן,</para>
  <para style="q" vid="MIC 7:9">װאָרעם איך האָב געזינדיקט צו אים;</para>
  <para style="q" vid="MIC 7:9">ביז ער װעט קריגן מײַן קריג,</para>
  <para style="q" vid="MIC 7:9">און װעט טאָן מײַן רעכט;</para>
  <para style="q" vid="MIC 7:9">ער װעט מיך אַרױספֿירן אין ליכטיקײט,</para>
  <para style="q" vid="MIC 7:9">איך װעל זען זײַן גערעכטיקײט.<verse eid="MIC 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 7:10" />און מײַן שׂוֹנאטע װעט זען, און אַ בושה װעט זי באַדעקן,</para>
  <para style="q" vid="MIC 7:10">די װאָס זאָגט צו מיר: װוּ איז ער, ה׳ דײַן ג-ט?</para>
  <para style="q" vid="MIC 7:10">מײַנע אױגן װעלן זיך אָנזען אױף איר;</para>
  <para style="q" vid="MIC 7:10">אַצונד װעט זי צעטראָטן װערן װי קױט פֿון די גאַסן.<verse eid="MIC 7:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="MIC 7:11" />אַ טאָג װעט זײַן צו בױען דײַנע מױערן,</para>
  <para style="q" vid="MIC 7:11">מעג יענער טאָג זײַן זײער װײַט.<verse eid="MIC 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 7:12" />אַ טאָג װעט דאָס זײַן װען מע װעט קומען צו דיר,</para>
  <para style="q" vid="MIC 7:12">פֿון אשור און די שטעט פֿון מִצרַיִם,</para>
  <para style="q" vid="MIC 7:12">און פֿון מִצרַיִם און ביזן טײַך,</para>
  <para style="q" vid="MIC 7:12">און פֿון ים ביז ים, און פֿון באַרג ביז באַרג.<verse eid="MIC 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 7:13" />און די ערד װעט זײַן װיסט פֿאַר אירע באַװױנער,</para>
  <para style="q" vid="MIC 7:13">פֿון װעגן דעם פֿרוכט פֿון זײערע מעשׂים.<verse eid="MIC 7:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="MIC 7:14" />פֿיטער דײַן פֿאָלק מיט דײַן רוט,</para>
  <para style="q" vid="MIC 7:14">די שאָף פֿון דײַן אַרב,</para>
  <para style="q" vid="MIC 7:14">װאָס װױנען באַזונדער אַ װאַלד אין מיטן כַּרמֶל;</para>
  <para style="q" vid="MIC 7:14">לאָזן זײ זיך פֿיטערן אין בָשָן און גִלעָד,</para>
  <para style="q" vid="MIC 7:14">װי אין די טעג פֿון אַמאָל.<verse eid="MIC 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MIC 7:15" />װי אין די טעג פֿון דײַן אַרױסגײן פֿון לאַנד מִצרַיִם,</para>
  <para style="q" vid="MIC 7:15">װעל איך אים װוּנדער באַװײַזן.<verse eid="MIC 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MIC 7:16" />פֿעלקער װעלן זען און זיך שעמען מיט אַל זײער גבֿורה,</para>
  <para style="q" vid="MIC 7:16">זײ װעלן אַרױפֿטאָן די האַנט אױפֿן מױל,</para>
  <para style="q" vid="MIC 7:16">זײערע אױערן װעלן טױב װערן.<verse eid="MIC 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="MIC 7:17" />זײ װעלן לעקן דעם שטױב װי אַ שלאַנג,</para>
  <para style="q" vid="MIC 7:17">װי די װאָס קריכן אױף דער ערד;</para>
  <para style="q" vid="MIC 7:17">זײ װעלן ציטערן פֿון זײערע פֿעסטונגען,</para>
  <para style="q" vid="MIC 7:17">צו ה׳ אלוקינו װעלן זײ אַנגסטן,</para>
  <para style="q" vid="MIC 7:17">און זײ װעלן מורא האָבן פֿאַר דיר.<verse eid="MIC 7:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="MIC 7:18" />װער איז אַן אֵל װי דו, װאָס פֿאַרגיט זינד,</para>
  <para style="q" vid="MIC 7:18">און גײט פֿאַרבײַ דעם פֿאַרברעך פֿון דעם איבערבלײַב פֿון זײַן אַרב?</para>
  <para style="q" vid="MIC 7:18">ער האַלט נישט אױף אײביק זײַן צאָרן,</para>
  <para style="q" vid="MIC 7:18">װאָרעם ער האָט ליב גענאָד.<verse eid="MIC 7:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="MIC 7:19" />ער װעט אונדז װידער דערבאַרעמען,</para>
  <para style="q" vid="MIC 7:19">ער װעט פֿאַרדריקן אונדזערע זינד;</para>
  <para style="q" vid="MIC 7:19">און װעסט אַרײַנװאַרפֿן אין די טיפֿענישן פֿון ים</para>
  <para style="q" vid="MIC 7:19">אַלע זײערע חטאָים.<verse eid="MIC 7:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="MIC 7:20" />װעסט װײַזן טרײַשאַפֿט צו יעקבֿן,</para>
  <para style="q" vid="MIC 7:20">חֶסֶד צו אבֿרהמען,</para>
  <para style="q" vid="MIC 7:20">װי דו האָסט געשװאָרן אונדזערע עלטערן</para>
  <para style="q" vid="MIC 7:20">פֿון די טעג פֿון פֿאַרצײַטן.<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>