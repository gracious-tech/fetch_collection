<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JON" style="id">- Waghrini Vathe</book>
  <para style="h">ಯೋನ</para>
  <para style="toc3">ಯೋನ</para>
  <para style="toc2">ಯೋನ</para>
  <para style="toc1">ಯೋನ</para>
  <para style="mt2">ಪ್ರವಾದಿಹುಯಿರೊತೆ ಯೋನನು ಗ್ರಂಥ್</para>
  <para style="mt1">ಯೋನ</para>
  <para style="imt">ಪ್ರವಾದಿ ಯೋನನು ಪರಿಚಯಂ</para>
  <para style="ip">ಯೋನನು ಗ್ರಂಥ್ ಪ್ರವಾದಿ ಯೋನ ನಿನೆವೆ ಖ್ಹಾಯೆರ್ನ ಕರ್ಯುತೆ ಕಾಮ್ ನು ಸಮಚರ್ನು ಭರೆಮ. ಬುಜು ಅಲದ ಪ್ರವಾದಿನು ಗ್ರಂಥ್ ತೆಬಿ ಅಲದುಹುಯಿರುಸ್, ಅ ಗ್ರಂಥ್ ದೇವ್ ನು ವಾತೆಖ್ಹುಬಿ ಪ್ರವಾದಿ ಬುಜು ಇನು ಕಾಮ್ ನ ಜಖ್ಹತ್ ಖ್ಹಯಲ್ ರ‍್ಹಕುಕರಸ್. ಯೋನನಿ ಸೇವೆ ಯೆರೋಬಾಮ ಇಸ್ರಾಯೇಲ್‌ನೊ ರಾಜ್ ಹುಯಿರೊತೆ ವಖ್ಹತ್, ಕತೊ ಕಮ್ ಶೆ ಕಮ್ ಕ್ರಿ.ಪೂ. ಆಟ್‍ಖ್ಹೊ ಥು ಖ್ಹಾತ್‍ಖ್ಹೊ ಹಡೈಖ್ಹ್ ಇಸ್‍ವಿ ನ ಮ್ಹೈಯಸ್ ಹುಯುತೆ, ರೈತೊಬಿ ಜ್ಞಾನಂವಳು ಖ್ಹರು ಅ ಗ್ರಂಥ್ ಕೆದೆ ಲಿಕೈರುಸ್ ಕರಿ ಮಲಂ ಕೊಯ್ನಿ. ದೇವ್ ಯೋನನ ನಿನೆವೆ ನು ವಿರೊದಂಖ್ಹು ಬೊಲನ ಬೊಲಿಮೊಕ್ಯೊ, ರೈತೊಬಿ ಯೋನನೆ ದೇವ್ನಿ ವಾತ್ ನ ನಾ ಖ್ಹಮಜ್‍ನು ತಿಮ್ ನಿನೆವೆಖ್ಹು ಅಲದು ಭಜುನ್ ಗಯೊ 1:1-3 ಯೊ ತಾರ್ಷೀಷ್ ಖ್ಹಯೆರ್ನ ಉಳಿಜೈತೆ ಜಹಜ್ ಮ ಛಡ್ಯೊ. ಜಹಜ್ ತಾರ್ಷೀಷ್ ನ ಜವಾನಿ ಬಿಚ್‍ಮ, ದೇವ್ ಮೊಟು ಡುಂಜ್‍ನ ಬೊಲಿಮೊಕ್ಯೊ. ಜಹಜ್ ಚಲವಳು ಇವ್ಣೆ ಖ್ಹರು ಜಖ್ಹತ್ ಡರಿಗಯುಥು ಬುಜು ದೇವ್‍ನು ಛಂಡಲ್ ಶೊಪೋರಕ್ನು ಕರಿ ಇವ್ಣೆ ಯೋನನ ದರ್ಯವ್‍ಮ ಫ್ಹೆಕ್ಯು. ಅ ಹುಯಿಜವದಿನ್ ದೇವ್‍ ಯೋನನ ಗಳನ ಎಕ್ ಮೊಟು ಮಚ್ಲನ ಬೊಲಿಮೊಕ್ಯೊ. ಯೋನನೆ ಪಶ್ಚತ್ತಾಪ್ ಪಡ್ಯೊ ಬುಜು ದೇವ್ ಇನ ಬಚನ ಮ್ಹೆಲ್ಯೊ. ಬಾದ್‌ಮ, ಯೋನನೆ ಇನು ವಿರೊದಂಖ್ಹು ಬೊಲನ ನಿನೆವೆನ ಗಯೊ, ಬುಜು ಖ್ಹಯೆರ್ನು ಖ್ಹರುಅದ್ಮಿ ಪಶ್ಚತ್ತಾಪ್ ಪಡ್ಯು. ದೇವ್ ಗೊರ್ವಳೊ ಹೊಣುಕರಿ ಯೋನನೆ ನಾ ಸೊಚ್ಯೊತೊಬಿ ದೇವ್ ಕೆತ್ರೆ ಗೊರ್ವಳೊ ಕರಿ ಯೋನನು ಗ್ರಂಥ್ ಗಟ್‍ಖ್ಹು ಬೊಲಸ್ 4:2</para>
  <para style="iot">ಯೋನನು ಮ್ಹೈನು ಭಾಗ್</para>
  <para style="io1">1. ಅಧ್ಯಾಯ <char style="ior"><ref loc="JON 1">1</ref> </char> ಯೋನನೆ ದೇವ್ ಖ್ಹು ಮಿಲೈಜೈನ್ ಮಚ್ಲನ ಪೊಟ್‍ಮ ಕಿಮ್ ಖ್ಹಪ್‍ಡಿಗೊ ಕರಿ ಬೊಲಿರಕ್ಯುಸ್.</para>
  <para style="io1">2. ಅಧ್ಯಾಯ <char style="ior"><ref loc="JON 2">2</ref> </char> ಅನಮ ಯೋನನೆ ಮಚ್ಲನ ಪೆಟ್‍ಮ ರ‍್ಹವದಿನ್ ದೇವ್ನ ಕರ್ಯುತೆ ಪ್ರಾರ್ಥನೆ ಅಸ್.</para>
  <para style="io1">3. ಅಧ್ಯಾಯ <char style="ior"><ref loc="JON 3">3</ref> </char> ಅನಮ ಯೋನನೆ ನಿನೆವೆನ ಬೊಲಸ್ ಬುಜು ಖ್ಹಯೆರ್ನು ಅದ್ಮಿ ಪಶ್ಚತ್ತಾಪ್ ಪಡಸ್. ದೇವ್ ಇವ್ಣ ಬಚವ್‍ನು ಕರಿ ಸೊಚಿಲೆಸ್.</para>
  <para style="io1">4. ಅಧ್ಯಾಯ <char style="ior"><ref loc="JON 4">4</ref> </char> ಛಟ್‍ನ ಅ ಅಧ್ಯಾಂಮ ದೇವ್ ನಿನೆವೆನು ಅದ್ಮಿವ್‍ನ ಗೋರ್‌ ವೊತಳ್ತನ ಯೋನನೆ ಛಂಡಲ್ ಕರ್ಯೊ ಬುಜು ದೇವ್ ಯೋನನ ಯೊ ಅಕ್ಕುಸ್ ಅದ್ಮಿವ್ ನ ಲಾಡ್‍ಕರುಸ್ ಕರಿ ಬೊಲಸ್.</para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s">ಯೋನ ದೇವ್ನಿ ವಾತ್ ಖ್ಹಂಜೊ ಕೊಯ್ನಿತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1" />ಎಕ್ ದನ್ನೆ, ಅಮಿತೈ ನೊ ಛಿಯ್ಯೊಹುಯಿರೊತೆ ಯೋನನ ಯೆಹೋವ ದೇವ್ ನು ವಾತೆ ಖ್ಹಂಜಯು. <verse eid="JON 1:1" /><verse number="2" style="v" sid="JON 1:2" />"ನಿನೆವೆ ಕರಿ ಮೊಟು ಖ್ಹಯೆರ್ಮ ರ‍್ಹಾವಳು ಕೆತ್ರೆ ಖರಾಬ್ ವಳು ಕರಿ ಮನ ಮಾಲಂ ಪಡ್ಯು. ತು ಇಜ್ಗ ಜಾ ಇವ್ಣ ಭರೊಬರ್ಥಿ ಭೊಲ್." <verse eid="JON 1:2" /><verse number="3" style="v" sid="JON 1:3" />ರೈತೊಬಿ ಯೋನ ನೆ ಯೆಹೋವ ದೇವ್‍ ನಿ ಸನ್ನಿದಿಮತು ಚುಕೈಲೆನು ಕರಿ ನಿನವೆನ ನಾ ಜವನು ಬದಲ್ ತಾರ್ಷೀಷ್ ಭ್ಹಣಿ ಫರಿನ್ ಮಿಲೈಜನು ಕರಿ ಗಯೊ. ಯೊಪ್ಪಕರಿ, ಗಾಮ್ಮ ಉತ್ರಿನ್ ಜೈನ್, ತಾರ್ಷೀಷ್ ನ ಜಾವಾಳಿ ಎಕ್ ಜಹಾಜ್‍ನ ದೇಕ್ಯೊ. ಯೆಹೋವ ದೇವ್ ನಿ ಸನ್ನಿದಿಥಿ ದೂರ್ ಜನುಕರಿ ಜಹಾಜ್‍ವಳನಿ ಜೊಡ್ಮ ಮೊಲ್ ದಿನ್ ತಾರ್ಷೀಷ್ ನ ಜಾವಾನ ಛಡಿಗಯೊ. <verse eid="JON 1:3" /><verse number="4" style="v" sid="JON 1:4" />ತದೆ ಯೆಹೋವ ದೇವ್ ನೆ ಮೋಟೊ ವಾಯಿರೊನ ದರ್ಯವ್ ಉಪ್ಪರ್ ಅವನಿತರ ಕರ್ರ್ಯೊ. ಬುಜು ಡುಂಜ್ ಅಯುತೆ ರಫಾಟಮ ಜಹಾಜಸ್ ತುಟಿಜಾವಾಂತ್ರ ಹುವ್ವಲಗ್ಯುಥು. <verse eid="JON 1:4" /><verse number="5" style="v" sid="JON 1:5" />ಜಹಾಜ್‍ನ ಚಲವಳು ಡರಿನ್, ಹರ್ ಎಕ್ ಜಣು ಇವ್ಣ-ಇವ್ಣ ದೇವ್ನ ಮದತ್‍ನ ಕಜೆ ಚಿಕ್ರಾಲಗ್ಯು; ಜಹಾಜ್‍ನೊ ವಜನ್ ಕಮ್‍ಹುವ್ವಾದೆ ಕರಿ ಇನಾಮಾನು ರ‍್ಹಾಚು ಪಾಡಿನ್ ದರ‍್ಯಾವ್‌ಮ ಫ್ಹೆಕ್ಯು; ರೈತೊಬಿ ಯೋನ ಜಹಾಜ್‍ನ ಹೆಟ್ ಭೊರ್ ನಿ ನಿಂದರ್‌ಮ ಖ್ಹುತೋಥೊ.<verse eid="JON 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 1:6" />ಅನ ದೆಕ್ಯುತೆ ಜಹಾಜ್‍ನ ಚಲವಳವ್‍ನೊ ಮೊಟೊ ಯೋನಕನ ಅಯಿನ್, ಇನ ವುಟಡಿನ್: “ಶೆಲ ಬಬ ಅರಾಂಖ್ಹು ಅಜ್ಗೊ ಖ್ಹುತೋಸ್ತೆ, ಉಟ್. ತಾರ ದೇವ್ನ ಪ್ರಾರ್ಥನೆ ಕರ್‌, ಯೋತೋಬಿ ಅಪ್ಣ ಉಪ್ಪರ್ ಗೋರ್‌ ವೊತಳಿನ್, ಅಪ್ಣೆ ನಾಶನಂ ನಾ ಕರ್ನುತಿಮ್ ಕರಶ್ ಶುಕಿ," ಕರಿ ಬೊಲ್ಯೊ.<verse eid="JON 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7" />ತದೆ ಜಹಜ್ ಚಲಾವವಳು: “ಅಪ್ಣ ಅಯಿರುಸ್ತೆ ಅ ಮುಸಿಬತ್ ನ ಕರಣಂ ಕೊಣ್? ಅವೊ ಅಪ್ಣೆ ಚೀಟಿ ನಾಖಿನ್ ದೆಖೆ" ಕರಿ ಇವ್ಣ ಇವ್ಣಮಸ್ ವಾತೆ ಬೊಲಿಲಿದು. ಇಮ್ ಕರಮ ಚೀಟಿಮ ಯೋನನು ನಾಮ್‍ ಅಯು. <verse eid="JON 1:7" /><verse number="8" style="v" sid="JON 1:8" />ತದೆ ಜಹಜ್ ಚಲಾವಳು: “ಹಮರ ಉಪ್ಪರ್ ಕ್ಹೆವು ಕರಣಂಖ್ಹು ಅಯು ಅ ಅಪಯಂ. ತರು ಕಾಮ್ ಕ್ಹೆವು? ತು ಕಿಜ್ಗಥೊ ಆಯೊ? ತರು ದೇಖ್ಹ್‌ ಕ್ಹೆವು? ಕೆವ್ಹಿ ಜಾತ್‍ವಾಳೊ?" ಕರಿ ಪುಛಾಯು.<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />ಇನ ಯೋನ ನೆ: "ಮೆ ಇಬ್ರಿಯ ವಳೊ, ದರ್ಯವ್ ಜಮೀನ್‍ನಾಭಿ ಉಬ್‍ಜಾಯೊತೆ ಪರಲೋಕಂನೊ ಯೆಹೋವ ದೇವ್ನ ಡರ್ ಮ ಚಲವಳೊ," ಕರಿ ಬೊಲ್ಯೊ. <verse eid="JON 1:9" /><verse number="10" style="v" sid="JON 1:10" />ತದೆ, ಯೋನ ಯೆಹೋವ ದೇವ್‍ಕಂಥೊ ಮಿಲಯ್ ಆಯೋಹುಯೊ ಕರಿ ಬೊಲ್ಯೊ. ಅನ ಖ್ಹಂಜಿನ್ ಘಣು ಡರಿಗಯು. ತದೆ ಯೋನನ, "ತು ಇಮ್ ಶನ ಕರ‍್ಯೊ!", ಕರಿ ಬೋಲ್ಯು. <verse eid="JON 1:10" /><verse number="11" style="v" sid="JON 1:11" />ತದೆ ಮೋಟೊ ವಾಯಿರೊ ಬುಜುಬಿ ಜಾಖ್ಹಾತ್-ಜಾಖ್ಹತಸ್ ಹುವ್ವಲಗ್ಯುಥೂ. ತದೆ ಇವ್ಣೆ ಯೋನನ, "ಆ ದರ‍್ಯಾವ್ ಶೊಪೊ ಹೋಣುಕತೊ ತುನ ಹಮೆ ಶಾತ್ ಕರ‍್ನು ಬೋಲ್?" ಕರಿ ಬೋಲ್ಯು. <verse eid="JON 1:11" /><verse number="12" style="v" sid="JON 1:12" />ತದೆ ಯೋನನೆ, "ಮನಪಾಡಿನ್ ದರ‍್ಯಾವ್‌ಮ ಫ್ಹೆಖೊ ತದೆ ದರ‍್ಯಾವ್ ಶೊಪೊ ಹುಯಿಜಾಶೆ. ಆ ಮೊಟೊ ವಯಿರೊ ಮಾರಖ್ಹಾಜೇಸ್ ತುಮಾರಪರ್ ಐರ‍್ಹುಸ್ತೆ ಕರಿ ಮನ ಮಲಾಂ," ಕರಿ ಬೊಲ್ಯೊ. <verse eid="JON 1:12" /><verse number="13" style="v" sid="JON 1:13" />ರೈತೊಬಿ ಜಹಾಜ್‍ಮ ರ‍್ಹವಳು ಇನ ಮನ್ಯುಕೊಯ್ನಿ, ಕಿಮ್‍ತೋಬಿ ಕನಾರೆ ಲಿಜಾನುಕರಿ ಕರ‍್ಯುತೋಬಿ ದರ್ಯವ್‌ನೊ ಝೋಕಾಳೊ ಜಾಖ್ಹತ್-ಜಾಖ್ಹತಸ್ ಹುಂಕರ್ತು. ಕನಾರೆ ಆವಾನ ಕೋ ಹುಯುನಿ <verse eid="JON 1:13" /><verse number="14" style="v" sid="JON 1:14" />ಹುಯಿಜವದಿನ್ ಇವ್ಣೆ ಯೆಹೋವ ದೇವ್ನ ಪ್ರಾರ್ಥನೆ ಕರ್ಯು, "ಓ ದೇವ್ ಖ್ಹಮಜ್ ಆ ಅದ್ಮಿನು ಮರಣ್ಣು ಪಾಪ್ ಹಮಾರ ಉಪ್ಪರ್ ನಕೊ ಆವಾದೀಶ್. ಆ ಅಪರಾಧ್ ಕೊಯ್ನಿತೆ ಅದ್ಮಿನ ಮಾರ‍ನು ದೋಷ್‍ನ ಹಮಾರ ಉಪ್ಪರ್ ನಕೊನಾಖಿಶ್. ಓ ದೇವ್ ಆ ಖ್ಹಾರು ಹುಯೂತೆ ತಾರೀಸ್ ಇಚ್ಚಾಥಿ", ಕರಿ ಪ್ರಾರ್ಥನೆ ಕರ್ಯು. <verse eid="JON 1:14" /><verse number="15" style="v" sid="JON 1:15" />ಬಾದ್‌ಮಾ ಯೋನನ ಪಾಡಿನ್ ದರ‍್ಯಾವ್‌ಮ ನಾಖಿದಿದು. ತದೆ ದರ‍್ಯಾವ್ ಶೊಪೊ ಹುಯುಗಯೊ. <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />ಅನೇಥಿ ಜಹಜ್‌ಮ ಥೂತೆ ಅದ್ಮಿಮ ದೇವ್ನ ಡರಿಗಯು. ಇವ್ಣೆ ಯೆಹೋವಾಸ್ ಖ್ಹಾಚೊ ದೇವ್ ಕರಿ ನಂಬಿನ್ ಬಲಿಛಡಾಯು. ಬುಜು ಯೆಹೋವ ದೇವ್‌ನಾಸ್ ಡರಿನ್ ಜಿವ್‌ಶು ಕರಿ ಕಬೂಲ್ ಲಿಲಿದು. <verse eid="JON 1:16" /><verse number="17" style="v" sid="JON 1:17" />ಹಂಕಡ್ ಯೋನನ ಗಳನಖ್ಹಾಜೆ ಯೆಹೋವ ದೇವ್ನೆ ಏಕ್‌ ಮೋಟ ಮಾಚ್ಲನ ಮೋಕ್‌ಲ್ಯೊ. ಯೊ ಮಾಛ್ಲಾನ ಪೇಟ್‌ಮಾ ಯೋನ ತೀನ್ ದನ್ ತೀನ್ ರಾತ್ ಥೊ.<verse eid="JON 1:17" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="s">ಯೋನನಿ ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1" />ಮಾಚ್ಲನ ಪೇಟ್‍ಮಾಥೊ ಯೋನ ಇನೊ ಯೆಹೋವಾ ದೇವ್ ಯಾದ್‌ಕರಿನ್ ಅಮ್ ಪ್ರಾರ್ಥನೆ ಕರ‍್ಯೊ.<verse eid="JON 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JON 2:2" />“ಮಾರಿ ಖ್ಹತಾವ್‌ಣಿಮ ಯೆಹೋವ ದೇವ್ನ ಪ್ರಾರ್ಥನೆ ಕರ‍್ಯೊ,</para>
  <para style="q2" vid="JON 2:2">ಇನೆ ಖ್ಹಂಜಿಲಿದೊ. ಪಾತಾಳಂನಮ್ಹೈತು ಮದತ್ ಮಾಂಗ್ಯೊ.</para>
  <para style="q2" vid="JON 2:2">ಮಾರಿ ಪ್ರಾರ್ಥನೆ ತು ಖ್ಹಂಜೊ.<verse eid="JON 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3" />ತುಸ್ ಮನ ಗಧಾರ್‌ಮ ಫೆಕಿರಕ್ಯೊಸ್.</para>
  <para style="q2" vid="JON 2:3">ತುಸ್ ಮನ ದರ‍್ಯಾವ್‍ನು ಗರ್ಬಮ್ಮ ಫೆಕಿರಕ್ಯೊಸ್.</para>
  <para style="q2" vid="JON 2:3">ಕೆತ್ರೊಕ್ಕಿ ತಾರೊ ದರ್ಯವ್‌ನೊ ಪ್ರವಾಹಂ ಮರ ಅಶ್ ಪಿಶ್ ಚಾ;</para>
  <para style="q2" vid="JON 2:3">ಜೊರೆಖ್ಹು ದರ್ಯವ್‌ನೊ ಡರವನು ಅವಜ್ ಬುಜು ಕೆತ್ರೊಕ್ಕಿ ಝೋಕಾಳೊಖ್ಹರು ಮರ ಉಪ್ಪರ್ ಉಳುಜಸ್!<verse eid="JON 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4" />ತಾರ ಸನ್ನಿದಿಮತು ಮೆ ದಕ್‍ಲೈಗೊ ಕರಿ ಸೊಚಿಲ್‍ದೊ</para>
  <para style="q2" vid="JON 2:4">ರೈತೊಬಿ ಮೆ ತಾರಿ ಪವಿತ್ರ ಮಂದಿರ್‌ಮ ಪಾಛೊ಼ ಡೊಳಪಡಿನ್ ದೆಖುಸ್.<verse eid="JON 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5" />ಪಾಣಿಮ ಡುಬಿನ್ ಮಾರೊ ಜಾನ್‌ ಜಾವಾನ ಆಯೊಥೊ.</para>
  <para style="q2" vid="JON 2:5">ದರ‍್ಯಾವ್ ಮಾರ ಉಪ್ಪರ್ ಮೂಚಯಿರ‍್ಹೊಥೊ.</para>
  <para style="q2" vid="JON 2:5">ಮಾರ ಮಾಥಪರ್‌ ಕಾಂಝಿ ಲೋಥಯ್‌ರ್‍ಹುಥೂ,<verse eid="JON 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6" />ಫಾಡ್‍ಣ ಜಡ್‍ಮ ಮೆ ಥೊ.</para>
  <para style="q2" vid="JON 2:6">ಮುಚೈಗಯು ಕದೇ ಕದೇಬಿ ಜಮೀನ್‌ನು ದರ್ವಾಜು ಖ್ಹರು ಮಾರ ಪೀಠೆ.</para>
  <para style="q2" vid="JON 2:6">ರೈತೊಬಿ ತು ಮನ ಬಚಯೊ ಗದರ್ ಮತು</para>
  <para style="q2" vid="JON 2:6">ಓ ಮಾರೊ ದೇವ್ ಯೆಹೋವ<verse eid="JON 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7" />ಮಾರೊ ಜಾನ್‌ ಮಾರಾಮತು ನಿಕ್ಳಿಗಯೊ ಕರಿ ಸೊಚ್ಯೊ</para>
  <para style="q2" vid="JON 2:7">ದೇವ್ ಯೆಹೋವ ಮೇ ತುನ ಪ್ರಾರ್ಥನೆ ಕರುಸ್,</para>
  <para style="q2" vid="JON 2:7">ತಾರಿ ಪವಿತ್ರ ಮಂದಿರ್‌ಮ.</para>
  <para style="q2" vid="JON 2:7">ತದೆ ಮಾರಿ ಪ್ರಾರ್ಥನೆ ನ ತು ಖ್ಹಂಜಿಲಿದೊ.<verse eid="JON 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8" />ಜ್ಹುಟಿ ವಿಗ್ರಹಂ ನ ಪುಜಕರವಳು</para>
  <para style="q2" vid="JON 2:8">ಇವ್ಣೆ ಗೋರ್‌ನ ದಕ್ಲಿದೆವಳು<verse eid="JON 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9" />ಮೆತೋಬಿ ತುನ ಗಿದ್ ಬೊಲಿನ್ ಉಂಚೊ ಅವಜ್ ಥಿ ಖ್ಹರೈನ್ ಬಲಿ ದೀಶ್.</para>
  <para style="q2" vid="JON 2:9">ಮೆ ತುನ ಕರಿರಕ್ಯೊಸ್ತೆ ಕಬೂಲ್ ನ ಕರುಸ್</para>
  <para style="q2" vid="JON 2:9">ಯೆಹೋವ ದೇವ್‌ ಥೀಸ್ ಮನ ಜಿತ್‍ಮಳ್‍ಶೆ."<verse eid="JON 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JON 2:10" />ತದೆ ಯೆಹೋವ ದೇವ್ನೆ ಮಾಚ್ಲನ ಹುಕುಮ್ ದಿನ್, ಯೋನನ ಕನಾರೆಲಾಯಿನ್ ಬಹರ್ ಓಕ್ರಿದಿದು.<verse eid="JON 2:10" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s">ಯೋನ ದೇವ್ನಿ ವಾತೆ ಖ್ಹಂಜೊತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />ಯೋನನ ಯೆಹೋವ ದೇವ್ ನಿ ವಾತೆ ಫಚು ಖ್ಹಂಜಯುತೆ: <verse eid="JON 3:1" /><verse number="2" style="v" sid="JON 3:2" />ಯೆಹೋವ ದೇವ್ ಯೋನನ, "ತೂ ಉಠೀನ್ ಯೊ ಮೊಟು ಖ್ಹಯೆರ್ ನಿನೆವೆನ ಜಾ. ಜಯ್‌ನ್ ಮೇ ಬೋಲುಸ್ತೆ ವಾತ್ನ ಅದ್ಮಿವ್‍ನ ಬೋಲ್," ಕರಿ ಬೊಲ್ಯೊ. <verse eid="JON 3:2" /><verse number="3" style="v" sid="JON 3:3" />ಯೆಹೋವ ದೇವ್ನೆ ಕಿಮ್ ಬೋಲ್ಯೊಕಿ ಇಮ್ಮಸ್ ಯೋನ ನಿನೆವೆ ಖ್ಹಯೆರ್ ನ ಗಯೋ. ಯೊ ಖ್ಹಯೆರ್ ತೀನ್ ರೋಜ್‌ನಿ ಚಾಲ್ ಎವ್ಡು ಮೊಟು ಖ್ಹಯೆರ್ ಹುಯಿರುಸ್. <verse eid="JON 3:3" /><verse number="4" style="v" sid="JON 3:4" />ಯೋನ ನಿನೆವೆ ಖ್ಹಯೆರ್ ಮಾಕರಿ ಎಕ್ ರೋಜ್‌ನಿ ಚಾಲ್ ಎವ್ಡು ಚಾಲಿನ್ ಜೈನ್ ಅ ಹುಯಿಜವದಿನ್ ಯೋನ ಯೆಹೋವ ದೇವ್ನಿ ವಾತೆ ನ ಬೊಲ್ತೊ, “ಖ್ಹಾರ ಅದ್ಮಿ, ಖ್ಹಂಜೊ: ಆ ಖ್ಹಯೆರ್ನ ಚಾಳಿಖ್ಹ್ ರೋಜ್‌ನ ಪಾರ್ ಯೆಹೋವ ದೇವ್ ನಾಶನಂ ಕರ್ಶೆ,” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="JON 3:4" /><verse number="5" style="v" sid="JON 3:5" />ನಿನೆವೆವಾಳು ದೇವ್ನಿ ಯೊ ವಾತೆನ ನಂಬ್ಯು. ಹರ್ ಎಕ್ ಜಣು ಉಪಾಸ್ ರ‍್ಹನು ಕರಿ ವಾತೆ ಬೊಲಿಲಿದು. ಅಡ್ಡಾಣಿಥು ಧರೀನ್ ಶಾಣತೋಡಿ ಅಕ್ಕುಸ್ ಜಣು ಎಕ್ಕಸ್ ದಿಲ್‍ಖ್ಹು ಘುಂಗ್‌ಡಿ ಖ್ಹು ಲಪೇಟಿಲಿದು. <verse eid="JON 3:5" /><verse number="6" style="v" sid="JON 3:6" />ಆ ಪುಕಾರ್‌ನ ನಿನೆವೆನೊ ರಾಜಾನ ಖ್ಹಂಜಯು. ಯೊ ರಾಜಾನಿ ಕುರ್ಚಿ ಥು ಉತ್ರಿನ್, ಇನು ರಾಜ್ ನು ಪೇರಖ್ಹೊನ ಉತಾರೀನ್, ಘುಂಗ್‌ಡಿ ನ ಹೊಡಿಲಿನ್ ರಾಕ್‌ಮ ಬೇಶಿಗಯೊ. <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />ತದೆ ನಿನೆವೆನು ಅದ್ಮಿವ್ ನ ಎಕ್ ರಾಜಾನಿ ಹುಕುಮ್‌ ದಿದೊ, “ನಿನೆವೆನು ಅಖ್ಖುಸ್ ಅದ್ಮಿರ‍್ಹಾವೊ, ಢಾಂಡು-ಗಯಿನ ಚೆಲ್ಕರ‍್ಹಾವೊ, ಬೊಕ್ಡ-ಮ್ಹೆಂಡರ‍್ಹಾವೊ, ಖಣುಪಾಣಿ ನಾ ಪಿನು. <verse eid="JON 3:7" /><verse number="8" style="v" sid="JON 3:8" />ಅಖ್ಖುಸ್ ಅದ್ಮಿಖ್ಹರು ಘುಂಗ್‌ಡಿ ನ ಹೊಡಿಲಿನ್ ಜಿನವರ್ನಬಿ ಹೊಡವ್ ನು. ದೇವ್ನ ಗಟ್‍ಖ್ಹು ಪ್ರಾರ್ಥನೆ ಕರ್‌ನು. ಹರ್‌ ಎಕ್ ಜಣು ಖರಾಬ್ ವಾಟ್‌ಮಾಥು ಫರೊ, ಮಾರ್ ತೋಡ್ ಖ್ಹಾರು ಮ್ಹೆಲಿದೆವಾದೆ. <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />ಕಿನ ಮಲಾಂ, ಅಮ್ ಕರ‍್ಯಾತೊ ಎಕ್ ವಳಿ ದೇವ್ ನು ಮನಸ್ ಫರೈನ್, ಗೋರ್‌ ಕರೀನ್ ಇನೊ ಇರಾದೊ ಮ್ಹೆಲಿನ್, ಅಪ್ಣ ನಾಶಂ ನಾ ಕರ್ನುತಿಮ್ ಬಚಾವಜೈ." <verse eid="JON 3:9" /><verse number="10" style="v" sid="JON 3:10" />ನಿನೆವೆ ಖ್ಹಯೆರ್‌ವಾಳು ಇವ್ಣ ಖರಾಬ್ ವಾಟ್‌ಮಾಥು ಫರಿಗಯುತೆ ದೇವ್ನೆ ದೇಖ್ಯೋ. ದೇಖಿನ್‌ ಗೋರ್‌ಕರೀನ್ ಇವ್ಣ ದೆವನುಥುತೆ ವದಖ್ಹೊ ನಾ ದೆನುತಿಮ್ ಕರ್ಯೊ.<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s">ಯೋನನು ಇರಾದೊ-ದೇವ್ ನು ಗೋರ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />ಅನಖ್ಹಾಜೆ ಯೋನನ ಘಣು ಬೇಜಾರ್ ಹುಯು. ಬುಜು ಇರಾದೊಬಿ ಆಯೊ. <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" />ಇನಖ್ಹಾಜೆ ಯೋನನೆ ಯೆಹೋವಾನ ಪ್ರಾರ್ಥನೆ ಕರೀನ್, "ಮೆ ಮಾರ ದೇಖ್ಹ್‌ಮ ಥೊ ತದೇಸ್‌ ಅಮ್ ಉಷೆಕರಿ ತುನ ಬೋಲ್ಯೊಥೊ.ತು ಗೋರ್ ಬಿ, ದಯಾಬಿ, ಶಾಂಥಿ ಕದೇಬಿರ‍್ಹವಾಳೊ, ಕದೇಬಿ ಆರ್‌ಗೋರ್‌ ಕರಾವಾಳೊ, ಬುಜು ದಯಾ ಕರಾವಾಳೊ ಕರಿ ಮಾಲೂಮ್‌ಕರೀಸ್‌ನ ಮೇ ತಾರ್ಷೀಷ್ ಖ್ಹಯೇರ್ ಭಣಿ ಮಿಲಾಯ್‌ ಗಯೋಥೊತೆ. <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />ಹಂಕ್ಕೆ ಯೆಹೋವ ಮಾರೊ ದೇವ್ ಮಾರೊ ಜಾನ್‌ ಕಳ್ಳೆ, ಮೆ ಬಚಿರ‍್ಹವಾಥಿಬಿ ಮರಿಜವಾನೂಸ್ ಅಛ್ಛು" ಕರಿ ಬೊಲಿಲಿದೊ. <verse eid="JON 4:3" /><verse number="4" style="v" sid="JON 4:4" />ತದೆ ಯೆಹೋವ ನೆ,"ತು ಇರಾದೊಕರಾನು ಬರೋಬರ್ ನಾ?" ಕರಿ ಬೊಲ್ಯೊ. <verse eid="JON 4:4" /><verse number="5" style="v" sid="JON 4:5" />ಅನ ಬಾದ್‌ಮ ಯೋನನೆ ಖ್ಹಯೆರ್ನ ಮ್ಹೆಲಿನ್ ದನ್ ನಿಕ್‍ಳಸ್ತೆ ಬಜುನ್ ಜಯಿನ್ ಎಕ್ ಜೊಪ್ಡಿನ ನಾಖಿನ್ ಇನ ಹೇಟ್ ಬೇಶಿನ್ ಖ್ಹಯೆರ್ನ ಶಾತ್ ಹುವಸ್‌ಕರಿ ದೇಖುಕರ್‌ತೊಥೊ. <verse eid="JON 4:5" /><verse number="6" style="v" sid="JON 4:6" />ತದೆ ಯೆಹೋವ ದೇವ್ನೆ ಯೋನನ ಅರಾಮ್ ದ್ಯವಾನಖ್ಹಾಜೆ ಎಕ್ ಎಲೊನ ಫೊಟನಿತರ ಕರ್ಯೊ. ಯೊ ಫುಟಿನ್ ಮಾಥಪರ್‌ ಛಾಳೊ ಬುಜು ಮನಸ್ ನ ಅರಾಂ ಮಳ್ಯು. ಯೋನನ ಘಣು ಖ್ಹುಶಿ ಹುಯು. <verse eid="JON 4:6" /><verse number="7" style="v" sid="JON 4:7" />ರೈತೊಬಿ ಇನ ವ್ಹಾಣೆಲ್ಯೊ ದನ್ಮ ದೇವ್ನೆ ಎಕ್ ಕಿಡುನ ಎಲೊಮ ಕಲ್ಡನ ಮ್ಹೆಲ್ಯೊ. ತದೆ ಯೊ ಎಲೊ ಖ್ಹುಕಾಯ್‌ಗಯು. <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />ದನ್ ಉಪ್ಪರ್ ಚಡ್ತೊ ಅವಮ, ದೇವ್ನು ಚಿತ್ತಂಖ್ಹು ದನ್ ನಿಕ್ಳಾನಿ ತರಪ್‌ಥೂ ಗರಮ್‌ ವಾಯಿರೊ ಅಯು, ತಡ್ಕೊ ಯೋನನ ಮಾಥಪರ್‌ ಮಾರ್‌ಪಡ್‌ತಾಖ್ಹತರ್‌ ಇನ ಡೋಳ ಫರನೀತರ ಹುಯು. ಯೊ ಮರ್‌ನುಕರಿ ಆಖ್ಹ್‌ಕರಿನ್, "ಮೆ ಜಿವಾಥಿಬಿ ಮರಿಜವಾನೂಸ್ ಅಛ್ಛು಼" ಕರಿ ಬೋಲಿಲಿದೊ. <verse eid="JON 4:8" /><verse number="9" style="v" sid="JON 4:9" />ಇನ ದೇವ್ನೆ: "ತೂ ಎಲೊನ ಖ್ಹಾಜೆ ಇರಾದೊ ಕರಾನು ಬರೊಬರ್‌ ನಾ"? ಕರಿ ಪುಚನಮ. ಯೋನನೆ, "ಹೊ, ಮರಣ್ ಅವನಿತರ ಇರಾದೊ ಕರಾನು ಬರೊಬರ್ ಖಯೆನಾ" ಕರಿ ಜವಾಬ್‌ ದಿದೊ. <verse eid="JON 4:9" /><verse number="10" style="v" sid="JON 4:10" />ತದೆ ಯೆಹೋವ ದೇವ್ನೆ, "ತು ಯೊ ಎಲೊನ ಮ್ಹಿನತ್ ಕರ‍್ಯೊಕೊಯ್ನಿ ಪಾಳ್ಯೋ ಕೊಯ್ನಿ, ಯೊ ಎಕ್ ರಾತ್ಮ ಫುಟಿನ್ ಎಕ್ ರಾತ್ಮ ಮರಿಗಯು. ಇನಖ್ಹಜೆ ತುನ ಅತ್ರೆ ಗೋರ್‌ ನಾ <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />ಯೊ ಎಲೊನ ಖ್ಹಾಜೆ ಅತ್ರೆ ಗೋರ್‌ಕರಾಪರ್, ಖ್ಹಚ ಜುಟಿ ಮಾಲಂ ಕೊಯ್ನಿತೆ ಎಕ್ ಲಾಕ್ ಇಖ್ಹ್‌ ಹಜಾರ್ ಅದ್ಮಿ, ಜಿನಾವರ್ ಛಾತೆ ಯೊ ಮೊಟು ಖ್ಹಯೆರ್ ನಿನೆವೆನ ಖ್ಹಾಜೆ ಮೇ ಶನ ಗೋರ್‌ ನಾ ಕರ್‌ನು? ಕರಿ ಬೊಲ್ಯೊ.<verse eid="JON 4:11" /></para>
  <chapter eid="JON 4" />
</usx>