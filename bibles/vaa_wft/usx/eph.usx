<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EPH" style="id">-WAGHRI</book>
  <para style="h">ಎಫೆಸ</para>
  <para style="toc3">ಎಫೆಸ</para>
  <para style="toc2">ಎಫೆಸ</para>
  <para style="toc1">ಪೌಲನೆ ಎಫೆಸವಾಳಾನ ಲೀಖ್ಯೋತೆ ಚಿಟ್ಟಿ</para>
  <para style="mt2">ಎಫೆಸದವರಿಗೆ ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="mt1">ಪೌಲನೆ ಎಫೆಸವಾಳನ ಲೀಖ್ಯೋತೆ ಚಿಟ್ಟಿ</para>
  <para style="imt">ಮಾಲುಮ್‌ ಕರಾನು</para>
  <para style="ip">ಎಫೆಸವಾಳನ ಲೀಖ್ಯೋತೆ ಚಿಟ್ಟಿ ಕ್ರಿಸ್ತನ ಪೈದಾಖ್ಹ್‌ನ ವಾರ್ ಘಣೇಥಿ ತೀನಿಖ್ಹ್‌ ವರಖ್ಹ್‌ನಿ ಉಂಬರ್‌ಮ ಲಿಖೈರ‍್ಹುಸ್. ಕೊಲೊಸ್ಸೆವಾಳಾನ ಲೀಖಾಯುತೆ ಚಿಟ್ಟಿಬಿ ಆ ವೇಳ್ಮ ಲೀಖೈರುಸ್. ಲೀಖಾಪಟ್ ಕರಾವಾಳೊ ಮೆ ಅಪೊಸ್ತಲ ಪೌಲಕರಿ ಪರಿಚಯ್ ಕರಸ್ <char style="xt"><ref loc="EPH 1:1">1:1</ref></char> ಕೊಲೊಸ್ಸೆನು ಚಿಟ್ಟೀಮ ರ‍್ಹೆಯಿತೆ ತಿಮ್ ಶೊಂತ್ ಖ್ಹಲಾಮ್ನ ಎಫೆಸಮ ಲೀಖ್ಯೋತೆ ಚಿಟ್ಟೀಮ ದೆಖಾಯುನಾತೋಬಿ ಘಣೇಥಿ ಲೀಖಾಪಟ್ ಕರವಾಳು ಪೌಲನೆ ಲೀಖಿರಾಖ್ಯೊಸ್ ಕರಿ ಮಾನಿಲೇಸ್. ಆ ಕಾರಣ್‍ಥಿ ಆ ಚಿಟ್ಟಿ ಯೊ ತಬರ್‌ಖಾಮ ಕೈಯೇಕ್ ಸಬೆನ ಫೈಲಾಯು ಉಷೆ. ಪೌಲನೆ ಆ ಚಿಟ್ಟಿ ಲಿಖಾನಿವಖ್ಹ್‌ತೆ ಇನೆ ಖ್ಹಾರ್ಕೊಟ್‌ಮ ಛೂ಼ ಕರಿ ಪೌಲ ಬೋಲಸ್<char style="xt"><ref loc="EPH 3:1">3:1</ref></char>, <char style="xt"><ref loc="EPH 4:1">4:1</ref></char>, <char style="xt"><ref loc="EPH 6:20">6:20</ref></char> ಪೌಲನೆ ಆ ಚಿಟ್ಟಿ ಎಫೆಸನಿ ಸಬೆನ ತುಕಿಕನ ಭೇಟಿ ಕರಾನಿ ವೇಳ್ಮ ತುಕಿಕನ ಹಾತ್ಮ ದಿಮೋಕ್‍ಲ್ಯೊ. <char style="xt"><ref loc="EPH 6:21-22">6:21-22</ref></char> ಎಫೆಸ ಖ್ಹಯೇರ್ ಏಕ್‌ ಮೋಟು ಖ್ಹಯೇರ್ ಹುಯು ಯೋ ರೋಮ್ ಸಾಮ್ರಾಜ್ಯನು ಏಷ್ಯಾನ ಮೈಹಿನ ತಬರ್‌ಖಾನು ರಾಜಧಾನಿ ಹುಯಿರೂಥು ಎಫೆಸ ಖ್ಹಯೇರ್ ಗ್ರೀಕ್ ದೇವ್‍ಥಿ ಹುಯಿರ‍್ಹಿಥೀತೆ ಆರ್ತೆಮೀಸ್‍ನು ದೇವಸ್ಥಾನ್‍ಥಿ ಎಫೆಸ ಪ್ರಸಿದ್ ಹುಯಿರ‍್ಹುಥು. <char style="xt"><ref loc="ACT 19:23-31">ಅಪೊ 19:23-31</ref></char> ಎಫೆಸನಿ ಸಬೆ ಶುರುವಾತ್ ಹುಯುತದೆ ಯೊ ಘಟ್‍ರ‍್ಹೀನ್, ಕತೋಬಿ ಇನಪಾರ್ ಯೊ ಭಂದೈನ್ ಖ್ಹರ್ತಿಹುವಾನಿ ಟಪ್ಪೊಹುಯಿರುಥು <char style="xt"><ref loc="REV 2:1-7">ಪ್ರಕಾಶಿತ್ 2:1-7</ref></char> ಪೌಲನಿ ಲೀಖಾವನಿ ಆಧಿ ಚಿಟ್ಟಿಮಾಸ್ ದೇವ್ನೆ ಇನ ಅದ್ಮಿವೋನ ಕಿಮ್ ಚೂ಼ಣಿಲಿದೊ ಅಜು಼ ಯೇಸು ಕ್ರಿಸ್ತಥಿ ಇವ್ಣಿ ಪಾಪ್‌ಥಿ ಇನೆ ಕಿಮ್ ಛೋ಼ಡಾಯೊ ಕರಿ ಬಾರೇಮ ಬೋಲಸ್. ಯೊ ಸಬೆ ಕ್ರಿಸ್ತನು ಶರೀರ್ ಅಜು಼ ಕ್ರಿಸ್ತ ಇನು ಮುಡ್‌ಕ್ಯು ಹುಯಿರೊಸ್, ಅಜು಼ ಕ್ರಿಸ್ತ ಘರ್‌ನೊ ಮುಖ್ಯ ಕೋಣಾನೊ ಬಂಡೊ ಕರಿ ಬೋಲಾನು ಪರಕ್‍ಥಿ ಬೋಲಸ್. ಆ ಚಿಟ್ಟಿನ ಬಿಜ಼ ಆಧಾಭಾಗ್ಮ ಪೌಲನೆ ಕ್ರಿಸ್ತನಿ ಜಿವ್ಣಾಮ ಅಪ್ಣೆ ಕಿಮ್ ಜಿವ್ಣು ಕರ್ನುಕರಿ ಖ್ಹೂಜ಼್ ದೇಸ್.</para>
  <para style="iot">ಕಾಡಿದೇಖೊ</para>
  <para style="io1">1. ಪೌಲನೆ ಇನಿ ಪರಿಚಯ್ ಕರ್ತೊಹುಯಿನ್ ಎಫೆಸವಾಳನ ಖ್ಹಲಾಮ್ ಕರಸ್.<char style="ior"><ref loc="EPH 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. ಇನಕೇಡೆಥು ಯೋ ಕ್ರಿಸ್ತಮ ಸಬೆಅಖ್ಖಾನಿ ಸಂಭಂದಾನಿ ಬಾರೇಮ ಬೋಲಾಸ್. <char style="ior"><ref loc="EPH 1:3-3:21">1:3—3:21</ref></char></para>
  <para style="io1">3. ಇನ ಕೇಡೆಥು ಪೌಲನೆ ವಿಶ್ವಾಸಿ ಖ್ಹಾರು ಕಿಮ್ ಜಿವ್ಣು ಕರ‍್ನು ಕರಿ ಬಾರೇಮ ಲಿಖಸ್. <char style="ior"><ref loc="EPH 4:1-6:20">4:1—6:2೦</ref></char></para>
  <para style="io1">4. ಖ್ಹರ್ತಿಮ ಪೌಲ ಥೋಡಿ ಕಡ್‌ಶೀನು ಖ್ಹೂಜ಼್ ದೇಸ್. <char style="ior"><ref loc="EPH 6:21-24">6:21-24</ref></char></para>
  <chapter number="1" style="c" sid="EPH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1"/>ದೇವ್ನಿ ಗಳ್‌ಜೋ಼ಡ್ಮ ಕ್ರಿಸ್ತ ಯೇಸುಮ ಅಪೊಸ್ತಲ ಹುಯಿರ‍್ಹೋಸ್ತೆ ಪೌಲ, ಎಫೆಸಮ ಛೇತೆ ದೇವ್ನ ಅದ್ಮಿನಾಬಿ, ವಿಶ್ವಾಸ್‌ವಾಳನಾಬಿ ಲಿಖಾನು ಶಾತ್‍ಕತೊ, <verse eid="EPH 1:1"/><verse number="2" style="v" sid="EPH 1:2"/>ಅಪ್ಣೊ ಬಾ ಹುಯಿರ‍್ಹೋತೆ ದೇವ್‌ಥಿಬಿ ಪ್ರಭು ಹುಯಿರ‍್ಹೋತೆ ಯೇಸು ಕ್ರಿಸ್ತಥಿಬಿ ತುಮುನ ವಾರ್‌ಖ್ಹೊಬಿ ಶಾಂತಿಬಿ ಮಳಾದೆ.<verse eid="EPH 1:2"/></para>
  <para style="s">ಕ್ರಿಸ್ತಮ ಛಾ಼ತೆ ಆತ್ಮೀಕ್ ಆಶೀರ್ವಾದ್‌ಖ್ಹಾರು</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3"/>ಅಪ್ಣೊ ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತನೊ ದೇವ್‌ಬಿ ಅಜು಼ ಬಾ ಹುಯಿರ‍್ಹೋತೆ ಇನ ಧನ್ಯವಾದ್ ಹುವಾದೆ, ಕ್ರಿಸ್ತನಿ ಗಳ್‌ಜೋ಼ಡ್ಮ ಇನೆ ಪರಲೋಕ್‍ಮ ಛಾ಼ತೆ ಹರೇಕ್ ಆತ್ಮೀಕ್ ಆಶೀರ್ವಾದ್‌ಖ್ಹಾರು ಅಪ್ಣುನ ದಿರಾಖ್ಯೊಸ್. <verse eid="EPH 1:3"/><verse number="4" style="v" sid="EPH 1:4"/>ಜಗತ್‌ ಉಬ್‌ಜಾ಼ತಿ ಪಹಿಲೇಸ್ ಅಪ್ಣೆ ಇನಖ್ಹಾಮ್ಣೆ ಪರಿಶುದ್ಧಬಿ ದೋಷ್‌ಕೊಂತೇಬಿ ಹುಯಿರ‍್ಹೇಣು ಕರಿ ದೇವ್ನೆ ಕ್ರಿಸ್ತನಿ ಗಳ್‌ಜೋ಼ಡ್ಮ ಅಪ್ಣುನ ಚೂ಼ಣಿಲಿದೊ. ಶನಕತೊ ಆ ಇನಿ ಪ್ಯಾರ್ ಹುಯಿರ‍್ಹಿಸ್. <verse eid="EPH 1:4"/><verse number="5" style="v" sid="EPH 1:5"/>ದೇವ್ ಫೈಲೆಥೊಸ್ ಯೇಸು ಕ್ರಿಸ್ತಥಿಸ್ ಅಪ್ಣುನ ಇನ ಲಡ್ಕಕರಿ ಬಣೈನ್ ಸ್ವೀಕಾರ್ ಕರಾನಖ್ಹಾಜೆ ಚೂ಼ಣಿಲಿದೊ. ಯೊ ಇನಿ ಖ್ಹೂಜ಼್ ಹುಯಿರ‍್ಹಿಥಿ ಇನಿ ಖ್ಹಯಾಲ್‍ಬಿ ಹುಯಿರ‍್ಹಿಥಿ. <verse eid="EPH 1:5"/><verse number="6" style="v" sid="EPH 1:6"/>ಅಜು಼ ಅಪ್ಣೆ ದೇವ್ನಿ ಮಹಿಮೆನಿ ವಾರ್‌ಖ್ಹಾನಖ್ಹಾಜೆ ಧನ್ಯವಾದ್ ಕರಿಯೆ. ಶನಕತೊ ಯೋ ಇನೊ ಪ್ಯಾರ‍್ನೊ ಛಿಯ್ಯಾನಖ್ಹಾಜೆ ಅಪ್ಣುನ ಫುಗಟ್ ವರದಾನ್ ದಿರಾಖ್ಯೊಸ್. <verse eid="EPH 1:6"/><verse number="7" style="v" sid="EPH 1:7"/>ಯೇಸು ಕ್ರಿಸ್ತನೆ ಅಪ್ಣಖ್ಹಾಜೆ ರಂಚ್ಯೊತೆ ಲ್ಹೋಯಿಥೀಸ್‍ ಛುಟ್ಕಾರ್‌ಹುಯು, ಕತೊ ದೇವ್ನಿ ಮಹಾ ವಾರ್‌ಖ್ಹೇಥಿಸ್ ಅಪ್ಣು ಪಾಪ್‌ಖ್ಹಾರು ಮಾಪಿ ಹುಯಿಗು. <verse eid="EPH 1:7"/><verse number="8" style="v" sid="EPH 1:8"/>ದೇವ್ನೆ ಇನಿ ಹರೇಕ್ ಗ್ಯಾನ್ ಅಜು಼ ಅಕ್ಕಲ್‍ಥಿ ಅಪ್ಣುನ ಯೊ ವಾರ್‌ಖ್ಹಾನ ಚೆಹೆಳ್‌ಥಿ ದಿರಾಖ್ಯೊಸ್. <verse eid="EPH 1:8"/><verse number="9" style="v" sid="EPH 1:9"/>ದೇವ್ ಇನೆ ಖ್ಹೂಜ಼್ ಕರ‍್ಯೊತೆ ಇನ ಕರ‍್ಯೊ, ಅಜು಼ ಕ್ರಿಸ್ತನ ಖ್ಹಾಜೇಥಿ ತದೇಸ್‌ ಪೂರಹುವನ ಖ್ಹಾಜೆ ತೀರ್ಮಾನ್ ಕರಿರಾಖ್ಯೊತೆ ಇನಿ ಗಪ್ಲತ್‌ನಿ ಖ್ಹೂಜ಼್‌ನ ಅಪ್ಣುನ ಮಾಲುಮ್‌ ಕರಾಯೊ. <verse eid="EPH 1:9"/><verse number="10" style="v" sid="EPH 1:10"/>ಆ ಖ್ಹೂಜ಼್‌ನ ಬರೊಬರ‍್ನಿ ವಖ್ಹತ್‌ಮ ಪೂರಕರಸ್‍. ಖ್ಹಾರಿ ಉಬ್‍ಜಾ಼ವ್ಣಿ ಧರ್ತಿಬಿ ಪರಲೋಕ್‌ಮ ಕ್ರಿಸ್ತನ ಮುಡ್‌ಕ್ಯು ಕರಿ ಬಣೈನ್ ಎಕ್ಟು ಕರ್ಶೆ. <verse eid="EPH 1:10"/><verse number="11" style="v" sid="EPH 1:11"/>ಖ್ಹಾರು ಕಾಮ್ ದೇವ್ನಿ ಮನ್ನಿ ತರಿಖಾಥಿ ಬಣೈಗಯು ಅಜು಼ ದೇವ್ ಅಪ್ಣುನ ಇನಿ ಶೊಂತ್ ಖ್ಹೂಜ಼್‌ನಿತರ ಪಹಿಲೇಸ್ ನೇಮಕ್‌ಹುಯಿರ‍್ಹಾತೆ ಅಪ್ಣುನ ಕ್ರಿಸ್ತನಿ ಘಳ್‍ಜೋಡ್ಮ ಇನ ಆದ್ಮಿ ಹುವಾನಖ್ಹಾಜೆ ಚೂ಼ಣಿಲಿದೊ. <verse eid="EPH 1:11"/><verse number="12" style="v" sid="EPH 1:12"/>ಅಮ್‌ರ‍್ಹವಾಪರ್ ಕ್ರಿಸ್ತನಖ್ಹಾಜೆ ಪಹಿಲೆ ವಿಶ್ವಾಸ್‌ನ ಹುಯಿರ‍್ಹಾತೆ ಅಪ್ಣೆ ಇನಿ ಮಹಿಮೆಮ ಧನ್ಯವಾದ್‌ ಕರಾವಾಳ ಹುಯಿರ‍್ಹೇವ್ಣು ಕರಿ ಅಮ್ ಕರ‍್ಯೊ! <verse eid="EPH 1:12"/><verse number="13" style="v" sid="EPH 1:13"/>ಸುವಾರ್ತೆನಿ ಖ್ಹಾಚಿ ಸಂದೇಶ್ನ ಖ್ಹಮ್‍ಜಾ಼ನಿ ವಖ್ಹ್‌ತೆ, ತುಮೇಬಿ ಜಿನು ದೇವ್ನ ಅದ್ಮಿ ಹುಯಿರ‍್ಹಾಥ. ಸುವಾರ್ತೆ ತುಮುನ ಛುಟ್ಕಾರ್ ದಿದು. ತುಮೆ ಕ್ರಿಸ್ತಮ ವಿಶ್ವಾಸ್ ಕರಿರಾಖ್ಯಾಸ್ ಅಜು಼ ದೇವ್ ಯೋ ವಾಗ್ದಾನ್ ಕರ‍್ಯೊತೆ ಪವಿತ್ರಾತ್ಮನ ತುಮುನ ದ್ಯಾವಥಿ ಇನೊ ಮುದ್ರೊನಾಖಿನ್ ಖ್ಹಣೇದ್ ಕರಿರಾಖ್ಯೋಸ್. <verse eid="EPH 1:13"/><verse number="14" style="v" sid="EPH 1:14"/>ದೇವ್ನೆ ಇನ ಶೊಂತ್ ಅದ್ಮಿನ ಛುಟ್ಕಾರ್ ಉಷೆಕರಿ ಬೋಲಾನ ಪವಿತ್ರಾತ್ಮಸ್ ಅಪ್ಣುನ ಖ್ಹಂಜ಼್‌ಕಾರ್‌ ಹುಯಿರ‍್ಹೊಸ್, ಅನಖ್ಹಾಜೆ ದೇವ್ನ ಮಹಿಮೆ ಕರಿಯೆ.<verse eid="EPH 1:14"/></para>
  <para style="s">ಪೌಲನಿ ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15"/>ಅನಾಖ್ಹಾಜೆಥಿ ಕೆದೆ ಮೇ ಪ್ರಭು ಯೇಸುಮ ತುಮೆ ರಾಖಿರಾಖ್ಯತೆ ವಿಶ್ವಾಸ್ ಅಜು಼ ಖ್ಹಾರಸ್ ದೇವ್ನ ಅದ್ಮಿವ್‌ಪರ್ ತುಮೆ ದೆಖಾಡನಿ ಪ್ಯಾರ್‌ನಿ ಬಾರೇಮ ಖ್ಹಮ್‌ಜಿನ್‌, <verse eid="EPH 1:15"/><verse number="16" style="v" sid="EPH 1:16"/>ಮೆ ತುಮಾರಖ್ಹಾಜೆ ಮಾರಿ ಪ್ರಾರ್ಥನೆಮ ಬಿಂತಿಕರಾನಿ ವಖ್ಹ್‌ತೆ ದೇವ್ನ ಲಗತ್ತರ್ ಧನ್ಯವಾದ್ ಕರುಸ್. <verse eid="EPH 1:16"/><verse number="17" style="v" sid="EPH 1:17"/>ಅಪ್ಣೊ ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತನೊ ದೇವ್‌ಬಿ ಮಹಿಮೆನೊ ಬಾಬಿ ಇನಿ ಇನಿ ಬಾರೇಮ ಪೂರ ಅಕ್ಕಲ್‍ನ ತುಮುನ ದೀನ್ ದರ್ಶನಾನು ಆತ್ಮನ ದ್ಯವಾದೆಕರಿ ಪ್ರಾರ್ಥನೆ ಕರುಸ್. <verse eid="EPH 1:17"/><verse number="18" style="v" sid="EPH 1:18"/>ಮೇ ಬೋಲಿಲಾವನು ಶಾತ್‌ಕತೊ ತುಮಾರ ದಿಲ್ನ ಡೋಳಾನ ಉಜಾ಼ಖ್ಹ್‌ ಕರೀನ್, ಇನಿ ಬುಲಾವ್ಣಿನ ಭರೋಖ್ಹೊ ಕೆಥ್ರಾನು ಕರೀಬಿ ಅಜು಼ ದೇವ್ನ ಅದ್ಮಿವೋಮ ಛಾ಼ತೆ ಶೊತ್ನಿ ಮಹಿಮೆ ಕೆಥ್ರಾನು ಛಾ಼ ಕರಿ <verse eid="EPH 1:18"/><verse number="19" style="v" sid="EPH 1:19"/>ಅಜು಼ ವಿಶ್ವಾಸ್‌ಕರವಾಳ ಅಪ್ಣುನ ಇನಿ ತಾಖತ್ ಕೆತ್ರೆ ಊಚು಼ ಹುಯಿರ‍್ಹುಸ್, ಯೋ ಅಪ್ಣಾಮ ಕಾಮ್ ಕರಸ್. ಆ ಶಕತ್ ಅಪ್ಣಾಮ ಮೋಟಿ ಶಕತ್ನುಬಿ, ಕಾಮ್ ಕರಾನುಬಿ ಹುಯಿರ‍್ಹುಸ್. <verse eid="EPH 1:19"/><verse number="20" style="v" sid="EPH 1:20"/>ಇನಿ ಮಹಿಮೇನಿ ಶಕಥ್ಥಿಸ್ ಕ್ರಿಸ್ತನ ಮರಣ್‌ಥು ಉಠಾಡಿನ್, ಹರೇಕ್ ರಾಜ್ಯ, ಅಧಿಕಾರ್, ರಾಜ಼್‌ಭಾರ್ ಚ಼ಲಾವವಾಳನ ಸೊರ್ಗಾಮ ಇನ ಖ್ಹಾವಿಬಾಜು಼ಮ ಬೆಖ್ಹಾಡಿಲಿದೊ. <verse eid="EPH 1:20"/><verse number="21" style="v" sid="EPH 1:21"/>ಕ್ರಿಸ್ತನಿ ಅದಿಕಾರ್‌, ಶಕತ್ ಆ ಜಗತ್‌ಮಾಸ್ ಕಾಹೆತೆಸ್ ಅಗಾಡಿ ಆವ್‌ಶೇತೆ ಜಗತ್‌ಮ ಛಾ಼ತೆ ಖ್ಹಾರ ಜ಼ಣನ ಉಪ್ಪರ್‌ಬಿ ಅಖ್ಖನಾಮ್ನ ಉಪ್ಪರ್‌ಬಿ ಪರಲೋಕ್‍ಮ ಇನ ಇನು ಖಾವಿಬಾಜು಼ಮ ಬೆಖ್ಹಾಡಿಲಿದೊ. <verse eid="EPH 1:21"/><verse number="22" style="v" sid="EPH 1:22"/>ಅತ್ರೇಸ್ ಕಾಹೆತೆ ದೇವ್ನೆ ಅಖ್ಖಾಸ್ನ ಯೇಸು ಕ್ರಿಸ್ತನ ಗೋಡಾನ ಹೇಟ್‌ನಾಖ್ಯೊ, ಅಜು಼ ಸಬೆನ ಖ್ಹಾಜೆ ಯೋ ಅಖ್ಖಾನಪರ್ ಇನ ಮುಡ್‌ಕ್ಯು ಕರಿ ಬಣಾಯೊ. <verse eid="EPH 1:22"/><verse number="23" style="v" sid="EPH 1:23"/>ಸಬೆ ಕ್ರಿಸ್ತನು ಶರೀರ್ ಹುಯಿರ‍್ಹುಸ್, ಅಖ್ಖಾಸ್ನ ಅಖ್ಖಿ ತರಿಕಾಮಾಬಿ ದ್ಯವಾಳಥಿ ಯೊ ಭರ್‌ಪೂರ್‌ ಹುಯಿರ‍್ಹುಸ್.<verse eid="EPH 1:23"/></para>
  <chapter eid="EPH 1"/>
  <chapter number="2" style="c" sid="EPH 2"/>
  <para style="s">ಮರಣ್‍ಥಿ ಜಿವ್ಣಭಣಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1"/>ತುಮೆ ತುಮಾರು ಅವಿಧೇಯ ಬಿಜು಼ ಪಾಪ್ನಖ್ಹಾಜೇಥಿ ಆತ್ಮೀಕ್ ಪರಕ್ಮ ಮರಿಗಯಥ. <verse eid="EPH 2:1"/><verse number="2" style="v" sid="EPH 2:2"/>ಅಗ್ಗಳ್ ತುಮೆ ಆ ಜಗತ್ನಿ ರೀತಿಥೀಬಿ, ವಹಿರಾನ ಗೋಳಾಮ ಅದಿಕಾರ್ ಚ಼ಲಾವತೆ ಅದಿಪತಿನ ಕತೊ ವಿಧೇಯ ಕೊಹುವಾಂತೆ ಲಡ್ಕಾವ್‌ಮ ಹಮ್ಕೆ ಚ಼ಲಾವತೆ ಆತ್ಮನಿಘೊಣಿ ಜಿವ್ಣು ಚಾ಼ಲಾಯ. <verse eid="EPH 2:2"/><verse number="3" style="v" sid="EPH 2:3"/>ಪಹಿಲೆ ಅಪ್ಣೇಬಿ ಇವ್ಣಿನಿತರಸ್ ಥಾ, ಶರೀರ್‌ನು ಆಖ್ಹ್‌ದಾಖ್ಹ್‌ನ ಪೂರ ಕರಾನಟೇಕೆ ಅಪ್ಣೆ ಕೊಶೀಷ್ ಕರುಕರ್ತಥ. ಶರೀರ್‌ನ ಆಖ್ಹ್‌ಮ ಪಡೀನ್, ಶರೀರ್ ಅಜು಼ ದಿಲ್ನಿ ಆಖ್ಹ್‌ನ ಅಪ್ಣೆ ಕರ‍್ಯಾ. ಇವ್ಣಿ ಛ಼ಂದ್‌ನಿತರ ಅಪ್ಣೇಬಿ ಜಿನು ಅಲಕ್‌ನಿಘೋಣಿ ದೇವ್ನ ಇರಾದಮ ಪಡ್ಯ. <verse eid="EPH 2:3"/><verse number="4" style="v" sid="EPH 2:4"/>ಕತೋಬಿ ದೇವ್ನಿ ಗೋರ್‌ ಘಣಿಮೋಟಿ ಅಪ್ಣಖ್ಹಾಜೆ ಜಾ಼ಖ್ಹತ್ ಪ್ಯಾರ್ ವತಾಳಿರಾಖ್ಯೊಸ್. <verse eid="EPH 2:4"/><verse number="5" style="v" sid="EPH 2:5"/>ಖರಾಬ್ ಕಾಮ್ನ ಖ್ಹಾಜೇಥಿ ಆತ್ಮೀಕ್ ಪರಕ್ಮ ಮರಿಗಯಥಾತೆ ಅಪ್ಣುನ ಕ್ರಿಸ್ತನ ಜೋ಼ಡೆ ಜಿವಾಡ್ಯೊ.ಆ ರಕ್ಷಣೆ ತುಮೆ ಲೀರಾಖ್ಯಾಸ್ತೆ ದೇವ್ನಿ ವಾರ್‌ಖ್ಹೇಥಿಸ್. <verse eid="EPH 2:5"/><verse number="6" style="v" sid="EPH 2:6"/>ಕ್ರಿಸ್ತ ಯೇಸುನ ಗಳ್‌ಜೋ಼ಡ್ಮ ಅಪ್ಣುನ ಜಿವ್ತು ಉಠಾಡಿನ್ ಪರಲೋಕ್‍ಮ ಬೆಖ್ಹಾಡ್ಯೊ. <verse eid="EPH 2:6"/><verse number="7" style="v" sid="EPH 2:7"/>ಇನೆ ಅಪ್ಣುನ ಕ್ರಿಸ್ತ ಯೇಸುಮ ಆ ಹಗಾಮ್ಮಾಬಿ ಅಜು಼ ಆವ್‌ಶೇತೆ ಅಖ್ಖಾ ಹಗಾಮ್ಮಾಬಿ ಬೋಲಾನ ಕೊಹೋಯ್ನಿತೆ ಎತ್ರೆ ಇನಿ ಮೋಟಿ ವಾರ್‌ಖ್ಹೊಬಿ ಲಾಡ್‌ಬಿ ದ್ಯವಾನಖ್ಹಾಜೆ ಇನೆ ಅಮ್ ಕರ‍್ಯೊ. <verse eid="EPH 2:7"/><verse number="8" style="v" sid="EPH 2:8"/>ವಿಶ್ವಾಸ್‌ನಿ ಕೃಪೆಥಿಸ್ ತುಮೆ ರಕ್ಷಣೆ ಲೀರಾಖವಾಳ ಹುಯಿರ‍್ಹಾಸ್. ಆ ಬಚಾ಼ವ್ಣಿ ಅಪ್ಣಕಾಮ್ನು ಫಲ್‌ಕಾಹೆ, ಯೊ ದೇವ್‌ನು ಧರಮಸ್. <verse eid="EPH 2:8"/><verse number="9" style="v" sid="EPH 2:9"/>ಆ ರಕ್ಷಣೆ ಕೆಹೂಬಿ ಅಛ್ಛು಼ ಕಾಮ್‍ಥಿ ಹುಯುತೆ ಕಾಹೆ, ಇನಖ್ಹಾಜೆ ಇವ್ಣು ಇವ್ಣೆಸ್ ಖ್ಹರೈಲ್ಯಾವಾನು ಜ಼ರೂರತ್ ಕೊಯ್ನಿ. <verse eid="EPH 2:9"/><verse number="10" style="v" sid="EPH 2:10"/>ಅಪ್ಣೇತೊ ದೇವ್ನೆ ಕರ‍್ಯೊತೆ ಬಣಾವಟ್‌ಅಖ್ಖು. ಕ್ರಿಸ್ತ ಯೇಸುಮ ಅಛ಼್ಛು ಕಾಮ್ನಖ್ಹಾರು ಕರ್ತಹುಯಿನ್ ಜಿವ್ಣುಕರಿ ಇನೆ ಪಹಿಲೆ ಖ್ಹೂಜ಼್‌ಕರ‍್ಯೊತೆ ಇಮ್ಮಸ್ ದೇವ್ನೆ ಅಪ್ಣುನ ಉಬ್‌ಜೈ಼ರಾಖ್ಯೋಸ್.<verse eid="EPH 2:10"/></para>
  <para style="s">ಕ್ರಿಸ್ತಮ ಏಕ್‌</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11"/>ಪೈದಾಖ್ಹ್‌ ಥು ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ತುಮೆ ಯೆಹೂದ್ಯರ್‌ಥಿ ಖ್ಹತ್ನ ಕರೈಲಿದ ಕೊಯ್ನಿತೆ ಹಮಾರು ಹಮೇಸ್‌ ಖ್ಹತ್ನ ಕರೈಲಿದಹುಯ ಕರಿ ಬೋಲಿಲೆವೊಸ್. ಅಗ್ಗಳ್ ತುಮೆ ಶಾತ್‌ ಹುಯಿರ‍್ಹಾಥಕರಿ ಯಾದ್‍ಕರಿಲಾವನ ಖ್ಹಾಜೆ ಪರ್ಖ್ಹಾ ಅದ್ಮಿ ಇವ್ಣ ಶರೀರ‍್ಮ ಹುಯಿರ‍್ಹಾವನು ಆ ಏಕ್‌ ಕಾಮ್ ಹುಯಿರ‍್ಹುಸ್. <verse eid="EPH 2:11"/><verse number="12" style="v" sid="EPH 2:12"/>ತ್ಯೊ ಹಗಾಮ್ಮ ತುಮೆ ಕ್ರಿಸ್ತಥಿ ಅಲಕ್ ಹುಯಿರ‍್ಹಾಥ, ಇಸ್ರಾಯೇಲ್‌ವಾಳಾನಿ ಹಕ್‌ಮ ಕೊಹುಯಿರ‍್ಹಾಥಾನಿ. ದೇವ್ ಇನ ಅದ್ಮಿನ ಜೋ಼ಡೆ ವಾಗ್ದಾನ್ ಕರಿರಾಖ್ಯೊತೆ ಒಪ್ಪಂದಾಮ ತುಮೆ ವಾಟೊ ಹುಯಿರ‍್ಹಾಥ ಕೊಯ್ನಿ ಅಜು಼ ತುಮೆ ಆ ಜಗತ್ನ ಭರೋಖ್ಹಾಮ ಥಾ. ಅಜು಼ ತುಮೆ ದೇವ್ನ ಮಾಲುಮ್‌ ಕರಿರಾಖ್ಯಥಕೊಯ್ನಿ. <verse eid="EPH 2:12"/><verse number="13" style="v" sid="EPH 2:13"/>ಹಮ್ಕೆ ತುಮೆ ಏಕ್‌ ಘಡಿ,ದೇವ್‍ಥಿ ದೂರ್ ಹುಯಿರ‍್ಹಾಥ. ಕ್ರಿಸ್ತ ಯೇಸುನ ಲ್ಹೋಯಿಥೀಸ್‍ ಇನ ಗಳ್‍ಜೋ಼ಡ್ ಹುಯಿಗಾತೆ ಇನಖ್ಹಾಜೆ ದೇವ್ನ ಖನ್ನೆ ಅಪ್ಣುನ ಲೈರಾಖ್ಯಸ್. <verse eid="EPH 2:13"/><verse number="14" style="v" sid="EPH 2:14"/>ಯೆಹೂದ್ಯರ್‌ಬಿ ಯೆಹೂದ್ಯರ್ ಕೊಯ್ನಿತೆ ಇವ್ಣುನಏಕ್‌ಪರ್‌ ಏಕ್‌ ಕರೀನ್ ಯೋಸ್ ಅಪ್ಣುನ ಶಾಂತಿ ದ್ಯವಾಳೊ ಹುಯಿರೋಸ್. ಕಿಮ್ ಕತೊ ಇವ್ಣ ಬೀಚ್ಮ ಏಕ್‌ ಭೀತ್‌ನಿತರ ಥು. ಕತೋಬಿ ಕ್ರಿಸ್ತ ಇನು ಶೊಂತ್ ಶರೀರ್‌ನು ಬಲಿದಾನ್‌ ದೇತೊಹುಯಿನ್ ಯೊ ವಹೇರ‍್ನು ಭೀತ್‌ನ ರಡ್ಕಾಯೊ. <verse eid="EPH 2:14"/><verse number="15" style="v" sid="EPH 2:15"/>ಇನೆ ಧರ್ಮಶಾಸ್ತ್ರ ಅಜು಼ ನಿಯಮ್‌ನಿ ಜೋ಼ಡ್ಮ ಯೊ ಭೀತ್ ರಡ್ಕಾಯೊ.ಅಮ್ ಇನ ಗಳ್‌ಜೋ಼ಡ್ಮ ಭೇ ಖೂಮ್ನ ಇನಜೋ಼ಡೆ ಏಕ್‌ ನವಿ ಖೂಮ್‌ಕರಿ ಮ್ಹೇಲಾನಖ್ಹಾಜೆ ಅಮ್ ಸಮಾಧಾನ್ ಕರ‍್ಯೊ. <verse eid="EPH 2:15"/><verse number="16" style="v" sid="EPH 2:16"/>ಇನ ಮರಣ್‌ಥೀಸ್, ಕ್ರಿಸ್ತ ಶಿಲ್‌ಬೆಪರ್ ಭೇ ಖೂಮ್ನ ಎಕ್ಕಸ್ ಶರೀರ್ ಕರಿನ್ ಇವ್ಣುನ ದೇವ್ನ ಜೋ಼ಡೆ ರಾಜಿ ಕರ‍್ಯೊ. <verse eid="EPH 2:16"/><verse number="17" style="v" sid="EPH 2:17"/>ಆಬಿ ಕಾಹೆತೆ ಯೊ ಅಯಿನ್ ದೂರ್ ಹುಯಿರ‍್ಹಥಾತೆ ತುಮೂನಾಬಿ ಅಜು಼ ಖನ್ನೆ ಹುಯಿರ‍್ಹುಥೂತೆ ಯೆಹೂದ್ಯರ್‌ನಾಬಿ ಸಮಾಧಾನ್ನಿ ಸುವಾರ್ತೆನ ಬೋಲ್ಯೊ.<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt"><ref loc="ISA 57:19">ಯೆಶಾಯ 57:19</ref></char></note> <verse eid="EPH 2:17"/><verse number="18" style="v" sid="EPH 2:18"/>ಇನಾಖ್ಹಾಜೆ ಕ್ರಿಸ್ತಥಿ ಯೆಹೂದ್ಯರ್ ಅಜು಼ ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ಅದ್ಮಿ ಹಮೆಬಿ ತುಮೆ ಎಕ್ಕಸ್ ಆತ್ಮಥಿ ಬಾಕನ ಆವಾನ ವಾಟ್‍ಹುಯು. <verse eid="EPH 2:18"/><verse number="19" style="v" sid="EPH 2:19"/>ಅಮ್‌ರ‍್ಹವಾಪರ್ ತುಮೆ ಹಮ್ಕೆ ಬಿಜ಼ ದೇಖ್ಹ್‌ವಾಳ ರ‍್ಹವೊ ಯೆಹೂದ್ಯರ್ ಕಾಹೆತೆ ರ‍್ಹವೊ ನಾ ಹುಯಿರ‍್ಹೇಣುತೆ ದೇವ್ನ ಅದ್ಮಿಯೇನ ಜೋ಼ಡೆ ಎಕ್ಕಸ್ಜ಼ಗೊವಾಳಬಿ ದೇವ್ನ ಘರ್‌ವಾಳಬಿ ಹುಯಿರ‍್ಹಾಸ್. <verse eid="EPH 2:19"/><verse number="20" style="v" sid="EPH 2:20"/>ಅಪೊಸ್ತಲಬಿ ಅಜು಼ ಪ್ರವಾದಿಖ್ಹಾರುಬಿ ಕರಿ ಬೋಲಾನು ಹದಿಪಾಯಪರ್ ತುಮೆ ಘರ್‌ನಿಘೋಣಿ ಭಂದೈರ‍್ಹಾಸ್. ಕ್ರಿಸ್ತ ಯೇಸುಸ್ ಮುಖ್ಯ ಹುಯಿರ‍್ಹೊಸ್ತೆ ಕೋಣಾನೊಬಂಡೊ ಹುಯಿರ‍್ಹೊಸ್. <verse eid="EPH 2:20"/><verse number="21" style="v" sid="EPH 2:21"/>ಇನಾಮ ಘರ್‌ನು ಅಖ್ಖೂಸ್ ಭಾಗ್‍ಖ್ಹಾರು ಏಕ್‌ಥಿ ಏಕ್‌ ಮಳಿನ್, ಘರ್ ಭಡೀನ್ ಪ್ರಭುಮ ಪರಿಶುದ್ ಮಂದಿರ್‌ ಹುವಾಸ್. <verse eid="EPH 2:21"/><verse number="22" style="v" sid="EPH 2:22"/>ಕ್ರಿಸ್ತಮ ತುಮೇಬಿ ಪವಿತ್ರಾತ್ಮಥಿ ದೇವ್ನ ರ‍್ಹವಾನು ಮಂದಿರ್‌ ಹುವಾನಖ್ಹಾಜೇಥಿ ಹಮಾರ ಜೋ಼ಡೆ ಭಂದೌಕರಾಸ್.<verse eid="EPH 2:22"/></para>
  <chapter eid="EPH 2"/>
  <chapter number="3" style="c" sid="EPH 3"/>
  <para style="s">ಯೆಹೂದ್ಯರ್ ಕಾಹೆತೆ ಇವ್ಣ ಇಚ಼್‌ಮ ಪೌಲಾನಿ ಸೇವೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1"/>ಅಮ್‍ರ‍್ಹವಾಪರ್ ಪೌಲ ಹುಯಿರ‍್ಹೋತೆ ಮೆ ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ತುಮಾರ ಖ್ಹಾಜೇಥಿ ಕ್ರಿಸ್ತ ಯೇಸುನಖ್ಹಾಜೆ ಖ್ಹಾರ್ಕೊಟ್‌ಮ ರ‍್ಹವಾಳೊ ಹುಯಿರ‍್ಹೋಸ್. <verse eid="EPH 3:1"/><verse number="2" style="v" sid="EPH 3:2"/>ತುಮಾರ ಅಛ್ಛು಼ಕಾಮ್ನ ಖ್ಹಾಜೇಥಿ ಛೇತೆ ಜಿಮ್ಮೆದಾರಿನ ದೇವ್ನೆ ಇನಿ ವಾರ್‌ಖ್ಹೇಥಿಸ್ ಮನ ದೀರಾಖ್ಯೊಸ್‍ಕರಿ ತುಮೆ ಖ್ಹಮ್‌ಜಿರಾಖ್ಯಾಸ್‌, <verse eid="EPH 3:2"/><verse number="3" style="v" sid="EPH 3:3"/>ದೇವ್ನೆ ಇನ ದಿಲ್ನ ಮಾಯ್ನನ ಬೋಲಿದಿದೊ. ಅನಿಬಾರೇಮ ಮೆ ಪಹಿಲೆಸ್ ತುಮುನ ಥೋಡಿ ವಾತೆಥಿ ಲೀಖಿನ್ ಮೋಕ್ಲಿರಾಖ್ಯೊಸ್. <verse eid="EPH 3:3"/><verse number="4" style="v" sid="EPH 3:4"/>ಅಜು಼ ಮೆ ಲೀಖಿರಾಖ್ಯೊಸ್ತೆ ಇನ ತುಮೆ ಬರಾಬರ್‌ಥಿ ಫಡೀನ್ ದೇಖ್ಯಾತೊ ಮಾರಮ ಕ್ರಿಸ್ತನಿ ಬಾರೇನು ಮಾಯ್ನನ ತುಮೇಬಿ ಮಾಲುಮ್ ಕರ‍್ಲಿಶು. <verse eid="EPH 3:4"/><verse number="5" style="v" sid="EPH 3:5"/>ಗಯೋತೆ ಹಗಾಮ್ಮ ಅದ್ಮಿವೊನ ಆ ಮಾಯ್ನೊ ಕೊಬೋಲಾಯುನಿ ಕತೋಬಿ ದೇವ್ನೆ ಇನ ಪವಿತ್ರಾತ್ಮಥಿ ಅಪೊಸ್ತಲರ‍್ನ ಅಜು಼ ಪ್ರವಾದಿಖ್ಹಾರನ ಮಾಲುಮ್ ಕರೈರಾಖ್ಯೋಸ್. <verse eid="EPH 3:5"/><verse number="6" style="v" sid="EPH 3:6"/>ಯೊ ಮಾಯ್ನೊ ಖಿವುಕತೊ,ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ಅದ್ಮಿ ಜಿನು ಸುವಾರ್ತೆಥಿ ಕ್ರಿಸ್ತಯೇಸುಮ ದೇವ್ನ ಅದ್ಮಿನಜೋ಼ಡೆ ವಾಗ್ದಾನ್‌ಮ ವಾಟೊಲ್ಯಾವಳ ಹುಯಿರ‍್ಹಾಸ್. <verse eid="EPH 3:6"/><verse number="7" style="v" sid="EPH 3:7"/>ದೇವ್ನೆ ಇನಿ ಕಾಮ್ ಕರಾನಿ ಶಕಥ್ಥಿ ಮನ ದೆವಾಯುತೆ ಇನಿ ದಾನ್ನಿ ವಾರ್‌ಖ್ಹೇಥಿ ಮೆ ಆ ಸುವಾರ್ತೆನ ಬೋಲವಾಳೊ ಸೇವಕ್ ಹುಯೊ. <verse eid="EPH 3:7"/><verse number="8" style="v" sid="EPH 3:8"/>ಅಖ್ಖಾಸ್ ದೇವ್ನ ಅದ್ಮಿಮ ಕಮ್‍ಶಿಲ್ ರ‍್ಹಿಯೊತೋಬಿ ದೇವ್ನೆ ಕ್ರಿಸ್ತನು ವಾರ್‌ಖ್ಹಾನಿ ಸುವಾರ್ತೆನ ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ಅದ್ಮಿನ ಬೋಲಿ ವತಾಳನಖ್ಹಾಜೆ ವಖ್ಹತ್‌ನ ಮನ ದೀರಾಖ್ಯೊಸ್. <verse eid="EPH 3:8"/><verse number="9" style="v" sid="EPH 3:9"/>ಬಿಜು಼ ದೇವ್ನ ಅದ್ಮಿನ ದೇವ್ನಿ ಗಪ್ಲತ್‌ನಿ ಖ್ಹೂಜ಼್‌ನ ಖಿವುಕರಿ ಅಜು಼ ಯೊ ಪ್ರಭಾವ್‌ ಹುವಾನಿತರಾನು ದೇಖಾನಖ್ಹಾಜೆ ಕರ‍್ಯೊ. ಅಖ್ಖಾಸ್ನ ಉಬ್‌ಜಾ಼ಯೊತೆ ದೇವ್ ಪಾಛ಼್‌ಲ್ಯಾಹಗಾಮ್ಮ ಇನು ಗಪ್ಲತ್‌ನ ಲಪಾಡಿರಾಖ್ಯೊಥೊ. <verse eid="EPH 3:9"/><verse number="10" style="v" sid="EPH 3:10"/>ಇನಖ್ಹಾಜೆ ಆ ಹಗಾಮ್ಮ ಸಬೇಥಿ ದೇವ್ನದೂತರ‍್ನು ಚ಼ಲಾವವಾಳು ಅಜು಼ ಪರಲೋಕ್‌ ರಾಜ್ಯನು, ಅದಿಕಾರಿಖ್ಹಾರು ಇನು ಗ್ಯಾನ್ ಬಿಜಿ ಪರಕ್ಮ ಶಿಕಾಡನಿಘೋಣಿ ಹೋಣುಕರಿ ಬೋಲಾನು ಇನಿ ಆಖ್ಹ್ ಹುಯಿರ‍್ಹೀಥಿ <verse eid="EPH 3:10"/><verse number="11" style="v" sid="EPH 3:11"/>ದೇವ್ನೆ ಅಪ್ಣೊ ಪ್ರಭು ಕ್ರಿಸ್ತಯೇಸುಥಿ ಭರ್‌ಪೂರ್‌ ಕರ‍್ಯೊತೆ ಇನಿ ಹರ್‌ಹಮೇಶಾನಿ ಖ್ಹೂಜ಼್‌ನಿ ಪರಕ್ಮ ಆ ಅಖ್ಖು ಕರ‍್ಯೊ. <verse eid="EPH 3:11"/><verse number="12" style="v" sid="EPH 3:12"/>ಕ್ರಿಸ್ತನ ಗಳ್‍ಜೋ಼ಡ್ಮಾಬಿ ಅಜು಼ ಇನಾಪರ್ ರಾಖಿರಾಖ್ಯತೆ ಅಪ್ಣಿ ವಿಶ್ವಾಸ್‍ಥಿ ಅಪ್ಣೆ ದೇವ್ನ ಖ್ಹಾಮ್ಣೆ ಭಾಲಿಥಿ ಅಜು಼ ಆತ್ಮ ವಿಶ್ವಾಸ್‍ಥಿ ಜಾ಼ವನಿತರ ಹುಯು. <verse eid="EPH 3:12"/><verse number="13" style="v" sid="EPH 3:13"/>ಇನಾಖ್ಹಾಜೆ ತುಮಾರಖ್ಹಾಜೆ ಮನಹುಯುತೆ ಖ್ಹತಾಪ್ಣಿನ ದೇಖಿನ್ ತುಮೆ ಹಿಮ್ಮತ್‌ ನಾ ಹರ‍್ನುಕರಿ ತುಮುನ ಗಿಂಗೈಲೆವುಸ್. ಆ ವದೆಖ್ಹೊಖ್ಹಾರು ತುಮುನ ಮರ್ಯಾದಿನು ಹುಯಿರ‍್ಹುಸ್.<verse eid="EPH 3:13"/></para>
  <para style="s">ಕ್ರಿಸ್ತನು ಪ್ಯಾರ್</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14"/>ಅನಖ್ಹಾಜೆ ಬಾನ ಖ್ಹಾಮ್ಣೆ ಮೆ ಗುಡ್‍ಘ್ಯ ಟೇಕ್ಯೊ. <verse eid="EPH 3:14"/><verse number="15" style="v" sid="EPH 3:15"/>ಆ ಜ಼ಮೀನ್‌ಪರ್ ಅಜು಼ ಸೊರ್ಗಾಮ ಛಾ಼ತೆ ಹರೇಕ್ ಕುಟಮ್‌ ಅನೇಥಿ ಖ್ಹಾಚ ನಾಮ್ನ ಲೀಲೆಸ್. <verse eid="EPH 3:15"/><verse number="16" style="v" sid="EPH 3:16"/>ಮೆ ದೇವ್ನ ಧನ್‌ದೌಲಥ್ಥಿ ರ‍್ಹವಾನು ಮಹಿಮೆಥಿ ಪ್ರಾರ್ಥನೆ ಕರುಕರೂಸ್. ಯೊ ಪವಿತ್ರಾತ್ಮಥಿ ದಿಲ್ನ ಮಹಿ ತಾಖತ್ ಹುವಾನ ವಿಶೇಷ್ ಶಕತ್‍ದ್ಯವಾದೆ, <verse eid="EPH 3:16"/><verse number="17" style="v" sid="EPH 3:17"/>ಕ್ರಿಸ್ತ ತುಮಾರ ವಿಶ್ವಾಸ್‍ಥಿ ತುಮಾರ ದಿಲ್ಮ ಜಿವಾದೆಕರಿಬಿ, ಯೊ ಇನಿ ಮಹಿಮೆನಿ ಶಕತ್ ದ್ಯವಾದೆ. <verse eid="EPH 3:17"/><verse number="18" style="v" sid="EPH 3:18"/>ತುಮೆ ಪ್ಯಾರ್‌ಮ ತಳ್‌ಗಾಠಿ ಭೀರೇವ್ಣು. ದೇವ್ನ ಅದ್ಮಿನ ಜೋ಼ಡೆ ಕ್ರಿಸ್ತನು ಪ್ಯಾರ್ ಕೆತ್ರೆ ಚೌ಼ಡು, ಲಾಂಬು, ಊಚು಼ ಗಧಾರ್, ಛಾ಼ಕರಿ ಮಾಲುಮ್ ಕರಾನಿ ಶಕತ್ ತುಮಾರಮ ರ‍್ಹವಾದೆ. <verse eid="EPH 3:18"/><verse number="19" style="v" sid="EPH 3:19"/>ಖ್ಹಯಾಲ್‌ಥೀಬಿ ಘಣು ಜಾ಼ಖ್ಹತ್ ಕ್ರಿಸ್ತನಿ ಪ್ಯಾರ್ ಮಾಲುಮ್ ಹುವಾದೆ, ದೇವ್ನಿ ಭರ್‌ಪೂರ್‌ ಸ್ವಭಾವ್‍ಥಿ ಪೂರಹುವಾದೆ. <verse eid="EPH 3:19"/><verse number="20" style="v" sid="EPH 3:20"/>ಅಪ್ಣಾಮ ಕಾಮ್ ಕರಾಸ್ತೆ ಇನು ಶಕತ್ನಿ ಪರಕ್ಮ ಅಪ್ಣೆ ಮಾಂಗಥಿಬಿ ಸೋಚಾಥಿಬಿ ಕೆತ್ರೆಸ್ಕಿ ಜಾ಼ಖ್ಹತ್ ಕರಾನ ಶಕತ್‌ವಾಳೊ ಹುಯಿರ‍್ಹೊಸ್ತೆ ದೇವ್ನ, <verse eid="EPH 3:20"/><verse number="21" style="v" sid="EPH 3:21"/>ಸಬೆಮಾಬಿ ಕ್ರಿಸ್ತ ಯೇಸುಮಾಬಿ ಜ಼ಗ್‌ಜ಼ಮಾನಮಾಬಿ ಪಿಢಿನ್‌ ಪಿಢಿಮಾಬಿ ಮಹಿಮೆ ಹುವಾದೆ.ಆಮೆನ್.<verse eid="EPH 3:21"/></para>
  <chapter eid="EPH 3"/>
  <chapter number="4" style="c" sid="EPH 4"/>
  <para style="s">ಶರೀರ‍್ಮ ಏಕ್‌ ಹುಯಿರ‍್ಹಾವನು</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1"/>ಇನಖ್ಹಾಜೆ ಪ್ರಭುನ ಸೇವೆನಖ್ಹಾಜೆ ಖೈದಿ ಹುಯಿರ‍್ಹೊಸ್ತೆ ಮೆ ತುಮೂನ ಬೋಲಿಲೆವ್‌ಸ್ ಶಾತ್‌ಕತೊ ದೇವ್ ತುಮುನ ಬುಲಾವನಿವಖ್ಹ್‌ತೆ ತುಮೆ ದೇವ್‍ಥಿ ಬುಲೈರಾಸ್ತೆಖ್ಹಾಜೆ ಯೊ ಬುಲಾವ್ಣಿನ ಲ್ಹಾಯೇಕ್ ಹುಯಿನ್ ಜಿವ್ಣು ಕರೊ. <verse eid="EPH 4:1"/><verse number="2" style="v" sid="EPH 4:2"/>ತುಮೆ ದೇವ್‌ಮ ಬುಲಾಯತೆ ಇನಖ್ಹಾಜೆ ಹೇಟು ಹುಯಿರ‍್ಹವಾನು, ಶೇದೇವ್‌ಥಿ ರ‍್ಹವಾನು, ಖ್ಹಮಾಳಿರ‍್ಹವಾಳ ಹುಯಿನ್ ಪ್ಯಾರ್‌ಥಿ ಏಕ್‌ಥಿ ಏಕ್ ಖ್ಹಮಾಳಿರ‍್ಹವೊ. <verse eid="EPH 4:2"/><verse number="3" style="v" sid="EPH 4:3"/>ಸಮಾಧಾನ್ನಿ ಬಂಧನ್ಮ ಭಂದೈರ‍್ಹವಾಳ ಹುಯಿನ್ ಪವಿತ್ರಾತ್ಮಥಿ ಹುವಾಸ್ತೆ ಒಗ್ಗಟ್‌ನ ಬಚಾ಼ಡಾನಖ್ಹಾಜೆ ಮನ್‌ಲಗಾಡೊ. <verse eid="EPH 4:3"/><verse number="4" style="v" sid="EPH 4:4"/>ತುಮೆ ದೇವ್‌ಮ ಬುಲಾವನಿವಖ್ಹ್‌ತೆ ಖ್ಹಾರು ಎಕ್ಕಸ್ ಶರೀರ್‌ಮ ಮಳಿರ‍್ಹವಾಳಬಿ, ಎಕ್ಕಸ್ ಪವಿತ್ರಾತ್ಮಥಿ ರ‍್ಹವಾಳಬಿ, ಎಕ್ಕಸ್ ಭರೋಖ್ಹಾನಟೇಕೆ ಬುಲೈರ‍್ಹಾಸ್. <verse eid="EPH 4:4"/><verse number="5" style="v" sid="EPH 4:5"/>ತುಮುನ ಯೋ ಎಕ್ಕಸ್ ಪ್ರಭು, ಎಕ್ಕಸ್ ವಿಶ್ವಾಸ್, ಎಕ್ಕಸ್ ಬ್ಯಾಪ್ತಿಸ್ಮ, <verse eid="EPH 4:5"/><verse number="6" style="v" sid="EPH 4:6"/>ಬಾ ಹುಯಿರ‍್ಹೊಸ್ತೆ ಎಕ್ಕಸ್ ದೇವ್‌ಬಿ, ಅಖ್ಖಾನ ಪ್ರಭು ಹುಯಿರ‍್ಹವಾಳೊ, ಖ್ಹಾರೇಥಿಸ್ ಕಾಮ್ ಕರಾವವಾಳೊಬಿ, ಖ್ಹಾರಮಸ್ ಜಿವ್ಣುಕರವಾಳೊ ಹುಯಿರ‍್ಹೋಸ್. <verse eid="EPH 4:6"/><verse number="7" style="v" sid="EPH 4:7"/>ಕತೋಬಿ ಕ್ರಿಸ್ತನಿ ವರಾನಿ ಆಳ್ತಿನಿ ಪರಕ್ಮಾಸ್ ಹರೇಕ್ ಜ಼ಣಾನ ವಾರ್‌ಖ್ಹಾನಿ ವರ ದೆವೈರ‍್ಹೂಸ್. <verse eid="EPH 4:7"/><verse number="8" style="v" sid="EPH 4:8"/>ಇನಾಖ್ಹಾಜೆ ಪವಿತ್ರ ದಪ್ತರ್‌ಮ ಅಮ್ ಬೋಲೈರ‍್ಹೂಸ್‍, “ಯೊ ಊಚಿ ಸ್ಥಾನ್‌ಪರ್ ಛ಼ಡಿಜಾ಼ವನಿ ವಖ್ಹ್‌ತೆ, ಯೊ ಖೈದಿಖ್ಹಾರಾನ ಬಂಧಿ ಕರ‍್ಲಿ ಜೈ಼ನ್ ಅದ್ಮಿಖ್ಹಾರಾನ ಇನಾಮ್ ದಿದೊ”. <verse eid="EPH 4:8"/><verse number="9" style="v" sid="EPH 4:9"/>“ಛ಼ಡಿಗಯೊ” ಕರಿ ಬೊಲಾನಿ ಮತ್ಲಬ್ ಶಾತ್‌ಕತೊ? ಯೊ ಜ಼ಮೀನ್ನ ಗಧಾರ್‌ಮ ಉತ್‌ರ‍್ಯೊಕರಿ ಬೋಲಾನಿತರ ಹುವಾಸ್. <verse eid="EPH 4:9"/><verse number="10" style="v" sid="EPH 4:10"/>ಉತ್ರಿನ್ ಆಯೊಹುಯೊ, ಖ್ಹಾರುಸ್ ಭರಾನಖ್ಹಾಜೆ ಅಖ್ಖಾ ಜಗತ್‌ಥೀಬಿ ಊಚಾ಼ಮ ಛ಼ಢಿಗಯೊಹುಯೊ ಹುಯಿರ‍್ಹೋಸ್. <verse eid="EPH 4:10"/><verse number="11" style="v" sid="EPH 4:11"/>ಯೊ ಹೈರೋತೆ ಇನಾಮ್ನ ದ್ಯವಾಳೊಬಿ ಹುಯಿರ‍್ಹೊಸ್ ಕತೊ ಯೊ ಥೋಡಜ಼ಣಾನ ಅಪೊಸ್ತಲರ್ ಕರಿಬಿ, ಥೋಡಾನ ಪ್ರವಾದಿಕರಿಬಿ, ಥೋಡಜ಼ಣಾನ ಸುವಾರ್ತೆ ಬೋಲವಾಳುಕರಿಬಿ, ಥೋಡಜ಼ಣಾನ ಸಬಾಪಾಲಕರ್ ಕರಿಬಿ, ಶಿಕಾಡವಾಳೊ ಕರಿಬಿ ನೆಮಿಸಾಯೊ. <verse eid="EPH 4:11"/><verse number="12" style="v" sid="EPH 4:12"/>ಯೋ ಕ್ರಿಸ್ತನ ಶರೀರ್‌ಮ ಎಕ್ಟುಹುವಾನಖ್ಹಾಜೆ ಅಖ್ಖಾ ದೇವ್ನ ಅದ್ಮಿವ್‌ನ ಕ್ರಿಸ್ತನ ಸೇವೆನ ಕಾಮ್ನಖ್ಹಾಜೆ ತಯಾರ್ ಕರಾನ ಟೇಕೆ ಯೋ ಅಮ್ ಕರ‍್ಯೊ. <verse eid="EPH 4:12"/><verse number="13" style="v" sid="EPH 4:13"/>ಇನಖ್ಹಾಜೆ ದೇವ್ನ ಅದ್ಮಿನ ಅಕ್ಲಿಕರೀನ್ ದೇವ್ನ ಛಿಯ್ಯಾನ ಕಾಮ್ ಕರಾನಖ್ಹಾಜೆ ತಯಾರ್ ಕರ್ನುಕರಿಬಿ ಅಜು಼ ಯೇಸುಕ್ರಿಸ್ತನು ಶರೀರ್ ಹುಯಿರ‍್ಹುಸ್ತೆ ಸಬೆ ಭಡಾದೆಕರಿ ಇನೆ ಅವ್ಣುನ ನೇಮ್‌ಶಾಯೊ. <verse eid="EPH 4:13"/><verse number="14" style="v" sid="EPH 4:14"/>ಇನಾಖ್ಹಾಜೆ ಬೋಲಿಲಾವನು ಶಾತ್‌ಕತೊ ಅಪ್ಣೆ ಹಂಕೇಥು ಅಡ್ಡಾಣಿ ನಾ ಹುಯಿರ‍್ಹೇವ್ಣುತೆ, ಖರಾಬ್ ಅದ್ಮಿನ ಠಗಾವ್ಣಿಮಾಬಿ, ಗಲ್ತಿಸೋಚ್‌ಮ ಪಡೀನ್, ಅಲಕ್ ಅಲಕ್ ಭೋದನ್‌ಥಿ ಧೋಕಹುಯಿನ್ ವಹಿರೊ ಕೀಕಡ್‌ಕಿ ತೀಕಡ್‌ ನಾಜಾ಼ವಾಳ ಹುಯಿರ‍್ಹೇಣು. <verse eid="EPH 4:14"/><verse number="15" style="v" sid="EPH 4:15"/>ಕತೋಬಿ ಪ್ಯಾರ್‌ಮ ಖ್ಹಾಚು಼ಬೋಲ್ತಹುಯಿನ್ ಹರೇಕ್ ವಾತೆವ್‌ಮಾಬಿ ಮುಡ್‌ಕ್ಯು ಹುಯಿರ‍್ಹೋಸ್ತೆ ಕ್ರಿಸ್ತಮ ಭಡವಾಳ ಹುಯಿರ‍್ಹಿಯೆ. <verse eid="EPH 4:15"/><verse number="16" style="v" sid="EPH 4:16"/>ಶರೀರ್‌ಅಖ್ಖು ಕ್ರಿಸ್ತಥಿ ಹರ್ ಕೀಲ್‌ಥಿ ಘಟ್ ಮಳಿರ‍್ಹೀನ್, ಹರೇಕ್ ಖ್ಹಂದೊಬಿ ಇನು, ಇನು ಕಾಮ್ ಕರಾಸ್ತೆಖ್ಹಾಜೆ ಶರೀರ್ ಪ್ಯಾರ್‌ಮ ಅಛ್ಛಿನಿತರ ಭಡಾಸ್.<verse eid="EPH 4:16"/></para>
  <para style="s">ಕ್ರಿಸ್ತಮ ನವು ಜಿವ್ಣು</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17"/>ಇನಾಖ್ಹಾಜೆ ಮೆ ಪ್ರಭುಮ ತುಮುನ ಶಾತ್‌ ಬೋಲುಸ್‌ಕತೊ ಅಲಕ್‌ ಅದ್ಮಿಖ್ಹಾರು ಚಾ಼ಲಾನಿಘೋಣಿ ಅನ ಅಗ್ಗಳ್ ನಾಚಾ಼ಲ್ನು. ಇವ್ಣೆ ಕಾಯ್‌ ಫಾಯಿದೊಕೊಂತೆ ಅಕ್ಕಲ್‌ವಾಳನಿತ್ರ ಚಾ಼ಲಿಲೆಸ್. <verse eid="EPH 4:17"/><verse number="18" style="v" sid="EPH 4:18"/>ಇವ್ಣ ದಿಲ್‌ ಅಂಧಾರಥಿ ಢಪೈರ‍್ಹೂಸ್, ಇವ್ಣೆ ಇವ್ಣಿ ಕಠೋರ್ ದಿಲ್‌ಥೀಬಿ ಅಜು಼ ಇವ್ಣಾಮ ಅಕ್ಕಲ್‌ಕೊಂತೆ ಖ್ಹಾಜೇಥಿಬಿ ದೇವ್ ದೇಸ್ತೆ ಜಾನ್‌ಥಿ ದೂರ್ ಹುಯಿರ‍್ಹೂಸ್. <verse eid="EPH 4:18"/><verse number="19" style="v" sid="EPH 4:19"/>ಇವ್ಣೆ ಖ್ಹರಮ್‌ ಮ್ಹೆಂದಿನ್ ಇವ್ಣುಇವ್ಣುನ ಖರಾಬ್ ಆಖ್ಹ್‌ನ ದಿನಾಖಿನ್, ಹರೇಕ್ ಥರಾನು ಕಚಿಂಡ್‌ ಕಾಮ್‍ಅಖ್ಖಾನ ನಿಕ್ಳಜಾನ್‌ಥಿ ಚ಼ಲಾವಸ್. <verse eid="EPH 4:19"/><verse number="20" style="v" sid="EPH 4:20"/>ತುಮೆತೋಬಿ ಕ್ರಿಸ್ತನಿ ಬಾರೇಮ ಇಮ್ನು ಶಾತ್ಬಿ ಶಿಕ್ಯಾಕೊಯ್ನಿ. <verse eid="EPH 4:20"/><verse number="21" style="v" sid="EPH 4:21"/>ಶನಕತೊ ಖ್ಹಾಚಮಾಬಿ ಇನಾಮಸ್ ಖ್ಹಮ್‌ಜಿರಾಖ್ಯಾಸ್‌ ಅಜು಼ ಇನ ಪೀಠೆ ಜಾ಼ವಳ ತುಮುನ ಯೇಸುಮ ಛಾ಼ತೆ ಖ್ಹಾಚ಼ನಿಘೋಣಿಸ್ ಶಿಕಾಡಿರಾಖ್ಯಸ್. <verse eid="EPH 4:21"/><verse number="22" style="v" sid="EPH 4:22"/>ಇನಖ್ಹಾಜೆ ತುಮುನ ಶಿಕಾಡ್ಯುತೆ ಭೋದನ್ ಶಾತ್‌ಕತೊ ತುಮೆ ತುಮಾರಿ ಅಗ್ಲಿ ಚಾ಼ಲ್‌ನಿತರಾನು ಜೂ಼ನಿ ಆದತ್‌ನ ಕಾಡಿನಾಖೊ; ಯೊ ಧೋಕ ಖೈರಾಖ್ಯಾಸ್ತೆ ಖರಾಬ್ ಆಖ್ಹ್‌ಥಿ ಭರೈರ‍್ಹುಸ್‌. ಯೊ ನಾಶ್‌ ಹುಯಿಜಾ಼ವನು ಹುಯಿರುಸ್. <verse eid="EPH 4:22"/><verse number="23" style="v" sid="EPH 4:23"/>ಅಜು಼ ತುಮೆ ತುಮಾರು ದಿಲ್‌ ಮನ್ನ ನವು ಕರಿಲೆವೊ. <verse eid="EPH 4:23"/><verse number="24" style="v" sid="EPH 4:24"/>ಅಜು಼ ತುಮಾರು ತುಮೆ ನವಿ ಆದತ್‌ನ ಫೇರಿಲೆವೊ ದೇವ್ನಿಸ್ ಪರಕ್ಮ ಅಜು಼ ಖ್ಹಾಚಿಥೀಬಿ ನೀತಿನೂಬಿ, ಪರಿಶುದ್ ಹುಯಿನ್‍ಬಿ ಉಬ್ಜಿರ‍್ಹುಸ್. <verse eid="EPH 4:24"/><verse number="25" style="v" sid="EPH 4:25"/>ಇನಾಖ್ಹಾಜೆ ಝೂ಼ಟಿ ಬೋಲಾನು ಮ್ಹೇಲಿನ್ ಹರೇಕ್ ಜ಼ಣು ಇನ ಭೀಡೆವಾಳನ ಜೋ಼ಡೆ ಖ್ಹಾಚಿಸ್ ಬೋಲೊ. ಶನಕತೊ ಅಪ್ಣೆಖ್ಹಾರು ಎಕ್ಕಸ್ ಶರೀರ‍್ನು ಭಾಗ್‌ ಹುಯಿರ‍್ಹಾಸ್ನಿ. <verse eid="EPH 4:25"/><verse number="26" style="v" sid="EPH 4:26"/>ಇರಾದೊ ಕರ‍್ಯತೋಬಿ ಪಾಪ್ ನಕೊಕರ್ಶು, ದನ್ ಡುಬಾಥಿ ಪಹಿಲೆಸ್ ತುಮಾರೊ ಇರಾದೊ ಖ್ಹರ್ತಿ ಹುಯಿಜಾ಼ವದೆ. <verse eid="EPH 4:26"/><verse number="27" style="v" sid="EPH 4:27"/>ಶೈತಾನ್ನ ಮೋಕ ನಕೊದಿಶು. <verse eid="EPH 4:27"/><verse number="28" style="v" sid="EPH 4:28"/>ಚೋ಼ರಿ ಕರಾವಾಳೊ ಚೋ಼ರ್ ಕರಾನು ಮ್ಹೆಂದಿನ್ ರಾಬಿನ್ ಮಿನಥ್ಥಿ ಅಛ಼್ಛು ಕಮೈಕರೀನ್ ಜಿವ್ಣು ಕರಾದೆ, ತದೆ ಗರೀಬ್ ಅದ್ಮಿನ ದ್ಯಾವಾನ ಇನ ಹಾತೆ ಉಶೆ. <verse eid="EPH 4:28"/><verse number="29" style="v" sid="EPH 4:29"/>ತುಮಾರ ಮ್ಹೋಡೆಥಿ ಖಿವು ಖರಾಬ್ ವಾತೆ ನಾ ಆವ್ಣು. ಕತೋಬಿ ಭಕ್ತಿನ ಭಡಾವಾನಿ ಯೋವೇಳ್ಮ ಬೋಲ್ನುತೆ ವಾತೆ ಹುಯಿರ‍್ಹೇಣು. ತುಮೆ ವಾತೆ ಬೊಲ್ಯಾತೊ ಖ್ಹಮ್‌ಜಾ಼ವಾಳನಾಬಿ ಅಛ಼್ಛು ದೆಖಾವ್‌ಶೆ. <verse eid="EPH 4:29"/><verse number="30" style="v" sid="EPH 4:30"/>ದೇವ್ನ ಪವಿತ್ರಾತ್ಮನ ದುಖ್ ನಕೊ ಕರೊ. ಇನಾಮಸ್ ಛುಟ್ಕಾರ್‌ನ ದನ್ನಖ್ಹಾಜೆ ಮುದ್ರೊ ಲೀರಾಖ್ಯಾಸ್ನಿ. <verse eid="EPH 4:30"/><verse number="31" style="v" sid="EPH 4:31"/>ಖ್ಹಾರು ವಹೇರ್‌, ಇರಾದೊ, ಖೀಜ಼್, ಝ಼ಗ್‍ಡೊ, ಚಾ಼ವ್‌ಣ್ಯ ಅನಖ್ಹಾರನಬಿ ಹರೇಕ್ ಥರಾನು ಖರಾಬ್ ಕಾಮ್ನ ತುಮಾರೇಥಿ ಕಾಡಿನಾಖೊ. <verse eid="EPH 4:31"/><verse number="32" style="v" sid="EPH 4:32"/>ಇನ ಬದಲ್ ಏಕ್‌ಥಿಏಕ್ ದಯಕರವಾಳಬಿ, ಗೋರ್‌ ಕರವಾಳಬಿ ಹುಯಿ‍ರ‍್ಹೆವೊ. ದೇವ್ನೆ ತುಮುನ ಕ್ರಿಸ್ತಮ ಮಾಪ್ ಕರ‍್ಯೊತೆ ಇಮ್ಮಸ್ ತುಮೇಬಿ ಏಕ್‌ಥಿಏಕ್ ಮಾಪ್ ಕರೊ.<verse eid="EPH 4:32"/></para>
  <chapter eid="EPH 4"/>
  <chapter number="5" style="c" sid="EPH 5"/>
  <para style="s">ಉಜಾ಼ಳಮ ಜಿವ್ಣು</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1"/>ದೇವ್ನ ಪ್ಯಾರ್‌ನ ಲಡ್ಕಹುಯಿರ‍್ಹಾಸ್ ಇನಖ್ಹಾಜೆ ಇನಿ ವಾಟ್‌ಪರ್ ಚಾ಼ಲವಾಳ ಹುಯಿ‍ರ‍್ಹೆವೊ. <verse eid="EPH 5:1"/><verse number="2" style="v" sid="EPH 5:2"/>ಕ್ರಿಸ್ತನೆ ಅಪ್ಣುನ ಪ್ಯಾರ್‌ಕರೀನ್ ಅಪ್ಣಖ್ಹಾಜೆ ಇನುಯೋಸ್ ದೇವ್ನ ಢಪ್ಕಾರಬಿ ಕಾಣ್‌ಕೆ ಹುಯಿನ್, ಬಲಿ ಸಮರ್ಪಣ್‌ ಹುಯೋತೆ ಪರಕ್ಮಸ್ ತುಮೇಬಿ ಪ್ಯಾರ್‌ಥಿ ಜಿವೊ. <verse eid="EPH 5:2"/><verse number="3" style="v" sid="EPH 5:3"/>ತುಮೆ ದೇವ್ನ ಲಡ್ಕ ಹುಯಿರ‍್ಹಾಸ್ತೆ ಇನಖ್ಹಾಜೆ ಪಾಪೇಲು ಕಾಮ್ ಅಜು಼ ಖಿವಿ ಥರಾನು ಮೈಲು ನತರ್ ಪೈಶಾನಿ ಆಖ್ಹ್‌ರ‍್ಹವೊ ಅಮ್ನಿ ಖಬರ್ ತುಮಾರಮ ನಾರ‍್ಹೇವ್ಣು, ಅಮ್ನ ಖ್ಹಾರೇಥಿ ದೂರ್ ರ‍್ಹವಾನುಸ್ ತುಮುನ ಅಛ್ಛು಼. <verse eid="EPH 5:3"/><verse number="4" style="v" sid="EPH 5:4"/>ಗಲೀಜ಼್ ವಾತೆ, ಬೇಕಾರ‍್ನಿ ವಾತೆ, ನಕ್ಲೆಕಾಡಿ ಹಾಖ್ಹಾನು ಆಖ್ಹಾರು ನಕೊ. ಆ ಅಖ್ಖು ಖ್ಹಾಜ಼ಕೊಂತೆ ಹುಯಿರ‍್ಹುಸ್. ಅನಬದಲ್, ತುಮೆ ದೇವ್ನ ಧನ್ಯವಾದ್ ಕರೊ. <verse eid="EPH 5:4"/><verse number="5" style="v" sid="EPH 5:5"/>ಪಾಪೇಲ ಕಾಮ್ಮ ಜಾ಼ವಳೊ , ಖರಾಬ್ ಕಾಮ್ ಕರವಾಳು, ಮೂರತ್ನ ಪೂಜ಼ ಕರವಾಳನಿ ಘೋಣಿನೊ ನಿಕ್‍ಳ್ಯ ಜಾನ್ನೊ ರ‍್ಹವೊ ಇವ್ಣುನ ಕ್ರಿಸ್ತನಿ ಅಜು಼ ದೇವ್ನ ರಾಜ್ಯಮ ವಾಟೊ ಕೊಯ್ನಿಕರಿ ತುಮಾರ ದಿಲ್ಮ ಘಟೈರ‍್ಹವಾದೆ. <verse eid="EPH 5:5"/><verse number="6" style="v" sid="EPH 5:6"/>ಫಾಯಿದೊಕೊಂತೆ ವಾತೆಥಿ ಕೋಣ್‌ಬಿ ತುಮುನ ನಕೊ ಠಗಾವದೆ, ಅಮ್ನು ಕಾಮ್ ಅಖ್ಖಾನಖ್ಹಾಜೆ ದೇವ್‌ನೊ ಇರಾದೊ ಇನಿ ವಾತೆನ ಮೀರಿನ್ ಚಾ಼ಲಸ್ತೆ ಇವ್ಣ ಉಪ್ಪರ್ ಆವಸ್. <verse eid="EPH 5:6"/><verse number="7" style="v" sid="EPH 5:7"/>ಇನಾಖ್ಹಾಜೆ ತುಮೆ ಇವ್ಣ ಜೋ಼ಡ್ಮ ಖ್ಹಂಗ್ ನಕೊ ಕರೊ. <verse eid="EPH 5:7"/><verse number="8" style="v" sid="EPH 5:8"/>ಶನಕತೊ ತುಮೆ ಯೋಹಗಾಮ್ಮ ಅಂಧಾರಮ ಥಾ, ಕತೋಬಿ ಹಮ್ಕೆ ತುಮೆ ಪ್ರಭುನ ಅದ್ಮಿ ಹುಯಿರ‍್ಹಿನ್ ಉಜಾ಼ಳವಾಳ ಹುಯಿರ‍್ಹಾಸ್. ಉಜಾ಼ಳವಾಳನಿತರ ಚಾ಼ಲಿಲೆವೊ. <verse eid="EPH 5:8"/><verse number="9" style="v" sid="EPH 5:9"/>ಉಜಾ಼ಳನು ಫಲ್ ಅಛ್ಛಾ಼ಮಾಬಿ ನೀತಿಮಾಬಿ ಅಜು಼ ಖ್ಹಾಚಿಮ ದೆಖಾವಸ್. <verse eid="EPH 5:9"/><verse number="10" style="v" sid="EPH 5:10"/>ಪ್ರಭುನ ಲ್ಹಾಯಕ್ ಶಾತ್‌ಕರಿ ಬೋಲಾನು ತರೀಪ್‌ಶ ಕರೀನ್‌ ಮಾಲುಮ್ ಕರಿಲೆವೊ. <verse eid="EPH 5:10"/><verse number="11" style="v" sid="EPH 5:11"/>ಕಾಯ್‌ಕೊಂತೆ ಅಂಧಾರನ ಕಾಮ್ಮ ವಾಟೊವಾಳ ನಾ ಹುಯಿರ‍್ಹೇಣುತೆ ಅನಬದಲ್ ಉಜಾ಼ಳಮ ದೆಖಾವನಿ ಘೋಣಿ ಕರೊ. <verse eid="EPH 5:11"/><verse number="12" style="v" sid="EPH 5:12"/>ಯೊ ಅದ್ಮಿಖ್ಹಾರು ಗಪ್ಲಥ್ಥಿ ಕರಾಸ್ತೆ ಕಾಮ್ನ ಅನಿಬಾರೇಮ ಬೋಲಾನು ಖ್ಹಾಚಮಾಬಿ ಖ್ಹರಮ್‍ಲಾಗಾನು ಹುಯಿರ‍್ಹುಸ್. <verse eid="EPH 5:12"/><verse number="13" style="v" sid="EPH 5:13"/>ಉಜಾ಼ಳಥಿ ಖ್ಹಾರು ಕಾಮ್ನು ಖ್ಹಾಚು಼ಗುಣ್‌ ದೆಖಾವಸ್. <verse eid="EPH 5:13"/><verse number="14" style="v" sid="EPH 5:14"/>ಶನಕತೊ ಖಿವು ಅಛ್ಛಿನಿತರ ದೆಖಾವಸ್ಕಿ ಯೋಸ್ ದೆಖಾವಸ್, ಇನಖ್ಹಾಜೇಥಿ ಬೋಲೈರ‍್ಹುಸ್. “ಖ್ಹುತೊರ‍್ಹವಾಳ ಉಠಿಆವ್‌, ಮರಿರ‍್ಹವಾಳೆಥಿ ಮ್ಹೇಲಿನ್ ಉಠೊ, ತದೆ ಕ್ರಿಸ್ತ ತುಮಾರಮ ಉಜಾ಼ಖ್ಹ್‌ ಹುಯಿರ‍್ಹಿಶೆಕರಿ ಇನಖ್ಹಾಜೆ ಬೋಲೈರ‍್ಹುಸ್. <verse eid="EPH 5:14"/><verse number="15" style="v" sid="EPH 5:15"/>ಇನಖ್ಹಾಜೆ ತುಮೆ ಚಾ಼ಲ್ ಚ಼ಲಣ್ಣಿ ಬಾರೇಮ ಹೊಷಾರ್‌ಥಿ ರ‍್ಹವೊ. ಬಿಣ್‍ಅಕ್ಲಿ ನಾ ಹುಯಿರ‍್ಹೇಣುತೆ ಅಕ್ಲಿ ಹುಯಿನ್ ಜಿವೊ. <verse eid="EPH 5:15"/><verse number="16" style="v" sid="EPH 5:16"/>ಆ ಮೋಕಾನ ಉಪಯೋಗ್ ಕರಿಲೆವೊ. ಶನಕತೊ ಆ ದನ್ ಖ್ಹಾರು ಖರಾಬ್‌ಥಿ ಭರಾಯುಹುಯು ಹುಯಿರ‍್ಹುಸ್. <verse eid="EPH 5:16"/><verse number="17" style="v" sid="EPH 5:17"/>ಅಜು಼ ಅಕ್ಕಲ್‌ಕೊಂತೆ ಇವ್ಣಿನಿತರ ನಾಚಾ಼ಲ್ನುತೆ ಪ್ರಭುನಿ ಮರ್ಜಿನ ಶಾತ್‌ಕರಿ ಮಾಲುಮ್ ಕರಿಲೆವೊ. <verse eid="EPH 5:17"/><verse number="18" style="v" sid="EPH 5:18"/>ದ್ರಾಕ್ಷಿನೊರಖ್ಹ್ ಪೀನ್ ಕಯೇಪ್ ನಕೊ ಛ಼ಡೈಲೆವೊ. ಇನೇಥಿ ಪಾಪ್ ಕರಾನ ಝ಼ಗೊ ಮಳಾಸ್, ಕತೋಬಿ ಪವಿತ್ರಾತ್ಮಥಿ ಭರೈನ್, <verse eid="EPH 5:18"/><verse number="19" style="v" sid="EPH 5:19"/>ಗೀದ್‍ಥೀಬಿ, ಸ್ತುತಿ ವಚನ್‌ಥಿಬಿ, ಆತ್ಮೀಕ್ ಲ್ಹೂರ್‌ನು ಗೀದ್‍ಥಿಬಿ ಏಕ್‌ಥಿಏಕ್ ವಾತೆ ಬೋಲ್ತಹುಯಿನ್ ತುಮಾರ ದಿಲ್ಮ ಪ್ರಭುನ ಸ್ತುತಿನು ಗೀದ್‌ ಬೋಲೊ. <verse eid="EPH 5:19"/><verse number="20" style="v" sid="EPH 5:20"/>ಕೆದೇಬಿ ಖ್ಹಾರ ಕಾಮ್ನಖ್ಹಾಜೆ ಅಪ್ಣೊ ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತನ ನಾಮ್ಮ ಬಾ ಹುಯಿರ‍್ಹೋತೆ ದೇವ್ನ ಧನ್ಯವಾದ್ ಕರೊ.<verse eid="EPH 5:20"/></para>
  <para style="s">ಬಾವಣ್‍ ಅಜು಼ ಬಾವ್ರಿಯೆ</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21"/>ಕ್ರಿಸ್ತನ ಡರ್‌ಭಕ್ತಿವಾಳ ಹುಯಿರ‍್ಹಿನ್, ಏಕ್‌ಥಿಏಕ್ ಸಮರ್ಪಣ್‌ಥಿ ಚಾ಼ಲಿಲೆವೊ. <verse eid="EPH 5:21"/><verse number="22" style="v" sid="EPH 5:22"/>ತಯೆಡಾವೊ, ತುಮೆ ಪ್ರಭುಮ ಕಿಮ್ಕಿ ಇಮ್ಮಸ್ ತುಮಾರ ಬಾವ್ರಿಯೇನಿ ದಾಬುಕ್ಮ ರ‍್ಹವೊ. <verse eid="EPH 5:22"/><verse number="23" style="v" sid="EPH 5:23"/>ಶನಕತೊ ಕ್ರಿಸ್ತ ಸಬೆನ ಮುಡ್‌ಕ್ಯು ಹುಯಿರ‍್ಹೋಸ್ತೆ ಇಮ್ಮಸ್ ಬಾವ್ರಿ ಬಾವಣ್ಣ ಮುಡ್‌ಕ್ಯು ಹುಯಿರ‍್ಹೊಸ್. ಕ್ರಿಸ್ತಸ್ ಯೊ ಸಬೆಕರಿ ಶರೀರ್‌ನ ರಕ್ಷಕ್ ಹುಯಿರ‍್ಹೋಸ್. <verse eid="EPH 5:23"/><verse number="24" style="v" sid="EPH 5:24"/>ಸಬೆ ಕ್ರಿಸ್ತನಿ ದಾಬುಕ್ಮ ಕಿಮ್ ರ‍್ಹೇಸ್ಕಿ ಇಮ್ಮಸ್ ತಯೇಡಖ್ಹಾರು ಇವ್ಣ ಬಾವ್ರಿಯೇನ ಖ್ಹಾರಿಸ್ ವಿಚಾರ್‌ಮ ದಾಬುಕ್ಮ ರ‍್ಹೇವ್ಣು. <verse eid="EPH 5:24"/><verse number="25" style="v" sid="EPH 5:25"/>ಬಾವ್ರಿಯೆ, ಕ್ರಿಸ್ತ ಸಬೆನ ಪ್ಯಾರ್ ಕರಿನ್ ಜಾನ್‌ ದಿದೋತೆ ಇಮ್ಮಸ್ ತುಮಾರಿ ಬಾವ್ಣೆನ ಪ್ಯಾರ್‌ಕರೊ. <verse eid="EPH 5:25"/><verse number="26" style="v" sid="EPH 5:26"/>ದೇವ್ನೆ ಇನ ಶುದ್ದ ಕರಾನಖ್ಹಾಜೆ ಇನುಯೋಸ್ ಸಮರ್ಪಣ್‌ ಕರೈಲಿದೊ. <verse eid="EPH 5:26"/><verse number="27" style="v" sid="EPH 5:27"/>ಇನಖ್ಹಾಜೆ ಕಳಂಕ್‌ನಿ ದಾಗ್ ನಾ ರ‍್ಹೇವ್ಣುತೆ ಪರಿಶುದ್ಧಬಿ, ದೋಷ್‌ಕೊಂತೇಬಿ, ಮಹಿಮೆಥಿ ರ‍್ಹವಾನಿ ಸಬೆಕರೀನ್ ಇನಖ್ಹಾಮ್ಣೆ ಭೀರಖಡ್ನುಕರಿ ಭೋದನೆನ ಜೋ಼ಡೆಸ್ ಪಾಣಿಥಿ ನೊಹಾಡಿನ್ ಶುದ್ದಕರ‍್ಯೊ. <verse eid="EPH 5:27"/><verse number="28" style="v" sid="EPH 5:28"/>ಇಮ್ಮಸ್ ಬಾವ್ರಿಯೇಬಿ ಇವ್ಣ ಶೊಂತ್ ಶರೀರ್‌ನ ಪ್ಯಾರ್ ಕರಾಸ್ತೆ ಇಮ್ಮಸ್ ಇವ್ಣಿ ಬಾವ್ಣೆನ ಪ್ಯಾರ್ ಕರಾವಾಳ ಹುಯಿರೇವ್ಣು. ಇನಿ ಬಾವಣ್ಣ ಪ್ಯಾರ್ ಕರಾವಾಳೊ ಇನಾಸ್ ಪ್ಯಾರ್ ಕರಾವಾಳೊ ಹುಯಿರ‍್ಹೋಸ್. <verse eid="EPH 5:28"/><verse number="29" style="v" sid="EPH 5:29"/>ಕೋಣ್‌ಬಿ ಕದೇಬಿ ಶೊಂತ್‌ ಶರೀರ್‌ನ ವಹೇರ್‌ ಕೊಕರಾನಿ, ಇನ ಬದಲ್ ಅಖ್ಖೂಜ಼ಣು ಇವ್ಣ ಶರೀರ್‌ನ ಖ್ಹದ್ದರ್‌ಥಿ ಪಾಳಸ್. ಕ್ರಿಸ್ತ ಇಮ್ಮಸ್ ಪಾಳಿನ್ ಖ್ಹದ್ದರ್‌ ಕರ್ತೊ ಆಯೊ. ಇಮ್ಮಸ್ ಸಬೇನಾಬಿ ಕರ‍್ನು. <verse eid="EPH 5:29"/><verse number="30" style="v" sid="EPH 5:30"/>ಇನಖ್ಹಾಜೆ ಸಬೆಕರಿ ಶರೀರ್‌ನ ಅಪ್ಣೆ ಖ್ಹಂದೊಅಖ್ಖು ಹುಯಿರ‍್ಹಾಸ್. <verse eid="EPH 5:30"/><verse number="31" style="v" sid="EPH 5:31"/>ಪವಿತ್ರ ದಪ್ತರ್‌ಮ ಅಮ್ ಲಿಖೈರ‍್ಹುಸ್ ಅನಖ್ಹಾಜೆಸ್ ಪರ್ಖ್ಹೊ ಆಯ-ಬಾನ ಮ್ಹೇಲಿನ್ ಇನಿ ಬಾವಣ್‍ಥಿ ಮಳಾಸ್, ಇವ್ಣೆ ಎಕ್ಕಸ್ ಶರೀರ್ ಹುಯಿರಾಸ್‍ಕರಿ ಬೋಲಸ್. ಅಜು಼ ಇವ್ಣೆ ಬೇಜ಼ಣ ಎಕ್ಕಸ್ ಹುಯಿರಾಸ್.<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt"><ref loc="GEN 2:24">ಆದಿಕಾಂಡ 2:24</ref></char></note> <verse eid="EPH 5:31"/><verse number="32" style="v" sid="EPH 5:32"/>ಮೆ ಕ್ರಿಸ್ತನಾಬಿ ಸಬೇನಾಬಿ ಛಾ಼ತೆ ಸಂಬಂದನಿ ಬಾರೇಮ ಬೋಲುಕರುಸ್, ಹಮ್ಕೆತೋಡಿ ಗಧಾರ್‌ಥಿ ಲಪಿರ‍್ಹುತೆ ಖ್ಹಾಚು಼ ಹುಯಿರ‍್ಹುಸ್. <verse eid="EPH 5:32"/><verse number="33" style="v" sid="EPH 5:33"/>ಯೊ ತುಮುನಾಬಿ ಹುವಾಸ್, ತುಮಾರಮ ಹರೇಕ್ ಬಾವ್ರಿ ಇನುಯೋ ಪ್ಯಾರ್ ಕರಾನಿತರಸ್ ಇವ್ಣಿ ಬಾವ್ಣೆನ ಪ್ಯಾರ್ ಕರ‍್ನು. ಅಖ್ಖಿ ಬಾವಣ್‍ ಇವ್ಣ ಬಾವ್ರಿಯೇನ ಇಜ಼್ಜಥ್ಥಿ ಚಾ಼ಲಿಲೇವ್ಣು.<verse eid="EPH 5:33"/></para>
  <chapter eid="EPH 5"/>
  <chapter number="6" style="c" sid="EPH 6"/>
  <para style="s">ಆಯ ಬಾ ಅಜು಼ ಲಡ್ಕಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1"/>ಲಡ್ಕಾವೊ, ತುಮೆ ಪ್ರಭುಮ ರ‍್ಹಾವವಾಳನಿತರಸ್ ತುಮಾರ ಆಯಬಾನ ಹೇಟು ಹುಯಿ‍ರ‍್ಹೆವೊ. ಆ ನ್ಯಾವ್‌ನು ಹುಯಿರ‍್ಹುಸ್. <verse eid="EPH 6:1"/><verse number="2" style="v" sid="EPH 6:2"/>ವಾಗ್ದಾನ್‌ಮ ಛಾ಼ತೆ ಪಹಿಲಿ ಹುಕುಮ್‌ನ ಖ್ಹಮ್‌ಜೊ಼, “ತುಮಾರ ಆಯ ಬಾನ ಮರ್ಯಾದಿ ದೇವ್ಣು”. <verse eid="EPH 6:2"/><verse number="3" style="v" sid="EPH 6:3"/>“ಅನ ಚ಼ಲಾಯತೊ ತುಮುನ ಅಛ್ಛು಼ ಉಷೆ, ಅಜು಼ ತುಮೆ ಜ಼ಮೀನ್‌ಪರ್ ಘಣ ವರಖ್ಹ್ ಜಿವ್‌ಶು”.<note caller="-" style="x"><char style="xo" closed="false">6:3 </char><char style="xt"><ref loc="EXO 20:12">ವಿಮೋಚನ 20:12</ref></char></note> <verse eid="EPH 6:3"/><verse number="4" style="v" sid="EPH 6:4"/>ಆಯ ಬಾವೊ, ತುಮಾರ ಲಡ್ಕಾನ ಛೇಡಾವ್ಣುನಾತೆ, ಪ್ರಭುನ ಲ್ಹಾಯಕ್‌ ಹುವಾನಿ ಪರಕ್ಮ ಇವ್ಣುನ ದಾಬುಕ್ಮ ಚಾ಼ಲನು ಶಿಕಾಡಿನ್ ಪಾಳಿ ಪರ್ವೆಶಿಕರೊ.<verse eid="EPH 6:4"/></para>
  <para style="s">ಯಜಮಾನ್‌ಖ್ಹಾರು ಅಜು಼ ಗುಲಾಮ್‌ಖ್ಹಾರು</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5"/>ಆಳ್‍ಖ್ಹಾರ, ಆ ಜಗತ್ನ ಯಜಮಾನ್ ಹುಯಿರ‍್ಹವವಾಳನ ಕ್ರಿಸ್ತನಿ ದಾಬುಕ್ಮ ಕಿಮ್ ರ‍್ಹೇಸ್ಕಿ ಇಮ್ಮಸ್ ದಿಲ್ಮ ಡರ್‌ಥಿ ಕಾಪವಾಳಹುಯಿರ‍್ಹೀನ್ ಛು಼ಟ ದಿಲ್‌ವಾಳಹುಯಿನ್ ದಾಬುಕ್ಮ ರ‍್ಹವೊ. <verse eid="EPH 6:5"/><verse number="6" style="v" sid="EPH 6:6"/>ಅದ್ಮಿಖ್ಹಾರು ಪಸಂದ್ ಕರಾನಿತರ ಛಾ಼ರ್ವಣಿನಖ್ಹಾಜೆ ಯಜಮಾನ್ ದೇಖುಕರಾನಿ ವಖ್ಹ್‌ತೆ ಖಲಿ ಕಾಮ್ ನಾಕರ‍್ನುತೆ, ಕ್ರಿಸ್ತನಿ ಆಳ್‌ನಿಘೋಣಿ ದೇವ್ನಿ ಮರ್ಜಿನ ಪೂರ ಮನ್‌ಥಿ ಚಾ಼ಲಿಲೆವೊ. <verse eid="EPH 6:6"/><verse number="7" style="v" sid="EPH 6:7"/>ತುಮೆ ಕರಾನು ಸೇವೆ ಅದ್ಮಿನಾಸ್ ಕಾಹೆತೆ, ಪ್ರಭುನ ಖ್ಹಾಜೇಥಿ ಕಾಮ್ ಕರುಕರೆಸ್ ಕರಿ ಪೂರ ಮನ್‌ಥಿ ಸೇವೆಕರೊ. <verse eid="EPH 6:7"/><verse number="8" style="v" sid="EPH 6:8"/>ಶನಕತೊ ಏಕ್‍ಜ಼ಣೊ ಆಳ್‌ ಹುಯಿ‍ರ‍್ಹೆವೊ ಛು಼ಟ್ಕಾರ್‌ವಾಳು ಹುಯಿ‍ರ‍್ಹೆವೊ ಇವ್ಣೆ ಶಾತ್ ಅಛ಼್ಛುಕಾಮ್ ಕರಾಸ್ಕಿ ಇನು ಇನಾಮ್ ಪ್ರಭುಥಿ ಲೀಲಿಶ್ ಕರಿ ತುಮುನ ಮಾಲುಮ್ ಛಾ಼. <verse eid="EPH 6:8"/><verse number="9" style="v" sid="EPH 6:9"/>ಯಜಮಾನವೊ, ತುಮಾರ ಆಳ್ನಿ ಬಾರೇಮ ಇಮ್ನಿ ಪರಕ್ಮಸ್ ಚಾ಼ಲಿಲೆವೊ. ತುಮಾರ ಆಳ್‌ನ ಡರಾವನು ಭೀರಾಕಿ ದೆವೊ. ಪರ್‌ಲೋಕ್‌ಮ ತುಮುನಬಿ ಇವ್ಣುನಾಬಿ ಯಜಮಾನ್ ಹುಯಿರ‍್ಹೋಸ್ತೆ ದೇವ್‌ಬಿ ಇನಾಮ ಬೇದ್‌ಭಾವ್‌ ಕೊಯ್ನಿಕರಿಬಿ ಮಾಲುಮ್ ಕರಿಲೆವೊ.<verse eid="EPH 6:9"/></para>
  <para style="s">ದೇವ್ನು ಬಚಾ಼ಡನು ಕವಚ್</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10"/>ಖ್ಹರ್ತಿಮ, ತುಮೆ ಪ್ರಭುಮಾಬಿ ಇನಿ ಘಣಿ ಮೋಟಿ ಶಕತ್‍ಮಾಬಿ ತಾಖತ್‍ವಾಳ ಹುವೊ. <verse eid="EPH 6:10"/><verse number="11" style="v" sid="EPH 6:11"/>ಶೈತಾನ್ನಿ ಲಝ಼ಣ್‌ನ ತುಮೆ ವಿರೋದ್‌ಕರಿನ್ ಭಿರಾವನಖ್ಹಾಜೆ ದೇವ್ ದೇಸ್ತೆ ಖ್ಹಾರ ಕಫ್ಪನ್ನ ಫೆರಿಲೆವೊ. <verse eid="EPH 6:11"/><verse number="12" style="v" sid="EPH 6:12"/>ಶನಕತೊ ಅಪ್ಣೆ ಲಡಾನು ಖಲಿ ಅದ್ಮಿನ ಜೋ಼ಡೆ ಕಾಹೆ. ಕತೋಬಿ ಅಪ್ಣಿ ಖ್ಹೂಜ಼್‌ ರಾಜ಼್‌ನ ಉಪ್ಪರ್‌ಬಿ, ಅದಿಕಾರಿನ ಉಪ್ಪರ್‌ಬಿ, ಆ ಅಂಧಾರನಿ ಜಗತ್ನಿ ಅದಿಪತಿನ ಉಪ್ಪರ್‌ಬಿ, ಆಸ್ಮಾನ್ನ ಗೋಳಾಮ ಛಾ಼ತೆ ನಾಶ್ ಕರಾನಿ ಆತ್ಮಾನಿ ದಂಡ್ ಉಪ್ಪರ್‌ಬಿ, ಅಪ್ಣೆ ಲಡವಾಳ ಹುಯಿರ‍್ಹಾಸ್. <verse eid="EPH 6:12"/><verse number="13" style="v" sid="EPH 6:13"/>ಇನಾಖ್ಹಾಜೆ ಯೊ ಖರಾಬ್ ದನ್ಮ ವಹೇರ‍್ಯಖ್ಹಾರಾನ ಭಿಡಾನಖ್ಹಾಜೇಬಿ ಕರ್ನುತೆ ಖ್ಹಾರಕಾಮ್ನ ಕರೀನ್ ಘಟ್‍ಥಿ ಭಿರ‍್ಯಾವನ ಖ್ಹಾಜೆ ಅಜು಼ ಇನಪಾರ್ ಶಕತ್‌ವಾಳ ಹುವಾನಿತರ ದೇವ್ ದೇಸ್ತೆ ಅಖ್ಖಿ ಕಫ್ಪನ್ನ ಧರಿಲೆವೊ.<figure style="fig" alt="Roman soldier" file="lb00196c.tif" size="col" copy="Horace Knowles ©" ref="6:10">ರೋಮ್‌ನೊ ಶಿಪಾಯಿ</figure><verse eid="EPH 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14"/>ಇನಖ್ಹಾಜೆ ಖ್ಹಾಚಿನಸ್ ಕಂಬರ್‌ನು ಕಷ್‌ಬಂದ್‌ ಕರಿ ಭಾಂದಿಲೀನ್, ನೀತಿನಸ್ ಛಾ಼ತಿನ ಕವಚ್ ಕರಿ ಫೆರೀನ್, <verse eid="EPH 6:14"/><verse number="15" style="v" sid="EPH 6:15"/>ಸಮಾಧಾನ್ನಿ ಸುರ್ವಾತೆನ ಬೋಲಿ ವತಾಳನಖ್ಹಾಜೆ ತಯಾರ‍್ನೊ ದಿಲ್‌ಕರಿ ಬೋಲಾನು ಚಪ್ಲೇನ ಘಾಲಿನ್ ಭೀರೆವೊ. <verse eid="EPH 6:15"/><verse number="16" style="v" sid="EPH 6:16"/>ಅಖ್ಖೇಥಿ ಜಾ಼ಖ್ಹತ್ ವಿಶ್ವಾಸ್‌ ಕರಿ ಢಾಲ್ನ ಧರಿಲೆವೊ. ಇನೇಥಿ ತುಮೆ ವಹೇರ‍್ಯಾನಿ ಆಗ್‍ನಿ ತೀರ‍್ನ ಆಡುಕರಾನ ಶಕತ್‌ವಾಳ ಹುಯಿರ‍್ಹಿಶು. <verse eid="EPH 6:16"/><verse number="17" style="v" sid="EPH 6:17"/>ಆಬಿ ಕಾಹೆತೆ ರಕ್ಷಣೆಕರಿ ಮುಡ್‌ಕ್ಯಾನು ಕವಚ್‌ನ ಘಾಲಿಲೀನ್‌ ಪವಿತ್ರಾತ್ಮ ದೇಸ್ತೆ ದೇವ್ನಿ ವಚನ್ ಕರಿಬೋಲಾನು ತಲ್ವಾರ್‌ನ ಧರಿಲೆವೊ. <verse eid="EPH 6:17"/><verse number="18" style="v" sid="EPH 6:18"/>ತುಮೆ ಪವಿತ್ರಾತ್ಮಥಿ ಭರೈನ್ ಖ್ಹಾರಿ ವಖ್ಹತ್‌ಮ ಹರೇಕ್ ತರಿಕಾನಿ ಪ್ರಾರ್ಥನೆಥಿಬಿ ಬಿಂತೀನಿವ್ಹಾರ್ಥೀಬಿ ದೇವ್ನ ಪ್ರಾರ್ಥನೆ ಕರೊ. ಅನಾಮ ಏಕ್‌ ಖ್ಹಯಾಲ್‌ವಾಳು ಹುಯಿನ್ ದೇವ್ನ ಅದ್ಮಿ ಖ್ಹಾರಾನಿ ಬಾರೇಮ ಬಿಂತಿಕರ‍್ತಹುಯಿನ್ ಜ಼ತನ್‌ಥಿ ರ‍್ಹವೊ. ಅಖ್ಖಾಸ್ ಅದ್ಮಿನಖ್ಹಾಜೆ ಹಮೇಶ ಪ್ರಾರ್ಥನೆ ಕರಾನು ನಕೊ ಮ್ಹೇಲೊ. <verse eid="EPH 6:18"/><verse number="19" style="v" sid="EPH 6:19"/>ಮಾರಖ್ಹಾಜೆಬಿ ಪ್ರಾರ್ಥನೆ ಕರೊ ಮೆ ವಾತೆ ಬೋಲಾನ ಮ್ಹೋಡು ಛೋ಼ಡಾನಿ ವಖ್ಹ್‌ತೆ ಅಗ್‍ಲ್ಯ ಹಗಾಮ್ಮ ಲಪಿಥಿತೆ ಸುವಾರ್ತೆನಿ ಖ್ಹಾಚಿನ ಡರ್‌ಕೊಂತೆ ಬೋಲಾನಖ್ಹಾಜೆ ಹೋಣುತೆ ವಾತೆನ ದೇವ್ ಮನ ದ್ಯವಾದೆ. <verse eid="EPH 6:19"/><verse number="20" style="v" sid="EPH 6:20"/>ಯೊ ಅಛ್ಛಿ ಸಂದೇಶ್ನ ಲೀಜಾ಼ವಳೊ ಹುಯಿರ‍್ಹೋತೆ ಮೆ ಜೇಲ್‌ಮ ಖ್ಹಂಕಳ್‌ಥಿ ಬಂಧಿಹುಯಿನ್ ಪಡ್ಯೊಸ್. ಇನಿ ಬಾರೇಮ ಮೆ ಬೋಲ್ನುತೆ ಇಮ್ಮಸ್ ಭಾಲಿಥಿ ಮೆ ಬೋಲಾನಿತರ ಮಾರ ಖ್ಹಾಜೆ ಬಿಂತಿಕರೊ.<verse eid="EPH 6:20"/></para>
  <para style="s">ಖ್ಹರ್ತಿನಿ ಖ್ಹಲಾಮ್</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21"/>ಮಾರಿ ಬಾರೇಮ ಮಾರು ಕಾಮ್ ಖ್ಹಾರು ತುಮುನ ಮಾಲುಮ್ ಹೋಣುಕರಿ ಪ್ಯಾರ್‌ನೊ ಭೈಬಿ ಪ್ರಭುಮ ವಿಶ್ವಾಸ್‌ವಾಳೊ ಸೇವೆಮ ಛಾ಼ತೆ ತುಖಿಕ ತುಮುನ ಅಖ್ಖು ಬೋಲಿದಿಶೆ. <verse eid="EPH 6:21"/><verse number="22" style="v" sid="EPH 6:22"/>ತುಮೆ ಹಮಾರಿ ಬಾರೇಮ ಮಾಲುಮ್‌ಕರಿಲೇವ್ಣು ಕರಿಬಿ, ಯೊ ತುಮಾರ ದಿಲ್ನಖ್ಹಾರು ಭಾಲಿ ದೇವ್ಣುಕರೀಬಿ ಇನ ತುಮಾರಕನ ಮೋಕ್ಲಿರಾಖ್ಯೊಸ್. <verse eid="EPH 6:22"/><verse number="23" style="v" sid="EPH 6:23"/>ಬಾ ದೇವ್‌ಥಿಬಿ ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತಥಿಬಿ ಶಾಂತಿಬಿ, ವಿಶ್ವಾಸ್‍ಥಿ ರ‍್ಹವಾನಿ ಪ್ಯಾರ್ ಅಖ್ಖಾಸ್ ವಿಶ್ವಾಸಿ ಭೈಯೇ ಭೇನೆನ ಮಾಲುಮ್ ಹುವಾದೆ. <verse eid="EPH 6:23"/><verse number="24" style="v" sid="EPH 6:24"/>ಅಪ್ಣೊ ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತನ ಹಮೇಶಾಬಿ ಪ್ಯಾರ್ ಕರಾವಾಳ ಅಖ್ಖಾಸ್‌ಪರ್ ದೇವ್ನಿ ವಾರ್‌ಖ್ಹೊ ರ‍್ಹವಾದೆ.<verse eid="EPH 6:24"/></para>
  <chapter eid="EPH 6"/>
</usx>
