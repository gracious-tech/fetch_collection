<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EST" style="id">- Waghri Vathe</book>
  <para style="h">ಎಸ್ತೇರ</para>
  <para style="toc3">ಎಸ್ತೇರ</para>
  <para style="toc2">ಎಸ್ತೇರ್</para>
  <para style="toc1">ಎಸ್ತೇರ್</para>
  <para style="mt1">ಎಸ್ತೇರ್‌</para>
  <para style="imt">ಶುರುವಾತ್‌</para>
  <para style="ip">ಎಸ್ತೇರ್‌ ಪುಸ್ತಕ ಪರ್ಷಿಯಾಮ ಬಂಧಿಹುಯಿರುಥುತೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳಾನ ವಹೇರ‍್ಯಾಥಿ ಕಿಮ್ ಬಚಾ಼ಡ್ಯುಕರಿ ಬೋಲಸ್‌. ಇಸ್ರಾಯೇಲ್‌ವಾಳಾನ ನಾಶಕರ‍್ನುಕರಿ ಸೋಚುಕರ್ತುಥು. ಎಸ್ತೇರ್‌ ಪುಸ್ತಕಮ ದೇವ್ನು ನಾಮ್ನ ನಾಬೋಲಿರಾಖ್ಯುತೋಬಿ ದೇವ್ತೊತೊ ಛ಼ಾಸ್‌ ಛಾ಼. ಯೇಹೂದಿವಾಳಾನ ಮಾರಿನಾಕ್ಣುಥುತೆ ಇವ್ಣಿ ಕೋಶಿಶ್‍ಥಿ ಇವ್ಣುನ ಛುಟ್ಕಾರ್ ಕರಾಯು. ಎಸ್ತೇರ್‌ ಪುಸ್ತಕನ ಕಿನೆ ಲಿಖ್ಯುಕರಿ ಕೀನಾಬಿ ಮಾಲುಮ್‌ಕೊಯ್ನಿ. ಅನ ಅಧಾರ್‌ನಿ ಚಾಲವ್ಣಿಮಥುತೆ ಹಿಬ್ರುನಿ ವಾತೆಮ ಬೋಲ್ನುಕತೊ ಎಸ್ತೇರ್‌ ಪುಸ್ತಕ ಕ್ರಿ.ಪೂ 400 ಮಾ ಲಿಖೈರುಸ್‌ಕರಿ ಕೈಏಕ್‌ ಪೊಂಡಿತ್‌ಖ್ಹಾರು ಬೋಲಸ್‌.</para>
  <para style="ip">ಎಸ್ತೇರ್‌ ಪುಸ್ತಕಮ ಬೋಲಸ್ತೆ ಸಮಾಚಾರ್‌ ಪೂರಿಮ್‌ ಜ಼ತ್ರಾನಿ ಯೆಹೂದಿನಿ ಪದತ್ತಿನ ಕಿಮ್ ವತಾಳಸ್‌ ಅಜು಼ ಕಿಮ್ ಶುರುಹುಯುಕರಿ ಮಾಲುಮ್‌ ಕರಾವಸ್‌. ಹಮಾನ್‌ಕರಿ ಏಕ್‌ಜ಼ಣೊ ಅಮಾಲೇಕ್ಯವಾಳೊ ಯೆಹೂದಿ ಅದ್ಮಿವೋನ ನಾಶ್‌ಕರಾನ ಏಕ್‌ ಖ್ಹೂಜ಼್‌ಕರ‍್ಯೊ. ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಜ಼ಂಗಳ್ಮಾಥು ದೇವ್ನ ದೇಖ್ಹ್‌ನ ಪೋಚ್ಯು಼ತೆ ತಪ್‌ಥು ಅಮಾಲೇಖ್ಯವಾಳು ವೈರಿಹುಯಿರುಥು. ಇವ್ಣುನ ವಾಗ್ದಾನ್ ಕರಿರಾಖ್ಯುತೆ ತಿಮ್ ಹಮಾನನೆ ಯೆಹೂದಿವಾಳಾನ ನಾಶಕರಾನ ವೇಳ್ಮಾಸ್ ಯೆಹೂದಿ ಹುಯಿರ‍್ಹಿಥೀತೆ<char style="xt"><ref loc="EXO 17:1-16">ವಿಮೋ 17:1-16</ref></char> ಎಸ್ತೇರ್‌ ಪರ್ಷಿಯಾನಿ ರಾಣಿಹುಯಿ. ಇನೊ ಸಂಬಂದಿ ಮೋರ್ದಕೈನಿ ಚಿತಾವ್ಣಿಥಿ ಎಸ್ತೇರ್‌ ಹಾಮಾನನಿ ಕೋಶಿಶ್‌ನ ಭೀರಾಖನ ಹುಯು. ಯೆಹೂದಿವಾಳು ಇವ್ಣ ವೈರಿವೋನ ಜೂತ್ಯುತೆ ಇನಕೇಡೆಥು<char style="xt"><ref loc="EST 9:20-22">ಎಸ್ತೇರ 9:20-22</ref></char>. ಯೆಹೂದಿವಾಳು ಜೂತ್ಯುತೆ ಇನಖ್ಹಾಜೆ ಪೂರಿಮ್‌ ಜ಼ತ್ರಾನ ಶುರುಕರ‍್ಯು.</para>
  <para style="iot">ಕಾಡಿದೇಖೊ</para>
  <para style="io1">1. ಅಧ್ಯಾಯ 1 ಅಜು಼ 2 ಮಾ ಎಸ್ತೇರ್‌ ಕಿಮ್ ಪರ್ಷಿಯಾನಿ ರಾಣಿಹುಯಿ ಕರಿ ಮಾಲುಮ್‌ ಕರಾವಸ್.</para>
  <para style="io1">2. ಅಧ್ಯಾಯ 3 ಥುಧರೀನ್‌ 7 ಲಗು ಹಾಮಾನ ಯೆಹೂದಿವಾಳಾನ ನಾಶಕರಾನ ಕಿಮ್ ಸೋಚ್ಯೊ ಅಜು಼ ಅನ ಕರಾನಜೈ಼ನ್‌ ಮರಿಗಯೊತೆ.</para>
  <para style="io1">3. ಅಧ್ಯಾಯ 8 ಥು ಧರೀನ್‌ 10 ಲಗು ಯೆಹೂದಿವಾಳು ಇವ್ಣ ವೈರಿವೋನ ಹರಾಯುತೆ. ಅಜು಼ ಪೂರಿಮ್‌ ಪದತ್ತಿನ ಕಿಮ್ ಲಾಯುಕರಿ ಬೋಲಸ್‌.</para>
  <chapter number="1" style="c" sid="EST 1" />
  <para style="s">ಅಹಷ್ವೇರೋಷ ರಾಜ಼ನ ವಷ್ಟಿ ರಾಣಿಥಿ ವಿರೋದ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 1:1" />ಭಾರತ ದೇಖ್ಹ್‌ಥು ಧರೀನ್ <note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">ಇಥಿಯೋಪಿಯ ಹಿಬ್ರುನು ನಾಮ್‌ ಕೂಷ್</char></note>ಇಥಿಯೋಪಿಯ ದೇಖ್ಹ್‌ಲಗೂಬಿ ಥೂತೆ ಏಕ್‌ಖ್ಹೊ ಖ್ಹಾತ್‌ಉಪ್ರೀಖ್ಹ್‌ ದೇಖ್ಹ್‌ನ ಅಹಷ್ವೇರೋಷ ರಾಜ಼ ರಾಜ಼್‌ಭಾರ್‌ ಚ಼ಲವ್‌ಕರ್ತೊಥೊ. <verse eid="EST 1:1" /><verse number="2" style="v" sid="EST 1:2" />ಅಹಷ್ವೇರೋಷ ರಾಜ಼ ಇನು ರಾಜ಼ಧಾನಿ ಹುಯಿರೂಥೂತೆ ಶೂಷನ್ ಖ್ಹಯೇರ್‌ಮ ರಾಜ಼ನು ಸಿಂಹಾಸನ್‌ಪರ್ ಬೇಶಿನ್ ಹುಕುಮ್ ಚ಼ಲವ್‌ಕರ್ತೊಥೊ. <verse eid="EST 1:2" /><verse number="3" style="v" sid="EST 1:3" />ಇನು ತೀನ್ನ ವರಖ್ಹ್‌ಮ ಇನು ಖ್ಹಾರೂಸ್ ಮೋಟ ಅಧಿಕಾರಿಯೇನ ಅಜು಼ ಪರಿವಾರ್‌ವಾಳನಾಬಿ ಎಕ್ ಮಿಝ಼್‌ವಾನ್‌ ಪಿಕಾಯೊ. ಪರ್ಷಿಯ ಅಜು಼ ಮೇದ್ಯ ದೇಖ್ಹ್‌ನು ಸೈನ್ಯಾದಿಕಾರಿಖ್ಹಾರುಬಿ ರಾಜ್ಯಪಾಲಬಿ ರಾಜಧಾನಿನು ಅದಿಕಾರಿಯೇಬಿ ಖ್ಹಾರೂಸ್ ರಾಜ಼ನ ಖ್ಹಾಮ್ಣೆ ಆಯಿರ‍್ಹುಥು. <verse eid="EST 1:3" /><verse number="4" style="v" sid="EST 1:4" />ರಾಜ಼ನೆ ಛೋ಼ ಮಹಿನಲಗೂಬಿ ಇನು ಮಹಾನ್ ರಾಜ್ಯನು ಧನ್‍ದೌಲತ್‌ನಾಬಿ, ರಾಜ಼್‌ಭೋಗ್‌ನಾಬಿ, ಅಲೇಲ್‌ಥಲೇಲ್‌ನಾಬಿ ಇವ್ಣಖ್ಹಾರಾಸ್‌ನ ಖ್ಹಾಮ್ಣೆ, ವತಾಳ್ಯೊ. <verse eid="EST 1:4" /><verse number="5" style="v" sid="EST 1:5" />ಇನಾಪಾರ್ ರಾಜ಼ನೆ ಶೂಷನ್ ಖ್ಹಯೇರ್‌ಮಾನು ಅದ್ಮೇವ್‌ನ ಶೌಕಾರ್, ಗರೀಬ್‌ಕರಿ ಶನೂ ಕಚ಼್ಚರಸ್‌ ಕರ‍್ಯೊಕೊಂತೆ ಖ್ಹಾರಸ್ನ ಮಹೇಲ್‌ನ ಬಗೀಚಾ಼ಮ ಖ್ಹಾತ್‌ದನ್‌ಲಗೂಬಿ ಮೊಟು ಮಿಝ಼್‌ವಾನ್ ಪಿಕಾಯೊ. <verse eid="EST 1:5" /><verse number="6" style="v" sid="EST 1:6" />ಯೊ ಬಗೀಚ಼ಾನ ಖ್ಹಾಮ್ಣೆ ಧೋಳು, ಹರ‍್ಯು, ರಾಯಿಜಾ಼ಮಣ್ಣೊ ರಂಗ್‌ನು ಪಡ್‌ದಖ್ಹಾರುಬಿ, ಲಲೇಲಾಲ್‌ರಂಗ್‌ನು ವಣ್ಕರ್‌ನಿ ಡೋರಿಥಿಬಿ ನರ್ವರಿನಬಂಡಾನ ಖಂಬಾವ್‌ನ ರೂಪಾನಿ ಅಂಗುಠಿಯೇಥಿ ಶನ್‌ಗಾರ್‌ಹುಯಿರ‍್ಹುಥು. ರೇಖ್ಹಮ್‌ನ ಧಾಗೇಥಿ ವಣಿನ್‌ ಬಣಾಯುಹುಯು ರೂಪಾನಿ, ಖ್ಹೊನ್ನಾನಿ ಆರಾಮ್ನಿಖುಡ್‌ಶಿಯೆ, ಲಾಲ್, ಧೋಳು, ಪೀಳು ಅಜು಼ ಕಾಳರಂಗ್‌ನು ನರ್‌ವರಿನ ಬಂಡಾಥಿ ಬಣಾಯುಹುಯು ಬಿಛಾ಼ವ್ಣಪರ್ ಮ್ಹೇಲಿರಾಖ್ಯೂಥು. <verse eid="EST 1:6" /><verse number="7" style="v" sid="EST 1:7" />ದ್ರಾಕ್ಷಿನೊರಖ್ಹ್‌ ಪೀಯಾನ ಖ್ಹೊನ್ನಾನು ರಾಛು಼ಖ್ಹಾರು ಅಲಕ್‌ಅಲಕ್ ರೂಪ್ಮ ಬಣೈರಾಖ್ಯೂಥು. ರಾಜ಼ನೊ ಮೋಟೊ ದಿಲ್‌ ಕಿಮ್ಕಿ, ಇನ ಬರೋಬರ್‌ನಿ ಪರಕ್ಮ ಕೆತ್ರುಹೋಣುಕಿ ತೆತ್ರು ಪಿಯ್ಯಾನಖ್ಹಾಜೆ ಮಿಛಾ಼ಣ್ಯುಥು. <verse eid="EST 1:7" /><verse number="8" style="v" sid="EST 1:8" />ಪೀಯಾಮ ಹರೇಕ್ ಜ಼ಣಾನಾಬಿ ಇವ್ಣಿ ಪಸಂದ್‌ನಿ ಪರಕ್ ದೇವ್ಣುಕರೀಬಿ ಇವ್ಣುನ ಕೆತ್ರು ಹೋಣುಕಿ ಎತ್ರು ದೇವ್ಣುಕರೀಬಿ ಮಹೇಲ್‌ನ ಆಳ್‌ಖ್ಹಾರಾನ ರಾಜಾ಼ನೆ ಹುಕುಮ್‌ ದೀರಾಖ್ಯೋಥೊ. <verse eid="EST 1:8" /><verse number="9" style="v" sid="EST 1:9" />ವಷ್ಟಿ ರಾಣಿನೆ, ಅಹಷ್ವೇರೋಷ ರಾಜ಼ನಿ ಮಹೇಲ್‌ಮ ತಯೇಡವ್‌ನಖ್ಹಾಜೆ ಮಿಝ಼್‌ವಾನ್ ಕರೈರಾಖಿಥಿ. <verse eid="EST 1:9" /><verse number="10" style="v" sid="EST 1:10" />ಖ್ಹಾತ್‌ನ ದನ್‌ಮ ಅಹಷ್ವೇರೋಷ ರಾಜ಼ನೆ ದ್ರಾಕ್ಷೀನೊರಖ್ಹ್‌ ಪೀನ್ ಖ್ಹುಷೀನ ಪೋಭಾರಮ ರ‍್ಹಾವಾನಿವಖ್ಹ್‌ತೆ ಘಣಿ ಶನ್‌ಗಾರ್‌ನಿ ಹುಯಿರೀತೆ ಇನಿ ರಾಣಿನು ಶನ್‌ಗಾರ್‌ನ ಅದ್ಮೆವ್‌ನಾಬಿ, ಮಹೇಲ್‌ನ ಅದಿಕಾರಿಯೇನಾಬಿ ವತಾಳ್‌ನುಕರಿ ಆಖ್ಹ್‌ಕರ‍್ಯೊ. ಯೊ ಇನ ಜೋ಼ಡ್ಮರ‍್ಹಾವಾಳು ಆಳ್‌ಹುಯಿರುತೆ, ಮೆಹೂಮಾನ್, ಬಿಜೆತಾ, ಹರ್ಬೋನಾ, ಬಿಗೆತಾ, ಅಬಗೆತಾ, ಜೇತರ್, ಕರ್ಕಸ್‌ ಕರಿ ಖ್ಹಾತ್ ಸೇವಕವ್‌ನ, <verse eid="EST 1:10" /><verse number="11" style="v" sid="EST 1:11" />“ವಷ್ಟಿ ರಾಣಿ ಕಿರೀಟ್ ಘಾಲಿಲೀನ್‌ ರಾಜ಼ಕನ ಆವ್ಣುಕರಿ ಬೋಲ್ನು” ಕರಿ ಹುಕುಮ್‌ಕರ‍್ಯೊ. ಯೊ ಘಣಿ ರಂಗ್‌ರೂಪ್ನಿಥಿ. ಅಜು಼ ರಾಜಾ಼ನೆ ಇನಿ ಶನ್‌ಗಾರ್‌ನ ಅದಿಕಾರಿಯೆನಾಬಿ ಮಾಯಮಾತ್ರವ್ನಾಬಿ ವತಾಳ್ಣುಕರಿ ಆಖ್ಹ್‌ಕರ‍್ಯೊ. <verse eid="EST 1:11" /><verse number="12" style="v" sid="EST 1:12" />ಕತೋಬಿ ಮಹೇಲ್‌ನು ಅದಿಕಾರಿ ಖ್ಹಮ್‌ಜ಼ಾಡ್ಯುತೆ ರಾಜಾ಼ನಿ ಹುಕುಮ್‌ನ ವಷ್ಟಿರಾಣಿನೆ, “ಆವ್‌ಕೊಯ್ನಿ” ಕರಿ ಫೇಡ್‌ದಿದಿ. ಅನಾಖ್ಹಾಜೆ ರಾಜ಼ ಘಣು ಇರಾದೊ ಕರೀನ್ ಚ಼ಂಢಾಳ್ ಕರ‍್ಯೊ. <verse eid="EST 1:12" /><verse number="13" style="v" sid="EST 1:13" />ರೀತಿರಿವಾಜ಼್‌ನು ಸವಾಲ್‌ನ ವಾತೇವ್ನ ಬೋಲಾನು ರಾಜಾ಼ನಿ ಪದತ್ತಿ ಥಿ. ಇನಖ್ಹಾಜೆ ಇನ ಮದತ್‌ಕರವಾಳನ ಬುಲಾಯೊ ಅಜು಼ ಕೋಣ್‌ ಶಾತ್‌ ಕರ‍್ನುಕರಿ ಖ್ಹಮ್‌ಜಾ಼ಡ್ನುಥು. <verse eid="EST 1:13" /><verse number="14" style="v" sid="EST 1:14" />ರಾಜ಼ ಹುಯಿರೋತೆ ಅಹಷ್ವೇರೋಷನ ಮಹೇಲ್‌ಮ ರಾಜ಼ಕನ ರ‍್ಹಾವಾಳು ಆಳ್‌ಖ್ಹಾರುಬಿ ರಾಜ್ಯಸಬೆನು ಅದಿಕಾರಿಖ್ಹಾರೂಬಿ ಹುಯಿರುಥೂತೆ ಕರ್ಷೇನಾ, ಶೇತಾರ್, ಅದ್ಮಾತಾ, ತರ್ಷೀಷ್, ಮೆರೆಸ್ ಮರ್ಸೆನಾ, ಮೆಮೂಕಾನ್‌ ಕರಿ ಖ್ಹಾತ್ಜ಼ಣ ಪರ್ಷಿಯ ಅಜು಼ ಮೇದ್ಯ ದೇಖ್ಹ್‌ನ ರಾಜ಼ವ್‌ನ ಗಲ್‌ಢಾಖ್ಹಾರುಥು. ಪುರಗುಲ್‌ಖ್ಹಾರು ಹುಯಿರ‍್ಹುತೆ ಅವ್ಣುನ ರಾಜ಼ನೆ, ಆ ಬಾರೇಮ ಪುಛಾ಼ಯೊ. <verse eid="EST 1:14" /><verse number="15" style="v" sid="EST 1:15" />“ಮಹೇಲ್‌ನ ಅದಿಕಾರಿಥಿ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೋತೆ ರಾಜ಼ನಿಹುಕುಮ್‌ನ ಕರ್‌ಹೈಯಕಾಡೀತೆ ವಷ್ಟಿರಾಣಿನ ಖಾನೂಲ್‌ನಿ ಪರಕ್ಮ ಶಾತ್‌ಕರ‍್ನು?” ಕರಿ ಪುಛಾ಼ಯೊ. <verse eid="EST 1:15" /><verse number="16" style="v" sid="EST 1:16" />ತದೆ ಮೆಮೂಕಾನನೆ ರಾಜ಼ ಅಜು಼ ಸಬೆನ ಅದಿಕಾರಿನ ಖ್ಹಾಮ್ಣೆ, “ವಷ್ಟಿರಾಣಿನು ಅಪರಾದ್‌ ರಾಜ಼ ಎಕ್ಕಸ್‌ಜ಼ಣಾನ ನಿಶ್‌ಟೂರ ಕರಾನಿತರ ಕಾಹೆ. <verse eid="EST 1:16" /><verse number="17" style="v" sid="EST 1:17" />ರಾಣಿನು ಚಾ಼ಲ್ ಖ್ಹಾರೀಸ್‍ ತಯೇಡವ್‌ನಾಬಿ ಮಾಲುಮ್‌ಪಡೀನ್ ಇವ್ಣೇಬಿ ಇವ್ಣ ಬಾವ್ರಿನಿ ವಾತ್ನ ಝಿ಼ಟ್ಕಾರಲಗ್‌ಶೆ. ಇವ್ಣೆ, ‘ಅಹಷ್ವೇರೋಷ ರಾಜ಼ನೆ ವಷ್ಟಿರಾಣಿನ ಮಾರಕನ ಆವ್ಣುಕರಿ ಬೋಲಿಮೋಕ್‌ಲ್ಯೊತೋಬಿ ಯೊ ಕೋಗೈನಿನಿ’ ಕರಿ ನಕ್ಲೆಕಾಡ್‌ಶೆ. <verse eid="EST 1:17" /><verse number="18" style="v" sid="EST 1:18" />ಆನಾಹುಯಿನ್, ರಾಣಿನಿ ಆ ಢಂಗ್‌ನಿ ಬಾರೇಮ ಖ್ಹಮ್‌ಜ್ಯೂತೆ ಪರ್ಷಿಯ, ಮೇದ್ಯ ದೇಖ್ಹ್‌ನಿ ಶವ್‌ಕಾಲ್ಡಿಯೆ ಅಮ್ನಿಸ್‌ಪರಕ್ ರಾಜ಼ನ ಅದಿಕಾರಿಯೇವ್‌ನಿ ಜೋ಼ಡ್ಮ ಢಂಗ್‌ಕರಿ ವತಾಳ್‌ಶೆ. ಅಮ್ ಕೆತ್ರೂಕಿ ಇರಾದೊಬಿ , ಅಜು಼ ಝಿ಼ಟ್ಕಾರನೂಬಿಖ್ಹಾರು ಉಶೆ. <verse eid="EST 1:18" /><verse number="19" style="v" sid="EST 1:19" />ರಾಜ಼ ಮಾನಿಲ್ಯಾವಾನು ರ‍್ಹಯೂತೊ , ವಷ್ಟಿ ರಾಣಿ ಬಿಜು಼ ಕದೇಬಿ ರಾಜ಼ನ ಖ್ಹಾಮ್ಣೆ ಆವ್ಣೂಸ್‌ನಾಕರಿ ರಾಜ಼ನಿ ಹುಕುಮ್ ಹುಯಿನ್ ಯೊ ಕದೇಬಿ ನಾ ಮಟಾವ್‌ನೂತೆತಿಮ್ ಪರ್ಷಿಯ ಅಜು಼ ಮೇದ್ಯ ದೇಖ್ಹ್‌ನಿ ಖಾನೂಲ್‌ಮ ಲೀಖೈಜಾ಼ವಾದೆ; ರಾಜ಼ ಇನಿ ರಾಣಿನು ಪಟ್ಟಾನ ಇನೇಥೀಬಿ ಘಣಿಅಛ್ಛಿನ ದ್ಯಾವಾದೆ. <verse eid="EST 1:19" /><verse number="20" style="v" sid="EST 1:20" />ರಾಜ಼ನಿ ಆ ತಿರ್ಮಾನ್ನ ಅಶಿಲ್‌ಥಿಧರಿನ್ ಕಮ್‌ಶಿಲ್‌ರ‍್ಹವಾಳಿ ಖ್ಹಾರೀಸ್‍ ತಯೇಡ ಇವ್ಣ ಬಾವ್ರಿಯೇನ ಜೋ಼ಡ್ಮ ಬರೋಬರ್ ಇಜ಼್ಜತ್‌ ದಿಶೆ”. ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EST 1:20" /><verse number="21" style="v" sid="EST 1:21" />ಮೆಮೂಕಾನನೆ ಬೋಲ್ಯೋತೆ ಆವಾತ್‌ ರಾಜ಼ನಾಬಿ, ಸಬೆನ ಅದಿಕಾರಿನಾಬಿ ಬರೋಬರ್ ದೆಖಾಯು. ಇನಾಖ್ಹಾಜೆ ರಾಜ಼ನೆ ಇಮ್ಮಸ್‌ಕರ‍್ಯೊ. <verse eid="EST 1:21" /><verse number="22" style="v" sid="EST 1:22" />ಇನೆ, “ಹರೇಕ್ ಕುಟುಂಬ್‌ಮ ಪರ್ಖ್ಹೋಸ್‌ ಯಜಮಾನ್ ಹುಯಿರ‍್ಹೇವ್ಣು ಅಜು಼ ಯೊ ಶೊಂತ್ ಅದ್ಮೇವ್‌ನಿ ಬೋಲಿಮಾಸ್‌ ಕಾಮ್‌ಧಂದೊಕರ‍್ನು” ಕರಿ ಖ್ಹಾರಾಸ್ ರಾಜ಼ವ್‌ನು ಮಹೇಲ್‌ಮ ಚಿಟ್ಟಿಲೀಖಿನ್‌ ಬೋಲಿವತಾಳ್ಯೊ. ಆ ಚಿಟ್ಟಿ ತ್ಯೊತ್ಯೊ ತಬರ್‌ಖಾವ್‌ಮ ಅಜು಼ ಜ಼ಗ್‌ಜಾ಼ತ್‌ನಿ ಬೋಲಿಮಾಬಿ ಲೀಖಾಯು.<verse eid="EST 1:22" /></para>
  <chapter eid="EST 1" />
  <chapter number="2" style="c" sid="EST 2" />
  <para style="s">ಎಸ್ತೇರ್ ರಾಣಿ ಹುಯಿತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 2:1" />ಆ ಹುಯಿನ್ ಥೋಡ ದನ್ನ ಬಾದ್ಮ ರಾಜ಼ ಇರಾದೊ ತೋಡಿನ್, ಇನೆ ವಷ್ಟಿರಾಣಿನಾಬಿ ಇನೆ ಕರೀತೆ ಢಂಗ್‌ನಾಬಿ ಅಜು಼ ಇನಿ ಬಾರೇಮ ಕರ‍್ಯೋತೆ ತೀರ್ಪ್‌ನಾಬಿ ಯಾದ್‌ಕರಿಲಿದೊ. <verse eid="EST 2:1" /><verse number="2" style="v" sid="EST 2:2" />ತದೆ ಇನಿ ಚಾ಼ಕ್ರಿ ಕರುಕರ್ತುಥೂತೆ ರಾಜ಼ನಿ ಪರಿವಾರ್‌ವಾಳು ಇನ ಬೋಲ್ಯುಕಿ, “ರಾಜ಼ನಖ್ಹಾಜೆ ಶನ್‌ಗಾರ್‌ನಿ ಛೋ಼ಕ್ರಿಯೇ ಢೂಂಡಾನ ಹುಕುಮ್ ಹೋಣು. <verse eid="EST 2:2" /><verse number="3" style="v" sid="EST 2:3" />ಅನಾಖ್ಹಾಜೆ ರಾಜ಼ ಇನ ಮುಲಕ್ನು ಖ್ಹಾರೂಸ್ ರಾಜಧಾನಿನಾಬಿ ಅದಿಕಾರಿಯೇವ್‌ನ ಮೋಕ್‌ಲ್‌ನು; ಇವ್ಣೆ ಶನ್‌ಗಾರ್‌ನಿ ಖ್ಹಾರೀಸ್‌ ಕವಾರಿ ಛೋ಼ಕ್ರಿಯೇವ್‌ನ ಶೂಷನ್ ಖ್ಹಯೇರ್‌ನ ಬುಲೈಲಾಯಿನ್ ಮಹೇಲ್‌ನೊ ಅದಿಕಾರಿಯೇನಾಬಿ ರಾಜ಼ನಿ ಆಸ್ಥಾನ್ನೊಹಿಜ಼್‌ಡೊ ಹುಯಿರೋತೆ ಹೇಗೈನ ಕಬ್‌ಜಾ಼ಮ ದೇವ್ಣು. ಯೊ ಇವ್ಣುನ ಶನ್‌ಗಾರ್‌ ಭಡ್ವಾನು ಲೋಥಾನ ತೇಲ್ನ ದ್ಯಾವಾದೆ. <verse eid="EST 2:3" /><verse number="4" style="v" sid="EST 2:4" />ರಾಜ಼ ಖೆವಿ ಛೋ಼ಕ್ರಿನ ಪಸಂದ್‌ಕರಸ್‌ಕಿ; ವಷ್ಟಿರಾಣಿನ ಬದಲ್ ಯೊ ಛೋ಼ಕ್ರಿ ರಾಣಿಹುವಾದೆ”. ಕರಿ ಬೋಲ್ಯು. ರಾಜ಼ ಇವ್ಣಿ ಖ್ಹೂಜ಼್‌ನ ಮಾನಿನ್ ಇಮ್ಮಸ್‌ಕರ‍್ಯೊ. <verse eid="EST 2:4" /><verse number="5" style="v" sid="EST 2:5" />ಶೂಷನ್ ಖ್ಹಯೇರ್‌ಮ ಮೊರ್ದೆಕೈಕರಿ ಯೆಹೂದ್ಯವಾಳೊ ಏಕ್‌ಜ಼ಣೊ ಜಿವ್ಣುಕರುಕರ್ತೊಥೊ. ಆ ಬೆನ್ಯಾಮೀನ್‌ ಖೂಮ್‌ವಾಳೊ ಕೀಷನೊ ಪಡ್‌ಪೋತಿಬಿ, ಶಿಮ್ಗಿನೊ ನಾತ್ಯೋಬಿ ಯಾಯೀರನೊ ಛಿಯ್ಯೊಬಿ ಹುಯಿರೋಥೊ. <verse eid="EST 2:5" /><verse number="6" style="v" sid="EST 2:6" />ಬಾಬಿಲೋನಿಯನೊ ರಾಜ಼ಹುಯಿರೋತೆ ನೆಬೂಕದ್ನೆಚ್ಚರ್‌ಥಿ ಯೆಹೂದ ರಾಜ಼ಹುಯಿರೋತೆ ಯೆಹೋಯಾಕೀನನಿ ಜೋ಼ಡ್ಮ ಜೇಲ್‌ಮ ಕೋಂಡಾಯಹುಯಾಮ ಯೆರೂಸಲೇಮ್‌ಥು ಥೂತೆ ಇವ್ಣಾಮ ಮೋರ್ದಕೈಬಿ ಥೊ. <verse eid="EST 2:6" /><verse number="7" style="v" sid="EST 2:7" />ಅನೆ ಇನ ನ್ಹಾನಕಾಕನಿ ಛೋ಼ರಿ ಎಸ್ತೇರ್, ಕತೊ; ಆಯಾಬಾ ಮರ‍್ಯಾತಪ್‌ಥ ಅನಾದ್ರಿಹುಯಿರೀತೆ ಅನ ಶೊಂತ್‌ ಛೋ಼ರಿನಿತರ ಯೊ ಪಾಳುಕರ್ತೊಥೊ. ಇಬ್ರಿಯಮ ಹದೆಸ್ಸಾ ಕರಿ ಇನು ನಾಮ್‌; ಆ ಹೈರೀತೆ ರೂಪ್‌ವಾಳಿಬಿ, ಜ಼ವಾನೀಬಿ , ಘಣಿ ಶನ್‌ಗಾರ್‌ನಿಬಿ ಥಿ. <verse eid="EST 2:7" /><verse number="8" style="v" sid="EST 2:8" />ರಾಜ಼ನಿ ಖ್ಹೂಜ಼್‌ನಿ ಪರಕ್ಮ ಇನಿ ಹುಕುಮ್ ಖ್ಹಾರೀಸ್‌ ಬಾಜೂ಼ಮ ಫೈಲಾಯು. ಕೈಏಕ್‌ಜ಼ಣಿ ಛೋ಼ಕ್ರಿಯೇನ ಶೂಷನ್ ಖ್ಹಯೇರ್‌ನ ಬುಲೈಲಾಯಿನ್‌ ಆಸ್ಥಾನ್ನ ದೇಖಿಲ್ಯವಾಳೊ ಹೇಗೈನ ದೇಕ್‌ಬಾಲ್‌ಮ ದೆವಾಯು. ಅಥ್ರಾನವಾಳಿಯೇಮ ಎಸ್ತೇರ್‌ಬಿ ಏಕ್‌ಜ಼ಣಿ. <verse eid="EST 2:8" /><verse number="9" style="v" sid="EST 2:9" />ಎಸ್ತೇರ್‌ ಹೇಗೈನ ಪಸಂದ್‌ಹೋತಾನ ಮೊರ್ದೆಕೈ ಹೈರೀತೆನ ಹೋಣುತೆ ಶನ್‌ಗಾರ್‌ಭಡಾವಾನು ತೇಲ್‌ಖ್ಹಾರೂಬಿ ಅಜು಼ ಅಛ್ಛು಼ ಖಾಣೂಬಿ ದೀನ್, ಇನಾಬಿ ಇನಿ ಮದತ್‌ ಕರಾನಖ್ಹಾಜೆ ಚೂ಼ಣ್ಯುತೆ ಖ್ಹಾತ್‌ಜ಼ಣಿ ಸೇವಕಿಯೆವ್ನಬಿ ಮಹೇಲ್‌ನು ಖ್ಹಾರೇಥಿ ಅಛ್ಛಿಝ಼ಗೋಮ ರಾಖ್ಯೊ. <verse eid="EST 2:9" /><verse number="10" style="v" sid="EST 2:10" />ಎಸ್ತೇರ್‌ನೆ ಇನ ಶೊಂತ್ ಅದ್ಮೇವ್ನ ಖೆವ ದೇಖ್ಹ್‌ನಿ ಅಜು಼ ಖಾನ್‌ಖೋಜ಼್‌ನಿ ಬಾರೇಮ ಕಿನಾಬಿ ಬೋಲಿರಾಖಿಥಿಕೊಯ್ನಿ. ಬೋಲ್ನುನಾಕರೀಬಿ ಮೊರ್ದೆಕೈನೆ ಇನ ಖ್ಹಮ್‌ಜಾ಼ಡಿರಾಖ್ಯೋಥೊ. <verse eid="EST 2:10" /><verse number="11" style="v" sid="EST 2:11" />ಎಸ್ತೇರ್ ಅಛ್ಛೊ ಛಾಕಿಶೂ ಕರೀಬಿ ಅಜು಼ ಯೊ ಅಗಾಡಿ ಶಾತ್‌ಕರ‍್ನು ಕರೀಬಿ ಪುಛಾವಾನಖ್ಹಾಜೆ ಹರೇಕ್‌ರೋಜ಼್‌ ಮಹೇಲ್‌ನ ಖ್ಹಾಮ್ಣೆ ಮೊರ್ದೆಕೈ ಆತೊಜ಼ಾತೊರ‍್ಹೇತೋಥೊ. <verse eid="EST 2:11" /><verse number="12" style="v" sid="EST 2:12" />ಛೋ಼ಕ್ರಿಯೇನ ಶನ್‌ಗಾರ್‌ಹುವಾನ ಲೋಥಾನು ಹಗಾಮ್‌ ಪೂರಹುವಾನಖ್ಹಾಜೆ ಮಹಿಕಾವನುತೇಲ್ ಲಗಾಡಾಮ ಛೋ಼ ಮಹಿನ ಹೋತುಥು, ಘಣುಗೋರುಕರಾನು ವಾನುತೈಲ ಲಗಾಡಾಮ ಛೋ಼ ಮಹಿನ, ಅಮ್ ಏಕ್‌ ವರಖ್ಹ್‌ ನಿಕ್ಳಿಗಯೊ. ಆ ಹುವಾದೀನ್‌ ಪದತ್ತಿನಿ ಪರಕ್ಮ ಶನ್‌ಗಾರ್‌ಕರಿಲಿದಿಹುಯಿ ಹರೇಕ್ ಛೋ಼ಕ್ರಿಬಿ ರಾಜ಼ ಅಹಷ್ವೇರೋಷಕನ ಜಾವ್ಣುಥು. <verse eid="EST 2:12" /><verse number="13" style="v" sid="EST 2:13" />ಅಮ್ಮಸ್‌ ಏಕ್‌ಜ಼ಣಿ ರಾಜ಼ಾಕನ ಜಾ಼ವಾನಿವಖ್ಹ್‌ತೆ ಇನಿ ಜೋ಼ಡ್ಮ ಲೀನ್‌ಜಾ಼ವಾನ ಪಸಂದ್‌ಕರಾಸ್ತೆ ತಮಾಮಸ್‌ ಯೊ ಛೋ಼ಕ್ರಿನ ದೆವಾವ್ತುಥು. <verse eid="EST 2:13" /><verse number="14" style="v" sid="EST 2:14" />ಯೊ ಹಿಜ್ಜಾ಼ ಖ್ಹಾಂಜೆಗೈಹುಯಿ ಇನವ್ಹಾಣೆ ರಾಜ಼ನಿ ರಖೇಲ್‌ಬಾವ್ಣೆನ ದೇಕ್‌ಬಾಲ್‌ ಕರಾವಳೊ ಶವಷ್ಗಜಕರಿ ರಾಜ಼ನಿಆಸ್ಥಾನ್ನೊ ಅದಿಕಾರಿ ದೇಕ್‌ಬಾಲ್‌ಮಥೂತೆ ಬೇನು ಮಹೇಲ್‌ಮ ಆವ್ಣುಥು. ರಾಜ಼ ಇನ ಪಸಂದ್‌ಕರೀನ್ ನಾಮ್‌ಬೋಲಿನ್ ಪುಕಾರಲಗೂಬಿ ಏಕ್‌ಜ಼ಣೀಬಿ ರಾಜ಼ಕನ ಪಾಛಿ ಜಾ಼ವಖ್ಹರ್ಕು ಕೋಥೂನಿ. <verse eid="EST 2:14" /><verse number="15" style="v" sid="EST 2:15" />ರಾಜ಼ಕನ ಜಾ಼ವಾನಖ್ಹಾಜೆ ಮೊರ್ದೆಕೈನಿ ಪಾಳಿಹುಯಿ ಛೋ಼ರಿಬಿ, ಇನೊ ನ್ಹಾನೊಕಾಕ ಅಬೀಹೈಲನಿ ಛೋ಼ರಿ ಎಸ್ತೇರ್‌ ಜಾ಼ವಾನಿ ವಖ್ಹತ್ ಆವಾದಿನ್, ಮಹೇಲ್‌ನೊ ದೇಕ್‌ಬಾಲ್‌ಕರವಾಳೊ ಹೇಗೈಕರಿ ರಾಜ಼ನ ಆಸ್ಥಾನ್ನೊ ಅದಿಕಾರಿ ನೇಮಕ್‌ಕರ‍್ಯೊತೆಸ್ ಪಣ್ಕಿ ಇನೆ ಬಿಜು಼ ಖೆವೂಬಿ ಬೋಲಿಕೊಯ್ನಿ. ದೇಖಾವಾಳು ಖ್ಹಾರೂಬಿ ಇನ ಪಸಂದ್‌ಕರ್ತುಥು. <verse eid="EST 2:15" /><verse number="16" style="v" sid="EST 2:16" />ರಾಜ಼ ಅಹಷ್ವೇರೋಷನೆ ಇನು ರಾಜ಼್‌ಭಾರ್‌ಚ಼ಲಾಯೋತೆ ಖ್ಹಾತ್‌ನೊ ವರಖ್ಹ್ ದಖ್ಹ್‌ನೊಮಹಿನೊ ಹುಯಿರೋತೆ ಪುಷ್ಯ ಮಹಿನಾಮ ಎಸ್ತೇರ್‌ನ ರಾಜ಼ಕನ ಬುಲೈಲೀನ್‌ಗಯು. <verse eid="EST 2:16" /><verse number="17" style="v" sid="EST 2:17" />ರಾಜ಼ ಖ್ಹಾರೀಸ್‌ ತಯೇಡಾಥೀಬಿ ಎಸ್ತೇರ್‌ನ ಪಸಂದ್‌ಕರ‍್ಯೊ. ಖ್ಹಾರೀಸ್‍ ಛೋ಼ಕ್ರಿಯೆಮ ಯೊ ರಾಜ಼ನಿ ದಯನಾಬಿ, ಪ್ಯಾರ್‌ನಾಬಿ ಜೀತಿಲಿದಿತೆ ಇನಾಖ್ಹಾಜೆ ರಾಜ಼ನೆ ಇನ ಮುಡ್‌ಕ್ಯಾಪರ್ ರಾಜ಼ನಿ ಕಿರೀಟ್‌ಘಾಲೀನ್‌ ವಷ್ಟಿರಾಣಿನ ಬದಲ್ ಇನ ರಾಣಿಕರಿಲಿದೊ. <verse eid="EST 2:17" /><verse number="18" style="v" sid="EST 2:18" />ಇನ ಖ್ಹಾರಸ್‌ ಪರಿವಾರ್‌ವಾಳನಾಬಿ , ಅದಿಕಾರಿಯೇನಾಬಿ ಎಸ್ತೇರ್‌ನಿ ಮರ‍್ಯಾದಿನಖ್ಹಾಜೆ ಎಕ್ ಮೋಟಿ ಮಿಝ಼್‌ವಾನ್ ತಯ್ಯಾರ್‌ಬಣಾಯೊ. ಇನು ಖ್ಹಾರೀಸ್‍ ಇಟಾರಮ್ನಿ, ಖ್ಹಾರ್‌ಕೋಟ್‌ಮ ಕೋಂಡೈಪಡ್ಯುಥೂತೆ ಇವ್ಣುನ ಛುಟ್‌ಕಾರ್‌ದೀನ್, ರಾಜ಼ನಿ ಮರ‍್ಯಾದಿನ ಬರೋಬರ್ ಛು಼ಟಾದಿಲ್‌ಥಿ ಅದ್ಮೇವ್‌ನ ದಾನ್ ಧರಮ್ ಕರ‍್ಯೊ.<verse eid="EST 2:18" /></para>
  <para style="s">ರಾಜ಼ನ ಬಚಾ಼ಡ್ಯೋತೆ ಮೊರ್ದೆಕೈ</para>
  <para style="p">
    <verse number="19" style="v" sid="EST 2:19" />ಬೇನಿ ಬಾರ್ ಛೋ಼ಕ್ರಿಯೇನ ಎಕ್ಟುಕರಾವನಿ ವಖ್ಹ್‌ತೆ ಮೊರ್ದೆಕೈ ಮಹೇಲ್‌ನು ದರ‍್ವಾಜ಼ಕನ ಬೇಠೋಥೊ. <verse eid="EST 2:19" /><verse number="20" style="v" sid="EST 2:20" />ಎಸ್ತೇರ್‌ತೊ ಮೊರ್ದೆಕೈಕನ ಪಳೂಕರ್ತಿಥೀತೆ ದನುಮ ಕಿಮ್ಕಿ ಇಮ್ಮಸ್ ತದೇಬಿ ಇನಿ ಹುಕುಮ್‌ಪರ್‌ ಚಾ಼ಲಾವಾಳಿಹುಯಿರೀನ್ ಮೇ ಅಥ್ರಾನಿ ಖೂಮ್‌ವಾಳಿ, ಅಥ್ರಾನಿ ಶೊಂತ್ ಜ಼ಗ್‌ಜಾ಼ತ್‌ವಾಳಿಕರಿ ಕಿನಾಬಿ ವತಾಳಿಲಿದಿಕೊಯ್ನಿ. <verse eid="EST 2:20" /><verse number="21" style="v" sid="EST 2:21" />ಯೊ ದನುಮ ಮೊರ್ದೆಕೈ, ರಾಜ಼ನ ಮಹೇಲ್‌ನ ದರ್ವಾಜ಼ನ ಕಾವಲ್ ಕರಾವಾಳಥಾತೆ ಬಿಗೆತಾನ್‌ ಅಜು಼ ತೆರೆಷ್‌ಕರಿ ಬೇಜ಼ಣ ರಾಜನಆಸ್ಥಾನ್ನ ಅದಿಕಾರಿ ಇರಾದೇಥಿ ರಾಜ಼ನ ಮಾರಿನಾಕ್ಣುಕರಿ ಮಶ್ಲತ್‌ ಕರಿರಾಖ್ಯಥ. <verse eid="EST 2:21" /><verse number="22" style="v" sid="EST 2:22" />ಆವಾತೆ ಮೊರ್ದೆಕೈನ ಮಾಲುಮ್‌ಪಡಾಮ ಇನೆ ಎಸ್ತೇರ್‌ರಾಣಿನ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ. ರಾಣಿನೆ ಮೊರ್ದೆಕೈನು ನಾಮ್‌ ರಾಜ಼ನ ಬೋಲಿನ್‌, ಯೊ ವಾತೆ ಖ್ಹಮ್‌ಜಾ಼ಡಿ. <verse eid="EST 2:22" /><verse number="23" style="v" sid="EST 2:23" />ಆ ವಾತೆನಿ ಬಾರೇಮ ವಾತ್‌ಚೀತ್‌ ಹುವಾಮ ಯೊ ಖ್ಹಾಚೀಸ್ ಕರಿ ಮಾಲುಮ್‌ಪಡ್ಯು, ಯೊ ಬೇಜ಼ಣನಾಬಿ ಫಾಶಿದೆವಾಯು. ಆ ವಾತೆ ರಾಜ಼ನು ದನ್‌ಪರ್‌ರೋಜ಼್‌ನು ಲಿಖಾಪಟ್‌ನ ದಪ್ತರ್‌ಮ ಲೀಖೈಮ್ಹೇಲಾಯು.<verse eid="EST 2:23" /></para>
  <chapter eid="EST 2" />
  <chapter number="3" style="c" sid="EST 3" />
  <para style="s">ಯೆಹೂದ್ಯರ್‌ನ ಖತಮ್‌ಕರಾನ ಹಾಮಾನನಿ ಖ್ಹೂಜ಼್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 3:1" />ಆಹುವಾದೀನ್‌ ರಾಜ ಅಹಷ್ವೇರೋಷನೆ ಅಗಾಗನೊ ಖೂಮ್‌ವಾಳೋಬಿ ಹಮ್ಮೆದಾತನೊ ಛಿಯ್ಯೊಬಿ ಹುಯಿರೋತೆ ಹಾಮಾನನಿ ಪದವಿನ ಪ್ರಧಾನ ಮಂತ್ರಿಕರಿ ಭಡೈನ್, ಇನಿ ಮಹೇಲ್‌ಮ ಖ್ಹಾರಾಸ್ ಅದಿಕಾರಿಯೇಥಿಬಿ ಇನ ಪಹಿಲಿಝ಼ಗೊ ದಿದೊ. <verse eid="EST 3:1" /><verse number="2" style="v" sid="EST 3:2" />ರಾಜ಼ನಿ ಹುಕುಮ್‌ನಿಘೋಣಿ ಮಹೇಲ್‌ಮಥೂತೆ ಕಾಮ್‌ಕರವಾಳು ಖ್ಹಾರೂಸ್ ಹಾಮಾನನ ಘುಡ್‌ಗ್ಯಮೇಟೆಹುಯಿನ್ ಖ್ಹಲಾಮ್‌ಕರ್ತುಥು. ಕತೋಬಿ ಮೊರ್ದೆಕೈ ಇನ ಇಮ್ ಕೋಕರ್ತೊಥೋನಿ. <verse eid="EST 3:2" /><verse number="3" style="v" sid="EST 3:3" />ಅನ ದೇಖ್ಯೂತೆ ದರ‍್ವಾಜ಼ನ ಕಾವಲ್‌ಕರಾವಾಳು, “ತೂ ರಾಜ಼ನಿಹುಕುಮ್‌ನ ಮೀರಸ್‌ಶನಾ”? ಕರಿ ಮೊರ್ದೆಕೈನ, ಝೇತಾವ್‌ತುಥು. <verse eid="EST 3:3" /><verse number="4" style="v" sid="EST 3:4" />ಅಮ್‌ ಇವ್ಣೆ ಹರೇಕ್‌ರೋಜ಼್‌ ಇನ ಬೋಲ್ಯುತೋಬಿ ಇನೆ ಇವ್ಣಿ ವಾತ್ನ ಕಾನ್‌ದಿದೊಕೊಯ್ನಿ. ಮೇ ಯೆಹೂದ್ಯಕರಿ ಬೊಲಿಲೇತೋಥೊತೆ ಮೊರ್ದೆಕೈನಿ ಹಟ ಕಿಜ್ಜಾ಼ಲಗು ಚಾ಼ಲಸ್ಕಿ ದೇಖಿಸ್‌ ಲೇವ್ಣುಕರಿ ಇನಿ ಆ ಢಂಗ್‌ನಿ ಬಾರೇಮ ಹಾಮಾನನ ಬೋಲ್ಯು. <verse eid="EST 3:4" /><verse number="5" style="v" sid="EST 3:5" />ಮೊರ್ದೆಕೈ ಇನ ಮುಡ್‌ಕ್ಯು ಝು಼ಕೈನ್ ಖ್ಹಲಾಮ್ ಕರ‍್ಯೊಕೊಂತೆ ದೇಖಿನ್ ಹಾಮಾನನೆ ಘಣುಇರಾದೊ ಕರ‍್ಯೊ. <verse eid="EST 3:5" /><verse number="6" style="v" sid="EST 3:6" />ಯೊ ಮೊರ್ದೆಕೈ ಏಕ್ಜ಼ಣಾಪರ್‌ ಹಾತ್‌ಪಾಡಾನು ಬಶ್‌ಕೊಯ್ನಿಕರಿ, ಹೈರೊತೆ ಯೆಹೂದ್ಯನಿ ಖಾನ್‌ದಾನ್‌ವಾಳೊ ಕರಿ ಖ್ಹಮ್‌ಜಾ಼ಮ ಅಹಷ್ವೇರೋಷನು ರಾಜ್ಯಮಥೂತೆ ಮೊರ್ದೆಕೈನು ಮಾಯಮಾತ್ರನಾಬಿ ಕತೊ ಪರ್ಷಿಯಾನು ಖ್ಹಾರೂಸ್ ಯೆಹೂದ್ಯವಾಳನ ಮರ್‌ನಾಕ್‌ಣುಕರಿ ಖ್ಹೂಜ಼್‌ ಕರಿಲಿದೊ. <verse eid="EST 3:6" /><verse number="7" style="v" sid="EST 3:7" />ರಾಜ಼ಹುಯಿರೋತೆ ಅಹಷ್ವೇರೋಷನು ಹುಕುಮ್ ಚ಼ಲಾಯೊಹುಯೊ ಭಾರನೊ ಮಹಿನನ ಚೇತ್ರಿನೊ ಮಹಿನಮ ಹಾಮಾನನ ಖ್ಹಾಮ್ಣೆ ಅಛ್ಛೊ಼ ಮಹಿನೊ ಅಜು಼ ಖರಾಬ್ ಮಹಿನೊ ಖೆವೂಕರಿ ಮಾಲುಮ್‌ ಕರಿಲ್ಯಾವಾನ ಖ್ಹಾಜೆ “ಪೂರ್" ಕತೊ ಚಿಟ್ಟಿ ನಾಖಾಮ ಯೊ ಚಿಟ್ಟಿ ಭಾರನೊ ಮಹಿನೊ ಹುಯಿರೋತೆ ನಿಸಾನ್ ಮಹಿನಾನು ಥೇರಾನ ರೋಜ಼್‌ಮ ಪಡ್ಯು. <verse eid="EST 3:7" /><verse number="8" style="v" sid="EST 3:8" />ಹಾಮಾನನೆ ರಾಜ಼ ಅಹಷ್ವೇರೋಷನ ಅಮ್ ಬೊಲ್ಯೊ; ತುಮಾರ ರಾಜ್ಯಮನು ಖ್ಹಾರೂಸ್ ಇಟಾರಮ್ಮ ರ‍್ಹಾವಾಳು ಎಕ್ ಖಾನ್‌ದಾನ್‌ ಛಾ಼. ಯೊ ಬಿಜು಼ಖ್ಹಾರು ಖಾನ್‌ದಾನ್ನ ಇಚ಼್‌ಮ ಫೈಲೈರ‍್ಹುತೋಬಿ ಇನಿ ರೀತಿರಿವಾಜ಼್‌ಮ ಇವ್ಣೇಥಿ ಅಲಕ್ಕಸ್‌ರ‍್ಹೇಸ್. ರಾಜ಼ನಿ ಖಾನೂಲ್‌ನಾತೊ ಆ ಖಾನ್‌ದಾನ್‌ವಾಳು ಪಾಡಿಚಾ಼ಲಾಸ್‌ ಕೊಯ್ನಿ. ಅಥ್ರಾನವಾಳ ಖ್ಹಾರಾನ ರಾಜ಼ ಚುಪ್ಕೆ ಮ್ಹೇಲಾನು ಬರೋಬರ್‌ಕೊಯ್ನಿ. <verse eid="EST 3:8" /><verse number="9" style="v" sid="EST 3:9" />ರಾಜ಼ನಿ ಖ್ಹೂಜ಼್‌ಹುಯಿತೊ ಇವ್ಣುನ ಮಾರಿನಾಕ್ಣುಕರಿ ಹುಕುಮ್‌ಕರಾದೆ; ಇಮ್ ಕರ‍್ಯೋತೊ ಮೇ ರಾಜ಼ನ ಖಜಿನೋಮ ದಖ್ಹ್‌ ಹಜಾ಼ರ್ ಕಿಲೋ ರೂಪಾನ ಪೈಶು ಟಜ್ರಿವಾಳಾನ ಹಾತ್‌ಮ ದೆವುಸ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EST 3:9" /><verse number="10" style="v" sid="EST 3:10" />ತದೆ ರಾಜ಼ನೆ ಇನ ಹಾತ್‌ಮ ಥೂತೆ ಮುದ್ರಾನಿ ಅಂಗೂಠಿನ ಕಾಡಿನ್ ಆಗಾಗನಿ ಖೂಮ್‌ವಾಳೋಬಿ ಹಮ್ಮೆದಾತನೊ ಛಿಯ್ಯೊಬಿ ಯೆಹೂದ್ಯವಾಳನೊ ವಹೇರ‍್ಯೋಬಿ ಹುಯಿರೋತೆ ಹಾಮಾನನ ದಿನಾಖಿನ್, <verse eid="EST 3:10" /><verse number="11" style="v" sid="EST 3:11" />“ಯೊ ರೂಪು ತಾರಾಕನಸ್‌ ರ‍್ಹಾವಾದೆ; ಯೊ ಅದ್ಮೇವ್‌ನಾತೊ ತುನ ಕಿಮ್ ಅಛ್ಛು಼ ದೆಖಾವಸ್ಕಿ ಯೊ ಪರಕ್ಮ ತೂ ಕರೆಜಾ಼ಯ್” ಕರಿ ರಾಜ಼ನೆ ಬೊಲ್ಯೊ. <verse eid="EST 3:11" /><verse number="12" style="v" sid="EST 3:12" />ಪಹಿಲ ಮಹಿನಾನೊ ಥೇರಾನೊ ದನ್‌ಮ ರಾಜ಼ನಿ ಬೋಲೀನ ಲೀಖಾವಾಳನ ಬುಲೈಮಂಗಾಯು. ಇವ್ಣೆ ಹಾಮಾನನಿ ಹುಕುಮ್‌ನಿಘೋಣಿ ರಾಜ್ಯಪಾಲವ್‌ನಾಬಿ , ಯೋಯೋ ಇಟಾರಮ್ನು ಅದಿಕಾರಿಯೇನಾಬಿ, ಯೋಯೋ ಜ಼ಗ್‌ಜಾ಼ತ್‌ನು ಮೋಟವ್‌ನಾಬಿ ಇವ್ಣ ಇವ್ಣ ಶೊಂತ್‌ ದೇಖ್ಹ್‌ನು ಲೀಖ್ಯಾಮಾಬಿ, ಬೋಲಿಮಾಬಿ ಲೀಖ್ಯು. ರಾಜ಼ ಅಹಷ್ವೇರೋಷನ ನಾಮ್‌ಪರಸ್‌ ಚಿಟ್ಟಿ ಲೀಖೈರ‍್ಹೂಥು; ಯೊ ಚಿಟ್ಟಿಯೇ ಅಖ್ಖಾಪರ್ ರಾಜ಼ನು ಅಂಗುಠಿನೊ ಮುದ್ರೊ ನಖೈರ‍್ಹೂಥು. <verse eid="EST 3:12" /><verse number="13" style="v" sid="EST 3:13" />ಚಿಟ್ಟಿಯೇನ ಚಿಟ್ಟಿಲೀಜ಼ಾವಾಳೇಥಿ ಖ್ಹಾರಾಸ್ ರಾಜ಼ನಿ ಅಖ್ಖ ತಬರ್‌ಖಾಮ ಮೋಕ್‌ಲಿದಿದು. ಯೊ ಅಖ್ಖಾಮ ಅಮ್ ಲೀಖೈರ‍್ಹೂಥು. “ಎಕ್ಕಸ್ ರೋಜ಼್‌ಮ, ಕತೊ, ಭಾರನೊ ಮಹಿನೊಹುಯಿರೋತೆ ಆದಾರ್<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">ಆದಾರ್ ಕತೊ ಏಪ್ರಿಲ್‌ನ ಮಹಿನಾಮ ಆವಸ್</char></note> ಮಹಿನಾನು, ಥೇರಾನೊ ರೋಜ಼್‌ಮ ಶಾಣು, ಅಡ್ಡಾಣಿ, ಲಡ್ಕು, ತಯೇಡಕರಿ ನಾದೇಕ್ಣುತೆ ತುಮಾರ ಇಚ಼್ಮ ರ‍್ಹಾವಾಳ ಖ್ಹಾರಾಸ್ ಯೆಹೂದ್ಯವಾಳನ ಭೋಕಿನಾಖೊ, ಕತರ್‌ನಾಖೊ, ಖತಮ್‌ಕರಿನಾಖೊ. ಇವ್ಣಿ ಶೊತ್ನ ಲೂಟಿಕರಿಲೆವೊ” ಕರೀಬಿ ಲೀಖೈರ‍್ಹೂಥು. <verse eid="EST 3:13" /><verse number="14" style="v" sid="EST 3:14" />ಎತ್ರೇಸ್ ಕಾಹೆತೆ, “ಆ ಚಿಟ್ಟಿನು ಏಕೇಕ್‌ ಹಾಳೇಬಿ ಹರೇಕ್ ತಬರ್‌ಖಾಮ ರಾಜ಼ನಿ ಹುಕುಮ್‌ನಿ ಘೋಣಿ ಬೋಲಿವತಾಳ್ಣು” ಕರಿ ಲೀಖೈರ‍್ಹೂಥು. ಅಖ್ಖುಜ಼ಣು ಯೊ ದನ್ಮ ತಯಾರ್‌ಹೋಣುಕರಿಬಿ ಹೈರುತೆ ಅಖ್ಖಾಸ್ನ ಮಾಲುಮ್‌ ಹುವಾದೆಕರಿ ಲೀಖೈರ‍್ಹುಥು. <verse eid="EST 3:14" /><verse number="15" style="v" sid="EST 3:15" />ಆ ಹುಕುಮ್ ಶೂಷನ್ ಮಹೇಲ್‌ಮ ಮಾಲುಮ್‌ಪಡ್ತಾಸ್‌ನ ಚಿಟ್ಟಿದ್ಯವಾಳುಖ್ಹಾರು ರಾಜ಼ನಿ ಹುಕುಮ್‌ನಿ ಪರಕ್ಮ ಘಬ್‌ರೈನ್ ನಿಕ್‌ಳ್ಯು. ರಾಜ಼ತೋಬಿ ಹಾಮಾನನಿ ಜೋ಼ಡ್ಮ ಪಿಯಾನ ಬೇಶಿಗಯೊ. ಹಿಜ಼್ಜ ಶೂಷನ್ ಖ್ಹಯೇರ್‌ಮತೊ ಕಿಜ಼್ಜಕಿಜ್ಜಾ಼ಬಿ ಕಲಾವ್ಣಿ ಹುವಾಲಗ್ಯು.<verse eid="EST 3:15" /></para>
  <chapter eid="EST 3" />
  <chapter number="4" style="c" sid="EST 4" />
  <para style="s">ಎಸ್ತೇರ್‌ಕನ ಮದತ್ನಖ್ಹಾಜೆ ಮೊರ್ದೆಕೈನಿ ಬಿಂತಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 4:1" />ಚಾ಼ಲಿತೆ ವಾತ್‌ಖ್ಹಾರಿ ಖ್ಹಮ್‍ಜ್ಯೊತೆ ಮೊರ್ದೆಕೈ, ಇನ ಲುಂಗ್ಡಾನ ಫಾಡಿಲೀನ್ , ಕೋಥ್‌ಳಾನಿ ಛೈ಼ನ ಫೇರಿನ್‌, ಇನಾಪರ್‌ ರಾಕ್‌ ರಂಚಿಲೀನ್ ಖ್ಹಯೇರ್‌ಮಾಕರಿ ಚಾ಼ಲ್ತೊಹುಯಿನ್‌ ಘಣು ದುಖ್‌ಥಿ ಅಂದ್ರೋಖ್ಹ್‌ಕರ‍್ಯೊ. <verse eid="EST 4:1" /><verse number="2" style="v" sid="EST 4:2" />ಯೋಸ್ ಹಾಲತ್‌ಮ ಮಹೇಲ್‌ನ ಮೋಟ ದರ್ವಾಜ಼ಲಗೂಬಿ ಆಯೊ. ಕೋಥ್‌ಳಾನಿ ಛೈ಼ನ ಭಾಂದ್ಯುಹುಯು ಕೋಣ್‌ಬಿ ಮಹಿ ನಾಜ಼ಾವ್ಣುಕರಿ ಹುಕುಮ್‌ಥು. <verse eid="EST 4:2" /><verse number="3" style="v" sid="EST 4:3" />ಖೆವಖೆವ ರಾಜ್ಯಮ ರಾಜ಼ನಿ ಹುಕುಮ್‌ ಅಜು಼ ತೀರ್ಮಾನ್ ಭಡ್‌ಕ್ಯುಕಿ ಹಿಜ್ಜಾ಼ಖ್ಹಾರು ಯೆಹೂದ್ಯವಾಳಮ ಘಣು ದುಖ್‌ಬಿ, ಉಪ್‌ವಾಸ್‌ಬಿ, ರದನ್‌ರೋಝ಼್‌ನ್ಯ ಕರೀನ್ ಕೋಥ್‌ಳಾನಿ ಛೈ಼ನ ಪಾಥ್‌ರೀನ್ ರಾಕ್‌ನ ಉಪ್ಪರ್ ಬೇಶಿಗಯು. <verse eid="EST 4:3" /><verse number="4" style="v" sid="EST 4:4" />ಎಸ್ತೇರ್‌ನಿ ದಾಸಿಯೇ ಅಜು಼ ಮಹೇಲ್ನು ಅದಿಕಾರಿಖ್ಹಾರು ರಾಣಿನ<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">ಸೇವಕಕತೊ ಹಿಝ಼್‌ಡಖ್ಹಾರು</char></note> ಆ ಖ್ಹಾರಿವಾತೆ ಇನ ಖ್ಹಮ್‌ಜಾ಼ಡ್‌ತಾನ, ಯೊ ಘಣಿ ಘಬ್ರಾವ್ಣಿಥಿ ಮೊರ್ದೆಕೈನ ಲುಂಗ್ಡ ದಿಮೋಕ್ಲಿನ್‌, “ಕೋಥ್‌ಳಾನಿಛೈ಼ನ ಕಾಡಿನಾಖಿನ್, ಆ ಫೇರಿಲೆ” ಕರಿ ಬೋಲಿಮೋಕ್ಲಿ ಕತೋಬಿ ಇನೆ ಮಾಂಗ್ಯೊಕೊಯ್ನಿ. <verse eid="EST 4:4" /><verse number="5" style="v" sid="EST 4:5" />ತದೆ ಎಸ್ತೇರ್‌ನೆ ಚಾ಼ಕ್ರಿನಖ್ಹಾಜೆಕರಿ ರಾಜ಼ನೆ ದಿದೋತೆ ಹತಾಕ ಕರಿ ಅದಿಕಾರಿನ ಬುಲೈನ್, ಮೊರ್ದೆಕೈಕನ ಜೈ಼ನ್, “ತೂ ಶನಾ ಅಮ್‌ ಕರ‍್ಯೋತೆ ಕರಿ ಪುಛೈ಼ನ್ ಆವ್” ಕರಿ ಬೋಲಿಮೋಕ್ಲಿ. <verse eid="EST 4:5" /><verse number="6" style="v" sid="EST 4:6" />ಇಮ್ಮಸ್ ಹತಾಕನೆ ಮಹೇಲ್‌ನ ದರ‍್ವಾಜ಼ನ ಖ್ಹಾಮ್ಣೆಛಾ಼ತೆ ಖ್ಹಯೇರ್‌ನು ಬಲ್ಡಾಮ ಮೊರ್ದೆಕೈಕನ ಜಾ಼ವಖ್ಹತರ್, <verse eid="EST 4:6" /><verse number="7" style="v" sid="EST 4:7" />ಮೊರ್ದೆಕೈನೆ, ಚಾ಼ಲಿತೆ ಖ್ಹಾರೀಸ್‍ ವಾತೆನ ಅಜು಼ ಹಾಮಾನನೆ ಯೆಹೂದ್ಯವಾಳನ ನಾಶ್‌ಕರಾನಖ್ಹಾಜೆ ರಾಜ಼ನ ಖಜಿನೊಮಾಥು ಅತ್ರು ರೂಪಾನ ಪೈಶಾದೆವುಸ್‌ಕರಿ ಬೋಲ್ಯೊತೆ ವಾತೆನಾಬಿ ಹತಾಕನ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ. <verse eid="EST 4:7" /><verse number="8" style="v" sid="EST 4:8" />ಆ ನಾಹುಯಿನ್ ಖ್ಹಾರಸ್‌ ಯೆಹೂದ್ಯವಾಳನ ಮಾರಿನಾಖನಖ್ಹಾಜೆ ಶೂಷನ್ ಖ್ಹಯೇರ್‌ಮ ಭಡ್‌ಕ್ಯುತೆ ರಾಜಾ಼ನಿ ಹುಕುಮ್‌ನು ಎಕ್ ಚಿಟ್ಟಿನ ದೀನ್, “ಅನ ಎಸ್ತೇರ್‌ನ ಬೋಲಿವತಾಳ್; ಅಜು಼ ಯೊ ರಾಜ಼ಕನ ಜೈ಼ನ್‌ ಇನ ಅದ್ಮೇವ್ನಖ್ಹಾಜೆ ರಾಜ಼ ಗೋರ್‌ವತಾಳನಿಘೋಣಿ ಇನಾಕನ ಬಿಂತಿಕರಾದೆ”. ಕರಿ ಬೋಲಿಮೋಕ್‌ಲ್ಯೊ. <verse eid="EST 4:8" /><verse number="9" style="v" sid="EST 4:9" />ಹತಾಕನೆ ಪಾಛೊ಼ಫರಿ ಆಯಿನ್ ಎಸ್ತೇರ್‌ನ ಮೊರ್ದೆಕೈನಿ ಅಖ್ಖಿ ವಾತೇವ್ನ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ. <verse eid="EST 4:9" /><verse number="10" style="v" sid="EST 4:10" />ಎಸ್ತೇರ್‌ನೆ ಇನ ಪಾಛು಼ ಮೊರ್ದೆಕೈಕನ ಮೋಕ್ಲಿನ್, <verse eid="EST 4:10" /><verse number="11" style="v" sid="EST 4:11" />“ರಾಜ಼ ಇನಾಕನ ಆವ್ಣುಕರಿ ಬೋಲಿ ನಾ ಮೋಕ್‌ಲ್ಯೋತೊ, ಇನಾಕನ ಮಹೇಲ್‌ನ ಮಹಿ ಜಾ಼ವಾಳನ ಮರಣ್ಣಿ ನಿಶತ್ ದೇವ್ಣುಕರಿ ಹುಕುಮ್‌ನ ತಯೇಡ ಪರ್ಖ್ಹೊಕರಿ ಕೊಂತೆ ಖ್ಹಾರಸ್ನ ಹುಯಿರುಥು. ಕಿನಾಭಣಿ ಇನು ಖ್ಹೊನ್ನಾನು ಡಂಡಾನ ವತಾಳಸ್ಕಿ ಇವ್ಣೆ ಖಲಿ ಜಾನ್‌ಥಿ ಬಚ಼್‌ಶೆ. ಕರಿಬೋಲಾನು ರಾಜಾ಼ನ ಖ್ಹಾರಸ್‌ ಆಳ್‌ನಾಬಿ, ಖ್ಹಾರಾಸ್ ಮಹೇಲ್‌ಮ ರ‍್ಹಾವಾಳನಾಬಿ ಮಾಲುಮ್‌ರ‍್ಹಾವಾನಿ ವಾತೆ. ಮನಾತೊ ಡೋಡಿಖ್ಹ್‌ ದನ್‌ಥು ರಾಜ಼ಕನ ಜಾ಼ವಾನ ಸ್ವಾಗತ ಹುಯುಕೊಯ್ನಿ” ಕರಿ ಖ್ಹಮ್‌ಜಾ಼ಡ್‌ಕರಿ ಬೋಲಿ. <verse eid="EST 4:11" /><verse number="12" style="v" sid="EST 4:12" />ಹತಾಕನೆ ಎಸ್ತೇರ್‌ನಿ ವಾತೆಖ್ಹಾರಿ ಮೊರ್ದೆಕೈನ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ. <verse eid="EST 4:12" /><verse number="13" style="v" sid="EST 4:13" />ತದೆ ಇನೆ ಎಸ್ತೇರ್‌ನ, “ತೂ ಮಹೇಲ್‌ಮಛಾ಼ತೆ ಇನಾಖ್ಹಾಜೆ ಯೆಹೂದ್ಯವಾಳು ನಾಶಹುಯ್ಗುತೋಬಿ ಮೇ ಖಲಿ ಬಚಿಜೈ಼ಶ್‌ಕರಿ ನಕೊಲ್ಹಾಯಿಶ್, <verse eid="EST 4:13" /><verse number="14" style="v" sid="EST 4:14" />ತೂ ಹಮ್ಕೆ ಖ್ಹೊಪೊ ರ‍್ಹಿಗೀತೊ ಬಿಜಿ ಖೆವಿಬಾಜೂ಼ಥುಬಿ ಯೆಹೂದ್ಯವಾಳನ ಮದತ್‌ರ‍್ಹವೊ, ಛುಟ್‌ಕಾರ್‌ರ‍್ಹವೊ ಮಳ್‌ಶೆಕೊಯ್ನಿ. ತೂತೋಬಿ ತಾರ ಬಾನ ಘರ್‌ವಾಳನಿ ಜೋಡ್ಮ ನಾಶ ಹುಯಿಜೈ಼ಶ್‌. ಆನಾಹುಯಿನ್ ತೂ ಅಥ್ರಾನಿ ವಖ್ಹತ್‌ನ ಖ್ಹಾಜೇಸ್ ಪಟ್ಟಾನ ಆಯಿರ‍್ಹಿಉಶೆ. ಕಿನಾಮಾಲುಮ್.” ಕರಿ ಬೋಲಿಮೋಕ್‌ಲ್ಯೊ. <verse eid="EST 4:14" /><verse number="15" style="v" sid="EST 4:15" />ತದೆ ಎಸ್ತೇರ್ ಮೊರ್ದೆಕೈನ, “ತೂ ಜೈ಼ನ್ ಶೂಷನ್ ಖ್ಹಯೇರ್‌ಮ ಛಾ಼ತೆ ಖ್ಹಾರಸ್‌ ಯೆಹೂದ್ಯವಾಳನ ಎಕ್ಟುಕರ್; <verse eid="EST 4:15" /><verse number="16" style="v" sid="EST 4:16" />ತುಮೇಖ್ಹಾರು ಶೂಷನ್ ನಂಗರ್‌ಮ ಮಳಿನ್ ತೀನ್‌ರೋಜ಼್‌ ರಾತ್‌ದನ್ ಖಾಣುಪಾಣಿ ಮ್ಹೇಲಿನ್ ಮಾರಖ್ಹಾಜೆ ಉಪವಾಸರ‍್ಹೆವೊ; ಇಮ್ಮಸ್ ಮೇಬಿ ಮಾರಿ ಸೇವಕಿನಿ ಜೋ಼ಡ್ಮ ಉಪವಾಸ್‌ರ‍್ಹೆವುಸ್‌. ಇನಾಪಾರ್ ರಾಜ಼ನಿ ಹುಕುಮ್‌ನ ಮೀರಿನ್‌ತೋಬಿ ಮೇ ಇನಾಕನ ಜ಼ವುಸ್‌. ಮರಿಗಿತೊ ಮರೀಗಿಕರಿ ಬೋಲಿಮೋಕ್ಲಿ. <verse eid="EST 4:16" /><verse number="17" style="v" sid="EST 4:17" />ಮೊರ್ದೆಕೈ ಪಾಛೊ಼ ಫರಿಜೈ಼ನ್ ಎಸ್ತೇರ್‌ನೆ ಬೋಲಿತೆತಿಮ್ಮಸ್ ಕರ‍್ಯೊ.<verse eid="EST 4:17" /></para>
  <chapter eid="EST 4" />
  <chapter number="5" style="c" sid="EST 5" />
  <para style="s">ಎಸ್ತೇರ್‌ನೆ ರಾಜ಼ನಾಬಿ ಅಜು಼ ಹಾಮಾನ್ನ ಮಿಝ಼್‌ವಾನ್ನ ಬುಲೈತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 5:1" />ತೀನ್ನೊ ದನ್ ಎಸ್ತೇರ್‌ನೆ ರಾಣಿನು ಪೆರ್ವಾಖ್ಹ್‌ನ ಪೇರ‍್ಹಿಲೀನ್ ಮಹೇಲ್‌ನ ಮಹಿಜೈ಼ನ್, ರಾಜ಼ನ ಘರ್‌ನು ಬಲ್ಡಾನ ಖ್ಹಾಮ್ಣೆ ಭೀರಿಗೈ. ರಾಜ಼ ಯೊ ಘರ್‌ಮ ರಾಜ಼ ಸಿಂಹಾಸನ್‌ಪರ್‌ ದರ‍್ವಾಜ಼ನ ಮ್ಹೋರೆಹುಯಿನ್‌ ಬೇಠೋಥೊ. <verse eid="EST 5:1" /><verse number="2" style="v" sid="EST 5:2" />ಯೊ ಭಾರ್‌ ಭಿಯಿಥೀತೆ ಎಸ್ತೇರ್ ರಾಣಿನ ದೇಕ್‌ತನಾಸ್‌ ಇನಾಪರ್ ವಾರ್ಖ್ಹೊ ಕರೀನ್ ಇನ ಹಾತ್‌ಮ ಥೂತೆ ಖ್ಹೊನ್ನಾನ ಡಂಡಾನ ಇನಾಭಣಿ ವತಾಳ್ಯೊ. ಎಸ್ತೇರ್ ಖನ್ನೆಆಯಿನ್ ರಾಜ಼ಡಂಡಾನಿ ನೋಕ್‌ನ ಛೀಮಿ. <verse eid="EST 5:2" /><verse number="3" style="v" sid="EST 5:3" />ರಾಜ಼ನೆ ಇನ, “ಎಸ್ತೇರ್ ರಾಣಿ, ತುನ ಶಾತ್ ಹೋಣು?” ತಾರಿ ಬಿಂತಿ ಶಾತ್? ತೂ ಮಾರ ರಾಜ್ಯಮಾಥು ಆಧು ಭಾಗ್‌ ಮಾಂಗಿತೋಬಿ ಮೇ ತುನ ದೆವುಸ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EST 5:3" /><verse number="4" style="v" sid="EST 5:4" />ಇನ ಎಸ್ತೇರ್‌ನೆ, “ರಾಜ಼ ಮಾನಿಲ್ಯಾವಾಳೊ ಉಶೇತೊ ಮೇ ಆ ವಖ್ಹತ್ ತುಮಾರಖ್ಹಾಜೆ ತಯಾರ್ ಕರಿರಾಖಿತೆ ಮಿಝ಼್‌ವಾನ್ನಖ್ಹಾಜೆ ಹಾಮಾನನಿ ಜೋ಼ಡ್ಮ ಆವ್ಣುಕರಿ” ಬಿಂತಿಕರಿಲಿದಿ. <verse eid="EST 5:4" /><verse number="5" style="v" sid="EST 5:5" />ತದೇಸ್‌ ರಾಜ಼ನೆ, “ಎಸ್ತೇರ್‌ನಿ ಬಿಂತಿನ ಚ಼ಲೈದ್ಯವಾನಖ್ಹಾಜೆ ಹಾಮಾನನ ಬುಲೈಲಿನ್ ಆವೊ” ಕರಿ ಹುಕುಮ್‌ಕರೀನ್‌ ಎಸ್ತೇರ್‌ನೆ ಕರೈತೆ ಮಿಝ಼್‌ವಾನ್ನಖ್ಹಾಜೆ ಹಾಮಾನನ ಜೋ಼ಡ್ಮ ಗಯೊ. <verse eid="EST 5:5" /><verse number="6" style="v" sid="EST 5:6" />ದ್ರಾಕ್ಷಿನೊ ರಖ್ಹ್ ಪಿಯ್ಯಾನಿ ವಖ್ಹ್‌ತೆ ರಾಜ಼ನೆ ಬಿಜೇಕ್‌ಹಲ್ಲ ಎಸ್ತೇರ್‌ನ, “ತಾರಿ ಬಿಂತಿ ಶಾತ್ ಬೋಲ್; ಮೇ ಇನ ಚ಼ಲೈದೆವುಸ್‌. ತೂ ಮಾರ ರಾಜ್ಯಮಾಥು ಆಧು ಭಾಗ್‌ ಮಾಂಗಿತೋಬಿ ಮೇ ಯೊ ತುನಾ ದೆವುಸ್‌” ಕರಿಬೋಲ್ಯೊ. <verse eid="EST 5:6" /><verse number="7" style="v" sid="EST 5:7" />ಇನ ಎಸ್ತೇರ್‌ನೆ, “ರಾಜ಼ ಮಾರಪರ್ ವಾರ್ಖ್ಹೊಕರಿನ್ ಮೇ ಬೋಲುಸ್ತೆ ದ್ಯವಾನಾಬಿ ಮಾರಿ ಬಿಂತಿನ ಚ಼ಲೈದ್ಯವಾನ ಮನ್‌ರ‍್ಹಯೂತೊ, <verse eid="EST 5:7" /><verse number="8" style="v" sid="EST 5:8" />ಮೇ ತುಮಾರಖ್ಹಾಜೆ ತಯಾರ್‌ಕರೈಶ್ತೆ ಮಿಝ಼್‌ವಾನ್ನಖ್ಹಾಜೆ ಕಾಲ್‌ಬಿ ಹಾಮಾನ್ನಿ ಜೋ಼ಡ್ಮ ಆವ್ಣು; ತದೆ ರಾಜ಼ ಬೋಲನಿತರಾಸ್ ಮೇ ಕರೀಶ್, ಆಸ್‌ ಮಾರಿ ಬಿಂತಿ.<verse eid="EST 5:8" /></para>
  <para style="s">ಮೊರ್ದೆಕೈನ ಖೂನ್ ಕರಾನ ಹಾಮಾನನಿ ಹೂಡ್‌</para>
  <para style="p">
    <verse number="9" style="v" sid="EST 5:9" />ಯೊ ದನ್ ಹಾಮಾನ ಖ್ಹುಶಿನಪೋಭಾರಮ ಘರೆ ಜಾ಼ವಾನಿ ವಖ್ಹ್‌ತೆ ಮೊರ್ದೆಕೈ ಇನೇಥಿ ಡರ‍್ಯೊಬಿಕೊಯ್ನಿ, ಇನ ಖ್ಹಾಮ್ಣೆ ಉಠ್ಯೋಬಿಕೊಂತೆ ಮಹೇಲ್‌ನ ದರ‍್ವಾಜ಼ಕನ ಬೆಠೊರ‍್ಹವಾನು ದೇಖಿನ್ ಇನಾಪರ್ ಘಣು ಇರಾದೊ ಕರ‍್ಯೊ. <verse eid="EST 5:9" /><verse number="10" style="v" sid="EST 5:10" />ರ‍್ಹೀನ್‌ಬಿ ಹಾಮಾನನೆ ಇನ ಇರಾದನ ಖ್ಹಮಾಳಿಲೀನ್ ಘರೆ ಜೈ಼ನ್ ಇನ ದೋಸ್ತಿಯೆನಾಬಿ, ಇನಿ ಬಾವಣ್ ಜೆರೆಷನಾಬಿ ಬುಲೈಮಂಗಾಯೊ. <verse eid="EST 5:10" /><verse number="11" style="v" sid="EST 5:11" />ಇವ್ಣಖ್ಹಾಮ್ಣೆ ಇನು ಧನ್‍ದೌಲತ್ನಾಬಿ, ಛಿಯ್ಯಾವ್ನಿ ಬಾರೇಮಬಿ, ರಾಜ಼ನೆ ಇನ ಖ್ಹರಾವ್ಣಿ ಇಜ಼್ಜತ್‌ ಕರ‍್ಯೋತೇಬಿ ಖ್ಹಾರಾಸ್ ಅದಿಕಾರಿಯೆಮಾಬಿ, ರಾಜನ ಸೇವಕರ್‌ಥೀಬಿ ಇನ ಊಚಿಝ಼಼ಗೊನ ದಿದೋತೇಬಿ ಖ್ಹರಾಯೊ. <verse eid="EST 5:11" /><verse number="12" style="v" sid="EST 5:12" />ಆ ನಾಹುಯಿನ್‌ ಎಸ್ತೇರ್‌ ರಾಣಿಸ್ ಖ್ಹುದ್ ತಯ್ಯಾರ್‌ಕರೀತೆ ಮಿಝ಼್‌ವಾನ್ನ ಮನಾಬಿ ರಾಜ಼ನ ಕಾಹೆತೆ ಬಿಜು಼ಕಿನಾಬಿ ಬುಲೈಕೊಯ್ನಿ. ಕಾಲ್‌ಬಿ ಇನೆ ಬುಲೈರಾಖಿಸ್ ಕರೀಬಿ ಹಾಮಾನನೆ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ. <verse eid="EST 5:12" /><verse number="13" style="v" sid="EST 5:13" />ಕತೋಬಿ ಯೆಹೂದ್ಯವಾಳೊ ಹುಯಿರೋತೆ ಮೊರ್ದೆಕೈ ಮಹೇಲ್‌ನ ದರ‍್ವಾಜ಼ಕನ ಮಾರ ಡೋಳಾನ ಖ್ಹಾಮ್ಣೆ ಬೆಠೊರ‍್ಹವಾಲಗೂಬಿ ಆ ಅಖ್ಖೇಥಿ ಮನ ಹಕ್ಲಾಲ್ ಕೋಉಶೇನಿ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EST 5:13" /><verse number="14" style="v" sid="EST 5:14" />ಇನಾಖ್ಹಾಜೆ ಇನಿ ಬಾವಣ್ ಜೆರೆಷಬೀ ಅಜು಼ ಇನ ದೋಸ್ತಿಯೇಬಿ ಇನ, “ಅಢೈವೀಖ್ಹ್ ಹಾತ್ ಊಚು಼ರ‍್ಹಾವಾನು ಏಕ್‌ ಗಳ್‌ಫಾಶಿನು ಖಂಬಾನ ತಯಾರ್‌ಕರೈನ್ ಕಾಲ್ ಕುಶಿಖ್ಹು ರಾಜ಼ನಿ ಹುಕುಮ್‌ಲೀನ್‌ ಮೊರ್ದೆಕೈನ ಖಂಬಾಪರ್‌ ಠಂಗಾವ್ಣು; ಇನಾಪಾರ್ ತೂ ಖ್ಹುಶೀಥಿ ರಾಜ಼ನಿ ಜೋ಼ಡ್ಮ ಮಿಝ಼್‌ವಾನ್ನ ಜ಼ಯೇಜಾ಼ಯ್.” ಕರಿ ಬೊಲ್ಯೊ. ಹಾಮಾನನೆ ಆ ವಾತ್ನ ಮಾನಿನ್‌ ಇಮ್ಮಸ್‌ ಗಳ್‌ಫಾಶಿನ ತಯಾರ್ ಕರಾಯೊ.<verse eid="EST 5:14" /></para>
  <chapter eid="EST 5" />
  <chapter number="6" style="c" sid="EST 6" />
  <para style="s">ಮೊರ್ದೆಕೈನ ರಾಜ಼ನೆ ಮರ‍್ಯಾದಿ ಕರ‍್ಯೊತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 6:1" />ಯೊ ರಾತ್ ರಾಜ಼ನ ನಿಂದರಸ್‌ ಕೋಆಯ್ನಿ, ಇನಖ್ಹಾಜೆ ಇನೆ ಯಾದ್‌ಕರಾಖ್ಹರ್ಕು ಇನಾಮ ರಾಜಾ಼ನಿ ರಾಜ಼್‌ಭಾರ್‌ನು ಜ಼ಮಾನನಿ ವಾತೆಖ್ಹಾರಿ ಲೀಖ್ಯುಹುಯು ದಪ್ತರ್‌ನ ಮಂಗೈನ್‌ ಇನ ಪಢಾವಖ್ಹತರ್‌, <verse eid="EST 6:1" /><verse number="2" style="v" sid="EST 6:2" />ರಾಜ಼ನ ಮಾರಿನಾಕ್ಣುಕರಿ ದರ‍್ವಾಜ಼ನ ಕಾವ್ಲಿಕರವಾಳ ಬಿಗೆತಾನ್‌, ತೆರೆಷ್ ಕರಿ ಬೇಜ಼ಣ ರಾಜಾ಼ನ ಅದಿಕಾರಿ ಹಿಕ್‌ಮತ್‌ಕರ‍್ಯಾತೆ ವಾತೆ ಅಜು಼ ಯೊ ವಾತೆ ಮೊರ್ದೆಕೈಥಿ ಭಾರ್ ಭಡ್‌ಕ್ಯುತೆ ಇನಾಮ ಲಿಖೈರ‍್ಹುಥು. <verse eid="EST 6:2" /><verse number="3" style="v" sid="EST 6:3" />ತದೆ ರಾಜ಼ನೆ, “ಯೊ ಅಛ಼್ಛ ಕಾಮ್ನಖ್ಹಾಜೆ ಮೊರ್ದೆಕೈನ ಖಿವಿ ಮರ‍್ಯಾದಿ ಮಳಿ?” ಕರಿ ಫುಛಾ಼ವಖ್ಹತರ್, ಇನ ಮಹೇಲ್‌ಮ ಕಾಮ್‌ಕರವಾಳು “ಖಿವೂಬಿ ಮಳ್ಯುಕೊಯ್ನಿ” ಕರಿಬೋಲ್ಯು. <verse eid="EST 6:3" /><verse number="4" style="v" sid="EST 6:4" />ತದೆ ರಾಜ಼ನೆ, “ಕೋಣ್ ಹಿಜ್ಜಾ಼ ಮಹೇಲ್‌ಮ ಛಾ಼ತೆ ಮಾರ ಅದಿಕಾರಿಯೆ?” ಕರಿ ಬೊಲ್ಯೊ. ಎತ್ರಾಮ ಹಾಮಾನನೆಸ್‌ ತಯಾರ್ ಕರಿರಾಖ್ಯೊಥೊತೆ ಫಾಖ್ಹಾಮ ಮೊರ್ದೆಕೈನ ಠಂಗಾವನ ರಾಜ಼ನಿ ಹುಕುಮ್ ಲೀಲೆವ್ಣುಕರಿ ಮಹೇಲ್‌ನ ಬಲ್ಡಾಮ ಅಯಿನ್ ಭಿಯೋಥೊ. <verse eid="EST 6:4" /><verse number="5" style="v" sid="EST 6:5" />ತದೆ ರಾಜ಼ನ ಸೇವಕರ‍್ನೆ, “ಹಂದೇಖೊ, ಬಲ್ಡಾಮ ಹಾಮಾನ ಭಿಯೋಸ್” ಕರಿ ಬೋಲ್ಯು. ತದೆ ರಾಜ಼ನೆ, “ಯೊ ಮಹಿ ಆವಾದೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="EST 6:5" /><verse number="6" style="v" sid="EST 6:6" />ತದೆ ಹಾಮಾನ ಮಹಿ ಆವಖ್ಹತರ್, “ರಾಜ಼ನೆ ಕಿನಾತೋಬಿ ಮರ‍್ಯಾದಿ ಕರೈಲೇವ್ಣುಕರಿ ಆಖ್ಹ್‌ಕರ‍್ಯೂತೊ ಎಥ್ರಾನವಾಳನ ಕರ್ನುತೆ ಶಾತ್?” ಕರಿ ಇನ ಬೊಲ್ಯೊ. ಇನ ಹಮಾನನೆ, “ಹಮ್ಕೆ ರಾಜ಼ ಕೋಣ್? ಕಿನ ಮರ‍್ಯಾದಿದ್ಯಾವನ ಪಸಂದ್‌ಕರ್‌ಶೆ?” ಕರಿ ಬೊಲ್ಯೊ, <verse eid="EST 6:6" /><verse number="7" style="v" sid="EST 6:7" />ಇನಖ್ಹಾಜೆ ಹಾಮಾನನೆ ರಾಜ಼ ಮರ‍್ಯಾದೆ ದ್ಯವಾನ ಪಸಂದ್‌ಕರಾಸ್ತೆ ಅದ್ಮಿನ ಅಮ್‌ ಕರ‍್ನು. <verse eid="EST 6:7" /><verse number="8" style="v" sid="EST 6:8" />ಇನೆ ರಾಜ಼ನ, ಕಿನಾತೋಬಿ ಮರ‍್ಯಾದಿಕರ್ನುಕರಿ ಪಸಂದ್ ಉಷೇತೊ ರಾಜ಼ ಫೇರಾನು ಪೆರ್ವಾಖ್ಹ್‌ಬಿ ಅಜು಼ ಸವಾರಿಕರಾನು ಪಟ್ಟಾನೊ ಘೋಡಾನ ಮಂಗಾವ್ಣು. <verse eid="EST 6:8" /><verse number="9" style="v" sid="EST 6:9" />ಯೊ ಪೆರ್ವಾಖ್ಹ್‌ನಾಬಿ ಘೋಡನಾಬಿ ಮುಖ್ಯ ರಾಜ಼ನ ಸರ್ದಾರ್‌ಮ ಏಕ್‌ಜ಼ಣಾನಿ ಕಬ್‌ಜಾ಼ಮ ದೀನ್, ರಾಜ಼ ಮರ‍್ಯಾದಿ ಕರ್ನುಕರಿಛಾ಼ತೆ ಅದ್ಮಿನ ಯೊ ರಾಜ಼ನ ಪೆರ್ವಾಖ್ಹ್‌ನ ಫೇರೈನ್, ಘೋಡಾನ ಉಪ್ಪರ್ ಬೆಖ್ಹಾಡಿನ್ ಖ್ಹಯೇರ್ನಿ ಚೌ಼ಕ್‌ಮ ಮೀರೊಂಗ್ಣಿ ಕರಾವ್ತುಹುಯಿನ್ ಇನಖ್ಹಾಮ್ಣೆ, ‘ರಾಜ಼ ಮರ‍್ಯಾದಿ ಕರ್ನುಕರಿಛಾ಼ತೆ ಇನ ಮರ‍್ಯಾದಿದ್ಯವಾನಿ ಪರಕ್ ಆಸ್’ ಕರಿ ಭಡ್ಕಾವ್ಣು” ಕರಿಬೋಲ್ಯೊ. <verse eid="EST 6:9" /><verse number="10" style="v" sid="EST 6:10" />ತದೆ ರಾಜ಼ನೆ ಹಾಮಾನ್ನ, “ತುನೆ ಬೋಲ್ಯೊತೆ ಪೆರ್ವಾಖ್ಹ್‌ನಾಬಿ ಅಜು಼ ಘೋಡಾನಾಬಿ ಒಗ್ಗಿಸ್ ಮಂಗೈನ್ ಮಹೇಲ್ನ ದರ‍್ವಾಜ಼ಕನ ಬೆಠೋತೆ ಮೊರ್ದೆಕೈ ಕರಿ ಯೆಹೂದ್ಯನ ಇಮ್ಮಸ್ ಕರ್‌; ತುನೆ ಬೋಲ್ಯೊತೆ ಇನಾಮ ಖಿವು ಏಕ್‌ಬಿ ಮ್ಹೆಲಿಶ್‌ನಕೋತೆ ಕರ್ಜೊ” ಕರಿ ಹುಕುಮ್ ದಿದೊ. <verse eid="EST 6:10" /><verse number="11" style="v" sid="EST 6:11" />ಹಾಮಾನನೆ ಯೊ ಪೆರ್ವಾಖ್ಹ್‌ನಾಬಿ ಅಜು಼ ಘೋಡಾನಾಬಿ ಲಯಿನ್, ಮೊರ್ದೆಕೈನ ಫೇರೈನ್, ಖ್ಹಯೇರ್ನಿ ಚೌ಼ಕ್‌ಮ ಮೀರೊಂಗ್ಣಿ ಕರೈನ್, ಇನಖ್ಹಾಮ್ಣೆ, “ರಾಜ಼ ಮರ‍್ಯಾದಿ ಕರ್ನುಕರಿಛಾ಼ತೆ ಇನ ಮರ‍್ಯಾದಿದ್ಯವಾನಿ ಪರಕ್ ಆಸ್” ಕರಿ ಭಡ್ಕಾಯೊ. <verse eid="EST 6:11" /><verse number="12" style="v" sid="EST 6:12" />ಮೊರ್ದೆಕೈ, ಪಾಛೊ಼ ಮಹೇಲ್‌ನ ದರ‍್ವಾಜ಼ಕನ ಆಯೊ. ಹಾಮಾನಾತೊ ದುಖ್‌ಥಿ ಮ್ಹೋಡಾನ ಮೂಚಿಲೀನ್, <verse eid="EST 6:12" /><verse number="13" style="v" sid="EST 6:13" />ಒಗ್ಗಿಸ್ ಘರೆಜೈನ್ ಇನಿ ಬಾವಣ್‌ಹುಯಿರೀತೆ ಜೆರೆಷನ ಅಜು಼ ಅಖ್ಖಾ ಮಾಯಮಾತ್ರನ ಖ್ಹಾಮ್ಣೆ ಹಿಜ಼್ಜಾ ಹುಯುತೆ ಇನ ಬೊಲ್ಯೊ. ತದೆ ಪೊಂಡಿತ್‌ಖ್ಹಾರು ಅಜು಼ ಬಾವಣ್ಣೆ ಹಾಮಾನನ, “ಕಿನ ಖ್ಹಾಮ್ಣೆ ತಾರಿ ಹಾರ್‌ ಶುರುಹುಯುಕಿ ಯೊ ಅದ್ಮಿ ಯೆಹೂದ್ಯವಾಳೊ ಹುಯಿರೊತೊ, ತೂ ಇನೇಥಿ ಜೂತಿಶ್ ಕೊಯ್ನಿ. ಇನ ಖ್ಹಾಮ್ಣೆಪಡೀನ್ ಬರ್‌ಬಾತ್‌ ಹುಯಿಜಿಶ್” ಕರಿ ಬೋಲ್ಯು.<verse eid="EST 6:13" /></para>
  <para style="s">ಹಾಮಾನನ ಗಳ್‌ಫಾಶಿ ಹುಯೂತೆ</para>
  <para style="p">
    <verse number="14" style="v" sid="EST 6:14" />ಇವ್ಣೆ ಅಜೂ಼ಬಿ ಇನಿ ಜೋ಼ಡ್ಮ ವಾತೆ ಬೋಲುಕರಾನಿ ವಖ್ಹ್‌ತೇಸ್ ರಾಜ಼ನ ಮಹೇಲ್‌ನು ಅದಿಕಾರಿಖ್ಹಾರು ಆಯಿನ್ ಎಸ್ತೇರ್ ಕರೈರಾಖಿತೆ ಮಿಝ಼್‌ವಾನ್ನ ಒಗ್ಗಿಸ್ ಆವ್ಣುಕರಿ ಹಾಮಾನನ ಬುಲೈಲೀಗು.<verse eid="EST 6:14" /></para>
  <chapter eid="EST 6" />
  <chapter number="7" style="c" sid="EST 7" />
  <para style="p">
    <verse number="1" style="v" sid="EST 7:1" />ರಾಜ಼ ಹಾಮಾನನಿ ಜೋ಼ಡ್ಮ ಎಸ್ತೇರ್‌ನ ಘರೆ ಮಿಝ಼್‌ವಾನ್ನಖ್ಹಾಜೆ ಗಯೊ. <verse eid="EST 7:1" /><verse number="2" style="v" sid="EST 7:2" />ಯೊ ಬೇನ ದನ್‌ಬಿ ದ್ರಾಕ್ಷಿನೊ ರಖ್ಹ್‌ನ ಪಿಯಾನಿವಖ್ಹ್‌ತೆ ರಾಜ಼ನೆ ಎಸ್ತೇರ್‌ನ, “ಎಸ್ತೇರ್ ರಾಣಿ, ತಾರಿ ಆಖ್ಹ್ ಶಾತ್ ಬೋಲ್; ಮೇ ಇನ ಚ಼ಲೈದೆವುಸ್‌. ತೂ ಮಾರಿ ಆಧ ರಾಜ್ಯನ ಬೋಲಿತೋಬಿ ಮೇ ತುನ ದೆವುಸ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EST 7:2" /><verse number="3" style="v" sid="EST 7:3" />ತದೆ ಎಸ್ತೇರ್‌ ರಾಣಿನೆ, “ರಾಜ಼ ಮಾರಪರ್ ಗೋರ್‌ಕರೀನ್ ಒಹೊ ಕರಿ ಬೋಲಾವಾಳೊ ಉಶೇತೊ ಮಾರಿ ಬಿಂತಿನಾಬಿ, ಪ್ರಾರ್ಥನೆನಾಬಿ, ಖ್ಹಮ್‌ಜಿನ್ ಮಾರ ಜಾನ್ನಬಿ ಅಜು಼ ಮಾರ ಅದ್ಮೆವ್‌ನಾಬಿ ಬಚಾ಼ಡ್‌ನು. <verse eid="EST 7:3" /><verse number="4" style="v" sid="EST 7:4" />ಅದ್ಮಿಖ್ಹಾರು ಹಮುನ ಕತ್ರಿ ಮಾರಿನಾಖಿನ್, ಹಮುನ ಖತಮ್ ಕರಿನಾಖನಿಘೋಣಿ ಹಮೆ ವೇಚೈ಼ಗಯ. ಖಲಿ ವೇಚೈ಼ಗಯ ಹೋತ್ತೊ ಆ ಖರಾಬ್ ಹಾಲತ್‌ನಿ ಬಾರೇಮ ರಾಜ಼ನ ತಕ್‌ಲಿಬ್ ದ್ಯಾವಾನು ಬರೋಬರ್‌ಕೊಯ್ನಿಕರಿ ಖ್ಹೊಪೊರ‍್ಹಿಗೈಹೋತ್.” ಕರಿ ಬೋಲಿ. <verse eid="EST 7:4" /><verse number="5" style="v" sid="EST 7:5" />ತದೆ ರಾಜ಼ನೆ ಎಸ್ತೇರ್‌ ರಾಣಿನ, “ಅಥ್ರಾನು ಕಾಮ್ ಕರಾನ ಕಳ್ ಚ಼ಲಾಯೋತೆ ಕೋಣ್? ಯೊ ಕಿಜ಼್ಜ ಛಾ಼?” ಕರಿ ಪುಛಾ಼ಯೊ. <verse eid="EST 7:5" /><verse number="6" style="v" sid="EST 7:6" />ತದೆ ಇನೆ, “ಹಮಾರೊ ದುಶ್ಮನ್‌ಬಿ ವಹೇರ‍್ಯೊ ಬಿಜು಼ಕೋಣ್‌ಬಿ ಕಾಹೆ; ಹಂದೇಕ್ ಆ ಹಾಮಾನಾಸ್ ಯೊ ದುಷ್ಟ” ಕರಿ ಬೋಲಿ. ಅನ ಖ್ಹಮಜ಼್‌ತಾನಸ್ ಹಾಮಾನನೆ ರಾಜ಼ ಅಜು಼ ರಾಣಿನ ಖ್ಹಾಮ್ಣೆ ಡರ್‌ಥಿ ಕಾಪಲಗ್ಯೊ. <verse eid="EST 7:6" /><verse number="7" style="v" sid="EST 7:7" />ಚ಼ಂಢಾಳ್‌ಥಿ ರಾಜ಼ನೆ ದ್ರಾಕ್ಷಿನೊ ರಖ್ಹ್‌ಪಿಯಾನು ಮ್ಹೇಲಿನ್ ಉಠಿ ಮಹೇಲ್‌ನ ಬಗೀಚಾ಼ಮ ಗಯೊ. ರಾಜಾ಼ಥಿ ಇನ ನಿಶತ್‌ ತಯಾರ್ ಹುಯಿಗಿಕರಿ ಮಾಲುಮ್‌ ಪಡಿನ್, ಹಾಮಾನನೆ ಎಸ್ತೇರ್ ರಾಣಿನ ಖ್ಹಾಮ್ಣೆ ಗಿಂಗೈನ್ ಜಾನ್ನಿ ಭೀಕ್ ಮಾಂಗ್ಯೊ. <verse eid="EST 7:7" /><verse number="8" style="v" sid="EST 7:8" />ರಾಜ಼ ಮಹೇಲ್‌ನು ಬಗೀಚ಼ಮಾಥೊ ಯೊ ದ್ರಾಕ್ಷಿನೊರಖ್ಹ್‌ ಪೀತೊಥೊತೆ ಕೋಣಾಮ ಆಯೋತೆ ತದೆ, ಎಸ್ತೇರ್ ಟೇಕೊದೀನ್ ಬೇಠಿಥೀತೆ ಅರಾಮ್‌ನಿ ಖುಡ್‌ಶಿಭಣಿ ಹಾಮಾನ ಝು಼ಕಿರ‍್ಹಯೋತೆ ದೇಖಿನ್, “ಆ ಶಾತ್‌? ಹೈರೋತೆ ಮಾರಖ್ಹಾಮ್ಣೇಸ್ ಮಾರಿ ಮಹೇಲ್‌ಮಾಸ್ ರಾಣಿಪರ್ ಬಲಾತ್ಕಾರ್ ಕರ್ನುಕರಿ ಛಾ಼ಕಿಶೂ?” ಕರಿಬೋಲ್ಯೊ. ರಾಜ಼ನ ಮ್ಹೋಡಾಮಾಥು ಆ ವಾತ್ ನಿಕಳ್‌ತಾಸ್ ಆಳ್‌ ಖ್ಹಾರು ಹಾಮಾನನ ಮ್ಹೋಡಾಪರ್ ಲುಂಗ್ಡು ಢಾಪಿನ್‌ ಖೇಚಿ ಲೀನ್‌ಗಯು. <verse eid="EST 7:8" /><verse number="9" style="v" sid="EST 7:9" />ಆ ನಾಹುಯಿನ್, ರಾಜ಼ನು ಚಾ಼ಕ್ರಿ ಕರ್ತುಥೂತೆ ಅದಿಕಾರಿಮಥೊ ಏಕ್‌ಜ಼ಣೊ ಹರ್ಬೋನನೆ, “ಹಂದೇಕ್, ರಾಜ಼ನೊ ಜಾನ್‌ ಬಚಾ಼ಡಾನಿ ವಾತ್ ಬೋಲ್ಯೋತೆ ಮೊರ್ದೆಕೈನ ಮರ್‌ನಾಖಾನಖ್ಹಾಜೆ ಹಾಮಾನನೆ ತಯಾರ್‌ಕರ‍್ಯೋತೆ ಅಢೈವೀಖ್ಹ್ ಹಾತ್ ಊಚು಼ರ‍್ಹವಾನು ಗಳ್‌ಫಾಶಿನು ಖಂಬಾನ ತಯಾರ್‌ ಕರಿರಾಖ್ಯೋಸ್‌” ಕರಿ ಬೊಲ್ಯೊ. ಇನಾಖ್ಹಾಜೆ ರಾಜ಼ನೆ, “ಇಮ್ ಉಶೇತೊ ಹಾಮಾನನ ಇನಾಪರಸ್‌ ಠಂಗಾವೊ.” ಕರಿ ಹುಕುಮ್ ಕರ‍್ಯೊ. <verse eid="EST 7:9" /><verse number="10" style="v" sid="EST 7:10" />ಮೊರ್ದೆಕೈನಖ್ಹಾಜೆ ತಯಾರ್ ಬಣಾಯುಹುಯು ಯೋಸ್‌ ಗಳ್‌ಫಾಶಿನ ಖಂಬಾಪರ್ ಹಾಮಾನನ ಠಂಗಾಯು. ಅಮ್ ಕರೀನ್‌ ರಾಜ಼ನಿ ಚ಼ಂಢಾಳ್ ಠಂಡೊಹುಯು.<verse eid="EST 7:10" /></para>
  <chapter eid="EST 7" />
  <chapter number="8" style="c" sid="EST 8" />
  <para style="s">ಯೆಹೂದ್ಯವಾಳನೆ ಶೊಂತ್‌ ಬಚೈಲ್ಯವಾನಖ್ಹಾಜೆ ಜಂಗ್‌ಭೀಡಾನ ಬುಲಾವ್ಣಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 8:1" />ಯೋಸ್ ದನ್ ರಾಜ಼ ಅಹಷ್ವೇರೋಷನೆ, ಯೆಹೂದ್ಯವಾಳನೊ ವಹೇರ‍್ಯೊ ಹಾಮಾನನ ಥೂತೆ ಘರ್‌ನ ರಾಣಿ ಎಸ್ತೇರ್‌ನ ದಿದೊ. ರಾಣಿನೆ, ಇನಾಬಿ ಮೊರ್ದೆಕೈನಾಬಿ ಥೂತೆ ಖ್ಹಾಚು಼ ಸಂಬಂದಾನಿ ಬಾರೇಮ ರಾಜ಼ನ ಖ್ಹಮ್‌ಜಾ಼ಡಿ. ತಪ್‌ಥೊ ಮೊರ್ದೆಕೈನ ರಾಜ಼ನಖ್ಹಾಮ್ಣೆ ಆವಾನಿ ಅವಕಾಶ್‌ ದೆವೈರುಥು. <verse eid="EST 8:1" /><verse number="2" style="v" sid="EST 8:2" />ತದೆ ರಾಜ಼ನೆ ಮೊರ್ದೆಕೈನ ಮರ‍್ಯಾದಿದೀನ್ ಹಾಮಾನಥಿ ಕಡಾಯೋತೆ ಮುದ್ರಾನಿ ಅಂಗುಠಿ ಇನ ದಿದೊ; ಎಸ್ತೇರ್‌ನೆ ಹಾಮಾನನು ಘರ್‌ನು ಜಿಮ್ಮೆದಾರಿನ ಇನ ದಿದಿ. <verse eid="EST 8:2" /><verse number="3" style="v" sid="EST 8:3" />ಎಸ್ತೇರ್ ಪಾಛಿ ರಾಜ಼ನ ಖ್ಹಾಮ್ಣೆ ಜೈ಼ನ್ ಇನ ಗೋಡಾಪರ್ ಪಡೀನ್, ರೋವ್ತಿಹುಯಿನ್, “ಅಗಾಗನಿ ಪಿಳ್ಗಿವಾಳೊ ಹಾಮಾನನೆ ಯೆಹೂದ್ಯವಾಳನಿ ಕೇಡ್ನಖ್ಹಾಜೆ‍ ಕರ‍್ಯೋತೆ ಖರಾಬ್‌ಖ್ಹೂಜ಼್‌ನ, ಖಾನೂಲ್‌ ಕಾಡಿನಾಕ್ಣುಕರಿ ಬಿಂತಿಕರಿಲಿದಿ. <verse eid="EST 8:3" /><verse number="4" style="v" sid="EST 8:4" />ರಾಜ಼ ಇನೊ ಖ್ಹೊನ್ನಾನೊ ಡಂಡೊ ಇನಾಭಣಿ ವತಾಳ್‌ತಾನ, ಯೊ ರಾಜ಼ನ ಖ್ಹಾಮ್ಣೆ ಉಠಿಭೀರಿನ್, <verse eid="EST 8:4" /><verse number="5" style="v" sid="EST 8:5" />“ತುಮೆ ಮರಾಪರ್ ಗೋರ್‌ಕರೀನ್, ಮನ ಪಸಂದ್‌ಕರೀನ್, ಮೇ ಬೋಲುತೆ ವಾತ್ ಅಛ್ಛು಼ಕರಿ ಗಣ್ತಿ ಕರೀನ್ ಇನ ಮಾನವಾಳೊ ಉಶೇತೊ, ರಾಜ಼ನ ಖ್ಹಾರಾಸ್ ತಬರ್ಖಾಮಛಾ಼ತೆ ಯೆಹೂದ್ಯವಾಳನ ಮಾರಿನಾಖನಖ್ಹಾಜೆ ಅಗಾಗನಿ ಪಿಳ್ಗಿವಾಳೊ ಹಮ್ಮೆದಾತನೊ ಛಿಯ್ಯೋಬಿ ಹುಯಿರೋತೆ ಹಾಮಾನನೆ ಲೀಖಾಯೋತೆ ಚಿಟ್ಟಿಯೇವ್ನ ವಜ಼ಾ ಕರಾನಖ್ಹಾಜೆ ಹುಕುಮ್‌ನ ಚ಼ಲಾವ್ಣು. <verse eid="EST 8:5" /><verse number="6" style="v" sid="EST 8:6" />ಮಾರ ಶೊಂತ್ ಅದ್ಮೇವ್‌ನ ಕೇಡ್‌ಹುವಾನು ಡೋಳೇಖ್ಹು ದೇಖಿನ್ ಮೇ ಕಿಮ್‍ತೋಬಿ ಖ್ಹಮಾಳು? ಮಾರಿ ಖೂಮ್‌ನು ನಾಶನ ದೇಖಿನ್ ಖ್ಹೊಪೊರ‍್ಹವಾನೂಬಿ ಕಿಮ್?” ಕರಿ ಬಿಂತಿಕರಿಲಿದಿ. <verse eid="EST 8:6" /><verse number="7" style="v" sid="EST 8:7" />ತದೆ ರಾಜ಼ನೆ, ರಾಣಿ ಎಸ್ತೇರ್‌ನಾಬಿ ಯೆಹೂದ್ಯವಾಳೊ ಮೊರ್ದೆಕೈನಾಬಿ, “ಹಾಮಾನನೆ ಯೆಹೂದ್ಯವಾಳನ ವಿರೋದ್‌ ಹಾತ್‌ಪಾಡ್ಯೋತೆ ಇನಾಖ್ಹಾಜೆ ಇನ ಗಳ್‌ಫಾಶಿದೀನ್ ಇನ ಘರ್‌ನ ಎಸ್ತೇರ್‌ನ ಧರಮ್ ದಿದೋನಿ. <verse eid="EST 8:7" /><verse number="8" style="v" sid="EST 8:8" />ಕತೋಬಿ ರಾಜ಼ನ ನಾಮ್‌ಪರ್ ಲೀಖಾಯುತೆ ಅಜು಼ ರಾಜ಼ನೊ ಮುದ್ರೊ ನಖಾಯುಹುಯು ಲೀಖ್ಯಾನ ಕೋಣ್‌ಬಿ ವಜಾಕರಾನ ಹುವಾಕೊಯ್ನಿ. ಇನಾಖ್ಹಾಜೆ ಯೆಹೂದ್ಯವಾಳನಿ ಬಾರೇಮ ತುಮುನ ಕಿಮ್ ಬರೋಬರ್‌ ದೆಖಾವಸ್ಕಿ ಇಮ್ ರಾಜ಼ನ ನಾಮ್‌ಪರ್‌ ತುಮೇಬಿ ಚಿಟ್ಟಿ ಲೀಖಾವೊ. ಇನಾಪರ್ ರಾಜ಼ನೋ ಮುದ್ರೊ ನಾಖೊ.” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EST 8:8" /><verse number="9" style="v" sid="EST 8:9" />ತದೆ ರಾಜ಼ನು ಲೀಖಾಪಟ್‌ವಾಳನ ಬುಲೈಮಂಗಾಯು. ಅವ್ಣೆ ತೀನ್ನೊ ಮಹಿನೊಹುಯಿರೋತೆ ಜೇಷ್ಠ ಮಹಿನಾನೊ ತೀನ್ ಉಪ್ರೀಖ್ಹ್‌ನ ದನ್‌ಮ ಆಯಿನ್ ಮೊರ್ದೆಕೈನಿ ಹುಕುಮ್‌ನಿ ಘೋಣಿ, ಯೆಹೂದ್ಯವಾಳನಾಬಿ ಭಾರತಥು ಧರೀನ್ ಕೂಷ್‌ಲಗೂಬಿ ಫೈಲೈರ‍್ಹೂತೆ ಏಕ್‌ಖ್ಹೊ ಖ್ಹಾತ್ಉಪ್ರೀಖ್ಹ್‌ ತಬರ್‌ಖಾನು ರಾಜ್ಯಪಾಲವ್‌ನಾಬಿ, ದೇಖ್ಹ್‌ನ ಅಧಿಪತಿಯೇನಾಬಿ, ಅದಿಕಾರಿಯೇನಾಬಿ, ಯೋಯೋ ತಬರ್‌ಖಾವ್ನು ಲೀಖ್ಯಾವ್‌ಮಾಬಿ, ಯೋಯೋ ಜ಼ಗ್‌ಜಾ಼ತ್‌ನು ಬೋಲಿಮಾಬಿ, ಚಿಟ್ಟಿಯೇ ಲೀಖ್ಯು. <verse eid="EST 8:9" /><verse number="10" style="v" sid="EST 8:10" />ರಾಜ಼ನ ನಾಮ್‌ಪರ್ ಲೀಖಾಯೂತೆ ಆ ಚಿಟ್ಟಿಯೆವ್‌ನ ಮೊರ್ದೆಕೈನೆ ರಾಜ಼ನೊ ಮುದ್ರೊನಾಖಿನ್, ಮಹೇಲ್‌ನು ಘೋಡಾನಿ ಕೊಟ್‌ಗೆಮ ಪೈದಹುಯಿನ್ ಪಳ್ಯಾತೆ ಘೋಡವ್‌ಪರ್ ಬೇಶಿನ್ ನಿಕ್‌ಳ್ಯಾತೆ ಚಿಟ್ಟಿದ್ಯಾವಾಳವ್‌ನ ಹಾತ್‌ಮ ದೀಮೋಕ್‌ಲ್ಯೊ <verse eid="EST 8:10" /><verse number="11" style="v" sid="EST 8:11" />ರಾಜಾ಼ನೆ ಖಾನೂಲ್‌ ಅಮ್‌ ಲೀಖೈರಾಖ್ಯೋತೊಕಿ ಹರೇಕ್‌ ಖ್ಹಯೇರ್‌ಮಾಬಿ ಯೆಹೂದ್ಯರ್‌ನ ಎಕ್ಟುಕರಾನುಬಿ ಬಚೈ಼ಲ್ಯಾವನಿ ಹಕ್‌ನಾಬಿ ದಿದೊ ಖೆವ ಮುಲಕ್‌ಮಾಬಿ ಪರ್ಖ್ಹಾವ್ನ ನಾಶ್‌ಕರಾನಬಿ ಮಾರಿನಾಖನಾಬಿ ಅಜು಼ ಇವ್ಣಿ ತಯೇಡಾವ್ನ, ಲಡ್ಕಾವ್ನ ಮಾರೆಜಾ಼ಯ್‌ ಅಜು಼ ಇವ್ಣ ವಹೇರ‍್ಯಾನು ಶೊತ್‌ನ ಲೂಟಿಕರೆಜಾ಼ಯ್‌. <verse eid="EST 8:11" /><verse number="12" style="v" sid="EST 8:12" />ಆ ರಾಜ಼ನಿ ತೀರ್ಪ್‌ ಪರ್ಷಿಯ ದೇಖ್ಹ್‌ನು ಯಹೂದಿವಾಳು ಖ್ಹತಾಪ್ಣಿಪಡ್ಯುತೆ ದನ್‌ಥು ಧರೀನ್ ಭಾರನೆ ಮಹಿನೊಹುಯಿರ‍್ಹೊತೆ ಆಧಾರ್‌ನು ಥೇರಾನ ದನ್‌ಮ ಚ಼ಲಾವ್ಣಿಲಾವ್ಣುಥು <verse eid="EST 8:12" /><verse number="13" style="v" sid="EST 8:13" />ಯೊ ದನ್‌ಮ ಯೆಹೂದ್ಯವಾಳು ಇವ್ಣ ವಹೇರ‍್ಯಾವ್‌ಪರ್ ದಾವ್‌ಕಾಡಾನ ತಯಾರ್ ಹುಯಿರ‍್ಹೇವ್ಣು” ಕರಿ ಹುಕುಮ್ ಕರ‍್ಯೊ. ಅಜು಼ ಹರೇಕ್‌ ತಬರ್‌ಖಾಮ ಇನ ಮಾಲುಮ್‌ಕರಾವ್ಣು. <verse eid="EST 8:13" /><verse number="14" style="v" sid="EST 8:14" />ರಾಜ಼ನಿ ಆ ಹುಕುಮ್ ಶೂಷನ್ ನಂಗರ್‌ಮ ಭಡ್ಕಾವನಿವಖ್ಹ್‌ತೆ ಇನೇಥಿ ಹುಮ್ಮಖ್ಹ್‌ ಲಿದುತೆ ಚಿಟ್ಟಿದ್ಯಾವಾಳು ಮಹೇಲ್‌ನು ಸವಾರಿನ ಘೋಡವ್‌ಪರ್ ಬೇಶಿನ್ ಘಣು ತುರಂಥಿ ನಿಕ್‌ಳ್ಯು. <verse eid="EST 8:14" /><verse number="15" style="v" sid="EST 8:15" />ಮೊರ್ದೆಕೈತೊ ನೀಲು ಅಜು಼ ಧೋಳುಫಟ್ ರಾಜ಼ನು ಝ಼ಗ್ಗೊ ಫೇರಿಲೀನ್, ಖ್ಹೊನ್ನಾನು ಮೋಟಿ ಕಿರೀಟ್‌ನ ಘಾಲಿಲೀನ್, ಲಲೇಲಾಲ್‌ರಂಗ್‌ನು ಧಾಗಾನ ಝ಼ಗ್ಗಾನ ಹೋಡಿಲೀನ್ ರಾಜ಼ಕಂಥೊ ನಿಕ್‌ಳ್ಯೊ. ಶೂಷನ್ ಖ್ಹಯೇರ್‌ಮ ಖ್ಹುಶೀನ ಪೋಭಾರ ಹುಯು. <verse eid="EST 8:15" /><verse number="16" style="v" sid="EST 8:16" />ಹಿಜ್ಜಾ಼ನು ಯೆಹೂದ್ಯವಾಳು ಶಂತೋಖ್ಹ್‌ ಅಜು಼ ಛುಟ್ಕಾರ್‌ನು ಜೀತ್‌ನಿ ಖ್ಹುಶಿಮ ಭರಾಯು. <verse eid="EST 8:16" /><verse number="17" style="v" sid="EST 8:17" />ರಾಜ಼ನು ತೀರ್ಮಾನ್ ಭಡ್‌ಕ್ಯುತೆ ತಬರ್ಖಾವ್‌ಮಾಬಿ, ಖ್ಹಯೇರ್‌ಮಾಬಿ ಜಿವ್ಣು ಕರುಕರ್ತುಥೂತೆ ಯೆಹೂದ್ಯವಾಳ ಖ್ಹಾರಸ್ನ ಅಛ್ಛೊ಼ ದನ್ ಹುಯೊ; ಇವ್ಣೆ ಇನ ಖ್ಹುಶೀನೊ ಅಜು಼ ಶಂತೋಖ್ಹ್‌ನೊ ದನ್‌ಕರಿ ಮನಾಯು. ಅದ್ಮೇವ್‌ಮ ಕೈಯೇಕ್‌ಜ಼ಣು ಯೆಹೂದ್ಯವಾಳಥಿ ಡರೀನ್ ಇವ್ಣಿ ಜಾ಼ತ್‌ಮ ಮಳಿಗಯು.<verse eid="EST 8:17" /></para>
  <chapter eid="EST 8" />
  <chapter number="9" style="c" sid="EST 9" />
  <para style="s">ಯೆಹೂದ್ಯವಾಳಥಿ ವಹೇರ‍್ಯಾವ್ನ ನಾಶ್‌ಕರ‍್ಯುತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 9:1" />ರಾಜ಼ನಿ ಹುಕುಮ್‌ನ, ತೀರ್ಮಾನ್ನ ಚ಼ಲಾವಖ್ಹರ್ಕೊ ದನ್ ಕತೊ, ಭಾರನೊ ಮಹಿನೊಹುಯಿರೋತೆ ಫಾಲ್ಗುಣ ಮಹಿನಾನು ಥೇರಾನೊ ದನ್ ಆಯೊ. ಯೊ ದನ್‌ಮ ಯೆಹೂದ್ಯವಾಳನ ಹಮೇಸ್ ಜೀತಿಲಿಯೇಜಾ಼ಯ್ ಕರಿ ಇವ್ಣು ವಹೇರ‍್ಯು ಟಿವೈರ‍್ಹೂಥು. ಕತೋಬಿ ಇನ ಬದಲ್ ಯೆಹೂದ್ಯವಾಳೂಸ್‌ ಇವ್ಣ ವಹೇರ‍್ಯಾವ್ನ ಜೀತಿಲಿದು. <verse eid="EST 9:1" /><verse number="2" style="v" sid="EST 9:2" />ಇನಖ್ಹಾಜೆ ರಾಜ಼ ಅಹಷ್ವೇರೋಷನು ತಮಾಮಸ್ ತಬರ್‌ಖಾನು ಹರೇಕ್ ಖ್ಹಯೇರ್‌ಮಥೂತೆ ಯೆಹೂದ್ಯವಾಳು ಇವ್ಣುನ ಕೇಡ್‌ ಕರಾವಾಳನ ವಿರೋದ್‌ಹುಯಿನ್ ಹಾತ್‌ಪಾಡಾನ ಎಕ್ಟುಹುಯು. ಖ್ಹಾರಸ್ನ ಇವ್ಣೊ ಡರ್‌ಥೋತೆ ಇನಖ್ಹಾಜೆ ಕೋಣ್‌ಬಿ ಇವ್ಣಖ್ಹಾಮ್ಣೆ ಭೀರ‍್ಹಾವಾನ ಕೋ ಹುಯುನಿ. <verse eid="EST 9:2" /><verse number="3" style="v" sid="EST 9:3" />ಆ ನಾಹುಯಿನ್‌ ಮಹೇಲ್‌ಮ ಮೊರ್ದೆಕೈನು ಅದಿಕಾರ್‌ನು ತಾಖತ್ ಭಡ್ತುಗಯೂತೆ ದೇಖಿನ್‌ ಇನಿ ಬಾರೇಮ ಖ್ಹಾರಸ್ ತಬರ್‌ಖಾಮಾಬಿ ಫೈಲಾಯು. <verse eid="EST 9:3" /><verse number="4" style="v" sid="EST 9:4" />ಇನಾಖ್ಹಾಜೆ ತಮಾಮಸ್ ತಬರ್‌ಖಾನು ಅದಿಕಾರಿಯೇಬಿ, ರಾಜ್ಯಪಾಲಖ್ಹಾರೂಬಿ, ದೇಖ್ಹ್‌ನ ಮೋಟವ್‌ಬಿ, ಅಜು಼ ಬಿಜು಼ಖ್ಹಾರು ರಾಜ಼ನು ಸೇವಕ್‌ರ‍್ಹವಾಳೂಬಿ ಇನ ಡರೀನ್ ಯೆಹೂದ್ಯವಾಳನಿ ಮದತ್‌ನ ಆಯು. <verse eid="EST 9:4" /><verse number="5" style="v" sid="EST 9:5" />ಅಮ್ ಯೆಹೂದ್ಯವಾಳು ಇವ್ಣ ಖ್ಹಾರಾಸ್ ವಹೇರ‍್ಯಾವ್ನ ಹರೈನ್, ತಲ್ವಾರ್‌ಥಿ ಕತ್ರಿ ಮಾರಿನ್, ಖತಮ್ ಕರ‍್ಯು; ಇವ್ಣ ವಹೇರ‍್ಯಾವ್ನ ಪಸಂದ್‌ಕಿಮ್ ಹುವಾಸ್ಕಿ ತಿಮ್ ಕರ‍್ಯು. <verse eid="EST 9:5" /><verse number="6" style="v" sid="EST 9:6" />ಯೆಹೂದ್ಯವಾಳು ಶೂಷನ್ ನಂಗರ್‌ಮಾಸ್‌ ಪಾಚ಼್‌ಖ್ಹೊ ಅದ್ಮೇವ್‌ನ ಮಾರಿನಾಖ್ಯು. <verse eid="EST 9:6" /><verse number="7" style="v" sid="EST 9:7" />ಮರಿಗಯೂತೆ ಇವ್ಣಾಮ ಪರ್ಷಂದಾತ, ದಲ್ಫೋನ್ ಅಜು಼ ಅಸ್ಫಾತ, <verse eid="EST 9:7" /><verse number="8" style="v" sid="EST 9:8" />ಪೋರಾತ, ಆದಲ್ಯ, ಅರೀದಾತ, <verse eid="EST 9:8" /><verse number="9" style="v" sid="EST 9:9" />ಪರ್ಮಷ್ಟ, ಅರೀಸೈ, ಅರಿದೈ ಅಜು಼ ವೈಜಾತ, ಕರಿ ನಾಮ್‌ವಾಳು ಖ್ಹಾರುಥು. <verse eid="EST 9:9" /><verse number="10" style="v" sid="EST 9:10" />ಅವ್ಣೆ ಯೆಹೂದ್ಯವಾಳನ ವಹೇರ್‌ ಕರುಕರ್ಥೋತೆ ಹಮ್ಮೆದಾತನೊ ಛಿಯ್ಯೊ ಹಾಮಾನನ ದಖ್ಹ್‌ಜ಼ಣ ಛಿಯ್ಯಾ. ಅತ್ರಜ಼ಣಾನ ಮರ್‌ನಾಖ್ಯೂತೋಬಿ ಯೆಹೂದ್ಯವಾಳನೆ ಲೂಟಿ ಕರ‍್ಯುಕೊಯ್ನಿ, <verse eid="EST 9:10" /><verse number="11" style="v" sid="EST 9:11" />ಯೊ ದನ್ ಶೂಷನ್ ನಂಗರ್‌ಮ ಕತ್‌ರೈಗಯೂತೆ ಇವ್ಣಿ ಗಣ್ತಿ ರಾಜ಼ನ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯು. <verse eid="EST 9:11" /><verse number="12" style="v" sid="EST 9:12" />ತದೆ ರಾಜ಼ನೆ ಎಸ್ತೇರ್‌ ರಾಣಿನ, “ಯೆಹೂದ್ಯವಾಳನೆ ಶೂಷನ್ ನಂಗರ್‌ಮಾಸ್‌ ಪಾಚ಼್‌ಖ್ಹೊ ಅದ್ಮಿನಾಬಿ, ಹಾಮಾನನ ದಖ್ಹ್‌ಜ಼ಣ ಲಡ್ಕಾವ್‍ನಾಬಿ ಮರ್‌ನಾಖಿದಿದು; ಅಜು಼ ಬಚ್ಯೂತೆ ರಾಜ಼ನ ತಬರ್‌ಖಾಮ ಕೆತ್ರೂಸ್‌ಕಿ ಅದ್ಮಿ ಕತ್‌ರೈಗಯು ಉಶೆ. ತಾರಿ ಬಿಂತಿ ಖಿವು? ಉಶೇತೋ ಚ಼ಲಾವುಸ್‌, ತೂ ಶಾತ್‌ ಬೋಲಿಲಿದಿತೋಬಿ ದೆವುಸ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EST 9:12" /><verse number="13" style="v" sid="EST 9:13" />ಇನ ಎಸ್ತೇರ್‌ನೆ, “ರಾಜ಼ನ ಪಸಂದ್‌ ಉಶೇತೊ, ಆಜ಼್‌ನಿತರ ಕಾಲ್‌ಬೀ ರಾಜನಿ ಹುಕುಮ್‌ನಿ ಘೋಣಿ ಕರಾನಬಿ ಹಾಮಾನನ ದಖ್ಹ್‌ಜ಼ಣ ಛಿಯ್ಯಾವ್‌ನು ಮುರ್ದಾವ್‌ನಾಬಿ ಗಳ್‌ಫಾಶಿಪರ್ ಠಂಗಾವನ ಶೂಷನ್‌ಮ ಛಾ಼ತೆ ಯೆಹೂದ್ಯವಾಳನ ಹುಕುಮ್ ಹೋಣು” ಕರಿ ಗಿಂಗೈಲಿದಿ. <verse eid="EST 9:13" /><verse number="14" style="v" sid="EST 9:14" />ತದೆ ರಾಜ಼ನೆ ಇಮ್ಮಸ್ ಹುಕುಮ್‌ದಿದೊ. ತದ್ನುತದೇಸ್ ಆ ಬಾರೇಮಾನು ರಾಜ಼ನಿ ಹುಕುಮ್‌ ಶೂಷನ್ ನಂಗರ್‌ಮ ಮಾಲುಮ್‌ಪಡ್ಯು. ಅಜು಼ ಹಾಮಾನನ ದಖ್ಹ್‌ಜ಼ಣ ಛಿಯ್ಯಾವ್‌ನು ಮುರ್ದಾವ್ನ ಗಳ್‌ಫಾಶಿಪರ್ ಠಂಗಾಯು. <verse eid="EST 9:14" /><verse number="15" style="v" sid="EST 9:15" />ಶೂಷನ್ನು ಯೆಹೂದ್ಯವಾಳು ನಿಸಾನ್ ಮಹಿನಾನು ಚ಼ೌಧಾನ ದನ್‌ಮಾಬಿ ಎಕ್ಟುಹುಯಿನ್ ಹಿಜ್ಜಾ಼ನು ತೀನ್‌ಖ್ಹೊ ಅದ್ಮಿನ ಮಾರ‍್ಯು; ಕತೋಬಿ ಪಾಛು಼ ಲೂಟಿ ಕೊಕರ‍್ಯುನಿ. <verse eid="EST 9:15" /><verse number="16" style="v" sid="EST 9:16" />ಇಮ್ಮಸ್ ಬಿಜ಼ ರಾಜ಼ನ ತಬರ್‌ಖವ್‌ಮಾಬಿ ಯೆಹೂದ್ಯವಾಳು ಇವ್ಣ ವಹೇರ‍್ಯಾವ್‌ನು ಕಾಟದ್ಯವಾನು ಮ್ಹೇಲಿನ್, ಇವ್ಣೊ ಜಾನ್‌ ಬಚಾ಼ಡಿಲ್ಯವಾನ ಖ್ಹಾಜೆ ಎಕ್ಟುಹುಯಿನ್‌ ಆಯಿನ್‌ ಇವ್ಣ ವಹೇರ‍್ಯಾವ್‌ಮ ಪಾಚ಼್‌ಉಪ್ಪರ್ ಖ್ಹಡ್‌ತೀನಿಖ್ಹ್ ಹಜಾ಼ರ್‌ ಅದ್ಮೇವ್‌ನ ಮರ್‌ನಾಖಿದಿದು; ಕತೋಬಿ, ಲೂಟಿ ಕರ‍್ಯುಕೊಯ್ನಿ. <verse eid="EST 9:16" /><verse number="17" style="v" sid="EST 9:17" />ಆ ನಿಸಾನ್ ಮಹಿನಾನು ಥೇರಾನ ದನ್‌ಮ ಚಾ಼ಲ್ಯು. ಇವ್ಣೆ ಚ಼ೌಧಾನ ದನ್‌ಮ ಅರಾಮ್‌ಕರೀನ್ ಯೊ ದನ್ನ ಖ್ಹುಶಿನ ಪೋಭಾರನೊ ದನ್‌ಕರಿ ಮನಾಯು. <verse eid="EST 9:17" /><verse number="18" style="v" sid="EST 9:18" />ಶೂಷನ್ನು ಯೆಹೂದ್ಯವಾಳು ಥೇರಾನೊ ದನ್ ಅಜು಼ ಚೌ಼ಧಾನೊ ದನ್ ಎಕ್ಟುಹುಯಿನ್‌ ಆಯುತೆ ಇನಾಖ್ಹಾಜೆ, ಇವ್ಣೆ ಪಂಧ್ರಾನ ದನ್‌ಮ ಅರಾಮ್ ಕರಿಲಿದು. ಯೊ ರೋಜ಼್‌ ಖ್ಹುಶಿನೊ ಪೋಭಾರನೊ ದನ್‌ಕರಿ ಮನಾಯು. <verse eid="EST 9:18" /><verse number="19" style="v" sid="EST 9:19" />ಅನಖ್ಹಾಜೆ ಬಲ್ಡಾನ ತಬರ್‌ಖಾನು ನಂಗರ್‌ಮ ರ‍್ಹಾವಾಳು ಯೆಹೂದ್ಯವಾಳು ನಿಸಾನ್ನು ಚೌ಼ಧಾನ ದನ್ನ ಅಛ್ಛೊ಼ದನ್‌ಕರೀಬಿ ಖ್ಹಯೇರ್‌ಮ ರ‍್ಹಾವಾಳು ಪಂಧ್ರಾನ ದನ್ನ ಅಛ್ಛೊ಼ದನ್‌ಕರೀಬಿ ಮನೈನ್, ಖ್ಹುಶಿನ ಇರಂದೀನ ಪಿಕೈನ್‌ ಖೈನ್, ಅಜು಼ ಏಕ್‌ಥಿ ಇನಾಮ್ನ ವಾಟ ಪಾಡಿಲಿದು.<verse eid="EST 9:19" /></para>
  <para style="s">ಪೂರೀಮ್‌ ಪೂಜ಼</para>
  <para style="p">
    <verse number="20" style="v" sid="EST 9:20" />ಮೊರ್ದೆಕೈನೆ ಖನ್ನೇಬಿ ದೂರ್‌ಬಿ ಥೂತೆ ಅಹಷ್ವೇರೋಷನು ಖ್ಹಾರೂಸ್ ತಬರ್‌ಖಾನು ಯೆಹೂದ್ಯವಾಳನ ಚಿಟ್ಟಿಯೇಥಿ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೂತೆ ವಾತೆಖ್ಹಾರಿ ಲೀಖ್ಯೊ: <verse eid="EST 9:20" /><verse number="21" style="v" sid="EST 9:21" />ಹರೇಕ್ ವರಖ್ಹ್‌ಬಿ ನಿಸಾನ್ ಮಹಿನಾನು ಚೌ಼ಧಾನೊ ದನ್ ಅಜು಼ ಪಂಧ್ರಾನೊ ದನ್ನಾ ಪೂಜ಼ನೊ ದನ್ ಕರಿ ಮನಾವನು ಹಮೇಶಾನು ಖಾನೂಲ್‌ ಕರಿ ಗಣ್ತಿಕರ್‌ನು. <verse eid="EST 9:21" /><verse number="22" style="v" sid="EST 9:22" />ಯೊ ದನ್‌ಮ ಯೆಹೂದ್ಯವಾಳನ ವಹೇರ‍್ಯಾವ್‌ನು ಚ಼ಪ್ಪಣ್ ಮಾಥು ಛು಼ಟೀನ್ ಅರಾಮ್‌ಹುಯು. ಯೊ ಮಹಿನಾಮ ಪಶ್ತಾವ್ಣಿ ಜೈ಼ನ್ ಇವ್ಣುನ ಖ್ಹುಶಿಹುಯು; ದುಖ್ ಜೈ಼ನ್ ಖ್ಹುಕ್‌ನ ದನ್ ಆಯು. ಇನಾಖ್ಹಾಜೆ ಇವ್ಣೆ ಯೊ ದನ್‌ಮ ಪೂಜ಼ನು ಖಾಣು ಪಿಕೈನ್ ಏಕ್‌ಥಿಏಕ್ ಖಾಣಾನ ಚೀಜ಼್‌ನು ಇನಾಮ್‌ ದೇತುಥು. <verse eid="EST 9:22" /><verse number="23" style="v" sid="EST 9:23" />ಇಮ್ಮಸ್ ಯೆಹೂದ್ಯವಾಳು ಮೊರ್ದೆಕೈನು ಚಿಟ್ಟಿಮ ಲೀಖೈರ‍್ಹುತೆ ಪರಕ್ಮಾಸ್ ಚ಼ಲಾಯು. ಯೊ ವರಖ್ಹ್‌ ಚಾ಼ಲೀತೆ ಪೂಜ಼ ಇವ್ಣಾಮ ವರಖ್ಹ್‌ನಿ ಪೂಜ಼ಕರಿ ಮನಾವ್ಣು ಕರಿ ತೀರ್ಮಾನ್ ಕರಿಲಿದು.<verse eid="EST 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EST 9:24" />ಖ್ಹಾರಸ್ ಯೆಹೂದ್ಯವಾಳನ ವಹೇರ್‌ ಕರ್ತೊಥೋತೆ ಆಗಾಗನಿ ಪಿಳ್ಗಿವಾಳೊಬಿ ಹಮ್ಮೆದಾತನೊ ಛಿಯ್ಯೊಬಿ ಹುಯಿರೋತೆ ಹಾಮಾನನೆ ಯೆಹೂದ್ಯವಾಳನ ಮರ್‌ನಾಕ್ಣುಕರಿ ಹೂಡ್‌ ಕರಿಲೀನ್ ಇವ್ಣುನ ಕಲಾವ್ಣಿಕರೀನ್‌ ನಾಶಕರಾನಿ ಬಾರೇಮ “ಪೂರ್”ನ ಕತೊ ಚೀಟ್‌ನ ನಾಖ್ಯೋಥೊ. <verse eid="EST 9:24" /><verse number="25" style="v" sid="EST 9:25" />ಆ ವಾತ್ ರಾಜ಼ನ ಕಾನ್‌ಮ ಪಡಾಮ ಇನೆ, “ಹಾಮಾನನೆ ಯೆಹೂದ್ಯವಾಳನ ವಿರೋದ್ ಸೋಚ್ಯೋತೆ ಕೇಡ್ ಇನ ಮುಡ್‌ಕ್ಯಾಪರಸ್‌ ಆವಾದೆ. ಇನಾಬಿ ಇನ ಲಡ್ಕಾವ್‍ನಾಬಿ ಗಳ್‌ಫಾಶಿದೆವೊ” ಕರಿ ಚಿಟ್ಟಿಥಿ ಹುಕುಮ್ ಕರಿರಾಖ್ಯೋಥೊ. <verse eid="EST 9:25" /><verse number="26" style="v" sid="EST 9:26" />ಯೊ “ಪೂರ್” ಕರಿ ಲೀಖ್ಯಾನಿ ಆಧಾರ್‌ಪರ್ ಯೊ ದನ್ನ “ಪೂರೀಮ್‌” ಕರಿ ನಾಮ್‌ಆಯು. ಮೋರ್ದಕೈನ ಚಿಟ್ಟಿನ ಕಾಮ್‌ಥಿ ಇವ್ಣುನ ಹುಯೂತೆ ಇನಾಬಿ <verse eid="EST 9:26" /><verse number="27" style="v" sid="EST 9:27" />ಯೆಹೂದ್ಯವಾಳು ಯೊ ಚಿಟ್ಟಿನಿ ವಾತೆವ್‌ನಾಬಿ ಯೊ ಅಖ್ಖಾನಿ ಬಾರೇಮ ಇವ್ಣೇಸ್ ಖ್ಹಮಾಳ್ಯುತೇಬಿ, ಇವ್ಣುನ ಹುಯುತೇಬಿ ಯಾದ್‌ಕರಿಲೀನ್, ಹರೇಕ್ ವರಖ್ಹ್‌ಬಿ ಯೊ ಬೇ ದನ್ನಾ ಖ್ಹಾರೂಸ್ ಖಾನ್‌ಖೋಜ಼್‌, <verse eid="EST 9:27" /><verse number="28" style="v" sid="EST 9:28" />ಹರೇಕ್‌ ಮುಲಕ್‌, ಹರೇಕ್‌ ನಂಗರ್‌, ಹರೇಕ್‌ ಅಗ್ಲಿ ಪಿಳಿಗಿವಾಳನ, ಹರೇಕ್ ಕುಟುಂಬ್‌ವಾಳನ ಆ ಪೂರೀಮ್‌ ಪೂಜ಼ ಯೆಹೂದ್ಯರ್‌ಮ ಕೆದೇಬಿ ನಾಭೀರೇವ್ಣುಕರಿ ತೀರ್ಮಾನ್‌ಕರ‍್ಯು. <verse eid="EST 9:28" /><verse number="29" style="v" sid="EST 9:29" />ಆನಾಹುಯಿನ್ ಅಬೀಹೈಲನಿ ಛೋ಼ರಿ ಎಸ್ತೇರ್‌ರಾಣಿನೆ ಪೂರೀಮ್‌ ಪೂಜಾ಼ನ ಚ಼ಲಾವನಿ ಬಾರೇಮಾನು ಯೊ ಬೇನು ಖಾನುಲ್‌ನ ಖಾಯಮ್‌ ಕರಾನಖ್ಹಾಜೆ ಮೊರ್ದೆಕೈನು ಮದತ್‌ಲೀನ್‌ ಚಿಟ್ಟಿಯೇನ ಲೀಖಿ. <verse eid="EST 9:29" /><verse number="30" style="v" sid="EST 9:30" />ಮೊರ್ದೆಕೈನೆ, ಅಹಷ್ವೇರೋಷನು ರಾಜ್ಯನು ಏಕ್‌ಖ್ಹೊ ಖ್ಹಾತ್‌ಉಪ್ರೀಖ್ಹ್‌ ತಬರ್‌ಖಾವ್‌ಮ ಜಿವ್ಣುಕರುಕರಾತೆ ಖ್ಹಾರಸ್ ಯೆಹೂದ್ಯವಾಳನಿ ರಕ್ಷಣೆ ಅಜು಼ ಶಾಂತಿನಖ್ಹಾಜೆ ಯೊ ಚಿಟ್ಟಿಯೇ ಮೋಕ್‌ಲ್ಯೊ. <verse eid="EST 9:30" /><verse number="31" style="v" sid="EST 9:31" />ದಯೆ ಅಜು಼ ಖ್ಹಾಚಿ ವಾತೇವ್‌ಥಿ ಯೊ ಚಿಟ್ಟಿಯೇಮ, “ಯೆಹೂದ್ಯವಾಳು ಇವ್ಣಾಮಾಬಿ ಅಜು಼ ಇವ್ಣಿ ಪಿಳ್ಗಿವಾಳಮಾಬಿ ಉಪವಾಸ್, ಅಜು಼ ಕಲ್‌ಕಲಾಟ್‌ನ ದನ್ನ ಯಾದ್ ಕರಿಲ್ಯವಾನಖ್ಹಾಜೆ ಇವ್ಣೇಸ್ ಮಾಲುಮ್ ಕರಿಲಿದುಥುತೆ ಪರಕ್ಮ ಆ ಪೂರೀಮ್‌ ದನುನ, ಇನು ಅಜು಼ ಯೆಹೂದ್ಯವಾಳೊ ಮೊರ್ದೆಕೈನು ಹುಕುಮ್‌ನಿಘೋಣಿ ಹರೇಕ್ ವರಖ್ಹ್‌ಬಿ ಮಾಲುಮ್ ಹುಯಿರ‍್ಹುತೆ ಹಗಾಮ್ಮ ಮ್ಹೇಲ್‌ನುನಾತೆ ಮನಾವ್ಣು.” ಕರಿ ರಾಣಿನೆ ಲೀಖಿರಾಖಿಥಿ. <verse eid="EST 9:31" /><verse number="32" style="v" sid="EST 9:32" />ಎಸ್ತೇರ್‌ನು ಯೊ ಹುಕುಮ್‌ನಿ ಚಿಟ್ಟಿ ಪೂರೀಮ್‌ ಪೂಜಾ಼ನ ಚ಼ಲಾಯು ಅಜು಼ ಯೊ, ದಪ್ತರ್‌ಮಾಬಿ ಲೀಖಾಯು.<verse eid="EST 9:32" /></para>
  <chapter eid="EST 9" />
  <chapter number="10" style="c" sid="EST 10" />
  <para style="s">ಅಹಷ್ವೇರೋಷ ಅಜು಼ ಮೊರ್ದೆಕೈನಿ ಖ್ಹರಾವ್ಣಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 10:1" />ರಾಜ಼ ಅಹಷ್ವೇರೋಷನೆ ಇನ ರಾಜ್ಯನ ಮಳ್ಯುಹುಯು ಖ್ಹಾರಸ್‌ ದೇಖ್ಹ್‌ಪರ್‌ಬಿ ದರ‍್ಯಾವ್ನ ಟಾಪಪರ್‌ಬಿ ಶುಂಕ ನಾಖ್ಯೊ. <verse eid="EST 10:1" /><verse number="2" style="v" sid="EST 10:2" />ಇನು ಶಕತ್ ತಾಖತ್‌ನು ಕಾಮ್‌ಖ್ಹಾರು ಅಜು಼ ರಾಜ಼ನೆ ಮೊರ್ದೆಕೈನ ಘಣಿ ಮರ‍್ಯಾದಿನಿ ಛ಼ಡಾಯೋತೆ ಬಾರೇಮಾನು ಪೂರ ಲೀಖಾಪಟ್‌ ಮೇದ್ಯ ಅಜು಼ ಪರ್ಷಿಯ ದೇಖ್ಹ್‌ನ ರಾಜ಼ವ್‌ನು ಜ಼ಮಾನನು ದಪ್ತರ್‌ಮ ಲೀಖೈರ‍್ಹುಸ್. <verse eid="EST 10:2" /><verse number="3" style="v" sid="EST 10:3" />ಯೆಹೂದ್ಯವಾಳೊ ಮೊರ್ದೆಕೈತೋಬಿ ರಾಜ಼ ಅಹಷ್ವೇರೋಷನು ಬೇನು ಝ಼ಗೋವಾಳೋಬಿ ಯೆಹೂದ್ಯವಾಳಾಮ ಮರ‍್ಯಾದಿವಾಳೊಬಿ ಇನ ಮಾಯಮಾತ್ರಾಮ ಲಾಡ್‌ಪ್ಯಾರ್‌ವಾಳೋಬಿ ಶೊಂತ್ ಅದ್ಮೇವ್‌ನಖ್ಹಾಜೆ ವೇಚ಼್‌ಣೆ ಕರಾವಾಳೋಬಿ ಶೊಂತ್‌ ಖೂಮ್‌ವಾಳ ಖ್ಹಾರಾಸ್ನ ಶಾಂತಿದೂತಾಬಿ ಹುಯಿರೋಥೊ.<verse eid="EST 10:3" /></para>
  <chapter eid="EST 10" />
</usx>