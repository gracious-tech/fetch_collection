<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Waghari Old Testment</book>
  <para style="h">ಓಬದ್ಯ</para>
  <para style="toc3">ಓಬದ್ಯ</para>
  <para style="toc2">ಓಬದ್ಯ</para>
  <para style="toc1">ಓಬದ್ಯ</para>
  <para style="mt2">ಪ್ರವಾದಿಹುಯಿರೊತೆ ಓಬದ್ಯನು ಗ್ರಂಥ್</para>
  <para style="mt1">ಓಬದ್ಯ</para>
  <para style="imt">ಓಬದ್ಯನು ಪರಿಚಯಂ</para>
  <para style="ip">ಅ ಗ್ರಂಥ್ ಓಬದ್ಯನು ಭವಿಷ್ಯವಾಣಿನ ಮ್ಹೈಚಾ. ಓಬದ್ಯನಿ ವಾತೆ ಏಸಾವ್‍ನು ವಂಶಂವಳು ಹುಯಿರುತೆ ಎದೋಮ್ ನು ಅದ್ಮಿನು ವಿರುದಂನು ತಿರ್ಪುನ ಬೊಲೈರುಸ್. ಓಬದ್ಯನು ಗ್ರಂಥ್ ಕೆದೆ ಲಿಕೈರುಸ್ ಕರಿ ಜ್ಞಾನಂವಳವ್‍ನಬಿ ಮಲಂ ಕೊಯ್ನಿ. ಅ ತಿರ್ಪು ಬಾಬಿಲೋನ್ ಜೆರುಸಲೆಮ್ ನ ಕೊಂಡಿರಕ್ಯುಸ್ತೆ ವಖ್ಹತ್ ನ ವೊತಳನು ಹುಯಿರುಸ್ ಬುಜು ಎದೋಮ್ ಇಸ್ರಾಯೇಲ್ ನ ಮದತ್ ಕೊ ಕರ್ಯುನಿ. ಅ ಖ್ಹಚ್ಚಉಶೆತೊ, ಯೊ ಕ್ರಿ.ಪೂ ಛೊ಼ಖ್ಹೊ಼ ಮ ಲಿಕೈರ‍್ಹವಜೈ.</para>
  <para style="ip">ಓಬದ್ಯತೊಬಿ ಪಹಿಲೆ ಎದೋಮ್‍ನು ವಿರುದಂ ಮಾತ್ರಮಸ್ ತಿರ್ಪು ದೇಸ್, ರೈತೊಬಿ ಬಾದ್‌ಮ 15 ನು ವಚನ್ ಮ ಅ ತಿರ್ಪುಮ ಅಕ್ಕಸ್ ದೇಖ್ಹ್ ನ ಮಳೈರಕ್ಯುಸ್. ಫಛಳ್‍ತು, ಎಕ್ ದನ್ನೆ ಇಸ್ರಾಯೇಲ್ ನು ಬಂದಿಕರವಳು ಆಳ್‍ಖ್ಹರು ಫಚು಼ಪರಿನ್ ಇವ್ಣು ಜಮಿನ್‍ ಪಚ್ಹು ಲಿಲಿಶೆ ಕರಿ ಓಬದ್ಯನೆ ಬೊಲಸ್.</para>
  <para style="iot">ಓಬದ್ಯನು ಮ್ಹೈನು ಭಗ್</para>
  <para style="io1">1. ಅಧ್ಯಾಯ <char style="ior"><ref loc="OBA 1:1-14">1:1-14</ref> </char> ಅ ವಚನಂಮ ಎದೋಮ್‍ನ ಉಪ್ಪರ್ ತಿರ್ಪು ಬೊಲವಸ್ತೆ.</para>
  <para style="io1">2. ಅಧ್ಯಾಯ <char style="ior"><ref loc="OBA 1:15-21">1:15-21</ref> </char> ಅ ವಚನಂಮ ಅಕ್ಕು ದೇಖ್ಹ್ ಖ್ಹರು ಇವ್ಣು ಘಯೆರ್ ಕಿಮ್ ಬೊಲೈಜಶೆ ಬುಜು ಬಂದಿಕರವಳು ಆಳ್‍ ಇಸ್ರಾಯೇಲ್‍ವಳು ಪಚ್ಹು ಪರಿನ್‍ ಇವ್ಣು ಜಮಿನ್‍ ನ ಇವ್ಣುಕರಿಲಿಶೆ, ಎದೋಮ್ ದೇಖ್ಹ್ ನಬಿ ಆಳ್‍ಶೆ ಕರಿ ಬೊಲಸ್.</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />ಓಬದ್ಯ ದೇಖ್ಯೊತೆ ದೇವ್ ನು ಖ್ಹೊಣ್ಯು, ಎದೋಮ್ ದೇಖ್ಹ್ ನು ಬಾರೇಮ ಯೆಹೋವ ಅಮ್ ಬೊಲುಕರಸ್:</para>
  <para style="s" vid="OBA 1:1">ದೆವ್ ಎದೋಮ್ ನ ಶಿಕ್ಷಿನ ದೆಸ್‍ತೆ</para>
  <para style="q1" vid="OBA 1:1">“ಭ್ಹಾರ್‌ ಜಾವೊ, ಎದೋಮ್‌ನ ಉಪ್ಪರ್ ಯುದ್ಧಂಕರನ ಖ್ಹಮೆಜಯೇ”</para>
  <para style="q2" vid="OBA 1:1">ಅಮ್ ಕರಿ ಇನ ದೂತರ್ ನ ಮುಲಕ</para>
  <para style="q2" vid="OBA 1:1">ಯೆಹೋವನು ಖ್ಹಾರುರಾಜ್ಯಂನ ಬೊಲಿಮೊಕಲ್ ರಕ್ಯೊಸ್.</para>
  <para style="q2" vid="OBA 1:1">ಎವ್ಣೆತೆ ಅಯುತೆ ಆ ಸಮಚರಂಖ್ಹಾರು ಹಮೇ ಖ್ಹಂಜ್ಯ.<verse eid="OBA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />“ಎದೋಮ್, ಹಂದೆಕ್, ಖ್ಹಾರು ದೇಖ್ಹ್ ಮ ತುನ ತೊಡು ಕರಿದಿಶ್.</para>
  <para style="q2" vid="OBA 1:2">ತೂ ಘಣು ಶರಂ ಮ ಗುರಿಹುಯಿಸ್.<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />ತಾರು ದುರಹಂಕಾರ್ ತುನ ವಂಚನೆ ಕರ್ಶೆ.”</para>
  <para style="q1" vid="OBA 1:3">ಉಪ್ಪರ್ ಲ್ಯು ಸ್ಥಾನಂ ಮ ವಾಸಮ್ ಹುಯಿರೊಸ್;</para>
  <para style="q2" vid="OBA 1:3">ಬಂಡನಿ ಪದರ್ ಮ ಜ಼ತನ್ ಛ್ಹು ಕರಿ;</para>
  <para style="q2" vid="OBA 1:3">ಮನ ಜಮೀನ್‌ಪರ್ ಉತರವಳು ಕೋಣ್?’ ಕರಿ ಬೊಲುಕರಸ್.<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />ಇನ ಯೆಹೋವ: “ತೂ ಖ್ಹಂಳಿವುಡಸ್ತೆ ಜ್ಹಗೊತೊಡಿ ವುಡ್ ತೊ</para>
  <para style="q2" vid="OBA 1:4">ರೈತೊಬಿ ಶುಕ್ಕರ್ ರ‍್ಹಾಸ್ತೆ ಜ್ಹಗೊಮ</para>
  <para style="q2" vid="OBA 1:4">ರೈತೊಬಿ ಇಜ್ಗೊಥುಬಿ ತುನ ಉತ್ರೈನಖಿದಿಶ್” ಕರಿ ಬೋಲಾಸ್.<verse eid="OBA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />ತುಮರಮ ಚೊಟ್ಟು ರ‍್ಹಾವೊ,</para>
  <para style="q2" vid="OBA 1:5">ರತ್ ನು ಚೊಟ್ಟು ರ‍್ಹಾವೊ ಅಯುತೊ</para>
  <para style="q2" vid="OBA 1:5">ಇವ್ಣೆ ಇವ್ಣನ ಹೊಣುತೆ ಎತ್ರನ ಖ್ಹೊತಿಲಿನ್ ಉಳುಜಸ್ತೆಖಾಯೆ ನಾ?<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />ರೈತೊಬಿ ಏಸಾವ್ ನು ಆಸ್ತಿಪಾಸ್ತಿ ಅಕ್ಕುಸ್ ಜ್ಹೊಟೈಲಿದು.<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />ಮಾರ ಖ್ಹಾರದೊಸ್ತ್ ತರ ಫಿಟೆ ಫಿಟೆ ಅಯೊ.</para>
  <para style="q2" vid="OBA 1:7">ತಾರು ಅಚ್ಚು ದೊಸ್ತ್ ತುನ ಠಗೈನ್ ಹರೈರಕ್ಯುಸ್.</para>
  <para style="q1" vid="OBA 1:7">ತರು ಖಾಣು ಖದುತೆ ಇವ್ಣೆಸ್</para>
  <para style="q2" vid="OBA 1:7">ಜ್ಞಾನಂ ಕೊಯಿನ್ತೆ ತುನ ಜಾಳ ಬಿಚೈರಕ್ಯುಸ್.<verse eid="OBA 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />ಯೆಹೋವ ಅಮ್ ಬೊಲುಕರಸ್:</para>
  <para style="q2" vid="OBA 1:8">“ಯೋ ದನ್ಮ ಎದೋಮ್ ನು ಜ್ಞಾನಿಖ್ಹರು</para>
  <para style="q2" vid="OBA 1:8">ಏಸಾವ್ ನು ಫಡ್ ಮ ಅಕ್ಕಲ್ ನು ಜಿನವರ್ ಖ್ಹರು ಮೇ ಮಠವಕೊಯಿನ್ತೇ ಮೆಂದಿಶ್ ನಾ?<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />ತೇಮಾನ್ ಮುಲಕ್, ತಾರು ಯುಧಂಕರವಾಳು ಡರಿಜಾಶೆ;</para>
  <para style="q2" vid="OBA 1:9">ಏಸಾವ್ ನು ಟಬರ್ಕಮ ಅಕ್ಕುಸ್ ನಾಶಂಹುಯಿಜಶೆ.<verse eid="OBA 1:9" /></para>
  <para style="s">ಎದೋಮ್ ನು ದ್ರೊಹಂ</para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />“ತಾರೊ ನ್ಹಾನೊ ಭ್ಹಯ್‍ಹುಯಿರೊತೆ ಯಕೋಬ್‍ ನು ವಿರೋದ್ ಖ್ಹು ಚಲಯುತೆ</para>
  <para style="q2" vid="OBA 1:10">ಹಿಮ್‍ಸೆನು ಕಮ್ ಖ್ಹು ತೂ ಶರಂ ಕಡವಾಳೊ ಹುಯಿಶ್.</para>
  <para style="q2" vid="OBA 1:10">ನಿತ್ಯನಾಶಂ ಹುಯಿಜಶೆ.<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />ತಾರೊ ನ್ಹಾನೊ ಭ್ಹಯ್‍ನು ಅಸ್ತಿನ ಚೊರಿ ಕರ್ಯುತೆ ದನ್ಮ</para>
  <para style="q2" vid="OBA 1:11">ತು ಅಲದನಿತರ ದೆಕ್ತೊ ಇಬ್ರ‍್ಯೊಥೊ.</para>
  <para style="q1" vid="OBA 1:11">ಅಲದ ದೆಖ್ಹ್ ವಾಳು ಇನು ಗಾಮ್ ನು ದರ್ವಜನ ಮ್ಹೈತುಅಯಿನ್</para>
  <para style="q2" vid="OBA 1:11">ಯೆರೂಸಲೇಮ್ ನು ಅಸ್ತಿನ ಚಿಟಿನಕ್ಯುತೆ ದನ್</para>
  <para style="q2" vid="OBA 1:11">ಥು ತೂಬಿ ಇವ್ಣಿನ್ ತರ ಛಾ.<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />ತಾರೊ ನ್ಹಾನೊ ಭ್ಹಯ್‍ನು ಖಾರಬ್ ದನ್ಮ,</para>
  <para style="q2" vid="OBA 1:12">ಇವ್ಣ ಕಷ್ಟಕಾಲಮ್ಮ ತೂ ಚುಕ್ಕೆ ದೆಕ್ ತೊ ನಾ ರ‍್ಹಾವನ್ ಥು.</para>
  <para style="q1" vid="OBA 1:12">ಯೆಹೂದ್ಯರ್‌ ನು ನಾಶಂ ನು ದನ್ಮ ಸಂತೋಷಂ ನಾ ಪಡನ್ ತು.</para>
  <para style="q2" vid="OBA 1:12">ಇವ್‌ಣ ಕಷ್ಟನು ಕಾಲಮ್ಮ ತು ಹಂಕಾರ್ ನಾ ಕರ್ನು ಥು.<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />ಮಾರು ಅದ್ಮಿನು ಕಷ್ಟನು ಕಲಮ್ಮ ತೂ ಇನು ಪುರ್ವ ಭಣಿನು ದರ್ವಜನ ಮ್ಹೈತು ನಾ ಜನು.</para>
  <para style="q2" vid="OBA 1:13">ಇನು ಅಸ್ತಿನ ತು ಹತ್ ನಾ ಘಲ್ನು ಥು.<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />ಛುಕೈಲಿನ್ ನಶಿವುಳಿಜತುತುತೆ ಇವ್ಣನ ಮರಕಿದೆವನಕಜೆ</para>
  <para style="q2" vid="OBA 1:14">ಎಕ್ಕಸ್ ವಟ್ ಪರ್ ನಾ ಹುಬಿರ‍್ಹವಂತು.</para>
  <para style="q1" vid="OBA 1:14">ಕಷ್ಟನು ಪರಸ್ಥಿತಿಮ ಛುಕೈರಕ್ಯುಸ್ತೆ</para>
  <para style="q2" vid="OBA 1:14">ಇವ್ಣಮ ಶತ್ರುನ ಹಾತ್‌ಮ ನಾ ಒಪ್ಪಿಸವಂತು.<verse eid="OBA 1:14" /></para>
  <para style="s">ಅ ದೇಖ್ಹ್ ನ ನ್ಯಾಯಂ ಕರ್ ಶೆ</para>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />“ಅಕ್ಕಸ್ ದೇಖ್ಹ್ ನ ಯೆಹೋವ ನೊ ದನ್ ಖನ್ನೆಅಯಿರುಸ್.</para>
  <para style="q2" vid="OBA 1:15">ತೂ ಕರ್ಯೊತೆಸ್ ತುನಾಬಿ ಉಶೆ.</para>
  <para style="q2" vid="OBA 1:15">ತಾರು ಖರಬ್ ಕಮ್ ಅಕ್ಕುಸ್ ತಾರ ಮುಡ್ಕ್ಯನ ಉಪ್ಪರ್ ಆವ್‌ಶೆ.<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />ಖ್ಹಾರ ಅದ್ಮಿ ಪವಿತ್ರಂನು ಫಡ್ ಉಪ್ಪರ್ ಮಾರು ದಂಡನೆನು ಕಡುಪಾಣಿ ಪಿರಕ್ಯಸ್.</para>
  <para style="q2" vid="OBA 1:16">ಇಮ್ಮಸ್ ಖ್ಹಾರು ದೇಖ್ಹ್ ಕಡುಪಾಣಿ ಪಿಶೆ.</para>
  <para style="q1" vid="OBA 1:16">ಹೋ, ಘಡಿ ಘಡಿ ಪಿನ್ ತೂರಾಡ್ ಶೆ.</para>
  <para style="q2" vid="OBA 1:16">ಅಂತ್ಯಮ್ಮ ಕೊಯ್ನಿತಿಮ್ ಹುಯಿಜಷೆ.<verse eid="OBA 1:16" /></para>
  <para style="s">ಇಸ್ರಾಯೇಲ್ ನು ಜಯಂ</para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />“ರೈತೊಬಿ ಚೀಯೋನ್ ಫಡ್ ನ ಉಪ್ಪರ್ ಛುಕಿಹುಯುವು ರ‍್ಹಾಶೆ.</para>
  <para style="q2" vid="OBA 1:17">ಯೋ ಪರಿಶುದಂ ಜಗೊ ಕರಿ ಬೊಲವ್ ಶೆ.</para>
  <para style="q1" vid="OBA 1:17">ಯಕೋಬ್‍ನಿ ಖಾನ್ ದಾನ್‌ ವಾಳು</para>
  <para style="q2" vid="OBA 1:17">ಇವ್ಣು ಸೊಂತ್ ಆಸ್ತಿನ ಪಛ್ಹು ಅನುಭವಂ ಕರ್ ಶೆ.<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />ಯಕೋಬ್ ನು ಖನ್ ದನ್ ವಳು ಅಗ್ ನಿ ತರ;</para>
  <para style="q2" vid="OBA 1:18">ಯೋಸೇಫ್ ನು ಖನ್ ದನ್ ವಳು ಜ್ವಾಲೆನಿತರ.</para>
  <para style="q1" vid="OBA 1:18">ಆ ಬೆ ಜೋಡ್ಮ ಮಳಿನ್ ಖ್ಹುಕ್ಕ ಘಖ್ಹ್ ನಿ ತರ ಛಾತೆ</para>
  <para style="q2" vid="OBA 1:18">ಏಸಾವ್ ನು ಖನ್ ದನ್ ನ ಧಗ್ ಧಗ್ ಕರಿ ಬಾಳಿನಕಿದಿಶೆ ದಿಶೆ.</para>
  <para style="q1" vid="OBA 1:18">ಏಸಾವ್ ನು ಹಾತ್‌ಮ ಕೋಣ್‌ಬಿ ಕೊ ಬಚ್ ಶೆನಿ.”</para>
  <para style="q2" vid="OBA 1:18">ಆ ಯೆಹೋವ ನು ವಾತ್.<verse eid="OBA 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />ತದೆ ದಕ್ಷಿಣ್ ವಳು ಏಸಾವ್ ನು ಫಡ್ ನ ಇವ್ಣ ಭಣಿ ಫರೈಲಿಶೆ.</para>
  <para style="q2" vid="OBA 1:19">ಪಶ್ಚಿಮ್ ನು ಅಲದು ಟಬರ್ಕೊವಳು ಫಿಲಿಷ್ಟಿಯವಳು ಎಫ್ರಾಯಿಮ್ ಬುಜು</para>
  <para style="q1" vid="OBA 1:19">ಸಮಾರ್ಯವಳವ್ನು ಜಮಿನ್ ನ ಇವ್ಣುಕರಿಲಿಶೆ.</para>
  <para style="q2" vid="OBA 1:19">ಬೆನ್ಯಾಮೀನ್ ಖಾಂದಾನ್‌ವಾಳ ಗಿಲ್ಯಾದ್‍ನ ಸೊಂತ್‍ ಕರಿಲಿಶೆ.<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />ಕೈದಿ ಹುಯಿರುಸ್ ತೆ ಇಸ್ರಾಯೇಲ್‌ ನು ಸಿಪಯಿಖ್ಹಾರು</para>
  <para style="q2" vid="OBA 1:20">ಕಾನಾನ್ ಮುಲುಕ್ ಥು ಚಾರೆಪತಿತೊಡಿ ಇವ್ಣುಕರಿಲಿಶೆ.</para>
  <para style="q1" vid="OBA 1:20">ಸೆಪಾರ ಕರಿ ಬೊಲಸ್ತೆ ಖ್ಹಯೆರ್ಮ ಕೈದಿ ಹುಯಿರುತೆ ಯೆರೂಸಲೇಮ್ವಳು</para>
  <para style="q2" vid="OBA 1:20">ದಕ್ಷಿಣ್ ಟಬರ್ಕನು ಖ್ಹಾರು ಖ್ಹಯೇರ್ ಸೊಂತ್‍ಕರಿಲಿಶೆ.<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />ಬಚಡವಳೊ ಏಸಾವ್ ನು ಫಡ್ ನ ಆಳಾನ</para>
  <para style="q2" vid="OBA 1:21">ಚೀಯೋನ್ ಫಡ್ ನ ಛಡ್ ಶೆ.</para>
  <para style="q1" vid="OBA 1:21">ತದೆ ರಾಜ್ ಭಾರಂ ಯೆಹೋವಾ ನು ಹುಯಿರ‍್ಹಶೆ.”<verse eid="OBA 1:21" /></para>
  <para style="b" />
  <chapter eid="OBA 1" />
</usx>