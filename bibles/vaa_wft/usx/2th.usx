<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TH" style="id">-WAGHRI</book>
  <para style="h">ಥೆಸಲೋನಿಕ</para>
  <para style="toc3">2 ಥೆಸ</para>
  <para style="toc2">2 ಥೆಸ</para>
  <para style="toc1">ಪೌಲನೆ ಥೆಸಲೋನಿಕವಾಳಾನ ಲೀಖ್ಯೋತೆ ಬೇನಿ ಚಿಟ್ಟಿ</para>
  <para style="mt2">ಪೌಲನು ಥೆಸಲೋನಿಕದವರಿಗೆ ಬರೆದ ಎರಡನೆಯ ಪತ್ರಿಕೆ</para>
  <para style="mt1">ಪೌಲನೆ ಥೆಸಲೋನಿಕವಾಳಾನ ಲೀಖ್ಯೋತೆ ಬೇನಿ ಚಿಟ್ಟಿ</para>
  <para style="imt">ಮಾಲುಮ್ ಕರಾನು</para>
  <para style="ip">ಥೆಸಲೋನಿಕವಾಳನ ಪೌಲ ಲೀಖುಕರಸ್ತೆ ಬೇನು ಕಾಗತ್ <char style="xt"><ref loc="2TH 1:1">1:1</ref></char>. ಥೆಸಲೋನಿಕವಾಳನ ಪಹಿಲು ಚಿಟ್ಟಿ ಲೀಖಿಹುಯ್ಗುತದೆ, ತುರಂತ್ ಯೋ ಆ ಚಿಟ್ಟಿನ ಲೀಖ್ಯೊ. ಯೇಸು ಪೈದಹುಯೊತೆ ಇನವಾರ್ ಖ್ಹುಮಾರ್ ಏಕ್‍ಉಪ್ಪರ್ ಐಡೈಖ್ಹ್‌ನ ವರಖ್ಹ್‌ನ ಪಾರ್ ಆ ಚಿಟ್ಟಿ ಲೀಖಾಯುತೆ. ಥೆಸಲೋನಿಕ ಸಬೆನ ಲೀಖಾನಿ ವಖ್ಹ್‌ತೆಬಿ ಯೋ ಕೊರಿಂಥಮಾಸ್ ಆ ಸಬೇವ್‌ನ ಇನ ಬೇನು ಶುಭಸಂದೇಶ್‍ನ ಬೋಲಾನಿ ಜಾ಼ವಾನಿವಖ್ಹತ್‍ಮ ಭಾಂದ್ಯೊ <char style="xt"><ref loc="ACT 17:1-10">ಅಪೊ 17:1-10</ref></char>. ಥೋಡು ಯೆಹೂದ್ಯ ಅದ್ಮಿ ಅಜು಼ ಖ್ಹುಮಾರ್ ಗ್ರೀಕ್‌ನು ಅದ್ಮಿ ಮಳಿನ್ ಆ ಸಬೆ ಭಂದೈರ‍್ಹುಥು ಕರಿ ಅಪೊಸ್ತಲರ‍್ನಿ ಪುಸ್ತಕ್‌ಮ ಬೋಲಸ್. ಥೆಸಲೋನಿಕಮಾನು ದೇವ್ನ ಅದ್ಮೆವ್‍ನ ಖ್ಹರ್ತಿನ ದನ್ನಿ ಬಾರೇಮ ಅಜು಼ ಕ್ರಿಸ್ತನು ಬೇನು ಆವಾನಿ ಬಾರೇಮ ಘಣು ಧ್ಯಾನ್ ಲೇವ್ಣು. ಶನಕತೊ ಪೌಲನೆ ಇನ ಲೀಖ್ಯೋತೆ ಬೇನಿ ಚಿಟ್ಟೀಮ ಅನಿ ಬಾರೇಮ ಘಣೇಥಿ ಲೀಖಿರಾಖ್ಯೊಸ್. ಆ ಬೇನು ಥೆಸಲೋನಿಕನು ಚಿಟ್ಟೀಮ ಖ್ಹುಮಾರ್ ಆಧುಭಾಗ್ ಖ್ಹತಮ್ ಹುವಾನ ವೇಳ್ಮ ಲೀಖಾಯು. ಪೌಲನೆ ಮೂರತ್‍ನಿ ಪೂಜಾ಼ನಿ ಬಾರೇಮಾಬಿ ಝೇತಾವಸ್. ಹರೇಕ್‍ಜ಼ಣು ಇನ ಖಾಣನಖ್ಹಾಜೆ ಕಾಮ್‌ಕರ‍್ನುಕರಿ ಬೋಲಸ್. <char style="xt"><ref loc="2TH 3:6-10">3:6-10</ref> </char></para>
  <para style="iot">ಕಾಡಿದೇಖೊ</para>
  <para style="io1">1. ಪೌಲನೆ ಚಿಟ್ಟೀಮ ಇನು ಅಜು಼ ಇನ ಜೋ಼ಡೆ ರ‍್ಹವಾಳಾನ ವತಾಳ್‍ತೊ ಹುಯಿನ್ ಶುರುಕರಸ್. <char style="ior"><ref loc="2TH 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. ಇನಕೇಡೆಥು ಯೊ ಥೆಸಲೋನಿಕನು ದೇವ್ನ ಅದ್ಮಿವೋನ ಝೂ಼ಂಡ್‌‍ನಖ್ಹಾಜೆ ದೇವ್ನ ಧನ್ಯವಾದ್ ಕರಸ್. ಅಜು಼ ಪ್ರಾರ್ಥನೆ ಕರಸ್. <char style="ior"><ref loc="2TH 1:3-12">1:3-12</ref> </char></para>
  <para style="io1">3. ಪೌಲನೆ ಖ್ಹರ್ತಿನ ದನ್ನ ವಖ್ಹತ್‌ನಿ ಬಾರೇಮ ವಾತೆ ಬೋಲಸ್. <char style="ior"><ref loc="2TH 2:1-17">2:1-17</ref> </char></para>
  <para style="io1">4. ಇನಕೇಡೆಥು ಯೋ ವಳ್‍ಶಿನಿ ಬಾರೇಮ ವಾತೆ ಬೋಲಸ್. ಅಜು಼ ಕಾಮ್ ಕರ್ನುಸ್ ಕರ‍್ನು ಕರಿ ಬಾರೇಮ ವಾತೆ ಬೋಲಸ್. <char style="ior"><ref loc="2TH 3:1-15">3:1-15</ref></char></para>
  <para style="io1">5. ಪೌಲನೆ ಬಿಜೇಕ್ ಹಲ್ಲ ದೇವ್ನ ಅದ್ಮಿವ್‍ನ ಟೋಳ್ನ ಖ್ಹಲಾಮ್ ಕರ್ತೊಹುಯಿನ್ ಚಿಟ್ಟಿನ ಖ್ಹತಮ್ ಕರಸ್. <char style="ior"><ref loc="2TH 3:16-18">3:16-18</ref></char></para>
  <chapter number="1" style="c" sid="2TH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1"/>ಅಪ್ಣೊ ಬಾ ಹುಯಿರ‍್ಹೋತೆ ದೇವ್‌ಮ ಅಜು಼ ಪ್ರಭು ಹುಯಿರ‍್ಹೋತೆ ಯೇಸು ಕ್ರಿಸ್ತಮ ಛಾ಼ತೆ ಥೆಸಲೋನಿಕ ಸಬೆನ, ಪೌಲ, ಸಿಲ್ವಾನ ಅಜು಼ ತಿಮೊಥೆ ಕರಿ ಹಮೆ ಲೀಖುಕರೇಸ್ತೆ ಶಾತ್‌ಕತೊ, <verse eid="2TH 1:1"/><verse number="2" style="v" sid="2TH 1:2"/>ಅಪ್ಣೊ ಬಾ ದೇವ್‍ಥಿಬಿ ಅಜು಼ ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತಥಿ ತುಮೂನ ವಾರ್‌ಖ್ಹೊ ಅಜು಼ ಶಾಂತಿ ಮಳಾದೆ.<verse eid="2TH 1:2"/></para>
  <para style="s">ಕ್ರಿಸ್ತ ಆವಾನಿವಖ್ಹ್‌ತೆ ತೀರ್ಪ್</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3"/>ಹಮಾರ ಭೈಯೆ ಭೇನೊ, ತುಮಾರಿ ಬಾರೇಮ ಹಮೆ ಹಮೇಶ ದೇವ್ನ ಧನ್ಯವಾದ್ ಕರಿಯೇಸ್. ಅಮ್ ಕರಾನು ಹಮೂನ ಬರೊಬರಸ್‌ ದೆಖಾಯು, ಶನಕತೊ ತುಮಾರಿ ವಿಶ್ವಾಸ್ ಘಣು ಭಡುಕರಾಸ್ ಅಜು಼ ಏಕ್‌ಥಿಏಕ್‌ ತುಮಾರಿ ಪ್ಯಾರ್ ದನ್‌ಪರ್-ದನ್ ಭಡ್ತು ಜಾ಼ವಾದೆ. <verse eid="2TH 1:3"/><verse number="4" style="v" sid="2TH 1:4"/>ಶನಕತೊ ತುಮೆ ಖ್ಹಮಾಳಮಾಬಿ ಖ್ಹತಾಪ್ಣಿಮಾಬಿ ತುಮಾರಮ ದೆಖಾಯುತೆ ವಿಶ್ವಾಸ್ನಖ್ಹಾಜೆಥಿ ದೇವ್ನಿ ಅದ್ಮಿನಿ ಸಬೇಮ ಕಮ್‌ಠೋಕಿ ವಾತೆ ಬೋಲಿಯೇಸ್.<verse eid="2TH 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5"/>ದೇವ್ನಿ ನೀತಿನಿ ತೀರ್ಪ್‌ನ ಖ್ಹಾಚು಼ ಖಿವುಕತೊ, ತುಮೆ ಲತಾಡಪಡುಕರಾತೆ ದೇವ್ನಿ ರಾಜ್ಯನ ತುಮೆ ಲ್ಹಾಯಕ್ ಹುಯಿರ‍್ಹವಾನು. <verse eid="2TH 1:5"/><verse number="6" style="v" sid="2TH 1:6"/>ನ್ಯಾವ್ನು ಕೋಣ್ ಕರಸ್ಕಿ ಇವ್ಣುನ ದೇವ್ ಅಛ್ಛು಼ಸ್ ಕರಸ್. ತುಮೂನ ಕೋಣ್ ಖ್ಹತಾವಸ್ಕಿ ಇವ್ಣುನ ದೇವ್ ಖ್ಹತಾವಸ್, <verse eid="2TH 1:6"/><verse number="7" style="v" sid="2TH 1:7"/>ಅಜು಼ ವಾಖ್ಯೊ ಛಾ಼ತೆ ತುಮುನಾಬಿ ಹಮೂನ ಪರಿಹಾರ್ ಕರ್ಶೆ. ಪ್ರಭು ಹುಯಿರ‍್ಹೋತೆ ಯೇಸು ಮಹಾ ಶಕತ್‌ವಾಳೊ ದೇವ್‌ದೂತರ್‌ನ ಜೋ಼ಡೆ ಸೊರ್ಗಥೊ ದೆಖಾವಾನಿ ವಖ್ಹತ್‌ಮ, ಇನ ಸಮಾಧಾನ್ ದಿಶೆ. <verse eid="2TH 1:7"/><verse number="8" style="v" sid="2TH 1:8"/>ಯೊ ಆಗ್‍ನಿ ಝ಼ಲ್‌ಪಟ್‌ ಜೋ಼ಡ್ಮ ಕೋಣ್ ದೇವ್ನ ಠೊಕ್ರಾವಸ್ಕಿ ಅಜು಼ ಯೇಸು ಪ್ರಭುನಿ ಬಾರೇನಿ ಸುವಾರ್ತೆನ ಮಾನ್ಯುಕೊಯ್ನಿಕಿ ಇವ್ಣುನ ನಿಶತ್‌ ದ್ಯವಾನ ಆವ್‌ಶೆ. <verse eid="2TH 1:8"/><verse number="9" style="v" sid="2TH 1:9"/>ಪ್ರಭು ಇವ್ಣುನ ಇನಿ ಮಹಿಮೆನಿ ಶಕತ್ನ ಖ್ಹಾಮ್ಣೇಥು ಹಟೈನಾಖಿದಿನ್ ಇವ್ಣುನ ಹರ್‌ಹಮೇಶಾನು ನಿಶತ್‌ ದಿಶೆ. <verse eid="2TH 1:9"/><verse number="10" style="v" sid="2TH 1:10"/>ಇನೆ ಯೋ ದನ್ಮ ಇನ ಪರಿಶುದ್ ಅದ್ಮಿವ್‌ಥಿ ಮಹಿಮೆಬಿ ಅಜು಼ ವಿಶ್ವಾಸ್‌ಮ ರ‍್ಹೇಯ್ತೆ ಇವ್ಣೇಥಿ ಮರ‍್ಯಾದಿಲೀನ್ ಆವಾಸ್ಕಿ ಯೊ ಅದ್ಮಿನಿ ಬೀಚ್ಮ ತುಮೇಬಿ ರ‍್ಹಿಶು. ಶನಕತೊ ಹಮೆ ತುಮುನ ಬೋಲ್ಯಾತೆ ಸಾಕ್ಷಿನ ತುಮೆ ನಂಬಿರಾಖ್ಯಾಸ್. <verse eid="2TH 1:10"/><verse number="11" style="v" sid="2TH 1:11"/>ಅನಖ್ಹಾಜೆಸ್ ಹಮೆ ಕದೇಬಿ ತುಮಾರಖ್ಹಾಜೆ ಪ್ರಾರ್ಥನೆ ಕರಿಯೇಸ್. ಅಪ್ಣೊ ದೇವ್ ತುಮೂನ ಬುಲಾಯೋತೆ ಇನಖ್ಹಾಜೆ ಯೋಸ್ ತುಮುನ ಲ್ಹಾಯೇಕ್‌ನಿ ಗಣ್ತಿ ಕರಿರಾಖ್ಯೊಸ್. ತುಮಾರಿ ಶಕತ್ ವಿಶ್ವಾಸ್‍ಥೀಬಿ ತುಮಾರಿ ಆಖ್ಹ್‌ನ ಅಜು಼ ಅಛ್ಛಾ಼ನ ಪೂರ ಕರಾದೆಕರಿ ಬಿಂತಿ ಕರ್ಯೆಸ್. <verse eid="2TH 1:11"/><verse number="12" style="v" sid="2TH 1:12"/>ಅಮ್ಮಸ್ ಅಪ್ಣೊ ಪ್ರಭು ಹುಯಿರ‍್ಹೋತೆ ಯೇಸು ಕ್ರಿಸ್ತನು ನಾಮ್ ತುಮಾರೇಥಿ ಮಹಿಮೆ ಉಶೆ, ಅಜು಼ ಇಮ್ಮಸ್ ತುಮೇಬಿ ಇನಾಮ ಮಹಿಮೆ ಲಿಶು. ಯೋ ಮಹಿಮೆ ಅಪ್ಣೊ ದೇವ್ ಅಜು಼ ಪ್ರಭು ಹುಯಿರ‍್ಹವಾಳ ಯೇಸು ಕ್ರಿಸ್ತನಿ ವಾರ್‌ಖ್ಹೇಥಿ ಚಾ಼ಲಾದೆ.<verse eid="2TH 1:12"/></para>
  <chapter eid="2TH 1"/>
  <chapter number="2" style="c" sid="2TH 2"/>
  <para style="s">ಝೂ಼ಟೊ ಅದ್ಮಿನಿ ಬಾರೇಮ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1"/>ಭೈಯೆ ಭೇನೊ, ಅಪ್ಣೊ ಪ್ರಭು ಹುಯಿರ‍್ಹೋತೆ ಯೇಸು ಕ್ರಿಸ್ತ ಆವಾನಿ ಬಾರೇಮ ಅಜು಼ ಅಪ್ಣೆ ಖ್ಹಾರು ಎಕ್ಟು ಹುಯಿನ್ ಇನ ಮಳಾನಿ ಬಾರೇಮ ತುಮೂನ ಬೋಲಿಲಿಯೇಸ್. <verse eid="2TH 2:1"/><verse number="2" style="v" sid="2TH 2:2"/>ಪ್ರಭುನೊ ದನ್ ಐರ‍್ಹೋಸ್ ಕರಿ ತುಮೆ ಆತ್ಮಥಿರ‍್ಹಿಲೇವೊ ವಾತೆಮರ‍್ಹಿಲೇವೊ ಹಮಾರಿ ಚಿಟ್ಟಿರ‍್ಹಿಲೇವೊ ತುಮೆ ವಗ್ಗಿಸ್‌ಮ ಕಲಾವ್ಣಿ ನಕೊಹುವೊ. <verse eid="2TH 2:2"/><verse number="3" style="v" sid="2TH 2:3"/>ಕೋಣ್‌ಬಿ ಕೆವ್ಹಿ ತರಿಖಾಮಾಬಿ ಠಗಾವ್ಣುನಾತೆ ಇಮ್‌ ದೇಖಿಲೇವೊ. ಶನಕತೊ ಪಹಿಲೆ ವಿಶ್ವಾಸ್‌ನ ಕಾಡಿನಾಖಿನ್ ನಾಶಕರವಾಳೊ, ವಿರೋದಿ ಭಡ್ಕಲಗುಬಿ ಯೊ ದನ್ ಆವ್‌ಶೆ ಕೊಯ್ನಿ. <verse eid="2TH 2:3"/><verse number="4" style="v" sid="2TH 2:4"/>ಖಿವು ದೇವ್‌ನು ಹುಯಿರ‍್ಹುಸ್ ನತರ್ ಆರಾದನೆನ ಯೋಗ್ಯಹುಯಿರ‍್ಹಾವನು ಹುಯಿರ‍್ಹುಸ್ಕಿ, ಯೋ ಖ್ಹಾರಾನ ನಾಶ್ ಕರ್ಷೆ. ಇನು ಯೋಸ್ ಖ್ಹಾರೇಥಿಬಿ ಭಡೈಲೀನ್, ದೇವ್ನಿ ಮಂದಿರ್‌ಮ ಬೇಶಿನ್‌ ಯೋಸ್ ದೇವ್‌ಕರಿ ಬೋಲಿಲಿಶೆ. <verse eid="2TH 2:4"/><verse number="5" style="v" sid="2TH 2:5"/>ಮೇ ತುಮಾರಿ ಜೋ಼ಡ್ಮ ಥೋತೆ ತದೆ, ಆ ಖ್ಹಾರಿ ಬಾರೇಮ ಬೋಲ್ಯೊತೆ ತುಮೂನ ಯಾದ್ ಕೊಯ್ನಿಕಿ ಶು? <verse eid="2TH 2:5"/><verse number="6" style="v" sid="2TH 2:6"/>ಯೋ ಬರೋಬರ್‌ನಿ ವಖ್ಹತ್‌ಮ ದೆಖಾವ್ಣುನಾತೆ ಇಮ್ ಅನಿ ಬಾರೇಮ ಶಾತ್ ಅಡ್ಡಿ ಹುಯಿರ‍್ಹುಸ್‌ಕರಿ ತುಮೂನ ಮಾಲುಮ್ ಛಾ಼. <verse eid="2TH 2:6"/><verse number="7" style="v" sid="2TH 2:7"/>ಠಗಾವ್ಣು ಅಜೂ಼ಬಿ ಗಪ್ಲಥ್ಥಿ ಕಾಮ್ ಕರುಕರಸ್. ಕತೋಬಿ ಅನ ಠೇರೈರಾಖವಾಳೊ ವಾಟ್‌ ಮ್ಹೇಲಾಲಗುಬಿ ಯೋ ಗಪ್ಲಥ್ಥೀಸ್ ರ‍್ಹಿಶೆ. <verse eid="2TH 2:7"/><verse number="8" style="v" sid="2TH 2:8"/>ಯೋ ಅಧರ್ಮಿ<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">ಅಛ್ಛಾ಼ನ ವಿರೋದ್‌ ಕರಾವಳೊ </char></note> ದೆಖಾವ್‌ಶೆ. ಪ್ರಭು ಯೇಸು ಇನ ಮ್ಹೋಡಾನು ದಮ್‌ಥೀಸ್ ಇನ ಮಾರಿನಾಕ್‌ಶೆ. ಅಜು಼ ಯೋ ಹಿಜ಼್ಜಾ ರ‍್ಹಿಶೇತೆ ಇನಖ್ಹಾಜೇಸ್ ಇನ ನಾಶ್ ಕರಿನಾಕ್‌ಶೆ. <verse eid="2TH 2:8"/><verse number="9" style="v" sid="2TH 2:9"/>ಯೋ ಅಧರ್ಮಿ ಶೈತಾನ್ನಿ ಶಕಥ್ಥಿ ಭರೈನ್ ಆವ್‌ಶೆ ಅಜು಼ ಕೈಯೆಕ್ಕಿಥರಾನು ಠಗಾವನು ಮೋಟುಕಾಮ್, ಅದ್ಭುತ್‌ಕಾಮ್, ಚಮತ್ಕಾಕರ್‌ನ ಕರ್ಶೆ. <verse eid="2TH 2:9"/><verse number="10" style="v" sid="2TH 2:10"/>ಇವ್ಣೆ ಖ್ಹಾಚಿನ ಪ್ಯಾರ್ ನಾಕರೀನ್‌, ರಕ್ಷಣೆ ಕೋಲೆಯಿಂತೆ ಝಿಟ್ಕಾರಿನ್ ನಾಶನ್ನ ಮಾರಗ್‍ಮ ರ‍್ಹವಾಳನ ಅಖ್ಖೀಸ್ ಥರಾನಿ ಖರಾಬ್‌ ದಿಮಾಕ್‌ಥಿ ಯೋ ಠಗಾವ್‌ಶೆ. <verse eid="2TH 2:10"/><verse number="11" style="v" sid="2TH 2:11"/>ಇನಖ್ಹಾಜೇಸ್ ದೇವ್ ಇವ್ಣುನ ಘಣಿ ಮೈಕಮ್ಮ ನಾಖಿನ್ ಇವ್ಣೆ ಯೋ ಝೂ಼ಟಿನ ನಂಬಾನಿಘೋಣಿ ಕರ್ಷೆ . <verse eid="2TH 2:11"/><verse number="12" style="v" sid="2TH 2:12"/>ಅನೇಥಿ ಖ್ಹಾಚಿನ ವಿಶ್ವಾಸ್‌ಕರ‍್ಯುಕೊಂತೆ, ಪಾಪ್ನು ಕಾಮ್ಮ ಖ್ಹುಶಿಕರಾವಾಳ ಹರೇಕ್ನ ತೀರ್ಪ್‌ ಉಶೆ.<verse eid="2TH 2:12"/></para>
  <para style="s">ತುಮೆ ರಕ್ಷಣೇನ ಚು಼ಣಿಲಿದ</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13"/>ಪ್ರಭು ಪ್ಯಾರ್ ಕರಾಸ್ತೆ ಭೈಯೆ ಭೇನೆವೊ, ಹಮೆ ತುಮಾರಿ ಬಾರೇಮ ಹಮೇಶ ದೇವ್ನ ಧನ್ಯವಾದ್ ಕರಾವಳ ಹುಯಿರ‍್ಹಾಸ್. ಶನಕತೊ ತುಮೆ ಪವಿತ್ರಾತ್ಮಾಥಿ ಪಾಕ್‌ ಹುಯಿನ್, ಖ್ಹಾಚಿಪರ್ ವಿಶ್ವಾಸ್‌ರಾಖಿನ್ ರಕ್ಷಣೆನ ಲೀಲ್ಯಾವದೆಕರಿ ದೇವ್ನೆ ತುಮೂನ ಶುರುವಾತ್‌ಮಾಸ್ ಚೂ಼ಣಿರಾಖ್ಯೊಸ್. <verse eid="2TH 2:13"/><verse number="14" style="v" sid="2TH 2:14"/>ತುಮೆ ಅಮ್ ರಕ್ಷಣೆಮ ಐನ್, ಅಪ್ಣೊ ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತನಿ ಮಹಿಮೆಮ ಪೇಖ್ಹ್‌ಣುಕರಿ, ಹಮೆ ಬೋಲ್ಯಾತೆ ಸುವಾರ್ತೆಥಿ ದೇವ್ನೆ ತುಮೂನ ಬುಲಾಯೊ. <verse eid="2TH 2:14"/><verse number="15" style="v" sid="2TH 2:15"/>ಇನಖ್ಹಾಜೇಸ್ ಹಮಾರ ಭೈಯೆ-ಭೇನೆವೊ, ಘಟ್ ಭೀರ‍್ಹೆವೊ, ಹಮೆ ವಾತೇಥಿರ‍್ಹವೊ ಅಜು಼ ಹಮೆ ಲೀಖ್ಯಾತೆ ಕಾಗತ್‌ಥ್ಥಿರ‍್ಹವೊ ತುಮೂನ ಮಾಲುಮ್ ಕರಾಯಾತೆ ಪದತ್ತಿನ ತುಮೆ ಘಟ್ ಧರಿಲೆವೊ. <verse eid="2TH 2:15"/><verse number="16" style="v" sid="2TH 2:16"/>ಅಪ್ಣುನ ಪ್ಯಾರ್ ಕರೀನ್, ಕೆದೇಬಿ ರ‍್ಹವಾನು ಹುಮ್ಮಖ್ಹ್‌ನಬಿ, ಅಛ಼್ಛು ಭರೋಖ್ಹಾನಬಿ ಇನಿ ವಾರ್‌ಖ್ಹೇಥಿ ದಿದೋತೆ ಅಪ್ಣೊ ಬಾ ಹುಯಿರ‍್ಹೋತೆ ದೇವ್‌ಬಿ ಅಪ್ಣೊ ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತ ಯೋಸ್ ತುಮಾರ ದಿಲ್‌ಮನ್ನ ಧಿಲ್‌ಪತ್‌ ದ್ಯವಾದೆ. <verse eid="2TH 2:16"/><verse number="17" style="v" sid="2TH 2:17"/>ಖ್ಹಾರಿಸ್ ತರ‍್ಹಾನು ಅಛ಼್ಛಕಾಮ್ಮಬಿ ಅಛ಼್ಛು ವಚನ್‌ಮಾಬಿ ತುಮುನ ಭಾಲಿದ್ಯವಾದೆ.<verse eid="2TH 2:17"/></para>
  <chapter eid="2TH 2"/>
  <chapter number="3" style="c" sid="2TH 3"/>
  <para style="s">ಹಮಾರಖ್ಹಾಜೆ ಪ್ರಾರ್ಥನೆ ಕರೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1"/>ಹಮಾರ ಭೈಯೆ ಭೇನೆವೊ, ಹಮಾರಖ್ಹಾಜೆ ಪ್ರಾರ್ಥನೆ ಕರೊ, ಪ್ರಭುನಿ ವಚನ್ ತುಮಾರಾಮ ಫೈಲೀತೆ ಇಮ್ಮಸ್, ಬಿಜಿಖ್ಹಾರಿ ಬಾಜು಼ಮಾಬಿ ವಗ್ಗಿಸ್ ಫೈಲೈನ್ ಮಹಿಮೆ ಹುವಾದೆ. <verse eid="2TH 3:1"/><verse number="2" style="v" sid="2TH 3:2"/>ಅಜು಼ ದೇವ್ ಹಮೂನ ಮೂರ್ಖ್‌ ಹುಯಿರ‍್ಹೂತೆ ಖರಾಬ್ ಅದ್ಮಿನ ಹಾತೇಥಿ ಬಚಾ಼ಡನಿ ಘೋಣಿಬಿ ಪ್ರಾರ್ಥನೆ ಕರೋಕಿ, ಕ್ರಿಸ್ತನು ವಿಶ್ವಾಸ್ ಅಖ್ಖಾಸ್‍ಮ ರ‍್ಹೆಯಿಕೊಯ್ನಿನಿ. <verse eid="2TH 3:2"/><verse number="3" style="v" sid="2TH 3:3"/>ಕತೋಬಿ ಪ್ರಭು ವಿಶ್ವಾಸ್‌ವಾಳೊ, ಯೋ ತುಮೂನ ಶಕತ್ ದೀನ್, ಖರಾಬ್‌ನ ಹಾತ್‌ಮ ಖ್ಹಪಡ್ನುನಾತೆ ಇಮ್‌ ಬಚಾ಼ಡ್‌ಶೆ. <verse eid="2TH 3:3"/><verse number="4" style="v" sid="2TH 3:4"/>ಹಮೆ ಬೋಲ್ಯಾತೆ ಇಮ್‌ ತುಮೆ ಕರುಕರಸ್ ಅಜು಼ ಖ್ಹಾಮ್ಣೇಬಿ ತುಮೆ ಕರ್ಷುಕರಿಬಿ ಪ್ರಭುನೆ ಹಮೂನ ಭರೋಖ್ಹೊ ದೀರಾಖ್ಯೊಸ್. <verse eid="2TH 3:4"/><verse number="5" style="v" sid="2TH 3:5"/>ತುಮೆ ದೇವ್ನಿ ಲಾಡ್‌ಮಾಬಿ ಕ್ರಿಸ್ತನು ಖ್ಹಮಾಳಿಲ್ಯಾವಾಮಾಬಿ ಮಳಾನಿಘೊಣಿ ಪ್ರಭುಸ್ ತುಮೂನ ಚಲಾವದೆ.<verse eid="2TH 3:5"/></para>
  <para style="s">ಕಾಮ್ನು ಜಿಮ್ಮೆದಾರಿ</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6"/>ಹಮಾರ ಭೈಯೆ ಭೇನೆವೊ, ಕಾಮ್ ಕರಾಕೊಂತೆ ಅಜು಼ ಹಮೆ ಬೋಲ್ಯಾತೆ ಪದತ್ತಿನ ಪಾಡಿನ್ ಚಾ಼ಲಕೊಂತೆ ವಿಶ್ವಾಸಿ ಖ್ಹಾರೇಥಿ ತುಮೆ ದೂರ್ ರ‍್ಹೇಣು. ಪ್ರಭು ಹುಯಿರ‍್ಹೋತೆ ಯೇಸು ಕ್ರಿಸ್ತನ ನಾಮ್‌ಪರ್‌ ತುಮೂನ ಹುಕುಮ್ ದಿಯೇಸ್. <verse eid="2TH 3:6"/><verse number="7" style="v" sid="2TH 3:7"/>ಹಮೆ ಜಿವ್ಯಾತೆ ಇಮ್ಮಸ್ ತುಮೇಬಿ ಜಿವ್ಣುಕರಿ ತುಮೂನ ಅಛ್ಛಿನಿತರ ಮಾಲುಮ್ ಛಾ಼. ಹಮೆ ತುಮಾರಕನ ಥಾತೆ ತದೆ ಶೋಂಬೇರಿ ಕೋಥಾನಿ. <verse eid="2TH 3:7"/><verse number="8" style="v" sid="2TH 3:8"/>ಫುಗಟ್‌ಥಿ ಹಮೆ ಕಿನಕನಾಬಿ ಖಾಣು ಖಾದಕೊಯ್ನಿ. ತುಮಾರಮ ಕಿನಾಪರ್‌ಬಿ ಹಮೆ ಭಾರೊ ನಾ ನಾಕ್ಣುಕರಿ ಹಮೆ ರಾತ್-ದನ್ ಕಾಮ್ ಅಜು಼ ಮ್ಹಿನತ್ ಕರೀನ್ ಜಿವ್ಣು ಚ಼ಲಾಯ. <verse eid="2TH 3:8"/><verse number="9" style="v" sid="2TH 3:9"/>ತುಮಾರೇಥಿ ದೇಕ್‌ಬಾಲ್ ಕರೈಲ್ಯವಾನ ಹಮೂನ ಹಕ್‍ಕೊಯ್ನಿಕರಿ ಕಾಹೆ, ತುಮೆ ಹಮಾರಿನಿತರ ಚಾ಼ಲಾದೆಕರಿಸ್ ತುಮೂನ ಇಮ್ ದೆಖೈಲಿದಾತೆ. <verse eid="2TH 3:9"/><verse number="10" style="v" sid="2TH 3:10"/>ಇನಖ್ಹಾಜೇಸ್ ಹಮೆ ತುಮಾರ ಜೋ಼ಡೆ ಥಾತೆ ತದೆ, “ಕಾಮ್ ಕರಾಕೊಂತೆ ಯೊ ಖಾಣು ನಾಖಾವ್ಣು” ಕರಿ ಹುಕುಮ್ ದಿದಾಥಾತೆ. <verse eid="2TH 3:10"/><verse number="11" style="v" sid="2TH 3:11"/>ಕತೋಬಿ ತುಮಾರಾಮ ಥೋಡುಜ಼ಣು ಖೆವು ಕಾಮ್‌ಬಿ ಕರುಕರಾಕೊಂತೆ, ಬಿಜಾ಼ನ ಕಾಮ್ಮ ಗೋಡೊ ಘಾಲ್ತುಹುಯಿನ್, ವಳ್‌ಶಿನು ಜಿವ್ಣು ಜಿವ್‌ಕರಾಸ್ ಕರಿ ಹಮೂನ ಖಬರ್‌ಪಡ್ಯು. <verse eid="2TH 3:11"/><verse number="12" style="v" sid="2TH 3:12"/>ಅಥ್ರಾನ ಅದ್ಮಿವ್‌ನ ಹಮೆ ಇವ್ಣು ಕಾಮ್ ಇವ್ಣೇಸ್ ಕರ್ತುಹುಯಿನ್, ಇವ್ಣ ಖಾಣಾನಖ್ಹಾಜೆ ಇವ್ಣೆಸ್ ಕಮಾವ್ಣುಕರಿ, ಹಮೆ ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತನ ನಾಮ್ಮ ಹುಕುಮ್ ದೀನ್ ಅಜು಼ ಬೋಲಿಲಿಯೆಸ್. <verse eid="2TH 3:12"/><verse number="13" style="v" sid="2TH 3:13"/>ಕತೋಬಿ ಹಮಾರ ಭೈಯೆ-ಭೇನೆವೊ, ತುಮೇತೊ, ಅಛ್ಛು಼ ಕರಾಮ ಕದೇಬಿ ಬೇಜಾರ್ ಕರ್ಶು ನಕೊ. <verse eid="2TH 3:13"/><verse number="14" style="v" sid="2TH 3:14"/>ಆ ಚಿಟ್ಟೀಮ ಹಮೆ ತುಮೂನ ಬೋಲುಕರೇತೆ ಕೋಣ್ ಇನ ಮಾನಕೊಯ್ನಿಕಿ, ಇಮ್‌ನಾನಿ ಖ್ಹಣೇದ್ ಕರೀನ್, ಇನ ಖ್ಹರಮ್‌ ಲಾಗಾನಿಘೋಣಿ ಕೋಣ್‌ಬಿ ಇನಿ ಖ್ಹಂಗ್ ನಕೊ ಕರೊ. <verse eid="2TH 3:14"/><verse number="15" style="v" sid="2TH 3:15"/>ಕತೋಬಿ ಇನ ದುಶ್‌ಮನ್ನಿಘೋಣಿ ನಕೊ ಸೋಚೊತೆ ಅನಬದಲ್ ಇನ ವಿಶ್ವಾಸಿ ಭೈ ಕರಿ ಸೋಚಿನ್ ಅಕ್ಕಲ್ ಬೋಲ್.<verse eid="2TH 3:15"/></para>
  <para style="s">ಖ್ಹರ್ತಿನಿ ವಾತೆ</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16"/>ಶಾಂತಿವಾಳೊ ಪ್ರಭು ಖ್ಹುದ್ ತುಮೂನ ಖ್ಹಾರಿಸ್ ವಖ್ಹತ್‌ಮ ಅಜು಼ ಖ್ಹಾರಿಸ್ ತರ‍್ಹಾಮ ಶಾಂತಿ ದ್ಯವಾದೆ. ಪ್ರಭು ತುಮಾರ ಖ್ಹಾರಸ್ನ ಜೋ಼ಡೆ ರ‍್ಹವಾದೆ. <verse eid="2TH 3:16"/><verse number="17" style="v" sid="2TH 3:17"/>ಪೌಲಕರಿ ಮೇ ಮಾರ ಹಾತೇಥಿಸ್ ತುಮುನ ಖ್ಹಲಾಮ್ನ ಲೀಖುಕರುಸ್. ಮೇ ಆಸ್ ಪರಕ್ ಚಿಟ್ಟೀಮ ಅಮ್ಮಸ್ ರುಜು ಕರುಸ್. ಮೇ ಲೀಖಾನು ತರೀಕ ಆಸ್‌ಹುಯಿರ‍್ಹುಸ್. <verse eid="2TH 3:17"/><verse number="18" style="v" sid="2TH 3:18"/>ಅಪ್ಣೊ ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತನಿ ವಾರ್‌ಖ್ಹೊ ತುಮಾರ ಅಖ್ಖಾಸ್ನಿ ಜೋ಼ಡ್ಮ ರ‍್ಹವಾದೆ.<verse eid="2TH 3:18"/></para>
  <chapter eid="2TH 3"/>
</usx>
