<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">-WAGHRI</book>
  <para style="h">ಫಿಲಿಪ್ಪಿ</para>
  <para style="toc3">ಫಿಲಿಪ್ಪಿ</para>
  <para style="toc2">ಫಿಲಿಪ್ಪಿ</para>
  <para style="toc1">ಪೌಲನೆ ಫಿಲಿಪ್ಪಿವಾಳಾನ ಲೀಖ್ಯೋತೆ ಚಿಟ್ಟಿ</para>
  <para style="mt2">ಪೌಲನು ಫಿಲಿಪ್ಪಿಯವರಿಗೆ ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="mt1">ಪೌಲನೆ ಫಿಲಿಪ್ಪಿವಾಳಾನ ಲೀಖ್ಯೋತೆ ಚಿಟ್ಟಿ</para>
  <para style="imt">ಮಾಲುಮ್ ಕರಾನು</para>
  <para style="ip">ಪೌಲನೆ ಕ್ರಿಸ್ತನಿ ಪೈದಾಖ್ಹ್‌ನ ವಾರ್ ಖ್ಹುಮಾರ್ 61 ನು ವರಖ್ಹ್‌ಮ ಆ ಚಿಟ್ಟಿ ಫಿಲಿಪ್ ಖ್ಹಯೇರ‍್ನ ವಿಶ್ವಾಸಿನ ಲೀಖ್ಯೋತೆ, ಆ ವೇಳ್ಮ ಯೊ ಘಣೇಥಿ ರೋಮ್‍ನ ಖ್ಹಾರ್ಕೊಟ್‌ಮ ಥೊ. <char style="xt"><ref loc="PHP 1:13">1:13</ref></char> ಆ ಚಿಟ್ಟಿ ಫಿಲಿಪ್ಪಿ ಖ್ಹಯೇರ್‌ಮ ಛಾ಼ತೆ ಸಬೇನ ಲಿಖೈರ‍್ಹುಸ್. ಅಪೊಸ್ತಲನು ಕಾಮ್ನ ಪುಸ್ತಕ್‌ಮ ಫಿಲಿಪ್ಪಿನಿ ಬಾರೇಮ ಅಪ್ಣೆ ಥೋಡಿ ವಾತೇವ್ನ ಮಾಲುಮ್ ಕರೆಜಾ಼ಯ್. ಫಿಲಿಪ್ಪಿ ಖ್ಹಯೇರ್ ಮೆಸೆಡೋನಿಯ ತಬರ್‌ಖಾನು ರಾಜಧಾನಿ ಹುಯಿರ‍್ಹುಥು. ಆ ಸಭೆ ಮೆಸೆಡೋನಿಯಮ ಭಂದೈರ‍್ಹುತೆ ಪಹಿಲಿ ಸಭೆ ಹುಯಿರ‍್ಹಿಥಿ. ಪೌಲಬಿ ಸೀಲಾನೆ ಆ ಸಬೆನ ಶುರುಕರ‍್ಯ ಅಜು಼ ಹಿಜ಼್ಜಾಥಾತೆ ತದೆ ಏಕ್‌ ದನ್ ಖ್ಹಾರ್ಕೊಟ್‌ಮ ಘಲೈರ‍್ಹಾಥ <char style="xt"><ref loc="ACT 16">ಅಪೊ 16</ref>.</char></para>
  <para style="ip">ಆ ಚಿಟ್ಟಿ ಲಿಖಾನ ಪೌಲನಿ ಕೈಯೇಕ್ ಉದ್ದೇಶ್ ರ‍್ಹೇವ್ಣುಕರಿ ದೆಖಾವಸ್ ಇನೆ ಆ ಮೋಕಾನ ಇವ್ಣೆ ಖ್ಹಾರ್ಕೊಟ್‌ಮ ಛಿಯ್ಯೆಕರಿ ಖ್ಹಮ್‌ಜಿನ್‌ ಇವ್ಣೆ ಮೋಕ್‌ಲ್ಯುತೆ ಇನಾಮ್ನಖ್ಹಾಜೆ ಸಬೆನ ಧನ್ಯವಾದ್ ಬೋಲಾನ ಉಪಯೋಗ್ ಕರಿಲೇಸ್ <char style="xt"><ref loc="PHP 4:10-19">4:10-19</ref></char> ಇನೆ ಖ್ಹಾರ್ಕೊಟ್‌ಮ ಥೂತೆ ಇವ್ಣಿ ಹಾಲತ್ನಿ ಬಾರೇಮ ಬೋಲಸ್ ಅಜು಼ ತಿಮೊಥೆಬಿನ್ ಎಪಪ್ರೊದಿಕನ ಸಬೆನ ಮಾಲುಮ್‌ ಕರೈವತಾಳಸ್‍ <char style="xt"><ref loc="PHP 2:19-30">2:19-30</ref></char> ಅಮ್ ಇವ್ಣೆ ಇವ್ಣುನ ಸ್ವಾಗತ್ ಕರಾನಿಮತ್‌ ಅಜು಼ ಇವ್ಣಿ ಗಲ್‌ಢಾನ ಮರ್ಯಾದಿ ಆವಾನಿಘೋಣಿ ಬೋಲಸ್.</para>
  <para style="iot">ಕಾಡಿದೇಖೊ</para>
  <para style="io1">1 ಪೌಲನೆ ಫಿಲಿಪ್ಪಿನಿ ಸಬೇನ ಖ್ಹಲಾಮ್ ಕರ್ತೊಹುಯಿನ್ ಶುರುವಾತ್ ಕರಸ್. <char style="ior"><ref loc="PHP 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2 ಇನಕೇಡೆಥು ಯೊ ಇನಿ ರ‍್ಹಾನಿ ಬಾರೇಮ ಥೋಡು ಸಂದೇಶ್ನ ವಾಟಪಾಡಿಲೆಸ್ ಅಜು಼ ಇನಥೂತೆ ಥೋಡಿ ತರಖ್ಹ್‌ಥಿ ವಾಟಪಾಡಿಲೆಸ್. <char style="ior"><ref loc="PHP 1:3-2:3">1:3—2:3</ref></char></para>
  <para style="io1">3 ಇನಕೇಡೆಥು ಯೊ ಕ್ರಿಸ್ತನು ವಿಶ್ವಾಸಿನ ಜಿವ್ಣಾನಖ್ಹಾಜೆ ಘಣೇಥಿ ಘಣು ಕಾಮ್‌ಕರ್ತೊಹುಯಿನ್‌ ವಾಟ್‌ವತಾಳ್ತೊ ಗಯೊ <char style="ior"><ref loc="PHP 3:1-4:9">3:1—4:9</ref></char></para>
  <para style="io1">4 ಪೌಲನೆ ಫಿಲಿಪ್ಪಿ ಸಬೇನ ಇವ್ಣೆ ಮೋಕ್‌ಲ್ಯುತೆ ಇನಾಮ್ನಖ್ಹಾಜೆ ಧನ್ಯವಾದ್ ಬೋಲಿನ್ ಇನಿ ಖ್ಹಲಾಮ್ನ ಬೋಲ್ತೊಹುಯಿನ್ ಚಿಟ್ಟಿನ ಖತಮ್ ಕರಸ್ <char style="ior"><ref loc="PHP 4:10-23">4:10-23</ref> </char></para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />ಕ್ರಿಸ್ತ ಯೇಸುನ ದಾಸ ಹುಯಿರಾತೆ ಪೌಲಬಿ ತಿಮೊಥೆ, ಫಿಲಿಪ್ಪಿ ಖ್ಹಯೇರ‍್ನ ವಿಶ್ವಾಸಿಖ್ಹಾರಾನ ಅಜು಼ ಇವ್ಣ ಜೋ಼ಡೆ ರ‍್ಹವಾಳನ ಸಬೇನ ಮೋಟಾನ ಅಜು಼ ಮದತ್ ಕರವಾಳನ ಲೀಖಾನು ಶಾತ್‌ಕತೊ, <verse eid="PHP 1:1" /><verse number="2" style="v" sid="PHP 1:2" />ಬಾ ದೇವ್‌ಥಿಬಿ ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತಥಿಬಿ ತುಮುನ ವಾರ್‌ಖ್ಹೊಬಿ ಶಾಂತಿಬಿ ಮಳಾದೆ.<figure style="fig" alt="City of Philippi" file="hk00363c.tif" size="span" copy="Horace Knowles ©" ref="1:2">ಫಿಲಿಪ್ಪಿ ನಂಗರ‍್ನ ದೇಖಾನು</figure><verse eid="PHP 1:2" /></para>
  <para style="s">ಇನ ಪಢವಾಳನಖ್ಹಾಜೆ ಪೌಲನಿ ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />ತುಮುನ ಯಾದ್ ಕರಾನಿ ಖ್ಹಾರಿ ವಖ್ಹತ್‌ಮ ಮೆ ದೇವ್ನ ಧನ್ಯವಾದ್ ಕರುಸ್, <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />ಮೇ ತುಮಾರಖ್ಹಾಜೆ ಪ್ರಾರ್ಥನೆ ಕರಾನಿ ಅಖ್ಖೀಸ್ ವಖ್ಹತ್‍ಮಾಬಿ ಶಂತೋಖ್ಹ್‌ಥೀಸ್ ಪ್ರಾರ್ಥನೆ ಕರಾವಾಳೊ ಹುಯಿರ‍್ಹೋಸ್. <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />ಶನಕತೊ ತುಮೆ ಪಹಿಲೆಥ ಹಮ್ಕೆಲಗುಬಿ ಸುವಾರ್ತೆನು ಬೋಧನೆಮ ಭಾಗ್‌ರ‍್ಹವಾಳ ಹುಯಿರ‍್ಹಾಸ್. <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />ಆ ಅಛ಼್ಛುಕಾಮ್ನ ತುಮಾರಮ ಶುರುಕರ‍್ಯೊತೆ ದೇವ್ನೆ ಇನ ಚ಼ಲಾವ್ತೊಹುಯಿನ್ ಯೇಸು ಕ್ರಿಸ್ತ ಆವಾನಮಹಿ ಪೂರ ಕರ್ಶೆಕರಿ ಮನ ಭರೋಖ್ಹೊ ಛಾ಼. <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />ತುಮಾರಿ ಬಾರೇಮ ಮನ ಅಮ್ ಬೋಲಾವಸ್ತೆ ಖ್ಹಾಚು಼ಸ್. ಶನಕತೊ ಮೆ ಬಂದಿ ಹುಯಿರ‍್ಹವಾನಿ ವಖ್ಹ್‌ತೆಬಿ, ಸುವಾರ್ತೆನಿ ಬಾರೇನು ಆಡ್‌ಫೇಡ್‌ಮಾಬಿ ತುಮೆಖ್ಹಾರು ಮಾರಜೋ಼ಡೆ ದೇವ್ನಿ ವಾರ್‌ಖ್ಹಾಮ ಭಾಗ್‌ವಾಳ ಹುಯಿರ‍್ಹಾಸ್ ಕರಿ ತುಮುನ ಮಾರ ದಿಲ್ಮ ರಾಖಿಮ್ಹೇಲ್ಯೋಸ್. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />ಕ್ರಿಸ್ತ ಯೇಸುನ ಛಾ಼ತೆ ಗೋರ್‌ಥೀಸ್ ತುಮಾರ ಹರೇಕ್ನ ಖ್ಹಾಜೆ ಕೆತ್ರೇಕ್ಕಿ ತರ್ಖ್ಹುಕರುಸ್. ಅನ ದೇವಸ್ ಸಾಕ್ಷಿ. <verse eid="PHP 1:8" /><verse number="9" style="v" sid="PHP 1:9" />ಅಜು಼ ತುಮಾರಿ ಪ್ಯಾರ್ ಅಜೂ಼ಬಿ ಜಾ಼ಖ್ಹತ್ ಭಡಿನ್ ಪೂರ ಅಕ್ಕಲ್‍ಥೀಬಿ ಖ್ಹಯಾಲ್‌ಥಿ ಮಳಿರ‍್ಹವಾಳ ಹುಯಿರ‍್ಹೇವ್ಣುಕರಿ ಮೆ ತುಮಾರಖ್ಹಾಜೆ ಪ್ರಾರ್ಥನೆ ಕರುಸ್. <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />ಅಮ್ ಮಹಾನ್ ಕಾಮ್‌ಖ್ಹಾರು ಖಿವುಕರಿ ಬೋಲಾನು ತುಮೆ ಪರ್ಖಾವಾಳ ಹುಯಿರ‍್ಹೇಣು ಕರೀಬಿ ಬಿಜು಼ ಕ್ರಿಸ್ತ ಆವಾನ ದನ್ಮ ತುಮೆ ಪರಿಶುದ್‌ಥೀಬಿ ದೋಷ್‌ಕೊಂತೇಬಿ ರ‍್ಹಿಶು. <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />ಯೇಸು ಕ್ರಿಸ್ತಮ ಛಾ಼ತೆ ಅಛ್ಛು಼ಗುಣ್‌ನ ಭರೈರ‍್ಹವಾಳ ಹುಯಿನ್ ರ‍್ಹೇವ್ಣುಕರಿ ದೇವ್ನ ಮಹಿಮೆ ಅಜು಼ ದನ್ಯವಾದ್‌ನ ದೇವ್ಣುಕರಿ ಬಿಂತಿಕರಿಲೇವುಸ್.<verse eid="PHP 1:11" /></para>
  <para style="s">ಜಿವಾನಖ್ಹಾಜೆ ಕ್ರಿಸ್ತ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />ಭೈಯೇ ಭೇನೆವೊ, ಮನ ಹುಯೂತೆ ಅಖ್ಖೂಬಿ ಸುವಾರ್ತೆನ ಭಡಾವನ ಮದತ್ ಹುಯಿಕರಿ ತುಮೆ ಮಾಲುಮ್ ಕರಿಲೇವ್ಣುಕರಿ ಮೆ ಹರ್‌ಖ್ಹುಸ್. <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />ಕಿಮ್‌ಕತೊ ಮೆ ಜೇಲ್‌ಮ ರ‍್ಹವಾನು ಕ್ರಿಸ್ತನ ಖ್ಹಾಜೆಸ್ ಕರಿ ಮಹೇಲ್‌ನ ಕಾವ್ಲಿ ಕರಾವಾಳ ಖ್ಹಾರನಾಬಿ ಬಿಜು಼ಖ್ಹಾರನಾಬಿ ಮಾಲುಮ್‌ಪಡ್ಯು. <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />ಆ ನಾಹುಯಿನ್ ಭೈಯೇ ಭೇನೇಮ ಜಾ಼ಖ್ಹತ್ ಅದ್ಮಿ ಮಾರಿ ಭಂದಣ್‌ಥೀಸ್ ಪ್ರಭುಮ ಭರೋಖ್ಹಾಥಿ ದೇವ್ನಿ ವಚನ್ನ ಡರ್‌ಕೊಂತೆ ಬೋಲಾನ ಅಜೂ಼ಬಿ ಘಣು ಭಾಲಿ ಲೀರಾಖ್ಯುಸ್. <verse eid="PHP 1:14" /><verse number="15" style="v" sid="PHP 1:15" />ಥೋಡುಜ಼ಣು ಪೇಟ್ನೊ ಬಳಾಪೊಕರಿನ್ ದಿಲ್ಮ ಕಚ಼್ಚರ್ ರಾಖವಾಳ ಹುಯಿರ‍್ಹೇಸ್. ಕತೋಬಿ ಅಲಕ್ ಥೋಡುಜ಼ಣು ಅಛ್ಛಿ ಉದ್ದೇಶ್‌ಥಿ ಕ್ರಿಸ್ತನಿ ಸುವಾರ್ತೆನ ಬೋಲಿವತಾಳಸ್. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />ಅವ್ಣೇತೊ ಮೆ ಸುವಾರ್ತೆನಿ ಬಾರೇಮ ಜ಼ವಾಬ್ ಬೋಲಾನಖ್ಹಾಜೆ ಹಜ್ಜಾ಼ ಮೆ ಘಲೈರ‍್ಹೋಸ್ ಕರಿ ಮಾಲುಮ್ ಕರಿನ್ ಪ್ಯಾರ್‌ಥಿ ಪ್ರಚಾರ್ ಕರುಕರಸ್. <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />ಥೋಡುಜ಼ಣು ಇಮಾಂಧಾರಿನಖ್ಹಾಜೆ ಕಾಹೆ, ಶೊಂತ್‌ ಆಖ್ಹ್‌ನ ಖ್ಹಾಜೆಸ್ ಕ್ರಿಸ್ತನ ಪ್ರಚಾರ್ ಕರಾಸ್. ಕತೋಬಿ ಥೋಡುಜ಼ಣು ಮೆ ಬೇಡಿ ಘಲೈನ್ ಕೋಂಡೈರ‍್ಹವಾನಿ ವಖ್ಹ್‌ತೆ ಮನ ಖ್ಹತಾಪ್ಣಿ ಜಾ಼ಖ್ಹತ್ ಕರ್ನುಕರಿ ಸೋಚ್ಯು. <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />ಇವ್ಣಿ ಉದ್ದೇಶ್ ಶಾತಸ್ ಹುಯಿರ‍್ಹವಾದೆ, ಠಗಾವಾಥಿ ರ‍್ಹವೊ ನತರ್ ಖ್ಹಾಚೇಥಿ ರ‍್ಹವೊ ಯೋ ಮನ ಮುಖ್ಯಕಾಹೆ. ಕ್ರಿಸ್ತಯೇಸುನ ಬಾರೇಮ ಬೋಲಿವತಾಳು ಕರುಕರಾತೆಸ್ ಮನ ಖುಷಿ. ಅಜು಼ ಅಗ್ಗಳ್‌ಬಿ ಖುಷಿ ಕರುಸ್. <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />ಶನಕತೊ ತುಮಾರಿ ಬಿಂತಿಥಿಬಿ ಅಜು಼ ಯೇಸು ಕ್ರಿಸ್ತನು ಆತ್ಮನಿ ಮದತ್‌ಥೀಬಿ ಆ ಹೈರುತೆ ಮಾರು ಛುಟ್ಕಾರ್‌ನ ಶುಲ್ಬ ಉಷೆಕರಿ ಮಾಲುಮ್ ಛಾ಼. <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />ಕಿಮ್‌ಕತೊ ಮೆ ಖಿವಿ ವಿಚಾರ್‌ಮಾಬಿ ಖ್ಹರ್ಮಾಯೊಕೊಂತೆ ಕೆದೇಬಿ ರ‍್ಹವಾನಿತರಸ್ ಹಮ್ಕೇಬಿ ಜಿನು ಘಣು ಭಾಲಿಥಿ ಛೂ಼ತೆ ಇನಖ್ಹಾಜೆ ಜಿವ್ತೊ ರ‍್ಹಿಯೊತೋಬಿ ಬರೋಬರಸ್ ನತರ್ ಮರ‍್ಯೊತೋಬಿ ಬರೋಬರಸ್ ಮಾರಿ ಶರೀರ್‌ಥಿ ಕ್ರಿಸ್ತನ ಮಹಿಮೆ ಹುವಾದೆಕರಿ ಮಾರಿ ಮೋಟಿ ಹರಖ್ಹ್ ಹುಯಿರ‍್ಹೀಸ್, ಇಮ್ಮಸ್ ಉಷೆಕರಿ ಭರೋಖ್ಹೊ ಛಾ಼. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />ಮನತೊ ಬಚಾ಼ನುಕತೊ ಕ್ರಿಸ್ತಸ್, ಮರಾನು ನಫ್ಫೋಸ್. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />ಅಮ್ ಶರೀರ್‌ಮ ಬಚಾ಼ನುಸ್ ಫಲ್ ದ್ಯವಾನು ರ‍್ಹಯೂತೊ, ಅನಾಮಾಥು ಖಿವು ಚೂ಼ಣಿಲೇವ್ಣುಕರಿ ಮನ ಮಾಲುಮ್‌ ಕೊಪಡುಕರಾನಿ. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />ಆ ಭೇನ ಇಚ಼್‌ಮ ಖ್ಹಪ್‌ಡಿರ‍್ಹೋಸ್, ಹಜ್ಜಾ಼ಥು ನಿಕ್ಳಿನ್ ಕ್ರಿಸ್ತ ಯೇಸುನಿ ಜೋ಼ಡ್ಮ ರ‍್ಹೇವ್ಣುಕರಿ ಬೋಲಾನುಸ್ ಮಾರಿ ಆಖ್ಹ್ ಹುಯಿರ‍್ಹೀಸ್, ಯೊ ಘಣು ಅಛ್ಛು಼ಸ್ ಹುಯಿರ‍್ಹುಸ್. <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />ಕತೋಬಿ ಮೇ ಬಿಜೂ಼ಬಿ ಶರೀರ್‌ಮ ಜಿವ್‌ಕರಾನು ತುಮಾರಖ್ಹಾಜೇಥಿ ಘಣು ಜ಼ರೂರತ್ ಛಾ಼. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />ಇನಖ್ಹಾಜೆ ತುಮುನ ವಿಶ್ವಾಸ್ಮ ಭಡೀನ್ ಶಂತೋಖ್ಹ್‌ಥಿ ರ‍್ಹವಾನಖ್ಹಾಜೆ ಮೇ ಬಚಿರ‍್ಹೀನ್ ತುಮಾರ ಅಖ್ಖಾಸ್ನಿ ಜೋ಼ಡ್ಮರ‍್ಹೀಷ್ ಕರಿ ಘಟ್ ವಿಶ್ವಾಸ್ ಛಾ಼. <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />ಅಮ್ ಮೆ ಫಾಛೊ಼ಫರಿ ಆವಾಥಿ ತುಮೆ ಕ್ರಿಸ್ತ ಯೇಸುನ ಗಳ್‌ಜೋ಼ಡ್ಮ ಖುಷಿ ಕರಾನ ಮಾರೇಥಿ ಘಣಿ ಹುಮ್ಮಖ್ಹ್‌ ರ‍್ಹಿಶೆ. <verse eid="PHP 1:26" /><verse number="27" style="v" sid="PHP 1:27" />ಕಿಮ್‌ಬಿ ಕ್ರಿಸ್ತನಿ ಸುವಾರ್ತೆನ ಲ್ಹಾಯೇಕ್‌ಹುಯಿನ್ ಚಾ಼ಲಿಲೆವೊ. ತದೆ ಮೆ ಐನ್ ತುಮುನ ದೇಖ್ಯೊತೋಬಿ ಚಾ಼ಲಸ್, ದೂರ್ ರ‍್ಹೀನ್ ತುಮಾರಿ ಖಬರ್‌ನ ಖ್ಹಮ್‌ಜೊ ಚಾ಼ಲಸ್, ತುಮೆ ತುಮಾರ ವಿರೋದಿನ ಖಿವಿ ವಿಚಾರ್‌ಮಾಬಿ ನಾಡರ‍್ನುತೆ ಏಕ್‌ ದಿಲ್‌ಥಿ ಘಟ್‍ಥಿ ಭೀರಿನ್ ಸುವಾರ್ತೆಮ ರಾಖ್ಯತೆ ವಿಶ್ವಾಸ್ನಖ್ಹಾಜೆ ಏಕ್‌ ಮನ್‌ಥಿ ಲಡವಾಳ ಹುಯಿರ‍್ಹಾಸ್‍ಕರಿ ಮೆ ಲ್ಹಾವ್ಸ್. <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />ತುಮೆ ತುಮಾರ ವಹೇರ‍್ಯಾಥಿ ನಕೊ ಡರೊ ಕೆದೇಬಿ ಭಾಲ್‌ಥಿ ರ‍್ಹವೊ, ಅಜು಼ ಅನ ಸಬೂತ್ ಕರೂಸ್ಕಿ ವಿರೋದಿನ ನಾಶ್‌ ಅಜು಼ ತುಮುನ ರಕ್ಷಣೆ. ಶನಕತೊ ಆ ದೇವ್‍ಥಿಸ್ ಹುಯಿರ‍್ಹುಸ್. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />ಕ್ರಿಸ್ತನವಾಳಾನ ಹಾತ್‌ ಫೈಲೈನ್ ದ್ಯವಾಳ ಹುಯಿರೇವೊ. ಕ್ರಿಸ್ತಪರ್ ವಿಶ್ವಾಸ್‌ರಾಖಾನು ಖಲಿ ಕಾಹೆ ಇನಖ್ಹಾಜೆ ವದೇಖ್ಹ್‌ಪಡಾನುಬಿ ಅಛ್ಛು಼ ವರ ಮಳಿರ‍್ಹೂಸ್‌. <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />ಅಮ್ ತುಮೆ ಮಾರಮ ದೇಖ್ಯಾತೆ ಯೋಸ್ ಲಡ್ವಾನು ತುಮುನಾಬಿ ಛಾ಼.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">ಕ್ರಿಸ್ತಮ ಹೇಟುಹುವಾನು ಅಜು಼ ಭಡ್‌ಪಣ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />ಕ್ರಿಸ್ತಮ ಪವಿತ್ರಾತ್ಮಥಿ ಮಳಿನ್ ರ‍್ಹವಾನು, ಪ್ಯಾರ್‌ನ ಸಮಾಧಾನ್, ಅಜು಼ ಗೋರ್‌ನಿ ದಯಾಥಿ ಏಕ್‌ಥಿಏಕ್ ಹುಮ್ಮಖ್ಹ್‌ವಾಳ ಹುಯಿ‍ರ‍್ಹೆವೊ. <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />ತುಮೆ ಅಖ್ಖು ಎಕ್ಕಸ್ ದಿಲ್‌ವಾಳ ಹುಯಿನ್, ಎಕ್ಕಸ್ ಪ್ಯಾರ್‌ವಾಳ ಹುಯಿನ್, ಏಕ್‌ಥಿಏಕ್ ಮಳಿನ್ ರ‍್ಹಾವವಾಳ ಹುಯಿನ್ ಅಜು಼ ಎಕ್ಕಸ್ ಶುಶತ್ ರಾಖವಾಳ ಹುಯಿರಿನ್ ಮಾರಿ ಶಂತೋಖ್ಹ್‌ನ ಪೂರ ಕರೊ. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />ಇನುಯೋ ಭಡಾನಖ್ಹಾಜೆ ರ‍್ಹವೊ, ಶಿಕ್ಕೊ ಲ್ಯವಾನಖ್ಹಾಜೆ ಶಾತ್ಬಿ ನಾಕರ‍್ನುತೆ, ಹರೇಕ್ ಜ಼ಣುಬಿ ಹೇಟು ಹುವಾಳಹುಯಿನ್ ಬಿಜೇಕ್ ಜ಼ಣಾನ ಇನೇಥಿಬಿ ಊಚೊ಼ಕರಿ ದೇಖಾದೆ. <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />ತುಮಾರಮ ಹರೇಕ್‌ಜ಼ಣೊ ಖಲಿ ಇವ್ಣ ಅಛ಼್ಛಾಸ್ನ ನಾ ದೇಕ್ಣುತೆ ಬಿಜಾ಼ನು ಅಛ಼್ಛು ಹುವಾನುಬಿ ದೇಖಾದೆ. <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />ಕ್ರಿಸ್ತ ಯೇಸುಮ ಥೋತೆ ದಿಲ್‌ ತುಮಾರಮಾಬಿ ರ‍್ಹವಾದೆ.<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />ಯೋ ದೇವ್‌ನೊ ರೂಪ್‌ವಾಳೊ ಹುಯೊ,</para>
  <para style="q2" vid="PHP 2:6">ಕತೋಬಿ ದೇವ್ನಿ ಸ್ವರೂಪ್ನ ಬರೋಬರ್ ರ‍್ಹಯುತೋಬಿ ಮಹಾನ್ ಪದವಿನ ಮ್ಹೇಲುಕೊಯ್ನಿಕರಿ ಬೋಲಿನ್,<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />ಇನುಯೋಸ್ ಖಾಲಿ ಕರಿಲೀನ್</para>
  <para style="q2" vid="PHP 2:7">ದಾಸನು ರೂಪ್‍ನ ಫೇರಿಲಿನ್ ಅದ್ಮಿನಿಘೋಣಿ ದೆಖೈಲಿದೊ.<verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />ಇನೆ ಇನುಯೋಸ್ ಹೇಟು ಹುಯಿನ್ ಮರಣ್ಣಖ್ಹಾಜೆ ಕತೊ</para>
  <para style="q2" vid="PHP 2:8">ಶಿಲ್‌ಬೇನಿ ಮರಣ್ಣಾಬಿ ಛೀಮಯೆತ್ರೆ ಹೇಟೊ ಹುಯೊ.<verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />ಅನಖ್ಹಾಜೆಸ್ ದೇವ್ನೆ ಇನ ಘಣು ಊಚೊ಼ ಪಾಡ್ಯೊ ಅಜು಼</para>
  <para style="q2" vid="PHP 2:9">ಅಖ್ಖಾ ನಾಮ್‌ಥಿಬಿ ಊಚು಼ ಹುಯಿರ‍್ಹುತೆ ನಾಮ್ನ ಇನ ದಯ ಕರಿರಾಖ್ಯೊಸ್.<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />ಇನಖ್ಹಾಜೆ ಸೊರ್ಗ ಮರಣ್</para>
  <para style="q2" vid="PHP 2:10">ಪಾತಾಳ್ಮ ರ‍್ಹವವಾಳು ಖ್ಹಾರುಸ್</para>
  <para style="q2" vid="PHP 2:10">ಯೇಸುನ ನಾಮ್ಮ ಗುಡ್‌ಘ್ಯಮೇಟೆಹುಯಿನ್ ಆಡ್‍ಪಡಿನ್,<verse eid="PHP 2:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="PHP 2:11" />ಬಾ ಹುಯಿರ‍್ಹೋತೆ ದೇವ್ನಿ ಮಹಿಮೆನ ಖ್ಹಾಜೆ</para>
  <para style="q1" vid="PHP 2:11">ಯೇಸು ಕ್ರಿಸ್ತನ ಪ್ರಭುಕರಿ ಹರೇಕ್ ಅದ್ಮಿ ಕಬೂಲ್‍ ಕರ್ಶೆ.<verse eid="PHP 2:11" /></para>
  <para style="s">ಜಗತ್‌ಮ ಉಜಾ಼ಳನಿತರ ಉಜಾ಼ಖ್ಹ್‌ದ್ಯವಾನು</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />ಅಮ್ ರ‍್ಹವಾಪರ್ ಮಾರ ಪ್ಯಾರ್‌ನ ದೋಸ್ತಿವೊ, ತುಮೆ ಮಾರಿ ವಾತೇನ ಕೆದೇಬಿ ಪಾಡಿಚಾ಼ಲ್ಯತೆ ತಿಮ್ ಹಮ್ಕೇಬಿ ಪಾಡಿಚಾ಼ಲೊ. ಮೆ ತುಮಾರಮ ರ‍್ಹವಾನಿವಖ್ಹ್‌ತೆಸ್ ಖಲಿಕಾಹೆತೆ, ಮೇ ನಾ ರ‍್ಹವಾಮಾಬಿ ಘಣು ಜಾ಼ಖ್ಹತ್ ದಿಲ್ಮ ಡರ್‌ಥಿ ಕಾಪವಾಳ ಹುಯಿನ್ ತುಮಾರಿ, ತುಮಾರಿ ರಕ್ಷಣೆನ ಲೀಲೆವೊ. <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />ಶನಕತೊ ದೇವಸ್ ಇನಿಮರ್ಜಿನ ಚ಼ಲಾವ್ಣುಕರಿ ತುಮಾರಮ ಉದ್ದೇಶ್‌ನಾಬಿ ಅಜು಼ ಕೋಶಿಶ್‌ನ ಬಣಾವವಾಳೊ ಹುಯಿರೋಸ್. <verse eid="PHP 2:13" /><verse number="14" style="v" sid="PHP 2:14" />ಭಣಕ್ಣುನಾತೇಬಿ, ಆಡಫೇಡ್ ನಾ ಬೋಲ್ನುತೆ ಖ್ಹಾರು ಕರೊ. <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />ಅಮ್ ತುಮೆ ದೋಷ್‌ನಾರ‍್ಹವಾಳಬಿ ಅಜು಼ ದೇವ್ನ ಧೋಬೆಡಾದಿಲ್ನ ಲಡ್ಕಹುಯಿನ್ ಮೋಂಡ್‍ಖ್ಹಯಾಲ್‍ನ ಅಜು಼ ಪಾಪ್‌ಮ ರ‍್ಹವಾಳ ಜಗತ್ನ ಅದ್ಮಿವೊನ ಬೀಚ್ಮ ಮೈಲುಕೊಂತೆ ದೇವ್ನ ಲಡ್ಕ ಹುಯಿರ‍್ಹಿಶು.<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt"><ref loc="DEU 32:5">ಧರ್ಮೊ 32:5</ref></char></note> <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />ಅವ್ಣ ಮಹಿ ತುಮೆ ಹರೇಕ್‌ನಾಬಿ ಜಾನ್‌ರ‍್ಹವಾನು ವಚನ್ನ ವತಾಳವಾಳ ಹುಯಿರ‍್ಹಿನ್, ಜಗತ್‌ಮ ಝ಼ಮ್ಕಾನ ಶುಕ್ಕರ್‌ನಿಮತ್ ದೆಖಾವ್‌ಶು. ತುಮೆ ಅಮ್‍ಚಾ಼ಲ್ಯಾತೊ ಮಾರಿ ಸೇವೆ ಬಿಣ್‌ಫಾಯಿದಾನು ಕಾಹೆ, ಮೇ ವದೇಖ್ಹ್‌ ಪಡ್ಯೋತೆ ಫಾಯಿದೊಸ್‌ಕರಿ ಬೋಲಾನಿ ಖ್ಹರಾವ್ಣಿ ಕ್ರಿಸ್ತಾನ ದನ್ಮ ಮನಮಳ್‌ಷೆ. <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />ತುಮಾರಿ ವಿಶ್ವಾಸ್ ಕರಿ ಬಲೀನ ಕಾಣ್ಕೆಮ ದೇವ್ನ ಮೇ ಅರ್ಪಣ್‌ಕರಾಮ ಮಾರ ಲೋಹಿನ ವವ್ಹಾಡನಿತರ ಹುಯುತೋಬಿ ಮನ ಖುಷಿ, ತುಮಾರ ಜೋ಼ಡೇಬಿ ಶಂತೋಖ್ಹ್‌ ಪಡುಸ್. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />ಇಮ್ಮಸ್ ತುಮೇಬಿ ಶಂತೋಖ್ಹ್‌ ಪಡೊ, ಅಜು಼ ತುಮೆ ಮಾರ ಜೋ಼ಡೆಬಿ ಶಂತೋಖ್ಹ್‌ ಕರೊ.<verse eid="PHP 2:18" /></para>
  <para style="s">ತಿಮೊಥೆ ಅಜು಼ ಎಪಫ್ರೊದಿ</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />ಕತೋಬಿ ಪ್ರಭು ಯೇಸುನಿ ಮರ್ಜಿ ಹುಯೂತೊ ಮೆ ತಿಮೊಥೆನ ಜ಼ಲ್ದೀಥಿ ತುಮಾರಕನ ಮೋಕಲ್ನುಕರಿ ಭರೋಖ್ಹೊ ಛಾ಼. ಇನೇಥಿ ತುಮಾರಿ ಬಾರೇನಿ ಸಮಾಚಾರ‍್ನ ಖ್ಹಮ್‌ಜಿನ್‌ ಮೆ ಭಾಲ್‌ ಹುಯಿಶ್. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />ಇನಿನಿತರ ತುಮಾರು ಅಛ್ಛು಼ರ‍್ಹವಾನಿ ಬಾರೇಮ ಘಣು ಛು಼ಟಾದಿಲ್‌ಥಿ ವೇಚ಼್‌ಣೆ ಕರಾಸ್ತೆ ತಿಮ್ ಮಾರ ಜೋ಼ಡ್ಮ ಬಿಜು಼ ಖಿವೂಬಿ ಕೊಯ್ನಿ. <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />ಅಖ್ಖುಜ಼ಣು ಇವ್ಣ ಕಾಮ್‌ಪರ್ ಮಗನ್‌ ರ‍್ಹೇಸ್ ಪಣ್ಕಿ ಯೇಸು ಕ್ರಿಸ್ತನ ಕಾಮ್‌ಪರ್ ಮನ್‌ಲಗಾಡಕೊಯ್ನಿ. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />ಕತೋಬಿ ತಿಮೊಥೆನ ಯೋಗ್ಯತೆನ ತುಮೆ ಮಾಲುಮ್ ಕರಿರಾಖ್ಯಸ್. ಛಿಯ್ಯೊ ಬಾನಿ ಜೋ಼ಡ್ಮ ಕಿಮ್ಕಿ ತಿಮ್ಮಸ್ ಇನೆ ಮಾರ ಜೋ಼ಡ್ಮ ಸುವಾರ್ತೆನ ಫೈಲಾವನಖ್ಹಾಜೆ ಸೇವೆ ಕರಿರಾಖ್ಯೋಸ್ ಕರಿ ಬೋಲಾನು ತುಮುನ ಮಾಲುಮ್‌ಛಾ಼. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />ಇನಖ್ಹಾಜೆ ಮಾರಿ ಬಾರೇಮ ಚಾ಼ಲುಕರಾತೆ ಕಿಮ್‌ಹುವಾಸ್ಕಿ ಇನ ಖ್ಹಮ್‌ಜೊತೊ ತದೇಸ್‌ ತಿಮೊಥೆನ ತುಮಾರಕನ ಮೋಕ್ಲಾನ ಆಖ್ಹ್‌ ಕರುಸ್. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />ಆನಾಹುಯಿನ್ ಮೇ ಜಿನು ಒಗ್ಗೀಮಾಸ್ ಐಶ್‌ಕರಿ ಪ್ರಭುಮ ಘಟ್‍ಥಿ ವಿಶ್ವಾಸ್ ಕರಿರಾಖ್ಯೊಸ್. <verse eid="PHP 2:24" /><verse number="25" style="v" sid="PHP 2:25" />ಮಾರಿ ಜ಼ರೂರತ್ನ ಕಾಡಾನಖ್ಹಾಜೆ ತುಮೆ ಮೋಕ್‍ಲ್ಯಥಾತೆ, ಮಾರೊ ಭೈ, ಜೋ಼ಡ್ನೊ ಸೇವಕ್‌ಬಿ, ಜೋ಼ಡ್‌ನೊ ಶಿಪಾಯಿಬಿ ಹುಯಿರ‍್ಹೋಸ್ತೆ ಎಪಫ್ರೊದೀತ್‌ನ ತುಮಾರಕನ ಮೋಕ್ಲಾನು ಜ಼ರೂರತ್ ಕರಿ ಲ್ಯಾಹುಸ್. <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />ಇನೆ ತುಮಾರಿ ಬಾರೇಮ ತರ್ಖ್ಹುಕರ್ತೊಥೊ ಅಜು಼ ಯೊ ಜಾನ್ನ ಅಛ್ಛು಼ಕೊಂತೆ ಖಬರ್‌ನ ತುಮೆ ಖ್ಹಮ್‍ಜ್ಯಾತೆ ಇನಖ್ಹಾಜೆ ಯೊ ದುಖ್ ಕರಿಲಿದೊ. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />ಯೋ ರೋಗ್ಮಪಡೀನ್ ಮರನಿತರ ಥೋತೆ ಖ್ಹಾಚಾಸ್, ಕತೋಬಿ ದೇವ್ನೆಯಿನ ಗೋರ್‌ಕರ‍್ಯೊ. ಇನಾಸ್ ಖಲಿ ಕಾಹೆತೆ ಮನ ದುಖ್‌ನಪರ್ ದುಖ್ ನಾ ಆವ್ಣುತೆ ತಿಮ್ ಮನಾಬಿ ದಯಾಕರ‍್ಯೊ. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />ಇನಖ್ಹಾಜೆ ತುಮೆ ಇನ ದೇಖಿನ್ ಪಾಛು಼ ಶಂತೋಖ್ಹ್‌ ಕರ್ನುಕರಿಬಿ ಮಾರಿ ದುಖ್ ಕಮ್ ಹೋಣುಕರೀಬಿ ಮೇ ಇನ ಘಣು ತರಖ್ಹ್‌ಥಿ ಮೋಕ್ಲುಕರುಸ್. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />ಇನಖ್ಹಾಜೆ ಪ್ರಭುಮ ಭೈನಿ ಘೋಣಿ ಶಂತೋಖ್ಹ್‌ಥಿ ಸ್ವೀಕಾರ್ ಕರಿಲೆವೊ. ಎಥ್ರಾನವಾಳನ ಅದ್ಮಿವ್‌ನ ಸ್ವಾಗತ್ ಕರೊ. <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />ಅಮ್ ತುಮೇಸ್ ಮನ ಕರ್ನುತೆ ಮ್ಹೆಮಾನ್ಮ ಜ಼ರೂರತ್‌ನ ಭರಾನಖ್ಹಾಜೆ ಇನ ಜಾನ್‌ಪರ‍್ಲಿ ಆಖ್ಹ್‌ನ ಮ್ಹೆಂದಿನ್ ಕ್ರಿಸ್ತ ಯೇಸುನಿ ಸೇವೆಮ ಮರಿಗೊ.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">ಖ್ಹಾಚು಼ ನೀತಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />ಖ್ಹರ್ತಿಮ ಮಾರ ಭೇನೆ ಭೈಯೇವೊ, ಪ್ರಭುಮ ಖುಷಿಕರೊ. ಪಹಿಲೆ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊಥೋತೆ ಯೋಸ್ ವಾತೇವ್ನ ಪಾಛು಼ ತುಮುನ ಲೀಖಾನ ಮನ ಶಾತ್ಬಿ ಬೇಜಾರ್‌ಕೊಯ್ನಿ. ಆ ತುಮುನ ಘಟ್‌ಕರಸ್. <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />ಖರಾಬ್‌ ಕಾಮ್‌ಕರಾವಾಳೇಥಿ ಜತನ್‌ ರ‍್ಹವೊ, ಖ್ಹತ್ನಕರಿ ಬೋಲಿನ್ ಶರೀರ್‌ಮ ಖ್ಹಂದೊ ವ್ಹಾಡವಾಳೇಥಿ ಹೊಷಾರಿ ರ‍್ಹವೊ, ಇವ್ಣೆ ಕುತ್‌ರ‍್ಯಾನ ಸಮಾನ್ ಹುಯಿರ‍್ಹುಸ್. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />ಖ್ಹಾಚಿ ಖ್ಹತ್ನ ರ‍್ಹವಾಳು ಕೋಣ್‌ಕತೊ, ದೇವ್ನಿ ಆತ್ಮನಿ ಖ್ಹೂಜ಼್‍ಥಿ ಆರಾದನೆ ಕರವಾಳು ಅಜು಼ ಕ್ರಿಸ್ತ ಯೇಸುಮ ಖುಷಿ ಕರವಾಳುಬಿ, ಶರೀರ್‌ನಿ ಆಖ್ಹ್‌ನಿ ಬಾರೇಮ ಭರೋಖ್ಹೊ ಕೊಂತೇಬಿ ಹುಯಿರ‍್ಹಾಸ್ತೆ ಅಪ್ಣೆಸ್. <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />ಮೆತೋಬಿ ಶರೀರ್‌ನಿ ಬಾರೇಮ ಭರೋಖ್ಹೊ ಕರಾನಬಿ ಮೋಕ ಛಾ಼. ಬಿಜು಼ ಖಿವೊತೋಬಿ ಶರೀರ‍್ನಿ ಆಖ್ಹ್‌ನಿ ಬಾರೇಮ ಭರೋಖ್ಹೊ ಕರೆಜಾ಼ಯ್ ಕರಿ ಸೋಚ್ಯೊತೊ ಮೆ ಇನೇಥಿಬಿ ಜಾ಼ಖ್ಹತ್ ಇಮ್ಮಸ್ ಸೋಚೆಜಾ಼ಯ್. <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />ಪೈದಹುಯಿನ್ ಆಟ್ನ ದನ್ಮ ಮನ ಖ್ಹತ್ನಹುಯು, ಮೆ ಇಸ್ರಾಯೇಲ್‌ನು ಖಾನ್‌ದಾನ್‌ವಾಳೊ, ಬೆನ್ಯಾಮೀನ್ನು ಖೂಮ್‌ವಾಳೊ, ಅಫೂಟ್ ಇಬ್ರಿಯವಾಳೊ, ಧರ್ಮಶಾಸ್ತ್ರನಿ ನಿಘ್ಯಾಥಿ ದೇಖ್ಯೂತೆ, ಮೆ ಫರಿಸಾಯವಾಳೊ, <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />ಜಾ಼ತ್ನೊ ಅಭಿಮಾನ್ ದೇಖ್ಯೊತೊ ಮೆ ಕ್ರಿಸ್ತ ಸಬೆನ ಖ್ಹತಾವವಾಳೊ, ಧರ್ಮಶಾಸ್ತ್ರನಿ ನೀತಿನ ದೇಖ್ಯುತೊ ಮೆ ನಿರ್ದೋಷಿ. <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />ಕತೋಬಿ, ಮನ ನಫ್ಫೊಹುಯಿರ‍್ಹಾವನು ಅಖ್ಖೂಸ್ ಕ್ರಿಸ್ತನಖ್ಹಾಜೆ ಲುಕ್ಷಾನ್‌ಕರಿಸ್ ಲ್ಹಾವ್ಸ್. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />ಅತ್ರೇಸ್ ಕಾಹೆತೆ, ಮಾರೊ ಪ್ರಭು ಕ್ರಿಸ್ತಯೇಸುನ ಮಾಲುಮ್ ಕರಿಲಾವನು ಬಾರೇಮ ಘಣು ಮಹಾನ್‌ಕರಿ ಸೋಚಿನ್ ಮೆ ಅಖ್ಖಾನ ಲುಕ್ಷಾನ್‌ಕರಿಸ್ ಲ್ಹಾವ್ಸ್. ಆಹೈರೋತೆ ಇನಖ್ಹಾಜೆ ಮೆ ಖ್ಹಾರುಸ್ ಗುಮೈಲಿದೋತೆಬಿ ಯೊ ಅಖ್ಖಾನ ಕಚ್ರೊ಼ಸ್ ಕರಿ ಲ್ಹಾವ್ಸ್. <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />ಅನಾಮ ಮಾರಿ ಖ್ಹೂಜ಼್ ಶಾತ್‌ಕತೊ, ಮೆ ಕ್ರಿಸ್ತಾನ ಕಮೈಕರೀನ್, ಧರ್ಮಶಾಸ್ತ್ರನು ಫಲ್ ಹುಯಿರ‍್ಹುತೆ ಶೊಂತ್ ನೀತಿಕಾಹೆ, ಕ್ರಿಸ್ತಮ ವಿಶ್ವಾಸ್‌ಕರಾಥಿ ಮಳಾತೆ ಕತೊ ಕ್ರಿಸ್ತಪರ್‌ನಿ ವಿಶ್ವಾಸ್‌ನಿ ಆಧಾರ್‌ಥಿ ದೇವ್ ದೇಸ್ತೆ ನೀತಿನಾಸ್ ಲೀನ್ ಕ್ರಿಸ್ತಮ ರ‍್ಹೇವ್ಣುಕರಿ ಬೋಲಾನುಸ್. <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />ಇನಾಬಿ ಇನು ಪಾಛು಼ ಜಿವ್ತುಹುವಾಮ ಛಾ಼ತೆ ಶಕತ್‍ನಾಬಿ, ಇನಿ ಖ್ಹತಾಪ್ಣಿಮ ಭಾಗ್‌ಲ್ಯವಾನಿ ಪದವಿನ ಮಾಲುಮ್ ಕರಿಲಿನ್ ಇನಿ ಮರಣ್ಣಿ ಬಾರೇಮ ಇನೀನಿತರಸ್ ಹೋಣುಕರಿ ಬೋಲನುಸ್ ಮಾರಿ ಹರಖ್ಹ್ ಹುಯಿರ‍್ಹೀಸ್. <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />ಅಮ್ ಮೇಬಿ ಜಿನು ಮರಿನ್‌ ಜಿವಿಶ್‌ಕರಿ ಮಾರಿ ಭರೋಖ್ಹೊ.<verse eid="PHP 3:11" /></para>
  <para style="s">ಶುಶತ್ನ ಪೊಚಾ಼ನಖ್ಹಾಜೆ ದೌಡ್</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />ಅತ್ರಾಸ್‌ಮ ಮೆ ಆ ಅಖ್ಖಾನ ಲೀಲಿನ್‌ ಪೂರ ಹುಯಿಗೊಕರಿ ಕೊಬೋಲೂನಿ. ಕತೋಬಿ ಮೆ ಶನ ಲೇವ್ಣುಕರಿ ಕ್ರಿಸ್ತ ಯೇಸು ಮನ ಧರಿಲಿದೋಕಿ ಯೋ ಲೀಲ್ಯಾವನ ಖ್ಹಾಜೆ ಕೋಶಿಶ್ ಕರುಸ್. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />ಭೇನೆ ಭೈಯೇವೊ, ಮೇತೊ ಯೋ ಶುಶತ್ನ ಪೋಚಿರ‍್ಹೋಸ್‌ಕರಿ ಹಮ್ಕೆಲಗುಬಿ ಕೊ ಬೋಲಿರಾಖ್ಯೋನಿ. ಕತೋಬಿ ಆ ಹೈರುತೆ ಖ್ಹಾಚು಼. ಪಾಛ಼್‌ಲಿ ಬಾರೇಮ ಭೈಕಿಜೈ಼ನ್, ಮಾರೇಥಿ ಹುವಾಯೆತ್ರೆ ಖ್ಹಾಮೆ ಹುವಾಸ್ತೆ ಇನ ಧರಿಲ್ಯವಾನ ಖ್ಹಾಜೆ ಮಿಲವ್‌ಕರುಸ್. <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />ಕ್ರಿಸ್ತ ಯೇಸುಮ ದೇವ್ನ ಮಹಾನ್ ಬುಲಾವ್ಣಿಖ್ಹಾಜೆ ಇನಾಮ್ನ ಲೇವ್ಣುಕರಿ ಶುಶತ್ ಭಾಂದಿನ್ ನಾಖ್ಹುಕರೂಸ್. <verse eid="PHP 3:14" /><verse number="15" style="v" sid="PHP 3:15" />ಅಪ್ಣಾಮ ಪುರ್ಗುಲ್ ಹುಯಿರ‍್ಹವಾಳ ಖ್ಹಾರಸ್ ಜ಼ಣ ಆ ಬಾರೇಮ ಪೂರ ಹುಯಿರ‍್ಹೇವ್ಣು. ಅಜು಼ ಖಿವುತೋಬಿ ಏಕ್‌ ವಾತೆವ್ಮ ತುಮೆ ಅಲಕ್ ಸೋಚ್‌ವಾಳ ಹುಯಿರ‍್ಹಾತೊ ಇನ ದೇವ್ ತುಮುನ ವತಾಳಿ ದಿಶೆ. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />ರ‍್ಹೀನ್‌ಬಿ, ಅಪ್ಣೆ ಖಿವಿ ರೀತಿಮ ಚಾ಼ಲಿನ್ ಅತ್ರೆಲಗು ಐರ‍್ಹಾಸ್ಕಿ ಇಮ್ಮಸ್ ಚಾ಼ಲಿಯೇ. <verse eid="PHP 3:16" /><verse number="17" style="v" sid="PHP 3:17" />ಭೇನೆ ಭೈಯೇವೊ, ತುಮೆ ಅಖ್ಖು ಮಾರಿ ಜೋ಼ಡೆ ಮಳಿನ್ ಮಾರಿಜೋ಼ಡೇಥಿ ಚಾ಼ಲವಾಳ ಹುಯಿ‍ರ‍್ಹೆವೊ ಅಜು಼ ಕೋಣ್ ಬರೊಬರ‍್ನಿ ಪರಕ್ಮ ಚಾ಼ಲಸ್ಕಿ ಇನ ಖ್ಹಯಾಲ್ಮ ಲೀಲೆವೊ. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />ಶನಕತೊ ಕೈಯೆಕ್ಕಿ ಜ಼ಣು ಕ್ರಿಸ್ತನಿ ಶಿಲ್‌ಬೇನ ವಿರೋದಿ ಹುಯಿನ್ ಚಾ಼ಲಸ್. ಇವ್ಣಿ ಬಾರೇಮ ತುಮುನ ಕೆತ್ರಿಕ್ಕಿಹಲ್ಲ ಬೋಲ್ಯೊ, ಹಮ್ಕೇಬಿ ರೊಯಿನ್ ಬೋಲುಕರುಸ್. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />ಪೇಟಸ್ ಇವ್ಣು ದೇವ್, ಖ್ಹರಮ್‌ಕಾಡಾನು ಕಾಮಸ್ ಇವ್ಣುನ ಮರ್ಯಾದಿನು. ಇವ್ಣೆ ಜಗತ್ನಿ ಬಾರೇಮಸ್ ಸೋಚವಾಳು, ಅನಖ್ಹಾಜೆ ವಿನಾಶಥೀಸ್ ಇವ್ಣೆ ಖ್ಹರ್ತಿಉಷೆ. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />ಅಪ್ಣೆತೋಬಿ ಸೊರ್ಗಾನ ಪ್ರಜೆ ಹುಯಿರಾಸ್, ಅಪ್ಣೊ ಬಚಾ಼ಡವಾಳೊ ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತಸ್ ಹಿಜ಼್ಜಾಥೊ ಆವಾನು ಮ್ಹೋರೆ ದೇಖುಕರೆಸ್. <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />ಯೊ ಅಖ್ಖಾಸ್ನ ಇನ ಅಧೀನ್‌ಮ ಲೀನ್ ತಾಖತ್‌ವಾಳೊ ಹುಯಿನ್ ಅಪ್ಣ ಕಮ್‌ಜೋ಼ರ್ ಶರೀರ್‌ನ ಇನಿ ಮಹಿಮೆಥಿ ಭರೈರ‍್ಹಾವನು ಶರೀರ‍್ನಿತರ ಬದ್ಲಾವ್‌ಷೆ.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s">ಮಾಲುಮ್ ಕರಾನು</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />ಅಮ್‌ರ‍್ಹವಾಪರ್, ಮಾರ ಪ್ಯಾರ್‌ನ ಭೇನೆ ಭೈಯೇವೊ ಅಜು಼ ಸಾಥಿವೊ, ಮನ ಶಂತೋಖ್ಹ್‌ಬಿ ಕಿರೀಟ್‌ಬಿ ಹುಯಿರ‍್ಹವವಾಳವೊ, ಮೇ ಬೋಲಾನಿತರ ಪ್ರಭುಮ ಘಟ್‍ಥಿ ಭೀರ‍್ಹೆವೊ. <verse eid="PHP 4:1" /><verse number="2" style="v" sid="PHP 4:2" />ಪ್ರಭುಮ ಏಕ್‌ ದಿಲ್‌ವಾಳ ಹುಯಿರ‍್ಹೇವೊಕರಿ ಯುವೊದ್ಯನಾಬಿ ಸಂತುಕೆನ ಗಿಂಗೈಲೆವುಸ್. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />ಮಾರೊ ಖ್ಹಾಚೊ಼ ಸಾಥಿನೊ ಸೇವಕ್, ಯೊ ತಯೇಡಾವ್ನ ಮದತ್ ಹುಯಿರ‍್ಹೇವ್ಣುಕರಿ ತುನ ಬೋಲಿಲೆವುಸ್. ಇವ್ಣೆ ಜಿನು ಕ್ಲೇಮೆನ್ಸ್ ಅಜು಼ ಥೋಡ ಜೋ಼ಡ್ಮಕಾಮ್‍ ಕರವಾಳನ ಖ್ಹಮೇದ್ ಮಾರ ಜೋ಼ಡೆ ಸುವಾರ್ತೆನಖ್ಹಾಜೆ ಖ್ಹತ್ಯು. ಅವ್ಣು ನಾಮ್‌ಅಖ್ಖು ಜಾನ್ನ ಹಕ್‌ವಾಳಾನಿ ಪಟ್ಟಿಮ ಛಾ಼. <verse eid="PHP 4:3" /><verse number="4" style="v" sid="PHP 4:4" />ಕೆದೇಬಿ ಪ್ರಭುಮ ಖುಷಿಕರೊ, ಖುಷಿಲೀಲೆವೊಕರಿ ಪಾಛೊ಼ ಬೋಲುಸ್. <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />ತುಮಾರು ಖ್ಹಮಾಳಿರ‍್ಹವಾನುಬಿ, ಗೋರ್‌ಬಿ ಹರೇಕ್ ಅದ್ಮಿನಾಬಿ ಮಾಲುಮ್‌ಪಡಾದೆ, ಪ್ರಭು ಪಾಛು಼ ಆವಾನು ಲಗಾಬಗು ಹುಯಿಗು. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />ಖಿವಿ ಬಾರೇಮಾಬಿ ವೇಚ಼್‌ಣೆ ನಾಕರ‍್ನುತೆ ಅಖ್ಖೀಸ್ ವಿಚಾರ್‌ಮ ದೇವ್ನ ಖ್ಹಾಮ್ಣೆ ಧನ್ಯವಾದ್ನು ಪ್ರಾರ್ಥನೆಬಿ ಬಿಂತಿ ಕರ್ತಹುಯಿನ್ ತುಮುನ ಹೋಣುತೆಯಿನ ಪ್ರಭುನ ಖ್ಹಮ್‍ಜಾ಼ಡೊ. <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />ಅಜು಼ ತದೆ ಅದ್ಮಿನ ಖ್ಹಯಾಲ್‌ಥೀಬಿ ಭಡಿರ‍್ಹವಾನು ದೇವ್ನಿ ಶಾಂತಿ ತುಮಾರ ದಿಲ್‌ನಾಬಿ ಸೋಚ್‌ನಾಬಿ ಕ್ರಿಸ್ತ ಯೇಸುಮ ಬಚಾ಼ಡ್‌ಶೆ. <verse eid="PHP 4:7" /><verse number="8" style="v" sid="PHP 4:8" />ಕಡೇಶಿಮ ಮಾರ ಭೇನೆ ಭೈಯೇವೊ, ಖಿವು ಖ್ಹಾಚು಼ಕಿ, ನ್ಯಾವ್‌ನೂಕಿ, ಗಣ್ತಿನುಕಿ, ಪಾಕ್‌ನೂಕಿ, ಲಾಡ್ನೂಬಿ, ಖ್ಹಾಜ಼್‌ನುಬಿ ಹುಯಿರ‍್ಹುಸ್ಕಿ, ಖಿವು ಅಛ್ಛಿ ಚಾ಼ಲ್‌ಚ಼ಲಣ್‌ಬಿ, ಕೀರತ್ನ ಲ್ಹಾಯೇಕ್ಕಿ, ಯೊ ಅಖ್ಖಾನಿ ಬಾರೇಮ ಸೋಚಾವಳ ಹುಯಿ‍ರ‍್ಹೆವೊ. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />ತುಮೆ ಖಿವು ಮಾರೇಥಿ ಶಿಕಿ ಲೀರಾಖ್ಯಾಸ್ಕಿ, ಅಜು಼ ಖಿವು ಮಾರಾಮ ಖ್ಹಮ್‌ಜಿ ದೇಖಿರಾಖ್ಯಸ್ಕಿ ಇನಾಸ್ ಕರ್ತಆವೊ. ಅಮ್ ಕರ‍್ಯಾತೊ ಸಮಾಧಾನ್ನೊ ದೇವ್ ತುಮಾರ ಜೋ಼ಡೆರ‍್ಹಿಷೆ.<verse eid="PHP 4:9" /></para>
  <para style="s">ಇನಾಮ್ನಖ್ಹಾಜೆ ಧನ್ಯವಾದ್</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />ಮಾರಿ ಬಾರೇಮ ತುಮುನ ಛಾ಼ತೆ ಖ್ಹದ್ದರ್‌ ಅತ್ರದನ್ನ ಪಾರ್ ಚಿಗುರ್‌ ಮ್ಹೇಲ್ಯುತೆ ಇನಖ್ಹಾಜೆ ಮೇ ಪ್ರಭುಮ ಖುಷಿಕರುಸ್. ಅಥ್ರಾನಿ ಸೋಚ್ ತುಮಾರಮ ಆ ಪಹಿಲೆ ರ‍್ಹಿಯುಹೊತ್ತೊಬಿ, ಮದತ್ ಕರಾನ ಬರೊಬರ‍್ನಿ ವೇಳ್ ಕೊಆಯಿರ‍್ಹಿಥೀನಿ. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />ಮನ ಹೋಣುತೆ ಇನಿ ಬಾರೇಥಿ ಮೇ ಅನ ಕೋ ಬೋಲುಕರುನಿ, ಮೆ ಬೋಲ್ನುಕತೊ ಛಾ಼ತೆ ಪರಕ್ಮ ಹಕ್ಲಾಲ್‌ಥಿ ರ‍್ಹವಾನು ಶಿಕಿರಾಖ್ಯೊಸ್. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />ಗರೀಬ್ ಹುಯಿರ‍್ಹವಾನಬಿ ಮಾಲುಮ್ ಚೆಹಳ್‌ಥಿರ‍್ಹವಾನು ಮಾಲುಮ್. ಮೆ ಹಕ್ಲಾಲ್‌ಥಿ ರ‍್ಹಯೊತೋಬಿ, ಭುಕ್ಯೊ ರ‍್ಹಯೊತೋಬಿ, ಬರ್ಗತ್‌ವಾಳೊ ಹುಯುತೋಬಿ, ಕಾಯಸ್‌ಕೊಂತೆ ಹುಯೋತೊಬಿ, ಖಿವಿ ರ‍್ಹಾಮರ‍್ಹವಾಳೊ ರ‍್ಹಿಯೊತೋಬಿ ಇನು ಗಪ್ಲತ್ ಮನ ಮಾಲುಮ್. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />ಮನ ತಾಖತ್ ದ್ಯವಾಳೊ ಕ್ರಿಸ್ತಥಿ ಮೆ ಅಖ್ಖಾಸ್ನ ಕರಾನ ಶಕತ್‌ವಾಳೊ ಹುಯಿರೋಸ್. <verse eid="PHP 4:13" /><verse number="14" style="v" sid="PHP 4:14" />ಅಮ್ ರ‍್ಹಯುತೋಬಿ ತುಮೆ ಮಾರಿ ಖ್ಹತಾಪ್ಣಿ ಖ್ಹಂಗ್‌ಮಥಾತೆ ಅಛ಼್ಛುಹುಯು. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />ಅಜು಼ ಫಿಲಿಪ್ಪಿವಾಳೊ, ಮೇ ಶುರುವಾತ್ನ ತುಮಾರಮ ಸುವಾರ್ತೆನ ಪ್ರಚಾರ್ ಕರೀನ್, ಮೆಕೆದೋನ್ಯನ ಗಯೋತೆ ತದೆ ದ್ಯವಾನು, ಲ್ಯಾವಾನಿ ಬಾರೇಮ ತುಮುನ ಮ್ಹೇಲ್ಯೂತೊ ಬಿಜು಼ ಖಿವು ಸಬೇಬಿ ಮನ ಮದತ್ ಕೊದಿದೂನಿಕರಿ ತುಮುನಾಬಿ ಮಾಲುಮ್ ಛಾ಼. <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />ಮೇ ಥೆಸಲೋನಿಕಮ ಥೋತೆ ತದೇಬಿ ತುಮೆ ಏಕ್‌ ಬೇಹಲ್ಲ ಮಾರಿ ಜ಼ರೂರತ್ನಖ್ಹಾಜೆ ಮದತ್ ದಿಮೋಕ್‌ಲ್ಯಥಾನಿ. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />ಖ್ಹಾಚಮಾಬಿ ಮೆ ತುಮಾರೇಥಿ ಇನಾಮ್ ಲೇವ್ಣು ಕರಿಕಾಹೆ, ಕತೋಬಿ ಅನೇಥಿ ತುಮೆ ಚೆಹೆಳ್ ಅಜು಼ ಬರ್ಗತ್ ಹುವಾದೇಸ್ ಕರಿ ಮಾರಿ ಆಖ್ಹ್. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />ಹೋಣುತೆ ಅಖ್ಖೂಸ್ ಮನ ಛಾ಼, ಚೆಹೆಳ್ ಹುಯಿರ‍್ಹೋಸ್. ಎಪಫ್ರೊದೀತ್‌ನ ತುಮೆ ದೀನ್ ಮೋಕ್‌ಲ್ಯಾತೆ ಇನಾಮ್ ಮನ ಪೋಚಾ಼ನಿ ವಖ್ಹ್‌ತೆ ಮೆ ಭರೈನ್ ಚೆಹಳ್‌ವಾಳೊ ಹುಯಿರ‍್ಹೋಸ್. ಯೊ ತುಮಾರು ಕಾಣ್‌ಕೆ ದೇವ್ನ ಢಪ್ಕಾರ‍್ನು ವಾ ಹುಯಿರ‍್ಹುಸ್, ಯೊ ದೇವ್ನ ಲ್ಹಾಯಕ್‌ನು ಬಲಿ ಹುಯಿರ‍್ಹುಸ್. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />ಮಾರೊ ದೇವ್ ಕ್ರಿಸ್ತ ಯೇಸುಥಿ ಇನಿ ಮೋಟಿ ಮಹಿಮೆನ ಧನ್‌ದೌಲಥ್ಥಿ ತುಮುನ ಛಾ಼ತೆ ಹರೇಕ್ ಜ಼ರೂರತ್‌ನ ಪೂರ ಕರ್ಶೆ. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />ಅಪ್ಣ ಬಾ ಹುಯಿರ‍್ಹೋತೆ ದೇವ್ನ ಜ಼ಗ್‌ಜ಼ಮಾನಮಾಬಿ ಮಹಿಮೆ ಹುವಾದೆ! ಆಮೆನ್.<verse eid="PHP 4:20" /></para>
  <para style="s">ಖ್ಹರ್ತಿನಿ ಖ್ಹಲಾಮ್</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />ಕ್ರಿಸ್ತ ಯೇಸುಮ ಛಾ಼ತೆ ಹರೇಕ್ ವಿಶ್ವಾಸಿನಬಿ ಮಾರಿ ಖ್ಹಲಾಮ್ ಬೋಲೊ. ಮಾರ ಜೋ಼ಡ್ಮ ಛಾ಼ತೆ ಭೈಯೇ ಭೇನೆಬಿ ತುಮುನ ಖ್ಹಲಾಮ್ ಕರುಕರಸ್. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />ಹಜ್ಜಾ಼ ಛಾ಼ತೆ ದೇವ್ನು ವಿಶ್ವಾಸಿ ಖ್ಹಾರು ತುಮುನ ಖ್ಹಲಾಮ್ ಕರುಕರಸ್. ವಿಶೇಷ್‌ಥಿ ಕೈಸರ್‌ನು ಮಹೇಲ್‌ಮ ರ‍್ಹವಾಳುಬಿ ತುಮುನ ಖ್ಹಲಾಮ್ ಬೋಲಿರಾಖ್ಯುಸ್. <verse eid="PHP 4:22" /><verse number="23" style="v" sid="PHP 4:23" />ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತನು ವಾರ್‌ಖ್ಹೊ ತುಮಾರ ಆತ್ಮನಿ ಜೋ಼ಡೆ ರ‍್ಹವಾದೆ.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>