<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Waghri Vathe</book>
  <para style="h">ಆದಿಕಾಂಡ</para>
  <para style="toc3">ಆದಿ</para>
  <para style="toc2">ಆದಿಕಾಂಡ</para>
  <para style="toc1">ಆದಿಕಾಂಡ</para>
  <para style="mt2">ಆದಿಕಾಂಡ ಪುಸ್ತಕ</para>
  <para style="mt1">ಆದಿಕಾಂಡ ಪುಸ್ತಕ</para>
  <para style="imt">ಮಾಲುಮ್‌ ಕರಾನು</para>
  <para style="ip">ಆದಿಕಾಂಡ ಲೀಖ್ಯಾನು ಮತ್‌ಲಬ್ “ಶುರುವಾತ್‌” ಅಜು಼ ಆ ಹೈರುತೆ ಬೈಬಲ್‌ನು ಜೂ಼ನು ಒಪ್ಪಂದಾನಮ ಪಹಿಲು ಪುಸ್ತಕ್‌ ಹುಯಿರ‍್ಹುಸ್. ಆ ಹೈರುತೆ ಹಿಬ್ರುಮ “ಪಹಿಲೆಮ” ಕರಿ ಲಿಖ್ಯಾನಜೋ಼ಡೆ ಶುರುಹುವಾಸ್ ಅಖ್ಖು ಕಿಜ಼್ಜಾಥು ಆಯುಕರಿ ಬೋಲಾನು ವತಾಳಸ್. ಅಜು಼ ಅದ್ಮಿವೋನ ಜೋ಼ಡ್ಮ ದೇವ್ನಿ ವ್ಯವಹಾರ್‌ ಕಿಮ್ ಶುರುಹುಯು. ಅಜು಼ ಹಮ್ಕೆ ಪಢಂತಿಖ್ಹಾರು ಕೈಯೇಕ್‌ ಸಿಧ್ಧಾಂತ್‌ನ ಲೀರಾಖ್ಯುಸ್. ಆದಿಕಾಂಡನ ಲೀಖ್ಯೊಹುಯೊ ನತರ್ ಅದ್ಮಿಖ್ಹಾರು ಅಜು಼ ಇನ ಕೆದೆ ಲೀಖಿರಾಖ್ಯುಸ್‌ಕರಿ ಬೋಲಾನಿ ಬಾರೇಮ ಉಷೆಕರಿ ಥೋಡು ಅದ್ಮಿ ವಿಶ್ವಾಸ್ ಕರಸ್. 5-6 ನೆ ಮುಂಡಿನು ಬಿ.ಸಿ. ಮ ಜ಼ಮಾನನ ಲೀಖ್ಯಾಥಿ ಜೋ಼ಡ್‌ ಕರಿರಾಖ್ಯುಸ್. ಬಾಬಿಲೋನ್‌ಮ ಥೋಡು ಜ಼ಣು ಸ್ವೀಕಾರ್ ಕರಸ್. ಮೋಶೆನು ಆದಿಕಾಂಡ, ಇಮ್ಮಸ್ ವಿಮೋಚನಕಾಂಡ, ಯಾಜಕಕಾಂಡ, ಅರಣ್ಯಕಾಂಡ, ಅಜು಼ ಧರ್ಮೊಪದೇಶಕಾಂಡ ಲೀಖಿರಾಖ್ಯೊಸ್‌ಕರಿ ಇವ್ಣಿ ವಿಶ್ವಾಸ್. ಖ್ಹುಮಾರ್ 1300 ನತರ್ 1400 ವರಖ್ಹ್‌ನು ಬಿ.ಸಿ. ಆದಿಕಾಂಡ ಬೈಬಲ್ನು ಉಭ್‌ರ‍್ಯುತೆ ಭಾಗ್‌ನ ಮಾಲುಮ್‌ಕರಿಲ್ಯವಾನ ಖ್ಹಾಜೆ ಕ್ರಿಸ್ತವಾಳನ ಮದತ್‌ಕರಾನು ಮುಖ್ಯ ವಿಚಾರ‍್ನ ಖ್ಹಮಾಳಿರಾಖ್ಯುಸ್. ಜೂ಼ನು ಅಜು಼ ನವು ಒಪ್ಪಂದಾನ ಭೇಬಿ ಪಾಪ್ ಜಗತ್‌ಮ ಕಿಮ್ ಪೇಶ್ಯು. ಅಜು಼ ಅದ್ಮಿನು ಜ಼ರೂರತ್‌ನ ಆ ಅಪ್ಣುನ ಒತಾಳಸ್. ಆ ಹೈರುತೆ ಅದ್ಮಿನ ಬಚಾ಼ಡನು ಖ್ಹೂಜ಼್‌ನ ಜಿನು ಛೋ಼ಡಿವತಾಳಸ್. ರಕ್ಷಕ್ ಯೇಸುನಿ ಬಾರೇನು ಪಹಿಲು ಪ್ರವಾದನೆಥಿ ಅನ ದೇಖೆಜಾ಼ಯ್‌. <char style="xt"><ref loc="GEN 3:15">ಆದಿಕಾಂಡ 3:15</ref></char> ಜ಼ಮಿನ್ನ ಉಪ್ಪರ್‌ಲ್ಯು ಹಿಡಿಕ್ ದೇಖ್ಹ್‌ನ ವಾರ್‌ಖ್ಹೊ ದಿಶ್‌ಕರಿ ಅಬ್ರಹಾಮ್‌ನ ದೇವ್ನಿ ಜಿಭಾನ್‌ <char style="xt"><ref loc="GEN 12:3">ಆದಿಕಾಂಡ 12:3</ref></char>.</para>
  <para style="iot">ಕಾಡಿದೇಖೊ</para>
  <para style="io1">1. ಅಧ್ಯಾಯ <char style="ior"><ref loc="GEN 1-2">1—2</ref></char> ಮ ಬೋಲಾನಿಘೋಣಿ ದೇವ್‌ ಜಗತ್ನ ಅಜು಼ ಆದಾಮ್‌ ಅಜು಼ ಹವ್ವನ ಉಬ್‌ಜಾ಼ಯೊ.</para>
  <para style="io1">2. <char style="ior"><ref loc="GEN 3-5">3—5</ref></char> ನು ಅಧ್ಯಾಯಖ್ಹಾರು ಆದಾಮ್‌ ಅಜು಼ ಹವ್ವ ಇವ್ಣು ಪಾಪ್‌ ಅಜು಼ ಖಾನ್‌ದಾನ್ನ ಬೋಲಿವತಾಳಸ್.</para>
  <para style="io1">3. <char style="ior"><ref loc="GEN 6-9">6—9</ref></char> ಅಧ್ಯಾಯಲಗು ನೋಹ ಅಜು಼ ಮೋಟಿ ತೋಫಾನ್ನಿ ಬಾರೇಮ ಬೋಲಸ್.</para>
  <para style="io1">4. ಇನವಾರ್‌ ಆದಿಕಾಂಡ ಪುಸ್ತಕ್‌ಮ ನೋಹಾನಿ ವೇಳ್‌ ಅಜು ವೇಳ್‌ನು ಬೀಚ್‌ಮ ಶಾತ್‌ ಹುಯುಕರಿ ಬೋಲಿ ವತಾಳಸ್.</para>
  <para style="io1">5. ಅಬ್ರಹಾಮ್‌ ಬಾಬೆಲ್‌ ಗುಂಬಜ಼್‌ ಮಳಿನ್‌ ಅಧ್ಯಾಯ <char style="ior"><ref loc="GEN 10-11">10—11</ref></char> ಮ.</para>
  <para style="io1">6. ಅಧ್ಯಾಯ <char style="ior"><ref loc="GEN 12-50">12—50</ref></char> ಅಬ್ರಹಾಂ ಇನು ಕುಟುಂಬ ಅಜು಼ ಇಸ್ರೇಲ್‌ ದೇಖ್ಹ್‌ನು ಶುರುನಿ ಬಾರೇಮ. ಎ) ಅಬ್ರಹಾಮ್‌ ಅಜು಼ ಇನಿ ಬಾವಣ್‌ ಸಾರನು ಜಿವ್ಣು ಅಧ್ಯಾಯ <char style="ior"><ref loc="GEN 12-25">12—25</ref></char> ಲಗು ಛಾ಼. ಬಿ) ಇಸಾಕ್‌ ಅಜು಼ ಇನಿ ಬಾವಣ್‌ ರೆಬೆಕ್ಕನು ಜಿವ್ಣು ಅಧ್ಯಾಯ <char style="ior"><ref loc="GEN 21-28">21—28</ref></char> ಲಗು ಅಜು಼ ಇನಿ ಮರಣ್‌ ಅಧ್ಯಾಯ 35 ಮ ಬೋಲಿ ವತಾಳಿರಾಖ್ಯುಸ್. ಸಿ) ಯಾಕೋಬ್‌ನು ಜಿವ್ಣು ಇನ ಛಿಯ್ಯಾ ಅಜು಼ ಇವ್ಣೆ ಕಾನಾನ್‌ಥು ಈಜಿಪ್ಟ್‌ನ ಗಯಾತೆ. ಅಧ್ಯಾಯ <char style="ior"><ref loc="GEN 25-50">25—50</ref></char>. ಡಿ) <char style="ior"><ref loc="GEN 37-50">37—50</ref></char> ನು ಅಧ್ಯಾಯ ಯಾಕೋಬನೊ ಪಸಂದ್‌ನೊ ಛಿಯ್ಯೊ ಯೋಸೆಫ್‌ನು ಜಿವ್ಣು ಅಜು಼ ಯೊ ಕಿಮ್ ಈಜಿಪ್ಟ್‌ಮ ರಾಜ಼್‌ಭಾರ್‌ ಚ಼ಲಾವವಾಳೊ ಹುಯೊಕರಿ ಬೋಲಾನು ಛಾ಼.</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s">ಉಬ್‌ಜಾ಼ವ್ಣಿನು ಖೇಣಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />ಶುರುವಾತ್‌ಮ ದೇವ್‌ ಆಬ್‌ ಧರ್ತಿನ ಉಬ್‌ಜಾ಼ಯೊ ತದೆ, <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />ಧರ್ತಿ ಅಗ್ಗಡ್‌ದುಗ್ಗಡ್‌ಬಿ ಖಾಲಿಹುಯಿನ್‌ಬಿ ಯೊ ಅಂಧಾರೆಥಿ ಭರೈರ‍್ಹುಥು. ದೇವ್‌ನು ಆತ್ಮ ದಲ್‌ದರ‍್ಯಾವ್‌ನ ಉಪ್ಪರ್‌ ಉಡ್ತುಫಂಡ್‌ತುಥು. <verse eid="GEN 1:2" /><verse number="3" style="v" sid="GEN 1:3" />ತದೆ ದೇವ್‌ “ಉಜಾ಼ಳುಹುವಾದೆ” ಕರಿ ಬೋಲಾಮ ಉಜಾ಼ಳು ಹುಯು. <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />ದೇವ್‌ ಯೊ ಉಜಾ಼ಳನ ಅಛ್ಛು಼ಕರಿ ದೇಖ್ಯೊ. ಇನೆ ಉಜಾ಼ಳನಾಬಿ ಅಂಧಾರನಾಬಿ ಅಲಕ್‌ ಬಣಾಯೊ. <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />ಅಜು಼ ದೇವ್ನೆ ಉಜಾ಼ಳನ “ದನ್” ಕರೀಬಿ ಅಂಧಾರನ “ರಾತ್‌” ಕರೀಬಿ ನಾಮ್‌ ಮ್ಹೇಲ್ಯೊ. ಅಮ್‌ ಖ್ಹಾಂಜ಼್‌ಬಿ ವ್ಹಾಣುಬಿ ಹುಯಿನ್‌ ಪೈಲ್ಹೊದನ್‌ ಹುಯು.<verse eid="GEN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6" />ಇನಕೇಡೆಥು ದೇವ್‌ನೆ ಹೇಟ್‌ನ ಪಾಣಿನಾಬಿ ಉಪ್ಪರ್‌ಲ್ಯ ಪಾಣಿನಾಬಿ ಅಲಕ್‌ ಅಲಕ್‌ ಕರಾನ ಪಾಣಿನ ಇಚ಼್‌ಮ ಗೋಳೊ ಬಣಾದೆ ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />ಅಮ್ ದೇವ್‌ ಗೋಳಾನ ಕರೀನ್ ಇನಹೇಟ್‌ ಥೂತೆ ಪಾಣಿನ ಇನ ಉಪ್ಪರ್‌ಥೂತೆ ಪಾಣಿಥಿ ಭಾಗ್‌ ಬಣಾಯೊ. ಯೊ ಇಮ್ಮಸ್‌ ಹುಯು. <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />ಅಜು ದೇವ್‌ ಯೊ ಗೋಳಾನ “ಆಬ್‌” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲ್ಯೊ. ಅಮ್‌ ಖ್ಹಾಂಜ಼್‌ಬಿ ವ್ಹಾಣುಹುಯಿನ್ ಬೇನು ದನ್‌ಹುಯು.<verse eid="GEN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />ಇನವಾರ್ ದೇವ್‌, “ಆಬ್‌ನ ಹೇಟ್‌ಛಾ಼ತೆ ಪಾಣಿ ಅಖ್ಖುಬಿ ಎಕ್ಕಸ್ ಝ಼ಗೊ ಅಖ್ಖು ಎಕ್ಟುಹುವಾದೆ ಅಜು಼ ಖ್ಹುಕ್ಕಿ ಜ಼ಮೀನ್ ದೇಖಾವದೆ” ಕರಿ ಬೊಲ್ಯೊ. ಇಮ್ಮಸ್ ಹುಯು. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />ದೇವ್‌ ಖ್ಹುಕ್ಕಿ ಜಮೀನ್ನ “ಧರ್ತಿ” ಕರೀಬಿ ಎಕ್ಟು ಹುಯಾಹುಯ ಪಾಣಿನ “ದರ‍್ಯಾವ್‌” ಕರೀಬಿ ನಾಮ್‌ ಮ್ಹೇಲ್ಯೊ. ದೇವ್ನ ಡೋಳಾಮ ಯೊ ಅಛ್ಛು಼ ದೆಖಾಯು. <verse eid="GEN 1:10" /><verse number="11" style="v" sid="GEN 1:11" />ಇನವಾರ್ ದೇವ್‌ನೆ, “ಧರ್ತಿಪರ್ ಘಾಖ್ಹ್‌ನ, ಅನಾಜ಼್‌ನಿ ಶೋಶಿಯೇವ್ನ, ಪಂಡುಪಲಾರ ಮ್ಹೇಲಾತೆ ಅಖ್ಖಿಥರಾನು ಝಾ಼ಡು ಫುಟ್‌ವಾದೆ” ಕರಿಬೋಲ್ಯೊ. ಇಮ್ಮಸ್ ಹುಯು. <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />ಧರ್ತಿಪರ್ ಅಖ್ಖಿಥರಾನು ಶೋಶಿಖ್ಹಾರು ಫುಟ್ಯು. ಪಂಡು ಮ್ಹೇಲಾನು ಝಾ಼ಡಅಖ್ಖುಬಿ ದೆಖಾಯು. ಇವ್ಣಿ ಇವ್ಣಿ ಜಾತ್ನಿ ಪರಕ್ಮ ಪಂಡರ‍್ಹವಾನು ಫಲ್‌ನು ಝಾ಼ಡು ಫುಟ್ಯು. ಯೋಅಖ್ಖು ದೇವ್ನ ಡೋಳಾಮ ಅಛ್ಛು಼ ದೆಖಾಯು. <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />ಅಮ್‌ ಖ್ಹಾಂಜ಼್‌ಬಿ ವ್ಹಾಣುಹುಯಿನ್ ತೀನ್ನೊ ದನ್‌ಹುಯು.<verse eid="GEN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />ಇನಕೇಡೆಥು ದೇವ್ನೆ ಆಬ್‌ಮ ದನ್‌ಥು ರಾತ್ನ ಅಲಕ್ ಕರಾನಖ್ಹಾಜೆ ಆಬ್‌ಮ ಉಜಾ಼ಳು ದೆಖಾವದೆ ಅಜು ಯೋಅಖ್ಖು ದನ್ ವರಖ್ಹ್ ಹಗಾಮ್‌ನಾಬಿ ವತಾಳನು ಖ್ಹಣೇದ್ ಹುಯಿರ‍್ಹವಾದೆ. <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />ಅಜು಼ ಧರ್ತಿನ ಉಪ್ಪರ್ ಉಜಾ಼ಳು ದ್ಯವಾನ ಯೋಖ್ಹಾರು ಆಬ್‌ಪರ್ ಉಜಾ಼ಖ್ಹ್‌ ದ್ಯವಾದೆ, ಕರಿಬೋಲ್ಯೊ. ಇಮ್ಮಸ್‌ಹುಯು. <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />ದನ್ನ ಚ಼ಲಾವನ ಚಾಂದ್‌ನಾಬಿ ರಾತ್ನ ಚ಼ಲಾವನ ಚಂದರ್‌ಮನಾಬಿ ಉಬ್‌ಜಾ಼ಯೊ. ಅಜು ಶುಕ್ಕರ್‌ಜಿನು ದೇವ್ನೆ ಉಬ್‌ಜಾ಼ಯೊ. <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />ದೇವ್‌ನೆ ಯೊ ಉಜಾ಼ಳನ ಆಬ್‌ಮ ಧರ್ತಿಪರ್ ಉಜಾ಼ಳು ದ್ಯವಾನ, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />ದನ್‌ರಾತ್‌ನ ಚ಼ಲಾವನಾಬಿ, ಅಜು ಉಜಾ಼ಳನಾಬಿ ಅಂಧಾರನ ಅಲಕ್ ಅಲಕ್‌ ಕರಾನ ದೇವ್ನೆ ಮ್ಹೇಲ್ಯೊ. ತದೆ ಇನೆ ಯೊ ಅಖ್ಖಾನ ಅಛ್ಛು಼ಕರಿ ದೇಖ್ಯೊ. <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />ಅಮ್‌ ಖ್ಹಾಂಜ಼್ ವ್ಹಾಣುಹುಯಿನ್ ಚಾರ್‌ನೊ ದನ್‌ಹುಯು.<verse eid="GEN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />ಇನಕೇಡೆಥು ದೇವ್‌ನೆ, ಕೈಯೇಕ್‌ಥರಾನು ಪಾಣಿನು ಜ಼ಂತ್ ಪಾಣಿಮ ಭರೈಜಾ಼ವಾದೆ; ಜಿನಾವರ್‌ಖ್ಹಾರು ಆಬ್‌ಮ ಉಡಾದೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />ಅಮ್ ದೇವ್‌ನೆ ಜಾ಼ಖ್ಹತ್ ಪಾಣಿನ ಜಿವಾನು ನ್ಹಾನ ಮೋಟ ಖ್ಹಾರಿಸ್ ಥರಾನ ಜ಼ಂತ್‌ನಾಬಿ ಉಬ್‌ಜಾ಼ಯೊ. ಅಜು಼ ಹರೇಕ್‌ಥರಾನು ಜಿನಾವರ್‌ನಾಬಿ ಇವ್ಣಿ ಜಾ಼ತ್ನಿ ಪರಕ್ಮ ಉಬ್‌ಜಾ಼ಯೊ. ತದೆ ಇನೆ ಯೊ ಅಖ್ಖಾನ ದೇಖಖ್ಹತರ್ ದೇವ್ನ ಘಣು ಖ್ಹುಷಿಹುಯು. <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />ಆ ನಾಹುಯಿನ್ ದೇವ್ನೆ, “ಪಾಣಿಮ ಛಾತೆ ಜೀವಿಅಖ್ಖು ಭಡಿನ್ ಜಾ಼ಖ್ಹತ್‌ಹುಯಿನ್ ದರ‍್ಯಾವ್ನ ಪಾಣಿಮ ಭರಾವದೆ, ಅಜು ಜಿನಾವರ್‌ಬಿ ಜಾ಼ಖ್ಹತ್ ಹುವಾದೆ” ಕರಿ ಬೋಲಿನ್‌ ಆಶೀರ್ವಾದ್‌ ದಿದೊ. <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />ಅಮ್‌ ಖ್ಹಾಂಜ಼್ ವ್ಹಾಣುಹುಯಿನ್ ಪಾಚ಼್‌ನೊ ದನ್ ಹುಯು. <verse eid="GEN 1:23" /><verse number="24" style="v" sid="GEN 1:24" />ಇನಕೇಡೆಥು ದೇವ್ನೆ, “ಧರ್ತೀಮಾಥು ಉಬ್‌ಜ್ಯುತೆ ಖ್ಹಾರು ಉಬ್‌ಜಾ಼ದೆ; ಪಾಳನು ಜಾನ್ವರ್‌, ಕೀಡ್‌ಕಮ್‌ಟು, ಝಾಡಿನು ಜಾನ್ವರ್‌ಖ್ಹಾರು, ಇನಿ ಇನಿ ಜಾ಼ತ್ನಿ ಪರಕ್‌ ಪೈದಹುವಾದೆ” ಕರಿ ಬೊಲ್ಯೊ. ಇಮ್ಮಸ್‌ ಹುಯು. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />ದೇವ್‌ನೆ, ಅಖ್ಖಿತರಾನು ಜಾನ್ವರ್‌ನಾಬಿ ಜ಼ಮೀನ್‌ಪರ್ ವ್ಹವಾವಾಳು ಕೀಡ್‌ಕಮ್‌ಟವ್‌ನಾಬಿ ತಿನಿತಿನಿ ಜಾ಼ತ್ನಿ ಪರಕ್‌ ಉಬ್‌ಜಾ಼ಯೊ. ತದೆ ಇನೆ ಯೊ ಅಖ್ಖಾನ ಅಛ್ಛು಼ಕರಿ ದೇಖ್ಯೊ. <verse eid="GEN 1:25" /><verse number="26" style="v" sid="GEN 1:26" />ಇನಪಾರ್‌ ದೇವ್ನೆ, “ಅಪ್ಣ ಶೊಂತ್‌ ರೂಪ್‌ಮ ಅಪ್ಣಿನಿ ಘೋಣಿನು ಅದ್ಮಿನ ಉಬ್‌ಜೈ಼ಯೆ. ಇವ್ಣೆ ದರ‍್ಯಾವ್‌ಮಾನು ಮಾಚ್ಲ‌ಪರ್‌ಬಿ, ಅಭಾಳ್‌ಮ ಉಡಾತೆ ಜಿನಾವರ್‌ ಪರ್‌ಬಿ ಪಾಳಾತೆ ಜಾನ್ವರ್‌ ಪರ್‌ಬಿ ಜ಼ಮೀನ್‌ಪರ್ ವ್ಹವವಾಳು ಖ್ಹಾರುಸ್‌ ಕೀಡ್‌ಕಮ್‌ಟ ಪರ್‌ಬಿ, ಖ್ಹಾರಿಸ್ ಧರ್ತಿಪರ್‌ಬಿ ರಾಜ಼್ ಚ಼ಲಾವಾದೆ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 1:27" />ಅಮ್‌ ದೇವ್‌ನೆ; ಅದ್ಮಿನ ಇನಿ ಶೊಂತ್‌ರೂಪ್‌ಮ ಉಬ್‌ಜಾ಼ಯೊ.</para>
  <para style="q1" vid="GEN 1:27">ಇನಿ ಶೊಂತ್‌ರೂಪ್‌ಮ ಉಬ್‌ಜಾ಼ಯೊ.</para>
  <para style="q1" vid="GEN 1:27">ಇವ್ಣುನ ಪರ್‌ಖ್ಹೊ ತಯೇಡ ಕರಿ ಉಬ್‌ಜಾ಼ಯೊ.<verse eid="GEN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 1:28" />ಆ ನಾಹುಯಿನ್ ದೇವ್‌ನೆ ಇವ್ಣುನ ಆಶೀರ್ವದ್, “ತುಮೆ ಘಣು ಪಿಳ್ಗಿವಾಳು ಹುಯಿನ್ ಧರ್ತಿಮ ಫೈಲೈನ್ ಇನ ಕಬ್‌ಜ಼ ಕರಿಲೆವೊ. ದರ‍್ಯಾವ್‌ನ ಮಾಚ್ಲಪರ್‌ಬಿ ಖ್ಹಾರೂಸ್ ಜಿನಾವರ್‌ಪರ್‌ಬಿ ಜಾನ್ವರ್‌ಪರ್‌ಬಿ ರಾಜ಼್‌ಚ಼ಲಾವೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 1:28" /><verse number="29" style="v" sid="GEN 1:29" />ಆ ನಾಹುಯಿನ್ ದೇವ್ನೆ, “ಹಂದೇಖೊ, ಧರ್ತಿಪರ್‌ಛಾ಼ತೆ ಖ್ಹಾರಿಸ್ ಥರಾನು ಪಂಡುದ್ಯವಾನು ಅನಾಜ಼್‌ನಾಬಿ ಪಂಡುದ್ಯವಾನು ಫಲ್ನ ಝಾ಼ಡ್‌ನಾಬಿ ತುಮೂನ ಖಾವನಖ್ಹಾಜೆ ದೀರಾಖ್ಯೋಸ್. <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />ಅತ್ರೇಸ್ ಕಾಹೆತೆ ಧರ್ತಿಪರ್ ಫರ್ತುಫಂಡಾತೆ ಜಾನ್ವರ್‌, ಆಬ್‌ಪರ್‌ ಉಡಾವಾಳು ಜಿನಾವರ್‌ಖ್ಹಾರು ಜ಼ಮೀನ್‌ಪರ್‌ ವ್ಹವವಾಳು ಕೀಡ್‌ಕಮ್‌ಟುಖ್ಹಾರು ಅಜು಼ ಕೈಏಕ್ ಜ಼ಂಗ್‌ಳಿ ಜಾನ್ವವರ್‌ನ ಖಾಣಾನಖ್ಹಾಜೆ ಭಾಜಿಪಾಲೊಖ್ಹಾರು ದೀರಾಖ್ಯೋಸ್” ಕರಿ ಬೊಲ್ಯೊ. ಯೊ ಇಮ್ಮಸ್ ಹುಯು. <verse eid="GEN 1:30" /><verse number="31" style="v" sid="GEN 1:31" />ದೇವ್‌ ಇನೆ ಉಬ್‌ಜಾ಼ಯೋತೆ ಅಖ್ಖಾಸ್ನ ದೇಖಾಖ್ಹತರ್ ಯೊ ಅಖ್ಖೂಸ್ ಘಣು ಅಛ್ಛು಼ ದೆಖಾಯು. ತದೆ ಖ್ಹಾಂಜ಼್ ವ್ಹಾಣುಹುಯಿನ್ ಛೋ಼ನೆ ದನ್‌ಹುಯು.<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />ಅಮ್‌ ಆಬ್‌ ಧರ್ತಿಖ್ಹಾರು ಯೊ ಅಖ್ಖಾಮ ಛಾ಼ತೆ ತಮಾಮಸ್ ಬಣಾವಟ್‌ಹುಯು. <verse eid="GEN 2:1" /><verse number="2" style="v" sid="GEN 2:2" />ದೇವ್‌ನೆ ಇನು ಉಬ್‌ಜಾ಼ವ್ಣಿನು ಕಾಮ್ನ ಖ್ಹತಮ್‌ಕರೀನ್ ಖ್ಹಾತ್‌ನ ದನ್‌ಮ ಅರಾಮ್‌ಕರ‍್ಯೊ. <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />ದೇವ್‌ನೆ ಇನು ಉಬ್‍ಜಾ಼ವ್ಣಿನ ಕಾಮ್ನ ಖ್ಹತಮ್‌ಕರಾನ ಬಾದ್‌ಮ ಖ್ಹಾತ್‌ನ ದನ್‌ಮ ಅರಾಮ್‌ಕರ‍್ಯೋತೆ ಇನಖ್ಹಾಜೆ ಯೊ ದನ್ನ ಪರಿಶುದ್ ದನ್ ಹುಯಿರ‍್ಹವಾದೆಕರಿ ಆಶೀರ್ವಾದ್‌ ಕರ‍್ಯೊ. <verse eid="GEN 2:3" /><verse number="4" style="v" sid="GEN 2:4" />ಯೆಹೋವ ದೇವ್‌ ಆಬ್‌ಧರ್ತಿನ ಬಣಾವಟ್ ಕರ‍್ಯೊತೆ ಖೇಣಿ ಆಸ್.</para>
  <para style="s" vid="GEN 2:4">ಏದೆನ್ ಬಗಿಚೋ಼</para>
  <para style="p" vid="GEN 2:4">ಯೆಹೋವ ದೇವ್‌ ಆಬ್‌ಧರ್ತಿನ ಉಬ್‌ಜಾ಼ವಾನಿ ವಖ್ಹ್‌ತೆ, <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />ತದೆ ಶನಿ ಥರಾನು ಝಾ಼ಡುಬಿ ಧರ್‌ತಿಮ ಕೋಥೂನಿ. ಶನಿ ಶೋಶಿಬಿ ಮೋಡ್‌ಕೊ ಪಾಡ್ಯುಥು ಕೊಯ್ನಿ. ಶನಕತೊ ಯೆಹೋವ ದೇವ್‌ ಧರ್ತಿಪರ್ ಪಾಣಿ ವರ್‌ಖ್ಹಾಯೋಥೊ ಕೊಯ್ನಿ. ಜಮೀನ್ನ ನಾಗ್ರಾನ ಅದ್ಮಿಬಿ ಕೋಥೂನಿ. <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />ಕತೋಬಿ ಧರ್ತಿಮಾಥು ಪಾಣಿನು ಚೇಜ಼್‌ಭಾರೊ ಉಕ್ಳಿನ್ ಉಪ್ಪರ್ ಅಯಿನ್ ಜ಼ಮೀನ್ ಅಖ್ಖು ಭಿಗಾವ್‌ತುಥು. <verse eid="GEN 2:6" /><verse number="7" style="v" sid="GEN 2:7" />ಅಮ್‌ರ‍್ಹಾವಪರ್‌ ಯೆಹೋವ ದೇವ್‌ ಜ಼ಮಿನ್ನಿ ಮಾಟಿಥಿ ಅದ್ಮಿನ ಉಬ್‌ಜೈ಼ನ್ ಇನ ನಾಕ್‌ಮ ಜಾನ್ನ ವಹಿರಾನ ಫುಕ್ಯೊ. ತದೆ ಯೊ ಜಿವವಾಳೊ ಅದ್ಮಿಹುಯೊ. <verse eid="GEN 2:7" /><verse number="8" style="v" sid="GEN 2:8" />ಆ ನಾಹುಯಿನ್ ಯೆಹೋವ ದೇವ್‌ ಪೂರಬ್‌ ದಿಕ್ಮ ಛಾ಼ತೆ ಏದೆನ್ ತಬರ್‌ಖಾಮ ಏಕ್‌ ಬಗೀಚಾ಼ನ ಉಬ್‌ಜೈ಼ನ್ ಇನೆ ಬಣಾವಟ್ ಕರ‍್ಯೊತೆ ಅದ್ಮಿನ ಇನಾಮ ರ‍್ಹಾವನಿತರ ಕರ‍್ಯೊ. <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />ಇನವಾರ್‌ ಯೆಹೋವ ದೇವ್‌ನೆ ದೇಖಾನ ಶನ್‌ಗಾರ್‌ನುಬಿ, ಖಾವಾನ ರುಚ್‌ ರ‍್ಹಾವಾನು ಖ್ಹಾರೀಸ್‍ ಥರಾನು ಝಾ಼ಡಾವ್‌ನ ಯೊ ಜ಼ಮೀನ್‌ಪರ್‌ ಫುಟಾನಿತರ ಕರ‍್ಯೊ. ಯೊ ನಾಹುಯಿನ್ ಯೊ ಬಗೀಚಾ಼ನ ಇಚ಼್‌ಮ ಜಾನ್‌ದೇವಾನು ಝಾ಼ಡನಬಿ ಅಛ್ಛಾ಼ನು ಖರಾಬ್‌ನು ಅಕ್ಕಲ್ ದೆವವಾಳು, ಝಾ಼ಡನಬಿ ಫೋಡಾಯೊ. <verse eid="GEN 2:9" /><verse number="10" style="v" sid="GEN 2:10" />ಏದೆನ್ ತಬರ್‌ಖಾಮ ಏಕ್‌ ನದ್ದಿ ಉಬ್‌ಜಿನ್ ಯೊ ಬಗೀಚಾ಼ನ ಭಿಗಾವ್‌ತುಥು. ಯೊ ಹಿಜ್ಜಾ಼ಥು ಚಾರ್‌ ಭಾಗ್‌ಹುಯಿನ್ ಫುಟ್‌ಪಡಿರ‍್ಹೂಥು. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />ಪಹಿಲಿ ನದ್ದಿನು ನಾಮ್‌ ಪೀಶೋನ್‌, ಯೊ ಖ್ಹೊನ್ನು ಮಳಾನು ಹವೀಲ ದೇಖ್ಹ್‌ಅಖ್ಖು ಫರಿನ್ ವ್ಹವಾಸ್. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />ಯೊ ತಬರ್‌ಖಾನು ಖ್ಹೊನ್ನು ಘಣಾ ಮೋಲ್‌ನು ಹುಯಿರ‍್ಹೂಸ್. ಹಿಜ್ಜಾ಼ ಬದೋಲಖ ಖ್ಹಾಲರ‍್ಯೊ, ಗೋಮೇಧಿಕನು ಘಣಾಮೋಲ್‌ನು ಕಾಕ್ರೊ ಮಳಸ್. <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />ಬೇನು ನದ್ದಿನು ನಾಮ್‌ ಗಿಹೋನ್‌, ಯೊ ಕೂಷ್‌ ದೇಖ್ಹ್‌ನ ಫರೀನ್ ವ್ಹವಾಸ್. <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />ತೀನ್ನಿ ನದ್ದಿನು ನಾಮ್‌ ಟೈಗ್ರೀಸ್; ಯೊ ಅಶ್ಯೂರ್‌ ದೇಖ್ಹ್‌ನು ಪೂರಬ್‌ ದಿಕ್‌ಭಣಿ ವ್ಹವಾಸ್. ಚಾರ್‌ನು ಯೂಫ್ರೇಟೀಸ್‌ ನದ್ದಿ. <verse eid="GEN 2:14" /><verse number="15" style="v" sid="GEN 2:15" />ಯೆಹೋವ ದೇವ್‌ ಯೊ ಅದ್ಮಿನ ಬುಲೈಲೀಜೈ಼ನ್ ಏದೆನ್ ಬಗೀಚಾ಼ನ ನಾಗ್ರನಾಬಿ ಕಾವಲ್‌ಕರನಾಬಿ ಇನಾಮ ರಾಖ್ಯೊ. <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />ಆ ನಾಹುಯಿನ್ ಯೆಹೋವ ದೇವ್‌ನೆ ಯೊ ಅದ್ಮಿನ, “ತೂ ಬಗೀಚಾ಼ಮ ಛಾ಼ತೆ ಖ್ಹಾರಸ್ ಝಾ಼ಡ್‌ಣ ಫಲ್ನ ಕೆತ್ರೂಬಿ ಖಾಯೆಜಾ಼ಯ್. <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />ಕತೋಬಿ ಅಛ್ಛಾ಼ನು ಖರಾಬ್‌ನು ಖ್ಹಯಾಲ್‌ ದ್ಯವಾಳು ಆ ಝಾಡ್‌ನು ಫಲ್ನ ನಾಖಾವ್ಣು. ಖೈಶ್‌ತೆ ದನ್ನೆಸ್ ಮರಿಜೈಶ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 2:17" /><verse number="18" style="v" sid="GEN 2:18" />ಆ ಹುವಾದಿನ್ ಯೆಹೋವ ದೇವ್‌ನೆ, “ಅದ್ಮಿ ಎಕೆಲೋ ರ‍್ಹವಾನು ಅಛ್ಛು಼ಕಾಹೆ, ಇನ ಬರೋಬರ್‌ನಿ ಜೋ಼ಡ್‌ವಾಳಿನ ಬಣಾವುಸ್‌” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 2:18" /><verse number="19" style="v" sid="GEN 2:19" />ಅಮ್‌ ಯೆಹೋವನೆ ಖ್ಹಾರುಸ್‌ ಧರ್ತಿನು ಜ಼ಂತ್‌ನಾಬಿ ಆಬ್‌ನು ಜಿನಾವರ್‌ನಾಬಿ, ಜ಼ಮೀನ್ನಿ ಮಾಟಿಥಿ ಉಬ್‌ಜೈ಼ನ್ ಆ ಅಖ್ಖಾನ ಅದ್ಮಿ ಖಿವುಖಿವು ನಾಮ್‌ ಮ್ಹೇಲಸ್ಕಿ ದೇಖ್ಯೆಕರಿ ಇನಾಕನ ಆವಾಖ್ಹರ್‌ಕು ಕರ‍್ಯೊ. ಅದ್ಮಿನೆ ಏಕೇಕ್‌ ಜಾನ್ವರ್‌ನ ಖೆವುಖೆವು ನಾಮ್‌ ಮ್ಹೇಲ್ಯೋಕಿ ಯೋಸ್ ಯೊ ಅಖ್ಖಾನು ನಾಮ್‌ಹುಯು. <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />ಅಮ್ ಯೊ ಅದ್ಮಿನೆ ಖ್ಹಾರೂಸ್ ಜಾನ್ವರ್‌ನಾಬಿ, ಆಬ್‌ನು ಜಿನಾವರ್‌ನಾಬಿ, ಝಾ಼ಡೀನು ಜಾನ್ವರ್‌ನಾಬಿ, ನಾಮ್ ಮ್ಹೇಲ್ಯೊ. ಕತೋಬಿ ಇನ ಬರೋಬರ್‌ನು ಜೋ಼ಡು ಮಳ್ಯುಕೊಯ್ನಿ. <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />ಅಮ್‌ರ‍್ಹಾವಪರ್‌ ಯೆಹೋವ ದೇವ್‌ನೆ ಯೊ ಅದ್ಮಿನ ಭರ್‌ನಿಂದರ್‌ ಆವಾನಿಘೋಣಿ ಕರಿನ್ ಇನಿ ಪಾಖ್ಹ್‌ಳಿಯೆಮಾಥು ಏಕ್‌ನ ಕಾಡಿಲೀನ್ ಯೊ ಝ಼ಗೋಮ ಬೋಟಿಥಿ ಮೂಚ಼್‌ಯೊ. <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />ಯೆಹೋವನೆ ಅದ್ಮಿಥಿ ಕಾಡ್ಯೋತೆ ಪಾಖ್ಹ್‌ಳಿನ ತಯೇಡಕರಿ ಬಣೈನ್, ಇನ ಯೊ ಅದ್ಮಿಕನ ಬುಲೈಲೀನ್ ಆಯೊ. <verse eid="GEN 2:22" /><verse number="23" style="v" sid="GEN 2:23" />ತದೆ ಇನೆ ಯೊ ತಯೇಡನ ದೇಖಿನ್, “ಹಮ್ಕೆ ಬರೋಬರ್‌ ಆ ಹೈರಿತೆ ಮಾರಿ ಹಡ್ಕೇಥಿ ಐತೆ ಹಡ್‌ಕ್ಯು, ಮಾರಿ ಬೋಟಿಥಿ ಐತೆ ಬೋಟಿ ಹುಯಿರ‍್ಹೀಸ್. ಆ ಹೈರಿತೆ ಅದ್ಮಿಥಿ ಉಬ್‌ಜೀತೆ ಇನಖ್ಹಾಜೆ ತಿರಿಯಕರಿ ಬೋಲೈಲಿಶೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 2:23" /><verse number="24" style="v" sid="GEN 2:24" />ಇನಖ್ಹಾಜೆ ಪರ್ಖ್ಹೊ ಆಯ ಬಾನ ಮ್ಹೇಲಿನ್ ಇನಿ ಬಾವಣ್ಣ ಮಳಿಜಾ಼ಸ್ ಇವ್ಣೆ ಬೇಜ಼ಣ ಎಕ್ಕಸ್ ಶರೀರ್‌ ಹುಯಿರ‍್ಹೇಸ್. <verse eid="GEN 2:24" /><verse number="25" style="v" sid="GEN 2:25" />ಯೊ ಅದ್ಮಿ ಅಜು಼ ಇನಿ ಬಾವಣ್‍ ಉಘಾಡ ರ‍್ಹಯತೋಬಿ ಖ್ಹರ್‌ಮಾಯಕೊಯ್ನಿ.<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">ಅದಮ್‌ಜಮಾನನು ಅವಿಧೇಯತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />ಯೆಹೋವ ದೇವ್‌ ಉಬ್‌ಜಾ಼ಯೋತೆ ಖ್ಹಾರುಸ್ ಜಾನ್ವರ್‌ಮ ಖ್ಹಾಪ್‌ ಘಣು ಠಗಾರು ಹುಯಿರ‍್ಹುಥು. ಖ್ಹಾಪ್‌ ಯೊ ತಯೇಡಾಕನ ಆಯಿನ್, “ಶಾತ್‌ಲಿಬಾಯಿ ಬಗೀಚಾ಼ಮ ಛಾ಼ತೆ ಖೆವಾ ಝಾ಼ಡ್‌ಣ ಫಲ್ನ ತುಮೆ ನಾ ಖಾವ್ಣುಕರಿ ದೇವ್‌ ಹುಕುಮ್‌ ದೀರಾಖ್ಯೊತೆ ಖ್ಹಾಚಿಸ್‌?” ಕರಿ ಬೋಲ್ಯು. <verse eid="GEN 3:1" /><verse number="2" style="v" sid="GEN 3:2" />ಯೊ ತಯೇಡನೆ ಖ್ಹಾಪ್‌ನ, “ಬಗೀಚಾ಼ಮ ಛಾ಼ತೆ ಖ್ಹಾರಸ್ ಝಾ಼ಡ್ನ ಫಲ್ನ ಖಯೆಜಾ಼ಯ್‌; <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />ಕತೋಬಿ ಬಗೀಚಾ಼ನ ಇಚ಼್‌ಮ ಛಾ಼ತೆ ಯೊ ಝಾ಼ಡ್‌ಣ ಫಲ್‌ನಿ ಬಾರೇಮ, ‘ತುಮೆ ಇನ ಖಾವ್ಣುಬಿ ನಾ, ಛೀಮ್‌ಣೂಬಿ ನಾ, ಖಾದಾತೊ ಮರಿಜಾ಼ಶು’ ಕರಿ ದೇವ್‌ನೆ ಬೋಲಿರಾಖ್ಯೊಸ್” ಕರಿಬೋಲಿ. <verse eid="GEN 3:3" /><verse number="4" style="v" sid="GEN 3:4" />ತದೆ ಖ್ಹಾಪ್‌ನೆ ತಯೇಡನ, “ತುಮೆ ಖ್ಹಚಂಬಿ ಮರ್‌ಶುಕೊಯ್ನಿ. <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />ತುಮೆ ಆ ಫಲ್ನ ಖಾದಾತೊ ತದ್ನುತದೆಸ್ ತುಮಾರ ಡೋಳ ಉಖ್‌ಡಾವ್‌ಶೆ. ತುಮೆ ದೇವ್‌ನಿತರ ಹುಯಿಜಾ಼ಶು ಅಜು಼ ಅಛ್ಛು಼ ಅಜು಼ ಖರಾಬ್‌ನು ಪರಕ್‌ನ ಮಾಲುಮ್‌ ಕರಿಲಿಶು, ಆ ದೇವ್ನ ಮಾಲುಮ್‌” ಕರಿಬೋಲ್ಯು. <verse eid="GEN 3:5" /><verse number="6" style="v" sid="GEN 3:6" />ತದೆ ತಯೇಡನೆ ಯೊ ಝಾಡ್‌ನು ಫಲ್‌ ಖಾವಾನ ಅಛ಼್ಛುಬಿ, ದೇಖಾನ ಖ್ಹಾಜ಼್‌ನುಬಿ, ಅಕ್ಕಲ್ ಆವಾಖ್ಹರ್‌ಕುಬಿ ಛಾ಼ಕರಿ ಮಾಲುಮ್‌ಕರಿನ್ ಯೊ ಫಲ್ನ ಲೀನ್ ಖಾದಿ, ಅಜು಼ ಇನ ಬಾವ್ರಿನ ದ್ಯಾವಖ್ಹತರ್‌ ಇನೇಬಿ ಖಾದೊ. <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />ತದ್ನುತದೇಸ್ ಇವ್ಣೆ ಭೇಜ಼ಣ ಉಘಾಡ ಛಿಯ್ಯೆಕರಿ ಮಾಲುಮ್‌ಕರಿನ್ ಗುಲ್ಲರ್ನ ಪಾಲನ ವಣಿನ್ ಇನ ಕಂಬರ್‌ನ ಲಪೇಟಿಲಿದ. <verse eid="GEN 3:7" /><verse number="8" style="v" sid="GEN 3:8" />ತದೆ ಯೆಹೋವ ದೇವ್‌ ಖ್ಹಾಂಜ಼್‌ನ ಠಂಡಾ ವಹಿರಾಮ ಬಗೀಚಾ಼ಮ ಚಾ಼ಲ್ಯೊಫಂಡಾನಿ ವಖ್ಹ್‌ತೆ ಯೊ ಅದ್ಮಿ ಅಜು಼ ತಯೇಡ ಇನು ಅವಾಜ಼್‌ನ ಖ್ಹಮ್‌ಜಿನ್ ಇನ ದೆಖಾವ್ಣು ನಾಕರಿ ಬಗೀಚಾ಼ನ ಝಾ಼ಡಾವ್‌ನ ಇಚ಼್‌ಮ ಲಪಿಗಯ. <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />ತದೆ ಯೆಹೋವ ದೇವ್ನೆ ಅದ್ಮಿನ ಚಿಕ್ರೀನ್, “ತೂ ಕಿಜ್ಜಾ಼ ಛಾ಼?” ಕರಿ ಪುಛಾ಼ಯೊ. <verse eid="GEN 3:9" /><verse number="10" style="v" sid="GEN 3:10" />ಇನಖ್ಹಾಜೆ ಇನೆ, “ತೂ ಬಗೀಚಾ಼ಮ ಚಾ಼ಲ್ಯೊಫಂಡಾನಿ ಅವಾಜ಼್‌ ಖ್ಹಮ್‌ಜಿನ್, ಉಘಾಡೊ ಹುಯಿರ‍್ಹೊಥೋತೆ ಇನಖ್ಹಾಜೆ ಡರಿನ್‌ ಮೇ ಲಪಿಗಯೊ” ಕರಿ ಜ಼ವಾಬ್‌ದಿದೊ. <verse eid="GEN 3:10" /><verse number="11" style="v" sid="GEN 3:11" />ತದೆ ದೇವ್‌ನೆ, “ತೂ ಉಘಾಡೊ ಛಾ಼ಕರಿ ತುನ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯುತೆ ಕೋಣ್‌? ಖಾವ್ಣುನಾಕರಿ ಮೇ ತುನ ಹುಕುಮ್‌ ಕರ‍್ಯೊತೆ ಝಾ಼ಡ್‌ಣ ಫಲ್ನ ಖಾದೊಕಿಶು?” ಕರಿ ಪುಛಾ಼ಯೊ. <verse eid="GEN 3:11" /><verse number="12" style="v" sid="GEN 3:12" />ತದೆ ಯೊ ಅದ್ಮಿನೆ, “ಮಾರಿ ಜೋಡ್ಮ ರ‍್ಹಾವಾನಖ್ಹಾಜೆ ತುನೆ ದಿದೋತೆ ಆ ತಯೇಡನೆ, ಯೊ ಝಾ಼ಡ್‌ಣ ಫಲ್ನ ಮನ ದಿದಿ, ಮೇ ಖಾದೊ” ಕರಿ ಜ಼ವಾಬ್‌ದಿದೊ. <verse eid="GEN 3:12" /><verse number="13" style="v" sid="GEN 3:13" />ಯೆಹೋವ ದೇವ್‌ನೆ ಯೊ ತಯೇಡನ, “ಆ ಶಾತ್ ತುನೆ ಕರೀತೆ?” ಕರಿ ಪುಛಾ಼ವದೀನ್, ಯೊ ತಯೇಡ, “ಖ್ಹಾಪ್‌ನೆ ಮನ ಠಗಾಯು, ಮೇಖಾದಿ ಕರಿ ಜ಼ವಾಬ್‍ದಿದಿ.<verse eid="GEN 3:13" /></para>
  <para style="s">ದೇವ್ನೆ ತೀರ್ಪ್‌ ಬೋಲ್ಯೊತೆ</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />ತದೆ ಯೆಹೋವ ಹುಯಿರೋತೆ ದೇವ್‌ ಖ್ಹಾಪ್‌ನ “ತೂ ಆ ಕಾಮ್‌ ಕರ‍್ಯೋತೆಖ್ಹಾಜೆ ತುನ ನಿಶತ್ ಮಳ್‌ಶೆ. ಅಜು ಖ್ಹಾರಾಸ್ ಜಾನ್ವರ್‌ಮಾಬಿ, ಶಾಪ್‌ಲ್ಯವಾಳೊ ಹುಯಿರ‍್ಹಿನ್, ತೂ ಪೇಟ್‌ಥಿ ಘಶೀನ್‌ ತಾರು ಜಿಂದಗಿನು ದನ್‌ಖ್ಹಾರು ಧೂಳಸ್ ಖೈಷ್. <verse eid="GEN 3:14" /><verse number="15" style="v" sid="GEN 3:15" />ತುನಾಬಿ, ಆ ತಯೇಡನಾಬಿ, ತಾರಿ ಪಿಳ್ಗಿನಾಬಿ ಆ ತಯೇಡಾನಿ ಪಿಳ್ಗಿನಾಬಿ, ದುಷ್‌ಮನ್ ರ‍್ಹವಾನಿಘೋಣಿ ಕರುಸ್. ಹೈರೀತೆನಿ ಪಿಳ್ಗಿ ತಾರ ಮುಡ್‌ಕ್ಯಾನ ಝ಼ಗದ್‌ಶೆ. ತೂ ಇನಿ ಏಡಿನ ಕಲ್ಡಿಶ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 3:15" /><verse number="16" style="v" sid="GEN 3:16" />ಇನಕೇಡೆಥು ಯೊ ತಯೇಡನ, “ಮೇತಾರಿ ಜ಼ಣತ್‌ನ ದರದ್‌ನ ಜಾ಼ಖ್ಹತ್ ಭಡೈಶ್. ತೂ ಅಜಾ಼ಥಿ ಲಡ್ಕಾವ್ನಬಿ ಜ಼ಣಿಶ್. ಬಾವ್ರಿಪರ್‌ ತುನ ಹರಖ್ಹ್‌ರ‍್ಹಿಶೆ, ಕತೋಬಿ ಇನಿ ದಾಬುಕ್‌ಮ ರ‍್ಹಿಶ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 3:16" /><verse number="17" style="v" sid="GEN 3:17" />ಯೊ ಹುವಾದಿನ್ ಯೊ ಪರ್ಖ್ಹಾನ, “ಖಾವ್ಣುನಾಕರಿ ಮೇ ತುನ ಹುಕುಮ್‌ ಕರ‍್ಯೊತೆ ಝಾ಼ಡ್ನ ಫಲ್ನ ತಾರಿ ಬಾವಣ್ಣಿ ವಾತೆ ಖ್ಹಮ್‌ಜಿನ್ ತೂ ಖಾದೋತೆ ಇನಖ್ಹಾಜೆ, ಧರ್ತಿಬಿ ಶಾಪ್‌ಮ ಪಡಿಗು. ತಾರಿ ಜಿಂದಗಿಪೂರ ವದೇಖ್ಹ್‌ಪಡೀನ್ ತಾರ ಪೇಟ್ನ ಜಿವ್‌ಣಾನ ಖ್ಹಾಜೆ ರಾಬಿನ್ ಧರ್ತಿನು ಪಿಕಾವ್ಣಿನ ಖಾವ್ಣು. <verse eid="GEN 3:17" /><verse number="18" style="v" sid="GEN 3:18" />ಯೊ ಧರ್ತಿಮ ಕಾಟನಝಾ಼ಡಬಿ ಶತ್ತೆ ಘಣು ಫುಟ್‌ಶೆ, ಖೆತರ್‌ನು ಪಿಕಾವ್ಣಿಖ್ಹಾರು ತುನ ಖಾಣುಹುಯಿರ‍್ಹಿಶೆ. <verse eid="GEN 3:18" /><verse number="19" style="v" sid="GEN 3:19" />ತೂ ಪಾಛೋ಼ ಮಾಟಿಮ ಮಳಾಲಗು ಪಶೂನೊ ರಂಚ಼್‌ತೊ ಹುಯಿನ್ ಹೋಣುತೆ ಖಾಣನ ಕಮಾವ್ಣು. ತೂ ಮಾಟಿಥಿ ತಯಾರ್ ಹುಯಿರ‍್ಹೋತೆ ಇನಖ್ಹಾಜೆ ತೂ ಪಾಛೊ಼ ಮಾಟಿಮಸ್ ಪೇಖ್ಹಿಷ್.” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 3:19" /><verse number="20" style="v" sid="GEN 3:20" />ಆದಾಮ್‌ನೆ ಇನಿ ಬಾವಣ್ಣ “ಹವ್ವಕರಿ ನಾಮ್‌ ಮ್ಹೇಲ್ಯೊ. ಇನಖ್ಹಾಜೆ ಅದ್ಮಿ ಬಚಿರ‍್ಹಾವಾಳ ಯೋಸ್ ಶುರುವಾತ್ನಿ ಆಯ ಹುಯಿರ‍್ಹೀಸ್. <verse eid="GEN 3:20" /><verse number="21" style="v" sid="GEN 3:21" />ಯೆಹೋವ ದೇವ್ನೆ ಆದಾಮ್‌ನಾಬಿ ಇನಿ ಬಾವಣ್ಣಾಬಿ ಜಾನ್‌ವಾರ್‌ನ ಚಾ಼ಂಬ್ಡಾನು ಪೆರ್ವಾಖ್ಹ್‌ ಬಣೈನ್ ಫೇರಾಯೊ.<verse eid="GEN 3:21" /></para>
  <para style="s">ಆದಾಮ್ ಹವ್ವನ ಬಗಿಚಾ಼ಥಿ ಭಾರ್‌ನಾಖ್ಯುತೆ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />ಯೆಹೋವ ದೇವ್ನೆ, “ಆ ಅದ್ಮಿ ಅಛ್ಛಾ಼ನು ಅಜು಼ ಖರಾಬ್‌ನು ಪರಕ್ ಮಾಲುಮ್‍ಕರ‍್ಲಿನ್ ಅಪ್ಣಾಮ ಎಕ್ ಹುಯಿಗೊ. ಅನಖ್ಹಾಜೆ ಆ ಜಾನ್ನಝಾ಼ಡ್‌ನು ಫಲ್ನ ಖೈನ್‍ ಜಿವವಾಳು ನಾಹೋಣು” ಕರಿ ಹುಕುಮ್‌ ಕರ‍್ಯೊ. <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />ಇನಖ್ಹಾಜೆ ಯೆಹೋವನೆ ಇನ ಉಬ್‌ಜಾ಼ಯೊತೆ ಮಾಟಿನಾಸ್ ನಾಗ್ರಾನಖ್ಹಾಜೆ ಇನ ಏದೆನ್ ಬಗೀಚಾ಼ಮಾಥು ಭಾರ್‌ ಮೋಕ್ಲಿದಿದೊ. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />ಅಮ್‌ ಇನೆ ಅದ್ಮಿನ ಭಾರ್‌ ನಾಖಿನ್, ಜಾನ್ನ ಝಾ಼ಡ್‌ಕನ ಜಾ಼ವನಿ ವಾಟ್ನ ಕಾವ್ಲಿಕರಾನಖ್ಹಾಜೆ, ಏದೆನ್ ಬಗಿಚಾ಼ನು ಪೂರಬ್‌ ದಿಕ್ಮ ಕೆರೂಬಿಖ್ಹಾರನಬಿ, ಅಖ್ಖೀಸ್ ಬಾಜು಼ಮ ಧಗ್‌ಧಗ್‌ ಬಳಾನಿ ಝ಼ಲ್‌ಪಟ್‌ನಿ ತಲ್ವಾರ್‌ನ ಮ್ಹೇಲ್ಯೊ.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">ಕಾಯಿನ ಅಜು಼ ಹೇಬೆಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />ಆದಾಮ್ ಇನಿ ಬಾವಣ್‍ ಹವ್ವನ ಮಳ್‌ವಾಮ ಯೊ ಬೇಜೂನಿಹುಯಿನ್ ಛಿಯ್ಯಾನ ಜ಼ಣೀನ್, “ಮೇ ಯೆಹೋವನ ಮದತ್‌ಥಿ ಕಾಯಿನನ ಜ಼ಣಿಲಿದಿ” ಕರಿಬೋಲಿ. <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />ಇನಕೇಡೆಥು ಹವ್ವ ಹೇಬೆಲಕರಿ ಬಿಜೇಕ್ ಜ಼ಣಾನ ಜ಼ಣಿ. ಹೇಬೆಲ ಮೇಂಢಾನ ಕಾವಲ್ ಕರಾವಳೊ ಬಣ್ಯೊ. ಕಾಯಿನ ನಾಗ್ರವಾಳೊ ಬಣ್ಯೊ. <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />ಥೋಡದನ್ನ ಬಾದ್‌ಮ ಕಾಯಿನನೆ ಖೆತರ್‌ನು ಪಿಕಾವ್ಣಿಮ ಥೋಡು ಲಯಿನ್ ಯೆಹೋವಕನ ಕಾಣ್ಕೆ ಲಾಯೊ. <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />ಹೇಬೆಲಬಿ ಇಮ್ಮಸ್ ಇನ ಮಂಧಾಮಾಥು ಫೈಲೊಟು ಮೇಂಢಾವ್ನ ಲಯಿನ್ ರ‍್ಹೇಶಿನ್ ಇನ ಮತ್ತಾ ಭಾಗ್ನ ಢಪ್ಕಾರ ದಿದೊ, ಯೆಹೋವನೆ ಹೇಬೆಲನಾಬಿ ಇನಿ ಕಾಣ್ಕೆನಾಬಿ ಪಸಂದ್‌ ಕರ‍್ಯೊ. <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />ಕತೋಬಿ ಕಾಯಿನನಾಬಿ ಇನಿ ಕಾಣ್ಕೆನಾಬಿ ಪಸಂದ್‌ ಕರ‍್ಯೊಕೊಯ್ನಿ. ಇನಖ್ಹಾಜೆ ಕಾಯಿನನೆ ಜಾ಼ಖ್ಹತ್ ಇರಾದೊಕರ‍್ಯೊ. ಇನು ಮ್ಹೋಡು ಇರಾದೇಥಿ ಲಾಲ್‌ಹುಯಿನ್‌ ಕಂಬ್‌ಲೈಗಯು. <verse eid="GEN 4:5" /><verse number="6" style="v" sid="GEN 4:6" />ತದೆ ಯೆಹೋವನೆ ಕಾಯಿನನ, “ತೂ ಇರಾದೊ ಕರ‍್ಯೊತೆ ಶನ? ತಾರು ಮ್ಹೋಡು ಕಂಬ್‌ಲೈಗೂತೆ ಶನ? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />ತೂ ಅಛ್ಛು಼ಕಾಮ್‌ ಕರ‍್ಯೊಹೊತ್ತೊ ತಾರು ಮುಡ್‌ಕ್ಯು ಉಪ್ಪರ್ ಪಡಾಯುಹೊತ್. ಪಾಪ್ ತುನ ಇನ ಕಬ್‌ಜಾ಼ಮ ರಾಖನ ಕರುಕರಸ್. ಕತೋಬಿ ತೂ ಇನ ಕಬ್‌ಜಾ಼ಮ ರಾಕ್ಣು” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 4:7" /><verse number="8" style="v" sid="GEN 4:8" />ಇನಕೇಡೆಥು ಕಾಯಿನನೆ ಇನೊ ನ್ಹಾನೊಭೈ ಹೇಬೆಲನ, “ಆವ್ ಅಪ್ಣೆ ಖೇತ್ರೆ ಜಿಯೆ” ಕರಿ ಬುಲಾಯೊ. ಖೇತ್ರೆ ಆವಖ್ಹತರ್‌ ಕಾಯಿನನೆ ಇನ ಭೈಪರ್‌ ಪಡೀನ್ ಇನ ಮಾರಿನಾಖ್ಯೊ. <verse eid="GEN 4:8" /><verse number="9" style="v" sid="GEN 4:9" />ಯೆಹೋವನೆ ಕಾಯಿನನ, “ತಾರೊ ನ್ಹಾನೊಭೈ ಹೇಬೆಲ ಕ್ಯಾ?” ಕರಿ ಬೋಲಖ್ಹತರ್‌ ಇನೆ, “ಮನ ಮಾಲುಮ್‌ಕೊಯ್ನಿ, ಮಾರ ನ್ಹಾನಭೈನ ಕಾವಲ್ ಕರಾವಾಳೊ ಮೇ‍ಕಿಶು? ಕರಿ ಜ಼ವಾಬ್‌ದಿದೊ. <verse eid="GEN 4:9" /><verse number="10" style="v" sid="GEN 4:10" />ಇನ ಯೆಹೋವನೆ, “ತೂ ಶಾತ್ ಕರ‍್ಯೊತೆ? ತಾರ ನ್ಹಾನಭೈನು ಲ್ಹೋಯಿ ರದನ್‌ಕರಿನ್‌ ಜ಼ಮೀನ್‌ಥು ಮನ ಫುಕಾರುಕರಸ್‌. <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />ಹಮ್ಕೆ ತೂ ತಾರ ಹಾತೆಥಿ ರಂಚ್ಯೋತೆ ತಾರ ನ್ಹಾನಭೈನು ಲ್ಹೋಯಿನ ಪೀದುತೆ ಆ ಜ಼ಮೀನ್‌ಥಿ ಹಮ್ಕೆ ತಾರಪರ್‌ ಶಾಪ್ ಆಯು. <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />ತೂ ಧರ್ತಿನ ನಾಗ್‍ರ್ಯೊತೋಬಿ. ಯೊ ಅನಪಾರ್ ತುನ ಫಲ್‍ಕೋದಿಶೆನಿ, ತೂ ಧರ್ತಿಪರ್ ಘರ್‌ಕೊಂತೆ ಡುಂಡ್ವವವಾಳೊ ದ್ರೋಹಿಹುಯಿರಿಶ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 4:12" /><verse number="13" style="v" sid="GEN 4:13" />ತದೆ ಕಾಯಿನನೆ ಯೆಹೋವನ, “ಆ ನಿಶತ್‌ನು ಫಲ್ ನಾ ಖ್ಹಮಾಳಯೆತ್ರು ಹುಯಿರ‍್ಹುಸ್. <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />ಹಂದೇಕ್‌, ತೂ ಆ ಜ಼ಮಿನ್‌ಥು ಅಜು ತಾರಿ ಸನ್ನಿಧಿಕಂಥು ಮನ ನಖ್ಹಾಡಿದಿದೊನಿ! ಮೇ ಧರ್ತಿಮ ಘರ್‌ಕೊಂತೆ ವನ್‍ವನ್‍ತೊಫಂಡಾನು ಉಷೆ. ಅಜು಼ ಕೋಣ್‌ತೊಬಿ ಮನ ದೇಖವಾಳು ಮಾರಿನಾಕ್‌ಶೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 4:14" /><verse number="15" style="v" sid="GEN 4:15" />ಕತೋಬಿ ಯೆಹೋವನೆ, “ಕೋಣ್‌ತೋಬಿ ತಾರ ಜಾನ್ನ ಕಾಡವಾಳಾನ ಖ್ಹಾತ್‍ಪಟ್ ಎತ್ರು ನಿಶತ್‍ಉಶೆ” ಕರಿ ಬೊಲ್ಯೊ. ಕಾಯಿನನ ದೇಖವಾಳುಖ್ಹಾರು ಮಾರಿನಾಕ್ಣುನಾತೆ ತಿಮ್ ಯೆಹೋವನೆ ಇನಾಪರ್ ಎಕ್ ಖ್ಹಣೇದ್ ಕರ‍್ಯೊ. <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />ತದೆ ಕಾಯಿನನೆ ಯೆಹೋವನ ಖ್ಹಾಮ್ಣೆ ಥೊ ನಿಕ್ಳಿನ್ ಏದೆನ್‍ನು ಪೂರಬ್ ದಿಕ್‍ಮಾಥು <note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="ft" closed="false">ನೋದ್‌ಕತೊ ಡುಂಡ್ವಾವನೊ ಮುಲಕ್ </char></note>‘ನೋ‍ದ್’ ಕರಿ ಮುಲಕ್‌ಮ ರ‍್ಹಯೊ.<verse eid="GEN 4:16" /></para>
  <para style="s">ಕಾಯಿನನು ಪಿಳ್ಗಿವಾಳು</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />ಕಾಯಿನ ಇನಿ ಬಾವಣ್ಣ ಮಳ್‌ವಾಮ ಯೊ ಬೇಜೂನಿ ಹುಯಿನ್ ಹನೋಕ್‌ನ ಜ಼ಣಿ. ಆ ನಾಹುಯಿನ್ ಕಾಯಿನನೆ ಏಕ್‌ ಗಾಮ್‌ಭಾಂದಿನ್ ಇನ ಹನೋಕ್‌ಕರಿ ಇನ ಛಿಯ್ಯಾನು ನಾಮ್ನಸ್ ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />ಹನೋಕ್‌ಥಿ ಈರಾದ ಕರಿ ನಾಮ್ನೊ ಛಿಯ್ಯೊ ಪೈದಹುಯೊ. ಈರಾದಥಿ ಮೆಹೂಯಾಯೇಲ ಪೈದಹುಯೊ; ಮೆಹೂಯಾಯೇಲಥಿ ಮೆತೂಷಾಯೇಲ ಪೈದಹುಯೊ; ಮೆತೂಷಾಯೇಲನೆ ಲೆಮೆಕನ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 4:18" /><verse number="19" style="v" sid="GEN 4:19" />ಲೆಮೆಕನೆ ಆದಾ, ಝಿಲ್ಲಾಕರಿ ಬೇಬಾವ್ಣೇನ ವ್ಯಹಾಕರಿಲಿದೊ. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />ಆದಾನೆ ಯಾಬಾಲನ ಜ಼ಣಿ; ಡೇರಮ ಜಿವ್ಣುಕರಿನ್ ಢಾಂಡಬೋಕ್ಡಾನ ಪಾಳವಾಳನ ಶುರುನೊ ಪರ್ಖ್ಹೊ ಆಸ್. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />ಇನ ನ್ಹಾನಭೈನು ನಾಮ್ ಯೂಬಾಲ; ಆ ತಂತಿನುವಾಜು಼ ಅಜು಼ ವಾಖ್ಹ್‌ಳಿ ವಜಾ಼ಡವಾಳನೊ ಶುರುನೊ ಪರ್ಖ್ಹೊ ಹುಯಿರ‍್ಹೊಸ್‌. <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />ಝಿಲ್ಲಾಕರಿ ಬೋಲವಾಳಿನೆ ತೂಬಲ್ ಕಾಯಿನನ ಜ಼ಣಿ. ಆಹೈರೋತೆ ಲ್ಹೋಡು ಅಜು಼ ಕಂಚ್‌ನು ಜಿನಖ್ಹ್‌ ಬಣಾವವಾಳು ಕೋಲ್‍ಮಿವಾಳನ ಶುರುನೊ ಪರ್ಖ್ಹೊ. ತೂಬಲ್‌ ಕಾಯಿನಾನು ಭೇನ್ನು ನಾಮ್ ನಯಮಾ. <verse eid="GEN 4:22" /><verse number="23" style="v" sid="GEN 4:23" />ಲೆಮೆಕನೆ ಇನಿ ಬಾವ್ಣೇವ್ನ ಅಮ್ ಬೊಲ್ಯೊ “ಆದಾ, ಝಿಲ್ಲಾ ಮಾರಿವಾತ್ನ ಖ್ಹಂಜೊ; ಮನ ಘಾವ್‍ಕರ‍್ಯುತೆ ಎಕ್ ಅದ್ಮಿನ ಮಾರಿನಾಖ್ಯೊ; ಮನ ಮಾರ‍್ಯುತೆ ಎಕ್ ಜ಼ವಾನಿನ ಮೆ ಮಾರಿನಾಖ್ಯೊ. <verse eid="GEN 4:23" /><verse number="24" style="v" sid="GEN 4:24" />ಕಾಯಿನನ ಮಾರಿನಾಖವಾಳನ ಖ್ಹಾತ್‍ಪಟ್ ಪಾಛು಼ ನಿಶತ್ ಆವಾನು ರ‍್ಹಯುತೊ, ಲೆಮೆಕನ ಮಾರವಾಳನ ಖ್ಹಾತ್‌ಉಪ್ಪರ್ ಖ್ಹಡ್‌ತೀನಿಖ್ಹ್‌ ಎತ್ರೆ ನಿಶತ್ ಮಳ್‌ಷೆ ಕೊಯ್ನಿಕಿಶು?” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 4:24" /></para>
  <para style="s">ಸೇತ್ ಅಜು಼ ಎನೋಷ್</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />ಆದಾಮ್‌ ಪಾಛೋ಼ ಇನಿ ಬಾವಣ್ಣಾ ಮಳ್‌ವಾಮ ಇನೆ ಛಿಯ್ಯಾನ ಜ಼ಣಿನ್, “ಕಾಯಿನನೆ ಮರ್‌ನಾಖ್ಯೊತೆ ಹೇಬೆಲನ ಬದಲ್‍ ದೇವ್ನೆ ಮನ ಬಿಜೇಕ್ ಛಿಯ್ಯಾನ ದಿದೊ” ಕರಿ, ಯೊ ಲಡ್ಕಾನ “ಸೇತ್” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲಿ. <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />ಇನವಾರ್ ಸೇತ್‌ನಾಬಿ ಎಕ್ ಛಿಯ್ಯೊಹುಯೊ. ಇನ, “ಎನೋಷ್” ಕರಿ ನಾಮ್ ಮ್ಹೇಲ್ಯೊ. ತಪ್‌ಥು ಅದ್ಮಿಯೆವ್ನೆ, “ಯೆಹೋವ” ಕರಿ ನಾಮ್ನ ಬೋಲಿನ್ ಆರಾದನೆ ಕರಾನ ಶುರುಕರ‍್ಯು.<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">ಆದಾಮ್‍ನಿ ಪಿಳ್ಗಿ</para>
  <para style="r">(<ref loc="1CH 1:1-4">1. ಪೂರ್ವ 1:1-4</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />ಆದಾಮ್‌ನಿ ಪಿಳ್ಗಿನಿ ಪಟ್ಟಿ: ದೇವ್ನೆ ಉಬ್‍ಜಾ಼ವ್ಣಿನ ಹಗಾಮ್ಮ ಅದ್ಮಿನ ಇನೀನಿ ಘೋಣಿಸ್ ಉಬ್‌ಜಾ಼ಯೊ. <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />ಇವ್ಣುನ ಪರ್‌ಖ್ಹೊ ಅಜು಼ ತಯೇಡ ಕರಿ ಬಣಾಯೊ. ಅಜು ಇವ್ಣುನ ಆಶೀರ್ವಾದ್‌ ಕರೀನ್ “ಅದ್ಮಿ” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲ್ಯೊ, <verse eid="GEN 5:2" /><verse number="3" style="v" sid="GEN 5:3" />ಆದಾಮ್‌ ಏಕ್‌ಖ್ಹೊ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳೊ ಹುವಾದಿನ್, ರೂಪ್‍ಮ ಇನಿನಿಘೋಣಿನೊ ಛಿಯ್ಯಾನ ಪೈದಕರೀನ್ ಇನ ಸೇತ ಕರಿ ನಾಮ್‌ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />ಇನಕೇಡೆಥು, ಆದಾಮ್‌ನೆ ಪರ್‌ಖ್ಹೊ ಅಜು಼ ತಯೇಡ ಲಡ್ಕಾವ್ನ ಪೈದಕರೀನ್ ಆಟ್‍ಖ್ಹೊ ವರಖ್ಹ್ ಬಚ್ಯೊ. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />ಅಮ್ ಆದಾಮ್‌ನೆ ಒಟ್‌ ನವ್‌ಖ್ಹೊ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್ ಬಚಿನ್ ಇನ ಪಾಛ಼ಳ್ ಮರ‍್ಯೊ. <verse eid="GEN 5:5" /><verse number="6" style="v" sid="GEN 5:6" />ಸೇತನೆ ಎಖ್ಹೊ ಪಾಚ಼್ ವರಖ್ಹ್‌ವಾಳೊ ಹುವಾದಿನ್, ಎನೋಷನ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />ಎನೋಷ ಪೈದಹುವಾನ ಬಾದ್ಮ ಸೇತನೆ ಪರ್ಖ್ಹೊ ತಯೇಡ ಲಡ್ಕಾನ ಪೈದಕರೀನ್ ಅಟ್‌ಖ್ಹೊ ಖ್ಹಾತ್ ವರಖ್ಹ್‌ ಬಚ್ಯೊ. <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />ಅಜು ಸೇತನೆ ಒಟ್‌ ನೌಖ್ಹೋ ಭಾರ ವರಖ್ಹ್‌ ಬಚೀನ್ ಇನಪಾಛ಼ಳ್‌ ಮರ‍್ಯೊ. <verse eid="GEN 5:8" /><verse number="9" style="v" sid="GEN 5:9" />ಎನೋಷ್‌ ಖ್ಹಡ್‌ಚಾರಿಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳೊ ಹುವಾದಿನ್ ಕೇನಾನನ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />ಕೇನಾನ ಪೈದಹುವಾನ ಬಾದ್ಮ ಎನೋಷ್‌ ಪರ್ಖ್ಹೊ ಅಜು಼ ತಯೇಡ ಲಡ್ಕಾವ್ನ ಪೈದಕರೀನ್‌ ಆಟ್‌ಖ್ಹೋ ಪಂಧ್ರಾವರಖ್ಹ್‌ ಬಚ್ಯೊ಼. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />ಎನೋಷ್ ಒಟ್‌ ನೌಖ್ಹೋ ಪಾಚ಼್‌ವರಖ್ಹ್‌ ಬಚೀನ್ ಇನ ವಾರ್ ಮರ‍್ಯೊ. <verse eid="GEN 5:11" /><verse number="12" style="v" sid="GEN 5:12" />ಕೇನಾನ ಖ್ಹಡ್‌ತೀನ್‌ಖ್ಹ್‌ ವರಖ್ಹ್‌ ಹುವಾನ ಬಾದ್ಮ, ಮಹಲಲೇಲ ಕರಿ ಛಿಯ್ಯೊ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />ಮಹಲಲೇಲ ಪೈದಹುವಾದಿನ್ ಕೇನಾನನೆ ಅಜೂ಼ಬಿ ಲಡ್ಕಾವ್ನ ಪೈದಕರೀನ್‌ ಆಟ್‌ಖ್ಹೋ ಚಾ಼ಳಿಖ್ಹ್‌ ವರಖ್ಹ್‌ ಬಚ್ಯೊ. <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />ಕೇನಾನನೆ ಒಟ್‌ ನೌಖ್ಹೋ ದಖ್ಹ್‌ ವರಖ್ಹ್‌ಮ ಮರ‍್ಯೊ. <verse eid="GEN 5:14" /><verse number="15" style="v" sid="GEN 5:15" />ಮಹಲಲೇಲ ಪಾಚ಼್‌ಉಪ್ಪರ್‌ ತೀನಿಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳೊ ಹುವಾನ ಬಾದ್ಮ ಯೆರೆದನ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />ಯೆರೆದ ಪೈದಹುವಾದಿನ್ ಮಹಲಲೇಲನೆ ಪರ್ಖ್ಹೊ ಅಜು಼ ತಯೇಡ ಲಡ್ಕಾವ್ನ ಪೈದಕರೀನ್‌ ಆಟ್ ಖ್ಹೋ ಡೋಡೀಖ್ಹ್‌ ವರಖ್ಹ್‌ ಬಚ್ಯೊ. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />ಮಹಲಲೇಲನೆ ಒಟ್‌ ಆಟ್‌ಖ್ಹೋ ಪಾಚ಼್ಉಪ್ಪರ್‌ ಖ್ಹಡ್‌ಚಾರೀಖ್ಹ್ ವರಖ್ಹ್ ಬಚೀನ್ ಇನವಾರ್ ಮರ‍್ಯೊ. <verse eid="GEN 5:17" /><verse number="18" style="v" sid="GEN 5:18" />ಯೆರೆದ ಏಕ್‌ಖ್ಹೊ ಬೇಉಪ್ಪರ್‌ ತೀನಿಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳೊ ಹುವಾನ ಬಾದ್ಮ ಹನೋಕನ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />ಹನೋಕ ಪೈದಹುವಾದಿನ್ ಯೆರೆದ ಆಟ್‌ಖ್ಹೊ ವರಖ್ಹ್‌ ಬಚಿರ‍್ಹೊ. ಅಜು಼ ಇನ ಲಡ್ಕಾಥ. <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />ಯೆರೆದ ಒಟ್‌ ನೌಖ್ಹೋ ಬೇಉಪ್ಪರ್‌ ತೀನಿಖ್ಹ್‌ ವರಖ್ಹ್‌ ಬಚಿರ‍್ಹೀನ್ ಇನವಾರ್ ಮರ‍್ಯೊ. <verse eid="GEN 5:20" /><verse number="21" style="v" sid="GEN 5:21" />ಹನೋಕ ಪಾಚ಼್ಉಪ್ಪರ್‌ ತೀನಿಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳೊ ಹುಯಿನ್ ಮೆತೂಷೆಲಹನ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />ಮೆತೂಷೆಲಹ ಪೈದಹುವಾದಿನ್ ಹನೋಕನೆ ಪರ್ಖ್ಹೊ ಅಜು಼ ತಯೇಡ ಲಡ್ಕಾವ್ನ ಪೈದಕರೀನ್‌ ದೇವ್ನಿ ಗಳ್‌ಜೋ಼ಡ್ಮ ರ‍್ಹೀನ್ ತೀನ್‌ಖ್ಹೊ ವರಖ್ಹ್‌ ಬಚ್ಯೊ. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />ಹನೋಕ ಬಚ್ಯೋತೆ ಒಟ್‌ ಹಗಾಮ್ ತೀನ್‌ಖ್ಹೊ ಪಾಚ಼್‌ಉಪ್ಪರ್‌ ತೀನಿಖ್ಹ್‌ ವರಖ್ಹ್‌. <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />ಹನೋಕ ದೇವ್ನಿ ಗಳ್‌ಜೋ಼ಡ್ಮ ರ‍್ಹೀನ್ ಜಿವ್ಣು ಕರ್ತೊರ‍್ಹವಾನಿ ವಖ್ಹ್‌ತೆ ದೇವ್‌ನೆ ಇನ ಬುಲೈಲೀದೋತೆ ಇನಖ್ಹಾಜೆ ಕಿನ ಡೋಳೇಬಿ ದೆಖಾಯೊಕೊಯ್ನಿ. <verse eid="GEN 5:24" /><verse number="25" style="v" sid="GEN 5:25" />ಮೆತೂಷೆಲಹ ಏಕ್‌ಖ್ಹೊ ಖ್ಹಾತ್‌ಉಪ್ಪರ್ ಚಾರೀಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳೊ ಹುಯಿನ್ ಲೆಮೆಕನ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />ಲೆಮೆಕ ಪೈದಹುವಾದಿನ್ ಮೆತೂಷೆಲಹನೆ ಪರ್ಖ್ಹೊ ಅಜು಼ ತಯೇಡ ಲಡ್ಕಾವ್ನ ಪೈದಕರೀನ್‌ ಖ್ಹಾತ್‌ಖ್ಹೋ ಬೇಉಪ್ಪರ್‌ ಚಾರೀಖ್ಹ್‌ ವರಖ್ಹ್‌ ಬಚಿರ‍್ಹೊ. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />ಮೆತೂಷೆಲಹ ಒಟ್‌ ನೌಖ್ಹೋ ನೌಉಪ್ಪರ್‌ ತೀನಿಖ್ಹ್‌ ವರಖ್ಹ್ ಬಚಿರ‍್ಹೀನ್ ಮರ‍್ಯೊ. <verse eid="GEN 5:27" /><verse number="28" style="v" sid="GEN 5:28" />ಲೆಮೆಕ ಏಕ್‌ಖ್ಹೊ ಬೇಉಪ್ಪರ್‌ ಚಾರೀಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳೊ ಹುಯಿನ್ ಏಕ್‌ ಛಿಯ್ಯಾನ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />ಇನ ನೋಹಕರಿ ನಾಮ್‌ ಮ್ಹೇಲಿನ್‌, “ಯೆಹೋವನೆ ಶಾಪದಿದೋತೆ ಧರ್ತಿಮ ಮ್ಹಿನತ್ ಕರೀನ್ ಪಡುಕರಿಯೇತೆ ವದೇಖ್ಹ್‌ನ ಆ ಲಡ್ಕೇಥಿ ಅಪ್ಣುನ ಸಮಾಧಾನ್ ಮಳ್‌ಶೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />ನೋಹ ಪೈದಹುವಾದಿನ್ ಲೆಮೆಕನೆ ಪರ್ಖ್ಹೊ ಅಜು಼ ತಯೇಡ ಲಡ್ಕಾವ್ನ ಪೈದಕರೀನ್ ಪಾಚ಼್‌ಖ್ಹೋ ಪಾಚ಼್‌ಉಪ್ಪರ್‌ ಖ್ಹಡ್‌ಚಾರೀಖ್ಹ್‌ ವರಖ್ಹ್‌ ಬಚಿರ‍್ಹೊ. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />ಲೆಮೆಕ ಒಟ್‌ ಖ್ಹಾತ್‌ಖ್ಹೋ ಖ್ಹಾತ್‌ಉಪ್ಪರ್ ಖ್ಹಡ್‌ತೀನಿಖ್ಹ್‌ ವರಖ್ಹ್‌ ಬಚಿರ‍್ಹೀನ್ ಇನವಾರ್ ಮರ‍್ಯೊ. <verse eid="GEN 5:31" /><verse number="32" style="v" sid="GEN 5:32" />ನೋಹ ಪಾಚ಼್‌ಖ್ಹೋ ವರಖ್ಹ್‌ನೊ ಹುಯಿನ್ ಶೇಮ್‌, ಹಾಮ್‌, ಯೆಫೆತ್‌ಕರಿ ತೀನ್‌ಜ಼ಣ ಪರ್ಖ್ಹ ಲಡ್ಕಾವ್ನ ಪೈದಕರ‍್ಯೊ.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">ಅದ್ಮೆವ್‍ನು ಖರಾಬ್‌ಫನೈ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />ಧರ್ತಿಪರ್ ಅದ್ಮಿನು ಗಣ್ತಿ ಜಾ಼ಖ್ಹತ್ ಹುಯಿನ್ ಅವ್ಣುನ ಛೋ಼ಕ್ರಿಯೆ ಪೈದಹುಯೆ. <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />ಅದ್ಮಿವ್‌ನಿ ಛೋ಼ಕ್ರಿಯೇ ರಂಗ್‌ರೂಪ್‌ವಾಳಿಯೆ ಥಿಯೇತೆ ದೇಖಿನ್ ದೇವ್ನ ಛಿಯ್ಯಾವ್‌ನೆ ಇವ್ಣುನ ಪಸಂದ್‌ಹುವಾತೆ ತಯೇಡವ್‍ನ ವ್ಯಾಹ ಕರಿಲಿದು. <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />ತದೆ ಯೆಹೋವನೆ, “ಮಾರಿ ಆತ್ಮ ಅದ್ಮಿನ ಜೋ಼ಡೆ ಹಮೇಶ ರ‍್ಹವಾನ ಮ್ಹೇಲುಕೊಯ್ನಿ. ಶನಕತೊ ಲ್ಹೋಯಿಬಿ ಬೋಟಿಥಿ ಛಾ಼ತೆಇವ್ಣೆ ಮರವಾಳುಸ್. ಇವ್ಣೆ ಘಣಾದನ್‍ ಬಚಿರ‍್ಹಿಶೆಕೊಂತೆ ಏಖ್ಹೊವೀಖ್ಹ್ ವರಖ್ಹ್‌ಲಗು ಬಚಿರ‍್ಹಿಶೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 6:3" /><verse number="4" style="v" sid="GEN 6:4" />ಇನವಾರ್‌, ದೇವ್ನಛಿಯ್ಯಾ ಅದ್ಮಿ‌ವ್‍ನಿ ಛೋ಼ರಿಯೇನ ಮಳೀನ್‍ ಇವ್ಣೇಥಿ ಲಡ್ಕ ಪೈದಹುಯು. ಯೊ ಹಗಾಮ್‌ಥು ಧರಿನ್‌ ಇಂಥಿವಾರ್‌ಲಗೂಬಿ ಜ಼ಗ್‌ಮ ಮಹಾಶರೀರ್‌ವಾಳು ಥು. ಅವ್ಣೇಸ್ ಜ಼ಮಾನಮ ನಾಮ್ ಕಮಾಯುತೆ ತಾಖತ್‍ವಾಳುಖ್ಹಾರು. <verse eid="GEN 6:4" /><verse number="5" style="v" sid="GEN 6:5" />ಅದ್ಮಿನು ಖರಾಬ್ ಫನೈ ಧರ್ತಿಪರ್ ಜಾ಼ಖ್ಹತ್ ಹುಯಿಗುತೆ, ಇವ್ಣೆ ಮನ್‌ಮ ಸೋಚಾನುಖ್ಹಾರು ಕದೇಬಿ ಖರಾಬಸ್‍ ಹುಯಿರ‍್ಹಯೂತೆ ಯೆಹೋವನೆ ದೇಖಿನ್, <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />ಯೆಹೋವನೆ, ಧರ್ತಿಪರ್ ಅದ್ಮಿವ್‍ನ ಉಬ್‍ಜಾ಼ಯೊತೆ ಇನಖ್ಹಾಜೆ ಪಶ್‌ತೈನ್‌ ಇನ ದಿಲ್ಮ ದುಖ್‍ಕರ‍್ಯೊ. <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />ಅಜು಼ ಯೆಹೋವನೆ, ಅದ್ಮಿವ್‍ ನ ಮೇ ಉಬ್‍ಜಾ಼ಯೊತೆ ಅದಮ್ಜ಼ಮಾನನ ಧರ್ತಿಪರ್‌ಥು ನೂಛಿನಾಖುಸ್; ಅದ್ಮೆವ್ನಿ ಜೋ಼ಡ್ಮ ಹರೇಕ್ ಜೀನ್‌-ಜಿನಾವರ್‌ಬಿ ಜ಼ಮಿನ್‌ಪರ್ ಖ್ಹವ್‌ಳವಾಳು ಕೀಡ್‌ಕಮ್‌ಟವ್‍ನಾಬಿ ನೂಛಿನಾಖುಸ್. ಅನ ಅಖ್ಖಾನ ಉಬ್‍ಜಾ಼ಯೊತೆ ಇನಖ್ಹಾಜೆ ಮನ ದುಖ್‌ ಹುವ್‍ಕರಸ್; ಕರಿ ಬೋಲಿಲಿದೊ. <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />ಕತೋಬಿ ನೋಹ ಯೆಹೋವನ ಪಸಂದ್‌ಹುಯೊ.<verse eid="GEN 6:8" /></para>
  <para style="s">ನೋಹ</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />ನೋಹಾನಿ ಖೇಣಿ; ನೋಹ ನೀತಿವಾಳೋಬಿ, ಅಖ್ಖ ಅದ್ಮಿವೋಮ ಖ್ಹಾಚೋ಼ಬಿ ಹುಯಿರ‍್ಹೋಥೊ. ಯೊ ದೇವ್‍ನಿಜೋ಼ಡ್ಮ ಗಳ್‍ಜೋ಼ಡ್‌ಥಿ ಚಾ಼ಲಿಲಿದೊ. <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />ನೋಹಾನ ಶೇಮ್‌, ಹಾಮ್‌, ಯೆಫೆತ್‌ ಕರಿ ತೀನ್ಜ಼ಣ ಲಡ್ಕ. <verse eid="GEN 6:10" /><verse number="11" style="v" sid="GEN 6:11" />ಧರ್ತಿವಾಳು ದೇವ್ನಿ ನಜ಼ರ‍್ಮ ಖರಾಬ್‌ಥಿ ಚಾ಼ಲಿನ್ ಖೋಟ್ವಾಳು ಹುಯ್ಗುಥು. ಖ್ಹತಾಪ್ಣಿ ಅಜು಼ ಅನ್ಯಾಮ್‌ಬಿ ಧರ್ತಿಮ ಭರೈಗುಥು. <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />ದೇವ್ ಜಗತ್ನ ಅದ್ಮಿನ ದೇಖಾಖ್ಹತರ್ ಇವ್ಣಿ ಖರಾಬ್ ಚಾ಼ಲ್‌ನ ದೇಖ್ಯೊ. ಹಿಜ್ಜಾ಼ ಜಿವ್ಣುಕರವಾಳು ಅಖ್ಖಾ ಅದ್ಮಿನಿವಾಟ್ ಖರಾಬ್‌ಥೀಸ್ ಭರೈರ‍್ಹುಥು. <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />ತದೆ ದೇವ್ನೆ ನೋಹಾನ, “ಮೇ ಖ್ಹಾರಸ್ ಅದ್ಮೆವ್‍ನ ನೂಛಿನಾಖನ ತೀರ್ಮಾನ್ ಕರಿರಾಖ್ಯೊಸ್; ಶನಕತೊ ಅವ್ಣೇಥಿ ಧರ್ತಿ ಖರಾಬ್‌ಫನೈಥಿ ಭರೈರ‍್ಹೂಸ್‍ ಮೇ ಖ್ಹಾಚಮ ಇವ್ಣುನ ಧರ್ತಿನ ಜೋ಼ಡ್ಮ ನೂಛಿನಾಖುಸ್. <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />ತೂ ತಾರಖ್ಹಾಜೆ ಘಣಮೋಲ್‌ನ ಝ಼ಾಡ್‍ಥಿ ಜ಼ಹಾಜ಼್ ಬಣೈಲೆ. ಇನಾಮ ಘಣಾ ಕೋಣರ‍್ಹೇಣು; ಮಹಿಬಿ ಭಾರ್‌ಬಿ ಡಾಂಬರ್ ಲಗಾಡ್. <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />ತೂ ಇನ ಕಿಮ್ನಿ ಪರಕ್ಮ ಕರ‍್ನುಕತೊ ಯೊ ತೀನ್‍ಖ್ಹೊ ಹಾತ್ ಲಾಂಬುಬಿ, ಅಢೈಖ್ಹ್‌ ಹಾತ್ ಚೌ಼ಡುಬಿ, ಡೋಡಿಖ್ಹ್‌ ಹಾತ್ ಊಚು಼ಬಿ ಹುಯಿರೇವ್ಣು. <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />ಇನ ಛ಼ತ್‍ನ ಹೇಟ್ ಅಶ್‍ಪಿಶ್ ಎಕ್ ಹಾತ್ ಊಚು಼ ಖೀಂಡ್‌ ಬಣಾವ್ಣು; ಭೀಡೆ ಬಾಕಲ್‍ಮ್ಹೇಲ್‍ನು. ಜ಼ಹಾಜ಼್‍ಮ ಏಕ್‍ನಪರ್‌ ಏಕ್‍ ತೀನ್‍ಖನ್ ಬಣಾವ್‍ಣು. <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />ಮೇತೊ ಧರ್ತಿಪರ್ ಪಾಣಿನು ತೋಫಾನ್ ಆವಾನಿತರ ಕರೀನ್ ಆಬ್‍ನ ಹೇಟ್ ಛಾ಼ತೆ ಹರೇಕ್ ಜೀನ್‌ಜಿನಾವರ್‌ನಾಬಿ ನಾಶ್‌ಕರಿಷ್; ಧರ್ತಿಮ ಛಾ಼ತೆ ತಮಾಮಸ್ ಮಟಿಜಾ಼ಶೆ. <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />“ಕತೋಬಿ ತಾರಿಜೋ಼ಡ್ಮ ಮೇ ಎಕ್ ಒಪ್ಪಂದಾನ ಕರುಸ್. ತೂ ತಾರಿ ಬಾವಣ್, ಛಿಯ್ಯಾ ಅಜು ವ್ಹವೆ ಖ್ಹಮೇದ್ ಜ಼ಹಾಜ಼್‍ಮ ಪೇಶಿಜಾ಼ವ್ಣು. <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />ಆ ನಾಹುಯಿನ್ ಜೀನ್‌ಜಿನಾವರ್‌ಮ ಹರೇಕ್ ಜಾ಼ತ್‍ಮಾಬಿ ಏಕ್‍ ಪರ್ಖ್ಹೊ ಎಕ್ ತಯೇಡ ಅಮ್ ಬೆಬ್ಬೇನ ಜ಼ಹಾಜ಼್‍ಮ ಪೆಖ್ಹಾಡಿನ್, ತಾರಿಜೋ಼ಡ್ಮ ಬಚಾ಼ಡಿಲೆವ್ಣು. <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />ಜಾನ್ವರ್‌, ಜಿನಾವರ್‌, ಝಾ಼ಡಿನು ಜಾನ್ವರ್‌ ಕೀಡುಕಮ್‌ಟು ಇನಾಮನು ಹರೇಕ್ ಜಾ಼ತ್‍ಮಾಬಿ ಜೋ಼ಡುಜೋ಼ಡು ಬಚಾ಼ನಖ್ಹಾಜೆ ತಾರಕನ ಆವ್‌ಶೆ. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />ತುನಾಬಿ ಯೊ ಅಖ್ಖಾನಬಿ ಪಳ್ವಾನಖ್ಹಾಜೆ ಹರೇಕ್ ಥರಾನು ಅನಾಜ಼್‌ನ ತಾರಕನ ಜ಼ಮಕರಿಲೆವ್ಣು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 6:21" /><verse number="22" style="v" sid="GEN 6:22" />ದೇವ್ನೆ ಹುಕುಮ್ ಕರ‍್ಯೊತೆ ಪರಕ್ಮಾಸ್ ನೋಹಾನೆ ಕರ‍್ಯೊ.<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">ಪಾಣಿನು ತೋಫಾನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />ತದೆ ಯೆಹೋವನೆ ನೋಹಾನ, “ತೂಬಿ ತಾರ ಘರ್‌ವಾಳು ಅಖ್ಖೂಸ್ ಜ಼ಹಾಜ಼್‍ಮ ಪೇಶಿಜಾ಼ವೊ; ಹಮ್ಕೆ ಛಾ಼ತೆ ಅದ್ಮಿನಿ ಖಾನ್‌ದಾನ್‌ಮ ತೂ ಎಕ್ಕಸ್‌ ಜ಼ಣೊ ಮಾರ ಖ್ಹಾಮ್ಣೆ ನಿಯತ್‌ವಾಳೊಕರಿ ದೆಖೈರ‍್ಹೋಸ್. <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />ಖ್ಹಾರೂಸ್ ಶುದ್‍ ಜಾನ್ವರ್‌ಮ ಖ್ಹಾತ್‌ಖ್ಹಾತ್ ಜೋ಼ಡ ಪರ್ಖ್ಹೋ ತಯೇಡಾವ್ನ ಶುದ್ ಕಾಹೆತೆ ಜಾನ್ವರ್‌ಮ ಬೆಬ್ಬೇ ಜೋ಼ಡ ಪರ್ಖ್ಹೊ ತಯೇಡಾವ್ನ ತಾರಿ ಜೋ಼ಡೆ ಬುಲೈಲೇವ್ಣು. <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />ಜಿನಾವರ್‌ಮಾಬಿ ಖ್ಹಾತ್‌ಖ್ಹಾತ್ ಪರ್ಖ್ಹೊ ತಯೇಡಾವ್ನ ಲೀಲೆವ್ಣು. ಅಮ್‌ ಯೋಯೋ ಜಾ಼ತ್ನ ಧರ್ತಿಪರ್ ರಾಖಿನ್ ಬಚಾ಼ಡ್‌ನು. ಶನಕತೊ ಇವ್ಣಿ ಪಿಳ್ಗಿ ಜಾ಼ಖ್ಹತ್ ಹುವಾನಖ್ಹಾಜೆ ತೂ ಅಮ್‌ಕರ‍್ನು. <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />ಹಮ್ಕೇಥು ಖ್ಹಾತ್‌ದನ್ನ ವಾರ್‌ ಧರ್ತಿಪರ್ ಮೇ ಧರ್ತಿಪರ್ ಚಾ಼ಳಿಖ್ಹ್‌ ದನ್ ಚಾಳಿಖ್ಹ್ ರಾತ್‌ ವರ್ಖ್ಹಾತ್ನ ವರ್‌ಖ್ಹೈನ್, ಮೇ ಉಬ್‌ಜಾ಼ಯೋತೆ ಜಾನ್‌ರ‍್ಹವಾಳ ಅಖ್ಖಾಸ್ನ ಧರ್ತಿಪರ್‌ಥು ನಾಶ್‌ಕರಿಷ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 7:4" /><verse number="5" style="v" sid="GEN 7:5" />ಯೆಹೋವನೆ ಹುಕುಮ್‌ ಕರ‍್ಯೊತೆ ಖ್ಹಾರೂಸ್ ನೋಹಾನೆ ಕರ‍್ಯೊ. <verse eid="GEN 7:5" /><verse number="6" style="v" sid="GEN 7:6" />ಧರ್ತಿಪರ್ ಪಾಣಿನು ತೋಫಾನ್ ಹುವಾನಿ ವಖ್ಹ್‌ತೆ ನೋಹ ಚೊ಼ಖ್ಹೋ ವರಖ್ಹ್‌ವಾಳೊ ಹುಯಿರ‍್ಹೊಥೊ. <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />ತದೆ ನೋಹಾನೆ ತೋಫಾನ್‌ಥಿ ಛು಼ಕಿಜಾ಼ವಾನಖ್ಹಾಜೆ ಬಾವಣ್ ಛಿಯ್ಯಾ ವ್ಹವೆ ಖ್ಹಮೇದ್ ಜ಼ಹಾಜ಼್‍ಮ ಪೇಶಿಗಯೊ. <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />ದೇವ್‌ ನೋಹಾನ ಹುಕುಮ್‌ ದಿದೋತೆ ತಿಮ್ಮಸ್ ಶುದ್ಧಾ ಅಶುದ್ಧ ಜಾನ್ವರ್‌ ಅಜು಼ ಜಿನಾವರ್‌ಮಾಬಿ ಕೀಡುಕಮ್‌ಟಮಾಬಿ, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />ಪರ್ಖ್ಹೊ ತಯೇಡ ಜೋ಼ಡುಜೋ಼ಡು ಹುಯಿನ್ ದೇವ್ನಿ ಹುಕುಮ್‌ನಿತರ ನೋಹಾನಿ ಜ಼ಹಾಜ಼್‍ಮ ಅಯಿನ್ ಪೇಶಿಗಯು. <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />ಯೊ ಖ್ಹಾತ್‌ದನ್ ಹುವಾನ ವಾರ್‌ ಪಾಣಿನು ತೋಫಾನ್ ಧರ್ತಿಪರ್ ಶುರುಹುಯು. <verse eid="GEN 7:10" /><verse number="11" style="v" sid="GEN 7:11" />ನೋಹಾನಿ ಜಿಂದಗೀನು ಚೊ಼ಖ್ಹೋ ವರಖ್ಹ್‌ನು ಬೇನ ಮಹಿನಾನು ಖ್ಹತ್ರಾನ ರೋಜ಼್‌ಮ ಧರ್ತಿನ ಹೇಟ್‌ನು ದಲ್‌ದರ‍್ಯಾವ್‌ನು ಚೇಜ್‌ಭಾರೊ ನಿಕ್ಳಿಆಯೊ; ಆಬ್‌ನು ತೂಬ್ ಫಾಟಿನ್ ಪಾಣಿ ರಂಚಾ಼ಯು. <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />ಚಾ಼ಳಿಖ್ಹ್‌ರೋಜ಼್‌ ರಾತ್‌ದನ್‌ ಧರ್ತಿಪರ್ ಕಹಾರ್‌ ವರ್‌ಶ್ಯೊ. <verse eid="GEN 7:12" /><verse number="13" style="v" sid="GEN 7:13" />ಯೊ ದನ್ಮ ನೋಹಾಬಿ ಇನಿ ಬಾವಣ್‍ ಅಜು಼ ಶೇಮ್‌, ಹಾಮ್‌, ಯೆಫೆತ್‌ಕರಿ ತೀನ್ ಲಡ್ಕಾವ್‌ಬಿ ಇವ್ಣಿ ಬಾವ್ಣೇಬಿ ಜ಼ಹಾಜ಼್‍ಮ ಪೇಶಿಗಯು. <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />ಖ್ಹಾರೂಸ್ ಜಾನ್ವರ್‌ಮ ಕತೊ ಹರೇಕ್ ಜಾ಼ತ್ನು ಜಾನ್ವರ್‌ಬಿ ಕೀಡುಕಮ್‌ಟುಬಿ ಫಾಕ್ಡಿಮಾರವಳು ಹರೇಕ್‌ಥರಾನ ಜೀನ್‌-ಜಿನಾವರ್‌ಬಿ, <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />ಬೆಬ್ಬೆ ಇನಿಇನಿ ಜಾತ್ನಿ ಪರಕ್ಮ ನೋಹಕನ ಐನ್ ಜ಼ಹಾಜ಼್‍ಮ ಪೇಶಿಗಯು. <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />ನೋಹಾನ ದೇವ್‌ನೆ ಹುಕುಮ್‌ ದಿದೋತೆ ತಿಮ್ಮಸ್ ಖ್ಹಾರಸ್ ಜಾನ್ವರ್‌ಮ ಏಕ್‌ ಪರ್ಖ್ಹೋ ಏಕ್‌ ತಯೇಡ ಪೇಶಿಗಯು. ಯೆಹೋವನೆ ನೋಹಾನ ಮಹಿ ಘಾಲಿನ್ ದರ್ವಾಜು ಮೂಚಿನಾಖ್ಯೊ. <verse eid="GEN 7:16" /><verse number="17" style="v" sid="GEN 7:17" />ಪಾಣಿನು ತೋಫಾನ್ ಚಾ಼ಳಿಖ್ಹ್‌ದನ್‌ ಧರ್ತಿಪರ್ ಪಾಣಿ ಛ಼ಡ್‌ತು ಐನ್ ಜ಼ಹಾಜ಼್‌ ಉಪ್ಪರ್‌ ಪಡಾವಖ್ಹತರ್‌ ಯೊ ಪಾಣಿಪರ್‌ ತೇಲಾವಲಗ್ಯು. <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />ಪಾಣಿ ಘಣು ತಾಖಥ್ಥಿ ಧರ್ತಿಪರ್ ಜಾ಼ಖ್ಹತ್ ಹುವಾಖ್ಹತರ್‌ ಜ಼ಹಾಜ಼್‌ ಇನಪರ್‌ ಚಾ಼ಲಲಗ್ಯು. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />ಪಾಣಿ ಧರ್ತಿಪರ್ ಘಣೇಥಿ ಘಣು ಜಾ಼ಖ್ಹತ್ ಹುಯುತೆಖ್ಹಾಜೆ ಆಬ್‌ನೊ ಗೋಳಾನ ಹೇಟ್‌ಥೂತೆ ಖ್ಹಾರೂಸ್ ಮೋಟ ಪಹಾಡ್‌ಬಿ ಮುಚೈ಼ಗು. <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />ಪಾಣಿ ಯೊ ಪಹಾಡ್‌ ಅಖ್ಖೇಥಿಬಿ ಪಂಧ್ರಾಹಾತ್‌ ಉಪ್ಪರ್‌ ಜಾ಼ಖ್ಹತ್ ಹುವಾಖ್ಹತರ್‌ ಯೊ ಅಖ್ಖು ಮುಚೈ಼ಗಯು. <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />ಇನಖ್ಹಾಜೆ, ಜಿನಾವರ್‌, ಕೀಡುಕಮ್‌ಟು, ಜಾನ್ವರ್‌ ಅಜು಼ ಅದ್ಮಿಖ್ಹಮೇದ್‌ ಜ಼ಮಿನ್‌ಪರ್ ಚಾ಼ಲವಾಳು ಹರೇಕ್ ಧರ್ತಿನು ಜ಼ಂತ್‌ಖ್ಹಾರೂಸ್ ನಾಶ್‌ಹುಯಿಗು. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />ದಮ್‌ಲೈತೆ ಧರ್ತಿನು ಜ಼ಂತ್‌ಖ್ಹಾರು ಮರಿಗು. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />ಅಮ್ ಪಹಿಲೆ ಅದ್ಮಿ, ಜೀನ್‌-ಜಿನಾವರ್‌ ಕೀಡುಕಮ್‌ಟುಬಿ ಧರ್ತಿಪರ್ ಥೂತೆ ಖ್ಹಾರುಸ್ ಮಟಿಗು. ನೋಹಾಬಿ ಇನಿ ಜೋ಼ಡ್ಮ ಜ಼ಹಾಜ಼್‍ಮ ಥೂತೆ ಜೀವಿಖ್ಹಾರು ಖಲಿ ಬಚಿಗು. <verse eid="GEN 7:23" /><verse number="24" style="v" sid="GEN 7:24" />ತೋಫಾನ್ನು ಪಾಣಿ ಧರ್ತಿಪರ್ ಏಕ್‌ಖ್ಹೊ ಅಡೈವಿಖ್ಹ್‌ ದನ್‌ಲಗು ಉತ್ರಿರ‍್ಹಯುಥು ಕೊಯ್ನಿ.<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">ಪಾಣಿನು ತೋಫಾನ್ನಿ ಖ್ಹರ್ತಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />ಇನವಾರ್ ದೇವ್ನೆ ನೋಹನಾಬಿ ಇನಜೋ಼ಡೆ ಜ಼ಹಾಜ಼್‍ಮಥೂತೆ ಖ್ಹಾರುಸ್ ಜೀನ್‌ಜಿನಾವರ್ ಅಜು಼ ಜಾನ್ವರ್‌ನಬಿ ಯಾದ್‌ಕರಿನ್ ಧರ್ತಿಪರ್ ವಹಿರೊ ವಾಗನಿಘೋಣಿ ಕರಾಖ್ಹತರ್ ಪಾಣಿ ಖ್ಹರ್‌ತುಆಯು. <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />ಧರ್ತಿನ ಹೇಟ್‌ಥೂತೆ ದರ‍್ಯಾವ್‍ನು ವಾಟೆಖ್ಹಾರುಬಿ ಆಬ್‍ನು ತೂಬ್‌ಖ್ಹಾರು ಮೂಚೈ಼ಗಯು. ಆಬ್‍ಥು ರಂಚ಼ವ್‌ಕರ್ತುಥೂತೆ ವರ್ಖ್ಹಾತ್ ಭೀರಿಗಯು. ಧರ್ತಿಪರ್‌ಥೂತೆ ಪಾಣಿ ಥೋಡು ಥೋಡು ಖ್ಹರ್ತುಹುಯಿನ್‍ ಆಯು. <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />ಅಮ್ ಏಕ್‌ಖ್ಹೊ ಅಢೈವೀಖ್ಹ್ ದನ್ ಹುವಾನ ಪಾರ್ ಪಾಣಿ ಕಮ್‍ಹೋತು ನಿಕ್‌ಳ್ಯು. <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />ಖ್ಹಾತ್‍ನ ಮಹಿನಾನೊ ಖ್ಹತ್ರಾನೊ ರೋಜ಼್‍ಮ ಜ಼ಹಾಜ಼್ ಅರಾರಾಟ್ ತಬರ್‌ಖಾನು ಪಹಾಡ್‍ಕನ ಭೀರಿಗು. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />ದಖ್ಹ್‌ನ ಮಹಿನಲಗೂಬಿ ಪಾಣಿ ಕಿಮ್ ಕಮ್‍ಹೋತು ಆಯುಕಿ ದಖ್ಹ್‌ನ ಮಹಿನಾನೊ ಪಹಿಲದನ್ನೆ ಪಹಾಡ್‍ನಿ ನೋಕೆ ದೆಖಾವಲಗ್ಯು. <verse eid="GEN 8:5" /><verse number="6" style="v" sid="GEN 8:6" />ಚಾ಼ಳಿಖ್ಹ್‌ದನ್‌ ಹುವಾನ ಪಾರ್ ನೋಹಾನೆ ಇನೆ ಕರ‍್ಯೊತೆ ಜ಼ಹಾಜ಼್‍ನಿ ಕಿಟ್‌ಕೆನ ಕಾಡಿನ್ ಎಕ್ ಕಾಂಗಣ್ಣಾ ಭಾರ್ ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />ಧರ್ತಿಪರ್‌ಥೂತೆ ಪಾಣಿ ಖ್ಹುಕಾವಲಗು ಯೊ ಕಾಂಗಣ್‌ ಆವಣ್ ಜಾ಼ವಣ್ ಕರುಕರ್ತುಥು. <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />ಅಮ್‍ರ್ಹಾವಪರ್ ಪಾಣಿ ಕಮ್‌ಹುಯುಕಿ ಕೊಯ್ನಿಕರಿ ಮಾಲುಮ್‍ ಕರಿಲ್ಯಾವನಖ್ಹಾಜೆ ನೋಹಾನೆ ಎಕ್ ಪರ‍್ಯಾವನ ಭಾರ್ ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />ಕತೋಬಿ ಜ಼ಮೀನ್‌ಪರ್‌ ಪಾಣಿ ಥೂತೆ ಇನಖ್ಹಾಜೆ ಪರ‍್ಯಾವೊ, ಗೋಡೊಮ್ಹೇಲಾನ ಝ಼ಗೊ ದೆಖಾಯುಕೊಂತೆ ಫರೀನ್ ಪಾಛು಼ ಜ಼ಹಾಜ಼್‍ಕನ ಆಯು. ನೋಹಾನೆ ಹಾತ್ ಪೂರೈನ್‌ ಇನ ಧರೀನ್ ಜ಼ಹಾಜ಼್‍ಮ ಘಾಲಿಲಿದೊ. <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />ಇನೆ ಬಿಜು಼ ಖ್ಹಾತ್ ರೋಜ಼್‍ನ ಪಾರ್ ಪರ‍್ಯಾವನ ಪಾಛೊ಼ ಭಾರ್ ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />ಖ್ಹಾಂಜೆ ಯೊ ಪರ‍್ಯಾವೊ ಪಾಛು಼ಫರಿನ್ ನೋಹಕನ ಆವಖ್ಹತರ್, ಇನ ಚೋ಼ಚ಼್‌ಮ ಒಲಿವ್ ತೇಲ್‍ನ ಝಾ಼ಡ್‍ನು ನವು ಚಿಗುರ್‌ಥು. ತದೆ ಇನೆ ಇನ ದೇಖಿನ್ ಪಾಣಿ ಧರ್ತಿಪರ್‌ಥು ಖ್ಹರಿಗಯುಕರಿ ಮಾಲುಮ್ ಕರಿಲಿದೊ. <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />ಪಾಛೊ಼ ಖ್ಹಾತ್ ರೋಜ಼್‌ನ ಪಾರ್ ಪರ‍್ಯಾವನ ಮ್ಹೇಲಾಖ್ಹತರ್ ಯೊ ಪಾಛು಼ಫರಿ ಇನಾಕನ ಆಯುಸ್ ಕೊಯ್ನಿ. <verse eid="GEN 8:12" /><verse number="13" style="v" sid="GEN 8:13" />ನೋಹಾನ ಛೊ಼ಖ್ಹೊ ಎಕ್ ವರಖ್ಹ್‌ ಹುಯಿನ್ ಪಹಿಲ ಮಹಿನಾನೊ ಪಹಿಲೊ ರೋಜ಼್‌ ಧರ್ತಿಪರ್ ಥೂತೆ ಪಾಣಿ ಖ್ಹರಿಗಯುಥು. ನೋಹಾನೆ ಜ಼ಹಾಜ಼್‌ನು ಕಿಟ್‌ಕೆನ ಕಾಡಿನ್ ದೇಖಾಖ್ಹತರ್, ಧರ್ತಿ ಪೂರ ಖ್ಹುಕೈರ‍್ಹೂಥು. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />ಬೇನ ಮಹಿನಾನೊ ಖ್ಹಾತ್‌ಉಪ್ರಿಖ್ಹ್‌ನೊ ರೋಜ಼್‌ಮ ಧರ್ತಿ ಖ್ಹುಕೈಗಯುಥು. <verse eid="GEN 8:14" /><verse number="15" style="v" sid="GEN 8:15" />ತದೆ ದೇವ್ನೆ ನೋಹಾನ, <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />“ತೂ ತಾರಿ ಬಾವಣ್, ಲಡ್ಕಾವ್ ವ್ಹವೆಖ್ಹಮೇದ್ ಜ಼ಹಾಜ಼್‍ನ ಮ್ಹೇಲಿನ್ ಭಾರ್ ಆವ್; <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />ತಾರಕನ ಛಾ಼ತೆ ಜೀನ್‌-ಜಿನಾವರ್‌, ಕೀಡುಕಮ್‍ಟು, ಖ್ಹಾರುಸ್ ಜೀವಿಬಿ ಭಾರ್‌ಆವಾದೆ; ಯೊ ಅಖ್ಖಾನ ಧರ್ತಿಪರ್ ಘಣುಹುಯಿನ್‌ ಫುಟಾದೆ; ಯೊ ಭಡೀನ್ ಜಾ಼ಖ್ಹತ್ ಹುವಾದೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 8:17" /><verse number="18" style="v" sid="GEN 8:18" />ನೋಹ ಇನಿ ಬಾವಣ್‍ ಛಿಯ್ಯಾ ವ್ಹವೆಖ್ಹಮೇದ್ ಭಾರ್ ಆಯೊ. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />ಖ್ಹಾರುಸ್ ಜೀನ್‌ಜಿನಾವರ್, ಜಿನಾವರ್‌ ಅಜು ಕೀಡುಕಮ್‌ಟು ಖ್ಹಮೇದ್ ತಿನಿ ತಿನಿ ಜಾತ್ನಿ ಪರಕ್ ಜ಼ಹಾಜ಼್‍ಥಿ ಭಾರ್ ಆಯು.<verse eid="GEN 8:19" /></para>
  <para style="s">ನೋಹಾನೆ ಬಲಿ ದಿದೋತೆ</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />ತದೆ ನೋಹ ಯೆಹೋವನಖ್ಹಾಜೆ ಚಾ಼ಚ಼ರ್‌ನ ಭಾಂದಿನ್‌, ಇನಾಪರ್ ಶುದ್ಧಂ ವಳು ಹರೇಕ್ ಜೀನ್‌-ಜಿನಾವರ್‌ ಮಾಥು ಚೂ಼ಣಿಲೀನ್ ಅಖ್ಖಾಸ್‍ ಏಕ್‍ನ ಭುಂಜಿನ್ ಢಪ್ಕಾರದಿದೊ. <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />ಇನು ಮಹಿಕಾವನು ವಾಖ್ಹ್‌ ಯೆಹೋವನ ಮಹಿಕಾವಖ್ಹತರ್‌ ಇನ ಪಸಂದ್ ಹುಯು, “ಅದ್ಮೆವ್‌ನಿ ದಿಲ್ನಿ ಖ್ಹೂಜ಼್‌ ಅಡ್ಡಾಣಿಪರ್‌ಥುಸ್ ಖರಾಬ್‌, ಕತೋಬಿ ಮೇ ಅನಪಾರ್‌ ಇವ್ಣಖ್ಹಾಜೇಥಿ ಧರ್ತಿನ ಶಾಪ ದೇವ್‌ಕೊಯ್ನಿ, ಮೇ ಖ್ಹಾರುಸ್ ಜೀವಿನಾಬಿ ಹಮ್ಕೆ ನಾಶ್‌ಕರ‍್ಯೊತೆ ತಿಮ್‌ ಅನಪಾರ್‌ ಕರೀಶ್‌ಕೊಯ್ನಿ.<verse eid="GEN 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 8:22" />ಧರ್ತಿರ‍್ಹವಾಲಗು ಬಿತ್‌ಕರಾನು ಹಗಾಮ್‌ಬಿ, ವ್ಹಾಡ್ಣಿನ ಹಗಾಮ್‌ಬಿ, ಠಣ್, ಗರಮ್, ಠಣ್ಣಾ ಹಗಾಮ್‌ಬಿ, ತಡ್ಕಾನ ಹಗಾಮ್‌ಬಿ, ದನ್‌ಬಿ, ರಾತ್‌ಬಿ, ಆ ಅಖ್ಖಾನು ತರಿಕಾ ಭೀರಿಶೆಕೊಯ್ನಿ” ಕರಿಬೋಲ್ಯೊ.<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">ನೋಹಾನಿ ಜೋಡ್ಮ ದೇವ್ನಿ ಒಪ್ಪಂದ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />ದೇವ್ನೆ ನೋಹಾನಬಿ, ಇನ ಛಿಯ್ಯಾವ್‌ನಬಿ ಆಶೀರ್ವದ್ ಇವ್ಣುನ, “ತುಮೆ ಘಣು ಪಿಳ್ಗಿವಾಳ ಹುಯಿನ್ ಭಡೊ. ಅಜು ಧರ್ತಿ ಅಖ್ಖಾಪರ್ ಫೈಲೈಜಾ಼ವೊ ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />ಧರ್ತಿಪರ್‌ಛಾ಼ತೆ ಖ್ಹಾರುಸ್ ಜಾನ್ವರ್‌ಬಿ, ಖ್ಹಾರುಸ್ ಜಿನಾವರ್‌ಬಿ ಜ಼ಮೀನ್‌ಪರ್‌ ವ್ಹವವಾಳು ಖ್ಹಾರುಸ್ ಕೀಡುಕಮ್‌ಟುಬಿ, ದರ‍್ಯಾವ್ನು ಮಾಚ್ಲತುಮಾರೆಥಿ ಡರ್‌ಶೆ. ಯೊ ಅಖ್ಖಾಸ್ನ ತುಮಾರ ಕಬ್‌ಜಾ಼ಮ ದೀರಾಖ್ಯೊಸ್. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />ಧರ್ತಿಪರ್ ವ್ಹವವಾಳು ಖ್ಹಾರುಸ್ ಕೀಡುಕಮ್‌ಟುಬಿ ತುಮೂನ ಖಾಣು ಹುಯಿರ‍್ಹಿಶೆ. ಮೇ ತುಮಾರ ಖಾಣನಖ್ಹಾಜೆ ಭಾಜಿಪಾಲನ ತುಮೂನ ದಿದೋತೆ ಇಮ್ಮಸ್ ಆ ಅಖ್ಖಾನಬಿ ತುಮೂನ ದೀರಾಖ್ಯೋಸ್. <verse eid="GEN 9:3" /><verse number="4" style="v" sid="GEN 9:4" />ಕತೋಬಿ ಬೋಟಿನ ಇನು ಜಾನ್‌ ಹುಯಿರುತೆ ಲೋಹಿನ ಜೋ಼ಡೆ ತುಮೆ ನಾಖಾವ್ಣು. ಶನಕತೊ ಲೋಹಿಮ ಜಾನ್‌ ಛಾ಼. <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />ಆ ನಾಹುಯಿನ್ ತುಮಾರು ಜಾನ್‌ ಕಾಡವಾಳಾನ ಮೇ ಮರಣ್ಣಿ ದಂಡ್‌ನೆ ದಿಶ್. ಜಾನ್ವರ್‌ ಉಷೇತೊ ಇನಾಬಿ ಮಾರಿನಾಖಿಶ್. ಅದ್ಮಿ ಉಷೇತೊ, ಮರಿಗಯೊಹುಯೊ ಇನೊ ಭೈ ಹುಯಿರೋತೆ ಇನಖ್ಹಾಜೆ ಇನಾಬಿ ಮರಣ್ಣಿ ದಂಡ್‌ನೆ ದಿಶ್. ಅದ್ಮಿನ ಖೂನ್‌ಕರವಾಳ ಭೈನ ಮಾರದಾಖ್ಹಲ್‌ ಕಾಹೆಕಿಶು? <verse eid="GEN 9:5" /><verse number="6" style="v" sid="GEN 9:6" />ದೇವ್ನೆ ಅದ್ಮಿವೋನ ಇನ ಶೊಂತ್‌ ರೂಪ್‌ಮ ಉಬ್‌ಜಾ಼ಯೊತೆ ಇನಖ್ಹಾಜೆ ಕೋಣ್‌ ಅದ್ಮಿನ ಲ್ಹೋಯಿನ ರಂಚ಼ಸ್‌ಕಿ ಇನ ಖೇವತೋಬಿ ಏಕ್‌ಅದ್ಮಿಸ್‌ ಇನ ಲ್ಹೋಯಿನ ರಂಚ಼್‌ಶೆ. <verse eid="GEN 9:6" /><verse number="7" style="v" sid="GEN 9:7" />ತುಮುನ ಕೈಯೇಕ್ ಲಡ್ಕಖ್ಹಾರು ಹುವಾದೆ ಶನಕತೊ ಧರ್ತಿಪರ್ ತುಮಾರು ಪಿಳ್ಗಿ ಬಚ಼್‌ವಾದೆ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />ಆನಾಹುಯಿನ್ ದೇವ್ನೆ ನೋಹನಾಬಿ ಇನ ಛಿಯ್ಯಾವ್‌ನಾಬಿ, <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />“ಖ್ಹಮ್‌ಜೊ಼ ಮೇ ತುಮಾರಿ ಜೋಡ್ಮಾಬಿ ತುಮಾರ ವಾರ್‌ ತುಮಾರ ಪಿಳ್ಗಿವಾಳನಿ ಜೋ಼ಡ್ಮಾಬಿ ಒಪ್ಪಂದ ಕರಿಲೇವುಸ್‌, <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />ಅಜು ತುಮಾರಿ ಜೋ಼ಡ್ಮ ಜ಼ಹಾಜ್‌ಮಾಥು ಆಯೂತೆ ಜೀನ್‌-ಜಿನಾವರ್‌, ಜ಼ಂಗ್ಳಿಜಾನ್ವಾರ್‌ ಹರೇಕ್ ಧರ್ತಿನು ಜ಼ಂತ್‌ನಿ ಜೋ಼ಡ್ಮಾಬಿ ಮಾರಿ ಒಪ್ಪಂದ ಕರಿಲೆವುಸ್‌, <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />ಯೊ ಒಪ್ಪಂದ ಖಿವುಕತೊ; ಅನಪಾರ್‌ ಖಿವು ಜಾನ್ವರ್‌ಬಿ ವರ್ಖ್ಹಾತ್ನ ತೋಫಾನ್‌ಥಿ ನಾಶ್ ಕೋಉಷೇನಿ ಕರಿ ಆಣ್‌ಕರಿನ್, <verse eid="GEN 9:11" /><verse number="12" style="v" sid="GEN 9:12" />ದೇವ್ನೆ ಪಾಛೊ಼ ಬೋಲ್ಯೊತೆ ಶಾತ್‌ಕತೊ “ಮೇ ತುಮೂನಾಬಿ ತುಮಾರಿ ಜೋ಼ಡ್ಮಛಾ಼ತೆ ಜೀವಿನು ರಾಶಿನಾ ಬಾರೇಮ ಪಿಢಿನ್‌ಪಿಢೀಬಿ ಕರಾನು ಆ ಒಪ್ಪಂದಾನ ಮೆ ವಾದ್‌ಳಾಮ ಮ್ಹೇಲಿರಾಖ್ಯೋತೆ ಆ ವಾದ್‌ಳಾನು ಧೂಣಸ್ ಖ್ಹಣೇದ್ ಹುಯಿರ‍್ಹಿಶೆ. <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />ಆ ಮೇ ಜಗತ್‌ನಿ ಜೋಡ್ಮ ಕರಿರಾಖ್ಯೊತೆ ಒಪ್ಪಂದಾನ ಆಸ್ ಖ್ಹಣೇದ್ ಹುಯಿರ‍್ಹಿಶೆ. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />ಮೇ ಆಬ್‌ಪರ್ ವಾದ್‌ಳು ಢಾಪಾನಿವಖ್ಹ್‌ತೆ ಯೊ ಆಬ್‌ನು ಧೂಣ್‌ ವಾದ್‌ಳಾಮ ದೆಖಾವ್‌ಶೆ. <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />ತದೆ ಮೇ ತುಮೂನಾಬಿ ಖ್ಹಾರುಸ್ ಜೀವಿನಿರಾಶಿನಿ ಬಾರೇಮ ಕರ‍್ಯೊತೆ ಒಪ್ಪಂದಾನ ಯಾದ್‌ಕರಿಲಿಶ್. ಅನಪಾರ್‌ ಪಾಣಿ ಜಾ಼ಖ್ಹತ್‌ಹುಯಿನ್ ಖ್ಹಾರುಸ್ ಧರ್ತಿನಿ ಜೀವಿನ ಬರ್‌ಬಾತ್‌ ಕರಾನು ಪಾಣಿನು ತೋಫಾನ್ ಉಷೆಕೊಯ್ನಿ. <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />ಯೊ ಆಬ್‌ನು ಧೂಣ್‌ ಅಜು ವಾದ್‌ಳಾನ ದೇಖವಾನಿ ವಖ್ಹ್‌ತೆ ಮೇ ಇನ ದೇಖಿನ್ ದೇವ್‌ ಹುಯಿರ‍್ಹೋತೆ ಮನಾಬಿ ಧರ್ತಿಪರ್ ಛಾ಼ತೆ ಖ್ಹಾರುಸ್ ಜಾನ್ನು ಜ಼ಂತ್‌ನಾಬಿ ಹುಯುತೆ ಹಮೇಶಾನು ಒಪ್ಪಂದಾನ ಯಾದ್ ಕರಿಲಿಶ್‌. <verse eid="GEN 9:16" /><verse number="17" style="v" sid="GEN 9:17" />ಅಜು಼ ದೇವ್ನೆ ನೋಹಾನ “ಮನಾಬಿ ಖ್ಹಾರುಸ್ ಧರ್ತಿನ ಜೀವಿನ ಹುಯುತೆ ಒಪ್ಪಂದಾನ ಆಸ್ ಖ್ಹಣೇದ್” ಕರಿಬೋಲ್ಯೊ.<verse eid="GEN 9:17" /></para>
  <para style="s">ನೋಹಾಬಿ ಇನ ಛಿಯ್ಯಾ</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />ಜ಼ಹಾಜ್‌ಮಾಥು ನಿಕ್ಳಿಆಯಾತೆ ನೋಹಾನ ಛಿಯ್ಯಾ ಕೋಣ್‌ಕತೊ ಶೇಮ್‌, ಹಾಮ್‌, ಯೆಫೆತ್‌. ಹಾಮ್‌ ಕಾನಾನ್ನೊ ಬಾ. <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />ಅವ್ಣೇಸ್ ತೀನ್‌ಜ಼ಣ ನೋಹಾನ ಛಿಯ್ಯಾ ಅವ್ಣೆಥೀಸ್ ಉಬ್‌ಜಿನ್ ಧರ್ತಿಪರ್ ಜಿವವಾಳನ ಗುರುಗುರುಬ್‌ಲ್ಯ ಹುಯಿರ‍್ಹಾಸ್. <verse eid="GEN 9:19" /><verse number="20" style="v" sid="GEN 9:20" />ನೋಹ ಖೆತರ್‌ ನಾಗ್ರವಾಳೊ ಹುಯಿರೊಥೊ; ದ್ರಾಕ್ಷಿನಬಗೀಚಾ಼ನ ಪಹಿಲೆ ಬಣಾವನ ಶುರುಕರ‍್ಯೊತೆ ಅನೇಸ್. <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />ಏಕ್‌ದನ್ ಅನೆ ದ್ರಾಕ್ಷಿನ ರಖ್ಹ್‌ಪೀನ್‌ ಕೈಯೇಪ್ಛ಼ಡೀನ್ ಇನ ಡೇರಾನ ಘರ್ಮ ಉಘಾಡೊ ಹುಯಿನ್ ಪಡ್ಯೊಥೊ. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />ಕಾನಾನ್ನೊ ಬಾ ಹುಯಿರ‍್ಹೋತೆ ಹಾಮನೆ ಬಾ ಉಘಾಡೊ ಹುಯಿರೋತೆ ದೇಖಿನ್‌ ಭಾರ್‌ಥಾತೆ ಇನ ಭಯ್ಯೆ ಶೇಮ್‌ ಅಜು಼ ಯೆಫೆತ್‌ನ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />ತದೆ ಶೇಮ್‌ ಅಜು಼ ಯೆಫೆತ್‌ನೆ ಘುಂಗ್ಡಿನ ಪಾಡಿನ್ ಇವ್ಣ ಬೇಜ಼ಣಾನ ಖಾಂದೆ ನಾಖಿಲೀನ್‌ ಪೀಠೆಪೀಠೆ ಜೈ಼ನ್ ಉಘಾಡೊ ಥೋತೆ ಬಾನ ಹೋಡಾಯ. ಇವ್ಣೆ ಪೀಠೆಥಾತೆ ಇನಖ್ಹಾಜೆ ಬಾ ಉಘಾಡೊ ಹುಯಿರ‍್ಹವಾನು ದೇಖ್ಯಕೊಯ್ನಿ. <verse eid="GEN 9:23" /><verse number="24" style="v" sid="GEN 9:24" />ನೋಹ ಕಯೇಪ್‌ಥಿ ಹೋಷಾರಿ ಹುಯಿನ್ ನ್ಹಾನ ಛಿಯ್ಯಾನೆ ಕರ‍್ಯೊತೆ ಇನ ಮಾಲುಮ್‌ ಕರಿಲೀನ್, <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />“ಕಾನಾನನ ಶಾಪಹುವಾದೆ ಯೊ ಇನ ಭಯ್ಯೇನ ದಾಸ ಹುವಾದೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 9:25" /><verse number="26" style="v" sid="GEN 9:26" />ಇನೆ ಬಿಜೂ಼ಬಿ ಶಾತ್‌ಬೋಲ್ಯೊ ಕತೊ, “ಶೇಮ್‌ನೊ ದೇವ್‌ ಯೆಹೋವನ ಧನ್ಯವಾದ್‌ ಹುವಾದೆ; ಕಾನಾನ ಇವ್ಣುನ ದಾಸಹುವಾದೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 9:26" /><verse number="27" style="v" sid="GEN 9:27" />ಯೆಫೆತ್‌ನ ಛಾ಼ತೆ ಅಖ್ಖಾಸ್ನ ದೇವ್‌ ಘಣು ಭಡಾವದೆ, ಯೊ ಶೇಮ್‌ನ ಡೇರಾನ ಘರ್‌ಮ ರ‍್ಹೀನ್ ಜಿವ್ಣು ಕರಾದೆ, ಕಾನಾನ ಇವ್ಣುನ ದಾಸ ಹುಯಿರ‍್ಹವಾದೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 9:27" /><verse number="28" style="v" sid="GEN 9:28" />ತೋಫಾನ್ ಹುಯಿಜಾ಼ವಾದಿನ್ ನೋಹ ತೀನ್‌ಖ್ಹೊ ಅಢೈಖ್ಹ್‌ ವರಖ್ಹ್‌ ಬಚೀರ‍್ಹೊ. <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />ನೋಹ ಒಟ್‌ ನೌಖ್ಹೋ ಅಢೈಖ್ಹ್‌ ವರಖ್ಹ್‌ ಬಚಿರ‍್ಹೀನ್‌ ಮರ‍್ಯೊ.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">ನೋಹಾನ ಛಿಯ್ಯಾವ್ನಿ ಪಿಳ್ಗಿ</para>
  <para style="r">(<ref loc="1CH 1:5-23">1. ಪೂರ್ವ 1:5-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />ನೋಹಾನ ಛಿಯ್ಯಾ ಹುಯಿರಾತೆ ಶೇಮ್‌, ಹಾಮ್‌, ಯೆಫೆತ್‌ ಕರಿ ಬೋಲೈಲ್ಯವಾಳನಿ ಖೇಣಿ: ಪಾಣಿನು ತೋಫಾನ್‌ ಹುವಾನ ವಾರ್‌ ಇವ್ಣುನ ಲಡ್ಕ ಪೈದಹುಯ. <verse eid="GEN 10:1" /><verse number="2" style="v" sid="GEN 10:2" />ಯೆಫೆತ್‌ನ ಛಿಯ್ಯಾ ಕೋಣ್‌ಕತೊ; ಗೋಮೆರ್, ಮಾಗೋಗ್‌, ಮಾದಯ್‌, ಯಾವಾನ್‌, ತೂಬಲ್‌, ಮೆಷೆಕ್‌, ತೀರಾಸ್ ಕರಿ ಬೋಲೈಲ್ಯವಾಳು. <verse eid="GEN 10:2" /><verse number="3" style="v" sid="GEN 10:3" />ಗೋಮೆರ್‌ನು ಛಿಯ್ಯಾ ಅಷ್ಕೆನಸ್, ರೀಫತ್‌, ತೋಗರ್ಮ ಕರಿಬೋಲೈಲ್ಯವಾಳು. <verse eid="GEN 10:3" /><verse number="4" style="v" sid="GEN 10:4" />ಯಾವಾನನ ಛಿಯ್ಯಾ- ಎಲೀಷಾ, ತಾರ್ಷೀಷ್, ಕಿತ್ತೀಮ್‌, ದೋದಾಕರಿ ಝ಼ಗೊವಾಳು. <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />ಅವ್ಣೆ ದರ‍್ಯಾವ್ನ ಕನಾರೆನು ತಬರ್‌ಖಾಮ ಫೈಲೈಗಯು. ಅಜು ದೇಖ್ಹ್‌, ಬೋಲಿ, ಖೂಮ್‌ ಜಗ್‌ಜಾತ್‌ನಿ ಪರಕ್ಮ ಅವ್ಣೇಸ್ ಯೆಫೆತ್‌ನಿ ಪಿಳ್ಗಿವಾಳು. <verse eid="GEN 10:5" /><verse number="6" style="v" sid="GEN 10:6" />ಹಾಮ್‌ನಿ ಪಿಳ್ಗಿವಾಳು ಕೋಣ್‌ಕತೊ- ಕೂಷ್‌, ಮಿಚ್ರಯಿಮ್‌, ಪೂತ್‌, ಕಾನಾನ್‌ ಕರಿ ಬೋಲೈಲ್ಯವಾಳು. <verse eid="GEN 10:6" /><verse number="7" style="v" sid="GEN 10:7" />ಕೂಷನ ಛಿಯ್ಯಾ ಕೋಣ್‌ಕತೊ- ಸೆಬಾ, ಹವೀಲ, ಸಬ್ತಾ, ರಾಮ್ಹ, ಸಬ್ತಕಾ ಕರಿಬೋಲೈಲ್ಯವಾಳು. ರಾಮ್ಹನ ಛಿಯ್ಯಾ ಕೋಣ್‌ಕತೊ - ಶೆಬಾ, ದೆದಾನ್‌ <verse eid="GEN 10:7" /><verse number="8" style="v" sid="GEN 10:8" />ಕೂಷನೊ ಛಿಯ್ಯೊ ನಿಮ್ರೋದ ಯೊ ಧರ್ತಿಪರ್ನೊ ಪಹಿಲೊ ತಾಖತ್‌ವಾಳೊ ಹುಯಿರ‍್ಹೋಥೊ. <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />ಯೆಹೋವನಿ ನಜ಼ರ್‌ಮ ನಿಮ್ರೋದ ಶಿಕಾರ್‌ ಕರಾಮ ಶುಸ್ತಿ ಹುಯಿರ‍್ಹೊಥೊ. ಇನಖ್ಹಾಜೆ “ಯೆಹೋವ ದೇವ್‌ನೆ ತುನ ಶಿಕಾರ್‌ಕರಾಮ ಶುಸ್ತಿ ಬಣಾವದೆ” ಕರಿ ಮಶ್ಲೋ ಹಮ್ಕೆಲಗೂಬಿ ಬೋಲಾನುಛಾ಼. <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />ಶಿನಾರ್‌ ದೇಖ್ಹ್‌ಮ ಛಾ಼ತೆ ಬಾಬೆಲ್‌, ಯೆರೆಕ್‌, ಅಕ್ಕದ್, ಕಲ್ನೇ ಕರಿ ಖ್ಹಯೇರಸ್ ಇನು ರಾಜ್ಯನು ಜ಼ಮಾನಾನು ಖ್ಹಯೇರ್‌ಖ್ಹಾರು ಹುಯಿರ‍್ಹುಥು. <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />ಆಹೈರೋತೆ ಯೊ ದೇಖ್ಹ್‌ಥೊ ನಿಕ್ಳಿನ್ ಅಶ್ಯೂರ್‌ ದೇಖ್ಹ್‌ನ ಅಯಿನ್ ನಿನೆವೆ, ರೆಹೋಬೋತೀರ್, ಕೆಲಹ ಕರಿ ಅಖ್ಖಾಖ್ಹಯೇರ‍್ನಾಬಿ, <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />ಅನೆ ನಿನೆವೆನಾಬಿ, ಕೆಲಹನಾಬಿ ಇಚ಼್‍ಮಛಾ಼ತೆ ರೆಸೆನ್‍ಕರಿ ಮೊಟು ಖ್ಹಯೆರ್ಮ ಭಂದಾಯೊ. <verse eid="GEN 10:12" /><verse number="13" style="v" sid="GEN 10:13" />ಈಜಿಪ್ಟ್‌ವಾಳಥು ಲೂದ್ಯವಾಳು, ಅನಾಮ್ಯವಾಳು, ಲೆಹಾಬ್ಯವಾಳು, ನಫ್ತುಹ್ಯವಾಳು ಪೈದಹುಯು. <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />ಪತ್ರುಸ್ಯವಾಳು, ಕಸ್ಲುಹ್ಯವಾಳು, ಕಫ್ತೋರ್ಯವಾಳು ಫಿಲಿಷ್ಟಿಯವಾಳಥಿ ಪೈದಹುಯು. <verse eid="GEN 10:14" /><verse number="15" style="v" sid="GEN 10:15" />ಕಾನಾನ್ ಖಾನ್‌ದಾನ್‌ಮ ಪಹಿಲೆ ಪೈದಹುಯೋತೆ ಸೀದೋನ್; ಇನಪಾರ್ ಹೇತ್‌ ಪೈದಹುಯೊ. <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />ಆನಾಹುಯಿನ್ ಯೆಬೂಸಿಯವಾಳು, ಅಮೋರಿಯವಾಳು, ಗಿರ್ಗಾಷಿಯವಾಳು, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />ಹಿವ್ವಿಯವಾಳು, ಅರ್ಕಿಯವಾಳು, ಸೀನಿಯವಾಳು, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />ಅರ್ವಾದಿಯವಾಳು, ಚೆಮಾರಿಯವಾಳು, ಹದೋರಾಮವಾಳು, ಹಮತಿಯವಾಳು, ಕಾನಾನ್‍ಥಿ ಪೈದಹುಯಿನ್ ಇವ್ಣು ಖಾನ್‌ದಾನ್‌ ಫೈಲಾಯು. <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />ಕಾನಾನ್ಯವಾಳನು ತಬರ್‌ಖೊ ಸೀದೋನ್‍ ಖ್ಹಯೇರ್‌ಥು ಗೆರಾರ್‌ನ ಜಾ಼ವಾನಿ ವಾಟ್‍ಪರ್‌ಛಾ಼ತೆ ಗಾಜಾ ಖ್ಹಯೇರ್‌ಲಗೂಬಿ ಅಜು಼ ಸೊದೋಮ್, ಗೊಮೋರ್, ಅದ್ಮಾ, ಚೆಬೋಯಿಮ್‌ಕರಿ ಖ್ಹಯೇರ್‌ನ ಜಾ಼ವಾನಿ ವಾಟ್‌ಪರ್ ಛಾ಼ತೆ ಲೆಷಾ ಗಾಮ್‍ಲಗೂಬಿ ಫೈಲಾಯು. <verse eid="GEN 10:19" /><verse number="20" style="v" sid="GEN 10:20" />ಖೂಮ್‌, ಬೋಲಿ, ದೇಖ್ಹ್‌, ಜಗ್‌ಜಾತ್‌ನಿ ಪರಕ್ಮ ಅವ್ಣೇಸ್ ಹಾಮ್‍ನು ಪಿಳ್ಗಿವಾಳು. <verse eid="GEN 10:20" /><verse number="21" style="v" sid="GEN 10:21" />ಇಬ್ರಿಯವಾಳಾನ ಶುರುನೊ ಪರ್ಖ್ಹೊಬಿ, ಯೆಫೆತ್‌ನೊ ಮೋಟೊ ಭೈಬಿ ಹುಯಿರ‍್ಹೋಥೊತೆ ಶೇಮ್‌ನಾಬಿ ಲಡ್ಕ ಪೈದಹುಯ. <verse eid="GEN 10:21" /><verse number="22" style="v" sid="GEN 10:22" />ಶೇಮ್‌ನ ಛಿಯ್ಯಾ, ಏಲಾಮ್, ಅಶ್ಯೂರ್‌, ಅರ್ಪಕ್ಷದ್, ಲೂದ್, ಅರಾಮ್ ಕರಿ ಬೋಲೈಲ್ಯಾವಾಳು. <verse eid="GEN 10:22" /><verse number="23" style="v" sid="GEN 10:23" />ಅರಾಮ್‍ನಿ ಖಾನ್‌ದಾನ್‌ವಾಳು, ಊಸ್, ಹೂಲ್, ಗೆತೆರ್, ಮಷ್ ಕರಿಬೋಲೈಲ್ಯವಾಳು. <verse eid="GEN 10:23" /><verse number="24" style="v" sid="GEN 10:24" />ಅರ್ಪಕ್ಷದಥಿ ಶೆಲಹಬಿ, ಶೆಲಹ ಎಬರನೊ ಬಾ ಹುಯಿರ‍್ಹೋಥೊ. <verse eid="GEN 10:24" /><verse number="25" style="v" sid="GEN 10:25" />ಎಬರನ ಬೇ ಛಿಯ್ಯಾ ಪೈದಹುಯ. ಏಕ್‍ಜ಼ಣಾನ ಪೆಲೆಗ ಕರಿ ನಾಮ್; ಶನಕತೊ ಇನ ಹಗಾಮ್ಮ ಧರ್ತಿ ಭಾಗ್‌ಪಡೈಗಿ. ಇನ ನ್ಹಾನ ಭೈನು ನಾಮ್ ಯೊಕ್ತಾನ್. <verse eid="GEN 10:25" /><verse number="26" style="v" sid="GEN 10:26" />ಯೊಕ್ತಾನ್‍ನು ಪಿಳ್ಗಿವಾಳು, ಅಲ್ಮೋದಾದ್, ಶೆಲೆಪ್, ಹಚರ್ಮಾವೆತ್, ಯೆರಹ, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />ಹದೋರಾಮ್, ಊಜಾಲ್, ದಿಕ್ಲಾ, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />ಓಬಾಲ್, ಅಬೀಮಯೇಲ್, ಶೆಬಾ, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />ಓಫೀರ್, ಹವೀಲ, ಯೋಬಾಬ್‌ಕರಿ ಅವ್ಣೆ ಯೊಕ್ತಾನಥಿ ಪೈದಹುಯು. <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />ಅವ್ಣೆ ಜಿವ್‌ಕರ್ತುಥುತೆ ಝ಼ಗೊ ಮೇಶಾ ತಬರ್‌ಖಾಥು ಧರೀನ್ ಪೂರಬ್‌ ದಿಕ್ಮಛಾ಼ತೆ ಸೆಫಾರ್‌ಕರಿ ಪಹಾಡ್‌ಲಗೂಬಿ ಫೈಲೈರ‍್ಹೂಥು. <verse eid="GEN 10:30" /><verse number="31" style="v" sid="GEN 10:31" />ಖೂಮ್‌, ಬೋಲಿ, ಜಗ್‌ಜಾತ್‌ನಿ ಪರಕ್ಮ ಅವ್ಣೇಸ್ ಶೇಮ್‌ನು ಪಿಳ್ಗಿವಾಳು. <verse eid="GEN 10:31" /><verse number="32" style="v" sid="GEN 10:32" />ಜಗ್‌ಜಾತ್‌ನಿ ಪಿಳ್ಗಿನಿ ಪರಕ್ಮ ಅವ್ಣೇಸ್ ನೋಹಾನು ಖೂಮ್‌ವಾಳು. ಪಾಣಿನು ತೋಫಾನ್‌ಹುಯುತೆ ಇನವಾರ್ ಧರ್ತಿಪರ್ ಫೈಲೈಗಯೂತೆ ಖಾನ್‌ದಾನ್‌ವಾಳು ಅವ್ಣೇಸ್.<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">ಬಾಬೆಲ್‌ ಗುಮಜ಼್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />ತದೆ ಜಗತ್ನ ಖ್ಹಾರಸ್‌ನ ಎಕ್ಕಸ್ ಬೋಲಿ; ಎಕ್ಕಸ್‌ವಾತೆ ಥೂ. ಬೋಲಿಮ ಪರಕ್‌ಶಾತ್‌ಬಿ ಕೋಥೂನಿ. <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />ಅದ್ಮೇವ್‌ ಪೂರಬ್‌ ದಿಕ್ಮ ಚಾ಼ಲ್ತುಜಾ಼ವಾನಿ ವಖ್ಹತ್‌ಮ <note caller="+" style="f"><char style="fr" closed="false">11:2 </char><char style="ft" closed="false">ಬಾಬಿಲೋನ್</char></note>ಶಿನಾರ್‌ ದೇಖ್ಹ್‌ನು ಬಲ್‌ಡಾನು ತಬರ್‌ಖೊ ದೇಖಿನ್ ಹಿಜ಼್ಜಾಸ್ ರ‍್ಹಿಗಯು. <verse eid="GEN 11:2" /><verse number="3" style="v" sid="GEN 11:3" />ಇವ್ಣೆಖ್ಹಾರುಸ್, “ಆವೊ, ಅಪ್ಣೆ ಈಟ್‌ ಬಣೈನ್ ಅಛ್ಛಿನಿತರ ಭುಂಜಿಯೆ” ಕರಿ ಏಕ್‌ಥಿ ಎಕ್ ಬೋಲಿಲಿದು. ಇವ್ಣೆ ಬಂಡಾನ ಬದಲ್‌ ಈಟ್‌ನ, ಚು಼ನ್ನಾನ ಬದಲ್ ಡಾಂಬರ್‌ಥಿ ಕಾಮ್‌ಕರ‍್ಯು. <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />ಇವ್ಣೆ, “ಆವೊ, ಎಕ್ ಖ್ಹಯೇರ್‌ ಭಾಂದಿಯೆ ಆಬ್‌ನ ಛೀಮಾಖ್ಹರ್ಕು ಎಕ್ ಗುಮಜ಼್‌ನ ಭಾಂದಿನ್ ಮೊಟು ನಾಮ್‌ ಕಮೈಯೇ; ಅಮ್‌ ಕರ‍್ಯುತೊ ಧರ್ತಿಪರ್ ಅಪ್ಣೆಖ್ಹಾರು ಛಿಡ್‌ಕೈಜಾ಼ವಖ್ಹರ್ಕು ಉಶೆಕೊಯ್ನಿ” ಕರಿ ಇವ್ಣ ಇವ್ಣಾಮ ಬೋಲಿಲಿದು. <verse eid="GEN 11:4" /><verse number="5" style="v" sid="GEN 11:5" />ಅದ್ಮೆವ್‌ನೆ ಭಾಂದು ಕರ್ತುಥೂತೆ ಯೊ ಖ್ಹಯೇರ್‌ನಾಬಿ, ಗುಮಜ಼್‌ನಾಬಿ ದೇಖಾನ ಯೆಹೋವ ದೇವ್‌ ಉತ್ರಿನ್ ಆಯೊ. <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />ಯೆಹೋವ ದೇವ್ನೆ ದೇಖಿನ್, “ಅವ್ಣೆ ಎಕ್ಕಸ್ ಜ಼ಗ್‌ಜಾ಼ತ್; ಅವ್ಣುನ ಖ್ಹಾರಾಸ್ನ ಎಕ್ಕಸ್‌ಬೋಲಿ, ಆ ಅವ್ಣೆ ಶುರುವಾತ್‌ಮಾಸ್‌ ಕರಾನಿ ಖ್ಹೂಜ಼್ ಅವ್‌ಡಿ. ಅನಪಾರ್‌ ಅವ್ಣೆ ಶಾತ್‌ ಹೋಣುತೊಬಿ ಕರಾಖ್ಹರ್‌ಕು ಛಾ. <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />ಅವ್ಣಾಮ ಏಕ್‌ನಿ ಬೋಲಿ ಏಕ್‌ನ ಮಾಲುಮ್‌ ನಾಪಡ್ನುತೆ ತಿಮ್‌ ಅವ್ಣಿ ಬೋಲಿನ ಕಲಾವ್ಣಿ ಕರಿನಾಖಿಯೇ ಆವೊ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 11:7" /><verse number="8" style="v" sid="GEN 11:8" />ಅಮ್ ಯೆಹೋವನೆ ಯೋಸ್ ಪರಕ್ಮ ಇವ್ಣುನ ಧರ್ತಿಪರ್ ಖ್ಹಾರುಸ್ ಛಿಡ್‌ಕಿನಾಖ್ಯೊ. ತದೆ ಇವ್ಣೆ ಯೊ ಖ್ಹಯೇರ್ ಭಾಂದಾನ ಭೀರಾಖಿದಿದು. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />ತಮಾಮ್‌ ಜಗತ್‌ನು ಬೋಲಿನ ಯೆಹೋವ ದೇವ್ನೆ ಹಿಜ್ಜಾ಼ ಕಲಾವ್ಣಿಕರೀನ್, ಇವ್ಣುನ ಧರ್ತಿಪರ್ ಛಿದ್‌ರೈನಾಖಿದಿದೊತೆ ಇನಖ್ಹಾಜೆ ಯೊ ಖ್ಹಯೇರ್‌ನ “ಬಾಬೆಲ್‌” ಕರಿ ನಾಮ್‌ಹುಯು.<verse eid="GEN 11:9" /></para>
  <para style="s">ಶೇಮ್‌ನಿ ಪಿಳ್ಗಿ</para>
  <para style="r">(<ref loc="1CH 1:24-27">1. ಪೂರ್ವ 1:24-27</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />ಶೇಮ್‌ನ ಖಾನ್‌ದಾನ್ನಮಾಥ: ಪಾಣಿನು ತೋಫಾನ್‌ಜೈನ್ ಬೇ ವರಖ್ಹ್‌ನ ಬಾದ್ಮ ಶೇಮ್‌ ಖ್ಹೊ ವರಖ್ಹ್‌ನೊ ಹುಯಿನ್ ಅರ್ಪಕ್ಷದನ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />ಶೇಮ್‌ ಅರ್ಪಕ್ಷದನ ಪೈದಕರಾನ ಬಾದ್‌ಮ ಪರ್ಖ್ಹೊ ಅಜು಼ ತಯೇಡ ಲಡ್ಕಾನ ಪೈದಕರೀನ್ ಪಾಚ಼್‌ಖ್ಹೊ ವರಖ್ಹ್‌ ಬಚಿರ‍್ಹೊ. <verse eid="GEN 11:11" /><verse number="12" style="v" sid="GEN 11:12" />ಅರ್ಪಕ್ಷದನೆ ಪಾಚ಼್‌ಉಪ್ಪರ್‌ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳೊ ಹುಯಿನ್ ಶೆಲಹನ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />ಅರ್ಪಕ್ಷದನೆ ಶೆಲಹನ ಪೈದಕರಾನ ಬಾದ್ಮ ಪರ್ಖ್ಹೊ ತಯೇಡ ಲಡ್ಕಾವ್ನ ಪೈದಕರೀನ್ ಚಾರ್‌ಖ್ಹೊ ತೀನ್ ವರಖ್ಹ್ ಬಚಿರ‍್ಹೊ. <verse eid="GEN 11:13" /><verse number="14" style="v" sid="GEN 11:14" />ಶೆಲಹ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳೊ ಹುಯಿನ್ ಎಬರನ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />ಶೆಲಹ ಎಬರನ ಪೈದಕರಾನ ಬಾದ್ಮ ಪರ್ಖ್ಹೊ ತಯೇಡ ಲಡ್ಕಾವ್ನ ಪೈದಕರೀನ್ ಚಾರ್‌ಖ್ಹೊ ತೀನ್ ವರಖ್ಹ್‌ ಬಚಿರ‍್ಹೊ. <verse eid="GEN 11:15" /><verse number="16" style="v" sid="GEN 11:16" />ಎಬರ ಚಾರ್‌ಉಪ್ಪರ್‌ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳೊ ಹುಯಿನ್ ಪೆಲೆಗನ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />ಎಬರನೆ ಪೆಲೆಗನ ಪೈದಕರಾನ ಬಾದ್ಮ ಪರ್ಖ್ಹೊ ತಯೇಡ ಲಡ್ಕಾವ್ನ ಪೈದಕರೀನ್ ಚಾರ್‌ಖ್ಹೊ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್‌ ಬಚಿರ‍್ಹೊ. <verse eid="GEN 11:17" /><verse number="18" style="v" sid="GEN 11:18" />ಪೆಲೆಗ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳೊ ಹುಯಿನ್ ರೆಗೂವನ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />ಪೆಲೆಗನೆ ರೆಗೂವನ ಪೈದಕರಾನ ಬಾದ್ಮ ಪರ್ಖ್ಹೊ ತಯೇಡ ಲಡ್ಕಾವ್ನ ಪೈದಕರೀನ್ ಬೇಖ್ಹೊ ನೌ ವರಖ್ಹ್‌ ಬಚಿರ‍್ಹೊ. <verse eid="GEN 11:19" /><verse number="20" style="v" sid="GEN 11:20" />ರೆಗೂವನೆ ಬೇಉಪ್ಪರ್‌ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳೊಹುಯಿನ್ ಸೆರೂಗನ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />ಸೆರೂಗನೆ ರೆಗೂವನ ಪೈದಕರಾನ ಬಾದ್ಮ ಪರ್ಖ್ಹೊ ತಯೇಡ ಲಡ್ಕಾವ್ನ ಪೈದಕರೀನ್‌ ಬೇಖ್ಹೊ ಖ್ಹಾತ್ ವರಖ್ಹ್‌ ಬಚಿರ‍್ಹೊ. <verse eid="GEN 11:21" /><verse number="22" style="v" sid="GEN 11:22" />ಸೆರೂಗ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳೊಹುಯಿನ್ ನಾಹೋರನ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />ಸೆರೂಗನ ನಾಹೋರನ ಪೈದಕರಾನ ಬಾದ್‌ಮ ಪರ್ಖ್ಹೊ ತಯೇಡ ಲಡ್ಕಾವ್ನ ಪೈದಕರೀನ್ ಬೇಖ್ಹೊ ವರಖ್ಹ್‌ ಬಚಿರ‍್ಹೊ. <verse eid="GEN 11:23" /><verse number="24" style="v" sid="GEN 11:24" />ನಾಹೋರನೆ ಎಕ್ಕಮ್‌ ಡೋಡೀಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳೊಹುಯಿನ್ ತೆರಹನ ಪೈದಕರ‍್ಯೊ. <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />ನಾಹೋರ ತೆರಹನ ಪೈದಕರಾನ ಬಾದ್‌ಮ ಪರ್ಖ್ಹೊ ತಯೇಡ ಲಡ್ಕಾವ್ನ ಪೈದಕರೀನ್‌ ಏಕ್‌ಖ್ಹೊ ಎಕ್ಕಮ್‌ವೀಖ್ಹ್‌ ವರಖ್ಹ್‌ ಬಚಿರ‍್ಹೊ. <verse eid="GEN 11:25" /><verse number="26" style="v" sid="GEN 11:26" />ತೆರಹನೆ ಖ್ಹಡ್‌ತೀನಿಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳೊ ಹುವಾನ ಬಾದ್ಮ ಅಬ್ರಾಮ, ನಾಹೋರ್‌, ಹಾರಾನ್‌ಕರಿ ಲಡ್ಕಾವ್ನ ಪೈದಕರ‍್ಯೊ.<verse eid="GEN 11:26" /></para>
  <para style="s">ತೆರಹನು ಪಿಳ್ಗಿ</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />ತೆರಹನು ಖಾನ್‌ದಾನ್ನು ಖೇಣಿ; ತೆರಹನೆ ಅಬ್ರಾಮ, ನಾಹೋರ್‌, ಹಾರಾನ್‌ಕರಿ ಅವ್ಣುನ ಪೈದಕರ‍್ಯೊ. ಹಾರಾನ್‌ ಲೋಟನೊ ಬಾ. <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />ಹಾರಾನ್‌ ಪೈದಾಖ್ಹ್ ಹುಯೊತೆ ಇನು ಶೊಂತ್ ಬಾಬಿಲೋನ್ನು ಊರ್‌ಕರಿ ಖ್ಹಯೇರ್‌ಮ ಇನೊ ಬಾ ಹುಯಿರೋತೆ ತೆರಹನ ಖ್ಹಾಮ್ಣೇಸ್ ಮರ‍್ಯೊ. <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />ಅಬ್ರಾಮ್‌ಬಿ ನಾಹೋರಬಿ ವ್ಯಾಹ ಕರಿಲಿದ. ಅಬ್ರಾಮನಿ ಬಾವಣ್ಣು ನಾಮ್‌ ಸಾರಯ, ನಾಹೋರನಿ ಬಾವಣ್ಣು ನಾಮ್‌ ಮಿಲ್ಕಾ. ಆ ಹೈರಿತೆ ಹಾರಾನ್ನಿ ಛೋ಼ರಿ; ಹಾರಾನ ಮಿಲ್ಕಾನಾಬಿ ಇಸ್ಕನಾಬಿ ಬಾ ಹುಯಿರ‍್ಹೋಥೊ. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />ಸಾರಯ ವಾಂಝ಼್‌ಣಿಥೀತೆ ಇನಖ್ಹಾಜೆ ಇನ ಲಡ್ಕ ಕೋಥಾನಿ. <verse eid="GEN 11:30" /><verse number="31" style="v" sid="GEN 11:31" />ತೆರಹನೆ ಇನೊ ಛಿಯ್ಯೊ ಹುಯಿರೋತೆ ಅಬ್ರಾಮನಾಬಿ, ಅಜು಼ ಇನ ನಾತ್ಯೊಬಿ ಹಾರನನೊ ಛಿಯ್ಯೊ ಲೋಟನಾಬಿ, ಇನ ವ್ಹವ್‌ಬಿ ಅಬ್ರಾಮ್‌ನಿ ಬಾವಣ್‌ಬಿ ಹುಯಿರೀತೆ ಸಾರಯನಬಿ ಬುಲೈಲೀನ್ ಕಾನಾನ್‌ ದೇಖ್ಹ್‌ನ ಜಾ಼ವ್ಣುಕರಿ ಬಾಬಿಲೋನ್ನು ಊರ್‌ಕರಿ ಖ್ಹಯೇರ್‌ನ ಜಾ಼ವ್ಣುಕರಿ ಥಾ, ಜಾ಼ವಾನಿವಖ್ಹ್‌ತೆ ಇವ್ಣೆ ಹಾರಾನ್‌ ಖ್ಹಯೇರ್‌ನ ಅಯಿನ್ ಹಿಜ್ಜಾ಼ಸ್ ಜಿವ್ಣು ಕರ‍್ಯೊ. <verse eid="GEN 11:31" /><verse number="32" style="v" sid="GEN 11:32" />ತೆರಹನೆ ಬೇಖ್ಹೊ ಪಾಚ಼್‌ ವರಖ್ಹ್‌ ಬಚಿನ್, ಇನ ಬಾದ್ಮ ಹಾರಾನ್‌ಮ ಮರ‍್ಯೊ.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">ದೇವ್ನೆ ಅಬ್ರಾಮ್‌ನ ಬುಲಾಯೋತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />ಯೆಹೋವ ದೇವ್‌ನೆ ಅಬ್ರಾಮ್‌ನ, “ತೂ ತಾರ ಶೊಂತ್‌ ದೇಖ್ಹ್‌ನಾಬಿ, ಮಾಯಮಾತ್ರನ ಅಜು಼ ಬಾನ ಘರ್‌ನ ಮ್ಹೇಲಿನ್‌ ಮೇ ವತಾಳುತೆ ದೇಖ್ಹ್‌ನ ಚ಼ಲ್ಯೊಜಾ಼ <verse eid="GEN 12:1" /><verse number="2" style="v" sid="GEN 12:2" />ಮೇ ತುನ ಮೋಟೊ ದೇಖ್ಹ್‌ ಬಣಾವುಸ್‌, ಮೇ ತುನ ಆಶೀರ್ವಾದ್‌ ದೆವುಸ್‌, ತಾರ ನಾಮ್ನ ಮೊಟು ಕರುಸ್‌, ತೂ ಆಶೀರ್ವಾದ್‌ನು ನಿಧಿ ಹುಯಿರಿಶ್. <verse eid="GEN 12:2" /><verse number="3" style="v" sid="GEN 12:3" />ತುನ ಆಶೀರ್ವಾದ್‌ ಕರವಾಳನ ಮೇ ಆಶೀರ್ವಾದ್‌ ದೆವುಸ್‌; ತುನ ಹೇಟ್‌ಲಿ ನಜ಼ರ್‌ಥಿ ದೇಖವಾಳಾನ ಮೇ ಶಾಪ್ ದೆವುಸ್‌. ತಾರೇಥಿ ಧರ್ತಿನು ಖ್ಹಾರಸ್ ಖಾನ್‌ದಾನ್ನ ಆಶೀರ್ವಾದ್‌ ಉಶೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 12:3" /><verse number="4" style="v" sid="GEN 12:4" />ಯೆಹೋವ ದೇವ್ನೆ ಬೋಲ್ಯೋತೆ ಪರಕ್ಮಾಸ್ ಅಬ್ರಾಮ ಚ಼ಲೇಗಯೊ. ಲೋಟಾಬಿ ಇನ ಜೋ಼ಡೆಗಯೊ. ಅಬ್ರಾಮನೆ ಹಾರಾನ್‌ ಖ್ಹಯೇರ್‌ನ ಮ್ಹೇಲಿನ್ ಜಾ಼ವನಿವಖ್ಹ್‌ತೆ ಪಾಚ಼್‌ಉಪ್ಪರ್‌ ಖ್ಹಡ್‌ತೀನಿಖ್ಹ್‌ ವರಖ್ಹ್‌ನೊ ಹುಯಿರ‍್ಹೊಥೊ. <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />ಅಬ್ರಾಮನೆ ಇನಿ ಬಾವಣ್‍ ಸಾರಯನಬಿ, ಇನೊ ನ್ಹಾನ ಭೈನೊಛಿಯ್ಯೊ ಲೋಟನಾಬಿ, ಇನೇಬಿ ಲೋಟಬಿ ಹಾರಾನ್‌ಮ ಕಮಾಯತೆ ಖ್ಹಾರೀಸ್‍ ಶೊತ್‌ನಾಬಿ, ದಾಸ, ದಾಸಿನಾಬಿ ಲೀನ್‌ ಕಾನಾನ್‌ ದೇಖ್ಹ್‌ನ ನಿಕ್‌ಳ್ಯೊ. ಇವ್ಣೆ ಕಾನಾನ್‌ ದೇಖ್ಹ್‌ನ ಛಿಮಾನಿವಖ್ಹ್‌ತೆ, <verse eid="GEN 12:5" /><verse number="6" style="v" sid="GEN 12:6" />ಅಬ್ರಾಮನೆ ಯೊ ದೇಖ್ಹ್‌ಮ ಫರ್‌ತೊಹುಯಿನ್ ಶೆಕೆಮ್‌ ಝ಼ಗೋಮರ‍್ಹವಾನು ಪರಿಶುದ್ದ ‘ಮೋರೆ’ ಝಾ಼ಡಲಗು ಆಯೊ. ಯೊ ಹಗಾಮ್ಮ ಕಾನಾನ್ಯವಾಳು ದೇಖ್ಹ್‌ಮ ಥು. <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />ಹಿಜ್ಜಾ಼ ಯೆಹೋವ ದೇವ್ನೆ ಅಬ್ರಾಮ್‌ನ ದರ್ಶನ್‌ಮ, “ಮೇ ಆ ದೇಖ್ಹ್‌ನ ತಾರಿ ಪಿಳ್ಗಿವಾಳನ ದೆವುಸ್‌” ಕರಿಬೋಲ್ಯೊ. ಇನ ದರ್ಶನ ದಿದೋತೆ ಯೆಹೋವದೇವ್ನ ಅಬ್ರಾಮ್‌ನೆ ಚಾ಼ಚ಼ರ್‌ನ ಭಂದಾಯೊ. <verse eid="GEN 12:7" /><verse number="8" style="v" sid="GEN 12:8" />ಯೊ ಹಿಜ್ಜಾ಼ಥೋ ನಿಕ್ಳಿನ್ ಬೇತೇಲ್‌ನು ಪೂರಬ್‌ಮಛಾ಼ತೆ ಟಿಮ್ಮಾಕನ ಅಯಿನ್ ಇನೊ ಡೇರೊನಾಖಿನ್‌ ರ‍್ಹಿಗಯೊ. ಹಿಜ಼್ಜಾಥು ಪಶ್ಚಿಮ್ ದಿಕ್ಮ ಬೇತೇಲ್‌, ಪೂರಬ್‌ಮ ಆಯಿಕರಿ ಗಾಮ್‌ಥು. ಹಿಜ್ಜಾ಼ಬಿ ಅಬ್ರಾಮನೆ ಚಾ಼ಚ಼ರ್‌ನ ಭಂದೈನ್ ಯೆಹೋವನ ಆರಾದನೆ ಕರ‍್ಯೊ. <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />ಇನವಾರ್ ಅಬ್ರಾಮ್‌ನೆ ಹಿಜ್ಜಾ಼ಥೊ ನಿಕ್ಳಿನ್ ಕಾನಾನ್‌ ದೇಖ್ಹ್‌ನು ದಕ್ಷಿಣ್‌ ತಬರ್‌ಖಾನ ಚಾ಼ಲ್ತೊಹುಯಿನ್ ಗಯೊ.<verse eid="GEN 12:9" /></para>
  <para style="s">ಈಜಿಪ್ಟ್‌ಮ ಅಬ್ರಾಮ</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />ಯೊ ವೇಳ್ಮ ಧರ್ತಿಪರ್ ಘಣು ಕಾಳ್‌ದುಕಾಳ್‌ಥೂತೆ ಇನಖ್ಹಾಜೆ, ಅಬ್ರಾಮ್‌ನೆ ಈಜಿಪ್ಟ್‌ದೇಖ್ಹ್‌ಮ ಚ಼ಲೇಗೊ. ಯೊ ಕಾಳ್‌ದುಕಾಳ್ ಘಣು ಕಠಣ್‌ ಥು. <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />ಯೊ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಖನ್ನೆ ಆವಾನಿ ವಖ್ಹ್‌ತೆ ಇನಿ ಬಾವಣ್‍ ಹುಯಿರ‍್ಹೀತೆ ಸಾರಯನ, “ಖ್ಹಮಜ಼್‌, ತೂ ಘಣಿ ಶನ್‌ಗಾರ್‌ನಿ ತಯೇಡಕರಿ ಮನ ಮಾಲುಮ್‌; <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ವಾಳು ತುನ ದೇಖಿನ್‌, ಆ ಹೈರಿತೆ ಅನಿ ಬಾವಣ್‌ಕರಿ ಮಾಲುಮ್‌ ಕರಿಲೀನ್‌ ಮನ ಮಾರಿನಾಖಿನ್‌ ತುನ ಬಚಾ಼ಡೆಜಾ಼ಯ್‌. <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />ಇನಖ್ಹಾಜೆ ತೂ ಮನ ನ್ಹಾನಿ ಭೇನ್‍ಕರಿ ಇವ್ಣುನ ಬೋಲ್; ಅಮ್‌ ಬೋಲಿತೊ ತಾರೇಥಿ ಮನ ಅಛ಼್ಛುಉಷೆ, ಮೇ ತಾರಖ್ಹಾಜೇಥಿ ಮರಿಶ್‌ಕೊಂತೆ ಬಚಿಶ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 12:13" /><verse number="14" style="v" sid="GEN 12:14" />ಅಬ್ರಾಮ್‌ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಆವಾನಿ ವಖ್ಹ್‌ತೆ ಈಜಿಪ್ಟ್‌ವಾಳು ಇನ ಜೋ಼ಡ್ಮಥೀತೆ ತಯೇಡನ ದೇಖಿನ್ ಘಣಿ ಶನ್‌ಗಾರ್‌ವಾಳಿ ಕರಿ ಬೋಲಿಲಿದು. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />ಫರೋಹನ ಆಸ್ಥಾನ್ನ ಅದಿಕಾರಿಯೇವ್ನೆ ಯೊ ಹೈರೀತೆನ ದೇಖಿನ್‌ ರಾಜ಼ನ ಖ್ಹಾಮ್ಣೆ ಖ್ಹರಾವಖ್ಹತರ್‌ ಫರೋಹನೆ ಯೊ ತಯೇಡಾನ ಮಹೇಲ್‌ಕನ ಬುಲೈಮಂಗೈನ್‌ ಆ ಹೈರೀತೆನಖ್ಹಾಜೆ ಅಬ್ರಾಮ್‌ನ ಮದತ್ ಕರ‍್ಯು. <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />ತದೆ ಅಬ್ರಾಮ್‌ನ ಢಾಂಡು, ಮೇಂಢು, ಗಧೇಡ ಗಧೇಡಿವ್‌ಖ್ಹಾರು, ದಾಸದಾಸಿಖ್ಹಾರು, ಊಟ್‌ಖ್ಹಾರು ಮಳ್ಯು. <verse eid="GEN 12:16" /><verse number="17" style="v" sid="GEN 12:17" />ಕತೋಬಿ ಯೆಹೋವ ದೇವ್ನೆ ಫರೋಹನಾಬಿ ಇನ ಘರ್‌ವಾಳನಾಬಿ ಅಬ್ರಾಮ್‌ನಿ ಬಾವಣ್‍ ಸಾರಯನಖ್ಹಾಜೆ ಘಣು ಖ್ಹತಾಪ್ಣಿದೀನ್ ಖ್ಹತಾಯೊ. <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />ತದೆ ಫರೋಹಾನೆ ಅಬ್ರಾಮ್‌ನ ಬುಲೈಮಂಗೈನ್‌, “ತೂ ಶನಾ ಅಮ್‌ ಕರ‍್ಯೊ? ಯೊ ತಾರಿ ಬಾವಣ್‌ಕರಿ ಮನ ಶನಾ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊಕೊಯ್ನಿ? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />ನ್ಹಾನಿ ಭೇನ್‍ಕರಿ ಶನಾ ಬೊಲ್ಯೊ? ಅಮ್‌ ಬೋಲ್ಯೊತೆ ಇನಖ್ಹಾಜೆ ಹೈರಿತೇನ ಬಾವಣ್‌ಕರಿ ಮೆ ರಾಖಿಲ್ಯಾವನಥೋನಿ ಹಂದೇಕ್ ತಾರಿ ಬಾವಣ್‍! ಬುಲೈಲೀನ್ ಜಾ಼” ಕರಿಬೋಲ್ಯೊ, <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />ಫರೋಹನೆ ಅಬ್ರಾಮ್‌ನಿ ಬಾರೇಮ ಇನು ಚಾ಼ಕ್ರಿವಾಳನ ಹುಕುಮ್‌ ದೇವಖ್ಹತರ್‌ ಇವ್ಣೆ ಅಬ್ರಾಮ್‌ನಾಬಿ, ಇನಿ ಬಾವಣ್ಣಾಬಿ ಇನಥೂತೆ ಅಖ್ಖಾಸ್ನ ಖ್ಹಮೇದ್ ಮೋಕ್ಲಿದಿದು.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">ಅಬ್ರಾಮ್‌ ಲೋಟಾಥಿ ಅಲಕ್‌ಹುಯೋತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />ಅಮ್‌ ಅಬ್ರಾಮ್‌ನೆ ಇನುಥೂತೆ ಖ್ಹಾರಾಸ್ನಲೀನ್‌ ಬಾವಣ್ಣಾಬಿ ಲೋಟನಾಬಿ ಜೋ಼ಡ್ಮ ಬುಲೈಲೀನ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಮ್ಹೇಲಿನ್ ಕಾನಾನ್‌ ದೇಖ್ಹ್‌ನು ದಕ್ಷಿಣ್ ತಬರ್‌ಖಾಮ ಆಯೊ. <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />ಅಬ್ರಾಮ ಘಣು ಧನ್‌ದೌಲತ್‌ವಾಳೊ ಹುಯಿರ‍್ಹೋಥೊ. ಢಾಂಡು ಬೋಕ್ಡು ಮೇಂಢು ಖ್ಹೋನ್ನು ರೂಪುಬಿ ಥು. <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />ಯೊ ದಕ್ಷಿಣ್ ಮುಲಕ್ನ ಮ್ಹೇಲಿನ್ ಅಗಾಡಿ ಚಾ಼ಲ್ತೊಹುಯಿನ್ ಬೇತೇಲ್‌ಲಗು ಕತೊ ಬೇತೇಲ್‌ನಾಬಿ ಆಯಿಕರಿ ಗಾಮ್‌ನ ಪೂರಬ್‌ಮ ಇಚ಼್‌ಮ ಡೇರೊ ನಾಖಿರಾಖ್ಯೊಥೊ. <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />ಚಾ಼ಚ಼ರ್‌ನ ಭಾಂದಿಹುಯಿ ಝಗೋಕನ ಅಬ್ರಾಮ್‌ ಪಾಛೊ಼ಫರಿ ಆಯೊ, ಹಿಜ್ಜಾ಼ ಯೆಹೋವನ ನಾಮ್‌ಪರ್‌ ಆರಾದನೆ ಕರ‍್ಯೊ. <verse eid="GEN 13:4" /><verse number="5" style="v" sid="GEN 13:5" />ಅಬ್ರಾಮ್‌ನಿ ಜೋ಼ಡ್ಮಥೂತೆ ಲೋಟನಾಬಿ ಮೇಂಢು, ಢಾಂಡು, ಡೇರಾನು ಘರ್‌ಖ್ಹಾರು ಥು. <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />ಇನಖ್ಹಾಜೆ ಇವ್ಣ ಭೇಜ಼ಣಾನ ಜಿವ್ಣಾನ ಝ಼ಗೊ ಪೂರ‍್ಯುಕೊಂತೆ ಹುಯಿಗು. <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />ಅನಖ್ಹಾಜೆ ಅಬ್ರಾಮ್‌ನ ಢಾಂಡ ಚ಼ರಾವವಾಳಮಾಬಿ ಲೋಟನ ಢಾಂಡ ಚ಼ರಾವವಾಳಮಾಬಿ ಲಡೈಹೊತುಥು. ಆ ನಾಹುಯಿನ್ ಕಾನಾನ್ಯವಾಳುಬಿ ಪೆರಿಜೀಯವಾಳೂಬಿ ಯೊ ಹಗಾಮ್ಮ ಯೋಸ್ ದೇಖ್ಹ್‌ಮ ಜಿವ್ಣುಕರುಕರ್ತುಥು. <verse eid="GEN 13:7" /><verse number="8" style="v" sid="GEN 13:8" />ಅಮ್‌ರ‍್ಹಾವಪರ್‌ ಅಬ್ರಾಮ್‌ನೆ ಲೋಟನ, “ಮನಾಬಿ ತುನಾಬಿ, ಮಾರ ಢಾಂಡ ಚ಼ರಾವವಾಳನಾಬಿ ತಾರ ಢಾಂಡ ಚ಼ರಾವವಾಳನಾಬಿ ಲಡೈನಾಹೋಣು; ಅಪ್ಣೆ ಭೈಯೇ ಕಾಹೆಕಿ ಶು? <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />ಖ್ಹಾರಿ ಧರ್ತಿ ತಾರಖ್ಹಾಮ್ಣೆ ಛಾ಼. ದಯಕರೀನ್‌ ಮನ ಮ್ಹೇಲಿನ್ ಅಲಕ್‌ಹುಯಿಜ಼. ತೂ ಡಾವಿಬಾಜು಼ ಗಯೋತೊ ಮೇ ಖಾವಿಬಾಜು಼ ಜ಼ವುಸ್‌; ತೂ ಖಾವಿಬಾಜು಼ ಗಯೋತೊ ಮೇ ಡಾವಿಬಾಜು಼ ಜ಼ವುಸ್” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 13:9" /><verse number="10" style="v" sid="GEN 13:10" />ಲೋಟ ಡೋಳಪಾಡಿನ್ ದೇಖಖ್ಹತರ್ ಯೊರ್ದನ್ ನದ್ದಿನು ತಬರ್ಖೊ ಚೋಗರ್‌ಲಗು ಪಾಣಿ ರ‍್ಹವಾನು ತಬರ್ಖೊಕರಿ ಮಾಲುಮ್ ಕರಿಲಿದೊ. ಯೆಹೋವ ದೇವ್‌ ಸೊದೋಮ್ ಗೊಮೋರ್‌ ಖ್ಹಯೇರ್‌ನ ನಾಶ್‌ಕರಾನ ಅಗಾಡಿ ಯೊ ತಬರ್ಖೊ ಯೆಹೋವ ದೇವ್ನು ಬಗೀಚನಿತರಾಬಿ, ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನಿತರಾಬಿ ಪಾಣಿನು ತಬರ್ಖೊ ಹುಯಿರ‍್ಹೊಥೊ. <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />ಇನಖ್ಹಾಜೆ ಲೋಟನೆ ಯೊರ್ದನ್ ನದ್ದಿನು ಅಶ್‌ಪಿಶ್‌ನ ತಬರ್ಖಾನ ಚೂ಼ಣಿಲೀನ್ ಪೂರಬ್ ದಿಕ್‌ಭಣಿ ನಿಕ್‌ಳ್ಯೊ. ಅಮ್‌ ಇವ್ಣೆ ಭೇಜ಼ಣ ಅಲಕ್‌ ಹುಯಿಗಾ. <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />ಅಬ್ರಾಮ್‌ ಕಾನಾನ್‌ ದೇಖ್ಹ್‌ಮ ಜಿವ್ಣುಕರ‍್ಯೊ. ಲೋಟನೆ ಯೊರ್ದನ್‌ ನದ್ದಿನ ಅಶ್‌ಪಿಶ್‌ನ ಖ್ಹಯೇರ್ನ ಬಲ್ಡಾಮ ಜಿವ್ಣು ಕರ್ತೊಹುಯಿನ್ ಸೊದೋಮ್‌ನ ಖನ್ನೆ ಡೇರೊ ನಾಖ್ಯೊ. <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />ಕತೋಬಿ ಸೊದೋಮ್ ಖ್ಹಯೇರ್‌ನು ಅದ್ಮಿ ಯೆಹೋವ ದೇವ್ನಿ ನಜ಼ರ್‌ಮ ಘಣು ಖರಾಬ್‌ಬಿ ಪಾಪಿಖ್ಹಾರು ಹುಯಿರ‍್ಹುಥು.<verse eid="GEN 13:13" /></para>
  <para style="s">ಅಬ್ರಾಮ್‌ ಹೆಬ್ರೋನ್ನ ಗಯೋತೆ</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />ಲೋಟನೆ ಅಬ್ರಾಮ್‌ನ ಮ್ಹೇಲಿನ್ ಅಲಕ್‌ಹುಯೊ ತದೆ ಯೆಹೋವ ದೇವ್ನೆ ಅಬ್ರಾಮ್‌ನ, “ತೂ ಛಾ಼ತೆ ಝ಼ಗೋಥು ಚಾರ್‌ ಬಾಜು಼ಬಿ ಡೋಳಪಾಡಿನ್‌ ದೇಕ್‌. <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />ತೂ ದೇಖುಕರಾತೆ ಆ ದೇಖ್ಹ್‌ ಖ್ಹಾರುಸ್ ತುನಾಬಿ ತಾರಿ ಪಿಳ್ಗಿಬಿ ಹಮೇಶನಖ್ಹಾಜೆ ದೆವುಸ್‌. <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />ತಾರಿ ಪಿಳ್ಗಿವಾಳನ ಧರ್ತಿನ ಧೂಳ್‌ನಿತರ ಗಣ್ತಿಕೊಂತೆ ಕರುಸ್. ಧರ್ತಿಪರ್ ಛಾ಼ತೆ ಧೂಳ್‌ನ ಗಣ್ತಿಕರಾನ ಹುಯುತೊ ತಾರಿ ಪಿಳ್ಗಿನ ಗಣೇಜಾ಼ಯ್‌. <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />ತೂ ಉಠೀನ್ ಆ ದೇಖ್ಹ್‌ನು ಖ್ಹಾರೀಸ್‍ ಬಾಜೂ಼ಬಿ ಗಖ್ಹತ್‌ಮಾರ್‌; ಯೊ ತುನ ದಿಶ್” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 13:17" /><verse number="18" style="v" sid="GEN 13:18" />ಹಿಜ಼್ಜಾಥೊ ನಿಕ್ಳಿನ್ ಅಬ್ರಾಮ್‌ ಡೇರೊ ಉಖ್ಡಿಲೀನ್ ಹೆಬ್ರೋನ್‌ಮ ಛಾ಼ತೆ ಮಮ್ರೆನು ಪರಿಶುದ್ದ ‘ಮೋರೆ’ಕರಿ ಝಾ಼ಡಕನ ಐನ್ ಹಿಜ್ಜಾ಼ಸ್ ಜಿವ್ಣುಕರಿನ್, ಯೆಹೋವ ದೇವ್ನ ಚಾ಼ಚ಼ರ್‌ ಭಂದಾಯೊ.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">ಅಬ್ರಾಮ್‌ನೆ ಲೋಟನ ಬಚಾ಼ಯೊತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />ಯೊ ದನ್ಮ <note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="ft" closed="false">ಬಾಬಿಲೋನ್</char></note>ಶಿನಾರ್‌ನೊ ರಾಜ಼ ಅಮ್ರಾಫೆಲ್‌, ಎಲ್ಲಾಸರನೊ ರಾಜ಼ ಅರಿಯೋಕ, ಏಲಾಮ್‌ನೊ ರಾಜ಼ ಕೆದೊರ್ಲಗೋಮರ್‌, ಗೋಯಿಮನೊ ರಾಜ಼ ತಿದ್ಗಾಲ್‌ ಆ ಚಾರ್‌ಜ಼ಣ ರಾಜ಼ನೆ <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />ಝ಼ರುಕೊ ತಬರ್‌ಖಾಮ ಎಕ್ಟುಮಳಿರ‍್ಹೊತೆ ಸೊದೋಮ್ ರಾಜ಼ ಬೆರಗ, ಗೊಮೋರನೊ ರಾಜ಼ ಬಿರ್ಶಗ, ಅದ್ಮಾಹನೊ ರಾಜ಼ ಶಿನಾಬ, ಚೆಬೋಯಿಮ್‌ನೊ ರಾಜ಼ ಶೆಮೇಬರ, ಬೇಲಗ ನತರ್ ಚೋಗರನ ಪಾಚ಼್ ರಾಜಾ಼ವ್‌ಥಿ ಜಂಗ್ ಭೀಡ್ಯು. <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />ಆ ಪಾಚ಼್‌ ರಾಜ಼ವ್ ಹಮ್ಕೇನು ಮೀಟ್‌ನೊದರ‍್ಯಾವ್‌ಕರಿ ಬೋಲೈರ‍್ಹುತೆ ಸಿದ್ದೀಮ್‌ ಝ಼ರುಕೊನ ತಬರ್‌ಖಾಮ ಒಟ್‌ಥಿ ಮಳಿರ‍್ಹಾಥ. <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />ಬೆರಗ ಅಜು಼ ಆ ಪಾಚ಼್‌ಜ಼ಣ ರಾಜ಼ಖ್ಹಾರು ಭಾರ ವರಖ್ಹ್‌ ಕೆದೊರ್ಲಗೋಮರನ ಚ಼ಪ್ಪಣ್‌ಮ ರ‍್ಹೀನ್ ತೇರ‍್ಹ ವರಖ್ಹ್‌ಮ ಪಾಛು಼ ಫರಿಪಡ್ಯು. <verse eid="GEN 14:4" /><verse number="5" style="v" sid="GEN 14:5" />ಚೌ಼ಧನ ವರಖ್ಹ್‌ಮ ಕೆದೊರ್ಲಗೋಮರಬಿ ಇನ ಮಳ್ಯಹುಯ ರಾಜ಼ವ್‌ಬಿ ಅಯಿನ್ ಅಷ್ಟರೋತ್‌ ಕರ್ನಯಿಮ್‌ ರೆಫಾಯವಾಳನಾಬಿ ಹಮಿ ಕರಿ ತಬರ್‌ಖಾಮ ಜೂಜ್ಯವಾಳನಾಬಿ ಶಾವೆಕಿರ್ಯಾತಯಿಮಿಮ ಏಮಿಯವಾಳನಬಿ, <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />ಆ ನಾಹುಯಿನ್ ಸೇಯಿರ್‌ಕರಿ ಪಹಾಡ್‌ನೊ ತಬರ್‌ಖಾಮ ಜಿವ್ಣು ಕರುಕರ್ತುಥೂತೆ ಹೋರಿಯವಳನಾಬಿ, ಹಿಜ್ಜಾ಼ಸ್‌ ಇವ್ಣುನ ಹರೈನ್‌ ರೇತ್ನ ತಬರ್‌ಖಾನ ಖನ್ನೆಛಾ಼ತೆ ಎಲ್ಪಾರಾನ್‌ಲಗೂಬಿ ಪಾಛೊ಼ ನಖ್ಹಾಡ್ಯು. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />ಇನಕೇಡೆಥು ಇವ್ಣೆ ಪಾಛು಼ಫರಿನ್ ಕಾದೇಶ್‌ಕರಿ ಬೋಲಾನು ಎನ್ಮಿಷ್ಟಾಟಿನ ಆಯಿನ್ ಅಮಾಲೇಕ್ಯವಾಳಾನು ತಮಾಮಸ್‌ ಗಾಮ್‌ನಾಬಿ ಹಚಚೋನ್ ತಾಮರಮ ಜಿವ್ಣು ಕರುಕರ್ತೊಥೋತೆ ಅಮೋರಿಯವಾಳನಬಿ ಜೂತಿಲಿದು. <verse eid="GEN 14:7" /><verse number="8" style="v" sid="GEN 14:8" />ತದೆ ಸೊದೋಮ್, ಗೊಮೋರ, ಅದ್ಮಾಹ, ಚೆಬೋಯಿಮ್‌ ಅಜು಼ ಚೋಗರ್‌ಕರಿ ಬೇಲಗ ದೇಖ್ಹ್‌ನು ರಾಜ಼ವ್‌ಖ್ಹಾರು ನಿಕ್ಳಿನ್ ಇವ್ಣುನ ಮ್ಹೋರೆಹುಯಿನ್, <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />ಕತೊ ಏಲಾಮ್‌ ರಾಜ಼ ಕೆದೊರ್ಲಗೋಮರ್‌, ಗೋಯಿಮನೊ ರಾಜ಼ ತಿದ್ಗಾಲ, ಶಿನಾರ್‌ನೊ ರಾಜ಼ ಅಮ್ರಾಫೆಲ್‌, ಎಲ್ಲಾಸರನೊ ರಾಜ಼ಹುಯಿರ‍್ಹೋತೆ ಅರಿಯೋಕ, ಅವ್ಣಿ ವಿರೋದ್‌ ಸಿದ್ದೀಮ್‌ಕರಿ ಝೋ಼ಕ್‌ಮ ಇವ್ಣ ದಂಡ್‌ನ ಭೀರಾಖ್ಯು. ಅಮ್‌ ಚಾರ್‌ಜ಼ಣ ರಾಜ಼ವ್ನೆ ಪಾಚ಼್‌ಜ಼ಣ ರಾಜಾ಼ವ್ನ ಡರಾಯು. <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />ಕತೋಬಿ ಸಿದ್ದೀಮ್‌ ಝ಼ರುಕಾನು ತಬರ್‌ಖೊ, ಬಂಡಾನಿ ಪಥಾರಿಯೇನು ಡಾಂಬರ್‌ನ ಕುಂಟಾವ್‌ಥಿ ಭರೈರ‍್ಹುಥು. ಸೊದೋಮ್ ಗೊಮೋರನ ರಾಜ಼ಭಣಿವಾಳು ನಾಶಿಜಾ಼ವನಿ ವಖ್ಹ್‌ತೆ ಯೊ ಡಾಂಬರ್‌ನ ಕುಂಟಾಮ ಪಡಿಗಯು; ಉಬ್ರಿಹುಯು ಪಹಾಡ್‌ಭಣಿ ನಾಶಿಚ಼ಲಿಗು. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />ಜೂತ್ಯೂತೆ ಯೊ ಚಾರ್‌ಜ಼ಣ ರಾಜ಼ವ್ನೆ ಸೊದೋಮ್ ಗೊಮೋರ್‌ ಖ್ಹಯೇರ್‌ಮಥೂತೆ ಖ್ಹಾರೂಸ್ ಧನ್‌ದೌಲತ್‌ನಾಬಿ ಇನಾಮಾನು ಅನಾಜ಼್‌ಬಿ ಲೂಟಿಲೀನ್‌ ಗಯು. <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />ಸೊದೋಮ್ಮ ಜಿವ್ಣು ಕರುಕರ್ತೊಥೋತೆ ಅಬ್ರಾಮ್‌ನೊ ನ್ಹಾನೊಭೈನೊ ಛಿಯ್ಯೊ ಲೋಟನಾಬಿ ಇನಿ ಶೊತ್‌ಖ್ಹಮೇದ್‌ ಧರಿಲೀನ್ ಚ಼ಲಿಗು. <verse eid="GEN 14:12" /><verse number="13" style="v" sid="GEN 14:13" />ಕತೋಬಿ ಛು಼ಕ್ಯುತೆ ಇನಮಾಥೊ ಏಕ್‌ಜ಼ಣಾನೆ, ಇಬ್ರಿಯವಾಳೊ ಅಬ್ರಾಮ್‌ಕನ ಅಯಿನ್ ಆಖ್ಹಾರಿ ವಾತೆ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ. ಅಬ್ರಾಮ್‌, ಅಮೋರಿಯವಾಳೊ ಹುಯಿರೋತೆ ಮಮ್ರೆಯಾನು ಮೋರೆ ತೋಪ್‌ಕನ ಜಿವ್ಣು ಕರುಕರ್ತೊಥೊ. ಮಮ್ರೆಯನ ಎಷ್ಕೋಲ ಅಜು಼ ಆನೇರಕರಿ ಬೇ ಭೈಯೇ ಥಾ; ಅವ್ಣೆ ಭೇಜ಼ಣನಾಬಿ ಅಬ್ರಾಮ್‌ನಾಬಿ ಒಪ್ಪಂದ ಥು. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />ಅಬ್ರಾಮ್‌ ಇನೊ ನ್ಹಾನೊ ಭೈನೊ ಛಿಯ್ಯೊ ಖ್ಹಾರ್ಕೊಟ್‌ಮ ಮಳ್ಯುತೆ ಇನ ಖ್ಹಮ್‌ಜೀನ್‌, ಇನ ಘರ್‌ಮಾಸ್ ಪೈದಹುಯಿನ್, ಹಿಜ್ಜಾ಼ ಪಳೀನ್ ಶಿಕಿರ‍್ಹೂತೆ ತೀನ್‌ಖ್ಹೊ ಅಠಾರ ಜ಼ಣು ಆಳ್ನ ಜಂಗ್‌ನ ತಯಾರ್ ಕರೀಲಿಜೈನ್ ಯೊ ಚಾರ್ ರಾಜಾ಼ವ್‌ನಾಬಿ ದಾನ ಖ್ಹಯೇರ್‌ಲಗೂಬಿ ಪಾಛೊ಼ ನಖ್ಹಾಡ್ಯೊ. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />ಯೊ ರಾತ್ನಿ ವಖ್ಹತ್‌ಮ ಇನ ಡಂಡ್‌ನ ಬೇಭಾಗ್‌ ಕರೀನ್, ವಹೇರ‍್ಯಪರ್‌ ಪಡಿನ್ ಹರಾಯೊ. ಕಾಹೆತೆ ದಮಸ್ಕ ಖ್ಹಯೇರ್‌ನ ಉತ್ತರ್ ದಿಕ್‌ಭಣಿಥಾತೆ ಹೋಬಾಕರಿ ಗಾಮ್‌ಲಗು ಇವ್ಣುನ ಪಾಛೊ಼ ನಖ್ಹಾಡ್ಯೊ. <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />ರಾಜ಼ಖ್ಹಾರು ಲೂಟಿಲಿದಾತೆ ಖ್ಹಾರುಸ್ ಚೀಜ಼್‌ನ ಇನೆ ಪಾಛೊ಼ ಛಿನೈಲಿದೊ. ಇನ ನ್ಹಾನಭೈನೊ ಛಿಯ್ಯೊ ಲೋಟನಾಬಿ ಛೋ಼ಡಾಯೊ. ಇನಿ ಶೊತ್‌, ಖ್ಹಾರ್ಕೊಟ್‌ಮಥೀತೆ ತಯೇಡಾವ್‌ನ, ಅಜು಼ ಬಿಜ಼ ಅದ್ಮಿವ್‌ನಾಬಿ ಬುಲೈಲೀನ್ ಆಯೊ.<verse eid="GEN 14:16" /></para>
  <para style="s">ಮೆಲ್ಕೀಚೆದೆಕನೆ ಅಬ್ರಾಮ್‌ನ ಆಶೀರ್ವಾದ್‌ ಕರ‍್ಯೊತೆ</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />ಇನೆ ಕೆದೊರ್ಲಗೋಮರನಾಬಿ ಇನಿಜೋ಼ಡ್ಮಥಾತೆ ರಾಜಾ಼ವ್‌ನಾಬಿ ಹರೈನ್ ಆವಾದಿನ್ ಸೊದೋಮ್‌ನೊ ರಾಜ಼ನೆ ಇನ ರಾಜ಼ನು ಝ಼ರುಕೊಕರಿ ಬೋಲೈರ‍್ಹುತೆ ಶಾವೆ ಝೋ಼ಕ್‌ಮ ಅಬ್ರಾಮ್‌ನ ಮಳ್ಯೊ. <verse eid="GEN 14:17" /><verse number="18" style="v" sid="GEN 14:18" />ಸಾಲೇಮಿನೊ ಮಹಾನ್ ರಾಜ಼ ಮೆಲ್ಕೀಚೆದೆಕ ಜಿನು ಅಯಿನ್ ರೋಟನಾಬಿ ದ್ರಾಕ್ಷಿನ ರಖ್ಹ್‌ನಾಬಿ ದಿದೊ. ಆ ಹೈರೋತೆ ಘಣೋ ಊಚೊ಼ ದೇವ್‌ನೊ ಯಾಜಕಬಿ ಹುಯಿರ‍್ಹೋಥೊ. <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />ಅನೆ ಅಬ್ರಾಮ್‌ನ ಆಶೀರ್ವಾದ್‌ಕರೀನ್, “ಆಬ್‌ಧರ್ತಿನ ಉಬ್‌ಜಾ಼ಯೋತೆ ದೇವ್‌ನು ಆಶೀರ್ವಾದ್‌ ಅಬ್ರಾಮ್‌ನ ಮಳಾದೆಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 14:19" /><verse number="20" style="v" sid="GEN 14:20" />ಸೊರ್ಗನೊ ದೇವ್‌ ತಾರ ವಹೇರ‍್ಯಾನ ತಾರ ಹಾತ್ಮ ದಿದೋತೆ ಇನಖ್ಹಾಜೆ ಇನ ಧನ್ಯವಾದ್‌” ಕರಿಬೋಲ್ಯೊ. ಅಬ್ರಾಮ್‌ ಇನೆ ಜೂತಿಲೀನ್ ಆಯೋತೆ ಖ್ಹಾರಸ್ ಚೀಜ಼್‌ಮ ದಖ್ಹ್‌ಮ ಏಕ್‌ಭಾಗ್ ಮೆಲ್ಕಿಚೆದೆಕನ ದಿದೊ. <verse eid="GEN 14:20" /><verse number="21" style="v" sid="GEN 14:21" />ಸೊದೋಮ್‌ನ ರಾಜ಼ನೆ ಅಬ್ರಾಮ್‌ನ, “ತೂ ಛೋ಼ಡೈಲಿನ್ ಆಯೋತೆ ಅದ್ಮೇವ್‌ನ ಮನ ದಿನಾಕ್; ಶೊತ್‌ನ ತೂಸ್ ರಾಖೀಲೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 14:21" /><verse number="22" style="v" sid="GEN 14:22" />ಅಬ್ರಾಮ್‌ನೆ ಸೊದೋಮ್‌ನ ರಾಜ಼ನ, ಆಬ್‌ಧರ್ತಿನ ಬಣಾಯೋತೆ ಘಣೋ ಊಚೊ಼ ದೇವ್‌ ಯೆಹೋವಭಣಿ ಹಾತ್‌ಪಾಡಿನ್ ಆಣ್‌ಲೆವುಸ್. <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />ಮನ ತಾರು ಶಾತ್‌ಬಿ ನಕೊ, “ಏಕ್‌ ಧಾಗೊರ‍್ಹೇವೊ, ಚಪ್ಪಲ್‌ನಿ ಡೋರಿನರ‍್ಹೇವೊ ತಾರಮಾಥು ಖೆವುಬಿ ಮೆ ಲೇವ್‌ಕೊಯ್ನಿ. ಅಜು಼ ‘ಮಾರೇಥಿ ಅಬ್ರಾಮ್‌ ಶೌಕಾರ್ ಬಣ್ಯೊ ಕರಿ ಬೋಲಾವಖ್ಹರ್ಕು ನಾಹೋಣು. <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />ಮಾರು ಆಳ್‌ಖ್ಹಾರಾನೆ ಖಾದುತೆ ಮ್ಹೇಲಿನ್, ಮಾರಜೋ಼ಡೆ ರ‍್ಹವಾಳ ಆನೇರ ಎಷ್ಕೋಲ ಮಮ್ರೆವಾಳನ ಆವ್ಣುತೆ ವಾಟೊ ಖಲಿ ಇವ್ಣುನ ರ‍್ಹವಾದೆ” ಕರಿಬೋಲ್ಯೊ.<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">ಅಬ್ರಾಮ್‌ನಿ ಜೋಡ್ಮ ದೇವ್ನಿ ಒಪ್ಪಂದ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />ಆ ಖ್ಹಾರು ಚಾ಼ಲಿ ಹುಯಿಜಾ಼ವನ ಪಾರ್ ಅಬ್ರಾಮ್‌ನ ದರ್ಶನ್‌ಮ ಯೆಹೋವ ದೇವ್ನು ವಚನ್‌ ಖ್ಹಮಜ಼್‌ಪಡ್ಯು, “ಅಬ್ರಾಮ್‌ ಡರ್‌ನಕೊ, ಮೇ ತುನ ಢಾಲ್‌ಹುಯಿರ‍್ಹೋಸ್ ಅಜು಼ ತುನ ಘಣುಖ್ಹು ಇನಾಮ್‌ ದೆವುಸ್‌” <verse eid="GEN 15:1" /><verse number="2" style="v" sid="GEN 15:2" />ಇನ ಅಬ್ರಾಮನೆ, “ಪ್ರಭು ಯೆಹೋವ ದೇವ್‌, ಮನ ಶಾತ್‌ದಿದೋತೊ ಶನೊ ಫಾಯಿದೊ ಮನ ಲಡ್ಕಕೊಯ್ನಿ. ಅಜು಼ ಮಾರಿ ಶೊತ್‌ಖ್ಹಾರಿಸ್, ದಮಸ್ಕವಾಳೊ ಸೇವಕ್ ಎಲೀಯೆಜ಼ರನು ಪಾಲ್ಉಶೆಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />ಪಾಛೊ಼ ಅಬ್ರಾಮ್‌ನೆ, “ತೂ ಮನ ಲಡ್ಕ ದಿದೊಕೊಯ್ನಿ ಇನಖ್ಹಾಜೆ, ದೇಕ್‌, ಮಾರ ಘರ್ಮ ಪೈದಹುವವಾಳೊಸ್ ಮನ ಹಕ್‌ದಾರ್‌ ಹೋಣು” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 15:3" /><verse number="4" style="v" sid="GEN 15:4" />ಯೆಹೋವನಿ ವಚನ್‌ ಇನಿ ಜೋ಼ಡ್ಮ ವಾತ್‌ಬೋಲಿನ್, “ಆ ಸೇವಕ್ ತುನ ಹಕ್‌ದಾರ್‌ ಉಷೆಕೊಯ್ನಿ, ಕತೋಬಿ ತಾರಪೇಟೆ ಪೈದಹುವವಾಳೋಸ್ ತುನ ಹಕ್‌ದಾರ್‌ ಉಷೆ” ಕರಿ ಬೋಲಿನ್, <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />ಅಬ್ರಾಮ್‌ನ ಭಾರ್ ಬುಲೈಲಯಿನ್, “ಆಬ್‍ಭಣಿ ದೇಕ್, ಶುಕ್ಕರ್‌ನ ತಾರೇಥಿ ಗಣಾನು ಹೋತು ಉಶೇತೊ ಗಣ್ತಿಕರ್. ತಾರಿಪಿಳ್ಗಿ ಎತ್ರುಉಷೆ.” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 15:5" /><verse number="6" style="v" sid="GEN 15:6" />ಅಬ್ರಾಮ್‌ ಯೆಹೋವನ ವಿಶ್ವಾಸ್ ಕರ‍್ಯೊ; ಯೆಹೋವ ದೇವ್ನೆ ಅಬ್ರಾಮ್‌ನಿ ವಿಶ್ವಾಸ್‌ನ ಇನಿ ಗಣ್ತಿಮ ನೀತಿಕರಿ ಮಾನಿಲಿದೊ. <verse eid="GEN 15:6" /><verse number="7" style="v" sid="GEN 15:7" />ಇನವಾರ್ ದೇವ್ನೆ ಅಬ್ರಾಮ್‌ನ, “ಆ ದೇಖ್ಹ್‌ನ ತುನ ಹಕ್‌ದಾರ್‌ ಬಣೈನ್ ದ್ಯವಾನಖ್ಹಾಜೆ ಊರ್‌ ಕರಿ ಕಲ್ದಿಯವಾಳನು ಖ್ಹಯೇರ್‌ಥಿ ಬುಲೈಲಾಯೋತೆ ಯೆಹೋವ ಮೇಸ್.” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 15:7" /><verse number="8" style="v" sid="GEN 15:8" />ಕತೋಬಿ “ಪ್ರಭು ಯೆಹೋವ ದೇವ್‌ ಮೇ ಅನ ಹಕ್‌ದಾರ್‌ ಹುಯಿರ‍್ಹಿಶ್‌ಕರಿ ಮಾಲುಮ್‌ಕರಾನು ಕಿಮ್?” ಕರಿ ಪುಛಾ಼ಯೊ. <verse eid="GEN 15:8" /><verse number="9" style="v" sid="GEN 15:9" />ತದೆ ಯೆಹೋವ ದೇವ್ನೆ ತೂ ತೀನ್ ವರಖ್ಹ್‌ ಹುಯಿರ‍್ಹವನು ಏಕ್‌ ಗಾಯ್‌, ಏಕ್‌ ಬೋಕ್‌ಡೊ, ಏಕ್‌ ಮೇಂಢೊ, ಎಕ್ ಹರ‍್ಯಾಲ್, ಎಕ್ ಪರ‍್ಯಾವನ ಲೀನ್ಆವ್‌” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 15:9" /><verse number="10" style="v" sid="GEN 15:10" />ಇನೆ ಆ ಅಖ್ಖಾಸ್ನ ಜಾನ್ವರ್‌ನ ಲಯಿನ್ ಚೀರಿನ್, ಬೇಭಾಗ್‌ಕರೀನ್ ಏಕ್‌ಭಾಗ್‌ನ ಖ್ಹಾಮೆ ಬಿಜೇಕ್‌ನ ಮ್ಹೇಲ್ಯೊ; ಜಿನಾವರ್‌ನ ಚೀರ‍್ಯೊಕೊಯ್ನಿ. <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />ಯೊ ಜಾನ್ವರ್‌ಪರ್ ಗರದ್‌ ಪಡಾಲಗ್ಯೊತೆ ದೇಖಿನ್, ಅಬ್ರಾಮ್‌ನೆ ಯೊ ಅಖ್ಖಾನ ನಖ್ಹಾಡಿದಿದೊ. <verse eid="GEN 15:11" /><verse number="12" style="v" sid="GEN 15:12" />ದನ್ ಡುಬಾನಿ ವಖ್ಹ್‌ತೆ ಅಬ್ರಾಮ್‌ನ ಭರ್‌ನಿಂದರ್‌ ಮಾರಿದಿದಿ. ತದೆ ಇನಾಪರ್ ಘಣು ಅಜು಼ ಭಯಾನಕ್‌ ಅಂಧಾರು ಮೂಚೈ಼ರ‍್ಹುಥು. <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />ತದೆ ಯೆಹೋವ ದೇವ್ನೆ ಅಬ್ರಾಮ್‌ನ, “ತೂ ಅಛ್ಛಿನಿತರ ಮಾಲುಮ್‌ ಕರಿಲ್ಯಾವಾನು ಶಾತ್‌ಕತೊ, ತಾರಿ ಪಿಳ್ಗಿವಾಳು ಪರ್‌ದೇಖ್ಹ್‌ಮ ವಶೇರೊ ಜೈ಼ರ‍್ಹೀನ್, ಯೊ ದೇಖ್ಹ್‌ವಾಳಾನ ಗುಲಾಮ್‌ ಹುಯಿಜಾ಼ಶೆ. ಚಾರ್‌ಖ್ಹೋ ವರಖ್ಹ್‌ ಯೊ ದೇಖ್ಹ್‌ವಾಳೇಥಿ ವದೇಖ್ಹೊ ಪಡ್‌ಶೆ. <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />ಇವ್ಣುನ ಗುಲಾಮ್‌ ಬಣೈಲಿದೂತೆ ಜಗ್‌ಜಾ಼ತ್‌ವಾಳಾನ ಮೇ ನಿಶತ್‌ ದೀನ್ ಹುಯಿಜಾ಼ವದಿನ್ ಇವ್ಣೆ ಘಣು ದೌಲತ್ತಿಹುಯಿನ್ ಯೊ ದೇಖ್ಹ್‌ಥು ಛುಟ್ಕಾರ್‌ ಹುಯಿನ್ ನಿಕ್ಳಿನ್ ಆವ್‌ಶೆ. <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />ತೂತೋಬಿ ಶಾಂತಿಥಿ ಗುರುಗುರಬ್‌ಲ್ಯಕನ ಜೈ಼ನ್ ಮಳೀಶ್. ಘಣೊ ಭುಡೊಹುಯಿನ್ ಕಾರೇಜ಼್‌ಬಿ ನಖೈಲಿಶ್. <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />ತಾರಿ ಪಿಳ್ಗಿನು ಚಾ಼ರ್‌ನಿ ಮುಂಡಿವಾಳು ಹಜ್ಜಾ಼ ಪಾಛು಼ ಆವ್‌ಶೆ. ಶನಕತೊ ಅಮೋರಿಯವಾಳನು ಅಪರಾದ್ ಅಜೂ಼ಬಿ ಪಾಪ್ನೊ ಘಡೊ ಭರಾಯುಕೊಯ್ನಿ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 15:16" /><verse number="17" style="v" sid="GEN 15:17" />ದನ್ ಡುಬೀನ್ ಅಂಧಾರ್‌ಗಡಪ್‌ ಹುಯಿಜಾ಼ವದಿನ್, ಹಂದೇಕ್ ಧುವ್ವೊ ನಿಕ್ಳಾನು ಛು಼ಲ್ಲೋಬಿ ಅಜು಼ ಬಳಾನು ಏಕ್‌ ಢಿಟಂಬು ದೆಖೈನ್ ಯೊ ಜಾನ್ವರ್‌ನ ಟುಕ್ಡಾವ್‌ನ ಬೀಚ್‌ಮಕರಿ ಗಯು. <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />ಯೊ ದನ್ಮ ಯೆಹೋವ ದೇವ್ನೆ ಅಬ್ರಾಮ್‌ನಿ ಜೋಡ್ಮ ಒಪ್ಪಂದ ಕರಿಲೀನ್, “ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನು ನದ್ದಿಥು ಯೂಫ್ರೇಟೀಸ್‌ ಮೋಟಿ ನದ್ದಿಲಗೂಬಿ ಛಾ಼ತೆ ಆ ದೇಖ್ಹ್‌ ಖ್ಹಾರುಸ್, <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />ಕೇನಿಯವಾಳುಬಿ, ಕೆನಿಜೀಯವಾಳುಬಿ, ಕದ್ಮೋನಿಯವಾಳುಬಿ, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />ಹಿತ್ತಿಯವಾಳುಬಿ, ಪೆರಿಜೀಯವಾಳುಬಿ, ರೆಫಾಯವಾಳುಬಿ, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />ಅಮೋರಿಯವಾಳುಬಿ, ಕಾನಾನ್ಯವಾಳುಬಿ, ಗಿರ್ಗಾಷಿಯವಾಳುಬಿ, ಯೆಬೂಸಿಯವಾಳು ಜಿವ್ಣು ಕರುಕರಸ್ತೆ ದೇಖ್ಹ್‌ನ ಮೇ ತಾರಿ ಪಿಳ್ಗಿನ ದೆವುಸ್” ಕರಿ ವಾಗ್ದಾನ್‌ ಕರ‍್ಯೊ.<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">ಹಾಗರ್‌ಬಿ ಇಸ್ಮಾಯೇಲ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />ಅಬ್ರಾಮ್‌ನಿ ಬಾವಣ್‍ ಸಾರಯನ ಲಡ್ಕಕೋಥಾನಿ. ಇನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ವಾಳಿ ಹಾಗರ್‌ಕರಿ ದಾಸಿಥಿ. <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />ಅಮ್‌ರ‍್ಹಾವಪರ್ ಸಾರಯನೆ ಅಬ್ರಾಮ್‌ನ, “ಯೆಹೋವನೆ ಮನ ಲಡ್ಕ ಕೋದಿದೋನಿನಿ; ತೂ ಮಾರಿ ದಾಸಿಹುಯಿರ‍್ಹೀತೆ ಹಾಗರ್‌ಕನ ಜಾ಼ವ್ಣು; ಅಮ್ ಏಕ್‌ವೇಳ್ ಇನೇಥಿ ಮನ ಲಡ್ಕ ಉಷೆ” ಕರಿ ಬೋಲಖ್ಹತರ್ ಅಬ್ರಾಮ್‌ನೆ ಇನಿ ವಾತ್ನ ಖ್ಹಮ್‍ಜಿಗೊ. <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />ಅಬ್ರಾಮ್‌ ದಖ್ಹ್‌ ವರಖ್ಹ್ ದನ್ ಕಾನಾನ್ ದೇಖ್ಹ್‌ಮ ಜಿವ್ಣುಕರಾನ ಬಾದ್ಮ ಇನಿ ಬಾವಣ್‍ ಸಾರಯನೆ ಈಜಿಪ್ಟ್‌ವಾಳಿ ಹಾಗರ್‌ಕರಿ ದಾಸಿನ ಇನೊ ಬಾವ್ರಿ ಅಬ್ರಾಮ್‌ನ ಬಾವಣ್‍ಬಣೈ ದಿನಾಖಿದಿದಿ. <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />ಅಬ್ರಾಮ್‌ ಹಾಗರ್‌ನ ಮಳಾಖ್ಹತರ್ ಯೊ ಬೇಜೂನಿ ಹುಯಿ. ಇನೆ ಬೇಜೂನಿ ಛೂ಼ಕರಿ ಮಾಲುಮ್‌ ಕರಿಲಿನ್, ಇನೆ ಯಜಮಾನಿನ ಫಿಕ್ಕರ್ ಕರಿಕೊಯ್ನಿ. <verse eid="GEN 16:4" /><verse number="5" style="v" sid="GEN 16:5" />ತದೆ ಸಾರಯ ಅಬ್ರಾಮ್‌ನ, “ಮಾರಿಗೋಳ್ ತಾರಪರ್ ಪಡಾದೆ; ಮಾರಿ ದಾಸಿನ ತುನ ಬಾವಣ್ ಕರಿದಿದೀತೆ ಎತ್ರೇಸ್; ಯೊ ಬೇಜೂನಿ ಕರಿ ಮಾಲುಮ್ ಕರಿಲೀನ್ ಮನ ಫಿಕ್ಕರ್ ಕರಾಕೊಯ್ನಿ. ತಾರಬಿ ಮಾರ ಇಚ಼್‌ಮ ಯೆಹೋವಾಸ್ ನ್ಯಾವ್ ಫೇಡಾವದೆ” ಕರಿ ಬೋಲಿ. <verse eid="GEN 16:5" /><verse number="6" style="v" sid="GEN 16:6" />ತದೆ ಅಬ್ರಾಮ್‌ನೆ, “ತಾರಿ ದಾಸಿ ತಾರ ಹಾತ್ಮ‌ ಛಾ಼ನಿ; ತಾರದಿಲ್‍ಮ ಆವಾತೆ ತಿಮ್‍ಕರ್” ಕರಿಬೋಲ್ಯೊ. ತದೆ ಸಾರಯನೆ ಇನ ಖ್ಹತಾವಖ್ಹತರ್ ಯೊ ನಾಶಿಚ಼ಲಿಗೈ. <verse eid="GEN 16:6" /><verse number="7" style="v" sid="GEN 16:7" />ಯೋಹೈರಿತೆ ರೇತ್‍ನ ತಬರ್‌ಖಾಮ ಶೂರ‍್ನಿ ವಾಟೆ ಪಾಣಿನೊ ಚೇಜ಼್‌ಭಾರಕನ ರ‍್ಹವಾನಿ ವಖ್ಹ್‌ತೆ ಯೆಹೋವನ ದೂತನೆ ಇನ ಮಳಿನ್ , <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />“ಸಾರಯನಿ ದಾಸಿಹುಯಿರ‍್ಹೀತೆ ಹಾಗರ್‌, ಕಿಜ್ಜಾ಼ಥಿ ಆಯಿ? ಕಿಜ್ಜಾ಼ ಉಳೀಜಾ಼ಸ್?” ಕರಿ ಬೋಲಖ್ಹತರ್‌ ಇನೆ, “ಮಾರಿ ಯಜಮಾನಿ ಹುಯಿರ‍್ಹೀತೆ ಸಾರಯಕಂಥು ನಾಶಿವಳಿಜ಼ವ್‌ಸ್‌” ಕರಿ ಬೋಲಿ. <verse eid="GEN 16:8" /><verse number="9" style="v" sid="GEN 16:9" />ಇನ ಯೆಹೋವನ ದೂತನೆ, “ತೂ ಯಜಮಾನಿಕನ ಪಾಛಿಫರಿಜೈನ್ ಇನ ಹಾತ್‍ಹೇಟ್ ರ‍್ಹೇ, ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />ಆ ನಾಹುಯಿನ್ ಯೆಹೋವನ ದೂತನೆ ಇನ, “ತುನ ಘಣುಲಡ್ಕಾ ಹುವಾನಿತರ ಕರುಸ್; ತಾರಿ ಪಿಳ್ಗಿ ಗಣ್ತಿ ನಾಹೋಣುತೆ ಎತ್ರೆ ಜಾ಼ಖ್ಹತ್ ಉಷೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 16:10" /><verse number="11" style="v" sid="GEN 16:11" />ಯೆಹೋವನ ದೂತನೆ ಇನ “ತೂ ಬೇಜೂನಿ ಹುಯಿನ್; ತುನ ಛಿಯ್ಯೊ ಪೈದ ಉಷೆ; ಯೊ ಛಿಯ್ಯಾನ ‘ಇಷ್ಮಾಯೇಲ್‌’ ಕರಿ ನಾಮ್‌ ಮ್ಹೇಲ್ನು ಶನಕತೊ ಯೆಹೋವ ದೇವ್‌ ತಾರಿ ವದೇಖ್ಹ್‌ನಿ ಚಿಕ್ರಾಣ್ಣ ಕಾನ್‌ದಿದೊ. <verse eid="GEN 16:11" /><verse number="12" style="v" sid="GEN 16:12" />ಯೊ ಅದ್ಮಿ ಝಾ಼ಡೀನ ಗಧೇಡನಿತರ ರ‍್ಹಿಶೆ. ಯೊ ಖ್ಹಾರಸ್‌ಪರ್‌ ಹಾತ್‌ಪಾಡ್‌ಶೆ. ಅಜು಼ ಅಖ್ಖುಜ಼ಣುಬಿ ಇನ ವಿರೋದ್ ಹುಯಿರ‍್ಹಿಶೆ. ಇನ ನ್ಹಾನ ಮೋಟ ಭಯೇನ ಖ್ಹಾಮ್ಣೇಸ್‌ರ‍್ಹೀನ್ ಜಿವ್ಣುಕರ್ಶೆ” ಕರಿ ಬೋಲಿನ್ ಗಯೊ. <verse eid="GEN 16:12" /><verse number="13" style="v" sid="GEN 16:13" />ಇನಪಾರ್ ಹೈರಿತೆ ಇನಿ ಜೋ಼ಡ್ಮ ವಾತ್‌ಬೋಲ್ಯೋತೆ ಯೆಹೋವ ದೇವ್ನ, “ಮನ ದೇಖ್ಯೊತೆ ದೇವ್ ತೂ” ಕರಿ ನಾಮ್ ಮ್ಹೇಲಿ; ಶನಕತೊ, “ಮನ ದೇಖ್ಯೊತೆ ಇನ ಮೇ ದೇಖಿ” ಕರಿ ಬೋಲಿ. <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />ಆ ಏಕ್‌ ಖೇಣಿಥಿ ಹಿಜ಼್ಜಾನಿ ಬಾವ್ಡಿನ ಲಹೈರೋಯಿಕರಿ ನಾಮ್‌ಹುಯು ಕತೊ “ಮನ ದೇಖಾವಳೊ ಜಾನ್ನ ಸ್ವರೂಪ್‌ನಿ ಬಾವ್ಡಿ” ಕರಿ. ಯೊ ಕಾದೇಶ್‌ನಾಬಿ ಬೆರೆದ್‌ನಾಬಿ ಬೀಚ್ಮ ಛಾ಼. <verse eid="GEN 16:14" /><verse number="15" style="v" sid="GEN 16:15" />ಹಾಗರ್‌ನೆ ಅಬ್ರಾಮ್‌ಥಿ ಏಕ್‌ ಛಿಯ್ಯಾನ ಜ಼ಣಿ. ಅಬ್ರಾಮ್‌ನೆ ಹಾಗರಥಿ ಪೈದಹುಯೋತೆ ಛಿಯ್ಯಾನ ಇಷ್ಮಾಯೇಲ್‌ ಕರಿ ನಾಮ್‌ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />ಹಾಗರ್‌ ಇಷ್ಮಾಯೇಲ್‌ನ ಜ಼ಣಾನಿ ವಖ್ಹ್‌ತೆ ಅಬ್ರಾಮ್‌ನ ಛೋ಼ಉಪ್ಪರ್‌ ಚಾರೀಖ್ಹ್‌ ವರಖ್ಹ್‌ ಹುಯಿರ‍್ಹುಥು.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">ಖ್ಹತ್ನ, ಒಪ್ಪಂದನು ಖ್ಹಣೇದ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />ಅಬ್ರಾಮ್‌ ನೌಉಪ್ಪರ್‌ ಖ್ಹಡ್‌ಚಾ಼ರಿಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳೊ ರ‍್ಹವಾನಿ ವಖ್ಹ್‌ತೆ ಯೆಹೋವ ದೇವ್ ನೆ ಇನಿ ದರ್ಶನ್‌ಮ, “ಮೇ ಸರ್ವಶಕ್ತ ದೇವ್‌ ಮಾರ ಖ್ಹಾಮ್ಣೆ ಖೋಟ್‌ಕೊಂತೆ ಚಾ಼ಲಿಲೆ. <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />ಮೇ ತಾರಿ ಜೋ಼ಡ್ಮ ಒಪ್ಪಂದ ಕರಿಲೇವುಸ್‌; ಘಣೇಥಿ ಘಣು ಪಿಳ್ಗಿನ ತುನ ದೆವುಸ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 17:2" /><verse number="3" style="v" sid="GEN 17:3" />ಅಬ್ರಾಮ್‌ ಆಡ್‌ಪಡಾಖ್ಹತರ್‌ ದೇವ್‌ ಇನಿಜೋಡ್ಮ ವಾತ್‌ಬೋಲಿನ್, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />“ಮೇ ತಾರಿಜೋ಼ಡ್ಮ ಎಕ್ ಒಪ್ಪಂದ ಕರಿಲೇವುಸ್‌; ಯೊ ಶಾತ್‌ಕತೊ ತೂ ಕೈಯೇಕ್ ಜ಼ಗ್‌ಜಾ಼ತ್ನ ಶುರುನೊ ಪರ್ಖ್ಹೊ ಹುಯಿರ‍್ಹೀಶ್. <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />ಅನಪಾರ್‌ ತುನ ಅಬ್ರಾಮ್‌ಕರಿ ನಾಮ್‌ ಕೋರ‍್ಹಿಶೇನಿ, ತುನ ಅಬ್ರಹಾಮ್‌ ಕರಿ ನಾಮ್‌ ರ‍್ಹಿಶೆ. ಶನಕತೊ ತುನ ಕೈಏಕ್‌ ಜ಼ಗ್‌ಜಾ಼ತ್‌ನ ಶುರುವಾತ್ನೊ ಪರ್ಖ್ಹೋ ಬಣೈರಾಖ್ಯೊ. <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />ತುನ ಘಣೇಥಿಘಣು ಪಿಳ್ಗಿನ ದಿಶ್ ತಾರೇಥಿ ಜ಼ಗ್‌ಜಾ಼ತ್‌ಖ್ಹಾರು ಉಬ್‌ಜಿನ್ ರಾಜ಼ವ್‌ಖ್ಹಾರು ಪೈದ ಉಷೆ. <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />ಮೇ ತುನಾಬಿ ತಾರಿ ಖ್ಹಾರಿ ಪಿಳ್ಗಿನಾಬಿ ದೇವ್‌ ಹುಯಿರ‍್ಹಿಶ್‌. ಅಜು಼ ಮಾರಿ ಒಪ್ಪಂದನ ತಾರಖ್ಹಾಜೇಬಿ ತಾರಿ ಪಿಳ್ಗಿನು ಖ್ಹಾರುಸ್ ಮುಂಡೀನ್‌ಮುಂಡಿನ ಖ್ಹಾಜೇಬಿ ಹಮೇಶಾನು ಒಪ್ಪಂದಕರಿನ್ ಘಟ್‌ರಾಖಿಶ್. ‌ <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />ಅಲಕ್‌ ದೇಖ್ಹ್‌ವಾಳೊ ಹುಯಿರೋತೆ ತೂ ಕಾನಾನ್‌ ದೇಖ್ಹ್‌ನು ಜ಼ಮೀನ್ ಅಖ್ಖುಸ್ ತುನಾಬಿ ತಾರ ಲಡ್ಕಾನಾಬಿ ಹಮೇಶ ರ‍್ಹವಾನು ಶೊತ್‌ಬಣೈದೀನ್, ಮೇ ಕದೆಕದೇಬಿ ಇವ್ಣುನ ದೇವ್‌ ಹುಯಿರ‍್ಹಿಶ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 17:8" /><verse number="9" style="v" sid="GEN 17:9" />ಆನಾಹುಯಿನ್ ದೇವ್ನೆ ಅಬ್ರಹಾಮ್‌ನ, “ತೂತೋ ಮಾರಿ ಒಪ್ಪಂದನ ಪಾಡಿಚಾ಼ಲ್ನು. ತೂಸ್ ಖಲಿಕಾಹೇತೆ ತಾರ ಲಡ್ಕಖ್ಹಾರು ಮುಂಡೀನ್‌ಮುಂಡಿಲಗೂಬಿ ಪಾಡಿಚಾ಼ಲ್ನು. <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />ತುನಾಬಿ ತಾರ ಲಡ್ಕಾನಾಬಿ ಪಾಡಿಚಾ಼ಲ್ನುತೆ ಆಸ್ ಮಾರಿ ಒಪ್ಪಂದನಿ ಖ್ಹಣೇದ್‌; ತುಮಾರಮ ಛಾ಼ತೆ ಖ್ಹಾರಾಸ್ ಪರ್ಖ್ಹಾನಬಿ ಖ್ಹತ್ನಹೋಣು. <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />ತೂಬಿ ಖ್ಹತ್ನ ಹೋಣು ಶನಕತೊ ಯೋಸ್ ತುಮುನಾಬಿ ಮನಾಬಿ ಹುಯೂತೆ ಒಪ್ಪಂದನು ಖ್ಹಣೇದ್‌ ಹುಯಿರ‍್ಹಿಶೆ. <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />ಶನಕತೊ ಅಗಾಡಿ ಮುಂಡೀನ್‌ಮುಂಡಿ ಹುಯಿನ್ ಆವ್‌ಶೇತೆ ಖ್ಹಾರುಸ್‌ಜ಼ಣು, ತುಮಾರ ಹರೇಕ್ ಪರ್ಖ್ಹ ಲಡ್ಕಾನಬಿ , ಆಟ್‍ದನ್ ಹುವಾದಿನ್ ಖ್ಹತ್ನಕರಾವ್ಣು; ಘರ್‌ಮ ಪೈದಹುವವಾಳೊ ರ‍್ಹವೊ, ತಾರಿ ಪಿಳ್ಗಿ ಕಾಹೆತೆ ಅಲ್ಹಾವ್‌ನ ಲಡ್ಕರ‍್ಹವೊ, ಅಲ್ಹಾವ್‍ಥಿ ಮೋಲ್‍ಲಿದುಹುಯು ರ‍್ಹವೊ; ಇವ್ಣುನಾಬಿ ಖ್ಹತ್ನಹೋಣು. <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />ತಾರ ಘರ್‌ಮ ಪೈದಹುವವಾಳನಬಿ, ತೂ ಮೋಲ್‍ಲಿದಹುಯನಾಬಿ, ಖ್ಹತ್ನಹೋಣು. ಅಮ್ ಮೇ ಕರೂತೆ ಒಪ್ಪಂದನು ಖ್ಹಣೇದ್ ತುಮಾರ ಶರೀರ್‌ಮಾಸ್ ರ‍್ಹೀನ್, ಹಮೇಶಾನಿ ಒಪ್ಪಂದನ ದೆಖಾಡ್‌ಷೆ. <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />ಖ್ಹತ್ನಕರಾವಕೊಂತೆ ಪರ್ಖ್ಹಾನ ಮಾರಿ ಒಪ್ಪಂದಾನ ಝಿಟ್ಕಾರನಿತರ ಹುವಾಸ್, ಇನಖ್ಹಾಜೆ ಇನ ಖೂಮ್‌ಥಿ ಭಾರ್‌ ಕಾಡಿನಾಕ್‌ಣು.” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 17:14" /><verse number="15" style="v" sid="GEN 17:15" />ಆನಾಹುಯಿನ್ ದೇವ್ನೆ ಅಬ್ರಹಾಮ್‌ನ, “ತೂ ಅನಪಾರ್‌ ತಾರಿ ಬಾವಣ್ಣ ಸಾರಯ ಕರಿ ನಾ ಪುಕಾರ‍್ನುತೆ ಸಾರ‍ ಕರಿ ಪುಕಾರ‍್ನು. <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />ಮೇ ಇನ ಅಶೀರ್ವಾದ್‌ಕರೀನ್, ಇನೇಥಿ ತುನ ಏಕ್‌ ಛಿಯ್ಯಾನ ದೆವುಸ್‌. ಮೇ ಇನ ವಾರ್ಖ್ಹೊ ದಿದೋತೆ ಇನಖ್ಹಾಜೆ ಇನೇಥಿ ಕೈಯೇಕ್ ಜ಼ಗ್‌ಜಾ಼ತ್‌ನ ಆಯಹುಯಿನ್, ಖ್ಹಾರ ರಾಜ಼ವ್‌ಬಿ ಇನೇಥಿ ಉಬ್‌ಜಿ ಆವ್‌ಶೆ ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 17:16" /><verse number="17" style="v" sid="GEN 17:17" />ಅಬ್ರಹಾಮ್‌ನೆ ಆಡ್‍ಪಡಿನ್ ನಾಶೀನ್, ಖ್ಹೋ ವರಖ್ಹ್‌ವಾಳನ ಛಿಯ್ಯೊ ಪೈದ ಉಷೇಕಿ ಶು? ಖ್ಹಡ್‌ಚಾ಼ರಿಖ್ಹ್‌ನಿ ಸಾರ ಜ಼ಣ್‌ಶೆ ಕಿಶು? ಕರಿ ದಿಲ್ಮ ಕರಿಲಿದೊ. <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />ಅಬ್ರಹಾಮನೆ ದೇವ್ನ, ಇಷ್ಮಾಯೇಲ್‌ ಛಾ಼ನಿ? ಯೋಸ್ ತಾರ ಆಶೀರ್ವಾದ್‌ಮ ರ‍್ಹಯೊತೊ ಬಶ್‌ಕೊಯ್ನಿಕಿಶು? ಕರಿ ಬೊಲ್ಯೊ, <verse eid="GEN 17:18" /><verse number="19" style="v" sid="GEN 17:19" />ದೇವ್ನೆ, “ಇಮ್‌ಕಾಹೆ, ತಾರಿ ಬಾವಣ್‍ ಹುಯಿರ‍್ಹಿತೆ ಸಾರಮಸ್‌ ತುನ ಏಕ್‌ ಛಿಯ್ಯೊ ಪೈದ ಕರ್ಷೆ. ಇನ ‘ಇಸಾಕ’ ಕರಿ ನಾಮ್‌ ಮ್ಹೇಲ್ನು. ಇನಿ ಜೋ಼ಡ್ಮಬಿ ಮಾರಿ ಒಪ್ಪಂದಾನ ಇನಿ ಪಿಳ್ಗಿನ ಜೋಡ್ಮ ಹಮೇಶಾಥಿ ಭಿರಾಖುಸ್. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />ಇಷ್ಮಾಯೇಲ್‌ನಿ ಬಾರೇಮ ತೂ ಕರ‍್ಯೊತೆ ಬಿಂತಿನ ಖ್ಹಮ್‍ಜಿರಾಖ್ಯೊಸ್ ಇನಾಬಿ ಆಶೀರ್ವಾದ್‌ ಕರಿರಾಖ್ಯೋಸ್; ಇನ ಭಡೈನ್ ಘಣೇಥಿ ಘಣು ಲಡ್ಕಾವ್ನ ದೆವುಸ್‌. ಯೊ ಭಾರಜ಼ಣ ರಾಜ಼ವ್ನ ಅಧಿಪತಿ. ಅಜು಼ ಇನೇಥಿ ಮೊಟು ಜ಼ಗ್‌ಜಾ಼ತ್‌ ಹುವಾನಿತರ ಕರಿಶ್. <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />ಕತೋಬಿ ಯೊ ಮಾರಿ ಒಪ್ಪಂದಾನ ಇಸಾಕನಿ ಜೋ಼ಡ್ಮಾಸ್ ಕರಿಲೆವುಸ್‌; ಆವ್‌ಶೇತೆ ವರಖ್ಹ್‌ ಆಸ್ ಹಗಾಮ್ಮ ಸಾರ ಇನ ಜ಼ಣ್‌ಶೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />ತದೆ ದೇವ್ ಅಬ್ರಹಾಮ್‌ನಿ ಜೋ಼ಡ್ಮ ವಾತ್‌ಬೋಲಾನು ಖ್ಹತಮ್‌ಕರೀನ್ ಇನಕಂಥು ಪಡೈಗಯೊ.<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />ಯೋಸ್ ದನ್ನೆ ಅಬ್ರಹಾಮ್‌ನೆ ಇನೊ ಛಿಯ್ಯೊ ಇಷ್ಮಾಯೇಲ್‌ನಾಬಿ ಇನ ಘರ್ಮಥಾತೆ ಖ್ಹಾರಸ್‌ ಪರ್ಖ್ಹಾವ್‌ನಾಬಿ, ಕತೊ ಘರ್ಮ ಪೈದಹುವವಾಳನ ಖಲಿ ಕಾಹೆತೆ, ಯೊ ಮೋಲ್ ಲಿದಹುಯನಾಬಿ ದೇವ್ನಿ ಹುಕುಮ್‌ನಿ ಘೋಣಿಸ್ ಖ್ಹತ್ನ ಕರಾಯೊ. <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />ಅಬ್ರಹಾಮ್‌ನ ಖ್ಹತ್ನ ಹುವಾನಿವಖ್ಹ್‌ತೆ ಇನ ನೌಉಪ್ಪರ್‌ ಖ್ಹಡ್‌ಚಾ಼ರಿಖ್ಹ್‌ ವರಖ್ಹ್‌ ಹುಯಿರ‍್ಹುಥು. <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />ಇಷ್ಮಾಯೇಲ್‌ನ ಖ್ಹತ್ನ ಹುವಾನಿವಖ್ಹ್‌ತೆ ಇನ ಥೇರಾ ವರಖ್ಹ್‌ ಹುಯಿರ‍್ಹುಥು. <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />ಅಬ್ರಹಾಮ್‌ನಾಬಿ ಇನೊ ಛಿಯ್ಯೊ ಇಷ್ಮಾಯೇಲ್‌ನಾಬಿ ಎಕ್ಕಸ್‌ ದನ್ಮ ಖ್ಹತ್ನ ಹುಯು. <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />ಇನ ಘರ್ಮಥೂತೆ ಖ್ಹಾರಸ್ ಪರ್ಖ್ಹಾವ್‌ನಾಬಿ ಕತೊ ಘರ್ಮ ಪೈದಹುವವಾಳನ ಖಲಿ ಕಾಹೆತೆ ಅಲ್ಹಾವ್‍ಥಿ ಮೋಲ್ ಲೀದಹುಯನಾಬಿ ಇನಿ ಜೋ಼ಡ್ಮ ಖ್ಹತ್ನ ಹುಯು.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">ಅಬ್ರಹಾಮ್‌ನ ಛಿಯ್ಯೊ ದ್ಯವಾನ ವಾಗ್ದಾನ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />ಅಬ್ರಹಾಮನ ತಡ್ಕಾನಿ ವಖ್ಹ್‌ತೆ ಮಮ್ರೆನ ಮೋರೆ ತೋಪ್‌ಮಾನು ಇನ ಡೇರಾಮ ಜಾ಼ವನಿ ವಾಟ್‌ಪರ್‌ ಬೆಠೋರ‍್ಹವಾನಿ ವಖ್ಹ್‌ತೆ ಯೆಹೋವನೆ ಇನ ದರ್ಶನ್‌ ದಿದೊ. <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />ಕಿಮ್‌ಕತೊ, ಯೊ ಡೋಳಪಾಡಿನ್ ದೇಖಾಖ್ಹತರ್‌ ಇನಖ್ಹಾಮ್ಣೆ ಕೋಣ್‌ಕಿ ತೀನ್‌ಜ಼ಣ ಪರ್ಖ್ಹ ಭಿಯಾಥ. ತದ್ನು ತದೇಸ್‌ ಇವ್ಣುನ ಮಳಾನಖ್ಹಾಜೆ ಯೊ ಘರ್‌ಕಂಥು ನಾಶಿಜೈನ್ ಡುಗಿನ್ ಖ್ಹಲಾಮ್‌ಕರೀನ್, <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />“ಗುರುಜಿವೋ, ದಯ ರ‍್ಹವಾದೆ, ಮಾರ ಘರ್‌ನ ಭೀಡೆಕರಿ ಸೇವಕಕನ ಆಯಕೊಂತೆ ತುಮೆ ಆಗಾಡಿ ನಕೊ ಜಾ಼ವೊ. ಮೇ ತುಮಾರೊ ಸೇವೆ ಕರಾವಾಳೊ ಹುಯಿರ‍್ಹೋಸ್. <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />ಪಾಣಿ ಮಂಗೈದೇವ್‌ಸ್; ತುಮಾರ ಗೋಡ ಧೋಯಿಲೀನ್ ಝಾ಼ಡ್‌ಣ ಛಾ಼ಳೆ ಅರಾಮ್‌ ಕರಿಲೆವೊ. <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />ಥೋಡು ಖಾಣು ಲೀಆವ್‌ಸ್, ಖಾದಾತೊ ಶಕತ್ ಆವ್‌ಶೆ ತದೆ ತುಮೆ ಅಗಾಡಿ ಜ಼ಯೇಜಾ಼ಯ್‌” ಕರಿ ಬೋಲಖ್ಹತರ್‌ ಇವ್ಣೆ, “ತೂ ಬೋಲ್ಯೊತೆ ತಿಮ್ಮಸ್ ಹುವಾದೆ” ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 18:5" /><verse number="6" style="v" sid="GEN 18:6" />ತದೆ ಅಬ್ರಹಾಮ್‌ ಡೇರಮಥೀತೆ ಸಾರಕನ ಮಿಲೈಜೈ಼ನ್‌ ಇನ, “ಛಾ಼ಣ್ಯಹುಯ <note caller="+" style="f"><char style="fr" closed="false">18:6 </char><char style="ft" closed="false">ಖ್ಹೋಳ ಕೇಜಿ ಎತ್ರು</char></note>ಆಟಾನ ಘೂಂದಿನ್ ಜ಼ಲ್‌ದಿ ರೋಟ ಕರ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 18:6" /><verse number="7" style="v" sid="GEN 18:7" />ಇನಪಾರ್‌ ಅಬ್ರಹಾಮ್ ನಾಶಿಜೈನ್ ಝೂ಼ಂಡ್‌ಮಾಥು ಪಲ್ಯಹುಯ ಕವ್‌ಳ ಕೆಲ್ಡಾನ ಲಯಿನ್ ಆಳ್ನ ಹಾತ್ಮದಿದೊ. ಆಳ್ನೆ ಜ಼ಲ್ದಿ ಪಲ್ಯಹುಯ ಕೆಲ್ಡಾನ ಕತ್ರಿನ್‌ ಖಾಣು ಪಿಕಾಯೊ. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />ಇನಪಾರ್ ಆಬ್ರಹಾಮ್‌ನೆ ಜಾನ್ವರ್‌ನ ದೂದ್ ಧೈಬಿ ಬೋಟಿನಾಬಿ ಲೀಐನ್ ಯೊ ಅದ್ಮಿಖ್ಹಾರನ ನಾಖಿ ಖಡಾಯೊ. ಇವ್ಣೆ ಝಾ಼ಡ್‌ಹೇಟ್‌ ಖಾಣು ಖಾವಲಗೂಬಿ ಯೊ ಖನ್ನೆ ಭಿರೀನ್ ಉಪಚಾರ್‌ ಕರ‍್ಯೊ. <verse eid="GEN 18:8" /><verse number="9" style="v" sid="GEN 18:9" />ಇನಕೇಡೆಥು ಇವ್ಣೆ ಅಬ್ರಹಾಮ್‌ನ, “ತಾರಿ ಬಾವಣ್‍ ಸಾರ‍ ಕಿಜ಼್ಜ ಛಾ಼?” ಕರಿ ಬೋಲಖ್ಹತರ್‌ ಇನೆ “ಹುಜ್ಜಾ಼ ಡೇರಾನ ಘರ್ಮಛಾ಼” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 18:9" /><verse number="10" style="v" sid="GEN 18:10" />ತದೆ ಇವ್ಣಾಮ ಏಕ್‌ಜ಼ಣಾನೆ, “ವಳ್ಯಾವತೆ ವರಖ್ಹ್‌ ಆಸ್ ದನ್ಮ ಪಾಛೊ಼ಫರಿ ತಾರಕನ ಐಶ್; ಆವಾದಿನ್ ತಾರಿಬಾವಣ್‌ ಸಾರನ ಛಿಯ್ಯೊ ರ‍್ಹಿಶೆ” ಕರಿಬೋಲ್ಯೊ. ಯೊ ವಾತ್ ಬಾಕಲ್‌ನ ಪೀಠೆಥೀತೆ ಸಾರನ ಕಾನ್ಮಪಡ್ಯು. <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />ಅಬ್ರಹಾಮ್‌ಬಿ ಸಾರಬಿ ಘಣಭುಡಾ ಹುಯಿರ‍್ಹಾಥ; ಸಾರನ ಮುಟ್‌ಭೀರಿಗಯುಥು. <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />ಅಮ್‌ ರ‍್ಹವಾಮ ಇನೆ, “ಮಾರಿನಿತರಾನಿ ಭುಡೀಯಾನ ಬಾವ್ರಿನ ಮಳಾನ ಉಷೇಕಿ ಶು?” ಮಾರೊ ಯಜಮಾನ್‌ಬಿ ಭುಡೋನಿ ಕರಿ ಇನುಯೋಸ್ ಹಾಶಿ. <verse eid="GEN 18:12" /><verse number="13" style="v" sid="GEN 18:13" />ಯೆಹೋವ ದೇವ್ ಅಬ್ರಹಾಮ್‌ನ, “ಸಾರನೆ ಹಾಶಿನ್, ಭುಡಿಯ ಹುಯಿರಿತೆ ಮೇ ಲಡ್ಕುಜ಼ಣಾನ ಉಷೇಕಿ ಶು ಕರಿ ಹಾಶಿನ್ ಬೋಲಿತೆ ಕಿಮ್?” <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />ಯೆಹೋವನ ಹೋಯಿಕೊಂತೆ ಖೆವುಛಾ಼? ಮೇ ಬೋಲ್ಯೊತೆ ತಿಮ್ಮಸ್ ಆವ್‌ಶೇತೆ ವರಖ್ಹ್‌ ಆಸ್ ಹಗಾಮ್ಮ ಮೇ ತಾರಕನ ಆವಾದಿನ್ ಸಾರ‍ನ ಛಿಯ್ಯೊ ರ‍್ಹಿಶೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 18:14" /><verse number="15" style="v" sid="GEN 18:15" />ತದೆ ಸಾರ ಡರಿನ್, “ಮೇ ಹಾಶಿಕೊಯ್ನಿನಿ” ಕರಿ ಬೋಲ್ತಾನ ಇನೆ ಇಮ್‌ ನಕೊ ಬೋಲ್, ತುನೆ ಹಾಶಿತೆ ಖ್ಹಾಚಿಸ್” ಕರಿಬೋಲ್ಯೊ.<verse eid="GEN 18:15" /></para>
  <para style="s">ಸೊದೋಮ್‌ನಖ್ಹಾಜೆ ಅಬ್ರಹಾಮ್‌ನಿ ಬಿಂತಿ</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />ಯೊ ತೀನ್ ಅದ್ಮಿವ್‌ ಹಿಜ್ಜಾ಼ಥ ನಿಕ್ಳಿನ್ ಸೊದೋಮ್‌ಭಣಿ ದೇಖ್ಯ; ಅಬ್ರಹಾಮ್‌ ಇವ್ಣುನ ಮೋಕ್ಲಾನ ಇವ್ಣ ಜೋ಼ಡ್ಮಾಸ್ ಗಯೊ. <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />ತದೆ ಯೆಹೋವ ದೇವ್ನೆ ಇನ ದಿಲ್ಮ, “ಮೇ ಕರ್ನುಕರಿ ಛೂ಼ತೆ ಕಾಮ್ನ ಅಬ್ರಹಾಮ್‌ಥಿ ಲಪಾಡನು ಬರೋಬರ್‌ಕಿಶು? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />ಅಬ್ರಹಾಮ್‌ಥಿ ಘಣು ತಾಖತ್‌ನು ಮೊಟು ಜ಼ಗ್‌ಜಾ಼ತ್‌ ಪೈದಹೋಣುನಿ; ಇನೇಥಿ ಧರ್ತಿನು ಅಖ್ಖೂಸ್ ಜ಼ಗ್‌ಜಾ಼ತ್‌ನಾಬಿ ಆಶೀರ್ವಾದ್‌ ಉಷೇನಿ; <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />ಅಬ್ರಹಾಮ್ ಇನ ಛಿಯ್ಯಾವ್‌ನಾಬಿ, ಪಿಳ್ಗಿವಾಳನ ‘ತುಮೆ ನ್ಯಾವ್‌ ನೀತಿನ ಪಾಡಿ ಚಾ಼ಲ್ತಹುಯಿನ್ ಯೆಹೋವ ದೇವ್ನ ಮಾರಗ್‌ಪರ್‌ ಚಾ಼ಲ್ನುಕರಿ ಬೋಧನ್‌ಕರಾನಿ ಘೋಣಿ ಮೇ ಇನ ಚೂ಼ಣಿಲಿದೋನಿ; ಇವ್ಣೆ ಅಮ್‌ ಕರಾಥಿ ಯೆಹೋವ ಹುಯಿರ‍್ಹೋತೆ ಮಾರಿ ವಾಗ್ದಾನ್ ಪೂರಉಷೆಕರಿ ಬೋಲಿಲಿದೊ. <verse eid="GEN 18:19" /><verse number="20" style="v" sid="GEN 18:20" />ಆ ನಾಹುಯಿನ್ ಯೆಹೋವನೆ, “ಸೊದೋಮ್ ಗೊಮೋರನಿ ಖ್ಹರಪ್‌ಗೋಳ್‌ ಮನ ಖ್ಹಮಜ಼್‌ಪಡ್ಯು; ಇವ್ಣು ಪಾಪ್ನು ಕಾಮ್‌ ಕೆವ್‌ಡುಕಿ ಮೊಟು ಹುಯಿರ‍್ಹುಸ್, <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />ಇನಖ್ಹಾಜೆ ಮೇ ಉತ್ರಿಜೈ಼ನ್ ದೇಖುಸ್, ಮನ ಛಿಮೈರ‍್ಹೀತೆ ಬಿಂತಿನಿಘೊಣೀಸ್ ಇವ್ಣೆ ಕರಿರಾಖ್ಯುಸ್ಕಿ ಕೊಯ್ನಿಕಿಕರಿ ದೇಖಿನ್ ಮಾಲುಮ್‌ ಕರಿಲೆವುಸ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 18:21" /><verse number="22" style="v" sid="GEN 18:22" />ಯೊ ಅದ್ಮೇವ್‌ ಹಿಜ್ಜಾ಼ಥ ಸೊದೋಮ್‌ಭಣಿ ಗಯ, ಕತೋಬಿ ಅಬ್ರಹಾಮ್‌ ಯೆಹೋವನ ಖ್ಹಾಮ್ಣೆ ಬಿಜೂ಼ಬಿ ಥೊ. <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />ತದೆ ಅಬ್ರಹಾಮ್‌ ಖನ್ನೆಐನ್, “ತೂ ಖರಾಬ್‌ ಅದ್ಮಿನಿ ಜೋ಼ಡ್ಮ ನೀತಿವಾಳನಾಬಿ ನಾಶ್ ಕರಸ್ಕಿ ಶು? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />ಏಕ್‌ವೇಳ್‌ ಯೊ ಖ್ಹಯೇರ್‌ಮ ಅಢೈವೀಖ್ಹ್‌ಜ಼ಣು ನೀತಿವಾಳು ರ‍್ಹಿಯುತೋಬಿ ರ‍್ಹಿಶೆ. ಇನಾಮ ಅಢೈವೀಖ್ಹ್‌ಜ಼ಣು ನೀತಿವಾಳು ರ‍್ಹಯುತೋಬಿ ಯೊ ಖ್ಹಯೇರ‍್ನ ನಾಶ್‌ಕರಿಷ್ ಕೊಂತೆ ಬಚಾ಼ಡಿಶ್ ‌ಕಿಶು? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />ಇಮ್ನಿ ಪರಕ್ಮ ಖರಾಬ್‌ನಾಬಿ ನೀತಿವಾಳನಾಬಿ ಪರ್‌ಖ್ಯೊಕೊಂತೆ ಖರಾಬ್‌ನಿ ಜೋ಼ಡ್ಮ ನೀತಿವಾಳನಾಬಿ ಮಾರಿನಾಖನು ತಾರೇಥಿ ಕದೇಬಿ ನಾಹೊಣು; ಖ್ಹಾರಸ್ ಜಗತ್ನ ನ್ಯಾವ್ ದ್ಯವಾಳೊ ನ್ಯಾವ್ನಸ್ ಚ಼ಲಾವ್‌ಶೆ ಕೊಯ್ನಿಕಿಶು?” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 18:25" /><verse number="26" style="v" sid="GEN 18:26" />ತದೆ ಯೆಹೋವನೆ, “ಸೊದೋಮ್ಮ ಅಢೈವೀಖ್ಹ್‌ಜ಼ಣು ನೀತಿವಾಳು ಮನ ಮಳ್ಯುತೊ ಇವ್ಣಖ್ಹಾಜೇಥಿ ಅಖ್ಖ ಖ್ಹಯೇರ್‌ನಾಸ್ ಬಚಾ಼ಡುಸ್ ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 18:26" /><verse number="27" style="v" sid="GEN 18:27" />ಇನ ಅಬ್ರಹಾಮ್‌ನೆ, “ಹಂದೇಕ್‌, ಮಾಟಿಬಿ, ರಾಕ್‌ಬಿ ಹುಯಿರ‍್ಹೋತೆ ಮೇ ಪ್ರಭುನಿ ಜೋ಼ಡ್ಮ ಅಬ್ಬಾಜ಼ಬ್ಬಿ ಬೋಲಾನ ಧಿಲ್‌ಪತ್ ಲೀರಾಖ್ಯೊಸ್. <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />ಕತೋಬಿ ಏಕ್‌ವೇಳ್‌ ಅಢೈಖ್ಹ್‌ ನೀತಿವಾಳಮ ಪಾಚ಼್‌ಜ಼ಣ ಕಮ್‌ರ‍್ಹಿಯುತೊ ಯೊ ಪಾಚ಼್‌ಜ಼ಣನಖ್ಹಾಜೆ ಖ್ಹಯೇರ್‌ನ ಅಖ್ಖು ನಾಶ್‌ ಕರೀಶ್ಕಿ ಶು?” ಕರಿ ಬೋಲಖ್ಹತರ್‌ ಯೆಹೋವನೆ, “ಹಿಜ಼್ಜ ಪಾಚ಼್‌ಉಪ್ಪರ್‌ ಚಾ಼ಳೀಖ್ಹ್‌ಜ಼ಣ ನೀತಿವಾಳ ಮಳ್ಯತೊ ಇನ ನಾಶ್‌ ಕರುಕೊಯ್ನಿ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 18:28" /><verse number="29" style="v" sid="GEN 18:29" />ಅಬ್ರಹಾಮ್‌ ಇನಿ ಜೋ಼ಡ್ಮ ಬಿಜೂ಼ಬಿ ವಾತ್‌ ಬೋಲಿನ್, ಏಕ್‌ವೇಳ್‌ ಹಿಜ಼್ಜ ಚಾ಼ಳಿಖ್ಹ್ ಜ಼ಣ ಮಳ್‌ಶೆಕರಿ ಬೋಲಖ್ಹತರ್‌ ಇನೆ “ಚಾ಼ಳೀಖ್ಹ್‌ಜ಼ಣು ಮಳ್ಯುತೊ ಯೊ ಖ್ಹಯೇರ್‌ನ ನಾಶ್‌ ಕರುಕೊಯ್ನಿ.” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 18:29" /><verse number="30" style="v" sid="GEN 18:30" />ಅಬ್ರಹಾಮ್‌ನೆ, “ಪ್ರಭು ಇರಾದೊ ನಕೊಕರೀಶ್; ಮೇ ಪಾಛು಼ ವಾತೆ ಬೋಲ್ನುಸ್ ಪಡ್ಯು; ಏಕ್‌ ವೇಳ್‌ ಡೋಡಿಖ್ಹ್‌ಜ಼ಣು ಹಿಜ಼್ಜ ಮಳ್‌ಶೆ” ಕರಿ ಬೋಲಖ್ಹತರ್‌ ಇನೆ, “ಹಿಜ಼್ಜ ಡೋಡಿಖ್ಹ್‌ಜ಼ಣು ಮಳ್ಯುತೊ ಇನ ನಾಶ್‌ ಕರುಕೊಯ್ನಿ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 18:30" /><verse number="31" style="v" sid="GEN 18:31" />ಇನೆ, “ಹಂದೇಕ್‌, ಪ್ರಭುನಿ ಜೋ಼ಡ್ಮ ವಾತ್‌ಬೋಲಾನ ಹಿಮ್ಮತ್‌ ಲೀರಾಖ್ಯೊಸ್; ಏಕ್‌ವೇಳ್‌ ವೀಖ್ಹ್‌ಜ಼ಣು ಹಿಜ಼್ಜ ಮಳ್ಯುತೊ: ಕರಿ ಬೋಲಖ್ಹತರ್‌ ಇನೆ, “ವೀಖ್ಹ್‌ಜ಼ಣು ರ‍್ಹಿಯೂತೊ ಇವ್ಣಖ್ಹಾಜೆ ಯೊ ಖ್ಹಯೇರ್‌ನ ಬಚಾ಼ಡುಸ್ ನಾಶ್‌ ಕರುಕೊಯ್ನಿ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 18:31" /><verse number="32" style="v" sid="GEN 18:32" />ಅಬ್ರಹಾಮ್‌ನೆ, “ಪ್ರಭು ಇರಾದೊ ನಾಕರ‍್ನು ಬಿಜು಼ ಎಕ್ಕಸ್‌ಹಲ್ಲ ವಾತ್‌ ಬೋಲುಸ್; ಏಕ್‌ವೇಳ್‌ ದಖ್ಹ್‌ಜ಼ಣು ಮಳ್ಯುತೊ” ಕರಿ ಬೋಲಖ್ಹತರ್‌ ಇನೆ, “ದಖ್ಹ್‌ಜ಼ಣಾನ ಖ್ಹಾಜೇಬಿ ಇನ ಬಚಾ಼ಡುಸ್ ನಾಶ್‌ಕೊಕರುನಿ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 18:32" /><verse number="33" style="v" sid="GEN 18:33" />ಯೆಹೋವನೆ ಅಬ್ರಹಾಮ್‌ನಿ ಜೋ಼ಡ್ಮ ವಾತ್‌ಬೋಲಾನು ಖತಮ್‌ಕರಿನ್ ಹಿಜ಼್ಜಾಥೊ ಚ಼ಲೇಗಯೊ. ಅಬ್ರಹಾಮ್‌ ಇನಿ ಘರ್‌ಕನ ಪಾಛೊ಼ಫರಿನ್ ಗಯೊ.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">ಸೊದೋಮ್ ಗೊಮೋರನು ಪಾಪ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />ಯೊ ಬೇಜ಼ಣ ದೂತನೆ ಖ್ಹಾಂಜ಼್‌ನಿ ವಖ್ಹ್‌ತೆ ಸೊದೋಮ್‌ನ ಆವಖ್ಹತರ್ ಲೋಟಕರಿ ಏಕ್‌ಜ಼ಣೊ ಸೊದೋಮ್‍ ಗಾಮ್‍ನ ದರ್ವಾಜಕನ ಬೇಠೋಥೊ. ಇನೆ ಇವ್ಣುನ ದೇಖಿನ್ ಉಠಿಭೀರಿನ್ ಝು಼ಕಿನ್‌ಖ್ಹಲಾಮ್‍ ಕರಿನ್, <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />“ಗುರುಜಿವೊ, ತುಮಾರ ದಾಸನ ಘರೆ ಅಯ್‍ರ್ಹೀನ್ ಹಾತ್ ಗೋಡ ಧೊಯಿನ್‌; ಆ ರಾತೆ ಮಾರ ಘರ್‌ಮ ರ‍್ಹೀನ್ ವ್ಹಾಣೆ ತುಮಾರಿ ಚಾ಼ಲ್‌ಕುಚ಼್ ಕರೆಜಾ಼ಯ್” ಕರಿಬೋಲ್ಯೊ. ಇವ್ಣೆ, “ಇಮ್‌ ಕಾಹೆ, ಮಾರಗ್‌ನಿ ಚೌ಼ಕ್‌ಮಾಸ್ ಹಮೆ ಆ ರಾತ್ ಕಾಡೇಸ್” ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 19:2" /><verse number="3" style="v" sid="GEN 19:3" />ತದೆ ಇನೆ ಇವ್ಣುನ ಘಣು ಜು಼ಲಮ್‌ ಕರ‍್ಯೋತೆಖ್ಹಾಜೆ ಇವ್ಣೆ ಇನಾಕನ ರ‍್ಹಾವನ ಮಾನಿಲಿದ. ಇವ್ಣೆ ಘರೆ ಆವದಿನ್ ಇನೆ ಶೋಡಕೊಂತೆ ರೋಟೊ ಕರೀನ್ ಮಿಝ಼್‍ವಾನ್ ಕರಾಖ್ಹತರ್ ಇವ್ಣೆ ಖಾಣುಖಾದ. <verse eid="GEN 19:3" /><verse number="4" style="v" sid="GEN 19:4" />ಇವ್ಣೆ ಖ್ಹುವಾನ ಅಗಾಡಿ ಲಡ್ಕಾವ್‍ಬಿ ಬುಢಾವ್‍ ಖ್ಹಮೇದ್ ಸೊದೋಮ್ ಖ್ಹಯೇರ್‌ವಾಳು ಖ್ಹಾರುಸ್ ಘರ್‌ನ ವಘೇರೊ ಕೋಂಡಿನ್, <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />ಲೋಟನ, “ಆ ರಾತೆ ತಾರಕನ ಆಯಾತೆ ಅದ್ಮೇವ್‌ ಕಿಜ಼್ಜಾ ಛಾ಼? ಇವ್ಣುನ ಭಾರ್ ಬುಲೈಲೀನ್ ಆವ್; ಇವ್ಣೇಥಿ ಭೋಗ್ ಕರ‍್ನು” ಕರಿ ಚಿಕ್ರೀನ್ ಬೋಲ್ಯು. <verse eid="GEN 19:5" /><verse number="6" style="v" sid="GEN 19:6" />ಲೋಟ ಇವ್ಣಕನ ಭಾರ್ ಆಯಿನ್ ಇನ ಪೀಠೆ ಬಾಕಲ್ ಲಗಾಡಿನ್, <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />“ದೋಸ್ತಿವೊ, ಆ ಖರಾಬ್ ಕಾಮ್‍ ನಕೊಕರೋ. <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />ಖ್ಹಮ್‌ಜೊ಼, ಮನ ಬೇ ಕವಾರಿ ಛೋ಼ಕ್ರಿಯೆ ಛಾ಼. ಇವ್ಣುನತೋಬಿ ತುಮುನ ಲಯಿನ್‍ ದೆವ್ಸ್; ಇವ್ಣುನ ದಿಲ್ಮ ಆವಾತೆ ತಿಮ್ ಕರೆಜಾ಼ಯ್; ಕತೋಬಿ ಯೊ ಅದ್ಮೆವ್‌ನ ಶಾತ್ಬಿ ನಾಕರ‍್ನು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 19:8" /><verse number="9" style="v" sid="GEN 19:9" />ಇವ್ಣೆ ವಾಟ್‍ ಮ್ಹೇಲ್‌ ಕರಿ ಬೋಲಿನ್, “ಆ ಹೈರೋತೆ ಕೆಹೋಕಿ ಎಕ್ ಪರ್‌ದೇಖ್ಹ್‌ಥೊ ಅಯಿನ್ ಹಮ್ಕೆ ನ್ಯಾವ್‍ಣೊ ಬಣಾನ ಕರಸ್; ಯೊ ಅದ್ಮೆವ್‍ನ ಖರಾಬ್ ಕರಾಥೀಬಿ ಘಣು ತುನಾಸ್ ಖರಾಬ್ ಕರ್ಶು” ಕರಿ ಬೋಲಿನ್ ಲೋಟನ ಉಪ್ಪರ್‌ಪಡಿ ಬಾಕಲ್‍ನ ತೋಡಾನ ಖನ್ನೆ ಆಯ. <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />ಕತೋಬಿ ಮ್ಹೈಥಾತೆ ಯೊ ಅದ್ಮೆವ್‌ನೆ ಲೋಟನ ಖೇಚಿ ಘರ್‌ಮ ಘಾಲಿಲೀನ್‌ ಬಾಕಲ್‍ ಮೂಚಿಲಿದು. <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />ನ್ಹಾನ ಮೋಟಾವ್‌ ಕರಿ ದೇಖ್ಯಕೊಂತೆ ಭಾರ್‌ಥೂತೆ ಅದ್ಮೇವ್‌ನ ಡೋಳ ಭುಂಬ್‌ಳ ಕರ‍್ಯ. ಇವ್ಣುನ ಬಾಕಲ್‍ ಖೆವುಕರಿ ಮಾಲುಮ್‍ ನಾಪಡ್ನುತೆ ತಿಮ್ ಕರಿನಾಖ್ಯ.<verse eid="GEN 19:11" /></para>
  <para style="s">ಲೋಟ ಸೊದೋಮ್‌ನ ಮ್ಹೇಲ್ಯೊತೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />ತದೆ ಯೊ ದೂತಾವ್ನೆ ಲೋಟನ, “ಹಜ್ಜಾ಼ ತುನ ಬಿಜು಼ಕೋಣ್ ಛಾ಼? ಜ಼ಮೈಯೇನಾಬಿ ಪರ್ಖ್ಹ ಅಜು಼ ತಯೇಡ ಲಡ್ಕಾವ್‍ನಾಬಿ ಖ್ಹಯೇರ್‌ಮ ತುನ ಛಾ಼ತೆ ಖ್ಹಾರಸ್ನ ಗಾಮ್‌ಥಿ ಭಾರ್‌ ಬುಲೈಲಿನ್ ಜಾ಼. <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />ಶನಕತೊ ಹಮೆ ಆ ಝ಼ಗೋನ ನಾಶಕರಾನ ಐರ‍್ಹಾಸ್. ಹಜ಼್ಜವಾಳಾನಿ ಬಾರೇಮ ಘಣುಮೋಟು ಅಪರಾದ್‌ ಯೆಹೋವನ ಛಿಮಾಯುತೆ ಇನಖ್ಹಾಜೆ ಅವ್ಣುನ ನಾಶ ಬಣಾವನಖ್ಹಾಜೆ ಇನೆ ಹಮೂನ ಮೋಕ್ಲಿರಾಖ್ಯೊಸ್” ಕರಿಬೋಲ್ಯು. <verse eid="GEN 19:13" /><verse number="14" style="v" sid="GEN 19:14" />ತದೆ ಲೋಟನೆ ಭಾರ್‌ಜೈನ್ ಇನ ಛೋ಼ರಿಯೇನ ವ್ಯಾಹ ಕರ‍್ನುಕರಿ ಥೋತೆ ಜ಼ಮೈಯೇನ ಆ ವಾತೆ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ. “ತುಮೆ ಉಠೀನ್‌ ಆ ಝ಼ಗೋನ ಮ್ಹೇಲಿನ್ ನಿಕ್‌ಳೊ. ಯೆಹೋವದೇವ್‌ ಆ ಗಾಮ್‌ನ ನಾಶ್‌ ಕರ್‌ಶೆ” ಕರಿ ಬೊಲ್ಯೊ. ಕತೋಬಿ ಇವ್ಣೆ ಲೋಟನ ನಕ್ಲೆ ಕರುಕರಸ್ ಕರಿಲ್ಹಾಜ್ಯು. <verse eid="GEN 19:14" /><verse number="15" style="v" sid="GEN 19:15" />ದನ್ ನಿಕ್ಳಾನ ಅಗಾಡಿ ಯೊ ದೂತಾವ್ನೆ ಲೋಟನ, “ತೂ ಉಠೀನ್‌ ತಾರಿ ಬಾವಣ್ಣಾಬಿ ಛೋ಼ರಿಯೇನಾಬಿ ಒಗ್ಗಿ ಬುಲೈಲಿನ್ ನಿಕಳ್‌; ಗಾಮ್‌ನ ಹುವಾನಿ ನಿಶಥ್ಥಿ ತೂಬಿ ನಾಶ್‌ಹುಯಿಜೈಶ್‌” ಕರಿ ಬೋಲಿನ್ ಉತ್ವಾಳಿ ಕರ‍್ಯು. <verse eid="GEN 19:15" /><verse number="16" style="v" sid="GEN 19:16" />ಯೊ ಧೇರ್‌ಕರಾಖ್ಹತರ್‌ ಯೆಹೋವ ದೇವ್‌ ಇನ ಗೋರ್‌ ಕರ‍್ಯೊತೆಖ್ಹಾಜೆ ಯೊ ಅದ್ಮೇವ್‌ನೆ ಇನಾಬಿ ಇನಿ ಬಾವಣ್ಣಾಬಿ ಲಡ್ಕಾವ್‌ನಾಬಿ ಹಾತ್‌ಧರೀನ್ ಖ್ಹಯೇರ್‌ನ ಭಾರ್‌ ಲಯಿನ್ ಮ್ಹೇಲ್ಯು. <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />ಇವ್ಣುನ ಭಾರ್‌ ಲಯಿನ್ ಇವ್ಣಾಮ ಏಕ್‌ ದೂತನೆ, “ನಾಶಿಜಾ಼ ಜಾನ್‌ ಬಚೈ಼ಲೇ ಪೀಠೆಫರೀನ್ ನಕೊದೇಕ್‌; ಆ ತಬರ್‌ಖಾಮ ಕಿಜ್ಜಾ಼ಬಿ ನಾಭೀರೆವ್ಣುತೆ ಪಹಾಡ್‌ನ ತಬರ್‌ಖಾಮ ನಾಶಿಜಾ಼; ತೂಬಿ ನಾಶ್‌ ಹುಯಿಜಿಶ್‌” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 19:17" /><verse number="18" style="v" sid="GEN 19:18" />ಇನ ಲೋಟಾನೆ, “ಪ್ರಭು, ಯೊ ಮಾರೇಥಿ ಹುವಾಕೊಯ್ನಿ; <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />ತು ತಾರ ದಾಸನ ಉಪ್ಪರ್‌ ದಯ ರಾಖಿನ್ ಮಾರಜಾನ್ನ ಬಚಾ಼ಡ್ಯೊತೆ ಘಣಿ ಮೋಟಿ ಮದತಸ್. ಯೊ ಘಣಿ ದೂರ್ ಛಾ಼ತೆಖ್ಹಾಜೆ ಮೆ ಪಹಾಡ್ನ ನಾಶಿಜ಼ವ್‌ಕೊಯ್ನಿ; ಮೇ ನಾಶಿ ಜಾ಼ವಾನ ಅಗಾಡಿಸ್ ಮರಿಜೈ಼ಶ್. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />ಹಂದೇಕ್‌, ಹಿಜ್ಜಾ಼ ಏಕ್‌ಖ್ಹಯೇರ್‌ ಖನ್ನೆ ಐರ‍್ಹೂಸ್; ಯೊ ನ್ಹಾನು; ಹಿಜ್ಜಾ಼ತೋಬಿ ಜಾ಼ವಾನ ಹುಕುಮ್‌ ಹುಯುತೊ ಮಾರೊ ಜಾನ್‌ ಬಚಿಜಾ಼ಶೆ. ಯೊ ಖ್ಹಯೇರ್‌ ನ್ಹಾನು ಕಾಹೇಕಿ ಶು” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 19:20" /><verse number="21" style="v" sid="GEN 19:21" />ಇನೆ ಜವಾಬ್ ದಿದೋಕಿ, “ಅನಿ ಬಾರೇಮಾಬಿ ತಾರಿ ಬಿಂತಿನ ಚ಼ಲೈದೆವ್ಸ್‌. “ದೇಕ್‌; ತೂ ಬೋಲ್ಯೊತೆ ಯೊ ಖ್ಹಯೇರ್‌ನ ನಾಶ್‌ ಕರೀಶ್‌ಕೊಯ್ನಿ. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />ಒಗ್ಗಿಮ ಹಿಜ಼್ಜ ಜೈ಼ನ್ ಬಚಿಜಾ಼; ತು ಯೊ ಖ್ಹಯೇರ್‌ನ ಪೋಚ಼ಲಗು ಮೇ ಶಾತ್ಬಿ ಕರಾನ ಕೋಹೊಯ್ನಿ” ಕರಿಬೋಲ್ಯೊ. ಲೋಟನೆ ಇನಖ್ಹಾಜೆ ಯೊ ಖ್ಹಯೇರ್‌ನ ‘ಚೋಗರ್‌’ ಕರಿ ನಾಮ್‌ಹುಯು.<verse eid="GEN 19:22" /></para>
  <para style="s">ಸೊದೋಮ್ ಅಜು಼ ಗೊಮೋರನು ನಾಶ್‌</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />ಲೋಟ ಚೋಗರ್‌ ಛಿಮಾಲಗು ಚಾ಼ಂದ್ ನಿಕ್‌ಳಿರ‍್ಹೋಥೊ. <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />ತದೆ ಯೆಹೋವದೇವ್ನೆ ಸೊದೋಮ್ ಗೊಮೋರಪರ್‌ ಸೋರ್ಗಥೊ ಆಗ್‌ ರಂಜ಼ಕ್‌ನ ವರ್ಖ್ಹಾಯೊ. <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />ಯೊ ಅಖ್ಖ ಖ್ಹಯೇರ್‌ನಬಿ ಅಶ್‌ಪೀಶ್‌ನು ತಬರ್ಖಾವ್‌ನಬಿ ಖ್ಹಯೇರ್‌ಮ ಥೂತೆ ಅದ್ಮಿವ್‌ನಾಬಿ ಧರ್ತಿಪರ್‌ಥೂತೆ ಖ್ಹಾರುಸ್ ಅನಾಜ಼್‌ನಾಬಿ ನಾಶ್‌ಕರಿನಾಖ್ಯೊ. <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />ಲೋಟಾನಿ ಬಾವಣ್‍ ಇನ ಪೀಠೆ ಆವಾನಿ ವಖ್ಹ್‌ತೆ ಪಾಛಿಫರಿನ್ ದೇಖಿ. ಇನಖ್ಹಾಜೆ ಯೊ ಮೀಟ್‌ನು ಖಮ್‌ ಹುಯಿಗಿ. <verse eid="GEN 19:26" /><verse number="27" style="v" sid="GEN 19:27" />ಹೈಕಡ್‌ ಅಬ್ರಹಾಮ್‌ ವ್ಹಾಣೆಉಠಿನ್ ಯೊ ಯೆಹೋವದೇವ್‌ಕನ ಭೀಯೊಥೋತೆ ಝ಼ಗೋಕನ್ ಪಾಛೊ಼ ಆಯೊ. <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />ಸೊದೋಮ್ ಅಜು಼ ಗೊಮೋರಭಣಿಬಿ, ಇನ ಅಶ್‌ಪಿಶ್‌ನು ಖ್ಹಾರುಸ್ ತಬರ್‌ಖ ಭಣಿಬಿ ದೆಖಾನಿವಖ್ಹ್‌ತೆ, ಅಯ್ಯೋ, ಧುವ್ವೊ ಆಗ್‍ನಿ ಪೋಯ್‌ ಉಪ್ಪರ್ ಉಡುಕರ್ತುಥು. <verse eid="GEN 19:28" /><verse number="29" style="v" sid="GEN 19:29" />ದೇವ್‌ನೆ ಯೊ ತಬರ್‌ಖಾನು ಖ್ಹಯೇರ್‌ನ ನಾಶ್‌ಕರಾನಿ ವಖ್ಹ್‌ತೆ ಲೋಟ ಜಿವ್ಣು ಕರುಕರ್ತೊಥೋತೆ ಖ್ಹಯೇರ್‌ನಾತೊ ಬರ್‌ಬಾತ್‌ ಕರ‍್ಯೊ, ಕತೋಬಿ ಅಬ್ರಹಾಮ್‌ನ ಯಾದ್ ಕರಿಲಿನ್ ಲೋಟನ ಛು಼ಕೈನ್ ಬಚಾ಼ಡ್ಯೊ.<verse eid="GEN 19:29" /></para>
  <para style="s">ಮೋವಾಬ್ಯ ಅಜು ಅಮೋನಿವಾಳನು ಉಬ್‍ಜಾ಼ವ್ಣಿ</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />ಲೋಟ ಚೋಗರ್‌ಮ ರ‍್ಹವಾನ ಡರ‍್ಯು ಇನಖ್ಹಾಜೆ ಇನಿ ಭೇ ಛೋ಼ರಿಯೇನ ಬುಲೈಲೀನ್ ಪಹಾಡ್‌ ಪರ್ಭತ್ ಛ಼ಡೀನ್ ಹಿಜ಼್ಜಾಥೂತೆ ಏಕ್‌ ಘವಿಮ ಜಿವ್ಣುಕರ‍್ಯು. <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />ಅಮ್‌ರ‍್ಹವಾಪರ್ ಮೋಟಿ ಛೋ಼ರಿ ಇನಿ ನ್ಹಾನಿ ಭೇನ್ನ, “ಅಪ್ಣೊ ಬಾ ಭುಡೊ ಎತ್ರೆಸ್; ಆ ಝ಼ಗೋನಿ ಪದತ್ತಿನಿ ಪರಕ್ಮ ಅಪ್ಣುನ ವ್ಯಾಹ ಕರವಾಳೊ ಪರ್ಖ್ಹೊ ಕಿಜ್ಜಾ಼ಬಿ ಕೊಯ್ನಿ; <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />ಆವ್ ಅಪ್ಣೆ ಬಾನ ದ್ರಾಕ್ಷಿನ ರಖ್ಹ್‌ನ ಪಿಡೈನ್‌, ಇನಜೋ಼ಡೆ ಖ್ಹುಯಿನ್‌ ಅಪ್ಣ ಬಾನಿ ಪಿಳ್ಗಿನ ಬಚಾ಼ಡೆಜಾ಼ಯ್‌” ಕರಿಬೋಲಿ. <verse eid="GEN 19:32" /><verse number="33" style="v" sid="GEN 19:33" />ಯೊ ರಾತ್‌ ಇವ್ಣೆ ಬಾನ ದ್ರಾಕ್ಷಿನರಖ್ಹ್‌ ಪಿಡಾವಖ್ಹತರ್‌ ಮೋಟಿ ಛೋ಼ರಿ ಇನಿಜೋಡ್ಮ ಖ್ಹುತಿ; ಇನ ಕಯೇಪ್‌ಥೂತೆ ಇನಖ್ಹಾಜೆ ಮಾಲುಮ್‌ ಪಡ್ಯುಕೊಯ್ನಿ. <verse eid="GEN 19:33" /><verse number="34" style="v" sid="GEN 19:34" />ಇನ ಬಿಜೇಕ್‌ ರೋಜ಼್ ಮೋಟಿ ಭೇನ್ನೆ ನ್ಹಾನಿನ, “ಕಾಲ್ನಿ ರಾತ್ ಮೇ ಬಾನಿಜೋ಼ಡ್ಮ ಖ್ಹುಯಿಗಿಥಿ; ಆ ರಾತ್ಬಿ ಇನ ನಿಶಾನು ದ್ರಾಕ್ಷಿನೊ ರಖ್ಹ್‌ಪಿಡೈಯೆ; ತದೆ ತೂ ಇನಿ ಜೋ಼ಡೆ ಖ್ಹುಯಿಜಾ಼; ಅಮ್‌ತೋಬಿ ಅಪ್ಣ ಬಾನಿ ಪಿಳ್ಗಿನ ಬಚಾ಼ಡ್ಯೆ” ಕರಿ ಬೋಲಿ. <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />ಯೊ ರಾತ್ಬಿ ಇವ್ಣೆ ಬಾನ ದ್ರಾಕ್ಷಿನೊ ರಖ್ಹ್‌ ಪಿಡೈನ್‌ ನ್ಹಾನಿ ಛೋ಼ರಿ ಇನಿಜೋಡ್ಮ ಖ್ಹುತಿ; ಇನ ಕಯೇಪ್‌ಥೂತೆ ಇನಖ್ಹಾಜೆ ಇನ ಶಾತ್‌ಬಿ ಮಾಲುಮ್ ಪಡ್ಯುಕೊಯ್ನಿ. <verse eid="GEN 19:35" /><verse number="36" style="v" sid="GEN 19:36" />ಅಮ್‌ ಲೋಟನಿ ಭೇ ಛೊ಼ರೀಯೆ ಬಾಥಿ ಬೇಜೂನಿ ಹುಯೆ. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />ಮೋಟಿಛೋ಼ರಿನೆ ಪರ್ಖ್ಹೊ ಲಡ್ಕುಜ಼ಣಿನ್ ಇನ “ಮೋಬಾಬ್‌” ಕರಿ ನಾಮ್‌ ಮ್ಹೇಲಿ. ಹಮ್ಕೇಲಗೂಬಿ ಛಾ಼ತೆ ಮೋವಾಬ್ಯವಾಳನ ಆಸ್ ಶುರುವಾತ್ನೊ ಪರ್ಖ್ಹೊ. <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />ನ್ಹಾನಿ ಛೋ಼ರಿನೆ ಪರ್ಖ್ಹೊ ಲಡ್ಕು ಜ಼ಣಿನ್ “ಬೆನಮ್ಮಿ” ಕರಿ ನಾಮ್‌ ಮ್ಹೇಲಿ. ಹಮ್ಕೇಲಗೂಬಿ ಛಾ಼ತೆ ಅಮ್ಮೋನಿಯವಾಳಾನ ಆಸ್ ಶುರುವಾತ್ನೊ ಪರ್ಖ್ಹೊ.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">ಅಬ್ರಹಾಮ್ ಅಜು಼ ಅಬೀಮೆಲೆಕ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />ಅಬ್ರಹಾಮ್ ಮಮ್ರೆಥೊ ನಿಕ್ಳಿನ್ ಹಿಜ್ಜಾ಼ಥೊ ಕಾನಾನ್ ದೇಖ್ಹ್‌ನು ದಕ್ಷಿಣ್ ತಬರ್ಖಾನ ಚಾ಼ಲ್‌ಕುಚ಼್ ಕರ್ತೊಹುಯಿನ್ ಕಾದೇಶ್‌ನಾಬಿ ಶೂರ್‌ನಬಿ ಬೀಚ್ಮ ಜಿವ್ಣುಕರ‍್ಯೊ. ಥೋಡದನ್ ಗೆರಾರ್‌ಮಾಬಿ ರ‍್ಹಯೊ. <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />ಅಬ್ರಹಾಮ್ ಇನಿ ಬಾವಣ್ ಸಾರನ ನ್ಹಾನಿ ಭೇನ್‍ಕರಿ ಬೋಲಿಲಿದೋತೆ ಇನಖ್ಹಾಜೆ, ಗೆರಾರ್‌ನೊ ರಾಜ಼ ಅಬೀಮೆಲೆಕನೆ ಸಾರನ ಬುಲೈಮಂಗೈನ್‌ ಇನ ಘರ್‌ಮ ರಾಖಿಲಿದೊ. <verse eid="GEN 20:2" /><verse number="3" style="v" sid="GEN 20:3" />ಕತೋಬಿ ಎಕ್ ರಾತ್ ದೇವ್ನೆ ಅಬೀಮೆಲೆಕನ ಖ್ಹೋಣ್ಯಾಮ ಆಯಿನ್, “ಯೊ ತಯೇಡನ ಮಳೈಲಿದೊತೆ ಇನಖ್ಹಾಜೆ ತೂ ಮರವಾಳೊ ಹುಯಿರ‍್ಹೋಸ್; ಯೊ ಬಿಜೇಕ್ ಪರ್ಖ್ಹಾನಿ ಬಾವಣ್ ಹುಯಿರ‍್ಹೀಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 20:3" /><verse number="4" style="v" sid="GEN 20:4" />ಕತೋಬಿ ಅಬೀಮೆಲೆಕ ಸಾರಥಿ ಮಳಿರ‍್ಹೋಥೊ ಕೊಯ್ನಿ. ಇನೆ, “ಪ್ರಭು, ನೀತಿವಾಳ ಹುಯಿರ‍್ಹಾತೆ ಅದ್ಮಿಖ್ಹಾರನಾಬಿ ನಾಶಕರೀಶ್‍ಕಿಶು? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />ಯೊ ಅದ್ಮಿನೆ ಹೈರಿತೆ ಮಾರಿ ನ್ಹಾನಿ ಭೇನ್‍ಕರಿ ಬೊಲ್ಯೊ. ಇನೇಬಿ ಯೊ ಮನ ಮೋಟೊಭೈ ಹೋಣುಕರಿ ಬೋಲಿ. ಮೇಬಿ ಖ್ಹಾಚ಼ ದಿಲ್‌ಥಿ, ಅಮ್‍ಕರ‍್ಯೋತೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 20:5" /><verse number="6" style="v" sid="GEN 20:6" />ಇನ ಖ್ಹೋಣ್ಯಮ ದೇವ್ನೆ, “ತೂ, ಖ್ಹಾಚ಼ದಿಲ್‍ಥಿ ಅಮ್‍ಕರ‍್ಯೋತೆ ಕರಿ ಮನ ಮಾಲುಮ್; ಇನಖ್ಹಾಜೆ ತೂ ಮಾರ ಖ್ಹಾಮ್ಣೆ ಪಾಪ್‍ ನಾಕರ‍್ನುತೆ ತಿಮ್ ಮೇ ತಾರ ಆಡೊ ಹುಯಿನ್ ಹೈರಿತೇನ ಛೀಮದಿದೊ ಕೊಯ್ನಿ. <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />ಅಮ್‍ರ್ಹಾವಪರ್ ಯೊ ಅದ್ಮಿನಿ ಬಾವಣ್ಣ ಇನ ದಿನಾಖಿದೆ. ಯೊ ಪ್ರವಾದಿ, ತಾರಖ್ಹಾಜೆ ಯೊ ಮನ ಬಿಂತಿ ಕರ್ಶೆ ಅಜು಼ ತೂ ಬಚಿಶ್. ಇನಿ ಬಾವಣ್ಣ ಇನ ನಾ ದಿನಾಖ್ಯೊತೊ ತೂಬಿ ತಾರಭಣಿನು ಖ್ಹಾರೂಸ್ ಮರಿಜಾ಼ಶುಕರಿ ಮಾಲುಮ್‍ ಕರಿಲೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 20:7" /><verse number="8" style="v" sid="GEN 20:8" />ಇನವ್ಹಾಣೆ ಅಬೀಮೆಲೆಕನೆ ಇನ ಕಾಮ್‌ಗಿರಿ ಖ್ಹಾರಸ್ನ ಮಳೈನ್ ಆ ಖ್ಹಾರಿ ವಾತೆ ಖ್ಹಮ್‍ಜಾ಼ಡಖ್ಹತರ್ ಇವ್ಣೆ ಘಣು ಡರ‍್ಯು. <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />ಅಬೀಮೆಲೆಕನೆ ಅಬ್ರಹಾಮ್‍ನ ಬುಲೈನ್, “ತೂ ಹಮುನ ಕರ‍್ಯೋತೆ ಶಾತ್‌? ಮೇ ಶನು ಪಾಪ್ ಕರ‍್ಯೋತೆ ಇನಖ್ಹಾಜೆ ತೂ ಮನಾಬಿ ಮಾರ ರಾಜ್ಯನಾಬಿ ನಾಶನ್‌ಮ ಘಾಲಿದಿದೊ? ತೂ ನಾಕರ‍್ನುತೆ ಕಾಮ್‍ಕರಾನ ಮೇ ತುನ ಶಾತ್‌ ಕರ‍್ಯೋಥೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />ಆನಾಹುಯಿನ್ “ತೂ ಖೆವಿ ಖ್ಹೂಜ಼್‌ಥಿ ಆ ಕಾಮ್ ಕರ‍್ಯೊತೆ?” ಕರಿ ಅಬೀಮೆಲೆಕನೆ ಅಬ್ರಹಾಮ್‍ನ ಪುಛಾ಼ಯೊ. <verse eid="GEN 20:10" /><verse number="11" style="v" sid="GEN 20:11" />ಇನ ಅಬ್ರಹಾಮ್‌ನೆ, “ಆ ಝ಼ಗೊವಾಳು ದೇವ್‍ನೊ ಡರ್‌ಕೊಂತೆ ಮಾರಿ ಬಾವಣ್‍ನಖ್ಹಾಜೆ ಮನ ಮಾರಿನಾಖೆಜಾ಼ಯ್ನಿ ಕರಿ ಲಾಝ್ಯೊ. <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />ಯೊ ನಾಹುಯಿನ್ ಆ ಹೈರಿತೆ ಖ್ಹಾಚಾಮ ಮಾರಿ ನ್ಹಾನಿ ಭೇನ್, ಮಾರ ಬಾನಿಛೋ಼ರೀಸ್; ಕತೋಬಿ ಮಾರಿ ಆಯಾನಿ ಛೋ಼ರಿ ಕಾಹೇ ಇನಖ್ಹಾಜೇಸ್ ಮನ ಬಾವಣ್‍ಬಣಿ. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />ಮೇ ದೇವ್ನಿ ಖ್ಹೂಜ಼್‍ಥಿ ಬಾನು ಘರ್ ಮ್ಹೇಲಿನ್ ದೇಖ್ಹ್‌ಪರ್ ಜಾ಼ವಾನ ನಿಕ್ಳಾನಿವಖ್ಹ್‌ತೆ ಮೇ ಇನ, ‘ಅಪ್ಣೆ ಜಾ಼ವನಿ ಖ್ಹಾರಿಸ್ ಝ಼ಗೋಮಾಬಿ ಮನ ತಾರೇಥಿ ಎಕ್ ಮದತ್ ಮಳ್‌ಣು. ಯೊ ಶಾತ್‍ಕತೊ ತೂ ಮನ ಮೋಟೊಭೈ ಕರಿಬೋಲ್ನು’ ಕರಿ ಖ್ಹಮ್‍ಜಾ಼ಡ್ಯೋಥೊ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 20:13" /><verse number="14" style="v" sid="GEN 20:14" />ತದೆ ಅಬೀಮೆಲೆಕನೆ ಅಬ್ರಹಾಮ್‍ನ ಇನಿ ಬಾವಣ್‍ ಸಾರನ ದಿನಾಖ್ಯೊ, ಅಜು಼ ಇನಜೋ಼ಡೆ ಢಾಂಡ ಮೇಂಢನಾಬಿ ದಾಸ ದಾಸಿನಾಬಿ ದಿನಾಖ್ಯೊ. <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />“ಹಂದೇಕ್‌, ಆ ಮಾರೊ ದೇಖ್ಹ್‌; ಅನಾಮ ತುನ ಪಸಂದ್‌ಲಾಗಾತೆ ಬಾಜು಼ಮ ತೂ ಜಿವ್ಣುಕರೇಜಾ಼ಯ್” ಕರಿ ಅಬೀಮೆಲೆಕನೆ ಬೊಲ್ಯೊ. <verse eid="GEN 20:15" /><verse number="16" style="v" sid="GEN 20:16" />ಆನಾಹುಯಿನ್ ಇನೆ ಸಾರನ, “ತಾರ ಮೋಟಭೈನ ಹಜಾ಼ರ್‌ ರೂಪಾನ ಪೈಶ ದೀರಾಖ್ಯೋಸ್; ಚಾ಼ಲ್ಯುತೆ ತಿನ ತಾರಭಣಿವಾಳು ಅನ ಖ್ಹಯಾಲ್ ನಾಕರ‍್ನುತೆ ತಿಮ್ ರ‍್ಹವಾನ ಆಹೈರುತೆ ಪ್ರಾಯಶ್ಚಿತ್ ಹುಯಿರ‍್ಹವಾದೆ; ತು ಇಜ಼್ಜತ್‌ವಾಳಿಕರಿ ಅನೇಥಿ ಖ್ಹಾರುಜ಼ಣು ಮಾಲುಮ್‌ಕರ್ಲಿಶೆ.” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 20:16" /><verse number="17" style="v" sid="GEN 20:17" />ತದೆ ಅಬ್ರಹಾಮ್‌ನೆ ದೇವ್ನ ಬಿಂತಿಕರಾಮ ದೇವ್ನೆ ಅಬೀಮೆಲೆಕನಾಬಿ, ಇನಿ ಬಾವಣ್ಣಾಬಿ, ಅಜು಼ ದಾಸಿಯೇವ್‌ನಾಬಿ ಗುಣ್‌ಕರ‍್ಯೊತೆ ಇನಖ್ಹಾಜೆ ಇವ್ಣುನ ಲಡ್ಕಹುಯು. <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />ಅನೇಥಿ ಅಗ್ಗಳ್ ಅಬ್ರಹಾಮ್‌ನಿ ಬಾವಣ್‍ ಸಾರನಟೇಕೆ ಯೆಹೋವ ದೇವ್ನೆ ಅಬೀಮೆಲೆಕನ ಘರ್ಮಥಿಯೆತೆ ಖ್ಹಾರಿಸ್ ತಯೇಡಾವ್ನ ವಾಂಝ಼್‌ಣಿ ಬಣೈರಾಖ್ಯೊಥೊ.<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">ಇಸಾಕನಿ ಪೈದಾಖ್ಹ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />ಯೆಹೋವದೇವ್‌ ಇನೆ ವಾಗ್ದಾನ್‌ ಕರ‍್ಯೊತೆ ತಿಮ್ಮಸ್‌ ಸಾರನ ಉಪ್ಪರ್‌ ಗೋರ್‌ಕರೀನ್ ಇನೆ ದಿದೋತೆ ವಾತ್ನ ಅನುಗ್ರಹಥಿ ಚಲಾಯೊ. <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />ಇಮ್ಮಸ್‌ ಸಾರ ಬೇಜೂನಿಹುಯಿನ್, ದೇವ್ನೆ ಫೈಲೆಸ್‌ ಖ್ಹಣೇದ್ ಕರ‍್ಯೊತೆ ದನ್ಮಾಸ್ ಅಬ್ರಹಾಮಥಿ ಇನ ಭುಡ್‌ಪಣ್‌ಮಾಸ್ ಇನ ಏಕ್‌ ಛಿಯ್ಯೊಜ಼ಣಿ. <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />ಅಬ್ರಹಾಮನೆ ಸಾರಥಿ ಪೈದಹುಯೊತೆ ಛಿಯ್ಯಾನ “ಇಸಾಕ” ಕರಿ ನಾಮ್‌ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />ಇಸಾಕ್‌ ಪೈದಹುಯಿನ್ ಆಟ್ನ ದನ್ಮ ದೇವ್ ಆಣ್ ಕರ‍್ಯೊತೆ ತಿಮ್ಮಸ್ ಅಬ್ರಹಾಮ್‌ನೆ ಇಸಾಕನ <note caller="+" style="f"><char style="fr" closed="false">21:4 </char><char style="ft" closed="false">ದೇವ್ನಿ ವಾಗ್ದಾನ್ನಿ ಪರಕ್ಮ ಹಿಬ್ರು ಜ಼ಗ್‌ಜಾ಼ತ್‌ಮ ಆಟ್ನ ದನ್ಮ ಪರ್ಖ್ಹಾಲಡ್ಕನ ಇನ ಮುತ್ತರ್‌ಖ್ಹಾಣಿನು ನೋಕ್ನು ಚಾ಼ಂಬ್ಡು ಕತ್ರಾನಿ ಪದತ್ತಿನ ಖ್ಹತ್ನ ಕರಿ ಬೋಲಸ್‌.</char></note>ಖ್ಹತ್ನ ಕರ‍್ಯೊ. <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />ಇಸಾಕ ಪೈದಹುಯೊ ತದೆ ಅಬ್ರಹಾಮ್‌ನ ಖ್ಹೊ ವರಖ್ಹ್‌ನೊ ಹುಯಿರ‍್ಹೋಥೊ. <verse eid="GEN 21:5" /><verse number="6" style="v" sid="GEN 21:6" />ಸಾರನೆ, “ದೇವ್‌ ಮನ ಖ್ಹುಷಿ ಕರೈನ್‌ ಹಾಖ್ಹನಿಘೊಣಿ ಕರ‍್ಯೊ; ಹಮ್ಕೆಲಗೂಬಿ ಆ ಬಾರೇಮ ಖ್ಹಮ್‌ಜ಼ವಾಳು ಖ್ಹಾರುಸ್ ಮಾರಿಜೋ಼ಡ್ಮ ಹಾಖ್ಹ್‌ಶೆ. <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />ಆಸ್ ಕಾಹೆತೆ ಸಾರಬಿ ಲಡ್ಕಾವ್ನ ದೂದ್ ಪಿಡಾವ್‌ಷೆಕರಿ ಕೋಣ್‌ತೋಬಿ ಅಬ್ರಹಾಮನ ಬೋಲಾನ ಹುಯುಹೋತ್ಕಿ ಶು? ಕತೋಬಿ ಇನಿ ಭುಡಿ ಉಂಬರ್‌ಮಾಬಿ ಇನ ಛಿಯ್ಯೊ ಜ಼ಣಿದಿದಿನಿ” ಕರಿ ಬೋಲಿಲಿದಿ. <verse eid="GEN 21:7" /><verse number="8" style="v" sid="GEN 21:8" />ಯೊ ಲಡ್ಕು ಮೋಟುಹುಯಿನ್ ದೂದ್ ಪಿಯಾನು ಮ್ಹೇಲ್‌ದಿದು. ಇಸಾಕ್‌ ದೂದ್ ಮ್ಹೇಲ್ಯೊತೆ ದನ್ಮ ಅಬ್ರಹಾಮನೆ ಮೊಟು ಮಿಝ಼್‌ವಾನ್ ಕರಾಯೊ.<verse eid="GEN 21:8" /></para>
  <para style="s">ಹಾಗರ್ ಅಜು ಇಷ್ಮಾಯೇಲ್‌ನ ಭಾರ್ ಕಾಡಿನಾಖ್ಯೊತೆ</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 21:9" />ಏಕ್‌ದನ್ ಈಜಿಪ್ಟ್‌ನಿ ಹಾಗರ್‌ಥಿ ಅಬ್ರಹಾಮನ ಪೈದಹುಯೊತೆ ಛಿಯ್ಯಾನೆ ಇಸಾಕನಿ ಬಾರೇಮ ನಕ್ಲೆಕಾಡಾನು ದೇಖಿನ್ ಸಾರನೆ, <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />ಅಬ್ರಹಾಮನ, “ಆ ದಾಸಿನಾಬಿ ಇನ ಛಿಯ್ಯಾನಾಬಿ ಭಾರ್‌ಕಾಡ್‌; ಆ ದಾಸಿನೊ ಛಿಯ್ಯೊ ಮಾರ ಛಿಯ್ಯೊ ಇಸಾಕನಿ ಜೋಡ್ಮ ಹಕ್‌ದಾರ್‌ ನಾಬಣ್ಣು” ಕರಿಬೋಲಿ. <verse eid="GEN 21:10" /><verse number="11" style="v" sid="GEN 21:11" />ಆ ವಾತೆ ಖ್ಹಮ್‌ಜಿನ್ ಅಬ್ರಹಾಮನ ಘಣು ದುಖ್‍ಹುಯು. ಶನಕತೊ ಇಷ್ಮಾಯೇಲ್‌ಬಿ ಇನೊ ಛಿಯ್ಯೊಸ್ ಹುಯಿರ‍್ಹೋಥೊ. <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />ಕತೋಬಿ ದೇವ್ನೆ ಅಬ್ರಹಾಮ್‌ನ, “ತಾರ ಛಿಯ್ಯಾನ ಅಜು಼ ದಾಸಿನಖ್ಹಾಜೆ ಇನ ವೇಚ಼್‌ಣೆ ನಾಹೊಣು; ಸಾರನೆ ಬೋಲಿತೆ ತಿಮ್ಮಸ್‌ಕರ್‌; ಇಸಾಕಥಿ ಪೈದಹುವವಾಳೂಸ್ ತಾರಿ ಪಿಳ್ಗಿ ಕರಿ ಬೋಲೈಲಿಶೆ; <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />ಆ ದಾಸಿನೊ ಛಿಯ್ಯೊ ತಾರೇಥಿ ಪೈದಹುಯೋತೆ ಇನಖ್ಹಾಜೆ ಇನೇಥಿಬಿ ಘಣು ಜ಼ಗ್‌ಜಾ಼ತ್‌ಹುವಾನಿತರ ಆಶೀರ್ವಾದ್‌ ಕರುಸ್” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 21:13" /><verse number="14" style="v" sid="GEN 21:14" />ಇನವ್ಹಾಣೆ ಅಬ್ರಹಾಮನೆ ಉಠೀನ್‌ ಹಾಗರನ ಥೋಡು ಖಾಣಾನು ಬುತ್ತುಬಿ, ಚಾ಼ಂಬ್‌ಡಾನಿ ತಿತ್ತೀಮ ಪಾಣಿ ಭರಿದೀನ್, ಲಡ್ಕಾನ ಇನ ಖಾಂದೆ ಬೆಖ್ಹಾಡಿ ಮೋಕಲ್‌ದಿದೊ. ಯೊ ನಿಕ್ಳಿನ್‌ ಬೇರ್ಷೆಬನಿ ಝಾ಼ಡಿಮ ಡುಂಡ್ವಾತಿಫಂಡ್ತಿಥಿ. <verse eid="GEN 21:14" /><verse number="15" style="v" sid="GEN 21:15" />ತಿತ್ತಿಮಥೂತೆ ಪಾಣಿ ಖ್ಹತಮ್ ಹುವಾನಪಾರ್ ಇನೆ ಲಡ್ಕಾನ ಡಾಗ್ನ ಛಾ಼ಳಾಮ ಖ್ಹುಡೈನ್, <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />ಬಂಡೊಫೇಕ ಎತ್ರೆ ದೂರ್‌ ಜೈ಼ನ್ ಬೇಶಿನ್, “ಲಡ್ಕು ಮರಾನು ಮನ ಖ್ಹಮಾಳನ ಕೋಹೊಯ್ನಿ” ಕರಿ ಬೋಲಿನ್ ಖ್ಹಡ್‌ಕ್ಯಭರಿ ರದನ್‌ಕರಿ. <verse eid="GEN 21:16" /><verse number="17" style="v" sid="GEN 21:17" />ಯೊ ಛೋ಼ಕ್ರು ರೋವಾನು ದೇವ್ನ ಖ್ಹಮಜ಼್‌ಪಡ್ಯು; ದೇವ್ನ ದೂತನೆ ಸೊರ್ಗಥೊ ಹಾಗರನ ಚಿಕ್ರಿನ್ ಇನ, “ಹಾಗರ್‌ ತುನ ಶಾತ್‌ಹುಯು? ಡರ್‌ನಕೊ; ಯೊ ಲಡ್ಕಾನಿ ಚಿಕ್ರಾಣ್ ದೇವ್ನ ಖ್ಹಮಜ಼್‌ಪಡ್ಯು <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />ತೂ ಉಠಿಜೈನ್ ಛೋ಼ಕ್ರಾನ ಪಾಡಿಲೆ, ಶನಕತೊ ಇನೇಥಿ ಮೋಟಿ ಜ಼ಗ್‌ಜಾ಼ತ್‌ ಹುವಾನಿಘೋಣಿ ಕರುಸ್” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 21:18" /><verse number="19" style="v" sid="GEN 21:19" />ಆ ನಾಹುಯಿನ್ ದೇವ್ನೆ ಇನ ಡೋಳಾನ ಉಖ್‍ಡ್ಯೊ, ಇನೆ ಹಿಜ಼್ಜ ಪಾಣಿನಿ ಬಾವ್ಡಿನದೇಖಿ ತಿತ್ತಿಮ ಪಾಣಿಭರಿ ಲಯಿನ್ ಛಿಯ್ಯಾನ ಪಿಡೈ. <verse eid="GEN 21:19" /><verse number="20" style="v" sid="GEN 21:20" />ದೇವ್ ಯೊ ಛೋ಼ಕ್ರಾನಿ ಜೋ಼ಡ್ಮ ಥೊ; ಯೊ ಮೋಟೊಹುಯಿನ್‌ ಝಾ಼ಡಿಮ ರ‍್ಹೇತೊಹುಯಿನ್ ಶಿಕಾರಿಬಣ್ಯೊ. <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />ಯೊ ಪಾರಾನ್ನಿ ಝಾ಼ಡಿಮ ಜಿವ್ಣು ಕರ‍್ಯೊ. ಇನಿ ಆಯಾನೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಛೋ಼ಕ್ರಿ ಲಾಯಿ.<verse eid="GEN 21:21" /></para>
  <para style="s">ಅಬ್ರಹಾಮನಾಬಿ ಅಜು಼ ಅಬೀಮೆಲೆಕನ ಬೀಚ್ಮ ಹುಯುತೆ ಒಪ್ಪಂದ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />ಯೊ ಹಗಾಮ್ಮ ಅಬೀಮೆಲೆಕನೆ ಇನೊ ಶಿಪಾಯಿನ ಮೋಟೊ ಫೀಕೋಲನ ಜೋ಼ಡ್ಮ ಅಬ್ರಹಾಮಕನ ಜೈ಼ನ್, “ತೂ ಕರಾತೆ ಖ್ಹಾರಾಸ್ ಕಾಮ್ಮ ದೇವ್ ತಾರ ಜೋ಼ಡ್ಮ ಛಾ಼. <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />ಇನಖ್ಹಾಜೆ ತೂ ಮನಾಬಿ, ಮಾರ ಲಡ್ಕಾವ್‍ನಾಬಿ, ಮಾರಿ ಪಿಳ್ಗಿನಾಬಿ ಅನ್ಯಾಮ್ ನಾಕರ‍್ನುತೆ, ಮೇ ತುನ ದಯ ಕರ‍್ಯೊತೆ ತಿಮ್ಮಸ್, ಮನಾಬಿ, ತೂ ಜಿವ್ಣುಕರ‍್ಯೊತೆ ಆ ದೇಖ್ಹ್‌ನಾಬಿ ಅಛ್ಛು಼ ಕರೀಶ್‍ಕರಿ ದೇವ್ನ ಉಪ್ಪರ್ ಆಣ್ ಕರ‍್ನು.” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 21:23" /><verse number="24" style="v" sid="GEN 21:24" />ಇನಖ್ಹಾಜೆ ಅಬ್ರಹಾಮನೆ “ಇಮ್ಮಸ್ ಮೇ ಆಣ್ ಕರುಸ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 21:24" /><verse number="25" style="v" sid="GEN 21:25" />ಅಬೀಮೆಲೆಕನ ಆಳ್‌ನೆ ಎಕ್ ಬಾವ್ಡಿನ ಜು಼ಲಮ್‌ಥಿ ಕಬ್‍ಜಾ಼ ಕರಿಲಿದುತೆ ಇನಖ್ಹಾಜೆ ಅಬ್ರಹಾಮನೆ ಅಬೀಮೆಲೆಕನ ಉಪ್ಪರ್ ಗಲತ್‌ ನಾಖ್ಯೊ, <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />ಅಬೀಮೆಲೆಕನೆ” ಆ ಕಾಮ್ ಕೋಣ್ ಕರ‍್ಯೂಕಿ ಮನ ಮಾಲುಮ್‍ಕೊಯ್ನಿ; ತೂ ಮನ ಬೋಲ್ಯೊಬಿಕೊಯ್ನಿ , ಹಮ್ಕೆಲಗು ಮೇ ಆ ವಾತೆನ ಖ್ಹಮ್‍ಜ್ಯೊಬಿ ಕೊಯ್ನಿ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 21:26" /><verse number="27" style="v" sid="GEN 21:27" />ತದೆ ಅಬ್ರಹಾಮ್‌ನೆ ಢಾಂಡ ಬೋಕ್ಡಾವ್ನ ಅಬೀಮೆಲೆಕನ ಧರಮ್‍ ದಿದೊ. ಇಮ್ ಕರಾಥಿ ಭೇಜ಼ಣಾನ ಇಚ಼್‌ಮ ಒಪ್ಪಂದ ಹುಯು. <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />ಅನಕೇಡೆಥು ಅಬ್ರಹಾಮನೆ ಮಂಧಮಾನು ಖ್ಹಾತ್ ಮೇಂಢಿನ ಅಲಕ್‍ ರಾಖಖ್ಹತರ್, <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />ಅಜು಼ ಅಬೀಮೆಲೆಕನೆ ಅಬ್ರಹಾಮ್‍ನ, “ತೂ ಆ ಖ್ಹಾತ್ ಮೇಂಢಿನ ಅಲಕ್‍ ರಾಖಾನೊ ಮಾಯ್ನೊ ಶಾತ್?” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 21:29" /><verse number="30" style="v" sid="GEN 21:30" />ಇನ ಅಬ್ರಹಾಮ್‌ನೆ, “ಆ ಬಾವ್ಡಿನ ಖೋಂದಾಯೊತೆ ಮೇಸ್ ಕರಿ ಬೋಲಾನ ಸಬೂತ್‌ಹುಯಿನ್ ತೂ ಆ ಖ್ಹಾತ್ ಮೇಂಢಿನ ಮಾರ ಹಾತೇಥಿ ಮಾಂಗಿಲೇವ್ಣು” ಕರಿ ಬೋಲಿನ್, ಇವ್ಣೆ ಬೇಜ಼ಣಾಬಿ ಒಪ್ಪಂದಾನ ಕರಿಲಿದ. <verse eid="GEN 21:30" /><verse number="31" style="v" sid="GEN 21:31" />ಇವ್ಣೆ ಭೇಜ಼ಣ ಹಿಜ಼್ಜ ಆಣ್‍ಕರ‍್ಯಾತೆ ಇನಖ್ಹಾಜೆ ಯೊ ಝ಼ಗೋನ “ಬೇರ್ಷೆಬ” ಕರಿ ನಾಮ್‌ಆಯು. <verse eid="GEN 21:31" /><verse number="32" style="v" sid="GEN 21:32" />ಬೇರ್ಷೆಬಮ ಇವ್ಣೆ ಒಪ್ಪಂದ ಕರಿ ಹುಯಿಜಾ಼ವದಿನ್ ಅಬೀಮೆಲೆಕಬಿ ಇನೊ ಶಿಪಾಯಿ ಫೀಕೋಲಬಿ ಫಿಲಿಷ್ಟಿಯವಾಳನ ದೇಖ್ಹ್‌ನ ಪಾಛ಼ ಚ಼ಲೇಗಯ. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />ಅಬ್ರಹಾಮ್ ಬೇರ್ಷೆಬಮ ತಮರಿಸ್ಕ್ ನಾಮ್ನು ಝಾ಼ಡ್ನ ಗಾಡಿನ್ ಹಿಜ಼್ಜ ಹಮೇಶನೊ ದೇವ್‍ ಯೆಹೋವನ ನಾಮ್ನ ಬೋಲಿನ್ ಅರಾದನೆಕರ‍್ಯೊ. <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />ಅಬ್ರಹಾಮನೆ ಫಿಲಿಷ್ಟಿಯವಾಳನ ದೇಖ್ಹ್‌ಮ ಘಣದನ್‍ಲಗು ಜಿವ್ಣುಕರ‍್ಯೊ.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">ಇಸಾಕ್‌ನ ಅರ್ಪಣ್ ಕರ್‌ಕರಿ ಅಬ್ರಹಾಮ್‍ನ ದೇವ್ ಹುಕುಮ್ ಕರ‍್ಯೋತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />ಆ ಖ್ಹಾರಿ ವಾತೆ ಹುವಾನ ಪಾರ್ ದೇವ್ನೆ ಅಬ್ರಹಾಮ್‍ನ ತರೀಪ್ಷ ಕರ‍್ಯೊ. ಕಿಮ್‌ಕತೊ ದೇವ್ನೆ ಇನ, “ಅಬ್ರಹಾಮ್” ಕರಿ ಬುಲಾಯೊ ಇನೆ, “ಹಂದೇಕ್‌, ಮೇ ಹಜ಼್ಜ ಛೂ಼” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 22:1" /><verse number="2" style="v" sid="GEN 22:2" />ತದೆ ಇನೆ, “ತುನ ಪ್ಯಾರ‍್ನೊ ಎಕ್ಕಸ್‍ ಛಿಯ್ಯೊ ಇಸಾಕನ ಬುಲೈಲೀನ್ ಮೋರಿಯ ತಬರ್‌ಖಾಮ ಜೈ಼ನ್ ಹಿಜ಼್ಜ ಇನ ಮೇ ವತಾಳುತೆ ಎಕ್ ಪಹಾಡ್‌ಪರ್ ಮನ ಬಲಿದೇವ್ಣು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 22:2" /><verse number="3" style="v" sid="GEN 22:3" />ಇಮ್ಮಸ್ ವ್ಹಾಣವೇಳಿ ಉಠೀನ್ ಅಬ್ರಹಾಮ್‌ನೆ ಗಧೇಡಪರ್ ಬಲಿನ ಹೋಣುತೆ ಲಾಕ್ಡಾನ ಢೊವಾಡಿನ್ ಇನ ಸೇವಕ್‌ಮಾಥು ಬೇಜ಼ಣನಬಿ, ಇನೊ ಛಿಯ್ಯೊ ಇಸಾಕ್‍ನಾಬಿ ಬುಲೈಲೀನ್ ದೇವ್ನೆ ಬೋಲ್ಯೋತೆ ಝ಼ಗೋಕನ ನಿಕ್‍ಳ್ಯೊ. <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />ತೀನ್ನದನ್ನೆ ಅಬ್ರಹಾಮ್‌ನೆ ಡೋಳಪಾಡಿ ದೇಖಾನಿವಖ್ಹ್‌ತೆ ಯೊ ಝ಼ಗೊ ದೂರ್‌ಮ ದೆಖಾಯು. <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />ತದೆ ಇನ ಸೇವಕ್‌ನ, “ತುಮೆ ಹಜ್ಜಾ಼ಸ್ ಗಧೇಡಕನ ರ‍್ಹವೊ; ಮೇಬಿ ಮಾರೊ ಛಿಯ್ಯೊಬಿ ಹಿಜ಼್ಜ ಜೈ಼ನ್ ದೇವ್ನಿ ಆರಾದನೆ ಕರ‍್ಲಿನ್ ಪಾಛ಼ ಹಜ್ಜಾ಼ಸ್ ತುಮಾರಕನ ಐಯೇಸ್” ಕರಿ ಅಬ್ರಹಾಮ್‌ನೆ ಬೊಲ್ಯೊ. <verse eid="GEN 22:5" /><verse number="6" style="v" sid="GEN 22:6" />ಅಬ್ರಹಾಮ್‌ನೆ ಬಲಿನ ಹೋಣುತೆ ಲಾಕ್ಡಾನ ಇನೊ ಛಿಯ್ಯೊ ಇಸಾಕನ ಉಪ್ಪರ್ ಢೊವಾಡಿನ್, ಇನ ಹಾತ್ಮಸ್ ಇಂಗಾಠೊಬಿ ಛ಼ರಿನಾಬಿ ಪಾಡಿಲೀನ್ ಇವ್ಣೆ ಭೇಜ಼ಣಾಬಿ ನಿಕ್‍ಳ್ಯ. <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />ಜಾ಼ವಾನಿ ವಖ್ಹ್‌ತೆ ಇಸಾಕ್‍ನೆ ಇನೊ ಬಾ ಅಬ್ರಹಾಮ್‌ನ, “ಬಾ" ಕರಿ ಫುಕಾರಖ್ಹತರ್ ಅಬ್ರಹಾಮ್‌ನೆ, “ಶಾತ್‌ಲ ಜಾ಼ಯ” ಕರಿಬೋಲ್ಯೊ. ಇಸಾಕ್‍ನೆ, ಹಂದೇಕ್‌ ಇಂಗಾಠೊಬಿ ಲಾಕ್ಡಬಿ ಛಾ಼; ಕತೋಬಿ ಹೋಮ ಬಲಿನ ಹೋಣುತೆ ಮೇಂಢು ಕ್ಯಾ?” ಕರಿ ಪುಛಾ಼ಯೊ. <verse eid="GEN 22:7" /><verse number="8" style="v" sid="GEN 22:8" />ಅಬ್ರಹಾಮ್‌ನೆ, “ಜಾ಼ಯ, ಬಲಿನ ಹೋಣುತೆ ಮೇಂಢಾನ ದೇವಸ್‌ ದಿಶೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 22:8" /><verse number="9" style="v" sid="GEN 22:9" />ದೇವ್ನೆ ಬೋಲ್ಯೊತೆ ಝ಼ಗೋಕನ ಇವ್ಣೆ ಐನ್‌ ಅಬ್ರಹಾಮ್‌ನೆ ಚಾ಼ಚ಼ರ್‌ ಭಾಂದ್ಯೊ. ಲಾಕ್ಡಾನಿ ಢೇರಿಕರಿನ್ ಇನೊ ಛಿಯ್ಯೊ ಇಸಾಕನ ಹಾತ್ ಗೋಡ ಭಾಂದಿನ್‌ ಇನ ಚಾ಼ಚ಼ರ್‌ಪರ್ ಥೂತೆ ಲಾಕ್ಡಪರ್ ಪಾಡಿನಾಖ್ಯೊ. <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />ಅಬ್ರಹಾಮ್‌ನೆ ಇನ ಛಿಯ್ಯಾನ ಬಲಿ ದ್ಯಾವಾನಖ್ಹಾಜೆ, ಹಾತ್ ಪೂರೈನ್ ಛ಼ರಿಪಾಡಿಲಿದೊ. <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />ತದೆ ಯೆಹೋವನ ದೂತಾನೆ ಆಬ್‍ನ ಮಹಿಥೊ, “ಅಬ್ರಹಾಮ್, ಹೇ ಅಬ್ರಹಾಮ್” ಕರಿ ಇನ ಫುಕಾರ‍್ಯೊ. ಇನಖ್ಹಾಜೆ ಅಬ್ರಹಾಮ್‌ನೆ, “ಹಂದೇಕ್‌ ಹಜ್ಜಾ಼ಸ್‌ಛು಼” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 22:11" /><verse number="12" style="v" sid="GEN 22:12" />ಯೊ ದೂತಾನೆ ಇನ, “ಛೋ಼ಕ್ರಾನ ಶಾತ್‌ಬಿ ನಕೋಕರ್. ತೂ ತಾರೊ ಎಕ್ಕಸ್ ಛಿಯ್ಯಾನ ಮನ ಬಲಿದ್ಯವಾನ ಪೀಛೆ ಹಟ್ಯೊಕೊಯ್ನಿ. ಹಮ್ಕೆ ತೂ ದೇವ್‍ಮ ಡರ್‌ಭಕ್ತಿಮ ರ‍್ಹವಾಳೊಕರಿ ಮನ ಮಾಲುಮ್ ಪಡ್ಯು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 22:12" /><verse number="13" style="v" sid="GEN 22:13" />ಅಬ್ರಹಾಮ್ ಡೋಳಪಾಡಿ ದೇಖಾನಿವಖ್ಹ್‌ತೆ ಇನ ಪೀಠೆ, ಎಕ್ ಮೇಂಢೊ ಡಾಗ್ಮ ಶಿಂಗ್ಡಾ ಖ್ಹಪ್‍ಡೈಪಡಿರ‍್ಹುತೆ ದೇಖ್ಯೊ. ಇನೆ ಜೈ಼ನ್ ಯೊ ಮೇಂಢಾನ ಧರಿಲೈನ್ ಛಿಯ್ಯಾನ ಬದಲ್ ಇನ ಭುಂಜಿನ್‌ ಢಪ್ಕಾರದಿದೊ. <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />ಯೊ ಝ಼ಗೋನ ಅಬ್ರಹಾಮ್‌ನೆ “ಯೆಹೋವ ದ್ಯವವಾಳೊ” ಕರಿ ನಾಮ್ ಮ್ಹೇಲ್ಯೊ. “ಯೆಹೋವ ಪರ್ಭತ್‌ಮ ದ್ಯಾವಳೊ” ಕರಿ ಹಮ್ಕೆಲಗೂಬಿ ಇಮ್ಮಸ್ ಬೋಲಾನಿ ಪದತ್ತಿಛಾ಼. <verse eid="GEN 22:14" /><verse number="15" style="v" sid="GEN 22:15" />ಯೆಹೋವನ ದೂತಾನೆ ಸೊರ್ಗಾ ಮಾಥೊ ಬೇನಿ ವಖ್ಹತ್ ಅಬ್ರಹಾಮ್‌ನ ಪುಕಾರಿನ್ ಇನ, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />“ತೂ ತಾರೊ ಎಕ್ಕಸ್ ಛಿಯ್ಯಾನ ಸಮರ್ಪಣ್‌ ಕರಾನ ಪೀಛೆ ಹಟ್ಯೊಕೊಂತೆ ಇನಖ್ಹಾಜೆ, ಯೆಹೋವ ಮೇ ತುನ ಆಣ್ ಕರೀನ್ ಬೋಲುಸ್‍ ಶಾತ್‍ಕತೊ ಮೇ ತುನ ಆಶೀರ್ವಾದ್‌ ಕರಿಶಸ್ ಕರೀಶ್; <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />ಮೇ ತುನ ಆಣ್‌ಕರುಸ್ ತಾರಿ ಪಿಳ್ಗಿನ ಘಣು ಆಶೀರ್ವಾದ್ ಕರಿಶ್, ಯೊ ಆಬ್‍ನು ಶುಕ್ಕರ್‌ನಿತ್ರಾಬಿ, ದರ‍್ಯಾವ್‍ನ ಕನ್‍ಖಾಡೆ ರ‍್ಹೇಯ್ತೆ ರೇತ್‌ನಿತರಾಬಿ ಗಣ್ತಿಕೊಂತೆ ತಿಮ್‍ ಭಡೈಶ್; ಇವ್ಣೆ ವಹೇರ‍್ಯಾವ್ನು ಖ್ಹಯೇರ್‌ನ ಕಬ್‍ಜ ಕರಿಲಿಶೆ. <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />ತೂ ಮಾರಿ ವಾತ್ನ ವಿದೇಯತೆ ಹುಯೋತೆ ಇನಖ್ಹಾಜೆ ಧರ್ತಿನು ಖ್ಹಾರಸ್ ಜ಼ಗ್‌ಜಾ಼ತ್‌ನ ತಾರಿ ಪಿಳ್ಗಿಥಿ ಆಶೀರ್ವಾದ್ ಉಶೆಕರಿ ಯೆಹೋವನೆ ವಾಗ್ದಾನ್ ಕರಿರಾಖ್ಯೋಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 22:18" /><verse number="19" style="v" sid="GEN 22:19" />ಇನಪಾರ್ ಅಬ್ರಹಾಮ್ ಪಾಛೊ಼ಫರಿ ಇನ ಸೇವಕ್‌ಕನ ಆಯೊ. ಇವ್ಣೆಖ್ಹಾರು ಇನ ಜೋ಼ಡ್ಮ ಬೇರ್ಷೆಬನ ಗಯಾ. ಅಬ್ರಹಾಮ್‌ನೆ ಬೇರ್ಷೆಬಮ ಜಿವ್ಣುಕರುಕರ್ತೊಥೊ.<verse eid="GEN 22:19" /></para>
  <para style="s">ನಾಹೋರನಿ ಪಿಳ್ಗಿವಾಳು.</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />ಥೋಡ ದನ್ನಪಾರ್ ಮಿಲ್ಕಮ ಇನೊ ನ್ಹಾನೊಭೈ ನಾಹೋರನ ಲಡ್ಕ ಹುಯ ಕರಿ ಅಬ್ರಹಾಮ್‌ನೆ ಸಮಾಚಾರ್ ಖ್ಹಮ್‍ಜ್ಯೊ. <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />ಇವ್ಣೆ ಕೋಣ್‍ಕತೊ; ಇನೊ ಪೈಲ್ಹೋಟೊ ಛಿಯ್ಯೊ ಊಜ಼್, ಇನೊ ನ್ಹಾನೊ ಭೈ ಬೂಜ್, ಅರಾಮ್‍ನೊ ಬಾ ಕೆಮೂವೇಲ. <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />ಕೆಸೆದ್, ಹಜೋ಼, ಪಿಲ್ದಾಷ್, ಇದ್ಲಾಫ್, ಬೆತೂವೇಲ್ ಕರಿ ಅವ್ಣೇಸ್. <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />ಬೆತೂವೇಲ್ ರೆಬೆಕ್ಕನೊ ಬಾ. ಆ ಆಟ್‍ ಜ಼ಣಾನ ಮಿಲ್ಕನೆ ಅಬ್ರಹಾಮ್‌ನೊ ನ್ಹಾನೊಭೈ ನಾಹೋರಥಿ ಪೈದಕರಿ. <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />ಆ ನಾಹುಯಿನ್ ಇನಿ ಬಿಜೇಕ್‌ ಬಾವಣ್‍ ರೂಮನೆ ಟೆಬಹ, ಗಹಮ್, ತಹಷ್, ಮಾಕಾ ಕರಿ ಅವ್ಣುನ ಜ಼ಣಿ.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">ಸಾರನಿ ಮರಣ್ ಅಜು಼ ಮಖ್ಹಾಣ್ಯು ದಿದೂತೆ.</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />ಸಾರ ಏಕ್‌ಖ್ಹೊ ಖ್ಹಾತ್ ಉಪ್ರಿಖ್ಹ್‌ ವರಖ್ಹ್ ಬಚೀರ‍್ಹಿ. <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />ಸಾರ ಕಾನಾನ್ ದೇಖ್ಹ್‌ಮಾನು ಹೆಬ್ರೋನ್‍ಕರಿ ಕಿರ್ಯತರ್ಬ ಗಾಮ್ಮ ಮರಿಗಿ. ಅಬ್ರಹಾಮ್‌ನೆ ಅಯಿನ್ ಇನಖ್ಹಾಜೆ ರದನ್‍ಕರಿನ್ ಆಂಝು಼ನಾಖ್ಯೊ. <verse eid="GEN 23:2" /><verse number="3" style="v" sid="GEN 23:3" />ಇನಪಾರ್ ಯೊ ಮುರ್ದಕಂಥೊ ಅಬ್ರಹಾಮ್ ಉಠಿನ್ ಹಿತ್ತಿಯವಾಳಕನ ಜೈ಼ನ್ ಇವ್ಣುನ, <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />“ಮೇ ತುಮಾರಮ ಪರ್‌ದೇಖ್ಹ್‌ವಾಳೊಬಿ, ವಶೇರೊನಾಖವಾಳೊಬಿ ಹುಯಿರೋಸ್. ಹಮ್ಕೆ ಮರಿಗೈತೆ ಮಾರಿ ಬಾವಣ್ಣ ಮಖ್ಹಾಣ್ಯನಖ್ಹಾಜೆ ಥೋಡಿ ಝ಼ಗೊ ಮನ ಮೋಲ್ನ ದೆವೊ” ಕರಿ ಬೋಲಿಲಿದೊ. <verse eid="GEN 23:4" /><verse number="5" style="v" sid="GEN 23:5" />ಹಿತ್ತಿಯವಾಳನೆ ಅಬ್ರಹಾಮ್‍ನ, <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />“ಗುರುಜಿ, ಹಮಾರಿ ವಾತ್ ಖ್ಹಮಜ಼್, ತೂ ಹಮುನ ಏಕ್‌ ಮೋಟೊ ರಾಜನಿತರ ಛಾ, ಮರಿಗೈತೆ ತಾರಿ ಬಾವಣ್ಣ ಶರೀರ್‌ನ ಹಮಾರಮ ಛಾ಼ತೆ ಮಖ್ಹಾಣ್ಯನಿ ಝ಼ಗೋಮ ಮಖ್ಹಾಣ್ಯು ಕರೆಜಾ಼ಯ್. ತಾರಿ ಬಾವಣ್ಣ ಮಖ್ಹಾಣ್ಯನ ದ್ಯವಾನಖ್ಹಾಜೆ ಹಮಾರಮ ಕೋಣ್ಬಿ ಮಖ್ಹಾಣ್ಯನು ಝ಼ಗೊ ದ್ಯವಾನ ಹಮೆ ಖುಶಿಕರೆಸ್” ಕರಿ ಜ಼ವಾಬ್ ದಿದು. <verse eid="GEN 23:6" /><verse number="7" style="v" sid="GEN 23:7" />ತದೆ ಅಬ್ರಹಾಮ್ ಉಠಿನ್, ಹಿತ್ತಿಯವಾಳನು ಮುಲಕ್‌ವಾಳನ ಮುಡ್‌ಕ್ಯು ಝು಼ಕೈನ್ ಖ್ಹಲಾಮ್‍ಕರ‍್ಯೊ. <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />ಇನೆ ಪಾಛೊ಼ ಇವ್ಣಿ ಜೋ಼ಡ್ಮ ವಾತೆ ಬೋಲಿನ್, “ಮೇ ತುಮಾರಮ ಮಾರಿ ಬಾವಣ್ಣ ಮುರ್ದಾನ ಮಖ್ಹಾಣ್ಯುಕರಾನ ತುಮೆ ಮಾನಾನು ಉಷೇತೊ ಮನ ತುಮಾರಮ ಎಕ್ ಬಿಂತಿ ಛಾ಼. ತುಮೆ ಚೋಹರನೊ ಛಿಯ್ಯೊ ಎಫ್ರೋನ್ನಿ ಜೋ಼ಡ್ಮ ಮಾರಖ್ಹಾಜೆ ವಾತ್ ಬೋಲಿನ್, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />ಇನ ಖೇತರ್‌ನ ಶೇಡಾಮ ಛಾ಼ತೆ ಮಕ್ಪೇಲ ಘವಿನ ಮನ ದೆವಾಡೊಕರಿ ಬೋಲಿಲೇವುಸ್. ಯೊ ಇನಿ ಝ಼ಗೋನು ಪೂರ ಮೋಲ್ಲಿನ್‌ ಮನ ದ್ಯವಾದೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 23:9" /><verse number="10" style="v" sid="GEN 23:10" />ಎಫ್ರೋನ್ ಹಿಜ಼್ಜ ಹಿತ್ತಿಯವಾಳನ ಇಚ಼್‌ಮ ಬೇಠೋಥೊ. ಅಮ್‍ರ್ಹಾವಪರ್ ಹಿತ್ತಿಯವಾಳೊ ಎಫ್ರೋನ್ ಹಿತ್ತಿಯವಾಳು ಹುಯಿರ‍್ಹುತೆ ಯೊ ಗಾಮ್‌ವಾಳಾನ ಖ್ಹಾಮ್ಣೆ ಅಬ್ರಹಾಮ್‍ನ, <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />ಇಮ್‌ ಕಾಹೆ ಮಾಲಿಕ್, ಮಾರಿ ವಾತ್ ಖ್ಹಮಜ಼್. ಯೊ ಜ಼ಮಿನ್ನಾಬಿ ಇನಾಮ ಛಾ಼ತೆ ಘವಿನಾಬಿ ತುನ ದೆವುಸ್‌; ಮರಿಗೈತೆ ತಾರಿ ಬಾವಣ್ಣ ಇನಾಮ ಮಖ್ಹಾಣ್ಯು ಕರೆಜಾ಼ಯ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 23:11" /><verse number="12" style="v" sid="GEN 23:12" />ಅಬ್ರಹಾಮ್‌ನೆ ಯೊ ದೇಖ್ಹ್‌ನ ಅದ್ಮಿನ ಮುಡ್‌ಕ್ಯು ಝು಼ಕೈನ್ ಖ್ಹಲಾಮ್‍ ಕರೀನ್ ಇವ್ಣ ಖ್ಹಾರನ ಖ್ಹಾಮ್ಣೆ, <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />ಅಜು಼ ಎಫ್ರೋನನ, “ದಿಲ್‍ ಉಶೇತೊ ದಯಾಕರೀನ್ ಮೇ ಬೋಲುಕರುತೆ ಖ್ಹಮಜ಼್ ; ಯೊ ಖೆತರ್‌ನು ಮೋಲ್‍ದೆವುಸ್. ಮಾರೇಥಿ ಇನು ದಾಮ್‌ ಲೀಲ್ದೊತೊ ಇನಾಮ ಮಾರಿ ಬಾವಣ್ಣು ಮಖ್ಹಾಣ್ಯು ಕರುಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 23:13" /><verse number="14" style="v" sid="GEN 23:14" />ತದೆ ಎಫ್ರೋನನೆ ಅಬ್ರಹಾಮ್‍ನ, <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />“ಮಾಲಿಕ್, ಮಾರಿ ವಾತ್ ಖ್ಹಮಜ಼್; ಚಾರ್‌ಖ್ಹೊ ರೂಪಾನ ಪಾವ್ಲನಿ ಮೋಲ್ನಿ ಜ಼ಮೀನ್ನಿ ಬಾರೇಮ ತಾರ ಮಾರಮ ವಾತೆ ಶನಾ? ಮಖ್ಹಾಣ್ಯು ಕರೆಜಾ಼ಯ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 23:15" /><verse number="16" style="v" sid="GEN 23:16" />ಅಬ್ರಹಾಮ್‌ನೆ ಎಫ್ರೋನ್ನಿ ವಾತ್ನ ಮಾನಿಲಿದೊ. ಎಫ್ರೋನನೆ ಹಿತ್ತಿಯವಾಳನ ಖ್ಹಾಮ್ಣೆ ಬೋಲ್ಯೊತೆ ಚಾರ್‌ಖ್ಹೊ ರೂಪಾನ ಪಾವ್ಲವ್ನ ಅಬ್ರಹಾಮ್‌ನೆ ಬೇಪಾರಿಕನ ತದ್ನಿ ತೋಲ್‌ನಿ ಪರಕ್ಮ ತೂಕಿನ್ ದಿದೊ. <verse eid="GEN 23:16" /><verse number="17" style="v" sid="GEN 23:17" />ಅಮ್ ಮಮ್ರೆ ಗಾಮ್ನ ಮ್ಹೋರೆನು ಮಕ್ಪೇಲಗಾಮ್ನ ಮಳ್ಯುಹುಯು ಎಫ್ರೋನನಿ ಜ಼ಮೀನ್‍ಬಿ, ಇನ ಮಳ್ಯುಹುಯು ಘವಿಬಿ, ಇನಾಮ ಅಜು಼ ಇನ ಅಶ್‌ಪೀಶ್‍ನು ಶೇಡಾಮ ಥೂತೆ ಝಾ಼ಡಾವ್‌ನ ಖ್ಹಮೇದ್, <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />ಯೊ ಅಖ್ಖು ಅಬ್ರಹಾಮ್‌ನು ಶೊಂತ್‌ ಜ಼ಮೀನ್‍ಕರಿ ಯೊ ಗಾಮ್‌ನು ಹಿತ್ತಿಯವಾಳನ ಖ್ಹಾಮ್ಣೆ ತೀರ್ಮಾನ್‌ಹುಯು. <verse eid="GEN 23:18" /><verse number="19" style="v" sid="GEN 23:19" />ಆ ಹುವಾದಿನ್ ಅಬ್ರಹಾಮ್‌ನೆ ಇನಿ ಬಾವಣ್ ಸಾರನು ಮುರ್ದಾನ ಕಾನಾನ್ ದೇಖ್ಹ್‌ನು ಹೆಬ್ರೋನ್‍ಕರಿ ಮಮ್ರೆ ತಬರ್‌ಖಾನ ಮ್ಹೋರೆನು ಮಕ್ಪೇಲ ತಬರ್‌ಖಾನಿ ಜ಼ಮೀನ್‍ಮ ಛಾ಼ತೆ ಘವಿಮ ಗಾಡ್ಯೊ. <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />ಅಮ್ ಹಿತ್ತಿಯವಾಳನೆ ಯೊ ಜ಼ಮಿನ್ನಾಬಿ ಇನಾಮನು ಘವಿನಾಬಿ ಅಬ್ರಹಾಮನ ಶೊಂತ್‌ ಮಖ್ಹಾಣ್ಯನಿ ಜ಼ಮೀನ್‍ಕರಿ ದಿನಾಖಿದಿದು.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">ಇಸಾಕ್‍ ಅಜು಼ ರೆಬೆಕ್ಕ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />ಅಬ್ರಹಾಮ್ ದನ್ ಭರಾಯೊಹುಯೊ ಭುಡೊ ಹುಯಿಗೊಥೊ. ಯೆಹೋವ ದೇವ್ನೆ ಇನ ಹರೇಕ್ ಬಾರೇಮ ಆಶೀರ್ವಾದ್‌ ಕರಿರಾಖ್ಯಥೊ. <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />ಅಮ್‌ರ‍್ಹಾವಪರ್ ಇನೆ ಇನಥೂತೆ ಶೊತ್ನಿ ಜಿಮ್ಮೇದಾರಿ ದೇಖವಾಳೊ ಗಲ್‌ಢೊ ಸೇವಕ್‌ನ ಅಬ್ರಹಾಮ್‌ನೆ, “ತೂ ಮಾರಿ ಮಾಂಡಿಹೇಟ್ ಹಾತ್ ಮ್ಹೇಲ್‌, <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />ಸೊರ್ಗಾನೊಬಿ ಧರ್ತಿನೊ ಬಾ ಯೆಹೋವ ದೇವ್‌ಪರ್‌ ಆಣ್‌ ಕರುಸ್ ಮೇ ಜಿವ್ಣು ಕರುಕರುತೆ ಆ ಕಾನಾನ್‌ವಾಳನಿ ಛೋ಼ರಿಯೆಮಾಥು ಮಾರ ಛಿಯ್ಯಾನ ಛೋ಼ಕ್ರಿ ಕೋ ಲ್ಯಾವ್‌ನಿ. <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />ಕತೋಬಿ ಮಾರೊ ಶೊಂತ್ ದೇಖ್ಹ್‌ನು ಮಾರು ಮಾಯಮಾತ್ರಮಾಥು ಇಸಾಕ್‌ನ ವ್ಯಾಹ ಕರಾನ ಛೋ಼ಕ್ರಿ ಲ್ಯಾವ್ಣು” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 24:4" /><verse number="5" style="v" sid="GEN 24:5" />ಕತೋಬಿ ಸೇವಕ್‌ನೆ, “ಏಕ್‌ವೇಳ್ ಮಾರಿ ಜೋ಼ಡ್ಮ ಆ ದೇಖ್ಹ್‌ನ ಆವಾನ ಯೊ ತಯೇಡಾನ ದಿಲ್‌ ನಾಲಾಗ್ಯೊತೊ ತೂ ಮ್ಹೇಲಿನ್ ಆಯೋತೆ ಯೊ ದೇಖ್ಹ್‌ನ ಮೇ ತಾರ ಛಿಯ್ಯಾನ ಪಾಛೋ಼ ಬುಲೈಲೀನ್ ಜಾ಼ವ್ಣುಕಿ?” ಕರಿ ಪೂಛಾ಼ಯೊ. <verse eid="GEN 24:5" /><verse number="6" style="v" sid="GEN 24:6" />ತದೆ ಅಬ್ರಹಾಮ್‌ನೆ ಇನ, “ಹಿಜ್ಜಾ಼ ಮಾರ ಛಿಯ್ಯಾನ ಕದೇಬಿ ನಾಸ್ ಬುಲೈಲೀಜಾ಼ವ್ಣು. <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />ಶನಕತೊ ಪರಲೋಕ್ನೊ ದೇವ್ ಯೆಹೋವನೆ ಮಾರ ಬಾನ ಘರ್‌ಥುಬಿ ಮೇ ಪೈದಹುಯೋತೆ ಶೊಂತ್ ದೇಖ್ಹ್‌ಥೂಬಿ ಮನ ಬುಲೈಲೈನ್, ‘ತಾರಿ ಪಿಳ್ಗಿನ ಆ ದೇಖ್ಹ್‌ ದೇವುಸ್’ ಕರಿ ಜಿಭಾನ್ ದಿರಾಖ್ಯೊಸ್. ತಾರ ಖ್ಹಾಮ್ಣೆ ಇನ ದೂತನ ಮೋಕಲ್‌ಶೆ, ತೂ ಹಿಜ್ಜಾ಼ಥೊ ಮಾರ ಛಿಯ್ಯನಖ್ಹಾಜೆ ಛೋ಼ಕ್ರಿನ ಲೀನ್ ಆವ್ಣು. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />ತಾರ ಪೀಠೆ ಆವಾನ ಯೊ ತಯೇಡನ ದಿಲ್‌ ನಾಲಾಗ್ಯೊತೊ ಮೇ ಕರಾಯೋತೆ ಆಣ್‌ಥಿ ತು ಛುಟ್ಕಾರ್‌ ಹುಯಿರ‍್ಹೀಶ್. ಕತೋಬಿ ಮಾರ ಛಿಯ್ಯಾನ ಪಾಛೊ಼ ಹಿಜ಼್ಜ ನಾ ಬುಲೈಲೀಜಾ಼ವ್ಣು” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 24:8" /><verse number="9" style="v" sid="GEN 24:9" />ತದೆ ಯೊ ಸೇವಕ್‌ನೆ ಇನೊ ಯಜಮಾನ್ ಅಬ್ರಹಾಮ್‌ನಿ ಮಾಂಡಿಹೇಟ್ ಹಾತ್‌ ಮ್ಹೇಲಿನ್ ಇನೆ ಬೋಲ್ಯೊತೆ ಇಮ್ಮಸ್ ಆಣ್‌ಕರ‍್ಯೊ. <verse eid="GEN 24:9" /><verse number="10" style="v" sid="GEN 24:10" />ಇನಪಾರ್‌ ಯೊ ಸೇವಕ್‌ನೆ ಇನ ಯಜಮಾನ್ನು ಊಟ್‌ಮಾಥು ಅಖ್ಖಾಮಾಥು ದಖ್ಹ್‌ ಊಟೇವ್ನ ತಯಾರ್ ಕರಿನ್ ಇನಪರ್‌ ಘಣಮೋಲ್ನು ಖ್ಹೊನ್ನುಖ್ಹರಪ್‌ನ ಲೀನ್‌ ಹಿಜ಼್ಜಾಥು ನಿಕ್ಳಿನ್‌ ಉತ್ತರ್ ದಿಕ್‌ನು ಮೆಸಪಟೋಮಿಯಮ ನಾಹೋರ್ ಜಿವ್ಣು ಕರುಕರ್ತೊಥೋತೆ ಗಾಮ್ ಪೋಚ್ಯೊ. <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />ತದೆ ಇನೆ ನಂಗರ್‌ ಭಾರ್‌ ಬಾವ್ಡಿಕನ ಊಟ್‌ನ ಅಖ್ಖ ಊಟ್‌ನ ಘುಡ್‌ಗ್ಯ ಮೇಟೆ ಕರಾಯೊ, ಹಿಜ಼್ಜ ಖ್ಹಾಂಜ಼್‌ನು ತಯೇಡಾಖ್ಹಾರಿ ಪಾಣಿಭರಾನ ಆವಾನಿ ವಖ್ಹ್‌ತೆ. <verse eid="GEN 24:11" /><verse number="12" style="v" sid="GEN 24:12" />ಇನೆ ಪ್ರಾರ್ಥನೆ ಕರ್ತೊಹುಯಿನ್, “ಯೆಹೋವ ದೇವ್‌, ಮಾರೊ ಯಜಮಾನ್‌ ಅಬ್ರಹಾಮ್‌ನೊ ದೇವ್‌, ಆ ವಖ್ಹತ್ ಮೇ ಆಯೋತೆ ಕಾಮ್ನ ತೂ ಚ಼ಲೈದೀನ್ ಮಾರೊ ಯಜಮಾನ್ನಿ ಭರೋಖ್ಹಾನ ದಯಕರ್‌. <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />ಹಂದೇಕ್‌, ಪಾಣಿನ ಚೇಜ಼್‌ಭಾರಕನ ಭಿಯೋಸ್: ಆ ನಂಗರ್‌ನಿ ಛೊ಼ಕ್ರಿಯೇ ಪಾಣಿನ ಆವ್‌ಶೆ. <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />ಮೇ ಖಿವಿ ಛೋ಼ಕ್ರಿನ, ‘ತೂ ದಯಾಕರಿನ್ ತಾರ ಘಡಾನ ಉತಾರಿನ್ ಮನ ಪಿಯ್ಯಾನ ಪಾಣಿದೇ’ ಕರಿ ಬೋಲಾನಿ ವಖ್ಹ್‌ತೆ, ‘ತೂ ಪಿಯೆಜಾ಼ಯ್‌ ಅಜು಼ ತಾರಿ ಊಟೆಯೇವ್ನಬಿ ಪಾಣಿ ದೇವುಸ್’ ಕರಿ ಬೋಲ್ಯುತೊ, ಯೋಸ್ ತಾರೊ ಸೇವಕ್ ಇಸಾಕ್‌ನ ತೂ ಚೂ಼ಣಿರಾಖ್ಯೋತೆ ಛೋ಼ಕ್ರಿ ಹುವಾದೆ. ಅಮ್‌ ಚಾ಼ಲ್ಯುತೊ ಮಾರ ಯಜಮಾನ್ನ ಕರ‍್ಯೊತೆ ಆಣ್‌ ಕರಿ ಮನ ಮಾಲುಮ್‌ ಪಡ್‌ಶೆ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />ಇನೆ ಅಮ್‌ ಬೋಲಿಲೆವ್‌ಕರಾನಿ ವಖ್ಹ್‌ತೇಸ್ ಅಬ್ರಹಾಮ್‌ನೊ ಭೈ ನಾಹೋರ ಅಜು಼ ಮಿಲ್ಕನೊ ಛಿಯ್ಯೊ ಬೆತೂವೇಲನಿ ಛೋ಼ರಿ ರೆಬೆಕ್ಕ ಖಾಂದಪರ್‌ ಘಡೊ ಮ್ಹೇಲಿಲೀನ್‌ ನಂಗರ್‌ ಭಾರ್‌ ಆವನು ದೇಖ್ಯೊ. <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />ಯೊ ಛೋ಼ಕ್ರಿ ಘಣಿ ಶನ್‌ಗಾರ್ನಿ ಜ಼ವಾನಿ ಕವಾರಿ ಹುಯಿರ‍್ಹಿಥಿ ಅಜು಼ ಖೆವ ಪರ್ಖ್ಹಾನು ಮ್ಹೋಡು ಕೊ ದೇಖಿರಾಖಿಥಿನಿ. <verse eid="GEN 24:16" /><verse number="17" style="v" sid="GEN 24:17" />ಇನೆ ಬಾವ್ಡಿಕನ ಜೈ಼ನ್ ಘಡಾಮ ಪಾಣಿಭರಿನ್ ಉಪ್ಪರ್‌ ಆವಾನಿ ವಖ್ಹ್‌ತೆ ಯೊ ಸೇವಕ್ ಖ್ಹಾಮೆ ಮಿಲೈಆಯಿನ್, “ಬಾಯಿ, ದಯಾಕರಿನ್ ತಾರ ಘಡಮಾಥು ಪಿಯ್ಯಾನ ಮನ ಥೋಡು ಪಾಣಿದೆ” ಕರಿ ಬೊಲ್ಯೊ, <verse eid="GEN 24:17" /><verse number="18" style="v" sid="GEN 24:18" />ಇನೆ ತದ್ನುತದೇಸ್ ಘಡೋ ಉತಾರಿನ್ ”ಪೀಲ ಗುರು" ಕರಿ ಇನ ಪಿಯ್ಯಾನ ಪಾಣಿ ದಿದಿ. <verse eid="GEN 24:18" /><verse number="19" style="v" sid="GEN 24:19" />ಯೊ ಪೀನ್‌ ಹುಯಿಜಾ಼ವದೀನ್, “ಮೇ ತಾರಿ ಊಟೆವ್‍ನಾಬಿ ಬಶ್‌ಹುವಾಯೆತ್ರು ಪಾಣಿಲೈನ್ ದೆವುಸ್” ಕರಿ ಬೋಲಿನ್, <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />ಘಡಾಮಥೂತೆ ಪಾಣಿನ ಬಾನೆಮ ನಾಖಿನ್ ಪಾಛಿ ಲ್ಯಾವಾನ ಬಾವ್ಡಿಕನ ಜಲ್ದಿಗೈ. ಅಮ್‌ ಇನಿ ಖ್ಹಾರೀಸ್‍ ಊಟೇವ್‌ ಪಾಣಿ ಪಿಯಲಗುಬಿ ಲಯಿನ್ ನಾಖಿ. <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />ಎತ್ರಾಮ ಯೊ ಆದ್ಮಿ ಶಾತ್ ಬೋಲ್ಯೊಕೊಂತೆ ಇನಾಸ್ ಠರ್ಕಿ ದೇಕ್ತೊಹುಯಿನ್, ಯೆಹೋವನೆ ಇನಿ ಚಾ಼ಲ್‍ಕುಚ಼್‍ನ ಜೀತ್‍ದಿದೋಕಿ, ಕೊಯ್ನಿ ಕರಿ ಮಾಲುಮ್‌ ಕರಾನ ಟಿವೈರ‍್ಹೋಥೊ. <verse eid="GEN 24:21" /><verse number="22" style="v" sid="GEN 24:22" />ಊಟೆಖ್ಹಾರು ಪಿಯ್ಯಾನ ಬಾದ್ಮ ರೆಬೆಕ್ಕನ ಇನೆ ಆಧೊ ತೋಲಾನಿ ಎಕ್ ಖ್ಹೊನ್ನಾನಿ ಟಿಕ್ಲಿನ, ಇನ ಹಾತ್‌ಮ ದಖ್ಹ್‌ ತೋಲಾನಿ ಬೇ ಖ್ಹೊನ್ನಾನಿ ಛು಼ಡಿಯೆ ಘಾಲ್ಯೊ. <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />ಅಜು಼ “ತಾರೊ ಬಾ ಕೋಣ್? ದಯಾಕರೀನ್ ಮನ ಬೋಲ್; ತಾರ ಬಾನ ಘರ್ಮ ಹಮೆ ಆ ರಾತೆ ರ‍್ಹವಾನ ಝ಼ಗೊ ಛಾ಼ಕಿಶು?” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 24:23" /><verse number="24" style="v" sid="GEN 24:24" />ಹೈರಿತೆನೆ ಇನ, “ಮೇ ನಾಹೋರನ ಮಿಲ್ಕಮ ಪೈದಹುಯೋತೆ ಬೆತೂವೇಲ ಮಾರೊ ಬಾ ಕರಿ ಜ಼ವಾಬ್‍ದಿದಿ. <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />ಆ ನಾಹುಯಿನ್ ರೆಬೆಕ್ಕನೆ ಇನ, “ಘಾಖ್ಹ್‌ಬಿ ಚಾ಼ರೊಬಿ ಹಮಾರಕನ ಹೋಣುತೆತ್ರು ಛಾ಼ ಅಜು಼ ತೂ ರ‍್ಹವಾನಬಿ ಝ಼ಗೊಛಾ಼” ಕರಿ ಬೋಲಿ. <verse eid="GEN 24:25" /><verse number="26" style="v" sid="GEN 24:26" />ಅನ ಖ್ಹಮ್‍ಜ್ಯೊತೆ ಯೊ ಅದ್ಮಿನೆ ಯೆಹೋವದೇವ್ನ ಆಡ್‌ಪಡಿನ್ ಖ್ಹಲಾಮ್ ಕರ‍್ಯೊ. <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />“ಮಾರೊ ಯಜಮಾನ ಅಬ್ರಹಾಮ್‌ನೊ ದೇವ್‌ ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವನ ಧನ್ಯವಾದ್‌ ಹುವಾದೆ. ಇನೆ ಮಾರ ಯಜಮಾನ್ನ ಉಪ್ಪರ್‌ಲಿ ಪ್ಯಾರ್‌ನಾಬಿ ಖ್ಹಾಚಿನ ಕಾಡಿನಾಖ್ಯೊಕೊಯ್ನಿ; ಮನ ಮಾರ ಯಜಮಾನ್ನ ಮಾಯಮಾತ್ರನ ಘರೆ ಖ್ಹೂದುಸ್ ಬುಲೈಲೀನ್ ಐರ‍್ಹೋಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 24:27" /><verse number="28" style="v" sid="GEN 24:28" />ತದೆ ಯೊ ಛೋ಼ಕ್ರಿ ನಾಶಿಜೈ಼ನ್ ಚಾ಼ಲಿತೆ ವಾತೆನ ಆಯಾನ ಘರ್‌ವಾಳಾನ ಖ್ಹಮ್‍ಜಾ಼ಡಿ. <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />ರೆಬೆಕ್ಕನ ಲಾಬಾನ ಕರಿ ಭೈಥೊ. ಯೊ ಅಬ್ರಹಾಮನ ಸೇವಕಥೋತೆ ಬಾವ್ಡಿಕನ ನಾಶಿಗಯೊ. <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />ಇನೆ ಇನಿ ಭೇನ್‍ಕನ ಥೂತೆ ಟಿಕ್ಲಿನಬಿ, ಚು಼ಢಿಯೇನಬಿ ದೇಖ್ಯೊ. ಯೊ ಅದ್ಮಿನೆ ಮಾರಿ ಜೋ಼ಡೆ ಕಿಮ್‍ ವಾತ್‌ಬೋಲ್ಯೊ ಕರಿ ರೆಬೆಕ್ಕಥಿಸ್ ಖ್ಹಮ್‍ಜಿನ್, ಬಾವ್ಡಿನ ಖನ್ನೆ ಊಟೆವ್‍ಕನ ಭೀಯೊಥೋತೆ ಯೊ ಅದ್ಮಿಕನ ಆಯೊ. <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />ಇನ, “ಅಲಾ, ಯೆಹೋವನಿ ಆಶೀರ್ವಾದ್‌ ಲೀರಾಖವಾಳ, ಮಹಿಆವ್; ಶನ ಭಾರ್ ಭಿಯೋಸ್? ತಾರಖ್ಹಾಜೆ ಮಾರ ಘರ್ಮ ಊಟೆವ್ನ ಹೋಣುತೆ ಝ಼ಗೋನಾಬಿ ತಯಾರ್ ಕರಿರಾಖ್ಯೋಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 24:31" /><verse number="32" style="v" sid="GEN 24:32" />ಯೊ ಅದ್ಮಿ ಘರ್‌ಭಣಿ ಆವಾದಿನ್ ಲಾಬಾನನೆ ಊಟೆವ್‍ಪರ‍್ನು ಭೋಜಾ಼ನ ಉತಾರಿನ್ ಯೊ ಅಖ್ಖಾನ ಘಾಖ್ಹ್‌ಬಿ ಚಾ಼ರೊಬಿ ನಖೈನ್ ಯೊ ಅದ್ಮಿ ಅಜು಼ ಇನ ಜೋ಼ಡ್ಮರ‍್ಹವಾಳನ ಗೋಡ ಧೊವಾನ ಪಾಣಿದಿದೊ. <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />ಇನವಾರ್ ಖಾಣುನಾಖಿದಿದು. ಕತೋಬಿ ಇನೆ, “ಮೇ ಆಯೋತೆ ಕಾಮ್ನ ಬೋಲ್ಯೊಕೊಂತೆ ಖಾಣು ಖವ್‌ಕೊಯ್ನಿ” ಕರಿ ಬೋಲಖ್ಹತರ್ ಲಾಬಾನನೆ, “ಯೊ ಶಾತ್‌ಬೋಲ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 24:33" /><verse number="34" style="v" sid="GEN 24:34" />ತದೆ ಇನೆ, “ಮೇ ಅಬ್ರಹಾಮ್‌ನೊ ಸೇವಕ್‌. <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />ಯೆಹೋವನೆ ಮಾರ ಯಜಮಾನ್ನ ಘಣು ಆಶೀರ್ವಾದ್‌ ಕರ‍್ಯೋತೆ ಇನಖ್ಹಾಜೆ ಢಾಂಡ ಬೋಕ್ಡಬಿ, ಖ್ಹೋನ್ನು ರೂಪುಬಿ, ದಾಸದಾಸಿನಬಿ, ಊಟೆವ್‍ನಾಬಿ, ಗಧೇಡವ್‍ಬಿ ದೀರಾಖ್ಯೋತೆ ಇನಖ್ಹಾಜೆ ಯೊ ದೌಲತ್ತಿಬಣ್ಯೊ. <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />ಮಾರೊ ಯಜಮಾನ್ನಿ ಬಾವಣ್ ಸಾರನೆ ಇನ ಬುಢ್‍ಪಣ್‌ಪರ್ ಛಿಯ್ಯೊ ಜ಼ಣಿ; ಯೊ ಛಿಯ್ಯಾನ ಮಾರೊ ಯಜಮಾನ್ನೆ ಇನಕನ ಥೂತೆ ಖ್ಹಾರುಸ್ ದೀರಾಖ್ಯೋಸ್. <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />ಆ ನಾಹುಯಿನ್ ಮಾರೊ ಯಜಮಾನ್ ಮಾರೇಥಿ ಆಣ್‌ಕರಿನ್ ಮೋಕ್ಲಿರಾಖ್ಯೊಸ್, ಮೇ ಛೂ಼ತೆ ಕಾನಾನ್ ದೇಖ್ಹ್‌ವಾಳಥಿ,ಮಾರ ಛಿಯ್ಯಾನ ಛೋ಼ಕ್ರಿ ನಾಲ್ಯಾವ್ಣು. <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />ಮಾರ ಬಾನ ಘರ್‌ಕನಾಬಿ ಮಾರ ಮಾಯಮಾತ್ರ ಕನಾಬಿ ಜೈ಼ನ್ ಇವ್ಣಕನಾಸ್ ಛೋ಼ಕ್ರಿನ ಚೂ಼ಣಿನ್‌ ಲ್ಯಾವ್ಣುಕರಿ ಬೋಲಿನ್ ಮಾರೇಥಿ ಕೋಲ್ ಲ್ಯವಾಡಿರಾಖ್ಯೊಸ್. <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />ಮೇ ಮಾರ ಯಜಮಾನ್ನ, ‘ಎಕ್ ವೇಳ್ ಮಾರ ಪೀಠೆ ಆವಾನ ಯೊ ಛೋ಼ಕ್ರಿನ ದಿಲ್‍ ನಾರ‍್ಹಯುತೊ” ಕರಿ ಬೋಲಖ್ಹತರ್, <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />ಮಾರ ಯಜಮಾನ್ನೆ ಮನ, “ಮೇ ಆರಾದನೆ ಕರ್ತೊ ಆಯೋತೆ ಮಾರೊ ದೇವ್ ಹುಯಿರೋತೆ ಯೆಹೋವನೆ ಇನ ದೂತನ ಮೋಕ್ಲಿನ್ ತೂ ಮಾರ ಬಾನ ಖಾನ್‍ಖೋಜ಼್‌ ಮಳ್ಯಹುಯ ಮಾಯಮಾತ್ರಾಮ ಮಾರ ಛಿಯ್ಯಾನ ಛೋ಼ಕ್ರಿ ಲ್ಯಾವನಿಘೋಣಿ ಮದತ್ ಕರ್ಷೆ. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />ತದೆ ಮೇ ಕರಾಯೋತೆ ಆಣ್‍ಪರ್‌ ತೂ ಗಯೋತೊ ಮಾರ ಮಾಯಮಾತ್ರಾಮ ಇವ್ಣೆ ಛೋ಼ಕ್ರಿ ನಾದಿದುತೊ ಮೇ ಕರಾಯೋತೆ ಆಣ್‍ಥಿ ತೂ ಛುಟ್ಕಾರ್‌ ಹುಯಿರಿಶ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 24:41" /><verse number="42" style="v" sid="GEN 24:42" />ಮೇ ಆ ವಖ್ಹತ್ ಆ ಖ್ಹಯೇರ್‌ಕನ ಬಾವ್ಡಿಕನ ಆವಾದಿನ್, “ಮಾರೊ ಯಜಮಾನ್‌ ಅಬ್ರಹಾಮ್‌ನೊ ದೇವ್‍ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವ, ಮೇತೊ ಪಾಣಿನ ಬಾವ್ಡಿಕನ ಭಿಯೋಸ್. ತೂ ಮಾರಿ ಚಾ಼ಲ್‍ಕುಚ಼್‍ನ ಜೀತ್ ದೀರಾಖ್ಯೊಸ್ ಉಶೇತೊ <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />ಪಾಣಿನ ಆವಾಳಿ ಖೆವಿ ಛೋ಼ಕ್ರಿನ, ‘ದಯಾಕರಿನ್, ತಾರ ಘಡಮಾಥು ಮನ ಥೋಡು ಪಾಣಿ ಪಿಯ್ಯಾನ ದೇ’ ಕರಿ ಮೇ ಬೋಲ್ಯೊತೊ, <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />ಇನೆ ಪೀ ಅಜು಼ ತಾರಿ ಊಟೆವ್‍ನಾಬಿ ಪಾಣಿಲೈನ್ ದೆವುಸ್ ಕರಿ ಬೋಲವಾಳಿ ಯೋಸ್ ಯೆಹೋವಥಿ ಮಾರ ಯಜಮಾನ್ನ ಛಿಯ್ಯಾನ ಚೂ಼ಣೈಹುಯಿ ಛೋ಼ಕ್ರಿ ಹುಯಿರಾವದೆ’ ಕರಿ, <verse eid="GEN 24:44" /><verse number="45" style="v" sid="GEN 24:45" />ಮೇ ಮಾರ ದಿಲ್ಮ ಬೋಲಿಲ್ಯಾವನಿ ವಖ್ಹ್‌ತೇಸ್, ರೆಬೆಕ್ಕ ಖಾಂದಪರ್ನ ಘಡಾನ ಪಾಡಿಲೀನ್ ಆವಾನು ಮೇ ದೇಖ್ಯೊ. ಇನೆ ಬಾವ್ಡಿಕನ ಉತ್ರಿನ್ ಪಾಣಿ ಭರ್ಲಿನ್ ಆವಾನಿ ವಖ್ಹ್‌ತೆ ಮೇ ಇನ, ‘ಮನ ಪಿಯ್ಯಾನ ಪಾಣಿ ದೇ’ ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />ತದ್ನುತದೇಸ್ ಇನೆ ಘಡಾನ ಉತಾರೀನ್, ‘ಪೀಯೊ, ತುಮಾರಿ ಊಟೆವ್‍ನಾಬಿ ಪಾಣಿ ಲೈನ್‌ ದೆವುಸ್’ ಕರಿ ಬೋಲಿ. ಮನಾಬಿ ಮಾರಿ ಊಟೆವ್‍ನಾಬಿ ಪಾಣಿಲೈನ್ ದಿದಿ. <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />ತೂ ಕಿನಿ ಛೋ಼ರಿ ಕರಿ ಮೇ ಬೋಲ್ತಾನ ಇನೆ, ‘ನಾಹೋರನ ಮಿಲ್ಕಮ ಪೈದಹುಯೊತೆ ಬೆತೂವೇಲನಿ ಛೋ಼ರಿ ಮೆ’ ಕರಿ ಬೋಲಿ. <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />ಯೊ ಖ್ಹಮ್‌ಜಿನ್ ಮೇ ಇನ ನಾಕ್ನ ಟಿಕ್ಲೀಬಿ ಹಾತ್ನ ಚು಼ಢಿಯ ಘಾಲೀನ್ ಮಾರೊ ಯಜಮಾನ್ ಅಬ್ರಹಾಮ್‌ನೊ ದೇವ್‍ ಹುಯಿರೋತೆ ಯೆಹೋವನ ಮುಡ್‌ಕ್ಯು ಝು಼ಕೈನ್ ಧನ್ಯವಾದ್‌ ಕರ‍್ಯೊ, ಇನೆ ಮಾರ ಯಜಮಾನ್ನ ಛಿಯ್ಯನಖ್ಹಾಜೆ ಇನ ನ್ಹಾನ ಭೈನಿ ಛೋ಼ರಿನಾಸ್ ಲೇವ್ಣುಕರಿ ಮನ ಖ್ಹಾಚಿ ವಾಟ್‍ಮ ಬುಲೈಲೀನ್ ಆಯೋತೆ ಇನಖ್ಹಾಜೆ ದೇವ್ನ ಖ್ಹರಾಯೊ. <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />ಹಮ್ಕೆ ತುಮೆ ಮಾರ ಯಜಮಾನ್ನಿ ಪ್ಯಾರ್‌ನಾಬಿ, ನಿಯ್ಯತ್‌ನಾಬಿ ಮಾನ್ಯತೊ ಒಹೊ ಬೋಲೊ; ನಾರ‍್ಹಯುತೊ ಕೊಯ್ನಿಕರಿ ಬೋಲೊ; ತದೆ ಮೇ ಶಾತ್‌ಕರ‍್ನು ಕರಿ ಮಾಲುಮ್ ಪಡ್‌ಶೆ” ಕರಿ ಬೋಲಿವತಾಳ್ಯೊ. <verse eid="GEN 24:49" /><verse number="50" style="v" sid="GEN 24:50" />ಇನಖ್ಹಾಜೆ ಲಾಬಾನಬಿ, ಬೆತೂವೇಲಬಿ, “ಆ ಕಾಮ್ ಯೆಹೋವಥೀಸ್ ಹುಯು; ಹಮೆತೋಬಿ ಒಹೊ ಕರೀಬಿ, ಕೊಯ್ನಿ ಕರೀಬಿ ಬೋಲಾನ ಕೊಹೊಯ್ನಿಕರಿ ಲಾಬಾನ್ ಅಜು಼ ಬೇತೂವೇಲ್‌ನ ಬೋಲ್ಯ. <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />ರೆಬೆಕ್ಕನ ತಾರ ಹಾತ್ಮ ದಿಯೇಸ್; ಬುಲೈಲೀನ್ ಜ಼ಯೇಜಾ಼ಯ್; ಯೆಹೋವನೆ ಬೋಲ್ಯೊತೆ ತಿಮ್ಮಸ್ ರೆಬೆಕ್ಕ ತಾರ ಯಜಮಾನ್ನ ಛಿಯ್ಯಾನ ಬಾವಣ್‍ ಹುವಾದೆ” ಕರಿಬೋಲ್ಯ. <verse eid="GEN 24:51" /><verse number="52" style="v" sid="GEN 24:52" />ಅಬ್ರಹಾಮ್‍ನ ಸೇವಕ್‌ನೆ ಇವ್ಣಿ ವಾತ್‍ಖ್ಹಮ್‍ಜಿನ್ ಯೆಹೋವನ ಆಡೊಪಡಿನ್ ಆರಾದನೆ ಕರ‍್ಯೊ. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />ಇನಪಾರ್ ಇನೆ ಲೀನ್ ಆಯೋತೆ ಖ್ಹೊನ್ನು ರೂಪು ಅಜು಼ ಲುಂಗ್ಡಾವ್‌ಬಿ ಕಾಡಿನ್ ರೆಬೆಕ್ಕನ ದಿದೊ. ಇನ ಭೈನಾಬಿ ಆಯಾನಬಿ ಜಿನು ಘಣಮೋಲ್ನು ಚೀಜ಼್‌ಖ್ಹಾರುದಿದೊ. <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />ಅನಕೇಡೆಥು ಯೋಬಿ ಇನಿ ಜೋ಼ಡ್ನ ಆಯುತೆ ಚಾ಼ಕ್ರಿವಾಳುಬಿ ಖಾಣುಪಾಣಿ ಖೈಪೀಲಿನ್ ಯೊ ರಾತ್‍ಖ್ಹಾರು ಹಿಜ್ಜಾ಼ಸ್‍ ಕಾಡ್ಯು. ವ್ಹಾಣೆ ಉಠೀನ್ ಇನೆ, “ಮಾರ ಯಜಮಾನ್‍ಕನ ಜಾ಼ವನಖ್ಹಾಜೆ ಮನ ಹುಕುಮ್‌ ಮಳಾದೆ” ಕರಿ ಬೋಲಖ್ಹತರ್, <verse eid="GEN 24:54" /><verse number="55" style="v" sid="GEN 24:55" />ರೆಬೆಕ್ಕನೊ ಭೈಬಿ ಆಯಾನೆಬಿ ಇನ, “ಛೋ಼ಕ್ರಿ ಬಿಜು಼ ದಖ್ಹ್‌ ರೋಜ಼್‌ತೋಬಿ ಹಮಾರಕನ ರ‍್ಹವಾದೆ ; ಇನಪಾರ್ ಯೊ ಜ಼ವಾದೆ” ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 24:55" /><verse number="56" style="v" sid="GEN 24:56" />ಇನೆ ಇವ್ಣುನ, “ಯೆಹೋವನೆ ಮಾರಿ ಚಾ಼ಲ್‍ಕುಚ಼್‍ನ ಜೀತ್‍ ದೀರಾಖ್ಯೋಸ್; ಇನಖ್ಹಾಜೆ ಮನ ತಡಾ ನಕೋಕರೊ, ಮಾರ ಯಜಮಾನ್‍ಕನ ಜಾ಼ವಾನ ಮನ ಹುಕುಮ್‌ ದೆವೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 24:56" /><verse number="57" style="v" sid="GEN 24:57" />ಇವ್ಣೆ, “ಹಮೆ ಛೋ಼ಕ್ರಿನ ಬುಲೈನ್ ಇನ ಮಾಯ್ನನ ಖ್ಹಮ್‌ಜಿ ಲಿಯೇಸ್” ಕರಿಬೋಲ್ಯ. <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />ಇವ್ಣೆ ರೆಬೆಕ್ಕನ ಬುಲೈನ್, “ಆ ಅದ್ಮಿನಿ ಜೋ಼ಡ್ಮ ತೂ ಜಾ಼ಸ್‍ಕಿಶು?” ಕರಿ ಬೋಲ್ಯ. ಇನೆ “ಜ಼ವುಸ್” ಕರಿಬೋಲಿ. <verse eid="GEN 24:58" /><verse number="59" style="v" sid="GEN 24:59" />ತದೆ ಇವ್ಣೆ ಇವ್ಣಿ ನ್ಹಾನಿ ಭೇನ್ ರೆಬೆಕ್ಕನಾಬಿ ಇನಿ ಸೇವಕಿಯೇನಾಬಿ, ಅಬ್ರಹಾಮ್‍ನ ಸೇವಕ್‌ನ ಜೋ಼ಡ್ಮ ಮೋಕ್ಲಿದಿದು. <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />ಅಜು಼ ಇವ್ಣೆ ರೆಬೆಕ್ಕನ, ಆಶೀರ್ವಾದ್ ದೀನ್ “ಭೇನ್, ತಾರೇಥಿ ಲಾಖೊಲಾಕ್ ಪಿಳ್ಗಿಹುವಾದೆ; ತಾರಿ ಪಿಳ್ಗಿವಾಳು ಇನ ವಹೇರ‍್ಯಾವ್ನು ಶೊತ್‌ನ ಸೊಂತ್ ಕರಿಲ್ಯಾವಾದೆ” ಕರಿ ಬೋಲಿನ್ ವಾರ್ಖ್ಹೊದಿದು. <verse eid="GEN 24:60" /><verse number="61" style="v" sid="GEN 24:61" />ರೆಬೆಕ್ಕಬಿ ಇನಿ ಸೇವಕಿಬಿ ಊಟೆವ್‍ಪರ್ ಚ಼ಢೀನ್ ಅಬ್ರಹಾಮ್‍ನ ಸೇವಕ್‌ನ ಪೀಠೆ ಗೈಯೇ. ಅಮ್ ಯೊ ಚಾ಼ಕ್ರಿವಾಳವ್‍ನೆ ರೆಬೆಕ್ಕನ ಬುಲೈಲಿನ್ ಗಯ. <verse eid="GEN 24:61" /><verse number="62" style="v" sid="GEN 24:62" />ಎತ್ರಾಮ ಇಸಾಕ್ ಲಹೈರೋಯಿ<note caller="+" style="f"><char style="fr" closed="false">24:62 </char><char style="ft" closed="false">ಇಮ್‌ಕತೊ “ಜಿವಿರ‍್ಹವಾಳೊ ಮನ ದೇಖವಾಳೊ” ಕರಿ</char></note> ಯೊ ಕಾನಾನ್ ದೇಖ್ಹ್‌ನು ದಕ್ಷಿಣ್ ತಬರ್‌ಖಾಮ ಜಿವ್ಣುಕರ್ತೋಥೊ. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />ಇನೆ ಖ್ಹಾಂಜ಼್‌ನಿ ವೇಳ್ಮ ದೇವ್ನಿ ಧ್ಯಾನ್ ಕರಾನಖ್ಹಾಜೆ ಖೇತರ್‌ಕನ ಜೈ಼ರ‍್ಹೋಥೊ. ಹಿಜ಼್ಜ ಡೋಳ ಪಾಡಿದೇಖಾಖ್ಹತರ್ ಊಟೆವ್‍ಖ್ಹಾರು ಆವಾನು ದೇಖ್ಯೊ. <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />ರೆಬೆಕ್ಕನೆ ಡೋಳಪಾಡಿ ಇಸಾಕನ ದೇಖಿನ್ ಊಟ್‌ಥಿ ಹೇಟ್ಉತ್ರಿ. <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />ಇನೆ ಯೊ ಸೇವಕ್‌ನ, “ಅಪ್ಣ ಖ್ಹಾಮೆ ಖೇತರ್‌ಭಣಿಥು ವಳ್ಯಾವತೆ ಯೊ ಅದ್ಮಿ ಕೋಣ್?” ಕರಿ ಪುಛೈ಼. ಯೋಸ್ ಮಾರೊ ಯಜಮಾನ್ ಕರಿ ಯೊ ಬೋಲಖ್ಹತರ್ ಇನೆ ಘುಮ್‌ಟೊ ನಾಖಿಲಿದಿ. <verse eid="GEN 24:65" /><verse number="66" style="v" sid="GEN 24:66" />ಯೊ ಸೇವಕ್‌ನೆ ಇನೆ ಕರ‍್ಯೊತೆ ಖ್ಹಾರ ಕಾಮ್ನ ಇಸಾಕನ ಬೊಲ್ಯೊ. <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />ಇಸಾಕ್‍ನೆ ರೆಬೆಕ್ಕನ ಇನಿ ಆಯಾ ಸಾರನು ಡೇರಾನ ಘರ್ಮ ಬುಲೈಲೀನ್‍ ಗಯೊ. ಅಮ್ನಿ ಪರಕ್ಮ ಇಸಾಕ್‍ನೆ ವ್ಯಾಹ ಕರ‍್ಯೊ. ರೆಬೆಕ್ಕ ಇನಿ ಬಾವಣ್‍ಹುಯಿ ಅಜು಼ ಪ್ಯಾರ್‌ಕರ‍್ಯೊ. ಇನೆ ರೆಬೆಕ್ಕನ ಪ್ಯಾರ್‌ಥಿ ಇನಿ ಆಯಾ ಸಾರ ಮರೀತೆ ದುಖ್‌ನ ಭೈಕಿಗಯೊ.<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">ಅಬ್ರಹಾಮ್‍ನಿ ಬಿಜಿಖ್ಹಾರಿ ಪಿಳ್ಗಿ</para>
  <para style="r">(<ref loc="1CH 1:32-33">1. ಪೂರ್ವ 1:32-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />ಅಬ್ರಹಾಮ್‌ನೆ ಕೆಟೂರಕರಿ ಬಿಜೇಕ್ ಬಾವಣ್ಣ ವ್ಯಾಹ ಕರಿಲಿದೊ. <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />ಹೈರಿತೆನೆ ಇನ, ಜಿಮ್ರಾನ್, ಯೊಕ್ಷಾನ್, ಮೆದಾನ್, ಮಿದ್ಯಾನ್, ಇಷ್ಬಾಕ್, ಶೂಹ, ಅವ್ಣುನ ಜ಼ಣಿ. <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />ಯೊಕ್ಷಾನ್ ಅಜು಼ ಶೆಬಾನೊ ಬಾ ದೆದಾನ್‌. ಅಶ್ಮೂರ್ಯಬಿ, ಲೆಟೂಶ್ಯಬಿ, ಲೆಯುಮ್ಯಬಿ, ದೆದಾನ್ನಿ ಪಿಳ್ಗಿವಾಳು. <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />ಗೇಫಾ, ಗೇಫೆರ್, ಹನೋಕ್, ಅಬೀದಾ, ಎಲ್ದಾಯ ಕರಿ ಅವ್ಣೆ ಮಿದ್ಯಾನಥಿ ಪೈದಹುಯ. ಅವ್ಣೆಖ್ಹಾರುಬಿ ಕೆಟೂರನಿ ಪಿಳ್ಗಿವಾಳು. <verse eid="GEN 25:4" /><verse number="5" style="v" sid="GEN 25:5" />ಅಬ್ರಹಾಮ್‌ನೆ ಇನಥೂತೆ ಶೊತ್‍ಖ್ಹಾರುಬಿ ಇಸಾಕ್‍ನ ದಿದೊ. <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />ಅಬ್ರಹಾಮ್‌ನೆ ಇನಿ ಬಿಜಿಬಾವ್ಣೆನ ಲಡ್ಕಾವ್ನ ಥೋಡು ಶೊತ್ನ ಧರಮ್‍ಕರೀನ್ ಯೊ ಬಿಜೂ಼ಬಿ ಬಚಿರ‍್ಹವಾನಿ ವಖ್ಹ್‌ತೇಸ್ ಇವ್ಣುನ ಇನೊ ಛಿಯ್ಯೊ ಇಸಾಕ್‍ಕಂಥು ಪೂರಬ್ ದಿಕ್‌ಮಾನು ಕೆದೆಮ್ ಮುಲಕ್‌ಮ ಮೋಕ್ಲಿದಿದೊ.<verse eid="GEN 25:6" /></para>
  <para style="s">ಅಬ್ರಹಾಮ್‌ನಿ ಮರಣ್ ಅಜು಼ ಇನು ಮಖ್ಹಾಣ್ಯು</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />ಅಬ್ರಹಾಮ್ ಎಖ್ಹೊ ಪಾಚ಼್ಉಪ್ಪರ್ ಖ್ಹಡ್‌ತೀನಿಖ್ಹ್ ವರಖ್ಹ್‌ಮ ಮರ‍್ಯೊ. <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />ಅಬ್ರಹಾಮ್‍ನಿ ಪೂರ ಉಂಬರ್ ಖತಮ್ ಹುಯಿನ್ ಭುಡೊಝಿಂಕ್ ಹುಯಿನ್ ಜಾನ್‌ ಮ್ಹೇಲಿನ್ ಇನ ಗುರುಗುರಬ್‍ಲ್ಯಕನ ಮಳಿಗೊ. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />ಇನ ಛಿಯ್ಯಾ ಇಸಾಕ್, ಇಷ್ಮಾಯೇಲ್‌ನೆ ಹಿತ್ತಿಯವಾಳೊ ಚೋಹರ‍ನೊ ಛಿಯ್ಯೊ ಎಫ್ರೋನ್ನಿ ಜ಼ಮೀನ್ಮ ಥೂತೆ ಮಕ್ಪೇಲನು ಘವಿಮ ಇನ ಮಖ್ಹಾಣ್ಯು ಕರ‍್ಯ. ಯೊ ಮಮ್ರೆ ತೋಪ್ನು ಪೂರಬ್ ದಿಕ್ಮ ಛಾ಼. <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />ಅಬ್ರಹಾಮ್‌ನೆ ಯೊ ಹಿತ್ತಿಯವಾಳಥಿ ಮೋಲ್ ಲೀರಾಖ್ಯೊಥೊ. ಇನಾಮ ಅಬ್ರಹಾಮ್‍ನಾಬಿ, ಇನಿ ಬಾವಣ್ ಸಾರನಬಿ ಮಖ್ಹಾಣ್ಯುಹುಯು. <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />ಅಬ್ರಹಾಮ್ ಮರಿಜಾ಼ವಾನ ಬಾದ್ಮ ದೇವ್‍ನೊ ಆಶೀರ್ವದ್ ಛಿಯ್ಯೊ ಇಸಾಕ್‍ಪರ್‌ಬಿ ಆಯು. ಇಸಾಕ್‍ನೆ ಲಹೈರೋಯಿ ಕರಿ ಬಾವ್ಡಿನ ಖನ್ನೆ ಜಿವ್‍ಕರ‍್ತೋಥೊ.<verse eid="GEN 25:11" /></para>
  <para style="s">ಇಷ್ಮಾಯೇಲ್‌ನಿ ಪಿಳ್ಗಿನಿ ಬಾರೇಮ</para>
  <para style="r">(<ref loc="1CH 1:28-31">1. ಪೂರ್ವ 1:28-31</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />ಅಬ್ರಹಾಮ್‍ನ ಸಾರನಿ ಈಜಿಪ್ಟ್‌ವಾಳಿ ದಾಸಿ ಹಾಗರ‍ಮ ಪೈದಹುಯೋತೆ ಇಷ್ಮಾಯೇಲ್‌ನು ಪಿಳ್ಗಿನಿ ಖೇಣಿ. <verse eid="GEN 25:12" /><verse number="13" style="v" sid="GEN 25:13" />ಇಷ್ಮಾಯೇಲ್‌ನ ಲಡ್ಕಾವ್‍ನಬಿ ಇವ್ಣೇಥಿ ಪೈದಹುಯುತೆ ಖೂಮ್‍ನಾಬಿ ಛಾ಼ತೆ ನಾಮ್‍ಖ್ಹಾರು ಖೆವುಕತೊ; ಪಹಿಲೆ ಪೈದಹುಯೋತೆ ನೆಬಾಯೋತ್, ಇನಪಾರ್ ಪೈದಹುಯಾತೆ ಕೇದಾರ್, ಅದ್ಬಯೇಲ್, ಮಿಬ್ಸಾಮ್, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />ಮಿಷ್ಮಾ, ದೂಮಾ, ಮಸ್ಸಾ, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />ಹದದ್, ತೇಮಾ, ಯಟೂರ್, ನಾಫೀಷ್, ಕೇದ್ಮಾ ಕರಿ ಅವ್ಣೇಸ್. <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />ಅವ್ಣೇಸ್ ಯೊ ಭಾರ ಖೂಮ್ನ ಶುರುವಾತ್‍ನ ಪರ್ಖ್ಹ. ಅವ್ಣ ನಾಮ್ನಾಸ್ ಇವ್ಣ ಗಾಮ್‌ನಾಬಿ ಟೋಳ್‌ನಾಬಿ ಮ್ಹೇಲೈರ‍್ಹುಥು. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />ಇಷ್ಮಾಯೇಲ್‌ ಏಖ್ಹೊಖ್ಹಾತ್‍ ಉಪ್ಪರ್ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್ ಬಚಿರ‍್ಹೊ. ಇನಪಾರ್ ಯೊ ಮರ‍್ಯೊ. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />ಇಷ್ಮಾಯೇಲ್ಯವಾಳು ಹವೀಲಥು ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನು ಪೂರಬ್‍ಮ ಛಾ಼ತೆ ಅಶ್ಯೂರ್‌ನು ವಾಟ್‍ಪರ್‌ನು ಶೂರ್‌ಲಗು ಜಿವ್ಣುಕರ‍್ಯು. ಅಮ್ ಇವ್ಣೆ ಅಬ್ರಹಾಮ್‍ನಿ ಖಾನ್‍ಧಾನ್‍ವಾಳನ ಆಮಖ್ಹಾಮೇಸ್ ಜಿವ್ಣುಕರ‍್ಯು.<verse eid="GEN 25:18" /></para>
  <para style="s">ಇಸಾಕ್‌ನಿ ಪಿಳ್ಗಿ</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />ಅಬ್ರಹಾಮ್‌ನೊ ಛಿಯ್ಯೊ ಇಸಾಕ್‍ನಿ ಪಿಳ್ಗಿ. <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />ಇಸಾಕ್ ಚಾ಼ಳಿಖ್ಹ್ ವರಖ್ಹ್‌ವಾಳೊ ಹುಯಿರ‍್ಹಾವನಿವಖ್ಹ್‌ತೆ ಪದ್ದನ್‌ ಅರಾಮ್ಯವಾಳೊ ಬೆತೂವೇಲನಿ ಛೋ಼ರಿಬಿ ಲಾಬಾನನಿ ಭೇನ್‍ಬಿ ಹುಯಿರೀತೆ ರೆಬೆಕ್ಕನ ಮೆಸಪಟೋಮಿಯಥು ಬುಲೈಮಂಗೈನ್‌ ವ್ಯಾಹ ಕರ‍್ಯೊಥೊ. <verse eid="GEN 25:20" /><verse number="21" style="v" sid="GEN 25:21" />ಯೊ ವಾಂಝ಼್‌ಣಿ ಹುಯಿರ‍್ಹಿಥಿ ಇಸಾಕ್‍ನೆ ಇನಖ್ಹಾಜೆ ಯೆಹೋವ ದೇವ್ನ ಗಿಂಗೈಲಿದೊ. ಯೆಹೋವನೆ ಇನಿ ಬಿಂತಿನ ಖ್ಹಮ್‍ಜ್ಯೋತೆ ಇನಖ್ಹಾಜೆ ರೆಬೆಕ್ಕ ಬೇಜೂನಿ ಹುಯಿ. <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />ಇನ ಗರಬ್‌ಮ ಅವ್ಳಿಜವ್ಳಿಲಡ್ಕ ಏಕ್‍ಥಿಏಕ್ ಧಕ್ಕಾಮುಕ್ಕಿಕರ್ತಾನ ಇನೆ, “ಅಮ್‍ಹುಯೂತೊ ಮೇ ಕಿಮ್‍ ಬಚ಼್‍ಣು” ಕರಿ ಬೋಲಿನ್ ಅನಿ ಬಾರೇಮ ಯೆಹೋವಕನ ಫಿರಾದನ ಗೈ. <verse eid="GEN 25:22" /><verse number="23" style="v" sid="GEN 25:23" />ಯೆಹೋವನೆ ಇನ, “ತಾರ ಪೇಟ್‍ಮ ಬೇ ಜ಼ಗ್‌ಜಾ಼ತ್‌ ಛಾ಼; ಯೊ ಬೇ ಜ಼ಗ್‌ಜಾ಼ತ್‌ ಪೈದಾಖ್ಹ್‌ಥೂಸ್ ಅಲಕ್ ತರೀಕಾಮ ರ‍್ಹಿಶೆ; ಇನಾಮ ಎಕ್ ಬಿಜೇಕ್‍ಥಿ ಘಣು ತಾಖತ್‌ವಾಳು ಉಷೆ; ಮೋಟೊಸ್ ನ್ಹಾನನಿ ಚಾ಼ಕ್ರಿ ಕರ್‌ಶೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 25:23" /><verse number="24" style="v" sid="GEN 25:24" />ಹೈರಿತೆ ದನ್ ಭರಾವದಿನ್ ಅವ್ಳಿ ಜವ್ಳಿ ಲಡ್ಕಜ಼ಣಿ. <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />ಪಹಿಲೆ ಪೈದಹುಯುತೆ ಲಡ್ಕು ಲಲೆಲಾಲ್‌ಬಿ ಆಂಗ್‍ತನ್‌ಭರಿ ಕೇಖ್ಹಾಳು ಹುಯಿರ‍್ಹುಥು. ಇನಖ್ಹಾಜೆ ಇನ, “ಏಸಾವ” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲ್ಯು. <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />ಬೇನು ಲಡ್ಕು ಏಸಾವನಿ ಏಡಿನ ಹಾತೇಖ್ಹು ಧರೀನ್ ಪೈದಹುಯುತೆ ಇನಖ್ಹಾಜೆ “ಯಾಕೋಬ” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲ್ಯು. ಅವ್ಣೆ ಪೈದಹುವಾನಿವಖ್ಹ್‌ತೆ ಇಸಾಕ್ ತೀನೀಖ್ಹ್ ವರಖ್ಹ್‌ವಾಳೊ ಹುಯಿರೋಥೊ.<verse eid="GEN 25:26" /></para>
  <para style="s">ಏಸಾವನೆ ಪೈಲ್ಹೋಟ ಹಕ್ನ ವೇಚಿನಾಖ್ಯೋತೆ</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />ಯೊ ಭೇ ಛೋ಼ಕ್ರಬಿ ಮೋಟಹುಯಿನ್ ಇವ್ಣಾಮ ಏಸಾವ ಹಲ್ಡೊಕರಾಮ ಪುರ್ಗುಲ್ ಹುಯಿರೋಥೊ; ಯೊ ಝಾ಼ಡಿಮರ‍್ಹಾವಳೊ. ಯಾಕೋಬ ಮ್ಹಾಮುಲಿ ಅದ್ಮಿಹುಯಿನ್ ಡೇರಾನ ಘರ್‌ಮಾಸ್ ಜಿವ್ಣುಕರ‍್ಯೊ. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />ಹಲ್ಡಾನಿ ಬೋಟಿ ಇಸಾಕ್‌ನ ಪಸಂದ್‍ಥೂತೆ ಇನಖ್ಹಾಜೆ ಯೊ ಏಸಾವನ ಪ್ಯಾರ್ ಕರ‍್ಯೊ; ರೆಬೆಕ್ಕನೆ ಯಾಕೋಬನ ಪ್ಯಾರ್ ಕರಿ. <verse eid="GEN 25:28" /><verse number="29" style="v" sid="GEN 25:29" />ಏಕ್‍ದನ್ ಯಾಕೋಬ ಖಾಣು ಕರುಕರಾನಿ ವಖ್ಹತ್‌ಮ ಏಸಾವ ಝಾ಼ಡಿಥೊ ಥಕೀನ್‌ ಆಯೊ. ತದೆ ಇನ, “ಮೇ ಘಣೊ ಥಕೀನ್‌ ಐರ‍್ಹೋಸ್; <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />ಯೊ ಲಾಲ್ ಲಜ಼ತ್‍ನು ಚೀಜ಼್‍ನ ಹಮ್ಕೇಸ್ ಖಾವಾನ ದೇ” ಕರಿ ಬೊಲ್ಯೊ. ಆ ವಾತೆಥಿ ಏಸಾವನ “ಎದೋಮ್” ಕರಿ ನಾಮ್‌ಆಯು. <verse eid="GEN 25:30" /><verse number="31" style="v" sid="GEN 25:31" />ಯಾಕೋಬನೆ ಇನ, “ತೂ ಪಹಿಲೆ ತಾರಿ ಪೈಲ್ಹೋಟ ಹಕ್ನ ಮನ ವೇಚಿನಾಕ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 25:31" /><verse number="32" style="v" sid="GEN 25:32" />ಏಸಾವನೆ, “ಹುವಾದೆ” ಮಾರೀನ್‌ತರಾನ ಮರಾವಾಳನ ಪೈಲ್ಹೋಟ ಹಕ್‍ನೊ ಫಾಯಿದೊಶನ ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 25:32" /><verse number="33" style="v" sid="GEN 25:33" />ತದೆ ಯಾಕೋಬನೆ ಪಹಿಲೆ ಕೋಲ್‌ದೆ ಕರಿ ಬೋಲಾನಿವಖ್ಹ್‌ತೆ ಏಸಾವನೆ ಆಣ್‍ಕರಿನ್ ಇನ ಪಹಿಲೋಟ ಹಕ್ನ ಇನ ದಿನಾಖಿದಿದೊ. <verse eid="GEN 25:33" /><verse number="34" style="v" sid="GEN 25:34" />ತದೆ ಯಾಕೋಬನೆ ಏಸಾವನ ರೋಟೊಬಿ ಲೋಭ್ಯಾನು ಟೋಟನಾಬಿ ದಿದೊ. ಏಸಾವನೆ ಖೈ ಪೀನ್ ಉಠಿ ಚ಼ಲೇಗೊ. ಅಮ್ ಇನೆ ಇನು ಪೈಲ್ಹೋಟ ಹಕ್ನ ಫಿಕ್ಕರ್ ಕರ‍್ಯೋಕೊಂತೆ ಮ್ಹೇಲಿದಿದೊ.<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">ಇಸಾಕ್ ಗೆರಾರ‍್ಮ ಜಿವ್ಣುಕರ‍್ಯೋತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />ಅಬ್ರಹಾಮ್‍ನ ಹಗಾಮ್ಮ ಪಹಿಲು ಕಾಳ್‌ದುಕಾಳ್ ಕಾಹೆತೆ ಬಿಜೇಕ್ ಕಾಳ್‌ದುಕಾಳ್‌ಬಿ ಕಾನಾನ್ ದೇಖ್ಹ್‌ನ ಆಯು. ತದೆ ಇಸಾಕ್‍ನೆ ಫಿಲಿಷ್ಟಿಯವಾಳನೊ ರಾಜ಼ ಅಬೀಮೆಲೆಕನ ದೇಖಾನ ಗೆರಾರ್‌ನ ಗಯೊ. <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />ಹಿಜ್ಜಾ಼ ಯೆಹೋವನೆ ಇಸಾಕ್‍ನ ದರ್ಶನ್‌ದೀನ್, “ತೂ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ನಕೊ ಜಾ಼; ಮೇ ಬೋಲುತೆ ದೇಖ್ಹ್‌ಮ ತೂ ಜಿವ್ಣು ಕರ್ನು. <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />ತೂ ಆ ದೇಖ್ಹ್‌ಮ ರ‍್ಹೇ; ಮೇ ತಾರಕನ ರ‍್ಹೀನ್ ತುನ ಆಶೀರ್ವಾದ್ ಕರಿನ್‌ ತುನಾಬಿ, ತಾರಿ ಪಿಳ್ಗಿವಾಳನಬಿ ಆ ಖ್ಹಾರಸ್ ತಬರ್ಖಾನ ದೆವುಸ್‌. ಅಮ್ ತಾರೊ ಬಾ ಅಬ್ರಹಾಮ್‍ನ ಕರ‍್ಯೊತೆ ವಾಗ್ದಾನ್ನ ಚ಼ಲಾವುಸ್. <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />ತಾರಿ ಪಿಳ್ಗಿವಾಳನ ಆಬ್‍ಮ ಛಾ಼ತೆ ಶುಕ್ಕರ್‌ನಿತರ ಭಡೈಶ್. ತಾರಿ ಪಿಳ್ಗಿನ ಆ ತಬರ್ಖೊ ಖ್ಹಾರೋಸ್ ದೆವುಸ್. ತಾರಿ ಪಿಳ್ಗಿಥಿ ಧರ್ತಿನು ಖ್ಹಾರುಸ್‍ ಜ಼ಗ್‌ಜಾ಼ತ್‍ನಾಬಿ ಆಶೀರ್ವಾದ್‌ ಉಷೆ. <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />ಶನಕತೊ ಅಬ್ರಹಾಮ್ ಮಾರಿ ವಾತ್ನ ಮುಡ್‌ಕ್ಯುಝು಼ಕೈನ್ ಮಾರಿ ವಿಧಿನ, ಮಾರಿ ಹುಕುಮ್‍ಖ್ಹಾರನ, ಮಾರಿ ಖಾನೂಲ್‍ನ, ಮಾರಿ ಹುಕುಮ್‌ನ ಪಾಡಿಚಾ಼ಲ್ಯೊ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 26:6" />ಇನಖ್ಹಾಜೆ ಇಸಾಕ್‍ ಗೆರಾರ‍್ಮ ಜಿವ್ಣುಕರ್ತೋಥೊ. <verse eid="GEN 26:6" /><verse number="7" style="v" sid="GEN 26:7" />ಯೊ ಝ಼ಗೋನು ಅದ್ಮಿ ಇನಿ ಬಾವಣ್ಣ ದೇಖಿನ್ ಇನಿ ಬಾರೇಮ ಪುಛಾ಼ಯು. ತದೆ ಇನೆ ರೆಬೆಕ್ಕ ಶನ್‌ಗಾರ್‌ನಿ ಥೀತೆ ಖ್ಹಾಜೆ ಆ ಝ಼ಗೋನು ಅದ್ಮಿ ಅನಾಖ್ಹಾಜೆ ಮನ ಮಾರಿನಾಕ್‍ಶೆನಿ ಕರಿ ಇನೆ ಇನಿ ಬಾವಣ್‌ಕರಿ ಬೋಲಾನ ಡರಿನ್ ಭೇನ್‍ಲಾಗ್ಣು ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 26:7" /><verse number="8" style="v" sid="GEN 26:8" />ಇನೆ ಯೊ ಝ಼ಗೋಮ ಘಣಾದನ್ ರ‍್ಹವಾನಪಾರ್ ಏಕ್‍ದನ್ ಫಿಲಿಷ್ಟಿಯವಾಳನೊ ರಾಜ಼ ಅಬೀಮೆಲೆಕನೆ ಕಿಟ್ಕೆಥು ದೇಖಾನಿವಖ್ಹ್‌ತೆ ಇಸಾಕ್‍ ಇನಿ ಬಾವಣ್ ರೆಬೆಕ್ಕನಿ ಜೋ಼ಡ್ಮ ಲಾಡ್‌ಕರಾನು ದೇಖ್ಯೊ. <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />ಅಬೀಮೆಲೆಕನೆ ಇಸಾಕ್‍ನ ಬುಲೈಮಂಗೈನ್‌, “ಖ್ಹಾಚಮ ಆ ಹೈರಿತೆ ತಾರಿ ಬಾವಣ್‍ ಕಾಹೆಕಿಶು, ಭೇನ್‍ಕರಿ ಶನ ಬೊಲ್ಯೊ?” ಕರಿ ಪುಛಾ಼ವಖ್ಹತರ್ ಇಸಾಕ್‍ನೆ, “ಇನಾಖ್ಹಾಜೆ ಅದ್ಮಿಖ್ಹಾರು ಮನ ಮಾರಿನಾಕ್‌ಶೆ ಕರಿ ಇಮ್ ಬೋಲ್ಯೊತೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 26:9" /><verse number="10" style="v" sid="GEN 26:10" />ಇನ ಅಬೀಮೆಲೆಕನೆ, “ತೂ ಹಮುನ ಅಮ್ ಶನ ಕರ‍್ಯೋತೆ? ಹಮಾರಮ ಕೋಣ್‌ತೋಬಿ ತಾರಿ ಬಾವಣ್ಣಿ ಜೋ಼ಡ್ಮ ಮಳ್ವಾಖ್ಹರ್‌ಕು ಹುಯಿಗುಹೋತ್ನಿ? ತಾರೇಥಿ ಹಮಾರಪರ್ ಖೋಟ್‍ ಆವಖ್ಹರ್‌ಕು ಹುಯುಹೋತ್ನಿ?” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 26:10" /><verse number="11" style="v" sid="GEN 26:11" />ಅಮ್ ಅಬೀಮೆಲೆಕನೆ ಇನ ಅದ್ಮೆವ್‍ನ, “ಆ ಅದ್ಮಿನ ರ‍್ಹವೊ ಅನಿ ಬಾವಣ್‌ಥಿ ರ‍್ಹವೊ ಖರಾಬ್ ಪರಕ್ಮ ಚಾ಼ಲ್ಯತೊ ಮರಣ್ಣಿ ನಿಶತ್ ಛು಼ಕ್‌ಶೆ ಕೊಯ್ನಿ” ಕರಿ ಹುಕುಮ್‍ಕರ‍್ಯೊ. <verse eid="GEN 26:11" /><verse number="12" style="v" sid="GEN 26:12" />ಇಸಾಕ್‍ನೆ ಯೊ ದೇಖ್ಹ್‌ಮ ದಾಣ ಬಿತ್‌ಕರೀನ್ ಯೋಸ್‍ ವರಖ್ಹ್‌ಮ ಏಕ್‌ನ ಖ್ಹೋಎತ್ರು ಅನಾಜ಼್‍ವ್ಹಾಡ್ಯೊ; ಅಜು಼ ಯೆಹೋವನೆ ಇನ ಘಣು ಆಶೀರ್ವದ್ ಭಡಾಯೊ; <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />ಇನು ಧನ್‍ದೌಲತ್ ದನ್‍ಪರ್‌ದನ್ ಭಡ್ಯುತೆ ಇನಖ್ಹಾಜೆ ಘಣೊ ದೌಲತ್ತಿಬಣ್ಯೊ. <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />ಇನ ಢಾಂಡ ಬೋಕ್ಡಾವ್‌ಬಿ, ಧನ್‌ದವ್ಲತ್‍ಬಿ, ಚಾ಼ಕ್ರಿಕರಾವಳುಬಿ ಘಣುಥೂತೆ ದೇಖಿನ್ ಫಿಲಿಷ್ಟಿಯವಾಳು ಪೇಟ್ನೊಬಳಾಪೊ ಕರ‍್ಯು. <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />ಇನೊ ಬಾ ಅಬ್ರಹಾಮ್‌ನು ಆಳ್‌ಖ್ಹಾರು ಅಬ್ರಹಾಮ್‌ನ ಹಗಾಮ್ಮಸ್ ಖೋಂದ್ಯಹುಯ ಬಾವ್ಡಿಯೇನ ಫಿಲಿಷ್ಟಿಯವಾಳನೆ ಮಾಟಿನಾಖಿನ್ ಮೂಚಿನಾಖ್ಯು. <verse eid="GEN 26:15" /><verse number="16" style="v" sid="GEN 26:16" />ಅಮ್‌ರ‍್ಹಾವಪರ್ ಅಬೀಮೆಲೆಕನೆ ಇಸಾಕ್‍ನ, “ತೂ ಹಮಾರೆಥಿ ಘಣು ಭಡೀಗೊ, ಇನಖ್ಹಾಜೆ ಹಮಾರಕಂಥೊ ಚ಼ಲ್ಯೋಜಾ಼ವ್ಣು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 26:16" /><verse number="17" style="v" sid="GEN 26:17" />ಇಸಾಕ್‍ ಹಿಜ್ಜಾ಼ಥೊ ಜೈ಼ನ್ ಗೆರಾರ್ ಝೋ಼ಕ್‍ನು ಬಲ್ಡಾಮ ಲಂಗರ್‌ನಾಖಿನ್ ಹಿಜ಼್ಜ ಜಿವ್ಣುಕರ‍್ಯೊ. <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />ಅಬ್ರಹಾಮ್‌ನೆ ಖೋಂದಾಯೊತೆ ಬಾವ್ಡಿಯೇನ ಯೊ ಮರಿಜಾ಼ವನಿ ವಖ್ಹ್‌ತೆ ಫಿಲಿಷ್ಟಿಯವಾಳನೆ ಮೂಚಿನಾಖ್ಯುತೆ ಇನಖ್ಹಾಜೆ ಇಸಾಕ್‍ನೆ ಯೊ ಅಖ್ಖಾನ ಪಾಛೋ಼ ಖೋಂದೈನ್, ಬಾನೆ ಮ್ಹೇಲ್ಯೋತೆ ನಾಮ್ನಾಸ್ ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 26:18" /><verse number="19" style="v" sid="GEN 26:19" />ಇಸಾಕ್‍ನು ಆಳ್‌ಖ್ಹಾರು ಝೋ಼ಕ್‍ಮ ಖೋಂದಖ್ಹತರ್ ಇವ್ಣುನ ಉಕ್ಳಾನು ಚೇಜ್ಭಾ಼ರಾನು ಬಾವ್ಡಿ ಮಳ್ಯು. <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />ಗೆರಾರ‍್ನು ಢಾಂಡ ಚ಼ರಾವವಾಳು ಅಯಿನ್ ಯೊ ಪಾಣಿ ಹಮಾರುಕರಿ ಬೋಲಿನ್ ಇಸಾಕ್‍ನು ಢಾಂಡ ಚ಼ರಾವವಾಳನಿ ಜೋ಼ಡ್ಮ ಲಡೈ ಕರ‍್ಯೂತೆ ಇನಖ್ಹಾಜೆ ಇಸಾಕ್‍ನೆ ಯೊ ಬಾವ್ಡಿನ “ಏಸೆಕ್<note caller="+" style="f"><char style="fr" closed="false">26:20 </char><char style="ft" closed="false">ಏಸೆಕ್‌ ಕತೊ ಲಡೈಕರಿ ಮತ್ಲಬ್‌</char></note>” ಕರಿ ನಾಮ್ ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />ಇನಪಾರ್‌ ಇನು ಅದ್ಮಿ ಬಿಜೇಕ್ ಬಾವ್ಡಿ ಖೋಂದಾನಿವಖ್ಹ್‌ತೆ ಯೊ ದೇಖ್ಹ್‌ವಾಳು ಇನಖ್ಹಾಜೇಬಿ ಲಡೈ ಕರ‍್ಯುತೆಖ್ಹಾಜೆ ಇಸಾಕ್‍ನೆ ಇನ <note caller="+" style="f"><char style="fr" closed="false">26:21 </char><char style="ft" closed="false">ಸಿಟ್ನಾಕತೊ ದುಷ್ಮನ್‌ಕರಿ ಮತ್ಲಬ್‌</char></note>“ಸಿಟ್ನಾ” ಕರಿ ನಾಮ್‍ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />ಇನೆ ಹಿಜ್ಜಾ಼ಥೊ ನಿಕ್ಳಿನ್ ಅಜೇಕ್ ಬಾವ್ಡಿ ಖೋಂದಾವನಿ ವಖ್ಹ್‌ತೆ ಇನಿ ಬಾರೇಮ ಕೋಣ್‍ಬಿ ಲಡೈಕರ‍್ಯುಕೊಂತೆ ಇನಖ್ಹಾಜೆ ಇನೆ, “ಹಮ್ಕೆ ಯೆಹೋವನೆ ಹಮಾರಖ್ಹಾಜೆ ಘಣಿ ಝ಼ಗೊ ಕರಿದಿದೋತೆ ಇನಖ್ಹಾಜೆ ಹಮೆ ಭಡ್‍ಶು” ಕರಿ ಬೋಲಿನ್ ಇನ, “ರೆಹೋಬೋತ್” ಕರಿ ನಾಮ್‍ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 26:22" /><verse number="23" style="v" sid="GEN 26:23" />ಇಸಾಕ್‍ನೆ ಹಿಜ್ಜಾ಼ಥೊ ನಿಕ್ಳಿನ್ ಘಾಟ್ ಛ಼ಢೀನ್ ಬೇರ್ಷೆಬನ ಗಯೊ. <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />ಯೊ ರಾತ್ ಯೆಹೋವ ದೇವ್‍ ಇನ ದೆಖೈನ್, “ಮೇ ತಾರೊ ಬಾ ಅಬ್ರಹಾಮ್‌ನೊ ದೇವ್; ತೂ ಡರ್‌ನಕೊ; ಮೇ ತಾರಿ ಜೋ಼ಡ್ಮ ಛೂ಼; ಮಾರೊ ಸೇವಕ್ ಅಬ್ರಹಾಮ್‍ನಖ್ಹಾಜೆ ತುನ ಆಶೀರ್ವಾದ್‌ ಕರೀನ್ ತಾರಿ ಪಿಳ್ಗಿನ ಭಡಾವುಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 26:24" /><verse number="25" style="v" sid="GEN 26:25" />ಇಸಾಕ್‍ನೆ ಚಾ಼ಚ಼ರ್‌ ಭಂದೈನ್ ಯೆಹೋವನು ನಾಮ್‍ಬೋಲಿನ್ ಆರಾದನೆ ಕರೀನ್ ಹಿಜ಼್ಜಾ ಇನು ಲಂಗರ್ ನಖೈಲಿದೊ. ಹಿಜ಼್ಜ ಬಾವ್ಡಿನ ಖೊಂದಾಯೊ.<verse eid="GEN 26:25" /></para>
  <para style="s">ಇಸಾಕ್‍ಬಿ ಅಬೀಮೆಲೆಕನ ಇಚ಼್‌ಮ ಹುಯುತೆ ಒಪ್ಪಂದ</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />ಯೊ ವಖ್ಹತ್‌ಮ ಅಬೀಮೆಲೆಕನೆ ಇನೊ ಖ್ಹೂಜ಼್‌ ಬೋಲಿದ್ಯವಾಳೊ ಅಹುಜ್ಜತನಾಬಿ, ಶಿಪಾಯಿ ಹುಯಿರೋತೆ ಫೀಕೋಲನಾಬಿ ಜೋ಼ಡ್ಮ ಬುಲೈಲೀನ್ ಗೆರಾರ್‌ಥೊ ಇಸಾಕ್‍ಕನ ಆಯೊ <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />ಇಸಾಕ್‍ನೆ, “ತುಮೆ, ಮನ ವಹೇರ್‌ಕರೀನ್ ತುಮಾರಕಂಥು ಮೋಕ್ಲಿದಿದಾನಿ; ಹಮ್ಕೆ ಮಾರಕನ ಶನ ಆಯ?” ಕರಿ ಇವ್ಣುನ ಬೊಲ್ಯೊ. <verse eid="GEN 26:27" /><verse number="28" style="v" sid="GEN 26:28" />ಇನ ಇವ್ಣೆ, “ಯೆಹೋವ ತಾರಿ ಜೋ಼ಡ್ಮ ಛಾ಼ ಕರಿ ಹಮುನ ಅಛ್ಛಿನಿತರ ಮಾಲುಮ್‌ಪಡ್ಯು ಇನಖ್ಹಾಜೆ ತೂಬಿ, ಹಮೇಬಿ ಏಕ್‍ಥಿಏಕ್ ಆಣ್‍ಕರ‍್ವಾಥಿ ಒಪ್ಪಂದ ಕರಿಲಿಯೆ ಕರಿ ಖ್ಹೂಜ಼್ ಕರಿರಾಖ್ಯಸ್. <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />ಹಮೆ ತುಮುನ ಶನೂಬಿ ಖರಾಬ್‌ ಕರಿಲಿದಾಕೊಂತೆ ಅಛ಼್ಛೂಸ್ ಕರೀನ್ ತುನ ಸಮಾಧಾನ್‌ಥಿ ಮೋಕ್‌ಲ್ಯಾನಿ. ಇಮ್ಮಸ್ ತೂಬಿ ಹಮುನ ಖರಾಬ್ ಕೋಕರಿಷ್‌ನಿ ಕರಿ ಆಣ್ ಕರ್ನು. ತೂ ಹಮ್ಕೆ ಯೆಹೋವನಿ ಆಶೀರ್ವದ್ ಲೀರಾಖ್ಯೋಸ್‍ ಕೊಯ್ನಿಕಿಶೂ?” ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 26:29" /><verse number="30" style="v" sid="GEN 26:30" />ತದೆ ಇಸಾಕ್‍ನೆ ಇವ್ಣುನ ಮಿಝ್ವಾ಼ನ್ ಕರಾಯೊ. ಇವ್ಣೆಖ್ಹಾರು ಖಾವಣ್‍ ಪೀವಣ್‍ ಖತಮ್‍ಕರ‍್ಯು. <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />ಇವ್ಣೆಖ್ಹಾರು ವ್ಹಾಣೆಉಠಿನ್ ಏಕ್‍ಥಿಏಕ್ ಒಪ್ಪಂದ ಕರಿಲಿದು. ಇಸಾಕ್‍ನೆ ಇವ್ಣುನ ಮೋಕ್ಲಾಖ್ಹತರ್ ಇವ್ಣೆ ಸಮಾಧಾನ್‌ಥಿ ಚ಼ಲಿಗಯು. <verse eid="GEN 26:31" /><verse number="32" style="v" sid="GEN 26:32" />ಯೋಸ್ ದನ್ನೆ ಇಸಾಕ್‍ನು ಸೇವಕ್‌ಖ್ಹಾರು ಇವ್ಣೆ ಖೋಂದ್ಯಾತೆ ಬಾವ್ಡಿನಿ ಬಾರೇಮ “ಹಮುನ ಪಾಣಿ ಮಳ್ಯು” ಕರಿ ಆಯಿನ್‌ ಬೋಲ್ಯು. <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />ಇನೆ ಯೊ ಬಾವ್ಡಿನ “<note caller="+" style="f"><char style="fr" closed="false">26:33 </char><char style="ft" closed="false">ಆಣ್‌ನಿ ಬಾವ್ಡಿ</char></note>ಷಿಬಾ” ಕರಿ ನಾಮ್ ಮ್ಹೇಲ್ಯೊ. ಇನಖ್ಹಾಜೆ ಹಿಜ಼್ಜ ಛಾ಼ತೆ ಖ್ಹಯೇರ್‌ ಹಮ್ಕೆಲಗೂಬಿ “ಬೇರ್ಷಬ” ಕರಿ ನಾಮ್‌ಹುಯು.<verse eid="GEN 26:33" /></para>
  <para style="s">ಏಸಾವನೆ ಪರ್‌ ದೇಖ್ಹ್‌ನಿ ಛೋ಼ಕ್ರಿನ ವ್ಯಾಹ ಕರ‍್ಯೋತೆ</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />ಏಸಾವ ಚಾ಼ಳಿಖ್ಹ್ ವರಖ್ಹ್‌ವಾಳೊ ಹುವಾದಿನ್ ಹಿತ್ತಿಯವಾಳೊ ಬೇರಿನಿ ಛೋ಼ರಿ ಯೆಹೂದೀತನಾಬಿ ಹಿತ್ತಿಯವಾಳೊ ಏಲೋನನಿ ಛೋ಼ರಿ ಬಾಸೆಮತನಾಬಿ ವ್ಯಾಹ ಕರಿಲಿದೊ. <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />ಅವ್ಣಖ್ಹಾಜೆಥಿ ಇಸಾಕ್‍ನಾಬಿ ರೆಬೆಕ್ಕನಾಬಿ ದಿಲ್‍ನುಕುಢಾಪೊ ಹುಯು.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">ಯಾಕೋಬ್‍ನ ಇಸಾಕ್‍ನಿ ಆಶೀರ್ವಾದ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />ಇಸಾಕ್‍ ಬುಢೊಹುಯಿನ್ ಡೋಳ ದೆಖಾವಕೊಂತೆ ಭುಂಬ್‌ಳ ಹುಯಿರ‍್ಹವಾನಿವಖ್ಹ್‌ತೆ ಯೊ ಇನೊ ಮೋಟೊ ಛಿಯ್ಯೊ ಏಸಾವನ ಬುಲೈನ್, “ಛಿಯ್ಯಾ” ಕರಿ ಬೋಲಖ್ಹತರ್ ಏಸಾವನೆ, “ಒಹೊ ಹಜ಼್ಜಸ್ ಛೂ಼” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 27:1" /><verse number="2" style="v" sid="GEN 27:2" />ಇಸಾಕ್‍ನೆ ಇನ, “ಮೇ ಬುಢೋಹುಯಿಗೊ; ಕದೆ ಮರೀಶ್‍ಕಿ ಮಾಲುಮ್‍ಕೊಯ್ನಿ. <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />ಇನಖ್ಹಾಜೆ ತಾರ ಕಫ್ಪನ್‌ನಾಬಿ ಧೂಣ್ ತೀರ್‌ಖ್ಹಾರು ಪಾಡಿಲೀನ್ ಝಾ಼ಡಿನ ಜೈ಼ನ್; <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />ಅಜು಼ ಮಾರಖ್ಹಾಜೆ ಶಿಕಾರ್‌ಕರೀನ್ ಬೋಟಿಲೀನ್‌ ಆವ್. ಮನ್ ಪಸಂದ್‍ನು ಲಜ಼ತ್‍ನು ಚೀಜ಼್‌ನ ಮಾರ ಖಾಣನಖ್ಹಾಜೆ ತಯ್ಯಾರ್‌ಕರ್, ಮರ್ವಾನ ಅಗಾಡಿ ಮೇ ಯೊ ಖೈನ್ ತುನ ಆಶೀರ್ವಾದ್‌ ಕರುಸ್” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 27:4" /><verse number="5" style="v" sid="GEN 27:5" />ಇಸಾಕ್‍ನೆ ಇನೊ ಛಿಯ್ಯೊ ಏಸಾವನ ಬೋಲ್ಯೊತೆ ವಾತ್ ರೆಬೆಕ್ಕನ ಕಾನ್ಮ ಪಡ್ಯು. <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />ಏಸಾವ ಶಿಕಾರ್‌ ಕರಾನ ಝಾ಼ಡಿನ ಜೈ಼ರ‍್ಹವಾನಿ ವಖ್ಹ್‌ತೆ, <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />ರೆಬೆಕ್ಕನೆ ಇನೊ ಛಿಯ್ಯೊ ಯಾಕೋಬ್‍ನ, “ತಾರೊ ಬಾ ತಾರೊ ಭೈ ಏಸಾವನ ‘ತೂ ಜೈ಼ನ್‌ ಶಿಕಾರ್‌ ಕರೀನ್ ಯೊ ಬೋಟಿಥಿ ಮಾರಖ್ಹಾಜೆ ಲಜ಼ತ್‍ನ ಖಾಣನ ತಯ್ಯಾರ್‌ಕರ್; ಮರಣ್ ಆವಾನ ಅಗಾಡಿ ಮೇ ತುನ ಯೆಹೋವನ ಖ್ಹಾಮ್ಣೆ ಆಶೀರ್ವಾದ್‌ ಕರುಸ್’ ಕರಿ ಬೋಲಾನು ಮೇ ಖ್ಹಮ್‍ಜಿ. <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />ಇನಖ್ಹಾಜೆ ಛಿಯ್ಯಾ, ತೂ ಮಾರಿ ವಾತ್ನ ಕಾನ್‍ದೀನ್ ಮೇ ಬೋಲಾನಿಘೋಣಿ ಕರ್‌. <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />ಬೋಕ್ಡಾನ ಮಂಧಾಮ ಜೈ಼ನ್ ಬೇ ಅಛ್ಛಾ಼ ಬೋಕ್ಡಾನ ಚೆಲ್ಕಾವ್ನ ಜ಼ಲ್ದಿ ಲೀನ್‍ ಆವ್; ಇನೇಥಿ ತಾರ ಬಾನ ಪಸಂದ್‍ನು ಲಜ಼ತ್‍ನು ಖಾಣು ಮೇಸ್ ತಯ್ಯಾರ್‌ಕರೂಸ್. <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />ತೂ ಯೊ ಇನ ಲಿಜೈ಼ನ್ ಖಡಾವ್ಣು; ಅಮ್ ಕರ‍್ಯೋತೊ ಯೊ ಮರಾನ ಅಗಾಡಿ ತುನಾಸ್‍ ಆಶೀರ್ವಾದ್‌ ಕರ್‌ಶೆ” ಕರಿ ಬೋಲಿ. <verse eid="GEN 27:10" /><verse number="11" style="v" sid="GEN 27:11" />ಇನಖ್ಹಾಜೆ ಯಾಕೋಬ್‍ನೆ ಇನಿ ಆಯಾ ರೆಬೆಕ್ಕನ, “ಮಾರೊ ಮೋಟೊ ಭೈ ಏಸಾವ ಆಂಗ್‍ಭರಿ ಕೇಖ್ಹ್‌ವಾಳೊ ಹುಯಿರೋಸ್. ಮೇ ಬಿಣ್‌ಕೇಖ್ಹ್‌ವಾಳೊ. <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />ಏಕ್‍ ವೇಳ್ ಬಾ ಮನ ಛೀಮಿ ದೇಖ್ಯೋತೊ ಮೇ ಇನ ಠಗಾವವಾಳೊ ಹುಯಿನ್ ದೆಖಾಯೋತೊ, ಆಶೀರ್ವಾದ್‌ಥೀಬಿ ಶಾಪಾಸ್ ಲೀಲಿಶ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 27:12" /><verse number="13" style="v" sid="GEN 27:13" />ಇನಿ ಆಯಾ ಇನ, “ಛಿಯ್ಯಾ, ಯೊ ತುನ ಶಾಪ ದಿದೋತೊ ಯೊ ಶಾಪ ಮನರ‍್ಹವಾದೆ; ತೂ ಮಾರಿ ವಾತ್ನ ಖ್ಹಮ್‌ಜಿನ್ ಬೋಕ್ಡಾನ ಚೆಲ್ಕಾವ್ನ ಲೀನ್ಆವ್‌” ಕರಿ ಬೋಲಿ. <verse eid="GEN 27:13" /><verse number="14" style="v" sid="GEN 27:14" />ಇನೆ ಜೈ಼ನ್ ಯೊ ಅಖ್ಖಾನ ಲಯಿನ್ ಆಯಾನ ದಿದೊ. ರೆಬೆಕ್ಕನೆ ಇನ ಬಾನ ಪಸಂದ್‍ಹುವಾನು ಲಜ಼ತ್‍ನ ಖಾಣನ ತಯ್ಯಾರ್‌ಕರಿ. <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />ಇನಪಾರ್ ರೆಬೆಕ್ಕನೆ ಇನಕನ ಥೂತೆ ಇನ ಮೋಟೊ ಛಿಯ್ಯೊ ಏಸಾವನು ಘಣಾ ಅಛ಼್ಛ ಲುಂಗ್ಡಾನ ಪಾಡಿಲಯಿನ್, ಇನೊ ನ್ಹಾನೊ ಛಿಯ್ಯೊ ಯಾಕೋಬನ ಫೇರೈ. <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />ಯೊ ಬೋಕ್ಡಾನ ಚೆಲ್ಕವ್‍ನು ಚಾ಼ಂಬ್ಡಾವ್‍ನ ಇನ ಹಾತ್‍ನಾಬಿ, ಘಲೆಂಡನಾಬಿ ಲಪೇಟಿ. <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />ಪಾಛ಼ಳ್‍ಥು ಇನೆ ತಯಾರ್ ಕರೀತೆ ಲಜ಼ತ್‍ನ ಖಾಣನಬಿ ರೋಟನಾಬಿ ಇನೊ ಛಿಯ್ಯೊ ಯಾಕೋಬನ ಹಾತ್ಮದಿದಿ. <verse eid="GEN 27:17" /><verse number="18" style="v" sid="GEN 27:18" />ಇನೆ ಬಾಕನ ಜೈ಼ನ್, “ಬಾ” ಕರಿ ಪುಕಾರಖ್ಹತರ್, ಬಾನೆ, “ಶಾತ್‍ಲಾ ಛಿಯ್ಯಾ, ತೂ ಕೋಣ್?” ಕರಿ ಪುಛಾ಼ಯೊ. <verse eid="GEN 27:18" /><verse number="19" style="v" sid="GEN 27:19" />ಯಾಕೋಬನೆ ಇನ, “ಮೇ ತಾರೊ ಮೋಟೊ ಛಿಯ್ಯೊ ಏಸಾವ; ತಾರಿ ಹುಕುಮ್‍ನಿತ್ರಾಸ್ ಖಾಣು ತಯಾರ್ ಕರೀನ್ ಲೈರಾಖ್ಯೋಸ್. ಉಠಿ ಬೇಶಿನ್ ಮೇ ಲೈರಾಖ್ಯೋತೆ ಶಿಕಾರ್‌ ಬೋಟಿ ಖೈನ್ ಮನ ಆಶೀರ್ವಾದ್‍ಕರ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 27:19" /><verse number="20" style="v" sid="GEN 27:20" />ಇಸಾಕ್‍ನೆ, “ಶಾತ್‍ಲಾ ಛಿಯ್ಯಾ, ಅತ್ರೆ ಜ಼ಲ್ದಿ ಶಿಕಾರ್‌ ಕಿಮ್‌ಕರ್ಯೊ” ಕರಿ ಬೋಲಖ್ಹತರ್ ಇನೆ, “ತಾರೊ ದೇವ್‍ ಯೆಹೋವನೆ ಇನ ಮಾರ ಖ್ಹಾಮ್ಣೆ ಆವಖ್ಹರ್ಕು ಕರ‍್ಯೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 27:20" /><verse number="21" style="v" sid="GEN 27:21" />ಇಸಾಕ್‍ನೆ ಯಾಕೋಬ್‍ನ, “ಚೆಲ್ಕಾ, ಮಾರಕನ ಆವ್; ತೂ ಮಾರೊ ಛಿಯ್ಯೊ ಏಸಾವಕಿ ಕೊಯ್ನಿಕಿ ಛೀಮಿ ದೇಖಿ ಮಾಲುಮ್ ಕರ್ನು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 27:21" /><verse number="22" style="v" sid="GEN 27:22" />ಯಾಕೋಬ ಖನ್ನೆ ಆವಖ್ಹತರ್ ಬಾ ಇಸಾಕನೆ ಇನ ಛೀಮಿ ದೇಖಿನ್, “ಅವಾಜ಼್‌ತೊ ಯಾಕೋಬನು ಅವಾಜ಼್ ಹುಯಿರುಸ್, ಹಾತ್ ಏಸಾವನ ಹಾತ್ನಿತರ ಛಾ಼” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />ಯಾಕೋಬನ ಹಾತ್ ಏಸಾವನ ಹಾತ್‍ನಿತ್ರಸ್ ಕೇಖ್ಹಾಳು ಹುಯಿರ‍್ಹುಥೂತೆ ಖ್ಹಾಜೆ ಇಸಾಕ್‍ನೆ ಇನು ಖ್ಹಣೇದ್‍ ಧರ‍್ಯೊಕೊಂತೆ ಇನ ಆಶೀರ್ವಾದ್‍ಕರ‍್ಯೊ. <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />ಇನೆ, “ತೂ ಖ್ಹಾಚಮ ಮಾರೊ ಛಿಯ್ಯೊ ಏಸಾವಕಿಶು” ಕರಿ ಬೋಲಖ್ಹತರ್ ಯಾಕೋಬನೆ, “ಒಹೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 27:24" /><verse number="25" style="v" sid="GEN 27:25" />ಇಸಾಕ್‍ನೆ, “ಯೊ ಬೋಟಿನ ಖನ್ನೆಲೀನ್‍ ಆವ್; ತೂ ಲಾಯೋತೆ ಶಿಕಾರ್‌ನಿ ಬೋಟಿನ ಮೇ ಖೈನ್ ಇನಪಾರ್‌ ತುನ ಆಶೀರ್ವಾದ್‌ ಕರುಸ್” ಕರಿ ಬೊಲ್ಯೊ. ಯಾಕೋಬ್‍ನೆ ಯೊ ಖ್ಹಾರು ಇನ ಖನ್ನೆ ಲೈನ್‌ ದ್ಯಾವಖ್ಹತರ್‌ ಇನೆ ಖಾದೊ; ದ್ರಾಕ್ಷಿನರಖ್ಹ್‌ನ ಪೀದೊ. <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />ಇನಪಾರ್‌ ಇನೊ ಬಾ ಇಸಾಕ್‍ನೆ ಇನ, “ಛಿಯ್ಯಾ, ತೂ ಮಾರ ಖನ್ನೆ ಅಯಿನ್ ಮನ ಬುಚ್ಚಾ಼ದೆ” ಕರಿ ಬೋಲಖ್ಹತರ್ ಇನೆ ಖನ್ನೆ ಅಯಿನ್ ಬಾನ ಬುಚ್ಚಾ಼ದಿದೊ. <verse eid="GEN 27:26" /><verse number="27" style="v" sid="GEN 27:27" />ಇಸಾಕ್‍ನೆ, ಇನ ಲುಂಗ್ಡಾನು ವಾಖ್ಹ್‌ನ ಖ್ಹುಂಗಿದೇಖಿನ್ ಇನ ಆಶೀರ್ವಾದ್‌ಕರೀನ್, “ವ್ಹಾ, ಮಾರ ಛಿಯ್ಯಾನಿ ಮಹಿಕಾವಾನಿ ವಾಖ್ಹ್‌, ಯೆಹೋವನೆ ಆಶೀರ್ವಾದ್ ಕರ‍್ಯೋತೆ ಖೇತರ‍್ನಿ ಮ್ಹೈಕಾವಾನಿ ವಾಖ್ಹ್‌ನಿಘೋಣಿ ಛಾ಼. <verse eid="GEN 27:27" /><verse number="28" style="v" sid="GEN 27:28" />ದೇವ್‌, ತುನ ಆಬ್‌ನು ಬರಪ್‌ನಾಬಿ ಹದಾನಿ ಜ಼ಮೀನ್ನಾಬಿ ದೀನ್‌, ಅನಾಜ಼್‌ಬಿ, ದ್ರಾಕ್ಷಿನ ರಖ್ಹ್‌ನಾಬಿ ಚೆಹೆಳ್‌ಥಿ ದ್ಯವಾದೆ. <verse eid="GEN 27:28" /><verse number="29" style="v" sid="GEN 27:29" />ಅದ್ಮಿಖ್ಹಾರು ತುನ ಆರಾದನೆ ಕರಾದೆ, ಜ಼ಗ್‌ಜಾ಼ತ್‌ಖ್ಹಾರು ತಾರ ಹಾತ್‍ಹೇಟ್ ರ‍್ಯವಾದೆ. ತಾರ ಮೋಟ ನ್ಹಾನಭೈಯೆನ ತೂ ಯಜಮಾನ್ ಹುಯಿರ‍್ಹೆ, ತಾರಿ ಆಯನ ಲಡ್ಕ ತುನ ಆಡ್‌ಪಡಾದೆ. ತುನ ಶಾಪ್ನ ದ್ಯವಾಳನ ಶಾಪ್ನಾಬಿ ತುನ ಆಶೀರ್ವಾದ್‌ ಕರವಾಳಾನ ಆಶೀರ್ವಾದ್‌ಬಿ ಹುವಾದೆ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 27:29" /></para>
  <para style="s">ಇಸಾಕ್‌ಕಿ ಆಶೀರ್ವಾದ್‍ನಖ್ಹಾಜೆ ಏಸಾವನಿ ಬಿಂತಿ</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />ಇಸಾಕ ಇನ ಆಶೀರ್ವಾದ್‌ ಕರಿ ಹುಯಿಜಾ಼ವಾದಿನ್ ಯಾಕೋಬ ಇನ ಬಾಕಂಥೋ ಚ಼ಲೆಜಾ಼ವಾನಿ ವಖ್ಹ್‌ತೇಸ್ ಇನೊ ಮೋಟೊ ಭೈ ಏಸಾವ ಹಲ್ಡೇಥೊ ಆಯೊ. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />ಯೋಬಿ ಅಛ್ಛು಼ ಖಾಣು ಪೀಕೈನ್ ಇನ ಬಾಕನ ಲಯಿನ್ ಇನ, “ಬಾ, ತೂ ಉಠೀನ್ ತಾರೊ ಛಿಯ್ಯೊ ಹುಯಿರ‍್ಹೋತೆ ಮೇ ಲಾಯೋತೆ ಶಿಕಾರ್‌ನಿ ಬೋಟಿನ ಖೈನ್ ಮನ ಆಶೀರ್ವಾದ್‌ ಕರ್‌” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 27:31" /><verse number="32" style="v" sid="GEN 27:32" />ಇನೊ ಬಾ ಇಸಾಕನೆ, “ತು ಕೋಣ್‌?” ಕರಿ ಇನ ಬೋಲಖ್ಹತರ್‌ ಇನೆ, “ಮೇ ತಾರೊ ಫೈಲೊಟೊ ಛಿಯ್ಯೊ ಏಸಾವ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 27:32" /><verse number="33" style="v" sid="GEN 27:33" />ಇನಖ್ಹಾಜೆ ಇಸಾಕನೆ ಘಣೊ ಗಡ್‌ಗಡ್‌ ಕಾಪ್ತೋಹುಯಿನ್, “ಕೋಣ್‌ ಬಿಜೇಕ್‌ ಜ಼ಣು ಶಿಕಾರ್‌ ಕರಿನ್ ಮನ ಖಾಣು ಲಯಿನ್ ದಿದೋತೆ? ತೂ ಆವಾನ ಅಗಾಡಿಸ್ ಇನೆ ಲಾಯೋತೆ ಖಾಣನ ಖೈನ್ ಕಡ್‌ಷಿನಿ ಅಶೀರ್ವಾದ್‌ ಕರಿನಾಖ್ಯೊ; ಇನ ಕರ‍್ಯೊತೆ ಆಶೀರ್ವಾದ್‌ ಛು಼ಕ್‌ಶೆ ಕೊಯ್ನಿ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 27:33" /><verse number="34" style="v" sid="GEN 27:34" />ಏಸಾವ ಇನ ಬಾನಿ ವಾತೆನ ಖ್ಹಮ್‌ಜಿನ್ ದುಖ್‌ನ ಕುಢಾಪೇಥಿ ಘಣು ರೋವ್ತೊಹುಯಿನ್‌, “ಬಾ, ಮಾರೊ ಬಾ, ಮನಾಬಿ ಆಶೀರ್ವಾದ್ ಕರ್‌” ಕರಿ ಗಿಂಗೈಲೇತಾನ ಇಸಾಕನೆ, <verse eid="GEN 27:34" /><verse number="35" style="v" sid="GEN 27:35" />“ತಾರೊ ನ್ಹಾನೊ ಭೈನೆ ತುನ ಹೋಣು ಥೂತೆ ಆಶೀರ್ವಾದ್‌ನ ತಾರೇಥಿ ಠಗೈಲಿ ಚ಼ಲೆಗಯೊ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 27:35" /><verse number="36" style="v" sid="GEN 27:36" />ತದೆ ಏಸಾವನೆ, ಇನಖ್ಹಾಜೇಸ್ ಇನ “ಯಾಕೋಬ ಕರಿ ನಾಮ್‌ ಪಡ್ಯುತೆ ನ್ಯಾವಸ್ನಿ, ಇನೆ ಪಹಿಲೆಸ್ ಬೇ ವಖ್ಹತ್ ಮನ ಠಗೈರಾಖ್ಯೋಸ್, ಅಗ್ಗಳ್ ಇನೆ ಮಾರಾ ಫೈಲೋಟ ಹಕ್‌ನ ಚೋ಼ರ್‌ಕರ‍್ಯೊ; ಹಮ್ಕೆ ಅಯಿನ್ ಮನ ಹೋಣುಥುತೆ ಆಶೀರ್ವಾದ್‌ನಾಬಿ ಛಿನೈಲಿದೊ” ಕರಿ ಬೋಲಿನ್ ಇನ ಬಾನ, “ಮಾರಖ್ಹಾಜೆಕರಿ ತಾರಕನ ಅಶೀರ್ವಾದಸ್ ಕೊಯ್ನಿಕಿಶು?” ಕರಿ ಬೋಲಖ್ಹತರ್‌, <verse eid="GEN 27:36" /><verse number="37" style="v" sid="GEN 27:37" />ಇಸಾಕನೆ ಏಸಾವನ, “ಮಾರ ಛಿಯ್ಯಾ, ಇನ ತಾರೊ ರಾಜ಼ಕರಿ ಬಣೈರಾಖ್ಯೊಸ್; ಇನ ಮೋಟ ನ್ಹಾನಭಯ್ಯೆನ ಆಳ್‌ಬಣೈ ದೀರಾಖ್ಯೊಸ್; ಅನಾಜ಼್‌ಬಿ, ದ್ರಾಕ್ಷಿನೊ ರಖ್ಹ್‌ಬಿ ಇನ ದೀರಾಖ್ಯೊಸ್ ದೇಕ್, ಅಮ್‌ ರ‍್ಹವಾಪರ್‌ ಮೇ ತಾರಖ್ಹಾಜೆ ಶಾತ್‌ಕರು?” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 27:37" /><verse number="38" style="v" sid="GEN 27:38" />ಏಸಾವನೆ ಇನ, “ಬಾ ಮಾರೊ ಬಾ, ತಾರಾಮ ಎಕ್ಕಸ್ ಆಶೀರ್ವಾದ್ ಖಲಿ ಥು? ಬಾ, ಮನಾಬಿ ಆಶೀರ್ವಾದ್ ಕರ್‌” ಕರಿ ಬೋಲಿನ್ ರದ್‌ನ್ಯ ಕರ‍್ಯೊ. <verse eid="GEN 27:38" /><verse number="39" style="v" sid="GEN 27:39" />ತದೆ ಇನೊ ಬಾ ಇಸಾಕ್‍ನೆ ಇನ, “ಹದಾನಿ ಜ಼ಮೀನ್‍ಥೀಬಿ ಆಬ್‍ಥು ಪಡಾತೆ ಓಖ್ಹ್‌ಥಿ ದೂರ್ ತಾರು ಘರ‍್ಹೀಶೆ. <verse eid="GEN 27:39" /><verse number="40" style="v" sid="GEN 27:40" />ತೂ ತಲ್ವಾರ್‌ಥೀಸ್ ಜಿವ್ಣುಕರೀಶ್. ತಾರ ನ್ಹಾನ ಭೈನಿ ಚಾ಼ಕ್ರಿ ಕರಿಶ್. ಕತೋಬಿ ತುನ ಖ್ಹಮಾಳನ ಕೋಹುವಾಂತೆ ವಖ್ಹತ್, ಯೊ ತಾರ ಖಾಂದಪರ್ ಢೊವಾಡ್‍ಶೇತೆ ನೊಗಾನ ತೋಡಿನಾಖಿಷ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 27:40" /><verse number="41" style="v" sid="GEN 27:41" />ಬಾನೆ ಯಾಕೋಬನ ಕರ‍್ಯೊತೆ ಆಶೀರ್ವಾದ್‍ನಖ್ಹಾಜೆ ಏಸಾವನೆ ಯಾಕೋಬ್‍ನ ವಹೇರ್‌ ಕರೀನ್ ಇನ ದಿಲ್‌ಮ, “ಬಾನಖ್ಹಾಜೆ ದುಖ್‍ ಕರಾನಿವಖ್ಹತ್‍ ಖನ್ನೆಅಯ್ಗಿ. ಇಮ್ಮಸ್‌ ಮಾರೊ ನ್ಹಾನೊ ಭೈ ಯಾಕೋಬನ ಮರ್‌ನಾಖಿಶ್” ಕರಿ ಬೋಲಿಲಿದೊ. <verse eid="GEN 27:41" /><verse number="42" style="v" sid="GEN 27:42" />ಮೋಟೊ ಛಿಯ್ಯೊ ಏಸಾವನೆ ಬೋಲ್ಯೊತೆ ವಾತ್ ರೆಬೆಕ್ಕನ ಮಾಲುಮ್‍ ಪಡಾನಿವಖ್ಹ್‌ತೆ ಇನೆ ಇನೊ ನ್ಹಾನೊ ಛಿಯ್ಯೋ ಯಾಕೋಬನ ಬುಲೈನ್ ಇನ, “ದೇಕ್, ತಾರೊ ಮೋಟೊ ಭೈ ಏಸಾವನೆ ತುನಾ ಮಾರಿನ್ ದಾವೊಕಾಡ್ಣು ಕರಿ ಛಾ಼. <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />ಇನಖ್ಹಾಜೆ ಛಿಯ್ಯಾ, ಮಾರಿವಾತ್ನ ಖ್ಹಮಜ಼್; ತೂ ಹಾರಾನ್ಮ ಛಾ಼ತೆ ಮಾರೊ ಭೈ ಲಾಬಾನಕನ ಚ಼ಲ್ಯೋಜಾ಼. <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />ಥೋಡದನ್, ತಾರ ಭೈನೊ ಇರಾದೊ ಟುಟಾಲಗು ಇನಾಕನಸ್ ರ‍್ಹೆ. <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />ತಾರೊ ಭೈ ತೂ ಕರ‍್ಯೊತೆ ಇನ ಭೈಕಿನ್, ಇನೊ ಇರಾದೊ ತೋಡಿಲ್ಯವಾನಿ ವಖ್ಹ್‌ತೆ ಮೇ ತುನ ಹಿಜ್ಜಾ಼ಥಿ ಬುಲೈ ಮಂಗೈಶ್. ಮೇ ಎಕ್ಕಸ್‍ ದನ್ಮ ತುಮುನ ಭೇಜ಼ಣಾನ ಗುಮೈಲೆವ್ ಕಿಮ್?” ಕರಿಬೋಲಿ.<verse eid="GEN 27:45" /></para>
  <para style="s">ಇಸಾಕ್‍ನೆ ಯಾಕೊಬ್‌ನ ಲಾಬಾನಕನ ಮೋಕ್‌ಲ್ಯೊತೆ</para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />ರೆಬೆಕ್ಕನೆ ಇಸಾಕ್‍ನ, “ಹಿತ್ತಿಯವಾಳನಿ ಛೋ಼ಕ್ರಿಯೇಥಿ ಮನ ಖಟು ಹುಯಿರುಸ್. ಯಾಕೋಬಬಿ ಆ ದೇಖ್ಹ್‌ಮ ಛಾ಼ತೆ ಹಿತ್ತಿಯನಿ ತಯೇಡವ್‍ನ ಚೂ಼ಣಿ ವ್ಯಹ ಕರಿಲಿದೋತೊ, ಮೇ ಬಿಜೂ಼ಬಿ ಬಚಿನ್ ಶನೊ ಫಾಯಿದೊ?” ಕರಿ ಬೋಲಿ.<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="s">ಯಕೋಬ್ ಲಾಬಾನ್‌ಕನ ಗಯೋತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />ತದೆ ಇಸಾಕ್‍ನೆ ಯಾಕೋಬನ ಬುಲೈನ್ ಆಶೀರ್ವಾದ್‍ಕರೀನ್ ಇನ ಹುಕುಮ್ ಶಾತ್‍ಕರ‍್ಯೋಕತೊ, “ತೂ ಕಾನಾನ್‌ವಾಳನಿ ಛೋ಼ಕ್ರಿನ ವ್ಯಾಹ ನಾಕರ‍್ನು. <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />ತೂ ಪದ್ದನ್‌ ಅರಾಮ್ಮ ಛಾ಼ತೆ ತಾರೊ ನಾನ ಬೆತೂವೇಲನ ಘರೆ ಚ಼ಲ್ಯೋಜಾ಼. ಹಿಜ಼್ಜ ತಾರೊ ಮಾಮ ಲಾಬಾನನಿ ಛೋ಼ರಿಯೆಮ ಏಕ್‍ಜ಼ಣಿನ ವ್ಯಾಹ ಕರಿಲೆ. <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />ಅಖ್ಖೀಸ್ ಶಕತ್ನೊ ಯೆಹೋವ ದೇವ್ ತುನ ಆಶೀರ್ವಾದ್ ಕರೀನ್ ತುನ ಘಣಿ ಪಿಳ್ಗಿನ ದೀನ್ ತಾರೇಥಿ ಕೈಯೇಕ್ ಜ಼ಗ್‌ಜಾ಼ತ್‌ ಪೈದಹುವಾನಿತರ ವಾರ್ಖ್ಹೋ ದ್ಯವಾದೆ. <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />ದೇವ್ನೆ ಅಬ್ರಹಾಮ್‍ನ ದಿದೋತೆ ಆಶೀರ್ವಾದ್ನ ತುನಾಬಿ, ತಾರಿ ಪಿಳ್ಗಿನಾಬಿ ದ್ಯವಾದೆ, ದೇವ್ ಅಬ್ರಹಾಮ್‌ನ ವಾಗ್ದಾನ್ ಕರ‍್ಯೊತೆ ತಿಮ್ಮಸ್, ತೂ ಹಮ್ಕೆ ವಶೇರೊ ಛಾ಼ತೆ ದೇಖ್ಹ್‌ನ ತೂ ಶೊಂತ್ ಕರಿಲ್ಯವಾನಿತರ ದೇವ್ ಆಶೀರ್ವಾದ್ ಕರೀನ್ ತುನಾಬಿ ತಾರಿ ಪಿಳ್ಗಿನಾಬಿ ದ್ಯವಾದೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />ಇಸಾಕ್‍ ಯಾಕೋಬ್‍ನ ಪದ್ದನ್‌ ಅರಾಮ್‌ನ ಮೋಕ್ಲಾಖ್ಹತರ್‌ ಅರಾಮ್ಯವಾಳೊ ಬೆತೂವೇಲನೊ ಛಿಯ್ಯೊಬಿ ಯಾಕೋಬ ಅಜು಼ ಏಸಾವನಿ ಆಯಾ ರೆಬೆಕ್ಕನೊ ಭೈಬಿ ಹುಯಿರೋತೆ ಲಾಬಾನಕನ ಗಯೊ.<verse eid="GEN 28:5" /></para>
  <para style="s">ಏಸಾವನ ಬಿಜೇಕ್ ಬಾವಣ್</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />ಇಸಾಕನೆ ಯಾಕೋಬನ ಆಶೀರ್ವಾದ್‍ಕರೀನ್ ಪದ್ದನ್‌ ಅರಾಮ್ಮ ಛೋ಼ಕ್ರಿ ಢೂಂಡಿನ್ ವ್ಯಾಹ ಕರಿಲ್ಯವಾನ ಮೋಕ್‌ಲ್ಯೊತೇಬಿ, ಇನೆ ಯಾಕೋಬನ ಆಶೀರ್ವಾದ್ ಕರಾನಿವಖ್ಹ್‌ತೆ ಇನ, ತೂ ಕಾನಾನ್‌ವಾಳನಿ ಛೋ಼ಕ್ರಿನ ನಾಲೇವ್ಣುಕರಿ ಹುಕುಮ್ ದಿದೋತೇಬಿ, ಏಸಾವನೆ ದೇಖ್ಯೊ. <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />ಯಾಕೋಬನೆ ಆಯಾ ಬಾ ಬೋಲನಿತ್ರಸ್ ಮೆಸಪಟೋಮಿಯನ ಗಯೋತೇಬಿ ಏಸಾವನೆ ದೇಖ್ಯೊ. <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />ಕಾನಾನ್‌ವಾಳನಿ ಛೋ಼ಕ್ರಿಯೆ ಇನೊ ಬಾ ಇಸಾಕ್‍ನ ಪಸಂದ್‍ಕೊಯ್ನಿ ಕರೀಬಿ ಮಾಲುಮ್‍ ಕರಿಲಿನ್ ಇನೆ, <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />ಏಸಾವ ಇಷ್ಮಾಯೇಲ್‌ಕನ ಜೈ಼ನ್ ಅಬ್ರಹಾಮ್‌ನೊ ಛಿಯ್ಯೊ ಇಷ್ಮಾಯೇಲ್‌ನಿ ಛೋ಼ರಿ ನೆಬಾಯೋತ್‌ನಿ ಭೇನ್‍ಬಿ ಹುಯಿರೀತೆ ಮಹಲತನ ವ್ಯಾಹ ಕರಿಲಿದೊ.<verse eid="GEN 28:9" /></para>
  <para style="s">ಬೇತೇಲ್‍ಮ ಯಾಕೋಬನು ಖ್ಹೋಣ್ಯು</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />ತದೆ ಯಾಕೋಬ ಹಾರಾನ್ನ ಜಾ಼ವ್ಣುಕರಿ ಬೇರ್ಷೆಬಥೊ ನಿಕ್‍ಳ್ಯೊ. <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />ಯೊ ಚಾ಼ಲ್‍ಕುಚ಼್ ಕರ್ತೊಹುಯಿನ್ ಜಾ಼ತೊರ‍್ಹಾವನಿ ವಖ್ಹ್‌ತೆ ದನ್‍ ಡುಬಿಗೋತೆಖ್ಹಾಜೆ ಯೊ ರಾತ್ ಹಿಜ್ಜಾ಼ಸ್ ರ‍್ಹೀಗೊ. ಇನೆ ಹಿಜ್ಜಾ಼ಥೂತೆ ಬಂಡಾವ್‍ಮ ಎಕ್ ಬಂಡಾನ ಶಿರಾಣೆದೀನ್ ಯೊ ಝ಼ಗೋಮಸ್ ಖ್ಹುಯ್ಗೊ. <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />ಯೊ ರಾತ್ ಇನೆ ಎಕ್ ಖ್ಹೋಣ್ಯು ದೇಖ್ಯೊ. ಯೊ ಖ್ಹೋಣ್ಯಾಮ ಎಕ್ ಏಣಿ ಜ಼ಮೀನ್‌ಪರ್‌ ಭಿಯೂಥು. ಇನಿ ನೋಕ್ ಸೊರ್ಗನ ಚಿಕೈರ‍್ಹೂಥು. ಇನಪರ್ ದೇವ್‍ನು ದೂತಖ್ಹಾರು ಛ಼ಡಾನು ಉತ್ರಾನು ಕರುಕರ್ತೂಥು. <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />ಆ ನಾಹುಯಿನ್ ಯೆಹೋವ ದೇವ್ ಇನಾಪರ್ ಭೀರಿನ್, “ತಾರೊ ನಾನ ಅಬ್ರಹಾಮ್‌ನೊ ದೇವ್‌ಬಿ, ಇಸಾಕ್‍ನೊ ದೇವ್‌ಬಿ ಮೇಸ್. ತೂ ಖ್ಹುತೊಸ್ತೆ ಜ಼ಮೀನ್ನ ತುನಾಬಿ ತಾರಿ ಪಿಳ್ಗಿನಾಬಿ ದೆವುಸ್‌. <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />ತಾರಿ ಪಿಳ್ಗಿ ಜ಼ಮೀನ್‍ಪರ‍್ನು ಕಾಕ್ರಿಯೆತ್ರು ಗಣ್ತಿಕೊಂತೆ ಉಶೆ. ತೂ ಪೂರಬ್, ಪಶ್ಚಿಮ್, ದಕ್ಷಿಣ್, ಉತ್ತರ್ ದಿಕ್‍ಮ ಫೈಲೈಜೈ಼ಶ್. ತಾರೇಥಿಬಿ, ತಾರಿ ಪಿಳ್ಗಿಥೀಬಿ, ಜ಼ಮೀನ್ನು ಖ್ಹಾರೀಸ್‍ ಖೂಮ್‍ವಾಳು ಆಶೀರ್ವಾದ್ ಲೀಲಿಶೆ. <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />ಹಂದೇಕ್, ಮೇ ತಾರಿ ಜೋ಼ಡ್ಮ ರ‍್ಹೀನ್ ತೂ ಕಿಜ಼್ಜ ಗಯೋತೋಬಿ ತುನಾ ಬಚಾ಼ಡಿನ್, ಪಾಛೊ಼ ಆ ದೇಖ್ಹ್‌ಮ ಬುಲೈಲಿನ್ ಅಯಿಶ್‌. ಅಜು ಮೇ ತುನ ಬೋಲ್ಯೋತೆ ವಾಗ್ದಾನ್‌ ಚ಼ಲವ್‌ಕೊಂತೆ ಮ್ಹೇಲಿಶ್‍ಕೊಯ್ನಿ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 28:15" /><verse number="16" style="v" sid="GEN 28:16" />ಯಾಕೋಬನೆ ನಿಂದರ್‌ಮಾಥೊ ಉಠೀನ್, “ಖ್ಹಾಚಾಮ ಯೆಹೋವ ಆ ಝ಼ಗೋಪರ್ ಛಾ಼. ಆ ಮನ ಮಾಲುಮ್ಮಸ್ ಪಡ್ಯುಕೊಯ್ನಿ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />ಯೊ ಡರಿನ್, “ಆ ಝ಼ಗೊ ಪರಿಶುದ್ ಹುಯಿರುಸ್. ಆ ದೇವ್‍ನೂಸ್ ಘರ್‌ಪಣ್ಕಿ ಬಿಜು಼ ಕಾಹೆ, ಆ ಸೊರ್ಗನು ಬಾಕಲ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 28:17" /><verse number="18" style="v" sid="GEN 28:18" />ಯಾಕೋಬ ವ್ಹಾಣೆ ಉಠೀನ್ ಇನೆ ಶಿರಾಣು ದೀರಾಖ್ಯೋಥೋತೆ ಯೊ ಬಂಡಾನ ಪಾಡಿನ್ ಖ್ಹಣೇದ್ನು ಖಂಬು ಕರಿ ಭೀರಾಖಿನ್ ಇನಾಪರ್ ತೇಲ್ನ ನಾಖ್ಯೊ. <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />ಆ ನಾಹುಯಿನ್ ಇನೆ ಲೂಜ಼್ ಕರಿ ನಾಮ್‍ಥೂತೆ ಯೊ ಗಾಮ್ನ ಬೇತೇಲ್‌ ಕರಿ ನಾಮ್‌ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 28:19" /><verse number="20" style="v" sid="GEN 28:20" />ಯಾಕೋಬನೆ ಹಿಜ್ಜಾ಼ ಕಬೂಲೀನ್, “ದೇವ್‍ ಮಾರಿಜೋಡೆ ರ‍್ಹೀನ್ ಮೇ ಜಾ಼ವಾನಿ ಆ ವಾಟ್‍ಮ ಮನ ಬಚಾ಼ಡಿನ್ ಪೇಟ್ನ ಖಾಣುಬಿ, ಫೇರಾನ ಲುಂಗ್ಡೂಬಿ, ಮನ ದೀನ್, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />ಪಾಛು಼ ಫರೀನ್ ಮಾರ ಬಾನ ಘರೆ ಜ಼ತನ್‍ಥಿ ಆವಖ್ಹರ್ಕು ಕರ‍್ಯೋತೊ ಯೆಹೋವಾಸ್ ಮನ ದೇವ್‍ ಹುಯಿರಿಶೆ. <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />ಆ ನಾಹುಯಿನ್ ಮೇ ಖ್ಹಣೇದ್ನು ಖಂಬು ಕರೀನ್‌ ಭೀರಾಖ್ಯೋತೆ ಆ ಬಂಡೊ ದೇವ್ನು ಘರ್‌ ಹುಯಿರಿಶೆ. ತದೆ ತೂ ಮನ ದೀಶ್‍ತೆ ಅಖ್ಖಾಸ್‌ಮಾಥು ದಖ್ಹ್‌ಮಾನು ಏಕ್‍ಭಾಗ್‌ನ ತುನ ಮೇ ದೀಶಸ್‍ ದೀಶ್” ಕರಿ ಹರ‍್ಕೆ ಕರಿಲಿದೊ.<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">ಲಾಬಾನನ ಘರ್ಮ ಯಾಕೋಬ ಆಯೊತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />ತದೆ ಯಾಕೋಬ ಚಾ಼ಲ್‍ಕುಚ಼್‍ಕರಿನ್ ಪೂರಬ್ ದಿಕ್‌ನು ಲೋಗ್‌ನ ತಬರ್ಖಾನ ಆಯೊ. <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />ತದೇಸ್‌ ಇನ ಯೊ ಜ಼ಂಗಳ್‌ಮ ಎಕ್ ಬಾವ್ಡಿನ ದೇಖ್ಯೊ. ಹಿಜ್ಜಾ಼ ಮೇಂಢಾನು ತೀನ್ ಮಂಧುಖ್ಹಾರು ಥು. ಮೇಂಢ ಚ಼ರಾವವಾಳು ಮಂಧಾವ್ನ ಲಯಿನ್ ಯೊ ಬಾವ್ಡಿನು ಪಾಣಿ ಪಿಡಾವ್ತು ಥು. ಯೊ ಬಾವ್ಡಿಪರ್ ಎಕ್ ಮೋಟೊ ಬಂಡೊ ಮ್ಹೇಲೈರೋಥೊ. <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />ಮಂಧುಖ್ಹಾರು ಹಿಜ್ಜಾ಼ ಭರಾವನಿ ವಖ್ಹ್‌ತೆ ಮೇಂಢ ಚ಼ರಾವವಾಳು ಬಾವ್ಡಿಪರ್ ಮೂಚೈ಼ರ‍್ಹೋತೆ ಬಂಡಾನ ಖ್ಹರ್‌ಕೈನ್ ಮೇಂಢಾವ್ನ ಪಾಣಿ ಪಿಡೈನ್ ಪಾಛು಼ ಬಂಡಾನ ಬಾವ್ಡಿಪರ್ ಮೂಚಿನಾಕ್‍ತೂಥು. <verse eid="GEN 29:3" /><verse number="4" style="v" sid="GEN 29:4" />ಯಾಕೋಬನೆ ಇವ್ಣುನ, “ಭೈಯೇವೊ, ತುಮೆ ಕಿಜ್ಜಾ಼ವಾಳ?” ಕರಿ ಬೋಲಖ್ಹತರ್ ಇವ್ಣೆ, “ಹಮೆ ಖಾರಾನ್ ಗಾಮ್‌ವಾಳ” ಕರಿ ಬೋಲ್ಯು. <verse eid="GEN 29:4" /><verse number="5" style="v" sid="GEN 29:5" />ತದೆ ಇನೆ ಇವ್ಣುನ, “ನಾಹೋರನೊ ನಾತ್ಯೊ ಲಾಬಾನ ತುಮುನ ಮಾಲುಮ್‍ಕಿಶೂ?” ಕರಿ ಬೋಲಖ್ಹತರ್, “ಹಮುನ ಯೊ ಮಾಲುಮ್” ಕರಿಬೋಲ್ಯು. <verse eid="GEN 29:5" /><verse number="6" style="v" sid="GEN 29:6" />ಇನೆ ಇವ್ಣುನ, “ಯೊ ಅಛ್ಛೊ ಛಾಕಿಶೂ?” ಕರಿ ಬೋಲನಿವಖ್ಹ್‌ತೆ ಇವ್ಣೆ, “ಅಛ್ಛೋಛಾ. ಹುಜ್ಜಾ ದೇಕ್, ಇನಿ ಛೋರಿ ರಾಹೇಲ್ ಮೇಂಢಾವ್ನಿ ಜೋ಼ಡ್ಮ ಉಳಿಆವಸ್” ಕರಿ ಬೋಲ್ಯು. <verse eid="GEN 29:6" /><verse number="7" style="v" sid="GEN 29:7" />ಯಾಕೋಬನೆ ಇವ್ಣುನ, “ದನ್ ಡುಬಾನ ಬಿಜೂ಼ಬಿ ಘಣಿ ವಖ್ಹತ್ ಛಾ಼, ಮೇಂಢಾವ್ನ ಎಕ್ಟುಕರಾನಿ ವಖ್ಹತ್ ಹುಯಿರ‍್ಹಿಕೊಯ್ನಿ; ಪಾಣಿ ಪಿಡೈನ್ ಶನ ಚರಾವ್ಣುನಾ?” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 29:7" /><verse number="8" style="v" sid="GEN 29:8" />ಮಂಧುಖ್ಹಾರು ಆವಾದಿನ್ ಇವ್ಣೆ ಬಾವ್ಡಿಪರ್ ಮೂಚಿರಾಖ್ಯುಥೂತೆ ಬಂಡಾನ ಕಾಡಿನ್; ಮೇಂಢವ್‌ನ ಪಾಣಿ ಪಿಡೈಯೇಸ್” ಕರಿ ಬೋಲ್ಯು. <verse eid="GEN 29:8" /><verse number="9" style="v" sid="GEN 29:9" />ಯೊ ಇವ್ಣಿಜೋ಼ಡ್ಮ ವಾತ್ ಬೋಲುಕರಾನಿ ವಖ್ಹ್‌ತೇಸ್ ರಾಹೇಲ್ ಇನ ಬಾನ ಮೇಂಢಾವ್ನಿ ಜೋ಼ಡ್ಮ ಆಯಿ; ಯೋಸ್ ಯೊ ಅಖ್ಖಾನ ಚ಼ರಾವ್‍ತೀಥಿ. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />ಯಾಕೋಬನೊ ಮಾಮ ಲಾಬಾನನಿ ಛೋ಼ರಿ ರಾಹೇಲ್‍ನಾಬಿ ಇನ ಮೇಂಢಾವ್‍ನಾಬಿ ದೇಖಾನಿವಖ್ಹ್‌ತೆ ಬಾವ್ಡಿಕನ ಜೈ಼ನ್ ಇನಪರ್ ಮೂಚೈ಼ರ‍್ಹೊಥೋತೆ ಬಂಡಾನ ಧಕೈನ್ ಲಾಬಾನನ ಮೇಂಢಾವ್ನ ಪಾಣಿ ಪಿಡಾಯೊ. <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />ಅಜು಼ ಇನೆ ರಾಹೇಲ್‍ನ ಬುಚ್ಚಾ಼ದೀನ್‌ ಜೋ಼ರೆಖ್ಹು ರೋಯೊ. <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />“ಮೇ ತಾರ ಬಾನೊ ಖಾಂದಾನ್‌ವಾಳೊ ತಾರಿ ರೆಬೆಕ್ಕನೊ ಛಿಯ್ಯೊ ಯಾಕೋಬ” ಕರಿ ಬೊಲ್ಯೊ. ತದೆ ರಾಹೇಲ್ ನಾಶಿಜೈ಼ನ್ ಯೊ ವಾತ್ನ ಇನ ಬಾನ ಖ್ಹಮ್‍ಜಾ಼ಡಿ. <verse eid="GEN 29:12" /><verse number="13" style="v" sid="GEN 29:13" />ಲಾಬಾನ ಇನಿ ಭೇನ್ನೊ ಛಿಯ್ಯೊ ಯಾಕೋಬ ಆಯೋತೆ ವಾತೆ ಖ್ಹಮ್‍ಜಿನ್ ಇನ ಬುಲಾವನ ನಾಶಿಆಯಿನ್ ಬಥೈನ್‌ ಇನ ಘರೆ ಬುಲೈಲೀನ್ ಗಯೊ. ತದೆ ಹಿಜ್ಜಾ಼ ಚಾ಼ಲೀತೆ ಖ್ಹಾರಿವಾತೆನ ಯಾಕೋಬನೆ ಲಬಾನನ ಬೊಲ್ಯೊ. <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />ಲಾಬಾನನೆ ಇನ, “ಖ್ಹಾಚಾಮ ತೂ ಮಾರುಸ್ ಲ್ಹೊಯಿಬಿ ಬೋಟಿ ಹುಯಿರೋಸ್” ಕರಿ ಬೊಲ್ಯೊ. ಏಕ್‍ ಮಹಿನಾಲಗೂಬಿ ಯೊ ಲಾಬಾನಕನ ರ‍್ಹಯೊ.<verse eid="GEN 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 29:15" />ತದೆ ಲಾಬಾನನೆ ಯಾಕೋಬನ, “ತೂ ಮಾರೊ ಸಂಬಂದಿ ಹುಯಿರ‍್ಹೋತೆ ಇನಖ್ಹಾಜೆ ಫುಗಟ್ನಿ ಚಾ಼ಕ್ರಿ ಕರೈಲ್ಯಾವಾನು ಬರೋಬರ್‌ಕೊಯ್ನಿ, ತಾರ ಕಾಮ್‍ನ ಕೆತ್ರ ಪೈಶ ಹೋಣು? ಕರಿ ಪುಛಾ಼ಯೊ. <verse eid="GEN 29:15" /><verse number="16" style="v" sid="GEN 29:16" />ಲಾಬಾನನ ಬೇ ಛೋ಼ರಿಯೇಥಿ; ಮೋಟಿನು ನಾಮ್ ಲೇಯ, ನ್ಹಾನಿನು ನಾಮ್ ರಾಹೇಲ್. <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />ಲೇಯ ಭುಂಬ್ಳಾ ಡೋಳವಾಳಿ ಹುಯಿರ‍್ಹಿಥಿ, ಕತೋಬಿ ರಾಹೇಲ್‍ ರಂಗ್‌ರೂಪ್ಮ ಶನ್‌ಗಾರ್‌ವಾಳಿ ಥಿ. <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />ಯಾಕೋಬನೆ ರಾಹೇಲ್‍ನ ಪ್ಯಾರ್‌ ಕರುಕರ್ತೊಥೊ ಇನಖ್ಹಾಜೆ, “ತಾರಿ ನ್ಹಾನಿ ಛೋ಼ರಿ ರಾಹೇಲ್‍ನ ವ್ಯಾಹ ಕರಾನಖ್ಹಾಜೆ ಖ್ಹಾತ್‍ ವರಖ್ಹ್‌ ಚಾ಼ಕ್ರಿ ಕರುಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 29:18" /><verse number="19" style="v" sid="GEN 29:19" />ಲಾಬಾನನೆ, “ಇನ ಬಿಜೇಕ್ ಜ಼ಣಾನ ದ್ಯಾವಥೀಬಿ ತುನಾಸ್‍ ದ್ಯಾವಾನು ಅಛ಼್ಛು. ಇನಖ್ಹಾಜೆ ತೂ ಮಾರಿ ಜೋ಼ಡ್ಮ ರ‍್ಹೇ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />ಆ ಪರಕ್ಮ ಯಾಕೋಬನೆ ರಾಹೇಲ್‍ನಖ್ಹಾಜೆ ಖ್ಹಾತ್‍ ವರಖ್ಹ್‌ ಚಾ಼ಕ್ರಿ ಕರ‍್ಯೊ. ಇನೆ ರಾಹೇಲ್‍ನ ಘಣು ಪ್ಯಾರ್ ಕರ‍್ಯೊತೆ ಇನಖ್ಹಾಜೆ ಯೊ ಇನ ಥೋಡ ದನ್ನಿತರಸ್ ದೆಖಾಯು. <verse eid="GEN 29:20" /><verse number="21" style="v" sid="GEN 29:21" />ಇನಾಪಾರ್ ಯಾಕೋಬನೆ ಲಾಬಾನನ, “ಮಾರಿ ಚಾ಼ಕ್ರಿನಿ ವಖ್ಹತ್ ಖ್ಹತಮ್ ಹುಯಿಗು. ತಾರಿ ಛೋ಼ರಿನ ಮನ ವ್ಯಾಹ ಕರೀದೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 29:21" /><verse number="22" style="v" sid="GEN 29:22" />ತದೆ ಲಾಬಾನನೆ ಯೊ ಗಾಮ್‌ವಾಳ ಖ್ಹಾರಾಸ್ನ ವ್ಯಹಾನಿ ಇರಂದಿ ಪಿಕಾಯೊ. <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />ಕತೋಬಿ ರಾತ್ನಿ ವೇಳ್ಮ ರಾಹೇಲ್‌ನ ಬದಲ್‌ ಇನಿ ಮೋಟಿ ಛೋ಼ರಿ ಲೇಯನ ಯಾಕೋಬಕನ ಮೋಕ್‌ಲ್ಯೊ. ಇನೆ ಲೇಯನ ಮಳ್ಯೊ. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />ಲಾಬಾನನೆ ಇನಿ ಛೋ಼ರಿ ಲೇಯನ ಜಿಲ್ಪಾ ಕರಿ ಎಕ್ ದಾಸಿನದಿದೊ. <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />ವ್ಹಾಣೆ ದೇಖಾಖ್ಹತರ್‌ ಯೊ ಲೇಯ ಕರಿ ಯಾಕೋಬನ ಮಾಲುಮ್ ಪಡ್‌ತಾನ ಇನೆ ಲಾಬಾನನ, “ತೂ ಮನ ಅಮ್‌ ಶನ ಕರ‍್ಯೊ? ರಾಹೇಲ್‍ನಖ್ಹಾಜೆ ತುನ ಚಾ಼ಕ್ರಿ ಕರ‍್ಯೋನಿ; ಶನಾ ಮನ ಠಗಾಯೋತೆ?” ಕರಿ ಬೊಲ್ಯೊ, <verse eid="GEN 29:25" /><verse number="26" style="v" sid="GEN 29:26" />ಲಾಬಾನನೆ, “ಮೋಟಿ ಛೋ಼ರಿಥಿ ಅಗಾಡಿ ನ್ಹಾನಿ ಛೋ಼ರಿನ ವ್ಯಾಹ ಕರಿದ್ಯಾವಾನು ಹಜ಼್ಜಾನು ಪದತ್ತಿಕಾಹೆ. <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />ಮೋಟಿನಿ ಜೋ಼ಡ್ಮ ವ್ಯಹಾನೊ ಥೋಡ ದನ್‌ಕಾಡ್‌ ಇನಬಾದ್‌ಮ ಮಾರಿ ನ್ಹಾನಿ ಛೋ಼ರಿನಾಬಿ ತುನ ದೆವುಸ್; ಅನಾಖ್ಹಾಜೆ ತೂ ಬಿಜೂ಼ಬಿ ಖ್ಹಾತ್ ವರಖ್ಹ್ ಚಾ಼ಕ್ರಿ ಕರ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 29:27" /><verse number="28" style="v" sid="GEN 29:28" />ಯಾಕೋಬ ಯೊ ವಾತ್ನ ಮಾನೀನ್ ಲೇಯನಿ ಜೋಡ್ಮ ವ್ಯಹಾನ ದನ್ನ ಪೂರಕರ‍್ಯೊ. ತದೆ ಲಾಬಾನನೆ ಇನಿ ನ್ಹಾನಿಛೋ಼ರಿ ರಾಹೇಲ್‍ನ ಯಾಕೋಬನ ವ್ಯಾಹ ಕರಿದಿದೊ. <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />ಲಾಬಾನನೆ ಇನಿ ದಾಸಿ ಬಿಲ್ಹಾನ ಇನಿ ಛೋ಼ರಿ ರಾಹೇಲ್‍ನ ದಾಸಿ ಕರಿದಿದೊ. <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />ಯಾಕೋಬನೆ ರಾಹೇಲ್‍ನ ಮಳಿನ್ ಇನ ಲೇಯಥೀಬಿ ಜಾ಼ಖ್ಹತ್ ಪ್ಯಾರ್‌ ಕರ‍್ಯೊ. ಇನಖ್ಹಾಜೆ ಲಾಬಾನಕನ ಬಿಜೂ಼ಬಿ ಖ್ಹಾತ್ ವರಖ್ಹ್ ಚಾ಼ಕ್ರಿಕರ‍್ಯೊ.<verse eid="GEN 29:30" /></para>
  <para style="s">ಯಾಕೋಬನ ಲಡ್ಕಾ</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />ಅಮ್‌ರ‍್ಹಾವಪರ್ ಲೇಯ ಯಾಕೋಬನ ಪಸಂದ್ ಕೊಯ್ನಿಕರಿ ಯೆಹೋವ ದೇವ್ನ ಮಾಲುಮ್‍ಪಡೀನ್, ಯೊ ಬೇಜೂನಿ ಹುವಾನಿತರ ವಾರ್‌ಖ್ಹೊದಿದೊ; ರಾಹೇಲ್‍ ವಾಂಝ್‌ಣಿ ಹುಯ್‍ರೀಥಿ. <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />ಲೇಯ ಬೇಜೂನಿಹುಯಿನ್‌ ಪರ್ಖ್ಹೊ ಲಡ್ಕು ಜ಼ಣೀನ್, “ಯೆಹೋವನೆ ಮಾರಿ ಹಾಲತ್‍ನ ದೇಖ್ಯೊ, ಅನಾಪಾರ್ ಮಾರೊ ಬಾವ್ರಿ ಮನ ಪ್ಯಾರ್‌ ಕರ್ಶೆ. ಕರಿ ಬೋಲಿನ್ ಇನ <note caller="+" style="f"><char style="fr" closed="false">29:32 </char><char style="ft" closed="false">ಹಿಬ್ರು ವಾತೇಮ, ದೇಕ್‌ ಏಕ್‌ ಛಿಯ್ಯೊ ಮಾರಿ ದುಖ್‌ನ ದೇಖ್ಯೊ</char></note>‘ರೂಬೇನ್’ ಕರಿ ನಾಮ್‌ಮ್ಹೇಲಿ” <verse eid="GEN 29:32" /><verse number="33" style="v" sid="GEN 29:33" />ಯೊ ಪಾಛಿ ಬೇಜೂನಿ ಹುಯಿನ್‌ ಪರ್ಖ್ಹೋ ಲಡ್ಕು ಜ಼ಣಿ, “ಮೇ ಬಾವ್ರಿನ ಪಸಂದ್ ಕೋಹುಯ್ನಿಕರಿ, ಯೆಹೋವನೆ ಮಾಲುಮ್‍ ಕರಿನ್‌ ಆ ಲಡ್ಕಾನ ದಿದೊಕರಿ ಇನ ‘ಸಿಮೆಯೋನ್‌’ ಕರಿ ನಾಮ್‌ಮ್ಹೇಲಿ” <verse eid="GEN 29:33" /><verse number="34" style="v" sid="GEN 29:34" />ಯೊ ಪಾಛಿ ಬೇಜೂನಿ ಹುಯಿನ್‌ ಪರ್ಖ್ಹೊಲಡ್ಕು ಜ಼ಣೀನ್, “ಹಮ್ಕೆತೋಬಿ ಮಾರೊ ಬಾವ್ರಿಬಿ ಮೇಬಿ ಎಕ್ಟ ರ‍್ಹಿಶು, ಇನ ತೀನ್‍ ಪರ್ಖ್ಹಾ ಲಡ್ಕಾವ್ನ ಜ಼ಣಿ ದಿರಾಖಿಸ್ನಿ” ಕರಿ ಬೋಲಿನ್ ಇನ “ಲೇವಿ” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲಿ. <verse eid="GEN 29:34" /><verse number="35" style="v" sid="GEN 29:35" />ಯೊ ಬಿಜೂಪಾಛಿ ಬೇಜೂನಿ ಹುಯಿನ್‌ ಪರ್ಖ್ಹೊಲಡ್ಕು ಜ಼ಣೀನ್, “ಹಮ್ಕೆ ಮೇ ಯೆಹೋವನ ಸ್ತುತಿಕರುಸ್” ಕರಿ ಬೋಲಿನ್ ಇನ “ಯೆಹೂದ” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲಿ. ಇನಾಪಾರ್‌ ಲೇಯನ ಲಡ್ಕಹುವಾನು ಭೀರಿಗಯು.<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />ರಾಹೇಲ್‍ ಯಾಕೋಬಥಿ ಲಡ್ಕ ಜ಼ಣಿಕೊಂತೆ ಇನಾಖ್ಹಾಜೆ ಇನಿ ಮೋಟಿ ಭೇನ್‌ಪರ್ ಪೇಟ್ನೊಬಳಾಪೊಕರಿ. ಅತ್ರೇಸ್ ಕಾಹೆತೆ ಯಾಕೋಬನ, “ಮನ ಲಡ್ಕದೇ, ನಾಹುಯುತೊ ಮರಿಜೈ಼ಶ್” ಕರಿ ಬೋಲಿ. <verse eid="GEN 30:1" /><verse number="2" style="v" sid="GEN 30:2" />ಯಾಕೋಬ ರಾಹೇಲ್‍ಪರ್ ಇರಾದೊ ಕರೀನ್, “ಮೇ ಶಾತ್‌ ದೇವ್‍ಕಿ ಶು? ಯೋಸ್ ಕಾಹೇಕಿಶೂ ತುನ ಲಡ್ಕದಿದೊ ಕೊಂತೆ?” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 30:2" /><verse number="3" style="v" sid="GEN 30:3" />ಇನಖ್ಹಾಜೆ ರಾಹೇಲ್‍ನೆ, “ಮಾರಿ ದಾಸಿಹುಯಿರೀತೆ ಬಿಲ್ಹಾ ಛಾ಼ನಿ, ಇನಾಕನ ತೂ ಖ್ಹೂ, ಯೊ ಬೇಜೂನಿ ಹುಯಿತೊ ಯೊ ಲಡ್ಕಾನ ಮಾರ ಖೋಳಾಮ ನಾಖಾದೆ. ತದೆ ಇನೇಥಿ ಮನಾಬಿ ಪಿಳ್ಗಿಉಶೆ” ಕರಿ ಬೋಲಿನ್‌, <verse eid="GEN 30:3" /><verse number="4" style="v" sid="GEN 30:4" />ಇನಿ ದಾಸಿಹುಯಿರೀತೆ ಬಿಲ್ಹಾನ ಯಾಕೋಬನ ದಿನಾಖಿ. ಯಾಕೋಬ ಇನ ಮಳ್ಯೊ. <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />ಬಿಲ್ಹಾ ಬೇಜೂನಿಹುಯಿನ್‌ ಪರ್ಖ್ಹೋ ಲಡ್ಕು ಜ಼ಣಿ. <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />ತದೆ ರಾಹೇಲ್‍ನೆ, “ದೇವ್‍ ಮಾರಭಣಿ ನ್ಯಾವ್ ಕರಿರಾಖ್ಯೋಸ್, ಯೊ ಮಾರಿ ಬಿಂತಿನ ಖ್ಹಮ್‌ಜಿನ್ ಮನ ಛಿಯ್ಯಾನ ದೀರಾಖ್ಯೋಸ್” ಕರಿ ಇನ <note caller="+" style="f"><char style="fr" closed="false">30:6 </char><char style="ft" closed="false">ಹಿಬ್ರು ವಾತೆಮ ದನ್‌ಕತೊ, ಮಾರಭಣಿಥು ನ್ಯಾವ್‌ಹುಯಿರ‍್ಹೋಸ್ ಕರಿ</char></note>“ದಾನ್‌” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲಿ. <verse eid="GEN 30:6" /><verse number="7" style="v" sid="GEN 30:7" />ರಾಹೇಲ್‌ನಿ ದಾಸಿ ಬಿಲ್ಹಾನೆ ಪಾಛಿ ಬೇಜೂನಿಹುಯಿನ್‌ ಯಾಕೋಬನ ಬೇನೊ ಛಿಯ್ಯೊ ಜ಼ಣಿ. <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />ತದೆ ರಾಹೇಲ್‍ನೆ, “ಮಾರಿ ಮೋಟಿ ಭೇನ್ನಜೋ಼ಡ್ಮ ಘಣೇಥಿ ಹೊಜ಼್ಜತ್‌ಕರಿನ್‌ ಜೂತಿರ‍್ಹೀಸ್‍” ಕರಿ ಇನ, “ನಫ್ತಾಲಿ” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲಿ. <verse eid="GEN 30:8" /><verse number="9" style="v" sid="GEN 30:9" />ಲೇಯ ಇನ ಜ಼ಣತ್‍ ಬಂದ್‍ಹುಯ್ಗುತೆ ಮಾಲುಮ್ ಕರ್ಲಿನ್‌ ಇನಿ ದಾಸಿ ಜಿಲ್ಪನ ಯಾಕೋಬನಿ ಬಾವಣ್‍ ಹುವಾನಖ್ಹಾಜೆ ದಿನಾಖಿ. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />ಲೇಯನಿ ದಾಸಿ ಜಿಲ್ಪನೆ ಯಾಕೋಬನ ಪರ್ಖ್ಹೊ ಲಡ್ಕು ಜ಼ಣಿ. <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />ಲೇಯನೆ, “ಮನ ಅಛ಼್ಛು ಹುಯು” ಕರಿ ಬೋಲಿನ್ ಇನ “ಗಾದ್” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲಿ. <verse eid="GEN 30:11" /><verse number="12" style="v" sid="GEN 30:12" />ಲೇಯನಿ ದಾಸಿ ಜಿಲ್ಪನೆ ಯಾಕೋಬಥಿ ಬೇನು ಪರ್ಖ್ಹೊಲಡ್ಕು ಜ಼ಣಿ <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />ತದೆ ಲೇಯನೆ, “ಮೇ ಧನ್ಯಹುಯಿ, ತಯೇಡವ್‍ಖ್ಹಾರು ಮನ ಧನ್ಯ ಕರಿ ಖ್ಹರಾವ್‌ಶೆ” ಕರಿ ಇನ “ಆಶೇರ್” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲಿ. <verse eid="GEN 30:13" /><verse number="14" style="v" sid="GEN 30:14" />ಘವ್‍ನೊ ಖ್ಹುಗ್ಗೀನ ಹಗಾಮ್ಮ ರೂಬೇನ್ ಝಾ಼ಡಿಮ ಜೈ಼ರ‍್ಹಾವಾನಿವಖ್ಹ್‌ತೆ ಹೋಶ್‌ನ ಫಲ್‍ನ ದೇಖಿನ್ ಇನಿ ಆಯಾ ಲೇಯನ ಲಯಿನ್ ದಿದೊ, ಇನ ದೇಖಿನ್ ರಾಹೇಲ್‍ನೆ, “ತಾರೊ ಛಿಯ್ಯೊ ಲಾಯಿರಾಖ್ಯೋತೆ ಹೋಶ್‌ನ ಫಲ್‍ಮ ಥೋಡು ಮನಾಬಿ ದೇ” ಕರಿ ಗಿಂಗೈಲಿದಿ. <verse eid="GEN 30:14" /><verse number="15" style="v" sid="GEN 30:15" />ಇನ, ಲೇಯನೆ, “ತೂ ಮಾರ ಬಾವ್ರಿನ ಮಾಂಗಿಲಿದಿತೆ ಬಶ್‌ಕೊಯ್ನಿ? ಮಾರೊ ಛಿಯ್ಯೊ ಲಾಯೋತೆ <note caller="+" style="f"><char style="fr" closed="false">30:15 </char><char style="ft" closed="false">ತಯೇಡಾನ ಲಡ್ಕಹುವಾನುಬಿ ಪರ್ಖ್ಹಾನ ಶಕತ್ ಆವಾನು ಪಂಡು </char></note>ಹೋಶ್‌ನ ಫಲ್‍ನಾಬಿ ಮಾಂಗಿಲೇವ್ಣುಕರಿ ಆಖ್ಹ್‌ಕರಸ್‍ಕಿಶೂ?” ಕರಿ ಬೋಲ್‍ತಾನ ರಾಹೇಲ್‍ನೆ, “ಅಛ಼್ಛುಸ್‌, ತೂ ತಾರೊ ಛಿಯ್ಯೊ ಲಾಯೋತೆ ಫಲ್‍ನ ಮನ ದಿದೀತೊ ಮಾರ ಬಾವ್ರಿನ ಆ ರಾತ್ ತಾರಕನಾಸ್‍ ರಾಖೀಲೆ” ಕರಿ ಬೋಲಿ. <verse eid="GEN 30:15" /><verse number="16" style="v" sid="GEN 30:16" />ಖ್ಹಾಂಜ಼್‌ನೊ ಯಾಕೋಬ ಝಾ಼ಡಿಥೊ ಆವಾನಿ ವಖ್ಹ್‌ತೆ ಲೇಯ ಇನ ಖ್ಹಾಮ್ಣೆಜೈ಼ನ್, “ತೂ ಮಾರಾಕನ ಖ್ಹೂಣು, ಮೇ ಮಾರೊ ಛಿಯ್ಯೊ ಲಾಯೊತೆ ಹೋಶ್‌ನು ಫಲ್‍ಖ್ಹಾರು ದೀನ್ ತುನ ಕಮೈರಾಖಿಸ್” ಕರಿ ಬೋಲಿ. ಯೊ ರಾತ್ ಯಾಕೋಬ ಇನಿ ಜೋ಼ಡ್ಮಮಳ್ಯೊ. <verse eid="GEN 30:16" /><verse number="17" style="v" sid="GEN 30:17" />ದೇವ್ನೆ ಲೇಯನಿ ಪ್ರಾರ್ಥನೆನ ಖ್ಹಮ್‍ಜ್ಯೊ. ಯೊ ಬೇಜೂನಿ ಹುಯಿನ್ ಯಾಕೋಬನ ಪಾಚ಼್‍ನು ಪರ್ಖ್ಹೊಲಡ್ಕು ಜ಼ಣಿ. <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />ಲೇಯನೆ, “ಮಾರಿ ದಾಸಿನ ಮೇ, ಮಾರ ಬಾವ್ರಿಕನ ದಿನಾಖಿತೆ ಇನಖ್ಹಾಜೆ ದೇವ್‍ಥಿ ಮನ ಇನಾಮ್‌ ಮಳ್ಯು” ಕರಿ ಯೊ ಲಡ್ಕಾನ “ಇಸ್ಸಾಕಾರ್” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲಿ. <verse eid="GEN 30:18" /><verse number="19" style="v" sid="GEN 30:19" />ಲೇಯನೆ ಪಾಛು಼ ಬೇಜೂನಿ ಹುಯಿನ್ ಯಾಕೋಬನ ಛೋ಼ನು ಪರ್ಖ್ಹೊಲಡ್ಕು ಜ಼ಣಿ. <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />ಲೇಯನೆ, “ದೇವ್ ಮನ ಅಛ಼್ಛು ಇನಾಮ್ ದೀರಾಖ್ಯೋಸ್. ಮೇ ಮಾರೊ ಬಾವ್ರಿನ ಛೋ಼ಜ಼ಣ ಪರ್ಖ್ಹಾ ಲಡ್ಕಾವ್ನ ಜ಼ಣಿತೆ ಇನಖ್ಹಾಜೆ ಯೊ ಮಾರಿಜೋ಼ಡ್ಮಾಸ್ ಜಿವ್ಣು ಕರ್‌ಶೆ” ಕರಿ ಬೋಲಿನ್ ಯೊ ಲಡ್ಕಾನ “ಜೆಬುಲೂನ್” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲಿ. <verse eid="GEN 30:20" /><verse number="21" style="v" sid="GEN 30:21" />ಇನಾಪಾರ್ ಇನೆ ತಯೇಡ ಲಡ್ಕಾನ ಜ಼ಣೀನ್ ಇನ, “ದೀನಾ” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲಿ. <verse eid="GEN 30:21" /><verse number="22" style="v" sid="GEN 30:22" />ಅನಾಪಾರ್ ದೇವ್ನೆ ರಾಹೇಲ್‍ನ ಯಾದ್‌ಕರಿಲಿನ್ ಇನಿ ಬಿಂತಿನ ಖ್ಹಮ್‍ಜಿನ್ ಇನ ಲಡ್ಕ ಹುವಾನಿತರ ಕರ‍್ಯೊ. <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />ಯೊ ಬೇಜೂನಿ ಹುಯಿನ್ ಪರ್ಖ್ಹೊ ಲಡ್ಕು ಜ಼ಣಿನ್, “ದೇವ್ನೆ ಮನಥೂತೆ ಖ್ಹರಮ್‌ನ ಪರಿಹಾರ್‌ ಕರ‍್ಯೊ” ಕರಿ ಬೋಲಿ. <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />ಆನಾಹುಯಿನ್ ಇನೆ, “ಯೆಹೋವ ಮನ ಬಿಜೇಕ್ ಪರ್ಖ್ಹೊಲಡ್ಕು ದಿಶೆ” ಕರಿ ಬೋಲಿನ್ ಇನ, “ಯೋಸೇಫ್” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲಿ.<verse eid="GEN 30:24" /></para>
  <para style="s">ಲಾಬಾನಕಂಥು ಯಾಕೋಬನೆ ಠಗಾಯೊತೆ</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />ರಾಹೇಲ್‍ನೆ ಯೋಸೇಫನ ಜ಼ಣೀತೆ ಇನವಾರ್ ಯಾಕೋಬನೆ ಲಾಬಾನನ, “ಮೇ ಮಾರ ದೇಖ್ಹ್‌ಮ ಛಾ಼ತೆ ಶೊಂತ್‍ ಝ಼ಗೊನ ಜಾ಼ವನ ಮನ ಹುಕುಮ್‍ದೆ. <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />ಮೇ ಚಾ಼ಕ್ರಿ ಕರೀನ್ ಲೀಲಿದೋತೆ ಬಾವ್ಣೆನಾಬಿ ಮಾರ ಲಡ್ಕಾವ್‍ನಾಬಿ ಮಾರಿ ಜೋ಼ಡ್ಮ ಮೋಕಲ್ನು. ಮೇ ತುನ ಕರ‍್ಯೊತೆ ಚ಼ಾಕ್ರಿ ತುನ ಮಲುಮ್‌ಛಾ಼” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 30:26" /><verse number="27" style="v" sid="GEN 30:27" />ಲಾಬಾನನೆ ಇನ, “ಮಾರಪರ್ ಗೋರ್‌ಕರೀನ್ ಹಜ಼್ಜಾಸ್ ರ‍್ಹೆ. ಯೆಹೋವನೆ ತಾರಖ್ಹಾಜೇಥಿ ಮನ ಆಶೀರ್ವಾದ್‌ ಕರಿರಾಖ್ಯೋಸ್ ಕರಿ ಅಛ್ಛಿನಿತರ ಮಾಲುಮ್‍ ಕರಿರಾಖ್ಯೋಸ್. <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />ಮೇ ತುನ ಶಾತ್ ಶಂಬ್‌ಳ ದೇವ್ಣು ಬೋಲ್ ದೆವುಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 30:28" /><verse number="29" style="v" sid="GEN 30:29" />ಇನ ಯಾಕೋಬನೆ, “ಮೇ ತುನ ಕರ‍್ಯೊತೆ ಚಾ಼ಕ್ರಿನಾಬಿ ಮಾರ ಕಬ್‌ಜಾ಼ಮ ಥೂತೆ ತಾರು ಜೀನ್‌ಜಿನಾವರ್ ಖ್ಹಾರು ಭಡ್ತುಗಯೂತೇಬಿ ತುನ ಮಾಲುಮ್. <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />ಮೇ ಆವಾನ ಅಗಾಡಿ ತುನ ಥೂತೆ ಥೋಡುಸ್. ಹಮ್ಕೆ ಯೊ ಘಣುಜಾ಼ಖ್ಹತ್‌ ಹುಯಿರ‍್ಹುಸ್. ಮೇ ಹಾತ್‌ಘಾಲುತೆ ಖ್ಹಾರಾಸ್‍ಕಾಮ್ಮಾಬಿ ಯೆಹೋವನೆ ತುನ ಆಶೀರ್ವಾದ್‌ರಾಖ್ಯೋಸ್. ಕತೋಬಿ ಮೇ ಮಾರ ಶೊಂತ್ ಘರ‍್ನಾಖ್ಹಾಜೆ ಕದೆ ಕಮೈಲೀಶ್?” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 30:30" /><verse number="31" style="v" sid="GEN 30:31" />ಇನ, ಲಾಬಾನನೆ, “ತುನ ಮೇ ಶಾತ್ ದೆವ್ಣು ಬೋಲ್” ಕರಿ ಬೋಲಖ್ಹತರ್ ಯಾಕೋಬನೆ, “ಮನ ಶಾತ್‌ಬಿ ನಕೋದೆ, ತೂ ಮನ ಆ ಎಕ್ ಕಾಮ್ ಖಲಿ ಕರ‍್ಯೋತೊ ಬಶ್, ಮೇ ಪಾಛೊ಼ ತಾರ ಮಂಧಾನ ಚ಼ರೈನ್ ಕಾವಲ್ ಕರುಸ್” <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />ಯೊ ಶಾತ್‌ಕತೊ, “ಹಮ್ಕೆ ಮೇ ತಾರ ಮಂಧಾಮ ಜೈ಼ನ್, ಮೇಂಢಾವ್‌ಮ ಟಿಪ್‌ಕ್ಯು ಅಜು಼ ಮಚ್ಚೊ಼ರ‍್ಹಾವಾಳನಾಬಿ, ಕಾಳುರ‍್ಹಾವಳುಬಿ, ಬೋಕ್ಡಾವ್‍ಮ ಟಿಪ್‌ಕ್ಯು ಅಜು ಮಚ಼್ಚೊರ‍್ಹವಾಳನ, ಅಲಕ್‍ ಕರುಸ್. ಯೋಸ್ ಮಾರು ಶಂಬ್‌ಳ ಹುಯಿರ‍್ಹಾವದೆ. <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />ಅಮ್‌ರ‍್ಹಯುತೊ ಆವ್‌ಶೇತೆ ಹಗಾಮ್ಮ ಮಾರಿ ಶಂಬ್‌ಳನಖ್ಹಾಜೆ ಮೇ ತಾರಕನ ಆವಾನಿ ವಖ್ಹ್‌ತೆ ಮಾರೊಖ್ಹಾಚೊ಼ ದಿಲ್ಲಸ್ ಮನ ಸಾಕ್ಷಿದಿಶೆ. ಬೋಕ್ಡಾವ್‍ಮ ಟಿಪ್‌ಕ್ಯು ಕೊಂತೊ ಮಚ಼್ಚೊ ನಾರ‍್ಹವಾಳು, ಮೇಂಢಾವ್‌ಮ ಕಾಳು ನಾರ‍್ಹವಾಳು, ಮಾರಕನ ಮಳ್ಯುತೊ ಇನ ಚೋ಼ರಿ ಕರ‍್ಯುಹುಯುಕರಿ ಬೋಲೆಜಾ಼ಯ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 30:33" /><verse number="34" style="v" sid="GEN 30:34" />ತದೆ ಲಾಬಾನನೆ, “ಅಛ಼್ಛೂಸ್, ತೂ ಬೋಲ್ಯೊತೆ ಇಮ್ಮಸ್ ಹುವಾದೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />ಯೋಸ್ ದನ್ ಲಾಬಾನನೆ ಬೋಕ್ಡಾವ್‍ಮ ಬರಾಕ್ ಅಜು಼ ಮಚ್ಚೊ಼ರ‍್ಹಾವಾಳುಬೀ, ಬೋಕ್ಡಿಯೇಮ ಟಿಪ್‌ಕ್ಯು ಮಚ್ಚೊ಼ರ‍್ಹಾಳನಾಬಿ, ಕತೊ ಜ಼ರ ಧೋಳುರಂಗ್ ದೆಖಾವತೆ ಆಖ್ಖಾಸ್‍ನಾಬಿ, ಮೇಂಢಾವ್‌ಮ ಕಾಳುರ‍್ಹಾವಳನಾಬಿ ಅಲಕ್ ಕರೀನ್ ಇನ ಲಡ್ಕಾವ್ನ ದಿನಾಖ್ಯೊ. <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />ಲಾಬಾನನೆ ಇನಾಬಿ, ಯಾಕೋಬನಾಬಿ ತೀನ್ ದನ್ನು ಚಾಲ್‌ಕುಚ಼್ ಕರಾಯೆತ್ರೆ ಅಂತರ್‌ ದೂರ್ ಮ್ಹೇಲ್ಯೊ. ಯಾಕೋಬನೆ ಲಾಬಾನನು ಮಂಧಾಮ ಉಭ್‌ರ‍್ಯಾಹುಯಾನ ಚ಼ರಾಯೊ. <verse eid="GEN 30:36" /><verse number="37" style="v" sid="GEN 30:37" />ಅಮ್‍ರ್ಹಾವಪರ್ ಯಾಕೋಬನೆ ಚಿನಾರು, ಬಾದಾಮ್‌, ಅರ್ಮೋನ್ ಕರಿ ಝಾ಼ಡವ್‍ನು ಕಚ್ಚಾ಼ ಲಠ್ಠಾವ್ನ ಲಯಿನ್ ಲಾಂಬೆ ಲಾಂಬೇಥಿ ಛ಼ಾಲ್ನ ಛೀಲ್ಯೊ. <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />ಇನಾಮನು ಧೋಳು ರಂಗ್ ದೆಖಾವನಿತರ ಕರ‍್ಯೊ. ಯೊ ಲಠ್ಠಾವ್ನ ಬೋಕ್ಡಮೇಂಢಾವ್ನು ಮಂಧಾ ಪಾಣಿ ಪೀಯಾನು ಟೊಟ್ಟಿಯೇಮ ಮ್ಹೇಲ್ಯೊ. ಬೋಕ್ಡಮೇಂಢ ಪಾಣಿ ಪಿಯಾನಿ ವಖ್ಹ್‌ತೇಸ್, ಮಳ್‌ತುಥು. <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />ಬೋಕ್ಡ ಮೇಂಢ ಯೊ ಲಠ್ಠಾವ್ನ ದೇಖಿನ್ ಏಕ್‌ಥಿಏಕ್ ಮಳ್ವಾತೆ ಇನಖ್ಹಾಜೆ ಬರಾಕೆ, ಟಿಪ್‌ಕ್ಯು, ಮಚ್ಚೊ಼ರ‍್ಹಾವಳು ಚೆಲ್ಕಾವ್ನ ಜ಼ಣ್‌ತುಥು. <verse eid="GEN 30:39" /><verse number="40" style="v" sid="GEN 30:40" />ಯಾಕೋಬ ಯೊ ಚೆಲ್ಕಾವ್ನ ಲಾಬಾನನ ಮಂಧಾವ್‌ಮ ಮಳಾಯೊಕೊಂತೆ ಮಾರು ಕರಿ ಅಲಕ್ ಕರಿಲಿದೊ. ಅಜು಼ ಲಾಬಾನನು ಬೋಕ್ಡ ಮೇಂಢಾವ್ನು ಮ್ಹೋಡು ಬರಾಕೆರ‍್ಹಾವಳು ಯೊ ಬೋಕ್ಡಾವ್‍ನು ಅಜು಼ ಕಾಳು ಮೇಂಢಾವ್‌ ಭಣಿ ಫರಾಯೊ. <verse eid="GEN 30:40" /><verse number="41" style="v" sid="GEN 30:41" />ಆನಾಹುಯಿನ್‌ ಘಣು ತಾಖತ್‌ನು ಬೋಕ್ಡು ಮೇಂಢು ಮಳ್ವಾನಿ ವಖ್ಹ್‌ತೆ ಯೊ ಲಠ್ಠಾವ್‍ನ ದೇಖಿನ್ ಮಳ್ವಾದೆ ಕರಿ ಯಾಕೋಬನೆ ಲಠ್ಠಾವ್‍ನ ಟೊಟ್ಟಿಯೇಮ ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />ಕತೋಬಿ ಬೋಕ್ಡ ಮೇಂಢ ಕಮ್‍ಜೋ಼ರಿ ರ‍್ಹವಾನಿವಖ್ಹ್‌ತೆ ಯೊ ಲಠ್ಠಾವ್ನ ಟೊಟ್ಟಿಯೇಮ ಮ್ಹೇಲ್ತೊಥೊಕೊಯ್ನಿ. ಅಮ್ನಿ ಪರಕ್ಮ ಕಮ್‍ಜೋ಼ರಿನು ಮಂಧು ಲಾಬಾನನು ಪಾಲ್‍ಹುಯು. ತಾಖತ್‍ರ‍್ಹಾವಳು ಯಾಕೋಬನು ಪಾಲ್ನ ಆಯು. <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />ಆ ಪರಕ್ಮ ಯಾಕೋಬನೆ ಘಣು ಧನ್‍ದೌಲತ್ತಿ ಬಣ್ಯೊ ಇನ ಮೇಂಢಾವ್ನು ಮಂಧು, ಚಾ಼ಕ್ರಿಕರಾವಾಳು. ಊಟ್, ಗಧೇಡು, ಜಾ಼ಖ್ಹತ್‌ಥು.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s">ಲಾಬಾನ್‌ಥಿ ಯಕೋಬ್ ಮಿಲೈಗಯೊತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />“ಅಪ್ಣ ಬಾನಿ ಶೊತ್‌ಖ್ಹಾರು ಯಾಕೋಬನು ಪಾಲ್‍ಹುಯ್ಗು, ಅಪ್ಣಬಾನಿ ಶೊತ್‍ಥೀಸ್ ಇನ ಅತ್ರೂ ಧನ್‍ದೌಲತ್ ಮಳ್ಯು” ಕರಿ ಲಾಬಾನನ ಛಿಯ್ಯಾವ್‌ನೆ ಬೋಲ್ಯುತೆ ಯಾಕೋಬನೆ ಖ್ಹಮ್‌ಜ್ಯೊ. <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />ಆನಾಹುಯಿನ್‌, ಯಾಕೋಬನೆ ಲಾಬಾನನು ಮ್ಹೋಡಾನು ಛೇರೊದೇಕ್ತಾನ ಇನು ಮ್ಹೋಡು ಅಗಾಡಿನಿತರ ದೆಖಾಯುಕೊಯ್ನಿ. <verse eid="GEN 31:2" /><verse number="3" style="v" sid="GEN 31:3" />ಅಜು಼ ಯೆಹೋವನೆ ಯಾಕೋಬನ, “ತೂ ತಾರ ಬಾನ ದೇಖ್ಹ್‌ನಾಬಿ ತಾರ ಮಾಯಮಾತ್ರಕನಬಿ ಪಾಛೊ಼ ಫರಿನ್‌ ಜಾ಼, ಮೇ ತಾರಿ ಜೋ಼ಡ್ಮ ರ‍್ಹೆವುಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 31:3" /><verse number="4" style="v" sid="GEN 31:4" />ಅನಖ್ಹಾಜೆ ಯಾಕೋಬನೆ ರಾಹೇಲ್‍ನಾಬಿ, ಲೇಯನಾಬಿ, ಇನು ಬೋಕ್ಡ ಮೇಂಢಾನು ಮಂಧಾನ ಚ಼ರವ್‍ ಕರ್ತೋಥೋತೆ ಝಾ಼ಡಿನ ಬುಲೈಮಂಗಾಯೊ. <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />ಹಿಜ಼್ಜಾ ಇವ್ಣುನ, “ತುಮಾರ ಬಾನ ಮ್ಹೋಡಾನು ಛೇರೊ ಮಾರಿ ಬಾರೇಮ ಅಗಾಡಿ ಥೂತೆ ಇಮ್‌ಕೊಯ್ನಿ ಕರಿ ದೆಖಾಯು. ಕತೋಬಿ ಮಾರ ಬಾನು ದೇವ್ ಮಾರಿ ಜೋ಼ಡ್ಮ ಛಾ಼. <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />ಮೇ ತುಮಾರ ಬಾನಿ ಚಾ಼ಕ್ರಿ ಪೂರ ಶಕಥ್ಥಿ ಕರಿರಾಖ್ಯೋಸ್, ತುಮುನಾಬಿ ಯೊ ಮಾಲುಮ್‍ಛಾ಼. <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />ಕತೋಬಿ ತುಮಾರೊ ಬಾ ಮನ ಠಗೈನ್ ಮಾರಿ ಶಂಬ್ಳಾನ ದಖ್ಹ್‌ವಖ್ಹತ್ ಬದ್ಲಾಯೊ. ಮನ ಲುಕ್ಷಾನ್ ಕರಾನ ದೇವ್‌ನೆ ಇನ ಮ್ಹೆಲ್ಯೊಕೊಯ್ನಿ. <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />ತುಮಾರೊ ಬಾ ಮನ ‘ಟಿಪ್‌ಕ್ಯುರ‍್ಹಾವಾಳು ತಾರಿ ಶಂಬ್‌ಳ ಹುಯಿರ‍್ಹಾವದೆ’ ಕರಿ ಯೊ ಬೋಲಾನಿವಖ್ಹ್‌ತೆ ಮಂಧಾಮನು ಬೋಕ್ಡು ಮೇಂಢುಖ್ಹಾರುಬಿ ಟಿಪ್‌ಕ್ಯು ರ‍್ಹಾವಾಳೂಸ್ ಜ಼ಣ್ಯು. ಇನೆ ಬರಾಕೆ ರ‍್ಹಾವಾಳು ತಾರಿ ಶಂಬ್‌ಳ ಹುಯಿರ‍್ಹಾವದೆ’ ಕರಿ ಬೋಲಾನಿವಖ್ಹ್‌ತೆ ಬೋಕ್ಡುಮೇಂಢು ಖ್ಹಾರುಬಿ ಬರಾಕೆ ರ‍್ಹವಾಳೂಸ್ ಚೆಲ್ಕು ಜ಼ಣ್ಯು. <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />ಅಮ್ ದೇವ್ನೆ ತಾರ ಬಾನು ಬೋಕ್ಡಮೇಂಢಾವ್ನ, ಜಾನ್ವರ್‌ನ ಇನಕಂಥು ಕಾಡಿನ್ ಮನ ದಿದೊ. <verse eid="GEN 31:9" /><verse number="10" style="v" sid="GEN 31:10" />ಮೇಂಢಿಯೆ ಗಾಬ್‍ಹುವಾನ ಹಗಾಮ್ಮ ಮೇ ಖ್ಹೋಣ್ಯಾಮ ಡೋಳ ಪಾಡಿನ್ ದೇಕ್‍ತಾನ ಮೇಂಢಾವ್ನಿ ಜೋ಼ಡ್ಮ ಮಳ್ವಾತೆ ಬೋಕ್ಡಖ್ಹಾರುಬಿ ಬರಾಕೆ, ಟಿಪ್‌ಕ್ಯು, ಮಚ಼್ಚವಾಳು ಹುವಾನು ದೆಖಾಯು. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />ಯೊ ಖ್ಹೋಣ್ಯಾಮ ದೇವ್ನದೂತನೆ, ಮನ ‘ಯಾಕೋಬ’ ಕರಿ ಪುಕಾರಖ್ಹತರ್ ಮೇ, ‘ಹಂದೇಕ್ ಮೇ ಹಜ಼್ಜ ಛೂ಼’ ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />ಇನೆ ಮನ, ‘ಲಾಬಾನನೆ ತಾರಿ ಬಾರೇಮ ಚಾ಼ಲಿಲಿದೋತೆ ಪರಕ್‍ ಮೇ ದೇಖಿರಾಖ್ಯೋಸ್, ಇನಾಖ್ಹಾಜೆ ತೂ ಡೋಳಪಾಡಿನ್ ಮೇಂಢಾವ್ನಿ ಜೋ಼ಡ್ಮ ಮಳ್ವಾತೆ ಬೋಕ್ಡಾವ್ನ ದೇಕ್. ಬರಾಕೆಬಿ ಟಿಪ್‌ಕ್ಯು, ಮಚ್ಚೊ಼ಬಿ ರ‍್ಹಾವಳು ಹುಯಿರ‍್ಹುಸ್. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />ತೂ ಬಂಡಾಪರ್ ತೇಲ್‌ನಾಖಿನ್ ಅಶ್‍ನಾನ್ ಕರೀನ್ ಕಬೂಲ್ಯೊಥೋತೆ ಬೇತೇಲ್‌ನೊ ದೇವ್‌ ಮೇಸ್. ಹಮ್ಕೆ ತೂ ಉಠೀನ್ ಆ ದೇಖ್ಹ್‌ನ ಮ್ಹೇಲಿನ್ ತೂ ಪೈದಹುಯೋತೆ ಶೊಂತ್ ದೇಖ್ಹ್‌ನಾಬಿ ತಾರ ಮಾಯಮಾತ್ರಕನಬಿ ಪಾಛೊ಼ಫರಿನ್ ಜಾ಼” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />ಯಾಕೋಬನೆ ಆ ವಾತೆ ಬೋಲ್ಯೊತದೆ ರಾಹೇಲ್‍ಬಿ, ಅಜು಼ ಲೇಯಬಿ, “ಹಮಾರ ಬಾನ ಘರ್‌ಮ ಹಮುನ ಬಿಜು಼ ಶನು ವಾಟೊಭಾಗ್‌ಲೊ ಛಾ಼? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />ಯೊ ಹಮುನ ಅಲ್ಹಾವ್‍ಕರಿ ಲಾಝ಼ಸ್‍ನಿ; ಯೊ ಹಮುನ ವೇಚಿನ್ ಹಮಾರೇಥಿ ಮಳ್ಯೂತೆ ರಪ್ಯಾನ ಇನೇಸ್‍ ಗಳಿಲಿದೋನಿ. <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />ಇನಖ್ಹಾಜೆ ದೇವ್ನೆ ಹಮಾರ ಬಾಥಿ ಮಳ್ಯುತೆ ಶೊತ್‌ಖ್ಹಾರುಸ್ ಅಪ್ಣುನಾಬಿ, ಅಪ್ಣ ಲಡ್ಕಾವ್‍ನಾಬಿ ದಿದೋನಿ, ದೇವ್‍ ತುನ ಬೋಲ್ಯೋತೆ ತಿಮ್ಮಸ್ ಕರ್‌” ಕರಿ ಜ಼ವಾಬ್ ದಿದಿಯೇ. <verse eid="GEN 31:16" /><verse number="17" style="v" sid="GEN 31:17" />ತದೆ ಯಾಕೋಬನೆ ಇನ ಲಡ್ಕಾವ್‍ನಾಬಿ, ಬಾವ್ಣೇವ್‍ನಾಬಿ ಊಟೇವ್‌ಪರ್ ಬೆಖ್ಹಾಡ್ಯೊ. <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />ಇನೆ ಕಮಾಯೋಥೋತೆ ಖ್ಹಾರಿಸ್ ಶೊತ್‌ನಾಬಿ, ಪದ್ದನ್ಅರಾಮ್ ದೇಖ್ಹ್‌ಮ ಕಮಾಯೋತೆ ಖ್ಹಾರುಸ್ ಜಾನ್ವರ್‌ಬಿ ಲೀನ್ ಕಾನಾನ್ ದೇಖ್ಹ್‌ನ ಇನೊ ಬಾ ಇಸಾಕ್‍ಕನ ನಿಕ್‌ಳ್ಯೊ. <verse eid="GEN 31:18" /><verse number="19" style="v" sid="GEN 31:19" />ತದೆ ಲಾಬಾನನೆ ಇನು ಮೇಂಢಾವ್ನ ರುಯಿ ಕತ್ರಾನಖ್ಹಾಜೆ ಜೈ಼ರ‍್ಹೋಥೊ. ತದೆ ರಾಹೇಲ್‍ನೆ ಇನ ಬಾನ ಘರ್ಮಥೂತೆ ಮೂರತ್ನ ಚೋ಼ರಿ ಕರಿಲಿದಿ. <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />ಅಜು಼ಬಿ ಯಾಕೋಬನೆ ಮೇ ವಳ್ಯೋಜ಼ವುಸ್ ಕರಿ ಅರಾಮ್ಯವಾಳ ಲಾಬಾನನ ಬೋಲ್ಯೊಸ್‌ಕೊಂತೆ ಇನ ಠಗೈನ್ ನಾಶಿಚ಼ಲಿಗಯೊ. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />ಅಮ್‍ ಇನಿ ಶೊತ್‌ಖ್ಹಾರುಸ್ ಲೀನ್ ಯೂಫ್ರೇಟೀಸ್ ಮಹಾ ನದ್ದಿನ ಉಲಾಂಗಿನ್ ಗಿಲ್ಯಾದ್‌ಕರಿ ಪಹಾಡ್‌ಟೋಳ್‌ನು ತಬರ್‌ಖಾನಿ ವಾಟ್‌ ಧರ‍್ಯೊ.<verse eid="GEN 31:21" /></para>
  <para style="s">ಲಾಬಾನನೆ ಯಾಕೋಬನ ಪೀಛೆ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />ಯಾಕೋಬ ಚ಼ಲ್ಯೊಗಯೋತೆ ಖಬರ್ ತೀನ್ನ ರೋಜೆ ಲಾಬಾನನ ಮಾಲುಮ್‌ಪಡ್ಯು, <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />ಇನೆ ಮಾಯಮಾತ್ರನ ಎಕ್ಟು ಕರಿಲಿನ್, ಖ್ಹಾತ್‍ದನ್ ಚಾ಼ಲ್‍ಕುಚ಼್ ಕರೀನ್ ಯಾಕೋಬನ ಪೀಛೆಕರೀನ್ ಗಿಲ್ಯಾದ್‌ ಪಹಾಡ್‌ಟೋಳ್ನ ತಬರ್‌ಖಾಮ ಮಳ್ಯೊ. <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />ಕತೋಬಿ ರಾತ್‍ಮ ದೇವ್ನೆ ಅರಾಮ್ಯವಾಳೊ ಲಾಬಾನನ ಖ್ಹೋಣ್ಯಾಮ ಆಯಿನ್, “ತೂ ಯಾಕೋಬನಿ ಜೋ಼ಡ್ಮ ಅಛ್ಛು಼ರ‍್ಹೆವೊ ಖರಾಬ್‍ರ್ಹೆವೊ ವಾತ್ ನಾಬೋಲ್ನುತೆ ಹೊಶಾರ್‌ಥಿರ‍್ಹೆ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 31:25" />ಇನಕೇಡೆಥು ಲಾಬಾನನೆ ಯಾಕೋಬ್‍ನ ಮಳಾನಿವಖ್ಹ್‌ತೆ ಯಾಕೋಬನೆ ಪಹಾಡ್‌ಮ ಇನು ಡೇರೊ ನಾಖಿರಾಖ್ಯೊಥೊ. ಲಾಬಾನಬಿ ಇನ ಮಾಯಮಾತ್ರನಿ ಜೋ಼ಡ್ಮ ಯೋಸ್ ಗಿಲ್ಯಾದ್‌ ಪಹಾಡ್‌ಮ ಡೇರೊ ನಾಖಿರಾಖ್ಯೊಥೊ. <verse eid="GEN 31:25" /><verse number="26" style="v" sid="GEN 31:26" />ಲಾಬಾನನೆ ಯಾಕೋಬ್‍ನ, “ಆ ಶಾತ್‍ ತೂ ಕರ‍್ಯೊತೆ? ತೂ ಮಾರಿ ತಯೇಡ ಛೋ಼ಕ್ರಿಯೇನ ಜಂಗ್‍ಮ ಕೋಂಡಿ ಧರಿಲಿನ್ ಜಾ಼ವಳನಿತರ ಮನ ಶಾತ್‌ಬಿ ಬೋಲ್ಯೊಕೊಂತೆ ನಿಕ್ಳಿಆಯೋನಿ. <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />ಶನಾ ತೂ ಮನ ಬೋಲ್ಯೊಕೊಂತೆ ಚೋ಼ರೇಖ್ಹು ನಿಕ್‌ಳಿ ಆಯೊ? ಮನ ಬೋಲ್ಯೊಹೋತ್ತೊ ಮೇ ಖ್ಹುಶೀಥಿ ಗೀದ್‌, ಖ್ಹಾರಂಗೊ, ತಂತೀನು ವಾಜ಼ವಜ಼ಂತ್ರಿಥಿ ತುನ ಮೋಕ್‌ಲ್ಯೊಹೋತ್‍. <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />ಕತೋಬಿ ತೂ ಮಾರಿ ತಯೇಡ ಛೋ಼ಕ್ರಿಯೇನಾಬಿ ನಾತಿಪೋತಿನ, ಬುಚ಼್ಚಾಕರಾನತೋಬಿ ನಾಹುವಾನಿತರ ಕರ‍್ಯೊ. ತೂ ಕರ‍್ಯೊತೆ ಪಾಗಲ್ ಕಾಮ್. <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />ತುಮುನ ಖರಾಬ್ ಕರಾನ ಮಾರಾಮ ತಾಖತ್ ಛಾ಼. ಕತೋಬಿ ಗೈತೆ ರಾತ್ ತಾರ ಬಾನ ದೇವ್‌ನೆ, ‘ಯಾಕೋಬನ ಅಛ್ಛು಼ರ‍್ಹೆವೊ ಖರಾಬ್‍ರ್ಹೆವೊ ನಾಬೋಲ್ನುತೆ ಹೊಶಾರ್‌ಥಿ ರ‍್ಹೆ’ ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />ಕತೋಬಿ ಬಾನ ಘರೆ ಜಾ಼ವಾನ ತುನ ಘಣು ಆಖ್ಹ್‌ಛಾ಼ತೆ ಇನಾಖ್ಹಾಜೆಥಿ ಜಾ಼ವ್ಣುಪಡ್ಯು. ಕತೋಬಿ ತೂ ಮಾರು ದೇವ್ನ ಚೋ಼ರಿ ಕರ‍್ಯೊತೆ ಶನಖ್ಹಾಜೆ?” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 31:30" /><verse number="31" style="v" sid="GEN 31:31" />ಇನ ಯಾಕೋಬನೆ ಲಾಬಾನನ, “ತೂ ತಾರಿ ಛೋ಼ರಿಯೇನ ಜು಼ಲಮ್‌ಥಿ ಪಾಛೊ಼ ಛಿನೈಲೀಶ್‌ ಕರಿ ಡರಿನ್ ನಿಕ್ಳಿಆಯೊ. <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />ಕತೋಬಿ ತಾರು ದೇವ್‍ಖ್ಹಾರು ಕಿನಾಕನ ಮಳಸ್ಕಿ ಇವ್ಣೆ ಮರಿಜಾವದೆ. ಮಾರ ಮಾಯಮಾತ್ರನ ಖ್ಹಾಮೇಸ್ ಮಾರಿ ಶೊತ್ನ ತರೀಪ್‍ಶ ಕರೆಜಾ಼ಯ್. ಇನಾಮ ತಾರು ಶಾತ್‌ಬಿ ಮಳ್ಯುತೊ ಯೊ ಲೀಲೆ” ಕರಿ ಬೊಲ್ಯೊ. ರಾಹೇಲ್‍ನೆ ಯೊ ದೇವ್ನ ಮೂರತ್ ಅಖ್ಖಾನ ಚೋ಼ರಿ ಕರೀತೆ ಯಾಕೋಬ್‍ನ ಮಾಲುಮ್ ಕೋಥೂನಿ. <verse eid="GEN 31:32" /><verse number="33" style="v" sid="GEN 31:33" />ಲಾಬಾನನೆ ಯಾಕೋಬಾನ ಡೇರಾಮಾಬಿ, ಲೇಯನ ಡೇರಾಮಾಬಿ, ಯೊ ಬೇಜ಼ಣಿ ದಾಸಿನ ಡೇರಾಮಾಬಿ ಢೂಂಡ್ಯೊ, ಕತೋಬಿ ಇನ ಶಾತ್‌ಬಿ ಮಳ್ಯುಕೊಯ್ನಿ. ಲೇಯನು ಡೇರೊ ಮ್ಹೇಲಿನ್ ರಾಹೇಲ್‍ನ ಡೇರಮ ಗಯೊ. <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />ರಾಹೇಲ್‍ ಯೊ ಮೂರತ್ ಖ್ಹಾರುಲೀನ್ ಊಟೆವ್‍ನು ಗೂಣೇಮ ಘಾಲಿನ್ ಇನಾಪರ್‌ ಬೆಠೀಥಿ. ಲಾಬಾನನೆ ಡೇರಾನ ಘರ್‌ಮ ಥೂತೆ ರಾಛ಼ವ್‍ನ ದೇಖ್ಯೊತೋಬಿ ಯೊ ಅಖ್ಖು ದೆಖಾಯುಕೊಯ್ನಿ. <verse eid="GEN 31:34" /><verse number="35" style="v" sid="GEN 31:35" />ರಾಹೇಲ್‍ ಇನ ಬಾನ, “ಬಾ, ಮೇ ತಾರ ಖ್ಹಾಮ್ಣೆ ನಾಭೀರಿತೋಬಿ ಇರಾದೊ ನಕೊಕರ್ಲ ಗುರು, ಮೇ ಛೀಮಾನುಕೊಯ್ನಿ” ಕರಿ ಬೋಲಿ. ಇನೆ ಕೆತ್ರು ಢೂಂಡ್ಯೊತೋಬಿ ಯೊ ಮೂರತ್‍ಅಖ್ಖು ಇನ ಮಳ್ಯುಕೊಯ್ನಿ. <verse eid="GEN 31:35" /><verse number="36" style="v" sid="GEN 31:36" />ತದೆ ಯಾಕೋಬ ಇರಾದೊ ಕರೀನ್ ಲಾಬಾನನ ಗುರ್‌ಕೈನ್, “ತೂ ಅತ್ರೆ ಉತ್ವಾಳಿಕರೀನ್ ಮನ ಪೀಛೆಕರೀನ್ ಆವಾನಿತರ ಮೇ ಶನು ಅಪರಾದ್‌ ಕರ‍್ಯೋಥೊ? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />ಮಾರು ರಾಛು಼ಖ್ಹಾರು ತರೀಪ್‌ಶ ಕರೀನ್ ದೇಖಾನಿಘೋಣಿ ಮೇ ಶನು ಗಲತ್‌ ಕರ‍್ಯೊ? ತಾರಿ ಶೊತ್‍ ಮಾರಾಕನ ಶಾತ್ತೊಬಿ ಮಳ್ಯುಕಿ ಶು? ತಾರ ಮಾರ ಮಾಯಮಾತ್ರನ ಖ್ಹಾಮ್ಣೆಬಿ ಯೊ ಲಯಿನ್ ಮ್ಹೇಲ್. ಅವ್ಣೇಸ್ ಅಪ್ಣ ಭೇಜ಼ಣನು ನ್ಯಾವ್‍ ಫೇಡಾದೆ. <verse eid="GEN 31:37" /><verse number="38" style="v" sid="GEN 31:38" />ಮೇ ವೀಖ್ಹ್‌ ವರಖ್ಹ್‌ ತಾರಿ ಜೋ಼ಡ್ಮ ರ‍್ಹಯೊ. ತಾರು ಮಂಧಾನು ಬೋಕ್ಡಿಯೆನು ಮೇಂಢಿಯೆವ್ನು ಪೇಟ್ ಪಡಾದಿದೊಕೊಯ್ನಿ. ತಾರ ಮಂಧಾನು ಮೇಂಢಾವ್ನ ಮೇ ಶಾತ್ ಖೈಲಿದೊಕೊಯ್ನಿ. <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />ಝಾ಼ಡಿನ ಜಾನ್ವಾರ್‌ಥಿ ಮರೈಗಯುತೆ ಮೇಂಢಾಬೋಕ್ಡಾವ್ನ ತಾರ ಭಾಗ್ನ ನಾಖ್ಯೊಕೊಯ್ನಿ, ಯೊ ಲುಕ್ಷಾನ್ನ ಮೇಸ್ ಢೊಯಿಲಿದೊ. ದನ್ನುರ‍್ಹವೊ, ರಾತ್ನು ರ‍್ಹವೊ ಗುಮೈಜಾ಼ಯ್‍ತೆ ಇನು ಗಣ್ತಿಮಾರೇಥಿ ಲೀಲಿದೊ. <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />ದನ್‌ಮ ತಡ್‌ಕಾಮಾಬಿ ರಾತ್‌ನಿ ಠಣ್‌ಮಾಬಿ ಲತಾಡಪಡ್ಯೊ; ನಿಂದರ್‌ ಕರಾನಿಬಿ ಫುರ್‌ಶತ್ ಮಳ್ಯುಕೊಯ್ನಿ, <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />ವೀಖ್ಹ್‌ ವರಖ್ಹ್‌ ತಾರ ಘರ್ಮ ಚಾ಼ಕ್ರಿ ಕರ್ಯೊ. ತಾರಿ ಬೇ ಛೋ಼ರಿಯೇನಖ್ಹಾಜೆ ಚೌ಼ಧ ವರಖ್ಹ್‌ಬಿ, ತಾರ ಬೋಕ್ಡ ಮೇಂಢಾನಖ್ಹಾಜೆ ಛೋ಼ ವರಖ್ಹ್‌ಬಿ ಚ಼ಾಕ್ರಿಕರ‍್ಯೊ. ಕತೋಬಿ ತೂ ಮಾರಿ ಶಂಬ್ಳಾನ ದಖ್ಹ್‌ ವಖ್ಹತ್ ಬದ್ಲಾಯೊ. <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />ಮಾರೊ ಬಾ ಹುಯಿರೋತೆ ದೇವ್‌ಬಿ, ಅಬ್ರಹಾಮ್‌ನೊ ದೇವ್‌, ಇಸಾಕ್‍ನೆ ಡರ್‌ಭಕ್ತಿಥಿ ಆರಾದನೆ ಕರ‍್ಯೊತೆ ದೇವ್‌ ಮಾರಿಜೋ಼ಡ್ಮ ನಾ ರ‍್ಹಯೋಹೊತ್ತೊ, ಖ್ಹಚಂಬಿ ತೂ ಮನ ಖಾಲಿ ಹಾತೆ ಮೋಕ್ಲಿದಿದೊಹೊತ್‌, ಕತೋಬಿ ದೇವ್‌ ಮಾರಿ ವದೇಖ್ಹ್‌ನಾಬಿ ಮೇ ಪಡ್ಯೋತೆ ಮ್ಹಿನತ್ ಮಾಲುಮ್‌ಥೂತೆ ಇನಖ್ಹಾಜೆ ಕಾಲ್‌ರಾತೆ ತುನ ಗುರ್ಕಾಯೊ” ಕರಿಬೋಲ್ಯೊ.<verse eid="GEN 31:42" /></para>
  <para style="s">ಯಾಕೋಬನಾಬಿ ಲಾಬಾನನಾಬಿ ಹುಯುತೆ ಒಪ್ಪಂದ</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />ಇನಾಖ್ಹಾಜೆ ಲಾಬಾನನೆ ಯಾಕೋಬನ, ಆ ಛೋ಼ರಿಯೇ ಮಾರಿ ಛೋ಼ರಿಯೇ ಕಾಹೆಕಿಶೂ, ಆ ಲಡ್ಕಾವ್ ಮಾರ ನಾತ್ಯ ಕಾಹೆಕಿಶೂ, ಆ ಮಂಧಾಬಿ ಮಾರೂಸ್, ತಾರ ಡೋಳಾನ ಖ್ಹಾಮ್ಣೆನು ಖ್ಹಾರುಬಿ ಮಾರೂಸ್. ಇಮ್‍ಕತೊ ಆ ಮಾರಿ ಛೋ಼ರಿಯೇನ ಖ್ಹಾಜೇಬಿ, ಅವ್ಣೆ ಜ಼ಣಿಯೇತೆ ಲಡ್ಕಾವ್‍ನ ಖ್ಹಾಜೇಬಿ ಹಮ್ಕೆ ಮೇ ಶಾತ್‍ಕರೂ? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />ಇನಖ್ಹಾಜೆ ಅಪ್ಣೆ ಬೇಜ಼ಣ ಮಳಿನ್ ಎಕ್ ಒಪ್ಪಂದ ಕರಿಲಿಯೆ ಆವ್, ಯೊ ಮನಾಬಿ ತುನಾಬಿ ಇಚ಼್‌ಮ ಸಬೂತ್ ಹುಯಿರ‍್ಹವಾದೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 31:44" /><verse number="45" style="v" sid="GEN 31:45" />ತದೆ ಯಾಕೋಬನೆ ಎಕ್ ಬಂಡಾನ ಲಯಿನ್ ಯಾದ್‌ನು ಖಂಬು ಕರೀನ್ ಭೀರಾಖ್ಯೊ. <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />ಯಾಕೋಬನೆ ಇನ ಭಣಿವಾಳನ, “ಬಂಡಾವ್ನ ಎಕ್ಟುಕರೊ” ಕರಿ ಬೋಲಖ್ಹತರ್ ಇವ್ಣೆ ಬಂಡೋಖ್ಹಾರು ಎಕ್ಟು ಕರೀನ್ ಗುಡ್ಡೊ ಕರ‍್ಯು. ಇವ್ಣೆ ಖ್ಹಾರು ಯೊ ಗುಡ್ಡಾಕನ ಖಾಣು ಖಾದು. <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />ಯೊ ಟಿಮ್ಮಾನ ಲಾಬಾನನೆ “ಯಗರಸಾಹದೂತ” ಕರೀಬಿ ಯಾಕೋಬನೆ “ಗಲೇದ್” ಕರೀಬಿ ನಾಮ್ ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 31:47" /><verse number="48" style="v" sid="GEN 31:48" />ತದೆ ಲಾಬಾನನೆ, “ಆ ವಖ್ಹತ್ ತುನಾಬಿ ಮನಾಬಿ ಹುಯುತೆ ಒಪ್ಪಂದನ ಆ ಗುಡ್ಡೋಸ್ ಸಾಕ್ಷಿ” ಕರಿ ಬೋಲ್ಯೋತೆ ಇನಾಖ್ಹಾಜೆ ಇನ ‘ಗಲೇದ್’ ಕರಿ ನಾಮ್‌ಹುಯು. <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />ಆನಾಹುಯಿನ್‌ ಇನೆ, “ಅಪ್ಣೆ ಏಕ್‍ಥಿಏಕ್ಜ಼ಣ ಅಲಕ್ ಹುಯಿರ‍್ಹಾವಪರ್ ಯೆಹೋವಾಸ್ ಅಪ್ಣ ಬೇ ಜ಼ಣಾನಾಬಿ ದೇಖಿಲೆವುಕರಸ್" ಕರಿ ಬೋಲ್ಯೋತೆ ಇನಾಖ್ಹಾಜೆ ಇನ ಮಿಚ್ಚಾ ಕರಿ ನಾಮ್‌ಹುಯು. <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />ಅಜು಼ ಲಾಬಾನನೆ, “ತೂ ಮಾರಿ ಬೇ ಛೋ಼ರಿಯೇನ ದುಖ್ ದಿದೋತೊ ನತರ್ ಬಿಜಿ ತಯೇಡಾನ ವ್ಯಹಾಕರಿಲಿದೋತೊ ಪರ್ಖಿ ಬೋಲಾನ ಅದ್ಮಿಮ ಕೋಣ್ ನಾರ‍್ಹಯುತೋಬಿ ದೇವಸ್‌ ಅಪ್ಣಿ ಒಪ್ಪಂದನ ಸಾಕ್ಷಿ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 31:50" /><verse number="51" style="v" sid="GEN 31:51" />ಆನಾಹುಯಿನ್ ಲಾಬಾನನೆ ಯಾಕೋಬನ, “ತಾರಮಾಬಿ ಮಾರಮಾಬಿ ಇಚ್ಮ಼ ಮೇ ಭೀರಾಖ್ಯೋತೆ ಆ ಖಂಬಾನ ದೇಕ್. ಆ ಗುಡ್ಡಾನಾಬಿ ದೇಕ್. <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />ಮೇ ಖರಾಬ್ ಕರಾನಖ್ಹಾಜೆ ಆ ಗುಡ್ಡಾನ ಉಲಾಂಗಿನ್ ತಾರಾಕನ ಆವ್‌ಕೊಯ್ನಿ. ಇಮ್ಮಸ್ ತೂಬಿನ್‌ ಆ ಖಂಬಾನಾಬಿ ಆ ಗುಡ್ಡಾನಾಬಿ ಉಲಾಂಗಿನ್ ಮಾರಾಕನ ನಾ ಆವ್ಣು. ಅನ, ಆ ಗುಡ್ಡೋಬಿ ಖಂಬೂಬಿ ಸಬೂತ್ ಹುಯಿರ‍್ಹವಾದೆ. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />ಅಬ್ರಹಾಮ್‌ನೊ ದೇವ್,ನಾಹೋರನೊ ದೇವ್,ಇವ್ಣ ಬಾನೋ ದೇವ್ ತುನಾಬಿ ಮನಾಬಿ ನ್ಯಾವ್ ಫೇಡಾವಾದೆ” ಕರಿ ಬೊಲ್ಯೊ. ಇಮ್ನಿಸ್ ಪರಕ್ ಯಾಕೋಬನೆ ಇನೊ ಬಾ ಇಸಾಕ್ ಡರ್‌ ಭಕ್ತಿಥಿ ಆರಾದನೆ ಕರಾತೆ ದೇವ್‍ಪರ್ ಆಣ್‍ಕರಿನ್ ಪರ್‌ಮಾಣ್ ಕರ‍್ಯೊ. <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />ಯಾಕೋಬ ಯೊ ಪಹಾಡ್‍ಪರ್ ಬಲಿದೀನ್ ಇನ ಮಾಯ ಮಾತ್ರನ ಇನಿಜೋ಼ಡ್ಮ ಖಾಣು ಖಾವನ ಬುಲೈಮಂಗಾಯೊ. ಇವ್ಣೆ ಖಾಣು ಖೈನ್ ಯೊ ರಾತ್‌ ಪಹಾಡ್‌ಮಸ್ ರಹಿಗು. <verse eid="GEN 31:54" /><verse number="55" style="v" sid="GEN 31:55" />ವ್ಹಾಣವೇಳಿ ಲಾಬಾನನೆ ಉಠೀನ್ ಇನಿ ಛೋ಼ರಿಯೇನಾಬಿ, ನಾತ್ಯಾವ್‍ನಾಬಿ ಬುಚ್ಚಾ಼ಕರೀನ್ ಇವ್ಣುನ ಆಶೀರ್ವಾದ್‌ಕರೀನ್ ಇನ ಘರೆ ಪಾಛೊ಼ ಫರೀನ್ ಗಯೊ.<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">ಏಸಾವನ ಭೇಟಿಹುವಾನ ಯಾಕೋಬನಿ ತಯ್ಯಾರ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />ಯಾಕೋಬ ಅಗಾಡಿ ಚಾ಼ಲ್ತೊರ‍್ಹಾವನಿ ವಖ್ಹತ್ ದೇವ್ನ ದೂತರ್ ಇನ ಖ್ಹಾಮ್ಣೆ ಆಯು. <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />ಯಾಕೋಬ ಇವ್ಣುನ ದೇಖಾನಿ ವಖ್ಹ್‌ತೆ, ಆ ದೇವ್‍ನು ಬೇ ಟಾಂಡು” ಕರಿ ಬೋಲಿನ್ ಯೊ ಝ಼ಗೋನ “ಮಹನಯಿಮ್” ಕರಿ ನಾಮ್ ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 32:2" /><verse number="3" style="v" sid="GEN 32:3" />ತದೆ ಯಾಕೋಬನೆ ಇನೇಥಿ ಅಗಾಡಿ ಎದೋಮ್ಯವಾಳನು ದೇಖ್ಹ್‌ ಹುಯಿರ‍್ಹುತೆ ಸೇಯಿರ್‌ ತಬರ್ಖಾನ ಇನೊ ಭೈ ಏಸಾವಕನ ಇನ ಖಬರ್‌ ದ್ಯವಾಳಾನ ಮೋಕ್‌ಲ್ಯೊ. <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />ಮೋಕ್ಲಾನಿ ವಖ್ಹ್‌ತೆ ಇವ್ಣುನ, “ತುಮೆ ಮಾರೊ ಮಾಲಿಕ್ ಏಸಾವಕನ ಜೈ಼ನ್ ಆ ಖಬರ್ ದೆವೊ; ಇನ, ‘ತಾರೊ ಸೇವೆ ಕರಾವಾಳೊ ಯಾಕೋಬ ಅತ್ರದನ್ ಲಾಬಾನಕನ ಜಿವ್ಣು ಕರುಕರ‍್ತೋಥೊ. <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />ಹಮ್ಕೆ ಇನಕನ ಢಾಂಡು, ಗಧೇಡು ಮೇಂಢು, ಬೋಕ್ಡಿ, ಕೈಯೇಕ್ ಜಾನ್ವರ್‌ನು ಮಂಧುಬಿ ದಾಸದಾಸಿಯೆವ್‌ಬಿ ಛಾ಼. ಮಾಲಿಕ್‌ನಿ ದಯಾ ಹಮಾರಪರ್ ರ‍್ಹೇವ್ಣುಕರಿ ಖಬರ್‌ ದ್ಯವಾನಖ್ಹಾಜೆ ಹಮುನ ಮೋಕ್ಲಿರಾಖ್ಯೊಸ್” ಕರಿ ಬೋಲೊ”. <verse eid="GEN 32:5" /><verse number="6" style="v" sid="GEN 32:6" />ತದೆ ಯೊ ಖಬರ್‌ ದ್ಯವಾಳು ಯಾಕೋಬಕನ ಪಾಛು಼ ಫರಿ ಆಯಿನ್, ಹಮೆ ತಾರ ಮೋಟ ಭೈ ಏಸಾವಕನ ಜೈ಼ನ್ ಆಯಿರ‍್ಹಾಸ್, ಯೊ ಚಾರ್‌ಖ್ಹೋ ಅದ್ಮಿ ಖ್ಹಮೇದ್ ತುನ ಮಳಾನ ವಳ್ಯಾವಸ್ ಕರಿ ಬೋಲಖ್ಹತರ್, <verse eid="GEN 32:6" /><verse number="7" style="v" sid="GEN 32:7" />ಯಾಕೋಬನ ಘಣು ಡರ್ಬಿ ಕಲಾವ್ಣಿಬಿ ಹುಯು. ಇನೆ ಇನಿ ಜೋ಼ಡ್ಮಥೂತೆ ಅದ್ಮೆವ್‍ನ, ಮೇಂಢ ಢಾಂಡವ್ನ ಅಜು಼ ಊಟೆವ್ನ ಬೇ ಝೂ಼ಂಡ್‌ಕರಿ ಭಾಗ್‍ಕರ‍್ಯೊ. <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />ಶನಕತೊ, “ಏಸಾವ ಎಕ್ ಝೂ಼ಂಡ್‍ಪರ್ ಪಡ್ಯೋತೋಬಿ ಬಿಜೇಕ್ ಝೂ಼ಂಡ್ ಲಪೀನ್ ಜ಼ಯೇಜಾ಼ಯ್” ಕರಿ ಇನೆ ಸೋಚಿಲಿದೊ. <verse eid="GEN 32:8" /><verse number="9" style="v" sid="GEN 32:9" />ಆನಾಹುಯಿನ್ ಯಾಕೋಬನೆ ದೇವ್ನ ಪ್ರಾರ್ಥನೆ ಕರೀನ್, “ಯೆಹೋವದೇವ್, ಮಾರೊ ಬಾ ಅಬ್ರಹಾಮ್‌ನೊ ದೇವ್, ಮಾರೊ ಬಾ ಇಸಾಕ್‍ನೊ ದೇವ್, ತುನೆ ಬೋಲ್ಯೊಥೋಕಿ ‘ತಾರ ಶೊಂತ್‌ ದೇಖ್ಹ್‌ನಾಬಿ, ಮಾಯಮಾತ್ರಕನಾಬಿ ಪಾಛೊ಼ ಜಾ಼ವ್ಣುಕರಿ ಮನ ಹುಕುಮ್ ಕರೀನ್ ತುನ ಅಛ್ಛು಼ ಕರೀಶ್‌ಕರಿ. <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />ಕತೋಬಿ ತೂ ತಾರೊ ದಾಸ ಹುಯಿರೋತೆ ಮಾರಪರ್ ಕೆತ್ರೇಕ್ಕಿ ಪ್ಯಾರ್‌ ರಾಖಿನ್ ತಾರಿ ವಾಗ್ದಾನ್ನ ಚ಼ಲೈದಿದೋನಿ, ಮೇ ಇನ ಲ್ಹಾಯೇಕ್‌ಕೊಂತೆ ಹುಯಿರ‍್ಹೊಸ್. ಮೇ ಪಹಿಲೆ ಆ ಯೊರ್ದನ್ ನದ್ದಿನ ಉಲಾಂಗನಿವಖ್ಹ್‌ತೆ ಮಾರಾಕನ ಎಕ್ ಲಠ್ಠೊ ಖಲಿ ಥೋ. ಹಮ್ಕೆ ಬೇ ಝೂ಼ಂಡ್‍ ಛಾ಼. <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />ಮಾರೊ ಮೋಟೊ ಭೈ ಏಸಾವ ಆಯಿನ್ ಮನಾಬಿ, ಮಾರ ಲಡ್ಕಾವ್ನಬಿ, ಇವ್ಣಿ ಆಯಾವ್‍ನಾಬಿ ಮಾರಿನಾಖಸ್‍ಕಿಶುಕಿ ಕರಿ ಮನ ಡರ್‌ ಛಾ಼. ಇನ ಹಾತ್ಮ ನಾಖ್ಹಪಡ್ನುತೆ ಹಮುನ ಬಚಾ಼ಡ್‍ನುಕರಿ ತುನ ಮೇ ಬಿಂತಿ ಕರಿಲೇವುಸ್. <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />‘ತುನ ಖ್ಹಚಂಬಿ ಅಛ್ಛು಼ಕರೀನ್, ತಾರಿ ಪಿಳ್ಗಿನ ಗಣಾನ ಕೊಹುವಾಂತೆ ದರ‍್ಯಾವ್‍ನಿ ರೇತ್ನಿತರ ಭಡಾವುಸ್ ಕರಿ ತುನೆ ಮನ ಬೋಲಿರಾಖ್ಯೋಸ್‌ನಿ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 32:12" /><verse number="13" style="v" sid="GEN 32:13" />ಯಾಕೋಬ ಯೊ ರಾತ್ ಹಿಜ್ಜಾ಼ಸ್‍ ಖ್ಹುತೊ. ಇನೆ ಲಾಯೊಥೋತೆ ತಿನಾಮಥು ಥೋಡು ಇನೊ ಭೈ ಏಸಾವನ ಕಾಣ್ಕೆ ದ್ಯಾವಾನ ಚೂ಼ಣಿ ಕಾಡಿಲಿದೊ. <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />ಬೇಖ್ಹೊ ಬೋಕ್ಡಿಯೆ ಬೇಖ್ಹೊ ಮೇಂಢಿಯೆ, ವೀಖ್ಹ್‌ ಬೋಕ್ಡ, ವೀಖ್ಹ್‌ ಮೇಂಢ <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />ಚೆಲ್ಕ ಖ್ಹಮೇದ್ ದೂದ್ ನಿಚೋಡಾನಿ ಡೋಡಿಖ್ಹ್‌ ಊಟೆ, ಚಾ಼ಳಿಖ್ಹ್‌ ಗೈಯೆ, ದಖ್ಹ್‌ ಘುಳಿ, ವೀಖ್ಹ್‌ ಗಧೇಡಿಯೇ, ದಖ್ಹ್‌ ಗಧೇಡ, <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />ಆ ಅಖ್ಖು ಇನೊ ಭೈ ಏಸಾವನ ಕಾಣ್ಕೆ ದ್ಯವಾನ ಕಾಡಿ ಮ್ಹೇಲ್ಯೊ. ಆ ಅಖ್ಖಾ ಮಂಧಾವ್ನ ಅಲಕ್ ಅಲಕ್ ಬಣೈನ್ ಇನ ಆಳ್‌ನ ದೀನ್, “ತುಮೆ ಮಾರೇಥಿ ಅಗಾಡಿ ಜಾ಼ವೊ ಅಜು಼ ಹರೇಕ್ ಮಂಧಾವ್‌ನಾಬಿ ಇಚ಼್‌ಮ ಝ಼ಗೊರ‍್ಹಾವಾದೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 32:16" /><verse number="17" style="v" sid="GEN 32:17" />ಫೈಲ ಮಂಧಾನ ದೇಖಿಲ್ಯಾವಾಳನ, “ಮಾರೋಮೋಟೊ ಭೈ ಏಸಾವ ತಾರ ಖ್ಹಾಮ್ಣೆ ಆಯಿನ್, ‘ತೂ ಕಿನೊ ಆಳ್‌? ಕಿಜ್ಜಾ಼ ವಳ್ಯೊಜಾ಼ಸ್? ತಾರ ಖ್ಹಾಮ್ಣೆ ಛಾ಼ತೆ ಆಖ್ಹಾರು ಜಾನ್ವರ್‌ ಕಿನು?” ಕರಿ ಪುಛಾ಼ಯೋತೊ, <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />ತದೆ ತೂ, “ಆ ತಾರೊ ಸೇವಕ್‌ ಹುಯಿರೋತೆ ಯಾಕೋಬನು. ಇನೊ ಮಾಲಿಕ್ ಏಸಾವನ ಆ ಅಖ್ಖು ಕಾಣ್ಕೆ ದೀನ್‌ ಮೋಕ್ಲಿರಾಖ್ಯೊಸ್. ಯೋಬಿ ಹಮಾರ ಪೀಠೆ ವಳ್ಯೋಆವಸ್”. ಕರಿ ಜ಼ವಾಬ್‌ ದೇವ್ಣುಕರಿ ಹುಕುಮ್‌ ದಿದೊ. <verse eid="GEN 32:18" /><verse number="19" style="v" sid="GEN 32:19" />ಇಮ್ಮಸ್ ಬೇನೆವಾಳನಾಬಿ ತೀನ್ನೇವಾಳನಾಬಿ ಮಂಧಾನ ಪೀಠೆ ಜಾ಼ವಾಳ ಖ್ಹಾರಸ್‌ನಾಬಿ, “ತುಮೆ ಏಸಾವನ ದೇಖಾನಿ ವಖ್ಹ್‌ತೆ ಅಮ್ನಿಸ್ ಪರಕ್‌ ಬೋಲ್ನು. <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />ತಾರೊ ಸೇವಕ್ ಯಾಕೋಬಸ್ ಹಮಾರ ಪೀಠೆ ವಳ್ಯೋಆವಸ್ ಕರಿ ಬೋಲೊ” ಕರಿ ಹುಕುಮ್‌ ಕರ‍್ಯೊ. ಯಾಕೋಬನೆ ಇನ ದಿಲ್ಮ, “ಮಾರ ಅಗಾಡಿ ಜಾ಼ಶೇತೆ ಆ ಕಾಣ್ಕೇಥಿ ಏಸಾವನ ಇರಾದನ ಸಮಾಧಾನ್‍ ಕರುಸ್ ತದೆ ಇನ ಮಳಾನಿ ವಖ್ಹ್‌ತೆ, ಏಕ್‌ವೇಳ್‌ ಮನ ಮಳೈಲಿಶೆ” ಕರಿ ಬೋಲಿಲಿದೊ. <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />ಅಮ್‌ ಯೊ ಕಾಣ್ಕೆನ ಅಗಾಡೀಸ್‌ ಮೋಕ್ಲಿನ್, ಇನೆ ಯೊ ರಾತ್‌ ಇನ ಟಾಂಡಮಸ್‌ ರ‍್ಹಯೊ.<verse eid="GEN 32:21" /></para>
  <para style="s">ದೇವ್ನಿ ಜೋ಼ಡ್ಮ ಯಾಕೋಬನಿ ಕುಸ್ತಿ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />ಯೋರಾತ್‌ ಇನಿ ಬೇ ಬಾವ್ಣೆನ, ಬೇ ದಾಸಿಯೇನ, ಅಜು಼ ಗ್ಯಾರ‍್ಹಜ಼ಣ ಲಡ್ಕಾವ್ನ ಬುಲೈಲಿನ್ ಯಬ್ಬೋಕ್‌ ವ್ಹೇಕ್ಳಾನ ಉಲಾಂಗ್ಯೊ. <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />ಅಮ್‌ ಇವ್ಣುನಾಬಿ, ಇನಿ ಶೊತ್‌ನಾಬಿ ವ್ಹೇಕ್ಳಾನಿ ವಾಟೆ ಉಲಾಂಗಾಯೊ. <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />ತದೆ ಯಾಕೋಬ ಎಕ್ಕಸ್‌ಜ಼ಣೊ ಪೀಠೆ ಭೀಯೊತೆತದೆ ಕೋಣ್ಕಿ ಎಕ್ ಪರ್ಖ್ಹೊ ವ್ಹಾಣುಹುವಾಲಗು ಇನಿ ಜೋ಼ಡ್ಮ ಕುಸ್ತಿಭೀಡ್ಯೊ. <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />ಯೊ ಪರ್ಖ್ಹೊ ಇನೆ ಜೂತ್ಯೊಕೊಂತೆ ಇನಖ್ಹಾಜೆ ಯಾಕೋಬನಿ ಜಾ಼ಂಗ್‌ನಿ ಕೀಲ್‌ಛೀಮ್ಯೋತೆ ಇನಖ್ಹಾಜೆ ಯಾಕೋಬ ಇನಿ ಜೋ಼ಡ್ಮ ಲಡ್‌ತೊರ‍್ಹವಾನಿ ವಖ್ಹ್‌ತೇಸ್‌ ಜಾ಼ಂಗ್‌ನಿ ಕೀಲ್ ಉಳ್‌ಕಿಗೈ. <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />ಯೊ ಪರ್ಖ್ಹೊ, “ಮನ ಮ್ಹೇಲ್‌, ವ್ಹಾಣು ಹುಯಿಚಾ಼ಲ್ಯು” ಕರಿ ಬೋಲಖ್ಹತರ್‌, ಯಾಕೋಬನೆ, “ತೂ ಮನ ಆಶೀರ್ವಾದ್‌ ಕರಾಲಗೂಬಿ ಮೇ ತುನ ಮ್ಹೇಲುಕೊಯ್ನಿ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 32:26" /><verse number="27" style="v" sid="GEN 32:27" />ಯೊ ಪರ್ಖ್ಹೊ, “ತಾರು ನಾಮ್ ಶಾತ್?” ಕರಿ ಬೋಲ್ತಾನ ಇನೆ, ‘ಯಾಕೋಬ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 32:27" /><verse number="28" style="v" sid="GEN 32:28" />ಇನೆ ಯಾಕೋಬನ, “ಅನಾಪರ್ ತೂ ಯಾಕೋಬಕರಿ ಬೋಲೈಲೀಶ್‌ ಕೊಯ್ನಿ; ತೂ ದೇವ್ನಿ ಜೋ಼ಡ್ಮಾಬಿ, ಅದ್ಮಿನಿ ಜೋ಼ಡ್ಮಾಬಿ ಲಡೀನ್‌ ಜೂತ್ಯೋತೆ ಇನಾಖ್ಹಾಜೆ ತುನ ‘ಇಸ್ರಾಯೇಲ್‌’ ಕರಿ ನಾಮ್‌ಉಶೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 32:28" /><verse number="29" style="v" sid="GEN 32:29" />ಯಾಕೋಬನೆ, “ದಯಾಕರಿನ್ ತಾರು ನಾಮ್‌ ಮನ ಬೋಲ್ನು” ಕರಿ ಇನ ಗಿಂಗೈಲೇತಾನ ಇನೆ, “ಮಾರ ನಾಮ್ನ ಪುಛಾ಼ವನು ಶನಾ?” ಕರಿ ಬೋಲಿನ್‌ ಹಿಜ್ಜಾ಼ ಇನ ಆಶೀರ್ವಾದ್‌ ಕರ‍್ಯೊ. <verse eid="GEN 32:29" /><verse number="30" style="v" sid="GEN 32:30" />ತದೆ ಯಾಕೋಬನೆ, “ಮೇ ದೇವ್ನ ಆಮಖ್ಹಾಮೆ ದೇಖ್ಯೊ, ತೋಬಿ ಮಾರೊ ಜಾನ್‌ ಬಚ್ಯೊ” ಕರಿ ಬೋಲಿನ್‌ ಯೊ ಝ಼ಗೋನ <note caller="+" style="f"><char style="fr" closed="false">32:30 </char><char style="ft" closed="false">ಪೆನಿಯೇಲ್‌ಕತೊ ಮೇ ದೇವ್ನ ಆಮಖ್ಹಾಮೆ ದೇಖ್ಯೊ. ಇನೆ ಮಾರ ಜಾನ್ನ ಬಚಾ಼ಡ್ಯೊ ಕರಿ</char></note>‘ಪೆನೀಯೇಲ್‌’ ಕರಿ ನಾಮ್‌ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 32:30" /><verse number="31" style="v" sid="GEN 32:31" />ಇನೆ, ಪೆನೂವೇಲ್‌ನ ಉಲಾಂಗಾನಿ ವಖ್ಹ್‌ತೆ ಚಾ಼ಂದ್‌ ನಿಕ್‌ಳ್ಯೊ. ಕತೋಬಿ ಯಾಕೋಬ ಜಾ಼ಂಗ್‌ನಿ ಅಜಾ಼ಥಿ ಲಂಗಡ್‌ತೊ ನಿಕ್‌ಳ್ಯೊ. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />ಯೊ ಪರ್ಖ್ಹೊ ಯಾಕೋಬನಿ ಜಾ಼ಂಗ್‌ನಿ ಕೀಲ್‌ನ ಛೀಮ್ಯೋತೆ ಇನಾಖ್ಹಾಜೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಹಮ್ಕೆಲಗೂಬಿ ಜಾ಼ಂಗ್‌ನಿ ನ್ಹಾರ್‌ನ ಖಾಯಿಕೊಯ್ನಿ.<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">ಯಾಕೋಬ ಏಸಾವನ ಮಳ್ಯೊತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />ಯಾಕೋಬ ಡೋಳ ಪಾಡಿನ್ ದೇಖಾನಿ ವಖ್ಹ್‌ತೆ, ಏಸಾವ ಚಾರ್‌ಖ್ಹೊ ಜ಼ಣ ಪರ್ಖ್ಹಾ ಖ್ಹಮೇದ್‌ ವಳ್ಯಾವಾತೆ ದೇಖ್ಯೊ. ತದೆ ಇನೆ ಲೇಯನಾಬಿ ರಾಹೇಲ್‌ನಬಿ ಬೇಜ಼ಣಿ ದಾಸಿಯೇನಾಬಿ ಇವ್ಣ ಇವ್ಣ ಲಡ್ಕಾವ್ನ ದಿದೊ. <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />ಇವ್ಣುನ ಅಲಕ್‌ ಅಲಕ್‌ಕರಿನ್ ಅಗಾಡಿ ದಾಸಿಯೇನಾಬಿ ಇವ್ಣ ಲಡ್ಕಾವ್‌ನಾಬಿ ಇವ್ಣ ಪೀಠೆ ಲೇಯನಾಬಿ ಇನ ಲಡ್ಕಾವ್ನಬಿ ಪಾಛ಼ಳ್‌ಥು ರಾಹೇಲ್‍ನಾಬಿ ಯೋಸೇಫನಾಬಿ ಭೀರಾಖ್ಯೊ. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />ಅಜು಼ ಯೋಸ್‌ ಇವ್ಣ ಅಗಾಡಿ ಜೈ಼ನ್‌ ಇನ ಭೈನ ಖನ್ನೆ ಆವಾನಿ ವಖ್ಹ್‌ತೆ ಖ್ಹಾತ್‌ಹಲ್ಲ ಜ಼ಮೀನ್‌ಲಗು ಮುಡ್‌ಕ್ಯು ಝು಼ಕೈನ್‌ ಖ್ಹಲಾಮ್ ಕರ‍್ಯೊ. <verse eid="GEN 33:3" /><verse number="4" style="v" sid="GEN 33:4" />ತದೆ ಏಸಾವ ಇನ ಮಳಾನಖ್ಹಾಜೆ ನಾಶಿ ಆಯಿನ್ ಇನ ಗಳುಬಥೈನ್‌ ಬುಚ್ಚಾ಼ ಕರೀನ್ ಇವ್ಣೆ ಭೇಜ಼ಣ ರೋಯ. <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />ಇನಾಪರ್ ಏಸಾವ ಡೋಳಪಾಡಿ ದೇಖಿನ್‌ ಯೊ ತಯೇಡವ್‌ನಾಬಿ ಲಡ್ಕಾವ್‌ನಾಬಿ ದೇಖಿನ್‌, “ತಾರಿ ಜೋ಼ಡ್ಮ ಛಾ಼ತೆ ಅದ್ಮಿಖ್ಹಾರು ಕೋಣ್‌?” ಕರಿ ಬೋಲಖ್ಹತರ್ ಯಾಕೋಬನೆ ಇನ, “ದೇವ್‌ನೆ ತಾರ ಸೇವಕ್‌ನ ಗೋರ್‌ಥಿ ದಿದೋತೆ ಲಡ್ಕಾಸ್‌ ಅವ್ಣೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 33:5" /><verse number="6" style="v" sid="GEN 33:6" />ತದೆ ಇನಿ ದಾಸಿ ಭೇ ಜ಼ಣೀಬಿ ಇವ್ಣ ಲಡ್ಕಖ್ಹಮೇದ್‌ ಐನ್‌ ಆಡ್‌ಪಡ್ಯು. <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />ಇನಾಪರ್‌ ಲೇಯ ಇನ ಲಡ್ಕಾನಿ ಜೋ಼ಡ್ಮ ಆಯಿನ್ ಆಡ್‌ಪಡಿ, ಖ್ಹರ್ತಿಮ ಯೋಸೇಫಬಿ ರಾಹೇಲ್‍ಬಿ ಆಯಿನ್‌ ಆಡ್‌ಪಡ್ಯು. <verse eid="GEN 33:7" /><verse number="8" style="v" sid="GEN 33:8" />ಏಸಾವನೆ, “ಮೇ ವಾಟ್‌ಪರ್‌ ದೇಖ್ಯೊತೆ ಯೊ ಜಾನ್ವರ್‌ನು ಮಂಧು ಶನಾ?” ಕರಿ ಪುಛಾ಼ವಖ್ಹತರ್ ಯಕೋಬನೆ, “ಯಜಮಾನ್ನಿ ಗೋರ್‌ ಮನ ಮಳ್‌ಣುಕರಿ ಮೇ ಯೊ ಅಖ್ಖು ತುಮುನ ಮೋಕ್‌ಲ್ಯೋತೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 33:8" /><verse number="9" style="v" sid="GEN 33:9" />ಏಸಾವನೆ ಇನ, “ಭೈ, ಮನ ಹೋಣುತೆತ್ರು ಶೊತ್‌ಛಾ಼, ತಾರು ತುನಾಸ್‌ ರ‍್ಹವಾದೆ.” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 33:9" /><verse number="10" style="v" sid="GEN 33:10" />ಯಾಕೋಬನೆ, “ಇಮ್‌ಕಾಹೆ, ತುನ ಮಾರಪರ್ ಗೋರ್‌ಉಶೇತೊ, ಮೇ ದೆವುತೆ ಕಾಣ್ಕೆನ ಲೀಲೆವ್ಣು ತುನ ದೇಖ್ಯೋತೆ ದೇವ್ನ ದೇಖಾನಿಘೋಣಿ ಹುಯು. ಮನ ಪ್ಯಾರ್‌ಥಿ ಬುಲೈಲಿದೋತೆಸ್ ಬಶ್‌. <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />ದೇವ್‌ ಮನ ವಾರ್ಖ್ಹೊಥೋತೆ ಇನಾಖ್ಹಾಜೆ ಮನ ಹೋಣುತೆಎತ್ರು ಛಾ಼; ಇನಾಖ್ಹಾಜೆ ಮೇ ದೆವುತೆ ಕಾಣ್ಕೆನ ತೂ ದಯಾ ಕರೀನ್‌ ಲೀಲೆವ್ಣು” ಕರಿ ಏಸಾವನ ಜು಼ಲಮ್‌ ಕರಾಖ್ಹತರ್‌ ಇನೆ ಯೊ ಕಾಣ್ಕೆನ ಲೀಲಿದೊ. <verse eid="GEN 33:11" /><verse number="12" style="v" sid="GEN 33:12" />ಇನಕೇಡೆಥು ಏಸಾವನೆ, “ಅಪ್ಣೆ ಅಗಾಡಿ ಜಿವ್ಣಾನ ನಿಕ್‌ಳೆ ಮೇಅಗಾಡಿ ಚಾ಼ಲೂಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 33:12" /><verse number="13" style="v" sid="GEN 33:13" />ಇನ ಯಾಕೋಬನೆ, “ಮಾರೊ ಮಾಲಿಕ್ ಹುಯಿರೋತೆ ತುನಾಸ್‌ ಮಾಲುಮ್‌ ಛಾ಼ನಿ, ಲಡ್ಕಾ ಕವ್ಳಿ ಉಂಬರ‍್ನ, ಆ ನಾಹುಯಿನ್‌ ಚೆರಾಳು ಢಾಂಡುಬೋಕ್ಡು ಮಾರಕನ ಛಾ಼, ಏಕ್‌ದನ್‌ ಜಾ಼ಖ್ಹತ್ ಚ಼ಲಾಯೋತೊ ಬೋಕ್ಡಮೇಂಢಾನು ಮಂಧು ಥಕೀನ್‌ ಮರೀಗಿರಿಜಾ಼ಶೆ. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />ತುಮೆ ದಯಾ ಕರೀನ್‌ ಸೇವಕಥೀಬಿ ಅಗಾಡಿ ಜ಼ಯೇಜಾ಼ಯ್‌ ಮೇ ಮಾರ ಖ್ಹಾಮ್ಣೆಛಾ಼ತೆ ಬೋಕ್ಡ ಮೇಂಢಾವ್ನಿ ಚಾ಼ಲ್‌ನಾಬಿ ಲಡ್ಕಾವ್ನಿ ಶಕತ್‍ನಾಬಿ ಬರೋಬರ್‌ ಹಳೆಹಳೆಥಿ ಚಾ಼ಲಿನ್‌ ಮಾರ ಯಜಮಾನ್ನ ತಬರ್‌ಖೊ ಹುಯಿರ‍್ಹುತೆ ಸೇಯಿರ್‌ನ ಆವುಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 33:14" /><verse number="15" style="v" sid="GEN 33:15" />ಏಸಾವನೆ, “ಮಾರ ಆಳ್‌ಮ ಥೋಡ ಜ಼ಣಾನ ತಾರಿ ಜೋ಼ಡ್ಮ ಮ್ಹೇಲಿಜ಼ವುಸ್‌” ಕರಿ ಬೋಲಖ್ಹತರ್‌ ಯಾಕೋಬನೆ, “ಇನಿ ಜ಼ರೂರತ್‌ ಶಾತ್‌ಛಾ಼? ಯಜಮಾನ್‌, ತುಮಾರಿ ಗೋರ್‌ ಮಾರಪರ್ ರ‍್ಹಯುತೊ ಬಶ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 33:15" /><verse number="16" style="v" sid="GEN 33:16" />ಅಮ್ ಏಸಾವನೆ ಯೋಸ್‌ ದನ್ ಸೇಯಿರ್‌ ತಬರ್ಖಾನ ನಿಕ್‌ಳ್ಯೊ. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />ಯಾಕೋಬನೆ ಚಾ಼ಲ್ತೊಹುಯಿನ್‌ ಸುಕ್ಕೋತ್‌ ಝ಼ಗೋನ ಗಯೊ. ಹಿಜ್ಜಾ಼ ಇನಾಖ್ಹಾಜೆ ಘರ್‌ಬಿ ಢಾಂಡವ್ನ ಕೊಟ್‌ಕೇಬಿ ಬಣಾಯೊ. ಇನಾಖ್ಹಾಜೆ ಯೊ ಝ಼ಗೋನ “ಸುಕ್ಕೋತ್‌” ಕರಿ ನಾಮ್‌ಹುಯು. <verse eid="GEN 33:17" /><verse number="18" style="v" sid="GEN 33:18" />ಯಾಕೋಬ ಪದ್ದನ್‌ ಅರಾಮ್‌ಥೊ ಆಯಿನ್‌, ಕಾನಾನ್‌ ದೇಖ್ಹ್‌ನು ಶೆಕೆಮ್‌ ಖ್ಹಯೇರ್‌ನ ಜ಼ತನ್‌ಥಿ ಪೋಚ್ಯೊ. ಯೊ ಖ್ಹಯೇರ್‌ನ ಖ್ಹಾಮ್ಣೆ ಇನು ಡೇರಾವ್ನ ನಖೈಲಿದೊ. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />ಇನೆ ಇನು ಡೇರೊ ನಖೈಲಿದೋತೆ ಜ಼ಮೀನ್ನ ಹಮೋರನ ಲಡ್ಕಾವ್ನ ಖ್ಹೋ ರೂಪಾನ ಬಿಲ್ಲಾ ದೀನ್‌ ಇವ್ಣೇಥಿ ಮೋಲ್‌ಲೀಲಿದೊ. ಹಮೋರ ಶೆಕೆಮ್‌ನೊ ಬಾ. <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />ಹಿಜ಼್ಜಾ ಯಾಕೋಬನೆ ಯೆಹೋವನಖ್ಹಾಜೆ ಬಲಿ ಚ಼ಢಾವನಿ ಚಾ಼ಚ಼ರ್‌ ಭಂದೈನ್ ಇನ, <note caller="+" style="f"><char style="fr" closed="false">33:20 </char><char style="ft" closed="false">ಇಸ್ರಾಯೇಲ್‌ನೊ ದೇವ್‌ಕರಿ</char></note>“ಏಲ್‌ ಎಲೋಹೆ ಇಸ್ರಾಯೇಲ್‌” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲ್ಯೊ.<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">ದೀನಬಿ ಶೆಕೆಮ್ಮ ರ‍್ಹವಾಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />ಯಾಕೋಬನ ಲೇಯಮ ಪೈದ ಹುಯಿತೆ ಛೋ಼ರಿ ದೀನ ಏಕ್‌ ದನ್ ಕಾನಾನ್‌ ದೇಖ್ಹ್‌ನಿ ತಯೇಡಾವ್ನ ಮಳಾನಖ್ಹಾಜೆ ಭಾರ್‌ ಆಯಿ. <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />ಹಿವ್ವಿಯವಾಳೊ ಹಮೋರನೊ ಛಿಯ್ಯೊಬಿ ಯೊ ಮುಲಕ್‌ನೊ ಅಧಿಪತಿಥೋತೆ ಶೆಕೆಮ್‌ನೆ ದೀನನ ದೇಖಿನ್, ಪಾಡಿಲಿಜೈ಼ನ್, ಇನ ಮಾನಭಂಗ ಕರ‍್ಯೊ. <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />ಇನೊ ದಿಲ್‌ ಯಾಕೋಬನಿ ಛೋ಼ರಿ ದೀನಪರಸ್ ಥು. ಯೊ ಛೋ಼ಕ್ರಿನ ಪ್ಯಾರ್‌ಕರೀನ್ ಇನೊ ದಿಲ್ನ ಫೊಖ್ಹ್‌ಲಾವನಿ ವಾತ್‌ಬೋಲ್ಯೊ. <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />ಶೆಕೆಮ್‌ನೆ ಇನೊ ಬಾ ಹಮೋರನ, “ತೂ ಯೊ ಛೋ಼ಕ್ರಿನ ಮನ ಬಾವಣ್‍ ಕರಿದೇವ್ಣು” ಕರಿ ಬೋಲಿಲಿದೊ. <verse eid="GEN 34:4" /><verse number="5" style="v" sid="GEN 34:5" />ಯಾಕೋಬನೆ ಇನಿ ಛೋ಼ರಿ ದೀನನ ಶೆಕೆಮ್‌ಥಿ ಮಾನಭಂಗ ಹುಯುತೆ ಖಬರ್‌ ಖ್ಹಮ್‌ಜಿನ್‌ ಇನ ಛಿಯ್ಯಾ ಖೇತರ್‌ಮ ಢಾಂಡ ಚ಼ರವ್‌ಕರ್ತಾಥ. ಇವ್ಣೆ ಆವಾಲಗು ಯೊ ಖ್ಹೊಪ್‌ತಿಥೊ. <verse eid="GEN 34:5" /><verse number="6" style="v" sid="GEN 34:6" />ಎತ್ರಾಮ ಶೆಕೆಮ್‌ನೊ ಬಾ ಹಮೋರ ಯಾಕೋಬನಿ ಜೋ಼ಡ್ಮ ವಾತ್ ಬೋಲಾನ ಆಯೊ. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />ಯಾಕೋಬನ ಪರ್ಖ್ಹಾ ಛಿಯ್ಯಾ ನ್ಹಾನಿ ಭೇನ್ನಿ ಖಬರ್‌ನ ಖ್ಹಮ್‌ಜಿನ್ ಖೇತರ್‌ಥ ಆಯಿನ್ ತದೇಸ್‌ ಕರೀನ್ ಘಣು ಇರಾದೊಕರ‍್ಯಾ. ಶೆಕೆಮ್‌ನೆ ಯಾಕೋಬನಿ ಛೋ಼ರಿನ ಮಾನಭಂಗ ಕರೀನ್, ಇಸ್ರಾಯೇಲ್‌ವಾಳಮ ಘಣು ಖ್ಹರಮ್‌ಜಾ಼ವನು ಕಾಮ್ ಕರ‍್ಯೊ. <verse eid="GEN 34:7" /><verse number="8" style="v" sid="GEN 34:8" />ಕತೋಬಿ ಹಮೋರನೆ ಇವ್ಣುನ, “ಮಾರೊ ಛಿಯ್ಯೊ ಶೆಕೆಮ್‌ನೆ ತುಮಾರಿ ಛೋ಼ಕ್ರಿನ ಘಣು ಆಖ್ಹ್‌ಥಿ ಮೊಹಬತ್ ಕರಿರಾಖ್ಯೊಸ್, ದಯಾಕರಿನ್ ಯೊ ಛೋ಼ಕ್ರಿನ ಇನ ದೇವ್ಣುಕರಿ ತುಮುನ ಬೋಲಿಲೆವುಸ್. <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />ಆ ನಾಹುಯಿನ್‌ ತುಮೆ ಹಮಾರಕನಾಸ್‌ ಜಿವ್ಣುಕರೀನ್ ತುಮಾರಿ ಛೋ಼ಕ್ರಿಯೇನ ಹಮುನ ದೀನ್ ಹಮಾರಿ ಛೋ಼ಕ್ರಿಯೇನ ತುಮೆ ಲೇತಹುಯಿನ್ ಹಮಾರಿ ಜೋ಼ಡ್ಮ ಒಪ್ಪಂದಾನ ಬಣೊ. <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />ದೇಖ್ಹ್‌ ಖ್ಹಾರು ತುಮಾರ ಖ್ಹಾಮ್ಣೆ ಛಾ಼. ಹಿಜ್ಜಾ಼ ಜಿವ್ಣುಕರೀನ್ ಬೇಪಾರ್ ಕರಿನ್ ಶೊತ್ನ ಕಮೈಲಿಯೇಜಾ಼ಯ್.” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 34:10" /><verse number="11" style="v" sid="GEN 34:11" />ತದೆ ಶೆಕೆಮ್‌ನೆ ದೀನನ ಬಾನಾಬಿ ಭೈಯೇನಾಬಿ, “ತುಮಾರಿ ದಯ ಮಾರಪರ್ ರ‍್ಹಾವಾದೆ, ತುಮೆ ಬೋಲಾಯೆತ್ರು ದೆವುಸ್. <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />ತುಮೆ ಬೋಲಾತೆ ತಿಮ್‌ ಕೆತ್ರು ಮಹಾರ್‌ಬಿ ಕಾಣ್ಕೆಬಿ ಛೋ಼ಕ್ರಿನಖ್ಹಾಜೆ ದೆವುಸ್‌. ಕತೋಬಿ ಯೊ ಛೋ಼ಕ್ರಿನ ಮನ ವ್ಯಹಾಕರಿ ದೆವೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 34:12" /><verse number="13" style="v" sid="GEN 34:13" />ಯಾಕೋಬನ ಛಿಯ್ಯಾವ್‌ನೆ ಇವ್ಣಿ ನ್ಹಾನಿ ಭೇನ್ ದೀನನ ಶೆಕೆಮ್‌ನೆ ಮಾನಭಂಗ ಕರ‍್ಯೊತೆ ಇನಾಖ್ಹಾಜೆ ಇನಾಬಿ ಇನೊ ಬಾ ಹಮೋರನಾಬಿ ಠಗಾವ್ಣಿನು ಜ಼ವಾಬ್‌ದಿದ. <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />ಯಾಕೋಬನ ಛಿಯ್ಯಾವ್‌ನೆ ಇವ್ಣುನ, “ಹಮೆ ಯೊ ಕಾಮ್ ಕರಿಯೆಕೊಯ್ನಿ. ಖ್ಹತ್ನ ಹುಯುಕೊಂತೆ ಇನ ಹಮಾರಿ ಭೇನ್ನ ದ್ಯಾವಾನ ಕೋ ಹೋಯ್ನಿ, ಇಮ್ ದ್ಯಾವಾಥಿ ಹಮಾರಿ ಖ್ಹರಮ್‌ ಜಾಷೆ. <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />ಹಮೇ ತುಮಾರೇಥಿ ಒಪ್ಪಂದ ಕರಿಲಿಯೇಸ್ ತುಮಾರಮಾನು ಪರ್ಖ್ಹೊ ಖ್ಹಾರುಬಿ ಹಮಾರಿನಿತರ ಖ್ಹತ್ನಕರೈಲಿದಾತೊ ಹಮಾರಿನಿಘೊಣಿ ಉಶು. ಅಮ್ ಹುಯುತೊ ಹಮೆ ತುಮಾರಿ ವಾತ್ನ ಮಾನಿಲಿಯೇಸ್. <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />ಹಮಾರಿ ಛೋ಼ಕ್ರಿಯೇನ ತುಮುನ ದೇತಾಹುಯಿನ್‌ ತುಮಾರಿ ಛೋ಼ಕ್ರಿಯೇನ ಹಮೆ ಲೇತಹುಯಿನ್ ತುಮಾರಕನ ಜಿವ್ಣುಕರೀನ್ ತುಮಾರಿ ಜೋ಼ಡ್ಮ ಎಕ್ಕಸ್ ಖೂಮ್‌ವಾಳ ಹುಯಿರ‍್ಹಯೇಸ್. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />ಕತೋಬಿ ತುಮೆ ಹಮಾರಿ ವಾತ್ನ ನಾಮಾನಿನ್ ಖ್ಹತ್ನ ನಾಕರಾಯತೊ ಹಮೆ ಹಮಾರಿ ಛೋ಼ಕ್ರಿನ ಬುಲೈಜಿಯೇಸ್” ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 34:17" /><verse number="18" style="v" sid="GEN 34:18" />ಇವ್ಣಿ ವಾತೆ ಹಮೋರನಾಬಿ, ಇನೊ ಛಿಯ್ಯೊ ಶೆಕೆಮ್‌ನಾಬಿ ಅಛ್ಛು಼ ಕರಿ ದೆಖಾಯು. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />ಯೊ ಜ಼ವಾನಿನೆ ಯಾಕೋಬನಿ ಛೋ಼ರಿನ ಪಸಂದ್ ಕರಿರಾಖ್ಯೊತೆ ಇನಖ್ಹಾಜೆ ಇವ್ಣೆ ಬೋಲ್ಯಾತೆ ತಿಮ್ ಕರಾನ ದೇರ್‌ ಕರ‍್ಯೊಕೊಯ್ನಿ. ಯೊ ಇನ ಬಾನ ಘರ್‌ವಾಳನ ಖ್ಹಾರೇಥೀಸ್ ಇಜ಼್ಜತ್‌ವಾಳೊ ಹುಯಿರೋಥೊ. <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />ಇನಖ್ಹಾಜೆ ಹಮೋರಬಿ ಇನೊ ಅಜು ಇನೊ ಛಿಯ್ಯೊ ಶೆಕೆಮ್‌ಬಿ ಇವ್ಣ ಖ್ಹಯೇರ್‌ವಾಳನಿ ಜೋಡ್ಮ ವಾತೆ ಬೋಲಾನ ಖ್ಹಯೇರ‍್ನ ದರ್ವಾಜಕನ ಆಯ. <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />“ಆ ಅದ್ಮಿಖ್ಹಾರು ಹಮಾರಿ ಜೋ಼ಡ್ಮ ಸಮಾಧಾನ್ ಹುಯಿರ‍್ಹುಸ್. ಇನಖ್ಹಾಜೆ ಇವ್ಣೆ ಅಪ್ಣ ದೇಖ್ಹ್‌ಮಾಸ್ ಜಿವ್ಣು ಕರೀನ್ ಬೇಪಾರ್ ಕರಾದೆ. ಆ ದೇಖ್ಹ್‌ ಅಪ್ಣುನಾಬಿ ಇವ್ಣುನಾಬಿ ಹೋಣುತೆಯೆತ್ರು ಜ಼ಮೀನ್ ಛಾ಼. ಅಪ್ಣೆ ಇವ್ಣಿ ಛೋ಼ಕ್ರಿಯೇನ ವ್ಯಾಹ ಕರಿಲಿಯೇ ಅಪ್ಣಿ ಛೋ಼ಕ್ರಿಯೇನ ಇವ್ಣುನ ದಿಯೇ. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />ಕತೋಬಿ ಇವ್ಣೆ ಖ್ಹತ್ನ ಕರೈರಾಖವಾಳು ಹುಯಿರೂಸ್ತೆ ಇನಖ್ಹಾಜೆ ಅಪ್ಣಮಾಬಿ ಪರ್ಖ್ಹೊಖ್ಹಾರು ಖ್ಹತ್ನ ಕರಿಲೇವ್ಣುಕರಿ ಬೋಲಸ್. ಅಮ್ ಹುಯೂತೊ ಇವ್ಣೆ ಅಪ್ಣಾಮ ಜಿವ್ಣುಕರನಾಬಿ ಅಪ್ಣ ಜೋ಼ಡ್ಮ ಎಕ್ಕಸ್ ಖೂಮ್‌ವಾಳು ಹುವನಾಬಿ ಮಾನಿಲಿಶೆ. <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />ಇವ್ಣು ಮೇಂಢು ಢಾಂಡುಬಿ, ಇವ್ಣಿ ಶೊತ್‌ಬಿ ಇವ್ಣು ಖ್ಹಾರುಸ್ ಜಾನ್ವರ್‌ಖ್ಹಾರು ಅಪ್ಣೂಸ್ ಉಶೇಕೊಯ್ನಿಕಿಶೂ? ಇನಖ್ಹಾಜೆ ಅಪ್ಣೆ ಇವ್ಣಾಮ ಜಿವ್ಣು ಕರಾನಖ್ಹಾಜೆ ಇವ್ಣಿವಾತ್ನ ಮಾನಿಲಿಯೇ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 34:23" /><verse number="24" style="v" sid="GEN 34:24" />ತದೆ ಖ್ಹಯೇರ್‌ನು ದರ್ವಾಜನಿ ವಾಟೆ ಜಾ಼ವಾಳು ಖ್ಹಾರೂಸ್, ಹಮೋರನೊ ಛಿಯ್ಯೊ ಶೆಕೆಮ್‌ನೆ ಬೋಲ್ಯೋತೆ ವಾತ್ನ ಗಾಮ್‌ವಾಳು ಖ್ಹಾರೂಸ್ ಮಾನಿಲಿದುತೆ ದೇಖಿನ್ ಇವ್ಣಾಮಥೂತೆ ಪರ್ಖ್ಹೊ ಖ್ಹಾರುಬಿ ಖ್ಹತ್ನ ಕರೈಲಿದು. <verse eid="GEN 34:24" /><verse number="25" style="v" sid="GEN 34:25" />ತೀನ್ನ ದನ್ಮ ಇವ್ಣೆ ಖ್ಹತ್ನನ ಘಾವ್‌ಥಿ ಘಣು ಖ್ಹತುಕರಾನಿ ವಖ್ಹ್‌ತೆ ಯಾಕೋಬನ ಛಿಯ್ಯಾಬಿ, ದೀನನ ಭೈಯೇ ಸಿಮೆಯೋನ್‌ಬಿ ಲೇವಿ ಕರಿ ಭೇಜ಼ಣ ಹಾತ್ಮ ತಲ್ವಾರ್‌ ಲೀನ್ ಡರ‍್ಯಕೊಂತೆ ಖ್ಹಯೇರ್‌ಮ ಆಯಿನ್‌ ಖ್ಹಾರಾಸ್ ಪರ್ಖ್ಹಾನ ಮಾರಿನಾಖ್ಯ. <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />ಗಾಮ್‌ವಾಳಪರ್ ಪಡೀನ್ ಹಮೋರ ಅಜು಼ ಇನೊ ಛಿಯ್ಯೊ ಶೆಕೆಮ್‌ಖ್ಹಮೇದ್ ಖ್ಹಾರಾಸ್ ಪರ್ಖ್ಹಾನ ಮುಲಾಜ್‌ಕೊಂತೆ ತಲ್ವಾರ್‌ಥಿ ಮರ್‌ನಾಖಿನ್ ಶೆಕೆಮ್‌ನ ಘರ್‌ಥು ದೀನನ ಬುಲೈಲೀನ್ ಚ಼ಲೇಗಯ. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />ಇನವಾರ್‌ ಯಾಕೋಬನೆಬಿ ಅಲಕ್ ಛಿಯ್ಯಾಬಿ ಆಯಿನ್, ಭೇನ್ನ ಮಾನಭಂಗ ಹುಯಿಗುತೆ ದಾವೊ ಕಾಡನಖ್ಹಾಜೆ ಖ್ಹಯೇರ್‌ನಾಸ್ ಲೂಟಿಕರಿನಾಖ್ಯ. <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />ಇವ್ಣ ಮೇಂಢಾವ್ನ, ಢಾಂಡವ್ನ, ಅಜು಼ ಗಧೇಡವ್‌ನ ಖ್ಹಯೇರ್‌ಮಾಬಿ ಖೇತರ್‌ಮಾಬಿ ಥೂತೆ ಇವ್ಣಿ ಶೊತ್‍ಖ್ಹಾರುಬಿ ಲೂಟಿಲಿದು. <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />ಇವ್ಣ ಲಡ್ಕಾವ್‌ನಬಿ ಬಾವ್ಣೆನಾಬಿ ಕೋಂಡಿನ್ ಮೋಲ್ನು ಖ್ಹಾರು ಜಿನಖ್ಹ್‌ಬಿ ಘರ್‌ಮಥೂತೆ ಖ್ಹಾರುಸ್ ಲೂಟಿಲಿದ. <verse eid="GEN 34:29" /><verse number="30" style="v" sid="GEN 34:30" />ತದೆ ಯಾಕೋಬನೆ ಸಿಮೆಯೋನ್‌ನಾಬಿ ಅಜು಼ ಲೇವಿನ, “ತುಮೆ ಮನ ಖತ್ರಾಮ ಖ್ಹಪ್‌ಡೈನಾಖಿದಿದ. ಹಮ್ಕೆ ಆ ದೇಖ್ಹ್‌ನು ಕಾನಾನ್ಯವಾಳು, ಪೆರಿಜೀಯವಾಳು, ಮನ ವಹೇರ್‌ ಕರುಕರಸ್. ಮನ ಜಾ಼ಖ್ಹತ್ ಪರ್ಖ್ಹಾ ಅದ್ಮಿ ಕೊಯ್ನಿ. ಆ ದೇಖ್ಹ್‌ವಾಳು ಎಕ್ಟುಹುಯಿನ್‌ ಮಾರಪರ್ ಜಂಗ್‌ನ ಆಯಿನ್ ಮನ ಮಾರ‍್ಯೂತೊ ಮೇಬಿ ಮಾರ ಘರ್‌ವಾಳುಬಿ ನಾಶಹುಯಿಜಾ಼ಶು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 34:30" /><verse number="31" style="v" sid="GEN 34:31" />ಕತೋಬಿ ಇವ್ಣೆ, “ಹಮಾರಿ ಭೇನ್ನ ಶೂಳೇನಿ ಘೋಣಿ ರಾಖಿಲಿದುತೆ ಬರೋಬರ್‌ಕಿಶು?” ಕರಿ ಬೋಲ್ಯು.<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">ಬೇತೇಲ್‍ಮ ದೇವ್‌ನೆ ಯಾಕೋಬನ ಆಶೀರ್ವಾದ್‌ ಕರ‍್ಯೋತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />ದೇವ್‌ನೆ ಯಾಕೋಬನ, “ತೂ ಬೇತೇಲ್‌ನ ಜೈ಼ನ್ ಹಿಜ್ಜಾ಼ ಜಿವ್ಣು ಕರ್‌. ತೂ ತಾರೊ ಮೋಟೊ ಭೈ ಏಸಾವಕಂಥೊ ನಾಶಿಗಯೋತೆ ಹಗಾಮ್ಮ ದೇವ್ ತುನ ಹಿಜ್ಜಾ಼ ದರ್ಶನ್‌ದಿದೋನಿ, ಇನಾಖ್ಹಾಜೆ ತೂ ಚಾ಼ಚ಼ರ್‌ನ ಭಂದಾವ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 35:1" /><verse number="2" style="v" sid="GEN 35:2" />ತದೆ ಯಾಕೋಬನೆ ಇನ ಘರ್‌ವಾಳನಾಬಿ ಇನಿ ಜೋ಼ಡ್ಮ ರ‍್ಹಾವಾಳ ಖ್ಹಾರಾಸ್‌ನಾಬಿ “ತುಮಾರಕನ ಛಾತೆ ಅಲಕ್ ದೇವ್ನ ಕಾಡಿಫೇಕಿನ್‌ ತುಮುನ ಶುದ್ದ ಕರಿಲೀನ್, ಕೋರುಲುಂಗ್ಡು ಫೇರಿಲೆವೊ, <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />ಅಪ್ಣೆ ಹಜ್ಜಾ಼ಥ ಬೇತೇಲ್‌ನ ಜೈ಼ಯೇ. ವದೇಖ್ಹ್‌ನ ದನ್ಮ ಮಾರಿ ಬಿಂತಿನ ಖ್ಹಮ್‌ಜಿನ್ ಮೇ ಜ಼ವುತೆ ಮಾರಗ್‌ಪರ್ ಮಾರಿ ಜೋ಼ಡ್ಮ ಥೂತೆ ದೇವ್ನ ಹಿಜ್ಜಾ಼ ಚಾ಼ಚ಼ರ್‌ನ ಭಂದಾವುಸ್”. ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />ತದೆ ಇವ್ಣೆ ಇವ್ಣಕನಥೂತೆ ಅಖ್ಖುಸ್ ಅಲಕ್ ದೇವ್‍ನಾಬಿ, ಇವ್ಣ ಕಾನ್‌ಮಾನು ಕಾಪ್‌ಖ್ಹಾರು ಯಾಕೋಬನ ದಿದು. ಇನೆ ಯೊ ಅಖ್ಖುಸ್ ಶೆಕೆಮ್‌ ಖ್ಹಯೇರ್‌ನ ಖನ್ನೇನು ಏಲಾ ಝಾ಼ಢ್‌ನ ಹೇಟ್ ಖೋಂದಿ ಘಾಲ್ಯೊ. <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />ಇನಪಾರ್ ಇವ್ಣೆ ಚಾ಼ಲ್ತ ಜಾ಼ವಾನಿ ವಖ್ಹ್‌ತೆ, ಅಶ್‌ಪಿಶ್‌ನು ಖ್ಹಯೇರ್‌ಮ ದೇವ್‌ನೊ ಡರ್‌ಥೂತೆ ಇನಖ್ಹಾಜೆ ಇವ್ಣೆ ಯಾಕೋಬನ ಛಿಯ್ಯಾವ್‍ನ ರಪೇಟಿನ್‌ ಆಯುಕೊಯ್ನಿ. <verse eid="GEN 35:5" /><verse number="6" style="v" sid="GEN 35:6" />ಅಮ್ ಯಾಕೋಬಬಿ ಇನಿ ಜೋ಼ಡ್ಮ ಥೂತೆ ಅದ್ಮಿಖ್ಹಾರು ಕಾನಾನ್ ದೇಖ್ಹ್‌ಮಾನು ಬೇತೇಲ್‌ ಗಾಮ್‌ನು ಲೂಜ಼್‌ನ ಆಯು. <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />ಯೊ ಇನ ಮೋಟ ಭೈಕಂಥೊ ನಾಶಿಜಾ಼ವನಿ ವಖ್ಹ್‌ತೆ ದೇವ್‌ ಇನ ದೆಖಾಯೋ. ಇನಖ್ಹಾಜೆ ಇನೆ ಹಿಜ್ಜಾ಼ ಚಾ಼ಚ಼ರ್‌ ಭಂದೈನ್ ಯೊ ಝ಼ಗೋನ <note caller="+" style="f"><char style="fr" closed="false">35:7 </char><char style="ft" closed="false">ಬೇತೇಲ್‌ನೊ ದೇವ್‌ ಕರಿ ಮತ್ಲಬ್‌</char></note>‘ಏಲ್‌ ಬೇತೇಲ್‌’ ಕರಿ ನಾಮ್‌ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 35:7" /><verse number="8" style="v" sid="GEN 35:8" />ಹಿಜ಼್ಜ ರೆಬೆಕ್ಕನಿ ದಾಸಿ ದೆಬೋರ ಮರಿಜಾ಼ತಾನ, ಇನ ಬೇತೇಲ್‌ನು ಝ಼ರೂಕೊಮಾನು ಏಲಾ ಝಾ಼ಡ್‌ನು ಬಡ್ಡೇಕನ ಮಖ್ಹಾಣ್ಯುಕರ‍್ಯು. ಯೊ ಝ಼ಗೋನ <note caller="+" style="f"><char style="fr" closed="false">35:8 </char><char style="ft" closed="false">ರೋವಾನು ಝಾ಼ಡು ಕರಿ ಮತ್ಲಬ್‌</char></note>“ಅಲ್ಲೋನ್ ಬಾಕೂತ್” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲ್ಯು.<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />ಯಾಕೋಬ ಪದ್ದನ್‌ ಅರಾಮ್‌ನ ಆವನಿ ವಖ್ಹ್‌ತೆ ದೇವ್‌ನೆ ಪಾಛೋ಼ ದರ್ಶನ ದೀನ್ ಇನ ಆಶೀರ್ವಾದ್‌ ಕರ‍್ಯೊ. <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />ದೇವ್‌ನೆ ಇನ, “ತುನ ಹಮ್ಕೆ ಯಾಕೋಬ ಕರಿ ನಾಮ್‌ ಛಾ಼. ಅನಪಾರ್ ತೂ ಯಾಕೋಬ ಕರಿ ಬೋಲೈಲೀಶ್‌ ಕೊಯ್ನಿ “ಇಸ್ರಾಯೇಲ್” ಕರಿ ಪುಕಾರೈಲೀಶ್ ಕರಿ ಬೊಲ್ಯೊ. ಅಮ್ ಇನ ಇಸ್ರಾಯೇಲ್‌ಕರಿ ನಾಮ್ ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 35:10" /><verse number="11" style="v" sid="GEN 35:11" />ಆನಾಹುಯಿನ್‌ ಯೆಹೋವ ದೇವ್ ಇನ, ಮೇಸ್ ಸರ್ವಶಕ್ತ ಹುಯಿರೋತೆ ದೇವ್, ತೂ ಜಾ಼ಖ್ಹತ್ ಪಿಳ್ಗಿವಾಳೊ ಹುಯಿನ್‌ ಭಡೀಶ್, ತಾರೇಥಿ ದೇಖ್ಹ್‌ಬಿ, ಜ಼ಗ್‌ಜಾ಼ತ್‌ನು ಟೋಳ್‌ ಖ್ಹಾರು ಉಶೆ. ಅಜು಼ ರಾಜ಼ವ್‌ಖ್ಹಾರು ತಾರೇಥಿ ಪೈದ ಉಶೆ. <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />ಮೇ ಅಬ್ರಹಾಮ್ ಅಜು಼ ಇಸಾಕ್‌ನ ದೇಖ್ಹ್‌ನ ತುನಾಬಿ ಇನಕೇಡೆಥು ತಾರಿ ಪಿಳ್ಗಿನಾಬಿ ದೀಶ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />ಇನಪಾರ್ ದೇವ್ ಇನಿ ಜೋ಼ಡ್ಮ ವಾತ್ ಬೋಲ್ಯೋತೆ ಝ಼ಗೋಥು ಉಪ್ಪರ್‌ ಚ಼ಲೆಗಯೊ. <verse eid="GEN 35:13" /><verse number="14" style="v" sid="GEN 35:14" />ಯಾಕೋಬನೆ ಇನಿ ಜೋ಼ಡ್ಮ ದೇವ್ ವಾತ್ ಬೋಲ್ಯೋತೆ ಝ಼ಗೋಮ ಬಂಡಾನು ಖಂಬು ಭೀರಾಖಿನ್ ಇನಾಪರ್ ದ್ರಾಕ್ಷಿನೊ ರಖ್ಹ್‌ ನಾಖಿನ್ ತೇಲ್ನ ರಂಚಿನ್ ಪಾಕ್‌ಕರ‍್ಯೊ. <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />ಯಾಕೋಬನೆ ಇನಿ ಜೋ಼ಡ್ಮ ದೇವ್ ವಾತ್ ಬೋಲ್ಯೋತೆ ಝ಼ಗೋನ <note caller="+" style="f"><char style="fr" closed="false">35:15 </char><char style="ft" closed="false">ಬೇತೇಲ್‌ಕತೊ ದೇವ್ನು ಘರ್‌ಕರಿ ಮತ್ಲಬ್</char></note>‘ಬೇತೇಲ್‌’ ಕರಿ ನಾಮ್ ಮ್ಹೇಲ್ಯೊ.<verse eid="GEN 35:15" /></para>
  <para style="s">ರಾಹೇಲ್‌ನಿ ಮರಣ್‌</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />ಇವ್ಣೆ ಬೇತೇಲ್‌ಥು ಜಾ಼ತುರ‍್ಹಾವಾನಿ ವಖ್ಹ್‌ತೆ ಎಫ್ರಾತ್‌ನ ಪೋಚಾ಼ನ ಬಿಜು಼ ದರಾಶಿ ದೂರ್ ರ‍್ಹಾವಾನಿ ವಖ್ಹ್‌ತೆ ರಾಹೇಲ್‌ನ ಪೈದಾಖ್ಹ್‌ನು ಘಣು ದರ್ದ್‌ಹುಯು. <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />ಯೊ ಜ಼ಣತ್‌ನಿ ಅಜಾ಼ಥಿ ಘಣು ಖ್ಹತಾಪ್ಣಿ ಪಡುಕರಾನಿ ವಖ್ಹ್‌ತೆ ಜ಼ಣಾವವಾಳಿನೆ ಇನ, “ಡರ್‌ನಕೊ ಬಿಜೇಕ್ ಪರ್‌ಖ್ಹೊಲಡ್ಕು ಪೈದಉಶೆ” ಕರಿ ಬೋಲಿ. <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />ಕತೋಬಿ ರಾಹೇಲ್ ಮರಿಗೈ. ಯೊ ಜಾನ್‌ಮ್ಹೆಲಾನಿ ವಖ್ಹ್‌ತೆ ಇನೆ ಯೊ ಲಡ್ಕಾನ, ‘ಬೆನೋನಿ’ ಕರಿ ನಾಮ್‌ಮ್ಹೇಲಿ. ಕತೋಬಿ ಯೊ ಲಡ್ಕಾನ ಬಾನೆ ಇನ, <note caller="+" style="f"><char style="fr" closed="false">35:18 </char><char style="ft" closed="false">ದುಖ್‌ನಿ ವೇಳ್‌ನು ಲಡ್ಕು ಕರಿ ಮತ್ಲಬ್‌</char></note>“ಬೆನ್ಯಾಮೀನ್” ಕರಿ ನಾಮ್‌ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 35:18" /><verse number="19" style="v" sid="GEN 35:19" />ರಾಹೇಲ್ ಮರಿಗೈ ತದೆ, ಎಫ್ರಾತ್‌ನ ಜಾ಼ವಾನ ಮಾರ್ಗೆ ಇನ ಮಖ್ಹಾಣ್ಯು ಕರ‍್ಯು. ಯೊ ಝ಼ಗೋನ ಹಮ್ಕೆ ಬೇತ್ಲೆಹೇಮ್‌ ಕರಿ ಬೋಲಸ್. <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />ಯಾಕೋಬನೆ ಇನ ಮಖ್ಹಾಣ್ಯಕನ ಖ್ಹಣೇದ್‍ನು ಖಂಬು ಭೀರಾಖ್ಯೊ. ಯೊ ಹಮ್ಕೆಲಗೂಬಿ “ರಾಹೇಲ್‌ನು ಮಖ್ಹಾಣ್ಯನು ಖಂಬು” ಕರೀಸ್ ಬೋಲೈರ‍್ಹುಸ್. <verse eid="GEN 35:20" /><verse number="21" style="v" sid="GEN 35:21" />ಹಿಜ್ಜಾ಼ಥೊ ಇಸ್ರಾಯೇಲ್‌ನೆ ಚಾ಼ಲ್ತೊಹುಯಿನ್‌ ಮಿಗ್ದಲ್ ಏದರ್‌ನ ಗುಮಜ಼್‌ನ ಪಾರ್ಲಿ ಬಾಜೂ಼ಮ ಇನೊ ಡೇರೊ ಠೋಕಾಯೊ.<verse eid="GEN 35:21" /></para>
  <para style="s">ಯಾಕೋಬನ ಛಿಯ್ಯಾ</para>
  <para style="r">(<ref loc="1CH 2:1-2">1. ಪೂರ್ವ 2:1-2</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 35:22" />ಇಸ್ರಾಯೇಲ್ ಯೊ ದೇಖ್ಹ್‌ಮ ಜಿವ್ಣುಕರಾನಿ ವಖ್ಹ್‌ತೆ ರೂಬೇನ್ನೆ ಇನ ಬಾನಿ ಬಾವ್ಣೆಮ ಎಕ್ ಬಾವಣ್ ಬಿಲ್ಹಕನ ಮಳ್ಯೊ. ಆ ವಾತೆ ಯಾಕೋಬನ ಖ್ಹಮಜ಼್‌ಪಡಿನ್ ಘಣು ಇರಾದೊ ಕರ‍್ಯೊ. ಯಾಕೋಬನ ಭಾರಜ಼ಣ ಛಿಯ್ಯಾಥ. <verse eid="GEN 35:22" /><verse number="23" style="v" sid="GEN 35:23" />ಯಾಕೋಬನ ಲೇಯಮ ಪೈದ ಹುಯಾತೆ ಕೋಣ್‌ಕತೊ; ಯಾಕೋಬನೊ ಪೈಲ್ಹೋಟೊ ಛಿಯ್ಯೊ ರೂಬೇನ್ ಅಜು಼ ಸಿಮೆಯೋನ್‌, ಲೇವಿ, ಯೆಹೂದ, ಇಸ್ಸಾಕಾರ್, ಜೆಬುಲೂನ್. <verse eid="GEN 35:23" /><verse number="24" style="v" sid="GEN 35:24" />ರಾಹೇಲ್‌ಮ ಪೈದಹುಯಾತೆ; ಯೋಸೇಫ ಅಜು಼ ಬೆನ್ಯಾಮೀನ್. <verse eid="GEN 35:24" /><verse number="25" style="v" sid="GEN 35:25" />ರಾಹೇಲ್‌ನಿ ದಾಸಿ ಬಿಲ್ಹಮ ಪೈದಹುಯಾತೆ; ದಾನ್‌, ನಫ್ತಾಲಿ, <verse eid="GEN 35:25" /><verse number="26" style="v" sid="GEN 35:26" />ಲೇಯನಿ ದಾಸಿ ಜಿಲ್ಪಮ ಪೈದಹುಯಾತೆ; ಗಾದ್, ಅಶೇರ್, ಪದ್ದನ್‌ ಅರಾಮ್ಮ ಯಾಕೋಬನ ಪೈದಹುಯಾತೆ ಲಡ್ಕಾವ್ ಅವ್ಣೇಸ್.<verse eid="GEN 35:26" /></para>
  <para style="s">ಇಸಾಕ್‌ನಿ ಮರಣ್‌</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />ಯಾಕೋಬ ಇನೊ ಬಾ ಇಸಾಕ್‍ಕನ ಮಮ್ರೆನ ಆಯೊ. ಮಮ್ರೆಗಾಮ್ ಹೆಬ್ರೋನ್‌ ಕರಿ ಕಿರ್ಯತರ್ಬನ ಮಳ್ಯುಹುಯು. ಯೊ ಅಬ್ರಹಾಮ್ ಇಸಾಕ್ ಪರ್‌ದೇಖ್ಹ್‌ವಾಳ ಹುಯಿನ್‌ ಜಿವ್ಣು ಕರ‍್ಯುಹುಯಿ ಝ಼ಗೊ. <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />ಇಸಾಕ್ ಏಕ್‌ಖ್ಹೊ ಚಾರೀಖ್ಹ್ ವರಖ್ಹ್‌ ಬಚಿರ‍್ಹಿನ್ ಮರ‍್ಯೊ. <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />ಇಸಾಕನ ಛಿಯ್ಯಾ ಏಸಾವ ಅಜು಼ ಯಾಕೋಬನೆ ಇನ ಮಖ್ಹಾಣ್ಯು ಕರ‍್ಯ.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">ಏಸಾವನಿ ಪಿಳ್ಗಿ</para>
  <para style="r">(<ref loc="1CH 1:34-37">1. ಪೂರ್ವ 1:34-37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />ಹೈರುತೆ ಎದೋಮ್ ಕರಿ ಏಸಾವನಿ ಖಾನ್‌ದಾನ್‌; <verse eid="GEN 36:1" /><verse number="2" style="v" sid="GEN 36:2" />ಏಸಾವ ಕಾನಾನ್ಯವಾಳನಿ ತಯೇಡಾವ್‌ನ ವ್ಯಾಹ ಕರಿಲಿದೊ. ಇವ್ಣೆ ಕೋಣ್‌ಕತೊ , ಹಿತ್ತಿಯವಾಳೊ ಏಲೋನನಿ ಛೋ಼ರಿ ಆದಾ, ಹಿವ್ವಿಯವಾಳೊ ಸಿಬಿಯೋನ್ನಿ ನಾತ್‌ಣಿ ಹುಯಿರ‍್ಹಿತೆ ಅನಾಹನಿ ಛೋ಼ರಿ ಒಹೊಲೀಬಾಮ, <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />ಅಜು಼ ಇಷ್ಮಾಯೇಲ್‌ನಿ ಛೋ಼ರಿ ನೆಬಾಯೋತ್‌ನಿ ಭೇನ್‌ ಹುಯಿರ‍್ಹಿತೆ ಬಾಸೆಮತನ ವ್ಯಾಹ ಕರಿರಾಖ್ಯೋಥೊ. <verse eid="GEN 36:3" /><verse number="4" style="v" sid="GEN 36:4" />ಆದಾನೆ ಏಸಾವಮ ಎಲೀಫಜನ ಜ಼ಣಿ. ಬಾಸೆಮತನೆ ರೆಗೂವೇಲನ ಜ಼ಣಿ. <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />ಒಹೊಲೀಬಾಮನೆ ಯೆಗೂಷನ, ಯಳಾಮನಾಬಿ, ಅಜು಼ ಕೋರಹನ ಜ಼ಣಿ. ಕಾನಾನ್ ದೇಖ್ಹ್‌ಮ ಏಸಾವನ ಪೈದಹುಯಾತೆ ಲಡ್ಕ ಅವ್ಣೇಸ್. <verse eid="GEN 36:5" /><verse number="6" style="v" sid="GEN 36:6" />ಇನಾಪಾರ್ ಏಸಾವನೆ ಇನಿ ಬಾವ್ಣೆನಾಬಿ,ಪರ್ಖ್ಹೋ ತಯೇಡ ಲಡ್ಕಾವ್‍ನಾಬಿ, ಇನ ಘರ್ನ ಮಳ್ಯುಹುಯು ಆಳ್‌ಖ್ಹಾರನಾಬಿ, ಇನ ಥೂತೆ ಜಾನ್ವರ್‌ನ ಮಂಧಾವ್‌ನಾಬಿ ಢಾಂಡು ಬೋಕ್ಡು, ಕಾನಾನ್ ದೇಖ್ಹ್‌ಮ ಕಮಾಯೋತೆ ಶೊತ್‌ ಖ್ಹಾರೂಬಿ ಲೀನ್ ಇನೊ ನ್ಹಾನೊಭೈ ಯಾಕೋಬಕಂಥೊ ಅಲಕ್ ದೇಖ್ಹ್‌ನ ಚ಼ಲೇಗಯೊ. <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />ಇವ್ಣಿ ಶೊತ್ ಜಾ಼ಖ್ಹತ್‌ಹುಯಿಗುತೆ ಇನಾಖ್ಹಾಜೆ ಇವ್ಣೆ ಭೇಜ಼ಣಾಬಿ ಎಕ್ಕಸ್ ಝಗೊ ರ‍್ಹಾವಾನ ಹುಯುಕೊಯ್ನಿ. ಇವ್ಣುನ ಜಾನ್ವರ್‌ ಅಖ್ಖು ಘಣುಥೂತೆ ಇನಾಖ್ಹಾಜೆ ಇವ್ಣೆಥೂತೆ ದೇಖ್ಹ್‌ ಇವ್ಣುನ ಬಶ್‌ಕೋಹುಯುನಿ. <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />ಅಮ್ ಏಸಾವನೆ ಸೇಯೀರ್ ಪಹಾಡ್‌ನೊ ತಬರ್‌ಖಾನ ಜೈ಼ನ್ ಹಿಜ್ಜಾ಼ಸ್‌ ಜಿವ್ಣು ಕರ‍್ಯೊ. ಏಸಾವಕತೊ ಎದೋಮಕರಿ. <verse eid="GEN 36:8" /><verse number="9" style="v" sid="GEN 36:9" />ಸೇಯೀರ್ ಪಹಾಡ್‌ನ ತಬರ್‌ಖಾಮ ಥೂತೆ ಎದೋಮ್ಯವಾಳನ ಶುರುವಾತ್ನೊ ಪರ್ಖ್ಹೊ ಏಸಾವನು ಖಾನ್‌ದಾನ್ನಿ ಖೇಣಿ; <verse eid="GEN 36:9" /><verse number="10" style="v" sid="GEN 36:10" />ಏಸಾವನ ಲಡ್ಕಾವ್ನು ನಾಮ್ ಶಾತ್‌ಕತೊ; ಏಸಾವನಿ ಬಾವಣ್ ಆದಾನೊ ಛಿಯ್ಯೊ ಎಲೀಫಜ. ರೆಗೂವೇಲ, ಏಸಾವನಿ ಬಾವಣ್ ಬಾಸೆಮತನೊ ಛಿಯ್ಯೊ. <verse eid="GEN 36:10" /><verse number="11" style="v" sid="GEN 36:11" />ಎಲೀಫಜನ ಲಡ್ಕ ಕೋಣ್‌ಕತೊ; ತೇಮಾನ್, ಓಮಾರ್, ಚೆಪೋ, ಗತಾಮ್, ಕೆನೆಜ್, <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />ಏಸಾವನೊಛಿಯ್ಯೊ ಎಲೀಫಜನ ತಿಮ್ನಕರಿ ರಖೇಲ್‌ ಬಾವಣ್‌ಥಿ. ಅನೆ ಎಲೀಫಜಥಿ ಅಮಾಲೇಕನ ಜ಼ಣಿ. ಅವ್ಣೇಸ್ ಏಸಾವನಿ ಬಾವಣ್ ಆದಾನಿ ಖಾನ್‌ದಾನ್‌ ಹುಯಿರುಸ್. <verse eid="GEN 36:12" /><verse number="13" style="v" sid="GEN 36:13" />ರೆಗೂವೇಲನ ಲಡ್ಕ ಕೋಣ್‌ಕತೊ; ನಹತ್, ಜೆರಹ, ಶಮ್ಮಾ, ಮಿಜ್ಜಾ, ಅವ್ಣೆ ಏಸಾವನಿ ಬಾವಣ್ ಬಾಸೆಮತನ ಖಾನ್‌ದಾನ್‌ವಾಳು ಹುಯಿರ‍್ಹುಸ್. <verse eid="GEN 36:13" /><verse number="14" style="v" sid="GEN 36:14" />ಏಸಾವನಿ ಬಾವಣ್ ಸಿಬಿಯೋನನೊ ಛಿಯ್ಯೊ ಹುಯಿರೋತೆ ಅನಾಹನಿ ಛೋ಼ರಿ ಒಹೊಲೀಬಾಮನ ಲಡ್ಕ ಕೋಣ್‌ಕತೊ; ಯೆಗೂಷ್, ಯಳಾಮ್ ಅಜು಼ ಕೋರಹ,ಕರಿ ತೀನ್ ಜ಼ಣ ಲಡ್ಕಾಥ. <verse eid="GEN 36:14" /><verse number="15" style="v" sid="GEN 36:15" />ಏಸಾವನು ಖಾನ್‌ದಾನ್ನು ಖೂಮ್‌ನ ಘಲ್ಡಾ ಕೋಣ್‌ಕತೊ; ಏಸಾವನೊ ಫೈಲೋಟೊ ಛಿಯ್ಯೊ ಎಲೀಫಜಥಿ ತೇಮಾನ, ಓಮಾರ್, ಚೆಪೋ, ಕೆನೆಜ್, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />ಕೋರಹ, ಗತಾಮ್, ಅಮಾಲೇಕ್,ಕರಿ ಖೂಮ್‌ನ ಫೈದಹುಯ. ಆ ಗಲ್ಢಾ ಎದೋಮ್ಯವಾಳನ ಮುಲಕ್‌ಮಥಾತೆ ಎಲೀಫಜಥಿ ಆಯಹುಯ ಆದಾನಿ ಪಿಳ್ಗಿಮ ಪೈದಹುಯ. <verse eid="GEN 36:16" /><verse number="17" style="v" sid="GEN 36:17" />ಏಸಾವನೊ ಛಿಯ್ಯೊ ರೆಗೂವೇಲನ, ನಹತ್, ಜೆರಹ, ಶಮ್ಮಾ, ಮಿಜ್ಜಾಕರಿ ಖೂಮ್‌ನ ಗಲ್ಢಾ ಪೈದಹುಯ. ಅವ್ಣೆ ಎದೋಮ್ಯವಾಳನ ಮುಲಕ್‌ಮ ಏಸಾವನಿ ಬಾವಣ್ ಬಾಸೆಮತನಿ ಪಿಳ್ಗಿಮ ಪೈದಹುಯ. <verse eid="GEN 36:17" /><verse number="18" style="v" sid="GEN 36:18" />ಏಸಾವನಿ ಬಾವಣ್‍ ಒಹೊಲೀಬಾಮನಿ ಪಿಳ್ಗಿಮ ಪೈದಹುಯಾತೆ ಖೂಮ್‌ನ ಗಲ್ಢಾ ಕೋಣ್‌ಕತೊ: ಯೆಗೂಷ್, ಯಳಾಮ, ಅಜು಼ ಕೋರಹ, ಅವ್ಣೇಸ್ ಅನಾಹನಿ ಛೋ಼ರಿಬಿ ಏಸಾವನಿ ಬಾವಣ್‌ಬಿ ಹುಯಿರೀತೆ ಒಹೊಲೀಬಾಮನಿ ಪಿಳ್ಗಿವಾಳು. <verse eid="GEN 36:18" /><verse number="19" style="v" sid="GEN 36:19" />ಎದೋಮ್ ಕರಿ ಬೋಲೈಲ್ಯಾವಾಳೊ ಏಸಾವಥಿ ಪೈದಹುಯುತೆ ಖೂಮ್ನ ಗಲ್ಢಾ ಅವ್ಣೇಸ್.<verse eid="GEN 36:19" /></para>
  <para style="s">ಸೇಯೀರನು ಪಿಳ್ಗಿ</para>
  <para style="r">(<ref loc="1CH 1:38-42">1. ಪೂರ್ವ 1:38-42</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />ಯೊ ತಬರ್‌ಖಾನು ಜ಼ಮಾನೇಥು ಜಿವ್ಣುಕರವಾಳು ಹೋರಿಯವಾಳೊ ಸೇಯೀರ್‌ಥಿ ಪೈದಹುಯುತೆ ಕೋಣ್‌ಕತೊ ಲೋಟಾನ್, ಶೋಬಾಲ್, ಸಿಬೆಯೋನ್, ಅನಾಹ, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />ದೀಶೋನ್‌, ಏಚೆರ್, ದೀಶಾನ್, ಇವ್ಣೆ ಎದೋಮ್ಯವಾಳನ ದೇಖ್ಹ್‌ಮ ಸೇಯೀರನಿ ಪಿಳ್ಗಿವಾಳು ಹೋರಿಯವಾಳಮ ಪೈದಹುಯಾತೆ ಖೂಮ್‌ನ ಗಲ್ಢಾ. <verse eid="GEN 36:21" /><verse number="22" style="v" sid="GEN 36:22" />ಲೋಟಾನನ ಹೋರಿ, ಹೇಮಾಮ್ ಕರಿ ಛಿಯ್ಯಥಾ, ಇನ ತಿಮ್ನಕರಿ ಭೇನ್‌ಬಿ ಥಿ. <verse eid="GEN 36:22" /><verse number="23" style="v" sid="GEN 36:23" />ಶೋಬಾಲನ ಲಡ್ಕಾವ್‌ಕತೊ; ಅಲ್ವಾನ್, ಮಾನಹತ್, ಗೇಬಾಲ್, ಶೆಪೋ ಅಜು಼ ಓನಾಮ್. <verse eid="GEN 36:23" /><verse number="24" style="v" sid="GEN 36:24" />ಸಿಬೆಯೋನನ ಲಡ್ಕಾವ್‌ಕತೊ; ಅಯ್ಯಾ ಅಜು಼ ಅನಾಹ ಕರಿ ಬೇಜ಼ಣ ಲಡ್ಕ. ಆ ಅನಾಹಸ್ ಇನೊ ಬಾ ಸಿಬೆಯೋನ ಗಧೇಡ ಚ಼ರಾವಾನಿ ವಖ್ಹ್‌ತೆ ಝಾ಼ಡಿಮ ಗರಮ್ ಪಾಣಿನು ಚೇಜ಼್‌ಭಾರಾವ್‌ನ ದೇಖಿನ್ ಮಾಲುಮ್ ಕರ‍್ಯೋಹುಯೊ. <verse eid="GEN 36:24" /><verse number="25" style="v" sid="GEN 36:25" />ಅನಾಹನ ಲಡ್ಕ ಕೋಣ್‌ಕತೊ ದೀಶೋನ್‌ ಅಜು಼ ಅನಾಹನಿ ಛೋ಼ರಿ ಒಹೊಲೀಬಾಮ. <verse eid="GEN 36:25" /><verse number="26" style="v" sid="GEN 36:26" />ದೀಶೋನನ ಲಡ್ಕಾವ್ ಕೋಣ್‌ಕತೊ; ಹೆಮ್ಡಾನ್, ಎಷ್ಬಾನ್, ಇತ್ರಾನ್, ಕೆರಾನ್, <verse eid="GEN 36:26" /><verse number="27" style="v" sid="GEN 36:27" />ಏಚೆರನ ಲಡ್ಕಕತೊ; ಬಿಲ್ಹಾನ್, ಜಾವಾನ್, ಅಕಾನ್. <verse eid="GEN 36:27" /><verse number="28" style="v" sid="GEN 36:28" />ದೀಶಾನನ ಲಡ್ಕಾವ್ ಕೋಣ್‌ಕತೊ; ಊಚ್ ಅಜು಼ ಅರಾನ್. <verse eid="GEN 36:28" /><verse number="29" style="v" sid="GEN 36:29" />ಹೋರಿಯ ವಾಳೇಥಿ ಪೈದ ಹುಯಾತೆ ಖೂಮ್‌ನ ಗಲ್ಢಾ; ಲೋಟಾನಾ, ಶೋಬಾಲ್, ಸಿಬೆಯೋನ್, ಅನಾಹ. <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />ದೀಶೋನ್, ಏಚೆರ್, ದೀಶಾನ್, ಅವ್ಣೇಸ್ ಹೋರಿಯಥಿ ಪೈದಹುಯಿನ್‌ ಸೇಯೀರ್ ತಬರ್‌ಖಾಮ ರಾಜ಼್ ಚ಼ಲಾಯಾತೆ ಖೂಮ್‌ನ ಗಲ್ಢಾ.<verse eid="GEN 36:30" /></para>
  <para style="s">ಎದೋಮ್‌ನ ರಾಜ಼ಖ್ಹಾರು</para>
  <para style="r">(<ref loc="1CH 1:43-54">1. ಪೂರ್ವ 1:43-54</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ರಾಜ಼ವ್ ರಾಜ಼್‌ಚ಼ಲಾವನ ಅಗಾಡಿ ಎದೋಮ್ಯವಾಳನ ದೇಖ್ಹ್‌ಮ ರಾಜ್ ಚ಼ಲವ್‌ಕರ್ತುಥೂತೆ ರಾಜವ್‌ನು ನಾಮ್‌ಅಖ್ಖು; <verse eid="GEN 36:31" /><verse number="32" style="v" sid="GEN 36:32" />ಬೆಯೋರನೊ ಛಿಯ್ಯೊ ಬೇಲಗನೆ ಎದೋಮ್ಯವಾಳಪರ್ ರಾಜ಼್ಚ಼ಲಾಯೊ. ಇನ ಖ್ಹಯೇರ್‌ನು ನಾಮ್ ದಿನ್ಹಾಬಾ. <verse eid="GEN 36:32" /><verse number="33" style="v" sid="GEN 36:33" />ಬೇಲಗ ಮರಿಗೊ ತದೆ ಬೊಚ್ರವಾಳೊ ಜೆರಹನೊ ಛಿಯ್ಯೊ ಯೋಬಾಬ ಯೂಫ್ರೇಟೀಸ್. <verse eid="GEN 36:33" /><verse number="34" style="v" sid="GEN 36:34" />ಯೋಬಾಬ ಮರಾದೀನ್ ತೇಮಾನೀವಾಳನೊ ಹುಷಾಮನೆ ಇನ ಬದಲ್ ರಾಜ಼್ಚ಼ಲಾಯೊ. <verse eid="GEN 36:34" /><verse number="35" style="v" sid="GEN 36:35" />ಹುಷಾಮ ಮರಿಜಾ಼ವಾದೀನ್ ಮೋವಾಬ್ಯವಾಳನ ಬಲ್ಡಾಮ ಮಿದ್ಯಾನ್‌ವಾಳನ ಹರಾಯೋತೆ ಬೆದದನೊ ಛಿಯ್ಯೊ ಹದದನೆ ರಾಜ಼ ಬಣ್ಯೊ ಇನು ರಾಜಧಾನಿನು ನಾಮ್ ಅವೀತ್. <verse eid="GEN 36:35" /><verse number="36" style="v" sid="GEN 36:36" />ಹದದ ಮರಾದಿನ್ ಮಸ್ರೇಕವಾಳೊ ಸಮ್ಲಾಹನೆ ರಾಜ಼ಹುಯೊ. <verse eid="GEN 36:36" /><verse number="37" style="v" sid="GEN 36:37" />ಸಮ್ಲಾಹ ಮರಾದಿನ್ ನದ್ದಿನು ಕನಾರಿಮ ಥೂತೆ ರೆಹೋಬೋತೂರ್‌ ಖ್ಹಯೇರ್‌ನೊ ಸೌಲ ರಾಜ಼ಹುಯೊ. <verse eid="GEN 36:37" /><verse number="38" style="v" sid="GEN 36:38" />ಸೌಲ ಮರಾದಿನ್ ಅಕ್ಬೋರನೊ ಛಿಯ್ಯೊ ಬಾಳ್ಹಾನಾನೆ ರಾಜ಼ಹುಯೊ. <verse eid="GEN 36:38" /><verse number="39" style="v" sid="GEN 36:39" />ಅಕ್ಬೋರನೊ ಛಿಯ್ಯೊ ಬಾಳ್ಹಾನಾನ ಮರಾದಿನ್ ಹದದ ರಾಜ಼ಹುಯೊ. ಇನು ರಾಜಧಾನಿನು ನಾಮ್ ಪಾಗು. ಇನಿ ಬಾವಣ್ಣು ನಾಮ್ ಮಹೇಟಬೇಲ್; ಯೊ ಮೇಜಾಹಾಬನಿ ಛೋ಼ರಿಹುಯಿರೀತೆ ಮಟ್ರೇದನಿ ಛೋ಼ರಿ. <verse eid="GEN 36:39" /><verse number="40" style="v" sid="GEN 36:40" />ಝ಼ಗೊ, ಜಾತ್‌ನಿ, ನಾಮ್ನ ಪರಕ್ಮ ಏಸಾವಥಿ ಪೈದಹುಯಾತೆ ಖೂಮ್‌ನ ಮೋಟಾವ್ನು ನಾಮ್ ಶಾತ್‌ಕತೊ; ತಿಮ್ನ, ಅಲ್ವಾ, ಯೆತೇತ, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />ಒಹೋಲಿಬಾಮ, ಏಲಾ, ಪೀನೋನ್, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />ಕೆನೆಜ್, ತೇಮಾನ್, ಮಿಪ್ಚಾರ್, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />ಮಗ್ದೀಯೇಲ್, ಗೀರಾಮ್, ಅವ್ಣೇಸ್ ಇವ್ಣ ದೇಖ್ಹ್‌ನು ಜಿವ್ಣು ಕರಾನಿ ಝ಼ಗೋನ ಪರಕ್ಮ ಎದೋಮ್ಯವಾಳನ ಖೂಮ್ನ ಗಲ್ಢಾ. ಆಸ್ ಎದೋಮ್ಯವಾಳನೊ ಶುರುವಾತ್ನೊ ಪರ್ಖ್ಹೊ ಏಸಾವ.<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">ಜೋಸೇಫ್ ಅಜು಼ ಇನ ಭೈಯೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />ಯಾಕೋಬನೆ ಇನೊ ಬಾ ಜಿವ್ಣು ಕರುಕರ್ತೊಥೋತೆ ಕಾನಾನ್ ದೇಖ್ಹ್‌ಮ ಜಿವ್ಣು ಕರುಕರ್ತೊಥೊ. <verse eid="GEN 37:1" /><verse number="2" style="v" sid="GEN 37:2" />ಯಕೋಬ್‍ನಿ ಖಾನ್‌ದಾನ್ನಿ ಖೇಣಿ: ತದೆ ಯೋಸೇಫ್‌ನ ಖ್ಹತ್ರಾವರಖ್ಹ್‌ ಹುಯಿರ‍್ಹಾಥ. ಯೊ ಇನ ಮೋಟಭೈಯೇನ ಜೋ಼ಡ್ಮ, ಕತೊ ಇನಿ ಬಾನಿ ಬಿಜೇಕ್‌ ಬಾವಣ್‍, ಬಿಲ್ಹಾ ಅಜು ಜಿಲ್ಪಾ ಕರಿ ಇವ್ಣ ಲಡ್ಕಾವ್ನ ಜೋ಼ಡ್ಮ, ಮೇಂಢ ಬೋಕ್ಡ ಚ಼ರಾವ್‌ತೋಥೊ. ಇವ್ಣೆ ಕಾಯಿತೋಬಿ ಖರಾಬ್ ಕಾಮ್ ಕರ‍್ಯಾತೊ ಯೊ ಬಾನ ಬೋಲ್‌ತೋಥೊ. <verse eid="GEN 37:2" /><verse number="3" style="v" sid="GEN 37:3" />ಯೋಸೇಫ್ ಯಾಕೋಬನ ಬುಡ್‌ಪಣ್‌ಪರ್‌ ಪೈದಹುಯೋತೆ ಇನಾಖ್ಹಾಜೆ ಯಾಕೋಬನೆ ಇನ ಖ್ಹಾರಾಸ್‌ಲಡ್ಕೆಥೀಬಿ ಯೋಸೇಫ್‌ನ ಘಣು ಪ್ಯಾರ್‌ಕರೀನ್ ಇನ ರಂಗೇಲು ಲಾಂಬಾ ಭಾಯನು ಝ಼ಗ್ಗೋ ಕರೈನ್‌ ದೀರಾಖ್ಯೋಥೊ. <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />ಬಾ ಇನ ಖ್ಹಾರಾಸ್ ಲಡ್ಕೇಥೀಬಿ ಅನಾಸ್ ಘಣು ಪ್ಯಾರ್‌ ಕರಾತೆ ದೇಖಿನ್, ಯೋಸೇಫ್‌ನ ಮೋಟಭೈಯೇ ಇನ ವಹೇರ್‌ ಕರೀನ್‌. ಇನಿ ಜೋ಼ಡ್ಮ ಖುಶಾಲಿಥಿ ವಾತ್ ಬೋಲಾನು ಮ್ಹೇಲಿದಿದ.<verse eid="GEN 37:4" /></para>
  <para style="s">ಯೋಸೇಫ್‌ನು ಖ್ಹೋಣ್ಯು</para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />ಎಕ್ ದನ್ ಯೋಸೇಫ್ ಖ್ಹೋಣ್ಯು ದೇಖಿನ್ ಯೊ ಇನ ಭೈಯೇನ ಖ್ಹಾಮ್ಣೆ ಬೊಲ್ಯೊ. <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />ಇನೆ ಇವ್ಣುನ “ಮೇ ಖ್ಹೋಣ್ಯಾಮ ದೇಖ್ಯೋತೆ ಇನ ಬೋಲುಸ್, ಖ್ಹಮ್‌ಜೋ಼, <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />ಯೊ ಖ್ಹೋಣ್ಯಾಮ ಅಪ್ಣೆ ಖೇತರ್‌ಮ ಕಂಥಿ ಭಾಂದುಕರ್ತಾಥ; ತದೆ ಮಾರಿ ಕಂಥಿ ಉಠಿ ಭೀರಾವಖ್ಹತರ್ ತುಮಾರಿ ಕಂಥಿಯೆ ಅಶ್‌ಪಿಶ್‌ ಆಯಿನ್ ಮಾರಿ ಕಂಥಿನ ಆಡ್‌ಪಡಾನು ದೇಖ್ಯೊ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />ತದೆ ಇನ ಭೈಯೇ, “ತೂ ಖ್ಹಾಚಮ ಹಮಾರಪರ್ ಹುಕುಮ್ ಚ಼ಲೈಶ್‌ಕಿಶೂ? ತೂ ಹಮಾರಪರ್ ರಾಜ಼್ ಚ಼ಲೈಶ್‌ಕಿಶೂ?” ಕರೀ ಬೋಲಿನ್ ಇನ ಖ್ಹೋಣ್ಯನಾಬಿ, ವಾತ್‌ನಖ್ಹಾಜೆಬಿ ಬಿಜೂ಼ಬಿ ವಹೇರ್‌ಕರ‍್ಯಾ. <verse eid="GEN 37:8" /><verse number="9" style="v" sid="GEN 37:9" />ಯೊ ಬಿಜೇಕ್ ಖ್ಹೋಣ್ಯು ದೇಖಿನ್ ಯೋಬಿ ಇನ ಭೈಯೇನ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ. ಇನೆ ಇವ್ಣುನ, “ಮೇ ಬಿಜೇಕ್ ಖ್ಹೋಣ್ಯು ದೇಖ್ಯೊ, ಇನಾಮ ಚಾ಼ಂದ್ ಚ಼ಂದರ್‌ಮೋಬಿ ಗ್ಯಾರ‍್ಹ ಶುಕ್ಕರ್‌ಬಿ ಮನ ಆಡ್‌ಪಡ್ಯು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 37:9" /><verse number="10" style="v" sid="GEN 37:10" />ಅಜು಼ ಇನೆ ಆ ಖ್ಹೋಣ್ಯಾನ ಇನ ಬಾನಬಿ ಇನ ಭೈಯೆನಾಬಿ ಖ್ಹಮ್‌ಜಾ಼ಡ್‌ತಾನ ಬಾನೆ ಇನ “ಆ ಕೆಥ್ರಾನು ಖ್ಹೋಣ್ಯು ತೂ ದೇಖ್ಯೋತೆ? ಮೇಬಿ ತಾರಿ ಆಯಾಬಿ ಭೈಯೇಬಿ ತಾರ ಖ್ಹಾಮ್ಣೆ ಆಡ್‌ಪಡಾನ ಆವ್‌ಶೂಕಿಶೂ?” ಕರಿಬೋಲಿನ್ ಗುರ್‌ಕಾಯೊ. <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />ಯೋಸೇಫನ ಭಯ್ಯೆ ಇನಾಪರ್ ಪೇಟ್ನೊಬಳಾಪೊ ಕರ‍್ಯಾ; ಕತೋಬಿ ಇನೊ ಬಾ ಇನಿ ವಾತೆನ ದಿಲ್‌ಮಾಸ್ ರಾಖಿಲಿದೊ.<verse eid="GEN 37:11" /></para>
  <para style="s">ಯೋಸೇಫ್ ವೇಚೈಗಯೋತೆ ಅಜು಼ ಇನ ಈಜಿಪ್ಟ್‌ನ ಲೀಗಯುತೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />ಏಕ್‌ವಖ್ಹತ್ ಇನ ಭೈಯೆ ಬಾನು ಬೋಕ್ಡ ಮೇಂಢಾವ್ನ ಮಂಧಾವ್ನ ಚ಼ರಾವಾನಖ್ಹಾಜೆ ಶೆಕೆಮ್ಮ ಜೈ಼ರ‍್ಹಾವಾನಿ ವಖ್ಹ್‌ತೆ, <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />ಯಾಕೋಬನೆ ಯೋಸೇಫ್‌ನ, “ತಾರ ಭೈಯೇ ಶೆಕೆಮ್ಮ ಬೋಕ್ಡ ಮೇಂಢ ಚ಼ರವ್‌ಕರಸ್‌ನಿ ಇನಖ್ಹಾಜೆ; ಇವ್ಣಕನ ತುನ ಮೋಕ್ಲೂಸ್, ಕರಿ ಬೋಲಖ್ಹತರ್ ಇನೆ, “ಮೇ ತಯಾರ್‌ಛೂ಼, ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 37:13" /><verse number="14" style="v" sid="GEN 37:14" />ಯಾಕೋಬನೆ ಇನ, “ತೂಜೈ಼ನ್ ತಾರ ಭೈಯೆ ಅಛ್ಛೊ ಛಾಕಿಶೂ ಕರೀಬಿ ಬೋಕ್ಡ ಮೇಂಢ ಅಛ್ಛೊ ಛಾಕಿಶೂ ಕರೀಬಿ ಪುಛೈನ್ ಆವ್” ಕರಿ ಹುಕುಮ್‌ದೀನ್ ಹೆಬ್ರೋನ್ ಝ಼ರುಕಾಥು ಬೋಲಿ ಮೋಕ್‌ಲ್ಯೊ. ಯೋಸೇಫ್ ನಿಕ್ಳಿನ್ ಶೆಕೆಮ್‌ನ ಆಯೊ. <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />ಹಿಜ್ಜಾ಼ ಝಾ಼ಡಿಮ ಫರ್‌ತೋಫಂಡಾನಿ ವಖ್ಹ್‌ತೆ ಎಕ್ ಅದ್ಮಿ ಅನ ದೇಖಿನ್, “ಶಾತ್‌ ಢೂಂಡ್ತೊಫಂಡಸ್?” ಕರಿಪುಛಾ಼ಯೊ. <verse eid="GEN 37:15" /><verse number="16" style="v" sid="GEN 37:16" />ಯೋಸೇಫ್‌ನೆ, “ಮಾರ ಭೈಯೇನ ಢೂಂಡುಕರೂಸ್; ಇವ್ಣೆ ಬೋಕ್ಡ ಮೇಂಢಾವ್‌ ಕಿಜ್ಜಾ಼ ಚ಼ರವ್‌ಕರಸ್? ಕರಿ ಬೋಲ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 37:16" /><verse number="17" style="v" sid="GEN 37:17" />ತದೆ ಯೊ ಅದ್ಮಿನೆ, “ಇವ್ಣೆ ಹಜ್ಜಾ಼ಥು ಚ಼ಲ್ಯುಗಯು ‘ದೋತಾನ್ನ ಜೈ಼ಯೇ’ ಕರಿ ಬೋಲಾನು ಖ್ಹಮ್‌ಜ್ಯೊ, ಕರಿ ಬೋಲಾಖ್ಹತರ್ ಯೋಸೇಫ್‌ನೆ ಇವ್ಣುನ ಢೂಂಡ್ತೊಹುಯಿನ್ ದೋತಾನ್‌ಮ ಇವ್ಣುನ ದೇಖ್ಯೊ. <verse eid="GEN 37:17" /><verse number="18" style="v" sid="GEN 37:18" />ಇನ ಭೈಯೆವ್‌ನೆ ಇನ ದೂರ್‌ಥಾಸ್ ದೇಖ್ಯ. ಯೊ ಇವ್ಣಕನ ಆವಾನ ಮಹಿಮ ಇನ ಮಾರಿನಾಖಾನಖ್ಹಾಜೆ ಮಶ್ಲತ್‌ಭಂದಾಯ. <verse eid="GEN 37:18" /><verse number="19" style="v" sid="GEN 37:19" />ಅಜು಼ ಇವ್ಣೆ ಏಕ್‌ಥಿಏಕ್ “ಹಂದೇಖೊ ಯೊ ಖ್ಹೋಣ್ಯುದೇಖವಾಳೊ ವಳ್ಯೋಆವಸ್! ಕರಿಬೋಲಿಲಿದ <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />ಅಪ್ಣೆ ಇನ ಮಾರಿನಾಖಿನ್ ಆ ಪಾಳ್ ಬಾವ್ಡಿಮ ನಾಖಿದಿಯೆ. ‘ಝಾ಼ಡಿನು ಜಾನ್ವರ್‌ ಇನ ಖೈಲಿದು, ಕರಿಬೋಲ್ಯೂತೊ ಹುಯಿಗು, ಆವೊ; ತದೆ ಇನು ಖ್ಹೋಣ್ಯುಖ್ಹಾರು ಶಾತ್‌ಹುವಾಸ್ಕಿ ದೇಖ್ಯೆ” ಕರಿ ಇವ್ಣೆ ವಾತ್‌ಬೋಲಿಲಿದ. <verse eid="GEN 37:20" /><verse number="21" style="v" sid="GEN 37:21" />ರೂಬೇನನೆ ಆ ವಾತೆ ಖ್ಹಮ್‌ಜಿನ್, “ಅಪ್ಣೆ ಇನ ಜಾನ್ನ ನಾಕಾಡ್ನು” ಕರಿ ಬೋಲಿನ್ ಇನ ಇವ್ಣ ಹಾತ್‌ಮಾಥು ಛು಼ಕಾವನ ಕೋಶಿಶ್ ಕರ‍್ಯೊ. <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />ರೂಬೇನನೆ ಇನ ಇವ್ಣಹಾತ್‌ಮಾಥೊ ಛು಼ಕೈನ್ ಬಾಕನ ಪಾಛೊ಼ ಲೀಜಾ಼ವ್ಣುಕರಿ ಇವ್ಣುನ, “ಜಾನ್‌ ನಕೊಕಾಡೊ, ಇನ ಜ಼ಂಗಳ್‌ಮ ಛಾ಼ತೆ ಆ ಬಾವ್ಡಿಮ ನಾಖಿದೆವೊ” ಇನಾಪರ್ ಹಾತ್‌ ನಕೊನಾಖೊ. ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 37:22" /><verse number="23" style="v" sid="GEN 37:23" />ಯೋಸೇಫ ಇನ ಭೈಯೆಕನ ಆವಾನಿವಖ್ಹ್‌ತೆ ಇವ್ಣೆ ಇನಾಪರ್‌ಥೂತೆ ಝ಼ಗ್ಗಾನ ಕಾಡಿನ್ ಛಿನೈಲಿದು, <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />ಇನಧರೀನ್ ಯೊ ಪಾಳ್ ಬಾವ್ಡಿಮ ಫೇಕಿದಿದ. <verse eid="GEN 37:24" /><verse number="25" style="v" sid="GEN 37:25" />ಇನಾಪಾರ್‌ ಇವ್ಣೆ ಖಾಣನ ಬೇಶಿಗಯ. ಎತ್ರಾಮ, ಇಷ್ಮಾಯೇಲ್ಯವಾಳನು ಎಕ್ ಝೂ಼ಂಡ್ ಗಿಲ್ಯಾದ್‌ಥು ಆವಾನು ತದೇಸ್‌ ಇವ್ಣಡೋಳಮ ದೆಖಾಯು. ಇವ್ಣೆ ಇವ್ಣಿ ಊಟೆವ್‍ಪರ್ ಮಸಾಲನು ರಾಛು಼, ವಾಖ್ಹ್‌ನು ಮುಲಾಮ್‌, ವಾನುರಖ್ಹ್‌, ವಾಖ್ಹ್‌ನುತೇಲ್‌, ಆ ಅಖ್ಖು ರಾಛು಼ ಢೊಯಿಲೀನ್, ಗಿಲ್ಯಾದ್‌ಥು ಈಜಿಪ್ಟ್‌ನ ಚಾ಼ಲಿವಳ್ಯವ್ತುಥು. <verse eid="GEN 37:25" /><verse number="26" style="v" sid="GEN 37:26" />ತದೆ ಯೆಹೂದನೆ ಇನ ನ್ಹಾನ ಮೋಟಭೈಯೇನ, “ಅಪ್ಣೆ ಅಪ್ಣ ನ್ಹಾನ ಭೈನ ಮಾರಿನ್ ಖೂನ್‌ಕರ‍್ಯಾತೊ ಶನೊ ಫಾಯಿದೊ? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />ಇನ ಆ ಇಷ್ಮಾಯೇಲ್ಯವಾಳನ ವೇಚಿನಾಖ್ಯೆ ಆವೊ, ಅಪ್ಣೆ ಇನಾಪರ್ ಹಾತ್ ನಾ ನಾಕ್ಣು. ಯೊ ಅಪ್ಣಜೋ಼ಡ್ಮ ಹುಯೋತೆ ನ್ಹಾನೊ ಭೈ ಕಾಹೆಕಿಶೂ?” ಕರಿ ಬೊಲ್ಯೊ. ಯೊ ವಾತ್ನ ಇನ ಭೈಯೆ ಮಾನಿಲಿದ. <verse eid="GEN 37:27" /><verse number="28" style="v" sid="GEN 37:28" />ಎತ್ರಾಮ, ಮಿದ್ಯಾನ್ಯವಾಳು ಬೇಪಾರಿಯೆ ಹಿಜ್ಜಾ಼ಕರಿ ವಳ್ಯುಜಾ಼ತೂಥು. ಇವ್ಣೆ ಯೋಸೇಫ್‌ನ ಬಾವ್ಡಿಮಾಥು ಪಾಡಿನ್ ಯೊ ಇಷ್ಮಾಯೇಲ್ಯವಾಳನ ವೀಖ್ಹ್‌ ರೂಪಾನ ಕಾಖ್ಹ್‌ನ ವೇಚಿನಾಖ್ಯು. ಇವ್ಣೆ ಇನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಲೀನ್‌ಗಯು. <verse eid="GEN 37:28" /><verse number="29" style="v" sid="GEN 37:29" />ರೂಬೇನನೆ ಪಾಛೊ಼ ಯೊ ಬಾವ್ಡಿಕನ ಆಯಿನ್ ದೇಖ್ಯೊಇನಾಮ ಯೋಸೇಫ ಕೋಥೊಂತೆ ದೇಖಿನ್ ದುಖ್ ಖ್ಹಂಬ್‌ಳಾವಕೊಂತೆ ಇನ ಲುಂಗ್ಡಾನ ಫಾಡಿಲಿದೊ. <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />ಇನ ನ್ಹಾನ ಭೈಯೆಕನ ಆಯಿನ್, “ಯೊ ಛೋ಼ಕ್ರು ಕೊಯ್ನಿನಿ, ಅಯ್ಯೋ, ಮೇ ಶಾತ್‌ಕರು?” <verse eid="GEN 37:30" /><verse number="31" style="v" sid="GEN 37:31" />ಇನಕೇಡೆಥು ಇವ್ಣೆ ಎಕ್ ಬೋಕ್ಡಾನ ರ‍್ಹೇಶಿನ್, ಇನ ಲ್ಹೊಯಿಮ ಯೋಸೇಫನು ಝ಼ಗ್ಗಾನ ಭಿಜೈ಼ನ್‌, <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />ಯೊ ಝ಼ಗ್ಗಾನ ಇನ ಬಾಕನ ಮೋಕ್‌ಲ್ಯು. “ಆ ಹಮುನ ಮಳ್ಯು; ಆ ತಾರ ಛಿಯ್ಯಾನು ಝ಼ಗ್ಗೊ ಕಾಹೇಕಿಶು ದೇಕ್?” ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 37:32" /><verse number="33" style="v" sid="GEN 37:33" />ತದೆ ಯಾಕೋಬನೆ ಇನು ಖ್ಹಣೇದ್ ಧರೀನ್, “ಆ ಝ಼ಗ್ಗೋ ಮಾರ ಛಿಯ್ಯಾನೂಸ್, ಝಾ಼ಡಿನು ಜಾನ್ವರ್‌ ಇನ ಮಾರಿ ಖಾದು ಹೋಣು, ಯೋಸೇಫನ ಯೊ ಚೀರಿನಾಖಾಮ ಗುಮಾನೀಸ್‌ ಕೊಯ್ನಿ” ಕರಿ ಬೋಲಿನ್, <verse eid="GEN 37:33" /><verse number="34" style="v" sid="GEN 37:34" />ಯೊ ದುಖ್ ಖ್ಹಮಾಳನ ಕೋಹುಯುನಿತೆ ಇನ ಲುಂಗ್ಡಾನ ಫಾಡಿಲೀನ್ ಕಂಬರ್‌ಪರ್ ಛೈ಼ನೊ ಕೋಥ್‌ಳೊ ಲಪೇಟಿಲೀನ್‌ ಇನ ಛಿಯ್ಯನಖ್ಹಾಜೆ ಘಣಾ ದನ್‌ಲಗೂಬಿ ಕರ‍್ಹವ್‌ಕರ್ತೊಥೊ. <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />ಇನ ದುಖ್ ಭೈಕಾನ ಛಿಯ್ಯಾ ಛೋ಼ರಿಯೇ ಕೆತ್ರು ಕೋಶಿಶ್‌ ಕರ‍್ಯೂತೋಬಿ ಯೊ ಸಮಾಧಾನ್ ಹುಯೋಕೊಯ್ನಿ, “ಮೇ ಅಮ್ಮಸ್ ಕರ‍್ಹಾವ್‌ತೊ ಹುಯಿನ್ ಮಾರೊ ಛಿಯ್ಯೊಛಾ಼ತೆ ಮರಣ್ಣಲೋಕ್‌ನ ಮಳೀಜ಼ವುಸ್”. ಅಮ್ ಬಾ ಛಿಯ್ಯನಖ್ಹಾಜೆ ರೊವ್‌ಕರ್ತೊಥೊ. <verse eid="GEN 37:35" /><verse number="36" style="v" sid="GEN 37:36" />ಮಿದ್ಯಾನ್ಯವಾಳು ಯೋಸೇಫನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಲೀಜೈ಼ನ್ ಫರೋಹಕನ ಆಸ್ಥಾನ್‌ಮಥೋತೆ ಪೋಟೀಫರನ ವೇಚಿನಾಖ್ಯು. ಯೊ ರಾಜ಼ನ ಕಾವ್ಲಿಕರವಾಳ ಶಿಪಾಯಿನೊ ಮೋಟೊಹುಯಿರೋಥೊ.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">ಯೆಹೂದ ಅಜು಼ ತಾಮಾರ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />ಯೊ ಹಗಾಮ್ಮ ಯೆಹೂದ ಇನ ನ್ಹಾನ ಭೈಯೇನ ಮ್ಹೇಲಿನ್‌ ಘಾಟ್ ಉತ್ರೀನ್ ಅದುಲ್ಲಾಮ್ ಗಾಮ್‌ವಾಳೊ ಹೀರಾ ನಾಮ್‌ವಾಳಕನ ರ‍್ಹವಾನ ಗಯೊ. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />ಹಿಜ್ಜಾ಼ ಯೆಹೂದನೆ ಕಾನಾನ್ಯ ಹುಯಿರೋತೆ ಶೂಗನಿ ಛೋ಼ರಿನ ದೇಖಿನ್ ಇನ ವ್ಯಹಾಕರಿಲಿದೊ. <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />ಯೊ ಬೇಜೂನಿ ಹುಯಿನ್ ಯೆಹೂದನ ಎಕ್ ಪರ್ಖ್ಹೊಲಡ್ಕು ಜ಼ಣಿ. ಇನ ಯೆಹೂದನೆ ‘ಏರ್‌’ ಕರಿ ನಾಮ್‌ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />ಯೊ ಪಾಛು಼ ಬೇಜೂನಿಹುಯಿನ್ ಪರ್ಖ್ಹೊಲಡ್ಕು ಜ಼ಣಿ, ಇನ ‘ಓನಾನ್’ ಕರಿ ನಾಮ್‌ಮ್ಹೇಲಿ. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />ಪಾಛಿ ಬೇಜೂನಿಹುಯಿನ್‌ ಪರ್ಖ್ಹೊಲಡ್ಕು ಜ಼ಣಿನ್ ಇನ ‘ಶೇಲಹ’ ಕರಿ ನಾಮ್‌ಮ್ಹೇಲಿ. ಹೈರಿತೆ ಆ ಲಡ್ಕು ಜ಼ಣಾನಿವಖ್ಹ್‌ತೆ ಯೆಹೂದ ಕೆಜೀಬ್ ಗಾಮ್ಮಥೊ. <verse eid="GEN 38:5" /><verse number="6" style="v" sid="GEN 38:6" />ಯೆಹೂದನೆ ಇನೊ ಮೋಟೊಛಿಯ್ಯೊ ಏರನ ‘ತಾಮಾರ’ ಕರಿ ಛೋ಼ಕ್ರಿನ ಲಯಿನ್ ವ್ಯಾಹ ಕರ‍್ಯೊ. <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />ಕತೋಬಿ ಯೆಹೂದನೊ ಮೋಟೊಛಿಯ್ಯೊ ಏರ ಯೆಹೋವನಿ ನಜ಼ರ್‌ಮ ಖರಾಬ್‌ ಹುಯಿರೋಥೊ. ಇನಾಖ್ಹಾಜೆ ಯೆಹೋವನೆ ಇನ ಮಾರಿನಾಖ್ಯೊ. <verse eid="GEN 38:7" /><verse number="8" style="v" sid="GEN 38:8" />ಇನಕೇಡೆಥು ಯೆಹೂದನೆ ಓನಾನನ, “ತೂ ತಾರಿ ಮುಂಡಚ್ಚಿ ಭೋಜೈ಼ಕನ ಖ್ಹುಯಿನ್ ದೇವರ್‌ನು ಕರ್ನುತೆ ಪರಕ್ಮ ಬರೋಬರ್‌ಥಿ ಚಾ಼ಲಿಲಿನ್ ತಾರಭೈನ ಪಿಳ್ಗಿ ಭಡಾವ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />ಕತೋಬಿ ಓನಾನನೆ, ಅಮ್‌ ಹುವಾನು ಪಿಳ್ಗಿ ಮಾರು ಉಶೆಕೋಯ್ನಿ ಕರಿ ಮಾಲುಮ್‌ಕರಿಲಿದೊ. ಮೋಟಭೈನಿ ಪಿಳ್ಗಿ ಪೈದಕರಾನ ಯೊ ಮಾನ್ಯೊಕೊಯ್ನಿ. ಇನಿ ಭೋಜೈನಿ ಜೋಡ್ಮ ಖ್ಹುತೊಥೋತೆ ತದೆ ಇನೆ ಕಾಮಾನ ರಖ್ಹ್‌ನ ಬಿಛಾ಼ವ್ಣಪರ್ ರಂಚಿನಾಖಿ ದೆತೋಥೊ. <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />ಆ ಚಾ಼ಲ್ ಯೆಹೋವನಿ ನಜ಼ರ್‌ಮ ಖರಾಬ್‌ಥೂತೆ ಇನಖ್ಹಾಜೆ ದೇವ್ನೆ ಇನ ಮಾರಿನಾಖ್ಯೊ. <verse eid="GEN 38:10" /><verse number="11" style="v" sid="GEN 38:11" />ಇನಪಾರ್ ಯೆಹೂದನೆ, ಏಕ್‌ವೇಳ್ ಶೇಲಹಬಿ ಇನ ಭೈಯೆನಿ ತರಾಸ್ ಮರಿಜಾ಼ಶೆಕರಿ ಸೋಚಿನ್ ಇನಿ ವ್ಹವ್ ತಾಮಾರನ, “ಮಾರೊಛಿಯ್ಯೊ ಶೇಲಹ ಜ಼ವಾನಿ ಹುವಾಲಗು ತೂ ಮುಂಡಚ್ಚಿಹುಯಿನ್ ಅಯಾಬಾನ ಘರ್‌ಮರ‍್ಹೆ” ಕರಿ ಭಾಣುಕರ‍್ಯೊ ಯೊ ಆಯಾಬಾನ ಘರ್ಮಜೈ಼ನ್ ಹಿಜ್ಜಾ಼ಸ್‌ ಜಿವ್ಣುಕರಿ. <verse eid="GEN 38:11" /><verse number="12" style="v" sid="GEN 38:12" />ಥೋಡ ದನ್ನಪಾರ್ ಯೆಹೂದನಿ ಬಾವಣ್ ಹುಯಿರ‍್ಹಿತೆ ಶೂಗನಿ ಛೋ಼ರಿ ಮರಿಗೈ. ಯೆಹೂದನೆ ದುಖ್‌ಭೈಕಿ ಹುಯಿಜಾ಼ವಾದಿನ್‌, ಇನ ಮೇಂಢಾನ ರುಯ್‌ ಕತ್ರಾವಾಳಕನ ಇನೊ ದೋಸ್ತಿ ಹೀರಾ ಕರಿ ಅದುಲ್ಲಾಮ್ಯವಾಳನಿ ಜೋ಼ಡ್ಮ ತಿಮ್ನಾಗಾಮ್‌ನ ಗಯೊ. <verse eid="GEN 38:12" /><verse number="13" style="v" sid="GEN 38:13" />ಮಾಮ ಇನು ಮೇಂಢಾವ್ನು ರುಯ್‌ ಕತ್ರಾನ ಖ್ಹಾಜೆ ತಿಮ್ನಾ ಗಾಮ್ನ ವಳ್ಯೋಜಾ಼ಸ್ ಕರಿ ಬೋಲಾನಿ ವಾತ್ ತಾಮಾರನ ಖ್ಹಮಜ್ ಪಡ್ಯು. <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />ತದೆ ಇನೆ, ‘ಶೇಲಹ ಜ಼ವಾನಿ ಹುಯಿಗೊತೋಬಿ ಮನ ಇನಿಜೋ಼ಡ್ಮ ಬಾವಣ್‍ ಕರಾಯೊಕೊಯ್ನಿನಿ’ ಕರಿಬೋಲಿನ್ ಇನು ಮುಂಡಚ್ಚಿನು ಲುಂಗ್ಡಾನ ಕಾಡಿಮ್ಹೇಲಿನ್‌ ಘುಮ್‌ಟೊ ನಾಖಿನ್ ಶನ್‍ಗಾರ್‌ಕರಿನ್ ತಿಮ್ನಾಗಾಮ್‌ನು ವಾಟ್‌ಪರ್‌ ಏನಯಿಮ್ ಗಾಮ್‌ನು ದರ‍್ವಾಜ಼ಕನ ಬೇಶಿಗೈ. <verse eid="GEN 38:14" /><verse number="15" style="v" sid="GEN 38:15" />ಯೆಹೂದನೆ ಇನ ದೇಖಾನಿವಖ್ಹ್‌ತೆ ಇನ ಮ್ಹೋಡಪರ್ ಘುಮ್‌ಟೊ ಥೋತೆ ಇನಖ್ಹಾಜೆ ಇನ ಶೂಳೆ ಕರಿ ಲಾಝ್ಯೊ. <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />ಇನ ವ್ಹವ್‌ಕರಿ ಮಾಲುಮ್‌ ಪಡ್ಯುಕೊಂತೆ ವಾಟ್ಪರ್‌ಥೊ ವ್ಹೇಡಿ ಇನಾಕನ ಜೈ಼ನ್, “ಮಾರಿಜೋ಼ಡ್ಮ ಖ್ಹುವಾನ ಆವಸ್‌ಕಿಶೂ?” ಕರಿ ಬುಲಾಯೊ. ಇನೆ, “ಆವ್ಣುಕತೊ ಶಾತ್‌ದೀಶ್?” ಕರಿ ಬೋಲಿ. <verse eid="GEN 38:16" /><verse number="17" style="v" sid="GEN 38:17" />ಇನೆ, “ಮಂಧಾಮಾಥೊ ಎಕ್ ಬೋಕ್ಡೊ ದೀನ್ ಮೋಕ್ಲುಸ್, ಕರಿಬೋಲಖ್ಹತರ್ ಇನೆ ಬೋಲಿ ಯೊ ದ್ಯಾವಲಗು ಮಾರಕನ ಶಾತ್ತೋಬಿ ಆಡುಮ್ಹೇಲಾಸ್ ಕಿಶು? ಕರಿಬೋಲಿ. <verse eid="GEN 38:17" /><verse number="18" style="v" sid="GEN 38:18" />ಇನೆ, ಮೇ ಶಾತ್ ಆಡುಮ್ಹೇಲು ಕರಿ ಬೋಲಾಖ್ಹತರ್ ಹೈರಿತೆ, ತಾರೊ ಮುದ್ರಾನಿ ಅಂಗೂಠಿ, ಕಂದೋರೊ, ಹಾತ್ಮಾನೊ ಲಠ್ಠೊ, ಆ ತೀನ್ನಾಬಿ ಮ್ಹೇಲ್ ಕರಿಬೋಲಿ. ಇನೆ ಯೊ ಅಖ್ಖು ದೀನ್ ಇನಾಕನ ಖ್ಹುತೊ. ಹೈರಿತೆ ಇನಾಕನ ಬೇಜೂನಿ ಹುಯಿ. <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />ತದೆ ಯೊ ಘರ್ಕನ ಆಯಿನ್ ಇನೆ ಫೇರಿರಾಖಿಥೀತೆ ಘುಮ್‌ಟಾನ ಕಾಡಿ ಮ್ಹೇಲಿನ್ ಮುಂಡಚ್ಚಿನು ಪೇರ್ವಾಖ್ಹೊ ಪಾಛಿ ಫೇರಿಲಿದಿ. <verse eid="GEN 38:19" /><verse number="20" style="v" sid="GEN 38:20" />ಯೆಹೂದನೆ ಯೊ ತಯೇಡಕನ ಮ್ಹೆಲ್ಯೋತೆ ಆಡು ಛೋ಼ಡಾವಾನಖ್ಹಾಜೆ ಇನೊ ದೋಸ್ತಿ ಹುಯಿರೋತೆ ಅದುಲ್ಲಾಮ್ಯನ ಹಾತ್ಮ ಬೋಕ್ಡಾನು ಚೆಲ್ಕಾನ ದಿಮೋಕ್ಲಾಖ್ಹತರ್ ಯೋಹೈರಿತೆ ಇನ ಮಳಿಕೊಯ್ನಿ. <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />ಅದುಲ್ಲಾಮನೆ ಇನ ಗಾಮ್‌ವಾಳನ, “ಏನಯಿಮ್‌ಗಾಮ್ಕನ ವಾಟ್ನ ಭೀಡೆ ಬೆಠಿಥೀತೆ ಶೂಳೆಕ್ಯಾ?” ಕರಿ ಪುಛಾ಼ವಖ್ಹತರ್‌ ಇವ್ಣೆ, “ಹಜ್ಜಾ಼ ಖೆವಿ ಶೂಳೇಬಿ ಕೊಯ್ನಿ” ಕರಿ ಬೋಲ್ಯು. <verse eid="GEN 38:21" /><verse number="22" style="v" sid="GEN 38:22" />ಇನೆ ಯೆಹೂದಕನ ಪಾಛೋ಼ಫರಿ ಆಯಿನ್, “ಮನ ಯೊ ಮಳಿಕೊಯ್ನಿ ಅಜು಼ ಪುಛಾ಼ವನಿ ವಖ್ಹ್‌ತೆ ಯೊ ಗಾಮ್‌ವಾಳು ಹಜ್ಜಾ಼ ಖೆವಿ ಶೂಳೇಬಿಕೊಯ್ನಿ” ಕರಿ ಬೋಲ್ಯು. ಕರಿ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ. <verse eid="GEN 38:22" /><verse number="23" style="v" sid="GEN 38:23" />ಇನಖ್ಹಾಜೆ ಯೆಹೂದನೆ, “ಬಿಜು಼ ಅಪ್ಣೆ ಖ್ಹರಮ್‌ ಕಡೈಲಿಶು ಮೇ ಮ್ಹೇಲ್ಯೋತೆ ಆಡು ಯೋಸ್ ರಾಖಿಲ್ಯಾವಾದೆ, ಮೇತೊ ಬೋಕ್ಡಾನ ಚೆಲ್ಕಾನ ದೀಮೋಕ್‌ಲ್ಯೊ, ಯೋಹೈರಿತೆ ತುನ ಮಳಿಕೊಯ್ನಿ ಎತ್ರೇಸ್ ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 38:23" /><verse number="24" style="v" sid="GEN 38:24" />ಖ್ಹುಮಾರ್ ತೀನ್‌ಮಹಿನ ಹುವಾದಿನ್ ಯೆಹೂದನೆ, ಇನಿ ವ್ಹವ್ ತಾಮಾರ ವ್ಯಬಿಚಾರ್‌ಥಿ ಬೇಜೂನಿ ಹುಯಿರೀಸ್ ಕರಿ ಖಬರ್‌ನ ಖ್ಹಮ್‌ಜಿನ್, “ಇನ ಭಾರ್‌ಖೇಚಿಲ್ಯಾವೊ, ಬಾಳಿನಾಕ್ಣು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 38:24" /><verse number="25" style="v" sid="GEN 38:25" />ಇವ್ಣೆ ಇನ ಭಾರ್ ಖೇಚಿ ಲ್ಯಾವನಿವಖ್ಹ್‌ತೆ, ಹೈರಿತೆನೆ ಇನೊ ಮಾಮನ, ಯೊ ಆಡು ಮ್ಹೇಲಿಹುಯು ಜಿನಖ್ಹ್‌ಅಖ್ಖು ಮೋಕ್ಲಿನ್, “ಆ ಅಖ್ಖು ಕಿನೂಕಿ ಯೋಸ್ ಅದ್ಮಿಥೀಸ್‌ ಮೇ ಬೇಜೂನಿ ಹುಯಿರೀಸ್ತೆ. ಮುದ್ರಾನಿ ಅಂಗೂಠಿ, ಧಾಗೊ, ಲಠ್ಠೊ ಆ ಅಖ್ಖಾನಿ ಖ್ಹಣೇದ್ ದೇಖಿನ್ ಮಾಲುಮ್ ಕರಿಲಿಯೇಜಾ಼ಯ್” ಕರಿ ಬೋಲಿ ಮೋಕ್ಲಿ. <verse eid="GEN 38:25" /><verse number="26" style="v" sid="GEN 38:26" />ಯೆಹೂದನೆ ಯೊ ಅಖ್ಖಾನು ಖ್ಹಣೇದ್ ಧರೀನ್, “ಮೇ ಮಾರೊಛಿಯ್ಯೊ ಶೇಲಹನ ಇನ ವ್ಯಾಹ ಕರಿ ದಿದೊಕೊಂತೆ ಇನಖ್ಹಾಜೆ ಯೊ ಮಾರೇಥಿಬಿ ನ್ಯಾವ್‌ಥೀಸ್ ಚಾ಼ಲಿಲಿದಿ.” ಕರಿ ಬೊಲ್ಯೊ. ಇನೆ ಪಾಛೊ಼ ಇನಿ ಖ್ಹಂಗ್‌ ಕರ‍್ಯೊಕೊಯ್ನಿ. <verse eid="GEN 38:26" /><verse number="27" style="v" sid="GEN 38:27" />ತಾಮಾರನ ಜ಼ಣತ್‌ನ ದನ್ ಆವಾನಿವಖ್ಹ್‌ತೆ ಇನಪೇಟ್‌ಮ ಅವ್ಳಿಜವ್ಳಿ ಲಡ್ಕರ‍್ಹಾವಾನು ಮಾಲುಮ್ ಪಡ್ಯು. <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />ಯೊ ಜ಼ಣ್‌ವಾನಿವಖ್ಹತ್ ಎಕ್ ಲಡ್ಕು ಹಾತ್ ಖ್ಹಾಮೆ ಕರ್ತಾನ ತದೆ ಜ಼ಣಾವವಾಳಿನೆ, “ಆ ಪಹಿಲೆ ಪೈದಹುಯು” ಕರಿ ಇನ ಹಾತ್ನ ಲಾಲ್ ಧಾಗೊ ಭಾಂದಿ. <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />ಕತೋಬಿ ಯೊ ಹಾತ್ ಪಾಛು಼ ಕಾಡಿಲಿದು. ಇನಿ ಜೋ಼ಡ್ಮ ಥೂತೆ ಬಿಜೇಕ್ ಲಡ್ಕು ಪೈದಹುಯು. ಇನ ಜ಼ಣಾವವಾಳಿನೆ ದೇಖಿನ್‌, “ತೂ ಧಕೇಲಿನ್ ಆಯೋನಿ” ಕರಿ ಇನಖ್ಹಾಜೆ ಯೊ ಲಡ್ಕಾನ ‘ಪೆರೆಚ್‌’ ಕರಿ ನಾಮ್‌ಹುಯು. <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />ಇನಪಾರ್ ಹಾತ್ನ ಲಾಲ್‌ಧಾಗೊ ಭಂದಾಯುಹುಯು ಲಡ್ಕು ಪೈದಹುಯು. ಇನ, ‘ಜೆರಹ’ ಕರಿ ನಾಮ್‌ಹುಯು.<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">ಯೋಸೇಫ್ ಅಜು಼ ಪೋಟೀಫರನಿ ಬಾವಣ್‍</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />ಅಮ್ ಯೋಸೇಫ್‌ನ ಮೋಲ್ಲಿನ್‌ ಗಯುಹುಯ ಇಷ್ಮಾಯೇಲ್ಯವಾಳು ಈಜಿಪ್ಟ್‌ನ ಗಯು. ಹಿಜ಼್ಜಾ ಈಜಿಪ್ಟ್‌ನೊ ಪೋಟೀಫರ ಕರಿ ನಾಮ್‌ವಾಳನ ವೇಚಿನಾಖ್ಯು. ಹೈರೊತೆ ಫರೋಹನಿ ಆಸ್ಥಾನ್‌ಮ ಎಕ್ ಕಾಮ್‌ಗಿರಿ ಅಜು಼ ಶಿಪಾಯಿನೊ ಮೋಟೊ ಹುಯಿರ‍್ಹೊತೊ. <verse eid="GEN 39:1" /><verse number="2" style="v" sid="GEN 39:2" />ಯೆಹೋವ ದೇವ್‌ ಯೋಸೇಫ್‌ನಿ ಜೋ಼ಡ್ಮಥೋತೆ ಇನಖ್ಹಾಜೆ ಯೊ ಊಚೊ಼ ಭಡ್ತೊಹುಯಿನ್ ಈಜಿಪ್ಟ್‌ವಾಳೊಹುಯಿರ‍್ಹೊತೆ ಇನೊ ಯಜಮಾನ್ನ ಘರ್ಮ ಥೊ. <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />ಯೆಹೋವ ದೇವ್ ಯೋಸೇಫ್‌ನ ಜೋ಼ಡ್ಮ ರ‍್ಹೀನ್ ಯೊ ಕರಾತೆ ಅಖ್ಖಾ ಕಾಮ್ಮ ಜೀತ್‌ದೇಸ್‌ಕರಿ ಇನೊ ಯಜಮಾನ್ ಮಾಲುಮ್ ಕರ‍್ಯೊ. <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />ಪೋಟೀಫರನೆ ಯೋಸೇಫಪರ್ ದಯಾಕರೀನ್ ಇನ ಶೊಂತ್‌ ಘರ್‌ನ ದೇಖಿಲ್ಯಾವನ ರಾಖಿಲಿದೊ. ಆನಾಹುಯಿನ್, ಯೊ ಯಜಮಾನ್ನೆ ಇನಿ ಘರ್‌ನಿ ಜಿಮ್ಮೇದಾರಿಬಿ ಇನಿ ಅಖ್ಖೀಸ್ ಶೊತ್ನಬಿ ಯೋಸೇಫ್‌ನ ಹಾತ್ಮ ದಿನಾಖಿದಿದೊ. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />ಇನೆ ಯೋಸೇಫ್‌ನ, ಇನ ಘರ್‌ಪರ್‌ಬಿ ಶೊತ್‌ಪರ್‌ಬಿ ದೇಕ್‌ಬಾಲ್‌ಕರಾನ ದಿದೋತಪ್‌ಥೋ ಯೆಹೋವನೆ ಯೋಸೇಫ್‌ನಖ್ಹಾಜೇಥಿ ಯೊ ಈಜಿಪ್ಟ್‌ವಾಳನ ಘರ್‌ನ ಭಡಾಯೊ. ಘರ್‌ಮರ‍್ಹವೊ, ಖೇತರ್‌ಮರ‍್ಹವೊ, ಇನಥೂತೆ ಖ್ಹಾರಾಸ್‌ಪರ್ ಯೆಹೋವನಿ ಆಶೀರ್ವಾದ್‌ಹುಯು. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />ಇನಖ್ಹಾಜೆ ಪೋಟೀಫರನೆ ಇನಿ ಶೊತ್‌ಖ್ಹಾರು ಯೋಸೇಫ್‌ನ ಕಬ್‌ಜಾ಼ಮ ದಿನಾಖಿದಿದೊ. ಯೊ ಇನಾಕನ ಥೋತೆ ಇನಖ್ಹಾಜೆ ಯೊ ಖಾವಾನು ಖಾಣು ಏಕ್‌ನ ಮ್ಹೇಲಿನ್ ಬಿಜ಼ ಖೆವಾನಖ್ಹಾಜೇಬಿ ವೇಚ್‌ಣೆ ಕರ‍್ಯೊಕೊಯ್ನಿ. ಅಮ್ ಯೋಸೇಫ್ ರಂಗ್‌ರೂಪ್‌ಮ ಶನ್‌ಗಾರ್‌ನೊ ಹುಯಿರೋಥೊ <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />ಅಮ್‌ರ‍್ಹಾವಪರ್ ಯೋಸೇಫನೊ ಯಜಮಾನ್ ಫೊಟಿಫರನಿ ಬಾವಣ್ ಇನಾಪರ್ ಡೋಳನಾಖಿನ್, ಇನಜೋ಼ಡ್ಮ ಖ್ಹುವಾನ ಬುಲೈ. <verse eid="GEN 39:7" /><verse number="8" style="v" sid="GEN 39:8" />ಕತೋಬಿ ಯೋಸೇಫ್ ಮಾನ್ಯೊಕೊಂತೆ” ಮಾರೊ ಯಜಮಾನ್ ಇನಿ ಶೊತ್‌ಖ್ಹಾರು ಮಾರ ಕಬ್‌ಜಾ಼ಮ ದೀನ್‌, ಮೇ ಛೂ಼ತೆ ಇನಖ್ಹಾಜೆ ಘರ್‌ಮ ಚಾ಼ಲಾತೆ ಖೆವ ಕಾಮ್‌ನಾಬಿ ವೇಚ಼್‌ಣೆಕರಾಕೊಂತೆ ಛಾ಼? <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />“ಆ ಘರ್‌ಮ ಮಾರೇಥಿ ಮೊಟು ಕೋಣ್‌ಬಿಕೊಯ್ನಿ; ತೂ ಇನಿ ಬಾವಣ್‌ಹುಯಿರೀತೆ ಇನಾಖ್ಹಾಜೆ ತುನಾಖಲಿ ಮಾರ ಕಬ್‌ಜಾ಼ಮ ದಿದೋಕೊಯ್ನಿ; ಅಮ್‌ರ‍್ಹಾವಪರ್ ಮೇ ಅಥ್ರಾನು ಮೋಟುಖರಾಬ್‌ಕಾಮ್ ಕರೀನ್ ದೇವ್ನ ಖ್ಹಾಮ್ಣೆ ಕಿಮ್ ಪಾಪ್‌ಕರು?” ಕರಿ ಇನ ಯಜಮಾನ್ನಿ ಬಾವಣ್ಣ ಜ಼ವಾಬ್‌ದಿದೊ. <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />ಹೈರಿತೆ ಯೋಸೇಫ್‌ನಿ ಜೋ಼ಡ್ಮ ಹರೇಕ್ ರೋಜ಼್ ಆ ವಾತ್ ಬೋಲಿತೋಬಿ ಇನೆ ಕಾನ್‌ದಿದೊಕೊಂತೆ ಇನಿ ಜೋ಼ಡ್ಮ ಖ್ಹುವಾನರ‍್ಹವೋ ಇನ ಖನ್ನೆ ರ‍್ಹವಾನರ‍್ಹವೊ ಮಾನ್ಯೋಸ್‌ಕೊಯ್ನಿ. <verse eid="GEN 39:10" /><verse number="11" style="v" sid="GEN 39:11" />ಅಮ್‌ರ‍್ಹವಾಪರ್ ಏಕ್‌ದನ್ ಯೊ ಇನ ಕಾಮ್‌ಪರ್ ಘರ್‌ಕನ ಐರ‍್ಹಾವಾನಿವಖ್ಹ್‌ತೆ ಘರ್‌ಮ ಆಳ್‌ ಕೋಣ್‌ಬಿ ಮಹಿಥೂಕೊಯ್ನಿ. <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />ತದೆ ಹೈರಿತೆ ಇನ ಲುಂಗ್ಡಾನ ಧರ್‌ಲೀನ್, “ಮಾರಕನ ಖ್ಹುವಾನ ಆವ್” ಕರಿ ಬೋಲಖ್ಹತರ್ ಯೋಸೇಫ್‌ನೆ ಇನು ಝ಼ಗ್ಗಾನ ಇನ ಹಾತ್‌ಮಾಸ್ ಮ್ಹೆಂದಿನ್‌ ನಾಶಿಚ಼ಲೇಗೊ. <verse eid="GEN 39:12" /><verse number="13" style="v" sid="GEN 39:13" />“ಇನೆ ಇನು ಝ಼ಗ್ಗಾನ ಮಾರಹಾತ್‌ಮಾಸ್ ಮ್ಹೇಲಿನ್ ನಾಶಿಚ಼ಲೇಗೋನಿ” ಕರಿ ಬೋಲಿನ್, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />ಇನ ಘರ್‌ನ ಆಳ್‌ನ ಬುಲೈನ್, “ದೇಖೊ, ಮಾರ ಬಾವ್ರಿನೆ ಎಕ್ ಇಬ್ರಿಯವಾಳನ ಅಪ್ಣಾಮ ಮಳೈಲೀನ್ ಅಪ್ಣುನ ಚಾ಼ವ್‌ಣ್ಯ ಕಡೈನಾಖ್ಯೊ. ಯೊ ಅದ್ಮಿ ಮನ ಮಾನ್‌ಭಂಗ ಕರಾನಖ್ಹಾಜೆ ಮಾರಾಕನ ಆಯೊ. ಮೇ ಜೋ಼ರೇಖ್ಹು ಚಿಕ್ರಿಪಡಿ. <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />ಅಜು಼ ಮೇ ಮದತ್‌ನಖ್ಹಾಜೆ ಚಿಕ್ರಾಖ್ಹತರ್‌ ಇನೆ ಇನು ಝ಼ಗ್ಗಾನ ಮಾರಕನಾಸ್ ಮ್ಹೇಲಿ ಘರ್‌ಮಾಥೊ ನಾಶಿಚ಼ಲೇಗೊ. ಕರಿ ಬೋಲಿ. <verse eid="GEN 39:15" /><verse number="16" style="v" sid="GEN 39:16" />ಯೋಸೇಫ್‌ನೊ ಯಜಮಾನ್ ಘರ್‌ಕನ ಆವಲಗೂಬಿ ಯೊ ಝ಼ಗ್ಗಾನ ಇನಾಕನಸ್ ಮಿಛಾ಼ಣಿರಾಖಿಥಿ. <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />ಬಾವ್ರಿ ಆವಾನಿವಖ್ಹ್‌ತೆ ಇನೆ ಖೇಣಿ ಬೋಲಿವತಾಳಿ, “ಇನ, ತೂ ಬುಲೈರಾಖ್ಯತೆ ಯೊ ಇಬ್ರಿಯನೊ ಆಳ್‌ ಮನ ಮಾನ್‌ಭಂಗಕರಾನ ಮಾರಾಕನ ಆಯೊ. <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />ಕತೋಬಿ ಮೇ ಜೋ಼ರೇಖ್ಹು ಚಿಕ್ರಾನಿ ವಖ್ಹ್‌ತೇಸ್‌ ಇನೆ ಇನೊ ಝ಼ಗ್ಗೊ ಮಾರಕನ ಮ್ಹೇಲಿನ್ ನಾಶಿಚ಼ಲೇಗೊ” ಕರಿ ಬೋಲಿ. <verse eid="GEN 39:18" /><verse number="19" style="v" sid="GEN 39:19" />“ತಾರೊ ಸೇವಕ್‌ನೆ ಮನ ಅಮ್‌ಕರ‍್ಯೊ” ಕರಿ ಬೋಲಿತೆ ಇನಿ ವಾತ್ನ ಖ್ಹಮ್‌ಜಿನ್ ಯಜಮಾನ್‌ ಘಣು ಚ಼ಂಢಾಳ್‌ ಛ಼ಡಾಯೊ, <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />ತದೆ ಯೋಸೇಫನ ಧರೈನ್ ರಾಜ಼ನೆ ಚೋ಼ರ್‌ನ ಭಂದೈರಾಖ್ಯೋಥೋತೆ ಜೇಲ್‌ಮ ಘಲಾಯೊ. ಹಿಜ್ಜಾ಼ ಯೋಸೇಫ ಜೇಲ್‌ಮ ರ‍್ಹೇವ್ಣುಥು. <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />ಕತೋಬಿ ಯೆಹೋವ ಯೋಸೇಫ್‌ನಿ ಜೋ಼ಡ್ಮರ‍್ಹೀನ್ ಇನಾಪರ್ ಆಶೀರ್ವಾದ್‌ ರಾಖಿನ್ ಇನ ಜೇಲ್‌ನೊ ಯಜಮಾನ್‌ಕನ ದಯಾಮಳಾನಿತರ ಕರ‍್ಯೊ. <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />ಜೇಲ್‌ನೊ ಯಜಮಾನ್‌ನೆ ಜೇಲ್‌ಮ ಥೂತೆ ಖ್ಹಾರಾಸ್ನ ಯೋಸೇಫ್‌ನ ಹಾತ್ಮ ದಿನಾಖಿದಿದೊ. ಹಿಜ್ಜಾ಼ ಕರ‍್ನುಥೂತೆ ಖ್ಹಾರೂಸ್ ಕಾಮ್‌ ಯೋಸೇಫ್‌ನೇಸ್ ಕರಾಯೊ. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />ಯೆಹೋವನೆ ಇನಿ ಜೋ಼ಡ್ಮ ರ‍್ಹೀನ್ ಇನೆ ಕರ‍್ಯೋತೆಖ್ಹಾರೂಸ್ ಕಾಮ್ಮ ಜೀತ್‌ದಿದೋತೆ ಇನಖ್ಹಾಜೆ ಇನ ಹಾತ್ಮಥೂತೆ ಖೆವಿ ಎಕ್ ಬಾರೆಮಾಬಿ ಜೇಲ್‌ನೊ ಯಜಮಾನ್ ಶಾತ್‌ಬಿ ವೇಚ಼್‌ಣೆಕರ‍್ಯೋಕೊಯ್ನಿ.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">ಯೋಸೇಫ್‌ಥಿ ಖ್ಹೋಣ್ಯಾನು ಮತ್ಲಬ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />ಆಖ್ಹಾರು ಚಾ಼ಲನ ಬಾದ್ಮ ಈಜಿಪ್ಟ್‌ನೊ ರಾಜ಼ ಫರೋಹನ ದ್ರಾಕ್ಷಿನೊರಖ್ಹ್‌ ದ್ಯವಾಳೊ ಅಜು಼ ಭೋಜ಼ನ್ ಪಿಕೈದ್ಯವಾಳೊ ಖೆವೀಕಿ ಎಕ್ ಬಾರೇಮ ಇವ್ಣ ಯಜಮಾನ್ನ ಧೋಕೊ ದೀರಾಖ್ಯಾಥ. <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />ಇನಖ್ಹಾಜೆ ಫರೋಹನೆ ಯೊ ಭೇಜ಼ಣ ಕಾಮ್‌ವಾಳ ಅದಿಕಾರಿಪರ್‌ ಇರಾದೊ ಕರೀನ್, <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />ಇವ್ಣುನ ಕಾವಲ್ ಕರವಾಳನೊ ಅದಿಕಾರಿನ ಘರ್‌ಮ ಯೋಸೇಫ ಥೋತೇಸ್‌ ಜೇಲ್‌ಮ ಕೋಂಡಿರಾಖ್ಯೊಥೊ. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />ತದೆ ಶಿಪಾಯಿನೆ ಯೊ ಬೇಜ಼ಣಾನ ದೇಕ್‌ಬಾಲ್‌ಕರಾನು ಯೋಸೇಫ್‌ನ ದಿದೋ. ಇನಾಖ್ಹಾಜೆ ಯೋಸೇಫ ಇವ್ಣಿ ಚಾ಼ಕ್ರಿ ಕರ್ನುಪಡ್ಯೂಥು. <verse eid="GEN 40:4" /><verse number="5" style="v" sid="GEN 40:5" />ಅಮ್ ಇವ್ಣೆ ಥೋಡ ದನ್ ಕಾವಲ್‌ಮರ‍್ಹಾವದೀನ್ ಇವ್ಣ ಭೇಜ಼ಣಾನಾಬಿ ಕತೊ, ಈಜಿಪ್ಟ್‌ನೊ ರಾಜ಼ನೆ ಜೇಲ್‌ಮ ಘಲೈರಾಖ್ಯೋಥೋತೆ ದ್ರಾಕ್ಷಿನೊ ರಖ್ಹ್ ದ್ಯಾವಾಳನಾಬಿ, ಭೋಜ಼ನ್‌ ಪಿಕಾವವಾಳನಾಬಿ ಎಕ್ಕಸ್ ರಾತ್ಮ ಖ್ಹೋಣ್ಯುಪಡ್ಯು; ಇವ್ಣ ಭೇಜ಼ಣಾನ ಖ್ಹೋಣ್ಯಾನ ಅಲಕ್‌ ಅಲಕ್ ಮತ್‌ಲಬ್‌ಥು. <verse eid="GEN 40:5" /><verse number="6" style="v" sid="GEN 40:6" />ವ್ಹಾಣೆ ಯೋಸೇಫ್ ಇವ್ಣಕನ ಆವಾಮ ಇವ್ಣೆ ವೇಚ಼್‌ಣೆಮ ರ‍್ಹವಾನಿಘೋಣಿ ದೆಖಾಯು. <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />ಅನ, ಇನೆ ದೇಖಿನ್, “ತುಮಾರುಮ್ಹೋಡು ಶನಾ ಉದಾಶಿ ಛಾ?” ಕರಿ ಇನಿ ಜೋ಼ಡ್ಮ ಜೇಲ್ಮಥೂತೆ ಫರೋಹನ ಕಾಮ್‌ವಾಳನ ಪುಛಾ಼ಯೊ. <verse eid="GEN 40:7" /><verse number="8" style="v" sid="GEN 40:8" />ಇವ್ಣೆ, “ಹಮುನ ಖ್ಹೋಣ್ಯುಪಡ್ಯು; ಇನು ಮತ್ಲಬ್‌ನ ಬೋಲಾವಾಳು ಕೋಣ್‌ಬಿ ಕೊಯ್ನಿ” ಕರಿ ಬೋಲ್ಯು. ತದೆ ಯೋಸೇಫ್‌ನೆ ಇವ್ಣುನ, “ಖ್ಹೋಣ್ಯಾನು ಮತ್‌ಲಬ್ ದೇವ್‌ಥಿ ಮಳೇಜಾ಼ಯಿ ಕೊಯ್ನಿಕಿ ಶು? ತುಮಾರು ಖ್ಹೋಣ್ಯು ಮನ ಬೋಲೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 40:8" /><verse number="9" style="v" sid="GEN 40:9" />ತದೆ, ಯೊ ದ್ರಾಕ್ಷಿನೊ ರಖ್ಹ್‌ದ್ಯಾವಾಳೊ ಅದಿಕಾರಿನೆ ಯೋಸೇಫ್‌ನ, “ಮಾರ ಖ್ಹೋಣ್ಯಾಮ ಎಕ್ ದ್ರಾಕ್ಷಿನೊ ವೇಲೊ ಮಾರಖ್ಹಾಮ್ಣೆ ರ‍್ಹಾವಾನು ದೇಖ್ಯೊ. <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />ಇನ ತೀನ್ ಡಾಳಿಯೇಥಿ. ಯೊ ಚಿಗುರ್‌ತಾನಸ್ ಫೂಲ್ ಖ್ಹಾರು ಮ್ಹೇಲ್ಯು; ಯೊ ಫೂಲ್‌ಖ್ಹಾರು ಗುಚ್ಚಾ಼ಹುಯಿನ್ ಪಂಡು ಮ್ಹೇಲಿನ್‌ ಪಕಾಯು. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />ಫರೋಹನು ಪಿಯಾನುರಾಛು಼ ಮಾರ ಹಾತ್‌ಮಥೂತೆ ಇನಾಖ್ಹಾಜೆ ಮೇ ಯೊ ಗುಚ಼್ಚಾವ್ನ ವ್ಹಾಡಿನ್ ರಾಛಾ಼ಮ ನಿಚೋಡಿನ್‌ ಫರೋಹನ ಹಾತ್‌ಮ ದಿದೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 40:11" /><verse number="12" style="v" sid="GEN 40:12" />ಇನ ಯೋಸೇಫ್‌ನೆ, “ಯೊ ಖ್ಹೋಣ್ಯಾನು ಮತ್‌ಲಬ್ ಶಾತ್‌ಕತೊ, ಯೊ ತೀನ್ ಡಾಳಿಸ್ ತೀನ್ ದನ್‌ಖ್ಹಾರು; <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />ಬಿಜು಼ ತೀನ್ ದನ್ಮ ತುನ ಛುಟ್ಕಾರ್ ಕರ್‌ಶೆ, ತುನ ಕ್ಷಮಾಪಣ್ ಕರ್‌ಶೆ ಫರೋಹ ತುನ ಪಾಛೋ಼ ಕಾಮ್ಮ ಮಳೈಲಿಶೆ; ತೂ ಇನ ಅಗಾಡಿನಿತರಸ್ ಫರೋಹನ ದ್ರಾಕ್ಷಿನೊರಖ್ಹ್‌ ದ್ಯಾವಳೊ ಹುಯಿನ್ ಇನ ಹಾತ್ಮ ಪಾಛೊ಼ ಪಿಯಾನ ರಾಛ಼ನ ದೀಶ್. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />ಕತೋಬಿ ತೂ ಖ್ಹುಕ್‌ಥಿ ರ‍್ಹವಾನಿವಖ್ಹ್‌ತೆ ಮನ ಮದತ್‌ ಕರಾನು ಭೈಕೀಶ್‌ನಕೋತೆ ಫರೋಹನ ಮಾರಿಬಾರೇಮ ಖ್ಹಮ್‌ಜಾ಼ಡಿನ್‌ ಮನ ಆ ಜೇಲ್‌ಮಾಥೊ ಛೋ಼ಡಾವ್ಣು. <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />ಮೇ ಇಬ್ರಿಯ ದೇಖ್ಹ್‌ವಾಳೊ. ಥೋಡಜ಼ಣಾನೆ ಮನ ಗುಲಾಮ್‌ಬಣೈನ್ ಆ ದೇಖ್ಹ್‌ನ ಧರಿಲಾಯು. ಹಜ್ಜಾ಼ಬಿ ಮೇ ಶನೂಬಿ ಗಲತ್‌ಕರ‍್ಯೊಕೊಂತೆ ಜೇಲ್‌ಮ ಘಲಾಯೊ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />ಯೋಸೇಫ್‌ನೆ ಬೋಲ್ಯೋತೆ ಮತ್ಲಬ್‌ ಅಛ಼್ಛು ಹುಯಿರುಸ್‌ ಕರಿ ಮಾಲುಮ್ ಕರಿಲಿದೋತೆ ಯೊ ಅದಿಕಾರಿನೆ ಭೋಜ಼ನ್‌ ಪಿಕಾವವಾಳನೆ ಇನ, “ಮೇ ದೇಖ್ಯೊತೆ ಖ್ಹೋಣ್ಯಾನ ಬೋಲೂಸ್ ಖ್ಹಮಜ್; ಅಛ್ಛೂ಼ಖ್ಹು ರೋಟ ಭರೈರ‍್ಹೂತೆ ತೀನ್ ಟೋಕ್ರಿಯೇ ಮಾರ ಮುಡ್‌ಕ್ಯಾಪರ್‌ಥು. <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />ಉಪ್ಪರ್‌ಲಿ ಟೋಕ್ರಿಮ ಅಲಕ್‌ ಅಲಕ್‌ ಥರಾನು ಚೀಜ಼್ ಫರೋಹನ ಖ್ಹಾಜೆಥು. ಜಿನಾವರ್‌ ಅಯಿನ್ ಯೊ ಅಖ್ಖಾನ ಮಾರ ಮುಡ್‌ಕ್ಯಾಪರ್‌ನಿ ಟೋಕ್ರಿಮಾಥುಸ್‌ ಖವ್‌ಕರ್ತೂಥು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 40:17" /><verse number="18" style="v" sid="GEN 40:18" />ಇನ ಯೋಸೇಫ್‌ನೆ, “ತಾರ ಖ್ಹೋಣ್ಯಾನು ಮತ್‌ಲಬ್ ಶಾತ್‌ಕತೊ, ಯೊ ತೀನ್ ಟೋಕ್ರೀಸ್ ತೀನ್ ದನ್; <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />ಬಿಜು಼ ತೀನ್ ದನ್ನಾಮಹಿ ಫರೋಹ ತಾರ ಘಲೆಂಡಾನ ಕತ್‌ರೈನ್ ತಾರ ಧಡ್‌ನ ಝಾ಼ಡ್ನ ಠಂಗಾವ್‌ಶೆ; ಜಿನಾವರ್‌ ಆಯಿನ್‌ ತಾರಿ ಬೋಟಿನ ತೋಡಿನ್‌ ಖೈನಾಕ್‌ಶೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 40:19" /><verse number="20" style="v" sid="GEN 40:20" />ತೀನ್ನ ದನ್ಮ ಫರೋಹನು ಪೈದಾಖ್ಹ್‌ನೊ ದನ್‌ಹುಯಿರೋಥೋತೆ ಇನಖ್ಹಾಜೆ ಇನೆ ಇನು ಆಳ್‌ಖ್ಹಾರಾನ ಇರಂದಿ ಪಿಕೈನ್‌, ಮುಖಿಯ ಪಾನದ್ಯವಾಳನಬಿ ಮುಖ್ಯ ಬೋಜ಼ನ್‌ಕರವಾಳನಬಿ ಛುಟ್ಕಾರ್ ಕರ‍್ಯೊ. <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />ಪಾನದ್ಯವಾಳ ಮುಖ್ಯನ ಪಾಛೋ಼ ಇನ ಕಾಮ್‌ದಿದೊ; ಇನೆ ಪಾನ್ಕನ ರಾಛ಼ನ ಫರೋಹನ ಹಾತ್ಮ ದ್ಯಾವಖ್ಹರ್‌ಕುಹುಯು; <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />ಕತೋಬಿ ಭೋಜ಼ನ್‌ ಕರಾವಾಳ ಮುಖ್ಯನ ಫಾಖ್ಹೋದಿದೊ. ಅಮ್ ಯೋಸೇಫ್‌ನೆ ಬೋಲ್ಯೋತೆ ಇಮ್ಮಸ್ ಹುಯು. <verse eid="GEN 40:22" /><verse number="23" style="v" sid="GEN 40:23" />ರ‍್ಹಯುತೋಬಿ ಪಾನ್ಕವಾಳನ ಮುಖ್ಯನೆ ಯೋಸೇಫ್‌ನ ಯಾದ್‌ಕರ‍್ಯೊ ಕೊಂತೆ ಭೈಕಿಗೊ.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">ಯೋಸೆಫ್‌ನೆ ಫರೋಹನ ಖ್ಹೋಣ್ಯವ್‌ನಿ ಮತ್ಲಬ್‌ ಬೋಲ್ಯೋತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />ಬೇ ವರಖ್ಹ್‌ ಹುವಾದಿನ್ ಫರೋಹನ ಎಕ್ ಖ್ಹೋಣ್ಯು ಪಡ್ಯು. ಯೊ ಖ್ಹೋಣ್ಯಾಮ ನೈಲ್ ನದ್ದಿನ ಕನಾರಿಪರ್ ಭಿಯ್ಯೋಥೊ. <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />ತದೆ ಖ್ಹಾಜ಼್‌ಥಿ ರ‍್ಹವಾನಿ ಖ್ಹಾತ್ ಪಲಿಹುಯಿ ಗೈಯೆ ಯೊ ನೈಲ್‌ ನದ್ದಿನ ಮಹಿಥು ಆಯಿನ್ ಘಾಖ್ಹ್‌ ಚ಼ರಾಲಗಿಥಿಯೇ಼. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />ಇನ ಪೀಠೇಸ್ ಖ್ಹುಕ್‌ಲಿ ಖ್ಹಾತ್ ಬಂಕೋಡಿ ಗೈಯೆ ನೈಲ್‌ ನದ್ದಿನ ಮಹಿಥು ಆಯಿನ್ ಪಹಿಲೆ ದೆಖೈಯೇತೆ ಗೈಯೇಕನ ಭೀರಿಗೈಯೆ. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />ಬಂಕೋಡಿ ಗೈಯೆನೆ ಖ್ಹಾಜ಼್‌ನಿ ಯೊ ಪಲಿಹುಯಿ ಗೈಯೆನ ಖೈಲಿದಿಯೆ. ಎತ್ರಾಮ ಫರೋಹನ ಹೊಷಾರಿ ಹುಯಿಗಯು <verse eid="GEN 41:4" /><verse number="5" style="v" sid="GEN 41:5" />ಯೊ ಪಾಛೊ಼ ನಿಂದರ್‌ ಕರಾದಿನ್‌ ಬಿಜೇಕ್ ಖ್ಹೋಣ್ಯುಪಡ್ಯು. ಯೊ ಶಾತ್‌ಕತೊ ದಾಣಭರಾಯುಹುಯು ಖ್ಹಾತ್ ಮುಡ್‌ಕ್ಯಾನು ಪಕೇಟ್ ಬುಟ್ಟುಖ್ಹಾರು ಎಕ್ಕಸ್ ಡಂಟ್‌ಮ ಫುಟ್ಯು. <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />ಇನ ಪೀಠೆಸ್ ಚ಼ಢ್‌ತಿ ಬಾಜೂ಼ನ ವಹಿರೇಥಿ ಖ್ಹುಕೈನ್, ತಶೀಗಯುತೆ ಬಿಜು಼ ಖ್ಹಾತ್ ಮುಡ್‌ಕ್ಯನು ಬುಟ್ಟು ಫುಟ್‌ತು ಆಯು. <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />ಅಜು಼ ತಶೀಗಯುಹುಯು ಯೊ ಬಂಕೋಡ್ಯು ಖ್ಹಾತ್ ಮುಡ್‌ಕ್ಯಾನು ಬುಟ್ಟುಖ್ಹಾರು ದಾಣಭರಾಯುಹುಯು ಯೊ ಖ್ಹಾತ್ ಮುಡ್‌ಕ್ಯಾನ ಪಕೇಟ್ ಬುಟ್ಟಾನ ಗಳಿಲಿದು. ಎತ್ರಾಮ ಫರೋಹನೆ ಹೊಷಾರಿ ಹುಯಿನ್, ಇನೆ ದೇಖ್ಯೋತೆ ಖ್ಹೋಣ್ಯು ಕರಿ ಮಾಲುಮ್‌ಕರ್‌ಲಿದೊ. <verse eid="GEN 41:7" /><verse number="8" style="v" sid="GEN 41:8" />ವ್ಹಾಣೆಮ ಇನೊ ದಿಲ್‌ಮ ಕಲಾವ್ಣಿ ಹುಯಿನ್‌, ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮಥೂತೆ ಖ್ಹಾರೂಸ್ ಪೊಂಡಿತ್‌ನಾಬಿ ಗ್ಯಾನಿನಾಬಿ ಬುಲೈಮಂಗಾಯೊ. ಇವ್ಣುನ ಇನು ಖ್ಹೋಣ್ಯು ಬೋಲಿವತಾಳ್ಯೊ. ಯೊ ಮತ್ಲಬ್‌ನ ಇನ ಬೋಲಿವತಾಳವಾಳು ಕೋಣ್ಬಿ ಮಳ್ಯುಕೊಯ್ನಿ.<verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />ತದೆ ಪಾನದ್ಯಾವಾಳ ಆಳ್‌ನ ಅದಿಕಾರಿನೆ ಫರೋಹನ, “ರಾಜ಼ ಆ ವಖ್ಹತ್ ಮಾರಿ ಗಲತ್‌ನ ಮೇ ಮಾನಿಲೇವ್ಣು. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />ತೂ ತಾರ ಆಳ್‌ಪರ್ ಇರಾದೊಕರೀನ್ ಮನಾಬಿ ಯೊ ಭೋಜ಼ನ್ ಪಿಕಾವವಾಳನ ಮೋಟಾನಾಬಿ ಶಿಪಾಯಿನ ಘರ್‌ಮ ಕಾವಲ್‌ಮ ರಾಖಾನಿವಖ್ಹ್‌ತೆ ಹಮುನ ಭೇಜ಼ಣಾನಾಬಿ <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />ಎಕ್ಕಸ್‌ ರಾತ್ಮ ಖ್ಹೋಣ್ಯು ಪಡ್ಯು, ಏಕೇಕ್‌ ಜ಼ಣಾನ ಖ್ಹೋಣ್ಯಾನ ಅಲಕ್‌ ಅಲಕ್ ಮತ್‌ಲಬ್‌ಥು. <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />ಹಿಜ್ಜಾ಼ ಹಮಾರಿ ಜೋ಼ಡ್ಮ ಇಬ್ರಿಯವಾಳೊ ಎಕ್ ಜ಼ವಾನಿಥೊ; ಯೊ ಶಿಪಾಯಿನೊ ಆಳ್‌. ಹಮೆ ಇನ ಹಮಾರ ಖ್ಹೋಣ್ಯಾನ ಬೋಲಖ್ಹತರ್‌ ಇನೆ ಯೊ ಅಖ್ಖಾನು ಮತ್ಲಬ್‌ನ ಹಮುನ ಬೊಲ್ಯೊ; ಹಮಾರ ಖ್ಹೋಣ್ಯಾನಿ ಪರಕ್ ಬರೋಬರಸ್ ಬೊಲ್ಯೊ. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />ಎತ್ರೇಸ್ ಕಾಹೆತೆ ಇನೆ ಹಮುನ ಬೋಲ್ಯೋತೆ ಪರಕ್ಕಸ್‌ಹುಯು. ಮನ ಪಾಛು಼ ಕಾಮ್‌ಬಿ ಮಳ್ಯು. ಯೊ ಭೋಜ಼ನ್‌ ಪಿಕಾವವಾಳನ ಫಾಖ್ಹೊದೆವಾಯು” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />ಅನ ಖ್ಹಮ್‍ಜ್ಯೋತೆ ಫರೋಹನೆ ಯೋಸೇಫ್‌ನ ಬುಲೈಮಂಗಾಯೊ. ಯೋಸೇಫ್‌ನೆ ಒಗ್ಗೀಸ್ ಜೇಲ್‌ಮಾಥೊ ಛು಼ಟೀನ್ ಢಾಡಿ ಮೂಂಡೈಲೀನ್‌ ಅಲಕ್ ಲುಂಗ್‌ಡು ಫೇರಿಲೀನ್ ಫರೋಹಕನ ಆಯೋ. <verse eid="GEN 41:14" /><verse number="15" style="v" sid="GEN 41:15" />ತದೆ ಫರೋಹನೆ ಯೋಸೇಫ್‌ನ, “ಮೇ ಎಕ್ ಖ್ಹೋಣ್ಯು ದೇಖ್ಯೊ, ಇನಿ ಮತ್ಲಬ್‌ ಬೋಲಾವಾಳು ಕೋಣ್‌ಬಿಕೊಯ್ನಿ. ಕತೋಬಿ ತೂ ಖ್ಹೋಣ್ಯು ಖ್ಹಮಜ಼್‌ತಾಸ್‌ನ ಇನು ಮತ್‌ಲಬ್ ಬೋಲಸ್‌ಕರಿ ಖಬರ್‌ ಖ್ಹಮ್‌ಜ್ಯೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 41:15" /><verse number="16" style="v" sid="GEN 41:16" />ಯೋಸೇಫ್‌ನೆ, “ಮನಶಾತ್‌ಬಿ ಮಾಲುಮ್‌ಕೊಯ್ನಿ. ಕತೋಬಿ ದೇವಸ್‌, ಫರೋಹ ಹುಯಿರೋತೆ ತುನ ಸಮಾಧಾನ್ನು ಫೇಡ್ ದ್ಯವಾಳೊ ಹುಯಿರೋಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 41:16" /><verse number="17" style="v" sid="GEN 41:17" />ತದೆ ಫರೋಹನೆ ಯೋಸೇಫ್‌ನ, “ಖ್ಹೋಣ್ಯಾಮ ಮೇ ನೈಲ್ ನದ್ದಿನು ಕನಾರಿಪರ್ ಭಿಯ್ಯೋಥೊ. <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />ನೈಲ್‌ ನದ್ದಿನ ಮಹಿಥು ಖ್ಹಾಜ಼್‌ನಿ ಖ್ಹಾತ್ ಪಲಿಹುಯಿ ಗೈಯೆ ಆಯಿನ್ ಘಾಖ್ಹ್‌ಮ ಚ಼ರುಕರ್‌ತಿಥೀಯೆ. <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />ಯೊ ಅಖ್ಖಾನ ಪೀಠೇಸ್ ಘಣು ಬಂಕೋಡಿ ಹುಯಿರೀತೆ ಬಿಜಿ ಖ್ಹಾತ್ ಗೈಯೆ ಅಯ್ಯೆ. ಎಥ್ರಾನಿ ಬಂಕೋಡಿ ಗೈಯೇನ ಮೇ ಈಜಿಪ್ಟ್‌ಮ ಕಿಜ್ಜಾ಼ಬಿ ದೇಖ್ಯೋಕೊಯ್ನಿ. <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />ಆನಾಹುಯಿನ್, ಬಂಕೋಡಿ ಹುಯಿರಿಯೇತೆ ಯೊ ಬಂಕೋಡಿ ಗೈಯೆನೆ ಫೈಲೇಸ್ ದೆಖೈಯೇತೆ ಯೊ ಖ್ಹಾತ್ ಗೈಯೇನ ಖೈಲಿದಿಯೆ. <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />ಖಾದಿಯೇತೋಬಿ ಖಾದಿಯೇಂತ್ರ ದೆಖಾಯುಕೊಯ್ನಿ. ಯೊ ಅಗಾಡಿಥೂತೆ ತಿಮ್ಮಸ್ ಬಂಕೋಡಿಸ್‌ಥಿಯೇ. ಎತ್ರಾಮ ಮನ ಹೋಷಾರಿ ಹುಯಿಗು. <verse eid="GEN 41:21" /><verse number="22" style="v" sid="GEN 41:22" />ಮನ ಪಡ್ಯುತೆ ಬಿಜೇಕ್ ಖ್ಹೋಣ್ಯಾಮ ದಾಣೊ ಭರಾಯುಹುಯು ಖ್ಹಾತ್ ಮುಡ್‌ಕ್ಯಾನ ಪಕೇಟ್ ಬುಟ್ಟು ಎಕ್ಕಸ್ ಡಂಟ್‌ಮ ಫುಟಿರ‍್ಹಯುಥು. <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />ಇನ ಪೀಠೇಸ್ , ಚ಼ಢ್‌ತಿಬಾಜು಼ನೊ ಗರಮ್‌ ವಹಿರಾಮ ತಶೀನ್, ಖ್ಹುಕೈನ್ ಖರಾಬ್‌ಹುಯ್ಗುತೆ ಬಿಜು಼ ಖ್ಹಾತ್ ಮುಡ್‌ಕ್ಯಾನು ಬುಟ್ಟು ಫುಟಿನ್‌ಆಯು. <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />ತಶೀಗಯುತೆ ಬುಟ್ಟುಖ್ಹಾರು ದಾಣ ಭರೈರ‍್ಹುಥೂತೆ ಯೊ ಖ್ಹಾತ್ ಬುಟ್ಟಾನ ಗಳಿಲಿದು. ಆ ಖ್ಹೋಣ್ಯಾನ ಪೊಂಡಿತ್‌ಖ್ಹಾರಾನ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ; ಯೊ ಅಖ್ಖಾನು ಮತ್ಲಬ್‌ನ ಛೋ಼ಡಿಬೋಲಾನ ಇವ್ಣಾಮ ಕಿನೇಥಿಬಿ ಹುಯುಕೊಯ್ನಿ.<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />ಯೋಸೇಫ್‌ನೆ ಫರೋಹನ, “ಇವ್ಣೆ ದೇಖ್ಯಾತೆ ಬೇ ಖ್ಹೋಣ್ಯಾನಿ ವಾತ್ ಎಕ್ಕಸ್‌. ದೇವ್‌ಕರ್‌ನುಕರಿ ಛಾ಼ತೆ ಇನ ಆ ಅಖ್ಖಾಥಿ ತುನ ಖ್ಹಮ್‌ಜಾ಼ಡಿರಾಖ್ಯೋಸ್. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />ಯೊ ಖ್ಹಾತ್ ಪಲಿಹುಯಿ ಗೈಯೆಸ್ ಖ್ಹಾತ್ ವರಖ್ಹ್‌; ಯೊ ಖ್ಹಾತ್ ಅಛ್ಛಾ಼ ಬುಟ್ಟಾಬಿ ಖ್ಹಾತ್ ವರಖ್ಹ್‌; ಬೇ ಖ್ಹೋಣ್ಯಾನಿ ಮತ್‌ಲಬ್ ಎಕ್ಕಸ್. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />ಅಛ್ಛಿ ಗೈಯೆನ ಪೀಠೆ ಅಯ್ಯೇತೆ ಬಂಕೋಡಿ ಹುಯಿರ‍್ಹಿಯೇತೆ ಯೊ ಖ್ಹಾತ್ ಗೈಯೆ ಅಜು಼ ಛ಼ಡ್ತಿಬಾಜೂ಼ನ ವಹಿರೇಥಿ ಖರಾಬ್‌ಹುಯ್ಗುತೆ ಯೊ ಖ್ಹಾತ್ ದಾಣಕೊಂತೆ ಬುಟ್ಟುಖ್ಹಾರು ಕಾಳ್‌ದುಕಾಳ್‌ಹುವಾನು ಖ್ಹಾತ್‌ವರಖ್ಹ್‌ನ ವತಾಳಸ್. <verse eid="GEN 41:27" /><verse number="28" style="v" sid="GEN 41:28" />ದೇವ್ ಕರ‍್ನುಕರಿ ಛಾ಼ತೆ ಯೊ ಫರೋಹ ಖ್ಹಮ್‌ಜಾ಼ಡಿರಾಖ್ಯೋಸ್‌ಕರಿ ಮೇ ಬೋಲಿವತಾಳ್ಯೋತೆ ಎತ್ರೇಸ್. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮಾಸ್ ಘಣು ಅಛ್ಛಾ಼ ಖ್ಹಾತ್ ಖ್ಹುಗಾಳ್‌ನ ದನ್ ರಿಶೆ, <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />ಇನಪಾರ್‌ ಖ್ಹಾತ್ ಕಾಳ್‌ದುಕಾಳ್‌ನ ದನ್ ಆವ್‌ಶೆ. ತದೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ವಾಳು ಪಹಿಲೆ ಥೂತೆ ಖ್ಹುಗಾಳ್‌ನ ಭೈಕಿಜಾಶೆ; ಯೊ ಕಾಳ್‌ದುಕಾಳ್‌ಥಿ ದೇಖ್ಹ್‌ನಿ ಹಾಲತ್‌ ಖರಾಬ್‌ಹುಯಿಜಾ಼ಶೆ. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />ಫೈಲೆಥೂತೆ ಖ್ಹುಗಾಳ್‌ನ ದನ್ನಿ ಖ್ಹಣೇದಸ್ ಕೋರ‍್ಹಿಶೇನಿ. ಕತೋಬಿ ಅಗಾಡಿ ವಳ್ಯಾವತೆ ಕಾಳ್‌ದುಕಾಳ್ನ ದನ್ ಘಣು ವದೇಖ್ಹ್‌ನು ಹುಯಿರಿಶೆ, <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />ಆ ಖ್ಹೋಣ್ಯಾನ ಫರೋಹನ ಬೇ ಥರ ದ್ಯವಾನ ಕಾರಣ್ ಶನಕತೊ ದೇವ್ ಆ ಕಾಮ್‌ಕರಾನ ಜ಼ಲ್ದಿಮ ಖ್ಹೂಜ಼್‌ ಕರಿರಾಖ್ಯೊಸ್ ಮಾಲುಮ್ ಕರಿಲೇವ್ಣು. <verse eid="GEN 41:32" /><verse number="33" style="v" sid="GEN 41:33" />“ಇನಖ್ಹಾಜೆ ತೂ ಅಕ್ಕಲ್‌ವಾಳೊಬಿ ಬುದ್ದಿವಾಳೊಬಿ ಹುಯಿರೋತೆ ಏಕ್‌ಜ಼ಣಾನ ಚೂ಼ಣಿಲೀನ್ ಇನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಪರ್ ಅಧಿಕಾರಿಬಣೈನ್ ಮ್ಹೇಲ್ನು. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />ಅಜು಼ ತೂ ಎಕ್ ಕಾಮ್ ಕರ‍್ನು;ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನಿ ಖ್ಹಾರೀಸ್‌ ಬಾಜು಼ಮಾಬಿ ಖ್ಹರ್ಕಾರ್‌ನೊ ಅಧಿಕಾರಿನ ಮ್ಹೇಲಿನ್ ಇವ್ಣೇಥಿ ಖ್ಹುಗಾಳ್‌ನ ಖ್ಹಾತ್‌ವರಖ್ಹ್‌ನು ಪಿಕಾವ್ಣಿಮ ಪಾಚ಼್‌ಮಾನು ಏಕ್‌ ಭಾಗ್ನ ಲೇವ್ಣು. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />ಇವ್ಣೆ ಅಗ್‌ಲ್ಯಾ ಅಛ್ಛಾ಼ ವರಖ್ಹ್‌ಮ ಖಾಣಾನು ಚೀಜ಼್‌ನಾಬಿ ಅನಾಜ಼್‌ನಾಬಿ ಜ಼ಮಾಕರೀನ್ ಖ್ಹಯೇರ್‌ಮ ಜ಼ತನ್‌ಕರಾನ ತೂ ಹುಕುಮ್‌ ದೆವ್ಣು. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />ಅಮ್‌ ಖಾಣಾನು ಚೀಜ಼್‌ನ ಜ಼ಮಕರಾಥಿ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಕಾಳ್‌ದುಕಾಳ್ ಉಶೇತೆ ಖ್ಹಾತ್ ವರಖ್ಹ್‌ನ ಹಗಾಮ್ಮ ಖ್ಹಾರುಸ್‌ ಕಾಳ್‌ಥಿ ನಾಶಹುಯ್‌ಜಾಶೆ ಕೊಯ್ನಿ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 41:36" /></para>
  <para style="s">ಯೋಸೇಫ್ ಈಜಿಪ್ಟ್‌ನೊ ರಾಜ್ಯಪಾಲ್ ಹುಯೋತೆ</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />ಯೋಸೇಫ್‌ನೆ ವತಾಳ್ಯೋತೆ ಖ್ಹೂಜ಼್ ಫರೋಹನಾಬಿ ಇನ ಕುಟುಂಬ್‌ವಾಳನಾಬಿ ಅಛ್ಛು಼ಕರಿ ದೆಖಾಯು. <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />ಅಜು಼ ಫರೋಹನ ಯೋಸೆಫನಿತ್ರಾನು ದೇವ್‌ನು ಆತ್ಮ ಛಾ಼ತೆ ಊಚು಼ ಅದ್ಮಿ ದೆಖ್ಯಾಕೊಯ್ನಿ. <verse eid="GEN 41:38" /><verse number="39" style="v" sid="GEN 41:39" />ಅನೇಥಿ ಅಛ್ಛೋ಼ ಪರ್ಖ್ಹೊ ಅಪ್ಣುನ ಮಳ್‌ಶೇಕಿಶೂ?” ಕರಿ ಬೋಲಿನ್ ಯೋಸೇಫ್‌ನ, “ದೇವ್‌ ತುನಾಸ್‌ ಆ ಅಖ್ಖು ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೋತೆ ಇನಾಖ್ಹಾಜೆ ತಾರಿನಿತರ ಅಕ್ಕಲ್‌ ಬುದ್ದಿರ‍್ಹಾವಾಳೊ ಪರ್ಖ್ಹೊ ಬಿಜು಼ ಕೋಣ್‌ಬಿ ಕೊಯ್ನಿ; <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />ಮೇ ತೂಸ್ ಮಹೇಲ್‌ಮ ಖ್ಹಾರೀಸ್‍ ಅಧಿಕಾರ್‌ ಲೀರಾಖವಾಳೊ ಹುಯಿರ‍್ಹೇವ್ಣು; ಅಜು಼ ಅದ್ಮಿಖ್ಹಾರು ತಾರಿ ಹುಕುಮ್‌ನಿ ಘೋಣಿಸ್ ಚಾ಼ಲಿಲೇವ್ಣು; ಸಿಂಹಾಸನ್ನಿ ಬಾರೇಮ ಖಲಿ ಮೇ ತಾರೇಥಿ ಮೋಟೊ ಹುಯಿರ‍್ಹೆವ್ಸ್ ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 41:40" /><verse number="41" style="v" sid="GEN 41:41" />ಇನಪಾರ್ ಫರೋಹನೆ ಯೋಸೇಫ್‌ನ, “ಹಮ್ಕೇಸ್‌ ತುನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಪರ್‌ ರಾಜ್ಯಪಾಲ್ ಬಣೈರಾಖ್ಯೋಸ್” ಕರಿ ಬೋಲಿನ್‌, <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />ಫರೋಹನೆ ಇನ ಹಾತ್‌ಮಾಥು ಮುದ್ರಾನಿ ಅಂಗೂಠಿನ ಕಾಡಿನ್ ಯೋಸೇಫ್‌ನಿ ಅಂಗ್‌ಳಿಮ ಘಾಲ್ಯೊ. ಕಿಮ್ಮತ್‌ನ ಝ಼ಗ್ಗಾನಬಿ ಇನ ಘಲೇಂಡಾಮ ಖ್ಹೋನ್ನಾನಿ ಹಾರ‍್ನ ಘಲಾಯೊ. <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />ಇನಥೂತೆ ಬೇನು ರಾಜ್ಯನು ರಥ್‌ಪರ್ ಬೆಖ್ಹಾಡಿನ್‌, “ಇನ ಖ್ಹಾಮ್ಣೆ ಆಡ್‌ಪಡೊ” ಕರಿ ಬೋಲೈನ್‌ ಇನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ರಾಜ್ಯಪಾಲ್ ಬಣಾಯೊ. <verse eid="GEN 41:43" /><verse number="44" style="v" sid="GEN 41:44" />ಇನೆ ಯೋಸೇಫನ, “ಮೇ ಫರೋಹ ಬೋಲುಕರೂಸ್; ಹಿಡಿ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ತಾರಿ ಹುಕುಮ್‌ಕೊಂತೆ ಕೋಣ್‌ಬಿ ಹಾತ್‌ ಗೋಡ ನಾ ಹಲಾವ್ಣು” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />ಆಸ್ ಕಾಹೆತೆ ಫರೋಹನೆ ಯೋಸೇಫ್‌ನ ‘ಸಾಪ್ನತ್ಪನ್ನೇಹ’ ಕರಿ ನವು ನಾಮ್ ಮ್ಹೇಲ್ಯೊ; ಓನ್‌ ಕರಿ ಗುರು ಪೀಠನೊ ಯಾಜಕ ಹುಯಿರೊಥೋತೆ ಪೋಟೀಫೆರನಿ ಛೋ಼ರಿ ಆಸನತ್‌ ಕರಿ ನಾಮ್‌ವಾಳಿನ ಇನ ವ್ಯಹಾಕರೈದಿದೊ. ಇನವಾರ್ ಯೋಸೇಫ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಪರ್ ಗಖ್ಹತ್‌ಮಾರನ ನಿಕ್‌ಳ್ಯೊ. <verse eid="GEN 41:45" /><verse number="46" style="v" sid="GEN 41:46" />ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನೊ ರಾಜ಼ ಫರೋಹನಿ ಮಹೇಲ್‌ಮ ಆವಾನಿವಖ್ಹ್‌ತೆ ಯೋಸೇಫ್‌ನ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್‌ನಿ ಉಂಬರ್‌ಹುಯಿರೀಥಿ. ಯೋಸೇಫ್ ಫರೋಹಕಂಥೊ ನಿಕ್ಳಿನ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನು ಖ್ಹಾರೀಸ್‍ ಬಾಜು಼ಮ ಗಖ್ಹತ್‌ ಮಾರ‍್ಯೊ. <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />ಯೊ ದೇಖ್ಹ್‌ಮ ಖ್ಹುಗಾಳ್‌ನ ಖ್ಹಾತ್ ವರಖ್ಹ್‌ಮ ಜ಼ಮೀನ್ ಹೋಣುತೆತ್ರು ಅನಾಜ಼್‌ದಿದು. <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಖ್ಹಾತ್ ವರಖ್ಹ್‌ನು ಅನಾಜ಼್‌ನ ಯೋಸೇಫ್‌ನೆ ಜ಼ಮಾಕರೀನ್ ಖ್ಹಯೇರ್‌ಮ ಮ್ಹೇಲ್ಯೊ. ಖೆವಾ ಖ್ಹಯೇರ್‌ನ ಅಶ್‌ಪಿಶ್‌ಥೂತೆ ಖೆತರ್‌ನು ಅನಾಜ಼್‌ಕೀ ಯೊ ಖ್ಹಯೇರ್‌ಮಾಸ್‌ ಜ಼ಮಾಕರ‍್ಯೊ. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />ಅಮ್ ಜ಼ಮಾಕರ‍್ಯುಹುಯು ಅನಾಜ಼್ ದರ‍್ಯಾವ್‍ನಿ ರೇತ್‌ನಿತರ ರಾಶ್‌ರಾಶ್ ಹುಯ್‌ರೂಥು. ಯೋಸೇಫನ ಗಣ್ತಿಕರಾನ ಹೋಣುನಾತೆ ಇಮ್‌ ಮ್ಹೇಲಖ್ಹರ್‌ಕುಹುಯು. <verse eid="GEN 41:49" /><verse number="50" style="v" sid="GEN 41:50" />ಕಾಳ್‌ದುಕಾಳ್ ಆವಾನ ಅಗಾಡಿ ಯೋಸೇಫ್‌ನ, ಓನ್‌ ಖ್ಹಯೇರ್‌ನೊ ಯಾಜಕ ಹುಯಿರೋತೆ ಪೋಟೀಫೆರನಿ ಛೋ಼ರಿ ಆಸನತ್‌ಥಿ ಬೇಜ಼ಣ ಪರ್ಖ್ಹಾ ಲಡ್ಕ ಪೈದಹುಯ. <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />ಪೈಲ್ಹೋಟೊ ಛಿಯ್ಯೊ ಪೈದಹುವಾದಿನ್ ಯೋಸೇಫ್‌ನೆ, “ಮೇ ಮಾರಿ ಅಖ್ಖೀಸ್‌ ವದೇಖ್ಹ್‌ನಾಬಿ ಬಾನ ಘರ್‌ವಾಳನಾಬಿ ಭೈಕಿಜಾ಼ವನಿತರ ದೇವ್ನೆ ಕರ‍್ಯೋನಿ” ಕರಿ ಯೊ ಲಡ್ಕಾನ, ‘ಮನಸ್ಸೆ’ ಕರಿ ನಾಮ್‌ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />ಬೇನೊ ಛಿಯ್ಯೊ ಪೈದಹುವಾದಿನ್, ಖೆವಾ ದೇಖ್ಹ್‌ಮ ಮನ ವದೇಖ್ಹ್‌ಥೂಕಿ ಯೋಸ್ ದೇಖ್ಹ್‌ಮ ದೇವ್‌ ಮನ ಭಡೈರಾಖ್ಯೋಸ್” ಕರಿ ಯೊ ಛಿಯ್ಯಾನ ‘ಎಫ್ರಾಯಿಮ್’ ಕರಿ ನಾಮ್ ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 41:52" /><verse number="53" style="v" sid="GEN 41:53" />ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಖ್ಹುಗಾಳ್‌ನ ಖ್ಹಾತ್ ವರಖ್ಹ್ ಖತಮ್‌ಹುಯ್‌ಗ. <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />ಯೋಸೇಫ್‌ನೆ ಬೋಲ್ಯೋತೆ ಪರಕ್ಮಾಸ್ ಕಾಳ್‌ದುಕಾಳ್‌ನ ಖ್ಹಾತ್ ವರಖ್ಹ್ ಶುರುಹುಯಿಗ. ಕಾಳ್‌ದುಕಾಳ್ ಖ್ಹಾರಾಸ್ ದೇಖ್ಹ್‌ಮಾಬಿ ಫೈಲೈಗು. ಈಜಿಪ್ಟ್‌ಮ ಖಲಿ ಅನಾಜ಼್ ಥು. <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />ಇನಾಕೇಡೆಥು ಈಜಿಪ್ಟ್‌ಮಾಬಿ ಭಾಡ್ ಆವಾಖ್ಹತರ್ ಅದ್ಮಿಖ್ಹಾರು ಖಾಣುಹೋಣುಕರಿ ಫರೋಹನ ಬಿಂತಿ ಕರ‍್ಯು. ತದೆ ಇನೆ ಇವ್ಣುನ, “ಯೋಸೇಫ್‌ಕನ ಜಾ಼ವೊ, ಯೊ ಬೋಲನಿತರ ಕರೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 41:55" /><verse number="56" style="v" sid="GEN 41:56" />ಕಾಳ್‌ದುಕಾಳ್ ಖ್ಹಾರಾಸ್ ದೇಖ್ಹ್‌ಮ ಫೈಲೈಜಾ಼ತಾನ ಯೋಸೇಫ್‌ನೆ ಕಣ್‌ಗಿಯೇನ ಕಡೈನ್, ಈಜಿಪ್ಟ್‌ವಾಳನ ಅನಾಜ಼್ ವೇಚಾ಼ಯೊ. ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಕಾಳ್‌ದುಕಾಳ್ ಘಣು ಕಠಣ್‌ ಹುಯಿರೂಥು. <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />ಆನಾಹುಯಿನ್ ಖ್ಹಾರೀಸ್‍ ಧರ್‌ತಿಪರ್ ಕಾಳ್‌ದುಕಾಳ್ ಕಠಣ್‌ ಹುಯಿರೂಥೂತೆ ಇನಖ್ಹಾಜೆ ಖ್ಹಾರಾಸ್ ದೇಖ್ಹ್‌ವಾಳು ಅನಾಜ಼್ ಲ್ಯಾವಾನಖ್ಹಾಜೆ ಈಜಿಪ್ಟ್‌ದೇಖ್ಹ್‌ನ ಯೋಸೇಫ್‌ಕನ ಆಯು.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">ಅನಾಜ಼್‌ಲ್ಯಾವನ ಯೋಸೇಫ್‌ನ ಭೈಯೇ ಈಜಿಪ್ಟ್‌ಮ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />ಈಜಿಪ್ಟ್‌ಮ ಅನಾಜ಼್ ಮಳಸ್ ಕರಿ ಖಬರ್‌ ಯಾಕೋಬ್‍ನ ಮಾಲುಮ್‌ಪಡೀನ್‌, ಇನೆ ಇನ ಲಡ್ಕಾವ್ನ, “ತುಮೆ ಮ್ಹೋಡುಮ್ಹೋಡು ಶನಾ ದೇಖೊಸ್‍? <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />ಈಜಿಪ್ಟ್‌ದೇಖ್ಹ್‌ಮ ಅನಾಜ಼್ ಮಳಸ್ ಕರಿ ಮೇ ಖ್ಹಮ್‌ಜ್ಯೊ; ಅಪ್ಣೆ ಭುಕ್‌ಥಿ ಮರ‍್ನುನಾತೆ ಬಚಾ಼ನಖ್ಹಾಜೆ ತುಮೆ ಹಿಜ್ಜಾ಼ ಜೈ಼ನ್ ಹೋಣುತೆ ಅನಾಜ಼್‌ನ ಮೋಲ್‌ಲೀನ್ ಆವೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 42:2" /><verse number="3" style="v" sid="GEN 42:3" />ಯೋಸೇಫ್‌ನ ದಖ್ಹ್‌ಜ಼ಣ ಭೈಯೇ ಅನಾಜ಼್ ಲ್ಯಾವನಖ್ಹಾಜೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ನಿಕ್‌ಳ್ಯ. <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />ಕತೋಬಿ ಯೋಸೇಫ್‌ನ ಪೀಟ್‌ನ ಪೈದಹುಯೋತೆ ನ್ಹಾನೊ ಭೈ ಬೆನ್ಯಾಮೀನ್ನ ಯಾಕೋಬನೆ ಇವ್ಣಿಜೋ಼ಡ್ಮ ಮೋಕ್‌ಲ್ಯೊಕೊಯ್ನಿ. ಶನಕತೊ, ಇನ ಕಾಯ್‌ತೋಬಿ ಇವ್ಣೇಥಿ ಖತ್ರ ಹುಯಿಜಾ಼ಶೆಕರಿ ಇನ ಡರ್‌ಥೊ. <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />ಕಾನಾನ್‌ ದೇಖ್ಹ್‌ಮಾಬಿ ಕಾಳ್‌ದುಕಾಳ್‌ಥೂತೆ ಇನಖ್ಹಾಜೆ ಈಜಿಪ್ಟ್‌ದೇಖ್ಹ್‌ನ ಅನಾಜ಼್‌ಲ್ಯಾವನ ಆಯೂತೆ ಇವ್ಣಾಮ ಇಸ್ರಾಯೇಲ್ ಕತೊ ಯಾಕೋಬನ ಛಿಯ್ಯಾಬಿಥ. <verse eid="GEN 42:5" /><verse number="6" style="v" sid="GEN 42:6" />ತದೆ ಈಜಿಪ್ಟ್‌ದೇಖ್ಹ್‌ಮ ಹುಕುಮ್ ಚ಼ಲವ಼್ ಕರ್ತೋಥೋತೆ ಅಜು಼ ಅದ್ಮೇವ್‌ನ ಅನಾಜ಼್ ವೇಚೂ಼ಕರ್‌ತೋಥೋತೆ ತದೆ ಯೋಸೇಫನ ಖ್ಹಾಮ್ಣೆ ಇನ ಭೈಯೇ಼ ಆಯಿನ್ ಆಡ್‌ಪಡ್ಯ. <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />ಯೋಸೇಫನೆ ಇವ್ಣುನ ದೇಕ್‌ತಾಸ್ನ ಖ್ಹಣೇದ್‌ಧರಿಲಿದೊ. ಕತೋಬಿ ಇವ್ಣುನ ಮಾಲುಮ್‌ಕೊಂತೆ ತಿಮ್ಮಸ್ ಗುರ್‌ಕೈನ್, “ತುಮೆ ಕಿಜ್ಜಾ಼ವಾಳ?” ಕರಿ ಪುಛಾ಼ಯೊ. ಇವ್ಣೆ, “ಹಮೆ ಅನಾಜ಼್ ಲ್ಯಾವನಖ್ಹಾಜೆ ಕಾನಾನ್ ದೇಖ್ಹ್‌ಥ ಆಯಿರ‍್ಹಾಸ್” ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 42:7" /><verse number="8" style="v" sid="GEN 42:8" />ಮೋಟಭೈಯೇನು ಖ್ಹಣೇದ್ ಯೋಸೇಫನ ಮಾಲುಮ್‌ಪಡ್ಯುತೋಬಿ ಇನು ಖ್ಹಣೇದ್ ಇವ್ಣುನ ಮಾಲುಮ್‌ಪಡ್ಯೂಕೊಯ್ನಿ. <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />ಇವ್ಣಿಬಾರೇಮ ಇನೆ ದೇಖ್ಯೋತೆ ಖ್ಹೋಣ್ಯಾವ್‌ನ ಯೋಸೇಫನೆ ಯಾದ್‌ಕರಿಲಿನ್ ಇವ್ಣುನ, “ದೇಖೊ, ತುಮೆ ಪತ್ತೊದೇಖವಾಳ; ಹಮಾರ ದೇಖ್ಹ್‌ನು ಕಮ್‌ಜೋ಼ರಿ ಝ಼ಗೋನ ಪತ್ತೋಕರಾನ ಆಯಿರ‍್ಹಾಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 42:9" /><verse number="10" style="v" sid="GEN 42:10" />ಇನ ಇವ್ಣೆ “ಕಾಹೆಲ ಯಜಕ್, ತಾರ ಸೇವಕ್ ಹುಯಿರಾತೆ ಹಮೆ ಅನಾಜ಼್ ಲ್ಯಾವಾನಖ್ಹಾಜೆ ಆಯಿರ‍್ಹಾಸ್. <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />ಹಮೆ ಅಖ್ಖಾಜ಼ಣಾಬಿ ಎಕ್ಕಸ್ ಬಾನ ಛಿಯ್ಯಾ; ಹಮೆ ಖ್ಹಾಚಾಸ್‌ ಪಣ್ಕಿ ಪತ್ತೊದೇಖವಾಳ ಕಾಹೆ” ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 42:11" /><verse number="12" style="v" sid="GEN 42:12" />ಯೋಸೇಫನೆ ಇವ್ಣುನ, “ಝೂ಼ಟಿ, ಹಮಾರ ದೇಖ್ಹ್‌ನು ಕಮ್‌ಜೋ಼ರಿ ಝ಼ಗೋನ ಮಾಲುಮ್‌ಕರಿಲ್ಯಾವಾನ ಖ್ಹಾಜೇಸ್ ಅಯಿರ‍್ಹಾಸ್‌, ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 42:12" /><verse number="13" style="v" sid="GEN 42:13" />ಇನಖ್ಹಾಜೆ ಇವ್ಣೆ, “ತಾರ ಸೇವಕ್‌ಹುಯ್‌ರಾತೆ ಹಮೆ ಭಾರಜ಼ಣ ಭೈಯೇ; ಕಾನಾನ್ ದೇಖ್ಹ್‌ವಾಳ, ಎಕ್ಕಸ್ ಬಾನ ಲಡ್ಕಾವ್; ಹಮಾರಮ ನ್ಹಾನೊ ಭೈ ಬಾಕನ ಛಾ಼; ಏಕ್‌ಜ಼ಣೊಕೊಯ್ನಿ” ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 42:13" /><verse number="14" style="v" sid="GEN 42:14" />ಯೋಸೇಫನೆ ಇವ್ಣುನ, “ಮೇ ಬೋಲ್ಯೋತೆ ತಿಮ್ಮಸ್ ತುಮೆ ಪತ್ತೊದೇಖಾವಳಸ್. <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />ಆ ಖ್ಹಾಚೀಕಿ ಝೂ಼ಟಿಕಿ ಕರಿ ಮಾಲುಮ್‌ಪಡ್‌ನುಕತೊ ತುಮೆ ತುಮಾರ ನ್ಹಾನ ಭೈನ ಬುಲೈಲ್ಯಾವ್ಣು. ಯೊ ನಾ ಆಯೋತೊ, ಫರೋಹನ ಖ್ಹಾಮ್‌ಬಿ, ತುಮೆ ಹಜ್ಜಾ಼ಥ ನಾಜಾ಼ವ್ಣು. <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />ಇನ ಬುಲೈಲೀನ್ ಆವಾನ ತುಮಾರಾಮಥ ಏಕ್‌ಜ಼ಣಾನ ಮೋಕ್‌ಲೊ. ಯೊ ಆವಾಲಗೂಬಿ ತುಮುನ ಖ್ಹಾರ್‌ಕೋಟ್‌ಮ ರಾಖುಸ್. ಅಮ್ ತುಮಾರಿ ಖ್ಹಾರಿವಾತೆನ ತರೀಪ್‌ಶ ಕರೀನ್ ತುಮೆ ಖ್ಹಾಚ಼ಕಿ ಕೊಯ್ನಿಕಿ ಕರಿ ಮಾಲುಮ್ ಕರಿಲೆವುಸ್‌. ತುಮಾರೊ ನ್ಹಾನೊಭೈ ಆಯೋನಾತೊ, ಫರೋಹನ ಜಾನ್ನಖ್ಹಾಮ್‌ಬಿ, ತುಮೆ ಪತ್ತೊದೇಖವಾಳೊಸ್” ಕರಿ ಬೋಲಿನ್‌, <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />ಇವ್ಣುನ ತೀನ್ ದನ್‌ಲಗು ಕಾವಲ್‌ಮ ರಾಖ್ಯೊ.<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />ತೀನ್ನರೋಜ಼್‌ಮ ಯೋಸೇಫ್‌ನೆ ಇವ್ಣುನ ಬುಲೈನ್, “ಮೇ ದೇವ್‌ಮ ಡರ್‌ಭಕ್ತಿಥಿರ‍್ಹಾವಾಳೊ; ತುಮುನ ಜಾನ್‌ಪರ್ ಹರಖ್ಹ್‌ಉಶೇತೊ ಮೇ ಬೋಲುತೆ ತಿಮ್ ಕರೊ; <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />ತುಮೆ ಖ್ಹಾಚಉಶೇತೊ ತುಮಾರಾಮ ಏಕ್‌ಜ಼ಣಾನ ಖಲಿ ಖ್ಹಾರ್‌ಕೋಟ್‌ಮ ರಾಖುಸ್. ಬಿಜಾ಼ಖ್ಹಾರ ತುಮಾರ ಕುಟುಂಬ್‌ವಾಳನ ಹೋಣುತೆ ಅನಾಜ಼್ ಲೀನ್‌ಜಾ಼ವೊ. <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />ಕತೋಬಿ ತುಮಾರ ನ್ಹಾನ ಭೈನ ಮಾರಾಕನ ಲೀನ್ ಆವ್ಣು, ಬುಲೈಲೀನ್ ಆಯಾತೊ, ತುಮಾರಿ ವಾತ್ ಖ್ಹಾಚಿಕರಿ ಮಾಲುಮ್‌ಕರಿಲೆವುಸ್‌, ತದೆ ತುಮೆ ಮರ್‌ಶುಕೊಂತೆ ಬಚ಼್‌ಶು” ಕರಿ ಬೊಲ್ಯೊ. ಇವ್ಣೆ ಇಮ್ಮಸ್ ಕರಾನ ಮಾನಿಲಿದ. <verse eid="GEN 42:20" /><verse number="21" style="v" sid="GEN 42:21" />ತದೆ ಇವ್ಣ ಇವ್ಣಾಸ್‌ಮ, “ಅಪ್ಣೆ ಅಪ್ಣ ನ್ಹಾನ ಭೈನ ಕರ‍್ಯಾತೆ ಧೋಕಾನ ಬರೋಬರ್‌ನು ನಿಶತ್‌ಲೆವ್‌ ಕರಿಯೇಸ್. ಇನೆ ಅಪ್ಣುನ ಗಿಂಗೈಲಿದೊ. ಇನಿ ಜಾನ್ನಿ ವದೇಖ್ಹ್‌ನ ಮಾಲುಮ್ ಕರೀನ್‌ಬಿ ಅಪ್ಣೆ ಇನಿ ಬೋಲಿನ ಕಾನ್‌ ಕೋದಿದಾನಿ. ಇನಖ್ಹಾಜೇಸ್ ಆ ಖ್ಹತಾಪ್‌ಣಿಮ ಖ್ಹಪ್‌ಡಿಗಯ” ಕರಿ ಬೋಲಿಲಿದ. <verse eid="GEN 42:21" /><verse number="22" style="v" sid="GEN 42:22" />ಇನಖ್ಹಾಜೆ ರೂಬೇನ್ನೆ, “ಯೊ ಛೋ಼ಕ್ರಾನ ಶನೂಬಿ ಕೇಡ್ ನಕೊ ಕರೊ ಕರಿ ಮೇ ಬೊಲ್ಯೊ. ತುಮೆ ಖ್ಹಮ್‌ಜ್ಯಾಕೊಯ್ನಿ, ಇನಖ್ಹಾಜೆ ಇನೊ ಜಾನ್‌ ಕಾಡಾನಿ ಬಾರೇಮ ಅಪ್ಣೆ ಹಮ್ಕೆ ಜ಼ವಾಬ್ ದೇವ್ಣು ಪಡ್ಯು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />ಯೋಸೇಫನೆ ಬೇ ಬೋಲಿಮ ವಾತ್ ಬೋಲಖ್ಹರ್ಕ ಏಕ್‌ಜ಼ಣಾನಿ ಜೋ಼ಡ್ಮ ವಾತ್ ಬೋಲುಕರ್‌ತೊಥೋತೆ ಇನಖ್ಹಾಜೆ ಇನ ಅವ್ಣಿವಾತ್ ಮಾಲುಮ್ ಪಡುಕರಸ್ ಕರಿ ಅವ್ಣೆ ಲಾಝ್ಯಾಕೊಯ್ನಿ. <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />ಇನೆ ಇವ್ಣಕಂಥೊ ಓಠೆಜೈ಼ನ್ ರೊಯೊ. ಇನಕೇಡೇಥು ಇವ್ಣಕನ ಪಾಛೊ಼ಫರಿ ಆಯಿನ್, ಇವ್ಣಿ ಜೋ಼ಡ್ಮ ವಾತ್‌ಬೋಲಿನ್ ಸಿಮೆಯೋನ್ನ ಧರೈನ್ ಇವ್ಣ ಡೋಳಾನ ಖ್ಹಾಮ್ಣೇಸ್ ಇನ ಭಂದಾಯೊ.<verse eid="GEN 42:24" /></para>
  <para style="s">ಯೋಸೇಫನ ಭೈಯೇ಼ ಕಾನಾನ್ ದೇಖ್ಹ್‌ನ ಪಾಛ಼ ಆಯಾತೆ</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />ಅನಾಪಾರ್ ಯೋಸೇಫನೆ ಇನ ಆಳ್‌ನ, “ಯೊ ಅದ್ಮೆವ್‌ನ ಕೋಥ್‌ಳಾವ್‌ಮ ಅನಾಜ಼್ ಭರೈನ್ ಏಕೇಕ್‌ ಜ಼ಣಾವ್ನ ಕೋಥ್‌ಳಾವ್‌ಮಾಸ್‌ ಇವ್ಣೆ ಲಾಯಥಾತೆ ಪೈಶಾನ ಘಾಲಿದೀನ್, ಇವ್ಣ ಚಾ಼ಲ್‍ಕುಚ಼್‍ನ ಹೋಣುತೆ ಖಾಣನ ದೆವ್ಣು” ಕರಿ ಹುಕುಮ್ ಕರಾಮ ಇವ್ಣೆ ಇಮ್ಮಸ್ ಕರ‍್ಯು. <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />ಆ ಅಖ್ಖು ಹುವಾನ ಬಾದ್ಮ ಇನ ಭೈಯೇವ್‌ನೆ ಇವ್ಣೆ ಲಿದಾತೆ ಅನಾಜ಼್‌ನ ಗಧೇಡವ್‌ಪರ್ ಢೊಯಿಲೀನ್‌ ನಿಕ್‌ಳ್ಯಾ. <verse eid="GEN 42:26" /><verse number="27" style="v" sid="GEN 42:27" />ರಾತ್ಮ ಎಕ್ ಝ಼ಗೋಮ ರ‍್ಹಯ. ಇವ್ಣಾಮ ಏಕ್ಜ಼ಣಾನೆ ಇನ ಗಧೇಡಾನ ಚಾ಼ರೊ ನಾಕ್ಣುಕರಿ ಇನೊ ಕೋಥ್‌ಳೊ ಛೋ಼ಡ್ಯೊ. ಇನೆ ಲಾಯೊಥೋತೆ ಪೈಶಾ ಇನ ಮ್ಹೋಡಾಮಾಸ್‌ಥೂತೆ ದೇಖ್ಯೊ. <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />“ಮೇ ದಿದೋತೆ ಪೈಶಾ ಮನ ಪಾಛ಼ಮಳ್ಯಾ: ಹಂದೇಕ್, ಮಾರ ಕೋಥ್‌ಳಾಮ ಛಾ಼” ಕರಿ ಇನ ಭೈಯೇನ ಬೊಲ್ಯೊ. ಇವ್ಣೆ ಅಕ್‌ಬಕೈಜೈ಼ನ್, ಏಕ್‌ಥಿ ಏಕ್‌ಜ಼ಣ ಘಬ್‌ರೈ ದೇಕ್‌ತಹುಯಿನ್, “ಅಪ್ಣುನ ದೇವ್ನೆ ಅಮ್‌ ಶನ ಕರ‍್ಯೊ?” ಕರಿ ಬೋಲಿಲಿದ. <verse eid="GEN 42:28" /><verse number="29" style="v" sid="GEN 42:29" />ತದೆ ಇವ್ಣೆ ಕಾನಾನ್ ದೇಖ್ಹ್‌ನ ಇವ್ಣೊ ಬಾ ಹುಯಿರೋತೆ ಯಾಕೋಬ್‌ಕನ ಆಯಿನ್ ಚಾ಼ಲ್ಯೂತೆ ಅಖ್ಖೀಸ್ ಬಾರೇಮ ಖ್ಹಮ್‌ಜಾ಼ಡ್‌ತ, <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />“ಯೊ ದೇಖ್ಹ್‌ನೊ ಮೋಟೊ ಹಮಾರಿ ಜೋ಼ಡ್ಮ ಕಠೋರ್‌ಥಿ ವಾತ್‌ಬೋಲಿನ್‌ ಹಮುನ ಪತ್ತೊದೇಖವಾಳೊ ಕರಿ ಲಾಝ್ಯೊ. <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />ಹಮೆ ಇನ, ‘ಹಮೆ ಖ್ಹಾಚಸ್ ಪಣ್ಕಿ ಪತ್ತೊದೇಖವಾಳ ಶಾತ್ಬಿಕಾಹೆ, <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />ಹಮೆ ಎಕ್ ಬಾನ ಪೈದಹುಯಾತೆ ಭಾರಜ಼ಣ ಭೈಯೇ; ಹಮಾರಮ ಏಕ್‌ಜ಼ಣೊಕೊಯ್ನಿ. ನ್ಹಾನೊ ಹಮ್ಕೆ ಕಾನಾನ್ ದೇಖ್ಹ್‌ಮ ಹಮಾರ ಬಾಕನ ಛಾ಼’ ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />ಇನಾಖ್ಹಾಜೆ ದೇಖ್ಹ್‌ನೊ ಮೋಟೊ, ತುಮೆ ಖ್ಹಾಚಾಕಿ ಕೊಯ್ನಿಕಿ ಕರಿ ಮಾಲುಮ್ ಪಡಾನ ಖ್ಹಾಜೆ ತುಮಾರಾಮ ಏಕ್‌ಜ಼ಣಾನ ಹಮಾರಕನಾಸ್‌ ಮ್ಹೇಲಿನ್ ಜಾ಼ವೊ; ತುಮಾರ ಕುಟುಂಬ್‌ವಾಳನ ಭಾಡ್‌ನ ಖತಮ್‌ಕರಾನ ಹೋಣೂತೆತ್ಯೊ ಲೀನ್ ಜ಼ಯೇಜಾ಼ಯ್. <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />ಕತೋಬಿ ತುಮಾರ ನ್ಹಾನ ಭೈನ ಮಾರಾಕನ ಬುಲೈಲೀನ್ ಆವ್ಣು. ಬುಲೈಲೀನ್ ಆಯಾತೊ, ತುಮೆ ಪತ್ತೊದೇಖವಾಳ ಕಾಹೆತೆ ಖ್ಹಾಚಾ಼ಸ್‌ಕರಿ ಮಾಲುಮ್ ಕರಿಲೆವುಸ್‌; ತುಮಾರ ಮೋಟಭೈನ ಛುಟ್ಕಾರ್ ಕರುಸ್ ಅಜು಼ ತುಮೆ ಆ ದೇಖ್ಹ್‌ಮ ಹೋಣುತೆತಿಮ್ ರ‍್ಹಿಯೆಜಾ಼ಯ್ ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 42:34" /><verse number="35" style="v" sid="GEN 42:35" />ಇವ್ಣೆ ಇವ್ಣ ಕೋಥ್‌ಳಾವ್ನ ಛೋ಼ಡಿ ದೇಖ್‌ತಾನ ಹರೇಕ್‌ಜ಼ಣಾನ ಕೋಥ್‌ಳಾಮಾಬಿ ಇವ್ಣ ಇವ್ಣ ಪೈಶಾನು ಗಂಟ್‌ಡು ಮಳ್ಯು. ಯೊ ಗಂಟ್‌ನ ಇವ್ಣೊ ಬಾಬಿ ಇವ್ಣೆ ದೇಖಿನ್ ಘಬ್‌ರೈಗಯ. <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />ತದೆ ಇವ್ಣೊ ಬಾ ಯಾಕೋಬನೆ ಇವ್ಣುನ, “ಮನ ಬಿಣ್‍ ಲಡ್ಕವಾಳನಿತರ ಕರಿನಾಖ್ಯ; ಯೋಸೇಫಬಿ ಕೊಯ್ನಿ, ಸಿಮೆಯೋನ್‌ಬಿಕೊಯ್ನಿ, ಬೆನ್ಯಾಮೀನನಾಬಿ ಬುಲೈಲೀನ್ ಜಾ಼ವ್ಣುಕರಿ ಛಾ಼. ಆ ಅಖ್ಖು ವದೇಖ್ಹ್‌ಬೀ ಮಾರಪರಸ್ ಆಯೂನಿ” ಕರಿ ಬೊಲ್ಯೊ <verse eid="GEN 42:36" /><verse number="37" style="v" sid="GEN 42:37" />ತದೆ ರೂಬೇನನೆ, “ಮೇ ಆ ಛೋ಼ಕ್ರಾನ ಪಾಛೊ಼ ಲಯಿನ್ ತುನ ನಾದಿದೋತೊ ಮಾರ ಭೇ ಛಿಯ್ಯಾನ ಮಾರಿ ನಾಖೇಜಾ಼ಯ್. ಅನ ಮಾರ ಕಬ್‌ಜಾ಼ಮ ದಿದೋತೊ ಮೇ ಮ್ಹೇಲಿಶ್‌ಕೊಂತೆ ಅನ ತಾರಕನ ಬುಲೈಲೀನ್ ಆವುಸ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 42:37" /><verse number="38" style="v" sid="GEN 42:38" />ಕತೋಬಿ ಯಾಕೋಬನೆ ಇವ್ಣುನ, “ಮಾರೊ ಛಿಯ್ಯೊ ತುಮಾರಿ ಜೋ಼ಡ್ಮ ನಾ ಜಾ಼ವ್ಣು. ಅನಿ ಪಾಕ್ತಿನ ಪೈದಹುಯೊತೆ ಯೊ ಮರಿಗಯೊ, ಆ ಎಕ್ಕಸ್ಜ಼ಣೊ ಬಚಿರ‍್ಹೋಸ್‌, ವಾಟ್‌ಪರ್‌ ಕಾಯ್‌ತೋಬಿ ಅನ ಖತ್ರಹುಯುತೊ ಆ ಬುಢು ಮುಡ್‌ಕ್ಯು ತುಮಾರೇಥೀಸ್ ದುಕ್‌ನಿಜೋ಼ಡೆ ಮರಿಜೈ಼ಶ್” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">ಬೆನ್ಯಾಮಿನ್ ಅಜು಼ ಯೋಸೇಫನ ಭೈಯೇ ಪಾಛ಼ ಈಜಿಪ್ಟ್‌ನ ಗಯಾತೆ.</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />ಕಾನಾನ್‌ಮ ಕಾಳ್‌ದುಕಾಳ್ ಘಣು ಜಾ಼ಖ್ಹತ್‌ಹುಯಿಗುಥು. <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />ಇವ್ಣೆ ಈಜಿಪ್ಟ್‌ಥ ಲಾಯಾತೆ ಅನಾಜ಼್ ಖತಮ್ ಹುಯಿಜಾ಼ವದಿನ್ ಇವ್ಣೊ ಬಾನೆ ಇವ್ಣುನ, “ತುಮೆ ಪಾಛ಼ ಜೈ಼ನ್ ಬಿಜೂ಼ಬಿ ಥೋಡು ಅನಾಜ಼್‌ನ ಮೋಲ್ ಲೀನ್‌ಆವೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 43:2" /><verse number="3" style="v" sid="GEN 43:3" />ಇನಖ್ಹಾಜೆ ಯೆಹೂದನೆ ಇನ ಬಾನ ಶಾತ್ ಬೋಲ್ಯೋಕತೊ, “ಯೊ ಅದ್ಮಿ ಹಮುನ ‘ತುಮಾರ ನ್ಹಾನ ಭೈನ ಬುಲೈ ನಾಲಾಯತೊ ಮಾರು ಮ್ಹೋಡು ತುಮೆ ನಾದೇಕ್ಣು’ ಕರಿ ಕಡಕ್‌ಥಿ ಬೊಲ್ಯೊ. <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />‘ತೂ ಹಮಾರ ನ್ಹಾನ ಭೈನ ಹಮಾರಿ ಜೋ಼ಡ್ಮ ಮೋಕ್‌ಲ್ಯೋತೊ ಹಮೆ ಜೈ಼ನ್, ತುನ ಅನಾಜ಼್ ಮೋಲ್‌ಲೀನ್ ಐಯೇಸ್. <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />ಇನ ತೂ ನಾ ಮೋಕ್‌ಲ್ಯೋತೊ ಹಮೆ ಕೋ ಜೈ಼ಯೇನಿ. ಶನಕತೊ ಯೊ ಅದ್ಮಿ, “ತುಮಾರೊ ನ್ಹಾನೊ ಭೈ ತುಮಾರಿ ಜೋ಼ಡ್ಮ ನಾರ‍್ಹಯೋತೊ ಮಾರು ಮ್ಹೋಡು ನಾ ದೇಕ್ಣು” ಕರಿ ಬೋಲಿ ರಾಖ್ಯೋಸ್. <verse eid="GEN 43:5" /><verse number="6" style="v" sid="GEN 43:6" />ಇನಖ್ಹಾಜೆ ಯಾಕೋಬ್‌ನೆ, “ಬಿಜೇಕ್ ನ್ಹಾನೊ ಭೈ ಛಾ಼ ಕರಿ ಯೊ ಅದ್ಮಿನ ಬೋಲೊ, ಮನ ಶನಖ್ಹಾಜೆ ಆ ಕುಢಾಪಮ ಘಾಲ್ಯ?” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 43:6" /><verse number="7" style="v" sid="GEN 43:7" />ತದೆ ಇವ್ಣೆ, ಅಪ್ಣಿ ಬಾರೇಮಾಬಿ ಅಪ್ಣ ಘರ್‌ವಾಳಾನಿ ಬಾರೇಮಾಬಿ ಯೊ ಅದ್ಮಿನೆ ಖ್ಹಂಜ಼್‌ಕಾರ್‌ಥಿ ಪೂಚ಼್‌ತಾಚ್‌ ಕರ‍್ಯೊ. ಅಜು಼ ಇನೆ ತುಮಾರೊ ಬಾ ಬಿಜೂ಼ಬಿ ಬಚಿರ‍್ಹೋಸ್‌ಕಿಶೂ? ತುಮುನ ಬಿಜೇಕ್ ನ್ಹಾನೊ ಭೈ ಛಾ಼ಕಿಶೂ? ಕರಿ ಪುಛಾ಼ಯೊ. ಯೊ ಜ಼ವಾಬ್‌ನ ಬರೋಬರ್‌ನು ಫೇಡ್‌ದಿದ. ಯೊ ತುಮಾರ ನ್ಹಾನ ಭೈನ ಬುಲೈಲೀನ್ ಆವೊಕರಿ ಬೋಲ್‌ಶೆ ಕರಿ ಹಮುನ ಕಿಮ್ ಮಾಲುಮ್ ಪಡ್‌ಶೆ?” ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 43:7" /><verse number="8" style="v" sid="GEN 43:8" />ತದೆ ಯೆಹೂದನೆ ಇನೊ ಬಾ ಯಾಕೋಬನ, “ಯೊ ಛೋ಼ಕ್ರಾನ ಮಾರಿ ಜೋ಼ಡ್ಮ ಮೋಕಲ್, ಹಮೆ ಜೈ಼ಯೇಸ್. ತದೆ ತೂಬಿ , ಹಮೇಬಿ ಅಜು಼ ಹಮಾರ ಲಡ್ಕಾಬಿ ಮರ್‌ಶುಕೊಂತೆ ಬಚ್‌ಶು. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />ಮೇ ಇನಿ ಜಿಮ್ಮೇದಾರಿ ಲೆವುಸ್‌; ಇನಿ ಬಾರೇಮ ಮನಾಸ್ ಪುಛಾ಼ಯೇಜಾ಼ಯ್. ಮೇ ಇನ ತಾರ ಖ್ಹಾಮ್ಣೆ ಪಾಛೊ಼ಫರಿ ನಾ ಬುಲೈಲಯಿನ್ ಭೀರಾಖ್ಯೋತೊ ಯೊ ಅಪ್‌ರಾದ್‌ ಕದೇಬಿ ಮಾರಪರಸ್ ರ‍್ಹವಾದೆ. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />ಹಮೆ ದೇರ್‌ ನಾರುಕ್ಯಹೋತ್ತೊ ತದೇಸ್‌ ಬೇ ವಖ್ಹತ್ ಜೈ಼ನ್ ಆಯಾಹೋತ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 43:10" /><verse number="11" style="v" sid="GEN 43:11" />ತದೆ ಇವ್ಣೊ ಬಾ ಯಾಕೋಬನೆ, “ತುಮೆ ಜಾ಼ವ್ಣುಕತೊ ಎಕ್ ಕಾಮ್ ಕರೊ; ಆ ಮುಲಕ್‌ಮ ಮಳಾತೆ ಮೋಲ್ನ ರಾಛಾ಼ನ ಇನಾಮ್ನಖ್ಹಾಜೆ ಥೋಡು ತೇಲ್, ಶೇತ್, ದೂದ್‌ನಿ ಮ್ಹಲೈ, ವಾಖ್ಹ್‌ನು ಮುಲಾಮ್‌, ವಾನುತೇಲ್‌, ಬಾದಮ್, ಕಾಜು಼ ಥೋಡು ಮಸಾಲನು ರಾಛು಼ ಆಅಖ್ಖಾನ ತುಮಾರ ಕೋಥ್‌ಳಾಮ ಘಲ್ಲೀನ್ ಜಾ಼ವೊ. <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />ಯೋಸ್ ಕಾಹೆತೆ ತುಮೆ ಬೇಪಟ್ ಎತ್ರು ಪೈಶಾನ ಲೀಜಾ಼ವೊ; ಇವ್ಣೆ ತುಮಾರ ಕೋಥ್‌ಳಾನ ಮ್ಹೋಡೆ ಪಾಛು಼ ಘಾಲಿ ಮೋಕ್ಲಿರಾಖ್ಯುಥುತೆ ಪೈಶಾ ಉಶೇತೊ ಲೀನ್‌ಜಾ಼ವೊ. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />ತುಮಾರ ನ್ಹಾನ ಭೈನಾಬಿ ಬುಲೈಲೀನ್ ಪಾಛ಼ ಯೊ ಅದ್ಮಿಕನ ಬುಲೈಲೀನ್ ಜಾ಼ವೊ. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />ಯೊ ತುಮಾರಾಪರ್ ಗೋರ್‌ಕರೀನ್‌ ತುಮಾರ ಮೋಟಭೈನಾಬಿ ಬೆನ್ಯಾಮೀನ್ನಾಬಿ ತುಮಾರಿ ಜೋಡ್ಮ ಮೋಕ್ಲಿದ್ಯಾವಾನಿ ತರ ಸರ್ವಶಕ್ತ ಯೆಹೋವ ದೇವ್ ಕರಾದೆ; ಮೇತೊ ಲಡ್ಕಾವ್ನ ಗುಮೈಲ್ಯಾವಾಳೊ ಹುಯಿರ‍್ಹವಾನು ಉಶೇತೊ ಇಮ್ಮಸ್ ಹುವಾದೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 43:14" /><verse number="15" style="v" sid="GEN 43:15" />ತದೆ ಇವ್ಣೆ ಕಾಣ್ಕೆನ ರಾಛಾ಼ನ ತಯಾರ್ ಕರಿಲೀನ್‌, ಬೇಪಟ್ ಪೈಶಾನ ಪಾಡಿಲೀನ್, ಬೆನ್ಯಾಮೀನ್ನ ಜೋ಼ಡ್ಮ ಬುಲೈಲೀನ್ ಈಜಿಪ್ಟ್‌ದೇಖ್ಹ್‌ನ ಜೈ಼ನ್ ಯೋಸೇಫ್‌ನ ಖ್ಹಾಮ್ಣೆ ಭೀರಿಗಯ. <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />ಬೆನ್ಯಾಮೀನ್ ಇವ್ಣಿಜೋ಼ಡ್ಮ ರ‍್ಹಾವಾನು ಯೋಸೇಫನೆ ದೇಖಿನ್ ಇನು ಘರ್‌ ದೇಖಿಲ್ಯಾವಾಳನ ಬುಲೈನ್, “ಆ ಅದ್ಮೆವ್‌ನ ಘರ್ಮ ಬುಲೈಲೀನ್ ಜಾ಼, ಅಛ್ಛಿಂತರ ಪಲಿ ರ‍್ಹಾವಾನು ಜಾನ್ವಾರ್‌ನ ವ್ಹಾಡಿನ್ ಖಾಣು ಪಿಕಾವ್. ಶನಕತೊ ಆ ಅದ್ಮೆವ್ ಆ ವಖ್ಹ್‌ತೆ ಧೊಪಾರ್‌ಮ ಮಾರಿ ಜೋ಼ಡ್ಮ ಖಾಣು ಖಾಶೆ” ಕರಿ ಹುಕುಮ್‌ದಿದೊ. <verse eid="GEN 43:16" /><verse number="17" style="v" sid="GEN 43:17" />ಯೋಸೇಫನು ಹುಕುಮ್‌ನಿತರಸ್ ಘರ್‌ದೇಖಿಲ್ಯವಾಳನೆ ಇವ್ಣುನ ಯೋಸೇಫನ ಘರ್ಮ ಬುಲೈಲೀನ್ ಗಯೊ. <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />ಯೋಸೇಫನ ಘರೆ ಬುಲೈಲಾಯೂತೆ ದೇಖಿನ್ ಇವ್ಣೆ ಡರಿನ್, “ಪಹಿಲಿ ಬಾರ್ ಅಪ್ಣ ಕೋಥ್‌ಳಾ ಪಾಛ಼ ಲೀನ್ ಗಯಾತೆ ಪೈಶಾನ ಖ್ಹಾಜೇಸ್‌ ಇನೆ ಅಪ್ಣುನ ಇನ ಘರ್ಮ ಬುಲೈರಾಖ್ಯೋಸ್. ಫಕ್ಕರಿ ಅಪ್ಣಪರ್ ಪಡೀನ್ ಅಪ್ಣುನ ಗುಲಾಮ್‌ಬಣೈನ್ ಅಪ್ಣ ಗಧೇಡಾವ್ನ ಛಿನೈಲಿಶೆಕರಿ ದೆಖಾವಸ್” ಕರಿ ಇವ್ಣ ಇವ್ಣಾಮಸ್ ಬೋಲಿಲಿದ. <verse eid="GEN 43:18" /><verse number="19" style="v" sid="GEN 43:19" />ಘರ್‌ನ ದರ‍್ವಾಜ಼ಕನ ಜೈ಼ನ್ ಯೋಸೇಫನು ಘರ್‌ ದೇಖಿಲ್ಯಾವಳನ, <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />“ಅಲಾ ಯಜಕ್, ಫೈಲಿ ಏಕ್‌ ವಖ್ಹ್‌ತೆ ಹಮೆ ಅನಾಜ಼್‌ನು ರಾಛು಼ ಲೀನ್‌ಜಾ಼ವಾನ ಆಯಾಥ. <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />ಹಮೆ ಜೈ಼ನ್ ಥಾತೆ ಡೇರಾಮ ಹಮಾರ ಕೋಥ್‌ಳಾವ್ನ ಛೋ಼ಡಿನ್ ದೇಖಾಖ್ಹತರ್ ಹರೇಕ್‌ಜ಼ಣಾನ ಪೈಶಾನ ವಜ಼ನ್‌ಮ ಜ಼ರಾಬಿ ಕಮ್‌ಕೊಂತೆ ತಿನತಿನ ಕೋಥ್‌ಳಾಮಾಸ್‌ ಥು. ಇನ ಪಾಛು಼ ಫರಾವನ ಲೀನ್ ಆಯಾ. <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />ಅನಾಜ಼್ ಮೋಲ್‌ಲ್ಯಾವಾನಖ್ಹಾಜೆ ಅಲಕ್ ಪೈಶಾ ಲೈರಾಖ್ಯಾಸ್. ಯೊ ಪೈಶಾನ ಹಮಾರ ಕೋಥ್‌ಳಾಮ ಕೋಣ್ ಘಾಲ್ಯೂಕಿ ಹಮುನ ಮಾಲುಮ್ ಕೊಯ್ನಿ” ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 43:22" /><verse number="23" style="v" sid="GEN 43:23" />ಇನಖ್ಹಾಜೆ ಯೊ ಘರ್‌ದೇಖಿಲ್ಯಾವಾಳನೆ, “ತುಮೆ ಸಮಾಧಾನ್‌ಥಿ ರ‍್ಹವೊ. ತುಮೆ ಶಾತ್ಬಿ ಡರೊನಕೊ ತುಮುನಾಬಿ ತುಮಾರ ಬಾನಾಬಿ ದೇವ್‌ ಹುಯಿರ‍್ಹವಾಳನೆ ತುಮಾರ ಕೋಥ್‌ಳಾಮ ಪೈಶಾ ಘಾಲ್ಯೊ ಉಶೆ. ತುಮಾರ ಪೈಶಾ ಮನ ಮಳ್ಯ” ಕರಿಬೋಲಿನ್, ಇನೆ ಸಿಮೆಯೋನ್ನ ಇವ್ಣಕನ ಬುಲೈಲಿನ್ ಆಯೊ. <verse eid="GEN 43:23" /><verse number="24" style="v" sid="GEN 43:24" />ಇನಪಾರ್ ಇವ್ಣ ಅಖ್ಖಾಸ್ನ ಯೋಸೇಫನ ಘರ್ಮ ಇನೆ ಬುಲೈಲೀನ್ ಆಯೊ. ಹಾತ್‌ ಗೋಡಾ ಧೊವಾನ ಪಾಣಿ ದೆವಾಡಿನ್, ಇವ್ಣ ಗಧೇಡವ್‌ನಾಬಿ ಚಾ಼ರೊ ನಖಾಯೊ. <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />ಇವ್ಣೆ ಹಿಜ್ಜಾ಼ಸ್ ಖಾಣುಖಾವ್‌ಣು ಕರಿ ವಾತೆ ಇವ್ಣೆ ಖ್ಹಮ್‌ಜ್ಯಾಥಾತೆ ಇನಾಖ್ಹಾಜೆ ಇವ್ಣೆ ಲಾಯಥಾತೆ ಕಾಣ್ಕೆನ ಯೋಸೇಫನ ದ್ಯವಾನ ತಯಾರ್ ಕರಿಲಿದ. <verse eid="GEN 43:25" /><verse number="26" style="v" sid="GEN 43:26" />ಯೋಸೇಫ ಘರೆ ಆವಾದಿನ್‌, ಇವ್ಣೆ ಇವ್ಣ ಹಾತ್‌ಮ ಥೂತೆ ಕಾಣ್ಕೆನ ಘರ್ಮಲಾಯಿನ್ ಇನ ದೀನ್ ಇನ ಖ್ಹಾಮ್ಣೆ ಆಡ್‌ಪಡ್ಯ. <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />ಇನೆ ಇವ್ಣುನ ಅಛ಼್ಛ ಛಾ಼ಕಿ ಕಿಮ್‌ಛಾ಼ ಕರಿಪುಛೈ಼ನ್‌ ಇವ್ಣುನ ಶಾತ್ ಬೋಲ್ಯೋಕತೊ, “ತುಮೆ ಬೋಲ್ಯಾತೆ ಬುಢೋಹುಯಿಗೋತೆ ತುಮಾರೊ ಬಾ ಅಛ್ಛೊ಼ ಛಾ಼ಕಿಶೂ? ಯೊ ಬಿಜೂ಼ಬಿ ಬಚಿರ‍್ಹೋಸ್‌ಕಿಶೂ? ಕರಿ ಪುಛಾ಼ಯೊ. <verse eid="GEN 43:27" /><verse number="28" style="v" sid="GEN 43:28" />ಇವ್ಣೆ ಪಾಛ಼ ಜ಼ಮೀನ್‌ಲಗು ಮುಡ್‌ಕ್ಯು ಝು಼ಕೈನ್ ಖ್ಹಲಾಮ್‌ಕರೀನ್‌, “ತುಮಾರೊ ಆಳ್‌ಹುಯಿರೋತೆ ಹಮಾರೊ ಬಾ ಹಮ್ಕೆಲಗೂಬಿ ಅಛ್ಛೊ಼ಛಾ಼, “ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 43:28" /><verse number="29" style="v" sid="GEN 43:29" />ತದೆ ಇನೆ ಡೋಳಪಾಡಿ ಇನಿ ಪೀಠೆ ಪೈದಹುಯೋತೆ ಭೈ ಬೆನ್ಯಾಮೀನ್ನ ದೇಖಿನ್, “ತುಮೆ ಬೋಲ್ಯಾತೆ ತುಮಾರೊ ನ್ಹಾನೊ ಭೈ ಆಸ್ ಕಿಶು?” ಕರಿ ಪುಛೈ಼ನ್ ಇನ, “ಛೋ಼ಕ್ರ ದೇವ್ನಿ ಪ್ಯಾರ್ ತಾರಪರ್ ರ‍್ಹಾವಾದೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />ಯೋಸೇಫ ನ್ಹಾನ ಭೈನ ದೇಖಿನ್ ಇನು ಪೇಟ್‌ಬಳಾತೆ ಇನಖ್ಹಾಜೆ ಯೊ ಒಗ್ಗೀಸ್ ಇನ ಘರ್ಮಜೈ಼ನ್ ರೊಯೊ. <verse eid="GEN 43:30" /><verse number="31" style="v" sid="GEN 43:31" />ಇನಾಪಾರ್ ಮ್ಹೋಡು ಧೊಯ್‌ಲೀನ್ ಭಾರ್ ಆಯಿನ್, ದಿಲ್‌ ಘಟ್ ಕರಿಲೀನ್, “ಖಾಣು ನಾಖೊ” ಕರಿ ಹುಕುಮ್ ಕರ‍್ಯೊ. <verse eid="GEN 43:31" /><verse number="32" style="v" sid="GEN 43:32" />ಖಾಣು ನಾಖವಾಳವ್‌ನೆ ಇನಾಬಿ ಇನ ಭೈಯೇನಾಬಿ ಇನ ಜೋ಼ಡ್ಮಥಾತೆ ಈಜಿಪ್ಟ್‌ವಾಳನಬಿ ಅಲಕ್‌ ಅಲಕ್‌ ಬೇಖ್ಹಾಡಿನ್ ಖಾಣುನಾಖ್ಯು. ಶನಕತೊ ಈಜಿಪ್ಟ್‌ವಾಳು ಇಬ್ರಿಯವಾಳನ ಜೋ಼ಡೆ ಪಂತೀಮ ಬೇಶಿನ್ ಖಾಣು ಖಾತೂಥು ಕೊಯ್ನಿ. ಯೊ ಈಜಿಪ್ಟ್‌ವಾಳನ ಕಚಿಂಡ್‌ ಹುಯಿರೂಥು. <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />ಯೋಸೇಫನೆ ಇನ ನ್ಹಾನ ಮೋಟ ಭೈಯೇನ, ಶಾಣಾಥಿ ಧರೀನ್ ಅಡ್ಡಾಣಿಲಗೂಬಿ, ಇವ್ಣಿ ಇವ್ಣಿ ಉಂಬರ್‌ನಿ ಪರಕ್ಕಸ್‌ ಬೇಖ್ಹಾನಿತರ ಕರ‍್ಯೊತೆ ಇನಖ್ಹಾಜೆ, ಇವ್ಣ ಇವ್ಣಾಮಸ್ ಆಶ್ಚರ್ಯಕರ‍್ಯು. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />ಯೋಸೇಫನೆ ಇನ ಖ್ಹಾಮ್ಣೆ ಮ್ಹೇಲಿರಾಖ್ಯುಥೂತೆ ಖಾಣಮಾಥು ಇವ್ಣುನ ಭಾಗ್‌ ದಿಮೋಕ್‌ಲ್ಯೊ. ಇನಾಮ ಬೆನ್ಯಾಮೀನ್ನ ಗಯೋತೆ ಭಾಗ್‌ ಯೊ ಅಖ್ಖಾನ ಭಾಗ್‌ಥಿ ಪಾಚ಼್‌ ಪಟ್‌ಯೆತ್ರು ಜಾ಼ಖ್ಹತ್‌ಥು. ಇವ್ಣೆ ಘಣು ಖೈಪೀನ್ ಯೋಸೇಫನಿ ಜೋ಼ಡ್ಮ ಖ್ಹುಶೀಥಿ ಥ.<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">ಯೋಸೇಫ್‌ಥಿ ಭಯೇನ ತರೀಪ್‌ಶ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />ಯೋಸೇಫನೆ ಇನಪಾರ್ ಇನು ಘರ್‌ ದೇಖಿಲ್ಯಾವಾಳನ ಬುಲೈನ್, “ಯೊ ಅದ್ಮೆವ್ ಕೋಥ್‌ಳಾಮ ಢೊವಾಯೆತ್ರೆ ಅನಾಜ಼್ ಭರೈನ್, ಏಕೇಕ್‌ ಜ಼ಣಾನ ಕೋಥ್‌ಳಾನ ಮ್ಹೋಡಾಮ ಇವ್ಣ ಇವ್ಣ ಪೈಶಾನು ಗಾಟ್‌ಡು ಮ್ಹೇಲೊ. <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />ನ್ಹಾನನ ಕೋಥ್‌ಳಾಮ ಇನೆ ಅನಾಜ಼್‌ನ ಲಾಯೋತೆ ಪೈಶಾ ಕಾಹೆತೆ, ಮೇ ಪೀಯಾನು ರೂಪಾನು ಕಟೋರೊಬಿ ಘಾಲ್ನು” ಕರಿ ಹುಕುಮ್‌ದಿದೊ. ಘರ್‌ದೇಖಿಲ್ಯವಾಳನೆ ಇಮ್ಮಸ್‌ಕರ‍್ಯೊ. <verse eid="GEN 44:2" /><verse number="3" style="v" sid="GEN 44:3" />ವ್ಹಾಣೆ ವೇಳಿಸ್, ಇವ್ಣ ಭಯ್ಯೇನ ಗಧೇಡವ್‌ನ ಜೋ಼ಡೆ ಮೋಕ್‌ಲ್ಯೊ. <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />ಇವ್ಣೆ ಖ್ಹಯೇರ್ ಮ್ಹೇಲಿನ್ ಥೋಡಿದೂರ್‌ ಜಾ಼ವಾನ ಮಹಿಮ, ಯೋಸೇಫನೆ ಇನು ಘರ್‌ ದೇಖಿಲ್ಯಾವಾಳನ, “ತೂ ಉಠಿ ಜೈ಼ನ್ ಇವ್ಣುನ ಪೀಛೆಕರಿ ಧರಿಲಿನ್‌ ಇವ್ಣುನ, ‘ತುಮೆ ಅಛ಼್ಛುಕರಾನ ಬದಲ್‌ ಧೋಕ ಶನ ದಿದ? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />ಯೊ ಕಟೋರಾಮ ಮಾರೊ ಯಜಮಾನ್‌ ಪೀಯಾಸ್ ಕಾಹೇಕಿಶೂ? ಇನಾಸ್‌ ದೇಖಿನ್ ಅಗಾಡಿ ಚಾ಼ಲ್‌ಶೇತೆ ಬೋಲಾಸ್ ಕಾಹೇಕಿಶೂ? ತುಮೆ ಅಮ್ ಕರ‍್ಯಾತೆ ಖರಾಬ್ ಕಾಮ್‌’ ಕರಿ ಇವ್ಣುನ ಬೋಲ್ ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 44:5" /><verse number="6" style="v" sid="GEN 44:6" />ಘರ್‌ ದೇಖಿಲ್ಯಾವಾಳನೆ ಇವ್ಣ ಪೀಠೆ ಜೈ಼ನ್ ಇವ್ಣುನ ಆ ವಾತೆ ಬೋಲಾನಿ ವಖ್ಹ್‌ತೆ <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />ಇವ್ಣೆ ಇನ, “ಅಲಾ ಮಾಲಿಕ್, ತೂ ಅಥ್ರಾನಿವಾತ್ ಬೋಲೆಜಾ಼ಯ್‌? ತಾರ ಆಳ್‌ ಹುಯಿರಾತೆ ಹಮೆ ಅಥ್ರಾನು ಕಾಮ್ ಕದೇಬಿ ಕರವಾಳ ಕಾಹೆ. <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />ಪಹಿಲೆ ಹಮಾರ ಕೋಥ್‌ಳಾನ ಮ್ಹೋಡಾಮ ಹಮುನ ಮಳ್ಯುತೆ ಪೈಶಾನ ಹಮೆ ಕಾನಾನ್ ದೇಖ್ಹ್‌ಥ ಪಾಛ಼ಲೈನ್ ತುಮುನ ದಿದ. ಅಮ್‌ರ‍್ಹಾವಪರ್ ಹಮೆ ತಾರ ಯಜಮಾನ್ನ ಘರ್‌ಮಾಥು ಖ್ಹೊನ್ನ ರೂಪಾನ ಶನ ಚೋ಼ರಿಕರಿಲಿಶು? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />ಯೊ ಕಟೋರಿ ತುಮಾರ ಆಳ್‌ಹುಯಿರಾತೆ ಹಮಾರಮ ಕಿನಾಕನ ತೋಬಿ ಮಳ್ಯುತೊ, ಇನ ಮರಣ್ ದಂಡ್‌ಹುವಾದೆ. ಎತ್ರೇಸ್ ಕಾಹೆತೆ, ಹಮೆ ಖ್ಹಾರೂಸ್ ಹಮಾರ ಯಜಮಾನ್ನ ಆಳ್‌ಹುಯ್‌ರಿಶು” ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 44:9" /><verse number="10" style="v" sid="GEN 44:10" />ಇನಖ್ಹಾಜೆ ಇನೆ, “ಅಛ್ಛೂ಼ಸ್, ತುಮೆ ಬೋಲ್ಯಾತೆ ಇಮ್ಮಸ್‌ ಹುವಾದೆ. ಯೊ ಕಟೋರಿ ಕಿನಾಕನ ಮಳಸ್ಕಿ, ಯೊ ಮನ ಆಳ್‌ಹುಯಿಜಾ಼ವ್ಣು. ಬಿಜು಼ಜ಼ಣು ಇನ ಗಲ್‌ತಿಕಾಹೆ” ಕರಿ ಬೋಲಾನಿ ವಖ್ಹ್‌ತೆ, <verse eid="GEN 44:10" /><verse number="11" style="v" sid="GEN 44:11" />ಇವ್ಣೆ ಫಟ್‌ಕರಿ, ಹರೇಕ್ ಜ಼ಣೂಬಿ ಇವ್ಣ ಇವ್ಣ ಕೋಥ್‌ಳಾನ ಜ಼ಮೀನ್‌ಪರ್‌ ಉತಾರೀನ್ ಯೊ ಅಖ್ಖಾನ ಛೋ಼ಡ್ಯಾ. <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />ಇನೆ ಶಾಣೇಥಿ ಧರೀನ್ ಅಡ್ಡಾಣಿಲಗು ತರೀಪ್‌ಶ ಕರೀನ್ ದೇಖ್ಯೊ. ಯೊ ಕಟೋರೊ ಬೆನ್ಯಾಮೀನ್ನ ಕೋಥ್‌ಳಾಮ ಮಳ್ಯು. <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />ತದೆ ಇವ್ಣೆ ಇವ್ಣ ಲುಂಗ್ಡಾನ ಫಾಡಿಲೀನ್ ಇವ್ಣ ದುಖ್‌ನ ವತಾಳ್ಯ; ಕೋಥ್‌ಳಾವ್ನ ಗಧೇಡವ್‌ಪರ್ ಢೊಯಿಲೀನ್‌ ಪಾಛ಼ ಖ್ಹಯೇರ್‌ನ ಆಯ. <verse eid="GEN 44:13" /><verse number="14" style="v" sid="GEN 44:14" />ಯೆಹೂದಬಿ ಅಜು಼ ಇನ ಭೈಯೇಬಿ ಯೋಸೇಫನ ಘರೆ ಆಯ. ಯೊ ಅಜೂ಼ಬಿ ಹಿಜ್ಜಾ಼ಸ್ ಥೊ. ಇವ್ಣೆ ಇನ ಖ್ಹಾಮ್ಣೆ ಆಡ್‌ಪಡ್ಯ. <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />ಯೋಸೇಫನೆ ಇವ್ಣುನ, “ತುಮೆ ಅಮ್‌ ಶನ ಕರ‍್ಯ? ಮಾರಿನಿತರಾನು ಅದ್ಮಿ ದೇವ್ನಿ ವಾತ್‌ಖ್ಹಾರಿ ಮಾಲುಮ್‌ ಕರಿಲಿಷ್ ಕರಿ ತುಮುನ ಮಾಲುಮ್‌ಥುನಿ?” ಕರಿ ಪುಛಾ಼ವಖ್ಹತರ್, <verse eid="GEN 44:15" /><verse number="16" style="v" sid="GEN 44:16" />ಯೆಹೂದನೆ, “ಹಮೆ ಹಮಾರ ಯಜಮಾನ್ನ ಶಾತ್‌ಬೋಲಿಯೆ? ಹಮೆ ಶಾತ್ ಫೇಡೈಯೆ? ಹಮೆ ನೀತಿವಾಳಹುಯಿನ್ ವತಾಳ್ನುಕತೊ ಶಾತ್‌ಕರ‍್ನು? ತಾರ ಆಳ್‌ನ ಪಾಪ್ನು ಕಾಮ್ನ ದೇವ್ನೆ ಭಡ್‌ಕೈರಾಖ್ಯೋಸ್‌. ಆ ಕಟೋರಿ ಕಿನಾಕನ ಮಳ್ಯುಕಿ ಯೊ ಖಲಿ ಕಾಹೆತೆ ಹಮೆ ಖ್ಹಾರೂಬಿ ಹಮಾರ ಯಜಮಾನ್ನ ಗುಲಾಮ್‌ಹುಯಿಗ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 44:16" /><verse number="17" style="v" sid="GEN 44:17" />ಯೋಸೇಫನೆ, “ಇಮ್‌ಕದೇಬಿ ನಾಹೋಣು ಆ ಕಟೋರಿ ಕಿನಾಕನ ಮಳ್ಯೂಕಿ ಯೊ ಖಲಿ ಮನ ಗುಲಾಮ್‌ ಹುಯಿರಾವದೆ. ಬಿಜು಼ಖ್ಹಾರು ಸಮಾಧಾನ್‌ಥಿ ತುಮಾರ ಬಾಕನ ಜಾ಼ವೊ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 44:17" /></para>
  <para style="s">ಬೆನ್ಯಾಮೀನ್ನಖ್ಹಾಜೆ ಯಹೂದನಿ ಬಿಂತಿ</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />ತದೆ ಯೆಹೂದ ಖನ್ನೆ ಆಯಿನ್, “ಮಾರೊ ಒಡೆಯ, ತಾರೊ ಆಳ್‌ಹುಯಿರೋತೆ ಮೇ ಎಕ್ ವಾತ್ ಮಾರ ಮಾಲಿಕ್‌ನ ಛೋ಼ಡಿ ಬೋಲಾನ ಹುಕುಮ್‌ಹೋಣು. ತಾರ ದಾಸನ ಉಪ್ಪರ್ ಇರಾದೊ ನಾಕರ‍್ನು ಶನಕತೊ ತೂ ಫರೋಹನಿ ಬರೋಬರ್‌ಕರಿ ಮನ ಮಾಲುಮ್. <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />ಮಾರ ಮಾಲಿಕ್ ಹುಯಿರೋತೆ ತೂ ಆಳ್‌ಹುಯಿರಾತೆ ಹಮಾರಿ ಬಾರೇಮ, ‘ತುಮುನ ಬಾ ಹುಯಿರ‍್ಹವೊ, ನ್ಹಾನೊ ಭೈ ಹುಯಿರ‍್ಹವೊ ಛಾ಼ಕಿಶೂ?’ ಕರಿ ಬೋಲಾಖ್ಹತರ್, <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />ಹಮೆ, ‘ಹಮುನ ಬುಢೋ ಬಾ ಛಾ಼, ಇನ ಬುಢಾಪರ್ ಪೈದಹುಯೋತೆ ಏಕ್‌ನ್ಹಾನೊ ಛಿಯ್ಯೊಬಿ ಛಾ಼, ಇನಿ ಪಾಕ್ತಿನೊ ಪೈದಹುಯೋತೆ ಮರಿಗಯೊ. ಇನಾಖ್ಹಾಜೆ ಇನಿ ಆಯಾಮ ಪೈದಹುವವಾಳಮ ಯೊ ಎಕ್ಕಸ್‌ಜ಼ಣೊ ಬಚಿರ‍್ಹೋಸ್. ಇನಾಪರ್ ಬಾನ ಘಣಿ ಪ್ಯಾರ್‌ ಛಾ಼’ ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />ತದೆ ತುಮೆ, ‘ಮೇ ಯೊ ಛೋ಼ಕ್ರಾನ ದೇಕ್ಣು ಇನ ಮಾರಕನ ಬುಲೈಲೀನ್ ಆವೊ’ ಕರಿ ಹುಕುಮ್ ತುನೆ ದಿದೊ. <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />ಹಮೆ, ‘ಆ ಛೋ಼ಕ್ರು ಬಾನ ಮ್ಹೇಲಿನ್ ರ‍್ಹಾವಾನ ಹೋಯಿಕೊಯ್ನಿ; ಯೊ ಅಲಕ್ ಹುಯಿಗುತೊ ಬಾ ಮರಿಸ್‌ಜಾ಼ಶೆ’ ಕರಿ ಯಜಮಾನ್ ಹುಯಿರೋತೆ ತುನ ಹಮೆ ಬೋಲ್ಯ. <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />ಇನಾಖ್ಹಾಜೆ ತುನೆ, ‘ತುಮಾರೊ ನ್ಹಾನೊ ಭೈ ತುಮಾರಿ ಜೋ಼ಡ್ಮ ನಾ ಆಯೋತೊ ಬಿಜೇಕ್‌ ವಖ್ಹತ್ ತುಮೆ ಮಾರುಮ್ಹೋಡು ನಾದೇಕ್ಣು’ ಕರಿ ಬೋಲ್ಯೊನಿ, <verse eid="GEN 44:23" /><verse number="24" style="v" sid="GEN 44:24" />“ತುಮಾರೊ ಆಳ್‌ಹುಯಿರಾತೆ ಹಮೆ ಹಮಾರ ಬಾಕನ ಜೈ಼ನ್ ಯಜಮಾನ್‌ ಹುಯಿರೋತೆ ತಾರಿ ವಾತ್ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯ. <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />ಹಮಾರೊ ಬಾ, ‘ತುಮೆ ಬಿಜೇಕ್‌ ವಖ್ಹತ್ ಜೈ಼ನ್ ಅನಾಜ಼್ ಲೀನ್‌ಆವೊ’ ಕರಿ ಬೋಲಖ್ಹತರ್, <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />ಹಮೆ ಇನ, ‘ಕಿಮ್ ಜಾ಼ವಾನು, ನ್ಹಾನೊ ಭೈ ಹಮಾರಿ ಜೋ಼ಡ್ಮ ರ‍್ಹಯೋತೋಸ್ ಹಮೆ ಜೈ಼ಯೇಸ್. ನಾ ಹುಯುತೊ ಹಮೆ ಯೊ ಅದ್ಮಿನು ಮ್ಹೋಡು ದೇಖಾನ ಕೋಹುವಾನಿ’ ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 44:26" /><verse number="27" style="v" sid="GEN 44:27" />ಇನಖ್ಹಾಜೆ ತಾರೊ ಸೇವಕ್‌ ಹಮಾರೊ ಬಾನೆ, ‘ಮಾರಿ ಬಾವಣ್‌ಮ ಮನ ಬೇಸ್ ಪರ್ಖ್ಹ ಲಡ್ಕ ಪೈದಹುಯಕರಿ ತುಮುನ ಮಾಲುಮ್ ಛಾ಼ತೆ ವಾತೆ. <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />ಇವ್ಣಾಮ ಏಕ್ಜ಼ಣೊ ಮನ ಮ್ಹೇಲಿನ್ ಚ಼ಲೇಗಯೊ; ಯೊ ಝಾ಼ಡೀನ ಜಾನ್‌ವಾರ್‌ಥಿ ಚೀರೈಜಾ಼ವಾಮ ಶನು ಗುಮಾನೀಸ್‌ ಕೊಯ್ನಿಕರಿ ಮೇ ಮಾಲುಮ್ ಕರ್‌ಲಿದೊ. ತಪ್‌ಥೊ ಮೇ ಇನ ದೇಖ್ಯೋಕೊಯ್ನಿ. <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />ಹಮ್ಕೆ ಛಾ಼ತೆ ಅನಾಬಿ ಮಾರಕಂಥು ಲೀಜಾ಼ವ್ಣುಕರಿ ಛಾ಼. ಅನಾಬಿ ಕಾಯ್‌ತೋಬಿ ಖತ್ರಹುಯಿಗುತೊ, ಆ ಬುಢು ಮುಡ್‌ಕ್ಯು ಕುಢಾಪಥಿ ಮರಿಜೈ಼ಶ್ ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 44:29" /><verse number="30" style="v" sid="GEN 44:30" />“ತುಮಾರೊ ಆಳ್‌ಹುಯಿರೋತೆ ಹಮಾರ ಬಾಕನ ಗಯಾತೊ, ಇನೋ ಜಾನ್ನೊ ಜಾನ್‌ಹುಯಿರೋತೆ ಆ ಛೋ಼ಕ್ರು ಹಮಾರಿಜೋ಼ಡ್ಮ ನಾರ‍್ಹಯುತೊ, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />ಯೊ ಛೋ಼ಕ್ರು ಹಮಾರಿ ಜೋ಼ಡ್ಮ ಕೊಯ್ನಿಕರಿ ಮಾಲುಮ್‌ ಪಡ್ತಸ್‌ ಮರಿ ಜಾ಼ಶೆ. ತದೆ ತುಮಾರ ಆಳ್‌ಹುಯಿರಾತೆ ಹಮೇಸ್, ಬುಢೊ ಹುಯಿರೋತೆ ಹಮಾರೊ ಬಾನ ಕುಢಾಪೇಥೀಸ್ ಮರಿಜಾ಼ವನ ಕಾರಣ್ಉಶು. <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />ಸೇವಕ್‌ ಹುಯಿರೋತೆ ಮೇ ಮಾರ ಬಾಕನ ಆ ಛೋ಼ಕ್ರಾನಿ ಜಿಮ್ಮೇದಾರಿಲೀನ್, ‘ಮೇ ಅನ ಬುಲೈಲಿನ್ ನಾ ಆಯೋಹೋತ್ತೊ, ಕದೆಕದೇಬಿ ಬಾನ ಧೋಕೊ ದ್ಯವಾಳೊಹುಯಿರೀಶ್‌’ ಕರಿ ವಾತ್ ದೀರಾಖ್ಯೋಸ್. <verse eid="GEN 44:32" /><verse number="33" style="v" sid="GEN 44:33" />“ಅಮ್‌ರ‍್ಹವಾಪರ್ ಮೇ ಆ ಛೋ಼ಕ್ರಾನ ಬದಲ್ ಯಜಮಾನ್ ಹುಯಿರೋತೆ ತುನ ಗುಲಾಮ್‌ ಹುವಾನಿಘೋಣಿಬಿ ಆ ಹೈರೋತೆ ಇನ ಭೈಯೇನಿ ಜೋ಼ಡ್ಮ ಜಾ಼ವಾನಿತರಾಬಿ ಕರ್‌ ಕರಿ ಗಿಂಗೈಲೆವುಸ್‌. <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />ಆ ಛೋ಼ಕ್ರಾನ ಮ್ಹೇಲಿನ್ ಮಾರ ಬಾಕನ ಮೇ ಕಿಮ್ ಜ಼ವ್? ಗಯೋತೊ, ಮಾರ ಬಾನ ಉಶೇತೆ ಕುಢಾಪ, ದುಖ್ ಮಾರೇಥಿ ದೇಖಾನ ಕೊಹೋಯ್ನಿ”. ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">ಯೋಸೇಫ ಕೋಣ್‌ಕರಿ ಇನ ಭೈಯೇನ ಮಾಲುಮ್‌ ಕರಾಯೋತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />ಯೋಸೇಫ ಅನ ಖ್ಹಮ್‌ಜಿನ್ ಇನಾಕನ ಭಿಯರ‍್ಹಾವಳನ ಖ್ಹಾಮ್ಣೆ ದುಖ್ ಖ್ಹಮಾಳನ ಕೊಹೋಯ್ನಿತೆ, ಖ್ಹಾರಾನ ಮಾರಕಂಥು ಭಾರ್ ಮೋಕ್ಲೊ” ಕರಿ ಚಿಕ್‌ರ‍್ಯೊ. ಯೋಸೇಫನೆ ಇನ ನ್ಹಾನಮೋಟ ಭೈಯೇನ ಇನು ಖ್ಹಣೇದ್‌ ಮಳಾನಿತರ ಕರಾನಿ ವೇಳ್ಮ ಬಿಜು಼ ಕೋಣ್ಬಿ ಖನ್ನೆ ಕೋಥೂನಿ. <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />ಯೊ ಜೋ಼ರೇಖ್ಹು ರೋಯೊತೆ ಇನಖ್ಹಾಜೆ ಈಜಿಪ್ಟ್‌ವಾಳಾನಾಬಿ, ಫರೋಹನ ಘರ್‌ವಾಳನಾಬಿ ಯೊ ಅವಾಜ಼್‌ ಖ್ಹಮಜ಼್‌ಪಡ್ಯು. <verse eid="GEN 45:2" /><verse number="3" style="v" sid="GEN 45:3" />ತದೆ ಯೋಸೇಫ್‌ನೆ, ಇನ ನ್ಹಾನ ಮೋಟ ಭೈಯೇನ, “ಮೇ ಯೋಸೇಫ, ಮಾರೊ ಬಾ ಬಿಜೂ಼ಬಿ ಛಾ಼ಕಿಶೂ?” ಕರಿ ಬೋಲಾಖ್ಹತರ್ ಇವ್ಣೆ ಇನ ಖ್ಹಾಮ್ಣೆ ಅಕ್‌ಬಕೈನ್ ಫೇಡ್‌ದ್ಯಾವಾನ ಕೋಹುಯುನಿ. <verse eid="GEN 45:3" /><verse number="4" style="v" sid="GEN 45:4" />ಅಜು಼ ಯೋಸೇಫನೆ, “ಮಾರ ಖನ್ನೆ ಆವೊ” ಕರಿ ಭೈಯೇನ ಬೋಲಾಖ್ಹತರ್‌ ಇವ್ಣೆ ಖನ್ನೆ ಆಯಾ. ಇನೆ ಇವ್ಣುನ “ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ವೇಚಿನಾಖ್ಯಾತೆ ತುಮಾರೊ ನ್ಹಾನೊ ಭೈ ಯೋಸೇಫ ಮೇಸ್. <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />ಮನ ತುಮೆ ಇಮ್ ವೇಚಿನಾಖ್ಯಾತೆ ಇನಖ್ಹಾಜೆ ವೇಚ಼್‌ಣೆಥಿ ದುಖ್‌ ನಕೊ ಕರೊ. ದೇವ್ನೆಸ್ ತುಮೂನ ಬಚಾ಼ಡಾನಖ್ಹಾಜೆ ಮನ ತುಮಾರೇಥಿ ಅಗಾಡಿ ಹಜ್ಜಾ಼ ಮೋಕ್‌ಲ್ಯೊ. <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />ದೇಖ್ಹ್‌ಮ ಕಾಳ್‌ದುಕಾಳ್ ಆಯಿನ್ ತದೇಸ್‌ ಬೇ ವರಖ್ಹ್ ಹುಯ್ಗ. ಬಿಜೂ಼ಬಿ ಪಾಚ಼್‌ ವರಖ್ಹ್‌ಲಗು ಬಿತ್ ಕರಾನರ‍್ಹವೋ, ವ್ಹಾಡ್‌ವಾನರ‍್ಹವೋ, ಮೋಕಕೊಯ್ನಿ. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />ತುಮಾರಿ ಖಾನ್‌ದಾನ್‌ ಜ಼ಮೀನ್‌ಪರ್‌ ಬಚಾ಼ನಿತರಾಬಿ ತುಮೆ ಆ ಖತ್ರಾಮ ಜಾನ್‌ ಬಚಾ಼ಯೊ, ಘಣು ಅದ್ಮಿ ಹುವಾನಿತರಾಬಿ ದೇವ್ನೆ ಮನ ಅಗಾಡಿ ಮೋಕ್‌ಲ್ಯೋತೆ. <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />ಖ್ಹಚಂಬಿ ಮನ ಮೋಕ್‌ಲ್ಯಾತೆ ತುಮೆ ಕಾಹೆ, ದೇವ್‌ನೇಸ್ ಮನ ಫರೋಹನೋ ಬಾ ಬಣಾಯೊ, ಅಜು಼ ಮಂತ್ರಿ ಬಣೈನ್‌ಬಿ, ಇನಿ ಮಹೇಲ್‌ಮ ಮೋಟೊ ಅದಿಕಾರಿ ಕರೀನ್‌, ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನಪರ್ ಅಖ್ಖೀಸ್‌ ಅದಿಕಾರ್‌ಬಿ ದೀರಾಖ್ಯೋಸ್. <verse eid="GEN 45:8" /><verse number="9" style="v" sid="GEN 45:9" />ತುಮೆ ಜ಼ಲ್ದಿ ಮಾರ ಬಾಕನ ಜೈ಼ನ್ ಇನ, ‘ತಾರೊ ಛಿಯ್ಯೊ ಯೋಸೇಫ ಅಮ್ ಬೊಲ್ಯೊ ಕರೊ ಬೋಲೊ, ದೇವ್ನೆ ಮನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಪರ್ ಮೋಟೊ ಅದಿಕಾರಿ ಕರಿರಾಖ್ಯೋಸ್. ತೂ ಠೇರ್‌ ನಕೋತೆ ಮಾರಾಕನ ಆವ್. <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />ತೂ ಗೋಷೆನ್ ತಬರ್‌ಖಾಮ ಜಿವ್ಣುಕರೇಜಾ಼ಯ್. ತೂಬಿ, ತಾರ ಲಡ್ಕಾವ್‌ಬಿ, ನಾತಿ ಪೋತಿಬಿ, ಮೇಂಢುಢಾಂಡುಬಿ, ಬಿಜು಼ ಖ್ಹಾರುಬಿ ಮಾರಾಕನ ರ‍್ಹಿಶೆ. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />ಆ ಕಾಳ್‌ ದುಕಾಳ್ ಖತಮ್ ಹುವಾನ ಬಿಜೂ಼ಬಿ ಪಾಚ಼್‌ವರಖ್ಹ್‌ ಜಾ಼ವ್ಣು. ಇನಖ್ಹಾಜೆ ತುನಾಬಿ ತಾರ ಘರ್‌ವಾಳನಾಬಿ ತುನಛಾ಼ತೆ ಖ್ಹಾರೂಸ್ ಗರೀಬ್ ನಾಹೋಣುತೆ ತಿಮ್ ಹಜ್ಜಾ಼ ತುಮುನ ಪಾಳೂಸ್‌’ ಕರಿ ಬೋಲುಕರಸ್‌ ಕರಿ ಖ್ಹಮ್‍ಜಾ಼ಡೊ. <verse eid="GEN 45:11" /><verse number="12" style="v" sid="GEN 45:12" />“ಮೇ ಖ್ಹುದ್ ತುಮಾರೇಥಿ ವಾತ್ ಬೋಲಿರಾಖ್ಯೋಸ್ನಿ, ಇನಖ್ಹಾಜೆ ತುಮೇಬಿ ದೇಕ್‌ಶು. ಮಾರಿ ಪೀಟ್‌ನ ಪೈದಹುಯೋತೆ ಬೆನ್ಯಾಮೀನ್‌ಬಿ ದೇಕ್‌ಶೆ. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />ಈಜಿಪ್ಟ್‌ದೇಖ್ಹ್‌ಮ ಮನಾಛಾ಼ತೆ ಮರ‍್ಯಾದಿ ಇಜ಼್ಜತ್‌ನಾಬಿ ತುಮೆ ದೆಖ್ಯಾತೆ ಅಖ್ಖೂಸ್ ಬಾನ ಖ್ಹಮ್‍ಜಾ಼ಡೊ, ಒಗ್ಗೀಸ್ ಇನ ಹಜ್ಜಾ಼ ಬುಲೈಲೀನ್ ಆವೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 45:13" /><verse number="14" style="v" sid="GEN 45:14" />ತದೆ ಇನೊ ಭೈ ಬೆನ್ಯಾಮೀನ್ನ ಗಳುಬಥೈನ್‌ ರೊಯೊ. ಬೆನ್ಯಾಮೀನನಾಬಿ ಇನು ಗಳುಬಥೈನ್‌ ರೊಯೊ. <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />ಆನಾಹುಯಿನ್ ಇನೆ ಹರೇಕ್ ಮೋಟ ಭೈಯೇನಾಬಿ ಬುಚ್ಚಕರೀನ್‌ ಇವ್ಣುನ ಬಥೈಲೀನ್ ರೋಯೊ. ತದೆ ಇವ್ಣೆ ಇನಿಜೋ಼ಡ್ಮ ವಾತೆಬೋಲ್ಯ. <verse eid="GEN 45:15" /><verse number="16" style="v" sid="GEN 45:16" />ಯೋಸೇಫನ ಭೈಯೇ ಆಯಾತೆ ವಾತೆ ಫರೋಹನ ಘರ್‌ವಾಳಾನ ಮಾಲುಮ್ ಪಡಾಮ ಫರೋಹನಾಬಿ ಇನ ಘರ್‌ವಾಳನಾಬಿ ಖ್ಹುಷಿಹುಯು. <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />ಫರೋಹನೆ ಯೋಸೇಫನ ಬುಲೈನ್, “ತೂ ತಾರ ಭೈಯೇನ ಖ್ಹಮ್‌ಜಾ಼ಡ್ನುತೆ ಶಾತ್‌ಕತೊ, ‘ತುಮಾರ ಗಧೇಡವ್‌ಪರ್ ಖ್ಹಾಮಾನ್‌ಅಖ್ಖು ಢೊಯಿಲೀನ್‌ ಕಾನಾನ್ ದೇಖ್ಹ್‌ನ ಜೈ಼ನ್, <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />ತುಮಾರ ಬಾನಾಬಿ, ಘರ್‌ವಾಳನಾಬಿ ಮಾರಾಕನ ಬುಲೈಲೀನ್ ಆವೊ. ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ತುಮುನ ಅಛ್ಛಿ ಜ಼ಮೀನ್ನ ದೆವುಸ್‌. ತುಮೆ ಆ ದೇಖ್ಹ್‌ಮ ಅಛ್ಛು಼ ಖಾವಾನ ತುಮುನ ಮಳ್‌ಶೆ. <verse eid="GEN 45:18" /><verse number="19" style="v" sid="GEN 45:19" />ಅಜು಼ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಘೋಡಾನು ರಥ್‌ಖ್ಹಾರು ಲೀಜೈ಼ನ್ ತುಮಾರಿ ಬಾವಣ್ ಲಡ್ಕಾ ಅಜು಼ ಬಾನಬಿ ಬುಲೈಲೀನ್‌ಆವೊ. <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />ತುಮಾರಿ ಆಸ್ತಿ ಪಾಸ್ತಿನಿ ಬಾರೇಮ ತುಮೆ ಮಾಥು ನಕೋಖಡೈಲೆವೊ. ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮಛಾ಼ತೆ ಘಣು ಅಛ಼್ಛು ರಾಛು಼ಖ್ಹಾರು ತುಮಾರುಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 45:20" /><verse number="21" style="v" sid="GEN 45:21" />ಯಾಕೋಬನ ಛಿಯ್ಯಾ ಯೋಸ್ ಪರಕ್ ಕರ‍್ಯ. ಫರೋಹನ ಹುಕುಮ್‌ನಿ ಪರಕ್ಕಸ್‌ ಯೋಸೇಫ್‌ನೆ ಇವ್ಣುನ ಘೋಡಾನು ರಥ್‌ಖ್ಹಾರೂಬಿ ಜಾ಼ವಾನಿ ವಾಟ್‌ಪರ್‌ ಖಾವಾನ ಖಾಣುಬಿ ದೆವಾಡ್ಯೊ. <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />ಯೊ ನಾಹುಯಿನ್ ಹರೇಕ್ ಜ಼ಣಾನಾಬಿ ಕಿಮ್ಮತ್‌ನು ನವು ಲುಂಗ್ಡು ದಿದೊ. ಬೆನ್ಯಾಮೀನ್ನಾತೋಬಿ ತೀನ್‌ಖ್ಹೊ ರೂಪಾನ ಕಾಖ್ಹ್‌ನ ಅಜು಼ ಪಾಚ಼್‌ ಜೋ಼ಡು ಲುಂಗ್‌ಡುದಿದೊ. <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />ಇನ ಬಾನಖ್ಹಾಜೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನು ಅಛ಼್ಛು ರಾಛು಼ಅಖ್ಖು ದಖ್ಹ್‌ ಗಧೇಡಾಪರ್ ಢೊವಾಡಿನ್, ದಖ್ಹ್‌ ಗಧೇಡಿಪರ್ ಇನೊ ಬಾ ಆವಾನಖ್ಹಾಜೆ ಹೋಣುತೆ ಅಖ್ಖು ಅನಾಜ಼್, ರೋಟ ಅಜು಼ ಬಿಜು಼ಖ್ಹಾರು ಖಾಣನ ದೀಮೋಕ್‌ಲ್ಯೊ. <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />ಇಮ್ಮಸ್ ಇನ ಭೈಯೇನ, “ತುಮೆ ವಾಟ್‌ಪರ್ ಲಡೈನಕೋಕರ್‌ಶು” ಕರಿ ಅಕ್ಕಲ್ ಬೋಲಿನ್ ಇವ್ಣುನ ಮೋಕ್‌ಲ್ಯೊ. ಇವ್ಣೆ ಚ಼ಲೆಗಯ. <verse eid="GEN 45:24" /><verse number="25" style="v" sid="GEN 45:25" />ಇವ್ಣೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ್ಹೇಲಿನ್ ಕಾನಾನ್‌ದೇಖ್ಹ್‌ಮ ಇನ ಬಾ ಯಾಕೋಬ್‌ಕನ ಆಯಾ. <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />ಇನ, “ಯೋಸೇಫ್ ಬಿಜೂ಼ಬಿ ಬಚಿರ‍್ಹೋಸ್ ಯೊ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನೊ ಪ್ರಧಾನ ಅದಿಕಾರಿ ಹುಯಿರೋಸ್” ಕರಿ ಬೋಲಖ್ಹತರ್, ಯೊ ಖ್ಹಮ್‌ಜಿನ್ ಖ್ಹೊಪೋಪಡಿಗೊ. ಅಜು಼ ಇವ್ಣುನ ವಿಶ್ವಾಸ್ ಕರ‍್ಯೋಸ್‌ಕೊಯ್ನಿ. <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />ಇನಪಾರ್ ಯೋಸೇಫ್‌ನೆ ಬೋಲಿ ಮೋಕ್‌ಲ್ಯೋತೆ ವಾತೆಖ್ಹಾರಿ ಖ್ಹಮ್‌ಜಿನ್, ಯೊ ಜಾ಼ವನಖ್ಹಾಜೆ ಯೋಸೇಫ್‌ಭಣಿಥು ಆಯೂತೆ ರಥ್‌ಖ್ಹಾರು ದೇಖ್‌ತಾನ ಯಾಕೋಬನು ದಿಲ್ಮ ಖ್ಹುಶಿಹುಯು. ಯೊ ಕಾಹೆತೆ ಇನ ನವೊ ಜಾನ್‌ ಆವಾಂತ್ರ ಹುಯು. <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />ತದೆ ಯಾಕೋಬನೆ, “ಮಾರೊ ಛಿಯ್ಯೊ ಯೋಸೇಫ ಜಿವ್‌ತೊ ಛಾ಼. ಮನ ಎತ್ರೇಸ್ ಬಶ್‌. ಮೇ ಮರಾನ ಅಗಾಡಿ ಜೈ಼ನ್ ಇನ ದೇಖೂಸ್” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">ಯಾಕೋಬ ಅಜು಼ ಇನು ಕುಟುಂಬ್‌ ಈಜಿಪ್ಟ್‌ನ ಗಯೂತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />ಯಾಕೋಬನೆ ಇನಾಕನ ಥೂತೆ ಖ್ಹಾರೂಸ್ ಲೀನ್ ಚಾ಼ಲ್‌ಕುಚ಼್‌ಕರಿನ್ ಬೇರ್ಷೆಬನ ಆಯೊ. ಹಿಜ್ಜಾ಼ ಇನೊ ಬಾ ಇಸಾಕನೊ ದೇವ್ನ ಖ್ಹಾಮ್ಣೆ ಬಲಿಅಖ್ಖು ಸಮರ್ಪಣ್‌ಕರ‍್ಯೊ. <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />ಯೊ ರಾತ್‌ ದೇವ್ ಯಾಕೋಬನ ಖ್ಹೋಣ್ಯಾಮ ಆಯಿನ್‌, “ಯಾಕೋಬ, ಯಾಕೋಬ” ಕರಿ ಪುಕಾರಖ್ಹತರ್ ಇನೆ “ಹಾ ಛೂ಼” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 46:2" /><verse number="3" style="v" sid="GEN 46:3" />ತದೆ ದೇವ್‌ನೆ, “ಮೇಸ್ ದೇವ್, ತಾರೊ ಬಾನೊ ದೇವ್‌ ಮೇಸ್ “ತೂ ಘಾಟ್ ಉತ್ರೀನ್ ಡರ್‌ಕೊಂತೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಜಾ಼; ಹಿಜ್ಜಾ಼ ತಾರೇತಿ ಘಣು ಜ಼ಗ್‌ಜಾ಼ತ್‌ ಹುವಾಂತರ ಕರೂಸ್‌. <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />ಮೇಸ್ ತಾರಿಜೋ಼ಡ್ಮ ಈಜಿಪ್ಟ್‌ನ ಆವುಸ್‌. ಹಿಜ್ಜಾ಼ಥು ತುನ ಬುಲೈಲೀನ್ ಪಾಛೊ಼ ಆಯಿಶಸ್ ಅಯಿಶ್. ತೂ ಮರಾನ ದನುಮ ಯೋಸೇಫ ತಾರಾಕನ ರ‍್ಹೀನ್ ತಾರ ಡೋಳ ಮೂಚ಼್‌ಶೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 46:4" /><verse number="5" style="v" sid="GEN 46:5" />ಇನಾಪಾರ್ ಯಾಕೋಬ ಬೇರ್ಷೆಬಥೊ ನಿಕ್‌ಳ್ಯೊ. ಫರೋಹನೆ ಇನ ಬುಲೈಲಿನ್ ಆವಾನಖ್ಹಾಜೆ ಮೋಕ್‌ಲ್ಯೋತೆ ರಥಾವ್‌ಮ ಯಾಕೋಬನ ಛಿಯ್ಯಾ ಇನೊ ಬಾ ಯಾಕೋಬನ ಅಜು ಇವ್ಣಿ ಬಾವ್ಣೆ ಲಡ್ಕಾವ್ನ ಬೆಖ್ಹಾಡಿಲೀನ್ ನಿಕ್‌ಳ್ಯಾ. <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />ಯಾಕೋಬಬಿ, ಇನು ಘರ್‌ವಾಳುಖ್ಹಾರುಬಿ ಇವ್ಣು ಢಾಂಡು ಮೇಂಢುಖ್ಹಾರುಬಿ ಇವ್ಣೆ ಕಾನಾನ್ ದೇಖ್ಹ್‌ಮ ಕಮಾಯುಥೂತೆ ದೌಲತ್‌ನಾಬಿ ಲೀನ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಆಯೊ. <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />ಅಮ್ ಯಾಕೋಬನೆ ಇನ ಪರ್ಖ್ಹಾ ತಯೇಡ ಲಡ್ಕಾವ್‍ನಾಬಿ , ನಾತಿಪೋತಿನಾಬಿ ಇನಿ ಅಖ್ಖಿ ಪಿಳ್ಗಿನಾಬಿ ಜೋ಼ಡ್ಮಾಸ್‌ ಬುಲೈಲಿನ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಆಯೊ. <verse eid="GEN 46:7" /><verse number="8" style="v" sid="GEN 46:8" />ಈಜಿಪ್ಟ್‌ನ ಆಯಾತೆ ಯಾಕೋಬ ಅಜು಼ ಇನ ಲಡ್ಕ ಹುಯಿರಾತೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ನಾಮ್‌ಖ್ಹಾರು; ಯಾಕೋಬ ಅಜು಼ ಇನೊ ಪೈಲ್ಹೋಟೊ ಛಿಯ್ಯೊ ರೂಬೇನ್. <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />ರೂಬೇನ್ನ ಲಡ್ಕ; ಹನೋಕ್, ಫಲ್ಲೂ, ಹೆಚ್ರೋನ್, ಕರ್ಮೀ, <verse eid="GEN 46:9" /><verse number="10" style="v" sid="GEN 46:10" />ಸಿಮೆಯೋನ್ನ ಲಡ್ಕ; ಯೆಮೂವೇಲ್, ಯಾಮೀನ್ , ಓಹದ್, ಯಾಕೀನ್, ಚೋಹರ್, ಅಜು಼ ಕಾನಾನ್ಯನಿ ತಯೇಡಮ ಪೈದಹುಯೋತೆ ಸೌಲ. <verse eid="GEN 46:10" /><verse number="11" style="v" sid="GEN 46:11" />ಲೇವಿನ ಛಿಯ್ಯಾ; ಗೇರ್ಷೋನ್, ಕೆಹಾತ್, ಮೆರಾರೀ. <verse eid="GEN 46:11" /><verse number="12" style="v" sid="GEN 46:12" />ಯೆಹೂದನ ಲಡ್ಕ; ಏರ್, ಓನಾನ್, ಶೇಲಾಹ, ಪೆರೆಚ್‌, ಜೆರಹ, ಕತೋಬಿ ಏರ್ ಅಜು಼ ಓನಾನ್ ಕರಿ ಅವ್ಣೆ ಕಾನಾನ್ ದೇಖ್ಹ್‌ಮಾಸ್ ಮರಿಗಯ. ಪೆರೆಚನ ಲಡ್ಕ; ಹೆಚ್ರೋನ್, ಹಾಮೂಲ್. <verse eid="GEN 46:12" /><verse number="13" style="v" sid="GEN 46:13" />ಇಸ್ಸಾಕಾರನ ಲಡ್ಕ; ತೋಲಾ, ಪುವ್ವಾ, ಯೋಬ್, ಶಿಮ್ರೋನ್ ಹುಯಿರ‍್ಹಾಥ. <verse eid="GEN 46:13" /><verse number="14" style="v" sid="GEN 46:14" />ಜೆಬುಲೂನನ ಲಡ್ಕ; ಸೆರೆದ್, ಏಲೋನ್, ಯಹ್ಲೇಲ್‌ ಹುಯಿರ‍್ಹಾಥ. <verse eid="GEN 46:14" /><verse number="15" style="v" sid="GEN 46:15" />ಅವ್ಣೆಖ್ಹಾರು ಲೇಯನಿ ಪಿಳ್ಗಿವಾಳು. ಇನೆ ಯಾಕೋಬಥಿ ಅವ್ಣುನಾಬಿ , ದೀನ ಕರಿ ಛೋ಼ರಿನಾಬಿ ಪದ್ದನ್‌ ಅರಾಮ್ಮ ಜ಼ಣಿ. ಇನೇಥಿ ಪೈದಹುಯುತೆ ಪರ್‌ಖ್ಹೊ ತಯೇಡಲಡ್ಕವ್ ತೀನ್‌ಉಪ್ಪರ್ ಡೋಡಿಖ್ಹ್‌ ಜ಼ಣು. <verse eid="GEN 46:15" /><verse number="16" style="v" sid="GEN 46:16" />ಗಾದನ ಲಡ್ಕ; ಚಿಪ್ಯೋನ್, ಹಗ್ಗಿ, ಶೂನಿ, ಎಚ್ಚೋನ್, ಏರೀ, ಅರೋದೀ, ಅರೇಲೀ; <verse eid="GEN 46:16" /><verse number="17" style="v" sid="GEN 46:17" />ಅಶೇರನ ಛಿಯ್ಯಾ: ಇಮ್ನಾ, ಇಷ್ವಾ, ಇಷ್ವೀ, ಬೆರೀಗಾ, ಅವ್ಣಿನ್ಹಾನಿ ಭೇನ್‌ ಸೆರಹ ಹುಯಿರ‍್ಹಿಥಿ. ಬೆರೀಗನ ಲಡ್ಕಹುಯಿರಾತೆ ಹೆಬೆರ್, ಮಲ್ಕೀಯೇಲ್. <verse eid="GEN 46:17" /><verse number="18" style="v" sid="GEN 46:18" />ಅವ್ಣೆ ಖ್ಹಾರು ಲಾಬಾನನೆ ಇನಿ ಛೋ಼ರಿ ಲೇಯನ ದಿದೋತೆ ಜಿಲ್ಪನಿ ಪಿಳ್ಗಿವಾಳು. ಅನೇಥಿ ಯಾಕೋಬನ ಹುಯುತೆ ಲಡ್ಕಾವ್‌ಬಿ, ನಾತಿಪೋತಿಬಿ, ಮಳೈನ್ ಖ್ಹೋಳ ಜ಼ಣು. <verse eid="GEN 46:18" /><verse number="19" style="v" sid="GEN 46:19" />ಯಾಕೋಬನಿ ಬಾವಣ್ ರಾಹೇಲನ ಲಡ್ಕ, ಯೋಸೇಫ, ಬೆನ್ಯಾಮೀನ್‌. <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಯೋಸೇಫನ ಓನ್‌ ಖ್ಹಯೇರ್‌ನು ಯಾಜಕ ಪೋಟೀಫೆರನಿ ಛೋ಼ರಿ ಆಸನತ್‌ ಕರಿ ನಾಮ್‌ವಾಳಿಮ ಫೈದಹುಯಾತೆ ಮನಸ್ಸೆ ಅಜು಼ ಎಫ್ರಾಯಿಮ್. <verse eid="GEN 46:20" /><verse number="21" style="v" sid="GEN 46:21" />ಬೆನ್ಯಾಮೀನ್ನ ಲಡ್ಕ; ಬಿಳಾ, ಬೆಕೆರ್, ಅಶ್ಬೇಲ್, ಗೇರಾ, ನಾಮಾನ್, ಏಹೀ, ರೋಷ್, ಮುಪ್ಪಿಮ್, ಹುಪ್ಪೀಮ್, ಆರ್ದ್. <verse eid="GEN 46:21" /><verse number="22" style="v" sid="GEN 46:22" />ಆ ಚೌ಼ಧಜ಼ಣ ರಾಹೇಲಥಿ ಯಾಕೋಬನ ಹುಯುತೆ ಪಿಳ್ಗಿವಾಳು. <verse eid="GEN 46:22" /><verse number="23" style="v" sid="GEN 46:23" />ದಾನನೊ ಛಿಯ್ಯೊ: ಹುಶೀಮ್. <verse eid="GEN 46:23" /><verse number="24" style="v" sid="GEN 46:24" />ನಫ್ತಾಲಿನ ಲಡ್ಕ; ಯಹೇಲ್, ಗೂನೀ, ಯೇಚೇರ್, ಶಿಲ್ಲೇಮ್ ಹುಯಿರ‍್ಹಾಥ. <verse eid="GEN 46:24" /><verse number="25" style="v" sid="GEN 46:25" />ಅವ್ಣೆ ಲಾಬಾನನೆ ಇನಿ ಛೋ಼ರಿ ರಾಹೇಲನ ದಿದೊತೆ ಬಿಲ್ಹನಿ ಪಿಳ್ಗಿವಾಳು. ಇನೇಥಿ ಯಾಕೋಬನಹುಯುತೆ ಲಡ್ಕಾಬಿ ನಾತಿ ಪೋತಿಬಿ ಖ್ಹಾತ್ಜ಼ಣ. <verse eid="GEN 46:25" /><verse number="26" style="v" sid="GEN 46:26" />ಯಾಕೋಬನಿ ವ್ಹವೆಕಾಹೇತೆ ಯಾಕೋಬಥೀಸ್ ಪೈದಹುಯಿನ್ ಇನಿಜೋ಼ಡ್ಮ ಈಜಿಪ್ಟ್‌ದೇಖ್ಹ್‌ನ ಗಯೂತೆ ಪೂರ ಛೋ಼ ಉಪ್ಪರ್ ತೀನೀಖ್ಹ್‌ ಜ಼ಣು. <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />ಇವ್ಣೇಸ್‌ಕಾಹೇತೆ ಈಜಿಪ್ಟ್‌ದೇಖ್ಹ್‌ಮ ಯೋಸೇಫನ ಪೈದಹುಯಾತೆ ಬೇಜ಼ಣ. ಈಜಿಪ್ಟ್‌ದೇಖ್ಹ್‌ನ ಗಯೂತೆ ಯಾಕೋಬನು ಕುಟುಂಬ್‌ವಾಳು ಖ್ಹಾರು ಪೂರ ಖ್ಹಡ್‌ತೀನಿಖ್ಹ್‌ ಜ಼ಣು.<verse eid="GEN 46:27" /></para>
  <para style="s">ಈಜಿಪ್ಟ್‌ಮ ಯಾಕೋಬ ಅಜು಼ ಇನು ಕುಟುಂಬ್‌ವಾಳು</para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />ಯಾಕೋಬನೆ ಗೋಷೆನ್‌ ತಬರ್ಖಾನಿ ವಾಟ್‌ಪರ್ ಯೋಸೇಫ ಆಯಿನ್ ಇನ ಮಳ್‌ಣುಕರಿ ಖ್ಹಮ್‌ಜಾ಼ಡಾನಖ್ಹಾಜೆ ಯೆಹೂದನ ಇನಾಕನ ಅಗಾಡಿ ಮೋಕ್‌ಲ್ಯೊ. ಇವ್ಣೆ ಗೋಷೆನ್ ತಬರ್ಖಾನ ಆಯು. <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />ಯೋಸೇಫನೆ ಇನು ರಥ್‌ ಬಣೈನ್ ಇನೊ ಬಾ ಯಾಕೋಬನ ಮಳಾನ ಗೋಷೆನ್ನ ಆಯೊ. ಬಾನ ದೇಕ್‌ತಾಸ್ನ ಇನು ಗಳುಬಥೈನ್‌ ಘಣು ವಖ್ಹತ್ ಇನೆ ರೊಯೊ. <verse eid="GEN 46:29" /><verse number="30" style="v" sid="GEN 46:30" />ಯಾಕೋಬ್‌ನೆ ಯೋಸೇಫನ, “ಮೇ ತಾರು ಮ್ಹೋಡು ದೇಖಿನ್‌, ತೂ ಬಿಜೂ಼ಬಿ ಜಿವ್ತೊ ಛಾ಼ಕರಿ ಮಾಲುಮ್ ಕರಿಲಿದೊ. ಹಮ್ಕೆ ಮೇ ಹಕ್ಲಾಲ್‌ಥಿ ಮರೂಸ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 46:30" /><verse number="31" style="v" sid="GEN 46:31" />ಇನಾಪಾರ್ ಯೋಸೇಫನೆ ಇನ ಭೈಯೇನಾಬಿ ಬಾನ ಘರ್‌ವಾಳ ಖ್ಹಾರಸ್ನ ಬೋಲ್ಯೊಕಿ, “ಮೇ ಫರೋಹಕನ ಜೈ಼ನ್ ತುಮೆ ಆಯಾತೆ ವಾತ್‌ ಖ್ಹಮ್‌ಜಾ಼ಡುಸ್. ‘ಕಾನಾನ್ ದೇಖ್ಹ್‌ಮಥಾತೆ ಮಾರ ಭೈಯೇಬಿ ಬಾಬಿ, ಕುಟುಂಬ್‌ವಾಳುಬಿ ಮಾರಕನ ಆಯಿರ‍್ಹಾಸ್; <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />ಇವ್ಣೆ ಮೇಂಢಾನಿ ಕಾವಲ್ ಕರಾನು, ಢಾಂಡ ಚ಼ರಾವಾನು ಇವ್ಣು ಕಾಮ್. ಇವ್ಣೆ, ಇವ್ಣು ಢಾಂಡ ಮೇಂಢ, ಇವ್ಣಕನ ಥೂತೆ ಖ್ಹಾರೂಸ್ ಲೈರಾಖ್ಯೂಸ್” ಕರಿ ಬೋಲೂಸ್. <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />ಫರೋಹ ತುಮುನ ಬುಲೈನ್, “ತುಮಾರು ಕಾಮ್‌ಶಾತ್‌?” ಕರಿ ಬೋಲ್ಯೋತೊ, <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />“ಅಡ್ಡಾಣಿಥು ಧರೀನ್ ಹಮ್ಕೆಲಗೂಬಿ ತಾರ ಆಳ್‌ಹುಯಿರಾತೆ ಹಮೆ, ಹಮಾರ ಗುರುಗುರಬ್‌ಲ್ಯಾನಿ ಪದತ್ತಿನಿತರ ಢಾಂಡ ಚ಼ರಾವವಾಳ” ಕರಿ ಬೋಲೊ. ಜಾನ್ವಾರ್ ಪಾಳವಾಳು ಈಜಿಪ್ಟ್‌ವಾಳನ ಗಲೀಜ಼್ ದೆಖಾವಸ್ ಇನಖ್ಹಾಜೆ, ಗೋಷೆನ್ ತಬರ್ಖಾನ ತುಮುನ ರ‍್ಹಾವನ ದಿಶೆ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="s">ಫರೋಹಥಿ ಯಾಕೋಬ್‍ನ ಸ್ವಾಗತ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />ತದೆ ಯೋಸೇಫನೆ ಫರೋಹಕನ ಅಯಿನ್‌, “ಮಾರೊ ಬಾಬಿ, ಭೈಯೇಬಿ ಢಾಂಡ ಮೇಂಢ ಆಜು಼ ಖ್ಹಾರೀಸ್‍ ಶೊತ್‌ನಲೀನ್ ಕಾನಾನ್ ದೇಖ್ಹ್‌ಥು ಗೋಷೆನ್ ತಬರ್ಖಾನ ಆಯಿರ‍್ಹಾಸ್” ಕರಿ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ. <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />ಅತ್ರೇಸ್ ಕಾಹೆತೆ ಇನ ಭೈಯೇಮ ಪಾಚ಼್ ಜ಼ಣಾನ ಬುಲೈಲಿ ಆಯಿನ್ ಫರೋಹಕನ ಭೀರಾಖ್ಯೊ. <verse eid="GEN 47:2" /><verse number="3" style="v" sid="GEN 47:3" />ಫರೋಹನೆ, “ತುಮಾರು ಕಾಮ್‌ಶಾತ್‌?” ಕರಿ ಇವ್ಣುನ ಪುಛಾ಼ವಖ್ಹತರ್‌ ಇವ್ಣೆ, “ತಾರ ಆಳ್‌ ಹುಯಿರ‍್ಹಾತೆ ಹಮೆ ಹಮಾರ ಬಾಬ್‌ದಾದನಿ ಘೋಣಿ ಮೇಂಢ ಚ಼ರಾವವಾಳ” ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />ಕಾನಾನ್ ದೇಖ್ಹ್‌ಮ ಕಾಳ್‌ದುಕಾಳ್ ಜಾ಼ಖ್ಹತ್‌ಥೂತೆ ಇನಖ್ಹಾಜೆ ತಾರ ಆಳ್‌ನು ಮೇಂಢ ಢಾಂಡವ್ನ ಚಾ಼ರೊಮಳ್ಯೊಕೊಯ್ನಿ. ಇನಖ್ಹಾಜೆ ಆ ದೇಖ್ಹ್‌ಮ ಥೋಡ ದನ್‌ರ‍್ಹಿಯೇ ಕರಿ ಆಯಾ. ಹಮೆ ಗೋಷೆನ್ ತಬರ್‌ಖಾಮ ಜಿವ್ಣು ಕರಾನ ಹುಕುಮ್ ದೇ” ಕರಿಬೋಲ್ಯ. <verse eid="GEN 47:4" /><verse number="5" style="v" sid="GEN 47:5" />ತದೆ ಫರೋಹನೆ ಯೋಸೇಫನ, “ತಾರೊ ಬಾಬಿ, ಭೈಯೇಬಿ ತರಾಕನ ಅಯಿರ‍್ಹಾಸ್‌”. <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ ತಾರ ಖ್ಹಾಮ್ಣೆ ಛಾ಼; ಇನಾಮಥು ಅಛ್ಛು಼ ಭಾಗ್‌ಮ ತಾರೊ ಬಾಬಿ ಅಜು಼ ಭೈಯೇಬಿ ಜಿವ್ಣುಕರಾನಿತರ ಕರ್‌; ಗೋಷೆನ್ ತಬರ್‌ಖಾಮ ಹೋಣುತೊ ಜಿವ್ಣುಕರಾದೆ; ಇವ್ಣಾಮ ಕೋಣ್‌ತೋಬಿ ತಾಖತಿ ಉಶೇತೊ ಇವ್ಣುನ ಮಾರ ಢಾಂಡ ಮೇಂಢಾನ ಮಂಧಾನ ದೇಖಿಲ್ಯಾವನ ಮ್ಹೇಲ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 47:6" /><verse number="7" style="v" sid="GEN 47:7" />ತದೆ ಯೋಸೇಫ ಇನೊ ಬಾ ಯಾಕೋಬನ ಬುಲೈಲೈನ್‌ ಫರೋಹಕನ ಖ್ಹಾಮ್ಣೆ ಭೀರಾಕ್‌ತನ, ಯಾಕೋಬನೆ ಫರೋಹನ ಆಶೀರ್ವಾದ್ ಕರ‍್ಯೊ. <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />ಇನ ಫರೋಹನೆ, “ತುನ ಹಮ್ಕೆ ಕೆತ್ರಾ ವರಖ್ಹ್?” ಕರಿ ಪುಛಾ಼ಯೊ. <verse eid="GEN 47:8" /><verse number="9" style="v" sid="GEN 47:9" />ಯಾಕೋಬನೆ ಫರೋಹನ, “ಮಾರು ಲೋಕನು ಗಖ್ಹತ್‌ ಮಾರ‍್ಯೊತೆ ಹಗಾಮ್ ಎಖ್ಹೊ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್. ಮೇ ಜಿವ್ಯೋತೆ ಹಗಾಮ್ ಥೋಡಾಬಿ ಆಜು಼ ವದೇಖ್ಹ್‌ ಕುಢಾಪಮಥು; ಕತೋಬಿ ಮಾರ ಗುರುಗುರಬ್‌ಲ್ಯ ಜಿವ್ಯಾತೆ ಖ್ಹಾರ ವರಖ್ಹ್ ಮನ ಕೊಹುಯನಿ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />ಪಾಛೊ಼ ಇನೆ ಫರೋಹನ ಆಶೀರ್ವಾದ್‌ ಕರೀನ್ ಇನ ಖ್ಹಾಮ್ಣೆಥೊ ಚ಼ಲೇಗಯೊ. <verse eid="GEN 47:10" /><verse number="11" style="v" sid="GEN 47:11" />ಫರೋಹನಿ ಹುಕುಮ್‌ನಿ ಪರಕ್ ಯೋಸೇಫನೆ ಇನ ಬಾನಬಿ ಭೈಯೇನಾಬಿ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಜಿವ್ಣುಕರಾನ ಘಣು ಅಛ್ಛು಼ಥೂತೆ ರಾಮ್ಸೇಸ್‌ ತಬರ್‌ಖಾಮ ಶೊತ್‌ನ ದಿದೊ. <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />ಯೋಸೇಫನೆ ಬಾನಾಬಿ ಭೈಯೇನಾಬಿ ಬಾನ ಘರ್ವಾಳ ಖ್ಹಾರಾಸ್ನ ಇವ್ಣ ಇವ್ಣ ಕುಟುಂಬ್‌ಮ ಮಳ್ಯಾಹುಯಾನಿ ಗಣ್ತಿನಿ ಪರಕ್ ಖಾಣುದೀನ್ ಇವ್ಣುನ ಪಾಳ್ಯೊ.<verse eid="GEN 47:12" /></para>
  <para style="s">ಘಣು ಮೊಟು ಕಾಳ್‌ದುಕಾಳ್</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />ಕಾಳ್‌ದುಕಾಳ್ ಘಣು ಥೂತೆ ಇನಖ್ಹಾಜೆ ದೇಖ್ಹ್‌ನ ಖೆವ ಭಾಗ್‌ಮಾಬಿ ಖಾಣು ಮಳ್‌ತೂಥುಕೊಯ್ನಿ. ಯೊ ಕಾಳ್‌ದುಕಾಳ್ನ ಖ್ಹಾಜೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ ಅಜು಼ ಕಾನಾನ್‌ದೇಖ್ಹ್ ಇಮ್ಮಸ್ ನಾಶ್‌ ಹುಯಿಗಯುಥು. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />ಯೋಸೇಫನೆ ಈಜಿಪ್ಟ್ ಅಜು಼ ಕಾನಾನ್ ದೇಖ್ಹ್‌ಮಾಬಿ ಅನಾಜ಼್ ವೇಚಿನ್ ಆಯೂತೆ ಪೈಶಾಥಿ ಫರೋಹನಿ ಕಣ್ಗಿಭರ‍್ಯೊ. <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />ಈಜಿಪ್ಟ್‌ನು ಅಜು಼ ಕಾನಾನ್ನು ಪೈಶಖ್ಹಾರು ಖತಮ್ ಹುಯಿಜಾ಼ವಾದೀನ್ ಈಜಿಪ್ಟ್‌ವಾಳು ಯೋಸೇಫಕನ ಆಯಿನ್‌, “ಹಮಾರ ಪೈಶಾ ಖತಮ್‌ಹುಯ್ಗು; ತೂ ಹಮುನ ಖಾಣು ದೆವ್ಣು; ಹಮೆ ತಾರ ಡೋಳಾನ ಖ್ಹಾಮ್ಣೆ ಮರ‍್ಯಾತೊ ಶನು ಫಾಯಿದೊ?” ಕರಿ ಬೋಲ್ಯು. <verse eid="GEN 47:15" /><verse number="16" style="v" sid="GEN 47:16" />ಇನ ಯೋಸೇಫನೆ, “ತುಮಾರು ಢಾಂಡುಮೇಂಢು ಲೀನ್‌ಆವೊ ಪೈಶ ನಾರ‍್ಹಿಯುತೊ ಗಧೇಡು, ಬೋಕ್ಡು ಲೀನ್ ಆವೊ, ಅನಾಜ಼್ ತುಮುನ ದೆವುಸ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />ಇವ್ಣೆ ಯೋಖ್ಹಾರು ಯೋಸೇಫಕನ ಲೀನ್‌ ಆವಾಖ್ಹತರ್, ಇನೆ ಇವ್ಣು ಘೋಡವ್‌ನಾಬಿ, ಢಾಂಡು ಮೇಂಢುಬಿ, ಗಧೇಡವ್‌ನಾಬಿ ಲೀಲಿನ್‌ ಇವ್ಣುನ ಅನಾಜ಼್ ದಿದೊ. ಯೊ ವರಖ್ಹ್ ಇವ್ಣು ಢಾಂಡು ಮೇಂಢುಖ್ಹಾರುಬಿ ಲೀಲಿನ್‌ ಅನಾಜ಼್ ದೀನ್ ಇವ್ಣುನ ಬಚಾ಼ಡ್ಯೊ. <verse eid="GEN 47:17" /><verse number="18" style="v" sid="GEN 47:18" />ಯೊ ವರಖ್ಹ್ ನಿಕ್ಳಿನ್ ಇನವಾರ್‌ಲ್ಯ ವರಖ್ಹ್‌ಮ ಇವ್ಣೆ ಇನಾಕನ ಆಯಿನ್, “ಹಮಾರ ಪೈಶಾ ಖತಮ್‌ಹುಯಿಗು; ಹಮಾರ ಢಾಂಡಮೇಂಢ ಖ್ಹಾರು ಯಜಮಾನ್ನ ಕಬ್‌ಜಾ಼ಮ ಹುಯಿಗು; ಅಮ್‌ರ‍್ಹಾವಪರ್ ಹಮಾರಿ ಜ಼ಮೀನ್‌ಬಿ , ಹಮಾರು ಶರೀರ್ ಮ್ಹೇಲಿನ್ ಬಿಜು಼ ಶಾತ್ಬಿ ಕೋ ಬಚಿರ‍್ಹೂನಿ ಕರಿ ಹಮಾರ ಯಜಮಾನ್ನ ಲಪಾಡಿಯೇಕೊಂತೆ ಖ್ಹಮ್‌ಜಾ಼ಡೆಸ್” ಕರಿ ಬೋಲ್ಯು. <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />ಹಮೆ ಶನ ತುಮಾರ ಡೋಳಾನ ಖ್ಹಾಮ್ಣೆ ಮರ‍್ನು; ಹಮಾರಿ ಜ಼ಮೀನ್ ಶನ ಪಾಳ್‌ಪಡ್ನು ; ಹಮುನಾಬಿ ಹಮಾರಿ ಜ಼ಮೀನ್ನಾಬಿ ಲೀಲಿನ್‌ ಅನಾಜ಼್ ದೆ; ಹಮೆ ಹಮಾರಿ ಜ಼ಮೀನ್ನ ಫರೋಹನ ದಿನಾಖಿದೀನ್ ಇನ ಗುಲಾಮ್ ಹುಯಿಜ಼ಯ್ಯೆಸ್. ಹಮೆ ಮರ‍್ನುನಾತೆ ಬಚ್ಣು಼ಕತೊ ಅಜು಼ ಜ಼ಮೀನ್ ಪಾಳ್‌ನಾಪಡ್ನುತೆ ತೂ ಹಮೂನ ಬಿತ್‌ನ ಪಂಡಾ ದೇವ್ಣು” ಕರಿ ಬೋಲ್ಯು. <verse eid="GEN 47:19" /><verse number="20" style="v" sid="GEN 47:20" />ಅಮ್ ಯೋಸೇಫನೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನು ಖ್ಹಾರಿಸ್ ಜ಼ಮೀನ್ ಫರೋಹನ್ನ ಮಳಿಗು. ಅಜು಼ ಹರೇಕ್ ಈಜಿಪ್ಟ್‌ವಾಳು ಇವ್ಣು ಗದ್ದೆ ಜ಼ಮೀನ್‌ಖ್ಹಾರು ವೇಚಿನಾಖ್ಯು. ಕಾಳ್‌ದುಕಾಳ್ ಈಜಿಪ್ಟ್‌ಮ ಘಣುಥೂತೆ ಇನಖ್ಹಾಜೆ ಇವ್ಣಖ್ಹಾರಾನಿ ಜ಼ಮೀನ್‌ಪರ್‌ ಫರೋಹನು ಕಬ್‌ಜ಼ಹುಯ್ಗು. <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />ಯೋಸೇಫನೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನು ಎಕ್ ಕೋಣ್ಹಿಥು ಧರೀನ್ ಬಿಜೇಕ್ ಕೋಣ್ಹಿಲಗೂಬಿ ಥೂತೆ ಅದ್ಮೆವ್‌ನ ಗುಲಾಮ್ ಬಣಾಯೊ. <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />ಯಾಜಕವ್‌ನಿ ಜ಼ಮೀನ್ ಖಲಿ ಇನೆ ಮೋಲ್‌ಕೋಲಿದೋನಿ. ಶನಕತೊ ಇವ್ಣುನ ಫರೋಹಥಿ ಪಿಂಚ್‌ನಿ ಮಳ್‌ತುಥು. ಯೊ ಪಿಂಚ್‌ನಿಥಿ ಜಿವ್ಣು ಕರುಕರ್ಥೂತೆ ಯೊ ಯಾಜಕಾವ್‌ನೆ ಇವ್ಣಿ ಜ಼ಮೀನ್ನ ವೇಚ್ಯುಕೊಯ್ನಿ. <verse eid="GEN 47:22" /><verse number="23" style="v" sid="GEN 47:23" />ಯೋಸೇಫನೆ ಅದ್ಮೆವ್‌ನ, “ಮೇ ಆಜ಼್‌ನೊ ದನ್ ತುಮುನಾಬಿ ತುಮಾರಿ ಜ಼ಮೀನ್ನಾಬಿ ಫರೋಹನಖ್ಹಾಜೆ ಮೋಲ್‌ಲೀಲಿದೊ ಕರಿ ಮಾಲುಮ್‌ಕರಿಲೆವೊ, ಹಂದೇಕ್‌, ಬಿತ್‌ನಖ್ಹಾಜೆ ತುಮುನ ಪಂಡಾ ದೀರಾಖ್ಯೋಸ್‌; ಜ಼ಮೀನ್‌ಮ ಬಿತ್‌ಕರೊ. <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />ವ್ಹಡಾವ್‌ಣಿನ ದನ್‌ಮ ಪಾಚ಼್‌ಮಾನು ಎಕ್ ಭಾಗ್‌ ಫರೋಹನ ಜಾ಼ವ್ಣು. ಉಭ್‌ರ‍್ಯುಹುಯು ಚಾರ್‌ಭಾಗ್ ತುಮಾರು. ಇನ ಬಿತ್‌ನೆನಾಬಿ ಅಜು಼ ತುಮಾರ ಘರ್‌ವಾಳಾನ ಖ್ಹಾಜೇಬಿ, ಕುಟುಂಬ್‌ವಾಳನ ಜಿವ್ಣಾನಖ್ಹಾಜೆ ರಾಖಿಲೆವೊ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 47:24" /><verse number="25" style="v" sid="GEN 47:25" />ಇನಖ್ಹಾಜೆ ಇವ್ಣೆ, ಹಮಾರ ಜಾನ್ನ ಬಚಾ಼ಡ್ಯೊ. ಹಮಾರೊ ಮಾಲಿಕ್ ಹುಯಿರೋತೆ ತುಮಾರಿ ಗೋರ್‌ ಹಮಾರಪರ್‌ ರ‍್ಹವಾದೆ; ಹಮೆ ಫರೋಹನಖ್ಹಾಜೆ ಗುಲಾಮ್ ಹುಯಿರ‍್ಹಿಯೇಸ್” ಕರಿಬೋಲ್ಯು. <verse eid="GEN 47:25" /><verse number="26" style="v" sid="GEN 47:26" />ಪಿಕಾವ್ಣಿಮ ಪಾಚ಼್‌ಮಾನು ಎಕ್ ಭಾಗ್‌ ಫರೋಹನ ಜಾ಼ವ್ಣುಕರಿ ಬೋಲಾನು ಯೋಸೇಫನೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನು ಎಕ್ ನಿಯಮ್ ಬಣಾಯೊ. ಹಮ್ಕೆಲಗೂಬಿ ಯೊ ಇಮ್ಮಸ್ ಛಾ಼. ಯಾಜಕವ್ನಿ ಜ಼ಮೀನ್ ಖಲಿ ಫರೋಹನ ಕಬ್‌ಜಾ಼ಮ ಹುಯುಕೊಯ್ನಿ.<verse eid="GEN 47:26" /></para>
  <para style="s">ಯಾಕೋಬನಿ ಖ್ಹರ್ತಿನಿ ಬಿಂತಿ</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಮಳ್ಯುಹುಯು ಗೋಷೆನ್ ತಬರ್‌ಖಾಮ ಜಿವ್ಣುಕರ‍್ಯು. ಹಿಜ್ಜಾ಼ ಇವ್ಣೆ ಶೊತ್ ಅಖ್ಖು ಕಮೈಲೀನ್ ಘಣು ಪಿಳ್ಗಿವಾಳುಹುಯಿನ್ ಭಡ್ಯು. <verse eid="GEN 47:27" /><verse number="28" style="v" sid="GEN 47:28" />ಯಕೋಬ್ ಈಜಿಪ್ಟ್‌ಮ ಖ್ಹತ್ರಾ ವರಖ್ಹ್ ರ‍್ಹಯೊ. ಯೊ ಜಿವಿರ‍್ಹೋತೆ ಪೂರ ಹಗಾಮ್ ಎಖ್ಹೊ ಖ್ಹಾತ್‌ಉಪ್ಪರ್ ಚಾ಼ಳಿಖ್ಹ್ ವರಖ್ಹ್‌. <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />ಯಾಕೋಬನ ಮರಾನ ಹಗಾಮ್ ಖನ್ನೆ ಆವಾದಿನ್ ಇನೆ ಇನೊ ಛಿಯ್ಯೊ ಯೋಸೇಫನ ಬುಲೈಮಂಗೈನ್‌, ತಾರೊ ಹಾತ್ನ ಮಾರಿ ಮಾಂಡಿ ಹೇಟ್‌ ಘಾಲ್, “ಮಾರಪರ್ ತುನ ಪ್ಯಾರ್‌ ಉಶೇತೊ ತೂ ಮಾರಿ ವಾತ್ನ ಫ್ಯಾರ್‌ಥಿಬಿ, ನಿಯಥ್ಥಿ ಚ಼ಲೈದೇವ್ಣು. ಯೊ ಶಾತ್‌ಕತೊ; ಮನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಮಖ್ಹಾಣ್ಯು ನಕೊಕರೀಶ್. <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />ಮೇ ಮರೀನ್ ಮಾರ ಗುರುಗುರಬ್‌ಲ್ಯಾಕನ ಮಳಿಜಾ಼ವದೀನ್, ಮಾರ ಮುರ್ದಾನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಲೀ ಜೈ಼ನ್ ಯೊ ಗುರುಗುರಬ್‌ಲ್ಯಾನು ಮಖ್ಹಾಣ್‌ಗಂಜ಼್‌ನಿ ಜ಼ಮೀನ್‌ಮಾಸ್‌ ಮಖ್ಹಾಣ್ಯುಕರ‍್ನು. ಇಮ್‌ಕರೂಸ್‌ಕರಿ ತೂ ಮಾರಿ ಮಾಂಡಿಹೇಟ್ ಹಾತ್ ಘಾಲಿನ್ ಆಣ್‌ಕರ‍್ನು” ಕರಿ ಬೋಲಿಲಿದೊ. ಇನೆ, “ತೂ ಬೋಲ್ಯೋತೆ ತಿಮ್ಮಸ್ ಕರುಸ್” ಕರಿ ಆಣ್ ಕರ‍್ಯೊ. <verse eid="GEN 47:30" /><verse number="31" style="v" sid="GEN 47:31" />ತದೆ ಯಾಕೋಬನೆ ಬಿಛಾ಼ವ್ಣನು ಶಿರಾಣನಿ ಬಾಜು಼ ಝು಼ಕಿನ್ ದೇವ್ನ ಖ್ಹಲಾಮ್ ಕರ‍್ಯೊ.<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">ಎಫ್ರಾಯಿಮ್ ಅಜು಼ ಮನಸ್ಸೆನ ಯಾಕೋಬನಿ ಆಶೀರ್ವಾದ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />ಥೋಡ ದನ್ ಜಾ಼ವಾದೀನ್, “ಬಾನ ಘಣು ಜಾನ್ನ ಅರಾಮ್‌ಕೊಯ್ನಿ” ಕರಿ ವಾತ್ ಯೋಸೇಫನ ಖ್ಹಮಜ಼್‌ಪಡ್ಯು. ತದೆ ಯೋಸೇಫನೆ ಮನಸ್ಸೆ ಎಫ್ರಾಯೀಮ್‌ಕರಿ ಇನ ಬೇ ಛಿಯ್ಯವ್‌ನ ಇನಜೋ಼ಡ್ಮ ಬುಲೈಲೀನ್ ಬಾಕನ ಆಯೊ. <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />“ತಾರೊಛಿಯ್ಯೊ ಯೋಸೇಫ ತಾರಾಕನ ಆಯಿರ‍್ಹೋಸ್” ಕರಿ ಯಾಕೋಬನ ಬೋಲಖ್ಹತರ್, ಯಾಕೋಬನೆ ಖ್ಹವಾರೀನ್‌ ಬಿಛಾ಼ವ್ಣಪರ್ ಉಠಿ ಬೇಶಿಗಯೊ. <verse eid="GEN 48:2" /><verse number="3" style="v" sid="GEN 48:3" />ಇನೆ ಯೋಸೇಫನ, “ಸರ್ವಶಕ್ತ ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವ ದೇವ್ ಕಾನಾನ್ ದೇಖ್ಹ್‌ನು ಲೂಜ಼್‌ಕರಿ ಖ್ಹಯೇರ್‌ಮ ಮನ ದರ್ಶನದೀನ್ ಆಶೀರ್ವಾದ್‌ಕರೀನ್, <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />ಇನೆ ಮನ, ‘ತುನ ಭಡೈನ್ ತಾರಿ ಪಿಳ್ಗಿನ ಜಾ಼ಖ್ಹತ್ ಕರುಸ್. ಕೈಏಕ್ ಜ಼ಗ್‌ಜಾ಼ತ್ ತಾರೇಥಿ ಹುವಾನಿತರ ಕರುಸ್. ತಾರೇಥಿ ವಾರ್ ತಾರಿ ಪಿಳ್ಗಿನ ಆ ದೇಖ್ಹ್‌ನ ಹಮೇಶಾನಿ ಶೊತ್‌ ಬಣೈದೆವುಸ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 48:4" /><verse number="5" style="v" sid="GEN 48:5" />ಮೇ ತಾರಾಕನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಆವಾನ ಅಗಾಡಿ ಹಜ಼್ಜ ಪೈದಹುಯಾತೆ ತಾರ ಬೇ ಛಿಯ್ಯಾ ಮಾರ ಲಡ್ಕಾಸ್. ರೂಬೇನ್ ಸಿಮೆಯೋನ್‌ ಮಾರ ಲಡ್ಕ ಹುಯಿರಾತೆ ತಿಮ್ಮಸ್ ಎಫ್ರಾಯಿಮ್ ಮನಸ್ಸೆಬಿ ಮಾರಛಿಯ್ಯ ಹುಯಿರ‍್ಹಾವದೆ. <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />ಇವ್ಣ ವಾರ್ ತೂ ಜ಼ಣ್ಯೋತೆ ಲಡ್ಕ ತಾರ ಹುಯಿರ‍್ಹಾವದೆ. ಇವ್ಣೆ ಇವ್ಣ ಶೊಂತ್ ಭೈಯೇನು ಸೊತ್‌ಮ ಹಕ್‌ ಲೀಲಿನ್‌, ಇವ್ಣ ಖೂಮ್‌ನೂಸ್ ನಾಮ್ ಮ್ಹೇಲಿಲ್ಯಾವದೆ. <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />ಶನಕತೊ ತುಮಾರಿ ಆಯಾ ರಾಹೇಲನೆ, ಮೇ ಪದ್ದನ್‌ಥು ಆವಾನಿ ವಖ್ಹತ್, ಕಾನಾನ್ ದೇಖ್ಹ್‌ಮ ಎಫ್ರಾತ್‌ನ ಜಾ಼ವಾನ ಬಿಜು಼ಥೋಡಿ ದೂರ್‌ರ‍್ಹಾವಾನಿ ವಖ್ಹ್‌ತೆ ರಾಹೇಲ ವಾಟ್‌ಪರಸ್ ಮರಿಗೈ. ಯೊ ಬೇತ್ಲೆಹೇಮ್‌ ಕರಿ ಬೋಲಾಯು. ಎಫ್ರಾತ್‌ನ ಜಾ಼ವಾನ ಮಾರಗ್‌ಪರ್ ಇನ ಮಖ್ಹಾಣ್ಯುಕರ‍್ಯೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 48:7" /><verse number="8" style="v" sid="GEN 48:8" />ಯಾಕೋಬನೆ ಯೋಸೇಫನ ಲಡ್ಕಾವ್ನ ದೇಖಿನ್‌, “ಅವ್ಣೆ ಕೋಣ್?” ಕರಿ ಪುಛಾ಼ಯೊ. <verse eid="GEN 48:8" /><verse number="9" style="v" sid="GEN 48:9" />ಇನ ಯೋಸೇಫನೆ, “ಆ ದೇಖ್ಹ್‌ಮ ಮನ ದೇವ್ನೆ ದಿದೋತೆ ಲಡ್ಕ” ಕರಿಬೋಲ್ಯೊ. ತದೆ ಬಾ ಯಾಕೋಬನೆ, “ಅವ್ಣುನ ಮೇ ಆಶೀರ್ವಾದ್‌ ಕರುಸ್; ಮಾರಕನ ಬುಲೈಲೀನ್ ಆವ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 48:9" /><verse number="10" style="v" sid="GEN 48:10" />ಬುಢೊಹುಯಿಗೊತೆ ಇನಖ್ಹಾಜೆ ಯಾಕೋಬನ ಡೋಳ ಭುಂಬ್‌ಳಹುಯ್ಗಾಥ. ಯೋಸೇಫನೆ ಯೊ ಲಡ್ಕಾವ್ನ ಖನ್ನೆ ಲ್ಯಾವಾದಿನ್ ಇವ್ಣುನ ಬಥೈನ್ ಬುಚ್ಚಕರ‍್ಯೊ. <verse eid="GEN 48:10" /><verse number="11" style="v" sid="GEN 48:11" />ಇನಾಪಾರ್ ಇನೆ ಯೋಸೇಫನ, “ತಾರ ಮ್ಹೋಡಾನ ಪಾಛೊ಼ ದೇಖಿಶ್‌ಕರಿ ಮೇ ಹರಖ್ಹ್‌ ಕರಿರಾಖ್ಯೋಥೊಕೊಯ್ನಿ. ಹಮ್ಕೆ ತುನ ಕಾಹೆತೆ ತಾರ ಲಡ್ಕಾವ್‍ನಾಬಿ ದೇಖಾನಿಘೋಣಿ ದೇವ್‌ನೆ ಗೋರ್‌ ಕರ‍್ಯೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 48:11" /><verse number="12" style="v" sid="GEN 48:12" />ತದೆ ಯೋಸೇಫನೆ ಬಾನಿ ಮಾಂಡಿಪರ್‌ಥೊ ಇನ ಲಡ್ಕಾವ್ನ ಪಾಡಿಲೀನ್ ಬಾನ ಜ಼ಮೀನ್‌ಲಗು ಝು಼ಕಿನ್ ಖ್ಹಲಾಮ್ ಕರ‍್ಯೊ. <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />ಇನಾಪಾರ್ ಯೋಸೇಫನೆ ಇನಿ ಖಾವಿಬಾಜೂ಼ಮ ಯಾಕೋಬನ ಡಾವ ಹಾತ್ನ ಖ್ಹಾಮ್ಣೆ ಎಫ್ರಾಯೀಮನಾಬಿ, ಇನಿ ಡಾವಿಬಾಜೂ಼ಮ ಯಾಕೋಬನ ಖಾವಹಾತ್‌ನ ಖ್ಹಾಮ್ಣೆ ಮನಸ್ಸೆನಾಬಿ, ಇವ್ಣ ಭೇಜ಼ಣಾನ ಇನ ಬಾಕನ ಭೀರಾಖ್ಯೊ. <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />ಮನಸ್ಸೆ ಪೈಲ್ಹೋಟೊ ಛಿಯ್ಯೊ ರ‍್ಹಯೊತೋಬಿ , ಯಾಕೋಬನೆ ಇನೊ ಹಾತ್‌ ಆಡೊಪಾಡಿನ್ ನ್ಹಾನೊಹುಯಿರೋತೆ ಎಫ್ರಾಯೀಮ್‌ನ ಮುಡ್‌ಕ್ಯಾಪರ್ ಖಾವೋ ಹಾತ್, ಮನಸ್ಸೆನ ಮುಡ್‌ಕ್ಯಾಪರ್ ಡಾವೊ ಹಾತ್ನ ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 48:14" /><verse number="15" style="v" sid="GEN 48:15" />ಯೋಸೇಫನ ಅಮ್ ಬೋಲಿನ್ ಆಶೀರ್ವಾದ್‌ ಕರ‍್ಯೊ. “ಮಾರ ಗುರುಗುರಬ್‌ಲ್ಯ ಅಬ್ರಹಾಮ್, ಇಸಾಕ್ ಖೆವ ದೇವ್ನ ಪೂಜ಼ಕರ‍್ಯಾಕಿ ಯೋಸ್‌ ದೇವ್, ಅಡ್ಡಾಣಿಥು ಧರೀನ್‌ ಹಮ್ಕೆಲಗೂಬಿ ಮನ ಪಾಳ್‌ತೊ ಆಯೊ, <verse eid="GEN 48:15" /><verse number="16" style="v" sid="GEN 48:16" />ಹರೇಕ್ ಅವ್‌ಘಡ್‌ಥು ಮನ ಬಚಾ಼ಡ್‌ತೊಹುಯಿನ್ ಆಯೋತೆ ಯೊ ದೂತ, ಆ ಛೋ಼ಕ್ರಾವ್ನ ಆಶೀರ್ವಾದ್‌ ಕರಾದೆ. ಇವ್ಣೇಥಿ ಮಾರು ನಾಮ್‌ಬಿ, ಮಾರ ಗುರುಗುರಬ್‌ಲ್ಯ ಹುಯಿರ‍್ಹಾತೆ ಅಬ್ರಹಾಮ್, ಇಸಾಕನು ನಾಮ್‌ಬೀ ಘಟ್‌ಭೀರ‍್ಹಾವಾದೆ; ಅವ್ಣೆ ಜ಼ಮೀನ್‌ಪರ್ ಜಾ಼ಖ್ಹತ್‌ಹುಯಿನ್ ಘಣು ಪಿಳ್ಗಿವಾಳ ಹುವಾದೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="GEN 48:16" /><verse number="17" style="v" sid="GEN 48:17" />ಇನೊ ಬಾ ಖಾವೊ ಹಾತ್ನ ಎಫ್ರಾಯೀಮ್‌ನ ಮುಡ್‌ಕ್ಯಪರ್ ಮ್ಹೇಲಾನು ಯೋಸೇಫನ ಪಸಂದ್ ಕೋಲಾಗ್ಯೂನಿ. ಇನಖ್ಹಾಜೆ ಇನ ಬಾನ ಹಾತ್ನ ಎಫ್ರಾಯೀಮ್‌ನ ಮುಡ್‌ಕ್ಯಾಪರ್‌ಥು ಪಾಡಿನ್ ಮನಸ್ಸೆನ ಮುಡ್‌ಕ್ಯಪರ್ ಮ್ಹೇಲ್ಯೊ. <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />ಇನೆ ಬಾನ, “ಬಾ, ಆಸ್ ಪೈಲ್ಹೋಟೊ ಛಿಯ್ಯೊ; ಅನ ಮುಡ್‌ಕ್ಯಪರ್ ಹಾತ್ ಮ್ಹೇಲ್ನು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 48:18" /><verse number="19" style="v" sid="GEN 48:19" />ಕತೋಬಿ ಬಾನೆ ಮಾನ್ಯೊಕೊಂತೆ, “ಛಿಯ್ಯಾ ಮನ ಮಾಲುಮ್‌ಲ, ಮನ ಮಾಲುಮ್; ಅನೇಥಿಬಿ ಎಕ್ ಮುಲಕ್ ಉಬಜ಼್‌ಶೆ ; ಆಬಿ ತಾಖತ್‌ವಾಳೊ ಬಣ್‌ಶೆ. ಅನಿ ಪಿಳ್ಗಿಮಾಸ್ ಘಣು ಅದ್ಮಿಖ್ಹಾರು ಪೈದಾಉಶೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 48:19" /><verse number="20" style="v" sid="GEN 48:20" />ಯೊ ದನ್ನೆ ಇವ್ಣುನ ಇನೆ ಆಶೀರ್ವಾದ್‌ಕರೀನ್, “ತುಮಾರ ನಾಮೇಥಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಆಶೀರ್ವಾದ್ ಲೀಲಿಶೆ. ಎಫ್ರಾಯಿಮ್ ಅಜು಼ ಮನಸ್ಸೆನಿತರ ದೇವ್ ತುಮುನಾಬಿ ಆಶೀರ್ವಾದ್‌ಕರಾದೆ” ಕರಿ ಬೋಲಿನ್ ಅಮ್‌ ಎಫ್ರಾಯೀಮ್‌ನ ಮನಸ್ಸೆನ ಖ್ಹಾಮ್ಣೆ ಭೀರಾಖ್ಯೊ. <verse eid="GEN 48:20" /><verse number="21" style="v" sid="GEN 48:21" />ತದೆ ಯಾಕೋಬನೆ ಯೋಸೇಫನ, “ಮನ ಮರಣ್ ಖನ್ನೆ ಆವ್‌ತಿರ‍್ಹಿ ; ಕತೋಬಿ ದೇವ್ ತುಮಾರಿ ಜೋ಼ಡ್ಮರ‍್ಹೀನ್‌, ತುಮುನ ಗುರುಗುರಬ್‌ಲ್ಯನ ದೇಖ್ಹ್‌ನ ಪಾಛ಼ ಆವಖ್ಹರ್ಕು ಕರ್‌ಶೆ. <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />ಆ ನಾಹುಯಿನ್‌ ತಲ್ವಾರ್‌, ಧೂಣ್‌ಥಿ ಮೇ ಅಮೋರಿಯವಾಳಾನ ಹಾತ್‌ಮಾಥು ಛೋ಼ಡಾಯೋತೆ ಪಹಾಡ್‌ನೊ ತಬರ್‌ಖಾನ , ತಾರ ಭೈಯೇನ ದಿದೋತೆ ಭಾಗ್‌ಥೀಬಿ ಘಣು ತುನ ದೀರಾಖ್ಯೋಸ್” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">ಯಾಕೋಬನಿ ಖ್ಹರ್ತಿನಿ ವಾತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />ಯಾಕೋಬನೆ ಇನ ಛಿಯ್ಯವ್‌ನ ಬುಲೈಮಂಗೈನ್‌ ಇವ್ಣುನ, ತುಮೆ ಖ್ಹಾರು ಮಳಿನ್ ಆವೊ, ಖ್ಹಾಮೇನ ದನ್ಮ ತುಮುನ ಉಶೇತೆ ಯೊ ಖ್ಹಾರು ಖ್ಹಮ್‌ಜಾ಼ಡುಸ್‌. <verse eid="GEN 49:1" /><verse number="2" style="v" sid="GEN 49:2" />ಯಾಕೋಬನ ಲಡ್ಕಾವೊ, ತುಮೆಖ್ಹಾರು ಮಳಿ ಆಯಿನ್ ಖ್ಹಮ್‌ಜೊ಼, ತುಮಾರೊ ಬಾ ಇಸ್ರಾಯೇಲನಿ ವಾತೇನ ಖ್ಹಮ್‌ಜೊ಼. <verse eid="GEN 49:2" /><verse number="3" style="v" sid="GEN 49:3" />ರೂಬೇನಾಸ್ ಮಾರೊ ಪೈಲ್ಹೋಟೊ ಛಿಯ್ಯೊಬಿ, ಮಾರಿ ತಾಖತ್‌ಬಿ, ಮಾರಿ ಅಛ್ಛಿಮರ್ಯಾದಿಮಾಬಿ, ಅಧಿಕಾರ್‌ಮಾಬಿ ತೂ ಪೈಲ್ಹೋಸ್‌ ಬಾಗ್‌ ಹುಯಿರೋಸ್‌. <verse eid="GEN 49:3" /><verse number="4" style="v" sid="GEN 49:4" />ಕತೋಬಿ ಕನಾರಿಪರ್‌ಥು ಉಛಾ಼ಳ್ ಮಾರುಕರಾತೆ ತೋಫಾನ್ನಿತರ ಛಾ಼ತೆ ತೂ, ಬಿಜೂ಼ ಅಶ್‌ಲಿ ಬಣೀಶ್‌ಕೊಯ್ನಿ. ಶನಕತೊ ತೂ ತಾರ ಬಾನು ಬಿಛಾ಼ವ್ಣಪರ್ ಖ್ಹುಯಿನ್, ಯೊ ಮೈಲು ಕರಿನಾಖಿದಿದೋನಿ, ಆ ಹೈರೋತೆ ಮಾರಿ ಬಿಛಾ಼ವ್ಣನ ಚ಼ಢ್ಯೊ. <verse eid="GEN 49:4" /><verse number="5" style="v" sid="GEN 49:5" />ಸಿಮೆಯೋನ್‌ಬಿ ಲೇವಿಬಿ ಭೈಯೇ. ಅವ್ಣಿ ತಲ್ವಾರೇ ಖ್ಹತಾವನು ಕಫ್ಫನ್. <verse eid="GEN 49:5" /><verse number="6" style="v" sid="GEN 49:6" />ಮಾರೊ ಜಾನ್‌ ತೂ ನಕೊ ಮಳಿಜೈ಼ಶ್, ಇವ್ಣಿ ಗಪ್‌ಲತ್ನಿ ಖರಾಬ್ ಖ್ಹಯಾಲ್ಮ. ಮಾರೊ ದಿಲ್‌ ತೂ ಇವ್ಣ ಝೂ಼ಂಡ್‌ಮ ನಕೊ ಮಳೀಶ್. ಇನಖ್ಹಾಜೆ ಮಾರೊ ದಿಲ್‌ ಖ್ಹುಶಿಹುವಾಸ್. ಇವ್ಣೆ ಇರಾದೇಥಿ ಅದ್ಮೇವ್‌ನ ಕತ್ರಿನಾಖ್ಯು. ಹಂಕಾರ್‌ಥಿ ಢಾಂಡವ್ನ ಕಮ್‌ಜೋ಼ರಿ ಕರಿನಾಖ್ಯು. <verse eid="GEN 49:6" /><verse number="7" style="v" sid="GEN 49:7" />ಇವ್ಣೊ ಇರಾದೊ ಭಯಂಕರ್‌ಬಿ, ಇವ್ಣಿ ಚ಼ಂಢಾಳ್ ಕಠೋರ್‌ಬಿ ರ‍್ಹೀನ್ ಯೊ ಶಾಪಲೀರಾಖವಾಳು ಹುಯಿರುಸ್. ಯಾಕೋಬನಿ ಖೂಮ್ಮವಾಳಮ ಇವ್ಣುನ ಅಲಕ್ ಬಣಾವುಸ್‌. ಇಸ್ರಾಯೇಲ್‌ವಾಳಮಾಬಿ ಇವ್ಣುನ ಎಕ್ಕೋಸ್‌ಏಕ್ ಕರುಸ್. <verse eid="GEN 49:7" /><verse number="8" style="v" sid="GEN 49:8" />ಯೆಹೂದ, ತಾರ ಭೈಯೇ ತುನಾಸ್ ಖ್ಹಲಾಮ್‌ಕರ್‌ಶೆ. ತಾರೊಹಾತ್ ತಾರ ವಹೇರ‍್ಯಾವ್ನಿ ಘಲೇಂಡಿಪರ್‌ ರ‍್ಹಿಶೆ. ತಾರ ಭೈಯೇ ತುನ ಆಡ್‌ಪಡ್‌ಶೆ. <verse eid="GEN 49:8" /><verse number="9" style="v" sid="GEN 49:9" />ಯೆಹೂದ ಜ಼ವಾನಿ ಶುಂಭನಿತರ ಛಾ಼. ಮಾರ ಛಿಯ್ಯಾ, ತೂ ಜಾನ್ವರ್‌ನ ಧರಿನ್ ಮಾರಿನಾಖಿನ್ ಪಹಾಡ್‌ಮ ಜೈ಼ನ್ ರ‍್ಹೇಯ್ತೆ ಶುಂಭನಿತರ ಛಾ಼. ಯೊ ತಯೇಡ ಶುಂಭಾನಿಘೋಣಿ ಗೋಡ ಖ್ಹಮ್‌ಟೈಲೀನ್ ಕೈರಾಟೆ ಬೇಠೋಸ್. ಜಾನ್ವರ್‌ನೊ ರಾಜಾ಼ನ ಬರೋಬರ್‌ ಹುಯಿರೋತೆ ಅನ ಛೇಡಾವನ ಕಿನೇಥಿ ಉಶೆ? <verse eid="GEN 49:9" /><verse number="10" style="v" sid="GEN 49:10" />ಇನ ಮಳ್‌ಣುತೆ ರಾಜ್ಯ ಇನ ಶಿಲೋವ್‌ಥು ಆವಾಲಗೂಬಿ ಯೊ ರಾಜ಼ನೊ ಡಂಡೊ ಯೆಹೂದನ ಹಾತ್ಮಾಥೊ ಛು಼ಟ್‌ಶೆಕೊಯ್ನಿ. ರಾಜಾ಼ನೊ ಡಂಡೊ ಇನ ಪಗ್‌ಕಂಥು ಖ್ಹಳಕ್‌ಶೆಕೊಯ್ನಿ. ಖ್ಹಾರು ಜ಼ಗ್‌ಜಾ಼ತ್‌ವಾಳುಬಿ ಇನ ಅದೀನ್ ಹುಯಿಜಾ಼ಶೆ. <verse eid="GEN 49:10" /><verse number="11" style="v" sid="GEN 49:11" />ಯೊ ಇನ ಸವಾರಿಕರಾನ ಜಾನ್ವಾರ್‌ನ ದ್ರಾಕ್ಷಿನ ವೇಲೇಥಿ ಭಾಂದ್‌ಶೆ, ದ್ರಾಕ್ಷಿನ ವೇಲೇಥಿ ಇನ ಗಧೇಡಿನ ಚೆಲ್ಕಾನ ಭಾಂದ್‌ಶೆ. ಯೊ ಇನ ಲುಂಗ್ಡಾನ ದ್ರಾಕ್ಷಿನ ರಖ್ಹ್‌ಮ ಧೋವ್‌ಶೆ; ಡುಬೈನ್ ಇನ ಝ಼ಗ್ಗಾನ ಧೋವಸ್. <verse eid="GEN 49:11" /><verse number="12" style="v" sid="GEN 49:12" />ದ್ರಾಕ್ಷಿನ ರಖ್ಹ್‌ಥಿ ಇನ ಡೋಳ ಲಾಲ್‌ಹುಯಿರ‍್ಹಿಶೆ. ದೂದ್‌ಥಿ ಇನ ದಾತ್‌ ಧೋಳಫಟ್ ಹುಯಿರ‍್ಹಿಶೆ. <verse eid="GEN 49:12" /><verse number="13" style="v" sid="GEN 49:13" />ಜೆಬುಲೂನ್ ದರ‍್ಯಾವ್ನ ಕನಾರೆಮ ಜಿವ್ಣು ಕರಸ್. ಇನ ಜ಼ಹಾಜ಼್ ಅಯಿನ್ ಜಾ಼ಯಿತೆ ಬಂದರ್‌ಕನ ಛಾ಼. ಇನ ಮುಲಕ್ನು ಏಕ್‌ಭಾಗ್ ಸೀದೋನ್ನ ಛಿಮಾವಸ್. <verse eid="GEN 49:13" /><verse number="14" style="v" sid="GEN 49:14" />ಇಸ್ಸಾಕಾರ ಮೇಂಢಾನ ಕೋಠಾನ ಇಚ಼್‌ಮ ಖ್ಹುತೊಹುಯೊ ಮೋಟೊ ಗಧೇಡೊ. <verse eid="GEN 49:14" /><verse number="15" style="v" sid="GEN 49:15" />ಇನ ಮಳ್ಯೋತೆ ತಬರ್‌ಖೊ ಅರಾಮ್‌ಕರಾನ ಅಛ಼್ಛುಬಿ ಖ್ಹುಕ್‌ಥಿ ರ‍್ಹಾವಖ್ಹರ್ಕುಬಿ ಹುಯಿರಾವನು ದೇಖ್ಯೊ. ಯೊ ಭೋಜ಼್‌ ಢೊವಾನ ಖ್ಹಾಜೆ ಪೀಟ್‌ಝು಼ಕೈನ್ ಫುಗಟ್‌ನು ಕಾಮ್‌ಕರಾವಾಳೊ ಸೇವಕ್ ಹುಯಿರ‍್ಹಿಶೆ. <verse eid="GEN 49:15" /><verse number="16" style="v" sid="GEN 49:16" />ದಾನ್‌ನೆ ಇಸ್ರಾಯೇಲವಾಳನು ಖೂಮ್‌ನಿ ಘೋಣಿ ಇನ ಅದ್ಮೆವ್‌ನ ನ್ಯಾವ್‌ದೀನ್ ಚ಼ಲಾವ್‌ಶೆ. <verse eid="GEN 49:16" /><verse number="17" style="v" sid="GEN 49:17" />ದಾನ್‌ ಮಾರಗ್‌ನ ಇಚ಼್ಮಪಡ್ಯೊರ‍್ಹಾವಾಳೊ ಝಾರ್‌ನ ಖ್ಹಾಪ್‌ನಿತರ ರ‍್ಹಿಶೆ. ಯೊ ಘೋಡಾನಿ ಖುರಿನ ಕಲ್ಡ್‌ಶೆ. ಇನ ಚ಼ಲಾವವಾಳನ ಹೇಟ್ ಚಿತ್ತೊ ರಡ್‌ಕಾವ್‌ಶೆ. <verse eid="GEN 49:17" /><verse number="18" style="v" sid="GEN 49:18" />ಯೆಹೋವ ದೇವ್‌, ತೂ ಮನ ಬಚಾ಼ಡನೊ ಮಾರಗ್‌ನ ಟಿವೈನ್ ದೇಖೂಕರೂಸ್‌. <verse eid="GEN 49:18" /><verse number="19" style="v" sid="GEN 49:19" />ಗಾದನ ಉಪ್ಪರ್‌ ಲೂಟಿಕರವಾಳು ಪಡ್ಯುತೊ, ಕತೋಬಿ ಯೊ ಇವ್ಣುನ ರಪೇಟಿಲೀನ್‌ಜಾ಼ಶೆ. <verse eid="GEN 49:19" /><verse number="20" style="v" sid="GEN 49:20" />ಅಶೇರನ ಅನಾಜ಼್ ಚೆಹೇಳ್‌ಉಶೆ. ಇನಾಕನ ರಾಜ಼ನ ಹೋಣುತೆ ಚೀಜ಼್ ಖ್ಹಾರು ಮಳ್‌ಶೆ. <verse eid="GEN 49:20" /><verse number="21" style="v" sid="GEN 49:21" />ನಫ್ತಾಲಿ ಛು಼ಟ್‌ಕಾರ್‌ಥಿ ಹರಣ್ ಘೋಣಿಛಾ಼. ಇನೇಥಿ ಖ್ಹಾಜ಼್‌ನಿವಾತೆ ನಿಕಳ್‌ಶೆ. <verse eid="GEN 49:21" /><verse number="22" style="v" sid="GEN 49:22" />ಯೋಸೇಫ ಘಣುಫಲ್‌ ದ್ಯವಾಳೊ ಝಾಡ್‌ನಿತರ ಚೇಜ಼್‌ಭಾರಕನ ಛಾ಼ತೆ ಫಲ್‌ನು ವೇಲೊ ಹುಯಿರೋಸ್‌. ಭೀತ್‌ನಪಾರ್ ಇನಿ ಡಾಳಿಯೇ ಫೈಲೈರ‍್ಹಯೇಸ್. <verse eid="GEN 49:22" /><verse number="23" style="v" sid="GEN 49:23" />ಕಡ್‌ವೈಥಿ ಧೂಣ್‌ಮಾರವಾಳು ಇನ ಕಬ್‌ಜಾ಼ಕರಿಲಿಶೆ, ವಹೇರ್‌ಥಿ ತೀರ್‌ನ ಇನಾಪರ್‌ ಫೇಕ್‌ಶೆ. <verse eid="GEN 49:23" /><verse number="24" style="v" sid="GEN 49:24" />ಕತೋಬಿ ಯಾಕೋಬನ ಖೂಮ್‌ನೊ ಖ್ಹಾರೀಸ್‍ ಶಕತ್‌ಬಳ್‌ವಾಳನಿ ತಾಖಥ್ಥಿಬಿ, ಇಸ್ರಾಯೇಲನ ಪಾಳನ್‌ಹಾರ್ ಚಿಪಾಟ್‌ ಹುಯಿರ‍್ಹವಾಳನ ನಾಮ್‌ಥೀಬಿ ಯೋಸೇಫನ ಹಾತ್‌ಮಾನು ಧೂಣ್ ಘಟ್‍ಥಿ ಭೀರಿಶೆ. ಯಾಕೋಬನ ಯಜಮಾನ್‌ಥಿ ಇನ ಹಾತ್ಮ ತಾಖತ್‌ಛಾ಼. <verse eid="GEN 49:24" /><verse number="25" style="v" sid="GEN 49:25" />ತಾರೊ ಬಾನೊ ದೇವ್‌ ತುನ ಮದತ್‌ಕರವಾಳೊ ಹುಯಿರೋಸ್. ತಾರೊ ಬಾನೊದೇವ್ ತುನ ಆಶೀರ್ವಾದ್‌ ಕರ್‌ಶೆ. ಸರ್ವಶಕ್ತ ಹುಯಿರೋತೆ ಯೆಹೋವ ದೇವ್, ಯೊ ಉಪ್ಪರ್‌ಲ್ಯಆಬ್‌ಥೀಬಿ, ಹೇಟ್‌ನು ದರ‍್ಯಾವ್‍ನಿ ಪಥಾರಿಯೇಮಾಥೂಬಿ, ಛಾ಼ತಿಯೇಥೀಬಿ, ಗರಬ್‌ನುಫಲ್‌ಥೀಬಿ , ಹುವಾನು ವರ್‌ದಾನ್ ತುನ ದೀನ್ ಆಶೀರ್ವಾದ್‌ಕರಾದೆ. <verse eid="GEN 49:25" /><verse number="26" style="v" sid="GEN 49:26" />‘ತಾರ ಬಾನಿ ಆಶೀರ್ವಾದ್‌ಖ್ಹಾರಿ ತಾರ ಗುರುಗುರಬ್‌ಲ್ಯಾನಿ ಆಶೀರ್ವಾದ್‌ಥೀಬಿ ಜಾ಼ಖ್ಹತ್ ಹುಯಿರುಸ್. ಶುರುವಾತ್‌ಥೂಬಿ ಪಹಾಡ್‌ಥಿಹುವಾತೆ ಖ್ಹಾರೂಸ್ ಮೇಲ್‌ಥೀಬಿ, ಶತಾಕಾಲ ಯೋಸೇಫನ ಉಪ್ಪರ್‌ಬಿ ಇನ ಭೈಯೇನ ಉಪ್ಪರ್‌ಬಿ ಛೇಳ್‌ಥಿ ಉತ್ರಿನ್ ಆವಾದೆ. <verse eid="GEN 49:26" /><verse number="27" style="v" sid="GEN 49:27" />“ಬೆನ್ಯಾಮೀನ್ ಮೇಂಢಾನ ಧರಿಖಾವಾಳೊ ಹಡಾನಿ ತರಛಾ಼. ರಾತೆ ಧರ‍್ಯಹುಯಾನ ವ್ಹಾಣೆಖಾಸ್. ಲೂಟ್ಯಾಹುಯಾನ ಖ್ಹಾಂಜೆ ವಾಟ ಪಾಡಿಲೇಸ್” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 49:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />ಅವ್ಣೆಖ್ಹಾರುಬಿ ಯಾಕೋಬಥಿ ಹುಯುತೆ ಬಾರ‍್ಹಖೂಮ್‌; ಆಸ್‌ಖ್ಹಾರು ಇವ್ಣೊ ಬಾನೆ ದಿದೋತೆ ಆಶೀರ್ವಾದ್; ಏಕೇಕ್‌ ಖೂಮ್‌ನ ಇನೆ ಬೋಲ್ಯೋತೆ ಏಕೇಕ್‌ನ ಆಶೀರ್ವಾದ್‌ನು ವಚನ್ ಬೊಲ್ಯೊ.<verse eid="GEN 49:28" /></para>
  <para style="s">ಯಾಕೋಬನಿ ಮರಣ್ ಅಜು಼ ಮಖ್ಹಾಣ್ಯು</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />ಯಾಕೋಬನೆ ಇನ ಲಡ್ಕಾವ್ನ ದಿದೋತೆ ಹುಕುಮ್ ಶಾತ್‌ಕತೊ, “ಮೇ ಮಾರ ಗುರುಗುರಬ್‌ಲ್ಯಾಕನ ಮಳಾನಿ ವಖ್ಹತ್‌ಖನ್ನೆಹುಯಿಗು. ಇನಖ್ಹಾಜೆ ಹಿತ್ತಿಯವಾಳೊ ಎಫ್ರೋನನಿ ಜ಼ಮೀನ್‌ಮ ಛಾ಼ತೆ ಘವಿಮ, ಮನ ಮಾರ ಗುರುಗುರಬ್‌ಲ್ಯಾಕನ ಮಖ್ಹಾಣ್ಯುಕರ‍್ನು. <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />ಯೊ ಘವಿ ಕಾನಾನ್ ದೇಖ್ಹ್‌ನು ಮಮ್ರೆಗಾಮ್‌ನ ಮ್ಹೋರೆಛಾ಼ತೆ ಮಕ್ಪೇಲ ಕರಿ ಬಲ್ಡಾಮ ಛಾ಼. ಅಬ್ರಹಾಮ್‌ನೆ ಯೊ ಘವಿನ ಅಶ್‌ಪಿಶ್‌ಥೂತೆ ಜ಼ಮೀನ್‌ಖ್ಹಮೇದ್‌ ಹಿತ್ತಿಯವಾಳೊ ಎಫ್ರೋನ್‌ಥಿ ಶೊಂತ್‌ ಮಖ್ಹಾಣ್ಯಾನಿ ಜ಼ಮೀನ್ನಾಖ್ಹಾಜೆ ಲೀಲಿದೊ. <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />ಹಿಜ್ಜಾ಼ ಅಬ್ರಹಾಮ್‌ನಾಬಿ ಇನಿ ಬಾವಣ್‍ ಸಾರಾನಾಬಿ ಮಖ್ಹಾಣ್ಯುಹುಯು. ಹಿಜ್ಜಾ಼ಸ್ ಇಸಾಕ್‌ನಾಬಿ ಇನಿ ಬಾವಣ್ ರೆಬೆಕ್ಕನಾಬಿ ಮಖ್ಹಾಣ್ಯುಹುಯು. ಹಿಜ್ಜಾ಼ ಲೇಯನಾಬಿ ಮೇ ಮಖ್ಹಾಣ್ಯುಕರ‍್ಯೊ. <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />ಖೇತರ್‌ಖ್ಹಮೇದ್ ಹಿತ್ತಿಯವಾಳಥಿ ಮೋಲ್‌ಲೀಲಿನ್ ಯೊ ಘವಿಮ ಮನಾಬಿ ಮಖ್ಹಾಣ್ಯುಕರ‍್ನು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 49:32" /><verse number="33" style="v" sid="GEN 49:33" />ಯಾಕೋಬನೆ ಇನ ಲಡ್ಕಾವ್ನ ಹುಕುಮ್‌ದ್ಯಾವಾನು ಖತಮ್‌ಕರೀನ್ ಬಿಛಾ಼ವ್ಣಪರ್ ಇನ ಗೋಡಾವ್‍ನ ಖ್ಹಮ್‌ಟೈ ಜಾನ್‌ಮ್ಹೇಲಿನ್, ಗುರುಗುರಬ್‌ಲ್ಯಾಕನ ಮಳೀಗೊ.<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />ತದೆ ಯೋಸೇಫನೆ ಇನ ಬಾನ ಮ್ಹೋಡಪರ್ ಪಡೀನ್ ರೊಯಿನ್‌ ಇನ ಬುಚ್ಚಾ಼ಕರ‍್ಯೊ. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />ತದೆ ಯೋಸೇಫನೆ ಇನ ಪೊಂಡಿತ್‌ನ ಹುಕುಮ್ ಕರೀನ್, ಇನ ಬಾ ಯಾಕೋಬನ ಮಖ್ಹಾಣ್ಯಾನ ವಾಖ್ಹ್‌ನು ತೇಲ್ ಲಗಾಡಿನ್ ತಯ್ಯಾರ್‌ಕರೊ. ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />ಪದತ್ತಿನಿ ಪರಕ್ಮ ಚಾ಼ಳಿಖ್ಹ್ ದನ್ ವಾಖ್ಹ್‌ನು ತೇಲ್ ಲಗಾಡ್‌ನುಥು, ಈಜಿಪ್ಟ್‌ವಾಳು ಇನಖ್ಹಾಜೆ ಖ್ಹಡ್‌ತೀನಿಖ್ಹ್ ದನ್‌ಲಗೂಬಿ ಅಂದ್ರೋಖ್ಹ್‌ ಕರ‍್ಯು. <verse eid="GEN 50:3" /><verse number="4" style="v" sid="GEN 50:4" />ತದೆ ದುಖ್‌ನ ದನ್ ನಿಕ್ಳಿಜಾವಾ಼ದೀನ್‌ ಯೋಸೇಫನೆ ಫರೋಹನ ಅದಿಕಾರಿನ, “ದಯಾಕರೀನ್ ತುಮೆ ಫರೋಹಕನ ಜೈ಼ನ್ ಆ ವಾತೆ ಬೋಲೊ. <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />ಮಾರೊ ಬಾ ಯೊ ಕಾನಾನ್ ದೇಖ್ಹ್‌ಮ ತಯಾರ್ ಕರಿ ರಾಖ್ಯೋತೆ ಝ಼ಗೋಮಸ್‌ ಇನ ಮಖ್ಹಾಣ್ಯು ಕರ‍್ನುಕರಿ ಮರಾನ ಅಗಾಡೀಸ್‌ ಮಾರೇಥಿ ಆಣ್‌ಕರಾಯೊಥೊ. ಇನಖ್ಹಾಜೆ ಮಾರಪರ್ ತುಮುನ ಗೋರ್‌ಉಶೇತೊ ತುಮೆ ಜೈ಼ನ್, ಆ ವಾತೆ ಫರೋಹನ ಖ್ಹಮ್‌ಜಾ಼ಡೀನ್, ಮೇಜೈ಼ನ್ ಬಾನ ಮಖ್ಹಾಣ್ಯು ಕರೀನ್ ಆವಾನ ಹುಕುಮ್ ದೇವ್ಣುಕರಿ ಬಿಂತಿ ಕರಿಲೆವುಸ್‌” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />ಫರೋಹನೆ ಆವಾತೆ ಖ್ಹಮ್‌ಜಿನ್‌ ಯೋಸೇಫನ, “ತಾರೊ ಬಾ ಆಣ್‌ಕರಾಯೊತೆ ಪರಕ್ಮ ತೂ ಜೈ಼ನ್ ಇನ ಮಖ್ಹಾಣ್ಯು ಕರೀನ್ ಆಯೇಜಾ಼ಯ್” ಕರಿ ಹುಕುಮ್‌ದಿದೊ. <verse eid="GEN 50:6" /><verse number="7" style="v" sid="GEN 50:7" />ಯೋಸೇಫ ಬಾನ ಮಖ್ಹಾಣ್ಯು ಕರಾನ ನಿಕ್ಳಾನಿವಖ್ಹ್‌ತೆ ಇನಿ ಜೋ಼ಡ್ಮ ಫರೋಹನು ಪರಿವಾರ್‌ಖ್ಹಾರೂಬಿ, ಮಹೇಲ್‌ನು ಮುಖ್ಯವಾಳುಬಿ , ಈಜಿಪ್ಟ್‌ನು ಗಲ್‌ಢಖ್ಹಾರುಬಿ, <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />ಯೋಸೇಫನ ಘರ್‌ವಾಳುಖ್ಹಾರುಬಿ , ಭೈಯೇಬಿ, ಬಾನ ಘರ್‌ವಾಳು ಖ್ಹಾರೂಬಿ ಗಯು. ಇವ್ಣೆ ಇವ್ಣಿ ಬಾವ್ಣೆ ಲಡ್ಕಾವ್ನ ಮೇಂಢ ಢಾಂಡವ್ನ ಖಲಿ ಗೋಷೆನ್ ತಬರ್‌ಖಾಮ ಮ್ಹೇಲಿದಿನ್ ಗಯಾ. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />ಇನಿ ಜೋ಼ಡ್ಮ ರಥ್ ಖ್ಹಾರೂಬಿ, ಘೋಡೊಖ್ಹಾರೂಬಿ ಗಯು. ಯೋಸೇಫನ ಜೋ಼ಡ್ಮ ಘಣು ಝೂ಼ಂಡಸ್‌ ಗಯು. <verse eid="GEN 50:9" /><verse number="10" style="v" sid="GEN 50:10" />ಇವ್ಣೆ ಯೊರ್ದನ್ ನದ್ದಿನಪಾರ್ ಛಾ಼ತೆ ಆಟಾದ್‌ಕರಿ ಖಳಾಮ ಅಯಿನ್ ಹಿಜ್ಜಾ಼ ಘಣು ರೊಯು. ಯೋಸೇಫ ಇನ ಬಾನ ಖ್ಹಾಜೆ ಖ್ಹಾತ್ ದನ್‌ಲಗು ಅಂದ್ರೋಖ್ಹ್‌ ಕರಾಯೊ. <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />ಯೊ ದೇಖ್ಹ್‌ನು ಅದ್ಮಿಹುಯಿರ‍್ಹೂತೆ ಕಾನಾನ್ಯವಾಳು ಯೊರ್ದನ್‌ ನದ್ದಿನ ಪಾರ್‌ಥೂತೆ ಆಟಾದ್‌ಕರಿ ಖಳಾಮ ಚಾ಼ಲ್ಯೂತೆ ರದನ್ನದೇಖಿನ್ ಈಜಿಪ್ಟ್‌ವಾಳಾನ ಆಯೂತೆ ಆ ಅಂದ್ರೋಖ್ಹ್‌ ಘಣು ವಿಶೇಷ್ ಛಾ಼ ಕರಿ ಬೋಲ್ಯೂತೆ ಇನಖ್ಹಾಜೆ ಯೊ ಝ಼ಗೋನ “ಅಬೇಲ್‌ಮಿಚ್ರಯೀಮ್” ಕರಿ ನಾಮ್‌ಹುಯು. <verse eid="GEN 50:11" /><verse number="12" style="v" sid="GEN 50:12" />ಯಾಕೋಬನ ಛಿಯ್ಯಾ ಬಾನಿ ಹುಕುಮ್ನಿಘೋಣಿ ಕರ‍್ಯ. <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />ಇನ ಮುರ್ದಾನ ಕಾನಾನ್ ದೇಖ್ಹ್‌ನ ಢೊಯಿಲೀಜೈ಼ನ್ ಮಕ್ಪೇಲ ಕರಿ ಬಲ್ಡಾನು ಘವಿಮ ಮಖ್ಹಾಣ್ಯು ಕರ‍್ಯು. ಅಬ್ರಹಾಮ್‌ನೆ ಹಿತ್ತಿಯವಾಳೊ ಎಫ್ರೋನ್‌ಥಿ ಮಮ್ರೆಗಾಮ್‌ನ ಮ್ಹೋರೇನು ಯೊ ಘವಿನ, ಅಶ್‌ಪಿಶ್‌ನಿ ಜ಼ಮೀನ್ ಖ್ಹಮೇದ್ ಶೊಂತ್‌ ಮಖ್ಹಾಣ್ಯಾನಖ್ಹಾಜೆ ಮೋಲ್ ಲೀರಾಖ್ಯೋಥೊ. <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />ಬಾನ ಮಖ್ಹಾಣ್ಯುಕರಿ ಹುವಾದೀನ್ ಯೋಸೇಫಬಿ ಇನ ಭೈಯೇಬಿ ಬಾನು ಮಖ್ಹಾಣ್ಯು ದ್ಯವಾನಖ್ಹಾಜೆ ಜೋ಼ಡ್ಮ ಗಯುಹುಯು ಖ್ಹಾರೂಸ್ ಈಜಿಪ್ಟ್‌ನ ಪಾಛು಼ ಫರಿಗಯು.<verse eid="GEN 50:14" /></para>
  <para style="s">ಯೋಸೇಫನೆ ಇನ ಭೈಯೇವ್‌ನ ಭರೋಖ್ಹೊ ದಿದೋತೆ.</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />ಯೋಸೇಫನ ಭೈಯೇ ಬಾ ಮರಿಗಯೋತೆ ದೇಖಿನ್, “ಏಕ್‌ ವೇಳ್ ಯೋಸೇಫ ಹಮುನ ವಹೇರ್‌ಕರೀನ್ ಹಮೆ ಕರ‍್ಯಾತೆ ಕೇಡ್‌ನ ಬದಲ್ ಹಮುನ ನಿಶತ್ ದೇಸ್‌ಕಿಶುಕಿ?” ಕರಿ ಇವ್ಣ ಇವ್ಣಾಸ್‌ಮ ವಾತ್‌ಬೋಲಿಲಿದ. <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />ಇವ್ಣೆ ಯೋಸೇಫನ, ‘ತಾರೊ ಬಾ ಮರಾನ ಪಹಿಲೆ ಹಮುನ ಹುಕುಮ್‌ ದೀನ್‌ ಶಾತ್‌ ಬೋಲ್ಯೊಥೊಕತೊ, <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />“ತಾರ ಭೈಯೇ ಹುಯಿರ‍್ಹಾತೆ ಹಮೆ ತುನ ಕೇಡ್‌ಕರ‍್ಯಾತೆ ಖ್ಹಾಚೀಸ್‌. ಕತೋಬಿ ಅಪ್ಣ ಬಾನ ದೇವ್ನ ಅರಾದನೆ ಕರಾವಾಳಬಿ, ಆಳ್‌ಬಿ ಹುಯಿರ‍್ಹಾತೆ ಹಮಾರಿ ಅಪರಾದ್ನ ಕ್ಷಮಾಪಣ್ ಕರ‍್ನುಕರಿ ಬಿಂತಿಕರಿಯೇಸ್” ಕರಿ ಯೋಸೇಫಕನ ಗಿಂಗೈಲೆವೊ ಕರಿ ಬೊಲ್ಯೊ. ಯೋಸೇಫನೆ ಆ ವಾತ್ನ ಖ್ಹಮ್‌ಜಿನ್ ರೋಯೊ. <verse eid="GEN 50:17" /><verse number="18" style="v" sid="GEN 50:18" />ಆನಾಹುಯಿನ್‌, ಭೈಯೇ ಇವ್ಣೇಸ್ ಆಯಿನ್ ಇನ ಖ್ಹಾಮ್ಣೆ ಆಡ್‌ಪಡಿನ್, “ಹಂದೇಕ್ ಹಮೆ ತುನ ಗುಲಾಮ್‌ಹುಯಿರ‍್ಹಾಸ್” ಕರಿ ಬೋಲ್ಯ. <verse eid="GEN 50:18" /><verse number="19" style="v" sid="GEN 50:19" />ಯೋಸೇಫನೆ ಇವ್ಣುನ, “ನಕೊ ಡರೊ; ಮೇ ಶಾತ್ ದೇವ್ನಿ ಝ಼ಗೋಮ ಛೂ಼ಕಿ ಶು? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />ತುಮೇತೊ ಮನ ಲುಕ್ಷಾನ್ ಕರ‍್ಯ. ಕತೋಬಿ ದೇವ್ನೆ ಮನ ಅಛ್ಛು಼ಹೋಣುಕರಿ ಖ್ಹೂಜ಼್ ಕರ‍್ಯೊ; ಇನಖ್ಹಾಜೆ ಕೈಏಕ್ ಅದ್ಮಿನೊ ಜಾನ್‌ ಬಚಾ಼ಡಂತರ ಹುಯು. ಹಮ್ಕೆಲಗೂಬಿ ಆ ಕಾಮ್ ಚಾ಼ಲುಕರಸ್. <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />ಇನಖ್ಹಾಜೆ ತುಮೆ ಡರೊನಕೊ. ಮೇ ತುಮುನಾಬಿ ತುಮಾರಕನ ರ‍್ಹಾವಳ ಖ್ಹಾರಾಸ್‌ನಾಬಿ ಪಾಳೂಸ್‌” ಕರಿ ಬೋಲಿನ್ ಇವ್ಣುನ ಖ್ಹೊಪೊರಾಖ್ಯೊ. ಇವ್ಣಿಜೋ಼ಡ್ಮ ಗೋರ್‌ಥಿ ವಾತ್‌ಬೋಲ್ಯೊ.<verse eid="GEN 50:21" /></para>
  <para style="s">ಯೋಸೇಫನಿ ಮರಣ್‌</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />ಅಮ್ ಯೋಸೇಫಬಿ, ಇನ ಬಾನ ಘರ್‌ವಾಳೂಬಿ ಈಜಿಪ್ಟ್‌ಮ ಜಿವ್ಣುಕರ‍್ಯು. ಯೋಸೇಫ ಏಖ್ಹೋದಖ್ಹ್ ವರಖ್ಹ್ ಬಚಿರ‍್ಹೊ; <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />ಎಫ್ರಾಯೀಮನ ಲಡ್ಕಾವ್ನು ನಾತಿಪೋತಿನಾಬಿ ದೇಖ್ಯೊ. ಮನಸ್ಸೆನೊ ಛಿಯ್ಯೊ ಮಾಕೀರನಾಬಿ ಲಡ್ಕ ಪೈದಹುವಾದೀನ್ ಇವ್ಣೇಬಿ ಯೋಸೇಫನ ಮಾಂಡಿಪರ್‌ ಪಳ್ಯ. <verse eid="GEN 50:23" /><verse number="24" style="v" sid="GEN 50:24" />ಯೋಸೇಫ ಇನ ಭೈಯೇನ, “ಮಾರ ಮರಣ್ಣ ದನ್ ಖನ್ನೆ ಐಗಾ. ಕತೋಬಿ ದೇವ್ ತುಮುನ ಬಚಾ಼ಡಾನ ಆವ್‌ಶೇಸ್‌ ಆವ್‌ಶೆ; ಯೊ ಅಬ್ರಹಾಮ್, ಇಸಾಕ್, ಯಾಕೋಬನ ದೆವುಸ್‌ಕರಿ ವಾಗ್ದಾನ್‌ ಕರ‍್ಯೋಥೋತೆ ದೇಖ್ಹ್‌ನ ತುಮೆ ಜಾ಼ವಾಂತರ ಕರ್‌ಶೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />ಆನಾಹುಯಿನ್ ಯೋಸೇಫನೆ ಇಸ್ರಾಯೇಲ್‌ನ ಲಡ್ಕಾವ್ನ, “ದೇವ್ ತುಮುನ ಗುಮಾನೀಸ್‌ಕೊಂತೆ ಬಚಾ಼ಡಾನ ಆವ್‌ಶೆ; ತದೆ ತುಮೆ ಮಾರ ಪಿಂಜ಼ರ್‌ನ ತುಮಾರಿ ಜೋಡ್ಮ ಢೊಯಿಲೀನ್ ಜಾ಼ವ್ಣು” ಕರಿ ಇವ್ಣೇಥಿ ಆಣ್‌ ಲೆವಾಡ್ಯೊ. <verse eid="GEN 50:25" /><verse number="26" style="v" sid="GEN 50:26" />ಯೋಸೇಫ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಏಖ್ಹೋದಖ್ಹ್ ವರಖ್ಹ್‌ವಾಳೊಹುಯಿನ್ ಜಾನ್‌ಮ್ಹೇಲ್ಯೊ. ಇನ ಮುರ್ದಾನ ವಾಖ್ಹ್‌ನು ತೇಲ್‌ಖ್ಹಾರು ಲಯಿನ್ ಲಗಾಡಿನ್, ಇನ ಎಕ್ ಪಿಟಾರಾಮ ಘಾಲ್ಯು.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>