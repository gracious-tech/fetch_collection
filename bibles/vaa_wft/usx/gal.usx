<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id">-WAGHRI</book>
  <para style="h">ಗಲಾತ್ಯವಾಳಾನ</para>
  <para style="toc3">ಗಲಾತ್ಯ</para>
  <para style="toc2">ಗಲಾತ್ಯ</para>
  <para style="toc1">ಪೌಲನೆ ಗಲಾತ್ಯವಾಳಾನ ಲೀಖ್ಯೋತೆ ಚಿಟ್ಟಿ</para>
  <para style="mt2">ಪೌಲನು ಗಲಾತ್ಯದವರಿಗೆ ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="mt1">ಪೌಲನೆ ಗಲಾತ್ಯವಾಳಾನ ಲೀಖ್ಯೋತೆ ಚಿಟ್ಟಿ</para>
  <para style="imt">ಮಾಲುಮ್‌ಕರಾನು</para>
  <para style="ip">ಅಪೊಸ್ತಲ ಹುಯಿರ‍್ಹೋತೆ ಪೌಲ ಗಲಾತ್ಯವಾಳಾನ ಚಿಟ್ಟಿ ಲೀಖಿರಾಖ್ಯೊಸ್ <char style="xt"><ref loc="GAL 1:1">1:1</ref></char> ಆ ಚಿಟ್ಟಿನ ಪೌಲನೆ 48-57 ವರಖ್ಹ್‌ನ ಬೀಚ್ಮ ಗಲಾತ್ಯನಿ ಸಬೆನ ಲೀಖಿರಾಖ್ಯೊಸ್. ಗಲಾತ್ಯವಾಳು ಘಣೇಥಿ ರೋಮ್ ಸಾಮ್ರಾಜ್ಯನು ಗಲಾತ್ಯಕರಿ ಬೋಲೈಲ್ಯವಾನ ತಬರ್‌ಖಾಮ ಜಿವ್ಣು ಕರುಕರ್ತುಥು. ಪೌಲನೆ ಆ ಚಿಟ್ಟಿ ಲೀಖಾನಿವಖ್ಹ್‌ತೆ ಕಿಜ್ಜಾ಼ಥೂಕರಿ ಕರಿ ಬೋಲಾನು ಲಿಖಾಪಟ್‌ವಾಳನ ಬರೋಬರ್‌ ಮಾಲುಮ್ ಪಡ್ಯುಕೊಯ್ನಿ, ಕತೋಬಿ ಎಫೆಸ ಕೊರಿಂಥ ಆ ಭೇ ಖ್ಹಯೇರ್‌ಮ ಯೊ ಥೋಕರಿ ಬೋಲೈರ‍್ಹುಸ್.</para>
  <para style="ip">ಪೌಲಾನಿ ಆಚಿಟ್ಟಿ ಗಲಾತ್ಯ ಸಭೆಮ ಛಾ಼ತೆ ಯೆಹೂದಿ ಅಜು಼ ಯೆಹೂದಿಕೊಂತೆ ವಿಶ್ವಾಸಿನ ಖ್ಹಾಜೆ ಆ ಚಿಟ್ಟಿ ಲೀಖಿರಾಖ್ಯೊಸ್. ವಿಶೇಷ್‌ಥಿ ಇನೆ ವಿಶ್ವಾಸಿಖ್ಹಾರು ಯೆಹೂದ್ಯರ್‌ನಿ ಜೂ಼ನಿ ಒಪ್ಪಂದಾನಿ ನಿಯಮ್ನ ಪಾಲನ್‍ ಕರ್ನುಕರಿ ಬಾರೇನು ಖ್ಹತ್ನಕರಾವನಿ ಬಾರೇಮ ಲೀಖಿರಾಖ್ಯೊಸ್. ಕ್ರಿಸ್ತ ವಿಶ್ವಾಸಿನ ಬೀಚ್ಮ ಯೆಹೂದ್ಯವಾಳಕರಿ ಬೋಲೈಲ್ಯವಾಳು ಥೋಡು ಅದ್ಮಿನು ಝೂ಼ಂಡ್‌ಥು. ಇವ್ಣುನ ಯೆಹೂದ್ಯಕಾಹೇತೆ ಕ್ರಿಸ್ತ ವಿಶ್ವಾಸಿಖ್ಹಾರು ಖ್ಹತ್ನ ಕರಾವ್ಣುಥು. ಇವ್ಣೆ ಪೌಲನಿ ಅಪೊಸ್ತಲಹುವಾನಿ ಅಧಿಕಾರ‍್ನಿ ಬಾರೇಮ ಸವಾಲ್‌ ಕರ‍್ಯು. ಪೌಲನೆ ಇನಿ ಜಿವ್ಣಾನಿ ಥೋಡಿ ಖೇಣಿನ ಬೋಲ್ತೊಹುಯಿನ್ ಅಪೊಸ್ತಲ್‌ಹುವಾನಿ ಬಾರೇಮ ಜ಼ವಾಬ್ ದೇಸ್. <char style="xt"><ref loc="GAL 1:11-2:14">1:11—2:14</ref></char> ಅಜು಼ ಇನೆ ಸುವಾರ್ತೆ ಬೋಲ್ತೊಹುಯಿನ್ ಯೇಸು ಕ್ರಿಸ್ತನಪರ್‌ ರಾಖಾನಿ ವಿಶ್ವಾಸ್‌ಥೀಸ್ ಬಚೇಜಾ಼ಯ್‌ಕರಿ ಒಪ್ಪಿಕೆ ದಿದೊ <char style="xt"><ref loc="GAL 2:16">2:16</ref></char> ಆಹೈರುತೆ ಅದ್ಮಿಥು ಹುಯಿರ‍್ಹುಕೊಯ್ನಿ. ದೇವ್ನಿ ಗೋರ್‌ನಿ ಪ್ರತಿಫಲ್ ಹುಯಿರ‍್ಹುಸ್‌ಕರಿ ದೆಖಾಡಸ್.</para>
  <para style="iot">ಕಾಡಿದೇಖೊ</para>
  <para style="io1">1. ಪೌಲನೆ ಗಲಾತ್ಯನು ಸಬೆನ ಖ್ಹಲಾಮ್ ಕರ್ತೊಹುಯಿನ್ ಚಿಟ್ಟಿನ ಶುರುಕರಸ್. <char style="ior"><ref loc="GAL 1:1-5">1:1-5</ref></char> ಇನಪಾರ್ ಪೌಲನೆ ಇನು ಶಿಕಾಡನು ಹಕ್ನಿ ಬಾರೇಮ ವತಾಳನಖ್ಹಾಜೆ ಇನು ಶೊಂತ್ ಬಾರೇಮ ಇನ ಪೀಛೆ ಶಾತ್‌ ಕರ‍್ಯೊಥೋಕಿ ಇನ ಬೋಲಿವತಾಳಸ್.</para>
  <para style="io1">2. ಅಜು಼ ಇನೆ ಧರ್ಮಶಾಸ್ತ್ರನಿ ಪರಕ್ಮ ಜಿವ್ಣುಕರಾನ ಕೋಶಿಶ್ ಕರ‍್ಯೊ. ಕತೋಬಿ ಯೊ ಫಾಯಿದಾನ ಕೊಆಯುನಿ ಕರಿ ವತಾಳಸ್‍. <char style="ior"><ref loc="GAL 1:6-2:21">1:6—2:21</ref></char></para>
  <para style="io1">3. ಇನಕೇಡೆಥು ಯೊ ಧರ್ಮಶಾಸ್ತ್ರನಿ ಬಾರೇಮ ಅಜು಼ ರಕ್ಷಣೇನು ವಾರ್ಖ್ಹಾನಿ ಬಾರೇಮ ಬೋಲಿವತಾಳಸ್. <char style="ior"><ref loc="GAL 3:1-4:31">3:1—4:31</ref></char></para>
  <para style="io1">4. ಇನಕೇಡೆಥು ಯೊ ಅಛ್ಛು಼ ಕ್ರಿಸ್ತನು ಜಿವ್ಣಮ ಜಿವ್ಣುಕರಾನಖ್ಹಾಜೆ ಥೋಡು ಅಛ್ಛಿ ವಾಟ್ನ ಬೋಲಿ ಓತಾಳಸ್‍. <char style="ior"><ref loc="GAL 5:1-6:10">5:1—6:10</ref></char></para>
  <para style="io1">5. ಪೌಲನೆ ಖ್ಹಲಾಮ್ ಬೋಲ್ತೊಹುಯಿನ್ ಅಜು಼ ಬಹರ್‌ಲಿ ನಿಯಮ್ ಕತೊ ಖ್ಹತ್ನ ಕರಾವನಿತರಾನು ಭಾರ್‌ಲಿ ನಿಯಮ್‌ಥೀಬಿ ದೇವ್‍ಥಿ ಏಕ್‌ ನವ ಅದ್ಮಿ ಕರೀನ್ ಬದಲಾವ್ಣಿ ಹುವಾಸ್ತೆ ಘಣು ಮಹಾನ್‌ಕರಿ ಖ್ಹಯಾಲ್ಮ ರಾಖೊ ಕರಿ ಬಿಂತಿ ಕರ್ತೊಹುಯಿನ್ ಆ ಚಿಟ್ಟಿನ ಖತಮ್ ಕರಸ್. <char style="ior"><ref loc="GAL 6:11-18">6:11-18</ref></char></para>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1"/>ಅದ್ಮಿಖ್ಹಾರಥಿ ರ‍್ಹವೊ ಅದ್ಮಿವ್‌ನ ಅದಿಕಾರ್‌ಥಿ ರ‍್ಹವೊ ಮೋಕ್ಲಾಯೊಕೊಂತೆ ಯೇಸು ಕ್ರಿಸ್ತಥಿಬಿ ಅಜು಼ ಇನ ಮರ‍್ಯಮಾಥು ಉಠಾಡ್ಯೊತೆ ಬಾ ದೇವ್‌ಥಿಬಿ ಅಪೊಸ್ತಲರ್‌ನಕರಿ ಬೋಲೈರ‍್ಹೋತೆ ಪೌಲಕರಿ ಮೇಬಿ, <verse eid="GAL 1:1"/><verse number="2" style="v" sid="GAL 1:2"/>ಅಜು಼ ಮಾರ ಜೋ಼ಡ್ಮ ಛಾ಼ತೆ ಅಖ್ಖಾಸ್ ವಿಶ್ವಾಸಿಯೇಬಿ ಗಲಾತ್ಯಮ ರ‍್ಹವಾನಿ ಸಬೇವ್‌ನ ಲಿಖಾನು ಶಾತ್‌ಕತೊ: <verse eid="GAL 1:2"/><verse number="3" style="v" sid="GAL 1:3"/>ಬಾ ದೇವ್‌ಥಿಬಿ ಅಪ್ಣೊ ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತಥಿಬಿ ತುಮುನ ವಾರ್‌ಖ್ಹೊಬಿ ಶಾಂತಿ ಮಳಾದೆ. <verse eid="GAL 1:3"/><verse number="4" style="v" sid="GAL 1:4"/>ಯೊ ಅಪ್ಣುನ ಹಮ್ಕೇನ ಖರಾಬ್ ಹಗಾಮ್‌ಥು ಛೋ಼ಡಾವ್ಣುಕರಿ ಅಪ್ಣೊ ಬಾ ಅಜು಼ ದೇವ್ನಿ ಖ್ಹೂಜ಼್‌ನಿ ಘೋಣಿ ಅಪ್ಣ ಪಾಪ್ನಖ್ಹಾಜೆ ಇನುಯೋಸ್ ಮರಣ್ಣ ದಿನಾಖ್ಯೊ. <verse eid="GAL 1:4"/><verse number="5" style="v" sid="GAL 1:5"/>ದೇವ್ನ ಜ಼ಗ್‌ಜ಼ಮಾನಮಾಬಿ ಮಹಿಮೆಹುವಾದೆ. ಆಮೆನ್.<verse eid="GAL 1:5"/></para>
  <para style="s">ಎಕ್ಕಸ್ ಸುವಾರ್ತೆ</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>ಕ್ರಿಸ್ತನಿ ವಾರ್‌ಖ್ಹೇಥಿ ತುಮುನ ಬುಲಾಯ ಹುಯಾನ ಮ್ಹೇಲಿನ್ ಅತ್ರೆ ವಗ್ಗಿಸ್‌ಮ ಬಿಜೇಕ್ ಸುವಾರ್ತೆನ ತುಮೆ ಸ್ವಿಕಾರ್‌ಕರಾನು ದೇಖಿನ್ ಮನ ಆಶ್ಚರ್ಯ ಹುವಾಸ್. <verse eid="GAL 1:6"/><verse number="7" style="v" sid="GAL 1:7"/>ಬೋಲ್ನುಕತೊ ಸುವಾರ್ತೆ ಬಿಜು಼ ಕೊಯ್ನಿ ಕತೋಬಿ ಥೋಡುಜ಼ಣು ತುಮಾರಮ ಘುಂಜ್ಲಾ಼ವ್ಣಿಕರೀನ್ ಕ್ರಿಸ್ತನಿ ಸುವಾರ್ತೆನ ಬದ್ಲಾವನ ಕೋಶಿಶ್ ಕರುಕರಸ್. <verse eid="GAL 1:7"/><verse number="8" style="v" sid="GAL 1:8"/>ಕತೋಬಿ ಹಮೆ ತುಮುನ ಸುವಾರ್ತೆನ ಖ್ಹಮ್‍ಜಾ಼ಡ್ಯ. ಇನಖ್ಹಾಜೆ ಹಮೇಸ್ ರ‍್ಹವೊ, ಸೊರ್ಗಥೊ ಆಯೋತೆ ದೇವ್‌ನೊ ದೂತಾಸ್ ರ‍್ಹವೊ, ಬಿಜೇಕ್ ಸುವಾರ್ತೆನ ಬೋಲಿ ವತಾಳ್ಯುತೊ ಯೊ ಶಾಪ್‌ವಾಳೊ ಹುವಾದೆ. <verse eid="GAL 1:8"/><verse number="9" style="v" sid="GAL 1:9"/>ಮೆ ಪಹಿಲೆಸ್ ಬೋಲ್ಯೊತೆ ತಿಮ್ಮಸ್ ಹಮ್ಕೆಬಿ ಮೆ ಪಾಛು಼ ಬೋಲುಕರುಸ್. ತುಮೆ ಸ್ವೀಕಾರ್ ಕರ‍್ಯಾತೆ ಸುವಾರ್ತೆನ ವಿರೋದ್‌ಥಿ ಕೋಣ್‌ತೋಬಿ ಬೋಲಿವತಾಳ್ಯುತೊ ಯೊ ಶಾಪ್ ಲೀರಾಖವಾಳೊ ಹುಯಿರೊಸ್. <verse eid="GAL 1:9"/><verse number="10" style="v" sid="GAL 1:10"/>ಮೆ ಹಮ್ಕೆ ಖ್ಹಮ್‌ಜಾ಼ಡಿನ್ ಕಿನೊ ದಿಲ್‌ ಜೂತಾನ ಕೋಶಿಶ್ ಕರುಸ್? ಅದ್ಮಿನೋಕಿ? ದೇವ್ನೊಕಿ? ಮೆ ಅದ್ಮಿವ್‌ನ ಪಸಂದ್ ಕರಾವನ ಕೋಶಿಶ್ ಕರುಕರುಸ್ಕಿ? ಮೆ ಬಿಜೂ಼ಬಿ ಅದ್ಮಿವ್‌ನ ಪಸಂದ್ ಕರಾವನ ಕೋಶಿಶ್ ಕರ‍್ಯೊತೊ ಮೇ ಕ್ರಿಸ್ತನೊ ಸೇವಕ್ ಕಾಹೆ.<verse eid="GAL 1:10"/></para>
  <para style="s">ಪೌಲ ಅಪೊಸ್ತಲ ಹುಯೋತೆ ಕಿಮ್</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11"/>ಮೇ ಶಾತ್‌ ಬೋಲುಸ್‌ಕತೊ ಭೈಯೇ ಭೇನೆವೊ ಮೇ ಬೋಲಿವತಾಳ್ಯೋತೆ ಸುವಾರ್ತೆ ಖಲಿ ಅದ್ಮಿಥಿ ಆಯೂತೆ ಕಾಹೆಕರಿ ತುಮೆ ಮಾಲುಮ್‌ಕರಿಲೇವ್ಣು ಕರಿ ಮೇ ಆಖ್ಹ್‌ ಕರುಸ್. <verse eid="GAL 1:11"/><verse number="12" style="v" sid="GAL 1:12"/>ಮೇ ಇನ ಅದ್ಮಿಥಿ ಲಿದೊಕೊಯ್ನಿ, ಮನ ಕೋಣ್ ಭೋಧನ್‌ಬಿ ಕರ‍್ಯುಕೊಯ್ನಿ ಬದಲ್‍ಥಿ ಯೇಸು ಕ್ರಿಸ್ತಾಥೀಸ್ ಯೊ ಮನ ಬೋಲಿವತಾಳಯು. <verse eid="GAL 1:12"/><verse number="13" style="v" sid="GAL 1:13"/>ಅಗ್ಗಳ್ ಮೆ ಯೆಹೂದ್ಯರ್‌ಮ ಮಳಿರ‍್ಹೋಥೋತೆ ತದೆ ಮಾರಿ ಚಾ಼ಲ್ ಕಿಮ್ ಥೀ ಕರಿ ತುಮೆ ಖ್ಹಮ್‌ಜಿರಾಖ್ಯಾಥ. ಮೇ ದೇವ್ನಿ ಸಬೆನ ಗೋರ್‌ಕೊಂತೆ ನಾಶ್‌ಕರ್ತೊಥೊ. <verse eid="GAL 1:13"/><verse number="14" style="v" sid="GAL 1:14"/>ಆನಾಹುಯಿನ್ ಮಾರ ಗುರುಗುರಬ್‌ಲ್ಯನಿ ಪದತ್ತಿಮ ಖ್ಹಾರೇಥಿಬಿ ಮೇಸ್ ಜಾ಼ಖ್ಹತ್ ದಿಲ್‌ಲಗಾಡವಾಳೊ ಹುಯಿರ‍್ಹೋಥೊ. ಅಜು಼ ಮಾರಿ ಜೋ಼ಡ್ನ ಯೆಹೂದ್ಯರ್ ಉಂಬರ್‌ವಾಳಾಥಿಬಿ ಮೇಸ್ ಖ್ಹಾಮ್ಣೆ ರ‍್ಹೇತೊಥೊ. <verse eid="GAL 1:14"/><verse number="15" style="v" sid="GAL 1:15"/>ಕತೋಬಿ ದೇವ್ ಮೇ ಆಯಾನಿ ಪೇಟ್‌ಮ ರ‍್ಹವಾನಿವಖ್ಹ್‌ತೆಸ್ ಮಾರಿ ಬಾರೇಮ ವಿಶೇಷ್ ವಾರ್‌ಖ್ಹೇಥಿ ಚೂ಼ಣಿನ್, ಇನ ಛಿಯ್ಯಾನಸ್ ಪಸಂದ್ ಕರ‍್ಯೊ. <verse eid="GAL 1:15"/><verse number="16" style="v" sid="GAL 1:16"/>ಅಮ್ ಮೇ ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ಅದ್ಮಿವ್‌ನ ಇನಿ ಛಿಯ್ಯಾನಿ ಬಾರೇಮ ಸುವಾರ್ತೆನ ಖ್ಹಮ್‌ಜಾ಼ಡ್ನುಕರಿ ದೇವ್ನಿ ಮರ್ಜಿ ಹುಯಿರ‍್ಹೀಥಿ. ಇನಖ್ಹಾಜೆ ದೇವ್ನೆ ಇನ ಛಿಯ್ಯಾನ ಮನ ವತಾಳ್ಯೊ. ಯೊ ಮನ ಬುಲಾವಖ್ಹತರ್ ಮೆ ಅದ್ಮಿಯೇವ್‌ನಿ ಖ್ಹೂಜ಼್‌ನ ಫುಛಾ಼ಯೊ ಕೊಯ್ನಿ. <verse eid="GAL 1:16"/><verse number="17" style="v" sid="GAL 1:17"/>ಯೆರೂಸಲೇಮ್ಮ ಮಾರೇಥಿಬಿ ಪಹಿಲೆ ಅಪೊಸ್ತಲರ್ ಹುಯಿರ‍್ಹುಥೂತೆ ಇವ್ಣಕನಾಬಿ ಕೊಗಯೊಂತೆ ಅರಬ್ ದೇಖ್ಹ್‌ನ ಜೈ಼ನ್ ಪಾಛು಼ ದಮಸ್ಕ ಖ್ಹಯೇರ್‌ಮ ಮೆ ಆಯೊ. <verse eid="GAL 1:17"/><verse number="18" style="v" sid="GAL 1:18"/>ತೀನ್ ವರಖ್ಹ್‌ನ ವಾರ್ ಕೇಫಥಿ ಮಳ್‌ಣುಕರಿ ಯೆರೂಸಲೇಮ್‌ ಗಯೊ. ಇನ ಜೋ಼ಡ್ಮ ಪಂಧ್ರ ದನ್‌ಲಗು ಥೊ. <verse eid="GAL 1:18"/><verse number="19" style="v" sid="GAL 1:19"/>ಕತೋಬಿ ಪ್ರಭುನೊ ಭೈಹುಯಿರ‍್ಹಾವಳೊ ಯಾಕೋಬ್ ಕಾಹೆತೆ ಅಪೊಸ್ತಲರ್‌ಮ ಬಿಜು಼ ಕಿನಾಬಿ ಕೊ ದೇಖ್ಯೋನಿ. <verse eid="GAL 1:19"/><verse number="20" style="v" sid="GAL 1:20"/>ಮೇ ತುಮುನ ಲೀಖುಕರುತೆ‍ ವಾತೆಅಖ್ಖು ಝೂ಼ಟು ಕಾಹೆಕರಿ ದೇವ್ನಾಸ್ ಮಾಲುಮ್. <verse eid="GAL 1:20"/><verse number="21" style="v" sid="GAL 1:21"/>ಇನಕೇಡೆಥು ಸಿರಿಯ ಅಜು಼ ಕಿಲಿಕ್ಯ ದೇಖ್ಹ್‌ನ ತಬರ್‌ಖಾಮ ಗಯೊ. <verse eid="GAL 1:21"/><verse number="22" style="v" sid="GAL 1:22"/>ಕತೋಬಿ ಕ್ರಿಸ್ತಮಾನು ಯೂದಾಯನು ಸಬೆವಾಳು ಮನ ಬಿಜು಼ ಅಗ್ಗಳ್ ಕೆದೇಬಿ ಮಳಿರ‍್ಹುಥು ಕೊಯ್ನಿ. <verse eid="GAL 1:22"/><verse number="23" style="v" sid="GAL 1:23"/>ಕತೋಬಿ “ಇವ್ಣೆ ಪಹಿಲೇಸ್ ಏಕ್‌ಹಲ್ಲ ಖ್ಹತಾಪ್ಣಿ ದಿದೊಥೋತೆ ಕತೋಬಿ ಯೊ ನಾಶ್‌ ಕರ್ತೊಥೋತೆ ವಿಶ್ವಾಸ್‌ನಿ ಬಾರೇಮಸ್ ಹಮ್ಕೆ ಅದ್ಮಿಖ್ಹಾರನ ಬೋಲಿವತಾಳುಕರಾಸ್‌” ಕರಿ ಸಮಾಚಾರ‍್ನ ಇವ್ಣೆ ಖ್ಹಮ್‌ಜ್ಯು. <verse eid="GAL 1:23"/><verse number="24" style="v" sid="GAL 1:24"/>ಅಜು಼ ಮಾರಖ್ಹಾಜೆ ದೇವ್ನ ಮಹಿಮೆ ಕರ‍್ಯು.<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s">ಪೌಲ ಅಜು಼ ಬಿಜು಼ಖ್ಹಾರ ಅಪೊಸ್ತಲರ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>ಚೌ಼ಧ ವರಖ್ಹ್‌ನ ವಾರ್ ಮೆ ಬಾರ್ನಬನಿ ಜೋ಼ಡ್ಮ ತೀತನಬಿ ಬುಲೈಲಿನ್, ಬಿಜೇಕ್ ಹಲ್ಲ ಯೆರೂಸಲೇಮ್ನ ಗಯೊ. <verse eid="GAL 2:1"/><verse number="2" style="v" sid="GAL 2:2"/>ದೇವ್ನಿ ಖ್ಹೂಜ಼್‌ನಿತರ ಜಾ಼ವ್ಣುಥೂತೆ ಇನಖ್ಹಾಜೆ ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ಅದ್ಮಿಮ ಮೆ ಬೋಲಿವತಾಳನು ಸುವಾರ್ತೆ ಶಾತ್‌ಕರಿ ಹಿಜ಼್ಜಾಥೂತೆ ಗಲ್‌ಢಾವ್‌ನಾಸ್ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ. ಶನಕತೊ ಮೆ ಸುವಾರ್ತೆನಖ್ಹಾಜೆ ಪಡ್ಯೋತೆ ಕಾಮ್‍ರ‍್ಹೆವೊ, ಮೇ ಹಮ್ಕೆ ಕರುಕರುಸ್ತೆ ಕಾಮ್‌ಖ್ಹಾರು ಬಿಣ್‌ಫಾಯಿದಾನು ನಾಹೊಣುಕರಿ ಮಾರಿ ಆಖ್ಹ್. <verse eid="GAL 2:2"/><verse number="3" style="v" sid="GAL 2:3"/>ಮಾರ ಜೋ಼ಡ್ಮಥೋತೆ ತೀತ ಗ್ರೀಕ್‌ನೊ ಹುಯಿರೊತೋಬಿ ಇನ ಖ್ಹತ್ನಕರಾವ್ಣುಕರಿ ಕೋಣ್‌ಬಿ ಜು಼ಲಮ್‌ ಕೊಕರ‍್ಯುನಿ. <verse eid="GAL 2:3"/><verse number="4" style="v" sid="GAL 2:4"/>ಕತೋಬಿ ಭಾಣೇಥಿ ಪೇಠುಥೂತೆ ವಿಶ್ವಾಸಿಖ್ಹಾರು ಗಪ್ಲಥ್ಥಿ ಹಮುನ ಧರ್ಮಶಾಸ್ತ್ರನಿ ಕಬ್‌ಜಾ಼ಮ ಖ್ಹಪ್‌ಡಾವ್ಣುಕರಿ, ಕ್ರಿಸ್ತ ಯೇಸುಮ ಛಾ಼ತೆ ಅಪ್ಣಿ ಛುಟ್ಕಾರ್‌ನ ಮಾಲುಮ್‌ಕೊಂತೆ ತಿಮ್ ಪುಛಾ಼ವನ ಐರ‍್ಹುಥು. <verse eid="GAL 2:4"/><verse number="5" style="v" sid="GAL 2:5"/>ಸುವಾರ್ತೆನು ಖ್ಹಾಚು಼ ತುಮಾರಮ ಘಟ್ ರ‍್ಹೇವ್ಣುಕರಿ ಹಮೆ ಇವ್ಣಿ ಅಧೀನ್‌ಮ ಏಕ್‌ ಘಡೀಬಿ ಕೊದಿದಾನಿ. <verse eid="GAL 2:5"/><verse number="6" style="v" sid="GAL 2:6"/>ಕತೋಬಿ ಕೋಣ್ ಗಲ್‌ಢಕರಿ ದೆಖಾವಸ್ಕಿ ಮೇ ಬೋಲುಸ್ ಆ ಮಾರಮ ಅಜು಼ ಇವ್ಣಾಮ ಅನು ಫರಕ್ ಕೊಯ್ನಿ; ದೇವ್ ಅಖ್ಖಾ ಅದ್ಮಿವ್‌ನ ಎಕ್ಕಸ್ ತರ ದೇಖಸ್. ಯೊ ಗ‌ಲ್‌ಢಾವ್‌ಥಿ ಮನ ಶಾತ್ಬಿ ಮಳ್ಯು ಕೊಯ್ನಿ.<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt"><ref loc="DEU 10:17">ಧರ್ಮೊ 10:17</ref></char></note> <verse eid="GAL 2:6"/><verse number="7" style="v" sid="GAL 2:7"/>ಕತೋಬಿ ಖ್ಹತ್ನಕರೈಲ್ಯವಾಳಾನ ಸುವಾರ್ತೆನ ಬೋಲಿ ವತಾಳನು ಕಾಮ್ ಪೇತ್ರಾನ ಕಿಮ್ ದೆವಾಯುಕಿ, ಇಮ್ಮಸ್ ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ಅದ್ಮಿನ ಯೊ ಬೋಲಿ ವತಾಳನು ಕಾಮ್ ಮನ ದೆವಾಯು. <verse eid="GAL 2:7"/><verse number="8" style="v" sid="GAL 2:8"/>ಶನಕತೊ ಯೆಹೂದ್ಯರ್‌ಮ ಅಪೊಸ್ತಲಹುಯಿನ್ ಕಾಮ್ ಕರಾನ ಪೇತ್ರಾನ ದಿದೋತೆ ದೇವ್, ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ಇವ್ಣಾಮ ಅನ ಚ಼ಲಾವನಖ್ಹಾಜೆ ಮನ ದಿರಾಖ್ಯೊಥೊ. <verse eid="GAL 2:8"/><verse number="9" style="v" sid="GAL 2:9"/>ಸಬೇನು ಖಂಬುಕರಿ ಬೋಲೈಲಿದಹುಯ ಯಾಕೋಬ್, ಪೇತ್ರ, ಯೋಹಾನ ಇವ್ಣೆ ದೇವ್ನೆ ಮನ ದಿರಾಖ್ಯೋತೆ ವಾರ್‌ಖ್ಹಾನ ಮಾಲುಮ್ ಕರಿಲಿನ್ ಗಳ್‍ಜೋ಼ಡ್‍ಥಿ ರ‍್ಹವಾನು ವತಾಳನಖ್ಹಾಜೆ ಮನಾಬಿ ಬಾರ್ನಬನಾಬಿ ಹಾತ್ ಮಳಾಯೊ. ಅಜು಼ ತುಮೆ ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ಅದ್ಮಿಕನ ಜಾ಼ವೊ, ಹಮೆ ಯೆಹೂದ್ಯರ್‌ಕನ ಜೈ಼ಯೇಸ್‌ಕರಿ ಮಾನಿಲಿದ. <verse eid="GAL 2:9"/><verse number="10" style="v" sid="GAL 2:10"/>ಕತೋಬಿ ತುಮೆ ಹಮಾರಮ ಛಾ಼ತೆ ದಿಕ್‌ದೆಶಾರ್‌ ಕೊಂತೆ ಇವ್ಣುನ ಖ್ಹಯಾಲ್ಮ ರಾಕ್ಣು ಕರಿ ಎಕ್ಕಸ್ ವಾತೆ ಮನ ಬೋಲ್ಯು. ಇಮ್‌ ಕರಾಮ ಮೇಬಿ ದಿಲ್‌ಲಗಾಡವಾಳೊ ಹುಯಿರ‍್ಹೊಥೊ.<verse eid="GAL 2:10"/></para>
  <para style="s">ಪೌಲನೆ ಅಂತಿಯೋಕ್ಯಮ ಪೇತ್ರನ ಘುರ್ಕಾಯೊತೆ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>ಪೇತ್ರನೆ ಅಂತಿಯೋಕ್ಯನ ಆವಾನಿ ವಖ್ಹ್‌ತೆ ಇನಾಮ ಗಲ್ತಿದೆಖಾಯುತೆ ಇನಖ್ಹಾಜೆ ಮೇ ಇನ ಖ್ಹಾರನ ಖ್ಹಾಮೇಸ್ ವಿರೋದ್ ಕರ‍್ಯೊ. <verse eid="GAL 2:11"/><verse number="12" style="v" sid="GAL 2:12"/>ಅಗ್ಗಳ್ ಯೊ ಅಂತಿಯೋಕ್ಯನ ಆವಾನಿ ವಖ್ಹ್‌ತೆ ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ಇವ್ಣ ಜೋ಼ಡ್ಮ ಖಾಣು ಖಾತೋಥೊ. ಇನಪಾರ್ ಯಾಕೋಬ್ ಭಣೀಥು ಥೋಡುಜ಼ಣು ಆಯು. ತದೆ ಪೇತ್ರನೆ ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ಇವ್ಣಿ ಜೋ಼ಡ್ಮ ಖಾಣುಖಾವನು ಭಿರಾಖಿದಿದೊ. ಯೆಹೂದ್ಯರ್ ಅದ್ಮಿಥಿ ಡರಿನ್, ಯೊ ಇನುಯೋಸ್ ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ಅದ್ಮಿಥಿ ಅಲಕ್ ಹುಯೊ.<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt"><ref loc="ACT 11:28-12:1">ಅಪೊ 11:28—12:1-3</ref></char></note> <verse eid="GAL 2:12"/><verse number="13" style="v" sid="GAL 2:13"/>ಅತ್ರೇಸ್ ಕಾಹೆತೆ ಥೂತೆ ಯೆಹೂದ್ಯರ್‌ಬಿ ಇನಜೋ಼ಡೆ ಮಳಿನ್ ಇಮ್ಮಸ್ ಢಂಗ್ ಕರ‍್ಯು. ತದೆ ಬಾರ್ನಬಬಿ ಇವ್ಣಿ ಢಂಗ್ಮ ಪಡಿಗೊ. <verse eid="GAL 2:13"/><verse number="14" style="v" sid="GAL 2:14"/>ಇವ್ಣೆ ಸುವಾರ್ತೆನಿ ಖ್ಹಾಚಿ ತರೀಖಾಮ ಬರೋಬರ್‌ಥಿ ಚಾ಼ಲುಕರ ಕೊಯ್ನಿಕರಿ ಬೋಲಾನು ಮನ ದೆಖಾವಮ ಅಖ್ಖಾನ ಖ್ಹಾಮ್ಣೆ ಪೇತ್ರನ ಶಾತ್‌ ಬೋಲ್ಯೊಕತೊ; ತು ಏಕ್‌ ಯೆಹೂದ್ಯವಾಳೊ‍ರ‍್ಹೀನ್ ಯೆಹೂದ್ಯರ್‌ಕಾಹೆನಿತರ ಬಚಿನ್, ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ಇವ್ಣುನ ಯೆಹೂದ್ಯರ್‌ನಿಘೋಣಿ ಚಾ಼ಲ್‌ನುಕರಿ ಜು಼ಲಮ್‍ಕರಿ ಬೋಲಾನುಬಿ ಶಾತ್?<verse eid="GAL 2:14"/></para>
  <para style="s">ಯೆಹೂದ್ಯರ್‌ಬಿ ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ಇವ್ಣುನ ವಿಶ್ವಾಸ್‍ಥಿ ರಕ್ಷಣೆ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>ಹಮೆತೋಬಿ ಪೈದಾಖ್ಹ್‌ಥು ಯೆಹೂದ್ಯರ್, ಪಾಪಿಕರಿ ಬೋಲೈಲಿದೂತೆ ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ಅದ್ಮಿಕಾಹೆ. <verse eid="GAL 2:15"/><verse number="16" style="v" sid="GAL 2:16"/>ಖಿವೊತೋಬಿ ಖಲಿ ಧರ್ಮಶಾಸ್ತ್ರನ ಪಾಡಿಚಾ಼ಲಾಥಿ ನೀತಿವಾಳೊಕರಿ ಬಣಾನ ಕೊಹುವ್ವಾನಿ ಕರಿ ಮನ ಮಾಲುಮ್. ಯೇಸು ಕ್ರಿಸ್ತಮ ವಿಶ್ವಾಸ್ ರಾಖಾಥೀಸ್ ನೀತಿವಾಳೊ ಬಣಾನ ಹುವಾಸ್. ಇನಖ್ಹಾಜೆ ಹಮೆ ನೀತಿವಾಳ ಹುವಾನಖ್ಹಾಜೆ ಯೇಸು ಕ್ರಿಸ್ತಾಮಸ್ ವಿಶ್ವಾಸ್ ರಾಖ್ಯ. ಅಮ್‌ರ‍್ಹಾವಪರ್ ಹಮೆ ನೀತಿವಾಳ ಹುಯಾತೆ ಕ್ರಿಸ್ತಮ ವಿಶ್ವಾಸ್ ರಾಖಿನಸ್ ಪಣ್ಕಿ ಧರ್ಮಶಾಸ್ತ್ರನಿಘೊಣಿ ಚಾ಼ಲಾಥಿ ಕಾಹೆ. <verse eid="GAL 2:16"/><verse number="17" style="v" sid="GAL 2:17"/>ಕತೋಬಿ ಅಪ್ಣೆ ಯೇಸು ಕ್ರಿಸ್ತಥಿ ನೀತಿವಾಳ ಕರಿ ತೀರ್ಮಾನ್ ಹುವಾನಿ ಕೋಶಿಶ್ಮ ಅಪ್ಣೆ ಪಾಪಿಕರಿ ದೆಖಾಯತೊ ಕ್ರಿಸ್ತ ಪಾಪ್ನ ಮದತ್‌ಕರಾವಾಳೊ ಕಿಶು? ಕೆದೇಬಿ ಕೊಯ್ನಿ. <verse eid="GAL 2:17"/><verse number="18" style="v" sid="GAL 2:18"/>ಮೇ ರಡ್ಕಾಯ ಹುಯಾನಸ್ ಪಾಛು಼ ಭಾಂದ್ಯೊತೊ ಮಾರುಮೇಸ್ ಅಪರಾದಿಕರಿ ದೆಖೈಜಿಷ್ನಿ. <verse eid="GAL 2:18"/><verse number="19" style="v" sid="GAL 2:19"/>ಮೇತೋಬಿ ದೇವ್ನಖ್ಹಾಜೆ ಬಚಿರ‍್ಹಾವನಖ್ಹಾಜೆ ಧರ್ಮಶಾಸ್ತ್ರಮಾಥೊ ಧರ್ಮಶಾಸ್ತ್ರನ ಭಾಗ್ನ ಮರ‍್ಯೊಹುಯೊ ಹುಯಿರೊಸ್. ಇನಖ್ಹಾಜೆ ಮೇ ಜಿನು ಕ್ರಿಸ್ತಾನಿಜೋ಼ಡ್ಮ ಶಿಲ್‌ಬೆಪರ್ ಘಲೈಗಯೊ ಹುಯೊ ಹುಯಿರೊಸ್. <verse eid="GAL 2:19"/><verse number="20" style="v" sid="GAL 2:20"/>ಅಜು಼ ಜಿವ್‌ಕರೂಸ್ತೆ ಮೇಕಾಹೆ, ಕತೋಬಿ ಕ್ರಿಸ್ತ ಮಾರಮಹಿ ಜಿವವಾಳೊ ಹುಯಿರೊಸ್. ಹಮ್ಕೆ ಮೆ ಶರೀರ್‌ಮ ಜಿವ್ಣುಕರಾನು ಕಿಮ್ ಕತೊ ದೇವ್ನ ಛಿಯ್ಯಾಪರ‍್ಲಿ ವಿಶ್ವಾಸ್‌ಥೀಸ್. ಯೋ ಮನ ಪ್ಯಾರ್ ಕರೀನ್ ಮಾರ ಖ್ಹಾಜೇಥಿ ಇನಾಸ್ ದಿನಾಖಿದಿದೊ. <verse eid="GAL 2:20"/><verse number="21" style="v" sid="GAL 2:21"/>ಮೇ ದೇವ್ನ ವಾರ್‌ಖ್ಹೊನ ಝಿಟ್ಕಾರುಕೊಯ್ನಿ. ಕತೋಬಿ ಧರ್ಮಶಾಸ್ತ್ರಥಿ ನೀತಿವಾಳ ಹುಯೆಜಾ಼ಯ್‌ ಕತೊ ಕ್ರಿಸ್ತನು ಮರಾನು, ಫಾಯಿದೊಸ್ ಕೊಯ್ನಿಕರಿ ಬೋಲೆಜಾ಼ಯ್.<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s">ವಿಶ್ವಾಸ್‌ಕಿ ನತರ್ ಧರ್ಮಶಾಸ್ತ್ರ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>ಅಲ ಅಕ್ಕಲ್‌ಕೊಂತೆ ಗಲಾತ್ಯವಾಳ, ತುಮುನ ಮಂಕ್ ‌ಕೋಣ್‌ಕರ‍್ಯು? ಯೇಸು ಕ್ರಿಸ್ತ ಶಿಲ್‌ಬೇಪರ್ ಜಾನ್‌ಮ್ಹೆಲ್ಯೊತೆ ಯೊ ತುಮಾರ ಡೋಳಾನ ಖ್ಹಾಮ್ಣೆ ಛೋ಼ಡಿವತಾಳ್ಯುನಿ! <verse eid="GAL 3:1"/><verse number="2" style="v" sid="GAL 3:2"/>ಏಕ್‌ ಬಾರೇಮ ಖಲಿ ತುಮಾರೇಥಿ ಮಾಲುಮ್ ಕರ್ನುಕರಿ ಛು಼. ತುಮೆ ಪವಿತ್ರಾತ್ಮನ ಲಿದಾತೆ ಧರ್ಮಶಾಸ್ತ್ರನ ಪಾಡಿನ್ ಚಾ಼ಲಾಥಿಕಿ ನತರ್ ವಿಶ್ವಾಸ್‌ನಿ ಸುವಾರ್ತೆನ ಖ್ಹಮ್‌ಜಾ಼ಥಿಕಿ ಶು? <verse eid="GAL 3:2"/><verse number="3" style="v" sid="GAL 3:3"/>ತುಮುನ ಅತ್ರೇಬಿ ಅಕ್ಕಲ್ ಕೊಯ್ನಿಕಿಶು? ದೇವ್ನಿ ಆತ್ಮಾನಿ ಪರಕ್ಮ ಶುರುಕರೀನ್ ಹಮ್ಕೆ ಶರೀರ್‌ನಿ ಬಾರೇಮ ಖತಮ್ ಕರಾನ ಆಯಕಿಶು? <verse eid="GAL 3:3"/><verse number="4" style="v" sid="GAL 3:4"/>ತುಮೆ ಅತ್ರೆಖ್ಹಾರು ಶಿಕ್ಯಾತೆ ಅಖ್ಖು ಕಾಯಿಸ್‌ಕೊಯ್ನಿಕರಿ ಬೋಲಿಯೆಕಿಶು? <verse eid="GAL 3:4"/><verse number="5" style="v" sid="GAL 3:5"/>ಅಮ್‌ರ‍್ಹಯುತೊ ದೇವ್ನೆ ಇನ ಆತ್ಮಾನ ತುಮುನ ಜಾ಼ಖ್ಹಥ್ಥಿ ದೀನ್ ತುಮಾರಮ ಮಹಾನ್‌ಕಾಮ್ ಚ಼ಲಾವ್ತೊ ಆಯೋತೆ; ತುಮೆ ಧರ್ಮಶಾಸ್ತ್ರನ ಪಾಡಿನ್ ಚಾ಼ಲಾಥಿಕಿ ನತರ್ ಸುವಾರ್ತೆನ ಖ್ಹಮ್‌ಜಿನ್‌ ವಿಶ್ವಾಸ್ ಕರಾಥಿ? <verse eid="GAL 3:5"/><verse number="6" style="v" sid="GAL 3:6"/>“ಅಬ್ರಹಾಮ್‌ನೆ ದೇವ್ನ ವಿಶ್ವಾಸ್ ಕರ‍್ಯೊ, ಇನಿ ವಿಶ್ವಾಸ್‌ಥೀಸ್ ಯೋ ವಿಶ್ವಾಸ್‌ ನೀತಿಕರಿ ಚೂ಼ಣೈಗು ಕರಿ ಧರ್ಮಶಾಸ್ತ್ರಮ ಬೋಲಸ್ನಿ.”<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt"><ref loc="GEN 15:6">ಆದಿಕಾಂಡ 15:6</ref></char></note> <verse eid="GAL 3:6"/><verse number="7" style="v" sid="GAL 3:7"/>ಇನಖ್ಹಾಜೆ ವಿಶ್ವಾಸ್‌ಕರವಾಳ ಅಬ್ರಹಾಮ್‌ನ ಪಿಳ್ಗಿಕರಿ ಮಾಲುಮ್ ಕರಿಲೆವೊ. <verse eid="GAL 3:7"/><verse number="8" style="v" sid="GAL 3:8"/>ದೇವ್ನೆ ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ಅದ್ಮಿನ ವಿಶ್ವಾಸ್‌ನ ಖ್ಹಾಜೇಥಿಸ್ ನೀತಿವಾಳಕರಿ ಸಾಬಿತ್‌ಕರಾನು ದೇವ್ನಿ ವಚನ್ನ ಪಹಿಲೇಸ್ ದೇಖಿನ್ ಅಬ್ರಹಾಮ್‌ನ, “ತಾರೇಥಿ ಜ಼ಗ್‌ಜಾ಼ತ್‌ನಾಬಿ ಆಶೀರ್ವಾದ್‌ ಉಷೆ”<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt"><ref loc="GEN 12:3">ಆದಿಕಾಂಡ 12:3</ref></char></note> ಕರಿ ಸುವಾರ್ತೆನ ಅಗ್ಗಳ್‌ಥೂಸ್ ಬೋಲಾಯು. <verse eid="GAL 3:8"/><verse number="9" style="v" sid="GAL 3:9"/>ಅಮ್‌ರ‍್ಹವಾಪರ್ ಕೋಣ್ ಕ್ರಿಸ್ತಾನ ನಂಬಾಸ್ಕಿ, ಇವ್ಣೆ ವಿಶ್ವಾಸ್‌ ರಾಖಿಮ್ಹೇಲ್ಯೊತೆ ಅಬ್ರಹಾಮ್‌ನ ಜೋ಼ಡೆ ಆಶೀರ್ವಾದ್‌ ಲಿಶೆ. <verse eid="GAL 3:9"/><verse number="10" style="v" sid="GAL 3:10"/>ಮೋಶೆನಿ ರೀತಿರಿವಾಜ್‌ಥಿ ಚಾ಼ಲವಾಳು ಶಾಪ್ ಲೀರಾಖವಾಳು ಹುಯಿರ‍್ಹುಸ್. ಕಿಮ್‌ಕತೊ ಧರ್ಮಶಾಸ್ತ್ರನ ನಿಯಮ್ಮ “ಲೀಖೈರ‍್ಹೂಸ್ತೆ ಅಖ್ಖಾಸ್ನ ಪಾಡಿನ್ ದನ್‌ಪರ್‌ರೋಜ಼್ ಕೋಚಾ಼ಲನಿತೆ ಹರೇಕ್ ಜ಼ಣು ಶಾಪ್‌ವಾಳೊ ಹುಯಿರ‍್ಹೊಸ್”<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt"><ref loc="DEU 27:26">ಧರ್ಮೊ 27:26</ref></char></note> ಕರಿ ಪವಿತ್ರ ಪುಸ್ತಕ್‌ಮ ಲಿಖೈರ‍್ಹುಸ್. <verse eid="GAL 3:10"/><verse number="11" style="v" sid="GAL 3:11"/>ಅತ್ರೇಸ್‍ಕಾಹೆತೆ ಧರ್ಮಶಾಸ್ತ್ರಥಿ ಕೋಣ್‌ಬಿ ದೇವ್ನಿ ಝ಼ಗೋಮ ನೀತಿವಾಳೊ ಕೊ ಉಷೇನಿಕರಿ ದೆಖಾವಸ್, ಶನಕತೊ ನೀತಿವಾಳೊ ವಿಶ್ವಾಸ್‌ಥೀಸ್ ಜಿವ್‌ಶೆ ಕರಿ ಬೋಲೈರ‍್ಹುಸ್. <verse eid="GAL 3:11"/><verse number="12" style="v" sid="GAL 3:12"/>ಕತೋಬಿ ಧರ್ಮಶಾಸ್ತ್ರ ವಿಶ್ವಾಸ್‌ಪರ್ ಆಧಾರ್‌ಕೊಯ್ನಿ, ಇನ ಬದಲ್, “ಧರ್ಮಶಾಸ್ತ್ರನ ಪಾಡಿಚಾ಼ಲವಾಳೊ ಯೋ ಇನೇಥಿಸ್ ಜಿವ್‌ಶೆ”<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt"><ref loc="LEV 18:5">ಯಾಜಕ 18:5</ref></char></note> ಕರಿ ಲೀಖೈರ‍್ಹುಸ್. <verse eid="GAL 3:12"/><verse number="13" style="v" sid="GAL 3:13"/>ಯೇಸು ಕ್ರಿಸ್ತ ಅಪ್ಣುನ ಶಾಪ್‌ಥು ಛೋ಼ಡಾವನ ಇನುಯೋಸ್ ಶಾಪ್‌ವಾಳೊ ಹುಯಿಗೊ. ಶನಕತೊ ಮೋಶೇನು ಧರ್ಮಶಾಸ್ತ್ರಮ ಬೋಲಸ್ತೆ ಪರಕ್ಮ “ಖಂಬಾಪರ್‌ ಠಂಗಾಯುಹುಯು ಹರೇಕ್‍ಜ಼ಣು ಶಾಪ್‌ವಾಳು ಹುಯಿರ‍್ಹುಸ್”<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt"><ref loc="DEU 21:23">ಧರ್ಮೊ 21:23</ref></char></note> ಕರಿ ಲೀಖೈರ‍್ಹುಸ್. <verse eid="GAL 3:13"/><verse number="14" style="v" sid="GAL 3:14"/>ಅನೇಥಿ ಅಬ್ರಹಾಮ್‌ನ ಹುಯೂತೆ ಆಶೀರ್ವಾದ್‌ ಯೇಸುಥಿ ಯೆಹೂದ್ಯರ್‌ಕಾಹೆತೆ ಅದ್ಮಿವ್‌ನ ಮಳಾನಿಘೊಣಿ ಹೋಣುಕರಿ ಅಮ್ ವಿಶ್ವಾಸ್‌ನಿ ಬಾರೇಥಿ ದೇವ್‍ಥಿ ವಾಗ್ದಾನ್ ಹುಯೂತೆ ಪವಿತ್ರಾತ್ಮ ಅಪ್ಣುನ ಮಳಾನಿತರ ಹುಯು.<verse eid="GAL 3:14"/></para>
  <para style="s">ಧರ್ಮಶಾಸ್ತ್ರಬಿ ವಾಗ್ದಾನ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>ಭೈಯೇ ಭೇನೆವೊ, ದನ್‌ರೋಜ಼್‌ನ ಜಿವ್ಣಾಥು ಏಕ್‌ ಮತ್ಲಬ್ ತುಮುನ ಬೋಲುಸ್, ಏಕ್‍ಜ಼ಣೊ ಬಿಜೇಕ್‌ ಜ಼ಣಾಥಿ ಒಪ್ಪಂದ ಕರಿರಾಖಸ್. ಇನ ಬರೊಬ್ಬರ್‌ಥಿ ಕರೀನ್ ಖತಮ್ ಕರಾಪರ್ ಇನ ಕೋಣ್‌ಬಿ ಕಾಡಖ್ಹರ್ಕು ಕೊಯ್ನಿ, ಮಳಾವಖ್ಹರ್ಕೂಬಿ ಕೊಯ್ನಿ. <verse eid="GAL 3:15"/><verse number="16" style="v" sid="GAL 3:16"/>ಇಮ್ಮಸ್ ದೇವ್ನೆ ಅಬ್ರಹಾಮ್‌ನಾಬಿ ಇನಿ ಪಿಳ್ಗಿನಾಬಿ ವಾಗ್ದಾನ್‌ ಕರ‍್ಯೊ. ಕತೋಬಿ ಯೋ ಖೂಮ್ಮ ರ‍್ಹವಾಳ ಅಖ್ಖಾಸ್ನ ಬೋಲ್ಯೊಕೊಂತೆ ಅಬ್ರಹಾಮ್‌ನು ಪಿಳ್ಗಿನ ಛಾ಼ತೆ ಎಕ್ಕಸ್ ಜ಼ಣಾನ ವತಾಳಸ್‍. ಯೋ ಏಕ್‌ ಜ಼ಣೋಸ್ ಯೇಸು ಕ್ರಿಸ್ತ. <verse eid="GAL 3:16"/><verse number="17" style="v" sid="GAL 3:17"/>ಮೇ ಶಾತ್‌ ಬೋಲಾನ ಆಖ್ಹ್‌ಕರುಸ್ ಕತೊ ದೇವ್ನೆ ಅಬ್ರಹಾಮ್‌ನ ಜೋ಼ಡ್ಮ ಪಹಿಲೆ ಕರೀನ್ ಖತಮ್ ಕರ‍್ಯೊಥೋತೆ ಒಪ್ಪಂದಾನ ಚಾರ್‌ಖ್ಹೊ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್‌ನ ವಾರ್ ಆಯೋತೆ ಮೋಶೆನಿ ಧರ್ಮಶಾಸ್ತ್ರನ ತೋಡಿನ್ ಯೋ ವಾಗ್ದಾನ್ನ ನಾ ರ‍್ಹೇವ್ಣುತೆ ತಿಮ್ ಕರಾನ ಕೋ ಉಶೇನಿ.<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt"><ref loc="EXO 12:40">ವಿಮೋಚನ 12:40</ref></char></note> <verse eid="GAL 3:17"/><verse number="18" style="v" sid="GAL 3:18"/>ಶನಕತೊ ಏಕ್‌ಬಾರ್ ದೇವ್ನು ಇನಾಮ್ ಧರ್ಮಶಾಸ್ತ್ರಥಿ ಮಳಾನು ರ‍್ಹಯೂತೊ, ಯೊ ದೇವ್ನಿ ವಾಗ್ದಾನ್‌ಥಿ ಮಳ್‌ಶೆ ಕೊಯ್ನಿಕರಿ ಹುಯಿಗು. ಕತೋಬಿ ದೇವ್ನೆ ಅಬ್ರಹಾಮ್‌ನ ದಿದೊತೆ ಇನ ವಾಗ್ದಾನ್‌ಖ್ಹಾಜೆಥಿ ಯೊ ಇನಾಮ್ನ ದಿರಾಖ್ಯೊಥೊ. <verse eid="GAL 3:18"/><verse number="19" style="v" sid="GAL 3:19"/>ಇಮ್‍ಕತೊ ಮೋಶೇನು ನಿಯಮ್‌ ಶನಖ್ಹಾಜೆ? ವಾಗ್ದಾನ್‌ಮ ವತಾಳಿರಾಖ್ಯೊತೆ ಯೊ ಆವಲಗು ದೇವ್ ಅಥ್ರಅಥ್ರಾನು ಅಪರಾದ್‌ಕರಿ ದೆಖಾಡನ ಖ್ಹಾಜೇಥಿ ಇನ ವಾಗ್ದಾನ್ ಹುಯುತದೆ ದೇವ್‌ದೂತರ್‌ಥಿ ಏಕ್‌ ಇಚ಼್‌ಮ ರ‍್ಹವಾಳನ ಹಾತ್ಮ ದಿದೊ. <verse eid="GAL 3:19"/><verse number="20" style="v" sid="GAL 3:20"/>ಕತೋಬಿ ಎಕ್ಕಸ್‍ಜ಼ಣೊ ರ‍್ಹಯೂತೊ ಬೀಚ಼್‌ವಾಳೊ ಶಾತ್ಬಿ ಜಾ಼ವಾನು ಹೋಣುಕೊಯ್ನಿ. ದೇವ್‌ತೊ ಎಕ್ಕಸ್ ಜ಼ಣೊ.<verse eid="GAL 3:20"/></para>
  <para style="s">ಧರ್ಮಶಾಸ್ತ್ರನಿ ಉದ್ದೇಶ್</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>ಇಮ್‍ಕತೊ ಮೋಶೇನು ಧರ್ಮಶಾಸ್ತ್ರ ದೇವ್ನ ವಾಗ್ದಾನ್ನ ವಿರೋದ್ ಕಿಶು? ಕಾಹೆಸ್ ಕಾಹೆ! ಬಚಾ಼ಡಾನಿ ಶಕತ್ನ ಧರ್ಮಶಾಸ್ತ್ರಥಿ ನೀತಿ ಮಳ್‌ಶೇಸ್ ಮಳ್‌ಶೆ. <verse eid="GAL 3:21"/><verse number="22" style="v" sid="GAL 3:22"/>ಹಿಡಿ ಜಗತ್‌ ಪಾಪ್ನ ಅಧೀನ್ ಹುಯ್ಗಕರಿ ಪವಿತ್ರ ದಪ್ತರ್‌ ಬರೋಬರ್‌ಥಿ ವತಾಳಸ್‍. ಅಮ್‌ರ‍್ಹವಾಪರ್ ವಾಗ್ದಾನ್ನ ಫಲ್ನ ಯೇಸುಮ ನಂಬಾವಳನ ಇವ್ಣ ವಿಶ್ವಾಸ್ ಆಧಾರ್‌ಪರ್ ದೆವಾವಸ್. <verse eid="GAL 3:22"/><verse number="23" style="v" sid="GAL 3:23"/>ಕತೋಬಿ ಕ್ರಿಸ್ತನು ವಿಶ್ವಾಸ್‍ನು ಹಗಾಮ್ ಆವಾನ ಪಹಿಲೆ ಅಪ್ಣೆ ಧರ್ಮಶಾಸ್ತ್ರನ ಮಹಿ ಬಂದನ್ಮ ರ‍್ಹಿಯೇಸ್. ಆ ವಿಶ್ವಾಸ್ ಮಾಲುಮ್‌ಪಡಾಲಗು ಆಸ್ ರ‍್ಹಾ ಹುಯಿರ‍್ಹುಥು. <verse eid="GAL 3:23"/><verse number="24" style="v" sid="GAL 3:24"/>ಅಜು಼ ಅಪ್ಣೆ ವಿಶ್ವಾಸ್‍ಥಿ ಕ್ರಿಸ್ತಮ ನೀತಿವಾಳ ಕರಿ ತೀರ್ಪ್‌ಮಳಾನ ಹಗಾಮ್ ಆವಲಗು, ಧರ್ಮಶಾಸ್ತ್ರ ಅಪ್ಣುನ ಚ಼ಲಾವಮ ಪಾಲನ್‍ ಕರವಾಳು ಹುಯಿರ‍್ಹುಥು. <verse eid="GAL 3:24"/><verse number="25" style="v" sid="GAL 3:25"/>ಕತೋಬಿ ಹಮ್ಕೆ ವಿಶ್ವಾಸ್ ಐರ‍್ಹೂತೆ ಇನಖ್ಹಾಜೆ ಅಪ್ಣೆ ಚ಼ಲವ್‌ಕರೇಸ್ತೆ ಧರ್ಮಶಾಸ್ತ್ರನ ಕಬ್‌ಜಾ಼ಮ ಕೊಯ್ನಿ. <verse eid="GAL 3:25"/><verse number="26" style="v" sid="GAL 3:26"/>ಶನಕತೊ ಕ್ರಿಸ್ತ ಯೇಸುಮ ತುಮೆಖ್ಹಾರು ವಿಶ್ವಾಸ್‍ಥಿ ದೇವ್ನ ಲಡ್ಕಹುಯಿರ‍್ಹಾಸ್. <verse eid="GAL 3:26"/><verse number="27" style="v" sid="GAL 3:27"/>ಕಿಮ್‌ಕತೊ ಕ್ರಿಸ್ತಮ ಮಳಾನ ಬ್ಯಾಪ್ತಿಸ್ಮ ಕರೈರಾಖ್ಯಾತೆ ತುಮೆ ಅಖ್ಖಾಸ್‍ಜ಼ಣ ಕ್ರಿಸ್ತನಿಘೋಣಿ ಹುಯಿರ‍್ಹಾಸ್. <verse eid="GAL 3:27"/><verse number="28" style="v" sid="GAL 3:28"/>ತುಮೆ ಅಖ್ಖುಜ಼ಣು ಕ್ರಿಸ್ತ ಯೇಸುಮ ಎಕ್ಕಸ್ ಹುಯಿರ‍್ಹಾಸ್ತೆಖ್ಹಾಜೆ ಮೆ ಯೆಹೂದ್ಯರ್‌ವಾಳೊ ನತರ್ ಯೆಹೂದ್ಯಕಾಹೇತೆ ಕರಿ ರ‍್ಹವೊ, ಛುಟ್ಕಾರ್‌ವಾಳ ನತರ್ ದಾಸರ್‌ ಕರಿ ರ‍್ಹವೊ, ಪರ್ಖ್ಹೊ ಅಜು಼ ತಯೇಡ ಕರಿ ರ‍್ಹವೊ ಫರಕ್ ಕೊಯ್ನಿ. <verse eid="GAL 3:28"/><verse number="29" style="v" sid="GAL 3:29"/>ತುಮೆ ಕ್ರಿಸ್ತವಾಳ ಉಷೇತೊ ಅಬ್ರಹಾಮ್‌ನ ಖೂಮ್‌ವಾಳ ಹುಯಿನ್ ಅಜು಼ ದೇವ್ನು ವಾಗ್ದಾನ್ನ ಲೀರಾಖವಾಳ ಹುಯಿರ‍್ಹಾಸ್.<verse eid="GAL 3:29"/></para>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>ಕತೋಬಿ ಮೇ ಶಾತ್‌ಬೋಲುಸ್ ಕತೊ ಹಕ್‍ದಾರ್ ರ‍್ಹವಾಳೊ ಯೋ ಇನು ಧನ್‌ದೌಲತ್ನ ಯಜಮಾನ್ ಹುಯಿರ‍್ಹೊತೋಬಿ ಅಡ್ಡಾಣಿ ರ‍್ಹಾವಾಲಗು ಇನು ರ‍್ಹಯುತೋಬಿ ಯೊ ಆಳ್‌ನಿತ್ರಾಸ್ ರ‍್ಹೇಸ್. <verse eid="GAL 4:1"/><verse number="2" style="v" sid="GAL 4:2"/>ಬಾನೆ ಖ್ಹಣೇದ್ ಕರ‍್ಯೊತೆ ವಖ್ಹತ್‌ಲಗು ಪಾಲನ್‌ಕರಾವಳನಿ ಅಜು಼ ಚ಼ಲಾವವಾಳಾನಿ ಚ಼ಪ್ಪಣ್‌ಮ ರ‍್ಹೇಣು. <verse eid="GAL 4:2"/><verse number="3" style="v" sid="GAL 4:3"/>ಇಮ್ಮಸ್ ಅಪ್ಣೇಬಿ ಅಡ್ಡಾನಿ ರ‍್ಹವಾನಿ ವಖ್ಹ್‌ತೆ ಆ ಜಗತ್ನಿ ನಿಯಮ್‌ಥಿ ಚ಼ಲಾವತೆ ಸೇವೆನ ಅಧೀನ್ ಹುಯಿರ‍್ಹಾಥ. <verse eid="GAL 4:3"/><verse number="4" style="v" sid="GAL 4:4"/>ಕತೋಬಿ ಬರಬರ‍್ನಿ ವಖ್ಹತ್ ಆವಖ್ಹತರ್ ದೇವ್ನೆ ಇನ ಛಿಯ್ಯಾನ ಮೋಕ್‌ಲ್ಯೊ.ಯೊ ಏಕ್‌ ತಯೇಡಾಮ ಪೈದಹುಯಿನ್ ಧರ್ಮಶಾಸ್ತ್ರನಿ ಅಧೀನ್‍ಮ ಆಯೊ. <verse eid="GAL 4:4"/><verse number="5" style="v" sid="GAL 4:5"/>ಅನೇಥಿ ಯೊ ಧರ್ಮಶಾಸ್ತ್ರನಿ ಚ಼ಪ್ಪಣ್‌ಮ ರ‍್ಹವಾಳನ ಛೋ಼ಡಾವ್ಣುಕರಿ ಆಯೊ. ಅನಖ್ಹಾಜೇಥಿ ಅಪ್ಣೆ ದೇವ್ನ ಲಡ್ಕಾ ಹುಯ. <verse eid="GAL 4:5"/><verse number="6" style="v" sid="GAL 4:6"/>ತುಮೆ ಛಿಯ್ಯಾಹುಯಿರ‍್ಹಾತೆ ಖ್ಹಾಜೆ ದೇವ್ನೆ, “ಬಾ! ಬಾ!” ಕರಿ ಚಿಕ್ರಾಸ್ತೆ ಇನ ಛಿಯ್ಯಾನ ಆತ್ಮಾನ ಅಪ್ಣ ದಿಲ್ಮ ಮೋಕ್‌ಲ್ಯೊ. <verse eid="GAL 4:6"/><verse number="7" style="v" sid="GAL 4:7"/>ಅಮ್‌ರ‍್ಹವಾಪರ್ ಅಜು಼ ಸೇವಕ್ ಕಾಹೆ, ಛಿಯ್ಯೊ ಹುಯಿರ‍್ಹೋಸ್. ಛಿಯ್ಯೊ ಕರಿ ಬೋಲಾಪರ್ ದೇವ್‌ನೊ ವಾರಿಸ್‌ವಾಳೊಬಿ ಹುಯಿರ‍್ಹೋಸ್.<verse eid="GAL 4:7"/></para>
  <para style="s">ಗಲಾತ್ಯವಾಳನಿ ಬಾರೇಮ ಪೌಲಾನಿ ನಿಘ್ಯ</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>ಅಗ್ಗಳ್ ತುಮೆ ದೇವ್ನ ಮಾಲುಮ್‌ ಕರ‍್ಯಾಕೊಂತೆ, ದೇವಸ್ ಕಾಹೆತೆ ಇವ್ಣುನ ಗುಲಾಮ್ ಹುಯಿರ‍್ಹಾಥ.<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt"><ref loc="ISA 37:19">ಯೆಶಾಯ 37:19</ref>;</char> <char style="xt"><ref loc="JER 2:11">ಯೆರೆಮೀಯ 2:11</ref></char></note> <verse eid="GAL 4:8"/><verse number="9" style="v" sid="GAL 4:9"/>ಹಮ್ಕೆತೋಬಿ ತುಮೆ ದೇವ್ನ ಮಾಲುಮ್‌ ಕರಿರಾಖ್ಯಾಸ್. ವಿಶೇಷ್‌ಥಿ ದೇವ್ನೆ ತುಮುನ ಮಾಲುಮ್ ಕರಿರಾಖ್ಯೋಸ್. ಅಮ್‌ರ‍್ಹವಾಪರ್ ತುಮೆ ಕಾಮ್ನ ಕೊಯ್ನಿತೆ, ಫಾಯಿದೊ ಕೊಯ್ನಿತೆ, ಜಗತ್ನಿ ನಿಯಮ್‌ಭಣಿ ತುಮೆ ಶನ ಫರೋಸ್? ಪಾಛು಼ ಇನ ಗುಲಾಮ್ ಹೋಣುಕರಿ ಛಾ಼ ಕಿಶು? <verse eid="GAL 4:9"/><verse number="10" style="v" sid="GAL 4:10"/>ತುಮೆ ಯೋಯೊ ದನ್ನಾಬಿ, ಮಹಿನನಬಿ, ವೇಳ್ನಾಬಿ, ಅಜು಼ ಹಗಾಮ್ನ ಬಾರೇಮ ಇನಾಸ್ ತುಮೆ ಚ಼ಲಾವವಾಳ ಹುಯಿರ‍್ಹಾಥ. <verse eid="GAL 4:10"/><verse number="11" style="v" sid="GAL 4:11"/>ಮೇ ತುಮಾರಖ್ಹಾಜೆ ಮ್ಹಿನತ್ ಕರ‍್ಯೊತೆ ಫಲ್‌ಕೊಂತೆ ಹುಯ್ಗುಕಿಶುಕಿ ಕರಿ ತುಮಾರಿ ಬಾರೇಮ ಡರ್‌ ಹುವಾಸ್. <verse eid="GAL 4:11"/><verse number="12" style="v" sid="GAL 4:12"/>ಭೈಯೇ ಭೇನೆವೊ, ಮೆ ತುಮಾರಿನಿ ಘೋಣಿ ಹುಯೋತೆ ಇಮ್ಮಸ್ ತುಮೇಬಿ ಮಾರಿನಿತರಸ್ ಹೋಣುಕರಿ ತುಮುನ ಗಿಂಗೈಲೆವುಸ್. ತುಮೆ ಮನ ಶಾತ್ಬಿ ಠಗಾಯ ಕೊಯ್ನಿ. <verse eid="GAL 4:12"/><verse number="13" style="v" sid="GAL 4:13"/>ಮನ ಶರೀರ್‌ಮ ಅಛ್ಛು಼ ಕೋಥುಂತೆ ಇನಖ್ಹಾಜೆ ತುಮಾರಮ ರ‍್ಹೀನ್ ಪಹಿಲಿ ಬಾರ್‌ಮ ತುಮುನ ಸುವಾರ್ತೆ ಬೋಲಿ ವತಾಳ್ಯೊಥೋತೆ ತುಮುನ ಮಾಲುಮ್‌ ಛಾ಼. <verse eid="GAL 4:13"/><verse number="14" style="v" sid="GAL 4:14"/>ಮಾರಿ ಶರೀರ್‌ನಿ ರ‍್ಹಾಥಿ ತುಮುನ ಬೇಜಾರ್ ಹುವಾನು ರ‍್ಹಯುತೋಬಿ ಧಚ಼್‌ಕಾಯ ಕೊಯ್ನಿ, ಝಿಟ್ಕಾರ‍್ಯ ಕೊಯ್ನಿ, ಮನ ದೇವ್ನ ದೂತನಿತರ ಕ್ರಿಸ್ತಯೇಸುನಿ ಘೋಣಿಸ್ ಉಪಚಾರ್ ಕರ‍್ಯಾ. <verse eid="GAL 4:14"/><verse number="15" style="v" sid="GAL 4:15"/>ಯೋ ವಖ್ಹತ್‌ಮ ಯೋ ಏಕ್‌ ಖುಶಿಕರಿ ಲಹಿರಾಖ್ಯಾಥಾನಿ, ಹಮ್ಕೆ ಯೊ ಖ್ಹಯಾಲ್ ಕಿಜ್ಜಾ಼ ಛಾ಼? ತದೆ ಹೋಣುಕತೊ ತುಮಾರ ಡೋಳಾನಸ್ ಉಖ್ಡೀನ್ ಮನ ದಿದಾಹೋತ್ತ್ ಕರಿ ಮೇ ಸಾಕ್ಷಿ ಬೋಲುಸ್. <verse eid="GAL 4:15"/><verse number="16" style="v" sid="GAL 4:16"/>ಅಮ್‌ರ‍್ಹವಾಪರ್ ಮೆ ಖ್ಹಾಚಿಬೋಲಾಥಿ ತುಮುನ ವಹೇರ‍್ಯೊ ಹುಯೊ ಕಿಶು?<note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt"><ref loc="AMO 5:10">ಆಮೋಸ 5:10</ref></char></note> <verse eid="GAL 4:16"/><verse number="17" style="v" sid="GAL 4:17"/>ಯೋ ಮಾರು ವಿರೋದಿ ಖ್ಹಾರು ತುಮುನ ದೋಸ್ತ್ ಕರಾವ್ಣುಕರಿ ದಿಲ್‌ ಲಗಾಡು ಕರಾಸ್ ಕತೋಬಿ ಅಛ್ಛಾ಼ನಖ್ಹಾಜೆ ಕಾಹೆ. ತುಮೆ ಇವ್ಣುನ ಕಿಮ್ ಮನ್‌ಲಗಾಡ್ಣುಕರಿ ಕರಸ್ಕಿ ಇಮ್ಮಸ್ ಇವ್ಣೇಬಿ ತುಮುನ ಮಾರೇಥಿ ಅಲಕ್ ಕರ್ನುಕರಿ ಕೋಶಿಶ್ ಕರುಕರಸ್. <verse eid="GAL 4:17"/><verse number="18" style="v" sid="GAL 4:18"/>ತುಮಾರಿ ಜೋ಼ಡೆ ರ‍್ಹವಾನಿವಖ್ಹ್‌ತೆ ಖಲಿಕಾಹೆ ಕೆದೇಬಿ ಅಛ್ಛು಼ ವಾತೇವ್ನ ಖ್ಹಾಜೆ ತುಮೆ ಮನ್ ಲಗಾಡನು ಅಛ್ಛೂ಼ಸ್. <verse eid="GAL 4:18"/><verse number="19" style="v" sid="GAL 4:19"/>ಮಾರ ಪ್ಯಾರ್‌ನ ಲಡ್ಕಾವ್‍ನಿಘೋಣಿ ಛಾ಼ತೆ ಗಲಾತ್ಯವಾಳವೊ, ಆಯ ಇನ ಲಡ್ಕಾನಖ್ಹಾಜೆ ಜ಼ಣತ್‌ನಿ ಅಜ಼ ಪಡಾನಿಘೋಣಿ, ಕ್ರಿಸ್ತ ಯೇಸುನು ಚಾ಼ವ್‌ಭಾವ್ ತುಮಾರಮ ಆವಲಗು ತುಮಾರ ಖ್ಹಾಜೆ ಮೆ ಎಥ್ರಾನಿಸ್ ಅಜ಼ ಪಡುಕರುಸ್. <verse eid="GAL 4:19"/><verse number="20" style="v" sid="GAL 4:20"/>ತುಮಾರಿ ಬಾರೇಮ ಶಾತ್‌ಕರ‍್ನುಕರಿ ಮನ ಸೋಚಾನ ಕೊಹುಂಕರಾನಿ. ಬೋಲ್ನುಕತೊ, ತುಮಾರ ಬೀಚ್ಮಾಸ್ ರ‍್ಹೀನ್ ಮಾರ ವಾತೆನಿ ಲಬೂಜ಼್‌ನ ಬದ್ಲಾಯೊಹೊತ್ತೊ ಅಛ್ಛು಼ ರ‍್ಹಿಯುಹೊತ್ ಕಿಶುಕಿ!<verse eid="GAL 4:20"/></para>
  <para style="s">ಸಾರನಿ ಅಜು಼ ಹಾಗರ‍್ನಿ ಉದಾಹರಣೆ</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>ಧರ್ಮಶಾಸ್ತ್ರನ ಹೇಟಹುಯಿನ್ ಚಾ಼ಲಾನ ಹರ್ಖ್ಹವಾಳ, ಧರ್ಮಶಾಸ್ತ್ರ ಶಾತ್‌ ಬೋಲುಕರಸ್ ಕರಿ ತುಮೆ ಖ್ಹಮ್‌ಜ್ಯ ಕೊಯ್ನಿಕಿಶು? ಮನ ಜ಼ವಾಬ್ ದೇವೊ. <verse eid="GAL 4:21"/><verse number="22" style="v" sid="GAL 4:22"/>ಇನಾಮ ಲಿಖೈರ‍್ಹುಸ್ ಶಾತ್‌ಕತೊ ಅಬ್ರಹಾಮ್‌ನ ಬೇ ಪರ್ಖ್ಹಾ ಲಡ್ಕಾಥ. ಏಕ್‌ ಜ಼ಣೊ ದಾಸಿನ ಪೈದಹುಯೊತೆ, ಬಿಜೇಕ್ ಜ಼ಣೊ ಛುಟ್ಕಾರ್‌ಥಿ ರ‍್ಹವಾಳಿನ ಪೈದಹುಯುತೆ.<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt"><ref loc="GEN 16:5-21:2">ಆದಿಕಾಂಡ 16:5—21:2</ref></char></note> <verse eid="GAL 4:22"/><verse number="23" style="v" sid="GAL 4:23"/>ದಾಸಿನೊ ಛಿಯ್ಯೊ ಶರೀರ್‌ನ ಸಂಬಂಧ್‌ಥಿ ಪೈದಹುಯುತೆ, ಛುಟ್ಕಾರ್‌ಥಿ ರ‍್ಹವಾಳಿನೊ ಛಿಯ್ಯೊ ವಾಗ್ದಾನ್‌ಥೀಸ್ ಹುಯೋತೆ. <verse eid="GAL 4:23"/><verse number="24" style="v" sid="GAL 4:24"/>ಆ ವಾತೆಖ್ಹಾರು ಮಾಲುಮ್ ಕರಾನು ಹುಯಿರ‍್ಹುಸ್. ಕಿಮ್‌ಕತೊ ಯೋ ಭೇ ತಯೇಡ ಬೇ ಒಪ್ಪಂದ ಹುಯಿರ‍್ಹುಸ್. ಏಕ್‌ ಒಪ್ಪಂದ ಸೀನಾಯಿ ಪರ್ಭತ್ ಉಬ್ಜಿನ್ ಗುಲಾಮ್ ಹುಯಿನ್ ರ‍್ಹವಾನ ಲಡ್ಕಾನ ಪೈದಕರಸ್ತೆ; ಯೋಸ್ ಹಾಗರ್. <verse eid="GAL 4:24"/><verse number="25" style="v" sid="GAL 4:25"/>ಹಾಗರ್ ಕತೊ ಅರಬ್‌ಮ ಛಾ಼ತೆ ಸೀನಾಯಿ ಪರ್ಭತ್‌ನ ವತಾಳಸ್‍. ಹಮ್ಕೇನು ಯೆರೂಸಲೇಮ್ ಖ್ಹಯೇರ‍್ನಿಮತ್ ಹುಯಿರ‍್ಹೀಸ್. ಶನಕತೊ ಯೊ ಹೈರಿತೆ ಇನ ಅದ್ಮಿಯೇನ ಜೋ಼ಡ್ಮ ಹಮ್ಕೆ ಸೇವೆಕರವಾಳಿ ಹುಯಿರ‍್ಹೀಸ್. <verse eid="GAL 4:25"/><verse number="26" style="v" sid="GAL 4:26"/>ಕತೋಬಿ ಸೊರ್ಗಾನು ಯೆರೂಸಲೇಮ್ ಕರಿ ಬೋಲವಾಳಿ ಛುಟ್ಕಾರ್‌ವಾಳಿ ಹುಯಿರ‍್ಹೀಸ್. ಆಸ್ ಅಪ್ಣಿ ಆಯ. <verse eid="GAL 4:26"/><verse number="27" style="v" sid="GAL 4:27"/>ಜ಼ಣಿಕೊಂತೆ ವಾಂಝಿ ತಯೇಡ ಶಂತೋಖ್ಹ್‌ಕರ್ ಜ಼ಣತ್‌ನಿ ಅಜ಼ ಮಾಲುಮ್‌ಕೊಂತೆ ರ‍್ಹವಾಳಿ, ಖುಷಿಥಿ ಊಚು಼ ಅವಾಜ಼್‌ಥಿ ಚಿಕರ್, ಬಾವ್ರಿ ರ‍್ಹಾವವಾಳಿಥೀಬಿ ಬಾವ್ರಿ ಮ್ಹೇಲಿಹುಯಿನ ಲಡ್ಕಾ ಜಾ಼ಖ್ಹತ್‌ಕರಿ ಲೀಖೈರ‍್ಹೂಸ್‌ನಿ.<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt"><ref loc="ISA 24:1-54:1">ಯೆಶಾಯ 24:1—54:1</ref></char></note> <verse eid="GAL 4:27"/><verse number="28" style="v" sid="GAL 4:28"/>ಭೇನೆ ಭೈಯೇವೊ, ಅಪ್ಣೆ ಇಸಾಕನಿ ಘೋಣಿ ವಾಗ್ದಾನ್ನ ಫಲ್ನ ಲಡ್ಕಹುಯಿರ‍್ಹಾಸ್. <verse eid="GAL 4:28"/><verse number="29" style="v" sid="GAL 4:29"/>ಕತೋಬಿ ಪಹಿಲೆ ಶರೀರ್‌ನ ಸಂಬಂಧ್‌ಥಿ ಪೈದ ಹುಯಿರ‍್ಹಾವಳೊ ದೇವ್ನ ಆತ್ಮಾನಿ ಶಕಥ್ಥಿ ಪೈದಹುಯಿರ‍್ಹಾವಳನ ಖ್ಹತಾಪ್ಣಿ ದ್ಯವನಿತರಸ್ ಹಮ್ಕೇಬಿ ಹೂಕರಸ್.<note caller="-" style="x"><char style="xo" closed="false">4:29 </char><char style="xt"><ref loc="GEN 21:9">ಆದಿಕಾಂಡ 21:9</ref></char></note> <verse eid="GAL 4:29"/><verse number="30" style="v" sid="GAL 4:30"/>ಕತೋಬಿ ಪವಿತ್ರ ದಪ್ತರ್‌ಮ ಶಾತ್‌ಬೋಲಾಸ್? “ದಾಸಿನಾಬಿ ಇನ ಛಿಯ್ಯಾನಾಬಿ ಭಾರ್‌ಕಾಡ್‌. ದಾಸಿನೊ ಛಿಯ್ಯೊ ಛುಟ್ಕಾರ್‌ಥಿ ರ‍್ಹವಾಳಿನ ಛಿಯ್ಯಾನ ಜೋ಼ಡೆ ಭಾಗ್‌ ಲ್ಯವಾಳೊ ನಾಹುಯಿರ‍್ಹೇವ್ಣು” ಕರಿ ಬೋಲಾಸ್.<note caller="-" style="x"><char style="xo" closed="false">4:30 </char><char style="xt"><ref loc="GEN 21:10">ಆದಿಕಾಂಡ 21:10</ref></char></note> <verse eid="GAL 4:30"/><verse number="31" style="v" sid="GAL 4:31"/>ಇಮ್ಮಸ್ ಭೈಯೇ ಭೇನೆವೊ, ಅಪ್ಣೆ ದಾಸಿನ ಲಡ್ಕಾಕಾಹೆ, ಕತೋಬಿ ಛುಟ್ಕಾರ್‌ವಾಳಿನ ಲಡ್ಕಾ ಹುಯಿರ‍್ಹಾಸ್.<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="s">ಕ್ರಿಸ್ತಮ ಛುಟ್ಕಾರ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>ಕ್ರಿಸ್ತನೆ ಅಪ್ಣುನ ಕಬ್‌ಜಾ಼ಮ ನಾರ‍್ಹೇವ್ಣುಕರಿ ಅಪ್ಣುನ ಛುಟ್ಕಾರ್ ಕರೀನ್ ಮ್ಹೇಲ್ಯೊ. ಇನಾಮ ಘಟ್‍ಥಿ ಭೀರೆವೊ. ಅಜು಼ ಪಾಛು಼ ದಿಲ್‌ ಫರೈನ್ ಗುಲಾಮ್‌ಗಿರಿನ ನೊಗಾಮ ಪಾಛಾ಼ ನಕೊ ಖ್ಹಪ್‌ಡಿಜಾಶು. <verse eid="GAL 5:1"/><verse number="2" style="v" sid="GAL 5:2"/>ದೇಖೊ, ಪೌಲಕರಿ ಮೇ ತುಮುನ ಬೋಲುಕರುಸ್, ತುಮೆ ಖ್ಹತ್ನ ಕರಾವನ ತುಮಾರು ತುಮೇಸ್ ಮಾನಿಲಿದಾತೊ ಕ್ರಿಸ್ತಥಿ ತುಮುನ ಶನೂಬಿ ಫಾಯಿದೊ ಕೊಯ್ನಿ. <verse eid="GAL 5:2"/><verse number="3" style="v" sid="GAL 5:3"/>ಖ್ಹತ್ನ ಕರೈಲಾವಳ ಹರೇಕ್ ಜ಼ಣಾನ, ತೂ ಧರ್ಮಶಾಸ್ತ್ರಮ ಬೋಲಿರಾಖ್ಯುಸ್ತೆ ಕರ್ನಿನ ಚ಼ಲಾವವಾಳೊ ಹುಯಿರ‍್ಹೊಸ್ ಕರಿ ಪಾಛು಼ ಮೆ ಖ್ಹಾಚ಼ಮಾಬಿ ಬೋಲುಸ್. <verse eid="GAL 5:3"/><verse number="4" style="v" sid="GAL 5:4"/>ತುಮಾರಮ ಕೋಣ್‌ಕೋಣ್ ಧರ್ಮಶಾಸ್ತ್ರಥಿ ನೀತಿವಾಳ ಹೋಣುಕರಿ ಆಖ್ಹ್‌ಕರಾಸ್ಕಿ ಇವ್ಣೆ ಕ್ರಿಸ್ತಥಿ ಬಿಚ಼ಡಿಜಾ಼ವಳ ಹುಯಿರಾಸ್ ವಾರ್‌ಖ್ಹಾನ ಆಖ್ಹ್‌ರೇಥಿ ರಡ್ಕಾಹುಯ ಹುಯಿರ‍್ಹಾಸ್. <verse eid="GAL 5:4"/><verse number="5" style="v" sid="GAL 5:5"/>ಹಮೆತೋಬಿ ದೇವ್ನ ಆತ್ಮಾಥಿ ವಿಶ್ವಾಸ್‍ಥಿ ನೀತಿವಾಳಹುಯೇಸ್ ಕರಿ ಟಿವೈರ‍್ಹವಾನು ಚಾ಼ಲ್‌ಶೆಕರಿ ದಿಲ್‌ ಲಗಾಡಿನ್ ಮ್ಹೋರೆ ದೇಖವಾಳ ಹುಯಿರ‍್ಹಾಸ್. <verse eid="GAL 5:5"/><verse number="6" style="v" sid="GAL 5:6"/>ಕ್ರಿಸ್ತ ಯೇಸುಮ ರ‍್ಹವಾಳನ ಖ್ಹತ್ನ ಹುಯುತೋಬಿ ನಾಹುಯುತೋಬಿ ಫಾಯಿದೊ ಕೊಯ್ನಿ. ಕತೋಬಿ ಪ್ಯಾರ್‌ಥಿ ರ‍್ಹೇಸ್ತೆ ವಿಶ್ವಾಸಸ್ ಫಾಯಿದಾನು ಹುಯಿರ‍್ಹುಸ್. <verse eid="GAL 5:6"/><verse number="7" style="v" sid="GAL 5:7"/>ತುಮೆ ಅಛ್ಛಿನಿತರ ಮಿಲವ್‌ ಕರಸ್ ಕತೋಬಿ ಖ್ಹಾಚ಼ನ ನಾ ಪಾಡಿಚಾ಼ಲ್ನುಕರಿ ತುಮುನ ಠೆರಾಯುತೆ ಕೋಣ್? <verse eid="GAL 5:7"/><verse number="8" style="v" sid="GAL 5:8"/>ಅಮ್ ಅಡ್ಡಿ ಕರಾನು ತುಮುನ ದೇವ್‍ಥಿ ಆಯು ಹುಯು ಕಾಹೆ. <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/>ದರಾಖ್ಹು ಶೋಡ ಬಶ್‌ ಪೂರ ಘೂಂದಹುಯ ಆಟನಸ್ ಫುಲೈನಾಖಸ್. <verse eid="GAL 5:9"/><verse number="10" style="v" sid="GAL 5:10"/>ಕತೋಬಿ ತುಮಾರಮ ಬಿಜಿ ಸೋಚ್ ಕೊರ‍್ಹಿಶೇನಿ ಕರಿ ಪ್ರಭುಮ ತುಮಾರಿ ಬಾರೇಮ ಮನ ಭರೋಖ್ಹೊ ಛಾ಼. ತುಮಾರಮ ಗುಂಝ಼್‌ಲಾವ್ಣಿ ಕರಾವಾಳೊ ಕೋಣ್‌ಬಿ ರ‍್ಹವೊ ದೇವ್ನಿ ನಿಶತ್‌ ಲಿಶೆ. <verse eid="GAL 5:10"/><verse number="11" style="v" sid="GAL 5:11"/>ಭೈಯೇ ಭೇನೆವೊ, ಅದ್ಮಿ ಖ್ಹತ್ನ ಕರಾವ್ಣು ಕರಿ ಮೇ ಬೋಧನೆ ಕರುಕೊಯ್ನಿ. ಖ್ಹತ್ನನು ಜ಼ರೂರತ್ ಛಾ಼ಕರಿ ಮೇ ಬೋಧನೆ ಕರಾವಾಳೊ ಹುಯೋತೊ ಮೇ ಬಿಜೂ಼ಬಿ ಖ್ಹತಾಪ್ಣಿನ ಮಹಿ ಶನ ಛೂ಼? ಅದ್ಮಿ ಖ್ಹತ್ನ ಕರಾವ್ಣುಕರಿ ಮೇ ಹಮ್ಕೆ ಬೋಧನೆ ಕರಾವಾಳೊ ರ‍್ಹಯೋತೊ ಶಿಲ್‌ಬೇನಿ ಬಾರೇನಿ ಮಾರಿ ಬೋಧನೆಥಿ ಶನೂಸ್ ಕಚ಼್ಚರ್‌ ಕೊರ‍್ಹಿಶೇನಿ. <verse eid="GAL 5:11"/><verse number="12" style="v" sid="GAL 5:12"/>ತುಮುನ ಕಲಾವ್ಣಿ ಕರವಾಳು ಇವ್ಣು ಇವ್ಣೇಸ್ ಖ್ಹಂದೊ ವ್ಹಾಡಿಲಿದುತೊಬಿ ಅಛ್ಛೂ಼ಸ್. <verse eid="GAL 5:12"/><verse number="13" style="v" sid="GAL 5:13"/>ಭೈಯೇ ಭೇನೆವೊ, ತುಮೆ ಛುಟ್ಕಾರ್‌ಥಿ ರ‍್ಹೇವ್ಣುಸ್‌ಕರಿ ದೇವ್ನೆ ತುಮುನ ಬುಲಾಯೊ. ಕತೋಬಿ ತುಮುನ ಛಾ಼ತೆ ಛುಟ್ಕಾರ್‌ನ ಶರೀರ್‌ನ ಇಛ್ಛಾನಿ ಪರಕ್ಮ ಉಪಯೋಗ್‌ ನಾಕರ‍್ನುತೆ, ಪ್ಯಾರ್‌ಥಿ ಏಕ್‌ಥಿ ಏಕ್‌ ಸೇವೆಕರೊ. <verse eid="GAL 5:13"/><verse number="14" style="v" sid="GAL 5:14"/>ತಾರ ಭೀಡೆವಾಳನ ತಾರಿನಿತರಾಸ್ ಪ್ಯಾರ್ ಕರ್ನುಕರಿ ಎಕ್ಕಸ್ ಹುಕುಮ್ಮ ಧರ್ಮಶಾಸ್ತ್ರಸ್ ಲಪಿರ‍್ಹುಸ್.<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt"><ref loc="LEV 19:18">ಯಾಜಕ 19:18</ref>;</char> <char style="xt"><ref loc="MAT 22:39-40">ಮತ್ತಾಯ 22:39-40</ref></char></note> <verse eid="GAL 5:14"/><verse number="15" style="v" sid="GAL 5:15"/>ಕತೋಬಿ ತುಮೆ ಏಕ್‌ ಥಿ ಏಕ್‌ ಜ಼ಂಗ್‌ಳಿ ಜಾನ್ವರ್‌ನಿ ಘೋಣಿ ಕಲ್ಡ್‌ತಾಹುಯಿನ್, ಫಾಡಿತೋಡಿ ಖಾವವಾಳ ಹುಯಿರ‍್ಹಾತೊ ಏಕ್‌ ಥಿ ಏಕ್‌ ಜ಼ಣು ನಾಶ್ ಹುಯಿಜಾ಼ಶು, ಹೊಷಾರ್.<verse eid="GAL 5:15"/></para>
  <para style="s">ಪವಿತ್ರಾತ್ಮ ಅಜು಼ ಅದ್ಮಿನು ಸ್ವಭಾವ್</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>ಮೇ ಬೋಲಾನು ಶಾತ್‌ಕತೊ ಪವಿತ್ರಾತ್ಮನಿ ತರೀಖಾಮ ಚಾ಼ಲೊ ತದೆ ತುಮೆ ಶರೀರ್‌ನ ಲಾಲಚ್‌ನಿ ಖೆವಿ ಪರಕ್ಮಬಿ ಕೋಕರ್‌ಶುನಿ. <verse eid="GAL 5:16"/><verse number="17" style="v" sid="GAL 5:17"/>ಶನಕತೊ ಶರೀರ್‌ನು ಸ್ವಭಾವ್‌ ಆತ್ಮಾನ ವಿರೋದ್ ಹುಯಿರ‍್ಹುಸ್. ಆತ್ಮನು ಸ್ವಭಾವ್ ಶರೀರ್‌ನ ವಿರೋದ್ ಹುಯಿರ‍್ಹುಸ್. ತುಮೆ ಕರ್ನುತೆಯಿನ ನಾಕರ‍್ನುತೆ ಏಕ್‌ಥಿಏಕ್ ಹೊಜ಼್ಜತ್ ಭೀಡಾಸ್. <verse eid="GAL 5:17"/><verse number="18" style="v" sid="GAL 5:18"/>ಕತೋಬಿ ತುಮೆ ಆತ್ಮಾಥಿ ಚ಼ಲೈಲಾವಳ ರ‍್ಹಯಾತೊ ಧರ್ಮಶಾಸ್ತ್ರನಿ ಚ಼ಪ್ಪಣ್‌ಮ ಕೊಯ್ನಿ. <verse eid="GAL 5:18"/><verse number="19" style="v" sid="GAL 5:19"/>ಶರೀರ್‌ನು ಗುಣ್‌ಖ್ಹಾರು ದೆಖವ್‌ಕರಸ್ ಯೊ ಖಿವುಕತೊ; ವ್ಯಬಿಚಾರ್,ಕಚಿಂಡ್ ರ‍್ಹವಾನು, ಪಾಪೇಲು ರ‍್ಹವಾನು, <verse eid="GAL 5:19"/><verse number="20" style="v" sid="GAL 5:20"/>ಮೂರತ್ನಿಪೂಜ಼, ಜಾ಼ದು ಜ಼ರ್ಮರ್, ಏಕ್‌ಥಿಏಕ್ ದಾವೊ,ಲಡೈ, ಪೇಟ್ನೊ ಬಳಾಪೊ, ಇರಾದೊ, ಅಲ್ಹಾವ್‍ನಿತರ ದೇಖಾನು, ಟೋಳ್ನ ಫೋಡಿನಾಖನು, <verse eid="GAL 5:20"/><verse number="21" style="v" sid="GAL 5:21"/>ವಹೇರ್‌ ರಾಖಾನು, ಪಿಯಾನು, ಗಲಾಟ್, ಮೋಜ್‌ಮಸ್ತಿ, ಆ ಅಖ್ಖು. ಅಮ್ನು ಕಾಮ್ ಚ಼ಲಾವವಾಳು ದೇವ್ನಿ ರಾಜ್ಯನು ಹಕ್‌ವಾಳು ಕೊಉಷೆನಿಕರಿ ಮೇ ಆ ಅಗ್ಗಳ್ ಬೋಲ್ಯೊತೆ ತಿಮ್ಮಸ್ ಹಮ್ಕೇಬಿ ತುಮುನ ಝೇತಾವ್‌ಸ್‌. <verse eid="GAL 5:21"/><verse number="22" style="v" sid="GAL 5:22"/>ಕತೋಬಿ ದೇವ್ನ ಆತ್ಮಾಥಿ ಉಬ್‌ಜಾ಼ನು ಫಲ್ ಶಾತ್‌ಕತೊ, ಪ್ಯಾರ್, ಶಂತೋಖ್ಹ್‌, ಸಮಾಧಾನ್, ಖ್ಹಮಾಳಿ ರ‍್ಹವಾನು, ದಯಾ, ಬಿಜೇಕ್ನ ಮದತ್‌ಕರಾನು, ವಿಶ್ವಾಸ್, ಆಸ್‌ಹುಯಿರ‍್ಹುಸ್. <verse eid="GAL 5:22"/><verse number="23" style="v" sid="GAL 5:23"/>ಶೇದೇವ್, ದೋಭೇಡು ಅಥ್ರಾನುಸ್. ಆ ಅಖ್ಖಾನ ವಿರೋದ್‌ಥಿ ಖಿವು ಧರ್ಮಶಾಸ್ತ್ರಬಿ ಕೊಯ್ನಿ. <verse eid="GAL 5:23"/><verse number="24" style="v" sid="GAL 5:24"/>ಕ್ರಿಸ್ತ ಯೇಸುಮ ರ‍್ಹವವಾಳು ಇವ್ಣ ಶರೀರ್‌ನು ಆಖ್ಹ್‌ದಾಖ್ಹ್‌ ಅಜು಼ ಖರಾಬ್ ಆಖ್ಹ್‌ನ ಖ್ಹಮೇದ್ ಶಿಲ್‌ಬೇಪರ್ ನಾಖವಾಳ ಹುಯಿರ‍್ಹುಸ್. <verse eid="GAL 5:24"/><verse number="25" style="v" sid="GAL 5:25"/>ಅಪ್ಣೆ ಆತ್ಮಾಥಿ ಜಿವ್‌ಕರಸ್ತೆ ಇನಖ್ಹಾಜೆ ಆತ್ಮಾನ ಪಾಲನ್‍ ಕರಿ ಚಾ಼ಲ್ಯೆ. <verse eid="GAL 5:25"/><verse number="26" style="v" sid="GAL 5:26"/>ಹಂಕಾರಿ, ಏಕ್‌ನಏಕ್ ನಾ ಛೇಡಾವ್ಣುನಾತೆ, ಏಕ್‌ ಜ಼ಣಾನ ಉಪ್ಪರ್ ಬಿಜೇಕ್ ಜ಼ಣು ಬಳಾಪೊ ನಾಕರ‍್ನುತೆ ತಿಮ್ ರ‍್ಹಿಯೆ.<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s">ಏಕ್‌ಥಿಏಕ್ ಭೋಜ಼್‌ ಝೇಲಾವಾಳ ರ‍್ಹವೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>ಭೈಯೇ ಭೇನೆವೊ ತುಮಾರಮ ಕೋಣ್‌ತೋಬಿ ಖಿವುತೋಬಿ ಪಾಪ್‌ಮ ಖ್ಹಪ್ಡಿ ರ‍್ಹಯೂತೊ ಎಥ್ರಾನವಾಳನ ಆತ್ಮಥಿ ಭರೈರ‍್ಹಾವಳ ತುಮೆ ಧೀಮೆಥಿ ಬೋಲಿನ್ ಬರೋಬರ್ ಕರೊ. ತುಮೆತೋಬಿ ಶೋದನೆಮ ನಾಪಡ್ನುತೆ ಇಮ್‌ ತುಮಾರಿ ಬಾರೇಮ ಜ಼ತನ್ ರ‍್ಹವೊ. <verse eid="GAL 6:1"/><verse number="2" style="v" sid="GAL 6:2"/>ಏಕ್ಜ಼ಣೊ ಬಿಜೇಕ್ ಜ಼ಣಾನಿ ಭೋಜ಼್‌ನ ಝೇಲಾದೆ, ಅಮ್ ಕ್ರಿಸ್ತನು ನಿಯಮ್ನ ಪೂರಕರೊ. <verse eid="GAL 6:2"/><verse number="3" style="v" sid="GAL 6:3"/>ಶನಕತೊ ಮೆ ಶಾತ್ ನಾ ರ‍್ಹಿಯೋತೋಬಿ, ಇನು ಯೊ ಮೋಟೊಕರಿ ಲ್ಹಾಯೊತೊ ಯೊ ಧೋಕೊ ಖಾವಳೊ ಹುಯಿರ‍್ಹೊಸ್. <verse eid="GAL 6:3"/><verse number="4" style="v" sid="GAL 6:4"/>ಹರೇಕ್ ಜ಼ಣೊ ಯೋ ಕರಾತೆ ಕಾಮ್ನ ತರೀಪ್‌ಶ ಕರಿಲ್ಯಾವಾದೆ. ತದೆ ಯೊ ಇನಖ್ಹಾಜೇಥಿ ಊಚೊ಼ ಹುಯೆಜಾ಼ಯ್‌ ಪಣ್ಕಿ ಬಿಜೇಕ್ ಜ಼ಣಾನಿತರಾಸ್‌ ಮೇ ಬರೊಬರ್‌ ಬೋಲಿಲಾವನು ಹೋಣುಕೊಯ್ನಿ. <verse eid="GAL 6:4"/><verse number="5" style="v" sid="GAL 6:5"/>ಶನಕತೊ ಹರೇಕ್ ಜ಼ಣೊ ಇನೊ ಶೊಂತ್ ಭೋಜ಼್‌ನ ಯೋಸ್ ಪಾಡವಾಳೊ ಹುಯಿರ‍್ಹೇಣು. <verse eid="GAL 6:5"/><verse number="6" style="v" sid="GAL 6:6"/>ಕ್ರಿಸ್ತನು ಬೋಧನೆನ ಶಿಕವಾಳೊ ಇನ ಶಿಕಾಡವಾಳಮ ಛಾ಼ತೆ ಅಖ್ಖಾಸ್ ಅಛ್ಛಾ಼ಮಾಥು ವಾಟಪಾಡಿಲ್ಯವಾದೆ. <verse eid="GAL 6:6"/><verse number="7" style="v" sid="GAL 6:7"/>ತುಮಾರು ತುಮೆ ಧೋಕ ನಕೊಖಾವೊ, ದೇವ್ನ ನಕ್ಲೆನಿತರ ಲ್ಹಾವನ ಕೊಹುವ್ವಾನಿ. ಅದ್ಮಿ ಯೋ ಶಾತ್ ಬಿತ್‌ಕರಸ್ಕಿ ಇನಾಸ್ ವ್ಹಾಡ್ಣು. <verse eid="GAL 6:7"/><verse number="8" style="v" sid="GAL 6:8"/>ಇನು ಶರೀರ್‌ನು ಲಾಲಚ್‌ನಿ ತರಾನು ಬಿತ್ತವಾಳೊ ಯೋ ಯೊ ಖ್ಹಯಾಲ್‍ಥೀಸ್ ನಾಶನನ ವ್ಹಾಡವಾಳೊ ಹುಯಿರ‍್ಹೋಸ್. ಪವಿತ್ರಾತ್ಮನಿ ಬಾರೇಮ ಬಿತ್ತವಾಳೊ ಪವಿತ್ರಾತ್ಮಥಿ ಹಮೇಶಾನು ಜಾನ್ನ ಫಲ್ನ ವ್ಹಾಡ್‌ಶೆ. <verse eid="GAL 6:8"/><verse number="9" style="v" sid="GAL 6:9"/>ಅಛ್ಛಾ಼ನ ಕರಾಮ ವಳ್‍ಶಿ ನಕೊಕರಿಯೆ, ದಿಲ್ಮ ಢೀಲ ನಾಪಡ್ನುತೆ ರ‍್ಹಿಯೆ, ತದೆ ಬರೊಬ್ಬರ್‌ನಿ ವಖ್ಹತ್‌ಮ ಅನಾಜ಼್ ವ್ಹಾಡ್‌ಶು. <verse eid="GAL 6:9"/><verse number="10" style="v" sid="GAL 6:10"/>ಇನಖ್ಹಾಜೆ ವಖ್ಹತ್ ರ‍್ಹವಾನಿಸ್ ವಖ್ಹ್‌ತೆ ಅಖ್ಖಾನ ಅಛ಼್ಛು ಕರಿಯೆ. ವಿಶೇಷ್‌ಥಿ ಎಕ್ಕಸ್ ಘರ್‌ವಾಳನಿತರ ವಿಶ್ವಾಸಿ ಭೈಯೇನ ಕರಿಯೆ.<verse eid="GAL 6:10"/></para>
  <para style="s">ಖ್ಹರ್ತಿನಿ ಝೇತಾವ್ಣಿ ಅಜು಼ ಖ್ಹಲಾಮ್</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>ದೇಖೊ ಆ ಮೋಟ, ಮೋಟ ಲೀಖ್ಯಾನ ಮಾರ ಹಾತೇಖ್ಹುಸ್ ತುಮುನ ಲೀಖುಕರುಸ್! <verse eid="GAL 6:11"/><verse number="12" style="v" sid="GAL 6:12"/>ಕಂಡಿ ಛ಼ಡೈಲ್ಯವಾಳು ಶರೀರ್‌ಮ ಖ್ಹತ್ನ ಕರಾವೊಕರಿ ತುಮುನ ಜು಼ಲಮ್‌ ಕರಾಸ್, ಶನಕತೊ ಕ್ರಿಸ್ತನಿ ಶಿಲ್‌ಬೇನಖ್ಹಾಜೆ ಇವ್ಣುನ ಖ್ಹತಾಪ್ಣಿ ನಾಹೊಣುಕರಿ ಬೋಲಾನುಸ್ ಇವ್ಣು ಉದ್ದೇಶ್. <verse eid="GAL 6:12"/><verse number="13" style="v" sid="GAL 6:13"/>ಖ್ಹತ್ನ ಕರಾಯುಹುಯೂಸ್ ಧರ್ಮಶಾಸ್ತ್ರನ ಪಾಡಿನ್ ಚಾ಼ಲುಕರ ಕೊಯ್ನೀನಿ. ಇವ್ಣೆ ತುಮಾರಿ ಶರೀರ್‌ನಿ ಬಾರೇಮ ಊಚ಼ ಹುವಾನಖ್ಹಾಜೆ ಖ್ಹತ್ನ ಹೋಣುಕರಿ ಆಖ್ಹ್‌ಕರಾಸ್‌. <verse eid="GAL 6:13"/><verse number="14" style="v" sid="GAL 6:14"/>ಮನತೋಬಿ ಮಾರೊ ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತನಿ ಶಿಲ್‌ಬೇನಿ ಬಾರೇಮಸ್ ಪಣ್ಕಿ ಬಿಜು಼ ಖೆವಾಥೀಬಿ ಊಚು಼ ಹೋಣುಕೊಯ್ನಿ. ಇನೇಥಿ ಮೇ ಜಗತ್ನಖ್ಹಾಜೆ ಮರಿಗೊ; ಜಗತ್‌ ಮಾರಖ್ಹಾಜೆಬಿ ಶಿಲ್‌ಬೇಪರ್ ಮರಿಗಯುಥು. <verse eid="GAL 6:14"/><verse number="15" style="v" sid="GAL 6:15"/>ಶನಕತೊ ಖ್ಹತ್ನ ಹುಯುತೋಬಿ ನತರ್ ನಾಹುಯುತೋಬಿ ಯೋ ಮುಖ್ಯ ಕಾಹೆ. ಕತೋಬಿ ನವೇಥಿ ಪೈದಾಹುವಾನುಸ್ ಮುಖ್ಯ ಹುಯಿರ‍್ಹುಸ್. <verse eid="GAL 6:15"/><verse number="16" style="v" sid="GAL 6:16"/>ಆ ನಿಯಮ್ ಅಖ್ಖಾನ ಬರೊಬರ್‌ಥಿ ಚಾ಼ಲವಾಳ ಅಖ್ಖಾಸ್ನ ಅಜು಼ ಇಸ್ರಾಯೇಲ್‌ವಾಳ ದೇವ್ನ ಅದ್ಮಿವ್‌ನ ಸಮಾಧಾನ್‍ಬಿ ಗೋರ್‌ಬಿ ಮಳಾದೆ! <verse eid="GAL 6:16"/><verse number="17" style="v" sid="GAL 6:17"/>ಅನೇಥಿ ಪಾರ್ ಮನ ಕೋಣ್‌ಬಿ ಖ್ಹತಾವ್ಣುನಾ. ಮಾರ ಶರೀರ್‌ಮ ಯೇಸು ಕ್ರಿಸ್ತನು ಖ್ಹಣೇದ್ನ ನಖೈರಾಖ್ಯೊಸ್. <verse eid="GAL 6:17"/><verse number="18" style="v" sid="GAL 6:18"/>ಭೈಯೇ ಭೇನೆವೊ, ಅಪ್ಣೊ ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತನೊ ವಾರ್‌ಖ್ಹೊ ತುಮಾರ ಆತ್ಮನಿ ಜೋ಼ಡ್ಮ ರ‍್ಹವಾದೆ. ಆಮೆನ್.<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
