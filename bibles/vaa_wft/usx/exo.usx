<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EXO" style="id">- Waghri Vathe</book>
  <para style="h">ವಿಮೋಚನಕಾಂಡ</para>
  <para style="toc3">ವಿಮೋ</para>
  <para style="toc2">ವಿಮೋ</para>
  <para style="toc1">ಮೋಶೇನೆ ಲೀಖ್ಯೋತೆ ವಿಮೋಚನಕಾಂಡ ಪುಸ್ತಕ</para>
  <para style="mt2">ಮೋಶೆನೆ ಲೀಖ್ಯೊತೆ ವಿಮೋಚನಕಾಂಡ ಪುಸ್ತಕ</para>
  <para style="mt1">ಮೋಶೆನೆ ಲೀಖ್ಯೊತೆ ವಿಮೋಚನಕಾಂಡ ಪುಸ್ತಕ</para>
  <para style="imt">ಮಾಲುಮ್ ಕರಾನು</para>
  <para style="ip">ವಿಮೋಚನಕಾಂಡ ಪುಸ್ತಕ್‌ ಆದಿಕಾಂಡಮ ಶುರುಹುಯುತೆ ಅಬ್ರಹಾಮ್ನ ಕುಟುಂಬಾನ ಹಗಾಮ್ನ ಅಗ್ಗಳ್ ಚ಼ಲಾವಸ್. ವಿಮೋಚನಕಾಂಡ ಕತೊ ‘ಬಹರ್‌ ನಿಕ್ಳಾನು’ ಇಸ್ರೇಲ್‌ ದೇಖ್ಹ್‌ನ ಪಾಛ಼ುಆವಾನು ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಬಹರ್‌ ನಿಕ್ಳಾನು ಖ್ಹಮ್‌ಜಾ಼ಡಸ್‍. ದೇವ್ನೆ ಅಬ್ರಹಾಮ್ನ ವಾಗ್ದಾನ್ ಕರಿರಾಖ್ಯೊಥೊ. ಪದತ್ತಿನಿಘೋಣಿ ಪಢಂತಿಖ್ಹಾರು ವಿಮೋಚನಕಾಂಡ ಪುಸ್ತಕ್‌ಥು ಜಾ಼ಖ್ಹತ್ ಭಾಗ್‌ ವಿಶ್ವಾಸ್ ಕರಸ್. ಪ್ರವಾದಿ ಮೋಶೆನೆ ಲೀಖಿರಾಖ್ಯೊಸ್ ಅಜು಼ ಪಢಾಥಿಸ್ ವತಾಳಿರಾಖ್ಯಸ್. ವಿಮೋಚನಕಾಂಡ 24:4 ಕಿಮ್ ಬೋಲಸ್. ಮೋಶೆ ಪುಸ್ತಕಾನ ಭಾಗ್‌ ಲೀಖ್ಯೊ. ಯೆಹೋಶುವ 8.31 ಮ ವಿಮೋಚನಕಾಂಡ 20.25 ಮ ಛಾ಼ತೆ ಹುಕುಮ್‌ನ ಛೋ಼ಡಿ ವತಾಳಸ್ ಅಜು಼ ಬೋಲಸ್. ಯೊ “ಮೋಶೆನ ಧರ್ಮಶಾಸ್ತ್ರ ಪುಸ್ತಕಮ” ಲೀಖೈರ‍್ಹುಸ್. ನವು ಒಪ್ಪಂದಾನನು ಲೀಖೈರ‍್ಹುಸ್ತೆ ಬೋಲಿ ವತಾಳಸ್ ಮೋಶೆ ಕೈಯೇಕ್‌ ಹಲ್ಲ ಉದಾಹರಣೆನ ಲೀಖಾನುವಖ್ಹ್‌ತೆ ಡಾಗ್‌ಮ ಶಾತ್‍ ಹುಯೂಥುಕರಿ ಬೋಲಾನು ಅಜು಼ ಲೀಖೈರ‍್ಹುಸ್. ಯೊ “ಮೋಶೆ ಪುಸ್ತಕಮ” ಲೀಖೈರ‍್ಹುಸ್. (ಮಾರ್ಕ 12:26). ಈಜಿಪ್ಟ್‌ಥು ಇಸ್ರೇಲ್‌ಮ ನಿಕ್ಳಿಆಯುತೆ ರ‍್ಹೇವ್ಣು. ಖ್ಹಮಾರ್‌ 1300 ನತರ್ 1400 ವರಖ್ಹ್‌ ಎತ್ರೆ ಪೀಛೆ 1 ರಾಜ಼ 6:1 ಮ ಬಹಾರ್‌ ನಿಕ್‌ಳ್ಯುತೆ 480 ವರಖ್ಹ್‌ ಹಗಾಮ್‌ ಚಾ಼ಲ್ಯು ಕರಿ ಬೋಲಸ್. ಇಸ್ರಾಯೇಲ್ನು ರಾಜ಼ ಸೊಲೊಮೋನನು ರಾಜ಼್‌ಭಾರ್‌ನು 4 ನ ವರಖ್ಹ್‌ನು ಪಹಿಲೆ. ಅಬ್ರಹಾಂ, ಇಸಾಕ್ ಅಜು಼ ಯಾಕೋಬನ ಇನು ವಾಗ್ದಾನ್ನ ಕಿಮ್ ಪಾಲನ್ ಕರುಕರ್ತೊಥೊಕರಿ ವಿಮೋಚನಕಾಂಡ ಜಾ಼ಖ್ಹತ್ ಬೋಲಸ್. ಆದೇವ್ನಿ ಬಾರೇಮ ಬೋಲಸ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಅಬ್ರಹಾಮ್‌ನ ಖಾನ್‌ಧಾನ್‌ವಾಳ ಇಸ್ರೇಲ್‌ನ ದೇಖ್ಹ್‌ನು ಮೋಟಿ ಛುಟ್ಕಾರ್ (ವಿಮೋಚನಕಾಂಡ 1-12). ಹಿಜ಼್ಜಾಥು ದೇವ್ನೆ ಇನ ಅದ್ಮಿನ ಸಿನಾಯ್‌ ಪರ್ಭತ್‌ಕನ ಬುಲೈಲಿಗಯೊ ಹಿಜ಼್ಜ ಇನೆ ಮೋಶೆನ ಕೈಯೇಕ್ ಖಾನೂಲ್‌ನ ದಿದೊ. ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಪಾಡಿಚಾ಼ಲನ ವಿಮೋಚನಕಾಂಡ 12-19. ಆ ಖಾನೂಲ್‌ ಕಿಮ್ ಚಾ಼ಲ್ನು ಕಿಮ್ ಕರ‍್ನುಕರಿ ಬೋಲಾನು ಪ್ರಕಟ್‌ಕರಸ್‌. ತ್ಯಾಗಖ್ಹಾರು ಅಜು಼ ಡೇರಾನ ಘರ್‌ನ ಭಾಂದಾನ ತರೀಖಾ ಆ ದೇವ್‌ ರ‍್ಹವಾನು ಝ಼ಗೊಹುಯಿರ‍್ಹಿಥಿ. ಡೇರಾನ ಘರ್ಮ ಪೂಜ಼ಕರಾನಖ್ಹಾಜೆ ಪಿಟಾರೊ ಅಜು಼ ಇನು ಜಿನಖ್ಹ್‌ ಅಜು಼ ಯಾಜಕ್‌ನು ಪೆರ್ವಾಖ್ಹ್‌ ವಿಮೋಚನಕಾಂಡ 20-31. ಇನವಾರ್‌ ಮೋಟಿ ಜಂಗ್‌ನವಾರ್‌ ಇಸ್ರಾಯೇಲ್‌ ಎಕ್ ಕೆಲ್ಡಾನು ಖ್ಹೊನ್ನಾನು ಮೂರತ್ನ ಬಣಾಯು. ಮೋಶೆನೆ ದೇವ್ನ ಮಳ್ಯೊ (ವಿಮೋಚನಕಾಂಡ 32-33). ಪುಸ್ತಕ್‌ನ ಅಂತಿಮ್‌ ಭಾಗ್‌ಮ ಕಿಮ್ ಆ ಅಖ್ಖಿ ಚೀಜ಼್‌ನ ಫಡಿಶ್‌ಕರಿ ಪೀಠೆ ಬೋಲಿವತಾಳ್ಯತೆ ತಿಮ್ ತಯ್ಯಾರ್‌ಕರಿರಾಖ್ಯಸ್(ವಿಮೋಚನಕಾಂಡ 33-40).</para>
  <para style="iot">ಕಾಡಿದೇಖೊ</para>
  <para style="io1">1. ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಇಸ್ರಾಯೇಲ್‌ ದೇಖ್ಹ್‌ಮ ಕಿಮ್ ಆಳ್‌ ಹುಯಿರ‍್ಹುಥುಕರಿ ಅದ್ಯಾಯ 1 ಬೋಲಿವತಾಳಸ್.</para>
  <para style="io1">2. ಅದ್ಯಾಯ 2 ಥು 4 ಲಗು ಮೋಶೆನಿ ಬಾರೇಮ ಬೋಲಸ್ ಅಜು಼ ಯೊ ಬುಲೈರ‍್ಹೊತೆ ವೇಳ್‌ಲಗು ಇನು ಜಿವ್ಣಾನಿ ಬಾರೇಮ ಬೋಲಸ್.</para>
  <para style="io1">3. ಇನವಾರ್‌ ಲಿಖಾಪಟ್‌ಕರಾವಳನೆ ಈಜಿಪ್ಟ್‌ಮ ಕಿಮ್ ಇನ ಅದ್ಮಿಯೇನ ಯೊ ದೇಖ್ಹ್‌ಥು ಅಜು಼ ಫರೋಹನ ಶಿಪಾಯ್‌ಥು ಛೋ಼ಡೈನ್ ದೇವ್ನ ಅದ್ಮಿನ ಪೋಚಾ಼ವನ ಮೋಟಿ ಅದ್ಭುತ್‌ ಅಜು಼ ಖ್ಹತಾಪ್ಣಿಯೇವ್ನ ದಿದೊಕರಿ ಬೋಲಿ ವತಾಳಸ್ (ಅದ್ಯಾಯ 5:15-21).</para>
  <para style="io1">4. ಹಜ಼್ಜಾಥು ಇಸ್ರೇಲ್‌ ದೇಖ್ಹ್‌ ಸೀನಾಯಿ ಪರ್ಭತ್‌ನ ಚಾ಼ಲ್‌ಕುಚ಼್‌ ಕರ‍್ಯು (ಅದ್ಯಾಯ 15:22-19).</para>
  <para style="io1">5. ಅದ್ಯಾಯ 20 ಥು 31 ಲಗು ದೇವ್ನೆ ಮೋಶೆನ ಕಿಮ್ ಹುಕುಮ್‌ ದಿದೊಕರಿ ಬೋಲಾನು ಫಡಿಯೇಸ್. ಅಜು಼ ದೇವ್ನು ಅದ್ಮಿಯೇ, ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಕಿಮ್ ಜಿವ್ಣು ಅಜು಼ ಆರಾದನೆ ಕರ‍್ನುಕರಿ ವಾತೆಖ್ಹಾರು ಅನಾಮ ಘಣು ಛಾ಼.</para>
  <para style="io1">6. ಮೋಶೆನೊ ಭೈ ಆರೋನನ ಪೊಖ್ಹ್‌ಲೈನ್ ಖ್ಹೊನ್ನಾನ ಕೆಲ್ಡಾನ ಮೂರತ್ ಬಣಾವನ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ದೇವ್ನಿ ವಿರೋದ್‌ ಜಂಗ್‌ನ ಭೀರ‍್ಯುಕರಿ ಅದ್ಯಾಯ 32 ಮ ಲೀಖೈರ‍್ಹುಸ್.</para>
  <para style="io1">7. ಅದ್ಯಾಯ 33 ಥು 40 ಲಗು ಮೋಶೆನೆ ದೇವ್ನಿ ಮಹಿಮೇನ ಕಿಮ್ ದೇಖ್ಯೊಕರಿ ಅಜು಼ ಇನವಾರ್‌ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಕಿಮ್ ಬೋಲಿವತಾಳ್ಯೊ ದೇವ್ನಿ ನಿಯಮ್‌ ಅಜು಼ ಆರಾದನೆನಖ್ಹಾಜೆ ಡೇರನಾಬಿ ದೇವ್ನ ಪಿಟಾರನಬಿ ಯಾಜಕ್‌ನು ವಿಶೇಷ್‌ ಲುಂಗ್‌ಡ ಅಜು಼ ಖ್ಹಾರು ಜಿನಖ್ಹ್‌ನ ಕಿಮ್ ಕರ‍್ನುಕರಿ.</para>
  <chapter number="1" style="c" sid="EXO 1" />
  <para style="s">ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಖ್ಹತ್ಯುತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 1:1" />`ಯಾಕೋಬನಿ ಜೋ಼ಡ್ಮ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಇವ್ಣ ಇವ್ಣ ಘರ್‌ವಾಳಾನ ಕೇಡೆ ಆಯಾತೆ ಇಸ್ರಾಯೇಲ್‌ನು ಪರ್ಖ್ಹಾ ಲಡ್ಕಾವ್ನು ನಾಮ್‌ಖ್ಹಾರು: <verse eid="EXO 1:1" /><verse number="2" style="v" sid="EXO 1:2" />ರೂಬೇನ್, ಸಿಮೆಯೋನ್‌, ಲೇವಿ, ಯೆಹೂದ, <verse eid="EXO 1:2" /><verse number="3" style="v" sid="EXO 1:3" />ಇಸ್ಸಾಕಾರ್, ಜೆಬುಲೂನ್ ಅಜು಼ ಬೆನ್ಯಾಮೀನ್; <verse eid="EXO 1:3" /><verse number="4" style="v" sid="EXO 1:4" />ದಾನ್, ಗಾದ್, ನಫ್ತಾಲಿ ಅಜು಼ ಆಶೇರ್. <verse eid="EXO 1:4" /><verse number="5" style="v" sid="EXO 1:5" />ಯಾಕೋಬನು ಅಖ್ಖಿ ಪಿಳ್ಗಿವಾಳು ಒಟ್‌ ಖ್ಹಡ್‌ತೀನಿಖ್ಹ್ ಜ಼ಣು ಕತೋಬಿ ಯೋಸೇಫಾನೆ ಪಹಿಲೇಸ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮಾಸ್ ಥೊ. <verse eid="EXO 1:5" /><verse number="6" style="v" sid="EXO 1:6" />ಇನಪಾರ್ ಯೋಸೇಫಾಬಿ ಇನೊ ನ್ಹಾನೊ ಭೈ ಅಜು಼ ಮೋಟೊ ಭೈಬಿ, ಯೊ ಪಿಳ್ಗಿವಾಳು ಖ್ಹಾರು ಮರಿಗಯು. <verse eid="EXO 1:6" /><verse number="7" style="v" sid="EXO 1:7" />ಕತೋಬಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಲಡ್ಕಾವ್ ಘಣೇಥು ಭಡ್‌ತು ಹುಯಿನ್ ಘಣಿ ಗಣ್ತಿಮ ಭಡಿನ್ ಘಣು ಶಕತ್ ಲೀಲಿದು ಅಜು಼ ದೇಖ್ಹಸ್‌ ಅಖ್ಖು ಇವ್ಣೇಥಿ ಭರೈಗು. <verse eid="EXO 1:7" /><verse number="8" style="v" sid="EXO 1:8" />ಇನವಾರ್ ಯೋಸೇಫಾನ ಮಾಲುಮ್‌ ಕರಿರಾಖ್ಯೊಕೊಂತೆ ನವೊ ರಾಜ಼ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಚ಼ಲಾವನ ಆಯೊ. <verse eid="EXO 1:8" /><verse number="9" style="v" sid="EXO 1:9" />ರಾಜ಼ ಇನ ಅದ್ಮಿನ, “ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಜಾ಼ಖ್ಹತ್ ಜ಼ಣು ಛಾ಼ ಅಜು಼ ಅಪ್ಣೆಥೀಬಿ ಘಣು ಅಜು಼ ಅಪ್ಣೇಥಿ ಶಕತ್‌ವಾಳುಬಿ ಹುಯಿರುಸ್ ದೇಖೊ”. <verse eid="EXO 1:9" /><verse number="10" style="v" sid="EXO 1:10" />ಜಂಗ್ ಶಾತ್ತೊಬಿ ಹುಯುತೊ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಅಪ್ಣ ವಹೇರ‍್ಯಾವ್ನಿ ಜೋ಼ಡ್ಮ ಮಳಿಜೈ಼ನ್ ಹಮುನ ಹರೈನ್ ಹಮಾರೇಥಿ ಛು಼ಕಿ ಚ಼ಲ್ಯುಜಾಷೆ. ಇನಖ್ಹಾಜೆ ಇವ್ಣೆ ಭಡ್ಣುನಾತೆ ತಿಮ್ ಅಪ್ಣೆ ಉಪಾಯ್ ಕರಿಯೆ”ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 1:10" /><verse number="11" style="v" sid="EXO 1:11" />ಇಮ್ಮಸ್ ಇನು ಅದ್ಮಿವ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಖ್ಹತಾಪ್ಣಿ ದ್ಯಾವಲಗ್ಯು. ಫುಗಟ್‌ಥಿ ಕಾಮ್ ಕರೈಲಿದು. ಚು಼ಪ್ಕೆ ಕಾಮ್ ಕರಾವನ ಅದಿಕಾರಿಯೇವ್ನ ನೇಮ್‌ಶೈನ್ ಫರೋಹನ ‘ಪಿತೋಮ್ ಅಜು಼ ರಾಮ್ಸೇಸ್’ ಕರಿ ಕಣಗಿ ಕೋಠಾನ ಖ್ಹಯೇರ್‌ನ ಭಂದಾಯೊ. <verse eid="EXO 1:11" /><verse number="12" style="v" sid="EXO 1:12" />ಈಜಿಪ್ಟ್‌ವಾಳು ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಕೆತ್ರೆ ಖ್ಹತಾಪ್ಣಿ ದಿದೂಕಿ ಜಾ಼ಖ್ಹತ್ ಹುಯಿನ್ ಫೈಲೈರ‍್ಹುತೆ ಖ್ಹಾಜೆ ಈಜಿಪ್ಟ್‌ವಾಳು ಇಸ್ರಾಯೇಲ್‌ವಾಳಾನಿ ಬಾರೇಮ ಘಣು ಡರ‍್ಯು. <verse eid="EXO 1:12" /><verse number="13" style="v" sid="EXO 1:13" />ಈಜಿಪ್ಟ್‌ವಾಳು ಇಸ್ರಾಯೇಲ್‌ವಾಳಥಿ ಕಠಣ್‌ಥಿ ರಬೈಲಿದು. <verse eid="EXO 1:13" /><verse number="14" style="v" sid="EXO 1:14" />ಮಾಟಿ ಖೋಂದಾನ ಕಾಮ್ಮಬಿ, ಇಟ್ಕೆ ಕರಾನ ಕಾಮ್ಮಬಿ, ನಾಗ್ರಾನು ಅಜು಼ ಇನು ಬಿಜು಼ ಅಖ್ಖೀಸ್ ಥರಾನು ಚಾ಼ಕ್ರಿಮ ಕಠಣ್‌ಥಿ ರಬಾಡಿನ್ ಇವ್ಣ ಜಿವ್ಣನಾಸ್ ಖಟು ಕರೈನಾಖ್ಯು. ಈಜಿಫ್ಟ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳಥಿ ಕರಾಯುತೆ ಅಖ್ಖುಕಾಮ್ ಘಣು ಕಠಣ್ ಹುಯಿರ‍್ಹುಥು. <verse eid="EXO 1:14" /><verse number="15" style="v" sid="EXO 1:15" />ಅತ್ರೇಸ್ ಕಾಹೆತೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ರಾಜಾ಼ನೆ “ಶಿಪ್ರಾ” ಅಜು಼ “ಪೂಗ” ಕರಿ ನಾಮ್ನಿ ಬೇಜ಼ಣಿನ ಮದತ್‌ಕರಿನ್, ಇವ್ಣುನ ಇಬ್ರಿಯಾನ ಲಡ್ಕಾವ್ನ ಜ಼ಣಾವವಾಳಿನ ಜೋ಼ಡೆ ವಾತೆ ಬೊಲ್ಯೊ. <verse eid="EXO 1:15" /><verse number="16" style="v" sid="EXO 1:16" />ಇನೆ ಇವ್ಣುನ, “ತುಮೆ ಇಬ್ರಿಯಾನಿ ತಯೇಡಾವ್ನ ಜ಼ಣಾವನಿ ವಖ್ಹ್‌ತೆ ಇವ್ಣೆ ಜ಼ಣಾತೆ ಲಡ್ಕು ಪರ್ಖ್ಹೊ ಲಡ್ಕು ಹುಯಿರ‍್ಹುತೊ ಮಾರಿನಾಖಿದೆವೊ, ತಯೇಡ ರ‍್ಹಯೂತೊ ಬಚಾ಼ನ ಮ್ಹೇಲೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 1:16" /><verse number="17" style="v" sid="EXO 1:17" />ಕತೋಬಿ ಜ಼ಣಾವವಾಳಿಯೆ ದೇವ್‌ಥಿ ಡರಿನ್ ಈಜಿಪ್ಟ್‌ನ ರಾಜ಼ವ್ನ ವಾತ್ನಿತರ ಕೋಕರ‍್ಯೆನಿತೆ ಪರ್ಖ್ಹಾ ಲಡ್ಕಾವ್ನ ಜಾನ್‌ಥಿ ಬಚಾ಼ಡ್ಯು. <verse eid="EXO 1:17" /><verse number="18" style="v" sid="EXO 1:18" />ತದೆ ಈಜಿಪ್ಟ್‌ನೊ ರಾಜ಼ ಜ಼ಣಾವವಾಳಿಯೇನ ಬುಲೈನ್ “ತುಮೆ ಇವ್ಣ ಪರ್ಖ್ಹಾ ಲಡ್ಕಾವ್ನ ಬಚಾ಼ಡಿಶನ? ಅಮ್ ಶನ ಕರಿಯೆ?” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 1:18" /><verse number="19" style="v" sid="EXO 1:19" />ಜ಼ಣಾವವಾಳಿಯೆನೆ ಫರೋಹಾನು “ಇಬ್ರಿಯಾನಿ ತಯೇಡ ಈಜಿಪ್ಟ್‌ನಿ ತಯೇಡನಿತರ ಕಾಹೆ, ಘಣು ಚಾ಼ತುರ್ ಅಕ್ಕಲ್‌ವಾಳು, ಜ಼ಣಾವವಾಳಿಯೆ ಆವಾನ ಅಗ್ಗಳಸ್ ಲಡ್ಕಾವ್ನ ಜ಼ಣಿಲೇತಿಥಿ” ಕರಿ ಬೋಲ್ಯು. <verse eid="EXO 1:19" /><verse number="20" style="v" sid="EXO 1:20" />ಇನಖ್ಹಾಜೆ ದೇವ್ನೆ ಯೊ ಜ಼ಣಾವವಾಳಿಯೇನ ದಯಾ ಕರ‍್ಯೊ. ಅನೇಥಿ ಇಸ್ರಾಯೇಲ್ನು ಅದ್ಮಿ ಜಾ಼ಖ್ಹತ್‌ಹುಯಿನ್ ಘಣು ತಾಖಥಿ ಹುಯು. <verse eid="EXO 1:20" /><verse number="21" style="v" sid="EXO 1:21" />ಜ಼ಣಾವವಾಳಿಯೆ ದೇವ್‍ಥಿ ಡರಿಯೇತೆಖ್ಹಾಜೆ, ಇನೆ ಇವ್ಣಿ ಪಿಳ್ಗಿನ ಭಡಾಯೊ. ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಜಾ಼ಖ್ಹತ್ ಶಕತ್‌ವಾಳು ಹುಯು. <verse eid="EXO 1:21" /><verse number="22" style="v" sid="EXO 1:22" />ಇನವಾರ್ ಫರೋಹಾನೆ ಇನ ಅದ್ಮಿವ್‌ನ, “ಇಬ್ರಿಯವಾಳನು ಪೈದಾಖ್ಹ್‌ನ ಪರ್ಖ್ಹಾ ಲಡ್ಕಾವ್ನ ನೈಲ್ ನದ್ದೀಮ ನಾಕ್ಣು’ ತಯೇಡ ಲಡ್ಕಾವ್ನ ಮ್ಹೇಲಿದೇವ್ಣು” ಕರಿ ಹುಕುಮ್ ಕರ‍್ಯೊ.<verse eid="EXO 1:22" /></para>
  <chapter eid="EXO 1" />
  <chapter number="2" style="c" sid="EXO 2" />
  <para style="s">ಮೋಶೆನು ಪೈದಾಖ್ಹ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 2:1" />ಇನವಾರ್ ಲೇವಿನೊ ಖಾನ್‌ದಾನ್‌ವಾಳೊ ಏಕ್‌ಜ಼ಣೊ ಲೇವಿನು ಖೂಮ್‌ನಿ ಕವಾರಿನ ವ್ಯಹಾಕರ‍್ಯೊ. <verse eid="EXO 2:1" /><verse number="2" style="v" sid="EXO 2:2" />ಯೊಹೈರಿತೆ ಬೇಜೂನಿ ಹುಯಿನ್ ಪರ್ಖ್ಹಾ ಲಡ್ಕಾನ ಪೈದಾಕರಿ. ಯೊ ಶನ್‌ಗಾರ‍್ನು ಲಡ್ಕುಕರಿ ಮಾಲುಮ್ ಕರಿನ್ ತೀನ್ ಮಹಿನ ಇನ ಲಪಾಡಿರಾಖಿಥಿ. <verse eid="EXO 2:2" /><verse number="3" style="v" sid="EXO 2:3" />ಹೈರಿತೆನೆ ಇನ ಬಿಜು಼ ಜಾ಼ಖ್ಹತ್ ಆಖ್ಹ್‌ರಾಮ ರಾಖನ ಕೊಹುವಾನಿತೆ, ಖ್ಹರ್ಕಿನ ಪಿಟಾರನ ಪಾಡಿಲಿನ್ ರೇಗ್ಡಿನಿ ಮಾಟಿಬಿ ಗೋಂದ್‌ನ ಲಗಾಡಿನ್ ಲಡ್ಕಾನ ಇನಾಮ ಖ್ಹುವಾಡಿನ್, ನೈಲ್ ನದ್ದಿನ ಕನಾರಿನು ಘಾಖ್ಹ್‌ಮ ಮ್ಹೇಲಿ. <verse eid="EXO 2:3" /><verse number="4" style="v" sid="EXO 2:4" />ಲಡ್ಕಾನ ಶಾತ್ ಉಷೆಕರಿ ಮಾಲುಮ್‌ ಕರಿಲ್ಯಾವನಖ್ಹಾಜೆ ಯೊ ಲಡ್ಕಾನಿ ಭೇನ್‌ ಜ಼಼ರಾ ದೂರ್ ಭೀರಿಗೈ. <verse eid="EXO 2:4" /><verse number="5" style="v" sid="EXO 2:5" />ಎತ್ರಾಸ್ಮ ಫರೋಹನಿ ಛೋ಼ರಿ ಪಾಣಿ ನ್ಹೊವಾನ ನೈಲ್ ನದ್ದಿಕನ ಆಯಿ. ಇನಿ ಚಾ಼ಕ್ರಿ ಕರಾವಳಿಯೆ ನದ್ದಿನ ಕನಾರೆನ ಫರ್ತುಫಂಡ್‌ತಿಥಿಯೆ. ಇನೆ ಖ್ಹರ್ಕಿನು ಘಾಖ್ಹ್‌ನು ಪಿಟಾರನ ದೇಖಿನ್ ದಾಸಿನ ಏಕ್‌ಜ಼ಣಿನ ಮೋಕ್ಲಿನ್ ಇನ ಪಡೈ ಮಂಗೈ. <verse eid="EXO 2:5" /><verse number="6" style="v" sid="EXO 2:6" />ಪಿಟಾರನ ಕಾಡಿನ್ ದೇಖಾನಿ ವಖ್ಹ್‌ತೆ, ಆಹಾ! ರೋವಾಳು ಲಡ್ಕು ಹೈರಿತೆನ ಇನಾಪರ್ ಗೋರ್‌ಹುಯಿನ್ “ಆ ಇಬ್ರಿಯಾನ ಲಡ್ಕವಾಳಮ ಎಕ್ ರ‍್ಹೇವ್ಣು” ಕರಿ ಲಹಿಗಿ. <verse eid="EXO 2:6" /><verse number="7" style="v" sid="EXO 2:7" />ತದೇಸ್‌ ಲಡ್ಕಾನಿ ಭೇನ್ ಅಯಿನ್ “ಫರೋಹನಿ ಛೋ಼ರಿನ, ತಾರಖ್ಹಾಜೆ ಆ ಲಡ್ಕಾನ ದೂದ್ ಪಿಡೈನ್ ಪಾಳಾನ ಇಬ್ರಿಯ ತಯೇಡಾವ್ಮ ಎಕ್ ದಾದಿನ ಮೇ ಬುಲೈಲಿನ್ ಆವ್‌ಕಿಶು?” ಕರಿಬೋಲಿ. <verse eid="EXO 2:7" /><verse number="8" style="v" sid="EXO 2:8" />ಫರೋಹನಿ ಛೋ಼ರಿ ಇನ, “ಜಾ಼ ಬುಲೈಲಿನ್ ಆವ್” ಕರಿಬೋಲಿ. ಛೋ಼ಕ್ರಿ ಜೈ಼ನ್ ಲಡ್ಕಾನಿ ಆಯಾನಸ್ ಬುಲೈಲಿನ್ ಆಯ್. <verse eid="EXO 2:8" /><verse number="9" style="v" sid="EXO 2:9" />ಫರೋಹನಿ ಛೋ಼ರಿ ಲಡ್ಕಾನಿ ಆಯಾನ, “ಆ ಲಡ್ಕಾನ ಪಾಡಿಲಿಜೈ಼ನ್ ಮಾರಖ್ಹಾಜೆ ದೂದ್ ಪಿಡೈನ್ ಪಾಳ್‌ನು. ಮೇ ತುನ ಪಗಾರ್ ದೆವುಸ್‌” ಕರಿಬೋಲಿ. ಯೊ ತಯೇಡಾನೆ ಲಡ್ಕಾನ ಲೀಜೈ಼ನ್ ಪಾಳಿ. <verse eid="EXO 2:9" /><verse number="10" style="v" sid="EXO 2:10" />ಯೊ ಲಡ್ಕು ಶಾಣು ಹುವಾನಿ ವಖ್ಹ್‌ತೆ ಇನ ಫರೋಹನಿ ಛೋ಼ರಿಕನ ಲೀನ್ಆಯಿ. ಯೊ ಇನ ಛಿಯ್ಯೊ ಹುಯೊ, “ಅನ ಪಾಣಿನ ಮಹಿಥು ಖೇಚಿಕಾಡಿಕರಿ ಇನುನಾಮ್ ಮೋಶೆ<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">ಮೋಶೆ ಕತೊ ಪಾಣಿಮಾಥೊ ಖೇಚಾ಼ಯೊಹುಯೊಕರಿ ಇನಿ ಮತ್ಲಬ್</char></note>” ಕರಿಮ್ಹೇಲಿ.<verse eid="EXO 2:10" /></para>
  <para style="s">ಮೋಶೆ ಮಿದ್ಯಾನ್ ದೇಖ್ಹ್‌ನ ಮಿಲೈಗಯೋತೆ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 2:11" />ಮೋಶೆ ಶಾಣುಹುವಾನಪರ್, ಶೊಂತ್ ಅದ್ಮಿಕನ ಜೈ಼ನ್ ಇವ್ಣೆ ಫುಗಟ್‌ನು ಕಾಮ್ಕರಿನ್ ಖ್ಹತುಕರ್ಥುತೆ ದೇಖ್ಯೊ. ತದೆ ಈಜಿಪ್ಟ್‌ವಾಳನೆ ಇನ ಶೊಂತ್ ಅದ್ಮಿವ್ ಹುಯಿರ‍್ಹಾತೆ ಏಕ್‌ಜ಼ಣೊ ಇಬ್ರಿಯವಾಳನ ಮಾರಿನಾಖನು ದೇಖ್ಯೊ. <verse eid="EXO 2:11" /><verse number="12" style="v" sid="EXO 2:12" />ಮೋಶೆ ಹೈಕಡ್ ಹಿಕಡ್ ದೇಖಿನ್ ಕೋಣ್ಬಿ ಕೊಯ್ನಿಕರಿ ಮಾಲಮ್‌ಕರಿನ್ ಯೊ ಈಜಿಪ್ಟ್‌ವಾಳನ ಮಾರಿನಾಖಿನ್ ಇನ ಮಖ್ಹಾಣ್ಯನ ರೇತಿಮ ಮೂಚಿನಾಖ್ಯೊ. <verse eid="EXO 2:12" /><verse number="13" style="v" sid="EXO 2:13" />ಇನವ್ಹಾಣೆ ಇನೆ ಪಾಛು಼ ಭಾರ್‌ ಜಾ಼ವಖ್ಹತರ್, ಇಬ್ರಿಯವಾಳು ಬೇಜ಼ಣು ಲಡೈ ಕರುಕರ್ತುಥು. ಗಲತ್‌ ಕರವಾಳನ ಯೊ “ಶಾತ್‌ಲಾ ತೂ ಶನಖ್ಹಾಜೆ ಶೊಂತ್ ಖಾನ್‌ಖೋಜ್‌ವಾಳನ ಮಾರುಕರಸ್?” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 2:13" /><verse number="14" style="v" sid="EXO 2:14" />ಯೊ ಅದ್ಮಿನೆ ಇನ “ತುನ ಹಮಾರಪರ್‌ ಅದಿಕಾರಿ ಕರೀನ್‌ಬಿ, ನ್ಯಾವ್ಣೊ ಕರೀನ್‌ಬಿ, ಮ್ಹೇಲಿರಾಖ್ಯುತೆ ಕೋಣ್? ಯೊ ಈಜಿಪ್ಟ್‌ವಾಳನ ಮಾರಿನಾಖನಿತರಸ್, ಮನಾಬಿ ಮಾರಿನಾಕ್ಣು ಕರಿ ಛಾ಼ಕಿಶು? ಕರಿ ಬೊಲ್ಯೊ. ಆ ವಾತ್ನ ಖ್ಹಮ್‌ಜಿನ್ ಮೋಶೆನೆ, “ಮೇ ಕರ‍್ಯೊತೆ ಕಾಮ್ ಮಾಲುಮ್ ಹುಯಿಗುನಿ!” ಕರಿ ಡರಿಗೊ. <verse eid="EXO 2:14" /><verse number="15" style="v" sid="EXO 2:15" />ಚಾ಼ಲ್ಯುತೆ ಖಬರ್ ಫರೋಹಾನ ಮಾಲುಮ್‌ಪಡಾನಿ ವಖ್ಹ್‌ತೆ ಯೊ ಮೋಶೆನ ಮರೈನಾಖಿದೇವ್ಣು ಕರಿ ಸೋಚಖ್ಹತರ್, ಕತೋಬಿ ಮೋಶೆ ಫರೋಹಕಂಥು ನಾಶಿಜೈ಼ನ್ ಮಿದ್ಯಾನ್ ದೇಖ್ಹ್‌ನಿ ಬಾವ್ಡಿಕನ ಬೇಶಿಗೊ. <verse eid="EXO 2:15" /><verse number="16" style="v" sid="EXO 2:16" />ಮಿದ್ಯಾನ್ನು ಯಾಜಕನಿ ಖ್ಹಾತ್‌ಜ಼ಣಿ ಛೋ಼ಕ್ರಿಯೆ ಹಿಜ಼್ಜ ಅಯ್ಯೆ. ಇವ್ಣ ಬಾನ ಮೇಂಢಾವ್ನ ಪಾಣಿ ಪಿಡಾವನಖ್ಹಾಜೆ, ಪಾಣಿ ಶೇಂದಿನ್ ಬಾನೇಮ ಭರುಕರ್ತಿಥಿಯೆ. <verse eid="EXO 2:16" /><verse number="17" style="v" sid="EXO 2:17" />ಎತ್ರಾಮ ಮಂಧಾನ ದೇಖವಾಳು ಐನ್ ಇವ್ಣುನ ಬಾವ್ಡಿಕಂಥು ನಖ್ಹಾಡಮ ಮೋಶೆ ಇವ್ಣುನ ಮದತ್‌ವಾಳೊಹುಯಿನ್ ಆಯಿನ್ ಇವ್ಣ ಮೇಂಢಾವ್ನ ಪಾಣಿ ಪಿಡಾಯೊ. <verse eid="EXO 2:17" /><verse number="18" style="v" sid="EXO 2:18" />ಇನವಾರ್ ಯೊ ಛೋ಼ಕ್ರಿಯೆ ಇವ್ಣ ಬಾಹುಯಿರ‍್ಹಾವಳೊ ರೆಗೂವೇಲಕನ ಆವಖ್ಹತರ್ ಇನೆ ಇವ್ಣುನ, “ಶನ ಹಮ್ಕೆ ಒಗ್ಗಿ ಕೊಆಯಥಾನಿ?” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 2:18" /><verse number="19" style="v" sid="EXO 2:19" />ಇನ ಅವ್ಣೆ, “ಈಜಿಪ್ಟ್‌ವಾಳೊ ಎಕ್ ಅದ್ಮಿ ಹಮುನ ಮಂಧವಾಳನ ಹಾತೇಥಿ ಛು಼ಕಾಯೊ ಕಾಹೆತೆ ಇನೆ ಹಮಾರಖ್ಹಾಜೆ ಪಾಣಿನ ಶೇಂದಿನ್ ಮೇಂಢಾವ್ನ ಪಿಡಾಯೊ.” ಕರಿಬೋಲಿಯೆ. <verse eid="EXO 2:19" /><verse number="20" style="v" sid="EXO 2:20" />ತದೆ ಯೊ ಇನ ಛೋ಼ರಿಯೇವ್ನ, “ಯೊ ಕಿಜ಼್ಜ ಛಾ಼? ಶನ ಯೊ ಅದ್ಮಿನ ಮ್ಹೆಂದಿನ್ ಐಗಯೆ? ಇನ ಬುಲಾವೊ ಯೊ ಅಪ್ಣ ಜೋ಼ಡೆ ಖಾಣು ಖಾವಾದೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 2:20" /><verse number="21" style="v" sid="EXO 2:21" />ಮೋಶೆ ಆ ಅದ್ಮಿನಿ ಜೋ಼ಡ್ಮ ಜಿವ್ಣುಕರಾನ ಆಖ್ಹ್ ಕರ‍್ಯೊ. ಯೊ ಯಾಜಕನೆ ಇನಿ ಛೋ಼ರಿ ಚಿಪ್ಪೋರನ ಮೋಶೆನ ವ್ಯಹಾಕರಿ ದಿದೊ. <verse eid="EXO 2:21" /><verse number="22" style="v" sid="EXO 2:22" />ಯೊ ಹೈರಿತೆನ ಪರ್ಖ್ಹೊ ಲಡ್ಕು ಪೈದಾಹುವಾಮ ಮೋಶೆನೆ “ಮೆ ಪರ್‌ದೇಖ್ಹ್‌ಮ ಎಕ್ ಪ್ರವಾಸಿ ಹುಯಿರ‍್ಹೋಸ್‌ಕರಿ ಬೋಲಿನ್ ಇನ ‘ಗೇರ್ಷೋಮ್’<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">ಗೇರ್ಷೋಮ್ ಕತೊ ದೇಖ್ಹ್‌ಫರಾವಳೊಕರಿ ಮತ್ಲಬ್‌</char></note> ಕರಿ ನಾಮ್ ಮ್ಹೇಲ್ಯೊ. <verse eid="EXO 2:22" /><verse number="23" style="v" sid="EXO 2:23" />ಅಮ್ ಘಣ ದನ್‌ಖ್ಹಾರು ನಿಕ್ಳಾನ ಬಾದ್ಮ ಈಜಿಪ್ಟ್‌ನೊ ರಾಜ಼ ಮರಿಗೊ. ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಇವ್ಣೆ ಕರ್ನುತೆ ಚು಼ಪ್ಕೇನ ಕಾಮ್ನಖ್ಹಾಜೆ ಖ್ಹಾಖ್ಹಾ ಕ್ಹೋಳಿ ಭಂದೈನ್ ರದನ್ ಕರುಕರ್ತುಥು ಯೊ ರದ್‌ನ್ಯಾ ದೇವ್‌ಕನ ಛಿಮಾಯಿ. <verse eid="EXO 2:23" /><verse number="24" style="v" sid="EXO 2:24" />ದೇವ್ ಇವ್ಣಿ ರದನ್ನ ಖ್ಹಮ್‌ಜಿನ್ ಇನೆ ಅಬ್ರಹಾಮ್, ಇಸಾಕ್, ಯಾಕೋಬ್‍ನ ಜೋ಼ಡೆ ಕರ‍್ಯೊಥೋತೆ ಒಪ್ಪಂದಾನ ಖ್ಹಯಾಲ್ಮ ಲಾಯೊ. <verse eid="EXO 2:24" /><verse number="25" style="v" sid="EXO 2:25" />ದೇವ್ನೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ದೇಖಿನ್ ಇವ್ಣಿ ಬಾರೇಮ ಗೋರ್‌ ಕರ‍್ಯೊ.<verse eid="EXO 2:25" /></para>
  <chapter eid="EXO 2" />
  <chapter number="3" style="c" sid="EXO 3" />
  <para style="s">ದೇವ್ನೆ ಮೋಶೆನ ಬುಲಾಯೊತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 3:1" />ಮೋಶೆ ಇನ ಮಾಮ, ಮಿದ್ಯಾನನೊ ಯಾಜಕ ಹುಯಿರ‍್ಹೋತೆ ಇತ್ರೋನನ ಮಂಧಾನ ಚ಼ರವ್‌ಕರಾನಿ ವಖ್ಹ್‌ತೆ ಯೊ ಮಂಧಾನ ಝಾ಼ಡಿನ ಬಿಜೇಕ್ ಭಾಗ್‌ಮ ಚ಼ಲೈನ್ ಜಾ಼ತೊಹುಯಿನ್, “ಹೋರೆಬ್” ಕರಿ ದೇವ್ನ ಪಹಾಡ್‌ಪರ್ ಆಯೊ. <verse eid="EXO 3:1" /><verse number="2" style="v" sid="EXO 3:2" />ತದೆ ಯೆಹೋವನೊ ದೂತ ಕಾಟಾನಿ ಡಾಗ್‌ಮಾಥು ಬಳಾತೆ ಆಗ್‍ನಿ ಝ಼ಲ್‌ಪಟೇಮ ಇನ ದೆಖಾಯೊ. ಮೋಶೆ ಡೋಳಪಾಡಿನ್ ದೇಖಾನಿವಖ್ಹ್‌ತೆ ಯೊ ಕಾಟಾನಿ ಡಾಗ್ ಆಗ್‌ಥಿ ಖ್ಹಲ್‌ಗುಕರ್ತುಥು; ಕತೋಬಿ ಯೊ ಬಳಿರ‍್ಹೂಥು ಕೊಯ್ನಿ. <verse eid="EXO 3:2" /><verse number="3" style="v" sid="EXO 3:3" />ತದೆ ಮೋಶೆ, “ಆ ಶನು ಆಶ್ಚರ್ಯ! ಡಾಗ್ ಬಳುಕರ ಕೊಯ್ನಿನಿ! ಅನ ಖನ್ನೆ ಜೈ಼ನ್ ದೇಖು ಕರಿ ಖ್ಹಯಾಲ್ ಕರ‍್ಯೊ. <verse eid="EXO 3:3" /><verse number="4" style="v" sid="EXO 3:4" />ಯೊ ಇನ ದೇಖಾನ ಖನ್ನೆ ಆವಾನು ಯೆಹೋವಾನೆ ದೇಖ್ಯೊ. ತದೆ ದೇವ್ನೆ ಡಾಗ್‌ಮಾಥು “ಮೋಶೆ, ಮೋಶೆ” ಕರಿ ಇನ ಚಿಕ್‌ರ‍್ಯೊ. ಇನ ಮೋಶೆನೆ, “ದೇಕ್ ಛೂ಼” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 3:4" /><verse number="5" style="v" sid="EXO 3:5" />ದೇವ್ನೆ ಇನ, “ತೂ ಡಾಗ್ನ ಖನ್ನೆ ನಕೊ ಆವ್! ತಾರ ಗೋಡಾನ ಖೋಖ್ಹ್‌ಡಾವ್ನ ಕಾಡಿನಾಕ್, ಶನಕತೊ ತೂ ಭಿಯೋಸ್ತೆ ಝ಼ಗೊ ಪರಿಶುದ್ಧ ಝ಼ಗೊ ಹುಯಿರ‍್ಹುಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 3:5" /><verse number="6" style="v" sid="EXO 3:6" />ಆಸ್ ಕಾಹೆತೆ ದೇವ್ನೆ ಇನ, “ಮೇ ತಾರೊ ಬಾ ಹುಯಿರ‍್ಹೋತೆ, ಅಬ್ರಹಾಮ್‌ನೊ ದೇವ್, ಇಸಾಕ್‌ನೊ ದೇವ್, ಯಾಕೋಬನೊ ದೇವ್‌ಬಿ ಹುಯಿರ‍್ಹೋಸ್” ಕರಿಬೋಲ್ಯೊ. ಮೋಶೆನೆ ದೇವ್ನ ದೇಖಾನ ಡರಿನ್ ಮ್ಹೋಡಾನ ಮೂಚಿಲಿದೊ. <verse eid="EXO 3:6" /><verse number="7" style="v" sid="EXO 3:7" />ತದೆ ಯೆಹೋವಾನೆ, “ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಛಾ಼ತೆ ಮಾರ ಅದ್ಮಿನಿ ಖರಾಬ್ ಹಾಲತ್ನ ಮೇ ಡೋಳೇಖ್ಹು ದೇಖಿರಾಖ್ಯೋಸ್. ಚು಼ಪ್ಕೇನು ಕಾಮ್ ಕರಾವನು ಬಾರೇಮ ಇವ್ಣೆ ಕರ‍್ಯುತೆ ಬಿಂತಿ ಮನ ಖ್ಹಮಜ್‌ಪಡ್ಯು ಇವ್ಣಿ ದುಖ್‌ಖ್ಹಾರು ಮನ ಮಾಲುಮ್ ಛೆ. <verse eid="EXO 3:7" /><verse number="8" style="v" sid="EXO 3:8" />ಇನಖ್ಹಾಜೆ ಇವ್ಣುನ ಈಜಿಪ್ಟ್‌ವಾಳನ ಹಾತ್‌ಮಾಥು ಛೋ಼ಡಾವನಬಿ ಯೊ ದೇಖ್ಹ್‌ಥು ಇವ್ಣುನ ದೂದ್ ಅಜು಼ ಶೇತ್‌ ವ್ಹವಾನು ಫರ್‌ಖ್ಹಾತ್ ರ‍್ಹವಾನು ಅಛ್ಛೊ಼ ದೇಖ್ಹ್‌ ಕತೊ ಕಾನಾನ್‌ವಾಳು, ಹಿತ್ತಿಯವಾಳು,ಅಮೋರಿಯವಾಳು, ಪೆರಿಜೀವಾಳು, ಹಿವ್ವಿವಾಳು, ಯೆಬೂಸಿವಾಳು ಜಿವ್ಣುಕರುಕರಾತೆ ದೇಖ್ಹ್‌ನ ಚ಼ಲೈಲಿನ್ ಜಾ಼ವನಬಿ ಉತ್ರಿ ಐರ‍್ಹೋಸ್. <verse eid="EXO 3:8" /><verse number="9" style="v" sid="EXO 3:9" />ಹಮ್ಕೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಚಿಕ್ರಾಣ್ ಮನ ಛಿಮೈರ‍್ಹಿಸ್. ಈಜಿಪ್ಟ್‌ವಾಳು ಇವ್ಣುನ ದ್ಯವಾನಿ ಖ್ಹತಾಪ್ಣಿನ ಮೇ ದೇಖಿರಾಖ್ಯೊಸ್. <verse eid="EXO 3:9" /><verse number="10" style="v" sid="EXO 3:10" />ಇನಖ್ಹಾಜೆ ಹಮ್ಕೆ ಆವ್, ಮಾರು ಅದ್ಮಿ ಹುಯಿರ‍್ಹುತೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಭಾರ್‌ ಕಡೈಲಿನ್ ಆವಾನ ತುನ ಫರೋಹ ರಾಜ಼ಕನ ಮೋಕ್ಲುಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 3:10" /><verse number="11" style="v" sid="EXO 3:11" />ತದೆ ಮೋಶೆನೆ ದೇವ್ನ, “ಫರೋಹಕನ ಜಾ಼ವನಬಿ ಅಜು಼ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಈಜಿಪ್ಟ್‌ಥು ಬುಲೈಲಿನ್ ಆವಾನಬಿ ಮೇ ಕೋಣ್?” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 3:11" /><verse number="12" style="v" sid="EXO 3:12" />ಇನ ದೇವ್ನೆ, “ಖ್ಹಚೆಂಬಿ ಮೇ ತಾರ ಜೋ಼ಡೆಸ್ ರ‍್ಹೀಶ್. ತೂ ಮಾರ ಅದ್ಮಿನ ಈಜಿಪ್ಟ್‌ಥು ಭಾರ್‌ಲೀನ್ ಆಯಾತೊ ತುಮೆ ಪಹಾಡ್‌ಮಾಸ್ ಮನ ಆರಾದನೆ ಕರ್ಶು. ಅಜು಼ ತುನ ಮೋಕ್‌ಲ್ಯೊತೆ ಮೇಸ್ ಕರಿ ಬೋಲಾನ ಆ ತುನ ಖ್ಹಣೇದ್ ಹುಯಿರ‍್ಹಿಷೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 3:12" /><verse number="13" style="v" sid="EXO 3:13" />ಇನ ಮೋಶೆನೆ ದೇವ್ನ, “ಮೇ ಇಸ್ರಾಯೇಲ್‌ವಾಳಕನ ಜೈ಼ನ್, ‘ತುಮಾರ ಗುರುಗುರಬ್‌ಲ್ಯನೊ ದೇವ್ ಮನ ತುಮಾರಕನ ಮೋಕ್ಲಿರಾಖ್ಯೊಸ್’ ಕರಿ ಬೋಲಾನು ವಖ್ಹ್‌ತೆ, ಮನ ಎಕ್ ವಖ್ಹತ್ ಇವ್ಣೆ ಇನು ನಾಮ್ ಶಾತ್? ಕರಿ ಬೋಲ್ಯೂತೊ ಮೇ ಶಾತ್ ಜವಾಬ್ ದೇವ್ಣು?” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 3:13" /><verse number="14" style="v" sid="EXO 3:14" />ತದೆ ದೇವ್ ಮೋಶೆನ, “ರ‍್ಹವವಾಳೊ ಹುಯಿರ‍್ಹೋಸ್” ಕರಿಬೋಲ್ಯೊ. ಅಜು಼ “ತೂ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ರ‍್ಹವವಾಳೊ ಕರಿ ಬೋಲಾವಾಳೊ ಮನ ತುಮಾರಕನ ಮೋಕ್ಲಿರಾಖ್ಯೊಸ್ ಕರಿ ಬೋಲ್ನು” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 3:14" /><verse number="15" style="v" sid="EXO 3:15" />ದೇವ್ ಪಾಛು಼ ಮೋಶೆನ ಬೊಲ್ಯೊ ಶಾತ್‌ಕತೊ, “ತೂ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ, ತುಮಾರ ಗುರುಗುರುಬ್‌ಲ್ಯಾವ್ ಹುಯಿರ‍್ಹಾತೆ ಅಬ್ರಹಾಮ್, ಇಸಾಕ್, ಯಾಕೋಬನೊ ದೇವ್ ಯೆಹೋವನೆ ಮನ ತುಮಾರಕನ ಮೋಕ್ಲಿರಾಖ್ಯೊಸ್” ಕರಿಬೋಲ್ನು. ಆ ಕದೇಬಿ ರ‍್ಹವಾನು ಮಾರು ನಾಮ್. ಆ ಮುಂಡಿಮುಂಡಿಬಿ ಮನ ಆರಾದನೆ ಕರ‍್ನುತೆ ನಾಮ್. <verse eid="EXO 3:15" /><verse number="16" style="v" sid="EXO 3:16" />ಇನೆ ತೂ ಜೈ಼ನ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳ ಶಾಣವ್ನ ಎಕ್ಟು ಮಳೈನ್ ಇವ್ಣುನ, “ತುಮಾರ ಗುರುಗುರುಬ್‌ಲ್ಯನೊ ದೇವ್ ಕತೊ ಅಬ್ರಹಾಮ್, ಇಸಾಕ್, ಯಾಕೋಬನೊ, ದೇವ್ ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವನೆ ಮನ ದರ್ಶನದೀನ್ ತುಮುನ ಕೃಪೆಕರಿನ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ತುಮುನ ಹುಯೂತೆ ಖ್ಹತಾಪ್ಣಿನ ಖ್ಹಚೆಂಬಿ ಮೇ ದೇಖಿರಾಖ್ಯೊಸ್. <verse eid="EXO 3:16" /><verse number="17" style="v" sid="EXO 3:17" />ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ತುಮುನ ಹುಯುತೆ ಖರಾಬ್ ಹಾಲಥ್ಥಿ ತುಮುನ ಛೋ಼ಡೈನ್, ದೂದ್ ಅಜು಼ ಶೇತ್‌ ವವ್ಹಾನೊ ದೇಖ್ಹ್‌ನ ಕತೊ ಕಾನಾನ್‌ವಾಳು, ಹಿತ್ತಿಯವಾಳು, ಅಮೋರಿಯವಾಳು, ಪೆರಿಜೀವಾಳು, ಹಿವ್ವಿವಾಳು, ಯೆಬೂಸಿವಾಳು, ಜಿವ್ಣುಕರಾನ ದೇಖ್ಹ್‌ಮ ಬುಲೈಲಿನ್ ಆವ್ಣುಕರಿ ತೀರ್ಮಾನ್ ಕರಿರಾಖ್ಯೊಸ್” ಕರಿ ಇವ್ಣುನ ಬೋಲ್. <verse eid="EXO 3:17" /><verse number="18" style="v" sid="EXO 3:18" />ಇವ್ಣೆ ತಾರಿ ವಾತ್ನ ಖ್ಹಮಜ಼್‌ಶೆ. ತೂ ಅಜು಼ ಇಸ್ರಾಯೇಲ್ನು ಶಾಣುಖ್ಹಾರು ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ರಾಜ಼ಕನ ಇನ, “ಇಬ್ರಿಯವಾಳನು ದೇವ್ ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವ ಮನ ದೆಖಾಯೊ; ಇನಖ್ಹಾಜೆ ಹಮೆ ಜ಼ಂಗಳ್‌ಮ ತೀನ್ ದನ್‌ಲಗು ಚಾ಼ಲಯೆತ್ರೆ ದೂರ್ ಜೈ಼ನ್ ಅಪ್ಣೊ ದೇವ್ ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವನಖ್ಹಾಜೆ ಬಲಿದೇವ್ಣು, ಇನಖ್ಹಾಜೆ ಹುಕುಮ್‌ ಹೋಣುಕರಿ ಬೋಲಿಲೇವ್ಣು. <verse eid="EXO 3:18" /><verse number="19" style="v" sid="EXO 3:19" />ಕತೋಬಿ ಯೊ ಈಜಿಪ್ಟ್‌ನೊ ರಾಜ಼ ತುಮೆ ಕೆತ್ರೆ ಜು಼ಲಮ್‌ ಕರ‍್ಯಾತೋಬಿ ಮ್ಹೇಲ್‌ಶೆ ಕೊಯ್ನಿಕರಿ ಮನ ಮಾಲುಮ್. <verse eid="EXO 3:19" /><verse number="20" style="v" sid="EXO 3:20" />ಇನಖ್ಹಾಜೆ ಮೆ ಮಾರ ಹಾತ್ನಿ ಶಕತ್ ಕೆತ್ರೆಕರಿ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಬೀಚ್ಮ ಮಹಾನ್ ಕಾಮ್ ಕರೀನ್ ಇನ ಅಲಕ್ ಅಲಕ್ ಥರಾಮ ಖ್ಹತೈಷ್. ಇನವಾರ್ ರಾಜ಼ ತುಮುನ ಮೋಕ್ಲಿದಿಶೆ. <verse eid="EXO 3:20" /><verse number="21" style="v" sid="EXO 3:21" />“ಆಸ್ ಕಾಹೆತೆ ಆ ಮಾರ ಅದ್ಮಿವ್‌ಪರ್ ಈಜಿಪ್ಟ್‌ವಾಳನ ಗೋರ್‌ ಆವನಿತರ ಕರೀಶ್. ಇನಖ್ಹಾಜೆ ತುಮೆ ಜಾ಼ವಾನಿವಖ್ಹ್‌ತೆ ಖಾಲಿ ಹಾತೆ ಜಾ಼ಶು ಕೊಯ್ನಿ. <verse eid="EXO 3:21" /><verse number="22" style="v" sid="EXO 3:22" />ತುಮಾರಮಾನಿ ಹರೇಕ್ ತಯೇಡಾಬಿ ಆಗೆ ಪೀಛೆನ ತಯೇಡಾಥೀಬಿ ಇವ್ಣ ಘರ್‌ಮ ಛಾ಼ತೆ ತಯೇಡಾಥಿ ರೂಪು ಖ್ಹೊನ್ನುಖ್ಹರಪ್ ಲುಂಗ್ಡ ಬೋಲಿಲ್ಯವಾದೆ ತುಮೆ ಯೊ ಅಖ್ಖಾನ ತುಮಾರ ಪರ್ಖ್ಹಾ ತಯೇಡ ಛೋ಼ಕ್ರಾವ್ನ ಫೇರಾವೊ. ಅಮ್ ಈಜಿಪ್ಟ್‌ವಾಳಕಂಥು ಛಿನೈನ್ ನಿಕಳ್‌ಷು” ಕರಿಬೋಲ್ಯೊ.<verse eid="EXO 3:22" /></para>
  <chapter eid="EXO 3" />
  <chapter number="4" style="c" sid="EXO 4" />
  <para style="s">ದೇವ್ನೆ ಮೋಶೆನ ದಿದೋತೆ ಅದ್ಭುತ್ ಶಕತ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 4:1" />ತದೆ ಮೋಶೆ ಯೆಹೋವ ದೇವ್ನ ಜವಾಬ್‌ ದೇತೊಹುಯಿನ್, “ಇವ್ಣೆ ಮನ ವಿಶ್ವಾಸ್ ನಾಕರಿನ್, ಮಾರಿವಾತ್ನ ನಾ ಖ್ಹಮ್ಜಿನ್, ಯೆಹೋವ ತುನ ದೆಖಾಯೊಸ್ ಕೊಯ್ನಿಕರಿ ಬೋಲ್ಯೊತೊ ಮೇ ಶಾತ್ ಕರ‍್ನು?” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 4:1" /><verse number="2" style="v" sid="EXO 4:2" />ಇನ ಯೆಹೋವನೆ, “ತಾರ ಹಾತ್ಮ ಛಾ಼ತೆ ಶಾತ್?” ಕರಿಬೋಲ್ಯೊ, ಇನೆ “ಆ ಎಕ್ ಲಠ್ಠೊ” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 4:2" /><verse number="3" style="v" sid="EXO 4:3" />ಯೆಹೋವನೆ ಇನ, “ಯೊ ಜ಼ಮಿನ್‌ಪರ್ ಫೇಕ್” ಕರಿಬೋಲ್ಯೊ. ಜ಼ಮಿನ್‌ಪರ್ ಫೇಕಾಖ್ಹತರ್ ಯೊ ಖ್ಹಾಪ್ ಹುಯಿಗು! ಮೋಶೆ ಇನ ದೇಖಿನ್ ಡರಿನ್ ಮಿಲೈನ್ ಚ಼ಲೆಗಯೊ. <verse eid="EXO 4:3" /><verse number="4" style="v" sid="EXO 4:4" />ಯೆಹೋವನೆ ಮೋಶೆನ “ತಾರೊ ಹಾತ್ ಪೂರೈನ್ ಇನ ಡೋಂಡಾನ ಧರ್” ಕರಿ ಬೊಲ್ಯೊ. ಇಮ್ಮಸ್ ಧರಾಖ್ಹತರ್ ಯೊ ಲಠ್ಠೊ ಹುಯೊ. <verse eid="EXO 4:4" /><verse number="5" style="v" sid="EXO 4:5" />ತದೆ ಯೆಹೋವನೆ ಇನ, “ಅನೇಥಿ ಇವ್ಣೆ ಇವ್ಣ ಗುರುಗುರಬ್‌ಲ್ಯ ಹುಯಿರ‍್ಹಾತೆ ಅಬ್ರಹಾಮ್, ಇಸಾಕ್, ಯಾಕೋಬನೊ ದೇವ್‌ಹುಯಿರ‍್ಹೊತೆ ಯೆಹೋವನೆ ತುನ ದೆಖೈರ‍್ಹೋಸ್ತೆ ಖ್ಹಾಚಕರಿ ವಿಶ್ವಾಸ್ ಕರ್ಷೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 4:5" /><verse number="6" style="v" sid="EXO 4:6" />ಯೆಹೋವನೆ ಪಾಛು಼ ಇನ, “ತಾರ ಹಾತ್ನ ಝ಼ಗ್ಗಾನ ಮಹಿ ಘಾಲಿರಾಕ್” ಕರಿ ಬೊಲ್ಯೊ. ಯೊ ಇಮ್ಮಸ್ ರಾಖಿನ್ ಭಾರ್ ಕಾಡಖ್ಹತರ್ ಇನೊ ಹಾತ್ನ ಮಚ಼್ಚೊ ಹುಯಿನ್ ಬರಪ್‌ನಿತರ ಧೋಳುಫಟ್ ಹುಯಿರ‍್ಹುಥು. <verse eid="EXO 4:6" /><verse number="7" style="v" sid="EXO 4:7" />ಯೆಹೋವನೆ ಇನ ಹಾತ್ನ ಪಾಛು಼ ಝ಼ಗ್ಗಾನ ಮಹಿ “ಘಾಲ್” ಕರಿ ಬೊಲ್ಯೊ. ಯೊ ಪಾಛು಼ ಝ಼ಗ್ಗಾನ ಮಹಿಘಾಲಿನ್ ಕಾಡಿ ದೇಖಾನಿ ವಖ್ಹ್‌ತೆ ಪಾಛು಼ ಥೂತೆ ಶರೀರ್‌ನಿತರಾಸ್ ಹುಯು. <verse eid="EXO 4:7" /><verse number="8" style="v" sid="EXO 4:8" />ತದೆ ಯೆಹೋವನೆ ಇನ “ಇವ್ಣೆ ತುನ ನಾ ನಂಬಿನ್, ಪಹಿಲು ಅದ್ಭುತ್ ಕಾಮ್ನ ನಾ ಮಾಲುಮ್‌ಕರೀನ್ ಝಿಟ್ಕಾರ‍್ಯು ತೋಬಿ ಬೇನ ಅದ್ಭುತ್‌ನ ದೇಖಿನ್ ವಿಶ್ವಾಸ್ ಕರ್ಷೆ. <verse eid="EXO 4:8" /><verse number="9" style="v" sid="EXO 4:9" />ಯೊ ಭೇ ಅದ್ಭುತ್‌ಕಾಮ್ನ ಇವ್ಣೆ ವಿಶ್ವಾಸ್ ನಾಕರಿನ್‌ಬಿ ತಾರಿ ವಾತ್ನ ನಾ ಖ್ಹಮ್‌ಜಿನ್‌ಬಿ ಗಯೂತೊ, ತೂ ನೈಲ್ ನದ್ದಿನ ಪಾಣಿನ ಲೀನ್ ಜೈ಼ನ್ ಖ್ಹುಕ್ಕಿ ಜ಼ಮಿನ್‌ಪರ್ ರಂಚ಼್‌ಣು. ತದೆ ಖ್ಹುಕೈರ‍್ಹೀತೆ ಜ಼ಮಿನ್‌ಮ ರಂಚ್ಯುತೆ ಪಾಣಿ ಲ್ಹೋಯಿ ಉಷೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 4:9" /><verse number="10" style="v" sid="EXO 4:10" />ತದೆ ಮೋಶೆ ಯೆಹೋವನ, “ಪ್ರಭು, ಪಹಿಲೆಥೋಬಿ ತು ಮಾರಿ ಜೋ಼ಡೆ ವಾತ್ ಬೋಲ್ಯೊತೋಬಿ ಮೆ ಕದೇಬಿ ವಾತೇಮ ಚಾ಼ತುರ್ ಕೊಯ್ನಿ, ಮೇ ತೊತ್‌ಳ್ಯೊ ಹುಯಿರ‍್ಹಿನ್, ಕದೇಬಿ ಪಾಛೊ಼ ಹಟಿಜ಼ಾವಾಳೊ, ಮಾರಿ ಜೀಬ್ಬಿ ಢೋಕ್‌ಳ್ಯು ಹುಯಿರಿಸ್” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 4:10" /><verse number="11" style="v" sid="EXO 4:11" />ತದೆ ಯೆಹೋವನೆ, ಇನ ಅದ್ಮಿನ ಬಾಕು ದಿದೋತೆ ಕೋಣ್? ಏಕ್‌ಜ಼ಣೊ ಮೂಗೊ, ಕಿವುಡೊ, ಏಕ್‌ಜ಼ಣಾನ ದೆಖಾವನಿ ಘೋಣಿ ಅಜು಼ ಬಿಜೇಕ್ ಜ಼ಣೊ ಅಂಧಾನಿತ್ರ ರ‍್ಹೇವ್ಣುಕರಿ ನೇಮಕ್ ಕಿನೆ ಕರ‍್ಯೊ? ಯೆಹೋವ ಹುಯಿರ‍್ಹೋಸ್ತೆ ಮೇಸ್ ಕಾಹೆಕಿಶು? <verse eid="EXO 4:11" /><verse number="12" style="v" sid="EXO 4:12" />ಅನಖ್ಹಾಜೆ ತು ಹಮ್ಕೆ ನಿಕಳ್ ಮೆ ತಾರ ಮ್ಹೋಡಾನ ಮದತ್‌ವಾಳೊ ಹುಯಿರ‍್ಹಿನ್ ತೂ ವಾತೆ ಬೋಲಾನುಖ್ಹಾರು ಮೇ ತುನ ಬೋಲುಸ್ ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 4:12" /><verse number="13" style="v" sid="EXO 4:13" />ಕತೋಬಿ ಮೋಶೆನೆ, ಪ್ರಭು ದಯಾಕರಿನ್ ಬಿಜೇಕ್ ಜ಼ಣಾನ ಮೋಕಲ್ನು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 4:13" /><verse number="14" style="v" sid="EXO 4:14" />ತದೆ ಯೆಹೋವನೆ ಮೋಶೆಪರ್ ಖಿಜೈ಼ನ್ ಇನ, “ಲೇವಿಹುಯಿರ‍್ಹೊತೆ ಆರೋನ ತಾರೊ ಭೈ ಕಾಹೆಕಿಶು? ಯೊ ಅಛ್ಛಿನಿತರ ವಾತೆ ಬೋಲವಾಳೊಕರಿ ಮನ ಮಾಲುಮ್‌ ಛಾ಼. ಯೋಸ್ ತುನ ಮ್ಹೋರೆಹುವಾನ ಆವ್‌ಷೆ. ಯೊ ತುನ ದೇಖಾನಿ ವಖ್ಹ್‌ತೆ ಯೊ ಇನ ದಿಲ್ಮ ಶಂತೋಖ್ಹ್‌ ಕರ್ಷೆ. <verse eid="EXO 4:14" /><verse number="15" style="v" sid="EXO 4:15" />ತೂ ಇನ ಜೋ಼ಡೆ ವಾತೆ ಬೋಲಿನ್ ಬೋಲ್ನುತೆ ವಾತ್‌ಖ್ಹಾರನ ಇನ ಖ್ಹಮ್‌ಜಾ಼ಡ್. ತಾರ ಮ್ಹೋಡನಾಬಿ ಮದತ್ ಕರಾವಳೊ ಹುಯಿನ್, ತುಮುನ ಶಾತ್‌ ಕರ‍್ನುಕರಿ ಮೇ ತುನ ಬೋಲುಸ್. <verse eid="EXO 4:15" /><verse number="16" style="v" sid="EXO 4:16" />ಯೊ ತಾರ ಬದಲ್ ಅದ್ಮಿವೋನ ಜೋ಼ಡ್ಮ ವಾತೆ ಬೋಲ್‌ಶೆ. ಯೊ ತುನ ಬಾಕನಿತರ ರ‍್ಹಿಶೆ. ತೂ ಇನ ದೇವ್‌ನಿತರ ರ‍್ಹೀಶ್. <verse eid="EXO 4:16" /><verse number="17" style="v" sid="EXO 4:17" />ಆ ನಾಹುಯಿನ್ ಆ ಲಠ್ಠಾನ ತಾರ ಹಾತ್ಮಲೀನ್ ಜಾ಼ವ್ಣು ಅನೇಥಿಸ್ ಯೊ ಅದ್ಭುತ್ ಕಾಮ್‌ಖ್ಹಾರು ಕರೀಶ್" ಕರಿ ಬೊಲ್ಯೊ.<verse eid="EXO 4:17" /></para>
  <para style="s">ಪಾಛು಼ ಈಜಿಪ್ಟ್ ಆಯೋತೆ ಮೋಶೆ</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 4:18" />ತದೆ ಮೋಶೆ ಇನೊ ಖ್ಹಖ್ಹ್‌ರೊ ಇತ್ರೊನಕನ ಫಾಛೊ಼ ಅಯಿನ್ ಇನ, “ಮೇ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಛಾ಼ತೆ ಮಾರ ಭಯ್ಯೆಕನ ಪಾಛೊ಼ ಇವ್ಣೆ ಜಾನ್‌ಥಿ ಛಾ಼ಕಿ ಶು ಕೊಯ್ನಿಕರಿ ಜೈ಼ನ್ ದೇಕ್ಣು” ಕರಿ ಬೊಲ್ಯೊ. ಇತ್ರೋನನೆ ಮೋಶೆನ, “ತೂ ಸಮಾಧಾನ್‌ ಜೈ಼ನ್‌ ಆವ್ ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 4:18" /><verse number="19" style="v" sid="EXO 4:19" />ಯೆಹೋವನೆ ಮಿದ್ಯಾನ್‌ಮ ಮೋಶೆನ, ತೂ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಪಾಛು಼ ಫರಿನ್ ಜಾ಼ ತಾರು ಜಾನ್ನ ಕಾಡಿನಾಕ್ಣುಕರಿ ಥೂತೆ ಖ್ಹಾರು ಮರಿಗಯು ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 4:19" /><verse number="20" style="v" sid="EXO 4:20" />ಮೋಶೆ ಇನಿ ಬಾವಣ್ಣ ಲಡ್ಕಾವ್ನ ಗಧೇಡಪರ್ ಬೆಖ್ಹಾಡಿನ್ ಇವ್ಣುನ ಬುಲೈಲಿನ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಗಯೊ. ಜೋ಼ಡ್ಮ ಇನೆ ದೇವ್ನೆ ಪಾಡಿಲಿಜಾ಼ವ್ಣುಕರಿ ಬೋಲ್ಯೊತೆ ಲಠ್ಠಾನ ಪಾಡಿಲಿಗಯೊ. <verse eid="EXO 4:20" /><verse number="21" style="v" sid="EXO 4:21" />ಯೆಹೋವನೆ ಮೋಶೆನ ಅಮ್ ಬೊಲ್ಯೊ “ತೂ ಈಜಿಪ್ಟ್ ಪಾಛು಼ ಆವನಿವಖ್ಹ್‌ತೆ ಮೇ ತಾರ ಹಾತೇಖ್ಹು ಕರ‍್ಯೊತೆ ಮಹಾನ್ ಕಾಮ್ನ ಫರೋಹನ ಖ್ಹಾಮೆ ಕರ್ನು. ಕತೋಬಿ ಇನ ದಿಲ್ನ ಕಠಣ್ ಕರಿಶ್. ಇನಖ್ಹಾಜೆ ಯೊ ಅದ್ಮಿನ ಜಾ಼ವಾನ ಕೊ ಮ್ಹೇಲ್‌ಶೇನಿ. <verse eid="EXO 4:21" /><verse number="22" style="v" sid="EXO 4:22" />ತದೆ ತು ಫರೋಹನ,ಯೆಹೋವ ಬೋಲಾತೆ ಖ್ಹಮಜ಼್‌ ‘ಇಸ್ರಾಯೇಲ್ ಮಾರೊ ಛಿಯ್ಯೊ, ಮಾರೊ ಪೈಲ್ಹೋಟೊ ಛಿಯ್ಯೊ. <verse eid="EXO 4:22" /><verse number="23" style="v" sid="EXO 4:23" />ಅಜು಼ ಮಾರೊ ಛಿಯ್ಯೊ ತಾರ ದೇಖ್ಹ್‌ಥೊ ನಿಕ್ಳಿನ್ ಮನ ಆರಾದನೆ ಕರಾನ ಇನ ಹುಕುಮ್‌ ದೇವ್ಣು ಇನ ತೂ, ನಾ ಮಾನ್ಯೊತೊ ಮೇ ತುನ ಛಾ಼ತೆ ಪೈಲ್ಹೋಟ ಲಡ್ಕಾವ್ನ ಮಾರಿನಾಖಿಷ್ ಯೆಹೋವ ಬೋಲುಕರಸ್” ಕರಿ ಖ್ಹಮ್‌ಜಾ಼ಡ್‌ನು. <verse eid="EXO 4:23" /><verse number="24" style="v" sid="EXO 4:24" />ಆನಾಹುಯಿನ್ ಮೋಶೆ ಜಾ಼ವಾನ ಮಾರಗ್‍ಮ, ಛತ್ರಾಮ ರ‍್ಹವಾನಿವಖ್ಹ್‌ತೆ ಯೆಹೋವನೆ ಇನ ಖ್ಹಾಮ್ಣೆ ಅಯಿನ್ ಇನ ಜಾನ್ನ ಕಾಡಿನಾಖಿದೇವ್ಣು ಕರಿ ಥೊ. <verse eid="EXO 4:24" /><verse number="25" style="v" sid="EXO 4:25" />ಅಮ್‍ರ‍್ಹಾವಮ ಚಿಪ್ಪೋರನೆ ಬಂಡಾನಿ ಛ಼ರೀಥಿ ಇನ ಛಿಯ್ಯಾನ ಖ್ಹತ್ನ ಕರೈನ್ ಇನ ಮೋಶೆನ ಪಂಜಾ಼ನ ಛಿಮಾಡಿ ಅನವಾರ್ ಹೈರಿತೆನ “ತೂ ಮನ ಲ್ಹೋಯಿಥಿ ಹುಯೋತೆ ನವ್‌ಷೊ” ಕರಿ ಬೋಲಿ. <verse eid="EXO 4:25" /><verse number="26" style="v" sid="EXO 4:26" />ತದೆ ಯೆಹೋವ ಇನ ಬಚಾ಼ಡ್ಯೊ, ತದೆ ಯೊ ಹೈರಿತೆ, “ಖ್ಹತ್ನಾನ ಖ್ಹಾಜೆಥೀಸ್ ತೂ ಮನ ಲ್ಹೋಯಿಥಿ ರಂಚೈ಼ನ್ ಹುಯೊತೆ ನೌಶೊಕರಿ ವಾತೆ ಬೋಲಿ. <verse eid="EXO 4:26" /><verse number="27" style="v" sid="EXO 4:27" />ಅತ್ರೇಸ್ ಕಾಹೆತೆ ಯೆಹೋವನೆ ಆರೋನನ “ತೂ ಮೋಶೆನ ಮಳಾನ ಜ಼ಂಗಳ್‌ಮ ಚ಼ಲ್ಯೊಜಾ಼” ಕರಿ ಬೊಲ್ಯೊ ಯೊ ಜೈ಼ನ್ ದೇವ್ನ ಪಹಾಡ್‌ಮಾಸ್ ಮ್ಹೋರೆ ಮಳಿನ್ ಬುಚ್ಚದಿದೊ. <verse eid="EXO 4:27" /><verse number="28" style="v" sid="EXO 4:28" />ತದೆ ಮೋಶೆನೆ ಆರೋನನ, ಬೋಲಿ ಮೋಕ್‌ಲ್ಯೊತೆ ಯೆಹೋವನಿ ಅಖ್ಖೀಸ್ ವಾತೆವ್‌ನಾಬಿ ಇನ ಹುಕುಮ್‌ ದಿದೋತೆ ಅದ್ಭುತ್ ಕಾಮ್‌ಖ್ಹಾರುಬಿ ಇನೆ ಕರ‍್ಯೊತೆ ಖ್ಹಾರುಸ್ ಆರೋನನ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ. <verse eid="EXO 4:28" /><verse number="29" style="v" sid="EXO 4:29" />ಆ ಹುವಾದಿನ್ ಮೋಶೆ ಅಜು಼ ಆರೋನ ಇವ್ಣೆ ಜೈ಼ನ್ ಇಸ್ರಾಯೇಲ್ನು ಹಿಡಿ ಶಾಣವ್ನ ಎಕ್ಟು ಮಳಾಯೊ. <verse eid="EXO 4:29" /><verse number="30" style="v" sid="EXO 4:30" />ಯೆಹೋವನೆ ಮೋಶೆನ ಬೋಲಿರಾಖ್ಯೊಥೋತೆ ವಾತೇವ್ನ ಆರೋನನೆ ಇವ್ಣುನ ಖ್ಹಮ್‌ಜಾ಼ಡಿನ್ ಅದ್ಮಿನ ಡೋಳಾವ್ನ ಖ್ಹಾಮೆ ಅದ್ಭುತ್ ಕಾಮ್‌ಖ್ಹಾರು ಕರ‍್ಯೊ. <verse eid="EXO 4:30" /><verse number="31" style="v" sid="EXO 4:31" />ಅದ್ಮಿನೆ ವಿಶ್ವಾಸ್ ಕರ‍್ಯು, ಯೆಹೋವ ದೇವ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ದಯಾಕರಿನ್ ಇವ್ಣು ಖರಾಬ್ ಹಾಲತ್ನ ಮನ್‌ಮ ಲೀಖಿರಾಖ್ಯೊಸ್ ‌ಕರಿ ಬೋಲಾನು ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಬೋಲಾಖ್ಹತರ್ ಮುಡ್‌ಕ್ಯು ಝು಼ಕೈನ್ ಖ್ಹಲಾಮ್ ಕರ‍್ಯು.<verse eid="EXO 4:31" /></para>
  <chapter eid="EXO 4" />
  <chapter number="5" style="c" sid="EXO 5" />
  <para style="s">ಈಜಿಪ್ಟ್‌ನ ರಾಜಾ಼ನ ಖ್ಹಾಮ್ಣೆ ಮೋಶೆ ಅಜು಼ ಆರೋನ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 5:1" />ಇನಕೇಡೆಥು ಮೋಶೆ ಅಜು಼ ಆರೋನ ಫರೋಹನ ಖ್ಹಾಮ್ಣೆ ಜೈ಼ನ್, “ಇಸ್ರಾಯೇಲ್ನ ದೇವ್ ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವ ಮಾರು ಅದ್ಮಿ ಮಾರಖ್ಹಾಜೆ ಮರ‍್ಯಾದಿಕರಿನ್ ಜ಼ಂಗಳ್‌ಮ ಜ಼ತ್ರಾ ಚ಼ಲಾವನಿತರ ಇವ್ಣುನ ಹುಕುಮ್‌ ದೇವ್ಣುಕರಿ ಬೋಲಿರಾಖ್ಯೊಸ್ ಕರಿಬೋಲ್ಯು. <verse eid="EXO 5:1" /><verse number="2" style="v" sid="EXO 5:2" />ಇನ ಫರೋಹಾನೆ, “ಯೆಹೋವಕರಿ ಬೋಲಾತೆ ಕೋಣ್? ಮೇ ಇನ ವಾತ್ನ ಖ್ಹಮ್‌ಜಿನ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಮೋಕಲ್ನುತೆ ಶನ? ಯೆಹೋವ ಕೋಣ್‌ಕರಿ ಮನ ಮಾಲುಮ್‌ಕೊಯ್ನಿ. ಆಸ್ ಖಲಿಕಾಹೆತೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಜಾ಼ವಾನ ಮೇ ಮ್ಹೇಲಿಶಸ್ ಕೊಯ್ನಿ” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 5:2" /><verse number="3" style="v" sid="EXO 5:3" />ತದೆ ಇವ್ಣೆ, “ಇಬ್ರಿಯವಾಳನು ದೇವ್ ಹಮುನ ಮ್ಹೋರೆ ಹುಯೊ. ಹುಕುಮ್ ಹುಯೂತೊ ಹಮೆ ಜ಼ಂಗಳ್‌ಮ ತೀನ್ ದನ್ ಚಾ಼ಲಿನ್, ಹಮಾರೊ ದೇವ್ ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವನಖ್ಹಾಜೆ ಬಲಿಕರಿನ್ ಐಯೇಸ್ ನತರ್ ಯೊ ಹಮುನ ರೋಗ್‌ಥಿಕಿ ತಲ್ವಾರ್‌ಥೀಕಿ ಸಂಹಾರ್ ಕರ್ಷೆ” ಕರಿ ಬೋಲ್ಯು. <verse eid="EXO 5:3" /><verse number="4" style="v" sid="EXO 5:4" />ಈಜಿಪ್ಟ್‌ನ ರಾಜಾ಼ನೆ ಇವ್ಣುನ, “ಮೋಶೆ ಅಜು಼ ಆರೋನ ಆ ಅದ್ಮಿನ ಇವ್ಣಕಾಮ್ನ ಕರ್ನುನಾತೆ ಶನ ಅಡ್ಡಿ ಕರೋಸ್? ತುಮಾರ ಫುಗಟ್‌ನ ಕಾಮ್ನ ಜಾ಼ವೊ ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 5:4" /><verse number="5" style="v" sid="EXO 5:5" />ಫರೋಹಾನೆ ಇಬ್ರಿಯವಾಳು ದೇಖ್ಹ್‌ಮ ಜಾ಼ಖ್ಹತ್ ಛಾ಼ ಇವ್ಣೆ ಇವ್ಣು ಫುಗಟ್‌ನ ಕಾಮ್ನ ನಾಕರ‍್ನುತೆ ತಿಮ್ ಭಿರಾಖಿ ದ್ಯವಾನಯುನಿ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 5:5" /><verse number="6" style="v" sid="EXO 5:6" />ಯೊ ದನ್ಮ ಫರೋಹಾನೆ ಫುಗಟ್‌ಥಿ ಕಾಮ್‌ ಕರಾವವಾಳನ ಅಜು಼ ಇವ್ಣ ಅದಿಕಾರಿಯೇವ್ನ ಬುಲೈನ್, <verse eid="EXO 5:6" /><verse number="7" style="v" sid="EXO 5:7" />“ಅನಪಾರ್ ತುಮೆ ಆ ಅದ್ಮಿವೋನ ಇಟ್ಕೆ ಕರಾನ ಖ್ಹಾಜೆ ಘಾಖ್ಹ್‌ನ ನಾದೇವ್ಣು ಇವ್ಣೇಸ್ ಜೈ಼ನ್ ಘಾಖ್ಹ್‌ನ ಜ಼ಮ ಕರಿಲ್ಯಾವದೆ. <verse eid="EXO 5:7" /><verse number="8" style="v" sid="EXO 5:8" />ಕತೋಬಿ ಇವ್ಣೆ ಹಮ್ಕೆಲಗು ಕರ‍್ಯುತೆ ಇಟ್ಕೆನಿ ಇಷಾಬ್‌ಮ ಶಾತ್‌ಬಿ ಕಮ್‌ನಾಹೋಣುಕರಿ ಇವ್ಣುನ ಬೋಲ್ನು. ಇವ್ಣೆ ವಳ್‌ಷಿನ ಖಾದಸ್, ಇನಖ್ಹಾಜೇಸ್ ಇವ್ಣೆ, ಹಮೆ ಜೈ಼ನ್ ಹಮಾರ ದೇವ್ನ ಬಲಿದೀನ್ ಆವಾನ ಹುಕುಮ್‌ ಹೋಣುಕರಿ ಚಿಕ್ರುಕರಾಸ್. <verse eid="EXO 5:8" /><verse number="9" style="v" sid="EXO 5:9" />ಆ ಅದ್ಮಿ ಹೋಣುಕೊಂತೆ ವಾತ್ನ ಧ್ಯಾನ್ ನಾದೇವ್ಣುತೆ ತುಮೆ ಇವ್ಣಪರ್ ಜಾ಼ಖ್ಹತ್ ಕಾಮ್ ಢೊವೊ. ಇವ್ಣೆ ರಾಬಾದೆ” ಕರಿ ಹುಕುಮ್‌ ಕರ‍್ಯೊ. <verse eid="EXO 5:9" /><verse number="10" style="v" sid="EXO 5:10" />ತದೆ ಫುಗಟ್ ಕಾಮ್‌ಕರಾವವಾಳು ಅಜು಼ ಅದಿಕಾರಿಖ್ಹಾರು ಭಾರ್‌ಜೈ಼ನ್ ಯೊ ಅದ್ಮಿವೊನ, “ತುಮುನ ಘಾಖ್ಹ್‌ ನಾ ದೇವ್ಣುಕರಿ ಫರೋಹನಿ ಹುಕುಮ್‌ ಹುಯಿರ‍್ಹೀಸ್. <verse eid="EXO 5:10" /><verse number="11" style="v" sid="EXO 5:11" />ತುಮುನ ಘಾಖ್ಹ್‌ ಕಿಜ್ಜಾ಼ ಮಳಾಸ್ಕಿ ಹಿಜ್ಜಾ಼ ತುಮೇಸ್ ಜೈ಼ನ್ ಲೀಲೆವೊ, ಕತೋಬಿ ತುಮೆ ಕರಾನ ಕಾಮ್ಮ ದರಾಖ್ಹುಬಿ ಕಮ್ ನಾಹೋಣು” ಕರಿ ಬೋಲ್ಯು. <verse eid="EXO 5:11" /><verse number="12" style="v" sid="EXO 5:12" />ಅಮ್‌ರ‍್ಹವಾಪರ್ ಅದ್ಮಿ ಘಾಖ್ಹ್‌ನ ಜ಼ಮಕರಾನ ಖ್ಹಾಜೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ ಅಖ್ಖು ಫೈಲೈಜ಼ಯಿನ್ ಢೂಂಡಲಗ್ಯು. <verse eid="EXO 5:12" /><verse number="13" style="v" sid="EXO 5:13" />ಆಸ್ ಕಾಹೆತೆ ಫುಗಟ್‌ನು ಕಾಮ್‌ಕರಾವವಳು, “ತುಮುನ ಘಾಖ್ಹ್‌ ಥೂತೆ ಕಿಮ್ಕಿ ಇಮ್ಮಸ್ ಹರೇಕ್ ದನ್ನಾ ಕಾಮ್ನ ಯೋಸ್ ದನ್ಮಾಸ್ ಖತಮ್ ಕರ‍್ನು” ಕರಿ ಬೋಲಿನ್ ಇವ್ಣುನ ಉತ್ವಾಳಿಕರಾಯು. <verse eid="EXO 5:13" /><verse number="14" style="v" sid="EXO 5:14" />ಫರೋಹನು ಅಧಿಕಾರಿಖ್ಹಾರು ಇವ್ಣೆಸ್ ನೇಮಕ್ ಕರ‍್ಯುಥೂತೆ ಇಸ್ರಾಯೇಲ್ನು ಮೇಸ್ತ್ರಿವ್‌ನ, “ತುಮೆ ಪಹಿಲೆ ಇಟ್ಕೇನಿ ಗಣ್ತಿ ದೇತಥಾತೆ ತಿಮ್‌ ಕಾಲೆ ಅಜು಼ ಆಜ಼್ ಶನ ಕೋದಿದಾನಿ” ಕರಿ ಬೋಲಿನ್ ಇವ್ಣುನ ಮಾರ‍್ಯು. <verse eid="EXO 5:14" /><verse number="15" style="v" sid="EXO 5:15" />ಅಮ್ ರ‍್ಹವಾಪರ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಮೇಸ್ತ್ರಿಖ್ಹಾರು ಫರೋಹಕನ ಜೈ಼ನ್‌, “ಮಾಲಿಕ್ ಶನ ತಾರ ದಾಸರ್‌ನ ಅಮ್ ಕರುಕರಸ್ ? <verse eid="EXO 5:15" /><verse number="16" style="v" sid="EXO 5:16" />ತಾರ ದಾಸರ್‌ನ, ನೇಮ್‌ಶಾಯಾತೆ ಅದಿಕಾರಿಖ್ಹಾರ ಘಾಖ್ಹ್‌ನ ನಾ ದೀನ್ ‘ಇಟ್ಕೆಖ್ಹಾರು ಕರೊ!’ ಕರಿ ಬೋಲಿನ್ ಹಮುನ ಮಾರುಕರಸ್. ಅಮ್ ತಾರು ಅದ್ಮಿ ಕರುಕರಾಸ್ತೆ ಪಾಪ್ನುಕಾಮ್ ಹುಯಿರ‍್ಹುಸ್” ಕರಿ ಬೋಲ್ಯು. <verse eid="EXO 5:16" /><verse number="17" style="v" sid="EXO 5:17" />ತದೆ ಇನೆ, ‘ತುಮೆ ವಳ್‌ಷಿಭರ‍್ಯ, ತುಮೆ ವಳ್‌ಷಿಭರ‍್ಯ ಹುಯಿರ‍್ಹಾಸ್ತೆ ಇನಖ್ಹಾಜೆ, ‘ಹಮೆ ಜೈ಼ನ್ ಯೆಹೋವನ ಬಲಿಸಮರ್ಪಣ್ ಕರಿನ್ ಆವ್ಣು’ ಕರಿ ಬೋಲುಕರ‍್ಯಾಹೊತ್ತ್. <verse eid="EXO 5:17" /><verse number="18" style="v" sid="EXO 5:18" />ಇನಖ್ಹಾಜೆ ಹಮ್ಕೆ ಚಾ಼ಕ್ರಿನ ಚಾ಼ಲೊ ತುಮುನ ಘಾಖ್ಹ್‌ ಕೊದೇವ್ನಿ ಕತೋಬಿ ಇಟ್ಕೆನಿ ಇಶಾಬ್ ದೇವ್ಣುಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 5:18" /><verse number="19" style="v" sid="EXO 5:19" />ದನ್‌ರೋಜ಼್‌ಬಿ ಒಪ್‌ಶಾವ್ಣುತೆ ಇಟ್ಕೆವ್ನಿ ಗಣ್ತಿ ಕಮ್‌ನಾಹೋಣುಕರಿ ಬೋಲಾನ ಹುಕುಮ್‌ನ ಖ್ಹಾಜೇಥಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಮೇಸ್ತ್ರಿಖ್ಹಾರು ಇವ್ಣೆ ಖರಾಬ್ ಹಾಲತ್ಮ ಖ್ಹಪ್‌ಡಿಗಯಕರಿ ಮಾಲುಮ್ ಕರಿಲಿದು. <verse eid="EXO 5:19" /><verse number="20" style="v" sid="EXO 5:20" />ಇವ್ಣೆಖ್ಹಾರು ಫರೋಹಕಂಥು ಭಾರ್‌ ಆಯತದೆ ಇವ್ಣುನ ಖ್ಹಾಮ್ಣೆ ದೇಖಾನ ಭಿಯಾಥಾತೆ ಮೋಶೆ ಅಜು಼ ಆರೋನ್ನ ದೇಖ್ಯು. <verse eid="EXO 5:20" /><verse number="21" style="v" sid="EXO 5:21" />ಮೋಶೆ ಅಜು಼ ಆರೋನ್ನ ಇವ್ಣೆ, “ಯೆಹೋವ ತುಮುನ ದೇಖಿನ್ ನ್ಯಾವ್ ಫೇಡಾವದೆ. ಶನಕತೊ ಫರೋಹಬಿ ಅಜು಼ ಇನ ಸೇವಕ್‌ಖ್ಹಾರು ಹಮುನ ದೇಖಿನ್ ಕಚಿಂಡ್ ಕರಾನಿತರ ತುಮೆ ಕರೈರಾಖ್ಯಸ್. ಹಮುನ ಮಾರಿನಾಖಾನ ಇವ್ಣ ಹಾತ್ಮ ತಲ್ವಾರ್‌ ದಿರಾಖ್ಯಸ್” ಕರಿಬೋಲ್ಯ. ಯೆಹೋವ ತುಮಾರಿ ಗಲತ್‌ನ ಬರೊಬರ‍್ನಿ ನಿಶತ್ ದ್ಯವಾದೆ” ಕರಿಬೋಲ್ಯು.<verse eid="EXO 5:21" /></para>
  <para style="s">ಮೋಶೆ ದೇವ್ನ ಬೋಲಿವತಾಳ್ಯೋತೆ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 5:22" />ತದೆ ಮೋಶೆ ಯೆಹೋವಕನ ಪಾಛು಼ “ಮಾಲಿಕ್ ಆ ಅದ್ಮಿವ್‌ನ ಕೇಡ್ ಕರಿ ರಾಖ್ಯೊನಿ? ಮನ ಮೋಕ್‌ಲ್ಯೊತೆ ಶನ? <verse eid="EXO 5:22" /><verse number="23" style="v" sid="EXO 5:23" />ಮೇ ಫರೋಹಕನ ಜೈ಼ನ್ ತಾರ ನಾಮ್ಮ ವಾತೆ ಬೊಲ್ಯೊ ತಪ್‌ಥು ಯೊ ಅದ್ಮಿವೊನ ಕೇಡೆಸ್ ಕರುಕರಸ್. ತೂ ತಾರ ಅದ್ಮಿವ್‌ನ ಖಲಿ ಅತ್ರುಖ್ಹೂಬಿ ಛು಼ಕಾಯೊ ಕೊಯ್ನಿನಿ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="EXO 5:23" /></para>
  <chapter eid="EXO 5" />
  <chapter number="6" style="c" sid="EXO 6" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 6:1" />ಅನಕೇಡೆಥು ಯೆಹೋವನೆ ಮೋಶೆನ, “ಮೆ ಫರೋಹನ ಕರಾನು ಅಖ್ಖು ತೂ ಹಮ್ಕೆ ದೇಖಿಷ್. ಯೊ ಮಾರ ಶಕತ್ನ ಹಾತ್ನ ದೇಖಿನ್ ಇವ್ಣುನ ನಖ್ಹಾಡಿದಿಶೆ. ಮಾರಿ ಮೋಟಿ ಶಕಥ್ಥಿ ಖ್ಹತಾಪ್ಣಿಲೀನ್ ಇವ್ಣುನ ಇನ ದೇಖ್ಹ್‌ಥು ಕಾಡಿನಾಕ್ಷೆ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="EXO 6:1" /></para>
  <para style="s">ಮೋಶೆನ ದೇವ್ನೆ ಬುಲಾಯೊತೆ</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 6:2" />ದೇವ್ನೆ ಮೋಶೆನ ಜೋ಼ಡೆ ಪಾಛೊ಼ ವಾತ್‌ಬೋಲಿನ್ ಅಮ್ ಬೊಲ್ಯೊ, ಮೇಸ್ ಯೆಹೋವ, <verse eid="EXO 6:2" /><verse number="3" style="v" sid="EXO 6:3" />ಮೇ ಅಬ್ರಹಾಮ್‌ನಬಿ, ಇಸಾಕ್‌ನಾಬಿ, ಯಾಕೋಬ್‌ನಾಬಿ ಅಖ್ಖೀಸ್ ಶಕತ್ನೊ ದೇವ್‌ಹುಯಿನ್ ದೆಖೈರ‍್ಹೋಥೊ. ಕತೋಬಿ ಯೆಹೋವ ದೇವ್ ಕರಿ ಬೋಲಾನು ಮಾರು ನಾಮ್ ಇವ್ಣುನ ಮಾಲುಮ್‌ ಕೋಪಡ್ಯುನಿ. <verse eid="EXO 6:3" /><verse number="4" style="v" sid="EXO 6:4" />ಕಾಹೆತೆ , ಇವ್ಣೆ ಅಲ್ಹಾವ್ ದೇಖ್ಹ್‌ವಾಳ ಹುಯಿನ್ ಜಿವ್ಣುಕರ‍್ಯಥಾತೆ ಕಾನಾನ್ ದೇಖ್ಹ್‌ನ ಮೆ ಇವ್ಣುನ ಶೊಂತ್‌ ಮುಲಕ್‌ ಬಣೈನ್ ದಿಶ್‌ಕರಿ ಇವ್ಣ ಜೋ಼ಡೆ ಒಪ್ಪಂದಾನನ ಕರಿರಾಖ್ಯೊಸ್. <verse eid="EXO 6:4" /><verse number="5" style="v" sid="EXO 6:5" />ಈಜಿಪ್ಟ್‌ವಾಳು ಗುಲಾಮ್‌ ಕರಿರಾಖ್ಯುಥೂತೆ ಇಸ್ರಾಯೇಲ್‌ನಿ ಅಂದ್ರೋಖ್ಹ್‌ ಹಮ್ಕೆ ಮನ ಖ್ಹಮಜ್‌ಪಡ್ಯು ಮೇ ಕರ‍್ಯೋತೆ ವಾಗ್ದಾನ್ನ ಪಾಛು಼ ಖ್ಹಯಾಲ್ಮ ಲೀರಾಖ್ಯೊಸ್. <verse eid="EXO 6:5" /><verse number="6" style="v" sid="EXO 6:6" />ಇನಖ್ಹಾಜೇಥಿ ತು ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಮಾರ ನಾಮ್ಮ ಬೋಲ್ನು ಶಾತ್‌ಕತೊ, ‘ಮೇಸ್ ಯೆಹೋವ ಈಜಿಪ್ಟ್‌ವಾಳು ತುಮಾರೇಥಿ ಕರವ್‌ಕರಾತೆ ಫುಗಟ್ನ ಕಾಮ್‍ಥಿ ಛು಼ಕೈನ್, ಇವ್ಣ ಗುಲಾಮ್‌ಗಿರಿಥಿ ತುಮುನ ಛೋ಼ಡೈನ್ ಮಾರೊ ಹಾತ್ ಪೂರೈನ್ ಇವ್ಣುನ ಮಹಾನ್ ಶಿಕ್ಷೆಖ್ಹಾರಿ ದೀನ್ ತುಮುನ ಬಚಾ಼ಡಿಶ್. <verse eid="EXO 6:6" /><verse number="7" style="v" sid="EXO 6:7" />ಮೇ ತುಮುನ ಮಾರ ಪ್ರಜೆಕರಿನ್ ಚೂ಼ಣಿಲೀನ್ ತುಮುನ ದೇವ್ ಹುಯಿರ‍್ಹೋಸ್. ಈಜಿಪ್ಟ್‌ವಾಳು ಕರವ್‌ಕರಾತೆ ಫುಗಟ್‌ನಿ ಚಾ಼ಕ್ರಿನ ಮೇ ತುಮುನ ಛು಼ಕಾವನಿವಖ್ಹ್‌ತೆ ಯೆಹೋವಕರಿ ಮೇಸ್ ತುಮಾರೊ ದೇವ್‌ಹುಯಿರ‍್ಹಿಷ್ ಕರಿ ತುಮುನ ಮಾಲುಮ್‌ಪಡ್‌ಷೆ. <verse eid="EXO 6:7" /><verse number="8" style="v" sid="EXO 6:8" />ಆಸ್ ಕಾಹೆತೆ ಅಬ್ರಹಾಮ್, ಇಸಾಕ್ ಅಜು಼ ಯಾಕೋಬನ ಮೇ ಹಾತ್ ಪಾಡಿನ್ ವಾಗ್ದಾನ್ ಕರಿಶ್‌ತೆ ದೇಖ್ಹ್‌ಮ ತುಮುನ ಬುಲೈಲಿ ಅಯಿನ್ ಯೊ ತುಮುನ ಶೊಂತ್‌ಕರಿ ದಿಶ್‌ಕರಿ ಬೋಲ್ಯೊಹುಯೊ ಯೆಹೋವಕರಿ ಮೇಸ್‌ಕರಿ ಇವ್ಣುನ ಬೋಲ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 6:8" /><verse number="9" style="v" sid="EXO 6:9" />ಮೋಶೆ ಆ ವಾತ್ನ ಯೋಸ್ ಪರಕ್ಮ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಬೋಲಾನಿ ವಖ್ಹ್‌ತೆ ಇವ್ಣೊ ಮನ್ ಕಮ್‌ಲೈ ಗಯೋತೆಖ್ಹಾಜೆ ಕಠಣ್‌ಥಿ ಚಾ಼ಕ್ರಿಕರ‍್ನು ಖ್ಹಾಜೇಥಿಬಿ ಇವ್ಣೆ ಮೋಶೆನಿ ವಾತ್ನ ಖ್ಹಮ್‌ಜುಸ್ ಕೊಯ್ನಿ. <verse eid="EXO 6:9" /><verse number="10" style="v" sid="EXO 6:10" />ತದೆ ಯೆಹೋವನೆ ಮೋಶೆನಿ ಜೋ಼ಡೆ ವಾತೆ ಬೋಲಿನ್, <verse eid="EXO 6:10" /><verse number="11" style="v" sid="EXO 6:11" />“ತು ಈಜಿಪ್ಟ್‌ನ ರಾಜ಼ ಹುಯಿರೋತೆ ಫರೋಹಕನ ಜೈ಼ನ್ ಯೊ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಇನ ದೇಖ್ಹ್‌ಥು ನಿಕ್ಳಿ ಜಾ಼ವನಿತರ ಇನಜೋ಼ಡೆ ವಾತೆ ಬೋಲ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 6:11" /><verse number="12" style="v" sid="EXO 6:12" />ಇನ ಮೋಶೆ ಯೆಹೋವನ ಖ್ಹಾಮ್ಣೆ, “ಹಂದೇಖೊ ಇಸ್ರಾಯೇಲಸ್ ಮಾರಿ ವಾತ್ನ ಕೊಖ್ಹಮ್‌ಜ್ಯುನಿ. ಅಮ್‌ರ‍್ಹವಾಪರ್ ತೊತ್‌ಳೈನ್ ಬೋಲಾನು ಮಾರಿವಾತೆನ ಫರೋಹ ಕಾನ್ ದಿಶೆ?” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 6:12" /><verse number="13" style="v" sid="EXO 6:13" />ಯೆಹೋವನೆ ಮೋಶೆ ಅಜು಼ ಆರೋನನಿ ಜೋ಼ಡ್ಮ ವಾತೆ ಬೋಲಿನ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಈಜಿಪ್ಟ್‌ಥು ಬುಲೈಲಿನ್ ಆವ್ಣುಕರಿ ಇವ್ಣುನ ಹುಕುಮ್‌ ದೀನ್ ಇವ್ಣುನ ಇಸ್ರಾಯೇಲ್‌ವಾಳಕನಬಿ ಈಜಿಪ್ಟ್‌ನೊ ರಾಜ಼ ಫರೋಹಕನ ಮೋಕ್‌ಲ್ಯೊ.<verse eid="EXO 6:13" /></para>
  <para style="s">ಮೋಶೆ ಅಜು಼ ಆರೋನನಿ ಪಿಳ್ಗಿ</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 6:14" />ಇಸ್ರಾಯೇಲ್ ಖಾನ್‌ಖೋಜ್‌ನ ಕುಟುಂಬ್‌ನ ಶಾಣ ಇಸ್ರಾಯೇಲ್‌ನೊ ಪೈಲ್ಹೋಟೊ ಛಿಯ್ಯೊ ಹುಯಿರ‍್ಹೋತೆ ರೂಬೇನ್ನ ಲಡ್ಕಾ: ಹನೋಕ್, ಫಲ್ಲೂ, ಹೆಚ್ರೋನ್, ಕರ್ಮೀ. ಅವ್ಣೇಸ್ ರೂಬೆನ್‌ಥಿ ಹುಯೂತೆ ಖಾನ್‌ಖೋಜ಼್‌ನ ಪಹಿಲ ಪರ್ಖ್ಹ. <verse eid="EXO 6:14" /><verse number="15" style="v" sid="EXO 6:15" />ಸಿಮೆಯೋನ್ನ ಲಡ್ಕಾಹುಯಿರ‍್ಹಾತೆ; ಯೆಮೂಯೇಲ್, ಯಾಮೀನ್, ಓಹದ್, ಯಾಕೀನ್, ಚೋಹರ್ ಅಜು಼ ಕಾನಾನ್ನಿ ತಯೇಡಾಮ ಪೈದಹುಯೊತೆ ಸೌಲ, ಅವ್ಣೆ ಸಿಮೆಯೋನ್‌ಥಿ ಹುಯಾತೆ ಖಾನ್‌ಖೋಜ಼್‌ನ ಪಹಿಲ ಪರ್ಖ್ಹಾ. <verse eid="EXO 6:15" /><verse number="16" style="v" sid="EXO 6:16" />ಖಾನ್‌ದಾನ್ನಿ ಪರಕ್ಮ ಲೇವಿನ ಲಡ್ಕಾ: ಗೇರ್ಷೋನ್, ಕೆಹಾತ್, ಮೆರಾರೀ, ಅವ್ಣೇಸ್. ಲೇವಿ ಎಕ್‌ಖ್ಹೊ ಖ್ಹಾತ್ ಉಪ್ಪರ್ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್ ಬಚಿನ್‌ಥೊ. <verse eid="EXO 6:16" /><verse number="17" style="v" sid="EXO 6:17" />ಖಾನ್‌ಖೋಜ಼್‌ನಿ ಪರಕ್ಮ ಗೇರ್ಷೋನನ ಲಡ್ಕಾ: ಲಿಬ್ನೀ ಅಜು಼ ಶಿಮ್ಮಿ. <verse eid="EXO 6:17" /><verse number="18" style="v" sid="EXO 6:18" />ಕೊಹಾತನ ಲಡ್ಕಾ: ಅಮ್ರಾಮ, ಇಚ್ಹಾರ್, ಹೆಬ್ರೋನ್, ಉಜ್ಜಿಯೇಲ್. ಕೆಹಾತ್ ಎಕ್‌ಖ್ಹೊ ತೀನ್‌ಉಪ್ಪರ್ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್ ಬಚಿಥೊ. <verse eid="EXO 6:18" /><verse number="19" style="v" sid="EXO 6:19" />ಮೆರಾರೀನ ಲಡ್ಕಾ: ಮಹ್ಲೀ, ಮೂಷೀ ಖಾನ್‌ದಾನ್ನಿ ಪರಕ್ಮ ಲೇವಿಥಿ ಹುಯೂತೆ ಖಾನ್‌ಖೋಜ಼್‌ ಆಸ್ ಹುಯಿರ‍್ಹುಥು. <verse eid="EXO 6:19" /><verse number="20" style="v" sid="EXO 6:20" />ಅಮ್ರಾಮನೆ ಇನ ಬಾನಿ ನ್ಹಾನಿ ಭೇನ್‌ ಯೋಕೆಬೆದನ ವ್ಯಾಹ ಕರಿಲಿದೊ. ಹೈರಿತೆನೆ ಇನ ಆರೋನನ ಮೋಶೆನ ಪೈದಾಕರಿ. ಅಮ್ರಾಮ ಏಕ್‌ಖ್ಹೊ ಖ್ಹಾತ್ ಉಪ್ಪರ್ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್ ಬಚ್ಯೊ. <verse eid="EXO 6:20" /><verse number="21" style="v" sid="EXO 6:21" />ಇಚ್ಹಾರನ ಲಡ್ಕಾ ಕೋರಹ, ನೆಫೆಗ್ ಅಜು಼ ಜಿಕ್ರೀ <verse eid="EXO 6:21" /><verse number="22" style="v" sid="EXO 6:22" />ಉಜ್ಜಿಯೇಲ್‌ನೊ ಲಡ್ಕಾ: ಮೀಷಾಯೇಲ್, ಎಲ್ಜಾಫಾನ್ ಅಜು಼ ಸಿತ್ರೀ. <verse eid="EXO 6:22" /><verse number="23" style="v" sid="EXO 6:23" />ಆರೋನನೆ ಅಮ್ಮಿನಾದಾಬನಿ ಛೋ಼ರಿ ನಹಶೋನ್ನಿ ನ್ಹಾನಿ ಭೇನ್‌ಬಿ ಹುಯಿರ‍್ಹಿಥೀತೆ, ಎಲೀಶೇಬನ ವ್ಯಹಾಕರ‍್ಯೊ. ಹೈರಿತೆಮ ಇನ ನಾದಾಬ್, ಅಬೀಹೂ, ಎಲ್ಲಾಜಾರ್, ಈತಾಮಾರ್ ಕರಿ ಬೋಲವಾಳು ಪೈದಹುಯು. <verse eid="EXO 6:23" /><verse number="24" style="v" sid="EXO 6:24" />ಕೋರಹನ ಲಡ್ಕಾ: ಅಸ್ಸೀರ್, ಎಲ್ಕಾನ್, ಅಬೀಯಾಸಾಫ್ ಅವ್ಣೇಸ್ ಕೋರಹಿವಾಳನು ಖಾನ್‌ಖೋಜ಼್‌. <verse eid="EXO 6:24" /><verse number="25" style="v" sid="EXO 6:25" />ಆರೋನನೊ ಛಿಯ್ಯೊ ಎಲ್ಲಾಜಾರನೆ ಪೂಟಿಯೇಲ್ನ ತಯೇಡ ಲಡ್ಕಾವ್ಮ ಏಕ್‌ಜ಼ಣಿನ ವ್ಯಹಾಕರ‍್ಯೊ. ಹೈರಿತೆನ ಇನ ಫಿನೇಹಾಸನ್ನ ಪೈದಾಕರಿ. ಇವ್ಣ ಇವ್ಣ ಖಾನ್‌ಖೋಜ಼್‌ನಿ ಪರಕ್ಮ ಅವ್ಣೇಸ್ ಲೇವಿನು ಖಾನ್‌ದಾನ್‌. <verse eid="EXO 6:25" /><verse number="26" style="v" sid="EXO 6:26" />ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಇವ್ಣ ಖಾನ್‌ಖೋಜ಼್‌ನಿ ಪರಕ್ಮ, ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಭಾರ್‌ ಕಾಡಿಲಿನ್ ಆವ್ಣುಕರಿ ಯೆಹೋವನೆ ಕಿನ ಬೋಲ್ಯೊಕಿ ಇವ್ಣೆಸ್ ಆರೋನ ಅಜು಼ ಮೋಶೆ. <verse eid="EXO 6:26" /><verse number="27" style="v" sid="EXO 6:27" />ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಭಾರ್ ಬುಲೈಲಿನ್ ಆವಾನಖ್ಹಾಜೆ ಈಜಿಪ್ಟ್‌ನೊ ರಾಜ಼ ಹುಯಿರ‍್ಹೊಥೋತೆ ಫರೋಹನ ಜೋ಼ಡೆ ವಾತೆ ಬೋಲ್ಯಾತೆ ಮೋಶೆ ಅಜು಼ ಆರೋನ ಅವ್ಣೇಸ್.<verse eid="EXO 6:27" /></para>
  <para style="s">ಮೋಶೆಬಿ ಆರೋನನೆ ದೇವ್ನಿ ಹುಕುಮ್</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 6:28" />ಯೆಹೋವ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ, ಮೋಶೆನ ಜೋ಼ಡೆ ವಾತೆ ಬೋಲಾನಿ ವಖ್ಹ್‌ತೆ, <verse eid="EXO 6:28" /><verse number="29" style="v" sid="EXO 6:29" />ಇನೆ ಮೋಶೆನ, “ಮೆ ಯೆಹೋವ ಮೇ ತುನ ಬೋಲ್ಯೊತೆ ಅಖ್ಖಾನ ತೂ ಈಜಿಪ್ಟ್‌ನೊ ರಾಜ಼ ಹುಯಿರ‍್ಹೋತೆ ಫರೋಹಾನ ಖ್ಹಮ್‌ಜಾ಼ಡ್” ಕರಿಬೋಲ್ಯೊ <verse eid="EXO 6:29" /><verse number="30" style="v" sid="EXO 6:30" />ಕತೋಬಿ ಮೋಶೆ ಯೆಹೋವಾನ, “ಹಂದೇಕ್, ಮಾಲಿಕ್ ಮೇ ತೊತ್‌ಳ್ಯೊ ಹುಯಿರೊಸ್, ಫರೋಹ ಮಾರಿ ವಾತೆನ ಕಿಮ್ ಖ್ಹಮಜ಼್‌ಷೆ?” ಕರಿಬೋಲ್ಯೊ.<verse eid="EXO 6:30" /></para>
  <chapter eid="EXO 6" />
  <chapter number="7" style="c" sid="EXO 7" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 7:1" />ತದೆ ಯೆಹೋವನೆ ಮೋಶೆನ ಅಮ್ ಬೋಲ್ಯೊಕಿ, “ಮೇ ತುನ ಫರೋಹನ ಖ್ಹಾಮ್ಣೆ ದೇವ್ನಿ ಝ಼ಗೋಮ ನೇಮಕ್‌ ಕರಿರಾಖ್ಯೊಸ್ ತಾರೊ ಮೋಟೊ ಭೈ ಆರೋನ ತಾರಖ್ಹಾಜೆ ಪ್ರವಾದಿ ಹುಯಿರ‍್ಹಿಷೆ. <verse eid="EXO 7:1" /><verse number="2" style="v" sid="EXO 7:2" />ಮೇ ತುನ ಹುಕುಮ್ ದ್ಯವಾನ ಖ್ಹಾರುಸ್ ತು ಬೋಲ್ನು ಇಸ್ರಾಯೇಲ್‌ವಾಳು ದೇಖ್ಹ್‌ಥು ನಿಕ್ಳಿ ಜಾ಼ವನಿತರ ಹುಕುಮ್ ದೆವಾವ್ಣುಕರಿ ತಾರೊ ಮೋಟೊ ಭೈ ಹುಯಿರ‍್ಹೋತೆ ಆರೋನಸ್ ಫರೋಹನ ಖ್ಹಾಮ್ಣೆ ವಾತೆ ಬೋಲ್ನು. <verse eid="EXO 7:2" /><verse number="3" style="v" sid="EXO 7:3" />ರ‍್ಹಿಯುತೋಬಿ ಮೇ ಫರೋಹನ ಮನ್ಮ ಹಟಕರೈನ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಕೈಯೇಕ್ ಖ್ಹಣೇದ್ನುಕಾಮ್ ಅಜು಼ ಅದ್ಭುತ್‌ಕಾಮ್ ಕರೈನ್ ಮಾರಿ ಶಕತ್ನ ವತಾಳಿಶ್. <verse eid="EXO 7:3" /><verse number="4" style="v" sid="EXO 7:4" />ಫರೋಹ ತಾರಿ ವಾತ್ನ ಖ್ಹಮಜ಼್‌ಷೆ ಕೊಯ್ನಿ. ತದೆ ಮೆ, ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ವಾಳಾನ ಖ್ಹತಾಪ್ಣಿ ದೀನ್, ಮಾರು ಅದ್ಮಿ ಹುಯಿರ‍್ಹುತೆ ಇಸ್ರಾಯೇಲ್ನ ಶಿಪಾಯ್ನಖ್ಹಾರು ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಭಾರ್ ಕಾಡಿಷ್. <verse eid="EXO 7:4" /><verse number="5" style="v" sid="EXO 7:5" />ಮೇ ಈಜಿಪ್ಟ್‌ವಾಳನ ವಿರೋದ್‌ಥಿ ಹಾತ್ ಫಖ್ಹಾರಿನ್ ಇವ್ಣ ಬೀಚ್ಮಾಥು ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಭಾರ್‌ಲೀನ್ ಆವಾನಿವಖ್ಹ್‌ತೆ ಮೇ ಯೆಹೋವ ಕರಿ ಈಜಿಪ್ಟ್‌ವಾಳು ಮಾಲುಮ್ ಕರಿಲಿಷೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 7:5" /><verse number="6" style="v" sid="EXO 7:6" />ಯೆಹೋವನಿ ಹುಕುಮ್‌ನಿತರ ಮೋಶೆ ಅಜು಼ ಆರೋನ ಇವ್ಣೆ ಕರ‍್ಯು. <verse eid="EXO 7:6" /><verse number="7" style="v" sid="EXO 7:7" />ಇವ್ಣೆ ಫರೋಹಕನ ವಾತೆ ಬೋಲ್ಯುತೆ ವಖ್ಹತ್‌ಮ ಮೋಶೆ ಚಾರಿಖ್ಹ್ ವರಖ್ಹ್‌ನೋಬಿ ಅಜು಼ ಆರೋನ ತೀನ್‌ಉಪ್ಪರ್ ಚಾರಿಖ್ಹ್ ವರಖ್ಹ್‌ವಾಳ ಹುಯಿರ‍್ಹಾಥ.<verse eid="EXO 7:7" /></para>
  <para style="s">ಆರೋನನೊ ಲಠ್ಠೊ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 7:8" />ಯೆಹೋವನೆ ಮೋಶೆ ಬಿಜು಼ ಆರೋನ್ನ ಜೋ಼ಡ್ಮ ವಾತೆ ಬೋಲಿನ್, <verse eid="EXO 7:8" /><verse number="9" style="v" sid="EXO 7:9" />“ಫರೋಹ ತುಮುನ, ‘ಮೇ ತುಮಾರಿ ವಾತೆನ ನಂಬಾನಿತರ ತುಮೆ ಮಹಾನ್ ಕಾಮ್ ಖ್ಹಾಮ್ಣೆ ಕರ್ನು’ ಕರಿ ಬೋಲ್ಯೆತೊ ಮೋಶೆ ಆರೋನ್ನ ‘ತಾರ ಹಾತ್ಮ ಛಾ಼ತೆ ಲಠ್ಠಾನ ಫರೋಹನ ಖ್ಹಾಮ್ಣೆ ಮಾಟಿನಪರ್ ಫೇಕ್’ ಕರಿ ಬೋಲ್ನು, ಯೊ ಖ್ಹಾಪ್ ಹುಯಿಜಾಷೆ” ಕರಿ ಹುಕುಮ್‌ದಿದೊ. <verse eid="EXO 7:9" /><verse number="10" style="v" sid="EXO 7:10" />ಮೋಶೆ ಅಜು಼ ಆರೋನ ಇವ್ಣೆ ಫರೋಹಕನ ಜೈ಼ನ್ ಯೆಹೋವನೆ ಇವ್ಣುನ ಹುಕುಮ್ ದ್ಯವಾನಿತರಾಸ್ ಕರ‍್ಯಾ. ಆರೋನನೆ ಇನ ಲಠ್ಠಾನ ಫರೋಹ ಅದಿಕಾರಿಯೇವ್ನ ಅಜು಼ ಶಿಪಾಯ್ನ ಖ್ಹಾಮ್ಣೆ ಜ಼ಮಿನ್‌ಪರ್ ನಾಖಖ್ಹತರ್ ಯೊ ಖ್ಹಾಪ್ ಹುಯಿಗು. <verse eid="EXO 7:10" /><verse number="11" style="v" sid="EXO 7:11" />ಫರೋಹನು ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನು ಫಡಂತ್‌ವಾಳನಬಿ ಜಾ಼ದು ಕರಾವಳನಾಬಿ ಬುಲಾವಖ್ಹತರ್ ಯೊ ಜಾ಼ದು ಕರಾವಳು ಇವ್ಣಿ ಮಂತರ್‌ಥಿ ಇಮ್ಮಸ್ ಕರ‍್ಯು. <verse eid="EXO 7:11" /><verse number="12" style="v" sid="EXO 7:12" />ಇವ್ಣೆ ಇವ್ಣ ಇವ್ಣ ಲಠ್ಠಾವ್ನ ಜ಼ಮಿನ್‌ಪರ್ ಫೇಕಾಖ್ಹತರ್ ಯೊ ಅಖ್ಖುಬಿ ಖ್ಹಾಪ್ ಹುಯಿಗು. ಕತೋಬಿ ಆರೋನ್ನೊ ಲಠ್ಠೊ ಇವ್ಣ ಅಖ್ಖ ಲಠ್ಠಾವ್ನ ಗಳಿಲಿದು. <verse eid="EXO 7:12" /><verse number="13" style="v" sid="EXO 7:13" />ಯೆಹೋವ ಪಹಿಲೆ ಬೋಲನಿತರಾಸ್ ಫರೋಹನ್ನೊ ದಿಲ್‌ ಕಠಣ್ ಹುಯಿಗು. ಇನೆ ಇವ್ಣಿವಾತ್ನ ಖ್ಹಂಜೊ ಕೊಂತೆ ಚ಼ಲೆಗಯೊ.<verse eid="EXO 7:13" /></para>
  <para style="s">ಈಜಿಪ್ಟ್‌ನ ಆಯುತೆ ಖತ್ರ</para>
  <para style="s1">ಲ್ಹೋಯಿ</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 7:14" />ತದೆ ಯೆಹೋವ ಮೋಶೆನ, “ಫರೋಹ ಘಣು ಹಟಕರಿನ್, ಯೊ ಅದ್ಮಿವ್‌ನ ಜಾ಼ವಾನ ಕೋ ಮ್ಹೇಲ್‌ಶೇನಿ ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 7:14" /><verse number="15" style="v" sid="EXO 7:15" />ತು ವ್ಹಾಣೆಸ್ ಫರೋಹಕನ ಜಾ಼, ಯೊ ಪಾಣಿಕನ ಉತ್ರಿನ್ ಆವ್‌ಶೇನಿ ಖ್ಹಾಪ್‌ಹುಯಿನ್ ಬದ್ಲಿಗಯೊತೆ ಲಠ್ಠಾನ ತಾರ ಹಾತ್ಮ ಪಾಡಿಲಿನ್ ಇನ ಮ್ಹೋರೆ ಹುವಾನಸ್‌ಖ್ಹಾಜೆ ನೈಲ್ ನದ್ದೀನಿ ಕನಾರಿಮ ಭಿಯೊರಿನ್ ಇನಖ್ಹಾಜೆ ಟಿವಾವೊ. <verse eid="EXO 7:15" /><verse number="16" style="v" sid="EXO 7:16" />ರಾಜ಼ನ ಅಮ್‌ ಬೋಲ್, ಇಬ್ರಿಯಾನೊ ದೇವ್ ಯೆಹೋವನೆ ಮನ ತಾರಕನ ಮೋಕ್ಲಿನ್, ಝ಼ಂಗಳ್‌ಮ ಇನ ಆರಾದನೆ ಕರಾನಖ್ಹಾಜೆ ಇನ ಅದ್ಮಿನ ಅಧಿಕಾರ್ ದೇವ್ಣುಕರಿ ಹುಕುಮ್ ದಿರಾಖ್ಯೊಸ್. ಹಮ್ಕೆ ಲಗೂಬಿ ತುನೆ ಇನ ಖ್ಹಮ್‌ಜ್ಯೊಕೊಯ್ನಿ. <verse eid="EXO 7:16" /><verse number="17" style="v" sid="EXO 7:17" />ಅನಖ್ಹಾಜೇಥಿ ಯೆಹೋವನೆ ಬೋಲ್ಯೊತೆ ಶಾತ್‌ಕತೊ ತೂ ಮನ ಯೆಹೋವಕರಿ ಮಾಲುಮ್‌ ಕರಿಲ್ಯವಾನಖ್ಹಾಜೆ ಮಾರ ಸೇವಕ್‌ನ ಹಾತ್ಮನೊ ಲಠ್ಠೇಥಿ ನೈಲ್ ನದ್ದಿನ ಪಾಣಿನ ಮಾರೈಶ್, ತದೆ ಯೊ ಲ್ಹೋಯಿ ಉಷೆ. <verse eid="EXO 7:17" /><verse number="18" style="v" sid="EXO 7:18" />ನದ್ದೀಮ ಛಾ಼ತೆ ಮಾಚ್ಲಖ್ಹಾರು ಮರಿಜಾ಼ಷೆ ನದ್ದಿ ಗಲೀಜ಼್‌ಹುಯಿನ್ ವಾ ಮಾರ್‌ಶೆ. ಇನ ಪಿಯಾನ ಈಜಿಪ್ಟ್‌ವಾಳನ ಕಚಿಂಡ್ ಹುಯಿಜಾ಼ಶೆ’ ಕರಿ ಬೋಲ್ನು” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 7:18" /><verse number="19" style="v" sid="EXO 7:19" />ಯೆಹೋವನೆ ಮೋಶೆನ ಜೋ಼ಡೆ ವಾತೆ ಬೋಲಿನ್, “ಆರೋನನ, ‘ತಾರ ಲಠ್ಠಾನಲೀನ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಛಾ಼ತೆ ನದ್ದಿ, ವ್ಹೆಕ್‌ಳೊ, ತಲಾವ್, ಪಾಣಿನೊ ಕುಂಟೊ ಅಥ್ರಾನು ಪಾಣಿರ‍್ಹವಾನು ಅಖ್ಖೀಸ್ ಝ಼ಗೋಪರ್ ಇನ ವತಾಳ್’ ಕರಿ ಬೋಲ್ನು, ಆರೋನ್ನೆ ಇಮ್ ಯೊ ಲಠ್ಠಾನ ಧರಿನ್ ವತಾಳನಿ ವಖ್ಹ್‌ತೆ ಯೊ ಪಾಣಿ ಅಖ್ಖು ಲ್ಹೋಯಿಉಷೆ. ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ ಅಖ್ಖು ಲಾಕ್ಡಾನ ರಾಛಾ಼ಮಾಬಿ ಬಂಡಾನ ಬಾನೆಮಾಬಿ ಛಾ಼ತೆ ಪಾಣಿ ಲ್ಹೋಯಿ ಹುಯಿಜಾಷೆ ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 7:19" /><verse number="20" style="v" sid="EXO 7:20" />ಮೋಶೆ ಅಜು಼ ಆರೋನ ಇವ್ಣೆ ಯೆಹೋವ ಇವ್ಣುನ ಬೋಲನಿತರಾಸ್ ಕರ‍್ಯಾ. ಆರೋನನೆ ಫರೋಹ ಅಜು಼ ಇನ ಅದಿಕಾರಿನ ಖ್ಹಾಮ್ಣೆ ಲಠ್ಠಾನ ಪಾಡಿನ್, ನೈಲ್ ನದ್ದಿಮಾನು ಪಾಣಿನ ಮಾರಖ್ಹತರ್ ಯೊ ಅಖ್ಖು ಲ್ಹೋಯಿ ಹುಯಿಗು. <verse eid="EXO 7:20" /><verse number="21" style="v" sid="EXO 7:21" />ಇನಾಮ ಥೂತೆ ಮಾಚ್ಲ ಮರಿಗಯು. ನದ್ದಿ ಖ್ಹಡಿ ವಾ ಮಾರುಕರ್ತುಥೂತೆ ಇನಖ್ಹಾಜೆ ಈಜಿಪ್ಟ್‌ವಾಳು ನೈಲ್ ನದ್ದಿನ ಪಾಣಿನ ಪಿಯಾನ ಕೊಹುಯುನಿ. ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಅಖ್ಖು ಲ್ಹೋಯಿಸ್ ದೆಖವ್‌ಕರ್ತುಥು. <verse eid="EXO 7:21" /><verse number="22" style="v" sid="EXO 7:22" />ಕತೋಬಿ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನು ಮಂತರ್‌ಕರಾವಳು ಇವ್ಣ ಮಂತರ್‌ಥಿ ಯೋಸ್ ಪರಕ್ಮ ಕರ‍್ಯುತೆ ಫರೋಹನು ದಿಲ್‌ ಬಿಜೂ಼ಬಿ ಕಠಣ್ ಹುಯಿಗು. ಯೆಹೋವ ಬೋಲ್ಯೊತೆ ತಿಮ್ಮಸ್ ಇನೆ ಮೋಶೆ ಅಜು಼ ಆರೋನಾನಿ ವಾತೆನ ಖ್ಹಂಜೊ ಕೊಂತೆ ಗಯೊ. <verse eid="EXO 7:22" /><verse number="23" style="v" sid="EXO 7:23" />ಅಮ್ ಫರೋಹನೆ ಯೊ ಮಹಾನ್ ಕಾಮ್ನ ಖ್ಹಾಯ್ ಕರ‍್ಯೊಕೊಂತೆ ಇನ ಘರೆ ಚ಼ಲೆಗಯೊ. <verse eid="EXO 7:23" /><verse number="24" style="v" sid="EXO 7:24" />ಈಜಿಪ್ಟ್‌ವಾಳು ಖ್ಹಾರು ನದ್ದಿನ ಪಾಣಿನ ಪಿಯಾನ ಕೊಹುಯುನಿತೆ ಪಿಯಾನ ಪಾಣಿನಖ್ಹಾಜೆ ನದ್ದಿನ ಅಶ್‌ಪಿಶ್ ಖಾಡ್‌ ಖೋಂದ್ಯು. <verse eid="EXO 7:24" /><verse number="25" style="v" sid="EXO 7:25" />ಯೆಹೋವ ನೈಲ್ ನದ್ದಿನಪರ್ ಮಾರನ ಪಾರ್ ಖ್ಹಾತ್‌ದನ್ ಭರೈಗು.<verse eid="EXO 7:25" /></para>
  <chapter eid="EXO 7" />
  <chapter number="8" style="c" sid="EXO 8" />
  <para style="s">ಮೇಂಡುಕ್‌ಅಖ್ಖು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 8:1" />ಇನಕೆಡೇಥು ಯೆಹೋವಾನೆ ಮೋಶೆನಿ ಜೋ಼ಡ್ಮ ಇನ, “ತೂ ಫರೋಹಕನ ಜೈ಼ನ್, ‘ಯೆಹೋವ ಬೋಲ್ಯೊತೆ ತಿಮ್‌’ ಮನ ಆರಾದನೆ ಕರಾನಿತರ ಮಾರ ಅದ್ಮಿನ ಹುಕುಮ್‌ ದೇವ್ಣು ಕರಿ ಬೋಲ್ನು. <verse eid="EXO 8:1" /><verse number="2" style="v" sid="EXO 8:2" />ತೂ ಜಾ಼ವಾನ ನಾ ಮ್ಹೇಲ್ಯೊತೊ, ಮೇ ತಾರ ದೇಖ್ಹ್‌ನಿ ಹರೇಕ್ ಬಾಜು಼ ಮೇಂಡುಕ್‌ಥಿ ಖ್ಹತೈಶ್. <verse eid="EXO 8:2" /><verse number="3" style="v" sid="EXO 8:3" />ನೈಲ್ ನದ್ದೀಮ ಮೇಂಡುಕ್‌ಖ್ಹಾರು ಘಣು ಭರೈಜ಼ಾಶೆ, ಯೊ ನಿಕ್‌ಳಿ ಅಯಿನ್ ತಾರು ಮಹೇಲ್‌ಮಾಬಿ, ಖ್ಹುವಾನ ಕೋಣಾಮಾಬಿ, ಖಟಿಯಾನ ಉಪ್ಪರ್‌ಬಿ ಆವ್‌ಶೆ ಕಾಹೆತೆ ಅದಿಕಾರಿಯೇವ್‌ನ ಘರ್‌ಮಾಬಿ, ತಾರ ಅದ್ಮಿಯೇನ ಘರ್‌ಮಾಬಿ, ಛು಼ಲ್ಲಾಮಾಬಿ ಅಜು಼ ಖಾಣನ ರಾಛ಼ಾಮಾಥು ನಿಕ್‌ಳ್ಯು. <verse eid="EXO 8:3" /><verse number="4" style="v" sid="EXO 8:4" />ತಾರಪರ್‌ಬಿ ತಾರ ಅದ್ಮಿಪರ್‌ಬಿ ಅಜು಼ ತಾರ ಪರಿವಾರ್‌ವಾಳ ಪರ್‌ಬಿ ಮೇಂಡುಕ್ ಕೂದ್‌ಶೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 8:4" /><verse number="5" style="v" sid="EXO 8:5" />ಯೆಹೋವ ಮೋಶೆನಿ ಜೋ಼ಡ್ಮ ವಾತೆ ಬೋಲಿನ್, “ತೂ ಆರೋನನ, ತಾರೊ ಲಠ್ಠೊ ಧರಿಲಿನ್ ನದ್ದಿ, ವ್ಹೆಕ್‌ಳೊ, ತಲಾವ್, ಆ ಅಖ್ಖಾಪರ್ ಇನ ಧರಿಲಿನ್ ಹಾತ್‌ಕರ್. ತದೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಉಪ್ಪರ್‌ ಮೇಂಡುಕ್‌ಖ್ಹಾರು ಫೈಲೈಜ಼ಾಶೆ” ಕರಿ ಬೋಲ್ನುಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 8:5" /><verse number="6" style="v" sid="EXO 8:6" />ತದೆ ಆರೋನನೆ ಈಜಿಪ್ಟ್‌ಮ ಪಾಣಿರ‍್ಹವಾನಿ ಹರೇಕ್ ಝ಼ಗೋಪರ್ ಇನ ಹಾತ್ ವತಾಳಖ್ಹತರ್‌ ಮೇಂಡುಕ್‌ಖ್ಹಾರು ನಿಕ್‌ಳಿ ಅಯಿನ್ ದೇಖ್ಹ್‌ ಅಖ್ಖೂಸ್ ಭರೈಗಯು. <verse eid="EXO 8:6" /><verse number="7" style="v" sid="EXO 8:7" />ಕತೋಬಿ ಮಂತರ್‌ವಾದಿಖ್ಹಾರು ಇವ್ಣು ಮಂತರ್‌ಥಿ ಇಮ್ಮಸ್ ಕರಿನ್, ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಪರ್ ಮೇಂಡುಕ್‌ಖ್ಹಾರು ಆವನಿತರ ಕರ‍್ಯು. <verse eid="EXO 8:7" /><verse number="8" style="v" sid="EXO 8:8" />ತದೆ ಫರೋಹನೆ ಮೋಶೆ ಅಜು಼ ಆರೋನನ ಬುಲೈಮಂಗೈನ್‌, “ತುಮೆ ಯೆಹೋವನ ಪ್ರಾರ್ಥನೆ ಕರಿನ್ ಆ ಮೇಂಡುಕ್‌ಅಖ್ಖಾನ ಮಾರಕನಥೂಬಿ ಮಾರ ಅದ್ಮಿವ್‌ಕನಥೂಬಿ ಹಟೈನಾಖಿದೇವ್ಣು, ಇಮ್ ಕರ‍್ಯೊತೊ ತುಮಾರು ಅದ್ಮಿ ಯೆಹೋವನಖ್ಹಾಜೆ ಬಲಿದ್ಯವಾನ ಇವ್ಣುನ ಮೆ ಅಧಿಕಾರ್ ದೆವುಸ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 8:8" /><verse number="9" style="v" sid="EXO 8:9" />ತದೆ ಮೋಶೆನೆ ಫರೋಹನ ಮನ ತುಮಾರಖ್ಹಾಜೆ ಪ್ರಾರ್ಥನೆಕರಾನ ಸಂತೋಖ್ಹ್‌ಹುವಸ್‌, ಮೇ ತುಮಾರಖ್ಹಾಜೆ, ತುಮಾರ ಅದಿಕಾರಿನಖ್ಹಾಜೆ ಅಜು಼ ತುಮಾರ ಅದ್ಮಿವೋನಖ್ಹಾಜೆ ಪ್ರಾರ್ಥನೆಕರಾನ ವೇಳ್ನ ಗೊತ್‌ಕರುಸ್‌. ತದೆ ತುಮೆ ಮೇಂಡುಕ್‌ಅಖ್ಖಾನ ಕಾಡಿನಾಕ್‌ಶು, ಅಜು಼ ನೈಲ್‌ನದ್ದಿನ ಮ್ಹೇಲ್ಯುತೊ ಶಾತ್‌ಬಿ ಕೋರ‍್ಹಿಶೇನಿ. <verse eid="EXO 8:9" /><verse number="10" style="v" sid="EXO 8:10" />ಫರೋಹನೆ ಮೋಶೆನ, “ತಾರ ವಾತ್ನಿ ಪರಕಸ್ ಹುವಾದೆ, ಅನಖ್ಹಾಜೇಥಿ ಹಮಾರ ದೇವ್ ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವನ ಸಮಾನ್ ಬಿಜು಼ ಕೋಣ್ಬಿಕೊಯ್ನಿಕರಿ ತು ಮಾಲುಮ್‌ ಕರಿಲಿಷ್. <verse eid="EXO 8:10" /><verse number="11" style="v" sid="EXO 8:11" />ಮೇಂಡುಕ್ ತುನಾಬಿ, ತಾರ ಘರ್‌ಮಾಬಿ, ತಾರಿ ಪ್ರಜೇನಿ ಪರಿವಾರ‍್ನಬಿ ಮ್ಹೇಲಿನ್ ನೈಲ್ ನದ್ದೀಮ ಖಾಲಿ ರ‍್ಹಿಶೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 8:11" /><verse number="12" style="v" sid="EXO 8:12" />ಮೋಶೆ ಅಜು಼ ಆರೋನ ಇವ್ಣೆ ಫರೋಹಕಂಥು ನಿಕ್ಳಿಗಯು. ತದೆ ಮೋಶೆ ಯೆಹೋವನ ತುನೆ ಫರೋಹಪರ್ ಲೈರಾಖ್ಯೊತೆ ಮೇಂಡುಕ್‌ಅಖ್ಖಾನ ನಖ್ಹಾಡಿದೇವ್ಣುಕರಿ ಬಿಂತಿಕರ‍್ಯೊ. <verse eid="EXO 8:12" /><verse number="13" style="v" sid="EXO 8:13" />ಯೆಹೋವನೆ ಮೋಶೆನಿ ವಾತ್ನಿ ಪರಕ್ಮಾಸ್ ಕರ‍್ಯೊ ಘರ್‌ಮಾಬಿ, ಮಾಳ್‌ಮಾಥೂತೆ ಮೇಂಡುಕ್, ಜ಼ಮೀನ್‌ಮಥೂತೆ ಮೇಂಡುಕ್‌ಅಖ್ಖು ಮರಿಗಯು. <verse eid="EXO 8:13" /><verse number="14" style="v" sid="EXO 8:14" />ಈಜಿಪ್ಟ್‌ವಾಳು ಯೊ ಅಖ್ಖಾನ ರಾಶೆ ರಾಶೆ ಎಕ್ಟುಕರ‍್ಯು, ದೇಖ್ಹ್‌ ಅಖ್ಖೂಸ್ ಖ್ಹಡಿವಾಖ್ಹ್‌ಥಿ ಭರೈಗಯು <verse eid="EXO 8:14" /><verse number="15" style="v" sid="EXO 8:15" />ಕತೋಬಿ ಫರೋಹನೆ ಮೇಂಡುಕ್‌ನಿ ಖ್ಹತಾಪ್ಣಿ ಖತಮ್ ಹುಯಿಗುಕರಿ ಮಾಲುಮ್‌ ಹುವಾಖ್ಹತರ್ ಇನ ದಿಲ್ನ ಕಠಣ್ ಕರಿಲಿದೊ. ಯೆಹೋವನೆ ಬೋಲ್ಯೊತೆ ತಿಮ್ಮಸ್ ಇನೆ, ಮೋಶೆ ಅಜು಼ ಆರೋನ್ನಿ ವಾತ್ನ ಖ್ಹಂಜೊ ಕೊಯ್ನಿತೆ ಗಯೊ.<verse eid="EXO 8:15" /></para>
  <para style="s">ಜು಼ಯೇ</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 8:16" />ಇನವಾರ್ ಯೆಹೋವನೆ ಮೋಶೆನ ಜೋ಼ಡೆ ವಾತೆ ಬೋಲಿನ್ “ತು ಆರೋನ್ನ, ‘ತಾರೊ ಲಠ್ಠೊ ಪಾಡಿನ್ ಜ಼ಮಿನ್ನಿ ಧೂಳ್‌ನಪರ್ ಮಾರ್, ತದೆ ಈಜಿಪ್ಟ್‌ನಿ ಜ಼ಮೀನ್ನಿ ಧೂಳ್‌ಅಖ್ಖು ಮಛ಼್ಛರ್ ಉಷೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 8:16" /><verse number="17" style="v" sid="EXO 8:17" />ಇವ್ಣೆ ಇಮ್ಮಸ್ ಕರ‍್ಯು. ಆರೋನ ಲಠ್ಠೊ ಪಾಡಿನ್ ಜ಼ಮಿನ್ನಿ ಧೂಳ್‌ನಪರ್ ಮಾರ‍್ಯೊತದೆ ಅದ್ಮಿಪರ್‌ಬಿ ಜಾನ್ವರ್‌ನಉಪ್ಪರ್ ಜು಼ಯ್ ಆಯು. ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಪರ್ ಜ಼ಮಿನ್ನು ಧೂಳ್ ಜು಼ಯ್ಯೆ ಹುಯಿಗು. <verse eid="EXO 8:17" /><verse number="18" style="v" sid="EXO 8:18" />ಕತೋಬಿ ಜಾ಼ದು ಕರಾವಳು ಇವ್ಣೆ ಇಮ್ಮಸ್ ಜು಼ಯ್ ಕರಾನ ಕೋಶಿಷ್ ಕರ‍್ಯುತೋಬಿ, ಯೊ ಕೊಹುಯುನಿ. ಯೊ ಜು಼ಯ್ಯೆ ಅದ್ಮಿಪರ್‌ಬಿ ಜಾನ್ವರ್‌ ಪರ್‌ಬಿ ಥೂ. <verse eid="EXO 8:18" /><verse number="19" style="v" sid="EXO 8:19" />ತದೆ ಯೊ ಜಾ಼ದು ಕರಾವಳು ಫರೋಹನ, “ಅದ್ಮೇವ್ನ ಹಾತ್ನು ಕಾಮಸ್ ಬರೊಬ್ಬರ್” ಕರಿ ಬೋಲ್ಯು.ಕತೋಬಿ ಫರೋಹನೊ ದಿಲ್‌ ಕಠಣ್‌ಥು. ಯೆಹೋವ ಮೋಶೆನ ಅಗಾಡಿ ಖ್ಹಮ್‌ಜಾ಼ಡಿರಾಖ್ಯೊಥೋತೆ ತಿಮ್ಮಸ್ ಫರೋಹನೆ ಇವ್ಣಿ ವಾತೆನ ಖ್ಹಮ್‌ಜೊಕೊಂತೆ ಗಯೊ.<verse eid="EXO 8:19" /></para>
  <para style="s">ಮಾಖೋಳಿಯೆ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 8:20" />ಇನವಾರ್ ಯೆಹೋವ ಮೋಶೆನ, “ತೂ ವ್ಹಾಣೆ ಉಠಿನ್ ಫರೋಹನ ಖ್ಹಾಮ್ಣೆ ಭೀರೆ. ಯೊ ನದ್ದಿಕನ ಆವ್‌ಶೆ ತು ಇನ ಅಮ್ ಬೋಲ್, ‘ಯೆಹೋವ ಹುಕುಮ್‌ದೇಸ್ ಶಾತ್‌ಕತೊ, ಮನ ಆರಾದನೆ ಕರಾನ ಮಾರ ಅದ್ಮಿನ ಮೋಕಲ್ನು. <verse eid="EXO 8:20" /><verse number="21" style="v" sid="EXO 8:21" />ಕತೋಬಿ ತೂ, ಮಾರ ಅದ್ಮಿನ ಜಾ಼ವಾನ ನಾ ಮ್ಹೇಲ್ಯೊತೊ ಮೆ ತುನಾಬಿ, ತಾರ ಪರಿವಾರ್‌ವಾಳನಬಿ ತಾರ ಘರ್‌ಮಾಬಿ ಖ್ಹತಾಪ್ಣಿ ಹುವಾನಿತರ ಕರೀಶ್. ಈಜಿಪ್ಟ್‌ವಾಳು ಘರ್‌ಮಾಬಿ ಇವ್ಣು ಅಖ್ಖೂಸ್ ಜ಼ಮಿನ್‌ಮಾಬಿ ಯೊ ಮಾಖೋಳೊ ಭರೈಜಾಷೆಕರಿ ಝೇತವ್‌ಕರುಸ್‌. <verse eid="EXO 8:21" /><verse number="22" style="v" sid="EXO 8:22" />ಕತೋಬಿ ಯೊ ದನ್ಮ ಮೇಸ್, ಧರ್ತಿಪರ್ ಯೆಹೋವಕರಿ ತು ಮಾಲುಮ್‌ ಕರಿಲ್ಯವಾನಿತರ ಮಾರು ಅದ್ಮಿ ಜಿವ್ಣುಕರುಕರಾತೆ ಗೋಷೆನ್ ತಬರ್‌ಖಾನ ಖಿವೂಬಿ ಮಾಖೋಳಾನಿ ಖ್ಹತಾಪ್ಣಿಥಿ ಬಚಾ಼ಡಿಶ್‌. <verse eid="EXO 8:22" /><verse number="23" style="v" sid="EXO 8:23" />ಅಮ್ ಮಾರ ಅದ್ಮಿನಾಬಿ ತಾರ ಅದ್ಮಿನ ಬೀಚ್ಮ ಫರಕ್ ಹುವಾನಿತರ ಕರಿಶ್. ಕಾಲೆಸ್ ಆ ಮಹಾನ್ ಕಾಮ್ ಉಷೆಕರಿ ಬೋಲ್ನು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 8:23" /><verse number="24" style="v" sid="EXO 8:24" />ಯೆಹೋವ ಇಮ್ಮಸ್ ಕರ‍್ಯೊ. ಮೋಟ ಮಾಖೋಳಾನ ಫರೋಹನ ಮಹೇಲ್‌ಮಾಬಿ ಇನ ಅದಿಕಾರಿಯೇವ್‌ನ ಘರ್‌ಮಾಬಿ ಮೋಕ್‌ಲ್ಯೊ, ಹಿಡಿ ಈಜಿಪ್ಟ್ ದೇಖ್ಹಸ್‌ ಮಾಖೋಳೇಥಿ ನಾಶ್‌ಹುಯಿಗು. <verse eid="EXO 8:24" /><verse number="25" style="v" sid="EXO 8:25" />ತದೆ ಫರೋಹನೆ ಮೋಶೆ ಅಜು಼ ಆರೋನ್ನ ಬುಲೈ ಮಂಗೈನ್ ಇವ್ಣುನ, “ತುಮೆ ಜೈ಼ನ್ ಆ ದೇಖ್ಹ್‌ಮಾಸ್ ತುಮಾರ ದೇವ್ನ ಬಲಿಸಮರ್ಪಣ್ ಕರೊ” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 8:25" /><verse number="26" style="v" sid="EXO 8:26" />ಕತೋಬಿ ಮೋಶೆ “ಇಮ್ ಕರಾನು ಬರೋಬರ್‌ಕಾಹೆ ಹಮಾರ ದೇವ್ ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವಾನ ಹಮೆ ಬಲಿ ಸಮರ್ಪಣ್‌ ಕರಾನು ಈಜಿಪ್ಟ್‌ವಾಳನ ಗಲೀಜ಼್ ಹುಯಿರ‍್ಹುಸ್. ಈಜಿಪ್ಟ್‌ವಾಳನ ಗಲೀಜ಼್‌ನಿತರನು ಇವ್ಣ ಡೋಳಾನ ಖ್ಹಾಮ್ಣೆ ಬಲಿಸಮರ್ಪಣ್ ಕರ‍್ಯಾತೊ ಇವ್ಣೆ ಹಮುನ ಬಂಡಫೇಕಿ ಮಾರಿನಾಕ್ಷೇನಿ? <verse eid="EXO 8:26" /><verse number="27" style="v" sid="EXO 8:27" />ಹಮೆ ಜ಼ಂಗಳ್‌ಮ ತೀನ್ ದನ್ ಚಾ಼ಲಿಜೈ಼ನ್ ಹಮಾರ ದೇವ್ ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವ ಹುಕುಮ್‌ ದ್ಯವಾನಿ ಪರಕ್ಮ ಬಲಿ ಸಮರ್ಪಣ್‌ ಕರ‍್ನು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 8:27" /><verse number="28" style="v" sid="EXO 8:28" />ಇನ ಫರೋಹನೆ ಇವ್ಣುನ, “ತುಮಾರ ದೇವ್ ಯೆಹೋವನ ಜ಼ಂಗಳ್‌ಮ ಬಲಿಸಮರ್ಪಣ್ ಕರಾನಿತರ ಮೇ ತುಮುನ ಹುಕುಮ್‌ ದೆವುಸ್‌. ಕತೋಬಿ ಘಣು ದೂರ್ ನಾಜಾ಼ವ್ಣು, ಮಾರಖ್ಹಾಜೆ ಪ್ರಾರ್ಥನೆ ಕರ‍್ನು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 8:28" /><verse number="29" style="v" sid="EXO 8:29" />ಇನ ಮೋಶೆನೆ, “ಮೇ ತಾರಕಂಥು ನಿಕಳ್‌ತ ತದೇಸ್‌, ಫರೋಹ ಹುಯಿರ‍್ಹೋತೆ ತುನಾಬಿ, ತಾರಿ ಅದಿಕಾರಿಯೇವ್‌ನ ಮಾಖೋಳಾಥಿ ಖ್ಹತಾಪ್ಣಿ ನಾ ರ‍್ಹೇವ್ಣುಕರಿ ಮೇ ಯೆಹೋವನ ಗಿಂಗೈಲೇವುಸ್‌, ಕತೋಬಿ ಯೆಹೋವನ ಬಲಿಸಮರ್ಪಣ್ ಕರಾನ ತೂ ಮಾರ ಅದ್ಮಿನ ಹುಕುಮ್ ಕೊಯ್ನಿತೆ ಅನೇಥಿ ಖ್ಹಾಮ್ಣೆ ಠಗಾವ್ಣುನಾ” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 8:29" /><verse number="30" style="v" sid="EXO 8:30" />ಮೋಶೆ ಫರೋಹಕಂಥು ನಿಕ್ಳಿನ್ ಜೈ಼ನ್ ಯೆಹೋವನ ಪ್ರಾರ್ಥನೆ ಕರ‍್ಯೊ. <verse eid="EXO 8:30" /><verse number="31" style="v" sid="EXO 8:31" />ಮೋಶೆ ಪ್ರಾರ್ಥನೆ ಕರ‍್ಯೊತೆ ತಿಮ್ಮಸ್ ಯೆಹೋವನೆ ಕರ‍್ಯೊ. ಯೊ ಮಾಖೋಳೊ ಫರೋಹಕಂಥುಬಿ, ಇನು ಅದಿಕಾರಿಯೇವ್‌ಥೂಬಿ ಅಜ಼ ಇನ ಅದ್ಮಿವ್‌ಥುಬಿ ಹಟಿಗಯು. ಏಕ್‌ಬಿ ರ‍್ಹಯುಕೊಯ್ನಿ. <verse eid="EXO 8:31" /><verse number="32" style="v" sid="EXO 8:32" />ಕತೋಬಿ ಫರೋಹನೆ ಇನ ಹಮ್ಕೇಬಿ ದಿಲ್ನ ಹಟಕರಿಲಿನ್ ಅದ್ಮಿನ ಜಾ಼ವನ ಕೋ ಮ್ಹೇಲ್ಯೊನಿ.<verse eid="EXO 8:32" /></para>
  <chapter eid="EXO 8" />
  <chapter number="9" style="c" sid="EXO 9" />
  <para style="s">ಜಾನ್‌ವಾರ್‌ನು ಮರಣ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 9:1" />ಇನವಾರ್ ಯೆಹೋವಾನೆ ಮೋಶೆನ ಶಾತ್‌ಬೋಲ್ಯೊ ಕತೊ, “ತೂ ಫರೋಹಕನ ಜೈ಼ನ್ ಇನ, ‘ಇಬ್ರಿಯವಾಳನು ದೇವ್‌ಹುಯಿರ‍್ಹೊತೆ ಯೆಹೋವ ಇನ ಆರಾದನೆ ಕರಾನಿತರ ಇನ ಅದ್ಮಿನ ಹುಕುಮ್ ದೇವ್ಣುಕರಿ ಬೋಲಿರಾಖ್ಯೊಸ್. <verse eid="EXO 9:1" /><verse number="2" style="v" sid="EXO 9:2" />ತು ಇವ್ಣುನ ಹುಕುಮ್ ನಾದೀನ್ ಬಿಜೂ಼ಬಿ ಇವ್ಣುನ ಅಡ್ಡಿ ಕರ‍್ಯೊತೊ, <verse eid="EXO 9:2" /><verse number="3" style="v" sid="EXO 9:3" />ಯೆಹೋವ ಜ಼ಂಗಳ್‌ಮಛಾ಼ತೆ ತಾರು ಹಿಡಿ ಜಾನ್ವರ್‌ನಾಬಿ, ಘೋಡೊ, ಗಧೇಡೊ, ಊಟ್, ಢಾಂಡು, ಮೇಂಢು, ಬೋಕ್ಡು ಆ ಅಖ್ಖಾನ ಮೋಟೊ ರೋಗ್‌ದೀನ್‌ ತುಮೂನ ಶಿಕ್ಷೆ ದೆವುಸ್‌. <verse eid="EXO 9:3" /><verse number="4" style="v" sid="EXO 9:4" />ಯೆಹೋವ ಹುಯಿರೋತೆ ಮೇ ಇಸ್ರಾಯೇಲ್‌ನ ಜಾನ್ವರ್‌ನಾಬಿ ಈಜಿಪ್ಟ್‌ನ ಜಾನ್ವರ್‌ನಾಬಿ ಫರಕ್ ಕರಿಶ್. ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಛಾ಼ತೆ ಜಾನ್ವರ್‌ಮ ಏಕ್‌ಬಿ ಮರ್ಶೆಕೊಯ್ನಿ’ ಕರಿ ಬೋಲ್ನು” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 9:4" /><verse number="5" style="v" sid="EXO 9:5" />ಆಸ್ ಕಾಹೆತೆ ಯೆಹೋವ ಹುಯಿರೋತೆ ಮೇಸ್ ಕಾಲೆ ಆಸ್ ವಖ್ಹತ್‌ಮಾಸ್‌ ಆ ಕಾಮ್ನ ದೇಖ್ಹ್‌ಮ ಕರೀಶ್‌ಕರಿ ಬೋಲ್” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 9:5" /><verse number="6" style="v" sid="EXO 9:6" />ತಿನವ್ಹಾಣೆ ಯೆಹೋವನೆ ಯೊ ಕಾಮ್‌ಖ್ಹಾರು ಹುವಾನಿತರ ಕರ‍್ಯೊ ಈಜಿಪ್ಟ್‌ವಾಳನು ಜಾನ್ವರ್‌ಖ್ಹಾರು ಮರಿಗಯು. ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಜಾನ್ವರ್‌ಮ ಎಕ್ ಮರ‍್ಯುಕೊಯ್ನಿ. <verse eid="EXO 9:6" /><verse number="7" style="v" sid="EXO 9:7" />ಫರೋಹ ಪುಛಾ಼ವಖ್ಹತರ್‌ ಇಸ್ರಾಯೇಲ್ನ ಜಾನ್ವರ್‌ಮ ಏಕ್‌ಬಿ ಮರ‍್ಯುಕೊಯ್ನಿಕರಿ ಮಾಲುಮ್ ಕರಿಲಿದೊ. ಕತೋಬಿ ಫರೋಹನೆ ಹಟಕರಿನ್, ಯೊ ಅದ್ಮಿವೊನ ಜಾ಼ವಾನ ಕೊಮ್ಹೇಲ್ಯೊನಿ.<verse eid="EXO 9:7" /></para>
  <para style="s">ಉಕ್ಳಾನು</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 9:8" />ಯೆಹೋವಾನೆ ಮೋಶೆ ಅಜು಼ ಆರೋನ್ನ, “ತುಮೆ ಛು಼ಲ್ಲಾನಿ ರಾಕ್‌ನ ಪಖ್ಹ್‌ಲಿಭರಿ ಪಾಡಿಲೆವೊ, ಮೋಶೆ ಇನ ಫರೋಹನ ಡೋಳಾನ ಖ್ಹಾಮ್ಣೆ ವಹಿರಾಮ ಉಡಾವದೆ. <verse eid="EXO 9:8" /><verse number="9" style="v" sid="EXO 9:9" />ತದೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಅಖ್ಖೂಸ್ ಧೂಳ್‌ಹುಯಿನ್‌ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ ಅಖ್ಖೂಸ್ ಫೈಲೈನ್ ಅದ್ಮಿಪರ್‌ಬಿ ಜಾನ್ವರ್‌ ಪರ್‌ಬಿ ಫೋಡಾನೊ ಫರ್‌ಪೋಲೊ ಉಠಾನಿತರ ಕರ್ಷೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 9:9" /><verse number="10" style="v" sid="EXO 9:10" />ಇಮ್ಮಸ್ ಮೋಶೆ ಅಜು಼ ಆರೋನ ಇವ್ಣೆ ಛು಼ಲ್ಲಾನಿ ರಾಕ್‌ನ ಪಾಡಿಲಿನ್ ಫರೋಹನ ಖ್ಹಾಮ್ಣೆ ಭೀರ‍್ಯ. ಮೋಶೆ ಯೊ ರಾಕ್‌ನ ವಹಿರಾಮ ಉಡಾಯೊ. ತದೆ ಯೊ ಅದ್ಮಿಪರ್‌ಬಿ ಜಾನ್ವರ್‌ಪರ್‌ಬಿ ಫಲೈನ್ ಫರ್‌ಪೋಲೊ ಹುಯಿನ್‌ ಫೋಡಹುಯು. <verse eid="EXO 9:10" /><verse number="11" style="v" sid="EXO 9:11" />ಆ ಕಾಹೆತೆ ಜಾ಼ದುಕರಾವಳು ಫೋಡಾವ್ನ ಖ್ಹಾಜೇಥಿ ಮೋಶೆನ ಖ್ಹಾಮ್ಣೆ ಭಿರಾವನ ಕೊಹುಯುನಿತೆ ಚ಼ಲಿಗಯು. ಶನಕತೊ ಫೋಡಖ್ಹಾರು ಮಂತರ್‌ ಕರಾವಳಪರ್‌ಬಿ. ಈಜಿಪ್ಟ್‌ವಾಳಪರ್‌ಬಿ ಉಠಿರ‍್ಹಿಥು. <verse eid="EXO 9:11" /><verse number="12" style="v" sid="EXO 9:12" />ಕತೋಬಿ ಯೆಹೋವ ಮೋಶೆನ ಬೋಲಾನಿತರಾಸ್ ಹುಯು. ಯೆಹೋವ ಫರೋಹನ ಹಟ ಕರಾಯೋತೆ ಇನಖ್ಹಾಜೆ ಯೊ ಇವ್ಣಿ ವಾತೆನ ಖ್ಹಂಜೊ ಕೊಯ್ನಿತೆ ಗಯೊ.<verse eid="EXO 9:12" /></para>
  <para style="s">ಗಾರೊ</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 9:13" />ಇನಕೇಡೆಥು ಯೆಹೋವ ಮೋಶೆನ, “ತು ವ್ಹಾಣೆ ಉಠೀನ್ ಫರೋಹನ ಖ್ಹಾಮ್ಣೆ ಜೈ಼ನ್ ಭೀರಿನ್ ಇನ, ‘ಇಬ್ರಿಯಾನೊ ದೇವ್‌ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವ ಹುಕುಮ್ ದ್ಯವಾನು ಶಾತ್‌ಕತೊ ಮನ ಆರಾದನೆ ಕರಾನಿತರ ಮಾರ ಅದ್ಮಿವ್‌ನ ಹುಕುಮ್‌ ದೇವ್ಣು. <verse eid="EXO 9:13" /><verse number="14" style="v" sid="EXO 9:14" />ಆ ಹಲ್ಲ ಮಾರಿ ಚ಼ಪ್ಪಣ್‌ಮ ಛಾ಼ತೆ ಆ ಖ್ಹತಾಪ್ಣಿನ ತಾರ ಅದ್ಮಿವ್‌ನಾಬಿ ಅದಿಕಾರಿವ್‌ನಾಬಿ ಹುವಾನಿತರಾಬಿ,ಅಜು಼ ತುನಾಬಿ ಹುವಾನಿತರಬಿ ಕರೀಶ್. ಅನೇಥಿ ಖ್ಹಾರಿಸ್ ಜಗತ್ಮ ಮನ ಸಮಾನ್ ಕೋಣ್‌ಬಿ ಕೊಯ್ನಿಕರಿ ಮಾರಿ ಬಾರೇಮ ತೂ ಮಾಲುಮ್ ಕರಿಲಿಷ್. <verse eid="EXO 9:14" /><verse number="15" style="v" sid="EXO 9:15" />ಮೇ ತುನಾಬಿ, ತಾರ ಅದ್ಮಿವ್‌ನಾಬಿ ರೋಗ್‌ಥಿ ಮಾರಾನ ಹಾತ್‌ ಪಾಡ್ಯೊತೊ ತುಮೆ ಅಖ್ಖು ನಾಶ್‌ಹುಯಿಜ಼ಾಶು. <verse eid="EXO 9:15" /><verse number="16" style="v" sid="EXO 9:16" />ಕತೋಬಿ ಮೇ ತಾರಾಮ ಮಾರಿ ಶಕತ್ನ ವತಾಳಿನ್ ಮಾರ ನಾಮ್ನ ಜಗತ್ಮಾಸ್ ಪ್ರಚಾರ್ ಕರ‍್ನುಕರಿ ಉದ್ದೇಶ್‌ಥೀಸ್ ತುನ ಜಿವ್ತೊ ರಾಖಿರಾಖ್ಯೋಸ್‌. <verse eid="EXO 9:16" /><verse number="17" style="v" sid="EXO 9:17" />ಕತೋಬಿ ತೂ ಅಜೂ಼ಬಿ ಘಬ್ರಿಹುಯಿನ್‌ ಮಾರ ಅದ್ಮಿನ ಜ಼ಾವನ ಕೊ ಮ್ಹೇಲಾನಿ. <verse eid="EXO 9:17" /><verse number="18" style="v" sid="EXO 9:18" />ಇಮ್‌ಕತೊ, ಕಾಲ್ ಅವ್ಡಿಸ್ ವಖ್ಹತ್‌ಮ ಜಾ಼ಖ್ಹತ್ ಗಾರ‍್ನೊ ಪಾಣಿ ಪಡಾನಿತರ ಕರಿಶ್. ಈಜಿಪ್ಟ್ ದನ್ ಶುರು ಹುಯುತಪ್‌ಥು ಹಮ್ಕೆಲಗುಬಿ ಎಥ್ರಾನೊ ಗಾರ‍್ನೊಪಾಣಿ ಪಡಿರ‍್ಹಿಷೆ ಕೊಯ್ನಿ. <verse eid="EXO 9:18" /><verse number="19" style="v" sid="EXO 9:19" />ಇನಖ್ಹಾಜೆ ತೂ ಆಳ್‌ಖ್ಹಾರನ ಮೋಕ್ಲಿನ್ ತಾರ ಜಾನ್ವರ್‌ನಾಬಿ, ತುನ ಖೇತರ್‌ಮ ಛಾ಼ತೆ ಖ್ಹಾರೂಸ್ ಒಗ್ಗಿಸ್‌ಮ ಖ್ಹವಾರಿಲೆ ಘರ್‌ಮ ಪೇಶ್ಯುಕೊಂತೆ ಬಲ್ಡಾನಪರ್ ರ‍್ಹವಾಳು ಅಖ್ಖೂಸ್ ಅದ್ಮಿಖ್ಹಾರುಬಿ, ಜಾನ್ವರ್‌ಖ್ಹಾರು ಯೊ ಬಂಡಾನ ಪಾಣಿನ ಮಾರ್‌ಥಿ ಮರಿಜಾ಼ಷೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 9:19" /><verse number="20" style="v" sid="EXO 9:20" />ತದೆ ಫರೋಹನ್ನ ಸೇವಕರ್‌ಮ ಕೋಣ್ ಕೋಣ್ ಯೆಹೋವನಿ ವಾತೆನ ಡರ‍್ಯೂಕಿ ಇವ್ಣೆ, ಇವ್ಣ ಆಳ್‌ನ ಜಾನ್ವರ್‌ನ ಒಗ್ಗೀಮ ಘರೆ ಬುಲೈಲಿದು. <verse eid="EXO 9:20" /><verse number="21" style="v" sid="EXO 9:21" />ಕೋಣ್‌ ಯೆಹೋವನಿ ವಾತೆನ ಮಾನಕೊಯ್ನಿಕಿ, ಇವ್ಣೆ ಇವ್ಣ ಆಳ್‌ಖ್ಹಾರನ, ಜಾನ್ವರ್‌ಖ್ಹಾರನ ಖೇತರ್‌ಮಾಸ್ ಮ್ಹೇಲಿದಿದು. <verse eid="EXO 9:21" /><verse number="22" style="v" sid="EXO 9:22" />ಯೆಹೋವ ಮೋಶೆನ, “ಆಬ್‌ಭಣಿ ತಾರು ಹಾತ್ನ ಪಾಡ್ ತದೆ ಈಜಿಪ್ಟ್ ಅಖ್ಖೂಸ್, ಅದ್ಮಿವ್‌ಪರ್‌ಬಿ ಜಾನ್ವರ್‌ಪರ್‌ಬಿ ಖೇತರ್‌ಮ ಛಾ಼ತೆ ಅಖ್ಖೀಸ್ ಶೋಶಿನಪರ್‌ಬಿ ಗಾರಾನೊ ಬಂಡಾನೊ ಪಾಣಿ ರಂಚಾ಼ವ್‌ಶೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 9:22" /><verse number="23" style="v" sid="EXO 9:23" />ಮೋಶೆ ಇನ ಲಠ್ಠಾನ ಆಬ್‌ಭಣಿ ಪಾಡಖ್ಹತರ್ ಘಲಾರ್‌ಬಿ, ಗಾರ‍್ನೊ ಪಾಣಿನು ವರ್ಖ್ಹಾತ್ನ ಮೋಕ್‌ಲ್ಯೊ. ವಿಜ್ಳಿ ಜ಼ಮಿನ್‌ಪರ್ ಮಾರಿನ್ ಯೆಹೋವ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಪರ್ ಗಾರಾನೊ ಬಂಡಾನೊ ಪಾಣಿನ ವರ್ಖ್ಹಾಯೊ. <verse eid="EXO 9:23" /><verse number="24" style="v" sid="EXO 9:24" />ಗಾರಾನೊ ಬಂಡಾನೊ ವರ್ಖ್ಹಾತ್ ಘಣು ಜೋ಼ರೆಖ್ಹು ಥು. ಇನಿ ಜೋ಼ಡ್ಮಾಸ್ ವಿಜ್ಳಿ ಖಡ್ಕುಕರ್ತಿಥಿ. ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಹಮ್ಕೆಲಗೂಬಿ ಇಮ್ನು ಮೋಟೊ ಗಾರಾನೊ ಪಾಣಿ ಕೊಹುಯಿರ‍್ಹೊಥುನಿ. <verse eid="EXO 9:24" /><verse number="25" style="v" sid="EXO 9:25" />ಯೊ ಬಂಡಾನೊ ಪಾಣಿ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನು ಅಖ್ಖೀಸ್ ಬಾಜು಼ಮ ಅದ್ಮಿವ್‌ನ ಜಾನ್ವರ್‌ನ ಲುಕ್ಷಾನ್ ಕರ‍್ಯು ಯೊ ಬಂಡಾನ ಪಾಣಿಥಿ ಖೇತರ್‌ಮ ಥೂತೆ ಅಖ್ಖು ಶೋಶಿ ಹಾಳ್‌ಹುಯಿಗು, ಝಾ಼ಡಿಮ ಥೂತೆ ಝಾ಼ಡು ಅಖ್ಖು ಟುಟಿ ಪಡಿಗಯು. <verse eid="EXO 9:25" /><verse number="26" style="v" sid="EXO 9:26" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಥೂತೆ ಗೋಷೆನ್ ತಬರ್‌ಖಾಮ ಗಾರಾನೊ ಬಂಡಾನೊ ಪಾಣಿ ಪಡ್ಯೊಕೊಯಿನಿ. <verse eid="EXO 9:26" /><verse number="27" style="v" sid="EXO 9:27" />ತದೆ ಫರೋಹನೆ ಮೋಶೆನ ಆರೋನ್ನ ಬುಲೈನ್ ಇವ್ಣುನ, “ಮೇ ಅಪರಾದಿ ಕರಿ ಹಮ್ಕೆ ಮಾನಿಲೆವುಸ್‌; ಯೆಹೋವ ನೀತಿವಾಳೊ. ಮೇ ಮಾರು ಅದ್ಮಿಖ್ಹಾರು ದೋಷ್‌ವಾಳು. <verse eid="EXO 9:27" /><verse number="28" style="v" sid="EXO 9:28" />ಆ ಖತರ್‌ನಾಕ್ ಘಲಾರನೊ ಬಂಡಾನೊ ವರ್ಖ್ಹಾತ್‌ಬಿ ಘಣು ಜಾ಼ಖ್ಹತ್ ಹುಯು. ಆ ಖ್ಹಾರು ಭೀರಾಖನಖ್ಹಾಜೆ ಯೆಹೋವನ ಪ್ರಾರ್ಥನೆ ಕರೊ. ಆ ದೇಖ್ಹ್‌ನ ಮ್ಹೇಲಿನ್ ಜಾ಼ವಾನ ತುಮುನ ಹುಕುಮ್ ದೆವುಸ್‌ ತುಮುನ ಅಡ್ಡಿ ಕರಿಶ್ ಕೊಯ್ನಿ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 9:28" /><verse number="29" style="v" sid="EXO 9:29" />ಇನ ಮೋಶೆ, “ಮೆ ಖ್ಹಯೇರ್ನ ಭಾರ್‌ಜಾ಼ತ ತದೇಸ್‌ ಹಾತ್ ಪಾಡಿನ್ ಯೆಹೋವನ ಪ್ರಾರ್ಥನೆ ಕರುಸ್; ತದೆ ಘಲಾರನೊ ಅಜು಼ ಗಾರ‍್ನೊ ವರ್ಖ್ಹಾತ್ ಭೀರಿಜಾಷೆ. ಅನೇಥಿ ಹರೇಕ್ ಧರ್ತೀನು ಲೋಕ್ ಯೆಹೋವನಿ ಕಬ್‌ಜಾ಼ಮ ಮಹಿ ಛಾ಼ಕರಿ ತೂ ಮಾಲುಮ್ ಕರಿಲಿಷ್. <verse eid="EXO 9:29" /><verse number="30" style="v" sid="EXO 9:30" />ಕತೋಬಿ ತೂ ರ‍್ಹವೊ ತಾರ ಅದಿಕಾರಿನರ‍್ಹವೊ ದೇವ್ ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವನ ತದೇಬಿ ಡರ್‌ಶು ಕೊಯ್ನಿಕರಿ ಮಾಲುಮ್ ಛಾ಼ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 9:30" /><verse number="31" style="v" sid="EXO 9:31" />ಬಾಜ಼್‌ರೊ ಅಜು಼ ಅಗಸೆದಾಣನಿ ಪಿಕಾವ್ಣಿ ಅಖ್ಖು ನಾಶ್‌ಹುಯಿಗು. ಶನಕತೊ ಬರಿಕ್‍ಗ್ಹವ್ ನಿಕ್‌ಳಿರ‍್ಹಿಥು ಅಗಸೆದಾಣನಿ ಮೊಗ್ ಮಿಛಾ಼ಣ್ಯುಥು. <verse eid="EXO 9:31" /><verse number="32" style="v" sid="EXO 9:32" />ಘವ್‌ಬಿ ಚ಼ಣ ಫಾಚ಼್‌ಲ್ಯು ಬೆಳೆಹುಯಿರ‍್ಹುಥೂತೆ ಇನಖ್ಹಾಜೆ ಇನ ಲುಕ್ಷಾನ್ ಕೋ ಹುಯುನಿ <verse eid="EXO 9:32" /><verse number="33" style="v" sid="EXO 9:33" />ಮೋಶೆ ಫರೋಹಕಂಥೊ ಖ್ಹಯೇರ್ನ ಭಾರ್‌ಆಯಿನ್ ಹಾತ್ ಪಾಡಿನ್ ಯೆಹೋವನ ಪ್ರಾರ್ಥನೆ ಕರ‍್ಯೊ. ಘಲಾರನೊ ಅಜು಼ ಗಾರಾನೊ ವರ್ಖ್ಹಾತ್‌ ಭೀರಿಗಯು. <verse eid="EXO 9:33" /><verse number="34" style="v" sid="EXO 9:34" />ಕತೋಬಿ ಯೊ ಮೋಟೊ ಗಾರ‍್ನೊಪಾಣಿ ಘಲಾರನು ಭೀರಿಗಯೂತೆ ಇನ ಫರೋಹ ದೇಖಖ್ಹತರ್ ಯೋಬಿ ಇನು ಅದಿಕಾರಿಖ್ಹಾರು ಬಿಜೂ಼ಬಿ ಪಾಪಿ ಹುಯಿನ್ ಇವ್ಣೆ ಹಟ ಕರಿಲಿದು. <verse eid="EXO 9:34" /><verse number="35" style="v" sid="EXO 9:35" />ಯೆಹೋವ ಮೋಶೆಥಿ ಬೋಲಾವನಿತರಾಸ್ ಹುಯು; ಫರೋಹನೊ ದಿಲ್‌ ಮೊಂಡ್‌ ಹುಯಿಗು. ಯೊ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಜಾ಼ವಕೋದಿದೋನಿ.<verse eid="EXO 9:35" /></para>
  <chapter eid="EXO 9" />
  <chapter number="10" style="c" sid="EXO 10" />
  <para style="s">ಚಿಡ್ಡೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 10:1" />ಅನಕೇಡೆಥು ಯೆಹೋವನೆ ಮೋಶೆನ ಅಮ್‌ಬೋಲ್ಯೊ ಫರೋಹಕನ ಪಾಛೊ಼ ಜಾ಼ .ಮೇ ಫರೋಹನ ಅಜು಼ ಇನ ಅದಿಕಾರಿವ್ನ ಖ್ಹಾಮ್ಣೆ ಆ ಅದ್ಭುತ್‌ಕಾಮ್ನ ಚ಼ಲಾವನಖ್ಹಾಜೆ ಕಾರಣ್ ಉಷೆ. <verse eid="EXO 10:1" /><verse number="2" style="v" sid="EXO 10:2" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಇನ ಲಡ್ಕಾವ್‌ನಾಬಿ ನಾತಿಪೋತಿನಾಬಿ ಈಜಿಪ್ಟ್‌ವಾಳನಿ ಬೀಚ್ಮ ಚ಼ಲೈರಾಖ್ಯೊತೆ ಆ ಅದ್ಭುತ್‌ಕಾಮ್ನ ಬೋಲಿವತಾಳನಖ್ಹಾಜೆ ಯೆಹೋವ ಹುಯಿರೋತೆ ಮೇ ಈಜಿಪ್ಟ್‌ವಾಳನ ಮನ್ಮ ಹುವಾಸ್ತೆ ತಿಮ್‌ ನಿಶತ್ ದಿದೊ. ಅನೇಥಿ ಮೇಸ್ ಯೆಹೋವಕರಿ ಮಾಲುಮ್ ಕರಿಲಿಶು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 10:2" /><verse number="3" style="v" sid="EXO 10:3" />ಮೋಶೆ ಅಜು಼ ಆರೋನ ಫರೋಹಕನ ಜೈ಼ನ್ ಇನ, “ಇಬ್ರಿಯವಾಳನ ದೇವ್‌ಹುಯಿರ‍್ಹೊತೆ ಯೆಹೋವ ಅಮ್‌ ಬೋಲಸ್, ‘ತುಮಾರ ಖ್ಹಾಮ್ಣೆ ಮುಡ್‌ಕ್ಯು ಝು಼ಕಾವನುಕೊಂತೆ ರ‍್ಹವಾನು ಕಬ್ಲಗು? ಮನ ಆರಾದನೆ ಕರಾನಿತರ ಮಾರ ಅದ್ಮಿನ ಜಾ಼ವಾನ ಮ್ಹೇಲ್‌. <verse eid="EXO 10:3" /><verse number="4" style="v" sid="EXO 10:4" />ಹುಕುಮ್ ನಾ ದಿದೋತೊ ಕಾಲೆ ತಾರ ರಾಜ್ಯಮ ಚಿಡ್ಡೊ ಆವನಿತರ ಕರಿಶ್. <verse eid="EXO 10:4" /><verse number="5" style="v" sid="EXO 10:5" />ಯೊ ಜ಼ಮೀನ್ ಅಖ್ಖೂಸ್ ಫಲೈಜಾಶೆ ಜ಼ಮಿನಸ್ ದೆಖಾವ್‌ಶೆ ಕೊಂತೆ ಹುಯಿಜಾಷೆ. ಗಾರಾನೊ ಪಾಣಿಥಿ ನಾಶ್‌ಕೊಹುಯುಂತೆ ಉಭ್‌ರ‍್ಹಿನ್ ಛಾ಼ತೆಯಿನ ಚಿಡ್ಡೊಖ್ಹಾರು ಖೈನಾಕ್ಷೆ ಖೇತರ್‌ಮ ಛಾ಼ತೆ ತುಮಾರು ಹಿಡಿ ಝಾ಼ಡವ್ನು ಪಾಂದ್ಡು ಚಿಗುರ್ ಖ್ಹಾರುಸ್ ಖೈನಾಕ್ಷೆ. <verse eid="EXO 10:5" /><verse number="6" style="v" sid="EXO 10:6" />ಯೊ ತಾರ ಮಹೇಲ್‌ಮಾಬಿ, ತಾರ ಅದಿಕಾರಿಯೇವ್‌ಮಾಬಿ ಈಜಿಪ್ಟ್‌ವಾಳನ ಘರುಮಾಬಿ ಭರೈರಿಷೆ. ಅಪ್ಣ ಬಾಪ್‌ದಾದವ್ನ ಹಗಾಮ್‌ಥು ಹಮ್ಕೆಲಗೂಬಿ ಎಥ್ರಾನು ಚಿಡ್ಡಾವ್ನು ಝೂಂಡ್‌ನ ಕೆದೇಬಿ ಇವ್ಣೆ ದೇಖಿರಾಕ್‌ಷೆ ಕೊಯ್ನಿ” ಕರಿ ಬೊಲ್ಯೊ ಅನ ಬೋಲಿನ್ ಮೋಶೆ ಫರಿನ್ ಫರೋಹಕಂಥು ನಿಕ್ಳಿಗಯೊ. <verse eid="EXO 10:6" /><verse number="7" style="v" sid="EXO 10:7" />ತದೆ ಫರೋಹನು ಅದಿಕಾರಿಖ್ಹಾರು, “ಆ ಅದ್ಮಿ ಬಿಜು಼ ಕೆತ್ರ ಹಗಾಮ್ ಅಪ್ಣುನ ಫಾಖ್ಹೊ ಹುಯಿರ‍್ಹೇಣು! ಯೊ ಅದ್ಮಿ ಜೈ಼ನ್ ಇವ್ಣು ದೇವ್‌ಹುಯಿರ‍್ಹುತೆ ಯೆಹೋವನ ಆರಾದನೆ ಕರಾನಿತರ ಹುಕುಮ್ ದೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ ನಾಶ್‌ಹುಯಿಗುಕರಿ ಅಜ಼ೂಬಿ ತಾರ ಮನ್ಮ ಕೊ ಆಯುನಿಕಿಷು?” ಕರಿ ಬೋಲ್ಯು. <verse eid="EXO 10:7" /><verse number="8" style="v" sid="EXO 10:8" />ಇನ ಖ್ಹಮ್‍ಜ್ಯೊತೆ ಫರೋಹಾನೆ, ಮೋಶೆ ಅಜು಼ ಆರೋನನ ಪಾಛು಼ ಬುಲೈನ್ ಇವ್ಣುನ, “ತುಮೆ ಜೈ಼ನ್ ತುಮಾರೊ ದೇವ್‌ಹುಯಿರ‍್ಹೊತೆ ಯೆಹೋವನ ಆರಾದನೆ ಕರೆಜಾ಼ಯ್, ಕತೋಬಿ ಕೋಣ್ ಕೋಣ್ ಜಾ಼ವ್ಣುಕರಿ ಛಾ಼”? ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 10:8" /><verse number="9" style="v" sid="EXO 10:9" />ಮೋಶೆನೆ ಇನ, “ಹಮೆ ಯೆಹೋವನಿ ಜ಼ತ್ರಾನ ಕರ‍್ನುಕರಿ ಛಾ. ಯೊ ಕಾರಣ್‍ಥಿ ಅಡ್ಡಾಣಿಥು ಶುರುಹುಯಿನ್ ಬುಢಾಲಗೂಬಿ ಅಖ್ಖುಸ್ ಜ಼ಣು ಜ಼ಯ್ಯೆಸ್; ಛಿಯ್ಯಾ ಛೋ಼ರಿವ್ನಾಬಿ, ಢಾಂಡು, ಮೇಂಢಾವ್ನ ಮಂಧಾವ್ನ ಲೀನ್ ಜ಼ಯ್ಯೆಸ್” ಕರಿ ಜ಼ವಾಬ್‌ದಿದೊ. <verse eid="EXO 10:9" /><verse number="10" style="v" sid="EXO 10:10" />ಇನ ಫರೋಹನೆ, “ಮೇ ತುಮುನ ಅಜು಼ ತುಮಾರ ಲಡ್ಕಾವ್ನ ಜಾ಼ವಾನ ಕೊಮ್ಹೇಲಿಶ್‌ನಿ, ಮೋಕ್ಲಿದಿದೋತೊ ಯೆಹೋವ ತುಮಾರ ಕೇಡೆ ರ‍್ಹಿಶೆ. ದೇಖೊ, ತುಮೆ ಖರಾಬ್ ಸೋಚವಾಳ. <verse eid="EXO 10:10" /><verse number="11" style="v" sid="EXO 10:11" />ತುಮಾರಮ ಪರ್ಖ್ಹಾ ಖಲಿಜೈ಼ನ್ ಯೆಹೋವನ ಆರಾದನೆ ಕರಿನ್ ಆಯೆಜಾ಼ಯ್. ತುಮೆ ಬೋಲಿಲಿದಾತೆ ಎತ್ರೇಸ್ ಕಾಹೆಕಿಶು?” ಕರಿ ಬೋಲಿನ್ ಇವ್ಣುನ ಫರೋಹನೆ ಇನಕಂಥು ಮೋಕ್ಲಿದಿದೊ. <verse eid="EXO 10:11" /><verse number="12" style="v" sid="EXO 10:12" />ತದೆ ಯೆಹೋವನೆ ಮೋಶೆನ, “ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಉಪ್ಪರ್ ತಾರ ಹಾತ್ನ ಫಖ್ಹಾರಿನ್ ಚಿಡ್ಡಾವ್ನ ಬುಲಾವ್ ಗಾರಾನ ಪಾಣಿಥಿ ನಾಶ್‌ಹುಯಿನ್ ಬಚಿರ‍್ಹೂತೆ ಹಗೇವ್ನ ಚಿಡ್ಡೊ ಅಖ್ಖು ಖೈಲಾವದೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 10:12" /><verse number="13" style="v" sid="EXO 10:13" />ಮೋಶೆ ಇನ ಲಠ್ಠಾನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಪರ್ ಪಾಡಖ್ಹತರ್ ಯೆಹೋವ ದನ್‌ರಾತ್ ದನ್ ನಿಕ್‌ಳ ಭಣೀಥು ವಹಿರೊ ವಾಗನಿತರ ಕರ‍್ಯೊ ಯೊ ವಹಿರಾನಖ್ಹಾಜೆ ವ್ಹಾಣೆವೇಳಿಸ್ ಚಿಡ್ಡೊಅಖ್ಖು ಐರ‍್ಹುಥು. <verse eid="EXO 10:13" /><verse number="14" style="v" sid="EXO 10:14" />ಚಿಡ್ಡೊಖ್ಹಾರು ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನಿ ಅಖ್ಖಿ ಬಾಜೂ಼ಬಿ ಘಣೇಥಿಘಣು ಉಲ್‌ಟೈಗಯು. ಎಥ್ರಾನು ಚಿಡ್ಡಾವ್ನು ಝೂ಼ಂಡ್ ಪೀಠೆ ಕೆದೇಬಿ ಕೊಆಯುಥುನಿ ಖ್ಹಾಮ್ಣೇಬಿ ಆವಾನ ಕೊಉಷೇನಿ. <verse eid="EXO 10:14" /><verse number="15" style="v" sid="EXO 10:15" />ಯೊ ಧರ್ತಿಪರ್ ಮೂಚೈ಼ಗೂತೆ ಖ್ಹಾಜೆ ಜ಼ಮೀನ್ ಜಿನು ಕೋದೆಖಾಯುನಿ. ಗಾರಾನ ಬಂಡಾನ ಪಾಣಿಥಿ ನಾಶ್‌ಕೊಹುಯುಂತೆ ಥೂತೆ ಪಂಡಾವ್ನಬಿ ಯೊ ಅಖ್ಖು ಖೈಲಿದು. ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಝಾ಼ಡಾಮ ರ‍್ಹವೊ ಖೆತರ್‌ ಶೋಶಿಮ ರ‍್ಹವೊ ಹರ‍್ಯುಕರಿ ಬೋಲಾನು ಬಚ್ಯುಸ್ ಕೊಯ್ನಿ. <verse eid="EXO 10:15" /><verse number="16" style="v" sid="EXO 10:16" />ತದೆ ಫರೋಹನೆ, ಮೋಶೆ ಆರೋನ್ನ ಒಗ್ಗಿಸ್‌ಮ ಬುಲೈ ಮಂಗೈನ್, ಮೇ ತುಮಾರ ದೇವ್ ಯೆಹೋವನಬಿ ತುಮಾರಿ ವಿರೋದ್‌ಬಿ ಪಾಪ್ ಕರಿರಾಖ್ಯೊಸ್. <verse eid="EXO 10:16" /><verse number="17" style="v" sid="EXO 10:17" />ಕತೋಬಿ ಆ ಎಕ್ಕಸ್ ಹಲ್ಲ ಮಾರ ಪಾಪ್ನ ಕ್ಷಮಾಪಣ್ ಕರ‍್ನು. ತುಮಾರು ದೇವ್ ಯೆಹೋವ ಆ ಮರಣ್ಣಿ ಖತ್ರ ಮಾರಕಂಥು ಕಾಡದೆ ಇನಖ್ಹಾಜೆ ಪ್ರಾರ್ಥನೆ ಕರ‍್ನು” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 10:17" /><verse number="18" style="v" sid="EXO 10:18" />ಮೋಶೆ ಫರೋಹಕಂಥು ನಿಕ್ಳಿನ್ ಯೆಹೋವನ ಪ್ರಾರ್ಥನೆ ಕರ‍್ಯೊ. <verse eid="EXO 10:18" /><verse number="19" style="v" sid="EXO 10:19" />ಯೆಹೋವನೆ ಪೂರಬ್‌ನ ವಹಿರಾನ ಘಣು ಶಕತ್ನು ಪಶ್ಚಿಮ್‌ನು ವಹಿರೊಕರಿ ಬಣೈನ್ ವಾಗನಿತರ ಕರ‍್ಯೊ. ವಹಿರೊ ಯೊ ಚಿಡ್ಡಾವ್ನ ಪಾಡಿಲಿಜೈ಼ನ್ ಲಾಲ್ ದರ‍್ಯಾವ್‌ಮ ನಾಖಿದಿದು. ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನ ಇಟಾರಮ್ಮ ಎಕ್ ಚಿಡ್ಡೋಬಿ ಕೊರ‍್ಹಯುನಿ. <verse eid="EXO 10:19" /><verse number="20" style="v" sid="EXO 10:20" />ಕತೋಬಿ ಯೆಹೋವನೆ ಫರೋಹನ ದಿಲ್ನ ಹಟ ಕರಾಯೋತೆ ಇನಖ್ಹಾಜೆ ಇನೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಮೋಕ್ಲಿದ್ಯವಾನ ಮಾನ್ಯೊಕೊಯ್ನಿ.<verse eid="EXO 10:20" /></para>
  <para style="s">ಅಂಧಾರ್‌ಗಡಪ್‌</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 10:21" />ಇನವಾರ್ ಯೆಹೋವನೆ ಮೋಶೆನ, “ಆಬ್‌ಭಣಿ ಹಾತ್‌ಪಾಡ್‌ ತದೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ ಅಖ್ಖು ಅಂಧಾರ್‌ಗಡಪ್‌ ಹುಯು. ಯೊ ಅಂಧಾರೇಥಿ ಅದ್ಮಿ ಥಪಾವ್ತು ಚಾ಼ಲ್‌ಷೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 10:21" /><verse number="22" style="v" sid="EXO 10:22" />ಮೋಶೆ ಆಬ್‌ಭಣಿ ಹಾತ್ ಪಾಡಖ್ಹತರ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನು ಅಖ್ಖಿ ಬಾಜು಼ ತೀನ್ ದನ್ ಅಂಧಾರ್‌ಗಡಪ್ ಹುಯು. <verse eid="EXO 10:22" /><verse number="23" style="v" sid="EXO 10:23" />ತೀನ್ ದನ್‌ಲಗು ಇವ್ಣೆ ಏಕ್‌ಥಿಏಕ್ ದೇಖ್ಯು ಕೊಯ್ನಿ ಕೋಣ್ಬಿ ಇವ್ಣಿ ರ‍್ಹವಾನಿ ಝ಼ಗೋಥಿ ಉಠ್ಯುಕೊಯ್ನಿ. ಕತೋಬಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಜಿವ್ಣು ಕರುಕರ್ತುಥೂತೆ ಝ಼ಗೋಮ ಉಜಾ಼ಳು ಥು. <verse eid="EXO 10:23" /><verse number="24" style="v" sid="EXO 10:24" />ತದೆ ಫರೋಹಾನೆ ಮೋಶೆನ ಬುಲೈನ್ ಇನ, “ತುಮೆ ಜೈ಼ನ್ ಯೆಹೋವನ ಆರಾದನೆ ಕರಾನ ಜ಼ಯೇಜಾ಼ಯ್‌. ತೂ ತುಮಾರ ಘರ್‌ವಾಳು ಜ಼ಯೇಜಾ಼ಯ್. ತುಮಾರು ಮೇಂಢು ಢಾಂಡುಕತೊ ಹಜ್ಜಾ಼ಸ್ ಮ್ಹೇಲಿನ್ ಜಾ಼ವ್ಣು” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 10:24" /><verse number="25" style="v" sid="EXO 10:25" />ಇನ ಮೋಶೆನೆ, “ಹಮಾರೊ ದೇವ್ ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವನ ಹಮೆ ಬಲಿನ ಕರಾನ ಹೋಣುತೆ ಜಾನ್ವರ್‌ನ ದೇವ್ಣು. <verse eid="EXO 10:25" /><verse number="26" style="v" sid="EXO 10:26" />ಹಮಾರು ಅಖ್ಖು ಜಾನ್ವರ್‌ಜಿನು ಹಮಾರ ಜೋ಼ಡೆ ಲೀನ್ ಜ಼ಯೇಸ್. ಎಕ್ ಕೆಲ್ಡಾನಬಿ ಹಮೆ ಮ್ಹೇಲಿನ್ ಜಾ಼ಶು ಕೊಯ್ನಿ. ಯೊ ಜಾನ್ವರ್‌ಥಿಸ್ ಹಮಾರೊ ದೇವ್ ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವನ ಆರಾದನೆನ ಕರ್ಶು. ಖಿವು ಜಾನ್ವರ್‌ನ ಅರ್ಪಣ್ ಕರ್ನುಕರಿ ಹಮೆ ಹಿಜ್ಜಾ಼ ಜೈ಼ನ್ ಮಳಾನ ಪಹಿಲೆ ಹಮುನ ಮಾಲುಮ್ ಕೊಯ್ನಿ ”ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 10:26" /><verse number="27" style="v" sid="EXO 10:27" />ಕತೋಬಿ ಯೆಹೋವ ಫರೋಹನ ದಿಲ್ನ ಹಟ ಕರಿಲಿದೋತೆಖ್ಹಾಜೆ ಇನೆ ಇವ್ಣುನ ಮೋಕ್‌ಲ್ಯೊ ಕೊಯ್ನಿ. <verse eid="EXO 10:27" /><verse number="28" style="v" sid="EXO 10:28" />ತದೆ ಫರೋಹಾನೆ ಮೋಶೆನ, “ಮನ ಮ್ಹೇಲಿನ್ ಜಾ಼ ಅನಪಾರ್ ಮಾರ ಮ್ಹೋಡಾನ ನಾದೇಕ್ಣುತೆ ಹೊಶಾರ್‌ಥಿ ರ‍್ಹೆ ಶನಕತೊ ತೂ ಮಾರ ಮ್ಹೋಡಾನ ದೇಖ್ಯೊತೆ ದನ್ಮ ತೂ ಮರಿಜೈಷ್” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 10:28" /><verse number="29" style="v" sid="EXO 10:29" />ಇನ ಮೋಶೆನೆ, “ತು ಬರೋಬರ್ ಬೊಲ್ಯೊ ಅನಪಾರ್ ಮೇ ತುನ ಕೊದೇಖಿಷ್‌ನಿ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="EXO 10:29" /></para>
  <chapter eid="EXO 10" />
  <chapter number="11" style="c" sid="EXO 11" />
  <para style="s">ಮೋಶೆನೆ ಪೈಲ್ಹೋಟ ಲಡ್ಕಾವ್ನಿ ಮರಣ್ಣಿ ಬಾರೇಮ ಬೋಲ್ಯೊತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 11:1" />ಯೆಹೋವ ಮೋಶೆನ, “ಫರೋಹನಾಬಿ ಅಜು಼ ಈಜಿಪ್ಟ್‌ವಾಳನಬಿ ಬಿಜು಼ ಎಕ್ಕಸ್‌ ಮುಸಿಬತ್ ಲ್ಯಾವುಸ್‌. ಯೊ ಆವಾನ ಬಾದ್‌ಮ ತುಮುನ ಹಜ್ಜಾ಼ಥು ಜಾ಼ವಾನ ಹುಕುಮ್ ದಿಶೆ ಎತ್ರೇಸ್ ಕಾಹೆತೆ ತುಮುನ ಖ್ಹಾರಸ್ನ ಜು಼ಲಮ್‌ಥಿ ಮೋಕ್ಲಿದಿಶೆ. <verse eid="EXO 11:1" /><verse number="2" style="v" sid="EXO 11:2" />ಇನಖ್ಹಾಜೆ ಪರ್ಖ್ಹೊ ತಯೇಡ ಖ್ಹಾರು ಇವ್ಣ ಇವ್ಣ ಆಜು಼ಬಾಜು಼ಮ ರ‍್ಹವಾಳಥಿ ಖ್ಹೊನ್ನು ರೂಪುಖ್ಹಾರು ಬೋಲಿಲೇವ್ಣುಕರಿ ಅಛ್ಛಿಂತರ ಅದ್ಮಿವ್‌ನ ಬೋಲ್”ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 11:2" /><verse number="3" style="v" sid="EXO 11:3" />ಯೆಹೋವನೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳಪರ್ ಈಜಿಪ್ಟ್‌ವಾಳಮ ಗೋರ್‌ ಪೈದಾಕರ‍್ಯೊ. ಆಸ್ ಕಾಹೆತೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಫರೋಹನು ಪರಿವಾರ್‌ವಾಳು ಅಜು಼ ಮೋಶೆನ ಮಹಾನ್ ಪರ್ಖ್ಹೊಕರಿ ಮಾನಿಲಿದು <verse eid="EXO 11:3" /><verse number="4" style="v" sid="EXO 11:4" />ತದೆ ಮೋಶೆ ಫರೋಹನ, “ಯೆಹೋವ ಹುಕುಮ್ ಶಾತ್ ದೇಸ್‌ಕತೊ, ‘ಮೇ ಅಧಿರಾತ್‌ಮ ಈಜಿಪ್ಟ್‌ವಾಳಮಾಕರಿ ಚಾ಼ಲಿನ್ ಜೈ಼ಶ್. <verse eid="EXO 11:4" /><verse number="5" style="v" sid="EXO 11:5" />ತದೆ ಸಿಂಹಾಸನ್‌ಪರ್ ಬೆಠೋತೆ ಫರೋಹನ್ನೊ ಪೈಲ್ಹೊಟ ಛಿಯ್ಯಾಥಿ ಧರಿನ್, ದಳಾನಿ ಘಟ್ಟಿನ ಪೀಠೆ ಬೆಠಿಥೀತೆ ದಾಸಿನ ಪೈಲ್ಹೊಟ ಛಿಯ್ಯಾಲಗುಬಿ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಛಾ಼ತೆ ಪೈಲ್ಹೊಟ ಲಡ್ಕಖ್ಹಾರು ಮರಿಜಾ಼ಷೆ. ಜಾನ್ವರ್‌ಮಾಬಿ ಪೈಲ್ಹೋಟು ಖ್ಹಾರು ಮರಿಜಾ಼ಷೆ. <verse eid="EXO 11:5" /><verse number="6" style="v" sid="EXO 11:6" />ತದೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ ಅಖ್ಖು ಮೋಟಿ ಅಂದ್ರೊಖ್ಹ್ ಉಷೆ, ಎಥ್ರಾನು ಅಂದ್ರೊಖ್ಹ್ ಹಮ್ಕೆಲಗು ದೇಖ್ಹ್‌ಮ ಕೆದೇಬಿ ಕೋಹುಯಿರ‍್ಹುಥೂನಿ ಅಗ್ಗಳ್ ಕೋಉಷೇನಿ. <verse eid="EXO 11:6" /><verse number="7" style="v" sid="EXO 11:7" />ಕತೋಬಿ ಈಜಿಪ್ಟ್‌ವಾಳನಬಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳನಬಿ ಯೆಹೋವ ಫರಕ್ ಕರಿರಾಖ್ಯೊಸ್ ಕರಿ ಬೋಲಾನು ತುಮುನ ಮಾಲುಮ್ ಪಡಾನಿತರ ಇಸ್ರಾಯೇಲ್‌ವಾಳಮ ಛಾ಼ತೆ ಜಾನ್ವರ್‌ನ ರ‍್ಹವೊ, ಅದ್ಮಿವ್‌ನ ವಿರೋದ್‌ರ‍್ಹವೊ ಎಕ್ ಕುತ್‌ರ‍್ಯು ಜಿನು ಭೂಕ್‌ಷೆ ಕೊಯ್ನಿ’ <verse eid="EXO 11:7" /><verse number="8" style="v" sid="EXO 11:8" />ತದೆ “ತಾರು ಅದಿಕಾರಿಖ್ಹಾರು, ಮಾರಕನ ಆಯಿನ್ ಆಡ್ ಪಡಿನ್, ‘ತೂ ತಾರ ಅಧೀನ್‌ಮ ಛಾ಼ತೆ ಅದ್ಮಿಖ್ಹಾರು ಹಮುನ ಮ್ಹೇಲಿನ್ ಜಾ಼ವ್ಣುಕರಿ ಗಿಂಗಾವ್‌ಷೆ. ಇನಪಾರ್ ಮೇ ಚ಼ಲ್ಯೊಜೈಷ್” ಕರಿ ಬೊಲ್ಯೊ. ಮೋಶೆ ಆ ವಾತೆನ ಬೋಲಿನ್ ಇರಾದೇಥಿ ಭರೈನ್ ಫರೋಹನ ಮ್ಹೇಲಿನ್ ನಿಕ್ಳಿನ್ ಚ಼ಲೆಗಯೊ. <verse eid="EXO 11:8" /><verse number="9" style="v" sid="EXO 11:9" />ಯೆಹೋವ ಮೋಶೆನ, “ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಮಾರು ಮಹಾನ್ ಕಾಮ್ನ ಬಿಜೂ಼ಬಿ ಘಣೇಥಿ ಚಾ಼ಲ್ನುತೆಖ್ಹಾಜೆ ಫರೋಹ ತುಮಾರಿ ವಾತ್ನ ಖ್ಹಮಜ಼್‌ಷೆ ಕೊಯ್ನಿ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 11:9" /><verse number="10" style="v" sid="EXO 11:10" />ಮೋಶೆ ಅಜು಼ ಆರೋನ ಇವ್ಣೆ, ಫರೋಹನ ಖ್ಹಾಮ್ಣೆ ಯೊ ಮಹಾನ್ ಕಾಮ್‌ಖ್ಹಾರು ಕರ‍್ಯು. ಕತೋಬಿ ಯೆಹೋವ ಫರೋಹನ ದಿಲ್ನ ಹಟಕರಾಯೊತೆ ಇನಖ್ಹಾಜೆ ಫರೋಹ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಇನ ದೇಖ್ಹ್‌ನ ಮ್ಹೇಲಿನ್ ಜಾ಼ವಾನ ಹುಕುಮ್ ಕೊ ದಿದೋನಿತೆ ಗಯೊ.<verse eid="EXO 11:10" /></para>
  <chapter eid="EXO 11" />
  <chapter number="12" style="c" sid="EXO 12" />
  <para style="s">ಪಸ್ಕ ಪೂಜ಼</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 12:1" />ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಯೆಹೋವನೆ ಮೋಶೆ ಅಜು಼ ಆರೋನ್ನ ಜೋ಼ಡೆ ವಾತೆ ಬೋಲಿನ್ ಶಾತ್ ಬೋಲ್ಯೊಕತೊ, <verse eid="EXO 12:1" /><verse number="2" style="v" sid="EXO 12:2" />“ಅಖ್ಖಾ ಮಹಿನಾಮ ಆಸ್ ತುಮುನ ಪಹಿಲೊ ಮಹಿನೊ ಹುಯಿರ‍್ಹೇಣು. ಆಸ್ ತುಮುನ ಹರೇಕ್ ವರಖ್ಹ್‌ನೊ ಪಹಿಲೊ ಮಹಿನೊ ಹುಯಿರ‍್ಹಿಷೆ. <verse eid="EXO 12:2" /><verse number="3" style="v" sid="EXO 12:3" />ಅನಿ ಬಾರೇಮ ತುಮೆ ಇಸ್ರಾಯೇಲ್ನ ಟಾಂಡಾನಅಖ್ಖು ಅಮ್ ಹುಕುಮ್‌ ದೇವ್ಣು, ‘ಆ ಮಹಿನಾನ ದಖ್ಹ್‌ನ ದನ್‌ಮ ತುಮಾರು-ತುಮಾರು ಖಾನ್‌ಖೋಜ್ನು಼ ಹರೇಕ್ ಘರ್‌ವಾಳು ಏಕೇಕ್‌ ಮೇಂಢಾನು ಚೆಲ್ಕುರ‍್ಹವೊ, ಬೋಕ್ಡಾನು ಚೆಲ್ಕುರ‍್ಹವೊ ಲೀನ್ ಆವ್ಣು. <verse eid="EXO 12:3" /><verse number="4" style="v" sid="EXO 12:4" />ಕುಟುಂಬ್‌ ನ್ಹಾನು ಹುಯಿರ‍್ಹಿತೊ ಎಕ್-ಎಕ್ ಮೇಂಢಾನ ಚೆಲ್ಕಾನ ಅಖ್ಖುಯೇಕ್ ಖಾವನ ನಾಹುಯುತೊ ಭೀಡೆನ ಘರ್‌ವಾಳಾನ ಜೋ಼ಡೆ ಮಳಿನ್, ಎಕ್-ಎಕ್ ಜ಼ಣೊ ಕೆತ್ರು-ಕೆತ್ರು ಖಾಷೆಕರಿ ಮಾಲುಮ್ ಕರಿನ್ ಅದ್ಮಿನ ಗಣ್ತಿನಿತರ ಬೋಕ್ಡಾನು ಚೆಲ್ಕು ಲಿಲಾವದೆ. <verse eid="EXO 12:4" /><verse number="5" style="v" sid="EXO 12:5" />ಯೊ ಚೆಲ್ಕು ಶನುಬಿ ದೋಷ್‌ಕೊಂತೆ ಎಕ್ ವರಖ್ಹ್‌ನು ಬೋಕ್ಡೊ ಹುಯಿರ‍್ಹೇಣು ತುಮೆ ಮೇಂಢಾಥಿ ರ‍್ಹವೊ ಚೆರಾಳಿ ಬೋಕ್ಡೀಥಿ ರ‍್ಹವೊ ಇನ ಲಿಯೆಜಾ಼ಯ್. <verse eid="EXO 12:5" /><verse number="6" style="v" sid="EXO 12:6" />ಆ ಮಹಿನಾನು ಚೌ಼ಧಾನೆ ದನ್‌ಲಗು ಇನಅಖ್ಖು ಮ್ಹೇಲಿರಾಖಿನ್, ಯೊ ದನ್ನಿ ಖ್ಹಾಂಜ಼್‌ನಿ ವಖ್ಹತ್‌ಮ ಇಸ್ರಾಯೇಲ್ನ ಟಾಂಡವಾಳು ಅಖ್ಖುಜ಼ಣು ಎಕ್ಟು ಮಳಿನ್ ಯೊ ಅಖ್ಖಾನ ಬಲಿದೇವ್ಣು. <verse eid="EXO 12:6" /><verse number="7" style="v" sid="EXO 12:7" />ಇವ್ಣೆ ಯೊ ಅಖ್ಖಾನ ಲ್ಹೋಯಿಮ ಥೋಡು ಕಾಡಿನ್ ಇವ್ಣೆ ಖಾಯಿತೆ ಘರ್‌ನ ಬಾಕಲ್ನ ಬೇ ಹೊಸಲ್ನು ಪಟ್ಟಿನಾಬಿ, ಉಪ್ಪರ್‌ಲಿ ಪಟ್ಟಿನಾಬಿ ಲಗಾಡ್‌ಣು. <verse eid="EXO 12:7" /><verse number="8" style="v" sid="EXO 12:8" />ಯೊ ರಾತ್‌ಮಾಸ್ ಯೊ ಬೋಟಿನ ಖೈಲೇವ್ಣು. ಇನ ಆಗ್‌ಮ ಬಾಳಿನ್ ಖಾಟುಕೊಂತೆ ರೋಟಾವ್ನ ಅಜು಼ ಕಡಿ ಭಾಜಿನ ಪಲ್ಲೆನ ಜೋ಼ಡೆ ಖಾಣು ಖಾವ್ಣು. <verse eid="EXO 12:8" /><verse number="9" style="v" sid="EXO 12:9" />ಇನ ಕಚ್ಚು಼ಬೀಕಿ ಪಾಣಿಮ ರ‍್ಹಾಂದಿನ್‌ಬಿ ನಾಖಾವ್ಣು. ಇನು ಮುಡ್‌ಕ್ಯು, ಟಾಂಗ್, ಪೇಟ್, ಅನ ಖ್ಹಮೇದ್‌ ಆಗ್ಮಾಸ್ ಭುಂಜಿನ್ ಖಾವ್ಣು. <verse eid="EXO 12:9" /><verse number="10" style="v" sid="EXO 12:10" />ಬಿಜೇಕ್ ದನ್ನಾ ವ್ಹಾಣಲಗು ಇನಾಮ ದರಾಖ್ಹುಬಿ ನಾ ಉಭ್‌ರ‍್ಹಾವ್ಣು, ವ್ಹಾಣಲಗು ಉಭ್ರಿರ‍್ಹೇಸ್‌ತೆ ಇನ ಆಗ್‌ಥಿ ಬಾಳಿನಾಕ್ಣು. <verse eid="EXO 12:10" /><verse number="11" style="v" sid="EXO 12:11" />ಯೊ ಖಾವಾನ ಕರ‍್ನುತೆ ನಿಯಮ್ ಕಿಮ್‌ಕತೊ: ತುಮೆ ಒಗ್ಗಿಸ್‌ ಲಾಧಿಜ಼ಾವಾನಿಘೊಣಿ ಕಷ್‌ಬಂದ್ ಭಾಂದಿಲಿನ್ ಖೋಖ್ಹ್‌ಡಾನ ಘಾಲಿಲೀನ್‌, ಲಠ್ಠೊ ಧರೀನ್, ಒಗ್ಗಿ ಒಗ್ಗಿಸ್‌ಮ ಖಾವ್ಣು ಆಹೈರುತೆ ಯೆಹೋವನ ಕರಾನು ಪಸ್ಕನು ಪೂಜ಼ <verse eid="EXO 12:11" /><verse number="12" style="v" sid="EXO 12:12" />ಯೊ ರಾತ್ಮ ಮೇ ಈಜಿಪ್ಟ್ ದೆಖ್ಹ್‌ಪರ್ ಚಾ಼ಲಿಜೈ಼ನ್ ಅದ್ಮಿಮ ರ‍್ಹವೊ ಜಾನ್ವರ್‌ಮ ರ‍್ಹವೊ ಪೈಲ್ಹೋಟು ರ‍್ಹವಾನು ಖ್ಹಾರಾನ ಮಾರಿನಾಖಿಷ್. ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನು ಹರೇಕ್ ದೇವ್ತಿನಾಬಿ ನಿಶತ್ ದಿಶ್. ಮೇಸ್ ಯೆಹೋವ. <verse eid="EXO 12:12" /><verse number="13" style="v" sid="EXO 12:13" />ಕತೋಬಿ ತುಮೆ ರ‍್ಹವಾನು ಅಖ್ಖಾಸ್ ಘರ್‌ನ ಬಾಕಲ್ನ ಲಗಾಡಿರಾಖ್ಯುತೆ ಲ್ಹೋಯಿ ಖ್ಹಣೇದ್ ಹುಯಿರ‍್ಹಿಷೆ. ಯೊ ಲ್ಹೋಯಿನ ಮೇ ದೇಖಾನಿವಖ್ಹ್‌ತೆ ತುಮುನ ಖಿವೂಬಿ ಲುಕ್ಷಾನ್ ಕರಿಶ್‌ಕೊಂತೆ ಅಗ್ಗಳ್ ಉಲಾಂಗಿ ಜೈ಼ಶ್. ಮೇ ಈಜಿಪ್ಟ್‌ವಾಳನ ಮಾರಾನಿವಖ್ಹ್‌ತೆ ತುಮುನ ಶನೀಬಿ ಲುಕ್ಷಾನ್‌ಬಿ ಕೊ ಉಷೇನಿ. <verse eid="EXO 12:13" /><verse number="14" style="v" sid="EXO 12:14" />ಆ ದನ್ ತುಮುನ ಯಾದ್‌ನಖ್ಹಾಜೆ ರ‍್ಹಿಶೆ. ಯೆಹೋವನ ಮರ‍್ಯಾದಿನಖ್ಹಾಜೆ ಆ ಪೂಜಾ಼ನ ಮುಂಡಿನ್ ಮುಂಡೀಬಿ ಚ಼ಲಾವ್ಣು ಇನ ಹಮೇಶಾನು ನಿಯಮ್‌ ಕರಿ ಕದೆ ಕದೇಬಿ ಚ಼ಲಾವ್ಣು.<verse eid="EXO 12:14" /></para>
  <para style="s">ಖಾಟು ಕೊಂತೆ ರೋಟಾನಿ ಪೂಜ಼</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 12:15" />ಖ್ಹಾತ್ ದನ್‌ಲಗು ತುಮೆ ಖಾಟುಕೊಂತೆ ರೋಟಾವ್ನ ಖಾವ್ಣು. ಪಹಿಲ ದನ್ಮಾಸ್ ಖಾಟ ಆಟಾನ ತುಮಾರ ಘರ್‌ಮಾಥು ಕಾಡಿನಾಕ್ಣು. ಶನಕತೊ ಪಹಿಲ ದನ್‌ಥು ಖ್ಹಾತ್ ದನ್‌ಲಗು ಖಾಟರೋಟಾನ ಖಾವವಾಳೊ ಇಸ್ರಾಯೇಲ್‌ವಾಳಮಾಥು ಕಾಡಿನಾಕ್ಣು. <verse eid="EXO 12:15" /><verse number="16" style="v" sid="EXO 12:16" />ಪಹಿಲ ದನ್‌ಮ ಪರಿಶುದ್ಧ ದೇವ್ನಿ ಆರಾದನೆನಖ್ಹಾಜೆ ಸಬೆ ಮಳ್‌ಣು. ಆ ಬೇ ದನ್ಮ ಖಿವು ಕಾಮ್‌ಬಿ ನಾಕರ‍್ನು ಖಾಣನ ಹೋಣುತೆಯಿನ ಕರೆಜಾ಼ಯ್ ಪಣ್ಕಿ ಬಿಜು಼ ಖಿವೂಬಿ ಕಾಮ್ ನಾಕರ‍್ನು. <verse eid="EXO 12:16" /><verse number="17" style="v" sid="EXO 12:17" />ತುಮೆ ಖಾಟುಕೊಂತೆ ರೋಟಾನಿ ಪೂಜಾ಼ನ ಚ಼ಲಾವ್ಣು ಶನಕತೊ ಆ ದನ್ಮಾಸ್ ಮೇ ತುಮುನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮಾಥು ಭಾರ್‌ ಬುಲೈಲಿನ್ ಆಯೋತೆ ಖ್ಹಾಜೆ ತುಮೇಬಿ, ತುಮಾರಿ ಪಿಳ್ಗೀಬಿ ಆ ದನ್ನ ಚ಼ಲಾವ್ಣು ಆ ಹಮೇಶಾನು ನಿಯಮ್‌ ಹುಯಿರ‍್ಹಿಸ್. <verse eid="EXO 12:17" /><verse number="18" style="v" sid="EXO 12:18" />ಪಹಿಲ ಮಹಿನಾನು ಚೌ಼ಧಾನೆ ದನ್ನ ಖ್ಹಾಂಜ಼್‌ಥು ಧರೀನ್ ಯೋಸ್ ಮಹಿನಾನು ಎಕ್ ಉಪ್ಪರ್ ವೀಖ್ಹ್‌ನ ದನ್ನ ಖ್ಹಾಂಜ಼್‌ಲಗು ತುಮೆ ಖಾಟುಕೊಂತೆ ರೋಟಾವ್ನ ಖಾವ್ಣು. <verse eid="EXO 12:18" /><verse number="19" style="v" sid="EXO 12:19" />ಯೊ ಖ್ಹಾತ್ ದನ್‌ಲಗು ತುಮಾರ ಘರೂಮ ಖಾಟೊ ಆಟೊ ನಾರ‍್ಹೇವ್ಣು. ಖಾಟು ಮಳಾಯ ಹುಯಾನ ಕೋಣ್ ಖಾಸ್ಕಿ ಯೊ ಪರ್‌ದೇಖ್ಹ್‌ವಾಳೊ ರ‍್ಹವಾದೆ, ಶೊಂತ್ ದೇಖ್ಹ್‌ವಾಳೊ ರ‍್ಹವೊ ಇಸ್ರಾಯೇಲ್ನ ಟಾಂಡಮಾಥು ಕಾಡಿನಾಖಿದೇವ್ಣು. <verse eid="EXO 12:19" /><verse number="20" style="v" sid="EXO 12:20" />ತುಮೆ ತುಮಾರ ಘರ್‌ಮ ಖಾಟುಕೊಂತೆ ರೋಟೊ ಖಾವ್ಣು ಪಣ್ಕಿ ಖಾಟು ಕಲಾಯುಹುಯು ಖಿವೂಬಿ ನಾಖಾವ್ಣು” ಕರಿ ಹುಕುಮ್‌ ಕರ‍್ಯೊ.<verse eid="EXO 12:20" /></para>
  <para style="s">ಪಹಿಲಿ ಪಸ್ಕ ಪೂಜ಼</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 12:21" />ತದೆ ಮೋಶೆ ಇಸ್ರಾಯೇಲ್ನ ಶಾಣಾವ್ನ ಬುಲೈನ್ ಇವ್ಣುನ, “ತುಮೆ ತುಮಾರ ಕುಟುಂಬ್‌ನಖ್ಹಾಜೆ ಮಂಧಾತು ಚೆಲ್ಕಾನ ಚೂ಼ಣಿಲಿನ್ ಪಸ್ಕ ಪೂಜಾ಼ನ ವ್ಹಾಡೊ. <verse eid="EXO 12:21" /><verse number="22" style="v" sid="EXO 12:22" />ಹಿಸ್ಸೋಪ್ ಝಾ಼ಡಾನಿ ಕಟ್ಟೀನ ಲೀನ್ ಕಟೋರಮಾನು ಲ್ಹೋಯಿಮ ಇನ ಡುಬೈನ್ ಬಾಕಲ್ನ ಉಪ್ಲಿ ಆಡಿ ಪಟ್ಟೀನಬಿ, ಇನ ಭೀಡೆನ ಭೇ ಬಾಕಲ್ನ ಪಟ್ಟಿನಾಬಿ ಲಗಾಡ್‌ಣು. ಇನಕೇಡೆಥು ತುಮಾರಮ ಏಕ್‌ಜ಼ಣುಬಿ ವ್ಹಾಣು ಹುವಾಲಗು ಘರ್‌ನ ಬಾಕಲ್ ಮ್ಹೇಲಿನ್ ಭಾರ್ ನಾಜಾ಼ವ್ಣು. <verse eid="EXO 12:22" /><verse number="23" style="v" sid="EXO 12:23" />ಯೆಹೋವ ಈಜಿಪ್ಟ್‌ವಾಳನ ಮಾರಿನಾಖನಖ್ಹಾಜೆ ದೇಖ್ಹ್‌ಮಾಕರಿ ಚಾ಼ಲಿಜಾಶೆ. ತದೆ ತುಮಾರು-ತುಮಾರು ಘರ್‌ನ ಬಾಕಲ್‌ನಿ ಉಪ್ಲಿ ಪಟ್ಟಿಮಾಬಿ ಭೇ ಚೌಕಟ್ನ ಪಟ್ಟಿಮಾಬಿ ಯೊ ಲ್ಹೋಯಿನ ದೇಖಿನ್ ಅಗ್ಗಳ್ ಉಲಾಂಗಿನ್ ಜಾಷೆ. ತುಮಾರ ಜಾನ್ನ ಕಾಡವಾಳೊ ಮರಣ್ಣೊದೂತ ತುಮಾರ ಘರ್‌ಮ ಆವ್‌ಶೇಸ್ ಕೊಯ್ನಿ. <verse eid="EXO 12:23" /><verse number="24" style="v" sid="EXO 12:24" />ಆ ತುಮುನಾಬಿ ತುಮಾರಿ ಪಿಳ್ಗಿನಾಬಿ ಹಮೇಶಾನು ನಿಯಮ್ ಕರಿ ಚ಼ಲಾವ್ಣು. <verse eid="EXO 12:24" /><verse number="25" style="v" sid="EXO 12:25" />ಯೆಹೋವ ಇನಿ ವಾತ್ನಿ ಘೋಣಿ ತುಮುನ ದಿಶೇತೆ ವಾಗ್ದಾನ್ನ ದೇಖ್ಹ್‌ನ ತುಮೆ ಆಯಾತೊ, ಯೊ ನಿಯಮ್ನ ಕರ‍್ನುಸ್‌ಪಡ್ಯು. <verse eid="EXO 12:25" /><verse number="26" style="v" sid="EXO 12:26" />ಅಗ್ಗಳ್ ತುಮಾರ ಲಡ್ಕ, ‘ತುಮೆ ಕರಾನಿ ಆ ಪದತ್ತಿನ ದೇಖಿನ್ ಅನಿ ಅರ್ಥಶಾತ್? ಕರಿ ತುಮುನ ಬೋಲಾನಿವಖ್ಹ್‌ತೆ, <verse eid="EXO 12:26" /><verse number="27" style="v" sid="EXO 12:27" />ತುಮೆ ಇವ್ಣುನ, ‘ಯೆಹೋವ ಈಜಿಪ್ಟ್‌ವಾಳನ ಮಾರಿನಾಖನಿ ವಖ್ಹ್‌ತೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮಥೂತೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಘರ್‌ಮ ಪೇಖ್ಹ್‌ಯೊ ಕೊಂತೆ ಅಗ್ಗಳ್ ಉಲಾಂಗಿನ್ ಅಪ್ಣ ಘರ್‌ವಾಳಾನ ಬಚಾ಼ಯೊತೆಖ್ಹಾಜೆ ಅಪ್ಣೆ ಯೆಹೋವನ ಪಸ್ಕಕರಿ ಆ ಬಲಿನ ಚ಼ಲಾವ್ಣುಕರಿ ಬೋಲ್ನು” ಕರಿ ಬೊಲ್ಯೊ. ತದೆ ಅದ್ಮಿಖ್ಹಾರು ಢುಕ್ಣಿಮಾಂಡಿನ್‌ ಯೆಹೋವನ ಅರಾದನೆ ಕರ‍್ಯು. <verse eid="EXO 12:27" /><verse number="28" style="v" sid="EXO 12:28" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಹಿಜ್ಜಾ಼ಥು ನಿಕ್ಳಿನ್ ಯೆಹೋವನೆ ಮೋಶೆ ಆರೋನ್ನ ಹುಕುಮ್ ದಿದೋತೆ ಪರಕ್ಮಾಸ್ ಕರ‍್ಯು.<verse eid="EXO 12:28" /></para>
  <para style="s">ಪೈಲ್ಹೋಟ ಲಡ್ಕಾವ್ನಿ ಮರಣ್</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 12:29" />ಅಧಿರಾತ್‌ಮ ಯೆಹೋವನೆ ಸಿಂಹಾಸನ್‌ಮ ಥಾತೆ ಫರೋಹನ ಪೈಲ್ಹೋಟ ಛಿಯ್ಯಾಥಿ ಧರಿನ್ ಜೇಲ್ಮಥೂತೆ ಖೈದಿನ ಪೈಲ್ಹೊಟ ಛಿಯ್ಯಾಲಗುಬಿ, ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಥೂತೆ ಅಖ್ಖೂಸ್ ಪೈಲ್ಹೋಟ ಲಡ್ಕಾನ ಮಾರಿನಾಖ್ಯೊ. ಜಾನ್ವರ್‌ನು ಪೈಲ್ಹೋಟ ಚೆಲ್ಕಾವ್‌ನಬಿ ಮಾರಿನಾಖ್ಯೊ. <verse eid="EXO 12:29" /><verse number="30" style="v" sid="EXO 12:30" />ಯೊ ರಾತ್ಮ ಫರೋಹಾನೆಬಿ, ಇನ ಅದಿಕಾರಿವಾಳುಬಿ ಈಜಿಪ್ಟ್‌ವಾಳು ಉಠಿನ್ ದೇಖಾಖ್ಹತರ್ ಮರಣ್ ಕೊಯ್ನಿತೆ ಘರ್ ಏಕ್‌ಬಿ ಕೋಥುನಿ. ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಮೋಟಿ ರದನ್ಯ ಹುಯು. <verse eid="EXO 12:30" /><verse number="31" style="v" sid="EXO 12:31" />ಫರೋಹಾನೆ ಯೊ ರಾತ್‌ಮಾಸ್ ಮೋಶೆ ಅಜು಼ ಆರೋನ ಇವ್ಣುನ ಬುಲೈನ್ ಮಂಗೈನ್ ಇವ್ಣುನ, “ತುಮೆ ಉಠಿನ್ ಮಾರ ಅದ್ಮಿನ ಬೀಚ್ಮಾಥು ನಿಕ್ಳಿಜಾ಼ವೊ. ತುಮೆ ಬೋಲಿಲಿದಾತೆ ತಿಮ್ಮಸ್ ಯೆಹೋವನ ಆರಾದನೆ ಕರಾನ ತುಮೆ ಅಜು಼ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ನಿಕ್ಳಿಜಾ಼ವೊ. <verse eid="EXO 12:31" /><verse number="32" style="v" sid="EXO 12:32" />ತುಮೆ ಬೋಲಿಲಿದಾತೆ ತಿಮ್ಮಸ್ ತುಮಾರು ಮೇಂಢು, ಢಾಂಡ ಬೋಕ್ಡಾನ ಮಂಧಾನ ಲೀನ್ ಜಾ಼ವೊ. ಎತ್ರೇಸ್ ಕಾಹೆತೆ ಮನಾಬಿ ಜಿನು ಆಶೀರ್ವಾದ್‌ ಕರೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 12:32" /><verse number="33" style="v" sid="EXO 12:33" />ಈಜಿಪ್ಟ್‌ವಾಳು, “ಹಮೆ ಅಖ್ಖು ಮರಿಜಾ಼ಶು” ಕರಿ ಬೋಲಿನ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಇವ್ಣ ದೇಖ್ಹ್‌ಥು ಒಗ್ಗಿಸ್ ಮೋಕ್ಲಿದ್ಯವಾನ ಖ್ಹಯಾಲ್ ಕರಿನ್ ಇವ್ಣುನ ಜು಼ಲಮ್‌ ಕರ‍್ಯು. <verse eid="EXO 12:33" /><verse number="34" style="v" sid="EXO 12:34" />ಇನಖ್ಹಾಜೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಅದ್ಮಿ ಆಟಾಮ ಖಾಟುನಾಖನ ವಖ್ಹತ್ ಕೋಥಿನಿ. ಇವ್ಣೆ ಖಾಣುಕರಾನ ರಾಛಾ಼ಮ ಆಟಾನ ಮುದ್ದಾನ ಲುಂಗ್ಡಾಮ ಲಪೇಟಿಲೀನ್ ಭುಜ಼್‌ಪರ್ ನಾಖಿಲಿನ್ ಗಯು. <verse eid="EXO 12:34" /><verse number="35" style="v" sid="EXO 12:35" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಮೋಶೆನಿ ವಾತ್ನಿ ಪರಕ್ಮಾಸ್ ಈಜಿಪ್ಟ್‌ವಾಳಥಿ ಖ್ಹೊನ್ನು ರೂಪು ಲುಂಗ್ಡಾವ್ನ ಬೋಲಿಲಿದು. <verse eid="EXO 12:35" /><verse number="36" style="v" sid="EXO 12:36" />ಯೆಹೋವಾನೆ ಇವ್ಣಪರ್ ಈಜಿಪ್ಟ್‌ವಾಳನ ಗೋರ್‌ ಆವನಿತರ ಕರ‍್ಯೊತೆ ದೇಖಿನ್ ಇವ್ಣೆ ಬೋಲಿಲಿದೂತೆ ಇನ ದಿದು. ಅಮ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಈಜಿಪ್ಟ್‌ವಾಳನಿ ಶೊತ್‌ನ ಖ್ಹಮೇಟಿಲಿದು.<verse eid="EXO 12:36" /></para>
  <para style="s">ಇಸ್ರಾಯೇಲ್ವಾಳು ಈಜಿಪ್ಟ್‌ನ ಮ್ಹೇಲಿನ್ ಗಯೂತೆ</para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 12:37" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ರಾಮ್ಸೇಸ್ ಖ್ಹಯೇರ್‌ಥಿ ನಿಕ್ಳಿನ್ ಸುಕ್ಕೋತಿನ ಆಯು. ತಯೇಡಸ್ ಲಡ್ಕಾಸ್ ಕಾಹೆತೆ ಪರ್ಖ್ಹಾಸ್ ಖ್ಹುಮಾರ್ ಛೊ಼ ಲಾಕ್ ಜ಼ಣು ಥು. <verse eid="EXO 12:37" /><verse number="38" style="v" sid="EXO 12:38" />ಇವ್ಣ ಜೋ಼ಡೆ ಕೈಯೇಕ್ ಜ಼ಣು ಅಲ್ಹಾವಸ್ ನಿಕ್ಳಿನ್ ಐರ‍್ಹುಥು. ಢಾಂಡ ಬೋಕ್ಡ ಮೇಂಢಾನು ಮಂಧು ಜಾನ್ವರ್‌ ಇವ್ಣ ಜೋ಼ಡೆ ನಿಕ್ಳಿಗಯು. <verse eid="EXO 12:38" /><verse number="39" style="v" sid="EXO 12:39" />ಇವ್ಣೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಲೀನ್ ಆಯೂತೆ ಇವ್ಣೆ ಘೂಂದ್ಯೊಹುಯೊ ಆಟೇಥಿ ಖಾಟುಕೊಂತೆ ರೋಟಾವ್ನ ಕರಿಲಿದು. ಇವ್ಣೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ನಿಕ್ಳಿನ್ ದರಾಖ್ಹುಬಿ ವಖ್ಹತ್ ಮಳ್ಯುಕೊಂತೆ ಇನಖ್ಹಾಜೆ ಇವ್ಣೆ ಜಾ಼ವಾನ ಖ್ಹಾಜೆ ವಿಶೇಷ್ ಖಾಣಾನ ತಯಾರ್ ಕರಾನ ಕೊಹುಯುನಿ. <verse eid="EXO 12:39" /><verse number="40" style="v" sid="EXO 12:40" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಖ್ಹುಮಾರ್ ಚಾರ್‌ಖ್ಹೊ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್‌ಲಗು ಜಿವಿರ‍್ಹೂಥು. <verse eid="EXO 12:40" /><verse number="41" style="v" sid="EXO 12:41" />ಚಾರ್‌ಖ್ಹೊ ಡೋಡಿಖ್ಹ್‌ ವರಖ್ಹ್ ನಿಕ್ಳಾನ ಬಾದ್ಮ ಯೊ ದನ್ಮಾಸ್ ಯೆಹೋವನು ಅದ್ಮಿಖ್ಹಾರು ಅಜು಼ ಖೂಮ್‌ಖ್ಹಾರು ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ ಮ್ಹೇಲಿನ್ ನಿಕ್ಳಿಗಯು. <verse eid="EXO 12:41" /><verse number="42" style="v" sid="EXO 12:42" />ಯೆಹೋವ ಯೊ ರಾತ್‌ಮಾಸ್ ಇವ್ಣುನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಭಾರ್‌ ಬುಲೈಲೀನ್ ಆಯೋತೆಖ್ಹಾಜೆ ಇವ್ಣೆ ರಾತ್ಮ ಇನ ಮರ‍್ಯಾದಿನಖ್ಹಾಜೆ ಜಾಗರಣೆ ಕರ‍್ಯು. ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಖ್ಹಾರು ಮುಂಡಿನ್ ಮುಂಡಿಮಾಬಿ ಯೆಹೋವಾನ ಜಾಗರಣೆ ಚ಼ಲಾವನಿ ರಾತ್ ಆಸ್ ಹುಯಿರ‍್ಹಿಸ್.<verse eid="EXO 12:42" /></para>
  <para style="s">ಪಸ್ಕಜ಼ತ್ರಾನ ಚ಼ಲಾವನಿ ನಿಯಮ್.</para>
  <para style="p">
    <verse number="43" style="v" sid="EXO 12:43" />ಯೆಹೋವನೆ ಮೋಶೆ ಅಜು಼ ಆರೋನ ಇವ್ಣುನ ಬೊಲ್ಯೊ ಶಾತ್‌ಕತೊ, “ಪಸ್ಕನ ಚ಼ಲಾವನು ನಿಯಮ್ ಕಿಮ್‌ಕತೊ, ಅಲ್ಹಾವ್ ಎಕ್ ಜ಼ಣೂಬಿ ಆ ಪಸ್ಕನು ಖಾಣು ನಾಖಾವ್ಣು. <verse eid="EXO 12:43" /><verse number="44" style="v" sid="EXO 12:44" />ಕತೋಬಿ ತುಮೆ ಮೋಲ್ ಲೆವೈಗಯಹುಯ ಹರೇಕ್ ಗುಲಾಮ್ ಖ್ಹತ್ನಕರೈಲ್ಯವಾನ ಬಾದ್ಮ ಇನ ಖಾಯೆಜಾ಼ಯ್. <verse eid="EXO 12:44" /><verse number="45" style="v" sid="EXO 12:45" />ಅಲ್ಹಾವ್ ದೇಖ್ಹ್‌ವಾಳುಬಿ, ಥೋಡದನ್ನಿ ಕೂಲಿವಾಳೊಬಿ ಇನ ನಾಖಾವ್ಣು. <verse eid="EXO 12:45" /><verse number="46" style="v" sid="EXO 12:46" />ಇವ್ಣ ಇವ್ಣ ಘರ್‌ಮಾಸ್ ಇನ ಖಾವ್ಣು ಇನಾಮ ದರಾಖ್ಹು ಬೋಟಿನಾಬಿ ಘರ್‌ನ ಭಾರ್ ಲೀನ್ ನಾಜಾ಼ವ್ಣು. ಯೊ ಜಾನ್ವರ್‌ನ ಎಕ್ ಪಾಖ್ಹ್‌ಳಿನಾಬಿ ನಾ ತೋಡ್ನು. <verse eid="EXO 12:46" /><verse number="47" style="v" sid="EXO 12:47" />ಇಸ್ರಾಯೇಲ್ನ ಟೋಳ್‌ವಾಳು ಆ ಪೂಜಾ಼ನ ಚ಼ಲಾವ್ಣು. <verse eid="EXO 12:47" /><verse number="48" style="v" sid="EXO 12:48" />ತುಮಾರಕನ ಜಿವ್‌ಕರಾತೆ ಪರ್‌ದೇಖ್ಹ್‌ವಾಳೊ ಯೆಹೋವಾನ ಪಸ್ಕಾನ ಪೂಜ಼ನ ಚ಼ಲಾವ್ಣುಕರಿ ಖ್ಹಯಾಲ್ ಕರ‍್ಯೊತೊ ಯೋಬಿ ಇನ ಮಳಿಹುಯು ಪರ್ಖ್ಹಾ ಖ್ಹಾರುಬಿ ಖ್ಹತ್ನಕರಾವ್ಣು. ಇನವಾರ್ ಯೊ ಆ ಪೂಜಾ಼ನ ಚ಼ಲಾವನ ಖನ್ನೆ ಆವಾದೆ. ಎಥ್ರಾನವಾಳೊ ಶೊಂತ್ ದೇಖ್ಹ್‌ವಾಳನಿತರಸ್ ರ‍್ಹಿಶೆ. ಕತೋಬಿ ಖ್ಹತ್ನ ನಾಕರೈರಾಖವಾಳೊ ಆ ಖಾಣನ ನಾ ಖಾವ್ಣು. <verse eid="EXO 12:48" /><verse number="49" style="v" sid="EXO 12:49" />ಇಸ್ರಾಯೇಲ್‌ವಾಳನಾಬಿ, ತುಮಾರಮ ಜಿವ್ಣುಕರುಕರಾತೆ ಪರ್‌ದೇಖ್ಹ್‌ವಾಳನಬಿ ಎಕ್ಕಸ್ ನಿಯಮ್ ರ‍್ಹೇಣು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 12:49" /><verse number="50" style="v" sid="EXO 12:50" />ಯೆಹೋವನೆ ಮೋಶೆ ಅಜು಼ ಆರೋನ್ನ ಹುಕುಮ್ ದಿದೋತೆ ಪರಕ್ಮಾಸ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಕರ‍್ಯು. <verse eid="EXO 12:50" /><verse number="51" style="v" sid="EXO 12:51" />ಯೋಸ್ ದನ್ಮ ಯೆಹೋವ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಇವ್ಣ ಇವ್ಣ ಖೂಮ್‌ ಪರಕ್‌ನಿತರಾಸ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಭಾರ್‌ಲಾಯೊ.<verse eid="EXO 12:51" /></para>
  <chapter eid="EXO 12" />
  <chapter number="13" style="c" sid="EXO 13" />
  <para style="s">ಪೈಲ್ಹೋಟ ಲಡ್ಕಾವ್ನಿ ಸಮರ್ಪಣ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 13:1" />ಯೆಹೋವಾನೆ ಮೋಶೆನ ಜೋ಼ಡೆ ವಾತೆ ಬೋಲಿನ್, <verse eid="EXO 13:1" /><verse number="2" style="v" sid="EXO 13:2" />“ಇಸ್ರಾಯೇಲ್‌ವಾಳಮ ಪೈದಾಹುಯಿರ‍್ಹುತೆ ಹರೇಕ್ ಪೈಲ್ಹೋಟ ಪರ್ಖ್ಹಾನ ಮಾರಖ್ಹಾಜೆ ಮ್ಹೇಲಿದೇವ್ಣು. ಅದ್ಮಿಮ ರ‍್ಹವೊ ಜಾನ್ವರ್‌ಮ ರ‍್ಹವೊ ಪೈದಾ ಹುವಾತೆ ಪಹಿಲು ಗರಬ್‌ನು ಫಲ್ ಮಾರು ಹುಯಿರ‍್ಹುಸ್” ಕರಿಬೋಲ್ಯೊ.<verse eid="EXO 13:2" /></para>
  <para style="s">ಖಾಟುಕೊಂತೆ ರೋಟಾನಿ ಪೂಜ಼</para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 13:3" />ಮೋಶೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ, “ಗುಲಾಮ್‌ಗಿರಿಮ ರ‍್ಹೀನ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಛುಟ್ಕಾರ್ ಹುಯಿರ‍್ಹುತೆ ಆ ದನ್ನಾ ತುಮೆ ಯಾದ್ ರಾಖೊ. ಯೆಹೋವ ಇನಿಮೋಟಿ ಶಕಥ್ಥಿ ತುಮುನ ಯೊ ಝ಼ಗೋಥು ಛೋ಼ಡೈರಾಖ್ಯೊಸ್. ಆ ದನ್ಮ ತುಮೆ ಖಾಟು ಮಳಾಯುಹುಯು ನಾಖಾವ್ಣು. <verse eid="EXO 13:3" /><verse number="4" style="v" sid="EXO 13:4" />ಚೇತ್ರಿನು ಮಹಿನಾನು ಆ ದನ್ಮಾಸ್ ತುಮೆ ಭಾರ್‌ ಐರ‍್ಹಾಸ್. <verse eid="EXO 13:4" /><verse number="5" style="v" sid="EXO 13:5" />ಯೆಹೋವ ತುಮಾರ ಗುರುಗುರಬ್‍ಲ್ಯನ ಕೋಲ್‌ನಾಮ್‌ ಕರಿನ್ ಬೋಲಾನಿತರ, ತುಮುನಾಬಿ ದೂದ್‌ಬಿ ಅಜು಼ ಶೇತ್‌ಬಿ ವಹುಕರಾನು ದೇಖ್ಹ್‌ನ ಕತೊ ಕಾನಾನ್‌ವಾಳು, ಹಿತ್ತಿಯವಾಳು, ಅಮೋರಿಯವಾಳು, ಹಿವ್ವಿವಾಳು, ಯೆಬೂಸಿವಾಳು ಜಿವ್‌ಕರಾಸ್ತೆ ದೇಖ್ಹ್‌ನ ಬುಲೈಲೀನ್ ಐನ್ ಇನ ತುಮುನ ದಿದುತೊ ತದೆ ತುಮೆ ಆ ಮಹಿನಾಮ ಆ ಕಾಮ್ನ ಚ಼ಲಾವ್ಣು. <verse eid="EXO 13:5" /><verse number="6" style="v" sid="EXO 13:6" />ಖ್ಹಾತ್ ದನ್ ತುಮೆ ಖಾಟುಕೊಂತೆ ರೋಟಾವ್ನ ಖಾಣು, ಖ್ಹಾತ್‌ನ ದನ್ಮ ಯೆಹೋವನಿ ಮರ‍್ಯಾದಿನಖ್ಹಾಜೆ ಆ ಪೂಜಾ಼ನ ಕರ‍್ನು. <verse eid="EXO 13:6" /><verse number="7" style="v" sid="EXO 13:7" />ಯೊ ಖ್ಹಾತ್ ದನ್‌ಬಿ ಖಾಟುಕೊಂತೆ ರೋಟಾವ್ನ ಖಾಣು. ಕಾಹೆತೆ ತುಮಾರಮ ಖಾಟು ಆಟೊ ದೆಖಾವ್ಣುನಾ, ನತರ್ ಖಾಟೊ ಆಟೊ ತುಮಾರ ಇಟಾರಮಸ್ ನಾದೆಖಾವ್ಣು. <verse eid="EXO 13:7" /><verse number="8" style="v" sid="EXO 13:8" />ಯೊ ದನ್ಮ ತುಮೆ ತುಮಾರ ಲಡ್ಕಾವ್ನ, ಅಪ್ಣು ಅದ್ಮಿ ಈಜಿಪ್ಟ್ ದೆಖ್ಹ್‌ಥು ನಿಕ್ಳಿನ್ ಆವಖ್ಹತರ್ ಯೆಹೋವ ಅಪ್ಣಖ್ಹಾಜೆ ಕರ‍್ಯೊತೆ ಇನ ಯಾದ್ ಕರಿಲ್ಯವಾನಖ್ಹಾಜೆ ಅನ ಚ಼ಲಾವ್ಣು. <verse eid="EXO 13:8" /><verse number="9" style="v" sid="EXO 13:9" />ಯೆಹೋವ ಇನಿ ಮೋಟಿ ಶಕಥ್ಥಿ ತುಮುನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಛೋ಼ಡಾಯೊತೆಖ್ಹಾಜೆ ಇನ ನಿಯಮ್‌ನಿ ಬಾರೇಮ ತುಮೆ ಬೋಲ್ನು. ಆ ಆಚರಣೆನ ತುಮಾರ ಹಾತ್‌ಪರ್ ಖ್ಹಣೇದ್‌ಕರಿನ್‌ಬಿ, ತಾಳ್ವಪರ್ ಭಾಂದಿರಾಖನು ಯಾದ್‌ನಿ ಪಟ್ಟಿನಿತರಾಬಿ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 13:9" /><verse number="10" style="v" sid="EXO 13:10" />ಅಮ್ ಛಾ಼ತೆಖ್ಹಾಜೆ ವರಖ್ಹ್ ವರಖ್ಹ್‌ಬಿ ಬೋಲಿರಾಖ್ಯೊಸ್‌ತೆ ವಖ್ಹತ್‌ಮ ತುಮೆ ಆ ಪದತ್ತಿ ಕರ‍್ನು.<verse eid="EXO 13:10" /></para>
  <para style="s">ಫೈಲೋಟು</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 13:11" />ಯೆಹೋವ ತುಮುನಾಬಿ ತುಮಾರ ಗುರುಗುರಬ್‌ಲ್ಯನಬಿ ಕೋಲ್‌ನಾಮ್‌ ಕರ‍್ಯುತೆ ಪರಕ್ಮ ತುಮುನ ಕಾನಾನ್‌ವಾಳನ ದೇಖ್ಹ್‌ನ ಬುಲೈನ್ ಯೊ ದೇಖ್ಹ್‌ನ ತುಮುನ ದ್ಯವಾನ ಬಾದ್ಮ, <verse eid="EXO 13:11" /><verse number="12" style="v" sid="EXO 13:12" />ತುಮಾರಮಾಬಿ ತುಮಾರ ಜಾನ್ವರ್‌ಮಾಬಿ, ಪೈದಹುವಾಸ್ತೆ ಪಹಿಲು ಪರ್ಖ್ಹೊ ಹುಯಿರ‍್ಹುತೊ ಯೊ ಯೆಹೋವನೊ ಭಾಗ್‌ಕರಿ ಮಾಲುಮ್ ಕರಿನ್ ಇನ ಯೆಹೋವಾನ ಸಮರ್ಪಣ್‌ ಕರ‍್ನು. <verse eid="EXO 13:12" /><verse number="13" style="v" sid="EXO 13:13" />ಪಹಿಲೆ ಪೈದಹುಯುತೆ ಗಧೇಡಾನ ಪೈಲ್ಹೋಟ ಚೆಲ್ಕಾನ ಬದಲ್ ಮೇಂಢಾನ ಚೆಲ್ಕಾನ ಛೋ಼ಡೈಲಿಯೆಜಾ಼ಯ್. ಇಮ್ ನಾ ಛೋ಼ಡಾಯುತೊ ಇನು ಬೋಚಿ ತೋಡಿ ಮಾರಿನಾಕ್ಣು. ಅದ್ಮಿನ ಪೈಲ್ಹೋಟು ಪರ್ಖ್ಹಾನ ಯೆಹೋವನಖ್ಹಾಜೆ ಛೋ಼ಡೈಸ್‌ಲೇವ್ಣು. <verse eid="EXO 13:13" /><verse number="14" style="v" sid="EXO 13:14" />ಖ್ಹಾಮ್ಣೆ ತುಮಾರ ಲಡ್ಕ, ‘ಅನಿ ಮತ್ಲಬ್ ಶಾತ್?’ ಕರಿ ತುಮುನ ಪುಛಾ಼ವನಿ ವಖ್ಹ್‌ತೆ ತುಮೆ ಇವ್ಣುನ, ‘ಹಮೆ ಗುಲಾಮ್‌ಗಿರಿ ಥಾತೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥಿ ಯೆಹೋವನೆ ಇನಿ ಮೋಟಿ ಶಕಥ್ಥಿ ಹಮುನ ಛೋ಼ಡಾಯೊ. <verse eid="EXO 13:14" /><verse number="15" style="v" sid="EXO 13:15" />ಫರೋಹನೆ ಹಟಧರಿನ್ ಹಮುನ ಮೋಕ್‌ಲ್ಯೊಕೊಂತೆ ರ‍್ಹವಾನಿ ವಖ್ಹ್‌ತೆ ಯೆಹೋವ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಅದ್ಮಿವ್‌ನ ಪೈಲ್ಹೊಟ ಲಡ್ಕಾವ್ನ, ಜಾನ್ವರ್‌ನ ಪೈಲ್ಹೊಟ ಚೆಲ್ಕಾವ್ನ ಇಮ್ಮಸ್ ಯೊ ದೇಖ್ಹ್‌ಮ ಪೈಲ್ಹೋಟು ಥೂತೆ ಅಖ್ಖಾಸ್ನ ಮಾರಿನಾಖಿದಿದೊ. ಇನಖ್ಹಾಜೆ ಪರ್ಖ್ಹೊ ಪೈದಾ ಹುವಾಸ್ತೆ ಪಹಿಲ ಗರಬ್ನ ಹಮೆ ಯೆಹೋವನ ಸಮರ್ಪಣ್‌ ಕರಿರಾಖ್ಯಸ್. ಅದ್ಮಿನ ಪೈದ ಹುಯೂತೆ ಪಹಿಲು ಗರಬ್ ತೋಬಿ ಬದಲ್‌ದೀನ್ ಛೋ಼ಡೈಯೆಸ್” ಕರಿಬೋಲ್ನು. <verse eid="EXO 13:15" /><verse number="16" style="v" sid="EXO 13:16" />ಯೆಹೋವನೆ ಮೋಟಿ ಶಕಥ್ಥಿ ತುಮುನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಛೋ಼ಡಾಯೊತೆ ಖಬರ್‌ನ ತುಮೆ ಖ್ಹಯಾಲ್ಮ ರಾಖಾನಿ ಖ್ಹಣೇದ್‌ನಖ್ಹಾಜೆ ಇನ ತುಮಾರ ಹಾತ್‌ಪರ್‌ಬಿ, ತಾಳ್ವಪರ್ ಯಾದ್‌ನಿ ಪಟ್ಟಿನಿತರಾಬಿ ರ‍್ಹೇವ್ಣು.<verse eid="EXO 13:16" /></para>
  <para style="s">ವಾದ್ಳಾನು ಖಂಬು - ಆಗ್ನು ಖಂಬು</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 13:17" />ಫರೋಹನೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಜಾ಼ವಾನ ಹುಕುಮ್ ದ್ಯವಾಖ್ಹತರ್, ಫಿಲಿಷ್ಟಿವಾಳನು ದೇಖ್ಹ್‌ನು ಮಾರಗ್ ಖನ್ನೆ ರ‍್ಹಿಯುತೋಬಿ ದೇವ್ ಯೊ ವಾಟ್ಮ ಇವ್ಣುನ ಮೋಕ್‌ಲ್ಯೊ ಕೊಯ್ನಿ. ಶನಕತೊ, “ದೇವ್, ಅದ್ಮಿ ಜಂಗ್‌ನ ದೇಖಿನ್ ಘಬ್‌ರೈನ್ ಮನ್ ಫರೈಲಿನ್ ಈಜಿಪ್ಟ್‌ನ ಫಾಚು಼ ಚ಼ಲಿಗಯೂತೊ ಚ಼ಲ್ಯುಜಾಷೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 13:17" /><verse number="18" style="v" sid="EXO 13:18" />ಅಮ್ ಛಾ಼ತೆ ಖ್ಹಾಜೇಥಿ ಯೆಹೋವನೆ ಅದ್ಮಿವ್‌ನ ಲಾಲ್ ದರ‍್ಯಾವ್ನ ಖನ್ನೆಛಾ಼ತೆ ಜ಼ಂಗಳ್‌ಪರ್ ಕರಿ ಪಡೀನ್ ಜಾ಼ವನಿತರ ಕರ‍್ಯೊ. ಕತೋಬಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಜಂಗ್‌ಭೀಡವಾಳ ಹುಯಿನಸ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮಾಥು ನಿಕ್ಳಿನ್ ಆಯು. <verse eid="EXO 13:18" /><verse number="19" style="v" sid="EXO 13:19" />ಆಸ್ ಕಾಹೆತೆ ಯೋಸೇಫನೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ, “ದೇವ್ನೆ ಸಂಕೋಚ್‌ಕೊಂತೆ ತುಮುನ ಬಚಾ಼ಡಿನ್ ಇನ ವಾಗ್ದಾನ್ನ ಚ಼ಲಾವವಾಳು ಹುಯೂತೆಖ್ಹಾಜೆ ತುಮೆ ಜಾ಼ವಾನಿ ವಖ್ಹ್‌ತೆ ಮಾರ ಮುರ‍್ದಾನ ತುಮಾರ ಜೋ಼ಡ್ಮ ಲೀನ್ ಜಾ಼ವ್ಣು” ಕರಿ ಬೋಲಿನ್ ಖ್ಹಚೆಂಬಿ, ಕೋಲ್‌ನಾಮ್ ಕರಾಯೋತೆ ಖ್ಹಾಜೆ ಮೋಶೆನೆ ಯೋಸೆಫನ ಪಿಂಜ಼ರ್‌ನ ಇನಿ ಜೋ಼ಡ್ಮ ಲೀನ್ ಗಯೊ. <verse eid="EXO 13:19" /><verse number="20" style="v" sid="EXO 13:20" />ಇವ್ಣೆ ಸುಕ್ಕೋತಿಥು ಚಾ಼ಲಿನ್ ರೇತ್ನ ಬಲ್ಡಾನ ಕನಾರಿಮ ಛಾ಼ತೆ ಏತಾಮಿಮ ಟೋಳ್‌ಮ ರ‍್ಹಿಯ. <verse eid="EXO 13:20" /><verse number="21" style="v" sid="EXO 13:21" />ಯೆಹೋವನೆ ವ್ಹಾಣಾನಿ ವಖ್ಹತ್‌ಮ ವಾಟ್‌ವತಾಳನ ಖ್ಹಾಜೆ ವಾದ್ಳಾನು ಖಂಬಾಮಾಬಿ, ರಾತ್‌ನಿ ವಖ್ಹತ್‌ಮ ಉಜಾ಼ಳು ದ್ಯವಾನಖ್ಹಾಜೆ ಆಗ್ನು ಖಂಬು ಹುಯಿರ‍್ಹಿನ್ ಯೊ ಚ಼ಲವ್‌ಕರ್ತೊಥೊ. ಆ ಪರಕ್ಮ ಇವ್ಣೆ ರಾತ್ನು ವ್ಹಾಣಾನು ಚಾ಼ಲಿನ್ ಗಯು. <verse eid="EXO 13:21" /><verse number="22" style="v" sid="EXO 13:22" />ವ್ಹಾಣಾನು ವಾದ್ಳಾನು ಖಂಬುಹುಯಿನ್, ರಾತ್ಮ ಆಗ್ನು ಖಂಬುಹುಯಿನ್ ಅದ್ಮಿನ ಮ್ಹೇಲಿನ್ ನಾ ಜೈ಼ನ್ ಹಿಜ್ಜಾ಼ಸ್ ರ‍್ಹೇತೊಥೊ.<verse eid="EXO 13:22" /></para>
  <chapter eid="EXO 13" />
  <chapter number="14" style="c" sid="EXO 14" />
  <para style="s">ಲಾಲ್ ದರ‍್ಯಾವ್ನ ಉಲಾಂಗ್ಯುತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 14:1" />ಯೆಹೋವನೆ ಮೋಶೆನ ಜೋ಼ಡೆ ವಾತೆ ಬೋಲಿನ್ <verse eid="EXO 14:1" /><verse number="2" style="v" sid="EXO 14:2" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಪಾಛು಼ ಫರಿನ್ ಜೈ಼ನ್ ಪೀಹಹೀರೋತ್‌ನು ಪೂರಬ್‌ಭಣಿ ಮಿಗ್ದೋಲ್‌ನಾಬಿ ಲಾಲ್ ದರ‍್ಯಾವ್‌ನಾಬಿ ಬೀಚ್ಮ ಬಾಳ್ಚೆಫೊನ್ನನ ಮ್ಹೋರೆ ಹುಯಿನ್ ರ‍್ಹೇವ್ಣುಕರಿ ಇವ್ಣುನ ಬೋಲ್. ಇನ ಖ್ಹಾಮೆಸ್ ದರ‍್ಯಾವ್ನ ಖನ್ನೆಸ್‌ ಇವ್ಣೆ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 14:2" /><verse number="3" style="v" sid="EXO 14:3" />ಫರೋಹನೆ ಇನ ದೇಖಿನ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಇವ್ಣುನ ವಾಟ್‌ ಛು಼ಕಿಗೈ, ಅಖ್ಖಿ ಬಾಜೂ಼ಬಿ ಜ಼ಂಗಳ್ ಇವ್ಣುನ ಮೂಚೈ಼ರ‍್ಹುಸ್’ ಕರಿ ಲ್ಹಾವಸ್. <verse eid="EXO 14:3" /><verse number="4" style="v" sid="EXO 14:4" />ಮೇ ಫರೋಹನ ದಿಲ್ನ ಕಠಣ್ ಕರಾವವಾಳೊ ಛೂ಼ತೆಖ್ಹಾಜೆ ಯೊ ಇವ್ಣುನ ಪೀಠೆಕರಿ ಆವ್‌ಶೆ; ತದೆ ಮೇ ಫರೋಹಮಾಬಿ ಇನ ಶಿಪಾಯ್‌ಮಾಬಿ ಮಹಿಮೆ ಲೀಶ್‌ ‘ಮೇಸ್ ಯೆಹೋವ’ ಕರಿ ಈಜಿಪ್ಟ್‌ವಾಳನ ಮಾಲುಮ್ ಪಡ್‌ಶೆ” ಕರಿಬೋಲ್ಯೊ. ಯೆಹೋವನೆ ಹುಕುಮ್ ದಿದೋತೆ ತಿಮ್ಮಸ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಚಾ಼ಲಿಲಿದು. <verse eid="EXO 14:4" /><verse number="5" style="v" sid="EXO 14:5" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಮಿಲೈನ್ ಚ಼ಲಿಗಯು ಕರಿ ಬೋಲಾನು ಪುಕಾರೊ ಈಜಿಪ್ಟ್‌ನೊ ರಾಜ಼ ಹುಯಿರ‍್ಹೋತೆ ಫರೋಹನ ಮಾಲುಮ್ ಪಡಾನಿವಖ್ಹ್‌ತೆ, ಇವ್ಣಿ ವಿಚಾರ್‌ಮ ಫರೋಹನ ಅಜು಼ ಇನ ಅದಿಕಾರಿವಾಳನು ದಿಲ್‌ ಇವ್ಣುನ ವಿರೋದ್ ಹುಯಿನ್ ಕಠಣ್ ಹುಯ್ಗು. ಇವ್ಣೆ, “ಆ ಶಾತ್ ಅಪ್ಣೆ ಕರ‍್ಯಾತೆ? ಅಪ್ಣುನ ಚಾ಼ಕ್ರಿ ಕರಾವಾಳ ಹುಯಿರ‍್ಹಥಾತೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ನಿಕ್ಳಿಜಾ಼ವಾನ ಮ್ಹೇಲಿದಿದಾನಿ” ಕರಿ ಲಾಝ್ಯ. <verse eid="EXO 14:5" /><verse number="6" style="v" sid="EXO 14:6" />ತದೆ ಫರೋಹಾನೆ ಇನಿ ರಥ್‌ನಿ ತಾಖತ್ನ ತಯಾರ್ ಕರಿಲಿನ್ ಇನ ಶಿಪಾಯ್ನ ಜೋ಼ಡ್ಮ ನಿಕ್‌ಳ್ಯೊ. <verse eid="EXO 14:6" /><verse number="7" style="v" sid="EXO 14:7" />ಶ್ರೇಷ್ಠರ‍್ಹಾವನು ಛೊ಼ಖ್ಹೊ ರಥ್‌ಖ್ಹಾರುಬಿ, ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನು ಖ್ಹಾರುಸ್ ರಥ್ ಖ್ಹಾರೂಬಿ ಲೀನ್ ಇನ ಪೀಠೆಗಯೊ. ಯೊ ಅಖ್ಖಾಸ್ ರಥ್ ಖ್ಹಾರಾಮ ಅದಿಕಾರಿಖ್ಹಾರನಬಿ ಬುಲೈಲಿದೊ. <verse eid="EXO 14:7" /><verse number="8" style="v" sid="EXO 14:8" />ಯೆಹೋವ ದೇವ್ನೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ನೊ ರಾಜ಼ ಹುಯಿರ‍್ಹೋತೆ ಫರೋಹನ ದಿಲ್ನ ಮೊಂಡ್‌ ಕರಾಯೊತೆಖ್ಹಾಜೆ ಯೊ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಪೀಠೆ ರಪೇಟಿಲಿನ್‌ ಗಯೊ. ಕತೋಬಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಜಂಗ್‌ನ ತಯಾರ್ ಹುಯಿನ್ ನಿಕ್ಳಿನ್ ಐರ‍್ಹುಥು. <verse eid="EXO 14:8" /><verse number="9" style="v" sid="EXO 14:9" />ಈಜಿಪ್ಟ್‌ವಾಳು ಕತೊ ಫರೋಹನು ಘೋಡಖ್ಹಾರುಬಿ, ರಥ್ ಖ್ಹಾರುಬಿ, ಇನು ಹತ್ತಿ ಚ಼ಲಾವವಾಳುಬಿ, ಶಿಪಾಯ್ ಖ್ಹಾರೂಬಿ, ಇವ್ಣ ಪೀಠೆ ನಿಕ್ಳಿನ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಪೀಹಹೀರೋತ್‌ನ ಖನ್ನೆ ಬಾಳ್ಚೆಫೊನ್ನ ಮ್ಹೋರೆ ಹುಯಿನ್ ದರ‍್ಯಾವ್ನಿ ಕನಾರಿಮ ಉತ್ರಿ ಆವಾನಿವಖ್ಹ್‌ತೆಸ್ ಇವ್ಣ ಖನ್ನೆ ಆಯು. <verse eid="EXO 14:9" /><verse number="10" style="v" sid="EXO 14:10" />ಫರೋಹನೆ ಖನ್ನೆ ಅವುಕರಾನಿ ವಖ್ಹ್‌ತೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಇವ್ಣ ಪೀಠೆ ನಿಕ್‌ಳಿ ಐರ‍್ಹೂತೆ ಈಜಿಪ್ಟ್‌ವಾಳನ ದೇಖಿನ್ ಘಣು ಡರಿನ್ ರೊವ್ತು ಹುಯಿನ್ ಯೆಹೋವನ ಮದತ್‌ನಖ್ಹಾಜೆ ಬಿಂತಿಕರ‍್ಯು. <verse eid="EXO 14:10" /><verse number="11" style="v" sid="EXO 14:11" />ಇವ್ಣೆ ಮೋಶೆನ, “ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಮಖ್ಹಾಣ್ಯು ಕೊಯ್ನಿಕರಿ ಜ಼ಂಗಳ್‌ಮ ಮರಾದೆ ಕರಿ ಹಮುನ ಹಜ್ಜಾ಼ ಶನ ಬುಲೈಲಿನ್ ಆಯೊ? ಶನ ತು ಹಮುನ ಅಮ್ನಿ ಪರಕ್‌ ಕರೀನ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಬುಲೈಲಿನ್ ಆಯೊ? <verse eid="EXO 14:11" /><verse number="12" style="v" sid="EXO 14:12" />ಹಮೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ರ‍್ಹವಾನಿ ವಖ್ಹ್‌ತೇಸ್, ‘ತೂ ಹಮಾರಿ ಫಿಕರ್‌ನ ನಕೊ ಆವ್. ಹಮೆ ಈಜಿಪ್ಟ್‌ವಾಳನ ಚಾ಼ಕ್ರಿ ಕರಾವಾಳ ಹುಯಿನಸ್ ರ‍್ಹಿಯೇಸ್’ ಕರಿ ತುನ ಬೋಲ್ಯಕೊಯ್ನಿಕಿಶು. ಹಮೆ ಜ಼ಂಗಳ್‌ಮ ಮರಾಥೀಬಿ ಈಜಿಪ್ಟ್‌ವಾಳನ ಗುಲಾಮ್ ಹುಯಿರ‍್ಹವಾನುಸ್ ಊಚೂ಼ನಿ” ಕರಿಬೋಲ್ಯು. <verse eid="EXO 14:12" /><verse number="13" style="v" sid="EXO 14:13" />ಕತೋಬಿ ಮೋಶೆ ಯೊ ಅದ್ಮಿನ, “ತುಮೆ ಡರೊನಕೊ. ಖ್ಹಪೇಥಿ ಭೀರಾವವಾಳ ಹುಯಿನ್ ಯೆಹೋವ ಆ ವಖ್ಹತ್ ತುಮುನ ಬಚಾಡನಿ ಪರಕ್ನ ದೇಖೊ. ತುಮೆ ಆ ವಖ್ಹತ್ ದೇಖಾನು ಈಜಿಪ್ಟ್‌ವಾಳನ ಬಿಜು಼ ಕೆದೇಬಿ ಕೋದೇಕ್‌ಷುನಿ. <verse eid="EXO 14:13" /><verse number="14" style="v" sid="EXO 14:14" />ಯೆಹೋವಾಸ್ ತುಮಾರ ಖ್ಹಾಜೆ ಜಂಗ್ ಭೀಡ್‌ಷೆ. ತುಮೆ ಚುಪ್ಕೆ ರ‍್ಹವೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 14:14" /><verse number="15" style="v" sid="EXO 14:15" />ತದೆ ಯೆಹೋವ ಮೋಶೆನ ಶಾತ್ ಬೋಲ್ಯೊಕತೊ, “ತೂ ಮನ ಬಿಂತಿಕರಾನು ಶಾತ್? ಅಗ್ಗಳ್ ಚಾ಼ಲ್‌ಕರಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಬೋಲ್. <verse eid="EXO 14:15" /><verse number="16" style="v" sid="EXO 14:16" />ತೂ ತಾರ ಲಠ್ಠಾನ ಪಾಡಿನ್ ದರ‍್ಯಾವ್‌ಭಣಿ ಹಾತ್ ಕರಿನ್ ಇನ ಬೇಭಾಗ್ ಕರ್‌, ತದೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ದರ‍್ಯಾವ್ನ ಇಚ಼್‌ಮ ಖ್ಹುಕ್ಕಿ ಜ಼ಮಿನ್‌ಪರ್ ಚಾ಼ಲಿನ್ ಜಾಷೆ. <verse eid="EXO 14:16" /><verse number="17" style="v" sid="EXO 14:17" />ಮೇತೋಬಿ ಈಜಿಪ್ಟ್‌ವಾಳನ ದಿಲ್ನ ಮೊಂಡ್‌ ಕರಿಶ್. ಇವ್ಣೆ ಅವ್ಣುನ ಪೀಠೆ ಕರ್ಶೆ. ತದೆ ಮೇ ಫರೋಹನ ಉಪ್ಪರ್‌ಬಿ, ಇನ ತಮಾಮ್‌ ಶಿಪಾಯ್‌ವಾಳನ ಉಪ್ಪರ್‌ಬಿ, ರಥ್‌ಖ್ಹಾರನ ಉಪ್ಪರ್‌ಬಿ ಅಜು಼ ಘೋಡಾವ್ನ ಉಪ್ಪರ್‌ಬಿ ಜೂತಿನ್ ಖ್ಹರೈಲಿಷ್. <verse eid="EXO 14:17" /><verse number="18" style="v" sid="EXO 14:18" />ಮೇ ಫರೋಹಮಾಬಿ ಇನ ರಥ್ ಖ್ಹಾರಮಾಬಿ, ಘೋಡಾವ್‌ಮಾಬಿ ಖ್ಹರೈಲ್ಯವಾನ ವಾರ್ ಮೇಸ್ ಯೆಹೋವಕರಿ ಬೋಲಾನು ಈಜಿಪ್ಟ್‌ವಾಳು ಮಾಲುಮ್ ಕರಿಲಿಷೆ” ಕರಿಬೋಲ್ಯೊ.<verse eid="EXO 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 14:19" />ತದೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ದಂಡ್‌ನ ಖ್ಹಾಮೆ ಒಳೆಜಾ಼ತೊಥೋತೆ ದೇವ್ನೊದೂತ ಇನಿ ಝ಼ಗೋನ ಮ್ಹೇಲಿನ್ ಇವ್ಣ ಪೀಛೆ ಆಯೊ. ಇವ್ಣ ಅಗ್ಗಳ್ ವಳಿಜಾ಼ತುಥೂತೆ ವಾದ್ಳಾನು ಖಂಬು ಹಿಜ್ಜಾ಼ಥು ಅಯಿನ್ ಇವ್ಣ ಪೀಠೆ ಭೀರಿಗಯು. <verse eid="EXO 14:19" /><verse number="20" style="v" sid="EXO 14:20" />ಯೊ ವಾದ್ಳಾನು ಖಂಬು ಈಜಿಪ್ಟ್‌ವಾಳನು ಇಟಾರಮಾಬಿ ಇಸ್ರಾಯೇಲ್ನ ಇಟಾರನ ಬೀಚ್ಮ ಆಯು. ಯೊ ಈಜಿಪ್ಟ್‌ವಾಳನ ಅಂಧಾರುಬಿ, ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ರಾತ್ಮ ಉಜಾ಼ಳನಬಿ ದಿದೂತೆಖ್ಹಾಜೆ ಯೊ ರಾತ್‌ಅಖ್ಖು ಏಕ್‌ಜ಼ಣು ಖನ್ನೆ ಆವಾನ ಕೋಹುಯುನಿ. <verse eid="EXO 14:20" /><verse number="21" style="v" sid="EXO 14:21" />ಮೋಶೆ ದರ‍್ಯಾವ್‌ನಪರ್ ಹಾತ್‌ಕರಾಖ್ಹತರ್, ಯೆಹೋವನೆ ಯೊ ರಾತ್‌ಅಖ್ಖು ದನ್ ನಿಕ್‌ಳ ಭಣೀಥು ಜಾ಼ಖ್ಹತ್ ವಹಿರೊ ವಾಗನಿತರ ಕರಿನ್ ದರ‍್ಯಾವ್ನ ಪಾಣಿನ ಎಕ್ ಬಾಜು಼ಮ ಧಕೇಲಿನ್ ಇನ ತಳ್‌ಮ ಖ್ಹುಕ್ಕಿ ಜ಼ಮೀನ್ ದೆಖಾವನಿತರ ಕರ‍್ಯೊ. ಪಾಣಿ ಬೇ ಭಾಗ್‌ ಹುಯು. <verse eid="EXO 14:21" /><verse number="22" style="v" sid="EXO 14:22" />ಅಮ್‌ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ದರ‍್ಯಾವ್ನ ಇಚ಼್‌ಮ ಖ್ಹುಕ್ಕಿ ಜ಼ಮಿನ್‌ಪರ್ ಚಾ಼ಲಿನ್ ಗಯು. ಪಾಣಿ ಇವ್ಣ ಡಾವಿಬಾಜು಼ ಅಜು಼ ಖಾವಿಬಾಜು಼ಮ ಭೀತ್‌ನಿತರ ಭೀರಿಗಯು. <verse eid="EXO 14:22" /><verse number="23" style="v" sid="EXO 14:23" />ಈಜಿಪ್ಟ್‌ವಾಳು ಕತೊ ಫರೋಹನು ಘೋಡಾವ್ ಖ್ಹಾರುಬಿ, ರಥ್ ಖ್ಹಾರೂಬಿ, ಹತ್ತಿ ಚ಼ಲಾವವಾಳುಬಿ ಇವ್ಣುನ ನಖ್ಹಾಡ್‌ತು ಪೀಠೆ ಕರ್ತುಹುಯಿನ್ ಇವ್ಣ ಪೀಠೆಸ್ ದರ‍್ಯಾವ್‌ಮ ಆಯು. <verse eid="EXO 14:23" /><verse number="24" style="v" sid="EXO 14:24" />ವ್ಹಾಣ್‌ಖ್ಹತ್‌ರೆ ಯೆಹೋವ ಯೊ ಆಗ್ನು ಖಂಬು ಅಜು಼ ವಾದ್ಳಾನ ಖಂಬಾಮಾಥು ಈಜಿಪ್ಟ್‌ವಾಳನ ದಂಡ್‌ಭಣಿ ದೇಖಿನ್ ಇವ್ಣಾಮ ಕಲಾವ್ಣಿ ಕರಾಯೊ. <verse eid="EXO 14:24" /><verse number="25" style="v" sid="EXO 14:25" />ಯೆಹೋವ ಇವ್ಣ ರಥ್‌ಖ್ಹಾರನು ಚ಼ಕ್ಕರ್‌ನ ಕಾಡಿನಾಖಿ ದಿದೊತೆಖ್ಹಾಜೆ, ಈಜಿಪ್ಟ್‌ವಾಳು ಜಾ಼ಖ್ಹತ್ ವದೇಖ್ಹ್‌ಥಿ ರಥ್ ಅಖ್ಖಾನ ಲೀನ್ ಜಾ಼ವ್ಣುಪಡ್ಯು. ತದೆ ಈಜಿಪ್ಟ್‌ವಾಳು “ಅಪ್ಣೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಖ್ಹಾಮೆ ಭಿರಾವನ ಕೊಉಷೇನಿ, ಮಿಲೈನ್ ಜ಼ಯ್ಯೆ ಯೆಹೋವ ಇವ್ಣಖ್ಹಾಜೆ ಅಪ್ಣಿ ವಿರೋದ್ ಜಂಗ್ ಭೀಡುಕರಾಸ್” ಕರಿ ಬೋಲಿಲಿದು. <verse eid="EXO 14:25" /><verse number="26" style="v" sid="EXO 14:26" />ಎತ್ರಾಮ ಯೆಹೋವನೆ ಮೋಶೆನ, “ದರ‍್ಯಾವ್‌ನಪರ್ ತಾರೊ ಹಾತ್‌ ಪಾಡ್, ತದೆ ಇನು ಪಾಣಿ ಪಹಿಲೆನಿತರಸ್ ಅಯಿನ್ ಈಜಿಪ್ಟ್‌ವಾಳನಬಿ, ಇವ್ಣ ರಥ್‌ಖ್ಹಾರನಬಿ, ಹತ್ತಿ ಚ಼ಲಾವವಾಳನಬಿ ಡುಬೈನಾಖಿದಿಷೆ” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 14:26" /><verse number="27" style="v" sid="EXO 14:27" />ಮೋಶೆ ದರ‍್ಯಾವ್‌ನಪರ್ ಹಾತ್ ಪಾಡ್ಯೊ.ಅಜು಼ ವ್ಹಾಣ್‌ಖ್ಹತ್ರೇಸ್ ದರ‍್ಯಾವ್ನು ಪಾಣಿ ಪಹಿಲೆನಿತರಸ್ ಭರೈಗಯು. ಈಜಿಪ್ಟ್‌ವಾಳು ಛು಼ಕಿನ್ ನಾಶಿ ಜಾ಼ವಾನ ಕರ‍್ಯು. ಕತೋಬಿ ಯೆಹೋವ ಈಜಿಪ್ಟ್‌ವಾಳನ ದರ‍್ಯಾವ್‌ಮ ಧಕೇಲಿದಿದೊ. <verse eid="EXO 14:27" /><verse number="28" style="v" sid="EXO 14:28" />ಪಾಣಿ ಪಹಿಲೆನಿತರಸ್ ಅಯಿನ್ ಯೊ ರಥ್‌ಖ್ಹಾರುಬಿ, ಹತ್ತಿ ಚ಼ಲಾವವಾಳನಬಿ ಇವ್ಣ ಪೀಠೆ ದರ‍್ಯಾವ್‌ಮ ಗಯುಥೂತೆ ಫರೋಹನ್ನ ಶಿಪಾಯ್‌ವಾಳನಬಿ ಡುಬೈನಾಖಿದಿದು, ಇನಾಮ ಏಕ್‌ತೋಬಿ ಬಚ್ಯುಕೊಯ್ನಿ. <verse eid="EXO 14:28" /><verse number="29" style="v" sid="EXO 14:29" />ಕತೋಬಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ದರ‍್ಯಾವ್‌ಮ ಖ್ಹುಕ್ಕಿ ಜ಼ಮಿನ್‌ಪರಸ್ ಚಾ಼ಲಿಗಯು. ಪಾಣಿ ಇವ್ಣ ಡಾವಿ ಬಾಜು಼ ಅಜು಼ ಖಾವಿ ಬಾಜೂ಼ಮ ಭೀತ್‌ನಿತರ ಭಿಯೂಥು. <verse eid="EXO 14:29" /><verse number="30" style="v" sid="EXO 14:30" />ಯೊ ದನ್ಮ ಯೆಹೋವನೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಈಜಿಪ್ಟ್‌ವಾಳನ ಹಾತೇಥಿ ಬಚಾಡ್ಯೊ. ಈಜಿಪ್ಟ್‌ವಾಳು ಮರಿನ್ ದರ‍್ಯಾವ್‍ನಿ ಕನಾರಿಮ ಪಡಿರ‍್ಹವಾನು ಇಸ್ರಾಯೇಲ್‌ವಾಳು ದೇಖ್ಯು. <verse eid="EXO 14:30" /><verse number="31" style="v" sid="EXO 14:31" />ಯೆಹೋವನೆ ಈಜಿಪ್ಟ್‌ವಾಳಮ ಕರ‍್ಯೊತೆ ಶಕತ್ನ ಕಾಮ್ನ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಯೆಹೋವನ ದೇಖಿ ಡರಿನ್‌ ಇನಾಮಬಿ ಇನೊ ಸೇವಕ್‌ಹುಯಿರ‍್ಹೊತೆ ಮೋಶೆಮಾಬಿ ವಿಶ್ವಾಸ್ ರಾಖ್ಯು.<verse eid="EXO 14:31" /></para>
  <chapter eid="EXO 14" />
  <chapter number="15" style="c" sid="EXO 15" />
  <para style="s">ಮೋಶೆನು ಗೀದ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 15:1" />ತದೆ ಮೋಶೆಬಿ, ಇಸ್ರಾಯೇಲ್‌ವಾಳುಬಿ ಯೆಹೋವನ ಸ್ತುತಿಕರಾನ ಖ್ಹಾಜೆ ಆ ಗೀದ್‌ನ ಬೋಲ್ಯು “ಯೆಹೋವನ ಧನ್ಯವಾದ್‌ ಕರಾನು ಗೀದ್‌ ಬೋಲಿಯೆ; ಯೊ ಮಹಾನ್ ಜಯ್‍ಕಾರ್ ಲಿದೊಹುಯೊ. ಘೋಡಾವ್‌ಖ್ಹಾರನ ಅಜು಼ ಹತ್ತಿ ಚ಼ಲಾವವಾಳನ ದರ‍್ಯಾವ್‌ಮ ಖಂಕ್‌ರೈನ್ ನಾಶ್ ಕರಿರಾಖ್ಯೊಸ್. <verse eid="EXO 15:1" /><verse number="2" style="v" sid="EXO 15:2" />ಮಾರಿ ತಾಖತ್‌ಬಿ ಗೀದ್‌ಬಿ ಯೆಹೋವಾಸ್, ಇನೇಥಿ ಮನ ರಕ್ಷಣೆ ಮಳ್ಯು. ಅಪ್ಣೊ ದೇವ್ ಯೋಸ್. ಇನ ಸ್ತುತಿ ಕರುಸ್, ಯೋಸ್ ಮಾರೊ ಬಾನೊ ದೇವ್ , ಇನಿ ಮರ‍್ಯಾದಿನಖ್ಹಾಜೆ ಸ್ತುತಿ ಕರೇಸ್. <verse eid="EXO 15:2" /><verse number="3" style="v" sid="EXO 15:3" />ಯೆಹೋವ ಜಂಗ್‌ನೊ ವೀರ್” ಯೆಹೋವಕರಿ ಬೋಲಾನು ಇನು ನಾಮ್ ಹುಯಿರ‍್ಹುಸ್. <verse eid="EXO 15:3" /><verse number="4" style="v" sid="EXO 15:4" />“ಯೊ ಫರೋಹನ ರಥ್‌ಖ್ಹಾರನಬಿ, ಶಿಪಾಯ್‌ಖ್ಹಾರನಾಬಿ ದರ‍್ಯಾವ್‌ಮ ಖಂಕ್‌ರೈನಾಖ್ಯೊ. ಫರೋಹನ ಮಹಾನ್ ವೀರರ್‌ನ ಲಾಲ್ ದರ‍್ಯಾವ್‌ಮ ಡುಬೈನಾಖ್ಯೊ. <verse eid="EXO 15:4" /><verse number="5" style="v" sid="EXO 15:5" />ಗಧಾರ್‌ನೊ ದರ‍್ಯಾವ್ ಇವ್ಣುನ ಮೂಚಿನಾಖ್ಯು”. ಇವ್ಣೆ ಬಂಡಾನಿತರ ದರ‍್ಯಾವ್ನು ಅಂತ್‌ಮ ಮಳಿಗು. <verse eid="EXO 15:5" /><verse number="6" style="v" sid="EXO 15:6" />“ಯೆಹೋವ ದೇವ್, ತಾರೊ ಖಾವ ಹಾತ್ಮನಿ ಶಕತ್ ಕೆತ್ರೆಕ್ಕಿ ಮಹಾನ್ ಹುಯಿರ‍್ಹುಸ್. ಯೆಹೋವ ದೇವ್, ತಾರೊ ಖಾವೊ ಹಾತ್ ವಹೇರ‍್ಯಾನ ಪುಡಿ-ಪುಡಿ ಕರಿನಾಖಸ್”. <verse eid="EXO 15:6" /><verse number="7" style="v" sid="EXO 15:7" />ತೂ ಜಾ಼ಖ್ಹತ್ ಊಚೊ಼ ಹುಯಿನ್ ತಾರ ಖ್ಹಾಮೆ ಭೀರಾವವಾಳನ ಖಂಕ್‌ರೈರಾಖ್ಯೊಸ್, ತಾರು ಇರಾದನಿ ಆಗ್ ನಿಕ್ಳಿನ್ ಇವ್ಣುನ ಖ್ಹುಕೈರ‍್ಹವಾನ ಘಾಖ್ಹ್‌ನಿತರ ಬಾಳಿನ್ ರಾಕ್ ಕರಿರಾಖ್ಯುಸ್. <verse eid="EXO 15:7" /><verse number="8" style="v" sid="EXO 15:8" />ತಾರ ನಾಕೋಳಿನ ದಮ್‌ಥಿ ದರ‍್ಯಾವ್ನು ಪಾಣಿ ಎಕ್ಟುಹುಯು; ವ್ಹೆಕ್‌ಳೊ ಭೀತ್‌ನಿ ಘೋಣಿ ಭೀರಿಗಯು; ದರ‍್ಯಾವ್ನ ಗಧಾರ‍್ನ ಮಹಿನು ಪಾಣಿ ಘಟ್‌ಹುಯ್ಗು. <verse eid="EXO 15:8" /><verse number="9" style="v" sid="EXO 15:9" />ವಹೇರ‍್ಯು, ‘ಮೇ ಅವ್ಣ ಪೀಠೆ ಜೈ಼ನ್ ಧರಿಲಿಶ್. ಇವ್ಣ ಶೊತ್‌ನ ಛಿನೈನ್ ವಾಟಪಾಡಿಲಿಶ್‌; ಇವ್ಣಾಮ ಹಮಾರಿ ಹರಖ್ಹ್‌ನ ತೋಡಿಲಿಶು. ಮೇ ತಲ್ವಾರ್‌ನ ಧರಿನ್; ಶಕಥ್ಥಿ ಇವ್ಣುನ ಸಂಹಾರ್ ಕರಿಶ್ ಕರಿ’ ಬೋಲಿನ್ ವಾತೆ ಬೋಲಿ ಲೆವ್‌ಕರ್ತುಥು. <verse eid="EXO 15:9" /><verse number="10" style="v" sid="EXO 15:10" />ಕತೋಬಿ ತೂ ವಹಿರಾನ ಫೂಕಾಖ್ಹತರ್, ದರ‍್ಯಾವ್ ಇವ್ಣುನ ಮೂಚಿನಾಖ್ಯು; ಇವ್ಣೆ ಮೋಟ ದರ‍್ಯಾವ್ನ ಮಹಿ ಶೀಸ್‌ನು ಚಂಡಾನಿತರ ಡುಬಿಗಯು. <verse eid="EXO 15:10" /><verse number="11" style="v" sid="EXO 15:11" />ಯೆಹೋವ ದೇವ್ ಖ್ಹಾರಾಮ ತುನ ಸಮಾನ್ ಕೋಣ್? ತಾರಿನಿಘೋಣಿ ಅದ್ಬುತ್‌ಬಿ ಪರಿಶುದ್‌ಮ ಊಚೊ಼ ಹುಯಿರೋತೆ ಕೋಣ್? ತಾರಿನಿಘೋಣಿ ವೀರ್‌ವ್ಹೆತಾಳಿಬಿ ಅದ್ಬುತ್‌ಬಿ ಮಹಾನ್ ಕಾಮ್‌ನ ಚ಼ಲಾವವಾಳೊ ಹುಯಿರ‍್ಹೋತೆ ತುನ ಸಮಾನ್ ಕೋಣ್ ಛಾ಼? <verse eid="EXO 15:11" /><verse number="12" style="v" sid="EXO 15:12" />ತೂ ತಾರ ಖಾವ ಹಾತ್ನ ಪಾಡಖ್ಹತರ್, ಜ಼ಮೀನ್ ಮ್ಹೋಡು ಮ್ಹೇಲಿನ್ ವಹೇರ‍್ಯಾವ್ನ ಗಳಿಲಿದೂನಿ. <verse eid="EXO 15:12" /><verse number="13" style="v" sid="EXO 15:13" />ತಾರು ಒಪ್ಪಂದಾನು ಪ್ಯಾರ್‌ಮ ತೂ ತಾರ ಲೋಕ್ನ ಛುಟ್ಕಾರ್ ಕರಿರಾಖ್ಯೊಸ್. ತಾರು ಶಕಥ್ಥಿ ಇವ್ಣುನ ತೂ ಜಿವ್ಣುಕರಾನ ಪರಿಶುದ್ ಘರ್‌ಮ ಚ಼ಲೈರಾಖ್ಯೊಸ್. <verse eid="EXO 15:13" /><verse number="14" style="v" sid="EXO 15:14" />ಜ಼ಗ್‌ಜಾ಼ತ್‌ಖ್ಹಾರು ಅನ ಖ್ಹಮ್‌ಜಿನ್ ಕಾಪ್‌ಶೆ. ಫಿಲಿಷ್ಟಿಯಮ ಜಿವ್ಣು ಕರಾವಳು ಡರ್‌ಥಿ ಭರೈಜಾ಼ಶೆ. <verse eid="EXO 15:14" /><verse number="15" style="v" sid="EXO 15:15" />ಎದೋಮ್ಯವಾಳನು ಗಲ್‌ಢಖ್ಹಾರು ಡರಿಜಾಷೆ; ಮೋವಾಬ್ಯವಾಳನು ಶಿಪಾಯ್‌ಖ್ಹಾರು ಕಾಪ್ಷೆ; ಕಾನಾನ್‌ವಾಳು ಹಿಮ್ಮತ್‌ ಕಾಡಿಲಿಷೆ. <verse eid="EXO 15:15" /><verse number="16" style="v" sid="EXO 15:16" />ಡರ್‌ಬಿ, ಝ಼ಪಕ್ಣೀಬಿ ಇವ್ಣುನ ಉಷೆ. ತಾರಿ ಭುಜ಼್‌ನಿ ತಾಖತ್‌ನಿ ಶಕಥ್ಥಿ ಇವ್ಣೆ ಬಂಡಾನಿತರ ಠರ್ಕಿಜಾ಼ಷೆ. ಎತ್ರಾಮ ಯೆಹೋವ, ತೂ ಬಚಾ಼ಡ್ಯೊತೆ ತಾರು ಅದ್ಮಿಖ್ಹಾರು ಉಲಾಂಗಿ ಜೈ಼ನ್ ದೇಖ್ಹ್‌ಮ ಮಳ್‌ಷೆ. <verse eid="EXO 15:16" /><verse number="17" style="v" sid="EXO 15:17" />ತೂ ಇವ್ಣುನ ತಾರು ಶೊಂತ್ ದೇಖ್ಹ್‌ ಹುಯಿರ‍್ಹುತೆ ಪಹಾಡ್‌ನ ಮುಲಕ್‌ಮ ಲೈನ್‌ ತಾಖತ್‌ಕರೀಷ್, ಯೆಹೋವ, ತೂ ತಾರು ಶೊಂತ್ ಘರ್‌ನಖ್ಹಾಜೆ ಚೂ಼ಣಿರಾಖ್ಯೊತೆ ಝ಼ಗೊ ಲಗೂಬಿ ಪ್ರಭು, ತೂ ತಾರಖ್ಹಾಜೆ ತಯಾರ್ ಕರಿರಾಖ್ಯೊತೆ ಪವಿತ್ರ ಪರ್ಭತ್‌ಲಗೂಬಿ ಇವ್ಣುನ ಬುಲೈಲೀನ್ ಅಯಿಶ್. <verse eid="EXO 15:17" /><verse number="18" style="v" sid="EXO 15:18" />ಯೆಹೋವ ಜ಼ಗ್‌ಜ಼಼ಗ್‌ಮಾಬಿ ರಾಜ಼ಹುಯಿನ್ ಚ಼ಲಾವವಾಳೊ.”<verse eid="EXO 15:18" /></para>
  <para style="s">ಮಿರ್ಯಾಮನು ಗೀದ್‌</para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 15:19" />ಫರೋಹಾನು ಘೋಡಾವ್‌ಖ್ಹಾರು, ರಥ್‌ಖ್ಹಾರುಬಿ, ಹತ್ತಿ ಚ಼ಲಾವವಾಳುಬಿ ದರ‍್ಯಾವ್ನ ಮಹಿ ಆವಖ್ಹತರ್ ಯೆಹೋವ ದರ‍್ಯಾವ್ನ ಪಾಣಿನ ಇವ್ಣಪರ್ ಪಾಛೊ಼ ಲೀಅಯಿನ್ ಡುಬೈನಾಖ್ಯೊ. ಕತೋಬಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳುತೋಬಿ ದರ‍್ಯಾವ್ನು ಇಚ಼್‌ಮಾನು ಖ್ಹುಕ್ಕಿ ಜ಼ಮಿನ್‌ಪರ್ ಉಲಾಂಗಿ ಗಯು. <verse eid="EXO 15:19" /><verse number="20" style="v" sid="EXO 15:20" />ತದೆ ಪ್ರವಾದಿನಿ ಹುಯಿರ‍್ಹಿಥೀತೆ ಆರೋನನಿ ಭೇನ್ ಮಿರ್ಯಾಮ ಹಾತ್ಮ ದಮ್‌ಡಿ ಪಾಡಿಲಿದಿ. ತಯೇಡಖ್ಹಾರುಬಿ ಹಾತ್ಮ ದಮ್‌ಡಿ ಧರಿನ್ ಖೇಲ್‌ತಿ ಹುಯಿನ್ ಯೊ ಹೈರಿತೆನ ಪೀಛೆ ಗಯು. <verse eid="EXO 15:20" /><verse number="21" style="v" sid="EXO 15:21" />ಮಿರ್ಯಾಮ ಇವ್ಣುನ ಅಮ್ ಗೀದ್‌ ಬೋಲಿ “ಯೆಹೋವನ ಗೀದ್‌ ಬೋಲೊ. ಯೊ ಮಹಾ ಊಚೊ಼ ಹುಯಿರ‍್ಹಾವಳೊ ದೇವ್‌ ಹುಯಿರ‍್ಹೊಸ್. ಘೋಡಾವ್‌ನಬಿ, ಹತ್ತಿ ಚ಼ಲಾವವಾಳನಬಿ ದರ‍್ಯಾವ್‌ಮ ಡುಬೈನ್ ನಾಶ್‌ಕರ‍್ಯೊ.”<verse eid="EXO 15:21" /></para>
  <para style="s">ಕಡು ಪಾಣಿ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 15:22" />ಬಾದ್ಮ ಮೋಶೆನೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಲಾಲ್ ದರ‍್ಯಾವ್‌ಮಾಕರಿ ಚ಼ಲಾಯೊ. ಇವ್ಣೆ ಶೂರ್ ಜ಼ಂಗಳ್‌ಮ ತೀನ್ ದನ್ ಪಾಣಿಸ್ ಕೊಂತೆ ಚ಼ಲಾಯು. <verse eid="EXO 15:22" /><verse number="23" style="v" sid="EXO 15:23" />ಇನಕೇಡೆಥು ಇವ್ಣೆ ಮಾರಾ ಕರಿ ಝ಼ಗೋಕನ ಆಯು. ಕತೋಬಿ ಯೊ ಝ಼ಗೋನು ಪಾಣಿ ಕಡುಥೂತೆಖ್ಹಾಜೆ ಇವ್ಣುನ ಇನ ಪಿಯಾನ ಕೊಹುಯುನಿ. ಇನಖ್ಹಾಜೇಸ್ ಯೊ ಝ಼ಗೋನ ಮಾರಾ ಕರಿ ನಾಮ್ ಪಡ್ಯು. <verse eid="EXO 15:23" /><verse number="24" style="v" sid="EXO 15:24" />ಅದ್ಮಿಖ್ಹಾರು ಮೋಶೆನ, “ಹಮೆ ಶಾತ್ ಪೀಣು?” ಕರಿ ಇನ ವಿರೋದ್‌ಥಿ ಭಣ್‌ಕ್ಯು. <verse eid="EXO 15:24" /><verse number="25" style="v" sid="EXO 15:25" />ಮೋಶೆ ಯೆಹೋವನ ಪ್ರಾರ್ಥನೆ ಕರ‍್ಯೊ. ತದೆ ಯೆಹೋವನೆ ಇನ ಎಕ್ ಝಾ಼ಡಾನ ವತಾಳ್ಯೊ. ಇನೆ ಯೊ ಪಾಣಿಮ ನಾಖಖ್ಹತರ್, ಪಾಣಿ ಮಿಠ್ಠುಹುಯಿಗು. ಹಿಜ್ಜಾ಼ ಯೆಹೋವನೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಖ್ಹಾಜೆ ಎಕ್ ನಿಯಮ್ ಕರಿನ್ ಇವ್ಣುನ ತರೀಪ್ಷಕರ‍್ಯೊ. <verse eid="EXO 15:25" /><verse number="26" style="v" sid="EXO 15:26" />ಯೆಹೋವನೆ ಇವ್ಣುನ, “ತುಮೆ ತುಮಾರ ದೇವ್‌ಹುಯಿರೋತೆ ಯೆಹೋವನಿ ವಾತ್ನ ಧ್ಯಾನ್‌ಥಿ ಖ್ಹಮ್‌ಜಿನ್, ಇನಿ ನಜ಼ರ್‌ಮ ಬರೋಬರ್ ರ‍್ಹವಾನು ಕರಿನ್, ಇನಿ ಹುಕುಮ್‌ನ ಹೇಟುಹುಯಿನ್, ಇನ ಮಾರಗ್‌ಪರ್ ಚಾ಼ಲ್ಯೊತೊ, ಮೆ ಈಜಿಪ್ಟ್‌ವಾಳನ ಉಬ್‌ಜಾ಼ಯೊತೆ ರೋಗ್‌ಮ ಏಕ್‌ಬಿ ತುಮುನ ಕೋಆವದಿಶ್‌ನಿ. ಯೆಹೋವಕರಿ ಮೇಸ್ ತುಮುನ ಅಛ್ಛು಼ ಕರವಾಳೊಬಿ, ತುಮುನ ಗುಣ್‌ಕರವಾಳೊಬಿ ಹುಯಿರ‍್ಹೊಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 15:26" /><verse number="27" style="v" sid="EXO 15:27" />ಇನವಾರ್ ಇವ್ಣೆ ಏಲೀಮ್‌ನ ಆಯು. ಹಿಜ್ಜಾ಼ ಭಾರ ಪಾಣಿನು ಚೇಜ಼್‌ಬಾರೋಬಿ, ಖ್ಹಡ್‌ತೀನಿಖ್ಹ್ ಖಜೂ಼ರ್‌ನು ಝಾ಼ಡುಬಿ ಥೂ. ಯೊ ಪಾಣಿನ ಖನ್ನೆಸ್‌ ಇವ್ಣೆ ರಹಿಗ.<verse eid="EXO 15:27" /></para>
  <chapter eid="EXO 15" />
  <chapter number="16" style="c" sid="EXO 16" />
  <para style="s">ದೇವ್ನೆ ಗೇರ್‌ಜು ಅಜು಼ ಮನ್ನಾನ ದಿದೋತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 16:1" />ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಟೋಳ್‌ಕೊ ಖ್ಹಾರು ಏಲೀಮ್‌ಥು ಚಾ಼ಲಿನ್ ಇವ್ಣೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ನಿಕ್‌ಳ್ಯುತೆ ಬೇನ ಮಹಿನಾನು ಪಂಧ್ರಾನ ದನ್ಮ ಎಲೀಮಿನಾಬಿ ಸೀನಾಯಿ ಪಹಾಡ್‌ನಾಬಿ ಬೀಚ್ಮಛಾ಼ತೆ ಸೀನ್ ಕರಿ ಜ಼ಂಗಳ್‌ಮ ಆಯ. <verse eid="EXO 16:1" /><verse number="2" style="v" sid="EXO 16:2" />ತದೆ ಇಸ್ರಾಯೇಲ್‌ನು ಟೋಳ್ಕೊಖ್ಹಾರು ಜ಼ಂಗಳ್‌ಮ ಮೋಶೆ ಅಜು಼ ಆರೋನ್‌ಯಿವ್ಣಪರ್ ಭಣ್‌ಕಾಲಗ್ಯು. <verse eid="EXO 16:2" /><verse number="3" style="v" sid="EXO 16:3" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಮೋಶೆ ಅಜು಼ ಆರೋನ್ನ, “ಆ ಟೋಳ್‌ ಅಖ್ಖಾಸ್ನ ಭುಕ್ಯು ಮಾರ‍್ನುಕರಿ ತುಮೆ ಹಮುನ ಆ ಜ಼ಂಗಳ್‌ಮ ಬುಲೈಲೀನ್ ಐರ‍್ಹಾಸ್. ಹಮೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ರ‍್ಹವಾನಿವಖ್ಹ್‌ತೆ ಬೋಟಿನ ಹಂಡ್ಕಕನಾಸ್ ಬೇಖ್ಹಿನ್ ಪೇಟ್‌ಭರಿನ್ ರೋಟಾನ ಖಾವನಿ ವಖ್ಹ್‌ತೆ ಯೆಹೋವನ ಹಾಥ್ಥಿ ಮರಿಗಯಹೊತ್ತೊ ಕೆತ್ರೆಕ್ಕಿ ಅಛ್ಛು಼ಥು” ಕರಿ ಬೋಲ್ಯು. <verse eid="EXO 16:3" /><verse number="4" style="v" sid="EXO 16:4" />ತದೆ ಯೆಹೋವ ಮೋಶೆನ, “ಮೇ ಆಬ್‌ಥು ತುಮಾರಖ್ಹಾಜೆ ಖಾಣಾನ ರಂಚು಼ಸ್. ಅದ್ಮಿಖ್ಹಾರು ಹರೇಕ್ ದನ್‌ಬಿ ಭಾರ್‌ಜೈ಼ನ್ ಯೊ ದನ್ಮಾ ಹೋಣುತೆ ಎತ್ರಾನ ಖಲಿ ಎಕ್ಟುಕರಿಲೇವ್ಣು. ಅನೇಥಿ ಇವ್ಣೆ ಮಾರಿ ನಿಯಮ್ನ ಪಾಡಿಚಾ಼ಲಸ್ಕಿ ಶು ಕೊಯ್ನಿಕಿ ಕರಿ ತರೀಪ್ಷಾಕರುಸ್. <verse eid="EXO 16:4" /><verse number="5" style="v" sid="EXO 16:5" />ಛೋ಼ನ ದನ್‌ಮ ಖಲಿ ಇವ್ಣೆ ಲೀನ್ ಆಯುತೆಯಿನ ತಯಾರ್ ಕರಾನಿವಖ್ಹ್‌ತೆ ಯೊ ಹರೇಕ್ ದನ್ಮ ಎಕ್ಟುಕರಿರಾಖಥಿಬಿ ಬೇಪಟ್‌ಹುಯಿರ‍್ಹಿಷೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 16:5" /><verse number="6" style="v" sid="EXO 16:6" />ಮೋಶೆ ಅಜು಼ ಆರೋನಯಿವ್ಣೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ, “ತುಮುನ ಈಜಿಪ್ಟ್‌ಮಾಥು ಬುಲೈಲಿನ್ ಆಯೊತೆ ಯೆಹೋವಾಸ್ ಕರಿಬೋಲಾನು ಹಮ್ಕೆ ಖ್ಹಾಂಜ಼್‌ಮ ತುಮುನ ಮಾಲುಮ್‌ ಪಡ್‌ಶೆ. <verse eid="EXO 16:6" /><verse number="7" style="v" sid="EXO 16:7" />ವ್ಹಾಣ್‌ಖ್ಹತ್ರೆಮ ಯೆಹೋವನು ಮಹಿಮೆ ತುಮುನ ದೆಖಾವ್‌ಷೆ, ಶನಕತೊ ತುಮೆ ಯೆಹೋವನ ವಿರೋದ್‌ಥಿ ಭಣ್‌ಕ್ಯಥಾತೆಯಿನ ಯೊ ಖ್ಹಮ್‍ಜಿರಾಖ್ಯೊಸ್. ಹಮಾರಪರ್ ತುಮೆ ಭಣ್‌ಕಾನು ಶಾತ್? ಹಮೆ ಕೆತ್ರಾಖ್ಹ?” ಕರಿ ಬೋಲ್ಯು. <verse eid="EXO 16:7" /><verse number="8" style="v" sid="EXO 16:8" />ತದೆ ಮೋಶೆ, “ಯೆಹೋವ ಖ್ಹಾಂಜ಼್‌ನಿ ವಖ್ಹತ್‌ಮ ತುಮುನ ಬೋಟಿನಾಬಿ, ವ್ಹಾಣಾನು ಹೋಣುತೆಯೆತ್ರು ರೋಟಾನಬಿ ದಿಶೆ. ತುಮಾರಿ ಭಣ್‌ಕಾರ್ ಯೆಹೋವನ ಖ್ಹಮಜ಼್ ಪಡ್ಯು. ಮೇ ಅಜು಼ ಆರೋನ ಕೆತ್ರಾಖ್ಹವಾಳ? ತುಮಾರಿ ಭಣ್‌ಕಾರ್ ಯೆಹೋವನು ವಿರೋದಸ್ ಪಣ್ಕಿ ಹಮಾರಿ ವಿರೋದ್‌ಕಾಹೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 16:8" /><verse number="9" style="v" sid="EXO 16:9" />ಮೋಶೆನೆ ಆರೋನ್ನ, “ತೂ ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಟೋಳ್‌ಕಾನ ಜೈ಼ನ್ ಇವ್ಣುನ, ‘ಯೆಹೋವ ತುಮಾರಿ ಭಣ್‌ಕಾರ್‌ನ ಖ್ಹಮ್‍ಜಿರಾಖ್ಯೊಸ್. ಇನಖ್ಹಾಜೆ ತುಮೆಖ್ಹಾರುಬಿ ಇನ ಖ್ಹಾಮ್ಣೆ ಎಕ್ಟುಮಳಿನ್ ಆವ್ಣುಕರಿ ಹುಕುಮ್‌ಕರ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 16:9" /><verse number="10" style="v" sid="EXO 16:10" />ಆರೋನ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಟೋಳ್‌ನ ಆ ವಾತೆ ಖ್ಹಮ್‌ಜಾ಼ಡುಕರಾನಿ ವಖ್ಹ್‌ತೆ, ಇವ್ಣೆ ಜ಼ಂಗಳ್ ಭಣಿ ದೇಖಾನಿ ವಖ್ಹ್‌ತೆ, ವಾದ್ಳಾಮ ಯೆಹೋವನಿ ಉಜಾ಼ಖ್ಹ್‌ ಇವ್ಣುನ ದೆಖಾಯು. <verse eid="EXO 16:10" /><verse number="11" style="v" sid="EXO 16:11" />ಯೆಹೋವಾನೆ ಮೋಶೆನ ಜೋ಼ಡ್ಮ ವಾತೆಬೊಲ್ತೊಹುಯಿನ್ ಅಮ್ ಬೊಲ್ಯೊ: <verse eid="EXO 16:11" /><verse number="12" style="v" sid="EXO 16:12" />“ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಭಣ್‌ಕಾರ್ ಮನ ಖ್ಹಮಜ್‌ಪಡ್ಯು. ತೂ ಇವ್ಣುನ, ‘ತೂ ಖ್ಹಾಂಜ಼್‌ಮ ಬೋಟಿನಾಬಿ, ವ್ಹಾಣಾನು ಹೋಣುತೆಯೆತ್ರು ರೋಟಾನಬಿ ಖಾಷು. ಅನೇಥಿ ಮೇ ತುಮಾರೊ ದೇವ್ ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವ ಕರಿ ತುಮುನ ಮಾಲುಮ್‌ಪಡ್‌ಷೆಕರಿ ಬೋಲ್ನು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 16:12" /><verse number="13" style="v" sid="EXO 16:13" />ಖ್ಹಾಂಜ಼್ ಹುವಾಖ್ಹತರ್ ಗೇರ್‌ಜುಖ್ಹಾರು ಐನ್ ಇವ್ಣ ಇಟಾರಮ ಭರೈಗು. ಆ ನಾಹುಯಿನ್ ವ್ಹಾಣೆವೇಳಿಮ ಬರಪ್ ಇಟಾರನ ಅಶ್‌ಪಿಶ್ ಪಡ್ಯುಥು. <verse eid="EXO 16:13" /><verse number="14" style="v" sid="EXO 16:14" />ಯೊ ಬರಪ್ ಪಿಗ್ಳಿಜಾ಼ವಾನ ಪಾರ್ ಜ಼ಂಗಳ್‌ನಿ ಜ಼ಮಿನ್‌ಪರ್ ಬರಪ್‌ನ ಬೂಂದನಿತ್ರ ಶಾತ್ಕಿ ನ್ಹಾನುನ್ಹಾನು ರವೆಖ್ಹಾರು ದೆಖಾಯು. <verse eid="EXO 16:14" /><verse number="15" style="v" sid="EXO 16:15" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಇನ ದೇಖಿನ್ ಏಕ್‌ಥಿ ಎಕ್, “ಶಾತ್ ರ‍್ಹೇವ್ಣು?” ಕರಿ ಬೋಲಿಲಿದು. ಯೊ ಶಾತ್‌ಕರಿ ಇವ್ಣುನ ಮಾಲುಮ್‌ಕೋಪಡ್ಯುನಿ. ಮೋಶೆ ಇವ್ಣುನ, “ಆ ಹೈರುತೆ ಯೆಹೋವನೆ ತುಮಾರಖ್ಹಾಜೆ ಖಾವನ ದಿರಾಖ್ಯೊಸ್ತೆ ರೋಟೊ ಹುಯಿರ‍್ಹುಸ್. <verse eid="EXO 16:15" /><verse number="16" style="v" sid="EXO 16:16" />ಯೆಹೋವ ಅನಿ ಬಾರೇಮ ಶಾತ್ ಹುಕುಮ್ ದಿದೊಕತೊ: ತಮಾಮ್‌ಜ಼ಣು ಇವ್ಣ ಕುಟುಂಬ್‌ನಿ ಗಣ್ತಿನಿ ಪರಕ್ಮ ಎಕ್ ಜ಼ಣಾನ ತೀನ್ ಶೇರ್‌ನಿತರ ಇವ್ಣ ಡೇರಾಮ ರ‍್ಹವಾಳನಖ್ಹಾಜೆ ಎಕ್ಟುಕರಿಲ್ಯವಾದೆ. ಹರೇಕ್‌ಜ಼ಣು ಯೊ ಕೆತ್ರು ಖಾಸ್ಕಿ ಇನಿ ಪರಕ್ಮಾಸ್ ತುಮೆ ಜ಼ಮಕರಿಲೆವೊ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="EXO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 16:17" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಇಮ್ಮಸ್ ಕರ‍್ಯು. ಥೋಡುಜ಼ಣು ಜಾ಼ಖ್ಹತ್, ಥೋಡುಜ಼ಣು ಕಮ್ ಜ಼ಮಕರ‍್ಯು. <verse eid="EXO 16:17" /><verse number="18" style="v" sid="EXO 16:18" />ಇವ್ಣೆ ಇನ ಶೇರ್‌ಥಿ ಆಳ್ತಿಕರ‍್ಯು. ಘಣು ಜ಼ಮಕರಾವಳನ ಶಾತ್ಬಿ ಜಾ಼ಖ್ಹತ್ ಕೊಹುಯುನಿ, ಥೋಡು ಜ಼ಮಕರಾವಳನ ಶಾತ್ಬಿ ಕಮ್‍ಕೋಹುಯುನಿ. ಹರೇಕ್‌ಜ಼ಣು ಇವ್ಣ ಖಾಣಾನ ಬರೋಬರ್‌ ಹುವಾಯೆತ್ರೆ ಜ಼ಮ ಕರಿಲಿದು. <verse eid="EXO 16:18" /><verse number="19" style="v" sid="EXO 16:19" />ಆ ನಾಹುಯಿನ್ ಮೋಶೆ ಇವ್ಣುನ, “ಅನ ಕೋಣ್‌ಬಿ ಕಾಲ್ಲಗು ನಾ ಮ್ಹೇಲಿರಾಕ್ಣು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 16:19" /><verse number="20" style="v" sid="EXO 16:20" />ರ‍್ಹೀನ್‌ಬಿ ಇವ್ಣೆ ಮೋಶೆನಿ ವಾತ್ನ ಖ್ಹಮ್‌ಜುಕೊಂತೆ, ಇನಾಮ ದರಾಖ್ಹು ಬಿಜೇಕ್ ದನ್‌ಲಗು ರಾಖಿಮ್ಹೇಲಖ್ಹತರ್ ಯೊ ಕೀಡಾ ಪಡಿನ್ ಖ್ಹಡಿವಾ಼ಧರಿನ್ ಖರಾಬ್ ಹುಯಿಗು. ಇನ ಮೋಶೆನೆ ಇವ್ಣಪರ್ ಖಿಜಾ಼ಯೊ. <verse eid="EXO 16:20" /><verse number="21" style="v" sid="EXO 16:21" />ಅದ್ಮಿಖ್ಹಾರು ದನ್‌ರೋಜ಼್ ವ್ಹಾಣೆವೇಳಿಮ ಇವ್ಣ ಖಾವನ ಹೋಣುತೆಯೆತ್ರು ಜ಼ಮಕರಿಲಿದು. ತಡ್‌ಕೊ ಜಾ಼ಖ್ಹತ್ ಹುವಾನಿವಖ್ಹ್‌ತೆ ಯೊ ಪಿಗ್ಳಿಜಾ಼ತುಥು. <verse eid="EXO 16:21" /><verse number="22" style="v" sid="EXO 16:22" />ಛೋ಼ನೆ ದನ್ ಬೇಪಟ್ ಖಾಣು, ಕತೊ ಏಕ್‌ಏಕ್‌ಜ಼ಣಾನ ಬೆಬ್ಬೆ ಶೇರ್‌ನಿತರ ಛ಼ಟೈನ್ ಭರಿರಾಖ್ಯುಥುತೆ ಇನಖ್ಹಾಜೆ ಟೋಳ್‌ನು ಅದಿಕಾರಿಖ್ಹಾರು ಮೋಶೆಕನ ಅಯಿನ್ ಆ ವಾತೇವ್ನ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯು. <verse eid="EXO 16:22" /><verse number="23" style="v" sid="EXO 16:23" />ಇನ ಇನೆ, “ಆ ಹೈರುತೆ ಯೆಹೋವಾನೆ ಬೋಲ್ಯೊತೆ ವಾತ್, ‘ಕಾಲೆ ಯೆಹೋವನ ಅರಾಮ್‌ನೊ ಪರಿಶುದ್ ಸಬ್ಬತ್‌ನೊ ದನ್‌ಹುಯಿರ‍್ಹೊಸ್. ಆಜ಼ಸ್ ಭುಂಜ್ನು಼ತೆಯಿನ ಭುಂಜಿನ್, ರ‍್ಹಾಂದ್‌ಣುತೆಯಿನ ರ‍್ಹಾಂದೊ. ಅನಾಮ ಉಭ್‌ರ‍್ಹಾಸ್ತೆಯಿನ ಕಾಲ್‌ಲಗು ರಾಖಿಮ್ಹೇಲೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 16:23" /><verse number="24" style="v" sid="EXO 16:24" />ಮೋಶೆ ಹುಕುಮ್ ಕರ‍್ಯೊತೆ ಇಮ್ಮಸ್ ಇವ್ಣೆ ಬಿಜೇಕ್ ದನ್‌ಲಗು ಇನ ರಾಖಿಲಿದು. ಕತೋಬಿ ಯೊ ಖ್ಹಡಿರ‍್ಹೂಥು ಕೊಯ್ನಿ, ಕೀಡೊ ಪಡ್ಯೊಬಿ ಕೊಯ್ನಿ. <verse eid="EXO 16:24" /><verse number="25" style="v" sid="EXO 16:25" />ತದೆ ಮೋಶೆನೆ ಇವ್ಣುನ, “ಆ ವಖ್ಹತ್ ಅನ ಖಾವೊ. ಆ ದನ್ ಯೆಹೋವನೊ ಸಬ್ಬತ್ ದನ್‌ಹುಯಿರ‍್ಹೊಸ್ತೆ ಖ್ಹಾಜೆ ಆ ದನ್ ಯೊ ಖೇತರ್‌ಮ ದೆಖಾವಕೊಯ್ನಿ. <verse eid="EXO 16:25" /><verse number="26" style="v" sid="EXO 16:26" />ಛೋ಼ ದನ್ ಇನ ಜ಼ಮಕರಿನ್ ಮ್ಹೇಲ್ನು. ಖ್ಹಾತ್‌ನೊ ದನ್ ಸಬ್ಬತ್ ದನ್‌ಹುಯಿರ‍್ಹೊಸ್ತೆ ಖ್ಹಾಜೆ ಯೊ ಮಳ್‌ಷೆ ಕೊಯ್ನಿ” ಕರಿ ಬೊಲ್ಯೊ. ಇಮ್ಮಸ್ ಹುಯು. <verse eid="EXO 16:26" /><verse number="27" style="v" sid="EXO 16:27" />ಅದ್ಮಿಮ ಥೋಡುಜ಼ಣು ಖ್ಹಾತ್‌ನ ದನ್‌ಮ ಇನ ಚೂ಼ಣಾನ ಜಾ಼ವಾಮ ಇವ್ಣುನ ಶಾತ್‌ಬಿ ಮಳ್ಯುಕೊಯ್ನಿ. <verse eid="EXO 16:27" /><verse number="28" style="v" sid="EXO 16:28" />ತದೆ ಯೆಹೋವನೆ ಮೋಶೆನ, “ತುಮೆ ಕಿಜ್ಜಾ಼ಲಗು ಮಾರಿ ಹುಕುಮ್‌ನಾಬಿ, ಮೇ ಕರಿರಾಖ್ಯೊತೆ ನಿಯಮ್‌ನಾಬಿ ಪಾಡಿಚಾ಼ಲ್‌ಶು ಕೊಂತೆ ಝಿಟ್ಕಾರ್‌ಶು? <verse eid="EXO 16:28" /><verse number="29" style="v" sid="EXO 16:29" />ದೇಖೊ, ಯೆಹೋವನೆ ತುಮುನ ಸಬ್ಬತ್ ದನ್ನಾ ಚ಼ಲಾವ್ಣುಕರಿ ಹುಕುಮ್ ದಿರಾಖ್ಯೊಸ್ತೆ ಖ್ಹಾಜೆಸ್ ಛೋ಼ನ ದನ್ಮ ಬೇ ದನ್ನು ಖಾಣು ತುಮುನ ಮಳಾನಿತ್ರ ಕರಿರಾಖ್ಯೊಸ್. ತುಮಾರಮ ತಮಾಮ್‌ ಜ಼ಣೋಬಿ ಯೊ ರ‍್ಹಾವನಿ ಝ಼ಗೋಮ ರ‍್ಹೇವ್ಣು. ಖ್ಹಾತ್‌ನ ದನ್ಮ ಏಕ್‌ಜ಼ಣೊಬಿ ಇನಿ ಝ಼ಗೋನ ಮ್ಹೇಲಿನ್ ಭಾರ್‌ ನಾಜಾ಼ವ್ಣು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 16:29" /><verse number="30" style="v" sid="EXO 16:30" />ಇನಖ್ಹಾಜೇಥಿ ಖ್ಹಾತ್‌ನ ದನ್ಮ ಅದ್ಮಿಖ್ಹಾರು ಕಾಮ್ ಕೋಕರ‍್ಯುನಿತೆ ಅರಾಮ್ ಕರ‍್ಯು.<verse eid="EXO 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 16:31" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಆ ಖಾಣಾನ “ಮನ್ನ” ಕರಿ ನಾಮ್ ಮ್ಹೇಲ್ಯು.ಯೊ ಧೋಳ ಕೊತ್‌ಮಿರ್‌ನ ಪಂಡಾನಿತರ ರ‍್ಹೀನ್ ಲಜ಼ತ್‌ಮ ಶೇತ್ ಲೋಥ್ಯಹುಯ ದೋಶನಿತರ ಥು. <verse eid="EXO 16:31" /><verse number="32" style="v" sid="EXO 16:32" />ಮೋಶೆ ಅದ್ಮಿಖ್ಹಾರನ, “ಯೆಹೋವನೆ ಹುಕುಮ್ ದಿದೋತೆ ಆಸ್, ‘ಮೇ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ತುಮುನ ಭಾರ್‌ ಬುಲಾವನಿವಖ್ಹ್‌ತೆ ಜ಼ಂಗಳ್‌ಮ ಖಾವಾನ ದಿದೊತೆ ಖಾಣಾನ ತುಮಾರಿ ಪಿಳ್ಗಿವಾಳು ದೇಖಾನಿತರ ಇವ್ಣಖ್ಹಾಜೆ ತುಮೆ ಎಕ್ ಶೇರ್ ಮನ್ನಾನ ಭರಿನ್ ಜ಼ತನ್‌ಥಿ ರಾಕ್ಣು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 16:32" /><verse number="33" style="v" sid="EXO 16:33" />ಇನಖ್ಹಾಜೆ ಮೋಶೆನೆ ಆರೋನ್ನ, “ತೂ ಎಕ್ ಹಂಡ್ಕಾನ ಲೀನ್. ಇನಾಮ ಎಕ್ ಶೇರ್‌ಯೆತ್ರೆ ಮನ್ನಾನ ನಾಖಿನ್ ತುಮಾರು ಪಿಳ್ಗಿವಾಳು ದೇಖಾನಖ್ಹಾಜೆ ಇನ ಯೆಹೋವನು ಝ಼ಗೋಮ ಮ್ಹೇಲ್ನು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 16:33" /><verse number="34" style="v" sid="EXO 16:34" />ಯೆಹೋವನೆ ಮೋಶೆನ ಹುಕುಮ್‌ಕರಾನಿತರಸ್, ಆರೋನ್ನೆ ಹುಕುಮ್‌ನುಶಾಸನ್ನು ಪಿಟಾರನ ಭೀಡೆ ಇನ ಮ್ಹೇಲ್ಯೊ. <verse eid="EXO 16:34" /><verse number="35" style="v" sid="EXO 16:35" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಇವ್ಣೆ ಜಿವ್ಣುಕರ‍್ನುತೆ ಮುಲಕ್‌ಮ ಆವಲಗು ಕತೊ ಕಾನಾನ್ ದೇಖ್ಹ್‌ನ ಅಯಿನ್ ಮಳಾಲಗೂಬಿ ಚಾ಼ಳಿಖ್ಹ್ ವರಖ್ಹ್ ಮನ್ನಾನಸ್ ಖಾದು. <verse eid="EXO 16:35" /><verse number="36" style="v" sid="EXO 16:36" />ಓಮೆರ್ (ಶೇರ್)ಕರಿ ಬೋಲಾನು ಏಫಾಮ<note caller="+" style="f"><char style="fr" closed="false">16:36 </char><char style="ft" closed="false">ಎಫಾಮ ಕತೊ ಖ್ಹುಮಾರ್ ಡೋಡಿಖ್ಹ್‌ ಶೇರ್ ಎತ್ರು</char></note> ದಖ್ಹ್‌ನು ಎಕ್ ವಾಟೊ.<verse eid="EXO 16:36" /></para>
  <chapter eid="EXO 16" />
  <chapter number="17" style="c" sid="EXO 17" />
  <para style="s">ಬಂಡಮಾಥು ಆಯುತೆ ಪಾಣಿ</para>
  <para style="r">(<ref loc="NUM 20:1-13">ಅರಣ್ಯ 20:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 17:1" />ಇನಕೇಡೆಥು ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಟೋಳ್‌ಅಖ್ಖು ಯೆಹೋವನಿ ಹುಕುಮ್‌ನಿ ಪರಕ್ಮ “ಸೀನ್” ಕರಿ ಜ಼ಂಗಳ್‌ಥು ನಿಕ್ಳಿನ್ ಅಗ್ಗಳ್ ಚಾ಼ಲ್‌ಕುಚ಼್ ಕರಿನ್ ರೆಫೀದೀಮಿಮ ರ‍್ಹಯ. ಹಿಜ್ಜಾ಼ಬಿ ಅದ್ಮಿನ ಪಿಯ್ಯಾನ ಪಾಣಿ ಕೊಥುನಿ. <verse eid="EXO 17:1" /><verse number="2" style="v" sid="EXO 17:2" />ಇನಖ್ಹಾಜೆ ಅದ್ಮಿಖ್ಹಾರು ಮೋಶೆಪರ್ ಭಣಕ್‌ತು ಹುಯಿನ್, “ಹಮುನ ಪಿಯ್ಯಾನ ಪಾಣಿ ದೆವಾಡಿದೇವ್ಣು” ಕರಿ ಗಲಾಟ್ ಕರಾಮ, ಮೋಶೆನೆ ಇವ್ಣುನ, “ಮಾರ ಕೇಡೆ ಶನ ಲಡೈಕರೊಸ್? ಯೆಹೋವನ ಶನ ತರೀಪ್ಷಕರೊಸ್?” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 17:2" /><verse number="3" style="v" sid="EXO 17:3" />ಹಿಜ಼್ಜ ಅದ್ಮಿಖ್ಹಾರು ಠೋಖ್ಹ್‌ಥಿ, ಮೋಶೆನ ವಿರೋದ್‌ಥಿ ಭಣ್‌ಕಿನ್, “ತೂ ಹಮುನಾಬಿ, ಹಮಾರ ಲಡ್ಕಾನಬಿ, ಜಾನ್ವರ್‌ನಬಿ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಹಜ಼್ಜ ಬುಲೈನ್ ಹಮ್ಕೆ ಪಾಣಿಕೊಂತೆ ಮಾರನಿಘೋಣಿ ಶನಕರ‍್ಯೊತೆ?” ಕರಿ ಬೋಲ್ಯು. <verse eid="EXO 17:3" /><verse number="4" style="v" sid="EXO 17:4" />ತದೆ ಮೋಶೆ ಯೆಹೋವನ ಬಿಂತಿಕರಿನ್, “ಆ ಅದ್ಮಿನಖ್ಹಾಜೆ ಮೇ ಶಾತ್‌ಕರು? ಇವ್ಣೆ ಮನ ಬಂಡೊಫೇಕಿನ್ ಮಾರನಿತರ ಛೇನಿ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="EXO 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 17:5" />ಇನ ಯೆಹೋವನೆ ಮೋಶೆನ, “ತೂ ನೈಲ್ ನದ್ದೀನ ಮಾರ‍್ಯೊತೆ ಲಠ್ಠಾನ ಹಾತ್ಮ ಧರಿಲಿನ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಶಾಣಾಮ ಥೋಡಾನ ಬುಲೈಲಿನ್ ಅದ್ಮಿಖ್ಹಾರನ ಖ್ಹಾಮ್ಣೆ ನಿಕ್ಳಿನ್, ಮೇ ವತಾಳನು ಝ಼ಗೋಕನ ಜಾ಼. <verse eid="EXO 17:5" /><verse number="6" style="v" sid="EXO 17:6" />ಹಿಜ಼್ಜ ಹೋರೇಬ್‌ಮ ಛಾ಼ತೆ ಬಂಡಾನಪರ್ ಮೇಸ್ ತುನ ಮ್ಹೋರೆಹುಯಿನ್ ಭೀರಿಶ್. ತೂ ಯೊ ಬಂಡಾನ ಮಾರಾನಿವಖ್ಹ್‌ತೆ, ಅದ್ಮಿಖ್ಹಾರು ಪಿಯ್ಯಾನ ಪಾಣಿ ಭಾರ್‌ ನಿಕಳ್‌ಶೆ” ಕರಿ ಬೊಲ್ಯೊ. ಮೋಶೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಗಲ್‌ಢಾನ ಖ್ಹಾಮೆ ಇಮ್ಮಸ್ ಕರ‍್ಯೊ. <verse eid="EXO 17:6" /><verse number="7" style="v" sid="EXO 17:7" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು, “ಯೆಹೋವ ಅಪ್ಣ ಬೀಚ್ಮ ಛಾ಼ಕಿಶು ಕೊಯ್ನಿ?” ಕರಿ ಯೆಹೋವನ ಹಿಜ್ಜಾ಼ ತರೀಪ್ಷ ಕರ‍್ಯುತೆಖ್ಹಾಜೆ, ಮೋಶೆ ಯೊ ಝ಼ಗೋನ ‘ಮಸ್ಸಾ’ ಕರೀಬಿ ಇವ್ಣೆ ಗಲಾಟ್ ಕರ‍್ಯುತೆಖ್ಹಾಜೆ ಇನ ‘ಮೆರೀಬಾ’ ಕರೀಬಿ ನಾಮ್ ಮ್ಹೇಲ್ಯೊ.<verse eid="EXO 17:7" /></para>
  <para style="s">ಅಮಾಲೇಕ್ಯವಾಳೇಥಿ ಜಂಗ್</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 17:8" />ಅಮಾಲೇಕ್ಯವಾಳು ರೆಫೀದೀಮಿಮ ಇಸ್ರಾಯೇಲ್‌ವಾಳನಿ ಜೋ಼ಡೆ ಜಂಗ್‌ಕರ‍್ಯು. <verse eid="EXO 17:8" /><verse number="9" style="v" sid="EXO 17:9" />ತದೆ ಮೋಶೆನೆ ಯೆಹೋಶುವನ, “ತೂ ಅಪ್ಣ ಅದ್ಮಿಖ್ಹಾರಮ ಥೋಡಾನ ಚೂ಼ಣಿಲಿನ್ ಅಮಾಲೇಕ್ಯನವಾಳನ ಜೋ಼ಡೆ ಜಂಗ್ ಭೀಡ್‌ನು. ಮೇ ಕಾಲೆ ದೇವ್ನ ಲಠ್ಠಾನ ಹಾತ್ಮ ಧರಿಲಿನ್ ಮೇಂಡ್‌ನಪರ್ ಭೀರಿಶ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 17:9" /><verse number="10" style="v" sid="EXO 17:10" />ಮೋಶೆನ ಹುಕುಮ್‌ನಿ ಪರಕ್ಮ ಯೆಹೋಶುವನೆ ಅಮಾಲೇಕ್ಯವಾಳೇಥಿ ಜಂಗ್ ಕರ‍್ಯೊ. ಮೋಶೆಬಿ, ಆರೋನಬಿ ಅಜು಼ ಹೂರ ಇವ್ಣೆ ಮೇಂಡ್‌ನಪರ್ ಛ಼ಡಿಗಯ. <verse eid="EXO 17:10" /><verse number="11" style="v" sid="EXO 17:11" />ಮೋಶೆನೆ ಇನ ಹಾತ್ನ ಉಪ್ಪರ್ ಪಾಡಖ್ಹತರ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ತಾಖತಿಉಷೆ. ಯೊ ಇನ ಹಾತ್ನ ಉತಾರ‍್ಯೊತೊ ಅಮಾಲೇಕ್ಯವಾಳು ತಾಖತಿಉಷೆ. <verse eid="EXO 17:11" /><verse number="12" style="v" sid="EXO 17:12" />ಮೋಶೆನ ಹಾತ್ ಶೋತಿಜಾ಼ವನಿ ವಖ್ಹತ್, ಆರೋನ ಅಜು಼ ಹೂರನೆ ಎಕ್ ಬಂಡಾನ ಲೈನ್‌ ಮ್ಹೇಲ್ಯೊ. ಮೋಶೆ ಇನ ಉಪ್ಪರ್ ಬೇಶಿಗಯೊ. ಆರೋನ ಎಕ್ ಬಾಜು಼ಮಾಬಿ, ಹೂರ ಬಿಜೇಕ್ ಬಾಜು಼ಮಾಬಿ ಭೀರಿನ್ ಮೋಶೆನ ಹಾತ್ನ ಪಾಡಿರಾಖನ ಮದತ್ ಕರ‍್ಯ. ಅಮ್ ಇನ ಹಾತ್‌ಖ್ಹಾರು ಚಾ಼ಂದ್ ಡುಬಾಲಗುಬಿ ಹೇಟ್ಉತಾರ‍್ಯಕೊಂತೆ ಥಾ. <verse eid="EXO 17:12" /><verse number="13" style="v" sid="EXO 17:13" />ಯೆಹೋಶುವನೆ ಅಮಾಲೇಕ್ಯವಾಳನ ಅಜು಼ ಇವ್ಣ ಶಿಪಾಯ್‌ಖ್ಹಾರನ ತಲ್ವಾರ್‌ಥಿ ಹರಾಯೊ.<verse eid="EXO 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 17:14" />ತದೆ ಯೆಹೋವನೆ ಮೋಶೆನ, “ಇನ ಯಾದ್‌ನಖ್ಹಾಜೆಥಿ ಎಕ್ ದಪ್ತರ್‌ಮ ಲೀಖ್. ಇನ ಯೆಹೋಶುವನ ಖ್ಹಮ್‌ಜಾ಼ಡ್. ಶನಕತೊ ಮೇ ಅಮಾಲೇಕ್ಯವಾಳನು ಯಾದ್ ಧರ್ತಿಪರ್ ನಾರ‍್ಹೇವ್ಣುತೆ ಪೂರ ನಾಶ್‌ ಕರಿನಾಖುಸ್” ಕರಿಬೋಲ್ಯೊ. <verse eid="EXO 17:14" /><verse number="15" style="v" sid="EXO 17:15" />ಯೊ ಝ಼ಗೋಮ ಮೋಶೆನೆ ಬಲಿಪೀಠ್ನ ಭಂದೈನ್ ಇನ “ಯೆಹೋವ ನಿಸ್ಸಿ”<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="ft" closed="false">ಯೆಹೋವ ನಿಸ್ಸಿ ಕತೊ ಯೆಹೋವ ಮಾರೊ ಜಯನೊ ಝಂಡೊ</char></note> ಕರಿನಾಮ್‌ ಮ್ಹೇಲ್ಯೊ. <verse eid="EXO 17:15" /><verse number="16" style="v" sid="EXO 17:16" />ಶನಕತೊ, “ಯೆಹೋವನಿ ಸಿಂಹಾಸನ್ನಿ ಆಣೇಬಿ ಅಮಾಲೇಕ್ಯವಾಳನ ಉಪ್ಪರ್ ಯೆಹೋವನ ಮುಂಡಿನ್‌ಮುಂಡಿಮಾಬಿ ಜಂಗ್‌ರ‍್ಹಿಶೆ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="EXO 17:16" /></para>
  <chapter eid="EXO 17" />
  <chapter number="18" style="c" sid="EXO 18" />
  <para style="s">ಇತ್ರೋವನೆ ಮೋಶೆನ ಮಳ್ಯೊತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 18:1" />ದೇವ್ನೆ ಮೋಶೆನಾಬಿ ಇನ ಅದ್ಮಿಹುಯಿರ‍್ಹಾತೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನಬಿ ಮಹಾನ್ ಮದತ್ನ ಕರ‍್ಯೊತೆಯಿನಬಿ, ಯೆಹೋವನೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಬುಲೈಲಿನ್ ಆಯೊತೇಬಿ, ಮಿದ್ಯಾನ್‌ವಾಳನು ಯಾಜಕಬಿ ಮೋಶೆನೊ ಮಾಮಾಬಿ ಹುಯಿರ‍್ಹೊಥೋತೆ ಇತ್ರೋವನೆ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ. <verse eid="EXO 18:1" /><verse number="2" style="v" sid="EXO 18:2" />ತದೆ ಮೋಶೆನೊ ಮಾಮ ಇತ್ರೋವನೆ ಇನಕನ ಮೋಕ್ಲಿರಾಖ್ಯೊಥೋತೆ ಮೋಶೆನಿ ಬಾವಣ್ ಚಿಪ್ಪೋರನಬಿ, ಇನ ಬೇ ಪರ್ಖ್ಹಾ ಲಡ್ಕಾನಬಿ ಬುಲೈಲಿನ್ ಆಯೊ. <verse eid="EXO 18:2" /><verse number="3" style="v" sid="EXO 18:3" />ಯೊ ಬೇ ಛಿಯ್ಯಾವ್ಮ ಏಕ್‌ಜ಼ಣಾನ “ಗೇರ್ಷೋಮ್” ಕರಿ ನಾಮ್ ಮ್ಹೇಲ್ಯೊ. ಶನಕತೊ ಮೋಶೆನೆ, “ಮೇ ಭಾರ್‌ ದೇಖ್ಹ್‌ವಾಳೊ ಹುಯಿರ‍್ಹೊಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 18:3" /><verse number="4" style="v" sid="EXO 18:4" />ಇನ ಬಿಜೇಕ್ ಛಿಯ್ಯಾನ ಮೋಶೆನೆ, “ಮಾರೊ ಬಾನೊ ದೇವ್ ಮನ ಮದತ್‌ವಾಳೊಹುಯಿನ್ ಮನ ಫರೋಹನಿ ತಲ್ವಾರ್‌ಥಿ ಛು಼ಕೈನ್ ಬಚಾ಼ಡ್ಯೊ” ಕರಿ ಬೋಲಿನ್, ಯೊ ಛಿಯ್ಯಾನ “ಎಲೀಯೆಜೆರ್”ಕರಿ ನಾಮ್ ಮ್ಹೇಲ್ಯೊ. <verse eid="EXO 18:4" /><verse number="5" style="v" sid="EXO 18:5" />ಮೋಶೆನೊ ಮಾಮ ಹುಯಿರ‍್ಹೋತೆ ಇತ್ರೋವಾನೆ ಮೋಶೆನ ಲಡ್ಕಾವ್ನಬಿ ಬಾವಣ್ಣಾಬಿ ಬುಲೈಲಿನ್ ಜ಼ಂಗಳ್‌ಮ ದೇವ್ನ ಪಹಾಡ್‌ಕನ ಉತ್ರಿರ‍್ಹೊಥೋತೆ ಮೋಶೆಕನ ಆಯೊ. <verse eid="EXO 18:5" /><verse number="6" style="v" sid="EXO 18:6" />ಇನೆ ಮೋಶೆನ, “ತಾರೊ ಮಾಮ ಇತ್ರೋವ ಹುಯಿರೋತೆ ಮೇ ತಾರಿ ಬಾವಣ್ಣ, ತಾರ ಭೇ ಛಿಯ್ಯಾನ ಬುಲೈಲಿನ್ ತಾರಕನ ಐರ‍್ಹೋಸ್” ಕರಿ ಬೋಲಿನ್ ಮೋಕ್‌ಲ್ಯೊ. <verse eid="EXO 18:6" /><verse number="7" style="v" sid="EXO 18:7" />ಮೋಶೆನೆ ಇನ ಮಾಮಾನ ಮಳಾನ ನಿಕ್ಳಿನ್ ಇನ ಖ್ಹಲಾಮ್‌ಕರಿನ್ ಬುಚ಼್ಚಕರ‍್ಯೊ. ಇವ್ಣೆ ಎಕ್‌ಥಿಏಕ್ ಅಛ್ಛೊ ರ‍್ಹವಾನು ನಾರ‍್ಹವಾನು ಪುಛಾವನ ಪಾರ್ ಡೇರಾನ ಮಹಿ ಗಯ. <verse eid="EXO 18:7" /><verse number="8" style="v" sid="EXO 18:8" />ಇನವಾರ್ ಮೋಶೆನೆ ಯೆಹೋವನೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳ ಭಣೀಥು ಫರೋಹನಾಬಿ, ಈಜಿಪ್ಟ್‌ವಾಳನಾಬಿ ಕರ‍್ಯೊತೆಅಖ್ಖಾಸ್ನಬಿ, ವಾಟ್ಮ ಇವ್ಣುನ ಹುಯುತೆ ಅಖ್ಖೀಸ್ ವದೇಖ್ಹ್‌ನಾಬಿ, ಯೆಹೋವನೆ ಯೊ ವದೇಖ್ಹ್‌ಥು ಛು಼ಕಾಯೊತೆನಬಿ ಇನ ಮಾಮಾನ ಬೋಲಿವತಾಳ್ಯೊ. <verse eid="EXO 18:8" /><verse number="9" style="v" sid="EXO 18:9" />ಯೆಹೋವನೆ ಈಜಿಪ್ಟ್‌ವಾಳನ ಹಾತೇಖ್ಹು ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಛೋ಼ಡೈನ್ ಇವ್ಣುನ ಮದತ್ ಕರ‍್ಯೊತೆಖ್ಹಾಜೆ ಇತ್ರೋವನೆ ಖುಷಿಕರ‍್ಯೊ. <verse eid="EXO 18:9" /><verse number="10" style="v" sid="EXO 18:10" />ಇತ್ರೋವನೆ, “ಈಜಿಪ್ಟ್‌ವಾಳನ ಹಾತೇಖ್ಹುಬಿ, ಫರೋಹನ ಹಾತೇಖ್ಹುಬಿ ತುಮುನ ಛುಟ್ಕಾರ್ ಕರ‍್ಯೊತೆ ಯೆಹೋವನ ಧನ್ಯವಾದ್‌ ಹುವಾದೆ! ಇನ ಅದ್ಮಿನ ಈಜಿಪ್ಟ್‌ಮ ಗುಲಾಮ್‌ನ ಕಾಮ್‍ಥಿ ಛೋಡಾಯೋತೆ ಯೆಹೋವನ ಧನ್ಯವಾದ್‌! <verse eid="EXO 18:10" /><verse number="11" style="v" sid="EXO 18:11" />ಯೆಹೋವನೆ ಇನ ಅದ್ಮಿಖ್ಹಾರನ ಇವ್ಣ ಹಾತೇಥಿ ಛೋ಼ಡೈನ್, ಯೊ ಈಜಿಪ್ಟ್‌ವಾಳು ಖಿವಿ ಬಾರೇಮ ಹಂಕಾರ್ ಕರುಕರ್ಥುಥೂಕಿ, ಯೊ ವಿಚಾರ್‌ಮ ಇವ್ಣುನ ಹೇಟುಕರ‍್ಯೊತೆ ಇನಖ್ಹಾಜೆ ಯೆಹೋವ ಅಖ್ಖಾಸ್ ದೇವ್‍ಥೀಬಿ ಮೋಟೊಕರಿ ಹಮ್ಕೆ ಮಾಲುಮ್ ಕರಿರಾಖ್ಯೊಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 18:11" /><verse number="12" style="v" sid="EXO 18:12" />ಆಸ್‌ಕಾಹೆತೆ ಮೋಶೆನೊ ಮಾಮ ಹುಯಿರ‍್ಹೋತೆ ಇತ್ರೋವನೆ ದೇವ್ನ ಅಖ್ಖಾಸ್ ಶರೀರ್‌ನಿ ಬಲಿನ ಸಮರ್ಪಣ್‌ ಕರ‍್ಯೊ. ಆರೋನಬಿ, ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಶಾಣುಖ್ಹಾರುಬಿ ಇನ ಜೋ಼ಡೆ ದೇವ್ನಿ ಝ಼ಗೋಮ ಖಾಣುಖಾವಾನ ಆಯ.<verse eid="EXO 18:12" /></para>
  <para style="s">ನ್ಯಾವ್‌ನ ಅಧಿಪತಿನು ನೇಮಕ್‌</para>
  <para style="r">(<ref loc="DEU 1:9-18">ಧರ್ಮೊ 1:9-18</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 18:13" />ಇನ ವ್ಹಾಣೆ ಮೋಶೆ ಅದ್ಮಿವ್‌ನ ನ್ಯಾವ್‌ ಫೇಡಾವನಖ್ಹಾಜೆ ಬೆಠೊರ‍್ಹವಾಮ ವ್ಹಾಣ್‌ಖ್ಹತ್ರೇಥು ಖ್ಹಾಂಜ್‌ಲಗುಬಿ ಅದ್ಮಿಖ್ಹಾರು ಇನ ಖನ್ನೆ ಭಿಯೂಥು. <verse eid="EXO 18:13" /><verse number="14" style="v" sid="EXO 18:14" />ಮೋಶೆನೆ ಅದ್ಮಿವ್‌ನಖ್ಹಾಜೆ ಕರುಕರಾತೆ ಅಖ್ಖಾನ ಇನೊ ಮಾಮ ದೇಖಿನ್ ಇನ, “ತೂ ಶನ ಅದ್ಮಿವ್‌ನಖ್ಹಾಜೆ ಅತ್ರು ಮ್ಹಿನತ್ ಕರುಕರಸ್? ವ್ಹಾಣೇಥಿ ಖ್ಹಾಂಜ಼್‌ಲಗು ತೂ ಎಕ್ಕಸ್‌ಜ಼ಣೊ ನ್ಯಾವ್ ಫೇಡಾವನ ಭೀರೆವ್ಣುಕಿಶು?” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 18:14" /><verse number="15" style="v" sid="EXO 18:15" />ಮೋಶೆ ಇನ ಮಾಮಾನ, “ದೇವ್ನಿ ತೀರ್ಪ್‌ನ ಮಾಲುಮ್ ಕರಿಲ್ಯಾವನಖ್ಹಾಜೆ ಅದ್ಮಿಖ್ಹಾರು ಮಾರಕನ ಆವಸ್. <verse eid="EXO 18:15" /><verse number="16" style="v" sid="EXO 18:16" />ಇಮ್ಮಸ್ ಇವ್ಣಾಮ ಝ಼ಗ್ಡೊಕಾಯ್‌ತೋಬಿ ಹುಯಿರ‍್ಹುತೊ ಮಾರಕನ ಆವಸ್. ಮೇ ವಿಚಾರ್‌ಕರಿನ್ ಇವ್ಣುನ ನ್ಯಾವ್ ಫೇಡೈನ್ ದೇವ್ನಿ ಹುಕುಮ್‌ನಿ ನಿಯಮ್ನ ಭೋದನ್ ಕರುಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 18:16" /><verse number="17" style="v" sid="EXO 18:17" />ಇನ ಖ್ಹಮ್‌ಜೊತೆ ಮೋಶೆನ ಮಾಮಾನೆ ಇನ, “ತೂ ಕರುಕರಾತೆ ಕಾಮ್ನುಪರಕ್ ಬರೋಬರ್ ಕೊಯ್ನಿ. <verse eid="EXO 18:17" /><verse number="18" style="v" sid="EXO 18:18" />ಆ ಕಾಮ್ ಘಣು ವದೇಖ್ಹ್‌ನು. ತಾರ ಎಕ್ಕಸ್‌ಜ಼ಣಾಥಿ ಇನ ಚ಼ಲಾವನ ಕೊಹೊಯ್ನಿ. ತೂ ತಾರ ಜೋ಼ಡೆ ಛಾ಼ತೆ ಆ ಅದ್ಮಿಖ್ಹಾರುಬಿ ಖ್ಹಚೆಂಬಿ ಖ್ಹತಿಜಾಶು. <verse eid="EXO 18:18" /><verse number="19" style="v" sid="EXO 18:19" />ಮಾರಿ ವಾತೆನ ಖ್ಹಮಜ಼್, ಮೇ ತುನ ಎಕ್ ಖ್ಹೂಜ಼್‌ನ ಬೋಲುಸ್ ಅಜು಼ ದೇವ್ ತಾರಿ ಜೋ಼ಡೆ ರ‍್ಹವಾದೆ. ತೂ ಅದ್ಮಿವ್‌ನಾಬಿ, ದೇವ್‍ನಾಬಿ ಬೀಚ್‌ವಾಳೊ ಹುಯಿರ‍್ಹಿನ್ ಅದ್ಮಿವ್‌ನ ಝ಼ಗ್ಡಾವ್ನ ದೇವ್‌ಕನ ಲೀನ್ ಆವ್ಣು. <verse eid="EXO 18:19" /><verse number="20" style="v" sid="EXO 18:20" />ತೂ ದೇವ್ನಿ ಹುಕುಮ್‌ನಿ ನಿಯಮ್ನ ಭೋದನ್ ಕರಿನ್, ಇವ್ಣೆ ಚಾ಼ಲ್ನುತೆ ಮಾರಗ್‌ನಬಿ, ಕರ್ನುತೆ ಕಾಮ್‌ಅಖ್ಖುಬಿ ಇವ್ಣುನ ಖ್ಹಮ್‌ಜಾ಼ಡ್‌ನು. <verse eid="EXO 18:20" /><verse number="21" style="v" sid="EXO 18:21" />ಕತೋಬಿ ತೂ ತಮಾಮ್‌ ಅದ್ಮಿವ್‌ನ ಮಹಿ ತಾಖತ್‌ವಾಳುಬಿ, ದೇವ್ನಭಕ್ತರ್‌ಬಿ, ವಿಶ್ವಾಸ್‌ವಾಳುಬಿ, ಲಂಚ ನಾಛೀಮವಾಳುಬಿ ಹುಯಿರ‍್ಹುಸ್ತೆ ಪರ್ಖ್ಹಾವ್‌ನ ಚೂ಼ಣಿಲಿನ್ ಇವ್ಣುನ ಹಜಾ಼ರ್ ಜ಼ಣಾನ ಉಪ್ಪರ್‌ಬಿ, ಖ್ಹೊ ಜ಼ಣಾಪರ್‌ಬಿ, ಅಢೈಖ್ಹ್ ಜ಼ಣಾಪರ್‌ಬಿ ಅಜು಼ ದಖ್ಹ್‌ ಜ಼ಣಾಪರ್‌ಬಿ ಅದಿಕಾರಿಕರಿನ್ ನೇಮಕ್‌ ಕರ‍್ನು. <verse eid="EXO 18:21" /><verse number="22" style="v" sid="EXO 18:22" />ಇವ್ಣೇಸ್ ಕೆದೇಬಿ ಅದ್ಮಿವ್‌ನ ನ್ಯಾವ್‌ನ ಫೇಡಾವದೆ. ಇವ್ಣೆ ಮೋಟ ಝ಼ಗ್ಡಾನ ತಾರ ಖ್ಹಾಮ್ಣೆ ಲ್ಯವಾದೆ.ನ್ಹಾನು ಝ಼ಗ್ಡಾವ್ನ ಇವ್ಣೇಸ್ ಫೇಡೈಲಾವದೆ. ಇವ್ಣೆ ತಾರೇಥಿ ಆ ವಜ಼ನ್ನ ಪಾಡಾಥಿ ತುನ ಶುಲ್ಬಉಷೆ. <verse eid="EXO 18:22" /><verse number="23" style="v" sid="EXO 18:23" />ದೇವ್ ತುನ ಅಮ್‌ಕರಾನ ಹುಕುಮ್ ದಿದೋತೊ, ತೂ ಆ ಕಾಮ್ನ ಜಿಮೆದಾರ್‌ನ ಪಾಡಾನು ಉಷೆ. ಆಸ್ ಖಲಿಕಾಹೆತೆ ಆ ಅದ್ಮಿಖ್ಹಾರುಬಿ ಖುಶಾಲಿಥಿ ಇವ್ಣ ಇವ್ಣ ಘರ್‌ನ ಜಾಷೆ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="EXO 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 18:24" />ಮೋಶೆ ಇನ ಮಾಮಾನಿ ವಾತೇನ ಮಾನಿನ್ ಇನೆ ಬೋಲ್ಯೊತೆ ತಿಮ್ಮಸ್ ಖ್ಹಾರು ಕರ‍್ಯೊ. <verse eid="EXO 18:24" /><verse number="25" style="v" sid="EXO 18:25" />ಮೋಶೆನೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳಮ ತಾಖತಿವ್ನ ಚೂ಼ಣಿಲಿನ್ ಹಜಾ಼ರ್ ಜ಼ಣಾಪರ್‌ಬಿ, ಖ್ಹೊ ಜ಼ಣಾಪರ್‌ಬಿ, ಅಢೈಖ್ಹ್ ಜ಼ಣಾಪರ್‌ಬಿ, ದಖ್ಹ್‌ ಜ಼ಣಾಪರ್‌ಬಿ ಅದಿಕಾರಿಕರಿನ್ ನೇಮಕ್ ಕರ‍್ಯೊ. <verse eid="EXO 18:25" /><verse number="26" style="v" sid="EXO 18:26" />ಅವ್ಣೆ ಕದೇಬಿ ನ್ಯಾವ್‌ಫೇಡಾವವಾಳು ಹುಯಿನ್ ಕಠಣ್ ಝ಼ಗ್ಡಾವ್ನ ಮೋಶೆಕನ ಲೀನ್ ಆವ್ತುಹುಯಿನ್, ಶುಲ್‌ಬಾನ ಝ಼ಗ್ಡಾನ ಇವ್ಣೇಸ್ ಫೇಡಾವ್‌ತು ಆಯು. <verse eid="EXO 18:26" /><verse number="27" style="v" sid="EXO 18:27" />ಇನವಾರ್ ಮೋಶೆ ಇನ ಮಾಮಾನ ಜ಼ೈನ್‌ಆವ್‌ಕರಿ ಬೋಲಖ್ಹತರ್, ಯೊ ಇನ ಶೊಂತ್‌ ಮುಲಕ್‌ಮ ನಿಕ್ಳಿಗಯೊ.<verse eid="EXO 18:27" /></para>
  <chapter eid="EXO 18" />
  <chapter number="19" style="c" sid="EXO 19" />
  <para style="s">ಸೀನಾಯಿ ಪಹಾಡ್‌ಕನ ಇಸ್ರಾಯೇಲ್‌ವಾಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 19:1" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ನಿಕ್‌ಳ್ಯುತೆ ತೀನ್ನ ಮಹಿನಾನ ಯೋಸ್ ದನ್ಮ ಸೀನಾಯಿ ಜ಼ಂಗಳ್‌ಮ ಆಯು. <verse eid="EXO 19:1" /><verse number="2" style="v" sid="EXO 19:2" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ರೆಫೀದೀಮಿನ ಮ್ಹೇಲಿನ್ ಜ಼ಂಗಳ್‌ಮ ಅಯಿನ್ ಸೀನಾಯಿ ಪಹಾಡ್‌ನ ಮ್ಹೋರೆ ಡೇರೊ ಠೋಕಿನ್ ರ‍್ಹಯ. <verse eid="EXO 19:2" /><verse number="3" style="v" sid="EXO 19:3" />ಮೋಶೆ ಪಹಾಡ್ ಛ಼ಡೀನ್ ದೇವ್‌ಕನ ಗಯೊ. ತದೆ ಯೆಹೋವನೆ ಪಹಾಡ್‌ನ ಉಪ್ಪರ್‌ಥು ಮೋಶೆನ ಚಿಕ್ರಿನ್ ಇನ, “ತೂ ಯಾಕೋಬನಿ ಖಾನ್‌ದಾನ್‌ವಾಳು ಹುಯಿರ‍್ಹುತೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಆ ವಾತೇವ್ನ ಬೋಲ್ನು. <verse eid="EXO 19:3" /><verse number="4" style="v" sid="EXO 19:4" />‘ಮೇ ಈಜಿಪ್ಟ್‌ವಾಳನ ಕರ‍್ಯೊತೇಬಿ, ಗರದ್ ಇನ ಚೆಲ್ಕಾವ್ನ ಫಾಕ್ಡಿನ ಉಪ್ಪರ್ ಢೊಯ್‌ರಾಖನಿತರ ಮೇ ತುಮುನ ಢೊಯಿಲಿನ್ ಆ ಝ಼ಗೋನ ಬುಲೈಲಿನ್ ಆಯೋತೆಖ್ಹಾರು ತುಮೆ ದೇಖಿರಾಖ್ಯಸ್. <verse eid="EXO 19:4" /><verse number="5" style="v" sid="EXO 19:5" />ಇನಖ್ಹಾಜೆ ತುಮೆ ಮಾರಿ ವಾತೇವ್ನ ಧ್ಯಾನ್‌ಥಿ ಖ್ಹಮ್‌ಜಿನ್, ಮಾರಿ ಒಪ್ಪಂದಾನ ಬಚಾ಼ಡಿಲಿದಾತೊ, ತುಮೆ ಅಖ್ಖೀಸ್ ಜ಼ಗ್‌ಜಾ಼ತ್‌ಮ ಮನ ಶೊಂತ್ ಅದ್ಮಿಹುಯಿರ‍್ಹಿಶು. ತಮಾಮ್‌ ಧರ್ತಿಬಿ ಮಾರಿಸ್. <verse eid="EXO 19:5" /><verse number="6" style="v" sid="EXO 19:6" />ತುಮೆ ಮನ ಮಹಾನ್ ಯಾಜಕರ್‌ಬಿ, ಪರಿಶುದ್ಧಂ ಅದ್ಮಿಬಿ ಹುಯಿರ‍್ಹಿಶು’ ತೂ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಬೋಲ್ನುತೆ ವಾತೆಖ್ಹಾರು ಆಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 19:6" /><verse number="7" style="v" sid="EXO 19:7" />ತದೆ ಮೋಶೆ ಅಯಿನ್ ಅದ್ಮಿಯೇವ್ನ ಶಾಣಾವ್ನ ಎಕ್ಟು ಮಳಾಯೊ. ಯೆಹೋವನೆ ಹುಕುಮ್‌ ಕರಿರಾಖ್ಯೊಥೋತೆ ವಾತೇವ್ನ ಇವ್ಣುನ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ. <verse eid="EXO 19:7" /><verse number="8" style="v" sid="EXO 19:8" />ಅದ್ಮಿಖ್ಹಾರುಬಿ ಎಕ್ಟುಹುಯಿನ್, “ಯೆಹೋವನೆ ಬೋಲ್ಯೊತೆ ತಿಮ್ಮಸ್ ಕರಿಯೇಸ್” ಕರಿ ಜವಾಬ್ ದಿದು. ಮೋಶೆ ಯೆಹೋವಕನ ಪಾಛೊ಼ ಜೈ಼ನ್ ಇವ್ಣೆ ಬೋಲ್ಯುತೆ ವಾತೇವ್ನ ಇನ ಬೊಲ್ಯೊ. <verse eid="EXO 19:8" /><verse number="9" style="v" sid="EXO 19:9" />ಯೆಹೋವನೆ ಮೋಶೆನ, “ಹಂದೇಕ್, ಮೇ ತಾರಿ ಜೋ಼ಡ್ಮ ವಾತೆ ಬೋಲಾನಿವಖ್ಹ್‌ತೆ, ಅದ್ಮೆವ್ ಖ್ಹಮ್‌ಜಿನ್ ಕೆದೇಬಿ ತುನ ವಿಶ್ವಾಸ್‌ಕರಾನಿತರ ಮೇ ವಾದ್ಳಾನ ಮಹಿಥು ತಾರಕನ ಆವುಸ್‌” ಕರಿ ಬೊಲ್ಯೊ. ಮೋಶೆ ಅದ್ಮಿಯೇವ್‌ನು ವಾತೇವ್ನ ಯೆಹೋವನ ಖ್ಹಮ್‌ಜಾ಼ಡ್ಯೊ. <verse eid="EXO 19:9" /><verse number="10" style="v" sid="EXO 19:10" />ಯೆಹೋವನೆ ಮೋಶೆನ ಶಾತ್ ಬೋಲ್ಯೊಕತೊ, “ತೂ ಅದ್ಮಿಕನ ಜೈ಼ನ್, ಆಜ಼್ ಅಜು಼ ಕಾಲೆ ಇವ್ಣುನ ಶುದ್‌ಕರ್. ಮಾರು ಆವಾನಖ್ಹಾಜೆ ಇವ್ಣುನ ತಯಾರ್‌ಕರ್. ಇವ್ಣೆ ಇವ್ಣ ಲುಂಗ್ಡಾವ್ನ ಧೊಯ್‌ಲಿನ್, <verse eid="EXO 19:10" /><verse number="11" style="v" sid="EXO 19:11" />ಬಿಜೇಕ್ ದನ್ಮ ಇವ್ಣೆ ತಯಾರ್ ಹುಯಿರ‍್ಹೇವ್ಣು. ತೀನ್ನ ದನ್ಮ ಯೆಹೋವ ತಮಾಮ್‌ ಅದ್ಮಿನಾಬಿ ದೆಖಾವ್‌ತೊ ಹುಯಿನ್ ಸೀನಾಯಿ ಪಹಾಡ್‌ಪರ್ ಉತ್ರಿನ್ ಆವ್‌ಶೆ. ಹಿಜ಼್ಜಾ ತುಮೆ ಮನ ದೇಕ್‌ಶು. <verse eid="EXO 19:11" /><verse number="12" style="v" sid="EXO 19:12" />ಅದ್ಮಿಖ್ಹಾರು ಖನ್ನೆ ನಾ ಆವ್ಣುತೆ ತೂ ಪಹಾಡ್‌ನ ಅಶ್‌ಪಿಶ್‌ಬಿ ಟಪ್ಪಾನ ಕರಿನ್ ಅದ್ಮಿವ್‌ನ, ‘ಹೊಷಾರ್‌ಥಿ ರ‍್ಹವೊ, ತುಮೆ ಆ ಪಹಾಡ್‌ನ ನಾಛ಼ಡ್ನುತೇಬಿ ಇನ ಟಪ್ಪಾನ ನಾಛೀಮ್‌ಣುತೇಬಿ ಜ಼ತನ್‌ಥಿ ರ‍್ಹೇವ್ಣು. ಪಹಾಡ್‌ನ ಛೀಮವಾಳು ಖ್ಹಾರುಸ್ ಖ್ಹಚೆಂಬಿ ಮರಿಜಾ಼ಷೆ.’ <verse eid="EXO 19:12" /><verse number="13" style="v" sid="EXO 19:13" />ಎಥ್ರಾನವಾಳನ ಕೋಣ್ಬಿ ನಾಛೀಮ್‌ಣು. ಬಂಡೊ ಫೇಕಿನ್ ನತರ್ ತೀರ್‌ನ ಫೇಕಿನ್ ಇನ ಮಾರ‍್ನುಸಸ್ ಮಾರ್ನು. ಅದ್ಮಿರ‍್ಹವೊ, ಜಾನ್ವರ್‌ರ‍್ಹವೊ ಪಹಾಡ್‌ನ ಛೀಮ್ಯುತೊ ಮರ‍್ನುಸ್ ಮರ‍್ನು. ಕತೋಬಿ ರಣ್‌ಶಿಂಗ್ಡಾನೊ ಅವಾಜ಼್ ಖ್ಹಮಜ಼್ ಪಡಾನಿ ವಖ್ಹ್‌ತೆ ಇವ್ಣೆ ಪಹಾಡ್‌ನ ಖನ್ನೆ ಆವ್ಣು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 19:13" /><verse number="14" style="v" sid="EXO 19:14" />ಮೋಶೆ ಪಹಾಡ್‌ಪರ್‌ಥೊ ಉತ್ರಿನ್ ಅದ್ಮಿಕನ ಐನ್, ಇವ್ಣುನ ಆರಾದನೆಕರಾನ ತಯಾರ್‌ಕರ‍್ಯೊ. ಇವ್ಣೆ ಇವ್ಣ ಲುಂಗ್ಡಾವ್‌ನ ಧೊಯ್‌ಲೀನ್ ಶುದ್‌ಹುಯು. <verse eid="EXO 19:14" /><verse number="15" style="v" sid="EXO 19:15" />ತದೆ ಮೋಶೆ ಅದ್ಮಿಯೇವ್ನ, “ತೀನ್ನಾ ದನ್ನಖ್ಹಾಜೆ ತಯಾರ್ ಹುವೊ. ಅನಿ ಬೀಚ್ಮ ಖಿವೊ ಪರ್ಖ್ಹೋಬಿ ತಯೇಡನ ಜೋ಼ಡೆ ನಾಮಳ್ನು” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="EXO 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 19:16" />ಬಿಜೇಕ್ ದನ್ಮ ಚಾ಼ಂದ್ ನಿಕ್ಳಾನಿ ವಖ್ಹ್‌ತೆ ಯೊ ಪಹಾಡ್‌ಪರ್ ಘಲಾರನು, ವಿಜ಼್‌ಳೀಬಿ, ಕಾಳೊಮೋಡ್‌ಬಿ, ತುತ್ತೂರಿನು ಮಹಾನ್ ಅವಾಜ಼್‌ಬಿ ಹುವಾಖ್ಹತರ್ ಇಟಾರಮ ಥೂತೆ ಅದ್ಮಿಖ್ಹಾರುಬಿ ಕಾಪ್ಯು. <verse eid="EXO 19:16" /><verse number="17" style="v" sid="EXO 19:17" />ದೇವ್ನಿ ದರ್ಶನ್ನಖ್ಹಾಜೆ ಮೋಶೆ ಅದ್ಮಿಯೇವ್ನ ಟಾಂಡಾನ ಭಾರ್ ಬುಲೈಲಿನ್ ಆವಖ್ಹತರ್, ಇವ್ಣೆ ಪಹಾಡ್‌ನ ಹೇಟ್ ಭೀರಿಗಯು. <verse eid="EXO 19:17" /><verse number="18" style="v" sid="EXO 19:18" />ಯೆಹೋವ ಆಗ್‌ಮ ಸೀನಾಯಿ ಪಹಾಡ್‌ಪರ್ ಉತ್ರಿನ್ ಆಯೊ. ಇನಖ್ಹಾಜೆ ಯೊ ಪಹಾಡ್ ಅಖ್ಖೂಸ್ ಧುವ್ವಾನಿ ಪೋಯ್‌ಥಿ ಫೈಲೈರ‍್ಹೂಥು. ಯೊ ಧುವ್ವೊ ಆವೀನ ಧುವ್ವಾನಿತ್ರ ಛ಼ಡ್ಯು. ಕಾಹೆತೆ ಪಹಾಡ್ ಅಖ್ಖು ಘಣು ಕಾಪ್ಯು. <verse eid="EXO 19:18" /><verse number="19" style="v" sid="EXO 19:19" />ತುತ್ತೂರಿನು ಅವಾಜ಼್ ಜಾ಼ಖ್ಹತ್ ಹೋತು ಆವಖ್ಹತರ್, ಮೋಶೆನೆ ದೇವ್ನ ಜೋ಼ಡೆ ವಾತೆ ಬೊಲ್ಯೊ. ತದೆ ದೇವ್ನೆ ಊಚ಼ ಘಲಾರ್‌ಥಿ ಇನ ಜ಼ವಾಬ್ ದಿದೊ. <verse eid="EXO 19:19" /><verse number="20" style="v" sid="EXO 19:20" />ಯೆಹೋವ ಸೀನಾಯಿ ಪರ್ಭತ್‌ಪರ್ ಉತ್ರಿನ್ ಆಯೊ. ಇನೆ ಪರ್ಭತ್‌ನ ಉಪ್ಪರ್‌ ಆವ್‌ಕರಿ ಮೋಶೆನ ಬುಲಾವಖ್ಹತರ್ ಇನೆ ಪಹಾಡ್ನಿ ನೋಕ್‌ನ ಗಯೊ. <verse eid="EXO 19:20" /><verse number="21" style="v" sid="EXO 19:21" />ತದೆ ಯೆಹೋವನೆ ಮೋಶೆನ, “ತೂ ಉತ್ರಿನ್ ಜೈ಼ನ್ ಅದ್ಮಿವ್‌ನ ಝೇತಾವ್ಣು. ಅಮ್‌ ಮನ ಇವ್ಣೆ ದೇಖಾನಿ ಆಖ್ಹ್‌ಥಿ ಟಪ್ಪಾನ ಉಲಾಂಗಿನ್ ಯೆಹೋವನ ಖನ್ನೆ ಆಯುತೆ ಇವ್ಣಾಮ ಕೈಯೇಕ್‌ಜ಼ಣು ಮರಿಜಾ಼ಷೆ. <verse eid="EXO 19:21" /><verse number="22" style="v" sid="EXO 19:22" />ಯೆಹೋವನಿ ಝ಼ಗೋಮ ಆವಾಳು ಯಾಜಕರ್‌ಬಿ ಇವ್ಣುನ ಶುದ್ದಿಕರಿಲೇವ್ಣು. ನಾಕತೊ ಯೆಹೋವ ಇವ್ಣುನ ನಾಶ್‌ಕರಿಷ್” ಕರಿಬೋಲ್ಯೊ.<verse eid="EXO 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 19:23" />ಇನ ಮೋಶೆ ಯೆಹೋವಾನ, “ಅದ್ಮಿಖ್ಹಾರು ಸೀನಾಯಿ ಪಹಡ್‌ನ ಛ಼ಡಾನ ಕೋಹೊಯ್ನಿ. ಶನಕತೊ ‘ಪಹಾಡ್‌ನ ಅಶ್‌ಪಿಶ್ ವಾಡ್‌ಗಿ ನಖೈನ್ ತಾರಖ್ಹಾಜೆ ಶುದ್‌ಕರ್” ಕರಿ ಹುಕುಮ್‌ ಕರಿರಾಖ್ಯೊಸ್ನಿ ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 19:23" /><verse number="24" style="v" sid="EXO 19:24" />ಯೆಹೋವ ಮೋಶೆನ, “ತೂ ಉತ್ರಿಜೈ಼ನ್ ಆರೋನ್ನ ತಾರಿ ಜೋ಼ಡ್ಮ ಬುಲೈಲಿನ್ ಉಪ್ಪರ್ ಆವ್ ಕತೋಬಿ ಯಾಜಕರ್‌ಬಿ, ಅದ್ಮಿಖ್ಹಾರುಬಿ ಯೊ ಟಪ್ಪಾನ ಉಲಾಂಗಿನ್ ಯೆಹೋವಕನ ನಾ ಆವ್ಣು. ಉಲಾಂಗಿನ್ ಆಯುತೊ ಮೇ ಇವ್ಣುನ ಒಗ್ಗಿಸ್‌ಮ ನಾಶ್‌ಕರಿಷ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 19:24" /><verse number="25" style="v" sid="EXO 19:25" />ಅಮ್‌ ಮೋಶೆನೆ ಅದ್ಮಿಕನ ಉತ್ರಿನ್ ಜೈ಼ನ್‌ ದೇವ್ನಿ ವಾತೇವ್ನ ಇವ್ಣುನ ಖ್ಹಮ್‌ಜಾ಼ಡ್‌ಯೊ.<verse eid="EXO 19:25" /></para>
  <chapter eid="EXO 19" />
  <chapter number="20" style="c" sid="EXO 20" />
  <para style="s">ದಖ್ಹ್‌ ಹುಕುಮ್‌ಖ್ಹಾರು</para>
  <para style="r">(<ref loc="DEU 5:1-21">ಧರ್ಮೊ 5:1-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 20:1" />ಆ ದೇವ್ನೆ ಬೋಲ್ಯೊತೆ ವಾತೆಖ್ಹಾರಿ: <verse eid="EXO 20:1" /><verse number="2" style="v" sid="EXO 20:2" />“ತೂ ಗುಲಾಮ್‌ಹುಯಿನ್ ಥೋತೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮಾಥು ತುನ ಭಾರ್‌ ಲಾಯೊತೆ ‘ತಾರೊ ಯೆಹೋವ ದೇವ್ ಮೇಸ್’ <verse eid="EXO 20:2" /><verse number="3" style="v" sid="EXO 20:3" />ಮನ ಮ್ಹೇಲಿನ್ ತುಮುನ ಬಿಜು಼ ದೇವ್‌ಖ್ಹಾರು ನಾರ‍್ಹೇವ್ಣು. <verse eid="EXO 20:3" /><verse number="4" style="v" sid="EXO 20:4" />“ಖಿವು ಮೂರತ್‌ನಾಬಿ ನಾಕರ‍್ನು. ಆಬ್‌ಮ ರ‍್ಹವೊ ಧರ್ತಿಪರ್ ರ‍್ಹವೊ, ಧರ್ತಿನ ಹೇಟ್‌ಪಾಣಿಮ ಛಾ಼ತೆ ಶನೂ ರೂಪ್‌ನಾಬಿ ನಾಕರಿರಾಕ್ಣು. <verse eid="EXO 20:4" /><verse number="5" style="v" sid="EXO 20:5" />ಯೋಖ್ಹಾರನ ಆಡುಬಿ ನಾಪಡ್ನು, ಪೂಜ಼ ನಾಕರ‍್ನು. ಶನಕತೊ ತಾರೊ ದೇವ್ ಯೆಹೋವ ಹುಯಿರ‍್ಹೋತೆ ಮನ ಮಳಾನು ಮರ‍್ಯಾದಿನ ಬಿಜೇಕ್‌ನ ಮ್ಹೇಲಿ ಕೋದೆವ್ನಿ. ಇನಖ್ಹಾಜೆ ಮನ ಬಳಾಪೊ ಕರವಾಳನಿ ಬಾರೇಮ ಇವ್ಣಿ ಬಾನಿ ದೋಷ್‌ನಿ ಫಲ್ನ ಇವ್ಣ ಲಡ್ಕಾವ್‌ಪರ್, ತೀನ್ ಚಾರ್ ಮುಂಡಿಲಗು ಲೀನ್‌ಅಯಿಶ್. <verse eid="EXO 20:5" /><verse number="6" style="v" sid="EXO 20:6" />ಕತೋಬಿ ಮನ ಪ್ಯಾರ್‌ಕರಿನ್ ಹುಕುಮ್‌ನ ಪಾಡಿಚಾ಼ಲವಾಳಪರ್‌ ಹಜಾ಼ರ್ ಮುಂಡಿಲಗು ಮೇ ಇವ್ಣುನ ದಯಾ ಕರಿಶ್. <verse eid="EXO 20:6" /><verse number="7" style="v" sid="EXO 20:7" />ತಾರೊ ದೇವ್‌ಹುಯಿರ‍್ಹೊತೆ ಯೆಹೋವನು ನಾಮ್ನ ಬೆಕಾರ್‌ಕಾಮ್ನಖ್ಹಾಜೆ ನಾಪಾಡ್ನು. ಯೆಹೋವ ಇನ ನಾಮ್ನ ಬೆಕಾರ್‌ಕಾಮ್ನಖ್ಹಾಜೆ ಪಾಡವಾಳನ ನಿಶತ್ ದಿಶ್‌ಕೊಂತೆ ಮ್ಹೇಲಿಶ್‌ ಕೊಯ್ನಿ. <verse eid="EXO 20:7" /><verse number="8" style="v" sid="EXO 20:8" />“ಸಬ್ಬತ್ ದನ್ನಾ ದೇವ್ನೊ ಪರಿಶುದ್ ದನ್‌ಕರಿ ಚ಼ಲಾವನ ಯಾದ್ಮ ರಾಕ್ಣು. <verse eid="EXO 20:8" /><verse number="9" style="v" sid="EXO 20:9" />ಛೋ಼ ದನ್‌ಖ್ಹಾರು ತೂ ರಾಬಿನ್‌ ತಾರು ಕಾಮ್‌ಖ್ಹಾರುಸ್ ಕರಿಲೇವ್ಣು. <verse eid="EXO 20:9" /><verse number="10" style="v" sid="EXO 20:10" />ಕತೋಬಿ ಖ್ಹಾತ್‌ನೊ ದನ್ ತಾರೊ ದೇವ್‌ಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವನಖ್ಹಾಜೆ ಛಾ಼ತೆ ಅರಾಮ್‌ನೊ ದನ್ ಹುಯಿರುಸ್. ಯೊ ದನ್ಮ ತುಮೆ ಖಿವು ಕಾಮ್ನಾಬಿ ನಾಕರ‍್ನು. ತಾರ ಪರ್ಖ್ಹೊ ತಯೇಡ ಲಡ್ಕ, ಪರ್ಖ್ಹೊ ಆಳ್‌, ತಯೇಡ ಆಳ್‌, ಜಾನ್ವರ್‌ಖ್ಹಾರು ಜಿನ್‌ಜಿನಾವರ್ ತಾರ ಗಾಮ್ಮ ಛಾ಼ತೆ ಪರ್‌ದೇಖ್ಹ್‌ವಾಳು ಜಿನು ಖಿವು ಕಾಮ್ನಬಿ ನಾಕರ‍್ನು. <verse eid="EXO 20:10" /><verse number="11" style="v" sid="EXO 20:11" />ಛೋ಼ ದನ್ಮ ಯೆಹೋವನೆ ಆಬ್ ಧರ್ತಿನಾಬಿ, ದರ‍್ಯಾವ್‌ನಾಬಿ, ಇನಾಮ ಛಾ಼ತೆ ತಮಾಮ್‌ನಾಬಿ ತಯಾರ್‌ಕರಿನ್, ಖ್ಹಾತ್‌ನ ದನ್ಮ ಅರಾಮ್ ಕರ‍್ಯೊ. ಇನಖ್ಹಾಜೆ ಯೆಹೋವನೆ ಸಬ್ಬತ್ ದನ್ನಾ ಇನು ಪರಿಶುದ್ಧ್ ದನ್‌ಹುಯಿರ‍್ಹವಾದೆ ಕರಿ ಆಶೀರ್ವಾದ್‌ ಕರ‍್ಯೊ. <verse eid="EXO 20:11" /><verse number="12" style="v" sid="EXO 20:12" />“ತಾರ ಆಯಬಾನ ಮರ‍್ಯಾದಿ ದೇವ್ಣು, ಮರ‍್ಯಾದಿ ದಿದೂತೊ ತಾರೊ ದೇವ್ ಯೆಹೋವ ತುನ ದೇಸ್‌ತೆ ದೇಖ್ಹ್‌ಮ ತೂ ಜಾ಼ಖ್ಹತ್ ಹಗಾಮ್ ಜಿವಿಷ್. <verse eid="EXO 20:12" /><verse number="13" style="v" sid="EXO 20:13" />“ಖೂನ್‌ ನಾಕರ‍್ನು. <verse eid="EXO 20:13" /><verse number="14" style="v" sid="EXO 20:14" />“ವ್ಯಬಿಚಾರ್ ನಾಕರ‍್ನು. <verse eid="EXO 20:14" /><verse number="15" style="v" sid="EXO 20:15" />“ಚೋ಼ರ್ ನಾಕರ‍್ನು. <verse eid="EXO 20:15" /><verse number="16" style="v" sid="EXO 20:16" />“ಬಿಜೇಕ್‌ ಜ಼ಣಪರ್ ಝೂ಼ಟಿ ಸಾಕ್ಷಿ ನಾಬೋಲ್ನು. <verse eid="EXO 20:16" /><verse number="17" style="v" sid="EXO 20:17" />“ಬಿಜೇಕ್ ಜ಼ಣನ ಘರ್‌ನ ದೇಖಿನ್ ಆಖ್ಹ್ ನಾಕರ‍್ನು. ಬಿಜೇಕ್‌ ಜ಼ಣಾನಿ ಬಾವಣ್, ದಾಸ, ದಾಸಿ, ಢಾಂಡು, ಗಧೇಡೊ ಬಿಜು಼ ಖಿವಾನಬಿ ಆಖ್ಹ್‌ನಾಕರ‍್ನು.”<verse eid="EXO 20:17" /></para>
  <para style="s">ಅದ್ಮಿಖ್ಹಾರು ಡರ‍್ಯುತೆ</para>
  <para style="r">(<ref loc="DEU 5:22-33">ಧರ್ಮೊ 5:22-33</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 20:18" />ಯೊ ಘಲಾರ್, ವಿಜ಼್‌ಳಿ, ತುತ್ತೂರಿನು ಅವಾಜ಼್, ಬಿಜೂ಼ ಪಹಾಡ್‌ಥಿ ಭಾರ್‌ ನಿಕ್‌ಳುಕರ್ತುಥೂತೆ ಧುವ್ವಾನ ದೇಖಿನ್ ಅದ್ಮಿಖ್ಹಾರು ಕಾಪ್ತುಹುಯಿನ್ ದೂರಸ್ ಭೀರಿಗಯು. <verse eid="EXO 20:18" /><verse number="19" style="v" sid="EXO 20:19" />ಇವ್ಣೆ ಮೋಶೆನ, “ತೂಸ್ ಹಮಾರ ಜೋ಼ಡೆ ವಾತೆಬೋಲ್ ಹಮೆ ಖ್ಹಮ್‌ಜೆಸ್. ಕತೋಬಿ ದೇವ್ ಹಮಾರಿ ಜೋ಼ಡೆ ವಾತೆ ಬೋಲ್ಯೊತೊ ಹಮೆ ಮರಿಜಾಶು” ಕರಿ ಬೋಲ್ಯು. <verse eid="EXO 20:19" /><verse number="20" style="v" sid="EXO 20:20" />ಇನ ಮೋಶೆನೆ ಅದ್ಮಿವ್‌ನ, “ಡರೊ ನಕೊ, ದೇವ್ ತುಮುನ ತರೀಪ್‌ಶ ಕರಾನಖ್ಹಾಜೆ, ತುಮೆ ಪಾಪ್ ನಾಕರ‍್ನುತೆ ಇನಪರ್ನಿ ಡರ್‌ ತುಮುನ ರ‍್ಹೇವ್ಣುಕರಿಬಿ ಉತ್ರಿ ಐರ‍್ಹೋಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 20:20" /><verse number="21" style="v" sid="EXO 20:21" />ಅದ್ಮಿವ್ ದೂರ್‌ಮ ಭಿಯೂಥು. ಮೋಶೆನೆ ದೇವ್‌ರ‍್ಹವಾನು ಯೊ ಅಂಧಾರ ವಾದ್ಳಾನ ಖನ್ನೆ ಗಯೊ.<verse eid="EXO 20:21" /></para>
  <para style="s">ಬಲೀನಿ ಚಾ಼ಚ಼ರ್‌ನಿ ಬಾರೇಮ ನಿಯಮ್‌</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 20:22" />ಯೆಹೋವನೆ ಮೋಶೆನ ಅಮ್‌ಬೋಲ್ಯೊ, “ತೂ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಬೋಲ್ನು ಶಾತ್‌ಕತೊ ‘ಮೇ ಆಬ್‌ಪರ್‌ಥು ತುಮಾರಿ ಜೋ಼ಡೆ ವಾತೆ ಬೋಲ್ಯೊತೆ ತುಮೆ ದೇಖಿರಾಖ್ಯಸ್. <verse eid="EXO 20:22" /><verse number="23" style="v" sid="EXO 20:23" />ಮನ ಮ್ಹೇಲಿನ್ ತುಮೆ ಖ್ಹೊನ್ನ ರೂಪಾನು ದೇವ್ನ ನಾ ಕರ್‌ನು. <verse eid="EXO 20:23" /><verse number="24" style="v" sid="EXO 20:24" />ತುಮೆ ಮಾರಿ ಚಾ಼ಚ಼ರ್‌ನ ಮಾಟಿಥಿ ಕರ‍್ನು. ತುಮೆ ಇನ ಉಪ್ಪರ್ ತುಮಾರಿ ಅಖ್ಖೀಸ್ ಶರೀರ್‌ನು ಬಲೀನ, ಸಮಾಧಾನ್ನಿ ಬಲಿ, ಢಾಂಡ ಮೇಂಢಾವ್ನ ಸಮರ್ಪಣ್‌ಕರ‍್ನು. ಮೆ ಮಾರ ನಾಮ್ನ ಮರ‍್ಯಾದೆ ದ್ಯವಾನಿತರನಿ ಅಖ್ಖೀಸ್ ಝ಼ಗೋಮಬಿ ಮೇ ತುಮಾರಕನ ಅಯಿನ್ ತುಮುನ ಆಶೀರ್ವಾದ್‌ ಕರಿಶ್. <verse eid="EXO 20:24" /><verse number="25" style="v" sid="EXO 20:25" />ತುಮೆ ಮಾರಖ್ಹಾಜೆ ಬಂಡಾಥಿ ಚಾ಼ಚ಼ರ್‌ನ ಭಾಂದನುರ‍್ಹಯೂತೊ, ಇನ ಟಕಾಯಹುಯ ಬಂಡೇಥಿ ನಾಭಾಂದ್‍ಣು. ಶನಕತೊ ಉಳಿ, ನತರ್ ಬಿಜು಼ ಖಿವೂಬಿ ಇನ ಉಪ್ಪರ್ ಉಪಯೋಗ್ ಕರ‍್ಯುತೊ ಯೊ ಮೈಲು ಹುಯಿರ‍್ಹುಸ್. <verse eid="EXO 20:25" /><verse number="26" style="v" sid="EXO 20:26" />ಆಸ್ ಕಾಹೆತೆ ತುಮಾರು ಉಘಾಡು ಶರೀರ್ ಚಾ಼ಚ಼ರ್‌ನಪರ್ ದೆಖಾವ್ಣುನಾತೆ ಖಿಡ್‌ಖೀಯೆಪರ್‌ಕರಿ ನಾಛ಼ಡ್ನು” ಕರಿ ಹುಕುಮ್ ಕರ‍್ಯೊ.<verse eid="EXO 20:26" /></para>
  <chapter eid="EXO 20" />
  <chapter number="21" style="c" sid="EXO 21" />
  <para style="s">ಗುಲಾಮ್‌ಗಿರಿನಿ ಬಾರೇಮ</para>
  <para style="r">(<ref loc="DEU 15:12-18">ಧರ್ಮೊ 15:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 21:1" />ಹಮ್ಕೆ ತೂ ದ್ಯವಾನು ನ್ಯಾವ್ನು ನಿಯಮ್‌ಖ್ಹಾರು ಖಿವುಕತೊ; <verse eid="EXO 21:1" /><verse number="2" style="v" sid="EXO 21:2" />“ತುಮಾರಮ ಕೋಣ್‌ತೋಬಿ ಇಬ್ರಿಯಾನ ಏಕ್‌ಜ಼ಣಾನ ಗುಲಾಮ್‌ಗಿರಿನ ಖ್ಹಾಜೆ ಲೀಲಿದೂತೊ, ಯೊ ಇಬ್ರಿಯವಾಳೊ ಛೋ಼ ವರಖ್ಹ್ ಗುಲಾಮ್ ಹುಯಿರ‍್ಹಿನ್ ಖ್ಹಾತ್ನ ವರಖ್ಹ್‌ಮ ಶಾತ್ಬಿ ನಾದೇವ್ಣುತೆ ಛುಟ್ಕಾರ್‌ ಹುಯಿನ್ ಚ಼ಲ್ಯುಜಾ಼ವ್ಣು. <verse eid="EXO 21:2" /><verse number="3" style="v" sid="EXO 21:3" />ಪರ್ಖ್ಹೊ ಎಕ್ಲೋಸ್ ಐರ‍್ಹೋತೊ ಎಕ್ಕಲಸ್ ನಿಕ್ಳಿಜಾ಼ವ್ಣು. ವ್ಯಹಾಕರಿನ್ ಐರ‍್ಹೋತೊ ಇನಿ ಬಾವಣ್‌ಬಿ ಇನ ಜೋ಼ಡೆ ಜಾ಼ವದೆ. <verse eid="EXO 21:3" /><verse number="4" style="v" sid="EXO 21:4" />ಇನೊ ಯಜಮಾನ್ ಇನ ಕಾಯ್‌ತೊಬಿ ವ್ಯಾಹ ಕರೈರಾಖ್ಯೊತೊ ಯೊ ಬಾವಣ್‌ಮ ಪರ್ಖ್ಹೊ ನತರ್ ತಯೇಡ ಲಡ್ಕಾ ಹುಯಿರ‍್ಹುತೊ, ಯೊ ಬಾವಣ್‌ಬಿ ಯೊ ಲಡ್ಕಾವ್‌ಬಿ ಯಜಮಾನ್ನಿ ಶೊತ್‌ಹುಯಿರ‍್ಹಿಷೆ. ಗುಲಾಮ್ ಯೊ ಎಕ್ಲೋಸ್ ನಿಕ್ಳಿಜಾ಼ವ್ಣು.” <verse eid="EXO 21:4" /><verse number="5" style="v" sid="EXO 21:5" />ಕತೋಬಿ ಯೊ ಗುಲಾಮ್, “ಮೆ ಮಾರ ಯಜಮಾನ್ನಬಿ, ಮಾರಿ ಬಾವಣ್ ಲಡ್ಕಾವ್ನ ಪ್ಯಾರ್‌ ಕರುಸ್. ಇನಖ್ಹಾಜೆ ಮೇ ಛುಟ್ಕಾರ್‌ಹುಯಿನ್ ಜಾ಼ವಾನ ಮನ ದಿಲ್‌ಕೊಯ್ನಿ” ಕರಿ ಬೋಲ್ಯುತೊ, <verse eid="EXO 21:5" /><verse number="6" style="v" sid="EXO 21:6" />ತದೆ ಇನೊ ಯಜಮಾನ್ ದೇವ್‌ಕನ ಇನ ಬುಲೈಲಿನ್ ಐನ್ ದರ್ವಾಜಕನ ಖನ್ನೆ ನತರ್ ಬಾಕಲ್‌ನಿ ಪಟ್ಟಿಕನ ಭಿರಾಖಿನ್ ಇನ ಕಾನ್ನ ಖ್ಹುಯ್‌ಥಿ ಟೋಚಿನ್ ಖ್ಹಣೇದ್ ಕರ‍್ನು. ತದೆ ಯೊ ಹಮೇಶ ಇನ ಗುಲಾಮ್ ಹುಯಿರ‍್ಹಿಷೆ. <verse eid="EXO 21:6" /><verse number="7" style="v" sid="EXO 21:7" />ಕೋಣ್‌ತೋಬಿ ಛೋ಼ರಿನ ದಾಸಿಕರಿನ್ ವೇಚ್ಯುತೊ, ಗುಲಾಮ್ ಛುಟ್ಕಾರ್‌ಹುಯಿನ್ ಜಾ಼ವನಿ ಪರಕ್ಮ ಯೊ ಛುಟ್ಕಾರ್‌ಹುಯಿನ್ ನಾಜಾ಼ವ್ಣು. <verse eid="EXO 21:7" /><verse number="8" style="v" sid="EXO 21:8" />ಇನ ಬೋಲಿರಾಖ್ಯುತೆ ಯಜಮಾನ್ನಿ ಜೋ಼ಡ್ಮ ಎಕ್ ವೇಳ್ ಪಸಂದ್ ನಾರ‍್ಹಯುತೊ ಹೈರಿತೆನ ಛೋ಼ಡೈಲಾವನಿತರ ಯೊ ಮೋಕ ಕರಿ ದೇವ್ಣು. ಯೊ ದಿದೋತೆ ವಾತ್ನ ಛು಼ಕ್ಯೊತೆಖ್ಹಾಜೆ ಯೊ ಹೈರಿತೆನ ವೇಚಾ಼ನ ಇನ ಅದಿಕಾರ್‌ಕೊಯ್ನಿ. <verse eid="EXO 21:8" /><verse number="9" style="v" sid="EXO 21:9" />ಎಕ್ ವೇಳ್ಮ ಯೊ ಇನ ಛಿಯ್ಯಾನ ಇನ ಬೋಲಿರಾಖ್ಯೊತೊ ಛೋ಼ರಿನಿತರ ಯೊ ಹೈರಿತೆನ ಸೋಚಿಲೇವ್ಣು. <verse eid="EXO 21:9" /><verse number="10" style="v" sid="EXO 21:10" />ಯಜಮಾನ್ ಬಿಜೇಕ್ ಜ಼ಣೀನ ವ್ಯಹಾಹುಯೂತೊ ಪಹಿಲೀನ ಖಾಣು, ಲುಂಗ್ಡು, ಬಾವಣ್ ಬಾವ್ರಿನಿ ಹಕ್‌ಮ ಕಮ್ ನಾಕರ‍್ನು. <verse eid="EXO 21:10" /><verse number="11" style="v" sid="EXO 21:11" />ಆ ತೀನ್‌ಮ ಖಿವಾನಬಿ ನಾಚ಼ಲಾಯುತೊ ಹೈರಿತೆ ಶಾತ್‌ಬಿ ನಾದೀನ್ ಛುಟ್ಕಾರ್ ಹುಯಿನ್ ಜ಼ಯೆಜಾ಼ಯ್.<verse eid="EXO 21:11" /></para>
  <para style="s">ಖ್ಹತಾಪ್ಣಿವ್‌ನಿ ಬಾರೇಮ ಖಾನುಲ್‌</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 21:12" />ಅದ್ಮಿನ ಮಾರಿನ್ ಖೂನ್ ಕರವಾಳನ ಖ್ಹಚೆಂಬಿಬಿ ಮರಣ್ಣಿ ನಿಶತ್‌ಹೋಣು. <verse eid="EXO 21:12" /><verse number="13" style="v" sid="EXO 21:13" />ಕತೋಬಿ ಖೂನ್ ಕರ‍್ನುಕರಿ ಸೋಚ್‌ಕೊಂತೆ ದೇವ್ನಿ ಖ್ಹೂಜ಼್‍ಥಿ ಯೊ ಖೂನ್ ಚಾ಼ಲಿರ‍್ಹು ಉಷೇತೊ, ಯೊ ಖೂನಿ ಮೆ ನೇಮಕ್‌ ಕರ‍್ಯೊತೆ ಝ಼ಗೋನ ಜಾ಼ವದೆ. <verse eid="EXO 21:13" /><verse number="14" style="v" sid="EXO 21:14" />ಕತೋಬಿ ಏಕ್‌ಜ಼ಣೊ ಇನ ಭೀಡೆವಾಳನ ಖೂನ್ ಕರಾನಿ ಖ್ಹೂಜ಼್‌ಥೀಸ್ ಇನ ಠಗೈನ್ ಮಾರ‍್ಯುತೊ, ಯೊ ಮರಾನಿಘೋಣಿ ತೂ ಇನ ಚಾ಼ಚ಼ರ್‌ಕಂಥು ಬುಲೈಲಿಜೈ಼ನ್ ಮಾರಿನಾಕ್ಣು. <verse eid="EXO 21:14" /><verse number="15" style="v" sid="EXO 21:15" />ಕೋಣ್‌ತೋಬಿ ಇನಿ ಆಯಾನ ರ‍್ಹವೊ ಬಾನ ರ‍್ಹವೊ ಮಾರ‍್ಯೊತೊ ಖ್ಹಚೆಂಬಿ ಯೊ ಮರ‍್ನುಸಸ್ ಮರ‍್ನು. <verse eid="EXO 21:15" /><verse number="16" style="v" sid="EXO 21:16" />ಕೋಣ್‌ತೋಬಿ ಎಕ್ ಅದ್ಮಿನ ಚೋ಼ರಿಕರಿ ಲೀಜೈ಼ನ್ ವೇಚ್ಯೊತೊ ನತರ್ ಯೊ ಧರೈಜಾ಼ವಾನಿ ವಖ್ಹ್‌ತೆ, ಚೋ಼ರಿ ಹುಯ್ಗಯೊಹುಯೊ ಇನಿ ಜೋ಼ಡ್ಮ ರ‍್ಹಿಯೂತೊ ಇನ ಮರಣ್ಣಿ ನಿಶತ್‌ಹೋಣು. <verse eid="EXO 21:16" /><verse number="17" style="v" sid="EXO 21:17" />ಆಯಾನ ರ‍್ಹವೊ ಬಾನ ರ‍್ಹವೊ ಶಬರ್‌ದ್ಯವಾಳನ ಮರಣ್ಣಿ ನಿಶತ್‌ಹೋಣು. <verse eid="EXO 21:17" /><verse number="18" style="v" sid="EXO 21:18" />ಬೇಜ಼ಣ ಲಡೈಭೀಡುಕರಾನಿ ವಖ್ಹ್‌ತೆ ಏಕ್‌ಜ಼ಣೊ ಬಿಜೇಕ್‌ಜ಼ಣಾನ ಬಂಡೇಥಿ ರ‍್ಹವೊ, ಮುಕ್ಕೀಥಿರ‍್ಹವೊ ಮಾರ‍್ಯೊತೆಖ್ಹಾಜೆ ಘಾವ್‌ಹುವಾಳೊ ಮರ‍್ಯೊಕೊಂತೆ ಥೋಡು ಹಗಾಮ್ ಛಾ಼ದ್ರಿ ಧರಿನ್, <verse eid="EXO 21:18" /><verse number="19" style="v" sid="EXO 21:19" />ಇನವಾರ್ ಉಠಿನ್ ಲಠ್ಠೊ ಟೇಕಿನ್ ಚಾ಼ಲುಕರ್ತೊ ಉಷೇತೊ, ಅಥ್ರಾನಿ ವಖ್ಹತ್‌ಮ ಮಾರಹುಯಾನ ನಿಶತ್ ನಾದೇವ್ಣು. ಕತೋಬಿ ಮಾರ್ ಖಾದುಹುಯು ಅದ್ಮಿ ಅಛ್ಛು಼ ಹುವಾಲಗೂಬಿ ಹುವಾನಿ ಖರ್ಚ್‌ನ ಭರಿನ್ ಅಛ್ಛು಼ಕರ‍್ನು. <verse eid="EXO 21:19" /><verse number="20" style="v" sid="EXO 21:20" />ಏಕ್‌ಜ಼ಣೊ ಇನ ದಾಸನರ‍್ಹವೊ, ದಾಸಿನರ‍್ಹವೊ ಲಠ್ಠೇಥಿ ಮರಿಜಾ಼ವಯೆತ್ರೆ ಮಾರ‍್ಯುತೊ, ಇನ ಬರಬರ‍್ನಿ ನಿಶತ್‌ಹೋಣು. <verse eid="EXO 21:20" /><verse number="21" style="v" sid="EXO 21:21" />ಯೊ ದಾಸ ತದೇಸ್‌ ನಾ ಮರಿನ್ ಏಕ್‌ಬೇದನ್ ಬಚಿರ‍್ಹಿಯೂತೊ, ಯಜಮಾನ್ನ ನಿಶತ್ ನಾದೇವ್ಣು. ಶನಕತೊ ಯೊ ದಾಸ ಇನು ಶೊತ್‌ಹುಯಿರ‍್ಹೊಸ್. <verse eid="EXO 21:21" /><verse number="22" style="v" sid="EXO 21:22" />ಪರ್ಖ್ಹಾ ಲಡೈ ಭೀಡಾನಿವಖ್ಹ್‌ತೆ ಬೇಜೂನಿ ತಯೇಡಾನ ಮಾರ್‌ಲಾಗಿನ್ ಇನ ಪೇಟ್‌ಪಡಿಗಯೂತೊ, ಯೊ ಬಾಯ್ಕೊನೊ ಬಾವ್ರಿ ಬೋಲಯೆತ್ರೆ ಅಜು಼ ನ್ಯಾವ್‌ಮ ತೀರ್ಮಾನ್ ಕರಾಯೆತ್ರೆ ದಂಡ್‌ನ ಯೊ ಮಾರ‍್ಯೊಹುಯೊ ಭರ‍್ನು. <verse eid="EXO 21:22" /><verse number="23" style="v" sid="EXO 21:23" />ಬಿಜು಼ ಶನೂಬಿ ಲುಕ್ಷಾನ್ ಹುಯುತೊ ಜಾನ್ನ ಬದಲ್ ಜಾನ್‌ ದೇವ್ಣು. <verse eid="EXO 21:23" /><verse number="24" style="v" sid="EXO 21:24" />ಡೋಳಾನ ಡೋಳೊ, ದಾತ್ನ ದಾತ್‌, ಹಾತ್ನ ಹಾತ್, ಗೋಡಾನ ಗೋಡೊ, <verse eid="EXO 21:24" /><verse number="25" style="v" sid="EXO 21:25" />ದಾಗ್ನ ದಾಗ್, ಘಾವ್ನ ಘಾವ್, ಮಾರ‍್ನ ಮಾರ್, ಅಮ್ನಿ ಪರಕ್ ಹರ್ ನಿಶತ್ ದೇವ್ಣು. <verse eid="EXO 21:25" /><verse number="26" style="v" sid="EXO 21:26" />ಖಿವೊ ತೋಬಿ ಇನ ಗುಲಾಮ್‌ನ ನತರ್ ದಾಸಿನ ಡೋಳಾನ ಮಾರಿನ್ ಲುಕ್ಷಾನ್ ಕರ‍್ಯುತೊ ಯೊ ಡೋಳಾನ ಬದಲ್ ಇವ್ಣುನ ಯೊ ಛುಟ್ಕಾರ್‌ಕರಿನ್ ಮೋಕಲ್‌ನು. <verse eid="EXO 21:26" /><verse number="27" style="v" sid="EXO 21:27" />ಏಕ್‌ಜ಼ಣೊ ದಾಸನ ನತರ್ ದಾಸಿನ ದಾತ್ನ ಜ಼ಂಜ್ರಾಯೊತೊ ಯೊ ದಾತ್ನ ಬದಲ್ ಇವ್ಣುನ ಛುಟ್ಕಾರ್ ಕರಿನ್ ಮೋಕಲ್ನು.<verse eid="EXO 21:27" /></para>
  <para style="s">ಯಜಮಾನವ್ನು ಜಿಮೆದಾರಿಖ್ಹಾರು</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 21:28" />ಖಿವುತೋಬಿ ಎಕ್ ಢಾಂಡು ಪರ್ಖ್ಹಾನ ರ‍್ಹವೊ, ತಯೇಡಾನ ರ‍್ಹವೊ, ಠೋಖ್ಹಿನ್ ಮಾರ‍್ಯುತೊ ಯೊ ಢಾಂಡಾನ ಬಂಡೊ ಫೇಖಿನ್ ಮಾರ‍್ನುಸಸ್ ಮಾರ‍್ನು. ಇನಿ ಬೋಟಿನ ನಾಖಾವ್ಣು. ಕತೋಬಿ ಯೊ ಢಾಂಡಾನೊ ಯಜಮಾನ್ ದೋಷಿ ಕೊಹುಯಿರ‍್ಹಿಷೆನಿ. <verse eid="EXO 21:28" /><verse number="29" style="v" sid="EXO 21:29" />ಕತೋಬಿ ಯೊ ಢಾಂಡು ಠೋಖ್ಹವಾಳುಕರಿ ಯಜಮಾನ್ನ ಮಾಲುಮ್‌ ರ‍್ಹೀನ್‌ಬಿ ಯೊ ಇನ ಭಾಂದ್ಯೊಕೊಂತೆ ಖ್ಹಾಜೆ ಯೊ ಪರ್ಖ್ಹಾನ ರ‍್ಹವೊ, ತಯೇಡಾನ ರ‍್ಹವೊ ಮಾರಿನಾಖ್ಯುತೊ ಯೊ ಢಾಂಡಾನ ಬಂಡೊ ಫೇಕಿನ್ ಮಾರ‍್ನು. ಕಾಹೆತೆ ಇನು ಯಜಮಾನಬಿ ಮರಣ್ಣಿದಂಡನೆನ ಕಾರಣ್ ಉಷೆ. <verse eid="EXO 21:29" /><verse number="30" style="v" sid="EXO 21:30" />ಕತೋಬಿ ಯೊ ಯಜಮಾನ್ ರಪ್ಯದ್ಯವಾನಿ ತೀರ್ಮಾನ್ ಹುಯೂತೊ ಯೊ ಇನ ಬೋಲೈರ‍್ಹುಸ್ತೆ ರಪ್ಯಾನ ಭರಿನ್ ಇನ ಜಾನ್ನ ಬಚೈ಼ಲಾವದೆ. <verse eid="EXO 21:30" /><verse number="31" style="v" sid="EXO 21:31" />ಯೊ ಢಾಂಡು ಛೋ಼ಕ್ರಾನ ರ‍್ಹವೊ ನತರ್ ಛೋ಼ಕ್ರಿನ ರ‍್ಹವೊ ಠೋಖ್ಹ್‌ಯುತೊ ಆಸ್ ನ್ಯಾವ್‍ನಿ ಪರಕ್ಮ ಇನ ಯಜಮಾನ್ನ ಹೋಣು. <verse eid="EXO 21:31" /><verse number="32" style="v" sid="EXO 21:32" />ದಾಸ ರ‍್ಹವೊ ನತರ್ ದಾಸಿನ ರ‍್ಹವೊ ಢಾಂಡು ಠೋಖ್ಹ್‌ಯುತೊ ದಾಸ ನತರ್ ದಾಸಿನ ಯಜಮಾನ್ನ ಡೋಡಿಖ್ಹ್‌ ರೂಪಾನ ಪಾವ್ಲನ ದೇವ್ಣು, ಅಜು಼ ಯೊ ಢಾಂಡಾನ ಬಂಡೊ ಫೇಕಿನ್ ಮಾರ‍್ನು. <verse eid="EXO 21:32" /><verse number="33" style="v" sid="EXO 21:33" />ಏಕ್‌ಜ಼ಣೊ ಖಾಡ್ ಖೋಂದ್ಯೊತೊ ನತರ್ ಖೋಂದಿನ್ ಇನ ನಾ ಮೂಚಿನ್ ಇನಾಮ ಢಾಂಡು ರ‍್ಹವೊ, ಗಧೇಡೊ ರ‍್ಹವೊ ಯೊ ಖಾಡ್‌ಮ ಪಡಿನ್ ಮರ‍್ಯುತೊ, <verse eid="EXO 21:33" /><verse number="34" style="v" sid="EXO 21:34" />ಯೊ ಖಾಡ್‌ನ ಖೋಂದಾಯೊ ಹುಯೊ ಹುಯೂತೆ ನಷ್ಟಂನ್ನ ಬರೊಬರ್‌ಥಿ ಪೈಸ ಬದಲ್ ದೇವ್ಣು. ಢಾಂಡಾನ ಯಜಮಾನ್ನ ಹಕ್ಲಾಲ್ ಹುವಾಯೆತ್ರೆ ದಾಮ್ನ ದೇವ್ಣು. ಮರ‍್ಯುತೆ ಢಾಂಡಾನ ಯೋಸ್ ಪಾಡಿಲಿಯೆಜಾ಼ಯ್. <verse eid="EXO 21:34" /><verse number="35" style="v" sid="EXO 21:35" />ಏಕ್‌ಜ಼ಣಾನೊ ಢಾಂಡೊ ಬಿಜೇಕ್‌ನ ಢಾಂಡಾನ ಠೋಖ್ಹಿನ್ ಮಾರ‍್ಯುತೊ, ಜಿವ್ತುರ‍್ಹವಾಳು ಢಾಂಡಾನ ಪೈಸನ ಏಚಿನ್ ಇನ ದಾಮ್ನ ಭರ‍್ನು. ಮರಸ್ತೆ ಢಾಂಡಾನ ಭೇಜ಼ಣೂಬಿ ಸಮಾಥಿ ವಾಟಪಾಡಿ ಲೇವ್ಣು. <verse eid="EXO 21:35" /><verse number="36" style="v" sid="EXO 21:36" />ಕತೋಬಿ ಯೊ ಢಾಂಡು ಪಹಿಲೆಥುಬಿ ಠೋಖ್ಹವಾಳುಕರಿ ಇನ ಯಜಮಾನ್ನ ಮಾಲುಮ್ ರ‍್ಹೀನ್‌ಬಿ ಇನ ಭಾಂದ್ಯೊಕೊಂತೆ ಇನಖ್ಹಾಜೆ ಯೊ ಢಾಂಡಾನ ಬದಲ್ ಢಾಂಡಾನ ದೇವ್ಣುಸ್ ದೇವ್ಣು. ಕತೋಬಿ ಮರ‍್ಯುತೆ ಢಾಂಡಾನ ಯೋಸ್ ಪಾಡಿಲಿಯೆಜಾ಼ಯ್.<verse eid="EXO 21:36" /></para>
  <chapter eid="EXO 21" />
  <chapter number="22" style="c" sid="EXO 22" />
  <para style="s">ಬದಲ್ ದ್ಯವಾನಿ ಬಾರೇಮ ಖಾನುಲ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 22:1" />ಏಕ್‌ಜ಼ಣೊ ಢಾಂಡಾನ ರ‍್ಹವೊ, ಮೇಂಢಾನ ರ‍್ಹವೊ ಚೋ಼ರಿಕರಿನ್ ವ್ಹಾಡ್‌ಯುತೊ ನತರ್ ವೇಚ್ಯುತೊ ಯೊ ಎಕ್ ಢಾಂಡಾನ ಬದಲ್ ಪಾಚ಼್‌ ಢಾಂಡವ್ನ ಎಕ್ ಮೇಂಢಾನ ಬದಲ್ ಚಾರ್ ಮೇಂಢಾವ್ನ ದೇವ್ಣು. <verse eid="EXO 22:1" /><verse number="2" style="v" sid="EXO 22:2" />ಎಕ್ ಚೋ಼ರ್ ಚೋ಼ರ್ ಕರಾನಿವಖ್ಹ್‌ತೆಸ್ ಹಾತ್ಮ ಖ್ಹಪ್‌ಡೈಜಿನ್ ಇನ ಮಾರ್‌ದ್ಯವಾಮ ಮರಿಗಯೊತೊ ಇನ ಖೂನ್ ಗಣ್ತಿ ನಾಕರ‍್ನು. <verse eid="EXO 22:2" /><verse number="3" style="v" sid="EXO 22:3" />ಚಾ಼ಂದ್ ನಿಕ್ಳಾನ ಬಾದ್‌ಮ ಏಕ್‌ಜ಼ಣೊ ಚೋ಼ರಿಕರಿನ್ ಖ್ಹಪ್‌ಡಿಗಯೊತೊ, ಇನ ಮಾರಿನ್ ಮಾರಿನಾಖ್ಯುತೊ ಇನ ಖೂನಿಕರಿ ಗಣ್ತಿಕರ‍್ನು. ಯೊ ಚೋ಼ರಿಕರಿಹುಯು ಪೂರ ಪಾಛು಼ ದೇವ್ಣು. ಇನಾಮ ದ್ಯವಾನ ಶಾತ್‌ಬಿ ನಾರ‍್ಹಿಯುತೊ ಯೊ ಚೋ಼ರ್‌ಕರ‍್ಯೊತೆ ಇನಖ್ಹಾಜೆ ಗುಲಾಮ್‌ಹುಯಿನ್ ವೇಚೈ಼ಜಾ಼ವ್ಣು. <verse eid="EXO 22:3" /><verse number="4" style="v" sid="EXO 22:4" />ಚೋ಼ರಿ ಕರಿಹುಯು ಢಾಂಡು ರ‍್ಹವೊ, ಗಧೇಡೊ ರ‍್ಹವೊ, ಬೋಕ್ಡುರ‍್ಹವೊ, ಮೇಂಢು ರ‍್ಹೀನ್ ಜಿವ್ತುಸ್ ಚೋ಼ರಿಕರವಾಳಕನ ಮಳ್ಯುತೊ ಯೊ ಬೇಪಟ್ ಬದಲ್ ದೇವ್ಣು. <verse eid="EXO 22:4" /><verse number="5" style="v" sid="EXO 22:5" />ಏಕ್‌ಜ಼ಣೊ ಇನ ಖೇತರ್‌ಮ ರ‍್ಹವೊ, ದ್ರಾಕ್ಷಿನ ಬಾಗ್‌ಮ ರ‍್ಹವೊ ಢಾಂಡವ್ನ ಚ಼ರೈನ್, ಬಿಜೇಕ್ ಜ಼ಣಾನ ಖೇತರ್‌ಮ ರ‍್ಹವೊ, ದ್ರಾಕ್ಷಿನ ಬಾಗ್‌ಮ ರ‍್ಹವೊ ಚ಼ರಾಯೊತೊ, ಇನ ಖೆತರ್‌ನು ನತರ್ ದ್ರಾಕ್ಷಿನು ಬಾಗ್‌ನ ಅಛ಼್ಛ ಪಸಲ್‌ಥಿ ಬದಲ್ ದೇವ್ಣು. <verse eid="EXO 22:5" /><verse number="6" style="v" sid="EXO 22:6" />ಏಕ್‌ಜ಼ಣೊ ಲಗಾಡ್‌ಯೊತೆ ಆಗ್ ಅಫ್ಫರ್‌ಥುಸ್ ಕಾಟಾನ ಝಾ಼ಡಾನ ಖ್ಹಲ್‌ಗಿನ್ ಹಿಜ್ಜಾ಼ಥು ಬಿಜೇಕ್‌ಜ಼ಣಾನ ಅನಾಜ಼್‌ನ ರಾಶ್‌ನ ರ‍್ಹವೊ, ಪಿಕಾವ್ಣಿ ರ‍್ಹವೊ, ಖೆತರ್‌ ರ‍್ಹವೊ ಬಳಿಗಯೂತೊ, ಆಗ್ ಲಗಾಡ್ಯೊ ಹುಯೊ ಇನ ಬದಲ್ ದೇವ್ಣು. <verse eid="EXO 22:6" /><verse number="7" style="v" sid="EXO 22:7" />ಏಕ್‌ಜ಼ಣೊ ರಪ್ಯಾನ ರ‍್ಹವೊ, ಖ್ಹೊನ್ನು ಖ್ಹರಪ್‌ನ ರ‍್ಹವೊ ಜ಼ತನ್‌ಥಿ ರಾಖಿಮ್ಹೆಲಾನ ಬಿಜೇಕ್ ಜ಼ಣಾನ ದೀರಾಖ್ಯುತೊ ಯೊ ರಾಛು಼ ಯೊ ಅದ್ಮಿನ ಘರ್‌ಮ ಚೋ಼ರಿಹುಯಿನ್, ಚ಼ೊಟ್ಟೊ ಖ್ಹಪ್‌ಡಿಗಯೋತೊ ಬೇಪಟ್ ದಂಡ್ ದೇವ್ಣು. <verse eid="EXO 22:7" /><verse number="8" style="v" sid="EXO 22:8" />ಚ಼ೊಟ್ಟೊ ನಾ ಮಳ್ಯೊತೊ ಯೊ ಘರ್‌ನೊ ಯಜಮಾನ್ ಯೋಸ್ ಯೊ ಘೇಣಾನ ಚೋ಼ರ್ ಕರ‍್ಯೊಕಿಶು ಕೊಯ್ನಿಕಿ ಕರಿ ದೇವ್ನಿ ಝ಼ಗೋಕನ ದೆಖೈಲೇವ್ಣು. <verse eid="EXO 22:8" /><verse number="9" style="v" sid="EXO 22:9" />ಠಗೈಗಯುಕರಿ ಶಕ್ ಹುವಾನು ಹರೇಕ್‌ನು ವಿಚಾರ್‌ನು ಬಾರೇಮಾಬಿ, ಯೊ ಢಾಂಡು, ಗಧೇಡೊ, ಮೇಂಢು ನತರ್ ಲುಂಗ್ಡಾವ್‌ನಿ ವಿಚಾರ್ ರ‍್ಹಿಯುತೋಬಿ, ಗುಮೈಲಿದೋತೆ ಬಿಜು಼ ಖಿವು ಜಿನಖ್ಹ್‌ನಿ ವಿಚಾರ್‌ ರ‍್ಹಿಯುತೋಬಿ, ಭೇಜ಼ಣ ಯೊ ಮಾರುಕರಿ ಬೋಲಾನಿ ವಖ್ಹ್‌ತೆ ಯೊ ಭೇಜ಼ಣಾನು ಝ಼ಗ್ಡಾನ ಲೀನ್ ದೇವ್ನ ಖ್ಹಾಮ್ಣೆ ಆವ್ಣು. ದೇವ್ ಯೊ ಭೇಮ ಕಿನ ಠಗಾರುಕರಿ ತೀರ್ಮಾನ್ ಕರಾಸ್ಕಿ ಯೊ ಬಿಜೇಕ್ ಜ಼ಣಾನ ಬೇಪಟ್ ದೇವ್ಣು. <verse eid="EXO 22:9" /><verse number="10" style="v" sid="EXO 22:10" />“ಏಕ್‌ಜ಼ಣೊ ಬಿಜೇಕ್‌ಜ಼ಣಾನ ಗಧೇಡಾನ ರ‍್ಹವೊ, ಢಾಂಡಾನ ರ‍್ಹವೊ ಬಿಜು಼ ಮೇಂಢರ‍್ಹವೊ ಅಜು಼ ಖಿವುಬಿ ಜಾನ್ವರ್‌ನ ರ‍್ಹವೊ, ಜ಼ತಂಥಿರಾಖನ ದೀಮ್ಹೇಲಿನ್, ಯೊ ಮರಿಗಯುತೊ ನತರ್ ಫೋಡೇಲು ಹುಯುತೊ ನತರ್ ಕಿನಾಬಿ ಮಾಲುಮ್‌ಕೊಂತೆ ಚೋ಼ರಿ ಹುಯ್ಗುತೊ, <verse eid="EXO 22:10" /><verse number="11" style="v" sid="EXO 22:11" />ಯೊ ಅದ್ಮಿ ಇನುಯೋಸ್ ಯೊ ಶೊತ್ನಿ ಬಾರೇಮ ಠಗಾಯೊ ಕೊಯ್ನಿಕರಿ ನಿಶ್ಚಯ್‌ಕರಾನ ಖ್ಹಾಜೆ ಯೆಹೋವನಪರ್ ಆಣ್‌ಕರ‍್ನು. ತದೆ ಜಾನ್ವರ್‌ನೊ ಮಾಲಿಕ್ ಯೊ ಆಣ್‌ನಿ ವಾತೆನ ವಿಶ್ವಾಸ್‌ಕರ‍್ನು. <verse eid="EXO 22:11" /><verse number="12" style="v" sid="EXO 22:12" />ಕತೋಬಿ ಯೊ ಜಾನ್ವರ್‌ ಇನಕಂಥು ಚೋ಼ರಿ ಹುಯಿರ‍್ಹುತೊ ಯೊ ಅದ್ಮಿ ಇನ ಮಾಲಿಕ್‌ನ ಬದಲ್ ದೇವ್ಣು. <verse eid="EXO 22:12" /><verse number="13" style="v" sid="EXO 22:13" />ಝಾ಼ಡಿನು ಜಾನ್ವರ್‌ ಮಾರಿರಾಖ್ಯುತೊ, ಇನ ಮುರ‍್ದಾನ ಖ್ಹಣೇದ್‌ನಖ್ಹಾಜೆ ವತಾಳದೆ. ಜ಼ಂಗಳ್‌ನು ಜಾನ್ವರ್‌ ಮಾರ‍್ಯುತೆಖ್ಹಾಜೆ ಬದಲ್ ದ್ಯವಾನಿ ಜ಼ರೂರತ್ ಕೊಯ್ನಿ. <verse eid="EXO 22:13" /><verse number="14" style="v" sid="EXO 22:14" />ಏಕ್‌ಜ಼ಣೊ ಬಿಜೇಕ್‌ಜ಼ಣೇಥಿ ಜಾನ್ವರ್‌ನ ಥೋಡ ದನ್ನಖ್ಹಾಜೆ ಭಾಡು ಲೀರಾಖಿನ್ ಯೊ ಜಾನ್ವರ್‌ನೊ ಮಾಲಿಕ್ ಇನು ಖನ್ನೆಕೊಂತೆ ವಖ್ಹತ್‌ಮ ಯೊ ಫೋಡೇಲು ಹುಯುತೊ ನತರ್ ಮರಿಗಯುತೊ ಉಧಾರ್ ಲೀರಾಖವಾಳೊ ಬದಲ್ ದೇವ್ಣು. <verse eid="EXO 22:14" /><verse number="15" style="v" sid="EXO 22:15" />ಮಾಲಿಕ್ ಖನ್ನೆಸ್‌ ರ‍್ಹಿಯೂತೊ, ಇನ ಬದಲ್ ದ್ಯವಾನಿ ಜ಼ರೂರತ್ ಕೊಯ್ನಿ. ಇನ ಭಾಡು ಲೀರಾಖ್ಯೊತೊ ಇನ ಹುವಾನಿ ಲುಕ್ಷಾನ್ ಭಾಡಾನು ಇಶಾಬ್‌ನ ಗಣ್ತಿಹೋಣು.<verse eid="EXO 22:15" /></para>
  <para style="s">ಲೋಗ್‌ ನಿಯಮ್‌ನಿ ಬಾರೇಮ</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 22:16" />ಖ್ಹಗೈಪಡಿರ‍್ಹಿಕೊಂತೆ ಛೋ಼ಕ್ರಿನ ಡೋಳಕಾಡಿನ್ ಮಳಿಗಯೊತೊ ಹೈರಿತೆನಖ್ಹಾಜೆ ಮಹಾರ್ ದೀನ್ ಇನ ವ್ಯಾಹ ಕರಿಲೇವ್ಣು. <verse eid="EXO 22:16" /><verse number="17" style="v" sid="EXO 22:17" />ಕತೋಬಿ ಯೊ ಛೋ಼ಕ್ರಿನೊ ಬಾ ಇನ ದ್ಯವಾನ ನಾ ಮಾನಿಲಿದೋತೊ ಯೊ ಅದ್ಮಿ ದಾಮ್ನ ಕಿಮ್‌ಬಿ ಪೈಸನ ದೇವ್ಣು. <verse eid="EXO 22:17" /><verse number="18" style="v" sid="EXO 22:18" />“ಜಾ಼ದುಕರಾವಳಿನ ಬಚಿರ‍್ಹವಾನ ನಾಮ್ಹೇಲ್ನು. <verse eid="EXO 22:18" /><verse number="19" style="v" sid="EXO 22:19" />“ಜಾನ್ವರ್‌ಥಿ ಮಳಾವಳನ ಮರಣ್ಣಿ ನಿಶತ್ ಹೋಣು. <verse eid="EXO 22:19" /><verse number="20" style="v" sid="EXO 22:20" />ಯೆಹೋವನ ಏಕ್‌ಜ಼ಣಾನ ಮ್ಹೇಲಿನ್ ಬಿಜೇಕ್ ದೇವ್ನ ಬಲಿ ಅರ್ಪಣ್ ಕರಾವಳೊ ಪೂರ ನಾಶ್‌ಹುಯಿಜಾ಼ವ್ಣು. <verse eid="EXO 22:20" /><verse number="21" style="v" sid="EXO 22:21" />ಪರ್‌ದೇಖ್ಹ್‌ವಾಳನ ನಾ ಠಗಾವ್ಣು, ಇನ ಖ್ಹತಾವ್ಣು ನಾ. ತುಮೇಬಿ ಜಿನು ಈಜಿಪ್ಟ್‌ಮ ಪರ್‌ದೇಖ್ಹ್‌ವಾಳ ಹುಯಿರ‍್ಹಾಥಾನಿ. <verse eid="EXO 22:21" /><verse number="22" style="v" sid="EXO 22:22" />ಮುಂಡಚ್ಚಿಯೇವ್ನ ರ‍್ಹವೊ, ಅನಾದ್ರಿ ಲಡ್ಕಾವ್ನ ರ‍್ಹವೊ ಖ್ಹತಾವ್ಣು ನಾ. <verse eid="EXO 22:22" /><verse number="23" style="v" sid="EXO 22:23" />ತುಮೆ ಅಥ್ರಾನವಾಳನ ಖ್ಹತಾಯತೊ ಇವ್ಣೆ ಮನ ಬಿಂತಿ ಕರ್‌ಷೆ ಯೊ ಬಿಂತಿನ ಮೇ ಕಾನ್ ದಿಶ್‌ಕರಿ ಮಾಲುಮ್‌ ಕರಿಲೆವೊ. <verse eid="EXO 22:23" /><verse number="24" style="v" sid="EXO 22:24" />ಮೇ ಖಿಜೈನ್ ತುಮಾರ ವಹೇರ‍್ಯಾವ್ನ ತಲ್ವಾರ್‌ಥಿ ಮಾರಿಶ್. ತುಮಾರಿ ಬಾವಣೆ ಮುಂಡಚ್ಚಿಯೆ ಉಷೆ. ತುಮಾರ ಲಡ್ಕಾವ್ ಅನಾದ್ರಿ ಉಷೆ. <verse eid="EXO 22:24" /><verse number="25" style="v" sid="EXO 22:25" />ಮಾರ ಅದ್ಮಿಮ ಎಕ್ ಗರೀಬ್‌ನ ತೂ ರಪ್ಯ ದಿದೋತೊ ಇನ ಕರ್‌ಜ್ಯನಿತರ ನಾ ದೇಕ್ಣು. ಇನೇಥಿ ಬಡ್ಡೀಬಿ ನಾ ಬೋಲ್ನು. <verse eid="EXO 22:25" /><verse number="26" style="v" sid="EXO 22:26" />ತೂ ಏಕ್‌ಜ಼ಣಾನ ಗೋದ್‌ಡಾನ ಆಡು ಮ್ಹೇಲಿರಾಖ್ಯೊತೊ ಚಾ಼ಂದ್ ಡುಬಾನ ಮಹಿ ಇನ ಪಾಛು಼ ದಿನಾಖಿ ದೇವ್ಣು. <verse eid="EXO 22:26" /><verse number="27" style="v" sid="EXO 22:27" />ಶನಕತೊ ಯೊ ಇನ ಎಕ್ಕಸ್ ಹೋಡ್‌ಣಿ ಹುಯಿರ‍್ಹಿಸ್. ಯೋಸ್ ಇನ ಆಂಗ್ನ ಪೆರ್ವಾಖ್ಹ್. ಯೊ ಬಿಜು಼ ಶನ ಹೋಡಿನ್ ಖ್ಹೂಣು? ಯೊ ಮನ ಬಿಂತಿ ಕರ‍್ಯೊತೊ ಮೇ ಕಾನ್‌ಲಗಾಡಿ ಖ್ಹಮ್‌ಜಿಶ್. ಶನಕತೊ ಮೇ ದಯಾಕರವಾಳೊಸ್. <verse eid="EXO 22:27" /><verse number="28" style="v" sid="EXO 22:28" />ದೇವ್ನ ಗಾಳೆ ನಾದೇವ್ಣು. ತಾರ ಅದ್ಮಿಯೇನ ಮೋಟಾನ ತೂ ಶಬರ್ ನಾದೇವ್ಣು. <verse eid="EXO 22:28" /><verse number="29" style="v" sid="EXO 22:29" />ತುಮಾರ ಖೇತರ್‌ಥು ಬಿಜೂ಼ ದ್ರಾಕ್ಷಿನ ರಖ್ಹ್‌ಮಾಥು ಮನ ದೆವಾವ್ಣುತೆಯಿನ ಅರ್ಪಣ್‌ಕರಾನ ಧೀರ್‌ನಾಕರ‍್ನು. ತುಮಾರ ಪೈಲ್ಹೋಟ ಪರ್ಖ್ಹಾ ಲಡ್ಕಾವ್ನ ಮನ ಅರ್ಪಣ್ ಕರ‍್ನು. <verse eid="EXO 22:29" /><verse number="30" style="v" sid="EXO 22:30" />ಇಮ್ಮಸ್ ತುಮಾರು ಮೇಂಢು, ಢಾಂಡಾವ್ನು ಪೈಲ್ಹೋಟ ಚೆಲ್ಕಾವ್ನ ಮನ ಅರ್ಪಣ್ ಕರ‍್ನು. ಖ್ಹಾತ್ ದನ್‌ಲಗು ಯೊ ಚೆಲ್ಕು ಇನಿ ಆಯನ ಜೋ಼ಡ್ಮ ರ‍್ಹವಾದೆ. ಆಟ್ನ ದನ್ಮ ಇನ ಮನ ಅರ್ಪಣ್ ಕರ‍್ನು. <verse eid="EXO 22:30" /><verse number="31" style="v" sid="EXO 22:31" />ತುಮೆ ಮನ ಪರಿಶುದ್ದ ಅದ್ಮಿ ಹುಯಿರೇಣು. ಇನಖ್ಹಾಜೆ ಜ಼ಂಗಳ್‌ನು ಜಾನ್ವರ್‌ ಮಾರಿರಾಖಸ್ತೆಯಿನ ನಾಖಾವ್ಣು; ಇನ ಕುತ್‌ರ‍್ಯಾವ್ನ ಮ್ಹೇಲಿದೇವ್ಣು.<verse eid="EXO 22:31" /></para>
  <chapter eid="EXO 22" />
  <chapter number="23" style="c" sid="EXO 23" />
  <para style="s">ನ್ಯಾವ್ ಅಜು಼ ಅಛ್ಛು಼ರ‍್ಹವಾನು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 23:1" />ಝೂ಼ಟಿ ಖಬರ್‌ನ ನಾ ಫೈಲಾವ್‌ಣು. ಖರಾಬಿ ದುಷ್ಟ ಅದ್ಮಿನ ಜೋ಼ಡೆ ಮಳಿನ್ ಝೂ಼ಟಿ ಸಾಕ್ಷಿನ ನಾಬೋಲ್ನು. <verse eid="EXO 23:1" /><verse number="2" style="v" sid="EXO 23:2" />ಖರಾಬ್ ಕಾಮ್‌ಕರಾವಳು ಕೈಯೇಕ್‌ಜ಼ಣು ಛಾ಼, ರ‍್ಹೀನ್‌ಬಿ ತುಮೆ ಇವ್ಣ ಜೋ಼ಡ್ಮ ನಾ ಮಳ್‌ಣು. ಘಣಜ಼ಣಾನಿ ವಾತೆನ ಮಾನಿನ್ ನ್ಯಾವ್ನ ಬಿಗ್ಡಾವನಿ ಸಾಕ್ಷಿನ ನಾಬೋಲ್ನು. <verse eid="EXO 23:2" /><verse number="3" style="v" sid="EXO 23:3" />ಆನಾಹುಯಿನ್ ಗರೀಬ್‌ನ ಉಪ್ಪರ್‌ಲಿ ಗೋರ್‌ಥಿ ಪಕ್ಷಪಾತ್‌ನಿ ತೀರ್ಮಾನ್ ನಾಕರ‍್ನು.<verse eid="EXO 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 23:4" />“ತಾರೊ ವಹೇರ‍್ಯಾನು ಢಾಂಡು ರ‍್ಹವೊ, ಗಧೇಡೊ ರ‍್ಹವೊ ತಪ್‌ಶೈನ್ ಜೈ಼ರ‍್ಹವಾನಿ ವಖ್ಹ್‌ತೆ ಯೊ ತುನ ಮಳ್ಯುತೊ ಪಾಛು಼ ಇನಾಕನ ಹಕೇಳಿ ಜೈ಼ನ್ ದೇವ್ಣು. <verse eid="EXO 23:4" /><verse number="5" style="v" sid="EXO 23:5" />ತುನ ಬಳಾಪೊ ಕರವಾಳನು ಗಧೇಡೊ ವಜ಼ನ್ ನಾಖ್ಹಮಾಳಿನ್ ಹೇಟ್ ಪಡ್ಯುರ‍್ಹವಾನು ದೇಖ್ಯೊತೊ ಇನ ಉಠಾಡನ ತುನ ಮನ್ ನಾರ‍್ಹಯುತೋಬಿ ಇನ ಮದತ್ ಕರಿನ್ ಉಠಾಡ್‌ನುಸಸ್ ಉಠಾಡ್‌ಣು. <verse eid="EXO 23:5" /><verse number="6" style="v" sid="EXO 23:6" />ತುಮಾರಮ ರ‍್ಹವಾಳು ಗರೀಬ್ ನ್ಯಾವ್‌ಬೋಲಿನ್ ತುಮಾರಕನ ಆಯೂತೊ ತುಮೆ ನ್ಯಾವ್ನ ನಾ ಛು಼ಕಾವ್‌ಣು. <verse eid="EXO 23:6" /><verse number="7" style="v" sid="EXO 23:7" />ಗಲತ್‌ ಕಾಮ್‍ಥಿ ದೂರ್ ರ‍್ಹೇವ್ಣು. ನಿರ್ದೋಷಿಬಿ, ನೀತಿಥಿ ರ‍್ಹವಾಳ ಅದ್ಮಿನ ಮರಣ್ಣಿ ನಿಶತ್‌ನ ನಾಸ್‌ದೇವ್ಣು. ಎಥ್ರಾನ ಖರಾಬ್ ಕಾಮ್ ಕರವಾಳನ ಮೇ ನಿಶತ್ ದಿಶ್‌ಕೊಂತೆ ಮ್ಹೇಲಿಶ್ ಕೊಯ್ನಿ. <verse eid="EXO 23:7" /><verse number="8" style="v" sid="EXO 23:8" />ಲಂಚ ನಾಲೇವ್ಣು. ಲಂಚ ಡೋಳ ರ‍್ಹವಾಳನಬಿ ಅಂಧುಕರಿನಾಖಸ್, ನಿಯತ್‍ವಳನ ಮಳ್‌ಣುತೆ ನ್ಯಾವ್ನ ಛು಼ಕಾವಸ್. <verse eid="EXO 23:8" /><verse number="9" style="v" sid="EXO 23:9" />ಪರ್‌ದೇಖ್ಹ್‌ವಾಳನ ಖ್ಹತಾವ್ಣುನಾ. ತುಮೆ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಮ ಪರ್‌ದೇಖ್ಹ್‌ವಾಳಸ್ ಹುಯಿರ‍್ಹಾಥ. ಎಥ್ರಾನವಾಳನು ದಿಲ್ನು ತಖ್ಹ್‌ಲಿಬ್ ತುಮುನ ಮಾಲುಮಸ್ ಛಾ಼.<verse eid="EXO 23:9" /></para>
  <para style="s">ಖ್ಹಾತ್‌ನೆ ವರಖ್ಹ್‌ನು ಖ್ಹಾತ್‌ನೆ ದನ್ನಿ ಪದತ್ತಿ</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 23:10" />ಛೋ಼ ವರಖ್ಹ್ ತುಮಾರ ಖೇತರ್‌ನ ಬಿತ್ತಿನ್ ಪಿಕಾವ್ಣಿನ ಕಾಡಿಲೆವೊ. <verse eid="EXO 23:10" /><verse number="11" style="v" sid="EXO 23:11" />ಕತೋಬಿ ಖ್ಹಾತ್‌ನೊ ವರಖ್ಹ್‌ಮ ಯೊ ಜ಼ಮೀನ್ನ ನಾಗರ್‌ನುನಾತೆ ಕೂಳೆ ಮ್ಹೇಲ್ನು. ತುಮಾರ ದೇಖ್ಹ್‌ನು ಗರೀಬ್ ಇನಾಮ ಫುಟಾಸ್ತೆ ಇನ ಖಾವದೆ. ಉಭ್‌ರ‍್ಹಾಸ್ತೆಯಿನ ಝಾ಼ಡಿನು ಜಾನ್ವರ್‌ ಚ಼ರಾದೆ. ತುಮಾರ ದ್ರಾಕ್ಷಿನ ಬಾಗ್‌ನು ಅಜು಼ ತೇಲ್ನ ಝಾ಼ಡ್‌ಣ ಬಗೀಚಾ಼ನಿ ಬಾರೇಮಾಬಿ ಅಮ್ನಿಸ್ ಪರಕ್ಮ ಕರ‍್ನು.<verse eid="EXO 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 23:12" />ಛೋ಼ ದನ್‌ಮ ತುಮಾರ ಕಾಮ್ನ ಕರಿನ್, ಖ್ಹಾತ್‌ನ ದನ್‌ಮ ಖಿವುಬಿ ಗೇಮೆ ನಾಕರ‍್ನುತೆ ರ‍್ಹೇವ್ಣು. ಯೊ ದನ್ ತುಮಾರು ಢಾಂಡುಖ್ಹಾರು, ಗಧೇಡುಖ್ಹಾರು, ದಾಸ, ದಾಸಿ, ಪರ್‌ದೇಖ್ಹ್‌ವಾಳು ಅರಾಮ್ ಕರಾದೆ. <verse eid="EXO 23:12" /><verse number="13" style="v" sid="EXO 23:13" />ಮೇ ತುಮುನ ಬೋಲ್ಯೊತೆಖ್ಹಾರುಸ್ ಹೊಷಾರ್‌ಥಿ ಚ಼ಲಾವ್ಣು. ಅಲಕ್ ದೇವ್ನ ನಾಮ್ನ ನಾ ಬೋಲ್‌ತುಬಿ ರ‍್ಹೇವ್ಣು; ಇನುಅಖ್ಖು ನಾಮ್ನಾಸ್ ನಾಕಾಡ್ನು.<verse eid="EXO 23:13" /></para>
  <para style="s">ತೀನ್ ಮೋಟಿ ಪೂಜ಼</para>
  <para style="r">(<ref loc="EXO 34:18-26">ವಿಮೋ 34:18-26</ref>; <ref loc="DEU 16:1-17">ಧರ್ಮೊ 16:1-17</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 23:14" />ತುಮೆ ವರಖ್ಹ್‌ನ ತೀನ್ ಹಲ್ಲ ಮನ ಜ಼ತ್ರಾಕರ‍್ನು. <verse eid="EXO 23:14" /><verse number="15" style="v" sid="EXO 23:15" />ಖಾಟುಕೊಂತೆ ರೋಟಾವ್ನ ಖಾವ್ಣುತೆ ಪೂಜ಼. ಮೇ ಹುಕುಮ್ ದ್ಯವಾನಿತರ ತುಮೆ ಚೇತ್ರಿನ ಮಹಿನಾಮ ನೇಮಕ್‌ಹುಯುತೆ ವಖ್ಹತ್‌ಮ ಖ್ಹಾತ್ ದನ್‌ಬಿ ಖಾಟುಕೊಂತೆ ರೋಟಾವ್ನ ಖಾವ್ಣು. ಯೊ ಮಹಿನಾಮಸ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ನಿಕ್‌ಳಿ ಆಯಾತೆ ಯಾದ್‌ನಖ್ಹಾಜೆ ಇನ ಚ಼ಲಾವ್ಣು. ಹಾತ್‌ಮ ಕಾಣ್ಕೆಕೊಂತೆ ಖಾಲಿ ಹಾತೇಥಿ ಮಾರಿ ಝ಼ಗೋಮ ಕೋಣ್‌ಬಿ ನಾ ಆವ್ಣು. <verse eid="EXO 23:15" /><verse number="16" style="v" sid="EXO 23:16" />ಯೋಸ್ ಕಾಹೆತೆ ತುಮೆ ಬಿತ್ಯಾತೆ ಖೇತರ್‌ಮ ಪಹಿಲು ಫಲ್ ಮಳ್ಯುತೊ ಖ್ಹುಗ್ಗೀನು ಪೂಜಾ಼ನ ಚ಼ಲಾವ್ಣು. ಖೆತರ್‌ ಬಾಗ್‌ನು ಪಿಕಾವ್ಣಿನ ಎಕ್ಟುಕರಾನಿ ವಖ್ಹ್‌ತೆ ಕತೊ ವರಖ್ಹ್‌ನು ಕಡ್‌ಷೀನು ಖ್ಹುಗ್ಗೀನು ಪೂಜಾ಼ನ ಚ಼ಲಾವ್ಣು. <verse eid="EXO 23:16" /><verse number="17" style="v" sid="EXO 23:17" />ವರಖ್ಹ್‌ನ ತೀನ್ ಹಲ್ಲ ತುಮಾರಮ ಛಾ಼ತೆ ಪರ್ಖ್ಹೊಖ್ಹಾರು ಪ್ರಭುಹುಯಿರ‍್ಹೋತೆ ಯೆಹೋವನಿ ಝ಼ಗೋಮ ಎಕ್ಟು ಮಳಿನ್ ಆವ್ಣು. <verse eid="EXO 23:17" /><verse number="18" style="v" sid="EXO 23:18" />ಮನ ಬಲಿ ಅರ್ಪಣ್‌ಕರಾನಿ ವಖ್ಹ್‌ತೆ ಯೊ ಬಲಿನು ಜಾನ್ವರ್‌ನು ಲ್ಹೋಯಿನ ಜೋ಼ಡ್ಮ ಖಾಟ ಆಟಾನ ಸಮರ್ಪಣ್‌ ನಾಕರ‍್ನು. ಮಾರಿ ಪೂಜಾ಼ಮ ತುಮೆ ಮನ ಸಮರ್ಪಣ್‌ ಕರ‍್ನುತೆ ಜಾನ್ವರ್‌ನು ಬಿಶ್ಶಾನ ಬಿಜೇಕ್ ದನ್‌ಲಗು ನಾಸ್‌ಮ್ಹೇಲ್‌ನು. <verse eid="EXO 23:18" /><verse number="19" style="v" sid="EXO 23:19" />ತುಮಾರು ಪಿಕಾವ್ಣಿನು ಪಹಿಲು ಫಲ್‌ಮ ಜಾ಼ಖ್ಹತ್ ಶ್ರೇಷ್ಟ್ ಹುಯಿರ‍್ಹೇಸ್ತೆ ಇನ ತುಮೆ ದೇವ್‌ಹುಯಿರ‍್ಹೊತೆ ಯೆಹೋವನಿ ಮಂದಿರ್‌ಮ ಲ್ಯಾವ್ಣು. ಬೋಕ್ಡಾನು ಚೆಲ್ಕಾನ ಇನಿ ಆಯಾನ ದೂದ್ಮ ನಾ ರ‍್ಹಾಂದ್‌ಣು.<verse eid="EXO 23:19" /></para>
  <para style="s">ವಾಗ್ದಾನ್ ಅಜು಼ ವಾಟ್‌ವತಾಳನು</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 23:20" />ಹಂದೇಕ್ ವಾಟ್‌ಮ ತುಮುನ ಬಚಾ಼ಡನಾಬಿ, ಮೇ ತಯಾರ್ ಕರಿರಾಖ್ಯೊತೆ ಝ಼ಗೋನ ತುಮುನ ಬುಲಾವನಖ್ಹಾಜೆಥಿ ದೂತಾನ ತುಮಾರ ಅಗ್ಗಳಸ್ ಮೋಕ್ಲಿರಾಖ್ಯೊಸ್. <verse eid="EXO 23:20" /><verse number="21" style="v" sid="EXO 23:21" />ತುಮೆ ಇನಾಮ ಧ್ಯಾನ್‌ದೀನ್ ಇನ ವಾತ್ನ ಖ್ಹಮಜ಼್‌ಣು. ಇನ ಝಿಟ್ಕಾರ್‌ನು ನಾ, ಶನಕತೊ ಯೊ ಆವಾನು ಮಾರ ನಾಮ್‌ಥಿ. ತುಮೆ ಝಿಟ್ಕಾರ್‌ಯತೊ ಯೊ ತುಮಾರಿ ಅಪರಾದ್‌ನ ಕ್ಷಮಾಪಣ್ ಕೊಕರ್ಷೇನಿ. <verse eid="EXO 23:21" /><verse number="22" style="v" sid="EXO 23:22" />ತುಮೆ ಇನಿ ವಾತ್ನ ನಿಘಾಥಿ ಖ್ಹಮ್‌ಜಿನ್ ಮಾರಿ ಹುಕುಮ್‌ನಿ ಪರಕ್‌ನಿತರ ಚಾ಼ಲಿಲಿದುತೊ ಮೇ ತುಮಾರ ವಹೇರ‍್ಯಾನ ವಹೇರ‍್ಯೊ ಹುಯಿನ್, ತುಮುನ ಖ್ಹತಾವವಾಳನ ಖ್ಹತಾವವಾಳೊ ಹುಯಿನ್‌ಬಿ ರ‍್ಹೀಶ್. <verse eid="EXO 23:22" /><verse number="23" style="v" sid="EXO 23:23" /><note caller="-" style="x"><char style="xo" closed="false">23:23 </char><char style="xt" closed="false"><ref loc="GEN 15:19-20">ಆದಿಕಾಂಡ 15:19-20</ref>,<ref loc="GEN 15:21">21</ref></char></note>ಮಾರೊ ದೂತ ತುಮಾರ ಖ್ಹಾಮ್ಣೆಕರಿ ನಿಕ್ಳಿನ್ ಅಮೋರಿಯವಾಳು, ಹಿತ್ತಿಯವಾಳು, ಪೆರಿಜೀವಾಳು, ಕಾನಾನ್ಯವಾಳು, ಹಿವ್ವಿವಾಳು, ಯೆಬೂಸಿವಾಳುಬಿ ಛಾ಼ತೆ ದೇಖ್ಹ್‌ಮ ತುಮುನ ಮಳಾವ್‌ಷೆ. ಇವ್ಣುನತೊ ಮೇ ಖತಮ್ ಕರಿನಾಖಿಷ್. <verse eid="EXO 23:23" /><verse number="24" style="v" sid="EXO 23:24" />ಇವ್ಣಿ ದೇವ್ತಿನ ತುಮೆ ಖ್ಹಲಾಮ್‌ಬಿ ನಾಕರ‍್ನು, ಇವ್ಣಿ ಪದತ್ತಿನ ನಾಸ್ ಪಾಡಿನಾಚಾ಼ಲ್ನು. ಯೊ ಅದ್ಮಿವ್‌ನ ಕಾಡಿನಾಖಿನ್ ಮೂರತ್‌ನ ಖಂಬಾವ್ನ ನಾಶ್‌ಕರ‍್ನು. <verse eid="EXO 23:24" /><verse number="25" style="v" sid="EXO 23:25" />ತುಮಾರೊ ದೇವ್ ಯೆಹೋವನ ಎಕ್ಕಸ್‌ಜ಼ಣಾನ ಆರಾದನೆ ಕರ‍್ನು. ತದೆ ಯೊ ತುಮಾರ ಖಾಣಪಾಣಿವ್‌ಮ ಆಶೀರ್ವದ್‍ದಿದೊ. ತುಮಾರಮ ಛಾ಼ತೆ ರೋಗ್‌ನ ಕಾಡಿನಾಕ್ಷೆ. <verse eid="EXO 23:25" /><verse number="26" style="v" sid="EXO 23:26" />ತುಮಾರ ದೇಖ್ಹ್‌ಮ ಪೇಟ್‌ಪಡಿಜಾ಼ವನು ರ‍್ಹವೊ, ವಾಂಝಿ ರ‍್ಹವಾನು ರ‍್ಹವೊ ರ‍್ಹಿಶೆಸ್ ಕೊಯ್ನಿ. ತುಮುನ ಪೂರ ಉಂಬರ‍್ನ ದಿಶ್.<verse eid="EXO 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 23:27" />ತುಮೆ ಜಾ಼ವನು ಅಖ್ಖೀಸ್ ಬಾಜು಼ಮಾಬಿ ಮೇ ಅದ್ಮಿಯೇವ್ನ ದಿಲ್‌ಮ ಡರ್‌ ಲೈನ್‌ ಇವ್ಣುನ ಕಲಾವ್ಣಿ ಕರಿನ್, ತುಮಾರು ವಿರೋದಿ ಖ್ಹಾರುಬಿ ಮಿಲೈನ್ ಜಾ಼ವನಿತರ ಕರಿಶ್. <verse eid="EXO 23:27" /><verse number="28" style="v" sid="EXO 23:28" />ಯೊ ನಾಹುಯಿನ್ ಡಾಕ್ನ ಕೀಡಾವ್ನ ತುಮಾರ ಪಹಿಲೆಸ್ ಮೋಕ್ಲಿನ್ ಹಿವ್ವಿವಾಳು, ಕಾನಾನ್ಯವಾಳು,ಅಜು಼ ಹಿತ್ತಿಯವಾಳು ತುಮಾರ ಖ್ಹಾಮ್ಣೆ ಭೀರೆವ್ಣುನಾತೆ ಯೊ ಕೀಡೊ ಇವ್ಣುನ ನಖ್ಹಾಡಿದಿಶೆ. <verse eid="EXO 23:28" /><verse number="29" style="v" sid="EXO 23:29" />ಕತೋಬಿ ಮೇ ಎಕ್ ವರಖ್ಹ್‌ನ ಮಹಿ ಇವ್ಣುನ ಖ್ಹಾರಾನ ಹಿಜ್ಜಾ಼ಥು ನಿಕ್‌ಳಾದಿಶ್ ಕೊಯ್ನಿ. ಶನಕತೊ ದೇಖ್ಹ್‌ಮ ಅದ್ಮಿಖ್ಹಾರು ಕಮ್‌ಹುವಾಥಿ ಝಾ಼ಡಿನು ಜಾನ್ವರ್‌ಖ್ಹಾರು ಜಾ಼ಖ್ಹತ್‌ಹುಯಿನ್ ತುಮುನ ಲುಕ್ಷಾನ್ ಹುಯೇಜಾ಼ಯ್. <verse eid="EXO 23:29" /><verse number="30" style="v" sid="EXO 23:30" />ತುಮೆ ಭಡಿನ್ ದೇಖ್ಹ್‌ಖ್ಹಾರು ಭರೈಜಾ಼ವಲಗು ಇವ್ಣುನ ಥೋಡೆ ಥೋಡೆಥಿ ನಿಕ್‌ಳೈಷ್. <verse eid="EXO 23:30" /><verse number="31" style="v" sid="EXO 23:31" />ಲಾಲ್ ದರ‍್ಯಾವ್‌ಥು ಫಿಲಿಷ್ಟಿವಾಳನು ದೇಖ್ಹ್‌ಕನ ಛಾ಼ತೆ ದರ‍್ಯಾವ್ ಲಗೂಬಿ ಅಜು಼ ಆ ಜ಼ಂಗಳ್‌ಥು ಯೂಫ್ರೇಟೀಸ್ ಮಹಾನ್ ನದ್ದಿಲಗುಬಿ ಛಾ಼ತೆ ದೇಖ್ಹ್‌ಖ್ಹಾರಸ್‌ನ ತುಮಾರಖ್ಹಾಜೆ ನೇಮಕ್‌ಕರಿನ್ ಇನಾಮ ರ‍್ಹವಾಳನ ತುಮುನ ಅಧೀನ್ ಕರಿಶ್. ತುಮೆ ಇವ್ಣುನ ನಖ್ಹಾಡ್‌ಷು. <verse eid="EXO 23:31" /><verse number="32" style="v" sid="EXO 23:32" />ತುಮೆ ಇವ್ಣೇಥಿ ರ‍್ಹವೊ ಇವ್ಣು ದೇವ್ತಿನ ಜೋ಼ಡೆ ರ‍್ಹವೊ ಖೆವೀಬಿ ಪರಕ್‌ನು ಒಪ್ಪಂದಾನಬಿ ನಾಕರಿಲೇವ್ಣು. <verse eid="EXO 23:32" /><verse number="33" style="v" sid="EXO 23:33" />ಇವ್ಣೆ ತುಮಾರ ದೇಖ್ಹ್‌ಮಾಸ್ ಜಿವ್ಣು ನಾಕರ‍್ನು. ಜಿವ್ಣು ಕರ‍್ಯಖ್ಯವುಶೇತೊ ಮನ ವಿರೋದ್‌ಥಿ ತುಮೆ ಪಾಪ್ ಕರಾನಿತರ ಇವ್ಣೆ ಹುಮ್ಮಖ್ಹ್‌ ಕರ್‌ಶೆ. ತುಮೆ ಇವ್ಣ ದೇವ್ತಿವ್ನ ಆರಾದನೆ ಕರ‍್ಯತೊ ಯೊ ಪೂಜಾ಼ ತುಮುನ ಫಾಖ್ಹೊಉಷೆ.<verse eid="EXO 23:33" /></para>
  <chapter eid="EXO 23" />
  <chapter number="24" style="c" sid="EXO 24" />
  <para style="s">ಒಪ್ಪಂದಾನ ಲಿಖಾಯುತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 24:1" />ಯೆಹೋವನೆ ಮೋಶೆನ, “ತೂ, ಆರೋನ, ನಾದಾಬ್, ಅಬೀಹೂ ಅಜು಼ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಶಾಣವ್‍ಮ ಖ್ಹಡ್‌ತೀನಿಖ್ಹ್ ಜ಼ಣು ಆ ಪಹಾಡ್‌ನ ಛ಼ಡಿನ್ ಯೆಹೋವಕನ ಅಯಿನ್ ದೂರ್‌ಮ ಭೀರಿನ್ ಆಡ್‌ಪಡಿನ್ ಆರಾದನೆ ಕರ‍್ನು. <verse eid="EXO 24:1" /><verse number="2" style="v" sid="EXO 24:2" />ಮೋಶೆ ಎಕ್ಲೋಸ್ ಯೆಹೋವನ ಖನ್ನೆ ಆವ್ಣು ಪಣ್ಕಿ ಬಿಜು಼ ಕೋಣ್‌ಬಿ ಖನ್ನೆ ನಾ ಆವ್ಣು. ಉಭ್ರಾಸ್ತೆ ಅದ್ಮಿ ಪಹಾಡ್‌ನ ನಾಸ್ ಛ಼ಡ್‌ನು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 24:2" /><verse number="3" style="v" sid="EXO 24:3" />ಮೋಶೆ ಅದ್ಮಿಯೆವ್‌ಕನ ಅಯಿನ್ ಯೆಹೋವನು ಅಖ್ಖೀಸ್ ವಾತೆವ್‌ನಾಬಿ ಅಜು಼ ಹುಕುಮ್‌ನಿ ನಿಯಮ್‌ನಾಬಿ ಬೋಲಿವತಾಳಿನಿ ವಖ್ಹ್‌ತೆ ಅದ್ಮಿಖ್ಹಾರುಬಿ, “ಯೆಹೋವನಿ ವಾತೇವ್ನ ಪಾಡಿಚಾ಼ಲೆಸ್” ಕರಿ ಎಕ್ಕಸ್‌ದಮ್ ಜವಾಬ್ ದಿದು. <verse eid="EXO 24:3" /><verse number="4" style="v" sid="EXO 24:4" />ಮೋಶೆನೆ ಯೆಹೋವನು ಹುಕುಮ್‌ಅಖ್ಖಾನ ಲೀಖ್ಯೊ. ವ್ಹಾಣೆ ಉಠಿನ್ ಯೊ ಪಹಾಡ್‌ನ ಹೇಟ್ ಬಲಿಪೀಠ್‌ನ ಭಂದೈನ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಭಾರ ಖೂಮ್‌ನ ಭಾರ ಬಂಡಾನ ಖಂಬಾನ ಭೀರಾಖ್ಯೊ. <verse eid="EXO 24:4" /><verse number="5" style="v" sid="EXO 24:5" />ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಜ಼ವಾನಿನ ತುಮೆ ಯೆಹೋವನಖ್ಹಾಜೆ ಅಖ್ಖೀಸ್ ಶರೀರ‍್ನು ಬಲಿನ ಅರ್ಪಣ್ ಕರಿನ್ ಸಮಾಧಾನ್ನಿ ಬಲಿನಖ್ಹಾಜೆ ಕೆಲ್ಡಾನ ಅರ್ಪಣ್‌ ಕರ‍್ನುಕರಿ ಹುಕುಮ್‌ದೀನ್ ಮೋಕ್‌ಲ್ಯೊ. <verse eid="EXO 24:5" /><verse number="6" style="v" sid="EXO 24:6" />ಇನವಾರ್ ಮೋಶೆ ಯೊ ಲ್ಹೋಯಿಮ ಆಧಾನ ಲೀಲಿನ್‌ ಕಟೋರಾವ್‌ಮ ಭರಿನ್ ಆಧಾನ ಚಾ಼ಚ಼ರ್‌ಪರ್ ಛಿಡ್‌ಕ್ಯೊ. <verse eid="EXO 24:6" /><verse number="7" style="v" sid="EXO 24:7" />ಇನವಾರ್ ಒಪ್ಪಂದಾನು ದಪ್ತರ್‌ನ ಲೀನ್ ಅದ್ಮಿವ್ ಖ್ಹಮಜ್‌ಪಡಾನಿತರ ಪಢ್ಯೊ. ಇವ್ಣೆ ಖ್ಹಮ್‌ಜಿನ್, “ಯೆಹೋವನಿ ಖ್ಹಾರಿ ಹುಕುಮ್‌ನ ಪಾಡಿಚಾ಼ಲಿನ್ ಮುಡ್‌ಕ್ಯು ಝು಼ಕೈಯೆಸ್” ಕರಿ ಬೋಲ್ಯು. <verse eid="EXO 24:7" /><verse number="8" style="v" sid="EXO 24:8" />ತದೆ ಮೋಶೆನೆ ಯೊ ಲ್ಹೋಯಿನ ಲೀನ್ ಅದ್ಮಿನಪರ್ ಛಿಡ್ಕಿನ್‌, “ಹಂದೇಖೊ ಆ ದಪ್ತರ್‌ಮ ಬೋಲೈರ‍್ಹುತೆ ಅಖ್ಖಿ ಹುಕುಮ್‌ನಿ ಪರಕ್ಮ ಯೆಹೋವ ತುಮಾರ ಜೋ಼ಡೆ ಕರ‍್ಯೊತೆ ಒಪ್ಪಂದಾನು ಲ್ಹೋಯಿ ಆಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 24:8" /><verse number="9" style="v" sid="EXO 24:9" />ಮೋಶೆ, ಆರೋನ, ನಾದಾಬ್, ಅಬೀಹೂ ಅಜು಼ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಶಾಣಾವ್‌ಮ ಖ್ಹಡ್‌ತೀನಿಖ್ಹ್ ಜ಼ಣು ಪಹಾಡ್‌ನ ಛ಼ಡ್ಯು. <verse eid="EXO 24:9" /><verse number="10" style="v" sid="EXO 24:10" />ತದೆ ಇಸ್ರಾಯೇಲ್‌ನು ಇವ್ಣೆ ದೇವ್ನ ದೇಖ್ಯು. ಆಬ್‌ನ ಗೋಳಾನಿತರ ಘಣು ಪಾಕ್‌ಥಿ ರ‍್ಹವಾನು ಇಂದ್ರನೀಲಮಣ್ಕನಿ ಪಾಯಿರೀಯೆ ಇನು ಗೋಡಾನೊ ರಚ್ಚೊ಼ಹುಯಿರ‍್ಹುಥು. <verse eid="EXO 24:10" /><verse number="11" style="v" sid="EXO 24:11" />ಇನೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಗಲ್‌ಢಾವ್ನ ಖಿವು ಲುಕ್ಷಾನ್‌ಬಿ ಕೊಕರ‍್ಯೋನಿ. ಯೊ ದೇವ್ನ ದೇಖಿನ್ ಖಾಣುಪಾಣಿನ ಖಾದು.<verse eid="EXO 24:11" /></para>
  <para style="s">ಮೋಶೆ ಸೀನಾಯಿ ಪಹಾಡ್‌ನ ಛ಼ಡ್‌ಯೊತೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 24:12" />ಯೆಹೋವನೆ ಮೋಶೆನ, “ತೂ ಪಹಾಡ್ ಛ಼ಡಿನ್ ಅಯಿನ್ ಮಾರ ಖನ್ನೆಸ್‌ ರ‍್ಹೆ. ತೂ ಆ ಧರ್ಮಶಾಸ್ತ್ರನಬಿ ಅಜು಼ ಹುಕುಮ್‌ನಾಬಿ ಅದ್ಮಿಯೇವ್ನ ಭೋದನ್‌ಕರಾನಿತರ ಮೆ ಯೊಅಖ್ಖು ಲೀಖಿರಾಖ್ಯುತೆ ಖೊಡ್‍ಶನ ಪಲ್ಗಾವ್ನ ತುನ ದೆವುಸ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 24:12" /><verse number="13" style="v" sid="EXO 24:13" />ಮೋಶೆನೆ ಇನೊ ಶಿಷ್ಯ ಯೆಹೋಶುವನ ಜೋ಼ಡೆ ಉಠಿನ್ ದೇವ್ನ ಪಹಾಡ್‌ಪರ್ ಗಯೊ. <verse eid="EXO 24:13" /><verse number="14" style="v" sid="EXO 24:14" />ಇನ ಪಹಿಲೆ ಇನೆ ಶಾಣವ್ನ, “ಹಮೆ ಫರಿನ್ ತುಮಾರಕನ ಆವಲಗು ತುಮೆ ಹಜ್ಜಾ಼ಸ್ ಜ಼ಪಿರ‍್ಹವೊ. ಆರೋನಬಿ ಅಜು಼ ಹೂರ ತುಮಾರಕನ ರ‍್ಹಿಶೆ. ಕಿನಾತೋಬಿ ಝ಼ಗ್‍ಡೊ ಉಷೇತೊ ಇನಕನಸ್ ಜಾ಼ವದೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 24:14" /><verse number="15" style="v" sid="EXO 24:15" />ಮೋಶೆ ಪಹಾಡ್‌ನ ಛ಼ಡ್ಯೊ ಅಜು಼ ವಾದ್‌ಳು ಪಹಾಡ್‌ನ ಮೂಚೈ಼ಗಯು. <verse eid="EXO 24:15" /><verse number="16" style="v" sid="EXO 24:16" />ಯೆಹೋವನಿ ಉಜಾ಼ಖ್ಹ್‌ ಸೀನಾಯಿ ಪಹಾಡ್‌ಪರ್ ಭೀರಿಗಯು ಅಜು಼ ಯೊ ವಾದ್‌ಳು ಛೋ಼ ದನ್‍ಲಗುಬಿ ಪಹಾಡ್‌ನ ಮೂಚಿರಾಖ್ಯುಥು. ಖ್ಹಾತ್‌ನ ದನ್‌ಮ ಯೆಹೋವ ವಾದ್ಳಮಾಥು ಮೋಶೆನ ಚಿಕ್ರಿನ್ ಬುಲಾಯೊ. <verse eid="EXO 24:16" /><verse number="17" style="v" sid="EXO 24:17" />ಯೆಹೋವನಿ ಉಜಾ಼ಖ್ಹ್‌ ಬಳಾನಿ ಆಗ್‌ನಿಮತ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ದೆಖಾಯು. <verse eid="EXO 24:17" /><verse number="18" style="v" sid="EXO 24:18" />ಮೋಶೆ ಯೊ ವಾದ್‌ಳಾನ ಮಹಿ ಪೇಶಿನ್ ಪಹಾಡ್ ಛ಼ಡ್ಯೊ. ಇನೆ ಯೊ ಪಹಾಡ್‌ಮ ಚಾ಼ಳಿಖ್ಹ್ ರೋಜ಼್ ರಾತ್‌ದನ್ ಯೊ ಪಹಾಡ್‌ಮಾಸ್ ಥೊ.<verse eid="EXO 24:18" /></para>
  <chapter eid="EXO 24" />
  <chapter number="25" style="c" sid="EXO 25" />
  <para style="s">ದೇವ್ನ ದರ್ಶನ್ನು ಡೇರಾನ ಕಾಣ್ಕೆಖ್ಹಾರು</para>
  <para style="r">(<ref loc="EXO 35:4-9">ವಿಮೋ 35:4-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 25:1" />ಯೆಹೋವನೆ ಮೋಶೆನ ಶಾತ್‌ ಬೋಲ್ಯೊಕತೊ, <verse eid="EXO 25:1" /><verse number="2" style="v" sid="EXO 25:2" />“ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಮಾರಖ್ಹಾಜೆ ಕಾಣ್ಕೆನ ಲೀನ್ ಆವ್ಣುಕರಿ ಇವ್ಣುನ ಬೋಲ್. ದಿಲ್‌ಥಿ ದ್ಯವಾಥಿಸ್ ಯೊ ಕಾಣ್ಕೆನ ಲೇವ್ಣು. <verse eid="EXO 25:2" /><verse number="3" style="v" sid="EXO 25:3" />ತೂ ಇವ್ಣೇಥಿ ಲ್ಯವಾನು ಕಾಣ್ಕೆಖ್ಹಾರು ಖಿವುಖಿವುಕತೊ, ಖ್ಹೊನ್ನು, ರೂಪು, ಅಜು಼ ತಾಂಬು, <verse eid="EXO 25:3" /><verse number="4" style="v" sid="EXO 25:4" />ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣೊ ರಂಗ್‌, ಲಲೇಲಾಲ್ ರಂಗ್‌ನು ಧಾಗೊಖ್ಹಾರುಬಿ, ಕೋರು ಲುಂಗ್‌ಡುಬಿ, ಬೋಕ್ಡಾನು ಕೇಖ್ಹ್‌ನು ರುಯ್‌ನು ಲುಂಗ್ಡಾವ್‌ಬಿ, <verse eid="EXO 25:4" /><verse number="5" style="v" sid="EXO 25:5" />ಹದಕರಿಹುಯು ಲಾಲ್‌ರಂಗ್ನು ಮೇಂಢಾನು ಚಾ಼ಂಬ್ಡು, ದರ‍್ಯಾವ್ನ ಜಾನ್ವರ್‌ನು ಚಾ಼ಂಬ್‌ಡುಖ್ಹಾರುಬಿ, ಬಾವಳ್ಯನು ಝಾ಼ಡ್‌ಬಿ, <verse eid="EXO 25:5" /><verse number="6" style="v" sid="EXO 25:6" />ಚಿಮ್ನಿನ ಹೋಣುತೆ ತೇಲ್‌ಬಿ, ಅಭಿಷೇಕನ ತೇಲ್ನ ಅಜು಼ ವಾನುಢಪ್‌ಕಾರನ ಹೋಣುತೆ ಅಛ್ಛಿವಾನು ತೈಲಾಬಿ, <verse eid="EXO 25:6" /><verse number="7" style="v" sid="EXO 25:7" />ಮಹಾಯಾಜಕ್‌ನು ಏಫೋದ್ ಅಜು಼ ಛಾ಼ತಿಪರ್ ಫೇರಾನು ಪದಕ್‌ಪರ್ ರ‍್ಹೇವ್ಣುತೆ ಗೋಮೇಧಕ ಹೀರೊಖ್ಹಾರು ಬಿಜೂ಼ ಅಲಕ್ ಅಲಕ್ ಹೀರೊಖ್ಹಾರು. <verse eid="EXO 25:7" /><verse number="8" style="v" sid="EXO 25:8" />“ಮೇ ಇವ್ಣ ಇಚ಼್‌ಮ ಜಿವ್ಣುಕರಾನ ಮನ ಎಕ್ ಡೇರಾನ ಘರ್‌ನ ಭಾಂದ್‌ಣು. <verse eid="EXO 25:8" /><verse number="9" style="v" sid="EXO 25:9" />ಮೇ ತುನ ವತಾಳನಿ ಪರಕ್ಮಾಸ್ ಡೇರಾನ ಘರ್‌ನಾಬಿ ಇನಾಮ ರ‍್ಹವಾನು ಅಖ್ಖುಸ್ ಖ್ಹಾಮನ್‌ಖ್ಹಾರುಬಿ ಕರಾವ್ಣು.<verse eid="EXO 25:9" /></para>
  <para style="s">ಒಪ್ಪಂದನೊ ಪಿಟಾರೊ</para>
  <para style="r">(<ref loc="EXO 37:1-9">ವಿಮೋ 37:1-9</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 25:10" />“ತೂ ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ಥಿ ಎಕ್ ಪಿಟಾರೊ ಕರಾವ್ಣು. ಯೊ ಅಢೈಹಾತ್‌ ಲಾಂಬು, ಡೋಡ್ ಹಾತ್ ಚೌ಼ಡುಬಿ ಬಿಜೂ಼ ಡೋಡ್ ಹಾತ್ ಊಚು಼ಬಿ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 25:10" /><verse number="11" style="v" sid="EXO 25:11" />ಅಫುಟ್‌ ಖ್ಹೊನ್ನಾನ ತಗ್‌ಡಾವ್ನ ಇನ ಭಾರ್‌ಬಿ ಅಜು಼ ಮಹಿಬಿ ಲಗಾಡ್‌ಣು. ಇನ ಉಪ್ಪರ್ ಅಶ್‌ಪಿಶ್‌ಬಿ ಖ್ಹೊನ್ನಾನು ತೋರಣ್ ಭಂದಾವ್ಣು. <verse eid="EXO 25:11" /><verse number="12" style="v" sid="EXO 25:12" />ಚಾರ್‌ ಖ್ಹೊನ್ನಾನು ಕಾಕ್ಣಿಯೆ ಇನ ಚಾರ್ ಕೋಣಮಛಾ಼ತೆ ಎಕೇಕೆ ಗೋಡನಬಿ ಬೆಬ್ಬೆ ಕಾಕ್ಣಿಯೆನ ಘಾಲ್‌ನು. <verse eid="EXO 25:12" /><verse number="13" style="v" sid="EXO 25:13" />ಯೊ ಪಿಟಾರನ ಪಾಡಾನಖ್ಹಾಜೆ ತು ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ನು ಖಂಬಾವ್ನ ಬಣೈನ್ ಯೋಖ್ಹಾರನ ಖ್ಹೊನ್ನಾನ ತಗ್‌ಡಾವ್ನ ಮೂಚಿನ್, <verse eid="EXO 25:13" /><verse number="14" style="v" sid="EXO 25:14" />ಪಿಟಾರನ ಭೇಬಾಜು಼ ಛಾ಼ತೆ ಕಂಗ್‌ಣಿಯೆಮ ಮಳಾವ್ಣು. <verse eid="EXO 25:14" /><verse number="15" style="v" sid="EXO 25:15" />ಯೊ ಖಂಬಾವ್ನ ಪಿಟಾರನು ಕಂಗ್‌ಣಿಯೆಥಿ ನಾಕಾಡ್ಣುತೆ ಇನಾಸ್‌ಮ ಮ್ಹೇಲಿರಾಕ್ಣು. <verse eid="EXO 25:15" /><verse number="16" style="v" sid="EXO 25:16" />ಯೊ ಪಿಟಾರಮ ಮೇ ತುನ ದ್ಯವಾನು ಹುಕುಮ್‌ನ ಬಂಡಾನ ಪಲ್ಗಾನ ಮ್ಹೇಲ್ನು. <verse eid="EXO 25:16" /><verse number="17" style="v" sid="EXO 25:17" />ಅಫುಟ್ ಖ್ಹೊನ್ನಾನು ಕೃಪಾಸನ್‌ನ ಬಣಾವ್ಣು. ಯೊ ಅಢೈಹಾತ್ ಲಾಂಬುಬಿ, ಡೋಡ್ ಹಾತ್ ಚೌ಼ಡುಬಿ ಹುಯಿರ‍್ಹೇಣು. <verse eid="EXO 25:17" /><verse number="18" style="v" sid="EXO 25:18" />ಕೃಪಾಸನ್ನು ಬೇ ನೋಕ್‌ಮ ಬೇ ಖ್ಹೊನ್ನಾನು ಕೆರೂಬಿಯೇವ್ನ ನಕ್ಷಾನ ಕಾಮ್‍ಥಿ ಬಣಾವ್ಣು. <verse eid="EXO 25:18" /><verse number="19" style="v" sid="EXO 25:19" />ಕೃಪಾಸನ್ನು ಏಕೇಕ್‌ ಕೋಣನಾಬಿ ಏಕೇಕ್‌ ಕೆರೂಬಿನ ಕರೈನ್ ಇನ ಕೃಪಾಸನ್ನ ಜೋ಼ಡ್ ಕರ‍್ನು. <verse eid="EXO 25:19" /><verse number="20" style="v" sid="EXO 25:20" />ಯೊ ಕೆರೂಬಿಖ್ಹಾರು ಉಪ್ಪರ್ ಫಾಕ್ಡಿಯೇನ ಫಖ್ಹಾರಿರಾಖನಿತರಬಿ ಅಜು಼ ಕೃಪಾಸನ್‌ನ ಇನಿ ಫಾಕ್ಡಿಥಿ ಢಾಪಿರಾಖನಿತರಬಿ ರ‍್ಹೇವ್ಣು. ಇವ್ಣು ಮ್ಹೋಡುಖ್ಹಾರು ಆಮೆಖ್ಹಾಮೆಥಿ ಕೃಪಾಸನ್‌ನ ದೇಖನಿತರ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 25:20" /><verse number="21" style="v" sid="EXO 25:21" />ಯೊ ಕೃಪಾಸನ್‌ನ ಪಿಟಾರನ ಉಪ್ಪರ್ ಮ್ಹೇಲ್ನು. ಮೇ ತುನ ದ್ಯವಾನು ಹುಕುಮ್‌ನು ಲೀಖ್ಯಾವ್ನ ಯೊ ಪಿಟಾರನ ಮಹಿ ಘಾಲ್‌ನು. <verse eid="EXO 25:21" /><verse number="22" style="v" sid="EXO 25:22" />ಹಿಜ಼್ಜಸ್ ಮೇ ತುನ ದರ್ಶನ್ ದಿಶ್. ಕೃಪಾಸನ್ನ ಉಪ್ಪರ್ ಹುಕುಮ್‌ನಿ ಲೀಖ್ಯಾವ್ನ ಮ್ಹೇಲಿರಾಖ್ಯುತೆ ಪಿಟಾರನ ಉಪ್ಪರ್ ಬೇ ಕೆರೂಬಿಯೇವ್ನ ಬೀಚ್ಮಾಸ್ ಮೇ ರ‍್ಹೀನ್ ತುಮಾರ ಜೋ಼ಡೆ ವಾತೆ ಬೋಲಿನ್ ತು ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಹುಕುಮ್ ಕರ‍್ನುತೆ ಹಿಡಿ ವಾತೇವ್ನ ಬೋಲಿದಿಶ್.<verse eid="EXO 25:22" /></para>
  <para style="s">ರೋಟಾನಿ ಖುಡ್‌ಷಿ</para>
  <para style="r">(<ref loc="EXO 37:10-16">ವಿಮೋ 37:10-16</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 25:23" />“ತು ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ಥಿ ಎಕ್ ಖುಡ್‌ಷಿನ ಕರಾವ್ಣು. ಯೊ ಬೇ ಹಾತ್ ಲಾಂಬುಬಿ, ಎಕ್ ಹಾತ್ ಚೌ಼ಡುಬಿ, ಡೋಡ್ ಹಾತ್ ಊಚು಼ಬಿ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 25:23" /><verse number="24" style="v" sid="EXO 25:24" />ಇನ ಅಫುಟ್ ಖ್ಹೊನ್ನಾನ ತಗಡ್‌ಥಿ ಢಾಪಿನ್, ಅಶ್‌ಪಿಶ್‌ಬಿ ಖ್ಹೊನ್ನಾನಿ ತೋರಣ್ ಭಂದಾವ್ಣು. <verse eid="EXO 25:24" /><verse number="25" style="v" sid="EXO 25:25" />ಖುಡ್‌ಷಿನ ಅಶ್‌ಪಿಶ್‌ಬಿ ಹತೇಳಿಯೆತ್ರೆ ಚೌ಼ಡುರ‍್ಹವಾನು ಆಡಿ ಪಟ್ಟಿನ ಕರೈನ್ ಇನಾಬಿ ಖ್ಹೊನ್ನಾನ ತೋರಣ್ ಭಂದಾವ್ಣು. <verse eid="EXO 25:25" /><verse number="26" style="v" sid="EXO 25:26" />ಚಾರ್‌ ಖ್ಹೊನ್ನಾನು ಕಾಕ್ಣಿನ ಕರೈನ್ ಖುಡ್‌ಷಿನ ಚಾರ್ ಗೋಡಾವ್‌ನಾಬಿ ಘಾಲ್‌ನು. <verse eid="EXO 25:26" /><verse number="27" style="v" sid="EXO 25:27" />ಯೊ ಕಾಕ್ಣಿಯೆ ಆಡಿಪಟ್ಟಿನ ಲಾಗಿರ‍್ಹೇಣು. ಖುಡ್‌ಷಿನ ಪಾಡಾನಖ್ಹಾಜೆ ಲಠ್ಠಾವ್ನ ಇನಾಮ ಪೆಖ್ಹಾಡ್‌ಣು. <verse eid="EXO 25:27" /><verse number="28" style="v" sid="EXO 25:28" />ಯೊ ಲಠ್ಠಾವ್ನ ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ಥಿ ಕರೈನ್ ಇನ ಖ್ಹೊನ್ನಾನ ತಗ್‌ಡಾವ್ನ ಮೂಚ಼್‌ಣು. ಇನೇಥಿಸ್ ಖುಡ್‌ಷಿನ ಪಾಡ್‌ನು. <verse eid="EXO 25:28" /><verse number="29" style="v" sid="EXO 25:29" />ಮೇಜ್‌ನ ಉಪ್ಪರ್ ಮ್ಹೇಲ್ನುತೆ ಕಾಠುಕ್‌ಖ್ಹಾರುಬಿ, ಢಾಕ್ಣಿಬಿ, ತಾಂಬ್ಯಬಿ, ಪಿಯ್ಯಾನ ಹೋಣುತೆ ಕಟೋರಾವ್ನ ಅಫುಟ್ ಖ್ಹೊನ್ನೆಥೀಸ್ ಕರಾವ್ಣು. <verse eid="EXO 25:29" /><verse number="30" style="v" sid="EXO 25:30" />ಪರಿಶುದ್ ರೋಟೊ ಹರೇಕ್‌ದನ್ ಯೊ ಖುಡ್‌ಷಿನ ಉಪ್ಪರ್ ಮಾರ ಖ್ಹಾಮ್ಣೆಸ್ ಮ್ಹೇಲಿರಾಕ್ಣು.<verse eid="EXO 25:30" /></para>
  <para style="s">ದಿವೋನು ಖಂಬು</para>
  <para style="r">(<ref loc="EXO 37:17-24">ವಿಮೋ 37:17-24</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 25:31" />“ಅಫುಟ್ ಖ್ಹೊನ್ನಾನು ದಿವೋನು ಖಂಬು ಕರಾವ್ಣು. ಯೊ ಖಂಬಾನು ಹೇಟ್‌ಲ್ಯ ಭಾಗ್ನ ನಕ್ಷಾನ ಕಾಮ್‍ಥಿ ಕರಾವ್ಣು. ಯೊ ದಿವೋನು ಖಂಬು ಅಖ್ಖೂಸ್ ದೇಖಾವನಿತರ ಫೂಲ್‌ನೊ ಗುಚ್ಚಾ಼ಥಿಬಿ, ಛಿದ್ರಾಯ ಹುಯ ಫೂಲ್‌ಥಿಬಿ, ಗೋಂಡಿಯೆಥಿ ಭರೈರ‍್ಹೀನ್ ಶನ್‌ಗಾರ್‌ಥಿ ಕೆತ್ತೈರ‍್ಹೇಣು. <verse eid="EXO 25:31" /><verse number="32" style="v" sid="EXO 25:32" />ಖಂಬಾನು ಏಕೇಕ್‌ ಬಾಜು಼ಬಿ ತೀನ್‌ತೀನ್ ಡಾಳಿಯೆನಿಘೋಣಿ ಇಮ್ಮಸ್ ಛೋ಼ ಡಾಳಿಯೆಬಿ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 25:32" /><verse number="33" style="v" sid="EXO 25:33" />ಹರೇಕ್ ಡಾಳಿಯೆವ್ಮ ಬಾದಾಮ್‌ನ ಫೂಲ್‌ನಿಘೋಣಿನು ತೀನ್‌ತೀನ್ ಫೂಲ್‌ಬಿ ಗೋಂಡಿಯೆಬಿ ರ‍್ಹೇವ್ಣು. ದಿವೋನು ಖಂಬಾಥು ಆವಾನಿ ಛೋ಼ ಡಾಳಿಯೆನಾಬಿ ಇಮ್ಮಸ್ ಕರಾವ್ಣು. <verse eid="EXO 25:33" /><verse number="34" style="v" sid="EXO 25:34" />ದಿವೋನು ಖಂಬ್‌ನಿ ಡಾಳಿಯೆವ್ಮ ಫೂಲ್‌ನೊ ಗುಚ್ಚೊ಼ಬಿ, ಫೂಲ್‌ಖ್ಹಾರುಬಿ, ಗೋಂಡಿಯೆಬಿ ರ‍್ಹವಾನು ಬಾದಾಮ್‌ನ ಫೂಲ್‌ನಿಘೋಣಿ ಚಾರ್ ಫೂಲ್‌ನಿ ಶನ್‌ಗಾರ್‌ಖ್ಹಾರುಬಿ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 25:34" /><verse number="35" style="v" sid="EXO 25:35" />ಬೆಬ್ಬೇ ಡಾಳಿಯೆ ಫಾಕೆಮ್ಹೆಲಿರಾಖಾನಿ ಝ಼ಗೊಖ್ಹಾರು ಏಕೇಕ್‌ ಗೋಂಡಿ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 25:35" /><verse number="36" style="v" sid="EXO 25:36" />ಫೂಲ್, ಗೋಂಡಿಯೆ, ಡಾಳಿಯೆಥಿ ರ‍್ಹವಾನು ದಿವೋನು ಖಂಬ್‌ಖ್ಹಾರುಸ್ ಏಕ್‌ದಮ್ ಅಫುಟ್ ಖ್ಹೊನ್ನಾನ ನಕ್ಷಾನ ಕಾಮ್‌ಥಿಸ್ ಕರಾವ್ಣು. <verse eid="EXO 25:36" /><verse number="37" style="v" sid="EXO 25:37" />ಇನ ಖ್ಹಾತ್ ದಿವಳ್‌ಗಿನ ಕರಾವ್ಣು. ಯೊ ದಿವಳ್‌ಗಿನು ಉಜಾ಼ಳು ಖ್ಹಾಮ್ಣೆಥು ಪಡಾನಿತರ ಯೊಖ್ಹಾರನ ಲಗಾಡಿರಾಕ್‌ಣು. <verse eid="EXO 25:37" /><verse number="38" style="v" sid="EXO 25:38" />ದಿವೋನು ಬತ್ತಿ ಕಾಡಾನ ಕತರ್ನಿಬಿ, ಕತ್ರಿಹುಯಿ ನೋಕ್ ನಾಖಾನ ಕಟೋರನಾಬಿ ಅಫುಟ್ ಖ್ಹೊನ್ನೆಥೀಸ್ ಕರಾವ್ಣು. <verse eid="EXO 25:38" /><verse number="39" style="v" sid="EXO 25:39" />ದಿವೋನು ಖಂಬುಬಿ ಇನು ಕಾಮ್ನು ಖ್ಹಾರುಸ್ ಜಿನಖ್ಹ್‌ಬಿ ಪಾಚು಼ಪ್ಪರ್ ಡೋಡಿಖ್ಹ್‌ ಕಿಲೊ ಅಫುಟ್‌ ಖ್ಹೊನ್ನೇಥಿ ಹುಯಿರ‍್ಹೇವ್ಣು. <verse eid="EXO 25:39" /><verse number="40" style="v" sid="EXO 25:40" />ದೇಕ್, ಪಹಾಡ್‌ಮ ಮೇ ತುನ ವತಾಳ್ಯೊತೆ ಪರಕ್ಮಾಸ್ ಅಖ್ಖಾನ ಹೊಷಾರ್‌ಥಿ ಕರಾವ್ಣು.”<verse eid="EXO 25:40" /></para>
  <chapter eid="EXO 25" />
  <chapter number="26" style="c" sid="EXO 26" />
  <para style="s">ಯೆಹೋವನು ಝ಼ಗೋನು ಡೇರೊ</para>
  <para style="r">(<ref loc="EXO 36:8-38">ವಿಮೋ 36:8-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 26:1" />ಮನ ರ‍್ಹವಾನಖ್ಹಾಜೆ ಎಕ್ ಡೇರಾನ ಘರ್‌ನ ದಖ್ಹ್‌ ಪಡ್ದೇಥಿ ಕರಾವ್ಣು. ಯೊ ಕವ್‌ಳು ಕೋರು ಲುಂಗ್ಡ ಹುಯಿರ‍್ಹೇಣು. ಇನಾಮ ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣೊ ರಂಗ್ ಅಜು಼ ಲಲೇಲಾಲ್ ರಂಗ್‌ನ ಉಲ್ಲನ್ನ ಧಾಗೇಥಿ ಕೆರೂಬಿಯೇವ್ನ ವಣ್‌ಖರ್‌ಥಿ ಬಣಾವಟ್ ಕರ‍್ನು. <verse eid="EXO 26:1" /><verse number="2" style="v" sid="EXO 26:2" />ಹರೇಕ್ ಲುಂಗ್‌ಡೂಬಿ ಆಟ್ ಉಪ್ಪರ್ ವೀಖ್ಹ್‌ ಹಾತ್ ಲಾಂಬುಬಿ ಚಾರ್ ಹಾತ್ ಚೌ಼ಡುಬಿ ರ‍್ಹೇವ್ಣು. ಅಖ್ಖುಸ್ ಪಡ್‌ದೊಖ್ಹಾರು ಎಕ್ಕಸ್ ಆಳ್ತಿನು ರ‍್ಹೇಣು. <verse eid="EXO 26:2" /><verse number="3" style="v" sid="EXO 26:3" />ಪಾಚ಼್-ಪಾಚ಼್ ಲುಂಗ್ಡಾನು ಪಡ್‌ದಾವ್ನ ಎಕೇಕೆ ಜೋ಼ಡ್‌ಕರ‍್ನು. <verse eid="EXO 26:3" /><verse number="4" style="v" sid="EXO 26:4" />ಆ ಭೇ ಬಿಡ್ಕಿಮ ಎಕೇಕೆನು ಕಡ್‌ಶಿನ ಲುಂಗ್ಡಾನ ಪಡ್ದಾನಿ ನೋಕ್‌ಮ ನೀಲಿ ಧಾಗೇಥಿ ಫುಂದಾವ್ನ ಕರಾವ್ಣು. <verse eid="EXO 26:4" /><verse number="5" style="v" sid="EXO 26:5" />ಯೊ ಫುಂದೊ ಅಢೈಖ್ಹ್‌ ಅಢೈಖ್ಹ್‌ನಿ ಪರಕ್ಮ ಏಕ್‌ಥಿಏಕ್‌ ಆಮಖ್ಹಾಮೆ ರ‍್ಹೇಣು. <verse eid="EXO 26:5" /><verse number="6" style="v" sid="EXO 26:6" />ಆಸ್ ಕಾಹೆತೆ ಅಢೈಖ್ಹ್ ಖ್ಹೊನ್ನಾನು ಅಖುಟಾವ್ನ ಕರೈನ್ ಯೊ ಪಡ್‌ದಾವ್ನ ಏಕ್‌ಥಿಏಕ್‌ ಮಳಾವ್ಣು. ಅಮ್ ಎಕ್ಕಸ್ ಡೇರಾನುಘರ್ ಬಣ್‌ಷೆ.<verse eid="EXO 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 26:7" />ಆ ಡೇರಾನ ಘರ್‌ಪರ್ ಹೋಡಾವನಖ್ಹಾಜೆ ಬೋಕ್ಡಾನು ರುಯ್‌ನು ಗ್ಯಾರ‍್ಹ ಲುಂಗ್ಡಾವ್ನ ಕರಾವ್ಣು. <verse eid="EXO 26:7" /><verse number="8" style="v" sid="EXO 26:8" />ಏಕೇಕ್‌ ಪಡ್‌ದೊ ಡೋಡಿಖ್ಹ್‌ಹಾತ್‌ ಲಾಂಬುಬಿ ಚಾ಼ರ್‌ಹಾತ್‌ ಚೌ಼ಡುಬಿ ರ‍್ಹೇವ್ಣು. ಅಖ್ಖೂಸ್ ಪಡ್‌ದೊಖ್ಹಾರು ಎಕ್ಕಸ್ ಆಳ್ತಿ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 26:8" /><verse number="9" style="v" sid="EXO 26:9" />ಪಾಚ಼್ ಪಡ್‌ದಾವ್ನ ಎಕ್ಟು ಜೋ಼ಡ್‌ಕರಿನ್ ಛೋ಼ನ ಪಡ್ದಾನ ಡೇರಾನ ಘರ್‌ನು ಖ್ಹಾಮ್ಣೆ ಬಿಡ್ಕಿಕರಿನ್‌ ಠಂಗಿರ‍್ಹಾವನಿತರ ಮ್ಹೇಲ್ನು. <verse eid="EXO 26:9" /><verse number="10" style="v" sid="EXO 26:10" />ಅಮ್ ಮಳೈನ್ ವಣಿಹುಯು ಲುಂಗ್ಡಾವ್ನ ನೋಕ್‌ಮ ಅಢೈಖ್ಹ್‌ ಅಢೈಖ್ಹ್‌ ಫುಂದಾವ್ನ ಕರಾವ್ಣು. <verse eid="EXO 26:10" /><verse number="11" style="v" sid="EXO 26:11" />ತಾಂಬಾನಿ ಅಢೈಖ್ಹ್ ಅಖುಟಾವ್ನ ಕರೈನ್ ಫುಂದಾವ್ಮ ಅಟ್‌ಕೈನ್ ತಮಾಮ್‌ಬಿ ಮಳಿನ್ ಎಕ್ಕಸ್ ಡೇರಾನುಘರ್ ಹುವಾನಿತರ ಜೋ಼ಡ್‌ಕರ‍್ನು. <verse eid="EXO 26:11" /><verse number="12" style="v" sid="EXO 26:12" />ಹೋಡಾನ ಲುಂಗ್ಡಾವ್ಮ ಆಧೊ ಪಡ್‌ದೊ ಜಾ಼ಖ್ಹತ್‌ರ‍್ಹಿಷೆ, ಯೊ ಜಾ಼ಖ್ಹತ್ನು ಭಾಗ್ನ ಡೇರಾನ ಘರ್‌ನ ಪೀಠೆನಭಾಗ್‌ಮ ಬಿಡ್‌ಕಿ ಕರಿನ್ ಠಂಗಿರ‍್ಹಾವನಿತರ ಮ್ಹೇಲ್ನು. <verse eid="EXO 26:12" /><verse number="13" style="v" sid="EXO 26:13" />ಢಾಪನ ಲುಂಗ್ಡಾವ್‌ನು ಲಾಂಬಮ ಹೈಕಡ್ ಎಕ್ ಹಾತ್‌ಬಿ, ಹಿಕಡ್ ಎಕ್ ಹಾತ್‌ಬಿ ಜಾ಼ಖ್ಹತ್ ರ‍್ಹಿಶೆ. ಯೊ ಮಹಿನು ಭಾಗ್‌ನು ಡೇರಾನ ಘರ್‌ನ ಮೂಚ಼ವನಿತರ ಹೈಕಡ್‌ಬಿ ಹಿಕಡ್‌ಬಿ ಠಂಗಿರ‍್ಹಾವನಿಘೋಣಿ ರ‍್ಹೇಣು.<verse eid="EXO 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 26:14" />ಆ ಹೋಡ್‌ಣಿನ ಢಾಪನಖ್ಹಾಜೆ ಹದಕರಿರಾಖನು ಲಾಲ್‌ರಂಗ್ನು ಮೇಂಢಾನ ಚಾ಼ಂಬ್ಡಾವ್‌ಥಿ ಏಕ್‌ ಪರ್‌ಖೊಂಡನಾಬಿ ದರ‍್ಯಾವ್ನ ಜಾನ್ವರ್‌ನ ಚಾ಼ಂಬ್ಡಾವ್‌ಥಿ ಅಜೇಕ್ ಪರ್‌ಖೊಂಡನಾಬಿ ಕರಾವ್ಣು. <verse eid="EXO 26:14" /><verse number="15" style="v" sid="EXO 26:15" />ಡೇರಾನ ಘರ್‌ನ ಹೋಣುತೆ ಚೌಕಟ್ನ ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ಥಿ ಕರಾವ್ಣು. <verse eid="EXO 26:15" /><verse number="16" style="v" sid="EXO 26:16" />ಹರೇಕ್ ಚೌಕಟ್‌ ದಖ್ಹ್‌ಹಾತ್‌ ಲಾಂಬುಬಿ ಡೋಡ್‌ಹಾತ್‌ ಚೌ಼ಡುಬಿ ರ‍್ಹೇಣು. <verse eid="EXO 26:16" /><verse number="17" style="v" sid="EXO 26:17" />ಹರೇಕ್ ಚೌಕಟ್‌ ಆಡುಪಟ್ಟೀಥಿ ಮಳಿರ‍್ಹಯುಹುಯು ಬೇ ಭಿರಾವನ ಖಂಬ ಹುಯಿರ‍್ಹೇಣು. ಡೇರಾನ ಘರ್‌ನು ಅಖ್ಖು ಚೌಕಟ್‌ಬಿ ಇಮ್ಮಸ್ ಕರಾವ್ಣು. <verse eid="EXO 26:17" /><verse number="18" style="v" sid="EXO 26:18" />ಘರ್‌ನ ದಕ್ಷಿಣ್ ದಿಕ್ಮ ವೀಖ್ಹ್‌ ಚೌಕಟ್ನ ಭೀರಾಕ್ಣು. <verse eid="EXO 26:18" /><verse number="19" style="v" sid="EXO 26:19" />ಚಾ಼ಳಿಖ್ಹ್ ರೂಪಾನು ಹುದಿನೊ ಬಂಡೊಕರೈನ್ ಯೊ ವೀಖ್ಹ್‌ ಚೌಕಟ್ನ ಹೇಟ್ ಮ್ಹೇಲ್ನು. ಏಕೇಕ್‌ ಚೌಕಟ್‌ಮ ಛಾ಼ತೆ ಬೇ ಪಟ್ಟಿಯೇವ್ನ ಏಕೇಕ್‌ ಹುದಿನೊ ಬಂಡೊರ‍್ಹೇಣು. <verse eid="EXO 26:19" /><verse number="20" style="v" sid="EXO 26:20" />ಇಮ್ಮಸ್ ಡೇರಾನ ಉತ್ತರ್ ದಿಕ್‌ಭಣಿಬಿ ವೀಖ್ಹ್‌ ಚೌಕಟ್‌ಖ್ಹಾರು, <verse eid="EXO 26:20" /><verse number="21" style="v" sid="EXO 26:21" />ಅಜು಼ ಹರೇಕ್ ಚೌಕಟ್ನ ಬೆಬ್ಬೆ ರೂಪಾನೊ ಹುದಿನೊ ಬಂಡೊಖ್ಹಾರು ರ‍್ಹೇಣು. <verse eid="EXO 26:21" /><verse number="22" style="v" sid="EXO 26:22" />ಡೇರಾನ ಪಚ್‌ಕೊಡೆ ಕತೊ ಪಶ್ಚಿಮ್ ದಿಕ್ಮ ಛೋ಼ ಚೌಕಟ್ನ ಕರಾವ್ಣು. <verse eid="EXO 26:22" /><verse number="23" style="v" sid="EXO 26:23" />ಡೇರಾನಿ ಪೀಠೆನು ಬೇ ಕೋಣಾವ್ನ ಅಲಕ್ ಬೇ ಚೌಕಟ್ನ ಕರಾವ್ಣು. <verse eid="EXO 26:23" /><verse number="24" style="v" sid="EXO 26:24" />ಯೊಖ್ಹಾರನ ಹೇಟ್‌ಥು ಧರಿನ್ ಉಪ್ಲಿ ನೋಕ್ ಲಗೂಬಿ ಮಳೈರಾಕ್‌ಣು. ಉಪ್ಲಿ ಬಾಜು಼ಬಿ ಎಕ್ಕಸ್ ಕಾಕ್ಣಿಮ ಮಳೈರಾಕ್‌ಣು. ಇಮ್ಮಸ್ ಭೇ ಕೋಣಾವ್ನಬಿ ಕರಾವ್ಣು. <verse eid="EXO 26:24" /><verse number="25" style="v" sid="EXO 26:25" />ಅಮ್ ಪೀಠೆನಿ ಬಾಜು಼ಮ ಆಟ್ ಚೌಕಟ್‌ಬಿ ಅಜು಼ ಹರೇಕ್ ಚೌಕಟ್ನ ರೂಪಾನೊ ಹುದಿನೊ ಬಂಡೋಬಿ ಬೋಲ್ನುಕತೊ ಖ್ಹೋಳ ಹುದಿನೊ ಬಂಡೊಖ್ಹಾರು ರ‍್ಹೇಣು. <verse eid="EXO 26:25" /><verse number="26" style="v" sid="EXO 26:26" />ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ಥಿ ಗಡಾವ್ನ ಕರಾವ್ಣು. ಘರ್‌ನು ಭೇಬಾಜು಼ನು ಚೌಕಟ್‌ನಬಿ, <verse eid="EXO 26:26" /><verse number="27" style="v" sid="EXO 26:27" />ಇನು ಪೀಠೆನು ಕತೊ ದನ್ ನಿಕ್‌ಳಭಣಿನು ಚೌಕಟ್‌ನಬಿ ಪಾಚ಼್-ಪಾಚ಼್ ಗಡಾವ್ನ ಕರಾವ್ಣು. <verse eid="EXO 26:27" /><verse number="28" style="v" sid="EXO 26:28" />ಚೌಕಟ್‌ಅಖ್ಖಾನು ಇಚ಼್ಮ ರ‍್ಹವಾನು ಗಡಾ ಎಕ್ ನೋಕ್‌ಥು ಬಿಜೇಕ್ ನೋಕ್‌ಲಗುಬಿ ಛಿಮಾವನಿಘೋಣಿ ರ‍್ಹೇಣು. <verse eid="EXO 26:28" /><verse number="29" style="v" sid="EXO 26:29" />ಯೊ ಚೌಕಟ್ನ ಖ್ಹೊನ್ನಾನ ತಗ್‌ಡಾವ್‌ಥಿ ಮೂಚಿನ್ ಇನಾಮ ಯೊ ಗಡಾನಖ್ಹಾಜೆ ಖ್ಹೊನ್ನಾನಿ ಕಾಕ್ಣಿನ ಕರಾವ್ಣು. ಯೊ ಅಖುಟಾವ್ನಬಿ ಖ್ಹೊನ್ನಾನ ತಗ್‌ಡಾವ್‌ಥಿ ಮೂಚ಼್‌ಣು. <verse eid="EXO 26:29" /><verse number="30" style="v" sid="EXO 26:30" />ಮೇ ಪಹಾಡ್‌ಮ ತುನ ವತಾಳಿದಿದೊತೆ ಪರಕ್ಮಾಸ್ ಡೇರಾನ ಘರ್‌ನ ಭೀರಾಕ್ಣು.<verse eid="EXO 26:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 26:31" />ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣೊ ರಂಗ್, ಲಲೇಲಾಲ್‌ ರಂಗ್‌ನು ಖ್ಹುತ್ತರ್‌ನ ಧಾಗೇಥಿ ಕೆರೂಬಿಯೇವ್ನ ಚಮತ್ಕಾರ್‌ನಿತರ ವಣ್‌ಖರ್ ನಖಾವ್ಣು. <verse eid="EXO 26:31" /><verse number="32" style="v" sid="EXO 26:32" />ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ಥಿ ಚಾರ್ ಖಂಬಾವ್ನ ಕರೈನ್, ಖ್ಹೊನ್ನಾನ ತಗಡ್‌ನ ಮೂಚಿನ್, ಚಾರ್ ರೂಪಾನ ಹುದಿನ ಬಂಡಾವ್ನ ಉಪ್ಪರ್ ಭಿರಾಖಿನ್ ಖ್ಹೊನ್ನಾನಿ ಕಣ್ಣಿಯೆವ್‌ಥಿ ಯೊ ಪಡ್‌ದಾವ್ನ ಯೊ ಚಾರ್ ಖಂಬಾವ್ನ ಅಟ್‌ಕಾವ್ಣು. <verse eid="EXO 26:32" /><verse number="33" style="v" sid="EXO 26:33" />ಯೊ ಪಡ್ದಾನ ಕಣ್ಣಿಯೆಮ ಅಟ್‌ಕಾವನಿ ವಖ್ಹ್‌ತೆ ಇನಾಮಹಿ ಹುಕುಮ್‌ನ ಪಲ್ಗಾವ್ನ ಪಿಟಾರನ ಮಂಗೈ ಮ್ಹೇಲ್ನು. ಯೊ ಪಡ್‌ದೊ ಪವಿತ್ರಝ಼ಗೊಕರಿಬಿ ಮಹಾಪವಿತ್ರಝ಼ಗೊಕರಿಬಿ ಭಾಗ್‌ಕರಾಸ್. <verse eid="EXO 26:33" /><verse number="34" style="v" sid="EXO 26:34" />ಮಹಾನ್ ಪವಿತ್ರಝ಼ಗೋಮ ಹುಕುಮ್‌ನು ಪಲ್ಗಾವ್ನ ಪಿಟಾರನಪರ್ ಕೃಪಾಸನ್‌ನ ಲಯಿನ್‌ಮ್ಹೇಲಾವ್ಣು. <verse eid="EXO 26:34" /><verse number="35" style="v" sid="EXO 26:35" />ಪಡ್ದಾನ ಭಾರ್‌ಮ ಖುಡ್‌ಷಿನಬಿ ಖುಡ್‌ಷಿನ ಖ್ಹಾಮ್ಣೆಕರಿ ಘರ್‌ನು ದಕ್ಷಿಣ್ ದಿಕ್ಮ ದಿವ್ವಾನ ಖಂಬಾನ ಮ್ಹೇಲ್ನು. ಖುಡ್‌ಷಿ ಉತ್ತರ್ ಬಾಜು಼ಭಣಿ ರ‍್ಹೇಣು.<verse eid="EXO 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 26:36" />ಡೇರಾನು ದರ್ವಾಜ಼ನ ಆಡು ಖ್ಹಾಜ಼್‌ನಿ ಬಣಾವಟ್ ಕರ‍್ಯಹುಯ ಖ್ಹುತ್ತರ್‌ನ ಧಾಗಾನ ಪಡ್ದೇಥಿ ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣೊ ರಂಗ್, ಲಲೇಲಾಲ್ ರಂಗ್‌ನ ಉಲ್ಲನ್‌ಥಿ ವಣ್‌ಖರ್ ನಖೈನ್ ಪಡ್‌ದೊ ಕರಾವ್ಣು. <verse eid="EXO 26:36" /><verse number="37" style="v" sid="EXO 26:37" />ಯೊ ಪಡ್ದೊ ಠಂಗಾವನಖ್ಹಾಜೆ ಬಾವಳ್ಯನು ಝಾ಼ಡ್‌ಥಿ ಪಾಚ಼್ ಖಂಬಾವ್ನ ಕರೈನ್ ಖ್ಹೊನ್ನಾನ ತಗ್‌ಡಾವ್‌ಥಿ ಮೂಚಾ಼ವ್ಣು. ಇನ ಅಖ್ಖ ಅಖುಟಾವ್ನ ಖ್ಹೊನ್ನೇಥಿ ಕರೈನ್ ಯೊ ಅಖ್ಖಾನಖ್ಹಾಜೆ ಪಾಚ಼್ ತಾಂಬಾನು ಹುದಿನ ಬಂಡಾವ್ನ ಕರಾವ್ಣು.<verse eid="EXO 26:37" /></para>
  <chapter eid="EXO 26" />
  <chapter number="27" style="c" sid="EXO 27" />
  <para style="s">ಬಲಿಪೀಠ್ (ಚಾ಼ಚ಼ರ್‌)</para>
  <para style="r">(<ref loc="EXO 38:1-7">ವಿಮೋ 38:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 27:1" />ಚಾ಼ಚ಼ರ್‌ನ ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ಥಿ ಪಾಚ಼್‌ಹಾತ್‌ ಲಾಂಬುಬಿ, ಪಾಚ಼್‌ಹಾತ್‌ ಚೌ಼ಡುಬಿ ಚಾರ್‌ಖೂಟಿ ಕರಾವ್ಣು. ಅಜು಼ ಯೊ ತೀನ್ ಹಾತ್ ಊಚು಼ ರ‍್ಹೇಣು. <verse eid="EXO 27:1" /><verse number="2" style="v" sid="EXO 27:2" />ಇನು ಚಾರ್ ಕೋಣಾಮ ಚಾರ್ ಶಿಂಗ್‌ಡಾವ್ನ ಕರಾವ್ಣು. ಯೊ ಶಿಂಗ್‌ಡುಅಖ್ಖು ಚಾ಼ಚ಼ರ್‌ಥಿಸ್ ಆಯುಹುಯು ರ‍್ಹೇವ್ಣು. ಯೊ ಚಾ಼ಚ಼ರ್‌ನ ತಾಂಬಾನ ತಗ್‌ಡಾವ್ನ ಮೂಚ಼್‌ಣು. <verse eid="EXO 27:2" /><verse number="3" style="v" sid="EXO 27:3" />ಇನಾಮನು ರಾಕ್‌ನ ಕಾಡಾನಖ್ಹಾಜೆ ಪತ್ತರ್‌ಬಿ, ಖಿಲ್ಲಾಬಿ, ಬೋಗುಣಿಯೆಬಿ, ಕಾಟಾನಿ ಡೋಯ್‌ಬಿ, ಅಜು಼ ಖಾಂಜ಼್‌ರಿನೊಛು಼ಲ್ಲೊ ಕರಾವ್ಣು. ಆ ಜಿನಖ್ಹ್‌ಖ್ಹಾರು ತಾಂಬಾನು ಹುಯಿರ‍್ಹೇವ್ಣು. <verse eid="EXO 27:3" /><verse number="4" style="v" sid="EXO 27:4" />ಚಾ಼ಚ಼ರ್‌ನ ವಣಾನ ಕಾಮ್‍ಥಿ ತಾಂಬಾನಿ ಖಾಂಜ್ರಿನ ಕರಾವ್ಣು, ಯೊ ಖಾಂಜ್ರಿನು ಚಾರ್ ಕೋಣಾವ್ನ ತಾಂಬಾನಿ ಕಾಕ್ಣಿಯೇವ್ನ ಘಲಾವ್ಣು. <verse eid="EXO 27:4" /><verse number="5" style="v" sid="EXO 27:5" />ಯೊ ಖಾಂಜ್‌ರಿ ಚಾ಼ಚ಼ರ್‌ನು ಅಶ್‌ಪಿಶ್ ಛಾ಼ತೆ ಕಟ್ಟಾನ ಹೇಟ್‌ಲಗು ರ‍್ಹೀನ್ ಚಾ಼ಚ಼ರ್‌ನ ಹೇಟ್‌ಥು ಬೀಚ್‌ಲಗು ರ‍್ಹವಾನಿತರ ಘಲಾವ್‌ಣು. <verse eid="EXO 27:5" /><verse number="6" style="v" sid="EXO 27:6" />ಚಾ಼ಚ಼ರ್‌ನ ಪಾಡಾನು ಲಠ್ಠಾವ್ನ ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ಥಿ ಕರೈನ್, ತಾಂಬಾನ ತಗ್‌ಡಾವ್ನ ಮೂಚ಼್‌ಣು. <verse eid="EXO 27:6" /><verse number="7" style="v" sid="EXO 27:7" />ಯೊ ಲಠ್ಠಾವ್ನ ಯೊ ಕಾಕ್ಣಿಯೆಮ ಪೆಖ್ಹಾಡನಿ ವಖ್ಹ್‌ತೆ ಯೊ ಹೈರುತೆ ಚಾ಼ಚ಼ರ್‌ನ ಪಾಡನಖ್ಹಾಜೆ ಇನು ಭೇ ಬಾಜು಼ಬಿ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 27:7" /><verse number="8" style="v" sid="EXO 27:8" />ಯೊ ಚಾ಼ಚ಼ರ್‌ನ ಪಲ್ಗಾವ್‌ಥಿ ಪೋಲ ಪಿಟಾರನಿಘೊಣಿ ಕರಾವ್ಣು. ಮೇ ಪಹಾಡ್‌ಮ ತುನ ವತಾಳನಿಘೋಣಿಸ್ ಇನ ಕರಾವ್ಣು.<verse eid="EXO 27:8" /></para>
  <para style="s">ಯೆಹೋವನ ಡೇರಾನ ಘರ್‌ನಿ ಝ಼ಗೋನು ಬಲ್ಡೊ</para>
  <para style="r">(<ref loc="EXO 38:9-20">ವಿಮೋ 38:9-20</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 27:9" />ಅಜು಼ ಡೇರಾನ ಘರ್‌ನ ಖ್ಹಾಮ್ಣೆನು ಬಲ್ಡಾನ ಕರಾವ್ಣು. ಯೊ ದಕ್ಷಿಣ್ ಬಾಜು಼ನ ಬಲ್ಡಾನ ಪಡ್ದಾವ್‌ಖ್ಹಾರು ರ‍್ಹೇವ್ಣು. ಯೊ ಪಡ್‌ದಾವ್ನ ಖ್ಹಾಜ಼್‌ಥಿ ಖ್ಹುತ್ತರ್‌ನ ಧಾಗಾನ ಲುಂಗ್ಡಾವ್‌ಥಿ ಕರಾವ್ಣು. ಯೊ ಖ್ಹೊ ಹಾತ್‌ ಲಾಂಬು ಹುಯಿರ‍್ಹೇವ್ಣು. <verse eid="EXO 27:9" /><verse number="10" style="v" sid="EXO 27:10" />ಯೊ ಬಾಜು಼ಮ ವೀಖ್ಹ್‌ ಖಂಬಖ್ಹಾರು. ಇನ ವೀಖ್ಹ್‌ ತಾಂಬಾನು ಹುದಿನೊ ಬಂಡೊಖ್ಹಾರು ರ‍್ಹೇಣು. ಖಂಬಾವ್ನ ರೂಪಾನೊ ಅಖುಟಾವ್‌ಬಿ ರ‍್ಹೇಣು. <verse eid="EXO 27:10" /><verse number="11" style="v" sid="EXO 27:11" />ಯೋಸ್ ಪರಕ್ಮ ಉತ್ತರ್ ಭಣಿಬಿ ಖ್ಹೊ ಹಾತ್ ಲಾಂಬು ರ‍್ಹವಾನು ಪಡ್‌ದೊಖ್ಹಾರು, ವೀಖ್ಹ್‌ ಖಂಬಖ್ಹಾರು, ವೀಖ್ಹ್‌ ತಾಂಬಾನು ಹುದಿನು ಬಂಡೊಖ್ಹಾರು ರ‍್ಹೇವ್ಣು ಖಂಬಾನು ಅಖುಟೊಖ್ಹಾರುಬಿ, ಪಟ್ಟಿಖ್ಹಾರುಬಿ ರೂಪಾನು ಹುಯಿರ‍್ಹೇವ್ಣು. <verse eid="EXO 27:11" /><verse number="12" style="v" sid="EXO 27:12" />ದನ್ ನಿಕ್‌ಳಭಣಿನು ಮಾಳ್‌ನು ಚೌ಼ಡಾಮ ಅಢೈಖ್ಹ್ ಹಾತ್ ಲಾಂಬು ಪಡ್‌ದೊಖ್ಹಾರುಬಿ ದಖ್ಹ್‌ ಖಂಬುಖ್ಹಾರುಬಿ, ದಖ್ಹ್‌ ಹುದಿನೊ ಬಂಡಾವ್‌ಬಿ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 27:12" /><verse number="13" style="v" sid="EXO 27:13" />ಪೂರಬ್‌ಭಣಿಬಿ ಬಲ್ಡಾನು ಚೌ಼ಡು ಅಢೈಖ್ಹ್ ಹಾತ್ ರ‍್ಹೇಣು. <verse eid="EXO 27:13" /><verse number="14" style="v" sid="EXO 27:14" />ಎಕ್ ಬಾಜು಼ಮ ಪಂಧ್ರ ಹಾತ್ ಲಾಂಬು ಪಡ್‌ದೊರ‍್ಹೀನ್ ಯೊ ಖ್ಹಾರನ ತೀನ್ ಖಂಬಾವ್‌ಬಿ, ತೀನ್ ಹುದಿನೊ ಬಂಡಾವ್‌ಬಿ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 27:14" /><verse number="15" style="v" sid="EXO 27:15" />ಅಜೇಕ್ ಬಾಜು಼ಮ ಪಂಧ್ರ ಹಾತ್ ಲಾಂಬುರ‍್ಹವಾನು ಪಡ್‌ದೊ ರ‍್ಹೀನ್ ಯೊ ಖ್ಹಾರನ ತೀನ್ ಖಂಬಾವ್‌ಬಿ, ತೀನ್ ಹುದಿನ ಬಂಡಾವ್‌ಬಿ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 27:15" /><verse number="16" style="v" sid="EXO 27:16" />ಬಲ್ಡಾನ ಬಾಕಲ್‌ಮಾಸ್ ವೀಖ್ಹ್‌ ಹಾತ್ನು ಪಡ್‌ದೊ ರ‍್ಹೇವ್ಣು. ಇನ ಖ್ಹಾಜ಼್‌ಥಿ ಕಾಡಿಹುಯು ವಾಟ್ಯುತೆ ಖ್ಹುತ್ತರ್‌ನೊ ಧಾಗೊ, ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣೊ ರಂಗ್, ಲಲೇಲಾಲ್ ರಂಗ್‌ಥಿ ರ‍್ಹವಾನು ಧಾಗೇಥಿ ವಣ್‌ಖರ್‌ನು ಕಾಮ್‌ಕರವಾಳನ ಹಾತೇಥಿ ಕರಾವ್ಣು. ಬಾಕಲ್‌ನ ಚಾರ್ ಖಂಬಾವ್‌ಬಿ ಚಾರ್ ಹುದಿನೊ ಬಂಡಾವ್‌ಖ್ಹಾರು ರ‍್ಹೇವ್ಣು. <verse eid="EXO 27:16" /><verse number="17" style="v" sid="EXO 27:17" />ಮಾಳ್‌ನ ಅಶ್‌ಪಿಶ್‌ನು ಖ್ಹಾರು ಖಂಬಾವ್‌ನಬಿ, ರೂಪಾನಿ ಪಟ್ಟಿಯೆಬಿ, ರೂಪಾನು ಅಖುಟೊಖ್ಹಾರುಬಿ, ತಾಂಬಾನು ಹುದಿನೊ ಬಂಡೊಖ್ಹಾರುಬಿ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 27:17" /><verse number="18" style="v" sid="EXO 27:18" />ಮಾಳ್ ಖ್ಹೊ ಹಾತ್ ಲಾಂಬುಬಿ ಅಶ್‌ಪಿಶ್ ಅಢೈಖ್ಹ್ ಹಾತ್ ಚೌ಼ಡುಬಿ ರ‍್ಹೇಣು. ಇನ ಅಶ್‌ಪಿಶ್‌ನು ಪಡ್‌ದೊ ಖ್ಹಾಜ಼್‌ಥಿ ಕಾಡಿಹುಯು ಖ್ಹುತ್ತರ್‌ನ ಧಾಗಾನ ಲುಂಗ್ಡೇಥಿ ಬಣೈರ‍್ಹಿನ್ ಪಾಚ಼್‌ ಹಾತ್ ಊಚು಼ ರ‍್ಹೇವ್ಣು. ಇನ ತಾಂಬಾನೊ ಹುದಿನೊ ಬಂಡೊ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 27:18" /><verse number="19" style="v" sid="EXO 27:19" />ಘರ್‌ನು ಹರೇಕ್ ಥರಾನ ಕಾಮ್ನು ರಾಛು಼ ಕಾಮ್ನ ಹೋಣುತೆ ಜಿನಖ್ಹ್‌ಖ್ಹಾರುಬಿ, ಡೇರಾನು ಘರ್‌ನು ಖಿಲ್ಲಾವ್‌ಬಿ, ಮಾಳ್‌ನು ಮರೆಲಾವ್ನ ಖಿಲ್ಲಾ ಖ್ಹಾರುಬಿ ತಾಂಬಾನು ಹುಯಿರ‍್ಹೇಣು.<verse eid="EXO 27:19" /></para>
  <para style="s">ದೀವಾನ ಲಗಾಡಾನಿ ಸೇವೆ</para>
  <para style="r">(<ref loc="LEV 24:1-4">ಯಾಜಕ 24:1-4</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 27:20" />ದೀವೊ ಕೆದೇಬಿ ಲಾಗುಕರನಿತರ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಒಲಿವ್ ಝಾ಼ಡಾನು ಪಂಡಾವ್ನ ಚ಼ಗ್‌ದಿನ್ ಶುದ್‌ಥಿ ರ‍್ಹವಾನು ಒಲಿವ್ ತೇಲ್ನ ಲೀನ್ ಆವನಿತರ ಇವ್ಣುನ ಹುಕುಮ್‌ ದೇವ್ಣು. <verse eid="EXO 27:20" /><verse number="21" style="v" sid="EXO 27:21" />ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾಮ ಹುಕುಮ್‌ನ ಬಂಡಾನು ಪಲ್ಗಾವ್ನ ಪಿಟಾರನ ಖ್ಹಾಮ್ಣೆನು ಪಡ್ದಾನ ಫಾದರ್ ಆರೋನಬಿ, ಇನ ಲಡ್ಕಾವ್‌ಬಿ ಖ್ಹಾಂಜ಼್‌ಥು ಧರಿನ್ ವ್ಹಾಣಲಗು ಯೆಹೋವನ ಖ್ಹಾಮ್ಣೆ ಯೊ ದೀವೊ ಲಾಗುಕರನಿಘೋಣಿ ಬರೋಬರ್ ಕರುಕರ‍್ನು. ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಇನಿ ಪಿಳ್ಗಿವಾಳು ಆ ನಿಯಮ್ನ ಮುಂಡಿನ್ ಮುಂಡಿಯೆಬಿ ಹಮೇಶಾಥಿ ಪಾಡಿಚಾ಼ಲ್ನು. ಯೊ ಇವ್ಣುನ ನಿಯಮ್‌ ಹುಯಿರ‍್ಹೇಣು.<verse eid="EXO 27:21" /></para>
  <chapter eid="EXO 27" />
  <chapter number="28" style="c" sid="EXO 28" />
  <para style="s">ಯಾಜಕರ‍್ನು ಪೆರ್ವಾಖ್ಹ್‌ಖ್ಹಾರು</para>
  <para style="r">(<ref loc="EXO 39:1-7">ವಿಮೋ 39:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 28:1" />ಮನ ಯಾಜಕನು ಸೇವೆ ಕರಾನ ತೂ ತಾರ ಮೋಟೊ ಭೈ ಆರೋನಾನಬಿ, ಇನೊ ಛಿಯ್ಯಾವ್ ಹುಯಿರ‍್ಹಾತೆ ನಾದಾಬ್, ಅಬೀಹೂ, ಎಲ್ಲಾಜಾರ್, ಈತಾಮಾರ್ ಕರಿ ಬೋಲವಾಳನಬಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳಥಿ ತಾರ ಖನ್ನೆ ಬುಲೈಲಿನ್ ಆವ್. <verse eid="EXO 28:1" /><verse number="2" style="v" sid="EXO 28:2" />ತಾರೊ ಮೋಟೊ ಭೈ ಆರೋನನ ಮರ‍್ಯಾದಿಬಿ, ಶನ್‌ಗಾರ್‌ಬಿ ಹುವಾನಿತರ ಇನ ಪರಿಶುದ್ ಪೇರ್ವಾಖ್ಹ್‌ನ ಕರಾವ್ಣು. <verse eid="EXO 28:2" /><verse number="3" style="v" sid="EXO 28:3" />ಕಿನ ಮೇ ಅಕ್ಕಲ್‌ನಿ ವರಾನ ಭರ್‌ಪೂರ್‌ಥಿ ದೀರಾಖ್ಯೊಸ್ಕಿ ಎಥ್ರಾನ ಅಕ್ಲಿಯೆವ್‌ನ ಜೋ಼ಡ್ಮ ತೂ ವಾತೆಬೋಲಿನ್ ಇವ್ಣ ಹಾತೇಖ್ಹು ಯೊ ಪೆರ್ವಾಖ್ಹ್‌ನ ತಯಾರ್ ಕರ‍್ನು. ಆರೋನ ಯೊ ಅಖ್ಖಾನ ಫೇರಿನ್ ಮಾರೊ ಯಾಜಕ ಹುವಾನ ಪರಿಶುದ್ ಉಷೆ. <verse eid="EXO 28:3" /><verse number="4" style="v" sid="EXO 28:4" />ಇವ್ಣೆ ಕರ‍್ನುತೆ ಪೆರ್ವಾಖ್ಹ್‌ಖ್ಹಾರು ಖಿವುಖಿವುಕತೊ; ಛಾ಼ತಿನು ಕವಚ್, ಮಹಾಯಾಜಕ್‌ನು ಏಫೋದ್, ಝ಼ಗ್ಗೊ, ವಣ್‌ಖರ್‌ಥಿ ಬಣಾಯುಹುಯು ಉಪ್ಪರ್‌ಲ್ಯು ಕುಡ್‌ತು, ರುಂಬಾಲ್ ಅಜು಼ ಕಂಬರ್‌ಪಟೊ ಆಸ್. ತಾರೊ ಭೈಹುಯಿರ‍್ಹೊತೆ ಆರೋನಬಿ ಇನ ಛಿಯ್ಯಾವ್‌ಬಿ ಮಾರ ಯಾಜಕ ಹುವಾನ ಇವ್ಣಖ್ಹಾಜೆ ಆ ಪರಿಶುದ್ ಪೆರ್ವಾಖ್ಹ್‌ನ ಕರಾವ್ಣು. <verse eid="EXO 28:4" /><verse number="5" style="v" sid="EXO 28:5" />ಅದ್ಮಿಖ್ಹಾರು ಕಾಣ್ಕೆ ದ್ಯವಾನ ಖ್ಹೊನ್ನಾನ, ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣು ರಂಗ್‌, ಲಲೇಲಾಲ್ ರಂಗ್‌ಥಿ ರ‍್ಹವಾನ ಧಾಗಾನ, ಅಜು಼ ಕೋರು ಲುಂಗ್ಡು ಯೊ ಕಾಮ್ನಖ್ಹಾಜೆ ಉಪಯೋಗ್ ಕರ‍್ನು. <verse eid="EXO 28:5" /><verse number="6" style="v" sid="EXO 28:6" />ಏಫೋದ್‌ಕರಿ ಕವಚ್‌ನ ಖ್ಹಾಜ್‌ಥಿ ಬಣಾಯಹುಯ ಖ್ಹುತ್ತರ್‌ನ ಧಾಗೇಥಿ ಕರೈನ್ ಇನ ಖ್ಹೊನ್ನು, ನೀಲಿ, ರಾಯಿಜಾ಼ಮಣ್ಣ ರಂಗ್‌ನು ಅಜು಼ ಲಲೇಲಾಲ್ ರಂಗ್‌ನ ಧಾಗೇಥಿಬಿ ವಣ್‌ಖರ್ ನಖೈನ್ ಶನ್‌ಗಾರ್ ಕರ‍್ನು. <verse eid="EXO 28:6" /><verse number="7" style="v" sid="EXO 28:7" />ಯೊ ಕವಚ್‌ನ ಭುಜ಼್‌ಪರ್ ಬೇ ಪಟ್ಟಿಯೆ ರ‍್ಹೇವ್ಣು. ಇನು ಭೇ ನೋಕ್‌ಖ್ಹಾರು ಜೋಡ್‌ಶೈ ರ‍್ಹೇಣು. <verse eid="EXO 28:7" /><verse number="8" style="v" sid="EXO 28:8" />ಕವಚ್‌ನ ಉಪ್ಪರ್ ರ‍್ಹವಾನು ವಣ್‌ಖರ್‌ನ ಕಾಮ್ನು ಕಂಬರ್‌ಪಟೊ ಏಕ್‌ಹುಯಿರ‍್ಹಿನ್ ಇಮ್ನಿಪರಕ್‌ಮಾಸ್ ಖ್ಹಾಜ್‌ಥಿ ಬಣಾಯಹುಯ ಖ್ಹುತ್ತರ್‌ನ ಧಾಗೇಥಿ ಕರೈರ‍್ಹಿನ್ ಖ್ಹೊನ್ನಾನ ಧಾಗೇಥಿಬಿ ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣೊ ರಂಗ್, ಲಲೇಲಾಲ್ ರಂಗ್‌ನ ಧಾಗೇಥಿಬಿ ಶನ್‌ಗಾರ್ ಹುಯಿರ‍್ಹೇಣು. <verse eid="EXO 28:8" /><verse number="9" style="v" sid="EXO 28:9" />ಅಜು಼ ತೂ ಬೇ ಗೋಮೇಧಕ(ಸುಲೈಮಣಿ) ಮೋಲ್ನ ಹೀರಾವ್ನ ಲೀನ್ ಯೊ ಖ್ಹಾರಾಮ ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಖೂಮ್‌ನ ನಾಮ್ನ ಟಕಾವ್ಣು. <verse eid="EXO 28:9" /><verse number="10" style="v" sid="EXO 28:10" />ಎಕ್ ಹೀರಾಮ ಛೊ಼ ನಾಮ್‌ನಾಬಿ ಅಜೇಕ್ ಹೀರಾಮ ಉಭ್‌ರ‍್ಯುತೆ ಛೊ಼ ನಾಮ್ನ ಇವ್ಣ ಇವ್ಣ ಪೈದಾಖ್ಹ್‌ನಿ ಪರಕ್ಮ ಟಕಾವ್ಣು. <verse eid="EXO 28:10" /><verse number="11" style="v" sid="EXO 28:11" />ಮುದ್ರಾವ್ನ ಹೀರಾನ ಟಕಾವನಿ ಘೋಣಿ ಯೊ ಕೆತ್ತವಾಳೇಥಿ ಭೇ ಹೀರಾವ್‌ಮ ಇಸ್ರಾಯೇಲ್‌ನು ಖೂಮ್‌ವಾಳನು ನಾಮ್ನ ಟಕೈನ್, ಖ್ಹೊನ್ನಾನ ಯೊ ಮುದ್ರಾವ್‌ಪರ್ ಬೆಖ್ಹಾಡ್‌ಣು. <verse eid="EXO 28:11" /><verse number="12" style="v" sid="EXO 28:12" />ಯೊ ಭೇ ಹೀರಾವ್ನ ಭುಜ಼್‌ನ ಉಪ್ಪರ್‌ಲಿ ಏಫೋದ್‌ನು ಪಟ್ಟಿಮ ಘಲಾವ್ಣು. ಯೊಅಖ್ಖು ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಯಾದ್ನಖ್ಹಾಜೆನು ಹೀರಾವ್‌ ಹುಯಿರ‍್ಹಿಷೆ. ಆರೋನ ಯೆಹೋವನ ಖ್ಹಾಮ್ಣೆಮ ಜಾ಼ವನಿ ಖ್ಹಾರಿವಖ್ಹತ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಖೂಮ್‌ನು ನಾಮ್‌ಖ್ಹಾರನ ಇನ ಯಾದ್ ಲ್ಯವಾನಖ್ಹಾಜೆ ಇನು ಭೇ ಭುಜ಼್‌ಪರ್ ಯೋಅಖ್ಖಾನ ಫೇರಿಲಿನ್ ಜಾಷೆ. <verse eid="EXO 28:12" /><verse number="13" style="v" sid="EXO 28:13" />ಯೊ ಹೀರಾವ್ನ ಜೋ಼ಡ್‌ಶಾವನ ಖ್ಹೊನ್ನಾನ ಛೇಡಾನ ವಣಿನ್ ಖಾನಾವ್‌ನ ಕರಾವ್ಣು. <verse eid="EXO 28:13" /><verse number="14" style="v" sid="EXO 28:14" />ಅಜು಼ ವಣಾನ ಕಾಮ್‍ಥಿ ಡೋರಿನುಘೋಣಿನು ಬೇ ಅಫುಟ್ ಖ್ಹೊನ್ನಾನಿ ಖ್ಹಾಕ್‌ಳಿಯೆವ್ನ ಕರೈನ್ ಹೀರಾವ್ನ ಖಾನಾವ್‌ನ ಅಟ್‌ಕಾವ್ಣು.<verse eid="EXO 28:14" /></para>
  <para style="s">ಛಾ಼ತಿನು ಕವಚ್</para>
  <para style="r">(<ref loc="EXO 39:8-21">ವಿಮೋ 39:8-21</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 28:15" />ದೇವ್ನಿ ತೀರ್ಮಾನ್ನು ಛಾ಼ತಿನು ಕವಚ್‌ನ ವಣ್‌ಖರ್‌ನ ಕಾಮ್‍ಥಿ ಕರಾವ್ಣು. ಇನ ಏಫೋದ್‌ನ ಕರಾಯುತೆ ತಿಮ್ಮಸ್ ಖ್ಹೊನ್ನಾನ ಧಾಗೇಥಿಬಿ ನೀಲಿ, ರಾಯಿಜಾ಼ಮಣ್ಣೊ ರಂಗ್, ಲಲೇಲಾಲ್ ರಂಗ್‌ರ‍್ಹವಾನು ಧಾಗೇಥಿಬಿ ಖ್ಹಾಜ಼್‌ಥಿ ಬಣಾಯಹುಯ ಖ್ಹುತ್ತರ್‌ನ ಧಾಗೇಥಿ ಕರಾವ್ಣು. <verse eid="EXO 28:15" /><verse number="16" style="v" sid="EXO 28:16" />ಯೊ ಎಕ್ ಬಿಲೇಶ್‌ ಲಾಂಬುಬಿ ಅಜು಼ ಎಕ್ ಬಿಲೇಶ್‌ ಚೌ಼ಡುರ‍್ಹೀನ್ ಬೇ ಪದರ್‌ಹುಯಿನ್ ಚಾರ್‌ಖೂಟಿ ಹುಯಿರ‍್ಹೇವ್ಣು. <verse eid="EXO 28:16" /><verse number="17" style="v" sid="EXO 28:17" />ಇನ ಖ್ಹಾಮೇನಿ ಬಾಜು಼ಮ ಚಾರ್‌ಶಾಲ್‌ ಹೀರಾವ್ನ ಲಗಾಡಿರಾಕ್‌ಣು. ಪಹಿಲಿ ಶಾಲ್ಮ ಮಾಣಿಕ್ಯ, ಪುಷ್ಯರಾಗ ಐರೊಖ್ಹಾರು ರ‍್ಹೇವ್ಣು. <verse eid="EXO 28:17" /><verse number="18" style="v" sid="EXO 28:18" />ಬೇನ ಶಾಲ್ಮ ಪಚ್ಚೆ, ನೀಲಿಮಣ್‌ಕೊ ಅಜು಼ ವಜ್ರಖ್ಹಾರು ರ‍್ಹೇಣು. <verse eid="EXO 28:18" /><verse number="19" style="v" sid="EXO 28:19" />ತೀನ್ನೆ ಶಾಲ್ಮ ಖ್ಹೊನ್ನಾನೊ ಹೀರೊ, ಸುಗಂಧಿ ಅಜು಼ ಪದ್ಮರಾಗ್‌ಖ್ಹಾರು ರ‍್ಹೇವ್ಣು. <verse eid="EXO 28:19" /><verse number="20" style="v" sid="EXO 28:20" />ಚಾರ‍್ನಿ ಶಾಲ್ಮ ಗೋಮೇಧಕ, ಬೆರುಲ್ಲ, ವೈಢೂರ್ಯವ್‌ನಬಿ ಖ್ಹೊನ್ನಾನ ಮಣ್ಕಾವ್‌ಮ ಮಳಾವ್ಣು. <verse eid="EXO 28:20" /><verse number="21" style="v" sid="EXO 28:21" />ಇಸ್ರಾಯೇಲ್‌ವಾಳಾನ ಖೂಮ್ಮ ಗಣ್ತೀನಿ ಪರಕ್‌ನಿಘೋಣಿ ಭಾರ ಹೀರಾ ರ‍್ಹೇವ್ಣು. ಮುದ್ರಾವ್ನ ಕೆತ್ತಾನಿ ಪರಕ್ಮ ಏಕೇಕ್‌ ಹೀರಾಮ ಏಕೇಕ್‌ ಖೂಮ್‌ನು ನಾಮ್ನ ಟಕಾವ್ಣು. <verse eid="EXO 28:21" /><verse number="22" style="v" sid="EXO 28:22" />ಯೋಸ್ ಕಾಹೆತೆ ಯೊ ಪದಕ್ನ ಉಪ್ಲಿ ಬಾಜು಼ಮ ಡೋರಿಯೆನಿ ಘೋಣಿನು ಅಫುಟ್ ಖ್ಹೊನ್ನಾನು ಖ್ಹಾಕ್‌ಳಿಯೆವ್ನ ವಣಾನ ಕಾಮ್‍ಥಿ ಕರೈಮ್ಹೇಲ್ನು. <verse eid="EXO 28:22" /><verse number="23" style="v" sid="EXO 28:23" />ಬೇ ಖ್ಹೊನ್ನಾನಿ ಅಂಗುಠಿಯೆವ್ನ ಕರೈನ್ ಛಾ಼ತಿನ ಪದಕ್ನು ಭೇ ಕೋಣಾವ್‌ನಾಬಿ ಲಗಾಡ್‌ಣು. <verse eid="EXO 28:23" /><verse number="24" style="v" sid="EXO 28:24" />ಯೊ ಭೇ ಖ್ಹಾಕ್‌ಳಿಯೆವ್ನ ಛಾ಼ತಿನ ಪದಕ್ನು ಕೋಣಾಮ ಛಾ಼ತೆ ಕಣ್ಣಿಯೆವ್‌ಮ ಅಟ್‌ಕಾವ್ಣು. <verse eid="EXO 28:24" /><verse number="25" style="v" sid="EXO 28:25" />ಯೊ ಖ್ಹಾಕ್‌ಳಿಯೆವ್ನ ನೋಕ್‌ಅಖ್ಖಾನ ಏಫೋದ್ನ ಕವಚ್‌ನು ಖಾಂದಾನಿ ಪಟ್ಟಿಮಛಾ಼ತೆ ಬೇ ಕಣ್ಣಿಯೆವ್‌ಮ ಅಟ್‌ಕೈನ್ ಖ್ಹಾಮ್ಣೆ ಮ್ಹೇಲಿರಾಕ್ಣು. <verse eid="EXO 28:25" /><verse number="26" style="v" sid="EXO 28:26" />ಆ ಕಾಹೆತೆ ಬೇ ಖ್ಹೊನ್ನಾನು ಕಣ್ಣಿಯೇವ್ನ ಕರೈನ್ ಯಾಜಕ್‌ನ ಛಾ಼ತಿನ ಪದಕ್‌ನ ಮಹಿನು ಕನಾರಿನ ಕೋಣಾವ್‌ಮ ಕವಚ್‌ನ ಖನ್ನೆಸ್‌ ಮ್ಹೇಲಾವ್ಣು. <verse eid="EXO 28:26" /><verse number="27" style="v" sid="EXO 28:27" />ಅಜು಼ ಬಿಜು಼ ಬೇ ಖ್ಹೊನ್ನಾನಿ ಕಣ್ಣಿಯೇವ್ನ ಕರೈನ್ ಏಫೋದ್ ಕವಚ್‌ನು ಭೇ ಖಾಂದಾವ್ನಿ ಪಟ್ಟಿಯೇವ್ನ ಖ್ಹಾಮ್ಣೆನ ಹೇಟ್ ಕವಚ್‌ನ ಜೋಡ್‌ಶೈರಾಖನ ಝ಼ಗೊನಕನ ಶಿವಣ್ ಕರಾಯಹುಯ ಕಷ್‌ಬಂದ್‌ನ ಉಪ್ಲಿ ಬಾಜು಼ಮ ಮ್ಹೇಲಾವ್‌ಣು. <verse eid="EXO 28:27" /><verse number="28" style="v" sid="EXO 28:28" />ಛಾ಼ತಿನು ಪದಕ್‌ ವಣ್‌ಖರ್‌ ನಖಾಯಹುಯ ಕಷ್‌ಬಂದ್‌ನ ಉಪ್ಲಿ ಬಾಜು಼ಮ ಭಂದೈರ‍್ಹವಾನಿಘೊಣಿಬಿ, ಏಫೋದ್ ಕವಚ್‌ಥು ಛು಼ಟಿನಾಪಡ್ನುತೆತಿಮ್‌ ಇನಿ ಕಣ್ಣಿಯೇವ್ನ ಏಫೋದ್ ಕವಚ್‌ನ ಕಣ್ಣಿಯೇವ್ನ ನೀಲಿ ಧಾಗೇಥಿ ಭಂದಾವ್ಣು. <verse eid="EXO 28:28" /><verse number="29" style="v" sid="EXO 28:29" />ನ್ಯಾವ್ನು ತಿರ್ಮಾನ್ನು ಛಾ಼ತಿನ ಪದಕ್‌ನ ಉಪ್ಪರ್ ಇಸ್ರಾಯೇಲ್ನು ಖೂಮ್‌ಖ್ಹಾರನು ನಾಮ್ನಅಖ್ಖು ಲಿಖೈರ‍್ಹುತೆಖ್ಹಾಜೆ ಆರೋನ ಪವಿತ್ರ ಝ಼ಗೋಮ ಜಾ಼ವನಿ ಖ್ಹಾರಿ ವಖ್ಹತ್ ಯೊ ನಾಮ್‌ಅಖ್ಖಾನ ಲಗತ್ತರ್‌ಥಿ ಯೆಹೋವನಿ ಯಾದ್ಮ ಲ್ಯವಾನಖ್ಹಾಜೆ ಇನ ಇನು ಛಾ಼ತಿನ ಉಪ್ಪರ್ ಹಮೇಶಬಿ ಫೇರ್‌ಶೆ. <verse eid="EXO 28:29" /><verse number="30" style="v" sid="EXO 28:30" />ನ್ಯಾವ್‌ನು ತಿರ್ಮಾನ್ನ ಖ್ಹಮ್‌ಜಾ಼ಡನು ಊರೀಮ್ ಅಜು಼ ತುಮ್ಮೀಮ್ ಕರಿ ಜಿನಖ್ಹ್‌ನ ಯೊ ಛಾ಼ತಿನ ಕವಚ್‌ಮ ಘಾಲಿರಾಕ್‌ಣು. ಆರೋನ ಯೆಹೋವನ ಮ್ಹೋರೆ ಜಾ಼ವನಿ ವಖ್ಹ್‌ತೆ ಯೋಅಖ್ಖು ಇನ ಛಾ಼ತಿಪರ್ ರ‍್ಹಿಶೆ. ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಪಾಡಿಚಾ಼ಲ್ನುತೆ ನ್ಯಾವ್ನ ತಿರ್ಮಾನ್ನ ಆರೋನ ಅಮ್ ಇನ ಛಾ಼ತಿನ ಉಪ್ಪರ್ ಯೆಹೋವನ ಮ್ಹೋರೆಮ ಕದೇಬಿ ಫೇರಿರಾಕ್ಣು.<verse eid="EXO 28:30" /></para>
  <para style="s">ಯಾಜಕರ‍್ನು ಬಿಜು಼ಖ್ಹಾರು ಪೆರ್ವಾಖ್ಹ್‌ಅಖ್ಖು</para>
  <para style="r">(<ref loc="EXO 39:22-31">ವಿಮೋ 39:22-31</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 28:31" />ಮಹಾಯಾಜಕ್ ಏಫೋದ್ ಕವಚ್‌ನ ಜೋ಼ಡ್ಮ ಫೇರ‍್ನುತೆ ಕುಡ್‌ತಾನ ತೂ ನೀಲಿ ರಂಗ್‌ನ ಲುಂಗ್ಡೇಥಿಸ್ ಕರಾವ್ಣು. <verse eid="EXO 28:31" /><verse number="32" style="v" sid="EXO 28:32" />ಮುಡ್‌ಕ್ಯು ಘಾಲನಖ್ಹಾಜೆ ಇನಾಮ ಖೀಂಡ್ ರ‍್ಹೇವ್ಣು. ಯೊ ಫಾಟ್ಣುನಾತೆ ತಿಮ್ ಯೊ ಖೀಂಡ್‌ನು ಗಿರ್ಕಿನ ಇನಜೋ಼ಡೆ ಎಕ್ ಪಟ್ಟಿನ ಶಿವಾಡ್‌ಣು. <verse eid="EXO 28:32" /><verse number="33" style="v" sid="EXO 28:33" />ಝ಼ಗ್ಗಾನು ಕನಾರಿನ ಅಶ್‌ಪಿಶ್‌ಬಿ ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣು ರಂಗ್, ಲಲೇಲಾಲ್ ರಂಗ್‌ಥಿ ರ‍್ಹವಾನ ಧಾಗೇಥಿ ಢಾಡಮ್‌ನ ಪಂಡಾವ್‌ನಿ ಘೋಣಿನು ಚಂಡುಲ್‌ನಬಿ ಯೊ ಅಖ್ಖಾನ ಬೀಚ್ಮ ಖ್ಹೊನ್ನಾನ ಘುಗ್‌ರಾವ್‌ನಾಬಿ ಘಲಾವ್‌ಣು. <verse eid="EXO 28:33" /><verse number="34" style="v" sid="EXO 28:34" />ಖ್ಹೊನ್ನಾನು ಘುಗ್ರೊಬಿ ಢಾಡಮ್‌ನಾಬಿ ಎಕ್ ಹುಯಿಜಾ಼ವದಿನ್ ಎಕ್ ಯೊ ಝ಼ಗ್ಗಾನ ಕನಾರಿನ ಅಶ್‌ಪಿಶ್‌ಬಿ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 28:34" /><verse number="35" style="v" sid="EXO 28:35" />ಆರೋನ ಯಾಜಕ್‌ನು ಸೇವೆ ಕರಾನಿ ವಖ್ಹತ್‌ಮ ಇನ ಫೇರ್‌ನು. ಯೊ ಯೆಹೋವನ ಮ್ಹೋರೆ ಪವಿತ್ರಝ಼ಗೋಮ ಜಾ಼ವನಿ ವಖ್ಹ್‌ತೆಬಿ ಆವನಿ ವಖ್ಹ್‌ತೆಬಿ ನಾ ಮರ‍್ನುತೆಖ್ಹಾಜೆ ಯೊ ಘುಗ್‌ರಾವ್‌ನ ಅವಾಜ಼್‌ ಖ್ಹಮಜ಼್‌ಪಡ್ಣು. <verse eid="EXO 28:35" /><verse number="36" style="v" sid="EXO 28:36" />ಅಫುಟ್‌ ಖ್ಹೊನ್ನೇಥಿ ಎಕ್ ಪಟ್ಟಿನ ಕರೈನ್ ಮುದ್ರಾನ ಟಕಾವನಿ ಪರಕ್ಮ ಇನಪರ್ “ಯೆಹೋವನಖ್ಹಾಜೆ” ಕರಿ ಲೀಖ್ಯಾನ ಟಕಾವ್ಣು. <verse eid="EXO 28:36" /><verse number="37" style="v" sid="EXO 28:37" />ಇನ ರುಂಬಾಲ್ನ ಭಾಂದನಖ್ಹಾಜೆ ನೀಲ ಧಾಗಾನ ಇನ ಭಂದಾವ್ಣು. ಯೊ ರುಂಬಾಲ್ನ ಖ್ಹಾಮ್ಣೇನಿ ಬಾಜು಼ ರ‍್ಹೇವ್ಣು. <verse eid="EXO 28:37" /><verse number="38" style="v" sid="EXO 28:38" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಕಾಣ್ಕೆ ದ್ಯವಾನು ದೇವ್ನ ಅಖ್ಖಾಸ್ ಪರಿಶುದ್ ಜಿನಖ್ಹ್‌ನಿ ಬಾರೇಮ ಖೋಟ್ ಕಾಯ್‌ತೊಬಿ ರ‍್ಹಯೂತೊ ಆರೋನ ಯೊ ಪಟ್ಟಾನ ಕೆದೇಬಿ ತಾಳ್ವಪರ್ ಘಾಲಿನ್ ಯೊ ದೋಷ್‌ನು ಫಲ್ನ ಪಾಡಿಲವಾಥಿ ಇವ್ಣೆ ಯೆಹೋವನ ಪಸಂದ್‌ವಾಳ ಹುಯಿರ‍್ಹಿಷೆ. <verse eid="EXO 28:38" /><verse number="39" style="v" sid="EXO 28:39" />ಆರೋನ ಫೇರ‍್ನುತೆ ಮಹಿನ ಕುಡ್‌ತಾನ ಖ್ಹುತ್ತರ್‌ನ ಧಾಗೇಥಿ ವಣ್‌ಖರ್ ನಖೈನ್ ಶಿವಾಡ್‌ಣು. ಇನ ರುಂಬಾಲ್ನ ಖ್ಹುತ್ತರ್‌ನ ಧಾಗೇಥಿ ಕರಾವ್ಣು. ಇನ ಕಷ್‌ಬಂದ್‌ನ ವಣ್‌ಖರ್‌ನ ಕಾಮ್‍ಥಿ ಕರಾವ್ಣು. <verse eid="EXO 28:39" /><verse number="40" style="v" sid="EXO 28:40" />ಆರೋನ್ನ ಛಿಯ್ಯಾವ್ನ ಬರೋಬರ್‌ನಿ ಮರ‍್ಯಾದಿಬಿ, ಶನ್‌ಗಾರ್‌ಬಿ ಹುವಾನಿಘೋಣಿ ಇವ್ಣುನ ಝ಼ಗ್ಗಾವ್‌ನಬಿ, ಕಂಬರ್‌ಪಟಾವ್‌ನಬಿ ಅಜು಼ ಕರಾವ್ಣು. <verse eid="EXO 28:40" /><verse number="41" style="v" sid="EXO 28:41" />ಇವ್ಣೆ ಮನ ಯಾಜಕನು ಸೇವೆ ಕರಾನಖ್ಹಾಜೆ ಯೊ ಪೆರ್ವಾಖ್ಹ್‌ನ ತಾರೊ ಭೈ ಆರೋನ್ನಬಿ, ಇನ ಛಿಯ್ಯನಾಬಿ ಫೇರೈನ್, ಇವ್ಣುನ ಅಬಿಷೇಕ್ ಕರಿನ್, ಸೇವೆನಖ್ಹಾಜೆ ನೇಮಕ್‌ಕರಿನ್ ಶುದ್‍ ಕರ‍್ನು. <verse eid="EXO 28:41" /><verse number="42" style="v" sid="EXO 28:42" />ಆ ನಾಹುಯಿನ್ ಇವ್ಣ ಉಘಾಡು ಆಂಗ್ ನಾ ದೆಖಾವ್ಣುತೆ ತಿಮ್ ಇವ್ಣುನ ಕಂಬರ್‌ಥು ಧರಿನ್ ಟಾಂಗ್‌ಲಗು ರ‍್ಹವಾನು ಚಡ್ಡಿಯೆವ್ನ ಖ್ಹುತ್ತರ್‌ಥಿ ಕರಾವ್ಣು. <verse eid="EXO 28:42" /><verse number="43" style="v" sid="EXO 28:43" />ಆರೋನಬಿ, ಇನ ಛಿಯ್ಯವ್‌ಬಿ ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾನ ಘರ್‌ಮ ಜಾ಼ವನಿ ವಖ್ಹ್‌ತೆಬಿ, ಪವಿತ್ರ ಝ಼ಗೋಮ ಸೇವೆ ಕರಾನ ಚಾ಼ಚ಼ರ್‌ಕನ ಆವನಿವಖ್ಹತೆಬಿ ಆಖ್ಹಾರನ ಫೇರಿರಾಕ್ಣು. ನಾರ‍್ಹಿಯುತೊ ಇವ್ಣೆ ಯೊ ಗಲತ್‌ನಖ್ಹಾಜೆ ಮರಿಜಾ಼ಷೆ. ಇನಾಬಿ ಇನ ಖಾನ್‌ದಾನ್‌ವಾಳನಬಿ ಆ ಹೈರುತೆ ಹಮೇಶಾನಿ ನಿಯಮ್ ಹುಯಿರ‍್ಹಿಸ್.<verse eid="EXO 28:43" /></para>
  <chapter eid="EXO 28" />
  <chapter number="29" style="c" sid="EXO 29" />
  <para style="s">ಆರೋನ ಅಜು಼ ಇನ ಛಿಯ್ಯವ್ನು ಯಾಜಕ್‌ನಿ ನೇಮಕ್‌.</para>
  <para style="r">(<ref loc="LEV 8:1-36">ಯಾಜಕ 8:1-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 29:1" />ಇವ್ಣೆ ಮನ ಯಾಜಕ ಹುವಾನಿತರ ಇವ್ಣುನ ನೇಮಕ್‌ಕರಾನ ತೂ ಕರ‍್ನುತೆ ಕಾಮ್‌ಶಾತ್‌ಕತೊ; ಎಕ್ ಕೆಲ್ಡಾನ ಅಜು಼ ಶನು ದೋಷ್‌ಕೊಂತೆ ಬೇ ಮೇಂಢಾವ್ನಬಿ ಲೇವ್ಣು. <verse eid="EXO 29:1" /><verse number="2" style="v" sid="EXO 29:2" />ಅಜು಼ ಖಾಟುಕೊಂತೆ ರೋಟಾವ್ನಬಿ, ತೇಲ್ ಮಿಲಾವಟ್‌ನು ಖಾಟುಕೊಂತೆ ಖ್ಹವಾಳಿನ, ತೇಲ್ ಲಗಾಡಿಹುಯು ಖಾಟುಕೊಂತೆ ಕಡುಬುಖ್ಹಾರುಬಿ, <verse eid="EXO 29:2" /><verse number="3" style="v" sid="EXO 29:3" />ಘವ್‌ನ ಆಟೇಖ್ಹು ಕರೈನ್ ಎಕ್ಕಸ್ ಟೋಕ್ರಿಮ ಭರಾವ್ಣು. ಇನವಾರ್ ಯೊ ಟೋಕ್ರಿನ, ಕೆಲ್ಡಾನ ಅಜು಼ ಬೇ ಮೇಂಢಾವ್ನಿ ಜೋ಼ಡ್ಮ ಲ್ಯಾವ್ಣು. <verse eid="EXO 29:3" /><verse number="4" style="v" sid="EXO 29:4" />ತದೆ ಆರೋನನಾಬಿ ಅಜು಼ ಇನ ಛಿಯ್ಯನಬಿ ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾನ ಘರ್‌ನ ಬಾಕಲ್‍ಕನ ಬುಲೈಲಿನ್ ಅಯಿನ್ ನೊಹಾಡ್ಣು. <verse eid="EXO 29:4" /><verse number="5" style="v" sid="EXO 29:5" />ಯೊ ಪೆರ್ವಾಖ್ಹ್‌ನ ಕತೊ ಮಹಿನ ಝ಼ಗ್ಗಾನ, ಏಫೋದ್ ಕವಚ್‌ನ ಜೋ಼ಡೆ ಫೇರಾನ ಝ಼ಗ್ಗಾನಬಿ, ಏಫೋದ್ ಕವಚ್‌ಬಿ ಛಾ಼ತಿನ ಪದಕ್‌ನಾಬಿ ಆರೋನ್ನ ಫೇರೈನ್ ಏಫೋದ್ ಕವಚ್‌ನು ವಣ್‌ಖರ್ ನಾಖ್ಯಹುಯ ಕಷ್‌ಬಂದ್‌ನ ಭಂದೈನ್, <verse eid="EXO 29:5" /><verse number="6" style="v" sid="EXO 29:6" />ಇನ ಮಾಥಪರ್ ರುಂಬಾಲ್ನ ಘಲೈನ್, ರುಂಬಾಲ್‌ಪರ್ ದೇವ್ನಖ್ಹಾಜೆ ರ‍್ಹೇವ್ಣುತೆ ಪವಿತ್ರ ಪಟ್ಟಿನ ಭಂದೈನ್, <verse eid="EXO 29:6" /><verse number="7" style="v" sid="EXO 29:7" />ಅಬಿಷೇಕ್‌ನ ತೇಲ್ನ ಇನಪರ್ ರಂಚಿನ್ ಇನ ಅಬಿಷೇಕ್‌ಕರ‍್ನು. <verse eid="EXO 29:7" /><verse number="8" style="v" sid="EXO 29:8" />ಇನವಾರ್ ಇನ ಛಿಯ್ಯಾವ್ನ ಖನ್ನೆ ಬುಲೈನ್, ಇವ್ಣುನ ಉಪ್‌ಲ್ಯ ಝ಼ಗ್ಗಾವ್ನ ಫೇರೈನ್, <verse eid="EXO 29:8" /><verse number="9" style="v" sid="EXO 29:9" />ಆರೋನ್ನಬಿ ಇನ ಛಿಯ್ಯಾವ್‌ನಬಿ ಕಷ್‌ಭಂದ್‌ನ ಭಂದೈನ್ ರುಂಬಾಲೆನ ಲಪೇಟ್‌ಣು. ತಪ್‌ಥು ಯಾಜಕಸೇವೆ ಇವ್ಣುನ ಹಮೇಶಾನು ಹಕ್ ಹುಯಿರ‍್ಹಿಷೆ. ಅಮ್ ಆರೋನಬಿ ಇನ ಛಿಯ್ಯಾವ್‌ಬಿ ಯಾಜಕ್ ಸೇವೆನ ನೇಮಕ್ ಹುಯಿರ‍್ಹಿಷೆ. <verse eid="EXO 29:9" /><verse number="10" style="v" sid="EXO 29:10" />ಇನವಾರ್ ತೂ ಯೊ ಕೆಲ್ಡಾನ ದೇವ್ನದರ್ಶನ್ನ ಡೇರಾನ ಘರ್‌ನ ಮ್ಹೋರೆ ಲಯಿನ್, ಆರೋನಬಿ ಇನ ಛಿಯ್ಯಾವ್‌ಬಿ ಇನ ಮುಡ್‌ಕ್ಯಪರ್ ಇವ್ಣ ಹಾತ್ನ ಮ್ಹೇಲ್ನು. <verse eid="EXO 29:10" /><verse number="11" style="v" sid="EXO 29:11" />ಇನವಾರ್ ತೂ ಕೆಲ್ಡಾನ ಯೆಹೋವನ ಖ್ಹಾಮೆ ದೇವ್ನದರ್ಶನ್ನ ಡೇರಾನ ಘರ್‌ನ ಬಾಕಲ್‌ಕನಸ್ ಬಲಿಕರ‍್ನು. <verse eid="EXO 29:11" /><verse number="12" style="v" sid="EXO 29:12" />ಯೊ ಕೆಲ್ಡಾನ ಲ್ಹೋಯಿಮ ದರಾಖ್ಹು ಲೀನ್ ಅಂಗ್ಳಿಥಿ ಚಾ಼ಚ಼ರ್‌ನ ಶಿಂಗ್‌ಡಾವ್ನ ಲೋಥಿನ್ ಉಭ್‌ರ‍್ಯ ಹುಯ ಲ್ಹೋಯಿನ ಚಾ಼ಚ಼ರ್‌ನ ಬಡ್ಡೇಮ ರಂಚ಼್‌ಣು. <verse eid="EXO 29:12" /><verse number="13" style="v" sid="EXO 29:13" />ಇನು ಕಾಳ್‌ಜನ ಉಪ್ಲಿ ಬಿಶ್ಶಾವ್ನಬಿ ಬೇ ಬುಕ್ಕಿಯೆನಬಿ ಇನಿ ಉಪ್ಪರ್‌ಲಿ ಬಿಶ್ಶಾವ್ನಬಿ ಲೀನ್ ಚಾ಼ಚರ್‌ಪರ್ ಬಲಿ ಛ಼ಡಾವ್‌ಣು. <verse eid="EXO 29:13" /><verse number="14" style="v" sid="EXO 29:14" />ಕೆಲ್ಡಾನು ಬೋಟಿನಬಿ, ಚಾ಼ಂಬ್‌ಡನಬಿ ಅಜು಼ ಅತಲ್ಡಿನ ಇಟಾರಮ್ನ ಭಾರ್‌ ಆಗ್‌ಥಿ ಬಾಳಿನಾಕ್ಣು. ಶನಕತೊ ಆ ಪಾಪ್ನ ಪರಿಹಾರ‍್ನು ಬಲಿ. <verse eid="EXO 29:14" /><verse number="15" style="v" sid="EXO 29:15" />ಇನವಾರ್ ತೂ ಯೊ ಮೇಂಢಾವ್‌ಮಥು ಏಕ್‌ನ ಧರಿಲಿನ್ ಆರೋನಬಿ ಇನ ಛಿಯ್ಯಾವ್‌ಬಿ ಇನ ಮುಡ್‌ಕ್ಯಪರ್ ಇವ್ಣ ಹಾತ್ನ ಮ್ಹೇಲ್ನು. <verse eid="EXO 29:15" /><verse number="16" style="v" sid="EXO 29:16" />ತೂ ಮೇಂಢಾನ ರ‍್ಹೇಖ್ಹಿನ್ ಇನು ಲ್ಹೋಯಿನ ಚಾ಼ಚ಼ರ್‌ನು ಚಾರ್ ಬಾಜು಼ಬಿ ಛಿಡಕ್‌ಣು. <verse eid="EXO 29:16" /><verse number="17" style="v" sid="EXO 29:17" />ಇನಪಾರ್ ತೂ ಯೊ ಮೇಂಢಾನ ಟುಕ್‌ಡ ಟುಕ್‌ಡಕರಿ ಕತ್ರಿನ್ ಇನಿ ಅತಲ್‌ಡಿಯೆವ್‌ನಾಬಿ, ಗೋಡಾವ್‌ನಾಬಿ ಧೊಯಿನ್ ಇನ ಟುಕ್‌ಡಾವ್ನಾಬಿ, ಮುಡ್‌ಕ್ಯನಾಬಿ ಎಕ್ಟು ಮ್ಹೇಲ್ನು. <verse eid="EXO 29:17" /><verse number="18" style="v" sid="EXO 29:18" />ಯೋಅಖ್ಖಯೇಕ್‌ ಮೇಂಢಾನ ಚಾ಼ಚ಼ರ್‌ನಪರ್ ಯೆಹೋವನಖ್ಹಾಜೆ ಭುಂಜಿನ್ ಬಲಿಕರಿನ್ ಸಮರ್ಪಣ್‌ ಕರ‍್ನು. ಆ ಯೆಹೋವನ ಖ್ಹೊಡ್‌ಮೈವಾನು ಢಪ್ಕಾರ್ ಹುಯಿರ‍್ಹುಸ್. <verse eid="EXO 29:18" /><verse number="19" style="v" sid="EXO 29:19" />ಇನವಾರ್ ತೂ ಬೇನ ಮೇಂಢಾನ ಧರಿಲಿನ್ ಆರೋನಬಿ ಇನ ಛಿಯ್ಯಾವ್‌ಬಿ ಇನ ಮುಡ್‌ಕ್ಯಪರ್ ಇವ್ಣ ಹಾತ್ನ ಮ್ಹೇಲ್ನು. <verse eid="EXO 29:19" /><verse number="20" style="v" sid="EXO 29:20" />ಇನಕೇಡೆಥು ಮೇಂಢಾನ ಬಲಿಕರಿನ್ ಯೊ ಲ್ಹೋಯಿಮ ದರಾಖ್ಹನ ಆರೋನ್ನು ಅಜು಼ ಇನ ಛಿಯ್ಯಾವ್‍ನ ಖಾವಕಾನ್ನಿ ನೋಕ್‌ನಾಬಿ ಖಾವಹಾತ್ನಿ ಅಂಗುಠನಬಿ, ಖಾವಗೋಡಾನ ಅಂಗುಠನಬಿ ಲಗಾಡಿನ್, ಉಭ್‌ರಸ್ತೆ ಲ್ಹೋಯಿನ ಚಾ಼ಚ಼ರ್‌ನ ಅಶ್‌ಪಿಶ್ ಛಿಡಕ್‌ಣು. <verse eid="EXO 29:20" /><verse number="21" style="v" sid="EXO 29:21" />ಆನಾಹುಯಿನ್ ತೂ ಚಾ಼ಚ಼ರ್‌ನ ಉಪ್ಪರ್‌ನು ಲ್ಹೋಯ್‌ಮಬಿ, ಅಭಿಷೇಕ್‌ನ ತೇಲ್‌ಮಾಬಿ ದರಾಖ್ಹನ ಲೀಲಿನ್‌ ಆರೋನ್ನು ಅಜು಼ ಇನ ಪೆರ್ವಾಖ್ಹ್‌ಪರ್‌ಬಿ ಇನ ಛಿಯ್ಯಾ ಅಜು಼ ಇವ್ಣ ಪೆರ್ವಾಖ್ಹ್‌ನ ಉಪ್ಪರ್‌ಬಿ ಛಿಡಕ್‌ಣು. ಅಮ್ ಯೋಬಿ ಅಜು಼ ಇನ ಛಿಯ್ಯಾವ್‌ಬಿ ಇವ್ಣ ಪೆರ್ವಾಖ್ಹ್ ಖ್ಹಮೇದ್ ಪರಿಶುದ್ಧ್ ಉಷೆ. <verse eid="EXO 29:21" /><verse number="22" style="v" sid="EXO 29:22" />ಪಟ್ಟಾಭಿಷೇಕ್‌ನ ಖ್ಹಾಜೆ ಸಮರ್ಪಣ್‌ ಕರ‍್ಯುಹುಯೊ ಮೇಂಢೊ ಹುಯಿರ‍್ಹೊತೆಖ್ಹಾಜೆ ಇನು ಬಿಶ್ಶಅಖ್ಖು ಕತೊ ಡೋಂಡಾನಿ ಬಿಶ್ಶಾನಬಿ, ಫೇಪ್ಡಾನ ಉಪ್ಪರ್‌ಲಿ ಬಿಶ್ಶಾನಬಿ, ಬೇ ಬುಕ್ಕಿಯೆನಬಿ ಇನಪರ್‌ಲಿ ಬಿಶ್ಶನಬಿ ಅಜು಼ ಖಾವಿ ಟಾಂಗ್‌ನಬಿ, <verse eid="EXO 29:22" /><verse number="23" style="v" sid="EXO 29:23" />ಅಜು಼ ಯೆಹೋವನ ಮ್ಹೋರೆ ಟೋಕ್ರಿಮ ಮ್ಹೇಲಿರಾಖ್ಯುಥುತೆ ಖಾಟುಕೊಂತೆ ಚೀಜ಼್‌ಖ್ಹಾರಮ ಎಕ್ ರೋಟಾನ, ತೇಲ್ ಮಳಾಯುಹುಯು ಎಕ್ ಖ್ಹವಾಳಿನ ಅಜು಼ ಎಕ್ ಕಡಬುನಬಿ ಪಾಡಿಲಿನ್, <verse eid="EXO 29:23" /><verse number="24" style="v" sid="EXO 29:24" />ಯೋಅಖ್ಖಾನ ಆರೋನ್ನ ಅಜು಼ ಇನ ಛಿಯ್ಯಾವ್‍ನ ಹಾತ್ಮ ದೀನ್ ಯೆಹೋವನ ಖ್ಹಾಮೆ ಅರ್ಪಣ್‌ ಕರ‍್ನು. <verse eid="EXO 29:24" /><verse number="25" style="v" sid="EXO 29:25" />ಇನಪಾರ್ ಯೋಅಖ್ಖಾನ ಇವ್ಣ ಹಾತೇಖ್ಹು ಪಾಡಿಲಿನ್ ಯೆಹೋವನಖ್ಹಾಜೆ ಬಲಿಪೀಠ್‌ನಪರ್ ಭುಂಜ಼್‌ನು. ಯೊ ಯೆಹೋವನ ಖ್ಹೊಡ್‌ಮೈವಾನು ಬಲಿನು ಢಪ್ಕಾರ್ ಹುಯಿರ‍್ಹುಸ್. <verse eid="EXO 29:25" /><verse number="26" style="v" sid="EXO 29:26" />ಅಜು಼ ಆರೋನ್ನ ಪಟ್ಟಾಭಿಷೇಕ್‌ನಖ್ಹಾಜೆ ನೇಮಕ್ ಕರ‍್ಯಹುಯ ಮೇಂಢಾನ ಛಾ಼ತಿನ ಭಾಗ್ನ ಪಾಡಿನ್ ಇನ ಅರ್ಪಣ್‌ ಕರ‍್ಯಹುಯಾನ ಯೆಹೋವನ ಖ್ಹಾಮೆ ಉತಾರ್‌ನು. ಯೊ ತುನ ಮಳ್‌ಣುತೆ ವಾಟೊ ಹುಯಿರ‍್ಹಿಷೆ. <verse eid="EXO 29:26" /><verse number="27" style="v" sid="EXO 29:27" />ಆರೋನ್ನಬಿ ಇನ ಛಿಯ್ಯಾವ್‌ನಬಿ ನೇಮಕ್ ಕರಾನಿ ವಖ್ಹ್‌ತೆ ಅರ್ಪಣ್‌ ಕರ‍್ಯಹುಯ ಮೇಂಢಾನಿ ಬೋಟಿಮ ಛಾ಼ತಿನ ಭಾಗ್‌ನಬಿ ಯಾಜಕರ‍್ನಖ್ಹಾಜೆ ಮ್ಹೇಲಿರಾಖನು ಟಾಂಗ್‌ನ ದೇವ್ಣುಕರಿ ಖ್ಹಯಾಲ್ ಕರ‍್ನು. <verse eid="EXO 29:27" /><verse number="28" style="v" sid="EXO 29:28" />ಹಮೇಶಾನಿ ನಿಯಮ್‌ಥಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಯೋಅಖ್ಖಾನ ಆರೋನ್ನಬಿ ಇನ ಖಾನ್‌ದಾನ್‌ವಾಳನಬಿ ದೇವ್ಣುಪಡ್ಯು. ಯೊಅಖ್ಖು ಯಾಜಕವ್‌ನ ಭಾಗ್‌ನಖ್ಹಾಜೆ ಕಾಡಿಮ್ಹೇಲಿರಾಖನು ಹುಯಿರ‍್ಹುಸ್. ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಸಮಾಧಾನ್ನಿ ಬಲಿನಖ್ಹಾಜೆ ಜಾನ್ವರ್‌ನ ರ‍್ಹೇಖ್ಹಿನ್ ಯೆಹೋವನ ಆರಾದನೆ ಖ್ಹಾರಿವಖ್ಹತ್ ಯೊ ಭಾಗ್‌ಅಖ್ಖನ ಯಾಜಕವ್‌ನ ಖ್ಹಾಜೆ ಕಾಡಿಮ್ಹೇಲಿರಾಕ್ಣು. <verse eid="EXO 29:28" /><verse number="29" style="v" sid="EXO 29:29" />ಆರೋನನು ಯಾಜಕ್‌ನು ಪವಿತ್ರ ಪೆರ್ವಾಖ್ಹ್‌ಅಖ್ಖು ಯೊ ಹುಯಿಜಾ಼ವದಿನ್ ಇನ ಖಾನ್‌ದಾನ್‌ವಾಳನಬಿ ಉಪಯೋಗ್ ಹೋಣು. ಇವ್ಣೆ ಅನಾಮಸ್ ಮಾರಖ್ಹಾಜೆ ಅಬಿಷೇಕ್‌ಕರಿನ್ ನೇಮಕ್ ಕರ‍್ನು. <verse eid="EXO 29:29" /><verse number="30" style="v" sid="EXO 29:30" />ಇನ ಛಿಯ್ಯಾವ್ಮ ಇನಬದಲ್ ಮಹಾಯಾಜಕ ಹುವವಾಳೊ ಪವಿತ್ರಝ಼ಗೋಮ ದೇವ್ನಿ ಸೇವೆನ ಚ಼ಲಾವನಖ್ಹಾಜೆ ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾನ ಘರ್‌ಮ ಪೇಖ್ಹ್‌ಯುಥಪ್ತು ಖ್ಹಾತ್ ದನ್‌ಲಗು ಯೊ ಪೆರ್ವಾಖ್ಹ್‌ನ ಫೇರಿರಾಕ್ಣು. <verse eid="EXO 29:30" /><verse number="31" style="v" sid="EXO 29:31" />ಆರೋನ ಅಬಿಷೇಕ್‌ನಖ್ಹಾಜೆ ಅರ್ಪಣ್‌ ಕರ‍್ಯಹುಯ ಮೇಂಢಾನಿ ಬೋಟಿನ ದೇವ್ನದರ್ಶನ್ನ ಘರ್‌ನ ಮಾಳ್‌ಮ ರ‍್ಹಾಂದ್‌ಣು. <verse eid="EXO 29:31" /><verse number="32" style="v" sid="EXO 29:32" />ಆರೋನಬಿ ಇನ ಛಿಯ್ಯಾವ್‌ಬಿ ಯೊ ಮೇಂಢಾನಿ ಬೋಟಿನ ಅಜು಼ ಟೋಕ್ರಿಮನ ರೋಟಾನ ದೇವ್ನದರ್ಶನ್ನ ಡೇರಾನ ಘರ್‌ನ ಬಾಕಲ್‌ನ ಮಹಿ ಖಾವ್ಣು. <verse eid="EXO 29:32" /><verse number="33" style="v" sid="EXO 29:33" />ಇವ್ಣುನ ಯಾಜಕ್‌ನ ಸೇವೆನ ಸಮರ್ಪಣ್‌ಕರನಬಿ ಖಿವು ಚೀಜ಼್‌ಖ್ಹಾರು ಪಾಪ್ನ ಪರಿಹಾರ್‌ನಖ್ಹಾಜೆ ಅರ್ಪಣ್‌ಹುಯುಕಿ ಯೋಅಖ್ಖಾನ ಇವ್ಣೆ ಖಾವ್ಣುಪಣ್ಕಿ ಬಿಜು಼ಖ್ಹಾರು ನಾಖಾವ್ಣು; ಶನಕತೊ ಯೊಅಖ್ಖು ಪರಿಶುದ್ ಹುಯಿರ‍್ಹುಸ್. <verse eid="EXO 29:33" /><verse number="34" style="v" sid="EXO 29:34" />ಅಭಿಷೇಕ್‌ನ ಸಂಬಂದ್‌ಪಡಿಹುಯು ಬೋಟಿಮ ರ‍್ಹವೊ, ರೋಟಾಮ ರ‍್ಹವೊ ಬಿಜೇಕ್ ದನ್ನ ವ್ಹಾಣಲಗು ಉಭ್‌ರ‍್ಯುತೊ ಇನ ಬಾಳಿನಾಕ್ಣು. ಯೊ ಪವಿತ್ರ ಹುಯಿರ‍್ಹುತೆ ಖ್ಹಾಜೆ ಕೋಣ್‌ಬಿ ಇನ ನಾಖಾವ್ಣು. <verse eid="EXO 29:34" /><verse number="35" style="v" sid="EXO 29:35" />ಮೇ ತುನ ಹುಕುಮ್ ಕರ‍್ಯೊತೆ ಪರಕ್ಮ ಖ್ಹಾತ್‌ದನ್‌ಲಗು ಅಮ್ ಇವ್ಣುನ ಚ಼ಲೈನ್ ಆರೋನ್ನಬಿ ಇನ ಛಿಯ್ಯಾವ್‌ನಬಿ ನೇಮಕ್‌ಕರ‍್ನು. <verse eid="EXO 29:35" /><verse number="36" style="v" sid="EXO 29:36" />ಹರ್‌ದನ್‌ಬಿ ಪಾಪ್ನ ಪರಿಹಾರ್‌ನಖ್ಹಾಜೆ ಎಕ್ ಕೆಲ್ಡಾನ ಬಲಿದೇವ್ಣು. ಆ ಕಾಹೆತೆ ಬಲಿಪೀಠ್‌ನ ಶುದ್ದಿಕರಾನಖ್ಹಾಜೆ ಇನಪರ್ ಪಾಪ್‌ ಪರಿಹಾರ‍್ನು ಬಲಿನ ಅರ್ಪಣ್‌ಕರಿನ್, ಇನ ದೇವ್ನಿ ಸೇವೆನಖ್ಹಾಜೆ ನೇಮಕ್‌ಕರಾನ ಅಬಿಷೇಕ್ ಕರ‍್ನು. <verse eid="EXO 29:36" /><verse number="37" style="v" sid="EXO 29:37" />ಅಮ್ ಖ್ಹಾತ್ ದನ್‍ಲಗುಬಿ ಬಲಿಪೀಠ್‌ನ ಖ್ಹಾಜೇಥಿ ಪಾಪ್ನು ಪರಿಹಾರ‍್ನು ನಿಯಮ್ನ ಚ಼ಲೈನ್ ಇನ ನೇಮಕ್‌ಕರ‍್ನು. ಚಾ಼ಚ಼ರ್‌ಘ಼ಣು ಪರಿಶುದ್ಧ್ ಹುಯಿರ‍್ಹೇಣು. ಬಲಿಪೀಠ್‌ನ ಛೀಮವಾಳು ಖ್ಹಾರುಬಿ ಪರಿಶುದ್ಧ್ ಹುಯಿರ‍್ಹೇಣು.<verse eid="EXO 29:37" /></para>
  <para style="s">ಹರ್‌ದನ್ನು ಬಲಿದಾನ್‌</para>
  <para style="r">(<ref loc="NUM 28:1-8">ಅರಣ್ಯ 28:1-8</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="EXO 29:38" />ಬಲಿಪೀಠ್‌ನ ಉಪ್ಪರ್ ದನ್‌ರೋಜ಼್ ಅರ್ಪಣ್‌ಕರಾನ ಹೋಣುತೆಖ್ಹಾರು ಆ: ಎಕ್ ವರಖ್ಹ್‌ನ ಬೇ ಮೇಂಢಾವ್ನ ಹರ್‌ದನ್‌ಬಿ ಬಲಿಕರ‍್ನು. <verse eid="EXO 29:38" /><verse number="39" style="v" sid="EXO 29:39" />ಇನಾಮ ಏಕ್‌ ಮೇಂಢಾನ ವ್ಹಾಣೆವೇಳಿಬಿ ಬಿಜೇಕ್‌ನ ಖ್ಹಾಂಜ಼್‌ನಿ ವಖ್ಹತ್‌ಮ ಅರ್ಪಣ್‌ಕರ‍್ನು. <verse eid="EXO 29:39" /><verse number="40" style="v" sid="EXO 29:40" />ಎಕ್ ಲೀಟರ್ ಓಲಿವ್‌ನು ತೇಲ್‌ಬಿ ಎಕ್ ಕಿಲೊಗ್ರಾಂ ಘವ್‌ನ ಆಟಾನಬಿ ಮಳೈನ್ ಅನಾಜ಼್ ಅರ್ಪಣ್‌ ಕರಾನಖ್ಹಾಜೆ ಯೊ ಪಹಿಲ ಮೇಂಢಾನ ಜೋ಼ಡ್ಮ ಅರ್ಪಣ್ ಕರ‍್ನು. ಎಕ್ ಲೀಟರ್ ದ್ರಾಕ್ಷಿನ ರಖ್ಹ್‌ನಬಿ ಅರ್ಪಣ್‌ಕರ‍್ನು. <verse eid="EXO 29:40" /><verse number="41" style="v" sid="EXO 29:41" />ಖ್ಹಾಂಜ಼್‌ನಿ ವಖ್ಹತ್‌ಮ ಬೇನ ಮೇಂಢಾನ ಬಲಿಕರಾನಿ ವಖ್ಹ್‌ತೆ ವ್ಹಾಣೆ ಕರ‍್ಯೊತೆ ಪರಕ್ಮಾಸ್ ಇನ ಜೋ಼ಡ್ಮ ಅನಾಜ಼್‌ನು ನೈವೇದ್ಯನಬಿ, ದ್ರಾಕ್ಷಿನ ರಖ್ಹ್‌ನಾಬಿ ಅರ್ಪಣ್‌ಕರ‍್ನು. ಯೊ ಯೆಹೋವನ ಖ್ಹೊಡ್‌ಮೈವಾನು ಭುಂಜಾ಼ನಿ ಬಲಿಹುಯಿರ‍್ಹಿಷೆ. <verse eid="EXO 29:41" /><verse number="42" style="v" sid="EXO 29:42" />ಆ ಭುಂಜಾ಼ನಿ ಬಲಿನ ತುಮೇಬಿ ತುಮಾರು ಪಿಳ್ಗಿವಾಳುಬಿ ಹರ್‌ವಖ್ಹತ್ ಯೆಹೋವನ ಖ್ಹಾಮ್ಣೆ ದೇವ್ನ ದರ್ಶನ್ನು ಘರ್‌ನ ಬಾಕಲ್‌ನ ಮ್ಹೋರೆಮ ಕರ‍್ನು. ಯೊ ಘರ್‌ಮ ಮೆ ತುಮಾರ ಜೋ಼ಡೆ ವಾತೆಬೋಲಿಷ್. <verse eid="EXO 29:42" /><verse number="43" style="v" sid="EXO 29:43" />ಹಿಜ್ಜಾ಼ಸ್ ಮೇ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ದರ್ಶನ್ ದಿಶ್. ಹಿಜ಼್ಜಾ ದೆಖಾವನಿ ಮಾರಿ ಉಜಾ಼ಖ್ಹ್‌ಥಿ ಯೊ ಝ಼ಗೊ ಪರಿಶುದ್ ಹುಯಿರ‍್ಹಿಷೆ. <verse eid="EXO 29:43" /><verse number="44" style="v" sid="EXO 29:44" />ಮೇ ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾನ ಘರ್‌ನಾಬಿ ಬಲಿಪೀಠ್‌ನಬಿ ಪರಿಶುದ್ದ ಕರಿಶ್. ಆರೋನ್ನಬಿ ಅಜು಼ ಇನ ಛಿಯ್ಯಾವ್‌ನಬಿ ಮನ ಯಾಜಕನು ಸೇವೆ ಕರಾನಿಘೋಣಿ ಶುದ್ದಿಕರಣ್ ಕರಿಶ್. <verse eid="EXO 29:44" /><verse number="45" style="v" sid="EXO 29:45" />ಮೇ ಇಸ್ರಾಯೇಲ್ನ ಬೀಚ್ಮ ಜಿವಿರ‍್ಹೀನ್ ಇವ್ಣುನ ದೇವ್‌ಹುಯಿರ‍್ಹಿಷ್. <verse eid="EXO 29:45" /><verse number="46" style="v" sid="EXO 29:46" />ಇವ್ಣ ಬೀಚ್ಮ ಜಿವಿರ‍್ಹವಾನ ಖ್ಹಾಜೆಸ್ ಇವ್ಣುನ ಈಜಿಪ್ಟ್‌ಥು ಭಾರ್‌ ಬುಲಾಯೊತೆ ಮೇಸ್ ಇವ್ಣೊ ದೇವ್ ಯೆಹೋವ ಕರಿ ಇವ್ಣೆ ಮಾಲುಮ್‌ ಕರಿಲಿಷೆ. ಇವ್ಣೊ ದೇವ್‌ ಹುಯಿರ‍್ಹವವಾಳೊ ಯೆಹೋವ ಮೇಸ್.<verse eid="EXO 29:46" /></para>
  <chapter eid="EXO 29" />
  <chapter number="30" style="c" sid="EXO 30" />
  <para style="s">ಖ್ಹಾಲರ‍್ಯನ ಬಾಳನಿ ಢಾಕ್ಣಿ</para>
  <para style="r">(<ref loc="EXO 37:25-28">ವಿಮೋ 37:25-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 30:1" />ವಾನ ತೇಲ್‌ಥಿ ಢಪ್‌ಕಾರನಾಖನ ತುಮೆ ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ಥಿ ಎಕ್ ಢಾಕ್ಣಿನ ಕರಾವ್ಣು. <verse eid="EXO 30:1" /><verse number="2" style="v" sid="EXO 30:2" />ಯೊ ಏಕ್‌ಹಾತ್ ಲಾಂಬುಬಿ ಏಕ್‌ಹಾತ್ ಚೌ಼ಡುಬಿ ರ‍್ಹೀನ್ ಚಾರ್‌ಖೂಟಿ ಹುಯಿರ‍್ಹೇಣು. ಇನು ಊಚು಼ ಬೇಹಾತ್ ಹುಯಿರ‍್ಹೇಣು. ಇನು ಶಿಂಗ್‌ಡು ಅಖ್ಖು ಇನೇಥಿಸ್‌ ಮಳಿರ‍್ಹೇಣು. <verse eid="EXO 30:2" /><verse number="3" style="v" sid="EXO 30:3" />ಇನು ಉಪ್ಲಿ ಬಾಜು಼ನ, ಚಾರ್ ಆಡಿಮ ಅಜು಼ ಶಿಂಗ್‌ಡಾವ್ನ, ಅಫುಟ್ ಖ್ಹೊನ್ನಾನು ತಗ್‌ಡಾವ್ನ ಮೂಚ಼್‌ಣು. ಅಶ್‌ಪಿಶ್‌ಬಿ ಖ್ಹೊನ್ನಾನು ಪಟ್ಟಿಯೇನ ಭಂದಾವ್ಣು. <verse eid="EXO 30:3" /><verse number="4" style="v" sid="EXO 30:4" />ಇನ ಹೇಟ್ ಢಾಕ್ಣಿನು ಭೇ ಬಾಜು಼ಮ ಬೆಬ್ಬೇ ಖ್ಹೊನ್ನಾನಿ ಕಾಕ್ಣಿನ ಕೋಣಮಾಸ್ ಘಲಾವ್ಣು. ಢಾಕ್ಣಿನ ಪಾಡನ ಲಠ್ಠಾವ್ನ ಇನಾಮ ಪೆಖ್ಹಾಡ್‌ಣು. <verse eid="EXO 30:4" /><verse number="5" style="v" sid="EXO 30:5" />ಯೊ ಲಠ್ಠಾವ್ನ ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ಥಿ ಕರೈನ್ ಇನ ಖ್ಹೊನ್ನಾನ ತಗ್‌ಡಾವ್ನ ಮೂಚ಼್‌ಣು. <verse eid="EXO 30:5" /><verse number="6" style="v" sid="EXO 30:6" />ಹುಕುಮ್‌ನ ಲಿಖ್ಯುರ‍್ಹವಾನ ಪಿಟಾರನು ಖ್ಹಾಮ್ಣೆನು ಪಡ್ದಾನ ಮ್ಹೋರೆ, ಕತೊ ಹುಕುಮ್‌ನು ಲೀಖ್ಯಾನು ಪಿಟಾರನ ಉಪ್‌ಲ್ಯು ಅಜು಼ ಮೆ ತುನ ದರ್ಶನ್ ದ್ಯವಾನು ಕೃಪಾಸನ್ನ ಖ್ಹಾಮ್ಣೆ ಇನ ಮ್ಹೇಲ್ನು. <verse eid="EXO 30:6" /><verse number="7" style="v" sid="EXO 30:7" />“ಆರೋನ ಹರ್ ವಖ್ಹತ್ ವ್ಹಾಣ್‌ಖ್ಹತ್ರೆ ದೀವಾನ ಬರೊಬರ್‌ಕರಾನಿ ವಖ್ಹ್‌ತೆಬಿ <verse eid="EXO 30:7" /><verse number="8" style="v" sid="EXO 30:8" />ಖ್ಹಾಂಜ಼್‌ನಿ ವಖ್ಹತ್‌ಮ ದೀವಾನ ಲಗಾಡನಿ ವಖ್ಹತ್‍ಬಿ ಇನಾಪರ್ ಅಛ್ಛಿವಾನ ತೇಲ್‌ಥಿ ಢಪ್ಕಾರ ನಾಕ್ಣು. ಅಮ್ ತುಮಾರಥೆಬಿ ತುಮಾರ ಪಿಳ್ಗಿವಾಳಥಿಬಿ ಯೆಹೋವನ ಖ್ಹಾಮ್ಣೆ ಲಗತ್ತರ್ ಢಪ್‌ಕಾರ್‌ನು ಅರ್ಪಣ್ ಚಾ಼ಲುಕರ‍್ನು. <verse eid="EXO 30:8" /><verse number="9" style="v" sid="EXO 30:9" />ಯೊ ಢಾಕ್ಣಿನಪರ್ ಬಿಜು಼ ಖಿವು ಢಪ್‌ಕಾರ್‌ನಬಿ ನಾನಾಕ್ಣು. ಇನಪರ್ ಬಿಜು಼ಖ್ಹಾರು ಬಳಾನುರ‍್ಹವೊ, ಖಾಣುಪಾಣಿರ‍್ಹವೊ ಅಜು಼ ದ್ರಾಕ್ಷಿನ ರಖ್ಹ್‌ನ ರ‍್ಹವೊ ಅರ್ಪಣ್ ನಾಕರ‍್ನು. <verse eid="EXO 30:9" /><verse number="10" style="v" sid="EXO 30:10" />ಆರೋನಬಿ ಇನು ಪಿಳ್ಗಿವಾಳುಬಿ ವರಖ್ಹ್‌ನ ಏಕ್‌ಹಲ್ಲ ಪಾಪ್ನ ಪರಿಹಾರ್‌ನ ಬಲಿನ ಜಾನ್ವರ್‌ನು ಲ್ಹೋಯಿನ ಯೊ ಢಾಕ್ಣಿನ ಶಿಂಗ್‌ಡಾವ್ನ ಲಗಾಡಿನ್ ಇನ ಬಾರೇಮ ದೋಷ್‌ನು ಪರಿಹಾರ್ ಕರ‍್ನು. ಯೊ ಯೆಹೋವನ ಘಣು ಪರಿಶುದ್ಧ್ ಹುಯಿರ‍್ಹುಸ್.”<verse eid="EXO 30:10" /></para>
  <para style="s">ಯೆಹೋವನಿ ಝ಼ಗೋಮ ಡೇರಾನಿ ಶುಂಕ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 30:11" />ಯೆಹೋವನೆ ಮೋಶೆನ ಶಾತ್‌ಬೋಲ್ಯೊ ಕತೊ, <verse eid="EXO 30:11" /><verse number="12" style="v" sid="EXO 30:12" />“ತೂ ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಅದ್ಮಿನು ಗಣ್ತಿ ಕರೈನ್ ಇವ್ಣುನ ಗಣ್ತಿಕರಾನಿ ವಖ್ಹ್‌ತೆ ಇವ್ಣುನ ಖ್ಹತಾಪ್ಣಿ ಹುಯಿನ್ ರೋಗ್ ನಾ ಆವ್ಣುತೆ ತಿಮ್ ಹರೇಕ್ ಜ಼ಣೊಬಿ ಇನು ಇನು ಜಾನ್ನಖ್ಹಾಜೆ ಯೆಹೋವನ ಕಪ್ಪಕಾಣ್ಕೆ ದೇವ್ಣು. <verse eid="EXO 30:12" /><verse number="13" style="v" sid="EXO 30:13" />ಗಣ್ತಿ ಹುಯಿರ‍್ಹವಾಳಮ ಹರೇಕ್ ಜ಼ಣೊಬಿ ಸೇವೆನ ದೇವ್ಣುಕರಿ ಹುಯಿರ‍್ಹುತೆ ವೀಖ್ಹ್‌ ‘ಗೇರಾ’ ತೋಲ್‌ನು ರಪ್ಯಾನಿ ಗಣ್ತಿನಿ ಘೋಣಿ ಆಧು ಶೆಕೆಲ್ ಕಾಣ್ಕೆ ದೇವ್ಣು. ಆ ಆಧುಶೆಕೆಲ್ ಯೆಹೋವನ ಪವಿತ್ರ ಕಾಣ್ಕೆ ಹುಯಿರ‍್ಹುಸ್. <verse eid="EXO 30:13" /><verse number="14" style="v" sid="EXO 30:14" />ಗಣ್ತಿ ಕರ‍್ಯಹುಯಾಮ ವೀಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳುಬಿ ಅಜು಼ ಇನ ಉಪ್ಪರ್‌ಲಿ ಉಂಬರ್‌ವಾಳುಬಿ ಯೊ ಕಾಣ್ಕೆನ ಹರೇಕ್‌ಜ಼ಣು ಯೆಹೋವನ ದೇವ್ಣು. <verse eid="EXO 30:14" /><verse number="15" style="v" sid="EXO 30:15" />ಜಾನ್ನ ಬಚಾ಼ಡನು ಆ ಕಾಣ್ಕೆನ ಯೆಹೋವನ ದ್ಯವಾಮ ಶೌಕಾರ್‌ ರ‍್ಹಯುತೋಬಿ ಆಧ ರಪ್ಯಾಥಿ ಜಾ಼ಖ್ಹತ್ ನಾದೇವ್ಣು. ಗರೀಬ್ ಕಮ್ ನಾದೇವ್ಣು. <verse eid="EXO 30:15" /><verse number="16" style="v" sid="EXO 30:16" />ತೂ ಜಾನ್ನ ಬಚಾ಼ಡನ ಆ ಪೈಶಾನ ಇಸ್ರಾಯೇಲ್‌ವಾಳಥಿ ಲೀನ್ ಇನ ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾನ ಘರ್‌ನಿ ಸೇವೆನ ಉಪಯೋಗ್‌ಕರ‍್ನು. ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಜಾನ್ನ ಬಚಾ಼ಡ್‌ಣುಕರಿ ಬೋಲಿನ್ ಆ ಕಾಣ್ಕೆನ ಯೆಹೋವ ಹುಯಿರ‍್ಹೋತೆ ಮಾರಿ ಖ್ಹಾಮೆ ಯಾದ್ ಹುಯಿರ‍್ಹಿಷೆ.”<verse eid="EXO 30:16" /></para>
  <para style="s">ತಾಂಬಾನಿ ಬಾನೆ</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 30:17" />ಯೆಹೋವನೆ ಮೋಶೆನ ಶಾತ್ ಬೋಲ್ಯೊಕತೊ, <verse eid="EXO 30:17" /><verse number="18" style="v" sid="EXO 30:18" />“ಪಾಣಿ ನ್ಹೊವ್ವಾನಖ್ಹಾಜೆ ಎಕ್ ತಾಂಬಾನು ಬಾನೆನಬಿ ಇನ ತಾಂಬಾನ ಝ಼ಗ್ಲಿನ ಕರೈನ್ ದೇವ್ನ ದರ್ಶನ್ನು ಘರ್‌ನಾಬಿ ಚಾ಼ಚ಼ರ್‌ನ ಬೀಚ್ಮ ಮ್ಹೇಲಿನ್ ಇನಾಮ ಪಾಣಿ ಭರಾವ್ಣು. <verse eid="EXO 30:18" /><verse number="19" style="v" sid="EXO 30:19" />ಆರೋನಬಿ ಇನ ಛಿಯ್ಯಾವ್‌ಬಿ ಇನೇಥಿ ಹಾತ್ ಗೋಡವ್ನ ಧೊಯಿಲೇವ್ಣು. <verse eid="EXO 30:19" /><verse number="20" style="v" sid="EXO 30:20" />ಇವ್ಣೆ ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾನ ಘರ್‌ನ ಮಹಿ ಜಾ಼ವನಿವಖ್ಹ್‌ತೆ ಅಜು಼ ದೇವ್ನಿ ಸೇವೆನ ಕರಾವಳಹುಯಿನ್ ಯೆಹೋವನ ಬಲಿ ಛ಼ಡಾವನಖ್ಹಾಜೆ ಚಾ಼ಚ಼ರ್‌ಕನ ಆವನಿವಖ್ಹ್‌ತೆ ಜಿವ್ತೊ ರ‍್ಹವಾನಖ್ಹಾಜೆ ಹಾತ್‌ಗೋಡಾವ್ನ ಧೊಯಿಲಿನ್ ಆವ್ಣು. <verse eid="EXO 30:20" /><verse number="21" style="v" sid="EXO 30:21" />ನಾ ಧೊಯಿನ್ ಆಯುತೊ ಮರಣ್ಣಿ ನಿಶತ್ ಉಷೆ. ಆ ಇನಾಬಿ ಅಜು಼ ಇನಿ ಪಿಳ್ಗಿವಾಳನಬಿ ಹಮೇಶಾನಿ ನಿಯಮ್‌ ಹುಯಿರ‍್ಹೇಣು.”<verse eid="EXO 30:21" /></para>
  <para style="s">ಅಬಿಷೇಕ್‌ನು ತೇಲ್‌</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 30:22" />ಆ ನಾಹುಯಿನ್ ಯೆಹೋವನೆ ಮೋಶೆನ ಪಾಛೊ಼ ಶಾತ್‌ ಬೋಲ್ಯೊಕತೊ, <verse eid="EXO 30:22" /><verse number="23" style="v" sid="EXO 30:23" />“ತೂ ಅಛ್ಛಿವಾನು ತೈಲಾಮ ದೇವ್ನಿ ಸೇವೆನ ನೇಮಕ್‌ನು ತೋಲ್‌ನಿ ಘೋಣಿ ಛೊ಼ ಕಿಲೊ ಅಫುಟ್ ರಕ್ತಬೋಳ್, ತೀನ್ ಕಿಲೊ ಶ್ರೇಷ್ಟ್ ಲವಂಗಚಕ್ಕೆ, ತೀನ್ ಕಿಲೊ ಅಛ್ಛು಼ ವಾಖ್ಹ್‌ರ‍್ಹವಾನು ವಚ಼್‌ ಅಜು಼ ಛೊ಼ ಕಿಲೊ ದಾಲ್‌ಚಿನ್ನಿನ ಲೇವ್ಣು. <verse eid="EXO 30:23" /><verse number="24" style="v" sid="EXO 30:24" />ಇನ ಅಖ್ಖಾನ ಪಾಡಿಲಿನ್ ಛೋ಼ ಲೀಟರ್ ಅಫುಟ್‌ ಒಲಿವ್ ತೇಲ್ನ ಲೀನ್, <verse eid="EXO 30:24" /><verse number="25" style="v" sid="EXO 30:25" />ವಾನು ತೇಲ್‌ ಕರವಾಳನಿ ಪದತ್ತಿನಿಘೋಣಿ ಮಿಲಾವಟ್‌ಕರಿನ್ ಪರಿಶುದ್ ಅಭಿಷೇಕ್ ತೇಲ್ನ ಕರಾವ್ಣು. ಆ ಅಬಿಷೇಕ್‌ನು ತೇಲ್‌ಹುಯಿರ‍್ಹುಸ್. <verse eid="EXO 30:25" /><verse number="26" style="v" sid="EXO 30:26" />ಇನಖ್ಹಾಜೆ ದೇವ್ನ ದರ್ಶನ್ನು ಡೇರಾನು ಘರ್, ಹುಕುಮ್‌ನು ಪಲ್ಗಾನೊ ಪಿಟಾರೊ, ಅಬಿಷೇಕ್‌ಕರಾನಖ್ಹಾಜೆ ಯೊ ತೇಲ್ನ ಉಪಯೋಗ್‌ ಕರ‍್ನು. <verse eid="EXO 30:26" /><verse number="27" style="v" sid="EXO 30:27" />ಖುಡ್‌ಷಿ, ಖುಡ್‌ಷಿನು ಜಿನಖ್ಹ್‌ಅಖ್ಖು. ದೀವಾನುಖಂಬು, ದೀವಾನುಖಂಬ್‌ನು ಜಿನಖ್ಹ್‌ಅಖ್ಖು, ಢಾಕ್ಣಿ, ಚಾ಼ಚ಼ರ್‌, ಚಾ಼ಚ಼ರ್‌ನು ಜಿನಖ್ಹ್‌ಅಖ್ಖು <verse eid="EXO 30:27" /><verse number="28" style="v" sid="EXO 30:28" />ಅಜು಼ ಪಾಣಿನಿ ಬಾನೆ ಇನ ಝ಼ಗ್ಲಿ ಅನಅಖ್ಖು ಅಬಿಷೇಕ್‌ಕರ‍್ನು. <verse eid="EXO 30:28" /><verse number="29" style="v" sid="EXO 30:29" />ಯೊಅಖ್ಖು ಘಣು ಪರಿಶುದ್ಧ್ ಹುವಾನಿತರ ಯೋಅಖ್ಖಾನ ಪಾಕ್‌ಕರ‍್ನು. ಯೋಅಖ್ಖಾನ ಛೀಮವಾಳುಖ್ಹಾರುಬಿ ಪರಿಶುದ್ಧ್ ಹುಯಿರ‍್ಹೇಣು. <verse eid="EXO 30:29" /><verse number="30" style="v" sid="EXO 30:30" />ಯೋಸ್‌ ಕಾಹೆತೆ ಆರೋನಬಿ ಇನ ಛಿಯ್ಯಾವ್‌ಬಿ ಮನ ಯಾಜಕ ಹುವಾನಿತರ ಇವ್ಣುನ ಅಬಿಷೇಕ್‌ಕರಿನ್ ಶುದ್ದಕರ‍್ನು.” <verse eid="EXO 30:30" /><verse number="31" style="v" sid="EXO 30:31" />ತೂ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಹುಕುಮ್ ದ್ಯವಾನಿತರಾನು ಶಾತ್‌ಕತೊ, “ತುಮೇಬಿ ತುಮಾರು ಪಿಳ್ಗಿವಾಳುಬಿ ಆ ತೇಲ್ನ ಮಾರಿ ಸೇವೆನ ನೇಮಕ್‌ನು ಪರಿಶುದ್ಧ್ ಅಬಿಷೇಕ್‌ನು ತೇಲ್‌ಕರಿ ಮಾಲುಮ್ ಕರಿಲೇವ್ಣು. <verse eid="EXO 30:31" /><verse number="32" style="v" sid="EXO 30:32" />ಅದ್ಮಿಖ್ಹಾರು ಆಂಗ್‌ತನ್ನ ಲಗಾಡನ ಅನ ನಾ ಉಪಯೋಗ್ ಕರ‍್ನು. ಆ ತರೀಖಾನ ಲೀನ್ ಬಿಜು಼ ಖಿವುಬಿ ಕಾಮ್ನಖ್ಹಾಜೆ ತೇಲ್ನ ನಾಸ್‌ ಬಣಾವ್ಣು. ಆ ದೇವ್ನ ನೇಮಕ್‌ಹುಯಿರ‍್ಹುತೆ ಜಿನಖ್ಹ್‌. ಆ ಹೈರುತೆ ಪರಿಶುದ್ಧ್ ಕರಿ ತುಮೆ ಮಾಲುಮ್ ಕರಿಲೇವ್ಣು. <verse eid="EXO 30:32" /><verse number="33" style="v" sid="EXO 30:33" />ಅನಿನಿಘೋಣಿ ತೇಲ್ನ ಕರವಾಳೊರ‍್ಹವೊ ಅನ ಯಾಜಕಕೊಂತೆ ಇನಾಪರ್ ಲಗಾಡವಾಳೊ ಇನ ಖೂಮ್‌ಥು ನಿಕ್‌ಳಿ ಜಾ಼ವ್ಣು.”<verse eid="EXO 30:33" /></para>
  <para style="s">ಮಹಿಕಾವನು ತೇಲ್‌</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 30:34" />ಆಸ್ ಕಾಹೆತೆ ಯೆಹೋವನೆ ಮೋಶೆನ ಶಾತ್ ಹುಕುಮ್ ದಿದೊಕತೊ, “ತೂ ದೂದ್ನಿಮಲ್ಹಯಿ, ಗುಗ್ಗುಲ ಅಜು಼ ಚ಼ಂದಣ್ಣಿಛಾ಼ಲ್‌ ಕರಿ ಮಹಿಕಾವನು ತೇಲ್ನ ಸಮಾಥಿ ಲೀನ್, <verse eid="EXO 30:34" /><verse number="35" style="v" sid="EXO 30:35" />ಮಹಿಕಾವನು ತೇಲ್ನ ತಯಾರ್ ಕರವಾಳನಿ ಪಢಂತ್‌ನಿ ಘೋಣಿ ಕಲೈನ್ ಮೀಟ್ ನಾಖಿನ್ ದೇವ್ನಿ ಸೇವೆನ ಪರಿಶುದ್‍ ಢಪ್‌ಕಾರ‍್ನ ಕರಾವ್ಣು. <verse eid="EXO 30:35" /><verse number="36" style="v" sid="EXO 30:36" />ಇನಾಮ ಥೋಡಾನ ಪುಡಿಕರೈನ್ ದೇವ್ನ ದರ್ಶನ್ನು ಡೇರಾನ ಘರ್‌ಮ ಹುಕುಮ್‌ನು ಲಿಖ್ಯಾವ್‌ನು ಪಿಟಾರನ ಖ್ಹಾಮೆಕರಿ ಮೇ ತುನ ದರ್ಶನ್ ದ್ಯವಾನಿ ಝ಼ಗೋಮ ಮ್ಹೇಲ್ನು. ಯೊ ಘಣು ಪರಿಶುದ್ಧ್‌ನು ಕರಿ ತುಮೆ ಮಾಲುಮ್‌ ಕರಿಲೇವ್ಣು. <verse eid="EXO 30:36" /><verse number="37" style="v" sid="EXO 30:37" />ತುಮೆ ಯೊ ಮಹಿಕಾವನ ತೇಲ್ನಿ ಪರಕ್‌ನಿಘೋಣಿ ತುಮಾರು ಶೊಂತ್ ಉಪಯೋಗ್‌ನಖ್ಹಾಜೆ ಢಪ್‌ಕಾರ‍್ನ ತೇಲ್ನ ನಾ ಕರಾವ್ಣು. ಯೊ ಯೆಹೋವನಿ ಸೇವೆನ ಖಲಿ ಉಪಯೋಗ್‌ಕರಾನ ಛಾ಼ತೆ ಪವಿತ್ರ ರಾಛು಼ಕರಿ ಮಾಲುಮ್ ರ‍್ಹೇಣು. <verse eid="EXO 30:37" /><verse number="38" style="v" sid="EXO 30:38" />ಅಛ್ಛಿ ವಾನಖ್ಹಾಜೆ ಎಥ್ರಾನು ಶೊಂತ್‌ನಖ್ಹಾಜೆ ಕರಿಲ್ಯವಾಳೊ ಇನಿ ಖೂಮ್‌ಥು ಕಡೈಜಾ಼ವಳೊ ಹುಯಿರ‍್ಹೊಸ್.”<verse eid="EXO 30:38" /></para>
  <chapter eid="EXO 30" />
  <chapter number="31" style="c" sid="EXO 31" />
  <para style="s">ಯೆಹೋವನಿ ಸನ್ನಿದಿನು ಡೇರಾನು ಕಾಮ್‌ಕರಾವಳು</para>
  <para style="r">(<ref loc="EXO 35:30-36:1">ವಿಮೋ 35:30—36:1</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 31:1" />ಯೆಹೋವನೆ ಮೋಶೆನ ಅಮ್ ಬೊಲ್ಯೊ, <verse eid="EXO 31:1" /><verse number="2" style="v" sid="EXO 31:2" />“ದೇಕ್, ಮೆ ಯೆಹೂದ ಖೂಮ್‌ನೊ ಹೂರನೊ ಪೋತಿಬಿ, ಊರಿಯನೊ ಛಿಯ್ಯೊಬಿ ಹುಯಿರ‍್ಹೋತೆ ಬೆಚಲೇಲ ಕರಿ ಬೋಲವಾಳನ ಚೂ಼ಣಿರಾಖ್ಯೊಸ್. <verse eid="EXO 31:2" /><verse number="3" style="v" sid="EXO 31:3" />ಅಖ್ಖಿ ಥರಾನು ಬಣಾವಟ್ ಕರಾನು ದೇವ್ನು ಗ್ಯಾನ್ನಾಬಿ, ಖ್ಹೊನ್ನು, ರೂಪು ಅಜು಼ ತಾಂಬಾನು ಕಾಮ್ ಕರಾನಬಿ, <verse eid="EXO 31:3" /><verse number="4" style="v" sid="EXO 31:4" />ಹೀರಾವ್ನ ಟಕಾವನಾಬಿ, ಝಾ಼ಡ್‌ಣ ಖೋಂದಿನ್‌ ಕಾಮ್‌ ಕರಾನಬಿ, <verse eid="EXO 31:4" /><verse number="5" style="v" sid="EXO 31:5" />ಇನ ದೇವ್ನು ಆತ್ಮನ ದೀನ್‌, ಇನ ಹೋಣುತೆ ಗ್ಯಾನ್, ಅಕ್ಕಲ್‌, ಬುದ್ದಿ ಕೈಏಕ್‌ ವಿಚಿತ್ರಥಿ ಹೀರಾನ ಕೆತ್ತಾನು ಕಾಮ್‌ ಕರಾನ ಅಕ್ಕಲ್‌ ದೀರಾಖ್ಯೊಸ್, <verse eid="EXO 31:5" /><verse number="6" style="v" sid="EXO 31:6" />ಇನಿ ಜೋ಼ಡ್ಮ ದಾನ್ ಖೂಮ್‌ನೊ ಅಹೀಸಾಮಾಕನೊ ಛಿಯ್ಯೊ ಒಹೋಲೀಯಾಬನ ನೇಮಕ್‌ ಕರಿರಾಖ್ಯೊಸ್. ಯೋಸ್ ಕಾಹೆತೆ ಮೆ ತುನ ಹುಕುಮ್ ದಿದೊತೆ ಅಖ್ಖಾಸ್ನ ಕರಾನ ಅಕ್ಲಿ ಹುಯಿರ‍್ಹವಳನ ದಿಲ್ಮ ಅಕ್ಕಲ್‍ನ ಪೈದ ಕರಿರಾಖ್ಯೊಸ್. <verse eid="EXO 31:6" /><verse number="7" style="v" sid="EXO 31:7" />ದೇವ್ನ ದರ್ಶನ್ನು ಡೇರಾನು ಘರ್, ಹುಕುಮ್‌ನು ಮ್ಹೇಲಿರಾಖನು ಪಿಟಾರೊ ಇನು ಉಪ್ಪರ್‌ಲ್ಯು, ಕೃಪಾಸನ್, ಡೇರಾನ ಘರ್‌ನು ಕಾಮ್‌ಕರಾನು ಅಖ್ಖುಸ್ ಜಿನಖ್ಹ್‌, <verse eid="EXO 31:7" /><verse number="8" style="v" sid="EXO 31:8" />ಖುಡ್‌ಷಿ ಇನು ಕಾಮ್ನು ಜಿನಖ್ಹ್‌, ಅಫುಟ್ ಖ್ಹೊನ್ನಾನು ದಿವೋನು ಖಂಬು ಇನು ಕಾಮ್ನು ಜಿನಖ್ಹ್‌ಅಖ್ಖು, <verse eid="EXO 31:8" /><verse number="9" style="v" sid="EXO 31:9" />ಢಾಕ್ಣಿ, ಚಾ಼ಚ಼ರ್‌ ಇನು ಕಾಮ್ನು ಜಿನಖ್ಹ್‌ಅಖ್ಖು, ಪಾಣಿನು ಬಾನೆ ಇನು ಝ಼ಗ್ಲಿ, <verse eid="EXO 31:9" /><verse number="10" style="v" sid="EXO 31:10" />ಶನ್‌ಗಾರ್ ಹುಯಿರ‍್ಹವನು ಪರಿಶುದ್ಧ್ ಪೆರ್ವಾಖ್ಹ್ಅಖ್ಖು ಕತೊ ಆರೋನ್ನಬಿ ಇನ ಛಿಯ್ಯಾವ್ನ ಹೋಣುತೆ ಪವಿತ್ರ ಯಾಜಕ್‌ನು ಪೆರ್ವಾಖ್ಹ್‌ಅಖ್ಖು, <verse eid="EXO 31:10" /><verse number="11" style="v" sid="EXO 31:11" />ಅಬಿಷೇಕ್‌ನು ತೇಲ್ ಅಜು಼ ಪವಿತ್ರ ಝ಼ಗೋನು ಸೇವೆನ ಹೋಣುತೆ ಮಹಿಕಾವನು ಖ್ಹಾಲರ‍್ಯೊ ಆ ಅಖ್ಖಾನ ಮೇ ತುನ ಹುಕುಮ್ ಕರಾನಿತ್ರಸ್ ಇವ್ಣೆ ಕರ್ಷೆ.”<verse eid="EXO 31:11" /></para>
  <para style="s">ಸಬ್ಬತ್‌ನು ದನ್ ಅರಾಮ್‌ನೊ ದನ್</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 31:12" />ಯೆಹೋವನೆ ಪಾಛೊ಼ ಮೋಶೆನ ಅಮ್ ಬೊಲ್ಯೊ, <verse eid="EXO 31:12" /><verse number="13" style="v" sid="EXO 31:13" />“ತೂ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಹುಕುಮ್ ಕರ‍್ನುತೆ ಶಾತ್‌ಕತೊ: ಮೇ ನೇಮಕ್ ಕರ‍್ಯೊತೆ ಪವಿತ್ರ ಸಬ್ಬತ್ ಖ್ಹಾರದನ್ನ ತುಮೆ ಛು಼ಕ್‌ಣುನಾತೆ ಚ಼ಲಾವ್ಣು. ತುಮುನ ಪರಿಶುದ್‌ಕರಾವಳೊ ಯೆಹೋವ ಮೇಸ್ ಕರಿ ತುಮೆ ಮಾಲುಮ್ ಕರಿಲ್ಯವಾನಿಘೋಣಿ ಆಸ್ ಮನಾಬಿ ತುಮುನಾಬಿ ತುಮಾರ ಪಿಳ್ಗಿವಾಳನ ಬೀಚ್ಮ ರ‍್ಹವಾನಿ ಖ್ಹಣೇದ್. <verse eid="EXO 31:13" /><verse number="14" style="v" sid="EXO 31:14" />ಇನಖ್ಹಾಜೆ ತುಮೆ ಸಬ್ಬತ್ ದನ್ನ ಪರಿಶುದ್ಧ್ ದನ್‌ಕರಿ ಚ಼ಲಾವ್ಣು. ಇನ ಮೈಲುಕರವಾಳ ಹರೇಕ್‌ಜ಼ಣಾನ ಮರಣ್ಣಿ ನಿಶತ್‌ಹೋಣು. ಯೊ ದನ್‌ಮ ಖಿವೊತೋಬಿ ಕಾಮ್ ಕರ‍್ಯೊತೊ ಇನ ಅದ್ಮಿವೋಮಾಥು ಕಾಡಿನಾಕ್ಣು. <verse eid="EXO 31:14" /><verse number="15" style="v" sid="EXO 31:15" />ಛೋ಼ ದನ್ ಕಾಮ್‌ ಕರೆಜಾ಼ಯ್. ಖ್ಹಾತ್‌ನೊ ದನ್ ಅರಾಮ್‌ಕರಾನೊ ಸಬ್ಬತ್ ದನ್ ಹುಯಿರ‍್ಹೊಸ್. ಯೊ ಯೆಹೋವನ ಪರಿಶುದ್ಧ್‌ನೊ ದನ್. ಅಥ್ರಾನ ಸಬ್ಬತ್ ದನ್‌ಮ ರಾಬವಳನ ಮರಣ್ಣಿ ನಿಶತ್‌ಹೋಣು. <verse eid="EXO 31:15" /><verse number="16" style="v" sid="EXO 31:16" />ಇನಖ್ಹಾಜೇಥಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಸಬ್ಬತ್ ದನ್ನ ಚ಼ಲಾವ್ಣು. ಆ ಚ಼ಲಾವನು ಇವ್ಣುನಬಿ, ಇವ್ಣ ಪಿಳ್ಗಿವಾಳನಬಿ ಹಮೇಶಾನು ಒಪ್ಪಂದಾನ ಹುಯಿರ‍್ಹುಸ್. <verse eid="EXO 31:16" /><verse number="17" style="v" sid="EXO 31:17" />ಆ ಮನಾಬಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳನಬಿ ಬೀಚ್ಮ ರ‍್ಹವಾನು ಶತಾಕಾಲನು ಖ್ಹಣೇದ್. ಶನಕತೊ ಛೋ಼ ದನ್ಮ ಯೆಹೋವನೆ ಆಬ್ ಧರ್ತಿವ್ನ ಉಬ್‌ಜ಼ೈನ್ ಖ್ಹಾತ್‌ನ ದನ್ಮ ಕಾಮ್ ಕರ‍್ಯೊಕೊಂತೆ ಅರಾಮ್ ಕರ‍್ಯೊಕೊಯ್ನಿಕಿಶು” <verse eid="EXO 31:17" /><verse number="18" style="v" sid="EXO 31:18" />ಯೆಹೋವನೆ ಸೀನಾಯಿ ಪಹಾಡ್‌ಮ ಮೋಶೆನ ಜೋ಼ಡೆ ವಾತೆಬೋಲಾನು ಖತಮ್‌ಕರಿನ್ ಇನ ಯೊ ಬೇ ಹುಕುಮ್‌ನ ಬಂಡಾನ ಪಲ್ಗಾನ ದಿದೊ. ಯೊಅಖ್ಖು ದೇವ್ನ ಹಾತೇಖ್ಹು ಲಿಖಾಯುತೆ ಖೊಡ್‍ಶನ ಪಲ್ಗುಹುಯಿರ‍್ಹುಸ್.<verse eid="EXO 31:18" /></para>
  <chapter eid="EXO 31" />
  <chapter number="32" style="c" sid="EXO 32" />
  <para style="s">ಖ್ಹೊನ್ನಾನೊ ಕೆಲ್ಡೊ</para>
  <para style="r">(<ref loc="DEU 9:6-29">ಧರ್ಮೊ 9:6-29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 32:1" />ಮೋಶೆನೆ ಪಹಾಡ್‌ಪರ್‌ಥು ಉತ್ರಿ ಆವಾಮ ಧೇರ್‌ಹುವಾನು ದೇಖಿನ್, ಆರೋನಕನ ಎಕ್ಟು ಮಳಿನ್ ಅಯಿನ್ ಇನ, “ಉಟ್ ಹಮುನ ಅಗ್ಗಳ್ ಚ಼ಲೈಲಿನ್ ಜಾ಼ವನ ಹಮುನ ಎಕ್ ದೇವ್‌ಖ್ಹಾರು ಕರಿನ್‌ ದೇ ಶನಕತೊ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಹಮುನ ಬುಲೈಲಿನ್ ಆಯೊತೆ ಯೊ ಮೋಶೆ ಶಾತ್‌ಹುಯೊಕರಿ ಮಾಲುಮ್ ಕೊಯ್ನಿ” ಕರಿ ಬೋಲ್ಯು. <verse eid="EXO 32:1" /><verse number="2" style="v" sid="EXO 32:2" />ಇನ ಆರೋನನೆ ಇವ್ಣುನ, “ತುಮಾರಿ ಬಾವ್ಣೆನು ಅಜು಼ ಛಿಯ್ಯಾ ಛೋ಼ರಿಯೇವ್ನ ಕಾನ್‌ಮ ಘಾಲಿರಾಖ್ಯುತೆ ಖ್ಹೊನ್ನಾನ ಕಾಪ್‌ನ ಛೋ಼ಡಿನ್ ಮನ ದೆವೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 32:2" /><verse number="3" style="v" sid="EXO 32:3" />ಇಮ್ಮಸ್‌ ಇವ್ಣೆಖ್ಹಾರುಬಿ ಇವ್ಣ ಇವ್ಣ ಕಾನ್‌ಮ ಥೂತೆ ಖ್ಹೊನ್ನಾನ ಕಾಪ್‌ಅಖ್ಖಾನ ಛೋ಼ಡಿನ್ ಆರೋನನ ಲಯಿನ್ ದಿದು. <verse eid="EXO 32:3" /><verse number="4" style="v" sid="EXO 32:4" />ಇನೆ ಯೊ ಖ್ಹೊನ್ನಾನ ಲೀನ್ ಜೈ಼ನ್ ಕೆಲ್ಡಾನಿ ಶಕಲ್‌ನ ಉಳಿಥಿ ರೂಪ್‌ದೀನ್ ಘಡಾಯೊ. ತದೆ ಇವ್ಣೆ “ಇಸ್ರಾಯೇಲ್‌ವಾಳವೊ ದೇಖೊ, ಆಸ್ ತುಮುನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಬುಲೈಲೀನ್ ಆಯೋತೆ ದೇವ್” ಕರಿ ಬೋಲ್ಯು.<verse eid="EXO 32:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 32:5" />ಆರೋನನೆ ಇನ ದೇಖಿನ್ ಯೊ ಕೆಲ್ಡಾನ ಖ್ಹಾಮೆ ಎಕ್ ಚ಼ಾಚ಼ರ್‌ನ ಭಂದೈನ್,</para>
  <para style="p" vid="EXO 32:5">“ಕಾಲೆ ಯೆಹೋವನ ಮರ‍್ಯಾದಿನಖ್ಹಾಜೆ ಜ಼ತ್ರಾಹೋಣು” ಕರಿ ಪ್ರಕಟ್‌ಕರ‍್ಯೊ. <verse eid="EXO 32:5" /><verse number="6" style="v" sid="EXO 32:6" />ಇನಖ್ಹಾಜೇಥಿ ಬಿಜೇಕ್ ದನ್ನ ವ್ಹಾಣೆ ಅದ್ಮಿಖ್ಹಾರು ಉಠಿನ್ ಭುಂಜಾ಼ನಿ ಬಲಿನಾಬಿ ಸಮಾಧಾನ್ನಿ ಬಲಿನಾಬಿ ಅರ್ಪಣ್ ಕರ‍್ಯು. ಇನವಾರ್ ಅದ್ಮಿಖ್ಹಾರು ಖಾವನಾಬಿ ಪಿಯಾನಾಬಿ ಬೇಖ್ಹಿಗು. ಇನಪಾರ್ ಉಠಿನ್ ಖೇಲ್‌ಕೂದ್ ಅಜು಼ ಮಜಾ಼ ಕರ‍್ಯು. <verse eid="EXO 32:6" /><verse number="7" style="v" sid="EXO 32:7" />ಅಮ್‍ರ‍್ಹಾವಮ ಯೆಹೋವನೆ ಮೋಶೆನ, “ತೂ ಪಹಾಡ್‌ಪರ್‌ಥು ಉತ್ರಿನ್ ಜಾ಼ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ತೂ ಬುಲೈಲಿನ್ ಆಯೋತೆ ತಾರು ಅದ್ಮಿಖ್ಹಾರು ಪಾಪ್‌ಕರೀನ್‌ ಬಿಗ್‌ಡಿಗಯು. <verse eid="EXO 32:7" /><verse number="8" style="v" sid="EXO 32:8" />ಮೇ ಇವ್ಣುನ ಹುಕುಮ್‌ ಕರ‍್ಯೊತೆ ಮಾರಗ್‌ನ ಇವ್ಣೆ ಒಗ್ಗಿಸ್ ಮೆಂಧಿನ್ ಜೈ಼ನ್ ಇವ್ಣುನ ಘಡಾಯಹುಯ ಖ್ಹೊನ್ನಾನ ಕೆಲ್ಡಾನ ಕರೈನ್ ಇನ ಆಡ್‍ಪಡಿನ್ ಬಲಿನ ಸಮರ್ಪಣ್‌ಕರಿನ್, ‘ಇಸ್ರಾಯೇಲ್‌ವಾಳವೊ ದೇಖೊ ಆಸ್ ತುಮುನ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಬುಲೈಲಿನ್ ಆಯೊತೆ ದೇವ್‌ಕರಿ ಬೋಲಿಲೆವ್‌ಕರಸ್‌” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 32:8" /><verse number="9" style="v" sid="EXO 32:9" />ಆನಾಹುಯಿನ್ ಯೆಹೋವನೆ ಮೋಶೆನ, “ಆ ಅದ್ಮಿವ್‌ನ ಸ್ವಭಾವ್‌ನ ದೇಖಿನ್‌, ಆ ಅದ್ಮಿಖ್ಹಾರು ಕೆತ್ರೆ ಮೊಂಡ್‌ ಬುದ್ದಿವಾಳು ಹುಯಿರ‍್ಹುಸ್ ಕರಿ ಮನ ಮಾಲುಮ್‌ ಹುಯಿರ‍್ಹುಸ್. <verse eid="EXO 32:9" /><verse number="10" style="v" sid="EXO 32:10" />ಇನಖ್ಹಾಜೆ ತೂ ಮನ ಥಮಾವ್‌ನಕೊ. ಮಾರಿ ಖೀಜ಼್‌ನಿ ಆಗ್ ಲಾಗಾದೆ, ಇವ್ಣುನ ನಾಶ್‌ಕರಿನಾಖುಸ್. ಇನವಾರ್ ತಾರೆಥೀಸ್ ಎಕ್ ಮೋಟಿ ಪಿಳ್ಗಿನ ಬಣೈಷ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 32:10" /><verse number="11" style="v" sid="EXO 32:11" />ತದೆ ಮೋಶೆ ಇನೊ ದೇವ್ ಯೆಹೋವನ ಗಿಂಗೈನ್, “ಯೆಹೋವದೇವ್ ತೂ ಮಹಾನ್ ಶಕಥ್ಥಿಬಿ, ಭುಜ಼್‌ನಿ ತಾಖಥ್ಥಿಬಿ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಭಾರ್‌ ಬುಲೈಲಿನ್ ಆಯೋತೆ ತಾರ ಪ್ರಜೆಪರ್ ಖೀಜ಼್‌ಥಿ ತೂ ಖೀಜ಼್‌ಕರೆಜಾ಼ಯ್‌ ಕಿಶು?<verse eid="EXO 32:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 32:12" />ಈಜಿಪ್ಟ್‌ವಾಳು ತಾರಿ ಬಾರೇಮ, ‘ಯೆಹೋವ ಕೇಡ್ ಕರ‍್ನುಕರಿ ಖ್ಹೂಜ಼್‌ಥೀಸ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಹಜ್ಜಾ಼ಥು ಬುಲೈಲಿನ್ ಗಯೋನಿ. ಇವ್ಣುನ ಪಹಾಡ್‌ಮ ಮಾರಿನಾಖನಬಿ ಧರ್ತಿಥು ಕಾಡಿನಾಖನಖ್ಹಾಜೆಬಿ ಇವ್ಣುನ ಬುಲೈಲಿನ್ ಗಯೊಕರಿ ಬೊಲೈಲಾವನು ಶನ?’ ತೂ ಇರಾದನ ಮೆಂಧಿನ್ ತಾರ ಪ್ರಜೆನ ಕೇಡ್ ನಾಕರ‍್ನುತೆ ದಿಲ್ನ ಫರೈಲೆ. <verse eid="EXO 32:12" /><verse number="13" style="v" sid="EXO 32:13" />ತಾರ ಸೇವಕ್ ಹುಯಿರ‍್ಹಾತೆ ಅಬ್ರಹಾಮ್, ಇಸಾಕ್ ಅಜು಼ ಯಕೋಬ್ ಇವ್ಣುನ ಯಾದ್ಮ ಲ್ಯಾವ್. ತೂ ತಾರ ಜಾನ್‌ಪರ್ ಆಣ್ ಕರಿನ್ ಇವ್ಣುನ, ‘ಮೆ ತುಮಾರಿ ಪಿಳ್ಗಿನ ಭಡೈನ್ ಆಬ್ ಶುಕ್ಕರ್‌ಯೆತ್ರು ಗಣ್ತಿಕೊಂತೆ ಆ ತಬರ್‌ಖಾವ್ನ ತುಮಾರಿ ಪಿಳ್ಗಿವಾಳನ ದಿಶ್‌ಕರಿಬಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಆ ದೇಖ್ಹ್‌ನ ಹಮೇಶಾಥಿ ಇವ್ಣಿ ಕಬ್‌ಜಾ಼ಮ ಕರಿಲಿಶೆ ಕರಿಬಿ ಜಿಭಾನ್ ದಿದೊಕೊಯ್ನಿಕಿಶು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 32:13" /><verse number="14" style="v" sid="EXO 32:14" />ತದೆ ಯೆಹೋವನೆ ಇನಿ ಪ್ರಜೆನ ಕರೀಶ್‌ಕರಿ ಇನೆ ಬೋಲ್ಯೊತೆ ಕೇಡ್‌ನಿ ಬಾರೇಮ ಮನ್ ಫರೈಲಿದೊ. <verse eid="EXO 32:14" /><verse number="15" style="v" sid="EXO 32:15" />ಯೊ ಹುಕುಮ್‌ನ ಬೇ ಖೊಡ್‍ಶನ ಪಲ್ಗಾವ್‌ನ ಮೋಶೆನೆ ಹಾತ್‌ಮ ಧರಿಲಿನ್ ಪಹಾಡ್‌ಪರ್‌ಥೊ ಉತ್ರಿನ್ ಆಯೊ. ಯೊ ಪಲ್ಗಾವ್‌ನ ಭೇಬಾಜು಼ಬಿ ಒಪಂದಾನಖ್ಹಾರು ಲೀಖೈರ‍್ಹುಥು. <verse eid="EXO 32:15" /><verse number="16" style="v" sid="EXO 32:16" />ಯೊ ಖೊಡ್‍ಶನ ಪಲ್ಗುಅಖ್ಖು ದೇವ್ನು ಕಾಮಸ್ ಹುಯಿರ‍್ಹಿನ್ ಯೊ ಲಿಖ್ಯುಅಖ್ಖು ದೇವ್ನೆಸ್ ಲೀಖಿಹುಯು ಹುಯಿರ‍್ಹುಥು. <verse eid="EXO 32:16" /><verse number="17" style="v" sid="EXO 32:17" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಖುಷಿಥಿ ಚಿಕ್ರಾಣ್ ಮಾರುಕರಾನು ಯೆಹೋಶುವನೆ ಖ್ಹಮ್‌ಜಿನ್, “ಇಟಾರಭಣಿಥು ಜಂಗ್‌ನೊ ಅವಾಜ಼್‌ ಖ್ಹಮಜ಼್ ಪಡುಕರಸ್”ಕರಿ ಮೋಶೆನ ಬೊಲ್ಯೊ.<verse eid="EXO 32:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 32:18" />ಇನ ಮೋಶೆನೆ, “ಮನ ಖ್ಹಮಜ಼್ ಪಡುಕರಸ್ತೆ ಜೂತಾನು ಅವಾಜ಼್‌ಬಿ ಕಾಹೆ, ಜಯಕಾರ್‌ನು ಗೀದ್‌ಬಿ ಕಾಹೆ ಹರಿಜಾ಼ವಳಾನಿ ಅವಾಜ಼್‌ನು ಗೀದ್‌ಬಿ ಕಾಹೆ, ಗೀದ್‌ ಬೋಲವಾಳನು ಖುಷಿನು ಗಳುಸ್ ಹುಯಿರ‍್ಹುಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 32:18" /><verse number="19" style="v" sid="EXO 32:19" />ಮೋಶೆನೆ ಇಟಾರಮ್‌ನ ಖನ್ನೆ ಅಯಿನ್ ಯೊ ಕೆಲ್ಡಾನಬಿ ಅಜು಼ ಅದ್ಮಿಯೇವ್ನು ಖೇಲಾನುಬಿ ದೇಖಖ್ಹತರ್ ಘಣು ಖೀಜ಼್‌ಖೈನ್ ಹಾತ್‌ಮ ಥೂತೆ ಖೊಡ್‍ಶನ ಪಲ್ಗಾವ್ನ ಪಹಡ್‌ನಿ ಝೋ಼ಕ್‌ಮ ಭಿರ್‌ಕೈನ್ ಫೋಡಿನಾಖ್ಯೊ. <verse eid="EXO 32:19" /><verse number="20" style="v" sid="EXO 32:20" />ಅದ್ಮಿಯೆವ್‌ನೆ ಕರೈರಾಖ್ಯುಥುತೆ ಕೆಲ್ಡಾನ ಇನೆ ಆಗ್‌ಥಿ ಬಾಳಿನ್ ವಾಟಿನ್ ಪುಡಿ-ಪುಡಿ ಕರಿನ್ ಪಾಣಿಮ ಕಲೈನ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಯೊ ಪಾಣಿನ ಪಿಡಾಯೊ. <verse eid="EXO 32:20" /><verse number="21" style="v" sid="EXO 32:21" />ತದೆ ಮೋಶೆನೆ ಆರೋನ್ನ, “ತೂ ಆ ಅದ್ಮಿಯೇವ್‌ಥಿ ಮೋಟಿ ಅಪರಾದ್ನ ಕರೈನಾಖ್ಯೊನಿ ಅಮ್ ಕರಾವನ ಅವ್ಣೆ ತುನ ಶಾತ್‌ಕರ‍್ಯು?” ಕರಿ ಫುಚಾ಼ವಮ, <verse eid="EXO 32:21" /><verse number="22" style="v" sid="EXO 32:22" />ಆರೋನನೆ, ಯಜಕ್ ಇರಾದೊ ನಕೊಕರ್. ಆ ಅದ್ಮಿಖ್ಹಾರು ಕೆಥ್ರಾನು ಖರಾಬ್ ಸ್ವಭಾವ್‌ನುಕರಿ ತುನಾಸ್ ಮಾಲುಮ್ ಛಾ಼. <verse eid="EXO 32:22" /><verse number="23" style="v" sid="EXO 32:23" />ಇವ್ಣೆ ಮಾರಕನ ಅಯಿನ್, ‘ಹಮುನ ಅಗ್ಗಳ್ ಚ಼ಲೈಲಿನ್ ಜಾ಼ವನ ಎಕ್ ದೇವ್ನ ಕರೈನ್‌ದೆ, ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಹಮುನ ಬುಲೈಲಿನ್ ಆಯೊತೆ ಮೋಶೆನ ಶಾತ್‌ಹುಯುಕಿ ಮಾಲುಮ್ ಕೊಯ್ನಿ’ ಕರಿ ಬೋಲ್ಯು. <verse eid="EXO 32:23" /><verse number="24" style="v" sid="EXO 32:24" />ಇನಖ್ಹಾಜೆ ಮೇ ‘ಕಿನಾಕನ ಖ್ಹೊನ್ನಾನು ಘೇಣು ಛಾ಼ಕಿ ಇವ್ಣೆಖ್ಹಾರುಬಿ ಇನ ಛೋ಼ಡಿನ್ ಮನ ದೇವ್ಣುಕರಿ’ ಕರಿ ಬೊಲ್ಯೊ. ಇವ್ಣೆ ಇಮ್ಮಸ್ ದ್ಯವಾನಿವಖ್ಹ್‌ತೆ ಮೇ ಯೊ ಖ್ಹೊನ್ನಾನ ಆಗ್‌ಮ ನಾಖಖ್ಹತರ್ ಯೊ ಕೆಲ್ಡಾನಿ ರೂಪ್ ಹುಯು” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="EXO 32:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 32:25" />ಮೋಶೆನೆ ಅದ್ಮಿಖ್ಹಾರು ಹದ್‌ಮಿರಿನ್ ಆವಸ್ತೆತಿಮ್ ಕರಾನಖ್ಹಾಜೆ ಆರೋನನೆ ಇವ್ಣುನ ಛು಼ಟು ಮ್ಹೇಲ್ಯೊತೆಖ್ಹಾಜೆ ಇನು ವಹೇರ‍್ಯುಖ್ಹಾರು ನಕ್ಲೆ ಕಾಡನಿಘೋಣಿ ಹುಯು. <verse eid="EXO 32:25" /><verse number="26" style="v" sid="EXO 32:26" />ಇವ್ಣೆ ತರಿಖ ಕೊಂತೆ ಇವ್ಣಿ ಮರ್ಜಿನಿಘೋಣಿ ಚಾ಼ಲನು ಮೋಶೆ ದೇಖಿನ್ ಇಟಾರಮ್‌ನ ಬಾಕಲ್‍ಕನ ಭೀರಿನ್, “ಯೆಹೋವ ಭಣಿವಾಳು ಮಾರಕನ ಆವ್ಣು” ಕರಿ ಬೊಲ್ಯೊ. ತದೆ ಲೇವಿನ ಖೂಮ್‌ವಾಳು ಖ್ಹಾರುಬಿ ಇನಕನ ಮಳಿನ್‌ ಆಯು. <verse eid="EXO 32:26" /><verse number="27" style="v" sid="EXO 32:27" />ಮೋಶೆನೆ ಇವ್ಣುನ, “ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ದೇವ್‌ಹುಯಿರ‍್ಹೊತೆ ಯೆಹೋವ ಹುಕುಮ್‌ಕರಾನು ಶಾತ್‌ಕತೊ, ‘ತುಮಾರಮ ಹರೇಕ್‌ಜ಼ಣೊಬಿ ತಲ್ವಾರ್‌ನ ಕಂಬರ್‌ನ ಭಾಂದಿಲಿನ್ ಇಟಾರಮ್‌ನ ಬೀಚ್ಮ ಎಕ್ ಬಾಕಲ್‌ಥು ಬಿಜೇಕ್ ಬಾಕಲ್‌ಲಗುಬಿ ಜಾ಼ತು ಆವ್ತು, ಇವ್ಣ ಇವ್ಣ ಭಯ್ಯೆ, ದೋಸ್ತಿ ಅಜು಼ ಖನ್ನೆವಾಳೊ ಕರಿ ಖ್ಹಾಯ್‌ ನಾಕರ‍್ನುತೆ ಅದ್ಮಿಯೇವ್ನ ಸಂಹಾರ್ ಕರ‍್ನು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 32:27" /><verse number="28" style="v" sid="EXO 32:28" />ಲೇವಿನು ಖೂಮ್‌ವಾಳು ಮೋಶೆನಿ ಹುಕುಮ್‌ನಿ ಪರಕಸ್ ಕರ‍್ಯು. ಯೊ ದನ್ಮ ಕಮ್‌ಶಿ ಕಮ್ ತೀನ್ ಹಜಾ಼ರ್‌ಜ಼ಣು ಮರೈಗು. <verse eid="EXO 32:28" /><verse number="29" style="v" sid="EXO 32:29" />ಮೋಶೆನೆ ಲೇವಿವಾಳನ, “ಆ ವಖ್ಹತ್ ತುಮಾರಮ ಹರೇಕ್‌ಜ಼ಣೊಬಿ ಛಿಯ್ಯೊ ರ‍್ಹಯುತೋಬಿ ಭಯ್ಯೆ ರ‍್ಹಯುತೋಬಿ ಖ್ಹಾಯ್ ನಾಕರ‍್ನುತೆ ತುಮುನ ಯೆಹೋವನಿ ಸೇವೆನ ನೇಮಕ್ ಕರಿಲೆವೊ. ಇನಖ್ಹಾಜೇಥಿ ಇನೆ ಆ ದನ್ ತುಮುನ ವಾರ್ಖ್ಹೊ ದಿಶೆ” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="EXO 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 32:30" />ಅಜೇಕ್ ದನ್ಮ ಮೋಶೆನೆ ಅದ್ಮಿನ, “ತುಮೆ ಮೊಟು ಪಾಪ್ ಕರಿರಾಖ್ಯಸ್. ರ‍್ಹಿಯುತೋಬಿ ಮೆ ಪಹಾಡ್‌ನ ಛ಼ಡಿನ್ ಯೆಹೋವನಿ ಮ್ಹೋರೆ ಜೈ಼ಶ್. ಎಕ್ ವಖ್ಹತ್ ತುಮೆ ಕರ‍್ಯಾತೆ ಪಾಪ್ನಕಾಮ್ನ ಮಾಫಿ ಮೇ ಮಾಂಗೆಜಾ಼ಯ್‌ಕಿಶುಕಿ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 32:30" /><verse number="31" style="v" sid="EXO 32:31" />ತದೆ ಮೋಶೆ ಯೆಹೋವಕನ ಪಾಛೊ಼ ಜೈ಼ನ್, “ಅಯ್ಯೊ ಆ ಅದ್ಮಿಖ್ಹಾರು ಮೊಟು ಪಾಪ್ ಕರಿರಾಖ್ಯುಸ್. ಖ್ಹೊನ್ನಾನು ಕೆಲ್ಡಾನ ಕರಿನ್ ದೇವ್‌ಕರಿ ಲಹಿರಾಖ್ಯುಸ್. <verse eid="EXO 32:31" /><verse number="32" style="v" sid="EXO 32:32" />ಕತೋಬಿ ತೂ ಗೋರ್‌ಕರಿನ್ ಇವ್ಣಿ ಪಾಪ್ನ ಮಾಫಿಕರ‍್ನು. ನಾರ‍್ಹಯುತೊ ತುನೆ ಲೀಖಿರಾಖ್ಯೊತೆ ಜಿವ್ತಜಾನ್ನು ಪುಸ್ತಕಥು ಮಾರ ನಾಮ್ನಬಿ ನೂಛಿನಾಕ್ಣು ಕರಿ ಬೋಲುಕರುಸ್” ಕರಿ ಪ್ರಾರ್ಥನೆ ಕರ‍್ಯೊ. <verse eid="EXO 32:32" /><verse number="33" style="v" sid="EXO 32:33" />ಇನ ಯೆಹೋವನೆ ಮೋಶೆನ, “ಕೋಣ್ ಮಾರಿ ವಾತ್ನ ಮೀರಿನ್ ಪಾಪ್‌ಕರ‍್ಯುಕಿ ಇವ್ಣ ನಾಮ್ನಾಸ್ ಮಾರಕನ್ ಛಾ಼ತೆ ಪುಸ್ತಕ್‌ಥು ಮೇ ನೂಛಿನಾಖಿಷ್. <verse eid="EXO 32:33" /><verse number="34" style="v" sid="EXO 32:34" />ತೂ ಹಜ್ಜಾ಼ಥು ನಿಕ್ಳಿನ್ ಮೇ ತುನ ಬೋಲ್ಯೊತೆ ದೇಖ್ಹ್‌ನ ಆ ಅದ್ಮಿಯೇವ್ನ ಚ಼ಲೈಲಿನ್ ಜಾ಼. ದೇಕ್, ಮಾರೊ ದೂತ ತುನ ಖ್ಹಾಮೆ ಅಗ್ಗಳ್ ಚ಼ಲಾವ್‌ಷೆ, ಕತೋಬಿ ಮಾರು ನ್ಯಾವ್ನ ತೀರ್ಪ್‌ನ ದನ್ಮ ಮೇ ಇವ್ಣ ಪಾಪ್ನ ಬರೊಬರ್‌ಥೀಸ್‌ ಇವ್ಣುನ ನಿಶತ್ ದಿಶ್.”<verse eid="EXO 32:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 32:35" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಆರೋನನ ಹಾಥ್ಥಿ ಯೊ ಖ್ಹೊನ್ನಾನು ಕೆಲ್ಡಾನ ಬಣಾಯೊತೆಖ್ಹಾಜೆ ಯೆಹೋವನೆ ಇವ್ಣುನ ನಿಶತ್ ದಿದೊ.<verse eid="EXO 32:35" /></para>
  <chapter eid="EXO 32" />
  <chapter number="33" style="c" sid="EXO 33" />
  <para style="s">ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಸಿನಾಯಿ ಪಹಾಡ್ ಮ್ಹೇಲಿನ್ ನಿಕಳ್‌ಣು ಕರಿ ಯೆಹೋವನಿ ಹುಕುಮ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 33:1" />ಯೆಹೋವನೆ ಮೋಶೆನ ಶಾತ್ ಬೋಲ್ಯೊಕತೊ, “ತೂ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಬುಲೈಲಿನ್ ಆಯೋತೆ ಆ ಅದ್ಮಿನ ತಾರ ಜೋ಼ಡೆ ಬುಲೈಲಿನ್ ಆ ಝ಼ಗೊನ ಮ್ಹೇಲಿನ್, ‘ಮೇ ಅಬ್ರಹಾಮ್, ಇಸಾಕ್, ಅಜು಼ ಯಕೋಬ್ ಇವ್ಣುನ ಅಜು಼ ತುಮಾರಿ ಪಿಳ್ಗಿವಾಳನ ದೆವುಸ್‌ಕರಿ’ ಕೋಲ್‌ನಾಮ್‌ ಕರ‍್ಯೊತೆ ದೇಖ್ಹ್‌ನ ನಿಕ್‌ಳಿಜಾ಼. <verse eid="EXO 33:1" /><verse number="2" style="v" sid="EXO 33:2" />ಮೇ, ತಾರೇಥಿಬಿ ಅಗ್ಗಳ್ ಎಕ್ ದೂತನ ಮೋಕ್ಲಿನ್ ಕಾನಾನ್ಯವಾಳನ, ಅಮೋರಿವಾಳನ, ಹಿತ್ತಿಯವಾಳನ, ಪೆರಿಜೀವಾಳನ, ಹಿವ್ವಿವಾಳನ ಅಜು಼ ಯೆಬೂಸಿವಾಳವ್ನ ಭಾರ್‌ ಕಾಡಿಷ್. <verse eid="EXO 33:2" /><verse number="3" style="v" sid="EXO 33:3" />ದೂದ್‌ಬಿ ಅಜು಼ ಶೇತ್‌ಬಿ ವ್ಹವಾನ ದೇಖ್ಹ್‌ಮ ತೂ ಜಾ಼. ಕತೋಬಿ ಮೆ ತುಮಾರ ಜೋ಼ಡೆ ಅಯಿಷ್‌ಕೊಯ್ನಿ, ಶನಕತೊ ತುಮೆ ಮೊಂಡಿ ಅದ್ಮಿಖ್ಹಾರು. ಮೇ ವಾಟ್‌ಮ ತುಮುನ ಮಾರಿತೋಬಿ ಮಾರಿನಾಖಿಷ್” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="EXO 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 33:4" />ಇಸ್ರಾಯೇಲ್ನು ಅದ್ಮಿಖ್ಹಾರು ಆ ದುಖ್‌ನಿ ವಾತೇವ್ನ ಖ್ಹಮ್‌ಜಿನ್ ದಿಲ್‌ಮ ದರದ್ ಕರ‍್ಯು. ಇನಾಮ ಏಕ್‌ಜ಼ಣುಬಿ ಘೇಣಾವ್ನ ಫೇರ‍್ಯುಕೊಯ್ನಿ. <verse eid="EXO 33:4" /><verse number="5" style="v" sid="EXO 33:5" />ಯೆಹೋವನೆ ಮೋಶೆನ ಅಮ್ ಬೊಲ್ಯೊ. “ತು ಇಸ್ರಾಯೇಲ್‌ವಾಳನ ಬೋಲಾನು ಶಾತ್‌ಕತೊ, ‘ತುಮೆ ಮೊಂಡಿ ಅದ್ಮಿಖ್ಹಾರು, ಮೇ ಎಕ್ ಘಡಿ ತುಮಾರಿ ಬೀಚ್ಮ ಆವನು ರ‍್ಹಯುತೊ, ಮೇ ತುಮುನ ಮಟೈನಾಖಿದಿಷ್. ಇನಖ್ಹಾಜೇಥಿ ತುಮಾರ ಖ್ಹೊನ್ನ ಖ್ಹರಪ್‌ನ ಹಮ್ಕೆ ಕಾಡಿನಾಖೊ. ತುಮುನ ಮೇ ಶಾತ್‌ ಕರ‍್ನುಕರಿ ಸೋಚುಸ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 33:5" /><verse number="6" style="v" sid="EXO 33:6" />ಇಮ್ನಿತರಸ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಹೋರೆಬ್<note caller="+" style="f"><char style="fr" closed="false">33:6 </char><char style="ft" closed="false">ಸೀನಾಯಿ ಪಹಾಡ್ನು ಬಿಜೇಕ್ ನಾಮ್ ಹೋರೆಬ್</char></note> ಪಹಾಡ್‌ಥು ನಿಕ್‌ಳ್ಯು ತದೆ ಇವ್ಣೆ ಘೇಣಾವ್ನ ಫೇರ‍್ಯುಕೊಯ್ನಿ.<verse eid="EXO 33:6" /></para>
  <para style="s">ದೇವ್ನ ದರ್ಶನ್ನೊ ಡೇರೊ</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 33:7" />ಮೋಶೆನೆ ಡೇರಾನ ಟಾಂಡಾನ ಭಾರ್‌ ದೂರ್‌ಮ ನಖಾವ್‌ತೊಥೊ. ಇನ ದೇವ್ನ ದರ್ಶನ್ನು ಡೇರೊ ಕರಿ ನಾಮ್‌ಮ್ಹೇಲ್ಯೊ. ಯೆಹೋವನಿ ಜ಼ವಾಬ್‌ನ ಆಖ್ಹ್‌ಕರವಾಳು ಖ್ಹಾರುಸ್‌ಬಿ ಟಾಂಡನ ಭಾರ್‌ಥೂತೆ ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾನ ಘರ್‌ಕನ ಜಾ಼ತುಥು. <verse eid="EXO 33:7" /><verse number="8" style="v" sid="EXO 33:8" />ಮೋಶೆನೆ ಯೊ ಘರ್‌ಮ ಜಾ಼ವನಿ ಖ್ಹಾರಿವಖ್ಹತ್‌ಬಿ ಅದ್ಮಿಖ್ಹಾರು ಉಠಿನ್ ಇವ್ಣ ಇವ್ಣ ಡೇರಾವ್ನು ಬಾಕಲ್‍ಕನ ಭೀರಿನ್, ಮೋಶೆ ಯೊ ಘರ್‌ಮ ಜಾ಼ವಲಗು ಇನ ದೇಕ್‌ತುಥು. <verse eid="EXO 33:8" /><verse number="9" style="v" sid="EXO 33:9" />ಮೋಶೆ ಯೊ ಘರ್‌ಮ ಜಾ಼ವನ ಬಾದ್‌ಮಸ್ ವಾದ್ಳಾನುಖಂಬು ಉತ್ರಿನ್, ಯೊ ಡೆರಾನ ಘರ್‌ನ ಬಾಕಲ್‌ಮ ಭಿರೇತುಥು ಅಜು಼ ಯೆಹೋವ ಮೋಶೆನ ಜೋ಼ಡೆ ವಾತೆ ಬೋಲ್ತೊಥೊ. <verse eid="EXO 33:9" /><verse number="10" style="v" sid="EXO 33:10" />ಯೊ ವಾದ್ಳಾನುಖಂಬು ಡೇರಾನ ಘರ್‌ನು ಬಾಕಲ್‍ಕನ ಭಿಯುರ‍್ಹವಾನು ದೇಖಿನ್ ಇವ್ಣ ಇವ್ಣ ಡೇರಾವ್ನ ಬಾಕಲ್‌ಕನಸ್ ಆಡುಪಡ್‌ತುಥು. <verse eid="EXO 33:10" /><verse number="11" style="v" sid="EXO 33:11" />ಏಕ್ಜ಼ಣೊ ಇನ ದೋಸ್ತಿನ ಜೋ಼ಡೆ ಕಿಮ್ ವಾತ್ ಬೋಲಸ್ಕಿ ಇಮ್ಮಸ್ ಯೆಹೋವ ದೇವ್ ಮೋಶೆನ ಜೋ಼ಡೆ ಆಮೆಖ್ಹಾಮೆ ವಾತೆ ಬೋಲ್ತೊಥೊ. ಇನಕೇಡೆಥು ಮೋಶೆ ಟಾಂಡನ ಪಾಛೊ಼ ಆವ್‌ತೊಥೊ; ಕತೋಬಿ ನೂನನೊ ಛಿಯ್ಯೊ ಯೆಹೋಶುವ ಕರಿ ನಾಮ್‌ನೊ ಜ಼ವಾನಿ ಏಕ್‌ಜ಼ಣೊ ಮೋಶೆನೊ ಶಿಷ್ಯಹುಯಿನ್ ಯೊ ಡೆರಾನ ಘರ್‌ಮಾಸ್ ರ‍್ಹೇತೊಥೊ, ಹಿಜ್ಜಾ಼ಥು ದೂರ್ ಕಿಜ್ಜಾ಼ಬಿ ಹಟ್ತೊಥೊಕೊಯ್ನಿ.<verse eid="EXO 33:11" /></para>
  <para style="s">ಅದ್ಮಿನ ಜೋ಼ಡೆ ರ‍್ಹವಾನಖ್ಹಾಜೆ ಯೆಹೋವನೆ ಕರ‍್ಯೊತೆ ವಾಗ್ದಾನ್</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 33:12" />ಮೋಶೆನೆ ಯೆಹೋವನ ಶಾತ್ ಬೊಲ್ಯೊಕತೊ, “ಆ ಅದ್ಮಿಖ್ಹಾರನ ಯೊ ಮುಲಕ್ನ ಚ಼ಲೈಲಿನ್ ಜಾ಼ವ್ಣುಕರಿ’ ತೂ ಮನ ಹುಕುಮ್ ಕರಿರಾಖ್ಯೊಸ್ ಎತ್ರೇಸ್. ಮಾರ ಜೋ಼ಡೆ ಖೆವಾನ ಮೋಕ್ಲಿಷ್‌ಕರಿ ಮನ ಬೋಲ್ಯೊಕೊಯ್ನಿ. ‘ಕತೋಬಿ ಮೆ ತುನ ಅಛ್ಛಿನಿತರ ಮಾಲುಮ್ ಕರಿರಾಖ್ಯೊಸ್. ತುನ ಮಾರಿ ದಯಾ ಮಳಿರ‍್ಹಿಸ್‌ಕರಿಬಿ’ ತುನೆ ಮನ ಬೋಲಿರಾಖ್ಯೊಸ್ನಿ. <verse eid="EXO 33:12" /><verse number="13" style="v" sid="EXO 33:13" />ಮಾರಪರ್ ಗೋರ್‌ರ‍್ಹವಾನು ಉಷೇತೊ ತಾರ ಮಾರಗ್‌ನ ಮನ ವತಾಳ್ ಮೇ ತುನ ಮಾಲುಮ್ ಕರಿಲ್ಯವಾನಿಘೋಣಿ ತಾರಿ ಕೃಪೇನ ಮನ ದಯಕರ್ ತದೆ ತಾರಿ ದಯಾ ಮನ ಮಳಿಕರಿ ಮನ ಮಾಲುಮ್‌ ಉಷೆ. ಆ ಮುಲಕ್‌ಖ್ಹಾರು ತಾರು ಪ್ರಜೆಕರಿ ಯಾದ್‌ಕರಿಲೆ” ಕರಿ ಹರ್ಕೆ ಕರ‍್ಯೊ. <verse eid="EXO 33:13" /><verse number="14" style="v" sid="EXO 33:14" />ತದೆ ಯೆಹೋವ ದೇವ್ನೆ, “ಮಾರಿ ಪ್ರಸನ್ನತೆ ತಾರಿ ಜೋ಼ಡ್ಮ ಆವ್‌ಷೆ, ಮೇ ತುಮುನ ಅರಾಮ್‌ದಿಷ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 33:14" /><verse number="15" style="v" sid="EXO 33:15" />ಮೋಶೆನೆ ಇನ, “ತಾರಿ ಪ್ರಸನ್ನತೆ ಹಮಾರ ಜೋ಼ಡೆ ಆವನು ನಾರ‍್ಹಯುತೊ ಹಮುನ ಹಜ್ಜಾ಼ಥು ನಾ ಮೋಕಲ್‌ನು. <verse eid="EXO 33:15" /><verse number="16" style="v" sid="EXO 33:16" />ಮನಾಬಿ ತಾರಿ ಪ್ರಜೆ ಹುಯಿರ‍್ಹುತೆ ಅವ್ಣುನಾಬಿ ತಾರಿ ದಯೆ ಮಳ್ಯುಕರಿ ತೂ ಹಮಾರಿ ಜೋ಼ಡೆ ಆವಥಿಸ್ ಪಣ್ಕಿ ಬಿಜು಼ ಶನೇಥಿ ಮಾಲುಮ್ ಪಡ್‌ಶೆ? ಅನೇಥಿ ಮೇಬಿ ಅಜು಼ ತಾರು ಪ್ರಜೆಹುಯಿರ‍್ಹುತೆ ಅವ್ಣೆ ಧರ್ತಿಪರ್ ರ‍್ಹವಾನು ಬಿಜು಼ ಖ್ಹಾರುಸ್ ಅದ್ಮಿಯೆಥಿಬಿ ವಿಶೇಷ್‌ವಾಳುಕರಿ ಮಾಲುಮ್‌ಉಷೆ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 33:16" /><verse number="17" style="v" sid="EXO 33:17" />ಯೆಹೋವನೆ ಮೋಶೆನ, “ತುನ ಮಾರಿ ದಯೆ ಮಳಿರ‍್ಹವಾಥಿಬಿ, ಮೇ ತಾರ ನಾಮ್ನ ಮಾಲುಮ್ ಕರಿರಾಖ್ಯೊಸ್ತೆ ಖ್ಹಾಜೇಥಿಬಿ ತಾರಖ್ಹಾಜೆ ಆ ಕಾಮ್ನ ಕರುಸ್” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="EXO 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 33:18" />ಇನ ಮೋಶೆನೆ, “ತಾರಿ ಮಹಿಮೆನ ದಯಾಕರಿನ್ ಮನ ವತಾಳ್” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="EXO 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 33:19" />ಇನ ಪ್ರಭುನೆ, “ಮೇ ಮಾರಿ ಮಹಿಮೆನ ಉಜಾ಼ಖ್ಹ್‌ನ ಪೂರಾಥಿ ತಾರಖ್ಹಾಮೆ ಆವನಿಘೋಣಿ ಕರುಸ್. ಯೆಹೋವಕರಿ ಮಾರ ನಾಮ್ನು ಪೂರ ಮಹಿಮೆನ ತಾರ ಖ್ಹಾಮೆಕರಿಸ್ ಪ್ರಕಟ್‌ಕರಿಷ್. ಮೇ ಕಿನಪರ್ ದಯಾ ವತಾಳ್‌ನುಕರಿ ಛೂ಼ಕಿ ಇನಪರ್ ವತಾಳಿಶ್, ಕಿನ ಗೋರ್‌ಕರ‍್ನುಕರಿ ಛೂ಼ಕಿ ಇನ ಗೋರ್‌ ಕರಿಶ್” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 33:19" /><verse number="20" style="v" sid="EXO 33:20" />ಕತೋಬಿ ಪ್ರಭುನೆ ಇನ, “ತೂ ಮಾರ ಮ್ಹೋಡಾನ ದೇಖಾನ ಕೊಉಷೇನಿ. ಶನಕತೊ ಅದ್ಮಿಯೇವ್ನ ಕೋಣ್ಬಿ ಮನ ದೇಖಿನ್ ಬಚ಼ಕೊಯ್ನಿ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 33:20" /><verse number="21" style="v" sid="EXO 33:21" />ಅಜು಼ ಯೆಹೋವನೆ ಇನ, “ದೇಕ್, ಹಜ್ಜಾ಼ ಮಾರ ಖನ್ನೆಸ್‌ ಎಕ್ ಝ಼ಗೊ ಛಾ಼. ತೂ ಆ ಬಂಡಾನ ಉಪ್ಪರಸ್ ಭಿಯೊರ‍್ಹೆ. <verse eid="EXO 33:21" /><verse number="22" style="v" sid="EXO 33:22" />ಮಾರಿ ಮಹಿಮೆ ಖ್ಹಾಮೆ ಉಲಾಂಗಿ ಜಾ಼ವನಿವಖ್ಹ್‌ತೆ ಮೇ ಆ ಬಂಡಾನಿ ಖೀಂಡಿಮ ತುನ ರಾಖಿನ್, ಮೇ ಖ್ಹಾಮೆ ಉಲಾಂಗಿ ಜಾ಼ವಲಗು ತುನ ಮಾರ ಹಾತೇಖ್ಹು ಮೂಚಿರಾಖಿಷ್. <verse eid="EXO 33:22" /><verse number="23" style="v" sid="EXO 33:23" />ಇನಕೇಡೆಥು ಮೇ ಮಾರ ಹಾತ್ನ ಕಾಡನಿ ವಖ್ಹ್‌ತೆ ತೂ ಮಾರ ಪೀಠೆ ದೇಖಿಶ್‌ ಪಣ್ಕಿ ಮಾರು ಮ್ಹೋಡು ತುನ ದೆಖಾವ್‌ಷೆ ಕೊಯ್ನಿ” ಕರಿ ಯೆಹೋವನೆ ಬೊಲ್ಯೊ.<verse eid="EXO 33:23" /></para>
  <chapter eid="EXO 33" />
  <chapter number="34" style="c" sid="EXO 34" />
  <para style="s">ಬೇನೆಹಲ್ಲನು ಬಂಡಾನು ಪಲ್ಗು</para>
  <para style="r">(<ref loc="DEU 10:1-5">ಧರ್ಮೊ 10:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 34:1" />ಯೆಹೋವನೆ ಮೋಶೆನ, “ತೂ ಪಹಿಲೆನ ಖೊಡ್‍ಶನ ಪಲ್ಗಾನಿಘೋಣಿ ಬಿಜೂ಼ಬಿ ಬೇ ಬಂಡಾನ ಪಲ್ಗಾವ್ನ ತಯಾರ್ ಕರಿಲೆ. ತೂ ಫೋಡಿನಾಖ್ಯೊತೆ ಯೊ ಪಹಿಲೆನ ಪಲ್ಗಾವ್‌ಪರ‍್ನು ವಚನ್‌ಅಖ್ಖಾನ ಆ ಪಲ್ಗಾವ್‌ಪರ್ ಮೇ ಲೀಖುಸ್. <verse eid="EXO 34:1" /><verse number="2" style="v" sid="EXO 34:2" />ವ್ಹಾಣೆ ತೂ ತಯಾರ್ ಹುಯಿನ್, ಸೀನಾಯಿ ಪಹಾಡ್‌ನ ಛ಼ಡಿನ್ ಹಿಜ಼್ಜಾ ಪಹಡ್‌ನಿ ನೋಕ್‌ನ ಉಪ್ಪರ್ ಮಾರ ಖ್ಹಾಮೆ ಭಿಯೊರ‍್ಹೇವ್ಣು. <verse eid="EXO 34:2" /><verse number="3" style="v" sid="EXO 34:3" />ಕೋಣ್‌ಬಿ ತಾರ ಜೋ಼ಡೆ ಪಹಾಡ್‌ಪರ್ ನಾ ಆವ್ಣು. ಆ ಪಹಾಡ್‌ಪರ್ ಕೋಣ್‌ಬಿ ಕಿಜ್ಜಾ಼ಬಿ ನಾದೆಖಾವ್ಣು; ಢಾಂಡು ಮೇಂಢುಬಿ ಪಹಾಡ್‌ಕನ ನಾಚ಼ರ‍್ನು” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="EXO 34:3" /><verse number="4" style="v" sid="EXO 34:4" />ಇನಖ್ಹಾಜೇಥಿ ಮೋಶೆನೆ ಪಹಿಲೆಥೂತೆ ಪಲ್ಗಾನಿತರ ಬೇ ಬಂಡಾನ ಪಲ್ಗಾವ್ನ ಟಕೈಲಿನ್, ಯೆಹೋವನ ಹುಕುಮ್‌ನಪರ್ ವ್ಹಾಣೆ ಉಠಿನ್ ಯೊ ಬೇ ಖೊಡ್‍ಶನ ಪಲ್ಗಾವ್ನ ಹಾತ್ಮ ಪಾಡಿಲಿನ್ ಸೀನಾಯಿ ಪಹಾಡ್‌ನ ಛ಼ಡ್ಯೊ. <verse eid="EXO 34:4" /><verse number="5" style="v" sid="EXO 34:5" />ತದೆ ಯೆಹೋವನೆ ಮೋಡ್‌ಮ ಉತ್ರಿನ್ ಅಯಿನ್ ಹಿಜ಼್ಜಾ ಇನ ಖನ್ನೆ ಭೀರಿನ್ ಯೆಹೋವಕರಿ ಇನ ಪರಿಶುದ್ದ ನಾಮ್ನ ಪ್ರಕಟ್‌ಕರ‍್ಯೊ. <verse eid="EXO 34:5" /><verse number="6" style="v" sid="EXO 34:6" />ಯೆಹೋವನೆ ಮೋಶೆನ ಖ್ಹಾಮೆಕರಿ ಜಾ಼ತೊಹುಯಿನ್ ಅಮ್ ಪ್ರಕಟ್ ಕರ‍್ಯೊಕಿ: ಯೆಹೋವಕರಿ ದೇವ್ ಗೋರ್‌ವಾಳೊಬಿ, ಕೃಪೆನೊಬಿ, ಧೇರ್‌ಥಿ ಇರಾದಕರವಾಳೊಬಿ, ಪ್ಯಾರ್‌ವಾಳೊ ಅಜು಼ ವಿಶ್ವಾಸ್‌ನೊ ದೇವ್‌ ಹುಯಿರ‍್ಹೊಸ್; <verse eid="EXO 34:6" /><verse number="7" style="v" sid="EXO 34:7" />ಹಜಾ಼ರೊ ಮುಂಡಿಲಗುಬಿ ಪ್ಯಾರ್‌ ಕರವಾಳೊ; ಖೋಟ್ ಖರಾಬಿನ ಪಾಪ್‌ಅಖ್ಖಾನ ಮಾಫಿಕರಾವಳೊ; ಕತೋಬಿ ಅಪರಾದಿವ್‌ನ ನಿಶತ್ ದಿಶೆಕೊಂತೆ ಮ್ಹೇಲ್‌ಶೆ ಕೊಯ್ನಿ; ಬಾನು ದೋಷ್‌ನು ಫಲ್ನ ತೀನ್ ಅಜು಼ ಚಾರ್‌ ಮುಂಡಿಲಗು ಲಡ್ಕಾನ್ ಲಡ್ಕಾವ್‌ಲಗುಬಿ ಲಿಆವಾಳೊ ಹುಯಿರ‍್ಹೊಸ್” ಕರಿ ಬೋಲನುಸ್. <verse eid="EXO 34:7" /><verse number="8" style="v" sid="EXO 34:8" />ಮೋಶೆ ತದೇಸ್‌ ಜ಼ಮಿನ್‌ಪರ್ ಆಡ್‌ಪಡಿನ್ ಆರಾದನೆ ಕರಿನ್, <verse eid="EXO 34:8" /><verse number="9" style="v" sid="EXO 34:9" />“ಪ್ರಭು, ತಾರಿ ನಜ಼ರ್‌ಮ ಮನ ದಯಾ ಮಳಿರ‍್ಹು ಉಷೇತೊ ತೂಸ್ ಹಮಾರ ಜೋ಼ಡ್ಮ ಆವ್ಣು. ಹಮಾರು ಅದ್ಮಿಖ್ಹಾರು ಮೊಂಡಿಸ್; ರ‍್ಹಿಯುತೋಬಿ ತೂ ಹಮಾರ ಪಾಪ್‌ಅಖ್ಖಾನ, ಖರಾಬ್‍ಕಾಮ್ನ ಮಾಫಿಕರಿನ್ ತಾರೊ ಶೊಂತ್ ಅದ್ಮಿಕರಿನ್ ಹಮುನ ಸ್ವೀಕಾರ್ ಕರ‍್ನು” ಕರಿ ಬೊಲ್ಯೊ.<verse eid="EXO 34:9" /></para>
  <para style="s">ಪಾಛು಼ ನವು ಒಪ್ಪಂದ ಕರ‍್ಯುತೆ</para>
  <para style="r">(<ref loc="EXO 23:14-19">ವಿಮೋ 23:14-19</ref>; <ref loc="DEU 7:1-5">ಧರ್ಮೊ 7:1-5</ref>; <ref loc="DEU 16:1-17">16:1-17</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 34:10" />ಯೆಹೋವನೆ ಶಾತ್ ಬೋಲ್ಯೊಕತೊ, “ಖ್ಹಮಜ಼್ ಮೇ ಎಕ್ ಒಪ್ಪಂದನ ಭೀರಾಖಿಷ್, ಜಗತ್‌ಮ ಕಿಜ್ಜಾ಼ಬಿ ಖೆವ ಜ಼ಗ್‌ಜಾ಼ತ್‌ಮಬಿ ಚಾ಼ಲ್ಯುಕೊಂತೆ ಮಹಾನ್ ಕಾಮ್ನ ತಾರು ಅದ್ಮಿಖ್ಹಾರು ದೆಖಾಖ್ಹರ್ಕು ಚ಼ಲೈಶ್. ತಾರ ಅಶ್‌ಪಿಶ್‌ನು ಖ್ಹಾರು ಅದ್ಮಿಬಿ ಯೆಹೋವ ಕರಾನ ಮಹಾನ್ ಕಾಮ್ನ ದೇಕ್‌ಶೆ. ಮೇ ತುಮಾರಿ ಬಾರೇಮ ಕರ‍್ನುಕರಿಛೂ಼ತೆ ಅದ್ಬುತ್‌ಹುಯಿರ‍್ಹುಸ್. <verse eid="EXO 34:10" /><verse number="11" style="v" sid="EXO 34:11" />ಮೇ ಆಜ಼್ ತುಮುನ ಹುಕುಮ್ ಕರುತೆಯಿನ ತುಮೆ ಪಾಡಿ ಚಾ಼ಲ್ನು. ಹಂದೇಕ್, ಮೇ ಅಮೋರಿವಾಳನ, ಕಾನಾನ್ಯವಾಳನ, ಹಿತ್ತಿಯವಾಳನ, ಪೆರಿಜೀವಾಳನ, ಹಿವ್ವಿವಾಳನ ಅಜು಼ ಯೆಬೂಸಿವಾಳನ ತುಮಾರ ಖ್ಹಾಮ್ಣೆಥು ನಖ್ಹಾಡಿದಿಶ್. <verse eid="EXO 34:11" /><verse number="12" style="v" sid="EXO 34:12" />ತುಮೆ ಜೈ಼ನ್ ಮಳಾನ ದೇಖ್ಹ್‌ನು ರ‍್ಹವಾಳನ ಜೋ಼ಡೆ ಖಿವಿ ಒಪ್ಪಂದನಬಿ ನಾ ಕರಿಲೇವ್ಣುತೆ ಹೊಷಾರ್‌ಥಿ ರ‍್ಹವೊ; ಇಮ್ ಕರಿಲಿದುತೊ ಯೊ ತುಮಾರ ಬೀಚ್ಮ ಫಾಖ್ಹೊಹುಯಿರ‍್ಹಿಷೆ. <verse eid="EXO 34:12" /><verse number="13" style="v" sid="EXO 34:13" />ತುಮೆ ಇವ್ಣು ಚಾ಼ಚ಼ರ್‌ನ ರಡ್‌ಕೈನ್‌ ಬಂಡಾನ ಖಂಬಾವ್ನ ಫೋಡಿನ್ ಅಶೇರ್ ಕರಿ ಮೂರತ್‌ನ ಖಂಬಾವ್ನ ಕತ್ರಿನಾಕ್ಣು. <verse eid="EXO 34:13" /><verse number="14" style="v" sid="EXO 34:14" />ತುಮೆ ಅಲಕ್ ದೇವ್ನ ಖ್ಹಾಮ್ಣೆ ನಾ ಆಡ್‌ಪಡ್ನು; ಶನಕತೊ ಶೊಂತ್‌ ಮರ‍್ಯಾದಿನ ನಾಮ್‌ರ‍್ಹವಾಳೊ ಯೆಹೋವ ದೇವ್ ಇನ ಮಳ್‌ಣುತೆ ಮರ‍್ಯಾದಿ ಬಿಜೇಕ್‌ ದೇವ್ನ ಮಳಾನ ಕೋ ಮ್ಹೇಲಾನಿ. <verse eid="EXO 34:14" /><verse number="15" style="v" sid="EXO 34:15" />ತುಮೆ ಯೊ ದೇಖ್ಹ್‌ನು ರ‍್ಹವಾಳನ ಜೋ಼ಡೆ ಒಪ್ಪಂದ ನಾ ಕರಿಲೇವ್ಣುತೆ ಹೊಶಾರ್‌ಥಿ ರ‍್ಹವೊ. ಕರಿಲಿದಾತೊ ಇವ್ಣೆ ಇವ್ಣ ದೇವ್ನ ಪೂಜ಼ಕರೀನ್ ಬಲಿ ಛ಼ಡಾಯಹುಯ ಖಾಣನ ತುಮುನ ಬುಲಾಯೆಜಾ಼ಯ್, ತದೆ ತುಮೆ ಜೈ಼ನ್ ಯೊ ಖಾವಖ್ಹರ್ಕು ಉಷೆ. <verse eid="EXO 34:15" /><verse number="16" style="v" sid="EXO 34:16" />ಅತ್ರೇಸ್ ಕಾಹೆತೆ ತುಮೆ ತುಮಾರ ಪರ್ಖ್ಹಾ ಲಡ್ಕಾನ ಇವ್ಣಮಾನಿ ತಯೇಡ ಛೋ಼ಕ್ರಿಯೆನ ಲ್ಯಾವಾನ ಯೊ ವಾಟ್‌ ಹುಯಿಜಾ಼ಶೆ; ಇನಪಾರ್ ಯೊ ವ್ಹವೆಖ್ಹಾರಿ ಆಯಬಾನ ದೇವ್ನ ಪೂಜ಼ಕರವಾಳಿ ಹುಯಿನ್ ತುಮಾರ ಛಿಯ್ಯವ್‌ನಾಬಿ ಅನ್ಯ ದೇವ್‌ನು ಪೂಜ಼ ಕರಿ ವ್ಯಬಿಚಾರ್‌ನ ಖೇಚಿಲಿಶೆ. ಇನಾಖ್ಹಾಜೆ ಜ಼ತನ್‌ಥಿರ‍್ಹವೊ. <verse eid="EXO 34:16" /><verse number="17" style="v" sid="EXO 34:17" />“ತುಮೆ ಟಕಾಯಹುಯು ದೇವ್‌ನು ಮೂರತ್‌ನ ನಾ ಕರಿಲೇವ್ಣು. <verse eid="EXO 34:17" /><verse number="18" style="v" sid="EXO 34:18" />“ಖಾಟುಕೊಂತೆ ರೋಟೊ ಖಾವನಿ ಜ಼ತ್ರಾ ಕರೊ. ಮೇ ತುಮುನ ಹುಕುಮ್ ಕರೂತೆ ಇಮ್ ತುಮೆ ಚೇತ್ರಿನ ಮಹಿನಾಮ ಖ್ಹಣೇದ್ ಹುಯಿರುತೆ ಹಗಾಮ್ಮ ಖ್ಹಾತ್ ದನ್‌ಲಗು ಖಾಟುಕೊಂತೆ ರೋಟನ ಖಾವ್ಣು. ಶನಕತೊ ತುಮೆ ಯೊ ಮಹಿನಾಮಸ್ ಈಜಿಪ್ಟ್ ದೇಖ್ಹ್‌ಥು ಛು಼ಟಿನ್ ಆಯತೆ. <verse eid="EXO 34:18" /><verse number="19" style="v" sid="EXO 34:19" />“ಪೈಲ್ಹೋಟು ಗರಬ್ನುಫಲ್ ಕತೊ, ತುಮಾರು ಢಾಂಡ ಬೋಕ್ಡಮ ಪೈದಹುವಾತೆ ಪೈಲ್ಹೋಟ ಚೆಲ್ಕವ್‌ಮ ಪರ್ಖ್ಹೊ ಹುಯಿರುತೊ ಯೊ ಮಾರುಸ್. <verse eid="EXO 34:19" /><verse number="20" style="v" sid="EXO 34:20" />ಗಧೇಡಾನ ಚೆಲ್ಕಾನ ಬದಲ್ ಮೇಂಢಾನ ಚೆಲ್ಕಾನ ದೀನ್ ಯೊ ಗಧೇಡಾನ ಚೆಲ್ಕಾನ ಛೋ಼ಡಯೆಜಾ಼ಯ್; ಇಮ್ ಛೋ಼ಡಾವನ ನಾಹುಯುತೊ ಇನು ಬೋಚಿ ತೋಡಿನ್ ಮಾರಿನಾಕ್ಣು. ಕತೋಬಿ ತುಮಾರು ಪೈಲ್ಹೋಟ ಪರ್ಖ್ಹಾ ಲಡ್ಕಾನ ಬದಲ್‌ದೀನ್‌ ಛೋ಼ಡೈಸ್‌ಲೇವ್ಣು.</para>
  <para style="p" vid="EXO 34:20">ಕೋಣ್‌ಬಿ ಖಾಲಿಹಾತೆ ಮಾರ ಖ್ಹಾಮ್ಣೆ ನಾ ದೆಖಾವ್ಣು.”<verse eid="EXO 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 34:21" />ಛೋ಼ ದನ್ ತುಮೆ ಕಾಮ್‌ ಕರೆಜಾ಼ಯ್. ಕತೋಬಿ ಖ್ಹಾತ್‌ನ ದನ್ನೆ ಶನಿ ಕಮೈಬಿ ನಾ ಕರ್ನು. ಯೊ ನಾಗ್ರಾನ ಹಗಾಮ್ ಹುಯಿರ‍್ಹವೋ, ವಢಾವ್ಣಿನ ಹಗಾಮ್‌ ಹುಯಿರ‍್ಹವೋ ಖ್ಹಾತ್‌ನೊ ದನ್ ಕಾಮ್‌ಕರವಾಳ ನಾರ‍್ಹೇವ್ಣು. <verse eid="EXO 34:21" /><verse number="22" style="v" sid="EXO 34:22" />“ಘವ್‌ನು ಪಿಕಾವ್ಣಿನು ಪಹಿಲು ಫಲ್ನ, ಪಸ್ಕ ಜ಼ತ್ರಾಹುಯಿನ್ ಥೋಡ ವಾರಾನ ಬಾದ್‌ಮ ಖ್ಹುಗ್ಗಿನಿ ಜ಼ತ್ರಾ ಕರಾನಿ ವಖ್ಹ್‌ತೆ ದೆವ್ಣು. ವರಖ್ಹ್‌ನ ಖ್ಹರ್ತಿನ ದನ್ಮ ಅನಾಜ಼್ ಜ಼ಮಕರಾನಿ ಜ಼ತ್ರಾನ ಕರ‍್ನು. <verse eid="EXO 34:22" /><verse number="23" style="v" sid="EXO 34:23" />ವರಖ್ಹ್‌ನ ತೀನ್ ವಖ್ಹತ್ ತುಮಾರಮಾನು ಪರ್ಖ್ಹಾ ಖ್ಹಾರೂಸ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ದೇವ್‌ಬಿ ಪ್ರಭು ಯೆಹೋವ ಹುಯಿರೋತೆ ಮಾರ ಖ್ಹಾಮ್ಣೆ ಆಯಿನ್, ಆರಾದನೆ ಕರ‍್ನು. <verse eid="EXO 34:23" /><verse number="24" style="v" sid="EXO 34:24" />ಮೇ ತುಮಾರ ಖ್ಹಾಮ್ಣೆಥು ಅನ್ಯ ಅದ್ಮೆವ್‌ನ ನಖ್ಹಾಡಿನ್ ತುಮಾರ ದೇಖ್ಹ್‌ನ ಫೈಲವುಸ್‌. ಅತ್ರೇಸ್ ಕಾಹೆತೆ ತುಮೆ ವರಖ್ಹ್‌ನ ತೀನ್ ವಖ್ಹತ್ ತುಮಾರೊ ದೇವ್ ಯೆಹೋವ ಹುಯಿರೋತೆ ಮಾರ ಖ್ಹಾಮ್ಣೆ ಆವಾನಿ ವಖ್ಹ್‌ತೆ ಕೋಣ್‌ಬಿ ತುಮಾರ ದೇಖ್ಹ್‌ನ ಕಬ್‌ಜ಼಼ಕರಾನ ಆಖ್ಹ್ ಕರ್‌ಶೆಕೊಯ್ನಿ.<verse eid="EXO 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 34:25" />“ಮನ ಬಲಿ ಅರ್ಪಣ್‌ಕರಾನಿ ವಖ್ಹ್‌ತೆ ಯೊ ಬಲಿನು ಜಾನ್ವರ್‌ನು ಲ್ಹೊಯಿಮ ಖಾಟೊ ಆಟಾನ ಮಳಾವ್ಣುನ. ಪಸ್ಕ ಜ಼ತ್ರಾಮ ತುಮೆ ಬಲಿ ದೇಸ್‌ತೆ ಬೋಟಿನ ಅಗ್‍ಲ್ಯ ದನ್ನು ವ್ಹಾಣುಹುವಾಲಗು ಉಭ್‌ರಾವ್ಣುನ. <verse eid="EXO 34:25" /><verse number="26" style="v" sid="EXO 34:26" />“ಜ಼ಮೀನ್ನು ಫೈಲು ಪಿಕಾವ್ಣಿಮಾನು ಅಛ್ಛು಼ ಭಾಗ್ನ ತುಮಾರೊ ದೇವ್ ಯೆಹೋವನ ಮಂದಿರ್‌ನ ಲೀನ್‌ ಆವ್ಣು. “ಬೋಕ್ಡಾನು ಚೆಲ್ಕಾನ ಇನಿ ಆಯಾನ ದೂದ್ಮ ನಾ ರ‍್ಹಾಂದ್‌ಣು.” <verse eid="EXO 34:26" /><verse number="27" style="v" sid="EXO 34:27" />ಯೆಹೋವನೆ ಮೋಶೆ, “ತೂ ಆ ವಚನ್ನ ಲೀಖ್, ಶನಕತೊ ಆ ವಚನ್ನಿ ಘೋಣಿ ತಾರಿಜೋ಼ಡ್ಮಾಬಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳನಿ ಜೋ಼ಡ್ಮಾಬಿ ಎಕ್ ಒಪ್ಪಂದ ಕರಿರಾಖ್ಯೋಸ್‌” ಕರಿ ಹುಕುಮ್ ಕರ‍್ಯೊ. <verse eid="EXO 34:27" /><verse number="28" style="v" sid="EXO 34:28" />ಮೋಶೆ ಯೊ ಪಹಾಡ್‌ಮ ರಾತ್‌ದನ್ ಚಾ಼ಳಿಖ್ಹ್‌ರೋಜ಼್‌ ಲಗೂಬಿ ಖಾಣುಪಾಣಿ ಮ್ಹೇಲಿನ್‌ ಯೆಹೋವನ ಖ್ಹಾಮ್ಣೆ ಥೊ. ಒಪ್ಪಂದನು ವಚನ್ನ, ಕತೊ ದಖ್ಹ್‌ ಹುಕುಮ್ನ ಯೊ ಖೊಡ್‍ಶನ ಪಲ್ಗಾವ್‌ಪರ್ ಇನೆ ಲೀಖ್ಯೊ.<verse eid="EXO 34:28" /></para>
  <para style="s">ಮೋಶೆ ಸೀನಾಯಿ ಪಹಾಡ್‌ಥೊ ಉತ್ರಿನ್ ಆಯೊತೆ</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 34:29" />ಮೋಶೆನೆ ಹುಕುಮ್‌ನು ಲೀಖ್ಯು ಹುಯಿರ‍್ಹುತೆ ಯೊ ಬೇ ಖೊಡ್‍ಶನ ಪಲ್ಗಾವ್‌ನ ಹಾತ್‌ಮ ಧರಿಲೀನ್ ಸೀನಾಯಿ ಪಹಾಡ್‌ಮಾಥೊ ಉತ್ರೀನ್ ಆವಾನಿವಖ್ಹ್‌ತೆ ಯೊ ಯೆಹೋವನಿ ಜೋ಼ಡ್ಮ ವಾತ್‌ಚೀತ್‌ ಬೋಲ್ಯೊಥೋತೆ ಇನಖ್ಹಾಜೆ ಇನು ಮ್ಹೋಡು ಉಜಾ಼ಖ್ಹ್‌ ಹುಯಿರೂಥು. ಕತೋಬಿ ಯೊ ಇನ ಮಾಲುಮ್ ಪಡ್ಯುಕೊಯ್ನಿ. <verse eid="EXO 34:29" /><verse number="30" style="v" sid="EXO 34:30" />ಮೋಶೆನು ಮ್ಹೋಡು ಉಜಾ಼ಖ್ಹ್‌ಹುಯಿರುತೆ ಆರೋನನೇಬಿ ಇಸ್ರಾಯೇಲ್‌ವಾಳಾನೆ ದೇಖಿನ್‌ ಇನ ಖನ್ನೆ ಆವಾನ ಡರಿಗಯು. <verse eid="EXO 34:30" /><verse number="31" style="v" sid="EXO 34:31" />ಕತೋಬಿ ಮೋಶೆನೆ ಆರೋನನಾಬಿ ಇವ್ಣ ಟಾಂಡಾನ ಗಲ್‌ಢಾನ ಇನಕನ ಬುಲಾಯೊ ಇವ್ಣೆ ಆಯು; ಮೋಶೆ ಇವ್ಣ ಜೋ಼ಡೆ ವಾತೆಬೋಲ್ಯೊ. <verse eid="EXO 34:31" /><verse number="32" style="v" sid="EXO 34:32" />ಇನಕೇಡೆಥು ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಇನಕನ ಆಯು. ಮೋಶೆನೆ ಯೆಹೋವದೇವ್‌ಕನ ಸೀನಾಯಿ ಪಹಾಡ್ನ ಉಪ್ಪರ್‌ ಲಿದೋತೆ ಹುಕುಮ್ನ ಇವ್ಣುನ ಬೊಲ್ಯೊ. <verse eid="EXO 34:32" /><verse number="33" style="v" sid="EXO 34:33" />ಮೋಶೆ ಇವ್ಣ ಜೋ಼ಡೆ ವಾತೆ ಬೋಲಿಹುಯಿಗು ತದೆ ಇನ ಮ್ಹೋಡಾನ ಉಪ್ಪರ್‌ ಘುಮ್‌ಟಾನ ನಾಖಿಲಿದೊ. <verse eid="EXO 34:33" /><verse number="34" style="v" sid="EXO 34:34" />ಮೋಶೆ ಯೆಹೋವನಿ ಜೋ಼ಡೆ ವಾತೆ ಬೋಲಾನ ಕದೆ ಇನಖ್ಹಾಮ್ಣೆ ಜಾ಼ತೊಥೋಕಿ ತದೆ ಯೊ ಘುಮ್‌ಟಾನ ನಾಖಿಲೆತೋಥೊ. ಭಾರ್‌ ಆಯೋತೊ ಕಾಡಿ ಮ್ಹೆಲಿದೆತೋಥೊ. ಯೊ ಭಾರ್‌ ಆಯೋತೊ ಯೆಹೋವನಿ ಹುಕುಮ್ನ ಇಸ್ರಾಯೇಲ್‌ವಾಳಾನ ಬೋಲ್ತೊಥೊ. <verse eid="EXO 34:34" /><verse number="35" style="v" sid="EXO 34:35" />ಮೋಶೆನು ಮ್ಹೋಡು ಉಜಾ಼ಖ್ಹ್‌ಹುಯಿರವಾನು ಇಸ್ರಾಯೇಲ್‌ವಾಳು ದೇಕ್‌ತುಥು. ಇನಖ್ಹಾಜೆ ಯೊ ಯೆಹೋವನ ಜೋ಼ಡೆ ವಾತೆಬೋಲಾನ ಜಾ಼ವಲಗೂಬಿ ಇನ ಮ್ಹೋಡಾನ ಉಪ್ಪರ್‌ ಯೊ ಘುಮ್‌ಟಾನ ಪಾಛೊ಼ ನಾಖಿಲೆತೋಥೊ.<verse eid="EXO 34:35" /></para>
  <chapter eid="EXO 34" />
  <chapter number="35" style="c" sid="EXO 35" />
  <para style="s">ಸಬ್ಬತ್‌ ದನ್ನಿ ನಿಯಮ್‌</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 35:1" />ಮೋಶೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳಾನ ಟೋಳ್‌ಕರಿನ್‌ ಇವ್ಣುನ, “ತುಮೆ ಅಮ್‌ಕರ‍್ನುಕರಿ ಯೆಹೋವದೇವ್ನೆ ತುಮೂನ ಹುಕುಮ್‌ ಕರಿರಾಖ್ಯೊಸ್. <verse eid="EXO 35:1" /><verse number="2" style="v" sid="EXO 35:2" />ಛೋ಼ ದನ್‌ಅಖ್ಖು ಕಾಮ್‌ಕರ‍್ನು; ಖ್ಹಾತ್‌ನೊ ದನ್ ಪರಿಶುದ್ದ ದನ್: ಯೊ ದನ್ ಯೆಹೋವನ ತನೀಯಛಾ಼ತೆ ಸಬ್ಬತ್‌ ದನ್‌ಹುಯಿರುತೆ ಇನಖ್ಹಾಜೆ ತುಮೆ ಕಾಮ್‌ ನಾಸ್‌ಕರ‍್ನು; ಯೊ ದನ್ನೆ ಕಾಮ್‌ಕರವಾಳನ ಮರಣ್ಣು ನಿಶತ್‌ಹೋಣು; <verse eid="EXO 35:2" /><verse number="3" style="v" sid="EXO 35:3" />ತುಮೆ ಜಿವ್ಣುಕರಾತೆ ಖೆವಿ ಝ಼ಗೋಬಿ ರ‍್ಹವೊ ಸಬ್ಬತ್‌ ದನ್ಮ ಆಗ್‌ನಾಬಿ ನಾ ಲಗಾಡ್‌ಣು ಕರಿ" ಬೊಲ್ಯೊ.<verse eid="EXO 35:3" /></para>
  <para style="s">ದೇವ್ನು ದರ್ಶನ್ನ ಡೇರಾನ ಹೋಣುತೆ ರಾಛು಼ಅಖ್ಖು</para>
  <para style="r">(<ref loc="EXO 25:1-9">ವಿಮೋ 25:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 35:4" />ಮೋಶೆನೆ ಇಸ್ರಾಯೇಲ್‌ನ ಹಿಡಿ ಟೋಳ್‌ವಾಳಾನ ಅಮ್‌ಬೋಲ್ಯೊಕಿ, “ಯೆಹೋವದೇವ್ನೆ ಹುಕುಮ್‌ಕರ‍್ಯೊತೆ ಶಾತ್‌ಕತೊ, <verse eid="EXO 35:4" /><verse number="5" style="v" sid="EXO 35:5" />ತುಮೆ ತುಮಾರ ತುಮಾರಮಸ್‌ ಯೆಹೋವನಖ್ಹಾಜೆ ಕಾಣ್ಕೆನ ಲೀಲೆವ್ಣು; ಅಛ್ಛಾ಼ ದಿಲ್‌ರ‍್ಹವಾಳು ಅಖ್ಖು ಕಾಣ್ಕೆನ ಲಯಿನ್ ದೇವ್ಣು. ಯೆಹೋವನ ದ್ಯವಾನು ಯೊ ಕಾಣ್ಕೆ ಕಿಮ್‌ರ‍್ಹೇವ್ಣುಕತೊ; ಖ್ಹೊನ್ನು, ರೂಪು, ತಾಂಬು; <verse eid="EXO 35:5" /><verse number="6" style="v" sid="EXO 35:6" />ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣೊ ರಂಗ್‌, ಲಲೇಲಾಲ್ ರಂಗ್‌ನು ಧಾಗೊಖ್ಹಾರುಬಿ, ಕೋರುಲುಂಗ್ಡು, ರುಯ್‌ನು ಲುಂಗ್ಡು, <verse eid="EXO 35:6" /><verse number="7" style="v" sid="EXO 35:7" />ಹದಕರಿಹುಯು ಲಾಲ್‌ರಂಗ್ನು ಮೇಂಢಾನು ಚಾ಼ಮ್ಡುಅಖ್ಖು, <note caller="+" style="f"><char style="fr" closed="false">35:7 </char><char style="ft" closed="false">ದರ‍್ಯಾವ್ನು ಡೂಕರ್‌ಕತೊ ಡಾಲ್ಫಿನ್ನಿಘೊಣಿ</char></note>ದರ‍್ಯಾವ್ನ ಡೂಕರ್‌ನು ಚಾ಼ಂಬ್ಡು, ಬಾವಳ್ಯನು ಝಾ಼ಡ್‌, <verse eid="EXO 35:7" /><verse number="8" style="v" sid="EXO 35:8" />ದೀವಾನ ಹೋಣುತೆ ತೇಲ್‌, ಅಭಿಷೇಕನ ಅಜು಼ ಅಛ್ಛಿ ವಾನುತೇಲ್‌ ಅಖ್ಖು, <verse eid="EXO 35:8" /><verse number="9" style="v" sid="EXO 35:9" />ಏಫೋದ್ ಪೇರ್‌ವಾಖ್ಹ್‌ನ ಹೋಣುತೆ ಗೋಮೇಧಕಅಖ್ಖು ಅಜು಼ ಮಹಾಯಾಜಕ್ನ ಛಾ಼ತಿನ ಪದಕ್ಮ ಲಗಾಡ್ನುತೆ ಹರೇಕ್‌ಥರಾನು ಹೀರೊಅಖ್ಖು.<verse eid="EXO 35:9" /></para>
  <para style="s">ಯೆಹೋವನ ಡೇರಾನು ಲಿಖ್ಯುಅಖ್ಖು</para>
  <para style="r">(<ref loc="EXO 39:32-43">ವಿಮೋ 39:32-43</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 35:10" />ತುಮಾರಮ ಛಾ಼ತೆ ಕಾಮ್‌ಕರಾವಳು ಅಕ್ಲಿಖ್ಹಾರು ಆಯಿನ್‌ ಯೆಹೋವನೆ ಹುಕುಮ್‌ಕರ‍್ಯೊತೆ ಅಖ್ಖಾನ ಕರ‍್ನು. <verse eid="EXO 35:10" /><verse number="11" style="v" sid="EXO 35:11" />ಇವ್ಣೆ ಕರ‍್ನುತೆ ಶಾತ್‌ಕತೊ; ದೇವ್ನು ದರ್ಶನ್ನು ಡೇರೊ, ಇನು ಢಾಪಾನು ಪಡ್ದೊಅಖ್ಖು, ಕೊಂಡಿಅಖ್ಖು, ಚೌಕಟ್ಅಖ್ಖು, ಗಡಅಖ್ಖು, ಖಮ್‌ಅಖ್ಖು, ಹುದಿನು ಬಂಡೊಅಖ್ಖು, <verse eid="EXO 35:11" /><verse number="12" style="v" sid="EXO 35:12" />ಹುಕುಮ್ನ ನಿಯಮ್ನು ಪಿಟಾರೊ, ಇನ ಢೊವಾನು ಲಠ್ಠಅಖ್ಖು, ಕೃಪಾಸನ , ಇನ ಓಠೊಕರಾನು ಪಡ್ದೊ, <verse eid="EXO 35:12" /><verse number="13" style="v" sid="EXO 35:13" />ಮೇಜ್‌, ಇನು ರಾಛು಼ಖ್ಹಾರು, ಇನ ಉಪ್ಪರ್ ಮ್ಹೇಲಾನು ಪರಿಶುದ್ ರೋಟೊ ಅಖ್ಖು, <verse eid="EXO 35:13" /><verse number="14" style="v" sid="EXO 35:14" />ದೀವಾನುಖಂಬು, ಇನು ಜಿನಖ್ಹ್‌ಖ್ಹಾರು, ದಿವಳ್ಗಿಅಖ್ಖು, ದೀವಾನ ಹೋಣುತೆ ತೇಲ್‌, <verse eid="EXO 35:14" /><verse number="15" style="v" sid="EXO 35:15" />ಢಾಕ್ಣಿ, ಇನು ಖಮ್‌ಅಖ್ಖು, ಅಭಿಷೇಕನು ತೇಲ್‌, ವಾಖ್ಹ್‌ನು ಢಪ್ಕಾರನುತೇಲ್‌, ಡೇರಾನು ದರ್ವಾಜ಼ನು ಪಡ್ದೊ, <verse eid="EXO 35:15" /><verse number="16" style="v" sid="EXO 35:16" />ಚಾ಼ಚ಼ರ್‌, ತಾಂಬಾನು ಖಾಂಜ್ರಿ, ಲಠ್ಠಅಖ್ಖು, ಜಿನಖ್ಹ್‌ಖ್ಹಾರು, ಹಾತ್‌ಧೊವಾನು ಕುಂಡು, ಇನಿ ಖುಡ್‌ಷಿ, <verse eid="EXO 35:16" /><verse number="17" style="v" sid="EXO 35:17" />ಯೊ ಝ಼ಗೋನು ಪಡ್ದೊಅಖ್ಖು, ಖಮ್‌ಅಖ್ಖು, ಮ್ಹೇಲಾನೊ ಬಂಡೊಅಖ್ಖು, ಬಲ್ಡಾನು ದರ್ವಾಜ಼ನು ಪಡ್ದೊ, <verse eid="EXO 35:17" /><verse number="18" style="v" sid="EXO 35:18" />ಡೇರಾನೊ ಖಿಲ್ಲೊಅಖ್ಖು, ಬಲ್ಡಾನು ಖಿಲ್ಲೊಅಖ್ಖು, ಇನು ಶಿಂದ್ರುಅಖ್ಖು, <verse eid="EXO 35:18" /><verse number="19" style="v" sid="EXO 35:19" />ಪವಿತ್ರ ಝ಼ಗೋನಿ ಸೇವೆನ ಹೋಣುತೆ ಶನ್‌ಗಾರ‍್ನು ಪೇರ್ವಾಖ್ಹ್‌ಅಖ್ಖು ಕತೊ ಮಹಾ ಯಾಜಕಹುಯಿರೊತೆ ಆರೋನನಾಬಿ ಇನ ಲಡ್ಕಾವ್‍ನಾಬಿ ಹೋಣುತೆ ಪವಿತ್ರ ಯಾಜಕ ಪೇರ್ವಾಖ್ಹ್‌ಅಖ್ಖು ಆಸ್" ಕರಿ ಬೊಲ್ಯೊ.<verse eid="EXO 35:19" /></para>
  <para style="s">ಅದ್ಮಿಖ್ಹಾರು ಲಾಯುತೆ ಇವ್ಣು ಕಾಣ್ಕೆ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 35:20" />ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಅಜು಼ ಟಾಂಡವಾಳು ಖ್ಹಾರು ಮೋಶೆನ ಖ್ಹಾಮ್ಣೆಥು ನಿಕ್ಳಿನ್‌, <verse eid="EXO 35:20" /><verse number="21" style="v" sid="EXO 35:21" />ಕಿನ ದಿಲ್‌ಮ ಬೋಲಾವಸ್ಕಿ, ಕಿನು ಮನ್‌ ತಯ್ಯಾರ್‌ಛಾ಼ಕಿ ಇವ್ಣೆಅಖ್ಖು ಆಯಿನ್‌ ದೇವ್ನ ದರ್ಶನ್ನು ಡೇರಾನ ಕಾಮ್ನಖ್ಹಾಜೇಬಿ ಇನು ಹರೇಕ್ ಸೇವೆನಾಬಿ, ಪವಿತ್ರ ಪೇರ್ವಾಖ್ಹ್‌ನಖ್ಹಾಜೇಬಿ ಯೆಹೋವನ ಕಾಣ್ಕೆನ ಲಾಯು. <verse eid="EXO 35:21" /><verse number="22" style="v" sid="EXO 35:22" />ಶುದ್ದ ದಿಲ್‌ನು ಪರ್‌ಖ್ಹೊ, ತಯೇಡಾಬಿ ಆಯಿನ್‌ ಯೆಹೋವನ ಖ್ಹೊನ್ನಾನು ಕಾಣ್ಕೆನಾಬಿ ಕತೊ ಕಾಕ್ಣು, ಕಾಪ್‌ಟೋಕ್ರಿ, ಅಂಗುಠಿ, ಗಳಾನಿಹಾರ್‌, ಖ್ಹೊನ್ನು ಖ್ಹರಪ್‌ನ ಸಮರ್ಪಣ್‌ ಕರ‍್ಯು. <verse eid="EXO 35:22" /><verse number="23" style="v" sid="EXO 35:23" />ಕಿನಾಮ ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣೊ ರಂಗ್ನು ಅಜು಼ ಲಲೇಲಾಲ್‌ ರಂಗ್ನು ಧಾಗೊಅಖ್ಖು, ಕೋರುಲುಂಗ್ಡು, ಬೋಕ್ಡಾನು ರುಯ್‌ನು ಲುಂಗ್ಡು, ಹದಕರಿಹುಯು ಲಾಲ್‌ರಂಗ್ನು ಮೇಂಢಾನು ಚಾ಼ಮ್ಡುಅಖ್ಖು ಅಜು಼ ದರ‍್ಯಾವ್ನ ಜಾನ್ವರ್‌ನು ಚಾ಼ಮ್ಡುಅಖ್ಖು ಥೂಕಿ ಇನಾಬಿ ಲಯಿನ್ ದಿದು. <verse eid="EXO 35:23" /><verse number="24" style="v" sid="EXO 35:24" />ಕಿನಾಕನ ರೂಪು ತಾಂಬುಥೂಕಿ ಇವ್ಣೆ ಇನಅಖ್ಖು ಲಯಿನ್ ಯೆಹೋವನ ದಿದು. ಕಿನಾಕನ ಡೇರಾನ ಕಾಮ್ನ ಹೋಣುತೆ ಬಾವಳ್ಯನು ಝಾ಼ಡುಥೂಕಿ ಇವ್ಣೆ ಇನ ಲಯಿನ್ ದಿದು. <verse eid="EXO 35:24" /><verse number="25" style="v" sid="EXO 35:25" />ಪುರ್ಗುಲ್‌ನಿ ತಯೇಡಖ್ಹಾರಿ ಇವ್ಣ ಹಾಥ್ಥಿ ನೀಲಿ ರಾಯ್‌ಜಾ಼ಮಣ್ಣೊ ರಂಗ್, ಲಲೇಲಾಲ್‌ ರಂಗ್ನು ಧಾಗೊಅಖ್ಖು, ಖ್ಹುತ್ತರ್‌ನ ಧಾಗನಾಬಿ ವಣಿನ್‌ ಯೊ ಧಾಗಾನ ಲಯಿನ್ ದಿದು. <verse eid="EXO 35:25" /><verse number="26" style="v" sid="EXO 35:26" />ಅಕ್ಲಿ ತಯೇಡಾಖ್ಹಾರಿ ಅಲಗ್‌ ತಯೇಡಖ್ಹಾರಿ ಬೋಕ್ಡಾನ ಕೇಖ್ಹ್‌ಥಿ ವಣಿನ್‌ ಲಯಿನ್ ದಿದಿಯೆ. <verse eid="EXO 35:26" /><verse number="27" style="v" sid="EXO 35:27" />ಅಧಿಪತಿಖ್ಹಾರು ಯಾಜಕನು ಏಫೋದ್‌ನ ಹೋಣುತೆ ಗೋಮೇಧಕ, ಹೀರೊಖ್ಹಾರು, ಛಾ಼ತಿನಿ ಪದಕ್ಮ ಘಾಲ್ನುತೆ ಹೀರೊಖ್ಹಾರನಾಬಿ, <verse eid="EXO 35:27" /><verse number="28" style="v" sid="EXO 35:28" />ದೀವನ ಹೋಣುತೆ ತೇಲ್ನಬಿ ಅಜು಼ ಅಬಿಷೇಕನ ತೇಲ್ನ ಅಜು಼ ವಾನತೇಲ್ನ ಅಖ್ಖುಲಾಯಿನ್‌ ದಿದು. <verse eid="EXO 35:28" /><verse number="29" style="v" sid="EXO 35:29" />ಮೋಶೆಥಿ ಯೆಹೋವನೆ ಹುಕುಮ್‌ಕರ‍್ಯೊತೆ ಅಖ್ಖು ಕಾಮ್ನಖ್ಹಾಜೇಬಿ ಇನ ಕಾಣ್ಕೆನ ಲಾಯಿನ್‌ದ್ಯವಾನ ದಿಲ್‌ಥಿ ಮಾನಿನ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಪರ್ಖ್ಹೊ ತಯೇಡಖ್ಹಾರುಬಿ ದಿಲ್‌ಥಿ ಲಯಿನ್ ದಿದು.<verse eid="EXO 35:29" /></para>
  <para style="s">ಯೆಹೋವನಿ ಸನ್ನಿಧಿಮ ಡೇರಾನು ಕಾಮ್‌ಕರವಾಳು</para>
  <para style="r">(<ref loc="EXO 31:1-11">ವಿಮೋ 31:1-11</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 35:30" />ಮೋಶೆನೆ ಇಸ್ರಾಯೇಲ್‌ವಾಳಾನ ಅಮ್‌ ಬೊಲ್ಯೊ, “ದೇಖೊ, ಯೆಹೋವನೆ ಯೆಹೂದ ಖೂಮ್‌ವಾಳು ಹುಯಿರೋತೆ ಹೂರನೊ ನಾತ್ಯೊಬಿ, ಊರಿಯನೊ ಛಿಯ್ಯೊಬಿ ಹುಯಿರೋತೆ ಬೆಚಲೇಲಕರಿ ನಾಮ್‌ವಾಳಾನ ನಾಮ್‌ ಧರಿನ್ ಚಿಕ್ರಿರಾಖ್ಯೊಸ್. <verse eid="EXO 35:30" /><verse number="31" style="v" sid="EXO 35:31" />ಇನ ದೇವ್ನ ಆತ್ಮನ ದೀನ್‌ ಇನ ಹೋಣುತೆ ಗ್ಯಾನ್, ಪಢಂತ್, ಖ್ಹಯಾಲ್ನನಾಬಿ ಹರೇಕ್ ಫುತ್‌ಳಾನು ಬಣಾವಟ್ನಿ ಗ್ಯಾನ್ನಾಬಿ ದೀರಾಖ್ಯೊಸ್‌, <verse eid="EXO 35:31" /><verse number="32" style="v" sid="EXO 35:32" />ಖ್ಹಾಜ಼್‌ಥಿ ಕರಾನ ಖ್ಹೊನ್ನು, ರೂಪು ಅಜು಼ ತಾಂಬಾಥಿ ಕಾಮ್‌ ಕರಾನಬಿ, <verse eid="EXO 35:32" /><verse number="33" style="v" sid="EXO 35:33" />ಹೀರಾನ ಬಣಾವಟ್‌ಕರಾನಾಬಿ, ಝಾ಼ಡೇಥಿ ಬಣಾವಟ್ ಕರಾನಬಿ, <verse eid="EXO 35:33" /><verse number="34" style="v" sid="EXO 35:34" />ಯೊ ಕೊಂತೆ ಬಿಜೇಕ್‌ಜ಼ಣಾನ ಶಿಕಾಡಿದ್ಯಾವನಬಿ ಇನಾಬಿ ಅಜು಼ ದಾನ್‌ ಖೂಮ್ನು ಅಹೀಸಾಮಾಕನೊ ಛಿಯ್ಯೊ ಒಹೋಲೀಯಾಬನಾಬಿ ಶಕತ್ ದೀರಾಖ್ಯೊಸ್‌. <verse eid="EXO 35:34" /><verse number="35" style="v" sid="EXO 35:35" />ಕೆತ್ತವಾಳೂಬಿ, ನೀಲಿ ರಾಯ್‌ಜಾ಼ಮಣ್ಣೊ ರಂಗ್ನು ಲಲೇಲಾಲ್‌ ರಂಗ್ನು ಧಾಗೇಥಿಬಿ, ಖ್ಹುತ್ತರ್‌ಥೀಬಿ ಬಣಾವಟ್ನು ಕಾಮ್‌ ಕರವಾಳುಬಿ, ವಣಾವಾಳೂಬಿ, ಅಖ್ಖು ಕಾಮ್ನ ಕರಾವಾಳಾನಾಬಿ ಯೆಹೋವನೆ ಇವ್ಣುನ ಗ್ಯಾನ್ನ ಘಣೇಥಿ ಘಣು ದಿದೊ.<verse eid="EXO 35:35" /></para>
  <chapter eid="EXO 35" />
  <chapter number="36" style="c" sid="EXO 36" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 36:1" />“ಬೆಚಲೇಲಬಿ ಅಜು಼ ಒಹೋಲೀಯಾಬ ಅಜು಼ ಅಲಕ್‌ ಅಕ್ಲಿಖ್ಹಾರು ಕತೊ ಯೆಹೋವಥಿ ಗ್ಯಾನ್ ಅಕ್ಕಲ್ನಲೀನ್‌ ಪವಿತ್ರ ದೇವ್ನಿ ಮಂದಿರ‍್ನ ತಯಾರ್ ಕರಾನ ಕಾಮ್ನ ಹೋಣುತೆ ಹರೇಕ್‌ಥರಾನು ರಾಛಾ಼ನ ಕರಾನ ತರಿಕಾನ ಮಾಲುಮ್‌ಕರವಾಳು, ಯೆಹೋವನೆ ಹುಕುಮ್‌ಕರ‍್ಯೊತೆ ಪರಕ್ಮಾಸ್ ಅಖ್ಖಾನಾಬಿ ಕರಸ್” ಕರಿಬೋಲ್ಯೊ.<verse eid="EXO 36:1" /></para>
  <para style="s">ಅದ್ಮಿಖ್ಹಾರು ದಿಲ್‌ಛೋ಼ಡಿನ್‌ ಕಾಣ್ಕೆನ ದಿದೂತೆ</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 36:2" />ಬೆಚಲೇಲಬಿ ಒಹೋಲೀಯಾಬಬಿ ಅಜು಼ ಕಿನ ದಿಲ್ಮ ಯೆಹೋವನೆ ಗ್ಯಾನ್ನ ದೀರಾಖ್ಯೊಸ್ಕಿ, ಕಿನಕಿನಾಬಿ ಆ ಕಾಮ್‌ಕರಾನ ದಿಲ್ಮ ಹುವಾಸ್ಕಿ ಎಥ್ರಾನವಾಳನ ಅಕ್ಲಿನಅಖ್ಖಾನ ಮೋಶೆನೆ ಇನ ಖನ್ನೆ ಬುಲಾಯೊ. <verse eid="EXO 36:2" /><verse number="3" style="v" sid="EXO 36:3" />ಇವ್ಣೆ ದೇವ್ನಿ ಮಂದಿರ‍್ನ ತಯಾರ‍್ನ ಕಾಮ್ನ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಲಾಯುತೆ ಕಾಣ್ಕೆಅಖ್ಖು ಮೋಶೆಥಿ ಲೀಲಿದು. ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಹರೇಕ್‌ದನ್ ವ್ಹಾಣವೇಳಿ ಮೋಶೆಕನ ಆಯಿನ್‌ ಕಾಣ್ಕೆನ ಶುದ್‍ ದಿಲ್‌ಥಿ ದೇತುಥು. <verse eid="EXO 36:3" /><verse number="4" style="v" sid="EXO 36:4" />ತದೆ ದೇವ್ನ ಮಂದಿರ‍್ನ ಕಾಮ್ನ ಕರ್ತುಥೂತೆ ಯೊ ಗ್ಯಾನಿಖ್ಹಾರು,ಇವ್ಣ ಇವ್ಣ ಕಾಮ್ನ ಮ್ಹೇಲಿನ್‌, <verse eid="EXO 36:4" /><verse number="5" style="v" sid="EXO 36:5" />ಮೋಶೆಕನ ಆಯಿನ್‌ ಇನ, “ಯೆಹೋವನೆ ಹುಕುಮ್‌ಕರ‍್ಯೊತೆ ಕಾಮ್ನ ಹೋಣುತೆ ಇಂಥಿಬಿ ಘಣು ಅದ್ಮಿಖ್ಹಾರು ಕಾಣ್ಕೆನ ಲ್ಯಾವ್ತುಥು ಕರಿ" ಬೋಲ್ಯು.<verse eid="EXO 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 36:6" />ತದೆ ಮೋಶೆನೆ ಇನ ದೇಖಿನ್, “ದೇವ್ನಿ ಮಂದಿರ‍್ನ ಕಾಮ್ನಖ್ಹಾಜೆ ಖಿವು ಪರ್ಖ್ಹೊರ‍್ಹೇವೊ ತಯೇಡರ‍್ಹೇವೊ ಇನಪಾರ್‌ ಕಾಮ್ನ ನಾಕರ‍್ನು" ಕರಿ ಹುಕುಮ್‌ಕರಿನ್‌ ಇನ ಟಾಂಡಾಮ ಫೈಲಾಯೊ. ಅದ್ಮಿಖ್ಹಾರು ಕಾಣ್ಕೆಅಖ್ಖಾನ ಲ್ಯಾವಾನು ಭೀರಾಖಿದಿದು. <verse eid="EXO 36:6" /><verse number="7" style="v" sid="EXO 36:7" />ಶನಕತೊ ಕಾಮ್ನಅಖ್ಖು ಕರಾನ ಹೋಣುತೆ ಎತ್ರೆಥೀಬಿ ಘಣು ರಾಛು಼ರ‍್ಹೇತುಥು.<verse eid="EXO 36:7" /></para>
  <para style="s">ಯೆಹೋವನಿ ಸನ್ನಿದಿಮ ಡೇರಾನ ಕರ‍್ಯುತೆ</para>
  <para style="r">(<ref loc="EXO 26:1-37">ವಿಮೋ 26:1-37</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 36:8" />ಯೊ ಕಾಮ್‌ ಕರುಕರ್ತುಥುತೆ ಗ್ಯಾನಿಖ್ಹಾರು ವಾಟ್ಯುಹುಯು ಖ್ಹುತ್ತರ್‌ನು ದಖ್ಹ್‌ ಪಡ್ದೇಥಿ ಡೇರಾನ ಕರಿನ್‌ ಯೊ ಪಡ್ದಾಮ ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣೊ ರಂಗ್ ಅಜು಼ ಲಲೇಲಾಲ್ ರಂಗ್‌ನ ಧಾಗೇಥಿ ವಣಾವಾಳನಿಘೋಣಿ ಕೆರೂಬಿಯೇವ್ನ ಕರಿನ್‌ ಇನ ಪುರ್ಗುಲ್‌ಥಿ ಶಿವಿನ್‌ ಬಣಾವಟ್‌ಕರ‍್ಯು. <verse eid="EXO 36:8" /><verse number="9" style="v" sid="EXO 36:9" />ಹರೇಕ್ ಪಡ್ದೊಬಿ ಆಟ್ ಉಪ್ಪರ್ ವೀಖ್ಹ್‌ ಹಾತ್ ಲಾಂಬುಬಿ ಚಾರ್ ಹಾತ್ ಚೌ಼ಡುಬಿ ಥು. ಅಖ್ಖುಸ್ ಪಡ್‌ದೊಖ್ಹಾರು ಶಮ ಆಳ್ತಿಮಥು. <verse eid="EXO 36:9" /><verse number="10" style="v" sid="EXO 36:10" />ಪಾಚ಼್-ಪಾಚ಼್ ಪಡ್‌ದಾವ್ನ ಏಕೇಕ್‌ ಕರಿನ್‌ ಎಕ್ಟುಕರ‍್ಯು. <verse eid="EXO 36:10" /><verse number="11" style="v" sid="EXO 36:11" />ಆ ಬೇ ಬಿಡ್ಕಿಮ ಏಕೇಕ್‌ನ ಕೋಣಾನ ಪಡ್ದಾನಿ ನೋಕ್‌ಮ, ನೀಲಿ ಧಾಗೇಥಿ ಫುಂದೊಕರ‍್ಯು. <verse eid="EXO 36:11" /><verse number="12" style="v" sid="EXO 36:12" />ಯೊ ಫುಂದಾವ್ನ ಅಢೈಖ್ಹ್‌ ಅಢೈಖ್ಹ್‌ನಿ ಪರಕ್ಮ ಏಕ್‌ಥಿಏಕ್‌ ಆಮೆಖ್ಹಾಮೆ ಮ್ಹೇಲ್ಯು. <verse eid="EXO 36:12" /><verse number="13" style="v" sid="EXO 36:13" />ಆಸ್ ಕಾಹೆತೆ ಅಢೈಖ್ಹ್ ಖ್ಹೊನ್ನಾನು ಅಖುಟಾವ್ನ ಕರೈನ್ ಯೊ ಪಡ್‌ದಾವ್ನ ಏಕ್‌ಥಿಏಕ್‌ ಬಿಡ್ಕಿಕರ‍್ಯು; ಅಮ್‌ ಯೊ ಎಕ್ಕಸ್ ಡೇರೊ ಹುಯು.<verse eid="EXO 36:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 36:14" />ಬೇಚಲೇಲನೆ ಡೇರಾನ ಉಪ್ಪರ್‌ ಢಾಪನಖ್ಹಾಜೆ ರುಯ್‌ನು ಗ್ಯಾರ‍್ಹ ಪಡ್ದೇಥಿ ಯೊ ಡೇರಾನ ಉಪ್‌ಲ್ಯ ಡೇರಾನ ಕರ‍್ಯು. <verse eid="EXO 36:14" /><verse number="15" style="v" sid="EXO 36:15" />ಏಕೇಕ್‌ ಪಡ್ದೊಬಿ ಡೋಡಿಖ್ಹ್‌ಹಾತ್‌ ಲಾಂಬುಬಿ ಚಾ಼ರ್‌ಹಾತ್‌ ಚೌ಼ಡುಬಿ ಥು; ಅಖ್ಖು ಪಡ್ದೊಬಿ ಎಕ್ಕಸ್‌ ಆಳ್ತಿನು ಥು. <verse eid="EXO 36:15" /><verse number="16" style="v" sid="EXO 36:16" />ಪಾಚ಼್ ಪಡ್‌ದಾವ್ನ ಎಕ್ಟು ಜೋ಼ಡ್‌ಕರಿನ್ ಉಭ್‌ರ‍್ಯುತೆ ಛೋ಼ ಪಡ್ದಾನಾಬಿ ಏಕೇಕ್‌ ಕರಿನ್‌ ಬಿಡ್ಕಿಕರ‍್ಯು. <verse eid="EXO 36:16" /><verse number="17" style="v" sid="EXO 36:17" />ಏಕೇಕ್‌ನ ಖ್ಹರ್ತಿನ ಪಡ್ದಾನ ಕೋಣಾನ ಅಢೈಖ್ಹ್‌ ಅಢೈಖ್ಹ್‌ ಫುಂದಾವ್ನ ಕರ‍್ಯು. <verse eid="EXO 36:17" /><verse number="18" style="v" sid="EXO 36:18" />ಎಕ್ಕಸ್‌ ಡೇರೊಹುವಾನಿಘೊಣಿ ಯೋಅಖ್ಖಾನ ಢೇರಿಕರಾನಖ್ಹಾಜೆ ತಾಂಬಾನಿ ಅಢೈಖ್ಹ್ ಅಖುಟಾವ್ನ ಕರ‍್ಯು. <verse eid="EXO 36:18" /><verse number="19" style="v" sid="EXO 36:19" />ಯೋಸ್ ಕಾಹೆತೆ ಹದಕರಿಹುಯು ಮೇಂಢಾನು ಚಾ಼ಂಬ್ಡಾವ್‌ಥಿ ಏಕ್‌ ಪರ್‌ಖೊಂಡನಾಬಿ ದರ‍್ಯಾವ್ನ ಜಾನ್ವರ್‌ನ ಚಾ಼ಂಬ್ಡಾವ್‌ಥಿ ಬಿಜೇಕ್‌ ಪರ್‌ಖೊಂಡನಾಬಿ ಕರ‍್ಯು. <verse eid="EXO 36:19" /><verse number="20" style="v" sid="EXO 36:20" />ಡೇರಾನ ಚೌಕಟ್ನ ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ಥಿ ಕರ‍್ಯು. <verse eid="EXO 36:20" /><verse number="21" style="v" sid="EXO 36:21" />ಹರೇಕ್ ಚೌಕಟ್‌ ದಖ್ಹ್‌ಹಾತ್‌ ಲಾಂಬುಬಿ ಡೋಡ್‌ಹಾತ್‌ ಚೌ಼ಡುಬಿ ಹುಯಿರ‍್ಹುಥು; <verse eid="EXO 36:21" /><verse number="22" style="v" sid="EXO 36:22" />ಹರೇಕ್ ಚೌಕಟ್‌ಬಿ ಆಡುಪಟ್ಟೀಥಿ ಮಳಿರ‍್ಹಯುಹುಯು ಬೇ ಭೀರಾಖನಿ ಪಟ್ಟಿಥಿ ಹುಯಿರ‍್ಹುಥು; ಅಜು಼ ಡೇರಾನು ಅಖ್ಖು ಚೌಕಟ್‌ಬಿ ಇಮ್ಮಸ್‌ ಕರಿರಾಖ್ಯುಥು. <verse eid="EXO 36:22" /><verse number="23" style="v" sid="EXO 36:23" />ಡೇರಾನಿ ದಕ್ಷಿಣ್‌ ದಿಕ್ಮ ವೀಖ್ಹ್‌ ಚೌಕಟ್ನ ಕರ‍್ಯು; <verse eid="EXO 36:23" /><verse number="24" style="v" sid="EXO 36:24" />ಚಾ಼ಳಿಖ್ಹ್ ರೂಪಾನು ಹುದಿನೊ ಬಂಡೊ ಕರಿನ್‌ ಯೊ ವೀಖ್ಹ್‌ ಚೌಕಟ್ನ ಹೇಟ್ ಮ್ಹೇಲ್ಯು; ಏಕೇಕ್‌ ಚೌಕಟ್‌ಮ ಛಾ಼ತೆ ಬೇ ಭೀರ‍್ಯವಾನಿ ಪಟ್ಟಿನ ಹೇಟ್‌ ಏಕೇಕ್‌ ಹುದಿನ ಬಂಡಾನ ಮ್ಹೇಲ್ಯು. <verse eid="EXO 36:24" /><verse number="25" style="v" sid="EXO 36:25" />ಇಮ್ಮಸ್‌ ಡೇರಾನ ಉತ್ತರ್ ದಿಕ್ಮ ವೀಖ್ಹ್‌ ಚೌಕಟ್‌ನಾಬಿ, <verse eid="EXO 36:25" /><verse number="26" style="v" sid="EXO 36:26" />ಅಜು಼ ಹರೇಕ್ ಚೌಕಟ್ನ ಬೆಬ್ಬೆ ಹುದಿನ ಬಂಡಾನಿ ಪರಕ್ಮ ಚಾ಼ಳಿಖ್ಹ್ ರೂಪಾನ ಹುದಿನ ಬಂಡಾನಅಖ್ಖು ಕರ‍್ಯು. <verse eid="EXO 36:26" /><verse number="27" style="v" sid="EXO 36:27" />ಡೇರಾನ ಪಚ್‌ಕೊಡೆ ಕತೊ ಪಶ್ಚಿಮ್‌ದಿಕ್‌ಮ ಛೋ಼ ಚೌಕಟ್ನಅಖ್ಖು ಕರ‍್ಯು. <verse eid="EXO 36:27" /><verse number="28" style="v" sid="EXO 36:28" />ಡೇರಾನಿ ಪೀಠೆನು ಬೇ ಕೋಣಾವ್ನ ಅಲಕ್‌ ಬೇ ಚೌಕಟ್ನಅಖ್ಖು ಕರ‍್ಯು. <verse eid="EXO 36:28" /><verse number="29" style="v" sid="EXO 36:29" />ಯೊ ಖ್ಹಾರು ಜ಼ಡ್‌ಥುಧರೀನ್‌ ಆಣಿಲಗು ಕತೊ ಫೈಲಿ ಕಾಕ್ಣಿಲಗು ಜೋ಼ಡ್‌ಶೈರ‍್ಹುಥು, ಇಮ್ಮಸ್‌ ಬೇ ಕೋಣನಾಬಿ ಕರ‍್ಯು, <verse eid="EXO 36:29" /><verse number="30" style="v" sid="EXO 36:30" />ಅಮ್ಮಸ್‌ ಆಟ್ ಚೌಕಟ್‌ಬಿ ಅಜು಼ ಹರೇಕ್ ಚೌಕಟ್ನ ಬೆಬ್ಬೆ ರೂಪಾನೊ ಹುದಿನೊ ಬಂಡೋಬಿ ಒಟ್‌ ಖ್ಹೋಳ ಹುದಿನೊ ಬಂಡೊಖ್ಹಾರು ಥು, <verse eid="EXO 36:30" /><verse number="31" style="v" sid="EXO 36:31" />ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ಥಿ ಗಡಖ್ಹಾರು ಕರ‍್ಯು, <verse eid="EXO 36:31" /><verse number="32" style="v" sid="EXO 36:32" />ಡೇರಾನ ಘರ್‌ನು ಭೇಬಾಜುನು ಚೌಕಟ್‌ನಾಬಿ ಇನ ಪೀಠೆನು ಕತೊ ಪಶ್ಚಿಮ್‌ ದಿಕ್‌ಭಣಿನು ಖ್ಹಾರು ಚೌಕಟ್ನಾಬಿ ಪಾಚ಼್‌ಪಾಚ಼್ ಗಡಾವ್ನ ಕರ‍್ಯು, <verse eid="EXO 36:32" /><verse number="33" style="v" sid="EXO 36:33" />ಚೌಕಟ್ನು ಅಧಿ ಇಚ಼್‌ಮಾನು ಗಡಾ ಏಕ್‌ ನೋಕ್‌ಥು ಬಿಜೇಕ್‌ ನೋಕ್‌ಲಗುಬಿ ಛೀಮಾವಖ್ಹರ್ಕು ಕರ‍್ಯು, <verse eid="EXO 36:33" /><verse number="34" style="v" sid="EXO 36:34" />ಯೊ ಖ್ಹಾರ ಚೌಕಟ್ನ ಖ್ಹೊನ್ನಾನು ತಗ್‌ಡು ಲಗಾಡಿನ್ ಇನಾಮ ಯೊ ಗಡಾನಖ್ಹಾಜೆ ಖ್ಹೊನ್ನಾನು ಕಾಕ್ಣಿಯೇವ್ನ ಬಣಾಯು, ಯೊ ಗಡಾವ್ನಬಿ ಖ್ಹೊನ್ನಾನು ತಗ್‌ಡು ಲಗಾಡ್ಯು,<verse eid="EXO 36:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 36:35" />ವಾಟ್ಯುಹುಯು ಖ್ಹುತ್ತರ್‌ನಿ ಡೋರಿನ ಲುಂಗ್ಡಾಮ ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣು ರಂಗ್‌ನು, ಲಲೇಲಾಲ್‌ ರಂಗ್‌ನ ರುಯ್‌ನ ಧಾಗೇಥಿ ಕೆರೂಬಿನು ಶನ್‌ಗಾರ‍್ನು ನಕ್ಷಾನ ಶಿವಿನ್‌ ಏಕ್‌ ಪಡ್ದೊ ಬಣಾಯು, <verse eid="EXO 36:35" /><verse number="36" style="v" sid="EXO 36:36" />ಇನ ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ಥಿ ಚಾರ್‌ ಖಂಬ ಬಣೈನ್ ಖ್ಹೊನ್ನಾನು ತಗ್‌ಡು ಲಗಾಡ್ಯು; ಯೊ ಖ್ಹಾರಾನ ಖ್ಹೊನ್ನಾನ ಅಖೂಟ ಬಣೈನ್. ಚಾರ್‌ ರೂಪಾನು ಹುದಿನ ಬಂಡಾನ ಘಡಾಯು. <verse eid="EXO 36:36" /><verse number="37" style="v" sid="EXO 36:37" />ಡೇರಾನು ದರ್ವಾಜ಼ನ ವಾಟ್ಯುಹುಯು ಖ್ಹುತ್ತರ್‌ನ ವಣ್‌ಖರ‍್ನ ಲುಂಗ್ಡಾಮ ನೀಲಿ. ರಾಯ್‌ಜಾ಼ಮಣ್ಣೊ ರಂಗ್‌ ಅಜು಼ ಲಲೇಲಾಲ್‌ ರಂಗ್‌ನ ಧಾಗೇಥಿ ಶನ್‌ಗಾರ‍್ನು ನಕ್ಷ ಶಿವಿನ್‌ ಪಡ್ದೊ ಬಣಾಯು. <verse eid="EXO 36:37" /><verse number="38" style="v" sid="EXO 36:38" />ಯೊ ಪಡ್ದೊ ಠಂಗಾವನ ಪಾಚ಼್ ಖಂಬಾಬಿ ಇನು ಅಖುಟಾವ್ನ ಬಣೈನ್, ಇನ ಅಶ್‌ಪಿಶ್‌ನು ಖಿಡ್ಕಿಯೆವ್ನಾಬಿ, ಚೌಕಟ್‌ನಾಬಿ ಖ್ಹೊನ್ನಾನು ತಗ್‌ಡು ಲಗಾಡ್ಯು. ಇನ ಪಾಚ಼್ ಹುದಿನ ಬಂಡಾನ ತಾಂಬಾಥಿ ಬಣಾಯು,<verse eid="EXO 36:38" /></para>
  <chapter eid="EXO 36" />
  <chapter number="37" style="c" sid="EXO 37" />
  <para style="s">ಒಪ್ಪಂದಾನು ಪಿಟಾರನಿ ತಯಾರ್</para>
  <para style="r">(<ref loc="EXO 25:10-22">ವಿಮೋ 25:10-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 37:1" />ಬೆಚಲೇಲನೆ ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ಥಿ ಒಪ್ಪಂದಾನ ಪಿಟಾರನ ಕರ‍್ಯೊ. ಯೊ ಅಢೈಹಾತ್‌ ಲಾಂಬು, ಡೋಡ್ ಹಾತ್ ಚೌ಼ಡುಬಿ ಅಜು಼ ಡೋಡ್‌ಹಾತ್‌ ಊಚು಼ಬಿ ಹುಯಿರ‍್ಹುಥು. <verse eid="EXO 37:1" /><verse number="2" style="v" sid="EXO 37:2" />ಅಫುಟ್‌ ಖ್ಹೊನ್ನಾನ ತಗ್‌ಡಾವ್ನ ಇನ ಭಾರ್‌ಬಿ ಅಜು಼ ಮಹಿಬಿ ಢಪಾಯೊ. ಇನ ಉಪ್ಪರ್ ಅಶ್‌ಪಿಶ್‌ಬಿ ಖ್ಹೊನ್ನಾನು ತೋರಣ್ ಭಂದಾಯೊ. <verse eid="EXO 37:2" /><verse number="3" style="v" sid="EXO 37:3" />ಚಾರ್‌ ಖ್ಹೊನ್ನಾನು ಕಾಕ್ಣಿಯೆ ಘಡೈನ್‌ ಇನ ಚಾರ್‌ ಕೋಣಾನ ಕತೊ, ಏಕೇಕ್‌ ಬಾಜು಼ಬಿ ಬೆಬ್ಬೆ ಕಾಕ್ಣಿಯೆನ ಮ್ಹೇಲಾಯೊ. <verse eid="EXO 37:3" /><verse number="4" style="v" sid="EXO 37:4" />ಅಜು಼ ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ನು ಖಂಬು ಕರಿನ್‌ ಇನ ಖ್ಹೊನ್ನಾನ ತಗ್‌ಡಾವ್ನ ಢಪೈನ್, <verse eid="EXO 37:4" /><verse number="5" style="v" sid="EXO 37:5" />ಪಿಟಾರೊ ಢೋವಾನಖ್ಹಾಜೆ ಖಂಬಾವ್ನ ಪಿಟಾರನಿ ಭೇಬಾಜು಼ ಕಾಕ್ಣಿಮ ಪೆಖ್ಹಾಡ್ಯೊ. <verse eid="EXO 37:5" /><verse number="6" style="v" sid="EXO 37:6" />ಆನಾಹುಯಿನ್ ಅಫುಟ್ ಖ್ಹೊನ್ನೇಥಿ ಕೃಪಾಸನ್ನ ಕರ‍್ಯೊ. ಯೊ ಅಢೈಹಾತ್ ಲಾಂಬುಬಿ, ಡೋಡ್ ಹಾತ್ ಚೌ಼ಡುಬಿ ಹುಯಿರ‍್ಹುಥು. <verse eid="EXO 37:6" /><verse number="7" style="v" sid="EXO 37:7" />ಕೃಪಾಸನ್ನ ಬೇ ಕೋಣನಾಬಿ ಕೆರೂಬಿನು ಬೇ ಖ್ಹೊನ್ನಾನು ರೂಪ್‌ನು ನಕ್ಷಾನ ಕಾಮ್‍ಥಿ ಬಣಾಯೊ. <verse eid="EXO 37:7" /><verse number="8" style="v" sid="EXO 37:8" />ಕೃಪಾಸನ್ನ ಏಕೇಕ್‌ ಕೋಣನಾಬಿ ಏಕೇಕ್‌ ಕೆರೂಬಿನ ಕರಿನ್‌ ಇನ ಬರೋಬರ್‌ ಮ್ಹೇಲಾಯು. <verse eid="EXO 37:8" /><verse number="9" style="v" sid="EXO 37:9" />ಯೊ ಕೆರೂಬಿಖ್ಹಾರು ಉಪ್ಪರ್‌ ಪಾಕ್‌ಢಿಯೇನ ಫಖ್ಹಾರಿರಾಖನಿಘೊಣಿ ಕೃಪಾಸನ್ನ ಇವ್ಣಿ ಪಾಕ್‌ಢಿಯೇಥಿ ಢಾಪಿರಾಖನಿತರಬಿ ಥೂ. ಇನ ಮ್ಹೋಡಾನ ಆಮೆಖ್ಹಾಮೆ ಕೃಪಾಸನ್ನ ದೇಖುಕರ್ತುಥು.<verse eid="EXO 37:9" /></para>
  <para style="s">ದೇವ್ನಖ್ಹಾಜೆ ಸಮರ್ಪಣ್‌ಕರಾನ ರೋಟನು ಮೇಜ್‌ ಕರಾಯೋತೆ</para>
  <para style="r">(<ref loc="EXO 25:23-30">ವಿಮೋ 25:23-30</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 37:10" />ಇನೆ ಬಾವಳ್ಯನ ಝಾ಼ಡೇಥಿ ಮೇಜ್‌ನ ಕರಾಯೊ. ಯೊ ಬೇ ಹಾತ್‌ ಲಾಂಬುಬಿ, ಏಕ್‌ಹಾತ್‌ ಚೌ಼ಡುಬಿ, ಡೋಡ್‌ಹಾತ್‌ ಊಚು಼ಬಿ ಹುಯಿರ‍್ಹುಥು. <verse eid="EXO 37:10" /><verse number="11" style="v" sid="EXO 37:11" />ಇನ ಅಫುಟ್‌ ಖ್ಹೊನ್ನಾನು ತಗ್‌ಡೇಥಿ ಢಪೈನ್‌ ಅಶ್‌ಪಿಶ್‌ ಖ್ಹೊನ್ನಾನು ತೋರಣ್ ಭಂದಾಯೊ. <verse eid="EXO 37:11" /><verse number="12" style="v" sid="EXO 37:12" />ಮೇಜ್‌ನ ಅಶ್‌ಪಿಶ್‌ ಹತೇಳಿಯೆತ್ರೆ ಚೌ಼ಡು ಆಡಿಪಟ್ಟಿನ ಕರಿನ್‌ ಇನಾಬಿ ಖ್ಹೊನ್ನಾನು ತೋರಣ್ ಭಂದಾಯೊ. <verse eid="EXO 37:12" /><verse number="13" style="v" sid="EXO 37:13" />ಮೇಜ್‌ನ ಪಾಡಾನು ಲಠ್ಠಾವ್ನ ಪೆಖ್ಹಾಡನಖ್ಹಾಜೆ ಇನ ಚಾರ್‌ ಖ್ಹೊನ್ನಾನು ಕಾಕ್ಣಿನ ಬಣಾವಟ್ ಕರೈನ್‌ ಇನ ಚಾರ್‌ ಗೋಡಾನಾಬಿ ಜೋ಼ಡ್‌ಶಾಯೊ. <verse eid="EXO 37:13" /><verse number="14" style="v" sid="EXO 37:14" />ಯೊ ಕಾಕ್ಣಿಅಖ್ಖು ಆಡಿಪಟ್ಟಿನ ಘಲೈರ‍್ಹುಥು. <verse eid="EXO 37:14" /><verse number="15" style="v" sid="EXO 37:15" />ಮೇಜ್‌ನ ಢೋವಾನ ಲಠ್ಠಾವ್ನ ಬಾವಳ್ಯನ ಝಾ಼ಡೇಥಿ ಕರೈನ್‌ ಇನ ಖ್ಹೊನ್ನಾನು ತಗ್‌ಡಾನ ಢಪಾಯೊ. <verse eid="EXO 37:15" /><verse number="16" style="v" sid="EXO 37:16" />ಮೇಜ್‌ನ ಉಪ್ಪರ್‌ ಮ್ಹೇಲಾನು ಜಿನಖ್ಹ್‌ನ ಕತೊ ಕಾಠುಕ್, ಢಾಕ್ಣಿ, ತಾಂಬ್ಯೊ, ಪಿಯ್ಯಾನ ಹೋಣುತೆ ಕಟೋರಿಯೆ ಯೊ ಅಖ್ಖೂಬಿ ಅಫುಟ್‌ ಖ್ಹೊನ್ನೇಥಿ ಕರ‍್ಯೊ.<verse eid="EXO 37:16" /></para>
  <para style="s">ದೀವಾನು ಖಂಬುನ ತಯಾರಿ ಕರ‍್ಯುತೆ</para>
  <para style="r">(<ref loc="EXO 25:31-40">ವಿಮೋ 25:31-40</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 37:17" />ಅಜು಼ ಅಫುಟ್‌ ಖ್ಹೊನ್ನೇಥಿ ದಿವೋನು ಖಂಬಾನ ಕರ‍್ಯೊ. ಇನ ಬಡ್ಡೇಮ ಖಂಬಾನಬಿ ನಕ್ಷಾನ ಕಾಮ್‍ಥಿ ಬಣಾಯೊ. ಯೊ ದಿವೋನು ಖಮ್‌ಅಖ್ಖು ಫೂಲ್‌ನಿ ಬಣಾವಟ್‌ನಿಘೊಣಿ ಫೂಲ್ನಿಘೊಣಿಬಿ ಶನ್‌ಗಾರ್‌ಥಿ ಕೆತ್ತಿರಾಖ್ಯುಥು. <verse eid="EXO 37:17" /><verse number="18" style="v" sid="EXO 37:18" />ಖಂಬಾನು ಏಕೇಕ್‌ ಬಾಜು಼ಬಿ ತೀನ್‌ತೀನ್ ಡಾಳಿಯೆ ಕತೊ ಛೋ಼ ಡಾಳಿಯೇಥಿ. <verse eid="EXO 37:18" /><verse number="19" style="v" sid="EXO 37:19" />ಹರೇಕ್ ಡಾಳಿಯೇನಾಬಿ ಬಾದಾಮ್‌ನ ಫೂಲ್ನಿಘೊಣಿನು ತೀನ್‌ತೀನ್‌ ಫೂಲ್ನು ಬಣಾವಟ್ನಿ ಶನ್‌ಗಾರ್‌ಥು; ಏಕೇಕ್‌ ಬಣಾವಟ್ನಾಬಿ ಏಕ್‌ ಫೂಲ್‌ಬಿ ಥೂ. ಛೋ಼ ಡಾಳಿಯೇನಾಬಿ ಇಮ್ಮಸ್‌ ಥು. <verse eid="EXO 37:19" /><verse number="20" style="v" sid="EXO 37:20" />ದಿವೋನು ಖಂಬ್‌ನಿ ಫೂಲ್ನು ಪತ್ತರ್‌ಬಿ ಫೂಲ್‌ಬಿ ಗೋಂಡಿಬಿ ಬಾದಾಮ್ನು ಫೂಲ್ನಿಘೊಣಿ ಚಾರ್‌ ಫೂಲ್ನು ಬಣಾವಟ್ ಥು. <verse eid="EXO 37:20" /><verse number="21" style="v" sid="EXO 37:21" />ಬೆಬ್ಬೇ ಡಾಳಿಯೇನಿ ಫಾಕೆಮ್ಹೆಲಿರಾಖಾನಿ ಝ಼ಗೊಮ ಏಕೇಕ್‌ ಗೋಂಡಿ, ಡಾಳಿಯೆನ ಹೇಟ್ ಫಾಕೆರ‍್ಹವಾನ ಝ಼ಗೊಮಾಬಿ ಏಕೇಕ್‌ ಗೋಂಡಿ ಅಮ್‌ ಡಾಳಿಯೇನು ಛೋ಼ ಬಾಜು಼ಬಿ ಗೋಂಡಿಖ್ಹಾರುಥು. <verse eid="EXO 37:21" /><verse number="22" style="v" sid="EXO 37:22" />ಗೋಂಡಿಯೆಬಿ ಡಾಳಿಯೇಬಿ ಮಳಿನ್ ದಿವೋನು ಖಂಬ್‌ಖ್ಹಾರುಸ್ ಅಫುಟ್‌ ಖ್ಹೊನ್ನೇಥಿ ನಕ್ಷಾನು ಬಣಾವಟ್‌ಥಿ ಕರ‍್ಯೊ. <verse eid="EXO 37:22" /><verse number="23" style="v" sid="EXO 37:23" />ಇನ ಖ್ಹಾತ್ ದಿವಳ್ಗಿನಾಬಿ ಇನಿ ಕತರ‍್ನಿನಾಬಿ ದಿವೋನು ಬತ್ತಿ ಕಾಡಾನು ಕಟೋರಿಯೇನಾಬಿ ಅಫುಟ್‌ ಖ್ಹೊನ್ನೇಥಿ ಕರ‍್ಯೊ. <verse eid="EXO 37:23" /><verse number="24" style="v" sid="EXO 37:24" />ದಿವೋನು ಖಂಬು ಇನ ಅಖ್ಖು ರಾಛು಼ಬಿ ಚಾರ್‌ಉಪ್ಪರ್ ಡೋಡಿಖ್ಹ್‌ ಕಿಲೊ ಅಫುಟ್‌ ಖ್ಹೊನ್ನೇಥಿ ಹುಯಿರ‍್ಹುಥು.<verse eid="EXO 37:24" /></para>
  <para style="s">ಢಪ್ಕಾರನ ಬಳಾನಖ್ಹಾಜೆ ಬಲಿನಿ ಚಾ಼ಚ಼ರ್‌ನ ಕರ‍್ಯುತೆ</para>
  <para style="r">(<ref loc="EXO 30:1-5">ವಿಮೋ 30:1-5</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 37:25" />ಇನೆ ಬಾವಳ್ಯನ ಝಾ಼ಡೇಥಿ ಖ್ಹಾಲರ‍್ಯನಿ ಚಾ಼ಚ಼ರ್‌ನ ಕರ‍್ಯೊ. ಯೊ ಏಕ್‌ಹಾತ್ ಲಾಂಬುಬಿ ಏಕ್‌ಹಾತ್ ಚೌ಼ಡುಬಿ ರ‍್ಹೀನ್ ಚಾರ್‌ಖೂಟಿಥು; ಇನು ಊಚು಼ ಬೇಹಾತ್ ಹುಯಿರ‍್ಹುಥು. ಇನು ಶಿಂಗ್‌ಡು ಅಖ್ಖು ಇನಿ ಜೋ಼ಡೆ ಬರೊಬರಸ್‌ಥು. <verse eid="EXO 37:25" /><verse number="26" style="v" sid="EXO 37:26" />ಇನು ಉಪ್ಲಿಬಾಜು಼ಬಿ ಚಾರ‍್ಹೆ ಬಾಜು಼ಬಿ ಶಿಂಗ್ಡನಾಬಿ ಅಫುಟ್‌ ಖ್ಹೊನ್ನೇಥಿ ಢಪಾಯೊ. ಅಶ್‌ಪಿಶ್‌ಬಿ ಖ್ಹೊನ್ನಾನು ಶನ್‌ಗಾರ್‌ನಿ ಪಟ್ಟಿ ಭಂದಾಯೊ. <verse eid="EXO 37:26" /><verse number="27" style="v" sid="EXO 37:27" />ಇನ ಪಾಡನ ಲಠ್ಠಾವ್ನ ಪೆಖ್ಹಾಡನ ಯೊ ಪಟ್ಟಿನ ಹೇಟ್‌ ಚಾ಼ಚ಼ರ್‌ನ ಭೇಬಾಜು಼ಬಿ ಬೆಬ್ಬೇ ಖ್ಹೊನ್ನಾನು ಕಾಕ್ಣಿನ ಕರಾಯೊ. <verse eid="EXO 37:27" /><verse number="28" style="v" sid="EXO 37:28" />ಚಾ಼ಚ಼ರ್‌ನ ಪಾಡಾನ ಲಠ್ಠಾವ್ನ ಬಾವಳ್ಯನ ಝಾ಼ಡೇಥಿ ಕರಿನ್‌ ಇನ ಖ್ಹೊನ್ನಾನ ತಗ್‌ಡಾವ್ನ ಢಪಾಯೊ.<verse eid="EXO 37:28" /></para>
  <para style="s">ಅಬಿಷೇಕ್ ತೇಲ್‌ಬಿ ಅಜು಼ ಖ್ಹಾಲರ‍್ಯೊ ತಯಾರ್‌ಕರಾನು</para>
  <para style="r">(<ref loc="EXO 30:22-38">ವಿಮೋ 30:22-38</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 37:29" />ಆ ನಾಹುಯಿನ್ ಇನೆ ದೇವ್ನ ಸೇವೆನ ನೇಮಕ್‌ಹುಯಿರ‍್ಹುತೆ ಪಟ್ಟಾಭಿಷೇಕನು ತೇಲ್ನಬಿ ವಾಖ್ಹ್‌ನ ತೇಲ್‌ಥಿ ಹುಯುತೆ ಶುದ್‍ ಖ್ಹಾಲರ‍್ಯನ ತೇಲ್ನಬಿ ವಾಖ್ಹ್‌ನ ತೇಲ್ನ ಕರವಾಳಾನ ಪರಕ್ಮಾಸ್ ಬಣಾಯೊ.<verse eid="EXO 37:29" /></para>
  <chapter eid="EXO 37" />
  <chapter number="38" style="c" sid="EXO 38" />
  <para style="s">ಬಾಳನು ಬಲಿನು ಚಾ಼ಚ಼ರ್‌ ಭಾಂದ್ಯುತೆ</para>
  <para style="r">(<ref loc="EXO 27:1-8">ವಿಮೋ 27:1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 38:1" />ಇನೆ ಬಳಾನಿ ಬಲಿನಿ ಚಾ಼ಚ಼ರ್‌ನ ಬಾವಳ್ಯನ ಝಾ಼ಡೇಥಿ ಬಣಾಯೊ. ಯೊ ಪಾಚ಼್‌ಹಾತ್‌ ಲಾಂಬುಬಿ ಪಾಚ಼್‌ಹಾತ್‌ ಚೌ಼ಡುಬಿ ಚಾರ್‌ಖೂಟಿ ಥು; ಇನು ಊಚು಼ ತೀನ್‌ಹಾತ್‌ ಥು. <verse eid="EXO 38:1" /><verse number="2" style="v" sid="EXO 38:2" />ಇನ ಚಾರ್‌ ಕೋಣನಾಬಿ ಚಾರ್ ಶಿಂಗ್‌ಡಾವ್ನ ಕರಾಯೊ; ಯೊ ಬಳಾನಿ ಚಾ಼ಚ಼ರ್‌ ಸಮಥು. ಯೊ ಚಾ಼ಚ಼ರ್‌ನ ತಾಂಬಾನ ತಗ್‌ಡಾವ್ನ ಢಪಾಯೊ. <verse eid="EXO 38:2" /><verse number="3" style="v" sid="EXO 38:3" />ಚಾ಼ಚ಼ರ್‌ನ ರಾಛ಼ವ್‌ನ ಕತೊ ಇನ ಕಟೋರಿಖ್ಹಾರು, ಪಲೋಟ್ಣುಅಖ್ಖು, ಅಖೂಟಅಖ್ಖು, ಕುಂಡು, ಕಾಟಾನಿ ಡೋಯ್‌, ಡಿಖ್ಹ್‌ಟೆಅಖ್ಖು, ಅನಅಖ್ಖು ತಾಂಬೇಖ್ಹು ಬಣಾಯೊ. <verse eid="EXO 38:3" /><verse number="4" style="v" sid="EXO 38:4" />ಚಾ಼ಚ಼ರ್‌ನ ವಣ್ಕರ್‌ನ ಕಾಮ್‍ಥಿ ತಾಂಬಾನಿ ಖಾಂಜ್ರಿನ ಕರಾಯೊ. ಯೊ ಚಾ಼ಚ಼ರ್‌ನ ಅಶ್‌ಪಿಶ್‌ನ ಕಟ್ಟಾನ ಹೇಟ್‌ ಚಾ಼ಚ಼ರ್‌ನ ಹೇಟ್‌ಥು ಬೀಚ್ಮ ರ‍್ಹವಾನಿಘೊಣಿ ಘಲಾಯೊ. <verse eid="EXO 38:4" /><verse number="5" style="v" sid="EXO 38:5" />ಚಾ಼ಚ಼ರ್‌ನ ಪಾಡನು ಲಠ್ಠಾನ ಘಾಲನಖ್ಹಾಜೆ ಯೊ ತಾಂಬಾನು ಖಾಂಜ್ರಿನ ಚಾರ್‌ ಕೋಣನಾಬಿ ಚಾರ್‌ ಕಾಕ್ಣಿನ ಲಗಾಡ್ಯೊ. <verse eid="EXO 38:5" /><verse number="6" style="v" sid="EXO 38:6" />ಚಾ಼ಚ಼ರ್‌ನ ಪಾಡಾನು ಲಠ್ಠಾವ್ನ ಬಾವಳ್ಯನ ಝಾ಼ಡ್‌ಥಿ ಕರಿನ್‌ ತಾಂಬಾನ ತಗ್‌ಡಾವ್ನ ಢಪಾಯೊ. <verse eid="EXO 38:6" /><verse number="7" style="v" sid="EXO 38:7" />ಇನ ಭೇ ಬಾಜೂ಼ಬಿ ಕಾಕ್ಣಿನ ಘಲಾಯೊ. ಯೊ ಚಾ಼ಚ಼ರ್‌ನ ಪಲ್ಗಾವ್‌ಥಿ ಪಿಟಾರನಿಘೊಣಿ ಕರ‍್ಯೊ.<verse eid="EXO 38:7" /></para>
  <para style="s">ಕಂಚ಼್‌ನು ಬಾನೆನ ಕರ‍್ಯುತೆ</para>
  <para style="r">(<ref loc="EXO 30:18">ವಿಮೋ 30:18</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 38:8" />ದೇವ್ನದರ್ಶನ್ನ ಡೇರಾನ ದರ‍್ವಾಜ಼ಕನ ಸೇವೆ ಕರುಕರ್ತಿಥಿತೆ ತಯೇಡಖ್ಹಾರು ದಿದೀತೆ ತಾಂಬಾನು ಐನೇಥಿ ಬಾನೇನ ಇನಿ ಝ಼ಗ್ಲಿನ ಕರ‍್ಯೊ.<verse eid="EXO 38:8" /></para>
  <para style="s">ಯೆಹೋವನಿ ಸನ್ನಿದಿನ ಡೇರಾನೊ ಬಲ್ಡೊ</para>
  <para style="r">(<ref loc="EXO 27:9-19">ವಿಮೋ 27:9-19</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 38:9" />ಡೇರಾನ ಬಲ್ಡಾನ ಕರ‍್ಯೊ. ಯೊ ಬಲ್ಡಾನ ದಕ್ಷಿಣ್‌ ದಿಕ್ಮ ಥೂತೆ ಪಡ್ದೊಅಖ್ಖು ಖ್ಹಾಜ಼್‌ಥಿ ಖ್ಹುತ್ತರ್‌ನ ವಣ್‌ಖರ‍್ನ ಲುಂಗ್ಡೇಥಿ ಕರ‍್ಯುಹುಯು ಖ್ಹೊಹಾತ್‌ ಲಾಂಬುಥು. <verse eid="EXO 38:9" /><verse number="10" style="v" sid="EXO 38:10" />ಯೋಅಖ್ಖಾನ ವೀಖ್ಹ್‌ ಖಮ್‌ಬಿ ಇನ ವೀಖ್ಹ್‌ ತಾಂಬಾನು ಹುದಿನ ಬಂಡೋಬಿ ಥು; ಖಂಬಾನು ಅಖುಟೊಅಖ್ಖು ಖ್ಹಬ್ಬಳ್‌ಬಿ ರೂಪಾನು ಹುಯಿರ‍್ಹುಥು. <verse eid="EXO 38:10" /><verse number="11" style="v" sid="EXO 38:11" />ಉತ್ತರ್ ದಿಕ್‌ಮಾಬಿ ಖ್ಹೊಹಾತ್‌ ಲಾಂಬುಹುಯಿರ‍್ಹುತೆ ಪಡ್ದೊಅಖ್ಖು ವೀಖ್ಹ್‌ ಖಂಬಖ್ಹಾರು ವೀಖ್ಹ್‌ ತಾಂಬಾನು ಹುದಿನು ಬಂಡೊಖ್ಹಾರು ಹಿಜ್ಜಾ಼ಥು; ಖಂಬಅಖ್ಖು ಅಖುಟೊಅಖ್ಖು ಖಿಲ್ಲಾಅಖ್ಖು ರೂಪಾನು ಹುಯಿರ‍್ಹುಥು. <verse eid="EXO 38:11" /><verse number="12" style="v" sid="EXO 38:12" />ಪಶ್ಚಿಮ್‌ನಿ ಬಾಜು಼ಮ ಅಢೈಖ್ಹ್ ಹಾತ್ ಲಾಂಬು ಪಡ್ದೊಅಖ್ಖುಬಿ ದಖ್ಹ್‌ ಖಂಬಾಬಿ ದಖ್ಹ್‌ ಹುದಿನೊ ಬಂಡೋಬಿ ಥು; ಖಂಬಾನು ಅಖುಟೊಅಖ್ಖುಬಿ ಖಿಲ್ಲಾಅಖ್ಖುಬಿ ರೂಪಾನು ಹುಯಿರ‍್ಹುಥು. <verse eid="EXO 38:12" /><verse number="13" style="v" sid="EXO 38:13" />ಪೂರಬ್‌ದಿಕ್‌ಮಾಬಿ ಬಲ್ಡಾನು ಚೌ಼ಡುಬಿ ಅಢೈಖ್ಹ್‌ ಹಾತ್‌ಹುಯಿರುಥು. <verse eid="EXO 38:13" /><verse number="14" style="v" sid="EXO 38:14" />ಹಿಜ಼್ಜ ದರ್ವಾಜ಼ನಿ ಭೇಬಾಜು಼ಬಿ ಪಂಧ್ರ ಹಾತ್ ಲಾಂಬು ಪಡ್ದೊಬಿ, <verse eid="EXO 38:14" /><verse number="15" style="v" sid="EXO 38:15" />ಇನ ತೀನ್-ತೀನ್ ಖಂಬಅಖ್ಖುಬಿ ತೀನ್-ತೀನ್ ಹುದಿನೊ ಬಂಡೋಬಿ ಥು. <verse eid="EXO 38:15" /><verse number="16" style="v" sid="EXO 38:16" />ಬಲ್ಡಾನ ಅಶ್‌ಪಿಶ್‌ನ ಪಡ್ದಾನಅಖ್ಖು ಕವ್‌ಳು ವಣಿಹುಯು ಖ್ಹುತ್ತರ್‌ನು ಲುಂಗ್ಡುಹುಯಿರ‍್ಹುಥು. <verse eid="EXO 38:16" /><verse number="17" style="v" sid="EXO 38:17" />ಖಂಬಾನು ಹುದಿನೊ ಬಂಡೊ ಅಖ್ಖು ತಾಂಬಾನು ಹುಯಿರುಥು; ಖಂಬಾನು ಅಖುಟೊಖ್ಹಾರುಬಿ ಘುಳೊಅಖ್ಖು ರೂಪಾನು ಹುಯಿರುಥು; ಇನು ಬಣಾವಟ್‌ಅಖ್ಖು ರೂಪಾನ ತಗ್‌ಡೇಥಿ ಢಪೈರ‍್ಹುಥು. ಬಲ್ಡಾನ ಅಖ್ಖಾ ಖಮ್‌ನಾಬಿ ರೂಪಾನು ಘುಳೊಥು. <verse eid="EXO 38:17" /><verse number="18" style="v" sid="EXO 38:18" />ಬಲ್ಡಾನ ದರ್ವಾಜ಼ಕನಥೂತೆ ಪಡ್ದೊ ಖ್ಹುತ್ತರ್‌ನ ಲುಂಗ್ಡೇಥಿಬಿ ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣೊ ರಂಗ್‌ಬಿ ಲಲೇಲಾಲ್‌ ರಂಗ್‌ನ ಧಾಗೇಥಿಬಿ ವಣ್‌ಖರ್‌ನು ಕಾಮ್‌ಕರವಾಳನ ಹಾತೇಥಿ ಬಣೈರ‍್ಹುಥು. ಯೊ <verse eid="EXO 38:18" /><verse number="19" style="v" sid="EXO 38:19" />ದರ್ವಾಜ಼ನ ಚಾರ್‌ ಖಮ್‌ನಾಬಿ ಚಾರ್‌ ತಾಂಬಾನು ಹುದಿನೊ ಬಂಡೊ ಅಖ್ಖು ಥು; ಖಮ್‌ನಿ ಅಖುಟೊಅಖ್ಖುಬಿ ಘುಳಾವ್ನು ಬಣಾವಟ್ನ ಢಪೈರ‍್ಹುತೆ ತಗ್‌ಡುಅಖ್ಖು ರೂಪಾನು ಹುಯಿರ‍್ಹುಥು. <verse eid="EXO 38:19" /><verse number="20" style="v" sid="EXO 38:20" />ಡೇರಾನು ಖಿಲ್ಲಾಅಖ್ಖು ಬಲ್ಡಾನ ಖಿಲ್ಲಾಬಿ ಅಖ್ಖು ತಾಂಬಾನು ಹುಯಿರುಥು.<verse eid="EXO 38:20" /></para>
  <para style="s">ಡೇರಾನ ತಯಾರ್ ಕರಾನಿ ವಖ್ಹ್‌ತೆ ಜಿನಖ್ಹ್‌ನಿ ಗಣ್ತಿ</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 38:21" />ದೇವ್ನು ದರ್ಶನ್ನ ಡೇರಾನ ಕರಾನ ಲಾಗ್ತುಥುತೆ ರಾಛ಼ನಿ ಗಣ್ತಿ. ಮೋಶೆನಿ ಹುಕುಮ್ನಿಘೋಣಿ ಮಹಾಯಾಜಕ ಹುಯಿರೋತೆ ಆರೋನನೊ ಛಿಯ್ಯೊ ಈತಾಮಾರನೆ ಲೇವಿನ ಹಾಥ್ಥಿ ಗಣ್ತಿ ಕರಾಯೋತೆ. <verse eid="EXO 38:21" /><verse number="22" style="v" sid="EXO 38:22" />ಯೆಹೋವದೇವ್ನೆ ಮೋಶೆನ ಹುಕುಮ್‌ಕರ‍್ಯೊತೆ ಅಖ್ಖು ಕರ‍್ಯುತೆ ಕೋಣ್‌ಕತೊ, ಯೆಹೂದ ಖೂಮ್ನೊ ಹೂರನೊ ನಾತ್ಯೊಬಿ ಊರಿಯನೊ ಛಿಯ್ಯೊಬಿ ಹುಯಿರೋತೆ ಬೆಚಲೇಲಸ್‌; <verse eid="EXO 38:22" /><verse number="23" style="v" sid="EXO 38:23" />ಇನಿ ಜೋಡ್ಮ ದಾನ್‌ ಖೂಮ್ನೊ ಅಹೀಸಾಮಾಕನೊ ಛಿಯ್ಯೊಹುಯಿರೊತೆ ಒಹೋಲೀಯಾಬಬಿ ಮಳಿರ‍್ಹೊಥೊ; ಯೊ ಕೆತ್ತಾನ ಕಾಮ್ಮ ಪುರ್‌ಗುಲ್‌ ಹುಯಿರ‍್ಹೊಥೊ. ಖ್ಹುತ್ತರ್‌ನ ಲುಂಗ್ಡಾಮ ನೀಲಿ ರಾಯ್‌ಜಾ಼ಮಣ್ಣು ರಂಗ್‌ನು ಲಲೇಲಾಲ್‌ ರಂಗ್ನು ಹುಯಿರುತೆ ಧಾಗೇಥಿ ವಣ್ಕರ್‌ನು ಕಾಮ್ನ ಕರವಾಳೊ ಹುಯಿರ‍್ಹೊಥೊ. <verse eid="EXO 38:23" /><verse number="24" style="v" sid="EXO 38:24" />ದೇವ್ನ ಮಂದಿರ‍್ನ ಹರೇಕ್ ಕಾಮ್ನಬಿ ಹೋಣುತೆ ಕಾಣ್ಕೆನು ಖ್ಹೊನ್ನಾನ ದೇವ್ನ ಸೇವೆನ ಅರ್ಪಣ್‌ ಕರ‍್ನುತೆ ಶೆಕೆಲ್‌ನ ಗಣ್ತಿಮ ಎಕ್ಕಮ್‌ಡೋಡಿಖ್ಹ್‌ ತೋಲ ಖ್ಹಾತ್ ಖ್ಹೊ ಡೋಡಿಖ್ಹ್‌ ಶೆಕೆಲ್‌ ಹುಯಿರ‍್ಹುಥು. <verse eid="EXO 38:24" /><verse number="25" style="v" sid="EXO 38:25" />ಟೋಳ್‌ವಾಳಾನಿ ಗಣ್ತಿಮ ಚೂ಼ಣಯುತೆ ಅದ್ಮಿವೋಥಿ ದೇವ್ನ ಸೇವೆನಖ್ಹಾಜೆಕರಿ ಜ಼ಮಾಹುಯುತೆ ರೂಪಾನು ತೋಲ್‌ಹುಯಿರುತೆ ದೇವ್ನ ಸೇವೆನ ಜ಼ಮಾಹುಯುತೆ ಶೆಕೆಲ್‌ನಿ ಗಣ್ತಿಮ ಖ್ಹೋತೋಲ ಅಜು಼ ಏಕ್‌ಹಜ಼ಾರ್‌ ಖ್ಹಾತ್‌ಖ್ಹೊ ಪಾಚ಼್‌ಉಪ್ಪರ್‌ ಖ್ಹಡ್‌ತೀನಿಖ್ಹ್‌ ಶೆಕೆಲ್‌. <verse eid="EXO 38:25" /><verse number="26" style="v" sid="EXO 38:26" />ದೇವ್ನ ಸೇವೆನ ನೇಮಕ್‌ಹುಯುತೆ ಶೆಕೆಲ್‌ನಿ ಏಕೇಕ್‌ “ಬೆಕಾ” ಕತೊ ಆಧು ಶೆಕೆಲ್‌ ಹುಯಿರುಥು. ಅದ್ಮಿವೋನಿ ಗಣ್ತಿವೊಮ ವೀಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳು ಅಜು಼ ಇನೇಥಿಬಿ ಘಣಿ ಉಂಬರ್‌ವಾಳಾನಿ ಇಶಾಬ್‌ಹುಯುತೆ ಇನಾಮ, ವೀಖ್ಹ್‌ ವರಖ್ಹ್‌ವಾಳುಬಿ ಇನೇಥಿ ಘಣಿ ಉಂಬರ್‌ವಾಳನಿ ಗಣ್ತಿ ಛೋ಼ ಲಾಕ್‌ ತೀನ್‌ಹಜಾ಼ರ್‌ ಪಾಚ಼್‍ಖ್ಹೊ ಅಢೈಖ್ಹ್‌ ಜ಼ಣು ಥು. <verse eid="EXO 38:26" /><verse number="27" style="v" sid="EXO 38:27" />ದೇವ್ನು ಮಂದಿರ್‌ನು ಹುದಿನ ಬಂಡಾನಬಿ ಪಡ್ದಾನ ಖಂಬಾವ್ನ ಹುದಿನ ಬಂಡಾನಬಿ ಬಣಾವಟ್‌ಕರಾಮ ಏಕೇಕ್‌ ಹುದಿನ ಬಂಡಾನ ಏಕೇಕ್‌ ತೋಲಾನಿ ಗಣ್ತಿಮ ತೀನ್‌ಹಜಾ಼ರ್‌ ಚಾರ್‌ಖ್ಹೊ ವೀಖ್ಹ್‌ ಕಿಲೊ ಅಫುಟ್‌ ರೂಪುಬಿ ಉಪಯೋಗ್‌ ಹುಯು. <verse eid="EXO 38:27" /><verse number="28" style="v" sid="EXO 38:28" />ಉಭ್‌ರ‍್ಯುತೆ ಏಕ್‌ಹಜಾ಼ರ್‌ ಖ್ಹಾತ್‌ಖ್ಹೊ ಪಾಚ಼್‌ಉಪ್ಪರ್‌ ವೀಖ್ಹ್‌ ತೋಲೆಥಿ ಖಂಬಾವ್ನ ಅಖೂಟೊಬಿ ಖಿಲ್ಲಾವ್‌ನ ಕರಿನ್‌ ಇನ ಬಣಾವಟ್ನ ತಗ್‌ಡಾನ ಢಪಾಯು. <verse eid="EXO 38:28" /><verse number="29" style="v" sid="EXO 38:29" />ಅದ್ಮಿಖ್ಹಾರು ಕಾಣ್ಕೆ ದಿದೂತೆ ತಾಂಬಾನಿ ಗಣ್ತಿ ಖ್ಹಡ್‌ತೀನ್‌ಖ್ಹ್‌ ತೋಲ ಬೇ ಹಜಾ಼ರ್‌ ಚಾರ್‌ಖ್ಹೊ ಪಾಚ಼್‌ಉಪ್ರಿಖ್ಹ್‌ ಶೆಕೆಲ್‌. <verse eid="EXO 38:29" /><verse number="30" style="v" sid="EXO 38:30" />ಅನೇಥಿ ದೇವ್ನ ದರ್ಶನ್ನು ಡೇರಾನ ದರ್ವಾಜ಼ನ ಹುದಿನ ಬಂಡಾನಾಬಿ ತಾಂಬಾನಿ ಖಾಂಜ್ರಿನಾಬಿ <verse eid="EXO 38:30" /><verse number="31" style="v" sid="EXO 38:31" />ಬಲ್ಡಾನ ಅಶ್‌ಪಿಶ್‌ನ ಹುದಿನ ಬಂಡಾನಾಬಿ ಬಲ್ಡಾನ ದರ್ವಾಜ಼ನ ಹುದಿನ ಬಂಡಾನಾಬಿ ಡೇರಾನ ಅಜು಼ ಬಲ್ಡಾನ ಅಖ್ಖಾ ಖಿಲ್ಲಾನಾಬಿ ಕರಾಯೊ.<verse eid="EXO 38:31" /></para>
  <chapter eid="EXO 38" />
  <chapter number="39" style="c" sid="EXO 39" />
  <para style="s">ಯಾಜಕವ್ನ ಚ಼ರ‍್ನಾನು ಪೇರ್ವಾಖ್ಹ್‌ ಕರಾಯುತೆ</para>
  <para style="r">(<ref loc="EXO 28:1-14">ವಿಮೋ 28:1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 39:1" />ಯೆಹೋವನೆ ಮೋಶೆನ ಹುಕುಮ್‌ದಿದೊತೆ ತಿಮ್‌ ಯೊ ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣು ರಂಗ್‌, ಲಲೇಲಾಲ್‌ ರಂಗ್ನು ಛಾ಼ತೆ ಧಾಗೇಖ್ಹು ದೇವ್ನ ಮಂದಿರ‍್ನ ಸೇವೆನ ಶನ್‌ಗಾರ್‌ನ ಪೇರ್ವಾಖ್ಹ್‌ನಬಿ ಪರಿಶುದ್ ಆರೋನನ ಪರಿಶುದ್ ಪೇರ್ವಾಖ್ಹ್‌ನಬಿ ಕರ‍್ಯು. <verse eid="EXO 39:1" /><verse number="2" style="v" sid="EXO 39:2" />ಮಹಾಯಾಜಕನು ಏಫೋದ್‌ಕರಿ ಚ಼ರ‍್ನಾನ ವಾಟ್ಯುತೆ ಖ್ಹುತ್ತರ್‌ನು ಲುಂಗ್ಡೇಥಿಬಿ ಖ್ಹೊನ್ನಾನು ಧಾಗೇಥಿಬಿ ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣು ರಂಗ್‌, ಲಲೇಲಾಲ್‌ ರಂಗ್ನು ಛಾ಼ತೆ ಧಾಗೇಥಿಬಿ ಕರ‍್ಯೊ. <verse eid="EXO 39:2" /><verse number="3" style="v" sid="EXO 39:3" />ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣು ರಂಗ್‌ನು, ಲಲೇಲಾಲ್‌ ರಂಗ್ನು ಧಾಗೇಥಿಬಿ ಖ್ಹುತ್ತರ್‌ನ ಲುಂಗ್ಡೇಥಿಬಿ ವಣ್‌ಖರ್‌ ಬಣಾವಟ್ನ ಕಾಮ್‍ಥೀಬಿ ಕಾಮ್‌ಕರಾವನ ಅಫುಟ್‌ ಖ್ಹೊನ್ನಾನ ಕೂಟೈನ್‌ ತಗ್‌ಡಾನ ಕರೈನ್‌ ನ್ಹಾನು-ನ್ಹಾನು ಪಧರ್‌ನಿಘೋಣಿ ಕತ್‌ರ‍್ಯು. <verse eid="EXO 39:3" /><verse number="4" style="v" sid="EXO 39:4" />ಯೊ ಏಫೋದ್ನ ಭುಜ಼್‌ಪರ್ ಬೇ ಪಟ್ಟಿಯೆ ಕರಾಯೊ. ಇನ ಭೇ ಜೋಡ್‌ಶೈರ‍್ಹುಥು. <verse eid="EXO 39:4" /><verse number="5" style="v" sid="EXO 39:5" />ಕವಚ್‌ನ ಉಪ್ಪರ್‌ಥೂತೆ ಶನ್‌ಗಾರ‍್ನು ವಣ್ಕರ್‌ಥೂತೆ ಕಂಬರ್‌ಪಟಾನ ಲಾಗಿರ‍್ಹಿನ್ ಖ್ಹುತ್ತರ್‌ನ ಲುಂಗ್ಡೇಥಿಬಿ, ಖ್ಹೊನ್ನಾನ ಧಾಗೇಥಿಬಿ ಅಜು಼ ನೀಲಿ, ರಾಯ್‌ಜಾ಼ಮಣ್ಣೊ ರಂಗ್, ಲಲೇಲಾಲ್ ರಂಗ್‌ನ ಧಾಗೇಥಿಬಿ ಬಣೈರ‍್ಹುಥು. ಯೆಹೋವನೆ ಮೋಶೆನ ಹುಕುಮ್‌ ಕರ‍್ಯೊತೆತಿಮ್‌ ಇನ ಕರ‍್ಯು. <verse eid="EXO 39:5" /><verse number="6" style="v" sid="EXO 39:6" />ಮುದ್ರಾನ ಹೀರಾನ ಕೆತ್ತಾನಿ ಪರಕ್ಮ ಬೇ ಗೋಮೇಧಕ ಹೀರಾಮ ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಭಾರ ಖೂಮ್ನು ನಾಮ್ನ ಕೆತ್ತೈನ್‌ ಯೊ ಹೀರಾನ ಚ಼ಂಚಿಮ ಭಾಂದ್ಯು. <verse eid="EXO 39:6" /><verse number="7" style="v" sid="EXO 39:7" />ಬೇ ಹೀರಾವ್ನ ಇಸ್ರಾಯೇಲ್‌ವಾಳಾನ ಖ್ಹಣೇದ್‍ನು ಹೀರಾ ರ‍್ಹವಾನಿಘೊಣಿ ಯೋಅಖ್ಖಾನ ಏಫೋದ್ನ ಖಾಂದಪರ್‌ ರ‍್ಹೆಯಿತೆ ಪಟ್ಟಿಮ ಜ಼ಡ್ಕಾಯೊ. ಯೆಹೋವನೆ ಮೋಶೆನ ಇಮ್ಮಸ್‌ ಹುಕುಮ್‌ಕರ‍್ಯೊ.<verse eid="EXO 39:7" /></para>
  <para style="s">ಛಾ಼ತಿನ ಕವಚ್‌ನ ಕರ‍್ಯುತೆ</para>
  <para style="r">(<ref loc="EXO 28:15-30">ವಿಮೋ 28:15-30</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 39:8" />ಏಫೋದ್‌ನಿ ಘೊಣಿಸ್ ಖ್ಹೊನ್ನಾನ ಧಾಗೇಥಿಬಿ ನೀಲಿ ರಾಯಿಜಾ಼ಮಣ್ಣೊ ರಂಗ್, ಲಲೇಲಾಲ್ ರಂಗ್‌ರ‍್ಹವಾನು ಧಾಗೇಥಿಬಿ ಖ್ಹುತ್ತರ್‌ನಿ ವಣ್ಕರ್‌ನ ಲುಂಗ್ಡಾಮ ಕೋಥ್‌ಳಿನಿತರಾನು ಪದಕ್ನ ಕರಾಯೊ. <verse eid="EXO 39:8" /><verse number="9" style="v" sid="EXO 39:9" />ಯೊ ಚಾರ್‌ಖೂಟಿ ಹುಯಿರ‍್ಹುಥು. ಯೊ ಕೋಥ್‌ಳಿನು ಪದಕ್‌ ಬೇ ಪಧರ್ನು ಹುಯಿರ‍್ಹುಥು. ಯೊ ಏಕ್‌ ಬಿಲೇಶ್‌ ಲಾಂಬುಬಿ ಏಕ್‌ ಬಿಲೇಶ್‌ ಚೌ಼ಡುಬಿ ಹುಯಿರ‍್ಹುಥು. <verse eid="EXO 39:9" /><verse number="10" style="v" sid="EXO 39:10" />ಇನ ಖ್ಹಾಮ್ಣೆ ಚಾರ್‌ ಶಾಲ್‌ಥಿ ಹೀರಾವ್ನ ಲಗಾಡಿರಾಖ್ಯುಥು. ಪಹಿಲಿ ಶಾಲ್ಮ ಮಾಣಿಕ್ಯ ಪುಷ್ಯರಾಗ ಐರೊಖ್ಹಾರು, <verse eid="EXO 39:10" /><verse number="11" style="v" sid="EXO 39:11" />ಬೇನ ಶಾಲ್ಮ ನೀಲಿಮಣ್‌ಕೊ ಅಜು಼ ವಜ್ರಖ್ಹಾರು. <verse eid="EXO 39:11" /><verse number="12" style="v" sid="EXO 39:12" />ತೀನ್ನೆ ಶಾಲ್ಮ ಖ್ಹೊನ್ನಾನೊ ಹೀರೊ, ಸುಗಂಧಿ ಬೂದುಚಿಡ್ಯ. <verse eid="EXO 39:12" /><verse number="13" style="v" sid="EXO 39:13" />ಚಾರ‍್ನಿ ಶಾಲ್ಮ ಗೋಮೇಧಕ, ಬೆರುಲ್ಲ ಅಜು಼ ವೈಢೂರ್ಯಮ ಖ್ಹೊನ್ನಾನ ಮಣ್ಕಾನ ಬೆಖ್ಹಾಡಿರಾಖ್ಯುಥು. <verse eid="EXO 39:13" /><verse number="14" style="v" sid="EXO 39:14" />ಇಸ್ರಾಯೇಲ್‌ವಾಳಾನ ಖೂಮ್ಮ ಗಣ್ತಿನ ಪರಕ್ಮ ಭಾರ ಹೀರಾಥ; ಮುದ್ರಾನ ಹೀರಾಮ ಕೆತ್ತಾನಿ ಪರಕ್ಮ ಏಕೇಕ್‌ ಹೀರಾಮ ಏಕೇಕ್‌ ಖೂಮ್ಮ ನಾಮ್‌ ಟಕೈರ‍್ಹುಥು. <verse eid="EXO 39:14" /><verse number="15" style="v" sid="EXO 39:15" />ಪದಕ್ನ ಉಪ್ಪರ್‌ ಡೋರಿಯೆನಿ ಘೋಣಿನು ಅಫುಟ್‌ ಖ್ಹೊನ್ನಾನು ಖ್ಹಾಕ್‌ಳಿಯೆವ್ನ ವಣ್‌ಖರ್‌ ಕಾಮ್‍ಥಿ ಕರ‍್ಯು. <verse eid="EXO 39:15" /><verse number="16" style="v" sid="EXO 39:16" />ಬೇ ಖ್ಹೊನ್ನಾನು ಮಣ್ಕಾನಾಬಿ ಕರಿನ್‌ ಯೊ ಅಂಗುಠಿಯೆವ್ನ ಛ಼ಾತಿನ ಪದಕ್ನು ಬೇ ಕೋಣಾನಾಬಿ ಅಟ್ಕಾಯು. <verse eid="EXO 39:16" /><verse number="17" style="v" sid="EXO 39:17" />ವಣ್‌ಖರ್‌ ಕಾಮ್ನು ಯೊ ಭೇ ಖ್ಹೊನ್ನಾನು ಖ್ಹಾಕ್‌ಳಿಯೆವ್ನ ಪದಕ್ನ ಕೋಣಾಮ ಛಾ಼ತೆ ಅಂಗುಠಿಯೆವ್ನ ಅಟ್ಕಾಯು. <verse eid="EXO 39:17" /><verse number="18" style="v" sid="EXO 39:18" />ವಣ್‌ಖರ್‌ನ ಕಾಮ್ನು ಯೊ ಖ್ಹಾಕ್‌ಳಿಯೆವ್ನ ಕೋಣಾನ ಏಫೋದ್ನ ಖಾಂದನಿ ಪಟ್ಟಿಮಛಾ಼ತೆ ಬೇ ಮಣ್ಕಾನ ಖ್ಹಾಮ್ಣೆ ಅಟ್ಕಾಯು. <verse eid="EXO 39:18" /><verse number="19" style="v" sid="EXO 39:19" />ಆ ನಾಹುಯಿನ್ ಬೇ ಖ್ಹೊನ್ನಾನು ಅಂಗುಠಿನ ಕರಿನ್ ಯಾಜಕ್‌ನ ಪದಕ್ನು ಮಹಿನು ಕನಾರಿನ ಕೋಣಾವ್‌ಮ ಕವಚ್‌ನ ಖನ್ನೆಸ್‌ ಮ್ಹೇಲ್ಯು. <verse eid="EXO 39:19" /><verse number="20" style="v" sid="EXO 39:20" />ಅಜು಼ ಅಲಕ್ ಬೇ ಖ್ಹೊನ್ನಾನು ಅಂಗುಠಿಯೆವ್ನ ಕರಿನ್ ಕವಚ್‌ನು ಭೇ ಖಾಂದಾವ್ನಿ ಪಟ್ಟಿಯೇವ್ನ ಖ್ಹಾಮ್ಣೆನ ಹೇಟ್, ಏಫೋದ್ನ ಮ್ಹೇಲಿರಾಖ್ಯುತೆ ಝ಼ಗೊನ ಖನ್ನೆ ಯೊ ವಿಚಿತ್ರನು ಕಂಬರ್‌ಪಟಾನ ಉಪ್ಪರ್‌ ಲಗಾಡ್ಯು. <verse eid="EXO 39:20" /><verse number="21" style="v" sid="EXO 39:21" />ಪದಕ್‌ ವಿಚಿತ್ರಹುಯಿರ‍್ಹುತೆ ಕಂಬರ್‌ಪಟಾನಿ ಉಪ್ಲಿ ಬಾಜು಼ಮ ಘಟ್‌ರ‍್ಹವಾನಖ್ಹಾಜೆಬಿ ಚ಼ರ‍್ನೆಥಿ ಛು಼ಟಿನಾಪಡ್ನುತೆತಿಮ್‌ ಇನಿ ಅಂಗುಠಿಯೆಅಖ್ಖಾನ ಚ಼ರ‍್ನಾನ ಅಂಗುಠಿಯೇನ ನೀಲ ಧಾಗೇಥಿ ಭಾಂದ್ಯು. ಯೆಹೋವನೆ ಮೋಶೆನ ಇಮ್ಮಸ್‌ ಹುಕುಮ್‌ಕರ‍್ಯೊ.<verse eid="EXO 39:21" /></para>
  <para style="s">ಯಾಜಕರ‍್ನು ಉಭ್‌ರ‍್ಯುತೆ ಪೆರ್ವಾಖ್ಹ್‌ನಿ ತಯಾರಿ</para>
  <para style="r">(<ref loc="EXO 28:31-43">ವಿಮೋ 28:31-43</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 39:22" />ಏಫೋದ್‌ನಿ ಜೋ಼ಡ್ಮ ಫೇರಾನ ಝ಼ಗ್ಗಾನ ನೀಲಿ ರಂಗ್‌ನ ಲುಂಗ್ಡೇಥಿಸ್ ವಣ್‌ಖರ್‌ನ ಕಾಮ್‍ಥಿ ಕರ‍್ಯೊ. <verse eid="EXO 39:22" /><verse number="23" style="v" sid="EXO 39:23" />ಮುಡ್‌ಕ್ಯು ಘಾಲನಖ್ಹಾಜೆ ಖೀಂಡ್‌ಕರಿನ್‌ ಯೊ ಫಾಟ್ಣುನಾತೆ ಜಂಗ್‌ನ ಝ಼ಗ್ಗಾನಿಮತ್‌ ಯೊ ಖೀಂಡ್‌ನು ಗಿರ್ಕಿನ ವಣಿನ್‌ ವಣ್‌ಖರ್‌ ಕರಾಯೊ. <verse eid="EXO 39:23" /><verse number="24" style="v" sid="EXO 39:24" />ಝ಼ಗ್ಗಾನು ಕನಾರಿನ ಅಶ್‌ಪಿಶ್‌ಬಿ ನೀಲಿ ರಾಯ್‌ಜಾ಼ಮಣ್ಣು ರಂಗ್‌, ಲಲೇಲಾಲ್‌ ಧಾಗೇಥಿ ಢಾಡಮ್‌ನಿಘೋಣಿ ಚೆಂಡುಲ್ನ ಕರ‍್ಯು. <verse eid="EXO 39:24" /><verse number="25" style="v" sid="EXO 39:25" />ಅಜು಼ ಅಫುಟ್‌ ಖ್ಹೊನ್ನೇಥಿ ಘುಗ್ರಾನ ಕರಿನ್‌ ಝ಼ಗ್ಗಾನ ಕನಾರಿನ ಢಾಡಮ್‌ನ ಚಂಡುಲ್ನಿ ಜೋಡ್ಮ ಚಿಕಾಯು. <verse eid="EXO 39:25" /><verse number="26" style="v" sid="EXO 39:26" />ಖ್ಹೊನ್ನಾನು ಘುಗ್ರೊಬಿ ಢಾಡಮ್‌ನಿಘೋಣಿ ಛಾ಼ತೆ ಚಂಡುಲ್ ಏಕ್‌ಥಿಏಕ್‌ ದೇವ್ನ ಸೇವೆನಖ್ಹಾಜೆ ಯೊ ಉಪ್‌ಲ್ಯ ಝ಼ಗ್ಗಾನ ಕನಾರಿನ ಅಶ್‌ಪಿಶ್‌ಬಿ ಥೂ. ಯೆಹೋವನೆ ಮೋಶೆನ ಹುಕುಮ್‌ಕರ‍್ಯೊತೆತಿಮ್‌ ಇನ ಕರ‍್ಯೊ. <verse eid="EXO 39:26" /><verse number="27" style="v" sid="EXO 39:27" />ಆರೋನನಾಬಿ ಇನ ಛಿಯ್ಯವ್‌ನಾಬಿ ಕವ್‌ಳ ಖ್ಹುತ್ತರ್‌ನ ಧಾಗೇಥಿ ವಣ್‌ಖರ್‌ನ ಕಾಮ್ನಿ ಪರಕ್ಮ ಝ಼ಗ್ಗಾವ್‌ನಬಿ <verse eid="EXO 39:27" /><verse number="28" style="v" sid="EXO 39:28" />ಖ್ಹುತ್ತರ್‌ನ ಲುಂಗ್ಡೇಥಿ ಮಹಾಯಾಜಕನ ರುಂಬಾಲ್‌ನಾಬಿ ಇನು ಶನ್‌ಗಾರ‍್ನು ರುಂಬಾಲ್‌ನಾಬಿ ಅಛ್ಛಾ಼ ಖ್ಹುತ್ತರ್‌ನಿ ಮಹಿ ಫೇರಾನು ಲುಂಗ್ಡು <verse eid="EXO 39:28" /><verse number="29" style="v" sid="EXO 39:29" />ಅಛ್ಛಾ಼ ಖ್ಹುತ್ತರ್‌ನ ಲುಂಗ್ಡೇಥಿ ನೀಲಿ ರಾಯ್‌ಜಾ಼ಮಣ್ಣು ರಂಗ್‌ನು ಅಜು಼ ಲಲೇಲಾಲ್‌ ರಂಗ್ನು ಧಾಗೇಥಿಬಿ ವಣ್‌ಖರ್‌ನ ಕಾಮ್ನಿ ಪರಕ್ಮ ಕಂಬರ್‌ನ ಕಷ್‌ಬಂದ್‌ನಾಬಿ ಕರ‍್ಯು. ಯೆಹೋವನೆ ಮೋಶೆನ ಹುಕುಮ್‌ಕರ‍್ಯೊತೆತಿಮ್‌ ಇನ ಕರ‍್ಯು. <verse eid="EXO 39:29" /><verse number="30" style="v" sid="EXO 39:30" />ಅಜು಼ ಅಫುಟ್‌ ಖ್ಹೊನ್ನೇಥಿ ಪರಿಶುದ್ದ ಕಿರೀಟ್ನ ಪಟ್ಟಿನ ಕರಿನ್‌ ಮುದ್ರಾನ ಟಕಾವನಿ ಪರಕ್ಮ ಇನಾಮ “ಯೆಹೋವನ ಖ್ಹಾಜೇಥಿ ಪರಿಶುದ್ದ” ಕರಿ ಲೀಖ್ಯಾಮ ಲೀಖಾಯು. <verse eid="EXO 39:30" /><verse number="31" style="v" sid="EXO 39:31" />ಇನ ರುಂಬಾಲ್ನ ಭಾಂದನಖ್ಹಾಜೆ ನೀಲ ಧಾಗಾನ ಭಾಂದ್ಯು. ಯೆಹೋವನೆ ಮೋಶೆನ ಹುಕುಮ್‌ ಕರ‍್ಯೊತೆತಿಮ್‌ ಇನ ಕರ‍್ಯು.<verse eid="EXO 39:31" /></para>
  <para style="s">ಕಾಮ್ನು ಖ್ಹರ್ತಿ</para>
  <para style="r">(<ref loc="EXO 35:10-19">ವಿಮೋ 35:10-19</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 39:32" />ಆ ಪರಕ್ಮ ದೇವ್ನ ದರ್ಶನ್ನು ಡೇರಾನು ಕಾಮ್‌ಅಖ್ಖು ಖ್ಹರ್ತಿಹುಯು. ಯೆಹೋವನೆ ಮೋಶೆನ ಹುಕುಮ್‌ಕರ‍್ಯೊತೆತಿಮ್‌ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಇನ ಕರ‍್ಯು. <verse eid="EXO 39:32" /><verse number="33" style="v" sid="EXO 39:33" />ತದೆ ಇವ್ಣೆ ಯೊ ಡೇರಾನ ಮೋಶೆನ ಖನ್ನೆ ಲಾಯು. ಡೇರನಾಬಿ ಇನ ಲಾಗ್ಯುತೆ ಅಖ್ಖಾನಾಬಿ ಕತೊ ಇನು ಅಖೂಟೊ, ಚೌಕಟ್‌, ಕಡಿಯೇ ಖಮ್‌, ಹುದಿನೊ ಬಂಡೊ ಅಖ್ಖಾನಾಬಿ; <verse eid="EXO 39:33" /><verse number="34" style="v" sid="EXO 39:34" />ಹದಕರಿಹುಯು ಲಾಲ್‌ರಂಗ್ನು ಮೇಂಢಾನು ಚ಼ಾಂಬ್ಡೇಥಿ ಹುಯುತೆ ಪರ್ಖೊಂಡು, ದರ‍್ಯಾವ್ನ ಜಾನ್ವರ್ನು ಚ಼ಾಂಬ್ಡೇಥಿ ಹುಯುತೆ ಪರ್ಖೊಂಡು, ಮಹಾ ಪವಿತ್ರ ಝ಼ಗೋನ ಓಠೊಕರಾನು ಪಡ್ದೊಬಿ; <verse eid="EXO 39:34" /><verse number="35" style="v" sid="EXO 39:35" />ಹುಕುಮ್ನ ನಿಯಮ್ನು ಪಿಟಾರನ, ಇನ ಲಠ್ಠಅಖ್ಖು ಕೃಪಾಸನ ಅಖ್ಖನಾಬಿ; <verse eid="EXO 39:35" /><verse number="36" style="v" sid="EXO 39:36" />ಮೇಜ್‌, ಇನು ಅಖ್ಖು ರಾಛು಼ಖ್ಹಾರು, ಪರಿಶುದ್ ರೋಟೊ ಅಖ್ಖಾನಾಬಿ; <verse eid="EXO 39:36" /><verse number="37" style="v" sid="EXO 39:37" />ಅಫುಟ್‌ ಖ್ಹೊನ್ನಾನು ದೀವಾನುಖಂಬುಬಿ, ಇನ ಉಪ್ಪರ್‌ ಮ್ಹೇಲ್ನುಥುತೆ ದಿವಳ್ಗಿಅಖ್ಖು, ಇನು ಜಿನಖ್ಹ್‌ಖ್ಹಾರು, ದೀವಾನ ಹೋಣುತೆ ತೇಲ್‌ ಯೊ ಅಖ್ಖುಬಿ; <verse eid="EXO 39:37" /><verse number="38" style="v" sid="EXO 39:38" />ಖ್ಹೊನ್ನಾನು ಢಾಕ್ಣಿಬಿ, ಅಭಿಷೇಕನು ತೇಲ್‌, ವಾಖ್ಹ್‌ನು ಖ್ಹಾಲರ‍್ಯೊಬಿ; ಡೇರಾನು ದರ್ವಾಜ಼ನು ಪಡ್ದೊಬಿ; <verse eid="EXO 39:38" /><verse number="39" style="v" sid="EXO 39:39" />ತಾಂಬಾನು ಚಾ಼ಚ಼ರ್‌ಬಿ, ಇನು ತಾಂಬಾನು ಖಾಂಜ್ರಿಬಿ, ಇನು ಲಠ್ಠಅಖ್ಖು, ಜಿನಖ್ಹ್‌ಖ್ಹಾರು, ಧೊವಾನು ಕುಂಡುಬಿ, ಇನಿ ಝ಼ಗ್ಲಿಬಿ; <verse eid="EXO 39:39" /><verse number="40" style="v" sid="EXO 39:40" />ಬಲ್ಡಾನಿ ಪಡ್ದಖ್ಹಾರು, ಖಮ್‌ಅಖ್ಖು, ಹುದಿನೊ ಬಂಡೊಅಖ್ಖು; ಖ್ಹಾಮ್ಣೆನ ಝ಼ಗೋನು ದರ್ವಾಜ಼ನು ಪಡ್ದೊ, ಇನು ಶಿಂದ್ರು, ಖಿಲ್ಲಾಬಿ; ದೇವ್ನ ದರ್ಶನ್ನು ಡೇರಾನ ಸೇವೆನ ಹೋಣುತೆ ಅಖ್ಖು ಜಿನಖ್ಹ್‌ಖ್ಹಾರುಬಿ; <verse eid="EXO 39:40" /><verse number="41" style="v" sid="EXO 39:41" />ಪವಿತ್ರ ಝ಼ಗೋಮ ಚಾ಼ಲಾತೆ ಸೇವೆನಖ್ಹಾಜೆ ಹೋಣುತೆ ಶನ್‌ಗಾರ‍್ನು ರಾಛು಼ ಕತೊ ಆರೋನನ ಹೋಣುತೆ ಪವಿತ್ರ ಪೆರ್ವಾಖ್ಹ್‌, ಯಾಜಕ್‌ನು ಸೇವೆಕರವಾಳೊ ಹುಯಿರೋತೆ ಇನ ಛಿಯ್ಯವ್‌ನ ಹೋಣುತೆ ಪೆರ್ವಾಖ್ಹ್‌ ಅಖ್ಖಾನಾಬಿ ಲಾಯು. <verse eid="EXO 39:41" /><verse number="42" style="v" sid="EXO 39:42" />ಯೆಹೋವನೆ ಮೋಶೆನ ಹುಕುಮ್‌ ಕರ‍್ಯೊತೆತಿಮ್‌ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಯೊ ಕಾಮ್ನಅಖ್ಖು ಕರ‍್ಯು. <verse eid="EXO 39:42" /><verse number="43" style="v" sid="EXO 39:43" />ಇವ್ಣೆ ಕರ‍್ಯುತೆ ಕಾಮ್ನ ಮೋಶೆ ತರೀಪ್ಷಕರಾಮ ಯೆಹೋವನ ಹುಕುಮ್ನಿಮತ್ ಇವ್ಣೆ ಅಖ್ಖು ಕರಿರಾಖ್ಯುಸ್‌ಕರಿ ಮಾಲುಮ್‌ಕರ್ಲಿನ್‌ ಇವ್ಣುನ ಆಶೀರ್ವಾದ್‌ ಕರ‍್ಯೊ.<verse eid="EXO 39:43" /></para>
  <chapter eid="EXO 39" />
  <chapter number="40" style="c" sid="EXO 40" />
  <para style="s">ಯೆಹೋವನಿ ಸನ್ನಿದಿಮ ಡೇರಾನ ಭೀರಾಖ್ಯೊತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 40:1" />ಯೆಹೋವ ದೇವ್ನೆ ಮೋಶೆನ <verse eid="EXO 40:1" /><verse number="2" style="v" sid="EXO 40:2" />ಪಹಿಲ ಮಹಿನಾನ ಪಹಿಲ ದನ್ನೆ ತೂ ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾನ ಪಾಡಿನ್ ಭೀರಾಕ್‌. <verse eid="EXO 40:2" /><verse number="3" style="v" sid="EXO 40:3" />ದಖ್ಹ್‌ ಹುಕುಮ್ನ ಪಲ್ಗಾನ ಪಿಟಾರನ ಇನಾಮ ಮ್ಹೇಲಿನ್‌ ಯೊ ಪಿಟಾರನ ಪಡ್ದೇಥಿ ಓಠೊಕರ್‌. <verse eid="EXO 40:3" /><verse number="4" style="v" sid="EXO 40:4" />ಇನಕೇಡೆಥು ಮೇಜ್‌ನ ಮಂಗೈನ್‌ ಇನ ಉಪ್ಪರ್‌ ಮ್ಹೇಲ್ನುತೆ ಇನ ಬರೊಬರ್‌ಥಿ ಮ್ಹೇಲ್‌. ದೀವನ ಖಂಬುನ ಮಂಗೈನ್ ಇನಿ ದಿವಳ್ಗಿಯೇನ ಬರೊಬರ್‌ಥಿ ಮ್ಹೇಲ್‌. <verse eid="EXO 40:4" /><verse number="5" style="v" sid="EXO 40:5" />ಹುಕುಮ್‌ನ ಪಲ್ಗಾವ್ನ ಪಿಟಾರನ ಖ್ಹಾಮ್ಣೆಕರಿ ಖ್ಹೊನ್ನಾನ ಢಾಕ್ಣಿನಿ ಝ಼ಗೊ ಮ್ಹೇಲಿನ್‌, ಡೇರಾನ ದರ್ವಾಜಕನ ಪಡ್ದಾನ ಭಾಂದ್‌. <verse eid="EXO 40:5" /><verse number="6" style="v" sid="EXO 40:6" />ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾನ ದರ್ವಾಜಕನ ಖ್ಹಾಮ್ಣೆ ಚಾ಼ಚ಼ರ್‌ನ ಮ್ಹೇಲ್‌. <verse eid="EXO 40:6" /><verse number="7" style="v" sid="EXO 40:7" />ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರನಾಬಿ ಚಾ಼ಚ಼ರ್‌ನ ಬೀಚ್ಮ ಬಾನೆನ ಮ್ಹೇಲಿನ್ ಇನಾಮ ಪಾಣಿನ ಭರಾವ್ಣು. <verse eid="EXO 40:7" /><verse number="8" style="v" sid="EXO 40:8" />ಬಲ್ಡಾನ ಅಶ್‌ಪಿಶ್‌ ಪಡ್ದಾನ ಭೀರಾಖಿನ್‌ ಬಲ್ಡಾನ ದರ್ವಾಜ಼ನ ಪಡ್ದಾನ ಠಂಗಾವ್ಣು. <verse eid="EXO 40:8" /><verse number="9" style="v" sid="EXO 40:9" />ಇನಕೇಡೆಥು ಅಬಿಷೇಕ ತೇಲ್ನಲೀನ್‌ ಡೇರನಾಬಿ ಇನಾಮಛಾ಼ತೆ ಅಖ್ಖಾನ ಇನ ಅಖ್ಖಾ ರಾಛಾ಼ವ್ನ ಅಬಿಷೇಕಕರೀನ್‌ ಅರ್ಪಣ್‌ಕರ್‌. ತಪ್‌ಥು ಯೊ ಪರಿಶುದ್ದ ಹುಯಿರ‍್ಹಿಶೆ. <verse eid="EXO 40:9" /><verse number="10" style="v" sid="EXO 40:10" />ಬಲಿನ ಚಾ಼ಚ಼ರ‍್ನಾಬಿ ಇನ ರಾಛಾ಼ವ್ನಾಬಿ ಅಬಿಷೇಕ್ ಕರಿನ್‌ ಬಲಿನ ಚಾ಼ಚ಼ರ್‌ನ ಅರ್ಪಣ್‌ಕರ್‌ ಯೊ ಘಣು ಪರಿಶುದ್ದ ಹುಯಿರ‍್ಹೇವ್ಣು. <verse eid="EXO 40:10" /><verse number="11" style="v" sid="EXO 40:11" />ಪಾಣಿನಿ ಬಾನೆನ ಇನ ಝ಼ಗ್ಲಿನ ಅಬಿಷೇಕ್‌ಕರಿನ್ ಅರ್ಪಣ್‌ಕರಿನ್ ನೇಮಕ್‌ ಕರ‍್ನು.<verse eid="EXO 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 40:12" />“ಆ ಕಾಹೆತೆ ಆರೋನನಾಬಿ ಅಜು಼ ಇನ ಛಿಯ್ಯಾವ್‍ನ ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾನ ದರ್ವಾಜ಼ನ ಖನ್ನೆ ಲಯಿನ್ ಇವ್ಣುನ ಪಾಣಿ ನ್ಹೊವಾಡಿನ್, <verse eid="EXO 40:12" /><verse number="13" style="v" sid="EXO 40:13" />ಆರೋನ ಮನ ಯಾಜಕ ಹುಯಿರ‍್ಹವಾನಿತರ ಇನ ಯೊ ಯಾಜಕ್‌ನ ಪವಿತ್ರ ಪೇರ್ವಾಖ್ಹ್‌ನ ಫೇರೈನ್‌ ಇವ್ಣುನ ಅಬಿಷೇಕ್ ಕರಿನ್‌ ಅರ್ಪಣ್‌ಕರ್‌. <verse eid="EXO 40:13" /><verse number="14" style="v" sid="EXO 40:14" />ಇನಕೇಡೆಥು ಇನ ಛಿಯ್ಯಾವ್ನ ಬುಲಾವ್‌. <verse eid="EXO 40:14" /><verse number="15" style="v" sid="EXO 40:15" />ಇವ್ಣುನ ಪೆರ್ವಾಖ್ಹ್‌ನ ಫೇರೈನ್‌ ಇವ್ಣೆ ಮಾರಖ್ಹಾಜೆ ಯಾಜಕ ಹುಯಿರ‍್ಹಾವನಖ್ಹಾಜೆ ತೂ ಇನ ಬಾನ ಅಬಿಷೇಕ್ ಕರ‍್ಯೊತೆತಿಮ್‌ ಇವ್ಣುನಾಬಿ ಅಬಿಷೇಕಕರ್‌. ಆ ಅಬಿಷೇಕ್‌ಥಿ ಯಾಜಕನು ಕಾಮ್ನ ಇವ್ಣುನಾಬಿ ಇವ್ಣ ಪಿಳ್ಗಿವಾಳನಬಿ ಕದೆಕದೇಬಿ ರ‍್ಹಿಶೆ” ಕರಿ ಬೋಲ್ಯು. <verse eid="EXO 40:15" /><verse number="16" style="v" sid="EXO 40:16" />ಯೆಹೋವನೆ ಹುಕುಮ್‌ಕರ‍್ಯೊತೆತಿಮ್‌ ಮೋಶೆನೆ ಅಖ್ಖಾನ ಕರ‍್ಯೊ. <verse eid="EXO 40:16" /><verse number="17" style="v" sid="EXO 40:17" />ಬೇನೆ ವರಖ್ಹ್‌ಮ ಪಹಿಲ ಮಹಿನಾನ ಪಹಿಲ ದನ್ಮ ಇನೆ ಡೇರಾನ ಪಾಡಿನ್ ಭೀರಾಖ್ಯೊ. <verse eid="EXO 40:17" /><verse number="18" style="v" sid="EXO 40:18" />ಮೋಶೆ ಡೇರಾನ ಭೀರಾಖಿನ್‌ ಇನ ಹುದಿನ ಬಂಡಾನಅಖ್ಖು ನಾಖಿನ್ ಚೌಕಟ್ಅಖ್ಖಾನ ಭೀರಾಖಿನ್‌ ಗಡಾನ ದೀನ್‌ ಖಂಬಾನ ಭೀರಾಖ್ಯೊ. <verse eid="EXO 40:18" /><verse number="19" style="v" sid="EXO 40:19" />ಡೇರಾನಘರ್‌ಪರ್‌ ಡೇರಾನ ಲುಂಗ್ಡಾನ ಢಪೈನ್‌ ಯೊ ಡೇರಾನ ಉಪ್ಪರ್‌ ಮೂಚಾ಼ಯೊ. ಯೆಹೋವನ ಹುಕುಮ್ನಿಘೋಣಿ ಮೋಶೆ ಆ ಅಖ್ಖುಕರ‍್ಯೊ. <verse eid="EXO 40:19" /><verse number="20" style="v" sid="EXO 40:20" />ಹುಕುಮ್ನ ಪಲ್ಗಾನ ಪಿಟಾರಮ ಮ್ಹೇಲಿನ್‌ ಪಿಟಾರನ ಲಠ್ಠೇಥಿ ಖ್ಹಪ್‌ಡೈನ್‌ ಕೃಪಾಸನನ ಮ್ಹೇಲಿರಾಖಿನ್, <verse eid="EXO 40:20" /><verse number="21" style="v" sid="EXO 40:21" />ಪಿಟಾರನ ಡೇರಾನಮಹಿ ಲಯಿನ್, ಇನ ಖ್ಹಾಮ್ಣೆ ಪಡ್ದಾನ ಠಂಗೈನ್‌, ಯೆಹೋವ ಹುಕುಮ್‌ ಕರ‍್ಯೊತೆತಿಮ್‌ ಮೋಶೆ ಹುಕುಮ್‌ನು ಪಲ್ಗಾನ ಪಿಟಾರನ ಓಠೊಕರ‍್ಯೊ. <verse eid="EXO 40:21" /><verse number="22" style="v" sid="EXO 40:22" />ಆ ಕಾಹೆತೆ ಯೆಹೋವನೆ ಹುಕುಮ್‌ ಕರ‍್ಯೊತೆತಿಮ್‌ ಮೋಶೆನೆ ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾನಮಹಿ ಉತ್ತರ‍್ನಿಭಾಗ್‌ಮ ಪಡ್ದಾನ ಭಾರ್‌ ಮೇಜ್‌ನ ಮ್ಹೇಲಿನ್‌, <verse eid="EXO 40:22" /><verse number="23" style="v" sid="EXO 40:23" />ಯೆಹೋವನೆ ಮೋಶೆನ ಹುಕುಮ್‌ ಕರ‍್ಯೊತೆ ಇಮ್ ಇನ ಉಪ್ಪರ್‌ ಯೆಹೋವನಿ ಝ಼ಗೋಮ ರೋಟಾನ ಢೇರಿಕರ‍್ಯೊ. <verse eid="EXO 40:23" /><verse number="24" style="v" sid="EXO 40:24" />ಇನೆ ದೀವಾನು ಖಂಬ್‌ನ ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾನ ಘರ್‌ಮ ಖುಡ್‌ಶಿನ ಖ್ಹಾಮ್ಣೆ ಡೇರಾನ ದಕ್ಷಿಣ್‌ ಬಾಜು಼ಮ ಮ್ಹೇಲಿನ್‌, <verse eid="EXO 40:24" /><verse number="25" style="v" sid="EXO 40:25" />ಯೆಹೋವನೆ ಮೋಶೆನ ಹುಕುಮ್‌ ಕರ‍್ಯೊತೆ ಇಮ್ಮಸ್ ಇನಿ ದಿವಳ್ಗಿನ ಯೆಹೋವನ ಸನ್ನಿದಿಮ ಬರೋಬರ್‌ಥಿ ಮ್ಹೇಲ್ಯೊ. <verse eid="EXO 40:25" /><verse number="26" style="v" sid="EXO 40:26" />ಅಜು಼ ಖ್ಹೊನ್ನಾನು ಢಾಕ್ಣಿನ ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾಮ ಪಡ್ದಾನಖ್ಹಾಮ್ಣೆ ಮ್ಹೇಲಿನ್‌, <verse eid="EXO 40:26" /><verse number="27" style="v" sid="EXO 40:27" />ಯೆಹೋವನೆ ಮೋಶೆನೆ ಹುಕುಮ್‌ ಕರ‍್ಯೊತೆ ಇಮ್ಮಸ್ ಇನ ಉಪ್ಪರ್‌ ವಾಖ್ಹ್‌ನು ತೇಲ್ನ ಢಪ್ಕಾರ ನಾಖ್ಯೊ. <verse eid="EXO 40:27" /><verse number="28" style="v" sid="EXO 40:28" />ಅಜು಼ ಇನೆ ಡೇರಾನ ದರ‍್ವಾಜ಼ನ ಪಡ್ದಾನ ಘಲಾಯೊ. <verse eid="EXO 40:28" /><verse number="29" style="v" sid="EXO 40:29" />ಯೆಹೋವನೆ ಮೋಶೆನ ಹುಕುಮ್‌ಕರ‍್ಯೊತೆತಿಮ್‌ ದೇವ್ನದರ್ಶನ್ನ ಡೇರಾನ ದರ‍್ವಾಜ಼ನ ಖ್ಹಾಮ್ಣೆ ಚಾ಼ಚ಼ರ್‌ನ ಮ್ಹೇಲಿನ್‌ ಇನ ಉಪ್ಪರ್ ಬಳಾನಿ ಬಲಿನಾಬಿ ಅನಾಜ಼್‌ನಿ ಅರ್ಪಣ್‌ಕರ‍್ಯೊ. <verse eid="EXO 40:29" /><verse number="30" style="v" sid="EXO 40:30" />ಮೋಶೆ ದೇವ್ನ ದರ್ಶನ್ನು ಡೇರನಾಬಿ, ಬಲಿನಿ ಚಾ಼ಚ಼ರ‍್ನಾಬಿ ಬೀಚ್ಮ ಪಾಣಿನ ಬಾನೆನ ಮ್ಹೇಲಿನ್‌, <verse eid="EXO 40:30" /><verse number="31" style="v" sid="EXO 40:31" />ಇನಾಮ ಮೋಶೆಬಿ ಆರೋನಬಿ ಇನ ಛಿಯ್ಯಾವ್‌ಬಿ ಧೊವಾನಖ್ಹಾಜೆ ಇನಾಮ ಪಾಣಿನ ಭರಾಯೊ. <verse eid="EXO 40:31" /><verse number="32" style="v" sid="EXO 40:32" />ಮೋಶೆ ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾನ ಮಹಿ ಜ಼ಾವಾನಿವಖ್ಹ್‌ತೆಬಿ ಚಾ಼ಚ಼ರ್‌ನ ಸೇವೆನ ಆವಾನಿವಖ್ಹ್‌ತೆಬಿ ಹಾತ್‌ಗೋಡಾವ್ನ ಧೊಯಿಲಿಶೆ. <verse eid="EXO 40:32" /><verse number="33" style="v" sid="EXO 40:33" />ಡೇರಾನ ಅಜು಼ ಚಾ಼ಚ಼ರ್‌ನ ಅಶ್‌ಪಿಶ್‌ ಮರೆಲಾವ್ನ ಭೀರಾಖಿನ್‌ ಬಲ್ಡಾನ ದರ್ವಾಜ಼ನ ಪಡ್ದಾನ ಘಲಾಯೊ. ಅಮ್‌ ಮೋಶೆನೆ ಯೊ ಕಾಮ್ನಅಖ್ಖು ಖ್ಹರ್ತಿಕರ‍್ಯೊ.<verse eid="EXO 40:33" /></para>
  <para style="s">ದೇವ್ನದರ್ಶನಾನ ಡೇರಾಪರ್‌ ವಾದ್‌ಳು ಢಪಾಯುತೆ</para>
  <para style="r">(<ref loc="NUM 9:15-23">ಅರಣ್ಯ 9:15-23</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 40:34" />ತದೆ ವಾದ್‌ಳುಏಕ್‌ ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾನ ಮೂಚಿನಾಖ್ಯು; ಯೆಹೋವನಿ ಉಜಾ಼ಖ್ಹ್‌ ಡೇರಾಮ ಭರೈಗು. <verse eid="EXO 40:34" /><verse number="35" style="v" sid="EXO 40:35" />ವಾದ್‌ಳು ದೇವ್ನ ದರ್ಶನ್ನ ಡೇರಾನ ಉಪ್ಪರ್‌ ಭಿಯುಥೂತೆ ಇನಖ್ಹಾಜೆ ಯೆಹೋವನಿ ಉಜಾ಼ಖ್ಹ್‌ ಡೇರಾನಮಹಿ ಭರೈಗುಥುತೆ ಇನಖ್ಹಾಜೆ ಮೋಶೆ ಡೇರಾಮ ಜಾ಼ವಾನ ಕೋಹುಯುನಿ. <verse eid="EXO 40:35" /><verse number="36" style="v" sid="EXO 40:36" />ಯೊ ವಾದ್‌ಳು ಡೇರಾನ ಮ್ಹೇಲಿನ್‌ ಉಪ್ಪರ್‌ ಜಾ಼ವಖ್ಹತರ್ ಇಸ್ರಾಯೇಲ್‌ವಾಳು ಖ್ಹಾಮ್ಣೆ ಚಾ಼ಲ್‌ತು ನಿಕ್‌ಳ್ಯು. <verse eid="EXO 40:36" /><verse number="37" style="v" sid="EXO 40:37" />ಯೊ ವಾದ್‌ಳು ಮ್ಹೇಲ್ಯುಕೊಂತೆ ರ‍್ಹವಾನಿವಖ್ಹ್‌ತೆ ಯೊ ನಿಕ್‌ಳಲಗು ಕೋಜಾ಼ತುಥುನಿ. <verse eid="EXO 40:37" /><verse number="38" style="v" sid="EXO 40:38" />ಇಸ್ರಾಯೇಲ್‌ವಾಳನು ಅಖ್ಖು ಚಾ಼ಲ್‌ಕುಚ಼್‌ಮಾಬಿ ಇವ್ಣ ಡೋಳಾನಖ್ಹಾಮ್ಣೆ ದನ್ನಿ ವೇಳ್ಮ ಯೆಹೋವನು ವಾದ್‌ಳು ಡೇರಾನ ಉಪ್ಪರ್‌ ರ‍್ಹೇತುಥು; ರಾತ್ನಿ ವೇಳ್ಮ ಯೊ ವಾದ್ಳಾನಮಹಿ ಆಗ್‍ನಿ ಉಜಾ಼ಖ್ಹ್‌ ರ‍್ಹೇತುಥು.<verse eid="EXO 40:38" /></para>
  <chapter eid="EXO 40" />
</usx>