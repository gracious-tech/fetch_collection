<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">-WAGHRI</book>
  <para style="h">ಫಿಲೆಮೋನ</para>
  <para style="toc3">ಫಿಲೆಮೋನ</para>
  <para style="toc2">ಫಿಲೆಮೋನ</para>
  <para style="toc1">ಪೌಲನೆ ಫಿಲೆಮೋನನ ಲೀಖ್ಯೋತೆ ಚಿಟ್ಟಿ</para>
  <para style="mt2">ಫಿಲೆಮೋನನಿಗೆ ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="mt1">ಪೌಲನೆ ಫಿಲೆಮೋನನ ಲೀಖ್ಯೋತೆ ಚಿಟ್ಟಿ</para>
  <para style="imt">ಮಾಲುಮ್‌ ಕರಾನು</para>
  <para style="ip">ಫಿಲೆಮೋನನ ಲೀಖ್ಯೋತೆ ಚಿಟ್ಟಿನ ಆ ನ್ಹಾನ ಪುಸ್ತಕನ ಅಪೊಸ್ತಲ ಪೌಲನೆ ಲೀಖಿರಾಖ್ಯೊಸ್. <char style="xt"><ref loc="PHM 1:1">1:1</ref></char> ಆ ಚಿಟ್ಟಿನ ಲೀಖಾನಿ ವಖ್ಹ್‌ತೆ ಪೌಲ ಖ್ಹಾರ್ಕೊಟ್‌ಮ ಥೊ. ಇನಖ್ಹಾಜೆ ಯೋ ಘಣೇಥಿ ಆ ಚಿಟ್ಟಿನ ರೋಮ್ ನಂಗರ್‌ಮ ಲೀಖಿರಾಖ್ಯೊಉಷೆ. ಯೋ ರೋಮ್ಮ ರ‍್ಹಯೊಉಷೇತೊ ಆ ಚಿಟ್ಟಿ ಕ್ರಿಸ್ತ ಪೈದಹುಯಿನ್ 61 ವರಖ್ಹ್‌ನ ಬಾದ್ಮ ಲೀಖಿರಾಖ್ಯೊಸ್. ಕೊಲೊಸ್ಸೆವಾಳಾನ ಲೀಖ್ಯೋತೆ ಚಿಟ್ಟಿಜಿನು ಆಸ್ ವೇಳ್ಮ ಲೀಖೈರ‍್ಹುಸ್.</para>
  <para style="ip">ಆ ಚಿಟ್ಟಿನ ಫಿಲೆಮೋನಕರಿ ಏಕ್‍ಜ಼ಣಾನ ಲೀಖೈರುಸ್. ಫಿಲೆಮೋನ ಏಕ್‌ ಸಬೇನೊ ವಿಶ್ವಾಸಿ ಹುಯಿರ‍್ಹೋಥೊ. ಜೋ಼ಡ್ಮ ಏಕ್‍ ಗುಲಾಮ್‌ನ ಯಜಮಾನ್ ಹುಯಿರ‍್ಹೋಥೊ. ಪೌಲ ಫಿಲೆಮೋನನ ಇನೊ ಗುಲಾಮ್ ಹುಯಿರೊಥೋತೆ ಒನೇಸಿಮಕರಿ ಬೋಲೈಲ್ಯವಾಳನ ಖ್ಹತಾವ್ಣುನಾಕರಿ ಬೋಲ್ಯೊತೆ ಇನಖ್ಹಾಜೆ ಲೀಖುಕರುಸ್. ಶನಕತೊ ಒನೆಸೀಮ ಫಿಲೆಮೋನಥಿ ಚೋ಼ರ್ ಕರೀನ್ ನಾಶಿ ಚ಼ಲೆಗೋಥೊ. ರೋಮ್‍ವಾಳಾನಿ ಕಾನೂಲ್‌ನಿಘೋಣಿ ಫಿಲೆಮೋನ ಒನೆಸೀಮನ ಮರಣ್ಣಿ ನಿಶತ್ ದ್ಯವಾನಿ ಹಕ್‌ಥಿ. ಪೌಲನೆ ಫಿಲೆಮೋನನ ಓನೆಸೀಮನ ಏಕ್‌ ವಿಶ್ವಾಸಿ ಭೈ ಬಣೈನ್ ಸ್ವೀಕಾರ್ ಕರಿಲೇವ್ಣು. ಅಜು಼ ಪೌಲಭಣಿ ಒನೆಸೀಮನ ಏಕ್‌ ಜೋ಼ಡ್‌ನೊ ಸೇವಕ್ ಹುಯಿನ್ ಸೇವೆಕರಾನ ಮ್ಹೇಲಿದೆವ್ಣು ಕರಿ ಖ್ಹೂಜ಼್ ಬೋಲಿದ್ಯವಾಳೊ ಫಿಲೆಮೋನನ ಮನ್ ಫರಾವನಿ ವಾತ್‍ಚೀತ್ನ ಲೀಖಿರಾಖ್ಯೊಸ್. <char style="xt"><ref loc="PHM 1:13-14">1:13-14</ref></char></para>
  <para style="iot">ಕಾಡಿದೇಖೊ</para>
  <para style="io1">1. ಪೌಲ ಫಿಲೆಮೋನನ ಬಿಂತಿಕರಸ್. <char style="ior"><ref loc="PHM 1:1-3">1:1-3</ref> </char></para>
  <para style="io1">2. ಇನಕೇಡೆಥು ಪೌಲನೆ ಫಿಲೆಮೋನನ ಒನೆಸೀಮನ ಏಕ್‌ ವಿಶ್ವಾಸಿ ಭೈನಿಘೋಣಿ ಸ್ವೀಕಾರ್ ಕರಿಲೇವ್ಣುಕರಿ ಬೋಲಿಲಿದೋತೆ, <char style="ior"><ref loc="PHM 1:4-21">1:4-21</ref></char></para>
  <para style="io1">3. ಪೌಲ ಯೊ ಭೇಟಿ ಕರಾನಿ ಉದ್ದೇಶ್ನ ಬೋಲ್ತೊಹುಯಿನ್ ಅಜು಼ ಖ್ಹಲಾಮ್ ಕರ್ತೊಹುಯಿನ್ ಚಿಟ್ಟಿನ ಖ್ಹರ್ತಿಕರಸ್. <char style="ior"><ref loc="PHM 1:22-25">1:22-25</ref></char></para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="s">ಖ್ಹಲಾಮ್</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>ಯೇಸು ಕ್ರಿಸ್ತನಖ್ಹಾಜೆ ಜೇಲ್‌ಮ ಛಾ಼ತೆ ಪೌಲಬಿ ಭೈಹುಯಿರ‍್ಹೊತೆ ತಿಮೊಥೆಯಬಿ ಅಪ್ಣುನ ಪ್ಯಾರ್‌ನೊಬಿ ಜೋ಼ಡ್ಮಕಾಮ್‍ ಕರಾವಾಳೋಬಿ ಹುಯಿರ‍್ಹೋತೆ ಫಿಲೆಮೋನನಾಬಿ, <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>ಭೇನ್ ಹುಯಿರ‍್ಹೀತೆ ಅಪ್ಫಿಯನಾಬಿ ಅಪ್ಣೊ ಜೋ಼ಡ್‌ನೊ ಶಿಪಾಯಿ ಹುಯಿರ‍್ಹೋತೆ ಅರ್ಖಿಪ್ಪನಾಬಿ ತುಮಾರ ಘರ್‌ಮ ಭರಾವಸ್ತೆ ಸಬೆವಾಳನಾಬಿ ಲೀಖೂಸ್ತೆ ಶಾತ್‍ಕತೊ; <verse eid="PHM 1:2"/><verse number="3" style="v" sid="PHM 1:3"/>ಅಪ್ಣೊ ಬಾ ಹುಯಿರ‍್ಹೂತೆ ದೇವ್‍ಥೀಬಿ ಪ್ರಭು ಹುಯಿರ‍್ಹೋತೆ ಕ್ರಿಸ್ತ ಯೇಸುಥೀಬಿ ತುಮುನ ವಾರ್‌ಖ್ಹೊಬಿ ಶಾಂತಿಬಿ ಹುವಾದೆ.<verse eid="PHM 1:3"/></para>
  <para style="s">ಫಿಲೆಮೋನನಿ ಪ್ಯಾರ್ ಅಜು಼ ವಿಶ್ವಾಸ್</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>ಮಾರಿ ಪ್ರಾರ್ಥನೆಮ ಕದೇಬಿ ತುನ ಯಾದ್‍ಕರ‍್ಲಿನ್ ಮಾರ ದೇವ್ನ ಧನ್ಯವಾದ್ ಕರುಸ್. <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>ಶನಕತೊ ದೇವ್ನ ಅದ್ಮಿವೋನಖ್ಹಾಜೆ ಛಾ಼ತೆ ತಾರಿ ಪ್ಯಾರ್ ಅಜು಼ ಪ್ರಭು ಯೇಸುಮ ಛಾ಼ತೆ ವಿಶ್ವಾಸ್‌ನಿ ಬಾರೇಮ ಖ್ಹಮ್‍ಜಿರಾಖ್ಯೊಸ್. <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>ಕ್ರಿಸ್ತಯೇಸುಮ ಅಪ್ಣುನ ಮಳಿರ‍್ಹುಸ್ತೆ ಅಖ್ಖೀಸ್ ಅಛ್ಛಿವರಾನಿ ಬಾರೇಮ ತೂ ಮಾಲುಮ್‌ ಕರಿಲೆವ್‌ಕರಾಸ್‌ ಕ್ರಿಸ್ತನಿ ವಿಶ್ವಾಸ್ಮಛಾ಼ತೆ ತಾರಿ ಗಳ್‍ಜೋ಼ಡ್ಮಾಬಿ ಕ್ರಿಸ್ತನ ಜಾ಼ಖ್ಹತ್ ಮಹಿಮೆನ ತಯಾರ್ ಕರ್ನುಕರಿ ಪ್ರಾರ್ಥನೆ ಕರುಸ್. <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>ಪ್ಯಾರ‍್ನೊ ಭೈ, ತಾರೇಥಿ ದೇವ್ನ ಅದ್ಮೆವ್‍ನ ದಿಲ್ನ ಖ್ಹುಶಿಬಿ ಹುಮ್ಮಖ್ಹ್‌ ಹುಯೂತೆಖ್ಹಾಜೆ ಇವ್ಣಿ ಬಾರೇಮ ಛಾ಼ತೆ ಪ್ಯಾರ್‌ಥಿ ಮನ ಘಣು ಖ್ಹುಶಿಬಿ ಸಮಾಧಾನ್‍ಬಿ ಹುಯು.<verse eid="PHM 1:7"/></para>
  <para style="s">ಒನೇಸಿಮಾನಖ್ಹಾಜೆ ಪೌಲನಿ ಬಿಂತಿ</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>ಇನಖ್ಹಾಜೆ ತೂ ಕರ್ನುತೆ ಏಕ್‍ ಕಾಮ್ ಛಾ಼ ಇನ ತೂ ಬರಬರ್‌ಥಿ ಕರ್ನುಕರಿ ಹುಕುಮ್‌ ದ್ಯವಾನಖ್ಹಾಜೆ ಮನ ಕ್ರಿಸ್ತಮ ಪೂರ ಅಧಿಕಾರ್‌ ಛಾ಼. <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>ಕತೋಬಿ ಪ್ಯಾರ್‌ನಿ ಆಧಾರ್‌ಪರ್ ಮೇ ತುಮೂನ ಗಿಂಗೈಲೆವುಸ್, ಏಕ್‌ ಬುಢೊ ಹುಯಿರೋತೆ ಪೌಲಹುಯಿರೋತೆ ಅಜು಼ ಕ್ರಿಸ್ತನಖ್ಹಾಜೆ ಜೇಲ್‌ಮ ಘಲೈರೋತೆ ಮೇ ಅನ ಕರುಕರೂಸ್. <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>ಮೇ ಜೇಲ್‌ಮ ಕೋಂಡೈರ‍್ಹವಾನಿ ವಖ್ಹ್‌ತೆ ಮಾರ ಛಿಯ್ಯಾನಿತರ ಆಯೋತೆ ಓನೇಸಿಮನಿ ಬಾರೇಮ ತುನ ಗಿಂಗೈಲೆವುಸ್. <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>ಯೋ ಪಹಿಲೆ ತುನ ಬಿಣ್‍ಫಾಯ್ದನೊ ಹುಯಿರ‍್ಹೋಥೊ. ಕತೋಬಿ ಹಮ್ಕೆ ತುನಾಬಿ ಮನಾಬಿ ಫಾಯಿದಾವಾಳು ಹುಯಿರ‍್ಹೋಸ್. <verse eid="PHM 1:11"/><verse number="12" style="v" sid="PHM 1:12"/>ಮಾರ ಜಾನ್ನ ಪ್ಯಾರ್‌ನೊ ಇನ ತಾರಾಕನ ಪಾಛೊ಼ ಮೋಕ್ಲುಕರುಸ್. <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>ಸುವಾರ್ತೆನಖ್ಹಾಜೆ ಜೇಲ್‌ಮ ಥೋತೆ ತದೆ ಮನ ದೇಕ್‌ಭಾಲ್‍ ಕರಾನಖ್ಹಾಜೆ ತಾರಬದಲ್ ಇನ ಮಾರಕನಸ್ ರಾಖಿಲೆವ್ಣುಕರಿ ಸೋಚ್ಯೊಥೊ. <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>ಕತೋಬಿ ತಾರಿ ವಾತ್‍ಕೊಂತೆ ಶಾತ್ ಕರಾನಬಿ ಮನ ಆಖ್ಹ್‌ಕೊಯ್ನಿ. ‍ಶನಕತೊ ತಾರು ಅಛ಼್ಛುಕಾಮ್ ಶೊಂತ್ ಖ್ಹೂಜ಼್‍ಥಿ ಕರ್ನುಪಣ್ಕಿ ಜು಼ಲಮ್‌ಥಿ ಕರಾನು ನಾ ಹುಯಿರ‍್ಹೇಣು. <verse eid="PHM 1:14"/><verse number="15" style="v" sid="PHM 1:15"/>ಯೋ ಥೋಡದನ್ ತಾರೇಥಿ ಅಲಕ್ ಹುಯೋತೆ, ಬೋಲ್ನುಕತೊ ತೂ ಇನ ಹರ್‌ಹಮೇಶ ಮಳೈಲ್ಯಾವಾನ ಖ್ಹಾಜೆಸ್ ರ‍್ಹೇವ್ಣು. <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>ಅನಪಾರ್ ಯೋ ಗುಲಾಮ್ ನಾಹುಯಿರ‍್ಹೇವ್ಣುತೆ, ಕತೋಬಿ ಯೊ ಗುಲಾಮ್‌ಥೀಬಿ ಘಣೊ ಊಚೊ಼ ಛಾ಼. ಯೋ ವಿಶೇಷ್‍ಪರಕ್ಮ ಮನ ಘಣೊ ಪ್ಯಾರ್‌ನೊ ಭೈ ಹುಯಿರೋಸ್ ಅಮ್‍ ರ‍್ಹವಾಪರ್ ಏಕ್‌ ಜಗತ್‌ನೊ ಭೈಹುಯಿನ್ ಪ್ರಭುನ ಸಂಬಂದಾಮ ಬಿಜೂ಼ಬಿ ಕೆತ್ರೇಕ್ಕಿ ಮನಾಬಿ ತುನ ಪ್ಯಾರ‍್ನೊ ಹುಯಿರ‍್ಹಿಶೆ ಕೊಯ್ನಿಕಿ ಶು? <verse eid="PHM 1:16"/><verse number="17" style="v" sid="PHM 1:17"/>ಇನಖ್ಹಾಜೆ ತೂ ಮನ ಜೋ಼ಡ್‍ವಾಳೊ ಕರಿ ಗಣ್ತಿಕರ‍್ತೊ ಉಶೇತೊ ಮನ ಸ್ವಾಗತ್ ಕರಾನಿ ಪರಕ್ಮಾಸ್‍ ಇನ ಸ್ವಾಗತ್‍ಕರ‍್ಲೆ. <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>ಏಕ್‍ ವಖ್ಹತ್ ಯೋ ತುನ ಕಾಯಿತೋಬಿ ಲುಕ್ಷಾನ್‌ ಕರ‍್ಯೊ ಉಶೇತೊ ನತರ್ ಯೋ ಕಾಯಿತೋಬಿ ದೇವ್ಣುಉಶೇತೊ ಇನ ಮಾರಿ ಗಣ್ತಿಮ ನಾಖಿದೆ. <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>ಪೌಲಕರಿ ಮೇ ಶೊಂತ್ ಹಾತೇಥಿ ಲೀಖಿರಾಖ್ಯೊಸ್, ಮೇಸ್ ಇನ ಫೇಡಿಶ್, ತಾರಿ ಶೊಂತ್ನಿ ಬಾರೇಮ ಮನಛಾ಼ತೆ ಕರ್ನಿನಿ ಬಾರೇಮ ಮೇ ಶಾತ್ಬಿ ಬೋಲುಕೊಯ್ನಿ. <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>ಒಹೋಲ ಭೈ, ಪ್ರಭುಮ ತಾರೇಥಿ ಮನ ಫಾಯಿದೊ ಹುವಾದೆ. ಪ್ರಭು ಕ್ರಿಸ್ತಮ ಮಾರ ದಿಲ್ನ ತಾಜು಼ಕರ್‌. <verse eid="PHM 1:20"/><verse number="21" style="v" sid="PHM 1:21"/>ತಾರಿ ವಿಧೇಯತೆಮ ಭರೋಖ್ಹೊಕರೀನ್ ಮೇ ತುನ ಲೀಖಿರಾಖ್ಯೊಸ್. ಮೇ ಬೋಲ್ಯೋತೆ ಇಂಥಿ ಜಾ಼ಖ್ಹತಸ್‍ ತೂ ಕರೀಶ್‌ಕರಿ ಮನ ಮಾಲುಮ್‌ ಛಾ಼. <verse eid="PHM 1:21"/><verse number="22" style="v" sid="PHM 1:22"/>ಆ ನಾಹುಯಿನ್, ತುಮಾರಿ ಪ್ರಾರ್ಥನೆನ ಖ್ಹಮ್‌ಜಿನ್‌ ಮೇ ತುಮಾರಕನ ಆವಾನ ದಯಕರ್‌ಶೆ ಕರಿ ಮನ ವಿಶ್ವಾಸ್ ಛಾ಼. ಇನಾಖ್ಹಾಜೆ ಮನ ಏಕ್‌ ರ‍್ಹವಾನ ಕೋಣಾನ ತಯಾರ್‌ಕರ್‌.<verse eid="PHM 1:22"/></para>
  <para style="s">ಖ್ಹರ್ತಿನು ಖ್ಹಲಾಮ್‌ಖ್ಹಾರು</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>ಕ್ರಿಸ್ತ ಯೇಸುನಖ್ಹಾಜೆ ಜೇಲ್‌ಮ ಮಾರಿ ಜೋ಼ಡ್ಮ ಛಾ಼ತೆ ಎಪಫ್ರಬಿ ತುನ ಖ್ಹಲಾಮ್ ಬೋಲಸ್. <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>ಮಾರ ಜೋ಼ಡ್ಮಕಾಮ್‍ ಕರಾವಾಳ ಹುಯಿರ‍್ಹಾತೆ ಮಾರ್ಕ, ಅರಿಸ್ತಾರ್ಕ, ದೇಮ ಅಜು಼ ಲೂಕ ಅವ್ಣೇಬಿ ತುನ ಖ್ಹಲಾಮ್ ಕರಸ್. <verse eid="PHM 1:24"/><verse number="25" style="v" sid="PHM 1:25"/>ಅಪ್ಣೊ ಪ್ರಭು ಹುಯಿರ‍್ಹೋತೆ ಯೇಸು ಕ್ರಿಸ್ತನೊ ವಾರ್‌ಖ್ಹೊ ತುಮಾರ ಆತ್ಮನಿ ಜೋ಼ಡ್ಮ ರ‍್ಹವಾದೆ. ಆಮೆನ್.<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
