<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Waghari Old Testment</book>
  <para style="h">ಹಬಕ್ಕೂಕ್‍</para>
  <para style="toc3">ಹಬಕ್ಕೂಕ್‍</para>
  <para style="toc2">ಹಬಕ್ಕೂಕ್‍</para>
  <para style="toc1">ಹಬಕ್ಕೂಕ್‍</para>
  <para style="mt2">ಪ್ರವಾದಿಹುಯಿರೊತೆ ಹಬಕ್ಕೂಕ್‍ನು ಗ್ರಂಥ್</para>
  <para style="mt1">ಹಬಕ್ಕೂಕ್‍</para>
  <para style="imt">ಪ್ರವಾದಿ ಹಬಕ್ಕೂಕ್‍ನು ಪರಿಚಯಂ</para>
  <para style="ip">ಆ ಗ್ರಂಥ್ ಹಬಕ್ಕೂಕ್‍ನು ಭವಿಷ್ಯವಾಣಿನ ಮ್ಹೈ ಛಾ. ಹಬಕ್ಕೂಕ್‍ನು ಗ್ರಂಥ್ ಕೆತ್ರುಕಿ ಪ್ರವಾದಿನು ಗ್ರಂಥಂಖ್ಹುಬಿ ಅಲಾದು ಹುಯಿರುಸ್ ಶನಕತೊ ಯೊ ಇಸ್ರೇಲ್ ಬುಜು ಯೆಹೂದ್ ನ ದಕ್ಲೈರುಸ್ತೆ ಸಂದೇಶಂನ ಕೊಲಿರಕ್ಯುನಿ. ಬದುಲ್ ನ, ಆ ಬೆ ಹಬಕ್ಕೂಕ್‍ನು ದುಃಖಂನು ಬುಜು ಪ್ರಾರ್ಥನೆನ ಮ್ಹೈಹುಯಿರುಸ್. ದೇವ್ ಇನು ಹಬಕ್ಕೂಕ್‍ನು ದುಃಖಂನಬಿ ಜವಾಬ್ ದಿಶೆ. ಹಬಕ್ಕೂಕ್‍ ತೊಬಿ ಯೆರೆಮೀಯನಿತರ ಬುಜು ರಾಜ್ ಯೋಷೀಯ ಬುಜು ರಾಜ್ ಯೆಹೋಯಾಕೀಮನು ಆಳನಿಟೆಂಪರ್ ಬಚಿನ್‍ಥು ಕರಿ ಅಕ್ಕುಸ್ ಮಾಲಂಚತೆ ಇವ್ಣೆ ಸೊಚಸ್. ಹಬಕ್ಕೂಕ್‍ನು ಗ್ರಂಥಂಹುಯಿಜವೊ ಬುಜು ಖ್ಹೆವುಬಿ ಬೈಬಲ್‍ನು ಗ್ರಂಥಮ್ಮಹುಯಿಜವೊ ಹಬಕ್ಕೂಕ್‍ತೊಬಿ ಖ್ಹೆವ ಕಾಲಮ್ಮ ಬಚಿರ‍್ಹಸ್‍ಕರಿ ಕೊ ಬೊಲನಿ.</para>
  <para style="ip">ಹಬಕ್ಕೂಕ್‍ನೆ ಪಹಿಲೆ ದೇವ್ನ ಯೊ ವದಖ್ಹೊ ಬುಜು ಅನ್ಯಾಯಂನ ದೆಖಿರಕ್ಯೊಸ್ ಬುಜು ಮದತ್‍ನ ಹಬಕ್ಕೂಕ್‍ನು ಪ್ರಾರ್ಥನೆನ ದೇವ್ನೆ ಜವಾಬ್ ಕೊದಿದೊನಿ ಕರಿ ಇನು ದುಃಖಂನು ಬೊಲ್ಯು. ಯೆಹೂದ ದೆಖ್ಹ್ ಮ ಚಲುಕರತೆ ಆ ಕಾಮ್‍ಖ್ಹರು ಹಬಕ್ಕೂಕ್‍ನೆ ದೇಖ್ಯು ಉಶೆ. ಯೆಹೂದನ ನಾಶಂಕರನ ಬ್ಯಾಬಿಲೋನ್‍ವಳನ ವುಠಡಿರಕ್ಯೊಸ್ ಕರಿ ಬೊಲನಿತರ ದೇವ್ ಜವಾಬ್‍ದಿರಕ್ಯೊಸ್. ಬಾದ್‍ಮ ಥೋಡ ಖರಬ್‍ ವಾಳನ ಖ್ಹತವಾನ ದೇವ್ ಖರಬ್‍ ಅದ್‍ಮಿವ್‍ನ ಉಪಯೊಗಂಕರುಕರಸ್ ಕರಿ ಹಬಕ್ಕೂಕ್‍ನು ದುಃಖಂನ ಬೊಲ್ಯೊತೆ. ಬ್ಯಾಬಿಲೋನ್ ವಾಳನಬಿ ಬಾದ್‍ಮ ಬೊಲಾವ್‍ಶೆ ಬುಜು ಖ್ಹತವ್‍ಶೆ ಕರಿ ಬೊಲನಿತರ ದೇವ್ ಜವಾಬ್‍ದಿಶೆ. ಛಟ್‍ನ ಹಬಕ್ಕೂಕ್‍ನೆ ದೇವ್ನಿ ವತೆನ ಪಳ್ಳಿ ಚಾಲಾನ ಬುಜು ಗೋರ್‌ ವತಳನ ಪ್ರಾರ್ಥನೆಕರುಸ್. ದೇವ್ನ ಫಿಟೆ ಕರಿರಕ್ಯುಸ್ತೆ ಘಣುಮೊಟು ಕಾಮ್‍ನ ಖ್ಹಜೆ ಯೊ ಇನ ಸ್ತುತಿಕರುಸ್.</para>
  <para style="iot">ಮ್ಹೈ ಚ್ಹಾತೆ ಅನು ಭಾಗ್</para>
  <para style="io1">1. ಅಧ್ಯಾಯ <char style="ior"><ref loc="HAB 1:1-4">1:1-4</ref></char> ಹಬಕ್ಕೂಕ್‍ನಿ ದುಃಖಂ ಭರಯಿರುಸ್.</para>
  <para style="io1">2. ಅಧ್ಯಾಯ <char style="ior"><ref loc="HAB 1:5-11">1:5-11</ref></char> ಮ ಅಪ್ಣೆ ಪಯಿಲೆನು ಜವಾಬ್‍ನ ಫಡೆಶ್.</para>
  <para style="io1">3. ಅಧ್ಯಾಯ <char style="ior"><ref loc="HAB 1:12-17">1:12-17</ref> </char> <char style="ior"><ref loc="HAB 2:1">2:1</ref> </char> ಬೆ ಮನು ಹಬಕ್ಕೂಕ್‍ನು ದುಃಖಂನು ಬರೆಮ ಬೊಲಸ್.</para>
  <para style="io1">4. ಅಧ್ಯಾಯ <char style="ior"><ref loc="HAB 2:2-20">2:2-20</ref> </char> ಮ ಅಪ್ಣೆ ಬೆ ಮನು ಜವಾಬ್‍ನ ಫಡೆಶ್.</para>
  <para style="io1">5. ಅಧ್ಯಾಯ <char style="ior"><ref loc="HAB 3">3</ref> </char> ದೇವ್ನ ಹಬಕ್ಕೂಕ್‍ನು ಪ್ರಾರ್ಥನೆನ ಬಿಡ್‍ಸೈನ್ ಬೊಲುಕರಸ್.</para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />ಪ್ರವಾದಿ ಹಬಕುಕ್‍ನು ಪ್ರಕಟನೆ ಹುಯಿರುಸ್ತೆ ದೆವ್ ನಿ ವಾತ್:<verse eid="HAB 1:1" /></para>
  <para style="s">ಅನ್ಯಾಯಂನಖ್ಹಜೆ ಹಬಕುಕ್ ನಿ ಬೊಲ್ಯೊತೆ</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 1:2" />ಮೇ ಕೆತ್ರ ಕಾಲಂ ದೇವ್, ತುನ ಮದತ್ ಕಾಜೆ ಮೊರೆ ಮ್ಹೆಲ್ ತು ರ‍್ಹಾನು, ತು ಕೆತ್ರ ಕಾಲಂ ಶೊಪೊರ‍್ಹೈಶ್ ಮನ ಕಾನ್ ನಾ ದೇನುತಿಮ್? ಹಿಂಸೆಹುಂಕರಸ್ ಕರಿ ಮೆ ಚಿಕ್ರ್ಯೊ; ರೈತೊಬಿ ತೂ ಶೊಪೊರ‍್ಹೈಶ್, ರಕ್ಷಣೆ ನಾದೇನುತಿಮ್. <verse eid="HAB 1:2" /><verse number="3" style="v" sid="HAB 1:3" />ಖರಾಬ್ ನ ಮೆ ದೆಖನಿತರ ಕರ್ಯೊಶನ? ಕಷ್ಟಂನ ಮೆ ದೆಖನಿತರ ಕರ್ಯೊಶನ? ಹಿಂಸೆಬಾಧೆಖ್ಹರು ಅಸ್ ಮರ ಡೊಳನ ಖ್ಹಮೆ. ಹಂದೇಕ್, ಲಡೈ ಹುಂಕರಸ್, ಎಕ್ ಹುಂಕರಸ್. <verse eid="HAB 1:3" /><verse number="4" style="v" sid="HAB 1:4" />ಇನಕಾಜೆ ಖ್ಹಾಚಿನು ಪ್ರಮಣಂ ಚಲವ್‍ಶೆ. ನಿಯತ್ ನು ನ್ಯಾವ್ ಕೆದೆಬಿ ಲಾಡ್‍ಷೆಕೊಯಿನಿ. ಖರಾಬ್ ಅಛ್ಚುಅದ್‍ಮಿವ್‍ನ ಕೊಂಡಿರಕ್ಯುಸ್. ಇನಕಾಜೆ ಛುಟಿನು ನ್ಯಾವ್ ಚಲ್ ಶೆ<verse eid="HAB 1:4" /></para>
  <para style="s">ದೆವ್ ನು ಜವಾಭ್</para>
  <para style="p">
    <verse number="5" style="v" sid="HAB 1:5" />ತದೆ ದೇವ್ ಇನು ಅದ್ಮಿನ ಅಂಬೊಲುಕರಸ್: “ಖ್ಹರು ದೇಖ್ಹ್ ನ ಮ್ಹೈ ಚಲುಕರ್ತುತೆ ದೆಖೊ. ದೆಖ್ಯಾತೊ ಆಶ್ಚರ್ಯಂಹುಯಿಜಾಶು. ತುಮಾರು ಕಾಲಮ್ಮ ಮೆ ಎಕ್ ಕಾಮ್ ನ ಕರ್ಯೊಥೊ. ಇನ ಬಾರೇಮ ತುಮೆ ಕಾನ್‍ ಖ್ಹುಬಿ ಖ್ಹಂಜ್ಯ ತೊಬಿ ತುಮೆ ಕೊ ನಂಶು ನಿ. <verse eid="HAB 1:5" /><verse number="6" style="v" sid="HAB 1:6" />ಹಂದೇಕ್, ಬಾಬಿಲೋನ್ ವಳವ್ ನ ವುಠಡಿಶ್. ಇವ್ಣೆ ಭಯಂಕರ ಬುಜು ಕಠಿಣವಳು. ಇವ್ಣೆ ಜಮಿನ್ ಅಖ್ಖು ಪ್ಹೈಲಯಿನ್ ಇನುಖಾಯೆತಿಮ್ ಇವ್ಣ ಭಣಿ ಕಬ್‍ಜ ಕರಿಲಿಶೆ. <verse eid="HAB 1:6" /><verse number="7" style="v" sid="HAB 1:7" />ಇವ್ಣೆ ಡರ್ರಸ್ ಕೊಯ್ನಿ, ಡರವವಾಳು. ಇವ್ಣನು ಇವ್ಣೆಸ್ ಖ್ಹಾಚಿನಿಯತ್ ನ ಉಬ್-ಜೈಲೆವಳು; ಇವ್ಣನು ಇವ್ಣೆಸ್ ಗೌರಂನ ಲಿಲೆವಳು. <verse eid="HAB 1:7" /><verse number="8" style="v" sid="HAB 1:8" />ಇವ್ಣನು ಘೋಡಖ್ಹರು ಚಿರತೆಥೆಬಿ ಡಾರವನು ಗ್ಹೊಣಿ; ಬ್ಹುಕ್ಯು ರ‍್ಹಾವಳು ಹಡೊತ್ಹೆಬಿ ಛತುರ್. ಇವ್ಣ ಘೋಡ ಚಲವವಳು ಜೊರೆಖ್ಹು ಅವ್ ಶೆ. ಹಲ್ಡೊನ ಧರಿಲೆವನ ಘಬ್ರೈನ್ ವುಡಸ್ತೆ ಖ್ಹಂಳಿ ನಿತರ ದೂರ್‌ತುಸ್ ಜೊರೇಖ್ಹು ಅವ್‍ಶೆ. <verse eid="HAB 1:8" /><verse number="9" style="v" sid="HAB 1:9" />ಹಿಂಸೆ-ಬಾಧೆಖ್ಹರು ನ ಲಿಲಿನ್ ಖಣದ್ ಕರ್ಲಿ ಖ್ಹಮೆ-ಖ್ಹಮೆ ಅವ್ ಶೆ. ಮಟಿನು ಕಾಕ್ರನಿತರ ಗಣ್ತಿಸ್ ಕೊಯಿಂತಿಮ್ ಅದ್ಮಿನ ಖ್ಹೊತಿನ್ ಧರಿಲಿಶೆ. <verse eid="HAB 1:9" /><verse number="10" style="v" sid="HAB 1:10" />“ಇವ್ಣೆ ರಾಜನ ಶರಂಕಡ್ ಶೆ; ಅಧಿಪತಿವ್ ನ ಶರಂ ಅವನಿತರ ಕರ್ದಿಶೆ. ಖ್ಹರುಖ್ಹೊಟೊನ ಧೂಳ್ ನಿತರ ಕರ್ದಿಶೆ. ಮಟಿನು ಗುಡ್ಡೊ ನಾಕಿನ್ ಕೊಂಡಿಲಿಶೆ. <verse eid="HAB 1:10" /><verse number="11" style="v" sid="HAB 1:11" />ಡುಂಜ್ ನಿತರ ಅಯಿನ್ ಇವ್ಣೆ ಮಾಯಂ ಹುಯಿಜಶೆ, ಸೊಂತ್ ಥಕತ್ತಸ್ ದೇವ್ ಕರಿ ಬೊಲಿಲೆವಳು ಅಪರಾದಿಖ್ಹರು.” ದೂರು ನೀಡುತ್ತಾನೆ<verse eid="HAB 1:11" /></para>
  <para style="s">ಹಬಕ್ಕೂಕ್‍ನಿ ದುಃಖಂನ ಬುಜಜೆಕ್ ಹಲ್ಲ ಬೊಲಸ್ತೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="HAB 1:12" />ಜಗತ್ ನೊ ದೇವ್, ಮಾರೊ ದೇವ್, ಘಣೊ ಪರಿಶುದ್ಧಂನೊ ಗುರು, ಜಮನತುಬಿ ರ‍್ಹಾವಳೊ ತುಸ್. ಹಮೆ ಖ್ಹಾಛಸ್ ಕರಿ ಮರ್ಶು ಕೊಯ್ನಿ. ಹಮ್ನ ಖ್ಹತವನಿತರ ಯೊ ಬಾಬಿಲೋನ್ ವಳನ ನೇಮ್ ಸೈರಕ್ಯೊತೆ ತುಸ್, ಇವ್ಣ ಉಂಚೊವಳನಿತರ ಕರ್ಯೊತೆ ತುಸ್. ಹಮ್ನ ಮೊಟೊ ಬಂಡೊ ತುಸ್. <verse eid="HAB 1:12" /><verse number="13" style="v" sid="HAB 1:13" />ಖರಾಬ್ ನ ದೆಖನಹೊಯಿಕೊಂತೆ ಎತ್ರು ಕಚ್ರೊಕೊಂತೆ ತುಮರ ಡೊಳೊ. ಖರಾಬ್‌ನ ಖ್ಹಮಳನ ಹೊಯಿಕೊಂತೆ ಇಮ್ ಪವಿತ್ರಂವಳೊ ತುಸ್. ಅಮ್ ರ‍್ಹವಮ ಖರಾಬ್ನ ದೆಖುಕರಸ್ ಶನ? ಖರಬ್ಅದ್ಮಿ ನಿಯತ್ ವಳನ ಗಳುಕರಸ್ತೆ ದೇಖಿನ್‌ ಶೊಪೊಶನ ಛಾ? <verse eid="HAB 1:13" /><verse number="14" style="v" sid="HAB 1:14" />ಅದ್ಮಿವ್ ನ ದರ್ಯವ್ ನು ಮಾಚ್ಲನು ಸಮಹುಯಿರುಸ್, ಶೆ. ಶಾಣುಸ್ ಕೊಯಿನ್ತೆ ನ್ಹಾನ ಕಿಡವ್‍ನಿ ಗತಿ ಶನ ಬೊಲಿಮೊಕ್ಯೊ? <verse eid="HAB 1:14" /><verse number="15" style="v" sid="HAB 1:15" />ಅ ಕರಣಂ ಯೊ ಬಾಬಿಲೋನ್ ವಳು ಅದ್ಮಿವ್ ಮ ಗಾಳ್ ಖ್ಹು ಕ್ಹೆಚಿಲೆವ್ ಕರಸ್; ಜಾಳಖ್ಹು ಖ್ಹೊತಿಲೆವ್ ಕರಸ್; ಇನು ಜಾಳ ಮ ಗುಡ್ಡೊಕರಿಲೆವ್ ಕರಿಲಿನ್; ಕುಶಿಪಡಸ್. <verse eid="HAB 1:15" /><verse number="16" style="v" sid="HAB 1:16" />ಇನು ಜಾಳನ ಬಲಿದಿಶೆ; ಗುಗಳ್ ನಾಕಸ್. ಯೊ ಮುಲಕಂ ಇವ್ಣು ಜಾನ್ ಘಣು ಘಟ್; ಇವ್ಣು ಖಾಣು ಥಕತ್. <verse eid="HAB 1:16" /><verse number="17" style="v" sid="HAB 1:17" />ಅಮ್ ಇವ್ಣೆ ಕೆದೆಕೆದೆಬಿ ಇವ್ಣ ಜಾಳಮಥು ಖ್ಹಲಿ ನಾ ಮ್ಹೆಲ್ ನು ತಿಮ್ ಜತುರ‍್ಹನು ನಾ? ಗೋರ್‌ ಕೊಂತೆ ಖ್ಹರನಂಗ್ರಿನ ಕೆದೆಬಿ ನಾಶನಂ ಕರ್ತುರ‍್ಹನು ನಾ?<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="s">ಹಬಕುಕ್ ನ ದೇವ್ ನು ಜವಾಬ್</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 2:1" />“ಮೇ ಕಾವ್ಲಿಕರವಳೊ ಹುಯಿನ್ ಹುಬ್ಯೊರ‍್ಹೈಶ್. ಕಾವ್ಲಿಕರಸ್ತೆ ಗೊಪುರನ ಉಪ್ಪರ್ ಛಡಿನ್ ಹುಬ್ಯೊರ‍್ಹೈಶ್. ಯೆಹೋವ ದೇವ್ ಮನ ಶಾತ್ ಬೊಲಸ್ಕಿ, ಕ್ಹೆವು ಜವಾಬ್ ದೇಸ್ ಕಿ, ಕರಿ ಇಂತಜಾರ್ ಕರುಕುರುಸ್.” <verse eid="HAB 2:1" /><verse number="2" style="v" sid="HAB 2:2" />ತದೆ ಯೆಹೋವ ದೇವ್ ಮನ ದಿದೋತೆ ಜವಾಬ್ ಅ: “ತೂ ದೆಕ್ಯೊತೆ ದರ್ಶನಂನ ಲೀಕ್. ಫಡವಳು ಜಲ್ದಿ ಫಡಖ್ಹರ್ಖ್ಹು ಖೊಡ್‍ಶನ ಉಪ್ಪರ್ ಅನ ಲಿಕ್. <verse eid="HAB 2:2" /><verse number="3" style="v" sid="HAB 2:3" />ನೆಮ್‍ಸೈರಕ್ಯೊಸ್ತೆ ಕಾಲಮ್ಮ ಯೊ ದರ್ಶನಂ ಜರಗ್ ಶೇ. ಇನು ಛಟ್‍ನು ತಿರ್ ಮನಂ ಜಲ್ದಿಶ್ ಮಲಂಪಡಿಜಸ್. ದಿರ್ಪಡಿತೊಬಿ ಜಪಿರ‍್ಹಾ; ಮೋಸಂಕರಕೊಯಿನಿ. ಯೋ ಖ್ಹಾಚಸ್ ಕರಿ ಹತ್ ಮ ಮಳ್‍ಶೆ; ಧಿರ್ ಪಡ್ ಶೆ ಕೊಯ್ನಿ. <verse eid="HAB 2:3" /><verse number="4" style="v" sid="HAB 2:4" />ದೇಕ್, ಖ್ಹಚ್ಚ ಮನಸ್ ಕೊಂತೆವಳು, ಫುಲಿರುಸ್ತೆ ಯೊ ಖ್ಹರಬ್ ಅದ್ಮಿ ಕೊ ಬಚ್‍ಶೆನಿ; ನಿಯತ್ ವಳೊ ವಿಶ್ವಾಸಂತಿ ಬಚ್ ಶೆ.<verse eid="HAB 2:4" /></para>
  <para style="s">ಖಾರಬ್ ವಳವ್ನು ಮುಸಿಬತ್</para>
  <para style="p">
    <verse number="5" style="v" sid="HAB 2:5" />ಯೊ ಖಯೆತೆ ಧನ್ ದವ್‍ಲತ್ ಮೊಸಹುಯಿರುಸ್, ಇನಕಾಜೆ ದುಷ್ಟರ್ನ ನಿಶಛಡಿರುಸ್, ಇನು ಸೊಂತ್ ಜಘೊಮ ಕೊ ಹುಬಿರಶೆನಿ; ಇನು ಅಖ್ಹ್ ಪತಳಂನಿತರ ಘಣುಮೊಟು, ಮರಿಹುಯನಿತರ ಛಾ, ಭಶ್ಶಸ್ ಕೊಯ್ನಿ; ಖ್ಹಾರ ಅದ್ಮಿವ್ ನ ಕ್ಹೆಚಿಲಿಶೆ, ಅಖ್ಖುಸ್ ಅದ್ಮಿವ್ ನ ಗುಡ್ಡೊಕರ್ಲಿಶೆ. <verse eid="HAB 2:5" /><verse number="6" style="v" sid="HAB 2:6" />ರೈತೊಬಿ ಅಮ್ ಇವ್ಣೆತೆ ಅಖ್ಹ್ ಪಡ್ಯುತೆಅಕ್ಕು ಇನು ವತ್ ನ ಛೊಡಿ ಬೊಲವಳು ಶರಂ ಕಡವಳು. “ಇನು ಖ್ಹಯೆತಿಮ್ ಜಾಖ್ಹತ್ ಜಾಖ್ಹತ್ ಭರೈರಖವಳನಿ ಗತಿನ ಶಾತ್ ಬೊಲ್‍ನು! ಬಡ್ಡಿನಕಾಜೆ ಅಡುಮೆಲ್ಯುತೆ ಖ್ಹರು ರ‍್ಹಾಛನ ಗುಡ್ಡೊಕರಿಲೆವಳನಿ ಗತಿ ಶಾತ್ ಬೊಲು! ಕೆತ್ರ ಕಾಲಂ ಅಮ್ ಕಿರಿಶ್?’ <verse eid="HAB 2:6" /><verse number="7" style="v" sid="HAB 2:7" />ತಾರು ಹುದರ್ ಲಿರ‍್ಹಾಖವಳು ಪಟಕ್ ಕರಿ ತರ ಖ್ಹಮೆ ಅಯಿನ್ ಹುಬಿರ‍್ಹಶೆ; ಬಾಕಿದೆವಳುಸ್ ಚತುರ್ ಹುಯಿನ್ ತುನ ಡರವ್‍ಶೆ. ಠಗೈನ್ ತುನ ಜೊಟೈಲಿಶೆ. <verse eid="HAB 2:7" /><verse number="8" style="v" sid="HAB 2:8" />ಶನಕತೊ ತೂ ಕೈಏಕ್ ದೆಖ್ಹ್ ನ ಠಗೈರಕ್ಯೊಸ್. ಅದ್ಮಿನು ಲ್ಹೋಯಿನ ಚಿಡ್‍ಕಿರಕ್ಯೊಸ್. ಮುಲಕ್‍ನ ಖ್ಹಾಯೆರ್ನ ಇನಮಲ್ಯು ಬಚಿರಸ್ತೆ ಅದ್ಮಿವ್ ನ ಖ್ಹಾತೈರಕ್ಯೊಸ್ ಭಚಿರುತೆಖ್ಹಾರುಸ್ ಜಣು ತುನ ಠಗವ್‍ಶೆ. <verse eid="HAB 2:8" /><verse number="9" style="v" sid="HAB 2:9" />ವಾದಖ್ಹೊಮತು ಬಚಿಜವಳು ಇಜಿಖ್ಹು ತರ ಗರ್ನ ಉಂಚಪರ್ ಭಂದಿಲಿದೊ. ತರ ಕುಟುಂಬನಕಜೆ ಅಲದನು ಆಸ್ತಿನ ಅನ್ಯಾಯಂಖ್ಹು ಖ್ಹೊಚಿಲಿದೊ, ತಾರಿ ಗತಿನ ಶಾತ್ ಬೊಲ್‍ನು! <verse eid="HAB 2:9" /><verse number="10" style="v" sid="HAB 2:10" />ತಾರು ಖ್ಹಾಯಲ್ ಖ್ಹು ತಾರ ಗರ್ ನ ಖರಬ್ ನಾಮ್ ಲಯಿತ್ರೊ. ಕೆತ್ರುಕಿ ಮುಲಕ್‍ನ ನಾಶ್ನಂ ಕರೀನ್ ತಾರ ಜತ್‍ನಬಿ ನಾಶ್‍ನಂ ನ ಲಯಿತ್ರೊ. <verse eid="HAB 2:10" /><verse number="11" style="v" sid="HAB 2:11" />ಭಿತ್ ನ ಮ್ಹೈಚತೆ ಭಂಡಸ್ ತುನ ವಿರೋದ್ ಖ್ಹು ಚಿಕರ್ಶೆ. ಗರ್ ನ ಉಪ್ಪರ್ಲ್ಯ ಲಕ್ಡ ಖ್ಹರು ಬಿ ಇನ ಜವಾಬ್ ದಿಶೆ. <verse eid="HAB 2:11" /><verse number="12" style="v" sid="HAB 2:12" />ಅದ್ಮಿನ ಜಾನ್ ನಾಕಡ್‍ನು ಖ್ಹಯೆರ್ ನ ಭಂದವಳನಿ ಗತಿನ ಶಾತ್ ಬೊಲ್‍ನು! ಅನ್ಯಾಯಂಖ್ಹು ಹಾದಿನ ಉಪ್ಪರ್ ಗಾಮ್‍ನ ಭಂದವಳನಿ ಗತಿನ ಶಾತ್ ಬೊಲ್‍ನು! <verse eid="HAB 2:12" /><verse number="13" style="v" sid="HAB 2:13" />ಅದ್ಮಿಖ್ಹಾರು ಕಮಾಯುತೆ ಆಗ್‍ನು ಪಾಲ್ ಉಷೇ. ಅದ್ಮಿಖ್ಹಾರು ಪಡ್ಯುತೆ ಕಷ್ಟಂನು ಕಾಮ್ ಬೇಕರ್ ಉಷೆ. ಅಖ್ಹರು ಯೆಹೋವ ದೇವ್‍ನುಸ್ ಚಿತ್ತಂಖ್ಹಯೆ ನಾ? <verse eid="HAB 2:13" /><verse number="14" style="v" sid="HAB 2:14" />ದರ್ಯವ್ ಪಣಿತೆ ಭರೈನ್ ಚಾ ತಿಮ್ ಜಮಿನ್ ಯೆಹೋವ ದೇವ್‍ನು ಮಹಿಮೆನು ಜ್ಞಾನಂಖ್ಹು ಭರೈರ‍್ಹಷೆ. <verse eid="HAB 2:14" /><verse number="15" style="v" sid="HAB 2:15" />ತಾರು ರೋಷಂನ ದ್ರಾಕ್ಷಿನು ರಖ್ಹ್ ಮ ಮಳೈನ್, ಇನಕಾಜೆ ತಾರ ಅಶ್ ಪಿಶ್‍ಲ್ಯವ್ ನ ಮತ್‍ಮ ಲಾಯಿನ್, ಇವ್‍ಣು ಹುಗಡುನ ದೆಕ್‍ನುಕರಿಚತೆ ತರಿ ಗತಿ ಶಾತ್ ಬೊಲು! <verse eid="HAB 2:15" /><verse number="16" style="v" sid="HAB 2:16" />ತೂ ಸನ್ಮಾನಂವಳೊ ಖಾಯೆ, ಅವಮಾನಂಖ್ಹು ಭರೈರ‍್ಹೈಶ್; ತೂಬಿ ಪಿ, ಪೀಲಿನ್ ಹುಗಡೊಹು. ಯೆಹೋವ ದೇವ್‍ ನು ಖ್ಹವಾತ್‍ಮ ಚತೆ ಛಂಡಲ್‍ನು ಬಿಂದಿ ತರ ಪಾಲ್‍ನ ಅವ್‍ಶೆ. ಅವಮನಸ್ ತಾರ ಸನ್ಮಾನಂನ ಲಿಪ್‍ಟೈಜಶೆ. <verse eid="HAB 2:16" /><verse number="17" style="v" sid="HAB 2:17" />ತೂ ಅದ್ಮಿನ ಲ್ಹೋಯಿನ ಚಿಡ್‍ಕಿರಕ್ಯೊಸ್. ಮುಲಕ್‍ನ ಖ್ಹಾಯೆರ್ನ ಇನಮಲ್ಯು ಬಚಿರಸ್ತೆ ಅದ್ಮಿವ್ ನ ಖ್ಹಾತೈರಕ್ಯೊಸ್. ಲೆಬನೋನ್ ಖ್ಹರು ಜ್ಹಾಡಿನ ಕತ್ರಿನಕಿರಕ್ಯೊಸ್. ಹಂಕ್ಕೆ ತುನಸ್ ಕತ್ರಿನಾಕಿದಿಶೆ. ಇನಮಲ್ಯು ಖ್ಹಾರ ಜಿನವರ‍್ನ ನಾಶನಂ ಕರಿರಕ್ಯೊಸ್. ಹಂಕ್ಕೆ ಯೋ ತುನ ಢರವ್‍ಣಿ ಹುಯಿರ‍್ಹಶೆ. <verse eid="HAB 2:17" /><verse number="18" style="v" sid="HAB 2:18" />ಕೆತ್ತನೆ ಕರಸ್ತೆ ವಿಗ್ರಹಂಖ್ಹು ಫಾಯಿದೊ ಶಾತ್? ಯೋ ಖಲಿ ಅದ್ಮಿನು ಕಾಮ್, ಜ್ಹುಟಿ ಖೆಣಿನ ಮ್ಹೆಲಿರಕ್ಯಸ್ತೆ ಥಕತ್ ಕೊಯಿಂತೆ ಫುತುಲು. ಇನ ತಯರ್ ಕರವಳನ ಯೊ ಖೆವುಬಿ ಡರ್ ಕೊಯಿಂತಿಮ್ ಯೊಸ್ ಲಯು? ಯೋ ಮೊಡುಕಡಕೊಯಿಂತೆ ಗೊಂಬೆಯೆತ್ರೆಸ್. <verse eid="HAB 2:18" /><verse number="19" style="v" sid="HAB 2:19" />ಜ್ಹಡನು ತುಕ್ಡೊ, ‘ಜ಼ತನ್ ಹುಯುಜ’ ಹಠಂನೊ ಭಂಡೊ, ‘ಉಟ್’ ಕರಿ ಹುಕುಂದೆವಳು ಖ್ಹಚಕರಿ ಅಕ್ಕಲಾಸ್ ಕೊಯ್ನಿ. ಫುತುಲು ಬೊಲಿವೊತಳಸ್ ನಾ? ಖ್ಹೊನ್ನುರುಪು ಇನ ಲಗಡಿರಕ್ಯಸ್ ಖ್ಹಚಸ್. ಕತೋಬಿ ಇನ ದಮ್ ಕೊಯಿನಿಸ್ ಕೊಯ್ನಿ. <verse eid="HAB 2:19" /><verse number="20" style="v" sid="HAB 2:20" />ಯೆಹೋವ ದೇವ್‍ ಪ್ರಸನ್ನತೆಹುಯಿರೊಸ್ ಪವಿತ್ರಜಗೊಮ; ಜಮಿನ್ಅಕ್ಕು ಶೊಪೊಹುವದೆ ಇನು ಸನ್ನಿದಿಮ.<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="s">ಹಬಕ್ಕೂಕ್ ನಿ ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 3:1" />ಆ ಪ್ರವಾದಿ ಹುಯಿರೊತೆ ಹಬಕುಕ್‍ನು ಪ್ರಾರ್ಥನೆ.<verse eid="HAB 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2" />ಯೆಹೋವ, ಮೇ ತಾರು ವಾತೆಖ್ಹಂಜಿ ಡರಿಗೊ;</para>
  <para style="q2" vid="HAB 3:2">ಯೆಹೋವ, ಜಗ್ ಜ಼ಮನಮ ತಾರು ಬಚವಾನು ಕಾಮ್ ಪಚು಼ ಕರ್,</para>
  <para style="q1" vid="HAB 3:2">ಜಗ್ ಜ಼ಮನನ ಇಚ್ಮ ಇನ ಕರಿವೊತಳ್;</para>
  <para style="q1" vid="HAB 3:2">ಛಂಡಲ್ ಅಯಿತೊಬಿ ನಕೊ ಭೈಕಿಶ್ ಗೊರ‍್ನ<verse eid="HAB 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HAB 3:3" />ದೇವ್ ವುಳ್ಯವಸ್ ತೇಮಾನ್‍ಮತು</para>
  <para style="q1" vid="HAB 3:3">ಯೋ ಘಣೊ ಪರಿಶುದ್ಧಂನೊ ಪಾರಾನ್ ಫಡ್‍ಮತು.</para>
  <para style="q1" vid="HAB 3:3">ಫೈಲಯಿರುಸ್ತೆ ಇನು ಮಹಿಮೆ ಖ್ಹರು ಪರಲೊಕಂ</para>
  <para style="q1" vid="HAB 3:3">ಭರೈರುಸ್ ಇನು ಮಹಿಮೆ ಜಮಿನ್ ಅಕ್ಕುಸ್.<verse eid="HAB 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HAB 3:4" />ಸೂರ್ಯನಿತರ ಛಾ ಇನು ವುಜಳು</para>
  <para style="q1" vid="HAB 3:4">ವುಜಳುಖ್ಹಾರು ಭಾರ್ ವುಳುಜಸ್ ಇನು ಹತ್‍ಮತು</para>
  <para style="q1" vid="HAB 3:4">ಇನು ಥಕತ್ ಇಜ್ಜಸ್ ಲಪಿರುಸ್.<verse eid="HAB 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HAB 3:5" />ರೊಗ್ ವುಳುಜಸ್ ಇನ ಖ್ಹಾಮೆ</para>
  <para style="q1" vid="HAB 3:5">ಮರಣ್ ವುಳ್ಯವಸ್ ಇನ ಪೀಠೆ.<verse eid="HAB 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 3:6" />ಜಮೀನ್ ಕಪ್‍ಶೆ ಯೊ ಹುಬಿರಯೊತೊ</para>
  <para style="q1" vid="HAB 3:6">ದೇಖ್ಹ್ ಡರ್ಶೆ ಯೊ ದೆಕ್ಯುತೊ</para>
  <para style="q1" vid="HAB 3:6">ಫಟಿಜಶೆ ಜಮನನು ಫಡ್‍ಖ್ಹಾರು</para>
  <para style="q1" vid="HAB 3:6">ರಡ್ಕಿ ಪಡ್‍ಜಶೆ ಜುನೊ ಫಡ್‍ಖ್ಹಾರು</para>
  <para style="q1" vid="HAB 3:6">ಯೊ ಆವಸ್ತೆ ಜಮನನು ಕಲಂಮತುಬಿ ಇಮ್ಮಸ್.<verse eid="HAB 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HAB 3:7" />ದೇಖೊ, ಕಷ್ಟಪಡುಕರತೆ ಕೂಷ್‍ನು ಜ್ಹೊಪ್‍ಡಿಖ್ಹರು</para>
  <para style="q1" vid="HAB 3:7">ಕಪುಕರಸ್ತೆ ಮಿದ್ಯಾನ್ ಟಬರ್‌ ಕನು ಡೇರನಿಜ್ಹೊಪ್‍ಡಿಖ್ಹರು.<verse eid="HAB 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HAB 3:8" />ತಾರು ಇರದೊ ತಲವ್‍ನ ಉಪ್ಪರ್ ಓ ಯೆಹೋವ ದೇವ್?</para>
  <para style="q1" vid="HAB 3:8">ತಾರು ಜಿತನು ರಥಂನ ಉಪ್ಪರ್ ತಾರು</para>
  <para style="q2" vid="HAB 3:8">ಘೋಡವ್‍ನಿ ಜೊಡ್ಮ ತು ಬೆಖ್ಹಿನ್ ಅವನಿ ವಖ್ಹತ್‍ಮ</para>
  <para style="q1" vid="HAB 3:8">ತಲವ್‍ನ ಉಪ್ಪರ್ ಛಂಡಲ್‍ ನಾ ಬುಜು</para>
  <para style="q2" vid="HAB 3:8">ದರ್ಯವ್‍ನ ಉಪ್ಪರ್ ಇರದೊ ನಾ?<verse eid="HAB 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HAB 3:9" />ಕಡಿಮ್ಹೆಲ್ಯೊ ಬಣಮಂನ ಭುಜ್‍ಮಥು</para>
  <para style="q1" vid="HAB 3:9">ಬೊಲಿಮೊಕ್‍ ಲ್ಯೊ ಇನಮಥು ತಿರ್ನ</para>
  <para style="q1" vid="HAB 3:9">ಫಡಿರಖ್ಯೊಸ್ ಜಮಿನ್ನ ಕಲ್ವೊಥಿ.<verse eid="HAB 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HAB 3:10" />ಘಬ್ರವಸ್ ಫಡ್ ಖ್ಹರು ತುನ ದೇಖಿನ್‌</para>
  <para style="q1" vid="HAB 3:10">ನಖ್ಹಸ್ ಜೊರೆಖ್ಹು ಪ್ರವಾಹಂಖ್ಹರು</para>
  <para style="q1" vid="HAB 3:10">ಹಾತ್ ಪಡಿನ್ ಅವಾಜ್ ಮ್ಹೆಲಸ್ ದರ್ಯವ್‍ ಖ್ಹರು.<verse eid="HAB 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HAB 3:11" />ವುಡಿನ್ ಮಿಲವುಂಕರಸ್ತೆ ತರು ತಿರ್ನು ಉಜಾಳಮ</para>
  <para style="q1" vid="HAB 3:11">ವುಕ್‍ಳು ಕರ್ತುತೆ ತರು ಭಲೊನು ಜ್ಹಮಕ್ ಮ</para>
  <para style="q1" vid="HAB 3:11">ಸೂರ್ಯಚಂದ್ರಬಿ ಭಿರಿಜಶೆ ಇವ್‍ಣಿ ಜ್ಹಗೊಮ.<verse eid="HAB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HAB 3:12" />ಜಮಿನ್ನ ಇಚ್ಮಕರಿ ತು ಜೈಶ್ ಛಂಡಲ್‍ಖ್ಹು</para>
  <para style="q1" vid="HAB 3:12">ದೇಖ್ಹ್ ನ ತು ಖುಂದ್ಲಿನಕಿದಿಶ್ ಇರದೊಖ್ಹು.<verse eid="HAB 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HAB 3:13" />ವುಳೊಜಸ್ ತಾರ ಆದ್ಮಿನ ಬಚವನ ಕಜೆ</para>
  <para style="q1" vid="HAB 3:13">ತಾರು ಅಭಿಷೆಕಂ ಲಿರಕ್ಯುಸ್ತೆ ಇನು ಜಾನ್ ಬಚವನ ಕಜೆ.</para>
  <para style="q1" vid="HAB 3:13">ಫೊಡಿರಕ್ಯೊಸ್ ಖರಬ್ ಅದ್ಮಿನೊ ಮೊಟನು ಮುಡ್‍ಕ್ಯವ್‍ನ</para>
  <para style="q1" vid="HAB 3:13">ಮಟಿಮ ಮಳೈರಖ್ಯೊಸ್ ಇನ ಘರ್ನ.<verse eid="HAB 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HAB 3:14" />ಗರಿಬ್ ನ ಲಪಿ ಧಬಿನ್ ಅಹಂಕಾರ್ ಥಿ ಫುಲವಳವ್‍ನಿತರ</para>
  <para style="q1" vid="HAB 3:14">ಮನ ಅಲದುಕರನ ಅಯು ಇನು ಯುದ್ದಂ ಕರವಳು ಡುಂಜ್‍ನಿ ತರ</para>
  <para style="q1" vid="HAB 3:14">ಇನು ಆಯುಧಂಖ್ಹುಸ್ ಇನು ಮುಡ್ಕ್ಯನ ಮರ್ಯೊ.<verse eid="HAB 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HAB 3:15" />ಘೋಡವ್‍ನ ಉಪ್ಪರ್ ಛಡಿನ್ ತೂ ದರ್ಯವ್‍ನ ಪರ್ ಚಲಿಗೊ</para>
  <para style="q1" vid="HAB 3:15">ದರ್ಯವ್‍ನು ಬುರ್ಗನು ಘಣುಪಣಿ ನ ಪರ್ ಚಲಿಗಯೊ.<verse eid="HAB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HAB 3:16" />ಅನ ಖ್ಹಂಜಿನ್ ಕಾಪ್ಯು ಮರು ಅಂಗ್ ತಾನ್</para>
  <para style="q1" vid="HAB 3:16">ಯೊ ಅವಜ್ಮಖ್ಹು ಮರು ಹೊಟ್ ಕಪಲಗ್ಯು</para>
  <para style="q1" vid="HAB 3:16">ಮರ ಹಡ್ಕ್ಯಖ್ಹರು ಸಂಪುರ್ಣಂಖ್ಹು ಖ್ಹಡನಿತರ</para>
  <para style="q1" vid="HAB 3:16">ಹುಬಿರಯೊತೆ ಜ್ಹಗೊಸ್ ಮರ ಗೊಡಖ್ಹರು ಕಾಪ್ಯ</para>
  <para style="q1" vid="HAB 3:16">ಕಷ್ಟಂ ಶೊಪೊಖ್ಹು ಅವಾಸ್</para>
  <para style="q" vid="HAB 3:16">ಹಮ್ನ ಜೊಟೈಲೆವನ</para>
  <para style="q1" vid="HAB 3:16">ಹುಬ್ಯೊರೈಶ್ ಮೆ ತಾಳ್ಮೆಖ್ಹು ಇಜ್ಗೊತೊಡಿ.<verse eid="HAB 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HAB 3:17" />ಗುಲ್ಲರ್ ನು ಝಾಡು ಚಿಗರ್ ನಾ ಮ್ಹೆಲ್ಯುತೊಬಿ</para>
  <para style="q1" vid="HAB 3:17">ದ್ರಾಕ್ಷಿನುಎಲೊಮ ಪಂಡು ನಾ ಧೆಕೈತೊಬಿ</para>
  <para style="q1" vid="HAB 3:17">ತೆಲ್‍ನು ಜ್ಹಡು ಉಬ್‍ಜನು ಭಿರಿಗಯುತೊಬಿ</para>
  <para style="q1" vid="HAB 3:17">ಖೆತರ್ನು ಜಮಿನ್ ಫಲಂನ ನಾ ದಿದುತೊಬಿ</para>
  <para style="q1" vid="HAB 3:17">ದೊಡ್ಡಿಮ ಮ್ಹೆಂಡ ನಾ ರೈತೊಬಿ</para>
  <para style="q1" vid="HAB 3:17">ದೊಡ್ಡಿಮ ಗಯಿ ಚೆಲ್ಕಖ್ಹರು ನಾ ರೈತೊಬಿ,<verse eid="HAB 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HAB 3:18" />ಸಂತೋಷಂ ಹುಯಿಶ್ ಮೇ ಯೆಹೋವಾ ಮ</para>
  <para style="q1" vid="HAB 3:18">ಆನಂದಂ ಹುಯಿಶ್ ಮಾನ ಬಚವನ ದೇವ್‍ಮಸ್.<verse eid="HAB 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HAB 3:19" />ಯೆಹೋವ ದೇವ್ ಮನ ದಿಶೆತೆ ಭರಖ್ಹೊ</para>
  <para style="q1" vid="HAB 3:19">ಮಾರ ಗೊಡವ್‍ನ ಹರಣ್ ನಿತರ ಛತುರ್ ಕರವಳೊ</para>
  <para style="q1" vid="HAB 3:19">ಕರ್ಶೆ ಮನ ಫಡ್‍ಮ ನಖ್ಹನಿತರ.</para>
  <para style="q1" vid="HAB 3:19">ಅಚ್ಚು ಗಿದ್ ಬೊಲವಳು: ಮರು ಡುಂಕುವಾಖ್ಹ್ ಳಿಖ್ಹು ಗಿದ್ ಬೊಲವಳು.<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>