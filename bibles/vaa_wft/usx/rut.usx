<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="RUT" style="id">- Waghri Vathe</book>
  <para style="h">ರೂತ್</para>
  <para style="toc3">ರೂತ್</para>
  <para style="toc2">ರೂತ್</para>
  <para style="toc1">ರೂತ್</para>
  <para style="mt2">ರೂತ್ ನು ಪುಸ್ತಕಂ</para>
  <para style="mt1">ರೂತ್ ನು ಪುಸ್ತಕಂ</para>
  <para style="imt">ರೂತ್ ನೀ ಪರಿಚಯಂ</para>
  <para style="ip">ಇಸ್ರಾಯೇಲ್ ಮ ನ್ಯಾಯಂ ಕರವಳವ್ ನ ಕಾಲಂ ಮ ಇಸ್ರಾಯೇಲ್ ನು ಎಕ್ ಕುಟಂಮ್ಮ ಅಯುತೆ ಅದ್ಬುತಾನು ಬರೆಮ ರೂತ್ ನು ಪುಸ್ತಕಂ ಬೊಲಸ್. ಅ ಕುಟಂನಿ ಆಯಾ ನವೊಮಿ, ಇನೊ ವ್ಹಾಗ್ರಿ ಬುಜು ಬೆ ಪರ್ಖ ಲಡ್ಕ ಮೋವಾಬ್ ಕರಿ ಅಲದ ದೆಖ್ಹ್ ಮ ರ‍್ಹಾವಮ ಮರಿಗಯುತೆ ಮೊಟು ವದಾಖ್ಹೊ ಖೈರಾಕ್ಹಿಸ್. ಅ ಹುಯಿಜವದಿನ್ ನವೋಮಿನಿ ವ್ಹೊವೆಮ ಎಕ್ ಜಣಿ ಹುಯಿರಿತೆ ಮೋವಾಬ್ ದೆಖ್ಹ್ ವಳಿ ರೂತ್ ಇಸ್ರಾಯೇಲ್‌ ನ ಪಚ್ಹು ಪ್ಹರಿನ್ ಜವಮ ಇನ ಭರಖ್ಹೊ ದೆವಾಮ ಅಶಿರ್ವದಂನ ಲಿಲಿದಿ. ಪಛಳ್ ತು ಬೋವಜ್ ಕರಿ ಕುಟಂನೊ ಖನ್ನೆವಾಳನ ದೆಖಿಲಿಶೆ ಬುಜು ರೂತ್ ನ ವ್ಯಾಹಕರನ ಒಪ್ಪದಿನ್ ರೂತ್ ಬುಜು ನವೊಮಿ ಬೆ ಜಣಿ ಅಶಿರ್ವದಂನ ಲೆಸ್. ನ್ಯಾಯಂ ಕರವಳವ್ ನು ವಖ್ಹತ್ ಖರಬ್ ತು ಬುಜು ಕೆತ್ರುಕ್ಕಿ ಇಸ್ರಾಯೇಲ್‌ ವಳು ಖಯಿದೊ ನಾ ಗವ್‍ರಂ ನಾ ದೆನುತಿಮ್ ಬಚಿನ್ ಥು, ರೈತೊಬಿ ನವೊಮಿ, ರೂತ್ ಬುಜು ಬೋವಜ್ ತೊಬಿ ದೆವ್ ನು ನಿಯಮಂ ಖ್ಹು ಪಳ್ಳಿ ಚಲವಳು ಇಸ್ರಾಯೇಲ್‌ ವಳನ ಅಚ್ಹು ಉದಹರಣೆ ಹುಯಿರುಸ್.</para>
  <para style="ip">ರೂತ್ ನು ಪುಸ್ತಕಂ ಲಿಕ್ಯುತೆ ಕೊಣ್ ಕಿ ಕಿನಾಬಿ ಮಲಂ ಕೊಯ್ನಿ. ಪುಸ್ತಕಂ ಲಿಕ್ಯುತೆ ದನ್ ಬಿ ಮಲಂ ಕೊಯ್ನಿ, ರೈತೊಬಿ ಥೊಡು ಅದ್ಮಿ ಅನ ಇಸ್ರಾಯೇಲ್‌ ವಳು ಕಬ್ ಜ ಮತು ಚ್ಹುಟಿನ್ ಅಯುತೆ ಬದ್ ಮ ಲಿಖೈರುತೆ ಹೀಬ್ರುನಿ ವಾತೆನಿ ಪ್ರಕರಂ ಲೀಖೈರುಸ್ ಕರಿ ಸೊಚಾಸ್. ಇಸ್ರಾಯೇಲ್‌ ಖಯೆತೆ ರೂತ್ ರಾಜ್ ದಾವಿದ್ ನಿ ನಾನಿ ಹುಯಿಗಿ ಕರಿ, ಅನು ಅರ್ಥಂ ಆ ಯೇಸುನಿ ಖನ್ ಧನ್ ವಳಿ. ದೇವ್ ಮ ಮಳಿರೊಸ್ ಕರಿ ಹಮೆ ಖೆವಿ ಕುಟಂ ಮಳಿರೊಸ್ ಕರಿ ಖಾಯೆ, ಹೃದಯಂ ಪರ್ ಬಿ ಭರಖ್ಹೊ ರಾಕ್ನು ಕರಿ ಅ ವೊತಳಸ್.</para>
  <para style="iot">ಮ್ಹೈ ಚ್ಹಾತೆ ಅನು ಭಾಗ್</para>
  <para style="io1">1. ಅಧ್ಯಾಯ <char style="ior"><ref loc="RUT 1">1</ref> </char> ನವೋಮಿನು ಕುಟಂಬ್ ಬುಜು ಇವ್ಣೆ ಖೈರಾಕಿತೆ ವದಾಖ್ಹೊನಿ ಭರೆಮ ಬುಜು ನವೊಮಿ ಬಿ ರೂತ್ ಇಸ್ರಾಯೇಲ್‌ ಕಿಮ್ ಗಯು ಕರಿ ಇನು ಭರೆಮ ಬೊಲಿರಕ್ಯುಸ್.</para>
  <para style="io1">2. ಅಧ್ಯಾಯ <char style="ior"><ref loc="RUT 2">2</ref></char> ಮಾ ರೂತ್ ಇನಿ ಖೆತರ್ ಮ ಮಿಗ್ಲಿರುತೆ ಬುಟ್ಟವ್ ನ ಚುಣ್ತಿ ರ‍್ಹಾವಮ ಬೋವಜ್ ಕಿಮ್ ಅನ ಮಳ್ಯೊ ಕರಿ ಫಡೆಸ್</para>
  <para style="io1">3. ಅಧ್ಯಾಯ <char style="ior"><ref loc="RUT 3">3</ref></char> ಬೋವಜ್ ನ ವ್ಯಾಹಮತು ಇನು ಖನ್ನೆವಾಳೊ ಹುಯಿರೊತೆ ಯೊ ವ್ಯಾಹ ಕರನ ಬುಜು ಇನ ದೆಖಿಲ್ಯಾವನ ಕರಿ ಬೊಲಮ ನವೋಮಿನೆ ರೂತ್ ನ ಅಮ್ ಬೊಲಿ ಮೊಕ್ಲಿ. ಅ ಹುಯಿಜವದಿನ್ ಬೋವಜ್ ನ ಇಮ್ ಕರನ ಒಪ್ಪಿಗಯೊ ಕರಿ ಫಡೆಸ್.</para>
  <para style="io1">4. ಅಧ್ಯಾಯ <char style="ior"><ref loc="RUT 4">4</ref></char> ನವೋಮಿನೊ ಮರ್ಯೊತೆ ವ್ಹಾಗ್ರಿನು ಅಸ್ತಿನ ಬೋವಜ್ ಲಿನ್ ರೂತ್ ನ ಕಿಮ್ ವ್ಯಾಹಕರ್ಶೆ ಕರಿ ಬೊಲಿವೊತಳಸ್.</para>
  <chapter number="1" style="c" sid="RUT 1" />
  <para style="s">ಎಲಿಮೆಲೆಕ್ ಬುಜು ಇನಿ ಕುಟಂ ಮೋವಾಬ್ ದೆಖ್ಹ್ ನ ಗಯುತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 1:1" />ನ್ಯಾಯಂ ಕರವಳು ಚಲವ್ ಕರ್ ತುತೆ ತ್ತದೆ ದೆಖ್ಹ್ ಮ ಬರಕಾಲಂ ಅವಮ ಯೆಹೂದ ಟಬರ್ ಕೊಮ ಬೇತ್ಲೆಹೇಮ್ ವಳು ಎಕ್ ಜಣನಿ ಬಯಿಕೊ ಬೇ ಚ್ಹಿಯ್ಯಾ ಅವ್ ಣ ಜೊಡ್ಮ ಮೋವಾಬ್ ದೇಖ್ಹ್ ಮ ರ‍್ಹವನಕಜೆ ಚ್ಹಲಿಗಯು. <verse eid="RUT 1:1" /><verse number="2" style="v" sid="RUT 1:2" />ಯೊ ಅದ್ಮಿನ ಎಲೀಮೆಲೆಕ್ ಕರಿ ಇನಿ ಬಯಿಕೊ ನವೊಮಿ ಕರಿ. ಬೇ ಲಡ್ಕವ್ ನ ಮಹ್ಲೋನ್, ಕಿಲ್ಯೋನ್ ಕರಿ ನಾಮ್. ಯೆಹೂದ ದೇಖ್ಹ್ ನ ಮಳ್ಯುರುತೆ ಎಫ್ರಾತಮ್ಮ ಕರಿ ಚ್ಹತೆ ಬೇತ್ಲೆಹೇಮ್ ಮ ರ‍್ಹಾವಳು ಅವ್ ಣೆ ಅಯಿನ್ ಮೋವಾಬ್ ದೇಖ್ಹ್ ಮ ರ‍್ಹವಮ. <verse eid="RUT 1:2" /><verse number="3" style="v" sid="RUT 1:3" />ನವೊಮಿ ನೋ ವ್ಹಾಗ್ರಿ ಹುಯಿರೊತೆ ಎಲೀಮೆಲೆಕ್ ಮರಿಗಯೊ. ಯೊ ತಯಡ ಬೇ ಪರ್ಖ್ಹಾ ಲಡ್ಕನಿ ಜೊಡ್ಮ ಇಜ್ಗೊಸ್ ರ‍್ಹೈಗಿ. <verse eid="RUT 1:3" /><verse number="4" style="v" sid="RUT 1:4" />ಯೊ ಲಡ್ಕ ಒರ್ಫಾ,ರೂತ್ ಕರಿ ನಾಮ್ ಚ್ಹಾತೆ ಬೆ ಮೋವಾಬ್ ನಿ ತಯಡವ್ ನ ವ್ಯಾಹಕರಿಲಿನ್ ಕಮ್ ಶೆ ಕಮ್ ದಖ್ಹ್‌ ವರಖ್ಹ್ ಇಜ್ಗೊಸ್ ರೈನ್ ಇನಪರ್ ಬೆ ಜಣಬಿ ಮರಿಗಯು. <verse eid="RUT 1:4" /><verse number="5" style="v" sid="RUT 1:5" />ಅಮ್ಮಸ್ ನವೊಮಿ ಇನ ವ್ಹಾಗ್ರಿನಾಬಿ ಬ್ಹೇಜಣ ಚ್ಹಿಯ್ಯೊ ಮಹ್ಲೋನ್ ಬುಜು ಕಿಲ್ಯೋನ್ ನಾಬಿ ಗಮೈಲಿನ್ ಎಕ್ಕಸ್ ಜಣಿ ರ‍್ಹೈಗಿ.<verse eid="RUT 1:5" /></para>
  <para style="s">ನವೊಮಿ ಬುಜು ರೂತ್ ಬೇತ್ಲೆಹೇಮ್ಮ ಪಾಛಿ ಫರಿನ್ ಆಯಿತೆ</para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 1:6" />ಯೆಹೋವ ದೇವ್ ನು ಅನುಗ್ರಹಥಿ ಇನು ಮುಲಕ್ ಮ ಅಚ್ಚು ಪಣಿ ಅನಜ್ ಹುಂಕರಸ್ ಕರಿ ವಾತೆ ಮೋವಾಬ್ ಮುಲಕ್ ಮ ನವೊಮಿನ ಮಾಲಂ ಹುಯು. ಯೊ ಇನಿ ವ್ಹಾವೆ ಬಿ ಪಚ್ಹುಪರಿನ್ ಮೋವಾಬ್ ದೆಖ್ಹ್ ಥಿ ಯೆಹೂದ ದೆಖ್ಹ್ ನ ಜನುಕರಿ. <verse eid="RUT 1:6" /><verse number="7" style="v" sid="RUT 1:7" />ಯೊ ಇನಿ ಬೆ ಜಣಿ ವ್ಹಾವೆನಿ ಜೊಡ್ಮ ಯೊ ಥಿತೆ ಜ್ಹಗೊಮತು ಯೆಹೂದ್ಯ ದೆಖ್ಹ್ ನ ಜವನಿ ವಟ್‍ಮ. <verse eid="RUT 1:7" /><verse number="8" style="v" sid="RUT 1:8" />ನವೊಮಿ ಇನಿ ವ್ಹಾವೆನ “ತುಮೆ ಭೆಜಣಿ ತುಮಾರಿ ಆಯ ಬಾನ ಘರೆ ಚಲಿಜಾವೋ. ಮನಾಬಿ ಮರಿಗಯತೆ ಮಾರ ಲಡ್ಕವ್ನಬಿ ತುಮೆ ಅಛ್ಛು ಸ್‌ ಕರ್ಯ, ಯೆಹೋವ ದೇವ್ ತುಮ್ನಾಬಿ ಇಮ್ಮಸ್ ಅಛ್ಛು ಕರದೆ. <verse eid="RUT 1:8" /><verse number="9" style="v" sid="RUT 1:9" />ತುಮೆ ಬೇ ಜಣಿ ಪಾಛಿ ವ್ಯಾಹಕರೀಲಿನ್ ಅಚ್ಚಿನಿತರ ರ‍್ಹವೊಕರಿ ಯೆಹೋವ ದೇವ್ ನು ಅನುಗ್ರಹ ಹುವಾದೆ!” ಕರಿ ಆಶ್ರೀವಾದಂ ಕರೀನ್ ಇವ್ಣ ಮ್ಹೆಲಿದಿನ್ ಬುಚ್ಚದಿದಿ. ಜಾ ಕರಿ ಬೊಲಮ ತದೆ ಇವ್ಣೆ ಜೊರೆಖ್ಹು ರೋವಲಗಿ. <verse eid="RUT 1:9" /><verse number="10" style="v" sid="RUT 1:10" />ರೈತೊಬಿ ಇವ್ಣೆ, “ಕೊಯ್ನಿಲಿ ಆಯ ತುನ ಮ್ಹೆಂದಿನ್ ಕೊ ಜೈಯಿಸ್ ನಿ. ಹಾಮೆಬಿ ತುಮಾರಿ ಜೋಡ್ಮಾಸ್ ತುಮಾರ ಮಯಾಮಾತ್ರಕನಾಸ್ ಅಯೇಸ್.” <verse eid="RUT 1:10" /><verse number="11" style="v" sid="RUT 1:11" />ತದೆ ನವೊಮಿ, “ಮಾರಿ ಭಯಿ, ತುಮೆ ಪಾಛು ಫರೀನ್ ಜಾವೊ. ಮಾರಿ ಜೋಡ್ಮ ಶನ ಆವ್ಣುಕರಿ ಛಾ? ತುಮೆ ಪಾಛು ವ್ಯಾಹ ಹುವಾನ ಮರಕನ ಬುಜಾ ಲಡ್ಕ ಚ್ಹಾ ನಾ? <verse eid="RUT 1:11" /><verse number="12" style="v" sid="RUT 1:12" />ಲಡ್ಕ ತುಮೆ ಪಾಚ್ಹು ಪ್ಹರಿನ್ ಜಾವೋ. ಪಾಛು ವ್ಯಾಹಕರಾನಿ ವೈಶ್ ‌ಮನ ಕೊಯ್ನಿ. ಎಕ್ ವಳಿ ಕಾಯಿತೋಬಿ ಲಡ್ಕನಿ ಭರಖ್ಹೊ ತಿ ಹಂಕ್ಕೆ ವ್ಯಾಹ ಹುಯಿನ್ ಲಡ್ಕ ಜಣಿತೋಬಿ <verse eid="RUT 1:12" /><verse number="13" style="v" sid="RUT 1:13" />ಇವ್ಣೆ ಮೊಟಹೂವಾಲಗೂ ತುಮೆ ರ‍್ಹವನ ಉಶೆ ನಾ? ನಕೊ,ಬುಜು ವ್ಹಾಗ್ರಿಯೆ ಕೊಯಿನ್ತೆ ರ‍್ಹವನ ಉಶೆ ನಾ? ಲಡ್ಕ ಯೆಹೋವನೆ ಮಾರೊ ಹಾತ್ ಮ್ಹೆಲಿರಾಖ್ಯೊಸ್ ತುಮಾರಖ್ಹಾಜೆ ಮನ ಘಣು ದುಃಖಂಹುವಸ್, ಕರಿ ಸಮಾಧಾನಂ ಬೋಲಿ. <verse eid="RUT 1:13" /><verse number="14" style="v" sid="RUT 1:14" />ಇವ್ಣೆ ಅನ ಖ್ಹಂಜೀನ್ ಉಜೂಬಿ ಜೊರೆಥಿ ರೋಯು. ಯೊ ಹುಯಿಜವದಿನ್ ಒರ್ಫಾ ಇನಿ ಪ್ಹುಯಿ ನಾ ಬುಚ್ಚಾದಿನ್ ಇನು ಆಯ ಬಾ ನ ಘರೆ ಪಾಛಿ ಫರೀನ್ ಚಲಿಗಯಿ. ರೂತ್ ಮತ್ರ ಪ್ಹುಯಿನ ಮ್ಹೆಂದಿನ್ ಕೋ ಗೈನಿ. <verse eid="RUT 1:14" /><verse number="15" style="v" sid="RUT 1:15" />ತದೆ ನವೊಮಿ ರೂತ್ ನ; ಹಂದೇಕ್, ತಾರಿ ಜ್ಹೆಟಣಿ<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">ಅರ್ತಂ ಭೈನಿ ಬಯಿಕೊ</char></note> ಇನ ಆದ್ಮಿವ್ ಕನಬಿ ಇನು ಖ್ಹರು ದೇವ್ ಕನಬಿ ಪಾಚ್ಹು ಪರಿನ್ ಚಲೀಗಿ. ತೂಬಿ ಇನಿನ್ತರಸ್ ತರ ಆದ್ಮಿವ್ ಕನ ಚಲೀಜಾ, ಕರಿ ಬೊಲಿ. <verse eid="RUT 1:15" /><verse number="16" style="v" sid="RUT 1:16" />ತದೆ ರೂತ್ ನೆ; “ತುನ ಮ್ಹೆಂದಿನ್ ಜಾವಾನಿತರ ಒತ್ತಾಯಂನಕೊಕರ್. ತೂ ಕಿಜ್ಜಾ ಗೈತೋಬಿ ಮೇ ಇಜ್ಜಾಸ್ ಅಯಿಶ್. ತೂ ಕಿಜ್ಜಾ ರ‍್ಹೈಶ್ ಕಿ ಮೇ ಇಜ್ಜಸ್ ರ‍್ಹೈಶ್. ತಾರು ಅದ್ಮಿಸ್ ಮಾರು ಅದ್ಮಿ; ತಾರು ದೇವಸ್ ಮಾರು ದೇವ್; <verse eid="RUT 1:16" /><verse number="17" style="v" sid="RUT 1:17" />ತೂ ಕಿಜ್ಜಾಮರಸ್‌ಕಿ ಇಜ್ಜಾಸ್ ಮೆಬಿ ಮರಿಶ್; ಇಜ್ಜಾಸ್ ಮಾರಿ ಮಟಿ ಹುವಾದೆ. ಮರಣ್ಮಾಬಿ ಮೆ ತುನ ಮ್ಹೆಂದಿನ್ ಕೊ ರ‍್ಹೈಶ್‌ನಿ. ಕೊಯ್ನಿಕತೊ ಯೆಹೋವ ಮನ ದೇನುತೆ ಶಿಕ್ಷೆ ದೆವಾದ!” ಕರಿ ಮಾಂಗಿಲಿದಿ. <verse eid="RUT 1:17" /><verse number="18" style="v" sid="RUT 1:18" />ರೂತ್ ಮಾರ ಜೋಡ್ಮ ಆವ್ ನುಸ್ ಕರಿ ತಿರ್ಮಾನ್‌ಕರಿ ರಕಿಶ್ ಕರಿ ಮಾಲಂ ಕರಿಲಿನ್ ನವೊಮಿ ಶೊಪೊಸ್ ರೈಗಿ. <verse eid="RUT 1:18" /><verse number="19" style="v" sid="RUT 1:19" />ಇಮ್ಮಸ್ ಚಾಲ್‌ತಿ ಹುಯಿನ್ ಇವ್ಣೆ ಬೇ ಜಣಿ ಬೇತ್ಲೆಹೇಮ್ ಮ ಗಯು. ಇವ್ಣೆ ಗಾಮ್ಮ ಪಾಚ್ಹು ಪ್ಹರಿನ್ ಅಯುತೆ ವಾತೆ ಅದ್ಮಿವ್ ಮ ಅಶ್ಚರ್ಯಂ ಹುಯು. ಗಾಮ್ ನಿ ತಯಡ ಖ್ಹಾರು, “ಆ ನವೊಮಿ ಖಾಯೆ ನಾ?” ಕರಿ ವತೆ ಬೊಲಲಗ್ಯು. <verse eid="RUT 1:19" /><verse number="20" style="v" sid="RUT 1:20" />ಇನಕಾಜೆ ಯೊ, “ಮನ ನವೊಮಿ” ಕರಿ ನಕೊಬುಲಾವೊ, ‘ಮಾರಾ’<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">ಅರ್ತಂ 'ಕಡು,’</char></note> ಕರಿ ಬುಲಾವೊ. ಶನಾಕತೊ ಯೆಹೋವ ದೇವ್ ಮನ ಜ್ಹಖ್ಹಾತ್ ದುಃಖಂ ದಿರಕ್ಯೊಸ್. <verse eid="RUT 1:20" /><verse number="21" style="v" sid="RUT 1:21" />ಮೇ ಧನ್ ದೌಲತ್‌ವಾಳಿ ಹುಯಿನ್ ಅಜ್ಗೊಥು ಗೈಥಿ, ಶತಸ್ ಕೊಯಿನಿತರ ಯೆಹೋವ ನೆ ಮನ ಪಾಛೋ ಬುಲೈಲೀನ್ ಆಯೊ. ಅಮ್ ಯೆಹೋವ ದೇವ್ ಮನ ವಿರೋಧಂಖ್ಹೂ ಮನ ಖ್ಹಾತೈನಾಖಿದಿದೋ ತುಮೆ ಮನ ನವೊಮಿ ಕರಿ ಬುಲಾವಾನು ಬರೋಬರ್‌ ನಾ? ‘ಕರಿ ಜವಾಬ್ ದಿದಿ. <verse eid="RUT 1:21" /><verse number="22" style="v" sid="RUT 1:22" />ಅಮ್ ನವೊಮಿ ಇನಿ ಮೋವಾಬ್ ನಿ ವ್ಹಾವ್ ಹುಯಿರಿತೆ ರೂತ್ ನಿ ಜೋಡ್ಮ ಬೇತ್ಲೆಹೇಮ್ ನ ಆಯಿ; ತದೆ ಬರಿಕ್‍ಗ್ಹವ್ ನು ಕಾಲಂ ಆಯು.<verse eid="RUT 1:22" /></para>
  <chapter eid="RUT 1" />
  <chapter number="2" style="c" sid="RUT 2" />
  <para style="s1">ರೂತ್ ಬೋವಜ್ ನ ಖೆತರ‍್ಮ ಕಮ್ ಕರಿತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 2:1" />ನವೊಮಿ ನೊ ವ್ಹಾಗ್ರಿಹುಯಿರುತೆ ಎಲಿಮೆಲೆಕ್ ನ ಜಾತ್ ಮ ಮಳಿರ‍್ಹೊತೆ ಎಕ್ ಜಣು ಖನ್ನೆವಾಳೊ ಥೊ. ಯೊ ಧನ್‌ದಲವತ್‌ವಾಳೋ ಹುಯ್‌ರೊಥೊ; ಇನು ನಾಮ್ ಬೋವಜ್. <verse eid="RUT 2:1" /><verse number="2" style="v" sid="RUT 2:2" />ಎಕ್ ದನ್ ಮೋವಾಬ್ ವಾಳಿ ರೂತ್ ನವೊಮಿ ನ: “ಮೆ ಖೆತರ್ ಮ ಬುಟ್ಟವ್ ನ ಚುಣನ ಜವ್ ನಾ? ಅನ ಕೊಣ್ ತೊಬಿ ಮನ ಗೋರ್‌ ಕರಾವಾಳು ಉಷೆ,” ಕರಿ ಬೋಲಿ. ನವೊಮಿನೆ, “ಜೈನ್ ಆವ್ ಚ್ಹೊರಿ,” ಕರಿ ಬೊಲಿ. <verse eid="RUT 2:2" /><verse number="3" style="v" sid="RUT 2:3" />ರೂತ್ ವ್ಹಾಡವಾಳಾನ ಪೆಟೆ ಜಾತ್‍ಹುಯಿನ್ ಇಜ್ಜಾ ಹುಜ್ಜಾ ಪಡ್ಯುರುತೆ ಬುಟ್ಟವ್ ನ ಚುಣುಕರ್ ಥಿಥ್ಹಿ. ಯೊ ಎಲಿಮೆಲೆಕ್ ನ ಜತ್ ನೊ ಹುಯಿರೊತೆ ಬೋವಜ್ ನುಸ್ ಖೆತರ್‌ ಹುಯಿರು ಥು. <verse eid="RUT 2:3" /><verse number="4" style="v" sid="RUT 2:4" />ತದೆ ಬೋವಜ್ ನೆ ಬೇತ್ಲೆಹೇಮ್ ಥು ಖೆತರ್ ಮ ಅಯಿನ್ ವ್ಹಾಡವಳವ್ ನ “ಯೆಹೋವ ದೇವ್ ತುಮಾರಿ ಜೋಡ್ಮ ರ‍್ಹಾವಾದೆ” ಕರಿ ಬೊಲ್ಯೊ. ತದೆ ಇವ್ಣೆ, “ಯೆಹೋವ ತುನಾಬಿ ಆಶೀರ್ವದ್ ಕರದೆ” ಕರಿ ಬೊಲ್ಯು. <verse eid="RUT 2:4" /><verse number="5" style="v" sid="RUT 2:5" />ಬೋವಜ್ ನೆ ಕಾಮ್‌ಕರವಳು ಅವ್ಣ ಬುಲೈನ್, “ಆ ಕಿನ ಗರ್ ನಿ ತಯಡ?” ಕರಿ ಪುಚ್ಹಯು. <verse eid="RUT 2:5" /><verse number="6" style="v" sid="RUT 2:6" />ಇನ ಯೊ ದೆಖಿಲೆವಳು “ಆ ಮೋವಾಬ್ ವಾಳಿ ನವೊಮಿ ನಿ ಜೋಡ್ಮ ಮೋವಾಬ್ ಮುಲುಕ್ ಥಿ ಪಾಛಿಫರಿನ್ ಅಯಿರಿಸ್ ಥೆ ತಯಡ. <verse eid="RUT 2:6" /><verse number="7" style="v" sid="RUT 2:7" />ಅ ಬುಟ್ಟ “ವ್ಹಾಡವಾಳಾನ ಪ್ಹಿಟೆ ಜೈನ್ ಚೊಪ್ಪೊ ನಾ ಇಚ್ ಮ ಚುಣಿಲ್ಯಾವನ ಖ್ಹಾಜೆ ಹುಕುಮ್ ದೇನುಕರಿ ಬೋಲಿಲಿದಿ. ವ್ಹಾಣೆ ಅಯಿತೆ ಬುಜುಬಿ ಅಜ್ಗೊಸ್ ಛಾ. ಜರ ಛಾಳಾಸ್ ಮ ಆರಾಮ್‌ಕರುಕರಸ್,” ಕರಿ ಜವಾಬ್ ದಿದು. <verse eid="RUT 2:7" /><verse number="8" style="v" sid="RUT 2:8" />ತದೆ ಬೋವಜ್ ನೆ ರೂತ್ ನ, “ದೆಕ್ಲಿ ಬಾಯಿ, ಮರ ಖೆತರ್ ನ ಮ್ಹೆಂದಿನ್ ಬುಜು ಕಿಜ್ಜಾಬಿ ಬುಟ್ಟವ್ ನ ಚುಣನ ಜಾವನು ಕೊಯ್ನಿ, ಮಾರ ಕಾಮ್ಮಚ್ಹತೆ ತಯಡವ್ ನ ಜೋಡ್ಮಸ್ ರ‍್ಹಜೊ. <verse eid="RUT 2:8" /><verse number="9" style="v" sid="RUT 2:9" />ಇವ್ಣೆ ಕಿಜ್ಜಾ ಬುಟ್ಟವ್ ನ ವ್ಹಾಡ್‌ಶೆಕಿ ಇನ ಪ್ಹಿಟೆ ಜೈನ್ ಬುಟ್ಟವ್ ನ ಚುಣಿಲ. ತುನ ಕೋಣ್‌ಬಿ ನಾ ಚಿಮ್ನು ನು ಕರಿ ಮಾರ ಕಮ್ ಕರವಳ ಪರ್ಖ್ಹನ ಜ್ಹತಯಿರಕ್ಯೊಸ್. ತುನ ತರಖ್ಹ್‌ಲಾಗಿತೊ ಜೈನ್ ಮಾರು ಕಮ್ ಕರವಳು ಖ್ಹಾರು ಭರಿರಾಕ್ಯುಸ್ ತೆ ಪಾಣಿನು ಹಂಡವ್ ಮ ಪೀಜೊ.” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="RUT 2:9" /><verse number="10" style="v" sid="RUT 2:10" />ತದೆ ರೂತ್ ಇನ ಮುಡ್ಕ್ಯುಜ್ಹುಕಯಿನ್ ಖ್ಹಲಾಂ ಕರಿ,” ಅಲದ ದೆಖ್ಹ್ ವಳಿ ಹುಯಿರಿತೆ ಮನ ತು ಅತ್ರೆ ಗೋರ್‌ ಒತಾಳುಕರಾತೆ ಷನಾ?” ಕರಿ ಬೋಲಿ. <verse eid="RUT 2:10" /><verse number="11" style="v" sid="RUT 2:11" />ಇನ ಬೋವಜ್ ನೆ, “ತಾರೊ ವ್ಹಾಗ್ರಿ ಮರಿಗಯೋತೆ ಇಜ್ಗೊತು ತು ಖ್ಹಾಖ್ಹುನಖ್ಹಾಜೆ ಕರಿತೆ ಅಖ್ಖಿ ಬಾರೇಮ ಖ್ಹಂಜಿರಾಖ್ಯೊಸ್. ತೂ ಕಿಮ್ ತಾರ ಆಯಾಬಾನ ಬುಜು ತರು ಸ್ವಂತ್ ಮುಲಕ್‌ ನ ಮ್ಹೆಂದಿನ್, ಕೋಣ್ ಬಿ ಮಾಲಂಮಸ್ ಕೊಯಿನಿತೆ ಅದ್ಮಿನಿ ಜೊಡ್ಮ ಜಿವನಾಕಜೆ ಆಯಿರಿಸ್ ಕರಿಬಿ ಮನ ಮಾಲಂ ಛಾ. <verse eid="RUT 2:11" /><verse number="12" style="v" sid="RUT 2:12" />ತು ಕರಿತೆ ಅಕ್ಕುಸ್ ಕಮ್ ನ ದೇವ್ ತುನ ಬರೊಬರ್‌ನಿ ಪ್ರತಿಫಲಂ ದೆವದ, ಇಸ್ರಾಯೇಲ್‌ ನೊ ದೇವ್‌ಹುಯ್‌ರ‍್ಹೊತೆ ಯೆಹೋವ ನಿ ಅಶ್ರಯಂ ಖ್ಹು ಅಯಿರಿಸ್. ಇವ್ಣೆ ತುನ ಬೊಲನ ಹೊಯಿಕೊಯಿನ್ತೆ ಆಶ್ರೀವಾದಂ ದೆವದ!” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="RUT 2:12" /><verse number="13" style="v" sid="RUT 2:13" />ತದೆ ರೂತ್ ನೆ, “ಯಜಮಾನ್ ತು ದಾಸಿಹುಯಿರೀತೆ ಮನ ಮೊಟು ಉಪಕಾರ್ ಕರಿರಾಖ್ಯಸ್. ಮೆ ತುಮಾರಿ ದಾಸಿ ಬೊಲೈಲ್ಯಾವನಾಬಿ ಯೋಗ್ಯತಂ ನಾ ರೈತೊಬಿ ಮನ ಗೋರ್‌ಕರೀನ್ ಲಾಡ್ ಖ್ಹು ವಾತೆ‌ಬೋಲಿರಕ್ಯೊಸ್,” ಕರಿ ಬೋಲಿ. <verse eid="RUT 2:13" /><verse number="14" style="v" sid="RUT 2:14" />ಖಾಣಾನಿ ವಖ್ಹತ್ ಮ ಬೋವಜ್ ನೆ ರೂತ್ ನ ಬುಲೈನ್, “ಅಜ್ಜಾ ಆವ್, ರೋಟಾನ ಪಾಡಿಲೀನ್ ದ್ರಾಕ್ಷಿನು ಖಠು ರಖ್ಹ್‌ಮ ಡುಬಯಿನ್ ಖಾ”, ಕರಿ ಬೊಲ್ಯೊ. ಯೊ ತಯಡ ವ್ಹಾಡವಾಳಾನಿ ಜೋಡ್ಮ ಬೇಶಿಗಿ. ಅಖಯೆತಿಮ್ ಬೋವಜ್ ನೆ ಇನ ಬುಂಜ್ಯುಹುಯು ಬುಟ್ಟವ್ ನ ದಿದೊ. ಯೊ ಪೆಟ್ ಭರಿನ್ ಖಾಣುಖೈನ್ ಬುಜುಬಿ ಬಚಯಿಲಿದಿ. <verse eid="RUT 2:14" /><verse number="15" style="v" sid="RUT 2:15" />ಯೊ ಪಾಛಿ ಚುಣನ ಉಟದಿನ್ ಬೋವಜ್ ನೆ ಇನ ಕಮ್ ಕರವಳಿ ನ, “ಚೊಪ್ಪೊ ನ ಇಚ್ಮ ಯೊ ಬುಟ್ಟವ್ ನ ಚುಣಿಲ್ಯಾವಾದೆ, ಅಡೆನಕೊ ಹುಯೊ. <verse eid="RUT 2:15" /><verse number="16" style="v" sid="RUT 2:16" />ಚೊಪ್ಪೊಮಥು ಬುಟ್ಟವ್ ನ ತೋಡಿನ್ ನಾಕೊ. ಯೊ ಜೊಡ್ ಕರಿಲೆವದೆ, ಕೊಣ್ ಬಿ ಇನ ಡರಾವ್ ಶು ನಕೊ” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="RUT 2:16" /><verse number="17" style="v" sid="RUT 2:17" />ಇಮ್ಮಸ್ ರೂತ್ ಖ್ಹಾಂಜ್ ಲಗೂ ಬಿ ಬುಟ್ಟವ್ ನ ಚುಣಿತೆ ಇನ ಕೂಟಮ ಕಮ್ ಶೆ ಕಮ್ ದೊಡಿಖ್ಹ್ ಶೇರ್ ಏತ್ರು ಬರಿಕ್‍ಗ್ಹವ್ ಮಳ್ಯೂ. <verse eid="RUT 2:17" /><verse number="18" style="v" sid="RUT 2:18" />ಇನ ಪಳ್ಳಿನ್ ಗಾಮ್ಮ ಜೈನ್ ಇನಿ ಖ್ಹಾಖ್ಹುನ ಓತಾಳಿ. ಇಮ್ಮಸ್ ಇನ ಖಾಣಮಾಥು ಬಚೈರಕಿತೆ ಇನಿ ಖ್ಹಾಖ್ಹುನ ದಿದಿ. <verse eid="RUT 2:18" /><verse number="19" style="v" sid="RUT 2:19" />ಇನ ದೇಖಿನ್ ನವೊಮಿ, “ತೂ ಆ ದನ್ನೆ ಕಿಜ್ಗತು ಚುಣಿಲಯಿ? ಕಿನ ಖೆತರ‍್ಮ ಕಾಮ್ ಕರಿ? ತುನ ಗೋರ್‌ ಕರ್ಯುತೆ ಇನ ಆಶೀರ್ವದ್ ಹುವದ!” ಕರಿ ಬೋಲಿ. ಇನ ರೂತ್ ನೆ, “ಮೇ ಬುಟ್ಟವ್ನ ಚುಣಿತೆ ಖೆತರ್‌ ಬೋವಜ್ ನು,” ಕರಿ ಬೋಲಿ. <verse eid="RUT 2:19" /><verse number="20" style="v" sid="RUT 2:20" />ಅನ ಖ್ಹಮ್‍ಜಿತೆ ನವೊಮಿ ಘಬ್ರಯಿನ್, “ಜಾನ್‌ರ‍್ಹಾವಳಾನಾಬಿ ಮರವಾಳನಾಬಿ ಕರ‍್ಯೊತೆ ವಾಗ್ದಾನಂಖ್ಹಾರು ಕರಿವತಳವಳೊ ಯೆಹೋವ ದೇವ್ ಇನ ಆಶೀರ್ವದ್ ಕರಾದೆ!” ಕರಿ ಚಿಕ್ರಿನ್, “ಯೊ ಅದ್ಮಿ ಅಪ್ಣ ಖನ್ನೆವಾಳೊ, ಅಪ್ಣ ಅಛ್ಛು ಪಾಳವಾಳೋ,” ಕರಿ ಬೊಲಿದಿದಿ.” <verse eid="RUT 2:20" /><verse number="21" style="v" sid="RUT 2:21" />ತದೆ ಮೋವಾಬ್ ವಳಿ ರೂತ್, “ಅನಜ್ ನು ಕಾಲಂ ಜವತೊಡಿ ಮಾರ ಕಮ್ ಕರವಳಿನಿ ಜೋಡ್ಮಾಸ್ ರ‍್ಹವಜೈ ಕರಿ ಬೊಲಿರಾಖ್ಯೋಸ್,” ಕರಿ ಬೋಲಿ. <verse eid="RUT 2:21" /><verse number="22" style="v" sid="RUT 2:22" />ನವೊಮಿ ಇನಿ ವ್ಹಾವ್ ಹುಯಿರಿತೆ ರೂತ್ ನ, “ಓಹೊ, ಚ್ಹೊರಿ ತೂ ಇನಿ ಕಮ್ ಕರವಳಿ ತಯಡನಿ ಜೋಡ್ಮ ರ‍್ಹಾವಾನೂಸ್ ಅಛ್ಛು; ಅಲದನು ಖೆತರ‍್ಮ ತುನ ತೊಂದರೆ ಹುವಜೈ,” ಕರಿ ಬೊಲಿ. <verse eid="RUT 2:22" /><verse number="23" style="v" sid="RUT 2:23" />ಇಮ್ಮಸ್ ರೂತ್ ನೆ ಖ್ಹಾಖ್ಹುನ ಜೊಡ್ ಮ ರ‍್ಹೈನ್ ಬರಿಕ್‍ಗ್ಹವ್ ಬುಜು ಘ್ಹವ್ ನ ಕಾಲಂ ಹುವತೊಡಿ ಬೋವಜ್ ನ ಕಮ್ ಕರವಳಿ ತಯಡನಿ ಜೋಡ್ಮಸ್ ಜೈನ್ ಚುಣುಕರ್ ಥಿಥ್ಹಿ.<verse eid="RUT 2:23" /></para>
  <chapter eid="RUT 2" />
  <chapter number="3" style="c" sid="RUT 3" />
  <para style="s">ರೂತ್ ನ ವ್ಹಾಗ್ರಿ ಮಳ್ಯುತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 3:1" />ಎಕ್ ದನ್ ನವೊಮಿ ನೆ ರೂತ್ ನ, “ದೆಕ್ಲಿ ಭಯಿ ತು ವ್ಯಾಹ ಕರಿನ್ ಅಚ್ಚಿರ‍್ಹನುಕರಿ ಬುಜು ಸುಖಂ ಖ್ಹು ರ‍್ಹನು ಕರಿ ಪ್ರಯತ್ನಂ ಕರನು ಮಾರು ಜಿಮ್ಮೇದಾರಿ ಖಾಯೆ ನಾ? <verse eid="RUT 3:1" /><verse number="2" style="v" sid="RUT 3:2" />ಯೊ ಬೋವಜ್ ಅಪ್ ಣು ಖನ್ನೆಲ್ಯೊ. ತೂ ಇನಿ ಕಮ್ ಕರವಳಿ ತಯಡನಿ ಜೋಡ್ಮ ಬುಟ್ಟವ್ ನ ಚುಣಸ್‌ತೆ ಖಯೆ ನಾ? ಹಂಕ್ಕೆ ಮೇ ಬೊಲುಸ್ತೆ ಖ್ಹಮಜ್; ಆ ರಾತೆ ಬೋವಜ್ ಖಳಮ ಬರಿಕ್‍ಗ್ಹವ್ ನ ತೂರ್‌ಶೆ. <verse eid="RUT 3:2" /><verse number="3" style="v" sid="RUT 3:3" />ತೂ ಪಾಣಿ ನ್ಹೊಯಿಲೀನ್ ವಾನು ತೇಲ್ ಲಗಾಡಿಲಿನ್, ಘಣೂ ಅಚ್ಚು ಲುಂಗ್ಡನ ಫೇರಿಲಾ. ಇನಪರ್ ಖಳಮ ಜಾ. ಯೊ ಖಾಣುಪಾಣಿ ಖಾವಾಲಗೂಬಿ ಇನ ನಕೊ ದೆಖೈಶ್. <verse eid="RUT 3:3" /><verse number="4" style="v" sid="RUT 3:4" />ಯೊ ಕಿಜ್ಗೊ ಖ್ಹುವಾಸ್ಕಿ ಝಗೊನ ದೆಖಿಲ. ಯೊ ಖ್ಹುಯಿಜವದಿನ್ ಇಜ್ಗ ಜ. ಇನ ಗೊಡಾಪರ್‌ ಲ್ಯು ಗೋದ್ರನ ಖ್ಹರ್ ಕೈನ್ ಗೊಡವ್ನ ಶೆಡೆಸ್ ಖ್ಹುಯಿಜಜೊ; ಇನಪರ್ ತೂ ಶಾತ್ ಕರ್‌ನು ಕರಿ ಯೋಸ್ ಬೋಲ್‌ಶೆ.” ಕರಿ ಬೋಲಿ. <verse eid="RUT 3:4" /><verse number="5" style="v" sid="RUT 3:5" />ರೂತ್ ನೆ, “ತೂ ಬೋಲಿತಿಮ್ಮಸ್ ಮೇ ಕರಿಶ್” ಕರಿ ಬೋಲಿ. <verse eid="RUT 3:5" /><verse number="6" style="v" sid="RUT 3:6" />ಇಮ್ಮಸ್ ರೂತ್ ಖಳಮ ಜೈನ್ ಫುಯಿ ನೆ ಬೋಲಿ ದಿದೀತೆ ಇಮ್ಮಸ್ ಕರಿ. <verse eid="RUT 3:6" /><verse number="7" style="v" sid="RUT 3:7" />ಬೋವಜ್ ನೆ ಖಾಣುಪಾಣಿ ಖೈನ್ ಭಶ್ ಹುಯಿರು ಥೊ. ಅ ಹುಯಿಜವದಿನ್ ಭಜ್ರೊ ನು ಗುಡ್ಡಾನ ಶೆಡೆ ಖ್ಹುಯಿಗಯೊ. ತದೆ ರೂತ್ ಶೊಪೊತಿ ಆಯಿನ್ ಇನ ಕನ್ನೆ ಜೈನ್ ಇನ ಗೊಡಪರ್ ಲ್ಯು ಗೋದ್ರು ಹಳ್ಳೆತ್ತಿ ಖ್ಹರ್ ಕಯಿನ್ ಗೊಡವ್ನ ಶೆಡೆಸ್ ಖ್ಹುಯಿಗಿ. <verse eid="RUT 3:7" /><verse number="8" style="v" sid="RUT 3:8" />ಹಾದಿ ರಾತ್ ಮ ಇನ ಪಟಕ್ಕರಿ ನಿಂದರ್ ಮಥು ಹೊಶರ್ ಹುಯಿಗು. ಜುಕಿನ್ ದೆಖಮ ಎಕ್ ತಯಡ ಗೊಡಕನ ಖ್ಹುತಿತೆ ತಯಡನ ದೆಕಿನ್ ಘಬ್ರೈಗೊ. <verse eid="RUT 3:8" /><verse number="9" style="v" sid="RUT 3:9" />ತದೆ ಬೋವಜ್ ನೆ ಇನ ದೆಕಿನ್ “ತು ಕೊಣ್?” ಕರಿ ಪುಚ್ಹವಮ. ಇನಕಾಜೆ ರೂತ್ ನೆ, “ಯಜಮಾನ್, ಮೇ ತರಿ ದಾಸಿ ರೂತ್. ತೂ ಹಮಾರೊ ಖನ್ನೆವಾಳೊ ಹುಯಿರೊಸ್ ತೆ ಇನಾಖ್ಹಾಜೆ ತಾರು ಗೋದ್ರನು ಕೋಣೊನ ಮಾರಪರ್‌ ನಾಕ್" ಕರಿ ಬೋಲಿಲಿದಿ. <verse eid="RUT 3:9" /><verse number="10" style="v" sid="RUT 3:10" />ಬೋವಜ್ ನೆ, “ಭಯಿ, ಯೆಹೋವ ತುನ ಆಶೀರ್ವದ್ ದೆವಾದ! ತೂ ಗರೀಬ್ ಶೌಕಾರ್‌ ಕವರವ್ ನ ದೆಖಿಕೊಗೈನಿ. ತೂ ಪೈಲೆ ವತಳಿತೆ ಅಛ್ಛು ಮರ್ಯಾದಿತೆಬಿ ಹಂಕ್ಕೆ ತು ವತಾಳುಕರಸ್ತೆ ಮರ್ಯಾದಿ ಘಣುಮೊಟು. <verse eid="RUT 3:10" /><verse number="11" style="v" sid="RUT 3:11" />ಭಯಿ ಡರ್‌ನಕೊ, ತೂ ಇಜ್ಜತ್‌ವಾಳಿಕರಿ ಗಾಮ್ ವಳ ಖ್ಹಾರವ್ ನಸ್ ಮಾಲಂ; ತೂ ಮಾಂಗಸ್ತೆ ಅಖ್ಖೂಸ್ ಮೇ ದಿಷ್. <verse eid="RUT 3:11" /><verse number="12" style="v" sid="RUT 3:12" />ಮೇ ತುಮ್ನ ಖನ್ನೆವಾಳೊ ಕತೊ ಖ್ಹಚ್ಚಸ್. ರೈತೊಬಿ ಮಾರೇಥೆಬಿ ಖನ್ನೆವಾಳೊ ಎಕ್‌ಜಣೊ ಛಾ. <verse eid="RUT 3:12" /><verse number="13" style="v" sid="RUT 3:13" />ಆ ರಾತ್ ಅಜ್ಗೊಸ್ ಖ್ಹು. ಯೊ ತುನ ಪಾಳ್ಷೇಕಿ ಕೊಯ್ನಿಕಿ ಕರಿ ಕಾಲ್ ಪುಚ್ಹಯೆ. ಯೊ ಇನ ಲೀಲಿದೋತೊ ಅಛ್ಛು. ನಾ ಹುತುಉಷೆತೊ ಮೇಸ್ ಯೊ ಲೀಲಿಶ್ ಕರಿ ಜನ್ ಚ್ಹಾತೆ ಯೆಹೋವ ದೇವ್ ನ ಖ್ಹಾಮ್‌ ಬಿ ತುನ ಬೋಲೂಸ್. ಶಾನಿಬಿ ಖ್ಹಯಲ್ ಕೊಯ್ನಿ ತೆ ವ್ಹಾಣುಹುವಾಲಗು ಖ್ಹೂ. “ಕರಿ ಬೊಲ್ಯೊ. <verse eid="RUT 3:13" /><verse number="14" style="v" sid="RUT 3:14" />ಇಮ್ಮಸ್‌ ಯೊ ಇನ ಗೋಡಾಕನಾಸ್ ಖ್ಹುತಿತಿ. ಯೊ ತಯಡ ಖಳಮ ಆಯಿತೆ ಕಿನಾಬಿ ಮಾಲಂ ನಾ ಪಡ್ನುಕರಿ ಬೋವಜ್ ನೆ ಬೊಲ್ಯೊ; ತಿಮ್ಮಸ್ ಹಂದರು ರ‍್ಹವದಿಶ್ ನ ಯೊ ಉಠಿನಿಕ್ಳಿ. <verse eid="RUT 3:14" /><verse number="15" style="v" sid="RUT 3:15" />ಬೋವಜ್ ನೆ ಯೊ ತಯಡನ, “ತಾರು ಹೋಡನು ಗೊದ್ರು ಬಿಚ್ಹವ್,” ಕರಿ ಬೋಲಿನ್ ಇನಾಮ ಕಮ್ ಶೆ ಕಮ್ ಚ್ಹೋ ಪಡಿ ಎತ್ರು ಬರಿಕ್‍ಗ್ಹವ್ ನಖಿನ್ ಇನ ಪಡಿನ್ ದಿದೊ. ಯೊ ಇನ ಪಾಡಿಲೀನ್ ಗಾಮ್ಮ ಗಯಿ. <verse eid="RUT 3:15" /><verse number="16" style="v" sid="RUT 3:16" />ಫುಯಿಕನ ಆವಾಮ, “ಭಯಿ ತೂ ಗೈತೆ ಕಾಮ್ ಶಾತ್‌ಹುಯು?“ ಕರಿ ಪುಚ್ಹವಮ, ರೂತ್ ನೆ ಬೋವಜ್ ಕರ್ಯೋತೆ ಕಮ್ ಅಕ್ಕುಸ್ ಬೋಲಿ. <verse eid="RUT 3:16" /><verse number="17" style="v" sid="RUT 3:17" />ಅಖಯೆತಿಮ್, ಫುಯಿಕನ ಖಾಲಿ ಹಾತ್ ನಕೊ ಜಾ, ಕರಿ ಬೋಲಿನ್ ಚ್ಹೋ ಪಡಿ ಎತ್ರು ಬರಿಕ್‍ಗ್ಹವ್ ದಿದು,“ ಕರಿ ಬೋಲಿ. <verse eid="RUT 3:17" /><verse number="18" style="v" sid="RUT 3:18" />ತದೆ ನವೊಮಿ, “ಭಯಿ, ಅನು ಕಾಮ್ ಶಾತ್‌ಹುವಸ್‌ ಕರಿ ಮಾಲಂ ಪಡಾತೊಡಿ ಖ್ಹಮಾಳಿನ್ ರ‍್ಹಜೊ. ಬೋವಜ್ ಅನಿ ಬಾರೇಮ ಬರೋಬರ್ ಕರತೊಡಿ ಯೊ ಶೊಪೊತಿ ಕೊರ‍್ಹಶೆನಿ.” ಕರಿ ಬೋಲಿ.<verse eid="RUT 3:18" /></para>
  <chapter eid="RUT 3" />
  <chapter number="4" style="c" sid="RUT 4" />
  <para style="s">ಬೋವಜ್ ರೂತ್ ನ ವ್ಯಾಹ ಕರ್ಯೊತೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 4:1" />ಹಂಕಡ್ ಬೋವಜ್ ಗಾಮ್‌ನು ದರ್ವಾಜಕನ ನ್ಯಾವ್‌ ಕರನಿ ಝಗೋಮ ಜೈನ್ ಇಜ್ಗೊ ಬೇಖ್ಹಿಗಯೊ. ಎತ್ರಸ್ ಮ ಇನೆ ಬೋವಜ್ ನೆ ಪಯಿಲೆ ಬೋಲ್ಯುಥುತೆ ಎಲಿಮೆಲೆಕ್ ನ ಖನ್ನೆವಾಳೊ ಹುಯಿರೊತೆ ಸಮಂದಿಕರ್ ಇಜ್ಗೊ ಅಯು. ತದೆ ಬೋವಜ್ ನೆ ಇನ; “ಆವ್‌ಲ ಭ್ಹಯಿ, ಅಜ್ಗ ಬೇಖ್ಹ್.” ಕರಿ ಬುಲವಮ, ಯೊ ಆಯಿನ್ ಶೆಡೆಸ್ ಬೇಶಿಗಯೊ. <verse eid="RUT 4:1" /><verse number="2" style="v" sid="RUT 4:2" />ಆ ಹುಯಿಜವದಿನ್ ಯೊ ಗಾಮ್ಮ ಶಣವ್ ಮ ದಖ್ಹ್‌ ಜಣಾನ ಬುಲವಮ ಇವ್ಣೇ ಅಯಿನ್ ಬೆಖ್ಹಿಗಯು. <verse eid="RUT 4:2" /><verse number="3" style="v" sid="RUT 4:3" />ಅ ಹುಯಿಜವದಿನ್ ಬೋವಜ್ ಯೊ ಖನ್ನೆವಾಳೊ ನ, “ಹಮ್ನ ಸ್ವಂತವಳೊ ಹುಯಿರೊತೆ ಎಲಿಮೆಲೆಕ್ ನ ಮಳ್ಯುತೆ ಎಕ್ ಭಗ್ ನು ಖೆತರ್ ಚ್ಹಾ ಖಯೆನಾ, ಇನ ಮೋವಾಬ್ ಮುಲುಕ್ ಖ್ಹು ಪಾಚುಪರಿನ್ ಆಯಿರುತೆ ನವೊಮಿ ಎಚ್ಹ್ ನು ಕರಿ ಚ್ಹಾ. <verse eid="RUT 4:3" /><verse number="4" style="v" sid="RUT 4:4" />ಅ ತುನ ಬೊಲ್ ನು ಕರಿ ಅನ್ಸಯು, ಯೊ ಜಮೀನ್ ನ ಲಿಲ್ಯಾವಾನ ತುನ ಮನಸ್ಉಶೇತೊ ಅಜ್ಗೊ ಬೇಠೂತೆ ಶಣವ್ ನ ಖ್ಹಾಮೆ ಲೀಲಿದೋತೊ ಹಕ್ಕು ಪಯಿಲೆ ತುನಸ್, ಅ ಹುಯಿಜವದಿನ್ ಮನಸ್ ಮಳ್ ಶೆ; ಬುಜು ಕಿನಾಬಿ ಕೊಯ್ನಿ, "ಕರಿ ಬೊಲ್ಯೊ. ತದೆ ಯೊ ಅದ್ಮಿ; “ಮೇಸ್ ಲೀಲೆವ್ಸ್", ಕರಿ ಬೊಲ್ಯೊ. <verse eid="RUT 4:4" /><verse number="5" style="v" sid="RUT 4:5" />ತದೆ ಬೋವಜ್ ನೆ, “ತೂ ಯೊ ಜಮೀನ್ನ ಲೀಲ್ಯಾವಾಳೊ ಉಶೇತೊ, ನವೊಮಿ ನಿ ವ್ಹಾವ್ ಹುಯಿರಿತೆ ಮೋವಾಬ್ ವಾಳಿ ರೂತ್ ನ ವ್ಯಾಹಕರ್‌ನು. ತದೆ ಯೊ ಖೆತರ್‌ನು ಖಾತೆ ನವೊಮಿ ನೊ ಮರಿಗಯೊತೆ ಛಿಯ್ಯಾನ ನಾಮ್‌ಪರಸ್‌ ರ‍್ಹಶೆ. "ಕರಿ ಬೊಲ್ಯೊ. <verse eid="RUT 4:5" /><verse number="6" style="v" sid="RUT 4:6" />ಇನ ಯೊ ಖನ್ನೆವಾಳೊ, “ಇಮ್‌ಕತೊ ಖೆತರ್ ನು ಖಾತೆ ಲೀಲಿದೋತೊ ಹಕ್ ನ ಮೇ ಮ್ಹೇಲಿದೆವ್ಸ್. ಕೊಯ್ನಿಕತೊ ಮಾರ ಕುಟಂನ ಮಳಿರುತೆ ಆಸ್ತಿ ನ ನಷ್ಟಉಶೆ. ಇನಾಕಜೆ ಯೊ ಹಕ್ ನ ತೂಸ್‌ ಲೀಲೆ ಮರೆಥಿ ಕೋವುಶೆನಿ.” ಕರಿ ಬೊಲ್ಯೊ. <verse eid="RUT 4:6" /><verse number="7" style="v" sid="RUT 4:7" />ಇಸ್ರಾಯೇಲ್‌ ಮ ಆಸ್ತಿ ಪಾಸ್ತಿ ಎಚನಿವಖ್ಹತ್ ನತೊ ಲೆವನಿವಖ್ಹತ್ ಎಕ್ ನಿಯಮ್ ಥು; ದೆವಳು ಲಿಲೆವಳನ ಇನ ಗೋಡಾನಿ ಚಪ್ಪಲ್ ನ ಕಡಿನ್ ದೆತುಥು. ಅಮ್ ಇಸ್ರಾಯೇಲ್‌ ಮ ಘಟ್‌ಹುಯಿಗಿಕರಿ ಮಾಲಂ ಕರಿಲೇತುಥು. <verse eid="RUT 4:7" /><verse number="8" style="v" sid="RUT 4:8" />ಇಮ್ಮಸ್ ಯೊ ಖನ್ನೆವಾಳೊ ನೆ, “ಖೆತರ್‌ ನ ತೂಸ್‌ಲೀಲೆ,” ಕರಿ ಬೋಲಿನ್ ಇನ ಗೋಡಾನಿ ಚಪ್ಪಲ್ ಬೋವಜ್ ನ ಕಾಡಿದಿದೊ. <verse eid="RUT 4:8" /><verse number="9" style="v" sid="RUT 4:9" />ತದೆ ಬೋವಜ್ ಗಾಮ್ ನ ಶಣವ್ ನ ಅಕ್ಕವ್ ನ ಬುಜು ಖ್ಹಾರಾಸ್‌ಅದ್ಮಿನಾಬಿ, “ಎಲಿಮೆಲೆಕ್ ನ ಬುಜು ಕಿಲ್ಯೋನ್, ಮಹ್ಲೋನ್ ಅವ್ಣ ಮಳಿರುತೆ ಆಸ್ತಿ ಅಕ್ಕುಸ್ ನವೊಮಿ ಥಿ ಮೇ ಲೀರ‍ಕ್ಯೊಸ್. ಅನ ತುಮೆಖ್ಹರು ಸಾಕ್ಷಿ ಹುಯಿರಾಸ್. <verse eid="RUT 4:9" /><verse number="10" style="v" sid="RUT 4:10" />ಅಖಯೆತೆ, ಮಹ್ಲೋನ್ ನಿ ಭಯಿಕೊ ಹುಯಿರಿತೆ ಮೋವಾಬ್ ವಾಳಿ ರೂತ್ ನ ಮಾರಿ ಭಯಿಕೊ ನಿತರ ಕರಿಲಿದೊ. ಅನೇಥಿ ಖೆತರ್‌ನಿ ಖಾತೆ ಮರಿಗಯೋತೆ ಮಹ್ಲೋನ್ನ ನಾಮ್ಮಸ್ ಬಚಿರ‍್ಹಶೆ. ಅಖಯೆತಿಮ್ ಇನು ಘರ್‌ಪರಿವಾರ್‌ವಾಳಮಾಬಿ, ಇನ ಬಂಧುಬಳಗಂ ಗಮ್ಮಸ್ ರ‍್ಹಶೆ. ಅನ ತುಮೇಸ್ ಸಾಕ್ಷಿ,“ ಕರಿ ಬೊಲ್ಯೊ. <verse eid="RUT 4:10" /><verse number="11" style="v" sid="RUT 4:11" />ತದೆ ಗಾಮ್‌ನ ಶಣವ್ ಬಿ ಬುಜು ಖ್ಹಾರೂಸ್ ಅದ್ಮಿಬಿ; “ಒಹೊ, ಹಮೇಸ್ ಸಾಕ್ಷಿ ಹುಯಿರ‍್ಹಾಸ್; ಯೆಹೋವ ದೇವ್ ಇಸ್ರಾಯೇಲ್‌ ನ ಘರ್ ನ ಭಡಯೊತೆ ರಾಹೇಲ್ ಬುಜು ಲೇಯಾ ಕರಿ ತಯೇಡಾವ್‌ನ ಕಿಮ್‌ಕಿ ಇಮ್ ಆಶೀರ್ವಾದ್ ಕರದೆ. ಎಫ್ರಾತಮ್ ಜತ್ ಮಾ ಧನ್ ಧವ್ಲತ್ ವಳೊ ಹು; ಬೇತ್ಲೆಹೇಮ್‌ಮ ನಾಮ್‌ಕಮಾವ್‌. <verse eid="RUT 4:11" /><verse number="12" style="v" sid="RUT 4:12" />ಯೊ ತಯಡ ಥಿ ಯೆಹೋವ ದೇವ್ ತುನ ದಿಶೇತೆ ಲಡ್ಕ ಖ್ಹು ತಾರುಘರ್ ಯೆಹೂದನಿ ತಾಮಾರಳ್ ಥಿ ಪೈದಹುಯೋತೆ ಪೆರೆಚ್ ಘರ್‌ವಾಳನಿ ಘೋಣಿ ನಾಮ್‌ ಕಮಾವದೆ ಕರಿ ಬೊಲ್ಯು.<verse eid="RUT 4:12" /></para>
  <para style="s">ಬೋವಜ್ ಅಜು ಇನು ಖಾನ್‌ದಾನ್‌</para>
  <para style="p">
    <verse number="13" style="v" sid="RUT 4:13" />ಬೋವಜ್ ರೂತ್ ನ ವ್ಯಾಹಕರಿಲಿನ್ ಗರ್ ಕನ ಬುಲೈನ್ ಗಯೊ. ಯೆಹೋವನಿ ದಯಾಥಿ ಯೊ ಬೇಜೂನಿಹುಯಿನ್ ಎಕ್ ಛಿಯ್ಯಾನ ಜಣಿ. <verse eid="RUT 4:13" /><verse number="14" style="v" sid="RUT 4:14" />ಗಾಮ್ ನಿ ಖ್ಹರಿ ಭಯಿಕ ನವೊಮಿ ನ: “ಯೆಹೋವಾಸ್ ಆಶೀರ್ವದ್ ಖ್ಹು ಉಛ್ಹೊಹುವದೆ! ಹಂಕ್ಕೆ ತುನ ಖನ್ನೆವಾಳೊ ನಿ ಜತ್ ನು ಜಿಮ್ಮೆದರಿ ಪಡವಳಾನ ದಿರಕ್ಯೊಸ್ತೆ. ಇಸ್ರಾಯೇಲ್‌ ನ ಮುಲಕ್ ಮ ಯೊ ಲಡ್ಕು ನಾಮ್ ಕಮವದೆ! <verse eid="RUT 4:14" /><verse number="15" style="v" sid="RUT 4:15" />ಯೊ ತುನ ನವೊ ಜಾನ್ ದಿನ್ ವಯಶ್ ಹುಯಿಗುತೊ ತುನ ಜತನ್‌ ಥಿ ಪಳಿಲಿಶೇ. ಖ್ಹಾತ್‌ ಜಣ ಚ್ಹಿಯ್ಯಾತೆ ಬಿ ಘಣು ಲಾಡ್ ಕರಾವಾಳಿ ಹುಯಿರಿತೆ ತಾರಿ ಲಾಡ್ ನಿ ವ್ಹಾವ್‌ನೆ ಅ ಚ್ಹಿಯ್ಯೊನ ತುನ ದಿರಕಿಸ್!” ಕರಿಬೋಲಿ. <verse eid="RUT 4:15" /><verse number="16" style="v" sid="RUT 4:16" />ನವೊಮಿ ನೆ ಯೊ ಲಡ್ಕಾನ ಇನ ಖೋಳಾಮ ರಾಖಿನ್ ಪಾಳುಕರ್ ಥಿಥ್ಹಿ. <verse eid="RUT 4:16" /><verse number="17" style="v" sid="RUT 4:17" />ಖ್ಹಮೆ ಪಿಟೆಲಿ ಭಯಿಕಖ್ಹರು, “ನವೊಮಿ ನ ಜತ್ ನೊ ಎಕ್ ಛಿಯ್ಯೊ ಪೈದಹುಯಿರ‍್ಹೋಸ್!” ಕರಿ ಬೋಲಿನ್ ಯೊ ಲಡ್ಕಾನ “ಓಬೇದ್” ಕರಿ ನಾಮ್ ಮ್ಹೇಲ್ಯು. ಆಸ್ ಇಷಯ್ ನೊ ಬಾ, ಬುಜು ಇಷಯ್ ದಾವೀದ್ ನೊ ಬಾ. <verse eid="RUT 4:17" /><verse number="18" style="v" sid="RUT 4:18" />ಪೆರೆಚನು ಖಾನ್‌ಧಾನ್; ಪೆರೆಚ್ ನೊ ಚ್ಹಿಯ್ಯೊ ಹೆಚ್ರೋನ್, <verse eid="RUT 4:18" /><verse number="19" style="v" sid="RUT 4:19" />ಹೆಚ್ರೋನ್ ನೊ ಚ್ಹಿಯ್ಯೊ ರಾಮ್, ರಾಮ್ ನೊ ಚ್ಹಿಯ್ಯೊ ಅಮೀನದಾಬ್, <verse eid="RUT 4:19" /><verse number="20" style="v" sid="RUT 4:20" />ಅಮೀನದಾಬ್ ನೊ ಚ್ಹಿಯ್ಯೊ ನಹಶೋನ್, ನಹಶೋನ್ ನೊ ಚ್ಹಿಯ್ಯೊ ಸಲ್ಮೋನ್, <verse eid="RUT 4:20" /><verse number="21" style="v" sid="RUT 4:21" />ಸಲ್ಮೋನ್‌ ನೊ ಚ್ಹಿಯ್ಯೊ ಬೋವಜ್, ಬೋವಜ್ ನೊ ಚ್ಹಿಯ್ಯೊ ಓಬೇದ್, <verse eid="RUT 4:21" /><verse number="22" style="v" sid="RUT 4:22" />ಓಬೇದ್ ನೊ ಚ್ಹಿಯ್ಯೊ ಇಷಯ್, ಇಷಯ್ ನೊ ಚ್ಹಿಯ್ಯೊ ದಾವೀದ್.<verse eid="RUT 4:22" /></para>
  <chapter eid="RUT 4" />
</usx>