<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="COL" style="id">Sanskrit Bible (NT) in Devanagari Script (सत्यवेदः।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Colossians</para>
  <para style="toc1">कलसिनः पत्रं</para>
  <para style="toc2">कलसिनः</para>
  <para style="toc3">कलसिनः</para>
  <para style="mt1">कलसिनः पत्रं</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ईश्वरस्येच्छया यीशुख्रीष्टस्य प्रेरितः पौलस्तीमथियो भ्राता च कलसीनगरस्थान् पवित्रान् विश्वस्तान् ख्रीष्टाश्रितभ्रातृन् प्रति पत्रं लिखतः।</para>
  <para style="p">
    <verse number="2" style="v"/>अस्माकं तात ईश्वरः प्रभु र्यीशुख्रीष्टश्च युष्मान् प्रति प्रसादं शान्तिञ्च क्रियास्तां।</para>
  <para style="p">
    <verse number="3" style="v"/>ख्रीष्टे यीशौ युष्माकं विश्वासस्य सर्व्वान् पवित्रलोकान् प्रति प्रेम्नश्च वार्त्तां श्रुत्वा</para>
  <para style="p">
    <verse number="4" style="v"/>वयं सदा युष्मदर्थं प्रार्थनां कुर्व्वन्तः स्वर्गे निहिताया युष्माकं भाविसम्पदः कारणात् स्वकीयप्रभो र्यीशुख्रीष्टस्य तातम् ईश्वरं धन्यं वदामः।</para>
  <para style="p">
    <verse number="5" style="v"/>यूयं तस्या भाविसम्पदो वार्त्तां यया सुसंवादरूपिण्या सत्यवाण्या ज्ञापिताः</para>
  <para style="p">
    <verse number="6" style="v"/>सा यद्वत् कृस्नं जगद् अभिगच्छति तद्वद् युष्मान् अप्यभ्यगमत्, यूयञ्च यद् दिनम् आरभ्येश्वरस्यानुग्रहस्य वार्त्तां श्रुत्वा सत्यरूपेण ज्ञातवन्तस्तदारभ्य युष्माकं मध्येऽपि फलति वर्द्धते च।</para>
  <para style="p">
    <verse number="7" style="v"/>अस्माकं प्रियः सहदासो युष्माकं कृते च ख्रीष्टस्य विश्वस्तपरिचारको य इपफ्रास्तद् वाक्यं</para>
  <para style="p">
    <verse number="8" style="v"/>युष्मान् आदिष्टवान् स एवास्मान् आत्मना जनितं युष्माकं प्रेम ज्ञापितवान्।</para>
  <para style="p">
    <verse number="9" style="v"/>वयं यद् दिनम् आरभ्य तां वार्त्तां श्रुतवन्तस्तदारभ्य निरन्तरं युष्माकं कृते प्रार्थनां कुर्म्मः फलतो यूयं यत् पूर्णाभ्याम् आत्मिकज्ञानवुद्धिभ्याम् ईश्वरस्याभितमं सम्पूर्णरूपेणावगच्छेत,</para>
  <para style="p">
    <verse number="10" style="v"/>प्रभो र्योग्यं सर्व्वथा सन्तोषजनकञ्चाचारं कुर्य्यातार्थत ईश्वरज्ञाने वर्द्धमानाः सर्व्वसत्कर्म्मरूपं फलं फलेत,</para>
  <para style="p">
    <verse number="11" style="v"/>यथा चेश्वरस्य महिमयुक्तया शक्त्या सानन्देन पूर्णां सहिष्णुतां तितिक्षाञ्चाचरितुं शक्ष्यथ तादृशेन पूर्णबलेन यद् बलवन्तो भवेत,</para>
  <para style="p">
    <verse number="12" style="v"/>यश्च पिता तेजोवासिनां पवित्रलोकानाम् अधिकारस्यांशित्वायास्मान् योग्यान् कृतवान् तं यद् धन्यं वदेत वरम् एनं याचामहे।</para>
  <para style="p">
    <verse number="13" style="v"/>यतः सोऽस्मान् तिमिरस्य कर्त्तृत्वाद् उद्धृत्य स्वकीयस्य प्रियपुत्रस्य राज्ये स्थापितवान्।</para>
  <para style="p">
    <verse number="14" style="v"/>तस्मात् पुत्राद् वयं परित्राणम् अर्थतः पापमोचनं प्राप्तवन्तः।</para>
  <para style="p">
    <verse number="15" style="v"/>स चादृश्यस्येश्वरस्य प्रतिमूर्तिः कृत्स्नायाः सृष्टेरादिकर्त्ता च।</para>
  <para style="p">
    <verse number="16" style="v"/>यतः सर्व्वमेव तेन ससृजे सिंहासनराजत्वपराक्रमादीनि स्वर्गमर्त्त्यस्थितानि दृश्यादृश्यानि वस्तूनि सर्व्वाणि तेनैव तस्मै च ससृजिरे।</para>
  <para style="p">
    <verse number="17" style="v"/>स सर्व्वेषाम् आदिः सर्व्वेषां स्थितिकारकश्च।</para>
  <para style="p">
    <verse number="18" style="v"/>स एव समितिरूपायास्तनो र्मूर्द्धा किञ्च सर्व्वविषये स यद् अग्रियो भवेत् तदर्थं स एव मृतानां मध्यात् प्रथमत उत्थितोऽग्रश्च।</para>
  <para style="p">
    <verse number="19" style="v"/>यत ईश्वरस्य कृत्स्नं पूर्णत्वं तमेवावासयितुं</para>
  <para style="p">
    <verse number="20" style="v"/>क्रुशे पातितेन तस्य रक्तेन सन्धिं विधाय तेनैव स्वर्गमर्त्त्यस्थितानि सर्व्वाणि स्वेन सह सन्धापयितुञ्चेश्वरेणाभिलेषे।</para>
  <para style="p">
    <verse number="21" style="v"/>पूर्व्वं दूरस्था दुष्क्रियारतमनस्कत्वात् तस्य रिपवश्चास्त ये यूयं तान् युष्मान् अपि स इदानीं तस्य मांसलशरीरे मरणेन स्वेन सह सन्धापितवान्।</para>
  <para style="p">
    <verse number="22" style="v"/>यतः स स्वसम्मुखे पवित्रान् निष्कलङ्कान् अनिन्दनीयांश्च युष्मान् स्थापयितुम् इच्छति।</para>
  <para style="p">
    <verse number="23" style="v"/>किन्त्वेतदर्थं युष्माभि र्बद्धमूलैः सुस्थिरैश्च भवितव्यम्, आकाशमण्डलस्याधःस्थितानां सर्व्वलोकानां मध्ये च घुष्यमाणो यः सुसंवादो युष्माभिरश्रावि तज्जातायां प्रत्याशायां युष्माभिरचलै र्भवितव्यं।</para>
  <para style="p">
    <verse number="24" style="v"/>तस्य सुसंवादस्यैकः परिचारको योऽहं पौलः सोऽहम् इदानीम् आनन्देन युष्मदर्थं दुःखानि सहे ख्रीष्टस्य क्लेशभोगस्य योंशोऽपूर्णस्तमेव तस्य तनोः समितेः कृते स्वशरीरे पूरयामि च।</para>
  <para style="p">
    <verse number="25" style="v"/>यत ईश्वरस्य मन्त्रणया युष्मदर्थम् ईश्वरीयवाक्यस्य प्रचारस्य भारो मयि समपितस्तस्माद् अहं तस्याः समितेः परिचारकोऽभवं।</para>
  <para style="p">
    <verse number="26" style="v"/>तत् निगूढं वाक्यं पूर्व्वयुगेषु पूर्व्वपुरुषेभ्यः प्रच्छन्नम् आसीत् किन्त्विदानीं तस्य पवित्रलोकानां सन्निधौ तेन प्राकाश्यत।</para>
  <para style="p">
    <verse number="27" style="v"/>यतो भिन्नजातीयानां मध्ये तत् निगूढवाक्यं कीदृग्गौरवनिधिसम्बलितं तत् पवित्रलोकान् ज्ञापयितुम् ईश्वरोऽभ्यलषत्। युष्मन्मध्यवर्त्ती ख्रीष्ट एव स निधि र्गैरवाशाभूमिश्च।</para>
  <para style="p">
    <verse number="28" style="v"/>तस्माद् वयं तमेव घोषयन्तो यद् एकैकं मानवं सिद्धीभूतं ख्रीष्टे स्थापयेम तदर्थमेकैकं मानवं प्रबोधयामः पूर्णज्ञानेन चैकैकं मानवं उपदिशामः।</para>
  <para style="p">
    <verse number="29" style="v"/>एतदर्थं तस्य या शक्तिः प्रबलरूपेण मम मध्ये प्रकाशते तयाहं यतमानः श्राभ्यामि।</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>युष्माकं लायदिकेयास्थभ्रातृणाञ्च कृते यावन्तो भ्रातरश्च मम शारीरिकमुखं न दृष्टवन्तस्तेषां कृते मम कियान् यत्नो भवति तद् युष्मान् ज्ञापयितुम् इच्छामि।</para>
  <para style="p">
    <verse number="2" style="v"/>फलतः पूर्णबुद्धिरूपधनभोगाय प्रेम्ना संयुक्तानां तेषां मनांसि यत् पितुरीश्वरस्य ख्रीष्टस्य च निगूढवाक्यस्य ज्ञानार्थं सान्त्वनां प्राप्नुयुरित्यर्थमहं यते।</para>
  <para style="p">
    <verse number="3" style="v"/>यतो विद्याज्ञानयोः सर्व्वे निधयः ख्रीष्टे गुप्ताः सन्ति।</para>
  <para style="p">
    <verse number="4" style="v"/>कोऽपि युष्मान् विनयवाक्येन यन्न वञ्चयेत् तदर्थम् एतानि मया कथ्यन्ते।</para>
  <para style="p">
    <verse number="5" style="v"/>युष्मत्सन्निधौ मम शरीरेऽवर्त्तमानेऽपि ममात्मा वर्त्तते तेन युष्माकं सुरीतिं ख्रीष्टविश्वासे स्थिरत्वञ्च दृष्ट्वाहम् आनन्दामि।</para>
  <para style="p">
    <verse number="6" style="v"/>अतो यूयं प्रभुं यीशुख्रीष्टं यादृग् गृहीतवन्तस्तादृक् तम् अनुचरत।</para>
  <para style="p">
    <verse number="7" style="v"/>तस्मिन् बद्धमूलाः स्थापिताश्च भवत या च शिक्षा युष्माभि र्लब्धा तदनुसाराद् विश्वासे सुस्थिराः सन्तस्तेनैव नित्यं धन्यवादं कुरुत।</para>
  <para style="p">
    <verse number="8" style="v"/>सावधाना भवत मानुषिकशिक्षात इहलोकस्य वर्णमालातश्चोत्पन्ना ख्रीष्टस्य विपक्षा या दर्शनविद्या मिथ्याप्रतारणा च तया कोऽपि युष्माकं क्षतिं न जनयतु।</para>
  <para style="p">
    <verse number="9" style="v"/>यत ईश्वरस्य कृत्स्ना पूर्णता मूर्त्तिमती ख्रीष्टे वसति।</para>
  <para style="p">
    <verse number="10" style="v"/>यूयञ्च तेन पूर्णा भवथ यतः स सर्व्वेषां राजत्वकर्त्तृत्वपदानां मूर्द्धास्ति,</para>
  <para style="p">
    <verse number="11" style="v"/>तेन च यूयम् अहस्तकृतत्वक्छेदेनार्थतो येन शारीरपापानां विग्रसत्यज्यते तेन ख्रीष्टस्य त्वक्छेदेन छिन्नत्वचो जाता</para>
  <para style="p">
    <verse number="12" style="v"/>मज्जने च तेन सार्द्धं श्मशानं प्राप्ताः पुन र्मृतानां मध्यात् तस्योत्थापयितुरीश्वरस्य शक्तेः फलं यो विश्वासस्तद्वारा तस्मिन्नेव मज्जने तेन सार्द्धम् उत्थापिता अभवत।</para>
  <para style="p">
    <verse number="13" style="v"/>स च युष्मान् अपराधैः शारीरिकात्वक्छेदेन च मृतान् दृष्ट्वा तेन सार्द्धं जीवितवान् युष्माकं सर्व्वान् अपराधान् क्षमितवान्,</para>
  <para style="p">
    <verse number="14" style="v"/>यच्च दण्डाज्ञारूपं ऋणपत्रम् अस्माकं विरुद्धम् आसीत् तत् प्रमार्ज्जितवान् शलाकाभिः क्रुशे बद्ध्वा दूरीकृतवांश्च।</para>
  <para style="p">
    <verse number="15" style="v"/>किञ्च तेन राजत्वकर्त्तृत्वपदानि निस्तेजांसि कृत्वा पराजितान् रिपूनिव प्रगल्भतया सर्व्वेषां दृष्टिगोचरे ह्रेपितवान्।</para>
  <para style="p">
    <verse number="16" style="v"/>अतो हेतोः खाद्याखाद्ये पेयापेये उत्सवः प्रतिपद् विश्रामवारश्चैतेषु सर्व्वेषु युष्माकं न्यायाधिपतिरूपं कमपि मा गृह्लीत।</para>
  <para style="p">
    <verse number="17" style="v"/>यत एतानि छायास्वरूपाणि किन्तु सत्या मूर्त्तिः ख्रीष्टः।</para>
  <para style="p">
    <verse number="18" style="v"/>अपरञ्च नम्रता स्वर्गदूतानां सेवा चैतादृशम् इष्टकर्म्माचरन् यः कश्चित् परोक्षविषयान् प्रविशति स्वकीयशारीरिकभावेन च मुधा गर्व्वितः सन्</para>
  <para style="p">
    <verse number="19" style="v"/>सन्धिभिः शिराभिश्चोपकृतं संयुक्तञ्च कृत्स्नं शरीरं यस्मात् मूर्द्धत ईश्वरीयवृद्धिं प्राप्नोति तं मूर्द्धानं न धारयति तेन मानवेन युष्मत्तः फलापहरणं नानुजानीत।</para>
  <para style="p">
    <verse number="20" style="v"/>यदि यूयं ख्रीष्टेन सार्द्धं संसारस्य वर्णमालायै मृता अभवत तर्हि यैै र्द्रव्यै र्भोगेन क्षयं गन्तव्यं</para>
  <para style="p">
    <verse number="21" style="v"/>तानि मा स्पृश मा भुंक्ष्व मा गृहाणेति मानवैरादिष्टान् शिक्षितांश्च विधीन्</para>
  <para style="p">
    <verse number="22" style="v"/>आचरन्तो यूयं कुतः संसारे जीवन्त इव भवथ?</para>
  <para style="p">
    <verse number="23" style="v"/>ते विधयः स्वेच्छाभक्त्या नम्रतया शरीरक्लेशनेन च ज्ञानविधिवत् प्रकाशन्ते तथापि तेऽगण्याः शारीरिकभाववर्द्धकाश्च सन्ति।</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>यदि यूयं ख्रीष्टेन सार्द्धम् उत्थापिता अभवत तर्हि यस्मिन् स्थाने ख्रीष्ट ईश्वरस्य दक्षिणपार्श्वे उपविष्ट आस्ते तस्योर्द्ध्वस्थानस्य विषयान् चेष्टध्वं।</para>
  <para style="p">
    <verse number="2" style="v"/>पार्थिवविषयेषु न यतमाना ऊर्द्ध्वस्थविषयेषु यतध्वं।</para>
  <para style="p">
    <verse number="3" style="v"/>यतो यूयं मृतवन्तो युष्माकं जीवितञ्च ख्रीष्टेन सार्द्धम् ईश्वरे गुप्तम् अस्ति।</para>
  <para style="p">
    <verse number="4" style="v"/>अस्माकं जीवनस्वरूपः ख्रीष्टो यदा प्रकाशिष्यते तदा तेन सार्द्धं यूयमपि विभवेन प्रकाशिष्यध्वे।</para>
  <para style="p">
    <verse number="5" style="v"/>अतो वेश्यागमनम् अशुचिक्रिया रागः कुत्सिताभिलाषो देवपूजातुल्यो लोभश्चैतानि र्पािथवपुरुषस्याङ्गानि युष्माभि र्निहन्यन्तां।</para>
  <para style="p">
    <verse number="6" style="v"/>यत एतेभ्यः कर्म्मभ्य आज्ञालङ्घिनो लोकान् प्रतीश्वरस्य क्रोधो वर्त्तते।</para>
  <para style="p">
    <verse number="7" style="v"/>पूर्व्वं यदा यूयं तान्युपाजीवत तदा यूयमपि तान्येवाचरत;</para>
  <para style="p">
    <verse number="8" style="v"/>किन्त्विदानीं क्रोधो रोषो जिहिंसिषा दुर्मुखता वदननिर्गतकदालपश्चैतानि सर्व्वाणि दूरीकुरुध्वं।</para>
  <para style="p">
    <verse number="9" style="v"/>यूयं परस्परं मृषाकथां न वदत यतो यूयं स्वकर्म्मसहितं पुरातनपुरुषं त्यक्तवन्तः</para>
  <para style="p">
    <verse number="10" style="v"/>स्वस्रष्टुः प्रतिमूर्त्या तत्त्वज्ञानाय नूतनीकृतं नवीनपुरुषं परिहितवन्तश्च।</para>
  <para style="p">
    <verse number="11" style="v"/>तेन च यिहूदिभिन्नजातीययोश्छिन्नत्वगच्छिन्नत्वचो र्म्लेच्छस्कुथीययो र्दासमुक्तयोश्च कोऽपि विशेषो नास्ति किन्तु सर्व्वेषु सर्व्वः ख्रीष्ट एवास्ते।</para>
  <para style="p">
    <verse number="12" style="v"/>अतएव यूयम् ईश्वरस्य मनोभिलषिताः पवित्राः प्रियाश्च लोका इव स्नेहयुक्ताम् अनुकम्पां हितैषितां नम्रतां तितिक्षां सहिष्णुताञ्च परिधद्ध्वं।</para>
  <para style="p">
    <verse number="13" style="v"/>यूयम् एकैकस्याचरणं सहध्वं येन च यस्य किमप्यपराध्यते तस्य तं दोषं स क्षमतां, ख्रीष्टो युष्माकं दोषान् यद्वद् क्षमितवान् यूयमपि तद्वत् कुरुध्वं।</para>
  <para style="p">
    <verse number="14" style="v"/>विशेषतः सिद्धिजनकेन प्रेमबन्धनेन बद्धा भवत।</para>
  <para style="p">
    <verse number="15" style="v"/>यस्याः प्राप्तये यूयम् एकस्मिन् शरीरे समाहूता अभवत सेश्वरीया शान्ति र्युष्माकं मनांस्यधितिष्ठतु यूयञ्च कृतज्ञा भवत।</para>
  <para style="p">
    <verse number="16" style="v"/>ख्रीष्टस्य वाक्यं सर्व्वविधज्ञानाय सम्पूर्णरूपेण युष्मदन्तरे निवमतु, यूयञ्च गीतै र्गानैः पारमार्थिकसङ्कीर्त्तनैश्च परस्परम् आदिशत प्रबोधयत च, अनुगृहीतत्वात् प्रभुम् उद्दिश्य स्वमनोभि र्गायत च।</para>
  <para style="p">
    <verse number="17" style="v"/>वाचा कर्म्मणा वा यद् यत् कुरुत तत् सर्व्वं प्रभो र्यीशो र्नाम्ना कुरुत तेन पितरम् ईश्वरं धन्यं वदत च।</para>
  <para style="p">
    <verse number="18" style="v"/>हे योषितः, यूयं स्वामिनां वश्या भवत यतस्तदेव प्रभवे रोचते।</para>
  <para style="p">
    <verse number="19" style="v"/>हे स्वामिनः, यूयं भार्य्यासु प्रीयध्वं ताः प्रति परुषालापं मा कुरुध्वं।</para>
  <para style="p">
    <verse number="20" style="v"/>हे बालाः, यूयं सर्व्वविषये पित्रोराज्ञाग्राहिणो भवत यतस्तदेव प्रभोः सन्तोषजनकं।</para>
  <para style="p">
    <verse number="21" style="v"/>हे पितरः, युष्माकं सन्ताना यत् कातरा न भवेयुस्तदर्थं तान् प्रति मा रोषयत।</para>
  <para style="p">
    <verse number="22" style="v"/>हे दासाः, यूयं सर्व्वविषय ऐहिकप्रभूनाम् आज्ञाग्राहिणो भवत दृष्टिगोचरीयसेवया मानवेभ्यो रोचितुं मा यतध्वं किन्तु सरलान्तःकरणैः प्रभो र्भाीत्या कार्य्यं कुरुध्वं।</para>
  <para style="p">
    <verse number="23" style="v"/>यच्च कुरुध्वे तत् मानुषमनुद्दिश्य प्रभुम् उद्दिश्य प्रफुल्लमनसा कुरुध्वं,</para>
  <para style="p">
    <verse number="24" style="v"/>यतो वयं प्रभुतः स्वर्गाधिकाररूपं फलं लप्स्यामह इति यूयं जानीथ यस्माद् यूयं प्रभोः ख्रीष्टस्य दासा भवथ।</para>
  <para style="p">
    <verse number="25" style="v"/>किन्तु यः कश्चिद् अनुचितं कर्म्म करोति स तस्यानुचितकर्म्मणः फलं लप्स्यते तत्र कोऽपि पक्षपातो न भविष्यति।</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अपरञ्च हे अधिपतयः, यूयं दासान् प्रति न्याय्यं यथार्थञ्चाचरणं कुरुध्वं युष्माकमप्येकोऽधिपतिः स्वर्गे विद्यत इति जानीत।</para>
  <para style="p">
    <verse number="2" style="v"/>यूयं प्रार्थनायां नित्यं प्रवर्त्तध्वं धन्यवादं कुर्व्वन्तस्तत्र प्रबुद्धास्तिष्ठत च।</para>
  <para style="p">
    <verse number="3" style="v"/>प्रार्थनाकाले ममापि कृते प्रार्थनां कुरुध्वं,</para>
  <para style="p">
    <verse number="4" style="v"/>फलतः ख्रीष्टस्य यन्निगूढवाक्यकारणाद् अहं बद्धोऽभवं तत्प्रकाशायेश्वरो यत् मदर्थं वाग्द्वारं कुर्य्यात्, अहञ्च यथोचितं तत् प्रकाशयितुं शक्नुयाम् एतत् प्रार्थयध्वं।</para>
  <para style="p">
    <verse number="5" style="v"/>यूयं समयं बहुमूल्यं ज्ञात्वा बहिःस्थान् लोकान् प्रति ज्ञानाचारं कुरुध्वं।</para>
  <para style="p">
    <verse number="6" style="v"/>युष्माकम् आलापः सर्व्वदानुग्रहसूचको लवणेन सुस्वादुश्च भवतु यस्मै यदुत्तरं दातव्यं तद् युष्माभिरवगम्यतां।</para>
  <para style="p">
    <verse number="7" style="v"/>मम या दशाक्ति तां तुखिकनामा प्रभौ प्रियो मम भ्राता विश्वसनीयः परिचारकः सहदासश्च युष्मान् ज्ञापयिष्यति।</para>
  <para style="p">
    <verse number="8" style="v"/>स यद् युष्माकं दशां जानीयात् युष्माकं मनांसि सान्त्वयेच्च तदर्थमेवाहं</para>
  <para style="p">
    <verse number="9" style="v"/>तम् ओनीषिमनामानञ्च युष्मद्देशीयं विश्वस्तं प्रियञ्च भ्रातरं प्रेषितवान् तौ युष्मान् अत्रत्यां सर्व्ववार्त्तां ज्ञापयिष्यतः।</para>
  <para style="p">
    <verse number="10" style="v"/>आरिष्टार्खनामा मम सहबन्दी बर्णब्बा भागिनेयो मार्को युष्टनाम्ना विख्यातो यीशुश्चैते छिन्नत्वचो भ्रातरो युष्मान् नमस्कारं ज्ञापयन्ति, तेषां मध्ये मार्कमधि यूयं पूर्व्वम् आज्ञापिताः स यदि युष्मत्समीपम् उपतिष्ठेत् तर्हि युष्माभि र्गृह्यतां।</para>
  <para style="p">
    <verse number="11" style="v"/>केवलमेत ईश्वरराज्ये मम सान्त्वनाजनकाः सहकारिणोऽभवन्।</para>
  <para style="p">
    <verse number="12" style="v"/>ख्रीष्टस्य दासो यो युष्मद्देशीय इपफ्राः स युष्मान् नमस्कारं ज्ञापयति यूयञ्चेश्वरस्य सर्व्वस्मिन् मनोऽभिलाषे यत् सिद्धाः पूर्णाश्च भवेत तदर्थं स नित्यं प्रार्थनया युष्माकं कृते यतते।</para>
  <para style="p">
    <verse number="13" style="v"/>युष्माकं लायदिकेयास्थितानां हियरापलिस्थितानाञ्च भ्रातृणां हिताय सोऽतीव चेष्टत इत्यस्मिन् अहं तस्य साक्षी भवामि।</para>
  <para style="p">
    <verse number="14" style="v"/>लूकनामा प्रियश्चिकित्सको दीमाश्च युष्मभ्यं नमस्कुर्व्वाते।</para>
  <para style="p">
    <verse number="15" style="v"/>यूयं लायदिकेयास्थान् भ्रातृन् नुम्फां तद्गृहस्थितां समितिञ्च मम नमस्कारं ज्ञापयत।</para>
  <para style="p">
    <verse number="16" style="v"/>अपरं युष्मत्सन्निधौ पत्रस्यास्य पाठे कृते लायदिकेयास्थसमितावपि तस्य पाठो यथा भवेत् लायदिकेयाञ्च यत् पत्रं मया प्रहितं तद् यथा युष्माभिरपि पठ्येत तथा चेष्टध्वं।</para>
  <para style="p">
    <verse number="17" style="v"/>अपरम् आर्खिप्पं वदत प्रभो र्यत् परिचर्य्यापदं त्वयाप्रापि तत्साधनाय सावधानो भव।</para>
  <para style="p">
    <verse number="18" style="v"/>अहं पौलः स्वहस्ताक्षरेण युष्मान् नमस्कारं ज्ञापयामि यूयं मम बन्धनं स्मरत। युष्मान् प्रत्यनुग्रहो भूयात्। आमेन।</para>
</usx>
