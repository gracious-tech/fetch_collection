<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="JUD" style="id">Sanskrit Bible (NT) in Devanagari Script (सत्यवेदः।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Jude</para>
  <para style="toc1">यिहूदाः पत्रं</para>
  <para style="toc2">यिहूदाः</para>
  <para style="toc3">यिहूदाः</para>
  <para style="mt1">यिहूदाः पत्रं</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>यीशुख्रीष्टस्य दासो याकूबो भ्राता यिहूदास्तातेनेश्वरेण पवित्रीकृतान् यीशुख्रीष्टेन रक्षितांश्चाहूतान् लोकान् प्रति पत्रं लिखति।</para>
  <para style="p">
    <verse number="2" style="v"/>कृपा शान्तिः प्रेम च बाहुल्यरूपेण युष्मास्वधितिष्ठतु।</para>
  <para style="p">
    <verse number="3" style="v"/>हे प्रियाः, साधारणपरित्राणमधि युष्मान् प्रति लेखितुं मम बहुयत्ने जाते पूर्व्वकाले पवित्रलोकेषु समर्पितो यो धर्म्मस्तदर्थं यूयं प्राणव्ययेनापि सचेष्टा भवतेति विनयार्थं युष्मान् प्रति पत्रलेखनमावश्यकम् अमन्ये।</para>
  <para style="p">
    <verse number="4" style="v"/>यस्माद् एतद्रूपदण्डप्राप्तये पूर्व्वं लिखिताः केचिज्जना अस्मान् उपसृप्तवन्तः, ते ऽधार्म्मिकलोका अस्माकम् ईश्वरस्यानुग्रहं ध्वजीकृत्य लम्पटताम् आचरन्ति, अद्वितीयो ऽधिपति र्यो ऽस्माकं प्रभु र्यीशुख्रीष्टस्तं नाङ्गीकुर्व्वन्ति।</para>
  <para style="p">
    <verse number="5" style="v"/>तस्माद् यूयं पुरा यद् अवगतास्तत् पुन र्युष्मान् स्मारयितुम् इच्छामि, फलतः प्रभुरेककृत्वः स्वप्रजा मिसरदेशाद् उदधार यत् ततः परम् अविश्वासिनो व्यनाशयत्।</para>
  <para style="p">
    <verse number="6" style="v"/>ये च स्वर्गदूताः स्वीयकर्तृत्वपदे न स्थित्वा स्ववासस्थानं परित्यक्तवन्तस्तान् स महादिनस्य विचारार्थम् अन्धकारमये ऽधःस्थाने सदास्थायिभि र्बन्धनैरबध्नात्।</para>
  <para style="p">
    <verse number="7" style="v"/>अपरं सिदोमम् अमोरा तन्निकटस्थनगराणि चैतेषां निवासिनस्तत्समरूपं व्यभिचारं कृतवन्तो विषममैथुनस्य चेष्टया विपथं गतवन्तश्च तस्मात् तान्यपि दृष्टान्तस्वरूपाणि भूत्वा सदातनवह्निना दण्डं भुञ्जते।</para>
  <para style="p">
    <verse number="8" style="v"/>तथैवेमे स्वप्नाचारिणोऽपि स्वशरीराणि कलङ्कयन्ति राजाधीनतां न स्वीकुर्व्वन्त्युच्चपदस्थान् निन्दन्ति च।</para>
  <para style="p">
    <verse number="9" style="v"/>किन्तु प्रधानदिव्यदूतो मीखायेलो यदा मूससो देहे शयतानेन विवदमानः समभाषत तदा तिस्मन् निन्दारूपं दण्डं समर्पयितुं साहसं न कृत्वाकथयत् प्रभुस्त्वां भर्त्सयतां।</para>
  <para style="p">
    <verse number="10" style="v"/>किन्त्विमे यन्न बुध्यन्ते तन्निन्दन्ति यच्च निर्ब्बोधपशव इवेन्द्रियैरवगच्छन्ति तेन नश्यन्ति।</para>
  <para style="p">
    <verse number="11" style="v"/>तान् धिक्, ते काबिलो मार्गे चरन्ति पारितोषिकस्याशातो बिलियमो भ्रान्तिमनुधावन्ति कोरहस्य दुर्म्मुखत्वेन विनश्यन्ति च।</para>
  <para style="p">
    <verse number="12" style="v"/>युष्माकं प्रेमभोज्येषु ते विघ्नजनका भवन्ति, आत्मम्भरयश्च भूत्वा निर्लज्जया युष्माभिः सार्द्धं भुञ्जते। ते वायुभिश्चालिता निस्तोयमेघा हेमन्तकालिका निष्फला द्वि र्मृता उन्मूलिता वृक्षाः,</para>
  <para style="p">
    <verse number="13" style="v"/>स्वकीयलज्जाफेणोद्वमकाः प्रचण्डाः सामुद्रतरङ्गाः सदाकालं यावत् घोरतिमिरभागीनि भ्रमणकारीणि नक्षत्राणि च भवन्ति।</para>
  <para style="p">
    <verse number="14" style="v"/>आदमतः सप्तमः पुरुषो यो हनोकः स तानुद्दिश्य भविष्यद्वाक्यमिदं कथितवान्, यथा, पश्य स्वकीयपुण्यानाम् अयुतै र्वेष्टितः प्रभुः।</para>
  <para style="p">
    <verse number="15" style="v"/>सर्व्वान् प्रति विचाराज्ञासाधनायागमिष्यति। तदा चाधार्म्मिकाः सर्व्वे जाता यैरपराधिनः। विधर्म्मकर्म्मणां तेषां सर्व्वेषामेव कारणात्। तथा तद्वैपरीत्येनाप्यधर्म्माचारिपापिनां। उक्तकठोरवाक्यानां सर्व्वेषामपि कारणात्। परमेशेन दोषित्वं तेषां प्रकाशयिष्यते॥</para>
  <para style="p">
    <verse number="16" style="v"/>ते वाक्कलहकारिणः स्वभाग्यनिन्दकाः स्वेच्छाचारिणो दर्पवादिमुखविशिष्टा लाभार्थं मनुष्यस्तावकाश्च सन्ति।</para>
  <para style="p">
    <verse number="17" style="v"/>किन्तु हे प्रियतमाः, अस्माकं प्रभो र्यीशुख्रीष्टस्य प्रेरितै र्यद् वाक्यं पूर्व्वं युष्मभ्यं कथितं तत् स्मरत,</para>
  <para style="p">
    <verse number="18" style="v"/>फलतः शेषसमये स्वेच्छातो ऽधर्म्माचारिणो निन्दका उपस्थास्यन्तीति।</para>
  <para style="p">
    <verse number="19" style="v"/>एते लोकाः स्वान् पृथक् कुर्व्वन्तः सांसारिका आत्महीनाश्च सन्ति।</para>
  <para style="p">
    <verse number="20" style="v"/>किन्तु हे प्रियतमाः, यूयं स्वेषाम् अतिपवित्रविश्वासे निचीयमानाः पवित्रेणात्मना प्रार्थनां कुर्व्वन्त</para>
  <para style="p">
    <verse number="21" style="v"/>ईश्वरस्य प्रेम्ना स्वान् रक्षत, अनन्तजीवनाय चास्माकं प्रभो र्यीशुख्रीष्टस्य कृपां प्रतीक्षध्वं।</para>
  <para style="p">
    <verse number="22" style="v"/>अपरं यूयं विविच्य कांश्चिद् अनुकम्पध्वं</para>
  <para style="p">
    <verse number="23" style="v"/>कांश्चिद् अग्नित उद्धृत्य भयं प्रदर्श्य रक्षत, शारीरिकभावेन कलङ्कितं वस्त्रमपि ऋतीयध्वं।</para>
  <para style="p">
    <verse number="24" style="v"/>अपरञ्च युष्मान् स्खलनाद् रक्षितुम् उल्लासेन स्वीयतेजसः साक्षात् निर्द्दोषान् स्थापयितुञ्च समर्थो</para>
  <para style="p">
    <verse number="25" style="v"/>यो ऽस्माकम् अद्वितीयस्त्राणकर्त्ता सर्व्वज्ञ ईश्वरस्तस्य गौरवं महिमा पराक्रमः कर्तृत्वञ्चेदानीम् अनन्तकालं यावद् भूयात्। आमेन्।</para>
</usx>
