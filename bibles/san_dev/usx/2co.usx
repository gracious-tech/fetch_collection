<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="2CO" style="id">Sanskrit Bible (NT) in Devanagari Script (सत्यवेदः।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">2 Corinthians</para>
  <para style="toc1">२ करिन्थिनः पत्रं</para>
  <para style="toc2">२ करिन्थिनः</para>
  <para style="toc3">२ करिन्थिनः</para>
  <para style="mt1">२ करिन्थिनः पत्रं</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ईश्वरस्येच्छया यीशुख्रीष्टस्य प्रेरितः पौलस्तिमथिर्भ्राता च द्वावेतौ करिन्थनगरस्थायै ईश्वरीयसमितय आखायादेशस्थेभ्यः सर्व्वेभ्यः पवित्रलोकेभ्यश्च पत्रं लिखतः।</para>
  <para style="p">
    <verse number="2" style="v"/>अस्माकं तातस्येश्वरस्य प्रभोर्यीशुख्रीष्टस्य चानुग्रहः शान्तिश्च युष्मासु वर्त्ततां।</para>
  <para style="p">
    <verse number="3" style="v"/>कृपालुः पिता सर्व्वसान्त्वनाकारीश्वरश्च योऽस्मत्प्रभोर्यीशुख्रीष्टस्य तात ईश्वरः स धन्यो भवतु।</para>
  <para style="p">
    <verse number="4" style="v"/>यतो वयम् ईश्वरात् सान्त्वनां प्राप्य तया सान्त्वनया यत् सर्व्वविधक्लिष्टान् लोकान् सान्त्वयितुं शक्नुयाम तदर्थं सोऽस्माकं सर्व्वक्लेशसमयेऽस्मान् सान्त्वयति।</para>
  <para style="p">
    <verse number="5" style="v"/>यतः ख्रीष्टस्य क्लेशा यद्वद् बाहुल्येनास्मासु वर्त्तन्ते तद्वद् वयं ख्रीष्टेन बहुसान्त्वनाढ्या अपि भवामः।</para>
  <para style="p">
    <verse number="6" style="v"/>वयं यदि क्लिश्यामहे तर्हि युष्माकं सान्त्वनापरित्राणयोः कृते क्लिश्यामहे यतोऽस्माभि र्यादृशानि दुःखानि सह्यन्ते युष्माकं तादृशदुःखानां सहनेन तौ साधयिष्येते इत्यस्मिन् युष्मानधि मम दृढा प्रत्याशा भवति।</para>
  <para style="p">
    <verse number="7" style="v"/>यदि वा वयं सान्त्वनां लभामहे तर्हि युष्माकं सान्त्वनापरित्राणयोः कृते तामपि लभामहे। यतो यूयं यादृग् दुःखानां भागिनोऽभवत तादृक् सान्त्वनाया अपि भागिनो भविष्यथेति वयं जानीमः।</para>
  <para style="p">
    <verse number="8" style="v"/>हे भ्रातरः, आशियादेशे यः क्लेशोऽस्मान् आक्राम्यत् तं यूयं यद् अनवगतास्तिष्ठत तन्मया भद्रं न मन्यते। तेनातिशक्तिक्लेशेन वयमतीव पीडितास्तस्मात् जीवनरक्षणे निरुपाया जाताश्च,</para>
  <para style="p">
    <verse number="9" style="v"/>अतो वयं स्वेषु न विश्वस्य मृतलोकानाम् उत्थापयितरीश्वरे यद् विश्वासं कुर्म्मस्तदर्थम् अस्माभिः प्राणदण्डो भोक्तव्य इति स्वमनसि निश्चितं।</para>
  <para style="p">
    <verse number="10" style="v"/>एतादृशभयङ्करात् मृत्यो र्यो ऽस्मान् अत्रायतेदानीमपि त्रायते स इतः परमप्यस्मान् त्रास्यते ऽस्माकम् एतादृशी प्रत्याशा विद्यते।</para>
  <para style="p">
    <verse number="11" style="v"/>एतदर्थमस्मत्कृते प्रार्थनया वयं युष्माभिरुपकर्त्तव्यास्तथा कृते बहुभि र्याचितो योऽनुग्रहोऽस्मासु वर्त्तिष्यते तत्कृते बहुभिरीश्वरस्य धन्यवादोऽपि कारिष्यते।</para>
  <para style="p">
    <verse number="12" style="v"/>अपरञ्च संसारमध्ये विशेषतो युष्मन्मध्ये वयं सांसारिक्या धिया नहि किन्त्वीश्वरस्यानुग्रहेणाकुटिलताम् ईश्वरीयसारल्यञ्चाचरितवन्तोऽत्रास्माकं मनो यत् प्रमाणं ददाति तेन वयं श्लाघामहे।</para>
  <para style="p">
    <verse number="13" style="v"/>युष्माभि र्यद् यत् पठ्यते गृह्यते च तदन्यत् किमपि युष्मभ्यम् अस्माभि र्न लिख्यते तच्चान्तं यावद् युष्माभि र्ग्रहीष्यत इत्यस्माकम् आशा।</para>
  <para style="p">
    <verse number="14" style="v"/>यूयमितः पूर्व्वमप्यस्मान् अंशतो गृहीतवन्तः, यतः प्रभो र्यीशुख्रीष्टस्य दिने यद्वद् युष्मास्वस्माकं श्लाघा तद्वद् अस्मासु युष्माकमपि श्लाघा भविष्यति।</para>
  <para style="p">
    <verse number="15" style="v"/>अपरं यूयं यद् द्वितीयं वरं लभध्वे तदर्थमितः पूर्व्वं तया प्रत्याशया युष्मत्समीपं गमिष्यामि</para>
  <para style="p">
    <verse number="16" style="v"/>युष्मद्देशेन माकिदनियादेशं व्रजित्वा पुनस्तस्मात् माकिदनियादेशात् युष्मत्समीपम् एत्य युष्माभि र्यिहूदादेशं प्रेषयिष्ये चेति मम वाञ्छासीत्।</para>
  <para style="p">
    <verse number="17" style="v"/>एतादृशी मन्त्रणा मया किं चाञ्चल्येन कृता? यद् यद् अहं मन्त्रये तत् किं विषयिलोकइव मन्त्रयाण आदौ स्वीकृत्य पश्चाद् अस्वीकुर्व्वे?</para>
  <para style="p">
    <verse number="18" style="v"/>युष्मान् प्रति मया कथितानि वाक्यान्यग्रे स्वीकृतानि शेषेऽस्वीकृतानि नाभवन् एतेनेश्वरस्य विश्वस्तता प्रकाशते।</para>
  <para style="p">
    <verse number="19" style="v"/>मया सिल्वानेन तिमथिना चेश्वरस्य पुत्रो यो यीशुख्रीष्टो युष्मन्मध्ये घोषितः स तेन स्वीकृतः पुनरस्वीकृतश्च तन्नहि किन्तु स तस्य स्वीकारस्वरूपएव।</para>
  <para style="p">
    <verse number="20" style="v"/>ईश्वरस्य महिमा यद् अस्माभिः प्रकाशेत तदर्थम् ईश्वरेण यद् यत् प्रतिज्ञातं तत्सर्व्वं ख्रीष्टेन स्वीकृतं सत्यीभूतञ्च।</para>
  <para style="p">
    <verse number="21" style="v"/>युष्मान् अस्मांश्चाभिषिच्य यः ख्रीष्टे स्थास्नून् करोति स ईश्वर एव।</para>
  <para style="p">
    <verse number="22" style="v"/>स चास्मान् मुद्राङ्कितान् अकार्षीत् सत्याङ्कारस्य पणखरूपम् आत्मानं अस्माकम् अन्तःकरणेषु निरक्षिपच्च।</para>
  <para style="p">
    <verse number="23" style="v"/>अपरं युष्मासु करुणां कुर्व्वन् अहम् एतावत्कालं यावत् करिन्थनगरं न गतवान् इति सत्यमेतस्मिन् ईश्वरं साक्षिणं कृत्वा मया स्वप्राणानां शपथः क्रियते।</para>
  <para style="p">
    <verse number="24" style="v"/>वयं युष्माकं विश्वासस्य नियन्तारो न भवामः किन्तु युष्माकम् आनन्दस्य सहाया भवामः, यस्माद् विश्वासे युष्माकं स्थिति र्भवति।</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अपरञ्चाहं पुनः शोकाय युष्मत्सन्निधिं न गमिष्यामीति मनसि निरचैषं।</para>
  <para style="p">
    <verse number="2" style="v"/>यस्माद् अहं यदि युष्मान् शोकयुक्तान् करोमि तर्हि मया यः शोकयुक्तीकृतस्तं विना केनापरेणाहं हर्षयिष्ये?</para>
  <para style="p">
    <verse number="3" style="v"/>मम यो हर्षः स युष्माकं सर्व्वेषां हर्ष एवेति निश्चितं मयाबोधि; अतएव यैरहं हर्षयितव्यस्तै र्मदुपस्थितिसमये यन्मम शोको न जायेत तदर्थमेव युष्मभ्यम् एतादृशं पत्रं मया लिखितं।</para>
  <para style="p">
    <verse number="4" style="v"/>वस्तुतस्तु बहुक्लेशस्य मनःपीडायाश्च समयेऽहं बह्वश्रुपातेन पत्रमेकं लिखितवान् युष्माकं शोकार्थं तन्नहि किन्तु युष्मासु मदीयप्रेमबाहुल्यस्य ज्ञापनार्थं।</para>
  <para style="p">
    <verse number="5" style="v"/>येनाहं शोकयुक्तीकृतस्तेन केवलमहं शोकयुक्तीकृतस्तन्नहि किन्त्वंशतो यूयं सर्व्वेऽपि यतोऽहमत्र कस्मिंश्चिद् दोषमारोपयितुं नेच्छामि।</para>
  <para style="p">
    <verse number="6" style="v"/>बहूनां यत् तर्ज्जनं तेन जनेनालम्भि तत् तदर्थं प्रचुरं।</para>
  <para style="p">
    <verse number="7" style="v"/>अतः स दुःखसागरे यन्न निमज्जति तदर्थं युष्माभिः स क्षन्तव्यः सान्त्वयितव्यश्च।</para>
  <para style="p">
    <verse number="8" style="v"/>इति हेतोः प्रर्थयेऽहं युष्माभिस्तस्मिन् दया क्रियतां।</para>
  <para style="p">
    <verse number="9" style="v"/>यूयं सर्व्वकर्म्मणि ममादेशं गृह्लीथ न वेति परीक्षितुम् अहं युष्मान् प्रति लिखितवान्।</para>
  <para style="p">
    <verse number="10" style="v"/>यस्य यो दोषो युष्माभिः क्षम्यते तस्य स दोषो मयापि क्षम्यते यश्च दोषो मया क्षम्यते स युष्माकं कृते ख्रीष्टस्य साक्षात् क्षम्यते।</para>
  <para style="p">
    <verse number="11" style="v"/>शयतानः कल्पनास्माभिरज्ञाता नहि, अतो वयं यत् तेन न वञ्च्यामहे तदर्थम् अस्माभिः सावधानै र्भवितव्यं।</para>
  <para style="p">
    <verse number="12" style="v"/>अपरञ्च ख्रीष्टस्य सुसंवादघोषणार्थं मयि त्रोयानगरमागते प्रभोः कर्म्मणे च मदर्थं द्वारे मुक्ते</para>
  <para style="p">
    <verse number="13" style="v"/>सत्यपि स्वभ्रातुस्तीतस्याविद्यमानत्वात् मदीयात्मनः कापि शान्ति र्न बभूव, तस्माद् अहं तान् विसर्ज्जनं याचित्वा माकिदनियादेशं गन्तुं प्रस्थानम् अकरवं।</para>
  <para style="p">
    <verse number="14" style="v"/>य ईश्वरः सर्व्वदा ख्रीष्टेनास्मान् जयिनः करोति सर्व्वत्र चास्माभिस्तदीयज्ञानस्य गन्धं प्रकाशयति स धन्यः।</para>
  <para style="p">
    <verse number="15" style="v"/>यस्माद् ये त्राणं लप्स्यन्ते ये च विनाशं गमिष्यन्ति तान् प्रति वयम् ईश्वरेण ख्रीष्टस्य सौगन्ध्यं भवामः।</para>
  <para style="p">
    <verse number="16" style="v"/>वयम् एकेषां मृत्यवे मृत्युगन्धा अपरेषाञ्च जीवनाय जीवनगन्धा भवामः, किन्त्वेतादृशकर्म्मसाधने कः समर्थोऽस्ति?</para>
  <para style="p">
    <verse number="17" style="v"/>अन्ये बहवो लोका यद्वद् ईश्वरस्य वाक्यं मृषाशिक्षया मिश्रयन्ति वयं तद्वत् तन्न मिश्रयन्तः सरलभावेनेश्वरस्य साक्षाद् ईश्वरस्यादेशात् ख्रीष्टेन कथां भाषामहे।</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>वयं किम् आत्मप्रशंसनं पुनरारभामहे? युष्मान् प्रति युष्मत्तो वा परेषां केषाञ्चिद् इवास्माकमपि किं प्रशंसापत्रेषु प्रयोजनम् आस्ते?</para>
  <para style="p">
    <verse number="2" style="v"/>यूयमेवास्माकं प्रशंसापत्रं तच्चास्माकम् अन्तःकरणेषु लिखितं सर्व्वमानवैश्च ज्ञेयं पठनीयञ्च।</para>
  <para style="p">
    <verse number="3" style="v"/>यतो ऽस्माभिः सेवितं ख्रीष्टस्य पत्रं यूयपेव, तच्च न मस्या किन्त्वमरस्येश्वरस्यात्मना लिखितं पाषाणपत्रेषु तन्नहि किन्तु क्रव्यमयेषु हृत्पत्रेषु लिखितमिति सुस्पष्टं।</para>
  <para style="p">
    <verse number="4" style="v"/>ख्रीष्टेनेश्वरं प्रत्यस्माकम् ईदृशो दृढविश्वासो विद्यते;</para>
  <para style="p">
    <verse number="5" style="v"/>वयं निजगुणेन किमपि कल्पयितुं समर्था इति नहि किन्त्वीश्वरादस्माकं सामर्थ्यं जायते।</para>
  <para style="p">
    <verse number="6" style="v"/>तेन वयं नूतननियमस्यार्थतो ऽक्षरसंस्थानस्य तन्नहि किन्त्वात्मन एव सेवनसामर्थ्यं प्राप्ताः। अक्षरसंस्थानं मृत्युजनकं किन्त्वात्मा जीवनदायकः।</para>
  <para style="p">
    <verse number="7" style="v"/>अक्षरै र्विलिखितपाषाणरूपिणी या मृत्योः सेवा सा यदीदृक् तेजस्विनी जाता यत्तस्याचिरस्थायिनस्तेजसः कारणात् मूससो मुखम् इस्रायेलीयलोकैः संद्रष्टुं नाशक्यत,</para>
  <para style="p">
    <verse number="8" style="v"/>तर्ह्यात्मनः सेवा किं ततोऽपि बहुतेजस्विनी न भवेत्?</para>
  <para style="p">
    <verse number="9" style="v"/>दण्डजनिका सेवा यदि तेजोयुक्ता भवेत् तर्हि पुण्यजनिका सेवा ततोऽधिकं बहुतेजोयुक्ता भविष्यति।</para>
  <para style="p">
    <verse number="10" style="v"/>उभयोस्तुलनायां कृतायाम् एकस्यास्तेजो द्वितीयायाः प्रखरतरेण तेजसा हीनतेजो भवति।</para>
  <para style="p">
    <verse number="11" style="v"/>यस्माद् यत् लोपनीयं तद् यदि तेजोयुक्तं भवेत् तर्हि यत् चिरस्थायि तद् बहुतरतेजोयुक्तमेव भविष्यति।</para>
  <para style="p">
    <verse number="12" style="v"/>ईदृशीं प्रत्याशां लब्ध्वा वयं महतीं प्रगल्भतां प्रकाशयामः।</para>
  <para style="p">
    <verse number="13" style="v"/>इस्रायेलीयलोका यत् तस्य लोपनीयस्य तेजसः शेषं न विलोकयेयुस्तदर्थं मूसा यादृग् आवरणेन स्वमुखम् आच्छादयत् वयं तादृक् न कुर्म्मः।</para>
  <para style="p">
    <verse number="14" style="v"/>तेषां मनांसि कठिनीभूतानि यतस्तेषां पठनसमये स पुरातनो नियमस्तेनावरणेनाद्यापि प्रच्छन्नस्तिष्ठति।</para>
  <para style="p">
    <verse number="15" style="v"/>तच्च न दूरीभवति यतः ख्रीष्टेनैव तत् लुप्यते। मूससः शास्त्रस्य पाठसमयेऽद्यापि तेषां मनांसि तेनावरणेन प्रच्छाद्यन्ते।</para>
  <para style="p">
    <verse number="16" style="v"/>किन्तु प्रभुं प्रति मनसि परावृत्ते तद् आवरणं दूरीकारिष्यते।</para>
  <para style="p">
    <verse number="17" style="v"/>यः प्रभुः स एव स आत्मा यत्र च प्रभोरात्मा तत्रैव मुक्तिः।</para>
  <para style="p">
    <verse number="18" style="v"/>वयञ्च सर्व्वेऽनाच्छादितेनास्येन प्रभोस्तेजसः प्रतिबिम्बं गृह्लन्त आत्मस्वरूपेण प्रभुना रूपान्तरीकृता वर्द्धमानतेजोयुक्तां तामेव प्रतिमूर्त्तिं प्राप्नुमः।</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अपरञ्च वयं करुणाभाजो भूत्वा यद् एतत् परिचारकपदम् अलभामहि नात्र क्लाम्यामः,</para>
  <para style="p">
    <verse number="2" style="v"/>किन्तु त्रपायुक्तानि प्रच्छन्नकर्म्माणि विहाय कुटिलताचरणमकुर्व्वन्त ईश्वरीयवाक्यं मिथ्यावाक्यैरमिश्रयन्तः सत्यधर्म्मस्य प्रकाशनेनेश्वरस्य साक्षात् सर्व्वमानवानां संवेदगोचरे स्वान् प्रशंसनीयान् दर्शयामः।</para>
  <para style="p">
    <verse number="3" style="v"/>अस्माभि र्घोषितः सुसंवादो यदि प्रच्छन्नः; स्यात् तर्हि ये विनंक्ष्यन्ति तेषामेव दृष्टितः स प्रच्छन्नः;</para>
  <para style="p">
    <verse number="4" style="v"/>यत ईश्वरस्य प्रतिमूर्त्ति र्यः ख्रीष्टस्तस्य तेजसः सुसंवादस्य प्रभा यत् तान् न दीपयेत् तदर्थम् इह लोकस्य देवोऽविश्वासिनां ज्ञाननयनम् अन्धीकृतवान् एतस्योदाहरणं ते भवन्ति।</para>
  <para style="p">
    <verse number="5" style="v"/>वयं स्वान् घोषयाम इति नहि किन्तु ख्रीष्टं यीशुं प्रभुमेवास्मांश्च यीशोः कृते युष्माकं परिचारकान् घोषयामः।</para>
  <para style="p">
    <verse number="6" style="v"/>य ईश्वरो मध्येतिमिरं प्रभां दीपनायादिशत् स यीशुख्रीष्टस्यास्य ईश्वरीयतेजसो ज्ञानप्रभाया उदयार्थम् अस्माकम् अन्तःकरणेषु दीपितवान्।</para>
  <para style="p">
    <verse number="7" style="v"/>अपरं तद् धनम् अस्माभि र्मृण्मयेषु भाजनेषु धार्य्यते यतः साद्भुता शक्ति र्नास्माकं किन्त्वीश्वरस्यैवेति ज्ञातव्यं।</para>
  <para style="p">
    <verse number="8" style="v"/>वयं पदे पदे पीड्यामहे किन्तु नावसीदामः, वयं व्याकुलाः सन्तोऽपि निरुपाया न भवामः;</para>
  <para style="p">
    <verse number="9" style="v"/>वयं प्रद्राव्यमाना अपि न क्लाम्यामः, निपातिता अपि न विनश्यामः।</para>
  <para style="p">
    <verse number="10" style="v"/>अस्माकं शरीरे ख्रीष्टस्य जीवनं यत् प्रकाशेत तदर्थं तस्मिन् शरीरे यीशो र्मरणमपि धारयामः।</para>
  <para style="p">
    <verse number="11" style="v"/>यीशो र्जीवनं यद् अस्माकं मर्त्त्यदेहे प्रकाशेत तदर्थं जीवन्तो वयं यीशोः कृते नित्यं मृत्यौ समर्प्यामहे।</para>
  <para style="p">
    <verse number="12" style="v"/>इत्थं वयं मृत्याक्रान्ता यूयञ्च जीवनाक्रान्ताः।</para>
  <para style="p">
    <verse number="13" style="v"/>विश्वासकारणादेव समभाषि मया वचः। इति यथा शास्त्रे लिखितं तथैवास्माभिरपि विश्वासजनकम् आत्मानं प्राप्य विश्वासः क्रियते तस्माच्च वचांसि भाष्यन्ते।</para>
  <para style="p">
    <verse number="14" style="v"/>प्रभु र्यीशु र्येनोत्थापितः स यीशुनास्मानप्युत्थापयिष्यति युष्माभिः सार्द्धं स्वसमीप उपस्थापयिष्यति च, वयम् एतत् जानीमः।</para>
  <para style="p">
    <verse number="15" style="v"/>अतएव युष्माकं हिताय सर्व्वमेव भवति तस्माद् बहूनां प्रचुरानुुग्रहप्राप्ते र्बहुलोकानां धन्यवादेनेश्वरस्य महिमा सम्यक् प्रकाशिष्यते।</para>
  <para style="p">
    <verse number="16" style="v"/>ततो हेतो र्वयं न क्लाम्यामः किन्तु बाह्यपुरुषो यद्यपि क्षीयते तथाप्यान्तरिकः पुरुषो दिने दिने नूतनायते।</para>
  <para style="p">
    <verse number="17" style="v"/>क्षणमात्रस्थायि यदेतत् लघिष्ठं दुःखं तद् अतिबाहुल्येनास्माकम् अनन्तकालस्थायि गरिष्ठसुखं साधयति,</para>
  <para style="p">
    <verse number="18" style="v"/>यतो वयं प्रत्यक्षान् विषयान् अनुद्दिश्याप्रत्यक्षान् उद्दिशामः। यतो हेतोः प्रत्यक्षविषयाः क्षणमात्रस्थायिनः किन्त्वप्रत्यक्षा अनन्तकालस्थायिनः।</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अपरम् अस्माकम् एतस्मिन् पार्थिवे दूष्यरूपे वेश्मनि जीर्णे सतीश्वरेण निर्म्मितम् अकरकृतम् अस्माकम् अनन्तकालस्थायि वेश्मैकं स्वर्गे विद्यत इति वयं जानीमः।</para>
  <para style="p">
    <verse number="2" style="v"/>यतो हेतोरेतस्मिन् वेश्मनि तिष्ठन्तो वयं तं स्वर्गीयं वासं परिधातुम् आकाङ्क्ष्यमाणा निःश्वसामः।</para>
  <para style="p">
    <verse number="3" style="v"/>तथापीदानीमपि वयं तेन न नग्नाः किन्तु परिहितवसना मन्यामहे।</para>
  <para style="p">
    <verse number="4" style="v"/>एतस्मिन् दूष्ये तिष्ठनतो वयं क्लिश्यमाना निःश्वसामः, यतो वयं वासं त्यक्तुम् इच्छामस्तन्नहि किन्तु तं द्वितीयं वासं परिधातुम् इच्छामः, यतस्तथा कृते जीवनेन मर्त्यं ग्रसिष्यते।</para>
  <para style="p">
    <verse number="5" style="v"/>एतदर्थं वयं येन सृष्टाः स ईश्वर एव स चास्मभ्यं सत्यङ्कारस्य पणस्वरूपम् आत्मानं दत्तवान्।</para>
  <para style="p">
    <verse number="6" style="v"/>अतएव वयं सर्व्वदोत्सुका भवामः किञ्च शरीरे यावद् अस्माभि र्न्युष्यते तावत् प्रभुतो दूरे प्रोष्यत इति जानीमः,</para>
  <para style="p">
    <verse number="7" style="v"/>यतो वयं दृष्टिमार्गे न चरामः किन्तु विश्वासमार्गे।</para>
  <para style="p">
    <verse number="8" style="v"/>अपरञ्च शरीराद् दूरे प्रवस्तुं प्रभोः सन्निधौ निवस्तुञ्चाकाङ्क्ष्यमाणा उत्सुका भवामः।</para>
  <para style="p">
    <verse number="9" style="v"/>तस्मादेव कारणाद् वयं तस्य सन्निधौ निवसन्तस्तस्माद् दूरे प्रवसन्तो वा तस्मै रोचितुं यतामहे।</para>
  <para style="p">
    <verse number="10" style="v"/>यस्मात् शरीरावस्थायाम् एकैकेन कृतानां कर्म्मणां शुभाशुभफलप्राप्तये सर्व्वैस्माभिः ख्रीष्टस्य विचारासनसम्मुख उपस्थातव्यं।</para>
  <para style="p">
    <verse number="11" style="v"/>अतएव प्रभो र्भयानकत्वं विज्ञाय वयं मनुजान् अनुनयामः किञ्चेश्वरस्य गोचरे सप्रकाशा भवामः, युष्माकं संवेदगोचरेऽपि सप्रकाशा भवाम इत्याशंसामहे।</para>
  <para style="p">
    <verse number="12" style="v"/>अनेन वयं युष्माकं सन्निधौ पुनः स्वान् प्रशंसाम इति नहि किन्तु ये मनो विना मुखैः श्लाघन्ते तेभ्यः प्रत्युत्तरदानाय यूयं यथास्माभिः श्लाघितुं शक्नुथ तादृशम् उपायं युष्मभ्यं वितरामः।</para>
  <para style="p">
    <verse number="13" style="v"/>यदि वयं हतज्ञाना भवामस्तर्हि तद् ईश्वरार्थकं यदि च सज्ञाना भवामस्तर्हि तद् युष्मदर्थकं।</para>
  <para style="p">
    <verse number="14" style="v"/>वयं ख्रीष्टस्य प्रेम्ना समाकृष्यामहे यतः सर्व्वेषां विनिमयेन यद्येको जनोऽम्रियत तर्हि ते सर्व्वे मृता इत्यास्माभि र्बुध्यते।</para>
  <para style="p">
    <verse number="15" style="v"/>अपरञ्च ये जीवन्ति ते यत् स्वार्थं न जीवन्ति किन्तु तेषां कृते यो जनो मृतः पुनरुत्थापितश्च तमुद्दिश्य यत् जीवन्ति तदर्थमेव स सर्व्वेषां कृते मृतवान्।</para>
  <para style="p">
    <verse number="16" style="v"/>अतो हेतोरितः परं कोऽप्यस्माभि र्जातितो न प्रतिज्ञातव्यः।यद्यपि पूर्व्वं ख्रीष्टो जातितोऽस्माभिः प्रतिज्ञातस्तथापीदानीं जातितः पुन र्न प्रतिज्ञायते।</para>
  <para style="p">
    <verse number="17" style="v"/>केनचित् ख्रीष्ट आश्रिते नूतना सृष्टि र्भवति पुरातनानि लुप्यन्ते पश्य निखिलानि नवीनानि भवन्ति।</para>
  <para style="p">
    <verse number="18" style="v"/>सर्व्वञ्चैतद् ईश्वरस्य कर्म्म यतो यीशुख्रीष्टेन स एवास्मान् स्वेन सार्द्धं संहितवान् सन्धानसम्बन्धीयां परिचर्य्याम् अस्मासु समर्पितवांश्च।</para>
  <para style="p">
    <verse number="19" style="v"/>यतः ईश्वरः ख्रीष्टम् अधिष्ठाय जगतो जनानाम् आगांसि तेषाम् ऋणमिव न गणयन् स्वेन सार्द्धं तान् संहितवान् सन्धिवार्त्ताम् अस्मासु समर्पितवांश्च।</para>
  <para style="p">
    <verse number="20" style="v"/>अतो वयं ख्रीष्टस्य विनिमयेन दौत्यं कर्म्म सम्पादयामहे, ईश्वरश्चास्माभि र्युष्मान् यायाच्यते ततः ख्रीष्टस्य विनिमयेन वयं युष्मान् प्रार्थयामहे यूयमीश्वरेण सन्धत्त।</para>
  <para style="p">
    <verse number="21" style="v"/>यतो वयं तेन यद् ईश्वरीयपुण्यं भवामस्तदर्थं पापेन सह यस्य ज्ञातेयं नासीत् स एव तेनास्माकं विनिमयेन पापः कृतः।</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>तस्य सहाया वयं युष्मान् प्रार्थयामहे, ईश्वरस्यानुग्रहो युष्माभि र्वृथा न गृह्यतां।</para>
  <para style="p">
    <verse number="2" style="v"/>तेनोक्तमेतत्, संश्रोष्यामि शुभे काले त्वदीयां प्रार्थनाम् अहं। उपकारं करिष्यामि परित्राणदिने तव। पश्यतायं शुभकालः पश्यतेदं त्राणदिनं।</para>
  <para style="p">
    <verse number="3" style="v"/>अस्माकं परिचर्य्या यन्निष्कलङ्का भवेत् तदर्थं वयं कुत्रापि विघ्नं न जनयामः,</para>
  <para style="p">
    <verse number="4" style="v"/>किन्तु प्रचुरसहिष्णुता क्लेशो दैन्यं विपत् ताडना काराबन्धनं निवासहीनत्वं परिश्रमो जागरणम् उपवसनं</para>
  <para style="p">
    <verse number="5" style="v"/>निर्म्मलत्वं ज्ञानं मृदुशीलता हितैषिता</para>
  <para style="p">
    <verse number="6" style="v"/>पवित्र आत्मा निष्कपटं प्रेम सत्यालाप ईश्वरीयशक्ति</para>
  <para style="p">
    <verse number="7" style="v"/>र्दक्षिणवामाभ्यां कराभ्यां धर्म्मास्त्रधारणं</para>
  <para style="p">
    <verse number="8" style="v"/>मानापमानयोरख्यातिसुख्यात्यो र्भागित्वम् एतैः सर्व्वैरीश्वरस्य प्रशंस्यान् परिचारकान् स्वान् प्रकाशयामः।</para>
  <para style="p">
    <verse number="9" style="v"/>भ्रमकसमा वयं सत्यवादिनो भवामः, अपरिचितसमा वयं सुपरिचिता भवामः, मृतकल्पा वयं जीवामः, दण्ड्यमाना वयं न हन्यामहे,</para>
  <para style="p">
    <verse number="10" style="v"/>शोकयुक्ताश्च वयं सदानन्दामः, दरिद्रा वयं बहून् धनिनः कुर्म्मः, अकिञ्चनाश्च वयं सर्व्वं धारयामः।</para>
  <para style="p">
    <verse number="11" style="v"/>हे करिन्थिनः, युष्माकं प्रति ममास्यं मुक्तं ममान्तःकरणाञ्च विकसितं।</para>
  <para style="p">
    <verse number="12" style="v"/>यूयं ममान्तरे न सङ्कोचिताः किञ्च यूयमेव सङ्कोचितचित्ताः।</para>
  <para style="p">
    <verse number="13" style="v"/>किन्तु मह्यं न्याय्यफलदानार्थं युष्माभिरपि विकसितै र्भवितव्यम् इत्यहं निजबालकानिव युष्मान् वदामि।</para>
  <para style="p">
    <verse number="14" style="v"/>अपरम् अप्रत्ययिभिः सार्द्धं यूयम् एकयुगे बद्धा मा भूत, यस्माद् धर्म्माधर्म्मयोः कः सम्बन्धोऽस्ति? तिमिरेण सर्द्धं प्रभाया वा का तुलनास्ति?</para>
  <para style="p">
    <verse number="15" style="v"/>बिलीयालदेवेन साकं ख्रीष्टस्य वा का सन्धिः? अविश्वासिना सार्द्धं वा विश्वासिलोकस्यांशः कः?</para>
  <para style="p">
    <verse number="16" style="v"/>ईश्वरस्य मन्दिरेण सह वा देवप्रतिमानां का तुलना? अमरस्येश्वरस्य मन्दिरं यूयमेव। ईश्वरेण तदुक्तं यथा, तेषां मध्येऽहं स्वावासं निधास्यामि तेषां मध्ये च यातायातं कुर्व्वन् तेषाम् ईश्वरो भविष्यामि ते च मल्लोका भविष्यन्ति।</para>
  <para style="p">
    <verse number="17" style="v"/>अतो हेतोः परमेश्वरः कथयति यूयं तेषां मध्याद् बहिर्भूय पृथग् भवत, किमप्यमेध्यं न स्पृशत; तेनाहं युष्मान् ग्रहीष्यामि,</para>
  <para style="p">
    <verse number="18" style="v"/>युष्माकं पिता भविष्यामि च, यूयञ्च मम कन्यापुत्रा भविष्यथेति सर्व्वशक्तिमता परमेश्वरेणोक्तं।</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अतएव हे प्रियतमाः, एतादृशीः प्रतिज्ञाः प्राप्तैरस्माभिः शरीरात्मनोः सर्व्वमालिन्यम् अपमृज्येश्वरस्य भक्त्या पवित्राचारः साध्यतां।</para>
  <para style="p">
    <verse number="2" style="v"/>यूयम् अस्मान् गृह्लीत। अस्माभिः कस्याप्यन्यायो न कृतः कोऽपि न वञ्चितः।</para>
  <para style="p">
    <verse number="3" style="v"/>युष्मान् दोषिणः कर्त्तमहं वाक्यमेतद् वदामीति नहि युष्माभिः सह जीवनाय मरणाय वा वयं युष्मान् स्वान्तःकरणै र्धारयाम इति पूर्व्वं मयोक्तं।</para>
  <para style="p">
    <verse number="4" style="v"/>युष्मान् प्रति मम महेत्साहो जायते युष्मान् अध्यहं बहु श्लाघे च तेन सर्व्वक्लेशसमयेऽहं सान्त्वनया पूर्णो हर्षेण प्रफुल्लितश्च भवामि।</para>
  <para style="p">
    <verse number="5" style="v"/>अस्मासु माकिदनियादेशम् आगतेष्वस्माकं शरीरस्य काचिदपि शान्ति र्नाभवत् किन्तु सर्व्वतो बहि र्विरोधेनान्तश्च भीत्या वयम् अपीड्यामहि।</para>
  <para style="p">
    <verse number="6" style="v"/>किन्तु नम्राणां सान्त्वयिता य ईश्वरः स तीतस्यागमनेनास्मान् असान्त्वयत्।</para>
  <para style="p">
    <verse number="7" style="v"/>केवलं तस्यागमनेन तन्नहि किन्तु युष्मत्तो जातया तस्य सान्त्वनयापि, यतोऽस्मासु युष्माकं हार्द्दविलापासक्तत्वेष्वस्माकं समीपे वर्णितेषु मम महानन्दो जातः।</para>
  <para style="p">
    <verse number="8" style="v"/>अहं पत्रेण युष्मान् शोकयुक्तान् कृतवान् इत्यस्माद् अन्वतप्ये किन्त्वधुना नानुतप्ये। तेन पत्रेण यूयं क्षणमात्रं शोकयुक्तीभूता इति मया दृश्यते।</para>
  <para style="p">
    <verse number="9" style="v"/>इत्यस्मिन् युष्माकं शोकेनाहं हृष्यामि तन्नहि किन्तु मनःपरिवर्त्तनाय युष्माकं शोकोऽभवद् इत्यनेन हृष्यामि यतोऽस्मत्तो युष्माकं कापि हानि र्यन्न भवेत् तदर्थं युष्माकम् ईश्वरीयः शोेको जातः।</para>
  <para style="p">
    <verse number="10" style="v"/>स ईश्वरीयः शोकः परित्राणजनकं निरनुतापं मनःपरिवर्त्तनं साधयति किन्तु सांसारिकः शोको मृत्युं साधयति।</para>
  <para style="p">
    <verse number="11" style="v"/>पश्यत तेनेश्वरीयेण शोकेन युष्माकं किं न साधितं? यत्नो दोषप्रक्षालनम् असन्तुष्टत्वं हार्द्दम् आसक्तत्वं फलदानञ्चैतानि सर्व्वाणि। तस्मिन् कर्म्मणि यूयं निर्म्मला इति प्रमाणं सर्व्वेण प्रकारेण युष्माभि र्दत्तं।</para>
  <para style="p">
    <verse number="12" style="v"/>येनापराद्धं तस्य कृते किंवा यस्यापराद्धं तस्य कृते मया पत्रम् अलेखि तन्नहि किन्तु युष्मानध्यस्माकं यत्नो यद् ईश्वरस्य साक्षाद् युष्मत्समीपे प्रकाशेत तदर्थमेव।</para>
  <para style="p">
    <verse number="13" style="v"/>उक्तकारणाद् वयं सान्त्वनां प्राप्ताः; ताञ्च सान्त्वनां विनावरो महाह्लादस्तीतस्याह्लादादस्माभि र्लब्धः, यतस्तस्यात्मा सर्व्वै र्युष्माभिस्तृप्तः।</para>
  <para style="p">
    <verse number="14" style="v"/>पूर्व्वं तस्य समीपेऽहं युष्माभिर्यद् अश्लाघे तेन नालज्जे किन्तु वयं यद्वद् युष्मान् प्रति सत्यभावेन सकलम् अभाषामहि तद्वत् तीतस्य समीपेऽस्माकं श्लाघनमपि सत्यं जातं।</para>
  <para style="p">
    <verse number="15" style="v"/>यूयं कीदृक् तस्याज्ञा अपालयत भयकम्पाभ्यां तं गृहीतवन्तश्चैतस्य स्मरणाद् युष्मासु तस्य स्नेहो बाहुल्येन वर्त्तते।</para>
  <para style="p">
    <verse number="16" style="v"/>युष्मास्वहं सर्व्वमाशंसे, इत्यस्मिन् ममाह्लादो जायते।</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>हे भ्रातरः, माकिदनियादेशस्थासु समितिषु प्रकाशितो य ईश्वरस्यानुग्रहस्तमहं युष्मान् ज्ञापयामि।</para>
  <para style="p">
    <verse number="2" style="v"/>वस्तुतो बहुक्लेशपरीक्षासमये तेषां महानन्दोऽतीवदीनता च वदान्यतायाः प्रचुरफलम् अफलयतां।</para>
  <para style="p">
    <verse number="3" style="v"/>ते स्वेच्छया यथाशक्ति किञ्चातिशक्ति दान उद्युक्ता अभवन् इति मया प्रमाणीक्रियते।</para>
  <para style="p">
    <verse number="4" style="v"/>वयञ्च यत् पवित्रलोकेभ्यस्तेषां दानम् उपकारार्थकम् अंशनञ्च गृह्लामस्तद् बहुनुनयेनास्मान् प्रार्थितवन्तः।</para>
  <para style="p">
    <verse number="5" style="v"/>वयं यादृक् प्रत्यै़क्षामहि तादृग् अकृत्वा तेऽग्रे प्रभवे ततः परम् ईश्वरस्येच्छयास्मभ्यमपि स्वान् न्यवेदयन्।</para>
  <para style="p">
    <verse number="6" style="v"/>अतो हेतोस्त्वं यथारब्धवान् तथैव करिन्थिनां मध्येऽपि तद् दानग्रहणं साधयेति युष्मान् अधि वयं तीतं प्रार्थयामहि।</para>
  <para style="p">
    <verse number="7" style="v"/>अतो विश्वासो वाक्पटुता ज्ञानं सर्व्वोत्साहो ऽस्मासु प्रेम चैतै र्गुणै र्यूयं यथापरान् अतिशेध्वे तथैवैतेन गुणेनाप्यतिशेध्वं।</para>
  <para style="p">
    <verse number="8" style="v"/>एतद् अहम् आज्ञया कथयामीति नहि किन्त्वन्येषाम् उत्साहकारणाद् युष्माकमपि प्रेम्नः सारल्यं परीक्षितुमिच्छता मयैतत् कथ्यते।</para>
  <para style="p">
    <verse number="9" style="v"/>यूयञ्चास्मत्प्रभो र्यीशुख्रीष्टस्यानुग्रहं जानीथ यतस्तस्य निर्धनत्वेन यूयं यद् धनिनो भवथ तदर्थं स धनी सन्नपि युष्मत्कृते निर्धनोऽभवत्।</para>
  <para style="p">
    <verse number="10" style="v"/>एतस्मिन् अहं युष्मान् स्वविचारं ज्ञापयामि। गतं संवत्सरम् आरभ्य यूयं केवलं कर्म्म कर्त्तं तन्नहि किन्त्विच्छुकतां प्रकाशयितुमप्युपाक्राभ्यध्वं ततो हेतो र्युष्मत्कृते मम मन्त्रणा भद्रा।</para>
  <para style="p">
    <verse number="11" style="v"/>अतो ऽधुना तत्कर्म्मसाधनं युष्माभिः क्रियतां तेन यद्वद् इच्छुकतायाम् उत्साहस्तद्वद् एकैकस्य सम्पदनुसारेण कर्म्मसाधनम् अपि जनिष्यते।</para>
  <para style="p">
    <verse number="12" style="v"/>यस्मिन् इच्छुकता विद्यते तेन यन्न धार्य्यते तस्मात् सोऽनुगृह्यत इति नहि किन्तु यद् धार्य्यते तस्मादेव।</para>
  <para style="p">
    <verse number="13" style="v"/>यत इतरेषां विरामेण युष्माकञ्च क्लेशेन भवितव्यं तन्नहि किन्तु समतयैव।</para>
  <para style="p">
    <verse number="14" style="v"/>वर्त्तमानसमये युष्माकं धनाधिक्येन तेषां धनन्यूनता पूरयितव्या तस्मात् तेषामप्याधिक्येन युष्माकं न्यूनता पूरयिष्यते तेन समता जनिष्यते।</para>
  <para style="p">
    <verse number="15" style="v"/>तदेव शास्त्रेऽपि लिखितम् आस्ते यथा, येनाधिकं संगृहीतं तस्याधिकं नाभवत् येन चाल्पं संगृहीतं तस्याल्पं नाभवत्।</para>
  <para style="p">
    <verse number="16" style="v"/>युष्माकं हिताय तीतस्य मनसि य ईश्वर इमम् उद्योगं जनितवान् स धन्यो भवतु।</para>
  <para style="p">
    <verse number="17" style="v"/>तीतोऽस्माकं प्रार्थनां गृहीतवान् किञ्च स्वयम् उद्युक्तः सन् स्वेच्छया युष्मत्समीपं गतवान्।</para>
  <para style="p">
    <verse number="18" style="v"/>तेन सह योऽपर एको भ्रातास्माभिः प्रेषितः सुसंवादात् तस्य सुख्यात्या सर्व्वाः समितयो व्याप्ताः।</para>
  <para style="p">
    <verse number="19" style="v"/>प्रभो र्गौरवाय युष्माकम् इच्छुकतायै च स समितिभिरेतस्यै दानसेवायै अस्माकं सङ्गित्वे न्ययोज्यत।</para>
  <para style="p">
    <verse number="20" style="v"/>यतो या महोपायनसेवास्माभि र्विधीयते तामधि वयं यत् केनापि न निन्द्यामहे तदर्थं यतामहे।</para>
  <para style="p">
    <verse number="21" style="v"/>यतः केवलं प्रभोः साक्षात् तन्नहि किन्तु मानवानामपि साक्षात् सदाचारं कर्त्तुम् आलोचामहे।</para>
  <para style="p">
    <verse number="22" style="v"/>ताभ्यां सहापर एको यो भ्रातास्माभिः प्रेषितः सोऽस्माभि र्बहुविषयेषु बहवारान् परीक्षित उद्योगीव प्रकाशितश्च किन्त्वधुना युष्मासु दृढविश्वासात् तस्योत्साहो बहु ववृधे।</para>
  <para style="p">
    <verse number="23" style="v"/>यदि कश्चित् तीतस्य तत्त्वं जिज्ञासते तर्हि स मम सहभागी युष्मन्मध्ये सहकारी च, अपरयो र्भ्रात्रोस्तत्त्वं वा यदि जिज्ञासते तर्हि तौ समितीनां दूतौ ख्रीष्टस्य प्रतिबिम्बौ चेति तेन ज्ञायतां।</para>
  <para style="p">
    <verse number="24" style="v"/>अतो हेतोः समितीनां समक्षं युष्मत्प्रेम्नोऽस्माकं श्लाघायाश्च प्रामाण्यं तान् प्रति युष्माभिः प्रकाशयितव्यं।</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>पवित्रलोकानाम् उपकारार्थकसेवामधि युष्मान् प्रति मम लिखनं निष्प्रयोजनं।</para>
  <para style="p">
    <verse number="2" style="v"/>यत आखायादेशस्था लोका गतवर्षम् आरभ्य तत्कार्य्य उद्यताः सन्तीति वाक्येनाहं माकिदनीयलोकानां समीपे युष्माकं याम् इच्छुकतामधि श्लाघे ताम् अवगतोऽस्मि युष्माकं तस्माद् उत्साहाच्चापरेषां बहूनाम् उद्योगो जातः।</para>
  <para style="p">
    <verse number="3" style="v"/>किञ्चैतस्मिन् युष्मान् अध्यस्माकं श्लाघा यद् अतथ्या न भवेत् यूयञ्च मम वाक्यानुसाराद् यद् उद्यतास्तिष्ठेत तदर्थमेव ते भ्रातरो मया प्रेषिताः।</para>
  <para style="p">
    <verse number="4" style="v"/>यस्मात् मया सार्द्धं कैश्चित् माकिदनीयभ्रातृभिरागत्य यूयमनुद्यता इति यदि दृश्यते तर्हि तस्माद् दृढविश्वासाद् युष्माकं लज्जा जनिष्यत इत्यस्माभि र्न वक्तव्यं किन्त्वस्माकमेव लज्जा जनिष्यते।</para>
  <para style="p">
    <verse number="5" style="v"/>अतः प्राक् प्रतिज्ञातं युष्माकं दानं यत् सञ्चितं भवेत् तच्च यद् ग्राहकतायाः फलम् अभूत्वा दानशीलताया एव फलं भवेत् तदर्थं ममाग्रे गमनाय तत्सञ्चयनाय च तान् भ्रातृन् आदेष्टुमहं प्रयोजनम् अमन्ये।</para>
  <para style="p">
    <verse number="6" style="v"/>अपरमपि व्याहरामि केनचित् क्षुद्रभावेन बीजेषूप्तेषु स्वल्पानि शस्यानि कर्त्तिष्यन्ते, किञ्च केनचिद् बहुदभवेन बीजेषूप्तेषु बहूनि शस्यानि कर्त्तिष्यन्ते।</para>
  <para style="p">
    <verse number="7" style="v"/>एकैकेन स्वमनसि यथा निश्चीयते तथैव दीयतां केनापि कातरेण भीतेन वा न दीयतां यत ईश्वरो हृष्टमानसे दातरि प्रीयते।</para>
  <para style="p">
    <verse number="8" style="v"/>अपरम् ईश्वरो युष्मान् प्रति सर्व्वविधं बहुप्रदं प्रसादं प्रकाशयितुम् अर्हति तेन यूयं सर्व्वविषये यथेष्टं प्राप्य सर्व्वेण सत्कर्म्मणा बहुफलवन्तो भविष्यथ।</para>
  <para style="p">
    <verse number="9" style="v"/>एतस्मिन् लिखितमास्ते, यथा, व्ययते स जनो रायं दुर्गतेभ्यो ददाति च। नित्यस्थायी च तद्धर्म्मः</para>
  <para style="p">
    <verse number="10" style="v"/>बीजं भेजनीयम् अन्नञ्च वप्त्रे येन विश्राण्यते स युष्मभ्यम् अपि बीजं विश्राण्य बहुलीकरिष्यति युष्माकं धर्म्मफलानि वर्द्धयिष्यति च।</para>
  <para style="p">
    <verse number="11" style="v"/>तेन सर्व्वविषये सधनीभूतै र्युष्माभिः सर्व्वविषये दानशीलतायां प्रकाशितायाम् अस्माभिरीश्वरस्य धन्यवादः साधयिष्यते।</para>
  <para style="p">
    <verse number="12" style="v"/>एतयोपकारसेवया पवित्रलोकानाम् अर्थाभावस्य प्रतीकारो जायत इति केवलं नहि किन्त्वीश्चरस्य धन्यवादोऽपि बाहुल्येनोत्पाद्यते।</para>
  <para style="p">
    <verse number="13" style="v"/>यत एतस्माद् उपकारकरणाद् युष्माकं परीक्षितत्वं बुद्ध्वा बहुभिः ख्रीष्टसुसंवादाङ्गीकरणे युष्माकम् आज्ञाग्राहित्वात् तद्भागित्वे च तान् अपरांश्च प्रति युष्माकं दातृत्वाद् ईश्वरस्य धन्यवादः कारिष्यते,</para>
  <para style="p">
    <verse number="14" style="v"/>युष्मदर्थं प्रार्थनां कृत्वा च युष्मास्वीश्वरस्य गरिष्ठानुग्रहाद् युष्मासु तैः प्रेम कारिष्यते।</para>
  <para style="p">
    <verse number="15" style="v"/>अपरम् ईश्वरस्यानिर्व्वचनीयदानात् स धन्यो भूयात्।</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>युष्मत्प्रत्यक्षे नम्रः किन्तु परोक्षे प्रगल्भः पौलोऽहं ख्रीष्टस्य क्षान्त्या विनीत्या च युष्मान् प्रार्थये।</para>
  <para style="p">
    <verse number="2" style="v"/>मम प्रार्थनीयमिदं वयं यैः शारीरिकाचारिणो मन्यामहे तान् प्रति यां प्रगल्भतां प्रकाशयितुं निश्चिनोमि सा प्रगल्भता समागतेन मयाचरितव्या न भवतु।</para>
  <para style="p">
    <verse number="3" style="v"/>यतः शरीरे चरन्तोऽपि वयं शारीरिकं युद्धं न कुर्म्मः।</para>
  <para style="p">
    <verse number="4" style="v"/>अस्माकं युद्धास्त्राणि च न शारीरिकानि किन्त्वीश्वरेण दुर्गभञ्जनाय प्रबलानि भवन्ति,</para>
  <para style="p">
    <verse number="5" style="v"/>तैश्च वयं वितर्कान् ईश्वरीयतत्त्वज्ञानस्य प्रतिबन्धिकां सर्व्वां चित्तसमुन्नतिञ्च निपातयामः सर्व्वसङ्कल्पञ्च बन्दिनं कृत्वा ख्रीष्टस्याज्ञाग्राहिणं कुर्म्मः,</para>
  <para style="p">
    <verse number="6" style="v"/>युष्माकम् आज्ञाग्राहित्वे सिद्धे सति सर्व्वस्याज्ञालङ्घनस्य प्रतीकारं कर्त्तुम् उद्यता आस्महे च।</para>
  <para style="p">
    <verse number="7" style="v"/>यद् दृष्टिगोचरं तद् युष्माभि र्दृश्यतां। अहं ख्रीष्टस्य लोक इति स्वमनसि येन विज्ञायते स यथा ख्रीष्टस्य भवति वयम् अपि तथा ख्रीष्टस्य भवाम इति पुनर्विविच्य तेन बुध्यतां।</para>
  <para style="p">
    <verse number="8" style="v"/>युष्माकं निपाताय तन्नहि किन्तु निष्ठायै प्रभुना दत्तं यदस्माकं सामर्थ्यं तेन यद्यपि किञ्चिद् अधिकं श्लाघे तथापि तस्मान्न त्रपिष्ये।</para>
  <para style="p">
    <verse number="9" style="v"/>अहं पत्रै र्युष्मान् त्रासयामि युष्माभिरेतन्न मन्यतां।</para>
  <para style="p">
    <verse number="10" style="v"/>तस्य पत्राणि गुरुतराणि प्रबलानि च भवन्ति किन्तु तस्य शारीरसाक्षात्कारो दुर्ब्बल आलापश्च तुच्छनीय इति कैश्चिद् उच्यते।</para>
  <para style="p">
    <verse number="11" style="v"/>किन्तु परोक्षे पत्रै र्भाषमाणा वयं यादृशाः प्रकाशामहे प्रत्यक्षे कर्म्म कुर्व्वन्तोऽपि तादृशा एव प्रकाशिष्यामहे तत् तादृशेन वाचालेन ज्ञायतां।</para>
  <para style="p">
    <verse number="12" style="v"/>स्वप्रशंसकानां केषाञ्चिन्मध्ये स्वान् गणयितुं तैः स्वान् उपमातुं वा वयं प्रगल्भा न भवामः, यतस्ते स्वपरिमाणेन स्वान् परिमिमते स्वैश्च स्वान् उपमिभते तस्मात् निर्ब्बोधा भवन्ति च।</para>
  <para style="p">
    <verse number="13" style="v"/>वयम् अपरिमितेन न श्लाघिष्यामहे किन्त्वीश्वरेण स्वरज्ज्वा युष्मद्देशगामि यत् परिमाणम् अस्मदर्थं निरूपितं तेनैव श्लाघिष्यामहे।</para>
  <para style="p">
    <verse number="14" style="v"/>युष्माकं देशोऽस्माभिरगन्तव्यस्तस्माद् वयं स्वसीमाम् उल्लङ्घामहे तन्नहि यतः ख्रीष्टस्य सुसंवादेनापरेषां प्राग् वयमेव युष्मान् प्राप्तवन्तः।</para>
  <para style="p">
    <verse number="15" style="v"/>वयं स्वसीमाम् उल्लङ्घ्य परक्षेत्रेण श्लाघामहे तन्नहि, किञ्च युष्माकं विश्वासे वृद्धिं गते युष्मद्देशेऽस्माकं सीमा युष्माभिर्दीर्घं विस्तारयिष्यते,</para>
  <para style="p">
    <verse number="16" style="v"/>तेन वयं युष्माकं पश्चिमदिक्स्थेषु स्थानेषु सुसंवादं घोषयिष्यामः, इत्थं परसीमायां परेण यत् परिष्कृतं तेन न श्लाघिष्यामहे।</para>
  <para style="p">
    <verse number="17" style="v"/>यः कश्चित् श्लाघमानः स्यात् श्लाघतां प्रभुना स हि।</para>
  <para style="p">
    <verse number="18" style="v"/>स्वेन यः प्रशंस्यते स परीक्षितो नहि किन्तु प्रभुना यः प्रशंस्यते स एव परीक्षितः।</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>यूयं ममाज्ञानतां क्षणं यावत् सोढुम् अर्हथ, अतः सा युष्माभिः सह्यतां।</para>
  <para style="p">
    <verse number="2" style="v"/>ईश्वरे ममासक्तत्वाद् अहं युष्मानधि तपे यस्मात् सतीं कन्यामिव युष्मान् एकस्मिन् वरेऽर्थतः ख्रीष्टे समर्पयितुम् अहं वाग्दानम् अकार्षं।</para>
  <para style="p">
    <verse number="3" style="v"/>किन्तु सर्पेण स्वखलतया यद्वद् हवा वञ्चयाञ्चके तद्वत् ख्रीष्टं प्रति सतीत्वाद् युष्माकं भ्रंशः सम्भविष्यतीति बिभेमि।</para>
  <para style="p">
    <verse number="4" style="v"/>अस्माभिरनाख्यापितोऽपरः कश्चिद् यीशु र्यदि केनचिद् आगन्तुकेनाख्याप्यते युष्माभिः प्रागलब्ध आत्मा वा यदि लभ्यते प्रागगृहीतः सुसंवादो वा यदि गृह्यते तर्हि मन्ये यूयं सम्यक् सहिष्यध्वे।</para>
  <para style="p">
    <verse number="5" style="v"/>किन्तु मुख्येभ्यः प्रेरितेभ्योऽहं केनचित् प्रकारेण न्यूनो नास्मीति बुध्ये।</para>
  <para style="p">
    <verse number="6" style="v"/>मम वाक्पटुताया न्यूनत्वे सत्यपि ज्ञानस्य न्यूनत्वं नास्ति किन्तु सर्व्वविषये वयं युष्मद्गोचरे प्रकाशामहे।</para>
  <para style="p">
    <verse number="7" style="v"/>युष्माकम् उन्नत्यै मया नम्रतां स्वीकृत्येश्वरस्य सुसंवादो विना वेतनं युष्माकं मध्ये यद् अघोष्यत तेन मया किं पापम् अकारि?</para>
  <para style="p">
    <verse number="8" style="v"/>युष्माकं सेवनायाहम् अन्यसमितिभ्यो भृति गृह्लन् धनमपहृतवान्,</para>
  <para style="p">
    <verse number="9" style="v"/>यदा च युष्मन्मध्येऽवऽर्त्ते तदा ममार्थाभावे जाते युष्माकं कोऽपि मया न पीडितः; यतो मम सोऽर्थाभावो माकिदनियादेशाद् आगतै भ्रातृभि न्यवार्य्यत, इत्थमहं क्कापि विषये यथा युष्मासु भारो न भवामि तथा मयात्मरक्षा कृता कर्त्तव्या च।</para>
  <para style="p">
    <verse number="10" style="v"/>ख्रीष्टस्य सत्यता यदि मयि तिष्ठति तर्हि ममैषा श्लाघा निखिलाखायादेशे केनापि न रोत्स्यते।</para>
  <para style="p">
    <verse number="11" style="v"/>एतस्य कारणं किं? युष्मासु मम प्रेम नास्त्येतत् किं तत्कारणं? तद् ईश्वरो वेत्ति।</para>
  <para style="p">
    <verse number="12" style="v"/>ये छिद्रमन्विष्यन्ति ते यत् किमपि छिद्रं न लभन्ते तदर्थमेव तत् कर्म्म मया क्रियते कारिष्यते च तस्मात् ते येन श्लाघन्ते तेनास्माकं समाना भविष्यन्ति।</para>
  <para style="p">
    <verse number="13" style="v"/>तादृशा भाक्तप्रेरिताः प्रवञ्चकाः कारवो भूत्वा ख्रीष्टस्य प्रेरितानां वेशं धारयन्ति।</para>
  <para style="p">
    <verse number="14" style="v"/>तच्चाश्चर्य्यं नहि; यतः स्वयं शयतानपि तेजस्विदूतस्य वेशं धारयति,</para>
  <para style="p">
    <verse number="15" style="v"/>ततस्तस्य परिचारका अपि धर्म्मपरिचारकाणां वेशं धारयन्तीत्यद्भुतं नहि; किन्तु तेषां कर्म्माणि यादृशानि फलान्यपि तादृशानि भविष्यन्ति।</para>
  <para style="p">
    <verse number="16" style="v"/>अहं पुन र्वदामि कोऽपि मां निर्ब्बोधं न मन्यतां किञ्च यद्यपि निर्ब्बोधो भवेयं तथापि यूयं निर्ब्बोधमिव मामनुगृह्य क्षणैकं यावत् ममात्मश्लाघाम् अनुजानीत।</para>
  <para style="p">
    <verse number="17" style="v"/>एतस्याः श्लाघाया निमित्तं मया यत् कथितव्यं तत् प्रभुनादिष्टेनेव कथ्यते तन्नहि किन्तु निर्ब्बोधेनेव।</para>
  <para style="p">
    <verse number="18" style="v"/>अपरे बहवः शारीरिकश्लाघां कुर्व्वते तस्माद् अहमपि श्लाघिष्ये।</para>
  <para style="p">
    <verse number="19" style="v"/>बुद्धिमन्तो यूयं सुखेन निर्ब्बोधानाम् आचारं सहध्वे।</para>
  <para style="p">
    <verse number="20" style="v"/>कोऽपि यदि युष्मान् दासान् करोति यदि वा युष्माकं सर्व्वस्वं ग्रसति यदि वा युष्मान् हरति यदि वात्माभिमानी भवति यदि वा युष्माकं कपोलम् आहन्ति तर्हि तदपि यूयं सहध्वे।</para>
  <para style="p">
    <verse number="21" style="v"/>दौर्ब्बल्याद् युष्माभिरवमानिता इव वयं भाषामहे, किन्त्वपरस्य कस्यचिद् येन प्रगल्भता जायते तेन ममापि प्रगल्भता जायत इति निर्ब्बोधेनेव मया वक्तव्यं।</para>
  <para style="p">
    <verse number="22" style="v"/>ते किम् इब्रिलोकाः? अहमपीब्री। ते किम् इस्रायेलीयाः? अहमपीस्रायेलीयः। ते किम् इब्राहीमो वंशाः? अहमपीब्राहीमो वंशः।</para>
  <para style="p">
    <verse number="23" style="v"/>ते किं ख्रीष्टस्य परिचारकाः? अहं तेभ्योऽपि तस्य महापरिचारकः; किन्तु निर्ब्बोध इव भाषे, तेभ्योऽप्यहं बहुपरिश्रमे बहुप्रहारे बहुवारं कारायां बहुवारं प्राणनाशसंशये च पतितवान्।</para>
  <para style="p">
    <verse number="24" style="v"/>यिहूदीयैरहं पञ्चकृत्व ऊनचत्वारिंशत्प्रहारैराहतस्त्रिर्वेत्राघातम् एककृत्वः प्रस्तराघातञ्च प्रप्तवान्।</para>
  <para style="p">
    <verse number="25" style="v"/>वारत्रयं पोतभञ्जनेन क्लिष्टोऽहम् अगाधसलिले दिनमेकं रात्रिमेकाञ्च यापितवान्।</para>
  <para style="p">
    <verse number="26" style="v"/>बहुवारं यात्राभि र्नदीनां सङ्कटै र्दस्यूनां सङ्कटैः स्वजातीयानां सङ्कटै र्भिन्नजातीयानां सङ्कटै र्नगरस्य सङ्कटै र्मरुभूमेः सङ्कटै सागरस्य सङ्कटै र्भाक्तभ्रातृणां सङ्कटैश्च</para>
  <para style="p">
    <verse number="27" style="v"/>परिश्रमक्लेशाभ्यां वारं वारं जागरणेन क्षुधातृष्णाभ्यां बहुवारं निराहारेण शीतनग्नताभ्याञ्चाहं कालं यापितवान्।</para>
  <para style="p">
    <verse number="28" style="v"/>तादृशं नैमित्तिकं दुःखं विनाहं प्रतिदिनम् आकुलो भवामि सर्व्वासां समितीनां चिन्ता च मयि वर्त्तते।</para>
  <para style="p">
    <verse number="29" style="v"/>येनाहं न दुर्ब्बलीभवामि तादृशं दौर्ब्बल्यं कः पाप्नोति?</para>
  <para style="p">
    <verse number="30" style="v"/>यदि मया श्लाघितव्यं तर्हि स्वदुर्ब्बलतामधि श्लाघिष्ये।</para>
  <para style="p">
    <verse number="31" style="v"/>मया मृषावाक्यं न कथ्यत इति नित्यं प्रशंसनीयोऽस्माकं प्रभो र्यीशुख्रीष्टस्य तात ईश्वरो जानाति।</para>
  <para style="p">
    <verse number="32" style="v"/>दम्मेषकनगरेऽरिताराजस्य कार्य्याध्यक्षो मां धर्त्तुम् इच्छन् यदा सैन्यैस्तद् दम्मेषकनगरम् अरक्षयत्</para>
  <para style="p">
    <verse number="33" style="v"/>तदाहं लोकैः पिटकमध्ये प्राचीरगवाक्षेणावरोहितस्तस्य करात् त्राणं प्रापं।</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>आत्मश्लाघा ममानुपयुक्ता किन्त्वहं प्रभो र्दर्शनादेशानाम् आख्यानं कथयितुं प्रवर्त्ते।</para>
  <para style="p">
    <verse number="2" style="v"/>इतश्चतुर्दशवत्सरेभ्यः पूर्व्वं मया परिचित एको जनस्तृतीयं स्वर्गमनीयत, स सशरीरेण निःशरीरेण वा तत् स्थानमनीयत तदहं न जानामि किन्त्वीश्वरो जानाति।</para>
  <para style="p">
    <verse number="3" style="v"/>स मानवः स्वर्गं नीतः सन् अकथ्यानि मर्त्त्यवागतीतानि च वाक्यानि श्रुतवान्।</para>
  <para style="p">
    <verse number="4" style="v"/>किन्तु तदानीं स सशरीरो निःशरीरो वासीत् तन्मया न ज्ञायते तद् ईश्वरेणैव ज्ञायते।</para>
  <para style="p">
    <verse number="5" style="v"/>तमध्यहं श्लाघिष्ये मामधि नान्येन केनचिद् विषयेण श्लाघिष्ये केवलं स्वदौर्ब्बल्येन श्लाघिष्ये।</para>
  <para style="p">
    <verse number="6" style="v"/>यद्यहम् आत्मश्लाघां कर्त्तुम् इच्छेयं तथापि निर्ब्बोध इव न भविष्यामि यतः सत्यमेव कथयिष्यामि, किन्तु लोका मां यादृशं पश्यन्ति मम वाक्यं श्रुत्वा वा यादृशं मां मन्यते तस्मात् श्रेष्ठं मां यन्न गणयन्ति तदर्थमहं ततो विरंस्यामि।</para>
  <para style="p">
    <verse number="7" style="v"/>अपरम् उत्कृष्टदर्शनप्राप्तितो यदहम् आत्माभिमानी न भवामि तदर्थं शरीरवेधकम् एकं शूलं मह्यम् अदायि तत् मदीयात्माभिमाननिवारणार्थं मम ताडयिता शयतानो दूतः।</para>
  <para style="p">
    <verse number="8" style="v"/>मत्तस्तस्य प्रस्थानं याचितुमहं त्रिस्तमधि प्रभुमुद्दिश्य प्रार्थनां कृतवान्।</para>
  <para style="p">
    <verse number="9" style="v"/>ततः स मामुक्तवान् ममानुग्रहस्तव सर्व्वसाधकः, यतो दौर्ब्बल्यात् मम शक्तिः पूर्णतां गच्छतीति। अतः ख्रीष्टस्य शक्ति र्यन्माम् आश्रयति तदर्थं स्वदौर्ब्बल्येन मम श्लाघनं सुखदं।</para>
  <para style="p">
    <verse number="10" style="v"/>तस्मात् ख्रीष्टहेतो र्दौर्ब्बल्यनिन्दादरिद्रताविपक्षताकष्टादिषु सन्तुष्याम्यहं। यदाहं दुर्ब्बलोऽस्मि तदैव सबलो भवामि।</para>
  <para style="p">
    <verse number="11" style="v"/>एतेनात्मश्लाघनेनाहं निर्ब्बोध इवाभवं किन्तु यूयं तस्य कारणं यतो मम प्रशंसा युष्माभिरेव कर्त्तव्यासीत्। यद्यप्यम् अगण्यो भवेयं तथापि मुख्यतमेभ्यः प्रेरितेभ्यः केनापि प्रकारेण नाहं न्यूनोऽस्मि।</para>
  <para style="p">
    <verse number="12" style="v"/>सर्व्वथाद्भुतक्रियाशक्तिलक्षणैः प्रेरितस्य चिह्नानि युष्माकं मध्ये सधैर्य्यं मया प्रकाशितानि।</para>
  <para style="p">
    <verse number="13" style="v"/>मम पालनार्थं यूयं मया भाराक्रान्ता नाभवतैतद् एकं न्यूनत्वं विनापराभ्यः समितिभ्यो युष्माकं किं न्यूनत्वं जातं? अनेन मम दोषं क्षमध्वं।</para>
  <para style="p">
    <verse number="14" style="v"/>पश्यत तृतीयवारं युुष्मत्समीपं गन्तुमुद्यतोऽस्मि तत्राप्यहं युष्मान् भाराक्रान्तान् न करिष्यामि। युष्माकं सम्पत्तिमहं न मृगये किन्तु युष्मानेव, यतः पित्रोः कृते सन्तानानां धनसञ्चयोऽनुपयुक्तः किन्तु सन्तानानां कृते पित्रो र्धनसञ्चय उपयुक्तः।</para>
  <para style="p">
    <verse number="15" style="v"/>अपरञ्च युष्मासु बहु प्रीयमाणोऽप्यहं यदि युष्मत्तोऽल्पं प्रम लभे तथापि युष्माकं प्राणरक्षार्थं सानन्दं बहु व्ययं सर्व्वव्ययञ्च करिष्यामि।</para>
  <para style="p">
    <verse number="16" style="v"/>यूयं मया किञ्चिदपि न भाराक्रान्ता इति सत्यं, किन्त्वहं धूर्त्तः सन् छलेन युष्मान् वञ्चितवान् एतत् किं केनचिद् वक्तव्यं?</para>
  <para style="p">
    <verse number="17" style="v"/>युष्मत्समीपं मया ये लोकाः प्रहितास्तेषामेकेन किं मम कोऽप्यर्थलाभो जातः?</para>
  <para style="p">
    <verse number="18" style="v"/>अहं तीतं विनीय तेन सार्द्धं भ्रातरमेकं प्रेषितवान् युष्मत्तस्तीतेन किम् अर्थो लब्धः? एकस्मिन् भाव एकस्य पदचिह्नेषु चावां किं न चरितवन्तौ?</para>
  <para style="p">
    <verse number="19" style="v"/>युष्माकं समीपे वयं पुन र्दोषक्षालनकथां कथयाम इति किं बुध्यध्वे? हे प्रियतमाः, युष्माकं निष्ठार्थं वयमीश्वरस्य समक्षं ख्रीष्टेन सर्व्वाण्येतानि कथयामः।</para>
  <para style="p">
    <verse number="20" style="v"/>अहं यदागमिष्यामि, तदा युष्मान् यादृशान् द्रष्टुं नेच्छामि तादृशान् द्रक्ष्यामि, यूयमपि मां यादृशं द्रष्टुं नेच्छथ तादृशं द्रक्ष्यथ, युष्मन्मध्ये विवाद ईर्ष्या क्रोधो विपक्षता परापवादः कर्णेजपनं दर्पः कलहश्चैते भविष्यन्ति;</para>
  <para style="p">
    <verse number="21" style="v"/>तेनाहं युष्मत्समीपं पुनरागत्य मदीयेश्वरेण नमयिष्ये, पूर्व्वं कृतपापान् लोकान् स्वीयाशुचितावेश्यागमनलम्पटताचरणाद् अनुतापम् अकृतवन्तो दृष्ट्वा च तानधि मम शोको जनिष्यत इति बिभेमि।</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>एतत्तृतीयवारम् अहं युष्मत्समीपं गच्छामि तेन सर्व्वा कथा द्वयोस्त्रयाणां वा साक्षिणां मुखेन निश्चेष्यते।</para>
  <para style="p">
    <verse number="2" style="v"/>पूर्व्वं ये कृतपापास्तेभ्योऽन्येभ्यश्च सर्व्वेभ्यो मया पूर्व्वं कथितं, पुनरपि विद्यमानेनेवेदानीम् अविद्यमानेन मया कथ्यते, यदा पुनरागमिष्यामि तदाहं न क्षमिष्ये।</para>
  <para style="p">
    <verse number="3" style="v"/>ख्रीष्टो मया कथां कथयत्येतस्य प्रमाणं यूयं मृगयध्वे, स तु युष्मान् प्रति दुर्ब्बलो नहि किन्तु सबल एव।</para>
  <para style="p">
    <verse number="4" style="v"/>यद्यपि स दुर्ब्बलतया क्रुश आरोप्यत तथापीश्वरीयशक्तया जीवति; वयमपि तस्मिन् दुर्ब्बला भवामः, तथापि युष्मान् प्रति प्रकाशितयेश्वरीयशक्त्या तेन सह जीविष्यामः।</para>
  <para style="p">
    <verse number="5" style="v"/>अतो यूयं विश्वासयुक्ता आध्वे न वेति ज्ञातुमात्मपरीक्षां कुरुध्वं स्वानेवानुसन्धत्त। यीशुः ख्रीष्टो युष्मन्मध्ये विद्यते स्वानधि तत् किं न प्रतिजानीथ? तस्मिन् अविद्यमाने यूयं निष्प्रमाणा भवथ।</para>
  <para style="p">
    <verse number="6" style="v"/>किन्तु वयं निष्प्रमाणा न भवाम इति युष्माभि र्भोत्स्यते तत्र मम प्रत्याशा जायते।</para>
  <para style="p">
    <verse number="7" style="v"/>यूयं किमपि कुत्सितं कर्म्म यन्न कुरुथ तदहम् ईश्वरमुद्दिश्य प्रार्थये। वयं यत् प्रामाणिका इव प्रकाशामहे तदर्थं तत् प्रार्थयामह इति नहि, किन्तु यूयं यत् सदाचारं कुरुथ वयञ्च निष्प्रमाणा इव भवामस्तदर्थं।</para>
  <para style="p">
    <verse number="8" style="v"/>यतः सत्यताया विपक्षतां कर्त्तुं वयं न समर्थाः किन्तु सत्यतायाः साहाय्यं कर्त्तुमेव।</para>
  <para style="p">
    <verse number="9" style="v"/>वयं यदा दुर्ब्बला भवामस्तदा युष्मान् सबलान् दृष्ट्वानन्दामो युष्माकं सिद्धत्वं प्रार्थयामहे च।</para>
  <para style="p">
    <verse number="10" style="v"/>अतो हेतोः प्रभु र्युष्माकं विनाशाय नहि किन्तु निष्ठायै यत् सामर्थ्यम् अस्मभ्यं दत्तवान् तेन यद् उपस्थितिकाले काठिन्यं मयाचरितव्यं न भवेत् तदर्थम् अनुपस्थितेन मया सर्व्वाण्येतानि लिख्यन्ते।</para>
  <para style="p">
    <verse number="11" style="v"/>हे भ्रातरः, शेषे वदामि यूयम् आनन्दत सिद्धा भवत परस्परं प्रबोधयत, एकमनसो भवत प्रणयभावम् आचरत। प्रेमशान्त्योराकर ईश्वरो युष्माकं सहायो भूयात्।</para>
  <para style="p">
    <verse number="12" style="v"/>यूयं पवित्रचुम्बनेन परस्परं नमस्कुरुध्वं।</para>
  <para style="p">
    <verse number="13" style="v"/>पवित्रलोकाः सर्व्वे युष्मान् नमन्ति।</para>
  <para style="p">
    <verse number="14" style="v"/>प्रभो र्यीशुख्रीष्टस्यानुग्रह ईश्वरस्य प्रेम पवित्रस्यात्मनो भागित्वञ्च सर्व्वान् युष्मान् प्रति भूयात्। तथास्तु।</para>
</usx>
