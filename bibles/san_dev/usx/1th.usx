<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1TH" style="id">Sanskrit Bible (NT) in Devanagari Script (सत्यवेदः।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 Thessalonians</para>
  <para style="toc1">१ थिषलनीकिनः पत्रं</para>
  <para style="toc2">१ थिषलनीकिनः</para>
  <para style="toc3">१ थिषलनीकिनः</para>
  <para style="mt1">१ थिषलनीकिनः पत्रं</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>पौलः सिल्वानस्तीमथियश्च पितुरीश्वरस्य प्रभो र्यीशुख्रीष्टस्य चाश्रयं प्राप्ता थिषलनीकीयसमितिं प्रति पत्रं लिखन्ति। अस्माकं तात ईश्वरः प्रभु र्यीशुख्रीष्टश्च युष्मान् प्रत्यनुग्रहं शान्तिञ्च क्रियास्तां।</para>
  <para style="p">
    <verse number="2" style="v"/>वयं सर्व्वेषां युष्माकं कृते ईश्वरं धन्यं वदामः प्रार्थनासमये युष्माकं नामोच्चारयामः,</para>
  <para style="p">
    <verse number="3" style="v"/>अस्माकं तातस्येश्वरस्य साक्षात् प्रभौ यीशुख्रीष्टे युष्माकं विश्वासेन यत् कार्य्यं प्रेम्ना यः परिश्रमः प्रत्याशया च या तितिक्षा जायते</para>
  <para style="p">
    <verse number="4" style="v"/>तत् सर्व्वं निरन्तरं स्मरामश्च। हे पियभ्रातरः, यूयम् ईश्वरेणाभिरुचिता लोका इति वयं जानीमः।</para>
  <para style="p">
    <verse number="5" style="v"/>यतोऽस्माकं सुसंवादः केवलशब्देन युष्मान् न प्रविश्य शक्त्या पवित्रेणात्मना महोत्साहेन च युष्मान् प्राविशत्। वयन्तु युष्माकं कृते युष्मन्मध्ये कीदृशा अभवाम तद् युष्माभि र्ज्ञायते।</para>
  <para style="p">
    <verse number="6" style="v"/>यूयमपि बहुक्लेशभोगेन पवित्रेणात्मना दत्तेनानन्देन च वाक्यं गृहीत्वास्माकं प्रभोश्चानुगामिनोऽभवत।</para>
  <para style="p">
    <verse number="7" style="v"/>तेन माकिदनियाखायादेशयो र्यावन्तो विश्वासिनो लोकाः सन्ति यूयं तेषां सर्व्वेषां निदर्शनस्वरूपा जाताः।</para>
  <para style="p">
    <verse number="8" style="v"/>यतो युष्मत्तः प्रतिनादितया प्रभो र्वाण्या माकिदनियाखायादेशौ व्याप्तौ केवलमेतन्नहि किन्त्वीश्वरे युष्माकं यो विश्वासस्तस्य वार्त्ता सर्व्वत्राश्रावि, तस्मात् तत्र वाक्यकथनम् अस्माकं निष्प्रयोजनं।</para>
  <para style="p">
    <verse number="9" style="v"/>यतो युष्मन्मध्ये वयं कीदृशं प्रवेशं प्राप्ता यूयञ्च कथं प्रतिमा विहायेश्वरं प्रत्यावर्त्तध्वम् अमरं सत्यमीश्वरं सेवितुं</para>
  <para style="p">
    <verse number="10" style="v"/>मृतगणमध्याच्च तेनोत्थापितस्य पुत्रस्यार्थत आगामिक्रोधाद् अस्माकं निस्तारयितु र्यीशोः स्वर्गाद् आगमनं प्रतीक्षितुम् आरभध्वम् एतत् सर्व्वं ते लोकाः स्वयम् अस्मान् ज्ञापयन्ति।</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>हे भ्रातरः, युष्मन्मध्ये ऽस्माकं प्रवेशो निष्फलो न जात इति यूयं स्वयं जानीथ।</para>
  <para style="p">
    <verse number="2" style="v"/>अपरं युष्माभि र्यथाश्रावि तथा पूर्व्वं फिलिपीनगरे क्लिष्टा निन्दिताश्च सन्तोऽपि वयम् ईश्वराद् उत्साहं लब्ध्वा बहुयत्नेन युष्मान् ईश्वरस्य सुसंवादम् अबोधयाम।</para>
  <para style="p">
    <verse number="3" style="v"/>यतोऽस्माकम् आदेशो भ्रान्तेरशुचिभावाद् वोत्पन्नः प्रवञ्चनायुक्तो वा न भवति।</para>
  <para style="p">
    <verse number="4" style="v"/>किन्त्वीश्वरेणास्मान् परीक्ष्य विश्वसनीयान् मत्त्वा च यद्वत् सुसंवादोऽस्मासु समार्प्यत तद्वद् वयं मानवेभ्यो न रुरोचिषमाणाः किन्त्वस्मदन्तःकरणानां परीक्षकायेश्वराय रुरोचिषमाणा भाषामहे।</para>
  <para style="p">
    <verse number="5" style="v"/>वयं कदापि स्तुतिवादिनो नाभवामेति यूयं जानीथ कदापि छलवस्त्रेण लोभं नाच्छादयामेत्यस्मिन् ईश्वरः साक्षी विद्यते।</para>
  <para style="p">
    <verse number="6" style="v"/>वयं ख्रीष्टस्य प्रेरिता इव गौरवान्विता भवितुम् अशक्ष्याम किन्तु युष्मत्तः परस्माद् वा कस्मादपि मानवाद् गौरवं न लिप्समाना युष्मन्मध्ये मृदुभावा भूत्वावर्त्तामहि।</para>
  <para style="p">
    <verse number="7" style="v"/>यथा काचिन्माता स्वकीयशिशून् पालयति तथा वयमपि युष्मान् काङ्क्षमाणा</para>
  <para style="p">
    <verse number="8" style="v"/>युष्मभ्यं केवलम् ईश्वरस्य सुसंवादं तन्नहि किन्तु स्वकीयप्राणान् अपि दातुं मनोभिरभ्यलषाम, यतो यूयम् अस्माकं स्नेहपात्राण्यभवत।</para>
  <para style="p">
    <verse number="9" style="v"/>हे भ्रातरः, अस्माकं श्रमः क्लेेशश्च युष्माभिः स्मर्य्यते युष्माकं कोऽपि यद् भारग्रस्तो न भवेत् तदर्थं वयं दिवानिशं परिश्राम्यन्तो युष्मन्मध्य ईश्वरस्य सुसंवादमघोषयाम।</para>
  <para style="p">
    <verse number="10" style="v"/>अपरञ्च विश्वासिनो युष्मान् प्रति वयं कीदृक् पवित्रत्वयथार्थत्वनिर्दोषत्वाचारिणोऽभवामेत्यस्मिन् ईश्वरो यूयञ्च साक्षिण आध्वे।</para>
  <para style="p">
    <verse number="11" style="v"/>अपरञ्च यद्वत् पिता स्वबालकान् तद्वद् वयं युष्माकम् एकैकं जनम् उपदिष्टवन्तः सान्त्वितवन्तश्च,</para>
  <para style="p">
    <verse number="12" style="v"/>य ईश्वरः स्वीयराज्याय विभवाय च युष्मान् आहूतवान् तदुपयुक्ताचरणाय युष्मान् प्रवर्त्तितवन्तश्चेति यूयं जानीथ।</para>
  <para style="p">
    <verse number="13" style="v"/>यस्मिन् समये यूयम् अस्माकं मुखाद् ईश्वरेण प्रतिश्रुतं वाक्यम् अलभध्वं तस्मिन् समये तत् मानुषाणां वाक्यं न मत्त्वेश्वरस्य वाक्यं मत्त्वा गृहीतवन्त इति कारणाद् वयं निरन्तरम् ईश्वरं धन्यं वदामः, यतस्तद् ईश्वरस्य वाक्यम् इति सत्यं विश्वासिनां युष्माकं मध्ये तस्य गुणः प्रकाशते च।</para>
  <para style="p">
    <verse number="14" style="v"/>हे भ्रातरः, ख्रीष्टाश्रितवत्य ईश्वरस्य याः समित्यो यिहूदादेशे सन्ति यूयं तासाम् अनुकारिणोऽभवत, तद्भुक्ता लोकाश्च यद्वद् यिहूदिलोकेभ्यस्तद्वद् यूयमपि स्वजातीयलोकेभ्यो दुःखम् अलभध्वं।</para>
  <para style="p">
    <verse number="15" style="v"/>ते यिहूदीयाः प्रभुं यीशुं भविष्यद्वादिनश्च हतवन्तो ऽस्मान् दूरीकृतवन्तश्च, त ईश्वराय न रोचन्ते सर्व्वेषां मानवानां विपक्षा भवन्ति च;</para>
  <para style="p">
    <verse number="16" style="v"/>अपरं भिन्नजातीयलोकानां परित्राणार्थं तेषां मध्ये सुसंवादघोषणाद् अस्मान् प्रतिषेधन्ति चेत्थं स्वीयपापानां परिमाणम् उत्तरोत्तरं पूरयन्ति, किन्तु तेषाम् अन्तकारी क्रोधस्तान् उपक्रमते।</para>
  <para style="p">
    <verse number="17" style="v"/>हे भ्रातरः मनसा नहि किन्तु वदनेन कियत्कालं युष्मत्तो ऽस्माकं विच्छेदे जाते वयं युष्माकं मुखानि द्रष्टुम् अत्याकाङ्क्षया बहु यतितवन्तः।</para>
  <para style="p">
    <verse number="18" style="v"/>द्विरेककृत्वो वा युष्मत्समीपगमनायास्माकं विशेषतः पौलस्य ममाभिलाषोऽभवत् किन्तु शयतानो ऽस्मान् निवारितवान्।</para>
  <para style="p">
    <verse number="19" style="v"/>यतोऽस्माकं का प्रत्याशा को वानन्दः किं वा श्लाघ्यकिरीटं? अस्माकं प्रभो र्यीशुख्रीष्टस्यागमनकाले तत्सम्मुखस्था यूयं किं तन्न भविष्यथ?</para>
  <para style="p">
    <verse number="20" style="v"/>यूयम् एवास्माकं गौरवानन्दस्वरूपा भवथ।</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अतोऽहं यदा सन्देहं पुनः सोढुं नाशक्नुवं तदानीम् आथीनीनगर एकाकी स्थातुं निश्चित्य</para>
  <para style="p">
    <verse number="2" style="v"/>स्वभ्रातरं ख्रीष्टस्य सुसंवादे सहकारिणञ्चेश्वरस्य परिचारकं तीमथियं युष्मत्समीपम् अप्रेषयं।</para>
  <para style="p">
    <verse number="3" style="v"/>वर्त्तमानैः क्लेशैः कस्यापि चाञ्चल्यं यथा न जायते तथा ते त्वया स्थिरीक्रियन्तां स्वकीयधर्म्ममधि समाश्वास्यन्ताञ्चेति तम् आदिशं।</para>
  <para style="p">
    <verse number="4" style="v"/>वयमेतादृशे क्लेेशे नियुक्ता आस्मह इति यूयं स्वयं जानीथ, यतोऽस्माकं दुर्गति र्भविष्यतीति वयं युष्माकं समीपे स्थितिकालेऽपि युष्मान् अबोधयाम, तादृशमेव चाभवत् तदपि जानीथ।</para>
  <para style="p">
    <verse number="5" style="v"/>तस्मात् परीक्षकेण युष्मासु परीक्षितेष्वस्माकं परिश्रमो विफलो भविष्यतीति भयं सोढुं यदाहं नाशक्नुवं तदा युष्माकं विश्वासस्य तत्त्वावधारणाय तम् अप्रेषयं।</para>
  <para style="p">
    <verse number="6" style="v"/>किन्त्वधुना तीमथियो युष्मत्समीपाद् अस्मत्सन्निधिम् आगत्य युष्माकं विश्वासप्रेमणी अध्यस्मान् सुवार्त्तां ज्ञापितवान् वयञ्च यथा युष्मान् स्मरामस्तथा यूयमप्यस्मान् सर्व्वदा प्रणयेन स्मरथ द्रष्टुम् आकाङ्क्षध्वे चेति कथितवान्।</para>
  <para style="p">
    <verse number="7" style="v"/>हे भ्रातरः, वार्त्तामिमां प्राप्य युष्मानधि विशेषतो युष्माकं क्लेशदुःखान्यधि युष्माकं विश्वासाद् अस्माकं सान्त्वनाजायत;</para>
  <para style="p">
    <verse number="8" style="v"/>यतो यूयं यदि प्रभाववतिष्ठथ तर्ह्यनेन वयम् अधुना जीवामः।</para>
  <para style="p">
    <verse number="9" style="v"/>वयञ्चास्मदीयेश्वरस्य साक्षाद् युष्मत्तो जातेन येनानन्देन प्रफुल्ला भवामस्तस्य कृत्स्नस्यानन्दस्य योग्यरूपेणेश्वरं धन्यं वदितुं कथं शक्ष्यामः?</para>
  <para style="p">
    <verse number="10" style="v"/>वयं येन युष्माकं वदनानि द्रष्टुं युष्माकं विश्वासे यद् असिद्धं विद्यते तत् सिद्धीकर्त्तुञ्च शक्ष्यामस्तादृशं वरं दिवानिशं प्रार्थयामहे।</para>
  <para style="p">
    <verse number="11" style="v"/>अस्माकं तातेनेश्वरेण प्रभुना यीशुख्रीष्टेन च युष्मत्समीपगमनायास्माकं पन्था सुगमः क्रियतां।</para>
  <para style="p">
    <verse number="12" style="v"/>परस्परं सर्व्वांश्च प्रति युष्माकं प्रेम युष्मान् प्रति चास्माकं प्रेम प्रभुना वर्द्ध्यतां बहुफलं क्रियताञ्च।</para>
  <para style="p">
    <verse number="13" style="v"/>अपरमस्माकं प्रभु र्यीशुख्रीष्टः स्वकीयैः सर्व्वैः पवित्रलोकैः सार्द्धं यदागमिष्यति तदा यूयं यथास्माकं तातस्येश्वरस्य सम्मुखे पवित्रतया निर्दोषा भविष्यथ तथा युष्माकं मनांसि स्थिरीक्रियन्तां।</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>हे भ्रातरः, युष्माभिः कीदृग् आचरितव्यं ईश्वराय रोचितव्यञ्च तदध्यस्मत्तो या शिक्षा लब्धा तदनुसारात् पुनरतिशयं यत्नः क्रियतामिति वयं प्रभुयीशुना युष्मान् विनीयादिशामः।</para>
  <para style="p">
    <verse number="2" style="v"/>यतो वयं प्रभुयीशुना कीदृशीराज्ञा युष्मासु समर्पितवन्तस्तद् यूयं जानीथ।</para>
  <para style="p">
    <verse number="3" style="v"/>ईश्वरस्यायम् अभिलाषो यद् युष्माकं पवित्रता भवेत्, यूयं व्यभिचाराद् दूरे तिष्ठत।</para>
  <para style="p">
    <verse number="4" style="v"/>युष्माकम् एकैको जनः स्वकीयं प्राणाधारं पवित्रं मान्यञ्च रक्षतु,</para>
  <para style="p">
    <verse number="5" style="v"/>ये च भिन्नजातीया लोका ईश्वरं न जानन्ति त इव तत् कामाभिलाषस्याधीनं न करोतु।</para>
  <para style="p">
    <verse number="6" style="v"/>एतस्मिन् विषये कोऽप्यत्याचारी भूत्वा स्वभ्रातरं न वञ्चयतु यतोऽस्माभिः पूर्व्वं यथोक्तं प्रमाणीकृतञ्च तथैव प्रभुरेतादृशानां कर्म्मणां समुचितं फलं दास्यति।</para>
  <para style="p">
    <verse number="7" style="v"/>यस्माद् ईश्वरोऽस्मान् अशुचितायै नाहूतवान् किन्तु पवित्रत्वायैवाहूतवान्।</para>
  <para style="p">
    <verse number="8" style="v"/>अतो हेतो र्यः कश्चिद् वाक्यमेतन्न गृह्लाति स मनुष्यम् अवजानातीति नहि येन स्वकीयात्मा युष्मदन्तरे समर्पितस्तम् ईश्वरम् एवावजानाति।</para>
  <para style="p">
    <verse number="9" style="v"/>भ्रातृषु प्रेमकरणमधि युष्मान् प्रति मम लिखनं निष्प्रयोजनं यतो यूयं परस्परं प्रेमकरणायेश्वरशिक्षिता लोका आध्वे।</para>
  <para style="p">
    <verse number="10" style="v"/>कृत्स्ने माकिदनियादेशे च यावन्तो भ्रातरः सन्ति तान् सर्व्वान् प्रति युष्माभिस्तत् प्रेम प्रकाश्यते तथापि हे भ्रातरः, वयं युष्मान् विनयामहे यूयं पुन र्बहुतरं प्रेम प्रकाशयत।</para>
  <para style="p">
    <verse number="11" style="v"/>अपरं ये बहिःस्थितास्तेषां दृष्टिगोचरे युष्माकम् आचरणं यत् मनोरम्यं भवेत् कस्यापि वस्तुनश्चाभावो युष्माकं यन्न भवेत्,</para>
  <para style="p">
    <verse number="12" style="v"/>एतदर्थं यूयम् अस्मत्तो यादृशम् आदेशं प्राप्तवन्तस्तादृशं निर्विरोधाचारं कर्त्तुं स्वस्वकर्म्मणि मनांमि निधातुं निजकरैश्च कार्य्यं साधयितुं यतध्वं।</para>
  <para style="p">
    <verse number="13" style="v"/>हे भ्रातरः निराशा अन्ये लोका इव यूयं यन्न शोचेध्वं तदर्थं महानिद्रागतान् लोकानधि युष्माकम् अज्ञानता मया नाभिलष्यते।</para>
  <para style="p">
    <verse number="14" style="v"/>यीशु र्मृतवान् पुनरुथितवांश्चेति यदि वयं विश्वासमस्तर्हि यीशुम् आश्रितान् महानिद्राप्राप्तान् लोकानपीश्वरोऽवश्यं तेन सार्द्धम् आनेष्यति।</para>
  <para style="p">
    <verse number="15" style="v"/>यतोऽहं प्रभो र्वाक्येन युष्मान् इदं ज्ञापयामि; अस्माकं मध्ये ये जनाः प्रभोरागमनं यावत् जीवन्तोऽवशेक्ष्यन्ते ते महानिद्रितानाम् अग्रगामिनोन न भविष्यन्ति;</para>
  <para style="p">
    <verse number="16" style="v"/>यतः प्रभुः सिंहनादेन प्रधानस्वर्गदूतस्योच्चैः शब्देनेश्वरीयतूरीवाद्येन च स्वयं स्वर्गाद् अवरोक्ष्यति तेन ख्रीष्टाश्रिता मृतलोकाः प्रथमम् उत्थास्यान्ति।</para>
  <para style="p">
    <verse number="17" style="v"/>अपरम् अस्माकं मध्ये ये जीवन्तोऽवशेक्ष्यन्ते त आकाशे प्रभोः साक्षात्करणार्थं तैः सार्द्धं मेघवाहनेन हरिष्यन्ते; इत्थञ्च वयं सर्व्वदा प्रभुना सार्द्धं स्थास्यामः।</para>
  <para style="p">
    <verse number="18" style="v"/>अतो यूयम् एताभिः कथाभिः परस्परं सान्त्वयत।</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>हे भ्रातरः, कालान् समयांश्चाधि युष्मान् प्रति मम लिखनं निष्प्रयोजनं,</para>
  <para style="p">
    <verse number="2" style="v"/>यतो रात्रौ यादृक् तस्करस्तादृक् प्रभो र्दिनम् उपस्थास्यतीति यूयं स्वयमेव सम्यग् जानीथ।</para>
  <para style="p">
    <verse number="3" style="v"/>शान्ति र्निर्व्विन्घत्वञ्च विद्यत इति यदा मानवा वदिष्यन्ति तदा प्रसववेदना यद्वद् गर्ब्भिनीम् उपतिष्ठति तद्वद् अकस्माद् विनाशस्तान् उपस्थास्यति तैरुद्धारो न लप्स्यते।</para>
  <para style="p">
    <verse number="4" style="v"/>किन्तु हे भ्रातरः, यूयम् अन्धकारेणावृता न भवथ तस्मात् तद्दिनं तस्कर इव युष्मान् न प्राप्स्यति।</para>
  <para style="p">
    <verse number="5" style="v"/>सर्व्वे यूयं दीप्तेः सन्ताना दिवायाश्च सन्ताना भवथ वयं निशावंशास्तिमिरवंशा वा न भवामः।</para>
  <para style="p">
    <verse number="6" style="v"/>अतो ऽपरे यथा निद्रागताः सन्ति तद्वद् अस्माभि र्न भवितव्यं किन्तु जागरितव्यं सचेतनैश्च भवितव्यं।</para>
  <para style="p">
    <verse number="7" style="v"/>ये निद्रान्ति ते निशायामेव निद्रान्ति ते च मत्ता भवन्ति ते रजन्यामेव मत्ता भवन्ति।</para>
  <para style="p">
    <verse number="8" style="v"/>किन्तु वयं दिवसस्य वंशा भवामः; अतो ऽस्माभि र्वक्षसि प्रत्ययप्रेमरूपं कवचं शिरसि च परित्राणाशारूपं शिरस्त्रं परिधाय सचेतनै र्भवितव्यं।</para>
  <para style="p">
    <verse number="9" style="v"/>यत ईश्वरोऽस्मान् क्रोधे न नियुज्यास्माकं प्रभुना यीशुख्रीष्टेन परित्राणस्याधिकारे नियुुक्तवान्,</para>
  <para style="p">
    <verse number="10" style="v"/>जाग्रतो निद्रागता वा वयं यत् तेन प्रभुना सह जीवामस्तदर्थं सोऽस्माकं कृते प्राणान् त्यक्तवान्।</para>
  <para style="p">
    <verse number="11" style="v"/>अतएव यूयं यद्वत् कुरुथ तद्वत् परस्परं सान्त्वयत सुस्थिरीकुरुध्वञ्च।</para>
  <para style="p">
    <verse number="12" style="v"/>हे भ्रातरः, युष्माकं मध्ये ये जनाः परिश्रमं कुर्व्वन्ति प्रभो र्नाम्ना युष्मान् अधितिष्ठन्त्युपदिशन्ति च तान् यूयं सम्मन्यध्वं।</para>
  <para style="p">
    <verse number="13" style="v"/>स्वकर्म्महेतुना च प्रेम्ना तान् अतीवादृयध्वमिति मम प्रार्थना, यूयं परस्परं निर्व्विरोधा भवत।</para>
  <para style="p">
    <verse number="14" style="v"/>हे भ्रातरः, युष्मान् विनयामहे यूयम् अविहिताचारिणो लोकान् भर्त्सयध्वं, क्षुद्रमनसः सान्त्वयत, दुर्ब्बलान् उपकुरुत, सर्व्वान् प्रति सहिष्णवो भवत च।</para>
  <para style="p">
    <verse number="15" style="v"/>अपरं कमपि प्रत्यनिष्टस्य फलम् अनिष्टं केनापि यन्न क्रियेत तदर्थं सावधाना भवत, किन्तु परस्परं सर्व्वान् मानवांश्च प्रति नित्यं हिताचारिणो भवत।</para>
  <para style="p">
    <verse number="16" style="v"/>सर्व्वदानन्दत।</para>
  <para style="p">
    <verse number="17" style="v"/>निरन्तरं प्रार्थनां कुरुध्वं।</para>
  <para style="p">
    <verse number="18" style="v"/>सर्व्वविषये कृतज्ञतां स्वीकुरुध्वं यत एतदेव ख्रीष्टयीशुना युष्मान् प्रति प्रकाशितम् ईश्वराभिमतं।</para>
  <para style="p">
    <verse number="19" style="v"/>पवित्रम् आत्मानं न निर्व्वापयत।</para>
  <para style="p">
    <verse number="20" style="v"/>ईश्वरीयादेशं नावजानीत।</para>
  <para style="p">
    <verse number="21" style="v"/>सर्व्वाणि परीक्ष्य यद् भद्रं तदेव धारयत।</para>
  <para style="p">
    <verse number="22" style="v"/>यत् किमपि पापरूपं भवति तस्माद् दूरं तिष्ठत।</para>
  <para style="p">
    <verse number="23" style="v"/>शान्तिदायक ईश्वरः स्वयं युष्मान् सम्पूर्णत्वेन पवित्रान् करोतु, अपरम् अस्मत्प्रभो र्यीशुख्रीष्टस्यागमनं यावद् युष्माकम् आत्मानः प्राणाः शरीराणि च निखिलानि निर्द्दोषत्वेन रक्ष्यन्तां।</para>
  <para style="p">
    <verse number="24" style="v"/>यो युष्मान् आह्वयति स विश्वसनीयोऽतः स तत् साधयिष्यति।</para>
  <para style="p">
    <verse number="25" style="v"/>हे भ्रातरः, अस्माकं कृते प्रार्थनां कुरुध्वं।</para>
  <para style="p">
    <verse number="26" style="v"/>पवित्रचुम्बनेन सर्व्वान् भ्रातृन् प्रति सत्कुरुध्वं।</para>
  <para style="p">
    <verse number="27" style="v"/>पत्रमिदं सर्व्वेषां पवित्राणां भ्रातृणां श्रुतिगोचरे युष्माभिः पठ्यतामिति प्रभो र्नाम्ना युष्मान् शपयामि।</para>
  <para style="p">
    <verse number="28" style="v"/>अस्माकं प्रभो र्यीशुख्रीष्टस्यानुग्रते युष्मासु भूयात्। आमेन्।</para>
</usx>
