<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1TI" style="id">Sanskrit Bible (NT) in Devanagari Script (सत्यवेदः।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 Timothy</para>
  <para style="toc1">१ तीमथियं पत्रं</para>
  <para style="toc2">१ तीमथियः</para>
  <para style="toc3">१ तीमथियः</para>
  <para style="mt1">१ तीमथियं पत्रं</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अस्माकं त्राणकर्त्तुरीश्वरस्यास्माकं प्रत्याशाभूमेः प्रभो र्यीशुख्रीष्टस्य चाज्ञानुसारतो यीशुख्रीष्टस्य प्रेरितः पौलः स्वकीयं सत्यं धर्म्मपुत्रं तीमथियं प्रति पत्रं लिखति।</para>
  <para style="p">
    <verse number="2" style="v"/>अस्माकं तात ईश्वरोऽस्माकं प्रभु र्यीशुख्रीष्टश्च त्वयि अनुग्रहं दयां शान्तिञ्च कुर्य्यास्तां।</para>
  <para style="p">
    <verse number="3" style="v"/>माकिदनियादेशे मम गमनकाले त्वम् इफिषनगरे तिष्ठन् इतरशिक्षा न ग्रहीतव्या, अनन्तेषूपाख्यानेषु वंशावलिषु च युष्माभि र्मनो न निवेशितव्यम्</para>
  <para style="p">
    <verse number="4" style="v"/>इति कांश्चित् लोकान् यद् उपदिशेरेतत् मयादिष्टोऽभवः, यतः सर्व्वैरेतै र्विश्वासयुक्तेश्वरीयनिष्ठा न जायते किन्तु विवादो जायते।</para>
  <para style="p">
    <verse number="5" style="v"/>उपदेशस्य त्वभिप्रेतं फलं निर्म्मलान्तःकरणेन सत्संवेदेन निष्कपटविश्वासेन च युक्तं प्रेम।</para>
  <para style="p">
    <verse number="6" style="v"/>केचित् जनाश्च सर्व्वाण्येतानि विहाय निरर्थककथानाम् अनुगमनेन विपथगामिनोऽभवन्,</para>
  <para style="p">
    <verse number="7" style="v"/>यद् भाषन्ते यच्च निश्चिन्वन्ति तन्न बुध्यमाना व्यवस्थोपदेष्टारो भवितुम् इच्छन्ति।</para>
  <para style="p">
    <verse number="8" style="v"/>सा व्यवस्था यदि योग्यरूपेण गृह्यते तर्ह्युत्तमा भवतीति वयं जानीमः।</para>
  <para style="p">
    <verse number="9" style="v"/>अपरं सा व्यवस्था धार्म्मिकस्य विरुद्धा न भवति किन्त्वधार्म्मिको ऽवाध्यो दुष्टः पापिष्ठो ऽपवित्रो ऽशुचिः पितृहन्ता मातृहन्ता नरहन्ता</para>
  <para style="p">
    <verse number="10" style="v"/>वेश्यागामी पुंमैथुनी मनुष्यविक्रेता मिथ्यावादी मिथ्याशपथकारी च सर्व्वेषामेतेषां विरुद्धा,</para>
  <para style="p">
    <verse number="11" style="v"/>तथा सच्चिदानन्देश्वरस्य यो विभवयुक्तः सुसंवादो मयि समर्पितस्तदनुयायिहितोपदेशस्य विपरीतं यत् किञ्चिद् भवति तद्विरुद्धा सा व्यवस्थेति तद्ग्राहिणा ज्ञातव्यं।</para>
  <para style="p">
    <verse number="12" style="v"/>मह्यं शक्तिदाता योऽस्माकं प्रभुः ख्रीष्टयीशुस्तमहं धन्यं वदामि।</para>
  <para style="p">
    <verse number="13" style="v"/>यतः पुरा निन्दक उपद्रावी हिंसकश्च भूत्वाप्यहं तेन विश्वास्यो ऽमन्ये परिचारकत्वे न्ययुज्ये च। तद् अविश्वासाचरणम् अज्ञानेन मया कृतमिति हेतोरहं तेनानुकम्पितोऽभवं।</para>
  <para style="p">
    <verse number="14" style="v"/>अपरं ख्रीष्टे यीशौ विश्वासप्रेमभ्यां सहितोऽस्मत्प्रभोरनुग्रहो ऽतीव प्रचुरोऽभत्।</para>
  <para style="p">
    <verse number="15" style="v"/>पापिनः परित्रातुं ख्रीष्टो यीशु र्जगति समवतीर्णोऽभवत्, एषा कथा विश्वासनीया सर्व्वै ग्रहणीया च।</para>
  <para style="p">
    <verse number="16" style="v"/>तेषां पापिनां मध्येऽहं प्रथम आसं किन्तु ये मानवा अनन्तजीवनप्राप्त्यर्थं तस्मिन् विश्वसिष्यन्ति तेषां दृष्टान्ते मयि प्रथमे यीशुना ख्रीष्टेन स्वकीया कृत्स्ना चिरसहिष्णुता यत् प्रकाश्यते तदर्थमेवाहम् अनुकम्पां प्राप्तवान्।</para>
  <para style="p">
    <verse number="17" style="v"/>अनादिरक्षयोऽदृश्यो राजा योऽद्वितीयः सर्व्वज्ञ ईश्वरस्तस्य गौरवं महिमा चानन्तकालं यावद् भूयात्। आमेन्।</para>
  <para style="p">
    <verse number="18" style="v"/>हे पुत्र तीमथिय त्वयि यानि भविष्यद्वाक्यानि पुरा कथितानि तदनुसाराद् अहम् एनमादेशं त्वयि समर्पयामि, तस्याभिप्रायोऽयं यत्त्वं तै र्वाक्यैरुत्तमयुद्धं करोषि</para>
  <para style="p">
    <verse number="19" style="v"/>विश्वासं सत्संवेदञ्च धारयसि च। अनयोः परित्यागात् केषाञ्चिद् विश्वासतरी भग्नाभवत्।</para>
  <para style="p">
    <verse number="20" style="v"/>हुमिनायसिकन्दरौ तेषां यौ द्वौ जनौ, तौ यद् धर्म्मनिन्दां पुन र्न कर्त्तुं शिक्षेते तदर्थं मया शयतानस्य करे समर्पितौ।</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>मम प्रथम आदेशोऽयं, प्रार्थनाविनयनिवेदनधन्यवादाः कर्त्तव्याः,</para>
  <para style="p">
    <verse number="2" style="v"/>सर्व्वेषां मानवानां कृते विशेषतो वयं यत् शान्तत्वेन निर्व्विरोधत्वेन चेश्चरभक्तिं विनीतत्वञ्चाचरन्तः कालं यापयामस्तदर्थं नृपतीनाम् उच्चपदस्थानाञ्च कृते ते कर्त्तव्याः।</para>
  <para style="p">
    <verse number="3" style="v"/>यतोऽस्माकं तारकस्येश्वरस्य साक्षात् तदेवोत्तमं ग्राह्यञ्च भवति,</para>
  <para style="p">
    <verse number="4" style="v"/>स सर्व्वेषां मानवानां परित्राणं सत्यज्ञानप्राप्तिञ्चेच्छति।</para>
  <para style="p">
    <verse number="5" style="v"/>यत एकोऽद्वितीय ईश्वरो विद्यते किञ्चेश्वरे मानवेषु चैको ऽद्वितीयो मध्यस्थः</para>
  <para style="p">
    <verse number="6" style="v"/>स नरावतारः ख्रीष्टो यीशु र्विद्यते यः सर्व्वेषां मुक्ते र्मूल्यम् आत्मदानं कृतवान्। एतेन येन प्रमाणेनोपयुक्ते समये प्रकाशितव्यं,</para>
  <para style="p">
    <verse number="7" style="v"/>तद्घोषयिता दूतो विश्वासे सत्यधर्म्मे च भिन्नजातीयानाम् उपदेशकश्चाहं न्ययूज्ये, एतदहं ख्रीष्टस्य नाम्ना यथातथ्यं वदामि नानृतं कथयामि।</para>
  <para style="p">
    <verse number="8" style="v"/>अतो ममाभिमतमिदं पुरुषैः क्रोधसन्देहौ विना पवित्रकरान् उत्तोल्य सर्व्वस्मिन् स्थाने प्रार्थना क्रियतां।</para>
  <para style="p">
    <verse number="9" style="v"/>तद्वत् नार्य्योऽपि सलज्जाः संयतमनसश्च सत्यो योग्यमाच्छादनं परिदधतु किञ्च केशसंस्कारैः कणकमुक्ताभि र्महार्घ्यपरिच्छदैश्चात्मभूषणं न कुर्व्वत्यः</para>
  <para style="p">
    <verse number="10" style="v"/>स्वीकृतेश्वरभक्तीनां योषितां योग्यैः सत्यर्म्मभिः स्वभूषणं कुर्व्वतां।</para>
  <para style="p">
    <verse number="11" style="v"/>नारी सम्पूर्णविनीतत्वेन निर्विरोधं शिक्षतां।</para>
  <para style="p">
    <verse number="12" style="v"/>नार्य्याः शिक्षादानं पुरुषायाज्ञादानं वाहं नानुजानामि तया निर्व्विरोेधत्वम् आचरितव्यं।</para>
  <para style="p">
    <verse number="13" style="v"/>यतः प्रथमम् आदमस्ततः परं हवायाः सृष्टि र्बभूव।</para>
  <para style="p">
    <verse number="14" style="v"/>किञ्चादम् भ्रान्तियुक्तो नाभवत् योषिदेव भ्रान्तियुक्ता भूत्वात्याचारिणी बभूव।</para>
  <para style="p">
    <verse number="15" style="v"/>तथापि नारीगणो यदि विश्वासे प्रेम्नि पवित्रतायां संयतमनसि च तिष्ठति तर्ह्यपत्यप्रसववर्त्मना परित्राणं प्राप्स्यति।</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>यदि कश्चिद् अध्यक्षपदम् आकाङ्क्षते तर्हि स उत्तमं कर्म्म लिप्सत इति सत्यं।</para>
  <para style="p">
    <verse number="2" style="v"/>अतोऽध्यक्षेणानिन्दितेनैकस्या योषितो भर्त्रा परिमितभोगेन संयतमनसा सभ्येनातिथिसेवकेन शिक्षणे निपुणेन</para>
  <para style="p">
    <verse number="3" style="v"/>न मद्यपेन न प्रहारकेण किन्तु मृदुभावेन निर्व्विवादेन निर्लोभेन</para>
  <para style="p">
    <verse number="4" style="v"/>स्वपरिवाराणाम् उत्तमशासकेन पूर्णविनीतत्वाद् वश्यानां सन्तानानां नियन्त्रा च भवितव्यं।</para>
  <para style="p">
    <verse number="5" style="v"/>यत आत्मपरिवारान् शासितुं यो न शक्नोति तेनेश्वरस्य समितेस्तत्त्वावधारणं कथं कारिष्यते?</para>
  <para style="p">
    <verse number="6" style="v"/>अपरं स गर्व्वितो भूत्वा यत् शयतान इव दण्डयोग्यो न भवेत् तदर्थं तेन नवशिष्येण न भवितव्यं।</para>
  <para style="p">
    <verse number="7" style="v"/>यच्च निन्दायां शयतानस्य जाले च न पतेत् तदर्थं तेन बहिःस्थलोकानामपि मध्ये सुख्यातियुक्तेन भवितव्यं।</para>
  <para style="p">
    <verse number="8" style="v"/>तद्वत् परिचारकैरपि विनीतै र्द्विविधवाक्यरहितै र्बहुमद्यपाने ऽनासक्तै र्निर्लोभैश्च भवितव्यं,</para>
  <para style="p">
    <verse number="9" style="v"/>निर्म्मलसंवेदेन च विश्वासस्य निगूढवाक्यं धातिव्यञ्च।</para>
  <para style="p">
    <verse number="10" style="v"/>अग्रे तेषां परीक्षा क्रियतां ततः परम् अनिन्दिता भूत्वा ते परिचर्य्यां कुर्व्वन्तु।</para>
  <para style="p">
    <verse number="11" style="v"/>अपरं योषिद्भिरपि विनीताभिरनपवादिकाभिः सतर्काभिः सर्व्वत्र विश्वास्याभिश्च भवितव्यं।</para>
  <para style="p">
    <verse number="12" style="v"/>परिचारका एकैकयोषितो भर्त्तारो भवेयुः, निजसन्तानानां परिजनानाञ्च सुशासनं कुर्य्युश्च।</para>
  <para style="p">
    <verse number="13" style="v"/>यतः सा परिचर्य्या यै र्भद्ररूपेण साध्यते ते श्रेष्ठपदं प्राप्नुवन्ति ख्रीष्टे यीशौ विश्वासेन महोत्सुका भवन्ति च।</para>
  <para style="p">
    <verse number="14" style="v"/>त्वां प्रत्येतत्पत्रलेखनसमये शीघ्रं त्वत्समीपगमनस्य प्रत्याशा मम विद्यते।</para>
  <para style="p">
    <verse number="15" style="v"/>यदि वा विलम्बेय तर्हीश्वरस्य गृहे ऽर्थतः सत्यधर्म्मस्य स्तम्भभित्तिमूलस्वरूपायाम् अमरेश्वरस्य समितौ त्वया कीदृश आचारः कर्त्तव्यस्तत् ज्ञातुं शक्ष्यते।</para>
  <para style="p">
    <verse number="16" style="v"/>अपरं यस्य महत्त्वं सर्व्वस्वीकृतम् ईश्वरभक्तेस्तत् निगूढवाक्यमिदम् ईश्वरो मानवदेहे प्रकाशित आत्मना सपुण्यीकृतो दूतैः सन्दृष्टः सर्व्वजातीयानां निकटे घोषितो जगतो विश्वासपात्रीभूतस्तेजःप्राप्तये स्वर्गं नीतश्चेति।</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>पवित्र आत्मा स्पष्टम् इदं वाक्यं वदति चरमकाले कतिपयलोका वह्निनाङ्कितत्वात्</para>
  <para style="p">
    <verse number="2" style="v"/>कठोरमनसां कापट्याद् अनृतवादिनां विवाहनिषेधकानां भक्ष्यविशेषनिषेधकानाञ्च</para>
  <para style="p">
    <verse number="3" style="v"/>भूतस्वरूपाणां शिक्षायां भ्रमकात्मनां वाक्येषु च मनांसि निवेश्य धर्म्माद् भ्रंशिष्यन्ते। तानि तु भक्ष्याणि विश्वासिनां स्वीकृतसत्यधर्म्माणाञ्च धन्यवादसहिताय भोगायेश्वरेण ससृजिरे।</para>
  <para style="p">
    <verse number="4" style="v"/>यत ईश्वरेण यद्यत् सृष्टं तत् सर्व्वम् उत्तमं यदि च धन्यवादेन भुज्यते तर्हि तस्य किमपि नाग्राह्यं भवति,</para>
  <para style="p">
    <verse number="5" style="v"/>यत ईश्वरस्य वाक्येन प्रार्थनया च तत् पवित्रीभवति।</para>
  <para style="p">
    <verse number="6" style="v"/>एतानि वाक्यानि यदि त्वं भ्रातृन् ज्ञापयेस्तर्हि यीशुख्रीष्टस्योत्तम्ः परिचारको भविष्यसि यो विश्वासो हितोपदेशश्च त्वया गृहीतस्तदीयवाक्यैराप्यायिष्यसे च।</para>
  <para style="p">
    <verse number="7" style="v"/>यान्युपाख्यानानि दुर्भावानि वृद्धयोषितामेव योग्यानि च तानि त्वया विसृज्यन्ताम् ईश्वरभक्तये यत्नः क्रियताञ्च।</para>
  <para style="p">
    <verse number="8" style="v"/>यतः शारीरिको यत्नः स्वल्पफलदो भवति किन्त्वीश्वरभक्तिरैहिकपारत्रिकजीवनयोः प्रतिज्ञायुक्ता सती सर्व्वत्र फलदा भवति।</para>
  <para style="p">
    <verse number="9" style="v"/>वाक्यमेतद् विश्वसनीयं सर्व्वै र्ग्रहणीयञ्च वयञ्च तदर्थमेव श्राम्यामो निन्दां भुंज्महे च।</para>
  <para style="p">
    <verse number="10" style="v"/>यतो हेतोः सर्व्वमानवानां विशेषतो विश्वासिनां त्राता योऽमर ईश्वरस्तस्मिन् वयं विश्वसामः।</para>
  <para style="p">
    <verse number="11" style="v"/>त्वम् एतानि वाक्यानि प्रचारय समुपदिश च।</para>
  <para style="p">
    <verse number="12" style="v"/>अल्पवयष्कत्वात् केनाप्यवज्ञेयो न भव किन्त्वालापेनाचरणेन प्रेम्ना सदात्मत्वेन विश्वासेन शुचित्वेन च विश्वासिनाम् आदर्शो भव।</para>
  <para style="p">
    <verse number="13" style="v"/>यावन्नाहम् आगमिष्यामि तावत् त्व पाठे चेतयने उपदेशे च मनो निधत्स्व।</para>
  <para style="p">
    <verse number="14" style="v"/>प्राचीनगणहस्तार्पणसहितेन भविष्यद्वाक्येन यद्दानं तुभ्यं विश्राणितं तवान्तःस्थे तस्मिन् दाने शिथिलमना मा भव।</para>
  <para style="p">
    <verse number="15" style="v"/>एतेषु मनो निवेशय, एतेषु वर्त्तस्व, इत्थञ्च सर्व्वविषये तव गुणवृद्धिः प्रकाशतां।</para>
  <para style="p">
    <verse number="16" style="v"/>स्वस्मिन् उपदेशे च सावधानो भूत्वावतिष्ठस्व तत् कृत्वा त्वयात्मपरित्राणं श्रोतृणाञ्च परित्राणं साधयिष्यते।</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>त्वं प्राचीनं न भर्त्सय किन्तु तं पितरमिव यूनश्च भ्रातृनिव</para>
  <para style="p">
    <verse number="2" style="v"/>वृद्धाः स्त्रियश्च मातृनिव युवतीश्च पूर्णशुचित्वेन भगिनीरिव विनयस्व।</para>
  <para style="p">
    <verse number="3" style="v"/>अपरं सत्यविधवाः सम्मन्यस्व।</para>
  <para style="p">
    <verse number="4" style="v"/>कस्याश्चिद् विधवाया यदि पुत्राः पौत्रा वा विद्यन्ते तर्हि ते प्रथमतः स्वीयपरिजनान् सेवितुं पित्रोः प्रत्युपकर्त्तुञ्च शिक्षन्तां यतस्तदेवेश्वरस्य साक्षाद् उत्तमं ग्राह्यञ्च कर्म्म।</para>
  <para style="p">
    <verse number="5" style="v"/>अपरं या नारी सत्यविधवा नाथहीना चास्ति सा ईश्वरस्याश्रये तिष्ठन्ती दिवानिशं निवेदनप्रार्थनाभ्यां कालं यापयति।</para>
  <para style="p">
    <verse number="6" style="v"/>किन्तु या विधवा सुखभोगासक्ता सा जीवत्यपि मृता भवति।</para>
  <para style="p">
    <verse number="7" style="v"/>अतएव ता यद् अनिन्दिता भवेयूस्तदर्थम् एतानि त्वया निदिश्यन्तां।</para>
  <para style="p">
    <verse number="8" style="v"/>यदि कश्चित् स्वजातीयान् लोकान् विशेषतः स्वीयपरिजनान् न पालयति तर्हि स विश्वासाद् भ्रष्टो ऽप्यधमश्च भवति।</para>
  <para style="p">
    <verse number="9" style="v"/>विधवावर्गे यस्या गणना भवति तया षष्टिवत्सरेभ्यो न्यूनवयस्कया न भवितव्यं; अपरं पूर्व्वम् एकस्वामिका भूत्वा</para>
  <para style="p">
    <verse number="10" style="v"/>सा यत् शिशुपोषणेनातिथिसेवनेन पवित्रलोकानां चरणप्रक्षालनेन क्लिष्टानाम् उपकारेण सर्व्वविधसत्कर्म्माचरणेन च सत्कर्म्मकरणात् सुख्यातिप्राप्ता भवेत् तदप्यावश्यकं।</para>
  <para style="p">
    <verse number="11" style="v"/>किन्तु युवती र्विधवा न गृहाण यतः ख्रीष्टस्य वैपरीत्येन तासां दर्पे जाते ता विवाहम् इच्छन्ति।</para>
  <para style="p">
    <verse number="12" style="v"/>तस्माच्च पूर्व्वधर्म्मं परित्यज्य दण्डनीया भवन्ति।</para>
  <para style="p">
    <verse number="13" style="v"/>अनन्तरं ता गृहाद् गृहं पर्य्यटन्त्य आलस्यं शिक्षन्ते केवलमालस्यं नहि किन्त्वनर्थकालापं पराधिकारचर्च्चाञ्चापि शिक्षमाणा अनुचितानि वाक्यानि भाषन्ते।</para>
  <para style="p">
    <verse number="14" style="v"/>अतो ममेच्छेयं युवत्यो विधवा विवाहं कुर्व्वताम् अपत्यवत्यो भवन्तु गृहकर्म्म कुर्व्वताञ्चेत्थं विपक्षाय किमपि निन्दाद्वारं न ददतु।</para>
  <para style="p">
    <verse number="15" style="v"/>यत इतः पूर्व्वम् अपि काश्चित् शयतानस्य पश्चाद्गामिन्यो जाताः।</para>
  <para style="p">
    <verse number="16" style="v"/>अपरं विश्वासिन्या विश्वासिनो वा कस्यापि परिवाराणां मध्ये यदि विधवा विद्यन्ते तर्हि स ताः प्रतिपालयतु तस्मात् समितौ भारे ऽनारोपिते सत्यविधवानां प्रतिपालनं कर्त्तुं तया शक्यते।</para>
  <para style="p">
    <verse number="17" style="v"/>ये प्राञ्चः समितिं सम्यग् अधितिष्ठन्ति विशेषत ईश्वरवाक्येनोपदेशेन च ये यत्नं विदधते ते द्विगुणस्यादरस्य योग्या मान्यन्तां।</para>
  <para style="p">
    <verse number="18" style="v"/>यस्मात् शास्त्रे लिखितमिदमास्ते, त्वं शस्यमर्द्दकवृषस्यास्यं मा बधानेति, अपरमपि कार्य्यकृद् वेतनस्य योग्यो भवतीति।</para>
  <para style="p">
    <verse number="19" style="v"/>द्वौ त्रीन् वा साक्षिणो विना कस्याचित् प्राचीनस्य विरुद्धम् अभियोगस्त्वया न गृह्यतां।</para>
  <para style="p">
    <verse number="20" style="v"/>अपरं ये पापमाचरन्ति तान् सर्व्वेषां समक्षं भर्त्सयस्व तेनापरेषामपि भीति र्जनिष्यते।</para>
  <para style="p">
    <verse number="21" style="v"/>अहम् ईश्वरस्य प्रभो र्यीशुख्रीष्टस्य मनोनीतदिव्यदूतानाञ्च गोचरे त्वाम् इदम् आज्ञापयामि त्वं कस्याप्यनुरोधेन किमपि न कुर्व्वन विनापक्षपातम् एतान विधीन् पालय।</para>
  <para style="p">
    <verse number="22" style="v"/>कस्यापि मूर्द्धि हस्तापर्णं त्वरया माकार्षीः। परपापानाञ्चांशी मा भव। स्वं शुचिं रक्ष।</para>
  <para style="p">
    <verse number="23" style="v"/>अपरं तवोदरपीडायाः पुनः पुन दुर्ब्बलतायाश्च निमित्तं केवलं तोयं न पिवन् किञ्चिन् मद्यं पिव।</para>
  <para style="p">
    <verse number="24" style="v"/>केषाञ्चित् मानवानां पापानि विचारात् पूर्व्वं केषाञ्चित् पश्चात् प्रकाशन्ते।</para>
  <para style="p">
    <verse number="25" style="v"/>तथैव सत्कर्म्माण्यपि प्रकाशन्ते तदन्यथा सति प्रच्छन्नानि स्थातुं न शक्नुवन्ति।</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>यावन्तो लोका युगधारिणो दासाः सन्ति ते स्वस्वस्वामिनं पूर्णसमादरयोग्यं मन्यन्तां नो चेद् ईश्वरस्य नाम्न उपदेशस्य च निन्दा सम्भविष्यति।</para>
  <para style="p">
    <verse number="2" style="v"/>येषाञ्च स्वामिनो विश्वासिनः भवन्ति तैस्ते भ्रातृत्वात् नावज्ञेयाः किन्तु ते कर्म्मफलभोगिनो विश्वासिनः प्रियाश्च भवन्तीति हेतोः सेवनीया एव, त्वम् एतानि शिक्षय समुपदिश च।</para>
  <para style="p">
    <verse number="3" style="v"/>यः कश्चिद् इतरशिक्षां करोति, अस्माकं प्रभो र्यीशुख्रीष्टस्य हितवाक्यानीश्वरभक्ते र्योग्यां शिक्षाञ्च न स्वीकरोति</para>
  <para style="p">
    <verse number="4" style="v"/>स दर्पध्मातः सर्व्वथा ज्ञानहीनश्च विवादै र्वाग्युद्धैश्च रोगयुक्तश्च भवति।</para>
  <para style="p">
    <verse number="5" style="v"/>तादृशाद् भावाद् ईर्ष्याविरोधापवाददुष्टासूया भ्रष्टमनसां सत्यज्ञानहीनानाम् ईश्वरभक्तिं लाभोपायम् इव मन्यमानानां लोकानां विवादाश्च जायन्ते तादृशेभ्यो लोकेभ्यस्त्वं पृथक् तिष्ठ।</para>
  <para style="p">
    <verse number="6" style="v"/>संयतेच्छया युक्ता येश्वरभक्तिः सा महालाभोपायो भवतीति सत्यं।</para>
  <para style="p">
    <verse number="7" style="v"/>एतज्जगत्प्रवेशनकालेऽस्माभिः किमपि नानायि तत्तयजनकालेऽपि किमपि नेतुं न शक्ष्यत इति निश्चितं।</para>
  <para style="p">
    <verse number="8" style="v"/>अतएव खाद्यान्याच्छादनानि च प्राप्यास्माभिः सन्तुष्टै र्भवितव्यं।</para>
  <para style="p">
    <verse number="9" style="v"/>ये तु धनिनो भवितुं चेष्टन्ते ते परीक्षायाम् उन्माथे पतन्ति ये चाभिलाषा मानवान् विनाशे नरके च मज्जयन्ति तादृशेष्वज्ञानाहिताभिलाषेष्वपि पतन्ति।</para>
  <para style="p">
    <verse number="10" style="v"/>यतोऽर्थस्पृहा सर्व्वेषां दुरितानां मूलं भवति तामवलम्ब्य केचिद् विश्वासाद् अभ्रंशन्त नानाक्लेशैश्च स्वान् अविध्यन्।</para>
  <para style="p">
    <verse number="11" style="v"/>हे ईश्वरस्य लोक त्वम् एतेभ्यः पलाय्य धर्म्म ईश्वरभक्ति र्विश्वासः प्रेम सहिष्णुता क्षान्तिश्चैतान्याचर।</para>
  <para style="p">
    <verse number="12" style="v"/>विश्वासरूपम् उत्तमयुद्धं कुरु, अनन्तजीवनम् आलम्बस्व यतस्तदर्थं त्वम् आहूतो ऽभवः, बहुसाक्षिणां समक्षञ्चोत्तमां प्रतिज्ञां स्वीकृतवान्।</para>
  <para style="p">
    <verse number="13" style="v"/>अपरं सर्व्वेषां जीवयितुरीश्वरस्य साक्षाद् यश्च ख्रीष्टो यीशुः पन्तीयपीलातस्य समक्षम् उत्तमां प्रतिज्ञां स्वीकृतवान् तस्य साक्षाद् अहं त्वाम् इदम् आज्ञापयामि।</para>
  <para style="p">
    <verse number="14" style="v"/>ईश्वरेण स्वसमये प्रकाशितव्यम् अस्माकं प्रभो र्यीशुख्रीष्टस्यागमनं यावत् त्वया निष्कलङ्कत्वेन निर्द्दोषत्वेन च विधी रक्ष्यतां।</para>
  <para style="p">
    <verse number="15" style="v"/>स ईश्वरः सच्चिदानन्दः, अद्वितीयसम्राट्, राज्ञां राजा, प्रभूनां प्रभुः,</para>
  <para style="p">
    <verse number="16" style="v"/>अमरताया अद्वितीय आकरः, अगम्यतेजोनिवासी, मर्त्त्यानां केनापि न दृष्टः केनापि न दृश्यश्च। तस्य गौरवपराक्रमौ सदातनौ भूयास्तां। आमेन्।</para>
  <para style="p">
    <verse number="17" style="v"/>इहलोके ये धनिनस्ते चित्तसमुन्नतिं चपले धने विश्वासञ्च न कुर्व्वतां किन्तु भोगार्थम् अस्मभ्यं प्रचुरत्वेन सर्व्वदाता</para>
  <para style="p">
    <verse number="18" style="v"/>योऽमर ईश्वरस्तस्मिन् विश्वसन्तु सदाचारं कुर्व्वन्तु सत्कर्म्मधनेन धनिनो सुकला दातारश्च भवन्तु,</para>
  <para style="p">
    <verse number="19" style="v"/>यथा च सत्यं जीवनं पाप्नुयुस्तथा पारत्रिकाम् उत्तमसम्पदं सञ्चिन्वन्त्वेति त्वयादिश्यन्तां।</para>
  <para style="p">
    <verse number="20" style="v"/>हे तीमथिय, त्वम् उपनिधिं गोपय काल्पनिकविद्याया अपवित्रं प्रलापं विरोधोक्तिञ्च त्यज च,</para>
  <para style="p">
    <verse number="21" style="v"/>यतः कतिपया लोकास्तां विद्यामवलम्ब्य विश्वासाद् भ्रष्टा अभवन। प्रसादस्तव सहायो भूयात्। आमेन्।</para>
</usx>
