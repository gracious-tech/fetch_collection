<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="MAT" style="id">Sanskrit Bible (NT) in Devanagari Script (सत्यवेदः।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Matthew</para>
  <para style="toc1">मथिलिखितः सुसंवादः</para>
  <para style="toc2">मथिः</para>
  <para style="toc3">मथिः</para>
  <para style="mt1">मथिलिखितः सुसंवादः</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>इब्राहीमः सन्तानो दायूद् तस्य सन्तानो यीशुख्रीष्टस्तस्य पूर्व्वपुरुषवंशश्रेणी।</para>
  <para style="p">
    <verse number="2" style="v"/>इब्राहीमः पुत्र इस्हाक् तस्य पुत्रो याकूब् तस्य पुत्रो यिहूदास्तस्य भ्रातरश्च।</para>
  <para style="p">
    <verse number="3" style="v"/>तस्माद् यिहूदातस्तामरो गर्भे पेरस्सेरहौ जज्ञाते, तस्य पेरसः पुत्रो हिष्रोण् तस्य पुत्रो ऽराम्।</para>
  <para style="p">
    <verse number="4" style="v"/>तस्य पुत्रो ऽम्मीनादब् तस्य पुत्रो नहशोन् तस्य पुत्रः सल्मोन्।</para>
  <para style="p">
    <verse number="5" style="v"/>तस्माद् राहबो गर्भे बोयम् जज्ञे, तस्माद् रूतो गर्भे ओबेद् जज्ञे, तस्य पुत्रो यिशयः।</para>
  <para style="p">
    <verse number="6" style="v"/>तस्य पुत्रो दायूद् राजः तस्माद् मृतोरियस्य जायायां सुलेमान् जज्ञे।</para>
  <para style="p">
    <verse number="7" style="v"/>तस्य पुत्रो रिहबियाम्, तस्य पुत्रोऽबियः, तस्य पुत्र आसा:।</para>
  <para style="p">
    <verse number="8" style="v"/>तस्य सुतो यिहोशाफट् तस्य सुतो यिहोराम तस्य सुत उषियः।</para>
  <para style="p">
    <verse number="9" style="v"/>तस्य सुतो योथम् तस्य सुत आहम् तस्य सुतो हिष्कियः।</para>
  <para style="p">
    <verse number="10" style="v"/>तस्य सुतो मिनशिः, तस्य सुत आमोन् तस्य सुतो योशियः।</para>
  <para style="p">
    <verse number="11" style="v"/>बाबिल्नगरे प्रवसनात् पूर्व्वं स योशियो यिखनियं तस्य भ्रातृंश्च जनयामास।</para>
  <para style="p">
    <verse number="12" style="v"/>ततो बाबिलि प्रवसनकाले यिखनियः शल्तीयेलं जनयामास, तस्य सुतः सिरुब्बाविल्।</para>
  <para style="p">
    <verse number="13" style="v"/>तस्य सुतो ऽबोहुद् तस्य सुत इलीयाकीम् तस्य सुतोऽसोर्।</para>
  <para style="p">
    <verse number="14" style="v"/>असोरः सुतः सादोक् तस्य सुत आखीम् तस्य सुत इलीहूद्।</para>
  <para style="p">
    <verse number="15" style="v"/>तस्य सुत इलियासर् तस्य सुतो मत्तन्।</para>
  <para style="p">
    <verse number="16" style="v"/>तस्य सुतो याकूब् तस्य सुतो यूषफ् तस्य जाया मरियम्; तस्य गर्भे यीशुरजनि, तमेव ख्रीष्टम् (अर्थाद् अभिषिक्तं) वदन्ति।</para>
  <para style="p">
    <verse number="17" style="v"/>इत्थम् इब्राहीमो दायूदं यावत् साकल्येन चतुर्दशपुरुषाः; आ दायूदः कालाद् बाबिलि प्रवसनकालं यावत् चतुर्दशपुरुषा भवन्ति। बाबिलि प्रवासनकालात् ख्रीष्टस्य कालं यावत् चतुर्दशपुरुषा भवन्ति।</para>
  <para style="p">
    <verse number="18" style="v"/>यीशुख्रीष्टस्य जन्म कथ्थते। मरियम् नामिका कन्या यूषफे वाग्दत्तासीत्, तदा तयोः सङ्गमात् प्राक् सा कन्या  पवित्रेणात्मना गर्भवती बभूव।</para>
  <para style="p">
    <verse number="19" style="v"/>तत्र तस्याः पति र्यूषफ् सौजन्यात् तस्याः कलङ्गं प्रकाशयितुम् अनिच्छन् गोपनेने तां पारित्यक्तुं मनश्चक्रे।</para>
  <para style="p">
    <verse number="20" style="v"/>स तथैव भावयति, तदानीं परमेश्वरस्य दूतः स्वप्ने तं दर्शनं दत्त्वा व्याजहार, हे दायूदः सन्तान यूषफ् त्वं निजां जायां मरियमम् आदातुं मा भैषीः।</para>
  <para style="p">
    <verse number="21" style="v"/>यतस्तस्या गर्भः पवित्रादात्मनोऽभवत्, सा च पुत्रं प्रसविष्यते, तदा त्वं तस्य नाम यीशुम् (अर्थात् त्रातारं) करीष्यसे, यस्मात् स निजमनुजान् तेषां कलुषेभ्य उद्धरिष्यति।</para>
  <para style="p">
    <verse number="22" style="v"/>इत्थं सति, पश्य गर्भवती कन्या तनयं प्रसविष्यते। इम्मानूयेल् तदीयञ्च नामधेयं भविष्यति॥ इम्मानूयेल् अस्माकं सङ्गीश्वरइत्यर्थः।</para>
  <para style="p">
    <verse number="23" style="v"/>इति यद् वचनं पुर्व्वं भविष्यद्वक्त्रा ईश्वरः कथायामास, तत् तदानीं सिद्धमभवत्।</para>
  <para style="p">
    <verse number="24" style="v"/>अनन्तरं यूषफ् निद्रातो जागरित उत्थाय परमेश्वरीयदूतस्य निदेशानुसारेण निजां जायां जग्राह,</para>
  <para style="p">
    <verse number="25" style="v"/>किन्तु यावत् सा निजं प्रथमसुतं अ सुषुवे, तावत् तां नोपागच्छत्, ततः सुतस्य नाम यीशुं चक्रे।</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अनन्तरं हेरोद् संज्ञके राज्ञि राज्यं शासति यिहूदीयदेशस्य बैत्लेहमि नगरे यीशौ जातवति च, कतिपया ज्योतिर्व्वुदः पूर्व्वस्या दिशो यिरूशालम्नगरं समेत्य कथयमासुः,</para>
  <para style="p">
    <verse number="2" style="v"/>यो यिहूदीयानां राजा जातवान्, स कुत्रास्ते? वयं पूर्व्वस्यां दिशि तिष्ठन्तस्तदीयां तारकाम् अपश्याम तस्मात् तं प्रणन्तुम् अागमाम।</para>
  <para style="p">
    <verse number="3" style="v"/>तदा हेरोद् राजा कथामेतां निशम्य यिरूशालम्नगरस्थितैः सर्व्वमानवैः सार्द्धम् उद्विज्य</para>
  <para style="p">
    <verse number="4" style="v"/>सर्व्वान् प्रधानयाजकान् अध्यापकांश्च समाहूयानीय पप्रच्छ, ख्रीष्टः कुत्र जनिष्यते?</para>
  <para style="p">
    <verse number="5" style="v"/>तदा ते कथयामासुः, यिहूदीयदेशस्य बैत्लेहमि नगरे, यतो भविष्यद्वादिना इत्थं लिखितमास्ते,</para>
  <para style="p">
    <verse number="6" style="v"/>सर्व्वाभ्यो राजधानीभ्यो यिहूदीयस्य नीवृतः। हे यीहूदीयदेशस्ये बैत्लेहम् त्वं न चावरा। इस्रायेलीयलोकान् मे यतो यः पालयिष्यति। तादृगेको महाराजस्त्वन्मध्य उद्भविष्यती॥</para>
  <para style="p">
    <verse number="7" style="v"/>तदानीं हेरोद् राजा तान् ज्योतिर्व्विदो गोपनम् आहूय सा तारका कदा दृष्टाभवत् , तद् विनिश्चयामास।</para>
  <para style="p">
    <verse number="8" style="v"/>अपरं तान् बैत्लेहमं प्रहीत्य गदितवान्, यूयं यात, यत्नात् तं शिशुम् अन्विष्य तदुद्देशे प्राप्ते मह्यं वार्त्तां दास्यथ, ततो मयापि गत्वा स प्रणंस्यते।</para>
  <para style="p">
    <verse number="9" style="v"/>तदानीं राज्ञ एतादृशीम् आज्ञां प्राप्य ते प्रतस्थिरे, ततः पूर्व्वर्स्यां दिशि स्थितैस्तै र्या तारका दृष्टा सा तारका तेषामग्रे गत्वा यत्र स्थाने शिशूरास्ते, तस्य स्थानस्योपरि स्थगिता तस्यौ।</para>
  <para style="p">
    <verse number="10" style="v"/>तद् दृष्ट्वा ते महानन्दिता बभूवुः,</para>
  <para style="p">
    <verse number="11" style="v"/>ततो गेहमध्य प्रविश्य तस्य मात्रा मरियमा साद्धं तं शिशुं निरीक्षय दण्डवद् भूत्वा प्रणेमुः, अपरं स्वेषां घनसम्पत्तिं मोचयित्वा सुवर्णं कुन्दुरुं गन्धरमञ्च तस्मै दर्शनीयं दत्तवन्तः।</para>
  <para style="p">
    <verse number="12" style="v"/>पश्चाद् हेरोद् राजस्य समीपं पुनरपि गन्तुं स्वप्न ईश्वरेण निषिद्धाः सन्तो ऽन्येन पथा ते निजदेशं प्रति प्रतस्थिरे।</para>
  <para style="p">
    <verse number="13" style="v"/>अनन्तरं तेषु गतवत्मु परमेश्वरस्य दूतो यूषफे स्वप्ने दर्शनं दत्वा जगाद, त्वम् उत्थाय शिशुं तन्मातरञ्च गृहीत्वा मिसर्देशं पलायस्व, अपरं यावदहं तुभ्यं वार्त्तां न कथयिष्यामि, तावत् तत्रैव निवस, यतो राजा हेरोद् शिशुं नाशयितुं मृगयिष्यते।</para>
  <para style="p">
    <verse number="14" style="v"/>तदानीं यूषफ् उत्थाय रजन्यां शिशुं तन्मातरञ्च गृहीत्वा मिसर्देशं प्रति प्रतस्थे,</para>
  <para style="p">
    <verse number="15" style="v"/>गत्वा च हेरोदो नृपते र्मरणपर्य्यन्तं तत्र देशे न्युवास, तेन मिसर्देशादहं पुत्रं स्वकीयं समुपाहूयम्। यदेतद्वचनम् ईश्वरेण भविष्यद्वादिना कथितं तत् सफलमभूत्।</para>
  <para style="p">
    <verse number="16" style="v"/>अनन्तरं हेरोद् ज्योतिर्विद्भिरात्मानं प्रवञ्चितं विज्ञाय भृशं चुकोप; अपरं ज्योतिर्व्विद्भ्यस्तेन विनिश्चितं यद् दिनं तद्दिनाद् गणयित्वा द्वितीयवत्सरं प्रविष्टा यावन्तो बालका अस्मिन् बैत्लेहम्नगरे तत्सीममध्ये चासन्, लोकान् प्रहित्य तान् सर्व्वान् घातयामास।</para>
  <para style="p">
    <verse number="17" style="v"/>अतः अनेकस्य विलापस्य निनाद: क्रन्दनस्य च। शोकेन कृतशब्दश्च रामायां संनिशम्यते। स्वबालगणहेतोर्वै राहेल् नारी तु रोदिनी। न मन्यते प्रबोधन्तु यतस्ते नैव मन्ति हि॥</para>
  <para style="p">
    <verse number="18" style="v"/>यदेतद् वचनं यिरीमियनामकभविष्यद्वादिना कथितं तत् तदानीं सफलम् अभूत्।</para>
  <para style="p">
    <verse number="19" style="v"/>तदनन्तरं हेरेदि राजनि मृते परमेश्वरस्य दूतो मिसर्देशे स्वप्ने दर्शनं दत्त्वा यूषफे कथितवान्</para>
  <para style="p">
    <verse number="20" style="v"/>त्वम् उत्थाय शिशुं तन्मातरञ्च गृहीत्वा पुनरपीस्रायेलो देशं याही, ये जनाः शिशुं नाशयितुम् अमृगयन्त, ते मृतवन्तः।</para>
  <para style="p">
    <verse number="21" style="v"/>तदानीं स उत्थाय शिशुं तन्मातरञ्च गृह्लन् इस्रायेल्देशम् आजगाम।</para>
  <para style="p">
    <verse number="22" style="v"/>किन्तु यिहूदीयदेशे अर्खिलायनाम राजकुमारो निजपितु र्हेरोदः पदं प्राप्य राजत्वं करोतीति निशम्य तत् स्थानं यातुं शङ्कितवान्, पश्चात् स्वप्न ईश्वरात् प्रबोधं प्राप्य गालील्देशस्य प्रदेशैकं प्रस्थाय नासरन्नाम नगरं गत्वा तत्र न्युषितवान्,</para>
  <para style="p">
    <verse number="23" style="v"/>तेन तं नासरतीयं कथयिष्यन्ति, यदेतद्वाक्यं भविष्यद्वादिभिरुक्त्तं तत् सफलमभवत्।</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>तदानों योह्न्नामा मज्जयिता यिहूदीयदेशस्य प्रान्तरम् उपस्थाय प्रचारयन् कथयामास,</para>
  <para style="p">
    <verse number="2" style="v"/>मनांसि परावर्त्तयत, स्वर्गीयराजत्वं समीपमागतम्।</para>
  <para style="p">
    <verse number="3" style="v"/>परमेशस्य पन्थानं परिष्कुरुत सर्व्वतः। तस्य राजपथांश्चैव समीकुरुत सर्व्वथा। इत्येतत् प्रान्तरे वाक्यं वदतः कस्यचिद् रवः॥</para>
  <para style="p">
    <verse number="4" style="v"/>एतद्वचनं यिशयियभविष्यद्वादिना योहनमुद्दिश्य भाषितम्। योहनो वसनं महाङ्गरोमजं तस्य कटौ चर्म्मकटिबन्धनं; स च शूककीटान् मधु च भुक्तवान्।</para>
  <para style="p">
    <verse number="5" style="v"/>तदानीं यिरूशालम्नगरनिवासिनः सर्व्वे यिहूदिदेशीया यर्द्दन्तटिन्या उभयतटस्थाश्च मानवा बहिरागत्य तस्य समीपे</para>
  <para style="p">
    <verse number="6" style="v"/>स्वीयं स्वीयं दुरितम् अङ्गीकृत्य तस्यां यर्द्दनि तेन मज्जिता बभूवुः।</para>
  <para style="p">
    <verse number="7" style="v"/>अपरं बहून् फिरूशिनः सिदूकिनश्च मनुजान् मंक्तुं स्वसमीपम् आगच्छ्तो विलोक्य स तान् अभिदधौ, रे रे भुजगवंशा आगामीनः कोपात् पलायितुं युष्मान् कश्चेतितवान्?</para>
  <para style="p">
    <verse number="8" style="v"/>मनःपरावर्त्तनस्य समुचितं फलं फलत।</para>
  <para style="p">
    <verse number="9" style="v"/>किन्त्वस्माकं तात इब्राहीम् अस्तीति स्वेषु मनःसु चीन्तयन्तो मा व्याहरत। यतो युष्मान् अहं वदामि, ईश्वर एतेभ्यः पाषाणेभ्य इब्राहीमः सन्तानान् उत्पादयितुं शक्नोति।</para>
  <para style="p">
    <verse number="10" style="v"/>अपरं पादपानां मूले कुठार इदानीमपि लगन् आस्ते, तस्माद् यस्मिन् पादपे उत्तमं फलं न भवति, स कृत्तो मध्येऽग्निं निक्षेप्स्यते।</para>
  <para style="p">
    <verse number="11" style="v"/>अपरम् अहं मनःपरावर्त्तनसूचकेन मज्जनेन युष्मान् मज्जयामीति सत्यं, किन्तु मम पश्चाद् य आगच्छति, स मत्तोपि महान्, अहं तदीयोपानहौ वोढुमपि नहि योग्योस्मि, स युष्मान् वह्निरूपे पवित्र आत्मनि संमज्जयिष्यति।</para>
  <para style="p">
    <verse number="12" style="v"/>तस्य कारे सूर्प आस्ते, स स्वीयशस्यानि सम्यक् प्रस्फोट्य निजान् सकलगोधूमान् संगृह्य भाण्डागारे स्थापयिष्यति, किंन्तु सर्व्वाणि वुषाण्यनिर्व्वाणवह्निना दाहयिष्यति।</para>
  <para style="p">
    <verse number="13" style="v"/>अनन्तरं यीशु र्योहना मज्जितो भवितुं गालील्प्रदेशाद् यर्द्दनि तस्य समीपम् आजगाम।</para>
  <para style="p">
    <verse number="14" style="v"/>किन्तु योहन् तं निषिध्य बभाषे, त्वं किं मम समीपम् आगच्छसि? वरं त्वया मज्जनं मम प्रयोजनम् आस्ते।</para>
  <para style="p">
    <verse number="15" style="v"/>तदानीं यीशुः प्रत्यवोचत्; ईदानीम् अनुमन्यस्व, यत इत्थं सर्व्वधर्म्मसाधनम् अस्माकं कर्त्तव्यं, ततः सोऽन्वमन्यत।</para>
  <para style="p">
    <verse number="16" style="v"/>अनन्तरं यीशुरम्मसि मज्जितुः सन् तत्क्षणात् तोयमध्याद् उत्थाय जगाम, तदा जीमूतद्वारे मुक्ते जाते, स ईश्वरस्यात्मानं कपोतवद् अवरुह्य स्वोपर्य्यागच्छन्तं वीक्षाञ्चक्रे।</para>
  <para style="p">
    <verse number="17" style="v"/>अपरम् एष मम प्रियः पुत्र एतस्मिन्नेव मम महासन्तोष एतादृशी व्योमजा वाग् बभूव।</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ततः परं यीशुः प्रतारकेण परीक्षितो भवितुम् आत्मना प्रान्तरम् आकृष्टः</para>
  <para style="p">
    <verse number="2" style="v"/>सन् चत्वारिंशदहोरात्रान् अनाहारस्तिष्ठन् क्षुधितो बभूव।</para>
  <para style="p">
    <verse number="3" style="v"/>तदानीं परीक्षिता तत्समीपम् आगत्य व्याहृतवान्, यदि त्वमीश्वरात्मजो भवेस्तर्ह्याज्ञया पाषाणानेतान् पूपान् विधेहि।</para>
  <para style="p">
    <verse number="4" style="v"/>ततः स प्रत्यब्रवीत्, इत्थं लिखितमास्ते, "मनुजः केवलपूपेन न जीविष्यति, किन्त्वीश्वरस्य वदनाद् यानि यानि वचांसि निःसरन्ति तैरेव जीविष्यति।"</para>
  <para style="p">
    <verse number="5" style="v"/>तदा प्रतारकस्तं पुण्यनगरं नीत्वा मन्दिरस्य चूडोपरि निधाय गदितवान्,</para>
  <para style="p">
    <verse number="6" style="v"/>त्वं यदिश्वरस्य तनयो भवेस्तर्हीतोऽधः पत, यत इत्थं लिखितमास्ते, आदेक्ष्यति निजान् दूतान् रक्षितुं त्वां परमेश्वरः। यथा सर्व्वेषु मार्गेषु त्वदीयचरणद्वये। न लगेत् प्रस्तराघातस्त्वां घरिष्यन्ति ते करैः॥</para>
  <para style="p">
    <verse number="7" style="v"/>तदानीं यीशुस्तस्मै कथितवान् एतदपि लिखितमास्ते, "त्वं निजप्रभुं परमेश्वरं मा परीक्षस्व।"</para>
  <para style="p">
    <verse number="8" style="v"/>अनन्तरं प्रतारकः पुनरपि तम् अत्युञ्चधराधरोपरि नीत्वा जगतः सकलराज्यानि तदैश्वर्य्याणि च दर्शयाश्चकार कथयाञ्चकार च,</para>
  <para style="p">
    <verse number="9" style="v"/>यदि त्वं दण्डवद् भवन् मां प्रणमेस्तर्ह्यहम् एतानि तुभ्यं प्रदास्यामि।</para>
  <para style="p">
    <verse number="10" style="v"/>तदानीं यीशुस्तमवोचत्, दूरीभव प्रतारक, लिखितमिदम् आस्ते, "त्वया निजः प्रभुः परमेश्वरः प्रणम्यः केवलः स सेव्यश्च।"</para>
  <para style="p">
    <verse number="11" style="v"/>ततः प्रतारकेण स पर्य्यत्याजि, तदा स्वर्गीयदूतैरागत्य स सिषेवे।</para>
  <para style="p">
    <verse number="12" style="v"/>तदनन्तरं योहन् कारायां बबन्धे, तद्वार्त्तां निशम्य यीशुना गालील् प्रास्थीयत।</para>
  <para style="p">
    <verse number="13" style="v"/>ततः परं स नासरन्नगरं विहाय जलघेस्तटे सिबूलून्नप्ताली एतयोरुवभयोः प्रदेशयोः सीम्नोर्मध्यवर्त्ती य: कफर्नाहूम् तन्नगरम् इत्वा न्यवसत्।</para>
  <para style="p">
    <verse number="14" style="v"/>तस्मात्, अन्यादेशीयगालीलि यर्द्दन्पारेऽब्धिरोधसि। नप्तालिसिबूलून्देशौ यत्र स्थाने स्थितौ पुरा।</para>
  <para style="p">
    <verse number="15" style="v"/>तत्रत्या मनुजा ये ये पर्य्यभ्राम्यन् तमिस्रके। तैर्जनैर्बृहदालोकः परिदर्शिष्यते तदा। अवसन् ये जना देशे मृत्युच्छायास्वरूपके। तेषामुपरि लोकानामालोकः संप्रकाशितः॥</para>
  <para style="p">
    <verse number="16" style="v"/>यदेतद्वचनं यिशयियभविष्यद्वादिना प्रोक्तं, तत् तदा सफलम् अभूत्।</para>
  <para style="p">
    <verse number="17" style="v"/>अनन्तरं यीशुः सुसंवादं प्रचारयन् एतां कथां कथयितुम् आरेभे, मनांसि परावर्त्तयत, स्वर्गीयराजत्वं सविधमभवत्।</para>
  <para style="p">
    <verse number="18" style="v"/>ततः परं यीशु र्गालीलो जलधेस्तटेन गच्छन् गच्छन् आन्द्रियस्तस्य भ्राता शिमोन् अर्थतो यं पितरं वदन्ति एतावुभौ जलघौ जालं क्षिपन्तौ ददर्श, यतस्तौ मीनधारिणावास्ताम्।</para>
  <para style="p">
    <verse number="19" style="v"/>तदा स तावाहूय व्याजहार, युवां मम पश्चाद् आगच्छतं, युवामहं मनुजधारिणौ करिष्यामि।</para>
  <para style="p">
    <verse number="20" style="v"/>तेनैव तौ जालं विहाय तस्य पश्चात् आगच्छताम्।</para>
  <para style="p">
    <verse number="21" style="v"/>अनन्तरं तस्मात् स्थानात् व्रजन् व्रजन् सिवदियस्य सुतौ याकूब् योहन्नामानौ द्वौ सहजौ तातेन सार्द्धं नौकोपरि जालस्य जीर्णोद्धारं कुर्व्वन्तौ वीक्ष्य तावाहूतवान्।</para>
  <para style="p">
    <verse number="22" style="v"/>तत्क्षणात् तौ नावं स्वतातञ्च विहाय तस्य पश्चाद्गामिनौ बभूवतुः।</para>
  <para style="p">
    <verse number="23" style="v"/>अनन्तरं भजनभवने समुपदिशन् राज्यस्य सुसंवादं प्रचारयन् मनुजानां सर्व्वप्रकारान् रोगान् सर्व्वप्रकारपीडाश्च शमयन् यीशुः कृत्स्नं गालील्देशं भ्रमितुम् आरभत।</para>
  <para style="p">
    <verse number="24" style="v"/>तेन कृत्स्नसुरियादेशस्य मध्यं तस्य यशो व्याप्नोत्, अपरं भूतग्रस्ता अपस्मारर्गीणः पक्षाधातिप्रभृतयश्च यावन्तो मनुजा नानाविधव्याधिभिः क्लिष्टा आसन्, तेषु सर्व्वेषु तस्य समीपम् आनीतेषु स तान् स्वस्थान् चकार।</para>
  <para style="p">
    <verse number="25" style="v"/>एतेन गालील्-दिकापनि-यिरूशालम्-यिहूदीयदेशेभ्यो यर्द्दनः पाराञ्च बहवो मनुजास्तस्य पश्चाद् आगच्छन्।</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अनन्तरं स जननिवहं निरीक्ष्य भूधरोपरि व्रजित्वा समुपविवेश।</para>
  <para style="p">
    <verse number="2" style="v"/>तदानीं शिष्येषु तस्य समीपमागतेषु तेन तेभ्य एषा कथा कथ्याञ्चक्रे।</para>
  <para style="p">
    <verse number="3" style="v"/>अभिमानहीना जना धन्याः, यतस्ते स्वर्गीयराज्यम् अधिकरिष्यन्ति।</para>
  <para style="p">
    <verse number="4" style="v"/>खिद्यमाना मनुजा धन्याः, यस्मात् ते सान्त्वनां प्राप्सन्ति।</para>
  <para style="p">
    <verse number="5" style="v"/>नम्रा मानवाश्च धन्याः, यस्मात् ते मेदिनीम् अधिकरिष्यन्ति।</para>
  <para style="p">
    <verse number="6" style="v"/>धर्म्माय बुभुक्षिताः तृषार्त्ताश्च मनुजा धन्याः, यस्मात् ते परितर्प्स्यन्ति।</para>
  <para style="p">
    <verse number="7" style="v"/>कृपालवो मानवा धन्याः, यस्मात् ते कृपां प्राप्स्यन्ति।</para>
  <para style="p">
    <verse number="8" style="v"/>निर्म्मलहृदया मनुजाश्च धन्याः, यस्मात् त ईश्चरं द्रक्ष्यन्ति।</para>
  <para style="p">
    <verse number="9" style="v"/>मेलयितारो मानवा धन्याः, यस्मात् त ईश्चरस्य सन्तानत्वेन विख्यास्यन्ति।</para>
  <para style="p">
    <verse number="10" style="v"/>धर्म्मकारणात् ताडिता मनुजा धन्या, यस्मात् स्वर्गीयराज्ये तेषामधिकरो विद्यते।</para>
  <para style="p">
    <verse number="11" style="v"/>यदा मनुजा मम नामकृते युष्मान् निन्दन्ति ताडयन्ति मृषा नानादुर्व्वाक्यानि वदन्ति च, तदा युयं धन्याः।</para>
  <para style="p">
    <verse number="12" style="v"/>तदा आनन्दत, तथा भृशं ह्लादध्वञ्च, यतः स्वर्गे भूयांसि फलानि लप्स्यध्वे; ते युष्माकं पुरातनान् भविष्यद्वादिनोऽपि तादृग् अताडयन्।</para>
  <para style="p">
    <verse number="13" style="v"/>युयं मेदिन्यां लवणरूपाः, किन्तु यदि लवणस्य लवणत्वम् अपयाति, तर्हि तत् केन प्रकारेण स्वादुयुक्तं भविष्यति? तत् कस्यापि कार्य्यस्यायोग्यत्वात् केवलं बहिः प्रक्षेप्तुं नराणां पदतलेन दलयितुञ्च योग्यं भवति।</para>
  <para style="p">
    <verse number="14" style="v"/>यूयं जगति दीप्तिरूपाः, भूधरोपरि स्थितं नगरं गुप्तं भवितुं नहि शक्ष्यति।</para>
  <para style="p">
    <verse number="15" style="v"/>अपरं मनुजाः प्रदीपान् प्रज्वाल्य द्रोणाधो न स्थापयन्ति, किन्तु दीपाधारोपर्य्येव स्थापयन्ति, तेन ते दीपा गेहस्थितान् सकलान् प्रकाशयन्ति।</para>
  <para style="p">
    <verse number="16" style="v"/>येन मानवा युष्माकं सत्कर्म्माणि विलोक्य युष्माकं स्वर्गस्थं पितरं धन्यं वदन्ति, तेषां समक्षं युष्माकं दीप्तिस्तादृक् प्रकाशताम्।</para>
  <para style="p">
    <verse number="17" style="v"/>अहं व्यवस्थां भविष्यद्वाक्यञ्च लोप्तुम् आगतवान्, इत्थं मानुभवत, ते द्वे लोप्तुं नागतवान्, किन्तु सफले कर्त्तुम् आगतोस्मि।</para>
  <para style="p">
    <verse number="18" style="v"/>अपरं युष्मान् अहं तथ्यं वदामि यावत् व्योममेदिन्यो र्ध्वंसो न भविष्यति, तावत् सर्व्वस्मिन् सफले न जाते व्यवस्थाया एका मात्रा बिन्दुरेकोपि वा न लोप्स्यते।</para>
  <para style="p">
    <verse number="19" style="v"/>तस्मात् यो जन एतासाम् आज्ञानाम् अतिक्षुद्राम् एकाज्ञामपी लंघते मनुजांञ्च तथैव शिक्षयति, स स्वर्गीयराज्ये सर्व्वेभ्यः क्षुद्रत्वेन विख्यास्यते, किन्तु यो जनस्तां पालयति, तथैव शिक्षयति च, स स्वर्गीयराज्ये प्रधानत्वेन विख्यास्यते।</para>
  <para style="p">
    <verse number="20" style="v"/>अपरं युष्मान् अहं वदामि, अध्यापकफिरूशिमानवानां धर्म्मानुष्ठानात् युष्माकं धर्म्मानुष्ठाने नोत्तमे जाते यूयम् ईश्वरीयराज्यं प्रवेष्टुं न शक्ष्यथ।</para>
  <para style="p">
    <verse number="21" style="v"/>अपरञ्च त्वं नरं मा वधीः, यस्मात् यो नरं हन्ति, स विचारसभायां दण्डार्हो भविष्यति, पूर्व्वकालीनजनेभ्य इति कथितमासीत्, युष्माभिरश्रावि।</para>
  <para style="p">
    <verse number="22" style="v"/>किन्त्वहं युष्मान् वदामि, यः कश्चित् कारणं विना निजभ्रात्रे कुप्यति, स विचारसभायां दण्डार्हो भविष्यति; यः कश्चिच्च स्वीयसहजं निर्ब्बोधं वदति, स महासभायां दण्डार्हो भविष्यति; पुनश्च त्वं मूढ इति वाक्यं यदि कश्चित् स्वीयभ्रातरं वक्ति, तर्हि नरकाग्नौ स दण्डार्हो भविष्यति।</para>
  <para style="p">
    <verse number="23" style="v"/>अतो वेद्याः समीपं निजनैवेद्ये समानीतेऽपि निजभ्रातरं प्रति कस्माच्चित् कारणात् त्वं यदि दोषी विद्यसे, तदानीं तव तस्य स्मृति र्जायते च,</para>
  <para style="p">
    <verse number="24" style="v"/>तर्हि तस्या वेद्याः समीपे निजनैवैद्यं निधाय तदैव गत्वा पूर्व्वं तेन सार्द्धं मिल, पश्चात् आगत्य निजनैवेद्यं निवेदय।</para>
  <para style="p">
    <verse number="25" style="v"/>अन्यञ्च यावत् विवादिना सार्द्धं वर्त्मनि तिष्ठसि, तावत् तेन सार्द्धं मेलनं कुरु; नो चेत् विवादी विचारयितुः समीपे त्वां समर्पयति विचारयिता च रक्षिणः सन्निधौ समर्पयति तदा त्वं कारायां बध्येथाः।</para>
  <para style="p">
    <verse number="26" style="v"/>तर्हि त्वामहं तथ्थं ब्रवीमि, शेषकपर्दकेऽपि न परिशोधिते तस्मात् स्थानात् कदापि बहिरागन्तुं न शक्ष्यसि।</para>
  <para style="p">
    <verse number="27" style="v"/>अपरं त्वं मा व्यभिचर, यदेतद् वचनं पूर्व्वकालीनलोकेभ्यः कथितमासीत्, तद् यूयं श्रुतवन्तः;</para>
  <para style="p">
    <verse number="28" style="v"/>किन्त्वहं युष्मान् वदामि, यदि कश्चित् कामतः काञ्चन योषितं पश्यति, तर्हि स मनसा तदैव व्यभिचरितवान्।</para>
  <para style="p">
    <verse number="29" style="v"/>तस्मात् तव दक्षिणं नेत्रं यदि त्वां बाधते, तर्हि तन्नेत्रम् उत्पाट्य दूरे निक्षिप, यस्मात् तव सर्व्ववपुषो नरके निक्षेपात् तवैकाङ्गस्य नाशो वरं।</para>
  <para style="p">
    <verse number="30" style="v"/>यद्वा तव दक्षिणः करो यदि त्वां बाधते, तर्हि तं करं छित्त्वा दूरे निक्षिप, यतः सर्व्ववपुषो नरके निक्षेपात् एकाङ्गस्य नाशो वरं।</para>
  <para style="p">
    <verse number="31" style="v"/>उक्तमास्ते, यदि कश्चिन् निजजायां परित्यक्त्तुम् इच्छति, तर्हि स तस्यै त्यागपत्रं ददातु।</para>
  <para style="p">
    <verse number="32" style="v"/>किन्त्वहं युष्मान् व्याहरामि, व्यभिचारदोषे न जाते यदि कश्चिन् निजजायां परित्यजति, तर्हि स तां व्यभिचारयति; यश्च तां त्यक्तां स्त्रियं विवहति, सोपि व्यभिचरति।</para>
  <para style="p">
    <verse number="33" style="v"/>पुनश्च त्वं मृषा शपथम् न कुर्व्वन् ईश्चराय निजशपथं पालय, पूर्व्वकालीनलोकेभ्यो यैषा कथा कथिता, तामपि यूयं श्रुतवन्तः।</para>
  <para style="p">
    <verse number="34" style="v"/>किन्त्वहं युष्मान् वदामि, कमपि शपथं मा कार्ष्ट, अर्थतः स्वर्गनाम्ना न, यतः स ईश्वरस्य सिंहासनं;</para>
  <para style="p">
    <verse number="35" style="v"/>पृथिव्या नाम्नापि न, यतः सा तस्य पादपीठं; यिरूशालमो नाम्नापि न, यतः सा महाराजस्य पुरी;</para>
  <para style="p">
    <verse number="36" style="v"/>निजशिरोनाम्नापि न, यस्मात् तस्यैकं कचमपि सितम् असितं वा कर्त्तुं त्वया न शक्यते।</para>
  <para style="p">
    <verse number="37" style="v"/>अपरं यूयं संलापसमये केवलं भवतीति न भवतीति च वदत यत इतोऽधिकं यत् तत् पापात्मनो जायते।</para>
  <para style="p">
    <verse number="38" style="v"/>अपरं लोचनस्य विनिमयेन लोचनं दन्तस्य विनिमयेन दन्तः पूर्व्वक्तमिदं वचनञ्च युष्माभिरश्रूयत।</para>
  <para style="p">
    <verse number="39" style="v"/>किन्त्वहं युष्मान् वदामि यूयं हिंसकं नरं मा व्याघातयत। किन्तु केनचित् तव दक्षिणकपोले चपेटाघाते कृते तं प्रति वामं कपोलञ्च व्याघोटय।</para>
  <para style="p">
    <verse number="40" style="v"/>अपरं केनचित् त्वया सार्ध्दं विवादं कृत्वा तव परिधेयवसने जिघृतिते तस्मायुत्तरीयवसनमपि देहि।</para>
  <para style="p">
    <verse number="41" style="v"/>यदि कश्चित् त्वां क्रोशमेकं नयनार्थं अन्यायतो धरति, तदा तेन सार्ध्दं क्रोशद्वयं याहि।</para>
  <para style="p">
    <verse number="42" style="v"/>यश्च मानवस्त्वां याचते, तस्मै देहि, यदि कश्चित् तुभ्यं धारयितुम् इच्छति, तर्हि तं प्रति परांमुखो मा भूः।</para>
  <para style="p">
    <verse number="43" style="v"/>निजसमीपवसिनि प्रेम कुरु, किन्तु शत्रुं प्रति द्वेषं कुरु, यदेतत् पुरोक्तं वचनं एतदपि यूयं श्रुतवन्तः।</para>
  <para style="p">
    <verse number="44" style="v"/>किन्त्वहं युष्मान् वदामि, यूयं रिपुव्वपि प्रेम कुरुत, ये च युष्मान् शपन्ते, तान, आशिषं वदत, ये च युष्मान् ऋृतीयन्ते, तेषां मङ्गलं कुरुत, ये च युष्मान् निन्दन्ति, ताडयन्ति च, तेषां कृते प्रार्थयध्वं।</para>
  <para style="p">
    <verse number="45" style="v"/>तत्र यः सतामसताञ्चोपरि प्रभाकरम् उदाययति, तथा धार्म्मिकानामधार्म्मिकानाञ्चोपरि नीरं वर्षयति तादृशो यो युष्माकं स्वर्गस्थः पिता, यूयं तस्यैव सन्ताना भविष्यथ।</para>
  <para style="p">
    <verse number="46" style="v"/>ये युष्मासु प्रेम कुर्व्वन्ति, यूयं यदि केवलं तेव्वेव प्रेम कुरुथ, तर्हि युष्माकं किं फलं भविष्यति? चण्डाला अपि तादृशं किं न कुर्व्वन्ति?</para>
  <para style="p">
    <verse number="47" style="v"/>अपरं यूयं यदि केवलं स्वीयभ्रातृत्वेन नमत, तर्हि किं महत् कर्म्म कुरुथ? चण्डाला अपि तादृशं किं न कुर्व्वन्ति?</para>
  <para style="p">
    <verse number="48" style="v"/>तस्मात् युष्माकं स्वर्गस्थः पिता यथा पूर्णो भवति, यूयमपि तादृशा भवत।</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>सावधाना भवत, मनुजान् दर्शयितुं तेषां गोचरे धर्म्मकर्म्म मा कुरुत, तथा कृते युष्माकं स्वर्गस्थपितुः सकाशात् किञ्चन फलं न प्राप्स्यथ।</para>
  <para style="p">
    <verse number="2" style="v"/>त्वं यदा ददासि तदा कपटिनो जना यथा मनुजेभ्यः प्रशंसां प्राप्तुं भजनभवने राजमार्गे च तूरीं वादयन्ति, तथा मा कुरिु, अहं तुभ्यं यथार्थं कथयामि, ते स्वकायं फलम् अलभन्त।</para>
  <para style="p">
    <verse number="3" style="v"/>किन्तु त्वं यदा ददासि, तदा निजदक्षिणकरो यत् करोति, तद् वामकरं मा ज्ञापय।</para>
  <para style="p">
    <verse number="4" style="v"/>तेन तव दानं गुप्तं भविष्यति यस्तु तव पिता गुप्तदर्शी, स प्रकाश्य तुभ्यं फलं दास्यति।</para>
  <para style="p">
    <verse number="5" style="v"/>अपरं यदा प्रार्थयसे, तदा कपटिनइव मा कुरु, यस्मात् ते भजनभवने राजमार्गस्य कोणे तिष्ठन्तो लोकान् दर्शयन्तः प्रार्थयितुं प्रीयन्ते; अहं युष्मान् तथ्यं वदामि, ते स्वकीयफलं प्राप्नुवन्।</para>
  <para style="p">
    <verse number="6" style="v"/>तस्मात् प्रार्थनाकाले अन्तरागारं प्रविश्य द्वारं रुद्व्वा गुप्तं पश्यतस्तव पितुः समीपे प्रार्थयस्व; तेन तव यः पिता गुप्तदर्शी, स प्रकाश्य तुभ्यं फलं दास्यतिl</para>
  <para style="p">
    <verse number="7" style="v"/>अपरं प्रार्थनाकाले देवपूजकाइव मुधा पुनरुक्तिं मा कुरु, यस्मात् ते बोधन्ते, बहुवारं कथायां कथितायां तेषां प्रार्थना ग्राहिष्यते।</para>
  <para style="p">
    <verse number="8" style="v"/>यूयं तेषामिव मा कुरुत, यस्मात् युष्माकं यद् यत् प्रयोजनं याचनातः प्रागेव युष्माकं पिता तत् जानाति।</para>
  <para style="p">
    <verse number="9" style="v"/>अतएव यूयम ईदृक् प्रार्थयध्वं, हे अस्माकं स्वर्गस्थपितः, तव नाम पूज्यं भवतु।</para>
  <para style="p">
    <verse number="10" style="v"/>तव राजत्वं भवतु; तवेच्छा स्वर्गे यथा तथैव मेदिन्यामपि सफला भवतु।</para>
  <para style="p">
    <verse number="11" style="v"/>अस्माकं प्रयोजनीयम् आहारम् अद्य देहि।</para>
  <para style="p">
    <verse number="12" style="v"/>वयं यथा निजापराधिनः क्षमामहे, तथैवास्माकम् अपराधान् क्षमस्व।</para>
  <para style="p">
    <verse number="13" style="v"/>अस्मान् परीक्षां मानय, किन्तु पापात्मनो रक्ष; राजत्वं गौरवं पराक्रमः एते सर्व्वे सर्व्वदा तव; तथास्तु।</para>
  <para style="p">
    <verse number="14" style="v"/>यदि यूयम् अन्येषाम् अपराधान् क्षमध्वे तर्हि युष्माकं स्वर्गस्थपितापि युष्मान् क्षमिष्यते;</para>
  <para style="p">
    <verse number="15" style="v"/>किन्तु यदि यूयम् अन्येषाम् अपराधान् न क्षमध्वे, तर्हि युष्माकं जनकोपि युष्माकम् अपराधान् न क्षमिष्यते।</para>
  <para style="p">
    <verse number="16" style="v"/>अपरम् उपवासकाले कपटिनो जना मानुषान् उपवासं ज्ञापयितुं स्वेषां वदनानि म्लानानि कुर्व्वन्ति, यूयं तइव विषणवदना मा भवत; अहं युष्मान् तथ्यं वदामि ते स्वकीयफलम् अलभन्त।</para>
  <para style="p">
    <verse number="17" style="v"/>यदा त्वम् उपवससि, तदा यथा लोकैस्त्वं उपवासीव न दृश्यसे, किन्तु तव योऽगोचरः पिता तेनैव दृश्यसे, तत्कृते निजशिरसि तैलं मर्द्दय वदनञ्च प्रक्षालय;</para>
  <para style="p">
    <verse number="18" style="v"/>तेन तव यः पिता गुप्तदर्शी स प्रकाश्य तुभ्यं फलं दास्यति।</para>
  <para style="p">
    <verse number="19" style="v"/>अपरं यत्र स्थाने कीटाः कलङ्काश्च क्षयं नयन्ति, चौराश्च सन्धिं कर्त्तयित्वा चोरयितुं शक्नुवन्ति, तादृश्यां मेदिन्यां स्वार्थं धनं मा संचिनुत।</para>
  <para style="p">
    <verse number="20" style="v"/>किन्तु यत्र स्थाने कीटाः कलङ्काश्च क्षयं न नयन्ति, चौराश्च सन्धिं कर्त्तयित्वा चोरयितुं न शक्नुवन्ति, तादृशे स्वर्गे धनं सञ्चिनुत।</para>
  <para style="p">
    <verse number="21" style="v"/>यस्मात् यत्र स्थाने युष्मांक धनं तत्रैव खाने युष्माकं मनांसि।</para>
  <para style="p">
    <verse number="22" style="v"/>लोचनं देहस्य प्रदीपकं, तस्मात् यदि तव लोचनं प्रसन्नं भवति, तर्हि तव कृत्स्नं वपु र्दीप्तियुक्तं भविष्यति।</para>
  <para style="p">
    <verse number="23" style="v"/>किन्तु लोचनेऽप्रसन्ने तव कृत्स्नं वपुः तमिस्रयुक्तं भविष्यति। अतएव या दीप्तिस्त्वयि विद्यते, सा यदि तमिस्रयुक्ता भवति, तर्हि तत् तमिस्रं कियन् महत्।</para>
  <para style="p">
    <verse number="24" style="v"/>कोपि मनुजो द्वौ प्रभू सेवितुं न शक्नोति, यस्माद् एकं संमन्य तदन्यं न सम्मन्यते, यद्वा एकत्र मनो निधाय तदन्यम् अवमन्यते; तथा यूयमपीश्वरं लक्ष्मीञ्चेत्युभे सेवितुं न शक्नुथ।</para>
  <para style="p">
    <verse number="25" style="v"/>अपरम् अहं युष्मभ्यं तथ्यं कथयामि, किं भक्षिष्यामः? किं पास्यामः? इति प्राणधारणाय मा चिन्तयत; किं परिधास्यामः? इति कायरक्षणाय न चिन्तयत; भक्ष्यात् प्राणा वसनाञ्च वपूंषि किं श्रेष्ठाणि न हि?</para>
  <para style="p">
    <verse number="26" style="v"/>विहायसो विहङ्गमान् विलोकयत; तै र्नोप्यते न कृत्यते भाण्डागारे न सञ्चीयतेऽपि; तथापि युष्माकं स्वर्गस्थः पिता तेभ्य आहारं वितरति।</para>
  <para style="p">
    <verse number="27" style="v"/>यूयं तेभ्यः किं श्रेष्ठा न भवथ? युष्माकं कश्चित् मनुजः चिन्तयन् निजायुषः क्षणमपि वर्द्धयितुं शक्नोति?</para>
  <para style="p">
    <verse number="28" style="v"/>अपरं वसनाय कुतश्चिन्तयत? क्षेत्रोत्पन्नानि पुष्पाणि कथं वर्द्धन्ते तदालोचयत। तानि तन्तून् नोत्पादयन्ति किमपि कार्य्यं न कुर्व्वन्ति;</para>
  <para style="p">
    <verse number="29" style="v"/>तथाप्यहं युष्मान् वदामि, सुलेमान् तादृग् ऐश्वर्य्यवानपि तत्पुष्पमिव विभूषितो नासीत्।</para>
  <para style="p">
    <verse number="30" style="v"/>तस्मात् क्षद्य विद्यमानं श्चः चुल्ल्यां निक्षेप्स्यते तादृशं यत् क्षेत्रस्थितं कुसुमं तत् यदीश्चर इत्थं बिभूषयति, तर्हि हे स्तोकप्रत्ययिनो युष्मान् किं न परिधापयिष्यति?</para>
  <para style="p">
    <verse number="31" style="v"/>तस्मात् अस्माभिः किमत्स्यते? किञ्च पायिष्यते? किं वा परिधायिष्यते, इति न चिन्तयत।</para>
  <para style="p">
    <verse number="32" style="v"/>यस्मात् देवार्च्चका अपीति चेष्टन्ते; एतेषु द्रव्येषु प्रयोजनमस्तीति युष्माकं स्वर्गस्थः पिता जानाति।</para>
  <para style="p">
    <verse number="33" style="v"/>अतएव प्रथमत ईश्वरीयराज्यं धर्म्मञ्च चेष्टध्वं, तत एतानि वस्तूनि युष्मभ्यं प्रदायिष्यन्ते।</para>
  <para style="p">
    <verse number="34" style="v"/>श्वः कृते मा चिन्तयत, श्वएव स्वयं स्वमुद्दिश्य चिन्तयिष्यति; अद्यतनी या चिन्ता साद्यकृते प्रचुरतरा।</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>यथा यूयं दोषीकृता न भवथ, तत्कृतेऽन्यं दोषिणं मा कुरुत।</para>
  <para style="p">
    <verse number="2" style="v"/>यतो यादृशेन दोषेण यूयं परान् दोषिणः कुरुथ, तादृशेन दोषेण यूयमपि दोषीकृता भविष्यथ, अन्यञ्च येन परिमाणेन युष्माभिः परिमीयते, तेनैव परिमाणेन युष्मत्कृते परिमायिष्यते।</para>
  <para style="p">
    <verse number="3" style="v"/>अपरञ्च निजनयने या नासा विद्यते, ताम् अनालोच्य तव सहजस्य लोचने यत् तृणम् आस्ते, तदेव कुतो वीक्षसे?</para>
  <para style="p">
    <verse number="4" style="v"/>तव निजलोचने नासायां विद्यमानायां, हे भ्रातः, तव नयनात् तृणं बहिष्यर्तुं अनुजानीहि, कथामेतां निजसहजाय कथं कथयितुं शक्नोषि?</para>
  <para style="p">
    <verse number="5" style="v"/>हे कपटिन्, आदौ निजनयनात् नासां बहिष्कुरु ततो निजदृष्टौ सुप्रसन्नायां तव भ्रातृ र्लोचनात् तृणं बहिष्कर्तुं शक्ष्यसि।</para>
  <para style="p">
    <verse number="6" style="v"/>अन्यञ्च सारमेयेभ्यः पवित्रवस्तूनि मा वितरत, वराहाणां समक्षञ्च मुक्ता मा निक्षिपत; निक्षेपणात् ते ताः सर्व्वाः पदै र्दलयिष्यन्ति, परावृत्य युष्मानपि विदारयिष्यन्ति।</para>
  <para style="p">
    <verse number="7" style="v"/>याचध्वं ततो युष्मभ्यं दायिष्यते; मृगयध्वं तत उद्देशं लप्स्यध्वे; द्वारम् आहत, ततो युष्मत्कृते मुक्तं भविष्यति।</para>
  <para style="p">
    <verse number="8" style="v"/>यस्माद् येन याच्यते, तेन लभ्यते; येन मृग्यते तेनोद्देशः प्राप्यते; येन च द्वारम् आहन्यते, तत्कृते द्वारं मोच्यते।</para>
  <para style="p">
    <verse number="9" style="v"/>आत्मजेन पूपे प्रार्थिते तस्मै पाषाणं विश्राणयति,</para>
  <para style="p">
    <verse number="10" style="v"/>मीने याचिते च तस्मै भुजगं वितरति, एतादृशः पिता युष्माकं मध्ये क आस्ते?</para>
  <para style="p">
    <verse number="11" style="v"/>तस्माद् यूयम् अभद्राः सन्तोऽपि यदि निजबालकेभ्य उत्तमं द्रव्यं दातुं जानीथ, तर्हि युष्माकं स्वर्गस्थः पिता स्वीययाचकेभ्यः किमुत्तमानि वस्तूनि न दास्यति?</para>
  <para style="p">
    <verse number="12" style="v"/>यूष्मान् प्रतीतरेषां यादृशो व्यवहारो युष्माकं प्रियः, यूयं तान् प्रति तादृशानेव व्यवहारान् विधत्त; यस्माद् व्यवस्थाभविष्यद्वादिनां वचनानाम् इति सारम्।</para>
  <para style="p">
    <verse number="13" style="v"/>सङ्कीर्णद्वारेण प्रविशत; यतो नरकगमनाय यद् द्वारं तद् विस्तीर्णं यच्च वर्त्म तद् बृहत् तेन बहवः प्रविशन्ति।</para>
  <para style="p">
    <verse number="14" style="v"/>अपरं स्वर्गगमनाय यद् द्वारं तत् कीदृक् संकीर्णं। यच्च वर्त्म तत् कीदृग् दुर्गमम्। तदुद्देष्टारः कियन्तोऽल्पाः।</para>
  <para style="p">
    <verse number="15" style="v"/>अपरञ्च ये जना मेषवेशेन युष्माकं समीपम् आगच्छन्ति, किन्त्वन्तर्दुरन्ता वृका एतादृशेभ्यो भविष्यद्वादिभ्यः सावधाना भवत, यूयं फलेन तान् परिचेतुं शक्नुथ।</para>
  <para style="p">
    <verse number="16" style="v"/>मनुजाः किं कण्टकिनो वृक्षाद् द्राक्षाफलानि शृगालकोलितश्च उडुम्बरफलानि शातयन्ति?</para>
  <para style="p">
    <verse number="17" style="v"/>तद्वद् उत्तम एव पादप उत्तमफलानि जनयति, अधमपादपएवाधमफलानि जनयति।</para>
  <para style="p">
    <verse number="18" style="v"/>किन्तूत्तमपादपः कदाप्यधमफलानि जनयितुं न शक्नोति, तथाधमोपि पादप उत्तमफलानि जनयितुं न शक्नोति।</para>
  <para style="p">
    <verse number="19" style="v"/>अपरं ये ये पादपा अधमफलानि जनयन्ति, ते कृत्ता वह्नौ क्षिप्यन्ते।</para>
  <para style="p">
    <verse number="20" style="v"/>अतएव यूयं फलेन तान् परिचेष्यथ।</para>
  <para style="p">
    <verse number="21" style="v"/>ये जना मां प्रभुं वदन्ति, ते सर्व्वे स्वर्गराज्यं प्रवेक्ष्यन्ति तन्न, किन्तु यो मानवो मम स्वर्गस्थस्य पितुरिष्टं कर्म्म करोति स एव प्रवेक्ष्यति।</para>
  <para style="p">
    <verse number="22" style="v"/>तद् दिने बहवो मां वदिष्यन्ति, हे प्रभो हे प्रभो, तव नाम्ना किमस्मामि र्भविष्यद्वाक्यं न व्याहृतं? तव नाम्ना भूताः किं न त्याजिताः? तव नाम्ना किं नानाद्भुतानि कर्म्माणि न कृतानि?</para>
  <para style="p">
    <verse number="23" style="v"/>तदाहं वदिष्यामि, हे कुकर्म्मकारिणो युष्मान् अहं न वेद्मि, यूयं मत्समीपाद् दूरीभवत।</para>
  <para style="p">
    <verse number="24" style="v"/>यः कश्चित् ममैताः कथाः श्रुत्वा पालयति, स पाषाणोपरि गृहनिर्म्मात्रा ज्ञानिना सह मयोपमीयते।</para>
  <para style="p">
    <verse number="25" style="v"/>यतो वृष्टौ सत्याम् आप्लाव आगते वायौ वाते च तेषु तद्गेहं लग्नेषु पाषाणोपरि तस्य भित्तेस्तन्न पततिl</para>
  <para style="p">
    <verse number="26" style="v"/>किन्तु यः कश्चित् ममैताः कथाः श्रुत्वा न पालयति स सैकते गेहनिर्म्मात्रा ऽज्ञानिना उपमीयते।</para>
  <para style="p">
    <verse number="27" style="v"/>यतो जलवृष्टौ सत्याम् आप्लाव आगते पवने वाते च तै र्गृहे समाघाते तत् पतति तत्पतनं महद् भवति।</para>
  <para style="p">
    <verse number="28" style="v"/>यीशुनैतेषु वाक्येषु समापितेषु मानवास्तदीयोपदेशम् आश्चर्य्यं मेनिरे।</para>
  <para style="p">
    <verse number="29" style="v"/>यस्मात् स उपाध्याया इव तान् नोपदिदेश किन्तु समर्थपुरुषइव समुपदिदेश।</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>यदा स पर्व्वताद् अवारोहत् तदा बहवो मानवास्तत्पश्चाद् वव्रजुः।</para>
  <para style="p">
    <verse number="2" style="v"/>एकः कुष्ठवान् आगत्य तं प्रणम्य बभाषे, हे प्रभो, यदि भवान् संमन्यते, तर्हि मां निरामयं कर्त्तुं शक्नोति।</para>
  <para style="p">
    <verse number="3" style="v"/>ततो यीशुः करं प्रसार्य्य तस्याङ्गं स्पृशन् व्याजहार, सम्मन्येऽहं त्वं निरामयो भव; तेन स तत्क्षणात् कुष्ठेनामोचि।</para>
  <para style="p">
    <verse number="4" style="v"/>ततो यीशुस्तं जगाद, अवधेहि कथामेतां कश्चिदपि मा ब्रूहि, किन्तु याजकस्य सन्निधिं गत्वा स्वात्मानं दर्शय मनुजेभ्यो निजनिरामयत्वं प्रमाणयितुं मूसानिरूपितं द्रव्यम् उत्सृज च।</para>
  <para style="p">
    <verse number="5" style="v"/>तदनन्तरं यीशुना कफर्नाहूम्नामनि नगरे प्रविष्टे कश्चित् शतसेनापतिस्तत्समीपम् आगत्य विनीय बभाषे,</para>
  <para style="p">
    <verse number="6" style="v"/>हे प्रभो, मदीय एको दासः पक्षाघातव्याधिना भृशं व्यथितः, सतु शयनीय आस्ते।</para>
  <para style="p">
    <verse number="7" style="v"/>तदानीं यीशुस्तस्मै कथितवान्, अहं गत्वा तं निरामयं करिष्यामि।</para>
  <para style="p">
    <verse number="8" style="v"/>ततः स शतसेनापतिः प्रत्यवदत्, हे प्रभो, भवान् यत् मम गेहमध्यं याति तद्योग्यभाजनं नाहमस्मि; वाङ्मात्रम् आदिशतु, तेनैव मम दासो निरामयो भविष्यति।</para>
  <para style="p">
    <verse number="9" style="v"/>यतो मयि परनिध्नेऽपि मम निदेशवश्याः कति कति सेनाः सन्ति, तत एकस्मिन् याहीत्युक्ते स याति, तदन्यस्मिन् एहीत्युक्ते स आयाति, तथा मम निजदासे कर्म्मैतत् कुर्व्वित्युक्ते स तत् करोति।</para>
  <para style="p">
    <verse number="10" style="v"/>तदानीं यीशुस्तस्यैतत् वचो निशम्य विस्मयापन्नोऽभूत्; निजपश्चाद्गामिनो मानवान् अवोच्च, युष्मान् तथ्यं वच्मि, इस्रायेलीयलोकानां मध्येऽपि नैतादृशो विश्वासो मया प्राप्तः।</para>
  <para style="p">
    <verse number="11" style="v"/>अन्यच्चाहं युष्मान् वदामि, बहवः पूर्व्वस्याः पश्चिमायाश्च दिश आगत्य इब्राहीमा इस्हाका याकूबा च साकम् मिलित्वा समुपवेक्ष्यन्ति;</para>
  <para style="p">
    <verse number="12" style="v"/>किन्तु यत्र स्थाने रोदनदन्तघर्षणे भवतस्तस्मिन् बहिर्भूततमिस्रे राज्यस्य सन्ताना निक्षेस्यन्ते।</para>
  <para style="p">
    <verse number="13" style="v"/>ततः परं यीशुस्तं शतसेनापतिं जगाद, याहि, तव प्रतीत्यनुसारतो मङ्गलं भूयात्; तदा तस्मिन्नेव दण्डे तदीयदासो निरामयो बभूव।</para>
  <para style="p">
    <verse number="14" style="v"/>अनन्तरं यीशुः पितरस्य गेहमुपस्थाय ज्वरेण पीडितां शयनीयस्थितां तस्य श्वश्रूं वीक्षाञ्चक्रे।</para>
  <para style="p">
    <verse number="15" style="v"/>ततस्तेन तस्याः करस्य स्पृष्टतवात् ज्वरस्तां तत्याज, तदा सा समुत्थाय तान् सिषेवे।</para>
  <para style="p">
    <verse number="16" style="v"/>अनन्तरं सन्ध्यायां सत्यां बहुशो भूतग्रस्तमनुजान् तस्य समीपम् आनिन्युः स च वाक्येन भूतान् त्याजयामास, सर्व्वप्रकारपीडितजनांश्च निरामयान् चकार;</para>
  <para style="p">
    <verse number="17" style="v"/>तस्मात्, सर्व्वा दुर्ब्बलतास्माकं तेनैव परिधारिता। अस्माकं सकलं व्याधिं सएव संगृहीतवान्। यदेतद्वचनं यिशयियभविष्यद्वादिनोक्तमासीत्, तत्तदा सफलमभवत्।</para>
  <para style="p">
    <verse number="18" style="v"/>अनन्तरं यीशुश्चतुर्दिक्षु जननिवहं विलोक्य तटिन्याः पारं यातुं शिष्यान् आदिदेश।</para>
  <para style="p">
    <verse number="19" style="v"/>तदानीम् एक उपाध्याय आगत्य कथितवान्, हे गुरो, भवान् यत्र यास्यति तत्राहमपि भवतः पश्चाद् यास्यामि।</para>
  <para style="p">
    <verse number="20" style="v"/>ततो यीशु र्जगाद, क्रोष्टुः स्थातुं स्थानं विद्यते, विहायसो विहङ्गमानां नीडानि च सन्ति; किन्तु मनुष्यपुत्रस्य शिरः स्थापयितुं स्थानं न विद्यते।</para>
  <para style="p">
    <verse number="21" style="v"/>अनन्तरम् अपर एकः शिष्यस्तं बभाषे, हे प्रभो, प्रथमतो मम पितरं श्मशाने निधातुं गमनार्थं माम् अनुमन्यस्व।</para>
  <para style="p">
    <verse number="22" style="v"/>ततो यीशुरुक्तवान् मृता मृतान् श्मशाने निदधतु, त्वं मम पश्चाद् आगच्छ।</para>
  <para style="p">
    <verse number="23" style="v"/>अनन्तरं तस्मिन् नावमारूढे तस्य शिष्यास्तत्पश्चात् जग्मुः।</para>
  <para style="p">
    <verse number="24" style="v"/>पश्चात् सागरस्य मध्यं तेषु गतेषु तादृशः प्रबलो झञ्भ्शनिल उदतिष्ठत्, येन महातरङ्ग उत्थाय तरणिं छादितवान्, किन्तु स निद्रित आसीत्।</para>
  <para style="p">
    <verse number="25" style="v"/>तदा शिष्या आगत्य तस्य निद्राभङ्गं कृत्वा कथयामासुः, हे प्रभो, वयं म्रियामहे, भवान् अस्माकं प्राणान् रक्षतु।</para>
  <para style="p">
    <verse number="26" style="v"/>तदा स तान् उक्तवान्, हे अल्पविश्वासिनो यूयं कुतो विभीथ? ततः स उत्थाय वातं सागरञ्च तर्जयामास, ततो निर्व्वातमभवत्।</para>
  <para style="p">
    <verse number="27" style="v"/>अपरं मनुजा विस्मयं विलोक्य कथयामासुः, अहो वातसरित्पती अस्य किमाज्ञाग्राहिणौ? कीदृशोऽयं मानवः।</para>
  <para style="p">
    <verse number="28" style="v"/>अनन्तरं स पारं गत्वा गिदेरीयदेशम् उपस्थितवान्; तदा द्वौ भूतग्रस्तमनुजौ श्मशानस्थानाद् बहि र्भूत्वा तं साक्षात् कृतवन्तौ, तावेतादृशौ प्रचण्डावास्तां यत् तेन स्थानेन कोपि यातुं नाशक्नोत्।</para>
  <para style="p">
    <verse number="29" style="v"/>तावुचैः कथयामासतुः, हे ईश्वरस्य सूनो यीशो, त्वया साकम् आवयोः कः सम्बन्धः? निरूपितकालात् प्रागेव किमावाभ्यां यातनां दातुम् अत्रागतोसि?</para>
  <para style="p">
    <verse number="30" style="v"/>तदानीं ताभ्यां किञ्चिद् दूरे वराहाणाम् एको महाव्रजोऽचरत्।</para>
  <para style="p">
    <verse number="31" style="v"/>ततो भूतौ तौ तस्यान्तिके विनीय कथयामासतुः, यद्यावां त्याजयसि, तर्हि वराहाणां मध्येव्रजम् आवां प्रेरय।</para>
  <para style="p">
    <verse number="32" style="v"/>तदा यीशुरवदत् यातं, अनन्तरं तौ यदा मनुजौ विहाय वराहान् आश्रितवन्तौ, तदा ते सर्व्वे वराहा उच्चस्थानात् महाजवेन धावन्तः सागरीयतोये मज्जन्तो मम्रुः।</para>
  <para style="p">
    <verse number="33" style="v"/>ततो वराहरक्षकाः पलायमाना मध्येनगरं तौ भूतग्रस्तौ प्रति यद्यद् अघटत, ताः सर्व्ववार्त्ता अवदन्।</para>
  <para style="p">
    <verse number="34" style="v"/>ततो नागरिकाः सर्व्वे मनुजा यीशुं साक्षात् कर्त्तुं बहिरायाताः तञ्च विलोक्य प्रार्थयाञ्चक्रिरे भवान् अस्माकं सीमातो यातु।</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अनन्तरं यीशु र्नौकामारुह्य पुनः पारमागत्य निजग्रामम् आययौ।</para>
  <para style="p">
    <verse number="2" style="v"/>ततः कतिपया जना एकं पक्षाघातिनं स्वट्टोपरि शाययित्वा तत्समीपम् आनयन्; ततो यीशुस्तेषां प्रतीतिं विज्ञाय तं पक्षाघातिनं जगाद, हे पुत्र, सुस्थिरो भव, तव कलुषस्य मर्षणं जातम्।</para>
  <para style="p">
    <verse number="3" style="v"/>तां कथां निशम्य कियन्त उपाध्याया मनःसु चिन्तितवन्त एष मनुज ईश्वरं निन्दति।</para>
  <para style="p">
    <verse number="4" style="v"/>ततः स तेषाम् एतादृशीं चिन्तां विज्ञाय कथितवान्, यूयं मनःसु कृत एतादृशीं कुचिन्तां कुरुथ?</para>
  <para style="p">
    <verse number="5" style="v"/>तव पापमर्षणं जातं, यद्वा त्वमुत्थाय गच्छ, द्वयोरनयो र्वाक्ययोः किं वाक्यं वक्तुं सुगमं?</para>
  <para style="p">
    <verse number="6" style="v"/>किन्तु मेदिन्यां कलुषं क्षमितुं मनुजसुतस्य सामर्थ्यमस्तीति यूयं यथा जानीथ, तदर्थं स तं पक्षाघातिनं गदितवान्, उत्तिष्ठ, निजशयनीयं आदाय गेहं गच्छ।</para>
  <para style="p">
    <verse number="7" style="v"/>ततः स तत्क्षणाद् उत्थाय निजगेहं प्रस्थितवान्।</para>
  <para style="p">
    <verse number="8" style="v"/>मानवा इत्थं विलोक्य विस्मयं मेनिरे, ईश्वरेण मानवाय सामर्थ्यम् ईदृशं दत्तं इति कारणात् तं धन्यं बभाषिरे च।</para>
  <para style="p">
    <verse number="9" style="v"/>अनन्तरं यीशुस्तत्स्थानाद् गच्छन् गच्छन् करसंग्रहस्थाने समुपविष्टं मथिनामानम् एकं मनुजं विलोक्य तं बभाषे, मम पश्चाद् आगच्छ, ततः स उत्थाय तस्य पश्चाद् वव्राज।</para>
  <para style="p">
    <verse number="10" style="v"/>ततः परं यीशौ गृहे भोक्तुम् उपविष्टे बहवः करसंग्राहिणः कलुषिणश्च मानवा आगत्य तेन साकं तस्य शिष्यैश्च साकम् उपविविशुः।</para>
  <para style="p">
    <verse number="11" style="v"/>फिरूशिनस्तद् दृष्ट्वा तस्य शिष्यान् बभाषिरे, युष्माकं गुरुः किं निमित्तं करसंग्राहिभिः कलुषिभिश्च साकं भुंक्ते?</para>
  <para style="p">
    <verse number="12" style="v"/>यीशुस्तत् श्रुत्वा तान् प्रत्यवदत्, निरामयलोकानां चिकित्सकेन प्रयोजनं नास्ति, किन्तु सामयलोकानां प्रयोजनमास्ते।</para>
  <para style="p">
    <verse number="13" style="v"/>अतो यूयं यात्वा वचनस्यास्यार्थं शिक्षध्वम्, दयायां मे यथा प्रीति र्न तथा यज्ञकर्म्मणि।यतोऽहं धार्म्मिकान् आह्वातुं नागतोऽस्मि किन्तु मनः परिवर्त्तयितुं पापिन आह्वातुम् आगतोऽस्मि।</para>
  <para style="p">
    <verse number="14" style="v"/>अनन्तरं योहनः शिष्यास्तस्य समीपम् आगत्य कथयामासुः, फिरूशिनो वयञ्च पुनः पुनरुपवसामः, किन्तु तव शिष्या नोपवसन्ति, कुतः?</para>
  <para style="p">
    <verse number="15" style="v"/>तदा यीशुस्तान् अवोचत् यावत् सखीनां संङ्गे कन्याया वरस्तिष्ठति, तावत् किं ते विलापं कर्त्तुं शक्लुवन्ति? किन्तु यदा तेषां संङ्गाद् वरं नयन्ति, तादृशः समय आगमिष्यति, तदा ते उपवत्स्यन्ति।</para>
  <para style="p">
    <verse number="16" style="v"/>पुरातनवसने कोपि नवीनवस्त्रं न योजयति, यस्मात् तेन योजितेन पुरातनवसनं छिनत्ति तच्छिद्रञ्च बहुकुत्सितं दृश्यते।</para>
  <para style="p">
    <verse number="17" style="v"/>अन्यञ्च पुरातनकुत्वां कोपि नवानगोस्तनीरसं न निदधाति, यस्मात् तथा कृते कुतू र्विदीर्य्यते तेन गोस्तनीरसः पतति कुतूश्च नश्यति; तस्मात् नवीनायां कुत्वां नवीनो गोस्तनीरसः स्थाप्यते, तेन द्वयोरवनं भवति।</para>
  <para style="p">
    <verse number="18" style="v"/>अपरं तेनैतत्कथाकथनकाले एकोऽधिपतिस्तं प्रणम्य बभाषे, मम दुहिता प्रायेणैतावत्काले मृता, तस्माद् भवानागत्य तस्या गात्रे हस्तमर्पयतु, तेन सा जीविष्यति।</para>
  <para style="p">
    <verse number="19" style="v"/>तदानीं यीशुः शिष्यैः साकम् उत्थाय तस्य पश्चाद् वव्राज।</para>
  <para style="p">
    <verse number="20" style="v"/>इत्यनन्तरे द्वादशवत्सरान् यावत् प्रदरामयेन शीर्णैका नारी तस्य पश्चाद् आगत्य तस्य वसनस्य ग्रन्थिं पस्पर्श;</para>
  <para style="p">
    <verse number="21" style="v"/>यस्मात् मया केवलं तस्य वसनं स्पृष्ट्वा स्वास्थ्यं प्राप्स्यते, सा नारीति मनसि निश्चितवती।</para>
  <para style="p">
    <verse number="22" style="v"/>ततो यीशुर्वदनं परावर्त्त्य तां जगाद, हे कन्ये, त्वं सुस्थिरा भव, तव विश्वासस्त्वां स्वस्थामकार्षीत्। एतद्वाक्ये गदितएव सा योषित् स्वस्थाभूत्।</para>
  <para style="p">
    <verse number="23" style="v"/>अपरं यीशुस्तस्याध्यक्षस्य गेहं गत्वा वादकप्रभृतीन् बहून् लोकान् शब्दायमानान् विलोक्य तान् अवदत्,</para>
  <para style="p">
    <verse number="24" style="v"/>पन्थानं त्यज, कन्येयं नाम्रियत निद्रितास्ते; कथामेतां श्रुत्वा ते तमुपजहसुः।</para>
  <para style="p">
    <verse number="25" style="v"/>किन्तु सर्व्वेषु बहिष्कृतेषु सोऽभ्यन्तरं गत्वा कन्यायाः करं धृतवान्, तेन सोदतिष्ठत्;</para>
  <para style="p">
    <verse number="26" style="v"/>ततस्तत्कर्म्मणो यशः कृत्स्नं तं देशं व्याप्तवत्।</para>
  <para style="p">
    <verse number="27" style="v"/>ततः परं यीशुस्तस्मात् स्थानाद् यात्रां चकार; तदा हे दायूदः सन्तान, अस्मान् दयस्व, इति वदन्तौ द्वौ जनावन्धौ प्रोचैराहूयन्तौ तत्पश्चाद् वव्रजतुः।</para>
  <para style="p">
    <verse number="28" style="v"/>ततो यीशौ गेहमध्यं प्रविष्टं तावपि तस्य समीपम् उपस्थितवन्तौ, तदानीं स तौ पृष्टवान् कर्म्मैतत् कर्त्तुं मम सामर्थ्यम् आस्ते, युवां किमिति प्रतीथः? तदा तौ प्रत्यूचतुः, सत्यं प्रभो।</para>
  <para style="p">
    <verse number="29" style="v"/>तदानीं स तयो र्लोचनानि स्पृशन् बभाषे, युवयोः प्रतीत्यनुसाराद् युवयो र्मङ्गलं भूयात्। तेन तत्क्षणात् तयो र्नेत्राणि प्रसन्नान्यभवन्,</para>
  <para style="p">
    <verse number="30" style="v"/>पश्चाद् यीशुस्तौ दृढमाज्ञाप्य जगाद, अवधत्तम् एतां कथां कोपि मनुजो म जानीयात्।</para>
  <para style="p">
    <verse number="31" style="v"/>किन्तु तौ प्रस्थाय तस्मिन् कृत्स्ने देशे तस्य कीर्त्तिं प्रकाशयामासतुः।</para>
  <para style="p">
    <verse number="32" style="v"/>अपरं तौ बहिर्यात एतस्मिन्नन्तरे मनुजा एकं भूतग्रस्तमूकं तस्य समीपम् आनीतवन्तः।</para>
  <para style="p">
    <verse number="33" style="v"/>तेन भूते त्याजिते स मूकः कथां कथयितुं प्रारभत, तेन जना विस्मयं विज्ञाय कथयामासुः, इस्रायेलो वंशे कदापि नेदृगदृश्यत;</para>
  <para style="p">
    <verse number="34" style="v"/>किन्तु फिरूशिनः कथयाञ्चक्रुः भूताधिपतिना स भूतान् त्याजयति।</para>
  <para style="p">
    <verse number="35" style="v"/>ततः परं यीशुस्तेषां भजनभवन उपदिशन् राज्यस्य सुसंवादं प्रचारयन् लोकानां यस्य य आमयो या च पीडासीत्, तान् शमयन् शमयंश्च सर्व्वाणि नगराणि ग्रामांश्च बभ्राम।</para>
  <para style="p">
    <verse number="36" style="v"/>अन्यञ्च मनुजान् व्याकुलान् अरक्षकमेषानिव च त्यक्तान् निरीक्ष्य तेषु कारुणिकः सन् शिष्यान् अवदत्,</para>
  <para style="p">
    <verse number="37" style="v"/>शस्यानि प्रचुराणि सन्ति, किन्तु छेत्तारः स्तोकाः।</para>
  <para style="p">
    <verse number="38" style="v"/>क्षेत्रं प्रत्यपरान् छेदकान् प्रहेतुं शस्यस्वामिनं प्रार्थयध्वम्।</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अनन्तरं यीशु र्द्वादशशिष्यान् आहूयामेध्यभूतान् त्याजयितुं सर्व्वप्रकाररोगान् पीडाश्च शमयितुं तेभ्यः सामर्थ्यमदात्।</para>
  <para style="p">
    <verse number="2" style="v"/>तेषां द्वादशप्रेष्याणां नामान्येतानि। प्रथमं शिमोन् यं पितरं वदन्ति, ततः परं तस्य सहज आन्द्रियः, सिवदियस्य पुत्रो याकूब्</para>
  <para style="p">
    <verse number="3" style="v"/>तस्य सहजो योहन्; फिलिप् बर्थलमय् थोमाः करसंग्राही मथिः, आल्फेयपुत्रो याकूब्,</para>
  <para style="p">
    <verse number="4" style="v"/>किनानीयः शिमोन्, य ईष्करियोतीययिहूदाः ख्रीष्टं परकरेऽर्पयत्।</para>
  <para style="p">
    <verse number="5" style="v"/>एतान् द्वादशशिष्यान् यीशुः प्रेषयन् इत्याज्ञापयत्, यूयम् अन्यदेशीयानां पदवीं शेमिरोणीयानां किमपि नगरञ्च न प्रविश्ये</para>
  <para style="p">
    <verse number="6" style="v"/>इस्रायेल्गोत्रस्य हारिता ये ये मेषास्तेषामेव समीपं यात।</para>
  <para style="p">
    <verse number="7" style="v"/>गत्वा गत्वा स्वर्गस्य राजत्वं सविधमभवत्, एतां कथां प्रचारयत।</para>
  <para style="p">
    <verse number="8" style="v"/>आमयग्रस्तान् स्वस्थान् कुरुत, कुष्ठिनः परिष्कुरुत, मृतलोकान् जीवयत, भूतान् त्याजयत, विना मूल्यं यूयम् अलभध्वं विनैव मूल्यं विश्राणयत।</para>
  <para style="p">
    <verse number="9" style="v"/>किन्तु स्वेषां कटिबन्धेषु स्वर्णरूप्यताम्राणां किमपि न गृह्लीत।</para>
  <para style="p">
    <verse number="10" style="v"/>अन्यच्च यात्रायै चेलसम्पुटं वा द्वितीयवसनं वा पादुके वा यष्टिः, एतान् मा गृह्लीत, यतः कार्य्यकृत् भर्त्तुं योग्यो भवति।</para>
  <para style="p">
    <verse number="11" style="v"/>अपरं यूयं यत् पुरं यञ्च ग्रामं प्रविशथ, तत्र यो जनो योग्यपात्रं तमवगत्य यानकालं यावत् तत्र तिष्ठत।</para>
  <para style="p">
    <verse number="12" style="v"/>यदा यूयं तद्गेहं प्रविशथ, तदा तमाशिषं वदत।</para>
  <para style="p">
    <verse number="13" style="v"/>यदि स योग्यपात्रं भवति, तर्हि तत्कल्याणं तस्मै भविष्यति, नोचेत् साशीर्युष्मभ्यमेव भविष्यति।</para>
  <para style="p">
    <verse number="14" style="v"/>किन्तु ये जना युष्माकमातिथ्यं न विदधति युष्माकं कथाञ्च न शृण्वन्ति तेषां गेहात् पुराद्वा प्रस्थानकाले स्वपदूलीः पातयत।</para>
  <para style="p">
    <verse number="15" style="v"/>युष्मानहं तथ्यं वच्मि विचारदिने तत्पुरस्य दशातः सिदोममोरापुरयोर्दशा सह्यतरा भविष्यति।</para>
  <para style="p">
    <verse number="16" style="v"/>पश्यत, वृकयूथमध्ये मेषः यथाविस्तथा युष्मान प्रहिणोमि, तस्माद् यूयम् अहिरिव सतर्काः कपोताइवाहिंसका भवत।</para>
  <para style="p">
    <verse number="17" style="v"/>नृभ्यः सावधाना भवत; यतस्तै र्यूयं राजसंसदि समर्पिष्यध्वे तेषां भजनगेहे प्रहारिष्यध्वे।</para>
  <para style="p">
    <verse number="18" style="v"/>यूयं मन्नामहेतोः शास्तृणां राज्ञाञ्च समक्षं तानन्यदेशिनश्चाधि साक्षित्वार्थमानेष्यध्वे।</para>
  <para style="p">
    <verse number="19" style="v"/>किन्त्वित्थं समर्पिता यूयं कथं किमुत्तरं वक्ष्यथ तत्र मा चिन्तयत, यतस्तदा युष्माभि र्यद् वक्तव्यं तत् तद्दण्डे युष्मन्मनः सु समुपस्थास्यति।</para>
  <para style="p">
    <verse number="20" style="v"/>यस्मात् तदा यो वक्ष्यति स न यूयं किन्तु युष्माकमन्तरस्थः पित्रात्मा।</para>
  <para style="p">
    <verse number="21" style="v"/>सहजः सहजं तातः सुतञ्च मृतौ समर्पयिष्यति, अपत्यागि स्वस्वपित्रोे र्विपक्षीभूय तौ घातयिष्यन्ति।</para>
  <para style="p">
    <verse number="22" style="v"/>मन्नमहेतोः सर्व्वे जना युष्मान् ऋृतीयिष्यन्ते, किन्तु यः शेषं यावद् धैर्य्यं घृत्वा स्थास्यति, स त्रायिष्यते।</para>
  <para style="p">
    <verse number="23" style="v"/>तै र्यदा यूयमेकपुरे ताडिष्यध्वे, तदा यूयमन्यपुरं पलायध्वं युष्मानहं तथ्यं वच्मि यावन्मनुजसुतो नैति तावद् इस्रायेल्देशीयसर्व्वनगरभ्रमणं समापयितुं न शक्ष्यथ।</para>
  <para style="p">
    <verse number="24" style="v"/>गुरोः शिष्यो न महान्, प्रभोर्दासो न महान्।</para>
  <para style="p">
    <verse number="25" style="v"/>यदि शिष्यो निजगुरो र्दासश्च स्वप्रभोः समानो भवति तर्हि तद् यथेष्टं। चेत्तैर्गृहपतिर्भूतराज उच्यते, तर्हि परिवाराः किं तथा न वक्ष्यन्ते?</para>
  <para style="p">
    <verse number="26" style="v"/>किन्तु तेभ्यो यूयं मा बिभीत, यतो यन्न प्रकाशिष्यते, तादृक् छादितं किमपि नास्ति, यच्च न व्यञ्चिष्यते, तादृग् गुप्तं किमपि नास्ति।</para>
  <para style="p">
    <verse number="27" style="v"/>यदहं युष्मान् तमसि वच्मि तद् युष्माभिर्दीप्तौ कथ्यतां; कर्णाभ्यां यत् श्रूयते तद् गेहोपरि प्रचार्य्यतां।</para>
  <para style="p">
    <verse number="28" style="v"/>ये कायं हन्तुं शक्नुवन्ति नात्मानं, तेभ्यो मा भैष्ट; यः कायात्मानौ निरये नाशयितुं, शक्नोति, ततो बिभीत।</para>
  <para style="p">
    <verse number="29" style="v"/>द्वौ चटकौ किमेकताम्रमुद्रया न विक्रीयेते? तथापि युष्मत्तातानुमतिं विना तेषामेकोपि भुवि न पतति।</para>
  <para style="p">
    <verse number="30" style="v"/>युष्मच्छिरसां सर्व्वकचा गणितांः सन्ति।</para>
  <para style="p">
    <verse number="31" style="v"/>अतो मा बिभीत, यूयं बहुचटकेभ्यो बहुमूल्याः।</para>
  <para style="p">
    <verse number="32" style="v"/>यो मनुजसाक्षान्मामङ्गीकुरुते तमहं स्वर्गस्थतातसाक्षादङ्गीकरिष्ये।</para>
  <para style="p">
    <verse number="33" style="v"/>पृथ्व्यामहं शान्तिं दातुमागतइति मानुभवत, शान्तिं दातुं न किन्त्वसिं।</para>
  <para style="p">
    <verse number="34" style="v"/>पितृमातृश्चश्रूभिः साकं सुतसुताबधू र्विरोधयितुञ्चागतेास्मि।</para>
  <para style="p">
    <verse number="35" style="v"/>ततः स्वस्वपरिवारएव नृशत्रु र्भविता।</para>
  <para style="p">
    <verse number="36" style="v"/>यः पितरि मातरि वा मत्तोधिकं प्रीयते, स न मदर्हः;</para>
  <para style="p">
    <verse number="37" style="v"/>यश्च सुते सुतायां वा मत्तोधिकं प्रीयते, सेापि न मदर्हः।</para>
  <para style="p">
    <verse number="38" style="v"/>यः स्वक्रुशं गृह्लन् मत्पश्चान्नैति, सेापि न मदर्हः।</para>
  <para style="p">
    <verse number="39" style="v"/>यः स्वप्राणानवति, स तान् हारयिष्यते, यस्तु मत्कृते स्वप्राणान् हारयति, स तानवति।</para>
  <para style="p">
    <verse number="40" style="v"/>यो युष्माकमातिथ्यं विदधाति, स ममातिथ्यं विदधाति, यश्च ममातिथ्यं विदधाति, स मत्प्रेरकस्यातिथ्यं विदधाति।</para>
  <para style="p">
    <verse number="41" style="v"/>यो भविष्यद्वादीति ज्ञात्वा तस्यातिथ्यं विधत्ते, स भविष्यद्वादिनः फलं लप्स्यते, यश्च धार्म्मिक इति विदित्वा तस्यातिथ्यं विधत्ते स धार्म्मिकमानवस्य फलं प्राप्स्यति।</para>
  <para style="p">
    <verse number="42" style="v"/>यश्च कश्चित् एतेषां क्षुद्रनराणाम् यं कञ्चनैकं शिष्य इति विदित्वा कंसैकं शीतलसलिलं तस्मै दत्ते, युष्मानहं तथ्यं वदामि, स केनापि प्रकारेण फलेन न वञ्चिष्यते।</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>इत्थं यीशुः स्वद्वादशशिष्याणामाज्ञापनं समाप्य पुरे पुर उपदेष्टुं सुसंवादं प्रचारयितुं तत्स्थानात् प्रतस्थे।</para>
  <para style="p">
    <verse number="2" style="v"/>अनन्तरं योहन् कारायां तिष्ठन् ख्रिष्टस्य कर्म्मणां वार्त्तं प्राप्य यस्यागमनवार्त्तासीत् सएव किं त्वं? वा वयमन्यम् अपेक्षिष्यामहे?</para>
  <para style="p">
    <verse number="3" style="v"/>एतत् प्रष्टुं निजौ द्वौ शिष्यौ प्राहिणोत्।</para>
  <para style="p">
    <verse number="4" style="v"/>यीशुः प्रत्यवोचत्, अन्धा नेत्राणि लभन्ते, खञ्चा गच्छन्ति, कुष्ठिनः स्वस्था भवन्ति, बधिराः शृण्वन्ति, मृता जीवन्त उत्तिष्ठन्ति, दरिद्राणां समीपे सुसंवादः प्रचार्य्यत,</para>
  <para style="p">
    <verse number="5" style="v"/>एतानि यद्यद् युवां शृणुथः पश्यथश्च गत्वा तद्वार्त्तां योहनं गदतं।</para>
  <para style="p">
    <verse number="6" style="v"/>यस्याहं न विघ्नीभवामि, सएव धन्यः।</para>
  <para style="p">
    <verse number="7" style="v"/>अनन्तरं तयोः प्रस्थितयो र्यीशु र्योहनम् उद्दिश्य जनान् जगाद, यूयं किं द्रष्टुं वहिर्मध्येप्रान्तरम् अगच्छत? किं वातेन कम्पितं नलं?</para>
  <para style="p">
    <verse number="8" style="v"/>वा किं वीक्षितुं वहिर्गतवन्तः? किं परिहितसूक्ष्मवसनं मनुजमेकं? पश्यत, ये सूक्ष्मवसनानि परिदधति, ते राजधान्यां तिष्ठन्ति।</para>
  <para style="p">
    <verse number="9" style="v"/>तर्हि यूयं किं द्रष्टुं बहिरगमत, किमेकं भविष्यद्वादिनं? तदेव सत्यं। युष्मानहं वदामि, स भविष्यद्वादिनोपि महान्;</para>
  <para style="p">
    <verse number="10" style="v"/>यतः, पश्य स्वकीयदूतोयं त्वदग्रे प्रेष्यते मया। स गत्वा तव पन्थानं स्मयक् परिष्करिष्यति॥ एतद्वचनं यमधि लिखितमास्ते सोऽयं योहन्।</para>
  <para style="p">
    <verse number="11" style="v"/>अपरं युष्मानहं तथ्यं ब्रवीमि, मज्जयितु र्योहनः श्रेष्ठः कोपि नारीतो नाजायत; तथापि स्वर्गराज्यमध्ये सर्व्वेभ्यो यः क्षुद्रः स योहनः श्रेष्ठः।</para>
  <para style="p">
    <verse number="12" style="v"/>अपरञ्च आ योहनोऽद्य यावत् स्वर्गराज्यं बलादाक्रान्तं भवति आक्रमिनश्च जना बलेन तदधिकुर्व्वन्ति।</para>
  <para style="p">
    <verse number="13" style="v"/>यतो योहनं यावत् सर्व्वभविष्यद्वादिभि र्व्यवस्थया च उपदेशः प्राकाश्यत।</para>
  <para style="p">
    <verse number="14" style="v"/>यदि यूयमिदं वाक्यं ग्रहीतुं शक्नुथ, तर्हि श्रेयः, यस्यागमनस्य वचनमास्ते सोऽयम् एलियः।</para>
  <para style="p">
    <verse number="15" style="v"/>यस्य श्रोतुं कर्णौ स्तः स शृणोतु।</para>
  <para style="p">
    <verse number="16" style="v"/>एते विद्यमानजनाः कै र्मयोपमीयन्ते? ये बालका हट्ट उपविश्य स्वं स्वं बन्धुमाहूय वदन्ति,</para>
  <para style="p">
    <verse number="17" style="v"/>वयं युष्माकं समीपे वंशीरवादयाम, किन्तु यूयं नानृत्यत; युष्माकं समीपे च वयमरोदिम, किन्तु यूयं न व्यलपत, तादृशै र्बालकैस्त उपमायिष्यन्ते।</para>
  <para style="p">
    <verse number="18" style="v"/>यतो योहन् आगत्य न भुक्तवान् न पीतवांश्च, तेन लोका वदन्ति, स भूतग्रस्त इति।</para>
  <para style="p">
    <verse number="19" style="v"/>मनुजसुत आगत्य भुक्तवान् पीतवांश्च, तेन लोका वदन्ति, पश्यत एष भोक्ता मद्यपाता चण्डालपापिनां बन्धश्च, किन्तु ज्ञानिनो ज्ञानव्यवहारं निर्दोषं जानन्ति।</para>
  <para style="p">
    <verse number="20" style="v"/>स यत्र यत्र पुरे बह्वाश्चर्य्यं कर्म्म कृतवान्, तन्निवासिनां मनःपरावृत्त्यभावात् तानि नगराणि प्रति हन्तेत्युक्ता कथितवान्,</para>
  <para style="p">
    <verse number="21" style="v"/>हा कोरासीन्, हा बैत्सैदे, युष्मन्मध्ये यद्यदाश्चर्य्यं कर्म्म कृतं यदि तत् सोरसीदोन्नगर अकारिष्यत, तर्हि पूर्व्वमेव तन्निवासिनः शाणवसने भस्मनि चोपविशन्तो मनांसि परावर्त्तिष्यन्त।</para>
  <para style="p">
    <verse number="22" style="v"/>तस्मादहं युष्मान् वदामि, विचारदिने युष्माकं दशातः सोरसीदोनो र्दशा सह्यतरा भविष्यति।</para>
  <para style="p">
    <verse number="23" style="v"/>अपरञ्च बत कफर्नाहूम्, त्वं स्वर्गं यावदुन्नतोसि, किन्तु नरके निक्षेप्स्यसे, यस्मात् त्वयि यान्याश्चर्य्याणि कर्म्मण्यकारिषत, यदि तानि सिदोम्नगर अकारिष्यन्त, तर्हि तदद्य यावदस्थास्यत्।</para>
  <para style="p">
    <verse number="24" style="v"/>किन्त्वहं युष्मान् वदामि, विचारदिने तव दण्डतः सिदोमो दण्डो सह्यतरो भविष्यति।</para>
  <para style="p">
    <verse number="25" style="v"/>एतस्मिन्नेव समये यीशुः पुनरुवाच, हे स्वर्गपृथिव्योरेकाधिपते पितस्त्वं ज्ञानवतो विदुषश्च लोकान् प्रत्येतानि न प्रकाश्य बालकान् प्रति प्रकाशितवान्, इति हेतोस्त्वां धन्यं वदामि।</para>
  <para style="p">
    <verse number="26" style="v"/>हे पितः, इत्थं भवेत् यत इदं त्वदृष्टावुत्तमं।</para>
  <para style="p">
    <verse number="27" style="v"/>पित्रा मयि सर्व्वाणि समर्पितानि, पितरं विना कोपि पुत्रं न जानाति, यान् प्रति पुत्रेण पिता प्रकाश्यते तान् विना पुत्राद् अन्यः कोपि पितरं न जानाति।</para>
  <para style="p">
    <verse number="28" style="v"/>हे परिश्रान्ता भाराक्रान्ताश्च लोका यूयं मत्सन्निधिम् आगच्छत, अहं युष्मान् विश्रमयिष्यामि।</para>
  <para style="p">
    <verse number="29" style="v"/>अहं क्षमणशीलो नम्रमनाश्च, तस्मात् मम युगं स्वेषामुपरि धारयत मत्तः शिक्षध्वञ्च, तेन यूयं स्वे स्वे मनसि विश्रामं लप्स्यध्बे।</para>
  <para style="p">
    <verse number="30" style="v"/>यतो मम युगम् अनायासं मम भारश्च लघुः।</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अनन्तरं यीशु र्विश्रामवारे श्स्यमध्येन गच्छति, तदा तच्छिष्या बुभुक्षिताः सन्तः श्स्यमञ्जरीश्छत्वा छित्वा खादितुमारभन्त।</para>
  <para style="p">
    <verse number="2" style="v"/>तद् विलोक्य फिरूशिनो यीशुं जगदुः, पश्य विश्रामवारे यत् कर्म्माकर्त्तव्यं तदेव तव शिष्याः कुर्व्वन्ति।</para>
  <para style="p">
    <verse number="3" style="v"/>स तान् प्रत्यावदत, दायूद् तत्सङ्गिनश्च बुभुक्षिताः सन्तो यत् कर्म्माकुर्व्वन् तत् किं युष्माभि र्नापाठि?</para>
  <para style="p">
    <verse number="4" style="v"/>ये दर्शनीयाः पूपाः याजकान् विना तस्य तत्सङ्गिमनुजानाञ्चाभोजनीयास्त ईश्वरावासं प्रविष्टेन तेन भुक्ताः।</para>
  <para style="p">
    <verse number="5" style="v"/>अन्यच्च विश्रामवारे मध्येमन्दिरं विश्रामवारीयं नियमं लङ्वन्तोपि याजका निर्दोषा भवन्ति, शास्त्रमध्ये किमिदमपि युष्माभि र्न पठितं?</para>
  <para style="p">
    <verse number="6" style="v"/>युष्मानहं वदामि, अत्र स्थाने मन्दिरादपि गरीयान् एक आस्ते।</para>
  <para style="p">
    <verse number="7" style="v"/>किन्तु दयायां मे यथा प्रीति र्न तथा यज्ञकर्म्मणि। एतद्वचनस्यार्थं यदि युयम् अज्ञासिष्ट तर्हि निर्दोषान् दोषिणो नाकार्ष्ट।</para>
  <para style="p">
    <verse number="8" style="v"/>अन्यच्च मनुजसुतो विश्रामवारस्यापि पतिरास्ते।</para>
  <para style="p">
    <verse number="9" style="v"/>अनन्तरं स तत्स्थानात् प्रस्थाय तेषां भजनभवनं प्रविष्टवान्, तदानीम् एकः शुष्ककरामयवान् उपस्थितवान्।</para>
  <para style="p">
    <verse number="10" style="v"/>ततो यीशुम् अपवदितुं मानुषाः पप्रच्छुः, विश्रामवारे निरामयत्वं करणीयं न वा?</para>
  <para style="p">
    <verse number="11" style="v"/>तेन स प्रत्युवाच, विश्रामवारे यदि कस्यचिद् अवि र्गर्त्ते पतति, तर्हि यस्तं घृत्वा न तोलयति, एतादृशो मनुजो युष्माकं मध्ये क आस्ते?</para>
  <para style="p">
    <verse number="12" style="v"/>अवे र्मानवः किं नहि श्रेयान्? अतो विश्रामवारे हितकर्म्म कर्त्तव्यं।</para>
  <para style="p">
    <verse number="13" style="v"/>अनन्तरं स तं मानवं गदितवान्, करं प्रसारय; तेन करे प्रसारिते सोन्यकरवत् स्वस्थोऽभवत्।</para>
  <para style="p">
    <verse number="14" style="v"/>तदा फिरूशिनो बहिर्भूय कथं तं हनिष्याम इति कुमन्त्रणां तत्प्रातिकूल्येन चक्रुः।</para>
  <para style="p">
    <verse number="15" style="v"/>ततो यीशुस्तद् विदित्वा स्थनान्तरं गतवान्; अन्येषु बहुनरेषु तत्पश्चाद् गतेषु तान् स निरामयान् कृत्वा इत्याज्ञापयत्,</para>
  <para style="p">
    <verse number="16" style="v"/>यूयं मां न परिचाययत।</para>
  <para style="p">
    <verse number="17" style="v"/>तस्मात् मम प्रीयो मनोनीतो मनसस्तुष्टिकारकः। मदीयः सेवको यस्तु विद्यते तं समीक्षतां। तस्योपरि स्वकीयात्मा मया संस्थापयिष्यते। तेनान्यदेशजातेषु व्यवस्था संप्रकाश्यते।</para>
  <para style="p">
    <verse number="18" style="v"/>केनापि न विरोधं स विवादञ्च करिष्यति। न च राजपथे तेन वचनं श्रावयिष्यते।</para>
  <para style="p">
    <verse number="19" style="v"/>व्यवस्था चलिता यावत् नहि तेन करिष्यते। तावत् नलो विदीर्णोऽपि भंक्ष्यते नहि तेन च। तथा सधूमवर्त्तिञ्च न स निर्व्वापयिष्यते।</para>
  <para style="p">
    <verse number="20" style="v"/>प्रत्याशाञ्च करिष्यन्ति तन्नाम्नि भिन्नदेशजाः।</para>
  <para style="p">
    <verse number="21" style="v"/>यान्येतानि वचनानि यिशयियभविष्यद्वादिना प्रोक्तान्यासन्, तानि सफलान्यभवन्।</para>
  <para style="p">
    <verse number="22" style="v"/>अनन्तरं लोकै स्तत्समीपम् आनीतो भूतग्रस्तान्धमूकैकमनुजस्तेन स्वस्थीकृतः, ततः सोऽन्धो मूको द्रष्टुं वक्तुञ्चारब्धवान्।</para>
  <para style="p">
    <verse number="23" style="v"/>अनेन सर्व्वे विस्मिताः कथयाञ्चक्रुः, एषः किं दायूदः सन्तानो नहि?</para>
  <para style="p">
    <verse number="24" style="v"/>किन्तु फिरूशिनस्तत् श्रुत्वा गदितवन्तः, बाल्सिबूब्नाम्नो भूतराजस्य साहाय्यं विना नायं भूतान् त्याजयति।</para>
  <para style="p">
    <verse number="25" style="v"/>तदानीं यीशुस्तेषाम् इति मानसं विज्ञाय तान् अवदत् किञ्चन राज्यं यदि स्वविपक्षाद् भिद्यते, तर्हि तत् उच्छिद्यते; यच्च किञ्चन नगरं वा गृहं स्वविपक्षाद् विभिद्यते, तत् स्थातुं न शक्नोति।</para>
  <para style="p">
    <verse number="26" style="v"/>तद्वत् शयतानो यदि शयतानं बहिः कृत्वा स्वविपक्षात् पृथक् पृथक् भवति, तर्हि तस्य राज्यं केन प्रकारेण स्थास्यति?</para>
  <para style="p">
    <verse number="27" style="v"/>अहञ्च यदि बाल्सिबूबा भूतान् त्याजयामि, तर्हि युष्माकं सन्तानाः केन भूतान् त्याजयन्ति? तस्माद् युष्माकम् एतद्विचारयितारस्त एव भविष्यन्ति।</para>
  <para style="p">
    <verse number="28" style="v"/>किन्तवहं यदीश्वरात्मना भूतान् त्याजयामि, तर्हीश्वरस्य राज्यं युष्माकं सन्निधिमागतवत्।</para>
  <para style="p">
    <verse number="29" style="v"/>अन्यञ्च कोपि बलवन्त जनं प्रथमतो न बद्व्वा केन प्रकारेण तस्य गृहं प्रविश्य तद्द्रव्यादि लोठयितुं शक्नोति? किन्तु तत् कृत्वा तदीयगृस्य द्रव्यादि लोठयितुं शक्नोति।</para>
  <para style="p">
    <verse number="30" style="v"/>यः कश्चित् मम स्वपक्षीयो नहि स विपक्षीय आस्ते, यश्च मया साकं न संगृह्लाति, स विकिरति।</para>
  <para style="p">
    <verse number="31" style="v"/>अतएव युष्मानहं वदामि, मनुजानां सर्व्वप्रकारपापानां निन्दायाश्च मर्षणं भवितुं शक्नोति, किन्तु पवित्रस्यात्मनो विरुद्धनिन्दाया मर्षणं भवितुं न शक्नोति।</para>
  <para style="p">
    <verse number="32" style="v"/>यो मनुजसुतस्य विरुद्धां कथां कथयति, तस्यापराधस्य क्षमा भवितुं शक्नोति, किन्तु यः कश्चित् पवित्रस्यात्मनो विरुद्धां कथां कथयति नेहलोके न प्रेत्य तस्यापराधस्य क्षमा भवितुं शक्नोति।</para>
  <para style="p">
    <verse number="33" style="v"/>पादपं यदि भद्रं वदथ, तर्हि तस्य फलमपि साधु वक्तव्यं, यदि च पादपं असाधुं वदथ, तर्हि तस्य फलमप्यसाधु वक्तव्यं; यतः स्वीयस्वीयफलेन पादपः परिचीयते।</para>
  <para style="p">
    <verse number="34" style="v"/>रे भुजगवंशा यूयमसाधवः सन्तः कथं साधु वाक्यं वक्तुं शक्ष्यथ? यस्माद् अन्तःकरणस्य पूर्णभावानुसाराद् वदनाद् वचो निर्गच्छति।</para>
  <para style="p">
    <verse number="35" style="v"/>तेन साधुर्मानवोऽन्तःकरणरूपात् साधुभाण्डागारात् साधु द्रव्यं निर्गमयति, असाधुर्मानुषस्त्वसाधुभाण्डागाराद् असाधुवस्तूनि निर्गमयति।</para>
  <para style="p">
    <verse number="36" style="v"/>किन्त्वहं युष्मान् वदामि, मनुजा यावन्त्यालस्यवचांसि वदन्ति, विचारदिने तदुत्तरमवश्यं दातव्यं,</para>
  <para style="p">
    <verse number="37" style="v"/>यतस्त्वं स्वीयवचोभि र्निरपराधः स्वीयवचोभिश्च सापराधो गणिष्यसे।</para>
  <para style="p">
    <verse number="38" style="v"/>तदानीं कतिपया उपाध्यायाः फिरूशिनश्च जगदुः, हे गुरो वयं भवत्तः किञ्चन लक्ष्म दिदृक्षामः।</para>
  <para style="p">
    <verse number="39" style="v"/>तदा स प्रत्युक्तवान्, दुष्टो व्यभिचारी च वंशो लक्ष्म मृगयते, किन्तु भविष्यद्वादिनो यूनसो लक्ष्म विहायान्यत् किमपि लक्ष्म ते न प्रदर्शयिष्यन्ते।</para>
  <para style="p">
    <verse number="40" style="v"/>यतो यूनम् यथा त्र्यहोरात्रं बृहन्मीनस्य कुक्षावासीत्, तथा मनुजपुत्रोपि त्र्यहोरात्रं मेदिन्या मध्ये स्थास्यति।</para>
  <para style="p">
    <verse number="41" style="v"/>अपरं नीनिवीया मानवा विचारदिन एतद्वंशीयानां प्रतिकूलम् उत्थाय तान् दोषिणः करिष्यन्ति, यस्मात्ते यूनस उपदेशात् मनांसि परावर्त्तयाञ्चक्रिरे, किन्त्वत्र यूनसोपि गुरुतर एक आस्ते।</para>
  <para style="p">
    <verse number="42" style="v"/>पुनश्च दक्षिणदेशीया राज्ञी विचारदिन एतद्वंशीयानां प्रतिकूलमुत्थाय तान् दोषिणः करिष्यति यतः सा राज्ञी सुलेमनो विद्यायाः कथां श्रोतुं मेदिन्याः सीम्न आगच्छत्, किन्तु सुलेमनोपि गुरुतर एको जनोऽत्र आस्ते।</para>
  <para style="p">
    <verse number="43" style="v"/>अपरं मनुजाद् बहिर्गतो ऽपवित्रभूतः शुष्कस्थानेन गत्वा विश्रामं गवेषयति, किन्तु तदलभमानः स वक्ति, यस्मा; निकेतनाद् आगमं, तदेव वेश्म पकावृत्य यामि।</para>
  <para style="p">
    <verse number="44" style="v"/>पश्चात् स तत् स्थानम् उपस्थाय तत् शून्यं मार्ज्जितं शोभितञ्च विलोक्य व्रजन् स्वतोपि दुष्टतरान् अन्यसप्तभूतान् सङ्गिनः करोति।</para>
  <para style="p">
    <verse number="45" style="v"/>ततस्ते तत् स्थानं प्रविश्य निवसन्ति, तेन तस्य मनुजस्य शेषदशा पूर्व्वदशातोतीवाशुभा भवति, एतेषां दुष्टवंश्यानामपि तथैव घटिष्यते।</para>
  <para style="p">
    <verse number="46" style="v"/>मानवेभ्य एतासां कथनां कथनकाले तस्य माता सहजाश्च तेन साकं काञ्चित् कथां कथयितुं वाञ्छन्तो बहिरेव स्थितवन्तः।</para>
  <para style="p">
    <verse number="47" style="v"/>ततः कश्चित् तस्मै कथितवान्, पश्य तव जननी सहजाश्च त्वया साकं काञ्चन कथां कथयितुं कामयमाना बहिस्तिष्ठन्ति।</para>
  <para style="p">
    <verse number="48" style="v"/>किन्तु स तं प्रत्यवदत्, मम का जननी? के वा मम सहजाः?</para>
  <para style="p">
    <verse number="49" style="v"/>पश्चात् शिष्यान् प्रति करं प्रसार्य्य कथितवान्, पश्य मम जननी मम सहजाश्चैते;</para>
  <para style="p">
    <verse number="50" style="v"/>यः कश्चित् मम स्वर्गस्थस्य पितुरिष्टं कर्म्म कुरुते, सएव मम भ्राता भगिनी जननी च।</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अपरञ्च तस्मिन् दिने यीशुः सद्मनो गत्वा सरित्पते रोधसि समुपविवेश।</para>
  <para style="p">
    <verse number="2" style="v"/>तत्र तत्सन्निधौ बहुजनानां निवहोपस्थितेः स तरणिमारुह्य समुपाविशत्, तेन मानवा रोधसि स्थितवन्तः।</para>
  <para style="p">
    <verse number="3" style="v"/>तदानीं स दृष्टान्तैस्तान् इत्थं बहुश उपदिष्टवान्। पश्यत, कश्चित् कृषीवलो बीजानि वप्तुं बहिर्जगाम,</para>
  <para style="p">
    <verse number="4" style="v"/>तस्य वपनकाले कतिपयबीजेषु मार्गपार्श्वे पतितेषु विहगास्तानि भक्षितवन्तः।</para>
  <para style="p">
    <verse number="5" style="v"/>अपरं कतिपयबीजेषु स्तोकमृद्युक्तपाषाणे पतितेषु मृदल्पत्वात् तत्क्षणात् तान्यङ्कुरितानि,</para>
  <para style="p">
    <verse number="6" style="v"/>किन्तु रवावुदिते दग्धानि तेषां मूलाप्रविष्टत्वात् शुष्कतां गतानि च।</para>
  <para style="p">
    <verse number="7" style="v"/>अपरं कतिपयबीजेषु कण्टकानां मध्ये पतितेषु कण्टकान्येधित्वा तानि जग्रसुः।</para>
  <para style="p">
    <verse number="8" style="v"/>अपरञ्च कतिपयबीजानि उर्व्वरायां पतितानि; तेषां मध्ये कानिचित् शतगुणानि कानिचित् षष्टिगुणानि कानिचित् त्रिंशगुंणानि फलानि फलितवन्ति।</para>
  <para style="p">
    <verse number="9" style="v"/>श्रोतुं यस्य श्रुती आसाते स शृणुयात्।</para>
  <para style="p">
    <verse number="10" style="v"/>अनन्तरं शिष्यैरागत्य सोऽपृच्छ्यत, भवता तेभ्यः कुतो दृष्टान्तकथा कथ्यते?</para>
  <para style="p">
    <verse number="11" style="v"/>ततः स प्रत्यवदत्, स्वर्गराज्यस्य निगूढां कथां वेदितुं युष्मभ्यं सामर्थ्यमदायि, किन्तु तेभ्यो नादायि।</para>
  <para style="p">
    <verse number="12" style="v"/>यस्माद् यस्यान्तिके वर्द्धते, तस्मायेव दायिष्यते, तस्मात् तस्य बाहुल्यं भविष्यति, किन्तु यस्यान्तिके न वर्द्धते, तस्य यत् किञ्चनास्ते, तदपि तस्माद् आदायिष्यते।</para>
  <para style="p">
    <verse number="13" style="v"/>ते पश्यन्तोपि न पश्यन्ति, शृण्वन्तोपि न शृण्वन्ति, बुध्यमाना अपि न बुध्यन्ते च, तस्मात् तेभ्यो दृष्टान्तकथा कथ्यते।</para>
  <para style="p">
    <verse number="14" style="v"/>यथा कर्णैः श्रोष्यथ यूयं वै किन्तु यूयं न भोत्स्यथ। नेत्रैर्द्रक्ष्यथ यूयञ्च परिज्ञातुं न शक्ष्यथ। ते मानुषा यथा नैव परिपश्यन्ति लोचनैः। कर्णै र्यथा न शृण्वन्ति न बुध्यन्ते च मानसैः। व्यावर्त्तितेषु चित्तेषु काले कुत्रापि तैर्जनैः। मत्तस्ते मनुजाः स्वस्था यथा नैव भवन्ति च। तथा तेषां मनुष्याणां क्रियन्ते स्थूलबुद्धयः। बधिरीभूतकर्णाश्च जाताश्च मुद्रिता दृशः।</para>
  <para style="p">
    <verse number="15" style="v"/>यदेतानि वचनानि यिशयियभविष्यद्वादिना प्रोक्तानि तेषु तानि फलन्ति।</para>
  <para style="p">
    <verse number="16" style="v"/>किन्तु युष्माकं नयनानि धन्यानि, यस्मात् तानि वीक्षन्ते; धन्याश्च युष्माकं शब्दग्रहाः, यस्मात् तैराकर्ण्यते।</para>
  <para style="p">
    <verse number="17" style="v"/>मया यूयं तथ्यं वचामि युष्माभि र्यद्यद् वीक्ष्यते, तद् बहवो भविष्यद्वादिनो धार्म्मिकाश्च मानवा दिदृक्षन्तोपि द्रष्टुं नालभन्त, पुनश्च यूयं यद्यत् शृणुथ, तत् ते शुश्रूषमाणा अपि श्रोतुं नालभन्त।</para>
  <para style="p">
    <verse number="18" style="v"/>कृषीवलीयदृष्टान्तस्यार्थं शृणुत।</para>
  <para style="p">
    <verse number="19" style="v"/>मार्गपार्श्वे बीजान्युप्तानि तस्यार्थ एषः, यदा कश्चित् राज्यस्य कथां निशम्य न बुध्यते, तदा पापात्मागत्य तदीयमनस उप्तां कथां हरन् नयति।</para>
  <para style="p">
    <verse number="20" style="v"/>अपरं पाषाणस्थले बीजान्युप्तानि तस्यार्थ एषः; कश्चित् कथां श्रुत्वैव हर्षचित्तेन गृह्लाति,</para>
  <para style="p">
    <verse number="21" style="v"/>किन्तु तस्य मनसि मूलाप्रविष्टत्वात् स किञ्चित्कालमात्रं स्थिरस्तिष्ठति; पश्चात तत्कथाकारणात् कोपि क्लेस्ताडना वा चेत् जायते, तर्हि स तत्क्षणाद् विघ्नमेति।</para>
  <para style="p">
    <verse number="22" style="v"/>अपरं कण्टकानां मध्ये बीजान्युप्तानि तदर्थ एषः; केनचित् कथायां श्रुतायां सांसारिकचिन्ताभि र्भ्रान्तिभिश्च सा ग्रस्यते, तेन सा मा विफला भवति।</para>
  <para style="p">
    <verse number="23" style="v"/>अपरम् उर्व्वरायां बीजान्युप्तानि तदर्थ एषः; ये तां कथां श्रुत्वा वुध्यन्ते, ते फलिताः सन्तः केचित् शतगुणानि केचित षष्टिगुणानि केचिच्च त्रिंशद्गुणानि फलानि जनयन्ति।</para>
  <para style="p">
    <verse number="24" style="v"/>अनन्तरं सोपरामेकां दृष्टान्तकथामुपस्थाप्य तेभ्यः कथयामास; स्वर्गीयराज्यं तादृशेन केनचिद् गृहस्थेनोपमीयते, येन स्वीयक्षेत्रे प्रशस्तबीजान्यौप्यन्त।</para>
  <para style="p">
    <verse number="25" style="v"/>किन्तु क्षणदायां सकललोकेषु सुप्तेषु तस्य रिपुरागत्य तेषां गोधूमबीजानां मध्ये वन्ययवमबीजान्युप्त्वा वव्राज।</para>
  <para style="p">
    <verse number="26" style="v"/>ततो यदा बीजेभ्योऽङ्करा जायमानाः कणिशानि घृतवन्तः; तदा वन्ययवसान्यपि दृश्यमानान्यभवन्।</para>
  <para style="p">
    <verse number="27" style="v"/>ततो गृहस्थस्य दासेया आगम्य तस्मै कथयाञ्चक्रुः, हे महेच्छ, भवता किं क्षेत्रे भद्रबीजानि नौप्यन्त? तथात्वे वन्ययवसानि कृत आयन्?</para>
  <para style="p">
    <verse number="28" style="v"/>तदानीं तेन ते प्रतिगदिताः, केनचित् रिपुणा कर्म्मदमकारि। दासेयाः कथयामासुः, वयं गत्वा तान्युत्पाय्य क्षिपामो भवतः कीदृशीच्छा जायते?</para>
  <para style="p">
    <verse number="29" style="v"/>तेनावादि, नहि, शङ्केऽहं वन्ययवसोत्पाटनकाले युष्माभिस्तैः साकं गोधूमा अप्युत्पाटिष्यन्ते।</para>
  <para style="p">
    <verse number="30" style="v"/>अतः श्स्यकर्त्तनकालं यावद् उभयान्यपि सह वर्द्धन्तां, पश्चात् कर्त्तनकाले कर्त्तकान् वक्ष्यामि, यूयमादौ वन्ययवसानि संगृह्य दाहयितुं वीटिका बद्व्वा स्थापयत; किन्तु सर्व्वे गोधूमा युष्माभि र्भाण्डागारं नीत्वा स्थाप्यन्ताम्।</para>
  <para style="p">
    <verse number="31" style="v"/>अनन्तरं सोपरामेकां दृष्टान्तकथामुत्थाप्य तेभ्यः कथितवान् कश्चिन्मनुजः सर्षपबीजमेकं नीत्वा स्वक्षेत्र उवाप।</para>
  <para style="p">
    <verse number="32" style="v"/>सर्षपबीजं सर्व्वस्माद् बीजात् क्षुद्रमपि सदङ्कुरितं सर्व्वस्मात् शाकात् बृहद् भवति; स तादृशस्तरु र्भवति, यस्य शाखासु नभसः खगा आगत्य निवसन्ति; स्वर्गीयराज्यं तादृशस्य सर्षपैकस्य समम्।</para>
  <para style="p">
    <verse number="33" style="v"/>पुनरपि स उपमाकथामेकां तेभ्यः कथयाञ्चकार; काचन योषित् यत् किण्वमादाय द्रोणत्रयमितगोधूमचूर्णानां मध्ये सर्व्वेषां मिश्रीभवनपर्य्यन्तं समाच्छाद्य निधत्तवती, तत्किण्वमिव स्वर्गराज्यं।</para>
  <para style="p">
    <verse number="34" style="v"/>इत्थं यीशु र्मनुजनिवहानां सन्निधावुपमाकथाभिरेतान्याख्यानानि कथितवान् उपमां विना तेभ्यः किमपि कथां नाकथयत्।</para>
  <para style="p">
    <verse number="35" style="v"/>एतेन दृष्टान्तीयेन वाक्येन व्यादाय वदनं निजं। अहं प्रकाशयिष्यामि गुप्तवाक्यं पुराभवं। यदेतद्वचनं भविष्यद्वादिना प्रोक्तमासीत्, तत् सिद्धमभवत्।</para>
  <para style="p">
    <verse number="36" style="v"/>सर्व्वान् मनुजान् विसृज्य यीशौ गृहं प्रविष्टे तच्छिष्या आगत्य यीशवे कथितवन्तः, क्षेत्रस्य वन्ययवसीयदृष्टान्तकथाम् भवान अस्मान् स्पष्टीकृत्य वदतु।</para>
  <para style="p">
    <verse number="37" style="v"/>ततः स प्रत्युवाच, येन भद्रबीजान्युप्यन्ते स मनुजपुत्रः,</para>
  <para style="p">
    <verse number="38" style="v"/>क्षेत्रं जगत्, भद्रबीजानी राज्यस्य सन्तानाः,</para>
  <para style="p">
    <verse number="39" style="v"/>वन्ययवसानि पापात्मनः सन्तानाः। येन रिपुणा तान्युप्तानि स शयतानः, कर्त्तनसमयश्च जगतः शेषः, कर्त्तकाः स्वर्गीयदूताः।</para>
  <para style="p">
    <verse number="40" style="v"/>यथा वन्ययवसानि संगृह्य दाह्यन्ते, तथा जगतः शेषे भविष्यति;</para>
  <para style="p">
    <verse number="41" style="v"/>अर्थात् मनुजसुतः स्वांयदूतान् प्रेषयिष्यति, तेन ते च तस्य राज्यात् सर्व्वान् विघ्नकारिणोऽधार्म्मिकलोकांश्च संगृह्य</para>
  <para style="p">
    <verse number="42" style="v"/>यत्र रोदनं दन्तघर्षणञ्च भवति, तत्राग्निकुण्डे निक्षेप्स्यन्ति।</para>
  <para style="p">
    <verse number="43" style="v"/>तदानीं धार्म्मिकलोकाः स्वेषां पितू राज्ये भास्करइव तेजस्विनो भविष्यन्ति। श्रोतुं यस्य श्रुती आसाते, म शृणुयात्।</para>
  <para style="p">
    <verse number="44" style="v"/>अपरञ्च क्षेत्रमध्ये निधिं पश्यन् यो गोपयति, ततः परं सानन्दो गत्वा स्वीयसर्व्वस्वं विक्रीय त्तक्षेत्रं क्रीणाति, स इव स्वर्गराज्यं।</para>
  <para style="p">
    <verse number="45" style="v"/>अन्यञ्च यो वणिक् उत्तमां मुक्तां गवेषयन्</para>
  <para style="p">
    <verse number="46" style="v"/>महार्घां मुक्तां विलोक्य निजसर्व्वस्वं विक्रीय तां क्रीणाति, स इव स्वर्गराज्यं।</para>
  <para style="p">
    <verse number="47" style="v"/>पुनश्च समुद्रो निक्षिप्तः सर्व्वप्रकारमीनसंग्राह्यानायइव स्वर्गराज्यं।</para>
  <para style="p">
    <verse number="48" style="v"/>तस्मिन् आनाये पूर्णे जना यथा रोधस्युत्तोल्य समुपविश्य प्रशस्तमीनान् संग्रह्य भाजनेषु निदधते, कुत्सितान् निक्षिपन्ति;</para>
  <para style="p">
    <verse number="49" style="v"/>तथैव जगतः शेषे भविष्यति, फलतः स्वर्गीयदूता आगत्य पुण्यवज्जनानां मध्यात् पापिनः पृथक् कृत्वा वह्निकुण्डे निक्षेप्स्यन्ति,</para>
  <para style="p">
    <verse number="50" style="v"/>तत्र रोदनं दन्तै र्दन्तघर्षणञ्च भविष्यतः।</para>
  <para style="p">
    <verse number="51" style="v"/>यीशुना ते पृष्टा युष्माभिः किमेतान्याख्यानान्यबुध्यन्त? तदा ते प्रत्यवदन्, सत्यं प्रभो।</para>
  <para style="p">
    <verse number="52" style="v"/>तदानीं स कथितवान्, निजभाण्डागारात् नवीनपुरातनानि वस्तूनि निर्गमयति यो गृहस्थः स इव स्वर्गराज्यमधि शिक्षिताः स्वर्व उपदेष्टारः।</para>
  <para style="p">
    <verse number="53" style="v"/>अनन्तरं यीशुरेताः सर्व्वा दृष्टान्तकथाः समाप्य तस्मात् स्थानात् प्रतस्थे। अपरं स्वदेशमागत्य जनान् भजनभवन उपदिष्टवान्;</para>
  <para style="p">
    <verse number="54" style="v"/>ते विस्मयं गत्वा कथितवन्त एतस्यैतादृशं ज्ञानम् आश्चर्य्यं कर्म्म च कस्माद् अजायत?</para>
  <para style="p">
    <verse number="55" style="v"/>किमयं सूत्रधारस्य पुत्रो नहि? एतस्य मातु र्नाम च किं मरियम् नहि? याकुब्-यूषफ्-शिमोन्-यिहूदाश्च किमेतस्य भ्रातरो नहि?</para>
  <para style="p">
    <verse number="56" style="v"/>एतस्य भगिन्यश्च किमस्माकं मध्ये न सन्ति? तर्हि कस्मादयमेतानि लब्धवान्? इत्थं स तेषां विघ्नरूपो बभूव;</para>
  <para style="p">
    <verse number="57" style="v"/>ततो यीशुना निगदितं स्वदेशीयजनानां मध्यं विना भविष्यद्वादी कुत्राप्यन्यत्र नासम्मान्यो भवती।</para>
  <para style="p">
    <verse number="58" style="v"/>तेषामविश्वासहेतोः स तत्र स्थाने बह्वाश्चर्य्यकर्म्माणि न कृतवान्।</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>तदानीं राजा हेरोद् यीशो र्यशः श्रुत्वा निजदासेयान् जगाद्,</para>
  <para style="p">
    <verse number="2" style="v"/>एष मज्जयिता योहन्, प्रमितेभयस्तस्योत्थानात् तेनेत्थमद्भुतं कर्म्म प्रकाश्यते।</para>
  <para style="p">
    <verse number="3" style="v"/>पुरा हेरोद् निजभ्रातु: फिलिपो जायाया हेरोदीयाया अनुरोधाद् योहनं धारयित्वा बद्धा कारायां स्थापितवान्।</para>
  <para style="p">
    <verse number="4" style="v"/>यतो योहन् उक्तवान्, एत्सयाः संग्रहो भवतो नोचितः।</para>
  <para style="p">
    <verse number="5" style="v"/>तस्मात् नृपतिस्तं हन्तुमिच्छन्नपि लोकेभ्यो विभयाञ्चकार; यतः सर्व्वे योहनं भविष्यद्वादिनं मेनिरे।</para>
  <para style="p">
    <verse number="6" style="v"/>किन्तु हेरोदो जन्माहीयमह उपस्थिते हेरोदीयाया दुहिता तेषां समक्षं नृतित्वा हेरोदमप्रीण्यत्।</para>
  <para style="p">
    <verse number="7" style="v"/>तस्मात् भूपतिः शपथं कुर्व्वन् इति प्रत्यज्ञासीत्, त्वया यद् याच्यते, तदेवाहं दास्यामि।</para>
  <para style="p">
    <verse number="8" style="v"/>सा कुमारी स्वीयमातुः शिक्षां लब्धा बभाषे, मज्जयितुर्योहन उत्तमाङ्गं भाजने समानीय मह्यं विश्राणय।</para>
  <para style="p">
    <verse number="9" style="v"/>ततो राजा शुशोच, किन्तु भोजनायोपविशतां सङ्गिनां स्वकृतशपथस्य चानुरोधात् तत् प्रदातुम आदिदेश।</para>
  <para style="p">
    <verse number="10" style="v"/>पश्चात् कारां प्रति नरं प्रहित्य योहन उत्तमाङ्गं छित्त्वा</para>
  <para style="p">
    <verse number="11" style="v"/>तत् भाजन आनाय्य तस्यै कुमार्य्यै व्यश्राणयत्, ततः सा स्वजनन्याः समीपं तन्निनाय।</para>
  <para style="p">
    <verse number="12" style="v"/>पश्चात् योहनः शिष्या आगत्य कायं नीत्वा श्मशाने स्थापयामासुस्ततो यीशोः सन्निधिं व्रजित्वा तद्वार्त्तां बभाषिरे।</para>
  <para style="p">
    <verse number="13" style="v"/>अनन्तरं यीशुरिति निशभ्य नावा निर्जनस्थानम् एकाकी गतवान्, पश्चात् मानवास्तत् श्रुत्वा नानानगरेभ्य आगत्य पदैस्तत्पश्चाद् ईयुः।</para>
  <para style="p">
    <verse number="14" style="v"/>तदानीं यीशु र्बहिरागत्य महान्तं जननिवहं निरीक्ष्य तेषु कारुणिकः मन् तेषां पीडितजनान् निरामयान् चकार।</para>
  <para style="p">
    <verse number="15" style="v"/>ततः परं सन्ध्यायां शिष्यास्तदन्तिकमागत्य कथयाञ्चक्रुः, इदं निर्जनस्थानं वेलाप्यवसन्ना; तस्मात् मनुजान् स्वस्वग्रामं गन्तुं स्वार्थं भक्ष्याणि क्रेतुञ्च भवान् तान् विसृजतु।</para>
  <para style="p">
    <verse number="16" style="v"/>किन्तु यीशुस्तानवादीत्, तेषां गमने प्रयोजनं नास्ति, यूयमेव तान् भोजयत।</para>
  <para style="p">
    <verse number="17" style="v"/>तदा ते प्रत्यवदन्, अस्माकमत्र पूपपञ्चकं मीनद्वयञ्चास्ते।</para>
  <para style="p">
    <verse number="18" style="v"/>तदानीं तेनोक्तं तानि मदन्तिकमानयत।</para>
  <para style="p">
    <verse number="19" style="v"/>अनन्तरं स मनुजान् यवसोपर्य्युपवेष्टुम् आज्ञापयामास; अपर तत् पूपपञ्चकं मीनद्वयञ्च गृह्लन् स्वर्गं प्रति निरीक्ष्येश्वरीयगुणान् अनूद्य भंक्त्वा शिष्येभ्यो दत्तवान्, शिष्याश्च लोकेभ्यो ददुः।</para>
  <para style="p">
    <verse number="20" style="v"/>ततः सर्व्वे भुक्त्वा परितृप्तवन्तः, ततस्तदवशिष्टभक्ष्यैः पूर्णान् द्वादशडलकान् गृहीतवन्तः।</para>
  <para style="p">
    <verse number="21" style="v"/>ते भोक्तारः स्त्रीर्बालकांश्च विहाय प्रायेण पञ्च सहस्राणि पुमांस आसन्।</para>
  <para style="p">
    <verse number="22" style="v"/>तदनन्तरं यीशु र्लोकानां विसर्जनकाले शिष्यान् तरणिमारोढुं स्वाग्रे पारं यातुञ्च गाढमादिष्टवान्।</para>
  <para style="p">
    <verse number="23" style="v"/>ततो लोकेषु विसृष्टेषु स विविक्ते प्रार्थयितुं गिरिमेकं गत्वा सन्ध्यां यावत् तत्रैकाकी स्थितवान्।</para>
  <para style="p">
    <verse number="24" style="v"/>किन्तु तदानीं सम्मुखवातत्वात् सरित्पते र्मध्ये तरङ्गैस्तरणिर्दोलायमानाभवत्।</para>
  <para style="p">
    <verse number="25" style="v"/>तदा स यामिन्याश्चतुर्थप्रहरे पद्भ्यां व्रजन् तेषामन्तिकं गतवान्।</para>
  <para style="p">
    <verse number="26" style="v"/>किन्तु शिष्यास्तं सागरोपरि व्रजन्तं विलोक्य समुद्विग्ना जगदुः, एष भूत इति शङ्कमाना उच्चैः शब्दायाञ्चक्रिरे च।</para>
  <para style="p">
    <verse number="27" style="v"/>तदैव यीशुस्तानवदत्, सुस्थिरा भवत, मा भैष्ट, एषोऽहम्।</para>
  <para style="p">
    <verse number="28" style="v"/>ततः पितर इत्युक्तवान्, हे प्रभो, यदि भवानेव, तर्हि मां भवत्समीपं यातुमाज्ञापयतु।</para>
  <para style="p">
    <verse number="29" style="v"/>ततः तेनादिष्टः पितरस्तरणितोऽवरुह्य यीशेारन्तिकं प्राप्तुं तोयोपरि वव्राज।</para>
  <para style="p">
    <verse number="30" style="v"/>किन्तु प्रचण्डं पवनं विलोक्य भयात् तोये मंक्तुम् आरेभे, तस्माद् उच्चैः शब्दायमानः कथितवान्, हे प्रभो, मामवतु।</para>
  <para style="p">
    <verse number="31" style="v"/>यीशुस्तत्क्षणात् करं प्रसार्य्य तं धरन् उक्तवान्, ह स्तोकप्रत्ययिन् त्वं कुतः समशेथाः?</para>
  <para style="p">
    <verse number="32" style="v"/>अनन्तरं तयोस्तरणिमारूढयोः पवनो निववृते।</para>
  <para style="p">
    <verse number="33" style="v"/>तदानीं ये तरण्यामासन्, त आगत्य तं प्रणभ्य कथितवन्तः, यथार्थस्त्वमेवेश्वरसुतः।</para>
  <para style="p">
    <verse number="34" style="v"/>अनन्तरं पारं प्राप्य ते गिनेषरन्नामकं नगरमुपतस्थुः,</para>
  <para style="p">
    <verse number="35" style="v"/>तदा तत्रत्या जना यीशुं परिचीय तद्देश्स्य चतुर्दिशो वार्त्तां प्रहित्य यत्र यावन्तः पीडिता आसन्, तावतएव तदन्तिकमानयामासुः।</para>
  <para style="p">
    <verse number="36" style="v"/>अपरं तदीयवसनस्य ग्रन्थिमात्रं स्प्रष्टुं विनीय यावन्तो जनास्तत् स्पर्शं चक्रिरे, ते सर्व्वएव निरामया बभूवुः।</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अपरं यिरूशालम्नगरीयाः कतिपया अध्यापकाः फिरूशिनश्च यीशोः समीपमागत्य कथयामासुः,</para>
  <para style="p">
    <verse number="2" style="v"/>तव शिष्याः किमर्थम् अप्रक्षालितकरै र्भक्षित्वा परम्परागतं प्राचीनानां व्यवहारं लङ्वन्ते?</para>
  <para style="p">
    <verse number="3" style="v"/>ततो यीशुः प्रत्युवाच, यूयं परम्परागताचारेण कुत ईश्वराज्ञां लङ्वध्वे।</para>
  <para style="p">
    <verse number="4" style="v"/>ईश्वर इत्याज्ञापयत्, त्वं निजपितरौ संमन्येथाः, येन च निजपितरौ निन्द्येते, स निश्चितं म्रियेत;</para>
  <para style="p">
    <verse number="5" style="v"/>किन्तु यूयं वदथ, यः स्वजनकं स्वजननीं वा वाक्यमिदं वदति, युवां मत्तो यल्लभेथे, तत् न्यविद्यत,</para>
  <para style="p">
    <verse number="6" style="v"/>स निजपितरौ पुन र्न संमंस्यते। इत्थं यूयं परम्परागतेन स्वेषामाचारेणेश्वरीयाज्ञां लुम्पथ।</para>
  <para style="p">
    <verse number="7" style="v"/>रे कपटिनः सर्व्वे यिशयियो युष्मानधि भविष्यद्वचनान्येतानि सम्यग् उक्तवान्।</para>
  <para style="p">
    <verse number="8" style="v"/>वदनै र्मनुजा एते समायान्ति मदन्तिकं। तथाधरै र्मदीयञ्च मानं कुर्व्वन्ति ते नराः।</para>
  <para style="p">
    <verse number="9" style="v"/>किन्तु तेषां मनो मत्तो विदूरएव तिष्ठति। शिक्षयन्तो विधीन् न्राज्ञा भजन्ते मां मुधैव ते।</para>
  <para style="p">
    <verse number="10" style="v"/>ततो यीशु र्लोकान् आहूय प्रोक्तवान्, यूयं श्रुत्वा बुध्यध्बं।</para>
  <para style="p">
    <verse number="11" style="v"/>यन्मुखं प्रविशति, तत् मनुजम् अमेध्यं न करोति, किन्तु यदास्यात् निर्गच्छति, तदेव मानुषममेध्यी करोती।</para>
  <para style="p">
    <verse number="12" style="v"/>तदानीं शिष्या आगत्य तस्मै कथयाञ्चक्रुः, एतां कथां श्रुत्वा फिरूशिनो व्यरज्यन्त, तत् किं भवता ज्ञायते?</para>
  <para style="p">
    <verse number="13" style="v"/>स प्रत्यवदत्, मम स्वर्गस्थः पिता यं कञ्चिदङ्कुरं नारोपयत्, स उत्पाव्द्यते।</para>
  <para style="p">
    <verse number="14" style="v"/>ते तिष्ठन्तु, ते अन्धमनुजानाम् अन्धमार्गदर्शका एव; यद्यन्धोऽन्धं पन्थानं दर्शयति, तर्ह्युभौ गर्त्ते पततः।</para>
  <para style="p">
    <verse number="15" style="v"/>तदा पितरस्तं प्रत्यवदत्, दृष्टान्तमिममस्मान् बोधयतु।</para>
  <para style="p">
    <verse number="16" style="v"/>यीशुना प्रोक्तं, यूयमद्य यावत् किमबोधाः स्थ?</para>
  <para style="p">
    <verse number="17" style="v"/>कथामिमां किं न बुध्यध्बे ? यदास्यं प्रेविशति, तद् उदरे पतन् बहिर्निर्याति,</para>
  <para style="p">
    <verse number="18" style="v"/>किन्त्वास्याद् यन्निर्याति, तद् अन्तःकरणात् निर्यातत्वात् मनुजममेध्यं करोति।</para>
  <para style="p">
    <verse number="19" style="v"/>यतोऽन्तःकरणात् कुचिन्ता बधः पारदारिकता वेश्यागमनं चैर्य्यं मिथ्यासाक्ष्यम् ईश्वरनिन्दा चैतानि सर्व्वाणि निर्य्यान्ति।</para>
  <para style="p">
    <verse number="20" style="v"/>एतानि मनुष्यमपवित्री कुर्व्वन्ति किन्त्वप्रक्षालितकरेण भोजनं मनुजममेध्यं न करोति।</para>
  <para style="p">
    <verse number="21" style="v"/>अनन्तरं यीशुस्तस्मात् स्थानात् प्रस्थाय सोरसीदोन्नगरयोः सीमामुपतस्यौ।</para>
  <para style="p">
    <verse number="22" style="v"/>तदा तत्सीमातः काचित् किनानीया योषिद् आगत्य तमुच्चैरुवाच, हे प्रभो दायूदः सन्तान, ममैका दुहितास्ते सा भूतग्रस्ता सती महाक्लेशं प्राप्नोति मम दयस्व।</para>
  <para style="p">
    <verse number="23" style="v"/>किन्तु यीशुस्तां किमपि नोक्तवान्, ततः शिष्या आगत्य तं निवेदयामासुः, एषा योषिद् अस्माकं पश्चाद् उच्चैराहूयागच्छति, एनां विसृजतु।</para>
  <para style="p">
    <verse number="24" style="v"/>तदा स प्रत्यवदत्, इस्रायेल्गोत्रस्य हारितमेषान् विना कस्याप्यन्यस्य समीपं नाहं प्रेषितोस्मि।</para>
  <para style="p">
    <verse number="25" style="v"/>ततः सा नारीसमागत्य तं प्रणम्य जगाद, हे प्रभो मामुपकुरु।</para>
  <para style="p">
    <verse number="26" style="v"/>स उक्तवान्, बालकानां भक्ष्यमादाय सारमेयेभ्यो दानं नोचितं।</para>
  <para style="p">
    <verse number="27" style="v"/>तदा सा बभाषे, हे प्रभो, तत् सत्यं, तथापि प्रभो र्भञ्चाद् यदुच्छिष्टं पतति, तत् सारमेयाः खादन्ति।</para>
  <para style="p">
    <verse number="28" style="v"/>ततो यीशुः प्रत्यवदत्, हे योषित्, तव विश्वासो महान् तस्मात् तव मनोभिलषितं सिद्य्यतु, तेन तस्याः कन्या तस्मिन्नेव दण्डे निरामयाभवत्।</para>
  <para style="p">
    <verse number="29" style="v"/>अनन्तरं यीशस्तस्मात् स्थानात् प्रस्थाय गालील्सागरस्य सन्निधिमागत्य धराधरमारुह्य तत्रोपविवेश।</para>
  <para style="p">
    <verse number="30" style="v"/>पश्चात् जननिवहो बहून् खञ्चान्धमूकशुष्ककरमानुषान् आदाय यीशोः समीपमागत्य तच्चरणान्तिके स्थापयामासुः, ततः सा तान् निरामयान् अकरोत्।</para>
  <para style="p">
    <verse number="31" style="v"/>इत्थं मूका वाक्यं वदन्ति, शुष्ककराः स्वास्थ्यमायान्ति, पङ्गवो गच्छन्ति, अन्धा वीक्षन्ते, इति विलोक्य लोका विस्मयं मन्यमाना इस्रायेल ईश्वरं धन्यं बभाषिरे।</para>
  <para style="p">
    <verse number="32" style="v"/>तदानीं यीशुः स्वशिष्यान् आहूय गदितवान्, एतज्जननिवहेषु मम दया जायते, एते दिनत्रयं मया साकं सन्ति, एषां भक्ष्यवस्तु च कञ्चिदपि नास्ति, तस्मादहमेतानकृताहारान् न विस्रक्ष्यामि, तथात्वे वर्त्ममध्ये क्लाम्येषुः।</para>
  <para style="p">
    <verse number="33" style="v"/>तदा शिष्या ऊचुः, एतस्मिन् प्रान्तरमध्य एतावतो मर्त्यान् तर्पयितुं वयं कुत्र पूपान् प्राप्स्यामः?</para>
  <para style="p">
    <verse number="34" style="v"/>यीशुरपृच्छत्, युष्माकं निकटे कति पूपा आसते? त ऊचुः, सप्तपूपा अल्पाः क्षुद्रमीनाश्च सन्ति।</para>
  <para style="p">
    <verse number="35" style="v"/>तदानीं स लोकनिवहं भूमावुपवेष्टुम् आदिश्य</para>
  <para style="p">
    <verse number="36" style="v"/>तान् सप्तपूपान् मीनांश्च गृह्लन् ईश्वरीयगुणान् अनूद्य भंक्त्वा शिष्येभ्यो ददौ, शिष्या लोकेभ्यो ददुः।</para>
  <para style="p">
    <verse number="37" style="v"/>ततः सर्व्वे भुक्त्वा तृप्तवन्तः; तदवशिष्टभक्ष्येण सप्तडलकान् परिपूर्य्य संजगृहुः।</para>
  <para style="p">
    <verse number="38" style="v"/>ते भोक्तारो योषितो बालकांश्च विहाय प्रायेण चतुःसहस्राणि पुरुषा आसन्।</para>
  <para style="p">
    <verse number="39" style="v"/>ततः परं स जननिवहं विसृज्य तरिमारुह्य मग्दलाप्रदेशं गतवान्।</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>तदानीं फिरूशिनः सिदूकिनश्चागत्य तं परीक्षितुं नभमीयं किञ्चन लक्ष्म दर्शयितुं तस्मै निवेदयामासुः।</para>
  <para style="p">
    <verse number="2" style="v"/>ततः स उक्तवान्, सन्ध्यायां नभसो रक्तत्वाद् यूयं वदथ, श्वो निर्म्मलं दिनं भविष्यति;</para>
  <para style="p">
    <verse number="3" style="v"/>प्रातःकाले च नभसो रक्तत्वात् मलिनत्वाञ्च वदथ, झञ्भ्शद्य भविष्यति। हे कपटिनो यदि यूयम् अन्तरीक्षस्य लक्ष्म बोद्धुं शक्नुथ, तर्हि कालस्यैतस्य लक्ष्म कथं बोद्धुं न शक्नुथ?</para>
  <para style="p">
    <verse number="4" style="v"/>एतत्कालस्य दुष्टो व्यभिचारी च वंशो लक्ष्म गवेषयति, किन्तु यूनसो भविष्यद्वादिनो लक्ष्म विनान्यत् किमपि लक्ष्म तान् न दर्शयिय्यते। तदानीं स तान् विहाय प्रतस्थे।</para>
  <para style="p">
    <verse number="5" style="v"/>अनन्तरमन्यपारगमनकाले तस्य शिष्याः पूपमानेतुं विस्मृतवन्तः।</para>
  <para style="p">
    <verse number="6" style="v"/>यीशुस्तानवादीत्, यूयं फिरूशिनां सिदूकिनाञ्च किण्वं प्रति सावधानाः सतर्काश्च भवत।</para>
  <para style="p">
    <verse number="7" style="v"/>तेन ते परस्परं विविच्य कथयितुमारेभिरे, वयं पूपानानेतुं विस्मृतवन्त एतत्कारणाद् इति कथयति।</para>
  <para style="p">
    <verse number="8" style="v"/>किन्तु यीशुस्तद्विज्ञाय तानवोचत्, हे स्तोकविश्वासिनो यूयं पूपानानयनमधि कुतः परस्परमेतद् विविंक्य?</para>
  <para style="p">
    <verse number="9" style="v"/>युष्माभिः किमद्यापि न ज्ञायते? पञ्चभिः पूपैः पञ्चसहस्रपुरुषेषु भोजितेषु भक्ष्योच्छिष्टपूर्णान् कति डलकान् समगृह्लीतं;</para>
  <para style="p">
    <verse number="10" style="v"/>तथा सप्तभिः पूपैश्चतुःसहस्रपुरुषेषु भेजितेषु कति डलकान् समगृह्लीत, तत् किं युष्माभिर्न स्मर्य्यते?</para>
  <para style="p">
    <verse number="11" style="v"/>तस्मात् फिरूशिनां सिदूकिनाञ्च किण्वं प्रति सावधानास्तिष्ठत, कथामिमाम् अहं पूपानधि नाकथयं, एतद् यूयं कुतो न बुध्यध्वे?</para>
  <para style="p">
    <verse number="12" style="v"/>तदानीं पूपकिण्वं प्रति सावधानास्तिष्ठतेति नोक्त्वा फिरूशिनां सिदूकिनाञ्च उपदेशं प्रति सावधानास्तिष्ठतेति कथितवान्, इति तैरबोधि।</para>
  <para style="p">
    <verse number="13" style="v"/>अपरञ्च यीशुः कैसरिया-फिलिपिप्रदेशमागत्य शिष्यान् अपृच्छत्, योऽहं मनुजसुतः सोऽहं कः? लोकैरहं किमुच्ये?</para>
  <para style="p">
    <verse number="14" style="v"/>तदानीं ते कथितवन्तः, केचिद् वदन्ति त्वं मज्जयिता योहन्, केचिद्वदन्ति, त्वम् एलियः, केचिच्च वदन्ति, त्वं यिरिमियो वा कश्चिद् भविष्यद्वादीति।</para>
  <para style="p">
    <verse number="15" style="v"/>पश्चात् स तान् पप्रच्छ, यूयं मां कं वदथ? ततः शिमोन् पितर उवाच,</para>
  <para style="p">
    <verse number="16" style="v"/>त्वममरेश्वरस्याभिषिक्तपुत्रः।</para>
  <para style="p">
    <verse number="17" style="v"/>ततो यीशुः कथितवान्, हे यूनसः पुत्र शिमोन् त्वं धन्यः; यतः कोपि अनुजस्त्वय्येतज्ज्ञानं नोदपादयत्, किन्तु मम स्वर्गस्यः पितोदपादयत्।</para>
  <para style="p">
    <verse number="18" style="v"/>अतोऽहं त्वां वदामि, त्वं पितरः (प्रस्तरः) अहञ्च तस्य प्रस्तरस्योपरि स्वमण्डलीं निर्म्मास्यामि, तेन निरयो बलात् तां पराजेतुं न शक्ष्यति।</para>
  <para style="p">
    <verse number="19" style="v"/>अहं तुभ्यं स्वर्गीयराज्यस्य कुञ्जिकां दास्यामि, तेन यत् किञ्चन त्वं पृथिव्यां भंत्स्यसि तत्स्वर्गे भंत्स्यते, यच्च किञ्चन मह्यां मोक्ष्यसि तत् स्वर्गे मोक्ष्यते।</para>
  <para style="p">
    <verse number="20" style="v"/>पश्चात् स शिष्यानादिशत्, अहमभिषिक्तो यीशुरिति कथां कस्मैचिदपि यूयं मा कथयत।</para>
  <para style="p">
    <verse number="21" style="v"/>अन्यञ्च यिरूशालम्नगरं गत्वा प्राचीनलोकेभ्यः प्रधानयाजकेभ्य उपाध्यायेभ्यश्च बहुदुःखभोगस्तै र्हतत्वं तृतीयदिने पुनरुत्थानञ्च ममावश्यकम् एताः कथा यीशुस्तत्कालमारभ्य शिष्यान् ज्ञापयितुम् आरब्धवान्।</para>
  <para style="p">
    <verse number="22" style="v"/>तदानीं पितरस्तस्य करं घृत्वा तर्जयित्वा कथयितुमारब्धवान्, हे प्रभो, तत् त्वत्तो दूरं यातु, त्वां प्रति कदापि न घटिष्यते।</para>
  <para style="p">
    <verse number="23" style="v"/>किन्तु स वदनं परावर्त्य पितरं जगाद, हे विघ्नकारिन्, मत्सम्मुखाद् दूरीभव, त्वं मां बाधसे, ईश्वरीयकार्य्यात् मानुषीयकार्य्यं तुभ्यं रोचते।</para>
  <para style="p">
    <verse number="24" style="v"/>अनन्तरं यीशुः स्वीयशिष्यान् उक्तवान् यः कश्चित् मम पश्चाद्गामी भवितुम् इच्छति, स स्वं दाम्यतु, तथा स्वक्रुशं गृह्लन् मत्पश्चादायातु।</para>
  <para style="p">
    <verse number="25" style="v"/>यतो यः प्राणान् रक्षितुमिच्छति, स तान् हारयिष्यति, किन्तु यो मदर्थं निजप्राणान् हारयति, स तान् प्राप्स्यति।</para>
  <para style="p">
    <verse number="26" style="v"/>मानुषो यदि सर्व्वं जगत् लभते निजप्रणान् हारयति, तर्हि तस्य को लाभः? मनुजो निजप्राणानां विनिमयेन वा किं दातुं शक्नोति?</para>
  <para style="p">
    <verse number="27" style="v"/>मनुजसुतः स्वदूतैः साकं पितुः प्रभावेणागमिष्यति; तदा प्रतिमनुजं स्वस्वकर्म्मानुसारात् फलं दास्यति।</para>
  <para style="p">
    <verse number="28" style="v"/>अहं युष्मान् तथ्यं वच्मि, सराज्यं मनुजसुतम् आगतं न पश्यन्तो मृत्युं न स्वादिष्यन्ति, एतादृशाः कतिपयजना अत्रापि दण्डायमानाः सन्ति।</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अनन्तरं षड्दिनेभ्यः परं यीशुः पितरं याकूबं तत्सहजं योहनञ्च गृह्लन् उच्चाद्रे र्विविक्तस्थानम् आगत्य तेषां समक्षं रूपमन्यत् दधार।</para>
  <para style="p">
    <verse number="2" style="v"/>तेन तदास्यं तेजस्वि, तदाभरणम् आलोकवत् पाण्डरमभवत्।</para>
  <para style="p">
    <verse number="3" style="v"/>अन्यच्च तेन साकं संलपन्तौ मूसा एलियश्च तेभ्यो दर्शनं ददतुः।</para>
  <para style="p">
    <verse number="4" style="v"/>तदानीं पितरो यीशुं जगाद, हे प्रभो स्थितिरत्रास्माकं शुभा, यदि भवतानुमन्यते, तर्हि भवदर्थमेकं मूसार्थमेकम् एलियार्थञ्चैकम् इति त्रीणि दूष्याणि निर्म्मम।</para>
  <para style="p">
    <verse number="5" style="v"/>एतत्कथनकाल एक उज्जवलः पयोदस्तेषामुपरि छायां कृतवान्, वारिदाद् एषा नभसीया वाग् बभूव, ममायं प्रियः पुत्रः, अस्मिन् मम महासन्तोष एतस्य वाक्यं यूयं निशामयत।</para>
  <para style="p">
    <verse number="6" style="v"/>किन्तु वाचमेतां शृण्वन्तएव शिष्या मृशं शङ्कमाना न्युब्जा न्यपतन्।</para>
  <para style="p">
    <verse number="7" style="v"/>तदा यीशुरागत्य तेषां गात्राणि स्पृशन् उवाच, उत्तिष्ठत, मा भैष्ट।</para>
  <para style="p">
    <verse number="8" style="v"/>तदानीं नेत्राण्युन्मील्य यीशुं विना कमपि न ददृशुः।</para>
  <para style="p">
    <verse number="9" style="v"/>ततः परम् अद्रेरवरोहणकाले यीशुस्तान् इत्यादिदेश, मनुजसुतस्य मृतानां मध्यादुत्थानं यावन्न जायते, तावत् युष्माभिरेतद्दर्शनं कस्मैचिदपि न कथयितव्यं।</para>
  <para style="p">
    <verse number="10" style="v"/>तदा शिष्यास्तं पप्रच्छुः, प्रथमम् एलिय आयास्यतीति कुत उपाध्यायैरुच्यते?</para>
  <para style="p">
    <verse number="11" style="v"/>ततो यीशुः प्रत्यवादीत्, एलियः प्रागेत्य सर्व्वाणि साधयिष्यतीति सत्यं,</para>
  <para style="p">
    <verse number="12" style="v"/>किन्त्वहं युष्मान् वच्मि, एलिय एत्य गतः, ते तमपरिचित्य तस्मिन् यथेच्छं व्यवजहुः; मनुजसुतेनापि तेषामन्तिके तादृग् दुःखं भोक्तव्यं।</para>
  <para style="p">
    <verse number="13" style="v"/>तदानीं स मज्जयितारं योहनमधि कथामेतां व्याहृतवान्, इत्थं तच्छिष्या बुबुधिरे।</para>
  <para style="p">
    <verse number="14" style="v"/>पश्चात् तेषु जननिवहस्यान्तिकमागतेषु कश्चित् मनुजस्तदन्तिकमेत्य जानूनी पातयित्वा कथितवान्,</para>
  <para style="p">
    <verse number="15" style="v"/>हे प्रभो, मत्पुत्रं प्रति कृपां विदधातु, सोपस्मारामयेन भृशं व्यथितः सन् पुनः पुन र्वह्नौ मुहु र्जलमध्ये पतति।</para>
  <para style="p">
    <verse number="16" style="v"/>तस्माद् भवतः शिष्याणां समीपे तमानयं किन्तु ते तं स्वास्थं कर्त्तुं न शक्ताः।</para>
  <para style="p">
    <verse number="17" style="v"/>तदा यीशुः कथितवान् रे अविश्वासिनः, रे विपथगामिनः, पुनः कतिकालान् अहं युष्माकं सन्निधौ स्थास्यामि? कतिकालान् वा युष्मान् सहिष्ये? तमत्र ममान्तिकमानयत।</para>
  <para style="p">
    <verse number="18" style="v"/>पश्चाद् यीशुना तर्जतएव स भूतस्तं विहाय गतवान्, तद्दण्डएव स बालको निरामयोऽभूत्।</para>
  <para style="p">
    <verse number="19" style="v"/>ततः शिष्या गुप्तं यीशुमुपागत्य बभाषिरे, कुतो वयं तं भूतं त्याजयितुं न शक्ताः?</para>
  <para style="p">
    <verse number="20" style="v"/>यीशुना ते प्रोक्ताः, युष्माकमप्रत्ययात्;</para>
  <para style="p">
    <verse number="21" style="v"/>युष्मानहं तथ्यं वच्मि यदि युष्माकं सर्षपैकमात्रोपि विश्वासो जायते, तर्हि युष्माभिरस्मिन् शैले त्वमितः स्थानात् तत् स्थानं याहीति ब्रूते स तदैव चलिष्यति, युष्माकं किमप्यसाध्यञ्च कर्म्म न स्थास्याति। किन्तु प्रार्थनोपवासौ विनैतादृशो भूतो न त्याज्येत।</para>
  <para style="p">
    <verse number="22" style="v"/>अपरं तेषां गालील्प्रदेशे भ्रमणकाले यीशुना ते गदिताः, मनुजसुतो जनानां करेषु समर्पयिष्यते तै र्हनिष्यते च,</para>
  <para style="p">
    <verse number="23" style="v"/>किन्तु तृतीयेऽहि्न म उत्थापिष्यते, तेन ते भृशं दुःखिता बभूवः।</para>
  <para style="p">
    <verse number="24" style="v"/>तदनन्तरं तेषु कफर्नाहूम्नगरमागतेषु करसंग्राहिणः पितरान्तिकमागत्य पप्रच्छुः, युष्माकं गुरुः किं मन्दिरार्थं करं न ददाति? ततः पितरः कथितवान् ददाति।</para>
  <para style="p">
    <verse number="25" style="v"/>ततस्तस्मिन् गृहमध्यमागते तस्य कथाकथनात् पूर्व्वमेव यीशुरुवाच, हे शिमोन्, मेदिन्या राजानः स्वस्वापत्येभ्यः किं विदेशिभ्यः केभ्यः करं गृह्लन्ति? अत्र त्वं किं बुध्यसे? ततः पितर उक्तवान्, विदेशिभ्यः।</para>
  <para style="p">
    <verse number="26" style="v"/>तदा यीशुरुक्तवान्, तर्हि सन्ताना मुक्ताः सन्ति।</para>
  <para style="p">
    <verse number="27" style="v"/>तथापि यथास्माभिस्तेषामन्तरायो न जन्यते, तत्कृते जलधेस्तीरं गत्वा वडिशं क्षिप, तेनादौ यो मीन उत्थास्यति, तं घृत्वा तन्मुखे मोचिते तोलकैकं रूप्यं प्राप्स्यसि, तद् गृहीत्वा तव मम च कृते तेभ्यो देहि।</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>तदानीं शिष्या यीशोः समीपमागत्य पृष्टवन्तः स्वर्गराज्ये कः श्रेष्ठः?</para>
  <para style="p">
    <verse number="2" style="v"/>ततो यीशुः क्षुद्रमेकं बालकं स्वसमीपमानीय तेषां मध्ये निधाय जगाद,</para>
  <para style="p">
    <verse number="3" style="v"/>युष्मानहं सत्यं ब्रवीमि, यूयं मनोविनिमयेन क्षुद्रबालवत् न सन्तः स्वर्गराज्यं प्रवेष्टुं न शक्नुथ।</para>
  <para style="p">
    <verse number="4" style="v"/>यः कश्चिद् एतस्य क्षुद्रबालकस्य सममात्मानं नम्रीकरोति, सएव स्वर्गराजये श्रेष्ठः।</para>
  <para style="p">
    <verse number="5" style="v"/>यः कश्चिद् एतादृशं क्षुद्रबालकमेकं मम नाम्नि गृह्लाति, स मामेव गृह्लाति।</para>
  <para style="p">
    <verse number="6" style="v"/>किन्तु यो जनो मयि कृतविश्वासानामेतेषां क्षुद्रप्राणिनाम् एकस्यापि विध्निं जनयति, कण्ठबद्धपेषणीकस्य तस्य सागरागाधजले मज्जनं श्रेयः।</para>
  <para style="p">
    <verse number="7" style="v"/>विघ्नात् जगतः सन्तापो भविष्यति, विघ्नोऽवश्यं जनयिष्यते, किन्तु येन मनुजेन विघ्नो जनिष्यते तस्यैव सन्तापो भविष्यति।</para>
  <para style="p">
    <verse number="8" style="v"/>तस्मात् तव करश्चरणो वा यदि त्वां बाधते, तर्हि तं छित्त्वा निक्षिप, द्विकरस्य द्विपदस्य वा तवानप्तवह्नौ निक्षेपात्, खञ्जस्य वा छिन्नहस्तस्य तव जीवने प्रवेशो वरं।</para>
  <para style="p">
    <verse number="9" style="v"/>अपरं तव नेत्रं यदि त्वां बाधते, तर्हि तदप्युत्पाव्य निक्षिप, द्विनेत्रस्य नरकाग्नौ निक्षेपात् काणस्य तव जीवने प्रवेशो वरं।</para>
  <para style="p">
    <verse number="10" style="v"/>तस्मादवधद्धं, एतेषां क्षुद्रप्राणिनाम् एकमपि मा तुच्छीकुरुत,</para>
  <para style="p">
    <verse number="11" style="v"/>यतो युष्मानहं तथ्यं ब्रवीमि, स्वर्गे तेषां दूता मम स्वर्गस्थस्य पितुरास्यं नित्यं पश्यन्ति। एवं ये ये हारितास्तान् रक्षितुं मनुजपुत्र आगच्छत्।</para>
  <para style="p">
    <verse number="12" style="v"/>यूयमत्र किं विविंग्घ्वे? कस्यचिद् यदि शतं मेषाः सन्ति, तेषामेको हार्य्यते च, तर्हि स एकोनशतं मेषान् विहाय पर्व्वतं गत्वा तं हारितमेकं किं न मृगयते?</para>
  <para style="p">
    <verse number="13" style="v"/>यदि च कदाचित् तन्मेषोद्देशं लमते, तर्हि युष्मानहं सत्यं कथयामि, सोऽविपथगामिभ्य एकोनशतमेषेभ्योपि तदेकहेतोरधिकम् आह्लादते।</para>
  <para style="p">
    <verse number="14" style="v"/>तद्वद् एतेषां क्षुद्रप्राएिनाम् एकोपि नश्यतीति युष्माकं स्वर्गस्थपितु र्नाभिमतम्।</para>
  <para style="p">
    <verse number="15" style="v"/>यद्यपि तव भ्राता त्वयि किमप्यपराध्यति, तर्हि गत्वा युवयोर्द्वयोः स्थितयोस्तस्यापराधं तं ज्ञापय। तत्र स यदि तव वाक्यं शृणोति, तर्हि त्वं स्वभ्रातरं प्राप्तवान्,</para>
  <para style="p">
    <verse number="16" style="v"/>किन्तु यदि न शृणोति, तर्हि द्वाभ्यां त्रिभि र्वा साक्षीभिः सर्व्वं वाक्यं यथा निश्चितं जायते, तदर्थम् एकं द्वौ वा साक्षिणौ गृहीत्वा याहि।</para>
  <para style="p">
    <verse number="17" style="v"/>तेन स यदि तयो र्वाक्यं न मान्यते, तर्हि समाजं तज्ज्ञापय, किन्तु यदि समाजस्यापि वाक्यं न मान्यते,तर्हि स तव समीपे देवपूजकइव चण्डालइव च भविष्यति।</para>
  <para style="p">
    <verse number="18" style="v"/>अहं युष्मान् सत्यं वदामि, युष्माभिः पृथिव्यां यद् बध्यते तत् स्वर्गे भंत्स्यते; मेदिन्यां यत् भोच्यते, स्वर्गेऽपि तत् मोक्ष्यते।</para>
  <para style="p">
    <verse number="19" style="v"/>पुनरहं युष्मान् वदामि, मेदिन्यां युष्माकं यदि द्वावेकवाक्यीभूय किञ्चित् प्रार्थयेते, तर्हि मम स्वर्गस्थपित्रा तत् तयोः कृते सम्पन्नं भविष्यति।</para>
  <para style="p">
    <verse number="20" style="v"/>यतो यत्र द्वौ त्रयो वा मम नान्नि मिलन्ति, तत्रैवाहं तेषां मध्येऽस्मि।</para>
  <para style="p">
    <verse number="21" style="v"/>तदानीं पितरस्तत्समीपमागत्य कथितवान् हे प्रभो, मम भ्राता मम यद्यपराध्यति, तर्हि तं कतिकृत्वः क्षमिष्ये?</para>
  <para style="p">
    <verse number="22" style="v"/>किं सप्तकृत्वः? यीशुस्तं जगाद, त्वां केवलं सप्तकृत्वो यावत् न वदामि, किन्तु सप्तत्या गुणितं सप्तकृत्वो यावत्।</para>
  <para style="p">
    <verse number="23" style="v"/>अपरं निजदासैः सह जिगणयिषुः कश्चिद् राजेव स्वर्गराजयं।</para>
  <para style="p">
    <verse number="24" style="v"/>आरब्धे तस्मिन् गणने सार्द्धसहस्रमुद्रापूरितानां दशसहस्रपुटकानाम् एकोऽघमर्णस्तत्समक्षमानायि।</para>
  <para style="p">
    <verse number="25" style="v"/>तस्य परिशोधनाय द्रव्याभावात् परिशोधनार्थं स तदीयभार्य्यापुत्रादिसर्व्वस्वञ्च विक्रीयतामिति तत्प्रभुरादिदेश।</para>
  <para style="p">
    <verse number="26" style="v"/>तेन स दासस्तस्य पादयोः पतन् प्रणम्य कथितवान् , हे प्रभो भवता घैर्य्ये कृते मया सर्व्वं परिशोधिष्यते।</para>
  <para style="p">
    <verse number="27" style="v"/>तदानीं दासस्य प्रभुः सकरुणः सन् सकलर्णं क्षमित्वा तं तत्याज।</para>
  <para style="p">
    <verse number="28" style="v"/>किन्तु तस्मिन् दासे बहि र्याते, तस्य शतं मुद्राचतुर्थांशान् यो धारयति, तं सहदासं दृष्द्वा तस्य कण्ठं निष्पीड्य गदितवान्, मम यत् प्राप्यं तत् परिशोधय।</para>
  <para style="p">
    <verse number="29" style="v"/>तदा तस्य सहदासस्तत्पादयोः पतित्वा विनीय बभाषे, त्वया धैर्य्ये कृते मया सर्व्वं परिशोधिष्यते।</para>
  <para style="p">
    <verse number="30" style="v"/>तथापि स तत् नाङगीकृत्य यावत् सर्व्वमृणं न परिशोधितवान् तावत् तं कारायां स्थापयामास।</para>
  <para style="p">
    <verse number="31" style="v"/>तदा तस्य सहदासास्तस्यैतादृग् आचरणं विलोक्य प्रभोः समीपं गत्वा सर्व्वं वृत्तान्तं निवेदयामासुः।</para>
  <para style="p">
    <verse number="32" style="v"/>तदा तस्य प्रभुस्तमाहूय जगाद, रे दुष्ट दास, त्वया मत्सन्निधौ प्रार्थिते मया तव सर्व्वमृणं त्यक्तं;</para>
  <para style="p">
    <verse number="33" style="v"/>यथा चाहं त्वयि करुणां कृतवान्, तथैव त्वत्सहदासे करुणाकरणं किं तव नोचितं?</para>
  <para style="p">
    <verse number="34" style="v"/>इति कथयित्वा तस्य प्रभुः क्रुद्ध्यन् निजप्राप्यं यावत् स न परिशोधितवान्, तावत् प्रहारकानां करेषु तं समर्पितवान्।</para>
  <para style="p">
    <verse number="35" style="v"/>यदि यूयं स्वान्तःकरणैः स्वस्वसहजानाम् अपराधान् न क्षमध्वे, तर्हि मम स्वर्गस्यः पितापि युष्मान् प्रतीत्थं करिष्यति।</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अनन्तरम् एतासु कथासु समाप्तासु यीशु र्गालीलप्रदेशात् प्रस्थाय यर्दन्तीरस्थं यिहूदाप्रदेशं प्राप्तः।</para>
  <para style="p">
    <verse number="2" style="v"/>तदा तत्पश्चात् जननिवहे गते स तत्र तान् निरामयान् अकरोत्।</para>
  <para style="p">
    <verse number="3" style="v"/>तदनन्तरं फिरूशिनस्तत्समीपमागत्य पारीक्षितुं तं पप्रच्छुः, कस्मादपि कारणात् नरेण स्वजाया परित्याज्या न वा?</para>
  <para style="p">
    <verse number="4" style="v"/>स प्रत्युवाच, प्रथमम् ईश्वरो नरत्वेन नारीत्वेन च मनुजान् ससर्ज, तस्मात् कथितवान्,</para>
  <para style="p">
    <verse number="5" style="v"/>मानुषः स्वपितरौ परित्यज्य स्वपत्न्याम् आसक्ष्यते, तौ द्वौ जनावेकाङ्गौ भविष्यतः, किमेतद् युष्माभि र्न पठितम्?</para>
  <para style="p">
    <verse number="6" style="v"/>अतस्तौ पुन र्न द्वौ तयोरेकाङ्गत्वं जातं, ईश्वरेण यच्च समयुज्यत, मनुजो न तद् भिन्द्यात्।</para>
  <para style="p">
    <verse number="7" style="v"/>तदानीं ते तं प्रत्यवदन्, तथात्वे त्याज्यपत्रं दत्त्वा स्वां स्वां जायां त्यक्तुं व्यवस्थां मूसाः कथं लिलेख?</para>
  <para style="p">
    <verse number="8" style="v"/>ततः स कथितवान्, युष्माकं मनसां काठिन्याद् युष्मान् स्वां स्वां जायां त्यक्तुम् अन्वमन्यत किन्तु प्रथमाद् एषो विधिर्नासीत्।</para>
  <para style="p">
    <verse number="9" style="v"/>अतो युष्मानहं वदामि, व्यभिचारं विना यो निजजायां त्यजेत् अन्याञ्च विवहेत्, स परदारान् गच्छति; यश्च त्यक्तां नारीं विवहति सोपि परदारेषु रमते।</para>
  <para style="p">
    <verse number="10" style="v"/>तदा तस्य शिष्यास्तं बभाषिरे, यदि स्वजायया साकं पुंस एतादृक् सम्बन्धो जायते, तर्हि विवहनमेव न भद्रं।</para>
  <para style="p">
    <verse number="11" style="v"/>ततः स उक्तवान्, येभ्यस्तत्सामर्थ्यं आदायि, तान् विनान्यः कोपि मनुज एतन्मतं ग्रहीतुं न शक्नोति।</para>
  <para style="p">
    <verse number="12" style="v"/>कतिपया जननक्लीबः कतिपया नरकृतक्लीबः स्वर्गराज्याय कतिपयाः स्वकृतक्लीबाश्च सन्ति, ये ग्रहीतुं शक्नुवन्ति ते गृह्लन्तु।</para>
  <para style="p">
    <verse number="13" style="v"/>अपरम् यथा स शिशूनां गात्रेषु हस्तं दत्वा प्रार्थयते, तदर्थं तत्समींपं शिशव आनीयन्त, तत आनयितृन् शिष्यास्तिरस्कृतवन्तः।</para>
  <para style="p">
    <verse number="14" style="v"/>किन्तु यीशुरुवाच, शिशवो मदन्तिकम् आगच्छन्तु, तान् मा वारयत, एतादृशां शिशूनामेव स्वर्गराज्यं।</para>
  <para style="p">
    <verse number="15" style="v"/>ततः स तेषां गात्रेषु हस्तं दत्वा तस्मात् स्थानात् प्रतस्थे।</para>
  <para style="p">
    <verse number="16" style="v"/>अपरम् एक आगत्य तं पप्रच्छ, हे परमगुरो, अनन्तायुः प्राप्तुं मया किं किं सत्कर्म्म कर्त्तव्यं?</para>
  <para style="p">
    <verse number="17" style="v"/>ततः स उवाच, मां परमं कुतो वदसि? विनेश्चरं न कोपि परमः, किन्तु यद्यनन्तायुः प्राप्तुं वाञ्छसि, तर्ह्याज्ञाः पालय।</para>
  <para style="p">
    <verse number="18" style="v"/>तदा स पृष्टवान्, काः का आज्ञाः? ततो यीशुः कथितवान्, नरं मा हन्याः, परदारान् मा गच्छेः, मा चोरयेः, मृषासाक्ष्यं मा दद्याः,</para>
  <para style="p">
    <verse number="19" style="v"/>निजपितरौ संमन्यस्व, स्वसमीपवासिनि स्ववत् प्रेम कुरु।</para>
  <para style="p">
    <verse number="20" style="v"/>स युवा कथितवान्, आ बाल्याद् एताः पालयामि, इदानीं किं न्यूनमास्ते?</para>
  <para style="p">
    <verse number="21" style="v"/>ततो यीशुरवदत्, यदि सिद्धो भवितुं वाञ्छसि, तर्हि गत्वा निजसर्व्वस्वं विक्रीय दरिद्रेभ्यो वितर, ततः स्वर्गे वित्तं लप्स्यसे; आगच्छ, मत्पश्चाद्वर्त्ती च भव।</para>
  <para style="p">
    <verse number="22" style="v"/>एतां वाचं श्रुत्वा स युवा स्वीयबहुसम्पत्ते र्विषणः सन् चलितवान्।</para>
  <para style="p">
    <verse number="23" style="v"/>तदा यीशुः स्वशिष्यान् अवदत्, धनिनां स्वर्गराज्यप्रवेशो महादुष्कर इति युष्मानहं तथ्यं वदामि।</para>
  <para style="p">
    <verse number="24" style="v"/>पुनरपि युष्मानहं वदामि, धनिनां स्वर्गराज्यप्रवेशात् सूचीछिद्रेण महाङ्गगमनं सुकरं।</para>
  <para style="p">
    <verse number="25" style="v"/>इति वाक्यं निशम्य शिष्या अतिचमत्कृत्य कथयामासुः; तर्हि कस्य परित्राणं भवितुं शक्नोति?</para>
  <para style="p">
    <verse number="26" style="v"/>तदा स तान् दृष्द्वा कथयामास, तत् मानुषाणामशक्यं भवति, किन्त्वीश्वरस्य सर्व्वं शक्यम्।</para>
  <para style="p">
    <verse number="27" style="v"/>तदा पितरस्तं गदितवान्, पश्य, वयं सर्व्वं परित्यज्य भवतः पश्चाद्वर्त्तिनो ऽभवाम; वयं किं प्राप्स्यामः?</para>
  <para style="p">
    <verse number="28" style="v"/>ततो यीशुः कथितवान्, युष्मानहं तथ्यं वदामि, यूयं मम पश्चाद्वर्त्तिनो जाता इति कारणात् नवीनसृष्टिकाले यदा मनुजसुतः स्वीयैश्चर्य्यसिंहासन उपवेक्ष्यति, तदा यूयमपि द्वादशसिंहासनेषूपविश्य इस्रायेलीयद्वादशवंशानां विचारं करिष्यथ।</para>
  <para style="p">
    <verse number="29" style="v"/>अन्यच्च यः कश्चित् मम नामकारणात् गृहं वा भ्रातरं वा भगिनीं वा पितरं वा मातरं वा जायां वा बालकं वा भूमिं परित्यजति, स तेषां शतगुणं लप्स्यते, अनन्तायुमोऽधिकारित्वञ्च प्राप्स्यति।</para>
  <para style="p">
    <verse number="30" style="v"/>किन्तु अग्रीया अनेके जनाः पश्चात्, पश्चातीयाश्चानेके लोका अग्रे भविष्यन्ति।</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>स्वर्गराज्यम् एतादृशा केनचिद् गृहस्येन समं, योऽतिप्रभाते निजद्राक्षाक्षेत्रे कृषकान् नियोक्तुं गतवान्।</para>
  <para style="p">
    <verse number="2" style="v"/>पश्चात् तैः साकं दिनैकभृतिं मुद्राचतुर्थांशं निरूप्य तान् द्राक्षाक्षेत्रं प्रेरयामास।</para>
  <para style="p">
    <verse number="3" style="v"/>अनन्तरं प्रहरैकवेलायां गत्वा हट्टे कतिपयान् निष्कर्म्मकान् विलोक्य तानवदत्,</para>
  <para style="p">
    <verse number="4" style="v"/>यूयमपि मम द्राक्षाक्षेत्रं यात, युष्मभ्यमहं योग्यभृतिं दास्यामि, ततस्ते वव्रजुः।</para>
  <para style="p">
    <verse number="5" style="v"/>पुनश्च स द्वितीयतृतीययोः प्रहरयो र्बहि र्गत्वा तथैव कृतवान्।</para>
  <para style="p">
    <verse number="6" style="v"/>ततो दण्डद्वयावशिष्टायां वेलायां बहि र्गत्वापरान् कतिपयजनान् निष्कर्म्मकान् विलोक्य पृष्टवान्, यूयं किमर्थम् अत्र सर्व्वं दिनं निष्कर्म्माणस्तिष्ठथ?</para>
  <para style="p">
    <verse number="7" style="v"/>ते प्रत्यवदन्, अस्मान् न कोपि कर्ममणि नियुंक्ते। तदानीं स कथितवान्, यूयमपि मम द्राक्षाक्षेत्रं यात, तेन योग्यां भृतिं लप्स्यथ।</para>
  <para style="p">
    <verse number="8" style="v"/>तदनन्तरं सन्ध्यायां सत्यां सएव द्राक्षाक्षेत्रपतिरध्यक्षं गदिवान्, कृषकान् आहूय शेषजनमारभ्य प्रथमं यावत् तेभ्यो भृतिं देहि।</para>
  <para style="p">
    <verse number="9" style="v"/>तेन ये दण्डद्वयावस्थिते समायातास्तेषाम् एकैको जनो मुद्राचतुर्थांशं प्राप्नोत्।</para>
  <para style="p">
    <verse number="10" style="v"/>तदानीं प्रथमनियुक्ता जना आगत्यानुमितवन्तो वयमधिकं प्रप्स्यामः, किन्तु तैरपि मुद्राचतुर्थांशोऽलाभि।</para>
  <para style="p">
    <verse number="11" style="v"/>ततस्ते तं गृहीत्वा तेन क्षेत्रपतिना साकं वाग्युद्धं कुर्व्वन्तः कथयामासुः,</para>
  <para style="p">
    <verse number="12" style="v"/>वयं कृत्स्नं दिनं तापक्लेशौ सोढवन्तः, किन्तु पश्चाताया से जना दण्डद्वयमात्रं परिश्रान्तवन्तस्तेऽस्माभिः समानांशाः कृताः।</para>
  <para style="p">
    <verse number="13" style="v"/>ततः स तेषामेकं प्रत्युवाच, हे वत्स, मया त्वां प्रति कोप्यन्यायो न कृतः किं त्वया मत्समक्षं मुद्राचतुर्थांशो नाङ्गीकृतः?</para>
  <para style="p">
    <verse number="14" style="v"/>तस्मात् तव यत् प्राप्यं तदादाय याहि, तुभ्यं यति, पश्चातीयनियुक्तलोकायापि तति दातुमिच्छामि।</para>
  <para style="p">
    <verse number="15" style="v"/>स्वेच्छया निजद्रव्यव्यवहरणं किं मया न कर्त्तव्यं? मम दातृत्वात् त्वया किम् ईर्ष्यादृष्टिः क्रियते?</para>
  <para style="p">
    <verse number="16" style="v"/>इत्थम् अग्रीयलोकाः पश्चतीया भविष्यन्ति, पश्चातीयजनाश्चग्रीया भविष्यन्ति, अहूता बहवः किन्त्वल्पे मनोभिलषिताः।</para>
  <para style="p">
    <verse number="17" style="v"/>तदनन्तरं यीशु र्यिरूशालम्नगरं गच्छन् मार्गमध्ये शिष्यान् एकान्ते वभाषे,</para>
  <para style="p">
    <verse number="18" style="v"/>पश्य वयं यिरूशालम्नगरं यामः, तत्र प्रधानयाजकाध्यापकानां करेषु मनुष्यपुत्रः समर्पिष्यते;</para>
  <para style="p">
    <verse number="19" style="v"/>ते च तं हन्तुमाज्ञाप्य तिरस्कृत्य वेत्रेण प्रहर्त्तुं क्रुशे धातयितुञ्चान्यदेशीयानां करेषु समर्पयिष्यन्ति, किन्तु स तृतीयदिवसे श्मशानाद् उत्थापिष्यते।</para>
  <para style="p">
    <verse number="20" style="v"/>तदानीं सिवदीयस्य नारी स्वपुत्रावादाय यीशोः समीपम् एत्य प्रणम्य कञ्चनानुग्रहं तं ययाचे।</para>
  <para style="p">
    <verse number="21" style="v"/>तदा यीशुस्तां प्रोक्तवान्, त्वं किं याचसे? ततः सा बभाषे, भवतो राजत्वे ममानयोः सुतयोरेकं भवद्दक्षिणपार्श्वे द्वितीयं वामपार्श्व उपवेष्टुम् आज्ञापयतु।</para>
  <para style="p">
    <verse number="22" style="v"/>यीशुः प्रत्युवाच, युवाभ्यां यद् याच्यते, तन्न बुध्यते, अहं येन कंसेन पास्यामि युवाभ्यां किं तेन पातुं शक्यते? अहञ्च येन मज्जेनेन मज्जिष्ये, युवाभ्यां किं तेन मज्जयितुं शक्यते? ते जगदुः शक्यते।</para>
  <para style="p">
    <verse number="23" style="v"/>तदा स उक्तवान्, युवां मम कंसेनावश्यं पास्यथः, मम मज्जनेन च युवामपि मज्जिष्येथे, किन्तु येषां कृते मत्तातेन निरूपितम् इदं तान् विहायान्यं कमपि मद्दक्षिणपार्श्वे वामपार्श्वे च समुपवेशयितुं ममाधिकारो नास्ति।</para>
  <para style="p">
    <verse number="24" style="v"/>एतां कथां श्रुत्वान्ये दशशिष्यास्तौ भ्रातरौ प्रति चुकुपुः।</para>
  <para style="p">
    <verse number="25" style="v"/>किन्तु यीशुः स्वसमीपं तानाहूय जगाद, अन्यदेशीयलोकानां नरपतयस्तान् अधिकुर्व्वन्ति, ये तु महान्तस्ते तान् शासति, इति यूयं जानीथ।</para>
  <para style="p">
    <verse number="26" style="v"/>किन्तु युष्माकं मध्ये न तथा भवेत्, युष्माकं यः कश्चित् महान् बुभूषति, स युष्मान् सेवेत;</para>
  <para style="p">
    <verse number="27" style="v"/>यश्च युष्माकं मध्ये मुख्यो बुभूषति, स युष्माकं दासो भवेत्।</para>
  <para style="p">
    <verse number="28" style="v"/>इत्थं मनुजपुत्रः सेव्यो भवितुं नहि, किन्तु सेवितुं बहूनां परित्राणमूल्यार्थं स्वप्राणान् दातुञ्चागतः।</para>
  <para style="p">
    <verse number="29" style="v"/>अनन्तरं यिरीहोनगरात् तेषां बहिर्गमनसमये तस्य पश्चाद् बहवो लोका वव्रजुः।</para>
  <para style="p">
    <verse number="30" style="v"/>अपरं वर्त्मपार्श्व उपविशन्तौ द्वावन्धौ तेन मार्गेण यीशो र्गमनं निशम्य प्रोच्चैः कथयामासतुः, हे प्रभो दायूदः सन्तान, आवयो र्दयां विधेहि।</para>
  <para style="p">
    <verse number="31" style="v"/>ततो लोकाः सर्व्वे तुष्णीम्भवतमित्युक्त्वा तौ तर्जयामासुः; तथापि तौ पुनरुच्चैः कथयामासतुः हे प्रभो दायूदः सन्तान, आवां दयस्व।</para>
  <para style="p">
    <verse number="32" style="v"/>तदानीं यीशुः स्थगितः सन् तावाहूय भाषितवान्, युवयोः कृते मया किं कर्त्तर्व्यं? युवां किं कामयेथे?</para>
  <para style="p">
    <verse number="33" style="v"/>तदा तावुक्तवन्तौ, प्रभो नेत्राणि नौ प्रसन्नानि भवेयुः।</para>
  <para style="p">
    <verse number="34" style="v"/>तदानीं यीशुस्तौ प्रति प्रमन्नः सन् तयो र्नेत्राणि पस्पर्श, तेनैव तौ सुवीक्षाञ्चक्राते तत्पश्चात् जग्मुतुश्च।</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अनन्तरं तेषु यिरूशालम्नगरस्य समीपवेर्त्तिनो जैतुननामकधराधरस्य समीपस्थ्तिं बैत्फगिग्रामम् आगतेषु, यीशुः शिष्यद्वयं प्रेषयन् जगाद,</para>
  <para style="p">
    <verse number="2" style="v"/>युवां सम्मुखस्थग्रामं गत्वा बद्धां यां सवत्सां गर्द्दभीं हठात् प्राप्स्यथः, तां मोचयित्वा मदन्तिकम् आनयतं।</para>
  <para style="p">
    <verse number="3" style="v"/>तत्र यदि कश्चित् किञ्चिद् वक्ष्यति, तर्हि वदिष्यथः, एतस्यां प्रभोः प्रयोजनमास्ते, तेन स तत्क्षणात् प्रहेष्यति।</para>
  <para style="p">
    <verse number="4" style="v"/>सीयोनः कन्यकां यूयं भाषध्वमिति भारतीं। पश्य ते नम्रशीलः सन् नृप आरुह्य गर्दभीं। अर्थादारुह्य तद्वत्समायास्यति त्वदन्तिकं।</para>
  <para style="p">
    <verse number="5" style="v"/>भविष्यद्वादिनोक्तं वचनमिदं तदा सफलमभूत्।</para>
  <para style="p">
    <verse number="6" style="v"/>अनन्तरं तौ श्ष्यिौ यीशो र्यथानिदेशं तं ग्रामं गत्वा</para>
  <para style="p">
    <verse number="7" style="v"/>गर्दभीं तद्वत्सञ्च समानीतवन्तौ, पश्चात् तदुपरि स्वीयवसनानी पातयित्वा तमारोहयामासतुः।</para>
  <para style="p">
    <verse number="8" style="v"/>ततो बहवो लोका निजवसनानि पथि प्रसारयितुमारेभिरे, कतिपया जनाश्च पादपपर्णादिकं छित्वा पथि विस्तारयामासुः।</para>
  <para style="p">
    <verse number="9" style="v"/>अग्रगामिनः पश्चाद्गामिनश्च मनुजा उच्चैर्जय जय दायूदः सन्तानेति जगदुः परमेश्वरस्य नाम्ना य आयाति स धन्यः, सर्व्वोपरिस्थस्वर्गेपि जयति।</para>
  <para style="p">
    <verse number="10" style="v"/>इत्थं तस्मिन् यिरूशालमं प्रविष्टे कोऽयमिति कथनात् कृत्स्नं नगरं चञ्चलमभवत्।</para>
  <para style="p">
    <verse number="11" style="v"/>तत्र लोकोः कथयामासुः, एष गालील्प्रदेशीय-नासरतीय-भविष्यद्वादी यीशुः।</para>
  <para style="p">
    <verse number="12" style="v"/>अनन्तरं यीशुरीश्वरस्य मन्दिरं प्रविश्य तन्मध्यात् क्रयविक्रयिणो वहिश्चकार; वणिजां मुद्रासनानी कपोतविक्रयिणाञ्चसनानी च न्युव्जयामास।</para>
  <para style="p">
    <verse number="13" style="v"/>अपरं तानुवाच, एषा लिपिरास्ते, "मम गृहं प्रार्थनागृहमिति विख्यास्यति", किन्तु यूयं तद् दस्यूनां गह्वरं कृतवन्तः।</para>
  <para style="p">
    <verse number="14" style="v"/>तदनन्तरम् अन्धखञ्चलोकास्तस्य समीपमागताः, स तान् निरामयान् कृतवान्।</para>
  <para style="p">
    <verse number="15" style="v"/>यदा प्रधानयाजका अध्यापकाश्च तेन कृतान्येतानि चित्रकर्म्माणि ददृशुः, जय जय दायूदः सन्तान, मन्दिरे बालकानाम् एतादृशम् उच्चध्वनिं शुश्रुवुश्च, तदा महाक्रुद्धा बभूवः,</para>
  <para style="p">
    <verse number="16" style="v"/>तं पप्रच्छुश्च, इमे यद् वदन्ति, तत् किं त्वं शृणोषि? ततो यीशुस्तान् अवोचत्, सत्यम्; स्तन्यपायिशिशूनाञ्च बालकानाञ्च वक्त्रतः। स्वकीयं महिमानं त्वं संप्रकाशयसि स्वयं। एतद्वाक्यं यूयं किं नापठत?</para>
  <para style="p">
    <verse number="17" style="v"/>ततस्तान् विहाय स नगराद् बैथनियाग्रामं गत्वा तत्र रजनीं यापयामास।</para>
  <para style="p">
    <verse number="18" style="v"/>अनन्तरं प्रभाते सति यीशुः पुनरपि नगरमागच्छन् क्षुधार्त्तो बभूव।</para>
  <para style="p">
    <verse number="19" style="v"/>ततो मार्गपार्श्व उडुम्बरवृक्षमेकं विलोक्य तत्समीपं गत्वा पत्राणि विना किमपि न प्राप्य तं पादपं प्रोवाच, अद्यारभ्य कदापि त्वयि फलं न भवतु; तेन तत्क्षणात् स उडुम्बरमाहीरुहः शुष्कतां गतः।</para>
  <para style="p">
    <verse number="20" style="v"/>तद् दृष्ट्वा शिष्या आश्चर्य्यं विज्ञाय कथयामासुः, आः, उडुम्वरपादपोऽतितूर्णं शुष्कोऽभवत्।</para>
  <para style="p">
    <verse number="21" style="v"/>ततो यीशुस्तानुवाच, युष्मानहं सत्यं वदामि, यदि यूयमसन्दिग्धाः प्रतीथ, तर्हि यूयमपि केवलोडुम्वरपादपं प्रतीत्थं कर्त्तुं शक्ष्यथ, तन्न, त्वं चलित्वा सागरे पतेति वाक्यं युष्माभिरस्मिन शैले प्रोक्तेपि तदैव तद् घटिष्यते।</para>
  <para style="p">
    <verse number="22" style="v"/>तथा विश्वस्य प्रार्थ्य युष्माभि र्यद् याचिष्यते, तदेव प्राप्स्यते।</para>
  <para style="p">
    <verse number="23" style="v"/>अनन्तरं मन्दिरं प्रविश्योपदेशनसमये तत्समीपं प्रधानयाजकाः प्राचीनलोकाश्चागत्य पप्रच्छुः, त्वया केन सामर्थ्यनैतानि कर्म्माणि क्रियन्ते? केन वा तुभ्यमेतानि सामर्थ्यानि दत्तानि?</para>
  <para style="p">
    <verse number="24" style="v"/>ततो यीशुः प्रत्यवदत्, अहमपि युष्मान् वाचमेकां पृच्छामि, यदि यूयं तदुत्तरं दातुं शक्ष्यथ, तदा केन सामर्थ्येन कर्म्माण्येतानि करोमि, तदहं युष्मान् वक्ष्यामि।</para>
  <para style="p">
    <verse number="25" style="v"/>योहनो मज्जनं कस्याज्ञयाभवत्? किमीश्वरस्य मनुष्यस्य वा? ततस्ते परस्परं विविच्य कथयामासुः, यदीश्वरस्येति वदामस्तर्हि यूयं तं कुतो न प्रत्यैत? वाचमेतां वक्ष्यति।</para>
  <para style="p">
    <verse number="26" style="v"/>मनुष्यस्येति वक्तुमपि लोकेभ्यो बिभीमः, यतः सर्व्वैरपि योहन् भविष्यद्वादीति ज्ञायते।</para>
  <para style="p">
    <verse number="27" style="v"/>तस्मात् ते यीशुं प्रत्यवदन्, तद् वयं न विद्मः। तदा स तानुक्तवान्, तर्हि केन सामरथ्येन कर्म्माण्येतान्यहं करोमि, तदप्यहं युष्मान् न वक्ष्यामि।</para>
  <para style="p">
    <verse number="28" style="v"/>कस्यचिज्जनस्य द्वौ सुतावास्तां स एकस्य सुतस्य समीपं गत्वा जगाद, हे सुत, त्वमद्य मम द्राक्षाक्षेत्रे कर्म्म कर्तुं व्रज।</para>
  <para style="p">
    <verse number="29" style="v"/>ततः स उक्तवान्, न यास्यामि, किन्तु शेषेऽनुतप्य जगाम।</para>
  <para style="p">
    <verse number="30" style="v"/>अनन्तरं सोन्यसुतस्य समीपं गत्वा तथैव कथ्तिवान्; ततः स प्रत्युवाच, महेच्छ यामि, किन्तु न गतः।</para>
  <para style="p">
    <verse number="31" style="v"/>एतयोः पुत्रयो र्मध्ये पितुरभिमतं केन पालितं? युष्माभिः किं बुध्यते? ततस्ते प्रत्यूचुः, प्रथमेन पुुत्रेण। तदानीं यीशुस्तानुवाच, अहं युष्मान् तथ्यं वदामि, चण्डाला गणिकाश्च युष्माकमग्रत ईश्वरस्य राज्यं प्रविशन्ति।</para>
  <para style="p">
    <verse number="32" style="v"/>यतो युष्माकं समीपं योहनि धर्म्मपथेनागते यूयं तं न प्रतीथ, किन्तु चण्डाला गणिकाश्च तं प्रत्यायन्, तद् विलोक्यापि यूयं प्रत्येतुं नाखिद्यध्वं।</para>
  <para style="p">
    <verse number="33" style="v"/>अपरमेकं दृष्टान्तं शृणुत, कश्चिद् गृहस्थः क्षेत्रे द्राक्षालता रोपयित्वा तच्चतुर्दिक्षु वारणीं विधाय तन्मध्ये द्राक्षायन्त्रं स्थापितवान्, माञ्चञ्च निर्म्मितवान्, ततः कृषकेषु तत् क्षेत्रं समर्प्य स्वयं दूरदेशं जगाम।</para>
  <para style="p">
    <verse number="34" style="v"/>तदनन्तरं फलसमय उपस्थिते स फलानि प्राप्तुं कृषीवलानां समीपं निजदासान् प्रेषयामास।</para>
  <para style="p">
    <verse number="35" style="v"/>किन्तु कृषीवलास्तस्य तान् दासेयान् धृत्वा कञ्चन प्रहृतवन्तः, कञ्चन पाषाणैराहतवन्तः, कञ्चन च हतवन्तः।</para>
  <para style="p">
    <verse number="36" style="v"/>पुनरपि स प्रभुः प्रथमतोऽधिकदासेयान् प्रेषयामास, किन्तु ते तान् प्रत्यपि तथैव चक्रुः।</para>
  <para style="p">
    <verse number="37" style="v"/>अनन्तरं मम सुते गते तं समादरिष्यन्ते, इत्युक्त्वा शेषे स निजसुतं तेषां सन्निधिं प्रेषयामास।</para>
  <para style="p">
    <verse number="38" style="v"/>किन्तु ते कृषीवलाः सुतं वीक्ष्य परस्परम् इति मन्त्रयितुम् आरेभिरे, अयमुत्तराधिकारी वयमेनं निहत्यास्याधिकारं स्ववशीकरिष्यामः।</para>
  <para style="p">
    <verse number="39" style="v"/>पश्चात् ते तं धृत्वा द्राक्षाक्षेत्राद् बहिः पातयित्वाबधिषुः।</para>
  <para style="p">
    <verse number="40" style="v"/>यदा स द्राक्षाक्षेत्रपतिरागमिष्यति, तदा तान् कृषीवलान् किं करिष्यति?</para>
  <para style="p">
    <verse number="41" style="v"/>ततस्ते प्रत्यवदन्, तान् कलुषिणो दारुणयातनाभिराहनिष्यति, ये च समयानुक्रमात् फलानि दास्यन्ति, तादृशेषु कृषीवलेषु क्षेत्रं समर्पयिष्यति।</para>
  <para style="p">
    <verse number="42" style="v"/>तदा यीशुना ते गदिताः, ग्रहणं न कृतं यस्य पाषाणस्य निचायकैः। प्रधानप्रस्तरः कोणे सएव संभविष्यति। एतत् परेशितुः कर्म्मास्मदृष्टावद्भुतं भवेत्। धर्म्मग्रन्थे लिखितमेतद्वचनं युष्माभिः किं नापाठि?</para>
  <para style="p">
    <verse number="43" style="v"/>तस्मादहं युष्मान् वदामि, युष्मत्त ईश्वरीयराज्यमपनीय फलोत्पादयित्रन्यजातये दायिष्यते।</para>
  <para style="p">
    <verse number="44" style="v"/>यो जन एतत्पाषाणोपरि पतिष्यति, तं स भंक्ष्यते, किन्त्वयं पाषाणो यस्योपरि पतिष्यति, तं स धूलिवत् चूर्णीकरिष्यति।</para>
  <para style="p">
    <verse number="45" style="v"/>तदानीं प्राधनयाजकाः फिरूशिनश्च तस्येमां दृष्टान्तकथां श्रुत्वा सोऽस्मानुद्दिश्य कथितवान्, इति विज्ञाय तं धर्त्तुं चेष्टितवन्तः;</para>
  <para style="p">
    <verse number="46" style="v"/>किन्तु लोकेभ्यो बिभ्युः, यतो लोकैः स भविष्यद्वादीत्यज्ञायि।</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अनन्तरं यीशुः पुनरपि दृष्टान्तेन तान् अवादीत्,</para>
  <para style="p">
    <verse number="2" style="v"/>स्वर्गीयराज्यम् एतादृशस्य नृपतेः समं, यो निज पुत्रं विवाहयन् सर्व्वान् निमन्त्रितान् आनेतुं दासेयान् प्रहितवान्,</para>
  <para style="p">
    <verse number="3" style="v"/>किन्तु ते समागन्तुं नेष्टवन्तः।</para>
  <para style="p">
    <verse number="4" style="v"/>ततो राजा पुनरपि दासानन्यान् इत्युक्त्वा प्रेषयामास, निमन्त्रितान् वदत, पश्यत, मम भेज्यमासादितमास्ते, निजव्टषादिपुष्टजन्तून् मारयित्वा सर्व्वं खाद्यद्रव्यमासादितवान्, यूयं विवाहमागच्छत।</para>
  <para style="p">
    <verse number="5" style="v"/>तथपि ते तुच्छीकृत्य केचित् निजक्षेत्रं केचिद् वाणिज्यं प्रति स्वस्वमार्गेण चलितवन्तः।</para>
  <para style="p">
    <verse number="6" style="v"/>अन्ये लोकास्तस्य दासेयान् धृत्वा दौरात्म्यं व्यवहृत्य तानवधिषुः।</para>
  <para style="p">
    <verse number="7" style="v"/>अनन्तरं स नृपतिस्तां वार्त्तां श्रुत्वा क्रुध्यन् सैन्यानि प्रहित्य तान् घातकान् हत्वा तेषां नगरं दाहयामास।</para>
  <para style="p">
    <verse number="8" style="v"/>ततः स निजदासेयान् बभाषे, विवाहीयं भोज्यमासादितमास्ते, किन्तु निमन्त्रिता जना अयोग्याः।</para>
  <para style="p">
    <verse number="9" style="v"/>तस्माद् यूयं राजमार्गं गत्वा यावतो मनुजान् पश्यत, तावतएव विवाहीयभोज्याय निमन्त्रयत।</para>
  <para style="p">
    <verse number="10" style="v"/>तदा ते दासेया राजमार्गं गत्वा भद्रान् अभद्रान् वा यावतो जनान् ददृशुः, तावतएव संगृह्यानयन्; ततोऽभ्यागतमनुजै र्विवाहगृहम् अपूर्य्यत।</para>
  <para style="p">
    <verse number="11" style="v"/>तदानीं स राजा सर्व्वानभ्यागतान् द्रष्टुम् अभ्यन्तरमागतवान्; तदा तत्र विवाहीयवसनहीनमेकं जनं वीक्ष्य तं जगाद्,</para>
  <para style="p">
    <verse number="12" style="v"/>हे मित्र,त्वं विवाहीयवसनं विना कथमत्र प्रविष्टवान्? तेन स निरुत्तरो बभूव।</para>
  <para style="p">
    <verse number="13" style="v"/>तदा राजा निजानुचरान् अवदत्, एतस्य करचरणान् बद्धा यत्र रोदनं दन्तैर्दन्तघर्षणञ्च भवति, तत्र वहिर्भूततमिस्रे तं निक्षिपत।</para>
  <para style="p">
    <verse number="14" style="v"/>इत्थं बहव आहूता अल्पे मनोभिमताः।</para>
  <para style="p">
    <verse number="15" style="v"/>अनन्तरं फिरूशिनः प्रगत्य यथा संलापेन तम् उन्माथे पातयेयुस्तथा मन्त्रयित्वा</para>
  <para style="p">
    <verse number="16" style="v"/>हेरोदीयमनुजैः साकं निजशिष्यगणेन तं प्रति कथयामासुः, हे गुरो, भवान् सत्यः सत्यमीश्वरीयमार्गमुपदिशति, कमपि मानुषं नानुरुध्यते, कमपि नापेक्षते च, तद् वयं जानीमः।</para>
  <para style="p">
    <verse number="17" style="v"/>अतः कैसरभूपाय करोऽस्माकं दातव्यो न वा? अत्र भवता किं बुध्यते? तद् अस्मान् वदतु।</para>
  <para style="p">
    <verse number="18" style="v"/>ततो यीशुस्तेषां खलतां विज्ञाय कथितवान्, रे कपटिनः युयं कुतो मां परिक्षध्वे?</para>
  <para style="p">
    <verse number="19" style="v"/>तत्करदानस्य मुद्रां मां दर्शयत। तदानीं तैस्तस्य समीपं मुद्राचतुर्थभाग आनीते</para>
  <para style="p">
    <verse number="20" style="v"/>स तान् पप्रच्छ, अत्र कस्येयं मूर्त्ति र्नाम चास्ते? ते जगदुः, कैसरभूपस्य।</para>
  <para style="p">
    <verse number="21" style="v"/>ततः स उक्तवान, कैसरस्य यत् तत् कैसराय दत्त, ईश्वरस्य यत् तद् ईश्वराय दत्त।</para>
  <para style="p">
    <verse number="22" style="v"/>इति वाक्यं निशम्य ते विस्मयं विज्ञाय तं विहाय चलितवन्तः।</para>
  <para style="p">
    <verse number="23" style="v"/>तस्मिन्नहनि सिदूकिनोऽर्थात् श्मशानात् नोत्थास्यन्तीति वाक्यं ये वदन्ति, ते यीशेारन्तिकम् आगत्य पप्रच्छुः,</para>
  <para style="p">
    <verse number="24" style="v"/>हे गुरो, कश्चिन्मनुजश्चेत् निःसन्तानः सन् प्राणान् त्यजति, तर्हि तस्य भ्राता तस्य जायां व्युह्य भ्रातुः सन्तानम् उत्पादयिष्यतीति मूसा आदिष्टवान्।</para>
  <para style="p">
    <verse number="25" style="v"/>किन्त्वस्माकमत्र केऽपि जनाः सप्तसहोदरा आसन्, तेषां ज्येष्ठ एकां कन्यां व्यवहात्, अपरं प्राणत्यागकाले स्वयं निःसन्तानः सन् तां स्त्रियं स्वभ्रातरि समर्पितवान्,</para>
  <para style="p">
    <verse number="26" style="v"/>ततो द्वितीयादिसप्तमान्ताश्च तथैव चक्रुः।</para>
  <para style="p">
    <verse number="27" style="v"/>शेषे सापी नारी ममार।</para>
  <para style="p">
    <verse number="28" style="v"/>मृतानाम् उत्थानसमये तेषां सप्तानां मध्ये सा नारी कस्य भार्य्या भविष्यति? यस्मात् सर्व्वएव तां व्यवहन्।</para>
  <para style="p">
    <verse number="29" style="v"/>ततो यीशुः प्रत्यवादीत्, यूयं धर्म्मपुस्तकम् ईश्वरीयां शक्तिञ्च न विज्ञाय भ्रान्तिमन्तः।</para>
  <para style="p">
    <verse number="30" style="v"/>उत्थानप्राप्ता लोका न विवहन्ति, न च वाचा दीयन्ते, किन्त्वीश्वरस्य स्वर्गस्थदूतानां सदृशा भवन्ति।</para>
  <para style="p">
    <verse number="31" style="v"/>अपरं मृतानामुत्थानमधि युष्मान् प्रतीयमीश्वरोक्तिः,</para>
  <para style="p">
    <verse number="32" style="v"/>"अहमिब्राहीम ईश्वर इस्हाक ईश्वरो याकूब ईश्वर" इति किं युष्माभि र्नापाठि? किन्त्वीश्वरो जीवताम् ईश्वर:, स मृतानामीश्वरो नहि।</para>
  <para style="p">
    <verse number="33" style="v"/>इति श्रुत्वा सर्व्वे लोकास्तस्योपदेशाद् विस्मयं गताः।</para>
  <para style="p">
    <verse number="34" style="v"/>अनन्तरं सिदूकिनाम् निरुत्तरत्ववार्तां निशम्य फिरूशिन एकत्र मिलितवन्तः,</para>
  <para style="p">
    <verse number="35" style="v"/>तेषामेको व्यवस्थापको यीशुं परीक्षितुं पपच्छ,</para>
  <para style="p">
    <verse number="36" style="v"/>हे गुरो व्यवस्थाशास्त्रमध्ये काज्ञा श्रेष्ठा?</para>
  <para style="p">
    <verse number="37" style="v"/>ततो यीशुरुवाच, त्वं सर्व्वान्तःकरणैः सर्व्वप्राणैः सर्व्वचित्तैश्च साकं प्रभौ परमेश्वरे प्रीयस्व,</para>
  <para style="p">
    <verse number="38" style="v"/>एषा प्रथममहाज्ञा। तस्याः सदृशी द्वितीयाज्ञैषा,</para>
  <para style="p">
    <verse number="39" style="v"/>तव समीपवासिनि स्वात्मनीव प्रेम कुरु।</para>
  <para style="p">
    <verse number="40" style="v"/>अनयो र्द्वयोराज्ञयोः कृत्स्नव्यवस्थाया भविष्यद्वक्तृग्रन्थस्य च भारस्तिष्ठति।</para>
  <para style="p">
    <verse number="41" style="v"/>अनन्तरं फिरूशिनाम् एकत्र स्थितिकाले यीशुस्तान् पप्रच्छ,</para>
  <para style="p">
    <verse number="42" style="v"/>ख्रीष्टमधि युष्माकं कीदृग्बोधो जायते? स कस्य सन्तानः? ततस्ते प्रत्यवदन्, दायूदः सन्तानः।</para>
  <para style="p">
    <verse number="43" style="v"/>तदा स उक्तवान्, तर्हि दायूद् कथम् आत्माधिष्ठानेन तं प्रभुं वदति ?</para>
  <para style="p">
    <verse number="44" style="v"/>यथा मम प्रभुमिदं वाक्यमवदत् परमेश्वरः। तवारीन् पादपीठं ते यावन्नहि करोम्यहं। तावत् कालं मदीये त्वं दक्षपार्श्व उपाविश। अतो यदि दायूद् तं प्रभुं वदति, र्तिह स कथं तस्य सन्तानो भवति?</para>
  <para style="p">
    <verse number="45" style="v"/>तदानीं तेषां कोपि तद्वाक्यस्य किमप्युत्तरं दातुं नाशक्नोत्;</para>
  <para style="p">
    <verse number="46" style="v"/>तद्दिनमारभ्य तं किमपि वाक्यं प्रष्टुं कस्यापि साहसो नाभवत्।</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अनन्तरं यीशु र्जननिवहं शिष्यांश्चावदत्,</para>
  <para style="p">
    <verse number="2" style="v"/>अध्यापकाः फिरूशिनश्च मूसासने उपविशन्ति,</para>
  <para style="p">
    <verse number="3" style="v"/>अतस्ते युष्मान् यद्यत् मन्तुम् आज्ञापयन्ति, तत् मन्यध्वं पालयध्वञ्च, किन्तु तेषां कर्म्मानुरूपं कर्म्म न कुरुध्वं; यतस्तेषां वाक्यमात्रं सारं कार्य्ये किमपि नास्ति।</para>
  <para style="p">
    <verse number="4" style="v"/>ते दुर्व्वहान् गुरुतरान् भारान् बद्व्वा मनुष्याणां स्कन्धेपरि समर्पयन्ति, किन्तु स्वयमङ्गुल्यैकयापि न चालयन्ति।</para>
  <para style="p">
    <verse number="5" style="v"/>केवलं लोकदर्शनाय सर्व्वकर्म्माणि कुर्व्वन्ति; फलतः पट्टबन्धान् प्रसार्य्य धारयन्ति, स्ववस्त्रेषु च दीर्घग्रन्थीन् धारयन्ति;</para>
  <para style="p">
    <verse number="6" style="v"/>भोजनभवन उच्चस्थानं, भजनभवने प्रधानमासनं,</para>
  <para style="p">
    <verse number="7" style="v"/>हट्ठे नमस्कारं गुरुरिति सम्बोधनञ्चैतानि सर्व्वाणि वाञ्छन्ति।</para>
  <para style="p">
    <verse number="8" style="v"/>किन्तु यूयं गुरव इति सम्बोधनीया मा भवत, यतो युष्माकम् एकः ख्रीष्टएव गुरु</para>
  <para style="p">
    <verse number="9" style="v"/>र्यूयं सर्व्वे मिथो भ्रातरश्च। पुनः पृथिव्यां कमपि पितेति मा सम्बुध्यध्वं, यतो युष्माकमेकः स्वर्गस्थएव पिता।</para>
  <para style="p">
    <verse number="10" style="v"/>यूयं नायकेति सम्भाषिता मा भवत, यतो युष्माकमेकः ख्रीष्टएव नायकः।</para>
  <para style="p">
    <verse number="11" style="v"/>अपरं युष्माकं मध्ये यः पुमान् श्रेष्ठः स युष्मान् सेविष्यते।</para>
  <para style="p">
    <verse number="12" style="v"/>यतो यः स्वमुन्नमति, स नतः करिष्यते; किन्तु यः कश्चित् स्वमवनतं करोति, स उन्नतः करिष्यते।</para>
  <para style="p">
    <verse number="13" style="v"/>हन्त कपटिन उपाध्यायाः फिरूशिनश्च, यूयं मनुजानां समक्षं स्वर्गद्वारं रुन्ध, यूयं स्वयं तेन न प्रविशथ, प्रविविक्षूनपि वारयथ। वत कपटिन उपाध्यायाः फिरूशिनश्च यूयं छलाद् दीर्घं प्रार्थ्य विधवानां सर्व्वस्वं ग्रसथ, युष्माकं घोरतरदण्डो भविष्यति।</para>
  <para style="p">
    <verse number="14" style="v"/>हन्त कपटिन उपाध्यायाः फिरूशिनश्च, यूयमेकं स्वधर्म्मावलम्बिनं कर्त्तुं सागरं भूमण्डलञ्च प्रदक्षिणीकुरुथ,</para>
  <para style="p">
    <verse number="15" style="v"/>कञ्चन प्राप्य स्वतो द्विगुणनरकभाजनं तं कुरुथ।</para>
  <para style="p">
    <verse number="16" style="v"/>वत अन्धपथदर्शकाः सर्व्वे, यूयं वदथ, मन्दिरस्य शपथकरणात् किमपि न देयं; किन्तु मन्दिरस्थसुवर्णस्य शपथकरणाद् देयं।</para>
  <para style="p">
    <verse number="17" style="v"/>हे मूढा हे अन्धाः सुवर्णं तत्सुवर्णपावकमन्दिरम् एतयोरुभयो र्मध्ये किं श्रेयः?</para>
  <para style="p">
    <verse number="18" style="v"/>अन्यच्च वदथ, यज्ञवेद्याः शपथकरणात् किमपि न देयं, किन्तु तदुपरिस्थितस्य नैवेद्यस्य शपथकरणाद् देयं।</para>
  <para style="p">
    <verse number="19" style="v"/>हे मूढा हे अन्धाः, नैवेद्यं तन्नैवेद्यपावकवेदिरेतयोरुभयो र्मध्ये किं श्रेयः?</para>
  <para style="p">
    <verse number="20" style="v"/>अतः केनचिद् यज्ञवेद्याः शपथे कृते तदुपरिस्थस्य सर्व्वस्य शपथः क्रियते।</para>
  <para style="p">
    <verse number="21" style="v"/>केनचित् मन्दिरस्य शपथे कृते मन्दिरतन्निवासिनोः शपथः क्रियते।</para>
  <para style="p">
    <verse number="22" style="v"/>केनचित् स्वर्गस्य शपथे कृते ईश्वरीयसिंहासनतदुपर्य्युपविष्टयोः शपथः क्रियते।</para>
  <para style="p">
    <verse number="23" style="v"/>हन्त कपटिन उपाध्यायाः फिरूशिनश्च, यूयं पोदिनायाः सितच्छत्राया जीरकस्य च दशमांशान् दत्थ, किन्तु व्यवस्थाया गुरुतरान् न्यायदयाविश्वासान् परित्यजथ; इमे युष्माभिराचरणीया अमी च न लंघनीयाः।</para>
  <para style="p">
    <verse number="24" style="v"/>हे अन्धपथदर्शका यूयं मशकान् अपसारयथ, किन्तु महाङ्गान् ग्रसथ।</para>
  <para style="p">
    <verse number="25" style="v"/>हन्त कपटिन उपाध्यायाः फिरूशिनश्च, यूयं पानपात्राणां भोजनपात्राणाञ्च बहिः परिष्कुरुथ; किन्तु तदभ्यन्तरं दुरात्मतया कलुषेण च परिपूर्णमास्ते।</para>
  <para style="p">
    <verse number="26" style="v"/>हे अन्धाः फिरूशिलोका आदौ पानपात्राणां भोजनपात्राणाञ्चाभ्यन्तरं परिष्कुरुत, तेन तेषां बहिरपि परिष्कारिष्यते।</para>
  <para style="p">
    <verse number="27" style="v"/>हन्त कपटिन उपाध्यायाः फिरूशिनश्च, यूयं शुक्लीकृतश्मशानस्वरूपा भवथ, यथा श्मशानभवनस्य बहिश्चारु, किन्त्वभ्यन्तरं मृतलोकानां कीकशैः सर्व्वप्रकारमलेन च परिपूर्णम्;</para>
  <para style="p">
    <verse number="28" style="v"/>तथैव यूयमपि लोकानां समक्षं बहिर्धार्म्मिकाः किन्त्वन्तःकरणेषु केवलकापट्याधर्म्माभ्यां परिपूर्णाः।</para>
  <para style="p">
    <verse number="29" style="v"/>हा हा कपटिन उपाध्यायाः फिरूशिनश्च, यूयं भविष्यद्वादिनां श्मशानगेहं निर्म्माथ, साधूनां श्मशाननिकेतनं शोभयथ</para>
  <para style="p">
    <verse number="30" style="v"/>वदथ च यदि वयं स्वेषां पूर्व्वपुरुषाणां काल अस्थास्याम, तर्हि भविष्यद्वादिनां शोणितपातने तेषां सहभागिनो नाभविष्याम।</para>
  <para style="p">
    <verse number="31" style="v"/>अतो यूयं भविष्यद्वादिघातकानां सन्ताना इति स्वयमेव स्वेषां साक्ष्यं दत्थ।</para>
  <para style="p">
    <verse number="32" style="v"/>अतो यूयं निजपूर्व्वपुरुषाणां परिमाणपात्रं परिपूरयत।</para>
  <para style="p">
    <verse number="33" style="v"/>रे भुजगाः कृष्णभुजगवंशाः, यूयं कथं नरकदण्डाद् रक्षिष्यध्वे।</para>
  <para style="p">
    <verse number="34" style="v"/>पश्यत, युष्माकमन्तिकम् अहं भविष्यद्वादिनो बुद्धिमत उपाध्यायांश्च प्रेषयिष्यामि, किन्तु तेषां कतिपया युष्माभि र्घानिष्यन्ते, क्रुशे च घानिष्यन्ते, केचिद् भजनभवने कषाभिराघानिष्यन्ते, नगरे नगरे ताडिष्यन्ते च;</para>
  <para style="p">
    <verse number="35" style="v"/>तेन सत्पुरुषस्य हाबिलो रक्तपातमारभ्य बेरिखियः पुत्रं यं सिखरियं यूयं मन्दिरयज्ञवेद्यो र्मध्ये हतवन्तः, तदीयशोणितपातं यावद् अस्मिन् देशे यावतां साधुपुरुषाणां शोणितपातो ऽभवत् तत् सर्व्वेषामागसां दण्डा युष्मासु वर्त्तिष्यन्ते।</para>
  <para style="p">
    <verse number="36" style="v"/>अहं युष्मान्त तथ्यं वदामि, विद्यमानेऽस्मिन् पुरुषे सर्व्वे वर्त्तिष्यन्ते।</para>
  <para style="p">
    <verse number="37" style="v"/>हे यिरूशालम् हे यिरूशालम् नगरि त्वं भविष्यद्वादिनो हतवती, तव समीपं प्रेरितांश्च पाषाणैराहतवती, यथा कुक्कुटी शावकान् पक्षाधः संगृह्लाति, तथा तव सन्तानान् संग्रहीतुं अहं बहुवारम् ऐच्छं; किन्तु त्वं न सममन्यथाः।</para>
  <para style="p">
    <verse number="38" style="v"/>पश्यत यष्माकं वासस्थानम् उच्छिन्नं त्यक्ष्यते।</para>
  <para style="p">
    <verse number="39" style="v"/>अहं युष्मान् तथ्यं वदामि, यः परमेश्वरस्य नाम्नागच्छति, स धन्य इति वाणीं यावन्न वदिष्यथ, तावत् मां पुन र्न द्रक्ष्यथ।</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अनन्तरं यीशु र्यदा मन्दिराद् बहि र्गच्छति, तदानीं शिष्यास्तं मन्दिरनिर्म्माणं दर्शयितुमागताः।</para>
  <para style="p">
    <verse number="2" style="v"/>ततो यीशुस्तानुवाच, यूयं किमेतानि न पश्यथ? युष्मानहं सत्यं वदामि, एतन्निचयनस्य पाषाणैकमप्यन्यपाषाणेापरि न स्थास्यति सर्व्वाणि भूमिसात् कारिष्यन्ते।</para>
  <para style="p">
    <verse number="3" style="v"/>अनन्तरं तस्मिन् जैतुनपर्व्वतोपरि समुपविष्टे शिष्यास्तस्य समीपमागत्य गुप्तं पप्रच्छुः, एता घटनाः कदा भविष्यन्ति? भवत आगमनस्य युगान्तस्य च किं लक्ष्म? तदस्मान् वदतु।</para>
  <para style="p">
    <verse number="4" style="v"/>तदानीं यीशुस्तानवोचत्, अवधद्व्वं, कोपि युष्मान् न भ्रमयेत्।</para>
  <para style="p">
    <verse number="5" style="v"/>बहवो मम नाम गृह्लन्त आगमिष्यन्ति, ख्रीष्टोऽहमेवेति वाचं वदन्तो बहून् भ्रमयिष्यन्ति।</para>
  <para style="p">
    <verse number="6" style="v"/>यूयञ्च संग्रामस्य रणस्य चाडम्बरं श्रोष्यथ, अवधद्व्वं तेन चञ्चला मा भवत, एतान्यवश्यं घटिष्यन्ते, किन्तु तदा युगान्तो नहि।</para>
  <para style="p">
    <verse number="7" style="v"/>अपरं देशस्य विपक्षो देशो राज्यस्य विपक्षो राज्यं भविष्यति, स्थाने स्थाने च दुर्भिक्षं महामारी भूकम्पश्च भविष्यन्ति,</para>
  <para style="p">
    <verse number="8" style="v"/>एतानि दुःखोपक्रमाः।</para>
  <para style="p">
    <verse number="9" style="v"/>तदानीं लोका दुःखं भोजयितुं युष्मान् परकरेषु समर्पयिष्यन्ति हनिष्यन्ति च, तथा मम नामकारणाद् यूयं सर्व्वदेशीयमनुजानां समीपे घृणार्हा भविष्यथ।</para>
  <para style="p">
    <verse number="10" style="v"/>बहुषु विघ्नं प्राप्तवत्सु परस्परम् ऋृतीयां कृतवत्सु च एकोऽपरं परकरेषु समर्पयिष्यति।</para>
  <para style="p">
    <verse number="11" style="v"/>तथा बहवो मृषाभविष्यद्वादिन उपस्थाय बहून् भ्रमयिष्यन्ति।</para>
  <para style="p">
    <verse number="12" style="v"/>दुष्कर्म्मणां बाहुल्याञ्च बहूनां प्रेम शीतलं भविष्यति।</para>
  <para style="p">
    <verse number="13" style="v"/>किन्तु यः कश्चित् शेषं यावद् धैर्य्यमाश्रयते, सएव परित्रायिष्यते।</para>
  <para style="p">
    <verse number="14" style="v"/>अपरं सर्व्वदेशीयलोकान् प्रतिमाक्षी भवितुं राजस्य शुभसमाचारः सर्व्वजगति प्रचारिष्यते, एतादृशि सति युगान्त उपस्थास्यति।</para>
  <para style="p">
    <verse number="15" style="v"/>अतो यत् सर्व्वनाशकृद्घृणार्हं वस्तु दानियेल्भविष्यद्वदिना प्रोक्तं तद् यदा पुण्यस्थाने स्थापितं द्रक्ष्यथ, (यः पठति, स बुध्यतां)</para>
  <para style="p">
    <verse number="16" style="v"/>तदानीं ये यिहूदीयदेशे तिष्ठन्ति, ते पर्व्वतेषु पलायन्तां।</para>
  <para style="p">
    <verse number="17" style="v"/>यः कश्चिद् गृहपृष्ठे तिष्ठति, स गृहात् किमपि वस्त्वानेतुम् अधेा नावरोहेत्।</para>
  <para style="p">
    <verse number="18" style="v"/>यश्च क्षेत्रे तिष्ठति, सोपि वस्त्रमानेतुं परावृत्य न यायात्।</para>
  <para style="p">
    <verse number="19" style="v"/>तदानीं गर्भिणीस्तन्यपाययित्रीणां दुर्गति र्भविष्यति।</para>
  <para style="p">
    <verse number="20" style="v"/>अतो यष्माकं पलायनं शीतकाले विश्रामवारे वा यन्न भवेत्, तदर्थं प्रार्थयध्वम्।</para>
  <para style="p">
    <verse number="21" style="v"/>आ जगदारम्भाद् एतत्कालपर्य्यनन्तं यादृशः कदापि नाभवत् न च भविष्यति तादृशो महाक्लेशस्तदानीम् उपस्थास्यति।</para>
  <para style="p">
    <verse number="22" style="v"/>तस्य क्लेशस्य समयो यदि ह्स्वो न क्रियेत, तर्हि कस्यापि प्राणिनो रक्षणं भवितुं न शक्नुयात्, किन्तु मनोनीतमनुजानां कृते स कालो ह्स्वीकरिष्यते।</para>
  <para style="p">
    <verse number="23" style="v"/>अपरञ्च पश्यत, ख्रीष्टोऽत्र विद्यते, वा तत्र विद्यते, तदानीं यदी कश्चिद् युष्मान इति वाक्यं वदति, तथापि तत् न प्रतीत्।</para>
  <para style="p">
    <verse number="24" style="v"/>यतो भाक्तख्रीष्टा भाक्तभविष्यद्वादिनश्च उपस्थाय यानि महन्ति लक्ष्माणि चित्रकर्म्माणि च प्रकाशयिष्यन्ति, तै र्यदि सम्भवेत् तर्हि मनोनीतमानवा अपि भ्रामिष्यन्ते।</para>
  <para style="p">
    <verse number="25" style="v"/>पश्यत, घटनातः पूर्व्वं युष्मान् वार्त्ताम् अवादिषम्।</para>
  <para style="p">
    <verse number="26" style="v"/>अतः पश्यत, स प्रान्तरे विद्यत इति वाक्ये केनचित् कथितेपि बहि र्मा गच्छत, वा पश्यत, सोन्तःपुरे विद्यते, एतद्वाक्य उक्तेपि मा प्रतीत।</para>
  <para style="p">
    <verse number="27" style="v"/>यतो यथा विद्युत् पूर्व्वदिशो निर्गत्य पश्चिमदिशं यावत् प्रकाशते, तथा मानुषपुत्रस्याप्यागमनं भविष्यति।</para>
  <para style="p">
    <verse number="28" style="v"/>यत्र शवस्तिष्ठति, तत्रेव गृध्रा मिलन्ति।</para>
  <para style="p">
    <verse number="29" style="v"/>अपरं तस्य क्लेशसमयस्याव्यवहितपरत्र सूर्य्यस्य तेजो लोप्स्यते, चन्द्रमा ज्योस्नां न करिष्यति, नभसो नक्षत्राणि पतिष्यन्ति, गगणीया ग्रहाश्च विचलिष्यन्ति।</para>
  <para style="p">
    <verse number="30" style="v"/>तदानीम् आकाशमध्ये मनुजसुतस्य लक्ष्म दर्शिष्यते, ततो निजपराक्रमेण महातेजसा च मेघारूढं मनुजसुतं नभसागच्छन्तं विलोक्य पृथिव्याः सर्व्ववंशीया विलपिष्यन्ति।</para>
  <para style="p">
    <verse number="31" style="v"/>तदानीं स महाशब्दायमानतूर्य्या वादकान् निजदूतान् प्रहेष्यति, ते व्योम्न एकसीमातोऽपरसीमां यावत् चतुर्दिशस्तस्य मनोनीतजनान् आनीय मेलयिष्यन्ति।</para>
  <para style="p">
    <verse number="32" style="v"/>उडुम्बरपादपस्य दृष्टान्तं शिक्षध्वं; यदा तस्य नवीनाः शाखा जायन्ते, पल्लवादिश्च निर्गच्छति, तदा निदाघकालः सविधो भवतीति यूयं जानीथ;</para>
  <para style="p">
    <verse number="33" style="v"/>तद्वद् एता घटना दृष्ट्वा स समयो द्वार उपास्थाद् इति जानीत।</para>
  <para style="p">
    <verse number="34" style="v"/>युष्मानहं तथ्यं वदामि, इदानीन्तनजनानां गमनात् पूर्व्वमेव तानि सर्व्वाणि घटिष्यन्ते।</para>
  <para style="p">
    <verse number="35" style="v"/>नभोमेदिन्यो र्लुप्तयोरपि मम वाक् कदापि न लोप्स्यते।</para>
  <para style="p">
    <verse number="36" style="v"/>अपरं मम तातं विना मानुषः स्वर्गस्थो दूतो वा कोपि तद्दिनं तद्दण्डञ्च न ज्ञापयति।</para>
  <para style="p">
    <verse number="37" style="v"/>अपरं नोहे विद्यमाने यादृशमभवत् तादृशं मनुजसुतस्यागमनकालेपि भविष्यति।</para>
  <para style="p">
    <verse number="38" style="v"/>फलतो जलाप्लावनात् पूर्व्वं यद्दिनं यावत् नोहः पोतं नारोहत्, तावत्कालं यथा मनुष्या भोजने पाने विवहने विवाहने च प्रवृत्ता आसन्;</para>
  <para style="p">
    <verse number="39" style="v"/>अपरम् आप्लावितोयमागत्य यावत् सकलमनुजान् प्लावयित्वा नानयत्, तावत् ते यथा न विदामासुः, तथा मनुजसुतागमनेपि भविष्यति।</para>
  <para style="p">
    <verse number="40" style="v"/>तदा क्षेत्रस्थितयोर्द्वयोरेको धारिष्यते, अपरस्त्याजिष्यते।</para>
  <para style="p">
    <verse number="41" style="v"/>तथा पेषण्या पिंषत्योरुभयो र्योषितोरेका धारिष्यतेऽपरा त्याजिष्यते।</para>
  <para style="p">
    <verse number="42" style="v"/>युष्माकं प्रभुः कस्मिन् दण्ड आगमिष्यति, तद् युष्माभि र्नावगम्यते, तस्मात् जाग्रतः सन्तस्तिष्ठत।</para>
  <para style="p">
    <verse number="43" style="v"/>कुत्र यामे स्तेन आगमिष्यतीति चेद् गृहस्थो ज्ञातुम् अशक्ष्यत्, तर्हि जागरित्वा तं सन्धिं कर्त्तितुम् अवारयिष्यत् तद् जानीत।</para>
  <para style="p">
    <verse number="44" style="v"/>युष्माभिरवधीयतां, यतो युष्माभि र्यत्र न बुध्यते, तत्रैव दण्डे मनुजसुत आयास्यति।</para>
  <para style="p">
    <verse number="45" style="v"/>प्रभु र्निजपरिवारान् यथाकालं भोजयितुं यं दासम् अध्यक्षीकृत्य स्थापयति, तादृशो विश्वास्यो धीमान् दासः कः?</para>
  <para style="p">
    <verse number="46" style="v"/>प्रभुरागत्य यं दासं तथाचरन्तं वीक्षते, सएव धन्यः।</para>
  <para style="p">
    <verse number="47" style="v"/>युष्मानहं सत्यं वदामि, स तं निजसर्व्वस्वस्याधिपं करिष्यति।</para>
  <para style="p">
    <verse number="48" style="v"/>किन्तु प्रभुरागन्तुं विलम्बत इति मनसि चिन्तयित्वा यो दुष्टो दासो</para>
  <para style="p">
    <verse number="49" style="v"/>ऽपरदासान् प्रहर्त्तुं मत्तानां सङ्गे भोक्तुं पातुञ्च प्रवर्त्तते,</para>
  <para style="p">
    <verse number="50" style="v"/>स दासो यदा नापेक्षते, यञ्च दण्डं न जानाति, तत्कालएव तत्प्रभुरुपस्थास्यति।</para>
  <para style="p">
    <verse number="51" style="v"/>तदा तं दण्डयित्वा यत्र स्थाने रोदनं दन्तघर्षणञ्चासाते, तत्र कपटिभिः साकं तद्दशां निरूपयिष्यति।</para>
  <chapter number="25" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>या दश कन्याः प्रदीपान् गृह्लत्यो वरं साक्षात् कर्त्तुं बहिरिताः, ताभिस्तदा स्वर्गीयराज्यस्य सादृश्यं भविष्यति।</para>
  <para style="p">
    <verse number="2" style="v"/>तासां कन्यानां मध्ये पञ्च सुधियः पञ्च दुर्धिय आसन्।</para>
  <para style="p">
    <verse number="3" style="v"/>या दुर्धियस्ताः प्रदीपान् सङ्गे गृहीत्वा तैलं न जगृहुः,</para>
  <para style="p">
    <verse number="4" style="v"/>किन्तु सुधियः प्रदीपान् पात्रेण तैलञ्च जगृहुः।</para>
  <para style="p">
    <verse number="5" style="v"/>अनन्तरं वरे विलम्बिते ताः सर्व्वा निद्राविष्टा निद्रां जग्मुः।</para>
  <para style="p">
    <verse number="6" style="v"/>अनन्तरम् अर्द्धरात्रे पश्यत वर आगच्छति, तं साक्षात् कर्त्तुं बहिर्यातेति जनरवात्</para>
  <para style="p">
    <verse number="7" style="v"/>ताः सर्व्वाः कन्या उत्थाय प्रदीपान् आसादयितुं आरभन्त।</para>
  <para style="p">
    <verse number="8" style="v"/>ततो दुर्धियः सुधिय ऊचुः, किञ्चित् तैलं दत्त, प्रदीपा अस्माकं निर्व्वाणाः।</para>
  <para style="p">
    <verse number="9" style="v"/>किन्तु सुधियः प्रत्यवदन्, दत्ते युष्मानस्मांश्च प्रति तैलं न्यूनीभवेत्, तस्माद् विक्रेतृणां समीपं गत्वा स्वार्थं तैलं क्रीणीत।</para>
  <para style="p">
    <verse number="10" style="v"/>तदा तासु क्रेतुं गतासु वर आजगाम, ततो याः सज्जिता आसन्, तास्तेन साकं विवाहीयं वेश्म प्रविविशुः।</para>
  <para style="p">
    <verse number="11" style="v"/>अनन्तरं द्वारे रुद्धे अपराः कन्या आगत्य जगदुः, हे प्रभो, हे प्रभो, अस्मान् प्रति द्वारं मोचय।</para>
  <para style="p">
    <verse number="12" style="v"/>किन्तु स उक्तवान्, तथ्यं वदामि, युष्मानहं न वेद्मि।</para>
  <para style="p">
    <verse number="13" style="v"/>अतो जाग्रतः सन्तस्तिष्ठत, मनुजसुतः कस्मिन् दिने कस्मिन् दण्डे वागमिष्यति, तद् युष्माभि र्न ज्ञायते।</para>
  <para style="p">
    <verse number="14" style="v"/>अपरं स एतादृशः कस्यचित् पुंसस्तुल्यः, यो दूरदेशं प्रति यात्राकाले निजदासान् आहूय तेषां स्वस्वसामर्थ्यानुरूपम्</para>
  <para style="p">
    <verse number="15" style="v"/>एकस्मिन् मुद्राणां पञ्च पोटलिकाः अन्यस्मिंश्च द्वे पोटलिके अपरस्मिंश्च पोटलिकैकाम् इत्थं प्रतिजनं समर्प्य स्वयं प्रवासं गतवान्।</para>
  <para style="p">
    <verse number="16" style="v"/>अनन्तरं यो दासः पञ्च पोटलिकाः लब्धवान्, स गत्वा वाणिज्यं विधाय ता द्विगुणीचकार।</para>
  <para style="p">
    <verse number="17" style="v"/>यश्च दासो द्वे पोटलिके अलभत, सोपि ता मुद्रा द्विगुणीचकार।</para>
  <para style="p">
    <verse number="18" style="v"/>किन्तु यो दास एकां पोटलिकां लब्धवान्, स गत्वा भूमिं खनित्वा तन्मध्ये निजप्रभोस्ता मुद्रा गोपयाञ्चकार।</para>
  <para style="p">
    <verse number="19" style="v"/>तदनन्तरं बहुतिथे काले गते तेषां दासानां प्रभुरागत्य तैर्दासैः समं गणयाञ्चकार।</para>
  <para style="p">
    <verse number="20" style="v"/>तदानीं यः पञ्च पोटलिकाः प्राप्तवान् स ता द्विगुणीकृतमुद्रा आनीय जगाद; हे प्रभो, भवता मयि पञ्च पोटलिकाः समर्पिताः, पश्यतु, ता मया द्विगुणीकृताः।</para>
  <para style="p">
    <verse number="21" style="v"/>तदानीं तस्य प्रभुस्तमुवाच, हे उत्तम विश्वास्य दास, त्वं धन्योसि, स्तोकेन विश्वास्यो जातः, तस्मात् त्वां बहुवित्ताधिपं करोमि, त्वं स्वप्रभोः सुखस्य भागी भव।</para>
  <para style="p">
    <verse number="22" style="v"/>ततो येन द्वे पोटलिके लब्धे सोप्यागत्य जगाद, हे प्रभो, भवता मयि द्वे पोटलिके समर्पिते, पश्यतु ते मया द्विगुणीकृते।</para>
  <para style="p">
    <verse number="23" style="v"/>तेन तस्य प्रभुस्तमवोचत्, हे उत्तम विश्वास्य दास, त्वं धन्योसि, स्तोकेन विश्वास्यो जातः, तस्मात् त्वां बहुद्रविणाधिपं करोमि, त्वं निजप्रभोः सुखस्य भागी भव।</para>
  <para style="p">
    <verse number="24" style="v"/>अनन्तरं य एकां पोटलिकां लब्धवान्, स एत्य कथितवान्, हे प्रभो, त्वां कठिननरं ज्ञातवान्, त्वया यत्र नोप्तं, तत्रैव कृत्यते, यत्र च न कीर्णं, तत्रैव संगृह्यते।</para>
  <para style="p">
    <verse number="25" style="v"/>अतोहं सशङ्कः सन् गत्वा तव मुद्रा भूमध्ये संगोप्य स्थापितवान्, पश्य, तव यत् तदेव गृहाण।</para>
  <para style="p">
    <verse number="26" style="v"/>तदा तस्य प्रभुः प्रत्यवदत् रे दुष्टालस दास, यत्राहं न वपामि, तत्र छिनद्मि, यत्र च न किरामि, तत्रेव संगृह्लामीति चेदजानास्तर्हि</para>
  <para style="p">
    <verse number="27" style="v"/>वणिक्षु मम वित्तार्पणं तवोचितमासीत्, येनाहमागत्य वृद्व्या साकं मूलमुद्राः प्राप्स्यम्।</para>
  <para style="p">
    <verse number="28" style="v"/>अतोस्मात् तां पोटलिकाम् आदाय यस्य दश पोटलिकाः सन्ति तस्मिन्नर्पयत।</para>
  <para style="p">
    <verse number="29" style="v"/>येन वर्द्व्यते तस्मिन्नैवार्पिष्यते, तस्यैव च बाहुल्यं भविष्यति, किन्तु येन न वर्द्व्यते, तस्यान्तिके यत् किञ्चन तिष्ठति, तदपि पुनर्नेष्यते।</para>
  <para style="p">
    <verse number="30" style="v"/>अपरं यूयं तमकर्म्मण्यं दासं नीत्वा यत्र स्थाने क्रन्दनं दन्तघर्षणञ्च विद्येते, तस्मिन् बहिर्भूततमसि निक्षिपत।</para>
  <para style="p">
    <verse number="31" style="v"/>यदा मनुजसुतः पवित्रदूतान् सङ्गिनः कृत्वा निजप्रभावेनागत्य निजतेजोमये सिंहासने निवेक्ष्यति,</para>
  <para style="p">
    <verse number="32" style="v"/>तदा तत्सम्मुखे सर्व्वजातीया जना संमेलिष्यन्ति। ततो मेषपालको यथा छागेभ्योऽवीन् पृथक् करोति तथा सोप्येकस्मादन्यम् इत्थं तान् पृथक कृत्वावीन्</para>
  <para style="p">
    <verse number="33" style="v"/>दक्षिणे छागांश्च वामे स्थापयिष्यति।</para>
  <para style="p">
    <verse number="34" style="v"/>ततः परं राजा दक्षिणस्थितान् मानवान् वदिष्यति, आगच्छत मत्तातस्यानुग्रहभाजनानि, युष्मत्कृत आ जगदारम्भत् यद् राज्यम् आसादितं तदधिकुरुत।</para>
  <para style="p">
    <verse number="35" style="v"/>यतो बुभुक्षिताय मह्यं भोज्यम् अदत्त, पिपासिताय पेयमदत्त, विदेशिनं मां स्वस्थानमनयत,</para>
  <para style="p">
    <verse number="36" style="v"/>वस्त्रहीनं मां वसनं पर्य्यधापयत, पीडीतं मां द्रष्टुमागच्छत, कारास्थञ्च मां वीक्षितुम आगच्छत।</para>
  <para style="p">
    <verse number="37" style="v"/>तदा धार्म्मिकाः प्रतिवदिष्यन्ति, हे प्रभो, कदा त्वां क्षुधितं वीक्ष्य वयमभोजयाम? वा पिपासितं वीक्ष्य अपाययाम?</para>
  <para style="p">
    <verse number="38" style="v"/>कदा वा त्वां विदेशिनं विलोक्य स्वस्थानमनयाम? कदा वा त्वां नग्नं वीक्ष्य वसनं पर्य्यधापयाम?</para>
  <para style="p">
    <verse number="39" style="v"/>कदा वा त्वां पीडितं कारास्थञ्च वीक्ष्य त्वदन्तिकमगच्छाम?</para>
  <para style="p">
    <verse number="40" style="v"/>तदानीं राजा तान् प्रतिवदिष्यति, युष्मानहं सत्यं वदामि, ममैतेषां भ्रातृणां मध्ये कञ्चनैकं क्षुद्रतमं प्रति यद् अकुरुत, तन्मां प्रत्यकुरुत।</para>
  <para style="p">
    <verse number="41" style="v"/>पश्चात् स वामस्थितान् जनान् वदिष्यति, रे शापग्रस्ताः सर्व्वे, शैताने तस्य दूतेभ्यश्च योऽनन्तवह्निरासादित आस्ते, यूयं मदन्तिकात् तमग्निं गच्छत।</para>
  <para style="p">
    <verse number="42" style="v"/>यतो क्षुधिताय मह्यमाहारं नादत्त, पिपासिताय मह्यं पेयं नादत्त,</para>
  <para style="p">
    <verse number="43" style="v"/>विदेशिनं मां स्वस्थानं नानयत, वसनहीनं मां वसनं न पर्य्यधापयत, पीडितं कारास्थञ्च मां वीक्षितुं नागच्छत।</para>
  <para style="p">
    <verse number="44" style="v"/>तदा ते प्रतिवदिष्यन्ति, हे प्रभो, कदा त्वां क्षुधितं वा पिपासितं वा विदेशिनं वा नग्नं वा पीडितं वा कारास्थं वीक्ष्य त्वां नासेवामहि?</para>
  <para style="p">
    <verse number="45" style="v"/>तदा स तान् वदिष्यति, तथ्यमहं युष्मान् ब्रवीमि, युष्माभिरेषां कञ्चन क्षोदिष्ठं प्रति यन्नाकारि, तन्मां प्रत्येव नाकारि।</para>
  <para style="p">
    <verse number="46" style="v"/>पश्चादम्यनन्तशास्तिं किन्तु धार्म्मिका अनन्तायुषं भोक्तुं यास्यन्ति।</para>
  <chapter number="26" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>यीशुरेतान् प्रस्तावान् समाप्य शिष्यानूचे,</para>
  <para style="p">
    <verse number="2" style="v"/>युष्माभि र्ज्ञातं दिनद्वयात् परं निस्तारमह उपस्थास्यति, तत्र मनुजसुतः क्रुशेन हन्तुं परकरेषु समर्पिष्यते।</para>
  <para style="p">
    <verse number="3" style="v"/>ततः परं प्रधानयाजकाध्यापकप्राञ्चः कियफानाम्नो महायाजकस्याट्टालिकायां मिलित्वा</para>
  <para style="p">
    <verse number="4" style="v"/>केनोपायेन यीशुं धृत्वा हन्तुं शक्नुयुरिति मन्त्रयाञ्चक्रुः।</para>
  <para style="p">
    <verse number="5" style="v"/>किन्तु तैरुक्तं महकाले न धर्त्तव्यः, धृते प्रजानां कलहेन भवितुं शक्यते।</para>
  <para style="p">
    <verse number="6" style="v"/>ततो बैथनियापुरे शिमोनाख्यस्य कुष्ठिनो वेश्मनि यीशौ तिष्ठति</para>
  <para style="p">
    <verse number="7" style="v"/>काचन योषा श्वेतोपलभाजनेन महार्घ्यं सुगन्धि तैलमानीय भोजनायोपविशतस्तस्य शिरोभ्यषेचत्।</para>
  <para style="p">
    <verse number="8" style="v"/>किन्तु तदालोक्य तच्छिष्यैः कुपितैरुक्तं, कुत इत्थमपव्ययते?</para>
  <para style="p">
    <verse number="9" style="v"/>चेदिदं व्यक्रेष्यत, तर्हि भूरिमूल्यं प्राप्य दरिद्रेभ्यो व्यतारिष्यत।</para>
  <para style="p">
    <verse number="10" style="v"/>यीशुना तदवगत्य ते समुदिताः, योषामेनां कुतो दुःखिनीं कुरुथ, सा मां प्रति साधु कर्म्माकार्षीत्।</para>
  <para style="p">
    <verse number="11" style="v"/>युष्माकमं समीपे दरिद्राः सततमेवासते, किन्तु युष्माकमन्तिकेहं नासे सततं।</para>
  <para style="p">
    <verse number="12" style="v"/>सा मम कायोपरि सुगन्धितैलं सिक्त्वा मम श्मशानदानकर्म्माकार्षीत्।</para>
  <para style="p">
    <verse number="13" style="v"/>अतोहं युष्मान् तथ्यं वदामि सर्व्वस्मिन् जगति यत्र यत्रैष सुसमाचारः प्रचारिष्यते, तत्र तत्रैतस्या नार्य्याः स्मरणार्थम् कर्म्मेदं प्रचारिष्यते।</para>
  <para style="p">
    <verse number="14" style="v"/>ततो द्वादशशिष्याणाम् ईष्करियोतीययिहूदानामक एकः शिष्यः प्रधानयाजकानामन्तिकं गत्वा कथितवान्,</para>
  <para style="p">
    <verse number="15" style="v"/>यदि युष्माकं करेषु यीशुं समर्पयामि, तर्हि किं दास्यथ? तदानीं ते तस्मै त्रिंशन्मुद्रा दातुं स्थिरीकृतवन्तः।</para>
  <para style="p">
    <verse number="16" style="v"/>स तदारभ्य तं परकरेषु समर्पयितुं सुयोगं चेष्टितवान्।</para>
  <para style="p">
    <verse number="17" style="v"/>अनन्तरं किण्वशून्यपूपपर्व्वणः प्रथमेह्नि शिष्या यीशुम् उपगत्य पप्रच्छुः भवत्कृते कुत्र वयं निस्तारमहभोज्यम् आयोजयिष्यामः? भवतः केच्छा?</para>
  <para style="p">
    <verse number="18" style="v"/>तदा स गदितवान्, मध्येनगरममुकपुंसः समीपं व्रजित्वा वदत, गुरु र्गदितवान्, मत्कालः सविधः, सह शिष्यैस्त्वदालये निस्तारमहभोज्यं भोक्ष्ये।</para>
  <para style="p">
    <verse number="19" style="v"/>तदा शिष्या यीशोस्तादृशनिदेशानुरूपकर्म्म विधाय तत्र निस्तारमहभोज्यमासादयामासुः।</para>
  <para style="p">
    <verse number="20" style="v"/>ततः सन्ध्यायां सत्यां द्वादशभिः शिष्यैः साकं स न्यविशत्।</para>
  <para style="p">
    <verse number="21" style="v"/>अपरं भुञ्जान उक्तवान् युष्मान् तथ्यं वदामि, युष्माकमेको मां परकरेषु समर्पयिष्यति।</para>
  <para style="p">
    <verse number="22" style="v"/>तदा तेऽतीव दुःखिता एकैकशो वक्तुमारेभिरे, हे प्रभो, स किमहं?</para>
  <para style="p">
    <verse number="23" style="v"/>ततः स जगाद, मया साकं यो जनो भोजनपात्रे करं संक्षिपति, स एव मां परकरेषु समर्पयिष्यति।</para>
  <para style="p">
    <verse number="24" style="v"/>मनुजसुतमधि यादृशं लिखितमास्ते, तदनुरूपा तद्गति र्भविष्यति; किन्तु येन पुंसा स परकरेषु समर्पयिष्यते, हा हा चेत् स नाजनिष्यत, तदा तस्य क्षेममभविष्यत्।</para>
  <para style="p">
    <verse number="25" style="v"/>तदा यिहूदानामा यो जनस्तं परकरेषु समर्पयिष्यति, स उक्तवान्, हे गुरो, स किमहं? ततः स प्रत्युक्तवान्, त्वया सत्यं गदितम्।</para>
  <para style="p">
    <verse number="26" style="v"/>अनन्तरं तेषामशनकाले यीशुः पूपमादायेश्वरीयगुणाननूद्य भंक्त्वा शिष्येभ्यः प्रदाय जगाद, मद्वपुःस्वरूपमिमं गृहीत्वा खादत।</para>
  <para style="p">
    <verse number="27" style="v"/>पश्चात् स कंसं गृह्लन् ईश्वरीयगुणाननूद्य तेभ्यः प्रदाय कथितवान्, सर्व्वै र्युष्माभिरनेन पातव्यं,</para>
  <para style="p">
    <verse number="28" style="v"/>यस्मादनेकेषां पापमर्षणाय पातितं यन्मन्नूत्ननियमरूपशोणितं तदेतत्।</para>
  <para style="p">
    <verse number="29" style="v"/>अपरमहं नूत्नगोस्तनीरसं न पास्यामि, तावत् गोस्तनीफलरसं पुनः कदापि न पास्यामि।</para>
  <para style="p">
    <verse number="30" style="v"/>पश्चात् ते गीतमेकं संगीय जैतुनाख्यगिरिं गतवन्तः।</para>
  <para style="p">
    <verse number="31" style="v"/>तदानीं यीशुस्तानवोचत्, अस्यां रजन्यामहं युष्माकं सर्व्वेषां विघ्नरूपो भविष्यामि, यतो लिखितमास्ते, "मेषाणां रक्षको यस्तं प्रहरिष्याम्यहं ततः। मेषाणां निवहो नूनं प्रविकीर्णो भविष्यति"॥</para>
  <para style="p">
    <verse number="32" style="v"/>किन्तु श्मशानात् समुत्थाय युष्माकमग्रेऽहं गालीलं गमिष्यामि।</para>
  <para style="p">
    <verse number="33" style="v"/>पितरस्तं प्रोवाच, भवांश्चेत् सर्व्वेषां विघ्नरूपो भवति, तथापि मम न भविष्यति।</para>
  <para style="p">
    <verse number="34" style="v"/>ततो यीशुना स उक्तः, तुभ्यमहं तथ्यं कथयामि, यामिन्यामस्यां चरणायुधस्य रवात् पूर्व्वं त्वं मां त्रि र्नाङ्गीकरिष्यसि।</para>
  <para style="p">
    <verse number="35" style="v"/>ततः पितर उदितवान्, यद्यपि त्वया समं मर्त्तव्यं, तथापि कदापि त्वां न नाङ्गीकरिष्यामि; तथैव सर्व्वे शिष्याश्चोचुः।</para>
  <para style="p">
    <verse number="36" style="v"/>अनन्तरं यीशुः शिष्यैः साकं गेत्शिमानीनामकं स्थानं प्रस्थाय तेभ्यः कथितवान्, अदः स्थानं गत्वा यावदहं प्रार्थयिष्ये तावद् यूयमत्रोपविशत।</para>
  <para style="p">
    <verse number="37" style="v"/>पश्चात् स पितरं सिवदियसुतौ च सङ्गिनः कृत्वा गतवान्, शोकाकुलोऽतीव व्यथितश्च बभूव।</para>
  <para style="p">
    <verse number="38" style="v"/>तानवादीच्च मृतियातनेव मत्प्राणानां यातना जायते, यूयमत्र मया सार्द्धं जागृत।</para>
  <para style="p">
    <verse number="39" style="v"/>ततः स किञ्चिद्दूरं गत्वाधोमुखः पतन् प्रार्थयाञ्चक्रे, हे मत्पितर्यदि भवितुं शक्नोति, तर्हि कंसोऽयं मत्तो दूरं यातु; किन्तु मदिच्छावत् न भवतु, त्वदिच्छावद् भवतु।</para>
  <para style="p">
    <verse number="40" style="v"/>ततः स शिष्यानुपेत्य तान् निद्रतो निरीक्ष्य पितराय कथयामास, यूयं मया साकं दण्डमेकमपि जागरितुं नाशन्कुत?</para>
  <para style="p">
    <verse number="41" style="v"/>परीक्षायां न पतितुं जागृत प्रार्थयध्वञ्च; आत्मा समुद्यतोस्ति, किन्तु वपु र्दुर्ब्बलं।</para>
  <para style="p">
    <verse number="42" style="v"/>स द्वितीयवारं प्रार्थयाञ्चक्रे, हे मत्तात, न पीते यदि कंसमिदं मत्तो दूरं यातुं न शक्नोति, तर्हि त्वदिच्छावद् भवतु।</para>
  <para style="p">
    <verse number="43" style="v"/>स पुनरेत्य तान् निद्रतो ददर्श, यतस्तेषां नेत्राणि निद्रया पूर्णान्यासन्।</para>
  <para style="p">
    <verse number="44" style="v"/>पश्चात् स तान् विहाय व्रजित्वा तृतीयवारं पूर्व्ववत् कथयन् प्रार्थितवान्।</para>
  <para style="p">
    <verse number="45" style="v"/>ततः शिष्यानुपागत्य गदितवान्, साम्प्रतं शयानाः किं विश्राम्यथ? पश्यत, समय उपास्थात्, मनुजसुतः पापिनां करेषु समर्प्यते।</para>
  <para style="p">
    <verse number="46" style="v"/>उत्तिष्ठत, वयं यामः, यो मां परकरेषु मसर्पयिष्यति, पश्यत, स समीपमायाति।</para>
  <para style="p">
    <verse number="47" style="v"/>एतत्कथाकथनकाले द्वादशशिष्याणामेको यिहूदानामको मुख्ययाजकलोकप्राचीनैः प्रहितान् असिधारियष्टिधारिणो मनुजान् गृहीत्वा तत्समीपमुपतस्थौ।</para>
  <para style="p">
    <verse number="48" style="v"/>असौ परकरेष्वर्पयिता पूर्व्वं तान् इत्थं सङ्केतयामास, यमहं चुम्बिष्ये, सोऽसौ मनुजः,सएव युष्माभि र्धार्य्यतां।</para>
  <para style="p">
    <verse number="49" style="v"/>तदा स सपदि यीशुमुपागत्य हे गुरो, प्रणमामीत्युक्त्वा तं चुचुम्बे।</para>
  <para style="p">
    <verse number="50" style="v"/>तदा यीशुस्तमुवाच, हे मित्रं किमर्थमागतोसि? तदा तैरागत्य यीशुराक्रम्य दघ्रे।</para>
  <para style="p">
    <verse number="51" style="v"/>ततो यीशोः सङ्गिनामेकः करं प्रसार्य्य कोषादसिं बहिष्कृत्य महायाजकस्य दासमेकमाहत्य तस्य कर्णं चिच्छेद।</para>
  <para style="p">
    <verse number="52" style="v"/>ततो यीशुस्तं जगाद, खड्गं स्वस्थानेे निधेहि यतो ये ये जना असिं धारयन्ति, तएवासिना विनश्यन्ति।</para>
  <para style="p">
    <verse number="53" style="v"/>अपरं पिता यथा मदन्तिकं स्वर्गीयदूतानां द्वादशवाहिनीतोऽधिकं प्रहिणुयात् मया तमुद्दिश्येदानीमेव तथा प्रार्थयितुं न शक्यते, त्वया किमित्थं ज्ञायते?</para>
  <para style="p">
    <verse number="54" style="v"/>तथा सतीत्थं घटिष्यते धर्म्मपुस्तकस्य यदिदं वाक्यं तत् कथं सिध्येत्?</para>
  <para style="p">
    <verse number="55" style="v"/>तदानीं यीशु र्जननिवहं जगाद, यूयं खड्गयष्टीन् आदाय मां किं चौरं धर्त्तुमायाताः? अहं प्रत्यहं युष्माभिः साकमुपविश्य समुपादिशं, तदा मां नाधरत;</para>
  <para style="p">
    <verse number="56" style="v"/>किन्तु भविष्यद्वादिनां वाक्यानां संसिद्धये सर्व्वमेतदभूत्।तदा सर्व्वे शिष्यास्तं विहाय पलायन्त।</para>
  <para style="p">
    <verse number="57" style="v"/>अनन्तरं ते मनुजा यीशुं धृत्वा यत्राध्यापकप्राञ्चः परिषदं कुर्व्वन्त उपाविशन् तत्र कियफानाामकमहायाजकस्यान्तिकं निन्युः।</para>
  <para style="p">
    <verse number="58" style="v"/>किन्तु शेषे किं भविष्यतीति वेत्तुं पितरो दूरे तत्पश्चाद् व्रजित्वा महायाजकस्याट्टालिकां प्रविश्य दासैः सहित उपाविशत्।</para>
  <para style="p">
    <verse number="59" style="v"/>तदानीं प्रधानयाजकप्राचीनमन्त्रिणः सर्व्वे यीशुं हन्तुं मृषासाक्ष्यम् अलिप्सन्त,</para>
  <para style="p">
    <verse number="60" style="v"/>किन्तु न लेभिरे। अनेकेषु मृषासाक्षिष्वागतेष्वपि तन्न प्रापुः।</para>
  <para style="p">
    <verse number="61" style="v"/>शेषे द्वौ मृषासाक्षिणावागत्य जगदतुः, पुमानयमकथयत्, अहमीश्वरमन्दिरं भंक्त्वा दिनत्रयमध्ये तन्निर्म्मातुं शक्नोमि।</para>
  <para style="p">
    <verse number="62" style="v"/>तदा महायाजक उत्थाय यीशुम् अवादीत्। त्वं किमपि न प्रतिवदसि? त्वामधि किमेते साक्ष्यं वदन्ति?</para>
  <para style="p">
    <verse number="63" style="v"/>किन्तु यीशु र्मौनीभूय तस्यौ। ततो महायाजक उक्तवान्, त्वाम् अमरेश्वरनाम्ना शपयामि, त्वमीश्वरस्य पुत्रोऽभिषिक्तो भवसि नवेति वद।</para>
  <para style="p">
    <verse number="64" style="v"/>यीशुः प्रत्यवदत्, त्वं सत्यमुक्तवान्; अहं युष्मान् तथ्यं वदामि, इतःपरं मनुजसुतं सर्व्वशक्तिमतो दक्षिणपार्श्वे स्थातुं गगणस्थं जलधरानारुह्यायान्तं वीक्षध्वे।</para>
  <para style="p">
    <verse number="65" style="v"/>तदा महायाजको निजवसनं छित्त्वा जगाद, एष ईश्वरं निन्दितवान्, अस्माकमपरसाक्ष्येण किं प्रयोजनं? पश्यत, यूयमेवास्यास्याद् ईश्वरनिन्दां श्रुतवन्तः,</para>
  <para style="p">
    <verse number="66" style="v"/>युष्माभिः किं विविच्यते? ते प्रत्यूचुः, वधार्होऽयं।</para>
  <para style="p">
    <verse number="67" style="v"/>ततो लोकैस्तदास्ये निष्ठीवितं केचित् प्रतलमाहत्य केचिच्च चपेटमाहत्य बभाषिरे,</para>
  <para style="p">
    <verse number="68" style="v"/>हे ख्रीष्ट त्वां कश्चपेटमाहतवान्? इति गणयित्वा वदास्मान्।</para>
  <para style="p">
    <verse number="69" style="v"/>पितरो बहिरङ्गन उपविशति, तदानीमेका दासी तमुपागत्य बभाषे, त्वं गालीलीययीशोः सहचरएकः।</para>
  <para style="p">
    <verse number="70" style="v"/>किन्तु स सर्व्वेषां समक्षम् अनङ्गीकृत्यावादीत्, त्वया यदुच्यते, तदर्थमहं न वेद्मि।</para>
  <para style="p">
    <verse number="71" style="v"/>तदा तस्मिन् बहिर्द्वारं गते ऽन्या दासी तं निरीक्ष्य तत्रत्यजनानवदत्, अयमपि नासरतीययीशुना सार्द्धम् आसीत्।</para>
  <para style="p">
    <verse number="72" style="v"/>ततः स शपथेन पुनरनङ्गीकृत्य कथितवान्, तं नरं न परिचिनोमि।</para>
  <para style="p">
    <verse number="73" style="v"/>क्षणात् परं तिष्ठन्तो जना एत्य पितरम् अवदन्, त्वमवश्यं तेषामेक इति त्वदुच्चारणमेव द्योतयति।</para>
  <para style="p">
    <verse number="74" style="v"/>किन्तु सोऽभिशप्य कथितवान्, तं जनं नाहं परिचिनोमि, तदा सपदि कुक्कुटो रुराव।</para>
  <para style="p">
    <verse number="75" style="v"/>कुक्कुटरवात् प्राक् त्वं मां त्रिरपाह्नोष्यसे, यैषा वाग् यीशुनावादि तां पितरः संस्मृत्य बहिरित्वा खेदाद् भृशं चक्रन्द।</para>
  <chapter number="27" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>प्रभाते जाते प्रधानयाजकलोकप्राचीना यीशुं हन्तुं तत्प्रतिकूलं मन्त्रयित्वा</para>
  <para style="p">
    <verse number="2" style="v"/>तं बद्व्वा नीत्वा पन्तीयपीलाताख्याधिपे समर्पयामासुः।</para>
  <para style="p">
    <verse number="3" style="v"/>ततो यीशोः परकरेव्वर्पयिता यिहूदास्तत्प्राणादण्डाज्ञां विदित्वा सन्तप्तमनाः प्रधानयाजकलोकप्राचीनानां समक्षं तास्त्रींशन्मुद्राः प्रतिदायावादीत्,</para>
  <para style="p">
    <verse number="4" style="v"/>एतन्निरागोनरप्राणपरकरार्पणात् कलुषं कृतवानहं। तदा त उदितवन्तः, तेनास्माकं किं? त्वया तद् बुध्यताम्।</para>
  <para style="p">
    <verse number="5" style="v"/>ततो यिहूदा मन्दिरमध्ये ता मुद्रा निक्षिप्य प्रस्थितवान् इत्वा च स्वयमात्मानमुद्बबन्ध।</para>
  <para style="p">
    <verse number="6" style="v"/>पश्चात् प्रधानयाजकास्ता मुद्रा आदाय कथितवन्तः, एता मुद्राः शोणितमूल्यं तस्माद् भाण्डागारे न निधातव्याः।</para>
  <para style="p">
    <verse number="7" style="v"/>अनन्तरं ते मन्त्रयित्वा विदेशिनां श्मशानस्थानाय ताभिः कुलालस्य क्षेत्रमक्रीणन्।</para>
  <para style="p">
    <verse number="8" style="v"/>अतोऽद्यापि तत्स्थानं रक्तक्षेत्रं वदन्ति।</para>
  <para style="p">
    <verse number="9" style="v"/>इत्थं सति इस्रायेलीयसन्तानै र्यस्य मूल्यं निरुपितं, तस्य त्रिंशन्मुद्रामानं मूल्यं</para>
  <para style="p">
    <verse number="10" style="v"/>मां प्रति परमेश्वरस्यादेशात् तेभ्य आदीयत, तेन च कुलालस्य क्षेत्रं क्रीतमिति यद्वचनं यिरिमियभविष्यद्वादिना प्रोक्तं तत् तदासिध्यत्।</para>
  <para style="p">
    <verse number="11" style="v"/>अनन्तरं यीशौ तदधिपतेः सम्मुख उपतिष्ठति स तं पप्रच्छ, त्वं किं यिहूदीयानां राजा? तदा यीशुस्तमवदत्, त्वं सत्यमुक्तवान्।</para>
  <para style="p">
    <verse number="12" style="v"/>किन्तु प्रधानयाजकप्राचीनैरभियुक्तेन तेन किमपि न प्रत्यवादि।</para>
  <para style="p">
    <verse number="13" style="v"/>ततः पीलातेन स उदितः, इमे त्वत्प्रतिकूलतः कति कति साक्ष्यं ददति, तत् त्वं न शृणोषि?</para>
  <para style="p">
    <verse number="14" style="v"/>तथापि स तेषामेकस्यापि वचस उत्तरं नोदितवान्; तेन सोऽधिपति र्महाचित्रं विदामास।</para>
  <para style="p">
    <verse number="15" style="v"/>अन्यच्च तन्महकालेऽधिपतेरेतादृशी रातिरासीत्, प्रजा यं कञ्चन बन्धिनं याचन्ते, तमेव स मोचयतीति।</para>
  <para style="p">
    <verse number="16" style="v"/>तदानीं बरब्बानामा कश्चित् ख्यातबन्ध्यासीत्।</para>
  <para style="p">
    <verse number="17" style="v"/>ततः पीलातस्तत्र मिलितान् लोकान् अपृच्छत्, एष बरब्बा बन्धी ख्रीष्टविख्यातो यीशुश्चैतयोः कं मोचयिष्यामि? युष्माकं किमीप्सितं?</para>
  <para style="p">
    <verse number="18" style="v"/>तैरीर्ष्यया स समर्पित इति स ज्ञातवान्।</para>
  <para style="p">
    <verse number="19" style="v"/>अपरं विचारासनोपवेशनकाले पीलातस्य पत्नी भृत्यं प्रहित्य तस्मै कथयामास, तं धार्म्मिकमनुजं प्रति त्वया किमपि न कर्त्तव्यं; यस्मात् तत्कृतेऽद्याहं स्वप्ने प्रभूतकष्टमलभे।</para>
  <para style="p">
    <verse number="20" style="v"/>अनन्तरं प्रधानयाजकप्राचीना बरब्बां याचित्वादातुं यीशुञ्च हन्तुं सकललोकान् प्रावर्त्तयन्।</para>
  <para style="p">
    <verse number="21" style="v"/>ततोऽधिपतिस्तान् पृष्टवान्, एतयोः कमहं मोचयिष्यामि? युष्माकं केच्छा? ते प्रोचु र्बरब्बां।</para>
  <para style="p">
    <verse number="22" style="v"/>तदा पीलातः पप्रच्छ, तर्हि यं ख्रीष्टं वदन्ति, तं यीशुं किं करिष्यामि? सर्व्वे कथयामासुः, स क्रुशेन विध्यतां।</para>
  <para style="p">
    <verse number="23" style="v"/>ततोऽधिपतिरवादीत्, कुतः? किं तेनापराद्धं? किन्तु ते पुनरुचै र्जगदुः, स क्रुशेन विध्यतां।</para>
  <para style="p">
    <verse number="24" style="v"/>तदा निजवाक्यमग्राह्यमभूत्, कलहश्चाप्यभूत्, पीलात इति विलोक्य लोकानां समक्षं तोयमादाय करौ प्रक्षाल्यावोचत्, एतस्य धार्म्मिकमनुष्यस्य शोणितपाते निर्दोषोऽहं, युष्माभिरेव तद् बुध्यतां।</para>
  <para style="p">
    <verse number="25" style="v"/>तदा सर्व्वाः प्रजाः प्रत्यवोचन्, तस्य शोणितपातापराधोऽस्माकम् अस्मत्सन्तानानाञ्चोपरि भवतु।</para>
  <para style="p">
    <verse number="26" style="v"/>ततः स तेषां समीपे बरब्बां मोचयामास यीशुन्तु कषाभिराहत्य क्रुशेन वेधितुं समर्पयामास।</para>
  <para style="p">
    <verse number="27" style="v"/>अनन्तरम् अधिपतेः सेना अधिपते र्गृहं यीशुमानीय तस्य समीपे सेनासमूहं संजगृहुः।</para>
  <para style="p">
    <verse number="28" style="v"/>ततस्ते तस्य वसनं मोचयित्वा कृष्णलोहितवर्णवसनं परिधापयामासुः</para>
  <para style="p">
    <verse number="29" style="v"/>कण्टकानां मुकुटं निर्म्माय तच्छिरसि ददुः, तस्य दक्षिणकरे वेत्रमेकं दत्त्वा तस्य सम्मुखे जानूनि पातयित्वा, हे यिहूदीयानां राजन्, तुभ्यं नम इत्युक्त्वा तं तिरश्चक्रुः,</para>
  <para style="p">
    <verse number="30" style="v"/>ततस्तस्य गात्रे निष्ठीवं दत्वा तेन वेत्रेण शिर आजघ्नुः।</para>
  <para style="p">
    <verse number="31" style="v"/>इत्थं तं तिरस्कृत्य तद् वसनं मोचयित्वा पुनर्निजवसनं परिधापयाञ्चक्रुः, तं क्रुशेन वेधितुं नीतवन्तः।</para>
  <para style="p">
    <verse number="32" style="v"/>पश्चात्ते बहिर्भूय कुरीणीयं शिमोन्नामकमेकं विलोक्य क्रुशं वोढुं तमाददिरे।</para>
  <para style="p">
    <verse number="33" style="v"/>अनन्तरं गुल्गल्ताम् अर्थात् शिरस्कपालनामकस्थानमु पस्थाय ते यीशवे पित्तमिश्रिताम्लरसं पातुं ददुः,</para>
  <para style="p">
    <verse number="34" style="v"/>किन्तु स तमास्वाद्य न पपौ।</para>
  <para style="p">
    <verse number="35" style="v"/>तदानीं ते तं क्रुशेन संविध्य तस्य वसनानि गुटिकापातेन विभज्य जगृहुः, तस्मात्, विभजन्तेऽधरीयं मे ते मनुष्याः परस्परं। मदुत्तरीयवस्त्रार्थं गुटिकां पातयन्ति च॥यदेतद्वचनं भविष्यद्वादिभिरुक्तमासीत्, तदा तद् असिध्यत्,</para>
  <para style="p">
    <verse number="36" style="v"/>पश्चात् ते तत्रोपविश्य तद्रक्षणकर्व्वणि नियुक्तास्तस्थुः।</para>
  <para style="p">
    <verse number="37" style="v"/>अपरम् एष यिहूदीयानां राजा यीशुरित्यपवादलिपिपत्रं तच्छिरस ऊर्द्व्वे योजयामासुः।</para>
  <para style="p">
    <verse number="38" style="v"/>ततस्तस्य वामे दक्षिणे च द्वौ चैरौ तेन साकं क्रुशेन विविधुः।</para>
  <para style="p">
    <verse number="39" style="v"/>तदा पान्था निजशिरो लाडयित्वा तं निन्दन्तो जगदुः,</para>
  <para style="p">
    <verse number="40" style="v"/>हे ईश्वरमन्दिरभञ्जक दिनत्रये तन्निर्म्मातः स्वं रक्ष, चेत्त्वमीश्वरसुतस्तर्हि क्रुशादवरोह।</para>
  <para style="p">
    <verse number="41" style="v"/>प्रधानयाजकाध्यापकप्राचीनाश्च तथा तिरस्कृत्य जगदुः,</para>
  <para style="p">
    <verse number="42" style="v"/>सोऽन्यजनानावत्, किन्तु स्वमवितुं न शक्नोति। यदीस्रायेलो राजा भवेत्, तर्हीदानीमेव क्रुशादवरोहतु, तेन तं वयं प्रत्येष्यामः।</para>
  <para style="p">
    <verse number="43" style="v"/>स ईश्वरे प्रत्याशामकरोत्, यदीश्वरस्तस्मिन् सन्तुष्टस्तर्हीदानीमेव तमवेत्, यतः स उक्तवान् अहमीश्वरसुतः।</para>
  <para style="p">
    <verse number="44" style="v"/>यौ स्तेनौ साकं तेन क्रुशेन विद्धौ तौ तद्वदेव तं निनिन्दतुः।</para>
  <para style="p">
    <verse number="45" style="v"/>तदा द्वितीययामात् तृतीययामं यावत् सर्व्वदेशे तमिरं बभूव,</para>
  <para style="p">
    <verse number="46" style="v"/>तृतीययामे "एली एली लामा शिवक्तनी", अर्थात् मदीश्वर मदीश्वर कुतो मामत्याक्षीः? यीशुरुच्चैरिति जगाद।</para>
  <para style="p">
    <verse number="47" style="v"/>तदा तत्र स्थिताः केचित् तत् श्रुत्वा बभाषिरे, अयम् एलियमाहूयति।</para>
  <para style="p">
    <verse number="48" style="v"/>तेषां मध्याद् एकः शीघ्रं गत्वा स्पञ्जं गृहीत्वा तत्राम्लरसं दत्त्वा नलेन पातुं तस्मै ददौ।</para>
  <para style="p">
    <verse number="49" style="v"/>इतरेऽकथयन् तिष्ठत, तं रक्षितुम् एलिय आयाति नवेति पश्यामः।</para>
  <para style="p">
    <verse number="50" style="v"/>यीशुः पुनरुचैराहूय प्राणान् जहौ।</para>
  <para style="p">
    <verse number="51" style="v"/>ततो मन्दिरस्य विच्छेदवसनम् ऊर्द्व्वादधो यावत् छिद्यमानं द्विधाभवत्,</para>
  <para style="p">
    <verse number="52" style="v"/>भूमिश्चकम्पे भूधरोव्यदीर्य्यत च। श्मशाने मुक्ते भूरिपुण्यवतां सुप्तदेहा उदतिष्ठन्,</para>
  <para style="p">
    <verse number="53" style="v"/>श्मशानाद् वहिर्भूय तदुत्थानात् परं पुण्यपुरं गत्वा बहुजनान् दर्शयामासुः।</para>
  <para style="p">
    <verse number="54" style="v"/>यीशुरक्षणाय नियुक्तः शतसेनापतिस्तत्सङ्गिनश्च तादृशीं भूकम्पादिघटनां दृष्ट्वा भीता अवदन्, एष ईश्वरपुत्रो भवति।</para>
  <para style="p">
    <verse number="55" style="v"/>या बहुयोषितो यीशुं सेवमाना गालीलस्तत्पश्चादागतास्तासां मध्ये</para>
  <para style="p">
    <verse number="56" style="v"/>मग्दलीनी मरियम् याकूब्योश्यो र्माता या मरियम् सिबदियपुत्रयो र्माता च योषित एता दूरे तिष्ठन्त्यो ददृशुः।</para>
  <para style="p">
    <verse number="57" style="v"/>सन्ध्यायां सत्यम् अरिमथियानगरस्य यूषफ्नामा धनी मनुजो यीशोः शिष्यत्वात्</para>
  <para style="p">
    <verse number="58" style="v"/>पीलातस्य समीपं गत्वा यीशोः कायं ययाचे, तेन पीलातः कायं दातुम् आदिदेश।</para>
  <para style="p">
    <verse number="59" style="v"/>यूषफ् तत्कायं नीत्वा शुचिवस्त्रेणाच्छाद्य</para>
  <para style="p">
    <verse number="60" style="v"/>स्वार्थं शैले यत् श्मशानं चखान, तन्मध्ये तत्कायं निधाय तस्य द्वारि वृहत्पाषाणं ददौ।</para>
  <para style="p">
    <verse number="61" style="v"/>किन्तु मग्दलीनी मरियम् अन्यमरियम् एते स्त्रियौ तत्र श्मशानसम्मुख उपविविशतुः।</para>
  <para style="p">
    <verse number="62" style="v"/>तदनन्तरं निस्तारोत्सवस्यायोजनदिनात् परेऽहनि प्रधानयाजकाः फिरूशिनश्च मिलित्वा पीलातमुपागत्याकथयन्,</para>
  <para style="p">
    <verse number="63" style="v"/>हे महेच्छ स प्रतारको जीवन अकथयत्, दिनत्रयात् परं श्मशानादुत्थास्यामि तद्वाक्यं स्मरामो वयं;</para>
  <para style="p">
    <verse number="64" style="v"/>तस्मात् तृतीयदिनं यावत् तत् श्मशानं रक्षितुमादिशतु, नोचेत् तच्छिष्या यामिन्यामागत्य तं हृत्वा लोकान् वदिष्यन्ति, स श्मशानादुदतिष्ठत्, तथा सति प्रथमभ्रान्तेः शेषीयभ्रान्ति र्महती भविष्यति।</para>
  <para style="p">
    <verse number="65" style="v"/>तदा पीलात अवादीत्, युष्माकं समीपे रक्षिगण आस्ते, यूयं गत्वा यथा साध्यं रक्षयत।</para>
  <para style="p">
    <verse number="66" style="v"/>ततस्ते गत्वा तद्दूारपाषाणं मुद्राङ्कितं कृत्वा रक्षिगणं नियोज्य श्मशानं रक्षयामासुः।</para>
  <chapter number="28" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ततः परं विश्रामवारस्य शेषे सप्ताहप्रथमदिनस्य प्रभोते जाते मग्दलीनी मरियम् अन्यमरियम् च श्मशानं द्रष्टुमागता।</para>
  <para style="p">
    <verse number="2" style="v"/>तदा महान् भूकम्पोऽभवत्; परमेश्वरीयदूतः स्वर्गादवरुह्य श्मशानद्वारात् पाषाणमपसार्य्य तदुपर्य्युपविवेश।</para>
  <para style="p">
    <verse number="3" style="v"/>तद्वदनं विद्युद्वत् तेजोमयं वसनं हिमशुभ्रञ्च।</para>
  <para style="p">
    <verse number="4" style="v"/>तदानीं रक्षिणस्तद्भयात् कम्पिता मृतवद् बभूवः।</para>
  <para style="p">
    <verse number="5" style="v"/>स दूतो योषितो जगाद, यूयं मा भैष्ट, क्रुशहतयीशुं मृगयध्वे तदहं वेद्मि।</para>
  <para style="p">
    <verse number="6" style="v"/>सोऽत्र नास्ति, यथावदत् तथोत्थितवान्; एतत् प्रभोः शयनस्थानं पश्यत।</para>
  <para style="p">
    <verse number="7" style="v"/>तूर्णं गत्वा तच्छिष्यान् इति वदत, स श्मशानाद् उदतिष्ठत्, युष्माकमग्रे गालीलं यास्यति यूयं तत्र तं वीक्षिष्यध्वे, पश्यताहं वार्त्तामिमां युष्मानवादिषं।</para>
  <para style="p">
    <verse number="8" style="v"/>ततस्ता भयात् महानन्दाञ्च श्मशानात् तूर्णं बहिर्भूय तच्छिष्यान् वार्त्तां वक्तुं धावितवत्यः। किन्तु शिष्यान् वार्त्तां वक्तुं यान्ति, तदा यीशु र्दर्शनं दत्त्वा ता जगाद,</para>
  <para style="p">
    <verse number="9" style="v"/>युष्माकं कल्याणं भूयात्, ततस्ता आगत्य तत्पादयोः पतित्वा प्रणेमुः।</para>
  <para style="p">
    <verse number="10" style="v"/>यीशुस्ता अवादीत्, मा बिभीत, यूयं गत्वा मम भ्रातृन् गालीलं यातुं वदत, तत्र ते मां द्रक्ष्यन्ति।</para>
  <para style="p">
    <verse number="11" style="v"/>स्त्रियो गच्छन्ति, तदा रक्षिणां केचित् पुरं गत्वा यद्यद् घटितं तत्सर्व्वं प्रधानयाजकान् ज्ञापितवन्तः।</para>
  <para style="p">
    <verse number="12" style="v"/>ते प्राचीनैः समं संसदं कृत्वा मन्त्रयन्तो बहुमुद्राः सेनाभ्यो दत्त्वावदन्,</para>
  <para style="p">
    <verse number="13" style="v"/>अस्मासु निद्रितेषु तच्छिष्या यामिन्यामागत्य तं हृत्वानयन्, इति यूयं प्रचारयत।</para>
  <para style="p">
    <verse number="14" style="v"/>यद्येतदधिपतेः श्रोत्रगोचरीभवेत्, तर्हि तं बोधयित्वा युष्मानविष्यामः।</para>
  <para style="p">
    <verse number="15" style="v"/>ततस्ते मुद्रा गृहीत्वा शिक्षानुरूपं कर्म्म चक्रुः, यिहूदीयानां मध्ये तस्याद्यापि किंवदन्ती विद्यते।</para>
  <para style="p">
    <verse number="16" style="v"/>एकादश शिष्या यीशुनिरूपितागालीलस्याद्रिं गत्वा</para>
  <para style="p">
    <verse number="17" style="v"/>तत्र तं संवीक्ष्य प्रणेमुः, किन्तु केचित् सन्दिग्धवन्तः।</para>
  <para style="p">
    <verse number="18" style="v"/>यीशुस्तेषां समीपमागत्य व्याहृतवान्, स्वर्गमेदिन्योः सर्व्वाधिपतित्वभारो मय्यर्पित आस्ते।</para>
  <para style="p">
    <verse number="19" style="v"/>अतो यूयं प्रयाय सर्व्वदेशीयान् शिष्यान् कृत्वा पितुः पुत्रस्य पवित्रस्यात्मनश्च नाम्ना तानवगाहयत; अहं युष्मान् यद्यदादिशं तदपि पालयितुं तानुपादिशत।</para>
  <para style="p">
    <verse number="20" style="v"/>पश्यत, जगदन्तं यावत् सदाहं युष्माभिः साकं तिष्ठामि। इति।</para>
</usx>
