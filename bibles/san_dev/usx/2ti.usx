<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="2TI" style="id">Sanskrit Bible (NT) in Devanagari Script (सत्यवेदः।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">2 Timothy</para>
  <para style="toc1">२ तीमथियं पत्रं</para>
  <para style="toc2">२ तीमथियः</para>
  <para style="toc3">२ तीमथियः</para>
  <para style="mt1">२ तीमथियं पत्रं</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ख्रीष्टेन यीशुना या जीवनस्य प्रतिज्ञा तामधीश्वरस्येच्छया यीशोः ख्रीष्टस्यैकः प्रेरितः पौलोऽहं स्वकीयं प्रियं धर्म्मपुत्रं तीमथियं प्रति पत्रं लिखामि।</para>
  <para style="p">
    <verse number="2" style="v"/>तात ईश्वरोऽस्माकं प्रभु र्यीशुख्रीष्टश्च त्वयि प्रसादं दयां शान्तिञ्च क्रियास्तां।</para>
  <para style="p">
    <verse number="3" style="v"/>अहम् आ पूर्व्वपुरुषात् यम् ईश्वरं पवित्रमनसा सेवे तं धन्यं वदनं कथयामि, अहम् अहोरात्रं प्रार्थनासमये त्वां निरन्तरं स्मरामि।</para>
  <para style="p">
    <verse number="4" style="v"/>यश्च विश्वासः प्रथमे लोयीनामिकायां तव मातामह्याम् उनीकीनामिकायां मातरि चातिष्ठत् तवान्तरेऽपि तिष्ठतीति मन्ये</para>
  <para style="p">
    <verse number="5" style="v"/>तव तं निष्कपटं विश्वासं मनसि कुर्व्वन् तवाश्रुपातं स्मरन् यथानन्देन प्रफल्लो भवेयं तदर्थं तव दर्शनम् आकाङ्क्षे।</para>
  <para style="p">
    <verse number="6" style="v"/>अतो हेतो र्मम हस्तार्पणेन लब्धो य ईश्वरस्य वरस्त्वयि विद्यते तम् उज्ज्वालयितुं त्वां स्मारयामि।</para>
  <para style="p">
    <verse number="7" style="v"/>यत ईश्वरोऽस्मभ्यं भयजनकम् आत्मानम् अदत्त्वा शक्तिप्रेमसतर्कतानाम् आकरम् आत्मानं दत्तवान्।</para>
  <para style="p">
    <verse number="8" style="v"/>अतएवास्माकं प्रभुमधि तस्य वन्दिदासं मामधि च प्रमाणं दातुं न त्रपस्व किन्त्वीश्वरीयशक्त्या सुसंवादस्य कृते दुःखस्य सहभागी भव।</para>
  <para style="p">
    <verse number="9" style="v"/>सोऽस्मान् परित्राणपात्राणि कृतवान् पवित्रेणाह्वानेनाहूतवांश्च; अस्मत्कर्म्महेतुनेति नहि स्वीयनिरूपाणस्य प्रसादस्य च कृते तत् कृतवान्। स प्रसादः सृष्टेः पूर्व्वकाले ख्रीष्टेन यीशुनास्मभ्यम् अदायि,</para>
  <para style="p">
    <verse number="10" style="v"/>किन्त्वधुनास्माकं परित्रातु र्यीशोः ख्रीष्टस्यागमनेन प्राकाशत। ख्रीष्टो मृत्युं पराजितवान् सुसंवादेन च जीवनम् अमरताञ्च प्रकाशितवान्।</para>
  <para style="p">
    <verse number="11" style="v"/>तस्य घोषयिता दूतश्चान्यजातीयानां शिक्षकश्चाहं नियुक्तोऽस्मि।</para>
  <para style="p">
    <verse number="12" style="v"/>तस्मात् कारणात् ममायं क्लेशो भवति तेन मम लज्जा न जायते यतोऽहं यस्मिन् विश्वसितवान् तमवगतोऽस्मि महादिनं यावत् ममोपनिधे र्गोपनस्य शक्तिस्तस्य विद्यत इति निश्चितं जानामि।</para>
  <para style="p">
    <verse number="13" style="v"/>हितदायकानां वाक्यानाम् आदर्शरूपेण मत्तः श्रुताः ख्रीष्टे यीशौ विश्वासप्रेम्नोः कथा धारय।</para>
  <para style="p">
    <verse number="14" style="v"/>अपरम् अस्मदन्तर्वासिना पवित्रेणात्मना तामुत्तमाम् उपनिधिं गोपय।</para>
  <para style="p">
    <verse number="15" style="v"/>आशियादेशीयाः सर्व्वे मां त्यक्तवन्त इति त्वं जानासि तेषां मध्ये फूगिल्लो हर्म्मगिनिश्च विद्येते।</para>
  <para style="p">
    <verse number="16" style="v"/>प्रभुरनीषिफरस्य परिवारान् प्रति कृपां विदधातु यतः स पुनः पुन र्माम् आप्यायितवान्</para>
  <para style="p">
    <verse number="17" style="v"/>मम शृङ्खलेन न त्रपित्वा रोमानगरे उपस्थितिसमये यत्नेन मां मृगयित्वा ममोद्देशं प्राप्तवान्।</para>
  <para style="p">
    <verse number="18" style="v"/>अतो विचारदिने स यथा प्रभोः कृपाभाजनं भवेत् तादृशं वरं प्रभुस्तस्मै देयात्। इफिषनगरेऽपि स कति प्रकारै र्माम् उपकृतवान् तत् त्वं सम्यग् वेत्सि।</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>हे मम पुत्र, ख्रीष्टयीशुतो योऽनुग्रहस्तस्य बलेन त्वं बलवान् भव।</para>
  <para style="p">
    <verse number="2" style="v"/>अपरं बहुभिः साक्षिभिः प्रमाणीकृतां यां शिक्षां श्रुतवानसि तां विश्वास्येषु परस्मै शिक्षादाने निपुणेषु च लोकेषु समर्पय।</para>
  <para style="p">
    <verse number="3" style="v"/>त्वं यीशुख्रीष्टस्योत्तमो योद्धेव क्लेशं सहस्व।</para>
  <para style="p">
    <verse number="4" style="v"/>यो युद्धं करोति स सांसारिके व्यापारे मग्नो न भवति किन्तु स्वनियोजयित्रे रोचितुं चेष्टते।</para>
  <para style="p">
    <verse number="5" style="v"/>अपरं यो मल्लै र्युध्यति स यदि नियमानुसारेण न युद्ध्यति तर्हि किरीटं न लप्स्यते।</para>
  <para style="p">
    <verse number="6" style="v"/>अपरं यः कृषीवलः कर्म्म करोति तेन प्रथमेन फलभागिना भवितव्यं।</para>
  <para style="p">
    <verse number="7" style="v"/>मया यदुच्यते तत् त्वया बुध्यतां यतः प्रभुस्तुभ्यं सर्व्वत्र बुद्धिं दास्यति।</para>
  <para style="p">
    <verse number="8" style="v"/>मम सुसंवादस्य वचनानुसाराद् दायूद्वंशीयं मृतगणमध्याद् उत्थापितञ्च यीशुं ख्रीष्टं स्मर।</para>
  <para style="p">
    <verse number="9" style="v"/>तत्सुसंवादकारणाद् अहं दुष्कर्म्मेव बन्धनदशापर्य्यन्तं क्लेशं भुञ्जे किन्त्वीश्वरस्य वाक्यम् अबद्धं तिष्ठति।</para>
  <para style="p">
    <verse number="10" style="v"/>ख्रीष्टेन यीशुना यद् अनन्तगौरवसहितं परित्राणं जायते तदभिरुचितै र्लोकैरपि यत् लभ्येत तदर्थमहं तेषां निमित्तं सर्व्वाण्येतानि सहे।</para>
  <para style="p">
    <verse number="11" style="v"/>अपरम् एषा भारती सत्या यदि वयं तेन सार्द्धं म्रियामहे तर्हि तेन सार्द्धं जीविव्यामः, यदि च क्लेशं सहामहे तर्हि तेन सार्द्धं राजत्वमपि करिष्यामहे।</para>
  <para style="p">
    <verse number="12" style="v"/>यदि वयं तम् अनङ्गीकुर्म्मस्तर्हि सो ऽस्मानप्यनङ्गीकरिष्यति।</para>
  <para style="p">
    <verse number="13" style="v"/>यदि वयं न विश्वासामस्तर्हि स विश्वास्यस्तिष्ठति यतः स्वम् अपह्नोतुं न शक्नोति।</para>
  <para style="p">
    <verse number="14" style="v"/>त्वमेतानि स्मारयन् ते यथा निष्फलं श्रोतृणां भ्रंशजनकं वाग्युद्धं न कुर्य्यस्तथा प्रभोः समक्षं दृढं विनीयादिश।</para>
  <para style="p">
    <verse number="15" style="v"/>अपरं त्वम् ईश्वरस्य साक्षात् स्वं परीक्षितम् अनिन्दनीयकर्म्मकारिणञ्च सत्यमतस्य वाक्यानां सद्विभजने निपुणञ्च दर्शयितुं यतस्व।</para>
  <para style="p">
    <verse number="16" style="v"/>किन्त्वपवित्रा अनर्थककथा दूरीकुरु यतस्तदालम्बिन उत्तरोत्तरम् अधर्म्मे वर्द्धिष्यन्ते,</para>
  <para style="p">
    <verse number="17" style="v"/>तेषाञ्च वाक्यं गलितक्षतवत् क्षयवर्द्धको भविष्यति तेषां मध्ये हुमिनायः फिलीतश्चेतिनामानौ द्वौ जनौ सत्यमताद् भ्रष्टौ जातौ,</para>
  <para style="p">
    <verse number="18" style="v"/>मृतानां पुनरुत्थिति र्व्यतीतेति वदन्तौ केषाञ्चिद् विश्वासम् उत्पाटयतश्च।</para>
  <para style="p">
    <verse number="19" style="v"/>तथापीश्वरस्य भित्तिमूलम् अचलं तिष्ठति तस्मिंश्चेयं लिपि र्मुद्राङ्किता विद्यते। यथा, जानाति परमेशस्तु स्वकीयान् सर्व्वमानवान्। अपगच्छेद् अधर्म्माच्च यः कश्चित् ख्रीष्टनामकृत्॥</para>
  <para style="p">
    <verse number="20" style="v"/>किन्तु बृहन्निकेतने केवल सुवर्णमयानि रौप्यमयाणि च भाजनानि विद्यन्त इति तर्हि काष्ठमयानि मृण्मयान्यपि विद्यन्ते तेषाञ्च कियन्ति सम्मानाय कियन्तपमानाय च भवन्ति।</para>
  <para style="p">
    <verse number="21" style="v"/>अतो यदि कश्चिद् एतादृशेभ्यः स्वं परिष्करोति तर्हि स पावितं प्रभोः कार्य्ययोग्यं सर्व्वसत्कार्य्यायोपयुक्तं सम्मानार्थकञ्च भाजनं भविष्यति।</para>
  <para style="p">
    <verse number="22" style="v"/>यौवनावस्थाया अभिलाषास्त्वया परित्यज्यन्तां धर्म्मो विश्वासः प्रेम ये च शुचिमनोभिः प्रभुम् उद्दिश्य प्रार्थनां कुर्व्वते तैः सार्द्धम् ऐक्यभावश्चैतेषु त्वया यत्नो विधीयतां।</para>
  <para style="p">
    <verse number="23" style="v"/>अपरं त्वम् अनर्थकान् अज्ञानांश्च प्रश्नान् वाग्युद्धोत्पादकान् ज्ञात्वा दूरीकुरु।</para>
  <para style="p">
    <verse number="24" style="v"/>यतः प्रभो र्दासेन युद्धम् अकर्त्तव्यं किन्तु सर्व्वान् प्रति शान्तेन शिक्षादानेच्छुकेन सहिष्णुना च भवितव्यं, विपक्षाश्च तेन नम्रत्वेन चेतितव्याः।</para>
  <para style="p">
    <verse number="25" style="v"/>तथा कृते यदीश्वरः सत्यमतस्य ज्ञानार्थं तेभ्यो मनःपरिवर्त्तनरूपं वरं दद्यात्,</para>
  <para style="p">
    <verse number="26" style="v"/>तर्हि ते येन शयतानेन निजाभिलाषसाधनाय धृतास्तस्य जालात् चेतनां प्राप्योद्धारं लब्धुं शक्ष्यन्ति।</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>चरमदिनेषु क्लेशजनकाः समया उपस्थास्यन्तीति जानीहि।</para>
  <para style="p">
    <verse number="2" style="v"/>यतस्तात्कालिका लोका आत्मप्रेमिणो ऽर्थप्रेमिण आत्मश्लाघिनो ऽभिमानिनो निन्दकाः पित्रोरनाज्ञाग्राहिणः कृतघ्ना अपवित्राः</para>
  <para style="p">
    <verse number="3" style="v"/>प्रीतिवर्जिता असन्धेया मृषापवादिनो ऽजितेन्द्रियाः प्रचण्डा भद्रद्वेषिणो</para>
  <para style="p">
    <verse number="4" style="v"/>विश्वासघातका दुःसाहसिनो दर्पध्माता ईश्वराप्रेमिणः किन्तु सुखप्रेमिणो</para>
  <para style="p">
    <verse number="5" style="v"/>भक्तवेशाः किन्त्वस्वीकृतभक्तिगुणा भविष्यन्ति; एतादृशानां लोकानां संमर्गं परित्यज।</para>
  <para style="p">
    <verse number="6" style="v"/>यतो ये जनाः प्रच्छन्नं गेहान् प्रविशन्ति पापै र्भारग्रस्ता नानाविधाभिलाषैश्चालिता याः कामिन्यो</para>
  <para style="p">
    <verse number="7" style="v"/>नित्यं शिक्षन्ते किन्तु सत्यमतस्य तत्त्वज्ञानं प्राप्तुं कदाचित् न शक्नुवन्ति ता दासीवद् वशीकुर्व्वते च ते तादृशा लोकाः।</para>
  <para style="p">
    <verse number="8" style="v"/>यान्नि र्याम्ब्रिश्च यथा मूसमं प्रति विपक्षत्वम् अकुरुतां तथैव भ्रष्टमनसो विश्वासविषये ऽग्राह्याश्चैते लोका अपि सत्यमतं प्रति विपक्षतां कुर्व्वन्ति।</para>
  <para style="p">
    <verse number="9" style="v"/>किन्तु ते बहुदूरम् अग्रसरा न भविष्यन्ति यतस्तयो र्मूढता यद्वत् तद्वद् एतेषामपि मूढता सर्व्वदृश्या भविष्यति।</para>
  <para style="p">
    <verse number="10" style="v"/>ममोपदेशः शिष्टताभिप्रायो विश्वासो र्धर्य्यं प्रेम सहिष्णुतोपद्रवः क्लेशा</para>
  <para style="p">
    <verse number="11" style="v"/>आन्तियखियायाम् इकनिये लूस्त्रायाञ्च मां प्रति यद्यद् अघटत यांश्चोपद्रवान् अहम् असहे सर्व्वमेतत् त्वम् अवगतोऽसि किन्तु तत्सर्व्वतः प्रभु र्माम् उद्धृतवान्।</para>
  <para style="p">
    <verse number="12" style="v"/>परन्तु यावन्तो लोकाः ख्रीष्टेन यीशुनेश्वरभक्तिम् आचरितुम् इच्छन्ति तेषां सर्व्वेषाम् उपद्रवो भविष्यति।</para>
  <para style="p">
    <verse number="13" style="v"/>अपरं पापिष्ठाः खलाश्च लोका भ्राम्यन्तो भ्रमयन्तश्चोत्तरोत्तरं दुष्टत्वेन वर्द्धिष्यन्ते।</para>
  <para style="p">
    <verse number="14" style="v"/>किन्तु त्वं यद् यद् अशिक्षथाः, यच्च त्वयि समर्पितम् अभूत् तस्मिन् अवतिष्ठ, यतः कस्मात् शिक्षां प्राप्तोऽसि तद् वेत्सि;</para>
  <para style="p">
    <verse number="15" style="v"/>यानि च धर्म्मशास्त्राणि ख्रीष्टे यीशौ विश्वासेन परित्राणप्राप्तये त्वां ज्ञानिनं कर्त्तुं शक्नुवन्ति तानि त्वं शैशवकालाद् अवगतोऽसि।</para>
  <para style="p">
    <verse number="16" style="v"/>तत् सर्व्वं शास्त्रम् ईश्वरस्यात्मना दत्तं शिक्षायै दोषबोधाय शोधनाय धर्म्मविनयाय च फलयूक्तं भवति</para>
  <para style="p">
    <verse number="17" style="v"/>तेन चेश्वरस्य लोको निपुणः सर्व्वस्मै सत्कर्म्मणे सुसज्जश्च भवति।</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ईश्वरस्य गोचरे यश्च यीशुः ख्रीष्टः स्वीयागमनकाले स्वराजत्वेन जीवतां मृतानाञ्च लोकानां विचारं करिष्यति तस्य गोचरे ऽहं त्वाम् इदं दृढम् आज्ञापयामि।</para>
  <para style="p">
    <verse number="2" style="v"/>त्वं वाक्यं घोषय कालेऽकाले चोत्सुको भव पूर्णया सहिष्णुतया शिक्षया च लोकान् प्रबोधय भर्त्सय विनयस्व च।</para>
  <para style="p">
    <verse number="3" style="v"/>यत एतादृशः समय आयाति यस्मिन् लोका यथार्थम् उपदेशम् असह्यमानाः कर्णकण्डूयनविशिष्टा भूत्वा निजाभिलाषात् शिक्षकान् संग्रहीष्यन्ति</para>
  <para style="p">
    <verse number="4" style="v"/>सत्यमताच्च श्रोत्राणि निवर्त्त्य विपथगामिनो भूत्वोपाख्यानेषु प्रवर्त्तिष्यन्ते;</para>
  <para style="p">
    <verse number="5" style="v"/>किन्तु त्वं सर्व्वविषये प्रबुद्धो भव दुःखभोगं स्वीकुरु सुसंवादप्रचारकस्य कर्म्म साधय निजपरिचर्य्यां पूर्णत्वेन कुरु च।</para>
  <para style="p">
    <verse number="6" style="v"/>मम प्राणानाम् उत्सर्गो भवति मम प्रस्थानकालश्चोपातिष्ठत्।</para>
  <para style="p">
    <verse number="7" style="v"/>अहम् उत्तमयुद्धं कृतवान् गन्तव्यमार्गस्यान्तं यावद् धावितवान् विश्वासञ्च रक्षितवान्।</para>
  <para style="p">
    <verse number="8" style="v"/>शेषं पुण्यमुकुटं मदर्थं रक्षितं विद्यते तच्च तस्मिन् महादिने यथार्थविचारकेण प्रभुना मह्यं दायिष्यते केवलं मह्यम् इति नहि किन्तु यावन्तो लोकास्तस्यागमनम् आकाङ्क्षन्ते तेभ्यः सर्व्वेभ्यो ऽपि दायिष्यते।</para>
  <para style="p">
    <verse number="9" style="v"/>त्वं त्वरया मत्समीपम् आगन्तुं यतस्व,</para>
  <para style="p">
    <verse number="10" style="v"/>यतो दीमा ऐहिकसंसारम् ईहमानो मां परित्यज्य थिषलनीकीं गतवान् तथा क्रीष्कि र्गालातियां गतवान् तीतश्च दाल्मातियां गतवान्।</para>
  <para style="p">
    <verse number="11" style="v"/>केवलो लूको मया सार्द्धं विद्यते। त्वं मार्कं सङ्गिनं कृत्वागच्छ यतः स परिचर्य्यया ममोपकारी भविष्यति,</para>
  <para style="p">
    <verse number="12" style="v"/>तुखिकञ्चाहम् इफिषनगरं प्रेषितवान्।</para>
  <para style="p">
    <verse number="13" style="v"/>यद् आच्छादनवस्त्रं त्रोयानगरे कार्पस्य सन्निधौ मया निक्षिप्तं त्वमागमनसमये तत् पुस्तकानि च विशेषतश्चर्म्मग्रन्थान् आनय।</para>
  <para style="p">
    <verse number="14" style="v"/>कांस्यकारः सिकन्दरो मम बह्वनिष्टं कृतवान् प्रभुस्तस्य कर्म्मणां समुचितफलं ददातु।</para>
  <para style="p">
    <verse number="15" style="v"/>त्वमपि तस्मात् सावधानास्तिष्ठ यतः सोऽस्माकं वाक्यानाम् अतीव विपक्षो जातः।</para>
  <para style="p">
    <verse number="16" style="v"/>मम प्रथमप्रत्युत्तरसमये कोऽपि मम सहायो नाभवत् सर्व्वे मां पर्य्यत्यजन् तान् प्रति तस्य दोषस्य गणना न भूयात्;</para>
  <para style="p">
    <verse number="17" style="v"/>किन्तु प्रभु र्मम सहायो ऽभवत् यथा च मया घोषणा साध्येत भिन्नजातीयाश्च सर्व्वे सुसंवादं शृणुयुस्तथा मह्यं शक्तिम् अददात् ततो ऽहं सिंहस्य मुखाद् उद्धृतः।</para>
  <para style="p">
    <verse number="18" style="v"/>अपरं सर्व्वस्माद् दुष्कर्म्मतः प्रभु र्माम् उद्धरिष्यति निजस्वर्गीयराज्यं नेतुं मां तारयिष्यति च। तस्य धन्यवादः सदाकालं भूयात्। आमेन्।</para>
  <para style="p">
    <verse number="19" style="v"/>त्वं प्रिष्काम् आक्किलम् अनीषिफरस्य परिजनांश्च नमस्कुरु।</para>
  <para style="p">
    <verse number="20" style="v"/>इरास्तः करिन्थनगरे ऽतिष्ठत् त्रफिमश्च पीडितत्वात् मिलीतनगरे मया व्यहीयत।</para>
  <para style="p">
    <verse number="21" style="v"/>त्वं हेमन्तकालात् पूर्व्वम् आगन्तुं यतस्व। उबूलः पूदि र्लीनः क्लौदिया सर्व्वे भ्रातरश्च त्वां नमस्कुर्व्वते।</para>
  <para style="p">
    <verse number="22" style="v"/>प्रभु र्यीशुः ख्रीष्टस्तवात्मना सह भूयात्। युष्मास्वनुग्रहो भूयात्। आमेन्।</para>
</usx>
