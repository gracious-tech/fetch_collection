<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="LUK" style="id">Sanskrit Bible (NT) in Devanagari Script (सत्यवेदः।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Luke</para>
  <para style="toc1">लूकलिखितः सुसंवादः</para>
  <para style="toc2">लूकः</para>
  <para style="toc3">लूकः</para>
  <para style="mt1">लूकलिखितः सुसंवादः</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>प्रथमतो ये साक्षिणो वाक्यप्रचारकाश्चासन् तेऽस्माकं मध्ये यद्यत् सप्रमाणं वाक्यमर्पयन्ति स्म</para>
  <para style="p">
    <verse number="2" style="v"/>तदनुसारतोऽन्येपि बहवस्तद्वृत्तान्तं रचयितुं प्रवृत्ताः।</para>
  <para style="p">
    <verse number="3" style="v"/>अतएव हे महामहिमथियफिल् त्वं या याः कथा अशिक्ष्यथास्तासां दृढप्रमाणानि यथा प्राप्नोषि</para>
  <para style="p">
    <verse number="4" style="v"/>तदर्थं प्रथममारभ्य तानि सर्व्वाणि ज्ञात्वाहमपि अनुक्रमात् सर्व्ववृत्तान्तान् तुभ्यं लेखितुं मतिमकार्षम्।</para>
  <para style="p">
    <verse number="5" style="v"/>यिहूदादेशीयहेरोद्नामके राजत्वं कुर्व्वति अबीययाजकस्य पर्य्यायाधिकारी सिखरियनामक एको याजको हारोणवंशोद्भवा इलीशेवाख्या</para>
  <para style="p">
    <verse number="6" style="v"/>तस्य जाया द्वाविमौ निर्दोषौ प्रभोः सर्व्वाज्ञा व्यवस्थाश्च संमन्य ईश्वरदृष्टौ धार्म्मिकावास्ताम्।</para>
  <para style="p">
    <verse number="7" style="v"/>तयोः सन्तान एकोपि नासीत्, यत इलीशेवा बन्ध्या तौ द्वावेव वृद्धावभवताम्।</para>
  <para style="p">
    <verse number="8" style="v"/>यदा स्वपर्य्यानुक्रमेण सिखरिय ईश्वास्य समक्षं याजकीयं कर्म्म करोति</para>
  <para style="p">
    <verse number="9" style="v"/>तदा यज्ञस्य दिनपरिपाय्या परमेश्वरस्य मन्दिरे प्रवेशकाले धूपज्वालनं कर्म्म तस्य करणीयमासीत्।</para>
  <para style="p">
    <verse number="10" style="v"/>तद्धूपज्वालनकाले लोकनिवहे प्रार्थनां कर्तुं बहिस्तिष्ठति</para>
  <para style="p">
    <verse number="11" style="v"/>सति सिखरियो यस्यां वेद्यां धूपं ज्वालयति तद्दक्षिणपार्श्वे परमेश्वरस्य दूत एक उपस्थितो दर्शनं ददौ।</para>
  <para style="p">
    <verse number="12" style="v"/>तं दृष्ट्वा सिखरिय उद्विविजे शशङ्के च।</para>
  <para style="p">
    <verse number="13" style="v"/>तदा स दूतस्तं बभाषे हे सिखरिय मा भैस्तव प्रार्थना ग्राह्या जाता तव भार्य्या इलीशेवा पुत्रं प्रसोष्यते तस्य नाम योेहन् इति करिष्यसि।</para>
  <para style="p">
    <verse number="14" style="v"/>किञ्च त्वं सानन्दः सहर्षश्च भविष्यसि तस्य जन्मनि बहव आनन्दिष्यन्ति च।</para>
  <para style="p">
    <verse number="15" style="v"/>यतो हेतोः स परमेश्वरस्य गोचरे महान् भविष्यति तथा द्राक्षारसं सुरां वा किमपि न पास्यति, अपरं जन्मारभ्य पवित्रेणात्मना परिपूर्णः</para>
  <para style="p">
    <verse number="16" style="v"/>सन् इस्रायेल्वंशीयान् अनेकान् प्रभोः परमेश्वरस्य मार्गमानेष्यति।</para>
  <para style="p">
    <verse number="17" style="v"/>सन्तानान् प्रति पितृणां मनांसि धर्म्मज्ञानं प्रत्यनाज्ञाग्राहिणश्च परावर्त्तयितुं, प्रभोः परमेश्वरस्य सेवार्थम् एकां सज्जितजातिं विधातुञ्च स एलियरूपात्मशक्तिप्राप्तस्तस्याग्रे गमिष्यति।</para>
  <para style="p">
    <verse number="18" style="v"/>तदा सिखरियो दूतमवादीत् कथमेतद् वेत्स्यामि? यतोहं वृद्धो मम भार्य्या च वृद्धा।</para>
  <para style="p">
    <verse number="19" style="v"/>ततो दूतः प्रत्युवाच पश्येश्वरस्य साक्षाद्वर्त्ती जिब्रायेल्नामा दूतोहं त्वया सह कथां गदितुं तुभ्यमिमां शुभवार्त्तां दातुञ्च प्रेषितः।</para>
  <para style="p">
    <verse number="20" style="v"/>किन्तु मदीयं वाक्यं काले फलिष्यति तत् त्वया न प्रतीतम् अतः कारणाद् यावदेव तानि न सेत्स्यन्ति तावत् त्वं वक्तुंमशक्तो मूको भव।</para>
  <para style="p">
    <verse number="21" style="v"/>तदानीं ये ये लोकाः सिखरियमपैक्षन्त ते मध्येमन्दिरं तस्य बहुविलम्बाद् आश्चर्य्यं मेनिरे।</para>
  <para style="p">
    <verse number="22" style="v"/>स बहिरागतो यदा किमपि वाक्यं वक्तुमशक्तः सङ्केतं कृत्वा निःशब्दस्तस्यौ तदा मध्येमन्दिरं कस्यचिद् दर्शनं तेन प्राप्तम् इति सर्व्वे बुबुधिरे।</para>
  <para style="p">
    <verse number="23" style="v"/>अनन्तरं तस्य सेवनपर्य्याये सम्पूर्णे सति स निजगेहं जगाम।</para>
  <para style="p">
    <verse number="24" style="v"/>कतिपयदिनेषु गतेषु तस्य भार्य्या इलीशेवा गर्ब्भवती बभूव</para>
  <para style="p">
    <verse number="25" style="v"/>पश्चात् सा पञ्चमासान् संगोप्याकथयत् लोकानां समक्षं ममापमानं खण्डयितुं परमेश्वरो मयि दृष्टिं पातयित्वा कर्म्मेदृशं कृतवान्।</para>
  <para style="p">
    <verse number="26" style="v"/>अपरञ्च तस्या गर्ब्भस्य षष्ठे मासे जाते गालील्प्रदेशीयनासरत्पुरे</para>
  <para style="p">
    <verse number="27" style="v"/>दायूदो वंशीयाय यूषफ्नाम्ने पुरुषाय या मरियम्नामकुमारी वाग्दत्तासीत् तस्याः समीपं जिब्रायेल् दूत ईश्वरेण प्रहितः।</para>
  <para style="p">
    <verse number="28" style="v"/>स गत्वा जगाद हे ईश्वरानुगृहीतकन्ये तव शुभं भूयात् प्रभुः परमेश्वरस्तव सहायोस्ति नारीणां मध्ये त्वमेव धन्या।</para>
  <para style="p">
    <verse number="29" style="v"/>तदानीं सा तं दृष्ट्वा तस्य वाक्यत उद्विज्य कीदृशं भाषणमिदम् इति मनसा चिन्तयामास।</para>
  <para style="p">
    <verse number="30" style="v"/>ततो दूतोऽवदत् हे मरियम् भयं माकार्षीः, त्वयि परमेश्वरस्यानुग्रहोस्ति।</para>
  <para style="p">
    <verse number="31" style="v"/>पश्य त्वं गर्ब्भं धृत्वा पुत्रं प्रसोष्यसे तस्य नाम यीशुरिति करिष्यसि।</para>
  <para style="p">
    <verse number="32" style="v"/>स महान् भविष्यति तथा सर्व्वेभ्यः श्रेष्ठस्य पुत्र इति ख्यास्यति; अपरं प्रभुः परमेश्वरस्तस्य पितुर्दायूदः सिंहासनं तस्मै दास्यति;</para>
  <para style="p">
    <verse number="33" style="v"/>तथा स याकूबो वंशोपरि सर्व्वदा राजत्वं करिष्यति, तस्य राजत्वस्यान्तो न भविष्यति।</para>
  <para style="p">
    <verse number="34" style="v"/>तदा मरियम् तं दूतं बभाषे नाहं पुरुषसङ्गं करोमि तर्हि कथमेतत् सम्भविष्यति?</para>
  <para style="p">
    <verse number="35" style="v"/>ततो दूतोऽकथयत् पवित्र आत्मा त्वामाश्रायिष्यति तथा सर्व्वश्रेष्ठस्य शक्तिस्तवोपरि छायां करिष्यति ततो हेतोस्तव गर्ब्भाद् यः पवित्रबालको जनिष्यते स ईश्वरपुत्र इति ख्यातिं प्राप्स्यति।</para>
  <para style="p">
    <verse number="36" style="v"/>अपरञ्च पश्य तव ज्ञातिरिलीशेवा यां सर्व्वे बन्ध्यामवदन् इदानीं सा वार्द्धक्ये सन्तानमेकं गर्ब्भेऽधारयत् तस्य षष्ठमासोभूत्।</para>
  <para style="p">
    <verse number="37" style="v"/>किमपि कर्म्म नासाध्यम् ईश्वरस्य।</para>
  <para style="p">
    <verse number="38" style="v"/>तदा मरियम् जगाद, पश्य प्रभेरहं दासी मह्यं तव वाक्यानुसारेण सर्व्वमेतद् घटताम्; अननतरं दूतस्तस्याः समीपात् प्रतस्थे।</para>
  <para style="p">
    <verse number="39" style="v"/>अथ कतिपयदिनात् परं मरियम् तस्मात् पर्व्वतमयप्रदेशीययिहूदाया नगरमेकं शीघ्रं गत्वा</para>
  <para style="p">
    <verse number="40" style="v"/>सिखरिययाजकस्य गृहं प्रविश्य तस्य जायाम् इलीशेवां सम्बोध्यावदत्।</para>
  <para style="p">
    <verse number="41" style="v"/>ततो मरियमः सम्बोधनवाक्ये इलीशेवायाः कर्णयोः प्रविष्टमात्रे सति तस्या गर्ब्भस्थबालको ननर्त्त। तत इलीशेवा पवित्रेणात्मना परिपूर्णा सती</para>
  <para style="p">
    <verse number="42" style="v"/>प्रोच्चैर्गदितुमारेभे, योषितां मध्ये त्वमेव धन्या, तव गर्ब्भस्थः शिशुश्च धन्यः।</para>
  <para style="p">
    <verse number="43" style="v"/>त्वं प्रभोर्माता, मम निवेशने त्वया चरणावर्पितौ, ममाद्य सौभाग्यमेतत्।</para>
  <para style="p">
    <verse number="44" style="v"/>पश्य तव वाक्ये मम कर्णयोः प्रविष्टमात्रे सति ममोदरस्थः शिशुरानन्दान् ननर्त्त।</para>
  <para style="p">
    <verse number="45" style="v"/>या स्त्री व्यश्वसीत् सा धन्या, यतो हेतोस्तां प्रति परमेश्वरोक्तं वाक्यं सर्व्वं सिद्धं भविष्यति।</para>
  <para style="p">
    <verse number="46" style="v"/>तदानीं मरियम् जगाद। धन्यवादं परेशस्य करोति मामकं मनः।</para>
  <para style="p">
    <verse number="47" style="v"/>ममात्मा तारकेशे च समुल्लासं प्रगच्छति।</para>
  <para style="p">
    <verse number="48" style="v"/>अकरोत् स प्रभु र्दुष्टिं स्वदास्या दुर्गतिं प्रति। पश्याद्यारभ्य मां धन्यां वक्ष्यन्ति पुरुषाः सदा।</para>
  <para style="p">
    <verse number="49" style="v"/>यः सर्व्वशक्तिमान् यस्य नामापि च पवित्रकं। स एव सुमहत्कर्म्म कृतवान् मन्निमित्तकं।</para>
  <para style="p">
    <verse number="50" style="v"/>ये बिभ्यति जनास्तस्मात् तेषां सन्तानपंक्तिषु। अनुकम्पा तदीया च सर्व्वदैव सुतिष्ठति।</para>
  <para style="p">
    <verse number="51" style="v"/>स्वबाहुबलतस्तेन प्राकाश्यत पराक्रमः। मनःकुमन्त्रणासार्द्धं विकीर्य्यन्तेऽभिमानिनः।</para>
  <para style="p">
    <verse number="52" style="v"/>सिंहासनगताल्लोकान् बलिनश्चावरोह्य सः। पदेषूच्चेषु लोकांस्तु क्षुद्रान् संस्थापयत्यपि।</para>
  <para style="p">
    <verse number="53" style="v"/>क्षुधितान् मानवान् द्रव्यैरुत्तमैः परितर्प्य सः। सकलान् धनिनो लोकान् विसृजेद् रिक्तहस्तकान्।</para>
  <para style="p">
    <verse number="54" style="v"/>इब्राहीमि च तद्वंशे या दयास्ति सदैव तां। स्मृत्वा पुरा पितृणां नो यथा साक्षात् प्रतिश्रुतं।</para>
  <para style="p">
    <verse number="55" style="v"/>इस्रायेल्सेवकस्तेन तथोपक्रियते स्वयं॥</para>
  <para style="p">
    <verse number="56" style="v"/>अनन्तरं मरियम् प्रायेण मासत्रयम् इलीशेवया सहोषित्वा व्याघुय्य निजनिवेशनं ययौ।</para>
  <para style="p">
    <verse number="57" style="v"/>तदनन्तरम् इलीशेवायाः प्रसवकाल उपस्थिते सति सा पुत्रं प्रासोष्ट।</para>
  <para style="p">
    <verse number="58" style="v"/>ततः परमेश्वरस्तस्यां महानुग्रहं कृतवान् एतत् श्रुत्वा समीपवासिनः कुटुम्बाश्चागत्य तया सह मुमुदिरे।</para>
  <para style="p">
    <verse number="59" style="v"/>तथाष्टमे दिने ते बालकस्य त्वचं छेत्तुम् एत्य तस्य पितृनामानुरूपं तन्नाम सिखरिय इति कर्त्तुमीषुः।</para>
  <para style="p">
    <verse number="60" style="v"/>किन्तु तस्य माताकथयत् तन्न, नामास्य योहन् इति कर्त्तव्यम्।</para>
  <para style="p">
    <verse number="61" style="v"/>तदा ते व्याहरन् तव वंशमध्ये नामेदृशं कस्यापि नास्ति।</para>
  <para style="p">
    <verse number="62" style="v"/>ततः परं तस्य पितरं सिखरियं प्रति सङ्केत्य पप्रच्छुः शिशोः किं नाम कारिष्यते?</para>
  <para style="p">
    <verse number="63" style="v"/>ततः स फलकमेकं याचित्वा लिलेख तस्य नाम योहन् भविष्यति। तस्मात् सर्व्वे आश्चर्य्यं मेनिरे।</para>
  <para style="p">
    <verse number="64" style="v"/>तत्क्षणं सिखरियस्य जिह्वाजाड्येऽपगते स मुखं व्यादाय स्पष्टवर्णमुच्चार्य्य ईश्वरस्य गुणानुवादं चकार।</para>
  <para style="p">
    <verse number="65" style="v"/>तस्माच्चतुर्दिक्स्थाः समीपवासिलोका भीता एवमेताः सर्व्वाः कथा यिहूदायाः पर्व्वतमयप्रदेशस्य सर्व्वत्र प्रचारिताः।</para>
  <para style="p">
    <verse number="66" style="v"/>तस्मात् श्रोतारो मनःसु स्थापयित्वा कथयाम्बभूवुः कीदृशोयं बालो भविष्यति? अथ परमेश्वरस्तस्य सहायोभूत्।</para>
  <para style="p">
    <verse number="67" style="v"/>तदा योहनः पिता सिखरियः पवित्रेणात्मना परिपूर्णः सन् एतादृशं भविष्यद्वाक्यं कथयामास।</para>
  <para style="p">
    <verse number="68" style="v"/>इस्रायेलः प्रभु र्यस्तु स धन्यः परमेश्वरः। अनुगृह्य निजाल्लोकान् स एव परिमोचयेत्।</para>
  <para style="p">
    <verse number="69" style="v"/>विपक्षजनहस्तेभ्यो यथा मोच्यामहे वयं। यावज्जीवञ्च धर्म्मेण सारल्येन च निर्भयाः।</para>
  <para style="p">
    <verse number="70" style="v"/>सेवामहै तमेवैकम् एतत्कारणमेव च। स्वकीयं सुपवित्रञ्च संस्मृत्य नियमं सदा।</para>
  <para style="p">
    <verse number="71" style="v"/>कृपया पुरुषान् पूर्व्वान् निकषार्थात्तु नः पितुः। इब्राहीमः समीपे यं शपथं कृतवान् पुरा।</para>
  <para style="p">
    <verse number="72" style="v"/>तमेव सफलं कर्त्तं तथा शत्रुगणस्य च। ऋृतीयाकारिणश्चैव करेभ्यो रक्षणाय नः।</para>
  <para style="p">
    <verse number="73" style="v"/>सृष्टेः प्रथमतः स्वीयैः पवित्रै र्भाविवादिभिः।</para>
  <para style="p">
    <verse number="74" style="v"/>यथोक्तवान् तथा स्वस्य दायूदः सेवकस्य तु।</para>
  <para style="p">
    <verse number="75" style="v"/>वंशे त्रातारमेकं स समुत्पादितवान् स्वयम्।</para>
  <para style="p">
    <verse number="76" style="v"/>अतो हे बालक त्वन्तु सर्व्वेभ्यः श्रेष्ठ एव यः। तस्यैव भाविवादीति प्रविख्यातो भविष्यसि। अस्माकं चरणान् क्षेमे मार्गे चालयितुं सदा। एवं ध्वान्तेऽर्थतो मृत्योश्छायायां ये तु मानवाः।</para>
  <para style="p">
    <verse number="77" style="v"/>उपविष्टास्तु तानेव प्रकाशयितुमेव हि। कृत्वा महानुकम्पां हि यामेव परमेश्वरः।</para>
  <para style="p">
    <verse number="78" style="v"/>ऊर्द्व्वात् सूर्य्यमुदाय्यैवास्मभ्यं प्रादात्तु दर्शनं। तयानुकम्पया स्वस्य लोकानां पापमोचने।</para>
  <para style="p">
    <verse number="79" style="v"/>परित्राणस्य तेभ्यो हि ज्ञानविश्राणनाय च। प्रभो र्मार्गं परिष्कर्त्तुं तस्याग्रायी भविष्यसि॥</para>
  <para style="p">
    <verse number="80" style="v"/>अथ बालकः शरीरेण बुद्ध्या च वर्द्धितुमारेभे; अपरञ्च स इस्रायेलो वंशीयलोकानां समीपे यावन्न प्रकटीभूतस्तास्तावत् प्रान्तरे न्यवसत्।</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अपरञ्च तस्मिन् काले राज्यस्य सर्व्वेषां लोकानां नामानि लेखयितुम् अगस्तकैसर आज्ञापयामास।</para>
  <para style="p">
    <verse number="2" style="v"/>तदनुसारेण कुरीणियनामनि सुरियादेशस्य शासके सति नामलेखनं प्रारेभे।</para>
  <para style="p">
    <verse number="3" style="v"/>अतो हेतो र्नाम लेखितुं सर्व्वे जनाः स्वीयं स्वीयं नगरं जग्मुः।</para>
  <para style="p">
    <verse number="4" style="v"/>तदानीं यूषफ् नाम लेखितुं वाग्दत्तया स्वभार्य्यया गर्ब्भवत्या मरियमा सह स्वयं दायूदः सजातिवंश इति कारणाद् गालील्प्रदेशस्य नासरत्नगराद्</para>
  <para style="p">
    <verse number="5" style="v"/>यिहूदाप्रदेशस्य बैत्लेहमाख्यं दायूद्नगरं जगाम।</para>
  <para style="p">
    <verse number="6" style="v"/>अन्यच्च तत्र स्थाने तयोस्तिष्ठतोः सतो र्मरियमः प्रसूतिकाल उपस्थिते</para>
  <para style="p">
    <verse number="7" style="v"/>सा तं प्रथमसुतं प्रासोष्ट किन्तु तस्मिन् वासगृहे स्थानाभावाद् बालकं वस्त्रेण वेष्टयित्वा गोशालायां स्थापयामास।</para>
  <para style="p">
    <verse number="8" style="v"/>अनन्तरं ये कियन्तो मेषपालकाः स्वमेषव्रजरक्षायै तत्प्रदेशे स्थित्वा रजन्यां प्रान्तरे प्रहरिणः कर्म्म कुर्व्वन्ति,</para>
  <para style="p">
    <verse number="9" style="v"/>तेषां समीपं परमेश्वरस्य दूत आगत्योपतस्थौ; तदा चतुष्पार्श्वे परमेश्वरस्य तेजसः प्रकाशितत्वात् तेऽतिशशङ्किरे।</para>
  <para style="p">
    <verse number="10" style="v"/>तदा स दूत उवाच मा भैष्ट पश्यताद्य दायूदः पुरे युष्मन्निमित्तं त्राता प्रभुः ख्रीष्टोऽजनिष्ट,</para>
  <para style="p">
    <verse number="11" style="v"/>सर्व्वेषां लोकानां महानन्दजनकम् इमं मङ्गलवृत्तान्तं युष्मान् ज्ञापयामि।</para>
  <para style="p">
    <verse number="12" style="v"/>यूयं (तत्स्थानं गत्वा) वस्त्रवेष्टितं तं बालकं गोशालायां शयनं द्रक्ष्यथ युष्मान् प्रतीदं चिह्नं भविष्यति।</para>
  <para style="p">
    <verse number="13" style="v"/>दूत इमां कथां कथितवति तत्राकस्मात् स्वर्गीयाः पृतना आगत्य कथाम् इमां कथयित्वेश्वरस्य गुणानन्ववादिषुः, यथा,</para>
  <para style="p">
    <verse number="14" style="v"/>सर्व्वोर्द्व्वस्थैरीश्वरस्य महिमा सम्प्रकाश्यतां। शान्तिर्भूयात् पृथिव्यास्तु सन्तोषश्च नरान् प्रति॥</para>
  <para style="p">
    <verse number="15" style="v"/>ततः परं तेषां सन्निधे र्दूतगणे स्वर्गं गते मेषपालकाः परस्परम् अवेचन् आगच्छत प्रभुः परमेश्वरो यां घटनां ज्ञापितवान् तस्या याथर्यं ज्ञातुं वयमधुना बैत्लेहम्पुरं यामः।</para>
  <para style="p">
    <verse number="16" style="v"/>पश्चात् ते तूर्णं व्रजित्वा मरियमं यूषफं गोशालायां शयनं बालकञ्च ददृशुः।</para>
  <para style="p">
    <verse number="17" style="v"/>इत्थं दृष्ट्वा बालकस्यार्थे प्रोक्तां सर्व्वकथां ते प्राचारयाञ्चक्रुः।</para>
  <para style="p">
    <verse number="18" style="v"/>ततो ये लोका मेषरक्षकाणां वदनेभ्यस्तां वार्त्तां शुश्रुवुस्ते महाश्चर्य्यं मेनिरे।</para>
  <para style="p">
    <verse number="19" style="v"/>किन्तु मरियम् एतत्सर्व्वघटनानां तात्पर्य्यं विविच्य मनसि स्थापयामास।</para>
  <para style="p">
    <verse number="20" style="v"/>तत्पश्चाद् दूतविज्ञप्तानुरूपं श्रुत्वा दृष्ट्वा च मेषपालका ईश्वरस्य गुणानुवादं धन्यवादञ्च कुर्व्वाणाः परावृत्य ययुः।</para>
  <para style="p">
    <verse number="21" style="v"/>अथ बालकस्य त्वक्छेदनकालेऽष्टमदिवसे समुपस्थिते तस्य गर्ब्भस्थितेः पुर्व्वं स्वर्गीयदूतो यथाज्ञापयत् तदनुरूपं ते तन्नामधेयं यीशुरिति चक्रिरे।</para>
  <para style="p">
    <verse number="22" style="v"/>ततः परं मूसालिखितव्यवस्थाया अनुसारेण मरियमः शुचित्वकाल उपस्थिते,</para>
  <para style="p">
    <verse number="23" style="v"/>"प्रथमजः सर्व्वः पुरुषसन्तानः परमेश्वरे समर्प्यतां," इति परमेश्वरस्य व्यवस्थया</para>
  <para style="p">
    <verse number="24" style="v"/>यीशुं परमेश्वरे समर्पयितुम् शास्त्रीयविध्युक्तं कपोतद्वयं पारावतशावकद्वयं वा बलिं दातुं ते तं गृहीत्वा यिरूशालमम् आययुः।</para>
  <para style="p">
    <verse number="25" style="v"/>यिरूशालम्पुरनिवासी शिमियोन्नामा धार्म्मिक एक आसीत् स इस्रायेलः सान्त्वनामपेक्ष्य तस्थौ किञ्च पवित्र आत्मा तस्मिन्नाविर्भूतः।</para>
  <para style="p">
    <verse number="26" style="v"/>अपरं प्रभुणा परमेश्वरेणाभिषिक्ते त्रातरि त्वया न दृष्टे त्वं न मरिष्यसीति वाक्यं पवित्रेण आत्मना तस्म प्राकथ्यत।</para>
  <para style="p">
    <verse number="27" style="v"/>अपरञ्च यदा यीशोः पिता माता च तदर्थं व्यवस्थानुरूपं कर्म्म कर्त्तुं तं मन्दिरम् आनिन्यतुस्तदा</para>
  <para style="p">
    <verse number="28" style="v"/>शिमियोन् आत्मन आकर्षणेन मन्दिरमागत्य तं क्रोडे निधाय ईश्वरस्य धन्यवादं कृत्वा कथयामास, यथा,</para>
  <para style="p">
    <verse number="29" style="v"/>हे प्रभो तव दासोयं निजवाक्यानुसारतः। इदानीन्तु सकल्याणो भवता संविसृज्यताम्।</para>
  <para style="p">
    <verse number="30" style="v"/>यतः सकलदेशस्य दीप्तये दीप्तिरूपकं।</para>
  <para style="p">
    <verse number="31" style="v"/>इस्रायेलीयलोकस्य महागौरवरूपकं।</para>
  <para style="p">
    <verse number="32" style="v"/>यं त्रायकं जनानान्तु सम्मुखे त्वमजीजनः। सएव विद्यतेऽस्माकं ध्रवं नयननगोचरे॥</para>
  <para style="p">
    <verse number="33" style="v"/>तदानीं तेनोक्ता एताः सकलाः कथाः श्रुत्वा तस्य माता यूषफ् च विस्मयं मेनाते।</para>
  <para style="p">
    <verse number="34" style="v"/>ततः परं शिमियोन् तेभ्य आशिषं दत्त्वा तन्मातरं मरियमम् उवाच, पश्य इस्रायेलो वंशमध्ये बहूनां पातनायोत्थापनाय च तथा विरोधपात्रं भवितुं, बहूनां गुप्तमनोगतानां प्रकटीकरणाय बालकोयं नियुक्तोस्ति।</para>
  <para style="p">
    <verse number="35" style="v"/>तस्मात् तवापि प्राणाः शूलेन व्यत्स्यन्ते।</para>
  <para style="p">
    <verse number="36" style="v"/>अपरञ्च आशेरस्य वंशीयफिनूयेलो दुहिता हन्नाख्या अतिजरती भविष्यद्वादिन्येका या विवाहात् परं सप्त वत्सरान् पत्या सह न्यवसत् ततो विधवा भूत्वा चतुरशीतिवर्षवयःपर्य्यनतं</para>
  <para style="p">
    <verse number="37" style="v"/>मन्दिरे स्थित्वा प्रार्थनोपवासैर्दिवानिशम् ईश्वरम् असेवत सापि स्त्री तस्मिन् समये मन्दिरमागत्य</para>
  <para style="p">
    <verse number="38" style="v"/>परमेश्वरस्य धन्यवादं चकार, यिरूशालम्पुरवासिनो यावन्तो लोका मुक्तिमपेक्ष्य स्थितास्तान् यीशोर्वृत्तान्तं ज्ञापयामास।</para>
  <para style="p">
    <verse number="39" style="v"/>इत्थं परमेश्वरस्य व्यवस्थानुसारेण सर्व्वेषु कर्म्मसु कृतेषु तौ पुनश्च गालीलो नासरत्नामकं निजनगरं प्रतस्थाते।</para>
  <para style="p">
    <verse number="40" style="v"/>तत्पश्चाद् बालकः शरीरेण वृद्धिमेत्य ज्ञानेन परिपूर्ण आत्मना शक्तिमांश्च भवितुमारेभे तथा तस्मिन् ईश्वरानुग्रहो बभूव।</para>
  <para style="p">
    <verse number="41" style="v"/>तस्य पिता माता च प्रतिवर्षं निस्तारोत्सवसमये यिरूशालमम् अगच्छताम्।</para>
  <para style="p">
    <verse number="42" style="v"/>अपरञ्च यीशौ द्वादशवर्षवयस्के सति तौ पर्व्वसमयस्य रीत्यनुसारेण यिरूशालमं गत्वा</para>
  <para style="p">
    <verse number="43" style="v"/>पार्व्वणं सम्पाद्य पुनरपि व्याघुय्य यातः किन्तु यीशुर्बालको यिरूशालमि तिष्ठति। यूषफ् तन्माता च तद् अविदित्वा</para>
  <para style="p">
    <verse number="44" style="v"/>स सङ्गिभिः सह विद्यत एतच्च बुद्व्वा दिनैकगम्यमार्गं जग्मतुः। किन्तु शेषे ज्ञातिबन्धूनां समीपे मृगयित्वा तदुद्देेशमप्राप्य</para>
  <para style="p">
    <verse number="45" style="v"/>तौ पुनरपि यिरूशालमम् परावृत्यागत्य तं मृगयाञ्चक्रतुः।</para>
  <para style="p">
    <verse number="46" style="v"/>अथ दिनत्रयात् परं पण्डितानां मध्ये तेषां कथाः शृण्वन् तत्त्वं पृच्छंश्च मन्दिरे समुपविष्टः स ताभ्यां दृष्टः।</para>
  <para style="p">
    <verse number="47" style="v"/>तदा तस्य बुद्ध्या प्रत्युत्तरैश्च सर्व्वे श्रोतारो विस्मयमापद्यन्ते।</para>
  <para style="p">
    <verse number="48" style="v"/>तादृशं दृष्ट्वा तस्य जनको जननी च चमच्चक्रतुः किञ्च तस्य माता तमवदत्, हे पुत्र, कथमावां प्रतीत्थं समाचरस्त्वम्? पश्य तव पिताहञ्च शोकाकुलौ सन्तौ त्वामन्विच्छावः स्म।</para>
  <para style="p">
    <verse number="49" style="v"/>ततः सोवदत् कुतो माम् अन्वैच्छतं? पितुर्गृहे मया स्थातव्यम् एतत् किं युवाभ्यां न ज्ञायते?</para>
  <para style="p">
    <verse number="50" style="v"/>किन्तु तौ तस्यैतद्वाक्यस्य तात्पर्य्यं बोद्धुं नाशक्नुतां।</para>
  <para style="p">
    <verse number="51" style="v"/>ततः परं स ताभ्यां सह नासरतं गत्वा तयोर्वशीभूतस्तस्थौ किन्तु सर्व्वा एताः कथास्तस्य माता मनसि स्थापयामास।</para>
  <para style="p">
    <verse number="52" style="v"/>अथ यीशो र्बुद्धिः शरीरञ्च तथा तस्मिन् ईश्वरस्य मानवानाञ्चानुग्रहो वर्द्धितुम् आरेभे।</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अनन्तरं तिबिरियकैसरस्य राजत्वस्य पञ्चदशे वत्सरे सति यदा पन्तीयपीलातो यिहूदादेशाधिपति र्हेरोद् तु गालील्प्रदेशस्य राजा फिलिपनामा तस्य भ्राता तु यितूरियायास्त्राखोनीतियाप्रदेशस्य च राजासीत् लुषानीयनामा अविलीनीदेशस्य राजासीत्</para>
  <para style="p">
    <verse number="2" style="v"/>हानन् कियफाश्चेमौ प्रधानयाजाकावास्तां तदानीं सिखरियस्य पुत्राय योहने मध्येप्रान्तरम् ईश्वरस्य वाक्ये प्रकाशिते सति</para>
  <para style="p">
    <verse number="3" style="v"/>स यर्द्दन उभयतटप्रदेशान् समेत्य पापमोचनार्थं मनःपरावर्त्तनस्य चिह्नरूपं यन्मज्जनं तदीयाः कथाः सर्व्वत्र प्रचारयितुमारेभे।</para>
  <para style="p">
    <verse number="4" style="v"/>यिशयियभविष्यद्वक्तृग्रन्थे यादृशी लिपिरास्ते यथा, परमेशस्य पन्थानं परिष्कुरुत सर्व्वतः। तस्य राजपथञ्चैव समानं कुरुताधुना।</para>
  <para style="p">
    <verse number="5" style="v"/>कारिष्यन्ते समुच्छ्रायाः सकला निम्नभूमयः। कारिष्यन्ते नताः सर्व्वे पर्व्वताश्चोपपर्व्वताः। कारिष्यन्ते च या वक्रास्ताः सर्व्वाः सरला भुवः। कारिष्यन्ते समानास्ता या उच्चनीचभूमयः।</para>
  <para style="p">
    <verse number="6" style="v"/>ईश्वरेण कृतं त्राणं द्रक्ष्यन्ति सर्व्वमानवाः। इत्येतत् प्रान्तरे वाक्यं वदतः कस्यचिद् रवः॥</para>
  <para style="p">
    <verse number="7" style="v"/>ये ये लोका मज्जनार्थं बहिराययुस्तान् सोवदत् रे रे सर्पवंशा आगामिनः कोपात् पलायितुं युष्मान् कश्चेतयामास?</para>
  <para style="p">
    <verse number="8" style="v"/>तस्माद् इब्राहीम् अस्माकं पिता कथामीदृशीं मनोभि र्न कथयित्वा यूयं मनःपरिवर्त्तनयोग्यं फलं फलत; युष्मानहं यथार्थं वदामि पाषाणेभ्य एतेभ्य ईश्वर इब्राहीमः सन्तानोत्पादने समर्थः।</para>
  <para style="p">
    <verse number="9" style="v"/>अपरञ्च तरुमूलेऽधुनापि परशुः संलग्नोस्ति यस्तरुरुत्तमं फलं न फलति स छिद्यतेऽग्नौ निक्षिप्यते च।</para>
  <para style="p">
    <verse number="10" style="v"/>तदानीं लोकास्तं पप्रच्छुस्तर्हि किं कर्त्तव्यमस्माभिः?</para>
  <para style="p">
    <verse number="11" style="v"/>ततः सोवादीत् यस्य द्वे वसने विद्येते स वस्त्रहीनायैकं वितरतु किंञ्च यस्य खाद्यद्रव्यं विद्यते सोपि तथैव करोतु।</para>
  <para style="p">
    <verse number="12" style="v"/>ततः परं करसञ्चायिनो मज्जनार्थम् आगत्य पप्रच्छुः हे गुरो किं कर्त्तव्यमस्माभिः?</para>
  <para style="p">
    <verse number="13" style="v"/>ततः सोकथयत् निरूपितादधिकं न गृह्लित।</para>
  <para style="p">
    <verse number="14" style="v"/>अनन्तरं सेनागण एत्य पप्रच्छ किमस्माभि र्वा कर्त्तव्यम्? ततः सोभिदधे कस्य कामपि हानिं मा कार्ष्ट तथा मृषापवादं मा कुरुत निजवेतनेन च सन्तुष्य तिष्ठत।</para>
  <para style="p">
    <verse number="15" style="v"/>अपरञ्च लोका अपेक्षया स्थित्वा सर्व्वेपीति मनोभि र्वितर्कयाञ्चक्रुः, योहनयम् अभिषिक्तस्त्राता न वेति?</para>
  <para style="p">
    <verse number="16" style="v"/>तदा योहन् सर्व्वान् व्याजहार, जलेऽहं युष्मान् मज्जयामि सत्यं किन्तु यस्य पादुकाबन्धनं मोचयितुमपि न योग्योस्मि तादृश एको मत्तो गुरुतरः पुमान् एति, स युष्मान् वह्निरूपे पवित्र आत्मनि मज्जयिष्यति।</para>
  <para style="p">
    <verse number="17" style="v"/>अपरञ्च तस्य हस्ते शूर्प आस्ते स स्वशस्यानि शुद्धरूपं प्रस्फोट्य गोधूमान् सर्व्वान् भाण्डागारे संग्रहीष्यति किन्तु बूषाणि सर्व्वाण्यनिर्व्वाणवह्निना दाहयिष्यति।</para>
  <para style="p">
    <verse number="18" style="v"/>योहन् उपदेशेनेत्थं नानाकथा लोकानां समक्षं प्रचारयामास।</para>
  <para style="p">
    <verse number="19" style="v"/>अपरञ्च हेरोद् राजा फिलिप्नाम्नः सहोदरस्य भार्य्यां हेरोदियामधि तथान्यानि यानि यानि कुकर्म्माणि कृतवान् तदधि च</para>
  <para style="p">
    <verse number="20" style="v"/>योहना तिरस्कृतो भूत्वा कारागारे तस्य बन्धनाद् अपरमपि कुकर्म्म चकार।</para>
  <para style="p">
    <verse number="21" style="v"/>इतः पूर्व्वं यस्मिन् समये सर्व्वे योहना मज्जितास्तदानीं यीशुरप्यागत्य मज्जितः।</para>
  <para style="p">
    <verse number="22" style="v"/>तदनन्तरं तेन प्रार्थिते मेघद्वारं मुक्तं तस्माच्च पवित्र आत्मा मूर्त्तिमान् भूत्वा कपोतवत् तदुपर्य्यवरुरोह; तदा त्वं मम प्रियः पुत्रस्त्वयि मम परमः सन्तोष इत्याकाशवाणी बभूव।</para>
  <para style="p">
    <verse number="23" style="v"/>तदानीं यीशुः प्रायेण त्रिंशद्वर्षवयस्क आसीत्। लौकिकज्ञाने तु स यूषफः पुत्रः,</para>
  <para style="p">
    <verse number="24" style="v"/>यूषफ् एलेः पुत्रः, एलिर्मत्ततः पुत्रः, मत्तत् लेवेः पुत्रः, लेवि र्मल्केः पुत्रः, मल्किर्यान्नस्य पुत्रः; यान्नो यूषफः पुत्रः।</para>
  <para style="p">
    <verse number="25" style="v"/>यूषफ् मत्तथियस्य पुत्रः, मत्तथिय आमोसः पुत्रः, आमोस् नहूमः पुत्रः, नहूम् इष्लेः पुत्रः इष्लिर्नगेः पुत्रः।</para>
  <para style="p">
    <verse number="26" style="v"/>नगिर्माटः पुत्रः, माट् मत्तथियस्य पुत्रः, मत्तथियः शिमियेः पुत्रः, शिमियिर्यूषफः पुत्रः, यूषफ् यिहूदाः पुत्रः।</para>
  <para style="p">
    <verse number="27" style="v"/>यिहूदा योहानाः पुत्रः, योहाना रीषाः पुत्रः, रीषाः सिरुब्बाबिलः पुत्रः, सिरुब्बाबिल् शल्तीयेलः पुत्रः, शल्तीयेल् नेरेः पुत्रः।</para>
  <para style="p">
    <verse number="28" style="v"/>नेरिर्मल्केः पुत्रः, मल्किः अद्यः पुत्रः, अद्दी कोषमः पुत्रः, कोषम् इल्मोददः पुत्रः, इल्मोदद् एरः पुत्रः।</para>
  <para style="p">
    <verse number="29" style="v"/>एर् योशेः पुत्रः, योशिः इलीयेषरः पुत्रः, इलीयेषर् योरीमः पुत्रः, योरीम् मत्ततः पुत्रः, मत्तत लेवेः पुत्रः।</para>
  <para style="p">
    <verse number="30" style="v"/>लेविः शिमियोनः पुत्रः, शिमियोन् यिहूदाः पुत्रः, यिहूदा यूषुफः पुत्रः, यूषुफ् योननः पुत्रः, यानन् इलीयाकीमः पुत्रः।</para>
  <para style="p">
    <verse number="31" style="v"/>इलियाकीम्ः मिलेयाः पुत्रः, मिलेया मैननः पुत्रः, मैनन् मत्तत्तस्य पुत्रः, मत्तत्तो नाथनः पुत्रः, नाथन् दायूदः पुत्रः।</para>
  <para style="p">
    <verse number="32" style="v"/>दायूद् यिशयः पुत्रः, यिशय ओबेदः पुत्र, ओबेद् बोयसः पुत्रः, बोयस् सल्मोनः पुत्रः, सल्मोन् नहशोनः पुत्रः।</para>
  <para style="p">
    <verse number="33" style="v"/>नहशोन् अम्मीनादबः पुत्रः, अम्मीनादब् अरामः पुत्रः, अराम् हिष्रोणः पुत्रः, हिष्रोण् पेरसः पुत्रः, पेरस् यिहूदाः पुत्रः।</para>
  <para style="p">
    <verse number="34" style="v"/>यिहूदा याकूबः पुत्रः, याकूब् इस्हाकः पुत्रः, इस्हाक् इब्राहीमः पुत्रः, इब्राहीम् तेरहः पुत्रः, तेरह् नाहोरः पुत्रः।</para>
  <para style="p">
    <verse number="35" style="v"/>नाहोर् सिरुगः पुत्रः, सिरुग् रिय्वः पुत्रः, रियूः पेलगः पुत्रः, पेलग् एवरः पुत्रः, एवर् शेलहः पुत्रः।</para>
  <para style="p">
    <verse number="36" style="v"/>शेलह् कैननः पुत्रः, कैनन् अर्फक्षदः पुत्रः, अर्फक्षद् शामः पुत्रः, शाम् नोहः पुत्रः, नोहो लेमकः पुत्रः।</para>
  <para style="p">
    <verse number="37" style="v"/>लेमक् मिथूशेलहः पुत्रः, मिथूशेलह् हनोकः पुत्रः, हनोक् येरदः पुत्रः, येरद् महललेलः पुत्रः, महललेल् कैननः पुत्रः।</para>
  <para style="p">
    <verse number="38" style="v"/>कैनन् इनोशः पुत्रः, इनोश् शेतः पुत्रः, शेत् आदमः पुत्र, आदम् ईश्वरस्य पुत्रः।</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ततः परं यीशुः पवित्रेणात्मना पूर्णः सन् यर्द्दननद्याः परावृत्यात्मना प्रान्तरं नीतः सन् चत्वारिंशद्दिनानि यावत् शैताना परीक्षितोऽभूत्,</para>
  <para style="p">
    <verse number="2" style="v"/>किञ्च तानि सर्व्वदिनानि भोजनं विना स्थितत्वात् काले पूर्णे स क्षुधितवान्।</para>
  <para style="p">
    <verse number="3" style="v"/>ततः शैतानागत्य तमवदत् त्वं चेदीश्वरस्य पुत्रस्तर्हि प्रस्तरानेतान् आज्ञया पूपान् कुरु।</para>
  <para style="p">
    <verse number="4" style="v"/>तदा यीशुरुवाच, लिपिरीदृशी विद्यते मनुजः केवलेन पूपेन न जीवति किन्त्वीश्वरस्य सर्व्वाभिराज्ञाभि र्जीवति।</para>
  <para style="p">
    <verse number="5" style="v"/>तदा शैतान् तमुच्चं पर्व्वतं नीत्वा निमिषैकमध्ये जगतः सर्व्वराज्यानि दर्शितवान्।</para>
  <para style="p">
    <verse number="6" style="v"/>पश्चात् तमवादीत् सर्व्वम् एतद् विभवं प्रतापञ्च तुभ्यं दास्यामि तन् मयि समर्पितमास्ते यं प्रति ममेच्छा जायते तस्मै दातुं शक्नोमि,</para>
  <para style="p">
    <verse number="7" style="v"/>त्वं चेन्मां भजसे तर्हि सर्व्वमेतत् तवैव भविष्यति।</para>
  <para style="p">
    <verse number="8" style="v"/>तदा यीशुस्तं प्रत्युक्तवान् दूरी भव शैतान् लिपिरास्ते, निजं प्रभुं परमेश्वरं भजस्व केवलं तमेव सेवस्व च।</para>
  <para style="p">
    <verse number="9" style="v"/>अथ शैतान् तं यिरूशालमं नीत्वा मन्दिरस्य चूडाया उपरि समुपवेश्य जगाद त्वं चेदीश्वरस्य पुत्रस्तर्हि स्थानादितो लम्फित्वाधः</para>
  <para style="p">
    <verse number="10" style="v"/>पत यतो लिपिरास्ते, आज्ञापयिष्यति स्वीयान् दूतान् स परमेश्वरः।</para>
  <para style="p">
    <verse number="11" style="v"/>रक्षितुं सर्व्वमार्गे त्वां तेन त्वच्चरणे यथा। न लगेत् प्रस्तराघातस्त्वां धरिष्यन्ति ते तथा।</para>
  <para style="p">
    <verse number="12" style="v"/>तदा यीशुना प्रत्युक्तम् इदमप्युक्तमस्ति त्वं स्वप्रभुं परेशं मा परीक्षस्व।</para>
  <para style="p">
    <verse number="13" style="v"/>पश्चात् शैतान् सर्व्वपरीक्षां समाप्य क्षणात्तं त्यक्त्वा ययौ।</para>
  <para style="p">
    <verse number="14" style="v"/>तदा यीशुरात्मप्रभावात् पुनर्गालील्प्रदेशं गतस्तदा तत्सुख्यातिश्चतुर्दिशं व्यानशे।</para>
  <para style="p">
    <verse number="15" style="v"/>स तेषां भजनगृहेषु उपदिश्य सर्व्वैः प्रशंसितो बभूव।</para>
  <para style="p">
    <verse number="16" style="v"/>अथ स स्वपालनस्थानं नासरत्पुरमेत्य विश्रामवारे स्वाचाराद् भजनगेहं प्रविश्य पठितुमुत्तस्थौ।</para>
  <para style="p">
    <verse number="17" style="v"/>ततो यिशयियभविष्यद्वादिनः पुस्तके तस्य करदत्ते सति स तत् पुस्तकं विस्तार्य्य यत्र वक्ष्यमाणानि वचनानि सन्ति तत् स्थानं प्राप्य पपाठ।</para>
  <para style="p">
    <verse number="18" style="v"/>आत्मा तु परमेशस्य मदीयोपरि विद्यते। दरिद्रेषु सुसंवादं वक्तुं मां सोभिषिक्तवान्। भग्नान्तः करणाल्लोकान् सुस्वस्थान् कर्त्तुमेव च। बन्दीकृतेषु लोकेषु मुक्ते र्घोषयितुं वचः। नेत्राणि दातुमन्धेभ्यस्त्रातुं बद्धजनानपि।</para>
  <para style="p">
    <verse number="19" style="v"/>परेशानुग्रहे कालं प्रचारयितुमेव च। सर्व्वैतत्करणार्थाय मामेव प्रहिणोति सः॥</para>
  <para style="p">
    <verse number="20" style="v"/>ततः पुस्तकं बद्व्वा परिचारकस्य हस्ते समर्प्य चासने समुपविष्टः, ततो भजनगृहे यावन्तो लोका आसन् ते सर्व्वेऽनन्यदृष्ट्या तं विलुलोकिरे।</para>
  <para style="p">
    <verse number="21" style="v"/>अनन्तरम् अद्यैतानि सर्व्वाणि लिखितवचनानि युष्माकं मध्ये सिद्धानि स इमां कथां तेभ्यः कथयितुमारेभे।</para>
  <para style="p">
    <verse number="22" style="v"/>ततः सर्व्वे तस्मिन् अन्वरज्यन्त, किञ्च तस्य मुखान्निर्गताभिरनुग्रहस्य कथाभिश्चमत्कृत्य कथयामासुः किमयं यूषफः पुत्रो न?</para>
  <para style="p">
    <verse number="23" style="v"/>तदा सोऽवादीद् हे चिकित्सक स्वमेव स्वस्थं कुरु कफर्नाहूमि यद्यत् कृतवान् तदश्रौष्म ताः सर्वाः क्रिया अत्र स्वदेशे कुरु कथामेतां यूयमेवावश्यं मां वदिष्यथ।</para>
  <para style="p">
    <verse number="24" style="v"/>पुनः सोवादीद् युष्मानहं यथार्थं वदामि, कोपि भविष्यद्वादी स्वदेशे सत्कारं न प्राप्नोति।</para>
  <para style="p">
    <verse number="25" style="v"/>अपरञ्च यथार्थं वच्मि, एलियस्य जीवनकाले यदा सार्द्धत्रितयवर्षाणि यावत् जलदप्रतिबन्धात् सर्व्वस्मिन् देशे महादुर्भिक्षम् अजनिष्ट तदानीम् इस्रायेलो देशस्य मध्ये बह्व्यो विधवा आसन्,</para>
  <para style="p">
    <verse number="26" style="v"/>किन्तु सीदोन्प्रदेशीयसारिफत्पुरनिवासिनीम् एकां विधवां विना कस्याश्चिदपि समीपे एलियः प्रेरितो नाभूत्।</para>
  <para style="p">
    <verse number="27" style="v"/>अपरञ्च इलीशायभविष्यद्वादिविद्यमानताकाले इस्रायेल्देशे बहवः कुष्ठिन आसन् किन्तु सुरीयदेशीयं नामान्कुष्ठिनं विना कोप्यन्यः परिष्कृतो नाभूत्।</para>
  <para style="p">
    <verse number="28" style="v"/>इमां कथां श्रुत्वा भजनगेहस्थिता लोकाः सक्रोधम् उत्थाय</para>
  <para style="p">
    <verse number="29" style="v"/>नगरात्तं बहिष्कृत्य यस्य शिखरिण उपरि तेषां नगरं स्थापितमास्ते तस्मान्निक्षेप्तुं तस्य शिखरं तं निन्युः</para>
  <para style="p">
    <verse number="30" style="v"/>किन्तु स तेषां मध्यादपसृत्य स्थानान्तरं जगाम।</para>
  <para style="p">
    <verse number="31" style="v"/>ततः परं यीशुर्गालील्प्रदेशीयकफर्नाहूम्नगर उपस्थाय विश्रामवारे लोकानुपदेष्टुम् आरब्धवान्।</para>
  <para style="p">
    <verse number="32" style="v"/>तदुपदेशात् सर्व्वे चमच्चक्रु र्यतस्तस्य कथा गुरुतरा आसन्।</para>
  <para style="p">
    <verse number="33" style="v"/>तदानीं तद्भजनगेहस्थितोऽमेध्यभूतग्रस्त एको जन उच्चैः कथयामास,</para>
  <para style="p">
    <verse number="34" style="v"/>हे नासरतीययीशोऽस्मान् त्यज, त्वया सहास्माकं कः सम्बन्धः? किमस्मान् विनाशयितुमायासि? त्वमीश्वरस्य पवित्रो जन एतदहं जानामि।</para>
  <para style="p">
    <verse number="35" style="v"/>तदा यीशुस्तं तर्जयित्वावदत् मौनी भव इतो बहिर्भव; ततः सोमेध्यभूतस्तं मध्यस्थाने पातयित्वा किञ्चिदप्यहिंसित्वा तस्माद् बहिर्गतवान्।</para>
  <para style="p">
    <verse number="36" style="v"/>ततः सर्व्वे लोकाश्चमत्कृत्य परस्परं वक्तुमारेभिरे कोयं चमत्कारः। एष प्रभावेण पराक्रमेण चामेध्यभूतान् आज्ञापयति तेनैव ते बहिर्गच्छन्ति।</para>
  <para style="p">
    <verse number="37" style="v"/>अनन्तरं चतुर्दिक्स्थदेशान् तस्य सुख्यातिर्व्याप्नोत्।</para>
  <para style="p">
    <verse number="38" style="v"/>तदनन्तरं स भजनगेहाद् बहिरागत्य शिमोनो निवेशनं प्रविवेश तदा तस्य श्वश्रूर्ज्वरेणात्यन्तं पीडितासीत् शिष्यास्तदर्थं तस्मिन् विनयं चक्रुः।</para>
  <para style="p">
    <verse number="39" style="v"/>ततः स तस्याः समीपे स्थित्वा ज्वरं तर्जयामास तेनैव तां ज्वरोऽत्याक्षीत् ततः सा तत्क्षणम् उत्थाय तान् सिषेवे।</para>
  <para style="p">
    <verse number="40" style="v"/>अथ सूर्य्यास्तकाले स्वेषां ये ये जना नानारोगैः पीडिता आसन् लोकास्तान् यीशोः समीपम् आनिन्युः, तदा स एकैकस्य गात्रे करमर्पयित्वा तानरोगान् चकार।</para>
  <para style="p">
    <verse number="41" style="v"/>ततो भूता बहुभ्यो निर्गत्य चीत्शब्दं कृत्वा च बभाषिरे त्वमीश्वरस्य पुत्रोऽभिषिक्तत्राता; किन्तु सोभिषिक्तत्रातेति ते विविदुरेतस्मात् कारणात् तान् तर्जयित्वा तद्वक्तुं निषिषेध।</para>
  <para style="p">
    <verse number="42" style="v"/>अपरञ्च प्रभाते सति स विजनस्थानं प्रतस्थे पश्चात् जनास्तमन्विच्छन्तस्तन्निकटं गत्वा स्थानान्तरगमनार्थं तमन्वरुन्धन्।</para>
  <para style="p">
    <verse number="43" style="v"/>किन्तु स तान् जगाद, ईश्वरीयराज्यस्य सुसंवादं प्रचारयितुम् अन्यानि पुराण्यपि मया यातव्यानि यतस्तदर्थमेव प्रेरितोहं।</para>
  <para style="p">
    <verse number="44" style="v"/>अथ गालीलो भजनगेहेषु स उपदिदेश।</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अनन्तरं यीशुरेकदा गिनेषरत्ह्दस्य तीर उत्तिष्ठति, तदा लोका ईश्वरीयकथां श्रोतुं तदुपरि प्रपतिताः।</para>
  <para style="p">
    <verse number="2" style="v"/>तदानीं स ह्दस्य तीरसमीपे नौद्वयं ददर्श किञ्च मत्स्योपजीविनो नावं विहाय जालं प्रक्षालयन्ति।</para>
  <para style="p">
    <verse number="3" style="v"/>ततस्तयोर्द्वयो र्मध्ये शिमोनो नावमारुह्य तीरात् किञ्चिद्दूरं यातुं तस्मिन् विनयं कृत्वा नौकायामुपविश्य लोकान् प्रोपदिष्टवान्।</para>
  <para style="p">
    <verse number="4" style="v"/>पश्चात् तं प्रस्तावं समाप्य स शिमोनं व्याजहार, गभीरं जलं गत्वा मत्स्यान् धर्त्तुं जालं निक्षिप।</para>
  <para style="p">
    <verse number="5" style="v"/>ततः शिमोन बभाषे, हे गुरो यद्यपि वयं कृत्स्नां यामिनीं परिश्रम्य मत्स्यैकमपि न प्राप्तास्तथापि भवतो निदेशतो जालं क्षिपामः।</para>
  <para style="p">
    <verse number="6" style="v"/>अथ जाले क्षिप्ते बहुमत्स्यपतनाद् आनायः प्रच्छिन्नः।</para>
  <para style="p">
    <verse number="7" style="v"/>तस्माद् उपकर्त्तुम् अन्यनौस्थान् सङ्गिन आयातुम् इङ्गितेन समाह्वयन् ततस्त आगत्य मत्स्यै र्नौद्वयं प्रपूरयामासु र्यै र्नौद्वयं प्रमग्नम्।</para>
  <para style="p">
    <verse number="8" style="v"/>तदा शिमोन्पितरस्तद् विलोक्य यीशोश्चरणयोः पतित्वा, हे प्रभोहं पापी नरो मम निकटाद् भवान् यातु, इति कथितवान्।</para>
  <para style="p">
    <verse number="9" style="v"/>यतो जाले पतितानां मत्स्यानां यूथात् शिमोन् तत्सङ्गिनश्च चमत्कृतवन्तः; शिमोनः सहकारिणौ सिवदेः पुत्रौ याकूब् योहन् चेमौ तादृशौ बभूवतुः।</para>
  <para style="p">
    <verse number="10" style="v"/>तदा यीशुः शिमोनं जगाद मा भैषीरद्यारभ्य त्वं मनुष्यधरो भविष्यसि।</para>
  <para style="p">
    <verse number="11" style="v"/>अनन्तरं सर्व्वासु नौसु तीरम् आनीतासु ते सर्व्वान् परित्यज्य तस्य पश्चाद्गामिनो बभूवुः।</para>
  <para style="p">
    <verse number="12" style="v"/>ततः परं यीशौ कस्मिंश्चित् पुरे तिष्ठति जन एकः सर्व्वाङ्गकुष्ठस्तं विलोक्य तस्य समीपे न्युब्जः पतित्वा सविनयं वक्तुमारेभे, हे प्रभो यदि भवानिच्छति तर्हि मां परिष्कर्त्तुं शक्नोति।</para>
  <para style="p">
    <verse number="13" style="v"/>तदानीं स पाणिं प्रसार्य्य तदङ्गं स्पृशन् बभाषे त्वं परिष्क्रियस्वेति ममेच्छास्ति ततस्तत्क्षणं स कुष्ठात् मुक्तः।</para>
  <para style="p">
    <verse number="14" style="v"/>पश्चात् स तमाज्ञापयामास कथामिमां कस्मैचिद् अकथयित्वा याजकस्य समीपञ्च गत्वा स्वं दर्शय, लोकेभ्यो निजपरिष्कृतत्वस्य प्रमाणदानाय मूसाज्ञानुसारेण द्रव्यमुत्मृजस्व च।</para>
  <para style="p">
    <verse number="15" style="v"/>तथापि यीशोः सुख्याति र्बहु व्याप्तुमारेभे किञ्च तस्य कथां श्रोतुं स्वीयरोगेभ्यो मोक्तुञ्च लोका आजग्मुः।</para>
  <para style="p">
    <verse number="16" style="v"/>अथ स प्रान्तरं गत्वा प्रार्थयाञ्चक्रे।</para>
  <para style="p">
    <verse number="17" style="v"/>अपरञ्च एकदा यीशुरुपदिशति, एतर्हि गालील्यिहूदाप्रदेशयोः सर्व्वनगरेभ्यो यिरूशालमश्च कियन्तः फिरूशिलोका व्यवस्थापकाश्च समागत्य तदन्तिके समुपविविशुः, तस्मिन् काले लोकानामारोग्यकारणात् प्रभोः प्रभावः प्रचकाशे।</para>
  <para style="p">
    <verse number="18" style="v"/>पश्चात् कियन्तो लोका एकं पक्षाघातिनं खट्वायां निधाय यीशोः समीपमानेतुं सम्मुखे स्थापयितुञ्च व्याप्रियन्त।</para>
  <para style="p">
    <verse number="19" style="v"/>किन्तु बहुजननिवहसम्वाधात् न शक्नुवन्तो गृहोपरि गत्वा गृहपृष्ठं खनित्वा तं पक्षाघातिनं सखट्वं गृहमध्ये यीशोः सम्मुखे ऽवरोहयामासुः।</para>
  <para style="p">
    <verse number="20" style="v"/>तदा यीशुस्तेषाम् ईदृशं विश्वासं विलोक्य तं पक्षाघातिनं व्याजहार, हे मानव तव पापमक्षम्यत।</para>
  <para style="p">
    <verse number="21" style="v"/>तस्माद् अध्यापकाः फिरूशिनश्च चित्तैरित्थं प्रचिन्तितवन्तः, एष जन ईश्वरं निन्दति कोयं? केवलमीश्वरं विना पापं क्षन्तुं कः शक्नोति?</para>
  <para style="p">
    <verse number="22" style="v"/>तदा यीशुस्तेषाम् इत्थं चिन्तनं विदित्वा तेभ्योकथयद् यूयं मनोभिः कुतो वितर्कयथ?</para>
  <para style="p">
    <verse number="23" style="v"/>तव पापक्षमा जाता यद्वा त्वमुत्थाय व्रज एतयो र्मध्ये का कथा सुकथ्या?</para>
  <para style="p">
    <verse number="24" style="v"/>किन्तु पृथिव्यां पापं क्षन्तुं मानवसुतस्य सामर्थ्यमस्तीति यथा यूयं ज्ञातुं शक्नुथ तदर्थं (स तं पक्षाघातिनं जगाद) उत्तिष्ठ स्वशय्यां गृहीत्वा गृहं याहीति त्वामादिशामि।</para>
  <para style="p">
    <verse number="25" style="v"/>तस्मात् स तत्क्षणम् उत्थाय सर्व्वेषां साक्षात् निजशयनीयं गृहीत्वा ईश्वरं धन्यं वदन् निजनिवेशनं ययौ।</para>
  <para style="p">
    <verse number="26" style="v"/>तस्मात् सर्व्वे विस्मय प्राप्ता मनःसु भीताश्च वयमद्यासम्भवकार्य्याण्यदर्शाम इत्युक्त्वा परमेश्वरं धन्यं प्रोदिताः।</para>
  <para style="p">
    <verse number="27" style="v"/>ततः परं बहिर्गच्छन् करसञ्चयस्थाने लेविनामानं करसञ्चायकं दृष्ट्वा यीशुस्तमभिदधे मम पश्चादेहि।</para>
  <para style="p">
    <verse number="28" style="v"/>तस्मात् स तत्क्षणात् सर्व्वं परित्यज्य तस्य पश्चादियाय।</para>
  <para style="p">
    <verse number="29" style="v"/>अनन्तरं लेवि र्निजगृहे तदर्थं महाभोज्यं चकार, तदा तैः सहानेके करसञ्चायिनस्तदन्यलोकाश्च भोक्तुमुपविविशुः।</para>
  <para style="p">
    <verse number="30" style="v"/>तस्मात् कारणात् चण्डालानां पापिलोकानाञ्च सङ्गे यूयं कुतो भंग्ध्वे पिवथ चेति कथां कथयित्वा फिरूशिनोऽध्यापकाश्च तस्य शिष्यैः सह वाग्युद्धं कर्त्तुमारेभिरे।</para>
  <para style="p">
    <verse number="31" style="v"/>तस्माद् यीशुस्तान् प्रत्यवोचद् अरोगलोकानां चिकित्सकेन प्रयोजनं नास्ति किन्तु सरोगाणामेव।</para>
  <para style="p">
    <verse number="32" style="v"/>अहं धार्म्मिकान् आह्वातुं नागतोस्मि किन्तु मनः परावर्त्तयितुं पापिन एव।</para>
  <para style="p">
    <verse number="33" style="v"/>ततस्ते प्रोचुः, योहनः फिरूशिनाञ्च शिष्या वारंवारम् उपवसन्ति प्रार्थयन्ते च किन्तु तव शिष्याः कुतो भुञ्जते पिवन्ति च?</para>
  <para style="p">
    <verse number="34" style="v"/>तदा स तानाचख्यौ वरे सङ्गे तिष्ठति वरस्य सखिगणं किमुपवासयितुं शक्नुथ?</para>
  <para style="p">
    <verse number="35" style="v"/>किन्तु यदा तेषां निकटाद् वरो नेष्यते तदा ते समुपवत्स्यन्ति।</para>
  <para style="p">
    <verse number="36" style="v"/>सोपरमपि दृष्टान्तं कथयाम्बभूव पुरातनवस्त्रे कोपि नुतनवस्त्रं न सीव्यति यतस्तेन सेवनेन जीर्णवस्त्रं छिद्यते, नूतनपुरातनवस्त्रयो र्मेलञ्च न भवति।</para>
  <para style="p">
    <verse number="37" style="v"/>पुरातन्यां कुत्वां कोपि नुतनं द्राक्षारसं न निदधाति, यतो नवीनद्राक्षारसस्य तेजसा पुरातनी कुतू र्विदीर्य्यते ततो द्राक्षारसः पतति कुतूश्च नश्यति।</para>
  <para style="p">
    <verse number="38" style="v"/>ततो हेतो र्नूतन्यां कुत्वां नवीनद्राक्षारसः निधातव्यस्तेनोभयस्य रक्षा भवति।</para>
  <para style="p">
    <verse number="39" style="v"/>अपरञ्च पुरातनं द्राक्षारसं पीत्वा कोपि नूतनं न वाञ्छति, यतः स वक्ति नूतनात् पुरातनम् प्रशस्तम्।</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अचरञ्च पर्व्वणो द्वितीयदिनात् परं प्रथमविश्रामवारे शस्यक्षेत्रेण यीशोर्गमनकाले तस्य शिष्याः कणिशं छित्त्वा करेषु मर्द्दयित्वा खादितुमारेभिरे।</para>
  <para style="p">
    <verse number="2" style="v"/>तस्मात् कियन्तः फिरूशिनस्तानवदन् विश्रामवारे यत् कर्म्म न कर्त्तव्यं तत् कुतः कुरुथ?</para>
  <para style="p">
    <verse number="3" style="v"/>यीशुः प्रत्युवाच दायूद् तस्य सङ्गिनश्च क्षुधार्त्ताः किं चक्रुः स कथम् ईश्वरस्य मन्दिरं प्रविश्य</para>
  <para style="p">
    <verse number="4" style="v"/>ये दर्शनीयाः पूपा याजकान् विनान्यस्य कस्याप्यभोजनीयास्तानानीय स्वयं बुभजे सङ्गिभ्योपि ददौ तत् किं युष्माभिः कदापि नापाठि?</para>
  <para style="p">
    <verse number="5" style="v"/>पश्चात् स तानवदत् मनुजसुतो विश्रामवारस्यापि प्रभु र्भवति।</para>
  <para style="p">
    <verse number="6" style="v"/>अनन्तरम् अन्यविश्रामवारे स भजनगेहं प्रविश्य समुपदिशति। तदा तत्स्थाने शुष्कदक्षिणकर एकः पुमान् उपतस्थिवान्।</para>
  <para style="p">
    <verse number="7" style="v"/>तस्माद् अध्यापकाः फिरूशिनश्च तस्मिन् दोषमारोपयितुं स विश्रामवारे तस्य स्वास्थ्यं करोति नवेति प्रतीक्षितुमारेभिरे।</para>
  <para style="p">
    <verse number="8" style="v"/>तदा यीशुस्तेषां चिन्तां विदित्वा तं शुष्ककरं पुमांसं प्रोवाच, त्वमुत्थाय मध्यस्थाने तिष्ठ।</para>
  <para style="p">
    <verse number="9" style="v"/>तस्मात् तस्मिन् उत्थितवति यीशुस्तान् व्याजहार, युष्मान् इमां कथां पृच्छामि, विश्रामवारे हितम् अहितं वा, प्राणरक्षणं प्राणनाशनं वा, एतेषां किं कर्म्मकरणीयम्?</para>
  <para style="p">
    <verse number="10" style="v"/>पश्चात् चतुर्दिक्षु सर्व्वान् विलोक्य तं मानवं बभाषे, निजकरं प्रसारय; ततस्तेन तथा कृत इतरकरवत् तस्य हस्तः स्वस्थोभवत्।</para>
  <para style="p">
    <verse number="11" style="v"/>तस्मात् ते प्रचण्डकोपान्विता यीशुं किं करिष्यन्तीति परस्परं प्रमन्त्रिताः।</para>
  <para style="p">
    <verse number="12" style="v"/>ततः परं स पर्व्वतमारुह्येश्वरमुद्दिश्य प्रार्थयमानः कृत्स्नां रात्रिं यापितवान्।</para>
  <para style="p">
    <verse number="13" style="v"/>अथ दिने सति स सर्व्वान् शिष्यान् आहूतवान् तेषां मध्ये</para>
  <para style="p">
    <verse number="14" style="v"/>पितरनाम्ना ख्यातः शिमोन् तस्य भ्राता आन्द्रियश्च याकूब् योहन् च फिलिप् बर्थलमयश्च</para>
  <para style="p">
    <verse number="15" style="v"/>मथिः थोमा आल्फीयस्य पुत्रो याकूब् ज्वलन्तनाम्ना ख्यातः शिमोन्</para>
  <para style="p">
    <verse number="16" style="v"/>च याकूबो भ्राता यिहूदाश्च तं यः परकरेषु समर्पयिष्यति स ईष्करीयोतीययिहूदाश्चैतान् द्वादश जनान् मनोनीतान् कृत्वा स जग्राह तथा प्रेरित इति तेषां नाम चकार।</para>
  <para style="p">
    <verse number="17" style="v"/>ततः परं स तैः सह पर्व्वतादवरुह्य उपत्यकायां तस्थौ ततस्तस्य शिष्यसङ्घो यिहूदादेशाद् यिरूशालमश्च सोरः सीदोनश्च जलधे रोधसो जननिहाश्च एत्य तस्य कथाश्रवणार्थं रोगमुक्त्यर्थञ्च तस्य समीपे तस्थुः।</para>
  <para style="p">
    <verse number="18" style="v"/>अमेध्यभूतग्रस्ताश्च तन्निकटमागत्य स्वास्थ्यं प्रापुः।</para>
  <para style="p">
    <verse number="19" style="v"/>सर्व्वेषां स्वास्थ्यकरणप्रभावस्य प्रकाशितत्वात् सर्व्वे लोका एत्य तं स्प्रष्टुं येतिरे।</para>
  <para style="p">
    <verse number="20" style="v"/>पश्चात् स शिष्यान् प्रति दृष्टिं कुत्वा जगाद, हे दरिद्रा यूयं धन्या यत ईश्वरीये राज्ये वोऽधिकारोस्ति।</para>
  <para style="p">
    <verse number="21" style="v"/>हे अधुना क्षुधितलोका यूयं धन्या यतो यूयं तर्प्स्यथ; हे इह रोदिनो जना यूयं धन्या यतो यूयं हसिष्यथ।</para>
  <para style="p">
    <verse number="22" style="v"/>यदा लोका मनुष्यसूनो र्नामहेतो र्युष्मान् ऋृतीयिष्यन्ते पृथक् कृत्वा निन्दिष्यन्ति, अधमानिव युष्मान् स्वसमीपाद् दूरीकरिष्यन्ति च तदा यूयं धन्याः।</para>
  <para style="p">
    <verse number="23" style="v"/>स्वर्गे युष्माकं यथेष्टं फलं भविष्यति, एतदर्थं तस्मिन् दिने प्रोल्लसत आनन्देन नृत्यत च, तेषां पूर्व्वपुरुषाश्च भविष्यद्वादिनः प्रति तथैव व्यवाहरन्।</para>
  <para style="p">
    <verse number="24" style="v"/>किन्तु हा हा धनवन्तो यूयं सुखं प्राप्नुत। हन्त परितृप्ता यूयं क्षुधिता भविष्यथ;</para>
  <para style="p">
    <verse number="25" style="v"/>इह हसन्तो यूयं वत युष्माभिः शोचितव्यं रोदितव्यञ्च।</para>
  <para style="p">
    <verse number="26" style="v"/>सर्व्वैलाकै र्युष्माकं सुख्यातौ कृतायां युष्माकं दुर्गति र्भविष्यति युष्माकं पूर्व्वपुरुषा मृषाभविष्यद्वादिनः प्रति तद्वत् कृतवन्तः।</para>
  <para style="p">
    <verse number="27" style="v"/>हे श्रोतारो युष्मभ्यमहं कथयामि, यूयं शत्रुषु प्रीयध्वं ये च युष्मान् द्विषन्ति तेषामपि हितं कुरुत।</para>
  <para style="p">
    <verse number="28" style="v"/>ये च युष्मान् शपन्ति तेभ्य आशिषं दत्त ये च युष्मान् अवमन्यन्ते तेषां मङ्गलं प्रार्थयध्वं।</para>
  <para style="p">
    <verse number="29" style="v"/>यदि कश्चित् तव कपोले चपेटाघातं करोति तर्हि तं प्रति कपोलम् अन्यं परावर्त्त्य सम्मुखीकुरु पुनश्च यदि कश्चित् तव गात्रीयवस्त्रं हरति तर्हि तं परिधेयवस्त्रम् अपि ग्रहीतुं मा वारय।</para>
  <para style="p">
    <verse number="30" style="v"/>यस्त्वां याचते तस्मै देहि, यश्च तव सम्पत्तिं हरति तं मा याचस्व।</para>
  <para style="p">
    <verse number="31" style="v"/>परेभ्यः स्वान् प्रति यथाचरणम् अपेक्षध्वे परान् प्रति यूयमपि तथाचरत।</para>
  <para style="p">
    <verse number="32" style="v"/>ये जना युष्मासु प्रीयन्ते केवलं तेषु प्रीयमाणेषु युष्माकं किं फलं? पापिलोका अपि स्वेषु प्रीयमाणेषु प्रीयन्ते।</para>
  <para style="p">
    <verse number="33" style="v"/>यदि हितकारिण एव हितं कुरुथ तर्हि युष्माकं किं फलं? पापिलोका अपि तथा कुर्व्वन्ति।</para>
  <para style="p">
    <verse number="34" style="v"/>येभ्य ऋणपरिशोधस्य प्राप्तिप्रत्याशास्ते केवलं तेषु ऋणे समर्पिते युष्माकं किं फलं? पुनः प्राप्त्याशया पापीलोका अपि पापिजनेषु ऋणम् अर्पयन्ति।</para>
  <para style="p">
    <verse number="35" style="v"/>अतो यूयं रिपुष्वपि प्रीयध्वं, परहितं कुरुत च; पुनः प्राप्त्याशां त्यक्त्वा ऋणमर्पयत, तथा कृते युष्माकं महाफलं भविष्यति, यूयञ्च सर्व्वप्रधानस्य सन्ताना इति ख्यातिं प्राप्स्यथ, यतो युष्माकं पिता कृतघ्नानां दुर्व्टत्तानाञ्च हितमाचरति।</para>
  <para style="p">
    <verse number="36" style="v"/>अत एव स यथा दयालु र्यूयमपि तादृशा दयालवो भवत।</para>
  <para style="p">
    <verse number="37" style="v"/>अपरञ्च परान् दोषिणो मा कुरुत तस्माद् यूयं दोषीकृता न भविष्यथ; अदण्ड्यान् मा दण्डयत तस्माद् यूयमपि दण्डं न प्राप्स्यथ; परेषां दोषान् क्षमध्वं तस्माद् युष्माकमपि दोषाः क्षमिष्यन्ते।</para>
  <para style="p">
    <verse number="38" style="v"/>दानानिदत्त तस्माद् यूयं दानानि प्राप्स्यथ, वरञ्च लोकाः परिमाणपात्रं प्रदलय्य सञ्चाल्य प्रोञ्चाल्य परिपूर्य्य युष्माकं क्रोडेषु समर्पयिष्यन्ति; यूयं येन परिमाणेन परिमाथ तेनैव परिमाणेन युष्मत्कृते परिमास्यते।</para>
  <para style="p">
    <verse number="39" style="v"/>अथ स तेभ्यो दृष्टान्तकथामकथयत्, अन्धो जनः किमन्धं पन्थानं दर्शयितुं शक्नोति? तस्माद् उभावपि किं गर्त्ते न पतिष्यतः?</para>
  <para style="p">
    <verse number="40" style="v"/>गुरोः शिष्यो न श्रेष्ठः किन्तु शिष्ये सिद्धे सति स गुरुतुल्यो भवितुं शक्नोति।</para>
  <para style="p">
    <verse number="41" style="v"/>अपरञ्च त्वं स्वचक्षुुषि नासाम् अदृष्ट्वा तव भ्रातुश्चक्षुषि यत्तृणमस्ति तदेव कुतः पश्यमि?</para>
  <para style="p">
    <verse number="42" style="v"/>स्वचक्षुषि या नासा विद्यते ताम् अज्ञात्वा, भ्रातस्तव नेत्रात् तृणं बहिः करोमीति वाक्यं भ्रातरं कथं वक्तुं शक्नोषि? हे कपटिन् पूर्व्वं स्वनयनात् नासां बहिः कुरु ततो भ्रातुश्चक्षुषस्तृणं बहिः कर्त्तुं सुदृष्टिं प्राप्स्यसि।</para>
  <para style="p">
    <verse number="43" style="v"/>अन्यञ्च उत्तमस्तरुः कदापि फलमनुत्तमं न फलति, अनुत्तमतरुश्च फलमुत्तमं न फलति कारणादतः फलैस्तरवो ज्ञायन्ते।</para>
  <para style="p">
    <verse number="44" style="v"/>कण्टकिपादपात् कोपि उडुम्बरफलानि न पातयति तथा शृगालकोलिवृक्षादपि कोपि द्राक्षाफलं न पातयति।</para>
  <para style="p">
    <verse number="45" style="v"/>तद्वत् साधुलोकोऽन्तःकरणरूपात् सुभाण्डागाराद् उत्तमानि द्रव्याणि बहिः करोति, दुष्टो लोकश्चान्तःकरणरूपात् कुभाण्डागारात् कुत्सितानि द्रव्याणि निर्गमयति यतोऽन्तःकरणानां पूर्णभावानुरूपाणि वचांसि मुखान्निर्गच्छन्ति।</para>
  <para style="p">
    <verse number="46" style="v"/>अपरञ्च ममाज्ञानुरूपं नाचरित्वा कुतो मां प्रभो प्रभो इति वदथ?</para>
  <para style="p">
    <verse number="47" style="v"/>यः कश्चिन् मम निकटम् आगत्य मम कथा निशम्य तदनुरूपं कर्म्म करोति स कस्य सदृशो भवति तदहं युष्मान् ज्ञाापयामि।</para>
  <para style="p">
    <verse number="48" style="v"/>यो जनो गभीरं खनित्वा पाषाणस्थले भित्तिं निर्म्माय स्वगृहं रचयति तेन सह तस्योपमा भवति; यत आप्लाविजलमेत्य तस्य मूले वेगेन वहदपि तद्गेहं लाडयितुं न शक्नोति यतस्तस्य भित्तिः पाषाणोपरि तिष्ठति।</para>
  <para style="p">
    <verse number="49" style="v"/>किन्तु यः कश्चिन् मम कथाः श्रुत्वा तदनुरूपं नाचरति स भित्तिं विना मृृदुपरि गृहनिर्म्मात्रा समानो भवति; यत आप्लाविजलमागत्य वेगेन यदा वहति तदा तद्गृहं पतति तस्य महत् पतनं जायते।</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ततः परं स लोकानां कर्णगोचरे तान् सर्व्वान् उपदेशान् समाप्य यदा कफर्नाहूम्पुरं प्रविशति</para>
  <para style="p">
    <verse number="2" style="v"/>तदा शतसेनापतेः प्रियदास एको मृतकल्पः पीडित आसीत्।</para>
  <para style="p">
    <verse number="3" style="v"/>अतः सेनापति र्यीशो र्वार्त्तां निशम्य दासस्यारोग्यकरणाय तस्यागमनार्थं विनयकरणाय यिहूदीयान् कियतः प्राचः प्रेषयामास।</para>
  <para style="p">
    <verse number="4" style="v"/>ते यीशोरन्तिकं गत्वा विनयातिशयं वक्तुमारेभिरे, स सेनापति र्भवतोनुग्रहं प्राप्तुम् अर्हति।</para>
  <para style="p">
    <verse number="5" style="v"/>यतः सोस्मज्जातीयेषु लोकेषु प्रीयते तथास्मत्कृते भजनगेहं निर्म्मितवान्।</para>
  <para style="p">
    <verse number="6" style="v"/>तस्माद् यीशुस्तैः सह गत्वा निवेशनस्य समीपं प्राप, तदा स शतसेनापति र्वक्ष्यमाणवाक्यं तं वक्तुं बन्धून् प्राहिणोत्। हे प्रभो स्वयं श्रमो न कर्त्तव्यो यद् भवता मद्गेहमध्ये पादार्पणं क्रियेत तदप्यहं नार्हामि,</para>
  <para style="p">
    <verse number="7" style="v"/>किञ्चाहं भवत्समीपं यातुमपि नात्मानं योग्यं बुद्धवान्, ततो भवान् वाक्यमात्रं वदतु तेनैव मम दासः स्वस्थो भविष्यति।</para>
  <para style="p">
    <verse number="8" style="v"/>यस्माद् अहं पराधीनोपि ममाधीना याः सेनाः सन्ति तासाम् एकजनं प्रति याहीति मया प्रोक्ते स याति; तदन्यं प्रति आयाहीति प्रोक्ते स आयाति; तथा निजदासं प्रति एतत् कुर्व्विति प्रोक्ते स तदेव करोति।</para>
  <para style="p">
    <verse number="9" style="v"/>यीशुरिदं वाक्यं श्रुत्वा विस्मयं ययौ, मुखं परावर्त्य पश्चाद्वर्त्तिनो लोकान् बभाषे च, युष्मानहं वदामि इस्रायेलो वंशमध्येपि विश्वासमीदृशं न प्राप्नवं।</para>
  <para style="p">
    <verse number="10" style="v"/>ततस्ते प्रेषिता गृहं गत्वा तं पीडितं दासं स्वस्थं ददृशुः।</para>
  <para style="p">
    <verse number="11" style="v"/>परेऽहनि स नायीनाख्यं नगरं जगाम तस्यानेके शिष्या अन्ये च लोकास्तेन सार्द्धं ययुः।</para>
  <para style="p">
    <verse number="12" style="v"/>तेषु तन्नगरस्य द्वारसन्निधिं प्राप्तेषु कियन्तो लोका एकं मृतमनुजं वहन्तो नगरस्य बहिर्यान्ति, स तन्मातुरेकपुत्रस्तन्माता च विधवा; तया सार्द्धं तन्नगरीया बहवो लोका आसन्।</para>
  <para style="p">
    <verse number="13" style="v"/>प्रभुस्तां विलोक्य सानुकम्पः कथयामास, मा रोदीः। स समीपमित्वा खट्वां पस्पर्श तस्माद् वाहकाः स्थगितास्तम्युः;</para>
  <para style="p">
    <verse number="14" style="v"/>तदा स उवाच हे युवमनुष्य त्वमुत्तिष्ठ, त्वामहम् आज्ञापयामि।</para>
  <para style="p">
    <verse number="15" style="v"/>तस्मात् स मृतो जनस्तत्क्षणमुत्थाय कथां प्रकथितः; ततो यीशुस्तस्य मातरि तं समर्पयामास।</para>
  <para style="p">
    <verse number="16" style="v"/>तस्मात् सर्व्वे लोकाः शशङ्किरे; एको महाभविष्यद्वादी मध्येऽस्माकम् समुदैत्, ईश्वरश्च स्वलोकानन्वगृह्लात् कथामिमां कथयित्वा ईश्वरं धन्यं जगदुः।</para>
  <para style="p">
    <verse number="17" style="v"/>ततः परं समस्तं यिहूदादेशं तस्य चतुर्दिक्स्थदेशञ्च तस्यैतत्कीर्त्ति र्व्यानशे।</para>
  <para style="p">
    <verse number="18" style="v"/>ततः परं योहनः शिष्येषु तं तद्वृत्तान्तं ज्ञापितवत्सु</para>
  <para style="p">
    <verse number="19" style="v"/>स स्वशिष्याणां द्वौ जनावाहूय यीशुं प्रति वक्ष्यमाणं वाक्यं वक्तुं प्रेषयामास, यस्यागमनम् अपेक्ष्य तिष्ठामो वयं किं स एव जनस्त्वं? किं वयमन्यमपेक्ष्य स्थास्यामः?</para>
  <para style="p">
    <verse number="20" style="v"/>पश्चात्तौ मानवौ गत्वा कथयामासतुः, यस्यागमनम् अपेक्ष्य तिष्ठामो वयं, किं सएव जनस्त्वं? किं वयमन्यमपेक्ष्य स्थास्यामः? कथामिमां तुभ्यं कथयितुं योहन् मज्जक आवां प्रेषितवान्।</para>
  <para style="p">
    <verse number="21" style="v"/>तस्मिन् दण्डे यीशूरोगिणो महाव्याधिमतो दुष्टभूतग्रस्तांश्च बहून् स्वस्थान् कृत्वा, अनेकान्धेभ्यश्चक्षुंषि दत्त्वा प्रत्युवाच,</para>
  <para style="p">
    <verse number="22" style="v"/>युवां व्रजतम् अन्धा नेत्राणि खञ्जाश्चरणानि च प्राप्नुवन्ति, कुष्ठिनः परिष्क्रियन्ते, बधिराः श्रवणानि मृताश्च जीवनानि प्राप्नुवन्ति, दरिद्राणां समीपेषु सुसंवादः प्रचार्य्यते, यं प्रति विघ्नस्वरूपोहं न भवामि स धन्यः,</para>
  <para style="p">
    <verse number="23" style="v"/>एतानि यानि पश्यथः शृणुथश्च तानि योहनं ज्ञापयतम्।</para>
  <para style="p">
    <verse number="24" style="v"/>तयो र्दूतयो र्गतयोः सतो र्योहनि स लोकान् वक्तुमुपचक्रमे, यूयं मध्येप्रान्तरं किं द्रष्टुं निरगमत? किं वायुना कम्पितं नडं?</para>
  <para style="p">
    <verse number="25" style="v"/>यूयं किं द्रष्टुं निरगमत? किं सूक्ष्मवस्त्रपरिधायिनं कमपि नरं? किन्तु ये सूक्ष्ममृदुवस्त्राणि परिदधति सूत्तमानि द्रव्याणि भुञ्जते च ते राजधानीषु तिष्ठन्ति।</para>
  <para style="p">
    <verse number="26" style="v"/>तर्हि यूयं किं द्रष्टुं निरगमत? किमेकं भविष्यद्वादिनं? तदेव सत्यं किन्तु स पुमान् भविष्यद्वादिनोपि श्रेष्ठ इत्यहं युष्मान् वदामि;</para>
  <para style="p">
    <verse number="27" style="v"/>पश्य स्वकीयदूतन्तु तवाग्र प्रेषयाम्यहं। गत्वा त्वदीयमार्गन्तु स हि परिष्करिष्यति। यदर्थे लिपिरियम् आस्ते स एव योहन्।</para>
  <para style="p">
    <verse number="28" style="v"/>अतो युष्मानहं वदामि स्त्रिया गर्ब्भजातानां भविष्यद्वादिनां मध्ये योहनो मज्जकात् श्रेष्ठः कोपि नास्ति, तत्रापि ईश्वरस्य राज्ये यः सर्व्वस्मात् क्षुद्रः स योहनोपि श्रेष्ठः।</para>
  <para style="p">
    <verse number="29" style="v"/>अपरञ्च सर्व्वे लोकाः करमञ्चायिनश्च तस्य वाक्यानि श्रुत्वा योहना मज्जनेन मज्जिताः परमेश्वरं निर्दोषं मेनिरे।</para>
  <para style="p">
    <verse number="30" style="v"/>किन्तु फिरूशिनो व्यवस्थापकाश्च तेन न मज्जिताः स्वान् प्रतीश्वरस्योपदेशं निष्फलम् अकुर्व्वन्।</para>
  <para style="p">
    <verse number="31" style="v"/>अथ प्रभुः कथयामास, इदानीन्तनजनान् केनोपमामि? ते कस्य सदृशाः?</para>
  <para style="p">
    <verse number="32" style="v"/>ये बालका विपण्याम् उपविश्य परस्परम् आहूय वाक्यमिदं वदन्ति, वयं युष्माकं निकटे वंशीरवादिष्म, किन्तु यूयं नानर्त्तिष्ट, वयं युष्माकं निकट अरोदिष्म, किन्तु युयं न व्यलपिष्ट, बालकैरेतादृशैस्तेषाम् उपमा भवति।</para>
  <para style="p">
    <verse number="33" style="v"/>यतो योहन् मज्जक आगत्य पूपं नाखादत् द्राक्षारसञ्च नापिवत् तस्माद् यूयं वदथ, भूतग्रस्तोयम्।</para>
  <para style="p">
    <verse number="34" style="v"/>ततः परं मानवसुत आगत्याखाददपिवञ्च तस्माद् यूयं वदथ, खादकः सुरापश्चाण्डालपापिनां बन्धुरेको जनो दृश्यताम्।</para>
  <para style="p">
    <verse number="35" style="v"/>किन्तु ज्ञानिनो ज्ञानं निर्दोषं विदुः।</para>
  <para style="p">
    <verse number="36" style="v"/>पश्चादेकः फिरूशी यीशुं भोजनाय न्यमन्त्रयत् ततः स तस्य गृहं गत्वा भोक्तुमुपविष्टः।</para>
  <para style="p">
    <verse number="37" style="v"/>एतर्हि तत्फिरूशिनो गृहे यीशु र्भेक्तुम् उपावेक्षीत् तच्छ्रुत्वा तन्नगरवासिनी कापि दुष्टा नारी पाण्डरप्रस्तरस्य सम्पुटके सुगन्धितैलम् आनीय</para>
  <para style="p">
    <verse number="38" style="v"/>तस्य पश्चात् पादयोः सन्निधौ तस्यौ रुदती च नेत्राम्बुभिस्तस्य चरणौ प्रक्षाल्य निजकचैरमार्क्षीत्, ततस्तस्य चरणौ चुम्बित्वा तेन सुगन्धितैलेन ममर्द।</para>
  <para style="p">
    <verse number="39" style="v"/>तस्मात् स निमन्त्रयिता फिरूशी मनसा चिन्तयामास, यद्ययं भविष्यद्वादी भवेत् तर्हि एनं स्पृशति या स्त्री सा का कीदृशी चेति ज्ञातुं शक्नुयात् यतः सा दुष्टा।</para>
  <para style="p">
    <verse number="40" style="v"/>तदा याशुस्तं जगाद, हे शिमोन् त्वां प्रति मम किञ्चिद् वक्तव्यमस्ति; तस्मात् स बभाषे, हे गुरो तद् वदतु।</para>
  <para style="p">
    <verse number="41" style="v"/>एकोत्तमर्णस्य द्वावधमर्णावास्तां, तयोरेकः पञ्चशतानि मुद्रापादान् अपरश्च पञ्चाशत् मुद्रापादान् धारयामास।</para>
  <para style="p">
    <verse number="42" style="v"/>तदनन्तरं तयोः शोध्याभावात् स उत्तमर्णस्तयो र्ऋणे चक्षमे; तस्मात् तयोर्द्वयोः कस्तस्मिन् प्रेष्यते बहु? तद् ब्रूहि।</para>
  <para style="p">
    <verse number="43" style="v"/>शिमोन् प्रत्युवाच, मया बुध्यते यस्याधिकम् ऋणं चक्षमे स इति; ततो यीशुस्तं व्याजहार, त्वं यथार्थं व्यचारयः।</para>
  <para style="p">
    <verse number="44" style="v"/>अथ तां नारीं प्रति व्याघुठ्य शिमोनमवोचत्, स्त्रीमिमां पश्यसि? तव गृहे मय्यागते त्वं पादप्रक्षालनार्थं जलं नादाः किन्तु योषिदेषा नयनजलै र्मम पादौ प्रक्षाल्य केशैरमार्क्षीत्।</para>
  <para style="p">
    <verse number="45" style="v"/>त्वं मां नाचुम्बीः किन्तु योषिदेषा स्वीयागमनादारभ्य मदीयपादौ चुम्बितुं न व्यरंस्त।</para>
  <para style="p">
    <verse number="46" style="v"/>त्वञ्च मदीयोत्तमाङ्गे किञ्चिदपि तैलं नामर्दीः किन्तु योषिदेषा मम चरणौ सुगन्धितैलेनामर्द्दीत्।</para>
  <para style="p">
    <verse number="47" style="v"/>अतस्त्वां व्याहरामि, एतस्या बहु पापमक्षम्यत ततो बहु प्रीयते किन्तु यस्याल्पपापं क्षम्यते सोल्पं प्रीयते।</para>
  <para style="p">
    <verse number="48" style="v"/>ततः परं स तां बभाषे, त्वदीयं पापमक्षम्यत।</para>
  <para style="p">
    <verse number="49" style="v"/>तदा तेन सार्द्धं ये भोक्तुम् उपविविशुस्ते परस्परं वक्तुमारेभिरे, अयं पापं क्षमते क एषः?</para>
  <para style="p">
    <verse number="50" style="v"/>किन्तु स तां नारीं जगाद, तव विश्वासस्त्वां पर्य्यत्रास्त त्वं क्षेमेण व्रज।</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अपरञ्च यीशु र्द्वादशभिः शिष्यैः सार्द्धं नानानगरेषु नानाग्रामेषु च गच्छन् इश्वरीयराजत्वस्य सुसंवादं प्रचारयितुं प्रारेभे।</para>
  <para style="p">
    <verse number="2" style="v"/>तदा यस्याः सप्त भूता निरगच्छन् सा मग्दलीनीति विख्याता मरियम् हेरोद्राजस्य गृहाधिपतेः होषे र्भार्य्या योहना शूशाना</para>
  <para style="p">
    <verse number="3" style="v"/>प्रभृतयो या बह्व्यः स्त्रियः दुष्टभूतेभ्यो रोगेभ्यश्च मुक्ताः सत्यो निजविभूती र्व्ययित्वा तमसेवन्त, ताः सर्व्वास्तेन सार्द्धम् आसन्।</para>
  <para style="p">
    <verse number="4" style="v"/>अनन्तरं नानानगरेभ्यो बहवो लोका आगत्य तस्य समीपेऽमिलन्, तदा स तेभ्य एकां दृष्टान्तकथां कथयामास। एकः कृषीबलो बीजानि वप्तुं बहिर्जगाम,</para>
  <para style="p">
    <verse number="5" style="v"/>ततो वपनकाले कतिपयानि बीजानि मार्गपार्श्वे पेतुः, ततस्तानि पदतलै र्दलितानि पक्षिभि र्भक्षितानि च।</para>
  <para style="p">
    <verse number="6" style="v"/>कतिपयानि बीजानि पाषाणस्थले पतितानि यद्यपि तान्यङ्कुरितानि तथापि रसाभावात् शुशुषुः।</para>
  <para style="p">
    <verse number="7" style="v"/>कतिपयानि बीजानि कण्टकिवनमध्ये पतितानि ततः कण्टकिवनानि संवृद्ध्य तानि जग्रसुः।</para>
  <para style="p">
    <verse number="8" style="v"/>तदन्यानि कतिपयबीजानि च भूम्यामुत्तमायां पेतुस्ततस्तान्यङ्कुरयित्वा शतगुणानि फलानि फेलुः। स इमा कथां कथयित्वा प्रोच्चैः प्रोवाच, यस्य श्रोतुं श्रोत्रे स्तः स शृणोतु।</para>
  <para style="p">
    <verse number="9" style="v"/>ततः परं शिष्यास्तं पप्रच्छुरस्य दृष्टान्तस्य किं तात्पर्य्यं?</para>
  <para style="p">
    <verse number="10" style="v"/>ततः स व्याजहार, ईश्वरीयराज्यस्य गुह्यानि ज्ञातुं युष्मभ्यमधिकारो दीयते किन्त्वन्ये यथा दृष्ट्वापि न पश्यन्ति श्रुत्वापि म बुध्यन्ते च तदर्थं तेषां पुरस्तात् ताः सर्व्वाः कथा दृष्टान्तेन कथ्यन्ते।</para>
  <para style="p">
    <verse number="11" style="v"/>दृष्टान्तस्यास्याभिप्रायः, ईश्वरीयकथा बीजस्वरूपा।</para>
  <para style="p">
    <verse number="12" style="v"/>ये कथामात्रं शृण्वन्ति किन्तु पश्चाद् विश्वस्य यथा परित्राणं न प्राप्नुवन्ति तदाशयेन शैतानेत्य हृदयातृ तां कथाम् अपहरति त एव मार्गपार्श्वस्थभूमिस्वरूपाः।</para>
  <para style="p">
    <verse number="13" style="v"/>ये कथं श्रुत्वा सानन्दं गृह्लन्ति किन्त्वबद्धमूलत्वात् स्वल्पकालमात्रं प्रतीत्य परीक्षाकाले भ्रश्यन्ति तएव पाषाणभूमिस्वरूपाः।</para>
  <para style="p">
    <verse number="14" style="v"/>ये कथां श्रुत्वा यान्ति विषयचिन्तायां धनलोभेन एेहिकसुखे च मज्जन्त उपयुक्तफलानि न फलन्ति त एवोप्तबीजकण्टकिभूस्वरूपाः।</para>
  <para style="p">
    <verse number="15" style="v"/>किन्तु ये श्रुत्वा सरलैः शुद्धैश्चान्तःकरणैः कथां गृह्लन्ति धैर्य्यम् अवलम्ब्य फलान्युत्पादयन्ति च त एवोत्तममृत्स्वरूपाः।</para>
  <para style="p">
    <verse number="16" style="v"/>अपरञ्च प्रदीपं प्रज्वाल्य कोपि पात्रेण नाच्छादयति तथा खट्वाधोपि न स्थापयति, किन्तु दीपाधारोपर्य्येव स्थापयति, तस्मात् प्रवेशका दीप्तिं पश्यन्ति।</para>
  <para style="p">
    <verse number="17" style="v"/>यन्न प्रकाशयिष्यते तादृग् अप्रकाशितं वस्तु किमपि नास्ति यच्च न सुव्यक्तं प्रचारयिष्यते तादृग् गृप्तं वस्तु किमपि नास्ति।</para>
  <para style="p">
    <verse number="18" style="v"/>अतो यूयं केन प्रकारेण शृणुथ तत्र सावधाना भवत, यस्य समीपे बर्द्धते तस्मै पुनर्दास्यते किन्तु यस्याश्रये न बर्द्धते तस्य यद्यदस्ति तदपि तस्मात् नेष्यते।</para>
  <para style="p">
    <verse number="19" style="v"/>अपरञ्च यीशो र्माता भ्रातरश्च तस्य समीपं जिगमिषवः</para>
  <para style="p">
    <verse number="20" style="v"/>किन्तु जनतासम्बाधात् तत्सन्निधिं प्राप्तुं न शेकुः। तत्पश्चात् तव माता भ्रातरश्च त्वां साक्षात् चिकीर्षन्तो बहिस्तिष्ठनतीति वार्त्तायां तस्मै कथितायां</para>
  <para style="p">
    <verse number="21" style="v"/>स प्रत्युवाच; ये जना ईश्वरस्य कथां श्रुत्वा तदनुरूपमाचरन्ति तएव मम माता भ्रातरश्च।</para>
  <para style="p">
    <verse number="22" style="v"/>अनन्तरं एकदा यीशुः शिष्यैः सार्द्धं नावमारुह्य जगाद, आयात वयं ह्रदस्य पारं यामः, ततस्ते जग्मुः।</para>
  <para style="p">
    <verse number="23" style="v"/>तेषु नौकां वाहयत्सु स निदद्रौ;</para>
  <para style="p">
    <verse number="24" style="v"/>अथाकस्मात् प्रबलझञ्भ्शगमाद् ह्रदे नौकायां तरङ्गैराच्छन्नायां विपत् तान् जग्रास।तस्माद् यीशोरन्तिकं गत्वा हे गुरो हे गुरो प्राणा नो यान्तीति गदित्वा तं जागरयाम्बभूवुः।तदा स उत्थाय वायुं तरङ्गांश्च तर्जयामास तस्मादुभौ निवृत्य स्थिरौ बभूवतुः।</para>
  <para style="p">
    <verse number="25" style="v"/>स तान् बभाषे युष्माकं विश्वासः क? तस्मात्ते भीता विस्मिताश्च परस्परं जगदुः, अहो कीदृगयं मनुजः पवनं पानीयञ्चादिशति तदुभयं तदादेशं वहति।</para>
  <para style="p">
    <verse number="26" style="v"/>ततः परं गालील्प्रदेशस्य सम्मुखस्थगिदेरीयप्रदेशे नौकायां लगन्त्यां तटेऽवरोहमावाद्</para>
  <para style="p">
    <verse number="27" style="v"/>बहुतिथकालं भूतग्रस्त एको मानुषः पुरादागत्य तं साक्षाच्चकार। स मनुषो वासो न परिदधत् गृहे च न वसन् केवलं श्मशानम् अध्युवास।</para>
  <para style="p">
    <verse number="28" style="v"/>स यीशुं दृष्ट्वैव चीच्छब्दं चकार तस्य सम्मुखे पतित्वा प्रोच्चैर्जगाद च, हे सर्व्वप्रधानेश्वरस्य पुत्र, मया सह तव कः सम्बन्धः? त्वयि विनयं करोमि मां मा यातय।</para>
  <para style="p">
    <verse number="29" style="v"/>यतः स तं मानुषं त्यक्त्वा यातुम् अमेध्यभूतम् आदिदेश; स भूतस्तं मानुषम् असकृद् दधार तस्माल्लोकाः शृङ्खलेन निगडेन च बबन्धुः; स तद् भंक्त्वा भूतवशत्वात् मध्येप्रान्तरं ययौ।</para>
  <para style="p">
    <verse number="30" style="v"/>अनन्तरं यीशुस्तं पप्रच्छ तव किन्नाम? स उवाच, मम नाम बाहिनो यतो बहवो भूतास्तमाशिश्रियुः।</para>
  <para style="p">
    <verse number="31" style="v"/>अथ भूता विनयेन जगदुः, गभीरं गर्त्तं गन्तुं माज्ञापयास्मान्।</para>
  <para style="p">
    <verse number="32" style="v"/>तदा पर्व्वतोपरि वराहव्रजश्चरति तस्माद् भूता विनयेन प्रोचुः, अमुं वराहव्रजम् आश्रयितुम् अस्मान् अनुजानीहि; ततः सोनुजज्ञौ।</para>
  <para style="p">
    <verse number="33" style="v"/>ततः परं भूतास्तं मानुषं विहाय वराहव्रजम् आशिश्रियुः वराहव्रजाश्च तत्क्षणात् कटकेन धावन्तो ह्रदे प्राणान् विजृहुः।</para>
  <para style="p">
    <verse number="34" style="v"/>तद् दृष्ट्वा शूकररक्षकाः पलायमाना नगरं ग्रामञ्च गत्वा तत्सर्व्ववृत्तान्तं कथयामासुः।</para>
  <para style="p">
    <verse number="35" style="v"/>ततः किं वृत्तम् एतद्दर्शनार्थं लोका निर्गत्य यीशोः समीपं ययुः, तं मानुषं त्यक्तभूतं परिहितवस्त्रं स्वस्थमानुषवद् यीशोश्चरणसन्निधौ सूपविशन्तं विलोक्य बिभ्युः।</para>
  <para style="p">
    <verse number="36" style="v"/>ये लोकास्तस्य भूतग्रस्तस्य स्वास्थ्यकरणं ददृशुस्ते तेभ्यः सर्व्ववृत्तान्तं कथयामासुः।</para>
  <para style="p">
    <verse number="37" style="v"/>तदनन्तरं तस्य गिदेरीयप्रदेशस्य चतुर्दिक्स्था बहवो जना अतित्रस्ता विनयेन तं जगदुः, भवान् अस्माकं निकटाद् व्रजतु तस्मात् स नावमारुह्य ततो व्याघुट्य जगाम।</para>
  <para style="p">
    <verse number="38" style="v"/>तदानीं त्यक्तभूतमनुजस्तेन सह स्थातुं प्रार्थयाञ्चक्रे</para>
  <para style="p">
    <verse number="39" style="v"/>किन्तु तदर्थम् ईश्वरः कीदृङ्महाकर्म्म कृतवान् इति निवेशनं गत्वा विज्ञापय, यीशुः कथामेतां कथयित्वा तं विससर्ज। ततः स व्रजित्वा यीशुस्तदर्थं यन्महाकर्म्म चकार तत् पुरस्य सर्व्वत्र प्रकाशयितुं प्रारेभे।</para>
  <para style="p">
    <verse number="40" style="v"/>अथ यीशौ परावृत्यागते लोकास्तं आदरेण जगृहु र्यस्मात्ते सर्व्वे तमपेक्षाञ्चक्रिरे।</para>
  <para style="p">
    <verse number="41" style="v"/>तदनन्तरं यायीर्नाम्नो भजनगेहस्यैकोधिप आगत्य यीशोश्चरणयोः पतित्वा स्वनिवेशनागमनार्थं तस्मिन् विनयं चकार,</para>
  <para style="p">
    <verse number="42" style="v"/>यतस्तस्य द्वादशवर्षवयस्का कन्यैकासीत् सा मृतकल्पाभवत्। ततस्तस्य गमनकाले मार्गे लोकानां महान् समागमो बभूव।</para>
  <para style="p">
    <verse number="43" style="v"/>द्वादशवर्षाणि प्रदररोगग्रस्ता नाना वैद्यैश्चिकित्सिता सर्व्वस्वं व्ययित्वापि स्वास्थ्यं न प्राप्ता या योषित् सा यीशोः पश्चादागत्य तस्य वस्त्रग्रन्थिं पस्पर्श।</para>
  <para style="p">
    <verse number="44" style="v"/>तस्मात् तत्क्षणात् तस्या रक्तस्रावो रुद्धः।</para>
  <para style="p">
    <verse number="45" style="v"/>तदानीं यीशुरवदत् केनाहं स्पृष्टः? ततोऽनेकैरनङ्गीकृते पितरस्तस्य सङ्गिनश्चावदन्, हे गुरो लोका निकटस्थाः सन्तस्तव देहे घर्षयन्ति, तथापि केनाहं स्पृष्टइति भवान् कुतः पृच्छति?</para>
  <para style="p">
    <verse number="46" style="v"/>यीशुः कथयामास, केनाप्यहं स्पृष्टो, यतो मत्तः शक्ति र्निर्गतेति मया निश्चितमज्ञायि।</para>
  <para style="p">
    <verse number="47" style="v"/>तदा सा नारी स्वयं न गुप्तेति विदित्वा कम्पमाना सती तस्य सम्मुखे पपात; येन निमित्तेन तं पस्पर्श स्पर्शमात्राच्च येन प्रकारेण स्वस्थाभवत् तत् सर्व्वं तस्य साक्षादाचख्यौ।</para>
  <para style="p">
    <verse number="48" style="v"/>ततः स तां जगाद हे कन्ये सुस्थिरा भव, तव विश्वासस्त्वां स्वस्थाम् अकार्षीत् त्वं क्षेमेण याहि।</para>
  <para style="p">
    <verse number="49" style="v"/>यीशोरेतद्वाक्यवदनकाले तस्याधिपते र्निवेशनात् कश्चिल्लोक आगत्य तं बभाषे, तव कन्या मृता गुरुं मा क्लिशान।</para>
  <para style="p">
    <verse number="50" style="v"/>किन्तु यीशुस्तदाकर्ण्याधिपतिं व्याजहार, मा भैषीः केवलं विश्वसिहि तस्मात् सा जीविष्यति।</para>
  <para style="p">
    <verse number="51" style="v"/>अथ तस्य निवेशने प्राप्ते स पितरं योहनं याकूबञ्च कन्याया मातरं पितरञ्च विना, अन्यं कञ्चन प्रवेष्टुं वारयामास।</para>
  <para style="p">
    <verse number="52" style="v"/>अपरञ्च ये रुदन्ति विलपन्ति च तान् सर्व्वान् जनान् उवाच, यूयं मा रोदिष्ट कन्या न मृता निद्राति।</para>
  <para style="p">
    <verse number="53" style="v"/>किन्तु सा निश्चितं मृतेति ज्ञात्वा ते तमुपजहसुः।</para>
  <para style="p">
    <verse number="54" style="v"/>पश्चात् स सर्व्वान् बहिः कृत्वा कन्यायाः करौ धृत्वाजुहुवे, हे कन्ये त्वमुत्तिष्ठ,</para>
  <para style="p">
    <verse number="55" style="v"/>तस्मात् तस्याः प्राणेषु पुनरागतेषु सा तत्क्षणाद् उत्तस्यौ। तदानीं तस्यै किञ्चिद् भक्ष्यं दातुम् आदिदेश।</para>
  <para style="p">
    <verse number="56" style="v"/>ततस्तस्याः पितरौ विस्मयं गतौ किन्तु स तावादिदेश घटनाया एतस्याः कथां कस्मैचिदपि मा कथयतं।</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ततः परं स द्वादशशिष्यानाहूय भूतान् त्याजयितुं रोगान् प्रतिकर्त्तुञ्च तेभ्यः शक्तिमाधिपत्यञ्च ददौ।</para>
  <para style="p">
    <verse number="2" style="v"/>अपरञ्च ईश्वरीयराज्यस्य सुसंवादं प्रकाशयितुम् रोगिणामारोग्यं कर्त्तुञ्च प्रेरणकाले तान् जगाद।</para>
  <para style="p">
    <verse number="3" style="v"/>यात्रार्थं यष्टि र्वस्त्रपुटकं भक्ष्यं मुद्रा द्वितीयवस्त्रम्, एषां किमपि मा गृह्लीत।</para>
  <para style="p">
    <verse number="4" style="v"/>यूयञ्च यन्निवेशनं प्रविशथ नगरत्यागपर्य्यनतं तन्निवेशने तिष्ठत।</para>
  <para style="p">
    <verse number="5" style="v"/>तत्र यदि कस्यचित् पुरस्य लोका युष्माकमातिथ्यं न कुर्व्वन्ति तर्हि तस्मान्नगराद् गमनकाले तेषां विरुद्धं साक्ष्यार्थं युष्माकं पदधूलीः सम्पातयत।</para>
  <para style="p">
    <verse number="6" style="v"/>अथ ते प्रस्थाय सर्व्वत्र सुसंवादं प्रचारयितुं पीडितान् स्वस्थान् कर्त्तुञ्च ग्रामेषु भ्रमितुं प्रारेभिरे।</para>
  <para style="p">
    <verse number="7" style="v"/>एतर्हि हेरोद् राजा यीशोः सर्व्वकर्म्मणां वार्त्तां श्रुत्वा भृशमुद्विविजे</para>
  <para style="p">
    <verse number="8" style="v"/>यतः केचिदूचुर्योहन् श्मशानादुदतिष्ठत्। केचिदूचुः, एलियो दर्शनं दत्तवान्; एवमन्यलोका ऊचुः पूर्व्वीयः कश्चिद् भविष्यद्वादी समुत्थितः।</para>
  <para style="p">
    <verse number="9" style="v"/>किन्तु हेरोदुवाच योहनः शिरोऽहमछिनदम् इदानीं यस्येदृक्कर्म्मणां वार्त्तां प्राप्नोमि स कः? अथ स तं द्रष्टुम् ऐच्छत्।</para>
  <para style="p">
    <verse number="10" style="v"/>अनन्तरं प्रेरिताः प्रत्यागत्य यानि यानि कर्म्माणि चक्रुस्तानि यीशवे कथयामासुः ततः स तान् बैत्सैदानामकनगरस्य विजनं स्थानं नीत्वा गुप्तं जगाम।</para>
  <para style="p">
    <verse number="11" style="v"/>पश्चाल् लोकास्तद् विदित्वा तस्य पश्चाद् ययुः; ततः स तान् नयन् ईश्वरीयराज्यस्य प्रसङ्गमुक्तवान्, येषां चिकित्सया प्रयोजनम् आसीत् तान् स्वस्थान् चकार च।</para>
  <para style="p">
    <verse number="12" style="v"/>अपरञ्च दिवावसन्ने सति द्वादशशिष्या यीशोरन्तिकम् एत्य कथयामासुः, वयमत्र प्रान्तरस्थाने तिष्ठामः, ततो नगराणि ग्रामाणि गत्वा वासस्थानानि प्राप्य भक्ष्यद्रव्याणि क्रेतुं जननिवहं भवान् विसृजतु।</para>
  <para style="p">
    <verse number="13" style="v"/>तदा स उवाच, यूयमेव तान् भेजयध्वं; ततस्ते प्रोचुरस्माकं निकटे केवलं पञ्च पूपा द्वौ मत्स्यौ च विद्यन्ते, अतएव स्थानान्तरम् इत्वा निमित्तमेतेषां भक्ष्यद्रव्येषु न क्रीतेषु न भवति।</para>
  <para style="p">
    <verse number="14" style="v"/>तत्र प्रायेण पञ्चसहस्राणि पुरुषा आसन्।</para>
  <para style="p">
    <verse number="15" style="v"/>तदा स शिष्यान् जगाद पञ्चाशत् पञ्चाशज्जनैः पंक्तीकृत्य तानुपवेशयत, तस्मात् ते तदनुसारेण सर्व्वलोकानुपवेशयापासुः।</para>
  <para style="p">
    <verse number="16" style="v"/>ततः स तान् पञ्च पूपान् मीनद्वयञ्च गृहीत्वा स्वर्गं विलोक्येश्वरगुणान् कीर्त्तयाञ्चक्रे भङ्क्ता च लोकेभ्यः परिवेषणार्थं शिष्येषु समर्पयाम्बभूव।</para>
  <para style="p">
    <verse number="17" style="v"/>ततः सर्व्वे भुक्त्वा तृप्तिं गता अवशिष्टानाञ्च द्वादश डल्लकान् संजगृहुः।</para>
  <para style="p">
    <verse number="18" style="v"/>अथैकदा निर्जने शिष्यैः सह प्रार्थनाकाले तान् पप्रच्छ, लोका मां कं वदन्ति?</para>
  <para style="p">
    <verse number="19" style="v"/>ततस्ते प्राचुः, त्वां योहन्मज्जकं वदन्ति; केचित् त्वाम् एलियं वदन्ति, पूर्व्वकालिकः कश्चिद् भविष्यद्वादी श्मशानाद् उदतिष्ठद् इत्यपि केचिद् वदन्ति।</para>
  <para style="p">
    <verse number="20" style="v"/>तदा स उवाच, यूयं मां कं वदथ? ततः पितर उक्तवान् त्वम् ईश्वराभिषिक्तः पुरुषः।</para>
  <para style="p">
    <verse number="21" style="v"/>तदा स तान् दृढमादिदेश, कथामेतां कस्मैचिदपि मा कथयत।</para>
  <para style="p">
    <verse number="22" style="v"/>स पुनरुवाच, मनुष्यपुत्रेण वहुयातना भोक्तव्याः प्राचीनलोकैः प्रधानयाजकैरध्यापकैश्च सोवज्ञाय हन्तव्यः किन्तु तृतीयदिवसे श्मशानात् तेनोत्थातव्यम्।</para>
  <para style="p">
    <verse number="23" style="v"/>अपरं स सर्व्वानुवाच, कश्चिद् यदि मम पश्चाद् गन्तुं वाञ्छति तर्हि स स्वं दाम्यतु, दिने दिने क्रुशं गृहीत्वा च मम पश्चादागच्छतु।</para>
  <para style="p">
    <verse number="24" style="v"/>यतो यः कश्चित् स्वप्राणान् रिरक्षिषति स तान् हारयिष्यति, यः कश्चिन् मदर्थं प्राणान् हारयिष्यति स तान् रक्षिष्यति।</para>
  <para style="p">
    <verse number="25" style="v"/>कश्चिद् यदि सर्व्वं जगत् प्राप्नोति किन्तु स्वप्राणान् हारयति स्वयं विनश्यति च तर्हि तस्य को लाभः?</para>
  <para style="p">
    <verse number="26" style="v"/>पुन र्यः कश्चिन् मां मम वाक्यं वा लज्जास्पदं जानाति मनुष्यपुत्रो यदा स्वस्य पितुश्च पवित्राणां दूतानाञ्च तेजोभिः परिवेष्टित आगमिष्यति तदा सोपि तं लज्जास्पदं ज्ञास्यति।</para>
  <para style="p">
    <verse number="27" style="v"/>किन्तु युष्मानहं यथार्थं वदामि, ईश्वरीयराजत्वं न दृष्टवा मृत्युं नास्वादिष्यन्ते, एतादृशाः कियन्तो लोका अत्र स्थनेऽपि दण्डायमानाः सन्ति।</para>
  <para style="p">
    <verse number="28" style="v"/>एतदाख्यानकथनात् परं प्रायेणाष्टसु दिनेषु गतेषु स पितरं योहनं याकूबञ्च गृहीत्वा प्रार्थयितुं पर्व्वतमेकं समारुरोह।</para>
  <para style="p">
    <verse number="29" style="v"/>अथ तस्य प्रार्थनकाले तस्य मुखाकृतिरन्यरूपा जाता, तदीयं वस्त्रमुज्ज्वलशुक्लं जातं।</para>
  <para style="p">
    <verse number="30" style="v"/>अपरञ्च मूसा एलियश्चोभौ तेजस्विनौ दृष्टौ</para>
  <para style="p">
    <verse number="31" style="v"/>तौ तेन यिरूशालम्पुरे यो मृत्युः साधिष्यते तदीयां कथां तेन सार्द्धं कथयितुम् आरेभाते।</para>
  <para style="p">
    <verse number="32" style="v"/>तदा पितरादयः स्वस्य सङ्गिनो निद्रयाकृष्टा आसन् किन्तु जागरित्वा तस्य तेजस्तेन सार्द्धम् उत्तिष्ठन्तौ जनौ च ददृशुः।</para>
  <para style="p">
    <verse number="33" style="v"/>अथ तयोरुभयो र्गमनकाले पितरो यीशुं बभाषे, हे गुरोऽस्माकं स्थानेऽस्मिन् स्थितिः शुभा, तत एका त्वदर्था, एका मूसार्था, एका एलियार्था, इति तिस्रः कुट्योस्माभि र्निर्म्मीयन्तां, इमां कथां स न विविच्य कथयामास।</para>
  <para style="p">
    <verse number="34" style="v"/>अपरञ्च तद्वाक्यवदनकाले पयोद एक आगत्य तेषामुपरि छायां चकार, ततस्तन्मध्ये तयोः प्रवेशात् ते शशङ्किरे।</para>
  <para style="p">
    <verse number="35" style="v"/>तदा तस्मात् पयोदाद् इयमाकाशीया वाणी निर्जगाम, ममायं प्रियः पुत्र एतस्य कथायां मनो निधत्त।</para>
  <para style="p">
    <verse number="36" style="v"/>इति शब्दे जाते ते यीशुमेकाकिनं ददृशुः किन्तु ते तदानीं तस्य दर्शनस्य वाचमेकामपि नोक्त्वा मनःसु स्थापयामासुः।</para>
  <para style="p">
    <verse number="37" style="v"/>परेऽहनि तेषु तस्माच्छैलाद् अवरूढेषु तं साक्षात् कर्त्तुं बहवो लोका आजग्मुः।</para>
  <para style="p">
    <verse number="38" style="v"/>तेषां मध्याद् एको जन उच्चैरुवाच, हे गुरो अहं विनयं करोमि मम पुत्रं प्रति कृपादृष्टिं करोतु, मम स एवैकः पुत्रः।</para>
  <para style="p">
    <verse number="39" style="v"/>भूतेन धृतः सन् सं प्रसभं चीच्छब्दं करोति तन्मुखात् फेणा निर्गच्छन्ति च, भूत इत्थं विदार्य्य क्लिष्ट्वा प्रायशस्तं न त्यजति।</para>
  <para style="p">
    <verse number="40" style="v"/>तस्मात् तं भूतं त्याजयितुं तव शिष्यसमीपे न्यवेदयं किन्तु ते न शेकुः।</para>
  <para style="p">
    <verse number="41" style="v"/>तदा यीशुरवादीत्, रे आविश्वासिन् विपथगामिन् वंश कतिकालान् युष्माभिः सह स्थास्याम्यहं युष्माकम् आचरणानि च सहिष्ये? तव पुत्रमिहानय।</para>
  <para style="p">
    <verse number="42" style="v"/>ततस्तस्मिन्नागतमात्रे भूतस्तं भूमौ पातयित्वा विददार; तदा यीशुस्तममेध्यं भूतं तर्जयित्वा बालकं स्वस्थं कृत्वा तस्य पितरि समर्पयामास।</para>
  <para style="p">
    <verse number="43" style="v"/>ईश्वरस्य महाशक्तिम् इमां विलोक्य सर्व्वे चमच्चक्रुः; इत्थं यीशोः सर्व्वाभिः क्रियाभिः सर्व्वैर्लोकैराश्चर्य्ये मन्यमाने सति स शिष्यान् बभाषे,</para>
  <para style="p">
    <verse number="44" style="v"/>कथेयं युष्माकं कर्णेषु प्रविशतु, मनुष्यपुत्रो मनुष्याणां करेषु समर्पयिष्यते।</para>
  <para style="p">
    <verse number="45" style="v"/>किन्तु ते तां कथां न बुबुधिरे, स्पष्टत्वाभावात् तस्या अभिप्रायस्तेषां बोधगम्यो न बभूव; तस्या आशयः क इत्यपि ते भयात् प्रष्टुं न शेकुः।</para>
  <para style="p">
    <verse number="46" style="v"/>तदनन्तरं तेषां मध्ये कः श्रेष्ठः कथामेतां गृहीत्वा ते मिथो विवादं चक्रुः।</para>
  <para style="p">
    <verse number="47" style="v"/>ततो यीशुस्तेषां मनोभिप्रायं विदित्वा बालकमेकं गृहीत्वा स्वस्य निकटे स्थापयित्वा तान् जगाद,</para>
  <para style="p">
    <verse number="48" style="v"/>यो जनो मम नाम्नास्य बालास्यातिथ्यं विदधाति स ममातिथ्यं विदधाति, यश्च ममातिथ्यं विदधाति स मम प्रेरकस्यातिथ्यं विदधाति, युष्माकं मध्येयः स्वं सर्व्वस्मात् क्षुद्रं जानीते स एव श्रेष्ठो भविष्यति।</para>
  <para style="p">
    <verse number="49" style="v"/>अपरञ्च योहन् व्याजहार हे प्रभेा तव नाम्ना भूतान् त्याजयन्तं मानुषम् एकं दृष्टवन्तो वयं, किन्त्वस्माकम् अपश्चाद् गामित्वात् तं न्यषेधाम्। तदानीं यीशुरुवाच,</para>
  <para style="p">
    <verse number="50" style="v"/>तं मा निषेधत, यतो यो जनोस्माकं न विपक्षः स एवास्माकं सपक्षो भवति।</para>
  <para style="p">
    <verse number="51" style="v"/>अनन्तरं तस्यारोहणसमय उपस्थिते स स्थिरचेता यिरूशालमं प्रति यात्रां कर्त्तुं निश्चित्याग्रे दूतान् प्रेषयामास।</para>
  <para style="p">
    <verse number="52" style="v"/>तस्मात् ते गत्वा तस्य प्रयोजनीयद्रव्याणि संग्रहीतुं शोमिरोणीयानां ग्रामं प्रविविशुः।</para>
  <para style="p">
    <verse number="53" style="v"/>किन्तु स यिरूशालमं नगरं याति ततो हेतो र्लोकास्तस्यातिथ्यं न चक्रुः।</para>
  <para style="p">
    <verse number="54" style="v"/>अतएव याकूब्योहनौ तस्य शिष्यौ तद् दृष्ट्वा जगदतुः, हे प्रभो एलियो यथा चकार तथा वयमपि किं गगणाद् आगन्तुम् एतान् भस्मीकर्त्तुञ्च वह्निमाज्ञापयामः? भवान् किमिच्छति?</para>
  <para style="p">
    <verse number="55" style="v"/>किन्तु स मुखं परावर्त्य तान् तर्जयित्वा गदितवान् युष्माकं मनोभावः कः, इति यूयं न जानीथ।</para>
  <para style="p">
    <verse number="56" style="v"/>मनुजसुतो मनुजानां प्राणान् नाशयितुं नागच्छत्, किन्तु रक्षितुम् आगच्छत्। पश्चाद् इतरग्रामं ते ययुः।</para>
  <para style="p">
    <verse number="57" style="v"/>तदनन्तरं पथि गमनकाले जन एकस्तं बभाषे, हे प्रभो भवान् यत्र याति भवता सहाहमपि तत्र यास्यामि।</para>
  <para style="p">
    <verse number="58" style="v"/>तदानीं यीशुस्तमुवाच, गोमायूनां गर्त्ता आसते, विहायसीयविहगाानां नीडानि च सन्ति, किन्तु मानवतनयस्य शिरः स्थापयितुं स्थानं नास्ति।</para>
  <para style="p">
    <verse number="59" style="v"/>ततः परं स इतरजनं जगाद, त्वं मम पश्चाद् एहि; ततः स उवाच, हे प्रभो पूर्व्वं पितरं श्मशाने स्थापयितुं मामादिशतु।</para>
  <para style="p">
    <verse number="60" style="v"/>तदा यीशुरुवाच, मृता मृतान् श्मशाने स्थापयन्तु किन्तु त्वं गत्वेश्वरीयराज्यस्य कथां प्रचारय।</para>
  <para style="p">
    <verse number="61" style="v"/>ततोन्यः कथयामास, हे प्रभो मयापि भवतः पश्चाद् गंस्यते, किन्तु पूर्व्वं मम निवेशनस्य परिजनानाम् अनुमतिं ग्रहीतुम् अहमादिश्यै भवता।</para>
  <para style="p">
    <verse number="62" style="v"/>तदानीं यीशुस्तं प्रोक्तवान्, यो जनो लाङ्गले करमर्पयित्वा पश्चात् पश्यति स ईश्वरीयराज्यं नार्हति।</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ततः परं प्रभुरपरान् सप्ततिशिष्यान् नियुज्य स्वयं यानि नगराणि यानि स्थानानि च गमिष्यति तानि नगराणि तानि स्थानानि च प्रति द्वौ द्वौ जनौ प्रहितवान्।</para>
  <para style="p">
    <verse number="2" style="v"/>तेभ्यः कथयामास च शस्यानि बहूनीति सत्यं किन्तु छेदका अल्पे; तस्माद्धेतोः शस्यक्षेत्रे छेदकान् अपरानपि प्रेषयितुं क्षेत्रस्वामिनं प्रार्थयध्वं।</para>
  <para style="p">
    <verse number="3" style="v"/>यूयं यात, पश्यत, वृकाणां मध्ये मेषशावकानिव युष्मान् प्रहिणोमि।</para>
  <para style="p">
    <verse number="4" style="v"/>यूयं क्षुद्रं महद् वा वसनसम्पुटकं पादुकाश्च मा गृह्लीत, मार्गमध्ये कमपि मा नमत च।</para>
  <para style="p">
    <verse number="5" style="v"/>अपरञ्च यूयं यद् यत् निवेशनं प्रविशथ तत्र निवेशनस्यास्य मङ्गलं भूयादिति वाक्यं प्रथमं वदत।</para>
  <para style="p">
    <verse number="6" style="v"/>तस्मात् तस्मिन् निवेशने यदि मङ्गलपात्रं स्थास्यति तर्हि तन्मङ्गलं तस्य भविष्यति, नोचेत् युष्मान् प्रति परावर्त्तिष्यते।</para>
  <para style="p">
    <verse number="7" style="v"/>अपरञ्च ते यत्किञ्चिद् दास्यन्ति तदेव भुक्त्वा पीत्वा तस्मिन्निवेशने स्थास्यथ; यतः कर्म्मकारी जनो भृतिम् अर्हति; गृहाद् गृहं मा यास्यथ।</para>
  <para style="p">
    <verse number="8" style="v"/>अन्यच्च युष्मासु किमपि नगरं प्रविष्टेषु लोका यदि युष्माकम् आतिथ्यं करिष्यन्ति, तर्हि यत् खाद्यम् उपस्थास्यन्ति तदेव खादिष्यथ।</para>
  <para style="p">
    <verse number="9" style="v"/>तन्नगरस्थान् रोगिणः स्वस्थान् करिष्यथ, ईश्वरीयं राज्यं युष्माकम् अन्तिकम् आगमत् कथामेताञ्च प्रचारयिष्यथ।</para>
  <para style="p">
    <verse number="10" style="v"/>किन्तु किमपि पुरं युष्मासु प्रविष्टेषु लोका यदि युष्माकम् आतिथ्यं न करिष्यन्ति, तर्हि तस्य नगरस्य पन्थानं गत्वा कथामेतां वदिष्यथ,</para>
  <para style="p">
    <verse number="11" style="v"/>युष्माकं नगरीया या धूल्योऽस्मासु समलगन् ता अपि युष्माकं प्रातिकूल्येन साक्ष्यार्थं सम्पातयामः; तथापीश्वरराज्यं युष्माकं समीपम् आगतम् इति निश्चितं जानीत।</para>
  <para style="p">
    <verse number="12" style="v"/>अहं युष्मभ्यं यथार्थं कथयामि, विचारदिने तस्य नगरस्य दशातः सिदोमो दशा सह्या भविष्यति।</para>
  <para style="p">
    <verse number="13" style="v"/>हा हा कोरासीन् नगर, हा हा बैत्सैदानगर युवयोर्मध्ये यादृशानि आश्चर्य्याणि कर्म्माण्यक्रियन्त, तानि कर्म्माणि यदि सोरसीदोनो र्नगरयोरकारिष्यन्त, तदा इतो बहुदिनपूर्व्वं तन्निवासिनः शणवस्त्राणि परिधाय गात्रेषु भस्म विलिप्य समुपविश्य समखेत्स्यन्त।</para>
  <para style="p">
    <verse number="14" style="v"/>अतो विचारदिवसे युष्माकं दशातः सोरसीदोन्निवासिनां दशा सह्या भविष्यति।</para>
  <para style="p">
    <verse number="15" style="v"/>हे कफर्नाहूम्, त्वं स्वर्गं यावद् उन्नता किन्तु नरकं यावत् न्यग्भविष्यसि।</para>
  <para style="p">
    <verse number="16" style="v"/>यो जनो युष्माकं वाक्यं गृह्लाति स ममैव वाक्यं गृह्लाति; किञ्च यो जनो युष्माकम् अवज्ञां करोति स ममैवावज्ञां करोति; यो जनो ममावज्ञां करोति च स मत्प्रेरकस्यैवावज्ञां करोति।</para>
  <para style="p">
    <verse number="17" style="v"/>अथ ते सप्ततिशिष्या आनन्देन प्रत्यागत्य कथयामासुः, हे प्रभो भवतो नाम्ना भूता अप्यस्माकं वशीभवन्ति।</para>
  <para style="p">
    <verse number="18" style="v"/>तदानीं स तान् जगाद, विद्युतमिव स्वर्गात् पतन्तं शैतानम् अदर्शम्।</para>
  <para style="p">
    <verse number="19" style="v"/>पश्यत सर्पान् वृश्चिकान् रिपोः सर्व्वपराक्रमांश्च पदतलै र्दलयितुं युष्मभ्यं शक्तिं ददामि तस्माद् युष्माकं कापि हानि र्न भविष्यति।</para>
  <para style="p">
    <verse number="20" style="v"/>भूता युष्माकं वशीभवन्ति, एतन्निमित्तत् मा समुल्लसत, स्वर्गे युष्माकं नामानि लिखितानि सन्तीति निमित्तं समुल्लसत।</para>
  <para style="p">
    <verse number="21" style="v"/>तद्घटिकायां यीशु र्मनसि जाताह्लादः कथयामास हे स्वर्गपृथिव्योरेकाधिपते पितस्त्वं ज्ञानवतां विदुषाञ्च लोकानां पुरस्तात् सर्व्वमेतद् अप्रकाश्य बालकानां पुरस्तात् प्राकाशय एतस्माद्धेतोस्त्वां धन्यं वदामि, हे पितरित्थं भवतु यद् एतदेव तव गोचर उत्तमम्।</para>
  <para style="p">
    <verse number="22" style="v"/>पित्रा सर्व्वाणि मयि समर्पितानि पितरं विना कोपि पुत्रं न जानाति किञ्च पुत्रं विना यस्मै जनाय पुत्रस्तं प्रकाशितवान् तञ्च विना कोपि पितरं न जानाति।</para>
  <para style="p">
    <verse number="23" style="v"/>तपः परं स शिष्यान् प्रति परावृत्य गुप्तं जगाद, यूयमेतानि सर्व्वाणि पश्यथ ततो युष्माकं चक्षूंषि धन्यानि।</para>
  <para style="p">
    <verse number="24" style="v"/>युष्मानहं वदामि, यूयं यानि सर्व्वाणि पश्यथ तानि बहवो भविष्यद्वादिनो भूपतयश्च द्रष्टुमिच्छन्तोपि द्रष्टुं न प्राप्नुवन्, युष्माभि र्या याः कथाश्च श्रूयन्ते ताः श्रोतुमिच्छन्तोपि श्रोतुं नालभन्त।</para>
  <para style="p">
    <verse number="25" style="v"/>अनन्तरम् एको व्यवस्थापक उत्थाय तं परीक्षितुं पप्रच्छ, हे उपदेशक अनन्तायुषः प्राप्तये मया किं करणीयं?</para>
  <para style="p">
    <verse number="26" style="v"/>यीशुः प्रत्युवाच, अत्रार्थे व्यवस्थायां किं लिखितमस्ति? त्वं कीदृक् पठसि?</para>
  <para style="p">
    <verse number="27" style="v"/>ततः सोवदत्, त्वं सर्व्वान्तःकरणैः सर्व्वप्राणैः सर्व्वशक्तिभिः सर्व्वचित्तैश्च प्रभौ परमेश्वरे प्रेम कुरु, समीपवासिनि स्ववत् प्रेम कुरु च।</para>
  <para style="p">
    <verse number="28" style="v"/>तदा स कथयामास, त्वं यथार्थं प्रत्यवोचः, इत्थम् आचर तेनैव जीविष्यसि।</para>
  <para style="p">
    <verse number="29" style="v"/>किन्तु स जनः स्वं निर्द्दोषं ज्ञापयितुं यीशुं पप्रच्छ, मम समीपवासी कः? ततो यीशुः प्रत्युवाच,</para>
  <para style="p">
    <verse number="30" style="v"/>एको जनो यिरूशालम्पुराद् यिरीहोपुरं याति, एतर्हि दस्यूनां करेषु पतिते ते तस्य वस्त्रादिकं हृतवन्तः तमाहत्य मृतप्रायं कृत्वा त्यक्त्वा ययुः।</para>
  <para style="p">
    <verse number="31" style="v"/>अकस्माद् एको याजकस्तेन मार्गेण गच्छन् तं दृष्ट्वा मार्गान्यपार्श्वेन जगाम।</para>
  <para style="p">
    <verse number="32" style="v"/>इत्थम् एको लेवीयस्तत्स्थानं प्राप्य तस्यान्तिकं गत्वा तं विलोक्यान्येन पार्श्वेन जगाम।</para>
  <para style="p">
    <verse number="33" style="v"/>किन्त्वेकः शोमिरोणीयो गच्छन् तत्स्थानं प्राप्य तं दृष्ट्वादयत।</para>
  <para style="p">
    <verse number="34" style="v"/>तस्यान्तिकं गत्वा तस्य क्षतेषु तैलं द्राक्षारसञ्च प्रक्षिप्य क्षतानि बद्ध्वा निजवाहनोपरि तमुपवेश्य प्रवासीयगृहम् आनीय तं सिषेवे।</para>
  <para style="p">
    <verse number="35" style="v"/>परस्मिन् दिवसे निजगमनकाले द्वौ मुद्रापादौ तद्गृहस्वामिने दत्त्वावदत् जनमेनं सेवस्व तत्र योऽधिको व्ययो भविष्यति तमहं पुनरागमनकाले परिशोत्स्यामि।</para>
  <para style="p">
    <verse number="36" style="v"/>एषां त्रयाणां मध्ये तस्य दस्युहस्तपतितस्य जनस्य समीपवासी कः? त्वया किं बुध्यते?</para>
  <para style="p">
    <verse number="37" style="v"/>ततः स व्यवस्थापकः कथयामास यस्तस्मिन् दयां चकार। तदा यीशुः कथयामास त्वमपि गत्वा तथाचर।</para>
  <para style="p">
    <verse number="38" style="v"/>ततः परं ते गच्छन्त एकं ग्रामं प्रविविशुः; तदा मर्थानामा स्त्री स्वगृहे तस्यातिथ्यं चकार।</para>
  <para style="p">
    <verse number="39" style="v"/>तस्मात् मरियम् नामधेया तस्या भगिनी यीशोः पदसमीप उवविश्य तस्योपदेशकथां श्रोतुमारेभे।</para>
  <para style="p">
    <verse number="40" style="v"/>किन्तु मर्था नानापरिचर्य्यायां व्यग्रा बभूव तस्माद्धेतोस्तस्य समीपमागत्य बभाषे; हे प्रभो मम भगिनी केवलं ममोपरि सर्व्वकर्म्मणां भारम् अर्पितवती तत्र भवता किञ्चिदपि न मनो निधीयते किम्? मम साहाय्यं कर्त्तुं भवान् तामादिशतु।</para>
  <para style="p">
    <verse number="41" style="v"/>ततो यीशुः प्रत्युवाच हे मर्थे हे मर्थे, त्वं नानाकार्य्येषु चिन्तितवती व्यग्रा चासि,</para>
  <para style="p">
    <verse number="42" style="v"/>किन्तु प्रयोजनीयम् एकमात्रम् आस्ते। अपरञ्च यमुत्तमं भागं कोपि हर्त्तुं न शक्नोति सएव मरियमा वृतः।</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अनन्तरं स कस्मिंश्चित् स्थाने प्रार्थयत तत्समाप्तौ सत्यां तस्यैकः शिष्यस्तं जगाद हे प्रभो योहन् यथा स्वशिष्यान् प्रार्थयितुम् उपदिष्टवान् तथा भवानप्यस्मान् उपदिशतु।</para>
  <para style="p">
    <verse number="2" style="v"/>तस्मात् स कथयामास, प्रार्थनकाले यूयम् इत्थं कथयध्वं, हे अस्माकं स्वर्गस्थपितस्तव नाम पूज्यं भवतु; तव राजत्वं भवतु; स्वर्गे यथा तथा पृथिव्यामपि तवेच्छया सर्व्वं भवतु।</para>
  <para style="p">
    <verse number="3" style="v"/>प्रत्यहम् अस्माकं प्रयोजनीयं भोज्यं देहि।</para>
  <para style="p">
    <verse number="4" style="v"/>यथा वयं सर्व्वान् अपराधिनः क्षमामहे तथा त्वमपि पापान्यस्माकं क्षमस्व। अस्मान् परीक्षां मानय किन्तु पापात्मनो रक्ष।</para>
  <para style="p">
    <verse number="5" style="v"/>पश्चात् सोपरमपि कथितवान् यदि युष्माकं कस्यचिद् बन्धुस्तिष्ठति निशीथे च तस्य समीपं स गत्वा वदति,</para>
  <para style="p">
    <verse number="6" style="v"/>हे बन्धो पथिक एको बन्धु र्मम निवेशनम् आयातः किन्तु तस्यातिथ्यं कर्त्तुं ममान्तिके किमपि नास्ति, अतएव पूपत्रयं मह्यम् ऋणं देहि;</para>
  <para style="p">
    <verse number="7" style="v"/>तदा स यदि गृहमध्यात् प्रतिवदति मां मा क्लिशान, इदानीं द्वारं रुद्धं शयने मया सह बालकाश्च तिष्ठन्ति तुभ्यं दातुम् उत्थातुं न शक्नोमि,</para>
  <para style="p">
    <verse number="8" style="v"/>तर्हि युष्मानहं वदामि, स यदि मित्रतया तस्मै किमपि दातुं नोत्तिष्ठति तथापि वारं वारं प्रार्थनात उत्थापितः सन् यस्मिन् तस्य प्रयोजनं तदेव दास्यति।</para>
  <para style="p">
    <verse number="9" style="v"/>अतः कारणात् कथयामि, याचध्वं ततो युष्मभ्यं दास्यते, मृगयध्वं तत उद्देशं प्राप्स्यथ, द्वारम् आहत ततो युष्मभ्यं द्वारं मोक्ष्यते।</para>
  <para style="p">
    <verse number="10" style="v"/>यो याचते स प्राप्नोति, यो मृगयते स एवोद्देशं प्राप्नोति, यो द्वारम् आहन्ति तदर्थं द्वारं मोच्यते।</para>
  <para style="p">
    <verse number="11" style="v"/>पुत्रेण पूपे याचिते तस्मै पाषाणं ददाति वा मत्स्ये याचिते तस्मै सर्पं ददाति</para>
  <para style="p">
    <verse number="12" style="v"/>वा अण्डे याचिते तस्मै वृश्चिकं ददाति युष्माकं मध्ये क एतादृशः पितास्ते?</para>
  <para style="p">
    <verse number="13" style="v"/>तस्मादेव यूयमभद्रा अपि यदि स्वस्वबालकेभ्य उत्तमानि द्रव्याणि दातुं जानीथ तर्ह्यस्माकं स्वर्गस्थः पिता निजयाचकेभ्यः किं पवित्रम् आत्मानं न दास्यति?</para>
  <para style="p">
    <verse number="14" style="v"/>अनन्तरं यीशुना कस्माच्चिद् एकस्मिन् मूकभूते त्याजिते सति स भूतत्यक्तो मानुषो वाक्यं वक्तुम् आरेभे; ततो लोकाः सकला आश्चर्य्यं मेनिरे।</para>
  <para style="p">
    <verse number="15" style="v"/>किन्तु तेषां केचिदूचु र्जनोयं बालसिबूबा अर्थाद् भूतराजेन भूतान् त्याजयति।</para>
  <para style="p">
    <verse number="16" style="v"/>तं परीक्षितुं केचिद् आकाशीयम् एकं चिह्नं दर्शयितुं तं प्रार्थयाञ्चक्रिरे।</para>
  <para style="p">
    <verse number="17" style="v"/>तदा स तेषां मनःकल्पनां ज्ञात्वा कथयामास, कस्यचिद् राज्यस्य लोका यदि परस्परं विरुन्धन्ति तर्हि तद् राज्यम् नश्यति; केचिद् गृहस्था यदि परस्परं विरुन्धन्ति तर्हि तेपि नश्यन्ति।</para>
  <para style="p">
    <verse number="18" style="v"/>तथैव शैतानपि स्वलोकान् यदि विरुणद्धि तदा तस्य राज्यं कथं स्थास्यति? बालसिबूबाहं भूतान् त्याजयामि यूयमिति वदथ।</para>
  <para style="p">
    <verse number="19" style="v"/>यद्यहं बालसिबूबा भूतान् त्याजयामि तर्हि युष्माकं सन्तानाः केन त्याजयन्ति? तस्मात् तएव कथाया एतस्या विचारयितारो भविष्यन्ति।</para>
  <para style="p">
    <verse number="20" style="v"/>किन्तु यद्यहम् ईश्वरस्य पराक्रमेण भूतान् त्याजयामि तर्हि युष्माकं निकटम् ईश्वरस्य राज्यमवश्यम् उपतिष्ठति।</para>
  <para style="p">
    <verse number="21" style="v"/>बलवान् पुमान् सुसज्जमानो यतिकालं निजाट्टालिकां रक्षति ततिकालं तस्य द्रव्यं निरुपद्रवं तिष्ठति।</para>
  <para style="p">
    <verse number="22" style="v"/>किन्तु तस्माद् अधिकबलः कश्चिदागत्य यदि तं जयति तर्हि येषु शस्त्रास्त्रेषु तस्य विश्वास आसीत् तानि सर्व्वाणि हृत्वा तस्य द्रव्याणि गृह्लाति।</para>
  <para style="p">
    <verse number="23" style="v"/>अतः कारणाद् यो मम सपक्षो न स विपक्षः, यो मया सह न संगृह्लाति स विकिरति।</para>
  <para style="p">
    <verse number="24" style="v"/>अपरञ्च अमेध्यभूतो मानुषस्यान्तर्निर्गत्य शुष्कस्थाने भ्रान्त्वा विश्रामं मृगयते किन्तु न प्राप्य वदति मम यस्माद् गृहाद् आगतोहं पुनस्तद् गृहं परावृत्य यामि।</para>
  <para style="p">
    <verse number="25" style="v"/>ततो गत्वा तद् गृहं मार्जितं शोभितञ्च दृष्ट्वा</para>
  <para style="p">
    <verse number="26" style="v"/>तत्क्षणम् अपगत्य स्वस्मादपि दुर्म्मतीन् अपरान् सप्तभूतान् सहानयति ते च तद्गृहं पविश्य निवसन्ति। तस्मात् तस्य मनुष्यस्य प्रथमदशातः शेषदशा दुःखतरा भवति।</para>
  <para style="p">
    <verse number="27" style="v"/>अस्याः कथायाः कथनकाले जनतामध्यस्था काचिन्नारी तमुच्चैःस्वरं प्रोवाच, या योषित् त्वां गर्ब्भेऽधारयत् स्तन्यमपाययच्च सैव धन्या।</para>
  <para style="p">
    <verse number="28" style="v"/>किन्तु सोकथयत् ये परमेश्वरस्य कथां श्रुत्वा तदनुरूपम् आचरन्ति तएव धन्याः।</para>
  <para style="p">
    <verse number="29" style="v"/>ततः परं तस्यान्तिके बहुलोकानां समागमे जाते स वक्तुमारेभे, आधुनिका दुष्टलोकाश्चिह्नं द्रष्टुमिच्छन्ति किन्तु यूनस्भविष्यद्वादिनश्चिह्नं विनान्यत् किञ्चिच्चिह्नं तान् न दर्शयिष्यते।</para>
  <para style="p">
    <verse number="30" style="v"/>यूनस् तु यथा नीनिवीयलोकानां समीपे चिह्नरूपोभवत् तथा विद्यमानलोकानाम् एषां समीपे मनुष्यपुत्रोपि चिह्नरूपो भविष्यति।</para>
  <para style="p">
    <verse number="31" style="v"/>विचारसमये इदानीन्तनलोकानां प्रातिकूल्येन दक्षिणदेशीया राज्ञी प्रोत्थाय तान् दोषिणः करिष्यति, यतः सा राज्ञी सुलेमान उपदेशकथां श्रोतुं पृथिव्याः सीमात आगच्छत् किन्तु पश्यत सुलेमानोपि गुरुतर एको जनोऽस्मिन् स्थाने विद्यते।</para>
  <para style="p">
    <verse number="32" style="v"/>अपरञ्च विचारसमये नीनिवीयलोका अपि वर्त्तमानकालिकानां लोकानां वैपरीत्येन प्रोत्थाय तान् दोषिणः करिष्यन्ति, यतो हेतोस्ते यूनसो वाक्यात् चित्तानि परिवर्त्तयामासुः किन्तु पश्यत यूनसोतिगुरुतर एको जनोऽस्मिन् स्थाने विद्यते।</para>
  <para style="p">
    <verse number="33" style="v"/>प्रदीपं प्रज्वाल्य द्रोणस्याधः कुत्रापि गुप्तस्थाने वा कोपि न स्थापयति किन्तु गृहप्रवेशिभ्यो दीप्तिं दातं दीपाधारोपर्य्येव स्थापयति।</para>
  <para style="p">
    <verse number="34" style="v"/>देहस्य प्रदीपश्चक्षुस्तस्मादेव चक्षु र्यदि प्रसन्नं भवति तर्हि तव सर्व्वशरीरं दीप्तिमद् भविष्यति किन्तु चक्षु र्यदि मलीमसं तिष्ठति तर्हि सर्व्वशरीरं सान्धकारं स्थास्यति।</para>
  <para style="p">
    <verse number="35" style="v"/>अस्मात् कारणात् तवान्तःस्थं ज्योति र्यथान्धकारमयं न भवति तदर्थे सावधानो भव।</para>
  <para style="p">
    <verse number="36" style="v"/>यतः शरीरस्य कुत्राप्यंशे सान्धकारे न जाते सर्व्वं यदि दीप्तिमत् तिष्ठति तर्हि तुभ्यं दीप्तिदायिप्रोज्ज्वलन् प्रदीप इव तव सवर्वशरीरं दीप्तिमद् भविष्यति।</para>
  <para style="p">
    <verse number="37" style="v"/>एतत्कथायाः कथनकाले फिरुश्येको भेजनाय तं निमन्त्रयामास, ततः स गत्वा भोक्तुम् उपविवेश।</para>
  <para style="p">
    <verse number="38" style="v"/>किन्तु भोजनात् पूर्व्वं नामाङ्क्षीत् एतद् दृष्ट्वा स फिरुश्याश्चर्य्यं मेने।</para>
  <para style="p">
    <verse number="39" style="v"/>तदा प्रभुस्तं प्रोवाच यूयं फिरूशिलोकाः पानपात्राणां भोजनपात्राणाञ्च बहिः परिष्कुरुथ किन्तु युष्माकमन्त र्दौरात्म्यै र्दुष्क्रियाभिश्च परिपूर्णं तिष्ठति।</para>
  <para style="p">
    <verse number="40" style="v"/>हे सर्व्वे निर्बोधा यो बहिः ससर्ज स एव किमन्त र्न ससर्ज?</para>
  <para style="p">
    <verse number="41" style="v"/>तत एव युष्माभिरन्तःकरणं (ईश्वराय) निवेद्यतां तस्मिन् कृते युष्माकं सर्व्वाणि शुचितां यास्यन्ति।</para>
  <para style="p">
    <verse number="42" style="v"/>किन्तु हन्त फिरूशिगणा यूयं न्यायम् ईश्वरे प्रेम च परित्यज्य पोदिनाया अरुदादीनां सर्व्वेषां शाकानाञ्च दशमांशान् दत्थ किन्तु प्रथमं पालयित्वा शेषस्यालङ्घनं युष्माकम् उचितमासीत्।</para>
  <para style="p">
    <verse number="43" style="v"/>हा हा फिरूशिनो यूयं भजनगेहे प्रोच्चासने आपणेषु च नमस्कारेषु प्रीयध्वे।</para>
  <para style="p">
    <verse number="44" style="v"/>वत कपटिनोऽध्यापकाः फिरूशिनश्च लोकायत् श्मशानम् अनुपलभ्य तदुपरि गच्छन्ति यूयम् तादृगप्रकाशितश्मशानवाद् भवथ।</para>
  <para style="p">
    <verse number="45" style="v"/>तदानीं व्यवस्थापकानाम् एका यीशुमवदत्, हे उपदेशक वाक्येनेदृशेनास्मास्वपि दोषम् आरोपयसि।</para>
  <para style="p">
    <verse number="46" style="v"/>ततः स उवाच, हा हा व्यवस्थापका यूयम् मानुषाणाम् उपरि दुःसह्यान् भारान् न्यस्यथ किन्तु स्वयम् एकाङ्गुुल्यापि तान् भारान् न स्पृशथ।</para>
  <para style="p">
    <verse number="47" style="v"/>हन्त युष्माकं पूर्व्वपुरुषा यान् भविष्यद्वादिनोऽवधिषुस्तेषां श्मशानानि यूयं निर्म्माथ।</para>
  <para style="p">
    <verse number="48" style="v"/>तेनैव यूयं स्वपूर्व्वपुरुषाणां कर्म्माणि संमन्यध्वे तदेव सप्रमाणं कुरुथ च, यतस्ते तानवधिषुः यूयं तेषां श्मशानानि निर्म्माथ।</para>
  <para style="p">
    <verse number="49" style="v"/>अतएव ईश्वरस्य शास्त्रे प्रोक्तमस्ति तेषामन्तिके भविष्यद्वादिनः प्रेरितांश्च प्रेषयिष्यामि ततस्ते तेषां कांश्चन हनिष्यन्ति कांश्चन ताडश्ष्यिन्ति।</para>
  <para style="p">
    <verse number="50" style="v"/>एतस्मात् कारणात् हाबिलः शोणितपातमारभ्य मन्दिरयज्ञवेद्यो र्मध्ये हतस्य सिखरियस्य रक्तपातपर्य्यन्तं</para>
  <para style="p">
    <verse number="51" style="v"/>जगतः सृष्टिमारभ्य पृथिव्यां भविष्यद्वादिनां यतिरक्तपाता जातास्ततीनाम् अपराधदण्डा एषां वर्त्तमानलोकानां भविष्यन्ति, युष्मानहं निश्चितं वदामि सर्व्वे दण्डा वंशस्यास्य भविष्यन्ति।</para>
  <para style="p">
    <verse number="52" style="v"/>हा हा व्यवस्थपका यूयं ज्ञानस्य कुञ्चिकां हृत्वा स्वयं न प्रविष्टा ये प्रवेष्टुञ्च प्रयासिनस्तानपि प्रवेष्टुं वारितवन्तः।</para>
  <para style="p">
    <verse number="53" style="v"/>इत्थं कथाकथनाद् अध्यापकाः फिरूशिनश्च सतर्काः</para>
  <para style="p">
    <verse number="54" style="v"/>सन्तस्तमपवदितुं तस्य कथाया दोषं धर्त्तमिच्छन्तो नानाख्यानकथनाय तं प्रवर्त्तयितुं कोपयितुञ्च प्रारेभिरे।</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>तदानीं लोकाः सहस्रं सहस्रम् आगत्य समुपस्थितास्तत एकैको ऽन्येषामुपरि पतितुम् उपचक्रमे; तदा यीशुः शिष्यान् बभाषे, यूयं फिरूशिनां किण्वरूपकापट्ये विशेषेण सावधानास्तिष्ठत।</para>
  <para style="p">
    <verse number="2" style="v"/>यतो यन्न प्रकाशयिष्यते तदाच्छन्नं वस्तु किमपि नास्ति; तथा यन्न ज्ञास्यते तद् गुप्तं वस्तु किमपि नास्ति।</para>
  <para style="p">
    <verse number="3" style="v"/>अन्धकारे तिष्ठनतो याः कथा अकथयत ताः सर्व्वाः कथा दीप्तौ श्रोष्यन्ते निर्जने कर्णे च यदकथयत गृहपृष्ठात् तत् प्रचारयिष्यते।</para>
  <para style="p">
    <verse number="4" style="v"/>हे बन्धवो युष्मानहं वदामि, ये शरीरस्य नाशं विना किमप्यपरं कर्त्तुं न शक्रुवन्ति तेभ्यो मा भैष्ट।</para>
  <para style="p">
    <verse number="5" style="v"/>तर्हि कस्माद् भेतव्यम् इत्यहं वदामि, यः शरीरं नाशयित्वा नरकं निक्षेप्तुं शक्नोति तस्मादेव भयं कुरुत, पुनरपि वदामि तस्मादेव भयं कुरुत।</para>
  <para style="p">
    <verse number="6" style="v"/>पञ्च चटकपक्षिणः किं द्वाभ्यां ताम्रखण्डाभ्यां न विक्रीयन्ते? तथापीश्वरस्तेषाम् एकमपि न विस्मरति।</para>
  <para style="p">
    <verse number="7" style="v"/>युष्माकं शिरःकेशा अपि गणिताः सन्ति तस्मात् मा विभीत बहुचटकपक्षिभ्योपि यूयं बहुमूल्याः।</para>
  <para style="p">
    <verse number="8" style="v"/>अपरं युष्मभ्यं कथयामि यः कश्चिन् मानुषाणां साक्षान् मां स्वीकरोति मनुष्यपुत्र ईश्वरदूतानां साक्षात् तं स्वीकरिष्यति।</para>
  <para style="p">
    <verse number="9" style="v"/>किन्तु यः कश्चिन्मानुषाणां साक्षान्माम् अस्वीकरोति तम् ईश्वरस्य दूतानां साक्षाद् अहम् अस्वीकरिष्यामि।</para>
  <para style="p">
    <verse number="10" style="v"/>अन्यच्च यः कश्चिन् मनुजसुतस्य निन्दाभावेन काञ्चित् कथां कथयति तस्य तत्पापस्य मोचनं भविष्यति किन्तु यदि कश्चित् पवित्रम् आत्मानं निन्दति तर्हि तस्य तत्पापस्य मोचनं न भविष्यति।</para>
  <para style="p">
    <verse number="11" style="v"/>यदा लोका युष्मान् भजनगेहं विचारकर्तृराज्यकर्तृणां सम्मुखञ्च नेष्यन्ति तदा केन प्रकारेण किमुत्तरं वदिष्यथ किं कथयिष्यथ चेत्यत्र मा चिन्तयत;</para>
  <para style="p">
    <verse number="12" style="v"/>यतो युष्माभिर्यद् यद् वक्तव्यं तत् तस्मिन् समयएव पवित्र आत्मा युष्मान् शिक्षयिष्यति।</para>
  <para style="p">
    <verse number="13" style="v"/>ततः परं जनतामध्यस्थः कश्चिज्जनस्तं जगाद हे गुरो मया सह पैतृकं धनं विभक्तुं मम भ्रातरमाज्ञापयतु भवान्।</para>
  <para style="p">
    <verse number="14" style="v"/>किन्तु स तमवदत् हे मनुष्य युवयो र्विचारं विभागञ्च कर्त्तुं मां को नियुक्तवान्?</para>
  <para style="p">
    <verse number="15" style="v"/>अनन्तरं स लोकानवदत् लोभे सावधानाः सतर्काश्च तिष्ठत, यतो बहुसम्पत्तिप्राप्त्या मनुष्यस्यायु र्न भवति।</para>
  <para style="p">
    <verse number="16" style="v"/>पश्चाद् दृष्टान्तकथामुत्थाप्य कथयामास, एकस्य धनिनो भूमौ बहूनि शस्यानि जातानि।</para>
  <para style="p">
    <verse number="17" style="v"/>ततः स मनसा चिन्तयित्वा कथयाम्बभूव ममैतानि समुत्पन्नानि द्रव्याणि स्थापयितुं स्थानं नास्ति किं करिष्यामि?</para>
  <para style="p">
    <verse number="18" style="v"/>ततोवदद् इत्थं करिष्यामि, मम सर्व्वभाण्डागाराणि भङ्क्त्वा बृहद्भाण्डागाराणि निर्म्माय तन्मध्ये सर्व्वफलानि द्रव्याणि च स्थापयिष्यामि।</para>
  <para style="p">
    <verse number="19" style="v"/>अपरं निजमनो वदिष्यामि, हे मनो बहुवत्सरार्थं नानाद्रव्याणि सञ्चितानि सन्ति विश्रामं कुरु भुक्त्वा पीत्वा कौतुकञ्च कुरु। किन्त्वीश्वरस्तम् अवदत्,</para>
  <para style="p">
    <verse number="20" style="v"/>रे निर्बोध अद्य रात्रौ तव प्राणास्त्वत्तो नेष्यन्ते तत एतानि यानि द्रव्याणि त्वयासादितानि तानि कस्य भविष्यन्ति?</para>
  <para style="p">
    <verse number="21" style="v"/>अतएव यः कश्चिद् ईश्वरस्य समीपे धनसञ्चयमकृत्वा केवलं स्वनिकटे सञ्चयं करोति सोपि तादृशः।</para>
  <para style="p">
    <verse number="22" style="v"/>अथ स शिष्येभ्यः कथयामास, युष्मानहं वदामि, किं खादिष्यामः? किं परिधास्यामः? इत्युक्त्वा जीवनस्य शरीरस्य चार्थं चिन्तां मा कार्ष्ट।</para>
  <para style="p">
    <verse number="23" style="v"/>भक्ष्याज्जीवनं भूषणाच्छरीरञ्च श्रेष्ठं भवति।</para>
  <para style="p">
    <verse number="24" style="v"/>काकपक्षिणां कार्य्यं विचारयत, ते न वपन्ति शस्यानि च न छिन्दन्ति, तेषां भाण्डागाराणि न सन्ति कोषाश्च न सन्ति, तथापीश्वरस्तेभ्यो भक्ष्याणि ददाति, यूयं पक्षिभ्यः श्रेष्ठतरा न किं?</para>
  <para style="p">
    <verse number="25" style="v"/>अपरञ्च भावयित्वा निजायुषः क्षणमात्रं वर्द्धयितुं शक्नोति, एतादृशो लाको युष्माकं मध्ये कोस्ति?</para>
  <para style="p">
    <verse number="26" style="v"/>अतएव क्षुद्रं कार्य्यं साधयितुम् असमर्था यूयम् अन्यस्मिन् कार्य्ये कुतो भावयथ?</para>
  <para style="p">
    <verse number="27" style="v"/>अन्यच्च काम्पिलपुष्पं कथं वर्द्धते तदापि विचारयत, तत् कञ्चन श्रमं न करोति तन्तूंश्च न जनयति किन्तु युष्मभ्यं यथार्थं कथयामि सुलेमान् बह्वैश्वर्य्यान्वितोपि पुष्पस्यास्य सदृशो विभूषितो नासीत्।</para>
  <para style="p">
    <verse number="28" style="v"/>अद्य क्षेत्रे वर्त्तमानं श्वश्चूल्ल्यां क्षेप्स्यमानं यत् तृणं, तस्मै यदीश्वर इत्थं भूषयति तर्हि हे अल्पप्रत्ययिनो युष्मान किं न परिधापयिष्यति?</para>
  <para style="p">
    <verse number="29" style="v"/>अतएव किं खादिष्यामः? किं परिधास्यामः? एतदर्थं मा चेष्टध्वं मा संदिग्ध्वञ्च।</para>
  <para style="p">
    <verse number="30" style="v"/>जगतो देवार्च्चका एतानि सर्व्वाणि चेष्टनते; एषु वस्तुषु युष्माकं प्रयोजनमास्ते इति युष्माकं पिता जानाति।</para>
  <para style="p">
    <verse number="31" style="v"/>अतएवेश्वरस्य राज्यार्थं सचेष्टा भवत तथा कृते सर्व्वाण्येतानि द्रव्याणि युष्मभ्यं प्रदायिष्यन्ते।</para>
  <para style="p">
    <verse number="32" style="v"/>हे क्षुद्रमेषव्रज यूयं मा भैष्ट युष्मभ्यं राज्यं दातुं युष्माकं पितुः सम्मतिरस्ति।</para>
  <para style="p">
    <verse number="33" style="v"/>अतएव युष्माकं या या सम्पत्तिरस्ति तां तां विक्रीय वितरत, यत् स्थानं चौरा नागच्छन्ति, कीटाश्च न क्षाययन्ति तादृशे स्वर्गे निजार्थम् अजरे सम्पुटके ऽक्षयं धनं सञ्चिनुत च;</para>
  <para style="p">
    <verse number="34" style="v"/>यतो यत्र युष्माकं धनं वर्त्तते तत्रेव युष्माकं मनः।</para>
  <para style="p">
    <verse number="35" style="v"/>अपरञ्च यूयं प्रदीपं ज्वालयित्वा बद्धकटयस्तिष्ठत;</para>
  <para style="p">
    <verse number="36" style="v"/>प्रभु र्विवाहादागत्य यदैव द्वारमाहन्ति तदैव द्वारं मोचयितुं यथा भृत्या अपेक्ष्य तिष्ठन्ति तथा यूयमपि तिष्ठत।</para>
  <para style="p">
    <verse number="37" style="v"/>यतः प्रभुरागत्य यान् दासान् सचेतनान् तिष्ठतो द्रक्ष्यति तएव धन्याः; अहं युष्मान् यथार्थं वदामि प्रभुस्तान् भोजनार्थम् उपवेश्य स्वयं बद्धकटिः समीपमेत्य परिवेषयिष्यति।</para>
  <para style="p">
    <verse number="38" style="v"/>यदि द्वितीये तृतीये वा प्रहरे समागत्य तथैव पश्यति, तर्हि तएव दासा धन्याः।</para>
  <para style="p">
    <verse number="39" style="v"/>अपरञ्च कस्मिन् क्षणे चौरा आगमिष्यन्ति इति यदि गृहपति र्ज्ञातुं शक्नोति तदावश्यं जाग्रन् निजगृहे सन्धिं कर्त्तयितुं वारयति यूयमेतद् वित्त।</para>
  <para style="p">
    <verse number="40" style="v"/>अतएव यूयमपि सज्जमानास्तिष्ठत यतो यस्मिन् क्षणे तं नाप्रेक्षध्वे तस्मिन्नेव क्षणे मनुष्यपुत्र आगमिष्यति।</para>
  <para style="p">
    <verse number="41" style="v"/>तदा पितरः पप्रच्छ, हे प्रभो भवान् किमस्मान् उद्दिश्य किं सर्व्वान् उद्दिश्य दृष्टान्तकथामिमां वदति?</para>
  <para style="p">
    <verse number="42" style="v"/>ततः प्रभुः प्रोवाच, प्रभुः समुचितकाले निजपरिवारार्थं भोज्यपरिवेषणाय यं तत्पदे नियोक्ष्यति तादृशो विश्वास्यो बोद्धा कर्म्माधीशः कोस्ति?</para>
  <para style="p">
    <verse number="43" style="v"/>प्रभुरागत्य यम् एतादृशे कर्म्मणि प्रवृत्तं द्रक्ष्यति सएव दासो धन्यः।</para>
  <para style="p">
    <verse number="44" style="v"/>अहं युष्मान् यथार्थं वदामि स तं निजसर्व्वस्वस्याधिपतिं करिष्यति।</para>
  <para style="p">
    <verse number="45" style="v"/>किन्तु प्रभुर्विलम्बेनागमिष्यति, इति विचिन्त्य स दासो यदि तदन्यदासीदासान् प्रहर्त्तुम् भोक्तुं पातुं मदितुञ्च प्रारभते,</para>
  <para style="p">
    <verse number="46" style="v"/>तर्हि यदा प्रभुं नापेक्षिष्यते यस्मिन् क्षणे सोऽचेतनश्च स्थास्यति तस्मिन्नेव क्षणे तस्य प्रभुरागत्य तं पदभ्रष्टं कृत्वा विश्वासहीनैः सह तस्य अंशं निरूपयिष्यति।</para>
  <para style="p">
    <verse number="47" style="v"/>यो दासः प्रभेाराज्ञां ज्ञात्वापि सज्जितो न तिष्ठति तदाज्ञानुसारेण च कार्य्यं न करोति सोनेकान् प्रहारान् प्राप्स्यति;</para>
  <para style="p">
    <verse number="48" style="v"/>किन्तु यो जनोऽज्ञात्वा प्रहारार्हं कर्म्म करोति सोल्पप्रहारान् प्राप्स्यति। यतो यस्मै बाहुल्येन दत्तं तस्मादेव बाहुल्येन ग्रहीष्यते, मानुषा यस्य निकटे बहु समर्पयन्ति तस्माद् बहु याचन्ते।</para>
  <para style="p">
    <verse number="49" style="v"/>अहं पृथिव्याम् अनैक्यरूपं वह्नि निक्षेप्तुम् आगतोस्मि, स चेद् इदानीमेव प्रज्वलति तत्र मम का चिन्ता?</para>
  <para style="p">
    <verse number="50" style="v"/>किन्तु येन मज्जनेनाहं मग्नो भविष्यामि यावत्कालं तस्य सिद्धि र्न भविष्यति तावदहं कतिकष्टं प्राप्स्यामि।</para>
  <para style="p">
    <verse number="51" style="v"/>मेलनं कर्त्तुं जगद् आगतोस्मि यूयं किमित्थं बोधध्वे? युष्मान् वदामि न तथा, किन्त्वहं मेलनाभावं कर्त्तुंम् आगतोस्मि।</para>
  <para style="p">
    <verse number="52" style="v"/>यस्मादेतत्कालमारभ्य एकत्रस्थपरिजनानां मध्ये पञ्चजनाः पृथग् भूत्वा त्रयो जना द्वयोर्जनयोः प्रतिकूला द्वौ जनौ च त्रयाणां जनानां प्रतिकूलौ भविष्यन्ति।</para>
  <para style="p">
    <verse number="53" style="v"/>पिता पुत्रस्य विपक्षः पुत्रश्च पितु र्विपक्षो भविष्यति माता कन्याया विपक्षा कन्या च मातु र्विपक्षा भविष्यति, तथा श्वश्रूर्बध्वा विपक्षा बधूश्च श्वश्र्वा विपक्षा भविष्यति।</para>
  <para style="p">
    <verse number="54" style="v"/>स लोकेभ्योपरमपि कथयामास, पश्चिमदिशि मेघोद्गमं दृष्ट्वा यूयं हठाद् वदथ वृष्टि र्भविष्यति ततस्तथैव जायते।</para>
  <para style="p">
    <verse number="55" style="v"/>अपरं दक्षिणतो वायौ वाति सति वदथ निदाघो भविष्यति ततः सोपि जायते।</para>
  <para style="p">
    <verse number="56" style="v"/>रे रे कपटिन आकाशस्य भूम्याश्च लक्षणं बोद्धुं शक्नुथ,</para>
  <para style="p">
    <verse number="57" style="v"/>किन्तु कालस्यास्य लक्षणं कुतो बोद्धुं न शक्नुथ? यूयञ्च स्वयं कुतो न न्याष्यं विचारयथ?</para>
  <para style="p">
    <verse number="58" style="v"/>अपरञ्च विवादिना सार्द्धं विचारयितुः समीपं गच्छन् पथि तस्मादुद्धारं प्राप्तुं यतस्व नोचेत् स त्वां धृत्वा विचारयितुः समीपं नयति। विचारयिता यदि त्वां प्रहर्त्तुः समीपं समर्पयति प्रहर्त्ता त्वां कारायां बध्नाति</para>
  <para style="p">
    <verse number="59" style="v"/>तर्हि त्वामहं वदामि त्वया निःशेषं कपर्दकेषु न परिशोधितेषु त्वं ततो मुक्तिं प्राप्तुं न शक्ष्यसि।</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अपरञ्च पीलातो येषां गालीलीयानां रक्तानि बलीनां रक्तैः सहामिश्रयत् तेषां गालीलीयानां वृत्तान्तं कतिपयजना उपस्थाप्य यीशवे कथयामासुः।</para>
  <para style="p">
    <verse number="2" style="v"/>ततः स प्रत्युवाच तेषां लोकानाम् एतादृशी दुर्गति र्घटिता तत्कारणाद् यूयं किमन्येभ्यो गालीलीयेभ्योप्यधिकपापिनस्तान् बोधध्वे?</para>
  <para style="p">
    <verse number="3" style="v"/>युष्मानहं वदामि तथा न किन्तु मनःसु न परावर्त्तितेषु यूयमपि तथा नंक्ष्यथ।</para>
  <para style="p">
    <verse number="4" style="v"/>अपरञ्च शीलोहनाम्न उच्चगृहस्य पतनाद् येऽष्टादशजना मृतास्ते यिरूशालमि निवासिसर्व्वलोकेभ्योऽधिकापराधिनः किं यूयमित्यं बोधध्वे?</para>
  <para style="p">
    <verse number="5" style="v"/>युष्मानहं वदामि तथा न किन्तु मनःसु न परिवर्त्तितेषु यूयमपि तथा नंक्ष्यथ।</para>
  <para style="p">
    <verse number="6" style="v"/>अनन्तरं स इमां दृष्टान्तकथामकथयद् एको जनो द्राक्षाक्षेत्रमध्य एकमुडुम्बरवृक्षं रोपितवान्। पश्चात् स आगत्य तस्मिन् फलानि गवेषयामास,</para>
  <para style="p">
    <verse number="7" style="v"/>किन्तु फलाप्राप्तेः कारणाद् उद्यानकारं भृत्यं जगाद, पश्य वत्सरत्रयं यावदागत्य एतस्मिन्नुडुम्बरतरौ क्षलान्यन्विच्छामि, किन्तु नैकमपि प्रप्नोमि तरुरयं कुतो वृथा स्थानं व्याप्य तिष्ठति? एनं छिन्धि।</para>
  <para style="p">
    <verse number="8" style="v"/>ततो भृत्यः प्रत्युवाच, हे प्रभो पुनर्वर्षमेकं स्थातुम् आदिश; एतस्य मूलस्य चतुर्दिक्षु खनित्वाहम् आलवालं स्थापयामि।</para>
  <para style="p">
    <verse number="9" style="v"/>ततः फलितुं शक्नोति यदि न फलति तर्हि पश्चात् छेत्स्यसि।</para>
  <para style="p">
    <verse number="10" style="v"/>अथ विश्रामवारे भजनगेहे यीशुरुपदिशति</para>
  <para style="p">
    <verse number="11" style="v"/>तस्मित् समये भूतग्रस्तत्वात् कुब्जीभूयाष्टादशवर्षाणि यावत् केनाप्युपायेन ऋजु र्भवितुं न शक्नोति या दुर्ब्बला स्त्री,</para>
  <para style="p">
    <verse number="12" style="v"/>तां तत्रोपस्थितां विलोक्य यीशुस्तामाहूय कथितवान् हे नारि तव दौर्ब्बल्यात् त्वं मुक्ता भव।</para>
  <para style="p">
    <verse number="13" style="v"/>ततः परं तस्या गात्रे हस्तार्पणमात्रात् सा ऋजुर्भूत्वेश्वरस्य धन्यवादं कर्त्तुमारेभे।</para>
  <para style="p">
    <verse number="14" style="v"/>किन्तु विश्रामवारे यीशुना तस्याः स्वास्थ्यकरणाद् भजनगेहस्याधिपतिः प्रकुप्य लोकान् उवाच, षट्सु दिनेषु लोकैः कर्म्म कर्त्तव्यं तस्माद्धेतोः स्वास्थ्यार्थं तेषु दिनेषु आगच्छत, विश्रामवारे मागच्छत।</para>
  <para style="p">
    <verse number="15" style="v"/>तदा पभुः प्रत्युवाच रे कपटिनो युष्माकम् एकैको जनो विश्रामवारे स्वीयं स्वीयं वृषभं गर्दभं वा बन्धनान्मोचयित्वा जलं पाययितुं किं न नयति?</para>
  <para style="p">
    <verse number="16" style="v"/>तर्ह्याष्टादशवत्सरान् यावत् शैताना बद्धा इब्राहीमः सन्ततिरियं नारी किं विश्रामवारे न मोचयितव्या?</para>
  <para style="p">
    <verse number="17" style="v"/>एषु वाक्येषु कथितेषु तस्य विपक्षाः सलज्जा जाताः किन्तु तेन कृतसर्व्वमहाकर्म्मकारणात् लोकनिवहः सानन्दोऽभवत्।</para>
  <para style="p">
    <verse number="18" style="v"/>अनन्तरं सोवदद् ईश्वरस्य राज्यं कस्य सदृशं? केन तदुपमास्यामि?</para>
  <para style="p">
    <verse number="19" style="v"/>यत् सर्षपबीजं गृहीत्वा कश्चिज्जन उद्यान उप्तवान् तद् बीजमङ्कुरितं सत् महावृक्षोऽजायत, ततस्तस्य शाखासु विहायसीयविहगा आगत्य न्यूषुः, तद्राज्यं तादृशेन सर्षपबीजेन तुल्यं।</para>
  <para style="p">
    <verse number="20" style="v"/>पुनः कथयामास, ईश्वरस्य राज्यं कस्य सदृशं वदिष्यामि? यत् किण्वं काचित् स्त्री गृहीत्वा द्रोणत्रयपरिमितगोधूमचूर्णेषु स्थापयामास,</para>
  <para style="p">
    <verse number="21" style="v"/>ततः क्रमेण तत् सर्व्वगोधूमचूर्णं व्याप्नोति, तस्य किण्वस्य तुल्यम् ईश्वरस्य राज्यं।</para>
  <para style="p">
    <verse number="22" style="v"/>ततः स यिरूशालम्नगरं प्रति यात्रां कृत्वा नगरे नगरे ग्रामे ग्रामे समुपदिशन् जगाम।</para>
  <para style="p">
    <verse number="23" style="v"/>तदा कश्चिज्जनस्तं पप्रच्छ, हे प्रभो किं केवलम् अल्पे लोकाः परित्रास्यन्ते?</para>
  <para style="p">
    <verse number="24" style="v"/>ततः स लोकान् उवाच, संकीर्णद्वारेण प्रवेष्टुं यतघ्वं, यतोहं युष्मान् वदामि, बहवः प्रवेष्टुं चेष्टिष्यन्ते किन्तु न शक्ष्यन्ति।</para>
  <para style="p">
    <verse number="25" style="v"/>गृहपतिनोत्थाय द्वारे रुद्धे सति यदि यूयं बहिः स्थित्वा द्वारमाहत्य वदथ, हे प्रभो हे प्रभो अस्मत्कारणाद् द्वारं मोचयतु, ततः स इति प्रतिवक्ष्यति, यूयं कुत्रत्या लोका इत्यहं न जानामि।</para>
  <para style="p">
    <verse number="26" style="v"/>तदा यूयं वदिष्यथ, तव साक्षाद् वयं भेाजनं पानञ्च कृतवन्तः, त्वञ्चास्माकं नगरस्य पथि समुपदिष्टवान्।</para>
  <para style="p">
    <verse number="27" style="v"/>किन्तु स वक्ष्यति, युष्मानहं वदामि, यूयं कुत्रत्या लोका इत्यहं न जानामि; हे दुराचारिणो यूयं मत्तो दूरीभवत।</para>
  <para style="p">
    <verse number="28" style="v"/>तदा इब्राहीमं इस्हाकं याकूबञ्च सर्व्वभविष्यद्वादिनश्च ईश्वरस्य राज्यं प्राप्तान् स्वांश्च बहिष्कृतान् दृष्ट्वा यूयं रोदनं दन्तैर्दन्तघर्षणञ्च करिष्यथ।</para>
  <para style="p">
    <verse number="29" style="v"/>अपरञ्च पूर्व्वपश्चिमदक्षिणोत्तरदिग्भ्यो लोका आगत्य ईश्वरस्य राज्ये निवत्स्यन्ति।</para>
  <para style="p">
    <verse number="30" style="v"/>पश्यतेत्थं शेषीया लोका अग्रा भविष्यन्ति, अग्रीया लोकाश्च शेषा भविष्यन्ति।</para>
  <para style="p">
    <verse number="31" style="v"/>अपरञ्च तस्मिन् दिने कियन्तः फिरूशिन आगत्य यीशुं प्रोचुः, बहिर्गच्छ, स्थानादस्मात् प्रस्थानं कुरु, हेरोद् त्वां जिघांसति।</para>
  <para style="p">
    <verse number="32" style="v"/>ततः स प्रत्यवोचत् पश्यताद्य श्वश्च भूतान् विहाप्य रोगिणोऽरोगिणः कृत्वा तृतीयेह्नि सेत्स्यामि, कथामेतां यूयमित्वा तं भूरिमायं वदत।</para>
  <para style="p">
    <verse number="33" style="v"/>तत्राप्यद्य श्वः परश्वश्च मया गमनागमने कर्त्तव्ये, यतो हेतो र्यिरूशालमो बहिः कुत्रापि कोपि भविष्यद्वादी न घानिष्यते।</para>
  <para style="p">
    <verse number="34" style="v"/>हे यिरूशालम् हे यिरूशालम् त्वं भविष्यद्वादिनो हंसि तवान्तिके प्रेरितान् प्रस्तरैर्मारयसि च, यथा कुक्कुटी निजपक्षाधः स्वशावकान् संगृह्लाति, तथाहमपि तव शिशून् संग्रहीतुं कतिवारान् ऐच्छं किन्तु त्वं नैच्छः।</para>
  <para style="p">
    <verse number="35" style="v"/>पश्यत युष्माकं वासस्थानानि प्रोच्छिद्यमानानि परित्यक्तानि च भविष्यन्ति; युष्मानहं यथार्थं वदामि, यः प्रभो र्नाम्नागच्छति स धन्य इति वाचं यावत्कालं न वदिष्यथ, तावत्कालं यूयं मां न द्रक्ष्यथ।</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अनन्तरं विश्रामवारे यीशौ प्रधानस्य फिरूशिनो गृहे भोक्तुं गतवति ते तं वीक्षितुम् आरेभिरे।</para>
  <para style="p">
    <verse number="2" style="v"/>तदा जलोदरी तस्य सम्मुखे स्थितः।</para>
  <para style="p">
    <verse number="3" style="v"/>ततः स व्यवस्थापकान् फिरूशिनश्च पप्रच्छ, विश्रामवारे स्वास्थ्यं कर्त्तव्यं न वा? ततस्ते किमपि न प्रत्यूचुः।</para>
  <para style="p">
    <verse number="4" style="v"/>तदा स तं रोगिणं स्वस्थं कृत्वा विससर्ज;</para>
  <para style="p">
    <verse number="5" style="v"/>तानुवाच च युष्माकं कस्यचिद् गर्द्दभो वृषभो वा चेद् गर्त्ते पतति तर्हि विश्रामवारे तत्क्षणं स किं तं नोत्थापयिष्यति?</para>
  <para style="p">
    <verse number="6" style="v"/>ततस्ते कथाया एतस्याः किमपि प्रतिवक्तुं न शेकुः।</para>
  <para style="p">
    <verse number="7" style="v"/>अपरञ्च प्रधानस्थानमनोनीतत्वकरणं विलोक्य स निमन्त्रितान् एतदुपदेशकथां जगाद,</para>
  <para style="p">
    <verse number="8" style="v"/>त्वं विवाहादिभोज्येषु निमन्त्रितः सन् प्रधानस्थाने मोपावेक्षीः। त्वत्तो गौरवान्वितनिमन्त्रितजन आयाते</para>
  <para style="p">
    <verse number="9" style="v"/>निमन्त्रयितागत्य मनुष्यायैतस्मै स्थानं देहीति वाक्यं चेद् वक्ष्यति तर्हि त्वं सङ्कुचितो भूत्वा स्थान इतरस्मिन् उपवेष्टुम् उद्यंस्यसि।</para>
  <para style="p">
    <verse number="10" style="v"/>अस्मात् कारणादेव त्वं निमन्त्रितो गत्वाऽप्रधानस्थान उपविश, ततो निमन्त्रयितागत्य वदिष्यति, हे बन्धो प्रोच्चस्थानं गत्वोपविश, तथा सति भोजनोपविष्टानां सकलानां साक्षात् त्वं मान्यो भविष्यसि।</para>
  <para style="p">
    <verse number="11" style="v"/>यः कश्चित् स्वमुन्नमयति स नमयिष्यते, किन्तु यः कश्चित् स्वं नमयति स उन्नमयिष्यते।</para>
  <para style="p">
    <verse number="12" style="v"/>तदा स निमन्त्रयितारं जनमपि जगाद, मध्याह्ने रात्रौ वा भोज्ये कृते निजबन्धुगणो वा भ्रातृृगणो वा ज्ञातिगणो वा धनिगणो वा समीपवासिगणो वा एतान् न निमन्त्रय, तथा कृते चेत् ते त्वां निमन्त्रयिष्यन्ति, तर्हि परिशोधो भविष्यति।</para>
  <para style="p">
    <verse number="13" style="v"/>किन्तु यदा भेज्यं करोषि तदा दरिद्रशुष्ककरखञ्जान्धान् निमन्त्रय,</para>
  <para style="p">
    <verse number="14" style="v"/>तत आशिषं लप्स्यसे, तेषु परिशोधं कर्त्तुमशक्नुवत्सु श्मशानाद्धार्म्मिकानामुत्थानकाले त्वं फलां लप्स्यसे।</para>
  <para style="p">
    <verse number="15" style="v"/>अनन्तरं तां कथां निशम्य भोजनोपविष्टः कश्चित् कथयामास, यो जन ईश्वरस्य राज्ये भोक्तुं लप्स्यते सएव धन्यः।</para>
  <para style="p">
    <verse number="16" style="v"/>ततः स उवाच, कश्चित् जनो रात्रौ भेाज्यं कृत्वा बहून् निमन्त्रयामास।</para>
  <para style="p">
    <verse number="17" style="v"/>ततो भोजनसमये निमन्त्रितलोकान् आह्वातुं दासद्वारा कथयामास, खद्यद्रव्याणि सर्व्वाणि समासादितानि सन्ति, यूयमागच्छत।</para>
  <para style="p">
    <verse number="18" style="v"/>किन्तु ते सर्व्व एकैकं छलं कृत्वा क्षमां प्रार्थयाञ्चक्रिरे। प्रथमो जनः कथयामास, क्षेत्रमेकं क्रीतवानहं तदेव द्रष्टुं मया गन्तव्यम्, अतएव मां क्षन्तुं तं निवेदय।</para>
  <para style="p">
    <verse number="19" style="v"/>अन्यो जनः कथयामास, दशवृषानहं क्रीतवान् तान् परीक्षितुं यामि तस्मादेव मां क्षन्तुं तं निवेदय।</para>
  <para style="p">
    <verse number="20" style="v"/>अपरः कथयामास, व्यूढवानहं तस्मात् कारणाद् यातुं न शक्नोमि।</para>
  <para style="p">
    <verse number="21" style="v"/>पश्चात् स दासो गत्वा निजप्रभोः साक्षात् सर्व्ववृत्तान्तं निवेदयामास, ततोसौ गृहपतिः कुपित्वा स्वदासं व्याजहार, त्वं सत्वरं नगरस्य सन्निवेशान् मार्गांश्च गत्वा दरिद्रशुष्ककरखञ्जान्धान् अत्रानय।</para>
  <para style="p">
    <verse number="22" style="v"/>ततो दासोऽवदत्, हे प्रभो भवत आज्ञानुसारेणाक्रियत तथापि स्थानमस्ति।</para>
  <para style="p">
    <verse number="23" style="v"/>तदा प्रभुः पुन र्दासायाकथयत्, राजपथान् वृक्षमूलानि च यात्वा मदीयगृहपूरणार्थं लोकानागन्तुं प्रवर्त्तय।</para>
  <para style="p">
    <verse number="24" style="v"/>अहं युष्मभ्यं कथयामि, पूर्व्वनिमन्त्रितानमेकोपि ममास्य रात्रिभोज्यस्यास्वादं न प्राप्स्यति।</para>
  <para style="p">
    <verse number="25" style="v"/>अनन्तरं बहुषु लोकेषु यीशोः पश्चाद् व्रजितेषु सत्सु स व्याघुट्य तेभ्यः कथयामास,</para>
  <para style="p">
    <verse number="26" style="v"/>यः कश्चिन् मम समीपम् आगत्य स्वस्य माता पिता पत्नी सन्ताना भ्रातरो भगिम्यो निजप्राणाश्च, एतेभ्यः सर्व्वेभ्यो मय्यधिकं प्रेम न करोति, स मम शिष्यो भवितुं न शक्ष्यति।</para>
  <para style="p">
    <verse number="27" style="v"/>यः कश्चित् स्वीयं क्रुशं वहन् मम पश्चान्न गच्छति, सोपि मम शिष्यो भवितुं न शक्ष्यति।</para>
  <para style="p">
    <verse number="28" style="v"/>दुर्गनिर्म्माणे कतिव्ययो भविष्यति, तथा तस्य समाप्तिकरणार्थं सम्पत्तिरस्ति न वा, प्रथममुपविश्य एतन्न गणयति, युष्माकं मध्य एतादृशः कोस्ति?</para>
  <para style="p">
    <verse number="29" style="v"/>नोचेद् भित्तिं कृत्वा शेषे यदि समापयितुं न शक्ष्यति,</para>
  <para style="p">
    <verse number="30" style="v"/>तर्हि मानुषोयं निचेतुम् आरभत समापयितुं नाशक्नोत्, इति व्याहृत्य सर्व्वे तमुपहसिष्यन्ति।</para>
  <para style="p">
    <verse number="31" style="v"/>अपरञ्च भिन्नभूपतिना सह युद्धं कर्त्तुम् उद्यम्य दशसहस्राणि सैन्यानि गृहीत्वा विंशतिसहस्रेः सैन्यैः सहितस्य समीपवासिनः सम्मुखं यातुं शक्ष्यामि न वेति प्रथमं उपविश्य न विचारयति एतादृशो भूमिपतिः कः?</para>
  <para style="p">
    <verse number="32" style="v"/>यदि न शक्नोति तर्हि रिपावतिदूरे तिष्ठति सति निजदूतं प्रेष्य सन्धिं कर्त्तुं प्रार्थयेत।</para>
  <para style="p">
    <verse number="33" style="v"/>तद्वद् युष्माकं मध्ये यः कश्चिन् मदर्थं सर्व्वस्वं हातुं न शक्नोति स मम शिष्यो भवितुं न शक्ष्यति।</para>
  <para style="p">
    <verse number="34" style="v"/>लवणम् उत्तमम् इति सत्यं, किन्तु यदि लवणस्य लवणत्वम् अपगच्छति तर्हि तत् कथं स्वादुयुक्तं भविष्यति?</para>
  <para style="p">
    <verse number="35" style="v"/>तद भूम्यर्थम् आलवालराश्यर्थमपि भद्रं न भवति; लोकास्तद् बहिः क्षिपन्ति।यस्य श्रोतुं श्रोत्रे स्तः स शृणोतु।</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>तदा करसञ्चायिनः पापिनश्च लोका उपदेश्कथां श्रोतुं यीशोः समीपम् आगच्छन्।</para>
  <para style="p">
    <verse number="2" style="v"/>ततः फिरूशिन उपाध्यायाश्च विवदमानाः कथयामासुः एष मानुषः पापिभिः सह प्रणयं कृत्वा तैः सार्द्धं भुंक्ते।</para>
  <para style="p">
    <verse number="3" style="v"/>तदा स तेभ्य इमां दृष्टान्तकथां कथितवान्,</para>
  <para style="p">
    <verse number="4" style="v"/>कस्यचित् शतमेषेषु तिष्ठत्मु तेषामेकं स यदि हारयति तर्हि मध्येप्रान्तरम् एकोनशतमेषान् विहाय हारितमेषस्य उद्देशप्राप्तिपर्य्यनतं न गवेषयति, एतादृशो लोको युष्माकं मध्ये क आस्ते?</para>
  <para style="p">
    <verse number="5" style="v"/>तस्योद्देशं प्राप्य हृष्टमनास्तं स्कन्धे निधाय स्वस्थानम् आनीय बन्धुबान्धवसमीपवासिन आहूय वक्ति,</para>
  <para style="p">
    <verse number="6" style="v"/>हारितं मेषं प्राप्तोहम् अतो हेतो र्मया सार्द्धम् आनन्दत।</para>
  <para style="p">
    <verse number="7" style="v"/>तद्वदहं युष्मान् वदामि, येषां मनःपरावर्त्तनस्य प्रयोजनं नास्ति, तादृशैकोनशतधार्म्मिककारणाद् य आनन्दस्तस्माद् एकस्य मनःपरिवर्त्तिनः पापिनः कारणात् स्वर्गे ऽधिकानन्दो जायते।</para>
  <para style="p">
    <verse number="8" style="v"/>अपरञ्च दशानां रूप्यखण्डानाम् एकखण्डे हारिते प्रदीपं प्रज्वाल्य गृहं सम्मार्ज्य तस्य प्राप्तिं यावद् यत्नेन न गवेषयति, एतादृशी योषित् कास्ते?</para>
  <para style="p">
    <verse number="9" style="v"/>प्राप्ते सति बन्धुबान्धवसमीपवासिनीराहूय कथयति, हारितं रूप्यखण्डं प्राप्ताहं तस्मादेव मया सार्द्धम् आनन्दत।</para>
  <para style="p">
    <verse number="10" style="v"/>तद्वदहं युष्मान् व्याहरामि, एकेन पापिना मनसि परिवर्त्तिते, ईश्वरस्य दूतानां मध्येप्यानन्दो जायते।</para>
  <para style="p">
    <verse number="11" style="v"/>अपरञ्च स कथयामास, कस्यचिद् द्वौ पुत्रावास्तां,</para>
  <para style="p">
    <verse number="12" style="v"/>तयोः कनिष्ठः पुत्रः पित्रे कथयामास, हे पितस्तव सम्पत्त्या यमंशं प्राप्स्याम्यहं विभज्य तं देहि, ततः पिता निजां सम्पत्तिं विभज्य ताभ्यां ददौ।</para>
  <para style="p">
    <verse number="13" style="v"/>कतिपयात् कालात् परं स कनिष्ठपुत्रः समस्तं धनं संगृह्य दूरदेशं गत्वा दुष्टाचरणेन सर्व्वां सम्पत्तिं नाशयामास।</para>
  <para style="p">
    <verse number="14" style="v"/>तस्य सर्व्वधने व्ययं गते तद्देशे महादुर्भिक्षं बभूव, ततस्तस्य दैन्यदशा भवितुम् आरेभे।</para>
  <para style="p">
    <verse number="15" style="v"/>ततः परं स गत्वा तद्देशीयं गृहस्थमेकम् आश्रयत; ततः सतं शूकरव्रजं चारयितुं प्रान्तरं प्रेषयामास।</para>
  <para style="p">
    <verse number="16" style="v"/>केनापि तस्मै भक्ष्यादानात् स शूकरफलवल्कलेन पिचिण्डपूरणां ववाञ्छ।</para>
  <para style="p">
    <verse number="17" style="v"/>शेषे स मनसि चेतनां प्राप्य कथयामास, हा मम पितुः समीपे कति कति वेतनभुजो दासा यथेष्टं ततोधिकञ्च भक्ष्यं प्राप्नुवन्ति किन्त्वहं क्षुधा मुमूर्षुः।</para>
  <para style="p">
    <verse number="18" style="v"/>अहमुत्थाय पितुः समीपं गत्वा कथामेतां वदिष्यामि, हे पितर् ईश्वरस्य तव च विरुद्धं पापमकरवम्</para>
  <para style="p">
    <verse number="19" style="v"/>तव पुत्रइति विख्यातो भवितुं न योग्योस्मि च, मां तव वैतनिकं दासं कृत्वा स्थापय।</para>
  <para style="p">
    <verse number="20" style="v"/>पश्चात् स उत्थाय पितुः समीपं जगाम; ततस्तस्य पितातिदूरे तं निरीक्ष्य दयाञ्चक्रे, धावित्वा तस्य कण्ठं गृहीत्वा तं चुचुम्ब च।</para>
  <para style="p">
    <verse number="21" style="v"/>तदा पुत्र उवाच, हे पितर् ईश्वरस्य तव च विरुद्धं पापमकरवं, तव पुत्रइति विख्यातो भवितुं न योग्योस्मि च।</para>
  <para style="p">
    <verse number="22" style="v"/>किन्तु तस्य पिता निजदासान् आदिदेश, सर्व्वोत्तमवस्त्राण्यानीय परिधापयतैनं हस्ते चाङ्गुरीयकम् अर्पयत पादयोश्चोपानहौ समर्पयत;</para>
  <para style="p">
    <verse number="23" style="v"/>पुष्टं गोवत्सम् आनीय मारयत च तं भुक्त्वा वयम् आनन्दाम।</para>
  <para style="p">
    <verse number="24" style="v"/>यतो मम पुत्रोयम् अम्रियत पुनरजीवीद् हारितश्च लब्धोभूत् ततस्त आनन्दितुम् आरेभिरे।</para>
  <para style="p">
    <verse number="25" style="v"/>तत्काले तस्य ज्येष्ठः पुत्रः क्षेत्र आसीत्। अथ स निवेशनस्य निकटं आगच्छन् नृत्यानां वाद्यानाञ्च शब्दं श्रुत्वा</para>
  <para style="p">
    <verse number="26" style="v"/>दासानाम् एकम् आहूय पप्रच्छ, किं कारणमस्य?</para>
  <para style="p">
    <verse number="27" style="v"/>ततः सोवादीत्, तव भ्रातागमत्, तव तातश्च तं सुशरीरं प्राप्य पुष्टं गोवत्सं मारितवान्।</para>
  <para style="p">
    <verse number="28" style="v"/>ततः स प्रकुप्य निवेशनान्तः प्रवेष्टुं न सम्मेने; ततस्तस्य पिता बहिरागत्य तं साधयामास।</para>
  <para style="p">
    <verse number="29" style="v"/>ततः स पितरं प्रत्युवाच, पश्य तव काञ्चिदप्याज्ञां न विलंघ्य बहून् वत्सरान् अहं त्वां सेवे तथापि मित्रैः सार्द्धम् उत्सवं कर्त्तुं कदापि छागमेकमपि मह्यं नाददाः;</para>
  <para style="p">
    <verse number="30" style="v"/>किन्तु तव यः पुत्रो वेश्यागमनादिभिस्तव सम्पत्तिम् अपव्ययितवान् तस्मिन्नागतमात्रे तस्यैव निमित्तं पुष्टं गोवत्सं मारितवान्।</para>
  <para style="p">
    <verse number="31" style="v"/>तदा तस्य पितावोचत्, हे पुत्र त्वं सर्व्वदा मया सहासि तस्मान् मम यद्यदास्ते तत्सर्व्वं तव।</para>
  <para style="p">
    <verse number="32" style="v"/>किन्तु तवायं भ्राता मृतः पुनरजीवीद् हारितश्च भूत्वा प्राप्तोभूत्, एतस्मात् कारणाद् उत्सवानन्दौ कर्त्तुम् उचितमस्माकम्।</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अपरञ्च यीशुः शिष्येभ्योन्यामेकां कथां कथयामास कस्यचिद् धनवतो मनुष्यस्य गृहकार्य्याधीशे सम्पत्तेरपव्ययेऽपवादिते सति</para>
  <para style="p">
    <verse number="2" style="v"/>तस्य प्रभुस्तम् आहूय जगाद, त्वयि यामिमां कथां शृणोमि सा कीदृशी? त्वं गृहकार्य्याधीशकर्म्मणो गणनां दर्शय गृहकार्य्याधीशपदे त्वं न स्थास्यसि।</para>
  <para style="p">
    <verse number="3" style="v"/>तदा स गृहकार्य्याधीशो मनसा चिन्तयामास, प्रभु र्यदि मां गृहकार्य्याधीशपदाद् भ्रंशयति तर्हि किं करिष्येऽहं? मृदं खनितुं मम शक्ति र्नास्ति भिक्षितुञ्च लज्जिष्येऽहं।</para>
  <para style="p">
    <verse number="4" style="v"/>अतएव मयि गृहकार्य्याधीशपदात् च्युते सति यथा लोका मह्यम् आश्रयं दास्यन्ति तदर्थं यत्कर्म्म मया करणीयं तन् निर्णीयते।</para>
  <para style="p">
    <verse number="5" style="v"/>पश्चात् स स्वप्रभोरेकैकम् अधमर्णम् आहूय प्रथमं पप्रच्छ, त्वत्तो मे प्रभुणा कति प्राप्यम्?</para>
  <para style="p">
    <verse number="6" style="v"/>ततः स उवाच, एकशताढकतैलानि; तदा गृहकार्य्याधीशः प्रोवाच, तव पत्रमानीय शीघ्रमुपविश्य तत्र पञ्चाशतं लिख।</para>
  <para style="p">
    <verse number="7" style="v"/>पश्चादन्यमेकं पप्रच्छ, त्वत्तो मे प्रभुणा कति प्राप्यम्? ततः सोवादीद् एकशताढकगोधूमाः; तदा स कथयामास, तव पत्रमानीय अशीतिं लिख।</para>
  <para style="p">
    <verse number="8" style="v"/>तेनैव प्रभुस्तमयथार्थकृतम् अधीशं तद्बुद्धिनैपुण्यात् प्रशशंस; इत्थं दीप्तिरूपसन्तानेभ्य एतत्संसारस्य सन्ताना वर्त्तमानकालेऽधिकबुद्धिमन्तो भवन्ति।</para>
  <para style="p">
    <verse number="9" style="v"/>अतो वदामि यूयमप्ययथार्थेन धनेन मित्राणि लभध्वं ततो युष्मासु पदभ्रष्टेष्वपि तानि चिरकालम् आश्रयं दास्यन्ति।</para>
  <para style="p">
    <verse number="10" style="v"/>यः कश्चित् क्षुद्रे कार्य्ये विश्वास्यो भवति स महति कार्य्येपि विश्वास्यो भवति, किन्तु यः कश्चित् क्षुद्रे कार्य्येऽविश्वास्यो भवति स महति कार्य्येप्यविश्वास्यो भवति।</para>
  <para style="p">
    <verse number="11" style="v"/>अतएव अयथार्थेन धनेन यदि यूयमविश्वास्या जातास्तर्हि सत्यं धनं युष्माकं करेषु कः समर्पयिष्यति?</para>
  <para style="p">
    <verse number="12" style="v"/>यदि च परधनेन यूयम् अविश्वास्या भवथ तर्हि युष्माकं स्वकीयधनं युष्मभ्यं को दास्यति?</para>
  <para style="p">
    <verse number="13" style="v"/>कोपि दास उभौ प्रभू सेवितुं न शक्नोति, यत एकस्मिन् प्रीयमाणोऽन्यस्मिन्नप्रीयते यद्वा एकं जनं समादृत्य तदन्यं तुच्छीकरोति तद्वद् यूयमपि धनेश्वरौ सेवितुं न शक्नुथ।</para>
  <para style="p">
    <verse number="14" style="v"/>तदैताः सर्व्वाः कथाः श्रुत्वा लोभिफिरूशिनस्तमुपजहसुः।</para>
  <para style="p">
    <verse number="15" style="v"/>ततः स उवाच, यूयं मनुष्याणां निकटे स्वान् निर्दोषान् दर्शयथ किन्तु युष्माकम् अन्तःकरणानीश्वरो जानाति, यत् मनुष्याणाम् अति प्रशंस्यं तद् ईश्वरस्य घृण्यं।</para>
  <para style="p">
    <verse number="16" style="v"/>योहन आगमनपर्य्यनतं युष्माकं समीपे व्यवस्थाभविष्यद्वादिनां लेखनानि चासन् ततः प्रभृति ईश्वरराज्यस्य सुसंवादः प्रचरति, एकैको लोकस्तन्मध्यं यत्नेन प्रविशति च।</para>
  <para style="p">
    <verse number="17" style="v"/>वरं नभसः पृथिव्याश्च लोपो भविष्यति तथापि व्यवस्थाया एकबिन्दोरपि लोपो न भविष्यति।</para>
  <para style="p">
    <verse number="18" style="v"/>यः कश्चित् स्वीयां भार्य्यां विहाय स्त्रियमन्यां विवहति स परदारान् गच्छति, यश्च ता त्यक्तां नारीं विवहति सोपि परदारान गच्छति।</para>
  <para style="p">
    <verse number="19" style="v"/>एको धनी मनुष्यः शुक्लानि सूक्ष्माणि वस्त्राणि पर्य्यदधात् प्रतिदिनं परितोषरूपेणाभुंक्तापिवच्च।</para>
  <para style="p">
    <verse number="20" style="v"/>सर्व्वाङ्गे क्षतयुक्त इलियासरनामा कश्चिद् दरिद्रस्तस्य धनवतो भोजनपात्रात् पतितम् उच्छिष्टं भोक्तुं वाञ्छन् तस्य द्वारे पतित्वातिष्ठत्;</para>
  <para style="p">
    <verse number="21" style="v"/>अथ श्वान आगत्य तस्य क्षतान्यलिहन्।</para>
  <para style="p">
    <verse number="22" style="v"/>कियत्कालात्परं स दरिद्रः प्राणान् जहौ; ततः स्वर्गीयदूतास्तं नीत्वा इब्राहीमः क्रोड उपवेशयामासुः।</para>
  <para style="p">
    <verse number="23" style="v"/>पश्चात् स धनवानपि ममार, तं श्मशाने स्थापयामासुश्च; किन्तु परलोके स वेदनाकुलः सन् ऊर्द्ध्वां निरीक्ष्य बहुदूराद् इब्राहीमं तत्क्रोड इलियासरञ्च विलोक्य रुवन्नुवाच;</para>
  <para style="p">
    <verse number="24" style="v"/>हे पितर् इब्राहीम् अनुगृह्य अङ्गुल्यग्रभागं जले मज्जयित्वा मम जिह्वां शीतलां कर्त्तुम् इलियासरं प्रेरय, यतो वह्निशिखातोहं व्यथितोस्मि।</para>
  <para style="p">
    <verse number="25" style="v"/>तदा इब्राहीम् बभाषे, हे पुत्र त्वं जीवन् सम्पदं प्राप्तवान् इलियासरस्तु विपदं प्राप्तवान् एतत् स्मर, किन्तु सम्प्रति तस्य सुखं तव च दुःखं भवति।</para>
  <para style="p">
    <verse number="26" style="v"/>अपरमपि युष्माकम् अस्माकञ्च स्थानयो र्मध्ये महद्विच्छेदोऽस्ति तत एतत्स्थानस्य लोकास्तत् स्थानं यातुं यद्वा तत्स्थानस्य लोका एतत् स्थानमायातुं न शक्नुवन्ति।</para>
  <para style="p">
    <verse number="27" style="v"/>तदा स उक्तवान्, हे पितस्तर्हि त्वां निवेदयामि मम पितु र्गेहे ये मम पञ्च भ्रातरः सन्ति</para>
  <para style="p">
    <verse number="28" style="v"/>ते यथैतद् यातनास्थानं नायास्यन्ति तथा मन्त्रणां दातुं तेषां समीपम् इलियासरं प्रेरय।</para>
  <para style="p">
    <verse number="29" style="v"/>तत इब्राहीम् उवाच, मूसाभविष्यद्वादिनाञ्च पुस्तकानि तेषां निकटे सन्ति ते तद्वचनानि मन्यन्तां।</para>
  <para style="p">
    <verse number="30" style="v"/>तदा स निवेदयामास, हे पितर् इब्राहीम् न तथा, किन्तु यदि मृतलोकानां कश्चित् तेषां समीपं याति तर्हि ते मनांसि व्याघोटयिष्यन्ति।</para>
  <para style="p">
    <verse number="31" style="v"/>तत इब्राहीम् जगाद, ते यदि मूसाभविष्यद्वादिनाञ्च वचनानि न मन्यन्ते तर्हि मृतलोकानां कस्मिंश्चिद् उत्थितेपि ते तस्य मन्त्रणां न मंस्यन्ते।</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>इतः परं यीशुः शिष्यान् उवाच, विघ्नैरवश्यम् आगन्तव्यं किन्तु विघ्ना येन घटिष्यन्ते तस्य दुर्गति र्भविष्यति।</para>
  <para style="p">
    <verse number="2" style="v"/>एतेषां क्षुद्रप्राणिनाम् एकस्यापि विघ्नजननात् कण्ठबद्धपेषणीकस्य तस्य सागरागाधजले मज्जनं भद्रं।</para>
  <para style="p">
    <verse number="3" style="v"/>यूयं स्वेषु सावधानास्तिष्ठत; तव भ्राता यदि तव किञ्चिद् अपराध्यति तर्हि तं तर्जय, तेन यदि मनः परिवर्त्तयति तर्हि तं क्षमस्व।</para>
  <para style="p">
    <verse number="4" style="v"/>पुनरेकदिनमध्ये यदि स तव सप्तकृत्वोऽपराध्यति किन्तु सप्तकृत्व आगत्य मनः परिवर्त्य मयापराद्धम् इति वदति तर्हि तं क्षमस्व।</para>
  <para style="p">
    <verse number="5" style="v"/>तदा प्रेरिताः प्रभुम् अवदन् अस्माकं विश्वासं वर्द्धय।</para>
  <para style="p">
    <verse number="6" style="v"/>प्रभुरुवाच, यदि युष्माकं सर्षपैकप्रमाणो विश्वासोस्ति तर्हि त्वं समूलमुत्पाटितो भूत्वा समुद्रे रोपितो भव कथायाम् एतस्याम् एतदुडुम्बराय कथितायां स युष्माकमाज्ञावहो भविष्यति।</para>
  <para style="p">
    <verse number="7" style="v"/>अपरं स्वदासे हलं वाहयित्वा वा पशून् चारयित्वा क्षेत्राद् आगते सति तं वदति, एहि भोक्तुमुपविश, युष्माकम् एतादृशः कोस्ति?</para>
  <para style="p">
    <verse number="8" style="v"/>वरञ्च पूर्व्वं मम खाद्यमासाद्य यावद् भुञ्जे पिवामि च तावद् बद्धकटिः परिचर पश्चात् त्वमपि भोक्ष्यसे पास्यसि च कथामीदृशीं किं न वक्ष्यति?</para>
  <para style="p">
    <verse number="9" style="v"/>तेन दासेन प्रभोराज्ञानुरूपे कर्म्मणि कृते प्रभुः किं तस्मिन् बाधितो जातः? नेत्थं बुध्यते मया।</para>
  <para style="p">
    <verse number="10" style="v"/>इत्थं निरूपितेषु सर्व्वकर्म्मसु कृतेषु सत्मु यूयमपीदं वाक्यं वदथ, वयम् अनुपकारिणो दासा अस्माभिर्यद्यत्कर्त्तव्यं तन्मात्रमेव कृतं।</para>
  <para style="p">
    <verse number="11" style="v"/>स यिरूशालमि यात्रां कुर्व्वन् शोमिरोण्गालील्प्रदेशमध्येन गच्छति,</para>
  <para style="p">
    <verse number="12" style="v"/>एतर्हि कुत्रचिद् ग्रामे प्रवेशमात्रे दशकुष्ठिनस्तं साक्षात् कृत्वा</para>
  <para style="p">
    <verse number="13" style="v"/>दूरे तिष्ठनत उच्चै र्वक्तुमारेभिरे, हे प्रभो यीशो दयस्वास्मान्।</para>
  <para style="p">
    <verse number="14" style="v"/>ततः स तान् दृष्ट्वा जगाद, यूयं याजकानां समीपे स्वान् दर्शयत, ततस्ते गच्छन्तो रोगात् परिष्कृताः।</para>
  <para style="p">
    <verse number="15" style="v"/>तदा तेषामेकः स्वं स्वस्थं दृष्ट्वा प्रोच्चैरीश्वरं धन्यं वदन् व्याघुट्यायातो यीशो र्गुणाननुवदन् तच्चरणाधोभूमौ पपात;</para>
  <para style="p">
    <verse number="16" style="v"/>स चासीत् शोमिरोणी।</para>
  <para style="p">
    <verse number="17" style="v"/>तदा यीशुरवदत्, दशजनाः किं न परिष्कृताः? तह्यन्ये नवजनाः कुत्र?</para>
  <para style="p">
    <verse number="18" style="v"/>ईश्वरं धन्यं वदन्तम् एनं विदेशिनं विना कोप्यन्यो न प्राप्यत।</para>
  <para style="p">
    <verse number="19" style="v"/>तदा स तमुवाच, त्वमुत्थाय याहि विश्वासस्ते त्वां स्वस्थं कृतवान्।</para>
  <para style="p">
    <verse number="20" style="v"/>अथ कदेश्वरस्य राजत्वं भविष्यतीति फिरूशिभिः पृष्टे स प्रत्युवाच, ईश्वरस्य राजत्वम् ऐश्वर्य्यदर्शनेन न भविष्यति।</para>
  <para style="p">
    <verse number="21" style="v"/>अत एतस्मिन् पश्य तस्मिन् वा पश्य, इति वाक्यं लोका वक्तुं न शक्ष्यन्ति, ईश्वरस्य राजत्वं युष्माकम् अन्तरेवास्ते।</para>
  <para style="p">
    <verse number="22" style="v"/>ततः स शिष्यान् जगाद, यदा युष्माभि र्मनुजसुतस्य दिनमेकं द्रष्टुम् वाञ्छिष्यते किन्तु न दर्शिष्यते, ईदृक्काल आयाति।</para>
  <para style="p">
    <verse number="23" style="v"/>तदात्र पश्य वा तत्र पश्येति वाक्यं लोका वक्ष्यन्ति, किन्तु तेषां पश्चात् मा यात, मानुगच्छत च।</para>
  <para style="p">
    <verse number="24" style="v"/>यतस्तडिद् यथाकाशैकदिश्युदिय तदन्यामपि दिशं व्याप्य प्रकाशते तद्वत् निजदिने मनुजसूनुः प्रकाशिष्यते।</para>
  <para style="p">
    <verse number="25" style="v"/>किन्तु तत्पूर्व्वं तेनानेकानि दुःखानि भोक्तव्यान्येतद्वर्त्तमानलोकैश्च सोऽवज्ञातव्यः।</para>
  <para style="p">
    <verse number="26" style="v"/>नोहस्य विद्यमानकाले यथाभवत् मनुष्यसूनोः कालेपि तथा भविष्यति।</para>
  <para style="p">
    <verse number="27" style="v"/>यावत्कालं नोहो महापोतं नारोहद् आप्लाविवार्य्येत्य सर्व्वं नानाशयच्च तावत्कालं यथा लोका अभुञ्जतापिवन् व्यवहन् व्यवाहयंश्च;</para>
  <para style="p">
    <verse number="28" style="v"/>इत्थं लोटो वर्त्तमानकालेपि यथा लोका भोजनपानक्रयविक्रयरोपणगृहनिर्म्माणकर्म्मसु प्रावर्त्तन्त,</para>
  <para style="p">
    <verse number="29" style="v"/>किन्तु यदा लोट् सिदोमो निर्जगाम तदा नभसः सगन्धकाग्निवृष्टि र्भूत्वा सर्व्वं व्यनाशयत्</para>
  <para style="p">
    <verse number="30" style="v"/>तद्वन् मानवपुत्रप्रकाशदिनेपि भविष्यति।</para>
  <para style="p">
    <verse number="31" style="v"/>तदा यदि कश्चिद् गृहोपरि तिष्ठति तर्हि स गृहमध्यात् किमपि द्रव्यमानेतुम् अवरुह्य नैतु; यश्च क्षेत्रे तिष्ठति सोपि व्याघुट्य नायातु।</para>
  <para style="p">
    <verse number="32" style="v"/>लोटः पत्नीं स्मरत।</para>
  <para style="p">
    <verse number="33" style="v"/>यः प्राणान् रक्षितुं चेष्टिष्यते स प्राणान् हारयिष्यति यस्तु प्राणान् हारयिष्यति सएव प्राणान् रक्षिष्यति।</para>
  <para style="p">
    <verse number="34" style="v"/>युष्मानहं वच्मि तस्यां रात्रौ शय्यैकगतयो र्लोकयोरेको धारिष्यते परस्त्यक्ष्यते।</para>
  <para style="p">
    <verse number="35" style="v"/>स्त्रियौ युगपत् पेषणीं व्यावर्त्तयिष्यतस्तयोरेका धारिष्यते परात्यक्ष्यते।</para>
  <para style="p">
    <verse number="36" style="v"/>पुरुषौ क्षेत्रे स्थास्यतस्तयोरेको धारिष्यते परस्त्यक्ष्यते।</para>
  <para style="p">
    <verse number="37" style="v"/>तदा ते पप्रच्छुः, हे प्रभो कुत्रेत्थं भविष्यति? ततः स उवाच, यत्र शवस्तिष्ठति तत्र गृध्रा मिलन्ति।</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अपरञ्च लोकैरक्लान्तै र्निरन्तरं प्रार्थयितव्यम् इत्याशयेन यीशुना दृष्टान्त एकः कथितः।</para>
  <para style="p">
    <verse number="2" style="v"/>कुत्रचिन्नगरे कश्चित् प्राड्विवाक आसीत् स ईश्वरान्नाबिभेत् मानुषांश्च नामन्यत।</para>
  <para style="p">
    <verse number="3" style="v"/>अथ तत्पुरवासिनी काचिद्विधवा तत्समीपमेत्य विवादिना सह मम विवादं परिष्कुर्व्विति निवेदयामास।</para>
  <para style="p">
    <verse number="4" style="v"/>ततः स प्राड्विवाकः कियद्दिनानि न तदङ्गीकृतवान् पश्चाच्चित्ते चिन्तयामास, यद्यपीश्वरान्न बिभेमि मनुष्यानपि न मन्ये</para>
  <para style="p">
    <verse number="5" style="v"/>तथाप्येषा विधवा मां क्लिश्नाति तस्मादस्या विवादं परिष्करिष्यामि नोचेत् सा सदागत्य मां व्यग्रं करिष्यति।</para>
  <para style="p">
    <verse number="6" style="v"/>पश्चात् प्रभुरवदद् असावन्यायप्राड्विवाको यदाह तत्र मनो निधध्वं।</para>
  <para style="p">
    <verse number="7" style="v"/>ईश्वरस्य ये ऽभिरुचितलोका दिवानिशं प्रार्थयन्ते स बहुदिनानि विलम्ब्यापि तेषां विवादान् किं न परिष्करिष्यति?</para>
  <para style="p">
    <verse number="8" style="v"/>युष्मानहं वदामि त्वरया परिष्करिष्यति, किन्तु यदा मनुष्यपुत्र आगमिष्यति तदा पृथिव्यां किमीदृशं विश्वासं प्राप्स्यति?</para>
  <para style="p">
    <verse number="9" style="v"/>ये स्वान् धार्म्मिकान् ज्ञात्वा परान् तुच्छीकुर्व्वन्ति एतादृग्भ्यः, कियद्भ्य इमं दृष्टान्तं कथयामास।</para>
  <para style="p">
    <verse number="10" style="v"/>एकः फिरूश्यपरः करसञ्चायी द्वाविमौ प्रार्थयितुं मन्दिरं गतौ।</para>
  <para style="p">
    <verse number="11" style="v"/>ततोऽसौ फिरूश्येकपार्श्वे तिष्ठन् हे ईश्वर अहमन्यलोकवत् लोठयितान्यायी पारदारिकश्च न भवामि अस्य करसञ्चायिनस्तुल्यश्च न, तस्मात्त्वां धन्यं वदामि।</para>
  <para style="p">
    <verse number="12" style="v"/>सप्तसु दिनेषु दिनद्वयमुपवसामि सर्व्वसम्पत्ते र्दशमांशं ददामि च, एतत्कथां कथयन् प्रार्थयामास।</para>
  <para style="p">
    <verse number="13" style="v"/>किन्तु स करसञ्चायि दूरे तिष्ठन् स्वर्गं द्रष्टुं नेच्छन् वक्षसि कराघातं कुर्व्वन् हे ईश्वर पापिष्ठं मां दयस्व, इत्थं प्रार्थयामास।</para>
  <para style="p">
    <verse number="14" style="v"/>युष्मानहं वदामि, तयोर्द्वयो र्मध्ये केवलः करसञ्चायी पुण्यवत्त्वेन गणितो निजगृहं जगाम, यतो यः कश्चित् स्वमुन्नमयति स नामयिष्यते किन्तु यः कश्चित् स्वं नमयति स उन्नमयिष्यते।</para>
  <para style="p">
    <verse number="15" style="v"/>अथ शिशूनां गात्रस्पर्शार्थं लोकास्तान् तस्य समीपमानिन्युः शिष्यास्तद् दृष्ट्वानेतृन् तर्जयामासुः,</para>
  <para style="p">
    <verse number="16" style="v"/>किन्तु यीशुस्तानाहूय जगाद, मन्निकटम् आगन्तुं शिशून् अनुजानीध्वं तांश्च मा वारयत; यत ईश्वरराज्याधिकारिण एषां सदृशाः।</para>
  <para style="p">
    <verse number="17" style="v"/>अहं युष्मान् यथार्थं वदामि, यो जनः शिशोः सदृशो भूत्वा ईश्वरराज्यं न गृह्लाति स केनापि प्रकारेण तत् प्रवेष्टुं न शक्नोति।</para>
  <para style="p">
    <verse number="18" style="v"/>अपरम् एकोधिपतिस्तं पप्रच्छ, हे परमगुरो, अनन्तायुषः प्राप्तये मया किं कर्त्तव्यं?</para>
  <para style="p">
    <verse number="19" style="v"/>यीशुरुवाच, मां कुतः परमं वदसि? ईश्वरं विना कोपि परमो न भवति।</para>
  <para style="p">
    <verse number="20" style="v"/>परदारान् मा गच्छ, नरं मा जहि, मा चोरय, मिथ्यासाक्ष्यं मा देहि, मातरं पितरञ्च संमन्यस्व, एता या आज्ञाः सन्ति तास्त्वं जानासि।</para>
  <para style="p">
    <verse number="21" style="v"/>तदा स उवाच, बाल्यकालात् सर्व्वा एता आचरामि।</para>
  <para style="p">
    <verse number="22" style="v"/>इति कथां श्रुत्वा यीशुस्तमवदत्, तथापि तवैकं कर्म्म न्यूनमास्ते, निजं सर्व्वस्वं विक्रीय दरिद्रेभ्यो वितर, तस्मात् स्वर्गे धनं प्राप्स्यसि; तत आगत्य ममानुगामी भव।</para>
  <para style="p">
    <verse number="23" style="v"/>किन्त्वेतां कथां श्रुत्वा सोधिपतिः शुशोच, यतस्तस्य बहुधनमासीत्।</para>
  <para style="p">
    <verse number="24" style="v"/>तदा यीशुस्तमतिशोकान्वितं दृष्ट्वा जगाद, धनवताम् ईश्वरराज्यप्रवेशः कीदृग् दुष्करः।</para>
  <para style="p">
    <verse number="25" style="v"/>ईश्वरराज्ये धनिनः प्रवेशात् सूचेश्छिद्रेण महाङ्गस्य गमनागमने सुकरे।</para>
  <para style="p">
    <verse number="26" style="v"/>श्रोतारः पप्रच्छुस्तर्हि केन परित्राणं प्राप्स्यते?</para>
  <para style="p">
    <verse number="27" style="v"/>स उक्तवान्, यन् मानुषेणाशक्यं तद् ईश्वरेण शक्यं।</para>
  <para style="p">
    <verse number="28" style="v"/>तदा पितर उवाच, पश्य वयं सर्व्वस्वं परित्यज्य तव पश्चाद्गामिनोऽभवाम।</para>
  <para style="p">
    <verse number="29" style="v"/>ततः स उवाच, युष्मानहं यथार्थं वदामि, ईश्वरराज्यार्थं गृहं पितरौ भ्रातृगणं जायां सन्तानांश्च त्यक्तवा</para>
  <para style="p">
    <verse number="30" style="v"/>इह काले ततोऽधिकं परकाले ऽनन्तायुश्च न प्राप्स्यति लोक ईदृशः कोपि नास्ति।</para>
  <para style="p">
    <verse number="31" style="v"/>अनन्तरं स द्वादशशिष्यानाहूय बभाषे, पश्यत वयं यिरूशालम्नगरं यामः, तस्मात् मनुष्यपुत्रे भविष्यद्वादिभिरुक्तं यदस्ति तदनुरूपं तं प्रति घटिष्यते;</para>
  <para style="p">
    <verse number="32" style="v"/>वस्तुतस्तु सोऽन्यदेशीयानां हस्तेषु समर्पयिष्यते, ते तमुपहसिष्यन्ति, अन्यायमाचरिष्यन्ति तद्वपुषि निष्ठीवं निक्षेप्स्यन्ति, कशाभिः प्रहृत्य तं हनिष्यन्ति च,</para>
  <para style="p">
    <verse number="33" style="v"/>किन्तु तृतीयदिने स श्मशानाद् उत्थास्यति।</para>
  <para style="p">
    <verse number="34" style="v"/>एतस्याः कथाया अभिप्रायं किञ्चिदपि ते बोद्धुं न शेकुः तेषां निकटेऽस्पष्टतवात् तस्यैतासां कथानाम् आशयं ते ज्ञातुं न शेकुश्च।</para>
  <para style="p">
    <verse number="35" style="v"/>अथ तस्मिन् यिरीहोः पुरस्यान्तिकं प्राप्ते कश्चिदन्धः पथः पार्श्व उपविश्य भिक्षाम् अकरोत्</para>
  <para style="p">
    <verse number="36" style="v"/>स लोकसमूहस्य गमनशब्दं श्रुत्वा तत्कारणं पृष्टवान्।</para>
  <para style="p">
    <verse number="37" style="v"/>नासरतीययीशुर्यातीति लोकैरुक्ते स उच्चैर्वक्तुमारेभे,</para>
  <para style="p">
    <verse number="38" style="v"/>हे दायूदः सन्तान यीशो मां दयस्व।</para>
  <para style="p">
    <verse number="39" style="v"/>ततोग्रगामिनस्तं मौनी तिष्ठेति तर्जयामासुः किन्तु स पुनारुवन् उवाच, हे दायूदः सन्तान मां दयस्व।</para>
  <para style="p">
    <verse number="40" style="v"/>तदा यीशुः स्थगितो भूत्वा स्वान्तिके तमानेतुम् आदिदेश।</para>
  <para style="p">
    <verse number="41" style="v"/>ततः स तस्यान्तिकम् आगमत्, तदा स तं पप्रच्छ, त्वं किमिच्छसि? त्वदर्थमहं किं करिष्यामि? स उक्तवान्, हे प्रभोऽहं द्रष्टुं लभै।</para>
  <para style="p">
    <verse number="42" style="v"/>तदा यीशुरुवाच, दृष्टिशक्तिं गृहाण तव प्रत्ययस्त्वां स्वस्थं कृतवान्।</para>
  <para style="p">
    <verse number="43" style="v"/>ततस्तत्क्षणात् तस्य चक्षुषी प्रसन्ने; तस्मात् स ईश्वरं धन्यं वदन् तत्पश्चाद् ययौ, तदालोक्य सर्व्वे लोका ईश्वरं प्रशंसितुम् आरेभिरे।</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>यदा यीशु र्यिरीहोपुरं प्रविश्य तन्मध्येन गच्छंस्तदा</para>
  <para style="p">
    <verse number="2" style="v"/>सक्केयनामा करसञ्चायिनां प्रधानो धनवानेको</para>
  <para style="p">
    <verse number="3" style="v"/>यीशुः कीदृगिति द्रष्टुं चेष्टितवान् किन्तु खर्व्वत्वाल्लोकसंघमध्ये तद्दर्शनमप्राप्य</para>
  <para style="p">
    <verse number="4" style="v"/>येन पथा स यास्यति तत्पथेऽग्रे धावित्वा तं द्रष्टुम् उडुम्बरतरुमारुरोह।</para>
  <para style="p">
    <verse number="5" style="v"/>पश्चाद् यीशुस्तत्स्थानम् इत्वा ऊर्द्ध्वं विलोक्य तं दृष्ट्वावादीत्, हे सक्केय त्वं शीघ्रमवरोह मयाद्य त्वद्गेहे वस्तव्यं।</para>
  <para style="p">
    <verse number="6" style="v"/>ततः स शीघ्रमवरुह्य साह्लादं तं जग्राह।</para>
  <para style="p">
    <verse number="7" style="v"/>तद् दृष्ट्वा सर्व्वे विवदमाना वक्तुमारेभिरे, सोतिथित्वेन दुष्टलोकगृहं गच्छति।</para>
  <para style="p">
    <verse number="8" style="v"/>किन्तु सक्केयो दण्डायमानो वक्तुमारेभे, हे प्रभो पश्य मम या सम्पत्तिरस्ति तदर्द्धं दरिद्रेभ्यो ददे, अपरम् अन्यायं कृत्वा कस्मादपि यदि कदापि किञ्चित् मया गृहीतं तर्हि तच्चतुर्गुणं ददामि।</para>
  <para style="p">
    <verse number="9" style="v"/>तदा यीशुस्तमुक्तवान् अयमपि इब्राहीमः सन्तानोऽतः कारणाद् अद्यास्य गृहे त्राणमुपस्थितं।</para>
  <para style="p">
    <verse number="10" style="v"/>यद् हारितं तत् मृगयितुं रक्षितुञ्च मनुष्यपुत्र आगतवान्।</para>
  <para style="p">
    <verse number="11" style="v"/>अथ स यिरूशालमः समीप उपातिष्ठद् ईश्वरराजत्वस्यानुष्ठानं तदैव भविष्यतीति लोकैरन्वभूयत, तस्मात् स श्रोतृभ्यः पुनर्दृष्टान्तकथाम् उत्थाप्य कथयामास।</para>
  <para style="p">
    <verse number="12" style="v"/>कोपि महाल्लोको निजार्थं राजत्वपदं गृहीत्वा पुनरागन्तुं दूरदेशं जगाम।</para>
  <para style="p">
    <verse number="13" style="v"/>यात्राकाले निजान् दशदासान् आहूय दशस्वर्णमुद्रा दत्त्वा ममागमनपर्य्यन्तं वाणिज्यं कुरुतेत्यादिदेश।</para>
  <para style="p">
    <verse number="14" style="v"/>किन्तु तस्य प्रजास्तमवज्ञाय मनुष्यमेनम् अस्माकमुपरि राजत्वं न कारयिव्याम इमां वार्त्तां तन्निकटे प्रेरयामासुः।</para>
  <para style="p">
    <verse number="15" style="v"/>अथ स राजत्वपदं प्राप्यागतवान् एकैको जनो बाणिज्येन किं लब्धवान् इति ज्ञातुं येषु दासेषु मुद्रा अर्पयत् तान् आहूयानेतुम् आदिदेश।</para>
  <para style="p">
    <verse number="16" style="v"/>तदा प्रथम आगत्य कथितवान्, हे प्रभो तव तयैकया मुद्रया दशमुद्रा लब्धाः।</para>
  <para style="p">
    <verse number="17" style="v"/>ततः स उवाच त्वमुत्तमो दासः स्वल्पेन विश्वास्यो जात इतः कारणात् त्वं दशनगराणाम् अधिपो भव।</para>
  <para style="p">
    <verse number="18" style="v"/>द्वितीय आगत्य कथितवान्, हे प्रभो तवैकया मुद्रया पञ्चमुद्रा लब्धाः।</para>
  <para style="p">
    <verse number="19" style="v"/>ततः स उवाच, त्वं पञ्चानां नगराणामधिपति र्भव।</para>
  <para style="p">
    <verse number="20" style="v"/>ततोन्य आगत्य कथयामास, हे प्रभो पश्य तव या मुद्रा अहं वस्त्रे बद्ध्वास्थापयं सेयं।</para>
  <para style="p">
    <verse number="21" style="v"/>त्वं कृपणो यन्नास्थापयस्तदपि गृह्लासि, यन्नावपस्तदेव च छिनत्सि ततोहं त्वत्तो भीतः।</para>
  <para style="p">
    <verse number="22" style="v"/>तदा स जगाद, रे दुष्टदास तव वाक्येन त्वां दोषिणं करिष्यामि, यदहं नास्थापयं तदेव गृह्लामि, यदहं नावपञ्च तदेव छिनद्मि, एतादृशः कृपणोहमिति यदि त्वं जानासि,</para>
  <para style="p">
    <verse number="23" style="v"/>तर्हि मम मुद्रा बणिजां निकटे कुतो नास्थापयः? तया कृतेऽहम् आगत्य कुसीदेन सार्द्धं निजमुद्रा अप्राप्स्यम्।</para>
  <para style="p">
    <verse number="24" style="v"/>पश्चात् स समीपस्थान् जनान् आज्ञापयत् अस्मात् मुद्रा आनीय यस्य दशमुद्राः सन्ति तस्मै दत्त।</para>
  <para style="p">
    <verse number="25" style="v"/>ते प्रोचुः प्रभोऽस्य दशमुद्राः सन्ति।</para>
  <para style="p">
    <verse number="26" style="v"/>युष्मानहं वदामि यस्याश्रये वद्धते ऽधिकं तस्मै दायिष्यते, किन्तु यस्याश्रये न वर्द्धते तस्य यद्यदस्ति तदपि तस्मान् नायिष्यते।</para>
  <para style="p">
    <verse number="27" style="v"/>किन्तु ममाधिपतित्वस्य वशत्वे स्थातुम् असम्मन्यमाना ये मम रिपवस्तानानीय मम समक्षं संहरत।</para>
  <para style="p">
    <verse number="28" style="v"/>इत्युपदेशकथां कथयित्वा सोग्रगः सन् यिरूशालमपुरं ययौ।</para>
  <para style="p">
    <verse number="29" style="v"/>ततो बैत्फगीबैथनीयाग्रामयोः समीपे जैतुनाद्रेरन्तिकम् इत्वा शिष्यद्वयम् इत्युक्त्वा प्रेषयामास,</para>
  <para style="p">
    <verse number="30" style="v"/>युवाममुं सम्मुखस्थग्रामं प्रविश्यैव यं कोपि मानुषः कदापि नारोहत् तं गर्द्दभशावकं बद्धं द्रक्ष्यथस्तं मोचयित्वानयतं।</para>
  <para style="p">
    <verse number="31" style="v"/>तत्र कुतो मोचयथः? इति चेत् कोपि वक्ष्यति तर्हि वक्ष्यथः प्रभेारत्र प्रयोजनम् आस्ते।</para>
  <para style="p">
    <verse number="32" style="v"/>तदा तौ प्ररितौ गत्वा तत्कथाानुसारेण सर्व्वं प्राप्तौ।</para>
  <para style="p">
    <verse number="33" style="v"/>गर्दभशावकमोचनकाले तत्वामिन ऊचुः, गर्दभशावकं कुतो मोचयथः?</para>
  <para style="p">
    <verse number="34" style="v"/>तावूचतुः प्रभोरत्र प्रयोजनम् आस्ते।</para>
  <para style="p">
    <verse number="35" style="v"/>पश्चात् तौ तं गर्दभशावकं यीशोरन्तिकमानीय तत्पृष्ठे निजवसनानि पातयित्वा तदुपरि यीशुमारोहयामासतुः।</para>
  <para style="p">
    <verse number="36" style="v"/>अथ यात्राकाले लोकाः पथि स्ववस्त्राणि पातयितुम् आरेभिरे।</para>
  <para style="p">
    <verse number="37" style="v"/>अपरं जैतुनाद्रेरुपत्यकाम् इत्वा शिष्यसंघः पूर्व्वदृष्टानि महाकर्म्माणि स्मृत्वा,</para>
  <para style="p">
    <verse number="38" style="v"/>यो राजा प्रभो र्नाम्नायाति स धन्यः स्वर्गे कुशलं सर्व्वोच्चे जयध्वनि र्भवतु, कथामेतां कथयित्वा सानन्दम् उचैरीश्वरं धन्यं वक्तुमारेभे।</para>
  <para style="p">
    <verse number="39" style="v"/>तदा लोकारण्यमध्यस्थाः कियन्तः फिरूशिनस्तत् श्रुत्वा यीशुं प्रोचुः, हे उपदेशक स्वशिष्यान् तर्जय।</para>
  <para style="p">
    <verse number="40" style="v"/>स उवाच, युष्मानहं वदामि यद्यमी नीरवास्तिष्ठन्ति तर्हि पाषाणा उचैः कथाः कथयिष्यन्ति।</para>
  <para style="p">
    <verse number="41" style="v"/>पश्चात् तत्पुरान्तिकमेत्य तदवलोक्य साश्रुपातं जगाद,</para>
  <para style="p">
    <verse number="42" style="v"/>हा हा चेत् त्वमग्रेऽज्ञास्यथाः, तवास्मिन्नेव दिने वा यदि स्वमङ्गलम् उपालप्स्यथाः, तर्ह्युत्तमम् अभविष्यत्, किन्तु क्षणेस्मिन् तत्तव दृष्टेरगोचरम् भवति।</para>
  <para style="p">
    <verse number="43" style="v"/>त्वं स्वत्राणकाले न मनो न्यधत्था इति हेतो र्यत्काले तव रिपवस्त्वां चतुर्दिक्षु प्राचीरेण वेष्टयित्वा रोत्स्यन्ति</para>
  <para style="p">
    <verse number="44" style="v"/>बालकैः सार्द्धं भूमिसात् करिष्यन्ति च त्वन्मध्ये पाषाणैकोपि पाषाणोपरि न स्थास्यति च, काल ईदृश उपस्थास्यति।</para>
  <para style="p">
    <verse number="45" style="v"/>अथ मध्येमन्दिरं प्रविश्य तत्रत्यान् क्रयिविक्रयिणो बहिष्कुर्व्वन्</para>
  <para style="p">
    <verse number="46" style="v"/>अवदत् मद्गृहं प्रार्थनागृहमिति लिपिरास्ते किन्तु यूयं तदेव चैराणां गह्वरं कुरुथ।</para>
  <para style="p">
    <verse number="47" style="v"/>पश्चात् स प्रत्यहं मध्येमन्दिरम् उपदिदेश; ततः प्रधानयाजका अध्यापकाः प्राचीनाश्च तं नाशयितुं चिचेष्टिरे;</para>
  <para style="p">
    <verse number="48" style="v"/>किन्तु तदुपदेशे सर्व्वे लोका निविष्टचित्ताः स्थितास्तस्मात् ते तत्कर्त्तुं नावकाशं प्रापुः।</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अथैकदा यीशु र्मनिदरे सुसंवादं प्रचारयन् लोकानुपदिशति, एतर्हि प्रधानयाजका अध्यापकाः प्राञ्चश्च तन्निकटमागत्य पप्रच्छुः</para>
  <para style="p">
    <verse number="2" style="v"/>कयाज्ञया त्वं कर्म्माण्येतानि करोषि? को वा त्वामाज्ञापयत्? तदस्मान् वद।</para>
  <para style="p">
    <verse number="3" style="v"/>स प्रत्युवाच, तर्हि युष्मानपि कथामेकां पृच्छामि तस्योत्तरं वदत।</para>
  <para style="p">
    <verse number="4" style="v"/>योहनो मज्जनम् ईश्वरस्य मानुषाणां वाज्ञातो जातं?</para>
  <para style="p">
    <verse number="5" style="v"/>ततस्ते मिथो विविच्य जगदुः, यदीश्वरस्य वदामस्तर्हि तं कुतो न प्रत्यैत स इति वक्ष्यति।</para>
  <para style="p">
    <verse number="6" style="v"/>यदि मनुष्यस्येति वदामस्तर्हि सर्व्वे लोका अस्मान् पाषाणै र्हनिष्यन्ति यतो योहन् भविष्यद्वादीति सर्व्वे दृढं जानन्ति।</para>
  <para style="p">
    <verse number="7" style="v"/>अतएव ते प्रत्यूचुः कस्याज्ञया जातम् इति वक्तुं न शक्नुमः।</para>
  <para style="p">
    <verse number="8" style="v"/>तदा यीशुरवदत् तर्हि कयाज्ञया कर्म्माण्येताति करोमीति च युष्मान् न वक्ष्यामि।</para>
  <para style="p">
    <verse number="9" style="v"/>अथ लोकानां साक्षात् स इमां दृष्टान्तकथां वक्तुमारेभे, कश्चिद् द्राक्षाक्षेत्रं कृत्वा तत् क्षेत्रं कृषीवलानां हस्तेषु समर्प्य बहुकालार्थं दूरदेशं जगाम।</para>
  <para style="p">
    <verse number="10" style="v"/>अथ फलकाले फलानि ग्रहीतु कृषीवलानां समीपे दासं प्राहिणोत् किन्तु कृषीवलास्तं प्रहृत्य रिक्तहस्तं विससर्जुः।</para>
  <para style="p">
    <verse number="11" style="v"/>ततः सोधिपतिः पुनरन्यं दासं प्रेषयामास, ते तमपि प्रहृत्य कुव्यवहृत्य रिक्तहस्तं विससृजुः।</para>
  <para style="p">
    <verse number="12" style="v"/>ततः स तृतीयवारम् अन्यं प्राहिणोत् ते तमपि क्षताङ्गं कृत्वा बहि र्निचिक्षिपुः।</para>
  <para style="p">
    <verse number="13" style="v"/>तदा क्षेत्रपति र्विचारयामास, ममेदानीं किं कर्त्तव्यं? मम प्रिये पुत्रे प्रहिते ते तमवश्यं दृष्ट्वा समादरिष्यन्ते।</para>
  <para style="p">
    <verse number="14" style="v"/>किन्तु कृषीवलास्तं निरीक्ष्य परस्परं विविच्य प्रोचुः, अयमुत्तराधिकारी आगच्छतैनं हन्मस्ततोधिकारोस्माकं भविष्यति।</para>
  <para style="p">
    <verse number="15" style="v"/>ततस्ते तं क्षेत्राद् बहि र्निपात्य जघ्नुस्तस्मात् स क्षेत्रपतिस्तान् प्रति किं करिष्यति?</para>
  <para style="p">
    <verse number="16" style="v"/>स आगत्य तान् कृषीवलान् हत्वा परेषां हस्तेषु तत्क्षेत्रं समर्पयिष्यति; इति कथां श्रुत्वा ते ऽवदन् एतादृशी घटना न भवतु।</para>
  <para style="p">
    <verse number="17" style="v"/>किन्तु यीशुस्तानवलोक्य जगाद, तर्हि, स्थपतयः करिष्यन्ति ग्रावाणं यन्तु तुच्छकं। प्रधानप्रस्तरः कोणे स एव हि भविष्यति। एतस्य शास्त्रीयवचनस्य किं तात्पर्य्यं?</para>
  <para style="p">
    <verse number="18" style="v"/>अपरं तत्पाषाणोपरि यः पतिष्यति स भंक्ष्यते किन्तु यस्योपरि स पाषाणः पतिष्यति स तेन धूलिवच् चूर्णीभविष्यति।</para>
  <para style="p">
    <verse number="19" style="v"/>सोस्माकं विरुद्धं दृष्टान्तमिमं कथितवान् इति ज्ञात्वा प्रधानयाजका अध्यापकाश्च तदैव तं धर्तुं ववाञ्छुः किन्तु लोकेभ्यो बिभ्युः।</para>
  <para style="p">
    <verse number="20" style="v"/>अतएव तं प्रति सतर्काः सन्तः कथं तद्वाक्यदोषं धृत्वा तं देशाधिपस्य साधुवेशधारिणश्चरान् तस्य समीपे प्रेषयामासुः।</para>
  <para style="p">
    <verse number="21" style="v"/>तदा ते तं पप्रच्छुः, हे उपदेशक भवान् यथार्थं कथयन् उपदिशति, कमप्यनपेक्ष्य सत्यत्वेनैश्वरं मार्गमुपदिशति, वयमेतज्जानीमः।</para>
  <para style="p">
    <verse number="22" style="v"/>कैसरराजाय करोस्माभि र्देयो न वा?</para>
  <para style="p">
    <verse number="23" style="v"/>स तेषां वञ्चनं ज्ञात्वावदत् कुतो मां परीक्षध्वे? मां मुद्रामेकं दर्शयत।</para>
  <para style="p">
    <verse number="24" style="v"/>इह लिखिता मूर्तिरियं नाम च कस्य? तेऽवदन् कैसरस्य।</para>
  <para style="p">
    <verse number="25" style="v"/>तदा स उवाच, तर्हि कैसरस्य द्रव्यं कैसराय दत्त; ईश्वरस्य तु द्रव्यमीश्वराय दत्त।</para>
  <para style="p">
    <verse number="26" style="v"/>तस्माल्लोकानां साक्षात् तत्कथायाः कमपि दोषं धर्तुमप्राप्य ते तस्योत्तराद् आश्चर्य्यं मन्यमाना मौनिनस्तस्थुः।</para>
  <para style="p">
    <verse number="27" style="v"/>अपरञ्च श्मशानादुत्थानानङ्गीकारिणां सिदूकिनां कियन्तो जना आगत्य तं पप्रच्छुः,</para>
  <para style="p">
    <verse number="28" style="v"/>हे उपदेशक शास्त्रे मूसा अस्मान् प्रतीति लिलेख यस्य भ्राता भार्य्यायां सत्यां निःसन्तानो म्रियते स तज्जायां विवह्य तद्वंशम् उत्पादयिष्यति।</para>
  <para style="p">
    <verse number="29" style="v"/>तथाच केचित् सप्त भ्रातर आसन् तेषां ज्येष्ठो भ्राता विवह्य निरपत्यः प्राणान् जहौ।</para>
  <para style="p">
    <verse number="30" style="v"/>अथ द्वितीयस्तस्य जायां विवह्य निरपत्यः सन् ममार। तृतीयश्च तामेव व्युवाह;</para>
  <para style="p">
    <verse number="31" style="v"/>इत्थं सप्त भ्रातरस्तामेव विवह्य निरपत्याः सन्तो मम्रुः।</para>
  <para style="p">
    <verse number="32" style="v"/>शेषे सा स्त्री च ममार।</para>
  <para style="p">
    <verse number="33" style="v"/>अतएव श्मशानादुत्थानकाले तेषां सप्तजनानां कस्य सा भार्य्या भविष्यति? यतः सा तेषां सप्तानामेव भार्य्यासीत्।</para>
  <para style="p">
    <verse number="34" style="v"/>तदा यीशुः प्रत्युवाच, एतस्य जगतो लोका विवहन्ति वाग्दत्ताश्च भवन्ति</para>
  <para style="p">
    <verse number="35" style="v"/>किन्तु ये तज्जगत्प्राप्तियोग्यत्वेन गणितां भविष्यन्ति श्मशानाच्चोत्थास्यन्ति ते न विवहन्ति वाग्दत्ताश्च न भवन्ति,</para>
  <para style="p">
    <verse number="36" style="v"/>ते पुन र्न म्रियन्ते किन्तु श्मशानादुत्थापिताः सन्त ईश्वरस्य सन्तानाः स्वर्गीयदूतानां सदृशाश्च भवन्ति।</para>
  <para style="p">
    <verse number="37" style="v"/>अधिकन्तु मूसाः स्तम्बोपाख्याने परमेश्वर ईब्राहीम ईश्वर इस्हाक ईश्वरो याकूबश्चेश्वर इत्युक्त्वा मृतानां श्मशानाद् उत्थानस्य प्रमाणं लिलेख।</para>
  <para style="p">
    <verse number="38" style="v"/>अतएव य ईश्वरः स मृतानां प्रभु र्न किन्तु जीवतामेव प्रभुः, तन्निकटे सर्व्वे जीवन्तः सन्ति।</para>
  <para style="p">
    <verse number="39" style="v"/>इति श्रुत्वा कियन्तोध्यापका ऊचुः, हे उपदेशक भवान् भद्रं प्रत्युक्तवान्।</para>
  <para style="p">
    <verse number="40" style="v"/>इतः परं तं किमपि प्रष्टं तेषां प्रगल्भता नाभूत्।</para>
  <para style="p">
    <verse number="41" style="v"/>पश्चात् स तान् उवाच, यः ख्रीष्टः स दायूदः सन्तान एतां कथां लोकाः कथं कथयन्ति?</para>
  <para style="p">
    <verse number="42" style="v"/>यतः मम प्रभुमिदं वाक्यमवदत् परमेश्वरः। तव शत्रूनहं यावत् पादपीठं करोमि न। तावत् कालं मदीये त्वं दक्षपार्श्व उपाविश।</para>
  <para style="p">
    <verse number="43" style="v"/>इति कथां दायूद् स्वयं गीतग्रन्थेऽवदत्।</para>
  <para style="p">
    <verse number="44" style="v"/>अतएव यदि दायूद् तं प्रभुं वदति, तर्हि स कथं तस्य सन्तानो भवति?</para>
  <para style="p">
    <verse number="45" style="v"/>पश्चाद् यीशुः सर्व्वजनानां कर्णगोचरे शिष्यानुवाच,</para>
  <para style="p">
    <verse number="46" style="v"/>येऽध्यापका दीर्घपरिच्छदं परिधाय भ्रमन्ति, हट्टापणयो र्नमस्कारे भजनगेहस्य प्रोच्चासने भोजनगृहस्य प्रधानस्थाने च प्रीयन्ते</para>
  <para style="p">
    <verse number="47" style="v"/>विधवानां सर्व्वस्वं ग्रसित्वा छलेन दीर्घकालं प्रार्थयन्ते च तेषु सावधाना भवत, तेषामुग्रदण्डो भविष्यति।</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अथ धनिलोका भाण्डागारे धनं निक्षिपन्ति स तदेव पश्यति,</para>
  <para style="p">
    <verse number="2" style="v"/>एतर्हि काचिद्दीना विधवा पणद्वयं निक्षिपति तद् ददर्श।</para>
  <para style="p">
    <verse number="3" style="v"/>ततो यीशुरुवाच युष्मानहं यथार्थं वदामि, दरिद्रेयं विधवा सर्व्वेभ्योधिकं न्यक्षेप्सीत्,</para>
  <para style="p">
    <verse number="4" style="v"/>यतोन्ये स्वप्राज्यधनेभ्य ईश्वराय किञ्चित् न्यक्षेप्सुः, किन्तु दरिद्रेयं विधवा दिनयापनार्थं स्वस्य यत् किञ्चित् स्थितं तत् सर्व्वं न्यक्षेप्सीत्।</para>
  <para style="p">
    <verse number="5" style="v"/>अपरञ्च उत्तमप्रस्तरैरुत्सृष्टव्यैश्च मन्दिरं सुशोभतेतरां कैश्चिदित्युक्ते स प्रत्युवाच</para>
  <para style="p">
    <verse number="6" style="v"/>यूयं यदिदं निचयनं पश्यथ, अस्य पाषाणैकोप्यन्यपाषाणोपरि न स्थास्यति, सर्व्वे भूसाद्भविष्यन्ति कालोयमायाति।</para>
  <para style="p">
    <verse number="7" style="v"/>तदा ते पप्रच्छुः, हे गुरो घटनेदृशी कदा भविष्यति? घटनाया एतस्यसश्चिह्नं वा किं भविष्यति?</para>
  <para style="p">
    <verse number="8" style="v"/>तदा स जगाद, सावधाना भवत यथा युष्माकं भ्रमं कोपि न जनयति, खीष्टोहमित्युक्त्वा मम नाम्रा बहव उपस्थास्यन्ति स कालः प्रायेणोपस्थितः, तेषां पश्चान्मा गच्छत।</para>
  <para style="p">
    <verse number="9" style="v"/>युद्धस्योपप्लवस्य च वार्त्तां श्रुत्वा मा शङ्कध्वं, यतः प्रथमम् एता घटना अवश्यं भविष्यन्ति किन्तु नापाते युगान्तो भविष्यति।</para>
  <para style="p">
    <verse number="10" style="v"/>अपरञ्च कथयामास, तदा देशस्य विपक्षत्वेन देशो राज्यस्य विपक्षत्वेन राज्यम् उत्थास्यति,</para>
  <para style="p">
    <verse number="11" style="v"/>नानास्थानेषु महाभूकम्पो दुर्भिक्षं मारी च भविष्यन्ति, तथा व्योममण्डलस्य भयङ्करदर्शनान्यश्चर्य्यलक्षणानि च प्रकाशयिष्यन्ते।</para>
  <para style="p">
    <verse number="12" style="v"/>किन्तु सर्व्वासामेतासां घटनानां पूर्व्वं लोका युष्मान् धृत्वा ताडयिष्यन्ति, भजनालये कारायाञ्च समर्पयिष्यन्ति मम नामकारणाद् युष्मान् भूपानां शासकानाञ्च सम्मुखं नेष्यन्ति च।</para>
  <para style="p">
    <verse number="13" style="v"/>साक्ष्यार्थम् एतानि युष्मान् प्रति घटिष्यन्ते।</para>
  <para style="p">
    <verse number="14" style="v"/>तदा किमुत्तरं वक्तव्यम् एतत् न चिन्तयिष्याम इति मनःसु निश्चितनुत।</para>
  <para style="p">
    <verse number="15" style="v"/>विपक्षा यस्मात् किमप्युत्तरम् आपत्तिञ्च कर्त्तुं न शक्ष्यन्ति तादृशं वाक्पटुत्वं ज्ञानञ्च युष्मभ्यं दास्यामि।</para>
  <para style="p">
    <verse number="16" style="v"/>किञ्च यूयं पित्रा मात्रा भ्रात्रा बन्धुना ज्ञात्या कुटुम्बेन च परकरेषु समर्पयिष्यध्वे; ततस्ते युष्माकं कञ्चन कञ्चन घातयिष्यन्ति।</para>
  <para style="p">
    <verse number="17" style="v"/>मम नाम्नः कारणात् सर्व्वै र्मनुष्यै र्यूयम् ऋतीयिष्यध्वे।</para>
  <para style="p">
    <verse number="18" style="v"/>किन्तु युष्माकं शिरःकेशैकोपि न विनंक्ष्यति,</para>
  <para style="p">
    <verse number="19" style="v"/>तस्मादेव धैर्य्यमवलम्ब्य स्वस्वप्राणान् रक्षत।</para>
  <para style="p">
    <verse number="20" style="v"/>अपरञ्च यिरूशालम्पुरं सैन्यवेष्टितं विलोक्य तस्योच्छिन्नतायाः समयः समीप इत्यवगमिष्यथ।</para>
  <para style="p">
    <verse number="21" style="v"/>तदा यिहूदादेशस्था लोकाः पर्व्वतं पलायन्तां, ये च नगरे तिष्ठन्ति ते देशान्तरं पलायन्ता, ये च ग्रामे तिष्ठन्ति ते नगरं न प्रविशन्तु,</para>
  <para style="p">
    <verse number="22" style="v"/>यतस्तदा समुचितदण्डनाय धर्म्मपुस्तके यानि सर्व्वाणि लिखितानि तानि सफलानि भविष्यन्ति।</para>
  <para style="p">
    <verse number="23" style="v"/>किन्तु या यास्तदा गर्भवत्यः स्तन्यदाव्यश्च तामां दुर्गति र्भविष्यति, यत एताल्लोकान् प्रति कोपो देशे च विषमदुर्गति र्घटिष्यते।</para>
  <para style="p">
    <verse number="24" style="v"/>वस्तुतस्तु ते खङ्गधारपरिव्वङ्गं लप्स्यन्ते बद्धाः सन्तः सर्व्वदेशेषु नायिष्यन्ते च किञ्चान्यदेशीयानां समयोपस्थितिपर्य्यन्तं यिरूशालम्पुरं तैः पदतलै र्दलयिष्यते।</para>
  <para style="p">
    <verse number="25" style="v"/>सूर्य्यचन्द्रनक्षत्रेषु लक्षणादि भविष्यन्ति, भुवि सर्व्वदेशीयानां दुःखं चिन्ता च सिन्धौ वीचीनां तर्जनं गर्जनञ्च भविष्यन्ति।</para>
  <para style="p">
    <verse number="26" style="v"/>भूभौ भाविघटनां चिन्तयित्वा मनुजा भियामृतकल्पा भविष्यन्ति, यतो व्योममण्डले तेजस्विनो दोलायमाना भविष्यन्ति।</para>
  <para style="p">
    <verse number="27" style="v"/>तदा पराक्रमेणा महातेजसा च मेघारूढं मनुष्यपुत्रम् आयान्तं द्रक्ष्यन्ति।</para>
  <para style="p">
    <verse number="28" style="v"/>किन्त्वेतासां घटनानामारम्भे सति यूयं मस्तकान्युत्तोल्य ऊर्दध्वं द्रक्ष्यथ, यतो युष्माकं मुक्तेः कालः सविधो भविष्यति।</para>
  <para style="p">
    <verse number="29" style="v"/>ततस्तेनैतदृष्टान्तकथा कथिता, पश्यत उडुम्बरादिवृक्षाणां</para>
  <para style="p">
    <verse number="30" style="v"/>नवीनपत्राणि जातानीति दृष्ट्वा निदावकाल उपस्थित इति यथा यूयं ज्ञातुं शक्नुथ,</para>
  <para style="p">
    <verse number="31" style="v"/>तथा सर्व्वासामासां घटनानाम् आरम्भे दृष्टे सतीश्वरस्य राजत्वं निकटम् इत्यपि ज्ञास्यथ।</para>
  <para style="p">
    <verse number="32" style="v"/>युष्मानहं यथार्थं वदामि, विद्यमानलोकानामेषां गमनात् पूर्व्वम् एतानि घटिष्यन्ते।</para>
  <para style="p">
    <verse number="33" style="v"/>नभोभुवोर्लोपो भविष्यति मम वाक् तु कदापि लुप्ता न भविष्यति।</para>
  <para style="p">
    <verse number="34" style="v"/>अतएव विषमाशनेन पानेन च सांमारिकचिन्ताभिश्च युष्माकं चित्तेषु मत्तेषु तद्दिनम् अकस्माद् युष्मान् प्रति यथा नोपतिष्ठति तदर्थं स्वेषु सावधानास्तिष्ठत।</para>
  <para style="p">
    <verse number="35" style="v"/>पृथिवीस्थसर्व्वलोकान् प्रति तद्दिनम् उन्माथ इव उपस्थास्यति।</para>
  <para style="p">
    <verse number="36" style="v"/>यथा यूयम् एतद्भाविघटना उत्तर्त्तुं मनुजसुतस्य सम्मुखे संस्थातुञ्च योग्या भवथ कारणादस्मात् सावधानाः सन्तो निरन्तरं प्रार्थयध्वं।</para>
  <para style="p">
    <verse number="37" style="v"/>अपरञ्च स दिवा मन्दिर उपदिश्य राचै जैतुनाद्रिं गत्वातिष्ठत्।</para>
  <para style="p">
    <verse number="38" style="v"/>ततः प्रत्यूषे लाकास्तत्कथां श्रोतुं मन्दिरे तदन्तिकम् आगच्छन्।</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अपरञ्च किण्वशून्यपूपोत्सवस्य काल उपस्थिते</para>
  <para style="p">
    <verse number="2" style="v"/>प्रधानयाजका अध्यायकाश्च यथा तं हन्तुं शक्नुवन्ति तथोपायाम् अचेष्टन्त किन्तु लोकेभ्यो बिभ्युः।</para>
  <para style="p">
    <verse number="3" style="v"/>एतस्तिन् समये द्वादशशिष्येषु गणित ईष्करियोतीयरूढिमान् यो यिहूदास्तस्यान्तःकरणं शैतानाश्रितत्वात्</para>
  <para style="p">
    <verse number="4" style="v"/>स गत्वा यथा यीशुं तेषां करेषु समर्पयितुं शक्नोति तथा मन्त्रणां प्रधानयाजकैः सेनापतिभिश्च सह चकार।</para>
  <para style="p">
    <verse number="5" style="v"/>तेन ते तुष्टास्तस्मै मुद्रां दातुं पणं चक्रुः।</para>
  <para style="p">
    <verse number="6" style="v"/>ततः सोङ्गीकृत्य यथा लोकानामगोचरे तं परकरेषु समर्पयितुं शक्नोति तथावकाशं चेष्टितुमारेभे।</para>
  <para style="p">
    <verse number="7" style="v"/>अथ किण्वशून्यपूपोत्मवदिने, अर्थात् यस्मिन् दिने निस्तारोत्सवस्य मेषो हन्तव्यस्तस्मिन् दिने</para>
  <para style="p">
    <verse number="8" style="v"/>यीशुः पितरं योहनञ्चाहूय जगाद, युवां गत्वास्माकं भोजनार्थं निस्तारोत्सवस्य द्रव्याण्यासादयतं।</para>
  <para style="p">
    <verse number="9" style="v"/>तदा तौ पप्रच्छतुः कुचासादयावो भवतः केच्छा?</para>
  <para style="p">
    <verse number="10" style="v"/>तदा सोवादीत्, नगरे प्रविष्टे कश्चिज्जलकुम्भमादाय युवां साक्षात् करिष्यति स यन्निवेशनं प्रविशति युवामपि तन्निवेशनं तत्पश्चादित्वा निवेशनपतिम् इति वाक्यं वदतं,</para>
  <para style="p">
    <verse number="11" style="v"/>यत्राहं निस्तारोत्सवस्य भोज्यं शिष्यैः सार्द्धं भोक्तुं शक्नोमि सातिथिशालाा कुत्र? कथामिमां प्रभुस्त्वां पृच्छति।</para>
  <para style="p">
    <verse number="12" style="v"/>ततः स जनो द्वितीयप्रकोष्ठीयम् एकं शस्तं कोष्ठं दर्शयिष्यति तत्र भोज्यमासादयतं।</para>
  <para style="p">
    <verse number="13" style="v"/>ततस्तौ गत्वा तद्वाक्यानुसारेण सर्व्वं दृष्द्वा तत्र निस्तारोत्सवीयं भोज्यमासादयामासतुः।</para>
  <para style="p">
    <verse number="14" style="v"/>अथ काल उपस्थिते यीशु र्द्वादशभिः प्रेरितैः सह भोक्तुमुपविश्य कथितवान्</para>
  <para style="p">
    <verse number="15" style="v"/>मम दुःखभोगात् पूर्व्वं युभाभिः सह निस्तारोत्सवस्यैतस्य भोज्यं भोक्तुं मयातिवाञ्छा कृता।</para>
  <para style="p">
    <verse number="16" style="v"/>युष्मान् वदामि, यावत्कालम् ईश्वरराज्ये भोजनं न करिष्ये तावत्कालम् इदं न भोक्ष्ये।</para>
  <para style="p">
    <verse number="17" style="v"/>तदा स पानपात्रमादाय ईश्वरस्य गुणान् कीर्त्तयित्वा तेभ्यो दत्वावदत्, इदं गृह्लीत यूयं विभज्य पिवत।</para>
  <para style="p">
    <verse number="18" style="v"/>युष्मान् वदामि यावत्कालम् ईश्वरराजत्वस्य संस्थापनं न भवति तावद् द्राक्षाफलरसं न पास्यामि।</para>
  <para style="p">
    <verse number="19" style="v"/>ततः पूपं गृहीत्वा ईश्वरगुणान् कीर्त्तयित्वा भङ्क्ता तेभ्यो दत्वावदत्, युष्मदर्थं समर्पितं यन्मम वपुस्तदिदं, एतत् कर्म्म मम स्मरणार्थं कुरुध्वं।</para>
  <para style="p">
    <verse number="20" style="v"/>अथ भोजनान्ते तादृशं पात्रं गृहीत्वावदत्, युष्मत्कृते पातितं यन्मम रक्तं तेन निर्णीतनवनियमरूपं पानपात्रमिदं।</para>
  <para style="p">
    <verse number="21" style="v"/>पश्यत यो मां परकरेषु समर्पयिष्यति स मया सह भोजनासन उपविशति।</para>
  <para style="p">
    <verse number="22" style="v"/>यथा निरूपितमास्ते तदनुसारेणा मनुष्यपुुत्रस्य गति र्भविष्यति किन्तु यस्तं परकरेषु समर्पयिष्यति तस्य सन्तापो भविष्यति।</para>
  <para style="p">
    <verse number="23" style="v"/>तदा तेषां को जन एतत् कर्म्म करिष्यति तत् ते परस्परं प्रष्टुमारेभिरे।</para>
  <para style="p">
    <verse number="24" style="v"/>अपरं तेषां को जनः श्रेष्ठत्वेन गणयिष्यते, अत्रार्थे तेषां विवादोभवत्।</para>
  <para style="p">
    <verse number="25" style="v"/>अस्मात् कारणात् सोवदत्, अन्यदेशीयानां राजानः प्रजानामुपरि प्रभुत्वं कुर्व्वन्ति दारुणशासनं कृत्वापि ते भूपतित्वेन विख्याता भवन्ति च।</para>
  <para style="p">
    <verse number="26" style="v"/>किन्तु युष्माकं तथा न भविष्यति, यो युष्माकं श्रेष्ठो भविष्यति स कनिष्ठवद् भवतु, यश्च मुख्यो भविष्यति स सेवकवद्भवतु।</para>
  <para style="p">
    <verse number="27" style="v"/>भोजनोपविष्टपरिचारकयोः कः श्रेष्ठः? यो भोजनायोपविशति स किं श्रेष्ठो न भवति? किन्तु युष्माकं मध्येऽहं परिचारकइवास्मि।</para>
  <para style="p">
    <verse number="28" style="v"/>अपरञ्च युयं मम परीक्षाकाले प्रथममारभ्य मया सह स्थिता</para>
  <para style="p">
    <verse number="29" style="v"/>एतत्कारणात् पित्रा यथा मदर्थं राज्यमेकं निरूपितं तथाहमपि युष्मदर्थं राज्यं निरूपयामि।</para>
  <para style="p">
    <verse number="30" style="v"/>तस्मान् मम राज्ये भोजनासने च भोजनपाने करिष्यध्वे सिंहासनेषूपविश्य चेस्रायेलीयानां द्वादशवंशानां विचारं करिष्यध्वे।</para>
  <para style="p">
    <verse number="31" style="v"/>अपरं प्रभुरुवाच, हे शिमोन् पश्य तितउना धान्यानीव युष्मान् शैतान् चालयितुम् ऐच्छत्,</para>
  <para style="p">
    <verse number="32" style="v"/>किन्तु तव विश्वासस्य लोपो यथा न भवति एतत् त्वदर्थं प्रार्थितं मया, त्वन्मनसि परिवर्त्तिते च भ्रातृणां मनांसि स्थिरीकुरु।</para>
  <para style="p">
    <verse number="33" style="v"/>तदा सोवदत्, हे प्रभोहं त्वया सार्द्धं कारां मृतिञ्च यातुं मज्जितोस्मि।</para>
  <para style="p">
    <verse number="34" style="v"/>ततः स उवाच, हे पितर त्वां वदामि, अद्य कुक्कुटरवात् पूर्व्वं त्वं मत्परिचयं वारत्रयम् अपह्वोष्यसे।</para>
  <para style="p">
    <verse number="35" style="v"/>अपरं स पप्रच्छ, यदा मुद्रासम्पुटं खाद्यपात्रं पादुकाञ्च विना युष्मान् प्राहिणवं तदा युष्माकं कस्यापि न्यूनतासीत्? ते प्रोचुः कस्यापि न।</para>
  <para style="p">
    <verse number="36" style="v"/>तदा सोवदत् किन्त्विदानीं मुद्रासम्पुटं खाद्यपात्रं वा यस्यास्ति तेन तद्ग्रहीतव्यं, यस्य च कृपाणोे नास्ति तेन स्ववस्त्रं विक्रीय स क्रेतव्यः।</para>
  <para style="p">
    <verse number="37" style="v"/>यतो युष्मानहं वदामि, अपराधिजनैः सार्द्धं गणितः स भविष्यति। इदं यच्छास्त्रीयं वचनं लिखितमस्ति तन्मयि फलिष्यति यतो मम सम्बन्धीयं सर्व्वं सेत्स्यति।</para>
  <para style="p">
    <verse number="38" style="v"/>तदा ते प्रोचुः प्रभो पश्य इमौ कृपाणौ। ततः सोवदद् एतौ यथेष्टौ।</para>
  <para style="p">
    <verse number="39" style="v"/>अथ स तस्माद्वहि र्गत्वा स्वाचारानुसारेण जैतुननामाद्रिं जगाम शिष्याश्च तत्पश्चाद् ययुः।</para>
  <para style="p">
    <verse number="40" style="v"/>तत्रोपस्थाय स तानुवाच, यथा परीक्षायां न पतथ तदर्थं प्रार्थयध्वं।</para>
  <para style="p">
    <verse number="41" style="v"/>पश्चात् स तस्माद् एकशरक्षेपाद् बहि र्गत्वा जानुनी पातयित्वा एतत् प्रार्थयाञ्चक्रे,</para>
  <para style="p">
    <verse number="42" style="v"/>हे पित र्यदि भवान् सम्मन्यते तर्हि कंसमेनं ममान्तिकाद् दूरय किन्तु मदिच्छानुरूपं न त्वदिच्छानुरूपं भवतु।</para>
  <para style="p">
    <verse number="43" style="v"/>तदा तस्मै शक्तिं दातुं स्वर्गीयदूतो दर्शनं ददौ।</para>
  <para style="p">
    <verse number="44" style="v"/>पश्चात् सोत्यन्तं यातनया व्याकुलो भूत्वा पुनर्दृढं प्रार्थयाञ्चक्रे, तस्माद् बृहच्छोणितबिन्दव इव तस्य स्वेदबिन्दवः पृथिव्यां पतितुमारेभिरे।</para>
  <para style="p">
    <verse number="45" style="v"/>अथ प्रार्थनात उत्थाय शिष्याणां समीपमेत्य तान् मनोदुःखिनो निद्रितान् दृष्ट्वावदत्</para>
  <para style="p">
    <verse number="46" style="v"/>कुतो निद्राथ? परीक्षायाम् अपतनार्थं प्रर्थयध्वं।</para>
  <para style="p">
    <verse number="47" style="v"/>एतत्कथायाः कथनकाले द्वादशशिष्याणां मध्ये गणितो यिहूदानामा जनतासहितस्तेषाम् अग्रे चलित्वा यीशोश्चुम्बनार्थं तदन्तिकम् आययौ।</para>
  <para style="p">
    <verse number="48" style="v"/>तदा यीशुरुवाच, हे यिहूदा किं चुम्बनेन मनुष्यपुत्रं परकरेषु समर्पयसि?</para>
  <para style="p">
    <verse number="49" style="v"/>तदा यद्यद् घटिष्यते तदनुमाय सङ्गिभिरुक्तं, हे प्रभो वयं कि खङ्गेन घातयिष्यामः?</para>
  <para style="p">
    <verse number="50" style="v"/>तत एकः करवालेनाहत्य प्रधानयाजकस्य दासस्य दक्षिणं कर्णं चिच्छेद।</para>
  <para style="p">
    <verse number="51" style="v"/>अधूना निवर्त्तस्व इत्युक्त्वा यीशुस्तस्य श्रुतिं स्पृष्ट्वा स्वस्यं चकार।</para>
  <para style="p">
    <verse number="52" style="v"/>पश्चाद् यीशुः समीपस्थान् प्रधानयाजकान् मन्दिरस्य सेनापतीन् प्राचीनांश्च जगाद, यूयं कृपाणान् यष्टींश्च गृहीत्वा मां किं चोरं धर्त्तुमायाताः?</para>
  <para style="p">
    <verse number="53" style="v"/>यदाहं युष्माभिः सह प्रतिदिनं मन्दिरेऽतिष्ठं तदा मां धर्त्तं न प्रवृत्ताः, किन्त्विदानीं युष्माकं समयोन्धकारस्य चाधिपत्यमस्ति।</para>
  <para style="p">
    <verse number="54" style="v"/>अथ ते तं धृत्वा महायाजकस्य निवेशनं निन्युः। ततः पितरो दूरे दूरे पश्चादित्वा</para>
  <para style="p">
    <verse number="55" style="v"/>बृहत्कोष्ठस्य मध्ये यत्राग्निं ज्वालयित्वा लोकाः समेत्योपविष्टास्तत्र तैः सार्द्धम् उपविवेश।</para>
  <para style="p">
    <verse number="56" style="v"/>अथ वह्निसन्निधौ समुपवेशकाले काचिद्दासी मनो निविश्य तं निरीक्ष्यावदत् पुमानयं तस्य सङ्गेऽस्थात्।</para>
  <para style="p">
    <verse number="57" style="v"/>किन्तु स तद् अपह्नुत्यावादीत् हे नारि तमहं न परिचिनोमि।</para>
  <para style="p">
    <verse number="58" style="v"/>क्षणान्तरेऽन्यजनस्तं दृष्ट्वाब्रवीत् त्वमपि तेषां निकरस्यैकजनोसि। पितरः प्रत्युवाच हे नर नाहमस्मि।</para>
  <para style="p">
    <verse number="59" style="v"/>ततः सार्द्धदण्डद्वयात् परं पुनरन्यो जनो निश्चित्य बभाषे, एष तस्य सङ्गीति सत्यं यतोयं गालीलीयो लोकः।</para>
  <para style="p">
    <verse number="60" style="v"/>तदा पितर उवाच हे नर त्वं यद् वदमि तदहं बोद्धुं न शक्नोमि, इति वाक्ये कथितमात्रे कुक्कुटो रुराव।</para>
  <para style="p">
    <verse number="61" style="v"/>तदा प्रभुणा व्याधुट्य पितरे निरीक्षिते कृकवाकुरवात् पूर्व्वं मां त्रिरपह्नोष्यसे इति पूर्व्वोक्तं तस्य वाक्यं पितरः स्मृत्वा</para>
  <para style="p">
    <verse number="62" style="v"/>बहिर्गत्वा महाखेदेन चक्रन्द।</para>
  <para style="p">
    <verse number="63" style="v"/>तदा यै र्यीशुर्धृतस्ते तमुपहस्य प्रहर्त्तुमारेभिरे।</para>
  <para style="p">
    <verse number="64" style="v"/>वस्त्रेण तस्य दृशौ बद्ध्वा कपोले चपेटाघातं कृत्वा पप्रच्छुः, कस्ते कपोले चपेटाघातं कृतवान? गणयित्वा तद् वद।</para>
  <para style="p">
    <verse number="65" style="v"/>तदन्यत् तद्विरुद्धं बहुनिन्दावाक्यं वक्तुमारेभिरे।</para>
  <para style="p">
    <verse number="66" style="v"/>अथ प्रभाते सति लोकप्राञ्चः प्रधानयाजका अध्यापकाश्च सभां कृत्वा मध्येसभं यीशुमानीय पप्रच्छुः, त्वम् अभिषिकतोसि न वास्मान् वद।</para>
  <para style="p">
    <verse number="67" style="v"/>स प्रत्युवाच, मया तस्मिन्नुक्तेऽपि यूयं न विश्वसिष्यथ।</para>
  <para style="p">
    <verse number="68" style="v"/>कस्मिंश्चिद्वाक्ये युष्मान् पृष्टेऽपि मां न तदुत्तरं वक्ष्यथ न मां त्यक्ष्यथ च।</para>
  <para style="p">
    <verse number="69" style="v"/>किन्त्वितः परं मनुजसुतः सर्व्वशक्तिमत ईश्वरस्य दक्षिणे पार्श्वे समुपवेक्ष्यति।</para>
  <para style="p">
    <verse number="70" style="v"/>ततस्ते पप्रच्छुः, र्तिह त्वमीश्वरस्य पुत्रः? स कथयामास, यूयं यथार्थं वदथ स एवाहं।</para>
  <para style="p">
    <verse number="71" style="v"/>तदा ते सर्व्वे कथयामासुः, र्तिह साक्ष्येऽन्सस्मिन् अस्माकं किं प्रयोजनं? अस्य स्वमुखादेव साक्ष्यं प्राप्तम्।</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ततः सभास्थाः सर्व्वलोका उत्थाय तं पीलातसम्मुखं नीत्वाप्रोद्य वक्तुमारेभिरे,</para>
  <para style="p">
    <verse number="2" style="v"/>स्वमभिषिक्तं राजानं वदन्तं कैमरराजाय करदानं निषेधन्तं राज्यविपर्य्ययं कुर्त्तुं प्रवर्त्तमानम् एन प्राप्ता वयं।</para>
  <para style="p">
    <verse number="3" style="v"/>तदा पीलातस्तं पृष्टवान् त्वं किं यिहूदीयानां राजा? स प्रत्युवाच त्वं सत्यमुक्तवान्।</para>
  <para style="p">
    <verse number="4" style="v"/>तदा पीलातः प्रधानयाजकादिलोकान् जगाद्, अहमेतस्य कमप्यपराधं नाप्तवान्।</para>
  <para style="p">
    <verse number="5" style="v"/>ततस्ते पुनः साहमिनो भूत्वावदन्, एष गालील एतत्स्थानपर्य्यन्ते सर्व्वस्मिन् यिहूदादेशे सर्व्वाल्लोकानुपदिश्य कुप्रवृत्तिं ग्राहीतवान्।</para>
  <para style="p">
    <verse number="6" style="v"/>तदा पीलातो गालीलप्रदेशस्य नाम श्रुत्वा पप्रच्छ, किमयं गालीलीयो लोकः?</para>
  <para style="p">
    <verse number="7" style="v"/>ततः स गालील्प्रदेशीयहेरोद्राजस्य तदा स्थितेस्तस्य समीपे यीशुं प्रेषयामास।</para>
  <para style="p">
    <verse number="8" style="v"/>तदा हेरोद् यीशुं विलोक्य सन्तुतोष, यतः स तस्य बहुवृत्तान्तश्रवणात् तस्य किञि्चदाश्चर्य्यकर्म्म पश्यति इत्याशां कृत्वा बहुकालमारभ्य तं द्रष्टुं प्रयासं कृतवान्।</para>
  <para style="p">
    <verse number="9" style="v"/>तस्मात् तं बहुकथाः पप्रच्छ किन्तु स तस्य कस्यापि वाक्यस्य प्रत्युत्तरं नोवाच।</para>
  <para style="p">
    <verse number="10" style="v"/>अथ प्रधानयाजका अध्यापकाश्च प्रोत्तिष्ठन्तः साहसेन तमपवदितुं प्रारेभिरे।</para>
  <para style="p">
    <verse number="11" style="v"/>हेरोद् तस्य सेनागणश्च तमवज्ञाय उपहासत्वेन राजवस्त्रं परिधाप्य पुनः पीलातं प्रति तं प्राहिणोत्।</para>
  <para style="p">
    <verse number="12" style="v"/>पूर्व्वं हेरोद्पीलातयोः परस्परं वैरभाव आसीत् किन्तु तद्दिने द्वयो र्मेलनं जातम्।</para>
  <para style="p">
    <verse number="13" style="v"/>पश्चात् पीलातः प्रधानयाजकान् शासकान् लोकांश्च युगपदाहूय बभाषे,</para>
  <para style="p">
    <verse number="14" style="v"/>राज्यविपर्य्ययकारकोयम् इत्युक्त्वा मनुष्यमेनं मम निकटमानैष्ट किन्तु पश्यत युष्माकं समक्षम् अस्य विचारं कृत्वापि प्रोक्तापवादानुरूपेणास्य कोप्यपराधः सप्रमाणो न जातः,</para>
  <para style="p">
    <verse number="15" style="v"/>यूयञ्च हेरोदः सन्निधौ प्रेषिता मया तत्रास्य कोप्यपराधस्तेनापि न प्राप्तः।पश्यतानेन वधहेेतुकं किमपि नापराद्धं।</para>
  <para style="p">
    <verse number="16" style="v"/>तस्मादेनं ताडयित्वा विहास्यामि।</para>
  <para style="p">
    <verse number="17" style="v"/>तत्रोत्सवे तेषामेको मोचयितव्यः।</para>
  <para style="p">
    <verse number="18" style="v"/>इति हेतोस्ते प्रोच्चैरेकदा प्रोचुः, एनं दूरीकृत्य बरब्बानामानं मोचय।</para>
  <para style="p">
    <verse number="19" style="v"/>स बरब्बा नगर उपप्लववधापराधाभ्यां कारायां बद्ध आसीत्।</para>
  <para style="p">
    <verse number="20" style="v"/>किन्तु पीलातो यीशुं मोचयितुं वाञ्छन् पुनस्तानुवाच।</para>
  <para style="p">
    <verse number="21" style="v"/>तथाप्येनं क्रुशे व्यध क्रुशे व्यधेति वदन्तस्ते रुरुवुः।</para>
  <para style="p">
    <verse number="22" style="v"/>ततः स तृतीयवारं जगाद कुतः? स किं कर्म्म कृतवान्? नाहमस्य कमपि वधापराधं प्राप्तः केवलं ताडयित्वामुं त्यजामि।</para>
  <para style="p">
    <verse number="23" style="v"/>तथापि ते पुनरेनं क्रुशे व्यध इत्युक्त्वा प्रोच्चैर्दृढं प्रार्थयाञ्चक्रिरे;</para>
  <para style="p">
    <verse number="24" style="v"/>ततः प्रधानयाजकादीनां कलरवे प्रबले सति तेषां प्रार्थनारूपं कर्त्तुं पीलात आदिदेश।</para>
  <para style="p">
    <verse number="25" style="v"/>राजद्रोहवधयोरपराधेन कारास्थं यं जनं ते ययाचिरे तं मोचयित्वा यीशुं तेषामिच्छायां समार्पयत्।</para>
  <para style="p">
    <verse number="26" style="v"/>अथ ते यीशुं गृहीत्वा यान्ति, एतर्हि ग्रामादागतं शिमोननामानं कुरीणीयं जनं धृत्वा यीशोः पश्चान्नेतुं तस्य स्कन्धे क्रुशमर्पयामासुः।</para>
  <para style="p">
    <verse number="27" style="v"/>ततो लोाकारण्यमध्ये बहुस्त्रियो रुदत्यो विलपन्त्यश्च यीशोः पश्चाद् ययुः।</para>
  <para style="p">
    <verse number="28" style="v"/>किन्तु स व्याघुट्य ता उवाच, हे यिरूशालमो नार्य्यो युयं मदर्थं न रुदित्वा स्वार्थं स्वापत्यार्थञ्च रुदिति;</para>
  <para style="p">
    <verse number="29" style="v"/>पश्यत यः कदापि गर्भवत्यो नाभवन् स्तन्यञ्च नापाययन् तादृशी र्वन्ध्या यदा धन्या वक्ष्यन्ति स काल आयाति।</para>
  <para style="p">
    <verse number="30" style="v"/>तदा हे शैला अस्माकमुपरि पतत, हे उपशैला अस्मानाच्छादयत कथामीदृशीं लोका वक्ष्यन्ति।</para>
  <para style="p">
    <verse number="31" style="v"/>यतः सतेजसि शाखिनि चेदेतद् घटते तर्हि शुष्कशाखिनि किं न घटिष्यते?</para>
  <para style="p">
    <verse number="32" style="v"/>तदा ते हन्तुं द्वावपराधिनौ तेन सार्द्धं निन्युः।</para>
  <para style="p">
    <verse number="33" style="v"/>अपरं शिरःकपालनामकस्थानं प्राप्य तं क्रुशे विविधुः; तद्द्वयोरपराधिनोरेकं तस्य दक्षिणो तदन्यं वामे क्रुशे विविधुः।</para>
  <para style="p">
    <verse number="34" style="v"/>तदा यीशुरकथयत्, हे पितरेतान् क्षमस्व यत एते यत् कर्म्म कुर्व्वन्ति तन् न विदुः; पश्चात्ते गुटिकापातं कृत्वा तस्य वस्त्राणि विभज्य जगृहुः।</para>
  <para style="p">
    <verse number="35" style="v"/>तत्र लोकसंघस्तिष्ठन् ददर्श; ते तेषां शासकाश्च तमुपहस्य जगदुः, एष इतरान् रक्षितवान् यदीश्वरेणाभिरुचितो ऽभिषिक्तस्त्राता भवति तर्हि स्वमधुना रक्षतु।</para>
  <para style="p">
    <verse number="36" style="v"/>तदन्यः सेनागणा एत्य तस्मै अम्लरसं दत्वा परिहस्य प्रोवाच,</para>
  <para style="p">
    <verse number="37" style="v"/>चेत्त्वं यिहूदीयानां राजासि तर्हि स्वं रक्ष।</para>
  <para style="p">
    <verse number="38" style="v"/>यिहूदीयानां राजेति वाक्यं यूनानीयरोमीयेब्रीयाक्षरै र्लिखितं तच्छिरस ऊर्द्ध्वेऽस्थाप्यत।</para>
  <para style="p">
    <verse number="39" style="v"/>तदोभयपार्श्वयो र्विद्धौ यावपराधिनौ तयोरेकस्तं विनिन्द्य बभाषे, चेत्त्वम् अभिषिक्तोसि तर्हि स्वमावाञ्च रक्ष।</para>
  <para style="p">
    <verse number="40" style="v"/>किन्त्वन्यस्तं तर्जयित्वावदत्, ईश्वरात्तव किञ्चिदपि भयं नास्ति किं? त्वमपि समानदण्डोसि,</para>
  <para style="p">
    <verse number="41" style="v"/>योग्यपात्रे आवां स्वस्वकर्म्मणां समुचितफलं प्राप्नुवः किन्त्वनेन किमपि नापराद्धं।</para>
  <para style="p">
    <verse number="42" style="v"/>अथ स यीशुं जगाद हे प्रभे भवान् स्वराज्यप्रवेशकाले मां स्मरतु।</para>
  <para style="p">
    <verse number="43" style="v"/>तदा यीशुः कथितवान् त्वां यथार्थं वदामि त्वमद्यैव मया सार्द्धं परलोकस्य सुखस्थानं प्राप्स्यसि।</para>
  <para style="p">
    <verse number="44" style="v"/>अपरञ्च द्वितीययामात् तृतीययामपर्य्यन्तं रवेस्तेजसोन्तर्हितत्वात् सर्व्वदेशोऽन्धकारेणावृतो</para>
  <para style="p">
    <verse number="45" style="v"/>मन्दिरस्य यवनिका च छिद्यमाना द्विधा बभूव।</para>
  <para style="p">
    <verse number="46" style="v"/>ततो यीशुरुच्चैरुवाच, हे पित र्ममात्मानं तव करे समर्पये, इत्युक्त्वा स प्राणान् जहौ।</para>
  <para style="p">
    <verse number="47" style="v"/>तदैता घटना दृष्ट्वा शतसेनापतिरीश्वरं धन्यमुक्त्वा कथितवान् अयं नितान्तं साधुमनुष्य आसीत्।</para>
  <para style="p">
    <verse number="48" style="v"/>अथ यावन्तो लोका द्रष्टुम् आगतास्ते ता घटना दृष्ट्वा वक्षःसु कराघातं कृत्वा व्याचुट्य गताः।</para>
  <para style="p">
    <verse number="49" style="v"/>यीशो र्ज्ञातयो या या योषितश्च गालीलस्तेन सार्द्धमायातास्ता अपि दूरे स्थित्वा तत् सर्व्वं ददृशुः।</para>
  <para style="p">
    <verse number="50" style="v"/>तदा यिहूदीयानां मन्त्रणां क्रियाञ्चासम्मन्यमान ईश्वरस्य राजत्वम् अपेक्षमाणो</para>
  <para style="p">
    <verse number="51" style="v"/>यिहूदिदेशीयो ऽरिमथीयनगरीयो यूषफ्नामा मन्त्री भद्रो धार्म्मिकश्च पुमान्</para>
  <para style="p">
    <verse number="52" style="v"/>पीलातान्तिकं गत्वा यीशो र्देहं ययाचे।</para>
  <para style="p">
    <verse number="53" style="v"/>पश्चाद् वपुरवरोह्य वाससा संवेष्ट्य यत्र कोपि मानुषो नास्थाप्यत तस्मिन् शैले स्वाते श्मशाने तदस्थापयत्।</para>
  <para style="p">
    <verse number="54" style="v"/>तद्दिनमायोजनीयं दिनं विश्रामवारश्च समीपः।</para>
  <para style="p">
    <verse number="55" style="v"/>अपरं यीशुना सार्द्धं गालील आगता योषितः पश्चादित्वा श्मशाने तत्र यथा वपुः स्थापितं तच्च दृष्ट्वा</para>
  <para style="p">
    <verse number="56" style="v"/>व्याघुट्य सुगन्धिद्रव्यतैलानि कृत्वा विधिवद् विश्रामवारे विश्रामं चक्रुः।</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>अथ सप्ताहप्रथमदिनेऽतिप्रत्यूषे ता योषितः सम्पादितं सुगन्धिद्रव्यं गृहीत्वा तदन्याभिः कियतीभिः स्त्रीभिः सह श्मशानं ययुः।</para>
  <para style="p">
    <verse number="2" style="v"/>किन्तु श्मशानद्वारात् पाषाणमपसारितं दृष्ट्वा</para>
  <para style="p">
    <verse number="3" style="v"/>ताः प्रविश्य प्रभो र्देहमप्राप्य</para>
  <para style="p">
    <verse number="4" style="v"/>व्याकुला भवन्ति एतर्हि तेजोमयवस्त्रान्वितौ द्वौ पुरुषौ तासां समीपे समुपस्थितौ</para>
  <para style="p">
    <verse number="5" style="v"/>तस्मात्ताः शङ्कायुक्ता भूमावधोमुख्यस्यस्थुः। तदा तौ ता ऊचतु र्मृतानां मध्ये जीवन्तं कुतो मृगयथ?</para>
  <para style="p">
    <verse number="6" style="v"/>सोत्र नास्ति स उदस्थात्।</para>
  <para style="p">
    <verse number="7" style="v"/>पापिनां करेषु समर्पितेन क्रुशे हतेन च मनुष्यपुत्रेण तृतीयदिवसे श्मशानादुत्थातव्यम् इति कथां स गलीलि तिष्ठन् युष्मभ्यं कथितवान् तां स्मरत।</para>
  <para style="p">
    <verse number="8" style="v"/>तदा तस्य सा कथा तासां मनःसु जाता।</para>
  <para style="p">
    <verse number="9" style="v"/>अनन्तरं श्मशानाद् गत्वा ता एकादशशिष्यादिभ्यः सर्व्वेभ्यस्तां वार्त्तां कथयामासुः।</para>
  <para style="p">
    <verse number="10" style="v"/>मग्दलीनीमरियम्, योहना, याकूबो माता मरियम् तदन्याः सङ्गिन्यो योषितश्च प्रेरितेभ्य एताः सर्व्वा वार्त्ताः कथयामासुः</para>
  <para style="p">
    <verse number="11" style="v"/>किन्तु तासां कथाम् अनर्थकाख्यानमात्रं बुद्ध्वा कोपि न प्रत्यैत्।</para>
  <para style="p">
    <verse number="12" style="v"/>तदा पितर उत्थाय श्मशानान्तिकं दधाव, तत्र च प्रह्वो भूत्वा पार्श्वैकस्थापितं केवलं वस्त्रं ददर्श; तस्मादाश्चर्य्यं मन्यमानो यदघटत तन्मनसि विचारयन् प्रतस्थे।</para>
  <para style="p">
    <verse number="13" style="v"/>तस्मिन्नेव दिने द्वौ शिय्यौ यिरूशालमश्चतुष्क्रोशान्तरितम् इम्मायुग्रामं गच्छन्तौ</para>
  <para style="p">
    <verse number="14" style="v"/>तासां घटनानां कथामकथयतां</para>
  <para style="p">
    <verse number="15" style="v"/>तयोरालापविचारयोः काले यीशुरागत्य ताभ्यां सह जगाम</para>
  <para style="p">
    <verse number="16" style="v"/>किन्तु यथा तौ तं न परिचिनुतस्तदर्थं तयो र्दृष्टिः संरुद्धा।</para>
  <para style="p">
    <verse number="17" style="v"/>स तौ पृष्टवान् युवां विषण्णौ किं विचारयन्तौ गच्छथः?</para>
  <para style="p">
    <verse number="18" style="v"/>ततस्तयोः क्लियपानामा प्रत्युवाच यिरूशालमपुरेऽधुना यान्यघटन्त त्वं केवलविदेशी किं तद्वृत्तान्तं न जानासि?</para>
  <para style="p">
    <verse number="19" style="v"/>स पप्रच्छ का घटनाः? तदा तौ वक्तुमारेभाते यीशुनामा यो नासरतीयो भविष्यद्वादी ईश्वरस्य मानुषाणाञ्च साक्षात् वाक्ये कर्म्मणि च शक्तिमानासीत्</para>
  <para style="p">
    <verse number="20" style="v"/>तम् अस्माकं प्रधानयाजका विचारकाश्च केनापि प्रकारेण क्रुशे विद्ध्वा तस्य प्राणाननाशयन् तदीया घटनाः;</para>
  <para style="p">
    <verse number="21" style="v"/>किन्तु य इस्रायेलीयलोकान् उद्धारयिष्यति स एवायम् इत्याशास्माभिः कृता।तद्यथा तथास्तु तस्या घटनाया अद्य दिनत्रयं गतं।</para>
  <para style="p">
    <verse number="22" style="v"/>अधिकन्त्वस्माकं सङ्गिनीनां कियत्स्त्रीणां मुखेभ्योऽसम्भववाक्यमिदं श्रुतं;</para>
  <para style="p">
    <verse number="23" style="v"/>ताः प्रत्यूषे श्मशानं गत्वा तत्र तस्य देहम् अप्राप्य व्याघुट्येत्वा प्रोक्तवत्यः स्वर्गीसदूतौ दृष्टावस्माभिस्तौ चावादिष्टां स जीवितवान्।</para>
  <para style="p">
    <verse number="24" style="v"/>ततोस्माकं कैश्चित् श्मशानमगम्यत तेऽपि स्त्रीणां वाक्यानुरूपं दृष्टवन्तः किन्तु तं नापश्यन्।</para>
  <para style="p">
    <verse number="25" style="v"/>तदा स तावुवाच, हे अबोधौ हे भविष्यद्वादिभिरुक्तवाक्यं प्रत्येतुं विलम्बमानौ;</para>
  <para style="p">
    <verse number="26" style="v"/>एतत्सर्व्वदुःखं भुक्त्वा स्वभूतिप्राप्तिः किं ख्रीष्टस्य न न्याय्या?</para>
  <para style="p">
    <verse number="27" style="v"/>ततः स मूसाग्रन्थमारभ्य सर्व्वभविष्यद्वादिनां सर्व्वशास्त्रे स्वस्मिन् लिखिताख्यानाभिप्रायं बोधयामास।</para>
  <para style="p">
    <verse number="28" style="v"/>अथ गम्यग्रामाभ्यर्णं प्राप्य तेनाग्रे गमनलक्षणे दर्शिते</para>
  <para style="p">
    <verse number="29" style="v"/>तौ साधयित्वावदतां सहावाभ्यां तिष्ठ दिने गते सति रात्रिरभूत्; ततः स ताभ्यां सार्द्धं स्थातुं गृहं ययौ।</para>
  <para style="p">
    <verse number="30" style="v"/>पश्चाद्भोजनोपवेशकाले स पूपं गृहीत्वा ईश्वरगुणान् जगाद तञ्च भंक्त्वा ताभ्यां ददौ।</para>
  <para style="p">
    <verse number="31" style="v"/>तदा तयो र्दृष्टौ प्रसन्नायां तं प्रत्यभिज्ञतुः किन्तु स तयोः साक्षादन्तर्दधे।</para>
  <para style="p">
    <verse number="32" style="v"/>ततस्तौ मिथोभिधातुम् आरब्धवन्तौ गमनकाले यदा कथामकथयत् शास्त्रार्थञ्चबोधयत् तदावयो र्बुद्धिः किं न प्राज्वलत्?</para>
  <para style="p">
    <verse number="33" style="v"/>तौ तत्क्षणादुत्थाय यिरूशालमपुरं प्रत्याययतुः, तत्स्थाने शिष्याणाम् एकादशानां सङ्गिनाञ्च दर्शनं जातं।</para>
  <para style="p">
    <verse number="34" style="v"/>ते प्रोचुः प्रभुरुदतिष्ठद् इति सत्यं शिमोने दर्शनमदाच्च।</para>
  <para style="p">
    <verse number="35" style="v"/>ततः पथः सर्व्वघटनायाः पूपभञ्जनेन तत्परिचयस्य च सर्व्ववृत्तान्तं तौ वक्तुमारेभाते।</para>
  <para style="p">
    <verse number="36" style="v"/>इत्थं ते परस्परं वदन्ति तत्काले यीशुः स्वयं तेषां मध्य प्रोत्थय युष्माकं कल्याणं भूयाद् इत्युवाच,</para>
  <para style="p">
    <verse number="37" style="v"/>किन्तु भूतं पश्याम इत्यनुमाय ते समुद्विविजिरे त्रेषुश्च।</para>
  <para style="p">
    <verse number="38" style="v"/>स उवाच, कुतो दुःखिता भवथ? युष्माकं मनःसु सन्देह उदेति च कुतः?</para>
  <para style="p">
    <verse number="39" style="v"/>एषोहं, मम करौ पश्यत वरं स्पृष्ट्वा पश्यत, मम यादृशानि पश्यथ तादृशानि भूतस्य मांसास्थीनि न सन्ति।</para>
  <para style="p">
    <verse number="40" style="v"/>इत्युक्त्वा स हस्तपादान् दर्शयामास।</para>
  <para style="p">
    <verse number="41" style="v"/>तेऽसम्भवं ज्ञात्वा सानन्दा न प्रत्ययन्। ततः स तान् पप्रच्छ, अत्र युष्माकं समीपे खाद्यं किञ्चिदस्ति?</para>
  <para style="p">
    <verse number="42" style="v"/>ततस्ते कियद्दग्धमत्स्यं मधु च ददुः</para>
  <para style="p">
    <verse number="43" style="v"/>स तदादाय तेषां साक्षाद् बुभुजे</para>
  <para style="p">
    <verse number="44" style="v"/>कथयामास च मूसाव्यवस्थायां भविष्यद्वादिनां ग्रन्थेषु गीतपुस्तके च मयि यानि सर्व्वाणि वचनानि लिखितानि तदनुरूपाणि घटिष्यन्ते युष्माभिः सार्द्धं स्थित्वाहं यदेतद्वाक्यम् अवदं तदिदानीं प्रत्यक्षमभूत्।</para>
  <para style="p">
    <verse number="45" style="v"/>अथ तेभ्यः शास्त्रबोधाधिकारं दत्वावदत्,</para>
  <para style="p">
    <verse number="46" style="v"/>ख्रीष्टेनेत्थं मृतियातना भोक्तव्या तृतीयदिने च श्मशानादुत्थातव्यञ्चेति लिपिरस्ति;</para>
  <para style="p">
    <verse number="47" style="v"/>तन्नाम्ना यिरूशालममारभ्य सर्व्वदेशे मनःपरावर्त्तनस्य पापमोचनस्य च सुसंवादः प्रचारयितव्यः,</para>
  <para style="p">
    <verse number="48" style="v"/>एषु सर्व्वेषु यूयं साक्षिणः।</para>
  <para style="p">
    <verse number="49" style="v"/>अपरञ्च पश्यत पित्रा यत् प्रतिज्ञातं तत् प्रेषयिष्यामि, अतएव यावत्कालं यूयं स्वर्गीयां शक्तिं न प्राप्स्यथ तावत्कालं यिरूशालम्नगरे तिष्ठत।</para>
  <para style="p">
    <verse number="50" style="v"/>अथ स तान् बैथनीयापर्य्यन्तं नीत्वा हस्तावुत्तोल्य आशिष वक्तुमारेभे</para>
  <para style="p">
    <verse number="51" style="v"/>आशिषं वदन्नेव च तेभ्यः पृथग् भूत्वा स्वर्गाय नीतोऽभवत्।</para>
  <para style="p">
    <verse number="52" style="v"/>तदा ते तं भजमाना महानन्देन यिरूशालमं प्रत्याजग्मुः।</para>
  <para style="p">
    <verse number="53" style="v"/>ततो निरन्तरं मन्दिरे तिष्ठन्त ईश्वरस्य प्रशंसां धन्यवादञ्च कर्त्तम् आरेभिरे। इति॥</para>
</usx>
