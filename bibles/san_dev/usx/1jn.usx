<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1JN" style="id">Sanskrit Bible (NT) in Devanagari Script (सत्यवेदः।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 John</para>
  <para style="toc1">१ योहनः पत्रं</para>
  <para style="toc2">१ योहनः</para>
  <para style="toc3">१ योहनः</para>
  <para style="mt1">१ योहनः पत्रं</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>आदितो य आसीद् यस्य वाग् अस्माभिरश्रावि यञ्च वयं स्वनेत्रै र्दृष्टवन्तो यञ्च वीक्षितवन्तः स्वकरैः स्पृष्टवन्तश्च तं जीवनवादं वयं ज्ञापयामः।</para>
  <para style="p">
    <verse number="2" style="v"/>स जीवनस्वरूपः प्रकाशत वयञ्च तं दृष्टवन्तस्तमधि साक्ष्यं दद्मश्च, यश्च पितुः सन्निधाववर्त्ततास्माकं समीपे प्रकाशत च तम् अनन्तजीवनस्वरूपं वयं युष्मान् ज्ञापयामः।</para>
  <para style="p">
    <verse number="3" style="v"/>अस्माभि र्यद् दृष्टं श्रुतञ्च तदेव युष्मान् ज्ञाप्यते तेनास्माभिः सहांशित्वं युष्माकं भविष्यति। अस्माकञ्च सहांशित्वं पित्रा तत्पुत्रेण यीशुख्रीष्टेन च सार्द्धं भवति।</para>
  <para style="p">
    <verse number="4" style="v"/>अपरञ्च युष्माकम् आनन्दो यत् सम्पूर्णो भवेद् तदर्थं वयम् एतानि लिखामः।</para>
  <para style="p">
    <verse number="5" style="v"/>वयं यां वार्त्तां तस्मात् श्रुत्वा युष्मान् ज्ञापयामः सेयम्। ईश्वरो ज्योतिस्तस्मिन् अन्धकारस्य लेशोऽपि नास्ति।</para>
  <para style="p">
    <verse number="6" style="v"/>वयं तेन सहांशिन इति गदित्वा यद्यन्धाकारे चरामस्तर्हि सत्याचारिणो न सन्तो ऽनृतवादिनो भवामः।</para>
  <para style="p">
    <verse number="7" style="v"/>किन्तु स यथा ज्योतिषि वर्त्तते तथा वयमपि यदि ज्योतिषि चरामस्तर्हि परस्परं सहभागिनो भवामस्तस्य पुत्रस्य यीशुख्रीष्टस्य रुधिरञ्चास्मान् सर्व्वस्मात् पापात् शुद्धयति।</para>
  <para style="p">
    <verse number="8" style="v"/>वयं निष्पापा इति यदि वदामस्तर्हि स्वयमेव स्वान् वञ्चयामः सत्यमतञ्चास्माकम् अन्तरे न विद्यते।</para>
  <para style="p">
    <verse number="9" style="v"/>यदि स्वपापानि स्वीकुर्म्महे तर्हि स विश्वास्यो याथार्थिकश्चास्ति तस्माद् अस्माकं पापानि क्षमिष्यते सर्व्वस्माद् अधर्म्माच्चास्मान् शुद्धयिष्यति।</para>
  <para style="p">
    <verse number="10" style="v"/>वयम् अकृतपापा इति यदि वदामस्तर्हि तम् अनृतवादिनं कुर्म्मस्तस्य वाक्यञ्चास्माकम् अन्तरे न विद्यते।</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>हे प्रियबालकाः, युष्माभि र्यत् पापं न क्रियेत तदर्थं युष्मान् प्रत्येतानि मया लिख्यन्ते। यदि तु केनापि पापं क्रियते तर्हि पितुः समीपे ऽस्माकं एकः सहायो ऽर्थतो धार्म्मिको यीशुः ख्रीष्टो विद्यते।</para>
  <para style="p">
    <verse number="2" style="v"/>स चास्माकं पापानां प्रायश्चित्तं केवलमस्माकं नहि किन्तु लिखिलसंसारस्य पापानां प्रायश्चित्तं।</para>
  <para style="p">
    <verse number="3" style="v"/>वयं तं जानीम इति तदीयाज्ञापालनेनावगच्छामः।</para>
  <para style="p">
    <verse number="4" style="v"/>अहं तं जानामीति वदित्वा यस्तस्याज्ञा न पालयति सो ऽनृतवादी सत्यमतञ्च तस्यान्तरे न विद्यते।</para>
  <para style="p">
    <verse number="5" style="v"/>यः कश्चित् तस्य वाक्यं पालयति तस्मिन् ईश्वरस्य प्रेम सत्यरूपेण सिध्यति वयं तस्मिन् वर्त्तामहे तद् एतेनावगच्छामः।</para>
  <para style="p">
    <verse number="6" style="v"/>अहं तस्मिन् तिष्ठामीति यो गदति तस्येदम् उचितं यत् ख्रीष्टो यादृग् आचरितवान् सो ऽपि तादृग् आचरेत्।</para>
  <para style="p">
    <verse number="7" style="v"/>हे प्रियतमाः, युष्मान् प्रत्यहं नूतनामाज्ञां लिखामीति नहि किन्त्वादितो युष्माभि र्लब्धां पुरातनामाज्ञां लिखामि। आदितो युष्माभि र्यद् वाक्यं श्रुतं सा पुरातनाज्ञा।</para>
  <para style="p">
    <verse number="8" style="v"/>पुनरपि युष्मान् प्रति नूतनाज्ञा मया लिख्यत एतदपि तस्मिन् युष्मासु च सत्यं, यतो ऽन्धकारो व्यत्येति सत्या ज्योतिश्चेदानीं प्रकाशते;</para>
  <para style="p">
    <verse number="9" style="v"/>अहं ज्योतिषि वर्त्त इति गदित्वा यः स्वभ्रातरं द्वेष्टि सो ऽद्यापि तमिस्रे वर्त्तते।</para>
  <para style="p">
    <verse number="10" style="v"/>स्वभ्रातरि यः प्रीयते स एव ज्योतिषि वर्त्तते विघ्नजनकं किमपि तस्मिन् न विद्यते।</para>
  <para style="p">
    <verse number="11" style="v"/>किन्तु स्वभ्रातरं यो द्वेष्टि स तिमिरे वर्त्तते तिमिरे चरति च तिमिरेण च तस्य नयने ऽन्धीक्रियेते तस्मात् क्क यामीति स ज्ञातुं न शक्नोति।</para>
  <para style="p">
    <verse number="12" style="v"/>हे शिशवः, यूयं तस्य नाम्ना पापक्षमां प्राप्तवन्तस्तस्माद् अहं युष्मान् प्रति लिखामि।</para>
  <para style="p">
    <verse number="13" style="v"/>हे पितरः, य आदितो वर्त्तमानस्तं यूयं जानीथ तस्माद् युष्मान् प्रति लिखामि। हे युवानः यूयं पापत्मानं जितवन्तस्तस्माद् युष्मान् प्रति लिखामि। हे बालकाः, यूयं पितरं जानीथ तस्मादहं युष्मान् प्रति लिखितवान्।</para>
  <para style="p">
    <verse number="14" style="v"/>हे पितरः, आदितो यो वर्त्तमानस्तं यूयं जानीथ तस्माद् युष्मान् प्रति लिखितवान्। हे युवानः, यूयं बलवन्त आध्वे, ईश्वरस्य वाक्यञ्च युष्मदन्तरे वर्तते पापात्मा च युष्माभिः पराजिग्ये तस्माद् युष्मान् प्रति लिखितवान्।</para>
  <para style="p">
    <verse number="15" style="v"/>यूयं संसारे संसारस्थविषयेषु च मा प्रीयध्वं यः संसारे प्रीयते तस्यान्तरे पितुः प्रेम न तिष्ठति।</para>
  <para style="p">
    <verse number="16" style="v"/>यतः संसारे यद्यत् स्थितम् अर्थतः शारीरिकभावस्याभिलाषो दर्शनेन्द्रियस्याभिलाषो जीवनस्य गर्व्वश्च सर्व्वमेतत् पितृतो न जायते किन्तु संसारदेव।</para>
  <para style="p">
    <verse number="17" style="v"/>संसारस्तदीयाभिलाषश्च व्यत्येति किन्तु य ईश्वरस्येष्टं करोति सो ऽनन्तकालं यावत् तिष्ठति।</para>
  <para style="p">
    <verse number="18" style="v"/>हे बालकाः, शेषकालोऽयं, अपरं ख्रीष्टारिणोपस्थाव्यमिति युष्माभि र्यथा श्रुतं तथा बहवः ख्रीष्टारय उपस्थितास्तस्मादयं शेषकालोऽस्तीति वयं जानीमः।</para>
  <para style="p">
    <verse number="19" style="v"/>ते ऽस्मन्मध्यान् निर्गतवन्तः किन्त्वस्मदीया नासन् यद्यस्मदीया अभविष्यन् तर्ह्यस्मत्सङ्गे ऽस्थास्यन्, किन्तु सर्व्वे ऽस्मदीया न सन्त्येतस्य प्रकाश आवश्यक आसीत्।</para>
  <para style="p">
    <verse number="20" style="v"/>यः पवित्रस्तस्माद् यूयम् अभिषेकं प्राप्तवन्तस्तेन सर्व्वाणि जानीथ।</para>
  <para style="p">
    <verse number="21" style="v"/>यूयं सत्यमतं न जानीथ तत्कारणाद् अहं युष्मान् प्रति लिखितवान् तन्नहि किन्तु यूयं तत् जानीथ सत्यमताच्च किमप्यनृतवाक्यं नोत्पद्यते तत्कारणादेव।</para>
  <para style="p">
    <verse number="22" style="v"/>यीशुरभिषिक्तस्त्रातेति यो नाङ्गीकरोति तं विना को ऽपरो ऽनृतवादी भवेत्? स एव ख्रीष्टारि र्यः पितरं पुत्रञ्च नाङ्गीकरोति।</para>
  <para style="p">
    <verse number="23" style="v"/>यः कश्चित् पुत्रं नाङ्गीकरोति स पितरमपि न धारयति यश्च पुत्रमङ्गीकरोति स पितरमपि धारयति।</para>
  <para style="p">
    <verse number="24" style="v"/>आदितो युष्माभि र्यत् श्रुतं तद् युष्मासु तिष्ठतु, आदितः श्रुतं वाक्यं यदि युष्मासु तिष्ठति, तर्हि यूयमपि पुत्रे पितरि च स्थास्यथ।</para>
  <para style="p">
    <verse number="25" style="v"/>स च प्रतिज्ञयास्मभ्यं यत् प्रतिज्ञातवान् तद् अनन्तजीवनं।</para>
  <para style="p">
    <verse number="26" style="v"/>ये जना युष्मान् भ्रामयन्ति तानध्यहम् इदं लिखितवान्।</para>
  <para style="p">
    <verse number="27" style="v"/>अपरं यूयं तस्माद् यम् अभिषेकं प्राप्तवन्तः स युष्मासु तिष्ठति ततः कोऽपि यद् युष्मान् शिक्षयेत् तद् अनावश्यकं, स चाभिषेको युष्मान् सर्व्वाणि शिक्षयति सत्यश्च भवति न चातथ्यः, अतः स युष्मान् यद्वद् अशिक्षयत् तद्वत् तत्र स्थास्यथ।</para>
  <para style="p">
    <verse number="28" style="v"/>अतएव हे प्रियबालका यूयं तत्र तिष्ठत, तथा सति स यदा प्रकाशिष्यते तदा वयं प्रतिभान्विता भविष्यामः, तस्यागमनसमये च तस्य साक्षान्न त्रपिष्यामहे।</para>
  <para style="p">
    <verse number="29" style="v"/>स धार्म्मिको ऽस्तीति यदि यूयं जानीथ तर्हि यः कश्चिद् धर्म्माचारं करोति स तस्मात् जात इत्यपि जानीत।</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>पश्यत वयम् ईश्वरस्य सन्ताना इति नाम्नाख्यामहे, एतेन पितास्मभ्यं कीदृक् महाप्रेम प्रदत्तवान्, किन्तु संसारस्तं नाजानात् तत्कारणादस्मान् अपि न जानाति।</para>
  <para style="p">
    <verse number="2" style="v"/>हे प्रियतमाः, इदानीं वयम् ईश्वरस्य सन्ताना आस्महे पश्चात् किं भविष्यामस्तद् अद्याप्यप्रकाशितं किन्तु प्रकाशं गते वयं तस्य सदृशा भविष्यामि इति जानीमः, यतः स यादृशो ऽस्ति तादृशो ऽस्माभिर्दर्शिष्यते।</para>
  <para style="p">
    <verse number="3" style="v"/>तस्मिन् एषा प्रत्याशा यस्य कस्यचिद् भवति स स्वं तथा पवित्रं करोति यथा स पवित्रो ऽस्ति।</para>
  <para style="p">
    <verse number="4" style="v"/>यः कश्चित् पापम् आचरति स व्यवस्थालङ्घनं करोति यतः पापमेव व्यवस्थालङ्घनं।</para>
  <para style="p">
    <verse number="5" style="v"/>अपरं सो ऽस्माकं पापान्यपहर्त्तुं प्राकाशतैतद् यूयं जानीथ, पापञ्च तस्मिन् न विद्यते।</para>
  <para style="p">
    <verse number="6" style="v"/>यः कश्चित् तस्मिन् तिष्ठति स पापाचारं न करोति यः कश्चित् पापाचारं करोति स तं न दृष्टवान् न वावगतवान्।</para>
  <para style="p">
    <verse number="7" style="v"/>हे प्रियबालकाः, कश्चिद् युष्माकं भ्रमं न जनयेत्, यः कश्चिद् धर्म्माचारं करोति स तादृग् धार्म्मिको भवति यादृक् स धाम्मिको ऽस्ति।</para>
  <para style="p">
    <verse number="8" style="v"/>यः पापाचारं करोति स शयतानात् जातो यतः शयतान आदितः पापाचारी शयतानस्य कर्म्मणां लोपार्थमेवेश्वरस्य पुत्रः प्राकाशत।</para>
  <para style="p">
    <verse number="9" style="v"/>यः कश्चिद् ईश्वरात् जातः स पापाचारं न करोति यतस्तस्य वीर्य्यं तस्मिन् तिष्ठति पापाचारं कर्त्तुञ्च न शक्नोति यतः स ईश्वरात् जातः।</para>
  <para style="p">
    <verse number="10" style="v"/>इत्यनेनेश्वरस्य सन्तानाः शयतानस्य च सन्ताना व्यक्ता भवन्ति। यः कश्चिद् धर्म्माचारं न करोति स ईश्वरात् जातो नहि यश्च स्वभ्रातरि न प्रीयते सो ऽपीश्वरात् जातो नहि।</para>
  <para style="p">
    <verse number="11" style="v"/>यतस्तस्य य आदेश आदितो युष्माभिः श्रुतः स एष एव यद् अस्माभिः परस्परं प्रेम कर्त्तव्यं।</para>
  <para style="p">
    <verse number="12" style="v"/>पापात्मतो जातो यः काबिल् स्वभ्रातरं हतवान् तत्सदृशैरस्माभि र्न भवितव्यं। स कस्मात् कारणात् तं हतवान्? तस्य कर्म्माणि दुष्टानि तद्भ्रातुश्च कर्म्माणि धर्म्माण्यासन् इति कारणात्।</para>
  <para style="p">
    <verse number="13" style="v"/>हे मम भ्रातरः, संसारो यदि युष्मान् द्वेष्टि तर्हि तद् आश्चर्य्यं न मन्यध्वं।</para>
  <para style="p">
    <verse number="14" style="v"/>वयं मृत्युम् उत्तीर्य्य जीवनं प्राप्तवन्तस्तद् भ्रातृषु प्रेमकरणात् जानीमः। भ्रातरि यो न प्रीयते स मृत्यौ तिष्ठति।</para>
  <para style="p">
    <verse number="15" style="v"/>यः कश्चित् स्वभ्रातरं द्वेष्टि सं नरघाती किञ्चानन्तजीवनं नरघातिनः कस्याप्यन्तरे नावतिष्ठते तद् यूयं जानीथ।</para>
  <para style="p">
    <verse number="16" style="v"/>अस्माकं कृते स स्वप्राणांस्त्यक्तवान् इत्यनेन वयं प्रेम्नस्तत्त्वम् अवगताः, अपरं भ्रातृणां कृते ऽस्माभिरपि प्राणास्त्यक्तव्याः।</para>
  <para style="p">
    <verse number="17" style="v"/>सांसारिकजीविकाप्राप्तो यो जनः स्वभ्रातरं दीनं दृष्ट्वा तस्मात् स्वीयदयां रुणद्धि तस्यान्तर ईश्वरस्य प्रेम कथं तिष्ठेत्?</para>
  <para style="p">
    <verse number="18" style="v"/>हे मम प्रियबालकाः, वाक्येन जिह्वया वास्माभिः प्रेम न कर्त्तव्यं किन्तु कार्य्येण सत्यतया चैव।</para>
  <para style="p">
    <verse number="19" style="v"/>एतेन वयं यत् सत्यमतसम्बन्धीयास्तत् जानीमस्तस्य साक्षात् स्वान्तःकरणानि सान्त्वयितुं शक्ष्यामश्च।</para>
  <para style="p">
    <verse number="20" style="v"/>यतो ऽस्मदन्तःकरणं यद्यस्मान् दूषयति तर्ह्यस्मदन्तः करणाद् ईश्वरो महान् सर्व्वज्ञश्च।</para>
  <para style="p">
    <verse number="21" style="v"/>हे प्रियतमाः, अस्मदन्तःकरणं यद्यस्मान् न दूषयति तर्हि वयम् ईश्वरस्य साक्षात् प्रतिभान्विता भवामः।</para>
  <para style="p">
    <verse number="22" style="v"/>यच्च प्रार्थयामहे तत् तस्मात् प्राप्नुमः, यतो वयं तस्याज्ञाः पालयामस्तस्य साक्षात् तुष्टिजनकम् आचारं कुर्म्मश्च।</para>
  <para style="p">
    <verse number="23" style="v"/>अपरं तस्येयमाज्ञा यद् वयं पुत्रस्य यीशुख्रीष्टस्य नाम्नि विश्वसिमस्तस्याज्ञानुसारेण च परस्परं प्रेम कुर्म्मः।</para>
  <para style="p">
    <verse number="24" style="v"/>यश्च तस्याज्ञाः पालयति स तस्मिन् तिष्ठति तस्मिन् सोऽपि तिष्ठति; स चास्मान् यम् आत्मानं दत्तवान् तस्मात् सो ऽस्मासु तिष्ठतीति जानीमः।</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>हे प्रियतमाः, यूयं सर्व्वेष्वात्मसु न विश्वसित किन्तु ते ईश्वरात् जाता न वेत्यात्मनः परीक्षध्वं यतो बहवो मृषाभविष्यद्वादिनो जगन्मध्यम् आगतवन्तः।</para>
  <para style="p">
    <verse number="2" style="v"/>ईश्वरीयो य आत्मा स युष्माभिरनेन परिचीयतां, यीशुः ख्रीष्टो नरावतारो भूत्वागत एतद् येन केनचिद् आत्मना स्वीक्रियते स ईश्वरीयः।</para>
  <para style="p">
    <verse number="3" style="v"/>किन्तु यीशुः ख्रीष्टो नरावतारो भूत्वागत एतद् येन केनचिद् आत्मना नाङ्गीक्रियते स ईश्वरीयो नहि किन्तु ख्रीष्टारेरात्मा, तेन चागन्तव्यमिति युष्माभिः श्रुतं, स चेदानीमपि जगति वर्त्तते।</para>
  <para style="p">
    <verse number="4" style="v"/>हे बालकाः, यूयम् ईश्वरात् जातास्तान् जितवन्तश्च यतः संसाराधिष्ठानकारिणो ऽपि युष्मदधिष्ठानकारी महान्।</para>
  <para style="p">
    <verse number="5" style="v"/>ते संसारात् जातास्ततो हेतोः संसाराद् भाषन्ते संसारश्च तेषां वाक्यानि गृह्लाति।</para>
  <para style="p">
    <verse number="6" style="v"/>वयम् ईश्वरात् जाताः, ईश्वरं यो जानाति सोऽस्मद्वाक्यानि गृह्लाति यश्चेश्वरात् जातो नहि सोऽस्मद्वाक्यानि न गृह्लाति; अनेन वयं सत्यात्मानं भ्रामकात्मानञ्च परिचिनुमः।</para>
  <para style="p">
    <verse number="7" style="v"/>हे प्रियतमाः, वयं परस्परं प्रेम करवाम, यतः प्रेम ईश्वरात् जायते, अपरं यः कश्चित् प्रेम करोति स ईश्वरात् जात ईश्वरं वेत्ति च।</para>
  <para style="p">
    <verse number="8" style="v"/>यः प्रेम न करोति स ईश्वरं न जानाति यत ईश्वरः प्रेमस्वरूपः।</para>
  <para style="p">
    <verse number="9" style="v"/>अस्मास्वीश्वरस्य प्रेमैतेन प्राकाशत यत् स्वपुत्रेणास्मभ्यं जीवनदानार्थम् ईश्वरः स्वीयम् अद्वितीयं पुत्रं जगन्मध्यं प्रेषितवान्।</para>
  <para style="p">
    <verse number="10" style="v"/>वयं यद् ईश्वरे प्रीतवन्त इत्यत्र नहि किन्तु स यदस्मासु प्रीतवान् अस्मत्पापानां प्रायश्चिर्त्तार्थं स्वपुत्रं प्रेषितवांश्चेत्यत्र प्रेम सन्तिष्ठते।</para>
  <para style="p">
    <verse number="11" style="v"/>हे प्रियतमाः, अस्मासु यदीश्वरेणैतादृशं प्रेम कृतं तर्हि परस्परं प्रेम कर्त्तुम् अस्माकमप्युचितं।</para>
  <para style="p">
    <verse number="12" style="v"/>ईश्वरः कदाच केनापि न दृष्टः यद्यस्माभिः परस्परं प्रेम क्रियते तर्हीश्वरो ऽस्मन्मध्ये तिष्ठति तस्य प्रेम चास्मासु सेत्स्यते।</para>
  <para style="p">
    <verse number="13" style="v"/>अस्मभ्यं तेन स्वकीयात्मनोंऽशो दत्त इत्यनेन वयं यत् तस्मिन् तिष्ठामः स च यद् अस्मासु तिष्ठतीति जानीमः।</para>
  <para style="p">
    <verse number="14" style="v"/>पिता जगत्रातारं पुत्रं प्रेषितवान् एतद् वयं दृष्ट्वा प्रमाणयामः।</para>
  <para style="p">
    <verse number="15" style="v"/>यीशुरीश्वरस्य पुत्र एतद् येनाङ्गीक्रियते तस्मिन् ईश्वरस्तिष्ठति स चेश्वरे तिष्ठति।</para>
  <para style="p">
    <verse number="16" style="v"/>अस्मास्वीश्वरस्य यत् प्रेम वर्त्तते तद् वयं ज्ञातवन्तस्तस्मिन् विश्वासितवन्तश्च। ईश्वरः प्रेमस्वरूपः प्रेम्नी यस्तिष्ठति स ईश्वरे तिष्ठति तस्मिंश्चेश्वरस्तिष्ठति।</para>
  <para style="p">
    <verse number="17" style="v"/>स यादृशो ऽस्ति वयमप्येतस्मिन् जगति तादृशा भवाम एतस्माद् विचारदिने ऽस्माभि र्या प्रतिभा लभ्यते सास्मत्सम्बन्धीयस्य प्रेम्नः सिद्धिः।</para>
  <para style="p">
    <verse number="18" style="v"/>प्रेम्नि भीति र्न वर्त्तते किन्तु सिद्धं प्रेम भीतिं निराकरोति यतो भीतिः सयातनास्ति भीतो मानवः प्रेम्नि सिद्धो न जातः।</para>
  <para style="p">
    <verse number="19" style="v"/>अस्मासु स प्रथमं प्रीतवान् इति कारणाद् वयं तस्मिन् प्रीयामहे।</para>
  <para style="p">
    <verse number="20" style="v"/>ईश्वरे ऽहं प्रीय इत्युक्त्वा यः कश्चित् स्वभ्रातरं द्वेष्टि सो ऽनृतवादी। स यं दृष्टवान् तस्मिन् स्वभ्रातरि यदि न प्रीयते तर्हि यम् ईश्वरं न दृष्टवान् कथं तस्मिन् प्रेम कर्त्तुं शक्नुयात्?</para>
  <para style="p">
    <verse number="21" style="v"/>अत ईश्वरे यः प्रीयते स स्वीयभ्रातर्य्यपि प्रीयताम् इयम् आज्ञा तस्माद् अस्माभि र्लब्धा।</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>यीशुरभिषिक्तस्त्रातेति यः कश्चिद् विश्वासिति स ईश्वरात् जातः; अपरं यः कश्चित् जनयितरि प्रीयते स तस्मात् जाते जने ऽपि प्रीयते।</para>
  <para style="p">
    <verse number="2" style="v"/>वयम् ईश्वरस्य सन्तानेषु प्रीयामहे तद् अनेन जानीमो यद् ईश्वरे प्रीयामहे तस्याज्ञाः पालयामश्च।</para>
  <para style="p">
    <verse number="3" style="v"/>यत ईश्वरे यत् प्रेम तत् तदीयाज्ञापालनेनास्माभिः प्रकाशयितव्यं, तस्याज्ञाश्च कठोरा न भवन्ति।</para>
  <para style="p">
    <verse number="4" style="v"/>यतो यः कश्चिद् ईश्वरात् जातः स संसारं जयति किञ्चास्माकं यो विश्वासः स एवास्माकं संसारजयिजयः।</para>
  <para style="p">
    <verse number="5" style="v"/>यीशुरीश्वरस्य पुत्र इति यो विश्वसिति तं विना कोऽपरः संसारं जयति?</para>
  <para style="p">
    <verse number="6" style="v"/>सोऽभिषिक्तस्त्राता यीशुस्तोयरुधिराभ्याम् आगतः केवलं तोयेन नहि किन्तु तोयरुधिराभ्याम्, आत्मा च साक्षी भवति यत आत्मा सत्यतास्वरूपः।</para>
  <para style="p">
    <verse number="7" style="v"/>यतो हेतोः स्वर्गे पिता वादः पवित्र आत्मा च त्रय इमे साक्षिणः सन्ति, त्रय इमे चैको भवन्ति।</para>
  <para style="p">
    <verse number="8" style="v"/>तथा पृथिव्याम् आत्मा तोयं रुधिरञ्च त्रीण्येतानि साक्ष्यं ददाति तेषां त्रयाणाम् एकत्वं भवति च।</para>
  <para style="p">
    <verse number="9" style="v"/>मानवानां साक्ष्यं यद्यस्माभि र्गृह्यते तर्हीश्वरस्य साक्ष्यं तस्मादपि श्रेष्ठं यतः स्वपुत्रमधीश्वरेण दत्तं साक्ष्यमिदं।</para>
  <para style="p">
    <verse number="10" style="v"/>ईश्वरस्य पुत्रे यो विश्वासिति स निजान्तरे तत् साक्ष्यं धारयति; ईश्वरे यो न विश्वसिति स तम् अनृतवादिनं करोति यत ईश्वरः स्वपुत्रमधि यत् साक्ष्यं दत्तवान् तस्मिन् स न विश्वसिति।</para>
  <para style="p">
    <verse number="11" style="v"/>तच्च साक्ष्यमिदं यद् ईश्वरो ऽस्मभ्यम् अनन्तजीवनं दत्तवान् तच्च जीवनं तस्य पुत्रे विद्यते।</para>
  <para style="p">
    <verse number="12" style="v"/>यः पुत्रं धारयति स जीवनं धारियति, ईश्वरस्य पुत्रं यो न धारयति स जीवनं न धारयति।</para>
  <para style="p">
    <verse number="13" style="v"/>ईश्वरपुत्रस्य नाम्नि युष्मान् प्रत्येतानि मया लिखितानि तस्याभिप्रायो ऽयं यद् यूयम् अनन्तजीवनप्राप्ता इति जानीयात तस्येश्वरपुत्रस्य नाम्नि विश्वसेत च।</para>
  <para style="p">
    <verse number="14" style="v"/>तस्यान्तिके ऽस्माकं या प्रतिभा भवति तस्याः कारणमिदं यद् वयं यदि तस्याभिमतं किमपि तं याचामहे तर्हि सो ऽस्माकं वाक्यं शृणोति।</para>
  <para style="p">
    <verse number="15" style="v"/>स चास्माकं यत् किञ्चन याचनं शृणोतीति यदि जानीमस्तर्हि तस्माद् याचिता वरा अस्माभिः प्राप्यन्ते तदपि जानीमः।</para>
  <para style="p">
    <verse number="16" style="v"/>कश्चिद् यदि स्वभ्रातरम् अमृत्युजनकं पापं कुर्व्वन्तं पश्यति तर्हि स प्रार्थनां करोतु तेनेश्वरस्तस्मै जीवनं दास्यति, अर्थतो मृत्युजनकं पापं येन नाकारितस्मै। किन्तु मृत्युजनकम् एकं पापम् आस्ते तदधि तेन प्रार्थना क्रियतामित्यहं न वदामि।</para>
  <para style="p">
    <verse number="17" style="v"/>सर्व्व एवाधर्म्मः पापं किन्तु सर्व्वपांप मृत्युजनकं नहि।</para>
  <para style="p">
    <verse number="18" style="v"/>य ईश्वरात् जातः स पापाचारं न करोति किन्त्वीश्वरात् जातो जनः स्वं रक्षति तस्मात् स पापात्मा तं न स्पृशतीति वयं जानीमः।</para>
  <para style="p">
    <verse number="19" style="v"/>वयम् ईश्वरात् जाताः किन्तु कृत्स्नः संसारः पापात्मनो वशं गतो ऽस्तीति जानीमः।</para>
  <para style="p">
    <verse number="20" style="v"/>अपरम् ईश्वरस्य पुत्र आगतवान् वयञ्च यया तस्य सत्यमयस्य ज्ञानं प्राप्नुयामस्तादृशीं धियम् अस्मभ्यं दत्तवान् इति जानीमस्तस्मिन् सत्यमये ऽर्थतस्तस्य पुत्रे यीशुख्रीष्टे तिष्ठामश्च; स एव सत्यमय ईश्वरो ऽनन्तजीवनस्वरूपश्चास्ति।</para>
  <para style="p">
    <verse number="21" style="v"/>हे प्रियबालकाः, यूयं देवमूर्त्तिभ्यः स्वान् रक्षत। आमेन्।</para>
</usx>
