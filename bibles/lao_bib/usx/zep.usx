<usx version="3.0">
  <book code="ZEP" style="id">- Biblica® Open Lao Contemporary Version</book>
  <para style="rem">Copyright © 2023, 2025 by Biblica, Inc.</para>
  <para style="h">ເຊຟານິຢາ</para>
  <para style="toc1">ພຣະທຳເຊຟານີຢາ</para>
  <para style="toc2">ເຊຟານິຢາ</para>
  <para style="toc3">ຊຟຢ</para>
  <para style="mt1">ພຣະທຳເຊຟານີຢາ</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="ZEP 1" />
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />ຖ້ອຍຄຳ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ ທີ່​ມາ​ເຖິງ​ເຊຟານີຢາ ລູກຊາຍ​ຂອງ​ກູຊີ, ຜູ້​ເປັນ​ລູກຊາຍ​ຂອງ​ເກດາລິຢາ, ຜູ້​ເປັນ​ລູກຊາຍ​ຂອງ​ອາມາຣີຢາ, ຜູ້​ເປັນ​ລູກຊາຍ​ຂອງ​ເຮເຊກີຢາ, ໃນ​ຊ່ວງ​ເວລາ​ຂອງ​ການ​ປົກຄອງ​ຂອງ​ໂຢຊີຢາ ລູກຊາຍ​ຂອງ​ອາໂມນ ກະສັດ​ແຫ່ງ​ຢູດາຍ​ມີ​ດັ່ງນີ້:<verse eid="ZEP 1:1" /></para>
  <para style="b" />
  <para style="s1">ການ​ຕັດສິນ​ທົ່ວ​ໂລກ​ໃນ​ວັນ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 1:2" />“ເຮົາ​ຈະ​ກວາດ​ລ້າງ​ທຸກສິ່ງ</para>
  <para style="q2" vid="ZEP 1:2">ອອກ​ໄປ​ຈາກ​ໜ້າ​ແຜ່ນດິນໂລກ”,</para>
  <para style="q2" vid="ZEP 1:2">ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ປະກາດ​ດັ່ງນັ້ນ.<verse eid="ZEP 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 1:3" />“ເຮົາ​ຈະ​ກວາດ​ລ້າງ​ທັງ​ຄົນ ແລະ ສັດ​ອອກ​ໄປ;</para>
  <para style="q2" vid="ZEP 1:3">ເຮົາ​ຈະ​ກວດ​ລ້າງ​ນົກ​ໃນ​ອາກາດ</para>
  <para style="q2" vid="ZEP 1:3">ແລະ ປາ​ໃນ​ທະເລ</para>
  <para style="q2" vid="ZEP 1:3">ແລະ ຮູບເຄົາລົບ​ທັງຫລາຍ​ທີ່​ເຮັດ​ໃຫ້​ຄົນ​ຊົ່ວຮ້າຍ​ສະດຸດ​ນັ້ນ​ອອກ​ໄປ”.<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">ໃນ​ພາສາ​ເຮັບເຣີ​ວັກ​ນີ້ </char><char style="fqa" closed="false">ມີ​ຄວາມຫມາຍ​ບໍ່​ຊັດເຈນ</char></note></para>
  <para style="b" vid="ZEP 1:3" />
  <para style="q1" vid="ZEP 1:3">“ເມື່ອ​ເຮົາ​ທຳລາຍ​ມະນຸດ​ທຸກຄົນ</para>
  <para style="q2" vid="ZEP 1:3">ທີ່​ຢູ່​ເທິງ​ໜ້າ​ແຜ່ນດິນ​ໂລກ”,</para>
  <para style="q2" vid="ZEP 1:3">ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ປະກາດ​ດັ່ງນັ້ນ,<verse eid="ZEP 1:3" /></para>
  <para style="s1">ກ່າວ​ໂທດ​ຢູດາຍ</para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 1:4" />“ເຮົາ​ຈະ​ຢຽດ​ມື​ຂອງ​ເຮົາ​ອອກ​ຕໍ່ສູ້​ຢູດາຍ</para>
  <para style="q2" vid="ZEP 1:4">ແລະ ຕໍ່ສູ້​ທຸກ​ຄົນ​ທີ່​ຢູ່​ໃນ​ເຢຣູຊາເລັມ.</para>
  <para style="q1" vid="ZEP 1:4">ເຮົາ​ຈະ​ທຳລາຍ​ທຸກ​ການ​ບູຊາ​ພະບາອານ​ທີ່​ເຫລືອ​ຢູ່​ໃຫ້​ໝົດ​ໄປ​ຈາກ​ບ່ອນ​ນີ້,</para>
  <para style="q2" vid="ZEP 1:4">ແລະ ບັນດາ​ຊື່​ຂອງ​ບັນດາ​ປະໂລຫິດ​ທີ່​ບູຊາ​ຮູບເຄົາລົບ​ນັ້ນ<verse eid="ZEP 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5" />ຄື​ບັນດາ​ຄົນ​ທີ່​ກົ້ມ​ຂາບ​ຢູ່​ເທິງ​ດາດ​ຟ້າ</para>
  <para style="q2" vid="ZEP 1:5">ເພື່ອ​ນະມັດສະການ​ດາວ​ຕ່າງ​ໆ,</para>
  <para style="q1" vid="ZEP 1:5">ບັນດາ​ຜູ້​ກົ້ມ​ຂາບ​ລົງ ແລະ ສາບານ​ໂດຍ​ອ້າງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q2" vid="ZEP 1:5">ແລະ ອ້າງ​ພະໂມລົກ,<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ </char><char style="fqa" closed="false">ມັນຄຳ ນັ້ນ​ຄື ມິນໂກນ</char></note><verse eid="ZEP 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6" />ບັນດາ​ຜູ້​ເຊົາ​ຕິດຕາມ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q2" vid="ZEP 1:6">ບໍ່​ໄດ້​ສະແຫວງຫາ​ພຣະເຈົ້າ​ຢາເວ ຫລື ຖາມ​ພຣະອົງ”.<verse eid="ZEP 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7" />ຈົ່ງ​ສະຫງົບ​ຢູ່​ຕໍ່ໜ້າ​ພຣະເຈົ້າ​ຢາເວ ອົງ​ເຈົ້ານາຍ,</para>
  <para style="q2" vid="ZEP 1:7">ເພາະ​ມື້​ແຫ່ງ​ພຣະເຈົ້າ​ຢາເວ​ນັ້ນ​ໃກ້​ເຂົ້າ​ມາ​ແລ້ວ.</para>
  <para style="q1" vid="ZEP 1:7">ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ຈັດ​ຕຽມ​ເຄື່ອງ​ບູຊາ;</para>
  <para style="q2" vid="ZEP 1:7">ພຣະອົງ​ໄດ້​ຊຳລະ​ບັນດາ​ຜູ້​ທີ່​ພຣະອົງ​ເຊີນ​ມາ​ນັ້ນ​ໃຫ້​ບໍລິສຸດ.<verse eid="ZEP 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8" />ໃນ​ມື້​ຖວາຍ​ເຄື່ອງ​ບູຊາ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ນັ້ນ</para>
  <para style="q2" vid="ZEP 1:8">ເຮົາ​ຈະ​ລົງໂທດ​ບັນດາ​ເຈົ້າໜ້າທີ່</para>
  <para style="q2" vid="ZEP 1:8">ແລະ ລູກຊາຍ​ຂອງ​ກະສັດ</para>
  <para style="q1" vid="ZEP 1:8">ແລະ ລົງໂທດ​ຄົນ​ທັງປວງ</para>
  <para style="q2" vid="ZEP 1:8">ທີ່​ປະຕິບັດ​ຕາມ​ທຳນຽມ​ຂອງ​ຄົນ​ຕ່າງ​ຊາດ.<verse eid="ZEP 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9" />ໃນ​ມື້​ນັ້ນ​ເຮົາ​ຈະ​ລົງໂທດ</para>
  <para style="q2" vid="ZEP 1:9">ທຸກຄົນ​ທີ່​ບໍ່​ຢຽບ​ຂອບ​ປະຕູ​ເຮືອນ,<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="1SA 5:5">1ຊມອ 5:5</ref></char></char></note></para>
  <para style="q1" vid="ZEP 1:9">ຜູ້​ທີ່​ເຮັດ​ໃຫ້​ວິຫານ​ຂອງ​ບັນດາ​ພະ​ຂອງ​ຕົນ</para>
  <para style="q2" vid="ZEP 1:9">ເຕັມ​ໄປ​ດ້ວຍ​ຄວາມ​ຮຸນແຮງ ແລະ ການ​ຫລອກລວງ.<verse eid="ZEP 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 1:10" />“ໃນ​ມື້​ນັ້ນ,”</para>
  <para style="q2" vid="ZEP 1:10">ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ປະກາດ​ໄວ້​ວ່າ,</para>
  <para style="q1" vid="ZEP 1:10">“ຈະ​ມີ​ສຽງ​ຮ້ອງ​ດັງ​ຂຶ້ນ​ມາ​ຈາກ​ປະຕູ​ປາ,</para>
  <para style="q2" vid="ZEP 1:10">ມີ​ສຽງ​ຮ້ອງໄຫ້​ຈາກ​ເຂດ​ທີ່​ສ້າງ​ໃໝ່​ຂອງ​ຕົວ​ເມືອງ,</para>
  <para style="q2" vid="ZEP 1:10">ແລະ ມີ​ສຽງ​ກະແທກ​ດັງ​ມາ​ຈາກ​ເນີນພູ​ຕ່າງ​ໆ.<verse eid="ZEP 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11" />ຈົ່ງ​ຮ້ອງໄຫ້, ເຈົ້າ​ຜູ້​ທີ່​ອາໄສ​ຢູ່​ໃນ​ເຂດ​ຕະຫລາດ;</para>
  <para style="q2" vid="ZEP 1:11">ພໍ່ຄ້າ​ທັງໝົດ​ຂອງ​ເຈົ້າ​ຈະ​ຖືກ​ກວາດ​ລ້າງ​ໄປ,</para>
  <para style="q2" vid="ZEP 1:11">ບັນດາ​ພໍ່ຄ້າ​ເຄື່ອງ​ເງິນ​ກໍ​ຈະ​ຖືກ​ທຳລາຍ.<verse eid="ZEP 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12" />ໃນ​ເວລາ​ນັ້ນ ເຮົາ​ຈະ​ຖື​ຕະກຽງ​ສ່ອງ​ຫາ​ເຢຣູຊາເລັມ</para>
  <para style="q2" vid="ZEP 1:12">ແລະ ລົງໂທດ​ບັນດາ​ຄົນ​ທີ່​ອິ່ມໃຈ,</para>
  <para style="q2" vid="ZEP 1:12">ຜູ້​ທີ່​ເປັນ​ຄື​ເຫລົ້າອະງຸ່ນ​ທີ່​ເຫລືອ​ຢູ່​ໃນ​ກາກ​ຂອງ​ມັນ,</para>
  <para style="q1" vid="ZEP 1:12">ຜູ້​ທີ່​ຄິດ​ວ່າ, ‘ພຣະເຈົ້າ​ຢາເວ​ຈະ​ບໍ່​ເຮັດ​ຫຍັງ,</para>
  <para style="q2" vid="ZEP 1:12">ບໍ່​ວ່າ​ດີ ຫລື ຮ້າຍ’.<verse eid="ZEP 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13" />ຊັບສົມບັດ​ຂອງ​ພວກເຂົາ​ຈະ​ຖືກ​ປຸ້ນ,</para>
  <para style="q2" vid="ZEP 1:13">ເຮືອນ​ຂອງ​ພວກເຂົາ​ຈະ​ຖືກ​ພັງ​ລົງ,</para>
  <para style="q1" vid="ZEP 1:13">ເຖິງ​ວ່າ​ພວກເຂົາ​ຈະ​ສ້າງ​ເຮືອນ,</para>
  <para style="q2" vid="ZEP 1:13">ແຕ່​ພວກເຂົາ​ກໍ​ບໍ່​ໄດ້​ອາໄສ​ຢູ່​ໃນ​ນັ້ນ;</para>
  <para style="q1" vid="ZEP 1:13">ເຖິງ​ວ່າ​ພວກເຂົາ​ຈະ​ປູກ​ສວນ​ອະງຸ່ນ</para>
  <para style="q2" vid="ZEP 1:13">ແຕ່​ພວກເຂົາ​ກໍ​ຈະ​ບໍ່​ໄດ້​ດື່ມ​ເຫລົ້າອະງຸ່ນ.<verse eid="ZEP 1:13" /></para>
  <para style="b" />
  <para style="s1">ວັນ​ຍິ່ງໃຫຍ່​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14" />“ວັນ​ຍິ່ງໃຫຍ່​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ນັ້ນ​ມາ​ໃກ້​ແລ້ວ</para>
  <para style="q2" vid="ZEP 1:14">ມາ​ໃກ້ ແລະ ຈະ​ມາ​ເຖິງ​ໃນ​ໄວ​ໆ​ນີ້.</para>
  <para style="q1" vid="ZEP 1:14">ສຽງ​ຮ້ອງ​ໃນ​ວັນ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ກໍ​ຂົມຂື່ນ;</para>
  <para style="q2" vid="ZEP 1:14">ນັກຮົບ​ຜູ້​ຍິ່ງໃຫຍ່​ຈະ​ສົ່ງ​ສຽງ​ຮ້ອງ​ຕໍ່ສູ້.<verse eid="ZEP 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15" />ວັນ​ນັ້ນ​ຈະ​ເປັນ​ວັນ​ແຫ່ງ​ຄວາມ​ໂກດຮ້າຍ</para>
  <para style="q2" vid="ZEP 1:15">ວັນ​ແຫ່ງ​ຄວາມ​ທຸກຍາກ ແລະ ທຸກທໍລະມານ,</para>
  <para style="q3" vid="ZEP 1:15">ວັນ​ແຫ່ງ​ຄວາມ​ຫຍຸ້ງຍາກ ແລະ ພິນາດ,</para>
  <para style="q2" vid="ZEP 1:15">ວັນ​ແຫ່ງ​ຄວາມ​ມືດ​ມິດ ແລະ ເສົ້າໝອງ</para>
  <para style="q3" vid="ZEP 1:15">ວັນ​ທີ່​ມີ​ເມກ ແລະ ຄວາມ​ມືດ​ມິດ<verse eid="ZEP 1:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ZEP 1:16" />ວັນ​ແຫ່ງ​ສຽງ​ແກ ແລະ ສຽງ​ໂຫ່​ຮ້ອງ</para>
  <para style="q1" vid="ZEP 1:16">ສູ້ຮົບ​ກັບ​ບັນດາ​ເມືອງ​ທີ່​ມີ​ປ້ອມ​ປ້ອງກັນ</para>
  <para style="q2" vid="ZEP 1:16">ແລະ ສູ້ຮົບ​ກັບ​ຫໍຄອຍ​ທຸກ​ມຸມ​ຂອງ​ເມືອງ.<verse eid="ZEP 1:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17" />“ເຮົາ​ຈະ​ນຳ​ຄວາມ​ທຸກຍາກ​ມາ​ສູ່​ປະຊາຊົນ​ທັງໝົດ</para>
  <para style="q2" vid="ZEP 1:17">ເພື່ອ​ວ່າ​ພວກເຂົາ​ຈະ​ງົມ​ທາວ​ໄປ​ມາ​ເໝືອນດັ່ງ​ຄົນ​ຕາບອດ,</para>
  <para style="q2" vid="ZEP 1:17">ເພາະ​ພວກເຂົາ​ໄດ້​ເຮັດ​ບາບ​ຕໍ່​ພຣະເຈົ້າ​ຢາເວ.</para>
  <para style="q1" vid="ZEP 1:17">ເລືອດ​ຂອງ​ພວກເຂົາ​ຈະ​ໄຫລ​ອອກ​ມາ​ເໝືອນ​ກັບ​ຂີ້ຝຸ່ນ</para>
  <para style="q2" vid="ZEP 1:17">ແລະ ອະໄວຍະວະ​ພາຍ​ໃນ​ຂອງ​ພວກເຂົາ​ກໍ​ເປັນ​ເໝືອນ​ຂີ້​ສັດ<verse eid="ZEP 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18" />ບໍ່​ວ່າ​ຈະ​ເປັນ​ເງິນ ແລະ ຄຳ​ຂອງ​ພວກເຂົາ</para>
  <para style="q2" vid="ZEP 1:18">ກໍ​ບໍ່​ສາມາດ​ຊ່ວຍ​ພວກເຂົາ​ໄດ້</para>
  <para style="q2" vid="ZEP 1:18">ໃນ​ວັນ​ແຫ່ງ​ຄວາມ​ໂກດຮ້າຍ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ”.</para>
  <para style="b" vid="ZEP 1:18" />
  <para style="q1" vid="ZEP 1:18">ດ້ວຍ​ໄຟ​ແຫ່ງ​ຄວາມ​ຫຶງຫວງ​ຂອງ​ພຣະອົງ</para>
  <para style="q2" vid="ZEP 1:18">ໂລກ​ທັງໝົດ​ຈະ​ຖືກ​ເຜົາໄໝ້,</para>
  <para style="q1" vid="ZEP 1:18">ເພາະ​ພຣະອົງ​ຈະ​ເຮັດ​ໃຫ້​ສິ່ງ​ມີ​ຊີວິດ​ທຸກ​ຢ່າງ​ໃນ​ໂລກ​ນີ້</para>
  <para style="q2" vid="ZEP 1:18">ເຖິງ​ຈຸດ​ຈົບ​ຢ່າງ​ວ່ອງໄວ​ທີ່​ສຸດ.<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" sid="ZEP 2" />
  <para style="s1">ຢູດາ ແລະ ເຢຣູຊາເລັມ​ຖືກ​ພິພາກສາ​ພ້ອມ​ດ້ວຍ​ຊົນຊາດ​ທັງຫລາຍ</para>
  <para style="s2">ຢູດາ​ຖືກ​ເອີ້ນ​ໃຫ້​ກັບໃຈ​ໃໝ່</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 2:1" />ຈົ່ງ​ເຕົ້າໂຮມ​ກັນ, ຈົ່ງ​ຮວມ​ຕົວ​ກັນ,</para>
  <para style="q2" vid="ZEP 2:1">ຊົນຊາດ​ທີ່​ໜ້າ​ອັບອາຍ,<verse eid="ZEP 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2" />ກ່ອນ​ທີ່​ດຳລັດ​ຈະ​ມີ​ຜົນ​ບັງຄັບ​ໃຊ້</para>
  <para style="q2" vid="ZEP 2:2">ແລະ ວັນ​ນັ້ນ​ກໍ​ຜ່ານ​ໄປ​ເໝືອນ​ດັ່ງ​ແກບ​ທີ່​ລົມ​ພັດ,</para>
  <para style="q1" vid="ZEP 2:2">ກ່ອນ​ທີ່​ຄວາມ​ໃຈຮ້າຍ​ອັນ​ຮຸນແຮງ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q2" vid="ZEP 2:2">ຈະ​ມາ​ເຖິງ​ເຈົ້າ,</para>
  <para style="q1" vid="ZEP 2:2">ກ່ອນ​ວັນ​ແຫ່ງ​ຄວາມ​ໂກດຮ້າຍ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q2" vid="ZEP 2:2">ຈະ​ລົງ​ມາ​ເໜືອ​ເຈົ້າ<verse eid="ZEP 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3" />ຈົ່ງ​ສະແຫວງ​ຫາ​ພຣະເຈົ້າ​ຢາເວ, ບັນດາ​ຜູ້​ຖ່ອມ​ໃຈ​ໃນ​ແຜ່ນດິນ,</para>
  <para style="q2" vid="ZEP 2:3">ເຈົ້າ​ຜູ້​ເຮັດ​ຕາມ​ຄຳສັ່ງ​ຂອງ​ພຣະອົງ.</para>
  <para style="q1" vid="ZEP 2:3">ຈົ່ງ​ສະແຫວງ​ຫາ​ຄວາມ​ຊອບທຳ, ສະແຫວງ​ຫາ​ຄວາມ​ຖ່ອມ​ຕົວ</para>
  <para style="q2" vid="ZEP 2:3">ເພື່ອ​ວ່າ​ບາງ​ເທື່ອ​ເຈົ້າ​ຈະ​ໄດ້​ບ່ອນ​ກຳບັງ</para>
  <para style="q2" vid="ZEP 2:3">ໃນ​ວັນ​ແຫ່ງ​ຄວາມ​ໃຈຮ້າຍ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ.<verse eid="ZEP 2:3" /></para>
  <para style="s2">ຟີລິດສະຕິນ</para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 2:4" />ກາຊາ​ຈະ​ຖືກ​ປະ​ໃຫ້​ຮົກຮ້າງ</para>
  <para style="q2" vid="ZEP 2:4">ແລະ ອາຊະເກໂລນ​ຈະ​ຖືກ​ປ່ອຍ​ໃຫ້​ຫັກພັງ.</para>
  <para style="q1" vid="ZEP 2:4">ໃນ​ເວລາ​ຕອນ​ທ່ຽງ ອາຊະໂດດ​ຈະ​ຖືກ​ເຮັດ​ໃຫ້​ຫວ່າງເປົ່າ</para>
  <para style="q2" vid="ZEP 2:4">ແລະ ເອັກໂຣນ​ຖືກ​ຖອນ​ຮາກ.<verse eid="ZEP 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5" />ວິບັດ​ແກ່​ເຈົ້າ ຜູ້​ທີ່​ອາໄສ​ຢູ່​ແຄມ​ທະເລ,</para>
  <para style="q2" vid="ZEP 2:5">ຄົນ​ຊາວ​ເຄເຣທີ;</para>
  <para style="q1" vid="ZEP 2:5">ຖ້ອຍຄຳ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ກ່າວ​ໂທດ​ເຈົ້າ,</para>
  <para style="q2" vid="ZEP 2:5">ການາອານ​ດິນແດນ​ແຫ່ງ​ຊາວ​ຟີລິດສະຕິນ.</para>
  <para style="q1" vid="ZEP 2:5">ພຣະອົງ​ກ່າວ​ວ່າ, “ເຮົາ​ຈະ​ທຳລາຍ​ເຈົ້າ,</para>
  <para style="q2" vid="ZEP 2:5">ແລະ ຈະ​ບໍ່​ໃຫ້​ເຫລືອ​ແມ່ນ​ແຕ່​ຄົນ​ດຽວ”.<verse eid="ZEP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6" />ດິນແດນ​ແຄມ​ທະເລ​ຈະ​ກາຍ​ເປັນ​ທົ່ງຫຍ້າ</para>
  <para style="q2" vid="ZEP 2:6">ມີ​ນ້ຳສ້າງ​ສຳລັບ​ບັນດາ​ຄົນລ້ຽງສັດ</para>
  <para style="q2" vid="ZEP 2:6">ແລະ ມີ​ຄອກ​ສຳລັບ​ຝູງ​ສັດ.<verse eid="ZEP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7" />ດິນແດນ​ນັ້ນ​ຈະ​ເປັນ</para>
  <para style="q2" vid="ZEP 2:7">ຂອງ​ຄົນ​ຢູດາຍ​ທີ່​ເຫລືອ​ຢູ່;</para>
  <para style="q2" vid="ZEP 2:7">ພວກເຂົາ​ຈະ​ພົບ​ທົ່ງຫຍ້າ​ຢູ່​ບ່ອນ​ນັ້ນ.</para>
  <para style="q1" vid="ZEP 2:7">ພວກເຂົາ​ຈະ​ນອນ​ລົງ​ໃນ​ເວລາ​ຄ່ຳ</para>
  <para style="q2" vid="ZEP 2:7">ໃນ​ເຮືອນ​ຂອງ​ອາຊະເກໂລນ.</para>
  <para style="q1" vid="ZEP 2:7">ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ​ຂອງ​ພວກເຂົາ​ຈະ​ເບິ່ງແຍງ​ພວກເຂົາ</para>
  <para style="q2" vid="ZEP 2:7">ພຣະອົງ​ຈະ​ເຮັດ​ໃຫ້​ພວກເຂົາ​ຄືນ​ສູ່​ສະພາບ​ເດີມ.<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ຈະ​ນຳ​ຊະເລີຍ​ຂອງ​ພວກເຂົາ​ກັບ​ຄືນ​ມາ</char></note><verse eid="ZEP 2:7" /></para>
  <para style="s2">ໂມອາບ ແລະ ອຳໂມນ</para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 2:8" />“ເຮົາ​ໄດ້​ຍິນ​ຄຳ​ໝິ່ນປະໝາດ​ຂອງ​ໂມອາບ</para>
  <para style="q2" vid="ZEP 2:8">ແລະ ຄຳ​ເຢາະເຢີ້ຍ​ຂອງ​ຊາວ​ອຳໂມນ,</para>
  <para style="q1" vid="ZEP 2:8">ພວກເຂົາ​ໝິ່ນປະໝາດ​ປະຊາຊົນ​ຂອງ​ເຮົາ</para>
  <para style="q2" vid="ZEP 2:8">ແລະ ຂົ່ມຂູ່​ເອົາ​ດິນແດນ​ຂອງ​ພວກເຂົາ”.<verse eid="ZEP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9" />ເຫດສະນັ້ນ, ເຮົາ​ມີ​ຊີວິດ​ຢູ່​ຢ່າງ​ແນ່ນອນ​ສັນໃດ,</para>
  <para style="q2" vid="ZEP 2:9">ພຣະເຈົ້າຢາເວ​ຜູ້​ມີ​ລິດອຳນາດ​ຍິ່ງໃຫຍ່,</para>
  <para style="q2" vid="ZEP 2:9">ພຣະເຈົ້າ​ແຫ່ງ​ອິດສະຣາເອນ​ໄດ້​ປະກາດ​ວ່າ,</para>
  <para style="q1" vid="ZEP 2:9">“ໂມອາບ​ຈະ​ເປັນ​ເໝືອນ​ກັບ​ໂຊໂດມ,</para>
  <para style="q2" vid="ZEP 2:9">ແລະ ຊາວ​ອຳໂມນ​ກໍ​ຈະ​ເປັນ​ເໝືອນ​ກັບ​ໂກໂມຣາ​ຢ່າງ​ແນ່ນອນ​ສັນນັ້ນ</para>
  <para style="q1" vid="ZEP 2:9">ຄື​ເປັນ​ແຫລ່ງ​ພືດ ແລະ ບໍ່ເກືອ,</para>
  <para style="q2" vid="ZEP 2:9">ເປັນ​ດິນແດນ​ທີ່​ຮົກຮ້າງ​ຕະຫລອດ​ໄປ.</para>
  <para style="q1" vid="ZEP 2:9">ປະຊາຊົນ​ຂອງ​ເຮົາ​ທີ່​ເຫລືອ​ຢູ່​ຈະ​ປຸ້ນ​ພວກເຂົາ;</para>
  <para style="q2" vid="ZEP 2:9">ຊົນຊາດ​ຂອງ​ເຮົາ​ທີ່​ລອດ​ຊີວິດ​ຈະ​ຄອບຄອງ​ດິນແດນ​ຂອງ​ພວກເຂົາ”.<verse eid="ZEP 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 2:10" />ນີ້​ເປັນ​ຜົນ​ຕອບແທນ​ທີ່​ພວກເຂົາ​ຈະ​ໄດ້​ຮັບ​ຈາກ​ຄວາມ​ຍິ່ງ​ຈອງຫອງ​ຂອງ​ພວກເຂົາ,</para>
  <para style="q2" vid="ZEP 2:10">ສຳລັບ​ການ​ດູຖູກ ແລະ ເຢາະເຢີ້ຍ</para>
  <para style="q2" vid="ZEP 2:10">ປະຊາຊົນ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ຜູ້​ມີ​ລິດອຳນາດ​ຍິ່ງໃຫຍ່.<verse eid="ZEP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 2:11" />ພຣະເຈົ້າ​ຢາເວ​ຈະ​ເປັນ​ທີ່​ໜ້າ​ຢ້ານກົວ​ສຳລັບ​ພວກເຂົາ</para>
  <para style="q2" vid="ZEP 2:11">ເມື່ອ​ພຣະອົງ​ທຳລາຍ​ພະ​ທັງປວງ​ຂອງ​ແຜ່ນດິນ​ນັ້ນ.</para>
  <para style="q1" vid="ZEP 2:11">ປະຊາຊາດ​ທັງຫລາຍ​ທີ່​ຢູ່​ຫ່າງ​ໄກ​ຈະ​ກົ້ມກາບ​ຕໍ່​ພຣະອົງ,</para>
  <para style="q2" vid="ZEP 2:11">ທຸກ​ຄົນ​ໃນ​ດິນແດນ​ຂອງ​ຕົນ.<verse eid="ZEP 2:11" /></para>
  <para style="s2">ກ່າວ​ໂທດ​ກູເຊ</para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12" />“ຊາວ​ກູເຊ,<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">ຄື </char><char style="fqa" closed="false">ຄົນ​ທັງຫລາຍ​ຈາກ​ຝາກ​ເທິງ​ຂອງ​ລຸ່ມ​ແມ່ນ້ຳ​ນິນ</char></note> ເຈົ້າ​ກໍ​ເໝືອນ​ກັນ,</para>
  <para style="q2" vid="ZEP 2:12">ຈະ​ຖືກ​ປະຫານ​ດ້ວຍ​ດາບ​ຂອງ​ເຮົາ”.<verse eid="ZEP 2:12" /></para>
  <para style="s2">ກ່າວ​ໂທດ​ອັດຊີເຣຍ</para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 2:13" />ພຣະອົງ​ຈະ​ຢຽດ​ມື​ຂອງ​ພຣະອົງ​ອອກ​ໄປ​ທາງ​ເໜືອ</para>
  <para style="q2" vid="ZEP 2:13">ແລະ ທຳລາຍ​ອັດຊີເຣຍ,</para>
  <para style="q1" vid="ZEP 2:13">ຖິ້ມ​ເມືອງ​ນີເນເວ​ໄວ້​ໃຫ້​ໂດດດ່ຽວ,</para>
  <para style="q2" vid="ZEP 2:13">ແລະ ແຫ້ງແລ້ງ​ຄື​ກັບ​ຖິ່ນແຫ້ງແລ້ງກັນດານ.<verse eid="ZEP 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14" />ຝູງ​ແບ້, ຝູງ​ແກະ ແລະ ຝູງ​ງົວ​ຈະ​ນອນ​ຢູ່​ທີ່​ນັ້ນ</para>
  <para style="q2" vid="ZEP 2:14">ສິ່ງ​ມີ​ຊີວິດ​ທຸກ​ຊະນິດ.</para>
  <para style="q1" vid="ZEP 2:14">ນົກເຄົ້າ​ທະເລຊາຍ ແລະ ນົກເຄົ້າ​ແມວ</para>
  <para style="q2" vid="ZEP 2:14">ຈະ​ເກາະ​ຢູ່​ທີ່​ຊາກ​ເສົາ​ຂອງ​ເມືອງ​ນັ້ນ.</para>
  <para style="q1" vid="ZEP 2:14">ສຽງ​ຮ້ອງ​ຂອງ​ພວກມັນ​ຈະ​ດັງ​ກ້ອງ​ຜ່ານ​ປ່ອງຢ້ຽມ,</para>
  <para style="q2" vid="ZEP 2:14">ຊາກ​ຫັກພັງ​ຈະ​ເຕັມ​ປະຕູ</para>
  <para style="q2" vid="ZEP 2:14">ຄານ​ໄມ້ແປກ​ກໍ​ຈະ​ຖືກ​ຖິ້ມ​ໄວ້​ກາງແຈ້ງ.<verse eid="ZEP 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15" />ນີ້​ແມ່ນ​ເມືອງ​ແຫ່ງ​ຄວາມ​ສະໜຸກສະໜານ</para>
  <para style="q2" vid="ZEP 2:15">ເຊິ່ງ​ອາໄສ​ຢູ່​ຢ່າງ​ປອດໄພ.</para>
  <para style="q1" vid="ZEP 2:15">ມັນ​ເວົ້າ​ກັບ​ຕົນ​ເອງ​ວ່າ,</para>
  <para style="q2" vid="ZEP 2:15">“ຂ້ອຍ​ນີ້​ແຫລະ! ແລະ ບໍ່​ມີ​ຜູ້ໃດ​ນອກຈາກ​ຂ້ອຍ”.</para>
  <para style="q1" vid="ZEP 2:15">ມັນ​ກາຍ​ເປັນ​ຊາກ​ຫັກພັງ,</para>
  <para style="q2" vid="ZEP 2:15">ເປັນ​ບ່ອນ​ອາໄສ​ຂອງ​ສັດປ່າ!</para>
  <para style="q1" vid="ZEP 2:15">ທຸກຄົນ​ທີ່​ຜ່ານ​ໄປ​ມາ​ກໍ​ເຢາະເຢີ້ຍ​ມັນ</para>
  <para style="q2" vid="ZEP 2:15">ແລະ ສັ່ນ​ກຳປັ້ນ​ຂອງ​ຕົນ.<verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" sid="ZEP 3" />
  <para style="s2">ເຢຣູຊາເລັມ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 3:1" />ວິບັດ​ແກ່​ເມືອງ​ຂອງ​ຜູ້​ທີ່​ກົດຂີ່​ຂົ່ມເຫັງ,</para>
  <para style="q2" vid="ZEP 3:1">ກະບົດ ແລະ ມີ​ມົນທິນ!<verse eid="ZEP 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2" />ເມືອງ​ນີ້​ບໍ່​ຍອມ​ເຊື່ອຟັງ​ຜູ້ໃດ,</para>
  <para style="q2" vid="ZEP 3:2">ເມືອງ​ນີ້​ບໍ່​ຍອມຮັບ​ການ​ປັບປຸງ​ແກ້ໄຂ.</para>
  <para style="q1" vid="ZEP 3:2">ເມືອງ​ນີ້​ບໍ່​ໄວ້ໃຈ​ໃນ​ພຣະເຈົ້າ​ຢາເວ,</para>
  <para style="q2" vid="ZEP 3:2">ເມືອງ​ນີ້​ບໍ່​ຍອມ​ເຂົ້າ​ມາ​ໃກ້​ພຣະເຈົ້າ​ຂອງ​ຕົນ.<verse eid="ZEP 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3" />ຂ້າລາຊະການ​ຂອງ​ເມືອງ​ນີ້</para>
  <para style="q2" vid="ZEP 3:3">ເປັນ​ເໝືອນ​ໂຕ​ສິງ​ທີ່​ສົ່ງ​ສຽງ​ຮ້ອງ;</para>
  <para style="q1" vid="ZEP 3:3">ບັນດາ​ຜູ້​ປົກຄອງ​ຂອງ​ເມືອງ​ນີ້​ກໍ​ເປັນ​ດັ່ງ​ໝາປ່າ​ຍາມ​ແລງ,</para>
  <para style="q2" vid="ZEP 3:3">ຜູ້​ທີ່​ບໍ່​ປະ​ຫຍັງ​ໄວ້​ຈົນ​ເຖິງ​ມື້​ອື່ນ​ເຊົ້າ.<verse eid="ZEP 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4" />ບັນດາ​ຜູ້ທຳນວາຍ​ຂອງ​ເມືອງ​ນີ້​ກໍ​ບໍ່​ມີ​ຫລັກການ;</para>
  <para style="q2" vid="ZEP 3:4">ພວກເຂົາ​ເປັນ​ຄົນ​ທໍລະຍົດ.</para>
  <para style="q1" vid="ZEP 3:4">ບັນດາ​ປະໂລຫິດ​ຂອງ​ເມືອງ​ນີ້​ກໍ​ໝິ່ນປະໝາດ​ສະຖານ​ນະມັດສະການ</para>
  <para style="q2" vid="ZEP 3:4">ແລະ ລະເມີດ​ກົດບັນຍັດ.<verse eid="ZEP 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5" />ພຣະເຈົ້າ​ຢາເວ​ຜູ້​ຢູ່​ໃນ​ເມືອງ​ນີ້​ເປັນ​ຜູ້​ຊອບທຳ;</para>
  <para style="q2" vid="ZEP 3:5">ພຣະອົງ​ບໍ່​ໄດ້​ເຮັດ​ຜິດ.</para>
  <para style="q1" vid="ZEP 3:5">ທຸກ​ໆ​ເຊົ້າ​ພຣະອົງ​ຈະ​ອຳນວາຍ​ຄວາມ​ຍຸຕິທຳ,</para>
  <para style="q2" vid="ZEP 3:5">ແລະ ທຸກ​ໆ​ວັນ​ໃໝ່​ພຣະອົງ​ບໍ່​ເຄີຍ​ຢຸດ​ທີ່​ຈະ​ເຮັດ​ເຊັ່ນ​ນັ້ນ</para>
  <para style="q2" vid="ZEP 3:5">ເຖິງ​ປານ​ນັ້ນ​ຄົນອະທຳ​ກໍ​ບໍ່​ຮູ້​ຈັກ​ລະອາຍ.<verse eid="ZEP 3:5" /></para>
  <para style="s2">ເຢຣູຊາເລັມ​ຍັງ​ຄົງ​ບໍ່​ກັບໃຈ</para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6" />“ເຮົາ​ໄດ້​ທຳລາຍ​ປະຊາຊາດ​ທັງຫລາຍ;</para>
  <para style="q2" vid="ZEP 3:6">ຖານ​ທີ່​ໝັ້ນ​ຂອງ​ພວກເຂົາ​ກໍ​ຖືກ​ທຳລາຍ.</para>
  <para style="q1" vid="ZEP 3:6">ເຮົາ​ເຮັດ​ໃຫ້​ຖະໜົນ​ຫົນທາງ​ຂອງ​ພວກເຂົາ​ຮົກຮ້າງ,</para>
  <para style="q2" vid="ZEP 3:6">ໂດຍ​ບໍ່​ມີ​ຜູ້ໃດ​ຜ່ານ​ໄປ​ມາ.</para>
  <para style="q1" vid="ZEP 3:6">ເມືອງ​ຕ່າງ​ໆ​ຂອງ​ພວກເຂົາ​ຖືກ​ປະ​ໃຫ້​ຮົກຮ້າງ;</para>
  <para style="q2" vid="ZEP 3:6">ກັນດານ ແລະ ຫວ່າງເປົ່າ.<verse eid="ZEP 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7" />ເຮົາ​ໄດ້​ກ່າວ​ແກ່​ເຢຣູຊາເລັມ​ວ່າ</para>
  <para style="q2" vid="ZEP 3:7">‘ເຈົ້າ​ຈະ​ຢ້ານກົວ​ເຮົາ​ຢ່າງ​ແນ່ນອນ</para>
  <para style="q2" vid="ZEP 3:7">ແລະ ຍອມຮັບ​ການ​ແກ້ໄຂ​ປັບປຸງ!’</para>
  <para style="q1" vid="ZEP 3:7">ແລ້ວ​ບ່ອນ​ລີ້ໄພ<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ສະຖານ​ນະມັດສະການ</char></note>​ຂອງ​ເມືອງ​ນີ້​ຈະ​ໄດ້​ບໍ່​ຖືກ​ທຳລາຍ,</para>
  <para style="q2" vid="ZEP 3:7">ແລະ ການ​ລົງໂທດ​ທັງໝົດ​ຂອງ​ເຮົາ​ຈະ​ໄດ້​ບໍ່​ຕົກ​ເທິງ<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ທຸກ​ຄົນ​ທີ່​ເຮົາ​ໄດ້​ແຕ່ງຕັ້ງ</char></note>​ເມືອງ​ນີ້.</para>
  <para style="q1" vid="ZEP 3:7">ແຕ່​ວ່າ​ພວກເຂົາ​ກໍ​ຍັງ​ຄົງ​ກະຕືລືລົ້ນ</para>
  <para style="q2" vid="ZEP 3:7">ທີ່​ຈະ​ປະພຶດ​ຊົ່ວ​ເໝືອນ​ທີ່​ເຄີຍ​ເຮັດ​ມາ​ທຸກ​ຢ່າງ”.<verse eid="ZEP 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8" />ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ປະກາດ​ວ່າ, “ເຫດສະນັ້ນ ຈົ່ງ​ລໍຖ້າ​ເຮົາ,</para>
  <para style="q2" vid="ZEP 3:8">ເພາະ​ໃນ​ວັນ​ນັ້ນ​ເຮົາ​ຈະ​ຢືນ​ຂຶ້ນ​ເປັນ​ພະຍານ.<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ຈະ​ລຸກ​ຂຶ້ນ​ປຸ້ນ</char></note></para>
  <para style="q1" vid="ZEP 3:8">ເຮົາ​ໄດ້​ຕັດສິນໃຈ​ທີ່​ຈະ​ຮວບຮວມ​ຊົນຊາດ​ຕ່າງ​ໆ,</para>
  <para style="q2" vid="ZEP 3:8">ເຕົ້າໂຮມ​ອານາຈັກ​ຕ່າງໆ</para>
  <para style="q1" vid="ZEP 3:8">ແລະ ຖອກ​ຄວາມ​ໂກດຮ້າຍ​ຂອງ​ເຮົາ​ລົງ​ເທິງ​ພວກເຂົາ</para>
  <para style="q2" vid="ZEP 3:8">ຄວາມ​ໃຈຮ້າຍ​ອັນ​ແຮງກ້າ​ທັງໝົດ​ຂອງ​ເຮົາ.</para>
  <para style="q1" vid="ZEP 3:8">ທົ່ວທັງ​ໂລກ​ຈະ​ຖືກ​ເຜົາໄໝ້</para>
  <para style="q2" vid="ZEP 3:8">ດ້ວຍ​ໄຟ​ແຫ່ງ​ຄວາມ​ໃຈຮ້າຍ​ອັນ​ເນື່ອງ​ມາ​ຈາກ​ຄວາມ​ຫຶງຫວງ​ຂອງ​ເຮົາ.<verse eid="ZEP 3:8" /></para>
  <para style="s1">ການ​ຟື້ນຟູ​ສ່ວນ​ທີ່​ເຫລືອ​ຂອງ​ອິດສະຣາເອນ</para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 3:9" />“ແລ້ວ​ເຮົາ​ຈະ​ຊຳລະ​ຮີມສົບ​ຂອງ​ຄົນ​ທັງຫລາຍ​ໃຫ້​ບໍລິສຸດ,</para>
  <para style="q2" vid="ZEP 3:9">ເພື່ອ​ພວກເຂົາ​ທັງໝົດ​ຈະ​ຮ້ອງ​ຫາ​ນາມ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q2" vid="ZEP 3:9">ແລະ ບົວລະບັດ​ຮັບໃຊ້​ພຣະອົງ​ຢ່າງ​ຄຽງບ່າ​ຄຽງໄຫລ່.<verse eid="ZEP 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10" />ຜູ້​ທີ່​ນະມັດສະການ​ເຮົາ, ປະຊາຊົນ​ຂອງ​ເຮົາ​ທີ່​ກະຈັດກະຈາຍ​ໄປ,</para>
  <para style="q2" vid="ZEP 3:10">ຈະ​ນຳ​ເຄື່ອງ​ບູຊາ.</para>
  <para style="q2" vid="ZEP 3:10">ຈາກ​ຟາກ​ແມ່ນ້ຳ​ແຫ່ງ​ກູເຊ<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">ຄື </char><char style="fqa" closed="false">ຕອນ​ເທິງ​ຂອງ​ລຸ່ມ​ແມ່ນ້ຳ​ນິນ</char></note>​ມາ​ຖວາຍ​ເຮົາ.<verse eid="ZEP 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11" />ເຢຣູຊາເລັມ, ໃນ​ວັນ​ນັ້ນ​ເຈົ້າ​ຈະ​ບໍ່​ຕ້ອງ​ອັບອາຍ</para>
  <para style="q2" vid="ZEP 3:11">ເພາະ​ຄວາມ​ຜິດ​ທັງໝົດ​ທີ່​ເຈົ້າ​ໄດ້​ເຮັດ​ຕໍ່​ເຮົາ,</para>
  <para style="q1" vid="ZEP 3:11">ເພາະວ່າ​ເຮົາ​ຈະ​ກຳຈັດ​ຄົນ​ທີ່​ຊື່ນຊົມ​ຄວາມ​ຈອງຫອງ​ຂອງ​ຕົນ</para>
  <para style="q2" vid="ZEP 3:11">ໃຫ້​ອອກ​ໄປ​ຈາກ​ນະຄອນ​ນີ້.</para>
  <para style="q1" vid="ZEP 3:11">ເຈົ້າ​ຈະ​ບໍ່​ຍິ່ງ​ຈອງຫອງ​ອີກ​ຕໍ່​ໄປ</para>
  <para style="q2" vid="ZEP 3:11">ເທິງ​ພູເຂົາ​ສັກສິດ​ຂອງ​ເຮົາ.<verse eid="ZEP 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12" />ແຕ່​ເຮົາ​ຈະ​ປ່ອຍ​ໃຫ້</para>
  <para style="q2" vid="ZEP 3:12">ຄົນ​ທີ່​ອ່ອນນ້ອມ ແລະ ຖ່ອມຕົວ​ໄວ້​ພາຍ​ໃນ​ເຈົ້າ.</para>
  <para style="q1" vid="ZEP 3:12">ຊົນຊາດ​ອິດສະຣາເອນ​ທີ່​ເຫລືອ​ຢູ່</para>
  <para style="q2" vid="ZEP 3:12">ຈະ​ໄວ້ວາງໃຈ​ໃນ​ນາມ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ.<verse eid="ZEP 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13" />ພວກເຂົາ​ຈະ​ບໍ່​ເຮັດ​ຜິດ;</para>
  <para style="q2" vid="ZEP 3:13">ພວກເຂົາ​ຈະ​ບໍ່​ເວົ້າ​ຕົວະ.</para>
  <para style="q1" vid="ZEP 3:13">ລີ້ນ​ທີ່​ຫລອກລວງ</para>
  <para style="q2" vid="ZEP 3:13">ຈະ​ບໍ່​ພົບ​ໃນ​ປາກ​ຂອງ​ພວກເຂົາ.</para>
  <para style="q1" vid="ZEP 3:13">ພວກເຂົາ​ຈະ​ກິນ ແລະ ນອນ​ລົງ</para>
  <para style="q2" vid="ZEP 3:13">ແລະ ບໍ່​ມີ​ຜູ້ໃດ​ເຮັດ​ໃຫ້​ພວກເຂົາ​ຢ້ານ​ກົວ”.<verse eid="ZEP 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14" />ລູກສາວ​ແຫ່ງ​ຊີໂອນ,<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">ຄື </char><char style="fqa" closed="false">ຊາວ​ເຢຣູຊາເລັມ</char></note> ຈົ່ງ​ຮ້ອງເພງ;</para>
  <para style="q2" vid="ZEP 3:14">ອິດສະຣາເອນ, ຈົ່ງ​ໂຫ່​ຮ້ອງ​ໃຫ້​ດັງ!</para>
  <para style="q1" vid="ZEP 3:14">ຈົ່ງ​ດີໃຈ ແລະ ຊື່ນຊົມຍິນດີ​ດ້ວຍ​ສຸດໃຈ​ຂອງ​ເຈົ້າ,</para>
  <para style="q2" vid="ZEP 3:14">ລູກສາວ​ແຫ່ງ​ເຢຣູຊາເລັມ!<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">ຄື </char><char style="fqa" closed="false">ຊາວ​ເຢຣູຊາເລັມ</char></note><verse eid="ZEP 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15" />ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ເອົາ​ໂທດ​ຂອງ​ເຈົ້າ​ໄປ​ແລ້ວ,</para>
  <para style="q2" vid="ZEP 3:15">ພຣະອົງ​ໄດ້​ໃຫ້​ສັດຕູ​ຂອງ​ເຈົ້າ​ຫັນ​ກັບ​ໄປ​ແລ້ວ.</para>
  <para style="q1" vid="ZEP 3:15">ພຣະເຈົ້າ​ຢາເວ, ກະສັດ​ແຫ່ງ​ອິດສະຣາເອນ​ໄດ້​ຢູ່​ກັບ​ເຈົ້າ;</para>
  <para style="q2" vid="ZEP 3:15">ເຈົ້າ​ຈະ​ບໍ່​ຢ້ານ​ອັນຕະລາຍ​ໃດ​ໆ​ອີກ​ເລີຍ.<verse eid="ZEP 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16" />ໃນ​ວັນ​ນັ້ນ</para>
  <para style="q2" vid="ZEP 3:16">ພວກເຂົາ​ຈະ​ເວົ້າ​ກັບ​ເຢຣູຊາເລັມ​ວ່າ,</para>
  <para style="q1" vid="ZEP 3:16">“ຊີໂອນ, ຢ່າ​ຢ້ານ​ເລີຍ;</para>
  <para style="q2" vid="ZEP 3:16">ຢ່າ​ໃຫ້​ມື​ຂອງ​ເຈົ້າ​ອ່ອນ​ແຮງ.<verse eid="ZEP 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17" />ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ​ຂອງ​ເຈົ້າ​ຢູ່​ກັບ​ເຈົ້າ</para>
  <para style="q2" vid="ZEP 3:17">ນັກຮົບ​ຜູ້​ຍິ່ງໃຫຍ່​ທີ່​ຈະ​ຊ່ວຍ​ໃຫ້​ພົ້ນ.</para>
  <para style="q1" vid="ZEP 3:17">ພຣະອົງ​ຈະ​ປິຕິ​ຍິນດີ​ໃນ​ເຈົ້າ;</para>
  <para style="q2" vid="ZEP 3:17">ດ້ວຍ​ຄວາມ​ຮັກ​ຂອງ​ພຣະອົງ ພຣະອົງ​ຈະ​ບໍ່​ຕຳໜິ​ເຈົ້າ​ອີກ​ຕໍ່​ໄປ,</para>
  <para style="q2" vid="ZEP 3:17">ແລະ ຈະ​ຮ້ອງເພງ​ເພາະ​ຊື່ນຊົມຍິນດີ​ໃນ​ເຈົ້າ”.<verse eid="ZEP 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18" />“ເຮົາ​ຈະ​ເອົາ​ຄວາມ​ໂສກເສົ້າ</para>
  <para style="q2" vid="ZEP 3:18">ທີ່​ເຈົ້າ​ບໍ່​ໄດ້​ຮ່ວມ​ເທດສະການ​ຕ່າງ​ໆ​ຕາມ​ກຳນົດ​ຂອງ​ເຈົ້າ​ອອກ​ໄປ,</para>
  <para style="q2" vid="ZEP 3:18">ສິ່ງ​ນີ້​ເປັນ​ພາລະ ແລະ ຄຳ​ປະນາມ​ສຳລັບ​ເຈົ້າ.<verse eid="ZEP 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19" />ໃນ​ເວລາ​ນັ້ນ​ເຮົາ​ຈະ​ຈັດການ</para>
  <para style="q2" vid="ZEP 3:19">ກັບ​ທຸກຄົນ​ທີ່​ກົດຂີ່​ຂົ່ມເຫັງ​ເຈົ້າ.</para>
  <para style="q1" vid="ZEP 3:19">ເຮົາ​ຈະ​ຊ່ວຍ​ບັນດາ​ຄົນເປ້ຍ</para>
  <para style="q2" vid="ZEP 3:19">ເຮົາ​ຈະ​ຮວບຮວມ​ເອົາ​ຜູ້​ທີ່​ຖືກ​ເຮັດ​ໃຫ້​ກະຈັດກະຈາຍ​ໄປ.</para>
  <para style="q1" vid="ZEP 3:19">ເຮົາ​ຈະ​ໃຫ້​ພວກເຂົາ​ເປັນ​ທີ່​ຍົກຍ້ອງ ແລະ ມີ​ກຽດ</para>
  <para style="q2" vid="ZEP 3:19">ໃນ​ທຸກ​ດິນແດນ​ທີ່​ພວກເຂົາ​ໄດ້​ຮັບ​ຄວາມ​ອັບອາຍ.<verse eid="ZEP 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20" />ໃນ​ເວລາ​ນັ້ນ​ເຮົາ​ຈະ​ຮວບຮວມ​ເອົາ​ເຈົ້າ;</para>
  <para style="q2" vid="ZEP 3:20">ໃນ​ເວລາ​ນັ້ນ​ເຮົາ​ຈະ​ພາ​ເຈົ້າ​ກັບ​ບ້ານ.</para>
  <para style="q1" vid="ZEP 3:20">ເຮົາ​ຈະ​ໃຫ້​ເຈົ້າ​ມີ​ກຽດ ແລະ ເປັນ​ທີ່​ຍົກຍ້ອງ</para>
  <para style="q2" vid="ZEP 3:20">ໃນ​ທ່າມກາງ​ຄົນ​ທັງໝົດ​ທີ່​ຢູ່​ແຜ່ນດິນໂລກ​ນີ້</para>
  <para style="q1" vid="ZEP 3:20">ເມື່ອ​ເຮົາ​ໃຫ້​ເຈົ້າ​ກັບ​ຄືນ​ສູ່​ສະພາບ​ດີ<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ເຮົາ​ນຳ​ຊະເລີຍ​ຂອງ​ເຈົ້າ​ກັບ​ມາ</char></note></para>
  <para style="q2" vid="ZEP 3:20">ຕໍ່ໜ້າ​ຕໍ່​ຕາ​ເຈົ້າ,”</para>
  <para style="q2" vid="ZEP 3:20">ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ເວົ້າ​ດັ່ງນັ້ນ.<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>