<usx version="3.0">
  <book code="MRK" style="id">- Biblica® Open Lao Contemporary Version</book>
  <para style="rem">Copyright © 2023, 2025 by Biblica, Inc.</para>
  <para style="h">ມາຣະໂກ</para>
  <para style="toc1">ພຣະທຳມາຣະໂກ</para>
  <para style="toc2">ມາຣະໂກ</para>
  <para style="toc3">ມຣກ</para>
  <para style="mt1">ພຣະທຳມາຣະໂກ</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s1">ການປະກາດ​ຂອງ​ໂຢຮັນ​ບັບຕິສະໂຕ</para>
  <para style="r">(ມທ 3:1-11; ລກ 3:2-16)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />ຂ່າວປະເສີດ​ເລື່ອງ​ພຣະເຢຊູເຈົ້າ​ພຣະເມຊີອາ<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ພຣະເຢຊູຄຣິດເຈົ້າ </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ </char><char style="fq" closed="false">ພຣະເມຊີອາ </char><char style="ft" closed="false">ພາສາ​ກຣີກ​ວ່າ </char><char style="fqa" closed="false">ພຣະຄຣິດເຈົ້າ </char><char style="ft" closed="false">ທັງ​ສອງ​ຄຳ​ນີ້​ມີ​ຄວາມໝາຍ​ວ່າ </char><char style="fqa" closed="false">ຜູ້​ຖືກ​ເຈີມ​ໄວ້</char></note> ພຣະບຸດ​ຂອງ​ພຣະເຈົ້າ<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ບາງ​ສະບັບ​ບໍ່​ມີ​ຄຳ​ວ່າ </char><char style="fqa" closed="false">ພຣະບຸດ​ຂອງ​ພຣະເຈົ້າ</char></note>​ໄດ້​ເລີ່ມຕົ້ນ​ດັ່ງນີ້, <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />ໃນ​ພຣະທຳ​ເອຊາຢາ​ຜູ້ທຳນວາຍ​ມີ​ຂຽນ​ໄວ້​ວ່າ:</para>
  <para style="q1" vid="MRK 1:2">“ເຮົາ​ຈະ​ໃຊ້​ທູດ​ຂອງ​ເຮົາ​ໄປ​ກ່ອນໜ້າ​ທ່ານ</para>
  <para style="q2" vid="MRK 1:2">ເພື່ອ​ຈັດຕຽມ​ຫົນທາງ​ສຳລັບ​ທ່ານ”<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false"><char style="xt"><ref loc="MRK 3:1">ມຣກ 3:1</ref></char></char></note><verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />“ສຽງ​ຂອງ​ຜູ້​ໜຶ່ງ​ຮ້ອງ​ໃນ​ຖິ່ນແຫ້ງແລ້ງກັນດານ​ວ່າ,</para>
  <para style="q1" vid="MRK 1:3">‘ຈົ່ງ​ຈັດຕຽມ​ຫົນທາງ​ສຳລັບ​ອົງພຣະຜູ້ເປັນເຈົ້າ,</para>
  <para style="q2" vid="MRK 1:3">ຈົ່ງ​ເຮັດ​ຫົນທາງ​ສຳລັບ​ພຣະອົງ​ໃຫ້​ຊື່​ໄປ’ ”.<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:3">ອຊຢ 40:3</ref></char></char></note><verse eid="MRK 1:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MRK 1:4" />ແລ້ວ​ໂຢຮັນ​ບັບຕິສະໂຕ​ກໍ​ໄດ້​ປາກົດ​ໂຕ​ໃນ​ຖິ່ນແຫ້ງແລ້ງກັນດານ ແລະ ໄດ້​ເທດສະໜາ​ເລື່ອງ​ການ​ຮັບ​ບັບຕິສະມາ​ທີ່​ສະແດງ​ເຖິງ​ການ​ຖິ້ມໃຈເກົ່າເອົາໃຈໃໝ່ ເພື່ອ​ຮັບ​ການອະໄພ​ບາບ. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />ປະຊາຊົນ​ທົ່ວ​ແຂວງ​ຢູດາຍ ແລະ ຊາວ​ເຢຣູຊາເລັມ​ທັງໝົດ​ໄດ້​ພາກັນ​ອອກ​ໄປ​ຫາ​ເພິ່ນ. ເມື່ອ​ພວກເຂົາ​ສາລະພາບ​ບາບ​ທັງຫລາຍ​ຂອງ​ຕົນ​ແລ້ວ ໂຢຮັນ​ກໍ​ໃຫ້​ພວກເຂົາ​ຮັບ​ບັບຕິສະມາ​ໃນ​ແມ່ນ້ຳຈໍແດນ. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />ໂຢຮັນ​ນຸ່ງເຄື່ອງ​ທີ່​ເຮັດ​ຈາກ​ຂົນ​ອູດ ເພິ່ນ​ຮັດ​ແອວ​ຂອງ​ເພິ່ນ​ດ້ວຍ​ສາຍແອວ​ໜັງ ແລະ ເພິ່ນ​ກິນ​ຕັກແຕນ ແລະ ນ້ຳເຜິ້ງ​ປ່າ. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />ແລະ ນີ້​ແມ່ນ​ຂໍ້ຄວາມ​ຂອງ​ເພິ່ນ​ຄື: “ຜູ້​ທີ່​ຈະ​ມາ​ພາຍຫລັງ​ເຮົາ​ກໍ​ຍິ່ງໃຫຍ່​ກວ່າ​ເຮົາ, ເຊິ່ງ​ເຮົາ​ບໍ່​ສົມຄວນ​ແມ່ນ​ແຕ່​ຈະ​ກົ້ມລົງ​ແກ້​ສາຍຮັດເກີບ​ຂອງ​ເພິ່ນ. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />ເຮົາ​ໃຫ້​ພວກເຈົ້າ​ທັງຫລາຍ​ບັບຕິສະມາ​ດ້ວຍ​ນ້ຳ<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ໃນ​ນ້ຳ</char></note> ແຕ່​ພຣະອົງ​ຈະ​ໃຫ້​ພວກເຈົ້າ​ທັງຫລາຍ​ບັບຕິສະມາ​ດ້ວຍ​ພຣະວິນຍານບໍລິສຸດເຈົ້າ”.<verse eid="MRK 1:8" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຮັບ​ບັບຕິສະມາ ແລະ ຖືກ​ມານຊາຕານ​ທົດລອງ</para>
  <para style="r">(ມທ 3:13-17; 4:1-11; <ref loc="LUK 3:21">ລກ 3:21</ref>,<ref loc="LUK 3:22">22</ref>; 4:1-13)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />ໃນ​ເວລາ​ນັ້ນ ພຣະເຢຊູເຈົ້າ​ໄດ້​ມາ​ຈາກ​ບ້ານ​ນາຊາເຣັດ​ໃນ​ແຂວງ​ຄາລີເລ ແລະ ຮັບ​ບັບຕິສະມາ​ຈາກ​ໂຢຮັນ​ໃນ​ແມ່ນ້ຳຈໍແດນ. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />ໃນຂະນະ​ທີ່​ພຣະເຢຊູເຈົ້າ​ຂຶ້ນ​ຈາກ​ນ້ຳ​ນັ້ນ, ພຣະອົງ​ກໍ​ເຫັນ​ສະຫວັນ​ເປີດ​ອອກ ແລະ ມີ​ພຣະວິນຍານບໍລິສຸດເຈົ້າ​ເໝືອນດັ່ງ​ນົກເຂົາ​ລົງ​ມາ​ຢູ່​ເທິງ​ພຣະອົງ. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />ແລ້ວ​ມີ​ສຽງ​ໜຶ່ງ​ມາ​ຈາກ​ສະຫວັນ​ວ່າ: “ທ່ານ​ເປັນ​ບຸດ​ຂອງ​ເຮົາ, ຜູ້​ທີ່​ເຮົາ​ຮັກ ເຮົາ​ພໍໃຈ​ທ່ານ​ຫລາຍ”.<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />ໃນທັນໃດ​ນັ້ນ ພຣະວິນຍານບໍລິສຸດເຈົ້າ​ໄດ້​ພາ​ພຣະອົງ​ເຂົ້າໄປ​ໃນ​ຖິ່ນແຫ້ງແລ້ງກັນດານ, <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />ພຣະອົງ​ຢູ່​ໃນ​ຖິ່ນແຫ້ງແລ້ງກັນດານ​ເປັນ​ເວລາ​ສີ່ສິບ​ວັນ, ຖືກ​ທົດລອງ​ໂດຍ​ມານຊາຕານ. ພຣະອົງ​ຢູ່​ກັບ​ສັດ​ປ່າ ແລະ ບັນດາ​ເທວະດາ​ໄດ້​ມາ​ບົວລະບັດ​ພຣະອົງ.<verse eid="MRK 1:13" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ເອີ້ນ​ເອົາ​ສາວົກ​ກຸ່ມ​ທຳອິດ</para>
  <para style="r">(ມທ 4:18-22; ລກ 5:2-11; ຢຮ 1:35-42)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />ຫລັງ​ຈາກ​ໂຢຮັນ​ຖືກ​ຂັງຄຸກ​ແລ້ວ ພຣະເຢຊູເຈົ້າ​ໄດ້​ໄປ​ປະກາດ​ຂ່າວປະເສີດ​ຂອງ​ພຣະເຈົ້າ​ທີ່​ແຂວງ​ຄາລີເລ. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />ພຣະອົງ​ກ່າວ​ວ່າ, “ເວລາ​ທີ່​ໄດ້​ກຳນົດ​ໄວ້​ມາ​ເຖິງ​ແລ້ວ ແລະ ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ​ໄດ້​ມາ​ໃກ້​ແລ້ວ. ຈົ່ງ​ຖິ້ມໃຈເກົ່າເອົາໃຈໃໝ່ ແລະ ເຊື່ອ​ໃນ​ຂ່າວປະເສີດ!”<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />ຂະນະ​ທີ່​ພຣະເຢຊູເຈົ້າ​ຍ່າງ​ໄປ​ຕາມ​ແຄມ​ທະເລສາບ​ຄາລີເລ​ຢູ່​ນັ້ນ, ພຣະອົງ​ໄດ້​ເຫັນ​ຊີໂມນ ແລະ ນ້ອງຊາຍ​ຂອງ​ເພິ່ນ​ຊື່​ວ່າ​ອັນເດອາ ກຳລັງ​ຢ່ອນມອງ​ຢູ່​ໃນ​ທະເລສາບ, ເພາະ​ພວກເພິ່ນ​ເປັນ​ຄົນຫາປາ. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />ພຣະເຢຊູເຈົ້າ​ກ່າວ​ວ່າ, “ຈົ່ງ​ຕາມ​ເຮົາ​ມາ ແລະ ເຮົາ​ຈະ​ໃຊ້​ພວກເຈົ້າ​ໃຫ້​ເປັນ​ຜູ້​ຫາ​ຄົນ”. <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />ໃນທັນໃດ​ນັ້ນ ພວກເພິ່ນ​ກໍ​ປະ​ມອງ​ຂອງ​ຕົນ ແລະ ຕິດຕາມ​ພຣະອົງ​ໄປ.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />ເມື່ອ​ພຣະອົງ​ເດີນ​ທາງ​ໄປ​ອີກ​ໜ້ອຍ​ໜຶ່ງ ພຣະອົງ​ກໍ​ເຫັນ​ຢາໂກໂບ​ລູກຊາຍ​ຂອງ​ເຊເບດາຍ ແລະ ໂຢຮັນ​ຜູ້​ເປັນ​ນ້ອງຊາຍ​ຂອງ​ຢາໂກໂບ ກຳລັງ​ແປງ​ມອງ​ຂອງ​ຕົນ​ຢູ່​ໃນ​ເຮືອ. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />ພໍ​ພຣະເຢຊູເຈົ້າ​ເຫັນ​ຈຶ່ງ​ເອີ້ນ​ເອົາ​ພວກເພິ່ນ​ທັນທີ ແລະ ພວກເພິ່ນ​ຈຶ່ງ​ປະ​ພໍ່​ຂອງ​ຕົນ​ຄື​ເຊເບດາຍ ແລະ ລູກຈ້າງ​ໄວ້​ໃນ​ເຮືອ​ແລ້ວ​ຕິດຕາມ​ພຣະອົງ​ໄປ.<verse eid="MRK 1:20" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຂັບໄລ່​ວິນຍານສົກກະປົກ</para>
  <para style="r">(ລກ 4:31-37)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />ພຣະເຢຊູເຈົ້າ ແລະ ບັນດາ​ສາວົກ​ຂອງ​ພຣະອົງ​ໄດ້​ໄປ​ຍັງ​ເມືອງ​ກາເປນາອູມ, ແລະ ເມື່ອ​ເຖິງ​ວັນຊະບາໂຕ ພຣະເຢຊູເຈົ້າ​ໄດ້​ເຂົ້າ​ໄປ​ໃນ​ທຳມະສາລາ ແລະ ໄດ້​ເລີ່ມຕົ້ນ​ສັ່ງສອນ. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />ປະຊາຊົນ​ໄດ້​ຕ່າງ​ກໍ​ປະຫລາດໃຈ​ໃນ​ຄຳສັ່ງສອນ​ຂອງ​ພຣະອົງ, ເພາະວ່າ​ພຣະອົງ​ໄດ້​ສັ່ງສອນ​ພວກເຂົາ​ເໝືອນ​ຜູ້​ມີ​ສິດອຳນາດ, ບໍ່​ເໝືອນ​ກັບ​ພວກ​ຄູສອນກົດບັນຍັດ. <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />ໃນ​ຂະນະ​ນັ້ນ ມີ​ຊາຍ​ຄົນ​ໜຶ່ງ​ໃນ​ທຳມະສາລາ​ທີ່​ໄດ້​ຖືກ​ວິນຍານສົກກະປົກ​ເຂົ້າ​ສິງ​ຢູ່ ແລະ ຮ້ອງ​ຂຶ້ນ​ວ່າ, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />“ເຢຊູ​ຊາວ​ນາຊາເຣັດ, ທ່ານ​ຕ້ອງການ​ສິ່ງໃດ​ຈາກ​ພວກຂ້ານ້ອຍ? ທ່ານ​ມາ​ເພື່ອ​ທຳລາຍ​ພວກຂ້ານ້ອຍ​ບໍ? ຂ້ານ້ອຍ​ຮູ້​ວ່າ​ທ່ານ​ເປັນ​ຜູ້ໃດ ທ່ານ​ຄື​ອົງ​ບໍລິສຸດ​ຂອງ​ພຣະເຈົ້າ!”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />ພຣະເຢຊູເຈົ້າ​ສັ່ງ​ວິນຍານສົກກະປົກ​ຢ່າງ​ເດັດຂາດ​ວ່າ, “ມິດງຽບ! ຈົ່ງ​ອອກ​ມາ​ຈາກ​ລາວ​ດຽວ​ນີ້!” <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />ວິນຍານສົກກະປົກ​ໄດ້​ເຮັດ​ໃຫ້​ຊາຍ​ຄົນ​ນັ້ນ​ຊັກດິ້ນ​ຢ່າງ​ຮຸນແຮງ ແລ້ວ​ຮ້ອງ​ສຽງດັງ ແລະ ກໍ​ອອກ​ໄປ​ຈາກ​ລາວ.<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />ປະຊາຊົນ​ທຸກຄົນ​ຕ່າງ​ກໍ​ພາກັນ​ປະຫລາດໃຈ ແລະ ຖາມ​ກັນ​ວ່າ, “ນີ້​ແມ່ນ​ຫຍັງ? ເປັນ​ຄຳສັ່ງສອນ​ໃໝ່ ແລະ ທັງ​ຍັງ​ມີ​ສິດອຳນາດ! ທ່ານ​ຜູ້​ນີ້​ສັ່ງ​ວິນຍານສົກກະປົກ ແລະ ພວກມັນ​ກໍ​ຍອມ​ເຊື່ອຟັງ​ເພິ່ນ”. <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />ຊື່ສຽງ​ຂອງ​ພຣະອົງ​ຈຶ່ງ​ແຜ່​ໄປ​ທົ່ວ​ແຂວງ​ຄາລີເລ​ຢ່າງ​ວ່ອງໄວ.<verse eid="MRK 1:28" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຮັກສາ​ຫລາຍ​ຄົນ​ໃຫ້​ດີ​ພະຍາດ</para>
  <para style="r">(ມທ 8:14-17; ລກ 4:38-41)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />ໃນ​ທັນທີ​ທີ່​ພວກເພິ່ນ​ອອກ​ຈາກ​ທຳມະສາລາ ພວກເພິ່ນ​ກໍ​ໄປ​ກັບ​ຢາໂກໂບ ແລະ ໂຢຮັນ ໄປ​ທີ່​ເຮືອນ​ຂອງ​ຊີໂມນ ແລະ ອັນເດອາ. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />ແມ່​ເມຍ​ຂອງ​ຊີໂມນ​ນອນ​ເປັນ​ໄຂ້​ຢູ່​ເທິງ​ຕຽງ, ພວກເຂົາ​ຈຶ່ງ​ບອກ​ເລື່ອງ​ຂອງ​ນາງ​ໃຫ້​ພຣະອົງ​ຮູ້​ທັນທີ. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />ດັ່ງນັ້ນ ພຣະອົງ​ຈຶ່ງ​ເຂົ້າ​ໄປ​ໃກ້ ແລະ ຈັບ​ມື​ຂອງ​ນາງ ແລະ ຊ່ວຍ​ນາງ​ໃຫ້​ລຸກຂຶ້ນ. ໃນທັນໃດ​ນັ້ນ ໄຂ້​ກໍ​ຫາຍ ແລະ ນາງ​ຈຶ່ງ​ເຝົ້າ​ຮັບໃຊ້​ພວກເພິ່ນ.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />ຕອນແລງ​ວັນ​ນັ້ນ​ຫລັງຈາກ​ຕາເວັນ​ຕົກດິນ ປະຊາຊົນ​ກໍ​ໄດ້​ພາ​ບັນດາ​ຄົນ​ທີ່​ເຈັບປ່ວຍ ແລະ ຄົນ​ທີ່​ຖືກ​ຜີມານຮ້າຍ​ເຂົ້າສິງ​ມາ​ຫາ​ພຣະເຢຊູເຈົ້າ. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />ຄົນ​ເມືອງ​ທັງໝົດ​ໄດ້​ມາ​ເຕົ້າໂຮມ​ກັນ​ຢູ່​ທີ່​ປະຕູ, <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />ແລະ ພຣະເຢຊູເຈົ້າ​ໄດ້​ຮັກສາ​ຫລາຍ​ຄົນ​ທີ່​ເຈັບໄຂ້​ໄດ້​ປ່ວຍ​ດ້ວຍ​ພະຍາດ​ຕ່າງໆ​ໃຫ້​ຫາຍດີ. ພຣະອົງ​ຍັງ​ໄດ້​ຂັບໄລ່​ຜີມານຮ້າຍ​ຫລາຍ​ໂຕ​ອອກ​ໄປ, ແຕ່​ພຣະອົງ​ບໍ່​ອະນຸຍາດ​ໃຫ້​ຜີມານຮ້າຍ​ທັງຫລາຍ​ເວົ້າ​ຫຍັງ​ຈັກ​ຄຳ ເພາະ​ພວກມັນ​ຮູ້​ວ່າ​ພຣະອົງ​ເປັນ​ຜູ້ໃດ.<verse eid="MRK 1:34" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ອະທິຖານ​ໃນ​ບ່ອນ​ທີ່​ງຽບສະຫງົບ</para>
  <para style="r">(<ref loc="LUK 4:42">ລກ 4:42</ref>,<ref loc="LUK 4:43">43</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />ໃນ​ເວລາ​ເຊົ້າ​ມືດ ພຣະເຢຊູເຈົ້າ​ໄດ້​ລຸກຂຶ້ນ, ແລ້ວ​ອອກ​ຈາກ​ເຮືອນ​ໄປ​ຍັງ​ບ່ອນ​ທີ່​ງຽບສະຫງົບ ບ່ອນ​ທີ່​ພຣະອົງ​ໄດ້​ອະທິຖານ​ນັ້ນ. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />ຊີໂມນ ແລະ ເພື່ອນ​ທີ່​ຢູ່​ນຳ​ກັນ​ກໍ​ໄດ້​ອອກ​ໄປ​ຊອກຫາ​ພຣະອົງ, <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />ເມື່ອ​ພົບ​ແລ້ວ ພວກເພິ່ນ​ກໍ​ຮ້ອງ​ອອກ​ມາ​ວ່າ: “ທຸກຄົນ​ກຳລັງ​ຊອກຫາ​ທ່ານ​ຢູ່!”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />ພຣະເຢຊູເຈົ້າ​ຈຶ່ງ​ຕອບ​ພວກເພິ່ນ​ວ່າ, “ໃຫ້​ພວກເຮົາ​ໄປ​ຍັງ​ບ່ອນ​ອື່ນໆ​ໃນ​ຂົງເຂດ​ໃກ້ຄຽງ​ນີ້ ເພື່ອ​ເຮົາ​ຈະ​ໄດ້​ປະກາດ​ຂ່າວປະເສີດ​ຢູ່​ທີ່​ນັ້ນ​ດ້ວຍ. ເຮົາ​ໄດ້​ມາ​ກໍ​ເພື່ອ​ພາລະກິດ​ນີ້​ແຫລະ”. <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />ດັ່ງນັ້ນ ພຣະອົງ​ຈຶ່ງ​ໄດ້​ເດີນທາງ​ໄປ​ທົ່ວ​ແຂວງ​ຄາລີເລ ໄດ້​ເທດສະໜາ​ໃນ​ທຳມະສາລາ ແລະ ຂັບໄລ່​ຜີມານຮ້າຍ​ທັງຫລາຍ​ໃຫ້​ອອກ​ໄປ.<verse eid="MRK 1:39" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຮັກສາ​ຄົນຂີ້ທູດ</para>
  <para style="r">(ມທ 8:2-4; ລກ 5:12-14)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />ມີ​ຊາຍ​ຄົນ​ໜຶ່ງ​ທີ່​ເປັນ​ພະຍາດຂີ້ທູດ<note caller="+" style="f"><char style="fr" closed="false">1:40 </char><char style="ft" closed="false">ພາສາ​ກຣີກ​ໝາຍເຖິງ </char><char style="fqa" closed="false">ພະຍາດ​ຜິວໜັງ​ຕ່າງໆ </char><char style="ft" closed="false">ບໍ່​ຈຳເປັນ​ຕ້ອງ​ໝາຍເຖິງ</char><char style="fqa" closed="false">/ພະຍາດ​ຂີ້ທູດ​ເທົ່ານັ້ນ</char></note>​ໄດ້​ມາ​ຫາ​ພຣະເຢຊູເຈົ້າ ແລະ ຄຸເຂົ່າ​ລົງ​ອ້ອນວອນ​ຂໍ​ພຣະອົງ​ວ່າ, “ຖ້າ​ພຣະອົງ​ເຕັມໃຈ ພຣະອົງ​ກໍ​ສາມາດ​ເຮັດ​ໃຫ້​ຂ້ານ້ອຍ​ດີ​ສະອາດ​ໄດ້”.<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />ພຣະເຢຊູເຈົ້າ​ໃຈຮ້າຍ.<note caller="+" style="f"><char style="fr" closed="false">1:41 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ບາງ​ສະບັບ​ວ່າ​ພຣະເຢຊູເຈົ້າ​ເຕັມລົ້ນ​ດ້ວຍ​ຄວາມເມດຕາ</char></note> ພຣະອົງ​ເດ່​ມື​ອອກ​ໄປ​ແຕະຕ້ອງ​ລາວ ແລະ ກ່າວ​ວ່າ, “ເຮົາ​ພໍໃຈ​ຈະ​ຮັກສາ ຈົ່ງ​ດີ​ສະອາດ​ສາ!” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />ໃນທັນໃດ​ນັ້ນ ພະຍາດ​ຂີ້ທູດ​ກໍ​ຫາຍ​ໄປ​ຈາກ​ຊາຍ​ຄົນ​ນີ້ ແລະ ລາວ​ຈຶ່ງ​ດີ​ສະອາດ.<verse eid="MRK 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 1:43" />ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ໄດ້​ສົ່ງ​ລາວ​ໜີ​ໄປ​ທັນທີ ພ້ອມ​ກັບ​ເຕືອນ​ຢ່າງ​ເຂັ້ມງວດ​ວ່າ: <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />“ຈົ່ງ​ລະວັງ​ຢ່າ​ບອກ​ເລື່ອງ​ນີ້​ແກ່​ຜູ້ໃດ ແຕ່​ຈົ່ງ​ໄປ​ສະແດງ​ໂຕ​ຕໍ່​ປະໂລຫິດ ແລະ ຖວາຍ​ເຄື່ອງບູຊາ​ຕາມ​ທີ່​ໂມເຊ​ໄດ້​ສັ່ງ​ໄວ້, ເພື່ອ​ເປັນ​ພະຍານ​ໃຫ້​ແກ່​ຄົນ​ທັງຫລາຍ​ວ່າ​ເຈົ້າ​ດີ​ສະອາດ​ແລ້ວ”. <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />ແຕ່​ພໍ​ຊາຍ​ຄົນ​ນີ້​ຈາກ​ໄປ​ແລ້ວ ລາວ​ພັດ​ໄປ​ປະກາດ​ເລື່ອງ​ນີ້​ໃຫ້​ແຜ່ກະຈາຍ​ໄປ​ທົ່ວ​ທຸກ​ບ່ອນ ຍ້ອນ​ຂ່າວ​ນີ້ ພຣະເຢຊູເຈົ້າ​ຈຶ່ງ​ບໍ່​ສາມາດ​ເຂົ້າ​ໄປ​ໃນ​ເມືອງ​ໄດ້​ຢ່າງ​ເປີດເຜີຍ​ອີກ​ຕໍ່​ໄປ ແຕ່​ພຣະອົງ​ໄດ້​ອາໄສ​ຢູ່​ນອກ​ເມືອງ​ໃນ​ບ່ອນ​ປ່ຽວ. ເຖິງ​ປານ​ນັ້ນ ກໍ​ຍັງ​ມີ​ຄົນ​ຈາກ​ທຸກ​ທີ່​ທຸກ​ບ່ອນ​ມາ​ຫາ​ພຣະອົງ.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຮັກສາ​ຄົນເປ້ຍ​ຜູ້​ໜຶ່ງ​ໃຫ້​ຫາຍດີ</para>
  <para style="r">(ມທ 9:2-8; ລກ 5:18-26)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />ສອງສາມ​ວັນ​ຕໍ່ມາ ພຣະເຢຊູເຈົ້າ​ໄດ້​ເຂົ້າ​ໄປ​ໃນ​ເມືອງ​ກາເປນາອູມ​ອີກ, ປະຊາຊົນ​ທັງຫລາຍ​ຕ່າງ​ກໍ​ໄດ້​ຍິນ​ຂ່າວ​ວ່າ​ພຣະອົງ​ໄດ້​ມາ​ເຮືອນ. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />ດັ່ງນັ້ນ ປະຊາຊົນ​ຢ່າງ​ຫລວງຫລາຍ​ຈຶ່ງ​ມາ​ເຕົ້າໂຮມກັນ​ຢູ່​ທີ່​ນັ້ນ​ຈົນ​ບໍ່​ມີ​ບ່ອນ​ຫວ່າງ​ແມ່ນແຕ່​ທີ່​ນອກ​ປະຕູ​ທາງເຂົ້າ ແລະ ພຣະອົງ​ໄດ້​ສັ່ງສອນ​ພຣະທຳ​ສູ່​ພວກເຂົາ​ຟັງ. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />ມີ​ຊາຍ​ສີ່​ຄົນ​ຫາມ​ຄົນເປ້ຍ​ຜູ້​ໜຶ່ງ​ມາ​ຫາ​ພຣະອົງ. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />ແຕ່​ພວກເຂົາ​ບໍ່​ສາມາດ​ເຂົ້າ​ໄປ​ຫາ​ພຣະເຢຊູເຈົ້າ​ໄດ້​ເພາະ​ມີ​ປະຊາຊົນ​ຈຳນວນ​ຫລວງຫລາຍ, ພວກເຂົາ​ຈຶ່ງ​ຮື້​ຫລັງຄາ​ຊື່​ບ່ອນ​ທີ່​ພຣະອົງ​ກຳລັງ​ສັ່ງສອນ​ຢູ່​ນັ້ນ ແລ້ວ​ຢ່ອນ​ບ່ອນນອນ​ທີ່​ຄົນເປ້ຍ​ນັ້ນ​ນອນ​ຢູ່​ລົງ​ມາ. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />ເມື່ອ​ພຣະເຢຊູເຈົ້າ​ໄດ້​ເຫັນ​ຄວາມເຊື່ອ​ຂອງ​ພວກເຂົາ ພຣະອົງ​ຈຶ່ງ​ກ່າວ​ຕໍ່​ຄົນເປ້ຍ​ນັ້ນ​ວ່າ, “ລູກ​ເອີຍ, ບາບ​ຂອງ​ເຈົ້າ​ໄດ້​ຮັບ​ອະໄພ​ແລ້ວ”.<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />ແຕ່​ມີ​ພວກ​ຄູສອນກົດບັນຍັດ​ບາງຄົນ​ທີ່​ນັ່ງ​ຢູ່​ທີ່​ນັ້ນ​ຄິດ​ໃນ​ໃຈ​ວ່າ, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“ເປັນຫຍັງ​ຄົນ​ນີ້​ຈຶ່ງ​ເວົ້າ​ຢ່າງ​ນີ້? ລາວ​ກຳລັງ​ເວົ້າ​ໝິ່ນປະໝາດ​ພຣະເຈົ້າ! ນອກຈາກ​ພຣະເຈົ້າ​ແລ້ວ ຈະ​ມີ​ຜູ້ໃດ​ສາມາດ​ອະໄພ​ບາບ​ໄດ້?”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />ພຣະເຢຊູເຈົ້າ​ຮູ້​ໃນ​ໃຈ​ຂອງ​ພຣະອົງ​ທັນທີ​ວ່າ​ພວກເຂົາ​ກຳລັງ​ຄິດ​ຫຍັງ​ຢູ່ ພຣະອົງ​ຈຶ່ງ​ກ່າວ​ຕໍ່​ພວກເຂົາ​ວ່າ, “ເປັນຫຍັງ​ພວກເຈົ້າ​ຈຶ່ງ​ຄິດ​ຢ່າງ​ນັ້ນ? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />ອັນໃດ​ຈະ​ງ່າຍ​ກວ່າ​ກັນ​ທີ່​ຈະ​ກ່າວ​ແກ່​ຄົນເປ້ຍ​ນັ້ນ​ວ່າ, ‘ບາບ​ຂອງ​ເຈົ້າ​ໄດ້​ຮັບ​ອະໄພ​ແລ້ວ’ ຫລື ກ່າວ​ວ່າ ‘ຈົ່ງ​ລຸກຂຶ້ນ, ເອົາ​ບ່ອນນອນ​ຂອງ​ເຈົ້າ ແລະ ຍ່າງ​ໄປ?’ <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />ແຕ່​ເຮົາ​ຢາກ​ໃຫ້​ພວກເຈົ້າ​ທັງຫລາຍ​ຮູ້​ວ່າ​ບຸດມະນຸດ​ມີ​ສິດອຳນາດ​ໃນ​ໂລກ​ທີ່​ຈະ​ອະໄພ​ຄວາມບາບ” ດັ່ງນັ້ນ ພຣະອົງ​ຈຶ່ງ​ກ່າວ​ກັບ​ຄົນເປ້ຍ​ນັ້ນ​ວ່າ, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“ເຮົາ​ບອກ​ເຈົ້າ​ວ່າ, ຈົ່ງ​ລຸກຂຶ້ນ, ຍົກ​ເອົາ​ບ່ອນນອນ​ຂອງ​ເຈົ້າ ແລະ ເມືອ​ເຮືອນ​ສາ”. <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />ລາວ​ຈຶ່ງ​ລຸກຂຶ້ນ, ຍົກ​ເອົາ​ບ່ອນນອນ​ຂອງ​ຕົນ ແລະ ກໍ​ຍ່າງ​ອອກ​ໄປ​ຕໍ່ໜ້າ​ຄົນ​ທັງຫລາຍ. ທຸກຄົນ​ຕ່າງ​ກໍ​ປະຫລາດໃຈ ແລະ ສັນລະເສີນ​ພຣະເຈົ້າ ແລະ ເວົ້າ​ວ່າ, “ພວກເຮົາ​ບໍ່​ເຄີຍ​ພົບເຫັນ​ເຫດການ​ຢ່າງ​ນີ້​ຈັກ​ເທື່ອ!”<verse eid="MRK 2:12" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ເອີ້ນ​ເອົາ​ເລວີ ແລະ ຮັບປະທານ​ອາຫານ​ຮ່ວມກັບ​ຄົນບາບ</para>
  <para style="r">(ມທ 9:9-13; ລກ 5:27-32)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />ອີກ​ຄັ້ງ​ໜຶ່ງ ພຣະເຢຊູເຈົ້າ​ໄດ້​ອອກ​ໄປ​ທີ່​ແຄມຝັ່ງ​ທະເລສາບ. ປະຊາຊົນ​ຈໍານວນ​ຫລວງຫລາຍ​ໄດ້​ພາກັນ​ມາ​ຫາ​ພຣະອົງ ແລະ ພຣະອົງ​ໄດ້​ສັ່ງສອນ​ພວກເຂົາ. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />ໃນຂະນະ​ທີ່​ພຣະອົງ​ຍ່າງ​ໄປ​ຕາມ​ທາງ​ນັ້ນ ພຣະອົງ​ກໍ​ເຫັນ​ເລວີ ລູກຊາຍ​ຂອງ​ອາລະຟາຍ ກຳລັງ​ນັ່ງ​ຢູ່​ດ່ານເກັບພາສີ ພຣະເຢຊູເຈົ້າ​ຈຶ່ງ​ກ່າວ​ກັບ​ລາວ​ວ່າ, “ຈົ່ງ​ຕາມ​ເຮົາ​ມາ,” ແລ້ວ​ເລວີ​ກໍ​ລຸກຂຶ້ນ ແລະ ຕິດຕາມ​ພຣະອົງ​ໄປ.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />ໃນຂະນະ​ທີ່​ພຣະເຢຊູເຈົ້າ​ກຳລັງ​ກິນ​ອາຫານແລງ​ຢູ່​ເຮືອນ​ຂອງ​ເລວີ, ມີ​ຄົນເກັບພາສີ ແລະ ຄົນບາບ​ຫລາຍ​ຄົນ​ກໍ​ໄດ້​ມາ​ຮ່ວມ​ກິນ​ອາຫານ​ກັບ​ພຣະອົງ ແລະ ພວກສາວົກ​ຂອງ​ພຣະອົງ, ເພາະວ່າ​ມີ​ຫລາຍ​ຄົນ​ໄດ້​ຕິດຕາມ​ພຣະອົງ. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />ເມື່ອ​ພວກ​ຄູສອນກົດບັນຍັດ​ຜູ້​ທີ່​ເປັນ​ຟາຣີຊາຍ​ໄດ້​ເຫັນ​ພຣະອົງ​ກຳລັງ​ກິນ​ອາຫານ​ຮ່ວມ​ກັບ​ຄົນເກັບພາສີ ແລະ ຄົນບາບ, ພວກເຂົາ​ຈຶ່ງ​ຖາມ​ພວກສາວົກ​ຂອງ​ພຣະອົງ​ວ່າ, “ເປັນຫຍັງ​ເພິ່ນ​ຈຶ່ງ​ກິນ​ອາຫານ​ຮ່ວມ​ກັບ​ຄົນເກັບພາສີ ແລະ ຄົນບາບ?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />ເມື່ອ​ໄດ້​ຍິນ​ດັ່ງນີ້, ພຣະເຢຊູເຈົ້າ​ຈຶ່ງ​ກ່າວ​ກັບ​ພວກເຂົາ​ວ່າ, “ຄົນ​ສຸຂະພາບດີ​ບໍ່​ຕ້ອງການ​ໝໍ, ແຕ່​ຄົນເຈັບ​ຕ້ອງການ​ໝໍ. ເຮົາ​ບໍ່​ໄດ້​ມາ​ເພື່ອ​ເອີ້ນ​ເອົາ​ຄົນຊອບທຳ, ແຕ່​ມາ​ເພື່ອ​ເອີ້ນ​ເອົາ​ຄົນບາບ​ທັງຫລາຍ”.<verse eid="MRK 2:17" /></para>
  <para style="s1">ຄຳຖາມ​ເລື່ອງ​ການຖືສິນອົດອາຫານ</para>
  <para style="r">(ມທ 9:14-17; ລກ 5:33-38)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />ໃນຂະນະ​ນັ້ນ ພວກລູກສິດ​ຂອງ​ໂຢຮັນ ແລະ ພວກ​ຟາຣີຊາຍ ກຳລັງ​ຖືສິນອົດອາຫານ​ຢູ່. ມີ​ບາງຄົນ​ມາ​ຖາມ​ພຣະເຢຊູເຈົ້າ​ວ່າ, “ດ້ວຍເຫດໃດ ພວກລູກສິດ​ຂອງ​ໂຢຮັນ ແລະ ພວກ​ຟາຣີຊາຍ​ຈຶ່ງ​ຖືສິນອົດອາຫານ, ແຕ່​ເປັນຫຍັງ​ພວກສາວົກ​ຂອງ​ທ່ານ​ບໍ່​ຖືສິນອົດອາຫານ?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />ພຣະເຢຊູເຈົ້າ​ຕອບ​ວ່າ, “ຈະ​ໃຫ້​ແຂກ​ຂອງ​ເຈົ້າ​ບ່າວ​ຖືສິນອົດອາຫານ​ຂະນະ​ທີ່​ເຈົ້າບ່າວ​ຢູ່​ນຳ​ໄດ້​ຢ່າງໃດ? ເມື່ອ​ໃດ​ເຈົ້າບ່າວ​ຍັງ​ຢູ່​ນຳ​ພວກເຂົາ ພວກເຂົາ​ກໍ​ເຮັດ​ຢ່າງ​ນັ້ນ​ບໍ່​ໄດ້. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />ແຕ່​ເວລາ​ນັ້ນ​ຈະ​ມາ​ເຖິງ ຄື​ເມື່ອ​ເຈົ້າບ່າວ​ຈະ​ຖືກ​ນໍາ​ໂຕ​ໄປ​ຈາກ​ພວກເຂົາ, ວັນ​ນັ້ນ​ແຫລະ ພວກເຂົາ​ຈະ​ຖືສິນອົດອາຫານ.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“ບໍ່​ມີ​ຜູ້ໃດ​ທີ່​ເອົາ​ຕ່ອນ​ຜ້າ​ໃໝ່​ໄປ​ຕາບ​ເສື້ອ​ເກົ່າ. ຖ້າ​ເຮັດ​ຢ່າງ​ນັ້ນ​ຜ້າ​ໃໝ່​ຈະ​ຫົດ ແລະ ເຮັດ​ໃຫ້​ເສື້ອ​ເກົ່າ​ຂາດ​ເປັນ​ຮູ​ໃຫຍ່​ຕື່ມ​ອີກ. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />ແລະ ບໍ່​ມີ​ຜູ້ໃດ​ທີ່​ຖອກ​ເຫລົ້າອະງຸ່ນໃໝ່​ໃສ່​ຖົງໜັງ​ເກົ່າ. ຖ້າ​ເຮັດ​ຢ່າງ​ນັ້ນ ເຫລົ້າອະງຸ່ນ​ຈະ​ເຮັດ​ໃຫ້​ຖົງໜັງ​ນັ້ນ​ແຕກ ແລະ ເຫລົ້າອະງຸ່ນ​ກັບ​ທັງ​ຖົງ​ກໍ​ຈະ​ເສຍຫາຍ. ບໍ່​ດອກ, ພວກເຂົາ​ຕ້ອງ​ຖອກ​ເຫລົ້າອະງຸ່ນ​ໃໝ່​ໃສ່​ໃນ​ຖົງໜັງ​ໃໝ່​ເທົ່ານັ້ນ”.<verse eid="MRK 2:22" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ເປັນ​ອົງພຣະຜູ້ເປັນເຈົ້າ​ຂອງ​ວັນຊະບາໂຕ</para>
  <para style="r">(ມທ 12:1-14; ລກ 6:1-11)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />ໃນ​ວັນຊະບາໂຕ​ວັນ​ໜຶ່ງ ພຣະເຢຊູເຈົ້າ​ໄດ້​ຍ່າງ​ຜ່ານ​ທົ່ງນາ, ໃນ​ຂະນະ​ທີ່​ຍ່າງ​ໄປ​ຕາມ​ທາງ​ນັ້ນ ພວກສາວົກ​ຂອງ​ພຣະອົງ​ໄດ້​ເດັດ​ຮວງເຂົ້າ. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />ດັ່ງນັ້ນ ພວກ​ຟາຣີຊາຍ​ຈຶ່ງ​ເວົ້າ​ກັບ​ພຣະອົງ​ວ່າ, “ເບິ່ງ​ແມ, ເປັນຫຍັງ​ພວກເຂົາ​ຈຶ່ງ​ເຮັດ​ສິ່ງ​ທີ່​ຜິດ​ກົດບັນຍັດ​ໃນ​ວັນຊະບາໂຕ?”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />ພຣະອົງ​ຕອບ​ພວກເຂົາ​ວ່າ, “ພວກເຈົ້າ​ບໍ່​ເຄີຍ​ອ່ານ​ໃນ​ສິ່ງ​ທີ່​ດາວິດ ແລະ ຄົນ​ຂອງ​ເພິ່ນ​ໄດ້​ເຮັດ​ເມື່ອ​ເພິ່ນ​ຫິວເຂົ້າ ແລະ ຂັດສົນ​ນັ້ນ​ບໍ? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />ໃນ​ສະໄໝ​ນັ້ນ ແມ່ນ​ອາບີອາທາ​ເປັນ​ມະຫາ​ປະໂລຫິດ, ດາວິດ​ໄດ້​ເຂົ້າ​ໄປ​ໃນ​ທີ່ສະຖິດ​ຂອງ​ພຣະເຈົ້າ ແລະ ກິນ​ເຂົ້າຈີ່​ສັກສິດ, ເຊິ່ງ​ຕາມ​ກົດບັນຍັດ​ແລ້ວ ມີ​ແຕ່​ປະໂລຫິດ​ເທົ່ານັ້ນ​ທີ່​ມີ​ສິດ​ກິນ​ເຂົ້າຈີ່​ນີ້​ໄດ້. ແລະ ດາວິດ​ຍັງ​ໄດ້​ເອົາ​ເຂົ້າຈີ່​ນັ້ນ​ໃຫ້​ຄົນ​ຂອງ​ເພິ່ນ​ກິນ​ນຳ​ອີກ​ດ້ວຍ”.<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />ແລ້ວ​ພຣະອົງ​ກໍ​ກ່າວ​ກັບ​ພວກເຂົາ​ວ່າ, “ວັນຊະບາໂຕ​ຖືກ​ຕັ້ງ​ໄວ້​ເພື່ອ​ມະນຸດ, ບໍ່​ແມ່ນ​ມະນຸດ​ຖືກ​ຕັ້ງ​ໄວ້​ເພື່ອ​ວັນຊະບາໂຕ. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />ດັ່ງນັ້ນ ບຸດມະນຸດ​ຈຶ່ງ​ເປັນ​ອົງພຣະຜູ້ເປັນເຈົ້າ​ຂອງ​ວັນຊະບາໂຕ”.<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຮັກສາ​ໃນ​ວັນສະບາໂຕ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />ອີກ​ຄັ້ງ​ໜຶ່ງ ພຣະເຢຊູເຈົ້າ​ໄດ້​ເຂົ້າ​ໄປ​ໃນ​ທຳມະສາລາ ແລະ ຢູ່​ທີ່​ນັ້ນ​ມີ​ຊາຍ​ມືລີບ​ຄົນ​ໜຶ່ງ. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />ມີ​ບາງຄົນ​ໃນ​ພວກເຂົາ​ກຳລັງ​ຊອກຫາ​ສາເຫດ​ທີ່​ຈະ​ກ່າວໂທດ​ພຣະເຢຊູເຈົ້າ, ດັ່ງນັ້ນ ພວກເຂົາ​ຈຶ່ງ​ຕິດຕາມ​ເບິ່ງ​ພຣະອົງ​ຢ່າງ​ໃກ້ຊິດ​ວ່າ​ພຣະອົງ​ຈະ​ຮັກສາ​ຊາຍ​ຄົນ​ນີ້​ໃນ​ວັນຊະບາໂຕ ຫລື ບໍ່. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />ພຣະເຢຊູເຈົ້າ​ກ່າວ​ແກ່​ຊາຍ​ມືລີບ​ວ່າ, “ຈົ່ງ​ຢືນຂຶ້ນ​ຕໍ່ໜ້າ​ທຸກ​ຄົນ”.<verse eid="MRK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4" />ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ຖາມ​ພວກເຂົາ​ວ່າ, “ອັນ​ໃດ​ທີ່​ຖືກຕ້ອງ​ຕາມ​ກົດບັນຍັດ​ໃນ​ວັນຊະບາໂຕ ຈະ​ເຮັດ​ດີ ຫລື ເຮັດ​ຊົ່ວ, ຈະ​ຊ່ວຍ​ຊີວິດ ຫລື ທຳລາຍ​ຊີວິດ?” ແຕ່​ພວກເຂົາ​ໄດ້​ມິດ​ຢູ່.<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />ພຣະອົງ​ແນມ​ໄປ​ເບິ່ງ​ພວກເຂົາ​ດ້ວຍ​ຄວາມເຄືອງໃຈ ແລະ ເປັນທຸກໃຈ​ທີ່ສຸດ​ທີ່​ພວກເຂົາ​ໃຈ​ແຂງກະດ້າງ. ພຣະອົງ​ຈຶ່ງ​ກ່າວ​ແກ່​ຊາຍ​ຄົນ​ນັ້ນ​ວ່າ, “ຈົ່ງ​ຢຽດ​ມື​ຂອງ​ເຈົ້າ​ອອກ”. ລາວ​ກໍ​ເຮັດ​ຕາມ ແລະ ມື​ຂອງ​ລາວ​ກໍ​ດີ​ເປັນ​ປົກກະຕິ​ທຸກ​ຢ່າງ. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />ພວກ​ຟາຣີຊາຍ​ຈຶ່ງ​ໄດ້​ອອກ​ໄປ ແລະ ເລີ່ມ​ວາງແຜນ​ກັບ​ກຸ່ມ​ສະໜັບສະໜູນ​ເຮໂຣດ​ວ່າ​ຈະ​ຂ້າ​ພຣະເຢຊູເຈົ້າ.<verse eid="MRK 3:6" /></para>
  <para style="s1">ປະຊາຊົນ​ຕິດຕາມ​ພຣະເຢຊູເຈົ້າ</para>
  <para style="r">(<ref loc="MAT 12:15">ມທ 12:15</ref>,<ref loc="MAT 12:16">16</ref>; ລກ 6:17-19)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />ພຣະເຢຊູເຈົ້າ ແລະ ພວກສາວົກ​ຂອງ​ພຣະອົງ​ໄດ້​ແຍກໂຕ​ຈາກ​ທີ່​ນັ້ນ​ໄປ​ຍັງ​ທະເລສາບ, ມີ​ປະຊາຊົນ​ເປັນ​ຈຳນວນ​ຫລວງຫລາຍ​ມາ​ຈາກ​ແຂວງ​ຄາລີເລ​ໄດ້​ຕິດຕາມ​ພຣະອົງ​ໄປ. <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />ເມື່ອ​ພວກເຂົາ​ໄດ້​ຍິນ​ເຖິງ​ສິ່ງ​ຕ່າງໆ​ທີ່​ພຣະອົງ​ໄດ້​ກະທຳ​ແລ້ວ, ມີ​ຄົນ​ເປັນ​ຈຳນວນ​ຫລວງຫລາຍ​ທີ່​ມາ​ຈາກ​ແຂວງ​ຢູດາຍ, ຈາກ​ເຢຣູຊາເລັມ, ຈາກ​ເຂດແດນ​ອີດູມາຍ ແລະ ອີກ​ຟາກ​ໜຶ່ງ​ຂອງ​ແມ່ນ້ຳຈໍແດນ ແລະ ຂົງເຂດ​ອ້ອມແອ້ມ​ເມືອງ​ຕີເຣ ແລະ ເມືອງ​ຊີໂດນ​ໄດ້​ພາກັນ​ມາ​ຫາ​ພຣະອົງ. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />ເພາະ​ຍ້ອນ​ປະຊາຊົນ​ເຫລົ່ານີ້ ພຣະອົງ​ຈຶ່ງ​ສັ່ງ​ພວກສາວົກ​ຂອງ​ພຣະອົງ​ໃຫ້​ຕຽມ​ເຮືອ​ນ້ອຍ​ໄວ້​ໃຫ້​ພຣະອົງ​ລຳ​ໜຶ່ງ, ເພື່ອ​ບໍ່​ໃຫ້​ປະຊາຊົນ​ມາ​ບຽດ​ພຣະອົງ. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />ເນື່ອງ​ຈາກ​ວ່າ ພຣະເຢຊູເຈົ້າ​ໄດ້​ຮັກສາ​ຫລາຍຄົນ​ໃຫ້​ຫາຍດີ, ດັ່ງນັ້ນ ບັນດາ​ຜູ້​ທີ່​ເຈັບ​ເປັນ​ດ້ວຍ​ພະຍາດ​ຕ່າງໆ​ຈຶ່ງ​ບຽດ​ກັນ​ເຂົ້າ​ມາ​ເພື່ອ​ທີ່​ຈະ​ໄດ້​ຈັບບາຍ​ພຣະອົງ. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />ເມື່ອ​ໃດ​ທີ່​ພວກ​ວິນຍານສົກກະປົກ​ໄດ້​ເຫັນ​ພຣະອົງ ພວກມັນ​ກໍ​ຂາບ​ລົງ​ຕໍ່ໜ້າ​ພຣະອົງ ແລະ ຮ້ອງ​ວ່າ, “ທ່ານ​ເປັນ​ພຣະບຸດ​ຂອງ​ພຣະເຈົ້າ”. <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />ແຕ່​ພຣະອົງ​ຫ້າມ​ພວກມັນ​ຢ່າງ​ເດັດຂາດ​ບໍ່​ໃຫ້​ບອກ​ຄົນ​ອື່ນ​ກ່ຽວກັບ​ເລື່ອງ​ຂອງ​ພຣະອົງ.<verse eid="MRK 3:12" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ແຕ່ງຕັ້ງ​ອັກຄະສາວົກ​ສິບສອງ​ຄົນ</para>
  <para style="r">(ມທ 10:2-4; ລກ 6:14-16; <ref loc="ACT 1:13">ກຈກ 1:13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />ພຣະເຢຊູເຈົ້າ​ໄດ້​ຂຶ້ນ​ໄປ​ເທິງ​ພູເຂົາ​ແຫ່ງ​ໜຶ່ງ ແລະ ເອີ້ນ​ເອົາ​ບັນດາ​ຜູ້​ທີ່​ພຣະອົງ​ຕ້ອງການ​ມາ​ຫາ​ພຣະອົງ, ແລະ ພວກເພິ່ນ​ໄດ້​ມາ​ຫາ​ພຣະອົງ. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />ພຣະອົງ​ໄດ້​ແຕ່ງຕັ້ງ​ສິບສອງ​ຄົນ​ໃຫ້​ເປັນ​ອັກຄະສາວົກ<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ບາງ​ສະບັບ​ບໍ່​ມີ​ຂໍ້​ຄວາມ​ວ່າ </char><char style="fqa" closed="false">ເປັນ​ອັກຄະສາວົກ</char></note>​ໃຫ້​ຢູ່​ກັບ​ພຣະອົງ ແລະ ພຣະອົງ​ຈະ​ໃຊ້​ພວກເພິ່ນ​ອອກ​ໄປ​ປະກາດ, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />ແລະ ໃຫ້​ພວກເພິ່ນ​ມີ​ສິດອຳນາດ​ທີ່​ຈະ​ຂັບໄລ່​ຜີມານຮ້າຍ​ອອກ​ໄດ້.<verse eid="MRK 3:15" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="16" style="v" sid="MRK 3:16" />ບັນດາ​ສິບສອງ​ຄົນ​ທີ່​ພຣະອົງ​ໄດ້​ແຕ່ງຕັ້ງ​ມີ​ດັ່ງນີ້:</para>
  <para style="b" vid="MRK 3:16" />
  <para style="li1" vid="MRK 3:16">ຊີໂມນ (ພຣະອົງ​ໄດ້​ຕັ້ງ​ຊື່​ໃຫ້​ວ່າ​ເປໂຕ),<verse eid="MRK 3:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="MRK 3:17" />ຢາໂກໂບ​ລູກຊາຍ​ຂອງ​ເຊເບດາຍ ແລະ ໂຢຮັນ​ຜູ້​ເປັນ​ນ້ອງຊາຍ​ຂອງ​ຢາໂກໂບ (ພຣະອົງ​ໄດ້​ຕັ້ງ​ຊື່​ໃຫ້​ທັງ​ສອງ​ຄົນ​ວ່າ​ໂບອະເນເຄ ເຊິ່ງ​ມີ​ຄວາມໝາຍ​ວ່າ​ລູກຟ້າຮ້ອງ),<verse eid="MRK 3:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="MRK 3:18" />ອັນເດອາ,</para>
  <para style="li1" vid="MRK 3:18">ຟີລິບ,</para>
  <para style="li1" vid="MRK 3:18">ບາຣະໂທໂລມາຍ,</para>
  <para style="li1" vid="MRK 3:18">ມັດທາຍ,</para>
  <para style="li1" vid="MRK 3:18">ໂທມາ,</para>
  <para style="li1" vid="MRK 3:18">ຢາໂກໂບ​ລູກຊາຍ​ຂອງ​ອາລະຟາຍ,</para>
  <para style="li1" vid="MRK 3:18">ທາດາຍ,</para>
  <para style="li1" vid="MRK 3:18">ຊີໂມນ​ຜູ້ຮັກຊາດ<verse eid="MRK 3:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="MRK 3:19" />ແລະ ຢູດາ​ອິດສະກາຣີອົດ, ຜູ້​ທີ່​ທໍລະຍົດ​ຕໍ່​ພຣະອົງ.<verse eid="MRK 3:19" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຖືກ​ກ່າວຫາ​ໂດຍ​ຄອບຄົວ​ຂອງ​ພຣະອົງ ແລະ ໂດຍ​ຄູສອນກົດບັນຍັດ</para>
  <para style="r">(ມທ 12:25-29; ລກ 11:17-22)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ໄດ້​ເຂົ້າ​ໄປ​ໃນ​ເຮືອນ ແລະ ປະຊາຊົນ​ກໍ​ໄດ້​ມາ​ເຕົ້າໂຮມກັນ​ອີກ​ຈົນ​ພຣະອົງ ແລະ ພວກສາວົກ​ຂອງ​ພຣະອົງ​ບໍ່​ມີ​ເວລາ​ແມ່ນແຕ່​ຈະ​ຮັບປະທານ​ອາຫານ. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />ເມື່ອ​ຄົນ​ໃນ​ຄອບຄົວ​ຂອງ​ພຣະອົງ​ໄດ້​ຍິນ​ເລື່ອງ​ນີ້ ພວກເຂົາ​ກໍ​ມາ​ເພື່ອ​ຈະ​ຫ້າມ​ພຣະອົງ​ໄວ້, ເພາະ​ພວກເຂົາ​ເວົ້າ​ວ່າ, “ພຣະອົງ​ເສຍສະຕິ​ໄປ​ແລ້ວ”.<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />ແລະ ພວກ​ຄູສອນກົດບັນຍັດ​ທີ່​ລົງ​ມາ​ຈາກ​ນະຄອນ​ເຢຣູຊາເລັມ​ໄດ້​ເວົ້າ​ວ່າ, “ຜູ້​ນີ້​ຖືກ​ເບເອນເຊບູນ<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">ພາສາ​ກຣີກ​ວ່າ </char><char style="fqa" closed="false">ເບເຊບູນ </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ເບເອນເຊບູນ</char></note>​ເຂົ້າ​ສິງ​ຢູ່! ໂດຍ​ອຳນາດ​ຂອງ​ນາຍ​ຜີມານຮ້າຍ ລາວ​ຈຶ່ງ​ຂັບໄລ່​ພວກຜີມານຮ້າຍ​ອອກ​ໄດ້”.<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />ສະນັ້ນ ພຣະເຢຊູເຈົ້າ​ຈຶ່ງ​ເອີ້ນ​ພວກເຂົາ​ມາ ແລະ ກ່າວ​ກັບ​ພວກເຂົາ​ເປັນ​ຄຳອຸປະມາ​ວ່າ, “ມານຊາຕານ​ຈະ​ຂັບໄລ່​ມານຊາຕານ​ອອກ​ໄດ້​ຢ່າງ​ໃດ? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />ຖ້າ​ອານາຈັກ​ໃດ​ເກີດ​ແຕກແຍກກັນ​ແລ້ວ ອານາຈັກ​ນັ້ນ​ກໍ​ຕັ້ງ​ຢູ່​ຕໍ່ໄປ​ບໍ່​ໄດ້. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />ຖ້າ​ເຮືອນ​ຫລັງ​ໃດ​ເກີດ​ແຕກແຍກກັນ ເຮືອນ​ຫລັງນັ້ນ​ກໍ​ຈະ​ຕັ້ງ​ຢູ່​ບໍ່​ໄດ້. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />ແລະ ຖ້າ​ມານຊາຕານ​ຕໍ່ຕ້ານ​ກັນ​ເອງ ແລະ ແຕກແຍກກັນ, ມັນ​ກໍ​ຕັ້ງ​ຢູ່​ບໍ່​ໄດ້ ຈຸດຈົບ​ຂອງ​ມັນ​ກໍ​ມາ​ເຖິງ​ແລ້ວ. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />ຕາມຄວາມຈິງ​ແລ້ວ ບໍ່​ມີ​ຜູ້ໃດ​ສາມາດ​ເຂົ້າ​ໄປ​ໃນ​ເຮືອນ​ຂອງ​ຄົນແຂງແຮງ​ໄດ້ ເວັ້ນໄວ້​ແຕ່​ໄດ້​ມັດ​ຄົນແຂງແຮງ​ນັ້ນ​ໄວ້​ກ່ອນ ແລ້ວ​ຈຶ່ງ​ປຸ້ນ​ເຮືອນ​ຂອງ​ລາວ​ໄດ້. <verse eid="MRK 3:27" /><verse number="28" style="v" sid="MRK 3:28" />ເຮົາ​ບອກ​ພວກເຈົ້າ​ຕາມ​ຄວາມຈິງ​ວ່າ, ການ​ບາບ ແລະ ຄຳ​ໝິ່ນປະໝາດ​ທຸກຢ່າງ​ທີ່​ມະນຸດ​ກ່າວ​ສາມາດ​ໃຫ້​ອະໄພ​ໄດ້. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />ແຕ່​ຜູ້ໃດ​ກໍ​ຕາມ​ທີ່​ໝິ່ນປະໝາດ​ຕໍ່ສູ້​ພຣະວິນຍານບໍລິສຸດເຈົ້າ​ຈະ​ບໍ່​ໄດ້​ຮັບ​ການ​ອະໄພ​ຈັກເທື່ອ, ພວກເຂົາ​ໄດ້​ເຮັດ​ຄວາມຜິດ​ອັນ​ເປັນ​ບາບ​ຕິດ​ໂຕ​ຕະຫລອດໄປ”.<verse eid="MRK 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 3:30" />ພຣະອົງ​ກ່າວ​ຢ່າງ​ນີ້​ກໍ​ເພາະ​ພວກເຂົາ​ໄດ້​ເວົ້າ​ວ່າ, “ເພິ່ນ​ມີ​ວິນຍານສົກກະປົກ​ເຂົ້າ​ສິງ​ຢູ່”.<verse eid="MRK 3:30" /></para>
  <para style="s1">ມານດາ ແລະ ພວກ​ນ້ອງຊາຍ​ຂອງ​ພຣະເຢຊູເຈົ້າ</para>
  <para style="r">(ມທ 12:46-50; ລກ 8:19-21)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />ແລ້ວ​ມານດາ ແລະ ພວກ​ນ້ອງຊາຍ​ຂອງ​ພຣະເຢຊູເຈົ້າ​ກໍ​ມາ​ເຖິງ. ພວກເຂົາ​ໄດ້​ຢືນ​ຢູ່​ຂ້າງນອກ ແລະ ໃຊ້​ຄົນ​ເຂົ້າ​ໄປ​ເອີ້ນ​ພຣະອົງ. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />ປະຊາຊົນ​ນັ່ງ​ອ້ອມ​ພຣະອົງ​ຢູ່ ແລະ ພວກເຂົາ​ໄດ້​ບອກ​ພຣະອົງ​ວ່າ, “ມານດາ ແລະ ບັນດາ​ນ້ອງຊາຍ​ຂອງ​ທ່ານ​ກຳລັງ​ຊອກຫາ​ທ່ານຢູ່​ທາງນອກ”. <verse eid="MRK 3:32" /><verse number="33" style="v" sid="MRK 3:33" />ພຣະອົງ​ຖາມ​ວ່າ, “ຜູ້ໃດ​ເປັນ​ມານດາ ແລະ ຜູ້ໃດ​ເປັນ​ພວກ​ນ້ອງຊາຍ​ຂອງ​ເຮົາ?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />ແລ້ວ​ພຣະອົງ​ກໍ​ຫລຽວ​ເບິ່ງ​ບັນດາ​ປະຊາຊົນ​ທີ່​ນັ່ງ​ອ້ອມ​ພຣະອົງ​ຢູ່​ນັ້ນ ແລະ ໄດ້​ກ່າວ​ວ່າ, “ນີ້​ຄື​ແມ່ ແລະ ນ້ອງຊາຍ​ຂອງ​ເຮົາ! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />ຜູ້ໃດ​ທີ່​ເຮັດ​ຕາມ​ຄວາມ​ປະສົງ​ຂອງ​ພຣະເຈົ້າ ຜູ້​ນັ້ນ​ກໍ​ເປັນ​ນ້ອງຊາຍ ແລະ ເປັນ​ນ້ອງສາວ ແລະ ເປັນ​ແມ່​ຂອງ​ເຮົາ”.<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s1">ຄຳອຸປະມາ​ເລື່ອງ​ຜູ້ຫວ່ານ</para>
  <para style="r">(ມທ 13:1-15,18-23; ລກ 8:4-15)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ໄດ້​ສັ່ງສອນ​ທີ່​ແຄມ​ທະເລສາບ​ອີກ. ປະຊາຊົນ​ໄດ້​ມາ​ເຕົ້າໂຮມກັນ​ອ້ອມ​ພຣະອົງ​ຢ່າງ​ແໜ້ນໜາ​ຫລາຍ ຈົນ​ພຣະອົງ​ຕ້ອງ​ລົງ​ໄປ​ນັ່ງ​ໃນ​ເຮືອ​ຢູ່​ແຄມ​ຝັ່ງ​ທະເລສາບ, ສ່ວນ​ປະຊາຊົນ​ນັ້ນ​ຢູ່​ເທິງ​ບົກ​ຕາມ​ແຄມ​ຝັ່ງ. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />ພຣະອົງ​ໄດ້​ໃຊ້​ຄຳອຸປະມາ​ຫລາຍ​ເລື່ອງ​ເພື່ອ​ສອນ​ພວກເຂົາ ແລະ ພຣະອົງ​ໄດ້​ສອນ​ວ່າ: <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />“ຈົ່ງ​ຟັງ​ໃຫ້​ດີ! ມີ​ຊາວນາ​ຄົນ​ໜຶ່ງ​ອອກ​ໄປ​ຫວ່ານ​ເມັດພືດ. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />ໃນຂະນະ​ທີ່​ລາວ​ກຳລັງ​ຫວ່ານ​ເມັດພືດ​ຢູ່​ນັ້ນ ບາງເມັດ​ກໍ​ຕົກ​ຕາມ​ທາງ ແລ້ວ​ຝູງ​ນົກ​ກໍ​ສັບກິນ​ເມັດພືດ​ນັ້ນ​ຈົນ​ໝົດ. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />ບາງເມັດ​ຕົກ​ໃສ່​ບ່ອນ​ທີ່​ມີ​ຫີນ ເຊິ່ງ​ເປັນ​ບ່ອນ​ທີ່​ມີ​ດິນ​ໜ້ອຍ ເມັດ​ເຫລົ່ານີ້​ຈຶ່ງ​ງອກ​ຂຶ້ນ​ໄດ້​ໄວ​ເພາະ​ພື້ນດິນ​ບໍ່​ເລິກ. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />ແຕ່​ເມື່ອ​ຕາເວັນ​ຂຶ້ນ​ມາ​ພືດ​ນັ້ນ​ກໍ​ຖືກ​ແດດເຜົາ ແລະ ຫ່ຽວແຫ້ງ​ໄປ​ເພາະ​ບໍ່​ມີ​ຮາກ. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />ບາງເມັດ​ກໍ​ຕົກ​ໃສ່​ທ່າມກາງ​ຟຸ່ມໜາມ, ເຊິ່ງ​ຕົ້ນໜາມ​ເຫລົ່ານີ້​ກໍ​ໃຫຍ່​ຂຶ້ນ ແລະ ຫຸ້ມຮັດ​ພືດ​ເຫລົ່ານັ້ນ ຈຶ່ງ​ເກີດຜົນ​ບໍ່​ໄດ້. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />ຍັງ​ມີ​ບາງເມັດ​ອີກ​ທີ່​ຕົກໃສ່​ດິນ​ດີ ພືດ​ກໍ​ງອກ​ຂຶ້ນ​ມາ, ເຕີບໃຫຍ່​ຂຶ້ນ ແລະ ເກີດຜົນ​ສາມສິບ​ເທົ່າ, ຫົກສິບ​ເທົ່າ, ແລະ ຮ້ອຍ​ເທົ່າ”.<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ກ່າວ​ວ່າ, “ຜູ້ໃດ​ມີ​ຫູ, ກໍ​ຈົ່ງ​ຟັງ​ເອົາ”.<verse eid="MRK 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />ເມື່ອ​ພຣະອົງ​ຢູ່​ຕາມ​ລຳພັງ​ແລ້ວ, ພວກສາວົກ​ທັງ​ສິບສອງ​ຄົນ​ກັບ​ຄົນ​ອື່ນໆ​ທີ່​ຕິດຕາມ​ພຣະອົງ​ບາງຄົນ​ຈຶ່ງ​ຖາມ​ພຣະອົງ​ກ່ຽວ​ກັບ​ຄຳອຸປະມາ​ດັ່ງ​ກ່າວ. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />ພຣະອົງ​ບອກ​ພວກເຂົາ​ວ່າ, “ຄວາມເລິກລັບ​ແຫ່ງ​ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ​ໃຫ້​ພວກເຈົ້າ​ຮູ້​ໄດ້. ແຕ່​ສ່ວນ​ຄົນນອກ​ນັ້ນ ທຸກຢ່າງ​ຈະ​ໃຊ້​ຄຳອຸປະມາ <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />ເພື່ອ​ວ່າ,</para>
  <para style="q1" vid="MRK 4:12">“ ‘ພວກເຂົາ​ເບິ່ງ​ແລ້ວ​ເບິ່ງ​ອີກ​ແຕ່​ກໍ​ຈະ​ບໍ່​ເຫັນ</para>
  <para style="q2" vid="MRK 4:12">ແລະ ຈະ​ຟັງ​ແລ້ວ​ຟັງ​ອີກ​ແຕ່​ຈະ​ບໍ່​ເຂົ້າໃຈ</para>
  <para style="q1" vid="MRK 4:12">ບໍ່​ດັ່ງນັ້ນ​ແລ້ວ ພວກເຂົາ​ຈະ​ຫັນ​ກັບ​ຄືນ​ມາ ແລະ ໄດ້​ຮັບ​ການ​ອະໄພ!’<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 6:9">ອຊຢ 6:9</ref>,<ref loc="ISA 6:10">10</ref></char></char></note>”<verse eid="MRK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ກ່າວ​ກັບ​ພວກເພິ່ນ​ວ່າ, “ພວກເຈົ້າ​ບໍ່​ເຂົ້າໃຈ​ຄຳອຸປະມາ​ນີ້​ບໍ? ຖ້າ​ເປັນ​ຢ່າງນັ້ນ ພວກເຈົ້າ​ຈະ​ເຂົ້າໃຈ​ຄຳອຸປະມາ​ເລື່ອງ​ອື່ນ​ໄດ້​ຢ່າງໃດ? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />ຊາວນາ​ນັ້ນ​ໄດ້​ຫວ່ານ​ພຣະທຳ. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />ບາງຄົນ​ກໍ​ເປັນ​ເໝືອນ​ເມັດພືດ​ທີ່​ຕົກ​ຕາມ​ທາງ. ຄື​ຄົນ​ທີ່​ໄດ້​ຍິນ​ພຣະຄຳ, ທັນໃດນັ້ນ ມານຊາຕານ​ກໍ​ມາ​ຍາດຊີງ​ເອົາ​ພຣະຄຳ​ທີ່​ໄດ້​ຫວ່ານ​ລົງ​ໃນ​ພວກເຂົາ​ໄປ. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />ບາງຄົນ​ກໍ​ເປັນ​ເໝືອນ​ເມັດພືດ​ທີ່​ຫວ່ານ​ລົງ​ເທິງ​ບ່ອນ​ມີ​ຫີນ​ຫລາຍ, ເມື່ອ​ໄດ້​ຍິນ​ພຣະຄຳ​ແລ້ວ​ກໍ​ຮັບ​ເອົາ​ໄວ້​ທັນທີ​ດ້ວຍ​ຄວາມຍິນດີ. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />ແຕ່​ຍ້ອນ​ພວກເຂົາ​ບໍ່​ມີ​ຮາກ​ຈຶ່ງ​ທົນ​ຢູ່​ບໍ່​ໄດ້​ດົນ. ເມື່ອ​ມີ​ຄວາມຍາກລຳບາກ ຫລື ຖືກ​ຂົ່ມເຫັງ​ເພາະ​ພຣະຄຳ ພວກເຂົາ​ກໍ​ລົ້ມເລີກ​ໄປ​ທັນທີ. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />ຍັງ​ມີ​ບາງຄົນ​ເປັນ​ເໝືອນ​ເມັດພືດ​ທີ່​ຫວ່ານ​ລົງ​ກາງ​ຟຸ່ມໜາມ, ຄື​ຜູ້​ທີ່​ໄດ້​ຍິນ​ພຣະຄຳ, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />ແຕ່​ມີ​ຄວາມກັງວົນ​ໃນ​ຊີວິດ​ນີ້, ຄວາມຫລອກລວງ​ຂອງ​ຄວາມຮັ່ງມີ ແລະ ຕະຫລອດ​ທັງ​ຄວາມປາຖະໜາ​ໃນ​ສິ່ງ​ຕ່າງໆ​ໄດ້​ເຂົ້າ​ມາ​ຫຸ້ມຮັດ​ພຣະຄຳ​ໄວ້ ຈຶ່ງ​ເຮັດ​ໃຫ້​ພຣະຄຳ​ບໍ່​ເກີດຜົນ. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />ບາງຄົນ​ເປັນ​ເໝືອນ​ເມັດພືດ​ທີ່​ຫວ່ານ​ລົງ​ດິນ​ດີ, ຄື​ຜູ້​ທີ່​ໄດ້​ຍິນ​ພຣະຄຳ, ຕ້ອນຮັບ​ເອົາ​ພຣະຄຳ​ໄວ້ ແລະ ເກີດຜົນ​ສາມສິບ​ເທົ່າ, ຫົກສິບ​ເທົ່າ ແລະ ຮ້ອຍ​ເທົ່າ​ຂອງ​ທີ່​ໄດ້​ຫວ່ານ​ລົງ​ໄປ”.<verse eid="MRK 4:20" /></para>
  <para style="s1">ຕະກຽງ​ຢູ່​ເທິງ​ຫລັກຕະກຽງ</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />ພຣະອົງ​ໄດ້​ກ່າວ​ກັບ​ພວກເພິ່ນ​ວ່າ, “ພວກເຈົ້າ​ເອົາ​ຕະກຽງ​ວາງ​ໄວ້​ໃນ​ກະບຸງ ຫລື ເອົາ​ວາງ​ໄວ້​ຢູ່​ກ້ອງ​ຕຽງນອນ​ແທນທີ່​ພວກເຈົ້າ​ຈະ​ຕັ້ງ​ໄວ້​ເທິງ​ຫລັກຕະກຽງ​ບໍ? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />ເພາະ​ສິ່ງໃດ​ທີ່​ຖືກ​ເຊື່ອງຊ້ອນ​ໄວ້​ຈະ​ຖືກ​ນຳ​ອອກມາ​ປາກົດ​ໃຫ້​ເຫັນ ແລະ ສິ່ງໃດ​ທີ່​ຖືກ​ປິດບັງ​ໄວ້​ກໍ​ຈະ​ຖືກ​ນຳ​ມາ​ເປີດເຜີຍ​ໃຫ້​ຮູ້. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />ຜູ້ໃດ​ມີ​ຫູ, ກໍ​ຈົ່ງ​ຟັງ​ເອົາ”.<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />ພຣະອົງ​ກ່າວ​ຕໍ່​ໄປ​ອີກ​ວ່າ, “ຈົ່ງ​ພິຈາລະນາ​ສິ່ງ​ທີ່​ພວກເຈົ້າ​ໄດ້​ຍິນ​ໃຫ້​ດີ. ພວກເຈົ້າ​ຈະ​ຕວງ​ໃຫ້​ເຂົາ​ດ້ວຍ​ເຄື່ອງຜອງ​ຢ່າງໃດ, ພວກເຈົ້າ​ກໍ​ຈະ​ໄດ້​ຮັບ​ດ້ວຍ​ເຄື່ອງຜອງ​ຢ່າງນັ້ນ ແລະ ຈະ​ໄດ້​ຮັບ​ຫລາຍກວ່າ​ນັ້ນ​ອີກ. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />ຜູ້ໃດ​ກໍ​ຕາມ​ທີ່​ມີ​ຢູ່​ແລ້ວ​ກໍ​ຈະ​ໄດ້​ຮັບ​ເພີ່ມເຕີມ​ຂຶ້ນ​ອີກ, ສ່ວນ​ຜູ້​ທີ່​ບໍ່​ມີ ແມ່ນແຕ່​ສິ່ງ​ທີ່​ພວກເຂົາ​ມີ​ຢູ່​ນັ້ນ ກໍ​ຈະ​ຖືກ​ຍົກ​ເອົາ​ໄປ​ຈາກ​ພວກເຂົາ”.<verse eid="MRK 4:25" /></para>
  <para style="s1">ຄຳອຸປະມາ​ເລື່ອງ​ເມັດພືດ​ທີ່​ງອກ​ຂຶ້ນ</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />ພຣະອົງ​ກ່າວ​ອີກ​ວ່າ, “ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ​ກໍ​ເປັນ​ເໝືອນ ຄົນ​ໜຶ່ງ​ຫວ່ານ​ເມັດພືດ​ລົງ​ໃນ​ດິນ. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />ໃນ​ເວລາ​ກາງເວັນ ແລະ ເວລາ​ກາງຄືນ ບໍ່​ວ່າ​ລາວ​ຈະ​ນອນຫລັບ ຫລື ຕື່ນ​ຂຶ້ນ, ເມັດພືດ​ນັ້ນ​ກໍ​ງອກ ແລະ ເຕີບໃຫຍ່​ຂຶ້ນ ເຖິງ​ວ່າ​ລາວ​ບໍ່​ຮູ້​ວ່າ​ມັນ​ງອກ​ຂຶ້ນ​ໄດ້​ຢ່າງໃດ. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />ແມ່ນ​ດິນ​ເອງ​ທີ່​ເຮັດ​ໃຫ້​ເມັດພືດ​ງອກ​ຂຶ້ນ, ທຳອິດ​ເປັນ​ຕົ້ນອ່ອນ ຕໍ່ມາ​ກໍ​ມີ​ເມັດເຂົ້າ​ເຕັມ​ຮວງ. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />ທັນທີ​ທີ່​ເຂົ້າ​ສຸກ​ແລ້ວ ລາວ​ກໍ​ໃຊ້​ກ່ຽວ​ເພື່ອ​ກ່ຽວ​ເຂົ້າ​ນັ້ນ ເພາະ​ເວລາ​ເກັບກ່ຽວ​ໄດ້​ມາ​ເຖິງ​ແລ້ວ”.<verse eid="MRK 4:29" /></para>
  <para style="s1">ຄຳອຸປະມາ​ເລື່ອງ​ເມັດພືດ</para>
  <para style="r">(<ref loc="MAT 13:31">ມທ 13:31</ref>,<ref loc="MAT 13:32">32</ref>; <ref loc="LUK 13:18">ລກ 13:18</ref>,<ref loc="LUK 13:19">19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />ພຣະອົງ​ກ່າວ​ອີກ​ວ່າ, “ພວກເຮົາ​ຈະ​ປຽບ​ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ​ກັບ​ສິ່ງ​ໃດ​ດີ, ຫລື ຈະ​ໃຊ້​ຄຳອຸປະມາ​ຢ່າງໃດ​ເພື່ອ​ມາ​ອະທິບາຍ​ເຖິງ​ອານາຈັກ​ນີ້? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ​ນັ້ນ​ກໍ​ປຽບເໝືອນ​ແກ່ນ​ຜັກກາດ​ເມັດ​ໜຶ່ງ, ເຊິ່ງ​ເປັນ​ເມັດ​ທີ່​ນ້ອຍ​ທີ່ສຸດ​ກວ່າ​ເມັດ​ໃດໆ​ທັງໝົດ​ໃນ​ໂລກ. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />ແຕ່​ເມື່ອ​ຫວ່ານ​ລົງ​ໄປ​ແລ້ວ ມັນ​ກໍ​ງອກ​ຂຶ້ນ ແລະ ກາຍ​ເປັນ​ຕົ້ນ​ທີ່​ໃຫຍ່​ທີ່ສຸດ​ກວ່າ​ຜັກ​ຊະນິດ​ອື່ນໆ​ໃນ​ສວນ ແລະ ແຕກ​ກິ່ງ​ໃຫຍ່​ອອກ​ຈົນ​ຝູງ​ນົກ​ສາມາດ​ມາ​ເຮັດຮັງ​ຢູ່​ໄດ້”.<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />ພຣະເຢຊູເຈົ້າ​ໄດ້​ກ່າວ​ຖ້ອຍຄຳ​ເປັນ​ຄຳອຸປະມາ​ຫລາຍ​ເລື່ອງ​ຢ່າງ​ດຽວ​ກັນ​ນີ້​ໃຫ້​ພວກເຂົາ​ຟັງ, ຕາມ​ທີ່​ພວກເຂົາ​ສາມາດ​ເຂົ້າໃຈ​ໄດ້. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />ພຣະອົງ​ກ່າວ​ກັບ​ພວກເຂົາ​ທຸກຄົນ​ເປັນ​ຄຳອຸປະມາ. ແຕ່​ເມື່ອ​ພຣະອົງ​ຢູ່​ຕາມ​ລຳພັງ​ກັບ​ພວກສາວົກ​ຂອງ​ພຣະອົງ​ແລ້ວ ພຣະອົງ​ກໍ​ອະທິບາຍ​ທຸກໆ​ສິ່ງ.<verse eid="MRK 4:34" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ສັ່ງຫ້າມ​ລົມພະຍຸ</para>
  <para style="r">(ມທ 8:18,23-27; ລກ 8:22-25)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />ໃນ​ຕອນຄ່ຳ​ຂອງ​ວັນ​ດຽວ​ກັນ​ນັ້ນ ພຣະເຢຊູເຈົ້າ​ໄດ້​ກ່າວ​ກັບ​ພວກສາວົກ​ຂອງ​ພຣະອົງ​ວ່າ, “ໃຫ້​ພວກເຮົາ​ຂ້າມ​ໄປ​ອີກ​ຟາກ​ໜຶ່ງ​ເທາະ”. <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />ດັ່ງນັ້ນ ພວກເພິ່ນ​ຈຶ່ງ​ພາ​ພຣະອົງ​ລົງ​ໄປ​ໃນ​ເຮືອ​ທີ່​ພຣະອົງ​ເຄີຍ​ຢູ່​ໂດຍ​ປະ​ປະຊາຊົນ​ໄວ້ ແລະ ມີ​ເຮືອ​ລຳ​ອື່ນໆ​ໄປ​ນຳ​ດ້ວຍ. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />ແລ້ວ​ເກີດ​ມີ​ລົມພະຍຸ​ຮຸນແຮງ ແລະ ຄື້ນນ້ຳ​ໄດ້​ຊັດ​ຖ້ວມ​ເຮືອ​ຈົນ​ເຮືອ​ເກືອບ​ຈະ​ຈົມ. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />ພຣະເຢຊູເຈົ້າ​ນອນ​ໝູນ​ໝອນ​ຫລັບ​ຢູ່​ທ້າຍເຮືອ. ພວກສາວົກ​ຈຶ່ງ​ໄປ​ປຸກ​ພຣະອົງ ແລະ ເວົ້າ​ວ່າ, “ອາຈານ​ເອີຍ, ພວກຂ້ານ້ອຍ​ກຳລັງ​ຈະ​ຈົມນໍ້າ​ແລ້ວ ພຣະອົງ​ບໍ່​ເປັນຫ່ວງ​ພວກຂ້ານ້ອຍ​ບໍ?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />ພຣະອົງ​ຈຶ່ງ​ຕື່ນ​ຂຶ້ນ​ມາ, ສັ່ງຫ້າມ​ລົມພະຍຸ ແລະ ຄື້ນທະເລ​ວ່າ, “ຈົ່ງ​ມິດ! ງຽບສະຫງົບ​ແມ!” ແລ້ວ​ລົມພະຍຸ​ກໍ​ຢຸດ​ພັດ ແລະ ຄື້ນທະເລ​ກໍ​ສະຫງົບ​ລົງ.<verse eid="MRK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40" />ພຣະອົງ​ກ່າວ​ກັບ​ພວກສາວົກ​ວ່າ, “ດ້ວຍເຫດໃດ​ພວກເຈົ້າ​ຈຶ່ງ​ຢ້ານ​ຫລາຍ​ແທ້? ພວກເຈົ້າ​ຍັງ​ບໍ່​ມີ​ຄວາມເຊື່ອ​ຢູ່​ບໍ?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />ພວກສາວົກ​ໄດ້​ພາກັນ​ຕົກໃຈ​ຢ້ານ​ຫລາຍ ແລະ ຕ່າງ​ກໍ​ຖາມ​ກັນ​ວ່າ, “ທ່ານ​ຜູ້​ນີ້​ເປັນ​ຜູ້ໃດ​ນໍ? ແມ່ນແຕ່​ລົມພະຍຸ ແລະ ຄື້ນທະເລ​ກໍ​ຍັງ​ເຊື່ອຟັງ​ເພິ່ນ!”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຮັກສາ​ຊາຍ​ຄົນ​ໜຶ່ງ​ທີ່​ຜີມານຮ້າຍ​ສິງ​ໃຫ້​ດີ</para>
  <para style="r">(ມທ 8:28-34; ລກ 8:26-39)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />ເມື່ອ​ພວກເພິ່ນ​ຂ້າມ​ຟາກ​ມາ​ຮອດ​ເມືອງ​ເຄຣາເຊນ.<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ກາດາຣາ</char></note> <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />ພໍ​ພຣະເຢຊູເຈົ້າ​ອອກ​ຈາກ​ເຮືອ​ໄປ, ມີ​ຊາຍ​ຄົນ​ໜຶ່ງ​ທີ່​ຖືກ​ວິນຍານສົກກະປົກ​ເຂົ້າ​ສິງ​ຢູ່​ໄດ້​ອອກ​ຈາກ​ອຸບມຸງ​ຝັງສົບ​ມາ​ພົບ​ພຣະອົງ. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />ຊາຍ​ຜູ້​ນີ້​ເຄີຍ​ອາໄສ​ຢູ່​ຕາມ​ອຸບມຸງ​ຝັງສົບ ແລະ ບໍ່​ມີ​ຜູ້ໃດ​ສາມາດ​ມັດ ຫລື ແມ່ນ​ແຕ່​ລ່າມ​ໂສ້​ລາວ​ໄວ້​ໄດ້. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />ເພາະ​ລາວ​ເຄີຍ​ຖືກ​ລ່າມ​ໂສ້​ໃສ່​ມື ແລະ ຕີນ​ຂອງ​ລາວ​ຫລາຍ​ເທື່ອ​ແລ້ວ, ແຕ່​ລາວ​ກໍ​ຫັກ​ໂສ້​ຂາດ. ບໍ່​ມີ​ຜູ້ໃດ​ແຂງແຮງ​ພໍ​ທີ່​ຈະ​ປາບ​ລາວ​ໄດ້. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />ລາວ​ໄດ້​ແຜດສຽງຮ້ອງ​ຢູ່​ຕາມ​ອຸບມຸງ​ຝັງສົບ ແລະ ຕາມ​ເນີນ​ພູເຂົາ​ທັງ​ກາງເວັນ ແລະ ກາງຄືນ ແລ້ວ​ກໍ​ເອົາ​ຫີນ​ປາດ​ຕົນ​ເອງ.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />ເມື່ອ​ລາວ​ເຫັນ​ພຣະເຢຊູເຈົ້າ​ແຕ່​ໄກໆ, ລາວ​ໄດ້​ແລ່ນ​ມາ​ຫາ ແລະ ຄຸເຂົ່າ​ລົງ​ຕໍ່ໜ້າ​ພຣະອົງ. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />ລາວ​ຮ້ອງ​ດ້ວຍ​ສຸດສຽງ​ຂອງ​ລາວ​ວ່າ, “ພຣະເຢຊູ ພຣະບຸດ​ຂອງ​ພຣະເຈົ້າ​ອົງ​ສູງສຸດ​ເອີຍ, ທ່ານ​ຕ້ອງການ​ສິ່ງໃດ​ຈາກ​ຂ້ານ້ອຍ? ຂໍ​ໃຫ້​ທ່ານ​ສັນຍາ​ໃນ​ນາມ​ພຣະເຈົ້າ​ວ່າ​ຈະ​ບໍ່​ທໍລະມານ​ຂ້ານ້ອຍ!” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />ເພາະ​ພຣະເຢຊູເຈົ້າ​ໄດ້​ກ່າວ​ກັບ​ມັນ​ວ່າ, “ວິນຍານສົກກະປົກ ຈົ່ງ​ອອກ​ມາ​ຈາກ​ຊາຍ​ຄົນ​ນີ້!”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ໄດ້​ຖາມ​ມັນ​ວ່າ, “ເຈົ້າ​ຊື່​ຫຍັງ?”</para>
  <para style="p" vid="MRK 5:9">ມັນ​ຕອບ​ວ່າ, “ຊື່​ກອງທັບ, ເພາະ​ພວກຂ້ານ້ອຍ​ມີ​ຢູ່​ນຳກັນ​ຫລາຍ​ໂຕ”. <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />ແລະ ມັນ​ຈຶ່ງ​ອ້ອນວອນຂໍ​ນຳ​ພຣະເຢຊູເຈົ້າ​ເພື່ອ​ບໍ່​ໃຫ້​ຂັບໄລ່​ພວກມັນ​ອອກ​ຈາກ​ເຂດແດນ​ນັ້ນ.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />ຢູ່​ໃກ້​ພູ​ນັ້ນ ມີ​ໝູ​ຝູງ​ໃຫຍ່​ກຳລັງ​ຫາ​ກິນ​ຢູ່​ຕາມ​ເນີນພູ. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />ພວກ​ຜີມານຮ້າຍ​ຈຶ່ງ​ຂໍຮ້ອງ​ພຣະເຢຊູເຈົ້າ​ວ່າ, “ຂໍ​ໃຫ້​ພວກ​ຂ້ານ້ອຍ​ເຂົ້າ​ໄປ​ສິງ​ຢູ່​ໃນ​ໝູ​ຝູງ​ນັ້ນ​ສາ”. <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />ພຣະອົງ​ກໍ​ໄດ້​ອະນຸຍາດ​ໃຫ້, ແລ້ວ​ວິນຍານສົກກະປົກ​ເຫລົ່ານັ້ນ​ກໍ​ອອກຈາກ​ຊາຍ​ຜູ້​ນັ້ນ ແລະ ເຂົ້າ​ໄປ​ສິງ​ຢູ່​ໃນ​ຝູງ​ໝູ. ໝູ​ທັງໝົດ​ປະມານ​ສອງພັນ​ໂຕ​ກໍ​ຟ້າວ​ແລ່ນ​ລົງ​ຕາລິ່ງຊັນ​ໂຕນ​ລົງ​ທະເລສາບ​ຈົມນ້ຳ​ຕາຍ​ໝົດ.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />ບັນດາ​ຄົນລ້ຽງໝູ​ຕ່າງ​ກໍ​ແລ່ນ​ໜີ ແລະ ໄປ​ເລົ່າ​ເລື່ອງ​ນີ້​ຢູ່​ໃນ​ເມືອງ ແລະ ຕາມ​ຊົນນະບົດ, ດັ່ງນັ້ນ ປະຊາຊົນ​ຈຶ່ງ​ພາກັນ​ອອກມາ​ເບິ່ງ​ເຫດການ​ທີ່​ໄດ້​ເກີດຂຶ້ນ. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />ເມື່ອ​ພວກເຂົາ​ມາ​ຫາ​ພຣະເຢຊູເຈົ້າ, ພວກເຂົາ​ກໍ​ເຫັນ​ຊາຍ​ທີ່​ຖືກ​ຜີມານຮ້າຍ​ເປັນ​ກອງທັບ​ເຄີຍ​ເຂົ້າສິງ​ຢູ່ ເຫັນ​ລາວ​ນຸ່ງຫົ່ມ​ເສື້ອຜ້າ ແລະ ມີ​ສະຕິ​ດີ, ພວກເຂົາ​ຈຶ່ງ​ຢ້ານ. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />ບັນດາ​ຜູ້​ທີ່​ໄດ້​ເຫັນ​ເຫດການ​ກໍ​ໄດ້​ເລົ່າ​ສິ່ງ​ທີ່​ໄດ້​ເກີດຂຶ້ນ​ກັບ​ຊາຍ​ທີ່​ຖືກ​ຜີມານຮ້າຍ​ສິງ ແລະ ເລົ່າ​ກ່ຽວກັບ​ຝູງ​ໝູ​ນັ້ນ​ສູ່​ປະຊາຊົນ​ຟັງ. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />ດັ່ງນັ້ນ ພວກເຂົາ​ຈຶ່ງ​ຂໍຮ້ອງ​ພຣະເຢຊູເຈົ້າ​ໃຫ້​ໄປ​ຈາກ​ເຂດແດນ​ຂອງ​ພວກເຂົາ.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />ຂະນະ​ທີ່​ພຣະເຢຊູເຈົ້າ​ກຳລັງ​ລົງ​ເຮືອ, ຊາຍ​ທີ່​ມີ​ຜີມານຮ້າຍ​ເຄີຍ​ສິງ​ນັ້ນ ກໍ​ຂໍຮ້ອງ​ໄປ​ກັບ​ພຣະອົງ. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />ພຣະເຢຊູເຈົ້າ​ບໍ່​ອະນຸຍາດ​ໃຫ້​ລາວ​ໄປ​ນຳ ແຕ່​ໄດ້​ກ່າວ​ວ່າ, “ຈົ່ງ​ກັບ​ເມືອ​ບ້ານ​ໄປ​ຫາ​ຍາດພີ່ນ້ອງ​ຂອງ​ເຈົ້າ ແລະ ບອກ​ພວກເຂົາ​ເຖິງ​ເຫດການ​ທີ່​ອົງພຣະຜູ້ເປັນເຈົ້າ​ໄດ້​ກະທຳ​ສຳລັບ​ເຈົ້າ ແລະ ພຣະອົງ​ເມດຕາ​ຕໍ່​ເຈົ້າ​ຢ່າງໃດ”. <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />ດັ່ງນັ້ນ ຊາຍ​ຜູ້​ນີ້​ຈຶ່ງ​ລາ​ພຣະເຢຊູເຈົ້າ​ໄປ ແລະ ເລີ່ມ​ປະກາດ​ໃນ​ແຂວງ​ເດກາໂປລີ<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">ຄື </char><char style="fqa" closed="false">ສິບ​ເມືອງ</char></note>​ວ່າ​ພຣະເຢຊູເຈົ້າ​ໄດ້​ກະທຳ​ເພື່ອ​ລາວ​ຫລາຍ​ຢ່າງ. ແລະ ຄົນ​ທັງປວງ​ຕ່າງ​ກໍ​ປະຫລາດໃຈ.<verse eid="MRK 5:20" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ເຮັດ​ໃຫ້​ເດັກຍິງ​ທີ່​ຕາຍ​ແລ້ວ​ເປັນຄືນມາ ແລະ ຮັກສາ​ຍິງ​ທີ່​ເຈັບປ່ວຍ</para>
  <para style="r">(ມທ 9:18-26; ລກ 8:41-56)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />ເມື່ອ​ພຣະເຢຊູເຈົ້າ​ໄດ້​ຂີ່​ເຮືອ​ຂ້າມ​ຟາກ​ທະເລສາບ​ກັບ​ມາ​ອີກ, ຂະນະ​ທີ່​ພຣະອົງ​ຢູ່​ທີ່​ແຄມ​ທະເລສາບ​ນັ້ນ ມີ​ປະຊາຊົນ​ຈໍານວນ​ຫລວງຫລາຍ​ໄດ້​ມາ​ເຕົ້າໂຮມກັນ​ອ້ອມ​ພຣະອົງ. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />ມີ​ຫົວໜ້າ​ທຳມະສາລາ​ຄົນ​ໜຶ່ງ​ຊື່​ວ່າ​ຢາອີໂຣ​ໄດ້​ມາ​ທີ່​ນັ້ນ ເມື່ອ​ລາວ​ເຫັນ​ພຣະເຢຊູເຈົ້າ​ຈຶ່ງ​ໝູບລົງ​ທີ່​ຕີນ​ຂອງ​ພຣະອົງ <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />ແລ້ວ​ຂໍຮ້ອງ​ພຣະອົງ​ດ້ວຍ​ຄວາມຮ້ອນຮົນໃຈ​ວ່າ, “ລູກສາວ​ຂອງ​ຂ້ານ້ອຍ​ເຈັບໜັກ​ກຳລັງ​ຈະ​ຕາຍ​ແລ້ວ ຂໍ​ທ່ານ​ກະລຸນາ​ໄປ​ວາງມື​ໃສ່​ນາງ​ດ້ວຍ ເພື່ອ​ນາງ​ຈະ​ຫາຍດີ ແລະ ມີຊີວິດ​ຢູ່”. <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />ດັ່ງນັ້ນ ພຣະເຢຊູເຈົ້າ​ຈຶ່ງ​ໄປ​ກັບ​ລາວ.</para>
  <para style="p" vid="MRK 5:24">ມີ​ປະຊາຊົນ​ຕິດຕາມ​ພຣະອົງ​ມາ​ຢ່າງ​ໜາແໜ້ນ ແລະ ບຽດ​ກັນ​ຢູ່​ອ້ອມ​ພຣະອົງ. <verse eid="MRK 5:24" /><verse number="25" style="v" sid="MRK 5:25" />ໃນ​ທີ່​ນັ້ນ ມີ​ຍິງ​ຄົນ​ໜຶ່ງ​ທີ່​ເປັນ​ພະຍາດ​ເລືອດຕົກ​ຊຳເຮື້ອ​ມາ​ໄດ້​ສິບສອງ​ປີ​ແລ້ວ. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />ນາງ​ໄດ້​ຮັບ​ຄວາມທຸກທໍລະມານ​ຫລາຍ ເຖິງ​ແມ່ນ​ວ່າ​ມີ​ໝໍ​ຫລາຍ​ຄົນ​ໄດ້​ປິ່ນປົວ ແລະ ເສຍ​ເງິນ​ຈົນ​ໝົດ​ໂຕ​ແລ້ວ, ແທນ​ທີ່​ນາງ​ຈະ​ດີ​ຂຶ້ນ ແຕ່​ອາການ​ກັບ​ຊຸດໂຊມ​ລົງ. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />ເມື່ອ​ນາງ​ໄດ້​ຍິນ​ເຖິງ​ເລື່ອງ​ພຣະເຢຊູເຈົ້າ ນາງ​ຈຶ່ງ​ຍ່າງ​ປົນ​ກັບ​ປະຊາຊົນ​ມາ​ທາງ​ຫລັງ​ພຣະອົງ ແລະ ບາຍ​ເສື້ອຄຸມ​ຂອງ​ພຣະອົງ, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />ເພາະ​ນາງ​ຄິດ​ວ່າ, “ຖ້າ​ເຮົາ​ໄດ້​ບາຍ​ພຽງ​ແຕ່​ເສື້ອຄຸມ​ຂອງ​ເພິ່ນ​ເທົ່ານັ້ນ​ເຮົາ​ກໍ​ຈະ​ດີ​ພະຍາດ”. <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />ໃນທັນໃດ​ນັ້ນ ເລືອດ​ທີ່​ຕົກ​ນັ້ນ​ກໍ​ຢຸດ​ທັນທີ ແລະ ນາງ​ຮູ້ສຶກ​ວ່າ​ຕົນ​ດີພະຍາດ​ແລ້ວ.<verse eid="MRK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30" />ຝ່າຍ​ພຣະເຢຊູເຈົ້າ​ຮູ້​ທັນທີ​ວ່າ​ລິດເດດ​ໄດ້​ອອກຈາກ​ພຣະອົງ. ພຣະອົງ​ຈຶ່ງ​ປິ່ນໜ້າ​ມາ​ທາງ​ປະຊາຊົນ ແລະ ຖາມ​ວ່າ, “ຜູ້ໃດ​ບາຍ​ເຄື່ອງນຸ່ງ​ຂອງ​ເຮົາ?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />ພວກສາວົກ​ຂອງ​ພຣະອົງ​ຕອບ​ວ່າ, “ທ່ານ​ກໍ​ເຫັນ​ຢູ່​ແລ້ວ​ວ່າ​ປະຊາຊົນ​ຢ່າງ​ແໜ້ນໜາ​ບຽດ​ທ່ານ, ແລ້ວ​ເປັນຫຍັງ​ທ່ານ​ຈຶ່ງ​ຖາມ​ອີກ​ວ່າ ‘ຜູ້ໃດ​ໄດ້​ບາຍ​ເຮົາ?’ ”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />ແຕ່​ພຣະເຢຊູເຈົ້າ​ຍັງ​ຫລຽວ​ໄປ​ອ້ອມໆ​ເພື່ອ​ຊອກ​ເບິ່ງ​ວ່າ​ຜູ້ໃດ​ທີ່​ເຮັດ​ຢ່າງ​ນັ້ນ. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />ຝ່າຍ​ຍິງ​ຄົນ​ນັ້ນ​ຮູ້​ດີ​ວ່າ​ສິ່ງ​ທີ່​ໄດ້​ເກີດຂຶ້ນ​ກັບ​ຕົນ, ນາງ​ຈຶ່ງ​ມາ​ໝູບລົງ​ທີ່​ຕີນ​ຂອງ​ພຣະອົງ​ດ້ວຍ​ຄວາມຢ້ານ, ແລ້ວ​ເວົ້າ​ຄວາມຈິງ​ທັງໝົດ​ໃຫ້​ພຣະອົງ​ຟັງ. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />ພຣະອົງ​ກ່າວ​ກັບ​ນາງ​ວ່າ, “ລູກ​ຍິງ​ເອີຍ, ຄວາມເຊື່ອ​ຂອງ​ເຈົ້າ​ໄດ້​ເຮັດ​ໃຫ້​ເຈົ້າ​ຫາຍດີ​ແລ້ວ. ຈົ່ງ​ກັບ​ໄປ​ດ້ວຍ​ສັນຕິສຸກ ແລະ ພົ້ນ​ຈາກ​ຄວາມທຸກທໍລະມານ​ສາ”.<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />ໃນຂະນະ​ທີ່​ພຣະເຢຊູເຈົ້າ​ຍັງ​ກ່າວ​ຢູ່ ກໍ​ມີ​ບາງຄົນ​ຈາກ​ເຮືອນ​ຂອງ​ຢາອີໂຣ​ຫົວໜ້າ​ທຳມະສາລາ ພວກເຂົາ​ບອກ​ວ່າ, “ລູກສາວ​ຂອງ​ທ່ານ​ຕາຍ​ແລ້ວ ຈະ​ລົບກວນ​ອາຈານ​ເຮັດ​ຫຍັງ?”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />ພຣະເຢຊູເຈົ້າ​ບໍ່​ຟັງ​ສິ່ງ​ທີ່​ພວກເຂົາ​ໄດ້​ເວົ້າ​ນັ້ນ ແຕ່​ກ່າວ​ແກ່​ຢາອີໂຣ​ວ່າ, “ຢ່າ​ຢ້ານ​ເລີຍ, ຈົ່ງ​ເຊື່ອ​ເທົ່ານັ້ນ”.<verse eid="MRK 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37" />ພຣະອົງ​ບໍ່​ອະນຸຍາດ​ໃຫ້​ຜູ້ໃດ​ຕິດຕາມ​ພຣະອົງ​ໄປ​ຍົກເວັ້ນ​ເປໂຕ, ຢາໂກໂບ ແລະ ໂຢຮັນ​ນ້ອງຊາຍ​ຂອງ​ຢາໂກໂບ. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />ເມື່ອ​ມາ​ຮອດ​ເຮືອນ​ຂອງ​ຫົວໜ້າ​ທຳມະສາລາ​ແລ້ວ, ພຣະເຢຊູເຈົ້າ​ກໍ​ເຫັນ​ຄວາມວຸ້ນວາຍ, ມີ​ຄົນ​ຮ້ອງໄຫ້ ແລະ ສະອື້ນ​ສຽງດັງ. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />ພຣະອົງ​ເຂົ້າ​ໄປ​ໃນ​ເຮືອນ ແລະ ກ່າວ​ກັບ​ພວກເຂົາ​ວ່າ, “ພວກເຈົ້າ​ຮ້ອງໄຫ້​ຄ່ຳຄວນ ແລະ ວຸ້ນວາຍ​ເຮັດ​ຫຍັງ? ເດັກນ້ອຍ​ຍັງ​ບໍ່​ຕາຍ​ພຽງ​ແຕ່​ນອນຫລັບ​ຢູ່”. <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />ແຕ່​ພວກເຂົາ​ພາກັນ​ຫົວຂວັນ​ພຣະອົງ.</para>
  <para style="p" vid="MRK 5:40">ຫລັງ​ຈາກ​ທີ່​ພຣະອົງ​ໃຫ້​ຄົນ​ທັງປວງ​ອອກ​ໄປ​ແລ້ວ ພຣະອົງ​ກໍ​ເອົາ​ພໍ່ແມ່​ຂອງ​ເດັກນ້ອຍ ແລະ ພວກສາວົກ​ທີ່​ຢູ່​ກັບ​ພຣະອົງ​ເຂົ້າ​ໄປ​ໃນ​ຫ້ອງ​ທີ່​ເດັກນ້ອຍ​ນັ້ນ​ນອນ​ຢູ່. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />ພຣະອົງ​ຈັບ​ມື​ເດັກນ້ອຍ ແລະ ກ່າວ​ຕໍ່​ນາງ​ວ່າ, “ຕາລີທາ ກຸມ!” (ເຊິ່ງ​ແປ​ວ່າ “ນາງ​ນ້ອຍ​ເອີຍ, ເຮົາ​ບອກ​ເຈົ້າ​ວ່າ, ຈົ່ງ​ລຸກຂຶ້ນ!”). <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />ທັນໃດນັ້ນ ນາງ​ກໍ​ລຸກຂຶ້ນ ແລະ ຍ່າງ​ໄປ​ມາ (ນາງ​ອາຍຸ​ໄດ້​ສິບສອງ​ປີ). ພວກເຂົາ​ໄດ້​ພາກັນ​ປະຫລາດໃຈ​ຫລາຍ​ໃນ​ສິ່ງ​ນີ້. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />ພຣະອົງ​ໄດ້​ສັ່ງຫ້າມ​ບໍ່​ໃຫ້​ບອກ​ເລື່ອງ​ນີ້​ແກ່​ຜູ້ໃດ​ເດັດຂາດ ແລະ ສັ່ງ​ໃຫ້​ພວກເຂົາ​ເອົາ​ອາຫານ​ມາ​ໃຫ້​ນາງ​ກິນ.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s1">ຜູ້ທຳນວາຍ​ທີ່​ບໍ່​ມີ​ຜູ້ໃດ​ນັບ​ຖື</para>
  <para style="r">(ມທ 13:54-58)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />ພຣະເຢຊູເຈົ້າ​ອອກ​ຈາກ​ທີ່​ນັ້ນ ແລະ ກັບ​ໄປ​ຍັງ​ບ້ານເກີດ​ຂອງ​ພຣະອົງ, ໂດຍ​ມີ​ພວກສາວົກ​ຂອງ​ພຣະອົງ​ຕິດຕາມ​ໄປ​ນຳ. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />ເມື່ອ​ເຖິງ​ວັນຊະບາໂຕ, ພຣະອົງ​ກໍ​ໄດ້​ເລີ່ມຕົ້ນ​ສັ່ງສອນ​ໃນ​ທຳມະສາລາ ແລະ ຫລາຍ​ຄົນ​ທີ່​ໄດ້​ຟັງ​ພຣະອົງ​ຕ່າງ​ກໍ​ປະຫລາດໃຈ.</para>
  <para style="p" vid="MRK 6:2">ພວກເຂົາ​ຖາມ​ວ່າ, “ຊາຍ​ຄົນ​ນີ້​ເອົາ​ຄຳສັ່ງສອນ​ເຫລົ່ານີ້​ມາ​ແຕ່​ໃສ? ສະຕິປັນຍາ​ທີ່​ລາວ​ໄດ້​ຮັບ​ນີ້​ແມ່ນ​ສະຕິປັນຍາ​ຢ່າງ​ໃດ, ຈຶ່ງ​ເຮັດ​ການ​ອັດສະຈັນ​ໄດ້! <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />ລາວ​ເປັນ​ຊ່າງໄມ້​ບໍ່​ແມ່ນ​ບໍ? ລາວ​ເປັນ​ລູກຊາຍ​ຂອງ​ນາງ​ມາຣີ ເປັນ​ອ້າຍ​ຂອງ​ຢາໂກໂບ, ໂຢເຊັບ,<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ໂຢເຊ</char></note> ຢູດາ ແລະ ຊີໂມນ​ບໍ່​ແມ່ນ​ບໍ? ພວກ​ນ້ອງສາວ​ຂອງ​ລາວ​ກໍ​ຢູ່​ກັບ​ພວກເຮົາ​ບໍ່​ແມ່ນ​ບໍ?” ແລ້ວ​ພວກເຂົາ​ທັງຫລາຍ​ຈຶ່ງ​ບໍ່​ພໍໃຈ​ພຣະອົງ.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ກໍ​ກ່າວ​ແກ່​ພວກເຂົາ​ວ່າ, “ຜູ້ທຳນວາຍ​ບໍ່​ໄດ້​ຂາດ​ຄວາມນັບຖື​ໃນ​ທຸກ​ບ່ອນ ເວັ້ນໄວ້​ແຕ່​ໃນ​ບ້ານເມືອງ, ບັນດາ​ຍາດພີ່ນ້ອງ ແລະ ໃນ​ຄອບຄົວ​ຂອງ​ຕົນ​ເອງ”. <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />ພຣະອົງ​ບໍ່​ສາມາດ​ເຮັດ​ການ​ອັດສະຈັນ​ໃດໆ​ຢູ່​ທີ່​ນັ້ນ, ນອກຈາກ​ພຣະອົງ​ໄດ້​ວາງມື​ໃສ່​ຄົນ​ເຈັບໄຂ້ໄດ້ປ່ວຍ​ບາງຄົນ ແລະ ຮັກສາ​ພວກເຂົາ​ໃຫ້​ຫາຍດີ. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />ແລະ ພຣະອົງ​ປະຫລາດໃຈ​ໃນ​ຄວາມ​ບໍ່ເຊື່ອ​ຂອງ​ພວກເຂົາ.</para>
  <para style="s1" vid="MRK 6:6">ພຣະເຢຊູເຈົ້າ​ໄດ້​ໃຊ້​ສາວົກ​ສິບສອງ​ຄົນ​ອອກ​ໄປ</para>
  <para style="r" vid="MRK 6:6">(ມທ 10:1,9-14; ລກ 9:1,3-5)</para>
  <para style="p" vid="MRK 6:6">ຫລັງຈາກ​ນັ້ນ ພຣະເຢຊູເຈົ້າ​ໄດ້​ສັ່ງສອນ​ຕາມ​ບ້ານ​ຕ່າງໆ​ທີ່​ຢູ່​ອ້ອມຮອບ​ເຂດ​ນັ້ນ. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />ພຣະອົງ​ໄດ້​ເອີ້ນ​ສາວົກ​ສິບສອງ​ຄົນ​ມາ ແລະ ເລີ່ມ​ໃຊ້​ພວກເພິ່ນ​ອອກໄປ​ເປັນ​ຄູ່ໆ ໂດຍ​ໃຫ້​ພວກເພິ່ນ​ມີ​ສິດອຳນາດ​ເໜືອ​ວິນຍານສົກກະປົກ​ທັງຫລາຍ.<verse eid="MRK 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 6:8" />ນີ້​ແມ່ນ​ຄຳແນະນໍາ​ຂອງ​ພຣະອົງ​ຄື: “ບໍ່​ຕ້ອງ​ເອົາ​ສິ່ງໃດ​ຕິດໂຕ​ໄປ​ໃນ​ການເດີນທາງ​ນອກຈາກ​ໄມ້ຄ້ອນເທົ້າ​ເທົ່ານັ້ນ, ບໍ່​ຕ້ອງ​ເອົາ​ອາຫານ, ຖົງ ຫລື ເງິນ​ໃສ່​ໃນ​ສາຍແອວ​ໄປ​ນຳ. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />ຈົ່ງ​ໃສ່​ເກີບ ແຕ່​ບໍ່​ຕ້ອງ​ຕຽມ​ເສື້ອ​ອີກ​ໂຕ​ໜຶ່ງ​ໄປ​ນຳ. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />ເມື່ອ​ພວກເຈົ້າ​ເຂົ້າ​ໄປ​ໃນ​ເຮືອນ​ໃດ, ຈົ່ງ​ພັກ​ຢູ່​ທີ່​ເຮືອນ​ນັ້ນ​ຈົນກວ່າ​ພວກເຈົ້າ​ຈະ​ໄປ​ຈາກ​ເມືອງ​ນັ້ນ. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />ຖ້າ​ບ່ອນ​ໃດ​ບໍ່​ຕ້ອນຮັບ ຫລື ບໍ່​ຮັບ​ຟັງ​ພວກເຈົ້າ, ຈົ່ງ​ໄປ​ຈາກ​ບ່ອນ​ນັ້ນ ແລະ ສັ່ນ​ຂີ້ຝຸ່ນ​ອອກ​ຈາກ​ຕີນ​ຂອງ​ພວກເຈົ້າ​ເພື່ອ​ເປັນ​ພະຍານ​ຕໍ່ສູ້​ພວກເຂົາ”.<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />ພວກສາວົກ​ຈຶ່ງ​ອອກ​ໄປ ແລະ ເທດສະໜາ​ໃຫ້​ປະຊາຊົນ​ຖິ້ມໃຈເກົ່າເອົາໃຈໃໝ່. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />ພວກເພິ່ນ​ໄດ້​ຂັບໄລ່​ຜີມານຮ້າຍ​ອອກ​ຫລາຍ​ໂຕ ແລະ ໄດ້​ເຈີມ​ຄົນເຈັບປ່ວຍ​ຫລາຍ​ຄົນ​ດ້ວຍ​ນ້ຳມັນ ແລະ ຮັກສາ​ພວກເຂົາ​ໃຫ້​ຫາຍດີ.<verse eid="MRK 6:13" /></para>
  <para style="s1">ໂຢຮັນ​ບັບຕິສະໂຕ​ຖືກ​ຂ້າ</para>
  <para style="r">(ມທ 14:1-12; ລກ 9:7-9)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />ກະສັດ​ເຮໂຣດ ໄດ້​ຍິນ​ເຖິງ​ເລື່ອງ​ຂອງ​ພຣະເຢຊູເຈົ້າ ເພາະ​ຊື່​ສຽງ​ຂອງ​ພຣະອົງ​ໄດ້​ຊ່າລື​ໄປ​ທົ່ວ. ບາງຄົນ​ໄດ້​ເວົ້າ​ວ່າ,<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ໃນ​ຍຸກ​ທຳອິດ​ບາງ​ສະບັບ​ວ່າ </char><char style="fqa" closed="false">ພວກເຂົາ​ເວົ້າ​ວ່າ</char></note> ພຣະເຢຊູເຈົ້າ​ແມ່ນ​ໂຢຮັນ​ບັບຕິສະໂຕ​ຜູ້​ທີ່​ເປັນຄືນມາຈາກຕາຍ, ດັ່ງນັ້ນ ເພິ່ນ​ຈຶ່ງ​ມີ​ລິດອຳນາດ​ເຮັດ​ການ​ອັດສະຈັນ​ຕ່າງໆ​ໄດ້.<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />ສ່ວນ​ຄົນ​ອື່ນ​ກໍ​ເວົ້າ​ວ່າ, “ເພິ່ນ​ແມ່ນ​ເອລີຢາ”. ແລະ ຍັງ​ມີ​ຄົນ​ອື່ນໆ​ອີກ​ອ້າງ​ວ່າ, “ເພິ່ນ​ເປັນ​ຜູ້ທຳນວາຍ, ເໝືອນ​ກັນ​ກັບ​ຜູ້​ໜຶ່ງ​ໃນ​ບັນດາ​ຜູ້ທຳນວາຍ​ໃນ​ເມື່ອກ່ອນ”.<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />ແຕ່​ເມື່ອ​ເຮໂຣດ​ໄດ້​ຍິນ​ຢ່າງ​ນັ້ນ ເພິ່ນ​ຈຶ່ງ​ເວົ້າ​ວ່າ, “ລາວ​ແມ່ນ​ໂຢຮັນ ຜູ້​ທີ່​ເຮົາ​ໄດ້​ສັ່ງ​ໃຫ້​ຕັດ​ຫົວ, ລາວ​ເປັນຄືນມາຈາກຕາຍ​ແລ້ວ!”<verse eid="MRK 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17" />ເພາະ​ເຮໂຣດ​ເອງ​ເປັນ​ຜູ້​ສັ່ງ​ໃຫ້​ຈັບ​ໂຢຮັນ​ມາ​ລ່າມໂສ້ ແລະ ຂັງ​ລາວ​ໄວ້​ໃນ​ຄຸກ. ກະສັດ​ເຮໂຣດ​ເຮັດ​ເຊັ່ນນີ້ ເພາະ​ນາງ​ເຮໂຣເດຍ​ຜູ້​ທີ່​ເຄີຍ​ເປັນ​ເມຍ​ຂອງ​ຟີລິບ​ນ້ອງຊາຍ​ຂອງ​ຕົນ​ເມື່ອກ່ອນ ເຊິ່ງ​ເຮໂຣດ​ໄດ້​ແຕ່ງງານ​ນຳ​ນາງ. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />ເນື່ອງ​ຈາກ​ໂຢຮັນ​ເຄີຍ​ເວົ້າ​ກັບ​ເຮໂຣດ​ວ່າ, “ທ່ານ​ໄດ້​ເຮັດ​ຜິດ​ຕໍ່​ກົດບັນຍັດ​ໃນ​ການ​ທີ່​ເອົາ​ນ້ອງໃພ້​ຂອງ​ທ່ານ​ມາ​ເປັນ​ເມຍ”. <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />ດັ່ງນັ້ນ, ນາງ​ເຮໂຣເດຍ​ຈຶ່ງ​ຄຽດແຄ້ນ​ໃຫ້​ໂຢຮັນ ແລະ ຕ້ອງການ​ຂ້າ​ເພິ່ນ​ແຕ່​ກໍ​ເຮັດ​ບໍ່​ໄດ້, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />ເພາະວ່າ​ເຮໂຣດ​ຢ້ານ​ໂຢຮັນ ແລະ ປົກປ້ອງ​ເພິ່ນ​ໄວ້​ເພາະ​ຮູ້​ວ່າ​ເພິ່ນ​ເປັນ​ຜູ້ຊອບທຳ ແລະ ບໍລິສຸດ. ເມື່ອ​ເຮໂຣດ​ໄດ້​ຟັງ​ໂຢຮັນ​ເວົ້າ​ກໍ​ມຶນງົງ​ສົງໄສ<note caller="+" style="f"><char style="fr" closed="false">6:20 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ໃນ​ຍຸກທຳອິດ​ບາງ​ສະບັບ​ວ່າ </char><char style="fqa" closed="false">ກໍ​ໄດ້​ເຮັດ​ຫລາຍ​ສິ່ງ​ຫລາຍ​ຢ່າງ</char></note> ແຕ່​ເພິ່ນ​ກໍ​ຍັງ​ຢາກ​ຟັງ​ໂຢຮັນ.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />ໃນ​ທີ່ສຸດ​ໂອກາດ​ກໍ​ມາ​ເຖິງ. ໃນ​ງານສະຫລອງ​ວັນເກີດ​ຂອງ​ເຮໂຣດ ເມື່ອ​ເພິ່ນ​ໄດ້​ຈັດ​ງານລ້ຽງສະຫລອງ ແລະ ເຊື້ອເຊີນ​ບັນດາ​ຂ້າລາຊະການ​ຊັ້ນສູງ​ມາ​ຮ່ວມ​ຄື: ຄະນະ​ລັດຖະບານ, ບັນດາ​ນາຍທະຫານ​ໃນ​ກອງທັບ ແລະ ບັນດາ​ບຸກຄົນ​ສຳຄັນ​ຕ່າງໆ​ໃນ​ແຂວງ​ຄາລີເລ. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />ເມື່ອ​ລູກສາວ​ຂອງ​ນາງ​ເຮໂຣເດຍ​ໄດ້​ເຂົ້າ​ມາ​ຟ້ອນ​ໃນ​ຫ້ອງ​ຈັດງານ ນາງ​ເຮັດ​ໃຫ້​ເຮໂຣດ​ພໍໃຈ​ຫລາຍ ແລະ ບັນດາ​ແຂກ​ທີ່​ໄດ້​ເຊີນ​ມາ.</para>
  <para style="p" vid="MRK 6:22">ກະສັດ​ຈຶ່ງ​ກ່າວ​ກັບ​ຍິງສາວ​ນັ້ນ​ວ່າ, “ເຈົ້າ​ຢາກ​ໄດ້​ສິ່ງ​ໃດ​ຈົ່ງ​ຂໍ​ມາ ແລ້ວ​ເຮົາ​ຈະ​ໃຫ້​ຕາມ​ທີ່​ເຈົ້າ​ຂໍ”. <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />ແລະ ເພິ່ນ​ກໍ​ສັນຍາ​ໂດຍ​ປະຕິຍານ​ວ່າ, “ສິ່ງ​ໃດ​ກໍ​ຕາມ​ທີ່​ເຈົ້າ​ຂໍ​ເຮົາ​ຈະ​ໃຫ້​ແກ່​ເຈົ້າ ແມ່ນແຕ່​ເຄິ່ງ​ໜຶ່ງ​ຂອງ​ອານາຈັກ​ຂອງ​ເຮົາ”.<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />ດັ່ງນັ້ນ ນາງ​ຈຶ່ງ​ອອກ​ໄປ​ຖາມ​ແມ່​ຂອງ​ຕົນ​ວ່າ, “ລູກ​ຈະ​ຂໍ​ສິ່ງ​ໃດ​ດີ?”</para>
  <para style="p" vid="MRK 6:24">ແມ່​ຈຶ່ງ​ຕອບ​ວ່າ, “ຂໍ​ຫົວ​ຂອງ​ໂຢຮັນ​ບັບຕິສະໂຕ”.<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />ນາງ​ຈຶ່ງ​ຟ້າວ​ມາ​ຕອບ​ກະສັດ​ທັນທີ​ວ່າ, “ຂ້ານ້ອຍ​ຕ້ອງການ​ໃຫ້​ທ່ານ​ເອົາ​ຫົວ​ຂອງ​ໂຢຮັນ​ບັບຕິສະໂຕ​ໃສ່​ຖາດ​ມາ​ໃຫ້​ຂ້ານ້ອຍ​ຢູ່​ບ່ອນນີ້​ດຽວນີ້”.<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />ຝ່າຍ​ກະສັດ​ກໍ​ໜັກໃຈ​ຫລາຍ, ແຕ່​ເພາະ​ໄດ້​ສັນຍາ​ໄວ້​ແລ້ວ ແລະ ເພາະ​ເຫັນ​ແກ່​ໜ້າ​ແຂກ​ທັງຫລາຍ​ຂອງ​ຕົນ ເພິ່ນ​ບໍ່​ຢາກ​ປະຕິເສດ​ນາງ. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />ດັ່ງນັ້ນ ເພິ່ນ​ຈຶ່ງ​ສັ່ງ​ໃນ​ທັນທີ​ໃຫ້​ທະຫານ​ນັກຂ້າ​ນຳ​ຫົວ​ຂອງ​ໂຢຮັນ​ມາ. ທະຫານ​ກໍ​ໄປ​ຕັດ​ຫົວ​ຂອງ​ໂຢຮັນ​ໃນ​ຄຸກ, <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />ແລ້ວ​ນຳ​ຫົວ​ຂອງ​ໂຢຮັນ​ໃສ່​ຖາດ​ມາ​ມອບ​ໃຫ້​ຍິງ​ນັ້ນ, ແລະ ນາງ​ກໍ​ເອົາ​ໄປ​ໃຫ້​ແມ່​ຂອງ​ຕົນ. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />ເມື່ອ​ພວກ​ລູກສິດ​ຂອງ​ໂຢຮັນ​ຮູ້​ຂ່າວ​ນີ້ ພວກເຂົາ​ກໍ​ມາ​ເອົາ​ສົບ​ຂອງ​ເພິ່ນ ແລ້ວ​ນຳ​ໄປ​ວາງ​ໄວ້​ໃນ​ອຸບມຸງ.<verse eid="MRK 6:29" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ລ້ຽງ​ຄົນ​ຫ້າພັນ​ຄົນ</para>
  <para style="r">(ມທ 14:13-21; ລກ 9:10-17; ຢຮ 6:5-13)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />ຝ່າຍ​ພວກ​ອັກຄະສາວົກ​ໄດ້​ກັບ​ມາ​ຫາ​ພຣະເຢຊູເຈົ້າ ແລະ ລາຍງານ​ຕໍ່​ພຣະອົງ​ເຖິງ​ທຸກ​ສິ່ງ​ທີ່​ພວກເພິ່ນ​ໄດ້​ເຮັດ ແລະ ໄດ້​ສັ່ງສອນ. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />ເນື່ອງ​ຈາກ​ມີ​ປະຊາຊົນ​ຈໍານວນ​ຫລວງຫລາຍ​ທຽວ​ໄປ​ມາ​ຈົນ​ພວກເພິ່ນ​ບໍ່​ມີ​ເວລາ​ກິນເຂົ້າ, ພຣະອົງ​ຈຶ່ງ​ກ່າວ​ກັບ​ພວກສາວົກ​ວ່າ, “ພວກເຈົ້າ​ທັງຫລາຍ​ຈົ່ງ​ຕາມ​ເຮົາ​ມາ ອອກໄປ​ຫາ​ບ່ອນ​ທີ່​ມິດງຽບ ແລະ ພັກຜ່ອນ​ຈັກ​ຄາວ​ໜຶ່ງ”.<verse eid="MRK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32" />ດັ່ງນັ້ນ, ພຣະອົງ​ກັບ​ພວກສາວົກ​ຈຶ່ງ​ລົງ​ເຮືອ​ໄປ​ຍັງ​ບ່ອນ​ທີ່​ມິດງຽບ. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />ແຕ່​ຫລາຍຄົນ​ໄດ້​ເຫັນ​ພວກເພິ່ນ​ອອກໄປ​ກໍ​ຈື່​ໄດ້​ທັນທີ ແລະ ພາກັນ​ແລ່ນ​ຈາກ​ເມືອງ​ຕ່າງໆ​ໄປ​ເຖິງ​ທີ່​ນັ້ນ​ລ່ວງໜ້າ​ກ່ອນ​ພວກເພິ່ນ. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />ເມື່ອ​ພຣະເຢຊູເຈົ້າ​ອອກ​ຈາກ​ເຮືອ​ມາ​ກໍ​ເຫັນ​ປະຊາຊົນ​ຈໍານວນ​ຫລວງຫລາຍ ພຣະອົງ​ກໍ​ມີ​ໃຈ​ສົງສານ​ພວກເຂົາ, ເພາະ​ພວກເຂົາ​ເປັນ​ເໝືອນ​ແກະ​ທີ່​ບໍ່​ມີ​ຜູ້ລ້ຽງ. ດັ່ງນັ້ນ ພຣະອົງ​ຈຶ່ງ​ເລີ່ມຕົ້ນ​ສັ່ງສອນ​ພວກເຂົາ​ຫລາຍ​ເລື່ອງ.<verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />ເມື່ອ​ຄ້າຍຄ່ຳ​ແລ້ວ ພວກສາວົກ​ຈຶ່ງ​ມາ​ບອກ​ພຣະອົງ​ວ່າ, “ບ່ອນນີ້​ຫ່າງໄກ​ຫລາຍ ແລະ ກໍ​ຄ່ຳ​ແລ້ວ. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />ຂໍ​ໃຫ້​ປະຊາຊົນ​ເຫລົ່ານີ້​ເມືອ​ສາ ເພື່ອ​ພວກເຂົາ​ຈະ​ໄດ້​ໄປ​ຊອກຫາ​ຊື້​ອາຫານ​ສຳລັບ​ພວກເຂົາ​ເອງ​ຕາມ​ໝູ່ບ້ານ​ຕ່າງໆ​ໃນ​ແຖບ​ນີ້”.<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />ແຕ່​ພຣະອົງ​ຕອບ​ວ່າ, “ພວກເຈົ້າ​ຈົ່ງ​ເອົາ​ອາຫານ​ໃຫ້​ພວກເຂົາ​ກິນ​ສາ”.</para>
  <para style="p" vid="MRK 6:37">ພວກສາວົກ​ຕອບ​ວ່າ, “ຈະ​ຕ້ອງ​ໃຊ້​ເງິນ​ເທົ່າ​ກັບ​ຄ່າຈ້າງ​ຂອງ​ຄົນງານ​ຄົນ​ໜຶ່ງ​ຫລາຍກວ່າ​ເຄິ່ງ​ປີ!<note caller="+" style="f"><char style="fr" closed="false">6:37 </char><char style="ft" closed="false">ພາສາ​ກຣີກ​ວ່າ </char><char style="fqa" closed="false">200 ເດນາຣິອົນ</char></note> ພວກເຮົາ​ຕ້ອງ​ໃຊ້​ເງິນ​ຫລາຍ​ຂະໜາດ​ນັ້ນ​ເພື່ອ​ໄປ​ຊື້​ອາຫານ​ມາ​ໃຫ້​ພວກເຂົາ​ກິນ​ບໍ?”<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />ພຣະອົງ​ຈຶ່ງ​ຖາມ​ວ່າ, “ພວກເຈົ້າ​ມີ​ເຂົ້າຈີ່​ຈັກ​ກ້ອນ? ຈົ່ງ​ໄປ​ເບິ່ງ​ແມ”.</para>
  <para style="p" vid="MRK 6:38">ເມື່ອ​ພວກເພິ່ນ​ໄປ​ຊອກ​ເບິ່ງ​ແລ້ວ ກໍ​ມາ​ບອກ​ພຣະເຢຊູເຈົ້າ​ວ່າ, “ມີ​ເຂົ້າຈີ່​ຫ້າ​ກ້ອນ ແລະ ປາ​ສອງ​ໂຕ”.<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ໄດ້​ສັ່ງ​ພວກສາວົກ​ໃຫ້​ໄປ​ບອກ​ປະຊາຊົນ​ໃຫ້​ນັ່ງ​ລົງ​ເປັນ​ກຸ່ມ​ຕາມ​ຫຍ້າ​ຂຽວສົດ. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />ແລ້ວ​ພວກເຂົາ​ກໍ​ນັ່ງ​ເປັນ​ກຸ່ມ ກຸ່ມ​ລະ​ຮ້ອຍ​ຄົນ ແລະ ຫ້າສິບ​ຄົນ. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ກໍ​ຈັບ​ເອົາ​ເຂົ້າຈີ່​ຫ້າ​ກ້ອນ ແລະ ປາ​ສອງ​ໂຕ​ນັ້ນ​ມາ ແລ້ວ​ເງີຍໜ້າ​ຂຶ້ນ​ເບິ່ງ​ສະຫວັນ, ພຣະອົງ​ໂມທະນາ​ຂອບພຣະຄຸນ​ພຣະເຈົ້າ ແລະ ຫັກ​ເຂົ້າຈີ່​ແລ້ວ​ພຣະອົງ​ກໍ​ຍື່ນ​ໃຫ້​ພວກສາວົກ​ຂອງ​ພຣະອົງ​ເພື່ອ​ແຈກຢາຍ​ໃຫ້​ປະຊາຊົນ. ພຣະອົງ​ຍັງ​ແບ່ງ​ປາ​ສອງ​ໂຕ​ໃຫ້​ພວກເຂົາ​ທົ່ວ​ເຖິງ​ກັນ​ອີກ​ດ້ວຍ. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />ພວກເຂົາ​ທຸກຄົນ​ໄດ້​ກິນ​ອີ່ມ​ແລ້ວ. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />ແລະ ພວກສາວົກ​ກໍ​ເກັບ​ເຂົ້າຈີ່​ຕ່ອນ​ທີ່​ຫັກ ແລະ ປາ​ທີ່​ເຫລືອ​ນັ້ນ​ໄດ້​ເຕັມ​ສິບສອງ​ກະບຸງ. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />ໃນ​ຈຳນວນ​ຜູ້ຊາຍ​ທີ່​ໄດ້​ກິນ​ອາຫານ​ນັ້ນ​ມີ​ຫ້າພັນ​ຄົນ.<verse eid="MRK 6:44" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຍ່າງ​ເທິງ​ໜ້ານ້ຳ</para>
  <para style="r">(ມທ 14:22-36; ຢຮ 6:15-21)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />ໃນທັນໃດ​ນັ້ນ ພຣະເຢຊູເຈົ້າ​ໄດ້​ຈັດ​ໃຫ້​ພວກສາວົກ​ຂອງ​ພຣະອົງ​ເຂົ້າ​ໄປ​ໃນ​ເຮືອ ແລະ ຂ້າມ​ຟາກ​ໄປ​ຍັງ​ເມືອງ​ເບັດຊາອີດາ​ລ່ວງໜ້າກ່ອນ​ພຣະອົງ, ໃນຂະນະ​ທີ່​ພຣະອົງ​ບອກ​ປະຊາຊົນ​ໃຫ້​ເລີກ​ເມືອ. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />ຫລັງ​ຈາກ​ແຍກ​ຈາກ​ພວກເຂົາ​ແລ້ວ, ພຣະອົງ​ກໍ​ຂຶ້ນ​ໄປ​ເທິງ​ພູ​ເພື່ອ​ອະທິຖານ.<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />ເມື່ອ​ຄ່ຳ​ມາ​ແລ້ວ ເຮືອ​ທີ່​ພວກສາວົກ​ຂີ່​ໄປ​ນັ້ນ​ກໍ​ຢູ່​ກາງ​ທະເລສາບ ແລະ ພຣະອົງ​ຢູ່​ທີ່​ແຄມ​ຝັ່ງ​ແຕ່​ຜູ້​ດຽວ, <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />ພຣະອົງ​ເຫັນ​ວ່າ​ພວກສາວົກ​ພາຍເຮືອ​ຕ້ານ​ທວນລົມ​ທີ່​ປະທະ​ຢູ່. ໃນ​ຊ່ວງ​ໃກ້​ແຈ້ງ<note caller="+" style="f"><char style="fr" closed="false">6:48 </char><char style="ft" closed="false">ພາສາ​ກຣີກ​ວ່າ </char><char style="fqa" closed="false">ຊ່ວງ​ຍາມ​ທີ​ສີ່ </char><char style="ft" closed="false">(ປະມານ​ສາມ​ໂມງ​ເຊົ້າ​ເຖິງ​ຫົກ​ໂມງ​ເຊົ້າ)</char></note>​ພຣະເຢຊູເຈົ້າ​ຍ່າງ​ເທິງ​ໜ້ານ້ຳ​ທະເລສາບ​ມາ​ຫາ​ພວກເພິ່ນ. ພຣະອົງ​ກຳລັງ​ຈະ​ກາຍ​ພວກເພິ່ນ​ໄປ, <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />ແຕ່​ເມື່ອ​ພວກສາວົກ​ເຫັນ​ພຣະອົງ​ກຳລັງ​ຍ່າງ​ຢູ່​ເທິງ​ທະເລສາບ, ພວກເພິ່ນ​ກໍ​ຄິດ​ວ່າ​ພຣະອົງ​ແມ່ນ​ຜີ. ພວກເພິ່ນ​ຈຶ່ງ​ຮ້ອງ​ຂຶ້ນ <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />ເພາະ​ທຸກຄົນ​ທີ່​ໄດ້​ເຫັນ​ພຣະອົງ​ຕ່າງ​ກໍ​ຕົກໃຈ​ຢ້ານ​ຫລາຍ.</para>
  <para style="p" vid="MRK 6:50">ໃນທັນໃດ​ນັ້ນ ພຣະອົງ​ໄດ້​ກ່າວ​ກັບ​ພວກເພິ່ນ​ວ່າ, “ຈົ່ງ​ກ້າຫານ! ແມ່ນ​ເຮົາ​ເອງ. ຢ່າ​ຢ້ານ​ເລີຍ”. <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />ແລ້ວ​ພຣະອົງ​ກໍ​ຂຶ້ນ​ໄປ​ໃນ​ເຮືອ​ຫາ​ພວກເພິ່ນ ແລະ ລົມ​ກໍ​ສະຫງົບ​ລົງ. ພວກເພິ່ນ​ຕ່າງ​ກໍ​ພາກັນ​ປະຫລາດໃຈ​ຫລາຍ, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />ເພາະ​ພວກເພິ່ນ​ຍັງ​ບໍ່​ເຂົ້າໃຈ​ກ່ຽວກັບ​ເລື່ອງ​ເຂົ້າຈີ່; ຈິດໃຈ​ຂອງ​ພວກເພິ່ນ​ຍັງ​ແຂງກະດ້າງ​ຢູ່.<verse eid="MRK 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />ເມື່ອ​ພວກເພິ່ນ​ໄດ້​ຂ້າມ​ຟາກ​ແລ້ວ ພວກເພິ່ນ​ກໍ​ມາ​ຂຶ້ນ​ຝັ່ງ​ທີ່​ເຄັນເນຊາເຣັດ ແລະ ຈອດ​ເຮືອ​ໄວ້​ຢູ່​ທີ່​ນັ້ນ. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />ທັນທີ​ທີ່​ພວກເພິ່ນ​ຂຶ້ນ​ຈາກ​ເຮືອ, ປະຊາຊົນ​ກໍ​ຈື່​ພຣະເຢຊູເຈົ້າ​ໄດ້. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />ບັນດາ​ຄົນ​ເຫລົ່ານັ້ນ​ຈຶ່ງ​ແລ່ນ​ໄປ​ທົ່ວ​ຂົງເຂດ​ນັ້ນ ແລະ ນຳ​ເອົາ​ບັນດາ​ຄົນເຈັບປ່ວຍ​ວາງ​ໃສ່​ເທິງ​ບ່ອນນອນ​ຫາມ​ໄປ​ທຸກ​ບ່ອນ​ທີ່​ໄດ້​ຍິນ​ວ່າ​ພຣະອົງ​ໄປ. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />ບໍ່​ວ່າ​ພຣະອົງ​ເຂົ້າ​ໄປ​ຢູ່​ທີ່​ໃດ ທັງ​ໃນ​ໝູ່ບ້ານ, ໃນ​ເມືອງ ຫລື ໃນ​ຊົນນະບົດ ພວກເຂົາ​ກໍ​ຫາມ​ຄົນເຈັບ​ມາ​ໄວ້​ທີ່​ບ່ອນຊຸມຊົນ. ພວກເຂົາ​ໄດ້​ຂໍຮ້ອງ​ພຣະອົງ​ໃຫ້​ຄົນເຈັບປ່ວຍ​ນັ້ນ​ໄດ້​ບາຍ​ແຕ່​ພຽງ​ຂອບ​ເສື້ອຄຸມ​ຂອງ​ພຣະອົງ​ກໍ​ພໍ ແລະ ທຸກຄົນ​ທີ່​ໄດ້​ບາຍ​ກໍ​ຫາຍດີ.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s1">ສິ່ງ​ທີ່​ເປັນມົນທິນ</para>
  <para style="r">(ມທ 15:1-20)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />ຝ່າຍ​ພວກ​ຟາຣີຊາຍ ແລະ ພວກ​ຄູສອນກົດບັນຍັດ​ບາງຄົນ​ທີ່​ໄດ້​ມາ​ແຕ່​ນະຄອນ​ເຢຣູຊາເລັມ ແລະ ເຕົ້າໂຮມກັນ​ຫຸ້ມອ້ອມ​ພຣະເຢຊູເຈົ້າ <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />ແລະ ເຫັນ​ພວກສາວົກ​ບາງຄົນ​ຂອງ​ພຣະອົງ​ຮັບປະທານ​ອາຫານ​ໂດຍ​ບໍ່​ໄດ້​ລ້າງມື​ກອ່ນ ເຊິ່ງ​ຖື​ວ່າ​ເປັນມົນທິນ. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />(ພວກ​ຟາຣີຊາຍ ແລະ ຄົນ​ຢິວ​ທົ່ວໄປ​ນັ້ນ ຖື​ຕາມ​ປະເພນີ​ທີ່​ສືບທອດ​ມາ​ຈາກ​ບັນດາ​ເຖົ້າແກ່​ວ່າ​ຈະ​ບໍ່​ຮັບປະທານ​ອາຫານ​ຈົນກວ່າ​ຈະ​ໄດ້​ລ້າງມື​ຕາມ​ພິທີ​ກ່ອນ. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />ເມື່ອ​ພວກເຂົາ​ກັບ​ມາ​ຈາກ​ຕະຫລາດ​ຖ້າ​ບໍ່​ໄດ້​ຊຳລະ​ໂຕ​ກ່ອນ ພວກເຂົາ​ກໍ​ຈະ​ບໍ່​ຍອມ​ກິນ ແລະ ຍັງ​ມີ​ທຳນຽມ​ອື່ນໆ​ອີກ​ຫລາຍ​ຢ່າງ​ເຊັ່ນ​ວ່າ: ການ​ລ້າງ​ຈອກ, ໝໍ້ ແລະ ພາຊະນະ​ຕ່າງໆ.<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ໃນ​ຍຸກທຳອິດ​ບາງສະບັບ​ວ່າ </char><char style="fqa" closed="false">ພາຊະນະ​ຕ່າງໆ ແລະ ເບາະເອນກາຍ​ກິນອາຫານ</char></note>)<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />ດັ່ງນັ້ນ ພວກ​ຟາຣີຊາຍ ແລະ ພວກ​ຄູສອນກົດບັນຍັດ​ຈຶ່ງ​ຖາມ​ພຣະເຢຊູເຈົ້າ​ວ່າ, “ເປັນຫຍັງ​ພວກສາວົກ​ຂອງ​ທ່ານ​ຈຶ່ງ​ບໍ່​ປະຕິບັດ​ຕາມ​ຄຳສັ່ງສອນ​ຂອງ​ພວກ​ເຖົ້າແກ່ ແຕ່​ຮັບປະທານ​ອາຫານ​ດ້ວຍ​ມື​ທີ່​ເປັນມົນທິນ?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />ພຣະອົງ​ຕອບ​ພວກເຂົາ​ວ່າ, “ເອຊາຢາ​ໄດ້​ທຳນວາຍ​ກ່ຽວກັບ​ພວກເຈົ້າ​ກໍ​ຖືກຕ້ອງ​ແລ້ວ​ວ່າ​ພວກເຈົ້າ​ເປັນ​ຄົນໜ້າຊື່ໃຈຄົດ, ຕາມ​ທີ່​ຂຽນ​ໄວ້​ໃນ​ພຣະຄຳພີ​ວ່າ:</para>
  <para style="q1" vid="MRK 7:6">“ ‘ປະຊາຊົນ​ເຫລົ່ານີ້​ໃຫ້​ກຽດ​ເຮົາ​ແຕ່​ປາກ,</para>
  <para style="q2" vid="MRK 7:6">ສ່ວນ​ໃຈ​ຂອງ​ພວກເຂົາ​ຫ່າງໄກ​ຈາກ​ເຮົາ.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />ພວກເຂົາ​ນະມັດສະການ​ເຮົາ​ໂດຍ​ບໍ່​ມີ​ປະໂຫຍດ</para>
  <para style="q2" vid="MRK 7:7">ຄຳສອນ​ຂອງ​ພວກເຂົາ​ເປັນ​ພຽງ​ກົດເກນ​ທີ່​ມະນຸດ​ສອນ​ຕໍ່​ກັນ​ມາ’.<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 29:13">ອຊຢ 29:13</ref></char></char></note><verse eid="MRK 7:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8" />ພວກເຈົ້າ​ໄດ້​ປະຖິ້ມ​ຂໍ້​ຄຳສັ່ງ​ຂອງ​ພຣະເຈົ້າ ແລະ ໄປ​ຢຶດຖື​ຄຳສັ່ງສອນ​ຂອງ​ມະນຸດ”.<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />ແລະ ພຣະອົງ​ກໍ​ກ່າວ​ຕໍ່ໄປ​ວ່າ, “ພວກເຈົ້າ​ມີ​ວິທີ​ຫລີກລ້ຽງ​ຄຳສັ່ງ​ຂອງ​ພຣະເຈົ້າ​ເພື່ອ​ໄປ​ເຮັດ​ຕາມ<note caller="+" style="f"><char style="fr" closed="false">7:9 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ບາງ​ສະບັບ​ວ່າ </char><char style="fqa" closed="false">ຕັ້ງ</char></note>​ທຳນຽມ​ຂອງ​ຕົນ! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />ເພາະ​ໂມເຊ​ໄດ້​ກ່າວ​ວ່າ, ‘ຈົ່ງ​ນັບຖື​ພໍ່ ແລະ ແມ່​ຂອງ​ຕົນ’<note caller="+" style="f"><char style="fr" closed="false">7:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12">ອພຍ 20:12</ref>; <ref loc="DEU 5:16">ພບຍ 5:16</ref></char></char></note> ແລະ ‘ຜູ້ໃດ​ທີ່​ສາບແຊ່ງ​ພໍ່ ແລະ ແມ່​ຂອງ​ຕົນ​ຈະ​ຕ້ອງ​ຖືກ​ໂທດ​ເຖິງ​ຕາຍ’<note caller="+" style="f"><char style="fr" closed="false">7:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 21:17">ອພຍ 21:17</ref>; <ref loc="LEV 20:9">ລລວ 20:9</ref></char></char></note> <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />ແຕ່​ຝ່າຍ​ພວກເຈົ້າ​ກັບ​ເວົ້າ​ວ່າ​ຖ້າ​ຄົນ​ໃດ​ປະກາດ​ວ່າ, ‘ສິ່ງ​ໃດ​ທີ່​ເຄີຍ​ໃຊ້​ເພື່ອ​ຊ່ວຍເຫລືອ​ພໍ່ແມ່​ຂອງ​ຕົນ ສິ່ງ​ນັ້ນ​ກໍ​ເປັນ​ໂກຣະບານ’ (ກໍ​ເປັນ​ສິ່ງ​ທີ່​ອຸທິດ​ຖວາຍ​ແກ່​ພຣະເຈົ້າ​ແລ້ວ), <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />ແລ້ວ​ພວກເຈົ້າ​ຈຶ່ງ​ບໍ່​ອະນຸຍາດ​ໃຫ້​ຜູ້​ນັ້ນ​ເຮັດ​ສິ່ງໃດ​ໃຫ້​ພໍ່​ແມ່​ຂອງ​ຕົນ​ອີກ​ຕໍ່ໄປ. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />ດ້ວຍເຫດນີ້ ພວກເຈົ້າ​ໄດ້​ລຶບລ້າງ​ພຣະຄຳ​ຂອງ​ພຣະເຈົ້າ​ໂດຍ​ການ​ຢຶດ​ເອົາ​ທຳນຽມ​ທີ່​ສືບທອດ​ກັນ​ມາ ແລະ ຍັງ​ມີ​ອີກ​ຫລາຍ​ຢ່າງ​ທີ່​ພວກເຈົ້າ​ເຮັດ​ຜິດ​ແບບ​ນີ້”.<verse eid="MRK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ກໍ​ໄດ້​ເອີ້ນ​ປະຊາຊົນ​ໃຫ້​ມາ​ຫາ​ພຣະອົງ​ອີກ​ເທື່ອ​ໜຶ່ງ ແລະ ກ່າວ​ວ່າ, “ທຸກຄົນ​ຈົ່ງ​ຟັງ​ເຮົາ ແລະ ເຂົ້າໃຈ​ຂໍ້​ນີ້. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />ບໍ່​ມີ​ສິ່ງໃດ​ທີ່​ຢູ່​ພາຍນອກ​ທີ່​ເຂົ້າໄປ​ໃນ​ມະນຸດ​ແລ້ວ​ເຮັດ​ໃຫ້​ມະນຸດ ‘ເປັນມົນທິນ’. ແຕ່​ແມ່ນ​ສິ່ງ​ທີ່​ອອກ​ມາ​ຈາກ​ມະນຸດ​ນັ້ນ​ແຫລະ ທີ່​ເຮັດ​ໃຫ້​ພວກເຂົາ​ເປັນມົນທິນ”. <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />ຜູ້ໃດ​ມີ​ຫູ, ກໍ​ຈົ່ງ​ຟັງ​ເອົາ.<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />ຫລັງຈາກ​ພຣະອົງ​ໄດ້​ຈາກ​ປະຊາຊົນ​ໄປ ແລະ ເຂົ້າໄປ​ໃນ​ເຮືອນ​ແລ້ວ, ພວກສາວົກ​ໄດ້​ຖາມ​ພຣະອົງ​ກ່ຽວ​ກັບ​ຄຳອຸປະມາ​ນີ້. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />ພຣະອົງ​ຖາມ​ພວກເພິ່ນ​ວ່າ, “ພວກເຈົ້າ​ຍັງ​ບໍ່​ເຂົ້າໃຈ​ອີກ​ບໍ? ພວກເຈົ້າ​ບໍ່​ເຫັນ​ບໍ​ວ່າ​ບໍ່​ມີ​ສິ່ງໃດ​ຈາກ​ພາຍນອກ​ທີ່​ເຂົ້າ​ໄປ​ໃນ​ໂຕ​ມະນຸດ​ແລ້ວ​ເຮັດ​ໃຫ້​ມະນຸດ ‘ເປັນມົນທິນ’ ໄດ້? <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />ເພາະວ່າ​ສິ່ງ​ນັ້ນ​ບໍ່​ໄດ້​ເຂົ້າ​ໄປ​ໃນ​ໃຈ​ຂອງ​ພວກເຂົາ ແຕ່​ເຂົ້າ​ໄປ​ໃນ​ທ້ອງ​ຂອງ​ພວກເຂົາ​ແລ້ວ​ກໍ​ຖ່າຍ​ອອກ​ມາ​ຈາກ​ຮ່າງກາຍ”. (ທີ່​ພຣະເຢຊູເຈົ້າ​ກ່າວ​ເຊັ່ນ​ນີ້​ເປັນ​ການປະກາດ​ວ່າ​ອາຫານ​ທຸກຊະນິດ “ປາດສະຈາກ​ມົນທິນ”.)<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />ພຣະອົງ​ກໍ​ກ່າວ​ຕໍ່​ໄປ​ອີກ​ວ່າ, “ແມ່ນ​ສິ່ງ​ທີ່​ອອກ​ມາ​ຈາກ​ມະນຸດ​ນັ້ນ​ແຫລະ ທີ່​ເຮັດ​ໃຫ້​ມະນຸດ ‘ເປັນມົນທິນ’. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />ເພາະ​ທີ່​ອອກ​ມາ​ຈາກ​ພາຍໃນ, ອອກມາ​ຈາກ​ຈິດໃຈ​ຂອງ​ມະນຸດ​ຄື: ຄວາມຄິດຊົ່ວ, ການ​ຜິດສິນທຳທາງເພດ, ການລັກ, ການຂ້າຄົນ, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />ການຫລິ້ນຊູ້, ຄວາມໂລບ, ການປອງຮ້າຍ, ການສໍ້ໂກງ, ລາຄະຕັນຫາ, ຄວາມອິດສາ, ໃສ່ຮ້າຍປ້າຍສີ, ຄວາມຈອງຫອງ, ຄວາມໂງ່ຈ້າ. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />ທັງໝົດ​ເຫລົ່ານີ້​ແມ່ນ​ອອກມາ​ຈາກ​ພາຍໃນ ແລະ ເຮັດ​ໃຫ້​ມະນຸດ ‘ເປັນມົນທິນ’ ”.<verse eid="MRK 7:23" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຍົກຍ້ອງ​ຄວາມເຊື່ອ​ຂອງ​ຍິງ​ຊາວ​ຊີເຣຍ ເຟນີເຊຍ</para>
  <para style="r">(ມທ 15:21-28)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />ຕໍ່ມາ ພຣະເຢຊູເຈົ້າ​ໄດ້​ຈາກ​ທີ່​ນັ້ນ ແລະ ໄປ​ຍັງ​ຂົງເຂດ​ເມືອງ​ຕີເຣ,<note caller="+" style="f"><char style="fr" closed="false">7:24 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ໃນ​ຍຸກ​ທຳອິດ​ບາງ​ສະບັບ​ວ່າ </char><char style="fqa" closed="false">ເມືອງ​ຕີເຣ ແລະ ເມືອງ​ຊີໂດນ</char></note> ພຣະອົງ​ໄດ້​ເຂົ້າ​ໄປ​ໃນ​ເຮືອນ​ຫລັງ​ໜຶ່ງ ແລະ ບໍ່​ຕ້ອງການ​ໃຫ້​ຜູ້ໃດ​ຮູ້​ວ່າ​ພຣະອົງ​ຢູ່​ທີ່​ນັ້ນ ແຕ່​ພຣະອົງ​ກໍ​ປິດບັງ​ໄວ້​ບໍ່​ໄດ້. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />ແລ້ວ​ກໍ​ມີ​ຍິງ​ຄົນ​ໜຶ່ງ ເຊິ່ງ​ລູກສາວ​ນ້ອຍ​ຂອງ​ນາງ​ຖືກ​ວິນຍານສົກກະປົກ​ເຂົ້າ​ສິງ​ຢູ່ ເມື່ອ​ນາງ​ໄດ້​ຍິນ​ເຖິງ​ເລື່ອງ​ຂອງ​ພຣະອົງ​ກໍ​ຟ້າວ​ມາ ແລະ ຂາບລົງ​ທີ່​ຕີນ​ຂອງ​ພຣະອົງ. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />ຍິງ​ຜູ້​ນີ້​ເປັນ​ຊາວກຣີກ, ເກີດ​ຢູ່​ໃນ​ຊີເຣຍເຟນີເຊຍ. ນາງ​ມາ​ຂໍຮ້ອງ​ພຣະເຢຊູເຈົ້າ​ໃຫ້​ຊ່ວຍ​ຂັບໄລ່​ຜີມານຮ້າຍ​ອອກ​ຈາກ​ລູກສາວ​ຂອງ​ນາງ.<verse eid="MRK 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27" />ພຣະອົງ​ບອກ​ນາງ​ວ່າ, “ຕ້ອງ​ໃຫ້​ເດັກນ້ອຍ​ທັງຫລາຍ​ກິນ​ອີ່ມ​ກ່ອນ ບໍ່​ເປັນ​ການ​ຖືກຕ້ອງ​ທີ່​ຈະ​ເອົາ​ອາຫານ​ຂອງ​ລູກ​ໂຍນ​ໃຫ້​ໝາ”.<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />ນາງ​ຕອບ​ວ່າ, “ອົງພຣະຜູ້ເປັນເຈົ້າ​ເອີຍ, ແມ່ນ​ແຕ່​ໝາ​ທີ່​ຢູ່​ກ້ອງ​ໂຕະ​ກໍ​ຍັງ​ໄດ້​ກິນ​ເສດອາຫານ​ທີ່​ເຫລືອ​ຈາກ​ເດັກນ້ອຍ”.<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />ແລ້ວ​ພຣະອົງ​ຈຶ່ງ​ກ່າວ​ແກ່​ນາງ​ວ່າ, “ຈົ່ງ​ໄປ​ສາ, ເພາະ​ຄຳຕອບ​ຂອງ​ເຈົ້າ ຜີມານຮ້າຍ​ໄດ້​ອອກ​ຈາກ​ລູກສາວ​ຂອງ​ເຈົ້າ​ແລ້ວ”.<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />ນາງ​ຈຶ່ງ​ກັບ​ເມືອ​ເຮືອນ ແລະ ເຫັນ​ລູກສາວ​ຂອງ​ຕົນ​ນອນ​ຢູ່​ເທິງ​ຕຽງ ແລະ ຜີມານຮ້າຍ​ນັ້ນ​ໄດ້​ອອກ​ໄປ​ແລ້ວ.<verse eid="MRK 7:30" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຮັກສາ​ຄົນຫູໜວກ ແລະ ຄົນປາກກືກ​ໃຫ້​ຫາຍດີ</para>
  <para style="r">(ມທ 15:29-31)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />ຕໍ່ມາ ພຣະເຢຊູເຈົ້າ​ໄດ້​ຈາກ​ຂົງເຂດ​ເມືອງ​ຕີເຣ ຜ່ານ​ເມືອງ​ຊີໂດນ, ສູ່​ທະເລສາບ​ຄາລີເລ ໂດຍ​ຜ່ານ​ໄປ​ທາງ​ຂົງເຂດ​ເດກາໂປລີ.<note caller="+" style="f"><char style="fr" closed="false">7:31 </char><char style="ft" closed="false">ຄື </char><char style="fqa" closed="false">ສິບ​ເມືອງ</char></note> <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />ຢູ່​ທີ່​ນັ້ນ​ມີ​ປະຊາຊົນ​ບາງຄົນ​ໄດ້​ນໍາ​ຊາຍ​ຜູ້​ໜຶ່ງ​ທີ່​ຫູໜວກ ແລະ ເວົ້າ​ເກືອບ​ບໍ່​ໄດ້​ເລີຍ​ມາ​ຫາ​ພຣະອົງ ແລະ ຂໍຮ້ອງ​ພຣະອົງ​ໃຫ້​ວາງມື​ໃສ່​ຊາຍ​ຜູ້​ນັ້ນ.<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />ຫລັງຈາກ​ທີ່​ພຣະອົງ​ໄດ້​ພາ​ລາວ​ອອກ​ໄປ​ຫ່າງ​ຈາກ​ປະຊາຊົນ, ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ກໍ​ໃຊ້​ນິ້ວມື​ສອດ​ເຂົ້າ​ໄປ​ໃນ​ຫູ​ທັງ​ສອງ​ຂອງ​ຊາຍ​ຜູ້​ນັ້ນ, ແລ້ວ​ບ້ວນ​ນ້ຳລາຍ​ເອົາ​ໄປ​ແປະ​ໃສ່​ທີ່​ລີ້ນ​ຂອງ​ລາວ. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />ພຣະອົງ​ເງີຍ​ໜ້າ​ເບິ່ງ​ສະຫວັນ​ພ້ອມ​ທັງ​ຖອນ​ຫາຍໃຈ​ຍາວ ແລະ ກ່າວ​ກັບ​ລາວ​ວ່າ “ເອຟາທາ!” (ເຊິ່ງ​ແປ​ວ່າ: “ຈົ່ງ​ເປີດ​ອອກ!”). <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />ໃນທັນໃດ​ນັ້ນ ຫູ​ທັງ​ສອງ​ຂອງ​ຊາຍ​ຄົນ​ນັ້ນ​ກໍ​ໄດ້​ເປີດ​ອອກ ແລະ ລີ້ນ​ຂອງ​ລາວ​ກໍ​ເຊົາ​ຂັດ ແລະ ລາວ​ເລີ່ມ​ເວົ້າ​ໄດ້​ຊັດເຈນ.<verse eid="MRK 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36" />ພຣະເຢຊູເຈົ້າ​ສັ່ງ​ພວກເຂົາ​ບໍ່​ໃຫ້​ເລົ່າ​ເລື່ອງ​ນີ້​ແກ່​ຜູ້ໃດ. ແຕ່​ຍິ່ງ​ພຣະອົງ​ສັ່ງຫ້າມ​ພວກເຂົາ ພວກເຂົາ​ກໍ​ຍິ່ງ​ເວົ້າ​ເລື່ອງ​ນີ້​ໄປ​ທົ່ວ. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />ປະຊາຊົນ​ຕ່າງ​ກໍ​ປະຫລາດໃຈ​ຫລາຍ ຈຶ່ງ​ເວົ້າ​ກັນ​ວ່າ, “ພຣະອົງ​ກະທຳ​ແຕ່​ສິ່ງ​ດີ​ທັງ​ນັ້ນ. ແມ່ນ​ແຕ່​ຄົນຫູໜວກ​ພຣະອົງ​ກໍ​ເຮັດ​ໃຫ້​ໄດ້​ຍິນ ແລະ ຄົນປາກກືກ​ກໍ​ເຮັດ​ໃຫ້​ເວົ້າ​ໄດ້”.<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ລ້ຽງ​ຄົນ​ສີ່ພັນ​ຄົນ</para>
  <para style="r">(ມທ 15:32-39; 16:1-12)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />ໃນ​ຊ່ວງ​ວັນ​ເຫລົ່ານັ້ນ ມີ​ປະຊາຊົນ​ອີກ​ຈໍານວນ​ຫລວງຫລາຍ​ໄດ້​ມາ​ເຕົ້າໂຮມກັນ. ເນື່ອງ​ຈາກ​ວ່າ ພວກເຂົາ​ບໍ່​ມີ​ອາຫານ​ກິນ, ພຣະເຢຊູເຈົ້າ​ຈຶ່ງ​ເອີ້ນ​ພວກສາວົກ​ຂອງ​ພຣະອົງ​ມາ ແລະ ກ່າວ​ວ່າ, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“ເຮົາ​ສົງສານ​ຄົນ​ເຫລົ່ານີ້​ເພາະ​ພວກເຂົາ​ມາ​ຢູ່​ກັບ​ເຮົາ​ໄດ້​ສາມ​ວັນ​ແລ້ວ ແລະ ບໍ່​ມີ​ຫຍັງ​ກິນ. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />ຖ້າ​ເຮົາ​ໃຫ້​ພວກເຂົາ​ກັບ​ໄປ​ທັງ​ທີ່​ຍັງ​ຫິວ​ຢູ່​ພວກເຂົາ​ອາດ​ຈະ​ໝົດ​ແຮງ​ກາງທາງ​ກໍ​ໄດ້​ເພາະ​ບາງຄົນ​ກໍ​ມາ​ແຕ່​ໄກ”.<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />ພວກສາວົກ​ຈຶ່ງ​ຕອບ​ພຣະອົງ​ວ່າ, “ແຕ່​ໃນ​ທີ່​ຫ່າງໄກ​ເຊັ່ນ​ນີ້​ຈະ​ຫາ​ເຂົ້າຈີ່​ຢູ່​ໃສ​ມາ​ພໍ​ລ້ຽງ​ພວກເຂົາ?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />ພຣະເຢຊູເຈົ້າ​ຖາມ​ພວກເພິ່ນ​ວ່າ, “ພວກເຈົ້າ​ມີ​ເຂົ້າຈີ່​ຈັກ​ກ້ອນ?”</para>
  <para style="p" vid="MRK 8:5">ພວກເພິ່ນ​ຕອບ​ວ່າ, “ເຈັດ​ກ້ອນ”.<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />ພຣະອົງ​ບອກ​ປະຊາຊົນ​ໃຫ້​ນັ່ງ​ລົງ​ຕາມ​ພື້ນດິນ. ເມື່ອ​ພຣະອົງ​ຮັບ​ເອົາ​ເຂົ້າຈີ່​ເຈັດ​ກ້ອນ ແລະ ໂມທະນາ​ຂອບພຣະຄຸນ​ພຣະເຈົ້າ​ແລ້ວ, ພຣະອົງ​ກໍ​ຫັກ​ເຂົ້າຈີ່​ຍື່ນ​ໃຫ້​ພວກສາວົກ​ຂອງ​ພຣະອົງ​ເພື່ອ​ແຈກຢາຍ​ໃຫ້​ແກ່​ປະຊາຊົນ ແລະ ພວກເພິ່ນ​ກໍ​ເຮັດ​ຕາມ​ນັ້ນ. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />ພວກເຂົາ​ຍັງ​ມີ​ປານ້ອຍ​ຈຳນວນ​ໜຶ່ງ, ພຣະອົງ​ໂມທະນາ​ຂອບພຣະຄຸນ​ພຣະເຈົ້າ​ສຳລັບ​ປາ​ເຫລົ່ານີ້ ແລະ ໃຫ້​ພວກສາວົກ​ນຳ​ໄປ​ແຈກຢາຍ​ເໝືອນ​ກັນ. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />ປະຊາຊົນ​ຕ່າງ​ກໍ​ກິນ​ຈົນ​ອີ່ມ. ຫລັງຈາກນັ້ນ ພວກສາວົກ​ໄດ້​ເກັບ​ເອົາ​ຕ່ອນ​ຫັກ​ທີ່​ເຫລືອ​ໄວ້​ໄດ້​ເຕັມ​ເຈັດ​ກະບຸງ. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />ໃນ​ທີ່​ນັ້ນ ມີ​ຜູ້ຊາຍ​ປະມານ​ສີ່ພັນ​ຄົນ. ຫລັງຈາກ​ທີ່​ພຣະອົງ​ໃຫ້​ພວກເຂົາ​ກັບ​ໄປ​ແລ້ວ, <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />ພຣະອົງ​ກໍ​ລົງ​ເຮືອ​ໄປ​ກັບ​ພວກສາວົກ​ຂອງ​ພຣະອົງ ແລະ ໄປ​ເຖິງ​ຂົງເຂດ​ເມືອງ​ດານມານຸທາ.<verse eid="MRK 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />ພວກ​ຟາຣີຊາຍ​ໄດ້​ມາ​ຫາ ແລະ ເລີ່ມ​ຖາມ​ພຣະເຢຊູເຈົ້າ. ເພື່ອ​ທົດລອງ​ພຣະອົງ ພວກເຂົາ​ຂໍ​ໃຫ້​ພຣະອົງ​ສະແດງ​ໝາຍສຳຄັນ​ຢ່າງ​ໜຶ່ງ​ຈາກ​ສະຫວັນ. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />ພຣະອົງ​ຖອນ​ຫາຍໃຈ​ຍາວ ແລະ ກ່າວ​ວ່າ, “ເປັນຫຍັງ​ຄົນ​ໃນ​ຍຸກ​ນີ້​ຈຶ່ງ​ຂໍ​ແຕ່​ໝາຍສຳຄັນ? ເຮົາ​ບອກ​ພວກເຈົ້າ​ຕາມ​ຄວາມຈິງ​ວ່າ, ຈະ​ບໍ່​ໃຫ້​ໝາຍສຳຄັນ​ໃດໆ​ແກ່​ພວກເຂົາ”. <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />ແລ້ວ​ພຣະອົງ​ກໍ​ຈາກ​ພວກເຂົາ​ກັບ​ລົງ​ໄປ​ໃນ​ເຮືອ ແລະ ຂ້າມ​ທະເລສາບ​ໄປ​ຍັງ​ຟາກ​ອື່ນ.<verse eid="MRK 8:13" /></para>
  <para style="s1">ເຊື້ອແປ້ງ​ຂອງ​ພວກ​ຟາຣີຊາຍ ແລະ ຂອງ​ເຮໂຣດ</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />ພວກສາວົກ​ໄດ້​ລືມ​ເອົາ​ເຂົ້າຈີ່​ມາ​ນຳ ແລະ ຢູ່​ໃນ​ເຮືອ​ກໍ​ມີ​ເຂົ້າຈີ່​ພຽງ​ແຕ່​ກ້ອນ​ດຽວ. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />ພຣະເຢຊູເຈົ້າ​ກ່າວ​ເຕືອນ​ພວກເພິ່ນ​ວ່າ, “ຈົ່ງ​ລະວັງ​ເຊື້ອແປ້ງ​ຂອງ​ພວກ​ຟາຣີຊາຍ ແລະ ເຊື້ອແປ້ງ​ຂອງ​ເຮໂຣດ​ໃຫ້​ດີ”.<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />ພວກເພິ່ນ​ຈຶ່ງ​ສົນທະນາກັນ ແລະ ເວົ້າ​ວ່າ, “ເປັນ​ເພາະ​ພວກເຮົາ​ບໍ່​ມີ​ເຂົ້າຈີ່”.<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />ພຣະເຢຊູເຈົ້າ​ຮູ້​ເລື່ອງ​ທີ່​ພວກເພິ່ນ​ເວົ້າ​ກັນ​ນັ້ນ ຈຶ່ງ​ຖາມ​ພວກເພິ່ນ​ວ່າ, “ເປັນຫຍັງ​ພວກເຈົ້າ​ຈຶ່ງ​ເວົ້າ​ກັນ​ເຖິງ​ເລື່ອງ​ບໍ່​ມີ​ເຂົ້າຈີ່? ພວກເຈົ້າ​ຍັງ​ບໍ່​ເຫັນ ຫລື ຍັງ​ບໍ່​ເຂົ້າໃຈ​ບໍ? ໃຈ​ຂອງ​ພວກເຈົ້າ​ແຂງກະດ້າງ​ແມ່ນ​ບໍ? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />ພວກເຈົ້າ​ມີ​ຕາ​ແຕ່​ເບິ່ງ​ບໍ່​ເຫັນ, ມີ​ຫູ​ແຕ່​ບໍ່​ໄດ້ຍິນ​ບໍ? ແລະ ພວກເຈົ້າ​ຈື່​ບໍ່​ໄດ້​ບໍ? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />ເມື່ອ​ເຮົາ​ຫັກ​ເຂົ້າຈີ່​ຫ້າ​ກ້ອນ​ລ້ຽງ​ຄົນ​ຫ້າພັນ​ຄົນ, ພວກເຈົ້າ​ເກັບ​ສ່ວນ​ທີ່​ເຫລືອ​ໄດ້​ຈັກ​ກະບຸງ?”</para>
  <para style="p" vid="MRK 8:19">ພວກເພິ່ນ​ຕອບ​ວ່າ, “ສິບສອງ​ກະບຸງ”.<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />ພຣະອົງ​ຖາມ​ວ່າ, “ແລະ ເມື່ອ​ເຮົາ​ຫັກ​ເຂົ້າຈີ່​ເຈັດ​ກ້ອນ​ລ້ຽງ​ຄົນ​ສີ່ພັນ​ຄົນ, ພວກເຈົ້າ​ເກັບ​ສ່ວນ​ທີ່​ເຫລືອ​ໄວ້​ໄດ້​ຈັກ​ກະບຸງ?”</para>
  <para style="p" vid="MRK 8:20">ພວກເພິ່ນ​ຕອບ​ວ່າ, “ເຈັດ​ກະບຸງ”.<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />ພຣະອົງ​ກ່າວ​ກັບ​ພວກເພິ່ນ​ວ່າ, “ພວກເຈົ້າ​ຍັງ​ບໍ່​ເຂົ້າໃຈ​ຢູ່​ບໍ?”<verse eid="MRK 8:21" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຮັກສາ​ຄົນຕາບອດ​ຜູ້​ໜຶ່ງ​ທີ່​ເບັດຊາອີດາ​ໃຫ້​ຫາຍດີ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />ເມື່ອ​ພຣະເຢຊູເຈົ້າ ແລະ ພວກສາວົກ​ມາ​ຮອດ​ເມືອງ​ເບັດຊາອີດາ, ມີ​ບາງ​ຄົນ​ໄດ້​ພາ​ຊາຍ​ຕາບອດ​ຜູ້​ໜຶ່ງ​ມາ ແລະ ຂໍຮ້ອງ​ພຣະເຢຊູເຈົ້າ​ໃຫ້​ວາງມື​ໃສ່​ລາວ. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />ພຣະອົງ​ຈູງ​ມື​ຄົນ​ຕາບອດ​ອອກ​ໄປ​ນອກ​ໝູ່​ບ້ານ. ເມື່ອ​ພຣະອົງ​ຖົ່ມ​ນ້ຳລາຍ​ໃສ່​ຕາ​ທັງ​ສອງ​ຂອງ​ຊາຍ​ຜູ້​ນີ້ ແລະ ວາງມື​ໃສ່​ລາວ​ແລ້ວ ພຣະອົງ​ກໍ​ຖາມ​ລາວ​ວ່າ, “ເຈົ້າ​ເຫັນ​ຫຍັງ​ບໍ?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />ລາວ​ໄດ້​ເງີຍ​ໜ້າ​ຂຶ້ນ​ເບິ່ງ ແລະ ຕອບ​ວ່າ, “ຂ້ານ້ອຍ​ເຫັນ​ຄົນ, ພວກເຂົາ​ເໝືອນ​ຕົ້ນໄມ້​ຍ່າງ​ໄປ​ຍ່າງ​ມາ”.<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />ພຣະເຢຊູເຈົ້າ​ວາງມື​ໃສ່​ທີ່​ຕາ​ຂອງ​ລາວ​ອີກ​ເທື່ອ​ໜຶ່ງ. ແລ້ວ​ຕາ​ທັງສອງ​ຂອງ​ລາວ​ກໍ​ເປີດ​ອອກ, ສາຍຕາ​ຂອງ​ລາວ​ກໍ​ດີ​ເປັນປົກກະຕິ ແລະ ເບິ່ງ​ເຫັນ​ທຸກ​ຢ່າງ​ໄດ້​ຊັດເຈນ. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />ພຣະເຢຊູເຈົ້າ​ຈຶ່ງ​ໃຫ້​ລາວ​ກັບ​ເມືອ​ໂດຍ​ສັ່ງ​ວ່າ, “ຢ່າ​ເຂົ້າໄປ​ໃນ​ໝູ່ບ້ານ<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ບາງ​ສະບັບ​ວ່າ </char><char style="fqa" closed="false">ຢ່າ​ໄປ​ເລົ່າ​ໃຫ້​ຜູ້ໃດ​ໃນ​ໝູ່ບ້ານ​ຟັງ</char></note>”.<verse eid="MRK 8:26" /></para>
  <para style="s1">ເປໂຕ​ປະກາດ​ວ່າ​ພຣະເຢຊູເຈົ້າ​ເປັນ​ພຣະຄຣິດເຈົ້າ</para>
  <para style="r">(ມທ 16:13-16; ລກ 9:18-20)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />ພຣະເຢຊູເຈົ້າ ແລະ ພວກສາວົກ​ຂອງ​ພຣະອົງ​ໄດ້​ໄປ​ຍັງ​ໝູ່​ບ້ານ​ໃກ້​ເຂດ​ເມືອງ​ກາຍຊາເຣຍ ຟີລິບປອຍ. ໃນ​ລະຫວ່າງທາງ​ພຣະອົງ​ໄດ້​ຖາມ​ພວກເພິ່ນ​ວ່າ, “ຄົນ​ທັງຫລາຍ​ເວົ້າ​ກັນ​ວ່າ​ເຮົາ​ເປັນ​ຜູ້ໃດ?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />ພວກເພິ່ນ​ຕອບ​ວ່າ, “ບາງຄົນ​ເວົ້າ​ວ່າ​ທ່ານ​ແມ່ນ​ໂຢຮັນ​ບັບຕິສະໂຕ, ບາງຄົນ​ເວົ້າ​ວ່າ​ທ່ານ​ແມ່ນ​ເອລີຢາ ແລະ ຍັງ​ມີ​ຄົນ​ອື່ນໆ​ອີກ​ເວົ້າ​ວ່າ​ທ່ານ​ເປັນ​ຄົນ​ໜຶ່ງ​ໃນ​ບັນດາ​ຜູ້ທຳນວາຍ”.<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />ພຣະອົງ​ຖາມ​ວ່າ, “ແລ້ວ​ພວກເຈົ້າ​ເດ? ພວກເຈົ້າ​ວ່າ​ເຮົາ​ເປັນ​ຜູ້ໃດ?”</para>
  <para style="p" vid="MRK 8:29">ເປໂຕ​ຕອບ​ວ່າ, “ພຣະອົງ​ເປັນ​ພຣະຄຣິດເຈົ້າ<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ພຣະເມຊີອາ</char></note>”.<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ເຕືອນ​ພວກເພິ່ນ​ບໍ່​ໃຫ້​ບອກ​ຜູ້ໃດ​ກ່ຽວກັບ​ເລື່ອງ​ຂອງ​ພຣະອົງ.<verse eid="MRK 8:30" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ທຳນວາຍ​ເຖິງ​ການຕາຍ​ຂອງ​ພຣະອົງ</para>
  <para style="r">(ມທ 16:21-28; ລກ 9:22-27)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />ຕັ້ງ​ແຕ່​ນັ້ນ​ມາ ພຣະເຢຊູເຈົ້າ​ກໍ​ໄດ້​ເລີ່ມ​ສັ່ງສອນ​ພວກສາວົກ​ວ່າ​ບຸດມະນຸດ​ຈະ​ຕ້ອງ​ຖືກ​ທົນທຸກທໍລະມານ​ຫລາຍ​ປະການ. ຖືກ​ພວກ​ເຖົ້າແກ່, ພວກຫົວໜ້າ​ປະໂລຫິດ ແລະ ພວກ​ຄູສອນກົດບັນຍັດ​ປະຕິເສດ, ພຣະອົງ​ຈະ​ຕ້ອງ​ຖືກ​ຂ້າ ແລະ ໃນ​ວັນ​ທີ​ສາມ​ພຣະອົງ​ຈະ​ເປັນຄືນມາ​ອີກ. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />ພຣະອົງ​ໄດ້​ກ່າວ​ເລື່ອງ​ນີ້​ສູ່​ພວກເພິ່ນ​ຟັງ​ຢ່າງ​ຈະແຈ້ງ, ເປໂຕ​ຈຶ່ງ​ໄດ້​ພາ​ພຣະອົງ​ຫລີກ​ໄປ​ຕ່າງຫາກ ແລະ ເລີ່ມ​ຕຳໜິ​ພຣະອົງ.<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />ແຕ່​ເມື່ອ​ພຣະເຢຊູເຈົ້າ​ຫັນ​ກັບ​ມາ​ເບິ່ງ​ພວກສາວົກ​ຂອງ​ພຣະອົງ, ພຣະອົງ​ຕຳໜິ​ເປໂຕ, ພຣະອົງ​ກ່າວ​ວ່າ, “ມານຊາຕານ​ເອີຍ! ຈົ່ງ​ຖອຍ​ໜີ​ໄປ​ຈາກ​ເຮົາ ເຈົ້າ​ບໍ່​ໄດ້​ມີ​ຄວາມຄິດ​ຫວ່ງໃຍ​ເໝືອນດັ່ງ​ພຣະເຈົ້າ ແຕ່​ມີ​ຄວາມຄິດ​ຫ່ວງໃຍ​ເໝືອນດັ່ງ​ມະນຸດ”.<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />ແລ້ວ​ພຣະອົງ​ເອີ້ນ​ປະຊາຊົນ​ກັບ​ພວກສາວົກ​ເຂົ້າ​ມາ ແລະ ກ່າວ​ວ່າ: “ຖ້າ​ຜູ້ໃດ​ຢາກ​ເປັນ​ສາວົກ​ຂອງ​ເຮົາ, ໃຫ້​ຜູ້​ນັ້ນ​ປະຕິເສດ​ຕົນ​ເອງ ແລະ ຮັບ​ແບກ​ໄມ້ກາງແຂນ​ຂອງ​ຕົນ​ແລ້ວ​ຕິດຕາມ​ເຮົາ​ມາ. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />ເພາະ​ຜູ້ໃດ​ທີ່​ຢາກ​ຮັກສາ​ຊີວິດ<note caller="+" style="f"><char style="fr" closed="false">8:35 </char><char style="ft" closed="false">ພາສາ​ກຣີກ​ໝາຍ​ເຖິງ </char><char style="fqa" closed="false">ຊີວິດ </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ຈິດວິນຍານ </char><char style="ft" closed="false">ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="MRK 8:36"><ref loc="MRK 8:36">36</ref></char> ແລະ <char style="xt" link-href="MRK 8:37"><ref loc="MRK 8:37">37</ref></char></char></note>​ຂອງ​ຕົນ​ໃຫ້​ພົ້ນ ຜູ້​ນັ້ນ​ກໍ​ຈະ​ເສຍ​ຊີວິດ, ເພາະ​ຜູ້ໃດ​ທີ່​ຍອມ​ສະຫລະ​ຊີວິດ​ຂອງ​ຕົນ​ເພື່ອ​ເຫັນ​ແກ່​ເຮົາ ແລະ ຂ່າວປະເສີດ ຜູ້​ນັ້ນ​ກໍ​ຈະ​ຖືກ​ຊ່ວຍ​ຊີວິດ​ໃຫ້​ພົ້ນ. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />ຈະ​ມີ​ປະໂຫຍດ​ອັນໃດ ທີ່​ຄົນ​ໃດ​ຄົນ​ໜຶ່ງ​ຈະ​ໄດ້​ໂລກ​ນີ້​ທັງໝົດ ແຕ່​ຕ້ອງ​ສູນເສຍ​ຈິດວິນຍານ​ຂອງ​ຕົນ? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />ຫລື ຄົນ​ນັ້ນ​ຈະ​ເອົາ​ສິ່ງ​ໃດ​ມາ​ແລກປ່ຽນ​ເອົາ​ຈິດວິນຍານ​ຂອງ​ຕົນ​ໄດ້? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />ຖ້າ​ຜູ້ໃດ​ອັບອາຍ​ໃນ​ເລື່ອງ​ເຮົາ ແລະ ໃນ​ເລື່ອງ​ຖ້ອຍຄຳ​ຂອງ​ເຮົາ​ໃນ​ຍຸກ​ທີ່​ບາບ ແລະ ຫລິ້ນຊູ້, ບຸດມະນຸດ​ກໍ​ຈະ​ອັບອາຍ​ໃນ​ເລື່ອງ​ຄົນ​ນັ້ນ ເມື່ອ​ພຣະອົງ​ມາ​ປາກົດ​ໃນ​ສະຫງ່າລາສີ​ຂອງ​ພຣະບິດາ ພ້ອມ​ກັບ​ບັນດາ​ເທວະດາ​ບໍລິສຸດ”.<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />ແລະ ພຣະອົງ​ກ່າວ​ແກ່​ພວກເພິ່ນ​ວ່າ, “ເຮົາ​ບອກ​ພວກເຈົ້າ​ຕາມ​ຄວາມຈິງ​ວ່າ, ບາງຄົນ​ທີ່​ຢືນ​ຢູ່​ໃນ​ທີ່​ນີ້​ຈະ​ບໍ່​ຮູ້​ລົດ​ຂອງ​ຄວາມຕາຍ​ຈົນ​ກວ່າ​ພວກເຂົາ​ຈະ​ໄດ້​ເຫັນ​ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ​ມາ​ຕັ້ງ​ຢູ່​ດ້ວຍ​ລິດອຳນາດ”.<verse eid="MRK 9:1" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ປ່ຽນ​ລັກສະນະ​ຮ່າງກາຍ</para>
  <para style="r">(ມທ 17:1-13; ລກ 9:28-36)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />ຫົກ​ວັນ​ຕໍ່ມາ ພຣະເຢຊູເຈົ້າ​ໄດ້​ພາ​ເປໂຕ, ຢາໂກໂບ ແລະ ໂຢຮັນ​ຂຶ້ນ​ໄປ​ເທິງ​ພູ​ສູງ​ຢູ່​ຕ່າງຫາກ. ຢູ່​ທີ່​ນັ້ນ ຮ່າງກາຍ​ຂອງ​ພຣະອົງ​ກໍ​ປ່ຽນແປງ​ໄປ​ຕໍ່ໜ້າ​ພວກເພິ່ນ. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />ເຄື່ອງນຸ່ງ​ຂອງ​ພຣະອົງ​ກາຍເປັນ​ສີຂາວ​ສ່ອງແສງ​ເຫລື້ອມໃສ, ຂາວ​ກວ່າ​ສິ່ງໃດ​ໃນ​ໂລກ​ນີ້​ຈະ​ຟອກ​ໃຫ້​ຂາວ​ເຊັ່ນ​ນັ້ນ​ໄດ້. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />ແລ້ວ​ໂມເຊ ແລະ ເອລີຢາ​ກໍ​ໄດ້​ມາ​ປາກົດ​ໂຕ​ຕໍ່ໜ້າ​ພວກເພິ່ນ ແລະ ກຳລັງ​ສົນທະນາ​ຢູ່​ກັບ​ພຣະເຢຊູເຈົ້າ.<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />ເປໂຕ​ຈຶ່ງ​ເວົ້າ​ກັບ​ພຣະເຢຊູເຈົ້າ​ວ່າ, “ອາຈານ​ເອີຍ, ດີ​ແທ້ໆ​ທີ່​ພວກຂ້ານ້ອຍ​ໄດ້​ມາ​ຢູ່​ບ່ອນນີ້. ຂໍ​ໃຫ້​ພວກຂ້ານ້ອຍ​ປຸກ​ຕູບ​ສາມ​ຫລັງ​ຂຶ້ນ ຫລັງ​ໜຶ່ງ​ສຳລັບ​ພຣະອົງ, ຫລັງ​ໜຶ່ງ​ສຳລັບ​ໂມເຊ ແລະ ຫລັງ​ໜຶ່ງ​ສຳລັບ​ເອລີຢາ”. <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />(ເປໂຕ​ບໍ່​ຮູ້​ວ່າ​ຈະ​ເວົ້າ​ສິ່ງໃດ​ດີ ເພາະ​ພວກເພິ່ນ​ຕົກໃຈຢ້ານ​ຫລາຍ.)<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />ແລ້ວ​ກໍ​ມີ​ກ້ອນເມກ​ປາກົດ​ຂຶ້ນ​ມາ​ປົກຄຸມ​ພວກເພິ່ນ​ໄວ້, ແລະ ມີ​ສຽງ​ໜຶ່ງ​ດັງ​ອອກ​ມາ​ຈາກ​ກ້ອນເມກ​ນັ້ນ​ວ່າ, “ທ່ານ​ຜູ້​ນີ້, ເປັນ​ບຸດ​ທີ່​ຮັກ​ຂອງ​ເຮົາ, ຈົ່ງ​ເຊື່ອຟັງ​ເພິ່ນ!”<verse eid="MRK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8" />ທັນໃດ​ນັ້ນ ເມື່ອ​ພວກເພິ່ນ​ຫລຽວ​ເບິ່ງ​ອ້ອມຮອບ​ໂຕ​ກໍ​ບໍ່​ເຫັນ​ຜູ້ໃດ ນອກຈາກ​ພຣະເຢຊູເຈົ້າ​ເທົ່ານັ້ນ​ທີ່​ຢູ່​ກັບ​ພວກເພິ່ນ.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />ໃນ​ຂະນະ​ທີ່​ກຳລັງ​ລົງ​ມາ​ແຕ່​ພູເຂົາ​ນັ້ນ, ພຣະເຢຊູເຈົ້າ​ໄດ້​ສັ່ງ​ພວກເພິ່ນ​ວ່າ​ຢ່າ​ບອກ​ສິ່ງ​ທີ່​ພວກເຈົ້າ​ໄດ້​ເຫັນ​ນີ້​ໃຫ້​ແກ່​ຜູ້ໃດ​ຈົນ​ກວ່າ​ບຸດມະນຸດ​ຈະ​ເປັນຄືນມາຈາກຕາຍ. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />ພວກສາວົກ​ທັງ​ສາມ​ໄດ້​ຖືຮັກສາ​ຂໍ້ຄຳສັ່ງ​ນີ້​ໄວ້​ກັບ​ຕົນ​ເອງ ໂດຍ​ປຶກສາ​ກັນ​ວ່າ, “ການເປັນຄືນມາຈາກຕາຍ” ໝາຍ​ຄວາມ​ວ່າ​ແນວໃດ.<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />ແລະ ພວກເພິ່ນ​ຈຶ່ງ​ຖາມ​ພຣະອົງ​ວ່າ, “ເປັນຫຍັງ​ພວກ​ຄູສອນກົດບັນຍັດ​ຈຶ່ງ​ເວົ້າ​ວ່າ​ເອລີຢາ​ຈະ​ຕ້ອງ​ມາ​ກ່ອນ?”<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />ພຣະເຢຊູເຈົ້າ​ຕອບ​ພວກເພິ່ນ​ວ່າ, “ຖືກ​ແລ້ວ, ເອລີຢາ​ຕ້ອງ​ມາ​ກ່ອນ ແລະ ເຮັດ​ໃຫ້​ທຸກສິ່ງ​ກັບ​ຄືນ​ສູ່​ສະພາບເດີມ. ດ້ວຍເຫດໃດ​ຈຶ່ງ​ມີ​ຄຳຂຽນ​ໄວ້​ໃນ​ພຣະຄຳພີ​ວ່າ​ບຸດມະນຸດ​ຈະ​ຖືກ​ທົນທຸກທໍລະມານ​ຢ່າງ​ໜັກໜ່ວງ ແລະ ຖືກ​ປະຕິເສດ? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />ແຕ່​ເຮົາ​ບອກ​ພວກເຈົ້າ​ວ່າ, ເອລີຢາ​ໄດ້​ມາ​ແລ້ວ ແລະ ພວກເຂົາ​ໄດ້​ເຮັດ​ກັບ​ເພິ່ນ​ຕາມໃຈ​ມັກ​ທຸກ​ຢ່າງ ດັ່ງ​ທີ່​ມີ​ຄຳຂຽນ​ໄວ້​ໃນ​ພຣະຄຳພີ​ກ່ຽວກັບ​ເພິ່ນ”.<verse eid="MRK 9:13" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຮັກສາ​ເດັກຊາຍ​ຜູ້​ໜຶ່ງ​ທີ່​ຖືກ​ວິນຍານສົກກະປົກ​ສິງ</para>
  <para style="r">(ມທ 17:14-19,22,23; ລກ 9:37-45)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />ເມື່ອ​ພວກເພິ່ນ​ໄດ້​ມາ​ຮອດ​ສາວົກ​ຄົນ​ອື່ນໆ​ແລ້ວ ພວກເພິ່ນ​ກໍ​ເຫັນ​ປະຊາຊົນ​ຢ່າງ​ຫລວງຫລາຍ​ຫຸ້ມອ້ອມ​ພວກເຂົາ​ຢູ່ ແລະ ພວກ​ຄູສອນກົດບັນຍັດ​ກຳລັງ​ໂຕ້ຖຽງ​ກັບ​ພວກເຂົາ​ຢູ່. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />ໃນທັນໃດ​ນັ້ນ ເມື່ອ​ປະຊາຊົນ​ທັງຫລາຍ​ເຫັນ​ພຣະເຢຊູເຈົ້າ, ພວກເຂົາ​ກໍ​ປະຫລາດໃຈ​ຫລາຍ ແລະ ພາກັນ​ຟ້າວ​ແລ່ນ​ເຂົ້າ​ມາ​ຄຳນັບ​ພຣະອົງ.<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />ພຣະອົງ​ຈຶ່ງ​ຖາມ​ວ່າ, “ພວກເຈົ້າ​ກຳລັງ​ໂຕ້ຖຽງ​ກັນ​ເຖິງ​ເລື່ອງ​ຫຍັງ?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />ມີ​ຊາຍ​ຄົນ​ໜຶ່ງ​ໃນ​ບັນດາ​ປະຊາຊົນ​ນັ້ນ​ຕອບ​ວ່າ, “ອາຈານ​ເອີຍ, ຂ້ານ້ອຍ​ໄດ້​ນໍາ​ລູກຊາຍ​ຂອງ​ຂ້ານ້ອຍ​ມາ​ຫາ​ທ່ານ, ລາວ​ຖືກ​ຜີມານຮ້າຍ​ສິງ​ຈົນ​ເຮັດ​ໃຫ້​ລາວ​ປາກກືກ. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />ເມື່ອ​ມັນ​ເຂົ້າ​ສິງ​ລາວ​ເທື່ອ​ໃດ, ມັນ​ກໍ​ເຮັດ​ໃຫ້​ລາວ​ລົ້ມລົງ​ພື້ນ, ແລະ ມີ​ນ້ຳລາຍ​ຟູມປາກ​ທັງ​ກັດແຂ້ວ ແລະ ໂຕ​ແຂງ​ໄປ​ໝົດ​ທັງ​ຮ່າງກາຍ. ຂ້ານ້ອຍ​ຂໍ​ໃຫ້​ພວກສາວົກ​ຂອງ​ທ່ານ​ຂັບໄລ່​ຜີມານຮ້າຍ​ນັ້ນ​ອອກ, ແຕ່​ພວກເພິ່ນ​ບໍ່​ສາມາດ​ເຮັດ​ໄດ້”.<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />ພຣະເຢຊູເຈົ້າ​ຕອບ​ວ່າ, “ຄົນ​ໃນ​ສະໄໝ​ທີ່​ຂາດ​ຄວາມເຊື່ອ​ເອີຍ, ເຮົາ​ຈະ​ຕ້ອງ​ຢູ່​ກັບ​ພວກເຈົ້າ​ອີກ​ດົນ​ປານໃດ? ເຮົາ​ຈະ​ອົດທົນ​ກັບ​ພວກເຈົ້າ​ອີກ​ດົນ​ປານໃດ? ຈົ່ງ​ພາ​ເດັກຊາຍ​ນັ້ນ​ມາ​ຫາ​ເຮົາ”.<verse eid="MRK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20" />ພວກເຂົາ​ກໍ​ໄດ້​ພາ​ເດັກນ້ອຍ​ມາ​ຫາ​ພຣະອົງ. ເມື່ອ​ຜີມານຮ້າຍ​ທີ່​ສິງ​ຢູ່​ໃນ​ໂຕ​ເດັກນ້ອຍ​ນັ້ນ​ໄດ້​ເຫັນ​ພຣະເຢຊູເຈົ້າ, ທັນໃດ​ນັ້ນ ມັນ​ກໍ​ເຮັດ​ໃຫ້​ເດັກນ້ອຍ​ນັ້ນ​ລົ້ມລົງ​ພື້ນດິນ, ຊັກດິ້ນ​ລົ້ມລົງ​ກິ້ງ​ໄປ​ມາ ແລະ ມີ​ນ້ຳລາຍ​ຟູມປາກ.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />ພຣະເຢຊູເຈົ້າ​ໄດ້​ຖາມ​ພໍ່​ຂອງ​ເດັກນ້ອຍ​ວ່າ, “ລາວ​ເປັນ​ຢ່າງ​ນີ້​ມາ​ດົນ​ປານໃດ​ແລ້ວ?”</para>
  <para style="p" vid="MRK 9:21">ລາວ​ຕອບ​ວ່າ, “ເປັນ​ມາ​ຕັ້ງ​ແຕ່​ນ້ອຍ​ພຸ້ນ <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />ຫລາຍ​ເທື່ອ​ແລ້ວ​ທີ່​ມັນ​ຊຸກ​ລາວ​ໃຫ້​ຕົກນ້ຳ ແລະ ຕົກ​ໃສ່​ໄຟ​ເພື່ອ​ຂ້າ​ລາວ. ແຕ່​ຖ້າ​ທ່ານ​ສາມາດ​ຊ່ວຍ​ໄດ້ ຂໍ​ສົງສານ​ພວກຂ້ານ້ອຍ ແລະ ຊ່ວຍ​ພວກຂ້ານ້ອຍ​ແດ່​ທ້ອນ”.<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />ພຣະເຢຊູເຈົ້າ​ກ່າວ​ວ່າ, “ ‘ຖ້າ​ສາມາດ​ຊ່ວຍ​ໄດ້’ ບໍ? ທຸກສິ່ງ​ເປັນ​ໄປ​ໄດ້​ສຳລັບ​ຜູ້​ທີ່​ເຊື່ອ”.<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />ໃນ​ທັນໃດ​ນັ້ນ ພໍ່​ຂອງ​ເດັກນ້ອຍ​ນັ້ນ​ໄດ້​ຮ້ອງ​ຕອບ​ທັນທີ​ວ່າ, “ຂ້ານ້ອຍ​ເຊື່ອ; ຂໍ​ຊ່ວຍ​ຂ້ານ້ອຍ​ໃຫ້​ມີ​ຄວາມເຊື່ອ​ຫລາຍກວ່າ​ນີ້​ແດ່​ທ້ອນ!”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />ເມື່ອ​ພຣະເຢຊູເຈົ້າ​ເຫັນ​ປະຊາຊົນ​ກຳລັງ​ບຸບຽດກັນ​ເຂົ້າ​ມາ​ໃກ້ ພຣະອົງ​ຈຶ່ງ​ສັ່ງ​ວິນຍານສົກກະປົກ, “ວິນຍານ​ປາກກືກ ແລະ ຫູໜວກ ເຮົາ​ສັ່ງ​ພວກເຈົ້າ​ໃຫ້​ອອກ​ຈາກ​ເດັກນ້ອຍ ແລະ ຢ່າ​ກັບ​ເຂົ້າ​ໄປ​ສິງ​ລາວ​ອີກ​ຈັກເທື່ອ”.<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />ຜີມານຮ້າຍ​ນັ້ນ​ແຜດສຽງ​ຂຶ້ນ ມັນ​ເຮັດ​ໃຫ້​ເດັກນ້ອຍ​ຊັກດິ້ນ​ຢ່າງ​ແຮງ ແລ້ວ​ກໍ​ອອກ​ໜີ​ໄປ. ເດັກນ້ອຍ​ນັ້ນ​ກາຍເປັນ​ເໝືອນ​ຄົນ​ຕາຍ ຈົນ​ຫລາຍ​ຄົນ​ທັງຫລາຍ​ເວົ້າ​ວ່າ, “ລາວ​ຕາຍ​ແລ້ວ”. <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />ແຕ່​ພຣະເຢຊູເຈົ້າ​ຈັບ​ມື​ເດັກນ້ອຍ ແລະ ດຶງ​ຂຶ້ນ ແລ້ວ​ລາວ​ກໍ​ລຸກຢືນ​ຂຶ້ນ.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />ຫລັງຈາກ​ທີ່​ພຣະເຢຊູເຈົ້າ​ເຂົ້າ​ໄປ​ໃນ​ເຮືອນ​ແລ້ວ, ພວກສາວົກ​ຂອງ​ພຣະອົງ​ກໍ​ຖາມ​ພຣະອົງ​ເປັນ​ການ​ສ່ວນໂຕ​ວ່າ, “ເປັນຫຍັງ​ພວກຂ້ານ້ອຍ​ຈຶ່ງ​ບໍ່​ສາມາດ​ຂັບໄລ່​ຜີມານຮ້າຍ​ນັ້ນ​ອອກ​ໄດ້?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />ພຣະອົງ​ຕອບ​ວ່າ, “ຜີຮ້າຍ​ແບບນີ້​ຈະ​ຂັບໄລ່​ອອກ​ດ້ວຍ​ວິທີ​ອື່ນ​ບໍ່​ໄດ້ ເວັ້ນໄວ້​ແຕ່​ດ້ວຍ​ການອະທິຖານ​ເທົ່ານັ້ນ<note caller="+" style="f"><char style="fr" closed="false">9:29 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ບາງ​ສະບັບ​ວ່າ </char><char style="fqa" closed="false">ອະທິຖານ ແລະ ອົດອາຫານ​ເທົ່ານັ້ນ</char></note>”.<verse eid="MRK 9:29" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ທຳນວາຍ​ກ່ຽວກັບ​ການຕາຍ​ຂອງ​ພຣະອົງ​ຄັ້ງ​ທີ​ສອງ</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />ພວກເພິ່ນ​ໄດ້​ຈາກ​ທີ່​ນັ້ນ ແລະ ຜ່ານ​ແຂວງ​ຄາລີເລ​ໄປ. ພຣະເຢຊູເຈົ້າ​ບໍ່​ຕ້ອງການ​ໃຫ້​ຜູ້ໃດ​ຮູ້​ບ່ອນ​ທີ່​ພວກເພິ່ນ​ຢູ່, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />ເພາະ​ພຣະອົງ​ກຳລັງ​ສັ່ງສອນ​ພວກສາວົກ​ຢູ່. ພຣະອົງ​ກ່າວ​ກັບ​ພວກເພິ່ນ​ວ່າ, “ບຸດມະນຸດ​ຈະ​ຖືກ​ມອບໄວ້​ໃນ​ມື​ຂອງ​ມະນຸດ. ພວກເຂົາ​ຈະ​ຂ້າ​ເພິ່ນ, ແລະ ຫລັງຈາກ​ສາມ​ວັນ​ພຣະອົງ​ຈະ​ເປັນຄືນມາຈາກຕາຍ”. <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />ແຕ່​ພວກເພິ່ນ​ບໍ່​ເຂົ້າໃຈ​ວ່າ​ພຣະອົງ​ໝາຍ​ເຖິງ​ສິ່ງ​ໃດ ແລະ ພວກເພິ່ນ​ກໍ​ຢ້ານ​ທີ່​ຈະ​ຖາມ​ພຣະອົງ​ເຖິງ​ເລື່ອງ​ນີ້.<verse eid="MRK 9:32" /></para>
  <para style="s1">ຜູ້ໃດ​ເປັນ​ໃຫຍ່​ທີ່ສຸດ?</para>
  <para style="r">(ມທ 18:1-5; ລກ 9:46-48)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />ເມື່ອ​ພວກເພິ່ນ​ມາ​ຮອດ​ເມືອງ​ກາເປນາອູມ. ຂະນະ​ທີ່​ພຣະອົງ​ຢູ່​ໃນ​ເຮືອນ ພຣະອົງ​ຖາມ​ພວກເພິ່ນ​ວ່າ, “ໃນ​ລະຫວ່າງ​ທາງ​ນັ້ນ ພວກເຈົ້າ​ໄດ້​ຖົກຖຽງກັນ​ເຖິງ​ເລື່ອງ​ຫຍັງ?” <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />ແຕ່​ພວກເພິ່ນ​ມິດ​ຢູ່ ເພາະ​ໃນ​ລະຫວ່າງ​ທາງ​ນັ້ນ​ພວກເພິ່ນ​ໄດ້​ຖົກຖຽງ​ກັນ​ວ່າ​ຜູ້ໃດ​ເປັນ​ໃຫຍ່​ທີ່ສຸດ.<verse eid="MRK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35" />ພຣະເຢຊູເຈົ້າ​ຈຶ່ງ​ນັ່ງ​ລົງ ແລ້ວ​ເອີ້ນ​ພວກສາວົກ​ທັງ​ສິບສອງ​ຄົນ​ມາ ແລະ ກ່າວ​ວ່າ, “ຖ້າ​ຜູ້ໃດ​ຢາກ​ເປັນ​ຜູ້ຕົ້ນ ຜູ້​ນັ້ນ​ຕ້ອງ​ເປັນ​ຜູ້ປາຍ ແລະ ເປັນ​ຜູ້ຮັບໃຊ້​ຂອງ​ຄົນ​ທັງຫລາຍ”.<verse eid="MRK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36" />ພຣະອົງ​ເອົາ​ເດັກນ້ອຍ​ຄົນ​ໜຶ່ງ​ມາ​ຢືນ​ຢູ່​ທ່າມກາງ​ພວກເພິ່ນ. ພຣະອົງ​ອຸ້ມ​ເດັກນ້ອຍ​ນັ້ນ​ໄວ້ ແລ້ວ​ກ່າວ​ກັບ​ພວກເພິ່ນ​ວ່າ, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“ຜູ້ໃດ​ກໍ​ຕາມ​ທີ່​ຕ້ອນຮັບ​ເດັກນ້ອຍ​ຄົນ​ໜຶ່ງ​ໃນ​ບັນດາ​ເດັກນ້ອຍ​ເຫລົ່ານີ້​ໄວ້​ໃນ​ນາມ​ຂອງ​ເຮົາ ຜູ້​ນັ້ນ​ກໍ​ບໍ່​ໄດ້​ຕ້ອນຮັບ​ເຮົາ​ເທົ່ານັ້ນ ແຕ່​ຍັງ​ຕ້ອນຮັບ​ພຣະອົງ​ຜູ້​ທີ່​ໄດ້​ໃຊ້​ເຮົາ​ມາ​ເໝືອນກັນ”.<verse eid="MRK 9:37" /></para>
  <para style="s1">ຜູ້ໃດ​ກໍ​ຕາມ​ທີ່​ບໍ່​ຕໍ່ສູ້​ພວກເຮົາ​ກໍ​ຢູ່​ຝ່າຍ​ພວກເຮົາ</para>
  <para style="r">(<ref loc="LUK 9:49">ລກ 9:49</ref>,<ref loc="LUK 9:50">50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />ໂຢຮັນ​ກ່າວ​ວ່າ, “ອາຈານ​ເອີຍ, ພວກຂ້ານ້ອຍ​ເຫັນ​ຊາຍ​ຄົນ​ໜຶ່ງ ຂັບໄລ່​ພວກ​ຜີມານຮ້າຍ​ອອກ​ໄດ້​ໃນ​ນາມ​ຂອງ​ທ່ານ ແລະ ພວກຂ້ານ້ອຍ​ຈຶ່ງ​ຫ້າມ​ລາວ, ເພາະ​ລາວ​ບໍ່​ໄດ້​ຢູ່​ໃນ​ກຸ່ມ​ຂອງ​ພວກເຮົາ”.<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />ພຣະເຢຊູເຈົ້າ​ໄດ້​ຕອບ​ວ່າ, “ຢ່າ​ຫ້າມ​ລາວ​ເລີຍ, ເພາະ​ບໍ່​ມີ​ຜູ້ໃດ​ທີ່​ເຮັດ​ການ​ອັດສະຈັນ​ໃນ​ນາມ​ຂອງ​ເຮົາ ແລະ ພາຍຫລັງ​ມາ​ຈະ​ເວົ້າ​ສິ່ງ​ທີ່​ບໍ່​ດີ​ກ່ຽວກັບ​ເຮົາ, <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />ເພາະ​ຜູ້ໃດ​ກໍ​ຕາມ​ທີ່​ບໍ່​ຕໍ່ສູ້​ພວກເຮົາ​ກໍ​ຢູ່​ຝ່າຍ​ພວກເຮົາ. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />ເຮົາ​ບອກ​ພວກເຈົ້າ​ຕາມ​ຄວາມຈິງ​ວ່າ, ຜູ້ໃດ​ທີ່​ເອົາ​ນ້ຳ​ຈອກ​ໜຶ່ງ​ໃຫ້​ພວກເຈົ້າ​ໃນ​ນາມ​ຂອງ​ເຮົາ ເພາະ​ພວກເຈົ້າ​ເປັນ​ຄົນ​ຂອງ​ພຣະຄຣິດເຈົ້າ ຜູ້​ນັ້ນ​ຈະ​ບໍ່​ຂາດ​ບຳເໜັດ​ຂອງ​ຕົນ”.<verse eid="MRK 9:41" /></para>
  <para style="s1">ຕົ້ນເຫດ​ໃຫ້​ເຮັດ​ບາບ</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“ຖ້າ​ຜູ້ໃດ​ເປັນຕົ້ນເຫດ​ພາ​ໃຫ້​ເດັກນ້ອຍ​ຄົນ​ໜຶ່ງ​ໃນ​ບັນດາ​ເດັກນ້ອຍ​ເຫລົ່ານີ້​ທີ່​ເຊື່ອ​ໃນ​ເຮົາ​ຕົກ​ໃນ​ບາບ ໃຫ້​ເອົາ​ຫີນໂມ້ແປ້ງ​ກ້ອນ​ໃຫຍ່​ຜູກ​ຄໍ​ຄົນ​ນັ້ນ​ແລ້ວ​ຖິ້ມ​ລົງ​ໃນ​ທະເລ​ເລິກ​ກໍ​ຍັງ​ດີ​ກວ່າ. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />ຖ້າ​ມື​ຂອງ​ເຈົ້າ​ເປັນຕົ້ນເຫດ​ພາ​ໃຫ້​ເຈົ້າ​ສະດຸດ, ກໍ​ຈົ່ງ​ຕັດ​ອອກ​ເສຍ. ຈະ​ເຂົ້າ​ສູ່​ຊີວິດ​ໂດຍ​ທີ່​ມີ​ມື​ເບື້ອງ​ດຽວ​ກໍ​ຍັງ​ດີ​ກວ່າ​ມີ​ມື​ທັງ​ສອງ​ເບື້ອງ​ແຕ່​ຕ້ອງ​ລົງ​ໄປ​ໃນ​ນະລົກ, ບ່ອນ​ທີ່​ໄຟ​ບໍ່​ມອດ​ຈັກ​ເທື່ອ.<note caller="+" style="f"><char style="fr" closed="false">9:43 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ບາງສະບັບ​ມີ​ຂໍ້</char></note> <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />ບ່ອນ​ທີ່ ‘ໂຕໜອນ​ຂອງ​ຄົນ​ເຫລົ່ານັ້ນ​ບໍ່​ມີ​ມື້​ຕາຍ ແລະ ໄຟ​ກໍ​ບໍ່​ຮູ້ຈັກ​ມອດ’ <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />ແລະ ຖ້າ​ຕີນ​ຂອງ​ເຈົ້າ​ເປັນຕົ້ນເຫດ​ພາ​ໃຫ້​ເຈົ້າ​ສະດຸດ, ກໍ​ຈົ່ງ​ຕັດ​ອອກ​ເສຍ. ຈະ​ເຂົ້າ​ສູ່​ຊີວິດ​ໂດຍ​ທີ່​ມີ​ຕີນ​ກຸດ​ເບື້ອງ​ດຽວ​ກໍ​ຍັງ​ດີ​ກວ່າ​ມີ​ຕີນ​ທັງ​ສອງ​ເບື້ອງ ແຕ່​ຕ້ອງ​ຖືກ​ໂຍນ​ຖິ້ມ​ລົງ​ນະລົກ.<note caller="+" style="f"><char style="fr" closed="false">9:45 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ບາງ​ສະບັບ​ມີ​ຂໍ້</char></note> <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />ບ່ອນ​ທີ່ ‘ໂຕໜອນ​ຂອງ​ຄົນ​ເຫລົ່ານັ້ນ​ບໍ່​ມີ​ມື້​ຕາຍ ແລະ ໄຟ​ກໍ​ບໍ່​ຮູ້ຈັກ​ມອດ’ <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />ແລະ ຖ້າ​ຕາ​ຂອງ​ເຈົ້າ​ເປັນຕົ້ນເຫດ​ພາ​ໃຫ້​ເຈົ້າ​ສະດຸດ, ຈົ່ງ​ຄວັດ​ຕາ​ນັ້ນ​ອອກ​ຖິ້ມ​ເສຍ. ຈະ​ເຂົ້າ​ສູ່​ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ​ໂດຍ​ທີ່​ມີ​ຕາ​ເບື້ອງ​ດຽວ​ກໍ​ຍັງ​ດີ​ກວ່າ​ມີ​ຕາ​ທັງ​ສອງ​ເບື້ອງ​ແຕ່​ຕ້ອງ​ຖືກ​ໂຍນ​ລົງ​ໄປ​ໃນ​ນະລົກ, <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />ບ່ອນ​ທີ່</para>
  <para style="q1" vid="MRK 9:48">“ ‘ໂຕໜອນ​ທີ່​ກັດ​ກິນ​ຄົນ​ເຫລົ່ານັ້ນ​ບໍ່​ມີ​ມື້​ຕາຍ,</para>
  <para style="q2" vid="MRK 9:48">ແລະ ໄຟ​ກໍ​ບໍ່​ຮູ້​ມອດ​ຈັກ​ເທື່ອ’.<note caller="+" style="f"><char style="fr" closed="false">9:48 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 66:24">ອຊຢ 66:24</ref></char></char></note><verse eid="MRK 9:48" /></para>
  <para style="m">
    <verse number="49" style="v" sid="MRK 9:49" />ທຸກຄົນ​ຈະ​ຕ້ອງ​ຖືກ​ເອືອບ​ດ້ວຍ​ເກືອ​ແລ້ວ​ຊຳລະ​ດ້ວຍ​ໄຟ.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />“ເກືອ​ເປັນ​ຂອງ​ດີ, ແຕ່​ຖ້າ​ເກືອ​ໝົດ​ຄວາມເຄັມ​ແລ້ວ​ພວກເຈົ້າ​ຈະ​ເຮັດ​ໃຫ້​ກັບຄືນ​ມາ​ເຄັມ​ອີກ​ໄດ້​ຢ່າງໃດ? ພວກເຈົ້າ​ທັງຫລາຍ​ຈົ່ງ​ມີ​ເກືອ​ໃນ​ໂຕ ແລະ ຢູ່​ຮ່ວມກັນ​ຢ່າງ​ສະຫງົບສຸກ”.<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s1">ການ​ຢ່າຮ້າງ</para>
  <para style="r">(ມທ 19:1-9)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />ຕໍ່ມາ ພຣະເຢຊູເຈົ້າ​ກໍ​ອອກຈາກ​ທີ່​ນັ້ນ​ໄປ​ຍັງ​ແຂວງ​ຢູດາຍ ແລ້ວ​ພຣະອົງ​ກໍ​ຂ້າມ​ແມ່ນ້ຳຈໍແດນ​ທາງ​ຟາກ​ເບື້ອງ​ນັ້ນ. ມີ​ປະຊາຊົນ​ຈໍານວນ​ຫລວງຫລາຍ​ໄດ້​ມາ​ຫາ​ພຣະອົງ​ອີກ, ແລະ ພຣະອົງ​ກໍ​ໄດ້​ສັ່ງສອນ​ພວກເຂົາ​ເໝືອນດັ່ງ​ທີ່​ພຣະອົງ​ເຄີຍ​ເຮັດ​ມາ.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />ພວກ​ຟາຣີຊາຍ​ບາງຄົນ​ໄດ້​ມາ​ທົດລອງ​ພຣະອົງ​ໂດຍ​ຖາມ​ພຣະອົງ​ວ່າ, “ເປັນ​ການ​ຖືກຕ້ອງ​ຕາມ​ກົດບັນຍັດ​ທີ່​ຜູ້ຊາຍ​ຈະ​ຢ່າຮ້າງ​ເມຍ​ຂອງ​ຕົນ​ແມ່ນ​ບໍ?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />ພຣະເຢຊູເຈົ້າ​ຕອບ​ພວກເຂົາ​ວ່າ, “ໂມເຊ​ໄດ້​ໃຫ້​ຂໍ້​ຄຳສັ່ງ​ໄວ້​ຢ່າງ​ໃດ?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />ພວກເຂົາ​ຕອບ​ວ່າ, “ໂມເຊ​ໄດ້​ອະນຸຍາດ​ໃຫ້​ຜູ້ຊາຍ​ຂຽນ​ໜັງສື​ຢັ້ງຢືນ​ການຢ່າຮ້າງ ແລະ ສົ່ງ​ນາງ​ໜີ​ໄປ”.<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />ພຣະເຢຊູເຈົ້າ​ຕອບ​ພວກເຂົາ​ວ່າ, “ເພາະ​ໃຈ​ຂອງ​ພວກເຈົ້າ​ທັງຫລາຍ​ແຂງກະດ້າງ ໂມເຊ​ຈຶ່ງ​ໄດ້​ຂຽນ​ກົດບັນຍັດ​ຂໍ້​ນີ້​ໃຫ້​ພວກເຈົ້າ. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />ຕັ້ງແຕ່​ເລີ່ມຕົ້ນ​ທີ່​ສ້າງ​ໂລກ​ນັ້ນ ພຣະເຈົ້າ ‘ໄດ້​ສ້າງ​ພວກເຂົາ​ໃຫ້​ເປັນ​ຊາຍ ແລະ ຍິງ’.<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 1:27">ປຖກ 1:27</ref></char></char></note> <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />‘ດ້ວຍ​ເຫດ​ນີ້ ຜູ້ຊາຍ​ຈຶ່ງ​ອອກ​ຈາກ​ພໍ່ແມ່​ຂອງ​ຕົນ ແລະ ໄປ​ຜູກພັນ​ຢູ່​ກັບ​ເມຍ<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ໃນ​ຍຸກ​ທຳອິດ​ບາງ​ສະບັບ​ບໍ່​ມີ​ຄຳ​ວ່າ </char><char style="fqa" closed="false">ໄປ​ຜູກພັນ​ເປັນ​ໜຶ່ງ​ດຽວ​ກັບ​ເມຍ</char></note>​ຂອງ​ຕົນ <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />ແລະ ພວກເຂົາ​ທັງ​ສອງ​ກໍ​ເປັນ​ກາຍ​ດຽວ​ກັນ’.<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:24">ປຖກ 2:24</ref></char></char></note> ດັ່ງນັ້ນ, ພວກເຂົາ​ຈຶ່ງ​ບໍ່​ໄດ້​ເປັນ​ສອງ​ອີກ​ຕໍ່ໄປ ແຕ່​ເປັນ​ກາຍ​ດຽວ​ກັນ. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />ເຫດສະນັ້ນ ສິ່ງ​ທີ່​ພຣະເຈົ້າ​ໄດ້​ໃຫ້​ເຂົ້າຮ່ວມກັນ​ແລ້ວ ຢ່າ​ໃຫ້​ມະນຸດ​ເຮັດ​ໃຫ້​ພາກ​ຈາກ​ກັນ”.<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />ເມື່ອ​ພວກເພິ່ນ​ກັບ​ເຂົ້າ​ໄປ​ໃນ​ເຮືອນ​ອີກ, ພວກສາວົກ​ກໍ​ໄດ້​ຖາມ​ພຣະເຢຊູເຈົ້າ​ກ່ຽວກັບ​ເລື່ອງ​ນີ້. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />ພຣະອົງ​ຈຶ່ງ​ຕອບ​ວ່າ, “ຜູ້ໃດ​ທີ່​ຢ່າຮ້າງ​ເມຍ​ຂອງ​ຕົນ​ແລ້ວ​ໄປ​ແຕ່ງງານ​ກັບ​ຍິງ​ອື່ນ ຜູ້​ນັ້ນ​ກໍ​ຫລິ້ນຊູ້. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />ແລະ ຖ້າ​ນາງ​ຢ່າຮ້າງ​ຜົວ​ຂອງ​ຕົນ​ແລ້ວ​ໄປ​ແຕ່ງງານ​ກັບ​ຊາຍ​ອື່ນ ນາງ​ກໍ​ຫລິ້ນຊູ້”.<verse eid="MRK 10:12" /></para>
  <para style="s1">ເດັກນ້ອຍ ແລະ ພຣະເຢຊູເຈົ້າ</para>
  <para style="r">(ມທ 19:13-15; ລກ 18:15-17)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />ປະຊາຊົນ​ໄດ້​ນໍາ​ເດັກນ້ອຍ​ມາ​ຫາ​ພຣະເຢຊູເຈົ້າ​ເພື່ອ​ໃຫ້​ພຣະອົງ​ວາງມື​ໃສ່​ພວກເຂົາ, ແຕ່​ພວກສາວົກ​ໄດ້​ຫ້າມ​ພວກເຂົາ​ໄວ້. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />ເມື່ອ​ພຣະເຢຊູເຈົ້າ​ເຫັນ​ດັ່ງນັ້ນ, ພຣະອົງ​ກໍ​ບໍ່​ພໍໃຈ​ຈຶ່ງ​ກ່າວ​ແກ່​ພວກສາວົກ​ວ່າ, “ຈົ່ງ​ປ່ອຍ​ໃຫ້​ເດັກນ້ອຍ​ເຫລົ່ານັ້ນ​ມາ​ຫາ​ເຮົາ, ແລະ ຢ່າ​ຂັດຂວາງ​ພວກເຂົາ, ເພາະ​ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ​ເປັນ​ຂອງ​ຄົນ​ທີ່​ເປັນ​ເໝືອນ​ເດັກນ້ອຍ​ເຫລົ່ານີ້​ແຫລະ. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />ເຮົາ​ບອກ​ພວກເຈົ້າ​ຕາມ​ຄວາມຈິງ​ວ່າ, ຜູ້ໃດ​ບໍ່​ຮັບ​ເອົາ​ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ​ເໝືອນດັ່ງ​ເດັກນ້ອຍ ຜູ້​ນັ້ນ​ຈະ​ເຂົ້າ​ໄປ​ໃນ​ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ​ບໍ່​ໄດ້​ຈັກ​ເທື່ອ”. <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />ແລ້ວ​ພຣະອົງ​ກໍ​ໄດ້​ອູ້ມ​ເດັກນ້ອຍ​ໄວ້​ໃນ​ແຂນ​ຂອງ​ພຣະອົງ, ວາງ​ມື​ຂອງ​ພຣະອົງ​ເທິງ​ພວກເຂົາ ແລະ ອວຍພອນ​ພວກເຂົາ.<verse eid="MRK 10:16" /></para>
  <para style="s1">ເສດຖີ ແລະ ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ</para>
  <para style="r">(ມທ 19:16-30; ລກ 18:18-30)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />ເມື່ອ​ພຣະເຢຊູເຈົ້າ​ອອກ​ເດີນທາງ​ຕໍ່​ໄປ, ມີ​ຊາຍ​ຄົນ​ໜຶ່ງ​ແລ່ນ​ມາ​ຫາ​ພຣະອົງ ແລະ ຄຸເຂົ່າ​ລົງ​ຕໍ່ໜ້າ​ພຣະອົງ​ແລ້ວ​ຖາມ​ວ່າ, “ອາຈານ​ຜູ້​ປະເສີດ​ເອີຍ, ຂ້ານ້ອຍ​ຕ້ອງ​ເຮັດ​ຢ່າງໃດ​ຈຶ່ງ​ຈະ​ໄດ້​ຊີວິດ​ນິລັນດອນ?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />ພຣະເຢຊູເຈົ້າ​ຕອບ​ວ່າ, “ເປັນຫຍັງ​ເຈົ້າ​ຈຶ່ງ​ເອີ້ນ​ເຮົາ​ວ່າ​ຜູ້ປະເສີດ? ບໍ່​ມີ​ຜູ້ໃດ​ທີ່​ປະເສີດ​ນອກ​ຈາກ​ພຣະເຈົ້າ​ອົງ​ດຽວ​ເທົ່ານັ້ນ. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />ເຈົ້າ​ກໍ​ຮູ້ຈັກ​ພຣະບັນຍັດ​ແລ້ວ​ວ່າ, ‘ຢ່າ​ຂ້າ​ຄົນ, ຢ່າ​ຫລິ້ນຊູ້, ຢ່າ​ລັກ, ຢ່າ​ເປັນ​ພະຍານ​ບໍ່​ຈິງ, ຢ່າ​ສໍ້ໂກງ, ຈົ່ງ​ໃຫ້​ກຽດ​ພໍ່ ແລະ ແມ່​ຂອງ​ຕົນ’<note caller="+" style="f"><char style="fr" closed="false">10:19 </char><char style="ft" closed="false"><char style="xt">ອພຍ 20:12-16; ພບຍ 5:16-20</char></char></note>”.<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />ຊາຍ​ຄົນ​ນັ້ນ​ໄດ້​ຕອບ​ວ່າ, “ອາຈານ​ເອີຍ, ທັງໝົດ​ເຫລົ່ານີ້ ຂ້ານ້ອຍ​ໄດ້​ຖື​ຮັກສາ​ຕັ້ງ​ແຕ່​ເປັນ​ເດັກນ້ອຍ”.<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />ພຣະເຢຊູເຈົ້າ​ແນມເບິ່ງ​ລາວ​ດ້ວຍ​ຄວາມຮັກ ແລະ ກ່າວ​ວ່າ, “ເຈົ້າ​ຍັງ​ຂາດ​ຢູ່​ສິ່ງ​ໜຶ່ງ​ຄື: ຈົ່ງ​ໄປ, ຂາຍ​ທຸກສິ່ງ​ທີ່​ເຈົ້າ​ມີ​ຢູ່ ແລະ ແຈກຢາຍ​ໃຫ້​ແກ່​ຄົນຍາກຈົນ, ແລ້ວ​ເຈົ້າ​ຈະ​ມີ​ຊັບສົມບັດ​ໃນ​ສະຫວັນ. ຫລັງຈາກນັ້ນ ຈົ່ງ​ຕາມ​ເຮົາ​ມາ”.<verse eid="MRK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22" />ເມື່ອ​ໄດ້​ຍິນ​ດັ່ງນັ້ນ​ໜ້າ​ຂອງ​ລາວ​ກໍ​ເສົ້າ​ລົງ. ລາວ​ຈາກ​ໄປ​ດ້ວຍ​ຄວາມທຸກໃຈ ເພາະ​ລາວ​ເປັນ​ຄົນຮັ່ງມີ​ຫລາຍ.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />ພຣະເຢຊູເຈົ້າ​ແນມເບິ່ງ​ອ້ອມຮອບ​ແລ້ວ​ກ່າວ​ກັບ​ພວກສາວົກ​ວ່າ, “ມັນ​ຍາກ​ແທ້​ທີ່​ຄົນຮັ່ງມີ​ຈະ​ເຂົ້າ​ໄປ​ໃນ​ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ!”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />ພວກສາວົກ​ຕ່າງ​ກໍ​ປະຫລາດໃຈ​ໃນ​ຄຳເວົ້າ​ຂອງ​ພຣະອົງ. ແຕ່​ພຣະເຢຊູເຈົ້າ​ໄດ້​ກ່າວ​ອີກ​ວ່າ, “ລູກ​ເອີຍ, ຍາກ​ຫລາຍ<note caller="+" style="f"><char style="fr" closed="false">10:24 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ບາງ​ສະບັບ​ເພີ່ມ​ຂໍ້​ຄວາມ​ວ່າ </char><char style="fqa" closed="false">ສຳລັບ​ຜູ້​ທີ່​ວາງໃຈ​ໃນ​ຊັບສົມບັດ</char></note>​ທີ່​ຈະ​ເຂົ້າ​ໄປ​ໃນ​ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />ໃຫ້​ອູດ​ໂຕ​ໜຶ່ງ​ລອດ​ຮູ​ເຂັມ​ຍັງ​ງ່າຍ​ກວ່າ​ຄົນຮັ່ງມີ​ຜູ້​ໜຶ່ງ​ຈະ​ເຂົ້າ​ໄປ​ໃນ​ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ”.<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />ພວກສາວົກ​ກໍ​ຍິ່ງ​ປະຫລາດ​ໃຈ​ຫລາຍ​ຂຶ້ນ ຈຶ່ງ​ເວົ້າ​ກັນ​ວ່າ, “ຖ້າ​ຢ່າງ​ນັ້ນ ຜູ້ໃດ​ສາມາດ​ພົ້ນ​ໄດ້?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />ພຣະເຢຊູເຈົ້າ​ແນມເບິ່ງ​ພວກເພິ່ນ ແລະ ກ່າວ​ວ່າ, “ສຳລັບ​ມະນຸດ​ກໍ​ເປັນ​ໄປ​ບໍ່​ໄດ້ ແຕ່​ສຳລັບ​ພຣະເຈົ້າ​ທຸກສິ່ງ​ເປັນ​ໄປ​ໄດ້”.<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />ແລ້ວ​ເປໂຕ​ກໍ​ກ່າວ​ຂຶ້ນ​ວ່າ, “ພວກຂ້ານ້ອຍ​ໄດ້​ປະຖິ້ມ​ທຸກ​ສິ່ງ​ເພື່ອ​ຕິດຕາມ​ພຣະອົງ!”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />ພຣະເຢຊູເຈົ້າ​ຕອບ​ວ່າ, “ເຮົາ​ບອກ​ພວກເຈົ້າ​ຕາມ​ຄວາມຈິງ​ວ່າ, ຜູ້ໃດ​ທີ່​ໄດ້​ປະຖິ້ມ​ເຮືອນ ຫລື ອ້າຍ​ເອື້ອຍ​ນ້ອງ ຫລື ພໍ່ແມ່ ຫລື ລູກ ຫລື ໄຮ່ນາ​ຂອງ​ຕົນ​ເພື່ອ​ເຮົາ ແລະ ເພື່ອ​ຂ່າວປະເສີດ <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />ຜູ້​ນັ້ນ​ຈະ​ໄດ້​ຮັບ​ຜົນຕອບແທນ​ຮ້ອຍ​ເທົ່າ​ໃນ​ຍຸກ​ນີ້​ຄື: ເຮືອນ, ອ້າຍ​ເອື້ອຍ​ນ້ອງ, ພໍ່ແມ່, ລູກ, ໄຮ່ນາ, ລວມ​ທັງ​ການຂົ່ມເຫັງ ແລະ ໃນ​ຍຸກ​ໜ້າ​ຈະ​ໄດ້​ຊີວິດ​ນິລັນດອນ. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />ແຕ່​ມີ​ຫລາຍ​ຄົນ​ທີ່​ເປັນ​ຜູ້ຕົ້ນ​ຈະ​ກັບ​ເປັນ​ຜູ້ປາຍ ແລະ ຜູ້ປາຍ​ຈະ​ກັບ​ເປັນ​ຜູ້ຕົ້ນ”.<verse eid="MRK 10:31" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ທຳນວາຍ​ການຕາຍ​ຂອງ​ພຣະອົງ​ຄັ້ງ​ທີສາມ</para>
  <para style="r">(ມທ 20:17-19; ລກ 18:31-33)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />ພວກເພິ່ນ​ກຳລັງ​ເດີນທາງ​ຂຶ້ນ​ໄປ​ນະຄອນ​ເຢຣູຊາເລັມ, ໂດຍ​ມີ​ພຣະເຢຊູເຈົ້າ​ນຳໜ້າ​ພວກເພິ່ນ​ໄປ, ແລະ ພວກສາວົກ​ກໍ​ພາກັນ​ປະຫລາດໃຈ, ສ່ວນ​ຄົນ​ທີ່​ມາ​ຕາມຫລັງ​ນັ້ນ​ຕ່າງ​ກໍ​ມີ​ຄວາມຢ້ານ. ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ກໍ​ພາ​ພວກສາວົກ​ທັງ​ສິບສອງ​ຄົນ​ແຍກ​ອອກ​ໄປ​ຕ່າງຫາກ​ອີກ ແລະ ກ່າວ​ເຖິງ​ສິ່ງ​ທີ່​ກຳລັງ​ຈະ​ເກີດຂຶ້ນ​ກັບ​ພຣະອົງ​ວ່າ, <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />“ພວກເຮົາ​ກຳລັງ​ຂຶ້ນ​ໄປ​ນະຄອນ​ເຢຣູຊາເລັມ ແລະ ບຸດມະນຸດ​ຈະ​ຖືກ​ມອບ​ໄວ້​ກັບ​ພວກຫົວໜ້າ​ປະໂລຫິດ ແລະ ພວກ​ຄູສອນກົດບັນຍັດ. ພວກເຂົາ​ຈະ​ລົງໂທດ​ພຣະອົງ​ໃຫ້​ເຖິງ​ຕາຍ ແລະ ຈະ​ມອບ​ພຣະອົງ​ໃຫ້​ກັບ​ຄົນຕ່າງຊາດ, <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />ພວກເຂົາ​ຈະ​ເຢາະເຢີ້ຍ​ພຣະອົງ ແລະ ຈະ​ຖົ່ມ​ນ້ຳລາຍ​ໃສ່​ພຣະອົງ, ຈະ​ຂ້ຽນຕີ​ພຣະອົງ ແລະ ຈະ​ຂ້າ​ພຣະອົງ. ສາມ​ວັນ​ຕໍ່ມາ​ພຣະອົງ​ຈະ​ເປັນຄືນມາ”.<verse eid="MRK 10:34" /></para>
  <para style="s1">ຄຳຂໍ​ຂອງ​ຢາໂກໂບ ແລະ ໂຢຮັນ</para>
  <para style="r">(ມທ 20:20-28)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />ແລ້ວ​ຢາໂກໂບ ແລະ ໂຢຮັນ​ລູກຊາຍ​ຂອງ​ເຊເບດາຍ​ໄດ້​ມາ​ຫາ​ພຣະເຢຊູເຈົ້າ ແລະ ເວົ້າ​ວ່າ, “ອາຈານ​ເອີຍ, ພວກຂ້ານ້ອຍ​ຢາກ​ໃຫ້​ທ່ານ​ເຮັດ​ຕາມ​ຄຳຂໍ​ຂອງ​ພວກຂ້ານ້ອຍ”.<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />ພຣະເຢຊູເຈົ້າ​ຖາມ​ພວກເພິ່ນ​ວ່າ, “ພວກເຈົ້າ​ຕ້ອງການ​ໃຫ້​ເຮົາ​ເຮັດ​ຫຍັງ​ໃຫ້​ພວກເຈົ້າ?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />ພວກເພິ່ນ​ຕອບ​ວ່າ, “ເມື່ອ​ພຣະອົງ​ໄດ້​ຮັບ​ສະຫງ່າລາສີ ຂໍ​ໃຫ້​ພວກຂ້ານ້ອຍ​ໄດ້​ນັ່ງ​ທີ່​ເບື້ອງຂວາ​ຂອງ​ພຣະອົງ ແລະ ອີກ​ຄົນ​ໜຶ່ງ​ນັ່ງ​ທີ່​ເບື້ອງຊ້າຍ​ຂອງ​ພຣະອົງ”.<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />ພຣະເຢຊູເຈົ້າ​ກ່າວ​ແກ່​ພວກເພິ່ນ​ວ່າ, “ພວກເຈົ້າ​ບໍ່​ຮູ້ຈັກ​ໃນ​ສິ່ງ​ທີ່​ພວກເຈົ້າ​ກຳລັງ​ຂໍ​ນັ້ນ ຈອກ​ທີ່​ເຮົາ​ຈະ​ດື່ມ​ນັ້ນ​ພວກເຈົ້າ​ຈະ​ດື່ມ​ໄດ້​ບໍ? ແລະ ບັບຕິສະມາ​ທີ່​ເຮົາ​ຮັບ​ນັ້ນ​ພວກເຈົ້າ​ຈະ​ຮັບ​ໄດ້​ບໍ?”<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />ພວກເພິ່ນ​ຕອບ​ວ່າ, “ໄດ້​ພຣະອົງ​ເຈົ້າ”.</para>
  <para style="p" vid="MRK 10:39">ພຣະເຢຊູເຈົ້າ​ກ່າວ​ແກ່​ພວກເພິ່ນ​ວ່າ, “ພວກເຈົ້າ​ຈະ​ໄດ້​ດື່ມ​ຈາກ​ຈອກ​ທີ່​ເຮົາ​ດື່ມ​ແທ້ ແລະ ບັບຕິສະມາ​ທີ່​ເຮົາ​ຮັບ ພວກເຈົ້າ​ກໍ​ຕ້ອງ​ໄດ້​ຮັບ​ແທ້, <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />ແຕ່​ການ​ນັ່ງ​ທີ່​ເບື້ອງຂວາ ຫລື ເບື້ອງຊ້າຍ​ຂອງ​ເຮົາ​ນັ້ນ​ບໍ່​ແມ່ນ​ເຮົາ​ຈະ​ເປັນ​ຜູ້​ອະນຸຍາດ. ບ່ອນ​ເຫລົ່ານັ້ນ​ເປັນ​ຂອງ​ບັນດາ​ຜູ້​ທີ່​ໄດ້​ຖືກ​ຈັດຕຽມ​ໄວ້​ແລ້ວ”.<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />ເມື່ອ​ສາວົກ​ອີກ​ສິບ​ຄົນ​ໄດ້​ຍິນ​ເຖິງ​ເລື່ອງ​ນີ້​ແລ້ວ ພວກເພິ່ນ​ກໍ​ບໍ່​ພໍໃຈ​ກັບ​ຢາໂກໂບ ແລະ ໂຢຮັນ. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />ພຣະເຢຊູເຈົ້າ​ຈຶ່ງ​ເອີ້ນ​ພວກສາວົກ​ມາ​ພ້ອມໜ້າ​ກັນ ແລະ ກ່າວ​ວ່າ, “ພວກເຈົ້າ​ທັງຫລາຍ​ຕ່າງ​ກໍ​ຮູ້​ດີ​ວ່າ​ບັນດາ​ຜູ້​ທີ່​ຖື​ວ່າ​ເປັນ​ຜູ້ປົກຄອງ​ຂອງ​ຄົນຕ່າງຊາດ​ຍ່ອມ​ເປັນ​ນາຍ​ເໜືອ​ພວກເຂົາ ແລະ ເຈົ້າໜ້າທີ່​ຊັ້ນໃຫຍ່​ກໍ​ໃຊ້​ສິດອຳນາດ​ເໜືອ​ພວກເຂົາ. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />ແຕ່​ສຳລັບ​ພວກເຈົ້າ​ບໍ່​ເປັນ​ດັ່ງນັ້ນ ກົງກັນຂ້າມ, ຖ້າ​ຜູ້ໃດ​ໃນ​ພວກເຈົ້າ​ຢາກ​ເປັນ​ໃຫຍ່ ຜູ້​ນັ້ນ​ຕ້ອງ​ເປັນ​ຜູ້ຮັບໃຊ້​ພວກເຈົ້າ​ທັງຫລາຍ, <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />ແລະ ຖ້າ​ຜູ້ໃດ​ໃນ​ພວກເຈົ້າ​ຢາກ​ເປັນ​ເອກ ຜູ້​ນັ້ນ​ຕ້ອງ​ເປັນ​ຜູ້ຮັບໃຊ້​ຂອງ​ທຸກຄົນ. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />ເພາະ​ແມ່ນ​ແຕ່​ບຸດມະນຸດ​ບໍ່​ໄດ້​ມາ​ເພື່ອ​ໃຫ້​ຄົນ​ອື່ນ​ຮັບໃຊ້, ແຕ່​ມາ​ເພື່ອ​ຮັບໃຊ້, ແລະ ສະຫລະ​ຊີວິດ​ຂອງ​ພຣະອົງ​ເປັນ​ຄ່າໄຖ່​ເພື່ອ​ຄົນ​ທັງຫລາຍ”.<verse eid="MRK 10:45" /></para>
  <para style="s1">ຊາຍ​ຕາບອດ​ຊື່​ວ່າ​ບາຣະຕີມາຍ​ເບິ່ງ​ເຫັນ​ໄດ້</para>
  <para style="r">(ມທ 20:29-34; ລກ 18:35-43)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />ຫລັງຈາກ​ນັ້ນ ພວກເພິ່ນ​ກໍ​ມາ​ຮອດ​ເມືອງ​ເຢຣິໂກ. ຂະນະ​ທີ່​ພຣະເຢຊູເຈົ້າ ແລະ ພວກສາວົກ​ຂອງ​ພຣະອົງ​ພ້ອມ​ກັບ​ປະຊາຊົນ​ກຸ່ມ​ໃຫຍ່​ກຳລັງ​ຈະ​ອອກຈາກ​ເມືອງ, ມີ​ຊາຍ​ຕາບອດ​ຄົນ​ໜຶ່ງ​ຊື່​ວ່າ​ບາຣະຕີມາຍ (ທີ່​ເປັນ​ລູກຊາຍ​ຂອງ​ຕີມາຍ) ນັ່ງ​ຂໍທານ​ຢູ່​ແຄມທາງ. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />ເມື່ອ​ລາວ​ໄດ້​ຍິນ​ວ່າ​ພຣະເຢຊູເຈົ້າ​ຊາວ​ນາຊາເຣັດ​ກຳລັງ​ມາ​ໃກ້, ລາວ​ກໍ​ຮ້ອງສຽງດັງ​ຂຶ້ນ​ວ່າ, “ພຣະເຢຊູເຈົ້າ ບຸດ​ດາວິດ, ຂໍ​ເມດຕາ​ຂ້ານ້ອຍ​ດ້ວຍ!”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />ມີ​ຫລາຍ​ຄົນ​ໄດ້​ຫ້າມ​ໄວ້ ແລະ ບອກ​ລາວ​ໃຫ້​ມິດ​ຢູ່, ແຕ່​ລາວ​ຍິ່ງ​ຮ້ອງ​ດັງ​ຂຶ້ນ​ກວ່າ​ເກົ່າ​ວ່າ, “ບຸດ​ດາວິດ​ເອີຍ, ຂໍ​ເມດຕາ​ຂ້ານ້ອຍ​ດ້ວຍ!”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />ພຣະເຢຊູເຈົ້າ​ຈຶ່ງ​ຢຸດ ແລະ ກ່າວ​ວ່າ, “ຈົ່ງ​ເອີ້ນ​ລາວ​ມາ”.</para>
  <para style="p" vid="MRK 10:49">ດັ່ງນັ້ນ ພວກເຂົາ​ຈຶ່ງ​ໄປ​ເອີ້ນ​ເອົາ​ຊາຍ​ຕາບອດ​ນັ້ນ​ມາ ແລະ ເວົ້າ​ວ່າ, “ຈົ່ງ​ດີໃຈ! ແລະ ລຸກຂຶ້ນ! ພຣະອົງ​ກຳລັງ​ເອີ້ນ​ເຈົ້າ”. <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />ລາວ​ຈຶ່ງ​ໂຍນ​ເສື້ອຄຸມ​ຂອງ​ຕົນ​ຖິ້ມ ແລ້ວ​ຟ້າວ​ກະໂດດ​ໄປ​ຫາ​ພຣະເຢຊູເຈົ້າ.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />ພຣະອົງ​ຖາມ​ລາວ​ວ່າ, “ເຈົ້າ​ຕ້ອງການ​ໃຫ້​ເຮົາ​ເຮັດ​ຫຍັງ​ໃຫ້​ເຈົ້າ?”</para>
  <para style="p" vid="MRK 10:51">ລາວ​ຈຶ່ງ​ຕອບ​ວ່າ, “ອາຈານ​ເອີຍ, ຂ້ານ້ອຍ​ຢາກ​ເບິ່ງ​ເຫັນ”.<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />ພຣະເຢຊູເຈົ້າ​ກ່າວ​ວ່າ, “ໄປ​ສາ, ຄວາມເຊື່ອ​ຂອງ​ເຈົ້າ​ເຮັດ​ໃຫ້​ເຈົ້າ​ຫາຍດີ​ແລ້ວ”. ໃນທັນໃດນັ້ນ​ລາວ​ກໍ​ເຫັນຮຸ່ງ ແລະ ຕິດຕາມ​ພຣະເຢຊູເຈົ້າ​ໄປ​ຕາມ​ທາງ.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ເຂົ້າ​ສູ່​ນະຄອນ​ເຢຣູຊາເລັມ​ຢ່າງ​ຜູ້ມີໄຊ</para>
  <para style="r">(ມທ 21:1-9; ລກ 19:29-38; ຢຮ 12:12-15)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />ເມື່ອ​ພຣະເຢຊູເຈົ້າ ແລະ ພວກສາວົກ​ເຂົ້າ​ມາ​ໃກ້​ນະຄອນ​ເຢຣູຊາເລັມ​ແລ້ວ ກໍ​ມາ​ຮອດ​ບ້ານ​ເບັດຟາເຄ ແລະ ບ້ານ​ເບັດທານີ​ທີ່​ພູເຂົາ​ໝາກກອກ, ພຣະເຢຊູເຈົ້າ​ໄດ້​ໃຊ້​ສາວົກ​ສອງ​ຄົນ​ຂອງ​ພຣະອົງ​ລ່ວງໜ້າ​ໄປ​ກ່ອນ, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />ໂດຍ​ສັ່ງ​ພວກເພິ່ນ​ວ່າ, “ຈົ່ງ​ໄປ​ໃນ​ບ້ານ​ທີ່​ຢູ່​ຕໍ່ໜ້າ​ພວກເຈົ້າ​ນັ້ນ ເມື່ອ​ເຂົ້າ​ໄປ​ແລ້ວ​ພວກເຈົ້າ​ຈະ​ພົບ​ລໍນ້ອຍ​ໂຕ​ໜຶ່ງ​ທີ່​ຖືກ​ມັດ​ຢູ່ ເຊິ່ງ​ຍັງ​ບໍ່​ເຄີຍ​ມີ​ຜູ້ໃດ​ໄດ້​ຂຶ້ນ​ຂີ່​ຈັກ​ເທື່ອ. ຈົ່ງ​ແກ້​ເຊືອກ​ອອກ ແລ້ວ​ຈູງ​ມາ​ທີ່​ນີ້. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />ຖ້າ​ມີ​ຜູ້ໃດ​ຖາມ​ວ່າ, ‘ເປັນຫຍັງ​ຈຶ່ງ​ເຮັດ​ແນວ​ນີ້?’ ຈົ່ງ​ບອກ​ວ່າ, ‘ອົງພຣະຜູ້ເປັນເຈົ້າ​ຕ້ອງການ ແລະ ບໍ່​ດົນ​ກໍ​ຈະ​ສົ່ງ​ມັນ​ຄືນ​ມາ​ບ່ອນ​ນີ້’ ”.<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />ແລ້ວ​ພວກສາວົກ​ທັງ​ສອງ​ຈຶ່ງ​ໄປ ແລະ ກໍ​ພົບ​ລໍນ້ອຍ​ໂຕ​ໜຶ່ງ​ຢູ່​ແຄມທາງ​ທີ່​ຖືກ​ມັດ​ໄວ້​ຢູ່​ໃກ້​ປະຕູເຮືອນ. ຂະນະ​ທີ່​ພວກເພິ່ນ​ກຳລັງ​ແກ້ເຊືອກ​ຢູ່​ນັ້ນ, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />ມີ​ບາງຄົນ​ທີ່​ຢືນ​ຢູ່​ໃນ​ທີ່​ນັ້ນ​ຖາມ​ວ່າ, “ພວກເຈົ້າ​ກຳລັງ​ເຮັດ​ຫຍັງ? ພວກເຈົ້າ​ແກ້ເຊືອກ​ເອົາ​ລໍນ້ອຍ​ນັ້ນ​ໄປ​ເຮັດ​ຫຍັງ?” <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />ພວກເພິ່ນ​ຈຶ່ງ​ຕອບ​ຕາມ​ທີ່​ພຣະເຢຊູເຈົ້າ​ໄດ້​ສັ່ງ​ໄວ້, ແລ້ວ​ຄົນ​ເຫລົ່ານັ້ນ​ຈຶ່ງ​ຍອມ​ໃຫ້​ພວກເພິ່ນ​ເອົາ​ໄປ. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />ພວກເພິ່ນ​ໄດ້​ຈູງ​ລໍນ້ອຍ​ນັ້ນ​ມາ​ຫາ​ພຣະເຢຊູເຈົ້າ ແລ້ວ​ພວກເພິ່ນ​ກໍ​ເອົາ​ເສື້ອຄຸມ​ຂອງ​ຕົນ​ປູ​ເທິງ​ຫລັງ​ລໍ, ພຣະອົງ​ຂຶ້ນ​ນັ່ງ​ຢູ່​ເທິງ​ຫລັງ​ລໍນ້ອຍ​ນັ້ນ. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />ມີ​ປະຊາຊົນ​ຫລາຍ​ຄົນ​ໄດ້​ເອົາ​ເສື້ອຄຸມ​ຂອງ​ຕົນ​ປູ​ລົງ​ຕາມ​ຫົນທາງ, ແລະ ບາງຄົນ​ກໍ​ໄດ້​ຕັດ​ເອົາ​ງ່າໄມ້​ຕາມ​ທົ່ງນາ​ມາ​ປູ​ຕາມ​ຫົນທາງ. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />ບັນດາ​ຄົນ​ທີ່​ຍ່າງ​ນຳໜ້າ​ໄປ​ກ່ອນ ແລະ ບັນດາ​ຄົນ​ທີ່​ຕາມຫລັງ​ພຣະເຢຊູເຈົ້າ​ໄປ​ຕ່າງ​ກໍ​ຮ້ອງ​ຂຶ້ນ​ວ່າ,</para>
  <para style="q1" vid="MRK 11:9">“ໂຮຊັນນາ!<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ໝາຍຄວາມ​ວ່າ </char><char style="fqa" closed="false">“ຊ່ວຍ​ໃຫ້​ພົ້ນ!” </char><char style="ft" closed="false">ຈຶ່ງ​ກາຍເປັນ​ຄຳ​ທີ່​ສະແດງ​ການສັນລະເສີນ​ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="MRK 11:10"><ref loc="MRK 11:10">10</ref></char></char></note></para>
  <para style="b" vid="MRK 11:9" />
  <para style="q1" vid="MRK 11:9">“ສັນລະເສີນ​ພຣະອົງ​ຜູ້​ມາ​ໃນ​ນາມ​ຂອງ​ອົງພຣະຜູ້ເປັນເຈົ້າ!”<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:25">ພສສ 118:25</ref>,<ref loc="PSA 118:26">26</ref></char></char></note><verse eid="MRK 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />“ຂໍ​ໃຫ້​ອານາຈັກ​ຂອງ​ດາວິດ​ບັນພະບຸລຸດ​ຂອງ​ພວກເຮົາ​ທີ່​ຈະ​ມາ​ນີ້ ຈົ່ງ​ຈະເລີນ!”</para>
  <para style="b" vid="MRK 11:10" />
  <para style="q1" vid="MRK 11:10">“ໂຮຊັນນາ​ໃນ​ສະຫວັນ​ສູງສຸດ!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />ພຣະເຢຊູເຈົ້າ​ໄດ້​ເຂົ້າ​ໄປ​ໃນ​ນະຄອນ​ເຢຣູຊາເລັມ ແລ້ວ​ເຂົ້າ​ໄປ​ໃນ​ເດີ່ນ​ວິຫານ. ພຣະອົງ​ໄດ້​ຫລຽວເບິ່ງ​ທຸກສິ່ງ, ແຕ່​ເນື່ອງ​ຈາກ​ວ່າ​ໃກ້​ຄ່ຳ​ແລ້ວ ພຣະອົງ​ຈຶ່ງ​ກັບ​ໄປ​ຍັງ​ບ້ານ​ເບັດທານີ​ກັບ​ພວກສາວົກ​ທັງ​ສິບສອງ​ຄົນ.<verse eid="MRK 11:11" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ສາບແຊ່ງ​ຕົ້ນໝາກເດື່ອ ແລະ ຊຳລະ​ເດີ່ນ​ວິຫານ</para>
  <para style="r">(ມທ 21:12-22; ລກ 19:45-47; ຢຮ 2:13-16)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />ໃນ​ວັນ​ຕໍ່ມາ ຂະນະ​ທີ່​ພຣະເຢຊູເຈົ້າ​ກັບ​ພວກສາວົກ​ກຳລັງ​ອອກ​ຈາກ​ບ້ານ​ເບັດທານີ​ໄປ, ພຣະເຢຊູເຈົ້າ​ຫິວເຂົ້າ. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />ພຣະອົງ​ເຫັນ​ຕົ້ນ​ໝາກເດື່ອ​ຕົ້ນ​ໜຶ່ງ​ທີ່​ມີ​ໃບ​ດົກໜາ​ດີ ແລະ ພຣະອົງ​ກໍ​ໄປ​ເບິ່ງ​ວ່າ​ມັນ​ມີ​ໝາກ​ບໍ່. ແຕ່​ເມື່ອ​ພຣະອົງ​ໄປ​ເຖິງ​ຕົ້ນ​ໝາກເດື່ອ​ແລ້ວ​ກໍ​ພົບ​ວ່າ​ບໍ່​ມີ​ໝາກ​ມີ​ແຕ່​ໃບ​ເທົ່ານັ້ນ ເພາະ​ບໍ່​ແມ່ນ​ລະດູ​ເກີດ​ໝາກ <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />ດັ່ງນັ້ນ ພຣະເຢຊູເຈົ້າ​ຈຶ່ງ​ກ່າວ​ຕໍ່​ຕົ້ນໝາກເດື່ອ​ນັ້ນ​ວ່າ, “ຕັ້ງແຕ່​ນີ້​ໄປ ຢ່າ​ໃຫ້​ຜູ້ໃດ​ໄດ້​ກິນ​ໝາກ​ຂອງ​ມຶງ​ອີກ​ຈັກ​ເທື່ອ”. ແລະ ພວກສາວົກ​ຂອງ​ພຣະອົງ​ກໍ​ໄດ້​ຍິນ​ຄຳ​ທີ່​ພຣະອົງ​ໄດ້​ກ່າວ​ນັ້ນ.<verse eid="MRK 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />ເມື່ອ​ມາ​ເຖິງ​ນະຄອນ​ເຢຣູຊາເລັມ ພຣະເຢຊູເຈົ້າ​ໄດ້​ເຂົ້າ​ໄປ​ໃນ​ເດີ່ນ​ວິຫານ ພຣະອົງ​ໄດ້​ເລີ່ມ​ຂັບໄລ່​ບັນດາ​ຄົນ​ທີ່​ຊື້ ແລະ ຂາຍ​ຢູ່​ທີ່​ນັ້ນ​ອອກໄປ. ພຣະອົງ​ໄດ້​ຂວ້ຳ​ໂຕະ​ຂອງ​ຄົນ​ຮັບ​ແລກປ່ຽນ​ເງິນ ແລະ ຕັ່ງ​ນັ່ງ​ຂອງ​ຄົນ​ຂາຍ​ນົກເຂົາ, <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />ແລະ ພຣະອົງ​ບໍ່​ອະນຸຍາດ​ໃຫ້​ຜູ້ໃດ​ຂົນ​ສິນຄ້າ​ຜ່ານ​ເດີ່ນ​ວິຫານ. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />ແລ້ວ​ພຣະອົງ​ກໍ​ໄດ້​ສັ່ງສອນ​ພວກເຂົາ​ວ່າ, “ມີ​ຄຳຂຽນ​ໄວ້​ໃນ​ພຣະຄຳພີ​ບໍ່​ແມ່ນ​ບໍ​ວ່າ:</para>
  <para style="q1" vid="MRK 11:17">“ ‘ວິຫານ​ຂອງ​ເຮົາ​ຈະ​ເປັນ​ທີ່​ເອີ້ນ​ວ່າ​ວິຫານ​ແຫ່ງ​ການອະທິຖານ​ສຳລັບ​ຄົນ​ທຸກ​ຊາດ’<note caller="+" style="f"><char style="fr" closed="false">11:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 56:7">ອຊຢ 56:7</ref></char></char></note>?</para>
  <para style="q1" vid="MRK 11:17">ແຕ່​ພວກເຈົ້າ​ໄດ້​ເຮັດ​ໃຫ້​ກາຍເປັນ ‘ຖ້ຳໂຈນ’<note caller="+" style="f"><char style="fr" closed="false">11:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 7:11">ຢມຢ 7:11</ref></char></char></note>”.<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />ເມື່ອ​ພວກຫົວໜ້າ​ປະໂລຫິດ ແລະ ພວກ​ຄູສອນກົດບັນຍັດ​ໄດ້​ຍິນ​ຢ່າງ​ນັ້ນ ພວກເຂົາ​ຈຶ່ງ​ເລີ່ມ​ຊອກຫາ​ທາງ​ທີ່​ຈະ​ຂ້າ​ພຣະອົງ, ພວກເຂົາ​ຢ້ານ​ພຣະອົງ, ເພາະ​ປະຊາຊົນ​ທັງໝົດ​ກໍ​ປະຫລາດໃຈ​ໃນ​ຄຳສັ່ງສອນ​ຂອງ​ພຣະອົງ.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />ພໍ​ຕອນ​ຄ່ຳ​ມາ ພຣະເຢຊູເຈົ້າ ແລະ ພວກສາວົກ<note caller="+" style="f"><char style="fr" closed="false">11:19 </char><char style="ft" closed="false">ພາສາ​ກຣີກ​ວ່າ </char><char style="fqa" closed="false">ພວກເຂົາ </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ໃນ​ຍຸກ​ທຳອິດ​ບາງ​ສະບັບ​ວ່າ </char><char style="fqa" closed="false">ພຣະອົງ</char></note>​ຂອງ​ພຣະອົງ​ກໍ​ອອກຈາກ​ເມືອງ.<verse eid="MRK 11:19" /></para>
  <para style="s1">ຕົ້ນໝາກເດື່ອ​ຫ່ຽວແຫ້ງ</para>
  <para style="r">(ມທ 21:19-22)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />ໃນ​ຕອນເຊົ້າ ຂະນະ​ທີ່​ພວກເພິ່ນ​ມາ​ຕາມ​ທາງ, ພວກເພິ່ນ​ໄດ້​ເຫັນ​ຕົ້ນໝາກເດື່ອ​ຫ່ຽວແຫ້ງ​ໄປ​ຈົນ​ເຖິງ​ຮາກ. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />ເປໂຕ​ຈື່​ໄດ້ ແລະ ເວົ້າ​ກັບ​ພຣະເຢຊູເຈົ້າ​ວ່າ, “ຣັບບີ​ເອີຍ, ເບິ່ງ​ແມ! ຕົ້ນ​ໝາກເດື່ອ​ທີ່​ພຣະອົງ​ສາບແຊ່ງ​ນັ້ນ​ໄດ້​ຫ່ຽວແຫ້ງ​ໄປ​ແລ້ວ!”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />ພຣະເຢຊູເຈົ້າ​ຕອບ​ວ່າ, “ຈົ່ງ​ມີ​ຄວາມເຊື່ອ<note caller="+" style="f"><char style="fr" closed="false">11:22 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ໃນ​ຍຸກ​ທຳອິດ​ບາງ​ສະບັບ​ວ່າ </char><char style="fqa" closed="false">ຖ້າ​ເຈົ້າ​ເຊື່ອ</char></note>​ໃນ​ພຣະເຈົ້າ, <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />ເຮົາ​ບອກ​ພວກເຈົ້າ​ຕາມ​ຄວາມຈິງ​ວ່າ, ຖ້າ​ຜູ້ໃດ​ກໍ​ຕາມ​ທີ່​ສັ່ງ​ພູເຂົາ​ໜ່ວຍ​ນີ້​ວ່າ, ‘ຈົ່ງ​ເຄື່ອນຍ້າຍ​ລົງ​ໄປ​ສູ່​ທະເລ’ ແລະ ບໍ່​ມີ​ຄວາມ​ສົງໄສ​ໃນ​ໃຈ ແຕ່​ເຊື່ອ​ວ່າ​ຈະ​ເປັນ​ໄປ​ຕາມ​ທີ່​ພວກເຂົາ​ເວົ້າ ແລ້ວ​ກໍ​ຈະ​ເປັນ​ຈິງ​ຕາມ​ນັ້ນ. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />ດ້ວຍເຫດນັ້ນ ເຮົາ​ບອກ​ພວກເຈົ້າ​ທັງຫລາຍ​ວ່າ, ສິ່ງໃດ​ກໍ​ຕາມ​ທີ່​ພວກເຈົ້າ​ອະທິຖານ​ຂໍ ຈົ່ງ​ເຊື່ອ​ວ່າ​ພວກເຈົ້າ​ໄດ້​ຮັບ​ແລ້ວ ແລະ ພວກເຈົ້າ​ຈະ​ໄດ້​ຮັບ​ສິ່ງ​ນັ້ນ. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />ແລະ ເມື່ອ​ພວກເຈົ້າ​ຢືນ​ອະທິຖານ, ຖ້າ​ພວກເຈົ້າ​ມີ​ເລື່ອງ​ກັບ​ຜູ້ໃດ​ຜູ້​ໜຶ່ງ ຈົ່ງ​ຍົກໂທດ​ໃຫ້​ພວກເຂົາ ເພື່ອ​ພຣະບິດາເຈົ້າ​ຂອງ​ພວກເຈົ້າ​ຜູ້​ສະຖິດ​ໃນ​ສະຫວັນ​ຈະ​ຍົກໂທດ​ບາບ​ຂອງ​ພວກເຈົ້າ<note caller="+" style="f"><char style="fr" closed="false">11:25 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ບາງສະບັບ​ວ່າ </char><char style="fqa" closed="false">ບາບ​ຂອງ​ເຈົ້າ</char></note>”. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />ແຕ່​ຖ້າ​ພວກເຈົ້າ​ບໍ່​ຍອມ​ຍົກໂທດ ພຣະບິດາເຈົ້າ​ຂອງ​ພວກເຈົ້າ​ຜູ້​ສະຖິດ​ໃນ​ສະຫວັນ​ກໍ​ຈະ​ບໍ່​ຍົກໂທດ​ບາບ​ຂອງ​ພວກເຈົ້າ​ເໝືອນກັນ.<verse eid="MRK 11:26" /></para>
  <para style="s1">ບັນຫາ​ເລື່ອງ​ສິດອຳນາດ​ຂອງ​ພຣະເຢຊູເຈົ້າ</para>
  <para style="r">(ມທ 21:23-27; ລກ 20:1-8)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />ພຣະເຢຊູເຈົ້າ ແລະ ພວກສາວົກ​ຂອງ​ພຣະອົງ​ໄດ້​ກັບຄືນ​ເຂົ້າໄປ​ໃນ​ນະຄອນ​ເຢຣູຊາເລັມ​ອີກ​ເທື່ອ​ໜຶ່ງ ແລະ ໃນຂະນະ​ທີ່​ພຣະເຢຊູເຈົ້າ​ໄດ້​ຍ່າງ​ເຂົ້າໄປ​ໃນ​ເດີ່ນ​ວິຫານ ພວກຫົວໜ້າ​ປະໂລຫິດ, ພວກ​ຄູສອນກົດບັນຍັດ ແລະ ພວກ​ເຖົ້າແກ່​ກໍ​ມາ​ຫາ​ພຣະອົງ, <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />ພວກເຂົາ​ໄດ້​ຖາມ​ວ່າ “ເຈົ້າ​ເຮັດ​ສິ່ງ​ເຫລົ່ານີ້​ດ້ວຍ​ສິດອຳນາດ​ໃດ? ແລະ ຜູ້ໃດ​ໃຫ້​ສິດອຳນາດ​ແກ່​ເຈົ້າ​ເຮັດ​ສິ່ງ​ນີ້?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />ພຣະເຢຊູເຈົ້າ​ຕອບ​ວ່າ, “ເຮົາ​ຈະ​ຖາມ​ພວກເຈົ້າ​ຂໍ້​ໜຶ່ງ​ເໝືອນກັນ. ຈົ່ງ​ຕອບ​ເຮົາ ແລະ ເຮົາ​ຈະ​ບອກ​ພວກເຈົ້າ​ວ່າ​ເຮົາ​ເຮັດ​ສິ່ງ​ເຫລົ່ານີ້​ດ້ວຍ​ສິດອຳນາດ​ໃດ. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />ບັບຕິສະມາ​ຂອງ​ໂຢຮັນ​ນັ້ນ​ມາ​ຈາກ​ສະຫວັນ ຫລື ມາ​ຈາກ​ມະນຸດ? ຈົ່ງ​ບອກ​ເຮົາ​ມາ​ເບິ່ງ​ດູ!”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />ພວກເຂົາ​ໄດ້​ປຶກສາ​ກັນ​ເອງ ແລະ ເວົ້າ​ວ່າ, “ຖ້າ​ພວກເຮົາ​ຕອບ​ວ່າ ‘ມາ​ຈາກ​ສະຫວັນ’ ລາວ​ກໍ​ຈະ​ຖາມ​ວ່າ, ‘ເປັນຫຍັງ​ພວກເຈົ້າ​ຈຶ່ງ​ບໍ່​ເຊື່ອ​ໂຢຮັນ?’ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />ແຕ່​ຖ້າ​ພວກເຮົາ​ເວົ້າ​ວ່າ, ‘ມາ​ຈາກ​ມະນຸດ’…” (ພວກເຂົາ​ຢ້ານ​ປະຊາຊົນ ເພາະ​ທຸກຄົນ​ຖືວ່າ​ໂຢຮັນ​ເປັນ​ຜູ້ທຳນວາຍ​ແທ້ໆ.)<verse eid="MRK 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33" />ດັ່ງນັ້ນ, ພວກເຂົາ​ຈຶ່ງ​ຕອບ​ພຣະເຢຊູເຈົ້າ​ວ່າ, “ພວກເຮົາ​ບໍ່​ຮູ້ຈັກ”.</para>
  <para style="p" vid="MRK 11:33">ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ຈຶ່ງ​ກ່າວ​ວ່າ, “ເຮົາ​ກໍ​ຈະ​ບໍ່​ບອກ​ພວກເຈົ້າ​ເໝືອນກັນ​ວ່າ​ເຮົາ​ເຮັດ​ສິ່ງ​ເຫລົ່ານີ້​ດ້ວຍ​ສິດອຳນາດ​ໃດ”.<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s1">ຄຳອຸປະມາ​ເລື່ອງ​ຄົນເຊົ່າສວນ</para>
  <para style="r">(ມທ 21:33-46; ລກ 20:9-19)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ກໍ​ໄດ້​ເລີ່ມຕົ້ນ​ກ່າວ​ແກ່​ພວກເຂົາ​ເປັນ​ຄຳອຸປະມາ​ວ່າ: “ມີ​ຊາຍ​ຄົນ​ໜຶ່ງ​ເຮັດ​ສວນອະງຸ່ນ. ເພິ່ນ​ໄດ້​ເຮັດ​ຮົ້ວ​ອ້ອມສວນ​ໄວ້, ເຈາະ​ອ່າງ​ເພື່ອ​ໃຊ້​ເປັນ​ບ່ອນ​ຢຽບ​ເອົາ​ນໍ້າອະງຸ່ນ ແລະ ໄດ້​ສ້າງ​ຫໍຄອຍ​ໄວ້​ເພື່ອ​ເຝົ້າຍາມ. ຫລັງຈາກນັ້ນ ເພິ່ນ​ໄດ້​ໃຫ້​ພວກຊາວສວນ​ເຊົ່າ ແລ້ວ​ເພິ່ນ​ກໍ​ຍ້າຍ​ອອກ​ໄປ​ບ່ອນ​ອື່ນ. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />ເມື່ອ​ເຖິງ​ລະດູ​ເກັບກ່ຽວ​ເພິ່ນ​ກໍ​ສົ່ງ​ຜູ້ຮັບໃຊ້​ຄົນ​ໜຶ່ງ​ໄປ​ຫາ​ພວກຄົນເຊົ່າສວນ ເພື່ອ​ຮັບ​ສ່ວນແບ່ງ​ຂອງ​ຜົນລະປູກ​ຈາກ​ສວນອະງຸ່ນ​ນຳ​ພວກເຂົາ. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />ແຕ່​ພວກຄົນເຊົ່າສວນ​ໄດ້​ຈັບ​ລາວ​ມາ, ຂ້ຽນຕີ ແລະ ສົ່ງ​ລາວ​ກັບ​ໄປ​ມື​ເປົ່າ. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />ດັ່ງນັ້ນ ເພິ່ນ​ຈຶ່ງ​ສົ່ງ​ຜູ້ຮັບໃຊ້​ຄົນ​ອື່ນ​ໄປ​ຫາ​ພວກເຂົາ​ອີກ ພວກເຂົາ​ກໍ​ຟາດ​ຫົວ​ຂອງ​ຄົນ​ນັ້ນ ແລະ ເຮັດ​ໃຫ້​ລາວ​ອັບອາຍຂາຍໜ້າ. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />ເພິ່ນ​ກໍ​ຍັງ​ສົ່ງ​ຜູ້ຮັບໃຊ້​ຄົນ​ອື່ນ​ໄປ​ອີກ ແລະ ພວກເຂົາ​ກໍ​ຂ້າ​ຄົນ​ນັ້ນ​ເສຍ. ເຈົ້າຂອງສວນ​ກໍ​ຍັງ​ສົ່ງ​ຄົນຮັບໃຊ້​ໄປ​ອີກ​ຫລາຍໆ​ຄົນ, ພວກເຮົາ​ກໍ​ຂ້ຽນຕີ​ບາງຄົນ ແລະ ພວກເຂົາ​ກໍ​ຂ້າ​ບາງຄົນ.<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />“ເພິ່ນ​ຈຶ່ງ​ເຫລືອ​ແຕ່​ຄົນ​ດຽວ​ທີ່​ຈະ​ໃຊ້​ມາ​ຄື​ລູກຊາຍ ຜູ້​ທີ່​ເພິ່ນ​ຮັກ. ເພິ່ນ​ຈຶ່ງ​ສົ່ງ​ລູກ​ຄົນ​ນັ້ນ​ໄປ​ເປັນ​ຄົນ​ສຸດທ້າຍ ໂດຍ​ກ່າວ​ວ່າ, ‘ພວກເຂົາ​ຈະ​ໃຫ້​ຄວາມເຄົາລົບ​ນັບຖື​ລູກຊາຍ​ຂອງ​ເຮົາ’.<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />“ແຕ່​ພວກ​ຄົນເຊົ່າສວນ​ເວົ້າ​ກັນ​ວ່າ, ‘ຄົນ​ນີ້​ເປັນ​ຜູ້ສືບທອດມໍລະດົກ. ໃຫ້​ພວກເຮົາ​ຂ້າ​ລາວ​ແລ້ວ​ມໍລະດົກ​ຈະ​ຕົກ​ເປັນ​ຂອງ​ພວກເຮົາ’. <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />ດັ່ງນັ້ນ ພວກເຂົາ​ຈຶ່ງ​ຈັບ​ລູກຊາຍ​ຂອງ​ເຈົ້າຂອງສວນ ແລະ ຂ້າ​ລາວ, ແລ້ວ​ພວກເຂົາ​ກໍ​ໂຍນ​ລາວ​ຖິ້ມ​ອອກ​ໄປ​ນອກ​ສວນອະງຸ່ນ.<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />“ພຣະເຢຊູເຈົ້າ​ຖາມ​ວ່າ ແລ້ວ​ເຈົ້າຂອງ​ສວນອະງຸ່ນ​ຈະ​ເຮັດ​ຢ່າງໃດ? ເພິ່ນ​ຈະ​ມາ​ຂ້າ​ພວກ​ຄົນເຊົ່າສວນ ແລະ ເອົາ​ສວນອະງຸ່ນ​ນັ້ນ​ໃຫ້​ຄົນ​ອື່ນ​ເຊົ່າ. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />ພວກເຈົ້າ​ຍັງ​ບໍ່​ໄດ້​ອ່ານ​ພຣະຄຳພີ​ຂໍ້​ນີ້​ບໍ​ວ່າ:</para>
  <para style="q1" vid="MRK 12:10">“ ‘ຫີນ​ທີ່​ຊ່າງ​ກໍ່​ໄດ້​ຖິ້ມ​ແລ້ວ</para>
  <para style="q2" vid="MRK 12:10">ບັດນີ້​ກໍ​ໄດ້​ກາຍເປັນ​ຫີນເສົາເອກ,<note caller="+" style="f"><char style="fr" closed="false">12:10 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ຫີນຫົວມຸມ</char></note><verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />ອົງພຣະຜູ້ເປັນເຈົ້າ​ໄດ້​ກະທຳ​ການ​ນີ້</para>
  <para style="q2" vid="MRK 12:11">ແລະ ເປັນ​ສິ່ງ​ທີ່​ອັດສະຈັນ​ໃນ​ສາຍຕາ​ຂອງ​ພວກເຮົາ.<note caller="+" style="f"><char style="fr" closed="false">12:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:22">ພສສ 118:22</ref>,<ref loc="PSA 118:23">23</ref></char></char></note>’ ”<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />ດັ່ງນັ້ນ ພວກຫົວໜ້າ​ປະໂລຫິດ, ພວກ​ຄູສອນກົດບັນຍັດ ແລະ ພວກ​ເຖົ້າແກ່​ຈຶ່ງ​ໄດ້​ຊອກຫາ​ທາງ​ທີ່​ຈະ​ຈັບ​ພຣະອົງ ພວກເຂົາ​ຮູ້ຈັກ​ວ່າ​ພຣະອົງ​ກ່າວ​ຄຳອຸປະມາ​ນີ້​ຕໍ່ສູ້​ພວກເຂົາ. ແຕ່​ຍ້ອນ​ພວກເຂົາ​ຢ້ານ​ປະຊາຊົນ, ດັ່ງນັ້ນ ພວກເຂົາ​ຈຶ່ງ​ໄປ​ຈາກ​ພຣະອົງ ແລະ ໄປ​ທາງ​ອື່ນ.<verse eid="MRK 12:12" /></para>
  <para style="s1">ການ​ເສຍພາສີ​ແກ່​ກາຍຊາ</para>
  <para style="r">(ມທ 22:15-22; ລກ 20:20-26)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />ແລ້ວ​ພວກເຂົາ​ກໍ​ໃຊ້​ຟາຣີຊາຍ​ບາງຄົນ ແລະ ກຸ່ມ​ສະໜັບສະໜູນ​ເຮໂຣດ​ມາ​ຫາ​ພຣະເຢຊູເຈົ້າ​ເພື່ອ​ຈັບຜິດ​ຖ້ອຍຄຳ​ຂອງ​ພຣະອົງ. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />ພວກເຂົາ​ໄດ້​ມາ​ຫາ​ພຣະອົງ ແລະ ເວົ້າ​ວ່າ, “ອາຈານ​ເອີຍ, ພວກເຮົາ​ຮູ້​ວ່າ​ທ່ານ​ເປັນ​ຄົນສັດຊື່ ແລະ ທ່ານ​ບໍ່​ໄດ້​ຖືກ​ຊັກຈູງ​ໂດຍ​ຄົນ​ອື່ນ, ເພາະ​ທ່ານ​ບໍ່​ເຫັນ​ແກ່​ໜ້າ​ຜູ້ໃດ, ແຕ່​ທ່ານ​ໄດ້​ສອນ​ທາງ​ຂອງ​ພຣະເຈົ້າ​ຕາມ​ຄວາມຈິງ. ເປັນ​ການ​ຖືກຕ້ອງ​ທີ່​ຈະ​ເສຍພາສີ​ໃຫ້​ແກ່​ກາຍຊາ​ບໍ? <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />ພວກເຮົາ​ຄວນ​ເສຍ ຫລື ພວກເຮົາ​ບໍ່​ຄວນ​ເສຍ?”</para>
  <para style="p" vid="MRK 12:15">ແຕ່​ພຣະເຢຊູເຈົ້າ​ຮູ້​ທັນ​ກົນອຸບາຍ​ຂອງ​ພວກເຂົາ ຈຶ່ງ​ຕອບ​ວ່າ, “ເປັນຫຍັງ​ພວກເຈົ້າ​ຈຶ່ງ​ພະຍາຍາມ​ຈະ​ຈັບຜິດ​ເຮົາ? ຈົ່ງ​ນຳ​ເງິນ​ໜຶ່ງ​ຫລຽນ​ມາ​ໃຫ້​ເຮົາ​ເບິ່ງ​ດູ”. <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />ພວກເຂົາ​ກໍ​ເອົາ​ຫລຽນ​ມາ​ໃຫ້ ແລະ ພຣະອົງ​ກໍ​ຖາມ​ພວກເຂົາ​ວ່າ, “ຮູບ​ນີ້​ເປັນ​ຂອງ​ຜູ້ໃດ? ແລະ ຄຳຈາລຶກ​ນີ້​ເປັນ​ຂອງ​ຜູ້ໃດ?”</para>
  <para style="p" vid="MRK 12:16">ພວກເຂົາ​ຕອບ​ວ່າ, “ເປັນ​ຂອງ​ກາຍຊາ”.<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />ແລ້ວ​ພຣະເຢຊູເຈົ້າ​ຈຶ່ງ​ກ່າວ​ແກ່​ພວກເຂົາ​ວ່າ, “ສິ່ງ​ທີ່​ເປັນ​ຂອງ​ກາຍຊາ ຈົ່ງ​ຄືນ​ໃຫ້​ແກ່​ກາຍຊາ ແລະ ສິ່ງ​ທີ່​ເປັນ​ຂອງ​ພຣະເຈົ້າ ຈົ່ງ​ຖວາຍ​ຄືນ​ໃຫ້​ແກ່​ພຣະເຈົ້າ”.</para>
  <para style="p" vid="MRK 12:17">ເມື່ອ​ທຸກຄົນ​ໄດ້​ຍິນ​ຄຳຕອບ​ຂອງ​ພຣະເຢຊູເຈົ້າ​ແລ້ວ ພວກເຂົາ​ຕ່າງ​ກໍ​ປະຫລາດໃຈ​ໃນ​ພຣະອົງ.<verse eid="MRK 12:17" /></para>
  <para style="s1">ບັນຫາ​ເລື່ອງ​ການເປັນຄືນມາຈາກຕາຍ</para>
  <para style="r">(ມທ 22:23-33; ລກ 20:27-38)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />ແລ້ວ​ພວກ​ຊາດູກາຍ​ຜູ້​ທີ່​ກ່າວ​ວ່າ​ບໍ່​ມີ​ການເປັນຄືນມາຈາກຕາຍ ໄດ້​ມາ​ຖາມ​ພຣະເຢຊູເຈົ້າ. <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />ພວກເຂົາ​ເວົ້າ​ວ່າ, “ອາຈານ​ເອີຍ, ໂມເຊ​ໄດ້​ຂຽນ​ເປັນ​ຄຳສັ່ງ​ສຳລັບ​ພວກເຮົາ​ໄວ້​ວ່າ​ຖ້າ​ອ້າຍ​ຂອງ​ຊາຍ​ຜູ້​ໜຶ່ງ​ຕາຍ​ປະ​ເມຍ​ຂອງ​ຕົນ​ໂດຍ​ບໍ່​ມີ​ລູກ, ຊາຍ​ຄົນ​ນັ້ນ​ຈະ​ຕ້ອງ​ແຕ່ງງານ​ກັບ​ຍິງໝ້າຍ​ຄົນ​ນັ້ນ​ເພື່ອ​ຈະ​ມີ​ລູກ​ສືບເຊື້ອສາຍ​ໃຫ້​ອ້າຍ​ຂອງ​ຕົນ. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />ຍັງ​ມີ​ອ້າຍນ້ອງ​ເຈັດ​ຄົນ. ຜູ້​ທີ​ໜຶ່ງ​ໄດ້​ແຕ່ງງານ ແລະ ໄດ້​ຕາຍ​ໄປ​ໂດຍ​ບໍ່​ມີ​ລູກ. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />ແລ້ວ​ຜູ້​ທີ​ສອງ​ກໍ​ໄດ້​ແຕ່ງງານ​ກັບ​ຍິງ​ນັ້ນ ແລະ ລາວ​ກໍ​ໄດ້​ຕາຍ​ໄປ​ອີກ​ໂດຍ​ບໍ່​ມີ​ລູກ. ຜູ້​ທີ​ສາມ​ກໍ​ເໝືອນກັນ. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />ອ້າຍນ້ອງ​ທັງ​ເຈັດ​ໄດ້​ເອົາ​ຍິງ​ນັ້ນ​ມາ​ເປັນ​ເມຍ ແລະ ພວກເຂົາ​ໄດ້​ຕາຍ​ໄປ​ໂດຍ​ບໍ່​ມີ​ລູກ, ແລ້ວ​ໃນ​ທີ່ສຸດ​ຍິງ​ນັ້ນ​ກໍ​ໄດ້​ຕາຍ​ໄປ​ເໝືອນກັນ. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />ໃນ​ວັນ​ທີ່​ເປັນຄືນມາຈາກຕາຍ​ຍິງ​ຄົນ​ນີ້​ຈະ​ເປັນ​ເມຍ​ຂອງ​ຜູ້ໃດ? ດ້ວຍວ່າ​ຊາຍ​ທັງ​ເຈັດ​ຄົນ​ໄດ້​ເປັນ​ຜົວ​ຂອງ​ນາງ​ແລ້ວ”.<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />ພຣະເຢຊູເຈົ້າ​ຕອບ​ວ່າ, “ພວກເຈົ້າ​ບໍ່​ຜິດ​ເພາະ​ວ່າ​ພວກເຈົ້າ​ບໍ່​ຮູ້ຈັກ​ພຣະຄຳພີ ຫລື ລິດອຳນາດ​ຂອງ​ພຣະເຈົ້າ​ບໍ? <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />ເມື່ອ​ຄົນຕາຍ​ຄືນ​ສູ່​ຊີວິດ​ນັ້ນ​ຈະ​ບໍ່​ມີ​ການແຕ່ງງານ ຫລື ຍົກ​ໃຫ້​ເປັນ​ຜົວເມຍ​ກັນ​ອີກ ພວກເຂົາ​ຈະ​ເປັນ​ເໝືອນ​ເທວະດາ​ໃນ​ສະຫວັນ. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />ສຳລັບ​ເລື່ອງ​ຄົນຕາຍ​ເປັນຄືນມາ​ນັ້ນ ພວກເຈົ້າ​ບໍ່​ເຄີຍ​ໄດ້​ອ່ານ​ຖ້ອຍຄຳ​ກ່ຽວກັບ​ເລື່ອງ​ຂອງ​ໂມເຊ ທີ່​ພຸ່ມໄມ້​ມີ​ໄຟ​ລຸກໄໝ້​ນັ້ນ​ບໍ? ພຣະເຈົ້າ​ໄດ້​ກ່າວ​ກັບ​ເພິ່ນ​ດັ່ງນີ້, ‘ເຮົາ​ເປັນ​ພຣະເຈົ້າ​ຂອງ​ອັບຣາຮາມ, ພຣະເຈົ້າ​ຂອງ​ອີຊາກ ແລະ ພຣະເຈົ້າ​ຂອງ​ຢາໂຄບ’<note caller="+" style="f"><char style="fr" closed="false">12:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 3:6">ອພຍ 3:6</ref></char></char></note>? <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />ພຣະອົງ​ບໍ່ແມ່ນ​ພຣະເຈົ້າ​ຂອງ​ຄົນຕາຍ, ແຕ່​ແມ່ນ​ພຣະເຈົ້າ​ຂອງ​ຄົນເປັນ. ພວກເຈົ້າ​ເຂົ້າໃຈ​ຜິດ​ຫລາຍ​ແລ້ວ!”<verse eid="MRK 12:27" /></para>
  <para style="s1">ກົດບັນຍັດ​ຂໍ້​ໃຫຍ່​ທີ່ສຸດ</para>
  <para style="r">(ມທ 22:34-40)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />ມີ​ຄູສອນກົດບັນຍັດ​ຄົນ​ໜຶ່ງ​ໄດ້​ເຂົ້າ​ມາ ແລະ ໄດ້​ຍິນ​ພຣະເຢຊູເຈົ້າ​ກັບ​ພວກຊາດູກາຍ​ກຳລັງ​ຖົກຖຽງ​ກັນ​ຢູ່. ເຫັນ​ວ່າ​ພຣະເຢຊູເຈົ້າ​ຕອບ​ພວກເຂົາ​ໄດ້​ດີ, ລາວ​ຈຶ່ງ​ຖາມ​ພຣະອົງ​ວ່າ, “ໃນ​ບັນດາ​ກົດບັນຍັດ​ທັງໝົດ​ຂໍ້​ໃດ​ສຳຄັນ​ທີ່ສຸດ?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />ພຣະເຢຊູເຈົ້າ​ຕອບ​ລາວ​ວ່າ, “ຂໍ້​ທີ່​ສຳຄັນ​ທີ່ສຸດ​ຄື ‘ຊາວ​ອິດສະຣາເອນ​ເອີຍ ຈົ່ງ​ຟັງ, ອົງພຣະຜູ້ເປັນເຈົ້າ​ພຣະເຈົ້າ​ຂອງ​ພວກເຮົາ, ອົງພຣະຜູ້ເປັນເຈົ້າ​ເປັນ​ໜຶ່ງ​ດຽວ.<note caller="+" style="f"><char style="fr" closed="false">12:29 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ເປັນ​ອົງພຣະຜູ້ເປັນເຈົ້າ​ດຽວ</char></note> <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />ຈົ່ງ​ຮັກ​ອົງພຣະຜູ້ເປັນເຈົ້າ​ພຣະເຈົ້າ​ຂອງ​ເຈົ້າ​ດ້ວຍ​ສຸດ​ໃຈ ດ້ວຍ​ສຸດ​ຈິດ ດ້ວຍ​ສຸດ​ຄວາມຄິດ ແລະ ດ້ວຍ​ສຸດ​ກຳລັງ​ຂອງ​ເຈົ້າ’.<note caller="+" style="f"><char style="fr" closed="false">12:30 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:4">ພບຍ 6:4</ref>,<ref loc="DEU 6:5">5</ref></char></char></note> <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />ສ່ວນ​ຂໍ້​ທີ​ສອງ​ຄື: ‘ຈົ່ງ​ຮັກ​ເພື່ອນບ້ານ​ເໝືອນ​ຮັກ​ຕົນ​ເອງ’.<note caller="+" style="f"><char style="fr" closed="false">12:31 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">ລລວ 19:18</ref></char></char></note> ບໍ່​ມີ​ກົດບັນຍັດ​ຂໍ້​ໃດ​ທີ່​ໃຫຍ່​ກວ່າ​ສອງ​ຂໍ້​ນີ້”.<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />ຄູສອນກົດບັນຍັດ​ຄົນ​ນີ້​ຈຶ່ງ​ຕອບ​ວ່າ, “ທ່ານ​ອາຈານ​ຕອບ​ໄດ້​ດີ, ທີ່​ທ່ານ​ໄດ້​ກ່າວ​ນັ້ນ​ຖືກຕ້ອງ​ແລ້ວ​ທີ່​ວ່າ​ພຣະເຈົ້າ​ເປັນ​ໜຶ່ງ ແລະ ບໍ່​ມີ​ພະ​ອື່ນ​ນອກ​ຈາກ​ພຣະອົງ. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />ການ​ທີ່​ຮັກ​ພຣະອົງ​ດ້ວຍ​ສຸດ​ຫົວໃຈ, ສຸດ​ຄວາມເຂົ້າໃຈ ແລະ ສຸດ​ກຳລັງ​ຂອງ​ທ່ານ ແລະ ການ​ທີ່​ຮັກ​ເພື່ອນບ້ານ​ເໝືອນ​ຮັກ​ຕົນ​ເອງ​ກໍ​ສຳຄັນ​ຫລາຍ​ກວ່າ​ເຄື່ອງເຜົາບູຊາ ແລະ ເຄື່ອງຖວາຍ​ທັງຫລາຍ”.<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />ເມື່ອ​ພຣະເຢຊູເຈົ້າ​ເຫັນ​ວ່າ​ລາວ​ຕອບ​ດ້ວຍ​ຄວາມສະຫລາດ ພຣະອົງ​ຈຶ່ງ​ກ່າວ​ກັບ​ລາວ​ວ່າ, “ເຈົ້າ​ບໍ່​ໄດ້​ຢູ່​ໄກ​ຈາກ​ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ”. ຕັ້ງແຕ່​ນັ້ນ​ມາ​ກໍ​ບໍ່​ມີ​ຜູ້ໃດ​ກ້າ​ຖາມ​ພຣະອົງ​ອີກ.<verse eid="MRK 12:34" /></para>
  <para style="s1">ພຣະຄຣິດເຈົ້າ​ເປັນ​ບຸດ​ຂອງ​ຜູ້ໃດ?</para>
  <para style="r">(<ref loc="MAT 22:41-23:7">ມທ 22:41–23:7</ref>; ລກ 20:41-47)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />ໃນຂະນະ​ທີ່​ພຣະເຢຊູເຈົ້າ​ກຳລັງ​ສັ່ງສອນ​ຢູ່​ໃນ​ເດີ່ນ​ວິຫານ, ພຣະອົງ​ໄດ້​ຖາມ​ວ່າ, “ດ້ວຍເຫດໃດ​ພວກ​ຄູສອນກົດບັນຍັດ​ຈຶ່ງ​ເວົ້າ​ໄດ້​ວ່າ​ພຣະຄຣິດເຈົ້າ<note caller="+" style="f"><char style="fr" closed="false">12:35 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ພຣະເມຊີອາ</char></note>​ເປັນ​ບຸດ​ຂອງ​ດາວິດ? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />ດາວິດ​ເອງ​ເມື່ອ​ກ່າວ​ໂດຍ​ພຣະວິນຍານບໍລິສຸດເຈົ້າ​ກໍ​ປະກາດ​ວ່າ:</para>
  <para style="q1" vid="MRK 12:36">“ ‘ພຣະເຈົ້າ​ໄດ້​ກ່າວ​ກັບ​ອົງພຣະຜູ້ເປັນເຈົ້າ​ຂອງ​ຂ້ານ້ອຍ​ວ່າ:</para>
  <para style="q2" vid="MRK 12:36">“ຈົ່ງ​ນັ່ງ​ທີ່​ເບື້ອງຂວາ​ມື​ຂອງ​ເຮົາ</para>
  <para style="q1" vid="MRK 12:36">ຈົນ​ກວ່າ​ເຮົາ​ຈະ​ປາບ​ສັດຕູ​ທັງຫລາຍ​ຂອງ​ເຈົ້າ</para>
  <para style="q2" vid="MRK 12:36">ໃຫ້​ຢູ່​ໃຕ້​ຕີນ​ຂອງ​ເຈົ້າ” ’<note caller="+" style="f"><char style="fr" closed="false">12:36 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:1">ພສສ 110:1</ref></char></char></note>.<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />ໃນ​ເມື່ອ​ກະສັດ​ດາວິດ​ເອງ​ຍັງ​ເອີ້ນ​ພຣະອົງ​ວ່າ, ‘ອົງພຣະຜູ້ເປັນເຈົ້າ’ ແລ້ວ​ພຣະອົງ​ຈະ​ເປັນ​ບຸດ​ຂອງ​ດາວິດ​ໄດ້​ຢ່າງໃດ?”</para>
  <para style="p" vid="MRK 12:37">ປະຊາຊົນ​ຈໍານວນ​ຫລວງຫລາຍ​ຟັງ​ພຣະອົງ​ດ້ວຍ​ຄວາມຊື່ນຊົມຍິນດີ.<verse eid="MRK 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />ໃນ​ຂະນະ​ທີ່​ພຣະເຢຊູເຈົ້າ​ສັ່ງສອນ​ຢູ່​ນັ້ນ ພຣະອົງ​ໄດ້​ກ່າວ​ວ່າ, “ຈົ່ງ​ລະວັງ​ພວກ​ຄູສອນກົດບັນຍັດ​ໃຫ້​ດີ. ພວກເຂົາ​ມັກ​ນຸ່ງ​ເສື້ອຄຸມຍາວ​ຍ່າງ​ໄປ​ມາ ແລະ ມັກ​ໃຫ້​ຄົນ​ມາ​ຄຳນັບ​ທັກທາຍ​ໃນ​ບ່ອນຊຸມນຸມຊົນ, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />ມັກ​ນັ່ງ​ໃນ​ບ່ອນນັ່ງ​ທີ່​ສຳຄັນ​ໃນ​ທຳມະສາລາ ແລະ ບ່ອນນັ່ງ​ທີ່​ມີ​ກຽດ​ໃນ​ງານກິນລ້ຽງ​ຕ່າງໆ. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />ພວກເຂົາ​ສໍ້ໂກງ​ເອົາ​ເຮືອນ​ຂອງ​ບັນດາ​ແມ່ໝ້າຍ ແລະ ເຮັດ​ທຳທ່າ​ອະທິຖານ​ຢ່າງ​ຍືດຍາວ​ເພື່ອ​ໃຫ້​ຄົນ​ເຫັນ. ຄົນ​ເຫລົ່ານີ້​ຈະ​ຖືກ​ລົງໂທດ​ໜັກ​ທີ່ສຸດ”.<verse eid="MRK 12:40" /></para>
  <para style="s1">ເງິນ​ຖວາຍ​ຂອງ​ແມ່ໝ້າຍ</para>
  <para style="r">(ລກ 21:1-4)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />ພຣະເຢຊູເຈົ້າ​ນັ່ງ​ຢູ່​ກົງກັນຂ້າມ​ກັບ​ບ່ອນ​ທີ່​ຮັບ​ເງິນ​ຖວາຍ​ຂອງ​ວິຫານ​ນັ້ນ ແລະ ພຣະອົງ​ສັງເກດ​ເບິ່ງ​ປະຊາຊົນ​ປ່ອນ​ເງິນ​ຂອງ​ພວກເຂົາ​ລົງ​ໃສ່​ຄັງ​ວິຫານ. ຄົນຮັ່ງມີ​ຫລາຍຄົນ​ໄດ້​ປ່ອນ​ເງິນ​ລົງ​ຈໍານວນ​ຫລວງຫລາຍ. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />ແຕ່​ແມ່ໝ້າຍ​ທີ່​ຍາກຈົນ​ຄົນ​ໜຶ່ງ​ໄດ້​ມາ ແລະ ປ່ອນ​ຫລຽນທອງແດງ​ຂະໜາດ​ນ້ອຍໆ​ສອງ​ຫລຽນ,<note caller="+" style="f"><char style="fr" closed="false">12:42 </char><char style="ft" closed="false">ພາສາ​ກຣີກ​ວ່າ </char><char style="fqa" closed="false">2 ເລຟະຕັນ</char></note> ເຊິ່ງ​ມີ​ມູນຄ່າ​ເທົ່າກັບ​ສອງສາມ​ເຊັນ<note caller="+" style="f"><char style="fr" closed="false">12:42 </char><char style="ft" closed="false">ພາສາ​ກຣີກ​ວ່າ </char><char style="fqa" closed="false">1 ໂຄແດນເທັດ</char></note>​ເທົ່າ​ນັ້ນ​ລົງ​ຖວາຍ.<verse eid="MRK 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 12:43" />ພຣະເຢຊູເຈົ້າ​ເອີ້ນ​ພວກສາວົກ​ຂອງ​ພຣະອົງ​ມາ ແລະ ກ່າວ​ກັບ​ພວກເພິ່ນ​ວ່າ, “ເຮົາ​ບອກ​ພວກເຈົ້າ​ຕາມ​ຄວາມຈິງ​ວ່າ, ແມ່ໝ້າຍ​ຍາກຈົນ​ຄົນ​ນີ້​ໄດ້​ຖວາຍ​ເຂົ້າ​ຄັງ​ວິຫານ​ຫລາຍກວ່າ​ຄົນ​ອື່ນ​ທັງໝົດ. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />ເພາະ​ພວກເຂົາ​ທັງໝົດ​ລ້ວນ​ແຕ່​ເອົາ​ສ່ວນ​ໜຶ່ງ​ຈາກ​ຄວາມຮັ່ງມີ​ຂອງ​ພວກເຂົາ​ມາ​ຖວາຍ, ແຕ່​ແມ່ໝ້າຍ​ຄົນ​ນີ້​ໄດ້​ເອົາ​ທຸກສິ່ງ​ທີ່​ຕົນ​ມີ​ຢູ່​ສຳລັບ​ລ້ຽງ​ຊີວິດ​ມາ​ຖວາຍ”.<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s1">ການທຳລາຍ​ວິຫານ ແລະ ໝາຍສຳຄັນ​ຂອງ​ຍຸກສຸດທ້າຍ</para>
  <para style="r">(ມທ 24:1-51; ລກ 21:5-36)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />ຂະນະ​ທີ່​ພຣະເຢຊູເຈົ້າ​ກຳລັງ​ອອກ​ຈາກ​ວິຫານ​ໄປ, ສາວົກ​ຄົນ​ໜຶ່ງ​ກໍ​ເວົ້າ​ກັບ​ພຣະອົງ​ວ່າ, “ເບິ່ງ​ແມ, ອາຈານ​ເອີຍ! ຫີນ​ຄື​ກ້ອນ​ໃຫຍ່​ແທ້! ອາຄານ​ເຫລົ່ານີ້​ຊ່າງ​ງົດງາມ​ແທ້!”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />ພຣະເຢຊູເຈົ້າ​ຕອບ​ວ່າ, “ພວກເຈົ້າ​ເຫັນ​ອາຄານ​ໃຫຍ່​ເຫລົ່ານັ້ນ​ບໍ? ຫີນ​ຢູ່​ທີ່​ນີ້​ຈະ​ບໍ່​ເຫລືອ​ຈັກ​ກ້ອນ, ທຸກ​ກ້ອນ​ຈະ​ຖືກ​ໂຍນຖິ້ມ​ລົງ​ມາ​ໝົດ”.<verse eid="MRK 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />ຂະນະ​ທີ່​ພຣະເຢຊູເຈົ້າ​ນັ່ງ​ຢູ່​ເທິງ​ພູເຂົາ​ໝາກກອກ ກົງກັນຂ້າມ​ກັບ​ວິຫານ, ເປໂຕ, ຢາໂກໂບ, ໂຢຮັນ ແລະ ອັນເດອາ​ໄດ້​ມາ​ຖາມ​ພຣະອົງ​ເປັນ​ການ​ສ່ວນ​ໂຕ​ວ່າ, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“ຂໍ​ບອກ​ພວກຂ້ານ້ອຍ​ແດ່​ວ່າ​ເຫດການ​ນີ້​ຈະ​ເກີດຂຶ້ນ​ເມື່ອ​ໃດ? ແລະ ສິ່ງ​ໃດ​ຈະ​ເປັນ​ໝາຍສຳຄັນ​ວ່າ​ເຫດການ​ທັງໝົດ​ເຫລົ່ານີ້​ກຳລັງ​ຈະ​ສຳເລັດ?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />ພຣະເຢຊູເຈົ້າ​ກໍ​ກ່າວ​ກັບ​ພວກເພິ່ນ​ວ່າ: “ຈົ່ງ​ລະວັງ​ໃຫ້​ດີ​ຢ່າ​ໃຫ້​ຜູ້ໃດ​ຜູ້​ໜຶ່ງ​ຫລອກລວງ​ພວກເຈົ້າ. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />ຫລາຍ​ຄົນ​ມາ​ໃນ​ນາມ​ຂອງ​ເຮົາ ແລະ ອ້າງ​ໂຕ​ວ່າ, ‘ເຮົາ​ເປັນ​ຜູ້​ນັ້ນ’ ແລະ ຈະ​ຫລອກລວງ​ຫລາຍ​ຄົນ. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />ເມື່ອ​ພວກເຈົ້າ​ໄດ້​ຍິນ​ເຖິງ​ເລື່ອງ​ສົງຄາມ ແລະ ຂ່າວລື​ເລື່ອງ​ການເຮັດສົງຄາມ ຢ່າ​ຕື່ນຕົກໃຈ. ເຫດການ​ເຫລົ່ານີ້​ຈະ​ຕ້ອງ​ເກີດຂຶ້ນ ແຕ່​ວ່າ​ເວລາ​ສຸດທ້າຍ​ຈະ​ຍັງ​ບໍ່​ມາ​ເຖິງ. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />ປະເທດ​ຕໍ່​ປະເທດ ແລະ ອານາຈັກ​ຕໍ່​ອານາຈັກ​ຈະ​ສູ້ຮົບ​ກັນ. ຈະ​ເກີດ​ແຜ່ນດິນໄຫວ​ໃນ​ບ່ອນ​ຕ່າງໆ ແລະ ຈະ​ເກີດ​ການອຶດຢາກ​ອາຫານ. ເຫດການ​ເຫລົ່ານີ້​ແມ່ນ​ຂັ້ນ​ເລີ່ມຕົ້ນ​ຂອງ​ຄວາມເຈັບປວດ​ໃນ​ການເກີດລູກ.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />“ພວກເຈົ້າ​ຈົ່ງ​ລະວັງ​ໂຕ​ໃຫ້​ດີ. ພວກເຈົ້າ​ຈະ​ຖືກ​ມອບ​ໃຫ້​ສະພາ​ທ້ອງຖິ່ນ ແລະ ຈະ​ຖືກ​ຂ້ຽນຕີ​ໃນ​ທຳມະສາລາ. ພວກເຈົ້າ​ຈະ​ຢືນ​ຢູ່​ຕໍ່ໜ້າ​ບັນດາ​ຜູ້ປົກຄອງ ແລະ ກະສັດ​ທັງຫລາຍ​ເພື່ອ​ເປັນ​ພະຍານ​ແກ່​ພວກເຂົາ​ເພື່ອ​ເຮົາ. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />ຂ່າວປະເສີດ​ຈະ​ຕ້ອງ​ປະກາດ​ໄປ​ທົ່ວ​ປະຊາຊາດ​ທັງໝົດ​ກ່ອນ. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />ເມື່ອ​ໃດ​ກໍ​ຕາມ​ທີ່​ເຈົ້າ​ຖືກ​ຈັບ ແລະ ຖືກ​ສົ່ງ​ໄປ​ຂຶ້ນ​ສານ, ພວກເຈົ້າ​ຢ່າ​ກັງວົນ​ໄປ​ກ່ອນ​ລ່ວງໜ້າ​ວ່າ​ຈະ​ເວົ້າ​ຢ່າງໃດ. ຈົ່ງ​ເວົ້າ​ໄປ​ຕາມ​ຖ້ອຍຄຳ​ທີ່​ໃຫ້​ແກ່​ພວກເຈົ້າ​ໃນ​ເວລາ​ນັ້ນ, ເພາະ​ບໍ່ແມ່ນ​ພວກເຈົ້າ​ທີ່​ເປັນ​ຜູ້​ເວົ້າ ແຕ່​ແມ່ນ​ພຣະວິນຍານບໍລິສຸດເຈົ້າ.<verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />“ອ້າຍ​ເອື້ອຍ​ນ້ອງ​ຈະ​ທໍລະຍົດ​ກັນ​ໃຫ້​ເຖິງ​ຕາຍ ແລະ ພໍ່​ຈະ​ທໍລະຍົດ​ລູກ. ລູກ​ຈະ​ລຸກຂຶ້ນ​ຕໍ່ສູ້​ພໍ່​ແມ່​ຂອງ​ຕົນ​ຈົນ​ເຖິງ​ແກ່​ຄວາມຕາຍ. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />ຄົນ​ທັງຫລາຍ​ຈະ​ກຽດຊັງ​ພວກເຈົ້າ​ເພາະ​ເຮົາ, ແຕ່​ຜູ້ໃດ​ທີ່​ຕັ້ງໝັ້ນຄົງ​ໄດ້​ຈົນ​ເຖິງ​ທີ່ສຸດ ຜູ້​ນັ້ນ​ຈະ​ໄດ້​ພົ້ນ.<verse eid="MRK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />“ເມື່ອ​ພວກເຈົ້າ​ເຫັນ ‘ສິ່ງ​ທີ່​ໜ້າກຽດໜ້າຊັງ​ອັນ​ເປັນ​ຕົ້ນເຫດ​ຂອງ​ວິບັດ’<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false"><char style="xt"><ref loc="DAN 9:27">ດນອ 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char></char></note> ຕັ້ງ​ຢູ່​ໃນ​ບ່ອນ​ບໍ່​ສົມຄວນ​ຈະ​ຕັ້ງ<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ເຂົາ </char><char style="ft" closed="false">ເຊັ່ນ​ດຽວ​ກັນ​ກັບ​ຂໍ້ <char style="xt" link-href="MRK 13:29"><ref loc="MRK 13:29">29</ref></char></char></note> (ໃຫ້​ຜູ້​ອ່ານ​ເຂົ້າໃຈ​ຄວາມໝາຍ​ເອົາ​ເອງ) ແລ້ວ​ໃຫ້​ບັນດາ​ຜູ້​ທີ່​ຢູ່​ໃນ​ແຂວງ​ຢູດາຍ​ໜີ​ໄປ​ທີ່​ພູເຂົາ​ທັງຫລາຍ. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />ຜູ້​ທີ່​ຢູ່​ເທິງ​ຫລັງຄາ ກໍ​ບໍ່​ຕ້ອງ​ລົງ​ມາ ຫລື ເຂົ້າໄປ​ໃນ​ເຮືອນ​ເພື່ອ​ເກັບ​ເອົາ​ສິ່ງ​ຂອງ​ອອກ​ໄປ. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />ສ່ວນ​ຜູ້​ທີ່​ຢູ່​ໃນ​ທົ່ງນາ ກໍ​ບໍ່​ຕ້ອງ​ກັບຄືນ​ໄປ​ເອົາ​ເສື້ອຜ້າ​ຂອງ​ຕົນ. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />ວັນ​ເຫລົ່ານັ້ນ​ໜ້າຢ້ານກົວ​ທີ່ສຸດ​ສຳລັບ​ແມ່ຍິງ​ຖືພາ ແລະ ແມ່ລູກອ່ອນ! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />ຈົ່ງ​ອະທິຖານ​ເພື່ອ​ວ່າ​ເຫດການ​ເຫລົ່ານີ້​ຈະ​ບໍ່​ເກີດຂຶ້ນ​ໃນ​ລະດູໜາວ, <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />ເພາະວ່າ ໃນ​ເວລາ​ນັ້ນ​ຈະ​ມີ​ຄວາມທຸກລຳບາກ​ຄັ້ງ​ໃຫຍ່​ທີ່​ບໍ່​ເຄີຍ​ມີ​ມາ​ຕັ້ງແຕ່​ຕົ້ນເດີມ ເມື່ອ​ພຣະເຈົ້າ​ໄດ້​ສ້າງ​ໂລກ​ຈົນ​ເຖິງ​ທຸກ​ວັນ​ນີ້ ແລະ ຈະ​ບໍ່​ມີ​ຄັ້ງ​ໃດ​ເທົ່າກັບ​ຄັ້ງ​ນີ້​ອີກ.<verse eid="MRK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 13:20" />“ຖ້າ​ອົງພຣະຜູ້ເປັນເຈົ້າ​ບໍ່​ໄດ້​ຕັດ​ວັນ​ເຫລົ່ານັ້ນ​ໃຫ້​ສັ້ນເຂົ້າ​ແລ້ວ ກໍ​ຈະ​ບໍ່​ມີ​ຄົນ​ໃດ​ພົ້ນ​ເລີຍ. ແຕ່​ເພື່ອ​ເຫັນ​ແກ່​ຜູ້​ທີ່​ໄດ້​ເລືອກ​ໄວ້​ນັ້ນ, ຈະ​ເຮັດ​ໃຫ້​ວັນ​ເຫລົ່ານັ້ນ​ສັ້ນ​ເຂົ້າ. <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />ໃນ​ເວລາ​ນັ້ນ​ຖ້າ​ມີ​ຜູ້ໃດ​ເວົ້າ​ກັບ​ພວກເຈົ້າ​ວ່າ, ‘ເບິ່ງ​ແມ ພຣະຄຣິດເຈົ້າ<note caller="+" style="f"><char style="fr" closed="false">13:21 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ພຣະເມຊີອາ</char></note>​ຢູ່​ທີ່​ນີ້!’ ຫລື ‘ເບິ່ງແມ! ພຣະອົງ​ຢູ່​ທີ່​ນັ້ນ!’ ຢ່າ​ໄດ້​ເຊື່ອ. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />ດ້ວຍວ່າ ຈະ​ມີ​ພຣະຄຣິດ​ປອມ ແລະ ຜູ້ທຳນວາຍ​ປອມ​ປາກົດ​ຂຶ້ນ. ພວກເຂົາ​ຈະ​ສະແດງ​ໝາຍສຳຄັນ ແລະ ການ​ອັດສະຈັນ​ຫລາຍ​ປະການ. ຖ້າ​ເປັນ​ໄປ​ໄດ້​ຈະ​ຫລອກລວງ​ແມ່ນ​ແຕ່​ຜູ້​ທີ່​ໄດ້​ເລືອກ​ໄວ້. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />ດັ່ງນັ້ນ ຈົ່ງ​ລະວັງ​ໃຫ້​ດີ, ເຮົາ​ໄດ້​ບອກ​ພວກເຈົ້າ​ທັງຫລາຍ​ໃຫ້​ຮູ້​ທຸກ​ສິ່ງ​ໄວ້​ລ່ວງໜ້າ​ກ່ອນ​ແລ້ວ.<verse eid="MRK 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />“ແຕ່​ໃນ​ວັນ​ເຫລົ່ານັ້ນ, ຫລັງ​ຈາກ​ຄວາມທຸກລຳບາກ</para>
  <para style="q1" vid="MRK 13:24">“ ‘ດວງອາທິດ​ຈະ​ມືດ​ໄປ</para>
  <para style="q2" vid="MRK 13:24">ແລະ ດວງເດືອນ​ຈະ​ບໍ່​ສ່ອງແສງ,<verse eid="MRK 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25" />ດວງດາວ​ທັງຫລາຍ​ຈະ​ຕົກ​ຈາກ​ທ້ອງຟ້າ,</para>
  <para style="q2" vid="MRK 13:25">ແລະ ສະຫວັນ​ຈະ​ສັ່ນສະເທືອນ’.<note caller="+" style="f"><char style="fr" closed="false">13:25 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 13:10">ອຊຢ 13:10</ref>; <ref loc="ISA 34:4">34:4</ref></char></char></note><verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />“ເມື່ອ​ນັ້ນ​ຄົນ​ທັງຫລາຍ​ຈະ​ເຫັນ​ບຸດມະນຸດ​ມາ​ໃນ​ເມກ​ດ້ວຍ​ລິດອຳນາດ ແລະ ສະຫງ່າລາສີ​ອັນ​ຍິ່ງໃຫຍ່. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />ແລະ ພຣະອົງ​ຈະ​ໃຊ້​ບັນດາ​ເທວະດາ​ຂອງ​ພຣະອົງ​ອອກ​ໄປ​ເພື່ອ​ຮວບຮວມ​ເອົາ​ຜູ້​ທີ່​ເລືອກ​ໄວ້​ຈາກ​ທັງ​ສີ່​ທິດ, ຕັ້ງແຕ່​ທີ່ສຸດປາຍ​ແຜ່ນດິນໂລກ​ຈົນ​ເຖິງ​ທີ່ສຸດປາຍ​ຟ້າສະຫວັນ.<verse eid="MRK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />“ບັດນີ້ ຈົ່ງ​ຮຽນຮູ້​ເອົາ​ບົດຮຽນ​ນີ້​ຈາກ​ຕົ້ນໝາກເດື່ອ​ຄື: ທັນທີ​ທີ່​ກິ່ງ​ອ່ອນ ແລະ ໃບ​ຂອງ​ມັນ​ປົ່ງ​ອອກມາ ພວກເຈົ້າ​ກໍ​ຮູ້​ວ່າ​ລະດູ​ຮ້ອນ​ໃກ້​ຈະ​ມາ​ເຖິງ. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />ຢ່າງ​ດຽວກັນ, ເມື່ອ​ພວກເຈົ້າ​ເຫັນ​ສິ່ງ​ເຫລົ່ານີ້​ເກີດຂຶ້ນ, ພວກເຈົ້າ​ກໍ​ຈະ​ຮູ້​ວ່າ​ສິ່ງ​ນີ້<note caller="+" style="f"><char style="fr" closed="false">13:29 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ສິ່ງ​ນີ້ </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ພຣະອົງ</char></note>​ເຂົ້າ​ມາ​ໃກ້​ແລ້ວ, ຢູ່​ທີ່​ປະຕູ​ແລ້ວ. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />ເຮົາ​ບອກ​ພວກເຈົ້າ​ຕາມ​ຄວາມຈິງ​ວ່າ, ຄົນ​ໃນ​ສະໄໝ​ນີ້<note caller="+" style="f"><char style="fr" closed="false">13:30 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ຍຸກ​ນີ້</char></note>​ຈະ​ຍັງ​ບໍ່​ທັນ​ລ່ວງລັບ​ໄປ​ກ່ອນ​ຈົນ​ກວ່າ​ສິ່ງ​ທັງໝົດ​ເຫລົ່ານີ້​ຈະ​ເກີດຂຶ້ນ. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />ສະຫວັນ ແລະ ແຜ່ນດິນໂລກ​ຈະ​ລ່ວງ​ພົ້ນ​ໄປ ແຕ່​ຖ້ອຍຄຳ​ຂອງ​ເຮົາ​ຈະ​ບໍ່​ລ່ວງ​ພົ້ນ​ໄປ​ຈັກເທື່ອ.<verse eid="MRK 13:31" /></para>
  <para style="s1">ວັນ ແລະ ເວລາ​ທີ່​ບໍ່​ມີ​ຜູ້ໃດ​ຮູ້</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />“ແຕ່​ເລື່ອງ​ວັນ ຫລື ເວລາ​ນັ້ນ​ບໍ່​ມີ​ຜູ້ໃດ​ຮູ້, ແມ່ນແຕ່​ບັນດາ​ເທວະດາ​ໃນ​ສະຫວັນ ຫລື ພຣະບຸດ​ກໍ​ບໍ່​ຮູ້, ມີ​ແຕ່​ພຣະບິດາ​ອົງ​ດຽວ​ເທົ່ານັ້ນ​ທີ່​ຮູ້. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />ຈົ່ງ​ລະມັດລະວັງ! ຈົ່ງ​ເຝົ້າ​ລະວັງ​ຢູ່!<note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ບາງສະບັບ​ວ່າ </char><char style="fqa" closed="false">ຕື່ນຕົວ </char><char style="ft" closed="false">ແລະ </char><char style="fqa" closed="false">ອະທິຖານ</char></note> ພວກເຈົ້າ​ບໍ່​ຮູ້​ວ່າ​ເວລາ​ນັ້ນ​ຈະ​ມາ​ເຖິງ​ເມື່ອ​ໃດ. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />ປຽບເໝືອນ​ກັບ​ຊາຍ​ຄົນ​ໜຶ່ງ​ທີ່​ອອກ​ຈາກ​ເຮືອນ​ຂອງ​ຕົນ​ໄປ ແລະ ໄດ້​ແຕ່ງຕັ້ງ​ໃຫ້​ຄົນຮັບໃຊ້​ຮັບຜິດຊອບ​ໜ້າທີ່​ຕ່າງໆ​ຕາມ​ແຕ່ລະຄົນ​ໄດ້​ຮັບ​ມອບໝາຍ ແລະ ບອກ​ຄົນເຝົ້າປະຕູ​ໃຫ້​ເຝົ້າລະວັງ​ໄວ້​ໃຫ້​ດີ.<verse eid="MRK 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35" />“ເຫດສະນັ້ນ ຈົ່ງ​ເຝົ້າ​ລະວັງ​ຢູ່ ເພາະ​ພວກເຈົ້າ​ທັງຫລາຍ​ບໍ່​ຮູ້​ວ່າ​ເຈົ້າຂອງ​ເຮືອນ​ຈະ​ກັບ​ມາ​ເມື່ອ​ໃດ, ຈະ​ກັບ​ມາ​ເວລາ​ຄ່ຳ ຫລື ເວລາ​ທ່ຽງຄືນ, ເວລາ​ໄກ່ຂັນ, ຫລື ເວລາ​ຮຸ່ງເຊົ້າ. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />ຖ້າ​ເພິ່ນ​ກັບ​ມາ​ກະທັນຫັນ ກໍ​ຢ່າ​ໃຫ້​ເພິ່ນ​ຈະ​ພົບ​ວ່າ​ພວກເຈົ້າ​ກຳລັງ​ຫລັບ​ຢູ່. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />ສິ່ງ​ທີ່​ເຮົາ​ໄດ້​ກ່າວ​ກັບ​ພວກເຈົ້າ​ນີ້ ເຮົາ​ກໍ​ກ່າວ​ເຕືອນ​ແກ່​ທຸກຄົນ​ເໝືອນ​ກັນ​ວ່າ: ‘ຈົ່ງ​ເຝົ້າ​ລະວັງ​ຢູ່!’ ”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ໄດ້​ຮັບ​ການຫົດສົງ​ທີ່​ເບັດທານີ</para>
  <para style="r">(ມທ 26:2-16; ລກ 22:1-6)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />ບັດນີ້ ຍັງ​ອີກ​ສອງ​ວັນ​ກໍ​ຈະ​ເຖິງ​ເທດສະການ​ປັດສະຄາ ແລະ ເທດສະການ​ເຂົ້າຈີ່​ບໍ່​ມີ​ເຊື້ອແປ້ງ, ພວກຫົວໜ້າ​ປະໂລຫິດ ແລະ ພວກ​ຄູສອນກົດບັນຍັດ​ຕ່າງ​ກໍ​ກຳລັງ​ຊອກຫາ​ກົນອຸບາຍ​ທີ່​ຈະ​ຈັບ​ພຣະເຢຊູເຈົ້າ ແລະ ຂ້າ​ພຣະອົງ. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />ຄື​ພວກເຂົາ​ເວົ້າ​ວ່າ, “ແຕ່​ຢ່າ​ເຮັດ​ໃນ​ລະຫວ່າງ​ເທດສະການ ບໍ່​ດັ່ງນັ້ນ​ປະຊາຊົນ​ອາດ​ຈະ​ກໍ່​ຄວາມວຸ້ນວາຍ”.<verse eid="MRK 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />ໃນຂະນະ​ທີ່​ພຣະອົງ​ຢູ່​ທີ່​ບ້ານ​ເບັດທານີ, ກຳລັງ​ນັ່ງເອນໂຕ​ຢູ່​ທີ່​ໂຕະ​ອາຫານ​ທີ່​ຢູ່​ໃນ​ເຮືອນ​ຂອງ​ຊີໂມນ​ຜູ້​ທີ່​ເປັນ​ພະຍາດຂີ້ທູດ, ມີ​ຍິງ​ຄົນ​ໜຶ່ງ​ເຂົ້າ​ມາ​ພ້ອມດ້ວຍ​ເຕົ້າຫີນຂາວ ເຊິ່ງ​ບັນຈຸ​ນ້ຳຫອມ​ທີ່​ມີ​ລາຄາ​ແພງ, ນ້ຳຫອມ​ນັ້ນ​ເຮັດ​ຈາກ​ເຄື່ອງຫອມ​ບໍລິສຸດ. ນາງ​ໄດ້​ຫັກ​ຄໍ​ເຕົ້າ​ນັ້ນ ແລະ ຖອກ​ນ້ຳຫອມ​ຫົດສົງ​ຫົວ​ພຣະອົງ.<verse eid="MRK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4" />ມີ​ບາງຄົນ​ໃນ​ທີ່​ນັ້ນ​ບໍ່​ພໍໃຈ ຈຶ່ງ​ເວົ້າ​ກັນ​ວ່າ, “ເປັນຫຍັງ​ຈຶ່ງ​ເຮັດ​ໃຫ້​ນ້ຳຫອມ​ນີ້​ເສຍ​ໄປ​ລ້າໆ? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />ນ້ຳຫອມ​ນີ້​ສາມາດ​ຂາຍ​ໄດ້​ໃນ​ລາຄາ​ສູງ​ຫລາຍ​ກວ່າ​ຄ່າຈ້າງ​ຂອງ​ຄົນງານ​ຜູ້​ໜຶ່ງ​ໝົດ​ທັງ​ປີ<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="ft" closed="false">ພາສາ​ກຣີກ​ວ່າ </char><char style="fqa" closed="false">ຫລາຍ​ກວ່າ 300 ເດນາຣິອົນ </char><char style="ft" closed="false">ເຊິ່ງ 1 ເດນາຣິອົນ​ມີ​ຄ່າ​ເທົ່າ​ກັບ​ຄ່າແຮງງານ 1 ມື້</char></note> ເພື່ອ​ຈະ​ໄດ້​ເອົາ​ເງິນ​ໄປ​ໃຫ້​ຄົນຍາກຈົນ”. ແລ້ວ​ພວກເຂົາ​ກໍ​ຕຳໜິ​ຍິງ​ຜູ້​ນີ້​ຢ່າງ​ໜັກ.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />ແຕ່​ພຣະເຢຊູເຈົ້າ​ກ່າວ​ວ່າ, “ປ່ອຍ​ນາງ​ເທາະ, ພວກເຈົ້າ​ໄປ​ກວນໃຈ​ນາງ​ເຮັດ​ຫຍັງ? ນາງ​ໄດ້​ເຮັດ​ສິ່ງ​ດີ​ງາມ​ໃຫ້​ແກ່​ເຮົາ. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />ພວກເຈົ້າ​ຈະ​ມີ​ຄົນຍາກຈົນ​ຢູ່​ກັບ​ພວກເຈົ້າ​ສະເໝີ ແລະ ພວກເຈົ້າ​ສາມາດ​ຊ່ວຍ​ພວກເຂົາ​ໄດ້​ທຸກ​ເວລາ​ຕາມ​ທີ່​ພວກເຈົ້າ​ຕ້ອງການ. ແຕ່​ພວກເຈົ້າ​ຈະ​ບໍ່​ມີ​ເຮົາ​ຢູ່​ນໍາ​ສະເໝີ​ໄປ. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />ນາງ​ເຮັດ​ເທົ່າ​ທີ່​ນາງ​ເຮັດ​ໄດ້. ນາງ​ຖອກ​ນ້ຳຫອມ​ໃສ່​ຮ່າງກາຍ​ຂອງ​ເຮົາ​ກໍ​ເພື່ອ​ເປັນ​ການ​ຕຽມ​ພິທີ​ຝັງສົບ​ຂອງ​ເຮົາ​ໄວ້​ລ່ວງໜ້າ. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />ເຮົາ​ບອກ​ພວກເຈົ້າ​ຕາມ​ຄວາມຈິງ​ວ່າ, ຂ່າວປະເສີດ​ຖືກ​ປະກາດ​ໄປ​ທີ່​ໃດ​ກໍ​ຕາມ​ໃນ​ທົ່ວ​ໂລກ, ສິ່ງ​ທີ່​ຍິງ​ຜູ້​ນີ້​ໄດ້​ເຮັດ​ຈະ​ເປັນ​ທີ່​ກ່າວ​ອອກ​ໄປ​ເໝືອນກັນ, ເພື່ອ​ເປັນ​ການລະນຶກ​ເຖິງ​ນາງ”.<verse eid="MRK 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />ແລ້ວ​ຢູດາ​ອິດສະກາຣີອົດ, ຄົນ​ໜຶ່ງ​ໃນ​ພວກສາວົກ​ສິບສອງ​ຄົນ, ກໍ​ໄດ້​ໄປ​ພົບ​ພວກຫົວໜ້າ​ປະໂລຫິດ​ເພື່ອ​ຈະ​ມອບ​ພຣະເຢຊູເຈົ້າ​ໃຫ້​ພວກເຂົາ. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />ບັນດາ​ຫົວໜ້າ​ປະໂລຫິດ​ດີໃຈ​ຫລາຍ​ທີ່​ໄດ້​ຍິນ​ເລື່ອງ​ນີ້ ແລະ ສັນຍາ​ວ່າ​ຈະ​ເອົາ​ເງິນ​ໃຫ້​ລາວ. ດັ່ງນັ້ນ ຢູດາ​ຈຶ່ງ​ຊອກຫາ​ໂອກາດ​ທີ່​ຈະ​ມອບ​ພຣະເຢຊູເຈົ້າ​ແກ່​ພວກເຂົາ.<verse eid="MRK 14:11" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຮັບປະທານ​ອາຫານ​ປັດສະຄາ​ກັບ​ສາວົກ</para>
  <para style="r">(ມທ 26:17-30; ລກ 22:7-23)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />ໃນ​ວັນ​ທີ​ໜຶ່ງ​ຂອງ​ເທດສະການ​ເຂົ້າຈີ່​ບໍ່ມີເຊື້ອແປ້ງ, ເຊິ່ງ​ຕາມ​ທຳນຽມ​ຈະ​ຖວາຍ​ລູກແກະ​ປັດສະຄາ, ບັນດາ​ສາວົກ​ຂອງ​ພຣະເຢຊູເຈົ້າ​ໄດ້​ຖາມ​ພຣະອົງ​ວ່າ, “ທ່ານ​ຢາກ​ໃຫ້​ພວກຂ້ານ້ອຍ​ໄປ​ຈັດຕຽມ​ອາຫານ​ປັດສະຄາ​ໃຫ້​ທ່ານ​ຮັບປະທານ​ຢູ່​ທີ່​ໃດ?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />ດັ່ງນັ້ນ ພຣະອົງ​ຈຶ່ງ​ໃຊ້​ສາວົກ​ສອງ​ຄົນ​ໃນ​ພວກເພິ່ນ​ໄປ​ພ້ອມ​ກັບ​ບອກ​ພວກເພິ່ນ​ວ່າ, “ຈົ່ງ​ເຂົ້າໄປ​ໃນ​ເມືອງ ແລະ ຈະ​ມີ​ຊາຍ​ຄົນ​ໜຶ່ງ​ແບກ​ໄຫນ້ຳ​ມາ​ພົບ​ພວກເຈົ້າ. ຈົ່ງ​ຕາມ​ລາວ​ໄປ. <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />ຈົ່ງ​ບອກ​ເຈົ້າຂອງ​ເຮືອນ​ທີ່​ລາວ​ເຂົ້າໄປ​ນັ້ນ​ວ່າ, ‘ອາຈານ​ຖາມ​ວ່າ: ຫ້ອງ​ຮັບແຂກ​ຂອງ​ເຮົາ ຢູ່​ທີ່​ໃດ, ບ່ອນ​ທີ່​ເຮົາ​ຈະ​ຮັບປະທານ​ອາຫານ​ປັດສະຄາ​ຮ່ວມ​ກັບ​ພວກສາວົກ​ຂອງ​ເຮົາ​ຢູ່​ທີ່​ໃດ?’ <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />ແລ້ວ​ລາວ​ກໍ​ຈະ​ພາ​ພວກເຈົ້າ​ໄປ​ເບິ່ງ​ຫ້ອງ​ໃຫຍ່​ຊັ້ນເທິງ ເຊິ່ງ​ຕົບແຕ່ງ​ຕຽມ​ໄວ້​ຮຽບຮ້ອຍ​ແລ້ວ. ຈົ່ງ​ຕຽມ​ທຸກສິ່ງ​ໄວ້​ສຳລັບ​ພວກເຮົາ​ຢູ່​ບ່ອນ​ນັ້ນ”.<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />ພວກສາວົກ​ກໍ​ໄປ ແລະ ໄດ້​ເຂົ້າໄປ​ໃນ​ເມືອງ ແລ້ວ​ກໍ​ພົບ​ສິ່ງ​ຕ່າງໆ​ຕາມ​ທີ່​ພຣະເຢຊູເຈົ້າ​ໄດ້​ບອກ​ພວກເພິ່ນ​ໄວ້. ດັ່ງນັ້ນ ພວກເພິ່ນ​ຈຶ່ງ​ໄດ້​ຈັດຕຽມ​ປັດສະຄາ​ໄວ້.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />ເມື່ອ​ເຖິງ​ຕອນຄ່ຳ​ມາ ພຣະເຢຊູເຈົ້າ​ກໍ​ມາ​ພ້ອມ​ກັບ​ພວກສາວົກ​ສິບສອງ​ຄົນ. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />ໃນ​ຂະນະ​ທີ່​ພວກເພິ່ນ​ກຳລັງ​ນັ່ງເອນໂຕ​ຮັບປະທານ​ອາຫານ​ຢູ່​ທີ່​ໂຕະອາຫານ ພຣະອົງ​ກ່າວ​ວ່າ, “ເຮົາ​ບອກ​ພວກເຈົ້າ​ຕາມ​ຄວາມຈິງ​ວ່າ, ຜູ້​ໜຶ່ງ​ໃນ​ພວກເຈົ້າ​ຈະ​ທໍລະຍົດ​ຕໍ່​ເຮົາ ຄື​ຜູ້​ທີ່​ກຳລັງ​ຮັບປະທານ​ອາຫານ​ຮ່ວມ​ກັບ​ເຮົາ”.<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />ພວກສາວົກ​ຕ່າງ​ກໍ​ເສຍໃຈ ແລະ ຖາມ​ພຣະອົງ​ເທື່ອລະຄົນ​ວ່າ, “ພຣະອົງ​ຄົງ​ບໍ່​ໝາຍ​ເຖິງ​ຂ້ານ້ອຍ​ແມ່ນ​ບໍ?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />ພຣະເຢຊູເຈົ້າ​ຕອບ​ວ່າ, “ແມ່ນ​ຄົນ​ໜຶ່ງ​ໃນ​ພວກເຈົ້າ​ສິບສອງ​ຄົນ​ນີ້​ແຫລະ ເປັນ​ຄົນ​ທີ່​ຢິບ​ອາຫານ​ຈຸ່ມ​ໃນ​ຖ້ວຍ​ດຽວ​ກັນ​ກັບ​ເຮົາ. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />ບຸດມະນຸດ​ຈະ​ຕ້ອງ​ເປັນ​ໄປ​ຕາມ​ທີ່​ມີ​ຄຳ​ຂຽນ​ໄວ້​ໃນ​ພຣະຄຳພີ​ກ່ຽວກັບ​ພຣະອົງ. ແຕ່​ວິບັດ​ຈະ​ມີ​ແກ່​ຜູ້​ນັ້ນ​ທີ່​ທໍລະຍົດ​ຕໍ່​ບຸດມະນຸດ! ຖ້າ​ລາວ​ບໍ່​ໄດ້​ເກີດ​ມາ​ເລີຍ​ກໍ​ຈະ​ດີ​ຕໍ່​ລາວ​ຫລາຍ​ກວ່າ”.<verse eid="MRK 14:21" /></para>
  <para style="s1">ພິທີ​ສິນມະຫາສະໜິດ</para>
  <para style="r">(ມທ 26:26-29; ລກ 22:15-20; 1ກຣທ 11:23-26)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />ໃນ​ຂະນະ​ທີ່​ພວກເພິ່ນ​ກຳລັງ​ຮັບປະທານ​ອາຫານ​ຢູ່​ນັ້ນ, ພຣະເຢຊູເຈົ້າ​ໄດ້​ຈັບ​ເອົາ​ເຂົ້າຈີ່​ຂຶ້ນ​ມາ ແລະ ເມື່ອ​ພຣະອົງ​ໂມທະນາ​ຂອບພຣະຄຸນ​ພຣະເຈົ້າ​ແລ້ວ, ພຣະອົງ​ຫັກ​ເຂົ້າຈີ່​ນັ້ນ​ແລ້ວ​ຍື່ນ​ໃຫ້​ພວກສາວົກ ແລະ ກ່າວ​ວ່າ, “ຈົ່ງ​ຮັບ​ເອົາ​ເຂົ້າຈີ່​ນີ້, ນີ້​ຄື​ກາຍ​ຂອງ​ເຮົາ”.<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />ແລ້ວ​ພຣະອົງ​ກໍ​ຈັບ​ເອົາ​ຈອກ​ມາ ແລະ ເມື່ອ​ພຣະອົງ​ໂມທະນາ​ຂອບພຣະຄຸນ​ພຣະເຈົ້າ​ແລ້ວ, ພຣະອົງ​ຍື່ນ​ຈອກ​ນັ້ນ​ໃຫ້​ພວກເພິ່ນ ແລະ ພວກເພິ່ນ​ທຸກຄົນ​ກໍ​ດື່ມ​ຈາກ​ຈອກ​ນັ້ນ.<verse eid="MRK 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 14:24" />ພຣະເຢຊູເຈົ້າ​ກ່າວ​ກັບ​ພວກເພິ່ນ​ວ່າ, “ນີ້​ຄື​ເລືອດ​ຂອງ​ເຮົາ ເຊິ່ງ​ເປັນ​ເລືອດ​ແຫ່ງ​ພັນທະສັນຍາ<note caller="+" style="f"><char style="fr" closed="false">14:24 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ບາງ​ສະບັບ​ວ່າ </char><char style="fqa" closed="false">ພັນທະສັນຍາ​ໃໝ່</char></note> ທີ່​ຖອກ​ອອກ​ມາ​ເພື່ອ​ຄົນ​ທັງຫລາຍ. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />ເຮົາ​ບອກ​ພວກເຈົ້າ​ຕາມ​ຄວາມຈິງ​ວ່າ, ເຮົາ​ຈະ​ບໍ່​ດື່ມ​ນ້ຳ​ຈາກ​ໝາກອະງຸ່ນ​ນີ້​ອີກ​ຈົນ​ຈະ​ເຖິງ​ວັນ​ນັ້ນ​ທີ່​ເຮົາ​ຈະ​ດື່ມ​ນໍ້າອະງຸ່ນໃໝ່​ໃນ​ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ”.<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />ເມື່ອ​ພວກເພິ່ນ​ຮ້ອງເພງ​ສັນລະເສີນ​ບົດ​ໜຶ່ງ​ແລ້ວ ພວກເພິ່ນ​ກໍ​ພາກັນ​ອອກ​ໄປ​ທີ່​ພູເຂົາ​ໝາກກອກ.<verse eid="MRK 14:26" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ທຳນວາຍ​ວ່າ​ເປໂຕ​ຈະ​ປະຕິເສດ​ພຣະອົງ</para>
  <para style="r">(ມທ 26:31-35)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />ພຣະເຢຊູເຈົ້າ​ກ່າວ​ແກ່​ພວກສາວົກ​ວ່າ, “ພວກເຈົ້າ​ທຸກຄົນ​ຈະ​ປະຖິ້ມ​ເຮົາ​ໄປ ເພາະ​ມີ​ຄຳຂຽນ​ໄວ້​ໃນ​ພຣະຄຳພີ​ວ່າ:</para>
  <para style="q1" vid="MRK 14:27">“ ‘ເຮົາ​ຈະ​ຟາດ​ຜູ້ລ້ຽງແກະ</para>
  <para style="q2" vid="MRK 14:27">ແລະ ຝູງ​ແກະ​ຈະ​ກະຈັດກະຈາຍ​ໄປ’.<note caller="+" style="f"><char style="fr" closed="false">14:27 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 13:7">ຊກຢ 13:7</ref></char></char></note><verse eid="MRK 14:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28" />ແຕ່​ຫລັງຈາກ​ທີ່​ເຮົາ​ເປັນຄືນມາຈາກຕາຍ​ແລ້ວ ເຮົາ​ຈະ​ໄປ​ທີ່​ແຂວງ​ຄາລີເລ​ກ່ອນໜ້າ​ພວກເຈົ້າ”.<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />ເປໂຕ​ປະກາດ​ວ່າ, “ເຖິງ​ແມ່ນ​ວ່າ​ທຸກຄົນ​ຈະ​ປະຖິ້ມ​ພຣະອົງ​ໄປ​ກໍ​ຕາມ ຂ້ານ້ອຍ​ຈະ​ບໍ່​ໜີ​ໄປ​ຈາກ​ພຣະອົງ”.<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />ພຣະເຢຊູເຈົ້າ​ຕອບ​ວ່າ, “ເຮົາ​ບອກ​ເຈົ້າ​ຕາມ​ຄວາມຈິງ​ວ່າ, ວັນ​ນີ້, ຄືນ​ນີ້​ແຫລະ ກ່ອນ​ໄກ່​ຂັນ​ສອງ​ເທື່ອ<note caller="+" style="f"><char style="fr" closed="false">14:30 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ໃນ​ຍຸກ​ທຳອິດ​ບາງສະບັບ​ບໍ່​ມີ​ຄຳ​ວ່າ </char><char style="fqa" closed="false">ສອງ​ເທື່ອ</char></note> ເຈົ້າ​ເອງ​ຈະ​ປະຕິເສດ​ວ່າ​ບໍ່​ຮູ້ຈັກ​ເຮົາ​ສາມ​ເທື່ອ”.<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />ແຕ່​ເປໂຕ​ຍັງ​ຢືນຢັນ​ຢ່າງ​ໜັກແໜ້ນ​ວ່າ, “ເຖິງ​ແມ່ນ​ຂ້ານ້ອຍ​ຈະ​ຕ້ອງ​ຕາຍ​ກັບ​ພຣະອົງ, ຂ້ານ້ອຍ​ກໍ​ຈະ​ບໍ່​ປະຕິເສດ​ພຣະອົງ”. ແລ້ວ​ພວກສາວົກ​ທຸກຄົນ​ກໍ​ເວົ້າ​ຢ່າງ​ນັ້ນ​ເໝືອນກັນ.<verse eid="MRK 14:31" /></para>
  <para style="s1">ເຄັດເຊມາເນ</para>
  <para style="r">(ມທ 26:36-46; ລກ 22:40-46)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />ແລ້ວ​ພວກເພິ່ນ​ໄດ້​ໄປ​ບ່ອນ​ໜຶ່ງ​ທີ່​ຊື່​ວ່າ​ເຄັດເຊມາເນ, ພຣະເຢຊູເຈົ້າ​ກ່າວ​ແກ່​ພວກສາວົກ​ຂອງ​ພຣະອົງ​ວ່າ, “ຈົ່ງ​ນັ່ງ​ຢູ່​ທີ່​ນີ້​ຂະນະ​ທີ່​ເຮົາ​ອະທິຖານ”. <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />ພຣະອົງ​ໄດ້​ເອົາ​ເປໂຕ, ຢາໂກໂບ ແລະ ໂຢຮັນ​ໄປ​ກັບ​ພຣະອົງ, ພຣະອົງ​ເລີ່ມ​ໂສກເສົ້າ ແລະ ເປັນທຸກໃຈ​ຫລາຍ. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />ພຣະອົງ​ຈຶ່ງ​ກ່າວ​ແກ່​ພວກເພິ່ນ​ວ່າ. “ຈິດໃຈ​ຂອງ​ເຮົາ​ກໍ​ເຕັມ​ໄປ​ດ້ວຍ​ຄວາມໂສກເສົ້າ​ໃກ້​ຈະ​ຕາຍ​ຢູ່​ແລ້ວ. ຈົ່ງ​ເຝົ້າ​ລະວັງ​ຢູ່​ທີ່​ນີ້”.<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />ພຣະອົງ​ຍ່າງ​ໄປ​ອີກ​ໜ້ອຍໜຶ່ງ, ພຣະອົງ​ໝູບ​ລົງ​ພື້ນດິນ ແລະ ອະທິຖານ​ວ່າ​ຖ້າ​ເປັນ​ໄປ​ໄດ້​ຂໍ​ໃຫ້​ຊົ່ວໂມງ​ນີ້​ຜ່ານພົ້ນ​ໄປ​ຈາກ​ພຣະອົງ. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />ພຣະອົງ​ກ່າວ​ວ່າ, “ອັບບາ<note caller="+" style="f"><char style="fr" closed="false">14:36 </char><char style="ft" closed="false">ເປັນ​ພາສາ​ອາຣາມິກ ໝາຍ​ເຖິງ </char><char style="fqa" closed="false">ພໍ່</char></note> ພຣະບິດາເຈົ້າ​ເອີຍ, ທຸກສິ່ງ​ເປັນ​ໄປ​ໄດ້​ສຳລັບ​ພຣະອົງ. ຂໍ​ເອົາ​ຈອກ​ນີ້​ໄປ​ຈາກ​ລູກ​ດ້ວຍ. ແຕ່​ເຖິງຢ່າງໃດ​ກໍ​ຕາມ​ຢ່າ​ໃຫ້​ເປັນ​ໄປ​ຕາມ​ຄວາມ​ປະສົງ​ຂອງ​ລູກ, ແຕ່​ຂໍ​ໃຫ້​ເປັນ​ໄປ​ຕາມ​ຄວາມ​ປະສົງ​ຂອງ​ພຣະອົງ”.<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />ແລ້ວ​ພຣະອົງ​ກໍ​ກັບ​ຄືນ​ມາ​ຫາ​ພວກສາວົກ​ຂອງ​ພຣະອົງ ແລະ ພົບ​ວ່າ​ພວກເພິ່ນ​ກຳລັງ​ນອນຫລັບ​ຢູ່ ພຣະອົງ​ຈຶ່ງ​ກ່າວ​ກັບ​ເປໂຕ​ວ່າ, “ຊີໂມນ​ເອີຍ, ເຈົ້າ​ນອນຫລັບ​ຢູ່​ບໍ? ເຈົ້າ​ຈະ​ເຝົ້າລະວັງ​ຢູ່​ຈັກ​ຊົ່ວໂມງ​ດຽວ​ບໍ່​ໄດ້​ບໍ? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />ຈົ່ງ​ເຝົ້າລະວັງ ແລະ ອະທິຖານ​ຢູ່ ເພື່ອ​ພວກເຈົ້າ​ຈະ​ບໍ່​ຕົກ​ເຂົ້າ​ໄປ​ໃນ​ການທົດລອງ. ຈິດວິນຍານ​ພ້ອມ​ຢູ່​ແລ້ວ​ກໍ​ຈິງ ແຕ່​ຮ່າງກາຍ​ກໍ​ອ່ອນກຳລັງ”.<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />ພຣະອົງ​ໄດ້​ໄປ ແລະ ອະທິຖານ​ຢ່າງ​ດຽວ​ກັນ​ອີກ​ເທື່ອ​ໜຶ່ງ. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />ເມື່ອ​ພຣະອົງ​ກັບ​ຄືນ​ມາ​ກໍ​ພົບ​ວ່າ​ພວກເພິ່ນ​ຍັງ​ນອນຫລັບ​ຢູ່​ຄືເກົ່າ ເພາະວ່າ​ພວກເພິ່ນ​ເຫງົານອນ​ຫລາຍ​ຈົນ​ມືນຕາ​ບໍ່​ຂຶ້ນ. ພວກເພິ່ນ​ກໍ​ບໍ່​ຮູ້​ວ່າ​ຈະ​ເວົ້າ​ກັບ​ພຣະອົງ​ຢ່າງໃດ.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />ເມື່ອ​ພຣະອົງ​ກັບ​ຄືນ​ມາ​ເປັນ​ເທື່ອ​ທີ​ສາມ ພຣະອົງ​ກໍ​ກ່າວ​ກັບ​ພວກເພິ່ນ​ວ່າ, “ພວກເຈົ້າ​ຍັງ​ນອນຫລັບ ແລະ ພັກຜ່ອນ​ຢູ່​ບໍ? ພໍ​ແລ້ວ! ເວລາ​ມາ​ຮອດ​ແລ້ວ. ເບິ່ງ​ແມ, ບຸດມະນຸດ​ກຳລັງ​ຈະ​ຖືກ​ມອບໄວ້​ໃນ​ມື​ຂອງ​ຄົນບາບ​ທັງຫລາຍ. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />ຈົ່ງ​ລຸກຂຶ້ນ! ພາກັນ​ໄປ​ເທາະ! ຜູ້​ທີ່​ທໍລະຍົດ​ເຮົາ​ກໍ​ມາ​ທີ່​ນີ້​ແລ້ວ!”<verse eid="MRK 14:42" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຖືກ​ຈັບກຸມ</para>
  <para style="r">(ມທ 26:47-56; ລກ 22:47-50; ຢຮ 18:3-11)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />ເມື່ອ​ພຣະເຢຊູເຈົ້າ​ກ່າວ​ຍັງ​ບໍ່​ທັນ​ສຸດ​ຄຳ, ຢູດາ ໜຶ່ງ​ໃນ​ພວກສາວົກ​ສິບສອງ​ຄົນ​ກໍ​ມາ​ປາກົດ. ມີ​ປະຊາຊົນ​ຈຳນວນ​ຫລວງຫລາຍ​ຖື​ດາບ ແລະ ໄມ້ຄ້ອນ​ມາ​ກັບ​ລາວ​ດ້ວຍ, ເຊິ່ງ​ເປັນ​ຄົນ​ທີ່​ພວກຫົວໜ້າ​ປະໂລຫິດ, ພວກ​ຄູສອນກົດບັນຍັດ ແລະ ພວກ​ເຖົ້າແກ່​ໃຊ້​ມາ.<verse eid="MRK 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 14:44" />ຜູ້ທໍລະຍົດ​ໄດ້​ກຳນົດ​ສັນຍານ​ກັບ​ພວກເຂົາ​ວ່າ, “ຜູ້ໃດ​ທີ່​ເຮົາ​ຈູບຄຳນັບ​ແມ່ນ​ຜູ້​ນັ້ນ ຈົ່ງ​ໄປ​ຈັບກຸມ​ລາວ ແລະ ເອົາ​ລາວ​ອອກ​ໄປ​ໃຫ້​ຢູ່​ໃຕ້​ການຄວບຄຸມ”. <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />ຢູດາ​ກໍ​ເຂົ້າ​ໄປ​ຫາ​ພຣະເຢຊູເຈົ້າ​ທັນທີ ແລະ ເວົ້າ​ວ່າ, “ຣັບບີ​ເອີຍ!” ແລ້ວ​ກໍ​ຈູບ​ພຣະອົງ. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />ດັ່ງນັ້ນ ພວກເຂົາ​ຈຶ່ງ​ຄວ້າຈັບ​ພຣະເຢຊູເຈົ້າ ແລະ ຈັບ​ພຣະອົງ​ໄວ້. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />ແລ້ວ​ມີ​ຄົນ​ໜຶ່ງ​ໃນ​ຈຳນວນ​ຄົນ​ທີ່​ຢືນ​ຢູ່​ໃນ​ທີ່​ນັ້ນ​ໄດ້​ຊັກ​ດາບ​ອອກມາ​ຟັນ​ຫູ​ຄົນຮັບໃຊ້​ຂອງ​ມະຫາ​ປະໂລຫິດ​ຂາດ​ເບື້ອງໜຶ່ງ.<verse eid="MRK 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48" />ພຣະເຢຊູເຈົ້າ​ໄດ້​ກ່າວ​ວ່າ, “ເຮົາ​ກຳລັງ​ກໍ່​ການກະບົດ​ບໍ ພວກເຈົ້າ​ຖື​ດາບ​ຖື​ໄມ້ຄ້ອນ​ມາ​ຈັບ​ເຮົາ? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />ເຮົາ​ຢູ່​ກັບ​ພວກເຈົ້າ, ສັ່ງສອນ​ຢູ່​ໃນ​ເດີ່ນ​ວິຫານ​ທຸກ​ວັນ ແລະ ພວກເຈົ້າ​ກໍ​ບໍ່​ໄດ້​ຈັບ​ເຮົາ. ແຕ່​ຈະ​ຕ້ອງ​ສຳເລັດ​ຕາມ​ທີ່​ກ່າວ​ໄວ້​ໃນ​ພຣະຄຳພີ”. <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />ແລ້ວ​ທຸກຄົນ​ໄດ້​ປະຖິ້ມ​ພຣະອົງ ແລະ ໜີ​ໄປ.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />ມີ​ຊາຍ​ໜຸ່ມ​ຄົນ​ໜຶ່ງ​ນຸ່ງ​ຜ້າຝ້າຍລິນິນ​ແຕ່​ຜືນ​ດຽວ​ຕິດຕາມ​ພຣະເຢຊູເຈົ້າ​ໄປ. ພວກເຂົາ​ໄດ້​ຄວ້າຈັບ​ຊາຍ​ໜຸ່ມ​ນັ້ນ, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />ລາວ​ໄດ້​ປະ​ຜ້າ​ຜືນ​ທີ່​ນຸ່ງ​ຢູ່​ນັ້ນ​ຖິ້ມ ແລະ ໜີ​ໄປ​ໂຕ​ເປົ່າ.<verse eid="MRK 14:52" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຕໍ່ໜ້າ​ສະພາ​ແຊນເຮດຣິນ</para>
  <para style="r">(ມທ 26:57-68; ລກ 22:67-71; ຢຮ 18:12,13,19-24)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />ພວກເຂົາ​ໄດ້​ພາ​ພຣະເຢຊູເຈົ້າ​ໄປ​ຫາ​ມະຫາ​ປະໂລຫິດ, ບ່ອນ​ທີ່​ພວກຫົວໜ້າ​ປະໂລຫິດ, ພວກ​ເຖົ້າແກ່ ແລະ ພວກ​ຄູສອນກົດບັນຍັດ​ໄດ້​ພາກັນ​ມາ​ເຕົ້າໂຮມກັນ​ຢູ່. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />ສ່ວນ​ເປໂຕ​ໄດ້​ຕິດຕາມ​ພຣະອົງ​ໄປ​ໃນ​ໄລຍະ​ຫ່າງໆ ແລະ ເຂົ້າ​ໄປ​ໃນ​ເດີ່ນບ້ານ​ຂອງ​ມະຫາ​ປະໂລຫິດ. ແລ້ວ​ນັ່ງ​ຝີງໄຟ​ຢູ່​ກັບ​ພວກທະຫານຍາມ.<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />ພວກຫົວໜ້າ​ປະໂລຫິດ ແລະ ສະມາຊິກ​ສະພາ​ແຊນເຮດຣິນ​ທັງໝົດ ໄດ້​ຊອກຫາ​ຫລັກຖານ​ມາ​ຕໍ່ສູ້​ພຣະເຢຊູເຈົ້າ​ເພື່ອ​ວ່າ​ພວກເຂົາ​ຈະ​ໄດ້​ຂ້າ​ພຣະອົງ, ແຕ່​ພວກເຂົາ​ກໍ​ຊອກຫາ​ຫລັກຖານ​ບໍ່​ໄດ້. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />ມີ​ຫລາຍ​ຄົນ​ກ່າວ​ຄຳພະຍານ​ບໍ່​ຈິງ​ຕໍ່ສູ້​ພຣະອົງ, ແຕ່​ຄຳເວົ້າ​ຂອງ​ພວກເຂົາ​ຂັດແຍ້ງ​ກັນ​ເອງ.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />ຕໍ່ມາ ມີ​ບາງຄົນ​ຢືນຂຶ້ນ​ກ່າວ​ຄຳພະຍານ​ບໍ່​ຈິງ​ຕໍ່ສູ້​ພຣະອົງ​ວ່າ: <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“ພວກເຮົາ​ໄດ້​ຍິນ​ລາວ​ກ່າວ​ວ່າ, ‘ເຮົາ​ຈະ​ມ້າງ​ວິຫານ​ຫລັງ​ນີ້​ທີ່​ສ້າງຂຶ້ນ​ດ້ວຍ​ມື​ມະນຸດ ແລະ ໃນ​ສາມ​ວັນ​ເຮົາ​ຈະ​ສ້າງຂຶ້ນ​ໃໝ່ ເຊິ່ງ​ບໍ່​ໄດ້​ສ້າງ​ດ້ວຍ​ມື​ມະນຸດ’ ”. <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />ເຖິງ​ປານ​ນັ້ນ ຄຳພະຍານ​ຂອງ​ພວກເຂົາ​ກໍ​ຍັງ​ຂັດແຍ້ງ​ກັນ.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />ມະຫາ​ປະໂລຫິດ​ຈຶ່ງ​ລຸກ​ຂຶ້ນ​ຢືນ​ຕໍ່ໜ້າ​ພວກເຂົາ ແລະ ຖາມ​ພຣະເຢຊູເຈົ້າ​ວ່າ, “ເຈົ້າ​ຈະ​ບໍ່​ຕອບ​ຫຍັງ​ບໍ? ຄຳພະຍານ​ທີ່​ຄົນ​ເຫລົ່ານີ້​ກ່າວ​ຕໍ່ສູ້​ເຈົ້າ​ເປັນ​ແນວໃດ?” <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />ແຕ່​ພຣະເຢຊູເຈົ້າ​ຍັງ​ມິດງຽບ​ຢູ່ ແລະ ບໍ່​ໄດ້​ຕອບ​ຫຍັງ.</para>
  <para style="p" vid="MRK 14:61">ມະຫາ​ປະໂລຫິດ​ຈຶ່ງ​ຖາມ​ພຣະອົງ​ອີກ​ວ່າ, “ເຈົ້າ​ເປັນ​ພຣະຄຣິດເຈົ້າ<note caller="+" style="f"><char style="fr" closed="false">14:61 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ພຣະເມຊີອາ</char></note>​ພຣະບຸດ​ຂອງ​ພຣະເຈົ້າ ຜູ້​ເປັນ​ທີ່​ໄດ້​ຮັບ​ການ​ຍົກຍ້ອງ​ສັນເສີນ​ບໍ?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />ພຣະເຢຊູເຈົ້າ​ຕອບ​ວ່າ, “ເຮົາ​ເປັນ ແລະ ພວກເຈົ້າ​ຈະ​ໄດ້​ເຫັນ​ບຸດມະນຸດ​ນັ່ງ​ຢູ່​ເບື້ອງຂວາ​ມື​ຂອງ​ຜູ້​ມີ​ລິດອຳນາດ​ຍິ່ງໃຫຍ່ ແລະ ກຳລັງ​ມາ​ເທິງ​ເມກ​ແຫ່ງ​ສະຫວັນ”.<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />ມະຫາ​ປະໂລຫິດ​ຈຶ່ງ​ຈີກ​ເສື້ອ​ຂອງ​ຕົນ ແລະ ຖາມ​ວ່າ, “ພວກເຮົາ​ຈະ​ຕ້ອງການ​ພະຍານ​ຕື່ມ​ອີກ​ເຮັດຫຍັງ? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />ພວກເຈົ້າ​ທັງຫລາຍ​ກໍ​ໄດ້​ຍິນ​ຄຳເວົ້າ​ໝິ່ນປະໝາດ​ແລ້ວ. ພວກເຈົ້າ​ຄິດ​ຢ່າງໃດ?”</para>
  <para style="p" vid="MRK 14:64">ພວກເຂົາ​ທັງໝົດ​ເຫັນດີ​ພ້ອມກັນ​ວ່າ​ພຣະອົງ​ສົມຄວນ​ຕາຍ. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />ມີ​ບາງຄົນ​ໃນ​ພວກເຂົາ​ໄດ້​ເລີ່ມ​ຖົ່ມ​ນ້ຳລາຍ​ໃສ່​ພຣະອົງ, ພວກເຂົາ​ເອົາ​ຜ້າ​ປິດ​ຕາ​ພຣະອົງ ແລະ ທຸບຕີ​ພຣະອົງ​ດ້ວຍ​ກຳປັ້ນ​ຂອງ​ພວກເຂົາ ແລະ ເວົ້າ​ວ່າ, “ທວາຍ​ເບິ່ງ​ດູ” ແມ່ນ​ຜູ້ໃດ​ຕີ​ເຈົ້າ ແລ້ວ​ພວກ​ຍາມ​ກໍ​ເອົາ​ພຣະອົງ​ໄປ ແລະ ທຸບຕີ​ພຣະອົງ.<verse eid="MRK 14:65" /></para>
  <para style="s1">ເປໂຕ​ປະຕິເສດ​ພຣະເຢຊູເຈົ້າ</para>
  <para style="r">(ມທ 26:69-75; ລກ 22:56-62; ຢຮ 18:16-18,25-27)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />ໃນ​ຂະນະ​ທີ່​ເປໂຕ​ຍັງ​ຢູ່​ທາງລຸ່ມ​ທີ່​ເດີ່ນບ້ານ​ນັ້ນ, ມີ​ຄົນຮັບໃຊ້​ຍິງ​ຄົນ​ໜຶ່ງ​ຂອງ​ມະຫາ​ປະໂລຫິດ​ໄດ້​ຜ່ານ​ມາ. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />ເມື່ອ​ນາງ​ເຫັນ​ເປໂຕ​ຝີງໄຟ​ຢູ່, ນາງ​ກໍ​ຈ້ອງຕາ​ເບິ່ງ​ເພິ່ນ.</para>
  <para style="p" vid="MRK 14:67">ນາງ​ເວົ້າ​ວ່າ, “ເຈົ້າ​ກໍ​ເຄີຍ​ຢູ່​ກັບ​ເຢຊູ​ຊາວ​ນາຊາເຣັດ​ເໝືອນກັນ”.<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />ແຕ່​ເປໂຕ​ໄດ້​ປະຕິເສດ ແລະ ເພິ່ນ​ເວົ້າ​ວ່າ, “ຂ້ອຍ​ບໍ່​ຮູ້ ແລະ ບໍ່​ເຂົ້າໃຈ​ໃນ​ສິ່ງ​ທີ່​ເຈົ້າ​ກຳລັງ​ເວົ້າ,” ແລ້ວ​ກໍ​ຍ່າງ​ອອກ​ໄປ​ບ່ອນ​ປະຕູ​ທາງເຂົ້າ.<note caller="+" style="f"><char style="fr" closed="false">14:68 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ໃນ​ຍຸກ​ທຳອິດ​ບາງສະບັບ​ເພີ່ມ​ຂໍ້ຄວາມ​ວ່າ </char><char style="fqa" closed="false">ແລ້ວ​ໄກ່​ກໍ​ຂັນ</char></note><verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />ເມື່ອ​ສາວໃຊ້​ຄົນ​ນັ້ນ​ໄດ້​ເຫັນ​ເພິ່ນ​ຢູ່​ທີ່​ນັ້ນ ນາງ​ຈຶ່ງ​ເວົ້າ​ກັບ​ບັນດາ​ຄົນ​ທີ່​ຢືນ​ຢູ່​ແຖບ​ນັ້ນ​ອີກ​ວ່າ, “ຄົນນີ້​ກໍ​ເປັນ​ຄົນ​ໜຶ່ງ​ໃນ​ພວກເຂົາ”. <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />ແຕ່​ເປໂຕ​ໄດ້​ປະຕິເສດ​ອີກ.</para>
  <para style="p" vid="MRK 14:70">ຫລັງ​ຈາກ​ນັ້ນ​ໜ້ອຍ​ໜຶ່ງ ບັນດາ​ຄົນ​ທີ່​ຢືນ​ຢູ່​ໃກ້​ກໍ​ເວົ້າ​ຕໍ່​ເປໂຕ​ວ່າ, “ແມ່ນ​ແທ້ ເຈົ້າ​ເປັນ​ຄົນ​ໜຶ່ງ​ໃນ​ພວກເຂົາ, ເພາະ​ເຈົ້າ​ເປັນ​ຊາວ​ຄາລີເລ”.<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />ເປໂຕ​ຈຶ່ງ​ເລີ່ມ​ສາບແຊ່ງ ແລະ ສາບານ​ຕໍ່​ພວກເຂົາ​ວ່າ, “ຂ້ອຍ​ບໍ່​ຮູ້ຈັກ​ຊາຍ​ຄົນ​ນີ້”.<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />ໃນທັນໃດນັ້ນ ໄກ່​ກໍ​ຂັນ​ເປັນ​ເທື່ອ​ທີ​ສອງ.<note caller="+" style="f"><char style="fr" closed="false">14:72 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ໃນ​ຍຸກ​ທຳອິດ​ບາງ​ສະບັບ​ບໍ່​ມີ​ຂໍ້​ຄວາມ​ວ່າ </char><char style="fqa" closed="false">ເທື່ອ​ທີ​ສອງ</char></note> ເປໂຕ​ຈຶ່ງ​ຈື່​ໄດ້​ເຖິງ​ຄຳ​ທີ່​ພຣະເຢຊູເຈົ້າ​ໄດ້​ກ່າວ​ແກ່​ລາວ​ວ່າ: “ກ່ອນ​ໄກ່​ຂັນ​ສອງ​ເທື່ອ<note caller="+" style="f"><char style="fr" closed="false">14:72 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ໃນ​ຍຸກ​ທຳອິດ​ບາງ​ສະບັບ​ບໍ່​ມີ​ຂໍ້ຄວາມ​ວ່າ </char><char style="fqa" closed="false">ສອງ​ເທື່ອ</char></note> ເຈົ້າ​ຈະ​ປະຕິເສດ​ວ່າ ບໍ່​ຮູ້ຈັກ​ເຮົາ​ເຖິງ​ສາມ​ເທື່ອ”. ແລ້ວ​ເປໂຕ​ຈຶ່ງ​ຮ້ອງໄຫ້​ອອກມາ​ດ້ວຍ​ຄວາມເສຍໃຈ.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຕໍ່ໜ້າ​ປີລາດ</para>
  <para style="r">(ມທ 27:11-26; ລກ 23:2,3,18-25; <ref loc="JHN 18:29-19:16">ຢຮ 18:29–19:16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />ເມື່ອ​ຮຸ່ງເຊົ້າ​ມາ ພວກຫົວໜ້າ​ປະໂລຫິດ, ພວກ​ເຖົ້າແກ່, ພວກ​ຄູສອນກົດບັນຍັດ ແລະ ບັນດາ​ສະມາຊິກ​ສະພາ​ແຊນເຮດຣິນ​ທັງໝົດ​ໄດ້​ປຶກສາຫາລື​ກັນ​ເພື່ອ​ວາງແຜນ​ຂອງ​ພວກເຂົາ. ດັ່ງນັ້ນ ພວກເຂົາ​ໄດ້​ມັດ​ພຣະເຢຊູເຈົ້າ ແລະ ນໍາ​ພຣະອົງ​ໄປ​ມອບ​ໃຫ້​ແກ່​ປີລາດ.<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />ສ່ວນ​ປີລາດ​ໄດ້​ຖາມ​ພຣະເຢຊູເຈົ້າ​ວ່າ, “ເຈົ້າ​ເປັນ​ກະສັດ​ຂອງ​ຊາວ​ຢິວ​ບໍ?”</para>
  <para style="p" vid="MRK 15:2">ພຣະເຢຊູເຈົ້າ​ຕອບ​ວ່າ, “ແມ່ນ​ຕາມ​ທີ່​ທ່ານ​ເວົ້າ​ນັ້ນ”.<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />ພວກຫົວໜ້າ​ປະໂລຫິດ​ໄດ້​ກ່າວໂທດ​ໃສ່​ພຣະເຢຊູເຈົ້າ​ຫລາຍ​ເລື່ອງ. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />ດັ່ງນັ້ນ, ປີລາດ​ຈຶ່ງ​ຖາມ​ພຣະອົງ​ອີກ​ວ່າ, “ເຈົ້າ​ຈະ​ບໍ່​ຕອບ​ຫຍັງ​ບໍ? ເບິ່ງ​ແມ ພວກເຂົາ​ກ່າວ​ຟ້ອງ​ເຈົ້າ​ຕັ້ງ​ຫລາຍ​ຢ່າງ”.<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />ແຕ່​ພຣະເຢຊູເຈົ້າ​ບໍ່​ຕອບ​ຫຍັງ ແລະ ປີລາດ​ຈຶ່ງ​ປະຫລາດໃຈ​ຫລາຍ.<verse eid="MRK 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />ບັດນີ້ ເປັນ​ທຳນຽມ​ໃນ​ເທດສະການ​ທີ່​ຈະ​ປ່ອຍ​ນັກໂທດ​ໜຶ່ງ​ຄົນ​ຕາມ​ທີ່​ປະຊາຊົນ​ຂໍຮ້ອງ. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />ມີ​ຊາຍ​ຄົນ​ໜຶ່ງ​ຊື່​ວ່າ​ບາຣາບາ ຖືກ​ຂັງຄຸກ​ຮ່ວມ​ກັບ​ພວກກະບົດ​ທີ່​ໄດ້​ຂ້າ​ຄົນ​ໃນ​ການກະບົດ​ນັ້ນ. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />ປະຊາຊົນ​ໄດ້​ຂຶ້ນ​ໄປ​ຫາ​ປີລາດ ແລະ ໄດ້​ຂໍ​ໃຫ້​ປີລາດ​ເຮັດ​ຕາມ​ທີ່​ເພິ່ນ​ເຄີຍ​ໄດ້​ປະຕິບັດ​ມາ.<verse eid="MRK 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9" />ປີລາດ​ຈຶ່ງ​ຖາມ​ພວກເຂົາ​ວ່າ, “ພວກທ່ານ​ຢາກ​ໃຫ້​ເຮົາ​ປ່ອຍ​ກະສັດ​ຂອງ​ຊາວ​ຢິວ​ໃຫ້​ແກ່​ພວກທ່ານ​ບໍ?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />ປີລາດ​ຮູ້​ດີ​ວ່າ​ການ​ທີ່​ພວກຫົວໜ້າ​ປະໂລຫິດ​ໄດ້​ນຳ​ພຣະເຢຊູເຈົ້າ​ມາ​ມອບ​ໃຫ້​ແກ່​ຕົນ​ນັ້ນ ເພາະ​ພວກເຂົາ​ອິດສາ. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />ແຕ່​ພວກ​ຫົວໜ້າ​ປະໂລຫິດ​ໄດ້​ຍຸຍົງ​ປະຊາຊົນ​ໃຫ້​ຮ້ອງຂໍ​ປີລາດ​ໃຫ້​ປ່ອຍ​ບາຣາບາ​ແທນ.<verse eid="MRK 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 15:12" />ປີລາດ​ຖາມ​ພວກເຂົາ​ອີກ​ວ່າ, “ແລ້ວ​ພວກທ່ານ​ຈະ​ໃຫ້​ເຮົາ​ເຮັດ​ຢ່າງໃດ​ກັບ​ຜູ້​ທີ່​ພວກທ່ານ​ເອີ້ນ​ວ່າ​ກະສັດ​ຂອງ​ຊາວ​ຢິວ?” <verse eid="MRK 15:12" /><verse number="13" style="v" sid="MRK 15:13" />ພວກເຂົາ​ຮ້ອງ​ຂຶ້ນ​ວ່າ, “ຄຶງ​ມັນ​ໄວ້​ທີ່​ໄມ້ກາງແຂນ”.<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />ປີລາດ​ຈຶ່ງ​ຖາມ​ວ່າ, “ເປັນຫຍັງ? ລາວ​ໄດ້​ກໍ່​ອາດຊະຍາກຳ​ຫຍັງ?”</para>
  <para style="p" vid="MRK 15:14">ແຕ່​ພວກເຂົາ​ຍິ່ງ​ຮ້ອງ​ດັງ​ຂຶ້ນ​ອີກ​ວ່າ, “ຄຶງ​ມັນ​ໄວ້​ທີ່​ໄມ້ກາງແຂນ!”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />ເພື່ອ​ເອົາໃຈ​ປະຊາຊົນ ປີລາດ​ຈຶ່ງ​ປ່ອຍ​ບາຣາບາ​ໃຫ້​ພວກເຂົາ. ເພິ່ນ​ໄດ້​ໃຫ້​ຄົນ​ຂ້ຽນຕີ​ພຣະເຢຊູເຈົ້າ ແລະ ມອບ​ພຣະອົງ​ໃຫ້​ໄປ​ຄຶງ​ທີ່​ໄມ້ກາງແຂນ.<verse eid="MRK 15:15" /></para>
  <para style="s1">ພວກທະຫານ​ເຢາະເຢີ້ຍ​ພຣະເຢຊູເຈົ້າ</para>
  <para style="r">(ມທ 27:27-31; ຢຮ 19:2-3)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />ພວກທະຫານ​ໄດ້​ນຳ​ພຣະເຢຊູເຈົ້າ​ເຂົ້າ​ໄປ​ໃນ​ວັງ​ຂອງ​ຜູ້ປົກຄອງ (ຄື​ສານ​ເພໂທຣຽມ) ແລ້ວ​ກໍ​ເອີ້ນ​ກອງທັບທະຫານ​ມາ​ເຕົ້າໂຮມກັນ​ໃນ​ທີ່​ນັ້ນ. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />ພວກເຂົາ​ໄດ້​ເອົາ​ເສື້ອຄຸມ​ສີມ່ວງ​ມາ​ນຸ່ງ​ໃຫ້​ພຣະອົງ. ຫລັງຈາກ​ນັ້ນ ກໍ​ສານ​ມົງກຸດ​ໜາມ​ແລ້ວ​ສຸບໃສ່​ຫົວ​ຂອງ​ພຣະອົງ. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />ແລ້ວ​ພວກເຂົາ​ກໍ​ເລີ່ມ​ຮ້ອງ​ຂຶ້ນ​ວ່າ, “ກະສັດ​ແຫ່ງ​ຊາວຢິວ​ເອີຍ ຈົ່ງ​ຈະເລີນ!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />ພວກເຂົາ​ຟາດ​ຫົວ​ພຣະອົງ​ດ້ວຍ​ໄມ້ຄ້ອນ, ຟາດ​ແລ້ວ​ຟາດ​ອີກ ແລະ ຖົ່ມ​ນ້ຳລາຍ​ໃສ່​ພຣະອົງ. ພວກເຂົາ​ໄດ້​ຄຸເຂົ່າ​ລົງ​ເຮັດ​ຄື​ວ່າ​ຄຳນັບ​ພຣະອົງ. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />ແລະ ເມື່ອ​ພວກເຂົາ​ໄດ້​ເຢາະເຢີ້ຍ​ພຣະອົງ​ແລ້ວ, ພວກເຂົາ​ກໍ​ແກ້​ເສື້ອຄຸມ​ສີມ່ວງ​ອອກ ແລະ ເອົາ​ເຄື່ອງນຸ່ງ​ຂອງ​ພຣະອົງ​ເອງ​ມາ​ນຸ່ງ​ໃຫ້​ພຣະອົງ. ຫລັງຈາກນັ້ນ​ພວກເຂົາ​ໄດ້​ນຳ​ພຣະອົງ​ອອກ​ໄປ​ເພື່ອ​ຄຶງ​ພຣະອົງ​ໄວ້​ທີ່​ໄມ້ກາງແຂນ.<verse eid="MRK 15:20" /></para>
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ຖືກ​ຄຶງ​ທີ່​ໄມ້ກາງແຂນ</para>
  <para style="r">(ມທ 27:33-44; ລກ 23:33-43; ຢຮ 19:17-24)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />ຊາຍ​ຄົນ​ໜຶ່ງ​ມາ​ຈາກ​ເມືອງ​ກີເຣເນ ຊື່​ວ່າ​ຊີໂມນ, ເຊິ່ງ​ເປັນ​ພໍ່​ຂອງ​ອາເລັກຊັນເດີ ແລະ ຣູໂຟ, ລາວ​ກຳລັງ​ມາ​ແຕ່​ນອກ​ເມືອງ​ຜ່ານ​ໄປ​ທາງ​ນັ້ນ ແລະ ພວກເຂົາ​ໄດ້​ບັງຄັບ​ລາວ​ໃຫ້​ແບກ​ໄມ້ກາງແຂນ​ນັ້ນ. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />ພວກເຂົາ​ໄດ້​ພາ​ພຣະເຢຊູເຈົ້າ​ໄປ​ຍັງ​ບ່ອນ​ໜຶ່ງ​ທີ່​ເອີ້ນ​ວ່າ​ໂຄລະໂຄທາ (ເຊິ່ງ​ແປ​ວ່າ​ສະຖານທີ່​ແຫ່ງ​ກະໂຫລກຫົວ). <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />ແລ້ວ​ພວກເຂົາ​ໄດ້​ເອົາ​ເຫລົ້າອະງຸ່ນ​ປະສົມ​ກັບ​ຢາງໄມ້ຫອມ​ຊະນິດ​ໜຶ່ງ​ໃຫ້​ພຣະເຢຊູເຈົ້າ​ດື່ມ, ແຕ່​ພຣະອົງ​ບໍ່​ຍອມ​ດື່ມ. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />ພວກເຂົາ​ໄດ້​ຄຶງ​ພຣະອົງ​ທີ່​ໄມ້ກາງແຂນ​ໄວ້. ພວກເຂົາ​ໄດ້​ເອົາ​ເຄື່ອງນຸ່ງ​ຂອງ​ພຣະອົງ​ມາ​ຈັບສະຫລາກ​ແບ່ງປັນ​ກັນ​ເພື່ອ​ເບິ່ງ​ວ່າ​ແຕ່ລະຄົນ​ຈະ​ໄດ້​ອັນໃດ.<verse eid="MRK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25" />ເມື່ອ​ພວກເຂົາ​ຄຶງ​ພຣະອົງ​ທີ່​ໄມ້ກາງແຂນ​ນັ້ນ​ແມ່ນ​ເວລາ​ເກົ້າໂມງ​ເຊົ້າ. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />ມີ​ປ້າຍ​ທີ່​ພວກເຂົາ​ຂຽນ​ຂໍ້ກ່າວຫາ​ທີ່​ລົງໂທດ​ພຣະອົງ ເຊິ່ງ​ອ່ານ​ວ່າ:</para>
  <para style="pc" vid="MRK 15:26">
    <char style="sc">“ກະສັດ​ຂອງ​ຊາວຢິວ”.</char><verse eid="MRK 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 15:27" />ພວກເຂົາ​ຍັງ​ໄດ້​ຄຶງ​ໂຈນ​ສອງ​ຄົນ​ທີ່​ໄມ້ກາງແຂນ​ພ້ອມ​ກັບ​ພຣະອົງ, ຄົນ​ໜຶ່ງ​ຢູ່​ເບື້ອງຂວາ ແລະ ອີກ​ຄົນ​ໜຶ່ງ​ຢູ່​ເບື້ອງຊ້າຍ​ຂອງ​ພຣະອົງ.<note caller="+" style="f"><char style="fr" closed="false">15:27 </char><char style="ft" closed="false">ເອກະສານ​ເກົ່າ​ທີ່​ຂຽນ​ດ້ວຍ​ມື​ບາງ​ສະບັບ​ວ່າ </char><char style="fqa" closed="false">ພຣະອົງ </char><char style="ft" closed="false">(<char style="xt"><ref loc="ISA 53:12">ອຊຢ 53:12</ref></char>)</char></note> <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />ແລະ ຈຶ່ງ​ເປັນ​ຈິງ​ຕາມ​ພຣະຄຳພີ​ທີ່​ວ່າ, “ພວກເຂົາ​ຖືກ​ນັບ​ເປັນ​ຄົນ​ທີ່​ລ່ວງລະເມີດ”. <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />ບັນດາ​ຄົນ​ທີ່​ຜ່ານ​ໄປ​ມາ​ຕ່າງ​ກໍ​ດູຖູກ​ພຣະອົງ, ພາກັນ​ແກວ່ງຫົວ ແລະ ເວົ້າ​ວ່າ, “ເປັນ​ຢ່າງ​ໃດ! ເຈົ້າ​ຜູ້​ທີ່​ຈະ​ທຳລາຍ​ວິຫານ​ແລ້ວ​ສ້າງຂຶ້ນ​ໃໝ່​ໃນ​ສາມວັນ, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />ຈົ່ງ​ລົງ​ມາ​ຈາກ​ໄມ້ກາງແຂນ ແລະ ຊ່ວຍ​ຕົນ​ເອງ​ໃຫ້​ພົ້ນ​ສາ!”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />ໃນ​ທຳນອງ​ດຽວ​ກັນ​ນັ້ນ ພວກຫົວໜ້າ​ປະໂລຫິດ ແລະ ພວກ​ຄູສອນກົດບັນຍັດ​ກໍ​ໄດ້​ພາກັນ​ເຢາະເຢີ້ຍ​ພຣະອົງ​ໃນ​ທ່າມກາງ​ພວກເຂົາ​ເອງ​ເໝືອນກັນ​ວ່າ, “ລາວ​ຊ່ວຍ​ຄົນ​ອື່ນ​ໃຫ້​ພົ້ນ​ໄດ້ ແຕ່​ລາວ​ບໍ່​ສາມາດ​ຊ່ວຍ​ຕົນ​ເອງ​ໄດ້! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />ໃຫ້​ພຣະຄຣິດເຈົ້າ,<note caller="+" style="f"><char style="fr" closed="false">15:32 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ພຣະເມຊີອາ</char></note> ກະສັດ​ຂອງ​ຊາວ​ອິດສະຣາເອນ ລົງ​ມາ​ຈາກ​ໄມ້ກາງແຂນ​ດຽວນີ້, ເພື່ອ​ພວກເຮົາ​ຈະ​ໄດ້​ເຫັນ ແລະ ໄດ້​ເຊື່ອ”. ບັນດາ​ຜູ້​ທີ່​ຖືກ​ຄຶງ​ໄວ້​ທີ່​ໄມ້ກາງແຂນ​ພ້ອມ​ກັບ​ພຣະເຢຊູເຈົ້າ​ກໍ​ພາກັນ​ເວົ້າ​ດູຖູກ​ພຣະອົງ​ເໝືອນກັນ.<verse eid="MRK 15:32" /></para>
  <para style="s1">ການ​ຕາຍ​ຂອງ​ພຣະເຢຊູເຈົ້າ</para>
  <para style="r">(ມທ 27:45-56; ລກ 23:44-49)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />ເມື່ອ​ເຖິງ​ເວລາ​ຕອນທ່ຽງ ທົ່ວ​ແຜ່ນດິນ​ກໍ​ເກີດ​ຄວາມມືດມົວ​ຈົນ​ເຖິງ​ບ່າຍ​ສາມ​ໂມງ. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />ພໍ​ເຖິງ​ບ່າຍ​ສາມ​ໂມງ ພຣະເຢຊູເຈົ້າ​ຮ້ອງ​ຂຶ້ນ​ດ້ວຍ​ສຽງດັງ​ວ່າ, “ເອໂລອີ, ເອໂລອີ, ແລມາ ຊາບັກທານີ?” ເຊິ່ງ​ແປວ່າ: “ພຣະເຈົ້າ​ຂອງ​ຂ້ານ້ອຍ, ພຣະເຈົ້າ​ຂອງ​ຂ້ານ້ອຍ, ດ້ວຍເຫດໃດ​ພຣະອົງ​ຈຶ່ງ​ປະຖິ້ມ​ຂ້ານ້ອຍ?”<note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:1">ພສສ 22:1</ref></char></char></note><verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />ເມື່ອ​ບາງຄົນ​ທີ່​ຢືນ​ຢູ່​ໃກ້​ທີ່​ນັ້ນ​ໄດ້​ຍິນ​ດັ່ງນີ້ ພວກເຂົາ​ຈຶ່ງ​ເວົ້າ​ວ່າ, “ຟັງ​ແມ, ລາວ​ຮ້ອງ​ຫາ​ເອລີຢາ”.<verse eid="MRK 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36" />ມີ​ຄົນ​ໜຶ່ງ​ແລ່ນ​ໄປ​ເອົາ​ຟອງນ້ຳ​ຈຸ່ມ​ເຫລົ້າອະງຸ່ນສົ້ມ​ສຽບ​ໃສ່​ໄມ້ ແລ້ວ​ຍື່ນ​ໃຫ້​ພຣະເຢຊູເຈົ້າ​ດື່ມ ແລະ ເວົ້າ​ວ່າ, “ຢ່າ​ໄປ​ຫຍຸ້ງກ່ຽວ​ກັບ​ລາວ. ໃຫ້​ພວກເຮົາ​ເບິ່ງ​ວ່າ​ເອລີຢາ​ຈະ​ມາ​ຊ່ວຍ​ລາວ​ລົງ​ຈາກ​ໄມ້ກາງແຂນ​ບໍ່”.<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />ເມື່ອ​ພຣະເຢຊູເຈົ້າ​ຮ້ອງ​ດ້ວຍ​ສຽງດັງ​ແລ້ວ​ກໍ​ສິ້ນ​ລົມຫາຍໃຈ.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />ຜ້າກັ້ງ​ໃນ​ວິຫານ​ກໍ​ຈີກຂາດ​ເປັນ​ສອງ​ຕ່ອນ​ຕັ້ງແຕ່​ເທິງ​ຮອດ​ລຸ່ມ. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />ແລະ ເມື່ອ​ນາຍທະຫານ​ຜູ້​ທີ່​ຢືນ​ຢູ່​ຕໍ່ໜ້າ​ພຣະເຢຊູເຈົ້າ ໄດ້​ເຫັນ​ວ່າ​ພຣະອົງ​ຕາຍ​ຢ່າງ​ໃດ<note caller="+" style="f"><char style="fr" closed="false">15:39 </char><char style="ft" closed="false">ເອກະສານ​ຕົ້ນສະບັບ​ບາງ​ສະບັບ​ວ່າ </char><char style="fqa" closed="false">ພຣະອົງ​ຕາຍ​ພ້ອມ​ກັບ​ສຽງ​ຮ້ອງ​ອັນ​ດັງ</char></note>, ລາວ​ຈຶ່ງ​ເວົ້າ​ວ່າ, “ແທ້ຈິງ​ແລ້ວ ທ່ານ​ຜູ້​ນີ້​ເປັນ​ພຣະບຸດ<note caller="+" style="f"><char style="fr" closed="false">15:39 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ບຸດ​ຄົນ​ໜຶ່ງ</char></note>​ຂອງ​ພຣະເຈົ້າ!”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />ມີ​ແມ່ຍິງ​ບາງຄົນ​ທີ່​ເຝົ້າ​ເບິ່ງ​ຢູ່​ຫ່າງໆ. ໃນ​ພວກເຂົາ​ນັ້ນ​ມີ​ມາຣີ​ຊາວ​ມັກດາລາ, ມາຣີ​ແມ່​ຂອງ​ຢາໂກໂບ​ຜູ້​ເປັນ​ນ້ອງຊາຍ, ໂຢເຊ<note caller="+" style="f"><char style="fr" closed="false">15:40 </char><char style="ft" closed="false">ພາສາ​ກຣີກ​ວ່າ ໂຢເຊ ເປັນ​ອີກ​ຮູບ​ໜຶ່ງ​ຂອງ​ໂຢເຊັບ ຄື​ກັບ​ກັບ​ຢູ່​ໃນ​ຂໍ້ <char style="xt" link-href="MRK 15:47"><ref loc="MRK 15:47">47</ref></char></char></note> ແລະ ນາງ​ຊາໂລເມ. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />ແມ່ຍິງ​ເຫລົ່ານີ້​ໄດ້​ຕິດຕາມ​ພຣະເຢຊູເຈົ້າ ແລະ ບົວລະບັດ​ພຣະອົງ​ໃນ​ແຂວງ​ຄາລີເລ. ຍັງ​ມີ​ແມ່ຍິງ​ຄົນ​ອື່ນໆ​ອີກ​ຫລາຍ​ຄົນ​ທີ່​ໄດ້​ຂຶ້ນ​ໄປ​ນະຄອນ​ເຢຣູຊາເລັມ​ກັບ​ພຣະອົງ ກໍ​ຢູ່​ທີ່​ນັ້ນ​ເໝືອນ​ກັນ.<verse eid="MRK 15:41" /></para>
  <para style="s1">ການ​ຝັງ​ສົບ​ຂອງ​ພຣະເຢຊູເຈົ້າ</para>
  <para style="r">(ມທ 27:57-61; ລກ 23:50-56; ຢຮ 19:38-42)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />ເນື່ອງ​ຈາກ​ວ່າ​ວັນ​ນັ້ນ​ເປັນ​ວັນ​ຈັດຕຽມ (ເປັນ​ວັນ​ກ່ອນ​ທີ່​ຈະ​ເຖິງ​ວັນຊະບາໂຕ). ດັ່ງນັ້ນ ເມື່ອ​ເວລາຄໍ່າ​ມາ, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />ໂຢເຊັບ​ຈາກ​ອາຣີມາທາຍ ເພິ່ນ​ເປັນ​ສະມາຊິກ​ສະພາສູງສຸດ​ທີ່​ສຳຄັນ​ຄົນ​ໜຶ່ງ ເພິ່ນ​ເປັນ​ຜູ້​ທີ່​ລໍຖ້າ​ການ​ມາ​ປາກົດ​ແຫ່ງ​ອານາຈັກ​ຂອງ​ພຣະເຈົ້າ, ເພິ່ນ​ກ້າ​ເຂົ້າ​ໄປ​ພົບ​ປີລາດ​ເພື່ອ​ຂໍ​ເອົາ​ສົບ​ຂອງ​ພຣະເຢຊູເຈົ້າ. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />ແຕ່​ປີລາດ​ປະຫລາດໃຈ​ຫລາຍ​ທີ່​ໄດ້​ຍິນ​ວ່າ​ພຣະເຢຊູເຈົ້າ​ໄດ້​ຕາຍ​ແລ້ວ. ດັ່ງນັ້ນ ເພິ່ນ​ຈຶ່ງ​ເອີ້ນ​ນາຍທະຫານ​ເຂົ້າ​ມາ​ຖາມ​ວ່າ​ພຣະອົງ​ຕາຍ​ແລ້ວ​ບໍ. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />ເມື່ອ​ຮູ້​ຄຳຕອບ​ຈາກ​ນາຍທະຫານ​ແລ້ວ ເພິ່ນ​ກໍ​ໄດ້​ມອບ​ສົບ​ໃຫ້​ແກ່​ໂຢເຊັບ. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />ດັ່ງນັ້ນ ໂຢເຊັບ​ໄດ້​ຊື້​ຜ້າຝ້າຍລິນິນ ແລ້ວ​ໄດ້​ນໍາເອົາ​ສົບ​ລົງມາ​ຈາກ​ໄມ້ກາງແຂນ ແລະ ນຳ​ໄປ​ວາງ​ໄວ້​ໃນ​ອຸບມຸງ​ຫີນ​ທີ່​ເຈາະ​ໄວ້ ແລະ ເພິ່ນ​ກໍ​ກຶ່ງ​ກ້ອນຫີນ​ໃຫຍ່​ປິດ​ທາງເຂົ້າ​ອຸບມຸງ​ໄວ້. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />ສ່ວນ​ມາຣີ​ຊາວ​ມັກດາລາ ແລະ ມາຣີ​ແມ່​ຂອງ​ໂຢເຊັບ<note caller="+" style="f"><char style="fr" closed="false">15:47 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ໂຢເຊ</char></note>​ກໍ​ໄດ້​ເຫັນ​ບ່ອນ​ທີ່​ໄວ້​ສົບ​ຂອງ​ພຣະເຢຊູເຈົ້າ.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s1">ພຣະເຢຊູເຈົ້າ​ເປັນຄືນມາຈາກຕາຍ</para>
  <para style="r">(ມທ 28:1-8; ລກ 24:1-10)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />ເມື່ອ​ວັນຊະບາໂຕ​ຜ່ານພົ້ນ​ໄປ​ແລ້ວ ມາຣີ​ຊາວ​ມັກດາລາ, ມາຣີ​ແມ່​ຂອງ​ຢາໂກໂບ ແລະ ນາງ​ຊາໂລເມ​ກໍ​ຊື້​ເຄື່ອງຫອມ​ເພື່ອ​ເອົາ​ໄປ​ຫົດສົງ​ສົບ​ຂອງ​ພຣະເຢຊູເຈົ້າ. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />ໃນ​ວັນ​ຕົ້ນ​ສັບປະດາ​ແຕ່​ເຊົ້າ ພວກເຂົາ​ກໍ​ໄປ​ເຖິງ​ອຸບມຸງ​ນັ້ນ <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />ແລະ ຖາມ​ກັນ​ວ່າ, “ຜູ້ໃດ​ນໍ​ຈະ​ຊ່ວຍ​ກຶ່ງ​ກ້ອນຫີນ​ນັ້ນ​ອອກ​ຈາກ​ປາກ​ອຸບມຸງ​ໃຫ້​ພວກເຮົາ?”<verse eid="MRK 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4" />ແຕ່​ພໍ​ພວກເຂົາ​ແນມເບິ່ງ​ກໍ​ເຫັນ​ວ່າ​ຫີນ​ກ້ອນ​ໃຫຍ່​ນັ້ນ​ຖືກ​ກຶ່ງ​ອອກ​ແລ້ວ. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />ເມື່ອ​ພວກເຂົາ​ເຂົ້າ​ໄປ​ໃນ​ອຸບມຸງ​ກໍ​ໄດ້​ເຫັນ​ຊາຍໜຸ່ມ​ຜູ້​ໜຶ່ງ​ນຸ່ງ​ເສື້ອຄຸມ​ຍາວ​ສີຂາວ ນັ່ງ​ຢູ່​ເບື້ອງຂວາ ພວກນາງ​ກໍ​ຕົກໃຈຢ້ານ​ຫລາຍ.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />ຊາຍໜຸ່ມ​ໄດ້​ກ່າວ​ແກ່​ພວກເຂົາ​ວ່າ, “ຢ່າ​ຕື່ນຕົກໃຈ​ເລີຍ, ພວກເຈົ້າ​ມາ​ຊອກຫາ​ພຣະເຢຊູເຈົ້າ​ຊາວ​ນາຊາເຣັດ ຜູ້​ຖືກ​ຄຶງ​ໄວ້​ທີ່​ໄມ້ກາງແຂນ. ພຣະອົງ​ເປັນຄືນມາ​ແລ້ວ! ພຣະອົງ​ບໍ່​ໄດ້​ຢູ່​ທີ່​ນີ້. ຈົ່ງ​ເບິ່ງ​ບ່ອນ​ທີ່​ພວກເຂົາ​ວາງ​ຮ່າງກາຍ​ຂອງ​ພຣະອົງ​ໄວ້​ແມ. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />ແຕ່​ຈົ່ງ​ໄປ​ບອກ​ພວກສາວົກ​ຂອງ​ພຣະອົງ ແລະ ເປໂຕ​ວ່າ, ‘ພຣະອົງ​ກຳລັງ​ໄປ​ແຂວງ​ຄາລີເລ​ກ່ອນໜ້າ​ພວກເຈົ້າ. ພວກເຈົ້າ​ຈະ​ເຫັນ​ພຣະອົງ​ໃນ​ທີ່​ນັ້ນ ຕາມ​ທີ່​ພຣະອົງ​ໄດ້​ບອກ​ພວກເຈົ້າ​ໄວ້​ແລ້ວ’ ”.<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />ພວກເຂົາ​ຢ້ານ​ຈົນ​ໂຕສັ່ນ ແລະ ສັບສົນ ຈຶ່ງ​ພາກັນ​ຟ້າວ​ອອກ​ໜີ​ໄປ​ຈາກ​ອຸບມຸງ. ພວກເຂົາ​ບໍ່​ໄດ້​ເວົ້າ​ອັນ​ໃດ​ກັບ​ຜູ້ໃດ ເພາະ​ວ່າ​ພວກເຂົາ​ຢ້ານ.<verse eid="MRK 16:8" /></para>
  <para style="iex">(ເອກະສານ​ເກົ່າ​ທີ່ສຸດ ແລະ ຫລັກຖານ​ບູຮານ​ອື່ນໆບໍ່​ມີ ຂໍ້ <char style="xt">16:9-20</char>.)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />ເມື່ອ​ຮຸ່ງເຊົ້າ​ຂອງ​ວັນ​ຕົ້ນ​ສັບປະດາ ຫລັງ​ຈາກ​ທີ່​ພຣະເຢຊູເຈົ້າ​ເປັນຄືນມາຈາກຕາຍ​ແລ້ວ, ພຣະອົງ​ໄດ້​ປາກົດ​ແກ່​ນາງ​ມາຣີ​ຊາວ​ມັກດາລາ​ເປັນ​ຜູ້ທຳອິດ ຄື​ຜູ້​ທີ່​ພຣະເຢຊູເຈົ້າ​ໄດ້​ຂັບໄລ່​ຜີມານຮ້າຍ​ເຈັດ​ໂຕ​ອອກ​ນັ້ນ. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />ມາຣີ​ຈຶ່ງ​ໄປ​ບອກ​ບັນດາ​ຜູ້​ທີ່​ເຄີຍ​ຢູ່​ກັບ​ພຣະອົງ, ຜູ້​ທີ່​ກຳລັງ​ໄວ້ທຸກ ແລະ ຮ້ອງໄຫ້​ຢູ່. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />ເມື່ອ​ພວກເຂົາ​ໄດ້​ຍິນ​ວ່າ​ພຣະເຢຊູເຈົ້າ​ມີຊີວິດ​ຢູ່ ແລະ ທັງ​ໄດ້​ຍິນ​ນາງ​ເວົ້າ​ວ່າ​ຕົນ​ໄດ້​ເຫັນ​ພຣະອົງ​ດ້ວຍ, ພວກເຂົາ​ກໍ​ບໍ່ເຊື່ອ.<verse eid="MRK 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />ຫລັງຈາກນັ້ນ​ແລ້ວ ພຣະເຢຊູເຈົ້າ​ກໍ​ໄດ້​ປາກົດ​ໃນ​ລັກສະນະ​ໜຶ່ງ​ອີກ​ແກ່​ສາວົກ​ສອງ​ຄົນ​ໃນຂະນະ​ທີ່​ພວກເພິ່ນ​ເດີນ​ທາງ​ຢູ່​ນອກ​ເມືອງ. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />ທັງ​ສອງ​ໄດ້​ກັບ​ມາ​ເລົ່າ​ໃຫ້​ສາວົກ​ຄົນ​ອື່ນໆ​ຟັງ ແຕ່​ພວກເພິ່ນ​ກໍ​ຍັງ​ບໍ່​ເຊື່ອ.<verse eid="MRK 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />ຕໍ່ມາ ພຣະເຢຊູເຈົ້າ​ກໍ​ໄດ້​ປາກົດ​ແກ່​ສາວົກ​ສິບເອັດ​ຄົນ​ໃນ​ຂະນະ​ທີ່​ພວກເພິ່ນ​ກຳລັງ​ກິນເຂົ້າ​ຢູ່, ພຣະອົງ​ໄດ້​ຕຳໜິ​ພວກເພິ່ນ​ທີ່​ຂາດ​ຄວາມເຊື່ອ ແລະ ດື້ດ້ານ​ທີ່​ບໍ່​ຍອມ​ເຊື່ອ​ຜູ້​ທີ່​ໄດ້​ເຫັນ​ພຣະອົງ​ຫລັງຈາກ​ທີ່​ພຣະອົງ​ໄດ້​ເປັນຄືນມາ​ແລ້ວ.<verse eid="MRK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15" />ພຣະອົງ​ກໍ​ກ່າວ​ແກ່​ພວກເພິ່ນ​ວ່າ, “ຈົ່ງ​ອອກ​ໄປ​ທົ່ວ​ໂລກ ປະກາດ​ຂ່າວປະເສີດ​ແກ່​ມະນຸດ​ທັງໝົດ. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />ຜູ້ໃດ​ກໍ​ຕາມ​ທີ່​ເຊື່ອ ແລະ ຮັບ​ບັບຕິສະມາ​ກໍ​ຈະ​ໄດ້​ພົ້ນ, ແຕ່​ຜູ້ໃດ​ກໍ​ຕາມ​ທີ່​ບໍ່ເຊື່ອ​ກໍ​ຈະ​ຖືກ​ຕັດສິນ​ລົງໂທດ. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />ແລະ ໝາຍສຳຄັນ​ເຫລົ່ານີ້​ຈະ​ຕິດຕາມ​ຄົນ​ທີ່​ເຊື່ອ​ດັ່ງນີ້​ຄື: ພວກເຂົາ​ຈະ​ຂັບໄລ່​ຜີມານຮ້າຍ​ອອກ​ໄດ້​ໃນ​ນາມ​ຂອງ​ເຮົາ, ພວກເຂົາ​ຈະ​ເວົ້າ​ພາສາ​ໃໝ່ໆ​ໄດ້, <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />ພວກເຂົາ​ຈະ​ຈັບ​ງູ​ດ້ວຍ​ມື​ເປົ່າ ແລະ ເມື່ອ​ພວກເຂົາ​ດື່ມ​ຂອງ​ທີ່​ມີ​ພິດ ສິ່ງ​ເຫລົ່ານີ້​ຈະ​ບໍ່​ເປັນ​ອັນຕະລາຍ​ແກ່​ພວກເຂົາ, ເມື່ອ​ພວກເຂົາ​ວາງມື​ໃສ່​ຄົນ​ເຈັບປ່ວຍ ແລະ ຄົນ​ເຫລົ່ານັ້ນ​ກໍ​ຈະ​ຫາຍດີ”.<verse eid="MRK 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />ເມື່ອ​ພຣະເຢຊູເຈົ້າ​ອົງພຣະຜູ້ເປັນເຈົ້າ​ໄດ້​ກ່າວ​ແກ່​ພວກເພິ່ນ​ແລ້ວ ພຣະອົງ​ກໍ​ຖືກ​ຮັບ​ຂຶ້ນ​ສູ່​ສະຫວັນ ແລະ ນັ່ງ​ຢູ່​ເບື້ອງຂວາ​ມື​ຂອງ​ພຣະເຈົ້າ. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />ຝ່າຍ​ພວກສາວົກ​ກໍ​ອອກ​ໄປ​ເທດສະໜາ​ທົ່ວ​ທຸກ​ບ່ອນ ແລະ ອົງພຣະຜູ້ເປັນເຈົ້າ​ໄດ້​ຮ່ວມງານ​ກັບ​ພວກເພິ່ນ ແລະ ພຣະອົງ​ໄດ້​ຢືນຢັນ​ຖ້ອຍຄຳ​ຂອງ​ພຣະອົງ​ດ້ວຍ​ໝາຍສຳຄັນ​ທີ່​ເກີດຂຶ້ນ.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>