<usx version="3.0">
  <book code="HAB" style="id">- Biblica® Open Lao Contemporary Version</book>
  <para style="rem">Copyright © 2023, 2025 by Biblica, Inc.</para>
  <para style="h">ຮາບາກຸກ</para>
  <para style="toc1">ພຣະທຳຮາບາກຸກ</para>
  <para style="toc2">ຮາບາກຸກ</para>
  <para style="toc3">ຮບກ</para>
  <para style="mt1">ພຣະທຳຮາບາກຸກ</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />ຄຳ​ທຳນວາຍ​ທີ່​ຜູ້ທຳນວາຍ​ຮາບາກຸກ​ໄດ້​ຮັບ.<verse eid="HAB 1:1" /></para>
  <para style="b" />
  <para style="s1">ຄຳ​ຮ້ອງທຸກ​ຂອງ​ຮາບາກຸກ</para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 1:2" />ຂ້າ​ແດ່​ພຣະເຈົ້າ​ຢາເວ, ຂ້ານ້ອຍ​ຈະ​ຕ້ອງ​ຮ້ອງ​ຂໍ​ຄວາມ​ຊ່ວຍເຫລືອ​ອີກ​ດົນ​ປານ​ໃດ,</para>
  <para style="q2" vid="HAB 1:2">ແຕ່​ພຣະອົງ​ບໍ່​ຮັບ​ຟັງ?</para>
  <para style="q1" vid="HAB 1:2">ຫລື ຕ້ອງ​ຮ້ອງ​ຂໍ​ຕໍ່​ພຣະອົງ​ວ່າ, “ໂຫດຮ້າຍ!”</para>
  <para style="q2" vid="HAB 1:2">ແຕ່​ພຣະອົງ​ບໍ່​ມາ​ຊ່ວຍ?<verse eid="HAB 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 1:3" />ດ້ວຍ​ເຫດ​ໃດ​ພຣະອົງ​ຈຶ່ງ​ເຮັດ​ໃຫ້​ຂ້ານ້ອຍ​ເບິ່ງ​ຄວາມ​ບໍ່​ຍຸຕິທຳ?</para>
  <para style="q2" vid="HAB 1:3">ດ້ວຍ​ເຫດ​ໃດ​ພຣະອົງ​ຈຶ່ງ​ອົດກັ້ນ​ຕໍ່​ການ​ກະທຳ​ຜິດ?</para>
  <para style="q1" vid="HAB 1:3">ການ​ທຳລາຍ ແລະ ຄວາມ​ຮຸນແຮງ​ຢູ່​ຕໍ່ໜ້າ​ຂ້ານ້ອຍ;</para>
  <para style="q2" vid="HAB 1:3">ມີ​ການ​ຕໍ່ສູ້ ແລະ ຂັດແຍ່ງ​ກັນ​ຢ່າງ​ຫລວງຫລາຍ.<verse eid="HAB 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 1:4" />ເຫດສະນັ້ນ ກົດໝາຍ​ຈຶ່ງ​ເປັນ​ອຳມະພາດ</para>
  <para style="q2" vid="HAB 1:4">ແລະ ຄວາມ​ຍຸຕິທຳ​ຈຶ່ງ​ບໍ່​ປາກົດ</para>
  <para style="q1" vid="HAB 1:4">ຄົນ​ຊົ່ວຮ້າຍ​ອ້ອມ​ຮອບ​ຄົນຊອບທຳ,</para>
  <para style="q2" vid="HAB 1:4">ຈົນ​ຄວາມ​ຍຸຕິທຳ​ຖືກ​ບິດເບືອນ​ໄປ.<verse eid="HAB 1:4" /></para>
  <para style="s1">ຄຳ​ຕອບ​ຂອງ​ພຣະເຈົ້າຢາເວ</para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 1:5" />ພຣະເຈົ້າ​ກ່າວ​ວ່າ: “ຈົ່ງ​ເບິ່ງ</para>
  <para style="q2" vid="HAB 1:5">ແລະ ຄອຍ​ເຝົ້າ​ເບິ່ງ​ຊົນຊາດ​ຕ່າງໆ.</para>
  <para style="q1" vid="HAB 1:5">ແລ້ວ​ຈົ່ງ​ປະຫລາດໃຈ​ທີ່ສຸດ​ເພາະ​ເຮົາ​ກຳລັງ​ຈະ​ເຮັດ​ບາງ​ສິ່ງ​ໃນ​ຍຸກ​ຂອງ​ເຈົ້າ</para>
  <para style="q2" vid="HAB 1:5">ເຈົ້າ​ກໍ​ຈະ​ບໍ່​ເຊື່ອ,</para>
  <para style="q2" vid="HAB 1:5">ເຖິງ​ແມ່ນ​ວ່າ​ມີ​ຜູ້​ໃດ​ບອກ.<verse eid="HAB 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 1:6" />ເຮົາ​ກຳລັງ​ຈະ​ໃຫ້​ຊາວ​ບາບີໂລນ<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ຊາວ​ຄານເດອາ</char></note>​ມີ​ອຳນາດ​ຂຶ້ນ​ມາ,</para>
  <para style="q2" vid="HAB 1:6">ພວກເຂົາ​ເປັນ​ຊົນຊາດ​ທີ່​ໂຫດຮ້າຍ ແລະ ໃຈ​ຮ້ອນ</para>
  <para style="q1" vid="HAB 1:6">ເຊິ່ງ​ເຄື່ອນ​ທັບ​ໄປ​ທົ່ວ​ແຜ່ນດິນໂລກ</para>
  <para style="q2" vid="HAB 1:6">ເພື່ອ​ຢຶດຄອງ​ບ່ອນ​ຢູ່​ທີ່​ບໍ່​ແມ່ນ​ຂອງ​ຕົນ.<verse eid="HAB 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 1:7" />ພວກເຂົາ​ເປັນ​ຊົນຊາດ​ທີ່​ໜ້າ​ຢຳເກງ ແລະ ໜ້າ​ຢ້ານກົວ;</para>
  <para style="q2" vid="HAB 1:7">ພວກເຂົາ​ຖື​ເອົາ​ຕົນ​ເອງ​ເປັນ​ກົດໝາຍ</para>
  <para style="q2" vid="HAB 1:7">ແລະ ສະແຫວງ​ຫາ​ກຽດຕິຍົດ​ໃຫ້​ຕົນ​ເອງ.<verse eid="HAB 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 1:8" />ບັນດາ​ມ້າ​ຂອງ​ພວກເຂົາ​ແລ່ນ​ໄວ​ກວ່າ​ເສືອດາວ,</para>
  <para style="q2" vid="HAB 1:8">ໂຫດຮ້າຍ​ກວ່າ​ໝາປ່າ​ໃນ​ເວລາ​ຄ່ຳ</para>
  <para style="q1" vid="HAB 1:8">ກອງ​ທະຫານ​ມ້າ​ຂອງ​ພວກເຂົາ​ຂີ່​ມ້າ​ຢ່າງ​ວ່ອງໄວ;</para>
  <para style="q2" vid="HAB 1:8">ທະຫານມ້າ​ຂອງ​ພວກເຂົາ​ມາ​ຈາກ​ແດນ​ໄກ.</para>
  <para style="q1" vid="HAB 1:8">ພວກເຂົາ​ບິນ​ມາ​ດັ່ງ​ນົກອິນຊີ​ເຈີດ​ລົງ​ຄຸບ​ເຫຍື່ອ;<verse eid="HAB 1:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="HAB 1:9" />ພວກເຂົາ​ທຸກຄົນ​ມີ​ເຈດຕະນາ​ທີ່​ຈະ​ໃຊ້​ຄວາມ​ຮຸນແຮງ.</para>
  <para style="q1" vid="HAB 1:9">ຝູງ​ຊົນ<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">ໃນ​ພາສາ​ເຮັບເຣີ​ຄຳ​ນີ້ </char><char style="fqa" closed="false">ມີ​ຄວາມຫມາຍ​ບໍ່​ຊັດເຈນ</char></note>​ຂອງ​ພວກເຂົາ​ບຸກ​ເຂົ້າ​ມາ​ເໝືອນ​ລົມ​ທະເລຊາຍ</para>
  <para style="q2" vid="HAB 1:9">ແລະ ກວາດ​ຕ້ອນ​ນັກໂທດ​ໄປ​ເໝືອນ​ເມັດ​ຊາຍ<verse eid="HAB 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 1:10" />ພວກເຂົາ​ເຢາະເຢີ້ຍ​ບັນດາ​ກະສັດ</para>
  <para style="q2" vid="HAB 1:10">ແລະ ດູຖູກ​ບັນດາ​ຜູ້​ປົກຄອງ.</para>
  <para style="q1" vid="HAB 1:10">ພວກເຂົາ​ຫົວ​ເຢາະເຢີ້ຍ​ເມືອງ​ທີ່​ມີ​ປ້ອມ​ປ້ອງກັນ​ທັງໝົດ;</para>
  <para style="q2" vid="HAB 1:10">ໂດຍ​ກອງ​ດິນ​ຂຶ້ນ​ສູງ​ຊັນ ແລະ ເຂົ້າ​ຢຶດ​ເມືອງ​ເຫລົ່ານັ້ນ.<verse eid="HAB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 1:11" />ແລ້ວ​ພວກເຂົາ​ກໍ​ກວດ​ທັບ​ໄປ​ຢ່າງ​ວ່ອງໄວ​ເໝືອນ​ລົມ ແລະ ມຸ່ງໜ້າ​ຕໍ່​ໄປ</para>
  <para style="q2" vid="HAB 1:11">ພວກເຂົາ​ເປັນ​ຄົນ​ຜິດ ທີ່​ຖື​ເອົາ​ພາລະ​ກຳລັງ​ຂອງ​ຕົນ​ເອງ​ເປັນ​ເທບພະເຈົ້າ​ຂອງ​ຕົນ”.<verse eid="HAB 1:11" /></para>
  <para style="s1">ຄຳ​ຮ້ອງທຸກ​ເທື່ອ​ທີ​ສອງ​ຂອງ​ຮາບາກຸກ</para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 1:12" />ຂ້າ​ແດ່​ພຣະເຈົ້າ​ຢາເວ, ພຣະອົງ​ດຳລົງ​ຢູ່​ນິລັນດອນ​ບໍ່ແມ່ນ​ບໍ?</para>
  <para style="q2" vid="HAB 1:12">ຂ້າ​ແດ່​ພຣະເຈົ້າ​ຂອງ​ຂ້ານ້ອຍ, ອົງ​ບໍລິສຸດ​ຂອງ​ຂ້ານ້ອຍ, ພວກຂ້ານ້ອຍ​ທັງຫລາຍ​ຈະ​ບໍ່​ຕາຍ.</para>
  <para style="q1" vid="HAB 1:12">ພຣະເຈົ້າ​ຢາເວ ພຣະອົງ​ໄດ້​ແຕ່ງຕັ້ງ​ພວກເຂົາ​ໃຫ້​ດຳເນີນ​ການ​ຕາມ​ຄຳ​ພິພາກສາ;</para>
  <para style="q2" vid="HAB 1:12">ສີລາ​ຂອງ​ຂ້ານ້ອຍ, ພຣະອົງ​ໄດ້​ບັນຊາ​ໃຫ້​ພວກເຂົາ​ມາ​ລົງໂທດ.<verse eid="HAB 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 1:13" />ຕາ​ຂອງ​ພຣະອົງ​ບໍລິສຸດ​ເກີນ​ກວ່າ​ຈະ​ເບິ່ງ​ຄວາມ​ຊົ່ວຮ້າຍ;</para>
  <para style="q2" vid="HAB 1:13">ພຣະອົງ​ບໍ່​ສາມາດ​ທົນ​ຕໍ່​ການ​ກະທຳ​ຜິດ​ໄດ້.</para>
  <para style="q1" vid="HAB 1:13">ດ້ວຍ​ເຫດ​ໃດ​ພຣະອົງ​ຈຶ່ງ​ທົນ​ຕໍ່​ຄົນ​ທໍລະຍົດ?</para>
  <para style="q2" vid="HAB 1:13">ດ້ວຍ​ເຫດ​ໃດ​ພຣະອົງ​ຈຶ່ງ​ງຽບ​ຢູ່​ໃນ​ຂະນະ​ທີ່​ຄົນ​ຊົ່ວຮ້າຍ</para>
  <para style="q2" vid="HAB 1:13">ກືນ​ກິນ​ບັນດາ​ຄົນ​ທີ່​ຊອບທຳ​ກວ່າ​ພວກເຂົາ​ເອງ?<verse eid="HAB 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 1:14" />ພຣະອົງ​ເຮັດ​ໃຫ້​ມະນຸດ​ເປັນ​ເໝືອນ​ປາ​ໃນ​ທະເລ,</para>
  <para style="q2" vid="HAB 1:14">ເໝືອນ​ບັນດາ​ສັດ​ໃນ​ທະເລ​ທີ່​ບໍ່​ມີ​ຜູ້ໃດ​ປົກຄອງ.<verse eid="HAB 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 1:15" />ສັດຕູ​ຜູ້​ຊົ່ວ​ຮ້າຍ​ໄດ້​ດຶງ​ພວກເຂົາ​ທັງໝົດ​ຂຶ້ນ​ມາ​ດ້ວຍ​ເບັດ,</para>
  <para style="q2" vid="HAB 1:15">ລາວ​ຈັບ​ພວກເຂົາ​ດ້ວຍ​ແຫ​ຂອງ​ລາວ,</para>
  <para style="q1" vid="HAB 1:15">ລາວ​ໄດ້​ຮວບຮວມ​ພວກເຂົາ​ຂຶ້ນ​ມາ​ດ້ວຍ​ມອງ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="HAB 1:15">ແລ້ວ​ລາວ​ຈຶ່ງ​ຊື່ນຊົມຍິນດີ ແລະ ດີໃຈ.<verse eid="HAB 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 1:16" />ເຫດສະນັ້ນ ລາວ​ຈຶ່ງ​ຖວາຍ​ເຄື່ອງ​ບູຊາ​ແກ່​ແຫ​ຂອງ​ຕົນ</para>
  <para style="q2" vid="HAB 1:16">ແລະ ເຜົາ​ເຄື່ອງຫອມ​ແກ່​ມອງ​ຂອງ​ຕົນ,</para>
  <para style="q1" vid="HAB 1:16">ເພາະ​ແຫ​ຂອງ​ລາວ​ເຮັດ​ໃຫ້​ລາວ​ດຳລົງ​ຊີວິດ​ຢູ່​ໄດ້​ຢ່າງ​ຟູມເຟືອຍ</para>
  <para style="q2" vid="HAB 1:16">ແລະ ເພີດເພີນ​ກັບ​ອາຫານ​ທີ່​ເລືອກ​ມາ​ແລ້ວ​ຢ່າງ​ດີ.<verse eid="HAB 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 1:17" />ລາວ​ຈະ​ແກະ​ສິ່ງ​ທີ່​ຈັບ​ໄດ້​ອອກ​ມາ​ຈາກ​ແຫ​ຂອງ​ລາວ,</para>
  <para style="q2" vid="HAB 1:17">ທຳລາຍ​ຊົນຊາດ​ຕ່າງ​ໆ​ຢ່າງ​ບໍ່​ມີ​ຄວາມ​ເມດຕາ​ຕໍ່​ໄປ​ບໍ?<verse eid="HAB 1:17" /></para>
  <para style="b" />
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="q1">
    <verse number="1" style="v" sid="HAB 2:1" />ຂ້ານ້ອຍ​ຈະ​ຢືນ​ເຝົ້າ​ເບິ່ງ</para>
  <para style="q2" vid="HAB 2:1">ແລະ ຂ້ານ້ອຍ​ຈະ​ປະຈຳການ​ຢູ່​ເທິງ​ຫໍຄອຍ;</para>
  <para style="q1" vid="HAB 2:1">ຂ້ານ້ອຍ​ຈະ​ເຝົ້າ​ເບິ່ງ​ວ່າ​ພຣະອົງ​ຈະ​ເວົ້າ​ສິ່ງ​ໃດ​ກັບ​ຂ້ານ້ອຍ,</para>
  <para style="q2" vid="HAB 2:1">ແລະ ຂ້ານ້ອຍ​ຈະ​ຕອບ​ຄຳ​ຮ້ອງທຸກ​ນີ້​ຢ່າງໃດ.<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ແລະ </char><char style="ft" closed="false">ຈະ​ຕອບ​ຢ່າງ​ໃດ </char><char style="fqa" closed="false">ເມື່ອ​ຂ້ານ້ອຍ​ຖືກ​ຕຳໜິ</char></note><verse eid="HAB 2:1" /></para>
  <para style="s1">ຄຳ​ຕອບ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2" />ແລ້ວ​ພຣະເຈົ້າ​ຢາເວ​ກໍ​ໄດ້​ຕອບ​ວ່າ:</para>
  <para style="q1" vid="HAB 2:2">“ຈົ່ງ​ຂຽນ​ສິ່ງ​ທີ່​ໄດ້​ເປີດເຜີຍ</para>
  <para style="q2" vid="HAB 2:2">ແລະ ໃຫ້​ເຫັນ​ຊັດເຈນ​ເທິງ​ແຜ່ນ​ຈາລຶກ</para>
  <para style="q2" vid="HAB 2:2">ເພື່ອ​ວ່າ​ທຸກ​ຄົນ​ທີ່​ອ່ານ​ຈະ​ເຂົ້າໃຈ​ໄດ້​ທັນທີ.<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">ຫລື ເພື່ອ​ວ່າ​ຜູ້​ທີ່​ນຳ​ສານ​ນັ້ນ​ຈະ​ໄດ້​ເອົາ​ແລ້ວ​ແລ່ນ​ໄປ</char></note><verse eid="HAB 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3" />ເພາະ​ສິ່ງ​ທີ່​ຈະ​ເປີດເຜີຍ​ນັ້ນ​ແມ່ນ​ຍັງ​ລໍຖ້າ​ເວລາ​ທີ່​ກຳນົດ​ໄວ້​ຢູ່;</para>
  <para style="q2" vid="HAB 2:3">ເປັນ​ເລື່ອງ​ວາລະ​ສຸດທ້າຍ</para>
  <para style="q2" vid="HAB 2:3">ແລະ ຈະ​ພິສູດ​ໄດ້​ວ່າ​ບໍ່​ແມ່ນ​ເລື່ອງ​ບໍ່​ຈິງ</para>
  <para style="q1" vid="HAB 2:3">ເຖິງ​ແມ່ນ​ວ່າ​ຈະ​ຊ້າ​ຢູ່, ກໍ​ຈົ່ງ​ອົດ​ໃຈ​ລໍຖ້າ;</para>
  <para style="q2" vid="HAB 2:3">ມັນ​ຈະ​ມາ​ເຖິງ​ຢ່າງ​ແນ່ນອນ<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="ft" closed="false">ຫລື ເຖິງ​ແມ່ນ​ວ່າ​ພຣະອົງ​ຈະ​ຊ້າ​ຢູ່ ກໍ​ຈົ່ງ​ອົດໃຈ​ລໍຖ້າ ພຣະອົງ​ຈະ​ມາ​ເຖິງ​ຢ່າງ​ແນ່ນອນ ແລະ ຈະ​ບໍ່​ຊັກຊ້າ</char></note></para>
  <para style="q2" vid="HAB 2:3">ແລະ ຈະ​ບໍ່​ຊັກຊ້າ.<verse eid="HAB 2:3" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4" />“ເບິ່ງ​ແມ, ສັດຕູ​ໄດ້​ຈອງຫອງ​ຂຶ້ນ;</para>
  <para style="q2" vid="HAB 2:4">ຄວາມ​ປາຖະໜາ​ຂອງ​ລາວ​ແມ່ນ​ບໍ່​ຖືກຕ້ອງ</para>
  <para style="q2" vid="HAB 2:4">ແຕ່​ຄົນ​ຊອບທຳ​ຈະ​ດຳເນີນຊີວິດ​ດ້ວຍ​ຄວາມ​ຊື່ສັດ<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">ຫລື ຄວາມເຊື່ອ</char></note>​ຂອງ​ພຣະອົງ<verse eid="HAB 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5" />ຄວາມຈິງ​ແລ້ວ, ເຫລົ້າອະງຸ່ນ​ໄດ້​ທໍລະຍົດ​ລາວ;</para>
  <para style="q2" vid="HAB 2:5">ລາວ​ຈອງຫອງ ແລະ ບໍ່​ເຄີຍ​ພັກ​ສະຫງົບ.</para>
  <para style="q1" vid="HAB 2:5">ເພາະ​ລາວ​ໂລບ​ເໝືອນ​ຂຸມ​ຝັງ​ສົບ</para>
  <para style="q2" vid="HAB 2:5">ແລະ ເໝືອນ​ຄວາມ​ຕາຍ​ທີ່​ບໍ່​ເຄີຍ​ອິ່ມ</para>
  <para style="q1" vid="HAB 2:5">ລາວ​ຮວບຮວມ​ປະຊາຊາດ​ທັງໝົດ​ມາ​ເປັນ​ຂອງ​ຕົນ</para>
  <para style="q2" vid="HAB 2:5">ແລະ ຈັບ​ທຸກ​ຄົນ​ມາ​ເປັນ​ຊະເລີຍ.<verse eid="HAB 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 2:6" />“ທຸກຄົນ​ຈະ​ຫຍໍ້ຫຍັນ​ລາວ​ດ້ວຍ​ຄຳ​ເຢາະເຢີ້ຍ ແລະ ດູຖູກ​ບໍ່​ແມ່ນ​ບໍ​ວ່າ,</para>
  <para style="q1" vid="HAB 2:6">“ ‘ວິບັດ​ແກ່​ລາວ​ຜູ້​ທີ່​ເອົາ​ຂອງ​ທີ່​ລັກ​ມາ​ສະສົມ​ໄວ້</para>
  <para style="q2" vid="HAB 2:6">ແລະ ເຮັດ​ໃຫ້​ຕົນ​ເອງ​ຮັ່ງມີ​ໂດຍ​ການ​ຂົ່ມຂູ່!</para>
  <para style="q2" vid="HAB 2:6">ສິ່ງ​ນີ້​ຈະ​ຕ້ອງ​ດຳເນີນ​ໄປ​ອີກ​ດົນ​ເທົ່າໃດ?’<verse eid="HAB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7" />ເຈົ້າ​ໜີ້​ຂອງ​ເຈົ້າ​ຈະ​ບໍ່​ລຸກ​ຮື້​ຂຶ້ນ​ໃນ​ທັນທີ​ທັນໃດ​ບໍ?</para>
  <para style="q2" vid="HAB 2:7">ພວກເຂົາ​ຈະ​ບໍ່​ຕື່ນ​ຂຶ້ນ ແລະ ເຮັດ​ໃຫ້​ເຈົ້າ​ໂຕ​ສັ່ນ​ສະທ້ານ​ບໍ?</para>
  <para style="q2" vid="HAB 2:7">ແລ້ວ​ເຈົ້າ​ກໍ​ຈະ​ຕົກ​ເປັນ​ເຫຍື່ອ​ຂອງ​ພວກເຂົາ.<verse eid="HAB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8" />ເພາະ​ເຈົ້າ​ໄດ້​ປຸ້ນ​ມາ​ຫລາຍ​ຊົນຊາດ​ແລ້ວ,</para>
  <para style="q2" vid="HAB 2:8">ຄົນ​ທັງຫລາຍ​ທີ່​ເຫລືອ​ຢູ່​ນັ້ນ​ຈະ​ປຸ້ນ​ເຈົ້າ.</para>
  <para style="q1" vid="HAB 2:8">ເພາະ​ເຈົ້າ​ເຮັດ​ໃຫ້​ຄົນ​ຕ້ອງ​ນອງ​ເລືອດ;</para>
  <para style="q2" vid="HAB 2:8">ເຈົ້າ​ໄດ້​ທຳລາຍ​ດິນແດນ ແລະ ເມືອງ​ຕ່າງ​ໆ ແລະ ພວກເຂົາ​ທຸກຄົນ.<verse eid="HAB 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9" />“ວິບັດ​ແກ່​ລາວ​ຜູ້​ທີ່​ສ້າງ​ເຮືອນ​ຂອງ​ຕົນ​ດ້ວຍ​ສິ່ງ​ທີ່​ໄດ້​ມາ​ຢ່າງ​ບໍ່​ຍຸຕິທຳ.</para>
  <para style="q2" vid="HAB 2:9">ເພື່ອ​ສ້າງ​ຮັງ​ຂອງ​ຕົນ​ໄວ້​ເທິງ​ທີ່​ສູງ</para>
  <para style="q2" vid="HAB 2:9">ເພື່ອ​ໜີ​ຈາກ​ເງື່ອມມື​ແຫ່ງ​ຄວາມ​ຈິບຫາຍ!<verse eid="HAB 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10" />ເຈົ້າ​ໄດ້​ວາງ​ແຜນ​ໃຫ້​ຫລາຍ​ຊົນຊາດ​ຖືກ​ທຳລາຍ,</para>
  <para style="q2" vid="HAB 2:10">ສ້າງ​ຄວາມ​ອັບອາຍ​ໃຫ້​ແກ່​ເຮືອນ​ຂອງ​ເຈົ້າ​ເອງ ແລະ ເຮັດ​ໃຫ້​ຊີວິດ​ຂອງ​ຕົນ​ເອງ​ຕ້ອງ​ເສຍ​ໄປ.<verse eid="HAB 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11" />ກ້ອນ​ຫີນ​ທີ່​ຝາ​ຈະ​ສົ່ງ​ສຽງ​ຮ້ອງ,</para>
  <para style="q2" vid="HAB 2:11">ແລະ ໄມ້​ຂື່​ໄມ້​ຄານ​ທັງຫລາຍ​ກໍ​ຈະ​ສົ່ງ​ສຽງ​ສະທ້ອນ.<verse eid="HAB 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12" />“ວິບັດ​ແກ່​ລາວ​ຜູ້​ທີ່​ສ້າງ​ນະຄອນ​ດ້ວຍ​ການ​ນອງ​ເລືອດ</para>
  <para style="q2" vid="HAB 2:12">ແລະ ຕັ້ງ​ເມືອງ​ດ້ວຍ​ຄວາມ​ບໍ່​ຍຸດຕິທຳ!<verse eid="HAB 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13" />ພຣະເຈົ້າ​ຢາເວ​ຜູ້​ມີ​ລິດອຳນາດ​ຍິ່ງໃຫຍ່​ໄດ້​ກຳນົດ​ໄວ້​ແລ້ວ</para>
  <para style="q2" vid="HAB 2:13">ວ່າ​ແຮງງານ​ຂອງ​ຄົນ​ທັງຫລາຍ​ນັ້ນ​ກໍ​ເປັນ​ພຽງ​ເຊື້ອໄຟ​ສຳລັບ​ໄຟ​ເທົ່ານັ້ນ,</para>
  <para style="q2" vid="HAB 2:13">ບັນດາ​ຊົນຊາດ​ທັງຫລາຍ​ນັ້ນ​ກໍ​ອິດເມື່ອຍ​ລ້າ​ໆ​ບໍ່​ແມ່ນ​ບໍ?<verse eid="HAB 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 2:14" />ເພາະ​ໂລກ​ຈະ​ເຕັມ​ໄປ​ດ້ວຍ​ຄວາມ​ຮູ້​ເຖິງ​ສະຫງ່າລາສີ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q2" vid="HAB 2:14">ເໝືອນດັ່ງ​ນໍ້າ​ທັງຫລາຍ​ທີ່​ກວມ​ທະເລ.<verse eid="HAB 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15" />“ວິບັດ​ແກ່​ລາວ​ຜູ້​ທີ່​ເອົາ​ເຄື່ອງດື່ມ​ໃຫ້​ບັນດາ​ເພື່ອນບ້ານ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="HAB 2:15">ຖອກ​ເຄື່ອງດື່ມ​ນັ້ນ​ອອກ​ຈາກ​ຖົງ​ເຫລົ້າອະງຸ່ນ​ຈົນ​ພວກເຂົາ​ເມົາ,</para>
  <para style="q2" vid="HAB 2:15">ເພື່ອ​ວ່າ​ລາວ​ຈະ​ໄດ້​ຈ້ອງ​ເບິ່ງ​ຮ່າງກາຍ​ທີ່​ເປືອຍກາຍ​ຂອງ​ພວກເຂົາ!<verse eid="HAB 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16" />ເຈົ້າ​ຈະ​ເຕັມ​ໄປ​ດ້ວຍ​ຄວາມ​ອັບອາຍ​ແທນ​ທີ່​ຈະ​ໄດ້​ສະຫງ່າລາສີ.</para>
  <para style="q2" vid="HAB 2:16">ບັດນີ້ ເຖິງ​ທີ​ຂອງ​ເຈົ້າ​ແລ້ວ! ຈົ່ງ​ດື່ມ ແລະ ໃຫ້​ຄວາມ​ເປືອຍກາຍ​ຂອງ​ເຈົ້າ​ຖືກ​ເປີດເຜີຍ<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">ຫລື ແລະ ເຊ​ໄປ​ມາ</char></note>!</para>
  <para style="q1" vid="HAB 2:16">ຈອກ​ຈາກ​ມື​ຂວາ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ກຳລັງ​ວຽນ​ມາ​ຮອດ​ເຈົ້າ​ແລ້ວ,</para>
  <para style="q2" vid="HAB 2:16">ແລ້ວ​ຄວາມ​ອັບອາຍ​ຈະ​ປົກ​ບັງ​ສະຫງ່າລາສີ​ຂອງ​ເຈົ້າ,<verse eid="HAB 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17" />ຄວາມ​ຮຸນແຮງ​ທີ່​ເຈົ້າ​ເຮັດ​ໄວ້​ກັບ​ເລບານອນ​ຈະ​ຄອບງຳ​ເຈົ້າ,</para>
  <para style="q2" vid="HAB 2:17">ແລະ ການ​ທີ່​ເຈົ້າ​ທຳລາຍ​ສັດ​ທັງຫລາຍ​ຈະ​ເຮັດ​ໃຫ້​ເຈົ້າ​ຢ້ານກົວ.</para>
  <para style="q1" vid="HAB 2:17">ເພາະ​ເຈົ້າ​ເຮັດ​ໃຫ້​ຄົນ​ຕ້ອງ​ນອງ​ເລືອດ;</para>
  <para style="q2" vid="HAB 2:17">ເຈົ້າ​ໄດ້​ທຳລາຍ​ດິນແດນ ແລະ ເມືອງ​ຕ່າງ​ໆ ແລະ ພວກເຂົາ​ທຸກຄົນ.<verse eid="HAB 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18" />“ຮູບເຄົາລົບ​ມີ​ຄຸນຄ່າ​ຫຍັງ​ໃນ​ເມື່ອ​ມະນຸດ​ເປັນ​ຜູ້​ແກະສະຫລັກ​ມັນ​ຂຶ້ນ​ມາ?</para>
  <para style="q2" vid="HAB 2:18">ຫລື ຮູບ​ທີ່​ສອນ​ຄວາມ​ຕົວະ​ນັ້ນ​ມີ​ຄຸນຄ່າ​ຫຍັງ?</para>
  <para style="q1" vid="HAB 2:18">ເພາະ​ຜູ້​ທີ່​ສ້າງ​ຮູບ​ນັ້ນ​ຂຶ້ນ​ກໍ​ວາງໃຈ​ໃນ​ສິ່ງ​ທີ່​ຕົນ​ສ້າງ;</para>
  <para style="q2" vid="HAB 2:18">ລາວ​ສ້າງ​ຮູບເຄົາລົບ​ທີ່​ເວົ້າ​ບໍ່​ໄດ້.<verse eid="HAB 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19" />ວິບັດ​ແກ່​ລາວ​ຜູ້​ທີ່​ເວົ້າ​ກັບ​ໄມ້​ວ່າ ‘ຈົ່ງ​ມີ​ຊີວິດ​ຂຶ້ນ​ມາ!’</para>
  <para style="q2" vid="HAB 2:19">ຫລື ເວົ້າ​ກັບ​ກ້ອນ​ຫີນ​ທີ່​ບໍ່​ມີ​ຊີວິດ​ນັ້ນ​ວ່າ, ‘ຈົ່ງ​ຕື່ນ​ຂຶ້ນ​ມາ!’</para>
  <para style="q1" vid="HAB 2:19">ມັນ​ຈະ​ໃຫ້​ຄຳ​ແນະນຳ​ໄດ້​ບໍ?</para>
  <para style="q2" vid="HAB 2:19">ມັນ​ໂອບ​ດ້ວຍ​ຄຳ ແລະ ເງິນ;</para>
  <para style="q2" vid="HAB 2:19">ມັນ​ບໍ່​ມີ​ລົມຫາຍໃຈ​ຢູ່​ພາຍ​ໃນ”.<verse eid="HAB 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20" />ແຕ່​ພຣະເຈົ້າ​ຢາເວ​ແມ່ນ​ຢູ່​ໃນ​ວິຫານ​ສັກສິດ​ຂອງ​ພຣະອົງ;</para>
  <para style="q2" vid="HAB 2:20">ໃຫ້​ທັງ​ໂລກ​ຈົ່ງ​ມິດງຽບ​ຢູ່​ຕໍ່ໜ້າ​ພຣະອົງ.<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="s1">ຄຳ​ອະທິຖານ​ຂອງ​ຮາບາກຸກ</para>
  <para style="d">
    <verse number="1" style="v" sid="HAB 3:1" />ຄຳ​ອະທິຖານ​ຂອງ​ຜູ້ທຳນວາຍ​ຮາບາກຸກ, ທຳນອງ​ຊິກິໂອໂນດ<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">ອາດ​ຈະ​ເປັນ​ສັບ​ທາງ​ວັນນະຄະດີ ຫລື ທາງ​ດົນຕີ</char></note><verse eid="HAB 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2" />ຂ້າ​ແດ່​ພຣະເຈົ້າ​ຢາເວ, ຂ້ານ້ອຍ​ເຄີຍ​ໄດ້​ຍິນ​ຊື່ສຽງ​ຂອງ​ພຣະອົງ;</para>
  <para style="q2" vid="HAB 3:2">ຂ້າ​ແດ່​ພຣະເຈົ້າ​ຢາເວ, ຂ້ານ້ອຍ​ຢືນ​ຢູ່​ດ້ວຍ​ຄວາມ​ຢຳເກງ​ໃນ​ກິດຈະການ​ຂອງ​ພຣະອົງ.</para>
  <para style="q1" vid="HAB 3:2">ຂໍ​ໂຜດ​ຮື້​ຟື້ນ​ກິດຈະການ​ເຫລົ່ານັ້ນ​ໃນ​ສະໄໝ​ຂອງ​ພວກຂ້ານ້ອຍ​ທັງຫລາຍ​ຄືນ​ອີກ,</para>
  <para style="q2" vid="HAB 3:2">ຂໍ​ໃຫ້​ຮູ້​ທົ່ວ​ກັນ​ໃນ​ສະໄໝ​ຂອງ​ພວກຂ້ານ້ອຍ​ທັງຫລາຍ;</para>
  <para style="q2" vid="HAB 3:2">ໃນ​ຄວາມ​ໂກດຮ້າຍ​ນັ້ນ​ຂໍ​ໃຫ້​ລະນຶກ​ເຖິງ​ຄວາມ​ເມດຕາ.<verse eid="HAB 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3" />ພຣະເຈົ້າ​ໄດ້​ມາ​ຈາກ​ເຕມານ,</para>
  <para style="q2" vid="HAB 3:3">ອົງ​ບໍລິສຸດ​ມາ​ຈາກ​ພູເຂົາ​ປາຣານ.<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">ອ່ານ​ວ່າ </char><char style="fqa" closed="false">ເສລາ </char><char style="ft" closed="false">ໃນ​ພາສາ​ເຮັບເຣີ​ຄຳ​ນີ້​ມີ​ຄວາມຫມາຍ​ບໍ່​ຊັດເຈນ ອາດ​ຈະ​ເປັນ​ສັບ​ທາງ​ດົນຕີ ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="HAB 3:9"><ref loc="HAB 3:9">9</ref></char> ແລະ <char style="xt" link-href="HAB 3:13"><ref loc="HAB 3:13">13</ref></char>.</char></note></para>
  <para style="q1" vid="HAB 3:3">ສະຫງ່າລາສີ​ຂອງ​ພຣະອົງ​ກໍ​ປົກຄຸມ​ຟ້າ​ສະຫວັນ</para>
  <para style="q2" vid="HAB 3:3">ແລະ ໂລກ​ນີ້​ກໍ​ເຕັມ​ດ້ວຍ​ຄຳ​ສັນລະເສີນ​ພຣະອົງ.<verse eid="HAB 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4" />ຄວາມ​ສະຫງ່າງາມ​ຂອງ​ພຣະອົງ​ຄື​ກັບ​ຕາເວັນ​ທີ່​ກຳລັງ​ຂຶ້ນ;</para>
  <para style="q2" vid="HAB 3:4">ມີ​ແສງ​ກະພິບ​ອອກ​ມາ​ຈາກ​ມື,</para>
  <para style="q2" vid="HAB 3:4">ບ່ອນ​ທີ່​ລິດອຳນາດ​ຂອງ​ພຣະອົງ​ໄດ້​ຖືກ​ເຊື່ອງ​ໄວ້.<verse eid="HAB 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5" />ໄພພິບັດ​ໄດ້​ໄປ​ກ່ອນ​ພຣະອົງ;</para>
  <para style="q2" vid="HAB 3:5">ໂລກລະບາດ​ໄດ້​ຕາມ​ບາດກ້າວ​ຂອງ​ພຣະອົງ​ມາ.<verse eid="HAB 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6" />ພຣະອົງ​ຢືນ ແລະ ໂລກ​ກໍ​ສັ່ນ;</para>
  <para style="q2" vid="HAB 3:6">ພຣະອົງ​ຫລຽວເບິ່ງ ແລະ ບັນດາ​ປະຊາຊາດ​ກໍ​ສັ່ນ​ສະທ້ານ</para>
  <para style="q1" vid="HAB 3:6">ພູເຂົາ​ດຶກດຳບັນ​ທັງຫລາຍ​ກໍ​ພັງ​ທະລາຍ​ລົງ</para>
  <para style="q2" vid="HAB 3:6">ເນີນພູ​ເກົ່າ​ແກ່​ທັງຫລາຍ​ກໍ​ພັງ​ລົງ</para>
  <para style="q2" vid="HAB 3:6">ແຕ່ ພຣະອົງ​ເດີນ​ຕໍ່​ໄປ​ຕະຫລອດໄປ.<verse eid="HAB 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7" />ຂ້ານ້ອຍ​ໄດ້​ເຫັນ​ເຕັນ​ຂອງ​ຊາວ​ຄູຊັນ​ຕົກ​ຢູ່​ໃນ​ຄວາມ​ທຸກຍາກ</para>
  <para style="q2" vid="HAB 3:7">ແລະ ບ່ອນຢູ່​ຂອງ​ຊາວ​ມີດີອານ​ກໍ​ຕົກ​ຢູ່​ໃນ​ຄວາມ​ທໍລະມານ.<verse eid="HAB 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8" />ຂ້າ​ແດ່​ພຣະເຈົ້າ​ຢາເວ ພຣະອົງ​ໃຈຮ້າຍ​ໃຫ້​ແມ່ນ້ຳ​ບໍ?</para>
  <para style="q2" vid="HAB 3:8">ພຣະອົງ​ໂກດຮ້າຍ​ໃຫ້​ສາຍນ້ຳ​ບໍ?</para>
  <para style="q1" vid="HAB 3:8">ພຣະອົງ​ໂກດຮ້າຍ​ຕໍ່​ທະເລ</para>
  <para style="q2" vid="HAB 3:8">ເມື່ອ​ພຣະອົງ​ຂີ່​ມ້າ​ຂອງ​ພຣະອົງ</para>
  <para style="q2" vid="HAB 3:8">ແລະ ລົດມ້າ​ຂອງ​ພຣະອົງ​ໄປ​ສູ່​ໄຊຊະນະ​ບໍ?<verse eid="HAB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9" />ພຣະອົງ​ຈັບ​ຄັນທະນູ​ອອກ​ມາ,</para>
  <para style="q2" vid="HAB 3:9">ພຣະອົງ​ໄດ້​ເອີ້ນ​ຫາ​ລູກທະນູ​ມາ​ຢ່າງ​ຫລວງຫລາຍ.</para>
  <para style="q1" vid="HAB 3:9">ພຣະອົງ​ແຍກ​ແຜ່ນດິນ​ດ້ວຍ​ແມ່ນ້ຳ;<verse eid="HAB 3:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="HAB 3:10" />ພູເຂົາ​ທັງຫລາຍ​ໄດ້​ເຫັນ​ພຣະອົງ ແລະ ບິດ​ໂຕ​ໄປ​ມາ</para>
  <para style="q1" vid="HAB 3:10">ກະແສນ້ຳ​ກວດ​ໄປ;</para>
  <para style="q2" vid="HAB 3:10">ນໍ້າ​ເລິກ​ສົ່ງ​ສຽງ​ດັງ​ກ້ອງ</para>
  <para style="q2" vid="HAB 3:10">ແລະ ຊັດ​ຄື້ນ​ຂອງ​ມັນ​ຂຶ້ນ​ສູງ.<verse eid="HAB 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11" />ດວງ​ຕາເວັນ ແລະ ດວງ​ເດືອນ​ຢຸດ​ຢູ່​ໃນ​ຟ້າ​ສະຫວັນ</para>
  <para style="q2" vid="HAB 3:11">ເມື່ອ​ລູກທະນູ​ທີ່​ພຸ່ງ​ອອກ​ມາ​ຂອງ​ພຣະອົງ​ກໍ​ສ່ອງ​ປະກາຍ,</para>
  <para style="q2" vid="HAB 3:11">ເມື່ອ​ຫອກ​ຂອງ​ພຣະອົງ​ສ່ອງ​ປະກາຍ​ຄື​ກັບ​ຟ້າ​ແມບ.<verse eid="HAB 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12" />ພຣະອົງ​ກະທືບ​ແຜ່ນດິນໂລກ​ດ້ວຍ​ຄວາມ​ໂກດຮ້າຍ</para>
  <para style="q2" vid="HAB 3:12">ແລະ ຢຽບ​ປະຊາຊາດ​ທັງຫລາຍ​ດ້ວຍ​ຄວາມ​ໃຈຮ້າຍ.<verse eid="HAB 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13" />ພຣະອົງ​ໄດ້​ອອກ​ມາ​ປົດປ່ອຍ​ຄົນ​ຂອງ​ພຣະອົງ,</para>
  <para style="q2" vid="HAB 3:13">ເພື່ອ​ຊ່ວຍ​ຜູ້​ທີ່​ພຣະອົງ​ໄດ້​ເຈີມ​ໄວ້​ໃຫ້​ພົ້ນ.</para>
  <para style="q1" vid="HAB 3:13">ພຣະອົງ​ຂະຢີ້​ຜູ້ນຳ​ຂອງ​ດິນແດນ​ແຫ່ງ​ຄວາມ​ຊົ່ວຮ້າຍ</para>
  <para style="q2" vid="HAB 3:13">ພຣະອົງ​ເຮັດ​ໃຫ້​ລາວ​ເປືອຍກາຍ​ຕັ້ງແຕ່​ຫົວ​ຈົນ​ຮອດ​ຕີນ.<verse eid="HAB 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14" />ພຣະອົງ​ຈະ​ໃຊ້​ຫອກ​ຂອງ​ລາວ​ເອງ​ແທງ​ຫົວ​ຂອງ​ລາວ</para>
  <para style="q2" vid="HAB 3:14">ເມື່ອ​ບັນດາ​ນັກຮົບ​ຂອງ​ລາວ​ບຸກ​ມາ​ເພື່ອ​ຕີ​ພວກຂ້ານ້ອຍ​ໃຫ້​ກະຈັດກະຈາຍ,</para>
  <para style="q1" vid="HAB 3:14">ຍິ້ມ​ເຢີ້ຍ​ເໝືອນ​ກັບ​ວ່າ​ຈະ​ເຂົ້າ​ມາ​ກັດ​ກິນ</para>
  <para style="q2" vid="HAB 3:14">ຄົນ​ໜ້າ​ເວດທະນາ​ທີ່​ລີ້​ຢູ່.<verse eid="HAB 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15" />ພຣະອົງ​ໄດ້​ຢຽບຢ່ຳ​ທະເລ​ດ້ວຍ​ຝູງ​ມ້າ​ຂອງ​ພຣະອົງ,</para>
  <para style="q2" vid="HAB 3:15">ເຮັດ​ໃຫ້​ຫ້ວງ​ນໍ້າ​ໃຫຍ່​ປັ່ນປ່ວນ<verse eid="HAB 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16" />ຂ້ານ້ອຍ​ໄດ້​ຍິນ ແລະ ຫົວໃຈ​ຂອງ​ຂ້ານ້ອຍ​ກໍ​ຕື່ນເຕັ້ນ,</para>
  <para style="q2" vid="HAB 3:16">ສຽງ​ນັ້ນ​ເຮັດ​ໃຫ້​ຮີບສົບ​ຂອງ​ຂ້ານ້ອຍ​ສັ່ນ;</para>
  <para style="q1" vid="HAB 3:16">ຄວາມ​ເຊື່ອມໂຊມ​ກໍ​ໄດ້​ເຂົ້າ​ສູ່​ກະດູກ​ຂອງ​ຂ້ານ້ອຍ;</para>
  <para style="q2" vid="HAB 3:16">ແລະ ຂາ​ຂອງ​ຂ້ານ້ອຍ​ກໍ​ສັ່ນສະເທືອນ.</para>
  <para style="q1" vid="HAB 3:16">ເຖິງ​ປານ​ນັ້ນ​ຂ້ານ້ອຍ​ກໍ​ຈະ​ອົດທົນ​ລໍຖ້າ​ວັນ​ແຫ່ງ​ໄພພິບັດ,</para>
  <para style="q2" vid="HAB 3:16">ທີ່​ຈະ​ມາ​ເຖິງ​ຊົນຊາດ​ທີ່​ຮຸກຮານ​ພວກຂ້ານ້ອຍ.<verse eid="HAB 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17" />ເຖິງ​ແມ່ນ​ວ່າ​ຕົ້ນ​ໝາກເດື່ອ​ຈະ​ບໍ່​ອອກ​ດອກ</para>
  <para style="q2" vid="HAB 3:17">ແລະ ເຄືອອະງຸ່ນ​ຈະ​ບໍ່​ມີ​ໝາກ​ອະງຸ່ນ,</para>
  <para style="q1" vid="HAB 3:17">ເຖິງ​ແມ່ນ​ວ່າ​ຕົ້ນ​ໝາກກອກ​ຈະ​ບໍ່​ໃຫ້​ຜົນ</para>
  <para style="q2" vid="HAB 3:17">ແລະ ທົ່ງນາ​ທັງຫລາຍ​ຈະ​ບໍ່​ເກີດ​ພືດ​ເພື່ອ​ເປັນ​ອາຫານ,</para>
  <para style="q1" vid="HAB 3:17">ເຖິງ​ແມ່ນ​ວ່າ​ຈະ​ບໍ່​ມີ​ແກະ​ຢູ່​ໃນ​ຄອກ</para>
  <para style="q2" vid="HAB 3:17">ແລະ ບໍ່​ມີ​ງົວ​ຢູ່​ໃນ​ຄອກ​ກໍ​ຕາມ,<verse eid="HAB 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18" />ແຕ່​ເຖິງ​ປານ​ນັ້ນ​ຂ້ານ້ອຍ​ກໍ​ຈະ​ຊື່ນຊົມຍິນດີ​ໃນ​ພຣະເຈົ້າ​ຢາເວ,</para>
  <para style="q2" vid="HAB 3:18">ຂ້ານ້ອຍ​ຈະ​ມີ​ຄວາມສຸກ​ໃນ​ພຣະເຈົ້າ ພຣະຜູ້ຊ່ວຍ​ໃຫ້​ພົ້ນ​ຂອງ​ຂ້ານ້ອຍ.<verse eid="HAB 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19" />ພຣະເຈົ້າ​ຢາເວ​ອົງ​ເຈົ້ານາຍ​ເປັນ​ກຳລັງ​ຂອງ​ຂ້ານ້ອຍ;</para>
  <para style="q2" vid="HAB 3:19">ພຣະອົງ​ໄດ້​ເຮັດ​ໃຫ້​ຕີນ​ຂອງ​ຂ້ານ້ອຍ​ເປັນ​ເໝືອນ​ກັບ​ຕີນ​ກວາງ</para>
  <para style="q2" vid="HAB 3:19">ພຣະອົງ​ໄດ້​ຊ່ວຍ​ໃຫ້​ຂ້ານ້ອຍ​ຢຽບ​ເທິງ​ທີ່​ສູງ​ໄດ້.</para>
  <para style="d" vid="HAB 3:19">ສຳລັບ​ຜູ້ອຳນວຍການ​ຂອງ​ເພງ ໃຊ້​ກັບ​ເຄື່ອງດົນຕີ​ປະເພດ​ສາຍ​ຂອງ​ຂ້ານ້ອຍ.<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>