<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Biblica® Open Lao Contemporary Version</book>
  <para style="rem">Copyright © 2023, 2025 by Biblica, Inc.</para>
  <para style="h">ມີກາ</para>
  <para style="toc1">ພຣະທຳມີກາ</para>
  <para style="toc2">ມີກາ</para>
  <para style="toc3">ມກ</para>
  <para style="mt1">ພຣະທຳມີກາ</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />ຖ້ອຍຄຳ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ທີ່​ໄດ້​ມາ​ເຖິງ​ມີກາ​ແຫ່ງ​ໂມເຣເຊັດ ໃນ​ສະໄໝ​ຂອງ​ກະສັດ​ໂຢທາມ, ອາຮາດ ແລະ ເຮເຊກີຢາ​ແຫ່ງ​ຢູດາ ຕໍ່​ໄປ​ນີ້​ຄື​ນິມິດ​ທີ່​ມີກາ​ໄດ້​ເຫັນ​ກ່ຽວ​ກັບ​ຊາມາເຣຍ ແລະ ເຢຣູຊາເລັມ.<verse eid="MIC 1:1" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2" />ປະຊາຊາດ​ທັງຫລາຍ, ພວກເຈົ້າ​ທຸກຄົນ, ຈົ່ງ​ຟັງ,</para>
  <para style="q2" vid="MIC 1:2">ໂລກ ແລະ ທຸກ​ຄົນ​ທີ່​ຢູ່​ໃນ​ໂລກ, ຈົ່ງ​ຟັງ,</para>
  <para style="q1" vid="MIC 1:2">ພຣະເຈົ້າ​ຢາເວ ອົງ​ເຈົ້ານາຍ​ຈະ​ເປັນ​ພະຍານ​ກ່າວ​ໂທດ​ພວກເຈົ້າ,</para>
  <para style="q2" vid="MIC 1:2">ອົງພຣະຜູ້ເປັນເຈົ້າ​ຈາກ​ວິຫານ​ສັກສິດ​ຂອງ​ພຣະອົງ.<verse eid="MIC 1:2" /></para>
  <para style="s1">ຄຳ​ພິພາກສາ​ຊາມາເຣຍ ແລະ ເຢຣູຊາເລັມ</para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3" />ເບິ່ງ​ແມ! ພຣະເຈົ້າ​ຢາເວ​ກຳລັງ​ມາ​ຈາກ​ບ່ອນ​ຢູ່​ຂອງ​ພຣະອົງ;</para>
  <para style="q2" vid="MIC 1:3">ພຣະອົງ​ລົງ​ມາ ແລະ ຢຽບຢ່ຳ​ຢູ່​ເທິງ​ທີ່​ສູງ​ຂອງ​ໂລກ.<verse eid="MIC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4" />ພູເຂົາ​ທັງຫລາຍ​ຈະ​ລະລາຍ​ຢູ່​ໃຕ້​ພຣະອົງ</para>
  <para style="q2" vid="MIC 1:4">ແລະ ຮ່ອມພູ​ທັງຫລາຍ​ຈະ​ແຍກ​ອອກ,</para>
  <para style="q1" vid="MIC 1:4">ເໝືອນ​ກັບ​ຂີ້ເຜິ້ງ​ທີ່​ຢູ່​ໃກ້​ໄຟ,</para>
  <para style="q2" vid="MIC 1:4">ແລະ ເໝືອນ​ກັບ​ນ້ຳ​ທີ່​ຫລັ່ງໄຫລ​ລົງ​ມາ​ຕາມ​ເປີ້ນພູ.<verse eid="MIC 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5" />ທັງໝົດ​ນີ້​ແມ່ນ​ເປັນ​ເພາະ​ການ​ລ່ວງລະເມີດ​ຂອງ​ຢາໂຄບ,</para>
  <para style="q2" vid="MIC 1:5">ເປັນ​ເພາະ​ບາບ​ທັງຫລາຍ​ຂອງ​ຄົນ​ອິດສະຣາເອນ.</para>
  <para style="q1" vid="MIC 1:5">ຢາໂຄບ​ລ່ວງລະເມີດ​ຫຍັງ?</para>
  <para style="q2" vid="MIC 1:5">ບໍ່​ແມ່ນ​ຊາມາເຣຍ​ບໍ?</para>
  <para style="q1" vid="MIC 1:5">ສະຖານ​ບູຊາ​ເທິງ​ທີ່​ສູງ​ຂອງ​ຢູດາ​ນັ້ນ​ຄື​ຫຍັງ?</para>
  <para style="q2" vid="MIC 1:5">ບໍ່​ແມ່ນ​ເຢຣູຊາເລັມ​ບໍ?<verse eid="MIC 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6" />“ເຫດສະນັ້ນ ເຮົາ​ຈະ​ເຮັດ​ໃຫ້​ຊາມາເຣຍ​ເປັນ​ກອງ​ຂີ້ເຫຍື້ອ,</para>
  <para style="q2" vid="MIC 1:6">ເປັນ​ບ່ອນ​ເຮັດ​ສວນ​ອະງຸ່ນ</para>
  <para style="q1" vid="MIC 1:6">ເຮົາ​ຈະ​ເທ​ຫີນ​ທີ່​ໃຊ້​ສ້າງ​ເມືອງ​ນັ້ນ​ລົງ​ໃນ​ຮ່ອມພູ</para>
  <para style="q2" vid="MIC 1:6">ແລະ ຈະ​ເຜີຍ​ຮາກຖານ​ຂອງ​ເມືອງ​ນັ້ນ​ອອກ​ມາ.<verse eid="MIC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7" />ຮູບເຄົາລົບ​ທັງໝົດ​ຂອງ​ຊາມາເຣຍ​ຈະ​ຖືກ​ທຸບ​ແຕກ​ເປັນ​ປ່ຽງໆ;</para>
  <para style="q2" vid="MIC 1:7">ເຄື່ອງຖວາຍ​ທັງໝົດ​ໃນ​ວິຫານ​ຂອງ​ເມືອງ​ນັ້ນ​ຈະ​ຖືກ​ໄຟ​ເຜົາ;</para>
  <para style="q2" vid="MIC 1:7">ເຮົາ​ຈະ​ທຳລາຍ​ຮູບເຄົາລົບ​ທັງໝົດ​ຂອງ​ເມືອງ​ນັ້ນ.</para>
  <para style="q1" vid="MIC 1:7">ເນື່ອງ​ຈາກ​ຊາມາເຣຍ​ໄດ້​ຮວບຮວມ​ເຄື່ອງຖວາຍ​ຂອງ​ຕົນ​ມາ​ຈາກ​ຄ່າ​ຈ້າງ​ຂອງ​ໂສເພນີ.</para>
  <para style="q2" vid="MIC 1:7">ຄ່າ​ຈ້າງ​ຂອງ​ໂສເພນີ​ນັ້ນ​ຈະ​ຖືກ​ໃຊ້​ເປັນ​ຄ່າ​ຈ້າງ​ໂສເພນີ​ອີກ”.<verse eid="MIC 1:7" /></para>
  <para style="s1">ຮ້ອງໄຫ້ ແລະ ຄ່ຳຄວນ</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8" />ດ້ວຍ​ເຫດ​ນີ້​ຂ້ອຍ​ຈະ​ຮ້ອງໄຫ້ ແລະ ຄ່ຳຄວນ</para>
  <para style="q2" vid="MIC 1:8">ຂ້ອຍ​ຈະ​ຍ່າງ​ໄປ​ມາ​ຕີນ​ເປົ່າ ແລະ ເປືອຍກາຍ.</para>
  <para style="q1" vid="MIC 1:8">ຂ້ອຍ​ຈະ​ຫອນ​ເໝືອນ​ກັບ​ໝາໄນ</para>
  <para style="q2" vid="MIC 1:8">ແລະ ຄວນຄາງ​ເໝືອນ​ນົກເຄົ້າແມວ.<verse eid="MIC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9" />ເພາະ​ບາດແຜ​ຂອງ​ຊາມາເລຍ​ຢຽວຢາ​ບໍ່​ໄດ້</para>
  <para style="q2" vid="MIC 1:9">ແລະ ໄດ້​ລາມ​ມາ​ເຖິງ​ຢູດາ​ແລ້ວ.</para>
  <para style="q1" vid="MIC 1:9">ມາ​ເຖິງ​ປະຕູ​ເມືອງ​ຂອງ​ພີ່ນ້ອງ​ຮ່ວມ​ຊາດ​ຂອງ​ຂ້ອຍ,</para>
  <para style="q2" vid="MIC 1:9">ມາ​ເຖິງ​ເຢຣູຊາເລັມ.<verse eid="MIC 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10" />ຢ່າ​ບອກ​ເລື່ອງ​ນີ້​ໃນ​ເມືອງ​ກາດ<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">ຄຳ​ວ່າ ກາດ ມີ​ສຽງ​ຄ້າຍ​ຄຳ​ພາສາ​ເຮັບເຣີ​ທີ່​ມີ​ຄວາມຫມາຍ​ວ່າ ບອກ</char></note>;</para>
  <para style="q2" vid="MIC 1:10">ຢ່າ​ຮ້ອງໄຫ້​ເລີຍ.</para>
  <para style="q1" vid="MIC 1:10">ຢ່າ​ບອກ​ໃນ​ເບດ​ໂອຟຣາ<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">ແປ​ວ່າ ເຮືອນ​ຝຸ່ນ</char></note></para>
  <para style="q2" vid="MIC 1:10">ຈົ່ງ​ເກືອກ​ໂຕ​ໃນ​ຂີ້ຝຸ່ນ.<verse eid="MIC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11" />ພວກເຈົ້າ​ຜູ້​ອາໄສ​ຢູ່​ໃນ​ຊານເຟຍ,<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">ແປ​ວ່າ ໜ້າ​ພໍໃຈ</char></note></para>
  <para style="q2" vid="MIC 1:11">ຈົ່ງ​ໜີ​ໄປ​ຢ່າງ​ເປືອຍກາຍ ແລະ ອັບອາຍ​ຂາຍໜ້າ,</para>
  <para style="q1" vid="MIC 1:11">ບັນດາ​ຜູ້​ທີ່​ອາໄສ​ຢູ່​ໃນ​ຊາອານານ<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">ຄຳ​ວ່າ ສາ​ອາ​ນັນ ສຽງ​ຄ້າຍ​ຄຳ​ພາສາ​ເຮັບເຣີ​ທີ່​ມີ​ຄວາມຫມາຍ​ວ່າ ອອກ​ມາ</char></note></para>
  <para style="q2" vid="MIC 1:11">ຈະ​ບໍ່​ອອກ​ມາ.</para>
  <para style="q1" vid="MIC 1:11">ເບັດເອເຊນ​ກຳລັງ​ໂສກເສົ້າ</para>
  <para style="q2" vid="MIC 1:11">ການ​ປົກປ້ອງ​ຄຸ້ມຄອງ​ຖືກ​ຍົກ​ໄປ​ຈາກ​ເຈົ້າ​ແລ້ວ.<verse eid="MIC 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12" />ບັນດາ​ຜູ້​ອາໄສ​ຢູ່​ໃນ​ມາໂຣດ<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">ຄຳ​ວ່າ ມາໂຣດ ສຽງ​ຄ້າຍ​ຄຳ​ພາສາ​ເຮັບເຣີ​ທີ່​ມີ​ຄວາມຫມາຍ​ວ່າ ຂົມຂື່ນ</char></note>​ດີ້ນ​ດ້ວຍ​ຄວາມ​ເຈັບປວດ,</para>
  <para style="q2" vid="MIC 1:12">ລໍຖ້າ​ການ​ບັນເທົາ​ທຸກ,</para>
  <para style="q1" vid="MIC 1:12">ເພາະ​ໄພພິບັດ​ທີ່​ຈາກ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q2" vid="MIC 1:12">ມາ​ເຖິງ​ປະຕູ​ເຢຣູຊາເລັມ​ແລ້ວ.<verse eid="MIC 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13" />ພວກເຈົ້າ​ຜູ້​ອາໄສ​ໃນ​ລາກິດ,<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">ຄຳ​ວ່າ ລາກິດ ສຽງ​ຄ້າຍ​ຄຳ​ພາສາ​ເຮັບເຣີ​ທີ່​ມີ​ຄວາມ​ຫມາຍ​ວ່າ ຝູງ​ມ້າ</char></note></para>
  <para style="q2" vid="MIC 1:13">ຈົ່ງ​ທຽມ​ຝູງ​ມ້າ​ເຂົ້າ​ກັບ​ລົດ​ມ້າໄວ.</para>
  <para style="q1" vid="MIC 1:13">ພວກເຈົ້າ​ເປັນ​ຜູ້​ທຳອິດ​ທີ່​ນຳ​ລູກ​ສາວ​ແຫ່ງ​ຊີໂອນ<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">ຄື ຊາວ​ເຢຣູຊາເລັມ</char></note>​ໃຫ້​ເຮັດ​ບາບ</para>
  <para style="q2" vid="MIC 1:13">ເພາະ​ໄດ້​ພົບ​ການ​ລ່ວງລະເມີດ​ຂອງ​ອິດສະຣາເອນ​ໃນ​ພວກເຈົ້າ.<verse eid="MIC 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14" />ເຫດສະນັ້ນ​ພວກເຈົ້າ​ຈະ​ໃຫ້​ຂອງຂັວນ​ອຳລາ</para>
  <para style="q2" vid="MIC 1:14">ແກ່​ໂມເຣເຊັດ​ກັດ.</para>
  <para style="q1" vid="MIC 1:14">ເມືອງ​ອັກຊິບ<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">ແປ​ວ່າ ລໍ້ລວງ</char></note>​ຈະ​ຖືກ​ຈັບ​ໄດ້​ວ່າ​ຫລອກລວງ</para>
  <para style="q2" vid="MIC 1:14">ບັນດາ​ກະສັດ​ອິດສະຣາເອນ.<verse eid="MIC 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15" />ເຮົາ​ຈະ​ນຳ​ຜູ້ພິຊິດ​ມາ​ຕໍ່ສູ້​ພວກເຈົ້າ</para>
  <para style="q2" vid="MIC 1:15">ຜູ້​ທີ່​ອາໄສ​ຢູ່​ໃນ​ມາເຣຊາ.<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">ຄຳວ່າ ມາເຣຊາ ມີ​ສຽງ​ຄ້າຍ​ຄຳ​ພາສາ​ເຮັບເຣີ​ທີ່​ມີ​ຄວາມ​ຫມາຍ​ວ່າ ຜູ້ພິຊິດ</char></note></para>
  <para style="q1" vid="MIC 1:15">ບັນດາ​ຂຸນນາງ​ຂອງ​ອິດສະຣາເອນ</para>
  <para style="q2" vid="MIC 1:15">ຈະ​ໜີ​ໄປ​ລີ້​ຢູ່​ທີ່​ອາດຸນລຳ.<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ຜູ້​ເປັນ​ສະຫງ່າລາສີ​ຂອງ​ອິດສະຣາເອນ​ຈະ​ມາ​ທີ່​ອາດຸນລຳ</char></note><verse eid="MIC 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16" />ຈົ່ງ​ແຖ​ຫົວ​ຂອງ​ພວກເຈົ້າ​ເພື່ອ​ໄວ້​ທຸກ</para>
  <para style="q2" vid="MIC 1:16">ໃຫ້​ບັນດາ​ລູກ​ທີ່​ເຈົ້າ​ຊື່ນໃຈ​ນຳ;</para>
  <para style="q1" vid="MIC 1:16">ຈົ່ງ​ແຖ​ຫົວ​ໃຫ້​ລ້ານ​ເໝືອນ​ແຮ້ງ,</para>
  <para style="q2" vid="MIC 1:16">ເພາະ​ບັນດາ​ລູກ​ຂອງ​ພວກເຈົ້າ​ຈະ​ຖືກ​ຈັບ​ໄປ​ເປັນ​ຊະເລີຍ.<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s1">ແຜນການ​ຂອງ​ມະນຸດ ແລະ ແຜນ​ງານ​ຂອງ​ພຣະເຈົ້າ</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1" />ວິບັດ​ແກ່​ບັນດາ​ຜູ້​ທີ່​ວາງ​ແຜນ​ຊົ່ວຮ້າຍ,</para>
  <para style="q2" vid="MIC 2:1">ບັນດາ​ຜູ້​ທີ່​ຄິດ​ອຸບາຍ​ຊົ່ວຮ້າຍ​ຂະນະ​ນອນ​ຢູ່​ເທິງ​ຕຽງ​ຂອງ​ຕົນ!</para>
  <para style="q1" vid="MIC 2:1">ເມື່ອ​ຮຸ່ງ​ເຊົ້າ​ມາ​ພວກເຂົາ​ກໍ​ດຳເນີນ​ການ​ຕາມ​ແຜນ​ນັ້ນ</para>
  <para style="q2" vid="MIC 2:1">ເພາະ​ຢູ່​ໃນ​ອຳນາດ​ທີ່​ພວກເຂົາ​ຈະ​ເຮັດ​ໄດ້.<verse eid="MIC 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2" />ພວກເຂົາ​ໂລບ​ຢາກ​ໄດ້​ທີ່​ດິນ ແລະ ກໍ​ຢຶດ​ເອົາ</para>
  <para style="q2" vid="MIC 2:2">ແລະ ຢາກ​ໄດ້​ເຮືອນ​ແລ້ວ​ກໍ​ເອົາ​ໄປ.</para>
  <para style="q1" vid="MIC 2:2">ພວກເຂົາ​ໄດ້​ໂກງ​ຄົນ​ທັງຫລາຍ​ທີ່​ຢູ່​ໃນ​ເຮືອນ​ຂອງ​ພວກເຂົາ,</para>
  <para style="q2" vid="MIC 2:2">ພວກເຂົາ​ໄດ້​ໂກງ​ເອົາ​ມໍລະດົກ​ຂອງ​ເພື່ອນ​ມະນຸດ.<verse eid="MIC 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3" />ເຫດສະນັ້ນ, ພຣະເຈົ້າ​ຢາເວ​ຈຶ່ງ​ກ່າວ​ວ່າ:</para>
  <para style="q1" vid="MIC 2:3">“ເຮົາ​ກຳລັງ​ວາງ​ແຜນ​ນຳ​ໄພພິບັດ​ມາ​ໃຫ້​ແກ່​ຄົນ​ເຫລົ່ານີ້,</para>
  <para style="q2" vid="MIC 2:3">ເຊິ່ງ​ພວກເຈົ້າ​ບໍ່​ມີ​ທາງ​ຊ່ວຍ​ຕົນ​ເອງ​ໃຫ້​ລອດ​ໄປ​ໄດ້​ເລີຍ.</para>
  <para style="q1" vid="MIC 2:3">ພວກເຈົ້າ​ຈະ​ບໍ່​ຍ່າງ​ອວດອົ່ງ​ອີກ​ຕໍ່​ໄປ,</para>
  <para style="q2" vid="MIC 2:3">ເພາະ​ມັນ​ຈະ​ເປັນ​ເວລາ​ແຫ່ງ​ຄວາມ​ພິນາດ.<verse eid="MIC 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4" />ໃນ​ມື້​ນັ້ນ​ຄົນ​ທັງຫລາຍ​ຈະ​ເຢາະເຢີ້ຍ​ພວກເຈົ້າ;</para>
  <para style="q2" vid="MIC 2:4">ພວກເຂົາ​ຈະ​ເຢາະເຢີ້ຍ​ພວກເຈົ້າ​ດ້ວຍ​ເພງ​ໂສກເສົ້າ​ບົດ​ນີ້​ວ່າ:</para>
  <para style="q1" vid="MIC 2:4">‘ພວກເຮົາ​ຖືກ​ທຳລາຍ​ໃຫ້​ພັງ​ພິນາດ;</para>
  <para style="q2" vid="MIC 2:4">ເຄື່ອງຂອງ​ທີ່​ເປັນ​ກຳມະສິດ​ຂອງ​ພີ່ນ້ອງ​ຮ່ວມ​ຊາດ​ຂອງ​ຂ້ອຍ​ຖືກ​ຢຶດ​ໄປ​ແບ່ງ​ກັນ.</para>
  <para style="q1" vid="MIC 2:4">ພຣະອົງ​ຢຶດ​ເອົາ​ໄປ​ຈາກ​ຂ້ອຍ​ແລ້ວ!</para>
  <para style="q2" vid="MIC 2:4">ພຣະອົງ​ມອບ​ທີ່​ດິນ​ຂອງ​ພວກເຮົາ​ໃຫ້​ແກ່​ບັນດາ​ຄົນ​ທໍລະຍົດ’ ”<verse eid="MIC 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5" />ເຫດສະນັ້ນ ພວກເຈົ້າ​ຈະ​ບໍ່​ມີ​ຜູ້ໃດ​ຈັກ​ຄົນ​ໃນ​ຊຸມຊົນ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q2" vid="MIC 2:5">ມາ​ຈັບ​ສະຫລາກ​ແບ່ງ​ດິນແດນ.<verse eid="MIC 2:5" /></para>
  <para style="s1">ຜູ້ທຳນວາຍ​ປອມ</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6" />ບັນດາ​ຜູ້ທຳນວາຍ​ຂອງ​ພວກເຂົາ​ກ່າວ​ວ່າ, “ຢ່າ​ທຳນວາຍ”,</para>
  <para style="q2" vid="MIC 2:6">“ຢ່າ​ທຳນວາຍ​ກ່ຽວກັບ​ສິ່ງ​ທັງຫລາຍ​ເຫລົ່ານີ້;</para>
  <para style="q2" vid="MIC 2:6">ຄວາມ​ອັບອາຍ​ຈະ​ມາ​ບໍ່​ເຖິງ​ພວກເຮົາ”.<verse eid="MIC 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7" />ພວກເຈົ້າ​ທີ່​ເປັນ​ເຊື້ອສາຍ​ຢາໂຄບ, ຄວນ​ຈະ​ເວົ້າ​ວ່າ,</para>
  <para style="q2" vid="MIC 2:7">“ພຣະເຈົ້າ​ຢາເວ​ບໍ່​ໄດ້​ອົດທົນ​ບໍ?</para>
  <para style="q2" vid="MIC 2:7">ພຣະອົງ​ໄດ້​ກະທຳ​ສິ່ງ​ເຫລົ່ານີ້​ບໍ?”</para>
  <para style="b" vid="MIC 2:7" />
  <para style="q1" vid="MIC 2:7">“ຖ້ອຍ​ຄຳ​ຂອງ​ເຮົາ​ບໍ່​ໄດ້​ເປັນ​ຜົນ​ດີ</para>
  <para style="q2" vid="MIC 2:7">ແກ່​ຜູ້​ປະພຶດ​ຢ່າງ​ຊອບທຳ​ບໍ?<verse eid="MIC 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8" />ເມື່ອ​ບໍ່​ດົນ​ມາ​ນີ້​ປະຊາຊົນ​ຂອງ​ເຮົາ​ໄດ້​ລຸກ​ຂຶ້ນ</para>
  <para style="q2" vid="MIC 2:8">ເໝືອນ​ເປັນ​ສັດຕູ.</para>
  <para style="q1" vid="MIC 2:8">ພວກເຈົ້າ​ແກ້​ເອົາ​ເສື້ອຄຸມ​ຢ່າງ​ດີ</para>
  <para style="q2" vid="MIC 2:8">ຈາກ​ບັນດາ​ຜູ້​ທີ່​ຜ່ານ​ໄປ​ໂດຍ​ບໍ່​ລະວັງ,</para>
  <para style="q2" vid="MIC 2:8">ເໝືອນ​ຄົນ​ທີ່​ຫາ​ກໍ​ກັບ​ມາ​ຈາກ​ການ​ສູ້ຮົບ.<verse eid="MIC 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9" />ພວກເຈົ້າ​ຂັບໄລ່​ແມ່ຍິງ​ໃນ​ທ່າມກາງ​ປະຊາຊົນ​ຂອງ​ຂ້ອຍ​ໃຫ້​ອອກ​ໄປ</para>
  <para style="q2" vid="MIC 2:9">ຈາກ​ບ້ານ​ອັນ​ຜາສຸກ​ຂອງ​ພວກເຂົາ.</para>
  <para style="q1" vid="MIC 2:9">ພວກເຈົ້າ​ຢຶດ​ເອົາ​ພອນ​ຂອງ​ຂ້ອຍ​ໄປ</para>
  <para style="q2" vid="MIC 2:9">ຈາກ​ລູກ​ຫລານ​ຂອງ​ພວກເຂົາ​ຕະຫລອດ​ໄປ.<verse eid="MIC 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10" />ຈົ່ງ​ລຸກ​ຂຶ້ນ, ໄປ​ໃຫ້​ພົ້ນ!</para>
  <para style="q2" vid="MIC 2:10">ເພາະ​ນີ້​ບໍ່​ແມ່ນ​ບ່ອນ​ພັກ​ຂອງ​ພວກເຈົ້າ,</para>
  <para style="q1" vid="MIC 2:10">ເພາະ​ມັນ​ເປັນມົນທິນ​ແລ້ວ,</para>
  <para style="q2" vid="MIC 2:10">ມັນ​ໄດ້​ຫັກພັງ​ແລ້ວ ເກີນ​ກວ່າ​ຈະ​ແກ້​ໄຂ​ທັງໝົດ.<verse eid="MIC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11" />ຫາກ​ຄົນ​ຕົວະ ແລະ ຄົນ​ຫລອກລວງ​ມາ ແລະ ເວົ້າ​ວ່າ,</para>
  <para style="q2" vid="MIC 2:11">‘ຂ້ອຍ​ຈະ​ທຳນວາຍ​ວ່າ​ເຈົ້າ​ຈະ​ມີ​ເຫລົ້າອະງຸ່ນ ແລະ ເບຍ​ຢ່າງ​ເຫລືອ​ເຟືອ’,</para>
  <para style="q2" vid="MIC 2:11">ລາວ​ກໍ​ຈະ​ເປັນ​ຜູ້ທຳນວາຍ​ທີ່​ຊົນຊາດ​ນີ້​ຕ້ອງການ!<verse eid="MIC 2:11" /></para>
  <para style="s1">ສັນຍາ​ຈະ​ຊ່ວຍ​ກອບກູ້</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12" />“ຢາໂຄບ, ເຮົາ​ຈະ​ຮວບຮວມ​ເຈົ້າ​ທັງໝົດ​ຢ່າງ​ແນ່ນອນ,</para>
  <para style="q2" vid="MIC 2:12">ເຮົາ​ຈະ​ເຕົ້າໂຮມ​ຄົນ​ຢິບ​ມື​ໜຶ່ງ​ທີ່​ເຫລືອ​ຂອງ​ອິດສະຣາເອນ​ກັບ​ຄືນ​ມາ​ຢ່າງ​ແນ່ນອນ.</para>
  <para style="q1" vid="MIC 2:12">ເຮົາ​ຈະ​ພາ​ພວກເຂົາ​ມາ​ເຕົ້າໂຮມ​ກັນ​ເໝືອນ​ແກະ​ທີ່​ຢູ່​ໃນ​ຄອກ,</para>
  <para style="q2" vid="MIC 2:12">ເໝືອນ​ຝູງສັດ​ໃນ​ທົ່ງຫຍ້າ;</para>
  <para style="q2" vid="MIC 2:12">ບ່ອນ​ນັ້ນ​ຈະ​ເຕັມ​ໄປ​ດ້ວຍ​ຄົນ​ທັງຫລາຍ.<verse eid="MIC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13" />ອົງ​ຜູ້​ເບີກ​ທາງ​ຈະ​ຂຶ້ນ​ໜ້າ​ນຳ​ພວກເຂົາ​ໄປ;</para>
  <para style="q2" vid="MIC 2:13">ພວກເຂົາ​ຈະ​ທະລຸ​ຜ່ານ​ປະຕູ ແລະ ອອກ​ໄປ.</para>
  <para style="q1" vid="MIC 2:13">ກະສັດ​ຂອງ​ພວກເຂົາ​ຈະ​ຜ່ານ​ຂຶ້ນ​ໜ້າ​ພວກເຂົາ,</para>
  <para style="q2" vid="MIC 2:13">ພຣະເຈົ້າ​ຢາເວ​ນຳ​ໜ້າ​ພວກເຂົາ​ໄປ”.<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="s1">ຕຳໜິ​ຜູ້ນຳ ແລະ ຜູ້​ທຳນວາຍ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1" />ແລ້ວ​ຂ້າພະເຈົ້າ​ໄດ້​ກ່າວ​ວ່າ,</para>
  <para style="q1" vid="MIC 3:1">“ບັນດາ​ຜູ້ນຳ​ຂອງ​ຢາໂຄບ ຈົ່ງ​ຟັງ,</para>
  <para style="q2" vid="MIC 3:1">ພວກທ່ານ​ຜູ້​ທີ່​ປົກຄອງ​ອິດສະຣາເອນ.</para>
  <para style="q1" vid="MIC 3:1">ພວກທ່ານ​ຄວນ​ຈະ​ຮູ້​ຈັກ​ຄວາມ​ຍຸຕິທຳ​ບໍ່​ແມ່ນ​ບໍ?<verse eid="MIC 3:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="MIC 3:2" />ພວກທ່ານ​ຊັງ​ຄວາມ​ດີ ແລະ ຮັກ​ຄວາມ​ຊົ່ວ;</para>
  <para style="q1" vid="MIC 3:2">ພວກທ່ານ​ຜູ້​ຈີກ​ໜັງ​ປະຊາຊົນ​ຂອງ​ເຮົາ</para>
  <para style="q2" vid="MIC 3:2">ແລະ ຈີກ​ຊີ້ນ​ຈາກ​ກະດູກ​ຂອງ​ພວກເຂົາ;<verse eid="MIC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3" />ຜູ້​ກິນ​ຊີ້ນ​ພີ່ນ້ອງ​ຮ່ວມ​ຊາດ​ຂອງ​ເຮົາ,</para>
  <para style="q2" vid="MIC 3:3">ລອກ​ໜັງ​ຂອງ​ພວກເຂົາ​ອອກ</para>
  <para style="q2" vid="MIC 3:3">ແລະ ຫັກ​ກະດູກ​ເປັນ​ຕ່ອນ​ນ້ອຍໆ;</para>
  <para style="q1" vid="MIC 3:3">ຜູ້​ຫັ່ນ​ພວກເຂົາ​ເໝືອນ​ຫັ່ນ​ຊີ້ນ​ໃສ່​ກະທະ,</para>
  <para style="q2" vid="MIC 3:3">ເໝືອນ​ຫັ່ນ​ຊີ້ນ​ໃສ່​ໝໍ້”<verse eid="MIC 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4" />ຫລັງຈາກນັ້ນ ພວກເຂົາ​ຈະ​ຮ້ອງ​ຫາ​ພຣະເຈົ້າ​ຢາເວ,</para>
  <para style="q2" vid="MIC 3:4">ແຕ່​ພຣະອົງ​ຈະ​ບໍ່​ຕອບ​ພວກເຂົາ.</para>
  <para style="q1" vid="MIC 3:4">ເທື່ອ​ນັ້ນ​ພຣະອົງ​ຈະ​ເຊື່ອງ​ໃບໜ້າ​ຂອງພຣະອົງ​ຈາກ​ພວກເຂົາ</para>
  <para style="q2" vid="MIC 3:4">ເພາະ​ຄວາມ​ຊົ່ວ​ທີ່​ພວກເຂົາ​ໄດ້​ເຮັດ.<verse eid="MIC 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5" />ພຣະເຈົ້າ​ຢາເວ​ກ່າວ​ດັ່ງນີ້​ວ່າ:</para>
  <para style="q1" vid="MIC 3:5">“ສຳລັບ​ບັນດາ​ຜູ້ທຳນວາຍ</para>
  <para style="q2" vid="MIC 3:5">ຜູ້​ທີ່​ນຳ​ປະຊາຊົນ​ຂອງ​ເຮົາ​ຕະເຫລີດ​ໄປ,</para>
  <para style="q1" vid="MIC 3:5">ຫາກ​ຜູ້ໃດ​ລ້ຽງດູ​ພວກເຂົາ</para>
  <para style="q2" vid="MIC 3:5">ພວກເຂົາ​ກໍ​ຈະ​ປະກາດ​ວ່າ ‘ຈົ່ງ​ມີ​ສັນຕິສຸກ’</para>
  <para style="q1" vid="MIC 3:5">ຜູ້ໃດ​ບໍ່​ລ້ຽງດູ​ພວກເຂົາ</para>
  <para style="q2" vid="MIC 3:5">ພວກເຂົາ​ກໍ​ຕຽມ​ຈະ​ເຮັດ​ເສິກ​ນໍາ​ຜູ້​ນັ້ນ.<verse eid="MIC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6" />ເຫດສະນັ້ນ ຄ່ຳ​ຄືນ​ຈະ​ມາ​ເຖິງ​ພວກເຈົ້າ ພວກເຈົ້າ​ຈະ​ບໍ່​ເຫັນ​ນິມິດ​ໃດໆ,</para>
  <para style="q2" vid="MIC 3:6">ແລະ ຄວາມ​ມືດ​ມາ​ເຖິງ​ເຈົ້າ ບໍ່​ມີ​ການ​ທຳນວາຍ​ໃດໆ.</para>
  <para style="q1" vid="MIC 3:6">ຕາເວັນ​ຈະ​ລັບ​ໄປ​ສຳລັບ​ບັນດາ​ຜູ້ທຳນວາຍ,</para>
  <para style="q2" vid="MIC 3:6">ແລະ ກາງເວັນ​ຈະ​ມືດ​ໄປ​ສຳລັບ​ພວກເຂົາ.<verse eid="MIC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7" />ຜູ້ພະຍາກອນ​ຈະ​ຖືກ​ອັບອາຍ</para>
  <para style="q2" vid="MIC 3:7">ແລະ ໝໍດູ​ຈະ​ຂາຍໜ້າ.</para>
  <para style="q1" vid="MIC 3:7">ພວກເຂົາ​ທຸກຄົນ​ຈະ​ເອົາ​ມື​ປິດ​ໜ້າ​ຂອງ​ຕົນ</para>
  <para style="q2" vid="MIC 3:7">ເພາະ​ບໍ່​ມີ​ຄຳ​ຕອບ​ຈາກ​ພຣະເຈົ້າ”.<verse eid="MIC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8" />ແຕ່​ສ່ວນ​ຂ້າພະເຈົ້າ ຂ້າພະເຈົ້າ​ແມ່ນ​ເຕັມ​ດ້ວຍ​ລິດອຳນາດ,</para>
  <para style="q2" vid="MIC 3:8">ດ້ວຍ​ພຣະວິນຍານ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ,</para>
  <para style="q2" vid="MIC 3:8">ແລະ ເຕັມ​ດ້ວຍ​ຄວາມ​ຍຸຕິທຳ​ກັບ​ກຳລັງ,</para>
  <para style="q1" vid="MIC 3:8">ເພື່ອ​ປະກາດ​ໃຫ້​ຢາໂຄບ​ຮູ້​ເຖິງ​ການ​ລ່ວງລະເມີດ​ຂອງ​ເພິ່ນ</para>
  <para style="q2" vid="MIC 3:8">ແລະ ໃຫ້​ອິດສະຣາເອນ​ຮູ້​ເຖິງ​ຄວາມ​ບາບ​ຂອງ​ຕົນ.<verse eid="MIC 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9" />ພວກທ່ານ​ທີ່​ເປັນ​ຜູ້ນຳ​ຂອງ​ຢາໂຄບ ຈົ່ງ​ຟັງ,</para>
  <para style="q2" vid="MIC 3:9">ພວກທ່ານ​ຜູ້​ທີ່​ປົກຄອງ​ອິດສະຣາເອນ,</para>
  <para style="q1" vid="MIC 3:9">ຜູ້​ຊັງ​ຄວາມ​ຍຸຕິທຳ</para>
  <para style="q2" vid="MIC 3:9">ແລະ ບິດ​ເບືອນ​ຄວາມ​ຖືກຕ້ອງ​ທຸກ​ຢ່າງ;<verse eid="MIC 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10" />ຜູ້​ສ້າງ​ຊີໂອນ​ຂຶ້ນ​ຈາກ​ການ​ຂ້າ​ຄົນ,</para>
  <para style="q2" vid="MIC 3:10">ສ້າງ​ເຢຣູຊາເລັມ​ຂຶ້ນ​ຈາກ​ຄວາມ​ຊົ່ວ​ຮ້າຍ.<verse eid="MIC 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11" />ບັນດາ​ຜູ້ນຳ​ຂອງ​ດິນແດນ​ນີ້​ຕັດສິນ​ຄວາມ​ໂດຍ​ເຫັນ​ແກ່​ສິນບົນ,</para>
  <para style="q2" vid="MIC 3:11">ບັນດາ​ປະໂລຫິດ​ຂອງ​ດິນແດນ​ນີ້​ສັ່ງສອນ​ໂດຍ​ເຫັນ​ແກ່​ລາງວັນ,</para>
  <para style="q2" vid="MIC 3:11">ແລະ ບັນດາ​ຜູ້ທຳນວາຍ​ຂອງ​ດິນແດນ​ນີ້​ທຳນວາຍ​ເພື່ອ​ເງິນ.</para>
  <para style="q1" vid="MIC 3:11">ເຖິງ​ປານ​ນັ້ນ​ພວກເຂົາ​ກໍ​ຍັງ​ເພິ່ງ​ພາ​ພຣະເຈົ້າ​ຢາເວ ແລະ ກ່າວ​ວ່າ,</para>
  <para style="q2" vid="MIC 3:11">“ພຣະເຈົ້າ​ຢາເວ​ຢູ່​ທ່າມກາງ​ພວກເຮົາ​ບໍ່​ແມ່ນ​ບໍ?</para>
  <para style="q2" vid="MIC 3:11">ຈະ​ບໍ່​ມີ​ໄພພິບັດ​ໃດ​ມາ​ເຖິງ​ພວກເຮົາ​ເລີຍ”.<verse eid="MIC 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12" />ເຫດສະນັ້ນ ເພາະ​ພວກເຈົ້າ</para>
  <para style="q2" vid="MIC 3:12">ຊີໂອນ​ຈະ​ຖືກ​ໄຖ​ເໝືອນ​ກັບ​ທົ່ງນາ,</para>
  <para style="q1" vid="MIC 3:12">ເຢຣູຊາເລັມ​ຈະ​ກາຍເປັນ​ກອງ​ຂີ້ເຫຍື້ອ,</para>
  <para style="q2" vid="MIC 3:12">ພູເຂົາ​ທີ່​ເປັນ​ທີ່​ຕັ້ງ​ຂອງ​ວິຫານ​ຈະ​ກາຍເປັນ​ປ່າ​ຮົກ.<verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="s1">ພູເຂົາ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="r">(ອຊຢ 2:1-4)</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1" />ໃນ​ບັ້ນປາຍ</para>
  <para style="q1" vid="MIC 4:1">ພູເຂົາ​ທີ່​ວິຫານ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ຕັ້ງ​ຢູ່​ຈະ​ໄດ້​ຮັບ​ການ​ສະຖາປະນາ</para>
  <para style="q2" vid="MIC 4:1">ໃຫ້​ເປັນ​ເອກ​ໃນ​ທ່າມກາງ​ພູເຂົາ​ທັງຫລາຍ;</para>
  <para style="q1" vid="MIC 4:1">ວິຫານ​ຈະ​ໄດ້​ຮັບ​ການ​ຍົກ​ຂຶ້ນ​ເໜືອ​ບັນດາ​ເນີນພູ​ທັງຫລາຍ,</para>
  <para style="q2" vid="MIC 4:1">ແລະ ຄົນ​ທັງຫລາຍ​ຈະ​ຫລັ່ງໄຫລ​ໄປ​ບ່ອນ​ນັ້ນ.<verse eid="MIC 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 4:2" />ປະຊາຊາດ​ທັງຫລາຍ​ຈະ​ມາ ແລະ ກ່າວ​ວ່າ,</para>
  <para style="q1" vid="MIC 4:2">“ຈົ່ງ​ມາ, ໃຫ້​ພວກເຮົາ​ຂຶ້ນ​ໄປ​ເທິງ​ພູເຂົາ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ,</para>
  <para style="q2" vid="MIC 4:2">ໄປ​ທີ່​ວິຫານ​ຂອງ​ພຣະເຈົ້າ​ຂອງ​ຢາໂຄບ.</para>
  <para style="q1" vid="MIC 4:2">ພຣະອົງ​ຈະ​ສອນ​ວິຖີທາງ​ຂອງ​ພຣະອົງ​ໃຫ້​ພວກເຮົາ,</para>
  <para style="q2" vid="MIC 4:2">ເພື່ອ​ພວກເຮົາ​ຈະ​ເດີນ​ໃນ​ວິຖີທາງ​ຂອງ​ພຣະອົງ”.</para>
  <para style="q1" vid="MIC 4:2">ກົດບັນຍັດ​ຈະ​ອອກ​ມາ​ຈາກ​ຊີໂອນ,</para>
  <para style="q2" vid="MIC 4:2">ຖ້ອຍຄຳ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ຈະ​ອອກ​ມາ​ຈາກ​ເຢຣູຊາເລັມ.<verse eid="MIC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3" />ພຣະອົງ​ຈະ​ຕັດສິນ​ຄວາມ​ລະຫວ່າງ​ຊົນຊາດ​ທັງຫລາຍ</para>
  <para style="q2" vid="MIC 4:3">ແລະ ຈະ​ຢຸດຕິ​ກໍລະນີ​ຜິດພາດ​ໃຫ້​ຊາດ​ມະຫາ​ອຳນາດ​ທັງຫລາຍ​ທີ່​ຢູ່​ໄກ ແລະ ຢູ່​ໃກ້.</para>
  <para style="q1" vid="MIC 4:3">ພວກເຂົາ​ຈະ​ຕີ​ດາບ​ຂອງ​ພວກເຂົາ​ໃຫ້​ເປັນ​ໝາກກະສົບໄຖ</para>
  <para style="q2" vid="MIC 4:3">ແລະ ຕີ​ຫອກ​ຂອງ​ພວກເຂົາ​ໃຫ້​ເປັນ​ມີດຕັດ​ກິ່ງໄມ້.</para>
  <para style="q1" vid="MIC 4:3">ຊົນຊາດ​ທັງຫລາຍ​ຈະ​ເຊົາ​ສູ້ຮົບ​ກັນ,</para>
  <para style="q2" vid="MIC 4:3">ພວກເຂົາ​ຈະ​ບໍ່​ມີ​ການ​ຝຶກ​ສູ້ຮົບ​ອີກ​ຕໍ່​ໄປ,<verse eid="MIC 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4" />ທຸກຄົນ​ຈະ​ນັ່ງ​ຢູ່​ກ້ອງ​ເຄືອອະງຸ່ນ​ຂອງ​ຕົນ​ເອງ</para>
  <para style="q2" vid="MIC 4:4">ແລະ ກ້ອງ​ຕົ້ນ​ໝາກເດື່ອ​ຂອງ​ຕົນ​ເອງ,</para>
  <para style="q1" vid="MIC 4:4">ແລະ ຈະ​ບໍ່​ມີ​ຜູ້ໃດ​ເຮັດ​ໃຫ້​ພວກເຂົາ​ຢ້ານ,</para>
  <para style="q2" vid="MIC 4:4">ເພາະ​ພຣະເຈົ້າ​ຢາເວ​ຜູ້​ມີ​ລິດອຳນາດ​ຍິ່ງໃຫຍ່​ໄດ້​ກ່າວ​ໄວ້​ແລ້ວ.<verse eid="MIC 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5" />ທຸກ​ຊົນຊາດ​ອາດ​ຈະ​ດຳເນີນ</para>
  <para style="q2" vid="MIC 4:5">ໃນ​ນາມ​ຂອງ​ພະ​ຂອງ​ຕົນ,</para>
  <para style="q1" vid="MIC 4:5">ສ່ວນ​ພວກເຮົາ​ຈະ​ດຳເນີນ​ໃນ​ນາມ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q2" vid="MIC 4:5">ພຣະເຈົ້າ​ຂອງ​ພວກເຮົາ​ຕະຫລອດ​ໄປ​ເປັນ​ນິດ.<verse eid="MIC 4:5" /></para>
  <para style="s1">ແຜນການ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6" />ພຣະເຈົ້າ​ຢາເວ​ປະກາດ​ວ່າ,</para>
  <para style="q2" vid="MIC 4:6">“ໃນ​ວັນ​ນັ້ນ, ເຮົາ​ຈະ​ເຕົ້າໂຮມ​ຄົນ​ຂາ​ພິການ;</para>
  <para style="q1" vid="MIC 4:6">ເຮົາ​ຈະ​ຮວບຮວມ​ບັນດາ​ຊະເລີຍ</para>
  <para style="q2" vid="MIC 4:6">ແລະ ບັນດາ​ຄົນ​ທີ່​ເຮົາ​ໃຫ້​ພົບ​ກັບ​ຄວາມ​ໂສກເສົ້າ.<verse eid="MIC 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7" />ເຮົາ​ຈະ​ໃຫ້​ຄົນ​ຂາ​ພິການ​ເປັນ​ຄົນ​ທີ່​ເຫລືອ​ຢູ່​ຂອງ​ເຮົາ,</para>
  <para style="q2" vid="MIC 4:7">ໃຫ້​ບັນດາ​ຄົນ​ທີ່​ຖືກ​ເນລະເທດ​ເປັນ​ຊາດ​ທີ່​ແຂງແຮງ.</para>
  <para style="q1" vid="MIC 4:7">ພຣະເຈົ້າ​ຢາເວ​ຈະ​ປົກຄອງ​ພວກເຂົາ​ຢູ່​ໃນ​ພູເຂົາ​ຊີໂອນ</para>
  <para style="q2" vid="MIC 4:7">ຕັ້ງແຕ່​ວັນ​ນັ້ນ ແລະ ຕະຫລອດ​ໄປ.<verse eid="MIC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8" />ສ່ວນ​ເຈົ້າ, ຜູ້​ເປັນ​ຫໍຄອຍ​ເຝົ້າຍາມ​ຂອງ​ຝູງແກະ,</para>
  <para style="q2" vid="MIC 4:8">ເປັນ​ທີ່​ໝັ້ນ<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">ຫລື ໂນນພູ</char></note>​ຂອງ​ລູກສາວ​ແຫ່ງ​ຊີໂອນ,<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">ຄື ຊາວ​ເຢຣູຊາເລັມ ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="MIC 4:10"><ref loc="MIC 4:10">10</ref></char> ແລະ <char style="xt" link-href="MIC 4:13"><ref loc="MIC 4:13">13</ref></char></char></note></para>
  <para style="q1" vid="MIC 4:8">ອຳນາດ​ເດີມ​ຈະ​ກັບ​ຄືນ​ມາ​ເປັນ​ຂອງ​ເຈົ້າ;</para>
  <para style="q2" vid="MIC 4:8">ລູກ​ສາວ​ແຫ່ງ​ເຢຣູຊາເລັມ<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">ຄື ຊາວ​ເຢຣູຊາເລັມ</char></note>​ຈະ​ໄດ້​ຮັບ​ອຳນາດ​ຄອບຄອງ”.<verse eid="MIC 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9" />ດ້ວຍ​ເຫດ​ໃດ​ເຈົ້າ​ຈຶ່ງ​ຮ້ອງ​ສຽງ​ດັງ</para>
  <para style="q2" vid="MIC 4:9">ເຈົ້າ​ບໍ່​ມີ​ກະສັດ​ບໍ?</para>
  <para style="q1" vid="MIC 4:9">ທີ່​ປຶກສາ​ຂອງ​ເຈົ້າ​ພິນາດ​ໄປ​ແລ້ວ​ບໍ?</para>
  <para style="q2" vid="MIC 4:9">ເຈົ້າ​ຈຶ່ງ​ເຈັບ​ປວດ​ເໝືອນ​ແມ່ຍິງ​ກຳລັງ​ເກີດ​ລູກ.<verse eid="MIC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10" />ລູກສາວ​ແຫ່ງ​ຊີໂອນ, ຈົ່ງ​ດີ້ນ​ດ້ວຍ​ຄວາມ​ເຈັບ​ປວດ,</para>
  <para style="q2" vid="MIC 4:10">ເໝືອນ​ແມ່ຍິງ​ທີ່​ກຳລັງ​ເກີດ​ລູກ,</para>
  <para style="q1" vid="MIC 4:10">ເພາະ​ບັດນີ້​ເຈົ້າ​ຈະ​ຕ້ອງ​ຈາກ​ເມືອງ</para>
  <para style="q2" vid="MIC 4:10">ໄປ​ຕັ້ງ​ຄ້າຍພັກ​ຢູ່​ກາງ​ທົ່ງນາ.</para>
  <para style="q1" vid="MIC 4:10">ເຈົ້າ​ຈະ​ໄປ​ທີ່​ບາບີໂລນ;</para>
  <para style="q2" vid="MIC 4:10">ເຈົ້າ​ຈະ​ໄດ້​ຮັບ​ການ​ຊ່ວຍເຫລືອ​ຢູ່​ບ່ອນ​ນັ້ນ.</para>
  <para style="q1" vid="MIC 4:10">ພຣະເຈົ້າ​ຢາເວ​ຈະ​ໄຖ່​ເຈົ້າ</para>
  <para style="q2" vid="MIC 4:10">ອອກ​ຈາກ​ມື​ຂອງ​ສັດຕູ​ທັງຫລາຍ​ຂອງ​ເຈົ້າ​ຢູ່​ບ່ອນ​ນັ້ນ.<verse eid="MIC 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11" />ແຕ່​ບັດນີ້​ຫລາຍ​ຊົນຊາດ</para>
  <para style="q2" vid="MIC 4:11">ໄດ້​ຮວມ​ໂຕ​ກັນ​ມາ​ສູ້ຮົບ​ກັບ​ເຈົ້າ.</para>
  <para style="q1" vid="MIC 4:11">ພວກເຂົາ​ກ່າວ​ວ່າ, “ໃຫ້​ຊີໂອນ​ເປັນ​ມົນທິນ,</para>
  <para style="q2" vid="MIC 4:11">ໃຫ້​ຕາ​ຂອງ​ພວກເຮົາ​ໄດ້​ເບິ່ງ​ຊີໂອນ​ດ້ວຍ​ຄວາມ​ສະໃຈ!”<verse eid="MIC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12" />ແຕ່​ພວກເຂົາ​ບໍ່​ຮູ້</para>
  <para style="q2" vid="MIC 4:12">ຄວາມຄິດ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ;</para>
  <para style="q1" vid="MIC 4:12">ພວກເຂົາ​ບໍ່​ເຂົ້າໃຈ​ແຜນການ​ຂອງ​ພຣະອົງ,</para>
  <para style="q2" vid="MIC 4:12">ທີ່​ພຣະອົງ​ໄດ້​ຮວບຮວມ​ພວກເຂົາ​ເໝືອນ​ຮວບຮວມ​ຟ່ອນ​ເຂົ້າ​ມາ​ສູ່​ລານ​ຟາດ​ເຂົ້າ.<verse eid="MIC 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13" />“ລູກສາວ​ແຫ່ງ​ຊີໂອນ, ຈົ່ງ​ລຸກ​ຂຶ້ນ​ຟາດ​ເຂົ້າ,</para>
  <para style="q2" vid="MIC 4:13">ເພາະ​ເຮົາ​ຈະ​ໃຫ້​ເຈົ້າ​ມີ​ເຂົາ​ເປັນ​ເຫລັກ;</para>
  <para style="q1" vid="MIC 4:13">ເຮົາ​ຈະ​ໃຫ້​ເຈົ້າ​ມີ​ກີບຕີນ​ເປັນ​ທອງສຳລິດ,</para>
  <para style="q2" vid="MIC 4:13">ແລະ ເຈົ້າ​ຈະ​ບົດ​ຫລາຍ​ຊາດ​ໃຫ້​ມຸ່ນ​ໄປ”.</para>
  <para style="q1" vid="MIC 4:13">ພວກທ່ານ​ຈະ​ຖວາຍ​ສິ່ງ​ທີ່​ພວກເຂົາ​ໄດ້​ມາ​ໂດຍ​ບໍ່​ຊອບທຳ​ນັ້ນ​ແກ່​ພຣະເຈົ້າ​ຢາເວ,</para>
  <para style="q2" vid="MIC 4:13">ຖວາຍ​ຄວາມ​ຮັ່ງມີ​ຂອງ​ພວກເຂົາ​ແກ່​ອົງພຣະຜູ້ເປັນເຈົ້າ​ແຫ່ງ​ໂລກ​ນີ້​ທັງໝົດ.<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="s1">ຜູ້​ປົກຄອງ​ຕາມ​ພຣະສັນຍາ​ຈະ​ມາ​ຈາກ​ເບັດເລເຮັມ</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 5:1" />ນະຄອນ​ແຫ່ງ​ກອງ​ທະຫານ, ຈົ່ງ​ຈັດ​ທັບ,<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">ຫລື ນະຄອນ​ແຫ່ງ​ປ້ອມ​ປ້ອງກັນ ຈົ່ງ​ເສີມ​ກຳແພງ​ຂອງ​ເຈົ້າ</char></note></para>
  <para style="q2" vid="MIC 5:1">ເພາະ​ສັດຕູ​ມາ​ລ້ອມ​ເມືອງ​ຂອງ​ພວກເຮົາ​ແລ້ວ.</para>
  <para style="q1" vid="MIC 5:1">ພວກເຂົາ​ຈະ​ເອົາ​ໄມ້ແສ້​ຟາດ​ແກ້ມ</para>
  <para style="q2" vid="MIC 5:1">ຂອງ​ຜູ້​ປົກຄອງ​ຂອງ​ອິດສະຣາເອນ.<verse eid="MIC 5:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2" />“ສ່ວນ​ເຈົ້າ, ເບັດເລເຮັມ ເອຟຣາທາ,</para>
  <para style="q2" vid="MIC 5:2">ເຖິງ​ແມ່ນ​ເຈົ້າ​ຈະ​ເປັນ​ຜູ້​ເລັກ​ນ້ອຍ​ໃນ​ທ່າມກາງ​ຕະກຸນ​ຕ່າງໆ<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">ຫລື ຜູ້​ປົກຄອງ</char></note>​ຂອງ​ຢູດາຍ,</para>
  <para style="q1" vid="MIC 5:2">ແຕ່​ຈະ​ມີ​ຜູ້​ໜຶ່ງ​ອອກ​ມາ​ຈາກ​ເຈົ້າ​ເພື່ອ​ເຮົາ</para>
  <para style="q2" vid="MIC 5:2">ເປັນ​ຜູ້​ທີ່​ຈະ​ຄອບຄອງ​ອິດສະຣາເອນ,</para>
  <para style="q1" vid="MIC 5:2">ຜູ້​ນັ້ນ​ມີ​ທີ່​ມາ<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ຜູ້​ນັ້ນ​ອອກ​ໄປ​ຈາກ</char></note> ທີ່​ມາ​ຈາກ​ສະໄໝ​ກ່ອນ</para>
  <para style="q2" vid="MIC 5:2">ຈາກ​ສະໄໝ​ບູຮານ”.<verse eid="MIC 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3" />ເຫດສະນັ້ນ ອິດສະຣາເອນ​ຈະ​ຖືກ​ປະຖິ້ມ</para>
  <para style="q2" vid="MIC 5:3">ຈົນ​ກວ່າ​ເມື່ອ​ເຖິງ​ເວລາ​ທີ່​ແມ່ຍິງ​ທີ່​ກຳລັງ​ເຈັບ​ມົດລູກ​ນັ້ນ​ເກີດ​ລູກຊາຍ​ແລ້ວ,</para>
  <para style="q1" vid="MIC 5:3">ແລະ ພີ່ນ້ອງ​ອື່ນໆ​ຂອງ​ຜູ້​ນັ້ນ</para>
  <para style="q2" vid="MIC 5:3">ກັບ​ມາ​ສົມທົບ​ກັນ​ກັບ​ຊົນຊາດ​ອິດສະຣາເອນ.<verse eid="MIC 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4" />ເພິ່ນ​ຈະ​ຢຶດໝັ້ນ ແລະ ລ້ຽງດູ​ຝູງແກະ​ຂອງ​ເພິ່ນ</para>
  <para style="q2" vid="MIC 5:4">ໂດຍ​ກຳລັງ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q2" vid="MIC 5:4">ໂດຍ​ບາລະມີ​ແຫ່ງ​ນາມ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ​ຂອງ​ເພິ່ນ.</para>
  <para style="q1" vid="MIC 5:4">ແລະ ພວກເຂົາ​ຈະ​ມີ​ຊີວິດ​ຢູ່​ຢ່າງ​ໝັ້ນຄົງ​ປອດໄພ</para>
  <para style="q2" vid="MIC 5:4">ເພາະ​ຄວາມ​ຍິ່ງໃຫຍ່​ຂອງ​ເພິ່ນ​ຈະ​ແຜ່​ເຖິງ​ສຸດປາຍ​ແຜ່ນດິນ​ໂລກ.<verse eid="MIC 5:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5" />ແລະ ເພິ່ນ​ຈະ​ນຳ​ສັນຕິສຸກ​ມາ​ໃຫ້​ພວກເຮົາ</para>
  <para style="q2" vid="MIC 5:5">ເມື່ອ​ຄັ້ງ​ທີ່​ອັດຊີເຣຍ​ຮຸກຮານ​ດິນແດນ​ຂອງ​ພວກເຮົາ</para>
  <para style="q2" vid="MIC 5:5">ແລະ ເດີນ​ທັບ​ຜ່ານ​ປ້ອມ​ປ້ອງກັນ​ຂອງ​ພວກເຮົາ.</para>
  <para style="q1" vid="MIC 5:5">ເຮົາ​ຈະ​ຕັ້ງ​ຄົນລ້ຽງແກະ​ເຈັດ​ຄົນ,</para>
  <para style="q2" vid="MIC 5:5">ຜູ້ບັນຊາການ​ແປດ​ຄົນ​ດ້ວຍ,<verse eid="MIC 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6" />ພວກເຂົາ​ຈະ​ປົກຄອງ<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">ຫລື ຍ່ອງ</char></note>​ດິນແດນ​ອັດຊີເຣຍ​ດ້ວຍ​ດາບ,</para>
  <para style="q2" vid="MIC 5:6">ປົກຄອງ​ດິນແດນ​ຂອງ​ນິມໂຣດ​ດ້ວຍ​ດາບ​ທີ່​ຊັກ​ອອກ.<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">ຫລື ນິມໂຣດ​ໃນ​ປະຕູ​ເມືອງ​ຂອງ​ມັນ</char></note></para>
  <para style="q1" vid="MIC 5:6">ຜູ້​ນັ້ນ​ຈະ​ກອບກູ້​ພວກເຮົາ​ອອກ​ຈາກ​ອັດຊີເຣຍ</para>
  <para style="q2" vid="MIC 5:6">ເມື່ອ​ພວກເຂົາ​ມາ​ຮຸກຮານ​ດິນແດນ​ຂອງ​ພວກເຮົາ</para>
  <para style="q2" vid="MIC 5:6">ແລະ ເດີນ​ທັບ​ເຂົ້າ​ມາ​ໃນ​ເຂດແດນ​ຂອງ​ພວກເຮົາ.<verse eid="MIC 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7" />ຄົນ​ທີ່​ເຫລືອ​ຂອງ​ຢາໂຄບ</para>
  <para style="q2" vid="MIC 5:7">ຈະ​ຢູ່​ທ່າມກາງ​ຊົນຊາດ​ທັງຫລາຍ</para>
  <para style="q1" vid="MIC 5:7">ເໝືອນ​ນ້ຳຄ້າງ​ຈາກ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q2" vid="MIC 5:7">ເໝືອນ​ສາຍ​ຝົນ​ທີ່​ໂຮຍ​ລົງ​ເທິງ​ຫຍ້າ,</para>
  <para style="q1" vid="MIC 5:7">ເຊິ່ງ​ບໍ່​ຕ້ອງ​ລໍຖ້າ​ຜູ້ໃດ</para>
  <para style="q2" vid="MIC 5:7">ຫລື ເພິ່ງພາ​ມະນຸດ.<verse eid="MIC 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8" />ຄົນ​ທີ່​ເຫລືອ​ຂອງ​ຢາໂຄບ​ຈະ​ຢູ່​ໃນ​ທ່າມກາງ​ປະຊາຊາດ​ທັງຫລາຍ,</para>
  <para style="q2" vid="MIC 5:8">ຢູ່​ທ່າມກາງ​ຊົນຊາດ​ຕ່າງໆ</para>
  <para style="q1" vid="MIC 5:8">ເໝືອນ​ດັ່ງ​ໂຕສິງ​ທີ່​ຢູ່​ໃນ​ທ່າມກາງ​ສັດປ່າ,</para>
  <para style="q2" vid="MIC 5:8">ເໝືອນ​ສິງ​ໜຸ່ມ​ທີ່​ຢູ່​ໃນ​ທ່າມກາງ​ຝູງ​ແກະ,</para>
  <para style="q1" vid="MIC 5:8">ເຊິ່ງ​ຢຽບຢ່ຳ ແລະ ທຳລາຍ​ຂະນະ​ທີ່​ຍ່າງ​ໄປ,</para>
  <para style="q2" vid="MIC 5:8">ໂດຍ​ບໍ່​ມີ​ຜູ້ໃດ​ຊ່ວຍ​ໄດ້.<verse eid="MIC 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9" />ເຈົ້າ​ຈະ​ຍົກ​ມື​ຂຶ້ນ​ດ້ວຍ​ໄຊຊະນະ​ເໜືອ​ສັດຕູ​ທັງຫລາຍ​ຂອງ​ພວກເຈົ້າ,</para>
  <para style="q2" vid="MIC 5:9">ແລະ ສັດຕູ​ທັງໝົດ​ຂອງ​ພວກເຈົ້າ​ຈະ​ຖືກ​ທຳລາຍ.<verse eid="MIC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10" />ພຣະເຈົ້າ​ຢາເວ​ປະກາດ​ວ່າ,</para>
  <para style="q1" vid="MIC 5:10">“ໃນ​ວັນ​ນັ້ນ ເຮົາ​ຈະ​ທຳລາຍ​ມ້າ​ທັງຫລາຍ​ຂອງ​ພວກເຈົ້າ​ໃຫ້​ໝົດ​ໄປ​ຈາກ​ພວກເຈົ້າ</para>
  <para style="q2" vid="MIC 5:10">ແລະ ທຳລາຍ​ບັນດາ​ລົດມ້າ​ຂອງ​ພວກເຈົ້າ.<verse eid="MIC 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11" />ເຮົາ​ຈະ​ທຳລາຍ​ເມືອງ​ຕ່າງໆ​ໃນ​ດິນແດນ​ຂອງ​ພວກເຈົ້າ</para>
  <para style="q2" vid="MIC 5:11">ແລະ ທຳລາຍ​ທີ່​ໝັ້ນ​ທັງໝົດ​ຂອງ​ພວກເຈົ້າ.<verse eid="MIC 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12" />ເຮົາ​ຈະ​ທຳລາຍ​ພວກ​ແມ່ມົດ​ຂອງ​ພວກເຈົ້າ</para>
  <para style="q2" vid="MIC 5:12">ແລະ ພວກເຈົ້າ​ຈະ​ບໍ່​ໃຊ້​ເວດມົນ​ຄາຖາ​ອີກ​ຕໍ່​ໄປ.<verse eid="MIC 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13" />ເຮົາ​ຈະ​ທຳລາຍ​ຮູບເຄົາລົບ​ທັງຫລາຍ​ຂອງ​ພວກເຈົ້າ;</para>
  <para style="q2" vid="MIC 5:13">ແລະ ຫີນ​ສັກສິດ​ທ່າມກາງ​ພວກເຈົ້າ​ໃຫ້​ໝົດ​ໄປ;</para>
  <para style="q1" vid="MIC 5:13">ພວກເຈົ້າ​ຈະ​ບໍ່​ກົ້ມ​ກາບ</para>
  <para style="q2" vid="MIC 5:13">ສິ່ງ​ທີ່​ມື​ຂອງ​ພວກເຈົ້າ​ເຮັດ​ຂຶ້ນ​ມາ​ອີກ​ຕໍ່​ໄປ.<verse eid="MIC 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14" />ເຮົາ​ຈະ​ຮື້​ຖອນ​ເສົາ​ເຈົ້າ​ແມ່​ອາເຊຣາ​ທີ່​ຢູ່​ທ່າມກາງ​ພວກເຈົ້າ​ອອກ​ໄປ</para>
  <para style="q2" vid="MIC 5:14">ແລະ ທຳລາຍ​ເມືອງ​ຕ່າງໆ​ຂອງ​ພວກເຈົ້າ.<verse eid="MIC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15" />ເຮົາ​ຈະ​ແກ້ແຄ້ນ​ດ້ວຍ​ຄວາມ​ໃຈຮ້າຍ ແລະ ຄວາມ​ໂກດຮ້າຍ​ຂອງ​ເຮົາ</para>
  <para style="q2" vid="MIC 5:15">ແກ່​ຊົນ​ຊາດ​ຕ່າງໆ​ທີ່​ບໍ່​ເຊື່ອຟັງ​ເຮົາ”.<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="s1">ພຣະເຈົ້າ​ຢາເວ​ສູ້​ຄວາມ​ອິດສະຣາເອນ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1" />ຈົ່ງ​ຟັງ​ສິ່ງ​ທີ່​ພຣະເຈົ້າ​ຢາເວ​ດັ່ງນີ້:</para>
  <para style="q1" vid="MIC 6:1">“ຈົ່ງ​ລຸກ​ຢືນ​ຂຶ້ນ, ສະເໜີ​ຄະດີ​ຄວາມ​ຂອງ​ເຈົ້າ​ຕໍ່ໜ້າ​ພູເຂົາ​ທັງຫລາຍ</para>
  <para style="q2" vid="MIC 6:1">ແລະ ໃຫ້​ບັນດາ​ໂນນພູ​ທັງຫລາຍ​ຟັງ​ສິ່ງ​ທີ່​ເຈົ້າ​ເວົ້າ,<verse eid="MIC 6:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2" />“ພູເຂົາ​ທັງຫລາຍ, ຈົ່ງ​ຟັງ​ການ​ກ່າວ​ໂທດ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ;</para>
  <para style="q2" vid="MIC 6:2">ຈົ່ງ​ຟັງ, ເຈົ້າ​ຜູ້​ເປັນ​ຮາກຖານ​ອັນ​ໝັ້ນຄົງ​ຂອງ​ໂລກ.</para>
  <para style="q1" vid="MIC 6:2">ເພາະ​ພຣະເຈົ້າ​ຢາເວ​ມີ​ຄະດີ​ຄວາມ​ກັບ​ປະຊາຊົນ​ຂອງ​ພຣະອົງ;</para>
  <para style="q2" vid="MIC 6:2">ພຣະອົງ​ຕັ້ງ​ຂໍ້​ກ່າວຫາ​ອິດສະຣາເອນ.<verse eid="MIC 6:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3" />“ປະຊາຊົນ​ຂອງ​ເຮົາ ເຮົາ​ໄດ້​ເຮັດ​ຫຍັງ​ໃຫ້​ພວກເຈົ້າ?</para>
  <para style="q2" vid="MIC 6:3">ເຮົາ​ໄດ້​ໃສ່​ພາລະ​ອັນ​ໃດ​ໃຫ້​ແກ່​ພວກເຈົ້າ? ຈົ່ງ​ຕອບ​ເຮົາ​ມາ.<verse eid="MIC 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4" />ເຮົາ​ໄດ້​ນຳ​ພວກເຈົ້າ​ອອກ​ມາ​ຈາກ​ເອຢິບ</para>
  <para style="q2" vid="MIC 6:4">ແລະ ໄດ້​ໄຖ່​ພວກເຈົ້າ​ຈາກ​ດິນແດນ​ແຫ່ງ​ຂ້າທາດ.</para>
  <para style="q1" vid="MIC 6:4">ເຮົາ​ໄດ້​ສົ່ງ​ໂມເຊ​ມາ​ເພື່ອ​ນຳພາ​ພວກເຈົ້າ,</para>
  <para style="q2" vid="MIC 6:4">ພ້ອມ​ທັງ​ອາໂຣນ ແລະ ມີຣີອາມ.<verse eid="MIC 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5" />ປະຊາຊົນ​ຂອງ​ເຮົາ, ຈົ່ງ​ລະນຶກ​ເຖິງ</para>
  <para style="q2" vid="MIC 6:5">ກະສັດ​ບາຫລາກ​ແຫ່ງ​ໂມອາບ ທີ່​ພະຍາຍາມ​ຈະ​ເຮັດ​ໃຫ້​ພວກເຈົ້າ​ຖືກ​ສາບແຊ່ງ.</para>
  <para style="q2" vid="MIC 6:5">ແຕ່​ບາລາອາມ ລູກຊາຍ​ຂອງ​ເບອໍ​ກໍ​ໄດ້​ຕອບ​ເພິ່ນ.</para>
  <para style="q1" vid="MIC 6:5">ຈົ່ງ​ລະນຶກ​ເຖິງ​ການ​ເດີນທາງ​ຂອງ​ພວກເຈົ້າ​ຈາກ​ຊິດຕິມ​ໄປ​ຫາ​ກິນການ,</para>
  <para style="q2" vid="MIC 6:5">ເພື່ອ​ພວກເຈົ້າ​ຈະ​ໄດ້​ຮູ້​ເຖິງ​ຄວາມ​ສັດຊື່​ຂອງ​ພຣະເຈົ້າ​ຢາເວ”.<verse eid="MIC 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6" />ຂ້າພະເຈົ້າ​ຈະ​ນຳ​ສິ່ງໃດ​ມາ​ຕໍ່ໜ້າ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q2" vid="MIC 6:6">ແລະ ກາບ​ລົງ​ຕໍ່​ພຣະເຈົ້າ​ຜູ້​ສູງ​ສຸດ?</para>
  <para style="q1" vid="MIC 6:6">ຂ້າພະເຈົ້າ​ຈະ​ຕ້ອງ​ເຂົ້າ​ພົບ​ພຣະອົງ​ດ້ວຍ​ເຄື່ອງເຜົາ​ບູຊາ,</para>
  <para style="q2" vid="MIC 6:6">ດ້ວຍ​ລູກງົວ​ທັງຫລາຍ​ທີ່​ມີ​ອາຍຸ​ໜຶ່ງ​ປີ​ບໍ?<verse eid="MIC 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7" />ພຣະເຈົ້າ​ຢາເວ​ຈະ​ພໍໃຈ​ແກະ​ເປັນ​ພັນໆ​ໂຕ,</para>
  <para style="q2" vid="MIC 6:7">ແລະ ສາຍ​ນ້ຳມັນ​ເປັນ​ໝື່ນໆ​ສາຍ​ບໍ?</para>
  <para style="q1" vid="MIC 6:7">ຂ້າພະເຈົ້າ​ຈະ​ຕ້ອງ​ຖວາຍ​ລູກ​ຫົວ​ປີ​ເພື່ອ​ການ​ລ່ວງລະເມີດ​ຂອງ​ຂ້າພະເຈົ້າ,</para>
  <para style="q2" vid="MIC 6:7">ຖວາຍ​ເຊື້ອສາຍ​ຂອງ​ຂ້າພຣະເຈົ້າ​ເພື່ອ​ບາບ​ແຫ່ງ​ຈິດວິນຍານ​ຂອງ​ຂ້າພະເຈົ້າ​ບໍ?<verse eid="MIC 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8" />ໂອ ມະນຸດ, ພຣະອົງ​ໄດ້​ສະແດງ​ແກ່​ພວກເຈົ້າ​ແລ້ວ​ວ່າ​ອັນໃດ​ດີ.</para>
  <para style="q2" vid="MIC 6:8">ແລະ ສິ່ງ​ທີ່​ພຣະເຈົ້າ​ຢາເວ​ຕ້ອງການ​ຈາກ​ພວກເຈົ້າ​ຄື​ອັນ​ໃດ?</para>
  <para style="q1" vid="MIC 6:8">ຄື​ຈົ່ງ​ປະພຶດ​ຢ່າງ​ທ່ຽງທຳ ແລະ ຮັກ​ຄວາມ​ເມດຕາ​ກະລຸນາ</para>
  <para style="q2" vid="MIC 6:8">ແລະ ດຳເນີນ​ຊີວິດ​ຢ່າງ​ຖ່ອມໃຈ<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">ຫລື ດ້ວຍ​ຄວາມ​ລະມັດລະວັງ</char></note>​ໄປ​ກັບ​ພຣະເຈົ້າ​ຂອງ​ພວກເຈົ້າ.<verse eid="MIC 6:8" /></para>
  <para style="s1">ຄວາມ​ຜິດ ແລະ ການ​ລົງໂທດ​ຂອງ​ອິດສະຣາເອນ</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9" />ຈົ່ງ​ຟັງ! ພຣະເຈົ້າ​ຢາເວ​ກຳລັງ​ເອີ້ນ​ເຢຣູຊາເລັມ</para>
  <para style="q2" vid="MIC 6:9">ເປັນ​ການ​ສະຫລາດ​ທີ່​ຈະ​ການ​ຢຳເກງ​ນາມ​ພຣະອົງ</para>
  <para style="q2" vid="MIC 6:9">“ຈົ່ງ​ຟັງ ເຜົ່າ​ທີ່​ຊຸມນຸມ​ກັນ​ຢູ່​ໃນ​ນະຄອນ​ນັ້ນ.<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">ໃນ​ພາສາ​ເຮັບເຣີ​ບັນ​ທັດ​ນີ້​ມີ​ຄວາມຫມາຍ​ບໍ່​ຊັດເຈນ</char></note><verse eid="MIC 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10" />ເຮືອນ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ, ຈະ​ໃຫ້​ເຮົາ​ລືມ​ຊັບສົມບັດ​ທີ່​ເຈົ້າ​ໄດ້​ມາ​ຢ່າງ​ບໍ່​ສັດຊື່,</para>
  <para style="q2" vid="MIC 6:10">ແລະ ລືມ​ເຄື່ອງຕວງ​ຄົດໂກງ<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ເອຟາ​ທີ່​ບໍ່​ໄດ້​ມາດຕະຖານ</char></note>​ທີ່​ຖືກ​ສາບແຊ່ງ​ບໍ?<verse eid="MIC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11" />ຈະ​ໃຫ້​ເຮົາ​ຍອມ​ປ່ອຍ​ຄົນ​ທີ່​ໃຊ້​ເຄື່ອງ​ຊັ່ງ​ທີ່​ບໍ່​ຖືກຕ້ອງ</para>
  <para style="q2" vid="MIC 6:11">ແລະ ມີ​ຕາຊິງ​ຄົດ​ໂກງ​ໄປ​ບໍ?<verse eid="MIC 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12" />ຄົນ​ຮັ່ງມີ​ຂອງ​ເຈົ້າ​ນັ້ນ​ໂຫດຮ້າຍ​ທາລຸນ</para>
  <para style="q2" vid="MIC 6:12">ແລະ ຄົນ​ຂອງ​ເຈົ້າ​ກໍ​ເປັນ​ຄົນ​ຂີ້ຕົວະ</para>
  <para style="q2" vid="MIC 6:12">ແລະ ລິ້ນ​ຂອງ​ພວກເຂົາ​ກໍ​ເວົ້າ​ແຕ່​ຄຳ​ຫລອກລວງ.<verse eid="MIC 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13" />ເຫດສະນັ້ນ ເຮົາ​ຈຶ່ງໄດ້​ເລີ່ມ​ທີ່​ຈະ​ທຳລາຍ​ເຈົ້າ;</para>
  <para style="q2" vid="MIC 6:13">ທຳລາຍ​ລ້າງ​ເຈົ້າ​ເພາະ​ບາບ​ທັງຫລາຍ​ຂອງ​ເຈົ້າ.<verse eid="MIC 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14" />ເຈົ້າ​ຈະ​ກິນ ແຕ່​ກໍ​ບໍ່​ອິ່ມ;</para>
  <para style="q2" vid="MIC 6:14">ທ້ອງ​ຂອງ​ເຈົ້າ​ກໍ​ຍັງ​ຫວ່າງເປົ່າ​ຢູ່.<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">ໃນ​ພາສາ​ເຮັບເຣີ​ຄຳ​ນີ້​ມີ​ຄວາມຫມາຍ​ບໍ່​ຊັດເຈນ</char></note></para>
  <para style="q1" vid="MIC 6:14">ເຈົ້າ​ຈະ​ສະສົມ​ໄວ້ ແຕ່​ກໍ​ບໍ່​ມີ​ຫຍັງ​ເຫລືອ.</para>
  <para style="q2" vid="MIC 6:14">ເພາະ​ເຮົາ​ຈະ​ມອບ​ສິ່ງ​ທີ່​ເຈົ້າ​ສະສົມ​ໄວ້​ນັ້ນ​ໃຫ້​ແກ່​ຄົມ​ດາບ.<verse eid="MIC 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15" />ເຈົ້າ​ຈະ​ປູກ ແຕ່​ບໍ່​ໄດ້​ເກັບກ່ຽວ;</para>
  <para style="q2" vid="MIC 6:15">ເຈົ້າ​ຈະ​ບີບ​ເອົາ​ນ້ຳມັນ​ໝາກກອກ ແຕ່​ກໍ​ບໍ່​ໄດ້​ໃຊ້​ເອງ,</para>
  <para style="q2" vid="MIC 6:15">ເຈົ້າ​ຈະ​ຍ່ອງ​ໝາກອະງຸ່ນ ແຕ່​ກໍ​ບໍ່​ໄດ້​ດື່ມ​ເຫລົ້າອະງຸ່ນ.<verse eid="MIC 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16" />ເຈົ້າ​ໄດ້​ຖື​ຮັກສາ​ກົດເກນ​ຂອງ​ອົມຣິ</para>
  <para style="q2" vid="MIC 6:16">ແລະ ພິທີກຳ​ທັງໝົດ​ຂອງ​ເຮືອນ​ຂອງ​ອາຮາບ</para>
  <para style="q2" vid="MIC 6:16">ແລ້ວ​ເຈົ້າ​ກໍ​ເອົາ​ແບບ​ຢ່າງ​ຂອງ​ພວກເພິ່ນ.</para>
  <para style="q1" vid="MIC 6:16">ເຫດສະນັ້ນ ເຮົາ​ຈະ​ປ່ອຍ​ໃຫ້​ເຈົ້າ​ພິນາດ</para>
  <para style="q2" vid="MIC 6:16">ປະຊາຊົນ​ຂອງ​ເຈົ້າ​ຈະ​ຖືກ​ເຢາະເຢີ້ຍ;</para>
  <para style="q2" vid="MIC 6:16">ເຈົ້າ​ຈະ​ເປັນ​ທີ່​ດູຖູກ​ຈາກ​ປະຊາຊາດ​ທັງຫລາຍ<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ເຈົ້າ​ຈະ​ເປັນ​ທີ່​ເຢາະເຢີ້ຍ​ຢ່າງ​ທີ່​ປະຊາຊົນ​ຂອງ​ເຮົາ​ຄວນ​ຈະ​ໄດ້​ຮັບ</char></note>”.<verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s1">ຄວາມ​ທຸກຍາກ​ຂອງ​ອິດສະຣາເອນ</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1" />ໝົດ​ຫວັງ​ແລ້ວ​ນໍ!</para>
  <para style="q1" vid="MIC 7:1">ຂ້າພະເຈົ້າ​ເປັນ​ເໝືອນ​ຄົນ​ໄປ​ເກັບ​ໝາກໄມ້​ໃນ​ລະດູ​ຮ້ອນ</para>
  <para style="q2" vid="MIC 7:1">ຫລັງຈາກ​ເພິ່ນ​ເກັບ​ໝາກອະງຸ່ນ​ໄປ​ໝົດ​ສວນ​ແລ້ວ</para>
  <para style="q1" vid="MIC 7:1">ບໍ່​ມີ​ພວງ​ໝາກອະງຸ່ນ​ໃຫ້​ຮັບ​ກິນ​ເລີຍ,</para>
  <para style="q2" vid="MIC 7:1">ບໍ່​ມີ​ທັງ​ໝາກເດື່ອ​ຕົ້ນ​ລະດູ​ທີ່​ຂ້າພະເຈົ້າ​ຢາກ​ກິນ.<verse eid="MIC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2" />ຄົນ​ຊອບທຳ​ນັ້ນ​ຖືກ​ກວາດ​ໄປ​ຈາກ​ແຜ່ນດິນ;</para>
  <para style="q2" vid="MIC 7:2">ບໍ່​ມີ​ຄົນ​ສັດຊື່​ເຫລືອ​ຢູ່​ແມ່ນ​ແຕ່​ຄົນ​ດຽວ.</para>
  <para style="q1" vid="MIC 7:2">ທຸກຄົນ​ດັກ​ລໍຖ້າ​ຂ້າ​ຄົນ;</para>
  <para style="q2" vid="MIC 7:2">ພວກເຂົາ​ຕ່າງ​ກໍ​ແກວ່ງ​ຕາໜ່າງ​ດັກ​ພີ່ນ້ອງ​ຂອງ​ຕົນ.<verse eid="MIC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3" />ມື​ທັງ​ສອງ​ເບື້ອງ​ກໍ​ຊຳນານ​ໃນ​ການ​ເຮັດ​ຊົ່ວ;</para>
  <para style="q2" vid="MIC 7:3">ຜູ້ປົກຄອງ​ຮຽກຮ້ອງ​ຂອງຂັວນ,</para>
  <para style="q1" vid="MIC 7:3">ຜູ້ຕັດສິນ​ຄະດີ​ກໍ​ຮັບ​ສິນບົນ,</para>
  <para style="q2" vid="MIC 7:3">ຜູ້​ມີ​ອິດທິພົນ​ກໍ​ສັ່ງ​ການ​ຕາມ​ໃຈ​ມັກ​ຂອງ​ພວກເຂົາ</para>
  <para style="q2" vid="MIC 7:3">ພວກເຂົາ​ທັງໝົດ​ຮ່ວມ​ຫົວ​ກັນ.<verse eid="MIC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4" />ແມ່ນ​ແຕ່​ຄົນ​ທີ່​ດີ​ທີ່ສຸດ​ໃນ​ທ່າມກາງ​ພວກເຂົາ​ກໍ​ເປັນ​ເໝືອນ​ຕົ້ນ​ໜາມ,</para>
  <para style="q2" vid="MIC 7:4">ຄົນ​ທີ່​ທ່ຽງທຳ​ທີ່ສຸດ​ກໍ​ຊົ່ວ​ຍິ່ງ​ກວ່າ​ຮົ້ວ​ໜາມ.</para>
  <para style="q1" vid="MIC 7:4">ມື້​ຂອງ​ຜູ້​ທີ່​ຈັບ​ຕາ​ເບິ່ງ​ເຈົ້າ​ນັ້ນ​ກໍ​ມາ​ເຖິງ​ແລ້ວ,</para>
  <para style="q2" vid="MIC 7:4">ເປັນ​ວັນ​ທີ່​ພຣະເຈົ້າ​ມາ​ຫາ​ພວກເຈົ້າ.</para>
  <para style="q2" vid="MIC 7:4">ບັດນີ້ ເຖິງ​ເວລາ​ແລ້ວ​ທີ່​ພວກເຂົາ​ຈະ​ສັບສົນ​ວຸ້ນວາຍ.<verse eid="MIC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5" />ຢ່າ​ວາງໃຈ​ເພື່ອນ​ບ້ານ;</para>
  <para style="q2" vid="MIC 7:5">ຢ່າ​ໝັ້ນໃຈ​ໃນ​ມິດ​ສະຫາຍ.</para>
  <para style="q1" vid="MIC 7:5">ແມ່ນ​ແຕ່​ຍິງ​ທີ່​ນອນ​ຢູ່​ໃນ​ອ້ອມ​ເອິກ​ຂອງ​ພວກເຈົ້າ</para>
  <para style="q2" vid="MIC 7:5">ຈົ່ງ​ລະວັງ​ຄຳ​ເວົ້າ​ຂອງ​ຮີມສົບ​ຂອງ​ພວກເຈົ້າ.<verse eid="MIC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6" />ເພາະ​ລູກຊາຍ​ຈະ​ດູຖູກ​ພໍ່​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="MIC 7:6">ລູກສາວ​ຈະ​ລຸກຂຶ້ນ​ຕໍ່ຕ້ານ​ແມ່​ຂອງ​ຕົນ,</para>
  <para style="q1" vid="MIC 7:6">ລູກໃພ້​ຂັດແຍ້ງ​ກັບ​ແມ່ຍ່າ</para>
  <para style="q2" vid="MIC 7:6">ສັດຕູ​ຂອງ​ລາວ​ຈະ​ເປັນ​ຄົນ​ທີ່​ຢູ່​ໃນ​ຄົວ​ເຮືອນ​ຂອງ​ລາວ​ເອງ.<verse eid="MIC 7:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7" />ແຕ່​ສ່ວນ​ຂ້າພຣະເຈົ້າ, ຂ້າພະເຈົ້າ​ຈະ​ມຸ່ງ​ຫວັງ​ໃນ​ພຣະເຈົ້າ​ຢາເວ,</para>
  <para style="q2" vid="MIC 7:7">ຂ້າພຣະເຈົ້າ​ລໍຖ້າ​ພຣະເຈົ້າ ພຣະຜູ້ຊ່ວຍ​ຂອງ​ຂ້າພຣະເຈົ້າ;</para>
  <para style="q2" vid="MIC 7:7">ພຣະເຈົ້າ​ຂອງ​ຂ້າພະເຈົ້າ​ຈະ​ຟັງ​ສຽງ​ຂອງ​ຂ້າພະເຈົ້າ.<verse eid="MIC 7:7" /></para>
  <para style="s1">ອິດສະຣາເອນ​ຈະ​ລຸກຂຶ້ນ​ມາ</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8" />ສັດຕູ​ຂອງ​ຂ້ອຍ, ຢ່າ​ຍິ້ມ​ເຢາະເຢີ້ຍ​ຂ້ອຍ​ເລີຍ!</para>
  <para style="q2" vid="MIC 7:8">ເຖິງ​ແມ່ນ​ວ່າ​ຂ້ອຍ​ໄດ້​ລົ້ມ​ລົງ, ຂ້ອຍ​ກໍ​ຈະ​ລຸກຂຶ້ນ​ມາ​ອີກ.</para>
  <para style="q1" vid="MIC 7:8">ເຖິງ​ແມ່ນ​ວ່າ​ຂ້ອຍ​ນັ່ງ​ຢູ່​ໃນ​ຄວາມ​ມືດ,</para>
  <para style="q2" vid="MIC 7:8">ພຣະເຈົ້າ​ຢາເວ​ກໍ​ຈະ​ເປັນຄວາມ​ສະຫວ່າງ​ຂອງ​ຂ້ອຍ.<verse eid="MIC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9" />ເພາະ​ຂ້າພະເຈົ້າ​ໄດ້​ເຮັດ​ບາບ​ຕໍ່​ພຣະອົງ,</para>
  <para style="q2" vid="MIC 7:9">ຂ້າພະເຈົ້າ​ກໍ​ຈະ​ທົນ​ຮັບ​ຄວາມ​ໂກດຮ້າຍ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ,</para>
  <para style="q1" vid="MIC 7:9">ຈົນ​ພຣະອົງ​ວ່າ​ຄະດີ​ຄວາມ​ໃຫ້​ຂ້າພະເຈົ້າ</para>
  <para style="q2" vid="MIC 7:9">ແລະ ປົກປ້ອງ​ສິດ​ຂອງ​ຂ້າພຣະເຈົ້າ​ໄວ້.</para>
  <para style="q1" vid="MIC 7:9">ພຣະອົງ​ຈະ​ນຳ​ຂ້ອຍ​ອອກ​ມາ​ສູ່​ຄວາມ​ສະຫວ່າງ;</para>
  <para style="q2" vid="MIC 7:9">ຂ້າພະເຈົ້າ​ຈະ​ເຫັນ​ຄວາມ​ຊອບທຳ​ຂອງ​ພຣະອົງ.<verse eid="MIC 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10" />ແລ້ວ​ສັດຕູ​ຂອງ​ຂ້າພະເຈົ້າ​ກໍ​ຈະ​ເຫັນ</para>
  <para style="q2" vid="MIC 7:10">ແລະ ຖືກ​ປົກຄຸມ​ດ້ວຍ​ຄວາມ​ອັບອາຍ,</para>
  <para style="q1" vid="MIC 7:10">ຜູ້​ທີ່​ໄດ້​ເວົ້າ​ກັບ​ຂ້າພະເຈົ້າ​ວ່າ,</para>
  <para style="q2" vid="MIC 7:10">“ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ​ຂອງ​ເຈົ້າ​ຢູ່​ໃສ?”</para>
  <para style="q1" vid="MIC 7:10">ຕາ​ຂອງ​ຂ້າພະເຈົ້າ​ກໍ​ຈະ​ເຫັນ​ລາວ​ລົ້ມ​ລົງ</para>
  <para style="q2" vid="MIC 7:10">ບັດນີ້​ແຫລະ ລາວ​ຈະ​ຖືກ​ຢຽບ​ຢ່ຳ​ຢູ່​ກ້ອງ​ຕີນ.</para>
  <para style="q2" vid="MIC 7:10">ເໝືອນ​ຂີ້ຕົມ​ຢູ່​ເທິງ​ຖະໜົນ.<verse eid="MIC 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11" />ມື້​ສ້າງ​ກຳແພງ​ໃຫ້​ເຈົ້າ​ນັ້ນ​ຈະ​ມາ​ເຖິງ,</para>
  <para style="q2" vid="MIC 7:11">ເປັນ​ວັນ​ທີ່​ຈະ​ຂະຫຍາຍ​ເຂດແດນ​ຂອງ​ເຈົ້າ​ອອກ​ໄປ.<verse eid="MIC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12" />ໃນ​ມື້​ນັ້ນ ຄົນ​ທັງຫລາຍ​ຈະ​ມາ​ຫາ​ເຈົ້າ</para>
  <para style="q2" vid="MIC 7:12">ຈາກ​ອັດຊີເຣຍ ແລະ ເມືອງ​ຕ່າງໆ​ຂອງ​ເອຢິບ,</para>
  <para style="q1" vid="MIC 7:12">ເຖິງ​ແມ່ນ​ວ່າ​ຈາກ​ເອຢິບ​ໄປ​ຫາ​ເອີຟຣັດ</para>
  <para style="q2" vid="MIC 7:12">ຈາກ​ທະເລ​ໄປ​ຫາ​ທະເລ</para>
  <para style="q2" vid="MIC 7:12">ແລະ ຈາກ​ພູເຂົາ​ໄປ​ຫາ​ພູເຂົາ.<verse eid="MIC 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13" />ແຜ່ນດິນ​ໂລກ​ຈະ​ແຫ້ງແລ້ງ​ເພາະ​ຊາວ​ໂລກ.</para>
  <para style="q2" vid="MIC 7:13">ນັ້ນ​ເປັນ​ຜົນ​ຈາກ​ການ​ກະທຳ​ຂອງ​ພວກເຂົາ.<verse eid="MIC 7:13" /></para>
  <para style="s1">ຄຳ​ອະທິຖານ ແລະ ສັນລະເສີນ</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14" />ຂໍ​ໂຜດ​ລ້ຽງດູ​ປະຊາຊົນ​ຂອງ​ພຣະອົງ​ດ້ວຍ​ໄມ້ຄ້ອນເທົ້າ​ຂອງ​ພຣະອົງ,</para>
  <para style="q2" vid="MIC 7:14">ລ້ຽງດູ​ຝູງ​ແກະ​ທີ່​ເປັນ​ກຳມະສິດ​ຂອງ​ພຣະອົງ,</para>
  <para style="q1" vid="MIC 7:14">ເຊິ່ງ​ດຳລົງ​ຊີວິດ​ດ້ວຍ​ຕົນ​ເອງ​ຢູ່​ໃນ​ປ່າ,</para>
  <para style="q2" vid="MIC 7:14">ໃນ​ທົ່ງຫຍ້າ​ທີ່​ອຸດົມສົມບູນ.<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">ຫລື ກາງ​ພູເຂົາ​ກາເມນ</char></note></para>
  <para style="q1" vid="MIC 7:14">ໃຫ້​ພວກເຂົາ​ຫາ​ກິນ​ໃນ​ບາຊານ ແລະ ກີເລອາດ</para>
  <para style="q2" vid="MIC 7:14">ເໝືອນ​ໃນ​ອະດີດ​ດົນ​ມາ​ແລ້ວ.<verse eid="MIC 7:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15" />“ເໝືອນ​ເມື່ອ​ຄັ້ງ​ທີ່​ພວກເຈົ້າ​ອອກ​ມາ​ຈາກ​ເອຢິບ</para>
  <para style="q2" vid="MIC 7:15">ເຮົາ​ຈະ​ສະແດງ​ໃຫ້​ພວກເຈົ້າ​ເຫັນ​ການ​ອັດສະຈັນ​ຂອງ​ເຮົາ”.<verse eid="MIC 7:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16" />ປະຊາຊາດ​ທັງຫລາຍ​ຈະ​ເຫັນ ແລະ ຕ້ອງ​ອັບອາຍ,</para>
  <para style="q2" vid="MIC 7:16">ແລະ ສູນເສຍ​ອຳນາດ​ທັງໝົດ​ຂອງ​ພວກເຂົາ.</para>
  <para style="q1" vid="MIC 7:16">ພວກເຂົາ​ຈະ​ເອົາ​ມື​ຂອງ​ພວກເຂົາ​ປິດ​ປາກ​ຕົນ​ເອງ</para>
  <para style="q2" vid="MIC 7:16">ແລະ ຫູ​ຂອງ​ພວກເຂົາ​ກໍ​ຈະ​ໜວກ​ໄປ.<verse eid="MIC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17" />ພວກເຂົາ​ຈະ​ເລຍ​ຝຸ່ນ​ເໝືອນ​ງູ</para>
  <para style="q2" vid="MIC 7:17">ເໝືອນ​ສິ່ງ​ມີ​ຊີວິດ​ທີ່​ເລືອຄານ​ຢູ່​ຕາມ​ພື້ນດິນ.</para>
  <para style="q1" vid="MIC 7:17">ພວກເຂົາ​ຈະ​ໂຕ​ສັ່ນ​ເຊັນ​ອອກ​ມາ​ຈາກ​ຖ້ຳ​ຂອງ​ພວກເຂົາ</para>
  <para style="q2" vid="MIC 7:17">ພວກເຂົາ​ຈະ​ຫັນ​ມາ​ຫາ​ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ​ຂອງ​ພວກເຮົາ​ດ້ວຍ​ຄວາມ​ຢຳເກງ</para>
  <para style="q2" vid="MIC 7:17">ແລະ ຈະ​ຢ້ານ​ພຣະອົງ.<verse eid="MIC 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18" />ຜູ້ໃດ​ທີ່​ເປັນ​ພຣະເຈົ້າ​ເໝືອນ​ກັບ​ພຣະອົງ,</para>
  <para style="q2" vid="MIC 7:18">ຜູ້​ທີ່​ອະໄພ​ບາບ ແລະ ອະໄພ​ການ​ລ່ວງລະເມີດ</para>
  <para style="q2" vid="MIC 7:18">ຂອງ​ຄົນ​ທີ່​ເຫລືອ​ພຽງ​ຢິບ​ມື ເຊິ່ງ​ເປັນ​ກຳມະສິດ​ຂອງ​ພຣະອົງ?</para>
  <para style="q1" vid="MIC 7:18">ພຣະອົງ​ບໍ່​ໄດ້​ໃຈຮ້າຍ​ຢູ່​ຕະຫລອດໄປ</para>
  <para style="q2" vid="MIC 7:18">ແຕ່​ປີຕິຍິນດີ​ທີ່​ຈະ​ສະແດງ​ຄວາມ​ເມດຕາ.<verse eid="MIC 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19" />ພຣະອົງ​ຈະ​ເອັນ​ເມດຕາ​ສົງສານ​ພວກເຮົາ​ອີກ;</para>
  <para style="q2" vid="MIC 7:19">ຈະ​ຢຽບ​ບາບ​ທັງຫລາຍ​ຂອງ​ພວກເຮົາ​ໄວ້​ກ້ອງ​ຕີນ</para>
  <para style="q2" vid="MIC 7:19">ແລະ ແກວ່ງ​ຄວາມ​ຊົ່ວຊ້າ​ທັງໝົດ​ຂອງ​ພວກເຮົາ​ລົງ​ສູ່​ທະເລ​ເລິກ.<verse eid="MIC 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20" />ພຣະອົງ​ຈະ​ສັດຊື່​ຕໍ່​ຢາໂຄບ,</para>
  <para style="q2" vid="MIC 7:20">ແລະ ຈະ​ສະແດງ​ຄວາມ​ເມດຕາ​ແກ່​ອັບຣາຮາມ,</para>
  <para style="q1" vid="MIC 7:20">ເໝືອນດັ່ງ​ທີ່​ພຣະອົງ​ໄດ້​ປະຕິຍານ​ໄວ້​ກັບ​ບັນພະບຸລຸດ​ຂອງ​ພວກເຮົາ</para>
  <para style="q2" vid="MIC 7:20">ແຕ່​ດົນ​ນານ​ມາ​ແລ້ວ.<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>