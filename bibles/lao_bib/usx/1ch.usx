<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Biblica® Open Lao Contemporary Version</book>
  <para style="rem">Copyright © 2023, 2025 by Biblica, Inc.</para>
  <para style="h">1 ຂ່າວຄາວ</para>
  <para style="toc1">ພຣະທຳ 1 ຂ່າວຄາວ</para>
  <para style="toc2">1 ຂ່າວຄາວ</para>
  <para style="toc3">1ຂຄ</para>
  <para style="mt1">ພຣະທຳ 1 ຂ່າວຄາວ</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s1">ບັນທຶກ​ປະຫວັດສາດ​ຕັ້ງແຕ່​ອາດາມເຖິງ​ອັບຣາຮາມ</para>
  <para style="s2">ຕັ້ງແຕ່​ອາດາມ​ເຖິງ​ລູກຊາຍ​ຂອງ​ໂນອາ</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 1:1" />ອາດາມ, ເຊດ, ເອໂນດ,<verse eid="1CH 1:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 1:2" />ເກນານ, ມະຫາລາເລນ, ຢາເຣັດ,<verse eid="1CH 1:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 1:3" />ເອນົກ, ເມທູເສລາ, ລາເມັກ,</para>
  <para style="li1" vid="1CH 1:3">ແລະ ໂນອາ.<verse eid="1CH 1:3" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="4" style="v" sid="1CH 1:4" />ລູກຊາຍ​ຂອງ​ໂນອາ​ມີ​ດັ່ງນີ້<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ບໍ່​ມີ​ຂໍ້ຄວາມ​ວ່າ ລູກຊາຍ​ຂອງ​ໂນອາ​ມີ​ດັ່ງນີ້</char></note>: ເຊມ, ຮາມ ແລະ ຢາເຟດ.<verse eid="1CH 1:4" /></para>
  <para style="s2">ເຊື້ອສາຍ​ຂອງ​ຢາເຟດ</para>
  <para style="r">(ປຖກ 10:2-5)</para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5" />ລູກຊາຍ​ຂອງ​ຢາເຟດ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:5">ໂກເມ, ມາກົກ, ມາດາຍ, ຢາວານ, ຕູບານ, ເມເຊັກ ແລະ ຕີຣາດ.<verse eid="1CH 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6" />ລູກຊາຍ​ຂອງ​ໂກເມ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:6">ອັດຊະເກນາດ, ຣີຟາດ ແລະ ໂຕກາມາ.<verse eid="1CH 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7" />ລູກຊາຍ​ຂອງ​ຢາວານ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:7">ເອລີຊາ, ຕາກຊິດ, ສະເປນ, ໄຊປຣັດ ແລະ ໂຣເດັດ.<verse eid="1CH 1:7" /></para>
  <para style="s2">ເຊື້ອສາຍ​ຂອງ​ຮາມ</para>
  <para style="r">(ປຖກ 10:6-20)</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8" />ລູກຊາຍ​ຂອງ​ຮາມ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:8">ກູເຊ, ເອຢິບ,<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">ຄື ເອຢິບ ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="1CH 1:11"><ref loc="1CH 1:11">11</ref></char></char></note> ພູດ ແລະ ການາອານ.<verse eid="1CH 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9" />ບັນດາ​ລູກຊາຍ​ຂອງ​ກູເຊ​ມີ​ຄື:</para>
  <para style="li2" vid="1CH 1:9">ເຊບາ, ຮາວີລາ, ສັບຕາ, ຣາອາມາ ແລະ ສັບເຕກາ.</para>
  <para style="li1" vid="1CH 1:9">ບັນດາ​ລູກຊາຍ​ຂອງ​ຣາອາມາ​ມີ​ຄື:</para>
  <para style="li2" vid="1CH 1:9">ເຊບາ ແລະ ເດດານ.<verse eid="1CH 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10" />ກູເຊ​ເປັນ​ພໍ່<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">ຄຳ​ວ່າ ບິດາ ອາດ​ໝາຍ​ເຖິງ ບັນພະບຸລຸດ ຕົ້ນ​ຕະກຸນ ຫລື ຜູ້​ກໍ່​ຕັ້ງ ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="1CH 1:11"><ref loc="1CH 1:11">11</ref></char>, <char style="xt" link-href="1CH 1:13"><ref loc="1CH 1:13">13</ref></char>, <char style="xt" link-href="1CH 1:18"><ref loc="1CH 1:18">18</ref></char> ແລະ <char style="xt" link-href="1CH 1:20"><ref loc="1CH 1:20">20</ref></char></char></note>​ຂອງ</para>
  <para style="li2" vid="1CH 1:10">ນິມໂຣດ, ຜູ້​ທີ່​ໄດ້​ກາຍ​ເປັນ​ນັກຮົບ​ຜູ້​ຍິ່ງໃຫຍ່​ຄົນ​ໜຶ່ງ​ໃນ​ໂລກ.<verse eid="1CH 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11" />ເອຢິບ​ເປັນ​ພໍ່​ຂອງ</para>
  <para style="li2" vid="1CH 1:11">ຊາວ​ລູດີອາ, ຊາວ​ອານາມ, ຊາວ​ເລຮາບ, ຊາວ​ນັບຕູ <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />ຊາວ​ປາທະຣູຊິມ, ຊາວ​ກັດສະລູ ແລະ ຊາວ​ກະເຣເຕ (ເຊິ່ງ​ເປັນ​ບັນພະບຸລຸດ​ຂອງ​ຊາວ​ຟີລິດສະຕິນ) ແລະ ຊາວ​ຄັບຟະໂທຣິມ.<verse eid="1CH 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13" />ການາອານ​ເປັນ​ພໍ່​ຂອງ</para>
  <para style="li2" vid="1CH 1:13">ຊີໂດນ ຜູ້​ທີ່​ເປັນ​ລູກຊາຍ​ກົກ​ຂອງ​ລາວ<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">ຫລື ຊາວ​ຊີໂດນ​ພວກ​ທຳອິດ​ສຸດ</char></note> ແລະ ຊາວ​ຮິດຕີ, <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />ຊາວ​ເຢບຸດ, ຊາວ​ອາໂມ, ຊາວ​ກີກາຊີ, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />ຊາວ​ຮີວີ, ຊາວ​ອາກກີ, ຊາວ​ສີນີ, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />ຊາວ​ອາກວາດີ, ຊາວ​ເຊມາຣີ ແລະ ຊາວ​ຮາມັດ.<verse eid="1CH 1:16" /></para>
  <para style="s2">ເຊື້ອສາຍ​ຂອງ​ເຊມ</para>
  <para style="r">(ປຖກ 10:21-31; 11:10-27)</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17" />ລູກຊາຍ​ຂອງ​ເຊມ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:17">ເອລາມ, ອັດຊູຣະ, ອາກປັກຊາດ, ລູດ, ແລະ ອາຣາມ.</para>
  <para style="li1" vid="1CH 1:17">ລູກຊາຍ​ຂອງ​ອາຣາມ​ມີ​ດັ່ງນີ້:<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">ສຳ​ເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ບໍ່​ມີ​ປະ​ໂຫຍກ​ນີ້ (ເບິ່ງ <char style="xt"><ref loc="GEN 10:23">ປຖກ 10:23</ref></char>)</char></note></para>
  <para style="li2" vid="1CH 1:17">ອູເສ, ຮຸນ, ເກເຕີ ແລະ ເມເຊັກ.<verse eid="1CH 1:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18" />ອາກປັກຊາດ​ເປັນ​ພໍ່​ຂອງ​ເຊລາ,</para>
  <para style="li2" vid="1CH 1:18">ແລະ ເຊລາ​ເປັນ​ພໍ່​ຂອງ​ເອເບ.<verse eid="1CH 1:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19" />ເອເບ​ມີ​ລູກຊາຍ​ສອງ​ຄົນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:19">ຜູ້​ໜຶ່ງ​ຊື່​ວ່າ ເປເລັກ<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">ແປ​ວ່າ ແຍກ</char></note> ເພາະ​ໃນ​ສະໄໝ​ຂອງ​ລາວ​ໂລກ​ໄດ້​ແບ່ງແຍກ​ກັນ; ແລະ ອີກ​ຜູ້​ໜຶ່ງ​ຊື່​ວ່າ​ໂຢກທານ.<verse eid="1CH 1:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20" />ໂຢກທານ​ເປັນ​ພໍ່​ຂອງ</para>
  <para style="li2" vid="1CH 1:20">ອານໂມດາດ, ເຊເລັບ, ຮາຊາມາເວດ, ເຢຣາ, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />ຮາໂດຣາມ, ອູຊານ, ດີກະລາ, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />ເອບານ,<note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">ສຳ​ເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ເອບານ (ເບິ່ງ <char style="xt"><ref loc="GEN 10:28">ປຖກ 10:28</ref></char>)</char></note> ອາບີມາເອນ, ເຊບາ, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />ໂອຟີ, ຮາວີລາ ແລະ ໂຢບັບ. ຄົນ​ເຫລົ່ານີ້​ທັງໝົດ​ເປັນ​ລູກຊາຍ​ຂອງ​ໂຢກທານ.<verse eid="1CH 1:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24" />ເຊມ, ອາກປັກຊາດ,<note caller="+" style="f"><char style="fr" closed="false">1:24 </char><char style="ft" closed="false">ສຳ​ເນົາ ເຊັບຕູອາຈິນ​ບາງ​ສະບັບ​ວ່າ ອາກຟາສາດ </char><char style="fqa" closed="false">ກາຍ​ນານ</char></note> ເຊລາ,<verse eid="1CH 1:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 1:25" />ເອເບ, ເປເລັກ, ເຣອູ,<verse eid="1CH 1:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 1:26" />ເສຣຸກ, ນາໂຮ, ເຕຣາ,<verse eid="1CH 1:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 1:27" />ແລະ ອັບຣາມ (ຄື​ອັບຣາຮາມ).<verse eid="1CH 1:27" /></para>
  <para style="s1">ຄອບຄົວ​ຂອງ​ອັບຣາຮາມ</para>
  <para style="lh">
    <verse number="28" style="v" sid="1CH 1:28" />ລູກຊາຍ​ຂອງ​ອັບຣາຮາມ​ມີ​ດັ່ງນີ້: ອີຊາກ ແລະ ອິດຊະມາເອນ.<verse eid="1CH 1:28" /></para>
  <para style="s2">ເຊື້ອສາຍ​ຂອງ​ນາງ​ຮາກາ</para>
  <para style="r">(ປຖກ 25:12-16)</para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29" />ລູກຊາຍ​ຂອງ​ອິດຊະມາເອນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:29">ເນບາໂຢດ​ເປັນ​ລູກຊາຍ​ກົກ​ຂອງ​ອິດຊະມາເອນ, ເກດາ, ອັດເບເອນ, ມິບຊາມ, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />ມີຊະມາ, ດູມາ, ມາສາ, ຮາດັດ, ເຕມາ, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />ເຢຕຸຣະ, ນາຟີດ ແລະ ເກເດມາ.</para>
  <para style="lf" vid="1CH 1:31">ຄົນ​ເຫລົ່ານີ້​ເປັນ​ລູກຊາຍ​ຂອງ​ອິດຊະມາເອນ.<verse eid="1CH 1:31" /></para>
  <para style="s2">ເຊື້ອສາຍ​ຂອງ​ນາງ​ເກຕູຣາ</para>
  <para style="r">(ປຖກ 25:1-4)</para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32" />ລູກຊາຍ​ທີ່​ເກີດ​ມາ​ຈາກ​ນາງ​ເກຕູຣາ ເຊິ່ງ​ເປັນ​ເມຍນ້ອຍ​ຂອງ​ອັບຣາຮາມ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:32">ຊິມຣານ, ໂຢກຊານ, ເມດານ, ມີດີອານ, ອີຊະບາກ ແລະ ຊູອາ.</para>
  <para style="li1" vid="1CH 1:32">ລູກຊາຍ​ຂອງ​ໂຢກຊານ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:32">ເຊບາ ແລະ ເດດານ.<verse eid="1CH 1:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33" />ລູກຊາຍ​ຂອງ​ມີດີອານ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:33">ເອຟາ, ເອເຟ, ຮານົກ, ອາບີດາ ແລະ ເອນດາອາ.</para>
  <para style="lf" vid="1CH 1:33">ຄົນ​ທັງໝົດ​ເຫລົ່ານີ້​ເປັນ​ເຊື້ອສາຍ​ຂອງ​ນາງ​ເກຕູຣາ.<verse eid="1CH 1:33" /></para>
  <para style="s2">ເຊື້ອສາຍ​ຂອງ​ນາງ​ຊາຣາ</para>
  <para style="r">(ປຖກ 36:10-14)</para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 1:34" />ອັບຣາຮາມ​ເປັນ​ພໍ່​ຂອງ​ອີຊາກ.</para>
  <para style="li1" vid="1CH 1:34">ລູກຊາຍ​ຂອງ​ອີຊາກ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:34">ເອຊາວ ແລະ ອິດສະຣາເອນ.<verse eid="1CH 1:34" /></para>
  <para style="s2">ລູກຊາຍ​ຂອງ​ເອຊາວ</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35" />ລູກຊາຍ​ຂອງ​ເອຊາວ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:35">ເອລີຟັດ, ເຣອູເອນ, ເຢອຸດ, ຢາລາມ ແລະ ໂກຣາ.<verse eid="1CH 1:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36" />ລູກຊາຍ​ຂອງ​ເອລີຟັດ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:36">ເຕມານ, ໂອມາກ, ເຊຟີ,<note caller="+" style="f"><char style="fr" closed="false">1:36 </char><char style="ft" closed="false">ສຳ​ເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ເສ​ເຟ (ເບິ່ງ <char style="xt"><ref loc="GEN 36:11">ປຖກ 36:11</ref></char>)</char></note> ຄາຕາມ, ເກນາດ,</para>
  <para style="li2" vid="1CH 1:36">ແລະ ອາມາເຫລັກ, ທີ່​ເກີດ​ມາ​ຈາກ​ນາງ​ຕີມນາ.<note caller="+" style="f"><char style="fr" closed="false">1:36 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ </char><char style="fqa" closed="false">ຄາຕາມ ເກນາດ ຕິມນາ ແລະ ອາ </char><char style="fqa" closed="false">ເມ </char><char style="ft" closed="false">ເຫລັກ (ເບິ່ງ <char style="xt"><ref loc="GEN 36:12">ປຖກ 36:12</ref></char>)</char></note><verse eid="1CH 1:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37" />ລູກຊາຍ​ຂອງ​ເຣອູເອນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:37">ນາຮາດ, ເຊຣາ, ຊາມມາ ແລະ ມິດຊາ.<verse eid="1CH 1:37" /></para>
  <para style="s2">ປະຊາຊົນ​ຂອງ​ເສອີ​ໃນ​ເອໂດມ</para>
  <para style="r">(ປຖກ 36:20-28)</para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38" />ລູກຊາຍ​ຂອງ​ເສອີ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:38">ໂລຕັນ, ໂຊບານ, ຊີເບໂອນ, ອານາ, ດີໂຊນ, ເອເຊ ແລະ ດີຊານ.<verse eid="1CH 1:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39" />ລູກຊາຍ​ຂອງ​ໂລຕັນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:39">ໂຮຣີ ແລະ ໂຮມາມ. ຕີມນາ​ເປັນ​ນ້ອງສາວ​ຂອງ​ໂລຕັນ.<verse eid="1CH 1:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40" />ລູກຊາຍ​ໂຊບານ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:40">ອາລີອານ,<note caller="+" style="f"><char style="fr" closed="false">1:40 </char><char style="ft" closed="false">ສຳ​ເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ເອລີ​ຍັນ (ເບິ່ງ <char style="xt"><ref loc="GEN 36:23">ປຖກ 36:23</ref></char>)</char></note> ມານາຮາດ, ເອບານ, ເຊໂຟ ແລະ ໂອນາມ.</para>
  <para style="li1" vid="1CH 1:40">ລູກຊາຍ​ຊີເບໂອນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:40">ອາອີຢາ ແລະ ອານາ.<verse eid="1CH 1:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41" />ລູກຊາຍ​ຂອງ​ອານາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:41">ດີໂຊນ</para>
  <para style="li1" vid="1CH 1:41">ລູກຊາຍ​ຂອງ​ດີໂຊນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:41">ຮຳຣານ,<note caller="+" style="f"><char style="fr" closed="false">1:41 </char><char style="ft" closed="false">ສຳ​ເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ຮຳລານ (ເບິ່ງ <char style="xt"><ref loc="GEN 36:26">ປຖກ 36:26</ref></char>)</char></note> ເອັດຊະບານ, ອິທະຣານ ແລະ ເກຣານ.<verse eid="1CH 1:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42" />ລູກຊາຍ​ຂອງ​ເອເຊ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:42">ບິນຮານ, ຊາອາວານ ແລະ ອາການ.<note caller="+" style="f"><char style="fr" closed="false">1:42 </char><char style="ft" closed="false">ສຳ​ເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ຢາອາຄານ (ເບິ່ງ <char style="xt"><ref loc="GEN 36:27">ປຖກ 36:27</ref></char>)</char></note></para>
  <para style="li1" vid="1CH 1:42">ລູກຊາຍ​ຂອງ​ດີຊານ<note caller="+" style="f"><char style="fr" closed="false">1:42 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ດີໂຊນ ເປັນ​ອີກ​ຮູບ​ໜຶ່ງ​ຂອງ ດີຊານ</char></note>​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 1:42">ອູເຊ ແລະ ອາຣານ.<verse eid="1CH 1:42" /></para>
  <para style="s2">ບັນດາ​ຜູ້ປົກຄອງ​ຂອງ​ເອໂດມ</para>
  <para style="r">(ປຖກ 36:31-43)</para>
  <para style="lh">
    <verse number="43" style="v" sid="1CH 1:43" />ຄົນ​ເຫລົ່ານີ້​ເປັນ​ບັນດາ​ກະສັດ​ທີ່​ໄດ້​ປົກຄອງ​ໃນ​ເອໂດມ​ກ່ອນ​ທີ່​ຈະ​ມີ​ບັນດາ​ກະສັດ​ອິດສະຣາເອນ​ໄດ້​ປົກຄອງ​ມີ​ດັ່ງນີ້:<note caller="+" style="f"><char style="fr" closed="false">1:43 </char><char style="ft" closed="false">ຫລື ກ່ອນ​ກະສັດ​ອິດສະຣາເອນ​ປົກຄອງ​ເໜືອ​ພວກເຂົາ</char></note></para>
  <para style="li1" vid="1CH 1:43">ເບລາ ລູກຊາຍ​ຂອງ​ເບໂອ, ເຊິ່ງ​ມີ​ເມືອງ​ທີ່​ຊື່​ວ່າ​ດິນຮາບາ.<verse eid="1CH 1:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44" />ເມື່ອ​ເບລາ​ໄດ້​ຕາຍ​ໄປ​ແລ້ວ, ໂຢບັບ ລູກຊາຍ​ຂອງ​ເຊຣາ​ຈາກ​ເມືອງ​ໂບຊະຣາ​ກໍ​ໄດ້​ຂຶ້ນ​ເປັນ​ກະສັດ​ແທນ​ເພິ່ນ.<verse eid="1CH 1:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45" />ເມື່ອ​ໂຢບັບ​ຕາຍໄປ​ແລ້ວ, ຮູຊາມ​ຈາກ​ດິນແດນ​ຂອງ​ຊາວ​ເຕມານ​ກໍ​ໄດ້​ຂຶ້ນ​ເປັນ​ກະສັດ​ແທນ​ເພິ່ນ.<verse eid="1CH 1:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46" />ເມື່ອ​ຮູຊາມ​ໄດ້​ໄປ​ຕາຍ​ແລ້ວ, ຮາດັດ​ລູກ​ຊາຍ​ຂອງ​ເບດັດ, ຜູ້​ທີ່​ໄດ້​ເອົາ​ຊະນະ​ຊາວ​ມີດີອານ​ໃນ​ດິນແດນ​ໂມອາບ, ລາວ​ກໍ​ໄດ້​ຂຶ້ນ​ເປັນ​ກະສັດ​ແທນ​ເພິ່ນ, ເມືອງ​ຂອງ​ເພິ່ນ​ຊື່​ວ່າ ອາວິດ.<verse eid="1CH 1:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47" />ເມື່ອ​ຮາດັດ​ໄດ້​ຕາຍ​ໄປ​ແລ້ວ, ຊາມລາ​ຈາກ​ເມືອງ​ມັດເຣກາ​ກໍ​ໄດ້​ຂຶ້ນ​ເປັນ​ກະສັດ​ແທນ​ເພິ່ນ.<verse eid="1CH 1:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48" />ເມື່ອ​ຊາມລາ​ໄດ້​ຕາຍ​ໄປ​ແລ້ວ, ຊາອູນ​ຈາກ​ເມືອງ​ເຣໂຮໂບດ​ຕັ້ງ​ຢູ່​ທີ່​ແຄມ​ແມ່ນໍ້າ<note caller="+" style="f"><char style="fr" closed="false">1:48 </char><char style="ft" closed="false">ອາດຈະ​ເປັນ​ແມ່ນ້ຳ​ເອີຟຣັດ</char></note>​ກໍ​ໄດ້​ຂຶ້ນ​ເປັນ​ກະສັດ​ແທນ​ເພິ່ນ.<verse eid="1CH 1:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49" />ເມື່ອ​ຊາອູນ​ໄດ້​ຕາຍ​ໄປ​ແລ້ວ, ບາອານຮານານ ລູກຊາຍ​ຂອງ​ອັກໂບ​ກໍ​ໄດ້​ຂຶ້ນ​ເປັນ​ກະສັດ​ແທນ​ເພິ່ນ.<verse eid="1CH 1:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50" />ເມື່ອ​ບາອານຮານານ​ໄດ້​ຕາຍ​ໄປ​ແລ້ວ, ຮາດັດ​ກໍ​ໄດ້​ຂຶ້ນ​ເປັນ​ກະສັດ​ແທນ​ເພິ່ນ. ເມືອງ​ຂອງ​ເພິ່ນ​ຊື່​ວ່າ​ປາອູ<note caller="+" style="f"><char style="fr" closed="false">1:50 </char><char style="ft" closed="false">ສຳ​ເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ປາອີ (ເບິ່ງ <char style="xt"><ref loc="GEN 36:39">ປຖກ 36:39</ref></char>)</char></note> ແລະ ເມຍ​ຂອງ​ເພິ່ນ​ຊື່​ວ່າ ເມເຫັດຕາເບັນ ຜູ້​ເປັນ​ລູກສາວ​ຂອງ​ມາດເຣດ, ຫລານສາວ​ຂອງ​ເມຊາຮາບ. <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />ຮາດັດ​ກໍ​ໄດ້​ຕາຍ​ໄປ​ເໝືອນກັນ.</para>
  <para style="b" vid="1CH 1:51" />
  <para style="lh" vid="1CH 1:51">ຫົວໜ້າ​ເຜົ່າ​ຂອງ​ເອໂດມ​ມີ​ດັ່ງນີ້:</para>
  <para style="li1" vid="1CH 1:51">ຕິມນາ, ອານວາ, ເຢເທັດ, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />ໂອໂຮລີບາມາ, ເອລາ, ປີໂນນ, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />ເກນາດ, ເຕມານ, ມິບສາຣະ,<verse eid="1CH 1:53" /></para>
  <para style="lf">
    <verse number="54" style="v" sid="1CH 1:54" />ມັກດີເອນ ແລະ ອີຣາມ, ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ຫົວໜ້າ​ເຜົ່າ​ຂອງ​ເອໂດມ.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s1">ລູກຊາຍ​ຂອງ​ອິດສະຣາເອນ</para>
  <para style="r">(ປຖກ 35:23-26)</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 2:1" />ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ລູກຊາຍ​ຂອງ​ອິດສະຣາເອນ​ມີ​ດັ່ງນີ້: ຣູເບັນ, ຊີເມໂອນ, ເລວີ, ຢູດາ, ອິດຊາຄາ, ເຊບູໂລນ, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />ດານ, ໂຢເຊັບ, ເບັນຢາມິນ, ເນັບທາລີ, ກາດ ແລະ ອາເຊ.<verse eid="1CH 2:2" /></para>
  <para style="s1">ຢູດາ</para>
  <para style="r">(ນຣ 4:18-22; ມທ 1:3-6)</para>
  <para style="s2">ຕັ້ງແຕ່​ຢູດາ​ເຖິງ​ລູກຊາຍ​ຂອງ​ເຮຊະໂຣນ</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3" />ລູກຊາຍ​ຂອງ​ຢູດາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:3">ເອຣະ, ໂອນານ ແລະ ເຊລາ. ຄົນ​ເຫລົ່ານີ້​ເກີດ​ຈາກ​ນາງ​ບັດຊູອາ​ຍິງ​ຊາວ​ການາອານ, ທີ່​ເປັນ​ລູກສາວ​ຂອງ​ຊູອາ.</para>
  <para style="li2" vid="1CH 2:3">(ເອຣະ​ເປັນ​ລູກຊາຍ​ກົກ​ຂອງ​ຢູດາ, ລາວ​ເປັນ​ຄົນ​ຊົ່ວຮ້າຍ​ໃນ​ສາຍ​ຕາ​ຂອງ​ພຣະເຈົ້າຢາເວ; ດັ່ງນັ້ນ ພຣະອົງ​ຈຶ່ງ​ຂ້າ​ລາວ).<verse eid="1CH 2:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 2:4" />ນາງ​ຕາມາ​ເປັນ​ລູກ​ໄພ້​ຂອງ​ຢູດາ​ມີ​ລູກຊາຍ​ສອງ​ຄົນ​ຄື: ເປເຣັດ ແລະ ເຊຣາ.</para>
  <para style="lf" vid="1CH 2:4">ຢູດາ​ຈຶ່ງ​ມີ​ລູກຊາຍ​ທັງໝົດ​ຫ້າ​ຄົນ.<verse eid="1CH 2:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5" />ລູກຊາຍ​ຂອງ​ເປເຣັດ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:5">ເຮຊະໂຣນ ແລະ ຮາມູນ.<verse eid="1CH 2:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6" />ລູກຊາຍ​ຂອງ​ເຊຣາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:6">ຊິມຣີ, ເອທານ, ເຮມານ, ການໂກນ ແລະ ດາກດາ<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">ສຳ​ເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ດາ​ລາ (ເບິ່ງ <char style="xt"><ref loc="1KI 4:31">1ກສ 4:31</ref></char>) ຊິມຣີ, ເອທານ, ເຮມານ, ການໂກນ ແລະ ດາກດາ</char></note> ທັງໝົດ​ມີ​ຫ້າ​ຄົນ.<verse eid="1CH 2:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7" />ລູກຊາຍ​ຂອງ​ການໝີ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:7">ອາການ,<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">ແປ​ວ່າ ບັນຫາ ໃນ​ພະທຳ​ໂຢຊວຍ​ເອີ້ນ ອາ​ຄາລີ ວ່າ ອາການ</char></note> ຜູ້​ທີ່​ນຳ​ຄວາມ​ຍາກລໍາບາກ​ມາ​ສູ່​ອິດສະຣາເອນ​ໂດຍ​ການ​ເກັບ​ເອົາ​ສິ່ງ​ທີ່​ຫ່ວງຫ້າມ​ທີ່​ໄດ້​ອຸທິດ​ຖວາຍ​ໃຫ້​ແກ່​ພຣະເຈົ້າ.<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">ຄຳ​ນີ້​ໃນ​ພາສາ​ເຮັບເຣີ​ໝາຍ​ເຖິງ​ສິ່ງ​ຂອງ ຫລື ບຸກ​ຄົນ​ທີ່​ຖວາຍ​ແດ່​ອົງພຣະຜູ້ເປັນເຈົ້າ​ແລ້ວ ບໍ່​ອາດ​ເອີ້ນ​ຄືນ​ໄດ້ ມັກ​ຈະ​ຕ້ອງ​ທຳລາຍ​ໃຫ້​ໝົດ​ສິ້ນ​ໄປ</char></note><verse eid="1CH 2:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8" />ລູກຊາຍ​ຂອງ​ເອທານ​ຄື:</para>
  <para style="li2" vid="1CH 2:8">ອາຊາຣີຢາ.<verse eid="1CH 2:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9" />ລູກຊາຍ​ຂອງ​ເຮຊະໂຣນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:9">ເຢຣາເມເອນ, ຣາມ ແລະ ກາເລັບ.<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ເຄລຸໄບ ເປັນ​ອີກ​ຮູບ​ໜຶ່ງ​ຂອງ ກາເລັບ</char></note><verse eid="1CH 2:9" /></para>
  <para style="s2">ຕັ້ງແຕ່​ຣາມ​ລູກຊາຍ​ຂອງ​ເຮຊະໂຣນ</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10" />ຣາມ​ເປັນ​ພໍ່​ຂອງ​ອຳມີນາດາບ,</para>
  <para style="li1" vid="1CH 2:10">ແລະ ອຳມີນາດາບ​ເປັນ​ພໍ່​ຂອງ​ນາໂຊນ, ຜູ້​ທີ່​ເປັນ​ຜູ້ນໍາ​ຂອງ​ປະຊາຊົນ​ຢູດາຍ.<verse eid="1CH 2:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 2:11" />ນາໂຊນ​ເປັນ​ພໍ່​ຂອງ​ສານໂມນ,<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ </char><char style="fqa" closed="false">ຊານມາ (ເບິ່ງ <char style="xt"><ref loc="RUT 4:21">ນຣ 4:21</ref></char>)</char></note></para>
  <para style="li1" vid="1CH 2:11">ສານໂມນ​ເປັນ​ພໍ່​ຂອງ​ໂບອາດ,<verse eid="1CH 2:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 2:12" />ໂບອາດ​ເປັນ​ພໍ່​ຂອງ​ໂອເບັດ</para>
  <para style="li1" vid="1CH 2:12">ແລະ ໂອເບັດ​ເປັນ​ພໍ່​ຂອງ​ເຢຊີ.<verse eid="1CH 2:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13" />ເຢຊີ​ເປັນ​ພໍ່​ຂອງ</para>
  <para style="li2" vid="1CH 2:13">ເອລີອາບ​ຜູ້​ທີ່​ເປັນ​ລູກຊາຍ​ກົກ; ລູກຊາຍ​ຄົນ​ທີ​ສອງ​ແມ່ນ​ອາບີນາດາບ,</para>
  <para style="li2" vid="1CH 2:13">ຄົນ​ທີ​ສາມ​ແມ່ນ​ຊີເມອາ, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />ຄົນ​ທີ​ສີ່​ແມ່ນ​ເນທາເນນ,</para>
  <para style="li2" vid="1CH 2:14">ຄົນ​ທີ​ຫ້າ​ແມ່ນ​ຣັດດາຍ, <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />ຄົນ​ທີ​ຫົກ​ແມ່ນ​ໂອເຊມ</para>
  <para style="li2" vid="1CH 2:15">ແລະ ຄົນ​ທີ​ເຈັດ​ແມ່ນ​ດາວິດ.<verse eid="1CH 2:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="1CH 2:16" />ເອື້ອຍ​ຂອງ​ພວກເຂົາ​ແມ່ນ​ນາງ​ເຊຣູອີຢາ ແລະ ນາງ​ອາບີກາຍ.</para>
  <para style="li3" vid="1CH 2:16">ນາງ​ເຊຣູອີຢາ​ມີ​ລູກຊາຍ​ສາມ​ຄົນ​ດັ່ງນີ້: ອາບີໄຊ, ໂຢອາບ ແລະ ອາສາເຮນ.<verse eid="1CH 2:16" /></para>
  <para style="li3">
    <verse number="17" style="v" sid="1CH 2:17" />ອາບີກາຍ​ເປັນ​ແມ່​ຂອງ​ອາມາສາ ເຊິ່ງ​ພໍ່​ຂອງ​ລາວ​ແມ່ນ​ເຢເທີ​ເປັນ​ຊາວ​ອິດຊະມາເອນ.<verse eid="1CH 2:17" /></para>
  <para style="s2">ກາເລັບ​ລູກຊາຍ​ຂອງ​ເຮຊະໂຣນ</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18" />ກາເລັບ​ລູກຊາຍ​ຂອງ​ເຮຊະໂຣນ​ໄດ້​ລູກ​ກັບ ນາງ​ອາຊູບາ (ແລະ ເຢຣີໂອດ). ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ລູກຊາຍ​ຂອງ​ນາງ​ອາຊູບາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:18">ເຢເຊ, ໂຊບັບ ແລະ ອາກໂດນ.<verse eid="1CH 2:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 2:19" />ເມື່ອ​ອາຊູບາ​ໄດ້​ຕາຍ​ໄປ​ແລ້ວ, ກາເລັບ​ກໍ​ໄດ້​ແຕ່ງງານ​ກັບ​ເອຟຣັດ, ເຊິ່ງ​ນາງ​ມີ​ລູກຊາຍ​ຄົນ​ໜຶ່ງ​ໃຫ້​ລາວ​ຊື່​ວ່າ ຮູເຣ.<verse eid="1CH 2:19" /></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 2:20" />ຮູເຣ​ເປັນ​ພໍ່​ຂອງ​ອູຣິ, ແລະ ອູຣິ​ເປັນ​ພໍ່​ຂອງ​ເບຊາເລນ.<verse eid="1CH 2:20" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21" />ຕໍ່ມາ, ເມື່ອ​ລາວ​ມີ​ອາຍຸ​ຫົກ​ສິບ​ປີ, ເຮຊະໂຣນ​ໄດ້​ແຕ່ງງານ​ກັບ​ລູກສາວ​ຂອງ​ມາກີ, ເຊິ່ງ​ເປັນ​ພໍ່​ຂອງ​ກີເລອາດ. ລາວ​ຮັກ​ນາງ​ຫລາຍ ແລະ ນາງ​ໄດ​ໃຫ້​ກຳເນີດ​ລູກຊາຍ​ຄົນ​ໜຶ່ງ​ຊື່​ວ່າ​ເສກຸບ.<verse eid="1CH 2:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 2:22" />ເສກຸບ​ເປັນ​ພໍ່​ຂອງ​ຢາອີ, ເຊິ່ງ​ລາວ​ໄດ້​ປົກຄອງ​ເມືອງ 23 ແຫ່ງ​ໃນ​ເຂດແດນ​ກີເລອາດ.<verse eid="1CH 2:22" /></para>
  <para style="li2">
    <verse number="23" style="v" sid="1CH 2:23" />(ແຕ່​ເກຊູ ແລະ ອາຣາມ​ໄດ້​ຢຶດ​ເມືອງ​ຮັບໂວດ​ຢາອີ,<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">ຫລື ຢຶດ​ບໍລິເວນ​ທີ່​ຕັ້ງ​ຖິ່ນ​ຖານ​ຂອງ​ຢາອີ</char></note> ພວກເຂົາ​ຍັງ​ໄດ້​ຢຶດ​ເມືອງ​ເກນາດ​ພ້ອມທັງ​ຫົກສິບ​ເມືອງ​ທີ່​ຕັ້ງ​ຢູ່​ອ້ອມ​ນັ້ນ​ດ້ວຍ).</para>
  <para style="lf" vid="1CH 2:23">ຄົນ​ເຫລົ່ານີ້​ທັງໝົດ​ເປັນ​ເຊື້ອສາຍ​ຂອງ​ມາກີ​ຜູ້​ທີ່​ເປັນ​ພໍ່​ຂອງ​ກີເລອາດ.<verse eid="1CH 2:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24" />ຫລັງຈາກ​ທີ່​ເຮຊະໂຣນ​ໄດ້​ຕາຍ​ໄປ​ໃນ​ກາເລັບ​ເອຟຣັດ, ອາບີຢາ​ເມຍ​ຂອງ​ເຮຊະໂຣນ​ມີ​ລູກຊາຍ​ຊື່ ອາຊະຮູ, ເຊິ່ງ​ເປັນ​ພໍ່<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="ft" closed="false">ຄຳ​ວ່າ ບິດາ ອາດຈະ​ມີ​ຄວາມຫມາຍ​ວ່າ ຜູ້​ນຳ​ທາງ​ພົນລະ​ເມືອງ ຫລື ຜູ້​ນຳ​ທາງ​ທະຫານ ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="1CH 2:42"><ref loc="1CH 2:42">42</ref></char>, <char style="xt" link-href="1CH 2:45"><ref loc="1CH 2:45">45</ref></char>, <char style="xt" link-href="1CH 2:49-52"><ref loc="1CH 2:49">49-52</ref></char> ແລະ ອາດຈະ​ມີ​ຄວາມຫມາຍ​ຢ່າງ​ນີ້​ໃນ​ທີ່​ອື່ນໆ​ດ້ວຍ</char></note>​ຂອງ​ເຕກົວ.<verse eid="1CH 2:24" /></para>
  <para style="s2">ເຢຣາເມເອນ​ລູກຊາຍ​ຂອງ​ເຮຊະໂຣນ</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25" />ລູກຊາຍ​ຂອງ​ເຢຣາເມເອນ​ທີ່​ເປັນ​ລູກຊາຍ​ກົກ​ຂອງ​ເຮຊະໂຣນ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:25">ຣາມ​ເປັນ​ລູກຊາຍ​ກົກ​ຂອງ​ລາວ, ບູນາ, ໂອເຣນ, ໂອເຊມ ແລະ<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ໂອເຣັນ ແລະ ໂອເສມ ເຊິ່ງ​ເກີດ​ຈາກ​ນາງ</char></note> ອາຮີຢາ. <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />ເຢຣາເມເອນ​ມີ​ເມຍ​ອີກ​ຄົນ​ໜຶ່ງ, ເຊິ່ງ​ຊື່​ວ່າ ອາຕາຣາ; ນາງ​ເປັນ​ແມ່​ຂອງ​ໂອນາມ.<verse eid="1CH 2:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27" />ຣາມ​ເປັນ​ລູກຊາຍ​ກົກ​ຂອງ​ເຢຣາເມເອນ​ມີ​ລູກຊາຍ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:27">ມາອາ, ຢາມິນ ແລະ ເອເກ.<verse eid="1CH 2:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28" />ລູກຊາຍ​ຂອງ​ໂອນາມ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:28">ຊາມມາຍ ແລະ ຢາດາ.</para>
  <para style="li1" vid="1CH 2:28">ລູກຊາຍ​ຂອງ​ຊາມມາຍ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:28">ນາດາບ ແລະ ອາບີຊູ. <verse eid="1CH 2:28" /><verse number="29" style="v" sid="1CH 2:29" />ເມຍ​ຂອງ​ອາບີຊູ​ຊື່​ວ່າ ອາບີໄຮ, ນາງ​ມີ​ລູກຊາຍ​ຊື່​ວ່າ ອາບານ ແລະ ໂມລິດ.<verse eid="1CH 2:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30" />ລູກຊາຍ​ຂອງ​ນາດາບ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:30">ເສເລັດ ແລະ ອັບປາອິມ. ເສເລັດ​ໄດ້​ຕາຍ​ໄປ​ໂດຍ​ບໍ່​ມີ​ລູກ.<verse eid="1CH 2:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31" />ລູກຊາຍ​ຂອງ​ອັບປາອິມ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:31">ອີຊີ, ຜູ້​ທີ່​ເປັນ​ພໍ່​ຂອງ​ເຊຊານ. ເຊຊານ​ເປັນ​ພໍ່​ຂອງ​ອາຮະໄລ.<verse eid="1CH 2:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32" />ລູກຊາຍ​ຂອງ​ຢາດາ, ເຊິ່ງ​ເປັນ​ນ້ອງຊາຍ​ຂອງ​ຊາມມາຍ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:32">ເຢເທີ ແລະ ໂຢນາທານ. ເຢເທີ​ໄດ້​ຕາຍ​ໄປ​ໂດຍ​ບໍ່​ມີ​ລູກ.<verse eid="1CH 2:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33" />ລູກຊາຍ​ຂອງ​ໂຢນາທານ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:33">ເປເລັດ ແລະ ຊາຊາ.</para>
  <para style="lf" vid="1CH 2:33">ຄົນ​ເຫລົ່ານີ້​ເປັນ​ເຊື້ອສາຍ​ຂອງ​ເຢຣາເມເອນ.<verse eid="1CH 2:33" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34" />ເຊຊານ​ບໍ່​ມີ​ລູກຊາຍ, ລາວ​ມີ​ແຕ່​ລູກສາວ.</para>
  <para style="li2" vid="1CH 2:34">ລາວ​ມີ​ຄົນ​ຮັບໃຊ້​ຊາວ​ເອຢິບ​ຜູ້​ໜຶ່ງ​ຊື່​ວ່າ​ຢາຣະຮາ. <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />ເຊຊານ​ຍົກ​ລູກສາວ​ຄົນ​ໜຶ່ງ​ໃຫ້​ແຕ່ງງານ​ກັບ​ຄົນຮັບໃຊ້​ຂອງ​ຕົນ​ຊື່​ວ່າ ຢາຣະຮາ, ແລ້ວ​ນາງ​ກໍ​ມີ​ລູກຊາຍ​ຊື່​ວ່າ ອັດໄຕ.<verse eid="1CH 2:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36" />ອັດໄຕ​ເປັນ​ພໍ່​ຂອງ​ນາທານ,</para>
  <para style="li1" vid="1CH 2:36">ນາທານ​ເປັນ​ພໍ່​ຂອງ​ຊາບັດ,<verse eid="1CH 2:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 2:37" />ຊາບັດ​ເປັນ​ພໍ່​ຂອງ​ເອຟະລານ,</para>
  <para style="li1" vid="1CH 2:37">ເອຟະລານ​ເປັນ​ພໍ່​ຂອງ​ໂອເບັດ,<verse eid="1CH 2:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 2:38" />ໂອເບັດ​ເປັນ​ພໍ່​ຂອງ​ເຢຮູ,</para>
  <para style="li1" vid="1CH 2:38">ເຢຮູ​ເປັນ​ພໍ່​ຂອງ​ອາຊາຣີຢາ,<verse eid="1CH 2:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 2:39" />ອາຊາຣີຢາ​ເປັນ​ພໍ່​ຂອງ​ເຮເລັດ,</para>
  <para style="li1" vid="1CH 2:39">ເຮເລັດ​ເປັນ​ພໍ່​ຂອງ​ເອເລອາສາ,<verse eid="1CH 2:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 2:40" />ເອເລອາສາ​ເປັນ​ພໍ່​ຂອງ​ສີສະໝາຍ,</para>
  <para style="li1" vid="1CH 2:40">ສີສະໝາຍ​ເປັນ​ພໍ່​ຂອງ​ຊໍລູມ,<verse eid="1CH 2:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 2:41" />ຊໍລູມ​ເປັນ​ພໍ່​ຂອງ​ເຢກາມີຢາ</para>
  <para style="li1" vid="1CH 2:41">ແລະ ເຢກາມີຢາ​ເປັນ​ພໍ່​ຂອງ​ເອລີຊາມາ.<verse eid="1CH 2:41" /></para>
  <para style="s2">ຕະກຸນ​ຂອງ​ກາເລັບ</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42" />ລູກຊາຍ​ຂອງ​ກາເລັບ​ທີ່​ເປັນ​ນ້ອງຊາຍ​ຂອງ​ເຢຣາເມເອນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:42">ເມຊາ​ເປັນ​ລູກຊາຍ​ກົກ​ຂອງ​ລາວ, ເຊິ່ງ​ລາວ​ເປັນ​ພໍ່​ຂອງ​ສີເຟ,</para>
  <para style="li2" vid="1CH 2:42">ແລະ ລູກຊາຍ​ຂອງ​ລາວ​ແມ່ນ​ມາເຣຊາ,<note caller="+" style="f"><char style="fr" closed="false">2:42 </char><char style="ft" closed="false">ໃນ​ພາສາ​ເຮັບເຣີ​ປະໂຫຍກ​ນີ້​ມີ​ຄວາມຫມາຍ​ບໍ່​ຊັດເຈນ</char></note> ເຊິ່ງ​ເປັນ​ພໍ່​ຂອງ​ເຮັບໂຣນ.<verse eid="1CH 2:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43" />ລູກຊາຍ​ຂອງ​ເຮັບໂຣນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:43">ໂກຣາ, ຕັບປູອາ, ເຣເກມ ແລະ ເຊມາ.<verse eid="1CH 2:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 2:44" />ເຊມາ​ເປັນ​ພໍ່​ຂອງ​ຣາຮາມ</para>
  <para style="li2" vid="1CH 2:44">ແລະ ຣາຮາມ​ເປັນ​ພໍ່​ຂອງ​ຢອກເກອາມ.</para>
  <para style="li1" vid="1CH 2:44">ເຣເກມ​ເປັນ​ພໍ່​ຂອງ​ຊາມມາຍ.<verse eid="1CH 2:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 2:45" />ລູກຊາຍ​ຂອງ​ຊາມມາຍ​ແມ່ນ​ມາໂອນ,</para>
  <para style="li2" vid="1CH 2:45">ແລະ ມາໂອນ​ເປັນ​ພໍ່​ຂອງ​ເບັດຊູເຣ.<verse eid="1CH 2:45" /></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 2:46" />ເມຍນ້ອຍ​ຂອງ​ກາເລັບ​ແມ່ນ​ເອຟາ​ທີ່​ແມ່​ຂອງ</para>
  <para style="li2" vid="1CH 2:46">ຮາຣານ, ໂມຊາ ແລະ ກາເຊ.</para>
  <para style="p" vid="1CH 2:46">ຮາຣານ​ເປັນ​ພໍ່​ຂອງ​ກາເຊ.<verse eid="1CH 2:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47" />ລູກຊາຍ​ຂອງ​ຢາດາຍ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:47">ເຣເຄມ, ໂຢທານ, ເກຊານ, ເປເລດ, ເອຟາ ແລະ ຊາອາບ.<verse eid="1CH 2:47" /></para>
  <para style="li2">
    <verse number="48" style="v" sid="1CH 2:48" />ມາອາກາ​ເປັນ​ເມຍນ້ອຍ​ຂອງ​ກາເລັບ​ທີ່​ເປັນ​ແມ່​ຂອງ</para>
  <para style="li2" vid="1CH 2:48">ເຊເບ ແລະ ຕີຮານາ.<verse eid="1CH 2:48" /></para>
  <para style="li2">
    <verse number="49" style="v" sid="1CH 2:49" />ນາງ​ກໍ​ຍັງ​ໄດ້​ເກີດ​ລູກຊາຍ​ອີກ​ຊື່​ວ່າ ຊາອາບ, ຜູ້​ທີ່​ເປັນ​ພໍ່​ຂອງ​ມາດມານນາ</para>
  <para style="li2" vid="1CH 2:49">ແລະ ໄດ້​ເກີດ​ເຊວາ​ຜູ້​ເປັນ​ພໍ່​ຂອງ​ມັກເບນາ ແລະ ກີເບອາ.</para>
  <para style="li1" vid="1CH 2:49">ລູກສາວ​ຂອງ​ກາເລັບ​ແມ່ນ​ອັກຊາ.<verse eid="1CH 2:49" /></para>
  <para style="lf">
    <verse number="50" style="v" sid="1CH 2:50" />ຄົນ​ເຫລົ່ານີ້​ເປັນ​ເຊື້ອສາຍ​ຂອງ​ກາເລັບ.</para>
  <para style="b" vid="1CH 2:50" />
  <para style="li1" vid="1CH 2:50">ລູກຊາຍ​ຂອງ​ຮູເຣ​ທີ່​ເປັນ​ລູກຊາຍ​ກົກ​ຂອງ​ນາງ​ເອຟຣັດ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:50">ໂຊບານ​ເປັນ​ພໍ່​ຂອງ​ກີຣີອາດ​ເຢອາຣີມ, <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />ສານມາ​ເປັນ​ພໍ່​ຂອງ​ເບັດເລເຮັມ ແລະ ຮາເຣັບ​ທີ່​ເປັນ​ພໍ່​ຂອງ​ເບັດກາເດ.<verse eid="1CH 2:51" /></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52" />ເຊື້ອສາຍ​ຂອງ​ໂຊບານ​ທີ່​ເປັນ​ພໍ່​ຂອງ​ກີຣີອາດ​ເຢອາຣີມ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:52">ຮາໂລເອ, ປະຊາຊົນ​ເຄິ່ງ​ໜຶ່ງ​ເປັນ​ຊາວ​ເມນູໂຮດ, <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />ແລະ ຕະກຸນ​ຕ່າງໆ​ຂອງ​ກີຣີອາດ​ເຢອາຣີມ​ມີ​ດັ່ງນີ້: ຊາວ​ອິດໄຣ, ປູທະ, ຊູມາ ແລະ ຊາວ​ມິດຊະຣາ. ຊາວ​ໂຊຣາ ແລະ ເອຊະຕາໂອນ​ສືບ​ເຊື້ອສາຍ​ມາ​ຈາກ​ຕະກຸນ​ເຫລົ່ານີ້.<verse eid="1CH 2:53" /></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54" />ເຊື້ອສາຍ​ຂອງ​ສານມາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 2:54">ເບັດເລເຮັມ, ຊາວ​ເນໂຕຟາ, ຊາວ​ອາໂຣດ​ເບັດ​ໂຢອາບ ແລະ ເຄິ່ງ​ໜຶ່ງ​ຂອງ​ຊາວ​ມານາຮາດ​ກັບ​ຊາວ​ໂຊເຣ. <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />ແລະ ຕະກຸນ​ຕ່າງໆ​ຂອງ​ບັນດາ​ຜູ້​ຊ່ຽວຊານ​ທາງ​ການ​ຂຽນ<note caller="+" style="f"><char style="fr" closed="false">2:55 </char><char style="ft" closed="false">ຫລື ຂອງ​ຊາວ​ໂຊເຟີ</char></note>​ທີ່​ອາໄສ​ຢູ່​ທີ່​ເມືອງ​ຢາເບດ​ມີ​ດັ່ງນີ້: ຊາວ​ຕີຣາດ, ຊີເມອາດ ແລະ ສູກາດ. ຄົນ​ເຫລົ່ານີ້​ເປັນ​ຊາວ​ເກນິດ​ທີ່​ມາ​ຈາກ​ຮາມມັດ, ເຊິ່ງ​ເປັນ​ຕົ້ນ​ຕະກຸນ​ຂອງ​ຊາວ​ເຣກາບ.<note caller="+" style="f"><char style="fr" closed="false">2:55 </char><char style="ft" closed="false">ຫລື ເປັນ​ພໍ່​ຂອງ </char><char style="fqa" closed="false">ເບັດເຣກາບ</char></note><verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s2">ລູກຊາຍ​ຂອງ​ດາວິດ</para>
  <para style="r">(2ຊມອ 3:2-5; 5:14-16; 1ຂຄ 14:4-7)</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 3:1" />ຄົນ​ເຫລົ່ານີ້​ເປັນ​ລູກຊາຍ​ຂອງ​ດາວິດ​ທີ່​ໄດ້​ເກີດ​ໃນ​ເມືອງ​ເຮັບໂຣນ​ມີ​ດັ່ງນີ້:</para>
  <para style="b" vid="1CH 3:1" />
  <para style="li1" vid="1CH 3:1">ລູກຊາຍ​ກົກ​ແມ່ນ​ອຳໂນນ​ທີ່​ເປັນ​ລູກຊາຍ​ຂອງ​ນາງ​ອາຮີໂນອາມ​ແຫ່ງ​ຢິດຊະເຣນ;</para>
  <para style="li1" vid="1CH 3:1">ຄົນ​ທີ​ສອງ​ຄື​ດານີເອນ, ເຊິ່ງ​ເປັນ​ລູກຊາຍ​ຂອງ​ນາງ​ອາບີກາຍ​ແຫ່ງ​ກາເມນ;<verse eid="1CH 3:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 3:2" />ຄົນ​ທີ​ສາມ​ຄື​ອັບຊາໂລມ, ເຊິ່ງ​ເປັນ​ລູກຊາຍ​ຂອງ​ນາງ​ມາອາກາ​ທີ່​ເປັນ​ລູກສາວ​ຂອງ​ກະສັດ​ຕານໄມ​ແຫ່ງ​ເມືອງ​ເກຊູ;</para>
  <para style="li1" vid="1CH 3:2">ຄົນ​ທີ​ສີ່​ຄື​ອາໂດນີຢາ, ເຊິ່ງ​ເປັນ​ລູກຊາຍ​ຂອງ​ນາງ​ຮັກກິດ;<verse eid="1CH 3:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 3:3" />ຄົນ​ທີ​ຫ້າ​ຄື​ເຊຟາຕີຢາ, ເຊິ່ງ​ເປັນ​ລູກຊາຍ​ຂອງ​ນາງ​ອາບີຕານ;</para>
  <para style="li1" vid="1CH 3:3">ແລະ ຄົນ​ທີ​ຫົກ​ຄື​ອິດທະເລອາມ, ເຊິ່ງ​ເປັນ​ລູກຊາຍ​ຂອງ​ນາງ​ເອັກລາ.<verse eid="1CH 3:3" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="4" style="v" sid="1CH 3:4" />ລູກຊາຍ​ຫົກ​ຄົນ​ເຫລົ່ານີ້​ໄດ້​ເກີດ​ຢູ່​ໃນ​ເມືອງ​ເຮັບໂຣນ, ເຊິ່ງ​ດາວິດ​ໄດ້​ຂຶ້ນ​ປົກຄອງ​ເປັນ​ເວລາ​ເຈັດ​ປີ ແລະ ຫົກ​ເດືອນ.</para>
  <para style="b" vid="1CH 3:4" />
  <para style="b" vid="1CH 3:4" />
  <para style="lh" vid="1CH 3:4">ດາວິດ​ໄດ້​ປົກຄອງ​ຢູ່​ໃນ​ນະຄອນ​ເຢຣູຊາເລັມ​ເປັນ​ເວລາ​ສາມ​ສິບ​ສາມ​ປີ, <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />ແລະ ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ລູກຊາຍ​ຂອງ​ເພິ່ນ​ທີ່​ໄດ້​ເກີດ​ຢູ່​ໃນ​ນະຄອນ​ເຢຣູຊາເລັມ​ມີ​ດັ່ງ​ນີ້:</para>
  <para style="b" vid="1CH 3:5" />
  <para style="li1" vid="1CH 3:5">ຊີເມອາ,<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ຊິ​ເມ​ອາ ເປັນ​ອີກ​ຮູບ​ໜຶ່ງ​ຂອງ ຊາມ​ມູອາ</char></note> ໂຊບັບ, ນາທານ ແລະ ໂຊໂລໂມນ. ລູກຊາຍ​ສີ່​ຄົນ​ນີ້​ໄດ້​ເກີດ​ມາ​ຈາກ​ນາງ​ບັດ​ເຊບາ<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">ສຳ​ເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ບັດ​ຊູອາ (ເບິ່ງ <char style="xt"><ref loc="2SA 11:3">2ຊມອ 11:3</ref></char>)</char></note>​ທີ່​ລູກສາວ​ຂອງ​ອາມມີເອນ.<verse eid="1CH 3:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 3:6" />ລູກຊາຍ​ຄົນ​ອື່ນໆ​ອີກ​ແມ່ນ​ອິບຮາ, ເອລີຊາມາ,<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">ສຳ​ເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ເອລີ​ຊາ​ມາ (ເບິ່ງ <char style="xt"><ref loc="2SA 5:15">2ຊມອ 5:15</ref></char> ແລະ <char style="xt"><ref loc="1CH 14:5">1ຂຄ 14:5</ref></char>)</char></note> ເອລີເຟເລັດ, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />ໂນຄາ, ເນເຟັກ, ຢາເຟຍ, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />ເອລີຊາມາ, ເອລີອາດາ ແລະ ເອລີເຟເລັດ, ເຊິ່ງ​ລວມ​ທັງໝົດ​ເກົ້າ​ຄົນ.<verse eid="1CH 3:8" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="9" style="v" sid="1CH 3:9" />ລາຍຊື່​ທັງໝົດ​ເຫລົ່ານີ້​ເປັນ​ລູກຊາຍ​ຂອງ​ດາວິດ, ບໍ່​ລວມ​ລູກຊາຍ​ຂອງ​ເພິ່ນ​ທີ່​ເກີດ​ມາ​ຈາກ​ເມຍນ້ອຍ​ຂອງ​ເພິ່ນ ແລະ ມີ​ລູກ​ສາວ​ຜູ້​ໜຶ່ງ​ອີກ​ຊື່​ວ່າ​ຕາມາ.<verse eid="1CH 3:9" /></para>
  <para style="s2">ບັນດາ​ກະສັດ​ແຫ່ງ​ຢູດາຍ</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10" />ລູກຊາຍ​ຂອງ​ໂຊໂລໂມນ​ແມ່ນ​ເຣໂຫໂບອາມ,</para>
  <para style="li1" vid="1CH 3:10">ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຄື​ອາບີຢາ,</para>
  <para style="li1" vid="1CH 3:10">ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຄື​ອາສາ,</para>
  <para style="li1" vid="1CH 3:10">ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຄື​ເຢໂຮຊາຟັດ,<verse eid="1CH 3:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 3:11" />ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຄື​ໂຢຣາມ,<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ໂຢຣາມ ເປັນ​ອີກ​ຮູບ​ໜຶ່ງ​ຂອງ ເຢ​ໂຮ​ຣາມ</char></note></para>
  <para style="li1" vid="1CH 3:11">ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຄື​ອາຮາຊີຢາ,</para>
  <para style="li1" vid="1CH 3:11">ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຄື​ໂຢອາດ,<verse eid="1CH 3:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 3:12" />ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຄື​ອາມາຊີຢາ,</para>
  <para style="li1" vid="1CH 3:12">ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຄື​ອາຊາຣີຢາ,</para>
  <para style="li1" vid="1CH 3:12">ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຄື​ໂຢທາມ,<verse eid="1CH 3:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 3:13" />ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຄື​ອາຮາດ,</para>
  <para style="li1" vid="1CH 3:13">ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຄື​ເຮເຊກີຢາ,</para>
  <para style="li1" vid="1CH 3:13">ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຄື​ມານາເຊ,<verse eid="1CH 3:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 3:14" />ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຄື​ອາໂມນ</para>
  <para style="li1" vid="1CH 3:14">ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຄື​ໂຢສີຢາ.<verse eid="1CH 3:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15" />ລູກຊາຍ​ຂອງ​ໂຢສີຢາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 3:15">ໂຢຮານັນ​ເປັນ​ລູກຊາຍ​ກົກ</para>
  <para style="li2" vid="1CH 3:15">ຄົນ​ທີ​ສອງ​ຄື​ເຢໂຮຍອາກິມ</para>
  <para style="li2" vid="1CH 3:15">ຄົນ​ທີ​ສາມ​ຄື​ເຊເດກີຢາ</para>
  <para style="li2" vid="1CH 3:15">ຄົນ​ທີ​ສີ່​ຄື​ຊໍລູມ<verse eid="1CH 3:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16" />ບັນດາ​ຜູ້​ທີ່​ເປັນ​ຜູ້ສືບທອດ​ແທນ​ເຢໂຮຍອາກິມ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 3:16">ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຄື​ເຢໂຮຍອາກິນ,<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ເຢ​ໂຄ​ນິ​ຢາ ເປັນ​ອີກ​ຮູບ​ໜຶ່ງ​ຂອງ ເຍໂຮຢາກິນ ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="1CH 3:17"><ref loc="1CH 3:17">17</ref></char></char></note> ເຊເດກີຢາ</para>
  <para style="li2" vid="1CH 3:16">ແລະ ເຊເດກີຢາ.<verse eid="1CH 3:16" /></para>
  <para style="s2">ຄອບຄົວ​ຂອງ​ກະສັດ​ຫລັງຈາກ​ຕົກ​ໄປ​ເປັນ​ຊະເລີຍ</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17" />ເຊື້ອສາຍ​ຂອງ​ເຢໂຮຍອາກິນ​ທີ່​ຖືກ​ຈັບ​ໄປ​ເປັນ​ຊະເລີຍ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 3:17">ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຄື​ເຊອານຕີເອນ, <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />ມານກີຣາມ, ເປດາອີຢາ, ເຊນັດຊາ, ເຢກາມີຢາ, ໂຮຊາມາ ແລະ ເນດາບີຢາ.<verse eid="1CH 3:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19" />ລູກຊາຍ​ຂອງ​ເປດາອີຢາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 3:19">ເຊຣຸບບາເບນ ແລະ ຊີເມອີ.</para>
  <para style="li1" vid="1CH 3:19">ລູກຊາຍ​ຂອງ​ເຊຣຸບບາເບນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 3:19">ເມຊູນລຳ ແລະ ຮານານີຢາ. ລູກສາວ​ຄົນ​ໜຶ່ງ​ຂອງ​ເພິ່ນ​ຄື​ເຊໂລມິດ. <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />ແລະ ເພິ່ນ​ກໍ​ຍັງ​ມີ​ລູກສາວ​ຄົນ​ອື່ນໆ​ອີກ​ດັ່ງ​ນີ້: ຮາຊູບາ, ໂອເຮນ, ເບເຣກີຢາ, ຮາສາດີຢາ ແລະ ຢູຊັບເຮເສັດ.<verse eid="1CH 3:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21" />ເຊື້ອສາຍ​ຂອງ​ຮານານີຢາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 3:21">ເປລາຕີຢາ ແລະ ເຢຊາອີຢາ, ແລະ ລູກຊາຍ​ຂອງ​ເຣຟາອີຢາ, ລາວ​ເປັນ​ພໍ່​ຂອງ​ອາກນັນ, ໂອບາດີຢາ ແລະ ເຊການີຢາ.<verse eid="1CH 3:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22" />ເຊື້ອສາຍ​ຂອງ​ເຊການີຢາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 3:22">ເຊມາອີຢາ ແລະ ລູກຊາຍ​ຂອງ​ລາວ​ມີ​ດັ່ງນີ້: ຮັດຕຸເຊ, ອີການ, ບາຣີຢາ, ເນອາຣີຢາ ແລະ ຊາຟັດ ລວມ​ທັງໝົດ​ມີ​ຫົກ​ຄົນ.<verse eid="1CH 3:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23" />ລູກຊາຍ​ຂອງ​ເນອາຣີຢາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 3:23">ເອລີໂອນາຍ, ເຮເຊກີຢາ ແລະ ອາຊະຣິກຳ ລວມ​ທັງໝົດ​ມີ​ສາມ​ຄົນ.<verse eid="1CH 3:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24" />ລູກຊາຍ​ຂອງ​ເອລີໂອນາຍ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 3:24">ໂຮດາວີຢາ, ເອລີອາຊິບ, ເປລາອີຢາ, ອັກກຸບ, ໂຢຮານານ, ເດລາອີຢາ ແລະ ອານານີ ລວມ​ທັງໝົດ​ມີ​ເຈັດ​ຄົນ.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s2">ຕະກຸນ​ອື່ນໆ​ຂອງ​ຢູດາ</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1" />ເຊື້ອສາຍ​ຂອງ​ຢູດາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 4:1">ເປເຣັດ, ເຮຊະໂຣນ, ການໝີ, ຮູເຣ ແລະ ໂຊບານ.<verse eid="1CH 4:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2" />ເຣອາອີຢາ​ລູກຊາຍ​ຂອງ​ໂຊບານ​ເປັນ​ພໍ່​ຂອງ​ຢາຮາດ, ແລະ ຢາຮາດ​ເປັນ​ພໍ່​ຂອງ​ອາຮູມາຍ ແລະ ລາຮາດ. ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ຕະກຸນ​ຂອງ​ຊາວ​ໂຊຣາ.<verse eid="1CH 4:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3" />ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ລູກຊາຍ<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ບິດາ</char></note>​ຂອງ​ເອຕາມ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 4:3">ຢິດຊະເຣນ, ອີຊະມາ ແລະ ອີດະບັດ. ແລະ ມີ​ລູກສາວ​ຜູ້​ໜຶ່ງ​ຊື່​ວ່າ ຮັດເຊເລນໂປນີ. <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" />ເປນູເອນ​ເປັນ​ພໍ່​ຂອງ​ເກໂດເຣ ແລະ ເອເຊ​ເປັນ​ພໍ່​ຂອງ​ຮູຊາ.</para>
  <para style="li1" vid="1CH 4:4">ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ເຊື້ອສາຍ​ຂອງ​ຮູເຣ, ເຊິ່ງ​ເປັນ​ລູກຊາຍ​ກົກ​ຂອງ​ນາງ​ເອຟຣັດ ແລະ ເປັນ​ພໍ່<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">ຄຳ​ວ່າ ບິດາ ອາດຈະ​ມີ​ຄວາມຫມາຍ​ວ່າ ຜູ້​ນຳ​ທາງ​ພົນລະ​ເມຶອງ ຫລື ຜູ້​ນຳ​ທາງ​ທະຫານ ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="1CH 4:12"><ref loc="1CH 4:12">12</ref></char>, <char style="xt" link-href="1CH 4:14"><ref loc="1CH 4:14">14</ref></char>, <char style="xt" link-href="1CH 4:17"><ref loc="1CH 4:17">17</ref></char>, <char style="xt" link-href="1CH 4:18"><ref loc="1CH 4:18">18</ref></char> ແລະ ອາດຈະ​ມີ​ຄວາມຫມາຍ​ຢ່າງ​ນີ້​ໃນ​ທີ່​ອື່ນໆ​ດ້ວຍ</char></note>​ຂອງ​ເບັດເລເຮັມ.<verse eid="1CH 4:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5" />ອາຊະຮູ​ເປັນ​ພໍ່​ຂອງ​ເຕກົວ​ທີ່​ມີ​ເມຍ​ສອງ​ຄົນ​ຄື ເຮລາ ແລະ ນາອາຣາ.<verse eid="1CH 4:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6" />ນາງ​ນາອາຣາ​ມີ​ລູກຊາຍ​ຄື ອາຮູດຊຳ, ເຮເຟ, ເຕເມນີ ແລະ ຮາຮັດສະຕາຣີ. ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ເຊື້ອສາຍ​ຂອງ​ນາງ​ນາອາຣາ.<verse eid="1CH 4:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7" />ລູກຊາຍ​ຂອງ​ນາງ​ເຮລາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 4:7">ເຊເຣດ, ອີຊະຮາດ ແລະ ເອັດນັນ. <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />ແລະ ໂກເຊ, ຜູ້​ທີ່​ເປັນ​ພໍ່​ຂອງ​ອານຸບ ແລະ ໂຊເບບາ ແລະ ເປັນ​ຕົ້ນ​ຕະກຸນ​ຕ່າງໆ​ຂອງ​ອາຮາເຮນ​ລູກຊາຍ​ຂອງ​ຮາຣູມ.<verse eid="1CH 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />ຢາເບດ​ເປັນ​ຜູ້​ທີ່​ໄດ້​ຮັບ​ຄວາມ​ນັບຖື​ຫລາຍກວ່າ​ອ້າຍ​ນ້ອງ​ຂອງ​ລາວ. ແມ່​ຂອງ​ລາວ​ຕັ້ງ​ຊື່​ໃຫ້​ລາວ​ວ່າ ຢາເບດ<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">ຄຳ​ວ່າ ຢາ​ເບດ ມີ​ສຽງ​ຄ້າຍ​ຄຳ​ພາສາ​ເຮັບເຣີ​ທີ່​ມີ​ຄວາມຫມາຍ​ວ່າ ເຈັບ​ປວດ</char></note> ເພາະ​ນາງ​ເວົ້າ​ວ່າ, “ເພາະ​ຂ້ອຍ​ໄດ້​ເກີດ​ລາວ​ອອກ​ມາ​ດ້ວຍ​ຄວາມ​ເຈັບປວດ”. <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />ຢາເບດ​ຮ້ອງ​ຫາ​ພຣະເຈົ້າ​ແຫ່ງ​ອິດສະຣາເອນ​ວ່າ, “ໂອ, ຂໍ​ພຣະອົງ​ອວຍພອນ​ຂ້ານ້ອຍ ແລະ ຂະຫຍາຍ​ເຂດແດນ​ຂອງ​ຂ້ານ້ອຍ! ຂໍ​ໃຫ້​ມື​ຂອງ​ພຣະອົງ​ຢູ່​ກັບ​ຂ້ານ້ອຍ, ແລະ ປົກປ້ອງ​ຂ້ານ້ອຍ​ຈາກ​ໄພ​ອັນຕະລາຍ​ເພື່ອ​ຂ້ານ້ອຍ​ຈະ​ພົ້ນ​ຈາກ​ຄວາມ​ເຈັບປວດ”. ແລ້ວ​ພຣະເຈົ້າ​ໄດ້​ປະທານ​ຕາມ​ຄໍາ​ຂໍ​ຂອງ​ລາວ.<verse eid="1CH 4:10" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11" />ເກລຸບ​ເປັນ​ອ້າຍ​ຂອງ​ຊູຮາ, ລາວ​ເປັນ​ພໍ່​ຂອງ​ເມຮີ, ຜູ້​ທີ່​ເປັນ​ພໍ່​ຂອງ​ເອຊະໂຕນ. <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />ເອຊະໂຕນ​ເປັນ​ພໍ່​ຂອງ​ເບັດຣາພາ, ປາເສຢາ ແລະ ເຕຮີນນາ. ເຊິ່ງ​ເປັນ​ພໍ່​ຂອງ​ເອີຣະ​ນາຮາດ.<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">ຫລື ເມືອງ​ຂອງ​ນາຮາດ</char></note> ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ຊາວ​ເມືອງ​ເຣກາ.<verse eid="1CH 4:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13" />ລູກຊາຍ​ຂອງ​ເກນາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 4:13">ໂອດນີເອນ ແລະ ເສຣາອີຢາ.</para>
  <para style="li1" vid="1CH 4:13">ລູກຊາຍ​ຂອງ​ໂອດ​ນີ​ເອນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 4:13">ຮາທັດ ແລະ ເມໂອໂນໄທ.<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ບໍ່​ມີວະລີ​ທີ່​ວ່າ ກັບ​ເມ​ໂອໂນ </char><char style="fqa" closed="false">ທາຍ</char></note> <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />ເມໂອໂນໄທ​ເປັນ​ພໍ່​ຂອງ​ໂອຟະຣາ.</para>
  <para style="li1" vid="1CH 4:14">ເສຣາອີຢາ​ເປັນ​ພໍ່​ຂອງ​ໂຢອາບ,</para>
  <para style="li2" vid="1CH 4:14">ພໍ່​ແຫ່ງ​ເກຮາຣາອິມ.<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="ft" closed="false">ແປ​ວ່າ ຮ່ອມພູ​ຊ່າງ​ຝີ​ມື</char></note> ທີ່​ໄດ້​ເອີ້ນ​ແບບ​ນີ້​ເພາະ​ປະຊາຊົນ​ຈໍານວນ​ຫລາຍ​ຂອງ​ເມືອງ​ເປັນ​ນາຍ​ຊ່າງສີມື.<verse eid="1CH 4:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15" />ລູກຊາຍ​ຂອງ​ກາເລັບ​ທີ່​ເປັນ​ລູກຊາຍ​ຂອງ​ເຢຟຸນເນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 4:15">ອີຣູ, ເອລາ ແລະ ນາອາມ.</para>
  <para style="li1" vid="1CH 4:15">ລູກຊາຍ​ຂອງ​ເອລາ​ຄື:</para>
  <para style="li2" vid="1CH 4:15">ເກນາດ.<verse eid="1CH 4:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16" />ລູກຊາຍ​ຂອງ​ເຢຮັນເລເລນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 4:16">ສີເຟ, ຊີຟາ, ຕີຣີອາ ແລະ ອາສາເຣນ.<verse eid="1CH 4:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17" />ລູກຊາຍ​ຂອງ​ເອຊະຣາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 4:17">ເຢເທ, ເມເຣດ, ເອເຟ ແລະ ຢາໂລນ.</para>
  <para style="li1" vid="1CH 4:17">ເມຍ​ຄົນ​ໜຶ່ງ​ຂອງ​ເມເຣດ​ມີ​ລູກຊາຍ​ຄື ມີຣີອາມ ຊາມມາຍ ແລະ ອີຊະບາ, ອີຊະບາ​ເປັນ​ພໍ່​ຂອງ​ເອຊະເຕມົວ. <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />ເມຍ​ຂອງ​ເອຊະເຕມົວ​ມາ​ຈາກ​ເຜົ່າ​ຢູດາ​ມີ​ລູກຊາຍ​ຄື ເຢເຣັດ​ເປັນ​ພໍ່​ຂອງ​ເກໂດເຣ, ເຮເບ​ເປັນ​ພໍ່​ຂອງ​ໂຊໂກ ແລະ ເຢກູທິເອນ​ເປັນ​ພໍ່​ຂອງ​ຊາໂນອາ.</para>
  <para style="li1" vid="1CH 4:18">ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ບີ​ທີ​ຢາ​ລູກສາວ​ຂອງ​ຟາໂຣ, ເຊິ່ງ​ເມເຣດ​ໄດ້​ແຕ່ງງານ​ນໍາ.<verse eid="1CH 4:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19" />ລູກຊາຍ​ທີ່​ເກີດ​ມາ​ຈາກ​ເມຍ​ຂອງ​ໂຮດີຢາ, ເຊິ່ງ​ເປັນ​ນ້ອງສາວ​ຂອງ​ນາຮາມ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 4:19">ມີ​ລູກຊາຍ​ເປັນ​ຕົ້ນ​ຕະກຸນ​ແຫ່ງ​ເກອີລາ​ຂອງ​ຊາວ​ການມີ ແລະ ເປັນ​ຕົ້ນ​ຕະກຸນ​ແຫ່ງ​ເອຊະເຕມົວ​ຂອງ​ຊາວ​ມາອາກາດ.<verse eid="1CH 4:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20" />ລູກຊາຍ​ຂອງ​ຊີໂມນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 4:20">ອາມໂນນ, ຣິນນາ, ເບນຮານານ ແລະ ຕີໂລນ.</para>
  <para style="li1" vid="1CH 4:20">ເຊື້ອສາຍ​ຂອງ​ອີຊີ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 4:20">ໂຊເຮັດ ແລະ ເບນໂຊເຫັດ.<verse eid="1CH 4:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21" />ເຊລາ​ເປັນ​ລູກຊາຍ​ຂອງ​ຢູດາ​ມີ​ລູກຊາຍ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 4:21">ເອຣະ​ເປັນ​ພໍ່​ຂອງ​ເລກາ, ລາອາດາ​ເປັນ​ພໍ່​ຂອງ​ມາເຣຊາ ແລະ ເປັນ​ຕະກຸນ​ຂອງ​ຊ່າງ​ຜ້າຝ້າຍ​ລິນິນ​ຢູ່​ທີ່​ເມືອງ​ເບັດອາຊະເບອາ,<verse eid="1CH 4:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 4:22" />ໂຢກີມ, ປະຊາຊົນ​ຂອງ​ເມືອງ​ໂກເຊບາ, ໂຢອາດ ແລະ ສາຣາບ, ທີ່​ໄດ້​ປົກຄອງ​ໃນ​ໂມອາບ ແລະ ຢາຊູບິເລເຮັມ (ການ​ບັນທຶກ​ເຫລົ່ານີ້​ແມ່ນ​ໄດ້​ມາ​ຈາກ​ສະໄໝ​ບູຮານ). <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />ພວກເຂົາ​ເປັນ​ຊ່າງ​ປັ້ນ​ໝໍ້​ທີ່​ອາໄສ​ຢູ່​ທີ່​ເມືອງ​ເນຕາອີມ ແລະ ເກເດຣາ; ພວກເຂົາ​ໄດ້​ອາໄສ​ຢູ່​ທີ່​ນັ້ນ ແລະ ໄດ້​ເຮັດວຽກ​ໃຫ້​ກະສັດ.<verse eid="1CH 4:23" /></para>
  <para style="s1">ເຊື້ອສາຍ​ຂອງ​ຊີເມໂອນ</para>
  <para style="r">(ຢຊ 19:2-10)</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24" />ເຊື້ອສາຍ​ຂອງ​ຊີເມໂອນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 4:24">ເນມູເອນ, ຢາມິນ, ຢາຣິບ, ເຊຣາ ແລະ ຊາອູນ;<verse eid="1CH 4:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25" />ລູກຊາຍ​ຂອງ​ຊາອູນ​ແມ່ນ​ຊໍລູມ, ລູກຊາຍ​ຂອງ​ຊໍລູມ​ແມ່ນ​ມິບຊາມ ແລະ ເຫລັນ​ຂອງ​ລາວ​ແມ່ນ​ມິຊະມາ.<verse eid="1CH 4:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26" />ເຊື້ອສາຍ​ຂອງ​ມິຊະມາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 4:26">ຮາມມູເອນ, ຊັກກູເຣ ແລະ ຊີເມອີ.<verse eid="1CH 4:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27" />ຊີເມອີ​ມີ​ລູກຊາຍ​ສິບ​ຫົກ​ຄົນ ແລະ ມີ​ລູກສາວ​ຫົກ​ຄົນ, ແຕ່​ອ້າຍ​ນ້ອງ​ຂອງ​ລາວ​ມີ​ລູກ​ບໍ່​ຫລາຍ​ຄົນ; ດັ່ງນັ້ນ​ຕະກຸນ​ຂອງ​ພວກເຂົາ​ທັງໝົດ​ຈຶ່ງ​ມີ​ຈຳນວນ​ຄົນ​ບໍ່​ຫລາຍ​ເໝືອນດັ່ງ​ຊາວ​ຢູດາ. <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />ພວກເຂົາ​ໄດ້​ອາໄສ​ຢູ່​ທີ່​ເມືອງ​ເບເອນເຊບາ, ໂມລາດາ, ຮາຊາຊູອານ, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />ບິນຮາ, ເອເສມ, ໂຕລາດ, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />ເບທູເອນ, ໂຮມາ, ຊິກລັກ, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />ເບັດມັກກາໂບດ, ຮາຊາສູສິມ, ເບັດບີຣີ ແລະ ຊາອາຣາອິມ. ເມືອງ​ເຫລົ່ານີ້​ເປັນ​ຂອງ​ພວກເຂົາ​ຈົນ​ເຖິງ​ໄລຍະ​ການ​ປົກຄອງ​ຂອງ​ດາວິດ. <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />ໝູ່ບ້ານ​ອ້ອມແອ້ມ​ຂອງ​ພວກເຂົາ​ມີ​ດັ່ງນີ້: ເອຕາມ, ອາອິນ, ຣິມໂມນ, ໂຕເກນ ແລະ ອາຊານ, ລວມ​ທັງໝົດ​ມີ​ຫ້າ​ເມືອງ. <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />ແລະ ບ້ານ​ທັງໝົດ​ທີ່​ຢູ່​ອ້ອມແອ້ມ​ເມືອງ​ເຫລົ່ານີ້​ໄກ​ອອກ​ໄປ​ຈົນ​ເຖິງ​ເມືອງ​ບາອາລາດ.<note caller="+" style="f"><char style="fr" closed="false">4:33 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ບາອານ (ເບິ່ງ <char style="xt"><ref loc="JOS 19:8">ຢຊ 19:8</ref></char>)</char></note> ບ່ອນ​ຕ່າງໆ​ເຫລົ່ານີ້​ເປັນ​ບ່ອນ​ທີ່​ພວກເຂົາ​ຕັ້ງ​ຖິ່ນຖານ​ຢູ່.</para>
  <para style="b" vid="1CH 4:33" />
  <para style="lh" vid="1CH 4:33">ແລະ ພວກເຂົາ​ໄດ້​ເກັບ​ຮັກສາ​ການ​ບັນທຶກ​ລໍາດັບ​ເຊື້ອສາຍ​ໄວ້​ດັ່ງນີ້:<verse eid="1CH 4:33" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="34" style="v" sid="1CH 4:34" />ເມໂຊບັບ, ຢາມເລັກ,</para>
  <para style="li1" vid="1CH 4:34">ໂຢຊາ​ເປັນ​ລູກຊາຍ​ຂອງ​ອາມາຊີຢາ, <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />ໂຢເອນ,</para>
  <para style="li1" vid="1CH 4:35">ເຢຮູ​ເປັນ​ລູກຊາຍ​ຂອງ​ໂຢຊີບີຢາ, ຫລານຊາຍ​ຂອງ​ເສຣາອີຢາ, ເຫລັນ​ຂອງ​ອາສີເອນ;<verse eid="1CH 4:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 4:36" />ຍັງ​ມີ​ເອລີໂອນາຍ; ຢາອາໂກບາດ; ເຢໂຊຮາອີຢາ;</para>
  <para style="li1" vid="1CH 4:36">ອາສາອີຢາ; ອາດີເອນ; ເຢສີມີເອນ; ເບນາອີຢາ;<verse eid="1CH 4:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 4:37" />ແລະ ຊີຊາ​ເປັນ​ລູກຊາຍ​ຂອງ​ຊິບຟີ, ຫລານຊາຍ​ຂອງ​ອັນໂລນ, ລູກຊາຍ​ຂອງ​ເຢດາອີຢາ, ເຢດາອີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ຊິມຣີ, ຫລານຊາຍ​ຂອງ​ເຊມາອີຢາ.<verse eid="1CH 4:37" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="38" style="v" sid="1CH 4:38" />ລາຍຊື່​ຄົນ​ທີ່​ຢູ່​ເທິງ​ນີ້​ແມ່ນ​ຜູ້ນຳ​ຂອງ​ຕະກຸນ.</para>
  <para style="b" vid="1CH 4:38" />
  <para style="p" vid="1CH 4:38">ຄອບຄົວ​ຂອງ​ພວກເຂົາ​ເພີ່ມ​ຂຶ້ນ​ຫລາຍ, <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />ແລະ ພວກເຂົາ​ໄດ້​ຂະຫຍາຍ​ອອກ​ໄປ​ທີ່​ເກໂດເຣ​ຈົນ​ເຖິງ​ທາງ​ຕາເວັນອອກ​ຂອງ​ຮ່ອມພູ​ເພື່ອ​ຊອກຫາ​ທົ່ງຫຍ້າ​ສຳລັບ​ຝູງແກະ​ຂອງ​ພວກເຂົາ. <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />ພວກເຂົາ​ໄດ້​ພົບ​ທົ່ງຫຍ້າ​ທີ່​ອຸດົມສົມບູນ ແລະ ດິນແດນ​ກໍ​ກວ້າງຂວາງ, ສະຫງົບສຸກ ແລະ ງຽບ​ສະຫງົບ. ມີ​ເຊື້ອສາຍ​ຂອງ​ຊາວ​ຮາມ​ບາງຄົນ​ໄດ້​ອາໄສ​ຢູ່​ທີ່​ນັ້ນ​ມາ​ກ່ອນ.<verse eid="1CH 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41" />ໃນ​ສະໄໝ​ຂອງ​ກະສັດ​ເຮເຊກີຢາ​ແຫ່ງ​ອານາຈັກ​ຢູດາຍ ພວກ​ຜູ້ຊາຍ​ທີ່​ມີ​ລາຍຊື່​ບັນທຶກ​ໄວ້. ພວກເຂົາ​ໄດ້​ໂຈມຕີ​ທີ່ຢູ່​ອາໄສ​ຂອງ​ຊາວ​ຮາມ ແລະ ຊາວ​ເມອູນີ​ທີ່​ອາໄສ​ຢູ່​ທີ່ນັ້ນ​ດ້ວຍ ແລະ ໄດ້​ທໍາລາຍ<note caller="+" style="f"><char style="fr" closed="false">4:41 </char><char style="ft" closed="false">ຄຳ​ນີ້​ໃນ​ພາສາ​ເຮັບເຣີ​ໝາຍ​ເຖິງ ສິ່ງ​ຂອງ ຫລື ບຸກ​ຄົນ​ທີ່​ຖວາຍ​ແດ່​ອົງພຣະຜູ້ເປັນເຈົ້າ​ແລ້ວ ບໍ່​ອາດ​ເອີ້ນຄືນ​ໄດ້ ມັກ​ຈະ​ຕ້ອງ​ທຳລາຍ​ໃຫ້​ໝົດ​ສິ້ນ​ໄປ</char></note> ພວກເຂົາ​ຈົນ​ໝົດ​ສິ້ນ. ດັ່ງ​ທີ່​ເຫັນ​ຢ່າງ​ຊັດເຈນ​ຈົນ​ເຖິງ​ທຸກ​ວັນນີ້. ພວກເຂົາ​ໄດ້​ຕັ້ງ​ຖິ່ນຖານ​ຂອງ​ຕົນ​ໃສ່​ແທນ​ເພາະ​ມີ​ທົ່ງຫຍ້າ​ສຳລັບ​ຝູງແກະ​ຂອງ​ພວກເຂົາ. <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />ແລະ ມີ​ຊາວ​ຊີເມໂອນ​ຫ້າ​ຮ້ອຍ​ຄົນ, ທີ່​ນຳ​ໂດຍ​ເປລາຕີຢາ, ເນອາຣີຢາ, ເຣຟາອີຢາ ແລະ ອຸດສິເອນ, ເຊິ່ງ​ເປັນ​ລູກຊາຍ​ຂອງ​ອີຊີ, ພວກເຂົາ​ໄດ້​ພາກັນ​ບຸກລຸກ​ເນີນພູ​ເສອີ. <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />ພວກເຂົາ​ໄດ້​ຂ້າ​ຊາວ​ອາມາເຫລັກ​ທີ່​ຍັງ​ເຫລືອ​ຢູ່, ແລະ ພວກເຂົາ​ກໍ​ໄດ້​ອາໄສ​ຢູ່​ທີ່​ນັ້ນ​ຈົນ​ເຖິງ​ທຸກ​ວັນນີ້.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s1">ເຊື້ອສາຍ​ຂອງ​ຣູເບັນ</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 5:1" />ຣູເບັນ​ເປັນ​ລູກຊາຍ​ກົກ​ຂອງ​ອິດສະຣາເອນ (ລາວ​ເປັນ​ລູກຊາຍ​ກົກ, ແຕ່​ເມື່ອ​ລາວ​ເຮັດ​ໃຫ້​ຕຽງ​ແຕ່ງງານ​ຂອງ​ພໍ່​ຕົນ​ເປັນ​ມົນທິນ, ສິດ​ການ​ເປັນ​ລູກຊາຍ​ກົກ​ຂອງ​ລາວ​ຈຶ່ງ​ໄດ້​ຖືກ​ມອບ​ໃຫ້​ແກ່​ໂຢເຊບ​ທີ່​ເປັນ​ລູກຊາຍ​ຂອງ​ອິດສະຣາເອນ. ດັ່ງນັ້ນ ລາວ​ຈຶ່ງ​ບໍ່​ມີ​ລາຍຊື່​ຢູ່​ໃນ​ການ​ບັນທຶກ​ລຳດັບ​ຕະກຸນ​ຕາມສິດ​ໃນ​ຖານະ​ເປັນ​ລູກຊາຍ​ກົກ. <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />ໂຢເຊັບ​ໄດ້​ຮັບ​ສິດ​ເປັນ​ລູກຊາຍ​ກົກ ເຖິງແມ່ນວ່າ​ຢູດາ​ເປັນ​ຕະກຸນ​ທີ່​ເຂັ້ມແຂງ​ທີ່ສຸດ​ໃນ​ບັນດາ​ພີ່ນ້ອງ​ຂອງ​ຕົນ ແລະ ຈະ​ມີ​ຜູ້ປົກຄອງ​ຄົນ​ໜຶ່ງ​ອອກ​ມາ​ຈາກ​ຢູດາ) <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />ລູກຊາຍ​ຂອງ​ຣູເບັນ​ທີ່​ເປັນ​ລູກຊາຍ​ກົກ​ຂອງ​ອິດສະຣາເອນ​ມີ​ດັ່ງ​ນີ້:</para>
  <para style="b" vid="1CH 5:3" />
  <para style="li2" vid="1CH 5:3">ຮານົກ, ປານລູ, ເຮຊະໂຣນ ແລະ ການໝີ.<verse eid="1CH 5:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4" />ເຊື້ອສາຍ​ຂອງ​ໂຢເອນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 5:4">ໂຢເອນ​ມີ​ລູກຊາຍ​ຄື​ເຊມາອີຢາ, ເຊມາອີຢາ​ມີ​ລູກ​ຄື​ໂກກ,</para>
  <para style="li2" vid="1CH 5:4">ໂກກ​ມີ​ລູກຊາຍ​ຄື​ຊີເມອີ, <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />ຊີເມອີ​ມີ​ລູກຊາຍ​ຄື​ມີກາ,</para>
  <para style="li2" vid="1CH 5:5">ມີກາ​ມີ​ລູກຊາຍ​ຄື​ເຣອາອີຢາ, ເຣອາອີຢາ​ມີ​ລູກຊາຍ​ຄື​ບາອານ.<verse eid="1CH 5:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6" />ແລະ ບາອານ​ມີ​ລູກຊາຍ​ຄື​ເບເອຣາ, ຜູ້ທີ່​ເປັນ​ຜູ້ນໍາ​ຂອງ​ຊາວ​ຣູເບັນ ເຊິ່ງ​ຕີກະລາດ​ປີເລເສ​ກະສັດ​ແຫ່ງ​ອັດຊີເຣຍ​ໄດ້​ຈັບ​ໄປ​ເປັນ​ຊະເລີຍ.<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ທິນກາດປິນເນເສີລ໌ ເປັນ​ອີກ​ຮູບ​ໜຶ່ງ​ຂອງ ທິກັດປິເລເສີລ໌ ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="1CH 5:26"><ref loc="1CH 5:26">26</ref></char></char></note><verse eid="1CH 5:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7" />ຍາດ​ພີ່ນ້ອງ​ຂອງ​ພວກເຂົາ​ຕາມ​ຕະກຸນ​ຕ່າງໆ​ທີ່​ໄດ້​ບັນທຶກ​ໃນ​ລຳດັບ​ວົງ​ຕະກຸນ​ຂອງ​ພວກເຂົາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 5:7">ເຢອີເອນ​ເປັນ​ຫົວໜ້າ, ເຊກາຣີຢາ <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />ແລະ ເບລາ​ເປັນ​ລູກຊາຍ​ຂອງ​ອາສາ, ອາສາ​ເປັນ​ລູກຊາຍ​ຂອງ​ເຊມາ, ເຊມາ​ເປັນ​ລູກຊາຍ​ຂອງ​ໂຢເອນ.</para>
  <para style="b" vid="1CH 5:8" />
  <para style="p" vid="1CH 5:8">ພວກເຂົາ​ໄດ້​ຕັ້ງ​ຖິ່ນຖານ​ຢູ່​ໃນ​ບໍລິເວນ​ຕັ້ງແຕ່​ອາໂຣເອ​ຈົນ​ເຖິງ​ເນໂບ ແລະ ບາອານເມໂອນ. <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />ທາງ​ທິດ​ຕາເວັນອອກ ພວກເຂົາ​ໄດ້​ຢຶດຄອງ​ດິນແດນ​ໄປ​ຈົນ​ເຖິງ​ແຄມ​ຖິ່ນ​ແຫ້ງແລ້ງ​ກັນດານ​ເລີຍ​ອອກ​ໄປ​ຈົນ​ຮອດ​ແມ່ນໍ້າ​ເອີຟຣັດ, ເພາະ​ຝູງສັດ​ໄດ້​ເພີ່ມ​ຂຶ້ນ​ໃນ​ດິນແດນ​ກີເລອາດ.<verse eid="1CH 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10" />ໃນ​ສະໄໝ​ການ​ປົກຄອງ​ຂອງ​ໂຊນ​ພວກເຂົາ​ໄດ້​ເຮັດ​ເສິກ​ຕໍ່ສູ້​ກັບ​ຊາວ​ຮັກກິດ, ເຊິ່ງ​ກໍ​ໄດ້​ເອົາ​ໄຊຊະນະ​ດ້ວຍ​ມື​ຂອງ​ພວກເຂົາ​ເອງ; ພວກເຂົາ​ໄດ້​ຢຶດຄອງ​ບ່ອນ​ຢູ່​ອາໄສ​ຂອງ​ຊາວ​ຮັກກິດ​ທັງໝົດ​ທົ່ວ​ຂົງເຂດ​ທາງ​ຕາເວັນອອກ​ຂອງ​ກີເລອາດ.<verse eid="1CH 5:10" /></para>
  <para style="s1">ເຊື້ອສາຍ​ຂອງ​ກາດ</para>
  <para style="lh">
    <verse number="11" style="v" sid="1CH 5:11" />ຊາວ​ກາດ​ໄດ້​ອາໄສ​ຢູ່​ຕໍ່​ຈາກ​ເຜົ່າ​ຣູເບັນ​ໃນ​ດິນແດນ​ບາຊານ​ທີ່​ໄກ​ອອກ​ໄປ​ຈົນ​ເຖິງ​ສາເລກາ​ຄື:<verse eid="1CH 5:11" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="12" style="v" sid="1CH 5:12" />ໂຢເອນ​ເປັນ​ຫົວໜ້າ, ຮອງ​ແມ່ນ​ຊາຟາມ, ແລ້ວ​ກໍ​ແມ່ນ​ຢານາຍ ແລະ ຊາຟັດ​ໃນ​ບາຊານ.<verse eid="1CH 5:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13" />ຍາດ​ພີ່ນ້ອງ​ຂອງ​ລາວ​ຕາມ​ຄອບຄົວ​ຕ່າງໆ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 5:13">ມີກາເອນ, ເມຊຸນລຳ, ເຊບາ, ໂຢຣາຍ, ຢາການ, ຊີອາ ແລະ ເອເບີ. ລວມ​ທັງໝົດ​ມີ​ເຈັດ​ຄົນ.<verse eid="1CH 5:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14" />ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ລູກຊາຍ​ຂອງ​ອາບີໄຮ​ເປັນ​ລູກຊາຍ​ຂອງ​ຮູຣິ, ຮູຣິ​ເປັນ​ລູກຊາຍ​ຂອງ​ຢາໂຣອາ, ຢາໂຣອາ​ເປັນ​ລູກຊາຍ​ຂອງ​ກີເລອາດ, ກີເລອາດ​ເປັນ​ລູກຊາຍ​ຂອງ​ມີກາເອນ, ມີກາເອນ​ເປັນ​ລູກຊາຍ​ຂອງ​ເຢຊີຊາຍ, ເຢຊີຊາຍ​ເປັນ​ລູກຊາຍ​ຂອງ​ຢາໂດ, ຢາໂດ​ເປັນ​ລູກຊາຍ​ຂອງ​ບູເຊ.<verse eid="1CH 5:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15" />ອາຮີ​ລູກຊາຍ​ຂອງ​ອັບດີເອນ, ອັບດີເອນ​ເປັນ​ລູກຊາຍ​ຂອງ​ກູນີ, ກູນີ​ເປັນ​ຫົວໜ້າ​ຄອບຄົວ​ຂອງ​ພວກເຂົາ.<verse eid="1CH 5:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="1CH 5:16" />ຊາວ​ກາດ​ອາໄສ​ຢູ່​ໃນ​ກີເລອາດ, ໃນ​ບາຊານ ແລະ ໝູ່ບ້ານ​ຕ່າງໆ​ທີ່​ຢູ່​ນອກ​ເມືອງ ແລະ ພວກເຂົາ​ໄດ້​ຂະຫຍາຍ​ອອກ​ໄປ​ໄກ​ຈົນ​ເຖິງ​ທົ່ງຫຍ້າ​ທັງໝົດ​ຂອງ​ຊາໂຣນ.<verse eid="1CH 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17" />ທັງໝົດ​ນີ້​ໄດ້​ຖືກ​ບັນທຶກ​ໃນ​ການ​ບັນທຶກ​ລຳດັບ​ວົງ​ຕະກຸນ​ໃນ​ຊ່ວງ​ການ​ປົກຄອງ​ຂອງ​ກະສັດ​ໂຢທາມ​ແຫ່ງ​ຢູດາຍ ແລະ ກະສັດ​ເຢໂຣໂບອາມ​ແຫ່ງ​ອິດສະຣາເອນ.<verse eid="1CH 5:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />ຊາວ​ຣູເບັນ ຊາວ​ກາດ ແລະ ຊາວ​ມານາເຊ​ເຄິ່ງ​ເຜົ່າ​ມີ​ກຳລັງ​ທະຫານ 44.760 ຄົນ​ທີ່​ພ້ອມ​ອອກ​ໄປ​ສູ້ຮົບ​ຄື​ເປັນ​ຜູ້ຊາຍ​ທີ່​ແຂງແຮງ​ທຸກຄົນ​ທີ່​ສາມາດ​ຖື​ໂລ່, ຈັບ​ດາບ, ເຊິ່ງ​ສາມາດ​ໃຊ້​ທະນູ​ໄດ້ ແລະ ໄດ້​ຮັບ​ການ​ຝຶກຝົນ​ເພື່ອ​ຮົບສູ້. <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />ພວກເຂົາ​ໄດ້​ເຮັດ​ເສິກ​ຕໍ່ສູ້​ກັບ​ຊາວ​ຮັກກິດ, ຊາວ​ເຢຕຸຣະ, ຊາວ​ນາຟີດ ແລະ ຊາວ​ໂນດາບ. <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />ພຣະເຈົ້າ​ໄດ້​ຊ່ວຍເຫລືອ​ພວກເຂົາ​ໃນ​ການ​ສູ້ຮົບ ແລະ ພຣະອົງ​ໄດ້​ມອບ​ຊາວ​ຮັກກິດ ແລະ ພັນທະມິດ​ທັງໝົດ​ໄວ້​ໃນ​ມື​ຂອງ​ພວກເຂົາ. ເພາະ​ພວກເຂົາ​ໄດ້​ອະທິຖານ​ຂໍ​ຕໍ່​ພຣະອົງ​ໃນ​ໄລຍະ​ທີ່​ສູ້ຮົບ​ຢູ່. ພຣະອົງ​ໄດ້​ຕອບ​ຄຳ​ອະທິຖານ​ຂອງ​ພວກເຂົາ, ເພາະ​ພວກເຂົາ​ໄດ້​ໄວ້ວາງໃຈ​ໃນ​ພຣະອົງ. <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />ພວກເຂົາ​ໄດ້​ຢຶດ​ເອົາ​ຝູງສັດ​ມາ​ຈາກ​ຊາວ​ຮັກກິດ​ມີ​ດັ່ງນີ້: ອູດ​ຫ້າສິບພັນ​ໂຕ, ແກະ​ສອງຮ້ອຍ​ຫ້າ​ສິບ​ພັນ​ໂຕ ແລະ ລໍ​ສອງ​ພັນ​ໂຕ. ພວກເຂົາ​ຍັງ​ໄດ້​ຈັບ​ຊະເລີຍ​ອີກ​ໜຶ່ງ​ແສນ​ຄົນ. <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />ແລະ ໄດ້​ຂ້າ​ສັດຕູ​ຄົນ​ອື່ນໆ​ຢ່າງ​ຫລວງຫລາຍ, ເພາະ​ການ​ສູ້ຮົບ​ຄັ້ງ​ນີ້​ເປັນ​ຂອງ​ພຣະເຈົ້າ. ແລະ ພວກເຂົາ​ກໍ​ໄດ້​ຄອບຄອງ​ດິນແດນ​ຈົນ​ຖືກ​ກວດ​ໄປ​ເປັນ​ຊະເລີຍ.<verse eid="1CH 5:22" /></para>
  <para style="s1">ເຊື້ອສາຍ​ຂອງ​ມານາເຊ​ເຄິ່ງ​ເຜົ່າ</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />ປະຊາຊົນ​ຂອງ​ມານາເຊ​ເຄິ່ງ​ເຜົ່າ​ມີ​ຈໍານວນ​ຫລວງຫລາຍ; ພວກເຂົາ​ໄດ້​ຕັ້ງ​ຖິ່ນຖານ​ຢູ່​ໃນ​ດິນແດນ​ຕັ້ງແຕ່​ບາຊານ​ຈົນ​ເຖິງ​ບາອານເຮີໂມນ, ນັ້ນ​ຄື​ເສນີ (ພູເຂົາ​ເຮີໂມນ).<verse eid="1CH 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 5:24" />ຫົວໜ້າ​ຄອບຄົວ​ຂອງ​ພວກເຂົາ​ມີ​ດັ່ງນີ້: ເອເຟ, ອີຊີ, ເອລີເອນ, ອາຊະຣິເອນ, ເຢເຣມີຢາ, ໂຮດາວີຢາ ແລະ ຢາດີເອນ. ພວກເຂົາ​ເປັນ​ນັກຮົບ​ທີ່​ກ້າຫານ, ມີ​ຊື່ສຽງ ແລະ ເປັນ​ຜູ້ນຳ​ຄອບຄົວ. <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />ແຕ່​ພວກເຂົາ​ໄດ້​ບໍ່​ສັດຊື່​ຕໍ່​ພຣະເຈົ້າ​ຂອງ​ບັນພະບຸລຸດ​ຂອງ​ພວກເຂົາ ແລະ ໄດ້​ກາບໄຫວ້​ບັນດາ​ພະ​ຂອງ​ປະຊາຊົນ​ໃນ​ດິນແດນ​ນັ້ນ, ເຊິ່ງ​ພຣະເຈົ້າ​ໄດ້​ທຳລາຍ​ຕໍ່ໜ້າ​ພວກເຂົາ. <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />ສະນັ້ນ​ພຣະເຈົ້າ​ແຫ່ງ​ອິດສະຣາເອນ​ໄດ້​ເຮັດ​ໃຫ້​ກະສັດ​ປູນ​ແຫ່ງ​ອັດຊີເຣຍ (ຄື​ຕີກະລາດ​ປີເລເສ), ຈັບ​ຊາວ​ຣູເບັນ, ຊາວ​ກາດ, ຊາວ​ມານາເຊ​ເຄິ່ງເຜົ່າ​ຕາເວັນອອກ​ໄປ​ເປັນ​ຊະເລີຍ. ເພິ່ນ​ໄດ້​ຈັບ​ພວກເຂົາ​ໄປ​ທີ່​ຮາລາ, ຮາໂບ, ຮາຣາ ແລະ ແມ່ນໍ້າ​ໂກຊານ, ເຊິ່ງ​ເປັນ​ບ່ອນ​ທີ່​ພວກເຂົາ​ໄດ້​ອາໄສ​ຢູ່​ຈົນ​ເຖິງ​ທຸກ​ວັນນີ້.<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s1">ເຊື້ອສາຍ​ຂອງ​ເລວີ</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 6:1" />ພວກລູກຊາຍ​ຂອງ​ເລວີ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:1">ເກໂຊນ, ໂກຮາດ ແລະ ເມຣາຣິ.<verse eid="1CH 6:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2" />ລູກຊາຍ​ຂອງ​ໂກຮາດ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:2">ອຳຣາມ, ອີຊະຮາດ, ເຮັບໂຣນ ແລະ ອຸດຊີເອນ.<verse eid="1CH 6:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3" />ລູກຊາຍ​ຂອງ​ອຳຣາມ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:3">ອາໂຣນ ແລະ ໂມເຊ ແລະ ມີຣີອາມ.</para>
  <para style="li1" vid="1CH 6:3">ລູກຊາຍ​ຂອງ​ອາໂຣນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:3">ນາດາບ, ອາບີຮູ, ເອເລອາຊາ ແລະ ອີທາມາ.<verse eid="1CH 6:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4" />ເອເລອາຊາ​ເປັນ​ພໍ່​ຂອງ​ຟີເນຮາ,</para>
  <para style="li2" vid="1CH 6:4">ຟີເນຮາ​ເປັນ​ພໍ່​ຂອງ​ອາບີຊູອາ,<verse eid="1CH 6:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5" />ອາບີຊູອາ​ເປັນ​ພໍ່​ຂອງ​ບຸກກີ,</para>
  <para style="li2" vid="1CH 6:5">ບຸກກີ​ເປັນ​ພໍ່​ຂອງ​ອຸດຊີ,<verse eid="1CH 6:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6" />ອຸດຊີ​ເປັນ​ພໍ່​ຂອງ​ເຊຣາຮີຢາ,</para>
  <para style="li2" vid="1CH 6:6">ເຊຣາຮີຢາ​ເປັນ​ພໍ່​ຂອງ​ເມຣາອີໂຢດ,<verse eid="1CH 6:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7" />ເມຣາອີໂຢດ​ເປັນ​ພໍ່​ຂອງ​ອາມາຣີຢາ,</para>
  <para style="li2" vid="1CH 6:7">ອາມາຣີຢາ​ເປັນ​ພໍ່​ຂອງ​ອາຮີຕຸບ,<verse eid="1CH 6:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8" />ອາຮີຕຸບ​ເປັນ​ພໍ່​ຂອງ​ຊາດົກ,</para>
  <para style="li2" vid="1CH 6:8">ຊາດົກ​ເປັນ​ພໍ່​ຂອງ​ອາຮີມາອາດ,<verse eid="1CH 6:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9" />ອາຮີມາອາດ​ເປັນ​ພໍ່​ຂອງ​ອາຊາຣີຢາ,</para>
  <para style="li2" vid="1CH 6:9">ອາຊາຣີຢາ​ເປັນ​ພໍ່​ຂອງ​ໂຢຮານານ,<verse eid="1CH 6:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10" />ໂຢຮານານ​ເປັນ​ພໍ່​ຂອງ​ອາຊາຣີຢາ.</para>
  <para style="li2" vid="1CH 6:10">ຜູ້​ທີ່​ໄດ້​ຮັບໃຊ້​ເປັນ​ປະໂລຫິດ​ໃນ​ວິຫານ​ທີ່​ໂຊໂລໂມນ​ສ້າງ​ຂຶ້ນ​ໃນ​ນະຄອນ​ເຢຣູຊາເລັມ.<verse eid="1CH 6:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11" />ອາຊາຣີຢາ​ເປັນ​ພໍ່​ຂອງ​ອາມາຣີຢາ,</para>
  <para style="li2" vid="1CH 6:11">ອາມາຣີຢາ​ເປັນ​ພໍ່​ຂອງ​ອາຮີຕຸບ,<verse eid="1CH 6:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12" />ອາຮີຕຸບ​ເປັນ​ພໍ່​ຂອງ​ຊາດົກ,</para>
  <para style="li2" vid="1CH 6:12">ຊາດົກ​ເປັນ​ພໍ່​ຂອງ​ຊໍລູມ,<verse eid="1CH 6:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13" />ຊໍລູມ​ເປັນ​ພໍ່​ຂອງ​ຮິນກີຢາ,</para>
  <para style="li2" vid="1CH 6:13">ຮິນກີຢາ​ເປັນ​ພໍ່​ຂອງ​ອາຊາຣີຢາ,<verse eid="1CH 6:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14" />ອາຊາຣີຢາ​ເປັນ​ພໍ່​ຂອງ​ເສຣາອີຢາ,</para>
  <para style="li2" vid="1CH 6:14">ແລະ ເສຣາອີຢາ​ເປັນ​ພໍ່​ຂອງ​ເຢໂຮຊາດັກ.<verse eid="1CH 6:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 6:15" />ເຢໂຮຊາດັກ​ຖືກ​ຈັບ​ໄປ​ເປັນ​ຊະເລີຍ ເມື່ອ​ພຣະເຈົ້າຢາເວ​ໄດ້​ສົ່ງ​ປະຊາຊົນ​ຢູດາຍ ແລະ ປະຊາຊົນ​ເຢຣູຊາເລັມ​ໄປ​ເປັນ​ຊະເລີຍ​ໂດຍ​ມື​ຂອງ​ເນບູກາດເນັດຊາ.<verse eid="1CH 6:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16" />ລູກຊາຍ​ຂອງ​ເລວີ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:16">ເກໂຊນ,<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ເກໂຊມ ເປັນ​ອີກ​ຮູບ​ໜຶ່ງ​ຂອງ ເກໂຊນ ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="1CH 6:17"><ref loc="1CH 6:17">17</ref></char>, <char style="xt" link-href="1CH 6:20"><ref loc="1CH 6:20">20</ref></char>, <char style="xt" link-href="1CH 6:43"><ref loc="1CH 6:43">43</ref></char>, <char style="xt" link-href="1CH 6:62"><ref loc="1CH 6:62">62</ref></char> ແລະ <char style="xt" link-href="1CH 6:71"><ref loc="1CH 6:71">71</ref></char></char></note> ໂກຮາດ ແລະ ເມຣາຣິ.<verse eid="1CH 6:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17" />ລາຍຊື່​ເຫລົ່ານີ້​ແມ່ນ​ລູກຊາຍ​ຂອງ​ເກໂຊນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:17">ລິບນີ ແລະ ຊີເມອີ.<verse eid="1CH 6:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18" />ລູກຊາຍ​ຂອງ​ໂກຮາດ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:18">ອຳຣາມ, ອີຊະຮາດ, ເຮັບໂຣນ ແລະ ອຸດຊີເອນ.<verse eid="1CH 6:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19" />ລູກຊາຍ​ຂອງ​ເມຣາຣິ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:19">ມາຮະລີ ແລະ ມູຊີ.</para>
  <para style="b" vid="1CH 6:19" />
  <para style="lh" vid="1CH 6:19">ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ຕະກຸນ​ຕ່າງໆ​ຂອງ​ເລວີ​ທີ່​ໄດ້​ຈັດລຳ​ດັບ​ຕາມ​ຕົ້ນ​ຕະກຸນ​ຂອງ​ພວກເຂົາ​ມີ​ດັ່ງນີ້:<verse eid="1CH 6:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20" />ເຊື້ອສາຍ​ຂອງ​ເກໂຊນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:20">ລູກຊາຍ​ຂອງ​ລິບນີ​ແມ່ນ​ຢາຮາດ,</para>
  <para style="li2" vid="1CH 6:20">ລູກຊາຍ​ຂອງ​ຢາຮາດ​ແມ່ນ​ຊິມມາ, <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />ລູກຊາຍ​ຂອງ​ຊິມມາ​ແມ່ນ​ໂຢອາ,</para>
  <para style="li2" vid="1CH 6:21">ລູກຊາຍ​ຂອງ​ໂຢອາ​ແມ່ນ​ອິດໂດ,</para>
  <para style="li2" vid="1CH 6:21">ລູກຊາຍ​ຂອງ​ອິດໂດ​ແມ່ນ​ເຊຣາ, ແລະ ລູກຊາຍ​ຂອງ​ເຊຣາ​ແມ່ນ​ເຢອາເທຣາຍ.<verse eid="1CH 6:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22" />ເຊື້ອສາຍ​ຂອງ​ໂກຮາດ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:22">ລູກຊາຍ​ຂອງ​ໂກຮາດ​ແມ່ນ​ອຳມີນາດາບ, ລູກຊາຍ​ຂອງ​ອຳມີນາດາບ​ແມ່ນ​ໂກຣາ,</para>
  <para style="li2" vid="1CH 6:22">ລູກຊາຍ​ຂອງ​ໂກຣາ​ແມ່ນ​ອັດຊີເຣ, <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />ລູກຊາຍ​ຂອງ​ອັດຊີເຣ​ແມ່ນ​ເອນການາ,</para>
  <para style="li2" vid="1CH 6:23">ລູກຊາຍ​ຂອງ​ເອນການາ​ແມ່ນ​ເອບີອາສັບ, ລູກຊາຍ​ຂອງ​ເອບີອາສັບ​ແມ່ນ​ອັດຊີເລ,<verse eid="1CH 6:23" /></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24" />ລູກຊາຍ​ຂອງ​ອັດຊີເຣ​ແມ່ນ​ຕາຮາດ, ລູກຊາຍ​ຂອງ​ຕາຮາດ​ແມ່ນ​ອູຣິເອນ,</para>
  <para style="li2" vid="1CH 6:24">ລູກຊາຍ​ຂອງ​ອູຣິເອນ​ແມ່ນ​ອຸດຊີອາ, ລູກຊາຍ​ຂອງ​ອຸດຊີຢາ​ແມ່ນ​ຊາອູນ.<verse eid="1CH 6:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25" />ເຊື້ອສາຍ​ຂອງ​ເອນການາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:25">ອາມາໄສ ແລະ ອາຮີມົດ.<verse eid="1CH 6:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26" />ລູກຊາຍ​ຂອງ​ອາຮີມົດ​ແມ່ນ​ເອນການາ,<note caller="+" style="f"><char style="fr" closed="false">6:26 </char><char style="ft" closed="false">ສຳເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ອາຮີໂມດ </char><char style="fqa" closed="false"><char style="fv">26</char>​ແລະ ເອນການາ ບຸດ​ຂອງ​ເອນການາ ໄດ້​ແກ່</char></note> ລູກຊາຍ​ຂອງ​ເອນການາ​ແມ່ນ​ໂຊໄຟ,</para>
  <para style="li2" vid="1CH 6:26">ລູກຊາຍ​ຂອງ​ໂຊໄຟ​ແມ່ນ​ນາຮາດ, ລູກຊາຍ​ຂອງ​ນາຮາດ​ແມ່ນ​ເອລີອາບ <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />ລູກຊາຍ​ຂອງ​ເອລີອາບ​ແມ່ນ​ເຢໂຣຮາມ,</para>
  <para style="li2" vid="1CH 6:27">ລູກຊາຍ​ຂອງ​ເຢໂຣຮາມ​ແມ່ນ​ເອນການາ.</para>
  <para style="li2" vid="1CH 6:27">ແລະ ລູກຊາຍ​ຂອງ​ເອນການາ​ແມ່ນ​ຊາມູເອນ<note caller="+" style="f"><char style="fr" closed="false">6:27 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ບໍ່​ມີວະລີ​ທີ່​ວ່າ ເຊິ່ງ​ມີ​ບຸດ​ຄື​ຊາມູເອນ (ເບິ່ງ <char style="xt"><ref loc="1SA 1:19">1ຊມອ 1:19</ref>,<ref loc="1SA 1:20">20</ref></char> ແລະ <char style="xt"><ref loc="1CH 6:33">1ຂຄ 6:33</ref>,<ref loc="1CH 6:34">34</ref></char>)</char></note><verse eid="1CH 6:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28" />ລູກຊາຍ​ຂອງ​ຊາມູເອນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:28">ໂຢເອນ<note caller="+" style="f"><char style="fr" closed="false">6:28 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ບໍ່​ມີ​ຄຳ​ວ່າ ໂຢເອນ (ເບິ່ງ <char style="xt"><ref loc="1SA 8:2">1ຊມອ 8:2</ref></char> ແລະ <char style="xt"><ref loc="1CH 6:33">1ຂຄ 6:33</ref></char>)</char></note>​ເປັນ​ລູກຊາຍ​ກົກ</para>
  <para style="li2" vid="1CH 6:28">ແລະ ອາບີຢາ​ເປັນ​ລູກຊາຍ​ຄົນ​ທີ​ສອງ.<verse eid="1CH 6:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29" />ເຊື້ອສາຍ​ຂອງ​ເມຣາຣິ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:29">ລູກຊາຍ​ຂອງ​ມາຮະລີ​ແມ່ນ​ລີບນີ,</para>
  <para style="li2" vid="1CH 6:29">ລູກຊາຍ​ຂອງ​ລິບນີ​ແມ່ນ​ຊີເມອີ, ລູກຊາຍ​ຂອງ​ຊີເມອີ​ແມ່ນ​ອຸດຊາ,<verse eid="1CH 6:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30" />ລູກຊາຍ​ຂອງ​ອຸດຊາ​ແມ່ນ​ຊີເມອາ, ລູກຊາຍ​ຂອງ​ຊີເມອາ​ແມ່ນ​ຮັກກິຢາ,</para>
  <para style="li2" vid="1CH 6:30">ແລະ ລູກຊາຍ​ຂອງ​ຮັກກິຢາ​ແມ່ນ​ອາສາອີຢາ.<verse eid="1CH 6:30" /></para>
  <para style="s2">ນັກດົນຕີ​ປະຈຳ​ວິຫານ</para>
  <para style="r">(ຢຊ 21:4-39)</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ພວກ​ທີ່​ກະສັດ​ດາວິດ​ໃຫ້​ຮັບຜິດຊອບ​ດົນຕີ​ໃນ​ວິຫານ​ຂອງ​ອົງພຣະເຈົ້າ​ຢາເວ ຫລັງຈາກ​ທີ່​ໄດ້​ນຳ​ເອົາ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ມາ​ໄວ້​ຢູ່​ທີ່​ນັ້ນ. <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />ພວກເຂົາ​ເຮັດ​ໜ້າທີ່​ຫລິ້ນ​ດົນຕີ​ຢູ່​ດ້ານໜ້າ​ຫໍເຕັນ​ສັກສິດ, ເຕັນ​ບ່ອນ​ຊຸມນຸມ, ຈົນ​ກວ່າ​ໂຊໂລໂມນ​ໄດ້​ສ້າງ​ວິຫານ​ຂອງ​ພຣະເຈົ້າຢາເວ​ຢູ່​ໃນ​ນະຄອນ​ເຢຣູຊາເລັມ. ພວກເຂົາ​ປະຕິບັດ​ໜ້າທີ່​ຂອງ​ພວກເຂົາ​ຕາມ​ກົດລະບຽບ​ທີ່​ໄດ້​ຕັ້ງ​ໄວ້​ສໍາລັບ​ພວກເຂົາ.<verse eid="1CH 6:32" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="33" style="v" sid="1CH 6:33" />ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ຄົນ​ທີ່​ຮັບໃຊ້​ພ້ອມ​ກັບ​ລູກຊາຍ​ຂອງ​ພວກເຂົາ ມີ​ດັ່ງນີ້:</para>
  <para style="b" vid="1CH 6:33" />
  <para style="li1" vid="1CH 6:33">ຈາກ​ຕະກຸນ​ໂກຮາດ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:33">ເຮມານ​ເປັນ​ນັກດົນຕີ</para>
  <para style="li2" vid="1CH 6:33">ເຮມານ​ເປັນ​ລູກຊາຍ​ຂອງ​ໂຢເອນ, ໂຢເອນ​ເປັນ​ລູກຊາຍ​ຂອງ​ຊາມູເອນ,<verse eid="1CH 6:33" /></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34" />ຊາມູເອນ​ເປັນ​ລູກຊາຍ​ຂອງ​ເອນການາ, ເອນການາ​ເປັນ​ລູກຊາຍ​ຂອງ​ເຢໂຣຮາມ,</para>
  <para style="li2" vid="1CH 6:34">ເຢໂຣຮາມ​ເປັນ​ລູກຊາຍ​ຂອງ​ເອລີເອນ, ເອລີເອນ​ເປັນ​ເປັນ​ລູກຊາຍ​ຂອງ​ໂຕອາ,<verse eid="1CH 6:34" /></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35" />ໂຕອາ​ເປັນ​ລູກຊາຍ​ຂອງ​ສູເຟ, ສູເຟ​ເປັນ​ລູກຊາຍ​ຂອງ​ເອນການາ,</para>
  <para style="li2" vid="1CH 6:35">ເອນການາ​ເປັນ​ລູກຊາຍ​ຂອງ​ມາຮາດ, ມາຮາດ​ເປັນ​ລູກຊາຍ​ຂອງ​ອາມາໄສ<verse eid="1CH 6:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36" />ອາມາໄສ​ເປັນ​ລູກຊາຍ​ຂອງ​ເອນການາ, ເອນການາ​ເປັນ​ລູກຊາຍ​ຂອງ​ໂຢເອນ</para>
  <para style="li2" vid="1CH 6:36">ໂຢເອນ​ເປັນ​ລູກຊາຍ​ຂອງ​ອາຊາຣີຢາ, ອາຊາຣີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ເຊຟານີຢາ<verse eid="1CH 6:36" /></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37" />ເຊຟານີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ຕາຮາດ, ຕາຮາດ​ເປັນ​ລູກຊາຍ​ຂອງ​ອັດຊີເລ</para>
  <para style="li2" vid="1CH 6:37">ອັດຊີເຣ​ເປັນ​ລູກຊາຍ​ຂອງ​ເອບີອາສັບ, ເອບີອາສັບ​ເປັນ​ລູກຊາຍ​ຂອງ​ໂກຣາ<verse eid="1CH 6:37" /></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38" />ໂກຣາ​ເປັນ​ລູກຊາຍ​ຂອງ​ອີຊະຮາດ, ຜູ້​ເປັນ​ລູກຊາຍ​ຂອງ​ໂກຮາດ</para>
  <para style="li2" vid="1CH 6:38">ໂກຮາດ​ເປັນ​ລູກຊາຍ​ຂອງ​ເລວີ, ເລວີ​ເປັນ​ລູກຊາຍ​ຂອງ​ອິດສະຣາເອນ.<verse eid="1CH 6:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39" />ແລະ ຜູ້​ຊ່ວຍ​ຂອງ​ເຮມານ​ແມ່ນ​ອາສັບ, ຜູ້​ທີ່​ຮັບໃຊ້​ເປັນ​ມື​ຂວາ​ຂອງ​ລາວ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:39">ອາສັບ​ເປັນ​ລູກຊາຍ​ຂອງ​ເບເຣກີຢາ, ເບເຣກີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ຊີເມອາ,<verse eid="1CH 6:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40" />ຊີເມອາ​ເປັນ​ລູກຊາຍ​ຂອງ​ມີກາເອນ, ມີກາເອນ​ເປັນ​ລູກຊາຍ​ຂອງ​ບາອາເສອີຢາ,<note caller="+" style="f"><char style="fr" closed="false">6:40 </char><char style="ft" closed="false">ສຳ​ເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ບາງ​ສະບັບ ແລະ ສຳ​ເນົາ​ສະບັບ LXX. ໜຶ່ງ​ສະບັບ ແລະ ສະບັບ Syr. ວ່າ ມາ​ອາ​ເສ​ຢາ</char></note></para>
  <para style="li2" vid="1CH 6:40">ບາອາເສອີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ມານກີຢາ, <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />ມານກີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ເອທະນີ,</para>
  <para style="li2" vid="1CH 6:41">ເອທະນີ​ເປັນ​ລູກຊາຍ​ຂອງ​ເຊຣາ, ເຊຣາ​ເປັນ​ລູກຊາຍ​ຂອງ​ອາດາອີຢາ,<verse eid="1CH 6:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42" />ອາດາອີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ເອທານ, ເອທານ​ເປັນ​ລູກຊາຍ​ຂອງ​ຊິມມາ,</para>
  <para style="li2" vid="1CH 6:42">ຊິມມາ​ເປັນ​ລູກຊາຍ​ຂອງ​ຊີເມອີ, <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />ຊີເມອີ​ເປັນ​ລູກຊາຍ​ຂອງ​ຢາຮາດ</para>
  <para style="li2" vid="1CH 6:43">ຢາຮາດ​ເປັນ​ລູກຊາຍ​ຂອງ​ເກໂຊນ, ເກໂຊນ​ເປັນ​ລູກຊາຍ​ຂອງ​ເລວີ.<verse eid="1CH 6:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44" />ແລະ ພວກ​ຜູ້​ຊ່ວຍ​ຂອງ​ພວກເຂົາ, ຜູ້​ທີ່​ຮັບໃຊ້​ເປັນ​ມື​ຊ້າຍ​ຂອງ​ແມ່ນ​ເອທານ​ຈາກ​ຕະກຸນ​ເມຣາຣິ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:44">ເອທານ​ເປັນ​ລູກຊາຍ​ຂອງ​ກີຊີ ກີຊີ​ເປັນ​ລູກຊາຍ​ຂອງ​ອັບດີ</para>
  <para style="li2" vid="1CH 6:44">ອັບດີ​ເປັນ​ລູກຊາຍ​ຂອງ​ມານລຸກ, <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />ມານລຸກ​ເປັນ​ລູກຊາຍ​ຂອງ​ຮາຊາບີຢາ,</para>
  <para style="li2" vid="1CH 6:45">ຮາຊາບີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ອາມາຊີຢາ, ອາມາຊີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ຮິນກີຢາ,<verse eid="1CH 6:45" /></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46" />ຮິນກີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ອາມຊີ, ອາມຊີ​ເປັນ​ລູກຊາຍ​ຂອງ​ບານີ,</para>
  <para style="li2" vid="1CH 6:46">ບານີ​ເປັນ​ລູກຊາຍ​ຂອງ​ເຊເມ, <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />ເຊເມ​ເປັນ​ລູກຊາຍ​ຂອງ​ມາຮະລີ,</para>
  <para style="li2" vid="1CH 6:47">ມາຮະລີ​ເປັນ​ລູກຊາຍ​ຂອງ​ມູຊີ, ມູຊີ​ເປັນ​ລູກຊາຍ​ຂອງ​ເມຣາຣິ,</para>
  <para style="li2" vid="1CH 6:47">ເມຣາຣິ​ເປັນ​ລູກຊາຍ​ຂອງ​ເລວີ.<verse eid="1CH 6:47" /></para>
  <para style="b" />
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />ພີ່ນ້ອງ​ຊາວ​ເລວີ​ຂອງ​ພວກເຂົາ​ທີ່​ໄດ້​ຖືກ​ມອບໝາຍ​ໃຫ້​ເຮັດ​ໜ້າທີ່​ອື່ນໆ​ທັງໝົດ​ໃນ​ຫໍເຕັນ​ສັກສິດ, ເຊິ່ງ​ເປັນ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ. <verse eid="1CH 6:48" /><verse number="49" style="v" sid="1CH 6:49" />ແຕ່​ອາໂຣນ ແລະ ເຊື້ອສາຍ​ຂອງ​ລາວ​ເປັນ​ຜູ້​ເຜົາ​ເຄື່ອງ​ຖວາຍ​ບູຊາ​ເທິງ​ແທ່ນບູຊາ ແລະ ເຜົາ​ເຄື່ອງຫອມ​ຕ່າງໆ​ພ້ອມທັງ​ຮັບຜິດຊອບ​ວຽກ​ທັງໝົດ​ຢູ່​ໃນ​ບ່ອນ​ສັກສິດ​ທີ່ສຸດ ແລະ ຂໍ​ການ​ລຶບລ້າງ​ບາບ​ສຳລັບ​ອິດສະຣາເອນ​ໃຫ້​ຄົບຖ້ວນ​ທຸກ​ປະການ ຕາມ​ທີ່​ໂມເຊ​ຜູ້ຮັບໃຊ້​ຂອງ​ພຣະເຈົ້າ​ໄດ້​ສັ່ງ​ໄວ້.<verse eid="1CH 6:49" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50" />ເຊື້ອສາຍ​ຂອງ​ອາໂຣນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 6:50">ລູກຊາຍ​ຂອງ​ອາໂຣນ​ແມ່ນ​ເອເລອາຊາ, ລູກຊາຍ​ຂອງ​ເອເລອາຊາ​ແມ່ນ​ຟີເນຮາ,</para>
  <para style="li2" vid="1CH 6:50">ລູກຊາຍ​ຂອງ​ຟີເນຮາ​ແມ່ນ​ອາບີຊູອາ, <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />ລູກຊາຍ​ຂອງ​ອາບີຊູອາ​ແມ່ນ​ບຸກກີ,</para>
  <para style="li2" vid="1CH 6:51">ລູກຊາຍ​ຂອງ​ບຸກກີ​ແມ່ນ​ອຸດຊີ, ລູກຊາຍ​ຂອງ​ອຸດຊີ​ແມ່ນ​ເຊຣາຮີຢາ,<verse eid="1CH 6:51" /></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52" />ລູກຊາຍ​ຂອງ​ເຊຣາຮີຢາ​ແມ່ນ​ເມຣາອີໂຢດ, ລູກຊາຍ​ຂອງ​ເມຣາອີໂຢດ​ແມ່ນ​ອາມາຣີຢາ,</para>
  <para style="li2" vid="1CH 6:52">ລູກຊາຍ​ຂອງ​ອາມາຣີຢາ​ແມ່ນ​ອາຮີຕຸບ, <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />ລູກຊາຍ​ຂອງ​ອາຮີຕຸບ​ແມ່ນ​ຊາດົກ,</para>
  <para style="li2" vid="1CH 6:53">ລູກຊາຍ​ຂອງ​ຊາດົກ​ແມ່ນ​ອາຮີມາອາດ.<verse eid="1CH 6:53" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="54" style="v" sid="1CH 6:54" />ສະຖານທີ່​ເຫລົ່ານີ້​ເປັນ​ເຂດແດນ​ສຳລັບ​ການຕັ້ງ​ຖິ່ນຖານ​ຂອງ​ພວກເຂົາ​ທີ່​ໄດ້​ຈັດສັນ​ໄວ້​ເປັນ​ເຂດແດນ​ຂອງ​ພວກເຂົາ (ເຂດແດນ​ທີ່​ໄດ້​ຖືກ​ມອບ​ໃຫ້​ເຊື້ອສາຍ​ຂອງ​ອາໂຣນ​ຈາກ​ຕະກຸນ​ໂກຮາດ, ເພາະວ່າ​ການ​ຈັບ​ສະຫລາກ​ຄັ້ງ​ທໍາອິດ​ນັ້ນ​ໄດ້​ຈົກ​ຖືກ​ພວກເຂົາ) ມີ​ດັ່ງນີ້:<verse eid="1CH 6:54" /></para>
  <para style="li1">
    <verse number="55" style="v" sid="1CH 6:55" />ພວກເຂົາ​ໄດ້​ເມືອງ​ເຮັບໂຣນ​ໃນ​ຢູດາຍ ພ້ອມທັງ​ທົ່ງຫຍ້າ​ທີ່​ຢູ່​ອ້ອມຮອບ​ນັ້ນ. <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />(ແຕ່​ທົ່ງນາ ແລະ ໝູ່ບ້ານ​ຕ່າງໆ​ທີ່​ອ້ອມ​ເມືອງ​ນັ້ນ​ໄດ້​ມອບ​ໃຫ້​ກາເລັບ​ລູກຊາຍ​ຂອງ​ເຢຟຸນເນ. <verse eid="1CH 6:56" /><verse number="57" style="v" sid="1CH 6:57" />ດັ່ງນັ້ນ ເຊື້ອສາຍ​ຂອງ​ອາໂຣນ​ຈຶ່ງ​ໄດ້​ເມືອງ​ເຮັບໂຣນ (ເມືອງ​ລີ້ໄພ) ແລະ ລິບນາ,<note caller="+" style="f"><char style="fr" closed="false">6:57 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ໄດ້​ຮັບ​ເມືອງ​ລີ້ໄພ​ຕ່າງໆ ໄດ້​ແກ່ ເຮັບໂຣນ (ເບິ່ງ <char style="xt"><ref loc="JOS 21:13">ຢຊ 21:13</ref></char>)</char></note> ຢັດທີ, ເອຊະເຕມົວ, <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />ຮີເລນ, ເດບີ, <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />ອາຊານ, ຢຸດທາ ແລະ ເບັດເຊເມດ,<note caller="+" style="f"><char style="fr" closed="false">6:59 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ບໍ່​ມີ​ຄຳ​ວ່າ ຢຸດຕາ (ເບິ່ງ <char style="xt"><ref loc="JOS 21:16">ຢຊ 21:16</ref></char>)</char></note> ລວມທັງ​ທົ່ງຫຍ້າ​ຂອງ​ພວກເຂົາ.<verse eid="1CH 6:59" /></para>
  <para style="li1">
    <verse number="60" style="v" sid="1CH 6:60" />ແລະ ຈາກ​ເຜົ່າ​ເບັນຢາມິນ ພວກເຂົາ​ໄດ້​ຮັບ​ກີເບໂອນ<note caller="+" style="f"><char style="fr" closed="false">6:60 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ບໍ່​ມີ​ຄຳ​ວ່າ ກີເບໂອນ (ເບິ່ງ <char style="xt"><ref loc="JOS 21:17">ຢຊ 21:17</ref></char>)</char></note> ເກບາ ອາເລເມັດ ແລະ ອານາທົດ, ລວມທັງ​ທົ່ງຫຍ້າ​ຂອງ​ພວກເຂົາ.</para>
  <para style="lf" vid="1CH 6:60">ຈໍານວນ​ເມືອງ​ລວມ​ທັງໝົດ​ມີ​ສິບສາມ​ເມືອງ​ໄດ້​ຖືກ​ມອບ​ໃຫ້​ແກ່​ຕະກຸນ​ໂກຮາດ.<verse eid="1CH 6:60" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="61" style="v" sid="1CH 6:61" />ເຊື້ອສາຍ​ຂອງ​ໂກຮາດ​ຄົນ​ອື່ນໆ​ທີ່​ຍັງ​ເຫລືອ​ໄດ້​ຈັດສັນ​ໄວ້​ມີ​ສິບ​ເມືອງ​ຈາກ​ຕະກຸນ​ຕ່າງໆ​ຂອງ​ມານາເຊ​ເຄິ່ງ​ເຜົ່າ.<verse eid="1CH 6:61" /></para>
  <para style="li1">
    <verse number="62" style="v" sid="1CH 6:62" />ສຳລັບ​ເຊື້ອສາຍ​ຂອງ​ເກໂຊນ​ຕາມ​ແຕ່​ລະ​ຕະກຸນ​ໄດ້​ຖືກ​ຈັດສັນ​ໄວ້​ໃຫ້​ມີ​ສິບສາມ​ເມືອງ​ຈາກ​ເຜົ່າ​ອິດຊາຄາ, ອາເຊ, ເນັບທາລີ ແລະ ມານາເຊ​ຕາເວັນອອກ​ໃນ​ບາຊານ.<verse eid="1CH 6:62" /></para>
  <para style="li1">
    <verse number="63" style="v" sid="1CH 6:63" />ເຊື້ອສາຍ​ຂອງ​ເມຣາຣິ​ຕາມ​ແຕ່​ລະ​ຕະກຸນ​ໄດ້​ຖືກ​ມອບ​ໃຫ້​ມີ​ສິບສອງ​ເມືອງ​ຈາກ​ເຜົ່າ​ຣູເບັນ, ກາດ ແລະ ເຊບູໂລນ.<verse eid="1CH 6:63" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="64" style="v" sid="1CH 6:64" />ດັ່ງນັ້ນ​ຊາວ​ອິດສະຣາເອນ​ໄດ້​ມອບ​ເມືອງ​ຕ່າງໆ ແລະ ທົ່ງຫຍ້າ​ໃຫ້​ຊາວ​ເລວີ.<verse eid="1CH 6:64" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="65" style="v" sid="1CH 6:65" />ຈາກ​ເຜົ່າ​ຢູດາຍ, ຊີເມໂອນ ແລະ ເບັນຢາມິນ ພວກເຂົາ​ໄດ້​ຮັບ​ການ​ມອບໝາຍ​ໃຫ້​ໂດຍ​ການ​ໃຊ້​ສະຫລາກ​ຄືກັນ.<verse eid="1CH 6:65" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="66" style="v" sid="1CH 6:66" />ເຜົ່າ​ເອຟຣາອິມ​ໄດ້​ມອບ​ເຂດແດນ​ເມືອງ​ຕ່າງໆ​ໃຫ້​ແກ່​ຕະກຸນ​ຕ່າງໆ​ຂອງ​ຊາວ​ໂກຮາດ​ບາງຄົນ​ເປັນ​ເຂດແດນ​ຂອງ​ພວກເຂົາ.<verse eid="1CH 6:66" /></para>
  <para style="li1">
    <verse number="67" style="v" sid="1CH 6:67" />ເມືອງ​ຊີເຄມ (ເມືອງ​ລີ້ໄພ) ໃນ​ແຖບ​ເນີນພູ​ເອຟຣາອິມ, ແລະ ເມືອງ​ເກເຊ<note caller="+" style="f"><char style="fr" closed="false">6:67 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ໄດ້​ຮັບ​ເມືອງ​ລີ້ໄພ​ຕ່າງໆ ໄດ້​ແກ່ ເມືອງ​ຊີເຄມ (ເບິ່ງ <char style="xt"><ref loc="JOS 21:21">ຢຊ 21:21</ref></char>)</char></note>, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />ເມືອງ​ໂຢກເມອາມ, ເມືອງ​ເບັດໂຮໂຣນ, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />ເມືອງ​ໄອຢາໂລນ ແລະ ກາດຣິມໂມນ. ໂມນ​ພ້ອມທັງ​ທົ່ງຫຍ້າ​ດ້ວຍ.<verse eid="1CH 6:69" /></para>
  <para style="li1">
    <verse number="70" style="v" sid="1CH 6:70" />ຈາກ​ເຜົ່າ​ມານາເຊ​ເຄິ່ງ​ເຜົ່າ ຊາວ​ອິດສະຣາເອນ​ໄດ້​ມອບ​ເມືອງ​ອາເນ ແລະ ເມືອງ​ບີເລອາມ​ພ້ອມທັງ​ທົ່ງຫຍ້າ​ໃຫ້​ແກ່​ຕະກຸນ​ທີ່​ຍັງ​ເຫລືອ​ຂອງ​ຊາວ​ໂກຮາດ.<verse eid="1CH 6:70" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="71" style="v" sid="1CH 6:71" />ຕະກຸນ​ເກໂຊນ​ໄດ້​ຮັບ​ເມືອງ​ຕ່າງໆ​ມີ​ດັ່ງນີ້:</para>
  <para style="li1" vid="1CH 6:71">ຈາກ​ຕະກຸນ​ຂອງ​ເຜົ່າ​ມານາເຊ​ເຄິ່ງ​ເຜົ່າ ພວກເຂົາ​ໄດ້​ຮັບ​ເມືອງ​ໂກລານ​ໃນ​ບາຊານ ແລະ ອັດຊະທາໂຣດ​ນໍາ, ພ້ອມທັງ​ທົ່ງຫຍ້າ.<verse eid="1CH 6:71" /></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72" />ຈາກ​ເຜົ່າ​ອິດຊາຄາ ພວກເຂົາ​ໄດ້ຮັບ​ເມືອງ​ເກເດັດ, ເມືອງ​ດາເບຣັດ, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />ເມືອງ​ຣາໂມດ ແລະ ເມືອງ​ອາເນມ ພ້ອມ​ທັງ​ທົ່ງຫຍ້າ.<verse eid="1CH 6:73" /></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74" />ເຜົ່າ​ອາເຊ ພວກເຂົາ​ໄດ້​ຮັບ​ເມືອງ​ມາຊານ, ເມືອງ​ອັບໂດນ, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />ເມືອງ​ຮູກົກ ແລະ ເມືອງ​ເຣໂຮບ, ພ້ອມທັງ​ທົ່ງຫຍ້າ;<verse eid="1CH 6:75" /></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76" />ແລະ ຈາກ​ເຜົ່າ​ເນັບທາລີ ພວກເຂົາ​ໄດ້​ຮັບ​ເມືອງ​ເກເດັດ​ໃນ​ຄາລີເລ, ເມືອງ​ຮາມໂມນ ແລະ ເມືອງ​ກີຣິອາດທາອິມ, ພ້ອມທັງ​ທົ່ງຫຍ້າ.<verse eid="1CH 6:76" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="77" style="v" sid="1CH 6:77" />ເຊື້ອສາຍ​ເມຣາຣິ (ຊາວ​ເລວີ​ທີ່​ຍັງ​ເຫລືອ​ຢູ່​ນັ້ນ) ກໍ​ໄດ້​ຮັບ​ເມືອງ​ຕ່າງໆ​ດັ່ງນີ້:</para>
  <para style="li1" vid="1CH 6:77">ຈາກ​ເຜົ່າ​ເຊບູໂລນ​ໄດ້​ຮັບ​ເມືອງ​ໂຢກເນອາມ, ເມືອງ​ການຕາ,<note caller="+" style="f"><char style="fr" closed="false">6:77 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ບໍ່​ມີ​ຄຳ​ວ່າ ເມືອງ​ໂຢກເນອາມ ເມືອງ​ການ​ທາ</char></note> ເມືອງ​ຣິມໂມໂນ ແລະ ເມືອງ​ທາໂບ, ພ້ອມທັງ​ທົ່ງຫຍ້າ;<verse eid="1CH 6:77" /></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78" />ຈາກ​ເຜົ່າ​ຣູເບັນ​ທາງ​ຝັ່ງ​ເບື້ອງ​ຕາເວັນອອກ​ຂອງ​ແມ່ນໍ້າ​ຈໍແດນ​ຂອງ​ເມືອງ​ເຢຣິໂກ ພວກເຂົາ​ໄດ້​ຮັບ​ເມືອງ​ເບເຊ​ໃນ​ຖິ່ນແຫ້ງແລ້ງກັນດານ, ເມືອງ​ຢາຊາ, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />ເມືອງ​ເກເດໂມດ ແລະ ເມືອງ​ເມຟາອາດ, ພ້ອມທັງ​ທົ່ງຫຍ້າ.<verse eid="1CH 6:79" /></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80" />ແລະ ຈາກ​ເຜົ່າ​ກາດ ພວກເຂົາ​ໄດ້​ຮັບ​ເມືອງ​ຣາໂມດ​ໃນ​ກີເລອາດ, ເມືອງ​ມະຫານາອິມ, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />ເມືອງ​ເຮັດຊະໂບນ ແລະ ເມືອງ​ຢາເຊ, ພ້ອມທັງ​ທົ່ງຫຍ້າ.<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s1">ເຊື້ອສາຍ​ຂອງ​ອິດຊາຄາ</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 7:1" />ລູກຊາຍ​ຂອງ​ອິດຊາຄາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:1">ໂຕລາ, ປູອາ, ຢາຊຸບ ແລະ ຊິມໂຣນ. ລວມ​ທັງໝົດ​ມີ​ສີ່​ຄົນ.<verse eid="1CH 7:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2" />ລູກຊາຍ​ຂອງ​ໂຕລາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:2">ອຸດຊີ, ເຣຟາອີຢາ, ເຢຣິເອນ, ຢາມາຍ, ອີບສາມ ແລະ ຊາມູເອນ. ພວກເຂົາ​ເປັນ​ຫົວໜ້າ​ຄອບຄົວ. ໃນ​ຊ່ວງ​ການ​ປົກຄອງ​ຂອງ​ດາວິດ, ເຊື້ອສາຍ​ຂອງ​ໂຕລາ​ທີ່​ເປັນ​ທະຫານ, ເຊິ່ງ​ໄດ້​ບັນທຶກ​ຕາມ​ລໍາດັບ​ວົງ​ຕະກຸນ​ຂອງ​ພວກເຂົາ​ມີ 22.600 ຄົນ.<verse eid="1CH 7:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3" />ລູກຊາຍ​ຂອງ​ອຸດຊີ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:3">ອີຊະຣາຮີຢາ.</para>
  <para style="li1" vid="1CH 7:3">ລູກຊາຍ​ຂອງ​ອີຊະຣາຮີຢາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:3">ມີກາເອນ, ໂອບາດີຢາ, ໂຢເອນ ແລະ ອິດຊີຢາ. ພວກເຂົາ​ຫ້າ​ຄົນ​ເປັນ​ຫົວໜ້າ. <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />ອີງ​ຕາມ​ການ​ບັນທຶກ​ຕາມ​ລໍາດັບ​ວົງ​ຕະກຸນ​ຂອງ​ພວກເຂົາ, ພວກເຂົາ​ມີ​ທະຫານ 36.000 ຄົນ​ທີ່​ພ້ອມ​ອອກ​ສູ້ຮົບ. ຍ້ອນ​ພວກເຂົາ​ມີ​ເມຍ ແລະ ລູກ​ຫລາຍ​ຄົນ.<verse eid="1CH 7:4" /></para>
  <para style="lf">
    <verse number="5" style="v" sid="1CH 7:5" />ບັນດາ​ຍາດ​ພີ່ນ້ອງ​ທີ່​ເປັນ​ທະຫານ​ຂອງ​ເຜົ່າ​ອິດຊາຄາ​ທັງໝົດ, ພວກເຂົາ​ມີ 87.000 ຄົນ, ດັ່ງ​ທີ່​ໄດ້​ບັນທຶກ​ຕາມ​ລໍາດັບ​ວົງ​ຕະກຸນ​ຂອງ​ພວກເຂົາ.<verse eid="1CH 7:5" /></para>
  <para style="s1">ເຊື້ອສາຍ​ຂອງ​ເບັນຢາມິນ</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6" />ລູກຊາຍ​ຂອງ​ເບັນຢາມິນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:6">ເບລາ, ເບເກ ແລະ ເຢດີອາເອນ.<verse eid="1CH 7:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7" />ລູກຊາຍ​ຂອງ​ເບລາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:7">ເອຊະໂບນ, ອຸດຊີ, ອຸດຊີເອນ, ເຢຣິໂມດ ແລະ ອີຣິ. ພວກເຂົາ​ມີ​ທັງໝົດ​ຫ້າ​ຄົນ​ເປັນ​ຫົວໜ້າ​ຄອບຄົວ. ຕາມ​ທີ່​ໄດ້​ບັນທຶກ​ຕາມ​ລໍາດັບ​ວົງ​ຕະກຸນ​ພວກເຂົາ​ມີ​ທະຫານ 22.034 ຄົນ.<verse eid="1CH 7:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8" />ລູກຊາຍ​ຂອງ​ເບເກ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:8">ເຊມີຣາ, ໂຢອາດ, ເອລີເອເຊ, ເອລີໂອນາຍ, ອົມຣິ, ເຢເຣໂມດ, ອາບີຢາ, ອານາທົດ ແລະ ອາເລເມັດ. ຄົນ​ທັງໝົດ​ນີ້​ເປັນ​ລູກຊາຍ​ຂອງ​ເບເຄ. <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />ຕາມ​ການ​ບັນທຶກ​ຕາມ​ລໍາດັບ​ວົງ​ຕະກຸນ​ຂອງ​ພວກເຂົາ, ພວກເຂົາ​ເປັນ​ຫົວໜ້າ​ຄອບຄົວ ແລະ ມີ​ທະຫານ 20.200 ຄົນ.<verse eid="1CH 7:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10" />ລູກຊາຍ​ຂອງ​ເຢດີອາເອນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:10">ບິນຮານ.</para>
  <para style="li1" vid="1CH 7:10">ລູກຊາຍ​ຂອງ​ບິນຮານ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:10">ເຢອຸດ, ເບັນຢາມິນ, ເອຮຸດ, ເຄນາອານາ, ເຊທານ, ຕາກຊິດ ແລະ ອາຮິຊາຮາ. <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />ຄົນ​ເຫລົ່ານີ້​ທັງໝົດ​ເປັນ​ລູກຊາຍ​ຂອງ​ເຢດີອາເອນ​ທີ່​ເປັນ​ຫົວໜ້າ​ຄອບຄົວ. ມີ​ທະຫານ 17.200 ຄົນ​ທີ່​ພ້ອມ​ອອກ​ໄປ​ສູ້ຮົບ.<verse eid="1CH 7:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12" />ຊາວ​ຊຸບປິມ ແລະ ຊາວ​ຮູບປິມ​ເປັນ​ເຊື້ອສາຍ​ຂອງ​ອີຣະ ແລະ ຊາວ​ຮູຊິມ​ເປັນ​ເຊື້ອສາຍ​ຂອງ​ອາເຮີ.<verse eid="1CH 7:12" /></para>
  <para style="s1">ເຊື້ອສາຍ​ຂອງ​ເນັບທາລີ</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13" />ລູກຊາຍ​ຂອງ​ເນັບທາລີ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:13">ຢາຊີເອນ, ກູນີ, ເຢເຊ ແລະ ຊໍລູມ,<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">ສຳເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ຊໍລູມ (ເບິ່ງ <char style="xt"><ref loc="GEN 46:24">ປຖກ 46:24</ref></char> ແລະ <char style="xt"><ref loc="NUM 26:49">ຈບຊ 26:49</ref></char>)</char></note> ທີ່​ເປັນ​ເຊື້ອສາຍ​ຂອງ​ນາງ​ບິນຮາ.<verse eid="1CH 7:13" /></para>
  <para style="s1">ເຊື້ອສາຍ​ຂອງ​ມານາເຊ</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14" />ເຊື້ອສາຍ​ຂອງ​ມານາເຊ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:14">ອາຊະຣີເອນ​ເປັນ​ເຊື້ອສາຍ​ທີ່​ໄດ້​ມາ​ຈາກ​ເມຍນ້ອຍ​ຊາວ​ອາຣາມ.</para>
  <para style="li2" vid="1CH 7:14">ນາງ​ໄດ້​ເກີດ​ມາກີ​ພໍ່​ຂອງ​ກີເລອາດ <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />ມາກີ​ໄດ້​ເມຍ​ຈາກ​ຊາວ​ຊຸບປິມ ແລະ ຊາວ​ຮູບປິມ​ຜູ້​ລະ​ຄົນ. ນ້ອງສາວ​ຂອງ​ລາວ​ຊື່​ວ່າ ມາອາກາ. ເຊື້ອສາຍ​ອີກ​ຄົນ​ໜຶ່ງ​ຊື່​ວ່າ​ເຊໂລເຟຮັດ, ຜູ້​ທີ່​ມີ​ແຕ່​ລູກສາວ​ເທົ່ານັ້ນ. <verse eid="1CH 7:15" /><verse number="16" style="v" sid="1CH 7:16" />ມາອາກາ​ເມຍ​ຂອງ​ມາກີ​ມີ​ລູກຊາຍ​ຄົນໜຶ່ງ ແລະ ໄດ້​ຕັ້ງ​ຊື່​ວ່າ ເປເຣັດ. ນ້ອງຊາຍ​ຂອງ​ລາວ​ຊື່ວ່າ ເຊເລດ, ແລະ ລາວ​ມີ​ລູກຊາຍ​ຄື ອູລາມ ແລະ ເຣເກມ.<verse eid="1CH 7:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17" />ລູກຊາຍ​ຂອງ​ອູລາມ​ຄື:</para>
  <para style="li2" vid="1CH 7:17">ເບດານ.</para>
  <para style="li1" vid="1CH 7:17">ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ລູກຊາຍ​ຂອງ​ກີເລອາດ, ຜູ້​ເປັນ​ລູກຊາຍ​ຂອງ​ມາກີ, ຜູ້​ທີ່​ເປັນ​ລູກຊາຍ​ຂອງ​ມານາເຊ.<verse eid="1CH 7:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 7:18" />ຮາມໂມເລເກັດ​ເປັນ​ນ້ອງສາວ​ຂອງ​ກີເລອາດ​ມີ​ລູກຊາຍ​ດັ່ງນີ້: ອີໂຊດ, ອາບີເອເຊ ແລະ ມາລາ.<verse eid="1CH 7:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19" />ລູກຊາຍ​ຂອງ​ເຊມີດາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:19">ອາຮີອານ, ຊີເຄມ, ລີຄີ ແລະ ອານີອາມ.<verse eid="1CH 7:19" /></para>
  <para style="s1">ເຊື້ອສາຍ​ຂອງ​ເອຟຣາອິມ</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20" />ເຊື້ອສາຍ​ຂອງ​ເອຟຣາອິມ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:20">ຊູເທລາ, ລູກຊາຍ​ຂອງ​ລາວ​ແມ່ນ​ເບເຣັດ,</para>
  <para style="li2" vid="1CH 7:20">ລູກຊາຍ​ຂອງ​ເບເຣັດ​ແມ່ນ​ຕາຮາດ, ລູກຊາຍ​ຂອງ​ຕາຮາດ​ແມ່ນ​ເອເລອາດາ,</para>
  <para style="li2" vid="1CH 7:20">ລູກຊາຍ​ຂອງ​ເອເລອາດາ​ແມ່ນ​ຕາຮາດ, <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />ລູກຊາຍ​ຂອງ​ຕາຮາດ​ແມ່ນ​ຊາບາດ,</para>
  <para style="li2" vid="1CH 7:21">ລູກຊາຍ​ຂອງ​ຊາບາດ​ແມ່ນ​ຊູເທລາ.</para>
  <para style="li2" vid="1CH 7:21">(ເອເຊ ແລະ ເອເລອາດ​ຖືກ​ຊາວ​ພື້ນເມືອງ​ຂອງ​ກາດ​ຂ້າ, ເມື່ອ​ພວກເຂົາ​ໄປ​ຢຶດ​ຝູງສັດ​ຂອງ​ຊາວ​ກາດ. <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />ເອຟຣາອິມ​ພໍ່​ຂອງ​ພວກເຂົາ​ກໍ​ໄວ້​ທຸກ​ໃຫ້​ພວກເຂົາ​ເປັນ​ເວລາ​ຫລາຍ​ມື້ ແລະ ຍາດ​ພີ່ນ້ອງ​ຂອງ​ລາວ​ກໍ​ໄດ້​ພາກັນ​ມາ​ເລົ້າໂລມ​ໃຈ​ລາວ. <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />ຫລັງຈາກນັ້ນ​ເອຟຣາອິມ​ກໍ​ຫລັບ​ນອນ​ກັບ​ເມຍ​ຂອງ​ຕົນ​ອີກ, ນາງ​ໄດ້​ຖື​ພາ ແລະ ເກີດ​ລູກຊາຍ​ຄົນໜຶ່ງ. ລາວ​ໄດ້​ຕັ້ງຊື່​ໃຫ້​ລູກຊາຍ​ວ່າ​ເບຣິຢາ,<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">ຄຳວ່າ ເບຣີອາ ມີ​ສຽງ​ຄ້າຍ​ຄຳ​ພາສາ​ເຮັບເຣີ​ທີ່​ມີ​ຄວາມຫມາຍ​ວ່າ ເຄາະ​ຮ້າຍ</char></note> ເພາະ​ມີ​ເຫດການ​ຮ້າຍ​ເກີດ​ຂຶ້ນ​ໃນ​ຄອບຄົວ​ຂອງ​ລາວ. <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />ລູກສາວ​ຂອງ​ເອຟຣາອິມ​ແມ່ນ​ເຊເອຣາ, ຜູ້​ທີ່​ສ້າງ​ເມືອງ​ເບັດ​ໂຮໂຣນ​ຕອນ​ລຸ່ມ ແລະ ຕອນ​ເທິງ​ເມືອງ​ອຸດເຊັນເຊເອຣາ).<verse eid="1CH 7:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 7:25" />ເຣຟາ​ເປັນ​ລູກຊາຍ​ຂອງ​ເອຟຣາອິມ​ອີກ​ຜູ້​ໜຶ່ງ​ແມ່ນ​ເຣຟາ, ລູກຊາຍ​ຂອງ​ເຣຟາ​ແມ່ນ​ເຣເຊັບ,<note caller="+" style="f"><char style="fr" closed="false">7:25 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ບໍ່​ມີ​ປະໂຫຍກ​ທີ່​ວ່າ ເຊິ່ງ​ມີ​ລູກ​ຄື</char></note></para>
  <para style="li2" vid="1CH 7:25">ລູກຊາຍ​ຂອງ​ເຣເຊັບ​ແມ່ນ​ເຕລາ, ລູກຊາຍ​ຂອງ​ເຕລາ​ແມ່ນ​ຕາຮານ,<verse eid="1CH 7:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26" />ລູກຊາຍ​ຂອງ​ຕາຮານ​ແມ່ນ​ລາດານ, ລູກຊາຍ​ຂອງ​ລາດານ​ແມ່ນ​ອາມມີຮູດ,</para>
  <para style="li2" vid="1CH 7:26">ລູກຊາຍ​ຂອງ​ອາມມີຮຸດ​ແມ່ນ​ເອລີຊາມາ, <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />ລູກຊາຍ​ຂອງ​ເອລີຊາມາ​ແມ່ນ​ນູນ,</para>
  <para style="li2" vid="1CH 7:27">ລູກຊາຍ​ຂອງ​ນູນ​ແມ່ນ​ໂຢຊວຍ.<verse eid="1CH 7:27" /></para>
  <para style="lf">
    <verse number="28" style="v" sid="1CH 7:28" />ດິນແດນ ແລະ ບ່ອນ​ທີ່​ພວກເຂົາ​ໄດ້​ຕັ້ງ​ຖິ່ນຖານ​ຢູ່​ລວມ​ທັງ​ເມືອງ​ເບັດເອນ ແລະ ບ້ານ​ຕ່າງໆ​ທີ່​ຢູ່​ອ້ອມ​ເມືອງ​ຕ່າງໆ​ນັ້ນ, ນາອາຣານ​ຈົນ​ເຖິງ​ທາງ​ຕາເວັນ​ອອກ, ເມືອງ​ເກເຊ ແລະ ບ້ານ​ຕ່າງໆ​ທີ່​ອ້ອມ​ເມືອງ​ນັ້ນ​ໄປ​ຈົນ​ເຖິງ​ທາງ​ຕາເວັນ​ຕົກ ແລະ ຈາກ​ເມືອງ​ຊີເຄມ ແລະ ໝູ່ບ້ານ​ຕ່າງໆ​ທີ່ຢູ່​ອ້ອມ​ໄປ​ຈົນ​ເຖິງ​ເມືອງ​ອາອີ ແລະ ໝູ່ບ້ານ​ຕ່າງໆ​ທີ່​ຢູ່​ອ້ອມ​ເມືອງ​ເຫລົ່ານັ້ນ. <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />ລຽບຕາມ​ຊາຍແດນ​ຂອງ​ມານາເຊ​ມີ​ເມືອງ​ຕ່າງໆ​ຄື: ເບັດເຊອານ, ຕາອານັກ, ເມກິດໂດ ແລະ ເມືອງ​ໂດເຣ, ພ້ອມທັງ​ບ້ານ​ຕ່າງໆ​ທີ່​ຢູ່​ອ້ອມ​ເມືອງ​ເຫລົ່ານັ້ນ. ເຊື້ອສາຍ​ຂອງ​ໂຢເຊັບ​ລູກຊາຍ​ອິດສະຣາເອນ​ອາໄສ​ຢູ່​ໃນ​ເມືອງ​ເຫລົ່ານີ້.<verse eid="1CH 7:29" /></para>
  <para style="s1">ເຊື້ອສາຍ​ຂອງ​ອາເຊ</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30" />ລູກຊາຍ​ຂອງ​ອາເຊ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:30">ອິມນາ, ອີຊະວາ, ອີຊະວີ ແລະ ເບຣີຢາ. ລາວ​ມີ​ລູກສາວ​ຜູ້ໜຶ່ງ​ຊື່​ວ່າ ເສຣາ.<verse eid="1CH 7:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31" />ລູກຊາຍ​ຂອງ​ເບຣີຢາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:31">ເຮເບ ແລະ ມັນກີເອນ, ມັນກີເອນ​ເປັນ​ພໍ່​ຂອງ​ບີຣະຊາອິດ.<verse eid="1CH 7:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32" />ເຮເບ​ເປັນ​ພໍ່​ຂອງ​ຢາຟະເລດ, ໂຊເມ, ໂຮທາມ ແລະ ນ້ອງສາວ​ຂອງ​ພວກເຂົາ​ຊື່​ວ່າ ຊູອາ.<verse eid="1CH 7:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33" />ລູກຊາຍ​ຂອງ​ຢາຟະເລດ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:33">ປາສັກ, ບີມຮານ ແລະ ອາຊະວາດ.</para>
  <para style="lf" vid="1CH 7:33">ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ລູກຊາຍ​ຂອງ​ຢາຟະເລດ.<verse eid="1CH 7:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34" />ລູກຊາຍ​ຂອງ​ໂຊເມ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:34">ອາຮີ, ໂຣກາ,<note caller="+" style="f"><char style="fr" closed="false">7:34 </char><char style="ft" closed="false">ຫລື ບຸດ​ຂອງ​ອ້າຍນ້ອງ​ຂອງ​ໂຊເມເຣ​ໄດ້​ແກ່ ໂຣຮະກາ</char></note> ຮຸບບາ ແລະ ອາຣາມ.<verse eid="1CH 7:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35" />ໂຮທາມ​ນ້ອງຊາຍ​ຂອງ​ລາວ​ມີ​ລູກຊາຍ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:35">ໂຊພາ, ອີມນາ, ເຊເລັດ ແລະ ອາມານ.<verse eid="1CH 7:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36" />ລູກຊາຍ​ຂອງ​ໂຊພາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:36">ສູອາ, ຮັກເນເຟ, ຊູອານ, ເບຣີ, ອິມຣາ, <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />ເບເຊ, ໂຮດ, ຊາມມາ, ຊິນຊາ, ອີທະຣານ<note caller="+" style="f"><char style="fr" closed="false">7:37 </char><char style="ft" closed="false">ອາດຈະ​ເປັນ​ອີກ​ຮູບ​ໜຶ່ງ​ຂອງ ເຢເທ</char></note> ແລະ ເບເອຣາ.<verse eid="1CH 7:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38" />ລູກຊາຍ​ຂອງ​ເຢເທີ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:38">ເຢຟຸນເນ, ປີສະປາ, ແລະ ອາຣາ.<verse eid="1CH 7:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39" />ລູກຊາຍ​ຂອງ​ອຸນລາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 7:39">ອາຣາ, ຮານນີເອນ, ແລະ ຣີຊີອາ.<verse eid="1CH 7:39" /></para>
  <para style="lf">
    <verse number="40" style="v" sid="1CH 7:40" />ຄົນ​ທັງໝົດ​ເຫລົ່ານີ້​ແມ່ນ​ເຊື້ອສາຍ​ຂອງ​ອາເຊ, ເຊິ່ງ​ເປັນ​ຫົວໜ້າ​ຄອບຄົວ, ເປັນ​ທະຫານ​ໄດ້​ຮັບ​ການ​ຄັດເລືອກ, ເປັນ​ນັກຮົບ​ເກັ່ງກ້າ ແລະ ເປັນ​ຜູ້ນຳ​ທີ່​ສໍາຄັນ. ມີ​ຈໍານວນ​ທະຫານ 26.000 ຄົນ​ທີ່​ພ້ອມ​ອອກ​ສູ້ຮົບ, ດັ່ງ​ທີ່​ໄດ້​ບັນທຶກ​ຕາມ​ລໍາດັບ​ວົງ​ຕະກຸນ​ຂອງ​ພວກເຂົາ.<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s1">ເຊື້ອສາຍ​ຂອງ​ໂຊນ​ຊາວ​ເບັນຢາມິນ</para>
  <para style="r">(1ຂຄ 9:34-44)</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 8:1" />ລູກຊາຍ​ຂອງ​ເບັນຢາມິນ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 8:1">ເບລາ​ເປັນ​ລູກຊາຍ​ກົກ</para>
  <para style="li2" vid="1CH 8:1">ອັດຊະເບັນ​ເປັນ​ລູກຊາຍ​ຄົນ​ທີ​ສອງ, ອາຮາຣາ​ເປັນ​ຄົນ​ທີ​ສາມ,<verse eid="1CH 8:1" /></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2" />ໂນຮາ​ເປັນ​ຄົນ​ທີ​ສີ່ ແລະ ຣາຟາ​ເປັນ​ຄົນ​ທີ​ຫ້າ.<verse eid="1CH 8:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3" />ລູກຊາຍ​ຂອງ​ເບລາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 8:3">ອັດດາ, ເກຣາ, ອາບີຮຸດ,<note caller="+" style="f"><char style="fr" closed="false">8:3 </char><char style="ft" closed="false">ຫລື ເກຣາ​ບິດາ​ຂອງ​ເອຮູດ</char></note> <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />ອາບີຊູອາ, ນາອາມານ, ອາໂຮຢາ, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />ເກຣາ, ເຊຟູຟານ ແລະ ຮູຣາມ.<verse eid="1CH 8:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6" />ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ເຊື້ອສາຍ​ຂອງ​ເອຮຸດ, ເຊິ່ງ​ພວກເຂົາ​ເປັນ​ຫົວໜ້າ​ຄອບຄົວ​ຕ່າງໆ​ທີ່​ອາໄສ​ຢູ່​ທີ່​ເມືອງ​ເກບາ ແລະ ຖືກ​ບັງຄັບ​ໃຫ້​ຍ້າຍ​ໄປ​ຢູ່​ທີ່​ເມືອງ​ມານາຮາດ​ມີ​ດັ່ງນີ້:<verse eid="1CH 8:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7" />ນາອາມານ, ອາຮີຢາ, ແລະ ເກຣາ, ຜູ້​ທີ່​ຍ້າຍ​ພວກເຂົາ​ອອກ​ໄປ ແລະ ຜູ້​ທີ່​ເປັນ​ພໍ່​ຂອງ​ອຸດຊາ ແລະ ອາຮີຮຸດ.<verse eid="1CH 8:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8" />ຫລັງຈາກ ຊາຮາຣາອິມ​ໄດ້​ຢ່າຮ້າງ​ກັບ​ນາງ​ຮູຊິມ​ເມຍ​ຂອງ​ລາວ ແລະ ບາອາຣາ, ລາວ​ມີ​ລູກຊາຍ​ທີ່​ໄດ້​ເກີດ​ຢູ່​ໃນ​ໂມອາບ. <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />ເມຍ​ຂອງ​ລາວ​ຊື່​ວ່າ​ນາງ​ໂຮເດັດ​ມີ​ລູກຊາຍ​ຄື ໂຢບັບ, ຊີບີອາ, ເມຊາ, ມັນກຳ, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />ເຢອູດ, ສາຄີອາ ແລະ ມີຣະມາ. ຄົນ​ເຫລົ່ານີ້​ເປັນ​ຫົວໜ້າ​ຄອບຄົວ. <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />ລາວ​ມີ​ລູກຊາຍ​ຈາກ​ນາງ​ຮູຊິມ ດັ່ງນີ້: ອາບີຕຸບ ແລະ ເອນປາອານ.<verse eid="1CH 8:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12" />ບັນດາ​ລູກຊາຍ​ຂອງ​ເອນປາອານ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 8:12">ເອເບີ, ມີຊາມ ແລະ ເຊເມັດ. (ເປັນ​ຜູ້​ສ້າງ​ເມືອງ​ໂອໂນ ແລະ ເມືອງ​ໂຣດ ພ້ອມ​ທັງ​ບ້ານ​ທີ່​ຢູ່​ອ້ອມແອ້ມ​ເມືອງ​ນັ້ນ) <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />ເບຣິຢາ ແລະ ເຊມາ​ເປັນ​ຫົວໜ້າ​ຄອບຄົວ​ຕ່າງໆ ເຊິ່ງ​ອາໄສຢູ່​ໃນ​ເມືອງ​ໄອຢາໂລນ ແລະ ເປັນ​ຜູ້​ທີ່​ໄດ້​ຂັບໄລ່​ປະຊາຊົນ​ທີ່ຢູ່​ໃນ​ເມືອງ​ກາດ​ອອກ​ໄປ.<verse eid="1CH 8:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14" />ພວກລູກຊາຍ​ຂອງ​ເບຣິຢາ ມີ​ດັ່ງນີ້: ອາຮີໂອ, ຊາຊັກ, ເຢເຣໂມດ, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />ເຊບາດີຢາ, ອາຣາດ, ເອເດ, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />ມີກາເອນ, ອີຊະປາ ແລະ ໂຢຮາ. ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ລູກຊາຍ​ຂອງ​ເບຣິຢາ.<verse eid="1CH 8:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17" />ບັນດາ​ລູກຊາຍ​ຂອງ​ເອນປາອານ ມີດັ່ງນີ້: ເຊບາດີຢາ, ເມຊຸນລຳ, ຮີຊະກີ, ເຮເບ, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />ອີຊະເມຣາຍ, ອີຊະລີຢາ ແລະ ໂຢບັບ.<verse eid="1CH 8:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19" />ພວກລູກຊາຍ​ຂອງ​ຊີເມອີ ມີ​ດັ່ງນີ້: ຢາກີມ, ຊີກະຣີ, ຊັບດີ, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />ເອລີເອນາຍ, ຊິນເລໄທ, ເອລີເອນ, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />ອາດາອີຢາ, ເບຣາອີຢາ ແລະ ຊິມຣາດ.<verse eid="1CH 8:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22" />ບັນດາ​ລູກຊາຍ​ຂອງ​ຊາຊັກ ມີ​ດັ່ງນີ້: ອີຊະປັນ, ເອເບ, ເອລີເອນ, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />ອັບໂດນ, ຊີກະຣີ, ຮານານ, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />ຮານານີຢາ, ເອລາມ, ອັນໂທທິຢາ, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />ອິບເດອີຢາ ແລະ ເປນູເອນ.<verse eid="1CH 8:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26" />ພວກລູກຊາຍ​ຂອງ​ເຢໂຣຮາມ ມີດັ່ງນີ້: ຊາມເຊໄຣ, ເຊຮາຣີຢາ, ອາທາລີຢາ, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />ຢາອາເຣຊີຢາ, ເອລີຢາ ແລະ ຊີກະຣີ.<verse eid="1CH 8:27" /></para>
  <para style="lf">
    <verse number="28" style="v" sid="1CH 8:28" />ຄົນ​ເຫລົ່ານີ້​ທັງໝົດ​ເປັນ​ຫົວໜ້າ​ຄອບຄົວ ແລະ ຜູ້ນຳ​ທີ່​ບັນທຶກ​ໄວ້​ຕາມ​ລຳ​ດັບ​ຕະກຸນ ຂອງ​ພວກເຂົາ ແລະ ໄດ້​ອາໄສ​ຢູ່​ທີ່​ເຢຣູຊາເລັມ.<verse eid="1CH 8:28" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29" />ເຢອີເອນ<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ບໍ່​ມີ​ຄຳ​ວ່າ ເຢອີເອນ (<char style="xt">ເບິ່ງ <ref loc="1CH 9:35">9:35</ref></char>)</char></note>​ເປັນ​ພໍ່<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">ຄຳ​ວ່າ ບິດາ ອາດຈະ​ມີ​ຄວາມຫມາຍ​ວ່າ ຜູ້​ນຳ​ທາງ​ພົນລະ​ເມືອງ ຫລື ຜູ້​ນຳ​ທາງ​ທະຫານ</char></note>​ຂອງ​ກີເບໂອນ​ອາໄສ​ຢູ່​ທີ່​ກີເບໂອນ.</para>
  <para style="li2" vid="1CH 8:29">ເມຍ​ຂອງ​ລາວ​ຊື່​ວ່າ​ມາອາກາ, <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />ແລະ ລູກຊາຍ​ກົກ​ຂອງ​ລາວ​ແມ່ນ​ອັບໂດນ ລູກຊາຍ​ຄົນ​ອື່ນໆ​ມີ​ດັ່ງນີ້: ຊຸຣະ, ກີເຊ, ບາອານ, ເນຣະ,<note caller="+" style="f"><char style="fr" closed="false">8:30 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ບໍ່​ມີ​ຄຳ​ວ່າ ເນຣະ (<char style="xt">ເບິ່ງ <ref loc="1CH 9:36">9:36</ref></char>)</char></note> ນາດາບ, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />ເກໂດເຣ, ອາຮີໂອ, ເຊເກ, <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />ແລະ ມີກໂລດ​ຜູ້​ເປັນ​ພໍ່​ຂອງ​ຊີເມອາ. ພວກເຂົາ​ກໍ​ອາໄສ​ຢູ່​ໃກ້​ຍາດ​ພີ່ນ້ອງ​ທີ່​ຢູ່​ເຢຣູຊາເລັມ​ເໝືອນ​ກັນ.<verse eid="1CH 8:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33" />ເນຣະ​ເປັນ​ພໍ່​ຂອງ​ກີເຊ ກີເຊ​ເປັນ​ພໍ່​ຂອງ​ໂຊນ ແລະ ໂຊນ​ເປັນ​ພໍ່​ຂອງ​ໂຢນາທານ, ມັນກີຊູອາ, ອາບີນາດາບ ແລະ ເອຊະບາອານ.<note caller="+" style="f"><char style="fr" closed="false">8:33 </char><char style="ft" closed="false">ເປັນ​ທີ່​ຮູ້​ຈັກ​ໃນ​ອີກ​ຊື່​ໜຶ່ງ​ວ່າ ອີຊະໂບເຊັດ</char></note><verse eid="1CH 8:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34" />ລູກຊາຍ​ຂອງ​ໂຢນາທານ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 8:34">ເມຣິບບາອານ,<note caller="+" style="f"><char style="fr" closed="false">8:34 </char><char style="ft" closed="false">ເປັນ​ທີ່​ຮູ້​ຈັກ​ໃນ​ອີກ​ຊື່​ໜຶ່ງ​ວ່າ ເມ​ຟີ​ໂບ​ເຊັດ</char></note> ຜູ້​ເປັນ​ພໍ່​ຂອງ​ມີກາ.<verse eid="1CH 8:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35" />ບັນດາ​ລູກຊາຍ​ຂອງ​ມີກາ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 8:35">ປີໂທນ, ເມເລັກ, ຕາເຣອາ ແລະ ອາຮາດ.<verse eid="1CH 8:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36" />ອາຮາດ​ເປັນ​ພໍ່​ຂອງ​ເຢໂຮອາດດາ, ເຢໂຮອາດດາ​ເປັນ​ພໍ່​ຂອງ​ອາເລເມດ, ອາຊະມາເວດ ແລະ ຊິມຣີ. ຊິມຣີ​ເປັນ​ພໍ່​ຂອງ​ໂມຊາ, <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />ໂມຊາ​ເປັນ​ພໍ່​ຂອງ​ບີເນອາ, ບີເນອາ​ເປັນ​ພໍ່​ຂອງ​ຣາພາ, ຣາພາ​ເປັນ​ພໍ່​ຂອງ​ເອເລອາສາ ແລະ ເອເລອາສາ​ເປັນ​ພໍ່​ຂອງ​ອາເຊນ.<verse eid="1CH 8:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38" />ອາເຊນ​ມີ​ລູກຊາຍ​ຫົກ​ຄົນ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 8:38">ອາຊະຣີກຳ, ໂບເກຣູ, ອິດຊະມາເອນ, ເຊອາຣີຢາ, ໂອບາດີຢາ ແລະ ຮານານ. ຄົນ​ເຫລົ່ານີ້​ເປັນ​ລູກຊາຍ​ຂອງ​ອາເຊນ.<verse eid="1CH 8:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39" />ລູກຊາຍ​ຂອງ​ເອເຊນ​ນ້ອງຊາຍ​ອາເຊນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 8:39">ອູລາມ​ເປັນ​ລູກຊາຍ​ກົກ ເຢອຸດ​ເປັນ​ຄົນ​ທີ​ສອງ ແລະ ເອລີເຟເລັດ​ເປັນ​ຄົນ​ທີ​ສາມ <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />ບັນດາ​ລູກຊາຍ​ຂອງ​ອູລາມ​ເປັນ​ນັກຮົບ​ເກັ່ງ​ກ້າ ແລະ ເປັນ​ນັກຍິງທະນູ. ພວກເຂົາ​ມີ​ລູກຊາຍ ແລະ ລູກຫລານ​ທັງໝົດ​ໜຶ່ງຮ້ອຍ​ຫ້າສິບ​ຄົນ.</para>
  <para style="li1" vid="1CH 8:40">ພວກຄົນ​ເຫລົ່ານີ້​ເປັນ​ເຊື້ອສາຍ​ຂອງ​ເຜົ່າ​ເບັນຢາມິນ.<verse eid="1CH 8:40" /></para>
  <para style="b" />
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />ຊົນຊາດ​ອິດສະຣາເອນ​ທຸກ​ຄົນ​ມີ​ຊື່​ລາຍ​ຢູ່​ໃນ​ບັນທຶກ​ຕາມລຳ​ດັບ​ເຊື້ອສາຍ ເຊິ່ງ​ບັນທຶກ​ໄວ້​ໃນ​ປື້ມ​ບັນດາ​ກະສັດ​ແຫ່ງ​ອິດສະຣາເອນ ແລະ ຢູດາຍ ພວກເຂົາ​ໄດ້​ຖືກ​ຈັບ​ໄປ​ເປັນ​ຊະເລີຍ​ທີ່​ບາບີໂລນ ເພາະ​ຄວາມ​ບໍ່​ຊື່ສັດ​ຂອງ​ພວກເຂົາ.<verse eid="1CH 9:1" /></para>
  <para style="s1">ປະຊາຊົນ​ໃນ​ເຢຣູຊາເລັມ</para>
  <para style="r">(ນມຢ 11:3-19)</para>
  <para style="lh">
    <verse number="2" style="v" sid="1CH 9:2" />ພວກ​ທຳອິດ​ທີ່​ກັບຄືນ​ມາ​ຕັ້ງຖິ່ນຖານ​ຢູ່​ໃນ​ທີ່ດິນ​ຂອງ​ຕົນ​ຕາມ​ເມືອງ​ຕ່າງໆ​ມີ​ຊາວ​ອິດສະຣາເອນ, ບັນດາ​ປະໂລຫິດ, ພວກ​ເລວີ ແລະ ພວກ​ຄົນຮັບໃຊ້​ໃນ​ວິຫານ.<verse eid="1CH 9:2" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="3" style="v" sid="1CH 9:3" />ປະຊາຊົນ​ຈາກ​ເຜົ່າ​ຢູດາ, ເບັນຢາມິນ, ເອຟຣາອິມ ແລະ ມານາເຊ​ໄດ້​ມາ​ອາໄສ​ໃນ​ເຢຣູຊາເລັມ ມີ​ດັ່ງນີ້:<verse eid="1CH 9:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4" />ອູໄທ​ລູກຊາຍ​ຂອງ​ອາມມີຮຸດ, ອາມມີຮຸດ​ເປັນ​ລູກຊາຍ​ຂອງ​ອົມຣິ, ອົມຣິ​ເປັນ​ລູກຊາຍ​ຂອງ​ອິມຣີ, ອິມຣີ​ເປັນ​ລູກຊາຍ​ຂອງ​ບານີ, ທີ່​ເປັນ​ເຊື້ອສາຍ​ຂອງ​ເປເຣັດ​ລູກຊາຍ​ຢູດາ.<verse eid="1CH 9:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5" />ຈາກ​ເຊື້ອສາຍ​ຂອງ​ຊິໂລ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 9:5">ອາສາອີຢາ​ເປັນ​ລູກຊາຍ​ກົກ ແລະ ລູກຊາຍ​ຄົນ​ອື່ນໆ​ຂອງ​ລາວ.<verse eid="1CH 9:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6" />ຈາກ​ເຊື້ອສາຍ​ເຊຣາ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 9:6">ເຢອູເອນ.</para>
  <para style="lf" vid="1CH 9:6">ປະຊາຊົນ​ຈາກ​ຢູດາ​ມີ​ຈຳນວນ​ຫົກ​ຮ້ອຍ​ເກົ້າ​ສິບ​ຄົນ.<verse eid="1CH 9:6" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="7" style="v" sid="1CH 9:7" />ຈາກ​ເຊື້ອສາຍ​ຂອງ​ຊາວ​ເບັນຢາມິນ ມີ​ດັ່ງນີ້:</para>
  <para style="li1" vid="1CH 9:7">ສານລູ​ເປັນ​ລູກຊາຍ​ຂອງ​ເມຊຸນລຳ, ເມຊຸນລຳ​ເປັນ​ລູກຊາຍ​ຂອງ​ໂຮດາວິຢາ, ແລະ ໂຮດາວິຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ຮັດເສນູຢາ<verse eid="1CH 9:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 9:8" />ອິບເນອີຢາ ເປັນ​ລູກຊາຍ​ຂອງ​ເຢໂຣຮາມ,</para>
  <para style="li1" vid="1CH 9:8">ເອລາ ເປັນ​ລູກຊາຍ​ຂອງ​ອຸດຊີ ອຸດຊີ​ເປັນ​ລູກຊາຍ​ຂອງ​ມີກະຣີ</para>
  <para style="li1" vid="1CH 9:8">ແລະ ເມຊຸນລຳ ເປັນ​ລູກຊາຍ​ຂອງ​ເຊຟາຕີຢາ ເຊຟາຕີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ເຣອູເອນ ເຣອູເອນ​ເປັນ​ລູກຊາຍ​ຂອງ​ອິບນີຢາ.<verse eid="1CH 9:8" /></para>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 9:9" />ປະຊາຊົນ​ຈາກ​ເຜົ່າ​ເບັນຢາມິນ​ໄດ້​ມີ​ລາຍ​ຊື່​ບັນທຶກ​ໄວ້​ຕາມ​ລຳດັບ​ເຊື້ອສາຍ​ມີ​ຈໍານວນ​ເກົ້າ​ຮ້ອຍ​ຫ້າ​ສິບ​ຫົກ​ຄົນ, ພວກເຂົາ​ທັງ​ໝົດ​ເປັນ​ຫົວໜ້າ​ຄອບຄົວ.<verse eid="1CH 9:9" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="10" style="v" sid="1CH 9:10" />ສ່ວນ​ບັນດາ​ປະໂລຫິດ ມີ​ດັ່ງນີ້:</para>
  <para style="li1" vid="1CH 9:10">ເຢດາອີຢາ, ເຢໂຮຍອາຣິບ, ຢາກິນ<verse eid="1CH 9:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 9:11" />ແລະ ອາຊາຣີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ຮິນກີຢາ, ຜູ້​ເປັນ​ລູກຊາຍ​ຂອງ​ເມຊຸນລຳ ຜູ້​ເປັນ​ລູກຊາຍ​ຂອງ​ຊາດົກ, ຜູ້​ເປັນ​ລູກຊາຍ​ຂອງ​ເມຣາອີຢົດ, ຜູ້​ເປັນ​ລູກຊາຍ​ຂອງ​ອາຮີຕຸບ (ຄົນ​ເຫລົ່ານີ້​ເປັນ​ເຈົ້າ​ໜ້າ​ທີ່​ຮັບຜິດ​ຊອບ​ເບິ່ງ​ແຍງ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ;<verse eid="1CH 9:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 9:12" />ແລະ ອາດາອີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ເຢໂຣຮາມ, ເຢໂຣຮາມ​ເປັນ​ລູກຊາຍ​ຂອງ​ປັດຊູ, ປັດຊູ​ເປັນ​ລູກຊາຍ​ຂອງ​ມັນກີຢາ,</para>
  <para style="li1" vid="1CH 9:12">ແລະ ມາອາໄສ​ເປັນ​ລູກຊາຍ​ຂອງ​ອາດີເອນ, ອາດີເອນ​ເປັນ​ລູກຊາຍ​ຂອງ​ຢາຮະເຊຣາ, ຢາຮະເຊຣາ​ເປັນ​ລູກຊາຍ​ຂອງ​ເມຊຸນລຳ, ເມຊຸນລຳ​ເປັນ​ລູກຊາຍ​ຂອງ​ເມຊິນເລມິດ, ເມຊິນເລມິດ​ເປັນ​ລູກຊາຍ​ຂອງ​ອິມເມ.<verse eid="1CH 9:12" /></para>
  <para style="lf">
    <verse number="13" style="v" sid="1CH 9:13" />ບັນດາ​ປະໂລຫິດ​ຜູ້​ເປັນ​ຫົວໜ້າ​ຄອບຄົວ​ລວມ​ທັງໝົດ​ມີ​ໜຶ່ງພັນ​ເຈັດ​ຮ້ອຍ​ຫົກສິບ​ຄົນ. ພວກເຂົາ​ເປັນ​ຜູ້​ທີ່​ມີ​ຄວາມສາມາດ, ມີ​ໜ້າທີ່​ຮັບຜິດຊອບ​ເພື່ອ​ຮັບໃຊ້​ໃນ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ.<verse eid="1CH 9:13" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="14" style="v" sid="1CH 9:14" />ຈາກ​ຊາວ​ເລວີ ມີ​ດັ່ງນີ້:</para>
  <para style="li1" vid="1CH 9:14">ເຊມາອີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ຮັດຊຸບ, ຮັດຊຸບ​ເປັນ​ລູກຊາຍ​ຂອງ​ອາຊະຣີກຳ, ອາຊະຣີກຳ​ເປັນ​ລູກຊາຍ​ຂອງ​ຮາຊາບີຢາ​ແຫ່ງ​ຕະກຸນ​ເມຣາຣິ;<verse eid="1CH 9:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 9:15" />ບັກບັກກາ, ເຮເຣັດ, ກາລານ ແລະ ມັດຕານີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ມີກາ, ມີກາ​ເປັນ​ລູກຊາຍ​ຂອງ​ຊີກະຣີ, ຊີກະຣີ​ເປັນ​ລູກຊາຍ​ຂອງ​ອາສັບ;<verse eid="1CH 9:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 9:16" />ໂອບາດີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ເຊມາອີຢາ, ເຊມາອີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ກາລານ, ກາລານ​ເປັນ​ລູກຊາຍ​ຂອງ​ເຢດູທູນ</para>
  <para style="li1" vid="1CH 9:16">ແລະ ເບເຣກີຢາ ລູກຊາຍ​ຂອງ​ອາສາ, ອາສາ​ເປັນ​ລູກຊາຍ​ຂອງ​ເອນການາ ຜູ້ໄດ້​ອາໄສ​ຢູ່​ໃນ​ບ້ານ​ຕ່າງໆ​ຂອງ​ຊາວ​ເນໂຕຟາ.<verse eid="1CH 9:16" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="17" style="v" sid="1CH 9:17" />ຄົນ​ເຝົ້າຍາມ​ປະຕູ​ວິຫານ ມີ​ດັ່ງນີ້:</para>
  <para style="li1" vid="1CH 9:17">ຊໍລູມ, ອັກກຸບ, ຕານໂມນ ແລະ ອາຮີມານ​ພ້ອມ​ທັງ​ພີ່ນ້ອງ​ຊາວ​ເລວີ​ຂອງ​ພວກເຂົາ, ຊໍລູມ​ເປັນ​ຜູ້ນຳ​ຂອງ​ພວກເຂົາ. <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />ຄົນ​ເຝົ້າຍາມ​ປະຕູ​ເຫລົ່ານີ້​ເປັນ​ຄົນ​ຈາກ​ຄ້າຍພັກ​ຂອງ​ຊາວ​ເລວີ ພວກເຂົາ​ຍັງ​ຮັບຜິດຊອບ​ເຝົ້າຍາມ​ປະຕູ​ຂອງ​ກະສັດ​ທາງ​ດ້ານ​ຕາເວັນອອກ​ຈົນ​ເຖິງ​ທຸກ​ວັນນີ້.<verse eid="1CH 9:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 9:19" />ຊໍລູມ​ເປັນ​ລູກຊາຍ​ຂອງ​ໂກເຣ, ໂກເຣ​ເປັນ​ລູກຊາຍ​ຂອງ​ເອບີອາສັບ, ເອບີອາສັບ​ເປັນ​ລູກຊາຍ​ຂອງ​ໂກຣາ ຊາມລູມ ແລະ ພີ່ນ້ອງ​ເປັນ​ຄົນ​ເຝົ້າຍາມ​ນໍາກັນ​ມາ​ຈາກ​ຕະກຸນ​ດຽວ​ກັນຄື (ຕະກຸນ​ໂກຣາ) ເປັນ​ຜູ້ຮັບຜິດຊອບ​ເຝົ້າຍາມ​ຢູ່​ທີ່​ປະຕູ​ຂອງ​ຫໍເຕັນ<note caller="+" style="f"><char style="fr" closed="false">9:19 </char><char style="ft" closed="false">ຄື ວິຫານ ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="1CH 9:23"><ref loc="1CH 9:23">23</ref></char></char></note> ເໝືອນດັ່ງ​ທີ່​ບັນພະບຸລຸດ​ຂອງ​ພວກເຂົາ​ຮັບຜິດຊອບ​ເຝົ້າຍາມ​ທາງ​ເຂົ້າ​ບ່ອນທີ່​ພຣະເຈົ້າຢາເວ​ສະຖິດ​ຢູ່.<verse eid="1CH 9:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 9:20" />ໃນ​ສະໄໝກ່ອນ​ນັ້ນ​ຟີເນຮາ ລູກຊາຍ​ຂອງ​ເອເລອາຊາ​ເຄີຍ​ເປັນ​ຂ້າລາຊະການ​ທີ່​ຮັບຜິດຊອບ​ເບິ່ງແຍງ​ພວກຄົນ​ເຝົ້າຍາມ ແລະ ພຣະເຈົ້າ​ຢາເວ​ຢູ່​ນໍາ​ລາວ<verse eid="1CH 9:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 9:21" />ເຊກາຣີຢາ​ລູກຊາຍ​ຂອງ​ເມເຊເລມີຢາ​ເປັນ​ຄົນ​ເຝົ້າຍາມ​ທາງເຂົ້າ​ຫໍເຕັນ​ບ່ອນ​ຊຸມນຸມ.<verse eid="1CH 9:21" /></para>
  <para style="lf">
    <verse number="22" style="v" sid="1CH 9:22" />ຜູ້​ທີ່​ໄດ້​ຖືກ​ເລືອກ​ໃຫ້​ເປັນ​ຄົນ​ເຝົ້າຍາມ​ປະຕູ​ເຂົ້າ​ເຊິ່ງ​ລວມ​ທັງ​ໝົດ​ມີ 212 ຄົນ ພວກເຂົາ​ໄດ້​ຖືກ​ຈົດ​ຊື່​ເຂົ້າ​ຕາມ​ລໍາດັບ​ເຊື້ອສາຍ​ໃນ​ບ້ານ​ຕ່າງໆ​ທີ່​ພວກເຂົາ​ໄດ້​ອາໄສ​ຢູ່.</para>
  <para style="b" vid="1CH 9:22" />
  <para style="p" vid="1CH 9:22">ພວກ​ຄົນ​ເຝົ້າຍາມ​ໄດ້​ຮັບ​ມອບໝາຍ​ໃຫ້​ຮັບ​ຕໍາແໜ່ງ​ຂອງ​ພວກເຂົາ​ດ້ວຍ​ຄວາມ​ໄວ້ວາງໃຈ​ຈາກ​ດາວິດ ແລະ ຜູ້​ທຳນວາຍ​ຊາມູເອນ. <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />ພວກເຂົາ ແລະ ເຊື້ອສາຍ​ໄດ້​ຮັບ​ໜ້າທີ່​ເຝົ້າຍາມ​ປະຕູ​ຕ່າງໆ​ຂອງ​ວິຫານ​ຂອງ​ພຣະເຈົ້າຢາເວ ວິຫານ​ເອີ້ນ​ວ່າ ຫໍເຕັນ​ແຫ່ງ​ການ​ຊຸມນຸມ. <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />ພວກຄົນ​ເຝົ້າຍາມ​ປະຈຳການ​ທີ່​ປະຕູ​ທັງ​ສີ່​ດ້ານ​ຄື​ດ້ານ​ຕາເວັນອອກ, ຕາເວັນຕົກ, ເໜືອ ແລະ ໃຕ້. <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />ພີ່ນ້ອງ​ຊາວ​ເລວີ​ຂອງ​ພວກເຂົາ​ຈາກ​ບ້ານ​ຕ່າງໆ​ກໍ​ໄດ້​ປ່ຽນ​ຜຽນ​ກັນ ແລະ ໄດ້​ແປ່ງ​ໜ້າ​ທີ່​ກັນ​ເຝົ້າ​ເທື່ອລະ​ເຈັດ​ວັນ. <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />ຫົວໜ້າ​ເຝົ້າຍາມ​ປະຕູ​ສີ່​ຄົນ​ເປັນ​ຊາວ​ເລວີ​ທີ່​ໄດ້​ຮັບ​ຄວາມ​ໄວ້ວາງໃຈ​ໃຫ້​ຮັບຜິດຊອບ​ຫ້ອງ​ຕ່າງໆ ແລະ ຊັບສົມບັດ​ຕ່າງໆ​ໃນ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ. <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />ພວກເຂົາ​ຕ້ອງ​ເຝົ້າຍາມ​ປະຈຳການ​ອ້ອມ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ​ຕະຫລອດ​ຄືນ, ເພາະ​ພວກເຂົາ​ຕ້ອງ​ເຝົ້າ​ຮັກສາ​ວິຫານ ແລະ ພວກເຂົາ​ມີ​ໜ້າທີ່​ເປີດ​ປະຕູ​ທຸກ​ເຊົ້າ.<verse eid="1CH 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />ພວກເຂົາ​ບາງ​ຄົນ​ມີ​ໜ້າທີ່​ຮັບຜິດຊອບ​ເບິ່ງແຍງ​ເຄື່ອງໃຊ້​ຕ່າງໆ​ທີ່​ນໍາໃຊ້​ໃນ​ການນະມັດສະການ, ພວກເຂົາ​ຈະ​ນັບເບິ່ງ​ເມື່ອ​ພວກເຂົາ​ໄດ້​ນໍາ​ໄປ ແລະ ນຳ​ເອົາ​ກັບ​ມາ. <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />ຄົນອື່ນ​ຖືກ​ຮັບຜິດຊອບ​ເບິ່ງແຍງ​ເຄື່ອງໃຊ້​ຕ່າງໆ ແລະ ເຄື່ອງໃຊ້​ສັກສິດ​ລວມ​ທັງ​ແປ້ງ, ເຫລົ້າ​ອະງຸ່ນ, ນໍ້າມັນ​ໝາກກອກ, ເຄື່ອງຫອມ ແລະ ເຄື່ອງເທດ. <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />ແຕ່​ປະໂລຫິດ​ບາງຄົນ​ເບິ່ງແຍງ​ການ​ປຸງ​ເຄື່ອງເທດ <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />ຊາວ​ເລວີ​ຄົນ​ໜຶ່ງ​ຊື່​ວ່າ ມັດຕີທີຢາ, ລູກຊາຍ​ກົກ​ຂອງ​ຊໍລູມ​ແຫ່ງ​ຕະກຸນ​ໂກຣາ, ໄດ້​ຮັບຜິດຊອບ​ໜ້າທີ່​ໃຫ້​ເຮັດ​ເຂົ້າຈີ່​ຖວາຍ​ບູຊາ. <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />ພີ່ນ້ອງ​ຕະກຸນ​ໂກຮາດ​ບາງຄົນ​ມີ​ໜ້າທີ່​ຈັດຕຽມ​ເຂົ້າຈີ່​ວາງ​ໄວ້​ເທິງ​ໂຕະ​ທຸກ​ວັນຊະບາໂຕ.<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />ບັນດາ​ນັກດົນຕີ​ທີ່​ເປັນ​ຫົວໜ້າ​ຄອບຄົວ​ຕ່າງໆ​ຂອງ​ຊາວເລວີ​ໄດ້​ພັກ​ທີ່​ຫ້ອງ​ໃນ​ວິຫານ ແລະ ໄດ້​ຖືກ​ຍົກເວັ້ນ​ຈາກ​ໜ້າທີ່​ອື່ນໆ ເພາະ​ພວກເຂົາ​ຕ້ອງ​ຮັບຜິດຊອບ​ວຽກ​ທັງ​ກາງເວັນ ແລະ ກາງຄືນ.<verse eid="1CH 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34" />ພວກຄົນ​ເຫລົ່ານີ້​ເປັນ​ຫົວໜ້າ​ຄອບຄົວ ແລະ ເປັນ​ຜູ້ນຳ​ຕ່າງໆ​ຂອງ​ຊາວ​ເລວີ ມີ​ລາຍຊື່​ບັນທຶກ​ໄວ້ຕາມ​ລຳ​ດັບ​ເຊື້ອສາຍ​ຂອງ​ພວກເຂົາ ແລະ ໄດ້​ອາໄສ​ໃນ​ຢູ່​ເຢຣູຊາເລັມ.<verse eid="1CH 9:34" /></para>
  <para style="s1">ເຊື້ອສາຍ​ຂອງ​ໂຊນ</para>
  <para style="r">(1ຂຄ 8:28-38)</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35" />ເຢອີເອນ​ເປັນ​ພໍ່<note caller="+" style="f"><char style="fr" closed="false">9:35 </char><char style="ft" closed="false">ຄຳ​ວ່າ ບິດາ ອາດຈະ​ມີ​ຄວາມຫມາຍ​ວ່າ ຜູ້​ນຳ​ທາງ​ພົນລະ​ເມືອງ ຫລື ຜູ້​ນຳ​ທາງ​ທະຫານ</char></note>​ຂອງ​ກີເບໂອນ​ອາໄສ​ຢູ່​ທີ່​ກີເບໂອນ.</para>
  <para style="li2" vid="1CH 9:35">ເມຍ​ຂອງ​ລາວ​ຊື່​ວ່າ​ມາອາກາ <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />ແລະ ລູກຊາຍ​ກົກ​ຂອງ​ລາວ​ແມ່ນ​ອັບໂດນ ລູກຊາຍ​ຄົນ​ອື່ນໆ​ຂອງ​ລາວ​ມີ​ດັ່ງນີ້: ຊຸຣະ, ກີເຊ, ບາອານ, ເນຣະ, ນາດາບ, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />ເກໂດເຣ, ອາຮີໂອ, ເຊກາຣີຢາ ແລະ ມີກໂລດ, <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />ມີກໂລດ​ເປັນ​ພໍ່​ຂອງ​ຊີເມອາ. ພວກເຂົາ​ກໍ​ອາໄສ​ຢູ່​ໃກ້​ຍາດ​ພີ່ນ້ອງ​ທີ່​ຢູ່​ເຢຣູຊາເລັມ​ເໝືອນ​ກັນ.<verse eid="1CH 9:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39" />ເນຣະ​ເປັນ​ພໍ່​ຂອງ​ກີເຊ, ກີເຊ​ເປັນ​ພໍ່​ຂອງ​ໂຊນ ແລະ ໂຊນ​ເປັນ​ພໍ່​ຂອງ​ໂຢນາທານ, ມັນກີຊູອາ, ອາບີນາດາບ ແລະ ເອຊະບາອານ.<note caller="+" style="f"><char style="fr" closed="false">9:39 </char><char style="ft" closed="false">ເປັນ​ທີ່​ຮູ້​ຈັກ​ໃນ​ອີກ​ຊື່​ໜຶ່ງ​ວ່າ ອີຊະໂບເຊັດ</char></note><verse eid="1CH 9:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40" />ລູກຊາຍ​ຂອງ​ໂຢນາທານ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 9:40">ເມຣິບບາອານ,<note caller="+" style="f"><char style="fr" closed="false">9:40 </char><char style="ft" closed="false">ເປັນ​ທີ່​ຮູ້​ຈັກ​ໃນ​ອີກ​ຊື່​ໜຶ່ງ​ວ່າ ເມຟີໂບເຊັດ</char></note> ຜູ້​ເປັນ​ພໍ່​ຂອງ​ມີກາ.<verse eid="1CH 9:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41" />ບັນດາ​ລູກຊາຍ​ຂອງ​ມີກາ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 9:41">ປີໂທນ, ເມເລັກ, ຕາເຣອາ ແລະ ອາຮາດ.<note caller="+" style="f"><char style="fr" closed="false">9:41 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ບໍ່​ມີ​ຄຳ​ວ່າ ແລະ ອາຮາດ (<char style="xt">ເບິ່ງ <ref loc="1CH 8:35">8:35</ref></char>)</char></note><verse eid="1CH 9:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42" />ອາຮາດ​ເປັນ​ພໍ່​ຂອງ​ຢາດາ<note caller="+" style="f"><char style="fr" closed="false">9:42 </char><char style="ft" closed="false">ຫລື ຂອງ​ຢາລາ, ຢາລາ (<char style="xt">ເບິ່ງ <ref loc="1CH 8:36">8:36</ref></char>)</char></note>, ຢາດາ​ເປັນ​ພໍ່​ຂອງ​ອາເລເມດ, ອາຊະມາເວດ ແລະ ຊິມຣີ, ຊິມຣີ​ເປັນ​ພໍ່​ຂອງ​ໂມຊາ. <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />ໂມຊາ​ເປັນ​ພໍ່​ຂອງ​ບີເນອາ, ບີເນອາ​ເປັນ​ພໍ່​ຂອງ​ເຣຟາອີຢາ, ເຣຟາອີຢາ​ເປັນ​ພໍ່​ຂອງ​ເອເລອາສາ, ເອເລອາສາ​ເປັນ​ພໍ່​ຂອງ​ອາເຊນ.<verse eid="1CH 9:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44" />ອາເຊນ​ມີ​ລູກຊາຍ​ຫົກ​ຄົນ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 9:44">ອາຊະຣີກຳ, ໂບເກຣູ, ອິດຊະມາເອນ, ເຊອາຣີຢາ, ໂອບາດີຢາ ແລະ ຮານານ. ຄົນ​ເຫລົ່ານີ້​ເປັນ​ລູກຊາຍ​ຂອງ​ອາເຊນ.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s1">ໂຊນ​ຂ້າ​ໂຕ​ຕາຍ</para>
  <para style="r">(1ຊມອ 31:1-13; 2ຊມອ 1:4-12)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />ຝ່າຍ​ຊາວ​ຟີລິດສະຕິນ​ໄດ້​ສູ້ຮົບ​ກັບ​ຊາວ​ອິດສະຣາເອນ; ຊາວ​ອິດສະຣາເອນ​ໄດ້​ປົບໜີ​ໄປ ແລະ ມີ​ຫລາຍ​ຄົນ​ລົ້ມ​ຕາຍ​ຢູ່​ເທິງ​ພູເຂົາ​ກິນໂບອາ. <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />ຊາວ​ຟີລິດສະຕິນ​ໄດ້​ໄລ່ຕາມ​ຈັບ​ໂຊນ ແລະ ບັນດາ​ລູກຊາຍ​ຂອງ​ເພິ່ນ ແລະ ພວກເຂົາ​ໄດ້​ຂ້າ​ລູກຊາຍ​ທັງ​ສາມ​ຄື: ໂຢນາທານ, ອາບີນາດາບ ແລະ ມັນກີຊູອາ. <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />ການ​ສູ້ຮົບ​ອ້ອມ​ໂຊນ​ເປັນ​ໄປ​ຢ່າງ​ດຸເດືອດ, ເມື່ອ​ນັກທະນູ​ໄດ້​ຍິງ​ທະນູ​ໃສ່​ໂຊນ ເຮັດ​ໃຫ້​ໂຊນ​ບາດເຈັບ​ສາຫັດ.<verse eid="1CH 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4" />ໂຊນ​ໄດ້​ເວົ້າ​ກັບ​ຜູ້​ທີ່​ຖື​ອາວຸດ​ຂອງ​ຕົນ​ວ່າ, “ຈົ່ງ​ຖອດ​ດາບ​ຂອງ​ເຈົ້າ​ອອກ ແລ້ວ​ແທງ​ທະລຸ​ຮ່າງ​ຂອງ​ເຮົາ ບໍ່​ດັ່ງນັ້ນ​ຄົນ​ທີ່​ບໍ່ໄດ້ຮັບພິທີຕັດ​ເຫລົ່ານີ້​ຈະ​ມາ​ຂ້າ​ເຮົາ ແລະ ນຳ​ຄວາມ​ອັບອາຍ​ມາ​ໃຫ້​ເຮົາ”.</para>
  <para style="p" vid="1CH 10:4">ແຕ່​ຊາຍ​ທີ່​ຖື​ອາວຸດ​ນັ້ນ​ຢ້ານ ແລະ ບໍ່​ກ້າ​ເຮັດ ດັ່ງນັ້ນ​ໂຊນ​ຈຶ່ງ​ເອົາ​ດາບ​ຂອງ​ເພິ່ນ​ອອກ​ມາ ແລ້ວ​ກໍ​ຖິ້ມ​ຕົວ​ລົງ​ໃສ່​ດາບ​ຂອງ​ຕົນ <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />ເມື່ອ​ຊາຍ​ນັ້ນ​ເຫັນ​ວ່າ​ໂຊນ​ໄດ້​ຕາຍ​ແລ້ວ ກໍ​ໃຊ້​ດາບ​ຂອງ​ຕົນ​ຂ້າ​ຕົນເອງ​ຕາຍ. <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />ດັ່ງນັ້ນ ໂຊນ ແລະ ລູກຊາຍ​ທັງ​ສາມ​ຄົນ​ຂອງ​ເພິ່ນ​ຈຶ່ງ​ໄດ້​ຕາຍ​ໄປ ແລະ ທຸກຄົນ​ໃນ​ຄອບຄົວ​ຂອງ​ເພິ່ນ​ໄດ້​ຕາຍ​ພ້ອມ​ກັນ.<verse eid="1CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7" />ເມື່ອ​ຊາວ​ອິດສະຣາເອນ​ທັງໝົດ​ທີ່​ຢູ່​ຕາມ​ຮ່ອມພູ​ເຫັນ​ວ່າ​ກອງທັບ​ກໍ​ໄດ້​ພາກັນ​ປົບໜີ​ໄປ ແລະ ເຫັນ​ວ່າ​ໂຊນ ແລະ ລູກຊາຍ​ໄດ້​ຕາຍ​ໄປ​ແລ້ວ, ພວກເຂົາ​ຈຶ່ງ​ພາກັນ​ປະຖິ້ມ​ບ້ານ​ເມືອງ​ຂອງ​ພວກເຂົາ​ໜີ​ໄປ ແລ້ວ​ຊາວ​ຟີລິດສະຕິນ​ກໍ​ໄດ້​ເຂົ້າ​ໄປ​ຢຶດ​ເອົາ.<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />ມື້​ຕໍ່ມາ​ເມື່ອ​ຊາວ​ຟີລິດສະຕິນ​ໄດ້​ອອກ​ມາ​ປົດ​ເອົາ​ເຄື່ອງ​ຂອງ​ທີ່​ມີ​ຄ່າ​ອອກ​ຈາກ​ສົບ, ພວກເຂົາ​ໄດ້​ພົບ​ສົບ​ຂອງ​ໂຊນ ແລະ ບັນດາ​ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຢູ່​ເທິງ​ພູເຂົາ​ກິນໂບອາ. <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />ພວກເຂົາ​ໄດ້​ແກ້​ເອົາ​ເຄື່ອງ​ຂອງ​ເພິ່ນ ແລະ ຕັດ​ຫົວ​ຂອງ​ເພິ່ນ ແລະ ເອົາ​ຍຸດທະພັນ​ຂອງ​ເພິ່ນ​ໄປ, ແລ້ວ​ກໍ​ສົ່ງ​ຜູ້​ນຳ​ຂ່າວ​ໄປ​ທົ່ວ​ດິນແດນ​ຟີລິດສະຕິນ ເພື່ອ​ປະກາດ​ຂ່າວ​ທ່າມກາງ​ບັນດາ​ພະ​ທັງຫລາຍ ແລະ ປະຊາຊົນ​ຂອງ​ພວກເຂົາ. <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />ພວກເຂົາ​ໄດ້​ເອົາ​ຍຸດທະພັນ​ຂອງ​ໂຊນ​ໄປ​ເກັບ​ໄວ້​ໃນ​ວິຫານ​ຂອງ​ພະ​ຂອງ​ຕົນ ແລະ ຫ້ອຍ​ຫົວ​ຂອງ​ເພິ່ນ​ໄວ້​ໃນ​ວິຫານ​ຂອງ​ພະ​ດາໂກນ.<verse eid="1CH 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11" />ເມື່ອ​ຊາວ​ຢາເບັດ​ກີເລອາດ​ທັງໝົດ​ໄດ້​ຍິນ​ສິ່ງ​ທີ່​ຊາວ​ຟີລິດສະຕິນ​ໄດ້​ເຮັດ​ຕໍ່​ໂຊນ, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />ທະຫານ​ທີ່​ເກັ່ງກ້າ​ຂອງ​ພວກເຂົາ​ກໍ​ອອກ​ໄປ​ເອົາ​ສົບ​ຂອງ​ໂຊນ ແລະ ສົບ​ຂອງ​ລູກຊາຍ​ຂອງ​ເພິ່ນ​ກັບ​ມາ​ທີ່​ຢາເບັດ. ແລ້ວ​ພວກເຂົາ​ໄດ້​ຝັງ​ກະດູກ​ຂອງ​ພວກເພິ່ນ​ໄວ້​ຢູ່​ກ້ອງ​ຕົ້ນໄມ້​ໃຫຍ່​ໃນ​ຢາເບັດ ແລະ ພວກເຂົາ​ໄດ້​ຖືສິນ​ອົດອາຫານ​ເປັນ​ເວລາ​ເຈັດ​ວັນ.<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />ໂຊນ​ໄດ້​ຕາຍ​ໄປ ເພາະ​ເພິ່ນ​ບໍ່​ໄດ້​ຊື່ສັດ​ຕໍ່​ພຣະເຈົ້າຢາເວ, ເພິ່ນ​ບໍ່​ໄດ້​ຮັກສາ​ຂໍ້​ຄຳສັ່ງ​ຂອງ​ພຣະເຈົ້າຢາເວ ແລະ ໄດ້​ໄປ​ຂໍ​ຄຳ​ປຶກສາ​ຈາກ​ວິນຍານ​ຂອງ​ຄົນ​ຕາຍ. <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />ແລະ ບໍ່​ໄດ້​ຂໍ​ຄໍາແນະນໍາ​ຈາກ​ພຣະເຈົ້າຢາເວ. ດັ່ງນັ້ນ ພຣະອົງ​ຈຶ່ງ​ໄດ້​ຂ້າ​ເພິ່ນ ແລະ ມອບ​ອານາຈັກ​ໃຫ້​ແກ່​ດາວິດ​ລູກຊາຍ​ຂອງ​ເຢຊີ.<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s1">ດາວິດ​ຂຶ້ນ​ເປັນ​ກະສັດ</para>
  <para style="r">(2ຊມອ 5:1-3)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />ຊາວ​ອິດສະຣາເອນ​ທັງໝົດ​ມາ​ຫາ​ດາວິດ​ທີ່​ເມືອງ​ເຮັບໂຣນ ແລະ ກ່າວ​ວ່າ, “ພວກເຮົາ​ເປັນ​ພີ່ນ້ອງ​ຮ່ວມ​ສາຍ​ເລືອດ​ຂອງ​ທ່ານ. <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />ໃນ​ອະດີດ​ທີ່​ຜ່ານ​ມາ​ເຖິງ​ແມ່ນ​ວ່າ​ຂະນະ​ທີ່​ໂຊນ​ຍັງ​ເປັນ​ກະສັດ​ຢູ່ ທ່ານ​ກໍ​ເປັນ​ຜູ້ນຳ​ອິດສະຣາເອນ​ໃນ​ການສູ້ຮົບ ພຣະເຈົ້າ​ຢາເວ, ພຣະເຈົ້າ​ຂອງ​ເພິ່ນ​ໄດ້​ກ່າວ​ຕໍ່​ເພິ່ນ​ວ່າ ‘ເພິ່ນ​ຈະ​ເປັນ​ຜູ້​ລ້ຽງ​ປະຊາ​ຊົນ​ອິດສະຣາເອນ​ຂອງ​ເຮົາ ແລະ ເພິ່ນ​ຈະ​ເປັນ​ຜູ້​ປົກຄອງ​ຂອງ​ພວກເຂົາ’ ”.<verse eid="1CH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3" />ເມື່ອ​ພວກ​ເຖົ້າແກ່​ທັງໝົດ​ຂອງ​ອິດສະຣາເອນ​ໄດ້​ມາ​ຫາ​ກະສັດ​ດາວິດ​ທີ່​ເຮັບໂຣນ. ເພິ່ນ​ໄດ້​ເຮັດ​ຄໍາໝັ້ນສັນຍາ​ກັບ​ພວກເຂົາ​ທີ່​ເຮັບໂຣນ​ຕໍ່ໜ້າ​ພຣະເຈົ້າຢາເວ. ແລະ ພວກເຂົາ​ໄດ້​ໃຊ້​ນໍ້າມັນ​ຫົດສົງ​ດາວິດ​ຂຶ້ນ​ເປັນ​ກະສັດ​ປົກຄອງ​ອິດສະຣາເອນ, ເຊິ່ງ​ເປັນ​ຈິງ​ຕາມ​ທີ່​ອົງພຣະຜູ້ເປັນເຈົ້າ​ໄດ້​ສັນຍາ​ໄວ້​ຜ່ານ​ທາງ​ຊາມູເອນ.<verse eid="1CH 11:3" /></para>
  <para style="s1">ດາວິດ​ຢຶດຄອງ​ເຢຣູຊາເລັມ</para>
  <para style="r">(2ຊມອ 5:6-10)</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />ດາວິດ ແລະ ຊາວ​ອິດສະຣາເອນ​ທັງໝົດ​ໄດ້​ບຸກ​ໂຈມຕີ​ເຢຣູຊາເລັມ (ຄື​ເມືອງ​ເຢບູ) ຊາວ​ເຢບຸດ​ໄດ້​ອາໄສ​ຢູ່​ທີ່ນັ້ນ. <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />ຊາວ​ເຢບຸດ​ເວົ້າ​ຕໍ່​ດາວິດ​ວ່າ “ເຈົ້າ​ຈະ​ເຂົ້າ​ມາ​ໃນ​ທີ່ນີ້​ບໍ່​ໄດ້​ດອກ”. ເຖິງຢ່າງໃດ​ກໍ່ຕາມ, ດາວິດ​ໄດ້​ຢຶດ​ປ້ອມ​ຂອງ​ເມືອງ​ຊີໂອນ​ໄວ້​ແລ້ວ ເຊິ່ງ​ຖືກ​ເອີ້ນ​ວ່າ “ເມືອງ​ຂອງ​ດາວິດ”.<verse eid="1CH 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6" />ດາວິດ​ໄດ້​ເວົ້າ​ວ່າ, “ຜູ້ໃດ​ກໍ​ຕາມ​ທີ່​ບຸກ​ໂຈມ​ຕີ​ຊາວ​ເມືອງ​ເຢບຸດ​ໄດ້ ຈະ​ໄດ້​ເປັນ​ຜູ້​ບັນຊາການ​ທະຫານ”. ໂຢອາບ​ລູກຊາຍ​ຂອງ​ນາງ​ເຊຣູອີຢາ​ບຸກ​ໂຈມຕີ​ໄດ້​ເປັນ​ຄົນ​ທຳອິດ ແລະ ລາວ​ຈຶ່ງ​ໄດ້​ເປັນ​ຜູ້​ບັນຊາການ​ທະຫານ.<verse eid="1CH 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7" />ດາວິດ​ຈຶ່ງ​ເຂົ້າ​ໄປ​ອາໄສ​ຢູ່​ໃນ​ປ້ອມ​ນັ້ນ ແລະ ບ່ອນ​ນັ້ນ​ຈຶ່ງ​ຖືກເອີ້ນ​ວ່າ ເມືອງ​ຂອງ​ດາວິດ. <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />ເພິ່ນ​ໄດ້​ສ້າງ​ເມືອງ​ນັ້ນ​ຂຶ້ນ​ໃໝ່​ອ້ອມ​ຮອບ​ປ້ອມ​ນັ້ນ​ໄວ້​ເປັນ​ຊັ້ນ​ໆ<note caller="+" style="f"><char style="fr" closed="false">11:8 </char><char style="ft" closed="false">ຫລື ມິນໂລ</char></note> ໄປ​ຈົນ​ຮອດ​ກຳແພງ​ທີ່​ອ້ອມ​ເມືອງ. ໃນ​ຂະນະ​ທີ່​ໂຢອາບ​ໄດ້​ສ້ອມແປງ​ສ່ວນ​ທີ່​ເຫລືອ​ຂອງ​ເມືອງ. <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />ແລະ ດາວິດ​ກໍ​ມີ​ອໍານາດ​ຫລາຍ​ຂຶ້ນ​ເລື້ອຍໆ, ເພາະ​ພຣະເຈົ້າ​ຢາເວ​ຜູ້​ມີ​ລິດ​ອຳນາດ​ຍິ່ງໃຫຍ່​ໄດ້​ສະຖິດ​ຢູ່​ກັບ​ເພິ່ນ.<verse eid="1CH 11:9" /></para>
  <para style="s1">ບັນດາ​ນັກຮົບ​ທີ່​ມີ​ຊື່ສຽງ​ຂອງ​ດາວິດ</para>
  <para style="r">(2ຊມອ 23:8-39)</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />ຕໍ່ໄປ​ນີ້​ແມ່ນ​ຫົວໜ້າ​ນັກຮົບ​ທີ່​ມີ​ຊື່ສຽງ​ຂອງ​ດາວິດ, ພວກເຂົາ​ໄດ້​ຮ່ວມ​ກັບ​ຊາວ​ອິດສະຣາເອນ​ທັງໝົດ, ໄດ້​ສະໜັບສະໜູນ​ການ​ຂຶ້ນ​ເປັນ​ກະສັດ​ຂອງ​ດາວິດ​ໃຫ້​ເຂັ້ມແຂງ​ໄປ​ທົ່ວ​ແຜ່ນດິນ, ເຊິ່ງ​ເປັນ​ໄປ​ຕາມ​ທີ່​ພຣະເຈົ້າຢາເວ​ໄດ້​ສັນຍາ​ໄວ້. <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />ນີ້​ແມ່ນ​ລາຍຊື່​ບັນດາ​ນັກຮົບ​ທີ່​ມີ​ຊື່ສຽງ​ຂອງ​ດາວິດ ມີ​ດັ່ງນີ້:</para>
  <para style="p" vid="1CH 11:11">ຢາໂຊເບອາມ,<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">ອາດຈະ​ເປັນ​ອີກ​ຮູບ​ໜຶ່ງ​ຂອງ ຢາໂຊເບອາມ</char></note> ຊາວ​ຮັກໂມນີ​ເປັນ​ຫົວໜ້າ​ບັນດາ​ທະຫານ;<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">ຫລື ຫົວໜ້າ​ສາມ​ສິບ​ຍອດ​ນັກຮົບ ຫລື ຫົວໜ້າ​ສາມ​ຍອດ​ນັກຮົບ (ເບິ່ງ <char style="xt"><ref loc="2SA 23:8">2ຊມອ 23:8</ref></char>)</char></note> ລາວ​ໃຊ້​ຫອກ​ຕໍ່ສູ້​ທະຫານ​ສາມ​ຮ້ອຍ​ຄົນ, ຜູ້​ທີ່​ລາວ​ໄດ້​ຂ້າ​ພວກເຂົາ​ຖິ້ມ​ໝົດ​ໃນ​ຄັ້ງ​ດຽວ.<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />ຄົນ​ຕໍ່ມາ​ແມ່ນ​ເອເລອາຊາ ລູກຊາຍ​ຂອງ​ໂດໂດ​ຊາວ​ອາໂຮ, ລາວ​ເປັນ​ໜຶ່ງ​ໃນ​ສາມ​ທະຫານ​ຍອດ​ນັກຮົບ. <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />ລາວ​ຢູ່​ກັບ​ດາວິດ​ທີ່​ເມືອງ​ປັດດຳມິມ ເມື່ອ​ຊາວ​ຟີລິດສະຕິນ​ໄດ້​ມາ​ເຕົ້າໂຮມ​ກັນ​ຢູ່​ທີ່​ນັ້ນ​ເພື່ອ​ສູ້ຮົບ​ກັນ. ລາວ​ຢູ່​ໃນ​ທົ່ງນາ​ເຂົ້າ​ບາເລ, ກອງທະຫານ​ຂອງ​ອິດສະຣາເອນ​ໄດ້​ຖອຍ​ໜີ​ໄປ. <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />ແຕ່​ດາວິດ​ກັບ​ລາວ​ໄດ້​ປັກຫລັກ​ຕໍ່ສູ້​ຢູ່​ກາງ​ທົ່ງນາ. ພວກເຂົາ​ປົກປ້ອງ​ເມືອງ​ນັ້ນ​ໄວ້​ໄດ້ ແລະ ໄດ້​ຂ້າ​ຊາວ​ຟີລິດສະຕິນ​ຖີ້ມ, ແລະ ພຣະເຈົ້າຢາເວ​ໄດ້​ໃຫ້​ລາວ​ມີ​ໄຊຊະນະ​ຄັ້ງ​ຍິ່ງໃຫຍ່.<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />ຍອດ​ນັກຮົບ​ສາມ​ຄົນ​ໃນ​ສາມ​ສິບ​ຄົນ​ມາ​ຫາ​ດາວິດ​ທີ່​ໂງ່ນຫີນ​ແຫ່ງ​ໜຶ່ງ​ໃນ​ຖໍ້າ​ອາດຸນລຳ, ໃນຂະນະທີ່​ກອງ​ທະຫານ​ຂອງ​ຊາວ​ຟີລິດສະຕິນ​ກຸ່ມ​ໜຶ່ງ​ໄດ້​ຕັ້ງ​ຄ້າຍ​ຢູ່​ໃນ​ຮ່ອມພູ​ເຣຟາອິມ. <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />ໃນ​ເວລາ​ນັ້ນ​ດາວິດ​ຢູ່​ໃນ​ຖານ​ທີ່​ໝັ້ນ, ສ່ວນ​ກອງທະຫານ​ຂອງ​ຟີລິດສະຕິນ​ຢູ່​ທີ່​ເບັດເລເຮັມ. <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />ດາວິດ​ຫິວ​ນ້ຳ ແລະ ເວົ້າ​ຂຶ້ນ​ວ່າ “ຖ້າ​ມີ​ຜູ້ໃດ​ໄປ​ເອົາ​ນ້ຳ​ຈາກ​ສ້າງ​ໃກ້​ປະຕູ​ເມືອງ​ເບັດເລເຮັມ​ມາ​ໃຫ້​ເຮົາ​ດື່ມ​ກໍ​ຈະ​ດີ!” <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />ດັ່ງນັ້ນ ນັກຮົບ​ສາມ​ຄົນ​ກໍ​ຕີ​ຝ່າ​ແນວ​ຮົບ​ຂອງ​ຟີລິດສະຕິນ, ໄປ​ຕັກ​ນ້ຳ​ຈາກ​ສ້າງ​ໃກ້​ປະຕູ​ເມືອງ​ເບັດເລເຮັມ ແລ້ວ​ເອົາ​ນ້ຳ​ມາ​ໃຫ້​ດາວິດ. ແຕ່​ເພິ່ນ​ບໍ່​ຍອມ​ດື່ມ; ເພິ່ນ​ໄດ້​ຖອກ​ນໍ້າ​ລົງ​ໃຫ້​ແກ່​ພຣະເຈົ້າຢາເວ. <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />ເພິ່ນ​ກ່າວ​ວ່າ “ຂໍ​ພຣະເຈົ້າ​ຫ້າມ​ໄວ້​ບໍ່​ໃຫ້​ເຮົາ​ດື່ມ​ນ້ຳ​ນີ້!” “ສົມຄວນ​ບໍ​ທີ່​ເຮົາ​ຈະ​ດື່ມ​ເລືອດ​ຂອງ​ຄົນ​ເຫລົ່ານີ້​ທີ່​ໄດ້​ສ່ຽງ​ຊີວິດ​ຂອງ​ພວກເຂົາ​ເພື່ອ​ໄປ​ເອົາ​ມາ?” ເນື່ອງ​ຈາກ​ພວກເຂົາ​ສ່ຽງ​ຊີວິດ​ໄປ​ເອົາ​ນ້ຳ​ມາ, ດາວິດ​ຈຶ່ງ​ບໍ່​ຍອມ​ດື່ມ​ນໍ້າ​ນັ້ນ.</para>
  <para style="p" vid="1CH 11:19">ນີ້​ແມ່ນ​ວິລະກຳ​ຂອງ​ສາມ​ທະຫານ​ຍອດ​ນັກຮົບ.<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />ອາບີໄຊ ນ້ອງຊາຍ​ຂອງ​ໂຢອາບ​ເປັນ​ຫົວໜ້າ​ຂອງ​ນັກຮົບ​ທີ່​ມີ​ຊື່ສຽງ​ສາມ​ຄົນ. ລາວ​ໄດ້​ໃຊ້​ຫອກ​ຂອງ​ຕົນ​ຕໍ່ສູ້​ທະຫານ​ສາມຮ້ອຍ​ຄົນ, ລາວ​ໄດ້​ຂ້າ​ທະຫານ​ທັງໝົດ ແລະ ລາວ​ຈຶ່ງ​ກາຍ​ເປັນ​ຄົນ​ທີ່​ມີ​ຊື່ສຽງ​ເທົ່າກັນ​ກັບ​ສາມ​ທະຫານ​ຍອດ​ນັກຮົບ. <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />ລາວ​ມີ​ກຽດ​ສອງ​ເທົ່າ​ເໜືອ​ສາມ​ທະຫານ​ຍອດ​ນັກຮົບ ເຖິງ​ແມ່ນ​ວ່າ​ລາວ​ບໍ່​ໄດ້​ເປັນ​ໜຶ່ງ​ໃນ​ຈຳນວນ​ນັ້ນ​ກໍ​ຕາມ.<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />ເບນາອີຢາ​ລູກຊາຍ​ຂອງ​ເຢໂຮຍອາດາ​ເປັນ​ທະຫານ​ກ້າຫານ​ຈາກ​ເມືອງ​ກັບເຊເອນ​ຜູ້​ສ້າງ​ວິລະກຳ​ຫລາຍ​ຄັ້ງ. ລາວ​ໄດ້​ຂ້າ​ນັກຮົບ​ສີ​ມື​ດີ​ຂອງ​ຊາວ​ໂມອາບ​ສອງ​ຄົນ. ມີ​ຄັ້ງ​ໜຶ່ງ​ໃນ​ມື້​ທີ່​ຫິມະ​ຕົກ ລາວ​ໄດ້​ລົງ​ໄປ​ໃນ​ຫລຸມ ແລະ ໄດ້​ຂ້າ​ສິງ​ໂຕ​ໜຶ່ງ. <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />ແລະ ລາວ​ໄດ້​ຂ້າ​ຊາວ​ເອຢິບ​ຄົນ​ໜຶ່ງ ເຊິ່ງ​ສູງ​ປະມານ​ສອງ​ແມັດ​ເຄິ່ງ.<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">ຄື ປະມານ 2,3 ແມັດ</char></note> ເຖິງ​ແມ່ນ​ວ່າ​ຊາວ​ເອຢິບ​ນັ້ນ​ຖື​ຫອກ​ໃຫຍ່​ຄື​ກັນ​ກັບ​ໄມ້​ກຳພັ້ນຫູກ, ເບນາອີຢາ​ໄດ້​ໄປ​ຕໍ່ສູ້​ລາວ​ດ້ວຍ​ໄມ້ຄ້ອນ. ລາວ​ຍາດ​ເອົາ​ຫອກ​ຈາກ​ມື​ຂອງ​ຊາວ​ເອຢິບ​ນັ້ນ ແລະ ຂ້າ​ຊາວ​ເອຢິບ​ດ້ວຍ​ຫອກ​ນັ້ນ. <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />ນີ້​ຄື​ວິລະກຳ​ຂອງ​ເບນາອີຢາ​ລູກຊາຍ​ຂອງ​ເຢໂຮຍອາດາ, ລາວ​ກໍ​ມີ​ຊື່ສຽງ​ທຽບເທົ່າ​ກັບ​ສາມ​ທະຫານ​ຍອດ​ນັກຮົບ​ດ້ວຍ. <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />ລາວ​ມີ​ກຽດ​ຫລາຍ​ກວ່າ​ທຸກຄົນ​ໃນ​ສາມ​ສິບ​ຍອດ​ນັກຮົບ, ແຕ່​ລາວ​ບໍ່​ໄດ້​ລວມ​ຢູ່​ໃນ​ສາມ​ທະຫານ​ຍອດ​ນັກຮົບ ແລະ ດາວິດ​ໄດ້​ແຕ່ງຕັ້ງ​ລາວ​ໃຫ້​ເບິ່ງແຍງ​ກອງ​ທະຫານ​ປ້ອງກັນ​ຕົວ​ຂອງ​ເພິ່ນ.<verse eid="1CH 11:25" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="26" style="v" sid="1CH 11:26" />ພວກ​ນັກຮົບ​ທີ່​ມີ​ຊື່ສຽງ ມີ​ດັ່ງນີ້:</para>
  <para style="b" vid="1CH 11:26" />
  <para style="li1" vid="1CH 11:26">ອາສາເຮນ ນ້ອງຊາຍ​ຂອງ​ໂຢອາບ,</para>
  <para style="li1" vid="1CH 11:26">ເອນຮານານ ລູກຊາຍ​ຂອງ​ໂດໂດ ຈາກ​ເມືອງ​ເບັດເລເຮັມ,<verse eid="1CH 11:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 11:27" />ຊາມໂມດ ຊາວ​ຮາໂຣດ,</para>
  <para style="li1" vid="1CH 11:27">ເຮເລັດ ຊາວ​ເປໂລນ,<verse eid="1CH 11:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 11:28" />ອີຣາ ລູກຊາຍ​ຂອງ​ອິກເກັດ​ຈາກ​ເຕກົວ,</para>
  <para style="li1" vid="1CH 11:28">ອາບີເອເຊ ຈາກ​ອານາທົດ,<verse eid="1CH 11:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 11:29" />ສິບເບກາຍ ຊາວ​ຮູຊາ,</para>
  <para style="li1" vid="1CH 11:29">ອີໄລ ຊາວ​ອາໂຮ,<verse eid="1CH 11:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 11:30" />ມະຫາໄຣ ຊາວ​ເນໂຕຟາ,</para>
  <para style="li1" vid="1CH 11:30">ເຮເລັດ ລູກຊາຍ​ຂອງ​ບາອານາ ຊາວ​ເນໂຕຟາ,<verse eid="1CH 11:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 11:31" />ອິດໄຕ​ລູກຊາຍ​ຂອງ​ຣີໄບ​ຈາກ​ກີເບອາ​ໃນ​ເຜົ່າ​ເບັນຢາມິນ,</para>
  <para style="li1" vid="1CH 11:31">ເບນາອີຢາ ຊາວ​ປີຣາໂທນ,<verse eid="1CH 11:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 11:32" />ຮູໄຣ ຈາກ​ຮ່ອມພູ​ແຫ່ງ​ເມືອງ​ກາອາດ,</para>
  <para style="li1" vid="1CH 11:32">ອາບີເອນ ຊາວ​ອາຣະບາ,<verse eid="1CH 11:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 11:33" />ອາຊະມາເວດ ຊາວ​ບາຮູຣຸມ,</para>
  <para style="li1" vid="1CH 11:33">ເອລີອາບາ​ຄົນ​ຊາອານໂບນ,<verse eid="1CH 11:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 11:34" />ພວກ​ລູກຊາຍ​ຂອງ​ອາຮີອາມ ຊາວ​ກີໂຊນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li1" vid="1CH 11:34">ໂຢນາທານ ລູກຊາຍ​ຂອງ​ຊາກີ ຊາວ​ຮາຣາເຣ,<verse eid="1CH 11:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 11:35" />ອາຮີອາມ ລູກຊາຍ​ຂອງ​ສາກາ ຊາວ​ຮາຣາເຣ,</para>
  <para style="li1" vid="1CH 11:35">ເອລີຟັນ ລູກຊາຍ​ຂອງ​ອູເຣ,<verse eid="1CH 11:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 11:36" />ເຮເຟ ຊາວ​ເມເຄຣາ,</para>
  <para style="li1" vid="1CH 11:36">ອາຮີຢາ ຊາວ​ເປໂລນ,<verse eid="1CH 11:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 11:37" />ເຮຊະໂຣ ຊາວ​ກາເມນ,</para>
  <para style="li1" vid="1CH 11:37">ນາອາໄຣ ລູກຊາຍ​ຂອງ​ເອຊະໄບ,<verse eid="1CH 11:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 11:38" />ໂຢເອນ ນ້ອງຊາຍ​ຂອງ​ນາທານ,</para>
  <para style="li1" vid="1CH 11:38">ມິບຮາ ລູກຊາຍ​ຂອງ​ຮາກຣີ,<verse eid="1CH 11:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 11:39" />ເຊເລັກ ຊາວ​ອຳໂມນ,</para>
  <para style="li1" vid="1CH 11:39">ນາຮາໄຣ​ຊາວ​ເບເອໂຣດ ຄົນ​ຖື​ອາວຸດ​ໃຫ້​ໂຢອາບ​ລູກຊາຍ​ຂອງ​ນາງ​ເຊຣູອີຢາ,<verse eid="1CH 11:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 11:40" />ອີຣາ​ຊາວ​ອິດໄຣ,</para>
  <para style="li1" vid="1CH 11:40">ຄາເຣັບ​ຊາວ​ອິດໄຣ,<verse eid="1CH 11:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 11:41" />ອູຣິຢາ ຊາວ​ຮິດຕີ,</para>
  <para style="li1" vid="1CH 11:41">ຊາບັດ ລູກຊາຍ​ຂອງ​ອາຮະໄລ,<verse eid="1CH 11:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 11:42" />ອາດີນາ ລູກຊາຍ​ຂອງ​ຊີຊາ ຊາວ​ຣູເບັນ, ເຊິ່ງ​ເປັນ​ຫົວໜ້າ​ຂອງ​ຊາວ​ຣູເບັນ, ແລະ ເປັນ​ຫົວໜ້າ​ຂອງ​ທະຫານ​ສາມ​ສິບ​ຄົນ​ທີ່​ຢູ່​ກັບ​ລາວ,<verse eid="1CH 11:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 11:43" />ຮານານ ລູກຊາຍ​ຂອງ​ມາອາກາ,</para>
  <para style="li1" vid="1CH 11:43">ໂຢຊາຟັດ ຊາວ​ມີທານ,<verse eid="1CH 11:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 11:44" />ອຸດຊີອາ ຊາວ​ອາຊະເຕຣາ,</para>
  <para style="li1" vid="1CH 11:44">ຊາມມາ ແລະ ເຢອີເອນ ລູກຊາຍ​ຂອງ​ໂຮທາມ ຊາວ​ອາໂຣເອ,<verse eid="1CH 11:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 11:45" />ເຢດີອາເອນ​ລູກຊາຍ​ຂອງ​ຊິມຣີ</para>
  <para style="li1" vid="1CH 11:45">ແລະ ໂຢຮາ​ຊາວ​ຕີເຊ​ຜູ້​ເປັນ​ນ້ອງຊາຍ,<verse eid="1CH 11:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 11:46" />ເອລີເອນ ຊາວ​ມາຮາໄວ,</para>
  <para style="li1" vid="1CH 11:46">ເຢຣີໄບ ແລະ ໂຢຊາວີຢາ ລູກຊາຍ​ຂອງ​ເອນນາອາມ,</para>
  <para style="li1" vid="1CH 11:46">ອິດມາ ຊາວ​ໂມອາບ,<verse eid="1CH 11:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 11:47" />ເອລີເອນ, ໂອເບັດ ແລະ ຢາອາສີເອນ​ຊາວ​ໂຊບາ.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s1">ບັນດາ​ນັກຮົບ​ທີ່ຢູ່ກັບ​ດາວິດ</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 12:1" />ນັກຮົບ​ເຫຼົ່ານີ້​ໄດ້​ມາ​ຫາ​ດາວິດ​ທີ່​ຊິກລັກ ໃນຂະນະ​ທີ່​ເພິ່ນ​ຖືກ​ໂຊນ​ລູກຊາຍ​ຂອງ​ກີເຊ​ໄລ່ລ່າ​ຢູ່ (ພວກເຂົາ​ຢູ່​ໃນ​ພວກ​ຍອດ​ນັກຮົບ ທີ່​ໄດ້​ຊ່ວຍ​ດາວິດ​ໃນ​ການ​ຕໍ່ສູ້; <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />ພວກເຂົາ​ເປັນ​ນັກ​ທະນູ​ທີ່​ຊ່ຽວຊານ​ໃນ​ການ​ຍິງທະນູ ຫລື ສາມາດ​ໃຊ້​ແຂນ​ຊ້າຍ ຫລື ແຂນ​ຂວາ​ແກວ່ງ​ກ້ອນຫີນ​ໄດ້, ພວກເຂົາ​ເປັນ​ຍາດ​ພີ່ນ້ອງ​ຂອງ​ໂຊນ​ມາ​ຈາກ​ເຜົ່າ​ເບັນຢາມິນ) ມີ​ດັ່ງນີ້:<verse eid="1CH 12:2" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="3" style="v" sid="1CH 12:3" />ອາຮີເອເຊ​ເປັນ​ຫົວໜ້າ​ຂອງ​ພວກເຂົາ ແລະ ໂຢອາດ ລູກຊາຍ​ຂອງ​ເຊມາຢາ​ຊາວ​ກິເບອາ,</para>
  <para style="li1" vid="1CH 12:3">ເຢຊີເອນ ແລະ ເປເລດ ລູກຊາຍ​ຂອງ​ອາຊະມາເວດ</para>
  <para style="li1" vid="1CH 12:3">ເບຣາກາ ແລະ ເຢຮູ ຊາວ​ອານາທົດ, <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />ແລະ ອີຊະມາອີຢາ ຊາວ​ກີເບໂອນ, ເປັນ​ຍອດ​ນັກຮົບ​ຄົນ​ໜຶ່ງ​ທີ່​ຢູ່​ໃນ​ບັນດາ​ຍອດ​ນັກຮົບ​ສາມສິບ​ຄົນ;</para>
  <para style="li1" vid="1CH 12:4">ເຢເຣມີຢາ, ຢາຮາຊີເອນ, ໂຢຮານານ ແລະ ໂຢຊາບັດ ຊາວ​ເກເດຣາ. <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />ເອລູໄຊ, ເຢຣິໂມດ, ເບອາລີຢາ, ເຊມາຣີຢາ ແລະ ເຊຟາຕີຢາ ຊາວ​ຮາຣິບ,<verse eid="1CH 12:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 12:6" />ເອນການາ, ອິດຊີຢາ, ອາຊາເຣນ, ໂຢເອເຊ ແລະ ຢາໂຊເບອາມ​ຊາວ​ໂກຣາ;<verse eid="1CH 12:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 12:7" />ໂຢເອລາ ແລະ ເຊບາດີຢາ ລູກຊາຍ​ຂອງ​ເຢໂຣຮາມ​ຈາກ​ເກໂດເຣ.<verse eid="1CH 12:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />ຊາວ​ກາດ​ບາງ​ຄົນ​ກໍ​ໄດ້​ເຂົ້າ​ເປັນ​ຝ່າຍ​ຂອງ​ດາວິດ​ທີ່​ປ້ອມ​ປ້ອງກັນ​ໃນ​ຖິ່ນແຫ້ງແລ້ງກັນດານ. ພວກເຂົາ​ເປັນ​ນັກຮົບ​ກ້າ​ຫານ ແລະ ຊ່ຽວຊານ​ໃນ​ການ​ໃຊ້​ໂລ່ ແລະ ຫອກ​ພ້ອມ​ທີ່​ຈະ​ອອກ​ໄປ​ສູ້ຮົບ. ໜ້າ​ຂອງ​ພວກເຂົາ​ເປັນ​ເໝືອນ​ສິງ ແລະ ວ່ອງໄວ​ເໝືອນ​ກວາງ​ທີ່​ເທິງ​ພູເຂົາ.<verse eid="1CH 12:8" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9" />ເອເຊ​ເປັນ​ຫົວໜ້າ,</para>
  <para style="li1" vid="1CH 12:9">ໂອບາດີຢາ​ເປັນ​ຄົນ​ທີ​ຮອງ​ຜູ້​ທີ​ສອງ ເອລີອາບ​ເປັນ​ຮອງ​ທີ​ສາມ,<verse eid="1CH 12:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10" />ມີຊະມັນນາ​ເປັນ​ຄົນ​ທີ​ສີ່, ເຢເຣມີຢາ​ເປັນຄົນ​ທີ​ຫ້າ,<verse eid="1CH 12:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11" />ອັດໄຕ​ເປັນ​ຄົນ​ທີຫົກ, ເອລີເອນ​ເປັນ​ຄົນ​ທີ​ເຈັດ,<verse eid="1CH 12:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12" />ໂຢຮານັນ​ເປັນ​ຄົນ​ທີແປດ, ເອນຊາບັດ​ເປັນ​ຄົນ​ທີ​ເກົ້າ,<verse eid="1CH 12:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13" />ເຢເຣມີຢາ​ເປັນ​ຄົນ​ທີ​ສິບ, ແລະ ມາກະບານໄນ​ເປັນ​ຄົນ​ທີ​ສິບເອັດ.<verse eid="1CH 12:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14" />ຊາວ​ກາດ​ເຫລົ່ານີ້​ເປັນ​ຜູ້ບັນຊາການ​ກອງທັບ; ກອງທັບ​ນ້ອຍ​ທີ່ສຸດ​ແມ່ນ​ກອງຮ້ອຍ ແລະ ຜູ້​ທີ່​ບັນຊາ​ກອງທັບ​ໃຫຍ່​ທີ່ສຸດ​ແມ່ນ​ກອງພັນ. <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />ພວກເຂົາ​ໄດ້​ຂ້າມ​ແມ່ນ້ຳ​ຈໍແດນ​ໄປ​ໃນ​ເດືອນ​ທີ​ໜຶ່ງ ເຊິ່ງ​ເປັນ​ລະດູ​ນ້ຳ​ຖ້ວມ​ລົ້ນ​ຝັ່ງ ແລະ ພວກເຂົາ​ໄດ້​ສູ້ຮົບ​ກັບ​ທຸກຄົນ​ທີ່ອາໄສ​ຢູ່​ໃນ​ຮ່ອມພູ​ທາງ​ຕາເວັນອອກ ແລະ ທາງ​ຕາເວັນຕົກ.<verse eid="1CH 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />ຊາວ​ເບັນຢາມິນ​ຄົນ​ອື່ນໆ ແລະ ບາງ​ຄົນ​ມາ​ຈາກ​ເຜົ່າ​ຢູດາ​ໄດ້​ມາ​ຫາ​ດາວິດ​ທີ່​ປ້ອມ​ປ້ອງກັນ. <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />ດາວິດ​ໄດ້​ອອກ​ໄປ​ພົບ​ພວກເຂົາ ແລະ ກ່າວ​ແກ່​ພວກເຂົາ​ວ່າ, “ຖ້າ​ພວກ​ເຈົ້າ​ມາ​ຫາ​ເຮົາ​ຢ່າງ​ສັນຕິ ເພື່ອ​ມາ​ຊ່ວຍເຫລືອ​ເຮົາ, ເຮົາ​ກໍ​ພ້ອມ​ທີ່​ຈະ​ໃຫ້​ພວກເຈົ້າ​ເຂົ້າ​ຮ່ວມ​ກັບ​ເຮົາ. ແຕ່​ຖ້າ​ພວກເຈົ້າ​ມາ​ທໍລະຍົດ​ມອບ​ເຮົາ​ໃຫ້​ແກ່​ສັດຕູ​ຂອງ​ເຮົາ​ທັງ​ທີ່​ມື​ຂອງ​ເຮົາ​ບໍ່​ໄດ້​ທຳຮ້າຍ​ຜູ້ໃດ ກໍ​ຂໍ​ໃຫ້​ພຣະເຈົ້າ​ຂອງ​ບັນພະບຸລຸດ​ຂອງ​ເຮົາ​ເບິ່ງ ແລະ ຕັດສິນ​ໂທດ​ພວກທ່ານ​ດ້ວຍ”.<verse eid="1CH 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18" />ແລ້ວ​ພຣະວິນຍານ​ລົງ​ມາ​ເໜືອ​ອາມາໄສ, ຜູ້​ທີ່​ເປັນ​ຫົວໜ້າ​ຍອດ​ນັກຮົບ​ສາມສິບ​ຄົນ ແລະ ລາວ​ເວົ້າ​ວ່າ:</para>
  <para style="q1" vid="1CH 12:18">“ດາວິດ, ພວກເຮົາ​ຢູ່​ຝ່າຍ​ທ່ານ!</para>
  <para style="q2" vid="1CH 12:18">ລູກຊາຍ​ຂອງ​ເຢຊີ, ພວກເຮົາ​ເປັນ​ຝ່າຍ​ທ່ານ!</para>
  <para style="q1" vid="1CH 12:18">ຄວາມ​ສຳເລັດ​ຈົ່ງ​ເປັນ​ຂອງ​ທ່ານ</para>
  <para style="q2" vid="1CH 12:18">ຄວາມ​ສຳເລັດ​ຈົ່ງ​ເປັນ​ຂອງ​ທຸກຄົນ​ທີ່​ຊ່ວຍເຫລືອ​ທ່ານ,</para>
  <para style="q3" vid="1CH 12:18">ເພາະ​ພຣະເຈົ້າ​ຂອງ​ທ່ານ​ຈະ​ຊ່ວຍ​ທ່ານ”.</para>
  <para style="p" vid="1CH 12:18">ດາວິດ​ຈຶ່ງ​ໄດ້​ຮັບ​ເອົາ​ພວກເຂົາ​ໄວ້ ແລະ ໄດ້​ແຕ່ງຕັ້ງ​ພວກເຂົາ​ໃຫ້​ເປັນ​ຫົວໜ້າ​ກອງ​ທະຫານ​ແນວ​ໜ້າ.<verse eid="1CH 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />ມີ​ບາງຄົນ​ຈາກ​ເຜົ່າ​ມານາເຊ​ໄດ້​ເຂົ້າ​ເປັນ​ຝ່າຍ​ຂອງ​ດາວິດ​ເມື່ອ​ເພິ່ນ​ຢູ່​ກັບ​ພວກ​ຟີລິດສະຕິນ​ເພື່ອ​ສູ້ຮົບ​ໂຊນ. (ດາວິດ ແລະ ພວກ​ຂອງ​ເພິ່ນ​ບໍ່​ໄດ້​ຊ່ວຍ​ຊາວ​ຟີລິດສະຕິນ​ສູ້ຮົບ, ເພາະ​ຫລັງຈາກ​ພວກ​ຜູ້ປົກຄອງ​ຂອງ​ຟີລິດສະຕິນ​ໄດ້​ປຶກສາ​ກັນ​ແລ້ວ, ກໍ​ໄດ້​ໄລ່​ເພິ່ນ​ໃຫ້​ກັບ​ໄປ. ພວກເຂົາ​ເວົ້າ​ວ່າ, “ຖ້າ​ລາວ​ປະຖິ້ມ​ພວກເຮົາ ກັບຄືນ​ໄປ​ຫາ​ໂຊນ ນາຍ​ເກົ່າ​ຂອງ​ລາວ ຫົວ​ຂອງ​ພວກເຮົາ​ຈະ​ຫຼຸດ​ອອກ​ຈາກ​ບ່າ”.) <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />ເມື່ອ​ດາວິດ​ໄປ​ທີ່​ຊິກລັກ, ພວກ​ຜູ້ຊາຍ​ມາ​ຈາກ​ເຜົ່າ​ມານາເຊ​ໄດ້​ເຂົ້າ​ເປັນ​ຝ່າຍ​ຂອງ​ດາວິດ​ມີ​ດັ່ງນີ້: ອັດນາ, ໂຢຊາບັດ, ເຢດີອາເອນ, ມີກາເອນ, ໂຢຊາບັດ, ເອລີຮູ ແລະ ຊິນເລໄທ. ພວກເຂົາ​ເປັນ​ຫົວໜ້າ​ໜ່ວຍ​ຂອງ​ກອງພັນ​ໃນ​ມານາເຊ. <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />ພວກເຂົາ​ທຸກ​ຄົນ​ເປັນ​ນັກຮົບ​ກ້າຫານ ແລະ ເປັນ​ຜູ້ບັນຊາການ​ໃນ​ກອງທັບ​ຂອງ​ເພິ່ນ, ທີ່​ໄດ້​ຊ່ວຍເຫລືອ​ດາວິດ​ຕໍ່ສູ້​ກັບ​ພວກ​ທະຫານ​ແນວ​ໜ້າ. <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />ແຕ່​ລະ​ມື້ ໄດ້​ມີ​ຄົນ​ເຂົ້າ​ຊ່ວຍ​ດາວິດ, ຈົນ​ວ່າ​ດາວິດ​ມີ​ກອງທັບ​ທີ່​ໃຫຍ່​ເໝືອນດັ່ງ​ກອງທັບ​ຂອງ​ພຣະເຈົ້າ.<note caller="+" style="f"><char style="fr" closed="false">12:22 </char><char style="ft" closed="false">ຫລື ກອງທັບ​ຍິ່ງໃຫຍ່ ແລະ ລິດ​ອາ​ນຸ​ພາບ</char></note><verse eid="1CH 12:22" /></para>
  <para style="s1">ຄົນ​ອື່ນໆ​ທີ່​ມາ​ຮ່ວມ​ກັບ​ດາວິດ​ທີ່​ເມືອງ​ເຮັບໂຣນ</para>
  <para style="lh">
    <verse number="23" style="v" sid="1CH 12:23" />ຕໍ່ໄປ​ນີ້​ເປັນ​ຈຳນວນ​ກອງ​ທະຫານ​ທີ່​ຕຽມພ້ອມ​ສູ້ຮົບ​ທີ່​ມາ​ຫາ​ດາວິດ​ທີ່​ເມືອງ​ເຮັບໂຣນ​ເພື່ອ​ຈະ​ເຮັດ​ໃຫ້​ອານາຈັກ​ຂອງ​ໂຊນ​ເປັນ​ຂອງ​ເພິ່ນ, ຕາມ​ຖ້ອຍຄຳ​ຂອງ​ພຣະເຈົ້າຢາເວ​ໄດ້​ກ່າວ​ໄວ້ ມີ​ດັ່ງນີ້:<verse eid="1CH 12:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24" />ມາ​ຈາກ​ເຜົ່າ​ຢູດາ, ມີ​ທະຫານ​ຫົກ​ພັນ​ແປດຮ້ອຍ​ຄົນ ທີ່​ຖື​ໂລ້ ແລະ ຫອກ,<verse eid="1CH 12:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25" />ມາ​ຈາກ​ເຜົ່າ​ຊີເມໂອນ, ມີ​ທະຫານ​ເຈັດພັນ​ໜຶ່ງ​ຮ້ອຍ​ຄົນ​ທີ່​ພ້ອມ​ອອກ​ໄປ​ສູ້ຮົບ,<verse eid="1CH 12:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26" />ມາ​ຈາກ​ເລວີ, ມີ​ທະຫານ​ສີ່​ພັນ​ຫົກຮ້ອຍ​ຄົນ, <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />ລວມ​ທັງ​ເຢໂຮຍອາດາ, ທີ່​ເປັນ​ຫົວໜ້າ​ໃນ​ຄອບຄົວ​ຂອງ​ອາໂຣນ​ພ້ອມ​ກັບ​ທະຫານ​ສາມພັນ​ເຈັດຮ້ອຍ​ຄົນ, <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />ແລະ ຊາດົກ​ນັກຮົບ​ໜຸ່ມ​ທີ່​ກ້າຫານ​ພ້ອມ​ກັບ​ເຈົ້າໜ້າທີ່ 22 ຄົນ​ມາຈາກ​ຄອບຄົວ​ຂອງ​ລາວ<verse eid="1CH 12:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29" />ມາຈາກ​ເຜົ່າ​ເບັນຢາມິນ, ທີ່​ເປັນ​ເຜົ່າ​ຂອງ​ໂຊນ ມີ​ສາມພັນ​ຄົນ, ຄົນ​ສ່ວນ​ຫລາຍ​ຍັງ​ຈົ່ງ​ຮັກ​ພັກ​ດີ​ຕໍ່​ເຊື້ອວົງ​ຂອງ​ໂຊນ​ຢູ່.<verse eid="1CH 12:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30" />ມີ​ນັກຮົບ​ກ້າຫານ​ຈາກ​ເອຟຣາອິມ 20.800 ຄົນ ລ້ວນ​ແຕ່​ມີ​ຊື່ສຽງ​ດີ​ໃນ​ຕະກຸນ​ຂອງ​ຕົນ.<verse eid="1CH 12:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31" />ເຜົ່າ​ມານາເຊ​ເຄິ່ງ​ເຜົ່າ​ສົ່ງ​ຄົນ​ມາ​ຕາມ​ລາຍຊື່​ທີ່​ລະບຸ​ໄວ 18.000 ຄົນ, ເພື່ອ​ຕັ້ງ​ດາວິດ​ເປັນ​ກະສັດ;<verse eid="1CH 12:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32" />ມີ​ຫົວໜ້າ​ຕະກຸນ​ຈາກ​ອິດຊາຄາ 200 ຄົນ ພ້ອມ​ທັງ​ຍາດພີ່ນ້ອງ​ທີ່​ຢູ່​ໃຕ້​ບັງຄັບ​ບັນຊາ​ຂອງ​ພວກເຂົາ​ທຸກຄົນ​ທີ່​ເຂົ້າໃຈ​ຈັງຫວະ​ເວລາ ແລະ ຮູ້​ວ່າ​ອິດສະຣາເອນ​ຄວນ​ເຮັດ​ຫຍັງ.<verse eid="1CH 12:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33" />ມີ​ນັກຮົບ​ທີ່​ມີ​ປະສົບການ​ຈາກ​ເຊບູໂລນ 5.000 ຄົນ ທີ່​ກຽມພ້ອມ​ອອກ​ສູ້ຮົບ​ໂດຍ​ໃຊ້​ອາວຸດ​ທຸກ​ຊະນິດ ແລະ ມີ​ຄວາມຈົງ​ຮັກ​ພັກ​ດີ​ຕໍ່​ດາວິດ​ຢ່າງ​ແນ່ວ​ແນ່;<verse eid="1CH 12:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34" />ມີ​ເຈົ້າໜ້າທີ່​ຈາກ​ເນັບທາລີ 1.000 ຄົນ ແລະ ທະຫານ 37.000 ຄົນ ຖື​ໂລ່ ແລະ ຫອກ;<verse eid="1CH 12:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35" />ຈາກ​ດານ​ມີ 28.000 ຄົນ ທີ່​ພ້ອມ​ອອກ​ສູ້ຮົບ.<verse eid="1CH 12:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36" />ມີ​ທະຫານ​ທີ່​ມີ​ປະສົບການ​ຈາກ​ອາເຊ 40.000 ຄົນ ທີ່​ກຽມພ້ອມ​ອອກ​ສູ້ຮົບ.<verse eid="1CH 12:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37" />ຊົນເຜົ່າ​ຣູເບັນ, ກາດ ແລະ ມານາເຊ​ເຄິ່ງ​ເຜົ່າ ແລະ ມາ​ຈາກ​ຟາກ​ຕາເວັນ​ອອກ​ຂອງ​ແມ່ນ້ຳ​ຈໍແດນ 120.000 ຄົນ ມີ​ອາວຸດ​ທຸກ​ຊະນິດ.<verse eid="1CH 12:37" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="38" style="v" sid="1CH 12:38" />ທັງໝົດ​ນີ້​ເປັນ​ນັກຮົບ​ທີ່​ສະໝັກໃຈ​ເພື່ອ​ຮັບໃຊ້​ຢູ່​ໃນ​ຕຳແໜ່ງ​ຕ່າງໆ.</para>
  <para style="b" vid="1CH 12:38" />
  <para style="p" vid="1CH 12:38">ພວກເຂົາ​ໄດ້​ມາ​ທີ່​ເມືອງ​ເຮັບໂຣນ​ດ້ວຍ​ຄວາມ​ເຕັມໃຈ ເພື່ອ​ຈະ​ເຊີນ​ດາວິດ​ຂຶ້ນ​ເປັນ​ກະສັດ​ປົກຄອງ​ເໜືອ​ອິດສະຣາເອນ​ທັງໝົດ. ສ່ວນ​ປະຊາຊົນ​ອິດສະຣາເອນ​ອື່ນໆ​ທັງໝົດ ກໍ​ເປັນ​ນໍ້າໜຶ່ງ​ໃຈ​ດຽວ​ກັນ​ທີ່​ຈະ​ຕັ້ງ​ດາວິດ​ເປັນ​ກະສັດ. <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />ພວກເຂົາ​ໄດ້​ກິນ ແລະ ດື່ມ​ຮ່ວມ​ກັບ​ດາວິດ​ເປັນ​ເວລາ​ສາມ​ວັນ ເພາະ​ຄອບຄົວ​ຂອງ​ພວກເຂົາ​ໄດ້​ຈັດ​ຫາ​ອາຫານ​ມາ​ໃຫ້​ພວກເຂົາ. <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />ທັງ​ຍັງ​ມີ​ປະຊາຊົນ​ທັງ​ໃກ້ ແລະ ໄກ ເຊັ່ນ ອິດຊາຄາ, ເຊບູໂລນ ແລະ ເນັບທາລີ​ໄດ້​ນຳ​ອາຫານ​ໃສ່​ລໍ, ອູດ, ມ້າລໍ ແລະ ງົວ. ນອກ​ຈາກ​ນັ້ນ​ກໍ​ໄດ້​ນຳ​ສິ່ງຂອງ​ຈຳນວນ​ຫລວງຫລາຍ​ມາ​ຮ່ວມ​ງານ​ສະຫລອງ​ນີ້​ໄດ້​ແກ່ ແປ້ງ, ຂະໜົມ​ໝາກເດື່ອ, ຂະໜົມ​ໝາກ​ອະງຸ່ນ​ແຫ້ງ, ເຫລົ້າ​ອະງຸ່ນ, ນໍ້າມັນ​ໝາກກອກ, ງົວ ແລະ ແກະ, ເພາະ​ມີ​ຄວາມ​ຊື່ນຊົມ​ຍິນດີ​ໃນ​ອິດສະຣາເອນ.<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s1">ການນຳເອົາ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ກັບຄືນ​ມາ</para>
  <para style="r">(2ຊມອ 6:1-11)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />ດາວິດ​ໄດ້​ປຶກສາ​ກັບ​ນາຍ​ທະຫານ ທີ່​ເປັນ​ຜູ້ບັນຊາການ​ກອງ​ພັນ ແລະ ກອງ​ຮ້ອຍ​ແຕ່ລະຄົນ. <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />ແລ້ວ​ເພິ່ນ​ເວົ້າ​ກັບ​ຊຸມຊົນ​ອິດສະຣາເອນ​ທັງໝົດ​ວ່າ “ຖ້າ​ພວກທ່ານ​ທັງຫລາຍ​ເຫັນ​ດີ ແລະ ຖ້າ​ເປັນ​ຄວາມປະສົງ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ​ຂອງ​ພວກເຮົາ, ຈົ່ງ​ໃຫ້​ພວກເຮົາ​ສົ່ງ​ຂ່າວ​ໄປ​ເຖິງ​ພີ່ນ້ອງ​ທີ່​ຍັງເຫລືອ​ຂອງ​ພວກເຮົາ​ທົ່ວ​ເຂດແດນ​ຂອງ​ອິດສະຣາເອນ​ທີ່​ຢູ່​ໃກ້ ຫລື ຢູ່​ໄກ ແລະ ໄປ​ຫາ​ບັນດາ​ປະໂລຫິດ ແລະ ພວກ​ເລວີ​ທີ່​ຢູ່​ໃນ​ເມືອງ ແລະ ຢູ່​ໃນ​ທົ່ງຫຍ້າ​ຂອງ​ພວກເຂົາ​ໃຫ້​ມາ​ຮ່ວມ​ກັບ​ພວກເຮົາ. <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />ໃຫ້​ພວກເຮົາ​ນຳ​ເອົາ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າ​ຂອງ​ພວກເຮົາ​ກັບຄືນ​ມາ, ເພາະ​ໃນ​ໄລຍະ​ຂອງ​ກະສັດ​ໂຊນ ພວກເຮົາ​ໄດ້​ສອບຖາມ​ກ່ຽວກັບ​ເລື່ອງ​ນີ້<note caller="+" style="f"><char style="fr" closed="false">13:3 </char><char style="ft" closed="false">ຫລື ເຮົາ​ໄດ້​ລະ​ເລີຍ​ພຣະອົງ ຫລື ເຮົາ​ບໍ່​ໄດ້​ທູນ​ຖາມ​ພຣະອົງ</char></note>” <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />ປະຊາຊົນ​ທັງໝົດ​ກໍ​ໄດ້​ເຫັນ​ພ້ອມ​ກັນ​ທີ່​ຈະ​ເຮັດ​ສິ່ງ​ນີ້, ເພາະ​ພວກເຂົາ​ເຫັນ​ວ່າ​ເປັນ​ສິ່ງ​ຖືກຕ້ອງ.<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />ສະນັ້ນ ດາວິດ​ຈຶ່ງ​ໄດ້​ປະຊຸມ​ກັບ​ປະຊາຊົນ​ອິດສະຣາເອນ​ທັງໝົດ ຕັ້ງ​ແຕ່​ແມ່ນ້ຳ​ຊີໂຮເຣ​ໃນ​ເອຢິບ​ຈົນ​ເຖິງ​ເມືອງ​ເລໂບຮາມັດ,<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false">ຫລື ທາງ​ເຂົ້າ​ສູ່​ຮາມັດ</char></note> ເພື່ອ​ນຳ​ເອົາ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າ​ອອກ​ມາ​ຈາກ​ເມືອງ​ກີຣີອາດ​ເຢອາຣີມ. <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />ດາວິດ ແລະ ປະຊາຊົນ​ອິດສະຣາເອນ​ທັງໝົດ​ຈຶ່ງ​ໄປ​ທີ່​ເມືອງ​ບາອາລາ​ແຫ່ງ​ຢູດາຍ (ເມືອງ​ກີຣີອາດ​ເຢອາຣີມ) ເພື່ອ​ນຳ​ເອົາ​ຫີບ​ພັນທະສັນຍາ​ຂອງ​ພຣະເຈົ້າ​ຄື ພຣະເຈົ້າຢາເວ, ຜູ້​ທີ່​ສະຖິດ​ຢູ່​ລະຫວ່າງ​ເຄຣຸບ ແລະ ຫີບ​ຄໍາໝັ້ນສັນຍາ​ທີ່​ໄດ້ເອີ້ນ​ຕາມ​ນາມຊື່​ນັ້ນ.<verse eid="1CH 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7" />ພວກເຂົາ​ໄດ້​ຍ້າຍ​ຫີບ​ພັນທະສັນຍາ​ຂອງ​ພຣະເຈົ້າ​ອອກ​ຈາກ​ເຮືອນ​ຂອງ​ອາບີນາດາບ​ຂຶ້ນ​ໃສ່​ເທິງ​ກວຽນ​ໃໝ່​ໂດຍ​ມີ​ອຸດຊາ ແລະ ອາຮີໂອ​ເປັນ​ຜູ້​ນຳ​ທາງ. <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />ດາວິດ ແລະ ປະຊາຊົນ​ອິດສະຣາເອນ​ທັງໝົດ​ໄດ້​ສະເຫຼີມ​ສະຫລອງ​ຢ່າງ​ສຸດ​ກໍາລັງ​ຂອງ​ພວກເຂົາ​ຕໍ່ໜ້າ​ພຣະເຈົ້າ​ດ້ວຍ​ການ​ຮ້ອງເພງ ແລະ ບັນເລງ​ດົນຕີ​ດ້ວຍ​ພິນເຂົາຄູ່, ພິນ​ໃຫຍ່, ກອງແຊັກ, ແສ່ງ ແລະ ແກ.<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />ເມື່ອ​ພວກເຂົາ​ມາ​ຮອດ​ລານ​ຟາດເຂົ້າ​ຂອງ​ກີໂດນ ເພາະ​ງົວ​ໄດ້​ແຕະ​ສະດຸດ, ອຸດຊາ​ໄດ້​ຈັບ​ຫີບ​ພັນທະສັນຍາ​ເພື່ອ​ປະຄອງ​ຫີບ​ນັ້ນ​ໄວ້. <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />ຄວາມ​ໂກດຮ້າຍ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ຈຶ່ງ​ພຸ່ງ​ຂຶ້ນ​ຕໍ່​ອຸດຊາ ແລະ ພຣະອົງ​ໄດ້​ຂ້າ​ລາວ ເພາະ​ລາວ​ໄດ້​ແຕະຕ້ອງ​ຫີບ​ພັນທະສັນຍາ​ນັ້ນ. ດັ່ງນັ້ນ ລາວ​ໄດ້​ຕາຍ​ຢູ່​ທີ່​ນັ້ນ​ຕໍ່ໜ້າ​ພຣະເຈົ້າ.<verse eid="1CH 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11" />ຫລັງຈາກນັ້ນ ດາວິດ​ກໍ​ໃຈຮ້າຍ​ເພາະ​ຄວາມ​ໂກດຮ້າຍ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ຕໍ່ສູ້​ອຸດຊາ ແລະ ຈົນ​ເຖິງ​ທຸກວັນ​ນີ້​ສະຖານທີ່​ແຫ່ງ​ນັ້ນ​ຈຶ່ງ​ໄດ້​ຖືກ​ເອີ້ນ​ວ່າ ເປເຣັດອຸດຊາ<note caller="+" style="f"><char style="fr" closed="false">13:11 </char><char style="ft" closed="false">ແປ​ວ່າ ໄພພິບັດ​ແກ່​ອຸດຊາ</char></note>.<verse eid="1CH 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12" />ໃນ​ມື້​ນັ້ນ​ດາວິດ​ກໍ​ຢ້ານກົວ​ພຣະເຈົ້າ ແລະ ຖາມ​ວ່າ, “ເຮົາ​ຈະ​ນຳເອົາ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າ​ໄປ​ກັບ​ເຮົາ​ໄດ້​ຢ່າງໃດ?” <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />ດາວິດ​ຈຶ່ງ​ບໍ່​ໄດ້​ນຳ​ເອົາ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ໄປ​ຢູ່​ນໍາເພິ່ນ​ທີ່​ເມືອງ​ດາວິດ. ແຕ່​ເພິ່ນ​ໄດ້​ນໍາ​ເອົາ​ຫີບ​ໄປ​ໄວ້​ທີ່​ເຮືອນ​ຂອງ​ໂອເບັດເອໂດມ​ຊາວ​ເມືອງ​ກາດ​ແທນ. <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າ​ຢູ່​ກັບ​ຄອບຄົວ​ຂອງ​ໂອເບັດເອໂດມ​ເປັນ​ເວລາ​ສາມ​ເດືອນ ແລ້ວ​ພຣະເຈົ້າຢາເວ​ໄດ້​ອວຍພອນ​ຄອບຄົວ​ຂອງ​ລາວ ແລະ ທຸກ​ສິ່ງ​ທີ່​ລາວ​ໄດ້​ເຮັດ.<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s1">ຄອບຄົວ​ຂອງ​ດາວິດ</para>
  <para style="r">(2ຊມອ 5:11-16; 1ຂຄ 3:5-8)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />ກະສັດ​ຮີຣາມ​ແຫ່ງ​ເມືອງ​ຕີເຣ​ໄດ້​ສົ່ງ​ຄະນະທູດ​ມາ​ພົບ​ດາວິດ ພ້ອມ​ທັງ​ຊ່າງ​ກໍ່​ຫີນ, ຊ່າງ​ໄມ້ ແລະ ຕົ້ນໄມ້​ສີດາ​ມາ​ເພື່ອ​ສ້າງ​ວັງ​ຂອງ​ດາວິດ. <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />ແລະ ດາວິດ​ຮູ້​ວ່າ ພຣະເຈົ້າຢາເວ​ໄດ້​ຕັ້ງ​ເພິ່ນ​ໃຫ້​ເປັນ​ກະສັດ​ປົກຄອງ​ເໜືອ​ອິດສະຣາເອນ ແລະ ອານາຈັກ​ຂອງ​ເພິ່ນ​ຈະ​ໄດ້​ຮັບ​ການ​ຍົກ​ຂຶ້ນ​ເປັນ​ຢ່າງ​ສູງ ເພື່ອ​ເຫັນ​ແກ່​ອິດສະຣາເອນ​ປະຊາຊົນ​ຂອງ​ພຣະອົງ.<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />ໃນ​ນະຄອນ​ເຢຣູຊາເລັມ​ດາວິດ​ມີ​ເມຍ​ຕື່ມ​ອີກ ແລະ ມີ​ລູກຊາຍ ແລະ ລູກສາວ​ຫລາຍ​ຄົນ. <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />ລູກ​ຂອງ​ເພິ່ນ​ທີ່​ໄດ້​ເກີດ​ຢູ່​ທີ່ນັ້ນ​ມີ​ຊື່​ດັ່ງນີ້: ຊາມມູອາ, ໂຊບັບ, ນາທານ, ໂຊໂລໂມນ, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />ອິບຮາ, ເອລີຊູອາ, ເອນເປເລັດ, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />ໂນຄາ, ເນເຟັກ, ຢາເຟຍ, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />ເອລີຊາມາ, ເບເອລີອາດາ,<note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="fq" closed="false">ເບເອລີອາດາ: </char><char style="ft" closed="false">ໃນ 3:8 ແລະ 2 ຊມອ 5:16 ເອີ້ນ​ວ່າ </char><char style="fqa" closed="false">ເອລີອາດາ.</char></note> ແລະ ເອລີເຟເລັດ.<verse eid="1CH 14:7" /></para>
  <para style="s1">ດາວິດ​ເອົາ​ຊະນະ​ຊາວ​ຟີລິດສະຕິນ</para>
  <para style="r">(2ຊມອ 5:17-25)</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />ເມື່ອ​ຊາວ​ຟີລິດສະຕິນ​ໄດ້​ຍິນ​ວ່າ​ດາວິດ​ໄດ້​ຮັບ​ການ​ຫົດສົງ​ໃຫ້​ຂຶ້ນ​ເປັນ​ກະສັດ​ປົກຄອງ​ເໜືອ​ທົ່ວ​ອິດສະຣາເອນ​ທັງໝົດ, ພວກເຂົາ​ຈຶ່ງ​ຍົກ​ທັບ​ມາ​ທັງໝົດ​ເພື່ອ​ຊອກ​ຫາ​ເພິ່ນ, ແຕ່​ດາວິດ​ໄດ້​ຍິນ​ເລື່ອງ​ນີ້ ແລ້ວ​ຈຶ່ງ​ອອກ​ໄປ​ພົບ​ພວກເຂົາ. <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />ເມື່ອ​ຊາວ​ຟີລິດສະຕິນ​ມາ​ຮອດ ແລະ ໄດ້​ບຸກ​ເຂົ້າ​ໄປ​ໃນ​ຮ່ອມພູ​ເຣຟາອິມ; <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />ດາວິດ​ຈຶ່ງ​ຖາມ​ພຣະເຈົ້າ​ວ່າ: “ຈະ​ໃຫ້​ຂ້ານ້ອຍ​ອອກ​ໄປ​ໂຈມຕີ​ພວກ​ຟີລິດສະຕິນ​ບໍ່? ພຣະອົງ​ຈະ​ມອບ​ພວກເຂົາ​ໄວ້​ໃນ​ມື​ຂອງ​ຂ້ານ້ອຍ​ບໍ?”</para>
  <para style="p" vid="1CH 14:10">ພຣະເຈົ້າຢາເວ​ໄດ້​ຕອບ​ເພິ່ນ​ວ່າ, “ຈົ່ງ​ໄປ, ເຮົາ​ຈະ​ມອບ​ພວກເຂົາ​ໄວ້​ໃນ​ມື​ຂອງ​ເຈົ້າ”.<verse eid="1CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11" />ດັ່ງນັ້ນ ດາວິດ​ກັບ​ພວກ​ທະຫານ​ຈຶ່ງ​ຂຶ້ນ​ໄປ​ທີ່​ບາອານເປຣາຊິມ, ເພິ່ນ​ໄດ້​ເອົາ​ຊະນະ​ພວກເຂົາ​ຢູ່​ທີ່​ນັ້ນ. ເພິ່ນ​ເວົ້າ​ວ່າ “ພຣະເຈົ້າ​ໄດ້​ທໍາລາຍ​ສັດຕູ​ຂອງ​ຂ້າພະເຈົ້າ​ດ້ວຍ​ມື​ຂອງ​ຂ້າພະເຈົ້າ​ເໝືອນດັ່ງ​ກະແສ​ນໍ້າ​ທີ່​ໄຫລ​ທະລຸ​ໄປ” ສະນັ້ນ ບ່ອນນັ້ນ​ຈຶ່ງ​ໄດ້​ຖືກເອີ້ນ​ວ່າ ບາອານ​ເປຣາຊິມ.<note caller="+" style="f"><char style="fr" closed="false">14:11 </char><char style="ft" closed="false">ແປ​ວ່າ ອົງພຣະຜູ້ເປັນເຈົ້າ​ຜູ້​ພຸ່ງ​ເຂົ້າ​ໃສ່</char></note> <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />ພວກ​ຟີລິດສະຕິນ​ໄດ້​ຖິ້ມ​ບັນດາ​ພະ​ຂອງ​ພວກເຂົາ​ໄວ້​ຢູ່​ທີ່ນັ້ນ ແລະ ດາວິດ​ໄດ້​ສັ່ງ​ໃຫ້​ຈູດ​ພະ​ເຫລົ່ານັ້ນ​ຖິ້ມ.<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />ບໍ່ດົນ​ຕໍ່ມາ ພວກ​ຟີລິດສະຕິນ​ໄດ້​ບຸກ​ເຂົ້າ​ໄປ​ໃນ​ຮ່ອມພູ​ແຫ່ງ​ນັ້ນ​ອີກ; <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />ດັ່ງນັ້ນ ດາວິດ​ຈຶ່ງ​ຖາມ​ພຣະເຈົ້າ​ອີກ ແລະ ພຣະເຈົ້າ​ໄດ້​ຕອບ​ເພິ່ນ​ວ່າ, “ຢ່າ​ບຸກ​ໂຈມຕີ​ທາງ​ດ້ານ​ໜ້າ ແຕ່​ຈົ່ງ​ອ້ອມ​ໄປ ແລ້ວ​ບຸກ​ເຂົ້າ​ໂຈມຕີ​ທາງ​ຕໍ່ໜ້າ​ຂອງ​ປ່າ​ຕົ້ນໂພ. <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />ເມື່ອ​ເຈົ້າ​ໄດ້​ຍິນ​ສຽງ​ຍ່າງ​ເທິງ​ປາຍ​ຕົ້ນໂພ, ຈົ່ງ​ບຸກ​ເຂົ້າ​ໂຈມຕີ ເພາະ​ນັ້ນ​ມີ​ຄວາມໝາຍ​ວ່າ​ພຣະເຈົ້າ​ໄດ້​ອອກ​ໄປ​ກ່ອນ​ພວກເຈົ້າ​ແລ້ວ ເພື່ອ​ໂຈມຕີ​ກອງທັບ​ຟີລິດສະຕິນ”. <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />ດັ່ງນັ້ນ​ດາວິດ​ໄດ້​ເຮັດ​ຕາມ​ທີ່​ພຣະເຈົ້າ​ໄດ້​ສັ່ງ​ເພິ່ນ ແລະ ພວກເຂົາ​ໄດ້​ທຳລາຍ​ກອງທັບ​ຟີລິດສະຕິນ​ຕະຫລອດ​ທາງ​ຕັ້ງແຕ່​ເມືອງ​ກີເບໂອນ​ໄປ​ຈົນ​ຮອດ​ເມືອງ​ເກເຊ.<verse eid="1CH 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17" />ຊື່ສຽງ​ຂອງ​ດາວິດ​ຈຶ່ງ​ຊ່າລື​ໄປ​ທົ່ວ​ທຸກ​ເຂດແດນ ແລະ ພຣະເຈົ້າຢາເວ​ໄດ້​ເຮັດ​ໃຫ້​ທຸກ​ຊົນຊາດ ເກີດ​ມີ​ຄວາມ​ຢ້ານກົວ​ເພິ່ນ.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s1">ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຖືກ​ນຳ​ມາ​ເຢຣູຊາເລັມ</para>
  <para style="r">(2ຊມອ 6:12-19)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />ຫລັງ​ຈາກ​ດາວິດ​ໄດ້​ສ້າງ​ຕຶກ​ອາຄານ​ຕ່າງ​ໆ​ສຳລັບ​ຕົນ​ໃນ​ເມືອງ​ຂອງ​ດາວິດ​ແລ້ວ ດາວິດ​ໄດ້​ຈັດຕຽມ​ບ່ອນ​ໄວ້​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າ ແລະ ໄດ້ຕັ້ງ​ຫໍເຕັນ​ຂຶ້ນ​ຫລັງ​ໜຶ່ງ​ສໍາລັບ​ເກັບ​ຫີບ​ໄວ້. <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />ແລ້ວ​ດາວິດ​ເວົ້າ​ວ່າ, “ຢ່າ​ໃຫ້​ຜູ້ໃດ​ຫາມ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າ ນອກຈາກ​ພວກ​ເລວີ​ເທົ່ານັ້ນ, ເພາະວ່າ​ພຣະເຈົ້າຢາເວ​ໄດ້​ເລືອກ​ພວກເຂົາ​ເພື່ອ​ຫາມ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າຢາເວ ແລະ ເພື່ອ​ຮັບໃຊ້​ຢູ່​ຕໍ່ໜ້າ​ພຣະອົງ​ຕະຫລອດໄປ”.<verse eid="1CH 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3" />ດາວິດ​ຈຶ່ງ​ໄດ້​ເອີ້ນ​ປະຊາຊົນ​ອິດສະຣາເອນ​ທັງໝົດ​ມາ​ປະຊຸມ​ກັນ​ຢູ່​ໃນ​ເຢຣູຊາເລັມ ເພື່ອ​ນຳ​ເອົາຫີບ​ຄໍາໝັ້ນ​ສັນຍາ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ ມາວາງ​ໄວ້​ບ່ອນ​ທີ່​ເພິ່ນ​ໄດ້​ຈັດຕຽມ​ໄວ້.<verse eid="1CH 15:3" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="4" style="v" sid="1CH 15:4" />ເພິ່ນ​ໄດ້​ເອີ້ນ​ເອົາ​ເຊື້ອສາຍ​ຂອງ​ອາໂຣນ ແລະ ພວກ​ເລວີ​ໃຫ້​ມາ​ພ້ອມໜ້າ​ກັນ ມີ​ດັ່ງນີ້:<verse eid="1CH 15:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5" />ຈາກ​ເຊື້ອສາຍ​ໂກຮາດ,</para>
  <para style="li2" vid="1CH 15:5">ແມ່ນ​ອູຣິເອນ​ເປັນ​ຫົວໜ້າ ແລະ ມີ​ຍາດພີ່ນ້ອງ​ໜຶ່ງ​ຮ້ອຍ​ຊາວ​ຄົນ;<verse eid="1CH 15:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6" />ຈາກ​ເຊື້ອສາຍ​ຂອງ​ເມຣາຣິ</para>
  <para style="li2" vid="1CH 15:6">ແມ່ນ​ອາສາອີຢາ​ເປັນ​ຫົວໜ້າ ແລະ ມີ​ຍາດພີ່ນ້ອງ​ສອງຮ້ອຍຊາວ​ຄົນ;<verse eid="1CH 15:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7" />ຈາກ​ເຊື້ອສາຍ​ເກໂຊນ,<note caller="+" style="f"><char style="fr" closed="false">15:7 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ເກໂຊມ ເປັນ​ອີກ​ຮູບ​ໜຶ່ງ​ຂອງ ເກໂຊນ</char></note></para>
  <para style="li2" vid="1CH 15:7">ແມ່ນ​ໂຢເອນ​ເປັນ​ຫົວໜ້າ ແລະ ຍາດ​ພີ່ນ້ອງ​ໜຶ່ງ​ຮ້ອຍ​ສາມສິບ​ຄົນ;<verse eid="1CH 15:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8" />ຈາກ​ເຊື້ອສາຍ​ຂອງ​ເອລີຊາຟັນ,</para>
  <para style="li2" vid="1CH 15:8">ແມ່ນ​ເຊມາອີຢາ​ເປັນ​ຫົວໜ້າ ແລະ ມີ​ຍາດພີ່ນ້ອງ​ສອງຮ້ອຍ​ຄົນ;<verse eid="1CH 15:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9" />ຈາກ​ເຊື້ອສາຍ​ຂອງ​ເຮັບໂຣນ,</para>
  <para style="li2" vid="1CH 15:9">ແມ່ນ​ເອລີເອນ​ເປັນ​ຫົວໜ້າ ແລະ ມີ​ຍາດພີ່ນ້ອງ ແປດສິບ​ຄົນ;<verse eid="1CH 15:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10" />ຈາກ​ເຊື້ອສາຍ​ຂອງ​ອຸດຊີເອນ,</para>
  <para style="li2" vid="1CH 15:10">ແມ່ນ​ອຳມີນາດາບ​ເປັນ​ຫົວໜ້າ ແລະ ມີ​ຍາດພີ່ນ້ອງ​ໜຶ່ງຮ້ອຍ​ສິບສອງ​ຄົນ.<verse eid="1CH 15:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />ຈາກນັ້ນ ດາວິດ​ໄດ້​ເອີ້ນ​ເອົາ​ປະໂລຫິດ​ຊາດົກ ແລະ ອາບີອາທາ ແລະ ພວກ​ເລວີ​ມີ​ດັ່ງນີ້: ອູຣິເອນ, ອາສາອີຢາ, ໂຢເອນ, ເຊມາອີຢາ, ເອລີເອນ ແລະ ອຳມີນາດາບ​ໃຫ້​ມາ​ພົບເພິ່ນ. <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />ແລ້ວ​ເພິ່ນ​ໄດ້​ເວົ້າ​ກັບ​ພວກເຂົາ​ວ່າ, “ພວກເຈົ້າ​ເປັນ​ຜູ້ນຳ​ບັນດາ​ຕະກຸນ​ຊາວ​ເລວີ; ພວກເຈົ້າ ແລະ ພວກ​ພີ່ນ້ອງ​ຊາວ​ເລວີ​ຈົ່ງ​ຊຳລະ​ຕົນ​ໃຫ້​ບໍລິສຸດ ແລະ ນຳ​ເອົາ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ​ແຫ່ງ​ອິດສະຣາເອນ​ມາ​ບ່ອນ​ທີ່​ເຮົາ​ໄດ້​ຈັດຕຽມ​ໄວ້​ແລ້ວ. <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />ຍ້ອນ​ພວກເຈົ້າ, ຄົນ​ເລວີ, ບໍ່​ໄດ້​ເປັນ​ຜູ້​ຫາມ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ໄປ​ແຕ່​ເທື່ອ​ທໍາອິດ​ນັ້ນ ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ​ຂອງ​ພວກເຮົາ​ຈຶ່ງ​ໄດ້​ໃຈຮ້າຍ​ຕໍ່​ພວກເຮົາ. ພວກເຮົາ​ບໍ່​ໄດ້​ຖາມ​ພຣະອົງ​ເຖິງ​ວິທີ​ທີ່​ຈະ​ນຳເອົາ​ຫີບ​ມາ​ຕາມ​ວິທີ​ທີ່​ໄດ້​ກຳນົດ​ໄວ້”. <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />ສະນັ້ນ ບັນດາ​ປະໂລຫິດ ແລະ ພວກ​ເລວີ​ຈຶ່ງ​ໄດ້​ຊຳລະ​ຕົນເອງ​ເພື່ອ​ນຳ​ເອົາ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າຢາເວ ພຣະເຈົ້າ​ແຫ່ງ​ອິດສະຣາເອນ​ຂຶ້ນ​ມາ. <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />ຫລັງຈາກ​ນັ້ນ​ພວກ​ເລວີ​ໄດ້​ຫາມ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າ​ຂຶ້ນ​ໃສ່​ບ່າ​ຂອງ​ພວກເຂົາ​ໂດຍ​ໃຊ້​ໄມ້ຄານ​ຫາມ​ຕາມ​ຖ້ອຍຄຳ​ຂອງ​ພຣະເຈົ້າຢາເວ​ທີ່​ໄດ້​ສັ່ງ​ໂມເຊ​ໄວ້.<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />ດາວິດ​ໄດ້ບອກ​ບັນດາ​ຫົວໜ້າ​ຂອງ​ພວກ​ເລວີ​ໃຫ້​ແຕ່ງຕັ້ງ​ພີ່ນ້ອງ​ຊາວ​ເລວີ​ຂອງ​ພວກຕົນ​ເປັນ​ນັກດົນຕຼີ ເພື່ອ​ຮ້ອງ​ເພງ​ຢ່າງ​ມ່ວນຊື່ນ​ດ້ວຍ​ເຄື່ອງ​ດົນຕີ​ຕ່າງ​ໆ​ຄື: ດີດ​ພິນ​ນ້ອຍ ດີດ​ພິນ​ໃຫຍ່ ແລະ ຕົບ​ແສ່ງ.<verse eid="1CH 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17" />ດັ່ງນັ້ນ ພວກ​ເລວີ​ຈຶ່ງ​ໄດ້​ແຕ່ງຕັ້ງ​ເຮມານ​ລູກຊາຍ​ຂອງ​ໂຢເອນ​ທີ່​ເປັນ​ພີ່ນ້ອງ​ຂອງ​ລາວ​ເອງ, ອາສັບ​ລູກຊາຍ​ຂອງ​ເບເຣກີຢາ​ທີ່​ເປັນ​ພີ່ນ້ອງ​ຂອງ​ພວກເຂົາ, ເອທານ​ລູກຊາຍ​ຂອງ​ກູຊາອີຢາ​ແຫ່ງ​ຕະກຸນ​ເມຣາຣິ. <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />ແລະ ພ້ອມທັງ​ພີ່ນ້ອງ​ທີ່​ເປັນ​ຜູ້​ຊ່ວຍ​ຮອງ​ລົງ​ມາ​ມີ​ດັ່ງນີ້: ເຊກາຣີຢາ,<note caller="+" style="f"><char style="fr" closed="false">15:18 </char><char style="ft" closed="false">ສຳ​ເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ເຊກາຣີຢາ ບຸດ ແລະ ຫລື ເຊກາຣີຢາ ເບນ ແລະ (ເບິ່ງ ຂໍ້ <char style="xt" link-href="1CH 15:20"><ref loc="1CH 15:20">20</ref></char> ແລະ <char style="xt" link-href="1CH 16:5"><ref loc="1CH 16:5">16:5</ref></char>)</char></note> ຢາອາຊີເອນ, ເຊມີຣາໂມດ, ເຢຮີເອນ, ອຸນນີ, ເອລີອາບ, ເບນາອີຢາ ແລະ ມາອາເສອີຢາ. ມັດຕີທີຢາ, ເອລີເຟເລຮູ, ມິກເນອີຢາ, ໂອເບັດເອໂດມ ແລະ ເຢອີເອນ.<note caller="+" style="f"><char style="fr" closed="false">15:18 </char><char style="ft" closed="false">ສະບັບ LXX. ວ່າ ເຢອີເອນ ແລະ ອາ​ຊາ​ຊິ​ຢາ (ເບິ່ງ​ຂໍ້ <char style="xt" link-href="1CH 15:21"><ref loc="1CH 15:21">21</ref></char>)</char></note> ຜູ້ເຝົ້າຍາມ​ປະຕູ​ວິຫານ.<verse eid="1CH 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19" />ນັກດົນຕຼີ​ມີ​ດັ່ງນີ້: ເຮມານ, ອາສັບ ແລະ ເອທານ​ເປັນ​ຜູ້​ຕີ​ແສ່ງ​ທອງສຳລິດ <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />ເຊກາຣີຢາ, ອາຊີເອນ, ເຊມີຣາໂມດ, ເຢຮີເອນ, ອຸນນີ, ເອລີອາບ, ມາອາເສອີຢາ ແລະ ເບນາອີຢາ​ເປັນ​ຜູ້ຫລິ້ນ​ພິນ​ນ້ອຍ​ຕາມ​ທຳນອງ​ອາລາໂມດ <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />ມັດຕີທີຢາ ເອລີເຟເລຮູ, ມິກເນອີຢາ, ໂອເບັດເອໂດມ, ເຢອີເອນ ແລະ ອາຊາຊີຢາ​ມັດຕີທີຢາ ເອລີເຟເລຮູ, ມິກເນອີຢາ, ໂອເບັດ​ເອໂດມ, ເຢອີເອນ ແລະ ອາຊາຊີຢາ ເປັນ​ຜູ້​ຫລິ້ນ​ພິນ​ໃຫຍ່​ຕາມ​ທໍານອງ​ເຊມີນິດ. <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />ເກນານີຢາ​ຫົວໜ້າ​ຂອງ​ຊາວ​ເລວີ​ໃຫ້​ຮັບຜິດຊອບ​ການ​ຮ້ອງເພງ; ນັ້ນ​ຄື​ໜ້າທີ່​ຂອງ​ລາວ​ເພາະ​ລາວ​ຊ່ຽວຊານ​ໃນ​ເລື່ອງ​ນີ້.<verse eid="1CH 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23" />ເບເຣກີຢາ ແລະ ເອນການາ​ເປັນ​ຜູ້​ເຝົ້າ​ຍາມ​ປະຕູ​ຫີບ​ຄໍາໝັ້ນສັນຍາ. <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />ບັນດາ​ປະໂລຫິດ​ເຊບານີຢາ, ໂຢຊາຟັດ, ເນທາເນນ, ອາມາໄສ, ເຊກາຣີຢາ, ເບນາອີຢາ ແລະ ເອລີເອເຊ ເປັນ​ຜູ້​ເປົ່າ​ແກ​ນຳ​ໜ້າ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າ. ໂອເບັດເອໂດມ ແລະ ເຢຮີຢາ​ເປັນ​ຜູ້ເຝົ້າ​ຍາມ​ປະຕູ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ເໝືອນກັນ.<verse eid="1CH 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />ດັ່ງນັ້ນ ດາວິດ, ພວກ​ເຖົ້າແກ່​ຂອງ​ອິດສະຣາເອນ ແລະ ພວກ​ຜູ້ບັນຊາການ​ກອງພັນ​ຈຶ່ງ​ໄດ້ໄປ​ນຳ​ເອົາ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າຢາເວ ອອກ​ມາ​ຈາກ​ເຮືອນ​ຂອງ​ໂອເບັດເອໂດມ​ດ້ວຍ​ຄວາມ​ຊື່ນຊົມຍິນດີ. <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />ເພາະ​ພຣະເຈົ້າ​ຊ່ວຍ​ພວກ​ເລວີ​ທີ່​ຫາມ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າຢາເວ, ແລ້ວ​ພວກເຂົາ​ຈຶ່ງ​ໄດ້​ຖວາຍ​ງົວເຖິກ​ເຈັດ​ໂຕ ແລະ ແກະເຖິກ​ເຈັດ​ໂຕ​ເປັນ​ເຄື່ອງບູຊາ. <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />ດາວິດ​ໄດ້​ນຸ່ງ​ເຄື່ອງ​ທີ່​ເຮັດ​ດ້ວຍ​ຜ້າຝ້າຍ​ລິນິນ​ເນື້ອລະອຽດ​ດີ, ເຊັ່ນດຽວກັນ​ກັບ​ພວກ​ເລວີ​ທັງໝົດ​ທີ່​ຫາມ​ຫີບ​ຄໍາໝັ້ນສັນຍາ ແລະ ພວກ​ນັກດົນຕີ​ກໍ່​ເໝືອນ​ກັນ ສ່ວນ​ເກນານີຢາ​ເປັນ​ຜູ້​ຮັບຜິດຊອບ​ຄະນະ​ນັກຮ້ອງ. ດາວິດ​ຍັງ​ໄດ້​ນຸ່ງ​ເສື້ອຄຸມ​ສັ້ນ​ເອໂຟດ​ດ້ວຍ. <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />ດັ່ງນັ້ນ ຊາວ​ອິດສະຣາເອນ​ທັງໝົດ​ຈຶ່ງ​ໄດ້​ນຳ​ເອົາ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າຢາເວ​ດ້ວຍ​ສຽງ​ໂຫ່​ຮ້ອງ​ຊື່ນຊົມຍິນດີ, ພ້ອມທັງ​ເປົ່າ​ເຂົາ​ແກະ ແລະ ເປົ່າແກ, ຕົບແສ່ງ ດີດ​ພິນ​ນ້ອຍ ແລະ ດີດ​ພິນ​ໃຫຍ່.<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29" />ໃນຂະນະ​ທີ່​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າຢາເວ​ກໍາລັງ​ເຂົ້າ​ໄປ​ສູ່​ເມືອງ​ຂອງ​ດາວິດ, ນາງ​ມີການ​ລູກສາວ​ຂອງ​ໂຊນ​ໄດ້​ແນມເບິ່ງ​ຈາກ​ທາງ​ປ່ອງຢ້ຽມ ແລະ ເຫັນ​ກະສັດ​ດາວິດ​ຟ້ອນ ແລະ ສະເຫລີມ​ສະຫຼອງ​ຢູ່, ນາງ​ຈຶ່ງ​ໝິ່ນປະໝາດ​ເພິ່ນ​ໃນ​ໃຈ.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="s1">ປະຕິບັດ​ງານ​ຢູ່​ຕໍ່ໜ້າ​ຫີບ​ຄໍາໝັ້ນສັນຍາ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />ພວກເຂົາ​ໄດ້​ນຳ​ເອົາ​ຫີບ​ພັນທະສັນຍາ​ຂອງ​ພຣະເຈົ້າ​ມາ​ຕັ້ງ​ໄວ້​ໃນ​ຫໍເຕັນ​ທີ່​ດາວິດ​ໄດ້​ຈັດຕຽມ​ໄວ້ ແລະ ພວກເຂົາ​ກໍ​ໄດ້​ຖວາຍ​ເຄື່ອງເຜົາ​ບູຊາ ແລະ ເຄື່ອງບູຊາ​ເພື່ອ​ຄວາມ​ສາມັກຄີທຳ​ຕໍ່ໜ້າ​ພຣະເຈົ້າ. <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />ຫລັງຈາກ​ທີ່​ດາວິດ​ໄດ້​ຖວາຍ​ເຄື່ອງເຜົາ​ບູຊາ ແລະ ເຄື່ອງບູຊາ​ເພື່ອ​ຄວາມ​ສາມັກຄີທຳ​ສຳເລັດ​ແລ້ວ ເພິ່ນ​ກໍ​ອວຍພອນ​ແກ່​ປະຊາຊົນ​ໃນ​ນາມ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ. <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />ຫລັງຈາກນັ້ນ ເພິ່ນ​ໄດ້​ເອົາ​ເຂົ້າຈີ່, ຂະໝົມ​ໝາກ​ອິນທະຜາລໍາ, ຂະໜົມ​ໝາກອະ​ງຸ່ນ​ແຫ້ງ​ແຈກຢາຍ​ໃຫ້​ຊາວ​ອິດສະຣາເອນ​ທຸກຄົນ​ຢ່າງ​ລະ​ກ້ອນ​ທັງ​ຜູ້ຊາຍ ແລະ ຜູ້ຍິງ.<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />ດາວິດ​ໄດ້​ແຕ່ງຕັ້ງ​ພວກ​ເລວີ​ບາງ​ຄົນ​ໃຫ້​ບົວລະບັດ​ຮັບໃຊ້​ຕໍ່ໜ້າ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າຢາເວ ເພື່ອ​ຍົກຍ້ອງ, ໂມທະນາ​ຂອບພຣະຄຸນ ແລະ ສັນລະເສີນ​ພຣະເຈົ້າຢາເວ ພຣະເຈົ້າ​ແຫ່ງ​ຊາດ​ອິດສະຣາເອນ. <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />ອາສັບ​ໄດ້​ເປັນ​ຫົວໜ້າ, ແລະ ຮອງ​ລົງ​ມາ​ຈາກ​ເພິ່ນ​ແມ່ນ​ເຊກາຣີຢາ, ຕໍ່ມາ​ແມ່ນ​ຢາອາຊີເອນ, ເຊມີຣາໂມດ, ເຢຮີເອນ, ມັດຕີທີຢາ, ເອລີອາບ, ເບນາອີຢາ, ໂອເບັດເອໂດມ ແລະ ເຢອີເອນ. ພວກເຂົາ​ເປັນ​ຜູ້​ດີດ​ພິນ​ນ້ອຍ ແລະ ດີດ​ພິນ​ໃຫຍ່ ອາສັບ​ເປັນ​ຜູ້​ຕົບແສ່ງ, <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />ປະໂລຫິດ​ເບນາອີຢາ ແລະ ຢາຮາຊີເອນ​ເປັນ​ຜູ້​ເປົ່າ​ແກ​ປະຈຳ​ຕໍ່ໜ້າ​ຫີບ​ພັນທະສັນຍາ​ຂອງ​ພຣະເຈົ້າ.<verse eid="1CH 16:6" /></para>
  <para style="b" />
  <para style="s1">ບົດເພງ​ສັນລະເສີນ​ຂອບພຣະຄຸນ​ຂອງ​ດາວິດ</para>
  <para style="r">(ພສສ 96:1-13; 105:1-15; 106:1,47-48)</para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />ໃນ​ມື້​ນັ້ນ​ດາວິດ​ໄດ້​ມອບ​ບົດເພງ​ສັນລະເສີນ​ຂອບພຣະຄຸນ​ອົງພຣະຜູ້ເປັນເຈົ້າ​ໃຫ້​ອາສັບ ແລະ ຄະນະ​ຂອງ​ລາວ​ໃຫ້​ຮ້ອງເພງ​ສັນລະເສີນ​ພຣະເຈົ້າຢາເວ​ເປັນ​ຄັ້ງ​ທຳອິດ​ດັ່ງນີ້:<verse eid="1CH 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8" />ຈົ່ງ​ສັນລະເສີນ​ພຣະເຈົ້າຢາເວ ແລະ ປະກາດ​ນາມ​ຂອງ​ພຣະອົງ</para>
  <para style="q2" vid="1CH 16:8">ໃຫ້​ປະຊາຊາດ​ທັງຫລາຍ​ໄດ້​ຮູ້​ເຖິງ​ສິ່ງ​ທີ່​ພຣະອົງ​ເຮັດ.<verse eid="1CH 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9" />ຈົ່ງ​ຮ້ອງເພງ​ຖວາຍ​ພຣະອົງ, ຮ້ອງ​ສັນລະເສີນ​ຖວາຍ​ພຣະອົງ;</para>
  <para style="q2" vid="1CH 16:9">ບອກ​ເຖິງ​ພາລະກິດ​ອັນ​ອັດສະຈັນ​ທັງໝົດ​ຂອງ​ພຣະອົງ.<verse eid="1CH 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10" />ຈົ່ງ​ເທີດທູນ​ນາມ​ອັນ​ບໍລິສຸດ​ຂອງ​ພຣະອົງ;</para>
  <para style="q2" vid="1CH 16:10">ໃຫ້​ຫົວໃຈ​ຂອງ​ຄົນ​ທີ່​ສະແຫວງຫາ​ພຣະເຈົ້າຢາເວ​ຊື່ນຊົມຍິນດີ.<verse eid="1CH 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11" />ຈົ່ງ​ເບິ່ງ​ໄປ​ທີ່​ພຣະເຈົ້າຢາເວ ແລະ ກຳລັງ​ຂອງ​ພຣະອົງ.</para>
  <para style="q2" vid="1CH 16:11">ຈົ່ງ​ສະແຫວງຫາ​ໃບໜ້າ​ຂອງ​ພຣະອົງ​ຢູ່​ສະເໝີ.<verse eid="1CH 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12" />ຈົ່ງ​ລະນຶກ​ເຖິງ​ການ​ອັດສະຈັນ​ທີ່​ພຣະອົງ​ໄດ້​ເຮັດ.</para>
  <para style="q2" vid="1CH 16:12">ເຖິງ​ການ​ອັດສະຈັນ ແລະ ຄຳ​ພິພາກສາ​ທີ່​ພຣະອົງ​ປະກາດ.<verse eid="1CH 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13" />ພວກເຈົ້າ​ທັງຫລາຍ​ຜູ້​ເປັນ​ເຊື້ອສາຍ​ຂອງ​ອິດສະຣາເອນ​ຜູ້ຮັບໃຊ້​ຂອງ​ພຣະອົງ,</para>
  <para style="q2" vid="1CH 16:13">ລູກຫລານ​ຂອງ​ຢາໂຄບ​ທີ່​ພຣະອົງ​ໄດ້​ເລືອກ​ໄວ້.<verse eid="1CH 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14" />ພຣະອົງ​ເປັນ​ພຣະເຈົ້າຢາເວ ພຣະເຈົ້າ​ຂອງ​ພວກເຮົາ;</para>
  <para style="q2" vid="1CH 16:14">ຄຳ​ພິພາກສາ​ຂອງ​ພຣະອົງ​ກໍ​ຢູ່​ທົ່ວ​ແຜ່ນດິນໂລກ.<verse eid="1CH 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15" />ພຣະອົງ​ໄດ້​ລະນຶກ<note caller="+" style="f"><char style="fr" closed="false">16:15 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ຈົ່ງ​ລະນຶກ​ເຖິງ (ເບິ່ງ <char style="xt"><ref loc="PSA 105:8">ພສສ 105:8</ref></char>)</char></note> ຄຳໝັ້ນສັນຍາ​ຂອງ​ພຣະອົງ​ຕະຫລອດ​ໄປ,</para>
  <para style="q2" vid="1CH 16:15">ພຣະອົງ​ລະນຶກ​ເຖິງ​ສັນຍາ​ທີ່​ພຣະອົງ​ໄດ້​ເຮັດ​ໄວ້​ຕະຫລອດ​ພັນ​ຊົ່ວ​ອາຍຸ​ຄົນ,<verse eid="1CH 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16" />ຄຳໝັ້ນສັນຍາ​ທີ່​ພຣະອົງ​ໄດ້​ເຮັດ​ກັບ​ອັບຣາຮາມ,</para>
  <para style="q2" vid="1CH 16:16">ຄຳ​ປະຕິຍານ​ທີ່​ພຣະອົງ​ໄດ້​ສັນຍາ​ກັບ​ອີຊາກ.<verse eid="1CH 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17" />ພຣະອົງ​ໄດ້​ຢືນຢັນ​ຕໍ່​ຢາໂຄບ​ເປັນ​ດຳລັດ,</para>
  <para style="q2" vid="1CH 16:17">ຕໍ່​ອິດສະຣາເອນ​ເປັນ​ຄຳໝັ້ນສັນຍາ​ນິລັນດອນ<verse eid="1CH 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18" />“ເຮົາ​ຈະ​ມອບ​ດິນແດນ​ການາອານ​ໃຫ້​ພວກເຈົ້າ</para>
  <para style="q2" vid="1CH 16:18">ໃຫ້​ເປັນ​ມໍລະດົກ​ຂອງ​ພວກເຈົ້າ”<verse eid="1CH 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19" />ເມື່ອ​ເວລາ​ທີ່​ອິດສະຣາເອນ​ຍັງ​ມີ​ຈຳນວນ​ໜ້ອຍ​ຫລາຍ,</para>
  <para style="q2" vid="1CH 16:19">ໜ້ອຍ​ເຫລືອ​ເກີນ ແລະ ເປັນ​ພຽງ​ຄົນ​ແປກໜ້າ​ໃນ​ດິນແດນ​ນັ້ນ,<verse eid="1CH 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20" />ພວກເພິ່ນ<note caller="+" style="f"><char style="fr" closed="false">16:18-20 </char><char style="ft" closed="false">ສຳເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ເປັນ​ມໍລະດົກ​ຂອງ​ພວກເຈົ້າ </char><char style="fqa" closed="false"><char style="fv">19</char> ເຖິງວ່າ​ອິດສະຣາເອນ​ຍັງ​ມີ​ຈຳນວນ​ໜ້ອຍ​ຫລາຍ, ໜ້ອຍ​ເຫລືອ​ເກີນ ແລະ ເປັນ​ພຽງ​ຄົນ​ແປກໜ້າ​ໃນ​ທີ່​ນັ້ນ” </char><char style="fqa" closed="false"><char style="fv">20</char> ພວກເພິ່ນ</char></note>​ພະເນຈອນ​ຈາກ​ຊົນຊາດ​ໜຶ່ງ​ໄປ​ຫາ​ອີກ​ຊົນຊາດ​ໜຶ່ງ,</para>
  <para style="q2" vid="1CH 16:20">ຈາກ​ອານາຈັກ​ໜຶ່ງ​ໄປ​ຫາ​ອີກ​ອານາຈັກ​ໜຶ່ງ.<verse eid="1CH 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21" />ພຣະອົງ​ບໍ່​ຍອມ​ໃຫ້​ຜູ້ໃດ​ຂົ່ມເຫັງ​ພວກເພິ່ນ</para>
  <para style="q2" vid="1CH 16:21">ເພາະ​ເຫັນ​ແກ່​ພວກເພິ່ນ ພຣະອົງ​ຈຶ່ງ​ໄດ້​ເຕືອນ​ກະສັດ​ທັງຫລາຍ​ວ່າ<verse eid="1CH 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22" />“ຢ່າ​ແຕະຕ້ອງ​ບັນດາ​ຜູ້​ທີ່​ເຮົາ​ໄດ້​ເຈີມ​ໄວ້</para>
  <para style="q2" vid="1CH 16:22">ຢ່າ​ເຮັດ​ອັນຕະລາຍ​ອັນ​ໃດ​ໃຫ້​ແກ່​ບັນດາ​ຜູ້ທຳນວາຍ​ຂອງ​ເຮົາ”.<verse eid="1CH 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23" />ທົ່ວ​ແຜ່ນດິນໂລກ, ຈົ່ງ​ຮ້ອງເພງ​ຖວາຍ​ແດ່ ພຣະເຈົ້າຢາເວ;</para>
  <para style="q2" vid="1CH 16:23">ຈົ່ງ​ປະກາດ​ຄວາມພົ້ນ​ຂອງ​ພຣະອົງ​ທຸກໆ​ວັນ<verse eid="1CH 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24" />ຈົ່ງ​ປະກາດ​ສະຫງ່າລາສີ​ຂອງ​ພຣະອົງ​ໃນ​ທ່າມກາງ​ບັນດາ​ປະຊາຊາດ,</para>
  <para style="q2" vid="1CH 16:24">ປະກາດ​ກິດຈະການ​ອັນ​ລ້ຳເລີດ​ຂອງ​ພຣະອົງ​ໃນ​ທ່າມກາງ​ຊົນຊາດ​ທັງໝົດ.<verse eid="1CH 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25" />ເພາະ​ພຣະເຈົ້າຢາເວ​ນັ້ນ​ຍິ່ງໃຫຍ່ ແລະ ສົມຄວນ​ໄດ້​ຮັບ​ການ​ສັນລະເສີນ​ທີ່ສຸດ.</para>
  <para style="q2" vid="1CH 16:25">ພຣະອົງ​ເປັນ​ທີ່​ເຄົາລົບ​ຢຳເກງ​ເໜືອ​ພະ​ທັງໝົດ.<verse eid="1CH 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26" />ເພາະ​ພະ​ທັງໝົດ​ຂອງ​ຊົນຊາດ​ຕ່າງໆ​ນັ້ນ​ເປັນ​ພຽງ​ຮູບເຄົາລົບ,</para>
  <para style="q2" vid="1CH 16:26">ແຕ່​ພຣະເຈົ້າຢາເວ​ໄດ້​ສ້າງ​ຟ້າ​ສະຫວັນ.<verse eid="1CH 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27" />ຄວາມ​ສະຫງ່າງາມ ແລະ ບາລະມີ​ກໍ​ຢູ່​ຕໍ່ໜ້າ​ພຣະອົງ;</para>
  <para style="q2" vid="1CH 16:27">ກໍາລັງ ແລະ ຄວາມ​ຊົມຊື່ນຍິນດີ​ຢູ່​ໃນ​ບ່ອນ​ສະຖິດ​ຢູ່​ຂອງ​ພຣະອົງ.<verse eid="1CH 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28" />ທຸກ​ຄອບຄົວ​ຂອງ​ຊົນຊາດ​ທັງຫລາຍ, ຈົ່ງ​ເທີດທູນ​ພຣະເຈົ້າຢາເວ</para>
  <para style="q2" vid="1CH 16:28">ຈົ່ງ​ເທີດທູນ​ພຣະເຈົ້າຢາເວ​ເຖິງ​ກຽດ ແລະ ກຳລັງ​ຂອງ​ພຣະອົງ<verse eid="1CH 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29" />ຈົ່ງ​ເທີດທູນ​ພຣະເຈົ້າຢາເວ​ຕາມ​ກຽດ​ທີ່​ສົມຄວນ​ແກ່​ນາມ​ຂອງ​ພຣະອົງ</para>
  <para style="q2" vid="1CH 16:29">ຈົ່ງ​ນຳ​ເຄື່ອງບູຊາ​ເຂົ້າ​ມາ​ຕໍ່ໜ້າ​ພຣະອົງ</para>
  <para style="q1" vid="1CH 16:29">ຈົ່ງ​ນະມັດສະການ​ພຣະເຈົ້າຢາເວ​ໃນ<note caller="+" style="f"><char style="fr" closed="false">16:29 </char><char style="ft" closed="false">ຫລື ດ້ວຍ</char></note>​ຄວາມ​ສະຫງ່າງາມ​ແຫ່ງ​ຄວາມ​ບໍລິສຸດ​ຂອງ​ພຣະອົງ.<verse eid="1CH 16:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="1CH 16:30" />ທົ່ວ​ແຜ່ນດິນ​ໂລກ​ຈົ່ງ​ສັ່ນສະທ້ານ​ຕໍ່ໜ້າ​ພຣະອົງ!</para>
  <para style="q2" vid="1CH 16:30">ໂລກ​ໄດ້​ຮັບ​ການ​ສະຖາປະນາ​ໄວ້​ຢ່າງ​ໝັ້ນຄົງ; ຈະ​ບໍ່​ມີ​ວັນ​ສັ່ນຄອນ.<verse eid="1CH 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31" />ຟ້າ​ສະຫວັນ, ຈົ່ງ​ຊື່ນຊົມຍິນດີ ແຜ່ນດິນໂລກ​ຈົ່ງ​ຍິນດີ;</para>
  <para style="q2" vid="1CH 16:31">ຈົ່ງ​ບອກ​ຊົນຊາດ​ທັງຫລາຍ​ວ່າ “ພຣະເຈົ້າຢາເວ​ເປັນ​ຜູ້​ປົກຄອງ!”<verse eid="1CH 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32" />ໃຫ້​ທະເລ ແລະ ທຸກສິ່ງ​ທີ່​ຢູ່​ໃນ​ນັ້ນ​ສົ່ງ​ສຽງ​ກັງວານ;</para>
  <para style="q2" vid="1CH 16:32">ໃຫ້​ທົ່ງນາ ແລະ ທຸກສິ່ງ​ທີ່​ຢູ່​ໃນ​ທົ່ງນາ​ນັ້ນ​ມ່ວນຊື່ນ!<verse eid="1CH 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33" />ໃຫ້​ຕົ້ນໄມ້​ທີ່​ຢູ່​ໃນ​ປ່າ​ຮ້ອງເພງ​ຊື່ນຊົມຍິນດີ,</para>
  <para style="q2" vid="1CH 16:33">ໃຫ້​ພວກມັນ​ຮ້ອງເພງ​ຢ່າງ​ຊື່ນຊົມຍິນດີ​ຕໍ່ໜ້າ​ພຣະເຈົ້າຢາເວ,</para>
  <para style="q2" vid="1CH 16:33">ເພາະ​ພຣະອົງ​ມາ​ເພື່ອ​ພິພາກສາ​ແຜ່ນດິນໂລກ.<verse eid="1CH 16:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34" />ຈົ່ງ​ຂອບພຣະຄຸນ​ພຣະເຈົ້າ​ຢາເວ, ເພາະ​ພຣະອົງ​ດີ;</para>
  <para style="q2" vid="1CH 16:34">ຄວາມ​ຮັກ​ໝັ້ນຄົງ​ຂອງ​ພຣະອົງ​ດຳລົງ​ຕະຫລອດ​ໄປ​ເປັນນິດ.<verse eid="1CH 16:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35" />ຈົ່ງ​ສົ່ງສຽງ​ຮ້ອງ​ວ່າ, “ຂ້າ​ແດ່​ພຣະເຈົ້າ ພຣະຜູ້ຊ່ວຍ​ໃຫ້​ພົ້ນ​ຂອງ​ພວກຂ້ານ້ອຍ, ຂໍ​ຊ່ວຍ​ພວກຂ້ານ້ອຍ​ໃຫ້​ພົ້ນ,</para>
  <para style="q2" vid="1CH 16:35">ຂໍ​ຮວບຮວມ​ພວກຂ້ານ້ອຍ​ຈາກ​ຊົນຊາດ​ຕ່າງໆ ແລະ ກອບກູ້​ພວກຂ້ານ້ອຍ​ຈາກ​ຊົນຊາດ​ທັງຫລາຍ​ດ້ວຍ,</para>
  <para style="q1" vid="1CH 16:35">ເພື່ອ​ພວກຂ້ານ້ອຍ​ຈະ​ຂອບພຣະຄຸນ​ນາມ​ອັນ​ບໍລິສຸດ​ຂອງ​ພຣະອົງ,</para>
  <para style="q2" vid="1CH 16:35">ແລະ ຍົກຍ້ອງ​ສັນລະເສີນ​ພຣະອົງ”.<verse eid="1CH 16:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36" />ຈົ່ງ​ສັນລະເສີນ​ພຣະເຈົ້າ​ຢາເວ, ພຣະເຈົ້າ​ແຫ່ງ​ອິດສະຣາເອນ,</para>
  <para style="q2" vid="1CH 16:36">ຈາກ​ນິລັນການ​ຈົນ​ເຖິງ​ນິລັນການ.</para>
  <para style="m" vid="1CH 16:36">ຫລັງຈາກນັ້ນ ປະຊາຊົນ​ທັງໝົດ​ກ່າວ​ວ່າ “ອາແມນ” ແລະ “ຈົ່ງ​ສັນລະເສີນ​ພຣະເຈົ້າ​ຢາເວ”.<verse eid="1CH 16:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />ດາວິດ​ມອບ​ໃຫ້​ອາສັບ ແລະ ຄະນະ​ຜູ້​ຊ່ວຍ​ຂອງ​ລາວ​ປະຕິບັດ​ໜ້າທີ່​ຕໍ່ໜ້າ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າຢາເວ​ຢູ່​ໃນ​ທີ່ນັ້ນ​ຢ່າງສະໝໍ່າ​ສະເໝີ. <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />ແລະ ເພິ່ນ​ໄດ້​ໃຫ້​ໂອເບັດເອໂດມ ແລະ ຄະນະ​ຜູ້​ຊ່ວຍ​ຂອງ​ລາວ ຫົກສິບແປດ​ຄົນ​ຮ່ວມ​ກັນ​ປະຕິບັດ​ໜ້າທີ່​ນໍາ​ພວກເຂົາ​ດ້ວຍ. ໂອເບັດເອໂດມ​ລູກຊາຍ​ເຢດູທູນ ແລະ ໂຮສາ​ເປັນ​ຜູ້​ເຝົ້າຍາມ​ປະຕູ.<verse eid="1CH 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39" />ດາວິດ​ໄດ້​ໃຫ້​ປະໂລຫິດ​ຊາດົກ ແລະ ພີ່ນ້ອງ​ປະໂລຫິດ​ຄົນ​ອື່ນໆ​ຮັບໃຊ້​ຮ່ວມ​ກັນ​ຢູ່​ຕໍ່ໜ້າ​ຫໍເຕັນ​ສັກສິດ​ຂອງ​ພຣະເຈົ້າຢາເວ​ທີ່​ບ່ອນສູງ​ໃນ​ກີເບໂອນ. <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />ເພື່ອ​ຖວາຍ​ເຄື່ອງເຜົາ​ບູຊາ​ເປັນ​ປະຈໍາ​ເທິງ​ແທ່ນບູຊາ​ແກ່​ພຣະເຈົ້າຢາເວ, ທຸກ​ເຊົ້າ​ທຸກ​ແລງ, ຕາມ​ທີ່​ກົດບັນຍັດ​ທຸກ​ຂໍ້​ຂອງ​ພຣະເຈົ້າຢາເວ​ທີ່​ໄດ້​ຂຽນ​ໄວ້ ເຊິ່ງ​ພຣະອົງໄດ້​ມອບ​ໃຫ້​ແກ່​ຊາວ​ອິດສະຣາເອນ. <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />ແລະ ໃຫ້​ເຮມານ ແລະ ເຢດູທູນ​ກັບ​ຄົນ​ອື່ນໆ​ທີ່​ໄດ້​ຮັບ​ເລືອກ ແລະ ລະ​ບຸ​ຊື່​ໄວ້​ເປັນ​ຜູ້​ຮ້ອງເພງ​ໂມທະນາ​ຂອບພຣະຄຸນ​ພຣະເຈົ້າຢາເວ​ວ່າ, “ເພາະ​ຄວາມ​ຮັກ​ອັນ​ໝັ້ນຄົງ​ຂອງ​ພຣະອົງ​ດຳລົງ​ຕະຫລອດໄປ​ເປັນ​ນິດ” <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />ເຮມານ ແລະ ເຢດູທູນ​ມີ​ໜ້າທີ່​ຮັບຜິດຊອບ​ເປົ່າແກ, ຕົບ​ແສ່ງ ແລະ ຫຼິ້ນ​ເຄື່ອງ​ດົນຕີ​ອື່ນໆ​ໄປ​ພ້ອມກັນ​ກັບ​ບົດເພງ​ສັກສິດ. ບັນດາລູກຊາຍ​ຂອງ​ເຢດູທູນ​ເປັນ​ຜູ້​ເຝົ້າ​ຍາມ​ປະຈຳ​ຢູ່​ທີ່​ປະຕູ.<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />ຫລັງຈາກ ປະຊາຊົນ​ທັງໝົດ​ກໍ​ຈາກ​ໄປ, ກັບ​ໄປ​ເຮືອນ​ຂອງ​ແຕ່ລະ​ຄົນ, ສ່ວນ​ດາວິດ​ກໍ​ໄດ້​ກັບ​ເມືອເຮືອນ​ເພື່ອ​ໄປ​ອວຍພອນ​ຄອບຄົວ​ຂອງ​ເພິ່ນ.<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s1">ຄຳສັນຍາ​ຂອງ​ພຣະເຈົ້າ​ທີ່​ມີ​ຕໍ່​ດາວິດ</para>
  <para style="r">(2ຊມອ 7:1-17)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />ຫລັງ​ຈາກ​ດາວິດ​ເຂົ້າ​ໄປ​ໃນ​ວັງ​ແລ້ວ, ລາວ​ໄດ້​ເວົ້າ​ກັບ​ຜູ້ທຳນວາຍ​ນາທານ​ວ່າ, “ເບິ່ງ​ແມ, ເຮົາ​ອາໄສ​ຢູ່​ໃນ​ເຮືອນ​ທີ່​ສ້າງ​ດ້ວຍ​ຕົ້ນໄມ້​ສີດາ, ໃນຂະນະ​ທີ່​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າຢາເວ​ຢູ່​ໃນ​ຫໍເຕັນ”.<verse eid="1CH 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2" />ນາທານ​ຕອບ​ດາວິດ​ວ່າ, “ຈົ່ງ​ເຮັດ​ຕາມ​ສິ່ງທີ່​ທ່ານ​ຄິດ, ເພາະ​ພຣະເຈົ້າ​ສະຖິດ​ຢູ່​ກັບ​ທ່ານ”.<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />ໃນ​ຄືນ​ນັ້ນ, ຖ້ອຍຄໍາ​ຂອງ​ພຣະເຈົ້າ​ໄດ້​ມາ​ເຖິງ​ນາທານ​ວ່າ:<verse eid="1CH 17:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4" />“ຈົ່ງ​ໄປ​ບອກ​ດາວິດ​ຜູ້ຮັບໃຊ້​ຂອງ​ເຮົາ​ວ່າ, ‘ນີ້​ແມ່ນ​ສິ່ງ​ທີ່​ພຣະເຈົ້າຢາເວ​ກ່າວ​ດັ່ງນີ້: ເຈົ້າ​ບໍ່​ແມ່ນ​ຜູ້​ທີ່​ຈະ​ສ້າງ​ວິຫານ​ໃຫ້​ເຮົາ​ຢູ່. <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />ເຮົາ​ບໍ່​ໄດ້​ຢູ່​ໃນ​ວິຫານ ນັບ​ຕັ້ງແຕ່​ເຮົາ​ໄດ້​ນຳພາ​ປະຊາຊົນ​ອິດສະຣາເອນ​ອອກ​ມາ​ຈາກ​ປະເທດ​ເອຢິບ​ຈົນ​ເຖິງ​ທຸກ​ມື້ນີ້. ເຮົາ​ໄດ້​ຍ້າຍ​ຈາກ​ຫໍເຕັນ​ໜຶ່ງ​ໄປ​ຫາ​ຫໍເຕັນ​ອື່ນ, ຈາກ​ສະຖານທີ່​ໜຶ່ງ​ຍ້າຍ​ໄປ​ສະຖານທີ່​ອື່ນ. <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />ທຸກ​ບ່ອນ​ທີ່​ເຮົາ​ໄປ​ກັບ​ຊາວ​ອິດສະຣາເອນ​ທັງໝົດ, ເຮົາ​ເຄີຍ​ບອກ​ພວກ​ຜູ້ນຳ<note caller="+" style="f"><char style="fr" closed="false">17:6 </char><char style="ft" closed="false">ໂດຍ​ປົກກະຕິ​ແປ​ວ່າ ພວກຜູ້ປົກຄອງ ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="1CH 17:10"><ref loc="1CH 17:10">10</ref></char></char></note> ຄົນ​ໃດ​ຂອງ​ພວກເຂົາ​ບໍ ຄື​ຜູ້​ທີ່​ເຮົາ​ສັ່ງ​ໃຫ້​ລ້ຽງດູ​ປະຊາຊົນ​ຂອງ​ເຮົາ​ວ່າ “ເປັນຫຍັງ​ພວກເຂົາ​ຈຶ່ງ​ບໍ່​ສ້າງ​ວິຫານ​ທີ່​ເຮັດ​ດ້ວຍ​ຕົ້ນໄມ້​ສີດາ​ໃຫ້​ເຮົາ?” ’<verse eid="1CH 17:6" /></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7" />“ບັດນີ້ ຈົ່ງ​ບອກ​ດາວິດ​ຜູ້ຮັບໃຊ້​ຂອງ​ເຮົາ​ວ່າ ‘ພຣະເຈົ້າ​ຢາເວ​ຜູ້​ມີ​ລິດອຳນາດ​ຍິ່ງໃຫຍ່​ກ່າວ​ວ່າ: ເຮົາ​ນຳ​ເຈົ້າ​ອອກ​ມາ​ຈາກ​ທົ່ງຫຍ້າ, ອອກ​ຈາກ​ການ​ເບິ່ງແຍງ​ຝູງແກະ ແລະ ແຕ່ງຕັ້ງ​ເຈົ້າ​ເປັນ​ຜູ້ປົກຄອງ​ອິດສະຣາເອນ​ປະຊາຊົນ​ຂອງ​ເຮົາ. <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />ເຮົາ​ໄດ້​ຢູ່​ກັບ​ເຈົ້າ​ທຸກ​ທີ່​ທຸກ​ບ່ອນ​ທີ່​ເຈົ້າ​ໄປ, ແລະ ເຮົາ​ໄດ້​ທຳລາຍ​ສັດຕູ​ທັງໝົດ​ຂອງ​ເຈົ້າ​ອອກ​ໄປ​ຈາກ​ເຈົ້າ. ບັດນີ້ ເຮົາ​ຈະ​ເຮັດ​ໃຫ້​ເຈົ້າ​ມີ​ຊື່ສຽງ​ເໝືອນ​ຜູ້​ຍິ່ງໃຫຍ່​ທີ່​ສຸດ​ຢູ່​ໃນ​ແຜ່ນດິນ​ໂລກ. <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />ແລະ ເຮົາ​ຈະ​ຈັດຕຽມ​ສະຖານທີ່​ແຫ່ງ​ໜຶ່ງ​ໃຫ້​ອິດສະຣາເອນ​ປະຊາຊົນ​ຂອງ​ເຮົາ​ຕັ້ງ​ຖິ່ນຖານ ເພື່ອ​ພວກເຂົາ​ຈະ​ມີ​ບ້ານ​ເຮືອນ​ເປັນ​ຂອງ​ຕົນ​ເອງ ແລະ ບໍ່​ຕ້ອງ​ຖືກ​ລົບກວນ​ອີກ. ຄົນ​ຊົ່ວ​ຈະ​ບໍ່​ມາ​ຂົ່ມ​ເຫັງ​ພວກເຂົາ​ອີກ, ດັ່ງ​ທີ່​ພວກເຂົາ​ຖືກ​ກະທໍາ​ມາ​ຕັ້ງແຕ່​ຕົ້ນ. <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />ແລະ ເປັນ​ຢ່າງ​ນັ້ນ​ຕະຫລອດ​ມາ​ນັບ​ຕັ້ງ​ແຕ່​ເຮົາ​ໄດ້​ແຕ່ງຕັ້ງ​ບັນດາ​ຜູ້ນຳ​ໃຫ້​ປົກຄອງ​ປະຊາຊົນ​ອິດສະຣາເອນ​ຂອງ​ເຮົາ. ເຮົາ​ຈະ​ປາບ​ສັດຕູ​ທັງຫລາຍ​ຂອງ​ເຈົ້າ​ອີກ​ດ້ວຍ.</para>
  <para style="pm" vid="1CH 17:10">“ ‘ເຮົາ​ຂໍ​ປະກາດ​ຕໍ່​ເຈົ້າ​ວ່າ ພຣະເຈົ້າ​ຢາເວ​ຈະ​ສ້າງ​ຄອບຄົວ​ໜຶ່ງ​ສຳລັບ​ເຈົ້າ. <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />ເມື່ອ​ເຈົ້າ​ຕາຍ​ໄປ ແລະ ເຈົ້າ​ໄປ​ຢູ່​ກັບ​ບັນພະບຸລຸດ​ຂອງ​ເຈົ້າ, ເຮົາ​ຈະ​ຕັ້ງ​ລູກຫລານ​ຄົນ​ໜຶ່ງ​ຂອງ​ເຈົ້າ​ໃຫ້​ສືບທອດ​ຕໍ່​ຈາກ​ເຈົ້າ​ຄື ລູກຊາຍ​ຄົນ​ໜຶ່ງ​ຂອງ​ເຈົ້າ​ເອງ ແລະ ເຮົາ​ຈະ​ຕັ້ງ​ອານາຈັກ​ຂອງ​ລາວ​ໄວ້. <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />ລາວ​ຈະ​ເປັນ​ຜູ້​ສ້າງ​ວິຫານ​ສຳລັບ​ເຮົາ ແລະ ເຮົາ​ຈະ​ຕັ້ງ​ບັນລັງ​ຂອງ​ລາວ​ໃຫ້​ດໍາລົງ​ຢູ່​ຕະຫລອດ​ໄປ. <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />ເຮົາ​ຈະ​ເປັນ​ພໍ່​ຂອງ​ລາວ, ແລະ ລາວ​ຈະ​ເປັນ​ລູກຊາຍ​ຂອງ​ເຮົາ. ເຮົາ​ຈະ​ບໍ່​ຖອນ​ຄວາມ​ຮັກ​ໝັ້ນຄົງ​ຂອງ​ເຮົາ​ອອກ​ໄປ​ຈາກ​ລາວ, ເໝືອນດັ່ງ​ທີ່​ເຮົາ​ໄດ້​ຖອນ​ຈາກ​ຜູ້​ທີ່​ໄດ້​ປົກຄອງ​ກ່ອນ​ໜ້າ​ເຈົ້າ. <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />ເຮົາ​ຈະ​ຕັ້ງ​ລາວ​ໄວ້​ຢູ່​ໃນ​ວິຫານ​ຂອງ​ເຮົາ ແລະ ອານາຈັກ​ຂອງ​ເຮົາ​ຈະ​ດໍາລົງ​ຢູ່​ຕະຫລອດ​ໄປ. ເຮົາ​ຈະ​ຕັ້ງບັນລັງ​ຂອງ​ລາວ​ໄວ້​ຕະຫລອດໄປ​ເປັນ​ນິດ’ ”.<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />ນາທານ​ຈຶ່ງ​ລາຍງານ​ຖ້ອຍຄໍາ​ທັງໝົດ​ທີ່​ພຣະເຈົ້າ​ເປີດເຜີຍ​ນີ້​ໃຫ້​ດາວິດ​ຮູ້.<verse eid="1CH 17:15" /></para>
  <para style="s1">ຄຳອະທິຖານ​ຂອງ​ດາວິດ</para>
  <para style="r">(2ຊມອ 7:18-29)</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />ຫລັງຈາກນັ້ນ​ກະສັດ​ດາວິດ​ຈຶ່ງ​ເຂົ້າ​ໄປ ແລະ ນັ່ງ​ຢູ່​ຕໍ່ໜ້າ​ພຣະເຈົ້າ​ຢາເວ ແລະ ເພິ່ນ​ໄດ້​ເວົ້າ​ວ່າ:</para>
  <para style="pm" vid="1CH 17:16">“ຂ້າແດ່​ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ, ຂ້ານ້ອຍ​ແມ່ນ​ຜູ້ໃດ ແລະ ຄອບຄົວ​ຂອງ​ຂ້ານ້ອຍ​ແມ່ນ​ຜູ້ໃດ, ພຣະອົງ​ຈຶ່ງ​ນຳ​ຂ້ານ້ອຍ​ມາ​ໄກ​ຂະໜາດ​ນີ້? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />ແລະ ບໍ່​ພຽງ​ເທົ່າ​ນີ້, ພຣະເຈົ້າ​ຂອງ​ຂ້ານ້ອຍ, ພຣະອົງ​ຍັງ​ໄດ້​ກ່າວ​ເຖິງ​ອະນາຄົດ​ຂອງ​ຄອບຄົວ​ຜູ້ຮັບໃຊ້​ຂອງ​ພຣະອົງ. ຂ້າແດ່​ພຣະເຈົ້າຢາເວ ພຣະເຈົ້າ, ພຣະອົງ​ເບິ່ງ​ຂ້ານ້ອຍ​ເປັນ​ເໝືອນ​ກັບ​ວ່າ​ເປັນ​ຜູ້​ມີ​ກຽດ​ສູງສົ່ງ.<verse eid="1CH 17:17" /></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18" />“ດາວິດ​ຈະ​ເວົ້າ​ຫຍັງ​ຫລາຍ​ໄປ​ກວ່າ​ນີ້​ໄດ້​ທີ່​ພຣະອົງ​ໃຫ້​ກຽດ​ຜູ້ຮັບໃຊ້​ຂອງ​ພຣະອົງ? ເພາະ​ພຣະອົງ​ຮູ້​ຈັກ​ຜູ້ຮັບໃຊ້​ຂອງ​ພຣະອົງ. <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />ຂ້າແດ່​ພຣະເຈົ້າຢາເວ. ພຣະອົງ​ໄດ້​ເຮັດ​ສິ່ງ​ທີ່​ຍິ່ງໃຫຍ່​ນີ້ ແລະ ເຮັດ​ໃຫ້​ຄຳສັນຍາ​ອັນ​ຍິ່ງໃຫຍ່​ເຫລົ່ານີ້​ເປັນ​ທີ່​ຮູ້ຈັກ, ເພາະ​ເຫັນ​ແກ່​ຜູ້ຮັບໃຊ້​ຂອງ​ພຣະອົງ ແລະ ຕາມ​ຄວາມ​ປະສົງ​ຂອງ​ພຣະອົງ​ເອງ.<verse eid="1CH 17:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20" />“ຂ້າແດ່​ພຣະເຈົ້າ​ຢາເວ, ບໍ່​ມີ​ຜູ້ໃດ​ເປັນ​ເໝືອນ​ພຣະອົງ ແລະ ບໍ່​ມີ​ພະ​ອື່ນ​ໃດ ມີ​ແຕ່​ພຣະອົງ​ເທົ່ານັ້ນ​ທີ່​ເປັນ​ພຣະເຈົ້າ, ຕາມ​ທີ່​ພວກ​ຂ້ານ້ອຍ​ໄດ້​ຍິນ​ມາ​ກັບ​ຫູ​ຂອງ​ພວກ​ຂ້ານ້ອຍ​ເອງ. <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />ແລະ ມີ​ຊົນຊາດ​ໃດ​ໃນ​ໂລກ​ທີ່​ເໝືອນ​ອິດສະຣາເອນ​ປະຊາຊົນ​ຂອງ​ພຣະອົງ​ທີ່​ພຣະເຈົ້າ​ໄດ້​ມາ​ໄຖ່​ພວກເຂົາ​ໃນ​ຖານະ​ປະຊາຊົນ​ເພື່ອ​ພຣະອົງ​ເອງ ແລະ ເພື່ອ​ນຳ​ກຽດຕິຍົດ​ມາ​ສູ່​ນາມ​ຂອງ​ພຣະອົງ ແລະ ໄດ້​ກະທຳ​ການ​ອັດສະຈັນ​ທີ່​ຍິ່ງໃຫຍ່​ອັນ​ໜ້າຢ້ານ ໂດຍ​ຂັບໄລ່​ປະຊາຊາດ​ຕ່າງໆ ແລະ ພະ​ຂອງ​ພວກເຂົາ​ອອກ​ໄປ​ໃຫ້​ພົ້ນ​ໜ້າ​ປະຊາຊົນ​ຂອງ​ພຣະອົງ, ເຊິ່ງ​ພຣະອົງ​ໄດ້​ໄຖ່​ອອກ​ມາ​ຈາກ​ເອຢິບ? <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />ພຣະອົງ​ເຮັດ​ໃຫ້​ປະຊາຊົນ​ອິດສະຣາເອນ​ຂອງ​ພຣະອົງ​ເປັນ​ຂອງ​ພຣະອົງ​ເອງ​ຕະຫລອດ​ໄປ ແລະ ຂ້າແດ່​ພຣະເຈົ້າ​ຢາເວ, ພຣະອົງ​ໄດ້​ກາຍ​ເປັນ​ພຣະເຈົ້າ​ຂອງ​ພວກເຂົາ.<verse eid="1CH 17:22" /></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23" />“ແລະ ບັດນີ້, ຂ້າແດ່​ພຣະເຈົ້າ​ຢາເວ, ຂໍ​ໃຫ້​ຄຳສັນຍາ​ທີ່​ພຣະອົງ​ໄດ້​ໃຫ້​ໄວ້​ກ່ຽວກັບ​ຜູ້ຮັບໃຊ້​ຂອງ​ພຣະອົງ ແລະ ຄອບຄົວ​ຂອງ​ລາວ​ນັ້ນ​ໄດ້​ຮັບ​ການ​ຕັ້ງ​ໄວ້​ຕະຫລອດ​ໄປ. ຂໍ​ເຮັດ​ຕາມ​ດັ່ງ​ທີ່​ພຣະອົງ​ໄດ້​ສັນຍາ​ໄວ້. <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />ເພື່ອ​ວ່າ​ຊື່ສຽງ​ຂອງ​ພຣະອົງ​ຈະ​ໄດ້​ຮັບ​ການ​ຕັ້ງ​ໄວ້ ແລະ ນາມ​ຂອງ​ພຣະອົງ​ຈະ​ຍິ່ງໃຫຍ່​ຕະຫລອດໄປ. ແລ້ວ​ຄົນ​ທັງຫລາຍ​ຈະ​ເວົ້າ​ວ່າ, ‘ພຣະເຈົ້າຢາເວ ຜູ້​ມີ​ລິດ​ອຳນາດ​ຍິ່ງໃຫຍ່, ພຣະເຈົ້າ​ຢູ່​ເໜືອ​ອິດສະຣາເອນ, ເປັນ​ພຣະເຈົ້າ​ຂອງ​ອິດສະຣາເອນ!’ ແລະ ເຊື້ອສາຍ​ດາວິດ​ຜູ້ຮັບໃຊ້​ຂອງ​ພຣະອົງ​ຈະ​ໄດ້​ຮັບ​ການ​ຕັ້ງ​ໄວ້​ຕໍ່ໜ້າ​ພຣະອົງ.<verse eid="1CH 17:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25" />“ຂ້າແດ່​ພຣະເຈົ້າ​ຂອງ​ຂ້ານ້ອຍ, ພຣະອົງ​ໄດ້​ເປີດເຜີຍ​ແກ່​ຜູ້ຮັບໃຊ້​ຂອງ​ພຣະອົງ​ວ່າ​ພຣະອົງ​ຈະ​ສ້າງ​ຄອບຄົວ​ໜຶ່ງ​ເພື່ອ​ລາວ. ດັ່ງນັ້ນ ຜູ້ຮັບໃຊ້​ຂອງ​ພຣະອົງ​ຈຶ່ງ​ກ້າ​ອະທິຖານ​ແບບ​ນີ້​ຕໍ່​ພຣະອົງ. <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />ຂ້າແດ່​ພຣະເຈົ້າ​ຢາເວ, ພຣະອົງ​ເປັນ​ພຣະເຈົ້າ! ພຣະອົງ​ສັນຍາ​ຈະ​ໃຫ້​ສິ່ງ​ດີ​ເຫລົ່ານີ້​ແກ່​ຜູ້ຮັບໃຊ້​ຂອງ​ພຣະອົງ. <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />ບັດນີ້ ພຣະອົງ​ພໍໃຈ​ທີ່​ຈະ​ອວຍພອນ​ຄອບຄົວ​ຜູ້ຮັບໃຊ້​ຂອງ​ພຣະອົງ​ໃຫ້​ຍືນຍົງ​ຕະຫລອດ​ໄປ​ໃນ​ສາຍຕາ​ຂອງ​ພຣະອົງ; ຂ້າແດ່​ພຣະເຈົ້າຢາເວ, ເພາະ​ພຣະອົງ​ໄດ້​ອວຍພອນ​ຄອບຄົວ​ຂອງ​ຂ້ານ້ອຍ​ແລ້ວ ແລະ ພວກເຂົາ​ຈະ​ໄດ້​ຮັບ​ພຣະພອນ​ຕະຫລອດ​ໄປ”.<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s1">ໄຊຊະນະ​ຂອງ​ດາວິດ</para>
  <para style="r">(2ຊມອ 8:1-14)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />ຕໍ່ມາ, ດາວິດ​ໄດ້​ເອົາ​ຊະນະ​ຊາວ​ຟີລິດສະຕິນ​ຢ່າງ​ຮາບຄາບ ແລະ ເພິ່ນ​ໄດ້​ຢຶດ​ເມືອງ​ກາດ ແລະ ໝູ່ບ້ານ​ທີ່​ຢູ່​ອ້ອມແອ້ມ​ເມືອງ​ນັ້ນ​ຈາກ​ການ​ຄວບຄຸມ​ຂອງ​ຊາວ​ຟີລິດສະຕິນ.<verse eid="1CH 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2" />ດາວິດ​ຍັງ​ໄດ້​ເອົາ​ຊະນະ​ຊາວ​ໂມອາບ​ດ້ວຍ ແລະ ພວກເຂົາ​ຕົກ​ເປັນ​ເມືອງ​ຂຶ້ນ ແລະ ນຳ​ເອົາ​ເຄື່ອງບັນນາການ​ມາ​ມອບ​ໃຫ້​ເພິ່ນ.<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />ຫລາຍ​ກວ່າ​ນັ້ນ, ດາວິດ​ໄດ້​ເອົາ​ຊະນະ​ກະສັດ​ຮາດາເດເຊ​ແຫ່ງ​ໂຊບາ, ໃນ​ບໍລິເວນ​ໃກ້​ກັບ​ເມືອງ​ຮາມັດ, ຂະນະ​ທີ່​ຮາດາເດເຊ​ກໍ​ຂຶ້ນ​ສະຖາປະນາ​ອຳນາດ<note caller="+" style="f"><char style="fr" closed="false">18:3 </char><char style="ft" closed="false">ຫລື ໄປ​ຢຶດ​ອຳນາດ​ຄວບຄຸມ​ເໜືອ</char></note>​ແຖບ​ແມ່ນໍ້າ​ເອີຟຣັດ. <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />ດາວິດ​ໄດ້​ຢຶດ​ລົດມ້າຮົບ​ໜຶ່ງ​ພັນ​ຄັນ, ທະຫານມ້າ​ເຈັດ​ພັນ​ຄົນ<note caller="+" style="f"><char style="fr" closed="false">18:4 </char><char style="ft" closed="false">ສະບັບ​ເຊັບຕູອາຈິນ​ວ່າ ຢຶດ​ພົນ​ລົດຮົບ 1.700 ຄົນ (ເບິ່ງ <char style="xt"><ref loc="1CH 18:4">1ຂຄ 18:4</ref></char>)</char></note> ແລະ ທະຫານ​ສອງ​ໝື່ນ​ຄົນ. ດາວິດ​ໄດ້​ຕັດ​ເອັນ​ຂາ​ມ້າ​ທັງໝົດ ຍົກເວັ້ນ​ມ້າ​ສຳລັບ​ລົດຮົບ​ໜຶ່ງ​ຮ້ອຍ​ໂຕ.<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />ເມື່ອ​ຊາວ​ອາຣາມ​ແຫ່ງ​ເມືອງ​ດາມັສກັດ​ມາ​ຊ່ວຍ​ກະສັດ​ຮາດາເດເຊ​ແຫ່ງ​ເມືອງ​ໂຊບາ, ດາວິດ​ໄດ້​ຂ້າ​ພວກເຂົາ 22.000 ຄົນ. <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />ເພິ່ນ​ໄດ້​ວາງ​ກຳລັງ​ທະຫານ​ໄວ້​ໃນ​ອານາຈັກ​ຂອງ​ຊາວ​ອາຣາມ​ແຫ່ງ​ດາມັສກັດ ແລະ ຊາວ​ອາຣາມ​ກໍ​ຍອມ​ຢູ່​ໃຕ້​ອໍານາດ​ຂອງ​ເພິ່ນ ແລະ ຕ້ອງ​ນໍາ​ເຄື່ອງບັນນາການ​ມາ​ໃຫ້​ເພິ່ນ. ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ໃຫ້​ໄຊຊະນະ​ແກ່​ດາວິດ​ໃນ​ທຸກ​ບ່ອນ​ທີ່​ເພິ່ນ​ໄປ.<verse eid="1CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7" />ດາວິດ​ໄດ້​ນຳ​ເອົາ​ໂລ່​ຄຳ​ຂອງ​ບັນດາ​ເຈົ້າໜ້າທີ່​ຂອງ​ກະສັດ​ຮາດາເດເຊ ແລະ ໄດ້​ນຳ​ໂລ່​ເຫລົ່ານັ້ນ​ມາ​ທີ່​ເຢຣູຊາເລັມ. <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />ດາວິດ​ໄດ້​ນຳ​ເອົາ​ທອງສຳລິດ​ເປັນ​ຈຳ​ນວນ​ມະຫາສານ​ມາ​ຈາກ​ເມືອງ​ຕິບຮາດ<note caller="+" style="f"><char style="fr" closed="false">18:8 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ຕິບຮາດ ເປັນ​ອີກ​ຮູບ​ໜຶ່ງ​ຂອງ ເຕບາ</char></note> ແລະ ເມືອງ​ກູນ, ບັນດາ​ເມືອງ​ເຫລົ່ານີ້​ຢູ່​ພາຍໃຕ້​ການ​ປົກຄອງ​ຂອງ​ຮາດາເດເຊ. ເຊິ່ງ​ໂຊໂລໂມນ​ໄດ້​ນໍາໃຊ້​ທອງສຳຣິດ​ເຫລົ່ານີ້​ເຮັດ​ຖັງນໍ້າ, ເສົາ ແລະ ເຄື່ອງໃຊ້​ຕ່າງໆ.<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />ເມື່ອ​ກະສັດ​ໂຕອີ​ແຫ່ງ​ຮາມັດ​ໄດ້​ຍິນຂ່າວ​ວ່າ ດາວິດ​ໄດ້ເອົາ​ຊະນະ​ກອງທັບ​ທັງໝົດ​ຂອງ​ກະສັດ​ຮາດາເດເຊ​ແຫ່ງ​ໂຊບາ, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />ເພິ່ນ​ຈຶ່ງ​ສົ່ງ​ຮາໂດຣາມ ລູກຊາຍ​ຂອງ​ເພິ່ນ​ມາ​ຫາ​ກະສັດ​ດາວິດ​ເພື່ອ​ອວຍພອນ​ເພິ່ນ ແລະ ສະແດງ​ຄວາມ​ດີໃຈ​ນຳ​ໄຊຊະນະ​ຂອງ​ເພິ່ນ​ຕໍ່​ກະສັດ​ຮາດາເດເຊ, ຜູ້​ທີ່​ເຄີຍ​ສູ້ຮົບ​ກັນ​ກັບໂຕອີ​ມາ​ກ່ອນ. ຮາໂດຣາມ​ໄດ້​ນຳ​ເຄື່ອງໃຊ້​ປະເພດ​ຕ່າງໆ​ທີ່​ເຮັດ​ດ້ວຍ​ຄຳ, ເງິນ ແລະ ທອງສໍາລິດ​ມາ​ມອບ​ໃຫ້​ກະສັດ​ດາວິດ.<verse eid="1CH 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11" />ກະສັດ​ດາວິດ​ໄດ້​ຖວາຍ​ສິ່ງ​ເຫລົ່ານີ້​ແກ່​ພຣະເຈົ້າຢາເວ ເພິ່ນ​ໄດ້​ເຮັດ​ແບບດຽວ​ກັນ​ກັບ​ເງິນ ແລະ ຄໍາ​ທີ່​ເພິ່ນ​ໄດ້​ມາ​ຈາກ​ຊົນຊາດ​ທັງໝົດ​ເຫລົ່ານີ້​ຄື ເອໂດມ, ໂມອາບ, ອຳໂມນ, ຟີລິດສະຕິນ ແລະ ອາມາເຫລັກ.<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />ອາບີໄຊ ລູກຊາຍ​ນາງ​ເຊຣູອີຢາ​ໄດ້​ຂ້າ​ຊາວ​ເອໂດມ 18.000 ຄົນ ຢູ່​ໃນ​ຮ່ອມພູ​ເກືອ. <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />ດາວິດ​ໄດ້​ວາງ​ກຳລັງ​ທະຫານ​ໄວ້​ໃນ​ທົ່ວ​ເອໂດມ ແລະ ຊາວ​ເອໂດມ​ທັງໝົດ​ກໍ​ຍອມ​ຢູ່​ໃຕ້​ອໍານາດ​ຂອງ​ດາວິດ. ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ໃຫ້​ໄຊຊະນະ​ແກ່​ດາວິດ​ທຸກ​ບ່ອນ​ທີ່​ເພິ່ນ​ໄປ.<verse eid="1CH 18:13" /></para>
  <para style="s1">ບັນດາ​ຂ້າລາຊະການ​ຂອງ​ດາວິດ</para>
  <para style="r">(2ຊມອ 8:15-18)</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />ດາວິດ​ໄດ້​ປົກຄອງ​ທົ່ວ​ແດນ​ອິດສະຣາເອນ, ເພິ່ນ​ເຮັດ​ສິ່ງ​ທີ່​ຍຸຕິທຳ ແລະ ຖືກຕ້ອງ​ເພື່ອ​ປະຊາຊົນ​ຂອງ​ເພິ່ນ​ທັງໝົດ.<verse eid="1CH 18:14" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="15" style="v" sid="1CH 18:15" />ໂຢອາບ​ລູກຊາຍ​ນາງ​ເຊຣູອີຢາ​ເປັນ​ຜູ້ບັນຊາການ​ກອງທັບ;</para>
  <para style="li1" vid="1CH 18:15">ເຢໂຮຊາຟັດ ລູກຊາຍ​ຂອງ​ອາຮີລຸດ​ເປັນ​ຜູ້​ຮັບຜິດຊອບ​ບັນທຶກ;<verse eid="1CH 18:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 18:16" />ຊາດົກ​ລູກຊາຍ​ຂອງ​ອາຮີຕຸບ ແລະ ແລະ ອາຮີເມເຫລັກ<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">ສຳ​ເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ອາບີເມເຫລັກ (ເບິ່ງ <char style="xt"><ref loc="2SA 8:17">2ຊມອ 8:17</ref></char>)</char></note> ລູກຊາຍ​ຂອງ​ອາບີອາທາ​ເປັນ​ປະໂລຫິດ;</para>
  <para style="li1" vid="1CH 18:16">ຊະວາຊາ​ເປັນ​ເລຂາທິການ;<verse eid="1CH 18:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 18:17" />ຊາວເກເຣັດ ແລະ ຊາວເປເລັດ​ເປັນ​ຫົວໜ້າ​ຊາວ​ເກເຣັດ ແລະ ຊາວ​ເປເລັດ;</para>
  <para style="li1" vid="1CH 18:17">ແລະ ບັນດາ​ລູກຊາຍ​ຂອງ​ກະສັດ​ດາວິດ​ຫົວໜ້າ​ຂອງ​ບັນດາ​ຂ້າລາຊະການ​ໃນ​ຝ່າຍ​ຂອງ​ກະສັດ.<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s1">ດາວິດ​ຊະນະ​ຊາວ​ອຳໂມນ</para>
  <para style="r">(2ຊມອ 10:1-19)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />ຕໍ່ມາ, ກະສັດ​ນາຮາດ​ແຫ່ງ​ອຳໂມນ​ໄດ້​ຕາຍ​ໄປ, ແລະ ຮານູນ​ລູກຊາຍ​ຂອງ​ເພິ່ນ​ໄດ້​ຂຶ້ນ​ເປັນ​ກະສັດ​ແທນ. <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />ດາວິດ​ເວົ້າ​ວ່າ, “ເຮົາ​ຈະ​ສະແດງ​ຄວາມ​ເມດຕາ​ຕໍ່​ຮານູນ​ລູກຊາຍ​ຂອງ​ນາຮາດ, ເພາະ​ພໍ່​ຂອງ​ລາວ​ໄດ້​ສະແດງ​ຄວາມ​ເມດຕາ​ຕໍ່​ເຮົາ”. ດັ່ງນັ້ນ ດາວິດ​ຈຶ່ງ​ສົ່ງ​ຄະນະທູດ​ໄປ​ສະແດງ​ຄວາມ​ໂສກເສົ້າ​ເສຍໃຈ​ຕໍ່​ຮານູນ​ກ່ຽວກັບ​ພໍ່​ຂອງ​ລາວ.</para>
  <para style="p" vid="1CH 19:2">ເມື່ອ​ຄະນະ​ທູດ​ຂອງ​ດາວິດ​ມາ​ພົບ​ຮານູນ​ທີ່​ດິນແດນ​ຊາວ​ອຳໂມນ​ເພື່ອ​ສະແດງ​ຄວາມ​ໂສກເສົ້າ​ເສຍໃຈ​ຕໍ່​ລາວ, <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />ພວກ​ຜູ້ບັນຊາການ​ຊາວ​ອຳໂມນ​ເວົ້າ​ກັບ​ຮານູນ​ວ່າ, “ທ່ານ​ຄິດ​ວ່າ​ດາວິດ​ໃຫ້​ກຽດ​ພໍ່​ຂອງ​ທ່ານ​ໂດຍ​ການ​ສົ່ງ​ພວກ​ທູດ​ມາ​ເພື່ອ​ສະແດງ​ຄວາມ​ໂສກເສົ້າ​ເສຍໃຈ​ຕໍ່​ທ່ານ​ຊັ້ນ​ບໍ? ພວກເຂົາ​ໄດ້​ບໍ່​ມາເພື່ອ​ສໍາຫຼວດ​ເທົ່ານັ້ນ ແລະ ມາ​ເພື່ອ​ສອດແນມ​ເບິ່ງ​ປະເທດ ແລ້ວ​ກໍ​ໂຄ່ນ​ລົ້ມ​ບໍ່ແມ່ນ​ບໍ?” <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />ດັ່ງນັ້ນ ຮານູນ​ຈຶ່ງ​ຈັບ​ຄະນະທູດ​ຂອງ​ດາວິດ​ແຖ​ໜວດ, ແລະ ຕັດ​ເສື້ອ​ຜ້າ​ບ່ອນ​ກະໂພກ​ກົ້ນ​ຂອງ​ພວກເຂົາ​ອອກ, ແລ້ວ​ກໍ​ປ່ອຍ​ພວກເຂົາ​ໄປ.<verse eid="1CH 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5" />ເມື່ອ​ມີ​ຄົນ​ມາ​ບອກ​ດາວິດ​ກ່ຽວກັບ​ເລື່ອງ​ທີ່​ເກີດ​ຂຶ້ນ​ກັບ​ຄົນ​ເຫລົ່ານັ້ນ, ເມື່ອ​ດາວິດ​ຮູ້​ເລື່ອງ​ນີ້, ເພິ່ນ​ກໍ​ສົ່ງ​ຜູ້​ສົ່ງ​ຂ່າວ​ໄປ​ພົບ​ຄົນ​ເຫລົ່ານັ້ນ, ເພາະ​ພວກເຂົາ​ຮູ້ສຶກ​ອັບອາຍ​ຂາຍໜ້າ​ຫລາຍ. ກະສັດ​ເວົ້າ​ວ່າ, “ຈົ່ງ​ພັກ​ຢູ່​ທີ່​ເຢຣິໂກ​ຈົນ​ກວ່າ​ໜວດ​ຂອງ​ພວກເຈົ້າ​ຈະ​ປົ່ງ​ໃໝ່, ແລ້ວ​ຈຶ່ງ​ກັບ​ຄືນ​ມາ”.<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />ເມື່ອ​ຊາວ​ອຳໂມນ​ຮູ້ວ່າ, ພວກເຂົາ​ໄດ້​ເຮັດ​ສິ່ງ​ທີ່​ໜ້າລັງກຽດ​ຕໍ່​ດາວິດ, ຮານູນ ແລະ ຊາວ​ອຳໂມນ​ຈຶ່ງ​ນຳ​ເອົາ​ເງິນ​ໜຶ່ງພັນ​ຕະລັນຕົນ<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ 1.000 ຕາລັນຕົນ</char></note>​ໄປ​ຈ້າງ​ລົດຮົບ ແລະ ທະຫານ​ມ້າ​ຈາກ​ອາຣາມ​ນາຮາຣາອິມ, ອາຣາມ ມາອາກາ ແລະ ໂຊບາ. <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />ພວກເຂົາ​ໄດ້​ຈ້າງ​ລົດຮົບ ແລະ ທະຫານມ້າ​ສາມສິບສອງ​ພັນ​ຄັນ, ແລະ ຈ້າງ​ກອງທະຫານ​ຂອງ​ກະສັດ​ມາອາກາ, ທີ່​ມາ​ຕັ້ງ​ຄ້າຍ​ຢູ່​ໃກ້​ເມືອງ​ເມເດບາ. ໃນຂະນະ​ທີ່​ຊາວ​ອຳໂມນ​ຍົກ​ທັບອອກ​ມາ​ຈາກ​ເມືອງ​ຕ່າງໆ​ຂອງ​ພວກເຂົາ​ເພື່ອ​ສູ້ຮົບ.<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />ເມື່ອ​ໄດ້​ຍິນ​ເລື່ອງ​ນີ້, ດາວິດ​ກໍ​ສົ່ງ​ໂຢອາບ​ພ້ອມທັງ​ທະຫານ​ໃນ​ກອງທັບ​ທັງໝົດ​ອອກ​ໄປ. <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />ຊາວ​ອຳໂມນ​ອອກ​ມາ ແລະ ຕັ້ງ​ແນວ​ສູ້ຮົບ​ຢູ່​ທີ່​ທາງເຂົ້າ​ເມືອງ​ຂອງ​ພວກເຂົາ, ໃນຂະນະ​ທີ່​ບັນດາ​ກະສັດ​ໄດ້​ອອກ​ມາ​ຮ່ວມ​ສູ້ຮົບ​ນໍາ​ນັ້ນ ກໍ​ຕັ້ງ​ທີ່​ໝັ້ນ​ຂອງ​ພວກ​ຕົນ​ຢູ່​ນອກ​ເມືອງ.<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />ໂຢອາບ​ເຫັນ​ວ່າ​ກອງ​ກຳລັງ​ຂອງ​ສັດຕູ​ຕັ້ງ​ແນວ​ສູ້ຮົບ​ຢູ່​ທັງ​ຂ້າງ​ໜ້າ ແລະ ຂ້າງ​ຫລັງ​ຂອງ​ຕົນ; ດັ່ງນັ້ນ ລາວ​ຈຶ່ງ​ເລືອກ​ເອົາ​ກອງທະຫານ​ທີ່​ເກັ່ງກ້າ​ທີ່ສຸດ​ສ່ວນ​ໜຶ່ງ​ໃນ​ອິດສະຣາເອນ ແລະ ໃຫ້​ພວກເຂົາ​ຕັ້ງ​ທ່າ​ຕໍ່ສູ້​ກັບ​ຊາວ​ອາຣາມ. <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />ລາວ​ໄດ້​ວາງ​ທະຫານ​ທີ່​ເຫລືອ​ນັ້ນ​ຢູ່​ພາຍໃຕ້​ຄຳສັ່ງ​ຂອງ​ອາບີໄຊ​ນ້ອງຊາຍ​ຂອງ​ລາວ ແລະ ພວກເຂົາ​ໄດ້​ອອກ​ໄປ​ຕໍ່ສູ້​ກັບ​ຊາວ​ອຳໂມນ. <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />ໂຢອາບ​ເວົ້າ​ກັບ​ທະຫານ​ຂອງ​ຕົນ​ວ່າ, “ຖ້າ​ຊາວ​ອາຣາມ​ແຂງແຮງ​ເກີນ​ໄປ​ສໍາລັບ​ຂ້ອຍ, ເຈົ້າ​ຈົ່ງ​ມາ​ຊ່ວຍ​ຂ້ອຍ; ແຕ່​ຖ້າ​ຊາວ​ອຳໂມນ​ແຂງແຮງ​ເກີນ​ໄປ​ສໍາລັບ​ເຈົ້າ, ຂ້ອຍ​ຈະ​ໄປ​ຊ່ວຍ​ເຈົ້າ. <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />ຈົ່ງ​ເຂັ້ມແຂງ ແລະ ໃຫ້​ພວກເຮົາ​ຕໍ່ສູ້​ຢ່າງ​ກ້າຫານ​ເພື່ອ​ພີ່ນ້ອງ​ຮ່ວມ​ຊາດ​ຂອງ​ພວກເຮົາ ແລະ ເມືອງ​ຕ່າງໆ​ຂອງ​ພຣະເຈົ້າ. ພຣະເຈົ້າຢາເວ​ຈະ​ເຮັດ​ສິ່ງ​ທີ່​ດີ​ໃນ​ສາຍຕາ​ຂອງ​ພຣະອົງ”.<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />ແລ້ວ​ໂຢອາບ ແລະ ກອງ​ທະຫານ​ຂອງ​ຕົນ​ກໍ​ຍົກທັບ​ບຸກ​ເຂົ້າ​ໂຈມຕີ​ຊາວ​ອາຣາມ, ແລ້ວ​ພວກເຂົາ​ກໍ​ປົບໜີ​ໄປ​ຕໍ່ໜ້າ​ເພິ່ນ. <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />ເມື່ອ​ຊາວ​ອຳໂມນ​ເຫັນ​ຊາວ​ອາຣາມ​ກໍາລັງ​ປົບໜີ​ໄປ, ພວກເຂົາ​ກໍ​ແລ່ນ​ປົບໜີ​ໄປ​ເໜືອນກັນ​ຕໍ່ໜ້າ​ອາບີໄຊ​ນ້ອງຊາຍ​ຂອງ​ລາວ ແລະ ພວກເຂົາ​ໄດ້​ເຂົ້າ​ໄປ​ໃນ​ເມືອງ. ດັ່ງນັ້ນ ໂຢອາບ​ຈຶ່ງ​ກັບຄືນ​ມາ​ທີ່​ເຢຣູຊາເລັມ.<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />ຫລັງຈາກ​ຊາວ​ອາຣາມ​ເຫັນ​ວ່າ, ພວກເຂົາ​ໄດ້​ພ່າຍ​ແພ້​ໃຫ້​ແກ່​ອິດສະຣາເອນ​ແລ້ວ, ພວກເຂົາ​ໄດ້​ສົ່ງ​ຜູ້ນໍາຂ່າວ​ໄປ ແລະ ໃຫ້​ຊາວ​ອາຣາມ​ນໍາ​ເອົາ​ກອງ​ທະຫານ​ມາ​ຈາກ​ອີກ​ຟາກ​ໜຶ່ງ​ຂອງ​ແມ່ນໍ້າ​ເອີຟຣັດ, ໂດຍ​ມີ​ໂຊບັກ ຜູ້​ບັນຊາການ​ກອງທັບ​ຂອງ​ຮາດາເດເຊ​ເປັນ​ຜູ້​ນໍາພາ.<verse eid="1CH 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17" />ເມື່ອ​ດາວິດ​ໄດ້​ຮູ້​ເລື່ອງ​ນີ້, ເພິ່ນ​ກໍ​ຮວບຮວມ​ເອົາ​ທະຫານ​ອິດສະຣາເອນ​ທັງໝົດ​ຂ້າມ​ແມ່ນ້ຳ​ຈໍແດນ​ໄປ​ເພິ່ນ​ບຸກ​ໂຈມຕີ​ຕໍ່ສູ້​ພວກເຂົາ ແລະ ໄດ້​ຕັ້ງ​ແນວຮົບ​ຕ້ານ​ພວກເຂົາ. ດາວິດ​ໄດ້​ຕັ້ງ​ແນວຮົບ​ປະເຊີນ​ໜ້າ​ກັບ​ຊາວ​ອາຣາມ​ໃນ​ສະໜາມຮົບ. ພວກເຂົາ​ໄດ້​ຕໍ່ສູ້​ກັບ​ເພິ່ນ. <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />ແຕ່​ພວກເຂົາ​ໄດ້​ປົບ​ໜີ​ໄປ​ຕໍ່ໜ້າ​ຊາວ​ອິດສະຣາເອນ ແລະ ດາວິດ​ໄດ້​ຂ້າ​ທະຫານມ້າ​ຂອງ​ພວກເຂົາ​ເຈັດ​ພັນ​ຄົນ ແລະ ທະຫານ​ລາບ​ສີ່ສິບ​ພັນ​ຄົນ. ເພິ່ນ​ຍັງ​ໄດ້​ຂ້າ​ໂຊບັກ​ຜູ້​ບັນຊາການ​ກອງທັບ​ຂອງ​ພວກເຂົາ.<verse eid="1CH 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19" />ເມື່ອ​ຄົນຮັບໃຊ້​ຂອງ​ຮາດາເດເຊ​ເຫັນ​ວ່າ​ພວກເຂົາ​ໄດ້​ພ່າຍແພ້​ໃຫ້​ອິດສະຣາເອນ​ແລ້ວ, ພວກເຂົາ​ກໍ​ໄດ້​ເຮັດ​ສັນຍາ​ສະຫງົບ​ເສິກ​ກັບ​ດາວິດ ແລະ ຍອມ​ຢູ່​ໃຕ້​ອຳນາດ​ຂອງ​ເພິ່ນ.</para>
  <para style="p" vid="1CH 19:19">ດັ່ງນັ້ນ ຊາວ​ອາຣາມ​ຈຶ່ງ​ບໍ່​ກ້າ​ຊ່ວຍ​ຊາວ​ອຳໂມນ​ອີກ​ເລີຍ.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s1">ການ​ຢຶດ​ເມືອງ​ຣັບບາ</para>
  <para style="r">(<ref loc="2SA 11:1">2ຊມອ 11:1</ref>; 12:29-31)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />ໃນ​ລະດູ​ໃບໄມ້ປົ່ງ, ເປັນ​ເວລາ​ທີ່​ບັນດາ​ກະສັດ​ອອກ​ໄປ​ເຮັດ​ເສິກ, ໂຢອາບ​ໄດ້​ນຳ​ທະຫານ​ອອກ​ໄປ. ລາວ​ໄດ້​ທຳລາຍ​ດິນແດນ​ຂອງ​ຊາວ​ອຳໂມນ ແລ້ວ​ໄດ້​ປິດລ້ອມ​ເມືອງ​ຣັບບາ​ໄວ້, ແຕ່​ດາວິດ​ຍັງ​ຢູ່​ໃນ​ເຢຣູຊາເລັມ. ໂຢອາບ​ໄດ້​ໂຈມ​ຕີ​ຣັບບາ ແລະ ປະຖິ້ມ​ໄວ້​ໃຫ້​ເປັນ​ຊາກ​ເພພັງ. <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />ດາວິດ​ໄດ້​ເອົາ​ມົງກຸດ​ຈາກ​ຫົວ​ຂອງ​ບັນດາ​ກະສັດ<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">ຫລື ຂອງ​ພະ​ມິນ </char><char style="fqa" closed="false">ກົມ </char><char style="ft" closed="false">(ຄື ພຣະໂມລົກ)</char></note> ຂອງ​ພວກເຂົາ​ມາ​ສວມ​ເທິງ​ຫົວ​ຂອງ​ຕົນ ມົງກຸດ​ນັ້ນ​ເຮັດ​ດ້ວຍ​ຄໍາ​ໜັກ​ໜຶ່ງ​ຕະລັນຕົນ,<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ 1 ຕະລັນຕົນ</char></note> ແລະ ປະດັບ​ດ້ວຍ​ເພັດ​ຕ່າງໆ. ດາວິດ​ໄດ້​ປຸ້ນ​ມາ​ຈາກ​ເມືອງ​ນັ້ນ​ເປັນ​ຈຳນວນ​ຫລາຍ. <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />ແລະ ໄດ້​ເອົາ​ປະຊາຊົນ​ຢູ່​ທີ່ນັ້ນ, ມາ​ເຮັດ​ວຽກ​ໂດຍ​ໃຊ້​ເລື່ອຍ ຈົກ ສຽມ ແລະ ຂວານ. ດາວິດ​ໄດ້​ເຮັດ​ເຊັ່ນ​ນີ້​ກັບ​ທຸກ​ເມືອງ​ຂອງ​ຊາວ​ອຳໂມນ. ແລ້ວ​ເພິ່ນ ແລະ ກອງທັບ​ກໍ​ກັບຄືນ​ໄປ​ທີ່​ເຢຣູຊາເລັມ.<verse eid="1CH 20:3" /></para>
  <para style="s1">ການເຮັດເສິກ​ກັບ​ຊາວ​ຟີລິດສະຕິນ</para>
  <para style="r">(2ຊມອ 21:15-22)</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />ຕໍ່ມາ, ມີ​ການ​ສູ້ຮົບ​ກັບ​ຊາວ​ຟີລິດສະຕິນ, ທີ່​ເກເຊ. ໃນ​ເວລາ​ນັ້ນ​ສິບເບກາຍ​ຊາວ​ຮູຊາ​ໄດ້​ຂ້າ​ສິບປາຍ​ທີ່​ເປັນ​ຜູ້​ໜຶ່ງ​ໃນ​ເຊື້ອສາຍ​ຂອງ​ຄົນ​ຮ່າງໃຫຍ່​ຂອງ​ຊາວ​ເຣຟາອິມ ແລະ ຊາວ​ຟີລິດສະຕິນ​ກໍ​ໄດ້​ພ່າຍແພ້.<verse eid="1CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5" />ໃນ​ການ​ສູ້ຮົບ​ກັບ​ຊາວ​ຟີລິດສະຕິນ​ອີກ​ຄັ້ງ​ໜຶ່ງ, ເອນຮານານ​ລູກຊາຍ​ຂອງ​ຢາອີ​ໄດ້​ຂ້າ​ລາຮະມີ​ນ້ອງຊາຍ​ຂອງ​ໂກລີອາດ​ຊາວ​ກາດ, ຜູ້​ທີ່​ຖື​ຫອກ​ດ້າມ​ໃຫຍ່​ເໝືອນ​ໄມ້​ທີ່​ໃຊ້​ຕ່ຳຫູກ.<verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />ໃນ​ການ​ສູ້ຮົບ​ອີກ​ຄັ້ງ, ເຊິ່ງ​ໄດ້​ເກີດ​ຂຶ້ນ​ທີ່​ເມືອງ​ກາດ ຄົນ​ຮູບຮ່າງ​ໃຫຍ່​ທີ່​ມີ​ນິ້ວມື​ນິ້ວຕີນ​ເບື້ອງ​ລະ​ຫົກ​ນິ້ວ​ລວມ​ທັງໝົດ​ມີ​ຊາວສີ່​ນິ້ວ. ລາວ​ເປັນ​ເຊື້ອສາຍ​ຂອງ​ຣາຟາ​ເໝືອນ​ກັນ. <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />ເມື່ອ​ລາວ​ໄດ້​ເວົ້າ​ເຢາະເຢີ້ຍ​ຊາວ​ອິດສະຣາເອນ, ໂຢນາທານ​ລູກຊາຍ​ຂອງ​ຊີເມອາ​ອ້າຍ​ຂອງ​ດາວິດ​ໄດ້​ຂ້າ​ລາວ.<verse eid="1CH 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8" />ຄົນ​ເຫລົ່ານີ້​ເປັນ​ເຊື້ອສາຍ​ຂອງ​ຣາຟາ​ໃນ​ເມືອງ​ກາດ, ແລ້ວ​ພວກເຂົາ​ໄດ້​ຖືກ​ດາວິດ ແລະ ທະຫານ​ຂອງ​ເພິ່ນ​ໄດ້​ຂ້າ​ພວກເຂົາ​ດ້ວຍ​ມື​ຂອງ​ຕົນ.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s1">ດາວິດ​ນັບ​ໄພ່​ພົນ</para>
  <para style="r">(2ຊມອ 24:1-25)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />ມານຊາຕານ​ລຸກ​ຂຶ້ນ​ຕໍ່ສູ້​ອິດສະຣາເອນ ແລະ ໄດ້​ດົນໃຈ​ໃຫ້​ດາວິດ​ນັບ​ຈຳນວນ​ປະຊາຊົນ​ອິດສະຣາເອນ. <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />ດາວິດ​ຈຶ່ງ​ເວົ້າ​ກັບ​ໂຢອາບ ແລະ ຜູ້ບັນຊາການ​ກອງ​ທະຫານ​ວ່າ, “ຈົ່ງ​ໄປ​ນັບ​ຈຳນວນ​ປະຊາຊົນ​ອິດສະຣາເອນ​ຕັ້ງແຕ່​ເມືອງ​ເບເອນເຊບາ​ຈົນຮອດ​ເມືອງ​ດານ. ແລ້ວ​ກັບ​ມາ​ລາຍງານ​ເຮົາ ເພື່ອ​ວ່າ​ເຮົາ​ຈະ​ຮູ້​ວ່າ​ມີ​ຈຳນວນ​ເທົ່າ​ໃດ”.<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />ແຕ່​ໂຢອາບ​ຕອບ​ວ່າ, “ຂໍ​ພຣະເຈົ້າຢາເວ​ທະວີຄູນ​ກອງທະຫານ​ຂອງ​ທ່ານ​ຮ້ອຍ​ເທົ່າ. ຂ້າແດ່​ກະສັດ, ພວກເຂົາ​ກໍ​ເປັນ​ຂອງ​ທ່ານ​ບໍ່​ແມ່ນ​ບໍ? ເປັນຫຍັງ​ທ່ານ​ຈຶ່ງ​ຢາກ​ເຮັດ​ສິ່ງ​ນີ້? ເປັນຫຍັງ​ພວກເຂົາ​ຈະ​ຕ້ອງ​ນຳ​ຄວາມຜິດ​ມາ​ສູ່​ອິດສະຣາເອນ?”<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />ເຖິງ​ຢ່າງ​ໃດ​ກໍ​ຕາມ, ເພາະ​ຄຳສັ່ງ​ຂອງ​ກະສັດ​ມີ​ອຳນາດ​ເໜືອ​ໂຢອາບ; ດັ່ງນັ້ນ ໂຢອາບ​ຈຶ່ງ​ເດີນທາງ​ໄປ​ທົ່ວ​ດິນແດນ​ອິດສະຣາເອນ​ແລ້ວ​ກັບ​ຄືນ​ມາ​ເຢຣູຊາເລັມ. <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />ໂຢອາບ​ໄດ້​ລາຍງານ​ຈຳນວນ​ທະຫານ​ໃຫ້​ແກ່​ດາວິດ​ດັ່ງນີ້: ທົ່ວ​ອິດສະຣາເອນ​ມີ​ໜຶ່ງ​ລ້ານ​ໜຶ່ງແສນ​ຄົນ​ທີ່​ສາມາດ​ຖື​ດາບ​ໄປ​ຕໍ່ສູ້​ໄດ້​ລວມທັງ​ຢູດາຍ​ມີ​ສີ່​ຮ້ອຍ​ເຈັດສິບ​ພັນ​ຄົນ.<verse eid="1CH 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6" />ແຕ່​ໂຢອາບ​ບໍ່​ໄດ້​ລວມ​ເອົາ​ຈຳນວນ​ຄົນ​ໃນ​ເຜົ່າ​ເລວີ ແລະ ເຜົ່າ​ເບັນຢາມິນ, ເພາະ​ຄຳສັ່ງ​ຂອງ​ກະສັດ​ເປັນ​ສິ່ງ​ທີ່​ລາວ​ບໍ່​ເຫັນດີ. <verse eid="1CH 21:6" /><verse number="7" style="v" sid="1CH 21:7" />ຄຳສັ່ງ​ນີ້​ກໍ​ເປັນ​ສິ່ງ​ທີ່​ຊົ່ວຮ້າຍ​ໃນ​ສາຍຕາ​ຂອງ​ພຣະເຈົ້າ​ດ້ວຍ; ດັ່ງນັ້ນ ພຣະອົງ​ຈຶ່ງ​ລົງໂທດ​ຊາວ​ອິດສະຣາເອນ.<verse eid="1CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8" />ແລ້ວ​ດາວິດ​ໄດ້​ເວົ້າ​ຕໍ່​ພຣະເຈົ້າ​ວ່າ, “ຂ້ານ້ອຍ​ໄດ້​ເຮັດ​ບາບ​ຢ່າງ​ຮ້າຍແຮງ​ດ້ວຍ​ການ​ເຮັດ​ສິ່ງ​ນີ້. ບັດນີ້​ຂ້ານ້ອຍ​ຂໍ​ພຣະອົງ​ໂຜດ​ຍົກ​ໂທດ​ຄວາມຜິດ​ຂອງ​ຜູ້ຮັບໃຊ້​ຂອງ​ພຣະອົງ. ຂ້ານ້ອຍ​ໄດ້​ເຮັດ​ສິ່ງ​ທີ່​ໂງ່​ຫລາຍ”.<verse eid="1CH 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />ພຣະເຈົ້າຢາເວ​ໄດ້​ກ່າວ​ຕໍ່​ກາດ​ຜູ້ທຳນວາຍ​ຂອງ​ດາວິດ​ວ່າ, <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />“ຈົ່ງ​ໄປ​ບອກ​ດາວິດ​ວ່າ, ‘ນີ້​ແມ່ນ​ສິ່ງ​ທີ່​ພຣະເຈົ້າຢາເວ​ກ່າວ: ເຮົາ​ມີ​ຂໍ້​ສະເໜີ​ສາມ​ປະການ ໃຫ້​ເຈົ້າ​ເລືອກ​ຢ່າງ​ໜຶ່ງ​ແລ້ວ​ເຮົາ​ຈະ​ຈັດການ​ກັບ​ເຈົ້າ​ຕາມ​ນັ້ນ’ ”.<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />ດັ່ງນັ້ນ ກາດ​ໄດ້​ໄປ​ຫາ​ດາວິດ ແລະ ເວົ້າ​ກັບ​ເພິ່ນ​ວ່າ, “ນີ້​ແມ່ນ​ສິ່ງ​ທີ່​ພຣະເຈົ້າຢາເວ​ກ່າວ​ດັ່ງນີ້: ‘ຈົ່ງ​ເລືອກ​ເອົາ​ຄື: <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />ເກີດ​ການ​ອຶດຢາກ​ອາຫານ​ເປັນ​ເວລາ​ສາມ​ປີ ຫລື ຖືກ​ສັດຕູ​ຂອງ​ເຈົ້າ​ໄລ່ຕາມ​ເປັນ​ເວລາ​ສາມ​ເດືອນ,<note caller="+" style="f"><char style="fr" closed="false">21:12 </char><char style="ft" closed="false">ສະບັບ ຊັບຕູອາຈິນ ແລະ Vulg. ວ່າ </char><char style="fqa" closed="false">ແຕກ​ໜີ​ຈາກ​ການ​ໄລ່ຕາມ​ຂ້າ​ຂອງ​ສັດຕູ​ສາມ​ເດືອນ (ເບິ່ງ <char style="xt"><ref loc="2SA 24:13">2ຊມອ 24:13</ref></char>)</char></note> ຫລື ໃຫ້​ດາບ​ຂອງ​ພວກເຂົາ​ໄລ່​ຕາມ​ທັນ​ເຈົ້າ, ຫລື ໃຫ້​ດາບ​ຂອງ​ພຣະເຈົ້າຢາເວ​ໂຈມຕີ​ຄື ວັນ​ນັ້ນ​ຈະ​ນໍາ​ເອົາ​ພະຍາດ​ລະບາດ​ມາ​ສູ່​ດິນແດນ​ຂອງ​ທ່ານ​ສາມ​ວັນ​ໂດຍ​ໃຫ້​ເທວະດາ​ຂອງ​ພຣະເຈົ້າຢາເວ​ທໍາລາຍ​ທຸກ​ພາກ​ຂອງ​ອິດສະຣາເອນ’. ດັ່ງນັ້ນ ຂໍ​ຈົ່ງ​ຕັດສິນໃຈ​ເພື່ອ​ຂ້ານ້ອຍ​ຈະ​ຕອບ​ພຣະອົງ​ຜູ້​ທີ່​ໃຊ້​ຂ້ານ້ອຍ​ມາ”.<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />ດາວິດ​ຕອບ​ກາດ​ວ່າ, “ເຮົາ​ລຳບາກ​ໃຈ​ຫລາຍ. ແຕ່​ເຮົາ​ຂໍ​ຕົກ​ຢູ່​ໃນ​ມື​ຂອງ​ພຣະເຈົ້າຢາເວ, ເພາະ​ຄວາມ​ເມດຕາ​ຂອງ​ພຣະອົງ​ຍິ່ງໃຫຍ່​ຫລາຍ; ຂໍ​ຢ່າ​ໃຫ້​ເຮົາ​ຕົກ​ຢູ່​ໃນ​ມື​ຂອງ​ມະນຸດ”.<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />ດັ່ງນັ້ນ ພຣະເຈົ້າຢາເວ​ຈຶ່ງ​ສົ່ງ​ພະຍາດ​ລະບາດ​ມາ​ສູ່​ຊາວ​ອິດສະຣາເອນ ແລະ ມີ​ຄົນ​ໄດ້​ລົ້ມ​ຕາຍ​ໄປ​ເຈັດ​ໝື່ນ​ຄົນ. <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />ແລະ ພຣະເຈົ້າ​ໄດ້​ສົ່ງ​ເທວະດາ​ອົງ​ໜຶ່ງ​ມາ​ທຳລາຍ​ເຢຣູຊາເລັມ. ແຕ່​ໃນຂະນະ​ທີ່​ເທວະດາ​ກໍາລັງ​ດໍາເນີນການ​ຢູ່​ນັ້ນ, ພຣະເຈົ້າຢາເວ​ກໍ​ໄດ້​ເຫັນ ແລະ ທຸກໃຈ​ກ່ຽວກັບ​ໄພພິບັດ​ນັ້ນ ຈຶ່ງ​ກ່າວ​ແກ່​ເທວະດາ​ຜູ້​ກໍາລັງ​ທຳລາຍ​ປະຊາຊົນ​ວ່າ, “ພໍ​ແລ້ວ! ຢຸດ” ເທວະດາ​ຂອງ​ພຣະເຈົ້າຢາເວ​ກຳລັງ​ຢືນ​ຢູ່​ໃກ້​ລານ​ຟາດເຂົ້າ​ຂອງ​ອາໂຣນາ<note caller="+" style="f"><char style="fr" closed="false">21:15 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ </char><char style="fqa" closed="false">ໂອຣະນານ </char><char style="ft" closed="false">ເປັນ​ອີກ​ຮູບ​ໜຶ່ງ​ຂອງ </char><char style="fq" closed="false">ອາໂຣນາ</char><char style="ft" closed="false">; ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="1CH 21:18-28"><ref loc="1CH 21:18">18-28</ref></char></char></note> ຊາວ​ເຢບຸດ.<verse eid="1CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16" />ເມື່ອ​ດາວິດ​ຫລຽວ​ຂຶ້ນ ແລະ ໄດ້​ເຫັນ​ເທວະດາ​ຂອງ​ພຣະເຈົ້າຢາເວ​ຢືນ​ຢູ່​ລະຫວ່າງ​ຟ້າ​ສະຫວັນ ແລະ ແຜ່ນດິນ​ໂລກ, ໂດຍ​ຖື​ດາບ​ຢູ່​ໃນ​ມື​ຂອງ​ຕົນ​ຢູ່​ເໜືອ​ເຢຣູຊາເລັມ. ຈາກນັ້ນ ດາວິດ ແລະ ບັນດາ​ເຖົ້າແກ່​ໃສ່​ເຄື່ອງ​ທີ່​ເຮັດ​ດ້ວຍ​ຜ້າ​ກະສອບ​ເຂົ້າ​ໄດ້​ກົ້ມ​ກາບ​ລົງ​ພື້ນດິນ.<verse eid="1CH 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17" />ດາວິດ​ໄດ້​ເວົ້າ​ກັບ​ພຣະເຈົ້າ​ວ່າ, “ຂ້ານ້ອຍ​ເປັນ​ຜູ້​ອອກ​ຄຳສັ່ງ​ໃຫ້​ນັບ​ຈຳນວນ​ປະຊາຊົນ​ບໍ່​ແມ່ນ​ບໍ. ຂ້ານ້ອຍ​ຄື​ຜູ້ລ້ຽງ<note caller="+" style="f"><char style="fr" closed="false">21:17 </char><char style="ft" closed="false">ເປັນ​ໄປ​ໄດ້​ວ່າ​ອ່ານ​ຈາກ​ຂໍ້ຄວາມ​ພາສາ​ເຮັບເຣີ​ຕົ້ນ​ສະບັບ (ເບິ່ງ​ໃນ <char style="xt"><ref loc="2SA 24:17">2ຊມອ 24:17</ref></char> ແລະ ໃນ​ໝາຍ​ເຫດ); ສະບັບ​ມາໂຊເຣຕິກ​ບໍ່​ມີ​ຄຳ​ວ່າ ຜູ້ລ້ຽງ</char><char style="ft" closed="false">.</char></note>​ທີ່​ໄດ້​ເຮັດ​ບາບ ແລະ ໄດ້​ເຮັດ​ຜິດ. ປະຊາຊົນ​ເຫລົ່ານີ້​ເປັນ​ແຕ່​ພຽງ​ຝູງແກະ ພວກເຂົາ​ໄດ້​ເຮັດ​ຫຍັງ​ຜິດ? ຂ້າ​ແດ່​ພຣະເຈົ້າຢາເວ ພຣະເຈົ້າ​ຂອງ​ຂ້ານ້ອຍ, ຂໍ​ໃຫ້​ມື​ຂອງ​ພຣະອົງ​ລົງໂທດ​ຂ້ານ້ອຍ ແລະ ຄອບຄົວ​ຂອງ​ຂ້ານ້ອຍ​ເທົ່ານັ້ນ, ແຕ່​ຢ່າ​ປ່ອຍ​ໃຫ້​ພະຍາດ​ລະບາດ​ນີ້​ຍັງ​ຄົງ​ຢູ່​ກັບ​ປະຊາຊົນ​ຂອງ​ພຣະອົງ​ເລີຍ”.<verse eid="1CH 21:17" /></para>
  <para style="s1">ດາວິດ​ສ້າງ​ແທ່ນ​ບູຊາ</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />ຫລັງຈາກນັ້ນ ເທວະດາ​ຂອງ​ພຣະເຈົ້າຢາເວ​ຈຶ່ງ​ໄດ້​ສັ່ງ​ກາດ​ໃຫ້​ໄປ​ບອກ​ດາວິດ​ໃຫ້​ຂຶ້ນ​ໄປ​ສ້າງ​ແທ່ນບູຊາ​ແທ່ນໜຶ່ງ​ຖວາຍ​ແກ່​ພຣະເຈົ້າຢາເວ​ທີ່​ລານ​ຟາດເຂົ້າ​ຂອງ​ອາໂຣນາ​ຊາວ​ເຢບຸດ. <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />ດັ່ງນັ້ນ ດາວິດ​ຈຶ່ງ​ໄປ​ປະຕິບັດ​ຕາມ​ຖ້ອຍຄໍາ​ທີ່​ກາດ​ໄດ້​ກ່າວ​ໃນ​ນາມຊື່​ຂອງ​ພຣະເຈົ້າຢາເວ.<verse eid="1CH 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20" />ໃນຂະນະທີ່ ອາໂຣນາ​ກຳລັງ​ຟາດ​ເຂົ້າຫວີດ​ຢູ່, ລາວ​ກໍ​ຫລຽວ​ເຫັນ​ເທວະດາ; ລູກຊາຍ​ສີ່​ຄົນ​ຂອງ​ລາວ​ທີ່​ຢູ່​ກັບ​ລາວ​ກໍ​ພາກັນ​ແລ່ນ​ໜີ​ໄປ​ລີ້. <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />ຈາກນັ້ນ ເມື່ອ​ອາໂຣນາ​ເຫັນ​ດາວິດ​ຍ່າງ​ມາ​ຫາ, ລາວຈຶ່ງ​ອອກ​ຈາກ​ລານ​ຟາດເຂົ້າ ແລະ ກົ້ມ​ກາບ​ລົງ​ຕໍ່ໜ້າ​ເພິ່ນ.<verse eid="1CH 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22" />ດາວິດ​ເວົ້າ​ກັບ​ລາວ​ວ່າ, “ເຮົາ​ຂໍ​ຊື້​ລານ​ຟາດເຂົ້າ​ຂອງ​ເຈົ້າ ເພື່ອ​ເຮົາ​ຈະ​ສ້າງ​ແທ່ນບູຊາ​ຖວາຍ​ແກ່​ພຣະເຈົ້າຢາເວ, ແລ້ວ​ພະຍາດ​ລະບາດ​ໃນ​ປະຊາຊົນ​ຈະ​ຢຸດ​ລົງ”. ຈົ່ງ​ຂາຍ​ລານ​ຟາດ​ເຂົ້າ​ໃຫ້​ເຮົາ​ໃນ​ລາຄາ​ເຕັມ.<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />ອາໂຣນາ​ເວົ້າ​ກັບ​ດາວິດ​ວ່າ, “ຂ້າແດ່​ກະສັດ ຈົ່ງ​ເອົາ​ໄປ! ຈະ​ເອົາ​ໄປ​ເຮັດ​ອັນໃດ​ກໍ​ໄດ້​ຕາມ​ທີ່​ທ່ານ​ພໍໃຈ. ຂ້ານ້ອຍ​ຈະ​ເອົາ​ງົວ​ເພື່ອ​ເປັນ​ເຄື່ອງເຜົາ​ຖວາຍບູຊາ​ດ້ວຍ, ໄມ້​ຟືນ​ທີ່​ລານ​ສາມາດ​ໃຊ້​ເປັນ​ຟືນ, ແລະ ເອົາ​ເຂົ້າຫວີດ​ໃຊ້​ເປັນ​ເຄື່ອງຖວາຍ​ພືດ​ຜົນ​ເປັນ​ເມັດ. ຂ້ານ້ອຍ​ຈະ​ເອົາ​ສິ່ງ​ທັງໝົດ​ນີ້​ໃຫ້​ທ່ານ”.<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />ແຕ່​ກະສັດ​ດາວິດ​ຕອບ​ອາໂຣນາ​ວ່າ, “ບໍ່, ເຮົາ​ຂໍ​ຢືນຢັນ​ທີ່​ຈະ​ຈ່າຍ​ໃຫ້​ເຈົ້າ​ເຕັມ​ລາຄາ. ເຮົາ​ຈະ​ບໍ່​ເອົາ​ສິ່ງໃດ​ທີ່​ເປັນ​ຂອງ​ເຈົ້າ​ໄປ​ໃຫ້​ແກ່​ພຣະເຈົ້າຢາເວ ຫລື ຖວາຍ​ເຄື່ອງເຜົາ​ບູຊາ​ໂດຍ​ເຮົາ​ບໍ່​ໄດ້​ຊື້​ອັນໃດ​ເລີຍ”.<verse eid="1CH 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25" />ດາວິດ​ຈຶ່ງ​ຈ່າຍ​ຄຳ​ໜັກ 600 ເຊເຂວ<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="ft" closed="false">ຫລື 6,9 ກິໂລກຣາມ</char></note> ໃຫ້​ແກ່​ອາໂຣນາ​ເປັນ​ຄ່າ​ທີ່ດິນ. <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />ດາວິດ​ໄດ້​ສ້າງ​ແທ່ນບູຊາ​ແທ່ນ​ໜຶ່ງ​ຖວາຍ​ແກ່​ພຣະເຈົ້າຢາເວ​ຢູ່​ທີ່​ນັ້ນ ແລະ ຖວາຍ​ເຄື່ອງ​ເຜົາບູຊາ ແລະ ຖວາຍບູຊາ​ເພື່ອ​ຄວາມ​ສາມັກຄີທຳ. ດາວິດ​ໄດ້​ຂໍ​ຕໍ່​ພຣະເຈົ້າຢາເວ ແລະ ພຣະເຈົ້າຢາເວ​ໄດ້​ຕອບ​ເພິ່ນ​ໂດຍ​ສົ່ງ​ໄຟ​ລົງ​ມາ​ຈາກ​ສະຫວັນ​ເຜົາ​ເຄື່ອງຖວາຍ​ທີ່​ຢູ່​ເທິງ​ແທ່ນບູຊາ​ນັ້ນ.<verse eid="1CH 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27" />ແລ້ວ​ພຣະເຈົ້າຢາເວ​ໄດ້​ສັ່ງ​ເທວະດາ​ໃຫ້​ເອົາ​ດາບ​ມ້ຽນ​ໄວ້​ໃນ​ຝັກ. <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />ໃນ​ເວລາ​ນັ້ນ, ດາວິດ​ເຫັນ​ວ່າ​ພຣະເຈົ້າຢາເວ​ໄດ້​ຕອບ​ເພິ່ນ​ທີ່​ລານ​ຟາດເຂົ້າ​ຂອງ​ອາໂຣນາ​ຊາວ​ເຢບຸດ, ເຊິ່ງ​ເພິ່ນ​ໄດ້​ຖວາຍ​ເຄື່ອງບູຊາ​ຢູ່​ທີ່​ນັ້ນ <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />ຫໍເຕັນ​ສັກສິດ​ຂອງ​ພຣະເຈົ້າຢາເວ, ທີ່​ໂມເຊ​ໄດ້​ສ້າງ​ຂຶ້ນ​ໃນ​ຖິ່ນແຫ້ງແລ້ງກັນດານ, ແລະ ແທ່ນບູຊາ​ທີ່​ໃຊ້​ເພື່ອ​ຖວາຍ​ເຄື່ອງເຜົາບູຊາ ກໍ​ຍັງ​ຢູ່​ໃນ​ສະຖານບູຊາ​ເທິງ​ທີ່​ສູງ​ໃນ​ກີເບໂອນ. <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />ແຕ່​ດາວິດ​ບໍ່​ສາມາດ​ໄປ​ຖາມ​ພຣະເຈົ້າ​ຢູ່​ທີ່​ນັ້ນ​ໄດ້, ເພາະ​ເພິ່ນ​ຢ້ານ​ດາບ​ຂອງ​ເທວະດາ​ຂອງ​ພຣະເຈົ້າຢາເວ.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />ຈາກນັ້ນ ດາວິດ​ເວົ້າ​ວ່າ, “ວິຫານ​ຂອງ​ພຣະເຈົ້າຢາເວ ພຣະເຈົ້າ, ແລະ ແທ່ນບູຊາ​ທີ່​ອິດສະຣາເອນ​ໃຊ້​ເພື່ອ​ເຜົາ​ເຄື່ອງບູຊາ​ຈະ​ຕ້ອງ​ຢູ່​ທີ່ນີ້”.<verse eid="1CH 22:1" /></para>
  <para style="s1">ການ​ກະກຽມ​ສຳລັບ​ການ​ສ້າງ​ວິຫານ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />ດັ່ງນັ້ນ ດາວິດ​ໄດ້​ສັ່ງ​ໃຫ້​ຊາວ​ຕ່າງດ້າວ​ທີ່​ອາໄສ​ໃນ​ອິດສະຣາເອນ​ມາ​ເຕົ້າໂຮມ​ກັນ, ແລະ ເພິ່ນ​ໄດ້​ແຕ່ງຕັ້ງ​ບາງຄົນ​ໃນ​ພວກເຂົາ​ໃຫ້​ເປັນ​ຊ່າງສະກັດຫີນ ຕຽມ​ຫີນ​ສຳລັບ​ກໍ່ສ້າງ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ. <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />ດາວິດ​ໄດ້​ຈັດຕຽມ​ເຫຼັກ​ເປັນ​ຈຳນວນ​ຫລາຍ ເພື່ອ​ເຮັດ​ຕະປູ​ໃຊ້​ຈັບ​ບານພັບ ແລະ ປະຕູ​ທາງເຂົ້າ ແລະ ທອງສຳຣິດ​ເປັນ​ຈຳນວນ​ຫລາຍ​ຈົນ​ເກີນກວ່າ​ທີ່​ຈະ​ຊັ່ງ​ນໍ້າໜັກ​ໄດ້. <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />ເພິ່ນ​ຕຽມ​ໄມ້ສີດາ​ເປັນ​ຈຳນວນ​ຫລາຍ​ຈົນ​ເກີນກວ່າ​ທີ່​ຈະ​ນັບ​ໄດ້, ເຊິ່ງ​ຊາວ​ຊີໂດນ​ກັບ​ຊາວ​ຕີເຣ​ໄດ້​ນຳ​ມາ​ມອບ​ໃຫ້​ດາວິດ.<verse eid="1CH 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5" />ດາວິດ​ເວົ້າ​ວ່າ, “ໂຊໂລໂມນ​ລູກຊາຍ​ຂອງ​ເຮົາ​ຍັງ​ໜຸ່ມນ້ອຍ​ຢູ່ ແລະ ບໍ່ມີ​ປະສົບການ, ວິຫານ​ທີ່​ຈະ​ສ້າງ​ຂຶ້ນ​ສຳລັບ​ພຣະເຈົ້າຢາເວ​ຄວນ​ຈະ​ງົດງາມ​ທີ່ສຸດ, ມີ​ຊື່ສຽງ​ຊ່າລື​ກັນ ແລະ ສະຫງ່າງາມ​ໃນ​ສາຍຕາ​ຂອງ​ຊົນຊາດ​ທັງໝົດ. ເພາະສະນັ້ນ​ເຮົາ​ຈະ​ຈັດຕຽມ​ສິ່ງ​ຕ່າງໆ​ໄວ້​ໃຫ້​ລາວ”. ດັ່ງນັ້ນ ດາວິດ​ຈຶ່ງ​ຈັດຫາ​ວັດສະດຸ​ຕຽມ​ໄວ້​ຢ່າງ​ຫລວງຫລາຍ​ກ່ອນ​ເພິ່ນ​ຕາຍ​ໄປ.<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />ແລ້ວ​ດາວິດ​ໄດ້​ເອີ້ນ​ໂຊໂລໂມນ​ລູກຊາຍ​ຂອງ​ເພິ່ນ​ມາ ແລະ ສັ່ງ​ໃຫ້​ສ້າງ​ວິຫານ​ສຳລັບ​ພຣະເຈົ້າຢາເວ ພຣະເຈົ້າ​ແຫ່ງ​ອິດສະຣາເອນ. <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />ດາວິດ​ເວົ້າ​ກັບ​ໂຊໂລໂມນ​ວ່າ: “ລູກ​ເອີຍ, ພໍ່​ຕັ້ງໃຈ​ທີ່​ຈະ​ສ້າງ​ວິຫານ​ເພື່ອ​ນາມຊື່​ຂອງ​ພຣະເຈົ້າຢາເວ ພຣະເຈົ້າ​ຂອງ​ພໍ່. <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />ແຕ່​ຖ້ອຍຄຳ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ມາ​ເຖິງ​ພໍ່​ວ່າ: ‘ເຈົ້າ​ໄດ້​ຂ້າ​ຄົນ​ຢ່າງ​ຫລວງຫລາຍ ແລະ ໄດ້​ຕໍ່ສູ້​ໃນ​ສະໜາມຮົບ​ຫລາຍ​ເທື່ອ. ເຈົ້າ​ໄດ້​ເຮັດ​ໃຫ້​ເລືອດ​ໄຫລ​ນອງ​ຢ່າງ​ຫລວງຫລາຍ​ເທິງ​ແຜ່ນດິນ​ໃນ​ສາຍ​ຕາ​ຂອງ​ເຮົາ ສະນັ້ນ ເຈົ້າ​ຈະ​ບໍ່​ໄດ້​ສ້າງ​ວິຫານ​ສຳລັບ​ນາມຊື່​ຂອງ​ເຮົາ. <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />ແຕ່​ຈະ​ມີ​ລູກ​ຄົນ​ໜຶ່ງ​ຂອງ​ເຈົ້າ​ເປັນ​ຄົນ​ແຫ່ງ​ສັນຕິສຸກ ແລະ ເຮົາ​ຈະ​ໃຫ້​ລາວ​ພັກຜ່ອນ​ຈາກ​ສັດຕູ​ທັງໝົດ​ທີ່​ຢູ່​ອ້ອມຮອບ​ທຸກ​ດ້ານ. ຊື່​ຂອງ​ລາວ​ແມ່ນ ໂຊໂລໂມນ,<note caller="+" style="f"><char style="fr" closed="false">22:9 </char><char style="ft" closed="false">ຄຳ​ວ່າ ໂຊໂລໂມນ ມີ​ສຽງ​ຄ້າຍ ແລະ ອາດ​ມາ​ຈາກ​ຄຳ​ພາສາ​ເຮັບເຣີ​ທີ່​ມີ​ຄວາມຫມາຍ​ວ່າ ສັນຕິສຸກ</char></note> ແລະ ເຮົາ​ຈະ​ໃຫ້​ອິດສະຣາເອນ​ມີ​ຄວາມ​ສະຫງົບສຸກ​ໃນ​ໄລຍະ​ການ​ປົກຄອງ​ຂອງ​ລາວ. <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />ລາວ​ຈະ​ເປັນ​ຜູ້​ທີ່​ຈະ​ສ້າງ​ວິຫານ​ເພື່ອ​ນາມ​ຂອງ​ເຮົາ. ລາວ​ຈະ​ເປັນ​ລູກຊາຍ​ຂອງ​ເຮົາ ແລະ ເຮົາ​ຈະ​ເປັນ​ພໍ່​ຂອງ​ລາວ. ແລະ ເຮົາ​ຈະ​ຕັ້ງ​ບັນລັງ​ແຫ່ງ​ອານາຈັກ​ຂອງ​ລາວ​ປົກຄອງ​ອິດສະຣາເອນ​ຕະຫລອດໄປ’.<verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />“ບັດນີ້ ລູກ​ເອີຍ, ຂໍ​ໃຫ້​ພຣະເຈົ້າຢາເວ​ສະຖິດ​ຢູ່​ກັບ​ເຈົ້າ ແລະ ຂໍ​ໃຫ້​ເຈົ້າ​ພົບ​ຄວາມ​ສຳເລັດ​ໃນ​ການສ້າງ​ວິຫານ​ສຳລັບ​ພຣະເຈົ້າຢາເວ ພຣະເຈົ້າ​ຂອງ​ເຈົ້າ​ຕາມ​ທີ່​ພຣະອົງ​ໄດ້​ກ່າວ​ໄວ້. <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />ຂໍ​ພຣະເຈົ້າຢາເວ ປະທານ​ການ​ຕັດສິນ​ອັນ​ຮອບຄອບ ແລະ ຄວາມ​ເຂົ້າໃຈ​ແກ່​ເຈົ້າ ເມື່ອ​ພຣະອົງ​ຕັ້ງ​ເຈົ້າ​ໃຫ້​ປົກຄອງ​ອິດສະຣາເອນ, ເພື່ອ​ເຈົ້າ​ຈະ​ຮັກສາ​ກົດບັນຍັດ​ຂອງ​ພຣະເຈົ້າຢາເວ ພຣະເຈົ້າ​ຂອງ​ເຈົ້າ. <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />ຖ້າ​ເຈົ້າ​ເອົາໃຈໃສ່​ໃນ​ການ​ຖື​ຮັກສາ​ຂໍ້​ຄໍາສັ່ງ​ຕ່າງໆ ແລະ ກົດບັນຍັດ​ທີ່​ພຣະເຈົ້າຢາເວ​ໄດ້​ມອບ​ໃຫ້​ໂມເຊ​ສຳລັບ​ອິດສະຣາເອນ​ນັ້ນ ແລ້ວ​ເຈົ້າ​ກໍ​ຈະ​ພົບ​ຄວາມ​ສຳ​ເລັດ ຈົ່ງ​ເຂັ້ມແຂງ ແລະ ກ້າຫານ. ຢ່າ​ຢ້ານ ຫລື ທໍ້ຖອຍ.<verse eid="1CH 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14" />“ພໍ່​ໄດ້​ໃຊ້​ຄວາມ​ພະຍາຍາມ​ຫລາຍ​ໃນ​ການ​ຈັດຕຽມ​ສໍາລັບ​ວິຫານ​ຂອງ​ພຣະເຈົ້າຢາເວ​ຄື ຄໍາ​ສາມພັນ​ສີ່ຮ້ອຍ​ຕະລັນຕົນ,<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ 100.000 ຕາລັນຕົນ</char></note> ເງິນ​ສາມສິບສີ່​ພັນ​ຕະລັນຕົນ,<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ 1.000.000 ຕາລັນຕົນ</char></note> ເຫລັກ ແລະ ທອງສຳຣິດ​ຈຳນວນ​ຫລວງຫລາຍ​ເກີນ​ກວ່າ​ຈະ​ຊັ່ງ​ໄດ້, ແລະ ຍັງ​ມີ​ໄມ້ ແລະ ຫີນ. ເຈົ້າ​ອາດ​ຈະ​ໄດ້​ຫາ​ຕື່ມ​ອີກ. <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />ເຈົ້າ​ມີ​ຄົນ​ເຮັດ​ວຽກ​ຢ່າງ​ຫລວງຫລາຍ​ຄື ຊ່າງ​ສະກັດຫີນ, ຊ່າງ​ກໍ່ ແລະ ຊ່າງ​ໄມ້, ຊ່າງ​ສີມື​ທຸກ​ຊະນິດ​ເຊັ່ນ: <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />ຊ່າງ​ຄຳ, ຊ່າງ​ເງິນ, ຊ່າງ​ທອງສຳຣິດ, ຊ່າງ​ເຫລັກ ແລະ ຊ່າງ​ແກະສະຫຼັກ​ຫລາຍ​ເກີນ​ກວ່າ​ທີ່​ຈະ​ນັບ​ໄດ້. ຈົ່ງ​ເລີ່ມ​ເຮັດວຽກ, ແລະ ຂໍ​ພຣະເຈົ້າຢາເວ​ສະຖິດ​ຢູ່​ນຳ​ລູກ​ເທີນ”.<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />ຈາກນັ້ນ ດາວິດ​ໄດ້​ສັ່ງ​ບັນດາ​ຜູ້ນຳ​ອິດສະຣາເອນ​ທັງໝົດ​ໃຫ້​ຊ່ວຍເຫລືອ​ໂຊໂລໂມນ​ລູກຊາຍ​ຂອງ​ເພິ່ນ. <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />ເພິ່ນ​ກ່າວ​ແກ່​ພວກເຂົາ​ວ່າ, “ພຣະເຈົ້າຢາເວ ພຣະເຈົ້າ​ຂອງ​ພວກເຈົ້າ​ໄດ້​ສະຖິດ​ຢູ່​ນຳ​ພວກເຈົ້າ​ບໍ່ແມ່ນ​ບໍ? ແລະ ພຣະອົງ​ໃຫ້​ພວກເຈົ້າ​ໄດ້​ພັກຜ່ອນ​ທຸກ​ດ້ານ​ບໍ່ແມ່ນ​ບໍ? ເພາະ​ພຣະອົງ​ໄດ້​ມອບ​ດິນແດນ​ຂອງ​ປະຊາຊົນ​ທັງໝົດ​ໄວ້​ໃນ​ມື​ຂອງ​ເຮົາ, ແລະ ດິນແດນ​ນີ້​ຢູ່​ໃຕ້​ອຳນາດ​ຂອງ​ພຣະເຈົ້າຢາເວ ແລະ ຢູ່​ໃຕ້​ອຳນາດ​ຂອງ​ປະຊາຊົນ​ຂອງ​ພຣະອົງ. <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />ບັດນີ້​ຈົ່ງ​ອຸທິດ​ຈິດໃຈ ແລະ ຈິດວິນຍານ​ເພື່ອ​ສະແຫວງ​ຫາ​ພຣະເຈົ້າຢາເວ ພຣະເຈົ້າ​ຂອງ​ພວກເຈົ້າ. ຈົ່ງ​ເລີ່ມ​ສ້າງ​ສະຖານທີ່​ສັກສິດ​ຂອງ​ພຣະເຈົ້າຢາເວ ພຣະເຈົ້າ​ຂອງ​ພວກເຈົ້າ ເພື່ອ​ພວກເຈົ້າ​ຈະ​ໄດ້​ນຳ​ເອົາ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າຢາເວ ແລະ ເຄື່ອງໃຊ້​ຕ່າງໆ​ອັນ​ສັກສິດ​ຂອງ​ພຣະເຈົ້າ​ເຂົ້າ​ໄປ​ໃນ​ວິຫານ ທີ່​ຈະ​ໄດ້​ສ້າງ​ຂຶ້ນ​ສໍາລັບ​ນາມຊື່​ຂອງ​ພຣະເຈົ້າຢາເວ”.<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s1">ຄົນ​ເລວີ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />ເມື່ອ​ດາວິດ​ໄດ້​ແກ່ຊະຣາ​ຫລາຍ​ແລ້ວ, ເພິ່ນ​ແຕ່ງຕັ້ງ​ໂຊໂລໂມນ​ລູກຊາຍ​ຂອງ​ເພິ່ນ​ຂຶ້ນ​ເປັນ​ກະສັດ​ປົກຄອງ​ອິດສະຣາເອນ.<verse eid="1CH 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2" />ດາວິດ​ເອີ້ນ​ຜູ້ນຳ​ທັງໝົດ​ຂອງ​ອິດສະຣາເອນ​ໃຫ້​ມາ​ເຕົ້າໂຮມ​ກັນ, ລວມ​ທັງ​ພວກ​ປະໂລຫິດ ແລະ ພວກ​ເລວີ. <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />ມີ​ການ​ນັບ​ຈຳນວນ​ຄົນ​ເລວີ​ທີ່​ມີ​ອາຍຸ​ສາມສິບ​ປີ​ຂຶ້ນ​ໄປ, ລວມ​ທັງໝົດ​ມີ​ສາມສິບແປດພັນ​ຄົນ. <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />ດາວິດ​ເວົ້າ​ວ່າ, “ໃຫ້​ຊາວສີ່​ພັນ​ຄົນ​ຮັບຜິດຊອບ​ໜ້າທີ່​ວຽກງານ​ໃນ​ວິຫານ​ຂອງ​ອົງພຣະເຈົ້າ​ຢາເວ ແລະ ໃຫ້​ຫົກ​ພັນ​ຄົນ​ເປັນ​ຂ້າລາຊະການ ແລະ ເປັນ​ຜູ້​ພິພາກສາ. <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />ໃຫ້​ສີ່​ພັນ​ຄົນ​ເປັນ​ຜູ້​ເຝົ້າ​ຍາມ​ປະຕູ​ວິຫານ ແລະ ໃຫ້​ອີກ​ສີ່​ພັນ​ຄົນ​ສັນລະເສີນ​ພຣະເຈົ້າຢາເວ​ດ້ວຍ​ເຄື່ອງ​ດົນຕີ​ຕ່າງໆ​ທີ່​ເຮົາ​ໄດ້​ຈັດຕຽມ​ໄວ້​ສໍາລັບ​ຈຸດປະສົງ​ນັ້ນ”.<verse eid="1CH 23:5" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="6" style="v" sid="1CH 23:6" />ດາວິດ​ໄດ້​ແບ່ງ​ຄົນ​ເລວີ​ເປັນ​ສາມ​ໝວດ​ຕາມ​ຊື່​ລູກຊາຍ​ຂອງ​ເລວີ​ມີ​ດັ່ງນີ້: ເກໂຊນ, ໂກຮາດ ແລະ ເມຣາຣິ.<verse eid="1CH 23:6" /></para>
  <para style="s1">ຕະກຸນ​ເກໂຊນ</para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 23:7" />ຈາກ​ຕະກຸນ​ເກໂຊນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 23:7">ລາດານ ແລະ ຊີເມອີ.<verse eid="1CH 23:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8" />ລູກຊາຍ​ຂອງ​ລາດານ​ມີ:</para>
  <para style="li2" vid="1CH 23:8">ຄົນ​ທີ​ໜຶ່ງ​ແມ່ນ​ເຢຮີເອນ, ເຊທາມ ແລະ ໂຢເອນ, ລວມ​ທັງໝົດ​ມີ​ສາມ​ຄົນ.<verse eid="1CH 23:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9" />ລູກຊາຍ​ຂອງ​ຊີເມອີ​ມີ:</para>
  <para style="li2" vid="1CH 23:9">ເຊໂລໂມດ, ຮາຊີເອນ ແລະ ຮາຣານ ລວມ​ທັງໝົດ​ມີ​ສາມ​ຄົນ.</para>
  <para style="li2" vid="1CH 23:9">ຄົນ​ເຫລົ່ານີ້​ເປັນ​ຫົວໜ້າ​ຄອບຄົວ​ຂອງ​ລາດານ.<verse eid="1CH 23:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10" />ແລະ ລູກຊາຍ​ຂອງ​ຊີເມອີ​ມີ:</para>
  <para style="li2" vid="1CH 23:10">ຢາຮາດ, ຊີຊາ<note caller="+" style="f"><char style="fr" closed="false">23:10 </char><char style="ft" closed="false">ສຳເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ສີນາ ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="1CH 23:11"><ref loc="1CH 23:11">11</ref></char></char></note> ເຢອຸດ ແລະ ເບຣິຢາ.</para>
  <para style="li2" vid="1CH 23:10">ຄົນ​ເຫລົ່ານີ້​ເປັນ​ລູກຊາຍ​ຂອງ​ຊີເມອີ ລວມ​ທັງໝົດ​ສີ່​ຄົນ.<verse eid="1CH 23:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11" />ຄົນ​ທີ​ໜຶ່ງ​ແມ່ນ​ຢາຮາດ, ຄົນ​ທີ​ສອງ​ແມ່ນ​ຊີຊາ, ແຕ່​ເຢອຸດ ແລະ ເບຣິຢາ​ບໍ່ມີ​ລູກຊາຍ​ຫລາຍ​ຄົນ; ດັ່ງນັ້ນ ພວກເຂົາ​ຈຶ່ງ​ໄດ້​ນັບ​ເຂົ້າ​ເປັນ​ຄອບຄົວ​ດຽວ​ກັນ ມີ​ໜ້າທີ່​ຮັບຜິດຊອບ​ອັນດຽວ​ກັນ.<verse eid="1CH 23:11" /></para>
  <para style="s1">ຕະກຸນ​ໂກຮາດ</para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 23:12" />ລູກຊາຍ​ຂອງ​ໂກຮາດ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 23:12">ອຳຣາມ, ອີຊະຮາດ, ເຮັບໂຣນ ແລະ ອຸດຊີເອນ. ລວມ​ທັງໝົດ​ມີ​ສີ່​ຄົນ<verse eid="1CH 23:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13" />ລູກຊາຍ​ຂອງ​ອຳຣາມ​ມີ:</para>
  <para style="li2" vid="1CH 23:13">ອາໂຣນ ແລະ ໂມເຊ.</para>
  <para style="li2" vid="1CH 23:13">ອາໂຣນ ແລະ ເຊື້ອ​ສາຍ​ຂອງ​ລາວ​ໄດ້​ຖືກ​ແຍກ​ອອກ​ຢູ່​ຕ່າງຫາກ ເພື່ອ​ເບິ່ງແຍງ​ສິ່ງທີ່​ສັກສິດ​ທີ່ສຸດ, ເພື່ອ​ຖວາຍ​ເຄື່ອງບູຊາ​ແກ່​ພຣະເຈົ້າຢາເວ, ເພື່ອ​ຮັບໃຊ້​ຢູ່​ຕໍ່ໜ້າ​ພຣະອົງ ແລະ ເພື່ອ​ອວຍພອນ​ປະຊາຊົນ​ໃນ​ນາມ​ຂອງ​ພຣະອົງ​ຕະຫລອດໄປ. <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />ລູກຊາຍ​ຂອງ​ໂມເຊ​ຄົນ​ຂອງ​ພຣະເຈົ້າ​ນັ້ນ ນັບ​ເຂົ້າ​ກັບ​ເຜົ່າ​ເລວີ.<verse eid="1CH 23:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15" />ລູກຊາຍ​ຂອງ​ໂມເຊ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 23:15">ເກໂຊມ ແລະ ເອລີເອເຊ.<verse eid="1CH 23:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16" />ເຊື້ອສາຍ​ຂອງ​ເກໂຊມ​ມີ:</para>
  <para style="li2" vid="1CH 23:16">ຄົນ​ທີ​ໜຶ່ງ​ແມ່ນ​ເຊບູເອນ.<verse eid="1CH 23:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17" />ເຊື້ອສາຍ​ຂອງ​ເອລີເອເຊ​ມີ:</para>
  <para style="li2" vid="1CH 23:17">ຄົນ​ທີ​ໜຶ່ງ​ແມ່ນ​ເຣຮາບີຢາ.</para>
  <para style="li2" vid="1CH 23:17">ເອລີເອເຊ​ມີ​ລູກຊາຍ​ຄົນ​ດຽວ ແລະ ບໍ່​ມີ​ລູກຊາຍ​ຄົນ​ອື່ນ​ອີກ. ແຕ່​ພວກ​ລູກຊາຍ​ຂອງ​ເຣຮາບີຢາ​ມີ​ລູກ​ຢ່າງ​ຫລວງຫລາຍ.<verse eid="1CH 23:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18" />ລູກຊາຍ​ຂອງ​ອີຊະຮາດ​ມີ:</para>
  <para style="li2" vid="1CH 23:18">ຄົນ​ທີ​ໜຶ່ງ​ແມ່ນ​ເຊໂລມິດ.<verse eid="1CH 23:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19" />ລູກຊາຍ​ຂອງ​ເຮັບໂຣນ​ມີ:</para>
  <para style="li2" vid="1CH 23:19">ຄົນ​ທີ​ໜຶ່ງ​ແມ່ນ​ເຢຣີຢາ, ຄົນ​ທີ​ສອງ​ແມ່ນ​ອາມາຣີຢາ,</para>
  <para style="li2" vid="1CH 23:19">ຄົນ​ທີ​ສາມ​ແມ່ນ​ເຢຮາຊີເອນ ແລະ ຄົນ​ທີ​ສີ່​ແມ່ນ​ເຢກາເມອາມ.<verse eid="1CH 23:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20" />ລູກຊາຍ​ຂອງ​ອຸດຊີເອນ​ມີ:</para>
  <para style="li2" vid="1CH 23:20">ຄົນ​ທີ​ໜຶ່ງ​ແມ່ນ​ມີກາ ແລະ ຄົນ​ທີ​ສອງ​ແມ່ນ​ອິດຊີຢາ.<verse eid="1CH 23:20" /></para>
  <para style="s1">ຕະກຸນ​ເມຣາຣິ</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 23:21" />ລູກຊາຍ​ຂອງ​ເມຣາຣິ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 23:21">ມາຮະລີ ແລະ ມູຊີ.</para>
  <para style="li1" vid="1CH 23:21">ລູກຊາຍ​ຂອງ​ມາຮະລີ​ມີ:</para>
  <para style="li2" vid="1CH 23:21">ເອເລອາຊາ ແລະ ກີເຊ.<verse eid="1CH 23:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22" />(ເອເລອາຊາ​ໄດ້​ຕາຍ​ໄປ​ໂດຍ​ບໍ່ມີ​ລູກຊາຍ, ລາວ​ມີ​ແຕ່​ບັນດາ​ລູກສາວ. ບັນດາ​ລູກຊາຍ​ຂອງ​ກີເຊ​ກໍ​ໄດ້​ແຕ່ງງານ​ກັບ​ພີ່ນ້ອງ​ຂອງ​ພວກເຂົາ).<verse eid="1CH 23:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23" />ລູກຊາຍ​ຂອງ​ມູຊີ​ມີ:</para>
  <para style="li2" vid="1CH 23:23">ມາຮະລີ, ເອເດ ແລະ ເຢເຣໂມດ ລວມ​ທັງໝົດ​ມີ​ສາມ​ຄົນ.<verse eid="1CH 23:23" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="24" style="v" sid="1CH 23:24" />ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ເຊື້ອສາຍ​ຂອງ​ເລວີ​ຕາມ​ຄອບຄົວ​ທີ່​ໄດ້​ນັບ​ຂຶ້ນ​ທະບຽນ​ໄວ້​ຕາມ​ຊື່​ຂອງ​ຫົວໜ້າ​ຄອບຄົວ ຊາຍ​ຊາວ​ເລວີ​ທີ່​ມີ​ອາຍຸ 20 ປີ ຂຶ້ນ​ໄປ​ທີ່​ກ່າວ​ມາ​ນີ້ ທຸກຄົນ​ມີ​ໜ້າທີ່​ປະຕິບັດ​ງານ​ໃນ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ. <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />ເພາະ​ດາວິດ​ໄດ້​ເວົ້າ​ວ່າ, “ຕັ້ງແຕ່ ພຣະເຈົ້າຢາເວ ພຣະເຈົ້າ​ແຫ່ງ​ອິດສະຣາເອນ​ໄດ້​ໃຫ້​ປະຊາຊົນ​ໄດ້​ພັກຜ່ອນ ແລະ ພຣະອົງ​ສະຖິດ​ຢູ່​ໃນ​ເຢຣູຊາເລັມ​ຕະຫລອດ​ໄປ. <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />ຄົນ​ເລວີ​ຈຶ່ງ​ບໍ່​ຈຳເປັນ​ຕ້ອງ​ຫາມ​ຫໍເຕັນ ແລະ ເຄື່ອງໃຊ້​ໃນ​ການ​ຮັບໃຊ້​ອີກ​ຕໍ່ໄປ”. <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />ຕາມ​ຄໍາ​ແນະນໍາ​ສຸດທ້າຍ​ຂອງ​ດາວິດ, ໃຫ້​ນັບ​ຈຳນວນ​ຄົນ​ເລວີ​ທີ່​ອາຍຸ 20 ປີ​ຂຶ້ນ​ໄປ ຫລື ມີ​ອາຍຸ​ຫລາຍກວ່າ​ນັ້ນ​ເຂົ້າ​ໃນ​ການ​ຮັບໃຊ້.<verse eid="1CH 23:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28" />ໜ້າທີ່​ຂອງ​ຄົນ​ເລວີ​ຄື​ຊ່ວຍເຫລືອ​ເຊື້ອສາຍ​ຂອງ​ອາໂຣນ​ໃນ​ການ​ຮັບໃຊ້​ໃນ​ວິຫານ​ຂອງ​ພຣະເຈົ້າຢາເວ​ຄື: ເພື່ອ​ເບິ່ງແຍງ​ເດີ່ນ​ວິຫານ, ຫ້ອງ​ຕ່າງໆ​ທີ່​ຢູ່​ດ້ານ​ຂ້າງ, ຊໍາລະ​ສິ່ງ​ສັກສິດ​ທຸກຢ່າງ ແລະ ປະຕິບັດ​ໜ້າທີ່​ອື່ນໆ​ໃນ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ. <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />ພວກເຂົາ​ຮັບຜິດຊອບ​ການ​ຈັດ​ເຂົ້າຈີ່​ຂຶ້ນ​ເທິງ​ໂຕະ, ແປ້ງ​ພິເສດ​ສຳລັບ​ການ​ຖວາຍບູຊາ​ພືດຜົນ​ທີ່​ເປັນ​ເມັດ, ເຂົ້າຈີ່​ບາງ​ທີ່​ບໍ່ມີ​ເຊື້ອແປ້ງ, ເຄື່ອງ​ປີ້ງ​ບູຊາ ແລະ ແປ້ງເຂົ້າ​ປະສົມ​ນໍ້າມັນ, ແລະ ວັດແທກ​ປະລິມານ ແລະ ຂະໜາດ​ຂອງ​ເຄື່ອງ​ຖວາຍ​ທັງໝົດ. <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />ທຸກໆ​ເຊົ້າ ແລະ ທຸກໆ​ແລງ​ພວກເຂົາ​ຈະ​ຢືນ​ຮ້ອງເພງ​ໂມທະນາ​ຂອບຄຸນ ແລະ ສັນລະເສີນ​ພຣະເຈົ້າຢາເວ. <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />ແລະ ເມື່ອໃດ​ທີ່​ມີ​ການ​ເຜົາ​ເຄື່ອງຖວາຍບູຊາ​ແກ່​ພຣະເຈົ້າຢາເວ​ໃນ​ວັນຊະບາໂຕ, ໃນ​ວັນ​ສະຫລອງ​ເດືອນ​ອອກ​ໃໝ່ ແລະ ຕາມ​ເທດສະການ​ທີ່​ໄດ້​ກຳນົດ. ພວກເຂົາ​ຈະ​ຕ້ອງ​ຮັບໃຊ້​ຢູ່​ຕໍ່ໜ້າ​ພຣະເຈົ້າຢາເວ​ເປັນ​ປະຈໍາ​ຕາມ​ຈຳນວນ​ຄົນ​ທີ່​ເໝາະສົມ ແລະ ຕາມ​ວິທີ​ທີ່​ໄດ້​ກຳນົດ​ໄວ້​ສໍາລັບ​ພວກເຂົາ.<verse eid="1CH 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32" />ດັ່ງນັ້ນ ຄົນ​ເລວີ​ຈຶ່ງ​ປະຕິບັດ​ໜ້າທີ່​ຮັບຜິດຊອບ​ຂອງ​ພວກເຂົາ​ໃນ​ຫໍເຕັນ​ບ່ອນ​ຊຸມນຸມ, ແລະ ສະຖານ​ທີ່​ສັກສິດ, ເພື່ອ​ຮັບໃຊ້​ໃນ​ວິຫານ​ຂອງ​ພຣະເຈົ້າຢາເວ ພາຍໃຕ້​ການ​ຄຳສັ່ງ​ຂອງ​ພີ່ນ້ອງ​ຂອງ​ພວກເຂົາ​ທີ່​ສືບ​ເຊື້ອສາຍ​ມາ​ຈາກ​ອາໂຣນ.<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s1">ການ​ແບ່ງ​ໝວດ​ຂອງ​ປະໂລຫິດ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />ເຊື້ອສາຍ​ຂອງ​ອາໂຣນ​ໄດ້​ແບ່ງ​ເປັນ​ໝວດ​ດັ່ງນີ້:</para>
  <para style="p" vid="1CH 24:1">ລູກຊາຍ​ຂອງ​ອາໂຣນ​ມີ​ດັ່ງນີ້: ນາດາບ, ອາບີຮູ, ເອເລອາຊາ ແລະ ອີທາມາ. <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />ແຕ່​ນາດາບ ແລະ ອາບີຮູ​ຕາຍ​ໄປ​ກ່ອນ​ພໍ່​ຂອງ​ພວກເຂົາ, ແລະ ພວກເຂົາ​ບໍ່ມີ​ລູກຊາຍ​ຈັກ​ຄົນ​ເລີຍ; ດັ່ງນັ້ນ ເອເລອາຊາ ແລະ ອີທາມາ​ຈຶ່ງ​ໄດ້​ຮັບໃຊ້​ເປັນ​ປະໂລຫິດ. <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />ດາວິດ​ໄດ້​ແບ່ງ​ເຊື້ອສາຍ​ຂອງ​ອາໂຣນ​ອອກ​ເປັນ​ໝວດ​ຕ່າງໆ ຕາມ​ໜ້າທີ່​ຂອງ​ພວກເຂົາ​ທີ່​ໄດ້​ຮັບ​ການ​ແຕ່ງຕັ້ງ​ໃນ​ການ​ຮັບໃຊ້​ໂດຍ​ມີ​ຊາດົກ​ເຊື້ອສາຍ​ຂອງ​ເອເລອາຊາ ແລະ ອາຮີເມເຫລັກ​ເຊື້ອສາຍ​ຈາກ​ອີທາມາ ເປັນ​ຜູ້​ຊ່ວຍ​ເພິ່ນ. <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />ເຊື້ອສາຍ​ຂອງ​ເອເລອາຊາ​ມີ​ຈໍານວນ​ພວກ​ຜູ້ນຳ​ຫລາຍ​ກວ່າ​ເຊື້ອສາຍ​ຂອງ​ອີທາມາ, ແລະ ພວກເຂົາ​ຖືກ​ແບ່ງ​ອອກ​ດັ່ງນີ້: ສິບຫົກ​ໝວດ​ຈາກ​ເຊື້ອສາຍ​ຂອງ​ເອເລອາຊາ ແລະ ແປດ​ໝວດ​ຈາກ​ເຊື້ອສາຍ​ຂອງ​ອີທາມາ. <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />ການ​ແບ່ງ​ພວກເຂົາ​ເປັນ​ໝວດ​ນັ້ນ​ໃຊ້​ສະຫລາກ​ເພື່ອ​ໃຫ້​ເກີດ​ຄວາມ​ຍຸຕິທໍາ, ມີ​ຜູ້ຮັບໃຊ້​ໃນ​ສະຖານທີ່​ສັກສິດ ແລະ ມີ​ຜູ້ຮັບໃຊ້​ຂອງ​ພຣະເຈົ້າ​ທີ່​ມາ​ຈາກ​ທັງ​ເຊື້ອສາຍ​ຂອງ​ເອເລອາຊາ ແລະ ອີທາມາ.<verse eid="1CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6" />ເຊມາອີຢາ​ລູກຊາຍ​ຂອງ​ເນທາເນນ, ຊາວ​ເລວີ​ໄດ້​ບັນທຶກ​ລາຍຊື່​ຂອງ​ພວກເຂົາ​ຕໍ່ໜ້າ​ກະສັດ ແລະ ບັນດາ​ຂ້າ​ຣາຊການ​ມີ​ດັ່ງນີ້: ປະໂລຫິດ​ຊາດົກ, ອາຮີເມເຫລັກ​ລູກຊາຍ​ຂອງ​ອາບີອາທາ ແລະ ແລະ ບັນດາ​ຫົວໜ້າ​ຄອບຄົວ​ຂອງ​ປະໂລຫິດ ແລະ ຂອງ​ຊາວ​ເລວີ ໂດຍ​ໃຊ້​ການ​ຈັບສະຫລາກ​ມອບໝາຍ​ວຽກ​ໃຫ້​ກຸ່ມ​ໜຶ່ງ​ຈາກ​ເຊື້ອສາຍ​ເອເລອາຊາ ແລະ ອີກ​ກຸ່ມ​ໜຶ່ງ​ຈາກ​ເຊື້ອສາຍ​ຂອງ​ອີທາມາ​ສະ​ຫລັບ​ກັນ​ໄປ.<verse eid="1CH 24:6" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7" />ການ​ຈັບ​ສະຫລາກ​ຄັ້ງ​ທໍາອິດ​ໄດ້​ຕົກ​ຖືກ​ເຢໂຮຍອາຣິບ,</para>
  <para style="li1" vid="1CH 24:7">ຄັ້ງ​ທີ​ສອງ​ເຢດາອີຢາ,<verse eid="1CH 24:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8" />ຄັ້ງ​ທີ​ສາມ​ຮາຣິມ,</para>
  <para style="li1" vid="1CH 24:8">ຄັ້ງ​ທີ​ສີ່​ເສໂອຣິມ,<verse eid="1CH 24:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9" />ຄັ້ງ​ທີຫ້າ​ມັນກີຢາ,</para>
  <para style="li1" vid="1CH 24:9">ຄັ້ງ​ທີ​ຫົກ​ມີຢາມິນ,<verse eid="1CH 24:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10" />ຄັ້ງ​ທີ​ເຈັດ​ຮັກກົດ,</para>
  <para style="li1" vid="1CH 24:10">ຄັ້ງ​ທີ​ແປດ​ອາບີຢາ,<verse eid="1CH 24:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11" />ຄັ້ງ​ທີ​ເກົ້າ​ເຢຊູອາ,</para>
  <para style="li1" vid="1CH 24:11">ຄັ້ງ​ທີ​ສິບ​ເຊການີຢາ,<verse eid="1CH 24:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12" />ຄັ້ງ​ທີ​ສິບເອັດ​ເອລີອາຊິບ,</para>
  <para style="li1" vid="1CH 24:12">ຄັ້ງ​ທີ​ສິບ​ສອງ​ຢາກິມ,<verse eid="1CH 24:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13" />ຄັ້ງ​ທີ​ສິບສາມ​ຮຸບປາ,</para>
  <para style="li1" vid="1CH 24:13">ຄັ້ງ​ທີ​ສິບສີ່​ເຢເຊເບອັບ,<verse eid="1CH 24:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14" />ຄັ້ງ​ທີ​ສິບຫ້າ​ບີນກາ,</para>
  <para style="li1" vid="1CH 24:14">ຄັ້ງ​ທີ​ສິບຫົກ​ອີມເມ,<verse eid="1CH 24:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15" />ຄັ້ງ​ທີ​ສິບເຈັດ​ເຮຊີຣະ,</para>
  <para style="li1" vid="1CH 24:15">ຄັ້ງ​ທີ​ສິບແປດ​ຮັບປີເຊດ<verse eid="1CH 24:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16" />ຄັ້ງ​ທີ​ສິບເກົ້າ​ເປທາຮີຢາ</para>
  <para style="li1" vid="1CH 24:16">ຄັ້ງ​ທີ​ຊາວ​ເຢເຮຊະເກນ<verse eid="1CH 24:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17" />ຄັ້ງ​ທີ​ຊາວເອັດ​ຢາກິນ</para>
  <para style="li1" vid="1CH 24:17">ຄັ້ງ​ທີ​ຊາວ​ສອງ​ກາມູນ<verse eid="1CH 24:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18" />ຄັ້ງ​ທີ​ຊາວສາມ​ເດລາອີຢາ</para>
  <para style="li1" vid="1CH 24:18">ແລະ ຄັ້ງ​ທີ​ຊາວສີ່​ມາອາຊີຢາ.<verse eid="1CH 24:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19" />ນີ້​ຄື​ລຳດັບ​ຄົນ​ທີ່​ໄດ້​ຮັບ​ການ​ແຕ່ງຕັ້ງ​ໃຫ້​ຮັບໃຊ້​ເມື່ອ​ພວກເຂົາ​ເຂົ້າ​ໄປ​ໃນ​ວິຫານ​ຂອງ​ພຣະເຈົ້າຢາເວ, ຕາມ​ກົດລະບຽບ​ທີ່​ໄດ້​ກໍານົດ​ໃຫ້​ພວກເຂົາ​ເຮັດ ເຊິ່ງ​ອາໂຣນ​ບັນພະບຸລຸດ​ຂອງ​ພວກເຂົາ, ໄດ້​ວາງໄວ້​ຕາມ​ທີ່​ພຣະເຈົ້າຢາເວ, ພຣະເຈົ້າ​ແຫ່ງ​ອິດສະຣາເອນ​ໄດ້​ສັ່ງ​ເພິ່ນ.<verse eid="1CH 24:19" /></para>
  <para style="s1">ເຊື້ອສາຍ​ສ່ວນ​ທີ່​ເຫລືອ​ຂອງ​ເລວີ</para>
  <para style="lh">
    <verse number="20" style="v" sid="1CH 24:20" />ສຳລັບ​ເຊື້ອສາຍ​ສ່ວນ​ທີ່​ເຫລືອ​ຂອງ​ເລວີ​ມີ​ດັ່ງນີ້:</para>
  <para style="b" vid="1CH 24:20" />
  <para style="li1" vid="1CH 24:20">ມາ​ຈາກ​ລູກຊາຍ​ຂອງ​ອຳຣາມ ຄື​ຊູບາເອນ;</para>
  <para style="li2" vid="1CH 24:20">ມາ​ຈາກ​ລູກຊາຍ​ຂອງ​ຊູບາເອນ​ແມ່ນ​ເຢເດອີຢາ.<verse eid="1CH 24:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 24:21" />ສຳລັບ​ເຊື້ອສາຍ​ເຣຮາບີຢາ, ມາຈາກ​ລູກຊາຍ​ຂອງ​ລາວ, ແມ່ນ​ອີຊີຢາ​ຄົນ​ທໍາອິດ.<verse eid="1CH 24:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22" />ມາຈາກ​ເຊື້ອສາຍ​ອີຊະຮາດ​ເຊໂລໂມດ;</para>
  <para style="li2" vid="1CH 24:22">ມາຈາກ​ລູກຊາຍ​ຂອງ​ເຊໂລໂມດ: ແມ່ນ​ຢາຮາດ.<verse eid="1CH 24:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23" />ລູກຊາຍ​ຂອງ​ເຮັບໂຣນ​ມີ:</para>
  <para style="li2" vid="1CH 24:23">ເຢຣີຢາ​ເປັນ​ຄົນ​ທີ​ໜຶ່ງ,<note caller="+" style="f"><char style="fr" closed="false">24:23 </char><char style="ft" closed="false">ສຳເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ລູກ​ທັງຫລາຍ​ຂອງ​ເຍລີຢາ (<char style="xt">ເບິ່ງ <ref loc="1CH 23:19">23:19</ref></char>)</char></note> ຄົນ​ທີ​ສອງ​ແມ່ນ​ອາມາຣີຢາ, ຄົນ​ທີ​ສາມ​ແມ່ນ​ເຢຮາຊີເອນ ແລະ ຄົນ​ທີ​ສີ່​ແມ່ນ​ເຢກາເມອາມ.<verse eid="1CH 24:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24" />ລູກຊາຍ​ຂອງ​ອຸດຊີເອນ​ແມ່ນ​ມີກາ;</para>
  <para style="li2" vid="1CH 24:24">ຈາກ​ລູກຊາຍ​ຂອງ​ມີກາ​ຄື​ຊາເມຍ.<verse eid="1CH 24:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 24:25" />ນ້ອງຊາຍ​ຂອງ​ມີກາ​ແມ່ນ​ອິດຊີຢາ;</para>
  <para style="li2" vid="1CH 24:25">ມາ​ຈາກ​ລູກຊາຍ​ຂອງ​ອິດຊີຢາ​ແມ່ນ​ເຊກາຣີຢາ.<verse eid="1CH 24:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26" />ລູກຊາຍ​ຂອງ​ເມຣາຣິ​ແມ່ນ​ມາຮະລີ, ມູຊີ ແລະ ຢາອາຊີຢາ,</para>
  <para style="li2" vid="1CH 24:26">ລູກຊາຍ​ຂອງ​ຢາອາຊີຢາ​ແມ່ນ​ເບໂນ.<verse eid="1CH 24:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27" />ລູກຊາຍ​ຂອງ​ເມຣາຣິ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 24:27">ມາ​ຈາກ​ຢາອາຊີຢາ​ແມ່ນ ໂຊຮາມ, ຊັກກູເຣ ແລະ ອິບຣີ.<verse eid="1CH 24:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28" />ມາ​ຈາກ​ມາຮະລີ​ແມ່ນ​ເອເລອາຊາ, ຜູ້​ທີ່​ບໍ່​ມີ​ລູກຊາຍ.<verse eid="1CH 24:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29" />ມາ​ຈາກ​ກີເຊ​ແມ່ນ ເຢຣາເມເອນ<verse eid="1CH 24:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30" />ລູກຊາຍ​ຂອງ​ມູຊີ​ມີ: ມາຮະລີ, ເອເດ ແລະ ເຢຣີໂມດ.</para>
  <para style="b" vid="1CH 24:30" />
  <para style="lf" vid="1CH 24:30">ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ຊາວ​ເລວີ​ຕາມ​ຄອບຄົວ​ຂອງ​ພວກເຂົາ.<verse eid="1CH 24:30" /></para>
  <para style="b" />
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31" />ພວກເຂົາ​ໄດ້​ຮັບ​ໜ້າທີ່​ຕ່າງໆ​ໂດຍ​ການ​ຈັບ​ສະຫລາກ, ຄື​ກັນ​ກັບ​ເຊື້ອສາຍ​ຂອງ​ອາໂຣນ ທີ່​ໄດ້​ຮັບ​ສິ່ງ​ນີ້​ຢູ່​ຕໍ່ໜ້າ​ກະສັດ​ດາວິດ, ຊາດົກ, ອາຮີເມເຫລັກ ແລະ ບັນດາ​ຫົວໜ້າ​ຄອບຄົວ​ຂອງ​ປະໂລຫິດ ແລະ ຂອງ​ຊາວ​ເລວີ. ຄອບຄົວ​ຂອງ​ຜູ້​ທີ່​ເປັນ​ອ້າຍ​ກໍ​ໄດ້​ປະຕິບັດ​ຄືກັນ​ກັບ​ຄອບຄົວ​ຂອງ​ຜູ້​ທີ່​ເປັນ​ນ້ອງຊາຍ.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s1">ພວກ​ນັກດົນຕຼີ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />ດາວິດ, ລວມທັງ​ບັນດາ​ຜູ້ບັນຊາການ​ກອງທັບ​ໄດ້​ແຍກ​ລູກຊາຍ​ບາງຄົນ​ຂອງ​ອາສັບ, ເຮມານ ແລະ ເຢດູທູນ ເພື່ອ​ຮັບໃຊ້​ໃນ​ການ​ທໍານວາຍ, ຮ່ວມ​ດີດ​ພິນ​ໃຫຍ່, ດີດ​ພິນ​ນ້ອຍ ແລະ ຕົບ​ແສ່ງ. ລາຍຊື່​ຕໍ່ໄປ​ນີ້​ແມ່ນ​ຜູ້​ທີ່​ເຮັດ​ໜ້າທີ່​ໃນ​ການ​ຮັບໃຊ້​ໃນ​ການ​ນະມັດສະການ​ມີ​ດັ່ງນີ້:<verse eid="1CH 25:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2" />ມາຈາກ​ລູກຊາຍ​ຂອງ​ອາສັບ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 25:2">ຊັກກູເຣ, ໂຢເຊັບ, ເນທານີຢາ ແລະ ອາຊາເຣລາ. ລູກຊາຍ​ຂອງ​ອາສັບ​ຢູ່​ພາຍໃຕ້​ການ​ດູແລ​ຂອງ​ອາສັບ, ທີ່​ເປັນ​ຜູ້ທໍານວາຍ​ພາຍໃຕ້​ການ​ດູແລ​ຂອງ​ກະສັດ.<verse eid="1CH 25:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3" />ມາ​ຈາກ​ລູກຊາຍ​ຂອງ​ເຢດູທູນ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 25:3">ເກດາລິຢາ, ເຊຣີ, ເຢຊາອີຢາ, ຊີເມອີ,<note caller="+" style="f"><char style="fr" closed="false">25:3 </char><char style="ft" closed="false">ສຳເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ບໍ່ມີ​ຄຳ​ວ່າ ຊີເມອີ ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="1CH 25:17"><ref loc="1CH 25:17">17</ref></char></char></note> ຮາຊາບີຢາ ແລະ ມັດຕີທີຢາ, ລວມ​ທັງໝົດ​ມີ​ຫົກ​ຄົນ, ຢູ່​ພາຍໃຕ້​ການ​ດູແລ​ຂອງ​ເຢດູທູນ​ພໍ່​ຂອງ​ພວກເຂົາ, ທີ່​ເປັນ​ຜູ້ທໍານວາຍ, ໂດຍ​ການ​ດີດ​ພິນໃຫຍ່​ເພື່ອ​ໂມທະນາ​ຂອບພຣະຄຸນ ແລະ ຮ້ອງເພງ​ສັນລະເສີນ​ພຣະເຈົ້າຢາເວ.<verse eid="1CH 25:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4" />ມາ​ຈາກ​ລູກຊາຍ​ຂອງ​ເຮມານ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 25:4">ບຸກກີຢາ, ມັດຕານີຢາ, ອຸດຊີເອນ, ເຊບູເອນ, ເຢຣີໂມດ, ຮານານີຢາ, ຮານານີ, ເອລີອາທາ, ກິດດັນຕີ, ໂຣມາມຕີ​ເອເຊ, ໂຢຊະເບກາຊາ, ມັນໂລທີ, ໂຮທີເຣ ແລະ ມາຮາຊີອົດ. <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />(ຄົນ​ເຫລົ່ານີ້​ທັງໝົດ​ແມ່ນ​ພວກ​ລູກຊາຍ​ຂອງ​ເຮມານ​ຜູ້ທຳນວາຍ​ຂອງ​ກະສັດ. ພຣະເຈົ້າ​ໄດ້ໃຫ້​ລາວ​ມີ​ລູກຊາຍ​ຕາມ​ທີ່​ພຣະເຈົ້າ​ໄດ້​ສັນຍາ​ໄວ້. ເພື່ອ​ຍົກຍ້ອງ​ລາວ ພຣະເຈົ້າ​ໄດ້​ໃຫ້​ເຮມານ​ມີ​ລູກຊາຍ​ສິບ​ສີ່​ຄົນ ແລະ ລູກສາວ​ສາມ​ຄົນ.)<verse eid="1CH 25:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6" />ພວກຄົນ​ເຫລົ່ານີ້​ມີ​ໜ້າທີ່​ຕົບ​ແສ່ງ, ດີດ​ພິນ​ໃຫຍ່ ແລະ ດີດ​ພິນ​ນ້ອຍ ເພື່ອ​ເປັນ​ນັກດົນຕີ​ໃນ​ວິຫານ​ຂອງ​ພຣະເຈົ້າຢາເວ, ເຊິ່ງ​ພວກເຂົາ​ຢູ່​ພາຍໃຕ້​ການ​ດູແລ​ໂດຍ​ພໍ່​ຂອງ​ພວກເຂົາ.</para>
  <para style="p" vid="1CH 25:6">ສ່ວນ​ອາສັບ, ເຢດູທູນ ແລະ ເຮມານ​ຢູ່​ພາຍໃຕ້​ການ​ດູແລ​ຂອງ​ກະສັດ. <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />ພວກເຂົາ​ທັງໝົດ ແລະ ຍາດ​ພີ່ນ້ອງ​ຂອງ​ພວກເຂົາ​ໄດ້​ຮັບ​ການ​ຝຶກຝົນ ແລະ ຊໍານານ​ໃນ​ດ້ານ​ດົນຕີ​ເພື່ອ​ຖວາຍ​ແກ່​ພຣະເຈົ້າຢາເວ ພວກເຂົາ​ມີ​ທັງໝົດ 288 ຄົນ. <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />ພວກເຂົາ​ໄດ້​ຮັບ​ມອບໝາຍ​ໜ້າທີ່​ໂດຍ​ການ​ຈັບ​ສະຫລາກ, ບໍ່​ວ່າ​ຈະ​ເປັນ​ຄົນໜຸ່ມ ຫລື ຜູ້​ໃຫຍ່, ບໍ່​ວ່າ​ຈະ​ເປັນ​ຄູ ຫລື ລູກສິດ.<verse eid="1CH 25:8" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="9" style="v" sid="1CH 25:9" />ສະຫລາກ​ທີ​ໜຶ່ງ​ໄດ້​ຕົກ​ຖືກ​ໂຢເຊັບ, ຄອບຄົວ​ຂອງ​ອາສັບ,</para>
  <para style="li2" vid="1CH 25:9">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.</para>
  <para style="li1" vid="1CH 25:9">ສະຫລາກ​ທີ​ສອງ​ໄດ້​ຕົກ​ຖືກ​ເກດາລິຢາ,</para>
  <para style="li2" vid="1CH 25:9">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 25:10" />ສະຫລາກ​ທີ​ສາມ​ໄດ້​ຕົກ​ຖືກ​ຊັກກູເຣ,</para>
  <para style="li2" vid="1CH 25:10">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 25:11" />ສະຫລາກ​ທີ​ສີ່​ໄດ້​ຕົກ​ຖືກ​ເຊຣີ,<note caller="+" style="f"><char style="fr" closed="false">25:11 </char><char style="ft" closed="false">ເປັນ​ອີກ​ຊື່​ໜຶ່ງ​ຂອງ ເຊລີ</char></note></para>
  <para style="li2" vid="1CH 25:11">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 25:12" />ສະຫລາກ​ທີ​ຫ້າ​ໄດ້​ຕົກ​ຖືກ​ເນທານີຢາ,</para>
  <para style="li2" vid="1CH 25:12">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 25:13" />ສະຫລາກ​ທີ​ຫົກ​ໄດ້​ຕົກ​ຖືກ​ບຸກກີຢາ,</para>
  <para style="li2" vid="1CH 25:13">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 25:14" />ສະຫລາກ​ທີ​ເຈັດ​ໄດ້​ຕົກ​ຖືກ​ອາຊາເຣລາ<note caller="+" style="f"><char style="fr" closed="false">25:14 </char><char style="ft" closed="false">ເປັນ​ອີກ​ຮູບ​ໜຶ່ງ​ຂອງ ອາຊາເລລາ</char></note></para>
  <para style="li2" vid="1CH 25:14">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 25:15" />ສະຫລາກ​ທີແປດ​ໄດ້​ຕົກ​ຖືກ​ເຢຊາອີຢາ,</para>
  <para style="li2" vid="1CH 25:15">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ​ຂອງ​ລາວ<verse eid="1CH 25:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 25:16" />ສະຫລາກ​ທີ​ເກົ້າ​ໄດ້​ຕົກ​ຖືກ​ມັດຕານີຢາ,</para>
  <para style="li2" vid="1CH 25:16">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 25:17" />ສະຫລາກ​ທີ​ສິບ​ໄດ້​ຕົກ​ຖືກ​ຊີເມອີ,</para>
  <para style="li2" vid="1CH 25:17">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 25:18" />ສະຫລາກ​ທີ​ສິບ​ເອັດ​ໄດ້​ຕົກ​ຖືກ​ອາຊາເຣນ,<note caller="+" style="f"><char style="fr" closed="false">25:18 </char><char style="ft" closed="false">ເປັນ​ອີກ​ຊື່​ໜຶ່ງ​ຂອງ ອຸດຊີເອນ</char></note></para>
  <para style="li2" vid="1CH 25:18">ກັບ​ພວກ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 25:19" />ສະຫລາກ​ທີ​ສິບ​ສອງ​ໄດ້​ຕົກ​ຖືກ​ຮາຊາບີຢາ,</para>
  <para style="li2" vid="1CH 25:19">ກັບ​ພວກ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 25:20" />ສະຫລາກ​ທີ​ສິບ​ສາມ​ໄດ້​ຕົກ​ຖືກ​ຊູບາເອນ,</para>
  <para style="li2" vid="1CH 25:20">ພວກ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 25:21" />ສະຫລາກ​ທີ​ສິບສີ່​ໄດ້​ຕົກ​ຖືກ​ມັດຕີທີຢາ,</para>
  <para style="li2" vid="1CH 25:21">ກັບ​ພວກ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 25:22" />ສະຫລາກ​ທີ​ສິບ​ຫ້າ​ໄດ້​ຕົກ​ຖືກ​ເຢຣີໂມດ,</para>
  <para style="li2" vid="1CH 25:22">ກັບ​ພວກ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 25:23" />ສະຫລາກ​ທີ​ສິບຫົກ​ໄດ້​ຕົກ​ຖືກ​ຮານານີຢາ,</para>
  <para style="li2" vid="1CH 25:23">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 25:24" />ສະຫລາກ​ທີ​ສິບ​ເຈັດ​ໄດ້​ຕົກ​ຖືກ​ໂຢຊະເບກາຊາ,</para>
  <para style="li2" vid="1CH 25:24">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 25:25" />ສະຫລາກ​ທີ​ສິບ​ແປດ​ໄດ້​ຕົກ​ຖືກ​ຮານານີ,</para>
  <para style="li2" vid="1CH 25:25">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 25:26" />ສະຫລາກ​ທີ​ສິບ​ເກົ້າ​ໄດ້​ຕົກ​ຖືກ​ມັນໂລທີ,</para>
  <para style="li2" vid="1CH 25:26">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 25:27" />ສະຫລາກ​ທີ​ຊາວ​ໄດ້​ຕົກ​ຖືກ​ເອລີອາທາ,</para>
  <para style="li2" vid="1CH 25:27">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 25:28" />ສະຫລາກ​ທີ​ຊາວ​ເອັດ​ໄດ້​ຕົກ​ຖືກ​ໂຮທີເຣ,</para>
  <para style="li2" vid="1CH 25:28">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 25:29" />ສະຫລາກ​ທີ​ຊາວ​ສອງ​ໄດ້​ຕົກ​ຖືກ​ກິດດັນຕີ,</para>
  <para style="li2" vid="1CH 25:29">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 25:30" />ສະຫລາກ​ທີ​ຊາວ​ສາມ​ໄດ້​ຕົກ​ຖືກ​ມາຮາຊີອົດ,</para>
  <para style="li2" vid="1CH 25:30">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 25:31" />ສະຫລາກ​ທີ​ຊາວ​ສີ່​ໄດ້​ຕົກ​ຖືກ​ໂຣມາມຕີ​ເອເຊ,</para>
  <para style="li2" vid="1CH 25:31">ກັບ​ບັນດາ​ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ ລວມ​ມີ 12 ຄົນ.<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s1">ຄົນ​ເຝົ້າຍາມ​ປະຕູ​ວິຫານ</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 26:1" />ການ​ແບ່ງ​ຄົນ​ເຝົ້າຍາມ​ປະຕູ​ວິຫານ​ມີ​ດັ່ງນີ້:</para>
  <para style="b" vid="1CH 26:1" />
  <para style="lh" vid="1CH 26:1">ຈາກ​ຕະກຸນ​ຂອງ​ໂກຣາ​ມີ:</para>
  <para style="li1" vid="1CH 26:1">ເມເຊເລມີຢາ ລູກຊາຍ​ຂອງ​ໂກເຣ, ເປັນ​ລູກຊາຍ​ຄົນ​ໜຶ່ງ​ຂອງ​ອາສັບ. <verse eid="1CH 26:1" /><verse number="2" style="v" sid="1CH 26:2" />ລູກຊາຍ​ຂອງ​ເມເຊເລມີຢາ ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 26:2">ເຊກາຣີຢາ​ເປັນ​ລູກຊາຍ​ກົກ, ຄົນ​ທີ​ສອງ​ແມ່ນ​ເຢດີອາເອນ,</para>
  <para style="li2" vid="1CH 26:2">ຄົນ​ທີ​ສາມ​ແມ່ນ​ເຊບາດີຢາ, ຄົນ​ທີ​ສີ່​ແມ່ນ​ຢາທະນິເອນ,<verse eid="1CH 26:2" /></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 26:3" />ຄົນ​ທີ​ຫ້າ​ແມ່ນ​ເອລາມ, ຄົນ​ທີ​ຫົກ​ແມ່ນ​ເຢໂຮຮານານ,</para>
  <para style="li2" vid="1CH 26:3">ແລະ ຄົນ​ທີ​ເຈັດ​ແມ່ນ​ເອລີເອໂຮນາຍ.<verse eid="1CH 26:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4" />ໂອເບັດເອໂດມ​ກໍ​ມີ​ລູກຊາຍ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 26:4">ເຊມາອີຢາ​ເປັນ​ລູກຊາຍ​ກົກ, ຄົນ​ທີ​ສອງ​ແມ່ນ​ເຢໂຮຊາບັດ,</para>
  <para style="li2" vid="1CH 26:4">ຄົນ​ທີ​ສາມ​ແມ່ນ​ໂຢອາ, ຄົນ​ທີ​ສີ່​ແມ່ນ​ສາກາ,</para>
  <para style="li2" vid="1CH 26:4">ຄົນ​ທີ​ຫ້າ​ແມ່ນ​ເນທາເນນ, <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />ຄົນ​ທີ​ຫົກ​ແມ່ນ​ອາມມີເອນ,</para>
  <para style="li2" vid="1CH 26:5">ຄົນ​ທີ​ເຈັດ​ແມ່ນ​ອິດຊາຄາ, ແລະ ຄົນ​ທີ​ແປດ​ແມ່ນ​ເປອູນເລໄທ.</para>
  <para style="li2" vid="1CH 26:5">(ເພາະ​ພຣະເຈົ້າ​ໄດ້​ອວຍພອນ​ໂອເບັດ​ເອໂດມ)<verse eid="1CH 26:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6" />ເຊມາອີຢາ ລູກຊາຍ​ກົກ​ຂອງ​ໂອເບັດເອໂດມ​ກໍ​ມີ​ລູກຊາຍ​ຫລາຍ​ຄົນ ທີ່​ເປັນ​ຜູ້ນຳ​ໃນ​ຄອບຄົວ​ຂອງ​ພໍ່​ຂອງ​ພວກເຂົາ ເພາະ​ພວກເຂົາ​ເປັນ​ຄົນ​ທີ່​ມີ​ຄວາມ​ສາມາດ​ຫລາຍ. <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />ລູກຊາຍ​ຂອງ​ເຊມາອີຢາ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 26:7">ໂອທະນີ, ເຣຟາເອນ, ໂອເບັດ ແລະ ເອນຊາບັດ;</para>
  <para style="li2" vid="1CH 26:7">ເອລີຮູ ແລະ ເສມາກີຢາ​ພ້ອມທັງ​ຍາດພີ່ນ້ອງ​ຂອງ​ລາວ​ກໍ​ເປັນ​ຄົນ​ທີ່​ມີ​ຄວາມ​ສາມາດ​ຫລາຍ.<verse eid="1CH 26:7" /></para>
  <para style="lf">
    <verse number="8" style="v" sid="1CH 26:8" />ຄົນ​ເຫລົ່ານີ້​ເປັນ​ເຊື້ອສາຍ​ຂອງ​ໂອເບັດເອໂດມ; ພວກເຂົາ, ລູກຫຼານ ແລະ ຍາດພີ່ນ້ອງ​ຂອງ​ພວກເຂົາ​ເປັນຄົນ​ທີ່​ມີ​ຄວາມ​ສາມາດ​ຫລາຍ ພ້ອມທັງ​ມີ​ກຳລັງ​ໃນ​ການ​ປະຕິບັດ​ວຽກງານ. ເຊື້ອສາຍ​ຂອງ​ໂອເບັດ​ເອໂດມ​ລວມ​ທັງໝົດ​ມີ 62 ຄົນ.<verse eid="1CH 26:8" /></para>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 26:9" />ເມເຊເລມີຢາ​ມີ​ລູກຊາຍ ແລະ ຍາດພີ່ນ້ອງ ທີ່​ເປັນ​ຄົນ​ທີ່​ມີ​ຄວາມ​ສາມາດ​ລວມທັງ​ໝົດ​ມີ​ສິບແປດ​ຄົນ.<verse eid="1CH 26:9" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="10" style="v" sid="1CH 26:10" />ໂຮສາ​ຈາກ​ຕະກຸນ​ເມຣາຣິ ມີ​ລູກຊາຍ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 26:10">ຄົນ​ທີ​ໜຶ່ງ​ແມ່ນ​ຊີມຣີ (ເຖິງແມ່ນວ່າ​ຊິມຣີ​ຈະ​ບໍ່ແມ່ນ​ລູກຊາຍ​ກົກ ແຕ່​ພໍ່​ໄດ້​ຕັ້ງ​ລາວ​ເປັນ​ຄົນ​ທີ​ໜຶ່ງ),<verse eid="1CH 26:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 26:11" />ຄົນ​ທີ​ສອງ​ແມ່ນ​ຮິນກີຢາ, ຄົນ​ທີ​ສາມ​ແມ່ນ​ເຕບາລີຢາ</para>
  <para style="li2" vid="1CH 26:11">ຄົນ​ທີສີ່​ແມ່ນ​ເຊກາຣີຢາ.</para>
  <para style="lf" vid="1CH 26:11">ລູກຊາຍ ແລະ ຍາດ​ພີ່ນ້ອງ​ຂອງ​ໂຮສາ ລວມ​ທັງໝົດ​ມີ​ສິບ​ສາມ​ຄົນ.<verse eid="1CH 26:11" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="12" style="v" sid="1CH 26:12" />ນີ້​ແມ່ນ​ການ​ແບ່ງ​ພວກ​ຄົນ​ຍາມ​ເຝົ້າ​ປະຕູ​ວິຫານ, ທີ່ໄດ້​ແບ່ງ​ຕາມ​ຜູ້ນໍາ​ຂອງ​ພວກເຂົາ, ມີ​ໜ້າທີ່​ຮັບໃຊ້​ໃນ​ວິຫານ​ຂອງ​ພຣະເຈົ້າຢາເວ​ເໝືອນກັນ​ກັບ​ຄົນ​ເລວີ​ອື່ນໆ. <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />ພວກເຂົາ​ໄດ້​ຮັບຜິດຊອບ​ຍາມ​ແຕ່ລະ​ປະຕູ​ໂດຍ​ການ​ຈັບ​ສະຫລາກ​ຕາມ​ຄອບຄົວ​ຂອງ​ພວກເຂົາ, ບໍ່​ວ່າ​ເປັນ​ຜູ້ໃຫຍ່ ແລະ ຄົນໜຸ່ມ​ກໍ​ເໝືອນ​ກັນ.<verse eid="1CH 26:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 26:14" />ສໍາລັບ​ການ​ຈັບ​ສະຫລາກ​ເພື່ອ​ຮັບຜິດຊອບ​ຍາມ​ປະຕູ​ດ້ານ​ຕາເວັນ​ອອກ ໄດ້​ຕົກ​ຖືກ​ເຊເລມີຢາ.<note caller="+" style="f"><char style="fr" closed="false">26:14 </char><char style="ft" closed="false">ເປັນ​ອີກ​ຊື່​ໜຶ່ງ​ຂອງ ເມເຊເລມິຢາ</char></note></para>
  <para style="li1" vid="1CH 26:14">ແລ້ວ​ສະຫລາກ​ສໍາລັບ​ດ້ານ​ເໜືອ ໄດ້​ຕົກຖືກ​ເຊກາຣີຢາ ລູກຊາຍ​ຂອງ​ລາວ, ທີ່​ເປັນ​ຜູ້​ໃຫ້​ຄໍາປຶກສາ​ທີ່​ສະຫຼຽວ​ສະຫຼາດ.<verse eid="1CH 26:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 26:15" />ສະຫລາກ​ສຳລັບ​ປະຕູ​ດ້ານ​ໃຕ້ ໄດ້​ຕົກ​ຖືກ​ໂອເບັດເອໂດມ ແລະ ສະຫລາກ​ສຳລັບ​ເຝົ້າຍາມ​ຫ້ອງ​ເກັບ​ເຄື່ອງ​ໄດ້​ຕົກ​ຖືກ​ບັນດາ​ລູກຊາຍ​ຂອງ​ລາວ.<verse eid="1CH 26:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 26:16" />ສະຫລາກ​ສຳລັບ​ປະຕູ​ດ້ານ​ຕາເວັນຕົກ ແລະ ປະຕູ​ຊັນເລເກັດ​ທີ່​ຖະໜົນ​ດ້ານ​ເທິງ ໄດ້​ຕົກ​ຖືກ ຊຸບປິມ ແລະ ໂຮສາ.</para>
  <para style="b" vid="1CH 26:16" />
  <para style="lh" vid="1CH 26:16">ໜ້າທີ່​ເຝົ້າຍາມ​ທີ່​ປ່ຽນ​ຜຽນ​ກັນ​ຍາມ​ດັ່ງນີ້:<verse eid="1CH 26:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 26:17" />ປະຕູ​ທາງ​ດ້ານ​ຕາເວັນອອກ ແຕ່​ລະ​ມື້​ຈະ​ມີ​ຍາມ​ຄົນ​ເລວີ​ຫົກ​ຄົນ,</para>
  <para style="li1" vid="1CH 26:17">ປະຕູ​ດ້ານ​ເໜືອ​ມີ​ຄົນ​ຍາມ​ສີ່​ຄົນ,</para>
  <para style="li1" vid="1CH 26:17">ປະຕູ​ດ້ານ​ໃຕ້​ມີ​ສີ່​ຄົນ</para>
  <para style="li1" vid="1CH 26:17">ຫ້ອງ​ເກັບ​ເຄື່ອງ​ຈະ​ມີ​ເວນຍາມ​ສອງ​ຄັ້ງ ຄັ້ງ​ລະ​ສອງ​ຄົນ.<verse eid="1CH 26:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 26:18" />ສຳລັບ​ສາລາ​ທາງ​ດ້ານ​ຕາເວັນຕົກ​ທີ່​ຖະໜົນ​ມີ​ສອງ​ຄົນ ແລະ ໃນ​ສາລາ​ເອງ​ມີ​ສອງ​ຄົນ.<verse eid="1CH 26:18" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="19" style="v" sid="1CH 26:19" />ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ຄົນ​ເຝົ້າຍາມ​ປະຕູ​ວິຫານ ທີ່​ເປັນ​ເຊື້ອສາຍ​ຂອງ​ໂກຣາ ແລະ ເມຣາຣິ.<verse eid="1CH 26:19" /></para>
  <para style="s1">ນາຍຄັງ ແລະ ໜ້າທີ່​ອື່ນໆ​ໃນ​ວິຫານ</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />ພີ່ນ້ອງ​ຊາວ​ເລວີ​ຄົນ​ອື່ນໆ<note caller="+" style="f"><char style="fr" closed="false">26:20 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ຈາກ​ຄົນ​ເລວີ ອາ </char><char style="fqa" closed="false">ຮີ </char><char style="ft" closed="false">ຢາ​ເປັນ​ຜູ້​ເບິ່ງ​ແຍງ</char></note> ມີ​ໜ້າ​ທີ​ຮັບຜິດຊອບ​ຄັງ​ຂອງ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ ແລະ ຄັງ​ຂອງ​ຖວາຍ​ຕ່າງໆ.<verse eid="1CH 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21" />ເຊື້ອສາຍ​ຂອງ​ລາດານ, ຈາກ​ຕະກຸນ​ເກໂຊນ ແລະ ເປັນ​ຫົວໜ້າ​ຄອບຄົວ​ຕາມ​ເຊື້ອສາຍ​ລາດານ​ຄື, ເຢຮີເອລີ, <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />ລູກຊາຍ​ຂອງ​ລາດານ​ມີ​ດັ່ງນີ້: ເຢຮີເອລີ ເຊທາມ ແລະ ໂຢເອນ​ນ້ອງຊາຍ​ຂອງ​ລາວ. ພວກເຂົາ​ເປັນ​ຜູ້​ຮັບຜິດຊອບ​ຄັງ​ວິຫານ​ຂອງ​ພຣະເຈົ້າຢາເວ.<verse eid="1CH 26:22" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="23" style="v" sid="1CH 26:23" />ຈາກ​ຕະກຸນ​ອຳຣາມ, ອີຊະຮາດ, ເຮັບໂຣນ ແລະ ອຸດຊີເອນ​ມີ​ດັ່ງນີ້:<verse eid="1CH 26:23" /></para>
  <para style="b" />
  <para style="li2">
    <verse number="24" style="v" sid="1CH 26:24" />ເຊບູເອນ ເຊື້ອສາຍ​ຂອງ​ເກໂຊມ​ລູກຊາຍ​ຂອງ​ໂມເຊ, ເປັນ​ເຈົ້າໜ້າທີ່​ຮັບຜິດຊອບ​ຄັງ​ຕ່າງໆ. <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />ຍາດ​ພີ່ນ້ອງ​ຂອງ​ລາວ​ທີ່​ທາງ​ເອລີເອເຊ​ຄື: ເຣຮາບີຢາ​ເປັນ​ພໍ່​ຂອງ​ເຢຊາອີຢາ, ເຢຊາອີຢາ​ເປັນ​ພໍ່​ຂອງ​ໂຢຣາມ, ໂຢຣາມ​ເປັນ​ພໍ່​ຂອງ​ຊີກະຣີ, ຊີກະຣີ​ເປັນ​ພໍ່​ຂອງ​ເຊໂລມິດ.<verse eid="1CH 26:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 26:26" />ເຊໂລມິດ ແລະ ຍາດ​ພີ່ນ້ອງ​ຂອງ​ລາວ​ແມ່ນ​ຮັບຜິດຊອບ​ຄັງ​ທັງໝົດ​ທີ່​ກະສັດ​ດາວິດ, ບັນດາ​ຫົວໜ້າ​ຄອບຄົວ​ຕ່າງໆ ທີ່​ຜູ້ບັນຊາການ​ກອງພັນ ແລະ ບັນດາ​ຜູ້ບັນຊາການ​ກອງຮ້ອຍ ແລະ ບັນດາ​ຜູ້​ບັນຊາ​ການກອງ​ທັບ​ໄດ້​ອຸທິດຖວາຍ​ແກ່​ພຣະເຈົ້າ. <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />ພວກເຂົາ​ໄດ້​ນໍາ​ເອົາ​ເຄື່ອງບາງ​ສ່ວນ​ທີ່​ຢຶດ​ມາ​ໄດ້​ຈາກ​ການ​ສູ້ຮົບ ພວກເຂົາ​ໄດ້​ອຸທິດຖວາຍ​ເພື່ອ​ນໍາໃຊ້​ໃນ​ການ​ບຳລຸງ​ຮັກສາ​ວິຫານ​ຂອງ​ພຣະເຈົ້າຢາເວ. <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />ເຊໂລມິດ ແລະ ຍາດ​ພີ່ນ້ອງ​ຂອງ​ລາວ​ກໍ​ຍັງ​ຮັບຜິດຊອບ​ທຸກສິ່ງ​ທີ່​ຜູ້ທຳນວາຍ​ຊາມູເອນ, ກະສັດ​ໂຊນ​ລູກຊາຍ​ຂອງ​ກີເຊ, ອັບເນ​ລູກຊາຍ​ຂອງ​ເນຣະ ແລະ ໂຢອາບ​ລູກຊາຍ​ຂອງ​ນາງ​ເຊຣູອີຢາ ແລະ ຄົນ​ອື່ນໆ​ໄດ້​ຖວາຍ​ແກ່​ພຣະເຈົ້າ.<verse eid="1CH 26:28" /></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 26:29" />ຈາກ​ຕະກຸນ​ອິດຊະຮາດ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 26:29">ເກນານີຢາ​ກັບ​ລູກຊາຍ​ຂອງ​ລາວ ໄດ້​ຮັບ​ໜ້າທີ່​ພາຍນອກ​ວິຫານ, ຄື ເປັນ​ເຈົ້າໜ້າທີ່ ແລະ ຜູ້ປົກຄອງ​ອິດສະຣາເອນ.<verse eid="1CH 26:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 26:30" />ຈາກ​ຕະກຸນ​ເຮັບໂຣນ​ມີ​ດັ່ງນີ້:</para>
  <para style="li2" vid="1CH 26:30">ຮາຊາບີຢາ ແລະ ພີ່ນ້ອງ​ຂອງ​ລາວ ມີ​ໜຶ່ງ​ພັນ​ເຈັດຮ້ອຍ​ຄົນ, ພວກເຂົາ​ມີ​ໜ້າທີ່​ຮັບຜິດຊອບ​ອິດສະຣາເອນ​ທາງ​ຕາເວັນ​ຕົກ​ຂອງ​ແມ່ນ້ຳ​ຈໍແດນ​ໃຫ້​ເຮັດວຽກ​ທຸກຢ່າງ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ ແລະ ຮັບໃຊ້​ກະສັດ. <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />ສໍາລັບ​ຕະກຸນ​ເຮັບໂຣນ, ເຢຣິຢາ​ເປັນ​ຫົວໜ້າ​ຕາມ​ການ​ບັນທຶກ​ລຳ​ດັບ​ຄອບຄົວ​ຂອງ​ພວກເຂົາ.</para>
  <para style="li2" vid="1CH 26:31">ໃນ​ການ​ປົກຄອງ​ປີ​ທີ​ສີ່ສິບ​ຂອງ​ກະສັດ​ດາວິດ ມີ​ການ​ສຳຫລວດ ແລະ ໄດ້​ບັນທຶກ​ໄວ້, ແລະ ພົບ​ວ່າ​ມີ​ຄົນ​ທີ່​ມີ​ຄວາມ​ສາມາດ​ໃນ​ຕະກຸນ​ຂອງ​ເຮັບໂຣນ​ທີ່​ຢາເຊ​ໃນ​ກີເລອາດ. <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />ເຢຣິຢາ​ມີ​ຍາດພີ່ນ້ອງ​ສອງພັນ​ເຈັດຮ້ອຍ​ຄົນ, ທີ່​ເປັນ​ຄົນ​ມີ​ຄວາມ​ສາມາດ ແລະ ເປັນ​ຫົວໜ້າ​ຄອບຄົວ​ຕ່າງໆ, ກະສັດ​ດາວິດ​ຈຶ່ງ​ຕັ້ງ​ພວກເຂົາ​ໃຫ້​ຮັບຜິດຊອບ​ຊາວ​ຣູເບັນ, ຊາວ​ກາດ ແລະ ຊາວ​ມານາເຊ​ເຄິ່ງ​ເຜົ່າ​ໃຫ້​ເຮັດວຽກ​ທຸກ​ຢ່າງ​ທີ່​ກ່ຽວກັບ​ພຣະເຈົ້າ ແລະ ກິດຈະການ​ຂອງ​ກະສັດ.<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s1">ການ​ແບ່ງ​ໝວດ​ກອງທັບ</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 27:1" />ຕໍ່​ໄປ​ນີ້​ແມ່ນ​ລາຍຊື່​ບັນດາ​ຫົວໜ້າ​ຄອບຄົວ, ຜູ້ບັນຊາການ​ກອງພັນ ແລະ ບັນດາ​ຜູ້ບັນຊາການ​ກອງຮ້ອຍ, ແລະ ເຈົ້າໜ້າທີ່​ຕ່າງໆ​ຂອງ​ອິດສະຣາເອນ, ທີ່​ຮັບໃຊ້​ກະສັດ​ໃນ​ທຸກ​ວຽກງານ​ທີ່​ກ່ຽວກັບ​ການ​ແບ່ງ​ໝວດ​ກອງ​ທະຫານ​ປະຕິບັດ​ໜ້າທີ່​ໃນ​ແຕ່ລະ​ເດືອນ​ຕະຫລອດ​ປີ. ແຕ່​ລະ​ໝວດ​ມີ​ທະຫານ​ຊາວສີ່​ພັນ​ຄົນ.<verse eid="1CH 27:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2" />ຜູ້ບັນຊາການ​ໝວດ​ທີ​ໜຶ່ງ, ທີ່​ຮັບຜິດຊອບ​ໃນ​ເດືອນ​ທີ​ໜຶ່ງ, ແມ່ນ​ຢາໂຊເບອາມ ລູກຊາຍ​ຂອງ​ຊັບດີເອນ. ຮັບຜິດຊອບ​ທະຫານ​ຊາວສີ່​ພັນ​ຄົນ. <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />ລາວ​ເປັນ​ເຊື້ອສາຍ​ຂອງ​ເປເຣັດ ແລະ ເປັນ​ຫົວໜ້າ​ນາຍ​ທະຫານ​ທັງໝົດ​ໃນ​ເດືອນ​ທີ​ໜຶ່ງ.<verse eid="1CH 27:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4" />ຜູ້ບັນຊາການ ທີ່​ຮັບຜິດຊອບ​ໃນ​ເດືອນ​ທີ​ສອງ​ແມ່ນ​ໂດດາຍ ຊາວ​ອາໂຮ; ມີກໂລດ​ເປັນ​ຜູ້ນໍາ​ຂອງ​ໝວດ​ລາວ ມີ​ທະຫານ​ຊາວສີ່​ພັນ​ຄົນ.<verse eid="1CH 27:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5" />ຜູ້ບັນຊາການ​ຄົນ​ທີ​ສາມ, ທີ່​ຮັບຜິດຊອບ​ໃນ​ເດືອນ​ທີ​ສາມ, ແມ່ນ​ເບນາອີຢາ​ລູກຊາຍ​ຂອງ​ປະໂລຫິດ​ເຢໂຮຍອາດາ; ລາວ​ເປັນ​ຫົວໜ້າ ແລະ ມີ​ທະຫານ​ຊາວ​ສີ່​ພັນ​ຄົນ. <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />ເບນາອີຢາ​ຄົນ​ນີ້​ແມ່ນ​ຜູ້​ທີ່​ເປັນ​ຫົວ​ໜ້າ​ຂອງ​ຍອດ​ນັກຮົບ​ສາມສິບ​ຄົນ. ລູກຊາຍ​ຂອງ​ລາວ​ແມ່ນ​ອຳມີຊາບັດ​ເປັນ​ຜູ້ບັນຊາການ​ຂອງ​ໝວດ​ນີ້​ແທນ​ພໍ່​ຂອງ​ຕົນ.<verse eid="1CH 27:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7" />ຜູ້ບັນຊາການ​ຄົນ​ທີ​ສີ່, ທີ່​ຮັບຜິດຊອບ​ໃນ​ເດືອນ​ທີ​ສີ່, ແມ່ນ​ອາສາເຮນ​ນ້ອງຊາຍ​ຂອງ​ໂຢອາບ; ເຊບາດີຢາ​ເປັນ​ລູກຊາຍ​ຂອງ​ລາວ​ໄດ້​ຂຶ້ນ​ແທນ​ພໍ່​ຂອງ​ຕົນ. ມີ​ທະຫານ​ຊາວສີ່​ພັນ​ຄົນ.<verse eid="1CH 27:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8" />ຜູ້ບັນຊາການ​ຄົນ​ທີ​ຫ້າ, ທີ່​ຮັບຜິດຊອບ​ໃນ​ເດືອນ​ທີ​ຫ້າ, ແມ່ນ​ຊາມຮູດ​ຊາວ​ອີຊະຣາ. ມີ​ທະຫານ​ຊາວສີ່​ພັນ​ຄົນ.<verse eid="1CH 27:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9" />ຜູ້​ບັນຊາການ​ຄົນ​ທີຫົກ, ທີ່​ຮັບຜິດຊອບ​ໃນ​ເດືອນ​ທີ​ຫົກ, ແມ່ນ​ອີຣາ​ລູກຊາຍ​ຂອງ​ອິກເກັດ ຊາວ​ເຕກົວ. ມີ​ທະຫານ​ຊາວສີ່​ພັນ​ຄົນ.<verse eid="1CH 27:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10" />ຜູ້​ບັນຊາການ​ຄົນ​ທີ​ເຈັດ, ທີ່​ຮັບຜິດຊອບ​ໃນ​ເດືອນ​ທີ​ເຈັດ, ແມ່ນ​ເຮເລັດ​ຊາວ​ເອຟຣາອິມ. ຈາກ​ເມືອງ​ເປໂລນ. ມີ​ທະຫານ​ຊາວສີ່​ພັນ​ຄົນ.<verse eid="1CH 27:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11" />ຜູ້ບັນຊາການ​ຄົນ​ທີ​ແປດ, ທີ່​ຮັບຜິດຊອບ​ໃນ​ເດືອນທີ​ແປດ, ແມ່ນ​ສິບເບກາຍ ຊາວ​ຮູຊາ, ໃນ​ຕະກຸນ​ເຊຣາ. ມີ​ທະຫານ​ຊາວສີ່​ພັນ​ຄົນ.<verse eid="1CH 27:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12" />ຜູ້ບັນຊາການ​ຄົນ​ທີ​ເກົ້າ, ທີ່​ຮັບຜິດຊອບ​ໃນ​ເດືອນ​ທີ​ເກົ້າ, ແມ່ນ​ອາບີເອເຊ​ຊາວ​ອານາທົດ, ໃນ​ເຜົ່າ​ເບັນຢາມິນ. ມີ​ທະຫານ​ຊາວສີ່​ພັນ​ຄົນ.<verse eid="1CH 27:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13" />ຜູ້ບັນຊາການ​ຄົນ​ທີ​ສິບ, ທີ່​ຮັບຜິດຊອບ​ໃນ​ເດືອນ​ທີ​ສິບ, ແມ່ນ​ມະຫາໄຣ​ຊາວ​ເນໂຕຟາ, ໃນ​ຕະກຸນ​ເຊຣາ. ມີ​ທະຫານ​ຊາວສີ່​ພັນ​ຄົນ.<verse eid="1CH 27:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 27:14" />ຜູ້ບັນຊາການ​ຄົນ​ທີ​ສິບ​ເອັດ, ທີ່​ຮັບຜິດຊອບ​ໃນ​ເດືອນ​ທີ​ສິບ​ເອັດ, ແມ່ນ​ເບນາອີຢາ ຊາວ​ປີຣາໂທນ, ໃນ​ເຜົ່າ​ເອຟຣາອິມ. ມີ​ທະຫານ​ຊາວສີ່​ພັນ​ຄົນ.<verse eid="1CH 27:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15" />ຜູ້ບັນຊາການ​ຄົນ​ທີ​ສິບ​ສອງ, ທີ່​ຮັບຜິດຊອບ​ໃນ​ເດືອນ​ທີ​ສິບສອງ, ແມ່ນ​ເຮນດາອີ ຊາວ​ເນໂຕຟາ, ຈາກ​ຄອບຄົວ​ຂອງ​ໂອດນີເອນ. ມີ​ທະຫານ​ຊາວສີ່​ພັນ​ຄົນ.<verse eid="1CH 27:15" /></para>
  <para style="s1">ບັນດາ​ຜູ້ນໍາ​ຂອງ​ເຜົ່າ​ຕ່າງໆ</para>
  <para style="lh">
    <verse number="16" style="v" sid="1CH 27:16" />ບັນດາ​ຜູ້ນໍາ​ຂອງ​ເຜົ່າ​ຕ່າງໆ​ຂອງ​ອິດສະຣາເອນ​ມີ​ດັ່ງນີ້:</para>
  <para style="b" vid="1CH 27:16" />
  <para style="li1" vid="1CH 27:16">ເອລີເອເຊ​ລູກຊາຍ​ຂອງ​ຊີກະຣີ​ປົກຄອງ​ເຜົ່າ​ຣູເບັນ:</para>
  <para style="li1" vid="1CH 27:16">ເຊຟາຕີຢາ​ລູກຊາຍ​ຂອງ​ມາອາກາ​ປົກຄອງ​ເຜົ່າ​ຊີເມໂອນ;<verse eid="1CH 27:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17" />ຮາຊາບີຢາ​ລູກຊາຍ​ຂອງ​ເກມູເອນ​ປົກຄອງ​ເຜົ່າ​ເລວີ;</para>
  <para style="li1" vid="1CH 27:17">ຊາດົກ​ປົກຄອງ​ເຊື້ອ​ສາຍ​ຂອງ​ອາໂຣນ;<verse eid="1CH 27:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18" />ເອລີຮູ​ອ້າຍ​ຂອງ​ດາວິດ​ປົກຄອງ​ເຜົ່າ​ຢູດາ;</para>
  <para style="li1" vid="1CH 27:18">ອົມຣິ​ລູກຊາຍ​ຂອງ​ມີກາເອນ​ປົກຄອງ​ເຜົ່າ​ອິດຊາຄາ;<verse eid="1CH 27:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19" />ອີຊະມາອີຢາ​ລູກຊາຍ​ຂອງ​ໂອບາດີຢາ​ປົກຄອງ​ເຜົ່າ​ເຊບູໂລນ;</para>
  <para style="li1" vid="1CH 27:19">ເຢຣີໂມດ​ລູກຊາຍ​ຂອງ​ອາຊະຣີເອນ​ປົກຄອງ​ເຜົ່າ​ເນັບທາລີ;<verse eid="1CH 27:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20" />ໂຮເຊອາ​ລູກຊາຍ​ຂອງ​ອາຊາຊີຢາ​ປົກຄອງ​ເຜົ່າ​ເອຟຣາອິມ;</para>
  <para style="li1" vid="1CH 27:20">ໂຢເອນ​ລູກຊາຍ​ຂອງ​ເປດາອີຢາ​ປົກຄອງ​ເຜົ່າ​ມານາເຊ​ເຄິ່ງ​ເຜົ່າ;<verse eid="1CH 27:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21" />ອິດໂດ​ລູກຊາຍ​ຂອງ​ເຊກາຣີຢາ​ປົກຄອງ​ເຜົ່າ​ມານາເຊ​ເຄິ່ງ​ເຜົ່າ​ໃນ​ກີເລອາດ;</para>
  <para style="li1" vid="1CH 27:21">ຢາອາສີເອນ​ລູກຊາຍ​ຂອງ​ອັບເນ​ປົກຄອງ​ເຜົ່າ​ເບັນຢາມິນ;<verse eid="1CH 27:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22" />ອາຊາເຣນ​ລູກຊາຍ​ຂອງ​ເຢໂຣຮາມ​ປົກຄອງ​ເຜົ່າ​ດານ.</para>
  <para style="b" vid="1CH 27:22" />
  <para style="lf" vid="1CH 27:22">ຄົນ​ເຫລົ່ານີ້​ແມ່ນ​ບັນດາ​ຜູ້ນໍາ​ເຜົ່າ​ຕ່າງໆ​ຂອງ​ອິດສະຣາເອນ.<verse eid="1CH 27:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23" />ດາວິດ​ບໍ່​ໄດ້​ນັບ​ຈຳນວນ​ຄົນ​ທີ່​ມີ​ອາຍຸ​ຊາວ​ປີ​ລົງ​ມາ ຫລື ຕໍ່າ​ກວ່າ​ຊາວ​ປີ, ເພາະ​ພຣະເຈົ້າຢາເວ​ໄດ້​ສັນຍາ​ວ່າ​ຈະ​ເຮັດ​ໃຫ້​ອິດສະຣາເອນ​ມີ​ຈໍານວນ​ຫລວງຫລາຍ​ເໝືອນ​ດັ່ງ​ດວງດາວ​ໃນ​ທ້ອງ​ຟ້າ <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />ໂຢອາບ ລູກຊາຍ​ຂອງ​ນາງ​ເຊຣູອີຢາ​ເລີ່ມ​ນັບ​ຈຳນວນ​ຄົນ ແຕ່​ເຮັດ​ບໍ່​ສຳເລັດ. ຄວາມ​ໂກດຮ້າຍ​ຂອງ​ພຣະເຈົ້າ​ໄດ້​ຕົກ​ໃສ່​ອິດສະຣາເອນ ເພາະ​ການ​ນັບ​ຈຳນວນ​ຄົນ​ຄັ້ງ​ນີ້, ແລະ ຈໍານວນ​ບໍ່ໄດ້​ບັນທຶກ​ໃນ​ໜັງສື​ທາງການ​ຂອງ​ກະສັດ​ດາວິດ.<verse eid="1CH 27:24" /></para>
  <para style="s1">ບັນດາ​ຜູ້ດູແລ​ຂອງ​ກະສັດ</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 27:25" />ອາຊະມາເວດ​ລູກຊາຍ​ຂອງ​ອາດີເອນ​ຮັບຜິດຊອບ​ຫ້ອງເກັບເຄື່ອງ​ຂອງ​ກະສັດ.</para>
  <para style="li1" vid="1CH 27:25">ໂຢນາທານ​ລູກຊາຍ​ຂອງ​ອຸດຊີອາ​ຮັບຜິດຊອບ​ຫ້ອງເກັບເຄື່ອງ​ຕ່າງໆ​ຕາມ​ນອກ​ເມືອງ, ໃນເມືອງ, ໝູ່ບ້ານ ແລະ ຫໍ​ຄອຍ​ຕ່າງໆ.<verse eid="1CH 27:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 27:26" />ເອຊະຣີ​ລູກຊາຍ​ຂອງ​ເກລຸບ​ຮັບຜິດຊອບ​ຄົນ​ເຮັດວຽກ​ໃນ​ນາ.<verse eid="1CH 27:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 27:27" />ຊີເມອີ​ຊາວ​ເມືອງ​ຣາມາ​ຮັບຜິດຊອບ​ສວນ​ອະງຸ່ນ</para>
  <para style="li1" vid="1CH 27:27">ຊັບດີ​ຊາວ​ເມືອງ​ເຊຟາມ​ຮັບຜິດຊອບ​ຜົນຜະລິດ​ຈາກ​ສວນ​ອະງຸ່ນ​ສຳລັບ​ຫ້ອງ​ເກັບ​ເຫລົ້າ​ອະງຸ່ນ<verse eid="1CH 27:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 27:28" />ບາອານຮານານ​ຊາວ​ເກເດ​ຮັບຜິດຊອບ​ສວນ​ໝາກກອກ​ເທບ ແລະ ໝາກເດື່ອ​ທີ່​ຕີນ​ພູ​ດ້ານ​ທິດ​ຕາເວັນຕົກ.</para>
  <para style="li1" vid="1CH 27:28">ໂຢອາດ​ຮັບຜິດຊອບ​ການ​ຈັດ​ຫາ​ນ້ຳ​ມັນ​ໝາກກອກເທດ.<verse eid="1CH 27:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 27:29" />ຊິດໄຣ​ຊາວ​ຊາໂຣນ​ຮັບຜິດຊອບ​ລ້ຽງ​ສັດ​ໃນ​ທົ່ງຫຍ້າ​ຊາໂຣນ.</para>
  <para style="li1" vid="1CH 27:29">ຊາຟັດ​ລູກຊາຍ​ຂອງ​ອັດໄລ​ຮັບຜິດຊອບ​ລ້ຽງ​ຝູງສັດ​ໃນ​ຮ່ອມພູ​ຕ່າງໆ.<verse eid="1CH 27:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 27:30" />ໂອບິນ​ຊາວ​ອິດຊະມາເອນ​ຮັບຜິດຊອບ​ຝູງ​ອູດ.</para>
  <para style="li1" vid="1CH 27:30">ເຢເດອີຢາ​ຊາວ​ເມໂລໂນດ​ຮັບຜິດຊອບ​ຝູງ​ລໍ.<verse eid="1CH 27:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 27:31" />ຢາຊິດ​ຊາວ​ເມືອງ​ຮັກກິດ​ຮັບຜິດຊອບ​ຝູງ​ແກະ.</para>
  <para style="lf" vid="1CH 27:31">ຄົນ​ເຫລົ່ານີ້​ເປັນ​ຜູ້ດູແລ​ຮັບຜິດຊອບ​ຊັບສົມບັດ​ຂອງ​ກະສັດ​ດາວິດ.<verse eid="1CH 27:31" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="32" style="v" sid="1CH 27:32" />ໂຢນາທານ​ລຸງ​ຂອງ​ດາວິດ​ເປັນ​ທີ່ປຶກສາ​ເປັນ​ຜູ້​ມີ​ຄວາມ​ເຂົ້າໃຈ​ເລິກ​ເຊິ່ງ ແລະ ເປັນ​ນັກສືກສາ​ຄົ້ນຄວ້າ. ເຢຮີເອນ​ລູກຊາຍ​ຂອງ​ຮັກໂມນີ</para>
  <para style="li1" vid="1CH 27:32">ເບິ່ງແຍງ​ບັນດາ​ລູກຊາຍ​ຂອງ​ກະສັດ.<verse eid="1CH 27:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 27:33" />ອາຮີໂຕເຟນ​ເປັນ​ທີ່​ປຶກສາ​ຂອງ​ດາວິດ</para>
  <para style="li1" vid="1CH 27:33">ແລະ ຮູຊາຍ​ຊາວ​ອາກກິດ​ເປັນ​ທີ່​ປຶກສາ​ສ່ວນຕົວ​ຂອງ​ກະສັດ.<verse eid="1CH 27:33" /></para>
  <para style="lf">
    <verse number="34" style="v" sid="1CH 27:34" />ເຢໂຮຍອາດາ​ລູກຊາຍ​ຂອງ​ເບນາອີຢາ ແລະ ອາບີອາທາ​ເປັນ​ຜູ້ສືບທອດ​ແທນ​ອາຮີໂຕເຟນ.</para>
  <para style="li1" vid="1CH 27:34">ສ່ວນ​ໂຢອາບ​ເປັນ​ຜູ້ບັນຊາການ​ທະຫານ​ສູງສຸດ.<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s1">ແຜນການ​ຂອງ​ດາວິດ​ໃນ​ການ​ສ້າງ​ວິຫານ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />ດາວິດ​ເອີ້ນ​ຂ້າລາຊະການ​ທັງໝົດ​ຂອງ​ອິດສະຣາເອນ​ໃຫ້​ຊຸມນຸມ​ກັນ​ທີ່​ເຢຣູຊາເລັມ​ຄື: ຂ້າລາຊະການ​ທີ່​ປົກຄອງ​ເຜົ່າ​ຕ່າງໆ, ບັນດາ​ຜູ້ບັນຊາການ​ໝວດ​ຕ່າງໆ​ໃນ​ການ​ຮັບໃຊ້​ກະສັດ, ຜູ້ບັນຊາການ​ກອງພັນ ແລະ ບັນດາ​ຜູ້ບັນຊາການ​ກອງຮ້ອຍ, ຜູ້ດູແລ​ຮັບຜິດຊອບ​ຊັບສົມບັດ​ທັງໝົດ ແລະ ສັດ​ຕ່າງໆ​ທີ່​ເປັນ​ຂອງ​ກະສັດ ແລະ ຂອງ​ລູກຊາຍ​ຂອງ​ເພິ່ນ, ພ້ອມທັງ​ຂ້າ​ຣາຊການ​ໃນ​ວັງ, ບັນດາ​ນັກສູ້ຮົບ ແລະ ພວກ​ທະຫານ​ທີ່​ກ້າຫານ.<verse eid="1CH 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2" />ດາວິດ​ໄດ້​ລຸກ​ຢືນ​ຂຶ້ນ ແລະ ກ່າວ​ວ່າ: “ພີ່ນ້ອງ​ຊາວ​ອິດສະຣາເອນ​ທັງຫລາຍ​ຂອງ​ຂ້າພະເຈົ້າ, ຈົ່ງ​ຟັງ​ຂ້າພະເຈົ້າ, ປະຊາຊົນ​ຂອງ​ຂ້າພະເຈົ້າ. ຂ້າພະເຈົ້າ​ຕັ້ງໃຈ​ຈະ​ສ້າງ​ວິຫານ​ເພື່ອ​ເປັນ​ບ່ອນ​ໄວ້​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າຢາເວ ແລະ ເປັນ​ບ່ອນ​ຮອງ​ຕີນ​ພຣະເຈົ້າ​ຂອງ​ພວກເຮົາ, ແລະ ຂ້າພະເຈົ້າ​ໄດ້​ຈັດຕຽມ​ການ​ກໍ່ສ້າງ​ໄວ້​ແລ້ວ. <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />ແຕ່​ພຣະເຈົ້າ​ໄດ້ກ່າວ​ແກ່​ຂ້າພະເຈົ້າ​ວ່າ, ‘ເຈົ້າ​ຈະ​ສ້າງ​ວິຫານ​ສຳລັບ​ນາມຊື່​ຂອງ​ເຮົາ​ບໍ່​ໄດ້, ເພາະ​ເຈົ້າ​ເປັນ​ນັກຮົບ ແລະ ໄດ້​ເຮັດ​ໃຫ້​ເລືອດ​ຕົກ​ຢ່າງ​ຫລວງຫລາຍ’.<verse eid="1CH 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4" />“ແຕ່​ພຣະເຈົ້າ​ຢາ​ເວ, ພຣະເຈົ້າ​ແຫ່ງ​ອິດສະຣາເອນ​ໄດ້​ເລືອກ​ຂ້າພະເຈົ້າ​ຈາກ​ຄົນ​ທັງໝົດ​ໃນ​ຄອບຄົວ​ຂອງ​ຂ້າພະເຈົ້າ​ໃຫ້​ຂຶ້ນ​ມາ​ເປັນ​ກະສັດ​ປົກຄອງ​ອິດສະຣາເອນ​ຕະຫລອດ​ໄປ. ພຣະອົງໄດ້​ເລືອກ​ຕະກຸນ​ຢູດາ​ເປັນ​ຜູ້ນຳ ແລະ ຈາກ​ເຜົ່າ​ຢູດາ​ໄດ້​ເລືອກ​ຄອບຄົວ​ຂອງ​ຂ້າພະເຈົ້າ, ແລະ ຈາກ​ບັນດາ​ລູກຊາຍ​ຂອງ​ພໍ່​ຂອງ​ຂ້າພະເຈົ້າ ພຣະອົງ​ພໍໃຈ​ທີ່​ຈະ​ແຕ່ງຕັ້ງ​ຂ້າພະເຈົ້າ​ເປັນ​ກະສັດ​ປົກຄອງ​ເໜືອ​ອິດສະຣາເອນ​ທັງໝົດ. <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />ສ່ວນ​ບັນດາ​ລູກຊາຍ​ຂອງ​ຂ້າພະເຈົ້າ, ພຣະເຈົ້າຢາເວ​ໄດ້​ໃຫ້​ຂ້າພະເຈົ້າ​ມີ​ລູກຊາຍ​ຫລວງຫລາຍ ພຣະອົງ​ໄດ້​ເລືອກ​ເອົາ​ໂຊໂລໂມນ​ໃຫ້​ຂຶ້ນ​ນັ່ງ​ເທິງ​ບັນລັງ​ແຫ່ງ​ອານາຈັກ​ຂອງ​ພຣະເຈົ້າຢາເວ ປົກຄອງ​ອິດສະຣາເອນ. <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />ພຣະອົງ​ກ່າວ​ກັບ​ຂ້າພະເຈົ້າ​ວ່າ: ‘ໂຊໂລໂມນ​ລູກຊາຍ​ຂອງ​ເຈົ້າ ເປັນ​ຜູ້​ທີ່​ຈະ​ສ້າງ​ວິຫານ​ຂອງ​ເຮົາ ແລະ ເດີ່ນ​ວິຫານ​ຂອງ​ເຮົາ, ເພາະ​ເຮົາ​ໄດ້​ເລືອກເອົາ​ລາວ​ໃຫ້​ເປັນ​ລູກຊາຍ​ຂອງ​ເຮົາ ແລະ ເຮົາ​ຈະ​ເປັນ​ພໍ່​ຂອງ​ລາວ. <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />ເຮົາ​ຈະ​ຕັ້ງ​ອານາຈັກ​ຂອງ​ລາວ​ໃຫ້​ໝັ້ນຄົງ​ຢູ່​ຕະຫລອດ​ໄປ ຖ້າ​ລາວ​ບໍ່​ຫັນໜີ​ຈາກ​ການ​ປະຕິບັດ​ຕາມ​ກົດບັນຍັດ ແລະ ຄຳສັ່ງ​ຂອງ​ເຮົາ, ດັ່ງ​ທີ່​ລາວ​ປະຕິບັດ​ຢູ່​ໃນ​ເວລາ​ນີ້’.<verse eid="1CH 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8" />“ສະນັ້ນ ບັດນີ້​ຂ້າພະເຈົ້າ​ຂໍ​ສັ່ງ​ພວກເຈົ້າ​ຕໍ່ໜ້າ​ປະຊາຊົນ​ອິດສະຣາເອນ​ທັງໝົດ ແລະ ຕໍ່ໜ້າ​ທີ່​ປະຊຸມ​ຂອງ​ພຣະເຈົ້າຢາເວ, ແລະ ຕໍ່ໜ້າ​ພຣະເຈົ້າ​ຂອງ​ພວກເຮົາ​ວ່າ: ຈົ່ງ​ເອົາໃຈໃສ່​ປະຕິບັດ​ຕາມ​ຂໍ້​ຄໍາສັ່ງ​ທຸກ​ປະການ​ຂອງ​ພຣະເຈົ້າຢາເວ ພຣະເຈົ້າ​ຂອງ​ພວກເຈົ້າ, ເພື່ອ​ພວກເຈົ້າ​ຈະ​ໄດ້​ຄອບຄອງ​ດິນແດນ​ອັນ​ອຸດົມສົມບູນ​ນີ້ ແລະ ສືບທອດ​ເປັນ​ມໍລະດົກ​ແກ່​ເຊື້ອສາຍ​ຂອງ​ພວກເຈົ້າ​ຕະຫລອດໄປ.<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />“ແລະ ເຈົ້າ, ໂຊໂລໂມນ​ລູກ​ຂອງ​ພໍ່, ຈົ່ງ​ຍອມ​ຮັບຮູ້​ພຣະເຈົ້າ​ຂອງ​ພໍ່ ແລະ ຈົ່ງ​ບົວລະບັດ​ຮັບໃຊ້​ພຣະອົງ​ດ້ວຍ​ການ​ອຸທິດຕົນ​ຢ່າງ​ສຸດໃຈ ແລະ ດ້ວຍ​ສຸດ​ຄວາມຄິດ​ຢ່າງ​ເຕັມໃຈ, ເພາະ​ພຣະເຈົ້າຢາເວ​ສະແຫວງຫາ​ໝົດ​ທັງ​ຫົວໃຈ ແລະ ເຂົ້າໃຈ​ທຸກ​ຄວາມ​ປາຖະໜາ ແລະ ຄວາມຄິດ​ທຸກ​ຢ່າງ. ຖ້າ​ເຈົ້າ​ສະແຫວງຫາ​ພຣະອົງ, ເຈົ້າ​ກໍ​ຈະ​ພົບ​ພຣະອົງ; ແຕ່​ຖ້າ​ເຈົ້າ​ປະຖິ້ມ​ພຣະອົງ ພຣະອົງ​ກໍ​ຈະ​ປະຕິເສດ​ເຈົ້າ​ຕະຫລອດໄປ. <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />ບັດນີ້ ຈົ່ງ​ຕຶກຕອງ​ເບິ່ງ, ເພາະ​ພຣະເຈົ້າຢາເວ​ໄດ້​ເລືອກ​ເອົາ​ເຈົ້າ​ໃຫ້​ເປັນ​ຜູ້ສ້າງ​ວິຫານ​ເປັນ​ບ່ອນ​ສັກສິດ. ຈົ່ງ​ເຂັ້ມແຂງ ແລະ ເຮັດວຽກ​ນີ້​ເທີ້ນ”.<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />ແລ້ວ​ດາວິດ​ໄດ້​ມອບ​ແຜນຜັງ​ການ​ກໍ່ສ້າງ​ວິຫານ ແລະ ແຜນຜັງ​ຕຶກ​ອາຄານ​ສ່ວນ​ຕ່າງໆ, ຫ້ອງ​ເກັບ​ເຄື່ອງ​ຕ່າງໆ, ຫ້ອງ​ຊັ້ນ​ເທິງ, ຫ້ອງ​ຊັ້ນ​ໃນ ແລະ ຫ້ອງ​ສຳລັບ​ທີ່​ນັ່ງ​ແຫ່ງ​ພຣະຄຸນ​ສຳລັບ​ໂຊໂລໂມນ. <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />ເພິ່ນ​ໄດ້​ມອບ​ແຜນຜັງ​ທັງໝົດ​ທີ່​ພຣະວິນຍານ​ໄດ້​ໃຫ້​ໃນ​ຄວາມຄິດ​ຂອງ​ເພິ່ນ​ສຳລັບ​ລະບຽງ​ທີ່​ຢູ່​ທາງ​ດ້ານໜ້າ​ຂອງ​ວິຫານ​ຂອງ​ພຣະເຈົ້າຢາເວ ແລະ ຫ້ອງ​ຕ່າງໆ​ທີ່​ອ້ອມຮອບ ເພື່ອ​ເກັບ​ຊັບສົມບັດ​ຂອງ​ວິຫານ​ຂອງ​ພຣະເຈົ້າຢາເວ​ໄວ້ ແລະ ສິ່ງຂອງ​ຕ່າງໆ​ທີ່​ນຳ​ມາ​ອຸທິດຖວາຍ. <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />ເພິ່ນ​ໄດ້​ມອບ​ຄໍາແນະນໍາ​ໃຫ້​ໂຊໂລໂມນ​ກ່ຽວກັບ​ການ​ແບ່ງ​ໜ້າທີ່​ຂອງ​ບັນດາ​ປະໂລຫິດ ແລະ ຂອງ​ພວກເລວີ ແລະ ວຽກງານ​ທັງໝົດ​ກ່ຽວກັບ​ການ​ຮັບໃຊ້​ໃນ​ວິຫານ​ຂອງ​ພຣະເຈົ້າຢາເວ, ຕະຫຼອດ​ຈົນ​ເຖິງ​ເຄື່ອງໃຊ້​ທຸກ​ຢ່າງ​ທີ່​ໃຊ້​ໃນ​ວິຫານ. <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />ເພິ່ນ​ໄດ້​ກຳນົດ​ນ້ຳໜັກ​ຄໍາ ແລະ ເງິນ​ເພື່ອ​ເຮັດ​ເຄື່ອງໃຊ້​ປະເພດ​ຕ່າງໆ​ຄື <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />ນ້ຳ​ໜັກ​ຄຳ​ສຳລັບ​ເຮັດ​ຕີນ​ຮອງ​ຕະກຽງ​ຄໍາ ແລະ ໜ່ວຍຕະກຽງ ພ້ອມທັງ​ນ້ຳໜັກ​ຂອງ​ຕີນ​ຕະກຽງ ແລະ ໜ່ວຍຕະກຽງ; ນ້ຳ​ໜັກ​ເງິນ​ສຳລັບ​ເຮັດຕີນ​ຕະກຽງ​ເງິນ ແລະ ໜ່ວຍຕະກຽງ​ແຕ່ລະ​ໜ່ວຍ​ຕາມ​ການ​ນໍາ​ໃຊ້​ຂອງ​ຕະກຽງ​ແຕ່​ລະ​ໜ່ວຍ. <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />ນ້ຳໜັກ​ຄຳ​ສຳລັບ​ເຮັດ​ໂຕະ​ແຕ່ລະ​ໜ່ວຍ​ເພື່ອ​ວາງ​ເຂົ້າຈີ່​ສັກສິດ; ນ້ຳໜັກ​ເງິນ​ສຳລັບ​ເຮັດ​ໂຕະ​ເງິນ. <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />ນ້ຳໜັກ​ຄຳ​ສົດ​ສຳລັບ​ເຮັດສ້ອມ​ຖ້ວຍ ແລະ ໂຖນໍ້າ; ນ້ຳໜັກ​ຄຳ​ສໍາລັບ​ເຮັດ​ຈານ​ຄໍາ ແລະ ຈານ​ເງິນ​ແຕ່ລະ​ໃບ; <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />ແລະ ນ້ຳ​ໜັກ​ຄໍາ​ຫລອມ​ບໍລິສຸດ​ສຳລັບ​ເຮັດ​ແທ່ນບູຊາ. ເພື່ອ​ເຜົາ​ເຄື່ອງຫອມ. ເພິ່ນ​ຍັງ​ໄດ້​ເອົາ​ແຜນຜັງ​ເຮັດ​ລົດມ້າ ທີ່​ເປັນ​ຮູບ​ເຄຣຸບ​ຄຳ​ທີ່​ພື​ປີກ​ຂອງ​ພວກມັນ​ອອກ​ປົກ​ຫີບ​ຄໍາໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າຢາເວ.<verse eid="1CH 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19" />ດາວິດ​ໄດ້​ເວົ້າ​ວ່າ, “ທັງໝົດ​ນີ້​ເຮົາ​ໄດ້​ຂຽນ​ດ້ວຍ​ມື​ຂອງ​ພຣະເຈົ້າຢາເວ​ຢູ່​ເໜືອ​ເຮົາ ແລະ ເຮັດ​ໃຫ້​ເຮົາ​ມີ​ຄວາມ​ເຂົ້າໃຈ​ໃນ​ລາຍລະອຽດ​ທັງໝົດ​ຂອງ​ແຜນການ”.<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />ດາວິດ​ກ່າວ​ກັບ​ໂຊໂລໂມນ​ລູກຊາຍ​ຂອງ​ເພິ່ນ​ອີກ​ວ່າ, “ຈົ່ງ​ເຂັ້ມແຂງ ແລະ ກ້າຫານ, ແລະ ຈົ່ງ​ລົງມື​ເຮັດ​ວຽກ. ຢ່າ​ຢ້ານ ຫລື ທໍ້ຖອຍ​ໃຈ, ເພາະ​ພຣະເຈົ້າ​ຢາເວ, ພຣະເຈົ້າ​ຂອງ​ເຮົາ​ສະຖິດ​ຢູ່​ກັບ​ເຈົ້າ. ພຣະອົງ​ຈະ​ບໍ່​ເຮັດ​ໃຫ້​ເຈົ້າ​ຜິດຫວັງ ຫລື ປະຖິ້ມ​ເຈົ້າ ຈົນກວ່າ​ວຽກ​ທຸກ​ຢ່າງ​ເພື່ອ​ຮັບໃຊ້​ໃນ​ວິຫານ​ຂອງ​ພຣະເຈົ້າຢາເວ​ຈະ​ສຳເລັດ. <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />ການ​ແບ່ງ​ໜ້າທີ່​ຂອງ​ບັນດາ​ປະໂລຫິດ ແລະ ຄົນ​ເລວີ​ພ້ອມ​ແລ້ວ​ສຳລັບ​ວຽກງານ​ທັງໝົດ​ກ່ຽວກັບ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ, ແລະ ຊ່າງສີມື​ທຸກ​ຄົນ​ກໍ​ເຕັມໃຈ​ທີ່​ຈະ​ຊ່ວຍ​ເຈົ້າ​ໃນ​ວຽກງານ​ທັງໝົດ. ບັນດາ​ຂ້າລາຊະການ ແລະ ປະຊາຊົນ​ທັງປວງ​ຈະ​ຟັງ​ຄຳສັ່ງ​ຂອງ​ເຈົ້າ​ທຸກ​ປະການ”.<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s1">ເຄື່ອງ​ຖວາຍ​ສຳລັບ​ສ້າງ​ວິຫານ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />ຈາກນັ້ນ ກະສັດ​ດາວິດ​ກ່າວ​ຕໍ່​ທີ່​ປະຊຸມ​ທັງໝົດ​ວ່າ: “ໂຊໂລໂມນ​ລູກຊາຍ​ຂອງ​ພໍ່, ຜູ້​ທີ່​ພຣະເຈົ້າ​ໄດ້​ເລືອກ​ໄວ້, ຍັງ​ໜຸ່ມ ແລະ ຂາດ​ປະສົບການ. ວຽກງານ​ກໍ​ໃຫຍ່​ຫລາຍ, ເພາະ​ສິ່ງ​ກໍ່ສ້າງ​ທີ່​ຍິ່ງໃຫຍ່​ນີ້​ບໍ່​ແມ່ນ​ສ້າງ​ຂຶ້ນ​ເພື່ອ​ມະນຸດ ແຕ່​ສຳລັບ​ພຣະເຈົ້າຢາເວ ພຣະເຈົ້າ. <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />ຂ້າພະເຈົ້າ​ໄດ້​ຈັດຕຽມ​ຊັບພະຍາກອນ​ຕ່າງໆ​ໄວ້​ສຸດ​ຄວາມ​ສາມາດ​ສຳລັບ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ​ຄື: ຄຳ, ເງິນ, ທອງສຳລິດ, ເຫລັກ, ໄມ້, ຫີນ​ມີ​ຄ່າ, ພອຍ​ສີຟ້າ<note caller="+" style="f"><char style="fr" closed="false">29:2 </char><char style="ft" closed="false">ໃນ​ພາສາ​ເຮັບເຣີ​ຄຳ​ນີ້​ມີ​ຄວາມຫມາຍ​ບໍ່​ຊັດເຈນ</char></note> ສຳລັບ​ປະດັບປະດາ ແລະ ຫີນລາຍ​ສີ​ຕ່າງໆ ແລະ ຫີນອ່ອນ​ເປັນ​ຈຳນວນ​ຫລວງຫລາຍ. <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />ນອກຈາກ​ສິ່ງ​ທັງໝົດ​ນີ້, ໃນ​ການ​ອຸທິດຕົວ​ຂອງ​ຂ້າພະເຈົ້າ​ເພື່ອ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ. ບັດນີ້ ຂ້າພະເຈົ້າ​ຂໍ​ມອບ​ຄໍາ ແລະ ເງິນ ທີ່​ເປັນ​ຊັບສົມບັດ​ສ່ວນຕົວ​ຂອງ​ຂ້າພະເຈົ້າ​ເພື່ອ​ການ​ກໍ່ສ້າງ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ, ນອກຈາກ​ສິ່ງ​ທັງປວງ​ນີ້​ແລ້ວ ຂ້າພະເຈົ້າ​ໄດ້​ຈັດຕຽມ​ສິ່ງ​ນີ້ໄວ້​ສໍາລັບ​ວິຫານ​ອັນ​ສັກສິດ​ນີ້​ຄື: <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />ຄຳ​ສາມພັນ​ຕະລັນຕົນ<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ 3.000 ຕະລັນຕົນ</char></note> (ຄຳ​ຈາກ​ໂອຟີ) ແລະ ເງິນ​ບໍລິສຸດ​ເຈັດ​ພັນ​ຕະລັນຕົນ<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ 7.000 ຕະລັນຕົນ</char></note> ສຳລັບ​ໃຊ້​ຕົບແຕ່ງ​ຝາ​ຂອງ​ວິຫານ, <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />ສຳລັບ​ສິ່ງຂອງ​ຕ່າງ​ທີ່​ເຮັດ​ດ້ວຍ​ຄໍາ ແລະ ເງິນ​ແມ່ນ​ພວກ​ຊ່າງສີມື​ຈະ​ລົງ​ມື​ເຮັດ. ບັດນີ້ ມີ​ຜູ້ໃດ​ແດ່​ທີ່​ເຕັມໃຈ​ຈະ​ອຸທິດ​ຕົນເອງ​ແກ່​ພຣະເຈົ້າຢາເວ​ໃນ​ມື້ນີ້?”<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />ບັນດາ​ຜູ້ນຳ​ຂອງ​ຕະກຸນ​ຕ່າງໆ, ບັນດາ​ເຈົ້າໜ້າທີ່​ຂອງ​ເຜົ່າ​ຕ່າງໆ​ຂອງ​ອິດສະຣາເອນ, ບັນດາ​ຜູ້ບັນຊາການ​ກອງພັນ ແລະ ບັນດາ​ຜູ້ບັນຊາການ​ກອງຮ້ອຍ, ແລະ ບັນດາ​ຂ້າລາຊະການ​ຮັບຜິດຊອບ​ວຽກງານ​ຂອງ​ກະສັດ​ຈຶ່ງ​ພາ​ກັນ​ໃຫ້​ດ້ວຍ​ຄວາມ​ເຕັມໃຈ. <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />ພວກເຂົາ​ໄດ້​ມອບ​ຄຳ​ໜັກ 5.000 ຕະລັນຕົນ<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">ປະມານ 190 ໂຕນ</char></note> ກັບ​ອີກ 10.000 ດາລິກ,<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">ປະມານ 84 ກິໂລກຣາມ</char></note> ເງິນ​ໜັກ 10.000 ຕະລັນຕົນ<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">ປະມານ 380 ໂຕນ</char></note> ແລະ ທອງສຳລິດ​ໜັກ 18.000 ຕະລັນຕົນ<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">ປະມານ 675 ໂຕນ</char></note> ແລະ ເຫລັກ​ໜັກ 100.000 ຕະລັນຕົນ.<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">ປະມານ 3.800 ໂຕນ</char></note> <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />ຜູ້ໃດ​ທີ່​ມີ​ເພັດນິນຈິນດາ​ກໍ​ນຳ​ມາ​ຖວາຍ​ທີ່​ຄັງ​ຂອງ​ວິຫານ​ຂອງ​ພຣະເຈົ້າຢາເວ ທີ່​ຢູ່​ໃນ​ການ​ດູແລ​ເບິ່ງແຍງ​ຂອງ​ເຢຮີເອນ​ຊາວເກໂຊນ. <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />ປະຊາຊົນ​ພາ​ກັນ​ຊື່ນຊົມຍິນດີ​ກັບ​ການ​ຕອບ​ສະໜອງ​ຂອງ​ບັນດາ​ຜູ້ນຳ​ຂອງ​ຕົນ, ພວກເຂົາ​ໄດ້​ຖວາຍ​ດ້ວຍ​ຄວາມ​ເຕັມໃຈ ແລະ ຖວາຍ​ດ້ວຍ​ສຸດໃຈ​ແກ່​ພຣະເຈົ້າຢາເວ. ກະສັດ​ດາວິດ​ກໍ​ມີ​ຄວາມ​ຊື່ນຊົມ​ຍິນດີ​ຫລາຍ​ທີ່ສຸດ.<verse eid="1CH 29:9" /></para>
  <para style="s1">ຄຳ​ອະທິຖານ​ຂອງ​ດາວິດ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />ດາວິດ​ໄດ້​ສັນລະເສີນ​ພຣະເຈົ້າຢາເວ​ຕໍ່ໜ້າ​ທີ່​ປະຊຸມ​ທັງຫລາຍ​ວ່າ,</para>
  <para style="q1" vid="1CH 29:10">“ຂ້າ​ແດ່​ພຣະເຈົ້າ​ຢາເວ, ຂໍ​ໃຫ້​ຄໍາ​ສັນລະເສີນ​ເປັນ​ຂອງ​ພຣະອົງ,</para>
  <para style="q2" vid="1CH 29:10">ພຣະເຈົ້າ​ແຫ່ງ​ອິດສະຣາເອນ​ບັນພະບຸລຸດ​ຂອງ​ພວກ​ຂ້ານ້ອຍ</para>
  <para style="q2" vid="1CH 29:10">ຂໍ​ໃຫ້​ຄໍາ​ສັນລະເສີນ​ເປັນ​ຂອງ​ພຣະອົງ​ຕະຫຼອດ​ໄປ.<verse eid="1CH 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11" />ຂ້າ​ແດ່​ພຣະເຈົ້າ​ຢາເວ, ຄວາມ​ຍິ່ງໃຫຍ່, ລິດອໍານາດ ແລະ ອໍານາດ</para>
  <para style="q2" vid="1CH 29:11">ແລະ ສະຫງ່າລາສີ ບາລະມີ ແລະ ຄວາມ​ງາມສະຫງ່າ ຈົ່ງ​ເປັນ​ຂອງ​ພຣະອົງ,</para>
  <para style="q2" vid="1CH 29:11">ທຸກສິ່ງ​ໃນ​ຟ້າ​ສະຫວັນ ແລະ ທີ່​ແຜ່ນດິນ​ໂລກ​ຈົ່ງ​ເປັນ​ຂອງ​ພຣະອົງ.</para>
  <para style="q1" vid="1CH 29:11">ຂ້າ​ແດ່, ພຣະເຈົ້າ​ຢາເວ, ອານາຈັກ​ເປັນ​ຂອງ​ພຣະອົງ;</para>
  <para style="q2" vid="1CH 29:11">ພຣະອົງ​ເປັນ​ທີ່​ຍົກຍ້ອງ​ໃນ​ຖານະ​ກະສັດ​ປົກຄອງ​ເໜືອ​ສັບພະທຸກສິ່ງ.<verse eid="1CH 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12" />ຄວາມ​ຮັ່ງມີ ແລະ ກຽດຕິຍົດ​ມາ​ຈາກ​ພຣະອົງ;</para>
  <para style="q2" vid="1CH 29:12">ພຣະອົງ​ເປັນ​ຜູ້ປົກຄອງ​ເໜືອ​ສັບພະທຸກສິ່ງ.</para>
  <para style="q1" vid="1CH 29:12">ພະລັງ ແລະ ລິດອຳນາດ​ຢູ່​ໃນ​ມື​ຂອງ​ພຣະອົງ</para>
  <para style="q2" vid="1CH 29:12">ເພື່ອ​ຍົກຍ້ອງ ແລະ ໃຫ້​ກຳລັງ​ແກ່​ທຸກຄົນ.<verse eid="1CH 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13" />ຂ້າແດ່, ພຣະເຈົ້າ​ຂອງ​ພວກ​ຂ້ານ້ອຍ, ພວກ​ຂ້ານ້ອຍ​ຂອບຄຸນ​ພຣະອົງ,</para>
  <para style="q2" vid="1CH 29:13">ແລະ ສັນລະເສີນ​ນາມ​ອັນ​ຮຸ່ງເຮືອງ​ຂອງ​ພຣະອົງ.<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />“ແຕ່​ຂ້ານ້ອຍ​ແມ່ນ​ຜູ້ໃດ, ແລະ ປະຊາຊົນ​ຂອງ​ຂ້ານ້ອຍ​ແມ່ນ​ຜູ້ໃດ, ທີ່​ຈະ​ສາມາດ​ຖວາຍ​ແກ່​ພຣະອົງ​ຢ່າງ​ເຕັມ​ໃຈ​ເຊັ່ນ​ນີ້? ທຸກສິ່ງ​ມາ​ຈາກ​ພຣະອົງ, ແລະ ພວກ​ຂ້ານ້ອຍ​ພຽງ​ແຕ່​ຖວາຍ​ສິ່ງ​ທີ່​ມາ​ຈາກ​ມື​ຂອງ​ພຣະອົງ. <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />ພວກ​ຂ້ານ້ອຍ​ເປັນ​ຄົນຕ່າງດ້າວ ແລະ ເປັນ​ຄົນແປກໜ້າ​ເໝືອນ​ບັນພະບຸລຸດ​ຂອງ​ພວກ​ຂ້ານ້ອຍ​ໃນ​ສາຍຕາ​ຂອງ​ພຣະອົງ. ວັນ​ເວລາ​ຂອງ​ພວກ​ຂ້ານ້ອຍ​ໃນ​ໂລກ​ນີ້​ກໍ​ເໝືອນ​ເງົາ ທີ່​ບໍ່ມີ​ຄວາມ​ຫວັງ. <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />ຂ້າ​ແດ່​ພຣະເຈົ້າ​ຢາເວ, ພຣະເຈົ້າ​ຂອງ​ພວກ​ຂ້ານ້ອຍ, ຊັບສົມບັດ​ທັງໝົດ​ນີ້​ທີ່​ຂ້ານ້ອຍ​ໄດ້​ຈັດຕຽມ​ໄວ້​ນັ້ນ ເພື່ອ​ສ້າງ​ວິຫານ​ສຳລັບ​ນາມ​ອັນ​ບໍລິສຸດ​ຂອງ​ພຣະອົງ​ກໍ​ມາ​ຈາກ​ມື​ຂອງ​ພຣະອົງ, ແລະ ທຸກສິ່ງ​ທຸກ​ຢ່າງ​ກໍ​ເປັນ​ຂອງ​ພຣະອົງ​ທັງ​ສິ້ນ. <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />ຂ້າແດ່​ພຣະເຈົ້າ, ຂ້ານ້ອຍ​ຮູ້​ວ່າ​ພຣະອົງ​ທົດສອບ​ເບິ່ງ​ຈິດໃຈ ແລະ ພໍໃຈ​ໃນ​ຄວາມ​ສັດຊື່. ຂ້ານ້ອຍ​ຖວາຍ​ສິ່ງ​ທັງໝົດ​ເຫລົ່ານີ້​ດ້ວຍ​ຄວາມ​ເຕັມໃຈ ແລະ ດ້ວຍ​ໃຈ​ທີ່​ບໍລິສຸດ. ບັດນີ້​ຂ້ານ້ອຍ​ໄດ້​ເຫັນ​ຄວາມ​ຊື່ນຊົມຍິນດີ​ທີ່​ປະຊາຊົນ​ຂອງ​ພຣະອົງ​ຢູ່​ທີ່ນີ້​ຖວາຍ​ດ້ວຍ​ຄວາມ​ເຕັມໃຈ. <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />ຂ້າ​ແດ່​ພຣະເຈົ້າຢາເວ, ພຣະເຈົ້າ​ຂອງ​ອັບຣາຮາມ, ອີຊາກ ແລະ ອິດສະຣາເອນ, ບັນພະບຸລຸດ​ຂອງ​ພວກ​ຂ້ານ້ອຍ, ຂໍ​ໂຜດ​ຮັກສາ​ຄວາມ​ປາຖະໜາ ແລະ ຄວາມຄິດ​ເຫລົ່ານີ້​ໄວ້​ໃນ​ຈິດໃຈ​ຕະຫລອດໄປ, ແລະ ຮັກສາ​ຈິດໃຈ​ທີ່​ຈົ່ງ​ຮັກ​ພັກ​ດີ​ຕໍ່​ພຣະອົງ​ຕະຫລອດໄປ​ເທີນ. <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />ແລະ ຂໍ​ໂຜດ​ໃຫ້​ໂຊໂລໂມນ​ລູກຊາຍ​ຂອງ​ຂ້ານ້ອຍ​ອຸທິດ​ຢ່າງ​ໝົດ​ໃຈ​ທີ່​ຈະ​ປະຕິບັດ​ຕາມ​ຂໍ້​ຄໍາ​ສັ່ງ, ກົດໝາຍ ແລະ ຂໍ້​ກໍາ​ນົດ​ຂອງ​ພຣະອົງ​ໃນ​ການ​ເຮັດ​ທຸກສິ່ງ​ສໍາລັບ​ການ​ກໍ່ສ້າງ​ທີ່​ຍິ່ງ​ໃຫຍ່​ນີ້ ທີ່​ຂ້ານ້ອຍ​ໄດ້​ຈັດຕຽມ​ໄວ້​ແລ້ວ”.<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />ແລ້ວ​ດາວິດ​ກ່າວ​ກັບ​ປະຊາຊົນ​ທີ່​ມາ​ຊຸມນຸມ​ທັງໝົດ​ວ່າ, “ຈົ່ງ​ສັນເສີນ​ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ​ຂອງ​ພວກເຈົ້າ”. ດັ່ງນັ້ນ ພວກເຂົາ​ທັງໝົດ​ກໍ​ສັນລະເສີນ​ພຣະເຈົ້າຢາເວ, ພຣະເຈົ້າ​ແຫ່ງ​ບັນພະບຸລຸດ​ຂອງ​ພວກເຂົາ; ພວກເຂົາ​ໄດ້​ກາບລົງ​ຕໍ່ໜ້າ​ພຣະເຈົ້າ​ຢາເວ ແລະ ກະສັດ​ຂອງ​ພວກຕົນ.<verse eid="1CH 29:20" /></para>
  <para style="s1">ໂຊໂລໂມນ​ຂຶ້ນ​ເປັນ​ກະສັດ</para>
  <para style="r">(1ກສ 1:28-53)</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />ວັນ​ຕໍ່ມາ ພວກເຂົາ​ໄດ້​ຖວາຍ​ເຄື່ອງບູຊາ​ແກ່​ພຣະເຈົ້າ​ຢາເວ ແລະ ເຜົາ​ຖວາຍບູຊາ​ແກ່​ພຣະອົງ​ມີ​ດັ່ງນີ້: ງົວເຖິກ​ໜຶ່ງພັນ​ໂຕ, ແກະເຖິກ​ໜຶ່ງພັນ​ໂຕ ແລະ ລູກແກະ​ໜຶ່ງພັນ​ໂຕ, ພ້ອມທັງ​ຖວາຍ​ເຫລົ້າ​ອະງຸ່ນ ແລະ ເຄື່ອງບູຊາ​ອື່ນໆ​ຢ່າງ​ຫລວງຫລາຍ​ແກ່​ພຣະເຈົ້າ​ຢາເວ​ສຳລັບ​ອິດສະຣາເອນ​ທັງໝົດ. <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />ໃນ​ວັນ​ນັ້ນ, ພວກເຂົາ​ໄດ້​ກິນ ແລະ ດື່ມ​ດ້ວຍ​ຄວາມ​ຊື່ນຊົມຍິນດີ​ຕໍ່ໜ້າ​ພຣະເຈົ້າ​ຢາເວ.</para>
  <para style="p" vid="1CH 29:22">ຈາກນັ້ນ ພວກເຂົາ​ໄດ້​ຍອມຮັບ​ໂຊໂລໂມນ​ລູກຊາຍ​ຂອງ​ດາວິດ​ຂຶ້ນ​ເປັນ​ກະສັດ​ເປັນ​ຄັ້ງ​ທີ​ສອງ, ພວກເຂົາ​ແຕ່ງຕັ້ງ​ລາວ​ຂຶ້ນ​ເປັນ​ຜູ້​ປົກຄອງ​ຕໍ່ໜ້າ​ພຣະເຈົ້າ​ຢາເວ ແລະ ແຕ່ງຕັ້ງ​ຊາດົກ​ເປັນ​ປະໂລຫິດ. <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />ດັ່ງນັ້ນ ໂຊໂລໂມນ​ຈຶ່ງ​ຂຶ້ນ​ນັ່ງ​ເທິງ​ບັນລັງ​ທີ່​ພຣະເຈົ້າຢາເວ​ຕັ້ງ​ໄວ້​ແທນ​ດາວິດ​ພໍ່​ຂອງ​ເພິ່ນ. ເພິ່ນ​ຈະ​ເລີນ​ຮຸ່ງ​ເຮືອງ​ຂຶ້ນ ແລະ ອິດສະຣາເອນ​ທັງໝົດ​ກໍ​ເຊື່ອຟັງ​ເພິ່ນ. <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />ບັນດາ​ຂ້າ​ລາຊະການ​ທັງໝົດ ແລະ ພວກ​ນັກສູ້ຮົບ, ຕະຫລອດ​ຈົນ​ເຖິງ​ລູກຊາຍ​ທັງໝົດ​ຂອງ​ກະສັດ​ດາວິດ, ຕ່າງ​ກໍ​ໄດ້​ສັນຍາ​ວ່າ​ຈະ​ຍອມ​ເຊື່ອຟັງ​ຕໍ່​ກະສັດ​ໂຊໂລໂມນ.<verse eid="1CH 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25" />ພຣະເຈົ້າຢາເວ​ໄດ້​ຍົກ​ຊູ​ໂຊໂລໂມນ​ຂຶ້ນ​ສູງ​ໃນ​ສາຍຕາ​ປະຊາຊົນ​ອິດສະຣາເອນ​ທັງໝົດ ແລະ ໄດ້​ປະທານ​ກຽດ​ອັນສະຫງ່າງາມ​ໃຫ້​ແກ່​ເພິ່ນ ທີ່​ບໍ່​ມີ​ກະສັດ​ອິດສະຣາເອນ​ຄົນ​ໃດ​ເຄີຍ​ມີ​ມາ​ກ່ອນ.<verse eid="1CH 29:25" /></para>
  <para style="s1">ການຕາຍ​ຂອງ​ດາວິດ</para>
  <para style="r">(1ກສ 2:10-12)</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />ດາວິດ​ລູກຊາຍ​ຂອງ​ເຢຊີ​ໄດ້​ປົກຄອງ​ທົ່ວ​ອິດສະຣາເອນ. <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />ເພິ່ນ​ໄດ້​ປົກຄອງ​ອິດສະຣາເອນ​ເປັນ​ເວລາ 40 ປີ, ເພິ່ນ​ໄດ້​ປົກຄອງ​ໃນ​ເມືອງ​ເຮັບໂຣນ 7 ປີ ແລະ ໃນ​ເຢຣູຊາເລັມ 33 ປີ. <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />ດາວິດ​ໄດ້​ຕາຍ​ໄປ​ເມື່ອ​ເຖົ້າ​ແກ່​ຊະລາ​ຫລາຍ​ແລ້ວ. ມີ​ຄວາມ​ຊື່ນຊົມຍິນດີ​ກັບ​ຊີວິດ​ຍືນ​ຍາວ, ກຽດຕິຍົດ ແລະ ຄວາມ​ຮັ່ງມີ. ໂຊໂລໂມນ​ລູກຊາຍ​ຂອງ​ເພິ່ນ​ໄດ້​ຂຶ້ນ​ເປັນ​ກະສັດ​ແທນ.<verse eid="1CH 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 29:29" />ເຫດການ​ຕ່າງໆ​ໃນ​ໄລຍະ​ການ​ປົກຄອງ​ຂອງ​ກະສັດ​ດາວິດ​ຕັ້ງ​ແຕ່​ຕົ້ນ​ຈົນ​ຈົບ, ພວກເຂົາ​ໄດ້​ບັນທຶກ​ໄວ້​ໃນ​ບົດບັນທຶກ​ຂອງ​ຜູ້ທຳນວາຍ​ຊາມູເອນ, ໃນ​ບົດບັນທຶກ​ຂອງ​ຜູ້ທຳນວາຍ​ນາທານ ແລະ ໃນ​ບົດບັນທຶກ​ຂອງ​ຜູ້ທຳນວາຍ​ກາດ, <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />ພ້ອມ​ທັງ​ລາຍລະອຽດ​ກ່ຽວກັບ​ການ​ປົກຄອງ, ອໍານາດ​ຂອງ​ເພິ່ນ ແລະ ເຫດການ​ທັງໝົດ​ທີ່​ເກີດ​ຂຶ້ນ​ກັບ​ເພິ່ນ ແລະ ອິດສະຣາເອນ ກັບ ອານາຈັກ​ອື່ນໆ​ທັງໝົດ.<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>