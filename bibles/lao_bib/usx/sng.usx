<usx version="3.0">
  <book code="SNG" style="id">- Biblica® Open Lao Contemporary Version</book>
  <para style="rem">Copyright © 2023, 2025 by Biblica, Inc.</para>
  <para style="h">ຍອດເພງ</para>
  <para style="toc1">ພຣະທຳຍອດເພງ</para>
  <para style="toc2">ຍອດເພງ</para>
  <para style="toc3">ຍພ</para>
  <para style="mt1">ພຣະທຳຍອດເພງ</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />ຍອດ​ບົດເພງ​ຂອງ​ໂຊໂລໂມນ.<verse eid="SNG 1:1" /></para>
  <para style="b" />
  <para style="sp">ຜູ້ສາວ<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">ໃນ​ຕົ້ນ​ສະບັບ​ບໍ່​ໄດ້​ລະບຸ​ຜູ້​ເວົ້າ ເປັນ​ຄວາມ​ຄາດ​ໝາຍ​ເພື່ອ​ໃຫ້​ເຂົ້າໃຈ​ຫລາຍ​ຂຶ້ນ</char></note></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />ຂໍ​ໃຫ້​ເຈົ້າ​ຈູບ​ຂ້ອຍ​ດ້ວຍ​ປາກ​ຂອງ​ເຈົ້າ</para>
  <para style="q2" vid="SNG 1:2">ເພາະ​ຄວາມ​ຮັກ​ຂອງ​ເຈົ້າ​ແມ່ນ​ຊື່ນ​ໃຈ​ຫລາຍ​ກວ່າ​ເຫລົ້າ​ອະງຸ່ນ.<verse eid="SNG 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3" />ກິ່ນ​ນ້ຳຫອມ​ຂອງ​ເຈົ້າ​ຊ່າງ​ຊວນ​ຫລົງໄຫລ;</para>
  <para style="q2" vid="SNG 1:3">ຊື່ສຽງ​ຂອງ​ເຈົ້າ​ກໍ​ເປັນ​ເໝືອນ​ນໍ້າຫອມ​ທີ່​ຖອກ​ອອກ​ມາ.</para>
  <para style="q2" vid="SNG 1:3">ຈຶ່ງ​ບໍ່​ແປກໃຈ​ເລີຍ​ທີ່​ຍິງ​ສາວ​ຫຸ້ມ​ຮັກ​ເຈົ້າ!<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />ພາ​ຂ້ອຍ​ໄປ​ນໍາ​ເຈົ້າ ໃຫ້​ພວກເຮົາ​ຟ້າວ​ໄປ!</para>
  <para style="q2" vid="SNG 1:4">ຂໍ​ໃຫ້​ກະສັດ​ພາ​ຂ້ອຍ​ເຂົ້າ​ໄປ​ໃນ​ຫ້ອງ​ຂອງ​ເຈົ້າ.</para>
  <para style="sp" vid="SNG 1:4">ບັນດາ​ໝູ່</para>
  <para style="q1" vid="SNG 1:4">ພວກເຮົາ​ຊື່ນຊົມ ແລະ ຍິນດີ​ໃນ​ໂຕ​ເຈົ້າ;</para>
  <para style="q2" vid="SNG 1:4">ພວກເຮົາ​ຈະ​ເທີດທູນ​ຄວາມ​ຮັກ​ຂອງ​ເຈົ້າ​ຫລາຍ​ກວ່າ​ເຫລົ້າ​ອະງຸ່ນ.</para>
  <para style="sp" vid="SNG 1:4">ຜູ້ສາວ</para>
  <para style="q1" vid="SNG 1:4">ຖືກຕ້ອງ​ແລ້ວ​ທີ່​ພວກເຂົາ​ເທີດທູນ​ເຈົ້າ!<verse eid="SNG 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />ບັນດາ​ຍິງສາວ​ຊາວ​ເຢຣູຊາເລັມ​ເອີຍ,</para>
  <para style="q2" vid="SNG 1:5">ຂ້ອຍ​ເປັນ​ຄົນ​ຜິວ​ດໍາ,</para>
  <para style="q1" vid="SNG 1:5">ດໍາ​ເໝືອນ​ດັ່ງ​ຜ້າ​ເຕັນ​ແຫ່ງ​ເກດາ​ກໍ​ຈິງ,</para>
  <para style="q2" vid="SNG 1:5">ແຕ່​ກໍ​ງາມ​ໜ້າ​ຮັກ​ເໝືອນ​ຜ້າກັ້ງ​ຂອງ​ໂຊໂລໂມນ.<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">ຫລື ຊັນມາ</char></note><verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />ຢ່າ​ຈ້ອງ​ເບິ່ງ​ຜິວ​ທີ່​ດຳ​ຂອງ​ຂ້ອຍ​ຫລາຍ,</para>
  <para style="q2" vid="SNG 1:6">ເພາະ​ຂ້ອຍ​ເປັນ​ຄົນ​ຍ້ອນ​ຕາເວັນ.</para>
  <para style="q1" vid="SNG 1:6">ບັນດາ​ອ້າຍ​ຂອງ​ຂ້ອຍ​ໃຈຮ້າຍ​ໃຫ້​ຂ້ອຍ</para>
  <para style="q2" vid="SNG 1:6">ແລະ ໃຫ້​ຂ້ອຍ​ໄປ​ເບິ່ງແຍງ​ສວນ​ອະງຸ່ນ​ທັງຫລາຍ.</para>
  <para style="q2" vid="SNG 1:6">ແຕ່​ສວນ​ອະງຸ່ນ​ຂອງ​ຂ້ອຍ​ເອງ​ຖືກ​ປະຖິ້ມ​ໄວ້;<verse eid="SNG 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />ບອກ​ຂ້ອຍ​ແດ່​ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ</para>
  <para style="q2" vid="SNG 1:7">ມື້​ນີ້​ເຈົ້າ​ຈະ​ພາ​ຝູງ​ແກະ​ຂອງ​ເຈົ້າ​ໄປ​ກິນ​ຫຍ້າ​ຢູ່​ໃສ</para>
  <para style="q2" vid="SNG 1:7">ແລະ ຕອນ​ທ່ຽງ​ນັ້ນ​ເຈົ້າ​ຈະ​ພາ​ຝູງແກະ​ຂອງ​ເຈົ້າ​ໄປ​ພັກຜ່ອນ​ຢູ່​ໃສ.</para>
  <para style="q1" vid="SNG 1:7">ດ້ວຍ​ເຫດ​ໃດ​ຂ້ອຍ​ຈະ​ຕ້ອງ​ເປັນ​ເໝືອນ​ແມ່ຍິງ​ທີ່​ເອົາ​ຜ້າ​ຄຸມ​ໜ້າ</para>
  <para style="q2" vid="SNG 1:7">ໄປ​ກັບ​ຝູງແກະ​ຂອງ​ບັນດາ​ໝູ່​ຂອງ​ເຈົ້າ?<verse eid="SNG 1:7" /></para>
  <para style="sp">ບັນດາ​ໝູ່</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />ແມ່ຍິງ​ງາມ​ທີ່​ສຸດ, ຖ້າ​ເຈົ້າ​ບໍ່​ຮູ້ຈັກ,</para>
  <para style="q2" vid="SNG 1:8">ກໍ​ໃຫ້​ຕິດຕາມ​ຮອຍ​ຝູງ​ແກະ​ໄປ</para>
  <para style="q1" vid="SNG 1:8">ແລະ ໄປ​ທີ່​ເຕັນ​ຂອງ​ພວກ​ຄົນ​ລ້ຽງ​ແກະ</para>
  <para style="q2" vid="SNG 1:8">ໄປ​ລ້ຽງ​ຝູງ​ແບ້​ຂອງ​ເຈົ້າ​ຢູ່​ທີ່​ນັ້ນ.<verse eid="SNG 1:8" /></para>
  <para style="sp">ຊາຍ​ໜຸ່ມ</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9" />ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ, ຂ້ອຍ​ປຽບ​ເຈົ້າ​ເໝືອນ​ດັ່ງ​ມ້າ​ແມ່</para>
  <para style="q2" vid="SNG 1:9">ທີ່​ໃຊ້​ທຽມ​ລົດມ້າ​ຂອງ​ຟາໂຣ<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />ແກ້ມ​ຂອງ​ເຈົ້າ​ງົດ​ງາມ​ດ້ວຍ​ຕຸ້ມຫູ,</para>
  <para style="q2" vid="SNG 1:10">ຄໍ​ຂອງ​ເຈົ້າ​ກໍ​ງາມ​ດ້ວຍ​ສາຍຄໍ​ອັນຍະມະນີ.<verse eid="SNG 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />ພວກເຮົາ​ຈະ​ເຮັດ​ຕຸ້ມຫູ​ຄຳ​ໃຫ້​ເຈົ້າ,</para>
  <para style="q2" vid="SNG 1:11">ປະດັບ​ເຈົ້າ​ດ້ວຍ​ເງິນ.<verse eid="SNG 1:11" /></para>
  <para style="sp">ຍິງ​ສາວ</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />ເມື່ອ​ກະສັດ​ຢູ່​ທີ່​ບ່ອນ​ນອນ,</para>
  <para style="q2" vid="SNG 1:12">ນ້ຳຫອມ​ຂອງ​ຂ້ອຍ​ກໍ​ສົ່ງ​ກິນ​ຫອມ​ໄປ​ທົ່ວ.<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ ເຈົ້າ​ເປັນ​ດັ່ງ​ຖົງ​ຢາງໄມ້ຫອມ</para>
  <para style="q2" vid="SNG 1:13">ທີ່​ວາງ​ຢູ່​ຫວ່າງ​ເອິກ​ຂອງ​ຂ້ອຍ.<verse eid="SNG 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ ເຈົ້າ​ເປັນ​ດັ່ງ​ພວງ​ດອກ​ທຽນຊຳ</para>
  <para style="q2" vid="SNG 1:14">ຈາກ​ສວນ​ອະງຸ່ນ​ແຫ່ງ​ເອນເກດີ.<verse eid="SNG 1:14" /></para>
  <para style="sp">ຊາຍ​ໜຸ່ມ</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15" />ເຈົ້າ​ຊ່າງ​ງາມ​ແທ້ ສຸດ​ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ!</para>
  <para style="q2" vid="SNG 1:15">ໂອ, ງາມ​ແທ້!</para>
  <para style="q2" vid="SNG 1:15">ດວງ​ຕາ​ຂອງ​ເຈົ້າ​ເໝືອນ​ດັ່ງ​ນົກເຂົາ.<verse eid="SNG 1:15" /></para>
  <para style="sp">ຍິງ​ສາວ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ ເຈົ້າ​ຊ່າງ​ເຈົ້າຊູ້​ແທ້!</para>
  <para style="q2" vid="SNG 1:16">ໂອ, ມີ​ສະເໜ່​ຫລາຍ!</para>
  <para style="q2" vid="SNG 1:16">ແລະ ຕຽງນອນ​ຂອງ​ພວກເຮົາ​ກໍ​ຂຽວ​ສົດ.<verse eid="SNG 1:16" /></para>
  <para style="sp">ຊາຍ​ໜຸ່ມ</para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17" />ຂື່​ເຮືອນ​ຂອງ​ພວກເຮົາ​ກໍ​ເປັນ​ໄມ້ສີດາ;</para>
  <para style="q2" vid="SNG 1:17">ເພດານ​ເຮືອນ​ຂອງ​ພວກເຮົາ​ກໍ​ເປັນ​ໄມ້ເຟີ້.<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="sp">ຍິງ​ສາວ<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">ຫລື ຊາຍ​ໜຸ່ມ</char></note></para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />ຂ້ອຍ​ເປັນ​ດັ່ງ​ດອກ​ກຸຫລາບ​ແຫ່ງ​ຊາໂຣນ,</para>
  <para style="q2" vid="SNG 2:1">ເໝືອນ​ດອກລີລາ​ແຫ່ງ​ຮ່ອມພູ.<verse eid="SNG 2:1" /></para>
  <para style="sp">ຊາຍ​ໜຸ່ມ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ ຢູ່​ທ່າມກາງ​ຍິງ​ສາວ</para>
  <para style="q2" vid="SNG 2:2">ກໍ​ເປັນ​ເໝືອນ​ດອກລີລາ​ທ່າມກາງ​ພຸ່ມ​ໜາມ.<verse eid="SNG 2:2" /></para>
  <para style="sp">ຍິງ​ສາວ</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ ຢູ່​ທ່າມກາງ​ຊາຍ​ໜຸ່ມ</para>
  <para style="q2" vid="SNG 2:3">ກໍ​ເປັນ​ເໝືອນ​ຕົ້ນ​ແອັບເປີ້ນ​ທ່າມກາງ​ຕົ້ນ​ໄມ້​ໃນ​ປ່າ</para>
  <para style="q1" vid="SNG 2:3">ຂ້ອຍ​ມັກ​ນັ່ງ​ຢູ່​ກ້ອງ​ຮົ່ມ​ເງົາ​ຂອງ​ລາວ,</para>
  <para style="q2" vid="SNG 2:3">ແລະ ໝາກ​ຂອງ​ລາວ​ແມ່ນ​ຫອມ​ຫວານ​ເມື່ອ​ຂ້ອຍ​ໄດ້​ຊີມ​ລົດ.<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />ລາວ​ພາ​ຂ້ອຍ​ໄປ​ໃນ​ຫ້ອງ​ກິນ​ລ້ຽງ,</para>
  <para style="q2" vid="SNG 2:4">ແລະ ໃຫ້​ຫລາຍ​ຄົນ​ເຫັນ​ວ່າ​ລາວ​ຮັກ​ຂ້ອຍ​ຫລາຍ​ເທົ່າໃດ<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">ຫລື ທຸງ​ຂອງ​ລາວ​ທີ່​ຢູ່​ເໜືອ​ຂ້ອຍ​ຄື​ຄວາມ​ຮັກ</char></note><verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />ໃຫ້​ກໍາລັງ​ໃຈ​ຂ້ອຍ​ດ້ວຍ​ໝາກ​ອະງຸ່ນ​ແຫ້ງ,</para>
  <para style="q2" vid="SNG 2:5">ເຮັດ​ໃຫ້​ຂ້ອຍ​ສົດຊື່ນ​ດ້ວຍ​ໝາກ​ແອັບເປີ້ນ</para>
  <para style="q2" vid="SNG 2:5">ເພາະ​ຂ້ອຍ​ອ່ອນແຮງ​ດ້ວຍ​ຄວາມ​ຮັກ.<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />ແຂນ​ຊ້າຍ​ຂອງ​ລາວ​ປະຄອງ​ຫົວ​ຂ້ອຍ​ໄວ້,</para>
  <para style="q2" vid="SNG 2:6">ແລະ ແຂນ​ຂວາ​ຂອງ​ລາວ​ກໍ​ໂອບກອດ​ຂ້ອຍ​ໄວ້.<verse eid="SNG 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />ບັນດາ​ລູກສາວ​ຊາວ​ເຢຣູຊາເລັມ,</para>
  <para style="q2" vid="SNG 2:7">ຂ້ອຍ​ຂໍ​ຢ້ຳ​ເຈົ້າ​ໂດຍ​ພະລັງ​ຢ່າງ​ເຍືອງ ແລະ ກວາງ​ໃນ​ທົ່ງຫຍ້າ​ວ່າ:</para>
  <para style="q1" vid="SNG 2:7">ຢ່າ​ກະຕຸ້ນ​ຄວາມ​ຮັກ ຫລື ປຸກ​ຄວາມ​ຮັກ</para>
  <para style="q2" vid="SNG 2:7">ຈົນ​ປ່ອຍ​ມັນ​ໃຫ້​ເປັນ​ໄປ​ຕາມ​ຄວາມ​ປາຖະໜາ.<verse eid="SNG 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />ຈົ່ງ​ຟັງ! ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ!</para>
  <para style="q2" vid="SNG 2:8">ເບິ່ງ​ແມ! ລາວ​ກໍາລັງ​ມາ​ທີ່​ນີ້,</para>
  <para style="q1" vid="SNG 2:8">ກະໂດດ​ຂ້າມ​ພູເຂົາ​ທັງຫລາຍ,</para>
  <para style="q2" vid="SNG 2:8">ກະໂດດ​ຂ້າມ​ເນີນພູ​ມາ.<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ​ເປັນ​ເໝືອນ​ເຍືອງ​ຜູ້ ຫລື ກວາງ​ໜຸ່ມ.</para>
  <para style="q2" vid="SNG 2:9">ເບິ່ງ​ແມ! ລາວ​ຢູ່​ຫລັງ​ກຳແພງ​ຂອງ​ພວກເຮົາ,</para>
  <para style="q1" vid="SNG 2:9">ກໍາລັງ​ໂງ​ຫົວ​ຂຶ້ນ​ເບິ່ງ​ຜ່ານ​ປ່ອງຢ້ຽມ,</para>
  <para style="q2" vid="SNG 2:9">ແນມ​ເບິ່ງ​ລອດ​ຜ່ານ​ຕາໜ່າງ.<verse eid="SNG 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ​ເອີ່ຍ​ຂຶ້ນ ແລະ ໄດ້​ເວົ້າ​ກັບ​ຂ້ອຍ​ວ່າ,</para>
  <para style="q2" vid="SNG 2:10">“ລຸກ​ຂຶ້ນ, ສຸດ​ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ,</para>
  <para style="q2" vid="SNG 2:10">ຄົນ​ງາມ​ຂອງ​ຂ້ອຍ, ຈົ່ງ​ມາ​ກັບ​ຂ້ອຍ.<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />ເບິ່ງ​ແມ! ລະດູ​ໜາວ​ຜ່ານ​ພົ້ນ​ໄປ​ແລ້ວ;</para>
  <para style="q2" vid="SNG 2:11">ຝົນ​ກໍ​ເຊົາ​ຕົກ​ແລ້ວ.<verse eid="SNG 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12" />ດອກ​ໄມ້​ຕ່າງໆ​ເລີ່ມ​ບານ​ຢູ່​ເທິງ​ແຜ່ນດິນ​ໂລກ;</para>
  <para style="q2" vid="SNG 2:12">ລະດູ​ແຫ່ງ​ການ​ຮ້ອງ​ເພງ​ໄດ້​ມາ​ເຖິງ​ແລ້ວ,</para>
  <para style="q1" vid="SNG 2:12">ສຽງ​ນົກເຂົາ​ຮ້ອງ</para>
  <para style="q2" vid="SNG 2:12">ໄດ້​ຍິນ​ໃນ​ຖິ່ນ​ຂອງ​ພວກເຮົາ.<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />ຕົ້ນ​ໝາກເດື່ອ​ກຳລັງ​ເກີດ​ຜົນ​ທຳອິດ</para>
  <para style="q2" vid="SNG 2:13">ເຄືອ​ອະງຸ່ນ​ກໍ​ອອກ​ດອກ​ບານ​ສົ່ງ​ກິ່ນ​ຫອມ​ຂອງ​ມັນ.</para>
  <para style="q1" vid="SNG 2:13">ລຸກ​ຂຶ້ນ​ມາ ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ;</para>
  <para style="q2" vid="SNG 2:13">ຄົນ​ງາມ​ຂອງ​ຂ້ອຍ ຈົ່ງ​ມາ​ກັບ​ຂ້ອຍ”.<verse eid="SNG 2:13" /></para>
  <para style="sp">ຊາຍ​ໜຸ່ມ</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />ນົກເຂົາ​ຂອງ​ຂ້ອຍ​ຢູ່​ໃນ​ຫລືບ​ຫີນ,</para>
  <para style="q2" vid="SNG 2:14">ກໍາລັງ​ລີ້​ຢູ່​ເທິງ​ເປີ້ນ​ພູເຂົາ</para>
  <para style="q1" vid="SNG 2:14">ຂໍ​ໃຫ້​ຂ້ອຍ​ໄດ້​ເຫັນ​ໜ້າ​ເຈົ້າ,</para>
  <para style="q2" vid="SNG 2:14">ຂໍ​ໃຫ້​ຂ້ອຍ​ໄດ້​ຍິນ​ສຽງ​ຂອງ​ເຈົ້າ;</para>
  <para style="q1" vid="SNG 2:14">ເພາະ​ສຽງ​ຂອງ​ເຈົ້າ​ຊ່າງ​ຫວານ​ແທ້,</para>
  <para style="q2" vid="SNG 2:14">ແລະ ໃບ​ໜ້າ​ຂອງ​ເຈົ້າ​ກໍ​ງາມ​ໜ້າ​ຮັກ.<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />ຈົ່ງ​ມາ​ຊ່ວຍ​ຈັບ​ຝູງ​ໝາຈອກ​ໃຫ້​ພວກເຮົາ</para>
  <para style="q2" vid="SNG 2:15">ໝາຈອກ​ໂຕ​ນ້ອຍ​ທັງຫລາຍ</para>
  <para style="q1" vid="SNG 2:15">ທີ່​ທຳລາຍ​ສວນ​ອະງຸ່ນ</para>
  <para style="q2" vid="SNG 2:15">ສວນ​ຂອງ​ພວກເຮົາ​ທີ່​ກຳລັງ​ອອກ​ດອກ​ບານ.<verse eid="SNG 2:15" /></para>
  <para style="sp">ຍິງ​ສາວ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ​ແມ່ນ​ເປັນ​ຂອງ​ຂ້ອຍ ແລະ ຂ້ອຍ​ກໍ​ເປັນ​ຂອງ​ລາວ</para>
  <para style="q2" vid="SNG 2:16">ລາວ​ລ້ຽງ​ສັດ​ຢູ່​ທ່າມກາງ​ດອກລີລາ.<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />ຈົນ​ຮຸ່ງ​ເຊົ້າ​ມາ</para>
  <para style="q2" vid="SNG 2:17">ແລະ ເງົາ​ມືດ​ກໍ​ລັບ​ຫາຍ​ໄປ,</para>
  <para style="q1" vid="SNG 2:17">ຈົ່ງ​ຫັນ​ມາ ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ,</para>
  <para style="q2" vid="SNG 2:17">ແລະ ຂໍ​ໃຫ້​ເປັນ​ເໝືອນ​ເຍືອງ</para>
  <para style="q1" vid="SNG 2:17">ຫລື ກວາງ​ໜຸ່ມ</para>
  <para style="q2" vid="SNG 2:17">ທີ່​ຢູ່​ເທິງ​ເນີນພູ​ເບັດເອ.<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">ຫລື ເນີນພູ​ທີ່​ຮົກ ແລະ ບໍ່​ຮາບພຽງ</char></note><verse eid="SNG 2:17" /></para>
  <para style="b" />
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1" />ຢູ່​ເທິງ​ຕຽງ​ຂອງ​ຂ້ອຍ​ຕະຫລອດ​ຄືນ</para>
  <para style="q2" vid="SNG 3:1">ຂ້ອຍ​ໄດ້​ຊອກ​ຫາ​ຍອດ​ຫົວໃຈ​ຮັກ​ຂອງ​ຂ້ອຍ;</para>
  <para style="q2" vid="SNG 3:1">ຂ້ອຍ​ໄດ້​ຊອກ​ຫາ​ລາວ ແຕ່​ກໍ​ບໍ່​ພົບ​ລາວ.<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />ຂ້ອຍ​ຈະ​ລຸກ​ຂຶ້ນ​ດຽວນີ້ ແລະ ໄປ​ທົ່ວ​ເມືອງ,</para>
  <para style="q2" vid="SNG 3:2">ໄປ​ຕາມ​ຖະໜົນ ແລະ ເດີ່ນ​ເມືອງ;</para>
  <para style="q1" vid="SNG 3:2">ຂ້ອຍ​ຈະ​ຄົ້ນຫາ​ຜູ້​ທີ່​ເປັນ​ຍອດ​ຫົວໃຈ​ຂອງ​ຂ້ອຍ.</para>
  <para style="q2" vid="SNG 3:2">ດັ່ງນັ້ນ ຂ້ອຍ​ໄດ້​ຊອກ​ຫາ​ລາວ ແຕ່​ກໍ​ບໍ່​ພົບ​ລາວ.<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />ຄົນ​ເຝົ້າ​ຍາມ​ກໍ​ມາ​ພົບ​ຂ້ອຍ</para>
  <para style="q2" vid="SNG 3:3">ຂະນະ​ທີ່​ພວກເຂົາ​ກຳລັງ​ຍ່າງ​ກວດ​ໄປ​ອ້ອມ​ເມືອງ.</para>
  <para style="q2" vid="SNG 3:3">ຂ້ອຍ​ຖາມ​ພວກເຂົາ​ວ່າ, “ພວກເຈົ້າ​ເຫັນ​ຜູ້​ເປັນ​ຍອດ​ຫົວໃຈ​ຂອງ​ຂ້ອຍ​ບໍ?”<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />ພໍ​ແຕ່​ຈາກ​ພວກເຂົາ​ໄປ​ບໍ່​ພໍ​ເທົ່າ​ໃດ</para>
  <para style="q2" vid="SNG 3:4">ຂ້ອຍ​ກໍ​ພົບ​ຜູ້​ທີ່​ເປັນ​ຍອດ​ຫົວໃຈ​ຂອງ​ຂ້ອຍ.</para>
  <para style="q1" vid="SNG 3:4">ຂ້ອຍ​ໂອບກອດ​ລາວ​ໄວ້ ແລະ ຈະ​ບໍ່​ປ່ອຍ​ໃຫ້​ລາວ​ໄປ​ໃສ</para>
  <para style="q2" vid="SNG 3:4">ຈົນ​ກວ່າ​ຂ້ອຍ​ຈະ​ໄດ້​ພາ​ລາວ​ມາ​ທີ່​ເຮືອນ​ຂອງ​ແມ່​ຂອງ​ຂ້ອຍ,</para>
  <para style="q2" vid="SNG 3:4">ມາ​ເຖິງ​ຫ້ອງ​ຜູ້​ທີ່​ໃຫ້​ກຳເນີດ​ຂ້ອຍ.<verse eid="SNG 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />ບັນດາ​ລູກສາວ​ຊາວ​ເຢຣູຊາເລັມ,</para>
  <para style="q2" vid="SNG 3:5">ຂ້ອຍ​ຂໍ​ຢ້ຳ​ເຈົ້າ​ໂດຍ​ພະລັງ​ຢ່າງ​ເຍືອງ ແລະ ກວາງ​ໃນ​ທົ່ງຫຍ້າ​ວ່າ:</para>
  <para style="q1" vid="SNG 3:5">ຢ່າ​ກະຕຸ້ນ​ຄວາມ​ຮັກ ຫລື ປຸກ​ຄວາມ​ຮັກ</para>
  <para style="q2" vid="SNG 3:5">ຈົນ​ປ່ອຍ​ມັນ​ໃຫ້​ເປັນ​ໄປ​ຕາມ​ຄວາມ​ປາຖະໜາ.<verse eid="SNG 3:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />ຜູ້ໃດ​ນໍ​ທີ່​ກໍາລັງ​ອອກ​ມາ​ຈາກ​ຖິ່ນແຫ້ງແລ້ງກັນດານ</para>
  <para style="q2" vid="SNG 3:6">ເໝືອນ​ລຳ​ຄວັນ​ພຸ່ງ​ຂຶ້ນ,</para>
  <para style="q1" vid="SNG 3:6">ເຕັມ​ໄປ​ດ້ວຍ​ກິ່ນ​ຫອມ​ຂອງ​ຢາງໄມ້ຫອມ ແລະ ກຳຍານ</para>
  <para style="q2" vid="SNG 3:6">ທີ່​ປຸງ​ມາ​ຈາກ​ເຄື່ອງຫອມ​ຂອງ​ພໍ່ຄ້າ?<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />ເບິ່ງ​ແມ! ນັ້ນ​ແມ່ນ​ຂະບວນ​ແຫ່​ຂອງ​ໂຊໂລໂມນ,</para>
  <para style="q2" vid="SNG 3:7">ມີ​ນັກຮົບ​ຜູ້​ເກັ່ງກ້າ​ທີ່ສຸດ​ຂອງ​ອິດສະຣາເອນ,</para>
  <para style="q2" vid="SNG 3:7">ຫົກ​ສິບ​ຄົນ​ຄຸມກັນ​ໄວ້,<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />ພວກເຂົາ​ທຸກຄົນ​ຖື​ດາບ​ໄວ້,</para>
  <para style="q2" vid="SNG 3:8">ທຸກຄົນ​ເປັນ​ນັກຮົບ​ທີ່​ຊຳນານ,</para>
  <para style="q1" vid="SNG 3:8">ແຕ່​ລະ​ຄົນ​ມີ​ດາບ​ຂອງ​ຕົນ​ຢູ່​ຂ້າງ​ກາຍ,</para>
  <para style="q2" vid="SNG 3:8">ກຽມ​ພ້ອມ​ຮັບ​ໄພ​ໂຈມຕີ​ໃນ​ເວລາ​ກາງຄືນ.<verse eid="SNG 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />ກະສັດ​ໂຊໂລໂມນ​ໄດ້​ໃຫ້​ປະກອບ​ລົດ​ນີ້​ໄວ້​ສຳລັບ​ຕົນ​ເອງ;</para>
  <para style="q2" vid="SNG 3:9">ເພິ່ນ​ໄດ້​ເຮັດ​ລົດ​ນີ້​ດ້ວຍ​ໄມ້​ຈາກ​ເລບານອນ.<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />ເສົາ​ຂອງ​ລົດ​ແມ່ນ​ເຮັດ​ດ້ວຍ​ເງິນ,</para>
  <para style="q2" vid="SNG 3:10">ພື້ນ​ຂອງ​ລົດ​ແມ່ນ​ເປັນ​ຄໍາ.</para>
  <para style="q1" vid="SNG 3:10">ບ່ອນນັ່ງ​ຂອງ​ລົດ​ແມ່ນ​ຫຸ້ມ​ດ້ວຍ​ຜ້າ​ສີມ່ວງ,</para>
  <para style="q2" vid="SNG 3:10">ພາຍໃນ​ຂອງ​ລົດ​ແມ່ນ​ຕົບແຕ່ງ​ດ້ວຍ​ຄວາມ​ຮັກ.</para>
  <para style="q1" vid="SNG 3:10">ບັນດາ​ລູກສາວ​ຊາວ​ເຢຣູຊາເລັມ, <verse eid="SNG 3:10" /><verse number="11" style="v" sid="SNG 3:11" />ຈົ່ງ​ອອກ​ມາ,</para>
  <para style="q2" vid="SNG 3:11">ພວກເຈົ້າ, ບັນດາ​ລູກສາວ​ແຫ່ງ​ຊີໂອນ,</para>
  <para style="q1" vid="SNG 3:11">ຈົ່ງ​ອອກ​ມາ​ເບິ່ງ​ກະສັດ​ໂຊໂລໂມນ​ສວມ​ມົງກຸດ,</para>
  <para style="q2" vid="SNG 3:11">ມົງກຸດ​ທີ່​ແມ່​ຂອງ​ເພິ່ນ​ໄດ້​ສວມ​ໃຫ້​ເພິ່ນ,</para>
  <para style="q1" vid="SNG 3:11">ໃນ​ວັນ​ແຕ່ງງານ​ຂອງ​ເພິ່ນ,</para>
  <para style="q2" vid="SNG 3:11">ວັນ​ແຫ່ງ​ຄວາມ​ຊື່ນຊົມຍິນດີ​ຂອງ​ເພິ່ນ.<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">ຊາຍ​ໜຸ່ມ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1" />ເຈົ້າ​ຊ່າງ​ງາມ​ແທ້, ສຸດ​ທີ່ຮັກ​ຂອງ​ຂ້ອຍ!</para>
  <para style="q2" vid="SNG 4:1">ໂອ, ງາມ​ແທ້ໆ!</para>
  <para style="q2" vid="SNG 4:1">ດວງຕາ​ຂອງ​ເຈົ້າ​ທີ່​ຢູ່​ພາຍ​ໃຕ້​ຜ້າຄຸມ​ໜ້າ​ທີ່​ເໝືອນ​ນົກເຂົາ.</para>
  <para style="q1" vid="SNG 4:1">ຜົມ​ຂອງ​ເຈົ້າ​ເໝືອນ​ກັບ​ຝູງ​ແບ້</para>
  <para style="q2" vid="SNG 4:1">ທີ່​ກໍາລັງ​ລົງ​ມາ​ຈາກ​ຮ່ອມພູ​ກີເລອາດ.<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />ແຂ້ວ​ຂອງ​ເຈົ້າ​ຂາວ​ເໝືອນ​ຝູງ​ແກະ​ທີ່​ຫາ​ກໍ​ຖືກ​ຕັດ​ຂົນ,</para>
  <para style="q2" vid="SNG 4:2">ແລະ ຂຶ້ນ​ມາ​ຈາກ​ການ​ຊຳລະ​ລ້າງ.</para>
  <para style="q1" vid="SNG 4:2">ແຂ້ວ​ທຸກ​ເຫລັ້ມ​ລຽງ​ສັບ​ກັນ,</para>
  <para style="q2" vid="SNG 4:2">ບໍ່​ຫາຍ​ໄປ​ຈັກ​ເຫລັ້ມ.<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />ຮີມສົບ​ຂອງ​ເຈົ້າ​ແດງ​ເຂັ້ມ​ເໝືອນ​ກັບ​ດ້າຍ​ແດງ;</para>
  <para style="q2" vid="SNG 4:3">ປາກ​ຂອງ​ເຈົ້າ​ກໍ​ໜ້າ​ຮັກ.</para>
  <para style="q1" vid="SNG 4:3">ພາຍໃຕ້​ຜ້າ​ຜ້າຄຸມ​ໜ້າ​ຂອງ​ເຈົ້າ ຂະໝັບ​ຂອງ​ເຈົ້າ</para>
  <para style="q2" vid="SNG 4:3">ກໍ​ເໝືອນ​ກັບ​ໝາກພິລາ​ຜ່າ​ເຄິ່ງ.<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />ລຳຄໍ​ຂອງ​ເຈົ້າ​ກໍ​ເໝືອນ​ກັບ​ຫໍຄອຍ​ຂອງ​ດາວິດ,</para>
  <para style="q2" vid="SNG 4:4">ທີ່​ສ້າງ​ຂຶ້ນ​ດ້ວຍ​ຫີນ​ຢ່າງ​ປານີດ<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">ໃນ​ພາສາ​ເຮັບເຣີ​ຄຳ​ນີ້​ມີ​ຄວາມຫມາຍ​ບໍ່​ຊັດເຈນ</char></note>;</para>
  <para style="q1" vid="SNG 4:4">ທີ່​ປະດັບປະດາ​ດ້ວຍ​ໂລ່​ນັບ​ເປັນ​ພັນ​ອັນ,</para>
  <para style="q2" vid="SNG 4:4">ໂລ່​ທັງ​ໝົດ​ນັ້ນ​ເປັນ​ຂອງ​ບັນດາ​ນັກຮົບ.<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />ນົມ​ທັງ​ສອງ​ຂອງ​ເຈົ້າ​ເໝືອນ​ກັບ​ລູກ​ກວາງ​ສອງ​ໂຕ,</para>
  <para style="q2" vid="SNG 4:5">ເໝືອນ​ລູກ​ແຝດ​ຂອງ​ເຍືອງ</para>
  <para style="q2" vid="SNG 4:5">ທີ່​ກິນ​ຫຍ້າ​ຢູ່​ທ່າມກາງ​ດອກລີລາ.<verse eid="SNG 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />ຂ້ອຍ​ຈະ​ຂຶ້ນ​ໄປ​ເທິງ​ພູເຂົາ​ແຫ່ງ​ຢາງໄມ້ຫອມ</para>
  <para style="q2" vid="SNG 4:6">ແລະ ໄປ​ເນີນພູ​ເຄື່ອງຫອມ.</para>
  <para style="q1" vid="SNG 4:6">ຈົນ​ຮຸ່ງ​ເຊົ້າ​ມາ​ເຖິງ</para>
  <para style="q2" vid="SNG 4:6">ແລະ ເງົາ​ມືດ​ຫາຍ​ໄປ.<verse eid="SNG 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />ສຸດ​ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ, ເຈົ້າ​ຊ່າງ​ງາມ​ໄປ​ໝົດ​ທຸກ​ຢ່າງ;</para>
  <para style="q2" vid="SNG 4:7">ໃນ​ຮ່າງກາຍ​ຂອງ​ເຈົ້າ​ບໍ່​ມີ​ທີ່​ຕິ​ເລີຍ.<verse eid="SNG 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />ເຈົ້າ​ສາວ​ຂອງ​ຂ້ອຍ, ລົງ​ມາ​ຈາກ​ເລບານອນ​ກັບ​ຂ້ອຍ,</para>
  <para style="q2" vid="SNG 4:8">ລົງ​ມາ​ຈາກ​ເລບານອນ​ກັບ​ຂ້ອຍ.</para>
  <para style="q1" vid="SNG 4:8">ລົງ​ມາ​ຈາກ​ຍອດ​ພູເຂົາ​ອາມານາ,</para>
  <para style="q2" vid="SNG 4:8">ຈາກ​ຈອມ​ພູເຂົາ​ເສນີ ແລະ ຈອມ​ພູເຂົາ​ເຮີໂມນ,</para>
  <para style="q1" vid="SNG 4:8">ຈາກ​ຖ້ຳ​ຂອງ​ສິງ</para>
  <para style="q2" vid="SNG 4:8">ແລະ ຈາກ​ພູເຂົາ​ທີ່​ເປັນ​ບ່ອນ​ຢູ່​ຂອງ​ເສືອດາວ.<verse eid="SNG 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />ເຈົ້າ​ໄດ້​ລັກ​ຫົວໃຈ​ຂອງ​ຂ້ອຍ​ໄປ​ແລ້ວ ນ້ອງ​ຮັກ​ຂອງ​ຂ້ອຍ, ເຈົ້າ​ສາວ​ຂອງ​ຂ້ອຍ,</para>
  <para style="q2" vid="SNG 4:9">ເຈົ້າ​ໄດ້​ລັກ​ຫົວໃຈ​ຂອງ​ຂ້ອຍ​ໄປ​ແລ້ວ</para>
  <para style="q1" vid="SNG 4:9">ເຈົ້າ​ແນມ​ເບິ່ງ​ພຽງ​ແຕ່​ຄັ້ງ​ດຽວ,</para>
  <para style="q2" vid="SNG 4:9">ພຽງ​ແຕ່​ອັນຍະມະນີ​ເມັດ​ດຽວ​ທີ່​ຢູ່​ສາຍຄໍ​ຂອງ​ເຈົ້າ.<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />ນ້ອງ​ຮັກ​ຂອງ​ຂ້ອຍ, ເຈົ້າສາວ​ຂອງ​ຂ້ອຍ, ຄວາມ​ຮັກ​ຂອງ​ເຈົ້າ​ໜ້າ​ຊື່ນໃຈ​ແທ້!</para>
  <para style="q2" vid="SNG 4:10">ຖືກ​ໃຈ​ຂ້ອຍ​ຫລາຍ​ກວ່າ​ເຫລົ້າ​ອະງຸ່ນ.</para>
  <para style="q1" vid="SNG 4:10">ແລະ ກິ່ນ​ນ້ຳຫອມ​ຂອງ​ເຈົ້າ</para>
  <para style="q2" vid="SNG 4:10">ກໍ​ຫອມ​ກວ່າ​ເຄື່ອງ​ຫອມ​ໃດໆ!<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />ເຈົ້າ​ສາວ​ຂອງ​ຂ້ອຍ, ຮີມສົບ​ຂອງ​ເຈົ້າ​ຢອດ​ຄວາມ​ຫວານ​ເໝືອນດັ່ງ​ນ້ຳເຜິ້ງ;</para>
  <para style="q2" vid="SNG 4:11">ກ້ອງ​ລິ້ນ​ຂອງ​ເຈົ້າ​ແມ່ນ​ນ້ຳນົມ ແລະ ນ້ຳເຜິ້ງ.</para>
  <para style="q1" vid="SNG 4:11">ກິ່ນ​ຫອມ​ຂອງ​ເຄື່ອງນຸ່ງ​ຂອງ​ເຈົ້າ</para>
  <para style="q2" vid="SNG 4:11">ກໍ​ເໝືອນ​ກັບ​ກິ່ນ​ຫອມ​ແຫ່ງ​ເລບານອນ.<verse eid="SNG 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />ນ້ອງ​ຮັກ​ຂອງ​ອ້າຍ, ເຈົ້າສາວ​ຂອງ​ຂ້ອຍ, ເຈົ້າ​ເປັນ​ເໝືອນ​ສວນ​ທີ່​ຫວງຫ້າມ;</para>
  <para style="q2" vid="SNG 4:12">ເຈົ້າ​ເປັນ​ເໝືອນ​ນ້ຳພຸ​ທີ່​ໄດ້​ຖືກ​ກັ້ນ​ເຂດ ແລະ ນໍ້າພຸ​ທີ່​ປະທັບຕາ​ໄວ້.<verse eid="SNG 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13" />ເຈົ້າ​ປຽບ​ເໝືອນ​ສວນ​ໝາກພິລາ</para>
  <para style="q2" vid="SNG 4:13">ທີ່​ໃຫ້​ຜົນ​ດີ​ເລີດ,</para>
  <para style="q2" vid="SNG 4:13">ມີ​ທັງ​ຕົ້ນ​ທຽນຊຳ ແລະ ຕົ້ນ​ຫອມແຝກ.<verse eid="SNG 4:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="SNG 4:14" />ຕົ້ນ​ຫອມແຝກ ແລະ ຫຍ້າຄຳຝອຍ,</para>
  <para style="q2" vid="SNG 4:14">ຄາລາມັສ ແລະ ອົບເຊີຍ,</para>
  <para style="q2" vid="SNG 4:14">ພ້ອມ​ກັບ​ຕົ້ນໄມ້​ຫອມ​ທຸກ​ຊະນິດ,</para>
  <para style="q2" vid="SNG 4:14">ພ້ອມ​ກັບ​ຢາງໄມ້ຫອມ, ຕົ້ນ​ກາລະບູນ</para>
  <para style="q2" vid="SNG 4:14">ແລະ ເຄື່ອງເທດ​ອັນ​ດີ​ທຸກ​ຊະນິດ.<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />ເຈົ້າ​ເປັນ<note caller="+" style="f"><char style="fr" closed="false">4:15 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ຂ້ອຍ​ເປັນ </char><char style="ft" closed="false">(ຍິງ​ສາວ​ເປັນ​ຜູ້​ເວົ້າ)</char></note>​ສວນ​ນ້ຳພຸ,</para>
  <para style="q2" vid="SNG 4:15">ເປັນ​ລຳທານ​ທີ່​ຫລັ່ງໄຫລ</para>
  <para style="q2" vid="SNG 4:15">ຫລັ່ງໄຫລ​ລົງ​ມາ​ຈາກ​ເລບານອນ.<verse eid="SNG 4:15" /></para>
  <para style="sp">ຍິງ​ສາວ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16" />ຈົ່ງ​ຕື່ນ​ຂຶ້ນ, ລົມ​ເໜືອ,</para>
  <para style="q2" vid="SNG 4:16">ແລະ ຈົ່ງ​ມາ, ລົມ​ໃຕ້!</para>
  <para style="q1" vid="SNG 4:16">ຈົ່ງ​ພັດ​ຜ່ານ​ສວນ​ຂອງ​ຂ້ອຍ,</para>
  <para style="q2" vid="SNG 4:16">ພັດ​ກິ່ນ​ຫອມ​ໃຫ້​ກະຈາຍ​ໄປ​ທຸກ​ບ່ອນ.</para>
  <para style="q1" vid="SNG 4:16">ຂໍ​ໃຫ້​ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ​ເຂົ້າ​ມາ​ໃນ​ສວນ​ຂອງ​ລາວ</para>
  <para style="q2" vid="SNG 4:16">ແລະ ຊິມ​ລົດ​ໝາກໄມ້​ທີ່​ດີ​ທີ​ສຸດ​ໃນ​ທີ່​ນັ້ນ.<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">ຊາຍ​ໜຸ່ມ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />ຂ້ອຍ​ໄດ້​ເຂົ້າ​ມາ​ໃນ​ສວນ​ຂອງ​ຂ້ອຍ​ແລ້ວ ນ້ອງ​ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ, ເຈົ້າສາວ​ຂອງ​ຂ້ອຍ;</para>
  <para style="q2" vid="SNG 5:1">ຂ້ອຍ​ໄດ້​ເກັບ​ຢາງໄມ້ຫອມ ແລະ ເຄື່ອງຫອມ​ຂອງ​ຂ້ອຍ.</para>
  <para style="q1" vid="SNG 5:1">ຂ້ອຍ​ໄດ້​ກິນ​ຮັງ​ເຜິ້ງ ແລະ ນ້ຳເຜິ້ງ​ຂອງ​ຂ້ອຍ;</para>
  <para style="q2" vid="SNG 5:1">ຂ້ອຍ​ໄດ້​ດື່ມ​ເຫລົ້າ​ອະງຸ່ນ ແລະ ນ້ຳນົມ​ຂອງ​ຂ້ອຍ.</para>
  <para style="sp" vid="SNG 5:1">ໝູ່​ເພື່ອນ</para>
  <para style="q1" vid="SNG 5:1">ໝູ່​ເພື່ອນ, ຈົ່ງ​ກິນ ແລະ ດື່ມ;</para>
  <para style="q2" vid="SNG 5:1">ດື່ມ​ຄວາມ​ຮັກ​ຂອງ​ເຈົ້າ​ໃຫ້​ອິ່ມ​ເຕັມ.<verse eid="SNG 5:1" /></para>
  <para style="sp">ຍິງ​ສາວ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />ຂ້ອຍ​ໄດ້​ນອນຫລັບ​ໄປ ແຕ່​ຫົວໃຈ​ຂອງ​ຂ້ອຍ​ຍັງ​ຕື່ນ​ຢູ່.</para>
  <para style="q2" vid="SNG 5:2">ຈົ່ງ​ຟັງ! ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ​ກຳລັງ​ເຄາະ​ປະຕູ ແລະ ເວົ້າ​ວ່າ:</para>
  <para style="q1" vid="SNG 5:2">“ນ້ອງ​ຮັກ​ຂອງ​ຂ້ອຍ, ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ, ເປີດ​ໃຫ້​ຂ້ອຍ​ແດ່,</para>
  <para style="q2" vid="SNG 5:2">ນົກເຂົາ​ນ້ອຍ​ຂອງ​ຂ້ອຍ, ຄົນ​ງາມ​ບໍ່​ມີ​ທີ່​ຕິ​ຂອງ​ຂ້ອຍ.</para>
  <para style="q1" vid="SNG 5:2">ຫົວ​ຂອງ​ຂ້ອຍ​ປຽກ​ຊຸ່ມ​ໄປ​ດ້ວຍ​ນ້ຳໝອກ,</para>
  <para style="q2" vid="SNG 5:2">ຜົມ​ຂອງ​ຂ້ອຍ​ຊຸ່ມ​ດ້ວຍ​ລະອອງ​ນໍ້າ​ໃນ​ຍາມ​ກາງຄືນ”.<verse eid="SNG 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />ແຕ່​ຂ້ອຍ​ໄດ້​ແກ້​ເສື້ອຄຸມ​ຂອງ​ຂ້ອຍ​ອອກ​ແລ້ວ</para>
  <para style="q2" vid="SNG 5:3">ຈະ​ໃຫ້​ນ້ອຍ​ນຸ່ງ​ເສື້ອຄຸມ​ນັ້ນ​ເຂົ້າ​ໄປ​ໃໝ່​ອີກ​ບໍ?</para>
  <para style="q1" vid="SNG 5:3">ຂ້ອຍ​ໄດ້​ລ້າງ​ຕີນ​ຂອງ​ຂ້ອຍ​ແລ້ວ</para>
  <para style="q2" vid="SNG 5:3">ຈະ​ໃຫ້​ຂ້ອຍ​ເຮັດ​ໃຫ້​ເປື້ອນ​ດິນ​ອີກ​ບໍ?<verse eid="SNG 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ​ພະຍາຍາມ​ເອົາ​ມື​ຖອດ​ກອນ​ປະຕູ</para>
  <para style="q2" vid="SNG 5:4">ຫົວໃຈ​ຂອງ​ຂ້ອຍ​ເລີ່ມ​ເຕັ້ນ​ແຮງ​ເພາະ​ຄິດຮອດ​ລາວ.<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />ຂ້ອຍ​ລຸກ​ຂຶ້ນ​ເປີດ​ເພື່ອ​ປະຕູ​ຮັບ​ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ,</para>
  <para style="q2" vid="SNG 5:5">ແລະ ມື​ຂອງ​ຂ້ອຍ​ກໍ​ປຽກ​ຊຸ່ມ​ດ້ວຍ​ຢົດ​ຢາງໄມ້ຫອມ,</para>
  <para style="q1" vid="SNG 5:5">ນິ້ວມື​ຂອງ​ຂ້ອຍ​ທີ່​ມີ​ຢາງໄມ້ຫອມ</para>
  <para style="q2" vid="SNG 5:5">ໄຫລ​ປຽກ​ຊຸ່ມ​ກອນ​ປະຕູ.<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />ຂ້ອຍ​ໄດ້​ເປີດ​ປະຕູ​ຕ້ອນຮັບ​ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ</para>
  <para style="q2" vid="SNG 5:6">ແຕ່​ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ​ໄດ້​ຈາກ​ໄປ; ລາວ​ໄດ້​ໄປ​ແລ້ວ.</para>
  <para style="q2" vid="SNG 5:6">ຂ້ອຍ​ກໍ​ຕົກໃຈ​ເມື່ອ​ລາວ​ຈາກ​ໄປ.<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">ຫລື ຈິດໃຈ​ຂອງ​ຂ້ອຍ​ໄດ້​ແລ່ນ​ໄປ​ຫາ​ລາວ​ເມື່ອ​ລາວ​ເວົ້າ</char></note></para>
  <para style="q1" vid="SNG 5:6">ຂ້ອຍ​ໄດ້​ຊອກຫາ​ລາວ ແຕ່​ບໍ່​ພົບ​ລາວ​ເລີຍ.</para>
  <para style="q2" vid="SNG 5:6">ຂ້ອຍ​ຮ້ອງ​ຫາ​ລາວ ແຕ່​ລາວ​ບໍ່​ຕອບ.<verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />ຄົນ​ເຝົ້າຍາມ​ໄດ້​ພົບ​ຂ້ອຍ</para>
  <para style="q2" vid="SNG 5:7">ຂະນະ​ທີ່​ພວກເຂົາ​ຍ່າງ​ກວດ​ອ້ອມ​ເມືອງ.</para>
  <para style="q1" vid="SNG 5:7">ພວກເຂົາ​ຕີ​ຂ້ອຍ, ພວກເຂົາ​ໄດ້​ເຮັດ​ໃຫ້​ຂ້ອຍ​ບວມ​ຊ້ຳ;</para>
  <para style="q2" vid="SNG 5:7">ບັນດາ​ຄົນ​ເຝົ້າ​ຍາມ​ຢູ່​ທີ່​ກຳແພງ​ເມືອງ</para>
  <para style="q2" vid="SNG 5:7">ພວກເຂົາ​ໄດ້​ເອົາ​ເສື້ອຄຸມ​ຂອງ​ຂ້ອຍ​ໄປ!<verse eid="SNG 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />ບັນດາ​ລູກສາວ​ຂອງ​ຊາວ​ເຢຣູຊາເລັມ, ຂ້ອຍ​ຂໍຮ້ອງ​ພວກເຈົ້າ​ວ່າ</para>
  <para style="q2" vid="SNG 5:8">ຖ້າ​ພວກເຈົ້າ​ພົບ​ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ,</para>
  <para style="q1" vid="SNG 5:8">ພວກເຈົ້າ​ຈະ​ບອກ​ລາວ​ເລື່ອງ​ໃດ​ກັບ​ລາວ?</para>
  <para style="q2" vid="SNG 5:8">ຈົ່ງ​ບອກ​ລາວ​ວ່າ​ຂ້ອຍ​ກຳລັງ​ປ່ວຍ​ເປັນ​ໄຂ້​ໃຈ.<verse eid="SNG 5:8" /></para>
  <para style="sp">ໝູ່​ເພື່ອນ</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />ແມ່ຍິງ​ທີ່​ງາມ​ທີ່​ສຸດ,</para>
  <para style="q2" vid="SNG 5:9">ຄົນ​ຮັກ​ຂອງ​ເຈົ້າ​ດີ​ກວ່າ​ຄົນ​ອື່ນ​ຢ່າງ​ໃດ?</para>
  <para style="q1" vid="SNG 5:9">ຄົນ​ຮັກ​ຂອງ​ເຈົ້າ​ດີ​ກວ່າ​ຄົນ​ອື່ນ​ຢ່າງໃດ?</para>
  <para style="q2" vid="SNG 5:9">ເຈົ້າ​ຈຶ່ງ​ຢ້ຳ​ພວກເຮົາ​ຢ່າງ​ນີ້?<verse eid="SNG 5:9" /></para>
  <para style="sp">ຍິງ​ສາວ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ​ງາມ​ສະຫງ່າ ແລະ ແຂງແຮງ​ດີ,</para>
  <para style="q2" vid="SNG 5:10">ໂດດເດັ່ນ​ທ່າມກາງ​ຄົນ​ເປັນ​ໝື່ນ.<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />ຫົວ​ຂອງ​ລາວ​ເໝືອນ​ຄໍາ​ບໍລິສຸດ​ທີ່ສຸດ;</para>
  <para style="q2" vid="SNG 5:11">ຜົມ​ຂອງ​ລາວ​ກໍ​ເປັນ​ຄື້ນ</para>
  <para style="q2" vid="SNG 5:11">ແລະ ດຳ​ເໝືອນດັ່ງ​ກາ.<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />ຕາ​ຂອງ​ລາວ​ກໍ​ເໝືອນ​ນົກເຂົາ</para>
  <para style="q2" vid="SNG 5:12">ຢືນ​ຢູ່​ແຄມ​ສາຍນ້ຳ,</para>
  <para style="q1" vid="SNG 5:12">ທີ່​ອາບ​ນໍ້ານົມ,</para>
  <para style="q2" vid="SNG 5:12">ເໝືອນດັ່ງ​ອັນຍະມະນີ​ປະດັບ​ໄວ້.<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />ແກ້ມ​ຂອງ​ລາວ​ເປັນ​ເໝືອນ​ໜານ​ເຄື່ອງຫອມ</para>
  <para style="q2" vid="SNG 5:13">ທີ່​ສົ່ງ​ກິ່ນ​ຫອມ.</para>
  <para style="q1" vid="SNG 5:13">ຮີມສົບ​ຂອງ​ລາວ​ເໝືອນດັ່ງ​ດອກລີລາ</para>
  <para style="q2" vid="SNG 5:13">ທີ່​ຢົດ​ດ້ວຍ​ຢາງໄມ້ຫອມ.<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />ແຂນ​ຂອງ​ລາວ​ເໝືອນ​ດັ່ງ​ແທ່ງ​ຄຳ</para>
  <para style="q2" vid="SNG 5:14">ທີ່​ປະດັບ​ດ້ວຍ​ບຸດສະລາຄຳ.</para>
  <para style="q1" vid="SNG 5:14">ຮ່າງກາຍ​ຂອງ​ລາວ​ເໝືອນ​ງາຊ້າງ​ທີ່​ເງົາ​ເຫລື້ອມ</para>
  <para style="q2" vid="SNG 5:14">ປະດັບ​ດ້ວຍ​ແກ້ວໄພທູນ.<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />ຂາ​ຂອງ​ລາວ​ຄື​ກັບ​ເສົາ​ຫີນອ່ອນ</para>
  <para style="q2" vid="SNG 5:15">ທີ່​ຕັ້ງ​ຢູ່​ເທິງ​ຖານ​ທີ່​ເຮັດ​ດ້ວຍ​ຄຳ​ບໍລິສຸດ.</para>
  <para style="q1" vid="SNG 5:15">ຮູບຮ່າງ​ຂອງ​ລາວ​ແຂງແກ່ນ​ເໝືອນ​ດັ່ງ​ຕົ້ນໄມ້ສີດາ​ແຫ່ງ​ເລບານອນ,</para>
  <para style="q2" vid="SNG 5:15">ທີ່​ຄັດເລືອກ​ມາ​ເປັນ​ຢ່າງ​ດີ.<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />ປາກ​ຂອງ​ລາວ​ກໍ​ຫວານ​ເປັນ​ທຳມະຊາດ</para>
  <para style="q2" vid="SNG 5:16">ທຸກສິ່ງ​ໃນ​ຕົວ​ລາວ​ເບິ່ງ​ເປັນ​ຕາ​ໜ້າ​ຮັກ,</para>
  <para style="q1" vid="SNG 5:16">ນີ້​ແມ່ນ​ທີ່​ຮັກ ແລະ ເພື່ອນ​ຂອງ​ຂ້ອຍ,</para>
  <para style="q2" vid="SNG 5:16">ໂອ ບັນດາ​ລູກສາວ​ຊາວ​ເຢຣູຊາເລັມ.<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">ໝູ່​ເພື່ອນ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />ແມ່ຍິງ​ທີ່​ງາມ​ທີ່​ສຸດ,</para>
  <para style="q2" vid="SNG 6:1">ທີ່​ຮັກ​ຂອງ​ເຈົ້າ​ໄປ​ໃສ?</para>
  <para style="q1" vid="SNG 6:1">ທີ່​ຮັກ​ຂອງ​ເຈົ້າ​ຫັນ​ໄປ​ທາງ​ໃດ,</para>
  <para style="q2" vid="SNG 6:1">ເພື່ອ​ວ່າ​ພວກເຮົາ​ຈະ​ຊ່ວຍ​ເຈົ້າ​ຊອກຫາ​ລາວ?<verse eid="SNG 6:1" /></para>
  <para style="sp">ຍິງ​ສາວ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ​ໄດ້​ລົງ​ໄປ​ທີ່​ສວນ​ຂອງ​ລາວ,</para>
  <para style="q2" vid="SNG 6:2">ໄປ​ທີ່​ໜານ​ເຄື່ອງຫອມ,</para>
  <para style="q1" vid="SNG 6:2">ໄປ​ຍ່າງ​ເບິ່ງ​ໃນ​ສວນ​ຂອງ​ລາວ</para>
  <para style="q2" vid="SNG 6:2">ແລະ ເກັບ​ດອກລີລາ.<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />ຂ້ອຍ​ເປັນ​ຂອງ​ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ ແລະ ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ​ກໍ​ເປັນ​ຂອງ​ຂ້ອຍ;</para>
  <para style="q2" vid="SNG 6:3">ລາວ​ຍ່າງ​ເບິ່ງ​ດອກລີລາ​ທັງຫລາຍ.<verse eid="SNG 6:3" /></para>
  <para style="sp">ຊາຍ​ໜຸ່ມ</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />ສຸດ​ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ, ເຈົ້າ​ຊ່າງ​ງາມ​ເທົ່າ​ກັບ​ແດນ​ຕີຣະຊາ,</para>
  <para style="q2" vid="SNG 6:4">ໜ້າ​ຮັກ​ເໝືອນດັ່ງ​ເຢຣູຊາເລັມ,</para>
  <para style="q2" vid="SNG 6:4">ສະຫງ່າ​ເໝືອນດັ່ງ​ກອງ​ທະຫານ​ທີ່​ປະດັບ​ດ້ວຍ​ທຸງ​ໄຊ.<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />ຈົ່ງ​ປະ​ສາຍ​ຕາ​ຂອງ​ເຈົ້າ​ໄປ​ຈາກ​ຂ້ອຍ;</para>
  <para style="q2" vid="SNG 6:5">ເພາະ​ສາຍ​ຕາ​ຂອງ​ເຈົ້າ​ເຮັດ​ໃຫ້​ຂ້ອຍ​ຫວັ່ນໄຫວ.</para>
  <para style="q1" vid="SNG 6:5">ຜົມ​ຂອງ​ເຈົ້າ​ເປັນ​ເໝືອນ​ຝູງ​ແບ້</para>
  <para style="q2" vid="SNG 6:5">ທີ່​ກໍາລັງ​ລົງ​ມາ​ຈາກ​ເນີນພູ​ກີເລອາດ.<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />ແຂ້ວ​ຂອງ​ເຈົ້າ​ເປັນ​ເໝືອນ​ຝູງ​ແກະ</para>
  <para style="q2" vid="SNG 6:6">ທີ່​ກຳລັງ​ຂຶ້ນ​ມາ​ຈາກ​ການ​ຊຳລະ.</para>
  <para style="q1" vid="SNG 6:6">ແຂ້ວ​ທຸກ​ເຫລັ້ມ​ລຽງ​ກັນ,</para>
  <para style="q2" vid="SNG 6:6">ຢ່າງ​ບໍ່​ມີ​ທີ່​ຕິ.<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />ພາຍໃຕ້​ຜ້າຄຸມ​ໜ້າ​ຂອງ​ເຈົ້າ ຂະໝັບ​ຂອງ​ເຈົ້າ</para>
  <para style="q2" vid="SNG 6:7">ເໝືອນ​ໝາກພິລາ​ຜ່າ​ເຄິ່ງ.<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />ອາດ​ມີ​ລາຊີນີ​ເຖິງ​ຫົກ​ສິບ​ຄົນ,</para>
  <para style="q2" vid="SNG 6:8">ແລະ ນາງສະໜົມ​ແປດສິບ​ຄົນ,</para>
  <para style="q2" vid="SNG 6:8">ແລະ ສາວ​ບໍລິສຸດ​ຈົນ​ອີກ​ຈົນ​ນັບ​ຈຳນວນ​ບໍ່​ຖ້ວນ;<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />ແຕ່​ນົກເຂົາ​ຂອງ​ຂ້ອຍ, ຄົນ​ງາມ​ຢ່າງ​ສົມບູນ​ແບບ​ຂອງ​ຂ້ອຍ, ບໍ່​ເໝືອນ​ຜູ້ໃດ,</para>
  <para style="q2" vid="SNG 6:9">ເປັນ​ລູກສາວ​ຄົນ​ດຽວ​ຂອງ​ແມ່,</para>
  <para style="q2" vid="SNG 6:9">ເປັນ​ລູກສາວ​ຄົນ​ທີ່​ແມ່​ພໍໃຈ​ຫລາຍ.</para>
  <para style="q1" vid="SNG 6:9">ບັນດາ​ຍິງ​ໜຸ່ມ​ທີ່​ເຫັນ​ນາງ ແລ້ວ​ກໍ​ເອີ້ນ​ນາງ​ວ່າ ໄດ້​ຮັບ​ພອນ;</para>
  <para style="q2" vid="SNG 6:9">ບັນດາ​ລາຊີນີ ແລະ ບັນດາ​ນາງສະໜົມ​ຕ່າງ​ກໍ​ຍ້ອງຍໍ​ຊົມເຊີຍ​ນາງ.<verse eid="SNG 6:9" /></para>
  <para style="sp">ໝູ່​ເພື່ອນ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />ຍິງ​ຄົນນີ້​ແມ່ນ​ຜູ້ໃດ​ນໍ ທີ່​ມາ​ປາກົດ​ໂຕ​ຂຶ້ນ​ດັ່ງ​ຮຸ່ງ​ອາລຸນ,</para>
  <para style="q2" vid="SNG 6:10">ຊ່າງ​ງາມ​ດັ່ງ​ດວງ​ເດືອນ, ສ່ອງແຈ້ງ​ດັ່ງ​ດວງ​ຕາເວັນ,</para>
  <para style="q2" vid="SNG 6:10">ສະຫງ່າງາມ​ເໝືອນ​ດັ່ງ​ດວງດາວ​ທີ່​ເຄື່ອນ​ທີ່​ໄປ​ມາ?<verse eid="SNG 6:10" /></para>
  <para style="sp">ຊາຍ​ໜຸ່ມ</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />ຂ້ອຍ​ໄດ້​ລົງ​ໄປ​ທີ່​ແຖວ​ຕົ້ນ​ໝາກມັນຮໍ່</para>
  <para style="q2" vid="SNG 6:11">ເພື່ອ​ເບິ່ງ​ສິ່ງ​ທີ່​ຫາ​ກໍ່​ປົ່ງ​ງາມ​ໃນ​ຮ່ອມພູ,</para>
  <para style="q1" vid="SNG 6:11">ເພື່ອ​ເບິ່ງ​ວ່າ​ເຄືອອະງຸ່ນ​ແຕກ​ຕາ</para>
  <para style="q2" vid="SNG 6:11">ຫລື ເບິ່ງ​ໝາກພິລາ​ອອກ​ດອກ​ບານ​ແລ້ວ​ບໍ.<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />ກ່ອນ​ທີ່​ຂ້ອຍ​ຈະ​ຮູ້​ໂຕ,</para>
  <para style="q2" vid="SNG 6:12">ຄວາມ​ປາຖະໜາ​ຂອງ​ຂ້ອຍ​ກໍ​ເຮັດ​ຂ້ອຍ​ຮູ້ສຶກ​ວ່າ​ຢູ່​ເທິງ​ລົດມ້າ​ຮົບ​ຫລວງ​ທີ່​ຢູ່​ທ່າມກາງ​ປະຊາຊົນ​ຂອງ​ຂ້ອຍ.<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">ຫລື ທ່າມ​ກາງ​ລົດຮົບ​ຂອງ​ອຳມີນາດາບ ຫລື ທ່າມ​ກາງ​ລົດຮົບ​ຂອງ​ປະຊາຊົນ​ຂອງ​ເຈົ້ານາຍ</char></note><verse eid="SNG 6:12" /></para>
  <para style="sp">ໝູ່​ເພື່ອນ</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />ຈົ່ງ​ກັບ​ມາ, ຈົ່ງ​ກັບ​ມາ, ໂອ ສາວ​ຊາວຊູລຳ;</para>
  <para style="q2" vid="SNG 6:13">ຈົ່ງ​ກັບ​ມາ, ຈົ່ງ​ກັບ​ມາ, ເພື່ອ​ພວກເຮົາ​ຈະ​ໄດ້​ຈ້ອງ​ເບິ່ງ​ເຈົ້າ!</para>
  <para style="sp" vid="SNG 6:13">ຊາຍ​ໜຸ່ມ</para>
  <para style="q1" vid="SNG 6:13">ເປັນ​ຫຍັງ​ພວກເຈົ້າ​ຈຶ່ງ​ຈ້ອງ​ເບິ່ງ​ສາວ​ຊາວ​ຊູລຳ</para>
  <para style="q2" vid="SNG 6:13">ປານ​ກັບ​ວ່າ​ເບິ່ງ​ການ​ຟ້ອນລຳ​ຢູ່​ທີ່​ເມືອງ​ມະຫານາອິມ?<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">ໃນ​ພາສາ​ເຮັບເຣີ ຂໍ້​ນີ້ 6:13 ເປັນ​ຂໍ້ <char style="xt" link-href="SNG 7:1"><ref loc="SNG 7:1">7:1</ref></char></char></note><verse eid="SNG 6:13" /></para>
  <para style="b" />
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1" />ໂອ ລູກສາວ​ຂອງ​ເຈົ້ານາຍ!</para>
  <para style="q2" vid="SNG 7:1">ຕີນ​ຂອງ​ເຈົ້າ​ທີ່​ຢູ່​ໃນ​ເກີບ​ສານ​ຊ່າງ​ງົດງາມ!</para>
  <para style="q1" vid="SNG 7:1">ຂາ​ຂອງ​ເຈົ້າ​ງາມ​ເໝືອນ​ດັ່ງ​ອັນຍະມະນີ,</para>
  <para style="q2" vid="SNG 7:1">ທີ່​ມື​ຂອງ​ນັກ​ສິນລະປິນ​ເຈຍລະໄນ.<verse eid="SNG 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2" />ສະບື​ຂອງ​ເຈົ້າ​ເປັນ​ດັ່ງ​ຈອກ​ກົມ</para>
  <para style="q2" vid="SNG 7:2">ທີ່​ບໍ່​ເຄີຍ​ຂາດ​ກິ່ນ​ເຫລົ້າອະງຸ່ນ​ປະສົມ.</para>
  <para style="q1" vid="SNG 7:2">ແອວ​ຂອງ​ເຈົ້າ​ງາມ​ດັ່ງ​ກອງ​ເຂົ້າ​ຫວີດ</para>
  <para style="q2" vid="SNG 7:2">ອ້ອມ​ດ້ວຍ​ດອກລີລາ.<verse eid="SNG 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3" />ນົມ​ຂອງ​ເຈົ້າ​ເໝືອນ​ກັບ​ລູກ​ກວາງ​ສອງ​ໂຕ,</para>
  <para style="q2" vid="SNG 7:3">ເໝືອນ​ກັບ​ລູກ​ແຝດ​ຂອງ​ເຍືອງ.<verse eid="SNG 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4" />ລຳຄໍ​ເຈົ້າ​ກໍ​ສູງ​ດັ່ງ​ຫໍຄອຍ​ງາຊ້າງ.</para>
  <para style="q1" vid="SNG 7:4">ຕາ​ຂອງ​ເຈົ້າ​ໃສ​ເໝືອນ​ສະນໍ້າ​ໃນ​ເຮັດຊະໂບນ</para>
  <para style="q2" vid="SNG 7:4">ທີ່​ສ່ອງ​ປະກາຍ​ຢູ່​ທີ່​ຂ້າງ​ປະຕູ​ບັດຣັບບິມ.</para>
  <para style="q1" vid="SNG 7:4">ດັງ​ຂອງ​ເຈົ້າ​ງາມ​ດັ່ງ​ຫໍຄອຍ​ແຫ່ງ​ເລບານອນ</para>
  <para style="q2" vid="SNG 7:4">ທີ່​ເບິ່ງ​ໄປ​ທີ່​ດາມັສກັດ.<verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />ຫົວ​ຂອງ​ເຈົ້າ​ສະຫງ່າງາມ​ເໝືອນ​ພູເຂົາ​ກາເມນ.</para>
  <para style="q2" vid="SNG 7:5">ຜົມ​ຂອງ​ເຈົ້າ​ງາມ​ຄື​ກັບ​ຜ້າກັ້ງ​ປັກ​ຢູ່​ໃນ​ວັງ;</para>
  <para style="q2" vid="SNG 7:5">ຜົມ​ຂອງ​ເຈົ້າ​ມັດ​ໃຈ​ກະສັດ.<verse eid="SNG 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ, ເຈົ້າ​ຊ່າງ​ງາມ​ຫລາຍ ແລະ ເປັນ​ທີ່​ພໍໃຈ​ຫລາຍ,</para>
  <para style="q2" vid="SNG 7:6">ເຈົ້າ​ໜ້າ​ຊື່ນໃຈ​ແທ້!<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />ເຈົ້າ​ສູງ​ເໝືອນ​ອິນທະຜາລຳ</para>
  <para style="q2" vid="SNG 7:7">ແລະ ນົມ​ຂອງ​ເຈົ້າ​ເໝືອນ​ພວງ​ໝາກໄມ້.<verse eid="SNG 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8" />ຂ້ອຍ​ໄດ້​ເວົ້າ​ວ່າ, “ຂ້ອຍ​ຈະ​ປີນ​ຂຶ້ນ​ຕົ້ນ​ອິນທະຜາລຳ​ຕົ້ນ​ນີ້;</para>
  <para style="q2" vid="SNG 7:8">ຂ້ອຍ​ຈະ​ກອດ​ໝາກ​ຂອງ​ມັນ​ໄວ້”.</para>
  <para style="q1" vid="SNG 7:8">ຂໍ​ໃຫ້​ນົມ​ຂອງ​ເຈົ້າ​ເໝືອນ​ພວງ​ໝາກ​ອະງຸ່ນ​ທີ່​ຢູ່​ເທິງ​ເຄືອອະງຸ່ນ,</para>
  <para style="q2" vid="SNG 7:8">ໃຫ້​ກິ່ນ​ລົມຫາຍ​ໃຈ​ຂອງ​ເຈົ້າ​ຫອມ​ເໝືອນ​ກິ່ນ​ໝາກ​ແອັບເປີ້ນ,<verse eid="SNG 7:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="SNG 7:9" />ແລະ ປາກ​ຂອງ​ເຈົ້າ​ເໝືອນ​ເຫລົ້າອະງຸ່ນ​ຊັ້ນ​ດີ.</para>
  <para style="sp" vid="SNG 7:9">ຍິງ​ສາວ</para>
  <para style="q1" vid="SNG 7:9">ຂໍ​ໃຫ້​ເຫລົ້າອະງຸ່ນ​ນີ້​ໄຫລ​ສູ່​ຮີມສົບ</para>
  <para style="q2" vid="SNG 7:9">ແລະ ແຂ້ວ​ຂອງ​ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ.<note caller="+" style="f"><char style="fr" closed="false">7:9 </char><char style="ft" closed="false">ຫລື ຮີມສົບ​ຂອງ​ຜູ້​ນອນ​ຫລັບ</char></note><verse eid="SNG 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10" />ຂ້ອຍ​ເປັນ​ຂອງ​ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ</para>
  <para style="q2" vid="SNG 7:10">ແລະ ລາວ​ປາຖະໜາ​ຂ້ອຍ.<verse eid="SNG 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />ຈົ່ງ​ມາ, ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ, ໃຫ້​ພວກເຮົາ​ອອກ​ໄປ​ທີ່​ຊົນນະບົດ​ນຳ​ກັນ,</para>
  <para style="q2" vid="SNG 7:11">ໃຫ້​ພວກເຮົາ​ນອນ​ຄ້າງ​ຄືນ​ຢູ່​ທີ່​ໝູ່ບ້ານ.<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">ຫລື ຟຸ່ມ​ທຽນຊຳ</char></note><verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />ໃຫ້​ພວກເຮົາ​ລຸກ​ຂຶ້ນ​ໄປ​ສວນ​ອະງຸ່ນ​ແຕ່​ເຊົ້າ</para>
  <para style="q2" vid="SNG 7:12">ເພື່ອ​ເບິ່ງ​ວ່າ​ເຄືອອະງຸ່ນ​ແຕກ​ຕາ​ແລ້ວ​ບໍ,</para>
  <para style="q1" vid="SNG 7:12">ເພື່ອ​ເບິ່ງ​ວ່າ​ດອກ​ອະງຸ່ນ​ເປີດ​ອອກ​ບານ​ແລ້ວ​ແລ້ວ​ບໍ,</para>
  <para style="q2" vid="SNG 7:12">ແລະ ເບິ່ງ​ວ່າ​ດອກ​ໝາກພິລາ​ບານ​ອອກ​ແລ້ວ​ບໍ</para>
  <para style="q2" vid="SNG 7:12">ຢູ່​ທີ່​ນັ້ນ ຂ້ອຍ​ຈະ​ມອບ​ຄວາມ​ຮັກ​ໃຫ້​ແກ່​ເຈົ້າ.<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />ຕົ້ນ​ມານເດກ​ກໍ​ສົ່ງ​ກິ່ນ​ຫອມ,</para>
  <para style="q2" vid="SNG 7:13">ແລະ ຢູ່​ທີ່​ປະຕູ​ຂອງ​ພວກເຮົາ​ກໍ​ມີ​ໝາກໄມ້​ແຊບ​ທີ່​ສຸດ,</para>
  <para style="q1" vid="SNG 7:13">ມີ​ທັງ​ໝາກ​ທີ່​ຫາ​ກໍ​ສຸກ ແລະ ໝາກ​ທີ່​ສຸກ​ເຕັມ​ທີ່​ແລ້ວ,</para>
  <para style="q2" vid="SNG 7:13">ເຊິ່ງ​ຂ້ອຍ​ໄດ້​ເກັບ​ຮວບຮວມ​ໄວ້​ໃຫ້​ເຈົ້າ, ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ.<verse eid="SNG 7:13" /></para>
  <para style="b" />
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1" />ຖ້າ​ເຈົ້າ​ເປັນ​ພຽງ​ແຕ່​ອ້າຍ​ຂອງ​ຂ້ອຍ,</para>
  <para style="q2" vid="SNG 8:1">ທີ່​ດູດ​ນ້ຳນົມ​ຈາກ​ນົມ​ຂອງ​ແມ່​ຂອງ​ຂ້ອຍ!</para>
  <para style="q1" vid="SNG 8:1">ຂ້ອຍ​ກໍ​ຈະ​ຈູບ​ເຈົ້າ​ໄດ້</para>
  <para style="q2" vid="SNG 8:1">ເມື່ອ​ຂ້ອຍ​ພົບ​ເຈົ້າ​ຢູ່​ທາງ​ນອກ,</para>
  <para style="q2" vid="SNG 8:1">ແລະ ຈະ​ບໍ່​ມີ​ຜູ້ໃດ​ດູຖູກ​ຂ້ອຍ.<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />ຂ້ອຍ​ຈະ​ພາ​ເຈົ້າ</para>
  <para style="q2" vid="SNG 8:2">ໄປ​ທີ່​ເຮືອນ​ຂອງ​ແມ່​ຂອງ​ຂ້ອຍ</para>
  <para style="q2" vid="SNG 8:2">ຜູ້​ທີ່​ໄດ້​ສັ່ງສອນ​ຂ້ອຍ.</para>
  <para style="q1" vid="SNG 8:2">ຂ້ອຍ​ຈະ​ໃຫ້​ເຈົ້າ​ດື່ມ​ເຫລົ້າອະງຸ່ນ​ໃສ່​ເຄື່ອງເທດ,</para>
  <para style="q2" vid="SNG 8:2">ເປັນ​ເຫລົ້າ​ໝາກ​ພິລາ​ຫວານ​ນຸ້ມນວນ.<verse eid="SNG 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />ແຂນ​ຊ້າຍ​ຂອງ​ລາວ​ປະຄອງ​ຫົວ​ຂ້ອຍ,</para>
  <para style="q2" vid="SNG 8:3">ແລະ ແຂນ​ຂວາ​ຂອງ​ລາວ​ກໍ​ໂອບກອດ​ຂ້ອຍ​ໄວ້.<verse eid="SNG 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4" />ບັນດາ​ລູກສາວ​ຊາວ​ເຢຣູຊາເລັມ, ຂ້ອຍ​ຂໍ​ຢ້ຳ​ເຈົ້າ​ວ່າ:</para>
  <para style="q2" vid="SNG 8:4">ຢ່າ​ກະຕຸ້ນ ຫລື ປຸກ​ຄວາມ​ຮັກ</para>
  <para style="q2" vid="SNG 8:4">ຈົນ​ປ່ອຍ​ມັນ​ໃຫ້​ເປັນ​ໄປ​ຕາມ​ຄວາມ​ປາຖະໜາ.<verse eid="SNG 8:4" /></para>
  <para style="sp">ໝູ່​ເພື່ອນ</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />ແມ່ນ​ຜູ້ໃດ​ນໍ​ທີ່​ກໍາລັງ​ອອກ​ມາ​ຈາກ​ຖິ່ນແຫ້ງແລ້ງກັນດານ</para>
  <para style="q2" vid="SNG 8:5">ກໍາລັງ​ເອື່ອຍ​ແນບ​ຄົນ​ຮັກ​ຂອງ​ນາງ​ມາ?</para>
  <para style="sp" vid="SNG 8:5">ຍິງ​ສາວ</para>
  <para style="q1" vid="SNG 8:5">ຢູ່​ກ້ອງ​ຕົ້ນ​ແອັບເປີ້ນ;</para>
  <para style="q2" vid="SNG 8:5">ເຊິ່ງ​ແມ່​ຂອງ​ເຈົ້າ​ໃຫ້​ກຳເນີດ​ເຈົ້າ​ດ້ວຍ​ຄວາມ​ເຈັບປວດ,</para>
  <para style="q2" vid="SNG 8:5">ຂ້ອຍ​ໄດ້​ປຸກ​ຄວາມ​ຮັກ​ຂອງ​ເຈົ້າ​ຢູ່​ທີ່​ນັ້ນ.<verse eid="SNG 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />ຂໍ​ໃຫ້​ຂ້ອຍ​ເປັນ​ດັ່ງ​ຕາປະທັບ​ທີ່​ປະທັບ​ຢູ່​ທີ່​ໃຈ​ຂອງ​ເຈົ້າ,</para>
  <para style="q2" vid="SNG 8:6">ແລະ ທີ່​ແຂນ​ຂອງ​ເຈົ້າ ເພື່ອ​ສະແດງ​ວ່າ​ເຈົ້າ​ເປັນ​ຂອງ​ຂ້ອຍ;</para>
  <para style="q1" vid="SNG 8:6">ເພາະ​ຄວາມ​ຮັກ​ມີ​ອຳນາດ​ເໝືອນ​ຄວາມ​ຕາຍ,</para>
  <para style="q2" vid="SNG 8:6">ແລະ ຄວາມ​ຫຶງຫວງ<note caller="+" style="f"><char style="fr" closed="false">8:6 </char><char style="ft" closed="false">ຫລື ຄວາມ​ຮ້ອນຮົນ</char></note>​ກໍ​ບໍ່​ຍອມແພ້​ເໝືອນ​ຂຸມ​ຝັງ​ສົບ.</para>
  <para style="q1" vid="SNG 8:6">ຄວາມ​ຮັກ​ນັ້ນ​ກໍາລັງ​ເຜົາໄໝ້​ດັ່ງ​ໄຟ,</para>
  <para style="q2" vid="SNG 8:6">ປຽບ​ເໝືອນ​ແປວ​ໄຟ​ແຮງ​ກ້າ.<note caller="+" style="f"><char style="fr" closed="false">8:6 </char><char style="ft" closed="false">ຫລື ແປວໄຟ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</char></note><verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />ນ້ຳ​ຫລາຍ​ສາຍ​ກໍ​ບໍ່​ອາດ​ດັບ​ໄຟ​ຮັກ;</para>
  <para style="q2" vid="SNG 8:7">ແມ່ນ້ຳ​ບໍ່​ອາດ​ພັດ​ຄວາມ​ຮັກ​ອອກ​ໄປ​ໄດ້.</para>
  <para style="q1" vid="SNG 8:7">ຖ້າ​ຜູ້ໃດ​ຈະ​ທຸ້ມ​ຊັບສິນ​ຈົນ​ໝົດ​ໂຕ</para>
  <para style="q2" vid="SNG 8:7">ເພື່ອ​ແລກ​ກັບ​ຄວາມ​ຮັກ,</para>
  <para style="q2" vid="SNG 8:7">ຜູ້​ນັ້ນ​ກໍ​ຈະ​ຖືກ​ດູຖູກ​ຫລາຍ​ທີ່​ສຸດ.<verse eid="SNG 8:7" /></para>
  <para style="sp">ໝູ່​ເພື່ອນ</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />ພວກເຮົາ​ມີ​ນ້ອງສາວ​ນ້ອຍ​ຄົນ​ໜຶ່ງ,</para>
  <para style="q2" vid="SNG 8:8">ແລະ ນົມ​ຂອງ​ນາງ​ກໍ​ຍັງ​ບໍ່​ທັນ​ໃຫຍ່.</para>
  <para style="q1" vid="SNG 8:8">ພວກເຮົາ​ຈະ​ເຮັດ​ແນວໃດ​ກັບ​ນ້ອງສາວ​ພວກເຮົາ​ຂອງ​ພວກເຮົາ</para>
  <para style="q2" vid="SNG 8:8">ໃນ​ວັນ​ທີ່​ມີ​ຄົນ​ມາ​ສູ່ຂໍ​ນາງ?<verse eid="SNG 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />ຖ້າ​ຫາກ​ນາງ​ເປັນ​ກຳແພງ,</para>
  <para style="q2" vid="SNG 8:9">ພວກເຮົາ​ກໍ​ຈະ​ສ້າງ​ຫໍຄອຍ​ເງິນ​ຢູ່​ເທິງ​ກໍາແພງ​ນັ້ນ.</para>
  <para style="q1" vid="SNG 8:9">ຖ້າ​ນາງ​ເປັນ​ປະຕູ,</para>
  <para style="q2" vid="SNG 8:9">ພວກເຮົາ​ກໍ​ຈະ​ໃສ່​ກອນ​ນາງ​ໄວ້​ດ້ວຍ​ໄມ້ສີດາ.<verse eid="SNG 8:9" /></para>
  <para style="sp">ຍິງ​ສາວ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10" />ຂ້ອຍ​ເປັນ​ກຳແພງ,</para>
  <para style="q2" vid="SNG 8:10">ແລະ ນົມ​ຂອງ​ຂ້ອຍ​ເໝືອນ​ຫໍຄອຍ.</para>
  <para style="q1" vid="SNG 8:10">ໃນ​ສາຍ​ຕາ​ຂອງ​ທີ່​ຮັກ</para>
  <para style="q2" vid="SNG 8:10">ຂ້ອຍ​ເປັນ​ເໝືອນ​ຄົນ​ທີ່​ນຳ​ຄວາມ​ອິ່ມ​ໃຈ​ມາ.<verse eid="SNG 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />ໂຊໂລໂມນ​ມີ​ສວນອະງຸ່ນ​ແຫ່ງ​ໜຶ່ງ​ຢູ່​ທີ່​ບາອານຮາໂມນ.</para>
  <para style="q2" vid="SNG 8:11">ເພິ່ນ​ໄດ້​ເອົາ​ສວນອະງຸ່ນ​ຂອງ​ຕົນ​ໃຫ້​ຄົນ​ເຊົ່າ.</para>
  <para style="q1" vid="SNG 8:11">ເກັບ​ຄ່າ​ເຊົ່າ​ເປັນ​ເງິນ</para>
  <para style="q2" vid="SNG 8:11">ໜັກ​ຄົນ​ລະ 1.000 ເຊເຂວ.<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">ໜັກ​ປະມານ 12 ກິໂລກຣາມ ເຊັ່ນ​ດຽວ​ກັບ​ຂໍ້ <char style="xt" link-href="SNG 8:12"><ref loc="SNG 8:12">12</ref></char></char></note><verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />ແຕ່​ສຳລັບ​ສວນອະງຸ່ນ​ຂອງ​ຂ້ອຍ​ເອງ ກໍ​ແລ້ວ​ແຕ່​ຂ້ອຍ​ຈະ​ໃຫ້​ຜູ້ໃດ;</para>
  <para style="q2" vid="SNG 8:12">ໂຊໂລໂມນ, ເງິນ 1.000 ເຊເຂວ​ນັ້ນ​ເປັນ​ຂອງ​ທ່ານ,</para>
  <para style="q2" vid="SNG 8:12">ແລະ 200 ເຊເຂວ​ນັ້ນ​ເປັນ​ຂອງ​ບັນດາ​ຜູ້​ເບິ່ງແຍງ​ສວນ.<verse eid="SNG 8:12" /></para>
  <para style="sp">ຊາຍ​ໜຸ່ມ</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />ເຈົ້າ​ຜູ້​ທີ່​ຢູ່​ໃນ​ສວນ</para>
  <para style="q2" vid="SNG 8:13">ອ້ອມ​ຮອບ​ໄປ​ດ້ວຍ​ໝູ່​ເພື່ອນ,</para>
  <para style="q2" vid="SNG 8:13">ຂໍ​ໃຫ້​ຂ້ອຍ​ໄດ້​ຍິນ​ສຽງ​ຂອງ​ເຈົ້າ!<verse eid="SNG 8:13" /></para>
  <para style="sp">ຍິງ​ສາວ</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14" />ຈົ່ງ​ມາ ທີ່​ຮັກ​ຂອງ​ຂ້ອຍ,</para>
  <para style="q2" vid="SNG 8:14">ແລະ ຂໍ​ໃຫ້​ເຈົ້າ​ເປັນ​ເໝືອນ​ເຍືອງ</para>
  <para style="q1" vid="SNG 8:14">ຫລື ເປັນ​ເໝືອນ​ກວາງ​ໜຸ່ມ​ເທິງ​ພູເຂົາ</para>
  <para style="q2" vid="SNG 8:14">ທີ່​ເຕັມ​ໄປ​ດ້ວຍ​ເຄື່ອງເທດ.<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>