<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Biblica® Open Lao Contemporary Version</book>
  <para style="rem">Copyright © 2023, 2025 by Biblica, Inc.</para>
  <para style="h">ສຸພາສິດ</para>
  <para style="toc1">ພຣະທຳສຸພາສິດ</para>
  <para style="toc2">ສຸພາສິດ</para>
  <para style="toc3">ສພສ</para>
  <para style="mt1">ພຣະທຳສຸພາສິດ</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="ms1">ຈຸດປະສົງ ແລະ ຫົວໃຈ​ຂອງ​ສຸພາສິດ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />ສຸພາສິດ​ຂອງ​ໂຊໂລໂມນ​ລູກຊາຍ​ຂອງ​ດາວິດ, ກະສັດ​ແຫ່ງ​ອິດສະຣາເອນ:<verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />ເພື່ອ​ໃຫ້​ເກີດ​ມີ​ປັນຍາ ແລະ ໄດ້​ຮັບ​ຄຳ​ແນະນໍາ;</para>
  <para style="q2" vid="PRO 1:2">ເພື່ອ​ຄວາມ​ເຂົ້າໃຈ​ເຖິງ​ຖ້ອຍຄຳ​ທີ່​ມີ​ຄວາມໝາຍ​ອັນ​ເລິກເຊິ່ງ;<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />ເພື່ອ​ຮັບ​ຟັງ​ຄຳ​ສັ່ງສອນ​ໃນ​ການ​ປະພຶດ​ຢ່າງ​ສະຫລາດ,</para>
  <para style="q2" vid="PRO 1:3">ເຮັດ​ໃນ​ສິ່ງ​ທີ່​ຖືກຕ້ອງ, ຍຸຕິທຳ ແລະ ທ່ຽງທຳ;<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />ເພື່ອ​ໃຫ້​ຄົນ​ທີ່​ອ່ອນ​ຕໍ່​ໂລກ<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">ຄຳ​ພາສາ​ເຮັບເຣີ ຄຳ​ວ່າ​ອ່ອນ​ຕໍ່​ໂລກ​ໃນ​ໜັງສື​ສຸພາສິດ​ໝາຍ​ເຖິງ​ຄົນ​ຫູ​ເບົາ​ບໍ່​ມີ​ສິນທຳ ແລະ ຫັນ​ໄປ​ຫາ​ຄວາມ​ຊົ່ວ</char></note>​ຮູ້​ທັນ​ເລ່ຫລຽ່ມ</para>
  <para style="q2" vid="PRO 1:4">ໃຫ້​ຄວາມຮູ້ ແລະ ແນວທາງ​ອັນ​ຖືກຕ້ອງ​ແກ່​ຄົນໜຸ່ມ<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />ໃຫ້​ຄົນ​ສະຫລາດ​ຮັບ​ຟັງ ແລະ ເພີ່ມພູນ​ການ​ຮຽນຮູ້​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 1:5">ແລະ ໃຫ້​ຄົນ​ທີ່​ມີ​ວິຈາລະຍານ​ໄດ້​ຮັບ​ການ​ແນະນໍາ<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />ເພື່ອ​ໃຫ້​ເຂົ້າໃຈ​ບັນດາ​ຄໍາ​ສຸພາສິດ ແລະ ຄຳ​ອຸປະມາ,</para>
  <para style="q2" vid="PRO 1:6">ບັນດາ​ຄຳສອນ ແລະ ຄຳ​ປິດສະໜາ​ຂອງ​ນັກປາດ.<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">ຫລື ເພື່ອ​ໃຫ້​ເຂົ້າໃຈ​ສຸພາສິດ ໄດ້​ແກ່ ຄຳ​ອຸປະມາ ຄຳ​ສອນ ແລະ ຄຳ​ປິດສະໜາ​ຂອງ​ນັກປາດ</char></note><verse eid="PRO 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />ການ​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ​ເປັນ​ບໍ່​ເກີດ​ແຫ່ງ​ຄວາມ​ຮູ້,</para>
  <para style="q2" vid="PRO 1:7">ສ່ວນ​ຄົນ​ໂງ່<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">ໃນ​ພາສາ​ເຮັບເຣີ​ຄຳ​ວ່າ ຄົນ​ໂງ່ ໃນ​ພະທຳ​ສຸພາສິດ ແລະ ທີ່​ອື່ນໆ ໃນ​ພັນທະສັນຍາ​ເດີມ​ໝາຍ​ເຖິງ​ຄົນ​ທີ່​ບົກຜ່ອງ​ທາງ​ດ້ານ​ສິນທຳ</char></note>​ປະໝາດ​ປັນຍາ ແລະ ຄຳ​ສັ່ງສອນ.<verse eid="PRO 1:7" /></para>
  <para style="ms1">ບົດນຳ: ຄຳ​ເຕືອນ​ໃຫ້​ໂອບ​ກອດ​ເອົາ​ປັນຍາ</para>
  <para style="s1">ຄໍາ​ເຕືອນ​ຕໍ່ສູ້​ການ​ເຊື້ອເຊີນ​ຂອງ​ຄົນ​ບາບ</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />ຈົ່ງ​ຟັງ, ລູກ​ຂອງ​ພໍ່, ຈົ່ງ​ເອົາໃຈໃສ່​ຄຳ​ສັ່ງສອນ​ຂອງ​ພໍ່​ເຈົ້າ</para>
  <para style="q2" vid="PRO 1:8">ແລະ ຢ່າ​ປະຖິ້ມ​ຄຳສອນ​ຂອງ​ແມ່​ເຈົ້າ.<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />ສິ່ງ​ເຫລົ່ານີ້​ເປັນ​ພວງມະໄລ​ປະດັບ​ຫົວ​ຂອງ​ເຈົ້າ</para>
  <para style="q2" vid="PRO 1:9">ແລະ ເປັນ​ສາຍຄໍ​ເພື່ອ​ປະດັບ​ຄໍ​ຂອງ​ເຈົ້າ.<verse eid="PRO 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />ລູກ​ຂອງ​ພໍ່, ຖ້າ​ຄົນ​ບາບ​ມາ​ຊັກຊວນ​ເຈົ້າ,</para>
  <para style="q2" vid="PRO 1:10">ຢ່າ​ຍອມ​ເຮັດ​ຕາມ​ພວກເຂົາ.<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />ຖ້າ​ພວກເຂົາ​ເວົ້າ​ວ່າ, “ຈົ່ງ​ມາ​ກັບ​ພວກເຮົາ;</para>
  <para style="q2" vid="PRO 1:11">ໃຫ້​ພວກເຮົາ​ດັກ​ລໍຖ້າ​ເອົາ​ເລືອດ​ບໍລິສຸດ,</para>
  <para style="q2" vid="PRO 1:11">ໃຫ້​ພວກເຮົາ​ດັກຊຸ້ມ​ໂຈມຕີ​ຄົນ​ບໍລິສຸດ;<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />ໃຫ້​ພວກເຮົາ​ເປັນ​ເໝືອນ​ຂຸມ​ຝັງ​ສົບ​ທີ່​ກືນ​ພວກເຂົາ​ທັງ​ເປັນ,</para>
  <para style="q2" vid="PRO 1:12">ແລະ ກືນ​ກິນ​ພວກເຂົາ​ໝົດ​ໂຕ, ເໝືອນ​ກັບ​ບັນດາ​ຄົນ​ທີ່​ຕົກ​ລົງ​ໄປ​ໃນ​ຂຸມ;<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />ພວກເຮົາ​ຈະ​ຢຶດ​ເຄື່ອງ​ຂອງ​ມີ​ຄ່າ​ທຸກ​ຊະນິດ</para>
  <para style="q2" vid="PRO 1:13">ແລະ ເອົາ​ເຄື່ອງ​ຂອງ​ທີ່​ປຸ້ນ​ມາ​ເກັບ​ໄວ້​ໃຫ້​ເຕັມ​ເຮືອນ​ຂອງ​ພວກເຮົາ;<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />ມາ​ຈັບ​ສະຫລາກ​ຮ່ວມ​ກັບ​ພວກເຮົາ;</para>
  <para style="q2" vid="PRO 1:14">ພວກເຮົາ​ທຸກຄົນ​ຈະ​ໄດ້​ໃຊ້​ເງິນ​ຖົງ​ດຽວ​ກັນ”<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />ລູກ​ຂອງ​ພໍ່, ຢ່າ​ໄປ​ຮ່ວມ​ທາງ​ກັບ​ພວກເຂົາ,</para>
  <para style="q2" vid="PRO 1:15">ຢ່າ​ຍ່າງ​ໃນ​ທາງ​ຂອງ​ພວກເຂົາ;<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />ເພາະ​ຕີນ​ຂອງ​ພວກເຂົາ​ແລ່ນ​ໄປ​ຫາ​ຄວາມ​ຊົ່ວຮ້າຍ,</para>
  <para style="q2" vid="PRO 1:16">ພວກເຂົາ​ຟ້າວ​ເຮັດ​ໃຫ້​ເລືອດ​ຕົກ.<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />ບໍ່​ມີ​ປະໂຫຍດ​ຫຍັງ​ທີ່​ຈະ​ກາງ​ຕາໜ່າງ​ໄວ້</para>
  <para style="q2" vid="PRO 1:17">ໃນ​ບ່ອນ​ທີ່​ນົກ​ທຸກ​ໂຕ​ສາມາດ​ເບິ່ງ​ເຫັນ!<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />ຄົນ​ເຫລົ່ານີ້​ດັກ​ລໍຖ້າ​ເອົາ​ເລືອດ​ຂອງ​ຕົນ​ເອງ;</para>
  <para style="q2" vid="PRO 1:18">ພວກເຂົາ​ດັກຊຸ້ມ​ເອົາ​ຊີວິດ​ຕົນ​ເອງ!<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />ວິຖີ​ທາງ​ຂອງ​ທຸກ​ຄົນ​ທີ່​ຫາ​ຜົນປະໂຫຍດ​ອັນ​ຊົ່ວຊ້າ​ກໍ​ເປັນ​ເຊັ່ນ​ນີ້;</para>
  <para style="q2" vid="PRO 1:19">ມັນ​ຈະ​ເອົາ​ຊີວິດ​ຂອງ​ບັນດາ​ຜູ້​ທີ່​ຮັບ​ເອົາ​ມັນ​ໄວ້​ໄປ​ເອງ.<verse eid="PRO 1:19" /></para>
  <para style="s1">ການ​ຕໍາໜິ​ຂອງ​ປັນຍາ</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />ປັນຍາ​ຮ້ອງ​ດັງ​ອອກ​ມາ​ຢ່າງ​ເປີດ​ເຜີຍ,</para>
  <para style="q2" vid="PRO 1:20">ນາງ​ເປັ່ງ​ສຽງ​ຂອງ​ຕົນ​ຢູ່​ທີ່​ເດີ່ນ​ສາທາລະນະ;<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />ນາງ​ຮ້ອງ​ຫາ​ຢູ່​ເທິງ​ຍອດ​ກຳແພງ,<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">ຫລື ຢູ່​ຫົວ​ຖະໜົນ</char></note></para>
  <para style="q2" vid="PRO 1:21">ນາງ​ຮ້ອງ​ບອກ​ທີ່​ປະຕູ​ເມືອງ​ວ່າ:<verse eid="PRO 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />“ເຈົ້າ​ຜູ້​ບໍ່ຮູ້ຈັກຄິດ, ເຈົ້າ​ຈະ​ຮັກ​ວິຖີ​ທາງ​ອັນ​ໂງ່​ຈ້າ​ອີກ​ດົນ​ປານໃດ?</para>
  <para style="q2" vid="PRO 1:22">ຄົນ​ທີ່​ມັກ​ເຢາະເຢີ້ຍ, ເຈົ້າ​ຈະ​ພໍໃຈ​ການ​ດູຖູກ​ອີກ​ດົນ​ປານໃດ?</para>
  <para style="q2" vid="PRO 1:22">ແລະ ຄົນ​ໂງ່ຈ້າ​ຈະ​ກຽດ​ຊັງ​ຄວາມ​ຮູ້​ອີກ​ດົນ​ປານໃດ?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />ຈົ່ງ​ກັບ​ໃຈ​ຟັງ​ຄຳ​ຕັກເຕືອນ​ຂອງ​ເຮົາ!</para>
  <para style="q2" vid="PRO 1:23">ແລ້ວ​ເຮົາ​ຈະ​ເທ​ຄວາມ​ຄິດ​ຕ່າງໆ​ຂອງ​ເຮົາ​ໃຫ້​ແກ່​ເຈົ້າ,</para>
  <para style="q2" vid="PRO 1:23">ແລະ ເຮົາ​ຈະ​ໃຫ້​ເຈົ້າ​ເຂົ້າໃຈ​ຄຳ​ສັ່ງສອນ​ຂອງ​ເຮົາ.<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />ແຕ່​ເພາະ​ເຈົ້າ​ປະຕິເສດ​ທີ່​ຈະ​ຟັງ ເມື່ອ​ເຮົາ​ເອີ້ນ​ຫາ​ເຈົ້າ</para>
  <para style="q2" vid="PRO 1:24">ແລະ ບໍ່​ມີ​ຜູ້ໃດ​ສົນໃຈ​ເມື່ອ​ເຮົາ​ຍື່ນ​ມື​ໄປ​ຫາ,<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />ເພາະ​ເຈົ້າ​ເມີນ​ເສີຍ​ຕໍ່​ຄຳ​ແນະນຳ​ທັງໝົດ​ຂອງ​ເຮົາ</para>
  <para style="q2" vid="PRO 1:25">ແລະ ບໍ່​ຍອມຮັບ​ຄຳ​ຕັກເຕືອນ​ຂອງ​ເຮົາ,<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />ສະນັ້ນ, ເມື່ອ​ໄພພິບັດ​ໂຈມ​ຕີ​ເຈົ້າ, ເຮົາ​ຈະ​ຫົວຂວັນ​ໃສ່​ເຈົ້າ;</para>
  <para style="q2" vid="PRO 1:26">ເຮົາ​ຈະ​ເຢາະເຢີ້ຍ ເມື່ອ​ຄວາມ​ຈິບຫາຍ​ມາ​ເຖິງ​ເຈົ້າ<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />ເມື່ອ​ຄວາມ​ຈິບຫາຍ​ມາ​ເຖິງ​ເຈົ້າ​ດັ່ງ​ພະຍຸ,</para>
  <para style="q2" vid="PRO 1:27">ເມື່ອ​ຄວາມ​ພິນາດ​ພັດ​ໃສ່​ເຈົ້າ​ດັ່ງ​ລົມ​ພະຍຸ​ໝຸນ,</para>
  <para style="q2" vid="PRO 1:27">ເມື່ອ​ຄວາມ​ເດືອດຮ້ອນ ແລະ ຄວາມ​ລຳບາກ​ຖ້ວມ​ເຈົ້າ.<verse eid="PRO 1:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />“ເມື່ອ​ນັ້ນ ພວກເຂົາ​ຈະ​ເອີ້ນ​ຫາ​ເຮົາ ແຕ່​ເຮົາ​ຈະ​ບໍ່​ຕອບ;</para>
  <para style="q2" vid="PRO 1:28">ພວກເຂົາ​ຈະ​ຊອກ​ຫາ​ເຮົາ ແຕ່​ຈະ​ບໍ່​ພົບ​ເຮົາ,<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />ເພາະ​ພວກເຂົາ​ໄດ້​ກຽດຊັງ​ຄວາມ​ຮູ້</para>
  <para style="q2" vid="PRO 1:29">ແລະ ເລືອກ​ທີ່​ຈະ​ບໍ່​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ.<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />ເພາະ​ພວກເຂົາ​ບໍ່​ຍອມຮັບ​ຄຳ​ແນະນຳ​ຂອງ​ເຮົາ</para>
  <para style="q2" vid="PRO 1:30">ແລະ ໄດ້​ປະຕິເສດ​ຄຳ​ຕັກເຕືອນ​ຂອງ​ເຮົາ,<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />ພວກເຂົາ​ຈະ​ໄດ້​ກິນ​ຜົນ​ຈາກ​ວິຖີ​ທາງ​ຂອງ​ພວກເຂົາ</para>
  <para style="q2" vid="PRO 1:31">ແລະ ອິ່ມ​ເຕັມ​ໄປ​ດ້ວຍ​ຜົນ​ຈາກ​ແຜນການ​ຮ້າຍ​ຂອງ​ຕົນ.<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />ຄົນ​ອ່ອນ​ຕໍ່​ໂລກ​ຈະ​ຕາຍ​ເພາະ​ຫັນ​ອອກ​ນອກ​ທາງ,</para>
  <para style="q2" vid="PRO 1:32">ແລະ ຄວາມ​ເມີນເສີຍ​ຂອງ​ຄົນ​ໂງ່ຈ້າ​ຈະ​ທຳລາຍ​ພວກເຂົາ;<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />ແຕ່​ຜູ້​ທີ່​ຮັບ​ຟັງ​ເຮົາ​ຈະ​ອາໄສ​ຢູ່​ຢ່າງ​ປອດໄພ</para>
  <para style="q2" vid="PRO 1:33">ແລະ ຈະ​ສະບາຍ​ໃຈ​ໂດຍ​ບໍ່​ຢ້ານ​ໄພ​ອັນຕະລາຍ”.<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">ຜົນດີ​ທາງ​ສິນທໍາ​ຂອງ​ປັນຍາ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />ລູກ​ຂອງ​ພໍ່, ຖ້າ​ເຈົ້າ​ຍອມຮັບ​ຄຳສອນ​ຂອງ​ພໍ່</para>
  <para style="q2" vid="PRO 2:1">ແລະ ເກັບ​ຮັກສາ​ຄຳສັ່ງ​ຂອງ​ພໍ່​ໄວ້​ຢູ່​ພາຍໃນ​ເຈົ້າ,<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />ຈົ່ງ​ງ່ຽງ​ຫູ​ຂອງ​ເຈົ້າ​ໄປ​ຟັງ​ປັນຍາ</para>
  <para style="q2" vid="PRO 2:2">ແລະ ເອົາ​ໃຈ​ໃສ່​ປະຕິບັດ​ຕາມ​ຄວາມ​ເຂົ້າໃຈ​ນັ້ນ<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />ແທ້ຈິງແລ້ວ, ຖ້າ​ເຈົ້າ​ເອີ້ນ​ຫາ​ຄວາມ​ຮູ້</para>
  <para style="q2" vid="PRO 2:3">ແລະ ຮ້ອງ​ຫາ​ຄວາມ​ເຂົ້າໃຈ,<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />ແລະ ຖ້າ​ເຈົ້າ​ຊອກຫາ​ປັນຍາ​ດັ່ງ​ຫາ​ເງິນ</para>
  <para style="q2" vid="PRO 2:4">ແລະ ຄົ້ນຫາ​ປັນຍາ​ດັ່ງ​ຂຸມ​ຊັບ​ທີ່​ຖືກ​ເຊື່ອງ​ໄວ້,<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />ແລ້ວ​ເຈົ້າ​ຈະ​ເຂົ້າໃຈ​ເຖິງ​ການ​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q2" vid="PRO 2:5">ແລະ ພົບ​ຄວາມ​ຮູ້​ຂອງ​ພຣະເຈົ້າ.<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />ເພາະ​ພຣະເຈົ້າ​ຢາເວ​ເປັນ​ຜູ້​ໃຫ້​ປັນຍາ;</para>
  <para style="q2" vid="PRO 2:6">ຄວາມ​ຮູ້ ແລະ ຄວາມ​ເຂົ້າໃຈ​ກໍ​ອອກ​ມາ​ຈາກ​ປາກ​ຂອງ​ພຣະອົງ.<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />ພຣະອົງ​ຖື​ຮັກສາ​ຄວາມ​ສໍາເລັດ<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">ຫລື ຄວາມ​ສຳ​ເລັດ</char></note> ໄວ້​ໃຫ້​ຄົນ​ທ່ຽງທຳ,</para>
  <para style="q2" vid="PRO 2:7">ພຣະອົງ​ເປັນ​ໂລ່​ໃຫ້​ຜູ້​ທີ່​ດຳເນີນ​ຊີວິດ​ຢ່າງ​ບໍ່​ມີ​ຕໍາໜິ,<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />ເພາະ​ພຣະອົງ​ເຝົ້າ​ຮັກສາ​ທາງ​ຂອງ​ຜູ້​ທີ່​ທ່ຽງທຳ</para>
  <para style="q2" vid="PRO 2:8">ແລະ ປົກປ້ອງ​ຮັກສາ​ທາງ​ຂອງ​ຜູ້​ທີ່​ສັດຊື່​ຂອງ​ພຣະອົງ.<verse eid="PRO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />ແລ້ວ​ເຈົ້າ​ຈະ​ເຂົ້າໃຈ​ສິ່ງ​ທີ່​ຖືກຕ້ອງ ແລະ ຍຸຕິທຳ</para>
  <para style="q2" vid="PRO 2:9">ແລະ ຄວາມ​ທ່ຽງທຳ​ຄື ເຂົ້າໃຈ​ທາງ​ອັນ​ດີ​ທຸກຢ່າງ,<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />ເພາະ​ປັນຍາ​ຈະ​ເຂົ້າ​ໄປ​ໃນ​ຫົວໃຈ​ຂອງ​ເຈົ້າ</para>
  <para style="q2" vid="PRO 2:10">ແລະ ຄວາມ​ຮູ້​ຈະ​ເຮັດ​ໃຫ້​ຈິດ​ວິນຍານ​ຂອງ​ເຈົ້າ​ຍິນດີ.<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />ຄວາມ​ຮອບຄອບ​ຈະ​ປົກປ້ອງ​ເຈົ້າ,</para>
  <para style="q2" vid="PRO 2:11">ແລະ ຄວາມ​ເຂົ້າໃຈ​ຈະ​ເຝົ້າ​ຮັກສາ​ເຈົ້າ.<verse eid="PRO 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />ປັນຍາ​ຈະ​ຊ່ວຍ​ເຈົ້າ​ໃຫ້​ພົ້ນ​ຈາກ​ທາງ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ,</para>
  <para style="q2" vid="PRO 2:12">ປັນຍາ​ຈະ​ຊ່ວຍ​ເຈົ້າ​ໃຫ້​ພົ້ນ​ຈາກ​ຜູ້​ທີ່​ມັກ​ປີ້ນ​ຄວາມ.<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />ຜູ້​ທີ່​ປະຖິ້ມ​ວິຖີທາງ​ອັນ​ຊອບທໍາ</para>
  <para style="q2" vid="PRO 2:13">ກໍ​ຈະ​ເດີນ​ໄປ​ໃນ​ທາງ​ທີ່​ມືດ,<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />ຜູ້​ທີ່​ພໍໃຈ​ໃນ​ການ​ກະທໍາ​ຜິດ</para>
  <para style="q2" vid="PRO 2:14">ແລະ ຊື່ນຊົມ​ໃນ​ການ​ປະພຶດ​ຊົ່ວ,<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />ເສັ້ນທາງ​ຂອງ​ພວກເຂົາ​ກໍ​ຄົດ​ງໍ</para>
  <para style="q2" vid="PRO 2:15">ແລະ ວິຖີທາງ​ຂອງ​ພວກເຂົາ​ກໍ​ຄົດໂກງ.<verse eid="PRO 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />ປັນຍາ​ຍັງ​ຈະ​ຊ່ວຍ​ເຈົ້າ​ໃຫ້​ພົ້ນ​ຈາກ​ຍິງ​ຫລິ້ນຊູ້,</para>
  <para style="q2" vid="PRO 2:16">ຈາກ​ຍິງ​ຂ້າງ​ທາງ​ດ້ວຍ​ຄຳເວົ້າ​ອັນ​ລໍ້ລວງ​ຂອງ​ນາງ,<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />ຜູ້​ທີ່​ປະຖິ້ມ​ຄູ່​ຊີວິດ​ຂອງ​ນາງ​ທີ່​ຢູ່​ນໍາ​ກັນ​ມາ​ຕັ້ງ​ແຕ່​ໜຸ່ມ</para>
  <para style="q2" vid="PRO 2:17">ແລະ ລືມໄລ​ຕໍ່​ຄຳໝັ້ນສັນຍາ​ທີ່​ນາງ​ເຮັດ​ໄວ້​ຕໍ່ໜ້າ​ພຣະເຈົ້າ.<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">ຫລື ຄຳໝັ້ນສັນຍາ​ຂອງ​ພຣະເຈົ້າ​ຂອງ​ນາງ</char></note><verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />ບ້ານ​ຂອງ​ນາງ​ນຳ​ໄປ​ສູ່​ຄວາມ​ຕາຍ​ຢ່າງ​ແນ່ນອນ</para>
  <para style="q2" vid="PRO 2:18">ແລະ ທາງ​ຂອງ​ນາງ​ກໍ​ນໍາ​ໄປ​ສູ່​ວິນຍານ​ແຫ່ງ​ຄົນຕາຍ.<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />ບໍ່​ມີ​ຜູ້​ໃດ​ທີ່​ໄປ​ຫາ​ນາງ​ແລ້ວ​ໄດ້​ກັບ​ຄືນ​ມາ</para>
  <para style="q2" vid="PRO 2:19">ຫລື ກັບ​ເຂົ້າ​ໄປ​ສູ່​ຫົນ​ທາງ​ແຫ່ງ​ຊີວິດ​ໄດ້​ອີກ.<verse eid="PRO 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />ດັ່ງນັ້ນ ເຈົ້າ​ຈະ​ເດີນ​ໃນ​ທາງ​ທີ່​ດີ</para>
  <para style="q2" vid="PRO 2:20">ແລະ ຢຶດໝັ້ນ​ໃນ​ວິຖີທາງ​ອັນ​ຊອບທຳ<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />ເພາະ​ຄົນ​ທ່ຽງທຳ​ຈະ​ໄດ້​ອາໄສ​ໃນ​ດິນແດນ​ນັ້ນ,</para>
  <para style="q2" vid="PRO 2:21">ແລະ ຄົນ​ທີ່​ບໍ່​ມີ​ຕຳໜິ​ຈະ​ຕັ້ງ​ໝັ້ນຄົງ​ຢູ່​ທີ່​ນັ້ນ<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />ແຕ່​ຄົນ​ຊົ່ວ​ຮ້າຍ​ຈະ​ຖືກ​ຕັດ​ອອກ​ຈາກ​ດິນແດນ​ນັ້ນ,</para>
  <para style="q2" vid="PRO 2:22">ແລະ ຄົນ​ບໍ່​ສັດຊື່​ຈະ​ຖືກ​ຖອນ​ຮາກ​ອອກ​ຈາກ​ດິນແດນ​ນັ້ນ.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">ປັນຍາ​ເຮັດ​ໃຫ້​ມີ​ຄວາມ​ເປັນ​ຢູ່​ທີ່​ດີ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />ລູກ​ເອີຍ, ຢ່າ​ລືມ​ຄຳສັ່ງສອນ​ຂອງ​ພໍ່,</para>
  <para style="q2" vid="PRO 3:1">ແຕ່​ຈົ່ງ​ຮັກສາ​ຄຳສັ່ງ​ຂອງ​ພໍ່​ໄວ້​ໃນ​ໃຈ​ຂອງ​ເຈົ້າ,<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />ເພາະ​ສິ່ງ​ເຫລົ່ານີ້​ຈະ​ເຮັດ​ໃຫ້​ເຈົ້າ​ມີ​ຊີວິດ​ຍືນຍາວ</para>
  <para style="q2" vid="PRO 3:2">ແລະ ນຳ​ເອົາ​ສັນຕິສຸກ ແລະ ຄວາມ​ຈະເລີນ​ຮຸ່ງເຮືອງ​ມາ​ສູ່​ເຈົ້າ.<verse eid="PRO 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />ຢ່າ​ໃຫ້​ຄວາມ​ຮັກ ແລະ ຄວາມ​ສັດຊື່​ໜີ​ໄປ​ຈາກ​ເຈົ້າ;</para>
  <para style="q2" vid="PRO 3:3">ຈົ່ງ​ມັດ​ມັນ​ໄວ້​ອ້ອມ​ຄໍ​ຂອງ​ເຈົ້າ,</para>
  <para style="q2" vid="PRO 3:3">ຈົ່ງ​ຂຽນ​ມັນ​ໃສ່​ແຜ່ນ​ຫົວໃຈ​ຂອງ​ເຈົ້າ.<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />ແລ້ວ​ເຈົ້າ​ຈະ​ເປັນ​ທີ່​ພໍໃຈ ແລະ ມີ​ຊື່ສຽງ​ດີ</para>
  <para style="q2" vid="PRO 3:4">ໃນ​ສາຍຕາ​ພຣະເຈົ້າ ແລະ ໃນ​ສາຍຕາ​ມະນຸດ.<verse eid="PRO 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />ຈົ່ງ​ໄວ້ວາງໃຈ​ໃນ​ພຣະເຈົ້າ​ຢາເວ​ດ້ວຍ​ສຸດ​ໃຈ​ຂອງ​ເຈົ້າ</para>
  <para style="q2" vid="PRO 3:5">ແລະ ຢ່າ​ເພິ່ງພາ​ຄວາມ​ເຂົ້າໃຈ​ຂອງ​ເຈົ້າ​ເອງ;<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />ຈົ່ງ​ຍອມຈໍານົນ​ຕໍ່​ພຣະອົງ​ໃນ​ທຸກ​ວິຖີທາງ​ຂອງ​ເຈົ້າ,</para>
  <para style="q2" vid="PRO 3:6">ແລະ ພຣະອົງ​ຈະ​ເຮັດ​ໃຫ້​ທາງ​ຂອງ​ເຈົ້າ​ຊື່​ໄປ.<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">ຫລື ຈະ​ຊີ້​ທາງ​ໃຫ້</char></note><verse eid="PRO 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />ຢ່າ​ຄິດ​ວ່າ​ຕົນ​ເປັນ​ຄົນ​ສະຫລາດ;</para>
  <para style="q2" vid="PRO 3:7">ຈົ່ງ​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ ແລະ ຈົ່ງ​ຫລີກ​ໜີ​ຈາກ​ຄວາມ​ຊົ່ວຮ້າຍ.<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />ສິ່ງນີ້​ຈະ​ນໍາ​ສຸຂະພາບ​ທີ່​ດີ​ມາ​ສູ່​ຮ່າງກາຍ​ຂອງ​ເຈົ້າ</para>
  <para style="q2" vid="PRO 3:8">ແລະ ບໍາລຸງ​ລ້ຽງ​ກະດູກ​ຂອງ​ເຈົ້າ.<verse eid="PRO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />ຈົ່ງ​ໃຫ້​ກຽດ​ພຣະເຈົ້າ​ຢາເວ​ດ້ວຍ​ຊັບສິນ​ຂອງ​ເຈົ້າ,</para>
  <para style="q2" vid="PRO 3:9">ດ້ວຍ​ຜົນ​ທໍາອິດ​ຈາກ​ຜົນລະປູກ​ທັງໝົດ​ຂອງ​ເຈົ້າ;<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />ແລ້ວ​ເລົ້າເຂົ້າ​ຂອງ​ເຈົ້າ​ຈະ​ເຕັມ​ລົ້ນ,</para>
  <para style="q2" vid="PRO 3:10">ແລະ ຖັງ​ຂອງ​ເຈົ້າ​ຈະ​ເຕັມ​ໄປ​ດ້ວຍ​ເຫລົ້າ​ອະງຸ່ນ​ໃໝ່.<verse eid="PRO 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />ລູກ​ເອີຍ, ຢ່າ​ໜິ່ນ​ປະໝາດ​ການ​ຕີສອນ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ,</para>
  <para style="q2" vid="PRO 3:11">ຢ່າ​ຄຽດ​ຕໍ່​ຄໍາ​ຕັກເຕືອນ​ຂອງ​ພຣະອົງ,<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />ເພາະ​ພຣະເຈົ້າ​ຢາເວ​ຕີສອນ​ຜູ້​ທີ່​ພຣະອົງ​ຮັກ,</para>
  <para style="q2" vid="PRO 3:12">ເໝືອນດັ່ງ​ພໍ່​ຕີ​ສອນ​ລູກ​ຜູ້​ທີ່​ເພິ່ນ​ພູມໃຈ​ນຳ.<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">ສະບັບ LXX. ວ່າ ແລະ ພຣະອົງ​ລົງໂທດ​ບຸດ​ທີ່​ພຣະອົງ​ຊື່ນຊົມ</char></note><verse eid="PRO 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />ຄວາມ​ສຸກ​ເປັນ​ຂອງ​ຜູ້​ທີ່​ພົບ​ປັນຍາ,</para>
  <para style="q2" vid="PRO 3:13">ຜູ້​ທີ່​ໄດ້​ຮັບ​ຄວາມ​ເຂົ້າໃຈ,<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />ເພາະ​ປັນຍາ​ໃຫ້​ປະໂຫຍດ​ຫລາຍ​ກວ່າ​ເງິນ</para>
  <para style="q2" vid="PRO 3:14">ແລະ ໃຫ້​ຜົນ​ຕອບ​ແທນ​ຫລາຍ​ກວ່າ​ຄຳ.<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />ປັນຍາ​ມີ​ຄຸນຄ່າ​ຫລາຍ​ກວ່າ​ເພັດພອຍ;</para>
  <para style="q2" vid="PRO 3:15">ບໍ່ມີ​ສິ່ງໃດ​ທີ່​ເຈົ້າ​ປາຖະໜາ​ຈະ​ປຽບທຽບ​ກັບ​ປັນຍາ​ໄດ້.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />ໃນ​ມື​ຂວາ​ຂອງ​ປັນຍາ​ມີ​ຊີວິດ​ຍືນຍາວ;</para>
  <para style="q2" vid="PRO 3:16">ໃນ​ມື​ຊ້າຍ​ມີ​ຄວາມ​ຮັ່ງມີ ແລະ ກຽດ​ສັກສີ​ດ້ວຍ.<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />ທາງ​ຂອງ​ປັນຍາ​ເປັນ​ທາງ​ອັນ​ລາບລື່ນ</para>
  <para style="q2" vid="PRO 3:17">ວິຖີທາງ​ທັງສິ້ນ​ຂອງ​ປັນຍາ​ຄື​ສັນຕິສຸກ.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />ປັນຍາ​ເປັນ​ຕົ້ນໄມ້​ແຫ່ງ​ຊີວິດ​ແກ່​ຜູ້​ທີ່​ຢຶດ​ປັນຍາ​ໄວ້;</para>
  <para style="q2" vid="PRO 3:18">ຄວາມ​ສຸກ​ຈະ​ເປັນ​ຂອງ​ຜູ້​ທີ່​ຢຶດ​ປັນຍາ​ໄວ້​ໃຫ້​ແໜ້ນ.<verse eid="PRO 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />ດ້ວຍ​ປັນຍາ ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ວາງ​ຮາກຖານ​ຂອງ​ແຜ່ນດິນ​ໂລກ,</para>
  <para style="q2" vid="PRO 3:19">ດ້ວຍ​ຄວາມ​ເຂົ້າໃຈ ພຣະອົງ​ຕັ້ງ​ຟ້າ​ສະຫວັນ​ໄວ້​ໃນ​ທີ່​ນັ້ນ;<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />ດ້ວຍ​ຄວາມຮອບຮູ້​ຂອງ​ພຣະອົງ ນໍ້າເລິກ​ກໍ​ຖືກ​ແຍກ​ອອກ,</para>
  <para style="q2" vid="PRO 3:20">ແລະ ເມກ​ກໍ​ເຮັດ​ໃຫ້​ນ້ຳໝອກ​ຕົກ​ລົງ​ມາ.<verse eid="PRO 3:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />ລູກ​ເອີຍ, ຢ່າ​ໃຫ້​ປັນຍາ ແລະ ຄວາມ​ເຂົ້າໃຈ​ໜີ​ໄປ​ຈາກ​ສາຍຕາ​ຂອງ​ເຈົ້າ​ໄດ້,</para>
  <para style="q2" vid="PRO 3:21">ຈົ່ງ​ຮັກສາ​ການ​ການ​ຕັດສິນ​ອັນ​ຖືກຕ້ອງ ແລະ ຄວາມ​ຮອບຄອບ​ໄວ້;<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />ສິ່ງເຫລົ່ານີ້​ຈະ​ເປັນ​ຊີວິດ​ໃຫ້​ແກ່​ເຈົ້າ,</para>
  <para style="q2" vid="PRO 3:22">ແລະ ເປັນ​ເຄື່ອງ​ເອ້ຍ້ອງ​ເພື່ອ​ປະດັບ​ຄໍ​ຂອງ​ເຈົ້າ.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />ແລ້ວ​ເຈົ້າ​ຈະ​ເດີນ​ໄປ​ຕາມ​ທາງ​ຂອງ​ຕົນ​ຢ່າງ​ປອດໄພ,</para>
  <para style="q2" vid="PRO 3:23">ແລະ ຕີນ​ຂອງ​ເຈົ້າ​ຈະ​ບໍ່​ເຕະ​ສະດຸດ​ລົ້ມ.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />ເມື່ອ​ເຈົ້າ​ນັ່ງ​ລົງ, ເຈົ້າ​ຈະ​ບໍ່​ຢ້ານ;</para>
  <para style="q2" vid="PRO 3:24">ເມື່ອ​ເຈົ້າ​ນອນ​ຫລັບ, ເຈົ້າ​ກໍ​ຈະ​ນອນ​ຫລັບ​ສະບາຍ.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />ຢ່າ​ຢ້ານ​ກົວ​ໄພພິບັດ​ທີ່​ມາ​ຢ່າງ​ກະທັນຫັນ</para>
  <para style="q2" vid="PRO 3:25">ຫລື ຄວາມ​ຈິບຫາຍ​ທີ່​ໂຈມຕີ​ຄົນຊົ່ວ,<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />ເພາະ​ພຣະເຈົ້າ​ຢາເວ​ຈະ​ຢູ່​ຄຽງ​ຂ້າງ​ເຈົ້າ<note caller="+" style="f"><char style="fr" closed="false">3:26 </char><char style="ft" closed="false">ຫລື ເພາະ​ອົງພຣະຜູ້ເປັນເຈົ້າ​ຈະ​ເປັນ​ຄວາມຫມັ້ນໃຈ​ຂອງ​ເຈົ້າ</char></note></para>
  <para style="q2" vid="PRO 3:26">ແລະ ຈະ​ຮັກສາ​ຕີນ​ຂອງ​ເຈົ້າ​ຈາກ​ບ້ວງແຮ້ວ.<verse eid="PRO 3:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />ຢ່າ​ເກັບ​ສິ່ງ​ທີ່​ດີ​ໄວ້​ຈາກ​ຜູ້​ທີ່​ສົມຄວນ​ໄດ້​ຮັບ,</para>
  <para style="q2" vid="PRO 3:27">ເມື່ອ​ມັນ​ຢູ່​ໃນ​ອຳນາດ​ຂອງ​ເຈົ້າ​ທີ່​ຈະ​ກະທຳ​ໄດ້.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />ຢ່າ​ເວົ້າ​ກັບ​ເພື່ອນບ້ານ​ຂອງ​ເຈົ້າ​ວ່າ,</para>
  <para style="q2" vid="PRO 3:28">“ຈົ່ງ​ກັບ​ມາ​ມື້ອື່ນ ແລ້ວ​ຂ້ອຍ​ຈະ​ເອົາ​ມັນ​ໃຫ້​ເຈົ້າ”</para>
  <para style="q2" vid="PRO 3:28">ໃນ​ເມື່ອ​ເຈົ້າ​ມີ​ມັນ​ຢູ່​ແລ້ວ.<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />ຢ່າ​ວາງແຜນ​ຮ້າຍ​ຕໍ່​ເພື່ອນບ້ານ​ຂອງ​ເຈົ້າ,</para>
  <para style="q2" vid="PRO 3:29">ຜູ້​ອາໄສ​ຢູ່​ໃກ້​ເຈົ້າ​ທີ່​ໄວ້ວາງໃຈ​ໃນ​ຕົວ​ເຈົ້າ.<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />ຢ່າ​ກ່າວ​ຫາ​ຜູ້​ໃດ​ໂດຍ​ບໍ່​ມີ​ເຫດຜົນ</para>
  <para style="q2" vid="PRO 3:30">ໃນ​ເມື່ອ​ພວກເຂົາ​ບໍ່​ໄດ້​ທໍາຮ້າຍ​ເຈົ້າ.<verse eid="PRO 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />ຢ່າ​ອິດສາ​ຄົນ​ທີ່​ໃຊ້​ຄວາມ​ຮຸນແຮງ</para>
  <para style="q2" vid="PRO 3:31">ຫລື ຢ່າ​ເລືອກ​ເອົາ​ວິຖີທາງ​ຂອງ​ພວກເຂົາ.<verse eid="PRO 3:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />ເພາະ​ພຣະເຈົ້າ​ຢາເວ​ກຽດຊັງ​ຜູ້​ທີ່​ມັກ​ປີ້ນ​ຄວາມ</para>
  <para style="q2" vid="PRO 3:32">ແຕ່​ໄວ້ວາງໃຈ​ນໍາ​ຄົນ​ທ່ຽງທຳ​ຂອງ​ພຣະອົງ.<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />ຄຳ​ສາບແຊ່ງ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ຢູ່​ເທິງ​ເຮືອນ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ,</para>
  <para style="q2" vid="PRO 3:33">ແຕ່​ພຣະອົງ​ອວຍພອນ​ເຮືອນ​ຂອງ​ຄົນ​ຊອບທຳ.<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />ພຣະອົງ​ເຢາະເຢີ້ຍ​ຄົນ​ທີ່​ມັກ​ເຢາະເຢີ້ຍ</para>
  <para style="q2" vid="PRO 3:34">ແຕ່​ສະແດງ​ຄວາມ​ເມດຕາ​ແກ່​ຄົນ​ຖ່ອມ​ຕົວ ແລະ ຄົນ​ທີ່​ຖືກ​ກົດຂີ່.<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />ຄົນ​ມີ​ປັນຍາ​ຈະ​ໄດ້​ຮັບ​ກຽດ​ເປັນ​ມໍລະດົກ</para>
  <para style="q2" vid="PRO 3:35">ແຕ່​ຄົນ​ໂງ່​ຈ້າ​ຈະ​ໄດ້​ຮັບ​ພຽງແຕ່​ຄວາມ​ອັບອາຍ.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">ຈົ່ງ​ຮັບ​ເອົາ​ປັນຍາ​ໂດຍ​ບໍ່​ເສຍ​ຄ່າ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />ລູກ​ທັງຫລາຍ​ເອີຍ, ຈົ່ງ​ຟັງ​ຄຳ​ສັ່ງສອນ​ຂອງ​ພໍ່​ເຈົ້າ;</para>
  <para style="q2" vid="PRO 4:1">ຈົ່ງ​ຕັ້ງໃຈ ແລະ ຈະ​ມີ​ຄວາມ​ເຂົ້າໃຈ​ເພີ່ມ​ຂຶ້ນ.<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />ເຮົາ​ຈະ​ມອບ​ຄຳສອນ​ທີ່​ດີ​ໃຫ້​ແກ່​ເຈົ້າ</para>
  <para style="q2" vid="PRO 4:2">ດັ່ງນັ້ນ ຢ່າ​ປະຖິ້ມ​ຄຳ​ສັ່ງສອນ​ຂອງ​ພໍ່.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />ເມື່ອ​ພໍ່​ເປັນ​ເດັກນ້ອຍ​ຄື ລູກຊາຍ​ຄົນ​ດຽວ​ຂອງ​ພໍ່,</para>
  <para style="q2" vid="PRO 4:3">ເມື່ອ​ຍັງ​ນ້ອຍ ແລະ ໄດ້​ຮັບ​ການ​ທະນຸຖະໜອມ​ຈາກ​ແມ່.<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />ປູ່​ກໍ​ໄດ້​ສອນ ແລະ ບອກ​ພໍ່​ວ່າ</para>
  <para style="q2" vid="PRO 4:4">“ຈົ່ງ​ຢຶດ​ຄຳສອນ​ຂອງ​ພໍ່​ດ້ວຍ​ສຸດ​ໃຈ​ຂອງ​ເຈົ້າ;</para>
  <para style="q2" vid="PRO 4:4">ຈົ່ງ​ຮັກສາ​ຄຳສັ່ງ​ຂອງ​ພໍ່​ໄວ້ ແລະ ເຈົ້າ​ຈະ​ມີຊີວິດ​ຢູ່.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />ຈົ່ງ​ຮັບ​ເອົາ​ປັນຍາ, ແລະ ຄວາມ​ເຂົ້າໃຈ;</para>
  <para style="q2" vid="PRO 4:5">ຢ່າ​ລືມ ຫລື ຢ່າ​ຫັນ​ໜີ​ຈາກ​ຄຳສອນ​ຂອງ​ພໍ່.<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />ຢ່າ​ປະຖິ້ມ​ປັນຍາ, ແລະ ປັນຍາ​ຈະ​ຊ່ວຍ​ປົກປ້ອງ​ເຈົ້າ​ໄວ້;</para>
  <para style="q2" vid="PRO 4:6">ຈົ່ງ​ຮັກ​ປັນຍາ ແລະ ປັນຍາ​ຈະ​ເບິ່ງແຍງ​ເຈົ້າ.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />ຈຸດ​ເລີ່ມ​ຕົ້ນ​ຂອງ​ປັນຍາ​ຄື: ຈົ່ງ​ຮັບ​ເອົາ​ປັນຍາ​ໄວ້.</para>
  <para style="q2" vid="PRO 4:7">ເຖິງ​ແມ່ນ​ວ່າ​ຈະ​ຕ້ອງ​ສູນເສຍ​ທຸກສິ່ງ​ທີ່​ເຈົ້າ​ມີ, ຈົ່ງ​ຢຶດ​ຄວາມ​ເຂົ້າໃຈ​ໄວ້.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />ຈົ່ງ​ທະນຸຖະໜອມ​ປັນຍາ​ໄວ້ ແລະ ປັນຍາ​ຈະ​ຍົກ​ເຈົ້າ​ຂຶ້ນ.</para>
  <para style="q2" vid="PRO 4:8">ຈົ່ງ​ກອດ​ເອົາ​ປັນຍາ​ໄວ້ ແລະ ປັນຍາ​ຈະ​ໃຫ້​ກຽດ​ເຈົ້າ.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />ປັນຍາ​ຈະ​ມອບ​ມົງກຸດ​ອັນ​ງົດງາມ​ປະດັບ​ຫົວ​ຂອງ​ເຈົ້າ</para>
  <para style="q2" vid="PRO 4:9">ແລະ ຈະ​ໃຫ້​ມົງກຸດ​ອັນ​ສະຫງ່າລາສີ​ແກ່​ເຈົ້າ”.<verse eid="PRO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />ລູກ​ເອີຍ, ຈົ່ງ​ຟັງ ແລະ ຍອມ​ຮັບ​ສິ່ງທີ່​ພໍ່​ສອນ,</para>
  <para style="q2" vid="PRO 4:10">ແລະ ເຈົ້າ​ຈະ​ມີ​ຊີວິດ​ຍືນ​ຍາວ.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />ພໍ່​ສັ່ງສອນ​ເຈົ້າ​ໄປ​ໃນ​ທາງ​ແຫ່ງ​ປັນຍາ</para>
  <para style="q2" vid="PRO 4:11">ແລະ ນຳ​ເຈົ້າ​ໄປ​ຕາມ​ທາງ​ທີ່​ຊື່.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />ເມື່ອ​ເຈົ້າ​ເດີນ​ໄປ, ບາດ​ກ້າວ​ຂອງ​ເຈົ້າ​ຈະ​ບໍ່​ຖືກ​ຂັດຂວາງ;</para>
  <para style="q2" vid="PRO 4:12">ເມື່ອ​ເຈົ້າ​ແລ່ນ​ໄປ, ເຈົ້າ​ຈະ​ບໍ່​ສະດຸດ.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />ຈົ່ງ​ຢຶດ​ຄຳ​ສັ່ງສອນ​ໄວ້​ໃຫ້​ໝັ້ນຄົງ, ຢ່າ​ປ່ອຍ​ໃຫ້​ມັນ​ໜີ​ໄປ;</para>
  <para style="q2" vid="PRO 4:13">ຈົ່ງ​ຮັກສາ​ມັນ​ໄວ້​ໃຫ້​ດີ, ເພາະ​ມັນ​ເປັນ​ຊີວິດ​ຂອງ​ເຈົ້າ.<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />ຢ່າ​ຍ່າງ​ໄປ​ຕາມ​ທາງ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ</para>
  <para style="q2" vid="PRO 4:14">ຫລື ເດີນ​ໃນ​ທາງ​ຂອງ​ຄົນ​ບໍ່​ດີ.<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />ຈົ່ງ​ຫລີກ​ເວັ້ນ​ມັນ​ໄປ, ຢ່າ​ເດີນ​ໄປ​ຕາມ​ທາງ​ນັ້ນ;</para>
  <para style="q2" vid="PRO 4:15">ຈົ່ງ​ຫັນ​ໜີ​ຈາກ​ມັນ ແລະ ໄປ​ຕາມ​ທາງ​ຂອງ​ເຈົ້າ.<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />ເພາະ​ສຳລັບ​ຄົນ​ຊົ່ວຮ້າຍ​ນັ້ນ ຈະ​ບໍ່​ພັກຜ່ອນ​ຈົນ​ພວກເຂົາ​ໄດ້​ເຮັດ​ຊົ່ວ;</para>
  <para style="q2" vid="PRO 4:16">ພວກເຂົາ​ຈະ​ນອນ​ບໍ່​ຫລັບ​ຈົນ​ກວ່າ​ຈະ​ໄດ້​ເຮັດ​ໃຫ້​ຜູ້​ໃດ​ຜູ້​ໜຶ່ງ​ສະດຸດ.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />ພວກເຂົາ​ກິນ​ອາຫານ​ແຫ່ງ​ຄວາມ​ຊົ່ວ</para>
  <para style="q2" vid="PRO 4:17">ແລະ ດື່ມ​ເຫລົ້າ​ອະງຸ່ນ​ແຫ່ງ​ຄວາມ​ຮຸນແຮງ.<verse eid="PRO 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />ທາງ​ຂອງ​ຄົນ​ຊອບທຳ​ເປັນ​ດັ່ງ​ດວງ​ຕາເວັນ​ໃນ​ຍາມ​ເຊົ້າ,</para>
  <para style="q2" vid="PRO 4:18">ສ່ອງ​ແສງ​ແຈ້ງ​ຂຶ້ນ​ເລື້ອຍໆ​ຈົນ​ເຖິງ​ກາງເວັນ.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />ແຕ່​ທາງ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ເປັນ​ເໝືອນ​ຄວາມ​ມືດ;</para>
  <para style="q2" vid="PRO 4:19">ພວກເຂົາ​ບໍ່​ຮູ້​ວ່າ​ຕົນ​ເອງ​ສະດຸດ​ຫຍັງ.<verse eid="PRO 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />ລູກ​ເອີຍ, ຈົ່ງ​ເອົາໃຈໃສ່​ໃນ​ສິ່ງ​ທີ່​ພໍ່​ເວົ້າ;</para>
  <para style="q2" vid="PRO 4:20">ຈົ່ງ​ງ່ຽງ​ຫູ​ຂອງ​ເຈົ້າ​ຟັງ​ຖ້ອຍຄຳ​ຂອງ​ພໍ່.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />ຢ່າ​ໃຫ້​ຖ້ອຍຄໍາ​ນັ້ນ​ໜີ​ຈາກ​ສາຍ​ຕາ​ຂອງ​ເຈົ້າ,</para>
  <para style="q2" vid="PRO 4:21">ຈົ່ງ​ຮັກສາ​ພວກມັນ​ໄວ້​ໃນ​ໃຈ​ຂອງ​ເຈົ້າ;<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />ເພາະ​ຖ້ອຍຄຳ​ເຫລົ່ານັ້ນ​ເປັນ​ຊີວິດ​ແກ່​ຜູ້​ທີ່​ຄົ້ນພົບ</para>
  <para style="q2" vid="PRO 4:22">ແລະ ເຮັດ​ໃຫ້​ຮ່າງກາຍ​ທັງໝົດ​ຂອງ​ຜູ້​ນັ້ນ​ແຂງແຮງ​ດີ.<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />ເໜືອ​ກວ່າ​ສິ່ງ​ອື່ນ​ໃດ, ຈົ່ງ​ຮັກສາ​ໃຈ​ຂອງ​ເຈົ້າ​ໄວ້​ໃຫ້​ດີ,</para>
  <para style="q2" vid="PRO 4:23">ເພາະ​ທຸກສິ່ງ​ທີ່​ເຈົ້າ​ເຮັດ​ກໍ​ລ້ວນ​ແຕ່​ໄຫລ​ອອກ​ມາ​ຈາກ​ໃຈ.<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />ຈົ່ງ​ຮັກສາ​ປາກ​ຂອງ​ເຈົ້າ​ໄວ້​ຈາກ​ສິ່ງ​ທີ່​ບໍ່​ເປັນ​ຄວາມຈິງ;</para>
  <para style="q2" vid="PRO 4:24">ຈົ່ງ​ຮັກສາ​ສົບ​ຂອງ​ເຈົ້າ​ໃຫ້​ຫ່າງ​ໄກ​ຈາກ​ຄຳ​ເວົ້າ​ທີ່​ຫລອກລວງ.<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />ຈົ່ງ​ໃຫ້​ຕາ​ຂອງ​ເຈົ້າ​ເບິ່ງ​ກົງ​ໄປ​ຂ້າງ​ໜ້າ;</para>
  <para style="q2" vid="PRO 4:25">ຈົ່ງ​ຈົດຈໍ່​ເບິ່ງ​ສິ່ງ​ທີ່​ຢູ່​ຕໍ່​ໜ້າ​ເຈົ້າ​ຢ່າງ​ໜັກແໜ້ນ.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />ຈົ່ງ​ຄິດ​ຢ່າງ​ຮອບຄອບ​ເຖິງ​ທາງ​ທີ່​ເຈົ້າ​ກ້າວ​ເດີນ​ໄປ<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false">ຫລື ຈົ່ງ​ເຮັດ​ທາງ </char><char style="fqa" closed="false">ທີ່ </char><char style="ft" closed="false">ຮາບ​ລຽບ​ໃຫ້​ຕີນ​ຂອງ​ເຈົ້າ</char></note></para>
  <para style="q2" vid="PRO 4:26">ແລະ ເດີນ​ຢູ່​ໃນ​ທາງ​ນັ້ນ​ຢ່າງ​ໝັ້ນຄົງ.<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />ຢ່າ​ຫັນ​ໄປ​ທາງ​ຂວາ ຫລື ທາງ​ຊ້າຍ;</para>
  <para style="q2" vid="PRO 4:27">ຈົ່ງ​ຮັກສາ​ຕີນ​ຂອງ​ເຈົ້າ​ໄວ້​ຈາກ​ຄວາມ​ຊົ່ວ​ຮ້າຍ.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">ຄຳເຕືອນ​ຕໍ່ສູ້​ການ​ຫລິ້ນຊູ້</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />ລູກ​ເອີຍ, ຈົ່ງ​ຕັ້ງໃຈ​ຟັງ​ປັນຍາ​ຂອງ​ພໍ່,</para>
  <para style="q2" vid="PRO 5:1">ຈົ່ງ​ງ່ຽງ​ຫູ​ຟັງ​ຖ້ອຍ​ຄຳ​ທີ່​ມີ​ຄວາມ​ໝາຍ​ອັນ​ເລິກເຊິ່ງ​ຂອງ​ພໍ່,<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />ເພື່ອ​ເຈົ້າ​ຈະ​ຮັກສາ​ຄວາມ​ຮອບຄອບ</para>
  <para style="q2" vid="PRO 5:2">ແລະ ປາກ​ຂອງ​ເຈົ້າ​ຈະ​ສະແດງ​ໃຫ້​ເຫັນ​ວ່າ​ເຈົ້າ​ມີ​ຄວາມ​ຮູ້.<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />ເພາະ​ຮີມສົບ​ຂອງ​ຍິງ​ຫລິ້ນຊູ້​ກໍ​ຫວານ​ດັ່ງ​ນ້ຳເຜິ້ງ.</para>
  <para style="q2" vid="PRO 5:3">ແລະ ຄຳ​ເວົ້າ​ຂອງ​ນາງ​ກໍ​ຫລ່ຽນໄຫລ​ຍິ່ງ​ກວ່າ​ນ້ຳ​ມັນ;<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />ແຕ່​ໃນ​ທີ່ສຸດ ນາງ​ຂົມ​ຍິ່ງ​ກວ່າ​ເຄືອເຂົາຮໍ,</para>
  <para style="q2" vid="PRO 5:4">ຄົມ​ຍິ່ງ​ກວ່າ​ດາບ​ສອງ​ຄົມ.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />ຕີນ​ຂອງ​ນາງ​ນຳ​ໄປ​ສູ່​ຄວາມ​ຕາຍ;</para>
  <para style="q2" vid="PRO 5:5">ບາດ​ຍ່າງ​ຂອງ​ນາງ​ຊື່​ຕົງ​ໄປ​ຫາ​ຂຸມ​ຝັງ​ສົບ.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />ນາງ​ບໍ່​ສົນ​ໃຈ​ທາງ​ແຫ່ງ​ຊີວິດ;</para>
  <para style="q2" vid="PRO 5:6">ວິຖີທາງ​ຂອງ​ນາງ​ວົງວຽນ​ໄປ​ມາ​ບໍ່​ມີ​ຈຸດ​ໝາຍ, ແຕ່​ນາງ​ບໍ່​ຮູ້.<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />ບັດນີ້, ລູກ​ເອີຍ, ຈົ່ງ​ຟັງ​ພໍ່;</para>
  <para style="q2" vid="PRO 5:7">ແລະ ຢ່າ​ຫັນ​ໜີ​ໄປ​ຈາກ​ສິ່ງ​ທີ່​ພໍ່​ບອກ.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />ຈົ່ງ​ຮັກສາ​ວິຖີທາງ​ຂອງ​ເຈົ້າ​ໃຫ້​ຫ່າງ​ໄກ​ຈາກ​ນາງ,</para>
  <para style="q2" vid="PRO 5:8">ຢ່າ​ເຂົ້າ​ໄປ​ໃກ້​ປະຕູ​ເຮືອນ​ຂອງ​ນາງ,<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />ຢ້ານ​ວ່າ​ເຈົ້າ​ຈະ​ເສຍ​ກຽດ​ຂອງ​ເຈົ້າ​ໃຫ້​ແກ່​ຄົນ​ອື່ນ</para>
  <para style="q2" vid="PRO 5:9">ແລະ ສັກສີ<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">ຫລື ປີ​ເດືອນ</char></note>​ຂອງ​ເຈົ້າ​ໃຫ້​ແກ່​ຄົນ​ໂຫດ​ຮ້າຍ.<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />ຢ້ານ​ວ່າ​ຄົນແປກໜ້າ​ຈະ​ໃຊ້​ຊັບສິນ​ຂອງ​ເຈົ້າ</para>
  <para style="q2" vid="PRO 5:10">ແລະ ສິ່ງ​ທີ່​ພວກເຈົ້າ​ຊອກ​ຫາ​ມາ​ໄດ້​ຈະ​ຕົກ​ແກ່​ເຮືອນ​ຂອງ​ຄົນ​ອື່ນ.<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />ໃນ​ບັ້ນ​ປາຍ​ຊີວິດ​ຂອງ​ເຈົ້າ ເຈົ້າ​ຈະ​ຮ້ອງ​ຄວນຄາງ,</para>
  <para style="q2" vid="PRO 5:11">ເມື່ອ​ເນື້ອໜັງ ແລະ ຮ່າງກາຍ​ຂອງ​ເຈົ້າ​ເສື່ອມໂຊມ​ລົງ.<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />ເຈົ້າ​ຈະ​ເວົ້າ​ວ່າ, “ຂ້ອຍ​ຊັງ​ລະບຽບ​ວິໄນ​ຫລາຍ!</para>
  <para style="q2" vid="PRO 5:12">ແລະ ຫົວໃຈ​ຂອງ​ຂ້ອຍ​ປະຕິເສດ​ການ​ປັບປຸງ​ແກ້ໄຂ!<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />ຂ້ອຍ​ບໍ່​ເຊື່ອຟັງ​ຄໍາ​ຄູ​ອາຈານ​ຂອງ​ຂ້ອຍ</para>
  <para style="q2" vid="PRO 5:13">ຫລື ງ່ຽງ​ຫູ​ຂອງ​ຂ້ອຍ​ໄປ​ຫາ​ຜູ້​ທີ່​ແນະນໍາ​ຂ້ອຍ.<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />ແລະ ອີກ​ບໍ່​ດົນ ຂ້ອຍ​ຈະ​ພົບ​ຄວາມ​ເດືອດຮ້ອນ​ຢ່າງ​ໜັກ</para>
  <para style="q2" vid="PRO 5:14">ໃນ​ບ່ອນ​ຊຸມນຸມ​ຂອງ​ປະຊາຊົນ​ຂອງ​ພຣະເຈົ້າ”.<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />ຈົ່ງ​ດື່ມ​ນ້ຳ​ຈາກ​ອ່າງ​ເກັບ​ນ້ຳ​ຂອງ​ເຈົ້າ,</para>
  <para style="q2" vid="PRO 5:15">ນ້ຳ​ທີ່​ໄຫລ​ຈາກ​ອ່າງ​ຂອງ​ເຈົ້າ​ເອງ.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />ຄວນ​ໃຫ້​ນ້ຳພຸ​ຂອງ​ເຈົ້າ​ໄຫລ​ລົ້ນ​ອອກ​ໄປ​ຕາມ​ຖະໜົນ​ບໍ,</para>
  <para style="q2" vid="PRO 5:16">ຫລື ໃຫ້​ສາຍນໍ້າ​ຂອງ​ເຈົ້າ​ໄຫລ​ໄປ​ໃນ​ແຖວ​ຊຸມຊົນ?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />ຈົ່ງ​ໃຫ້​ສາຍນ້ຳ​ເຫລົ່ານັ້ນ​ເປັນ​ຂອງ​ເຈົ້າ​ຜູ້​ດຽວ,</para>
  <para style="q2" vid="PRO 5:17">ຈົ່ງ​ຢ່າ​ໄດ້​ແບ່ງປັນ​ໃຫ້​ກັບ​ຄົນແປກໜ້າ.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />ຂໍ​ໃຫ້​ນ້ຳພຸ​ຂອງ​ເຈົ້າ​ໄດ້​ຮັບ​ພອນ</para>
  <para style="q2" vid="PRO 5:18">ແລະ ຂໍ​ໃຫ້​ເຈົ້າ​ພົບ​ຄວາມ​ຊື່ນຊົມຍິນດີ​ໃນ​ເມຍ​ຂອງ​ເຈົ້າ​ທີ່​ໄດ້​ມາ​ຕັ້ງແຕ່​ຍັງ​ໜຸ່ມ.<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />ດັ່ງ​ກວາງ​ແມ່​ທີ່​ໜ້າ​ຮັກ, ເຍືອງຜາ​ທີ່​ສະຫງ່າງາມ</para>
  <para style="q2" vid="PRO 5:19">ຂໍ​ໃຫ້​ນົມ​ຂອງ​ນາງ​ເຮັດ​ໃຫ້​ເຈົ້າ​ອິ່ມໃຈ​ໄດ້​ສະເໝີ,</para>
  <para style="q2" vid="PRO 5:19">ຂໍ​ໃຫ້​ເຈົ້າ​ຫລົງໄຫລ​ໃນ​ຄວາມ​ຮັກ​ຂອງ​ນາງ​ຕະຫລອດ​ໄປ.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />ລູກ​ເອີຍ, ເປັນຫຍັງ​ເຈົ້າ​ຈຶ່ງ​ໄປ​ມົວເມົາ​ກັບ​ເມຍ​ຂອງ​ຊາຍ​ອື່ນ?</para>
  <para style="q2" vid="PRO 5:20">ເປັນຫຍັງ​ເຈົ້າ​ຈຶ່ງ​ໄປ​ແນບ​ເອິກ​ຍິງ​ທີ່​ຫລົງຜິດ?<verse eid="PRO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />ເພາະ​ທາງ​ທັງຫລາຍ​ຂອງ​ເຈົ້າ​ຢູ່​ໃນ​ສາຍຕາ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ,</para>
  <para style="q2" vid="PRO 5:21">ແລະ ພຣະອົງ​ກວດສອບ​ເບິ່ງ​ທຸກ​ວິຖີທາງ​ຂອງ​ເຈົ້າ.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />ການ​ກະທໍາ​ຊົ່ວ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ກໍ​ດັກ​ຈັບ​ພວກເຂົາ​ເອງ;</para>
  <para style="q2" vid="PRO 5:22">ເຊືອກ​ແຫ່ງ​ຄວາມ​ບາບ​ຂອງ​ພວກເຂົາ​ກໍ​ຮັດ​ພວກເຂົາ​ໄວ້​ແໜ້ນ.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />ພວກເຂົາ​ຈະ​ຕາຍ​ໄປ ເພາະ​ຂາດ​ລະບຽບ​ວິໄນ,</para>
  <para style="q2" vid="PRO 5:23">ຖືກ​ນໍາ​ໃຫ້​ຫລົງ​ໄປ​ໃນ​ທາງ​ທີ່​ຜິດ ເພາະ​ຄວາມ​ໂງ່ຈ້າ​ທີ່ສຸດ​ຂອງ​ພວກເຂົາ​ເອງ.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">ຄຳ​ຕັກເຕືອນ​ຕໍ່​ຄວາມ​ໂງ່ຈ້າ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />ລູກ​ເອີຍ, ຖ້າ​ເຈົ້າ​ໄດ້​ຄ້ຳປະກັນ​ໃຫ້​ເພື່ອນບ້ານ,</para>
  <para style="q2" vid="PRO 6:1">ຖ້າ​ເຈົ້າ​ໄດ້​ຈັບ​ມື​ສັນຍາ​ກັບ​ຄົນແປກໜ້າ,<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />ເຈົ້າ​ກໍ​ໄດ້​ຖືກ​ບ້ວງ​ແຮ້ວ​ຈາກ​ສິ່ງ​ທີ່​ເຈົ້າ​ເວົ້າ,</para>
  <para style="q2" vid="PRO 6:2">ເຈົ້າ​ໄດ້​ຖືກ​ຈັບ​ຈາກ​ຄຳເວົ້າ​ຂອງ​ປາກ​ເຈົ້າ​ເອງ.<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />ລູກ​ເອີຍ, ເມື່ອ​ເຈົ້າ​ຕົກ​ຢູ່​ໃນ​ມື​ຂອງ​ເພື່ອນບ້ານ,</para>
  <para style="q2" vid="PRO 6:3">ສະນັ້ນ ຈົ່ງ​ເຮັດ​ແບບ​ນີ້​ເພື່ອ​ປົດປ່ອຍ​ຕົວ​ເຈົ້າ​ເອງ:</para>
  <para style="q1" vid="PRO 6:3">ຈົ່ງ​ອອກ​ໄປ​ອ້ອນວອນ​ຂໍ​ຈົນ​ບໍ່​ມີ​ແຮງ<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">ຫລື ໄປ ຖ່ອມ​ຕົວ​ຖ່ອມ​ໃຈ​ຂອງ​ເຈົ້າ​ລົງ</char></note></para>
  <para style="q2" vid="PRO 6:3">ຢ່າ​ໃຫ້​ເພື່ອນບ້ານ​ຂອງ​ເຈົ້າ​ໄດ້​ພັກຜ່ອນ!<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />ຢ່າ​ໃຫ້​ຕາ​ຂອງ​ເຈົ້າ​ໄດ້​ນອນ​ຫລັບ,</para>
  <para style="q2" vid="PRO 6:4">ຢ່າ​ໃຫ້​ເປືອກຕາ​ຂອງ​ເຈົ້າ​ເຊືອບຫລັບ​ໄປ<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />ຈົ່ງ​ປົດປ່ອຍ​ຕົນ​ເອງ​ໃຫ້​ເປັນ​ອິດສະຫລະ​ດັ່ງ​ກວາງ​ທີ່​ປົບໜີ​ຈາກ​ມື​ຂອງ​ນາຍພານ,</para>
  <para style="q2" vid="PRO 6:5">ດັ່ງ​ນົກ​ທີ່​ໜີ​ຈາກ​ບ້ວງ​ແຮ້ວ​ຂອງ​ນາຍພານ.<verse eid="PRO 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />ເຈົ້າ​ຄົນ​ຂີ້ຄ້ານ, ຈົ່ງ​ໄປ​ຮຽນຮູ້​ບົດຮຽນ​ຈາກ​ມົດ;</para>
  <para style="q2" vid="PRO 6:6">ຈົ່ງ​ພິຈາລະນາ​ວິທີການ​ຂອງ​ມັນ ແລະ ຈົ່ງ​ເປັນ​ຄົນ​ສະຫລາດ​ຂຶ້ນ!<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />ມັນ​ບໍ່​ມີ​ຜູ້ບັນຊາ,</para>
  <para style="q2" vid="PRO 6:7">ບໍ່​ມີ​ຜູ້​ຄວບຄຸມ ຫລື ບໍ່​ມີ​ຜູ້ປົກຄອງ,<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />ແຕ່​ມັນ​ກໍ​ຍັງ​ສະສົມ​ອາຫານ​ໄວ້​ໄດ້​ໃນ​ລະດູ​ຮ້ອນ</para>
  <para style="q2" vid="PRO 6:8">ແລະ ຮວບຮວມ​ອາຫານ​ໄວ້​ຕັ້ງ​ແຕ່​ໃນ​ລະດູ​ເກັບ​ກ່ຽວ.<verse eid="PRO 6:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />ເຈົ້າ​ຄົນ​ຂີ້ຄ້ານ, ເຈົ້າ​ຈະ​ນອນ​ຢູ່​ອີກ​ດົນ​ປານໃດ?</para>
  <para style="q2" vid="PRO 6:9">ເມື່ອໃດ​ເຈົ້າ​ຈະ​ຕື່ນ​ຂຶ້ນ​ຈາກ​ນອນ?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />ເຈົ້າ​ເວົ້າ​ວ່າ, ຂໍ​ນອນ​ອີກ​ໜ້ອຍ​ໜຶ່ງ, ເຊືອບ​ນອນ​ອີກ​ຈັກ​ໜ້ອຍ,</para>
  <para style="q2" vid="PRO 6:10">ເອົາ​ມື​ກອດ​ເອິກ​ຫລັບ​ບຶດ​ໜຶ່ງ<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />ແລະ ຄວາມ​ທຸກຍາກ​ຈະ​ມາ​ຫາ​ເຈົ້າ​ດັ່ງ​ຄົນ​ຂີ້ລັກ</para>
  <para style="q2" vid="PRO 6:11">ແລະ ຄວາມ​ຂັດສົນ​ຈະ​ໂຈມຕີ​ເຈົ້າ​ດັ່ງ​ມີ​ຄົນ​ໜຶ່ງ​ຖື​ອາວຸດ​ມາ.<verse eid="PRO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />ຄົນ​ສ້າງ​ບັນຫາ ແລະ ຄົນ​ຊົ່ວຮ້າຍ,</para>
  <para style="q2" vid="PRO 6:12">ທີ່​ມັກ​ໄປ​ຊອກ​ຫາ​ຕົວະ,<verse eid="PRO 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PRO 6:13" />ຜູ້​ທີ່​ຍິກຄີ້ວ​ເພື່ອ​ຫວັງ​ທໍາລາຍ,</para>
  <para style="q2" vid="PRO 6:13">ສັ່ນ​ຕີນ​ຂອງ​ຕົນ​ເປັນ​ສັນຍານ</para>
  <para style="q2" vid="PRO 6:13">ແລະ ດີດ​ນິ້ວມື​ສົ່ງ​ສັນຍານ,<verse eid="PRO 6:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 6:14" />ຜູ້​ທີ່​ວາງ​ແຜນການ​ອັນ​ຊົ່ວ​ຮ້າຍ​ດ້ວຍ​ການ​ຫລອກລວງ​ຢູ່​ໃນ​ໃຈ</para>
  <para style="q2" vid="PRO 6:14">ລາວ​ມັກ​ສ້າງ​ຄວາມ​ຂັດແຍ້ງ​ຕະຫລອດ.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />ເຫດສະນັ້ນ ຄວາມ​ຈິບຫາຍ​ຈະ​ມາ​ຫາ​ລາວ​ແບບ​ບໍ່​ຮູ້​ຕົວ;</para>
  <para style="q2" vid="PRO 6:15">ລາວ​ຈະ​ຖືກ​ທໍາລາຍ​ໃນ​ທັນທີ​ທັນໃດ ໂດຍ​ບໍ່​ມີ​ວິທີ​ປ້ອງກັນ​ໄດ້.<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="PRO 6:16" />ມີ​ຫົກ​ຢ່າງ​ທີ່​ພຣະເຈົ້າ​ຢາເວ​ກຽດຊັງ,</para>
  <para style="li2" vid="PRO 6:16">ມີ​ເຈັດ​ຢ່າງ​ທີ່​ພຣະອົງ​ກຽດຊັງ​ຄື:<verse eid="PRO 6:16" /></para>
  <para style="li3">
    <verse number="17" style="v" sid="PRO 6:17" />ຕາ​ທີ່​ຈອງຫອງ,</para>
  <para style="li3" vid="PRO 6:17">ລີ້ນ​ທີ່​ເວົ້າ​ຕົວະ,</para>
  <para style="li3" vid="PRO 6:17">ມື​ທີ່​ຂ້າ​ຄົນບໍລິສຸດ<verse eid="PRO 6:17" /></para>
  <para style="li3">
    <verse number="18" style="v" sid="PRO 6:18" />ໃຈ​ທີ່​ຄິດ​ແຜນການ​ຊົ່ວຮ້າຍ,</para>
  <para style="li3" vid="PRO 6:18">ຕີນ​ທີ່​ຟ້າວ​ແລ່ນ​ໄປ​ເຮັດ​ຊົ່ວ,<verse eid="PRO 6:18" /></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 6:19" />ເປັນ​ພະຍານ​ບໍ່​ຈິງ​ຕໍ່ສູ້​ຄົນອື່ນ</para>
  <para style="li3" vid="PRO 6:19">ແລະ ເປັນ​ຄົນ​ທີ່​ສ້າງ​ຄວາມ​ຂັດແຍ້ງ​ກັນ​ຢູ່​ໃນ​ຊຸມຊົນ.<verse eid="PRO 6:19" /></para>
  <para style="s1">ຄຳເຕືອນ​ຕໍ່ສູ້​ການ​ຫລິ້ນຊູ້</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />ລູກ​ເອີຍ, ຈົ່ງ​ຮັກສາ​ຄຳສັ່ງ​ຂອງ​ພໍ່​ເຈົ້າ</para>
  <para style="q2" vid="PRO 6:20">ແລະ ຢ່າ​ປະຖິ້ມ​ຄຳສັ່ງສອນ​ຂອງ​ແມ່​ເຈົ້າ.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />ຈົ່ງ​ຜູກ​ມັນ​ໄວ້​ໃນ​ໃຈ​ຂອງ​ເຈົ້າ​ສະເໝີ;</para>
  <para style="q2" vid="PRO 6:21">ຈົ່ງ​ມັດ​ມັນ​ໄວ້​ອ້ອມ​ຄໍ​ຂອງ​ເຈົ້າ.<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />ເມື່ອ​ເຈົ້າ​ຍ່າງ​ໄປ, ພວກມັນ​ຈະ​ນຳ​ພາ​ເຈົ້າ;</para>
  <para style="q2" vid="PRO 6:22">ເມື່ອ​ເຈົ້າ​ນອນ​ຫລັບ, ພວກມັນ​ຈະ​ຄອຍ​ເບິ່ງແຍງ;</para>
  <para style="q2" vid="PRO 6:22">ເມື່ອ​ເຈົ້າ​ຕື່ນ​ຂຶ້ນ, ພວກມັນ​ຈະ​ເວົ້າ​ກັບ​ເຈົ້າ.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />ເພາະ​ຄຳສັ່ງ​ນີ້​ເປັນ​ຕະກຽງ,</para>
  <para style="q2" vid="PRO 6:23">ຄຳສັ່ງສອນ​ນີ້​ເປັນ​ແສງ​ສະຫວ່າງ,</para>
  <para style="q1" vid="PRO 6:23">ແລະ ເປັນ​ສິ່ງ​ທີ່​ດັດແປງ​ແກ້ໄຂ ແລະ ໃຫ້​ຄໍາ​ແນະນໍາ</para>
  <para style="q2" vid="PRO 6:23">ແລະ ສັ່ງສອນ​ເຖິງ​ທາງ​ແຫ່ງ​ຊີວິດ,<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />ຮັກສາ​ເຈົ້າ​ໃຫ້​ພົ້ນ​ຈາກ​ເມຍ​ຂອງ​ເພື່ອນບ້ານ​ຂອງ​ເຈົ້າ,</para>
  <para style="q2" vid="PRO 6:24">ຈາກ​ຄຳ​ເວົ້າ​ທີ່​ຫລ່ຽນໄຫລ​ຂອງ​ຍິ່ງ​ທີ່​ເອົາ​ແຕ່​ໃຈ​ຕົນ​ເອງ.<verse eid="PRO 6:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />ຢ່າ​ໃຫ້​ຄວາມ​ງາມ​ຂອງ​ນາງ​ຍົວະເຍົ້າ​ໃຈ​ເຈົ້າ​ໄດ້</para>
  <para style="q2" vid="PRO 6:25">ຫລື ຢ່າ​ໃຫ້​ນາງ​ຫວ່ານ​ສະເໜ່​ເຈົ້າ​ດ້ວຍ​ສາຍຕາ​ຂອງ​ນາງ.<verse eid="PRO 6:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />ເພາະ​ຍິງ​ໂສເພນີ​ກໍ​ສາມາດ​ແລກ​ໄດ້​ດ້ວຍ​ອາຫານ​ຈານ​ໜຶ່ງ,</para>
  <para style="q2" vid="PRO 6:26">ແຕ່​ເມຍ​ຂອງ​ຊາຍ​ອື່ນ​ຈະ​ລ່າ​ເອົາ​ຊີວິດ​ອັນ​ມີ​ຄ່າ​ຂອງ​ເຈົ້າ.<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />ຜູ້ໃດ​ຫອບ​ຖ່ານ​ໄຟ​ແດງ​ໄວ້​ໃນ​ເອິກ​ຂອງ​ຕົນ​ໄດ້</para>
  <para style="q2" vid="PRO 6:27">ໂດຍ​ທີ່​ເສື້ອ​ຂອງ​ຕົນ​ບໍ່​ໄໝ້?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />ຜູ້ໃດ​ແດ່​ຍ່າງ​ຢູ່​ເທິງ​ຖ່ານ​ໄຟ​ຮ້ອນ</para>
  <para style="q2" vid="PRO 6:28">ໂດຍ​ທີ່​ຕີນ​ຂອງ​ຕົນ​ບໍ່​ໄໝ້?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />ຜູ້​ທີ່​ນອນ​ນໍາ​ເມຍ​ຂອງ​ຊາຍ​ອື່ນ​ກໍ​ເປັນ​ດັ່ງນັ້ນແຫລະ;</para>
  <para style="q2" vid="PRO 6:29">ບໍ່​ມີ​ຜູ້ໃດ​ທີ່​ແຕະຕ້ອງ​ນາງ​ແລ້ວ​ຈະ​ບໍ່​ຖືກ​ລົງໂທດ.<verse eid="PRO 6:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />ຄົນ​ເຮົາ​ຍັງ​ຮູ້ຈັກ​ສົງສານ​ຄົນ​ຂີ້ລັກ</para>
  <para style="q2" vid="PRO 6:30">ທີ່​ລັກ​ເພື່ອ​ບັນເທົາ​ຄວາມ​ຫິວ​ຂອງ​ຕົນ ໃນຂະນະ​ທີ່​ລາວ​ກໍາລັງ​ຫິວ​ຢູ່​ນັ້ນ.<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />ແຕ່​ຖ້າ​ລາວ​ຖືກ​ຈັບ​ໄດ້, ລາວ​ກໍ​ຈະ​ຕ້ອງ​ຈ່າຍ​ຄືນ​ເຖິງ​ເຈັດ​ເທົ່າ,</para>
  <para style="q2" vid="PRO 6:31">ເຖິງແມ່ນວ່າ​ລາວ​ຈະ​ຕ້ອງ​ສູນເສຍ​ຊັບສິນ​ທຸກ​ຢ່າງ​ໃນ​ບ້ານ​ຂອງ​ຕົນ​ໄປ​ກໍ​ຕາມ.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />ແຕ່​ຊາຍ​ທີ່​ຫລິ້ນຊູ້​ເປັນ​ຄົນ​ບໍ່ຮູ້ຈັກຄິດ;</para>
  <para style="q2" vid="PRO 6:32">ຜູ້ໃດ​ກໍ​ຕາມ​ທີ່​ເຮັດ​ເຊັ່ນ​ນັ້ນ​ກໍ​ທຳລາຍ​ຕົນ​ເອງ.<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />ລາວ​ຈະ​ໄດ້​ຮັບ​ຄວາມ​ຈິບຫາຍ ແລະ ຄວາມ​ອັບອາຍ,</para>
  <para style="q2" vid="PRO 6:33">ແລະ ຄວາມ​ອັບອາຍ​ຂາຍ​ໜ້າ​ຂອງ​ລາວ​ຈະ​ບໍ່​ມີ​ມື້​ຖືກ​ລຶບລ້າງ​ໄດ້.<verse eid="PRO 6:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />ເພາະ​ຄວາມ​ຫຶງຫວງ​ຈະ​ເພີ່ມ​ທະວີ​ຄວາມ​ແຄ້ນ​ຂອງ​ຜູ້​ທີ່​ເປັນ​ຜົວ,</para>
  <para style="q2" vid="PRO 6:34">ແລະ ເມື່ອ​ລາວ​ແກ້​ແຄ້ນ, ລາວ​ຈະ​ບໍ່​ສະແດງ​ຄວາມ​ເມດຕາ.<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />ລາວ​ຈະ​ບໍ່​ຍອມຮັບ​ຄ່າ​ທຳຂວັນ​ໃດໆ;</para>
  <para style="q2" vid="PRO 6:35">ເຖິງວ່າ​ຄ່າ​ທຳຂວັນ​ນັ້ນ​ຈະ​ຫລາຍ​ສໍ່າ​ໃດ​ກໍ່​ຕາມ, ລາວ​ກໍ​ຈະ​ບໍ່​ຍອມຮັບ​ຢ່າງ​ເດັດຂາດ.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s1">ຄຳ​ເຕືອນ​ເລື່ອງ​ຍິງ​ຫລິ້ນຊູ້</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />ລູກ​ເອີຍ, ຈົ່ງ​ຮັກສາ​ຖ້ອຍຄໍາ​ຂອງ​ພໍ່​ໄວ້</para>
  <para style="q2" vid="PRO 7:1">ຈົ່ງ​ເກັບ​ສະສົມ​ຄຳສັ່ງສອນ​ຂອງ​ພໍ່​ໄວ້​ພາຍ​ໃນ​ຕົວ​ເຈົ້າ.<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />ຈົ່ງ​ຮັກສາ​ຄຳສັ່ງ​ຂອງ​ພໍ່​ໄວ້ ແລ້ວ​ເຈົ້າ​ຈະ​ມີ​ຊີວິດ​ຢູ່;</para>
  <para style="q2" vid="PRO 7:2">ຈົ່ງ​ຖື​ຮັກສາ​ຄຳສອນ​ຂອງ​ພໍ່​ໄວ້​ດັ່ງ​ແກ້ວຕາ​ຂອງ​ເຈົ້າ.<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />ຈົ່ງ​ພັນ​ມັນ​ໄວ້​ອ້ອມ​ນິ້ວມື​ຂອງ​ເຈົ້າ​ເປັນ​ເຄື່ອງ​ເຕືອນ​ໃຈ;</para>
  <para style="q2" vid="PRO 7:3">ຈົ່ງ​ຂຽນ​ມັນ​ໃສ່​ແຜ່ນ​ຫົວໃຈ​ຂອງ​ເຈົ້າ.<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />ຈົ່ງ​ເວົ້າ​ຕໍ່​ປັນຍາ​ວ່າ, “ເຈົ້າ​ເປັນ​ເອື້ອຍ​ຂອງ​ຂ້ອຍ”,</para>
  <para style="q2" vid="PRO 7:4">ແລະ ຈົ່ງ​ເວົ້າ​ຕໍ່​ຄວາມ​ເຂົ້າໃຈ​ອັນ​ເລິກເຊິ່ງ​ວ່າ, “ເຈົ້າ​ເປັນ​ຍາດພີ່ນ້ອງ​ຂອງ​ຂ້ອຍ”.<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />ສິ່ງ​ເຫລົ່ານີ້​ຈະ​ປົກປ້ອງ​ເຈົ້າ​ຈາກ​ຍິງຫລິ້ນຊູ້,</para>
  <para style="q2" vid="PRO 7:5">ຈາກ​ຍິງ​ເອົາ​ແຕ່​ໃຈ​ດ້ວຍ​ຄຳເວົ້າ​ອັນ​ລໍ້ລວງ​ຂອງ​ນາງ.<verse eid="PRO 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />ຢູ່​ປ່ອງຢ້ຽມ​ເຮືອນ​ຂອງ​ເຮົາ</para>
  <para style="q2" vid="PRO 7:6">ເຮົາ​ແນມ​ເບິ່ງ​ຜ່ານ​ຕາໜ່າງ​ລົງ​ໄປ.<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />ເຮົາ​ເຫັນ​ບັນດາ​ຄົນ​ທີ່​ຍັງ​ອ່ອນ​ຕໍ່​ໂລກ,</para>
  <para style="q2" vid="PRO 7:7">ເຮົາ​ສັງເກດ​ທ່າມກາງ​ບັນດາ​ຊາຍ​ໜຸ່ມ,</para>
  <para style="q2" vid="PRO 7:7">ມີ​ຊາຍ​ຄົນ​ໜຶ່ງ​ທີ່​ບໍ່ຮູ້ຈັກຄິດ.<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />ລາວ​ກໍາລັງ​ຍ່າງ​ໄປ​ຕາມ​ຖະໜົນ​ໃກ້​ແຈ​ບ້ານ​ຂອງ​ນາງ,</para>
  <para style="q2" vid="PRO 7:8">ກໍາລັງ​ຍ່າງ​ຊື່​ໄປ​ຫາ​ເຮືອນ​ຂອງ​ນາງ<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />ໃນ​ຕອນ​ຄໍ່າ, ຂະນະ​ທີ່​ຕາເວັນ​ກໍາລັງ​ຕົກ​ດິນ,</para>
  <para style="q2" vid="PRO 7:9">ເມື່ອ​ຄວາມ​ມືດ​ໃນ​ຕອນ​ຄໍ່າ​ກໍາລັງ​ມາ.<verse eid="PRO 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />ມີ​ຍິງ​ຄົນ​ໜຶ່ງ​ອອກ​ມາ​ພົບ​ລາວ,</para>
  <para style="q2" vid="PRO 7:10">ນາງ​ແຕ່ງ​ຕົວ​ດັ່ງ​ຍິງ​ໂສເພນີ ແລະ ມີ​ເລ້ຫລ່ຽມ​ຢູ່​ໃນ​ໃຈ.<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />(ນາງ​ດື້ດ້ານ ແລະ ບໍ່​ຮູ້​ຈັກ​ອາຍ,</para>
  <para style="q2" vid="PRO 7:11">ນາງ​ບໍ່​ເຄີຍ​ຢູ່​ບ້ານ;<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />ຕອນນີ້ ນາງ​ຢູ່​ຕາມ​ຖະໜົນ, ບັດນີ້ ຢູ່​ຕາມ​ລານ​ສາທາລະນະ,</para>
  <para style="q2" vid="PRO 7:12">ນາງ​ດັກ​ຊຸ້ມ​ຢູ່​ຕາມ​ທຸກ​ແຈ​ຖະໜົນ.)<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />ນາງ​ໂດດ​ກອດ​ລາວ ແລະ ຈູບ​ລາວ</para>
  <para style="q2" vid="PRO 7:13">ແລະ ເວົ້າ​ແບບ​ໜ້າ​ບໍ່​ອາຍ​ວ່າ:<verse eid="PRO 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />“ມື້​ນີ້ ຂ້ອຍ​ໄດ້​ເຮັດ​ຕາມ​ທີ່​ຂ້ອຍ​ສາບານ​ໄວ້,</para>
  <para style="q2" vid="PRO 7:14">ແລະ ຂ້ອຍ​ມີ​ອາຫານ​ມາ​ຈາກ​ການ​ຖວາຍ​ເຄື່ອງບູຊາ​ເພື່ອ​ຄວາມ​ສາມັກຄີທຳ​ຢູ່​ເຮືອນ​ແລ້ວ.<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />ດັ່ງນັ້ນ ຂ້ອຍ​ຈຶ່ງ​ອອກ​ມາ​ພົບ​ເຈົ້າ;</para>
  <para style="q2" vid="PRO 7:15">ຂ້ອຍ​ໄດ້​ຊອກຫາ​ເຈົ້າ ແລະ ຂ້ອຍ​ກໍ​ໄດ້​ພົບ​ເຈົ້າ​ແລ້ວ!<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />ຂ້ອຍ​ໄດ້​ປູ​ບ່ອນ​ນອນ​ຂອງ​ຂ້ອຍ​ໄວ້</para>
  <para style="q2" vid="PRO 7:16">ດ້ວຍ​ຜ້າຝ້າຍ​ລີນິນ​ສີ​ສົດໃສ​ຈາກ​ເອຢິບ.<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />ຂ້ອຍ​ໄດ້​ພົມ​ບ່ອນນອນ​ໃຫ້​ຫອມ</para>
  <para style="q2" vid="PRO 7:17">ດ້ວຍ​ຢາງໄມ້ຫອມ ແລະ ອົບເຊີຍ.<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />ຈົ່ງ​ມາ, ມາ​ດື່ມດໍ່າ​ຄວາມ​ຮັກ​ນຳ​ກັນ​ຈົນ​ເຖິງ​ຕອນເຊົ້າ;</para>
  <para style="q2" vid="PRO 7:18">ໃຫ້​ພວກເຮົາ​ມ່ວນຊື່ນ​ນໍາ​ກັນ​ກັບ​ຄວາມ​ຮັກ!<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />ຜົວ​ຂອງ​ຂ້ອຍ​ບໍ່​ຢູ່​ເຮືອນ;</para>
  <para style="q2" vid="PRO 7:19">ລາວ​ໄດ້​ເດີນທາງ​ໄປ​ໄກ.<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />ລາວ​ຖື​ເງິນ​ໄປ​ເຕັມ​ກະເປົາ</para>
  <para style="q2" vid="PRO 7:20">ແລະ ຈະ​ບໍ່​ຢູ່​ເຮືອນ​ຈົນ​ເຖິງ​ວັນ​ເດືອນ​ເຕັມ​ດວງ”.<verse eid="PRO 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />ນາງ​ໄດ້​ເຮັດ​ໃຫ້​ລາວ​ຫລົງ​ດ້ວຍ​ຄຳເວົ້າ​ອັນ​ອ່ອນຫວານ;</para>
  <para style="q2" vid="PRO 7:21">ນາງ​ຫລອກລໍ້​ລາວ​ດ້ວຍ​ຄຳເວົ້າ​ອັນ​ນິ້ມນວນ.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />ທັນໃດນັ້ນ ລາວ​ກໍ​ຕິດຕາມ​ນາງ​ໄປ</para>
  <para style="q2" vid="PRO 7:22">ດັ່ງ​ງົວເຖິກ​ທີ່​ຖືກ​ຈູງ​ໄປ​ຂ້າ,</para>
  <para style="q1" vid="PRO 7:22">ດັ່ງ​ກວາງ​ທີ່​ກໍາລັງ​ຖືກ​ຕ້ອນ​ລົງ​ໄປ​ຂຸມແຮ້ວ<verse eid="PRO 7:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23" />ຈົນ​ຖືກ​ລູກ​ທະນູ​ແທງ​ທະລຸ​ເຖິງ​ຕັບ,</para>
  <para style="q1" vid="PRO 7:23">ລາວ​ເປັນ​ດັ່ງ​ນົກ​ບິນ​ເຂົ້າ​ໄປ​ໃນ​ບ້ວງແຮ້ວ,</para>
  <para style="q2" vid="PRO 7:23">ໂດຍ​ບໍ່​ຮູ້​ເລີຍ​ວ່າ​ຄວາມ​ຕາຍ​ຈະ​ເອົາ​ຊີວິດ​ຂອງ​ລາວ​ໄປ.<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />ບັດນີ້ ລູກ​ເອີຍ, ຈົ່ງ​ຟັງ​ພໍ່;</para>
  <para style="q2" vid="PRO 7:24">ຈົ່ງ​ເອົາໃຈໃສ່​ໃນ​ສິ່ງ​ທີ່​ພໍ່​ບອກ.<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />ຢ່າ​ປ່ອຍ​ໃຈ​ຂອງ​ເຈົ້າ​ໄປ​ຕາມ​ທາງ​ຂອງ​ນາງ</para>
  <para style="q2" vid="PRO 7:25">ຫລື ຢ່າ​ຫລົງ​ໄປ​ຕາມ​ວິຖີທາງ​ຂອງ​ນາງ.<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />ມີ​ຜູ້ຊາຍ​ຫລາຍ​ຄົນ​ເປັນ​ເຫຍື່ອ​ທີ່​ນາງ​ໄດ້​ເຮັດ​ໃຫ້​ລົ້ມ​ລົງ;</para>
  <para style="q2" vid="PRO 7:26">ຄົນ​ຍິ່ງໃຫຍ່​ກໍ​ຕາຍ​ເພາະ​ນາງ.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />ເຮືອນ​ຂອງ​ນາງ​ເປັນ​ທາງ​ຫລວງ​ໄປ​ສູ່​ຂຸມ​ຝັງສົບ,</para>
  <para style="q2" vid="PRO 7:27">ນຳ​ລົງ​ໄປ​ສູ່​ຫ້ອງ​ແຫ່ງ​ຄວາມ​ຕາຍ.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">ສຽງ​ເອີ້ນ​ຂອງ​ປັນຍາ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />ປັນຍາ​ບໍ່​ໄດ້​ເອີ້ນ​ຫາ​ບໍ?</para>
  <para style="q2" vid="PRO 8:1">ຄວາມ​ເຂົ້າໃຈ​ບໍ່​ໄດ້​ສົ່ງສຽງ​ເອີ້ນ​ບໍ?<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />ປັນຍາ​ຢືນ​ຢູ່​ເທິງ​ບ່ອນ​ສູງ​ໄປ​ຕາມ​ທາງ​ຍ່າງ,</para>
  <para style="q2" vid="PRO 8:2">ແລະ ໄປ​ຕາມ​ທາງ​ແຍກ, ປັນຍາ​ຢືນ​ຢູ່​ທີ່​ນັ້ນ;<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />ຢູ່​ຂ້າງ​ປະຕູ​ເຂົ້າ​ໄປ​ໃນ​ເມືອງ,</para>
  <para style="q2" vid="PRO 8:3">ຢູ່​ປາກ​ປະຕູ​ທາງ​ເຂົ້າ, ປັນຍາ​ຮ້ອງ​ສຽງ​ດັງ​ວ່າ:<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />“ໂອ ປະຊາຊົນ, ເຮົາ​ຮ້ອງ​ຫາ​ພວກເຈົ້າ;</para>
  <para style="q2" vid="PRO 8:4">ເຮົາ​ຍົກ​ສຽງ​ຂຶ້ນ​ຮ້ອງ​ຫາ​ມະນຸດ​ທຸກຄົນ.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />ເຈົ້າ​ຜູ້​ຜູ້​ເປັນ​ຄົນ​ອ່ອນ​ຕໍ່​ໂລກ, ຈົ່ງ​ມີ​ຄວາມ​ສຸຂຸມ​ຮອບຄອບ;</para>
  <para style="q2" vid="PRO 8:5">ເຈົ້າ​ຜູ້​ເປັນ​ຄົນໂງ່​ຈ້າ ຈົ່ງ​ໃສ່​ໃຈ​ໃນ​ສິ່ງ​ນີ້.<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ສະບັບ​ເຊັບຕູອາຈິນ ວ່າ ໂງ່ ຈົ່ງ​ສັ່ງສອນ​ຈິດໃຈ​ຂອງ​ຕົນ​ເອງ</char></note><verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />ຈົ່ງ​ຟັງ, ເພາະ​ເຮົາ​ມີ​ສິ່ງ​ທີ່​ສໍາຄັນ​ຫລາຍ​ຈະ​ມາ​ບອກ;</para>
  <para style="q2" vid="PRO 8:6">ເຮົາ​ອ້າ​ປາກ​ຂອງ​ເຮົາ​ເພື່ອ​ເວົ້າ​ສິ່ງ​ທີ່​ຖືກຕ້ອງ.<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />ປາກ​ຂອງ​ເຮົາ​ເວົ້າ​ສິ່ງ​ທີ່​ເປັນ​ຄວາມຈິງ,</para>
  <para style="q2" vid="PRO 8:7">ເພາະ​ຮີມ​ສົບ​ຂອງ​ເຮົາ​ກຽດຊັງ​ຄວາມ​ຊົ່ວຮ້າຍ.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />ຄໍາເວົ້າ​ທັງໝົດ​ຈາກ​ປາກ​ຂອງ​ເຮົາ​ແມ່ນ​ຍຸຕິທຳ;</para>
  <para style="q2" vid="PRO 8:8">ບໍ່​ມີ​ຄຳ​ໃດ​ທີ່​ຫລອກລວງ ຫລື ບິດເບືອນ.<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />ສໍາລັບ​ຜູ້​ທີ່​ພິຈາລະນາ​ຄໍາເວົ້າ​ທັງໝົດ​ຈະ​ເຂົ້າໃຈ;</para>
  <para style="q2" vid="PRO 8:9">ເປັນ​ຄໍາເວົ້າ​ທີ່​ທ່ຽງທຳ​ຕໍ່​ບັນດາ​ຜູ້​ທີ່​ຄົ້ນພົບ​ຄວາມ​ຮູ້.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />ຈົ່ງ​ເລືອກ​ເອົາ​ຄຳ​ສັ່ງສອນ​ຂອງ​ເຮົາ​ແທນ​ທີ່​ຈະ​ເລືອກ​ເອົາ​ເງິນ,</para>
  <para style="q2" vid="PRO 8:10">ຈົ່ງ​ເລືອກ​ເອົາ​ຄວາມ​ຮູ້​ຫລາຍ​ກວ່າ​ເລືອກ​ເອົາ​ຄໍາ​ເນື້ອ​ດີ,<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />ເພາະ​ປັນຍາ​ມີ​ຄ່າ​ກວ່າ​ເພັດພອຍ,</para>
  <para style="q2" vid="PRO 8:11">ແລະ ບໍ່​ມີ​ສິ່ງ​ໃດ​ທີ່​ເຈົ້າ​ປາຖະໜາ​ຈະ​ປຽບທຽບ​ກັບ​ປັນຍາ​ໄດ້.<verse eid="PRO 8:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />“ເຮົາ, ຄື​ປັນຍາ, ຢູ່​ຮ່ວມ​ກັນ​ກັບ​ຄວາມ​ຮອບຄອບ;</para>
  <para style="q2" vid="PRO 8:12">ເຮົາ​ມີ​ຄວາມ​ຮູ້ ແລະ ຄວາມ​ສະຫລາດ.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />ການ​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ​ແມ່ນ​ການ​ກຽດຊັງ​ຄວາມ​ຊົ່ວຮ້າຍ;</para>
  <para style="q2" vid="PRO 8:13">ເຮົາ​ກຽດຊັງ​ຄວາມ​ຈອງຫອງ ແລະ ຄວາມ​ໂອ້ອວດ,</para>
  <para style="q2" vid="PRO 8:13">ການ​ປະພຶດ​ຊົ່ວ ແລະ ການ​ເວົ້າ​ປີ້ນ​ຄວາມ.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />ຄຳ​ປຶກສາ ແລະ ການ​ຕັດສິນ​ທີ່​ຖືກຕ້ອງ​ເປັນ​ຂອງ​ເຮົາ;</para>
  <para style="q2" vid="PRO 8:14">ເຮົາ​ມີ​ຄວາມເຂົ້າໃຈ ແລະ ມີ​ອຳນາດ.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />ໂດຍ​ປັນຍາ ບັນດາ​ກະສັດ​ຈຶ່ງ​ໄດ້​ຂຶ້ນ​ປົກຄອງ</para>
  <para style="q2" vid="PRO 8:15">ແລະ ຜູ້​ປົກຄອງ​ກໍ​ອອກ​ກົດໝາຍ​ຢ່າງ​ຍຸຕິທຳ;<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />ໂດຍ​ປັນຍາ ບັນດາ​ເຈົ້ານາຍ​ຈຶ່ງ​ໄດ້​ຂຶ້ນ​ປົກຄອງ,</para>
  <para style="q2" vid="PRO 8:16">ແລະ ບັນດາ​ຂຸນນາງ​ຄື​ຜູ້​ທີ່​ປົກຄອງ​ທັງໝົດ​ຢູ່​ໃນ​ໂລກ.<note caller="+" style="f"><char style="fr" closed="false">8:16 </char><char style="ft" closed="false">ສຳເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ ໂດຍ​ເຮົາ ບັນດາ​ເຈົ້າຊີວິດ​ຈຶ່ງ​ປົກຄອງ ແລະ ບັນດາ​ຂຸນນາງ ຄື​ຜູ້​ປົກຄອງ​ທີ່​ຊອບທຳ​ທັງໝົດ​ກໍ​ເຊັ່ນ​ກັນ</char></note><verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />ເຮົາ​ຮັກ​ຄົນ​ທັງຫລາຍ​ທີ່​ຮັກ​ເຮົາ,</para>
  <para style="q2" vid="PRO 8:17">ແລະ ຜູ້​ທີ່​ຊອກ​ຫາ​ເຮົາ​ກໍ​ໄດ້​ພົບ​ເຮົາ.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />ເຮົາ​ມີ​ຊັບສົມບັດ ແລະ ມີ​ກຽດ,</para>
  <para style="q2" vid="PRO 8:18">ມີ​ຄວາມ​ຮັ່ງມີ ແລະ ຈະເລີນ​ຮຸ່ງເຮືອງ​ຕະຫລອດໄປ​ດ້ວຍ.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />ຜົນ​ຂອງ​ເຮົາ​ກໍ​ດີ​ກວ່າ​ຄຳ​ບໍລິສຸດ;</para>
  <para style="q2" vid="PRO 8:19">ສິ່ງ​ທີ່​ເຮົາ​ໃຫ້​ນັ້ນ​ກໍ​ມີ​ຄຸນຄ່າ​ຫລາຍ​ກວ່າ​ເງິນ​ເນື້ອ​ດີ.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />ເຮົາ​ເດີນ​ໃນ​ທາງ​ແຫ່ງ​ຄວາມ​ຊອບທຳ,</para>
  <para style="q2" vid="PRO 8:20">ຕາມ​ວິຖີ​ແຫ່ງ​ຄວາມ​ຍຸຕິທຳ,<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />ເຮົາ​ໃຫ້​ມໍລະດົກ​ລ້ຳຄ່າ​ແກ່​ຜູ້​ທີ່​ຮັກ​ເຮົາ</para>
  <para style="q2" vid="PRO 8:21">ແລະ ເຮັດ​ໃຫ້​ຄັງ​ສົມບັດ​ຂອງ​ພວກເຂົາ​ເຕັມ.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />“ພຣະເຈົ້າຢາເວ​ໄດ້​ສ້າງ​ເຮົາ​ຂຶ້ນ​ມາ​ເປັນ​ຜົນ​ງານ​ຊິ້ນ​ທຳອິດ,<note caller="+" style="f"><char style="fr" closed="false">8:22 </char><char style="ft" closed="false">ຫລື ທາງ ຫລື ອານາຈັກ</char></note><note caller="+" style="f"><char style="fr" closed="false">8:22 </char><char style="ft" closed="false">ຫລື ພຣະເຈົ້າຢາເວ​ຄອບຄອງ​ເຮົາ​ຕັ້ງແຕ່​ເລີ່ມ​ງານ​ຂອງ​ພຣະອົງ ຫລື ພຣະເຈົ້າຢາເວ​ນຳ​ເຮົາ​ອອກ​ມາ​ຕັ້ງແຕ່​ເລີ່ມ​ງານ​ຂອງ​ພຣະອົງ</char></note></para>
  <para style="q2" vid="PRO 8:22">ກ່ອນ​ກິດຈະການ​ຂອງ​ພຣະອົງ​ຕັ້ງແຕ່​ດົນນານ​ມາ​ແລ້ວ;<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />ເຮົາ​ໄດ້​ຖືກ​ສ້າງ​ມາ​ເມື່ອ​ດົນນານ​ມາ​ແລ້ວ,</para>
  <para style="q2" vid="PRO 8:23">ຕັ້ງແຕ່​ປະຖົມມະການ, ເມື່ອ​ໂລກ​ຖືກ​ສ້າງ​ຂຶ້ນ​ມາ.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />ເຮົາ​ເກີດ​ຂຶ້ນ​ມາ​ກ່ອນ​ຈະ​ມີ​ຫ້ວງ​ນໍ້າ​ເລິກ,</para>
  <para style="q2" vid="PRO 8:24">ກ່ອນ​ນ້ຳພຸ​ທີ່​ມີ​ນ້ຳ​ພຸ່ງ​ຂຶ້ນ​ມາ;<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />ກ່ອນ​ບັນດາ​ພູເຂົາ​ຈະ​ຖືກ​ໄວ້​ສ້າງ​ຂຶ້ນ​ໄວ້​ຢູ່​ໃນ​ບ່ອນ​ຂອງ​ມັນ,</para>
  <para style="q2" vid="PRO 8:25">ກ່ອນ​ມີ​ເນີນພູ, ເຮົາ​ກໍ​ເກີດ​ແລ້ວ,<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />ກ່ອນ​ທີ່​ພຣະເຈົ້າ​ໄດ້​ສ້າງ​ໂລກ ຫລື ທົ່ງຫຍ້າ​ທັງຫລາຍ</para>
  <para style="q2" vid="PRO 8:26">ຫລື ກ່ອນ​ຂີ້ຝຸ່ນ​ດິນ​ໃດໆ​ຂອງ​ໂລກ.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />ເຮົາ​ຢູ່​ທີ່​ນັ້ນ ເມື່ອ​ພຣະອົງ​ຈັດ​ວາງ​ຟ້າ​ສະຫວັນ,</para>
  <para style="q2" vid="PRO 8:27">ເມື່ອ​ພຣະອົງ​ຂີດ​ເສັ້ນ​ຂອບ​ຟ້າ​ເທິງ​ໜ້າ​ມະຫາສະໝຸດ,<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />ເມື່ອ​ພຣະອົງ​ວາງ​ຕຳແໜ່ງ​ເມກ​ເບື້ອງ​ເທິງ</para>
  <para style="q2" vid="PRO 8:28">ແລະ ໄດ້​ກຳນົດ​ຕານໍ້າ​ແຫ່ງ​ບາດານ​ຢ່າງ​ໝັ້ນຄົງ,<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />ເມື່ອ​ພຣະອົງ​ຂີດ​ພົມແດນ​ຂອງ​ທະເລ</para>
  <para style="q2" vid="PRO 8:29">ເພື່ອ​ບໍ່​ໃຫ້​ນ້ຳ​ລົ້ນ​ຂຶ້ນ​ເກີນ​ເຂດ​ຄໍາສັ່ງ​ຂອງ​ພຣະອົງ,</para>
  <para style="q1" vid="PRO 8:29">ແລະ ເມື່ອ​ພຣະອົງ​ວາງ​ຮາກຖານ​ຂອງ​ໂລກ.<verse eid="PRO 8:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30" />ໃນ​ເວລາ​ນັ້ນ ເຮົາ​ຢູ່​ຄຽງຂ້າງ​ພຣະອົງ​ຕະຫລອດ​ເວລາ.<note caller="+" style="f"><char style="fr" closed="false">8:30 </char><char style="ft" closed="false">ຫລື ໃນ​ຕອນ​ນັ້ນ​ເຮົາ​ເປັນ​ນາຍ​ຊ່າງ​ເອກ​ຢູ່​ຄຽງ​ຂ້າງ​ພຣະອົງ ຫລື ໃນ​ຕອນ​ນັ້ນ​ເຮົາ​ເປັນ​ເດັກ​ນ້ອຍໆ​ຢູ່​ຄຽງ​ຂ້າງ​ພຣະອົງ</char></note></para>
  <para style="q1" vid="PRO 8:30">ເຮົາ​ກໍ​ເຕັມ​ໄປ​ດ້ວຍ​ຄວາມ​ຍິນດີ​ວັນ​ຕໍ່​ວັນ,</para>
  <para style="q2" vid="PRO 8:30">ຊື່ນຊົມຍິນດີ​ຢູ່​ຕໍ່ໜ້າ​ພຣະອົງ​ສະເໝີ,<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />ຊື່ນຊົມຍິນດີ​ຢູ່​ໃນ​ໂລກ​ທັງໝົດ​ຂອງ​ພຣະອົງ</para>
  <para style="q2" vid="PRO 8:31">ແລະ ມີ​ຄວາມ​ຍິນດີ​ໃນ​ມະນຸດຊາດ.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />“ບັດນີ້ ລູກ​ເອີຍ, ຈົ່ງ​ຟັງ​ເຮົາ;</para>
  <para style="q2" vid="PRO 8:32">ຄວາມ​ສຸກ​ເປັນ​ຂອງ​ຜູ້ທີ່​ຮັກສາ​ວິຖີທາງ​ຂອງ​ເຮົາ.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />ຄວາມ​ສຸກ​ເປັນ​ຂອງ​ຜູ້​ທີ່​ຟັງ​ຄໍາ​ສັ່ງສອນ​ຂອງ​ເຮົາ ແລະ ຈະ​ກາຍ​ເປັນ​ຄົນ​ມີ​ປັນຍາ;</para>
  <para style="q2" vid="PRO 8:33">ຢ່າ​ເມີນເສີຍ​ຕໍ່​ຄໍາ​ສັ່ງສອນ​ນັ້ນ​ເລີຍ.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />ພຣະພອນ​ເປັນ​ຂອງ​ຜູ້​ທີ່​ຟັງ​ເຮົາ,</para>
  <para style="q2" vid="PRO 8:34">ຄື ຜູ້​ທີ່​ກໍາລັງ​ລໍຖ້າ​ຢູ່​ທີ່​ປະຕູ​ຂອງ​ເຮົາ​ທຸກໆ​ວັນ,</para>
  <para style="q2" vid="PRO 8:34">ລໍຖ້າ​ຢູ່​ປະຕູ​ເຮືອນ​ຂອງ​ເຮົາ.<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />ເພາະ​ຄົນ​ທີ່​ພົບ​ເຮົາ​ຍ່ອມ​ພົບ​ຊີວິດ</para>
  <para style="q2" vid="PRO 8:35">ແລະ ໄດ້​ຮັບ​ຄວາມ​ພໍໃຈ​ຈາກ​ພຣະເຈົ້າ​ຢາເວ.<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />ແຕ່​ຄົນ​ທີ່​ບໍ່​ພົບ​ເຮົາ​ກໍ​ຮັກ​ຄວາມ​ຕາຍ;</para>
  <para style="q2" vid="PRO 8:36">ທຸກຄົນ​ທີ່​ກຽດຊັງ​ເຮົາ​ກໍ​ຮັກ​ຄວາມ​ຕາຍ”.<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">ຄຳ​ເຊີນ​ຂອງ​ປັນຍາ ແລະ ຄວາມ​ໂງ່ຈ້າ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />ປັນຍາ​ໄດ້​ສ້າງ​ບ້ານ​ຂອງ​ຕົນ​ຂຶ້ນ;</para>
  <para style="q2" vid="PRO 9:1">ປັນຍາ​ໄດ້​ຕັ້ງ​ເສົາ​ເຈັດ​ຕົ້ນ.<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />ປັນຍາ​ໄດ້​ຕຽມ​ຊີ້ນ ແລະ ປະສົມ​ເຫລົ້າ​ອະງຸ່ນ​ໄວ້;</para>
  <para style="q2" vid="PRO 9:2">ປັນຍາ​ຍັງ​ໄດ້​ຈັດ​ໂຕະ​ໄວ້​ດ້ວຍ.<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />ປັນຍາ​ໄດ້​ສົ່ງ​ຄົນຮັບໃຊ້​ອອກ​ໄປ, ແລະ ຮ້ອງ​ບອກ</para>
  <para style="q2" vid="PRO 9:3">ຈາກ​ບ່ອນ​ສູງສຸດ​ຢູ່​ໃນ​ເມືອງ​ວ່າ,<verse eid="PRO 9:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 9:4" />“ໃຫ້​ທຸກຄົນ​ທີ່​ບໍ່​ຮູ້ຈັກ​ຄິດ ເຂົ້າ​ມາ​ໃນ​ເຮືອນ​ຂອງ​ເຮົາ!”</para>
  <para style="q1" vid="PRO 9:4">ປັນຍາ​ເວົ້າ​ກັບ​ຄົນ​ທີ່​ບໍ່ຮູ້ຈັກຄິດ​ວ່າ,<verse eid="PRO 9:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 9:5" />“ຈົ່ງ​ມາ​ກິນ​ເຂົ້າ​ຂອງ​ເຮົາ</para>
  <para style="q2" vid="PRO 9:5">ແລະ ດື່ມ​ເຫລົ້າ​ອະງຸ່ນ​ທີ່​ເຮົາ​ໄດ້​ປະສົມ​ໄວ້.<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />ຈົ່ງ​ປະຖິ້ມ​ວິຖີທາງ​ອັນ​ບໍ່ຮູ້ຈັກຄິດ​ຂອງ​ເຈົ້າ ແລະ ເຈົ້າ​ຈະ​ມີຊີວິດ​ຢູ່;</para>
  <para style="q2" vid="PRO 9:6">ຈົ່ງ​ເດີນ​ຕາມ​ທາງ​ແຫ່ງ​ຄວາມ​ເຂົ້າໃຈ”.<verse eid="PRO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />ຜູ້​ໃດ​ທີ່​ຕັກເຕືອນ​ຄົນ​ມັກ​ເຢາະເຢີ້ຍ​ກໍ​ຈະ​ຖືກ​ດູໝິ່ນ;</para>
  <para style="q2" vid="PRO 9:7">ຜູ້​ທີ່​ຕຳໜິ​ຄົນ​ຊົ່ວຮ້າຍ ກໍ​ຈະ​ຖືກ​ທໍາຮ້າຍ.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />ຢ່າ​ໄປ​ຕຳໜິ​ຄົນ​ມັກ​ເຢາະເຢີ້ຍ ເພາະ​ພວກເຂົາ​ຈະ​ກຽດຊັງ​ເຈົ້າ;</para>
  <para style="q2" vid="PRO 9:8">ຈົ່ງ​ຕຳໜິ​ຄົນ​ສະຫລາດ ແລະ ພວກເຂົາ​ຈະ​ຮັກ​ເຈົ້າ.<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />ຈົ່ງ​ສັ່ງສອນ​ຄົນ​ສະຫລາດ ແລ້ວ​ພວກເຂົາ​ຈະ​ສະຫລາດ​ຫລາຍ​ກວ່າ​ເກົ່າ;</para>
  <para style="q2" vid="PRO 9:9">ຈົ່ງ​ສອນ​ຄົນ​ຊອບທຳ ແລ້ວ​ພວກເຂົາ​ຈະ​ເພີ່ມ​ການ​ຮຽນຮູ້​ຂອງ​ພວກເຂົາ​ໃຫ້​ຫລາຍ​ຂຶ້ນ.<verse eid="PRO 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />ການ​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ​ເປັນ​ບໍ່​ເກີດ​ຂອງ​ປັນຍາ,</para>
  <para style="q2" vid="PRO 9:10">ແລະ ການ​ຮູ້ຈັກ​ອົງ​ບໍລິສຸດ​ເປັນ​ບໍ່​ເກີດ​ແຫ່ງ​ຄວາມ​ເຂົ້າໃຈ.<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />ເພາະ​ໂດຍ​ທາງ​ປັນຍາ ວັນ​ເວລາ​ຂອງ​ເຈົ້າ​ຈະ​ມີ​ຫລາຍ​ຂຶ້ນ,</para>
  <para style="q2" vid="PRO 9:11">ແລະ ເຈົ້າ​ຈະ​ມີ​ອາຍຸ​ຍືນຍາວ.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />ຖ້າ​ເຈົ້າ​ມີ​ປັນຍາ, ປັນຍາ​ຂອງ​ເຈົ້າ​ຈະ​ໃຫ້​ບຳເໜັດ​ແກ່​ເຈົ້າ;</para>
  <para style="q2" vid="PRO 9:12">ຖ້າ​ເຈົ້າ​ເປັນ​ຄົນ​ມັກ​ເຢາະເຢີ້ຍ, ເຈົ້າ​ກໍ​ຈະ​ທົນທຸກ​ຢູ່​ຄົນ​ດຽວ.<verse eid="PRO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />ຄວາມ​ໂງ່ຈ້າ​ເປັນ​ດັ່ງ​ຍິງ​ດື້ດ້ານ;</para>
  <para style="q2" vid="PRO 9:13">ນາງ​ເປັນ​ຄົນ​ບໍ່​ຮູ້ຈັກ​ຄິດ ແລະ ບໍ່​ຮູ້​ຫຍັງ​ເລີຍ.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />ນາງ​ນັ່ງ​ຢູ່​ປະຕູ​ເຮືອນ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 9:14">ຫລື ນັ່ງ​ຢູ່​ບ່ອນ​ສູງ​ໃນ​ເມືອງ,<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />ນາງ​ເອີ້ນ​ໃສ່​ຄົນ​ທີ່​ຍ່າງ​ຜ່ານ​ໄປ​ມາ,</para>
  <para style="q2" vid="PRO 9:15">ຜູ້​ທີ່​ໃສ່​ໃຈ​ກິດທຸລະ​ຂອງ​ຕົນ​ເອງ​ວ່າ,<verse eid="PRO 9:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="PRO 9:16" />“ໃຫ້​ທຸກຄົນ​ທີ່​ບໍ່ຮູ້ຈັກຄິດ, ເຂົ້າ​ມາ​ໃນ​ເຮືອນ​ຂອງ​ເຮົາ!”</para>
  <para style="q1" vid="PRO 9:16">ນາງ​ເວົ້າ​ກັບ​ຄົນ​ທີ່​ບໍ່ຮູ້ຈັກຄິດວ່າ,<verse eid="PRO 9:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 9:17" />“ນໍ້າ​ທີ່​ລັກ​ມາ​ກໍ​ຫວານ​ຊື່ນ​ໃຈ;</para>
  <para style="q2" vid="PRO 9:17">ອາຫານ​ທີ່​ລີ້​ກິນ​ກໍ​ແຊບ​ດີ!”<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />ແຕ່​ພວກເຂົາ​ຮູ້​ບໍ່​ວ່າ ມີ​ຄົນຕາຍ​ຢູ່ທີ່​ນັ້ນ,</para>
  <para style="q2" vid="PRO 9:18">ແຂກ​ທັງຫລາຍ​ຂອງ​ນາງ​ກໍ​ຢູ່​ໃນ​ແດນ​ແຫ່ງ​ຄວາມ​ຕາຍ.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="ms1">ສຸພາສິດ​ຂອງ​ໂຊໂລໂມນ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />ສຸພາສິດ​ຂອງ​ໂຊໂລໂມນ​ມີ​ດັ່ງ​ນີ້:</para>
  <para style="q1" vid="PRO 10:1">ລູກ​ທີ່​ມີ​ປັນຍາ​ເຮັດ​ໃຫ້​ພໍ່​ຂອງ​ຕົນ​ມີ​ຄວາມ​ສຸກ,</para>
  <para style="q2" vid="PRO 10:1">ແຕ່​ລູກ​ທີ່​ໂງ່​ຈ້າ​ເຮັດ​ໃຫ້​ແມ່​ໂສກເສົ້າ.<verse eid="PRO 10:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />ຊັບສົມບັດ​ທີ່​ໄດ້​ມາ​ຢ່າງ​ບໍ່​ສັດຊື່​ນັ້ນ​ບໍ່​ມີ​ຄຸນຄ່າ​ຍືນຍົງ,</para>
  <para style="q2" vid="PRO 10:2">ແຕ່​ຄວາມ​ຊອບທຳ​ຊ່ວຍ​ໃຫ້​ພົ້ນ​ຈາກ​ຄວາມ​ຕາຍ.<verse eid="PRO 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />ພຣະເຈົ້າ​ຢາເວ​ຈະ​ບໍ່​ປ່ອຍ​ໃຫ້​ຄົນ​ຊອບທຳ​ອຶດຫິວ,</para>
  <para style="q2" vid="PRO 10:3">ແຕ່​ພຣະອົງ​ຈະ​ຂັດຂວາງ​ບໍ່​ໃຫ້​ຄົນ​ຊົ່ວຮ້າຍ​ໄດ້​ຕາມ​ໃຈ​ປາຖະໜາ.<verse eid="PRO 10:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />ມື​ທີ່​ຂີ້ຄ້ານ​ເຮັດ​ໃຫ້​ທຸກ​ຈົນ​ລົງ</para>
  <para style="q2" vid="PRO 10:4">ແຕ່​ມື​ທີ່​ດຸໝັ່ນ​ເຮັດ​ໃຫ້​ຮັ່ງມີ​ຂຶ້ນ.<verse eid="PRO 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />ຄົນ​ທີ່​ຮວບຮວມ​ເອົາ​ຜົນລະປູກ​ໄວ້​ໃນ​ລະດູຮ້ອນ​ກໍ​ເປັນ​ລູກ​ທີ່​ສະຫລາດ</para>
  <para style="q2" vid="PRO 10:5">ແຕ່​ຄົນ​ທີ່​ນອນຫລັບ​ໃນ​ລະດູ​ເກັບກ່ຽວ​ກໍ​ເປັນ​ລູກ​ທີ່​ອັບອາຍ​ຂາຍໜ້າ.<verse eid="PRO 10:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />ພຣະພອນ​ຢູ່​ເທິງ​ຫົວ​ຂອງ​ຄົນ​ຊອບທຳ,</para>
  <para style="q2" vid="PRO 10:6">ແຕ່​ຄວາມ​ຮຸນແຮງ​ໄຫລ​ຖ້ວມ​ປາກ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ.<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false">ຫລື ແຕ່​ປາກ​ຂອງ​ຄົນ​ຊົ່ວ​ຊ້ອນ​ຄວາມ​ໂຫດຮ້າຍ​ທາລຸນ</char></note><verse eid="PRO 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />ຊື່​ຂອງ​ຄົນ​ຊອບທຳ​ຈະ​ໃຊ້​ເປັນ​ຄຳ​ອວຍພອນ,</para>
  <para style="q2" vid="PRO 10:7">ແຕ່​ຊື່​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ຈະ​ເສື່ອມເສຍ​ໄປ.<verse eid="PRO 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />ໃຈ​ຂອງ​ຄົນ​ມີ​ປັນຍາ​ຈະ​ຮັບ​ເອົາ​ຄຳ​ສັ່ງສອນ,</para>
  <para style="q2" vid="PRO 10:8">ແຕ່​ຄົນ​ໂງ່ຈ້າ​ທີ່​ເວົ້າ​ໂລເລ​ກໍ​ຈະ​ພົບ​ຄວາມ​ຈິບຫາຍ.<verse eid="PRO 10:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />ຜູ້​ໃດ​ກໍ່​ຕາມ​ທີ່​ເດີນ​ຢູ່​ໃນ​ທາງ​ທີ່​ສັດຊື່​ກໍ​ຈະ​ຍ່າງ​ຢ່າງ​ປອດໄພ,</para>
  <para style="q2" vid="PRO 10:9">ແຕ່​ຜູ້​ໃດ​ກໍ່​ຕາມ​ທີ່​ເດີນ​ຢູ່​ໃນ​ທາງ​ທີ່​ບໍ່​ສັດຊື່​ຈະ​ຖືກ​ເປີດເຜີຍ.<verse eid="PRO 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />ຜູ້​ທີ່​ຍິກຄິ້ວ​ຢ່າງ​ມີ​ເລ້ຫລ່ຽມ​ກໍ​ສ້າງ​ຄວາມ​ເດືອດຮ້ອນ,</para>
  <para style="q2" vid="PRO 10:10">ແລະ ຄົນ​ໂງ່ຈ້າ​ທີ່​ເວົ້າ​ໂລເລ​ກໍ​ຈະ​ພົບ​ຄວາມ​ຈິບຫາຍ.<verse eid="PRO 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />ປາກ​ຂອງ​ຄົນ​ຊອບທຳ​ເປັນ​ນ້ຳພຸ​ແຫ່ງ​ຊີວິດ,</para>
  <para style="q2" vid="PRO 10:11">ແຕ່​ປາກ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ເຊື່ອງຊ້ອນ​ຄວາມ​ໂຫດຮ້າຍ.<verse eid="PRO 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />ຄວາມ​ກຽດຊັງ​ເຮັດ​ໃຫ້​ເກີດ​ຄວາມ​ຂັດແຍ້ງ,</para>
  <para style="q2" vid="PRO 10:12">ແຕ່​ຄວາມ​ຮັກ​ກໍ​ປົກປິດ​ຄວາມຜິດ​ທັງໝົດ.<verse eid="PRO 10:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />ປັນຍາ​ພົບ​ໄດ້​ຢູ່​ໃນ​ຮິມສົບ​ຂອງ​ຜູ້​ທີ່​ມີ​ຄວາມ​ເຂົ້າໃຈ​ແຈ້ງ​ດີ,</para>
  <para style="q2" vid="PRO 10:13">ແຕ່​ໄມ້​ແສ້​ມີ​ໄວ້​ສໍາລັບ​ຫລັງ​ຂອງ​ຄົນ​ທີ່​ບໍ່ຮູ້ຈັກຄິດ.<verse eid="PRO 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />ຄົນ​ມີ​ປັນຍາ​ກໍ​ສະ​ສົມ​ຄວາມ​ຮູ້​ໄວ້,</para>
  <para style="q2" vid="PRO 10:14">ແຕ່​ປາກ​ຂອງ​ຄົນ​ໂງ່ຈ້າ​ນຳ​ເອົາ​ຄວາມ​ຈິບຫາຍ​ມາ.<verse eid="PRO 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />ຊັບສົມບັດ​ຂອງ​ຄົນ​ຮັ່ງມີ​ເປັນ​ດັ່ງ​ປ້ອມ​ປ້ອງກັນ​ເມືອງ​ຂອງ​ພວກເຂົາ,</para>
  <para style="q2" vid="PRO 10:15">ແຕ່​ຄວາມ​ທຸກຍາກ​ເປັນ​ດັ່ງ​ຄວາມ​ຈິບຫາຍ​ຂອງ​ຄົນ​ທຸກ.<verse eid="PRO 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />ຄ່າຈ້າງ​ຂອງ​ຄົນ​ຊອບທຳ​ຄື​ຊີວິດ,</para>
  <para style="q2" vid="PRO 10:16">ແຕ່​ລາຍໄດ້​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ຄື​ຄວາມ​ບາບ ແລະ ຄວາມ​ຕາຍ.<verse eid="PRO 10:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />ຜູ້​ໃດ​ກໍ່​ຕາມ​ທີ່​ເອົາໃຈໃສ່​ລະບຽບ​ວິໄນ​ກໍ​ສະແດງ​ທາງ​ສູ່​ຊີວິດ,</para>
  <para style="q2" vid="PRO 10:17">ແຕ່​ຜູ້​ໃດ​ກໍ່​ຕາມ​ທີ່​ບໍ່​ຍອມ​ຮັບ​ການ​ດັດແປງແກ້ໄຂ​ກໍ​ພາ​ຄົນ​ອື່ນ​ໄປ​ໃນ​ທາງ​ທີ່​ຜິດ.<verse eid="PRO 10:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />ຜູ້​ທີ່​ເຊື່ອງ​ຄວາມ​ກຽດຊັງ​ດ້ວຍ​ປາກ​ທີ່​ເວົ້າ​ຕົວະ</para>
  <para style="q2" vid="PRO 10:18">ແລະ ຜູ້​ທີ່​ກະຈາຍ​ຄໍາ​ນິນທາ​ກໍ​ເປັນ​ຄົນ​ໂງ່​ຈ້າ.<verse eid="PRO 10:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />ຄວາມ​ບາບ​ບໍ່​ໄດ້​ຈົບ​ສິ້ນ​ດ້ວຍ​ການ​ເວົ້າ​ຫລາຍ,</para>
  <para style="q2" vid="PRO 10:19">ແຕ່​ຄົນ​ສະຫລາດ​ກໍ​ລະງັບ​ລີ້ນ​ຂອງ​ຕົນ.<verse eid="PRO 10:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />ລີ້ນ​ຂອງ​ຄົນ​ຊອບທຳ​ເປັນ​ດັ່ງ​ເງິນ​ຊັ້ນ​ດີ,</para>
  <para style="q2" vid="PRO 10:20">ແຕ່​ໃຈ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ກໍ​ມີ​ຄຸນຄ່າ​ໜ້ອຍດຽວ.<verse eid="PRO 10:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />ຮິມສົບ​ຂອງ​ຄົນ​ຊອບທຳ​ກໍ​ລ້ຽງດູ​ຄົນ​ຈຳນວນ​ຫລາຍ,</para>
  <para style="q2" vid="PRO 10:21">ແຕ່​ຄົນ​ໂງ່​ຈ້າ​ຕາຍ​ເພາະ​ຂາດ​ສາມັນ​ສໍານຶກ.<verse eid="PRO 10:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />ພຣະພອນ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ນຳ​ຄວາມຮັ່ງມີ​ມາ​ໃຫ້,</para>
  <para style="q2" vid="PRO 10:22">ໂດຍ​ບໍ່​ໄດ້​ເຮັດ​ວຽກ​ໜັກ​ເພື່ອ​ຈະ​ຮັ່ງມີ.<verse eid="PRO 10:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />ຄົນ​ໂງ່​ຈ້າ​ພໍໃຈ​ໃນ​ແຜນການ​ອັນ​ຊົ່ວ</para>
  <para style="q2" vid="PRO 10:23">ແຕ່​ຄົນ​ທີ່​ມີ​ຄວາມ​ເຂົ້າໃຈ​ກໍ​ຍິນດີ​ໃນ​ປັນຍາ​ຂອງ​ຕົນ.<verse eid="PRO 10:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />ສິ່ງ​ທີ່​ຄົນ​ຊົ່ວຮ້າຍ​ຢ້ານ​ຈະ​ໄລ່​ທັນ​ພວກເຂົາ;</para>
  <para style="q2" vid="PRO 10:24">ສິ່ງ​ທີ່​ຄົນ​ຊອບທຳ​ປາຖະໜາ​ກໍ​ຈະ​ໄດ້​ຮັບ.<verse eid="PRO 10:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />ເມື່ອ​ລົມພະຍຸ​ພັດ​ຜ່ານ ຄົນ​ຊົ່ວຮ້າຍ​ກໍ​ຖືກ​ພັດ​ໄປ,</para>
  <para style="q2" vid="PRO 10:25">ແຕ່​ຄົນ​ຊອບທຳ​ຢືນ​ຢູ່​ຢ່າງ​ໝັ້ນຄົງ​ຕະຫລອດໄປ.<verse eid="PRO 10:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />ເໝືອນ​ດັ່ງ​ນ້ຳ​ສົ້ມ​ກັບ​ແຂ້ວ ແລະ ຄວັນໄຟ​ກັບ​ຕາ​ບໍ່​ຖືກ​ກັນ​ສັນໃດ</para>
  <para style="q2" vid="PRO 10:26">ຄົນ​ຂີ້ຄ້ານ​ກັບ​ນາຍຈ້າງ​ກໍ​ບໍ່​ຖືກ​ກັນ​ສັນນັ້ນ.<verse eid="PRO 10:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />ການ​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ​ເຮັດ​ໃຫ້​ມີ​ຊີວິດ​ຍືນຍາວ,</para>
  <para style="q2" vid="PRO 10:27">ແຕ່​ປີ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ຈະ​ຖືກ​ຕັດ​ໃຫ້​ສັ້ນ​ເຂົ້າ.<verse eid="PRO 10:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />ຄວາມ​ຫວັງ​ຂອງ​ຄົນ​ຊອບທຳ​ຄື​ຄວາມ​ຊົມຊື່ນ​ຍິນດີ,</para>
  <para style="q2" vid="PRO 10:28">ແຕ່​ຄວາມ​ຫວັງ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ກໍ​ບໍ່​ມີ​ຫຍັງ.<verse eid="PRO 10:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />ທາງ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ເປັນ​ບ່ອນ​ລີ້ໄພ​ສໍາລັບ​ຄົນ​ທີ່​ບໍ່​ມີ​ຕຳໜິ,</para>
  <para style="q2" vid="PRO 10:29">ແຕ່​ເປັນ​ຄວາມ​ຈິບຫາຍ​ຂອງ​ຄົນ​ທີ່​ເຮັດ​ຊົ່ວ.<verse eid="PRO 10:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />ຄົນ​ຊອບທຳ​ຈະ​ບໍ່​ມີ​ວັນ​ຖືກ​ຖອນ​ຮາກ,</para>
  <para style="q2" vid="PRO 10:30">ແຕ່​ຄົນ​ຊົ່ວຮ້າຍ​ຈະ​ບໍ່​ໝັ້ນຄົງ​ຢູ່​ໃນ​ແຜ່ນດິນ.<verse eid="PRO 10:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />ປາກ​ຂອງ​ຄົນ​ຊອບທຳ​ນໍາ​ເອົາ​ຜົນ​ແຫ່ງ​ປັນຍາ​ມາ​ໃຫ້,</para>
  <para style="q2" vid="PRO 10:31">ແຕ່​ລີ້ນ​ທີ່​ມັກ​ປີ້ນ​ຄວາມ​ຈະ​ຖືກ​ລະງັບ​ໄວ້.<verse eid="PRO 10:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />ຮິມ​ສົບ​ຂອງ​ຄົນ​ຊອບທຳ​ຮູ້ຈັກ​ວ່າ​ຈະເຮັດ​ສິ່ງໃດ​ຈຶ່ງ​ໄດ້​ຮັບ​ຄວາມ​ກະລຸນາ,</para>
  <para style="q2" vid="PRO 10:32">ແຕ່​ປາກ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ເວົ້າ​ແຕ່​ສິ່ງ​ທີ່​ເຮັດ​ໃຫ້​ເຈັບໃຈ.<verse eid="PRO 10:32" /></para>
  <para style="b" />
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />ພຣະເຈົ້າ​ຢາເວ​ກຽດຊັງ​ຕາຊິງ​ທີ່​ບໍ່ສັດຊື່,</para>
  <para style="q2" vid="PRO 11:1">ແຕ່​ພຣະອົງ​ພໍໃຈ​ນໍາ​ການ​ຊັ່ງ​ຕວງ​ທີ່​ຖືກຕ້ອງ.<verse eid="PRO 11:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />ເມື່ອ​ຄວາມ​ອວດຕົວ​ມາ, ຄວາມ​ອັບອາຍ​ຂາຍໜ້າ​ກໍ​ຕາມ​ມາ,</para>
  <para style="q2" vid="PRO 11:2">ແຕ່​ປັນຍາ​ມາ​ນໍາ​ຄວາມ​ຖ່ອມຕົວ.<verse eid="PRO 11:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />ຄວາມ​ສັດຊື່​ນຳ​ທາງ​ຄົນ​ທ່ຽງທຳ,</para>
  <para style="q2" vid="PRO 11:3">ແຕ່​ຄວາມ​ບໍ່​ສັດຊື່​ກໍ​ຖືກ​ທຳລາຍ​ດ້ວຍ​ກົນອຸບາຍ​ຂອງ​ຕົນ.<verse eid="PRO 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />ຄວາມ​ຮັ່ງມີ​ຈະ​ຊ່ວຍ​ຫຍັງ​ບໍ່​ໄດ້​ໃນ​ວັນ​ແຫ່ງ​ຄວາມ​ໂກດຮ້າຍ,</para>
  <para style="q2" vid="PRO 11:4">ແຕ່​ຄວາມ​ຊອບທຳ​ຊ່ວຍ​ໃຫ້​ພົ້ນ​ຈາກ​ຄວາມ​ຕາຍ.<verse eid="PRO 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />ຄວາມ​ຊອບທຳ​ຂອງ​ຄົນ​ບໍ່​ມີ​ທີ່​ຕຳໜິ​ເຮັດ​ໃຫ້​ທາງ​ຂອງ​ພວກເຂົາ​ຊື່​ໄປ.</para>
  <para style="q2" vid="PRO 11:5">ແຕ່​ຄົນ​ຊົ່ວຮ້າຍ​ຈະ​ລົ້ມ​ລົງ​ດ້ວຍ​ຄວາມ​ຊົ່ວ​ຮ້າຍ​ຂອງ​ຕົນ.<verse eid="PRO 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />ຄວາມ​ຊອບທຳ​ຂອງ​ຄົນ​ທ່ຽງທຳ​ຊ່ວຍ​ພວກເຂົາ​ໃຫ້​ພົ້ນ,</para>
  <para style="q2" vid="PRO 11:6">ແຕ່​ຄົນ​ບໍ່​ສັດຊື່​ຈະ​ຖືກ​ບ້ວງແຮ້ວ​ຍ້ອນ​ຄວາມປາດຖະໜາ​ຊົ່ວ​ຂອງ​ຕົນ.<verse eid="PRO 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />ຄວາມ​ຫວັງ​ທີ່​ຝາກ​ໄວ້​ນໍາ​ຄົນ​ຊົ່ວ​ກໍ​ຕາຍ​ໄປ​ພ້ອມ​ກັບ​ພວກເຂົາ;</para>
  <para style="q2" vid="PRO 11:7">ຄໍາສັນຍາ​ທັງໝົດ​ແຫ່ງ​ອໍານາດ​ຂອງ​ພວກເຂົາ​ກໍ​ຈະ​ສູນ​ເປົ່າ.<note caller="+" style="f"><char style="fr" closed="false">11:7 </char><char style="ft" closed="false">ຫລື ຄວາມ​ຫວັງ​ທີ່​ຝາກ​ໄວ້​ກັບ​ສິ່ງ​ທີ່​ບໍ່​ຈີລັງ​ກໍ​ຕາຍ​ໄປ​ພ້ອມ​ກັບ​ມັນ ຄຳ​ສັນຍາ​ທີ່​ໄດ້​ຈາກ​ອຳນາດ​ຂອງ​ສິ່ງ​ທີ່​ບໍ່​ຈີລັງ​ກໍ​ສູນ​ເປົ່າ</char></note><verse eid="PRO 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />ຄົນ​ຊອບທຳ​ໄດ້​ຮັບ​ການ​ກອບກູ້​ໃຫ້​ພົ້ນ​ຈາກ​ຄວາມ​ເດືອດຮ້ອນ.</para>
  <para style="q2" vid="PRO 11:8">ແຕ່​ຄວາມ​ເດືອດຮ້ອນ​ນັ້ນ​ຈະ​ຕົກ​ໃສ່​ຄົນ​ຊົ່ວຮ້າຍ​ແທນ.<verse eid="PRO 11:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />ປາກ​ຂອງ​ຄົນ​ບໍ່​ຮູ້​ພຣະເຈົ້າ​ທຳລາຍ​ເພື່ອນບ້ານ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 11:9">ແຕ່​ຄົນ​ຊອບທຳ​ໜີ​ໄປ​ໄດ້​ໂດຍ​ອາໄສ​ຄວາມ​ຮູ້.<verse eid="PRO 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />ເມື່ອ​ຄົນຊອບທຳ​ຈະເລີນ​ຮຸ່ງເຮືອງ, ບ້ານ​ເມືອງ​ກໍ​ຊົມຊື່ນຍິນດີ;</para>
  <para style="q2" vid="PRO 11:10">ເມື່ອ​ຄົນ​ຊົ່ວຮ້າຍ​ຈິບຫາຍ​ໄປ, ກໍ​ມີ​ສຽງ​ໂຮຮ້ອງ​ຍິນ​ດີ.<verse eid="PRO 11:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />ໂດຍ​ພອນ​ຂອງ​ຄົນ​ທ່ຽງທຳ ບ້ານ​ເມືອງ​ກໍ​ໄດ້​ຮັບການ​ຍົກຍ້ອງ,</para>
  <para style="q2" vid="PRO 11:11">ແຕ່​ໂດຍ​ປາກ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ ບ້ານ​ເມືອງ​ກໍ​ຖືກ​ທໍາລາຍ.<verse eid="PRO 11:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />ຄົນ​ບໍ່ຮູ້ຈັກຄິດ​ກໍ​ດູຖູກ​ເພື່ອນບ້ານ​ຂອງຕົນ,</para>
  <para style="q2" vid="PRO 11:12">ແຕ່​ຄົນ​ທີ່​ມີ​ຄວາມ​ເຂົ້າໃຈ​ກໍ​ຄວບຄຸມ​ລີ້ນ​ຂອງ​ຕົນ​ໄວ້.<verse eid="PRO 11:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />ຄຳ​ນິນທາ​ທໍລະຍົດ​ຄວາມ​ໄວ້ວາງໃຈ,</para>
  <para style="q2" vid="PRO 11:13">ແຕ່​ຄົນ​ທີ່​ສັດຊື່​ໄດ້​ກໍ​ຮັກສາ​ຄວາມ​ລັບ​ໄວ້.<verse eid="PRO 11:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />ເພາະ​ຂາດ​ການຊີ້ນຳ ປະເທດ​ຊາດ​ກໍ​ລົ້ມ​ຈົມ,</para>
  <para style="q2" vid="PRO 11:14">ແຕ່​ມີ​ທີ່ປຶກສາ​ຫລາຍ​ຄົນ​ກໍ​ປອດໄພ.<verse eid="PRO 11:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />ຜູ້​ໃດ​ກໍ່​ຕາມ​ທີ່​ຄ້ຳປະກັນ​ໃຫ້​ຄົນແປກໜ້າ​ຈະ​ເດືອດຮ້ອນ​ແນ່ນອນ,</para>
  <para style="q2" vid="PRO 11:15">ແຕ່​ຜູ້​ທີ່​ປະຕິເສດ​ການ​ຈັບ​ມື​ສັນຍາ​ກໍ​ປອດໄພ.<verse eid="PRO 11:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />ຍິງ​ທີ່​ມີ​ໃຈ​ເມດຕາ​ກໍ​ໄດ້​ຮັບ​ກຽດ,</para>
  <para style="q2" vid="PRO 11:16">ແຕ່​ຊາຍ​ໂຫດຮ້າຍ​ໄດ້​ພຽງແຕ່​ຄວາມ​ຮັ່ງມີ​ເທົ່ານັ້ນ.<verse eid="PRO 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />ຜູ້​ທີ່​ມີ​ໃຈ​ເມດຕາ​ກໍ​ສ້າງ​ປະໂຫຍດ​ໃຫ້​ຕົນເອງ,</para>
  <para style="q2" vid="PRO 11:17">ແຕ່​ຜູ້​ທີ່​ໂຫດ​ຮ້າຍ​ນໍາ​ຄວາມ​ຈິບຫາຍ​ມາ​ສູ່​ຕົນເອງ.<verse eid="PRO 11:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />ຄົນ​ຊົ່ວຮ້າຍ​ໄດ້​ຄ່າ​ຈ້າງ​ທີ່​ຫລອກລວງ,</para>
  <para style="q2" vid="PRO 11:18">ແຕ່​ຜູ້​ທີ່​ຫວ່ານ​ຄວາມ​ຊອບທຳ ຍ່ອມ​ໄດ້​ຮັບ​ບຳເໜັດ​ຢ່າງ​ແນ່ນອນ.<verse eid="PRO 11:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />ຄົນ​ຊອບທຳ​ຈະ​ໄດ້​ຮັບ​ຊີວິດ​ທີ່​ແທ້ຈິງ,</para>
  <para style="q2" vid="PRO 11:19">ແຕ່​ຜູ້​ໃດ​ທີ່​ຕິດຕາມ​ຄວາມ​ຊົ່ວ​ກໍ​ຈະ​ພົບ​ຄວາມ​ຕາຍ.<verse eid="PRO 11:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />ພຣະເຈົ້າ​ຢາເວ​ກຽດຊັງ​ຄົນ​ທີ່​ມີ​ໃຈ​ຫລອກລວງ,</para>
  <para style="q2" vid="PRO 11:20">ແຕ່​ພຣະອົງ​ພໍໃຈ​ໃນ​ທາງ​ຂອງ​ຄົນ​ທີ່​ບໍ່​ມີ​ຕຳໜິ.<verse eid="PRO 11:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />ຈົ່ງ​ໝັ້ນໃຈ​ວ່າ: ຄົນ​ຊົ່ວ​ຮ້າຍ​ຈະ​ໜີ​ບໍ່​ພົ້ນ​ການ​ລົງໂທດ,</para>
  <para style="q2" vid="PRO 11:21">ແຕ່​ຄົນຊອບທຳ​ຈະ​ໄດ້​ຮັບ​ການ​ປົດປ່ອຍ.<verse eid="PRO 11:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />ຜູ້ຍິງ​ງາມ​ທີ່​ບໍ່​ມີ​ຄວາມ​ຮອບຄອບ</para>
  <para style="q2" vid="PRO 11:22">ກໍ​ເໝືອນ​ແຫວນ​ຄຳ​ເກາະ​ດັງ​ໝູ.<verse eid="PRO 11:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />ຄວາມ​ປາຖະໜາ​ຂອງ​ຄົນ​ຊອບທຳ​ຈົບລົງ​ດ້ວຍ​ດີ,</para>
  <para style="q2" vid="PRO 11:23">ແຕ່​ຄວາມ​ຫວັງ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ຈົບ​ລົງ​ດ້ວຍ​ຄວາມ​ໂກດຮ້າຍ.<verse eid="PRO 11:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />ຄົນ​ໜຶ່ງ​ໃຫ້​ດ້ວຍ​ໃຈ​ກວ້າງຂວາງ, ຍິ່ງ​ມີ​ເພີ່ມ​ຂຶ້ນ;</para>
  <para style="q2" vid="PRO 11:24">ແຕ່​ບາງ​ຄົນ​ຍິ່ງ​ຂີ້ຖີ່​ຍິ່ງ​ທຸກຈົນ​ລົງ.<verse eid="PRO 11:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />ຄົນ​ທີ່​ມີ​ໃຈ​ເອື້ອເຟື້ອ​ເພື່ອ​ແຜ່​ຈະ​ຈະເລີນ​ຮຸ່ງເຮືອງ;</para>
  <para style="q2" vid="PRO 11:25">ຜູ້​ໃດ​ກໍ່ຕາມ​ທີ່​ນຳ​ຄວາມ​ຊື່ນໃຈ​ໄປ​ສູ່​ຄົນ​ອື່ນ ກໍ​ຈະ​ໄດ້​ຮັບ​ພຣະພອນ.<verse eid="PRO 11:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />ປະຊາຊົນ​ສາບແຊ່ງ​ຜູ້​ທີ່​ກັກ​ເຂົ້າ​ໄວ້​ຂາຍ​ກິນ​ກຳໄລ,</para>
  <para style="q2" vid="PRO 11:26">ແຕ່​ພວກເຂົາ​ອະທິຖານ​ອວຍພອນ​ຜູ້​ທີ່​ເຕັມໃຈ​ຂາຍ​ໃຫ້.<verse eid="PRO 11:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />ຜູ້​ທີ່​ສະແຫວງ​ຫາ​ເຮັດ​ຄວາມດີ ກໍ​ຈະ​ໄດ້​ຮັບ​ຄວາມ​ກະລຸນາ,</para>
  <para style="q2" vid="PRO 11:27">ແຕ່​ຄວາມ​ຊົ່ວ​ຈະ​ມາ​ຫາ​ຜູ້​ທີ່​ສະແຫວງ​ຫາ​ມັນ.<verse eid="PRO 11:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />ຄົນ​ທີ່​ວາງໃຈ​ໃນ​ຊັບສົມບັດ​ຂອງ​ຕົນ​ນັ້ນ ຈະ​ລົ້ມ​ລົງ,</para>
  <para style="q2" vid="PRO 11:28">ແຕ່​ຄົນ​ຊອບທຳ​ຈະ​ຈະເລີນ​ຂຶ້ນ​ດັ່ງ​ໃບໄມ້​ຂຽວ.<verse eid="PRO 11:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />ຜູ້​ໃດ​ກໍ​ຕາມ​ທີ່​ນໍາ​ຄວາມ​ຈິບຫາຍ​ມາ​ສູ່​ຄອບຄົວ​ຂອງ​ຕົນ​ຈະ​ບໍ່​ເຫລືອ​ຫຍັງ,</para>
  <para style="q2" vid="PRO 11:29">ແລະ ຄົນ​ໂງ່ຈ້າ​ຈະ​ເປັນ​ຄົນ​ຮັບໃຊ້​ຂອງ​ຄົນ​ສະຫລາດ.<verse eid="PRO 11:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />ຜົນ​ແຫ່ງ​ຄົນ​ຊອບທຳ​ເປັນ​ຕົ້ນໄມ້​ແຫ່ງ​ຊີວິດ,</para>
  <para style="q2" vid="PRO 11:30">ແລະ ຄົນ​ສະຫລາດ​ຈະ​ຊ່ວຍ​ໃຫ້​ຄົນ​ອື່ນ​ມີ​ຊີວິດ​ຢູ່.<verse eid="PRO 11:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />ຖ້າ​ຄົນ​ຊອບທຳ​ໄດ້​ຮັບ​ບຳເໜັດ​ຂອງ​ຕົນ​ໃນ​ແຜ່ນດິນ​ໂລກ,</para>
  <para style="q2" vid="PRO 11:31">ຄົນ​ບໍ່​ນັບຖື​ພຣະເຈົ້າ ແລະ ຄົນບາບ​ຍິ່ງ​ຈະ​ໄດ້​ຮັບ​ຜົນ​ຂອງ​ຕົນ​ຫລາຍ​ກວ່າ​ນັ້ນ​ອີກ​ເທົ່າ​ໃດ​ນໍ!<verse eid="PRO 11:31" /></para>
  <para style="b" />
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />ຜູ້​ໃດ​ກໍ​ຕາມ​ທີ່​ຮັກ​ການ​ເຟິກຝົນ​ວິໄນ​ກໍ​ຮັກ​ຄວາມ​ຮູ້,</para>
  <para style="q2" vid="PRO 12:1">ແຕ່​ຜູ້​ໃດ​ກໍ​ຕາມ​ທີ່​ກຽດຊັງ​ການ​ດັດແປງ​ແກ້ໄຂ​ກໍ​ໂງ່ຈ້າ.<verse eid="PRO 12:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />ຄົນ​ດີ​ໄດ້​ຮັບ​ຄວາມ​ພໍໃຈ​ຈາກ​ພຣະເຈົ້າ​ຢາເວ,</para>
  <para style="q2" vid="PRO 12:2">ແຕ່​ພຣະອົງ​ກ່າວໂທດ​ຄົນ​ທີ່​ວາງ​ແຜນ​ຊົ່ວ.<verse eid="PRO 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />ບໍ່​ມີ​ຜູ້ໃດ​ຢືນ​ຢູ່​ດ້ວຍ​ຄວາມ​ຊົ່ວ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 12:3">ແຕ່​ຮາກຖານ​ຂອງ​ຄົນ​ຊອບທຳ​ຈະ​ບໍ່​ຖືກ​ຖອນ​ຈັກ​ເທື່ອ.<verse eid="PRO 12:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />ເມຍ​ທີ່​ມີ​ກຽດ​ເປັນ​ມົງກຸດ​ຂອງ​ຜົວ,</para>
  <para style="q2" vid="PRO 12:4">ແຕ່​ເມຍ​ທີ່​ເຮັດ​ໃຫ້​ອັບອາຍ​ຂາຍ​ໜ້າ​ເປັນ​ດັ່ງ​ກະດູກ​ຜ່ອຍ.<verse eid="PRO 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />ແຜນການ​ຂອງ​ຄົນ​ຊອບທຳ​ນັ້ນ​ຍຸຕິທຳ,</para>
  <para style="q2" vid="PRO 12:5">ແຕ່​ຄໍາແນະນໍາ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ນັ້ນ​ເປັນ​ການ​ຫລອກລວງ.<verse eid="PRO 12:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />ຄໍາເວົ້າ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ດັກ​ລໍຖ້າ​ເອົາ​ຊີວິດ</para>
  <para style="q2" vid="PRO 12:6">ແຕ່​ຄໍາເວົ້າ​ຂອງ​ຄົນ​ທ່ຽງທຳ​ຊ່ວຍ​ຄົນ​ໃຫ້​ພົ້ນ​ໄດ້.<verse eid="PRO 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />ຄົນ​ຊົ່ວຮ້າຍ​ຈະ​ຫລົ້ມຈົມ ແລະ ດັບສູນ​ໄປ,</para>
  <para style="q2" vid="PRO 12:7">ແຕ່​ເຮືອນ​ຂອງ​ຄົນ​ຊອບທຳ​ຕັ້ງ​ໝັ້ນຄົງ​ຢູ່.<verse eid="PRO 12:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />ຄົນ​ໄດ້​ຮັບ​ການ​ຍົກຍ້ອງ​ຕາມ​ຄວາມ​ສະຫລຽວ​ສະຫລາດ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 12:8">ແຕ່​ຄົນ​ທີ່​ຄິດ​ຄົດໂກງ​ຈະ​ຖືກ​ໝິ່ນປະໝາດ.<verse eid="PRO 12:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />ເປັນ​ຄົນ​ທໍາມະດາ​ແຕ່​ມີ​ຄົນຮັບ​ໃຊ້</para>
  <para style="q2" vid="PRO 12:9">ກໍ​ດີກວ່າ​ເຮັດ​ທໍາທ່າ​ເປັນ​ຄົນ​ຍິ່ງໃຫຍ່​ແຕ່​ບໍ່​ມີ​ອາຫານ​ກິນ.<verse eid="PRO 12:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />ຄົນ​ຊອບທຳ​ເປັນ​ຫ່ວງ​ນໍາ​ການ​ເປັນ​ຢູ່​ຂອງ​ສັດລ້ຽງ​ຂອງ​ພວກເຂົາ,</para>
  <para style="q2" vid="PRO 12:10">ແຕ່​ຄວາມ​ກະລຸນາ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ກໍ​ຍັງ​ໂຫດຮ້າຍ​ຢູ່.<verse eid="PRO 12:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />ຄົນ​ທີ່​ເຮັດວຽກ​ໄຖ​ດິນ​ຂອງ​ຕົນ​ຈະ​ມີ​ອາຫານ​ຢ່າງ​ອຸດົມ​ສົມບູນ,</para>
  <para style="q2" vid="PRO 12:11">ແຕ່​ຄົນ​ທີ່​ມີ​ແຕ່​ໃຝ່ຝັນ​ກໍ​ເປັນ​ຄົນ​ບໍ່ຮູ້ຈັກຄິດ.<verse eid="PRO 12:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />ຄົນ​ຊົ່ວຮ້າຍ​ປາຖະໜາ​ຢາກ​ໄດ້​ປ້ອມ​ປ້ອງກັນ​ຂອງ​ຄົນ​ເຮັດ​ຊົ່ວ,</para>
  <para style="q2" vid="PRO 12:12">ແຕ່​ຮາກຖານ​ຂອງ​ຄົນ​ຊອບທຳ​ຈະ​ໝັ້ນຄົງ​ຢູ່.<verse eid="PRO 12:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />ຄົນ​ເຮັດ​ຊົ່ວ​ຈະ​ຖືກ​ບ້ວງແຮ້ວ​ຍ້ອນ​ຄຳເວົ້າ​ຊົ່ວ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 12:13">ແຕ່​ຄົນ​ຊອບທຳ​ກໍ​ພົ້ນ​ຈາກ​ຄວາມ​ເດືອດ​ຮ້ອນ.<verse eid="PRO 12:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />ຜົນ​ຈາກ​ປາກ​ຂອງ​ພວກເຂົາ ເຮັດ​ໃຫ້​ມະນຸດ​ເຕັມ​ໄປ​ດ້ວຍ​ສິ່ງ​ທີ່​ດີ,</para>
  <para style="q2" vid="PRO 12:14">ແລະ ການ​ງານ​ຈາກ​ມື​ຂອງ​ພວກເຂົາ​ຈະ​ນໍາ​ລາງວັນ​ມາ​ໃຫ້​ພວກເຂົາ.<verse eid="PRO 12:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />ທາງ​ຂອງ​ຄົນ​ໂງ່ຈ້າ​ກໍ​ເບິ່ງ​ຄື​ວ່າ​ຖືກຕ້ອງ,</para>
  <para style="q2" vid="PRO 12:15">ແຕ່​ຄົນ​ມີ​ປັນຍາ​ຍ່ອມ​ຟັງ​ຄຳ​ແນະນຳ.<verse eid="PRO 12:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />ຄົນ​ໂງ່ຈ້າ​ສະແດງ​ຄວາມ​ຮ້າຍ​ອອກ​ມາ​ໃຫ້​ເຫັນ​ທັນທີ,</para>
  <para style="q2" vid="PRO 12:16">ແຕ່​ຄົນ​ສະຫລາດ​ບໍ່​ສົນໃຈ​ຕໍ່​ຄຳ​ໝິ່ນປະໝາດ.<verse eid="PRO 12:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />ພະຍານ​ທີ່​ສັດຊື່​ກໍ​ເວົ້າ​ຄວາມຈິງ,</para>
  <para style="q2" vid="PRO 12:17">ແຕ່​ພະຍານ​ບໍ່​ຈິງ​ກໍ​ເວົ້າ​ແຕ່​ຄວາມ​ຕົວະ.<verse eid="PRO 12:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />ຄຳ​ເວົ້າ​ທີ່​ບໍ່​ຄິດ​ກໍ​ສຽບ​ແທງ​ດັ່ງ​ດາບ,</para>
  <para style="q2" vid="PRO 12:18">ແຕ່​ລີ້ນ​ຂອງ​ຄົນ​ມີ​ປັນຍາ​ກໍ​ປິ່ນປົວ​ໃຫ້​ຫາຍ​ດີ.<verse eid="PRO 12:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />ຮິມສົບ​ທີ່​ເວົ້າ​ຄວາມ​ຈິງ​ຍືນຍົງ​ຕະຫລອດໄປ,</para>
  <para style="q2" vid="PRO 12:19">ແຕ່​ລີ້ນ​ທີ່​ຕົວະ​ຢູ່​ໄດ້​ພຽງ​ຊົ່ວຄາວ.<verse eid="PRO 12:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />ການ​ຫລອກລວງ​ຢູ່​ໃນ​ໃຈ​ຂອງ​ຜູ້​ທີ່​ວາງ​ແຜນການ​ຊົ່ວຮ້າຍ,</para>
  <para style="q2" vid="PRO 12:20">ແຕ່​ຜູ້​ທີ່​ສົ່ງເສີມ​ຄວາມ​ສະຫງົບສຸກ​ມີ​ແຕ່​ຄວາມ​ຊື່ນຊົມຍິນດີ.<verse eid="PRO 12:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />ບໍ່​ມີ​ເຫດຮ້າຍ​ອັນໃດ​ຕົກ​ໃສ່​ຄົນ​ຊອບທຳ</para>
  <para style="q2" vid="PRO 12:21">ແຕ່​ຄົນ​ຊົ່ວຮ້າຍ​ກໍ​ຈະ​ເຕັມໄປ​ດ້ວຍ​ຄວາມ​ເດືອດຮ້ອນ.<verse eid="PRO 12:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />ພຣະເຈົ້າ​ຢາເວ​ກຽດຊັງ​ປາກ​ທີ່​ເວົ້າ​ຕົວະ,</para>
  <para style="q2" vid="PRO 12:22">ແຕ່​ພຣະອົງ​ພໍໃຈ​ນໍາ​ຄົນ​ທີ່​ສັດຊື່.<verse eid="PRO 12:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />ຄົນ​ສະຫລາດ​ເກັບ​ຄວາມ​ຮູ້​ໄວ້​ສໍາລັບ​ພວກເຂົາ​ເອງ,</para>
  <para style="q2" vid="PRO 12:23">ແຕ່​ໃຈ​ຂອງ​ຄົນ​ໂງ່ຈ້າ​ສະແດງ​ຄວາມ​ໂງ່​ຈ້າ​ຂອງ​ພວກເຂົາ​ອອກ​ມາ.<verse eid="PRO 12:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />ມື​ທີ່​ດຸໝັ່ນ​ກໍ​ຈະ​ໄດ້​ປົກຄອງ,</para>
  <para style="q2" vid="PRO 12:24">ແຕ່​ຄວາມ​ຂີ້ຄ້ານ​ຈົບ​ລົງ​ດ້ວຍ​ການ​ຖືກ​ບັງຄັບ​ໃຊ້​ແຮງງານ.<verse eid="PRO 12:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />ຄວາມ​ກະວົນ​ກະວາຍ​ເຮັດ​ໃຫ້​ໜັກ​ໃຈ,</para>
  <para style="q2" vid="PRO 12:25">ແຕ່​ຄຳ​ໜູນໃຈ​ເຮັດ​ໃຫ້​ມີ​ກໍາລັງ​ຂຶ້ນ.<verse eid="PRO 12:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />ຄົນ​ຊອບທຳ​ເລືອກ​ໝູ່​ຢ່າງ​ລະມັດລະວັງ,<note caller="+" style="f"><char style="fr" closed="false">12:26 </char><char style="ft" closed="false">ຫລື ຄົນ </char><char style="fqa" closed="false">ຊອບ </char><char style="ft" closed="false">ທຳ​ເປັນ​ຜູ້​ຊີ້​ທິດ​ທາງ​ໃຫ້​ແກ່​ເພື່ອນ </char><char style="fqa" closed="false">ບ້ານ</char></note></para>
  <para style="q2" vid="PRO 12:26">ແຕ່​ທາງ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ນໍາພາ​ພວກເຂົາ​ໃຫ້​ຫລົງ​ເສຍ​ໄປ.<verse eid="PRO 12:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />ຄົນ​ຂີ້ຄ້ານ​ບໍ່​ຍອມ​ປິ້ງ​ຊີ້ນ​ທີ່​ຄົນ​ອື່ນ​ຫາ​ມາ​ໃຫ້,</para>
  <para style="q2" vid="PRO 12:27">ແຕ່​ຄົນ​ດຸໝັ່ນ​ຊອກຫາ​ອາຫານ​ມາ​ໄດ້​ຢ່າງ​ຫລວງຫລາຍ.<note caller="+" style="f"><char style="fr" closed="false">12:27 </char><char style="ft" closed="false">ໃນ​ພາສາ​ເຮັບເຣີ​ຂໍ້​ນີ້​ມີ​ຄວາມໝາຍ​ບໍ່​ຊັດເຈນ</char></note><verse eid="PRO 12:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />ທາງ​ແຫ່ງ​ຄວາມ​ຊອບທຳ​ມີ​ຊີວິດ;</para>
  <para style="q2" vid="PRO 12:28">ທາງ​ນັ້ນ​ນຳ​ໄປ​ສູ່​ຊີວິດ​ນິລັນດອນ.<verse eid="PRO 12:28" /></para>
  <para style="b" />
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />ລູກ​ທີ່​ມີ​ປັນຍາ​ເອົາໃຈໃສ່​ຟັງ​ຄຳສັ່ງສອນ​ຂອງ​ພໍ່,</para>
  <para style="q2" vid="PRO 13:1">ແຕ່​ຄົນ​ມັກ​ເຢາະເຢີ້ຍ​ບໍ່​ຍອມ​ຟັງ​ຄຳ​ຕຳໜິ.<verse eid="PRO 13:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />ຄົນ​ເຮົາ​ມີ​ຄວາມ​ຍິນດີ​ກັບ​ສິ່ງ​ທີ່​ດີ​ຈາກ​ຜົນ​ແຫ່ງ​ປາກ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 13:2">ແຕ່​ຄົນ​ບໍ່​ສັດຊື່​ກໍ​ປາຖະໜາ​ຫາ​ຄວາມ​ໂຫດຮ້າຍ.<verse eid="PRO 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />ຜູ້​ທີ່​ລະວັງ​ປາກ​ກໍ​ຮັກສາ​ຊີວິດ​ຂອງ​ຕົນ​ໄວ້,</para>
  <para style="q2" vid="PRO 13:3">ແຕ່​ຜູ້​ທີ່​ເວົ້າ​ບໍ່​ຄິດ​ຈະ​ມາ​ສູ່​ຄວາມ​ຈິບຫາຍ.<verse eid="PRO 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />ຄວາມ​ກະຫາຍ​ຂອງ​ຄົນ​ຂີ້ຄ້ານ​ຈະ​ບໍ່​ໄດ້​ຮັບ​ການ​ເຕີມເຕັມ,</para>
  <para style="q2" vid="PRO 13:4">ແຕ່​ຄວາມ​ປາຖະໜາ​ຂອງ​ຄົນ​ດຸໝັ່ນ​ຈະ​ຖືກ​ເຕີມເຕັມ​ຢ່າງ​ພໍໃຈ.<verse eid="PRO 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />ຄົນ​ຊອບທຳ​ກຽດຊັງ​ສິ່ງ​ທີ່​ບໍ່​ຖືກຕ້ອງ,</para>
  <para style="q2" vid="PRO 13:5">ແຕ່​ຄົນ​ຊົ່ວ​ເຮັດ​ໃຫ້​ຕົນ​ມີ​ກິ່ນເໝັນ</para>
  <para style="q2" vid="PRO 13:5">ແລະ ນໍາ​ຄວາມ​ອັບອາຍ​ຂາຍ​ໜ້າ​ມາ​ສູ່​ຕົນ.<verse eid="PRO 13:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />ຄວາມ​ຊອບທຳ​ຮັກສາ​ຄົນ​ສັດຊື່</para>
  <para style="q2" vid="PRO 13:6">ແຕ່​ຄວາມ​ຊົ່ວຮ້າຍ​ຂວໍ້າ​ຄົນ​ບາບ.<verse eid="PRO 13:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />ຄົນ​ທີ່​ທຳທ່າ​ເປັນ​ຄົນ​ຮັ່ງມີ, ແຕ່​ບໍ່ມີ​ອັນໃດ​ເລີຍ;</para>
  <para style="q2" vid="PRO 13:7">ແຕ່​ຄົນ​ທີ່​ເຮັດ​ເໝືອນ​ຄົນ​ທຸກຍາກ, ແຕ່​ມີ​ຊັບສົມບັດ​ຢ່າງ​ຫລວງຫລາຍ.<verse eid="PRO 13:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />ຄົນ​ຮັ່ງມີ​ອາດ​ໃຊ້​ເງິນ​ໄຖ່​ຊີວິດ​ຂອງ​ຕົນ​ໄດ້,</para>
  <para style="q2" vid="PRO 13:8">ແຕ່​ຄົນ​ທຸກຍາກ​ບໍ່​ເຄີຍ​ຖືກ​ຂົ່ມຂູ່.<verse eid="PRO 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />ຄວາມ​ສະຫວ່າງ​ຂອງ​ຄົນ​ຊອບທຳ​ສ່ອງແສງ​ແຈ້ງ,</para>
  <para style="q2" vid="PRO 13:9">ແຕ່​ຕະກຽງ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ຈະ​ດັບ​ໄປ.<verse eid="PRO 13:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />ມີ​ຄວາມ​ອວດຕົວ​ຢູ່​ບ່ອນ​ໃດ​ກໍ​ມີ​ການ​ຜິດ​ຖຽງ​ກັນ,</para>
  <para style="q2" vid="PRO 13:10">ແຕ່​ປັນຍາ​ພົບ​ໄດ້​ໃນ​ຜູ້​ທີ່​ຮັບ​ຟັງ​ຄຳແນະນຳ.<verse eid="PRO 13:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />ເງິນ​ທີ່​ໄດ້​ມາ​ຢ່າງ​ບໍ່​ສັດຊື່​ກໍ​ເສຍ​ໄປ​ໄວ,</para>
  <para style="q2" vid="PRO 13:11">ແຕ່​ຜູ້​ໃດ​ກໍ​ຕາມ​ທີ່​ສະສົມ​ເງິນ​ໄວ້​ເທື່ອ​ລະ​ໜ້ອຍ​ເຮັດ​ໃຫ້​ເງິນ​ນັ້ນ​ເພີ່ມພູນ​ຂຶ້ນ.<verse eid="PRO 13:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />ຄວາມ​ຫວັງ​ທີ່​ຖືກ​ປະ​ໄວ້​ເຮັດ​ໃຫ້​ທໍລະມານ​ໃຈ,</para>
  <para style="q2" vid="PRO 13:12">ແຕ່​ຄວາມ​ປາຖະໜາ​ທີ່​ບັນລຸ​ຜົນ​ສໍາເລັດ​ເປັນ​ດັ່ງ​ຕົ້ນໄມ້​ແຫ່ງ​ຊີວິດ.<verse eid="PRO 13:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />ຜູ້​ໃດ​ກໍ​ຕາມ​ທີ່​ດູຖູກ​ຄຳສັ່ງສອນ​ຈະ​ໄດ້​ຮັບ​ຄວາມ​ຈິບຫາຍ,</para>
  <para style="q2" vid="PRO 13:13">ແຕ່​ຜູ້​ໃດ​ທີ່​ເຄົາລົບນັບຖື​ຄຳສັ່ງສອນ​ກໍ​ໄດ້​ຮັບ​ບຳເໜັດ.<verse eid="PRO 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />ຄຳສອນ​ຂອງ​ຄົນ​ມີ​ປັນຍາ​ເປັນ​ນ້ຳ​ພຸ​ແຫ່ງ​ຊີວິດ,</para>
  <para style="q2" vid="PRO 13:14">ມັນ​ຊ່ວຍ​ໃຫ້​ຄົນ​ພົ້ນ​ຈາກ​ບ້ວງແຮ້ວ​ແຫ່ງ​ຄວາມ​ຕາຍ.<verse eid="PRO 13:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />ຄົນ​ທີ່​ມີ​ປັນຍາ​ນຳ​ໄປ​ສູ່​ຄວາມ​ພໍໃຈ,</para>
  <para style="q2" vid="PRO 13:15">ແຕ່​ທາງ​ຂອງ​ຄົນ​ບໍ່​ສັດຊື່​ນຳ​ໄປ​ສູ່​ຄວາມ​ຈິບຫາຍ.<note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="ft" closed="false">ຫລື ຄົນ​ອະທໍາ​ບໍ່​ຍືນ​ຍົງ</char></note><verse eid="PRO 13:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />ທຸກຄົນ​ທີ່​ສະຫລາດ​ກໍ​ປະຕິບັດ​ດ້ວຍ​ຄວາມຮູ້<note caller="+" style="f"><char style="fr" closed="false">13:16 </char><char style="ft" closed="false">ຫລື ຄົນ​ສະຫລາດ​ຫລັກ​ແຫລມ​ທຸກຄົນ​ເຮັດ​ສິ່ງ​ຕ່າງໆ​ດ້ວຍ​ຄວາມ​ຮູ້</char></note></para>
  <para style="q2" vid="PRO 13:16">ແຕ່​ຄົນ​ໂງ່ຈ້າ​ເປີດເຜີຍ​ຄວາມ​ໂງ່​ຂອງ​ຕົນ​ອອກ​ມາ.<verse eid="PRO 13:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />ຜູ້ສົ່ງຂ່າວ​ທີ່​ຊົ່ວຮ້າຍ​ຈະ​ຕົກ​ຢູ່​ໃນ​ຄວາມ​ເດືອດຮ້ອນ,</para>
  <para style="q2" vid="PRO 13:17">ແຕ່​ທູດ​ທີ່​ສັດຊື່​ໄດ້​ນຳ​ການ​ຮັກສາ​ມາ.<verse eid="PRO 13:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />ຜູ້​ທີ່​ເມີນເສີຍ​ຕໍ່​ຄໍາສັ່ງສອນ​ກໍ​ຈະ​ໄດ້​ຮັບ​ຄວາມ​ທຸກຍາກ ແລະ ຄວາມ​ອັບອາຍ,</para>
  <para style="q2" vid="PRO 13:18">ແຕ່​ຜູ້​ທີ່​ຍອມຮັບ​ການ​ປັບປຸງ​ແກ້ໄຂ​ຈະ​ໄດ້​ຮັບ​ກຽດ.<verse eid="PRO 13:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />ຄວາມ​ປາຖະໜາ​ທີ່​ບັນລຸ​ຜົນ​ສໍາເລັດ​ເປັນ​ຄວາມ​ຊື່ນບານ​ແກ່​ວິນຍານ,</para>
  <para style="q2" vid="PRO 13:19">ແຕ່​ຄົນ​ໂງ່​ຈ້າ​ກຽດຊັງ​ການ​ຫັນໜີ​ຈາກ​ຄວາມ​ຊົ່ວ.<verse eid="PRO 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />ຄົບ​ກັບ​ຄົນ​ສະຫລາດ​ກໍ​ຈະ​ເປັນ​ຄົນສະຫລາດ,</para>
  <para style="q2" vid="PRO 13:20">ເພາະ​ໝູ່​ຂອງ​ຄົນ​ໂງ່​ຈ້າ​ກໍ​ໄດ້​ຮັບ​ອັນຕະລາຍ.<verse eid="PRO 13:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />ຄວາມ​ເດືອດຮ້ອນ​ໄລ່​ຕາມ​ຄົນ​ບາບ,</para>
  <para style="q2" vid="PRO 13:21">ແຕ່​ຄົນ​ຊອບທຳ​ໄດ້​ຮັບ​ສິ່ງ​ທີ່​ດີ​ເປັນ​ບໍາເໜັດ.<verse eid="PRO 13:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />ຄົນ​ດີ​ປະ​ມໍລະດົກ​ໄວ້​ໃຫ້​ລູກ​ຫລານ,</para>
  <para style="q2" vid="PRO 13:22">ແຕ່​ຊັບສົມບັດ​ຂອງ​ຄົນ​ບາບ​ກໍ​ສະສົມ​ໄວ້​ໃຫ້​ຄົນ​ຊອບທຳ.<verse eid="PRO 13:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />ທົ່ງນາ​ທີ່​ບໍ່​ໄດ້​ໄຖ​ກໍ​ຍັງ​ເກີດ​ພືດ​ຜັກ​ໃຫ້​ຄົນ​ທຸກຍາກ,</para>
  <para style="q2" vid="PRO 13:23">ແຕ່​ຄວາມ​ບໍ່​ຍຸຕິທຳ​ກວາດ​ເອົາ​ທຸກສິ່ງ​ໄປ​ໝົດ.<verse eid="PRO 13:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />ຜູ້​ທີ່​ບໍ່​ໃຊ້​ໄມ້ແສ້​ກໍ​ກຽດຊັງ​ລູກ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 13:24">ແຕ່​ຜູ້​ທີ່​ຮັກ​ລູກ​ກໍ​ເອົາໃຈໃສ່​ສັ່ງສອນ​ພວກເຂົາ.<verse eid="PRO 13:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />ຄົນ​ຊອບທຳ​ໄດ້​ກິນ​ຈົນ​ເຫລືອ,</para>
  <para style="q2" vid="PRO 13:25">ແຕ່​ທ້ອງ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ກໍ​ອຶດຫິວ​ຢູ່​ເລື້ອຍ.<verse eid="PRO 13:25" /></para>
  <para style="b" />
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />ຍິງ​ທີ່​ມີ​ປັນຍາ​ສ້າງ​ເຮືອນ​ຂອງຕົນ​ຂຶ້ນ,</para>
  <para style="q2" vid="PRO 14:1">ແຕ່​ຍິງ​ທີ່​ໂງ່ຈ້າ​ມ້າງ​ເຮືອນ​ລົງ​ດ້ວຍ​ມື​ຂອງ​ຕົນ.<verse eid="PRO 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />ຜູ້​ໃດ​ກໍ​ຕາມ​ທີ່​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ​ກໍ​ເດີນ​ໃນ​ທາງ​ຊື່​ກົງ,</para>
  <para style="q2" vid="PRO 14:2">ແຕ່​ຄົນ​ທີ່​ດູໝິ່ນ​ປະໝາດ​ພຣະອົງ​ກໍ​ເດີນ​ໃນ​ທາງ​ອັນ​ຄົດລ້ຽວ​ຂອງ​ຕົນ.<verse eid="PRO 14:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />ປາກ​ຂອງ​ຄົນ​ໂງ່​ກໍ​ເວົ້າ​ອອກ​ມາ​ດ້ວຍ​ຄວາມຈອງຫອງ,</para>
  <para style="q2" vid="PRO 14:3">ແຕ່​ຄຳເວົ້າ​ຂອງ​ຄົນ​ມີ​ປັນຍາ​ປົກປ້ອງ​ຕົນ​ໄວ້.<verse eid="PRO 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />ບ່ອນ​ໃດ​ບໍ່​ມີ​ງົວ, ເລົ້າເຂົ້າ​ກໍ​ຫວ່າງເປົ່າ,</para>
  <para style="q2" vid="PRO 14:4">ແຕ່​ດ້ວຍ​ກໍາລັງ​ຂອງ​ງົວ​ກໍ​ໄດ້​ເກັບກ່ຽວ​ຢ່າງ​ອຸດົມ​ສົມບູນ.<verse eid="PRO 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />ພະຍານ​ທີ່​ສັດຊື່​ຈະ​ບໍ່​ຫລອກລວງ,</para>
  <para style="q2" vid="PRO 14:5">ແຕ່​ພະຍານ​ທີ່​ບໍ່​ຈິງ​ເວົ້າ​ຕົວະ​ຢູ່​ເລື້ອຍ.<verse eid="PRO 14:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />ຄົນ​ມັກ​ເຢາະເຢີ້ຍ​ສະແຫວງຫາ​ປັນຍາ​ແຕ່​ບໍ່​ພົບ​ຈັກ​ເທື່ອ,</para>
  <para style="q2" vid="PRO 14:6">ແຕ່​ຜູ້​ທີ່​ມີ​ຄວາມ​ເຂົ້າໃຈ​ກໍ​ພົບ​ເຫັນ​ໄດ້​ຢ່າງ​ງ່າຍ​ດາຍ.<verse eid="PRO 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />ຈົ່ງ​ຢູ່​ຫ່າງ​ຈາກ​ຄົນ​ໂງ່​ຈ້າ,</para>
  <para style="q2" vid="PRO 14:7">ເພາະ​ເຈົ້າ​ຈະ​ບໍ່​ພົບ​ຄວາມ​ຮູ້​ຈາກ​ປາກ​ຂອງ​ພວກເຂົາ.<verse eid="PRO 14:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />ປັນຍາ​ຂອງ​ຄົນ​ສະຫລາດ​ແມ່ນ​ເຂົ້າໃຈ​ທາງ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 14:8">ແຕ່​ຄວາມ​ໂງ່​ຂອງ​ຄົນ​ໂງ່ຈ້າ​ແມ່ນ​ການ​ຫລອກລວງ​ຕົນເອງ.<verse eid="PRO 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />ຄົນ​ໂງ່ຈ້າ​ກໍ​ເຢາະເຢີ້ຍ​ການ​ໃຊ້​ໜີ​ຄວາມ​ຜິດ​ບາບ</para>
  <para style="q2" vid="PRO 14:9">ແຕ່​ໃນ​ທ່າມກາງ​ຄົນ​ທ່ຽງທຳ​ກໍ​ມີ​ແຕ່​ຄວາມ​ຫວັງ​ດີ.<verse eid="PRO 14:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />ມີ​ແຕ່​ໃຈ​ຕົນເອງ​ທີ່​ຮູ້​ເຖິງ​ຄວາມ​ຂົມຂື່ນ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 14:10">ແລະ ບໍ່​ມີ​ຜູ້​ໃດ​ສາມາດ​ແບ່ງປັນ​ຄວາມ​ຍິນດີ​ໃຫ້​ຄົນອື່ນ​ໄດ້.<verse eid="PRO 14:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />ບ້ານ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ຈະ​ຖືກ​ທຳລາຍ,</para>
  <para style="q2" vid="PRO 14:11">ແຕ່​ເຕັນ​ຂອງ​ຄົນ​ທ່ຽງທຳ​ຈະ​ຈະເລີນ​ຂຶ້ນ.<verse eid="PRO 14:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />ມີ​ທາງ​ໜຶ່ງ​ທີ່​ເບິ່ງ​ຄື​ວ່າ​ຖືກຕ້ອງ,</para>
  <para style="q2" vid="PRO 14:12">ແຕ່​ສຸດທ້າຍ​ມັນ​ຈະ​ນໍາ​ໄປ​ສູ່​ຄວາມ​ຕາຍ.<verse eid="PRO 14:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />ແມ່ນ​ແຕ່​ຍາມ​ຫົວເລາະ ຈິດໃຈ​ອາດ​ເຈັບປວດ,</para>
  <para style="q2" vid="PRO 14:13">ແລະ ຄວາມ​ຊື່ນຊົມຍິນດີ​ອາດ​ຈົບ​ລົງ​ດ້ວຍ​ຄວາມ​ໂສກ​ເສົ້າ.<verse eid="PRO 14:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />ຄົນ​ປະຖິ້ມ​ຄວາມ​ເຊື່ອ​ຈະ​ໄດ້​ຮັບ​ຜົນ​ກໍາ​ຕອບສະໜອງ​ຢ່າງ​ເຕັມທີ່​ສໍາລັບ​ວິຖີທາງ​ຂອງ​ພວກເຂົາ,</para>
  <para style="q2" vid="PRO 14:14">ແຕ່​ຄົນ​ດີ​ກໍ​ໄດ້​ຮັບ​ບຳເໜັດ​ຂອງ​ຕົນ.<verse eid="PRO 14:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />ຄົນ​ບໍ່ຮູ້ຈັກຄິດ​ເຊື່ອ​ໄປ​ໝົດ​ທຸກສິ່ງ​ທຸກຢ່າງ,</para>
  <para style="q2" vid="PRO 14:15">ແຕ່​ຄົນ​ສະຫລາດ​ກໍ​ຄິດ​ກ່ອນ​ຈຶ່ງ​ກ້າວ​ອອກ​ໄປ.<verse eid="PRO 14:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />ຄົນ​ມີ​ປັນຍາ​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ ແລະ ຫລີກລ້ຽງ​ຈາກ​ຄວາມ​ຊົ່ວ,</para>
  <para style="q2" vid="PRO 14:16">ແຕ່​ຄົນ​ໂງ່​ຈ້າ​ໃຈ​ຮ້ອນ​ລົງ​ມື​ເຮັດ​ໄປ​ຢ່າງ​ວ່ອງໄວ ຄິດ​ໄປ​ເອງ​ວ່າ​ຕົນ​ປອດໄພ.<verse eid="PRO 14:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />ຄົນ​ທີ່​ໃຈຮ້າຍ​ງ່າຍ​ເຮັດ​ສິ່ງ​ທີ່​ໂງ່ຈ້າ,</para>
  <para style="q2" vid="PRO 14:17">ແລະ ຄົນ​ທີ່​ຄິດ​ແຜນການ​ຊົ່ວ​ກໍ​ໜ້າ​ກຽດຊັງ.<verse eid="PRO 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />ຄົນ​ບໍ່ຮູ້ຈັກຄິດ​ໄດ້​ຄວາມ​ໂງ່​ເປັນ​ມໍລະດົກ,</para>
  <para style="q2" vid="PRO 14:18">ແຕ່​ຄົນ​ສະຫລາດ​ໄດ້​ຄວາມ​ຮູ້​ເປັນ​ມົງກຸດ.<verse eid="PRO 14:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />ຄົນ​ທີ່​ເຮັດ​ຊົ່ວ​ຈະ​ກົ້ມ​ຂາບ​ລົງ​ຕໍ່ໜ້າ​ຄົນ​ດີ,</para>
  <para style="q2" vid="PRO 14:19">ແລະ ຄົນ​ຊົ່ວຮ້າຍ​ຈະ​ກົ້ມ​ຂາບ​ລົງ​ທີ່​ປະຕູ​ຂອງ​ຄົນ​ຊອບທຳ.<verse eid="PRO 14:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />ຄົນ​ທຸກຍາກ​ນັ້ນ​ແມ່ນແຕ່​ເພື່ອນບ້ານ​ກໍ​ເມີນ​ໜ້າ​ໜີ,</para>
  <para style="q2" vid="PRO 14:20">ແຕ່​ຄົນ​ຮັ່ງມີ​ມີ​ໝູ່​ເພື່ອນ​ຢ່າງ​ຫລວງຫລາຍ.<verse eid="PRO 14:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />ຜູ້​ທີ່​ດູຖູກ​ເພື່ອນບ້ານ​ກໍ​ເປັນ​ຄວາມ​ບາບ,</para>
  <para style="q2" vid="PRO 14:21">ຄວາມ​ສຸກ​ເປັນ​ຂອງ​ຜູ້​ທີ່​ມີ​ໃຈ​ເມດຕາ​ຕໍ່​ຄົນ​ທຸກຍາກ.<verse eid="PRO 14:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />ຜູ້​ທີ່​ວາງ​ແຜນການ​ຊົ່ວຮ້າຍ​ກໍ​ຫລົງ​ທາງ​ໄປ​ບໍ່ແມ່ນ​ບໍ?</para>
  <para style="q2" vid="PRO 14:22">ແຕ່​ຜູ້​ທີ່​ວາງ​ແຜນການ​ອັນ​ດີ​ກໍ​ພົບ<note caller="+" style="f"><char style="fr" closed="false">14:22 </char><char style="ft" closed="false">ຫລື ສະແດງ</char></note> ຄວາມ​ຮັກ ແລະ ຄວາມ​ສັດຊື່.<verse eid="PRO 14:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />ການ​ເຮັດວຽກ​ຢ່າງ​ໜັກ​ກໍ​ນໍາ​ຜົນ​ກຳໄລ​ມາ,</para>
  <para style="q2" vid="PRO 14:23">ຖ້າ​ເອົາ​ແຕ່​ເວົ້າ​ເທົ່ານັ້ນ​ກໍ​ນໍາ​ໄປ​ສູ່​ຄວາມ​ທຸກຍາກ.<verse eid="PRO 14:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />ຄວາມ​ຮັ່ງມີ​ຂອງ​ຄົນ​ມີ​ປັນຍາ​ເປັນ​ມົງກຸດ​ຂອງ​ຕົນ.</para>
  <para style="q2" vid="PRO 14:24">ແຕ່​ຄວາມ​ໂງ່ຈ້າ​ຂອງ​ຄົນ​ໂງ່​ເຮັດ​ໃຫ້​ເກີດ​ຄວາມ​ໂງ່ຈ້າ.<verse eid="PRO 14:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />ພະຍານ​ທີ່​ເວົ້າ​ຄວາມ​ຈິງ​ກໍ​ຊ່ວຍ​ຊີວິດ​ໄດ້,</para>
  <para style="q2" vid="PRO 14:25">ແຕ່​ພະຍານ​ບໍ່​ຈິງ​ເປັນ​ການ​ຫລອກລວງ.<verse eid="PRO 14:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />ຜູ້​ທີ່​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ​ມີ​ປ້ອມ​ປ້ອງກັນ​ທີ່​ປອດໄພ,</para>
  <para style="q2" vid="PRO 14:26">ແລະ ມັນ​ຈະ​ເປັນ​ບ່ອນ​ລີ້ໄພ​ໃຫ້​ແກ່​ລູກ​ຫລານ​ຂອງ​ພວກເຂົາ.<verse eid="PRO 14:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />ການ​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ​ເປັນ​ນ້ຳພຸ​ແຫ່ງ​ຊີວິດ,</para>
  <para style="q2" vid="PRO 14:27">ຊ່ວຍ​ຄົນ​ໃຫ້​ພົ້ນ​ຈາກ​ບ້ວງແຮ້ວ​ແຫ່ງ​ຄວາມ​ຕາຍ.<verse eid="PRO 14:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />ມີ​ປະຊາຊົນ​ຢ່າງ​ຫລວງຫລາຍ​ເປັນ​ສະຫງ່າລາສີ​ຂອງ​ກະສັດ,</para>
  <para style="q2" vid="PRO 14:28">ຖ້າ​ບໍ່​ມີ​ປະຊາຊົນ ເຈົ້ານາຍ​ກໍ​ຈິບຫາຍ​ໄປ.<verse eid="PRO 14:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />ຜູ້​ທີ່​ມີ​ຄວາມ​ອົດທົນ​ກໍ​ມີ​ຄວາມ​ເຂົ້າໃຈ​ທີ່​ຍິ່ງໃຫຍ່,</para>
  <para style="q2" vid="PRO 14:29">ແຕ່​ຜູ້​ທີ່​ໃຈ​ຮ້ອນ​ກໍ​ສະແດງ​ຄວາມ​ໂງ່ຈ້າ.<verse eid="PRO 14:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />ຈິດໃຈ​ທີ່​ສະຫງົບສຸກ​ໃຫ້​ຊີວິດ​ແກ່​ຮ່າງກາຍ,</para>
  <para style="q2" vid="PRO 14:30">ແຕ່​ຄວາມ​ອິດສາ​ເຮັດ​ໃຫ້​ກະດູກ​ເປື່ອຍ​ເນົ່າ.<verse eid="PRO 14:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />ຜູ້​ທີ່​ກົດຂີ່​ຂົ່ມເຫັງ​ຄົນ​ທຸກຍາກ​ກໍ​ດູຖູກ​ພຣະເຈົ້າ​ຜູ້ສ້າງ​ຂອງ​ພວກເຂົາ,</para>
  <para style="q2" vid="PRO 14:31">ແຕ່​ຜູ້​ທີ່​ເມດຕາ​ຄົນ​ຂັດສົນ​ກໍ​ໃຫ້​ກຽດ​ພຣະເຈົ້າ.<verse eid="PRO 14:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />ເມື່ອ​ໄພພິບັດ​ມາ​ເຖິງ, ຄົນ​ຊົ່ວ​ກໍ​ຖືກ​ໂຄ່ນ​ລົ້ມ,</para>
  <para style="q2" vid="PRO 14:32">ແມ່ນ​ແຕ່​ຢູ່​ໃນ​ຄວາມ​ຕາຍ ຄົນ​ຊອບທຳ​ສະແຫວງຫາ​ບ່ອນ​ລີ້ໄພ​ໃນ​ພຣະເຈົ້າ.<verse eid="PRO 14:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />ຄົນ​ມີ​ປັນຍາ​ກໍ​ໄວ້ວາງໃຈ​ໃນ​ຄົນ​ທີ່​ຮູ້​ຈັກ​ຄິດ</para>
  <para style="q2" vid="PRO 14:33">ແລະ ແມ່ນ​ແຕ່​ໃນ​ທ່າມກາງ​ຄົນ​ໂງ່​ຈ້າ<note caller="+" style="f"><char style="fr" closed="false">14:33 </char><char style="ft" closed="false">ສະບັບ LXX. ແລະ Syr. ວ່າ ແຕ່​ໃນ​ໃຈ​ຂອງ​ຄົນ​ໂງ່​ຂາດ​ສະຕິປັນຍາ</char></note> ຄົນ​ມີ​ປັນຍາ​ກໍ​ເຮັດ​ໃຫ້​ຕົນ​ເປັນ​ທີ່​ຮູ້​ຈັກ.<verse eid="PRO 14:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />ຄວາມ​ຊອບທຳ​ເຊີດຊູ​ຊາດ,</para>
  <para style="q2" vid="PRO 14:34">ແຕ່​ບາບ​ປະນາມ​ຊົນຊາດ​ຕ່າງໆ<verse eid="PRO 14:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />ກະສັດ​ພໍໃຈ​ໃນ​ຄົນຮັບໃຊ້​ທີ່​ມີ​ປັນຍາ,</para>
  <para style="q2" vid="PRO 14:35">ແຕ່​ເພິ່ນ​ໂກດຮ້າຍ​ຄົນຮັບໃຊ້​ທີ່​ບໍ່​ໄດ້​ວຽກ.<verse eid="PRO 14:35" /></para>
  <para style="b" />
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />ຄຳ​ຕອບ​ອ່ອນຫວານ​ຊ່ວຍ​ລະງັບ​ຄວາມ​ໂກດຮ້າຍ​ໄດ້,</para>
  <para style="q2" vid="PRO 15:1">ແຕ່​ຄຳເວົ້າ​ຫຍາບຊ້າ​ຍົວະ​ໃຫ້​ເກີດ​ຄວາມ​ໂມໂຫ.<verse eid="PRO 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />ລິ້ນ​ຂອງ​ຄົນ​ມີ​ປັນຍາ​ປະດັບ​ດ້ວຍ​ຄວາມ​ຮູ້,</para>
  <para style="q2" vid="PRO 15:2">ແຕ່​ປາກ​ຂອງ​ຄົນ​ໂງ່ຈ້າ​ເວົ້າ​ຄວາມ​ໂງ່​ອອກ​ມາ.<verse eid="PRO 15:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />ຕາ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ຢູ່​ທຸກ​ຫົນ​ທຸກ​ແຫ່ງ,</para>
  <para style="q2" vid="PRO 15:3">ພຣະອົງ​ເຝົ້າເບິ່ງ​ທັງ​ຄົນ​ຊົ່ວ ແລະ ຄົນ​ດີ.<verse eid="PRO 15:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />ລິ້ນ​ທີ່​ໜູນໃຈ​ເປັນ​ຕົ້ນໄມ້​ແຫ່ງ​ຊີວິດ,</para>
  <para style="q2" vid="PRO 15:4">ແຕ່​ລີ້ນ​ທີ່​ມັກ​ປີ້ນ​ຄວາມ​ເຮັດ​ໃຫ້​ຈິດໃຈ​ເຈັບປວດ.<verse eid="PRO 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />ຄົນ​ໂງ່​ໝິ່ນປະໝາດ​ຄຳສັ່ງສອນ​ຂອງ​ພໍ່​ແມ່,</para>
  <para style="q2" vid="PRO 15:5">ຜູ້​ທີ່​ຍອມຮັບ​ການ​ດັດແປງ​ແກ້ໄຂ​ສະແດງ​ໃຫ້​ເຫັນ​ເຖິງ​ຄວາມ​ສະຫລາດ.<verse eid="PRO 15:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />ບ້ານ​ຂອງ​ຄົນ​ຊອບທຳ​ມີ​ຊັບສົມບັດ​ຢ່າງ​ຫລວງຫລາຍ,</para>
  <para style="q2" vid="PRO 15:6">ແຕ່​ລາຍໄດ້​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ກໍ​ນໍາ​ຄວາມ​ຈິບຫາຍ​ມາ.<verse eid="PRO 15:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />ປາກ​ຂອງ​ຄົນ​ມີ​ປັນຍາ​ກະຈາຍ​ຄວາມ​ຮູ້,</para>
  <para style="q2" vid="PRO 15:7">ແຕ່​ຈິດໃຈ​ຂອງ​ຄົນ​ໂງ່​ຈ້າ​ແມ່ນ​ບໍ່​ຊື່ກົງ.<verse eid="PRO 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />ພຣະເຈົ້າ​ຢາເວ​ກຽດຊັງ​ເຄື່ອງບູຊາ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ,</para>
  <para style="q2" vid="PRO 15:8">ແຕ່​ພຣະອົງ​ພໍໃຈ​ນໍາ​ຄຳ​ພາວັນນາ​ອະທິຖານ​ຂອງ​ຄົນ​ທ່ຽງທຳ.<verse eid="PRO 15:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />ພຣະເຈົ້າ​ຢາເວ​ກຽດຊັງ​ທາງ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ,</para>
  <para style="q2" vid="PRO 15:9">ແຕ່​ພຣະອົງ​ຮັກ​ຜູ້​ທີ່​ຕິດຕາມ​ຄວາມ​ຊອບທຳ.<verse eid="PRO 15:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />ຜູ້​ທີ່​ປະຖິ້ມ​ທາງ​ແຫ່ງ​ຊີວິດ​ຈະ​ຖືກ​ລົງໂທດ​ຢ່າງ​ໜັກໜ່ວງ,</para>
  <para style="q2" vid="PRO 15:10">ຜູ້​ທີ່​ກຽດຊັງ​ການ​ປັບປຸງ​ແກ້ໄຂ​ຈະ​ພົບ​ຄວາມ​ຕາຍ.<verse eid="PRO 15:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />ແມ່ນ​ແຕ່​ຄວາມ​ຕາຍ ແລະ ການ​ທໍາລາຍ​ກໍ​ປາກົດ​ແຈ້ງ​ຕໍ່ໜ້າ​ພຣະເຈົ້າ​ຢາເວ.</para>
  <para style="q2" vid="PRO 15:11">ໃຈ​ມະນຸດ​ຄິດ​ຫຍັງ​ຫລາຍ​ເທົ່າ​ໃດ​ພຣະອົງ​ກໍ​ຮູ້.<verse eid="PRO 15:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />ຄົນ​ມັກ​ເຢາະເຢີ້ຍ​ບໍ່​ມັກ​ການ​ປັບປຸງ​ແກ້ໄຂ,</para>
  <para style="q2" vid="PRO 15:12">ດັ່ງນັ້ນ ພວກເຂົາ​ຈຶ່ງ​ບໍ່​ໄປ​ຢູ່​ໃກ້​ຄົນ​ມີ​ປັນຍາ.<verse eid="PRO 15:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />ໃຈ​ທີ່​ມີຄວາມ​ສຸກ​ເຮັດ​ໃຫ້​ໃບໜ້າ​ສົດໃສ,</para>
  <para style="q2" vid="PRO 15:13">ໃຈ​ທີ່​ມີ​ຄວາມ​ເຈັບປວດ​ເຮັດ​ໃຫ້​ຈິດ​ວິນຍານ​ເສົ້າໝອງ.<verse eid="PRO 15:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />ຄົນ​ທີ່​ຮູ້ຈັກ​ຄິດ​ສະແຫວງຫາ​ຄວາມ​ຮູ້,</para>
  <para style="q2" vid="PRO 15:14">ແຕ່​ປາກ​ຂອງ​ຄົນ​ໂງ່ຈ້າ​ກິນ​ຄວາມ​ໂງ່​ເປັນ​ອາຫານ.<verse eid="PRO 15:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />ທຸກ​ມື້​ຂອງ​ຜູ້​ທີ່​ຖືກ​ກົດຂີ່​ຂົ່ມເຫັງ​ກໍ​ເປັນ​ເຄາະຮ້າຍ,</para>
  <para style="q2" vid="PRO 15:15">ແຕ່​ຫົວໃຈ​ທີ່​ມ່ວນຊື່ນ​ກໍ​ມີ​ງານ​ກິນລ້ຽງ​ຕະຫລອດ.<verse eid="PRO 15:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />ມີ​ໜ້ອຍ​ແຕ່​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ ກໍ​ດີ​ກວ່າ</para>
  <para style="q2" vid="PRO 15:16">ຮັ່ງມີ​ຫລາຍ​ແຕ່​ມີ​ຄວາມ​ວຸ້ນວາຍ.<verse eid="PRO 15:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />ໄດ້​ກິນ​ຜັກ​ໜ້ອຍໜຶ່ງ​ໃນ​ບ່ອນ​ມີ​ຄວາມ​ຮັກ</para>
  <para style="q2" vid="PRO 15:17">ກໍ​ດີ​ກວ່າ​ກິນ​ຊີ້ນ​ງົວ​ໃນ​ບ່ອນ​ມີ​ຄວາມ​ກຽດຊັງ.<verse eid="PRO 15:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />ຄົນ​ໃຈ​ຮ້ອນ​ເຮັດ​ໃຫ້​ເກີດ​ການ​ຂັດແຍ້ງ​ກັນ,</para>
  <para style="q2" vid="PRO 15:18">ແຕ່​ຄົນ​ທີ່​ມີ​ຄວາມ​ອົດທົນ​ລະງັບ​ການ​ຜິດຖຽງກັນ.<verse eid="PRO 15:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />ທາງ​ຂອງ​ຄົນ​ຂີ້ຄ້ານ​ຖືກ​ຂວາງ​ດ້ວຍ​ໜາມ,</para>
  <para style="q2" vid="PRO 15:19">ແຕ່​ທາງ​ຂອງ​ຄົນ​ທ່ຽງທຳ​ກໍ​ສະດວກ​ດີ.<verse eid="PRO 15:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />ລູກ​ທີ່​ມີ​ປັນຍາ​ເຮັດ​ໃຫ້​ພໍ່​ຂອງ​ຕົນ​ມີ​ຄວາມ​ສຸກ,</para>
  <para style="q2" vid="PRO 15:20">ແຕ່​ຄົນ​ທີ່​ໂງ່​ຈ້າ​ໝິ່ນປະໝາດ​ແມ່​ຂອງ​ຕົນ.<verse eid="PRO 15:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />ຄົນ​ບໍ່ຮູ້ຈັກຄິດ​ຊື່ນຊົມ​ຄວາມ​ໂງ່​ຂອງ​ຕົນ</para>
  <para style="q2" vid="PRO 15:21">ແຕ່​ຄົນ​ທີ່​ມີ​ຄວາມ​ເຂົ້າໃຈ​ຮັກສາ​ທາງ​ຂອງ​ຕົນ​ໃຫ້​ຊື່​ໄປ.<verse eid="PRO 15:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />ຂາດ​ການ​ປຶກສາ​ແຜນການ​ຕ່າງໆ​ກໍ​ລົ້ມເຫລວ,</para>
  <para style="q2" vid="PRO 15:22">ແຕ່​ມີ​ທີ່ປຶກສາ​ຫລາຍ​ຄົນ​ກໍ​ພົບ​ຄວາມ​ສຳເລັດ.<verse eid="PRO 15:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />ຄົນ​ທີ່​ໃຫ້​ຄຳຕອບ​ທີ່​ເໝາະສົມ​ກໍ​ມີ​ຄວາມ​ສຸກ</para>
  <para style="q2" vid="PRO 15:23">ແລະ ຄໍາ​ເວົ້າ​ທີ່​ຖືກ​ກາລະ​ເທສະ​ກໍ​ດີ​ຫລາຍ​ເທົ່າ​ໃດ!<verse eid="PRO 15:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />ຄົນ​ທີ່​ສະຫລາດ​ເດີນ​ທາງ​ຂຶ້ນ​ໄປ​ສູ່​ຊີວິດ,</para>
  <para style="q2" vid="PRO 15:24">ເພື່ອ​ປ້ອງກັນ​ພວກເຂົາ​ບໍ່​ໃຫ້​ລົງ​ໄປ​ສູ່​ແດນ​ຂອງ​ຄົນ​ຕາຍ.<verse eid="PRO 15:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />ພຣະເຈົ້າ​ຢາເວ​ມ້າງ​ເຮືອນ​ຂອງ​ຄົນ​ອວດຕົວ,</para>
  <para style="q2" vid="PRO 15:25">ແຕ່​ພຣະອົງ​ວາງ​ສີລາ​ໄວ້​ໃນ​ເຂດແດນ​ຂອງ​ຍິງໝ້າຍ.<verse eid="PRO 15:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />ພຣະເຈົ້າ​ຢາເວ​ກຽດຊັງ​ຄວາມ​ຄິດ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ,</para>
  <para style="q2" vid="PRO 15:26">ແຕ່​ພຣະອົງ​ພໍໃຈ​ຄໍາເວົ້າ​ທີ່​ມີ​ບໍລິສຸດ.<verse eid="PRO 15:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />ຄົນ​ໂລບມາກ​ກໍ​ນຳ​ຄວາມ​ຈິບຫາຍ​ມາ​ສູ່​ຄອບຄົວ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 15:27">ແຕ່​ຄົນ​ທີ່​ກຽດຊັງ​ສິນບົນ​ຈະ​ມີ​ຊີວິດ​ຢູ່.<verse eid="PRO 15:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />ໃຈ​ຂອງ​ຄົນ​ຊອບທຳ​ຄິດ​ຊັ່ງຊາ​ກ່ອນ​ຕອບ,</para>
  <para style="q2" vid="PRO 15:28">ແຕ່​ປາກ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ເວົ້າ​ຄວາມ​ຊົ່ວ​ອອກ​ມາ.<verse eid="PRO 15:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />ພຣະເຈົ້າ​ຢາເວ​ຢູ່​ຫ່າງໄກ​ຈາກ​ຄົນ​ຊົ່ວຮ້າຍ,</para>
  <para style="q2" vid="PRO 15:29">ແຕ່​ພຣະອົງ​ຟັງ​ຄຳພາວັນນາ​ອະທິຖານ​ຂອງ​ຄົນ​ຊອບທຳ.<verse eid="PRO 15:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />ແສງສະຫວ່າງ​ໃນ​ຕາ​ຂອງ​ຜູ້ສົ່ງຂ່າວ​ນໍາ​ຄວາມ​ຍິນດີ​ມາ​ສູ່​ຈິດໃຈ,</para>
  <para style="q2" vid="PRO 15:30">ແລະ ຂ່າວ​ດີ​ເຮັດ​ໃຫ້​ກະດູກ​ແຂງແຮງ.<verse eid="PRO 15:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />ຜູ້​ທີ່​ໃສ່ໃຈ​ການ​ຕັກເຕືອນ ກໍ​ໃຫ້​ຊີວິດ</para>
  <para style="q2" vid="PRO 15:31">ທີ່​ຈະ​ຢູ່​ໃນ​ເຮືອນ​ທ່າມກາງ​ຄົນ​ມີ​ປັນຍາ.<verse eid="PRO 15:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />ຜູ້​ທີ່​ບໍ່​ຍອມຮັບ​ການ​ຕີສອນ​ກໍ​ໝິ່ນປະໝາດ​ຕົນ​ເອງ,</para>
  <para style="q2" vid="PRO 15:32">ແຕ່​ຜູ້​ທີ່​ຍອມຮັບ​ການ​ປັບປຸງ​ແກ້ໄຂ​ກໍ​ມີ​ຄວາມ​ເຂົ້າໃຈ​ເພີ່ມ​ຂຶ້ນ.<verse eid="PRO 15:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />ຄຳ​ສັ່ງສອນ​ຂອງ​ປັນຍາ​ແມ່ນ​ການ​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ,</para>
  <para style="q2" vid="PRO 15:33">ແລະ ຄວາມ​ຖ່ອມໃຈ​ມາ​ກ່ອນ​ກຽດ.<verse eid="PRO 15:33" /></para>
  <para style="b" />
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />ມະນຸດ​ວາງ​ແຜນການ​ຢູ່​ໃນ​ໃຈ,</para>
  <para style="q2" vid="PRO 16:1">ແຕ່​ຄຳ​ຕອບ​ທີ່​ຖືກຕ້ອງ​ມາ​ຈາກ​ລີ້ນ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ.<verse eid="PRO 16:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />ທາງ​ທັງໝົດ​ຂອງ​ມະນຸດ​ເບິ່ງ​ຄື​ວ່າ​ບໍລິສຸດ​ໃນ​ສາຍຕາ​ຂອງ​ພວກເຂົາ,</para>
  <para style="q2" vid="PRO 16:2">ແຕ່​ພຣະເຈົ້າ​ຢາເວ​ຊັ່ງຊາ​ແຮງຈູງໃຈ​ພາຍໃນ.<verse eid="PRO 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />ຈົ່ງ​ມອບ​ທຸກສິ່ງ​ທີ່​ເຈົ້າ​ເຮັດ​ໄວ້​ກັບ​ພຣະເຈົ້າ​ຢາເວ,</para>
  <para style="q2" vid="PRO 16:3">ແລ້ວ​ພຣະອົງ​ຈະ​ເຮັດ​ໃຫ້​ແຜນການ​ຂອງ​ເຈົ້າ​ສໍາເລັດ.<verse eid="PRO 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />ພຣະເຈົ້າ​ຢາເວ​ເຮັດ​ໃຫ້​ທຸກສິ່ງ​ສິ້ນສຸດ​ລົງ​ຢ່າງ​ເໝາະສົມ</para>
  <para style="q2" vid="PRO 16:4">ແມ່ນ​ແຕ່​ຄົນ​ຊົ່ວຮ້າຍ​ກໍ​ມີ​ມື້​ແຫ່ງ​ຄວາມ​ຈິບຫາຍ.<verse eid="PRO 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />ພຣະເຈົ້າ​ຢາເວ​ກຽດຊັງ​ທຸກຄົນ​ທີ່​ມີ​ໃຈ​ຍິ່ງ​ຈອງຫອງ.</para>
  <para style="q2" vid="PRO 16:5">ຈົ່ງ​ແນ່ໃຈ​ວ່າ​ພວກເຂົາ​ຈະ​ໜີ​ບໍ່​ພົ້ນ​ຈາກ​ການ​ລົງໂທດ.<verse eid="PRO 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />ບາບ​ຈະ​ໄດ້​ຮັບ​ການ​ຍົກໂທດ​ດ້ວຍ​ຄວາມ​ຮັກ ແລະ ຄວາມ​ສັດຊື່;</para>
  <para style="q2" vid="PRO 16:6">ຈະ​ຫລີກລ້ຽງ​ຈາກ​ສິ່ງ​ຊົ່ວຮ້າຍ​ໄດ້​ໂດຍ​ການ​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ.<verse eid="PRO 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />ເມື່ອ​ພຣະເຈົ້າ​ຢາເວ​ພໍໃຈ​ໃນ​ທາງ​ຂອງ​ຜູ້ໃດ​ຜູ້ໜຶ່ງ,</para>
  <para style="q2" vid="PRO 16:7">ພຣະອົງ​ເຮັດ​ໃຫ້​ສັດຕູ​ຂອງ​ພວກເຂົາ​ຄືນດີ​ກັບ​ພວກເຂົາ.<verse eid="PRO 16:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />ໄດ້​ມາ​ໜ້ອຍ​ດ້ວຍ​ຄວາມ​ຊອບທຳ</para>
  <para style="q2" vid="PRO 16:8">ກໍ​ດີ​ກວ່າ​ໄດ້​ຫລາຍ​ດ້ວຍ​ຄວາມ​ບໍ່​ຍຸຕິທຳ.<verse eid="PRO 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />ມະນຸດ​ວາງ​ແຜນການ​ຢູ່​ໃນ​ໃຈ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 16:9">ແຕ່​ພຣະເຈົ້າ​ຢາເວ​ເປັນ​ຜູ້​ກຳນົດ​ບາດກ້າວ​ຂອງ​ພວກເຂົາ.<verse eid="PRO 16:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />ຮິບສົບ​ຂອງ​ກະສັດ​ເວົ້າ​ອອກ​ມາ​ເປັນ​ດັ່ງ​ຄໍາ​ທໍານວາຍ,</para>
  <para style="q2" vid="PRO 16:10">ແລະ ປາກ​ຂອງ​ເພິ່ນ​ຈະ​ບໍ່​ທໍລະຍົດ​ຄວາມ​ຍຸຕິທຳ.<verse eid="PRO 16:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />ຕາ​ຊັ່ງ ແລະ ຕາ​ຊິງ​ທີ່​ຊື່ສັດ​ເປັນ​ຂອງ<note caller="+" style="f"><char style="fr" closed="false">16:11 </char><char style="ft" closed="false">ຫລື ເປັນ​ຂອງ</char></note>​ພຣະເຈົ້າ​ຢາເວ;</para>
  <para style="q2" vid="PRO 16:11">ໜ່ວຍ​ວັດແທກ​ນໍ້າໜັກ​ທັງໝົດ​ໃນ​ຊິງ​ໃນ​ຖົງ​ແມ່ນ​ພຣະອົງ​ເປັນ​ຜູ້​ສ້າງ.<verse eid="PRO 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />ບັນດາ​ກະສັດ​ກຽດຊັງ​ການ​ກະທຳ​ຜິດ,</para>
  <para style="q2" vid="PRO 16:12">ເພາະ​ບັນລັງ​ໄດ້​ຮັບ​ການ​ສະຖາປະນາ​ຂຶ້ນ​ໂດຍ​ຄວາມ​ຊອບທຳ.<verse eid="PRO 16:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />ບັນດາ​ກະສັດ​ພໍໃຈ​ໃນ​ຄໍາເວົ້າ​ສັດຊື່;</para>
  <para style="q2" vid="PRO 16:13">ພວກເຂົາ​ເຫັນ​ຄຸນຄ່າ​ຜູ້​ທີ່​ເວົ້າ​ຄວາມຈິງ.<verse eid="PRO 16:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />ຄວາມ​ໂກດຮ້າຍ​ຂອງ​ກະສັດ​ເປັນ​ດັ່ງ​ຜູ້ນຳຂ່າວ​ແຫ່ງ​ຄວາມ​ຕາຍ​ມາ,</para>
  <para style="q2" vid="PRO 16:14">ແຕ່​ຄົນ​ມີ​ປັນຍາ​ຈະ​ລະງັບ​ມັນ​ໄວ້​ໄດ້.<verse eid="PRO 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />ເມື່ອ​ໃບໜ້າ​ຂອງ​ກະສັດ​ຍິ້ມແຍ້ມ​ແຈ່ມໃສ, ກໍ​ໝາຍ​ເຖິງ​ຊີວິດ;</para>
  <para style="q2" vid="PRO 16:15">ຄວາມ​ເມດຕາ​ກະລຸນາ​ຂອງ​ເພິ່ນ​ເປັນ​ດັ່ງ​ເມກ​ຝົນ​ໃນ​ລະດູ​ໃບໄມ້​ປົ່ງ.<verse eid="PRO 16:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />ມີ​ປັນຍາ​ກໍ​ດີ​ກວ່າ​ມີ​ຄຳ​ຫລາຍ​ເທົ່າ​ໃດ,</para>
  <para style="q2" vid="PRO 16:16">ມີ​ຄວາມ​ເຂົ້າໃຈ​ກໍ​ດີ​ກວ່າ​ມີ​ເງິນ!<verse eid="PRO 16:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />ທາງ​ຂອງ​ຄົນ​ທ່ຽງທຳ​ກໍ​ຫລີກໜີ​ຈາກ​ຄວາມ​ຊົ່ວ;</para>
  <para style="q2" vid="PRO 16:17">ຜູ້​ທີ່​ເຝົ້າ​ລະວັງ​ທາງ​ຂອງ​ຕົນ​ກໍ​ຮັກສາ​ຊີວິດ​ຂອງ​ຕົນ​ໄວ້.<verse eid="PRO 16:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />ຄວາມ​ອວດຕົວ​ນຳ​ໄປ​ສູ່​ການ​ທຳລາຍ,</para>
  <para style="q2" vid="PRO 16:18">ແລະ ໃຈ​ທີ່​ຍິ່ງ​ຈອງຫອງ​ກໍ​ນຳ​ໄປ​ສູ່​ການ​ຫລົ້ມຈົມ.<verse eid="PRO 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />ມີ​ໃຈ​ຖ່ອມ​ລົງ​ຢູ່​ກັບ​ຄົນ​ທີ່​ຖືກ​ກົດຂີ່​ຂົ່ມເຫັງ</para>
  <para style="q2" vid="PRO 16:19">ກໍ​ດີ​ກວ່າ​ແບ່ງ​ສິ່ງ​ຂອງ​ທີ່​ປຸ້ນ​ມາ​ໄດ້​ກັບ​ຄົນ​ຈອງຫອງ.<verse eid="PRO 16:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />ຜູ້​ທີ່​ເອົາໃຈໃສ່​ຟັງ​ຄຳ​ສັ່ງສອນ​ຈະ​ຈະເລີນ​ຮຸ່ງເຮືອງ​ຂຶ້ນ,</para>
  <para style="q2" vid="PRO 16:20">ແລະ ຄວາມ​ສຸກ​ເປັນ​ຂອງ​ຜູ້​ທີ່​ໄວ້ວາງໃຈ​ໃນ​ພຣະເຈົ້າ​ຢາເວ.<verse eid="PRO 16:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />ຜູ້​ມີ​ໃຈ​ສະຫລາດ​ເອີ້ນ​ວ່າ​ຄົນ​ມີ​ຄວາມ​ຮອບຄອບ,</para>
  <para style="q2" vid="PRO 16:21">ແລະ ຄໍາເວົ້າ​ທີ່​ມີ​ຄວາມ​ເມດຕາ​ເຮັດ​ໃຫ້​ເພີ່ມ​ຄວາມ​ໜ້າ​ເຊື່ອ​ຖື.<note caller="+" style="f"><char style="fr" closed="false">16:21 </char><char style="ft" closed="false">ຫລື ເຮັດ​ໃຫ້​ລາວ​ໜ້າ​ເຊື່ອຖື</char></note><verse eid="PRO 16:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />ຄວາມ​ຮອບຄອບ​ເປັນ​ນໍ້າພຸ​ແຫ່ງ​ຊີວິດ​ໃຫ້​ແກ່​ຄົນ​ສະຫລາດ.</para>
  <para style="q2" vid="PRO 16:22">ແຕ່​ຄວາມ​ໂງ່ຈ້າ​ນຳ​ການ​ລົງໂທດ​ມາ​ສູ່​ຄົນ​ໂງ່ຈ້າ.<verse eid="PRO 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />ໃຈ​ຂອງ​ຄົນ​ມີ​ປັນຍາ​ເຮັດ​ໃຫ້​ລະວັງ​ປາກ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 16:23">ແລະ ຮິມສົບ​ຂອງ​ພວກເຂົາ​ເຮັດ​ໃຫ້​ເກີດ​ຄວາມ​ໜ້າເຊື່ອຖື.<note caller="+" style="f"><char style="fr" closed="false">16:23 </char><char style="ft" closed="false">ຫລື ລະ​ວັງ​ປາກ ແລະ ເຮັດ​ໃຫ້​ລິມ​ຝີ​ປາກ​ຂອງ​ເຂົາ​ໜ້າ​ເຊື່ອ​ຖື</char></note><verse eid="PRO 16:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />ຄໍາເວົ້າ​ທີ່​ມີ​ຄວາມ​ເມດຕາ​ເປັນ​ດັ່ງ​ນ້ຳເຜິ້ງ,</para>
  <para style="q2" vid="PRO 16:24">ເຮັດ​ໃຫ້​ເກີດ​ຄວາມ​ຊື່ນ​ໃຈ​ແກ່​ວິນຍານ ແລະ ຮັກສາ​ກະດູກ​ໄດ້.<note caller="+" style="f"><char style="fr" closed="false">16:24 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ​ວ່າ ກະດູກ</char></note><verse eid="PRO 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />ມີ​ທາງ​ໜຶ່ງ​ທີ່​ເບິ່ງ​ຄື​ວ່າ​ຖືກຕ້ອງ,</para>
  <para style="q2" vid="PRO 16:25">ແຕ່​ສຸດທ້າຍ​ມັນ​ຈະ​ນໍາ​ໄປ​ສູ່​ຄວາມ​ຕາຍ.<verse eid="PRO 16:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />ຄວາມ​ຢາກ​ອາຫານ​ຂອງ​ຄົນ​ເຮັດ​ໃຫ້​ຕົນ​ດຸໝັ່ນ;</para>
  <para style="q2" vid="PRO 16:26">ຄວາມ​ຫິວ​ຂອງ​ພວກເຂົາ​ກະຕຸ້ນ​ໃຫ້​ພວກເຂົາ​ເຮັດ​ວຽກ​ຕໍ່ໄປ.<verse eid="PRO 16:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />ຄົນ​ຊົ່ວ​ວາງ​ແຜນການ​ອັນ​ຊົ່ວຮ້າຍ,</para>
  <para style="q2" vid="PRO 16:27">ແລະ ຮິມສົບ​ຂອງ​ພວກເຂົາ​ກໍ​ເປັນ​ເໝືອນ​ໄຟ​ທີ່​ລຸກ​ໄໝ້.<verse eid="PRO 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />ຄົນ​ມັກ​ປີ້ນ​ຄວາມ​ເຮັດ​ໃຫ້​ເກີດ​ການ​ຜິດຖຽງກັນ,</para>
  <para style="q2" vid="PRO 16:28">ຄົນ​ມັກ​ນິນທາ​ເຮັດ​ໃຫ້​ໝູ່​ສະໜິດ​ແຕກແຍກ​ກັນ.<verse eid="PRO 16:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />ຄົນ​ທີ່​ໃຊ້​ຄວາມ​ຮຸນແຮງ​ກໍ​ຫລອກລວງ​ເພື່ອນບ້ານ</para>
  <para style="q2" vid="PRO 16:29">ແລະ ນຳ​ພວກເຂົາ​ລົງ​ໄປ​ໃນ​ທາງ​ທີ່​ບໍ່​ດີ.<verse eid="PRO 16:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />ຜູ້​ທີ່​ຂະຫຍິບ​ຕາ​ຂອງ​ຕົນ​ກຳລັງ​ຄິດ​ແຜນການ​ຮ້າຍ;</para>
  <para style="q2" vid="PRO 16:30">ຜູ້​ທີ່​ເຮັດ​ສົບ​ຈູ​ບອກ​ໃຫ້​ມິດງຽບ​ກໍ​ຫວັງ​ທໍາລາຍ.<verse eid="PRO 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />ຜົມ​ຫງອກ​ເປັນ​ມົງກຸດ​ແຫ່ງ​ສະຫງ່າລາສີ;</para>
  <para style="q2" vid="PRO 16:31">ມັນ​ໄດ້​ມາ​ດ້ວຍ​ວິຖີທາງ​ອັນ​ຊອບທຳ.<verse eid="PRO 16:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />ເປັນ​ຄົນ​ທີ່​ອົດທົນ​ກໍ​ດີກວ່າ​ເປັນ​ນັກຮົບ,</para>
  <para style="q2" vid="PRO 16:32">ຄົນ​ທີ່​ຄວບຄຸມ​ຕົນເອງ​ໄດ້​ກໍ​ດີກວ່າ​ຄົນ​ທີ່​ຕີ​ເອົາ​ເມືອງ​ໄດ້.<verse eid="PRO 16:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />ສະຫລາກ​ໃຊ້​ເພື່ອ​ຢາກ​ຮູ້​ຄວາມ​ປະສົງ​ຂອງ​ພຣະເຈົ້າ,</para>
  <para style="q2" vid="PRO 16:33">ແຕ່​ຄຳຊີ້ຂາດ​ແມ່ນ​ມາ​ຈາກ​ພຣະເຈົ້າ​ຢາເວ.<verse eid="PRO 16:33" /></para>
  <para style="b" />
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />ກິນ​ເຂົ້າ​ແຫ້ງ​ຢ່າງ​ມິດງຽບ ແລະ ສະຫງົບສຸກ</para>
  <para style="q2" vid="PRO 17:1">ກໍ​ດີ​ກວ່າ​ເຮືອນ​ທີ່​ເຕັມ​ໄປ​ດ້ວຍ​ງານລ້ຽງ​ພ້ອມ​ກັບ​ການ​ຜິດຖຽງ​ກັນ.<verse eid="PRO 17:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />ຄົນ​ຮັບໃຊ້​ທີ່​ສະຫລາດ​ຈະ​ປົກຄອງ​ລູກ​ທີ່​ໜ້າ​ອັບອາຍຂາຍໜ້າ.</para>
  <para style="q2" vid="PRO 17:2">ແລະ ຈະ​ໄດ້​ຮັບ​ສ່ວນ​ແບ່ງ​ມໍລະດົກ​ເໝືອນ​ດັ່ງ​ຄົນ​ໃນ​ຄອບຄົວ.<verse eid="PRO 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />ເຕົາຫລອມ​ໃຊ້​ທົດສອບ​ເງິນ ແລະ ເຕົາ​ໄຟ​ທົດສອບ​ຄຳ​ເຕົາ​ໄຟ​ສັນໃດ,</para>
  <para style="q2" vid="PRO 17:3">ພຣະເຈົ້າ​ຢາເວ​ກໍ​ທົດສອບ​ຈິດໃຈ.<verse eid="PRO 17:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />ຄົນ​ຊົ່ວຮ້າຍ​ມັກ​ຟັງ​ຄໍາເວົ້າ​ທີ່​ຫລອກລວງ;</para>
  <para style="q2" vid="PRO 17:4">ຄົນ​ຂີ້ຕົວະ​ກໍ​ມັກ​ຟັງ​ລີ້ນ​ທີ່​ຫວັງ​ທໍາລາຍ.<verse eid="PRO 17:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />ຜູ້​ທີ່​ເຢາະເຢີ້ຍ​ຄົນ​ທຸກຍາກ​ກໍ​ໝິ່ນປະໝາດ​ພຣະເຈົ້າ​ຜູ້​ສ້າງ​ຂອງ​ພວກເຂົາ;</para>
  <para style="q2" vid="PRO 17:5">ຜູ້​ທີ່​ດີ​ໃຈ​ເມື່ອ​ເຫັນ​ຄົນ​ພົບ​ໄພພິບັດ​ຈະ​ໜີ​ບໍ່​ພົ້ນ​ການ​ລົງໂທດ.<verse eid="PRO 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />ລູກ​ຫລານ​ເປັນ​ມົງກຸດ​ຂອງ​ຜູ້​ເຖົ້າ,</para>
  <para style="q2" vid="PRO 17:6">ແລະ ພໍ່​ແມ່​ເປັນ​ຄວາມ​ພູມ​ໃຈ​ຂອງ​ພວກ​ລູກ.<verse eid="PRO 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />ຄໍາເວົ້າ​ທີ່​ມວນ​ບໍ່​ເໝາະສົມ​ກັບ​ຄົນ​ທີ່​ບໍ່​ນັບຖື​ພຣະເຈົ້າ​ສັນໃດ</para>
  <para style="q2" vid="PRO 17:7">ຄຳເວົ້າ​ຕົວະ​ກໍ​ຍິ່ງ​ບໍ່​ເໝາະສົມ​ກັບ​ຜູ້ປົກຄອງ​ສັນນັ້ນ!<verse eid="PRO 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />ການ​ໃຫ້​ສິນບົນ​ຖື​ເປັນ​ສະເໜ່​ຂອງ​ຜູ້​ໃຫ້;</para>
  <para style="q2" vid="PRO 17:8">ພວກເຂົາ​ຄິດ​ວ່າ​ຄວາມ​ສຳເລັດ​ຈະ​ເກີດຂຶ້ນ​ທຸກ​ຄັ້ງ.<verse eid="PRO 17:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />ຜູ້​ທີ່​ສົ່ງເສີມ​ຄວາມ​ຮັກ​ກໍ​ປິດບັງ​ຄວາມຜິດ,</para>
  <para style="q2" vid="PRO 17:9">ແຕ່​ຜູ້​ທີ່​ເວົ້າ​ຟື້ນ​ເລື່ອງ​ເກົ່າ​ກໍ​ເຮັດ​ໃຫ້​ໝູ່​ສະໜິດ​ແຕກ​ແຍກ​ກັນ.<verse eid="PRO 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />ໃຫ້​ຄໍາ​ຕັກເຕືອນ​ພຽງ​ຄັ້ງ​ດຽວ​ແກ່​ຄົນ​ສະຫລາດ</para>
  <para style="q2" vid="PRO 17:10">ກໍ​ດີ​ກວ່າ​ຂ້ຽນ​ຕີ​ຄົນ​ໂງ່​ຈ້າ​ຮ້ອຍ​ບາດ.<verse eid="PRO 17:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />ຄົນ​ຊົ່ວຮ້າຍ​ສົ່ງເສີມ​ການ​ກະບົດ​ຕໍ່ສູ້​ພຣະເຈົ້າ;</para>
  <para style="q2" vid="PRO 17:11">ແຕ່​ຜູ້ນຳຂ່າວ​ແຫ່ງ​ຄວາມ​ຕາຍ​ຈະ​ຖືກ​ສົ່ງ​ມາ​ຕໍ່ສູ້​ພວກເຂົາ.<verse eid="PRO 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />ພົບ​ໝີ​ແມ່​ທີ່​ຖືກ​ລັກ​ລູກນ້ອຍ​ໄປ</para>
  <para style="q2" vid="PRO 17:12">ກໍ​ດີກວ່າ​ໄປ​ພົບ​ຄົນ​ໂງ່ຈ້າ​ທີ່​ຫລົງ​ຢູ່​ໃນ​ຄວາມ​ໂງ່.<verse eid="PRO 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />ຄວາມ​ຊົ່ວ​ຈະ​ບໍ່​ໜີ​ຈາກ​ບ້ານ​ໄປ</para>
  <para style="q2" vid="PRO 17:13">ຫາກ​ຄົນ​ນັ້ນ​ຕອບ​ແທນ​ຄວາມ​ດີ​ດ້ວຍ​ຄວາມ​ຊົ່ວ.<verse eid="PRO 17:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />ເລີ່ມ​ຜິດຖຽງກັນ​ກໍ​ເປັນ​ດັ່ງ​ເຂື່ອນ​ທີ່​ກໍາລັງ​ຈະ​ແຕກ;</para>
  <para style="q2" vid="PRO 17:14">ດັ່ງນັ້ນ ຈົ່ງ​ຢຸດ​ເລື່ອງ​ນີ້​ກ່ອນ​ການ​ຜິດຖຽງ​ກັນ​ຈະ​ເກີດ​ຂຶ້ນ.<verse eid="PRO 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />ສອງ​ສິ່ງ​ທີ່​ພຣະເຈົ້າ​ຢາເວ​ກຽດຊັງ​ຄື</para>
  <para style="q2" vid="PRO 17:15">ການ​ປ່ອຍ​ໃຫ້​ຄົນ​ຜິດ​ໜີ​ໄປ ແລະ ການ​ລົງໂທດ​ຄົນ​ຊອບທຳ.<verse eid="PRO 17:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />ເປັນຫຍັງ​ພວກ​ຄົນ​ໂງ່​ຈ້າ​ຈຶ່ງ​ມີ​ເງິນ​ໃນ​ມື​ເພື່ອ​ຊື້​ປັນຍາ,</para>
  <para style="q2" vid="PRO 17:16">ເມື່ອ​ພວກເຂົາ​ບໍ່​ສາມາດ​ເຂົ້າໃຈ​ປັນຍາ​ໄດ້?<verse eid="PRO 17:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />ໝູ່​ມີ​ຄວາມ​ຮັກ​ຕໍ່​ກັນ​ຢູ່​ຕະຫລອດ​ເວລາ,</para>
  <para style="q2" vid="PRO 17:17">ແລະ ອ້າຍ​ເອື້ອຍ​ນ້ອງ​ກັນ​ກໍ​ເກີດ​ມາ​ເພື່ອ​ຊ່ວຍ​ກັນ​ໃນ​ຍາມ​ຍາກ​ລໍາບາກ.<verse eid="PRO 17:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />ຄົນ​ບໍ່ຮູ້ຈັກຄິດ​ຈັບ​ມື​ໃຫ້​ຄໍາ​ສັນຍາ</para>
  <para style="q2" vid="PRO 17:18">ແລະ ຄ້ຳປະກັນ​ໃຫ້​ເພື່ອນບ້ານ.<verse eid="PRO 17:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />ຜູ້​ທີ່​ມັກ​ການ​ຜິດຖຽງກັນ​ກໍ​ຮັກ​ຄວາມ​ບາບ;</para>
  <para style="q2" vid="PRO 17:19">ຜູ້​ທີ່​ຍິ່ງ​ອວດຕົວ​ກໍ​ນໍາ​ຄວາມ​ຈິບຫາຍ​ມາ​ສູ່​ຕົນ.<verse eid="PRO 17:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />ຄົນ​ທີ່​ມີ​ຈິດໃຈ​ຄົດ​ໂກງ​ຈະ​ບໍ່​ຈະເລີນ,</para>
  <para style="q2" vid="PRO 17:20">ຄົນ​ທີ່​ເວົ້າ​ປີ້ນ​ຄວາມ​ຈະ​ຕົກ​ລົງ​ໃນ​ຄວາມ​ຍາກ​ລຳບາກ.<verse eid="PRO 17:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />ການ​ທີ່​ມີ​ລູກ​ເປັນ​ຄົນ​ໂງ່​ຈ້າ​ຈະ​ນໍາ​ຄວາມ​ໂສກເສົ້າ​ມາ;</para>
  <para style="q2" vid="PRO 17:21">ພໍ່ແມ່​ຂອງ​ຄົນ​ໂງ່ຈ້າ​ບໍ່​ມີ​ຄວາມ​ສຸກ.<verse eid="PRO 17:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />ຈິດໃຈ​ທີ່​ມ່ວນຊື່ນ​ກໍ​ເປັນ​ຢາ​ຊັ້ນດີ</para>
  <para style="q2" vid="PRO 17:22">ແຕ່​ຈິດ​ວິນຍານ​ທີ່​ແຕກສະຫລາຍ​ກໍ​ເຮັດ​ໃຫ້​ກະດູກ​ຫ່ຽວແຫ້ງ.<verse eid="PRO 17:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />ຄົນ​ຊົ່ວຮ້າຍ​ຍອມ​ຮັບ​ສິນບົນ​ຢ່າງ​ລັບໆ</para>
  <para style="q2" vid="PRO 17:23">ເພື່ອ​ບິດ​ເບືອນ​ທາງ​ແຫ່ງ​ຄວາມ​ຍຸຕິທຳ.<verse eid="PRO 17:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />ຄົນ​ສະຫລາດ​ຍ່ອມ​ຮັກສາ​ປັນຍາ​ໄວ້,</para>
  <para style="q2" vid="PRO 17:24">ແຕ່​ຕາ​ຂອງ​ຄົນ​ໂງ່​ຈ້າ​ແນມ​ຫາ​ໄປ​ຈົນ​ສຸດປາຍ​ແຜ່ນດິນ​ໂລກ.<verse eid="PRO 17:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />ລູກ​ໂງ່​ຈ້າ​ນໍາ​ຄວາມ​ໂສກເສົ້າ​ມາ​ສູ່​ພໍ່​ຂອງ​ຕົນ</para>
  <para style="q2" vid="PRO 17:25">ແລະ ນໍາ​ຄວາມ​ຂົມຂື່ນ​ມາ​ສູ່​ແມ່​ຂອງ​ຕົນ ຜູ້​ໃຫ້​ກຳ​ເນີດ​ຕົນ​ມາ.<verse eid="PRO 17:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />ຖ້າ​ການ​ລົງໂທດ​ຄົນບໍລິສຸດ​ເປັນ​ເລື່ອງ​ບໍ່​ດີ</para>
  <para style="q2" vid="PRO 17:26">ການ​ຂ້ຽນ​ຕີ​ເຈົ້າໜ້າທີ່​ທີ່​ຊື່ສັດ​ກໍ​ບໍ່​ຖືກຕ້ອງ​ຢ່າງ​ແນ່ນອນ.<verse eid="PRO 17:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />ຜູ້​ທີ່​ມີ​ຄວາມ​ຮູ້​ກໍ​ຈະ​ໃຊ້​ຄໍາເວົ້າ​ດ້ວຍ​ຄວາມ​ລະມັດລະວັງ</para>
  <para style="q2" vid="PRO 17:27">ຜູ້​ທີ່​ມີ​ຄວາມ​ເຂົ້າໃຈ​ກໍ​ເປັນ​ຄົນ​ໃຈ​ເຢັນ.<verse eid="PRO 17:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />ແມ່ນແຕ່​ຄົນ​ໂງ່ຈ້າ​ກໍ​ຖືວ່າ​ເປັນ​ຄົນ​ມີ​ປັນຍາ</para>
  <para style="q2" vid="PRO 17:28">ຖ້າ​ພວກເຂົາ​ມິດງຽບ​ຢູ່ ແລະ ຖ້າ​ພວກເຂົາ​ງັບ​ປາກ​ໄວ້​ໄດ້​ກໍ​ຖື​ວ່າ​ພວກເຂົາ​ເປັນ​ຄົນ​ສະຫລາດ.<verse eid="PRO 17:28" /></para>
  <para style="b" />
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />ຄົນ​ທີ່​ບໍ່​ເປັນ​ມິດ​ສະແຫວງຫາ​ຈຸດຈົບ​ທີ່​ເຫັນ​ແກ່​ໂຕ</para>
  <para style="q2" vid="PRO 18:1">ແລະ ຕໍ່ຕ້ານ​ການ​ຕັດສິນ​ທີ່​ຖືກຕ້ອງ​ທັງໝົດ ເຮັດ​ໃຫ້​ຜິດ​ຖຽງ​ກັນ.<verse eid="PRO 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />ຄົນ​ໂງ່​ຈ້າ​ບໍ່​ພົບ​ຄວາມ​ສຸກ​ໃນ​ຄວາມ​ເຂົ້າໃຈ</para>
  <para style="q2" vid="PRO 18:2">ແຕ່​ມັກ​ຍິນດີ​ໃນ​ການ​ສະແດງ​ຄວາມ​ຄິດເຫັນ​ຂອງ​ຕົນ.<verse eid="PRO 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />ເມື່ອ​ຄວາມ​ຊົ່ວ​ມາ<note caller="+" style="f"><char style="fr" closed="false">18:3 </char><char style="ft" closed="false">ຫລື ຄົນ​ຊົ່ວ</char></note> ການ​ດູຖູກ​ກໍ​ມາ​ນໍາ,</para>
  <para style="q2" vid="PRO 18:3">ແລະ ການ​ຕຳໜິ​ມາ​ພ້ອມ​ກັບ​ຄວາມ​ອັບອາຍ.<verse eid="PRO 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />ຄຳເວົ້າ​ຈາກ​ປາກ​ຂອງ​ຄົນ​ເປັນ​ດັ່ງ​ນ້ຳ​ເລິກ,</para>
  <para style="q2" vid="PRO 18:4">ນ້ຳພຸ​ແຫ່ງ​ປັນຍາ​ເປັນ​ກະແສ​ນ້ຳ​ທີ່​ໄຫລ​ແຮງ.<verse eid="PRO 18:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />ການ​ເຂົ້າ​ຂ້າງ​ຄົນ​ຊົ່ວ​ຮ້າຍ​ບໍ່​ດີ​ສັນໃດ</para>
  <para style="q2" vid="PRO 18:5">ແລະ ການ​ບໍ່​ໃຫ້​ຄວາມ​ຍຸຕິທຳ​ແກ່​ຄົນ​ບໍລິສຸດ​ກໍ​ບໍ່​ດີ​ສັນນັ້ນ.<verse eid="PRO 18:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />ຮິມສົບ​ຂອງ​ຄົນ​ໂງ່​ຈ້າ​ນໍາ​ເອົາ​ຄວາມ​ຂັດແຍ່ງ​ມາ​ສູ່​ພວກເຂົາ,</para>
  <para style="q2" vid="PRO 18:6">ແລະ ປາກ​ຂອງ​ພວກເຂົາ​ນໍາ​ເອົາ​ການ​ຊົກຕ່ອຍ​ມາ.<verse eid="PRO 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />ປາກ​ຂອງ​ຄົນ​ໂງ່​ຈ້າ​ເປັນ​ຄວາມ​ຈິບຫາຍ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 18:7">ຮິມສົບ​ຂອງ​ພວກເຂົາ​ເປັນ​ກັບດັກ​ຊີວິດ​ຂອງ​ຕົນ.<verse eid="PRO 18:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />ຄຳເວົ້າ​ນິນທາ​ເປັນ​ດັ່ງ​ອາຫານ​ທີ່​ແຊບ;</para>
  <para style="q2" vid="PRO 18:8">ມັນ​ລົງ​ໄປ​ໃນ​ສ່ວນ​ເລິກ​ທີ່​ສຸດ​ຂອງ​ຄົນ.<verse eid="PRO 18:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />ຄົນ​ຂີ້ຄ້ານ​ໃນ​ການ​ເຮັດວຽກ​ຂອງ​ຕົນ</para>
  <para style="q2" vid="PRO 18:9">ເປັນ​ພີ່ນ້ອງ​ກັບ​ຄົນ​ທີ່​ມັກ​ທໍາລາຍ.<verse eid="PRO 18:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />ນາມຊື່​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ເປັນ​ດັ່ງ​ປ້ອມ​ປ້ອງກັນ;</para>
  <para style="q2" vid="PRO 18:10">ຄົນ​ຊອບທຳ​ແລ່ນ​ເຂົ້າ​ໄປ​ຫລົບ​ລີ້​ຢູ່​ທີ່​ນັ້ນ ແລະ ໄດ້​ຮັບ​ຄວາມ​ປອດໄພ.<verse eid="PRO 18:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />ຊັບສົມບັດ​ຂອງ​ຄົນ​ຮັ່ງມີ​ເປັນ​ດັ່ງ​ປ້ອມ​ປ້ອງກັນ​ເມືອງ​ຂອງ​ພວກເຂົາ;</para>
  <para style="q2" vid="PRO 18:11">ພວກເຂົາ​ຄິດວ່າ​ມັນ​ເປັນ​ກຳແພງ​ສູງ​ເກີນ​ກວ່າ​ທີ່​ຈະ​ວັດແທກ​ໄດ້.<verse eid="PRO 18:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />ໃຈ​ຂອງ​ຄົນ​ໂອ້ອວດ​ກໍ​ຈະ​ຕົກຕໍ່າ</para>
  <para style="q2" vid="PRO 18:12">ແຕ່​ການ​ຖ່ອມຕົວ​ນໍາ​ກຽດ​ມາ​ໃຫ້.<verse eid="PRO 18:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />ຄົນ​ທີ່​ຕອບ​ກ່ອນ​ຟັງ</para>
  <para style="q2" vid="PRO 18:13">ກໍ​ເປັນ​ຄວາມ​ໂງ່ຈ້າ ແລະ ຄວາມ​ອັບອາຍ​ຂາຍ​ໜ້າ.<verse eid="PRO 18:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />ຈິດໃຈ​ຂອງ​ຄົນ​ອົດທົນ​ຕໍ່​ຄວາມ​ເຈັບປ່ວຍ​ໄດ້</para>
  <para style="q2" vid="PRO 18:14">ແຕ່​ເມື່ອ​ຈິດໃຈ​ແຕກ​ສະຫລາຍ​ຜູ້ໃດ​ຈະ​ອົດທົນ​ໄດ້?<verse eid="PRO 18:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />ໃຈ​ຂອງ​ຄົນ​ສະ​ຫລາດ​ສະແຫວງ​ຫາ​ຄວາມ​ຮູ້</para>
  <para style="q2" vid="PRO 18:15">ແລະ ຫູ​ຂອງ​ຄົນ​ມີ​ປັນຍາ​ສະແຫວງ​ຫາ​ຄວາມ​ຮູ້.<verse eid="PRO 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />ຂອງຂັວນ​ເປີດ​ຊ່ອງທາງ</para>
  <para style="q2" vid="PRO 18:16">ແລະ ນໍາ​ທາງ​ແກ່​ຜູ້​ໃຫ້​ເພື່ອ​ຈະ​ໄດ້​ເຂົ້າ​ມາ​ພົບ​ຜູ້​ໃຫຍ່.<verse eid="PRO 18:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />ຄົນ​ທີ່​ເວົ້າ​ກ່ອນ​ໃນ​ສານ​ເບິ່ງ​ຄື​ວ່າ​ເປັນ​ຝ່າຍຖືກ,</para>
  <para style="q2" vid="PRO 18:17">ຈົນກວ່າ​ອີກ​ຝ່າຍ​ເຂົ້າ​ມາ ແລະ ໂຕ້ແຍ້ງ.<verse eid="PRO 18:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />ການ​ຈັບ​ສະຫລາກ​ຢຸດຕິ​ການ​ຜິດຖຽງ​ກັນ</para>
  <para style="q2" vid="PRO 18:18">ແລະ ແຍກ​ຄູ່​ຂັດແຍ້ງ​ອອກ​ຈາກ​ກັນ​ໄດ້.<verse eid="PRO 18:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />ການ​ໄກ່ເກ່ຍ​ອ້າຍ​ເອື້ອຍ​ນ້ອງ​ທີ່​ຜິດ​ກັນ​ກໍ​ຍາກ​ກວ່າ​ການ​ຢຶດ​ເມືອງ​ທີ່​ມີ​ປ້ອມ​ປ້ອງກັນ;</para>
  <para style="q2" vid="PRO 18:19">ການ​ຜິດຖຽງ​ກັນ​ເປັນ​ດັ່ງ​ປະຕູ​ຮົ້ວ​ທີ່​ກັ້ນ​ໄວ້.<verse eid="PRO 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />ຜົນ​ຈາກ​ປາກ​ເຮັດ​ໃຫ້​ຄົນ​ອີ່ມ​ທ້ອງ;</para>
  <para style="q2" vid="PRO 18:20">ພວກເຂົາ​ພໍໃຈ​ດ້ວຍ​ການ​ເກັບກ່ຽວ​ຜົນ​ຈາກ​ຮິມສົບ​ຂອງ​ຕົນ.<verse eid="PRO 18:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />ລີ້ນ​ມີ​ອຳນາດ​ແຫ່ງ​ຊີວິດ ແລະ ຄວາມ​ຕາຍ,</para>
  <para style="q2" vid="PRO 18:21">ແລະ ຄົນ​ທີ່​ຮັກ​ການ​ເວົ້າ​ຈະ​ໄດ້​ກິນ​ຜົນ​ຂອງ​ມັນ.<verse eid="PRO 18:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />ຜູ້​ທີ່​ພົບ​ເມຍ​ກໍ​ພົບ​ສິ່ງ​ທີ່​ດີ</para>
  <para style="q2" vid="PRO 18:22">ແລະ ໄດ້​ຮັບ​ຄວາມ​ພໍໃຈ​ຈາກ​ພຣະເຈົ້າ​ຢາເວ.<verse eid="PRO 18:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />ຄົນ​ທຸກຍາກ​ອ້ອນວອນ​ຂໍ​ຄວາມ​ເມດຕາ,</para>
  <para style="q2" vid="PRO 18:23">ແຕ່​ຄົນ​ຮັ່ງມີ​ຕອບ​ຢ່າງ​ຫຍາບຊ້າ.<verse eid="PRO 18:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />ຜູ້​ທີ່​ມີ​ໝູ່ເພື່ອນ​ທີ່​ໄວ້ໃຈ​ບໍ່​ໄດ້​ຈະ​ນໍາ​ຄວາມ​ຈິບຫາຍ​ມາ​ໃຫ້,</para>
  <para style="q2" vid="PRO 18:24">ແຕ່​ມີ​ໝູ່ເພື່ອນ​ທີ່​ໃກ້​ຊິດ​ສະໜິດ​ແໜ້ນ​ກໍ​ດີ​ກວ່າ​ພີ່ນ້ອງ.<verse eid="PRO 18:24" /></para>
  <para style="b" />
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />ເປັນ​ຄົນ​ທຸກຍາກ​ທີ່​ດຳເນີນ​ຊີວິດ​ຢ່າງ​ບໍ່​ມີ​ຕຳໜິ</para>
  <para style="q2" vid="PRO 19:1">ກໍ​ດີ​ກວ່າ​ເປັນ​ຄົນ​ໂງ່​ຈ້າ​ທີ່​ເວົ້າ​ປີ້ນ​ຄວາມ.<verse eid="PRO 19:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />ຄວາມ​ປາຖະໜາ​ທີ່​ຂາດ​ຄວາມຮູ້​ບໍ່​ເປັນ​ການ​ດີ</para>
  <para style="q2" vid="PRO 19:2">ຕີນ​ທີ່​ຟ້າວຟັ່ງ​ກໍ​ຈະ​ເຮັດ​ໃຫ້​ຫລົງ​ທາງ!<verse eid="PRO 19:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />ຄວາມ​ໂງ່ຈ້າ​ຂອງ​ຄົນ​ນໍາ​ໄປ​ສູ່​ຄວາມ​ຈິບຫາຍ,</para>
  <para style="q2" vid="PRO 19:3">ແຕ່​ໃຈ​ຂອງ​ພວກເຂົາ​ໂມໂຫ​ກ່າວ​ໂທດ​ພຣະເຈົ້າ​ຢາເວ.<verse eid="PRO 19:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />ຄວາມ​ຮັ່ງມີ​ເຮັດ​ໃຫ້​ມີ​ໝູ່ເພື່ອນ​ຢ່າງ​ຫລວງຫລາຍ,</para>
  <para style="q2" vid="PRO 19:4">ແມ່ນ​ແຕ່​ໝູ່​ສະໜິດ​ຂອງ​ຄົນທຸກ​ຍາກ​ກໍ​ຍັງ​ປະຖິ້ມ​ລາວ​ໄປ.<verse eid="PRO 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />ພະຍານ​ທີ່​ບໍ່​ຈິງ​ຈະ​ໜີ​ບໍ່​ພົ້ນ​ຈາກ​ການ​ລົງໂທດ,</para>
  <para style="q2" vid="PRO 19:5">ແລະ ຜູ້​ທີ່​ເວົ້າ​ຕົວະ​ຈະ​ບໍ່​ເປັນ​ອິດສະຫລະ.<verse eid="PRO 19:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />ຄົນ​ສ່ວນ​ຫລາຍ​ເອົາໃຈ​ຜູ້​ມີ​ອຳນາດ,</para>
  <para style="q2" vid="PRO 19:6">ແລະ ທຸກຄົນ​ຈະ​ເປັນ​ໝູ່​ກັບ​ຜູ້​ທີ່​ເອົາ​ຂອງຂັວນ​ໃຫ້.<verse eid="PRO 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />ຄົນ​ທຸກຍາກ​ນັ້ນ​ພີ່ນ້ອງ​ທຸກ​ຄົນ​ກໍ​ກຽດຊັງ</para>
  <para style="q2" vid="PRO 19:7">ແລະ ໝູ່ເພື່ອນ​ຂອງ​ພວກເຂົາ​ກໍ​ຍິ່ງ​ຫລີກ​ໜີ​ຫ່າງ​ຈາກ​ພວກເຂົາ!</para>
  <para style="q1" vid="PRO 19:7">ເຖິງ​ແມ່ນ​ວ່າ ຄົນ​ທຸກຍາກ​ຕາມ​ໄປ​ອ້ອນວອນ​ຂໍ​ພວກເຂົາ,</para>
  <para style="q2" vid="PRO 19:7">ພວກເຂົາ​ກໍ​ຫລົບ​ໜີ​ໄປ​ໝົດ.<note caller="+" style="f"><char style="fr" closed="false">19:7 </char><char style="ft" closed="false">ໃນ​ພາສາ​ເຮັບເຣີ​ປະ​ໂຫຍກ​ນີ້​ມີ​ຄວາມຫມາຍ​ບໍ່​ຊັດເຈນ</char></note><verse eid="PRO 19:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />ຜູ້​ທີ່​ມີ​ປັນຍາ​ກໍ​ຮັກ​ຊີວິດ​ຂອງ​ຕົນເອງ;</para>
  <para style="q2" vid="PRO 19:8">ຜູ້​ທີ່​ທະນຸຖະໜອມ​ຄວາມ​ເຂົ້າໃຈ​ອີກ​ບໍ່​ດົນ​ກໍ​ຈະ​ຈະເລີນ​ຮຸ່ງເຮືອງ​ຂຶ້ນ.<verse eid="PRO 19:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />ພະຍານ​ທີ່​ບໍ່​ຈິງ​ຈະ​ໜີ​ບໍ່​ພົ້ນ​ຈາກ​ການ​ລົງໂທດ,</para>
  <para style="q2" vid="PRO 19:9">ແລະ ຜູ້​ເວົ້າ​ຕົວະ​ຈະ​ຈິບຫາຍ.<verse eid="PRO 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />ຄົນ​ໂງ່​ຈ້າ​ບໍ່​ຄວນ​ໃຊ້​ຊີວິດ​ຢ່າງ​ຟຸມເຟືອຍ​ສັນໃດ</para>
  <para style="q2" vid="PRO 19:10">ຂ້າທາດ​ກໍ​ບໍ່​ຄວນ​ຈະ​ປົກຄອງ​ເຈົ້ານາຍ​ສັນນັ້ນ!<verse eid="PRO 19:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />ປັນຍາ​ຂອງ​ຄົນ​ເຮັດ​ໃຫ້​ເກີດ​ຄວາມ​ອົດ​ທົນ;</para>
  <para style="q2" vid="PRO 19:11">ແລະ ກຽດ​ຂອງ​ຄົນ​ນັ້ນ​ຄື​ການ​ເບິ່ງ​ຂ້າມ​ຄວາມຜິດ​ຂອງ​ຄົນ​ອື່ນ.<verse eid="PRO 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />ຄວາມ​ໂກດຮ້າຍ​ຂອງ​ກະສັດ​ເປັນ​ດັ່ງ​ສຽງ​ໂຕສິງ​ແຜດສຽງ,</para>
  <para style="q2" vid="PRO 19:12">ແຕ່​ຄວາມ​ເມດຕາ​ຂອງ​ເພິ່ນ​ເປັນ​ດັ່ງ​ນໍ້າໝອກ​ຢູ່​ເທິງ​ຫຍ້າ.<verse eid="PRO 19:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />ລູກ​ໂງ່​ຈ້າ​ນໍາ​ຄວາມ​ຈິບຫາຍ​ມາ​ໃຫ້​ພໍ່,</para>
  <para style="q2" vid="PRO 19:13">ແລະ ເມຍ​ທີ່​ມັກ​ທະເລາະ​ວິວາດ​ກໍ​ເໝືອນ​ຫລັງຄາ​ຮົ່ວ</para>
  <para style="q2" vid="PRO 19:13">ທີ່​ມີ​ນ້ຳຝົນ​ຍ້ອຍ​ຢູ່​ຕະຫລອດ.<verse eid="PRO 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />ເຮືອນ ແລະ ຊັບສົມບັດ​ເປັນ​ມໍລະດົກ​ຈາກ​ພໍ່​ແມ່,</para>
  <para style="q2" vid="PRO 19:14">ແຕ່​ເມຍ​ທີ່​ສະຫລາດ​ແມ່ນ​ມາ​ຈາກ​ພຣະເຈົ້າ​ຢາເວ.<verse eid="PRO 19:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />ຄວາມ​ຂີ້ຄ້ານ​ເຮັດ​ໃຫ້​ຫລັບ​ສະໜິດ,</para>
  <para style="q2" vid="PRO 19:15">ແລະ ຄົນ​ຂີ້ຄ້ານ​ກໍ​ຈະ​ຫິວໂຫຍ.<verse eid="PRO 19:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />ຜູ້​ທີ່​ຖື​ຮັກສາ​ກົດບັນຍັດ​ກໍ​ຮັກສາ​ຊີວິດ​ຂອງ​ຕົນ​ໄວ້.</para>
  <para style="q2" vid="PRO 19:16">ແຕ່​ຜູ້​ທີ່​ບໍ່​ເອົາໃຈໃສ່​ທາງ​ຂອງ​ຕົນ​ຈະ​ເສຍ​ຊີວິດ.<verse eid="PRO 19:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />ຜູ້​ທີ່​ເມດຕາ​ຕໍ່​ຄົນ​ທຸກຍາກ​ກໍ​ເທົ່າ​ກັບ​ໃຫ້​ພຣະເຈົ້າ​ຢາເວ​ຢືມ,</para>
  <para style="q2" vid="PRO 19:17">ແລະ ພຣະອົງ​ຈະ​ໃຫ້​ລາງວັນ​ຕອບ​ແທນ​ຕໍ່​ສິ່ງ​ທີ່​ພວກເຂົາ​ໄດ້​ເຮັດ.<verse eid="PRO 19:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />ຈົ່ງ​ແອບສອນ​ລູກ​ຂອງ​ເຈົ້າ, ເພາະ​ໃນ​ນັ້ນ​ຍັງ​ມີ​ຄວາມ​ຫວັງ​ຢູ່;</para>
  <para style="q2" vid="PRO 19:18">ການ​ຕາມ​ໃຈ​ລູກ​ຄື​ການ​ສົ່ງເສີມ​ພວກເຂົາ​ໄປ​ສູ່​ຄວາມ​ຕາຍ.<verse eid="PRO 19:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />ຄົນ​ໃຈຮ້ອນ​ຈະ​ໄດ້​ຮັບ​ການ​ລົງໂທດ;</para>
  <para style="q2" vid="PRO 19:19">ຖ້າ​ເຈົ້າ​ຊ່ວຍ​ພວກເຂົາ, ເຈົ້າ​ກໍ​ຈະ​ຕ້ອງ​ຊ່ວຍ​ພວກເຂົາ​ອີກ.<verse eid="PRO 19:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />ຈົ່ງ​ຟັງ​ຄຳ​ແນະນຳ ແລະ ຍອມຮັບ​ເອົາ​ການ​ຕີສອນ,</para>
  <para style="q2" vid="PRO 19:20">ແລະ ໃນ​ທີ່ສຸດ​ເຈົ້າ​ຈະ​ຖືກ​ນັບ​ເຂົ້າ​ເປັນ​ໜຶ່ງ​ໃນ​ທ່າມກາງ​ຄົນ​ມີ​ປັນຍາ.<verse eid="PRO 19:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />ໃນ​ໃຈ​ຂອງ​ມະນຸດ​ມີ​ແຜນການ​ຢ່າງ​ຫລວງ​ຫລາຍ,</para>
  <para style="q2" vid="PRO 19:21">ແຕ່​ຄວາມ​ປະສົງ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ນັ້ນ​ຈະ​ພົ້ນເດັ່ນ.<verse eid="PRO 19:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />ສິ່ງ​ທີ່​ຄົນ​ປາຖະໜາ​ແມ່ນ​ຄວາມ​ຮັກ​ໝັ້ນຄົງ;<note caller="+" style="f"><char style="fr" closed="false">19:22 </char><char style="ft" closed="false">ຫລື ຄວາມ​ໂລບ​ຂອງ​ມະນຸດ​ເປັນ​ຄວາມ​ອັບອາຍ​ຂອງ​ເຂົາ</char></note></para>
  <para style="q2" vid="PRO 19:22">ແລະ ເປັນ​ຄົນ​ທຸກຍາກ​ກໍ​ດີກວ່າ​ເປັນ​ຄົນ​ຂີ້ຕົວະ.<verse eid="PRO 19:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />ການ​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ​ນຳ​ໄປ​ສູ່​ຊີວິດ;</para>
  <para style="q2" vid="PRO 19:23">ແລ້ວ​ລາວ​ກໍ​ພັກຜ່ອນ​ຢ່າງ​ປອດໄພ​ໂດຍ​ປາສະຈາກ​ບັນຫາ.<verse eid="PRO 19:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />ຄົນ​ຂີ້ຄ້ານ​ແຊ່​ມື​ຂອງ​ຕົນ​ໄວ້​ຢູ່​ໃນ​ຈານ;</para>
  <para style="q2" vid="PRO 19:24">ລາວ​ບໍ່​ຍອມ​ແມ່ນ​ແຕ່​ຈະ​ຈັບ​ອາຫານ​ເຂົ້າ​ໃສ່​ປາກ​ຕົນ​ເອງ!<verse eid="PRO 19:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />ຈົ່ງ​ຂ້ຽນ​ຕີ​ຄົນ​ທີ່​ມັກ​ເຢາະເຢີ້ຍ, ແລະ ຜູ້​ທີ່​ບໍ່ຮູ້ຈັກຄິດ​ຈະ​ຮຽນຮູ້​ເອົາ​ຄວາມ​ສະຫລາດ;</para>
  <para style="q2" vid="PRO 19:25">ຈົ່ງ​ຕັກເຕືອນ​ຄົນ​ສະຫລາດ ແລະ ພວກເຂົາ​ຈະ​ມີ​ຄວາມ​ຮູ້​ເພີ່ມ​ຂຶ້ນ.<verse eid="PRO 19:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />ລູກ​ທີ່​ປຸ້ນ​ພໍ່ ແລະ ໄລ່​ແມ່​ໜີ</para>
  <para style="q2" vid="PRO 19:26">ກໍ​ເປັນ​ລູກ​ທີ່​ນຳ​ຄວາມ​ອັບອາຍ ແລະ ຄວາມ​ລະອາຍ​ມາ​ໃຫ້.<verse eid="PRO 19:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />ລູກ​ເອີຍ, ຖ້າ​ບໍ່​ຟັງ​ຄຳ​ສັ່ງສອນ,</para>
  <para style="q2" vid="PRO 19:27">ເຈົ້າ​ກໍ​ຈະ​ຫລົງ​ໄປ​ຈາກ​ຖ້ອຍຄຳ​ແຫ່ງ​ຄວາມ​ຮູ້.<verse eid="PRO 19:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />ພະຍານ​ທີ່​ຫລອກລວງ​ເຢາະເຢີ້ຍ​ຄວາມ​ຍຸຕິທຳ,</para>
  <para style="q2" vid="PRO 19:28">ແລະ ປາກ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ກໍ​ກືນ​ກິນ​ຄວາມ​ຊົ່ວຮ້າຍ.<verse eid="PRO 19:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />ການ​ລົງໂທດ​ຕຽມ​ໄວ້​ສໍາລັບ​ຄົນ​ມັກ​ເຢາະເຍີ້ຍ,</para>
  <para style="q2" vid="PRO 19:29">ແລະ ການ​ຂ້ຽນຕີ​ຕຽມ​ໄວ້​ສໍາລັບ​ຫລັງ​ຂອງ​ຄົນ​ໂງ່​ຈ້າ.<verse eid="PRO 19:29" /></para>
  <para style="b" />
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />ເຫລົ້າ​ເຮັດ​ໃຫ້​ຄົນ​ເວົ້າ​ບໍ່​ມ່ວນ ແລະ ເບຍ​ເຮັດ​ໃຫ້​ຄົນ​ຜິດຖຽງ​ກັນ;</para>
  <para style="q2" vid="PRO 20:1">ຜູ້​ທີ່​ປ່ອຍ​ໃຫ້​ຕົນ​ເມົາ​ກໍ​ບໍ່​ມີ​ປັນຍາ.<verse eid="PRO 20:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />ຄວາມ​ໂກດຮ້າຍ​ຂອງ​ກະສັດ​ເຮັດ​ໃຫ້​ເກີດ​ຄວາມ​ຢ້ານ​ດັ່ງ​ໂຕສິງ​ຮ້ອງ​ແຜດສຽງ;</para>
  <para style="q2" vid="PRO 20:2">ຜູ້​ທີ່​ເຮັດ​ໃຫ້​ເພິ່ນ​ໃຈຮ້າຍ​ຈະ​ເສຍ​ຊີວິດ​ຂອງ​ຕົນ.<verse eid="PRO 20:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />ຫລີກລ້ຽງ​ຈາກ​ການ​ຜິດຖຽງ​ກັນ​ກໍ​ເປັນ​ກຽດ​ຢ່າງ​ໜຶ່ງ,</para>
  <para style="q2" vid="PRO 20:3">ແຕ່​ມີ​ແຕ່​ຄົນ​ໂງ່ຈ້າ​ເທົ່ານັ້ນ​ທີ່​ມັກ​ຜິດຖຽງ​ກັນ.<verse eid="PRO 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />ຄົນ​ຂີ້ຄ້ານ​ບໍ່​ຄາດ​ໄຖ​ດິນ​ຕາມ​ລະດູການ;</para>
  <para style="q2" vid="PRO 20:4">ດັ່ງນັ້ນ ເມື່ອ​ເຖິງ​ເວລາ​ເກັບ​ກ່ຽວ​ພວກເຂົາ​ຊອກຫາ​ຜົນລະປູກ​ແຕ່​ກໍ​ບໍ່​ມີ​ຫຍັງ.<verse eid="PRO 20:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />ຄວາມ​ປະສົງ​ໃນ​ໃຈ​ຄົນ​ເປັນ​ເໝືອນ​ນ້ຳ​ເລິກ,</para>
  <para style="q2" vid="PRO 20:5">ແຕ່​ຄົນ​ທີ່​ມີ​ຄວາມ​ເຂົ້າໃຈ​ກໍ​ຕັກ​ມັນ​ອອກ​ມາ​ໄດ້.<verse eid="PRO 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />ມີ​ຫລາຍ​ຄົນ​ອ້າງ​ວ່າ​ຕົນ​ມີ​ຄວາມ​ຮັກ​ໝັ້ນຄົງ,</para>
  <para style="q2" vid="PRO 20:6">ແຕ່​ຜູ້ໃດ​ສາມາດ​ຊອກ​ເຫັນ​ຄົນ​ສັດຊື່​ໄດ້?<verse eid="PRO 20:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />ຄົນ​ຊອບທຳ​ດຳເນີນ​ຊີວິດ​ຢ່າງ​ບໍ່​ມີ​ຕຳໜິ;</para>
  <para style="q2" vid="PRO 20:7">ລູກ​ຫລານ​ຂອງ​ພວກເຂົາ​ໄດ້​ຮັບ​ພຣະພອນ.<verse eid="PRO 20:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />ເມື່ອ​ກະສັດ​ນັ່ງ​ເທິງ​ບັນລັງ​ເພື່ອ​ພິພາກສາ</para>
  <para style="q2" vid="PRO 20:8">ເພິ່ນ​ຝັດ​ຮ່ອນ​ຄວາມ​ຊົ່ວ​ທັງໝົດ​ອອກ​ໄປ​ດ້ວຍ​ຕາ​ຂອງ​ເພິ່ນ.<verse eid="PRO 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />ຜູ້ໃດ​ສາມາດ​ເວົ້າ​ໄດ້​ວ່າ “ຂ້າພະເຈົ້າ​ໄດ້​ຮັກສາ​ໃຈ​ຂອງ​ຕົນ​ໃຫ້​ບໍລິສຸດ;</para>
  <para style="q2" vid="PRO 20:9">ຂ້າພະເຈົ້າ​ສະອາດ ແລະ ປາສະຈາກ​ບາບ”?<verse eid="PRO 20:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />ສອງ​ສິ່ງ​ທີ່​ພຣະເຈົ້າ​ຢາເວ​ກຽດຊັງ​ຄື</para>
  <para style="q2" vid="PRO 20:10">ເຄື່ອງ​ຊັ່ງ​ກັບ​ເຄື່ອງແທກ​ທີ່​ບໍ່​ທ່ຽງທໍາ.<verse eid="PRO 20:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />ແມ່ນແຕ່​ເດັກນ້ອຍ​ກໍ​ຮູ້​ຈັກ​ໄດ້​ຈາກ​ການ​ກະທຳ​ຂອງ​ພວກເຂົາ,</para>
  <para style="q2" vid="PRO 20:11">ດັ່ງນັ້ນ ການ​ກະທໍາ​ຂອງ​ພວກເຂົາ​ບໍລິສຸດ ແລະ ຖືກຕ້ອງ​ແທ້​ບໍ?<verse eid="PRO 20:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ສ້າງ​ສອງ​ຢ່າງ​ຄື</para>
  <para style="q2" vid="PRO 20:12">ຫູ​ທີ່​ໄດ້​ຍິນ ແລະ ຕາ​ທີ່​ເບິ່ງເຫັນ.<verse eid="PRO 20:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />ຢ່າ​ຮັກ​ການ​ນອນ ເພາະ​ເຈົ້າ​ຈະ​ທຸກຍາກ;</para>
  <para style="q2" vid="PRO 20:13">ຈົ່ງ​ຕື່ນ​ແລ້ວ​ເຈົ້າ​ຈະ​ມີ​ອາຫານ​ເຫລືອ​ເກັບ​ໄວ້.<verse eid="PRO 20:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />ຄົນ​ຊື້​ເວົ້າ​ວ່າ, “ສິນຄ້າ​ບໍ່​ດີ! ສິນຄ້າ​ບໍ່​ດີ!”</para>
  <para style="q2" vid="PRO 20:14">ແຕ່​ພໍ​ອອກ​ໄປ ແລະ ກໍ​ໄປ​ເວົ້າ​ໂອ້ອວດ​ກ່ຽວກັບ​ສິນຄ້າ​ທີ່​ຕົນ​ໄດ້​ຊື້​ມາ.<verse eid="PRO 20:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />ມີ​ຄໍາ, ແລະ ເພັດພອຍ​ຢ່າງ​ຫລວງຫລາຍ,</para>
  <para style="q2" vid="PRO 20:15">ແຕ່​ຮິມສົບ​ທີ່​ເວົ້າ​ດ້ວຍ​ຄວາມ​ຮູ້​ເປັນ​ເພັດ​ທີ່​ຫາ​ຍາກ.<verse eid="PRO 20:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />ຈົ່ງ​ຢຶດ​ເຄື່ອງນຸ່ງ​ຂອງ​ຜູ້​ທີ່​ຄ້ຳປະກັນ​ໃຫ້​ແກ່​ຄົນແປກໜ້າ;</para>
  <para style="q2" vid="PRO 20:16">ຈົ່ງ​ຢຶດ​ໄວ້​ເປັນ​ເຄື່ອງ​ມັດຈໍາ​ຖ້າ​ເຮັດ​ການ​ຄ້ຳປະກັນ​ໃຫ້​ຄົນ​ພາຍນອກ.<verse eid="PRO 20:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />ອາຫານ​ທີ່​ໄດ້​ມາ​ໂດຍ​ການ​ສໍ້ໂກງ​ກໍ​ມີ​ລົດ​ຫວານ​ດີ,</para>
  <para style="q2" vid="PRO 20:17">ແຕ່​ໃນທີ່ສຸດ​ມັນ​ກໍ​ກາຍ​ເປັນ​ຫີນແຮ່​ເຕັມ​ປາກ.<verse eid="PRO 20:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />ແຜນການ​ຈະ​ສຳເລັດ​ໄດ້​ກໍ​ໂດຍ​ການ​ຂໍ​ຄຳປຶກສາ;</para>
  <para style="q2" vid="PRO 20:18">ດັ່ງນັ້ນ ຖ້າ​ເຈົ້າ​ເຮັດ​ສົງຄາມ​ກໍ​ຕ້ອງ​ຂໍ​ຄໍາແນະນໍາ.<verse eid="PRO 20:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />ຄຳ​ນິນທາ​ກໍ​ທໍລະຍົດ​ຄວາມ​ໄວ້ວາງໃຈ;</para>
  <para style="q2" vid="PRO 20:19">ສະນັ້ນ ຈົ່ງ​ຫລີກໜີ​ຈາກ​ຄົນ​ທີ່​ເວົ້າ​ຫລາຍ​ເກີນໄປ.<verse eid="PRO 20:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />ຄົນ​ທີ່​ສາບ​ແຊ່ງ​ພໍ່ ຫລື ແມ່​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 20:20">ຊີວິດ​ຂອງ​ພວກເຂົາ​ກໍ​ຈະ​ດັບ​ລົງ​ໃນ​ຂຸມ​ແຫ່ງ​ຄວາມ​ມືດ.<verse eid="PRO 20:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />ຊັບສົມບັດ​ທີ່​ຫາ​ມາ​ໄດ້​ຢ່າງ​ວ່ອງໄວ</para>
  <para style="q2" vid="PRO 20:21">ຈະ​ບໍ່​ເປັນ​ພຣະພອນ​ໃນ​ບັ້ນ​ປາຍ.<verse eid="PRO 20:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />ຢ່າ​ເວົ້າ​ວ່າ “ຂ້ອຍ​ຈະ​ແກ້ແຄ້ນ​ເຈົ້າ​ສຳລັບ​ຄວາມ​ຜິດ​ຄັ້ງ​ນີ້!”</para>
  <para style="q2" vid="PRO 20:22">ຈົ່ງ​ຄອຍຖ້າ​ພຣະເຈົ້າ​ຢາເວ, ແລະ ພຣະອົງ​ຈະ​ແກ້ແຄ້ນ​ແທນ​ເຈົ້າ.<verse eid="PRO 20:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />ພຣະເຈົ້າ​ຢາເວ​ກຽດຊັງ​ເຄື່ອງ​ຊັ່ງ​ບໍ່​ທ່ຽງທໍາ,</para>
  <para style="q2" vid="PRO 20:23">ແລະ ພຣະອົງ​ບໍ່​ພໍໃຈ​ນໍາ​ຕາຊິງ​ທີ່​ບໍ່ສັດຊື່.<verse eid="PRO 20:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />ພຣະເຈົ້າ​ຢາເວ​ເປັນ​ຜູ້​ກຳນົດ​ບາດ​ກ້າວ​ຂອງ​ມະນຸດ</para>
  <para style="q2" vid="PRO 20:24">ແລ້ວ​ຈະ​ມີ​ຜູ້ໃດ​ແດ່​ເຂົ້າໃຈ​ທາງ​ຂອງ​ຕົນ​ໄດ້?<verse eid="PRO 20:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />ການ​ອຸທິດ​ຖວາຍ​ບາງສິ່ງ​ບາງຢ່າງ​ໂດຍ​ບໍ່​ຄິດ​ກໍ​ເປັນ​ບ້ວງແຮ້ວ​ໃສ່​ຕົນ</para>
  <para style="q2" vid="PRO 20:25">ແລະ ຕໍ່​ມາ​ຈຶ່ງ​ຄິດ​ໄດ້​ເມື່ອ​ສາບານ​ໄປ​ແລ້ວ.<verse eid="PRO 20:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />ກະສັດ​ທີ່​ມີ​ປັນຍາ​ຝັດ​ຮ່ອນ​ຄົນ​ຊົ່ວຮ້າຍ​ໃຫ້​ອອກ​ມາ;</para>
  <para style="q2" vid="PRO 20:26">ແລະ ເພິ່ນ​ຂັດສັນ​ພວກເຂົາ​ດ້ວຍ​ລໍ້​ນວດເຂົ້າ.<verse eid="PRO 20:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />ຈິດ​ວິນຍານ<note caller="+" style="f"><char style="fr" closed="false">20:27 </char><char style="ft" closed="false">ຫລື ຖ້ອຍ​ຄຳ</char></note> ຂອງ​ມະນຸດ​ເປັນ​ຕະກຽງ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q2" vid="PRO 20:27">ທີ່​ສ່ອງ​ແຈ້ງ​ໃຫ້​ເຫັນ​ເຖິງ​ສ່ວນ​ພາຍໃນ​ທີ່​ເລິກ​ທີ່ສຸດ​ຂອງ​ຄົນ.<verse eid="PRO 20:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />ຄວາມ​ຮັກ ແລະ ຄວາມ​ສັດຊື່​ຮັກສາ​ກະສັດ​ໄວ້​ຢ່າງ​ປອດໄພ;</para>
  <para style="q2" vid="PRO 20:28">ແລະ ບັນລັງ​ຂອງ​ເພິ່ນ​ຕັ້ງ​ຢູ່​ຢ່າງ​ໝັ້ນຄົງ​ໂດຍ​ຄວາມ​ຮັກ.<verse eid="PRO 20:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />ກຽດ​ສັກສີ​ຂອງ​ຄົນໜຸ່ມ​ແມ່ນ​ກໍາລັງ​ຂອງ​ລາວ,</para>
  <para style="q2" vid="PRO 20:29">ແຕ່​ຄວາມ​ສະຫງ່າງາມ​ຂອງ​ຜູ້ເຖົ້າ​ແມ່ນ​ຜົມຫງອກ.<verse eid="PRO 20:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />ບາດແຜ ແລະ ການ​ຂ້ຽນຕີ​ກຳຈັດ​ຄວາມ​ຊົ່ວ​ອອກ​ໄປ,</para>
  <para style="q2" vid="PRO 20:30">ແລະ ການ​ຂ້ຽນຕີ​ກໍ​ຊໍາລະ​ສ່ວນ​ທີ່​ເລິກ​ທີ່​ສຸດ.<verse eid="PRO 20:30" /></para>
  <para style="b" />
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />ຈິດໃຈ​ຂອງ​ກະສັດ​ຢູ່​ໃນ​ມື​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ເປັນ​ດັ່ງ​ສາຍ​ນ້ຳ​ໄຫລ</para>
  <para style="q2" vid="PRO 21:1">ທີ່​ພຣະອົງ​ນຳ​ໄປ​ຫາ​ທຸກຄົນ​ທີ່​ພຣະອົງ​ພໍໃຈ.<verse eid="PRO 21:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />ມະນຸດ​ອາດ​ຈະ​ຄິດ​ວ່າ​ທາງ​ທັງໝົດ​ຂອງ​ຕົນ​ນັ້ນ​ຖືກຕ້ອງ,</para>
  <para style="q2" vid="PRO 21:2">ແຕ່​ພຣະເຈົ້າ​ຢາເວ​ຢັ່ງ​ເບິ່ງ​ຈິດໃຈ.<verse eid="PRO 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />ການ​ເຮັດ​ສິ່ງ​ທີ່​ຖືກຕ້ອງ ແລະ ຍຸຕິທຳ​ນັ້ນ</para>
  <para style="q2" vid="PRO 21:3">ກໍ​ໄດ້​ຮັບ​ການ​ຍອມຮັບ​ຈາກ​ພຣະເຈົ້າ​ຢາເວ​ຫລາຍ​ກວ່າ​ການ​ຖວາຍ​ເຄື່ອງບູຊາ.<verse eid="PRO 21:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />ຕາ​ທີ່​ຍິ່ງ​ຈອງຫອງ ແລະ ໃຈ​ໂອ້ອວດ</para>
  <para style="q2" vid="PRO 21:4">ເປັນ​ເໝືອນ​ທົ່ງນາ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ທີ່​ບໍ່​ໄດ້​ໄຖ ທັງ​ສອງ​ສິ່ງ​ນີ້​ແມ່ນ​ຄວາມ​ບາບ.<verse eid="PRO 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />ແຜນການ​ຂອງ​ຄົນ​ດຸໝັ່ນ​ນຳ​ຜົນ​ກຳໄລ​ມາ​ໃຫ້​ສັນໃດ</para>
  <para style="q2" vid="PRO 21:5">ແຜນການ​ທີ່​ຟ້າວຟັ່ງ​ນຳ​ຄວາມ​ທຸກຍາກ​ມາ​ໃຫ້​ສັນນັ້ນ.<verse eid="PRO 21:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />ຊັບສົມບັດ​ທີ່​ໄດ້​ມາ​ຈາກ​ການ​ຕົວະ</para>
  <para style="q2" vid="PRO 21:6">ເປັນ​ດັ່ງ​ອາຍນ້ຳ​ທີ່​ຫາຍ​ໄປ​ຢ່າງ​ວ່ອງໄວ ແລະ ເປັນ​ດັ່ງ​ບ້ວງແຮ້ວ​ແຫ່ງ​ຄວາມ​ຕາຍ.<note caller="+" style="f"><char style="fr" closed="false">21:6 </char><char style="ft" closed="false">ສຳ​ເນົາ​ຕົ້ນ​ສະບັບ​ພາສາ​ເຮັບເຣີ​ສ່ວນ​ໃຫຍ່​ວ່າ </char><char style="fqa" closed="false">ໝອກ​ຄວັນ </char><char style="ft" closed="false">ສຳລັບ​ຄົນທີ່​ເສາະ​ສະແຫວງຫາ​ຄວາມ​ຕາຍ</char></note><verse eid="PRO 21:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />ຄວາມ​ຮຸນແຮງ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ຈະ​ລາກ​ພວກເຂົາ​ໄປ,</para>
  <para style="q2" vid="PRO 21:7">ເພາະ​ພວກເຂົາ​ບໍ່​ຍອມ​ເຮັດ​ສິ່ງ​ທີ່​ຖືກຕ້ອງ.<verse eid="PRO 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />ທາງ​ຂອງ​ຄົນ​ທີ່​ເຮັດ​ຜິດ​ນັ້ນ​ກໍ​ຄົດລ້ຽວ,</para>
  <para style="q2" vid="PRO 21:8">ແຕ່​ການ​ປະພຶດ​ຂອງ​ຄົນ​ບໍລິສຸດ​ນັ້ນ​ກໍ​ທ່ຽງທຳ.<verse eid="PRO 21:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />ອາໄສ​ຢູ່​ເທິງ​ຫລັງຄາ​ເຮືອນ</para>
  <para style="q2" vid="PRO 21:9">ກໍ​ດີ​ກວ່າ​ຢູ່​ໃນ​ເຮືອນ​ຮ່ວມ​ກັບ​ເມຍ​ທີ່​ມັກ​ຜິດຖຽງ​ກັນ.<verse eid="PRO 21:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />ຄົນ​ຊົ່ວຮ້າຍ​ປາຖະໜາ​ຄວາມ​ຊົ່ວ;</para>
  <para style="q2" vid="PRO 21:10">ເພື່ອນບ້ານ​ບໍ່​ໄດ້​ຮັບ​ຄວາມ​ເມດຕາ​ຈາກ​ພວກເຂົາ.<verse eid="PRO 21:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />ເມື່ອ​ຄົນ​ມັກ​ເຢາະເຢີ້ຍ​ຖືກ​ລົງໂທດ, ຜູ້​ທີ່​ບໍ່ຮູ້ຈັກຄິດ​ກໍ​ຈະ​ມີ​ປັນຍາ​ເພີ່ມ​ຂຶ້ນ;</para>
  <para style="q2" vid="PRO 21:11">ການ​ໃຫ້​ຄວາມ​ສົນໃຈ​ນຳ​ຄົນ​ມີ​ປັນຍາ​ພວກເຂົາ​ກໍ​ໄດ້​ຄວາມ​ຮູ້.<verse eid="PRO 21:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />ພຣະເຈົ້າ​ອົງ​ຊອບທຳ<note caller="+" style="f"><char style="fr" closed="false">21:12 </char><char style="ft" closed="false">ຫລື ຄົນ </char><char style="fqa" closed="false">ຊອບ </char><char style="ft" closed="false">ທຳ</char></note> ເຝົ້າ​ເບິ່ງ​ເຮືອນ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ</para>
  <para style="q2" vid="PRO 21:12">ແລະ ນຳ​ຄວາມ​ຈິບຫາຍ​ມາ​ສູ່​ພວກເຂົາ.<verse eid="PRO 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />ຜູ້​ທີ່​ປິດ​ຫູ​ບໍ່​ຟັງ​ສຽງ​ຮ້ອງໄຫ້​ຂອງ​ຄົນ​ທຸກຍາກ</para>
  <para style="q2" vid="PRO 21:13">ກໍ​ຈະ​ຮ້ອງໄຫ້ ແລະ ບໍ່​ໄດ້​ຮັບ​ຄຳ​ຕອບ​ເໝືອນ​ກັນ.<verse eid="PRO 21:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />ຂອງຂັວນ​ທີ່​ໃຫ້​ຢ່າງ​ລັບໆ​ເຮັດ​ໃຫ້​ຄວາມ​ໃຈຮ້າຍ​ຫລຸດລົງ,</para>
  <para style="q2" vid="PRO 21:14">ສິນບົນ​ທີ່​ເຊື່ອງ​ໄວ້​ຢູ່​ໃນ​ກະເປົ໋າ​ກໍ​ຈະ​ຫລຸດ​ຜ່ອນ​ຄວາມ​ໂມໂຫ​ຮ້າຍ​ລົງ.<verse eid="PRO 21:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />ເມື່ອ​ໄດ້​ຮັບ​ຄວາມ​ຍຸຕິທຳ, ມັນ​ກໍ​ຈະ​ນໍາ​ຄວາມ​ຊື່ນຊົມຍິນດີ​ມາ​ໃຫ້​ຄົນ​ຊອບທຳ</para>
  <para style="q2" vid="PRO 21:15">ແຕ່​ຄວາມ​ຢ້ານ​ເປັນ​ຂອງ​ຜູ້​ທີ່​ເຮັດ​ຊົ່ວ.<verse eid="PRO 21:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />ຜູ້​ທີ່​ຫັນ​ໜີ​ໄປ​ຈາກ​ທາງ​ແຫ່ງ​ຄວາມ​ເຂົ້າໃຈ</para>
  <para style="q2" vid="PRO 21:16">ຈະ​ໄປ​ພັກຜ່ອນ​ໃນ​ໝູ່​ຄົນຕາຍ.<verse eid="PRO 21:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />ຜູ້​ທີ່​ຮັກ​ຄວາມ​ສະໜຸກ​ຈະ​ທຸກຍາກ</para>
  <para style="q2" vid="PRO 21:17">ຜູ້​ທີ່​ຮັກ​ເຫລົ້າ​ອະງຸ່ນ ແລະ ນ້ຳ​ມັນ​ໝາກກອກ​ຈະ​ບໍ່​ຮັ່ງມີ​ຈັກ​ເທື່ອ.<verse eid="PRO 21:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />ຄົນ​ຊົ່ວຮ້າຍ​ກາຍ​ເປັນ​ຄ່າ​ໄຖ່​ໃຫ້​ຄົນ​ຊອບທຳ,</para>
  <para style="q2" vid="PRO 21:18">ຄົນ​ບໍ່​ສັດຊື່​ເປັນ​ຄ່າ​ໄຖ່​ໃຫ້​ຄົນ​ທ່ຽງ​ທຳ.<verse eid="PRO 21:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />ອາໄສ​ຢູ່​ໃນ​ຖິ່ນແຫ້ງແລ້ງກັນດານ</para>
  <para style="q2" vid="PRO 21:19">ກໍ​ດີ​ກວ່າ​ຢູ່​ກັບ​ເມຍ​ທີ່​ມັກ​ທະເລາະ​ວິວາດ ແລະ ມັກ​ຈົ່ມ.<verse eid="PRO 21:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />ຄົນ​ມີ​ປັນຍາ​ສະສົມ​ອາຫານ​ຊັ້ນ​ດີ<note caller="+" style="f"><char style="fr" closed="false">21:20 </char><char style="ft" closed="false">ຫລື ອາຫານ ແລະ ນ້ຳ​ມັນ​ມະ​ກອກ</char></note>​ແລະ ນ້ຳມັນ​ໝາກກອກ​ໄວ້.</para>
  <para style="q2" vid="PRO 21:20">ແຕ່​ຄົນ​ໂງ່ຈ້າ​ກິນ​ສິ່ງ​ທີ່​ມີ​ຈົນ​ໝົດກ້ຽງ.<verse eid="PRO 21:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />ຜູ້​ທີ່​ຕິດຕາມ​ຄວາມ​ຊອບທຳ ແລະ ຄວາມ​ຮັກ</para>
  <para style="q2" vid="PRO 21:21">ກໍ​ພົບ​ຊີວິດ, ຄວາມ​ຈະເລີນ​ຮຸ່ງເຮືອງ<note caller="+" style="f"><char style="fr" closed="false">21:21 </char><char style="ft" closed="false">ຫລື ຄວາມ </char><char style="fqa" closed="false">ຊອບ </char><char style="ft" closed="false">ທຳ</char></note> ແລະ ກຽດຕິຍົດ.<verse eid="PRO 21:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />ຄົນ​ມີ​ປັນຍາ​ສາມາດ​ໂຈມຕີ​ເມືອງ​ທີ່​ເຂັ້ມແຂງ</para>
  <para style="q2" vid="PRO 21:22">ແລະ ພັງ​ທະລາຍ​ຖານ​ທີ່​ໝັ້ນ​ທີ່​ພວກເຂົາ​ໄວ້ວາງໃຈ.<verse eid="PRO 21:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />ຜູ້​ທີ່​ລະວັງ​ປາກ ແລະ ລີ້ນ​ຂອງ​ຕົນ</para>
  <para style="q2" vid="PRO 21:23">ກໍ​ປ້ອງກັນ​ຕົນ​ຈາກ​ຄວາມ​ຈິບຫາຍ.<verse eid="PRO 21:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />ຄົນ​ຈອງ​ຫອງ ແລະ ຄົນ​ໂອ້ອວດ​ມີ​ຊື່​ວ່າ “ຄົນ​ມັກ​ເຢາະເຢີ້ຍ”</para>
  <para style="q2" vid="PRO 21:24">ການ​ປະພຶດ​ຂອງ​ລາວ​ລ້ວນ​ແຕ່​ອວດດີ.<verse eid="PRO 21:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />ຄວາມ​ຢາກ​ຂອງ​ຄົນ​ຂີ້ຄ້ານ​ຈະ​ຂ້າ​ລາວ​ໃຫ້​ຕາຍ,</para>
  <para style="q2" vid="PRO 21:25">ເພາະ​ລາວ​ບໍ່​ຍອມ​ລົງ​ມື​ເຮັດວຽກ.<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />ລາວ​ປາຖະໜາ​ຢາກ​ໄດ້​ຫລາຍ​ຂຶ້ນ​ຢູ່​ທຸກ​ມື້,</para>
  <para style="q2" vid="PRO 21:26">ແຕ່​ຄົນ​ຊອບທຳ​ເອົາ​ໃຫ້​ໂດຍ​ບໍ່​ຂາດ​ເຂີນ.<verse eid="PRO 21:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />ເຄື່ອງບູຊາ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ນັ້ນ​ເປັນ​ໜ້າລັງກຽດ</para>
  <para style="q2" vid="PRO 21:27">ໂດຍ​ສະເພາະ​ເມື່ອ​ລາວ​ນຳ​ມາ​ດ້ວຍ​ເຈດຕະນາ​ຊົ່ວ!<verse eid="PRO 21:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />ພະຍານ​ທີ່​ບໍ່​ຈິງ​ຈະ​ຈິບຫາຍ​ໄປ,</para>
  <para style="q2" vid="PRO 21:28">ແຕ່​ຄົນ​ທີ່​ຟັງ​ຢ່າງ​ລະມັດລະວັງ​ຈະ​ເປັນ​ພະຍານ​ທີ່​ໜ້າເຊື່ອຖື​ໄດ້.<verse eid="PRO 21:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />ຄົນ​ຊົ່ວຮ້າຍ​ຢືນຢັນ​ຢ່າງ​ກ້າຫານ,</para>
  <para style="q2" vid="PRO 21:29">ແຕ່​ຄົນ​ສະຫລາດ​ຄິດ​ເຖິງ​ວິຖີທາງ​ຂອງ​ຕົນ.<verse eid="PRO 21:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />ບໍ່​ມີ​ປັນຍາ, ຄວາມ​ເຂົ້າໃຈ, ແຜນການ​ອັນໃດ</para>
  <para style="q2" vid="PRO 21:30">ທີ່​ສາມາດ​ຕໍ່ສູ້​ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ສຳເລັດ.<verse eid="PRO 21:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />ມ້າ​ຕຽມ​ພ້ອມ​ໄວ້​ສຳລັບ​ມື້​ສູ້ຮົບ,</para>
  <para style="q2" vid="PRO 21:31">ແຕ່​ໄຊຊະນະ​ກໍ​ຢູ່​ນໍາ​ພຣະເຈົ້າ​ຢາເວ.<verse eid="PRO 21:31" /></para>
  <para style="b" />
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />ຊື່ສຽງ​ດີ​ກໍ​ເປັນ​ທີ່​ຕ້ອງການ​ຫລາຍ​ກວ່າ​ຄວາມ​ຮັ່ງມີ;</para>
  <para style="q2" vid="PRO 22:1">ໄດ້​ຮັບ​ການ​ຍ້ອງຍໍ​ກໍ​ດີ​ກວ່າ​ໄດ້​ເງິນ ຫລື ຄໍາ.<verse eid="PRO 22:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />ຄົນ​ຮັ່ງມີ ແລະ ຄົນ​ທຸກຍາກ​ມີ​ສິ່ງ​ໜຶ່ງ​ທີ່​ຄື​ກັນ​ຄື:</para>
  <para style="q2" vid="PRO 22:2">ພຣະເຈົ້າ​ຢາເວ​ເປັນ​ຜູ້​ສ້າງ​ຂອງ​ພວກເຂົາ​ທັງໝົດ.<verse eid="PRO 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />ຄົນ​ສະຫລາດ​ເຫັນ​ໄພ​ອັນຕະລາຍ ແລະ ເຂົ້າ​ໄປ​ລີ້ໄພ,</para>
  <para style="q2" vid="PRO 22:3">ແຕ່​ຜູ້​ທີ່​ບໍ່​ຮູ້ຈັກ​ຄິດ​ກໍ​ຍ່າງ​ຕໍ່ໄປ ແລະ ໄດ້​ຮັບ​ໂທດ.<verse eid="PRO 22:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />ຄວາມ​ຖ່ອມຕົວ​ຄື​ການ​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ;</para>
  <para style="q2" vid="PRO 22:4">ຄ່າຈ້າງ​ຂອງ​ຄວາມ​ຖ່ອມຕົວ​ຄື ຄວາມ​ຮັ່ງມີ, ກຽດຕິຍົດ ແລະ ຊີວິດ.<verse eid="PRO 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />ທາງ​ຂອງ​ຄົນ​ຊົ່ວຮ້າຍ​ເປັນ​ບ້ວງແຮ້ວ ແລະ ເປັນ​ກັບດັກ,</para>
  <para style="q2" vid="PRO 22:5">ແຕ່​ຄົນ​ທີ່​ຮັກສາ​ຊີວິດ​ຂອງ​ຕົນ​ຈະ​ຫລີກ​ໜີ​ຈາກ​ສິ່ງ​ເຫລົ່າ​ນັ້ນ.<verse eid="PRO 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />ຈົ່ງ​ເລີ່ມ​ອົບຮົມ​ເດັກນ້ອຍ​ໃນ​ທາງ​ທີ່​ພວກເຂົາ​ຄວນ​ຈະ​ໄປ,<note caller="+" style="f"><char style="fr" closed="false">22:6 </char><char style="ft" closed="false">ຫລື ຈົ່ງ​ໃຫ້​ເດັກ​ເລີ່ມ​ຕົ້ນ​ໄປ​ໃນ​ທາງ​ທີ່​ຄວນ</char></note></para>
  <para style="q2" vid="PRO 22:6">ແລະ ເມື່ອ​ພວກເຂົາ​ໃຫຍ່​ຂຶ້ນ ພວກເຂົາ​ຈະ​ບໍ່​ຫັນ​ໜີ​ຈາກ​ທາງ​ນັ້ນ.<verse eid="PRO 22:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />ຄົນ​ຮັ່ງມີ​ປົກຄອງ​ຄົນ​ທຸກຈົນ,</para>
  <para style="q2" vid="PRO 22:7">ແລະ ຄົນ​ທີ່​ເປັນ​ໜີ້​ກໍ​ເປັນ​ຂ້າທາດ​ຂອງ​ເຈົ້າ​ໜີ້.<verse eid="PRO 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />ຜູ້​ທີ່​ຫວ່ານ​ຄວາມ​ບໍ່​ຍຸຕິທໍາ​ກໍ​ເກັບກ່ຽວ​ໄພພິບັດ,</para>
  <para style="q2" vid="PRO 22:8">ແລະ ໄມ້ແສ້​ຄື​ອຳນາດ​ທີ່​ພວກເຂົາ​ໃຊ້​ກົດຂີ່​ຄົນ​ອື່ນ​ຈະ​ຖືກ​ທຳລາຍ.<verse eid="PRO 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />ຄວາມສຸກ​ເປັນ​ຂອງ​ຄົນ​ໃຈ​ກວ້າງ,</para>
  <para style="q2" vid="PRO 22:9">ເພາະ​ພວກເຂົາ​ແບ່ງປັນ​ອາຫານ​ຂອງ​ຕົນ​ໃຫ້​ຄົນ​ທຸກຍາກ.<verse eid="PRO 22:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />ຈົ່ງ​ໄລ່​ຄົນ​ມັກ​ເຢາະເຢີ້ຍ​ອອກ​ໄປ, ແລະ ການ​ຜິດຖຽງ​ກັນ​ກໍ​ຈະ​ບໍ່ມີ;</para>
  <para style="q2" vid="PRO 22:10">ການ​ສຽດສີ ແລະ ການ​ໝິ່ນປະໝາດ​ຈະ​ຈົບ​ລົງ.<verse eid="PRO 22:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />ຜູ້​ທີ່​ຮັກ​ຈິດໃຈ​ທີ່​ບໍລິສຸດ ແລະ ເວົ້າ​ຈາ​ອ່ອນຫວານ</para>
  <para style="q2" vid="PRO 22:11">ຈະ​ມີ​ໝູ່​ເປັນ​ກະສັດ.<verse eid="PRO 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />ຕາ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ເຝົ້າ​ຮັກສາ​ຄວາມ​ຮູ້​ໄວ້,</para>
  <para style="q2" vid="PRO 22:12">ແຕ່​ພຣະອົງ​ທໍາລາຍ​ຄຳເວົ້າ​ຂອງ​ຄົນ​ບໍ່​ສັດຊື່.<verse eid="PRO 22:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />ຄົນ​ຂີ້ຄ້ານ​ເວົ້າ​ວ່າ “ມີ​ໂຕສິງ​ຢູ່​ຂ້າງ​ນອກ!”</para>
  <para style="q2" vid="PRO 22:13">“ຂ້ອຍ​ຈະ​ຖືກ​ມັນ​ຂ້າ​ຢູ່​ກາງ​ທາງ​ກໍ​ໄດ້!”<verse eid="PRO 22:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />ປາກ​ຂອງ​ຍິງ​ຫລິ້ນຊູ້​ເປັນ​ດັ່ງ​ຂຸມ​ເລິກ;</para>
  <para style="q2" vid="PRO 22:14">ຄົນ​ທີ່​ຖືກ​ພຣະເຈົ້າ​ຢາເວ​ໂກດຮ້າຍ​ຈະ​ຕົກ​ລົງ​ໄປ​ໃນ​ຂຸມ​ນັ້ນ.<verse eid="PRO 22:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />ຄວາມ​ໂງ່ຈ້າ​ຝັງ​ໄວ້​ຢູ່​ໃນ​ໃຈ​ຂອງ​ເດັກນ້ອຍ,</para>
  <para style="q2" vid="PRO 22:15">ແຕ່​ໄມ້ແສ້​ທີ່​ຕີສອນ​ຈະ​ຊ່ວຍ​ໄລ່​ມັນ​ອອກ​ໄປ.<verse eid="PRO 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />ຜູ້​ທີ່​ກົດຂີ່​ຂົ່ມເຫັງ​ຄົນ​ທຸກຍາກ​ເພື່ອ​ໃຫ້​ຕົນເອງ​ຮັ່ງມີ​ຂຶ້ນ.</para>
  <para style="q2" vid="PRO 22:16">ແລະ ຜູ້​ທີ່​ເອົາ​ຂອງຂັວນ​ໃຫ້​ຄົນ​ຮັ່ງມີ ຈະ​ເຮັດ​ໃຫ້​ທັງ​ສອງ​ຄົນ​ທຸກ​ຈົນ​ລົງ.<verse eid="PRO 22:16" /></para>
  <para style="ms1">ຄຳສອນ 30 ຕອນ​ຂອງ​ຄົນ​ມີ​ປັນຍາ</para>
  <para style="s2">ຄໍາສອນ​ທີ 1</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />ຈົ່ງ​ຕັ້ງໃຈ ແລະ ຟັງ​ຄຳເວົ້າ​ຂອງ​ຄົນ​ມີ​ປັນຍາ</para>
  <para style="q2" vid="PRO 22:17">ແລະ ຈົ່ງ​ເອົາໃຈໃສ່​ໃນ​ສິ່ງ​ທີ່​ປັນຍາ​ສັ່ງສອນ,<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />ເພາະ​ມັນ​ຈະ​ເຮັດ​ໃຫ້​ເຈົ້າ​ສຸກ​ໃຈ ເມື່ອ​ເຈົ້າ​ຮັກສາ​ຄຳ​ສັ່ງສອນ​ນັ້ນ​ໄວ້​ໃນ​ໃຈ​ຂອງ​ເຈົ້າ.</para>
  <para style="q2" vid="PRO 22:18">ແລະ ມີ​ຄຳ​ສັ່ງສອນ​ທັງໝົດ​ຢູ່​ໃນ​ປາກ​ຂອງ​ເຈົ້າ.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />ເພື່ອ​ໃຫ້​ຄວາມ​ໄວ້ວາງໃຈ​ຂອງ​ເຈົ້າ​ຢູ່​ໃນ​ພຣະເຈົ້າ​ຢາເວ,</para>
  <para style="q2" vid="PRO 22:19">ເຮົາ​ສອນ​ເຈົ້າ​ໃນ​ມື້ນີ້, ແມ່ນແຕ່​ເຈົ້າ​ເອງ​ກໍ​ຄື​ກັນ.<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />ເຮົາ​ໄດ້​ຂຽນ​ຄຳສັ່ງສອນ​ສາມສິບ​ຕອນ​ໄວ້​ໃຫ້​ເຈົ້າ​ບໍ່ແມ່ນ​ບໍ,</para>
  <para style="q2" vid="PRO 22:20">ເປັນ​ຄຳ​ແນະນຳ ແລະ ຄວາມ​ຮູ້.<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />ສັ່ງສອນ​ເຈົ້າ​ໃຫ້​ເປັນ​ຄົນ​ສັດຊື່ ແລະ ເວົ້າ​ຄວາມຈິງ,</para>
  <para style="q2" vid="PRO 22:21">ເພື່ອ​ເຈົ້າ​ຈະ​ນໍາ​ຄວາມ​ຈິງ​ກັບ​ມາ​ລາຍງານ</para>
  <para style="q2" vid="PRO 22:21">ຜູ້​ທີ່​ໃຊ້​ເຈົ້າ​ໄປ?<verse eid="PRO 22:21" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 2</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />ຢ່າ​ເອົາ​ປຽບ​ຄົນ​ທຸກຈົນ ເພາະ​ພວກເຂົາ​ກໍ​ທຸກຈົນ​ຢູ່​ແລ້ວ</para>
  <para style="q2" vid="PRO 22:22">ແລະ ຢ່າ​ຢຽບຢໍ່າ​ຄົນ​ຂັດສົນ​ຢູ່​ໃນ​ສານ,<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />ເພາະ​ພຣະເຈົ້າ​ຢາເວ​ຈະ​ແກ້​ຄະດີ​ໃຫ້​ພວກເຂົາ</para>
  <para style="q2" vid="PRO 22:23">ແລະ ຈະ​ເອົາ​ຊີວິດ​ຂອງ​ຜູ້​ທີ່​ຈະ​ເອົາ​ຊີວິດ​ຂອງ​ພວກເຂົາ.<verse eid="PRO 22:23" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 3</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />ຢ່າ​ເປັນ​ໝູ່​ກັບ​ຄົນ​ໃຈ​ຮ້ອນ,</para>
  <para style="q2" vid="PRO 22:24">ຢ່າ​ຄົບ​ກັບ​ຄົນ​ທີ່​ໃຈຮ້າຍ​ງ່າຍ,<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />ເພາະ​ເຈົ້າ​ອາດ​ຈະ​ຮຽນ​ແບບ​ວິຖີທາງ​ຂອງ​ພວກເຂົາ</para>
  <para style="q2" vid="PRO 22:25">ແລະ ເຮັດ​ໃຫ້​ຕົນ​ເອງ​ຕົກ​ຢູ່​ໃນ​ບ້ວງແຮ້ວ.<verse eid="PRO 22:25" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 4</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />ຢ່າ​ເປັນ​ຜູ້​ທີ່​ຈັບ​ມື​ໃຫ້​ຄໍາສັນຍາ</para>
  <para style="q2" vid="PRO 22:26">ຫລື ຄ້ຳປະກັນ​ໃນ​ການ​ໃຊ້​ໜີ້​ຄົນ​ອື່ນ;<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />ຖ້າ​ເຈົ້າ​ບໍ່​ມີ​ເງິນ​ຈ່າຍ,</para>
  <para style="q2" vid="PRO 22:27">ແມ່ນແຕ່​ບ່ອນນອນ​ກໍ​ຈະ​ຖືກ​ດຶງ​ອອກ​ໄປ​ຈາກ​ຫລັງ​ຂອງ​ເຈົ້າ.<verse eid="PRO 22:27" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 5</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />ຢ່າ​ຍ້າຍ​ຫລັກ​ເຂດແດນ​ເກົ່າ</para>
  <para style="q2" vid="PRO 22:28">ທີ່​ບັນພະບຸລຸດ​ຂອງ​ເຈົ້າ​ໄດ້​ຕັ້ງ​ໄວ້.<verse eid="PRO 22:28" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 6</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />ເຈົ້າ​ເຫັນ​ຄົນ​ທີ່​ມີ​ຄວາມ​ຊຳນານ​ໃນ​ວຽກງານ​ຂອງ​ພວກເຂົາ​ບໍ?</para>
  <para style="q2" vid="PRO 22:29">ພວກເຂົາ​ຈະ​ໄດ້​ຮັບໃຊ້​ກະສັດ;</para>
  <para style="q2" vid="PRO 22:29">ພວກເຂົາ​ຈະ​ບໍ່​ຮັບ​ໃຊ້​ຂ້າລາຊະການ​ຊັ້ນຕໍ່າ.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="s2">ຄໍາສອນ​ທີ 7</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />ເມື່ອ​ເຈົ້າ​ນັ່ງ​ກິນ​ເຂົ້າ​ກັບ​ຜູ້ປົກຄອງ,</para>
  <para style="q2" vid="PRO 23:1">ຈົ່ງ​ສັງເກດ​ເບິ່ງ​ສິ່ງ<note caller="+" style="f"><char style="fr" closed="false">23:1 </char><char style="ft" closed="false">ຫລື ຜູ້</char></note> ທີ່​ຢູ່​ຕໍ່ໜ້າ​ເຈົ້າ​ໃຫ້​ດີ,<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />ຖ້າ​ເຈົ້າ​ເປັນ​ຄົນ​ມັກ​ກິນ​ຫລາຍ,</para>
  <para style="q2" vid="PRO 23:2">ກໍ​ຈົ່ງ​ເອົາ​ມີດ​ຈີ້​ຄໍ​ຕົນເອງ​ໄວ້.<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />ຢ່າ​ໂລບມາກ​ໃນ​ອາຫານ​ທີ່​ດີ​ຂອງ​ລາວ,</para>
  <para style="q2" vid="PRO 23:3">ເພາະ​ອາຫານ​ນັ້ນ​ເປັນ​ສິ່ງ​ທີ່​ຫລອກລວງ.<verse eid="PRO 23:3" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 8</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />ຢ່າ​ອິດເມື່ອຍ​ອ່ອນ​ແຮງ​ເພື່ອ​ຢາກ​ຮັ່ງມີ;</para>
  <para style="q2" vid="PRO 23:4">ຢ່າ​ໄວ້​ວາງໃຈ​ໃນ​ຄວາມ​ເຂົ້າໃຈ​ຂອງ​ເຈົ້າ​ເອງ.<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />ຄວາມ​ຮັ່ງມີ​ກໍ​ຫາຍ​ໄປ​ໄດ້​ພຽງ​ແຕ່​ພັບຕາ​ດຽວ,</para>
  <para style="q2" vid="PRO 23:5">ເພາະ​ປີກ​ມັນ​ຈະ​ງອກ​ອອກ​ມາ</para>
  <para style="q2" vid="PRO 23:5">ແລະ ບິນ​ຂຶ້ນ​ສູ່​ທ້ອງຟ້າ​ເໝືອນ​ດັ່ງ​ນົກອິນຊີ.<verse eid="PRO 23:5" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 9</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />ຢ່າ​ກິນ​ອາຫານ​ຂອງ​ຄົນ​ທີ່​ຂີ້ຖີ່,</para>
  <para style="q2" vid="PRO 23:6">ຢ່າ​ໂລບມາກ​ໃນ​ອາຫານ​ດີ​ຂອງ​ລາວ​ທີ່​ເອົາ​ມາ​ໃຫ້;<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />ເພາະ​ລາວ​ເປັນ​ຄົນ​ປະເພດ</para>
  <para style="q2" vid="PRO 23:7">ທີ່​ຄິດ​ເລື່ອງ​ລາຄາ​ຢູ່​ໃນ​ໃຈ​ສະເໝີ.<note caller="+" style="f"><char style="fr" closed="false">23:7 </char><char style="ft" closed="false">ຫລື ເພາະ​ເມື່ອ​ເຂົາ​ຄິດ​ຢູ່​ໃນ​ໃຈ ດັ່ງນັ້ນ​ເຂົາ​ຈຶ່ງ​ກຳລັງ​ຄິດ​ລາ​ຄາ ຫລື ເພາະ​ເມື່ອ​ເຂົາ​ຈັດ​ງານ​ລ້ຽງ ດັ່ງນັ້ນ​ເຂົາ​ກຳລັງ​ຄິດ​ເລື່ອງ​ລາ​ຄາ</char></note></para>
  <para style="q1" vid="PRO 23:7">ລາວ​ເວົ້າ​ກັບ​ເຈົ້າ​ວ່າ, “ເຊີນ​ກິນ ແລະ ເຊີນ​ດື່ມ”</para>
  <para style="q2" vid="PRO 23:7">ແຕ່​ໃຈ​ຂອງ​ລາວ​ບໍ່​ໄດ້​ຄິດ​ແບບ​ນັ້ນ.<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />ເຈົ້າ​ຈະ​ຮາກ​ອາຫານ​ທີ່​ເຈົ້າ​ໄດ້​ກິນ​ເຂົ້າ​ໄປ​ອອກ​ມາ</para>
  <para style="q2" vid="PRO 23:8">ແລະ ຄໍາ​ຍ້ອງຍໍ​ຂອງ​ເຈົ້າ​ຈະ​ສູນເສຍ​ໄປ.<verse eid="PRO 23:8" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 10</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />ຢ່າ​ເວົ້າ​ກັບ​ຄົນ​ໂງ່ຈ້າ,</para>
  <para style="q2" vid="PRO 23:9">ເພາະ​ພວກເຂົາ​ຈະ​ດູໝິ່ນ​ຄຳ​ແນະນຳ​ທີ່​ສະຫລາດ​ຂອງ​ເຈົ້າ.<verse eid="PRO 23:9" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 11</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />ຢ່າ​ຍ້າຍ​ຫລັກ​ເຂດແດນ​ເກົ່າ</para>
  <para style="q2" vid="PRO 23:10">ຫລື ບຸກ​ຢຶດ​ທີ່ດິນ​ຂອງ​ລູກ​ກຳພ້າ,<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />ເພາະ​ຜູ້ປົກປ້ອງ​ຂອງ​ພວກເຂົາ​ກໍ​ເຂັ້ມແຂງ;</para>
  <para style="q2" vid="PRO 23:11">ພຣະອົງ​ຈະ​ສູ້​ຄະດີ​ກັບ​ເຈົ້າ​ແທນ​ພວກເຂົາ.<verse eid="PRO 23:11" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 12</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />ຈົ່ງ​ເອົາໃຈໃສ່​ຕໍ່​ຄຳສັ່ງສອນ</para>
  <para style="q2" vid="PRO 23:12">ແລະ ງ່ຽງ​ຫູ​ຟັງ​ຖ້ອຍຄຳ​ແຫ່ງ​ຄວາມ​ຮູ້.<verse eid="PRO 23:12" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 13</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />ຢ່າ​ລັງເລ​ໃນ​ການ​ຕີສອນ​ລູກ;</para>
  <para style="q2" vid="PRO 23:13">ຖ້າ​ເຈົ້າ​ລົງໂທດ​ພວກເຂົາ​ດ້ວຍ​ໄມ້ແສ້, ພວກເຂົາ​ຈະ​ບໍ່​ຕາຍ.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />ຈົ່ງ​ລົງໂທດ​ພວກເຂົາ​ດ້ວຍ​ໄມ້ແສ້</para>
  <para style="q2" vid="PRO 23:14">ແລະ ຊ່ວຍ​ພວກເຂົາ​ໃຫ້​ພົ້ນ​ຈາກ​ຄວາມ​ຕາຍ.<verse eid="PRO 23:14" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 14</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />ລູກ​ເອີຍ, ຖ້າ​ໃຈ​ຂອງ​ເຈົ້າ​ມີ​ປັນຍາ,</para>
  <para style="q2" vid="PRO 23:15">ຫົວໃຈ​ຂອງ​ພໍ່​ກໍ​ຈະ​ມີ​ຄວາມ​ຍິນດີ​ຫລາຍ;<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />ເມື່ອ​ປາກ​ຂອງ​ເຈົ້າ​ເວົ້າ​ສິ່ງ​ທີ່​ຖືກຕ້ອງ</para>
  <para style="q2" vid="PRO 23:16">ຈິດວິນຍານ​ຂອງ​ພໍ່​ກໍ​ຈະ​ຊື່ນຊົມຍິນດີ.<verse eid="PRO 23:16" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 15</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />ຢ່າ​ໃຫ້​ໃຈ​ຂອງ​ເຈົ້າ​ອິດສາ​ພວກ​ຄົນບາບ,</para>
  <para style="q2" vid="PRO 23:17">ແຕ່​ຈົ່ງ​ກະຕືລືລົ້ນ​ໃນ​ການ​ຢຳເກງ​ພຣະເຈົ້າຢາເວ​ຢູ່​ສະເໝີ.<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />ເພາະ​ມີ​ຄວາມ​ຫວັງ​ໃນ​ອະນາຄົດ​ສໍາລັບ​ເຈົ້າ​ຢ່າງ​ແນ່ນອນ,</para>
  <para style="q2" vid="PRO 23:18">ແລະ ຄວາມ​ຫວັງ​ຂອງ​ເຈົ້າ​ຈະ​ບໍ່​ສູນເສຍ​ໄປ.<verse eid="PRO 23:18" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 16</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />ລູກ​ເອີຍ, ຈົ່ງ​ຟັງ ແລະ ມີ​ປັນຍາ,</para>
  <para style="q2" vid="PRO 23:19">ຈົ່ງ​ຮັກສາ​ໃຈ​ຂອງ​ເຈົ້າ​ໃຫ້​ຢູ່​ໃນ​ທາງ​ທີ່​ຖືກຕ້ອງ​ດັ່ງ​ນີ້:<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />ຢ່າ​ຮ່ວມ​ວົງ​ກັບ​ຜູ້​ທີ່​ດື່ມ​ເຫລົ້າ​ໜັກ</para>
  <para style="q2" vid="PRO 23:20">ຫລື ຜູ້​ທີ່​ເຫັນ​ແກ່​ກິນ,<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />ເພາະ​ຄົນ​ຂີ້ເມົາ ແລະ ຄົນ​ໂລບມາກ​ຈະ​ກາຍເປັນ​ຄົນ​ທຸກຍາກ,</para>
  <para style="q2" vid="PRO 23:21">ແລະ ຖ້າ​ມີ​ແຕ່​ນອນ​ຈະ​ເຮັດ​ໃຫ້​ພວກເຂົາ​ນຸ່ງ​ເຄື່ອງ​ຂາດ.<verse eid="PRO 23:21" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 17</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />ຈົ່ງ​ຟັງ​ຄວາມ​ພໍ່​ຂອງ​ເຈົ້າ, ຜູ້​ທີ່​ໃຫ້​ຊີວິດ​ແກ່​ເຈົ້າ,</para>
  <para style="q2" vid="PRO 23:22">ແລະ ຢ່າ​ດູໜິ່ນ​ແມ່​ຂອງ​ເຈົ້າ​ເມື່ອ​ເພິ່ນ​ເຖົ້າແກ່.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />ຈົ່ງ​ຊື້​ຄວາມ​ຈິງ ແລະ ຢ່າ​ຂາຍ​ສິ່ງ​ເຫລົ່ານີ້​ຄື:</para>
  <para style="q2" vid="PRO 23:23">ປັນຍາ, ຄຳສັ່ງສອນ<note caller="+" style="f"><char style="fr" closed="false">23:23 </char><char style="ft" closed="false">ຫລື ວິ​ໄນ</char></note> ແລະ ຄວາມ​ເຂົ້າໃຈ.<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />ພໍ່​ທີ່​ມີ​ລູກ​ເປັນ​ຄົນ​ຊອບທຳ​ກໍ​ມີ​ຄວາມ​ສຸກ​ຫລາຍ;</para>
  <para style="q2" vid="PRO 23:24">ພໍ່​ທີ່​ມີ​ລູກ​ມີ​ປັນຍາ​ກໍ​ພູມ​ໃຈ​ໃນ​ຕົວ​ລາວ.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />ຈົ່ງ​ເຮັດ​ໃຫ້​ພໍ່​ແມ່​ຂອງ​ເຈົ້າ​ມີ​ຄວາມ​ຊື່ນຊົມ​ຍິນດີ;</para>
  <para style="q2" vid="PRO 23:25">ຈົ່ງ​ເຮັດ​ໃຫ້​ແມ່​ຜູ້​ທີ່​ເກີດ​ເຈົ້າ​ມີ​ຄວາມ​ສຸກ!<verse eid="PRO 23:25" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 18</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />ລູກ​ເອີຍ, ຂໍ​ໃຈ​ຂອງ​ເຈົ້າ​ໃຫ້​ເຮົາ</para>
  <para style="q2" vid="PRO 23:26">ແລະ ຈົ່ງ​ໃຫ້​ຕາ​ຂອງ​ເຈົ້າ​ຍິນດີ​ໃນ​ທາງ​ຂອງ​ເຮົາ,<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />ເພາະ​ຍິງ​ຫລິ້ນຊູ້​ເປັນ​ດັ່ງ​ຂຸມ​ເລິກ,</para>
  <para style="q2" vid="PRO 23:27">ແລະ ເມຍ​ທີ່​ເອົາ​ແຕ່​ໃຈ​ເປັນ​ນໍ້າສ້າງ​ແຄບໆ.<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />ນາງ​ນອນ​ໝອບ​ລໍຖ້າ​ຢູ່​ຄື​ໂຈນ</para>
  <para style="q2" vid="PRO 23:28">ແລະ ເຮັດ​ໃຫ້​ຊາຍ​ຫລາຍ​ຄົນ​ບໍ່​ສັດຊື່​ຕໍ່​ເມຍ​ຂອງ​ຕົນ.<verse eid="PRO 23:28" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 19</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />ຜູ້​ໃດ​ທີ່​ທຸກ​ທໍລະມານ? ຜູ້ໃດ​ທີ່​ໂສກ​ເສົ້າ?</para>
  <para style="q2" vid="PRO 23:29">ຜູ້​ໃດ​ທີ່​ຜິດຖຽງ​ກັນ? ຜູ້​ໃດ​ທີ່​ຈົ່ມທຸກ?</para>
  <para style="q2" vid="PRO 23:29">ຜູ້​ໃດ​ມີ​ຮອຍ​ຊໍ້າ​ດໍາ​ຂຽວ​ໂດຍ​ບໍ່​ຈຳເປັນ? ຜູ້​ໃດ​ທີ່​ມີ​ຕາ​ແດງ​ກ່ຳ?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />ກໍ​ຄື​ຄົນ​ທີ່​ມົວເມົາ​ຢູ່​ກັບ​ເຫລົ້າ,</para>
  <para style="q2" vid="PRO 23:30">ຄົນ​ທີ່​ລອງ​ຊີມ​ເຫລົ້າ​ປະສົມ​ກັນ​ຫລາຍ​ຊະນິດ​ຢູ່​ໃນ​ຖ້ວຍ.<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />ຢ່າ​ຈ້ອງ​ເບິ່ງ​ເຫລົ້າ​ອະງຸ່ນ​ທີ່​ມີ​ສີ​ແດງ,</para>
  <para style="q2" vid="PRO 23:31">ເມື່ອ​ມັນ​ເປັ່ງປະກາຍ​ຢູ່​ໃນ​ຈອກ,</para>
  <para style="q2" vid="PRO 23:31">ເມື່ອ​ດື່ມ​ມັນ​ລົງ​ໄປ​ກໍ​ລື່ນ​ຄໍ​ດີ!<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />ໃນ​ບັ້ນ​ປາຍ​ແລ້ວ ມັນ​ຕອດ​ຄື​ງູ</para>
  <para style="q2" vid="PRO 23:32">ແລະ ມີ​ພິດຮ້າຍ​ເໝືອນ​ງູ​ພິດ.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />ຕາ​ຂອງ​ເຈົ້າ​ຈະ​ເຫັນ​ພາບ​ແປກໆ,</para>
  <para style="q2" vid="PRO 23:33">ແລະ ຄວາມ​ຄິດ​ຂອງ​ເຈົ້າ​ຈະ​ຄິດ​ສິ່ງ​ທີ່​ສັບສົນ.<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />ເຈົ້າ​ຈະ​ເປັນ​ດັ່ງ​ຄົນ​ທີ່​ກໍາລັງ​ນອນ​ຢູ່​ກາງ​ທະເລ,</para>
  <para style="q2" vid="PRO 23:34">ແລະ ເປັນ​ດັ່ງ​ຄົນ​ທີ່​ກໍາລັງ​ນອນ​ຢູ່​ເທິງ​ຍອດ​ເສົາ​ຂອງ​ເຮືອໃບ.<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />ເຈົ້າ​ຈະ​ເວົ້າ​ວ່າ, “ພວກເຂົາ​ຕ່ອຍ​ຂ້ອຍ,</para>
  <para style="q2" vid="PRO 23:35">ແຕ່​ຂ້ອຍ​ບໍ່​ເຈັບ! ພວກເຂົາ​ຟາດ​ຂ້ອຍ,</para>
  <para style="q1" vid="PRO 23:35">ແຕ່​ຂ້ອຍ​ບໍ່​ຮູ້ສຶກ!</para>
  <para style="q2" vid="PRO 23:35">ເມື່ອໃດ​ຂ້ອຍ​ຈະ​ຕື່ນ​ຂຶ້ນ​ມາ ຂ້ອຍ​ຈະ​ໄປ​ດື່ມ​ອີກ”<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s2">ຄໍາສອນ​ທີ 20</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />ຢ່າ​ອິດສາ​ຄົນ​ຊົ່ວຮ້າຍ,</para>
  <para style="q2" vid="PRO 24:1">ຢ່າ​ປາຖະໜາ​ເປັນ​ໝູ່​ກັບ​ພວກເຂົາ;<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />ເພາະ​ໃຈ​ຂອງ​ພວກເຂົາ​ວາງ​ແຜນການ​ອັນ​ໂຫດຮ້າຍ,</para>
  <para style="q2" vid="PRO 24:2">ແລະ ປາກ​ຂອງ​ພວກເຂົາ​ເວົ້າ​ແຕ່​ເລື່ອງ​ທີ່​ເຮັດ​ໃຫ້​ເກີດ​ຄວາມ​ເດືອດຮ້ອນ.<verse eid="PRO 24:2" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 21</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />ເຮືອນ​ຖືກ​ສ້າງ​ຂຶ້ນ​ໂດຍ​ຄົນ​ມີ​ປັນຍາ,</para>
  <para style="q2" vid="PRO 24:3">ແລະ ຕັ້ງ​ຂຶ້ນ​ດ້ວຍ​ຄວາມ​ເຂົ້າໃຈ;<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />ດ້ວຍ​ຄວາມ​ຮູ້ ຫ້ອງ​ຕ່າງໆ​ໃນ​ເຮືອນ​ກໍ​ເຕັມ​ໄປ​ດ້ວຍ</para>
  <para style="q2" vid="PRO 24:4">ຊັບສົມບັດ​ທີ່​ຫາ​ຍາກ ແລະ ງົດງາມ,<verse eid="PRO 24:4" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 22</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />ຄົນ​ມີ​ປັນຍາ​ເອົາ​ຊະນະ​ດ້ວຍ​ອຳນາດ​ອັນ​ຍິ່ງໃຫຍ່,</para>
  <para style="q2" vid="PRO 24:5">ແລະ ຄົນ​ທີ່​ມີ​ຄວາມ​ຮູ້​ກໍ​ຮວບຮວມ​ກຳລັງ​ຂອງ​ຕົນ​ໄວ້.<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />ແນ່ນອນ​ວ່າ​ເຈົ້າ​ຕ້ອງການ​ຄໍາແນະນໍາ​ເມື່ອ​ເຮັດ​ສົງຄາມ,</para>
  <para style="q2" vid="PRO 24:6">ແລະ ຈະ​ໄດ້​ຮັບ​ໄຊຊະນະ​ກໍ​ໂດຍ​ການ​ມີ​ທີ່ປຶກສາ​ຫລາຍ​ຄົນ.<verse eid="PRO 24:6" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 23</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />ປັນຍາ​ຢູ່​ສູງ​ເກີນໄປ​ສຳລັບ​ຄົນ​ໂງ່ຈ້າ;</para>
  <para style="q2" vid="PRO 24:7">ພວກເຂົາ​ບໍ່​ຄວນ​ເປີດ​ປາກ​ເວົ້າ​ໃນ​ບ່ອນ​ຊຸມນຸມ​ທີ່​ປະຕູ​ເມືອງ.<verse eid="PRO 24:7" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 24</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />ຜູ້​ທີ່​ວາງ​ແຜນການ​ຊົ່ວຮ້າຍ</para>
  <para style="q2" vid="PRO 24:8">ຈະ​ຖືກ​ເອີ້ນ​ວ່າ ເປັນ​ຜູ້​ສ້າງ​ຄວາມ​ເດືອດຮ້ອນ.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />ແຜນການ​ແຫ່ງ​ຄວາມ​ໂງ່​ຄື​ບາບ,</para>
  <para style="q2" vid="PRO 24:9">ແລະ ປະຊາຊົນ​ກຽດຊັງ​ຄົນ​ມັກ​ເຢາະເຢີ້ຍ.<verse eid="PRO 24:9" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 25</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />ຖ້າ​ເຈົ້າ​ທໍ້ໃຈ​ໃນ​ເວລາ​ມີ​ບັນຫາ,</para>
  <para style="q2" vid="PRO 24:10">ກຳລັງ​ຂອງ​ເຈົ້າ​ກໍ​ໜ້ອຍ​ຫລາຍ!<verse eid="PRO 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />ຈົ່ງ​ຊ່ວຍ​ເຫລືອ​ຜູ້​ທີ່​ຖືກ​ນຳ​ໄປ​ສູ່​ຄວາມ​ຕາຍ;</para>
  <para style="q2" vid="PRO 24:11">ແລະ ຢ່າ​ຊັກຊ້າ​ທີ່​ຈະ​ຊ່ວຍ​ຄົນ​ກຳລັງ​ຈະ​ຖືກ​ຂ້າ.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />ຖ້າ​ເຈົ້າ​ເວົ້າ​ວ່າ, “ແຕ່​ພວກເຮົາ​ບໍ່​ຮູ້​ຫຍັງ​ກ່ຽວກັບ​ເລື່ອງ​ນີ້”,</para>
  <para style="q2" vid="PRO 24:12">ພຣະອົງ​ຜູ້​ທີ່​ຊັ່ງ​ເບິ່ງ​ຈິດໃຈ​ຂອງ​ເຈົ້າ​ຈະ​ບໍ່​ເຫັນ​ບໍ?</para>
  <para style="q1" vid="PRO 24:12">ພຣະອົງ​ຜູ້​ທີ່​ເຝົ້າ​ຮັກສາ​ຊີວິດ​ຂອງ​ເຈົ້າ​ຈະ​ບໍ່​ຮູ້​ບໍ?</para>
  <para style="q2" vid="PRO 24:12">ພຣະອົງ​ຈະ​ບໍ່​ຕອບ​ແທນ​ທຸກຄົນ​ຕາມ​ສິ່ງທີ່​ພວກເຂົາ​ໄດ້​ເຮັດ​ບໍ?<verse eid="PRO 24:12" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 26</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />ລູກ​ເອີຍ, ຈົ່ງ​ກິນ​ນ້ຳເຜິ້ງ​ເພາະ​ມັນ​ເປັນ​ສິ່ງທີ່​ດີ;</para>
  <para style="q2" vid="PRO 24:13">ນ້ຳເຜິ້ງ​ທີ່​ມາ​ຈາກ​ຮັງ​ນັ້ນ​ກໍ​ມີ​ລົດ​ຫວານ​ດີ.<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />ຈົ່ງ​ຮູ້ຈັກ​ວ່າ ປັນຍາ​ກໍ​ຫວານ​ເໝືອນດັ່ງ​ນ້ຳເຜິ້ງ​ສຳລັບ​ຊີວິດ​ຂອງ​ເຈົ້າ:</para>
  <para style="q2" vid="PRO 24:14">ຖ້າ​ເຈົ້າ​ພົບ​ປັນຍາ, ກໍ​ມີ​ຄວາມ​ຫວັງ​ໃນ​ອະນາຄົດ​ສໍາລັບ​ເຈົ້າ,</para>
  <para style="q2" vid="PRO 24:14">ແລະ ຄວາມ​ຫວັງ​ຂອງ​ເຈົ້າ​ຈະ​ບໍ່​ສູນເສຍ​ໄປ.<verse eid="PRO 24:14" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 27</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />ຢ່າ​ດັກຊຸ້ມ​ເໝືອນ​ໂຈນ​ທີ່​ຢູ່​ໃກ້​ເຮືອນ​ຂອງ​ຄົນ​ຊອບທຳ,</para>
  <para style="q2" vid="PRO 24:15">ຢ່າ​ປຸ້ນ​ທີ່ຢູ່​ອາໄສ​ຂອງ​ພວກເຂົາ;<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />ເພາະ​ເຖິງ​ແມ່ນ​ວ່າ​ຄົນ​ຊອບທຳ​ລົ້ມ​ລົງ​ເຈັດ​ຄັ້ງ, ພວກເຂົາ​ກໍ​ລຸກ​ຂຶ້ນ​ມາ​ໄດ້​ອີກ.</para>
  <para style="q2" vid="PRO 24:16">ແຕ່​ຄົນ​ຊົ່ວຮ້າຍ​ນັ້ນ​ກໍ​ລົ້ມລົງ​ເມື່ອ​ຄວາມ​ຈິບຫາຍ​ມາ​ໂຈມຕີ.<verse eid="PRO 24:16" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 28</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />ຢ່າ​ດີໃຈ​ເມື່ອ​ສັດຕູ​ຂອງ​ເຈົ້າ​ລົ້ມ​ລົງ;</para>
  <para style="q2" vid="PRO 24:17">ຢ່າ​ຊື່ນຊົມຍິນດີ​ເມື່ອ​ພວກເຂົາ​ສະດຸດ​ລົ້ມ,<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />ຢ້ານວ່າ​ພຣະເຈົ້າ​ຢາເວ​ຈະ​ເຫັນ ແລະ ບໍ່​ພໍໃຈ</para>
  <para style="q2" vid="PRO 24:18">ແລະ ຫັນ​ຄວາມ​ໂກດຮ້າຍ​ຂອງ​ພຣະອົງ​ໄປ​ຈາກ​ພວກເຂົາ.<verse eid="PRO 24:18" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 28</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />ຢ່າ​ກັງວົນ​ໃຈ​ເພາະ​ຄົນ​ຊົ່ວ</para>
  <para style="q2" vid="PRO 24:19">ຫລື ຢ່າ​ອິດສາ​ຄົນ​ຊົ່ວຮ້າຍ,<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />ເພາະ​ຄົນ​ຊົ່ວ​ບໍ່​ມີ​ຄວາມ​ຫວັງ​ໃນ​ອະນາຄົດ</para>
  <para style="q2" vid="PRO 24:20">ຕະກຽງ​ຂອງ​ຄົນ​ຊົ່ວ​ຈະ​ດັບ​ໄປ.<verse eid="PRO 24:20" /></para>
  <para style="s2">ຄໍາສອນ​ທີ 30</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />ລູກ​ເອີຍ, ຈົ່ງ​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ ແລະ ກະສັດ</para>
  <para style="q2" vid="PRO 24:21">ຢ່າ​ຮ່ວມ​ກັບ​ເຈົ້າໜ້າທີ່​ຜູ້​ກະບົດ,<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />ເພາະ​ທັງ​ສອງ​ຈະ​ພົບ​ຄວາມ​ຈິບຫາຍ​ມາ​ເຖິງ​ພວກເຂົາ​ຢ່າງ​ກະທັນຫັນ.</para>
  <para style="q2" vid="PRO 24:22">ແລະ ຜູ້​ໃດ​ຈະ​ຮູ້​ເຖິງ​ໄພພິບັດ​ທີ່​ທັງສອງ​ຈະ​ນໍາ​ມາ?<verse eid="PRO 24:22" /></para>
  <para style="ms1">ຄຳສອນ​ເພີ່ມເຕີມ​ຂອງ​ຄົນ​ມີ​ປັນຍາ</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />ສິ່ງ​ເຫລົ່ານີ້​ຄື​ຄໍາສອນ​ຂອງ​ຄົນ​ມີ​ປັນຍາ:</para>
  <para style="q1" vid="PRO 24:23">ການ​ຕັດສິນ​ເຂົ້າ​ຂ້າງ​ເປັນ​ສິ່ງ​ທີ່​ບໍ່​ດີ​ຄື:<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />ຜູ້​ທີ່​ເວົ້າ​ກັບ​ຄົນ​ເຮັດ​ຜິດ​ວ່າ, “ເຈົ້າ​ເປັນ​ຄົນບໍລິສຸດ,”</para>
  <para style="q2" vid="PRO 24:24">ຈະ​ຖືກ​ຄົນ​ສາບແຊ່ງ ແລະ ບັນດາ​ປະຊາຊາດ​ຈະ​ປະນາມ​ລາວ.<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />ສ່ວນ​ຜູ້​ຕັດສິນ​ລົງໂທດ​ຄົນ​ເຮັດ​ຜິດ​ຈະ​ໄດ້​ດີ,</para>
  <para style="q2" vid="PRO 24:25">ພຣະພອນ​ອັນ​ອຸດົມ​ຈະ​ມາ​ເຖິງ​ພວກເຂົາ.<verse eid="PRO 24:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />ຄຳຕອບ​ທີ່​ຊື່ສັດ</para>
  <para style="q2" vid="PRO 24:26">ເປັນ​ເຄື່ອງໝາຍ​ແຫ່ງ​ມິດ​ແທ້.<verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />ຈົ່ງ​ເຮັດວຽກ​ໄຖ​ນາ​ໃຫ້​ສຳເລັດ</para>
  <para style="q2" vid="PRO 24:27">ແລະ ຕຽມ​ທົ່ງນາ​ຂອງ​ເຈົ້າ​ໃຫ້​ພ້ອມ;</para>
  <para style="q2" vid="PRO 24:27">ຫລັງຈາກນັ້ນ, ຈຶ່ງ​ສ້າງ​ເຮືອນ​ຂອງ​ເຈົ້າ.<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />ຢ່າ​ເປັນ​ພະຍານ​ຕໍ່ສູ້​ເພື່ອນບ້ານ​ຂອງ​ເຈົ້າໂດຍ​ບໍ່​ມີ​ສາເຫດ​ຄື</para>
  <para style="q2" vid="PRO 24:28">ເຈົ້າ​ຈະ​ໃຊ້​ປາກ​ຂອງ​ເຈົ້າ​ເວົ້າ​ຫລອກລວງ​ບໍ?<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />ຢ່າ​ເວົ້າ​ວ່າ, “ຂ້ອຍ​ຈະ​ເຮັດ​ຕໍ່​ພວກເຂົາ​ເໝືອນ​ດັ່ງ​ທີ່​ພວກເຂົາ​ໄດ້​ເຮັດ​ຕໍ່​ຂ້ອຍ;</para>
  <para style="q2" vid="PRO 24:29">ຂ້ອຍ​ຈະ​ແກ້ແຄ້ນ​ສໍາລັບ​ສິ່ງ​ທີ່​ພວກເຂົາ​ໄດ້​ເຮັດ​ໄປ​ນັ້ນ”.<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />ຂ້ອຍ​ໄດ້​ຍ່າງ​ຜ່ານ​ໄປ​ທີ່​ທົ່ງນາ​ຂອງ​ຄົນ​ຂີ້ຄ້ານ,</para>
  <para style="q2" vid="PRO 24:30">ແລະ ສວນ​ອະງຸ່ນ​ຂອງ​ຄົນ​ບໍ່ຮູ້ຈັກຄິດ;<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />ສວນ​ນັ້ນ​ມີ​ຟຸ່ມໜາມ​ຂຶ້ນ​ເຕັມ​ໄປ​ໝົດ, ຫຍ້າ</para>
  <para style="q2" vid="PRO 24:31">ກໍ​ປົ່ງ​ຂຶ້ນ​ປົກຄຸມ​ພື້ນດິນ ແລະ</para>
  <para style="q2" vid="PRO 24:31">ກຳແພງ​ຫີນ​ກໍ​ຫັກພັງ​ລົງ.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />ຂ້ອຍ​ຄິດ​ຢູ່​ໃນ​ໃຈ​ເຖິງ​ສິ່ງ​ທີ່​ຂ້ອຍ​ສັງເກດ​ເຫັນ</para>
  <para style="q2" vid="PRO 24:32">ແລະ ໄດ້​ບົດຮຽນ​ຈາກ​ສິ່ງ​ທີ່​ຂ້ອຍ​ເຫັນ​ກໍ​ຄື:<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />ຂໍ​ນອນ​ອີກ​ໜ້ອຍ​ໜຶ່ງ, ເຊືອບ​ນອນ​ອີກ​ຈັກ​ໜ້ອຍ,</para>
  <para style="q2" vid="PRO 24:33">ເອົາ​ມື​ກອດ​ເອິກ​ຫລັບ​ບຶດ​ໜຶ່ງ.<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />ແລ້ວ​ຄວາມ​ທຸກຍາກ​ຈະ​ມາ​ຫາ​ເຈົ້າ​ດັ່ງ​ຄົນ​ຂີ້ລັກ</para>
  <para style="q2" vid="PRO 24:34">ແລະ ຄວາມ​ຂັດສົນ​ຈະ​ໂຈມຕີ​ເຈົ້າ​ດັ່ງ​ມີ​ຄົນ​ໜຶ່ງ​ຖື​ອາວຸດ​ມາ.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="ms1">ສຸພາສິດ​ເພີ່ມເຕີມ​ຂອງ​ໂຊໂລໂມນ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />ຕໍ່ໄປນີ້ ແມ່ນ​ສຸພາສິດ​ເພີ່ມເຕີມ​ຂອງ​ໂຊໂລໂມນ, ທີ່​ຄົນ​ຂອງ​ເຮເຊກີຢາ​ກະສັດ​ແຫ່ງ​ຢູດາຍ​ໄດ້​ຮວບຮວມ​ໄວ້​ດັ່ງ​ນີ້:<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />ພຣະເຈົ້າ​ໄດ້​ຮັບ​ກຽດ​ຈາກ​ການ​ເຊື່ອງບັງ​ສິ່ງ​ຕ່າງໆ​ໄວ້;</para>
  <para style="q2" vid="PRO 25:2">ແລະ ບັນດາ​ກະສັດ​ໄດ້​ຮັບ​ກຽດ​ຈາກ​ການ​ຄົ້ນ​ພົບ​ສິ່ງ​ທີ່​ໄດ້​ເກີດ​ຂຶ້ນ.<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />ຟ້າສະຫວັນ​ສູງ​ເທົ່າ​ໃດ ແລະ ແຜ່ນດິນ​ໂລກ​ກໍ​ເລິກ​ເທົ່າໃດ,</para>
  <para style="q2" vid="PRO 25:3">ຄວາມ​ຄິດ​ຂອງ​ບັນດາ​ກະສັດ​ກໍ​ເກີນ​ກວ່າ​ຈະ​ຄົ້ນຫາ​ໄດ້​ສັນນັ້ນ.<verse eid="PRO 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />ເມື່ອ​ກຳຈັດ​ຂີ້ແຮ່​ອອກ​ຈາກ​ເງິນ​ແລ້ວ,</para>
  <para style="q2" vid="PRO 25:4">ແລະ ຊ່າງ​ຕີ​ເງິນ​ກໍ​ສາມາດ​ເຮັດ​ພາຊະນະ​ໄດ້;<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />ເມືອ​ຈໍາກັດ​ຂ້າລາຊະການ​ຊົ່ວ​ອອກ​ໄປ​ຈາກ​ບ່ອນ​ທີ່​ກະສັດ​ຢູ່​ແລ້ວ,</para>
  <para style="q2" vid="PRO 25:5">ບັນລັງ​ຂອງ​ເພິ່ນ​ກໍ​ຈະ​ຖືກ​ສ້າງ​ຕັ້ງ​ຂຶ້ນ​ໂດຍ​ຄວາມ​ຊອບທຳ.<verse eid="PRO 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />ຢ່າ​ຍົກຍໍ​ຕົນເອງ​ຢູ່​ຕໍ່ໜ້າ​ກະສັດ,</para>
  <para style="q2" vid="PRO 25:6">ຫລື ເວົ້າ​ໂອ້ອວດ​ເຖິງ​ຕົນເອງ​ໃນ​ບ່ອນ​ທີ່​ມີ​ຄົນ​ສຳຄັນ;<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />ຈົ່ງ​ລໍຖ້າ​ກະສັດ​ເວົ້າ​ກັບ​ເຈົ້າ​ວ່າ, “ຈົ່ງ​ມາ​ບ່ອນ​ນີ້”,</para>
  <para style="q2" vid="PRO 25:7">ກໍ​ດີກວ່າ​ທີ່​ເພິ່ນ​ເຮັດ​ໃຫ້​ເຈົ້າ​ອັບອາຍ​ຂາຍໜ້າ​ຕໍ່ໜ້າ​ບັນດາ​ຂຸນນາງ​ຂອງ​ເພິ່ນ.</para>
  <para style="b" vid="PRO 25:7" />
  <para style="q1" vid="PRO 25:7">ເຈົ້າ​ໄດ້​ເຫັນ​ຫຍັງ​ດ້ວຍ​ຕາ​ຂອງ​ເຈົ້າ​ເອງ<verse eid="PRO 25:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 25:8" />ຢ່າ​ຟ້າວ​ນຳ​ໄປ​ຟ້ອງ<note caller="+" style="f"><char style="fr" closed="false">25:7,8 </char><char style="ft" closed="false">ຫລື </char><char style="fq" closed="false">ຂຸນນາງ </char><char style="fqa" closed="false">ຜູ້​ເຊິ່ງ​ເຈົ້າ​ຈັບ​ຕາ​ເບິ່ງ <char style="fv">8</char> ຢ່າ​ຮີບ​ຮ້ອນ​ໄປ</char></note> ສານ,</para>
  <para style="q1" vid="PRO 25:8">ເພາະ​ໃນ​ບັ້ນປາຍ​ເຈົ້າ​ຈະ​ເຮັດ​ແນວໃດ</para>
  <para style="q2" vid="PRO 25:8">ຖ້າ​ເພື່ອນບ້ານ​ຂອງ​ເຈົ້າ​ເຮັດ​ໃຫ້​ເຈົ້າ​ອັບອາຍ​ຂາຍ​ໜ້າ?<verse eid="PRO 25:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />ຖ້າ​ເຈົ້າ​ນໍາ​ເອົາ​ເພື່ອນບ້ານ​ຂອງ​ເຈົ້າ​ໄປ​ຂຶ້ນ​ສານ,</para>
  <para style="q2" vid="PRO 25:9">ຢ່າ​ທໍລະຍົດ​ຕໍ່​ຄວາມ​ໄວ້ວາງໃຈ​ຂອງ​ຄົນ​ອື່ນ,<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />ຢ້ານ​ວ່າ​ຜູ້​ທີ່​ໄດ້​ຍິນ​ອາດ​ຈະ​ເຮັດ​ໃຫ້​ເຈົ້າ​ຂາຍໜ້າ</para>
  <para style="q2" vid="PRO 25:10">ແລະ ຈະ​ກ່າວຫາ​ຕໍ່ສູ້​ເຈົ້າ​ບໍ່​ຈົບ​ສິ້ນ​ຈັກ​ເທື່ອ.<verse eid="PRO 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />ການ​ໃຫ້​ຄໍາຕັດສິນ​ຢ່າງ​ຖືກຕ້ອງ<note caller="+" style="f"><char style="fr" closed="false">25:11 </char><char style="ft" closed="false">ຫລື ການ​ຕັດ​ສິນ​ໃຈ​ທີ່​ເໝາະ​ສົມ​ກັບ​ສະຖານນະການ</char></note></para>
  <para style="q2" vid="PRO 25:11">ກໍ​ເໝືອນ​ດັ່ງ​ໝາກ​ແອັບເປີ້ນ​ຄຳ​ທີ່​ຫຸ້ມຫໍ່​ດ້ວຍ​ເງິນ.<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />ຄຳ​ຕຳໜິ​ຂອງ​ຜູ້ພິພາກສາ​ມີ​ປັນຍາ​ສຳລັບ​ຫູ​ທີ່​ຮັບ​ຟັງ</para>
  <para style="q2" vid="PRO 25:12">ກໍ​ເໝືອນ​ດັ່ງ​ຕຸ້ມຫູ​ຄໍາ ຫລື ເຄື່ອງ​ປະດັບ​ທີ່​ເຮັດ​ດ້ວຍ​ຄຳ​ບໍລິສຸດ.<verse eid="PRO 25:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />ຜູ້ນຳຂ່າວ​ທີ່​ສັດຊື່</para>
  <para style="q2" vid="PRO 25:13">ເປັນ​ດັ່ງ​ນໍ້າ​ເຢັນ​ຈາກ​ຫິມະ​ໃນ​ລະດູ​ເກັບກ່ຽວ;</para>
  <para style="q2" vid="PRO 25:13">ທີ່​ເຮັດ​ໃຫ້​ນາຍ​ທີ່​ສົ່ງ​ລາວ​ໄປ​ນັ້ນ​ຊື່ນບານ​ໃຈ.<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />ຜູ້​ທີ່​ໂອ້ອວດ​ເລື່ອງ​ຂອງ​ຂວັນ ທີ່​ຕົນ​ບໍ່​ໃຫ້​ຈັກເທື່ອ</para>
  <para style="q2" vid="PRO 25:14">ກໍ​ເໝືອນ​ຟ້າ​ຄື້ມ ແລະ ລົມ​ທີ່​ບໍ່​ມີ​ຝົນ.<verse eid="PRO 25:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />ຄວາມ​ອົດທົນ​ສາມາດ​ເອົາ​ຊະນະ​ໃຈ​ຜູ້ປົກຄອງ,</para>
  <para style="q2" vid="PRO 25:15">ລິ້ນ​ທີ່​ອ່ອນຫວານ​ສາມາດ​ເຮັດ​ໃຫ້​ກະດູກ​ຫັກ​ໄດ້.<verse eid="PRO 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />ເມື່ອ​ເຈົ້າ​ເຫັນ​ນໍ້າເຜິ້ງ ຈົ່ງ​ກິນ​ໃຫ້​ພໍ​ດີ</para>
  <para style="q2" vid="PRO 25:16">ຖ້າ​ກິນ​ມັນ​ຫລາຍ​ເກີນ​ໄປ, ແລະ ເຈົ້າ​ຈະ​ຮາກ​ອອກ​ມາ.<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />ຈົ່ງ​ໄປ​ຢ້ຽມຢາມ​ເພື່ອນບ້ານ​ດົນໆ​ເທື່ອ​ໜຶ່ງ</para>
  <para style="q2" vid="PRO 25:17">ຖ້າ​ເຈົ້າ​ໄປ​ດຸ​ຫລາຍ, ພວກເຂົາ​ຈະ​ຊັງ​ເຈົ້າ.<verse eid="PRO 25:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />ຜູ້​ທີ່​ເປັນ​ພະຍານ​ບໍ່​ຈິງ​ຕໍ່ສູ້​ເພື່ອນບ້ານ</para>
  <para style="q2" vid="PRO 25:18">ກໍ​ເໝືອນດັ່ງ​ໄມ້ຄ້ອນ, ດາບ ຫລື ລູກທະນູ​ທີ່​ແຫລມຄົມ.<verse eid="PRO 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />ການ​ເພິ່ງພາ​ຄົນ​ບໍ່​ສັດຊື່​ໃນ​ຍາມ​ເດືອດ​ຮ້ອນ</para>
  <para style="q2" vid="PRO 25:19">ກໍ​ເໝືອນດັ່ງ​ແຂ້ວ​ຫັກ ຫລື ຕີນ​ທີ່​ພິການ.<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />ຜູ້​ທີ່​ຮ້ອງເພງ​ໃຫ້​ຄົນ​ທຸກໃຈ​ຟັງ</para>
  <para style="q2" vid="PRO 25:20">ກໍ​ເໝືອນດັ່ງ​ຜູ້​ທີ່​ແກ້​ເສື້ອ​ອອກ​ໃນ​ມື້​ທີ​ອາກາດ​ໜາວ,</para>
  <para style="q2" vid="PRO 25:20">ຫລື ເອົາ​ເກືອ​ໂຮຍ​ໃສ່​ບາດ.<verse eid="PRO 25:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />ຖ້າ​ສັດຕູ​ຂອງ​ເຈົ້າ​ຫິວເຂົ້າ, ຈົ່ງ​ເອົາ​ອາຫານ​ໃຫ້​ລາວ​ກິນ;</para>
  <para style="q2" vid="PRO 25:21">ຖ້າ​ລາວ​ຫິວ​ນໍ້າ, ຈົ່ງ​ເອົາ​ນ້ຳ​ໃຫ້​ລາວ​ດື່ມ.<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />ການ​ເຮັດ​ຢ່າງນັ້ນ, ເປັນການ​ທີ່​ເຈົ້າ​ໄດ້​ກອງ​ຖ່ານໄຟ​ທີ່​ລຸກໄໝ້​ຢູ່​ໃສ່​ຫົວ​ຂອງ​ລາວ,</para>
  <para style="q2" vid="PRO 25:22">ແລະ ພຣະເຈົ້າ​ຢາເວ​ຈະ​ໃຫ້​ບຳເໜັດ​ແກ່​ເຈົ້າ.<verse eid="PRO 25:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />ຄຳ​ເວົ້າ​ສຽດສີ ທີ່​ເຮັດ​ໃຫ້​ໜ້າ​ບູດບຶ້ງ</para>
  <para style="q2" vid="PRO 25:23">ກໍ​ເປັນ​ເໝືອນ​ລົມ​ທິດເໜືອ​ນຳ​ເອົາ​ຝົນ​ມາ​ໂດຍ​ທີ່​ບໍ່​ຄາດ​ຄິດ.<verse eid="PRO 25:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />ອາໄສ​ຢູ່​ເທິງ​ຫລັງຄາ​ເຮືອນ</para>
  <para style="q2" vid="PRO 25:24">ກໍ​ດີ​ກວ່າ​ຢູ່​ໃນ​ເຮືອນ​ຮ່ວມ​ກັບ​ເມຍ​ທີ່​ມັກ​ຜິດຖຽງ​ກັນ.<verse eid="PRO 25:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />ຂ່າວ​ດີ​ຈາກ​ແດນ​ໄກ</para>
  <para style="q2" vid="PRO 25:25">ກໍ​ເໝືອນດັ່ງ​ເອົາ​ນ້ຳ​ເຢັນ​ໃຫ້​ແກ່​ຈິດໃຈ​ທີ່​ອິດເມື່ອຍ​ອ່ອນແຮງ.<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />ຖ້າ​ຄົນ​ຊອບທຳ​ເຮັດຕາມ​ຄົນ​ຊົ່ວຮ້າຍ</para>
  <para style="q2" vid="PRO 25:26">ກໍ​ເໝືອນດັ່ງ​ນ້ຳ​ພຸ​ມີ​ຂີ້ຕົມ ຫລື ນ້ຳສ້າງ​ທີ່​ເປື້ອນເປີ.<verse eid="PRO 25:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />ກິນ​ນ້ຳເຜິ້ງ​ຫລາຍ​ບໍ່​ດີ​ສັນໃດ,</para>
  <para style="q2" vid="PRO 25:27">ການ​ຄົ້ນຫາ​ເລື່ອງ​ຕ່າງໆ​ເລິກ​ເກີນ​ໄປ​ກໍ​ເຮັດໃຫ້​ເສຍ​ກຽດ​ສັນນັ້ນ.<note caller="+" style="f"><char style="fr" closed="false">25:27 </char><char style="ft" closed="false">ຫລື ການ​ຫາ​ກຽດ​ໃຫ້​ໂຕ​ເອງ​ກໍ​ບໍ່​ເໝາະ​ສັນນັ້ນ</char></note><verse eid="PRO 25:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />ຄົນ​ທີ່​ຄວບຄຸມ​ຕົນເອງ​ບໍ່​ໄດ້</para>
  <para style="q2" vid="PRO 25:28">ກໍ​ເໝືອນດັ່ງ​ເມືອງ​ທີ່​ກຳແພງ​ຖືກ​ທຳລາຍ.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />ກຽດ​ສັກສີ​ບໍ່​ເໝາະສົມ​ສໍາລັບ​ຄົນ​ໂງ່ຈ້າ,</para>
  <para style="q2" vid="PRO 26:1">ເໝືອນ​ດັ່ງ​ຫິມະ​ໃນ​ລະດູ​ຮ້ອນ ຫລື ຝົນຕົກ​ໃນ​ລະດູ​ເກັບກ່ຽວ,<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />ຄຳ​ສາບແຊ່ງ​ທີ່​ບໍ່​ມີ​ເຫດຜົນ​ກໍ​ບໍ່​ສົ່ງ​ຜົນ​ຫຍັງ​ຕາມ​ມາ,</para>
  <para style="q2" vid="PRO 26:2">ເໝືອນ​ດັ່ງ​ນົກກະຈອກ ຫລື ນົກແອ່ນ​ທີ່​ບິນ​ເວີ່ນ​ໄປ​ມາ​ໂດຍ​ບໍ່​ມີ​ຈຸດໝາຍ.<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />ໄມ້ແສ້​ມີ​ໄວ້​ສຳລັບ​ຕີ​ມ້າ, ບັງຫຽນ​ມີ​ໄວ້​ສຳລັບ​ຄວບຄຸມ​ລໍ,</para>
  <para style="q2" vid="PRO 26:3">ແລະ ໄມ້​ແສ້​ມີ​ໄວ້​ສຳລັບ​ຕີ​ຫລັງ​ຂອງ​ຄົນ​ໂງ່ຈ້າ!<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />ຢ່າ​ຕອບ​ຄົນ​ໂງ່ຈ້າ​ຕາມ​ຄວາມ​ໂງ່​ຂອງ​ລາວ</para>
  <para style="q2" vid="PRO 26:4">ຢ້ານວ່າ​ເຈົ້າ​ເອງ​ຈະ​ເປັນ​ຄື​ລາວ.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />ຈົ່ງ​ຕອບ​ຄົນ​ໂງ່ຈ້າ​ຕາມ​ຄວາມ​ໂງ່​ຂອງ​ລາວ,</para>
  <para style="q2" vid="PRO 26:5">ຢ້ານວ່າ​ລາວ​ຈະ​ເປັນ​ຄົນ​ສະຫລາດ​ໃນ​ສາຍຕາ​ຂອງ​ຕົນເອງ.<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />ການ​ສົ່ງຂ່າວ​ດ້ວຍ​ມື​ຂອງ​ຄົນ​ໂງ່ຈ້າ</para>
  <para style="q2" vid="PRO 26:6">ກໍ​ເໝືອນດັ່ງ​ຕັດ​ຕີນ​ຕົນເອງ​ອອກ ຫລື ດື່ມ​ຢາ​ພິດ.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />ສຸພາສິດ​ຢູ່​ໃນ​ປາກ​ຂອງ​ຄົນ​ໂງ່ຈ້າ</para>
  <para style="q2" vid="PRO 26:7">ກໍ​ເໝືອນ​ຂາ​ຄົນ​ພິການ​ທີ່​ໃຊ້​ການ​ບໍ່​ໄດ້.<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />ການ​ໃຫ້​ກຽດ​ຄົນ​ໂງ່ຈ້າ</para>
  <para style="q2" vid="PRO 26:8">ກໍ​ເໝືອນ​ມັດ​ກ້ອນຫີນ​ຕິດ​ກັບ​ກະຖຸນ.<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />ສຸພາສິດ​ໃນ​ປາກ​ຂອງ​ຄົນ​ໂງ່ຈ້າ</para>
  <para style="q2" vid="PRO 26:9">ກໍ​ເໝືອນດັ່ງ​ຟຸ່ມ​ໜາມ​ໃນ​ມື​ຂອງ​ຄົນ​ຂີ້ເມົາ.<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />ຜູ້​ທີ່​ຈ້າງ​ຄົນ​ໂງ່ຈ້າ ຫລື ຜູ້​ທີ່​ຍ່າງ​ຜ່ານ​ໄປ​ມາ</para>
  <para style="q2" vid="PRO 26:10">ກໍ​ເໝືອນດັ່ງ​ນັກ​ທະນູ​ທີ່​ຍິງ​ມົ້ວ​ໄປ​ມາ.<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />ໝາ​ກິນ​ສິ່ງ​ທີ່​ມັນ​ຮາກ​ອອກ​ມາ​ຄືນ​ສັນໃດ,</para>
  <para style="q2" vid="PRO 26:11">ຄົນ​ໂງ່ຈ້າ​ກໍ​ກັບ​ໄປ​ເຮັດ​ສິ່ງ​ທີ່​ໂງ່ຈ້າ​ຄືນ​ສັນນັ້ນ.<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />ເຈົ້າ​ເຫັນ​ບັນດາ​ຄົນ​ທີ່​ຄິດວ່າ​ຕົນເອງ​ເປັນ​ຄົນ​ສະຫລາດ​ບໍ?</para>
  <para style="q2" vid="PRO 26:12">ຄົນ​ໂງ່ຈ້າ​ກໍ​ຍັງ​ມີ​ຄວາມ​ຫວັງ​ຫລາຍກວ່າ​ພວກເຂົາ​ອີກ.<verse eid="PRO 26:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />ຄົນ​ຂີ້ຄ້ານ​ເວົ້າ​ວ່າ, “ມີ​ໂຕສິງ​ຢູ່​ທາງ​ນອກ,</para>
  <para style="q2" vid="PRO 26:13">ມີ​ສິງ​ຮ້າຍ​ທີ່​ຍ່າງ​ວົນວຽນ​ໄປ​ມາ​ຢູ່​ຕາມ​ຖະໜົນ!”<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />ປະຕູ​ເປີດ​ປິດ​ໄປ​ມາ​ດ້ວຍ​ບານ​ພັບ​ສັນໃດ,</para>
  <para style="q2" vid="PRO 26:14">ດັ່ງນັ້ນ ຄົນ​ຂີ້ຄ້ານ​ກໍ​ນອນ​ພິກ​ຄີງ​ໄປ​ມາ​ຢູ່​ເທິງ​ຕຽງ​ສັນນັ້ນ.<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />ຄົນ​ຂີ້ຄ້ານ​ແຊ່​ມື​ຂອງ​ຕົນ​ໄວ້​ຢູ່​ໃນ​ຊາມ;</para>
  <para style="q2" vid="PRO 26:15">ລາວ​ຂີ້ຄ້ານ​ຫລາຍ​ຈົນ​ບໍ່​ຍອມ​ຈັບ​ອາຫານ​ເຂົ້າ​ໃສ່​ປາກ​ຕົນເອງ.<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />ຄົນ​ຂີ້ຄ້ານ​ຄິດວ່າ​ໂຕ​ເອງ​ເປັນ​ຄົນ​ສະຫລາດ</para>
  <para style="q2" vid="PRO 26:16">ຫລາຍກວ່າ​ຄົນ​ເຈັດ​ຄົນ​ທີ່​ຕອບ​ຢ່າງ​ລະມັດລະວັງ.<verse eid="PRO 26:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />ຄົນ​ທີ່​ເຂົ້າ​ຮ່ວມ​ວົງ​ຜິດຖຽງ​ກັນ​ໂດຍ​ບໍ່​ກ່ຽວຂ້ອງ​ກັບ​ຕົນເອງ</para>
  <para style="q2" vid="PRO 26:17">ກໍ​ຄື​ຄົນ​ທີ່​ຈັບ​ຫູ​ໝາ​ທີ່​ຍ່າງ​ກາຍໄປ​ນັ້ນ.<verse eid="PRO 26:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />ເໝືອນ​ດັ່ງ​ຄົນ​ບ້າ​ທີ່​ຍິງ</para>
  <para style="q2" vid="PRO 26:18">ລູກທະນູ​ໄຟ​ແຫ່ງ​ຄວາມ​ຕາຍ<verse eid="PRO 26:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19" />ຜູ້​ທີ່​ຕົວະ​ເພື່ອນບ້ານ​ຂອງ​ຕົນ</para>
  <para style="q2" vid="PRO 26:19">ແລະ ເວົ້າ​ວ່າ, “ຂ້ອຍ​ພຽງ​ແຕ່​ຢອກ​ຫລິ້ນ​ຊື່ໆ!” ກໍ​ເປັນ​ດັ່ງ​ຄົນ​ບ້າ.<verse eid="PRO 26:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />ເມື່ອ​ບໍ່​ມີ​ຟືນ ໄຟ​ກໍ​ມອດ</para>
  <para style="q2" vid="PRO 26:20">ເມື່ອ​ບໍ່​ມີ​ການ​ເວົ້າ​ນິນທາ ກໍ​ມີ​ການ​ຜິດຖຽງກັນ​ສັນນັ້ນ.<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />ຖ່ານ ແລະ ໄມ້​ເຮັດ​ໃຫ້​ໄຟ​ລຸກ,</para>
  <para style="q2" vid="PRO 26:21">ຄົນ​ທີ່​ມັກ​ຄວາມ​ເດືອດຮ້ອນ ເຮັດ​ໃຫ້​ຜິດ​ກັນ.<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />ຄຳເວົ້າ​ນິນທາ​ເປັນ​ດັ່ງ​ອາຫານ​ທີ່​ແຊບ;</para>
  <para style="q2" vid="PRO 26:22">ມັນ​ລົງ​ໄປ​ໃນ​ສ່ວນ​ເລິກ​ທີ່​ສຸດ​ຂອງ​ຄົນ.<verse eid="PRO 26:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />ຮິມສົບ​ທີ່​ທີ່​ຮ້ອນຮົນ<note caller="+" style="f"><char style="fr" closed="false">26:23 </char><char style="ft" closed="false">ພາສາ​ເຮັບເຣີ ສະສັບ​ເຊັບຕູອາຈິນ​ວ່າ ລຽບ</char></note>​ຈາກ​ຈິດໃຈ​ຊົ່ວຮ້າຍ</para>
  <para style="q2" vid="PRO 26:23">ກໍ​ເໝືອນດັ່ງ​ຂີ້ແຮ່​ເງິນ​ທີ່​ເຄືອບ​ເທິງ​ພາຊະນະ​ດິນເຜົາ.<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />ສັດຕູ​ແຝງ​ຕົວ​ດ້ວຍ​ຮິບສົບ,</para>
  <para style="q2" vid="PRO 26:24">ແຕ່​ໃນ​ໃຈ​ຂອງ​ພວກເຂົາ​ກໍ​ປິດບັງ​ການ​ຫລອກລວງ​ໄວ້.<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />ເຖິງແມ່ນວ່າ​ຄໍາເວົ້າ​ຂອງ​ພວກເຂົາ​ເປັນ​ຕາ​ຟັງ, ກໍ​ຢ່າ​ເຊື່ອ​ພວກເຂົາ,</para>
  <para style="q2" vid="PRO 26:25">ເພາະ​ມີ​ສິ່ງທີ່​ໜ້າກຽດຊັງ​ເຈັດ​ຢ່າງ​ເຕັມ​ຢູ່​ໃນ​ໃຈ​ຂອງ​ພວກເຂົາ.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />ຄວາມ​ກຽດຊັງ​ຂອງ​ພວກເຂົາ​ອາດຈະ​ຖືກ​ປິດບັງ​ໄວ້​ດ້ວຍ​ການ​ຫລອກລວງ,</para>
  <para style="q2" vid="PRO 26:26">ແຕ່​ຄວາມ​ຊົ່ວຮ້າຍ​ຂອງ​ພວກເຂົາ​ຈະ​ຖືກ​ເປີດ​ເຜີຍ​ຢູ່​ໃນ​ບ່ອນ​ປະຊຸມ.<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />ຜູ້ໃດ​ຂຸດ​ຂຸມ​ໄວ້ ຜູ້​ນັ້ນ​ຈະ​ຕົກ​ລົງ​ໄປ​ໃນ​ຂຸມ​ນັ້ນ​ເອງ;</para>
  <para style="q2" vid="PRO 26:27">ຖ້າ​ຜູ້​ໃດ​ກິ້ງ​ຫີນ​ອອກ, ຫີນ​ນັ້ນ​ຈະ​ກິ້ງ​ທັບ​ຜູ້​ນັ້ນ​ເອງ.<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />ລີ້ນ​ທີ່​ເວົ້າ​ຕົວະ​ກໍ​ກຽດຊັງ​ຜູ້​ທີ່​ມັນ​ທໍາຮ້າຍ,</para>
  <para style="q2" vid="PRO 26:28">ແລະ ປາກ​ທີ່​ປະຈົບ​ປະແຈງ​ກໍ​ນໍາ​ໄປ​ສູ່​ຄວາມ​ຈິບຫາຍ.<verse eid="PRO 26:28" /></para>
  <para style="b" />
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />ຢ່າ​ອວດ​ເຖິງ​ເລື່ອງ​ຂອງ​ມື້ອື່ນ,</para>
  <para style="q2" vid="PRO 27:1">ເພາະ​ເຈົ້າ​ບໍ່​ຮູ້​ວ່າ​ມື້​ໜຶ່ງ​ຈະ​ມີ​ຫຍັງ​ເກີດ​ຂຶ້ນ​ແດ່.<verse eid="PRO 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />ຈົ່ງ​ໃຫ້​ຄົນອື່ນ​ຍ້ອງຍໍ​ເຈົ້າ, ແລະ ຢ່າ​ຍ້ອງຍໍ​ຕົນເອງ;</para>
  <para style="q2" vid="PRO 27:2">ຈົ່ງ​ໃຫ້​ຄົນ​ພາຍນອກ​ຍ້ອງຍໍ​ເຈົ້າ, ແລະ ບໍ່​ແມ່ນ​ດ້ວຍ​ຮິມສົບ​ຂອງ​ເຈົ້າ​ເອງ.<verse eid="PRO 27:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />ຫີນ​ກໍ​ໜັກ ແລະ ດິນຊາຍ​ກໍ​ເປັນ​ພາລະ,</para>
  <para style="q2" vid="PRO 27:3">ແຕ່​ການ​ຍົວຍົງ​ຂອງ​ຄົນ​ໂງ່ຈ້າ​ກໍ​ຍິ່ງ​ໜັກ​ກວ່າ​ຫີນ ແລະ ດິນຊາຍ.<verse eid="PRO 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />ຄວາມ​ໃຈຮ້າຍ​ແມ່ນ​ຄວາມ​ໂຫດຮ້າຍ ແລະ ຄວາມ​ໂມໂຫ​ນັ້ນ​ຖ້ວມລົ້ນ,</para>
  <para style="q2" vid="PRO 27:4">ແຕ່​ຜູ້ໃດ​ຈະ​ອົດທົນ​ຕໍ່​ຄວາມ​ອິດສາ​ໄດ້?<verse eid="PRO 27:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />ການ​ຕໍາໜິ​ຢ່າງ​ເປີດ​ເຜີຍ</para>
  <para style="q2" vid="PRO 27:5">ກໍ​ດີ​ກວ່າ​ເຊື່ອງ​ຄວາມ​ຮັກ​ໄວ້.<verse eid="PRO 27:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />ບາດແຜ​ທີ່​ມາ​ຈາກ​ໝູ່​ເພື່ອນ​ກໍ​ເຊື່ອຖືໄດ້,</para>
  <para style="q2" vid="PRO 27:6">ແຕ່​ຈູບ​ຂອງ​ສັດຕູ​ຫລາຍ​ຄັ້ງ​ກໍ​ວາງໃຈ​ບໍ່​ໄດ້.<verse eid="PRO 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />ຄົນ​ທີ່​ກິນ​ອີ່ມ​ແລ້ວ​ກໍ​ບໍ່​ສົນໃຈ​ນ້ຳເຜິ້ງ​ຈາກ​ຮັງ,</para>
  <para style="q2" vid="PRO 27:7">ແຕ່​ຄົນ​ທີ່​ອຶດຫິວ​ແມ່ນ​ແຕ່​ສິ່ງ​ທີ່​ຂົມ​ກໍ​ມີ​ລົດ​ຫວານ​ໄດ້.<verse eid="PRO 27:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />ຄົນ​ທີ່​ໜີ​ອອກ​ຈາກ​ບ້ານ</para>
  <para style="q2" vid="PRO 27:8">ກໍ​ເໝືອນ​ດັ່ງ​ນົກ​ທີ່​ໜີ​ອອກ​ໄປ​ຈາກ​ຮັງ.<verse eid="PRO 27:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />ນ້ຳ​ຫອມ ແລະ ເຄື່ອງ​ຫອມ​ນໍາ​ຄວາມ​ຍິນດີ​ມາ​ສູ່​ຈິດໃຈ,</para>
  <para style="q2" vid="PRO 27:9">ແລະ ຄຳ​ແນະນຳ​ທີ່​ມາ​ຈາກ​ໃຈ​ຂອງ​ໝູ່ເພື່ອນ</para>
  <para style="q2" vid="PRO 27:9">ກໍ​ເຮັດ​ໃຫ້​ເກີດ​ຄວາມ​ສຸກ.<verse eid="PRO 27:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />ຢ່າ​ປະຖິ້ມ​ໝູ່ເພື່ອນ​ຂອງ​ເຈົ້າ ຫລື ໝູ່ເພື່ອນ​ຂອງ​ຄອບຄົວ​ເຈົ້າ,</para>
  <para style="q2" vid="PRO 27:10">ແລະ ຢ່າ​ໄປ​ບ້ານ​ຍາດຕິພີ່ນ້ອງ​ຂອງ​ເຈົ້າ​ເມື່ອ​ເຈົ້າ​ພົບ​ຄວາມ​ຍາກ​ລຳບາກ,</para>
  <para style="q2" vid="PRO 27:10">ຈົ່ງ​ໄປ​ຫາ​ເພື່ອນບ້ານ​ທີ່​ໃກ້ຄຽງ​ກໍ​ດີ​ກວ່າ​ຍາດຕິພີ່ນ້ອງ​ທີ່​ຢູ່​ຫ່າງໄກ.<verse eid="PRO 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />ລູກ​ເອີຍ, ຈົ່ງ​ເປັນ​ຄົນ​ມີ​ປັນຍາ, ແລະ ນໍາ​ຄວາມ​ສຸກ​ມາ​ໃຫ້​ພໍ່;</para>
  <para style="q2" vid="PRO 27:11">ເພື່ອ​ພໍ່​ຈະ​ຕອບ​ຄົນ​ທີ່​ໝິ່ນປະໝາດ​ພໍ່​ໄດ້.<verse eid="PRO 27:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />ຄົນ​ສະຫລາດ​ເຫັນ​ໄພ​ອັນຕະລາຍ ແລະ ເຂົ້າ​ໄປ​ລີ້ໄພ,</para>
  <para style="q2" vid="PRO 27:12">ແຕ່​ຜູ້​ທີ່​ບໍ່ຮູ້ຈັກຄິດ​ກໍ​ຍ່າງ​ຕໍ່ໄປ ແລະ ໄດ້​ຮັບ​ໂທດ.<verse eid="PRO 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />ຈົ່ງ​ຢຶດ​ເຄື່ອງນຸ່ງ​ຂອງ​ຜູ້​ທີ່​ຄ້ຳປະກັນ​ໃຫ້​ແກ່​ຄົນແປກໜ້າ;</para>
  <para style="q2" vid="PRO 27:13">ຈົ່ງ​ຢຶດ​ໄວ້​ເປັນ​ເຄື່ອງ​ມັດຈໍາ​ຖ້າ​ເຮັດ​ການ​ຄ້ຳປະກັນ​ໃຫ້​ຄົນ​ພາຍນອກ.<verse eid="PRO 27:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />ຖ້າ​ຜູ້​ໃດ​ອວຍພອນ​ເພື່ອນບ້ານ​ດ້ວຍ​ສຽງ​ດັງ​ແຕ່​ເຊົ້າ​ມືດ,</para>
  <para style="q2" vid="PRO 27:14">ຄໍາ​ອວຍພອນ​ນັ້ນ​ຈະ​ຖື​ວ່າ​ເປັນ​ຄຳ​ສາບແຊ່ງ.<verse eid="PRO 27:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />ເມຍ​ທີ່​ມັກ​ຜີດຖຽງ​ກັນ​ກໍ​ເໝືອນ​ຫລັງຄາ​ຮົ່ວ</para>
  <para style="q2" vid="PRO 27:15">ທີ່​ມີ​ນ້ຳຝົນ​ຍ້ອຍ​ໃນ​ເວລາ​ເກີດ​ພະຍຸ​ຝົນ;<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />ການ​ຫ້າມ​ນາງ​ກໍ​ເໝືອນ​ການ​ໄປ​ຫ້າມ​ລົມ</para>
  <para style="q2" vid="PRO 27:16">ຫລື ການ​ໃຊ້​ມື​ກໍາ​ນ້ຳມັນ.<verse eid="PRO 27:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />ເຫລັກ​ຝົນ​ເຫລັກ​ໃຫ້​ຄົມ​ໄດ້​ສັນໃດ,</para>
  <para style="q2" vid="PRO 27:17">ຄົນ​ເຮົາ​ກໍ​ຝົນ​ກັນ ແລະ ກັນ​ໃຫ້​ຫລັກແຫລມ​ໄດ້​ສັນນັ້ນ.<verse eid="PRO 27:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />ຜູ້​ທີ່​ບົວລະບັດ​ຕົ້ນ​ໝາກເດື່ອ​ຈະ​ໄດ້​ກິນ​ໝາກ​ຂອງ​ມັນ,</para>
  <para style="q2" vid="PRO 27:18">ແລະ ຜູ້​ທີ່​ປົກປ້ອງ​ນາຍ​ຂອງ​ຕົນ​ຈະ​ໄດ້​ຮັບ​ກຽດ.<verse eid="PRO 27:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />ນ້ຳ​ສະທ້ອນ​ໃຫ້​ເຫັນ​ໜ້າ​ສັນໃດ,</para>
  <para style="q2" vid="PRO 27:19">ຊີວິດ​ຂອງ​ຄົນ​ກໍ​ສະທ້ອນ​ໃຫ້​ເຫັນ​ຈິດໃຈ​ສັນນັ້ນ.<verse eid="PRO 27:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />ຄວາມ​ຕາຍ ແລະ ຄວາມ​ຈິບຫາຍ​ບໍ່​ເຄີຍ​ອີ່ມ​ສັນໃດ,</para>
  <para style="q2" vid="PRO 27:20">ຕາ​ຂອງ​ມະນຸດ​ກໍ​ບໍ່​ຮູ້​ຈັກ​ອີ່ມ​ສັ້ນນັ້ນ.<verse eid="PRO 27:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />ເງິນ​ຖືກ​ທົດສອບ​ດ້ວຍ​ເບົ້າ​ຫລອມ ແລະ ຄໍາ​ຖືກ​ທົດສອບ​ດ້ວຍ​ເຕົາໄຟ​ສັນໃດ,</para>
  <para style="q2" vid="PRO 27:21">ຄຳ​ຍ້ອງຍໍ​ຊົມເຊີຍ​ກໍ​ມີ​ໄວ້​ພິສູດ​ຄົນ​ສັນນັ້ນ.<verse eid="PRO 27:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />ເຖິງ​ແມ່ນ​ເຈົ້າ​ເອົາ​ຄົນ​ໂງ່ຈ້າ​ໃສ່​ຄົກ​ຕຳ,</para>
  <para style="q2" vid="PRO 27:22">ຕໍາ​ພວກເຂົາ​ເໝືອນ​ດັ່ງ​ເມັດເຂົ້າ​ທີ່​ຕໍາ​ດ້ວຍ​ຄົກມອງ,</para>
  <para style="q2" vid="PRO 27:22">ເຈົ້າ​ກໍ​ບໍ່​ສາມາດ​ກຳຈັດ​ຄວາມ​ໂງ່​ຂອງ​ພວກເຂົາ​ອອກ​ໄປ​ໄດ້.<verse eid="PRO 27:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />ຈົ່ງ​ແນ່ໃຈ​ວ່າ​ເຈົ້າ​ຮູ້​ຄວາມ​ເປັນ​ຢູ່​ຂອງ​ຝູງ​ແກະ​ຂອງ​ເຈົ້າ​ເປັນ​ຢ່າງ​ດີ,</para>
  <para style="q2" vid="PRO 27:23">ຈົ່ງ​ເອົາໃຈໃສ່​ຝູງງົວ​ຂອງ​ເຈົ້າ;<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />ເພາະ​ຄວາມ​ຮັ່ງມີ​ບໍ່​ຢືນຍົງ​ຕະຫລອດໄປ,</para>
  <para style="q2" vid="PRO 27:24">ແລະ ມົງກຸດ​ກໍ​ບໍ່​ໄດ້​ໝັ້ນຄົງ​ທຸກ​ຊົ່ວ​ອາຍຸ​ຄົນ.<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />ເມື່ອ​ຕັດ​ຫຍ້າ​ແຫ້ງ​ອອກ​ໄປ ແລະ ຫຍ້າ​ໃໝ່​ກໍ​ປົ່ງ​ຂຶ້ນ​ມາ,</para>
  <para style="q2" vid="PRO 27:25">ແລະ ຫຍ້າ​ຈາກ​ເນີນພູ​ກໍ​ຖືກ​ເກັບກ່ຽວ​ໄວ້,<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />ແກະ​ຈະ​ໃຫ້​ເສື້ອຜ້າ​ແກ່​ເຈົ້າ,</para>
  <para style="q2" vid="PRO 27:26">ແລະ ແບ້​ຈະ​ໃຫ້​ຄ່າ​ທົ່ງນາ.<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />ເຈົ້າ​ຈະ​ມີ​ນໍ້ານົມ​ແບ້​ຢ່າງ​ອຸດົມ​ສົມບູນ​ເພື່ອ​ລ້ຽງ​ຄອບຄົວ​ຂອງ​ເຈົ້າ</para>
  <para style="q2" vid="PRO 27:27">ແລະ ລ້ຽງດູ​ບັນດາ​ຄົນຮັບໃຊ້​ຍິງ​ຂອງ​ເຈົ້າ.<verse eid="PRO 27:27" /></para>
  <para style="b" />
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />ຄົນ​ຊົ່ວຮ້າຍ​ໜີ​ໄປ​ໂດຍ​ບໍ່​ມີ​ຜູ້ໃດ​ໄລ່​ຕາມ,</para>
  <para style="q2" vid="PRO 28:1">ແຕ່​ຄົນ​ຊອບທຳ​ກ້າຫານ​ເໝືອນ​ດັ່ງ​ໂຕສິງ.<verse eid="PRO 28:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />ເມື່ອ​ປະເທດ​ຊາດ​ເກີດ​ການ​ກະບົດ,<note caller="+" style="f"><char style="fr" closed="false">28:2 </char><char style="ft" closed="false">ຫລື ເພາະ​ຄວາມ​ບາບ​ຂອງ​ແຜ່ນດິນ</char></note> ປະເທດ​ນັ້ນ​ກໍ​ຈະ​ມີ​ຜູ້ປົກຄອງ​ຫລາຍ​ຄົນ,</para>
  <para style="q2" vid="PRO 28:2">ແຕ່​ຜູ້​ປົກຄອງ​ທີ່​ມີ​ຄວາມ​ສະຫລາດ​ຫລັກແຫລມ ແລະ ມີ​ຄວາມຮູ້​ຮັກສາ​ຄວາມ​ເປັນ​ລະບຽບ​ໄວ້​ໄດ້.<verse eid="PRO 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />ຜູ້ປົກຄອງ<note caller="+" style="f"><char style="fr" closed="false">28:3 </char><char style="ft" closed="false">ຫລື ຄົນ​ຍາກ​ຈົນ</char></note> ທີ່​ກົດຂີ່​ຄົນ​ທຸກຍາກ</para>
  <para style="q2" vid="PRO 28:3">ກໍ​ເປັນ​ເໝືອນ​ຝົນ​ຕົກ​ໜັກ​ທີ່​ທຳລາຍ​ຜົນລະປູກ.<verse eid="PRO 28:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />ຜູ້​ທີ່​ປະຖິ້ມ​ກົດບັນຍັດ​ກໍ​ຍົກຍ້ອງ​ຄົນ​ຊົ່ວຮ້າຍ,</para>
  <para style="q2" vid="PRO 28:4">ແຕ່​ຜູ້ທີ່​ຮັກສາ​ກົດບັນຍັດ​ກໍ​ຕໍ່ຕ້ານ​ຄົນ​ຊົ່ວຮ້າຍ.<verse eid="PRO 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />ຄົນ​ທີ່​ເຮັດ​ຊົ່ວ​ບໍ່​ເຂົ້າໃຈ​ສິ່ງ​ທີ່​ຖືກຕ້ອງ,</para>
  <para style="q2" vid="PRO 28:5">ແຕ່​ຜູ້​ທີ່​ສະແຫວງຫາ​ພຣະເຈົ້າ​ຢາເວ​ມີ​ຄວາມ​ເຂົ້າໃຈ​ຢ່າງ​ແທ້ຈິງ.<verse eid="PRO 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />ເປັນ​ຄົນ​ທຸກຍາກ​ທີ່​ດຳເນີນ​ຊີວິດ​ຢ່າງ​ບໍ່​ມີ​ຕຳໜິ</para>
  <para style="q2" vid="PRO 28:6">ກໍ​ດີ​ກວ່າ​ເປັນ​ຄົນ​ຮັ່ງມີ​ທີ່​ຢູ່​ໃນ​ທາງ​ຄົດ​ໂກງ.<verse eid="PRO 28:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />ລູກ​ທີ່​ສະຫລາດ​ກໍ​ປະຕິບັດ​ຕາມ​ຄຳສັ່ງສອນ,</para>
  <para style="q2" vid="PRO 28:7">ແຕ່​ລູກ​ທີ່​ມີ​ໝູ່​ເປັນ​ຄົນ​ຂີ້ໂລບ​ກໍ​ເຮັດ​ໃຫ້​ພໍ່​ຂອງ​ຕົນ​ອັບອາຍ​ຂາຍໜ້າ.<verse eid="PRO 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />ຜູ້​ທີ່​ຮັ່ງມີ​ເພີ່ມ​ຂຶ້ນ​ດ້ວຍ​ດອກ​ເບ້ຍ ຫລື ຜົນກໍາໄລ​ຈາກ​ຄົນ​ທຸກຍາກ</para>
  <para style="q2" vid="PRO 28:8">ກໍ​ສະສົມ​ໄວ້​ໃຫ້​ຄືນອື່ນ, ທີ່​ເມດຕາ​ຕໍ່​ຄົນ​ທຸກຍາກ.<verse eid="PRO 28:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />ຜູ້​ທີ່​ປິດ​ຫູ​ບໍ່​ຍອມ​ຟັງ​ຄຳສັ່ງສອນ​ຂອງ​ພຣະເຈົ້າ,</para>
  <para style="q2" vid="PRO 28:9">ແມ່ນ​ແຕ່​ຄຳພາວັນນາ​ອະທິຖານ​ຂອງ​ພວກເຂົາ​ກໍ​ເປັນ​ທີ່​ກຽດຊັງ.<verse eid="PRO 28:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />ຜູ້​ທີ່​ນໍາ​ພາ​ຄົນ​ທ່ຽງທຳ​ໄປ​ໃນ​ທາງ​ຊົ່ວ</para>
  <para style="q2" vid="PRO 28:10">ຈະ​ຕົກລົງ​ໄປ​ໃນ​ບ້ວງແຮ້ວ​ຂອງ​ຕົນ​ເອງ,</para>
  <para style="q2" vid="PRO 28:10">ແຕ່​ຜູ້​ທີ່​ບໍ່​ມີ​ຕຳໜິ​ຈະ​ໄດ້​ຮັບ​ສິ່ງ​ດີ​ເປັນ​ມໍລະດົກ.<verse eid="PRO 28:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />ຄົນ​ຮັ່ງມີ​ມັກ​ຄິດ​ວ່າ​ຕົນ​ເປັນ​ຄົນ​ມີ​ປັນຍາ;</para>
  <para style="q2" vid="PRO 28:11">ແຕ່​ຄົນ​ທຸກຈົນ ແລະ ຄົນ​ສະຫລາດ​ເຫັນ​ວ່າ​ພວກເຂົາ​ເປັນ​ຄົນ​ຫລອກລວງ​ຫລາຍ​ສໍ່າໃດ.<verse eid="PRO 28:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />ເມື່ອ​ຄົນ​ຊອບທຳ​ມີ​ໄຊຊະນະ, ກໍ​ປິຕິ​ຍິນດີ​ຢ່າງ​ຍິ່ງ;</para>
  <para style="q2" vid="PRO 28:12">ແຕ່​ເມື່ອ​ຄົນ​ຊົ່ວຮ້າຍ​ຂຶ້ນ​ມີ​ອຳນາດ, ປະຊາຊົນ​ກໍ​ພາກັນ​ໄປ​ຫລົບລີ້.<verse eid="PRO 28:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />ຜູ້​ທີ່​ປົກປິດ​ບາບ​ຂອງ​ຕົນ​ຈະ​ບໍ່​ຈະເລີນ​ຮຸ່ງເຮືອງ,</para>
  <para style="q2" vid="PRO 28:13">ແຕ່​ຜູ້​ທີ່​ສາລະພາບ​ບາບ ແລະ ປະຖິ້ມ​ບາບ​ນັ້ນ​ຈະ​ໄດ້​ຮັບ​ຄວາມ​ເມດຕາ.<verse eid="PRO 28:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />ຄວາມ​ສຸກ​ເປັນ​ຂອງ​ຜູ້ທີ່​ຢຳເກງ​ພຣະເຈົ້າ​ຢູ່​ສະເໝີ,</para>
  <para style="q2" vid="PRO 28:14">ແຕ່​ຜູ້​ທີ່​ເຮັດ​ໃຈ​ແຂງ​ກະດ້າງ​ຈະ​ຕົກ​ຢູ່​ໃນ​ຄວາມ​ເດືອດຮ້ອນ.<verse eid="PRO 28:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />ຜູ້​ປົກຄອງ​ຊົ່ວ​ປົກຄອງ​ຄົນ​ທຸກຍາກ</para>
  <para style="q2" vid="PRO 28:15">ກໍ​ເໝືອນ​ດັ່ງ​ໂຕສິງ​ທີ່​ຮ້ອງ​ແຜດ​ສຽງ ຫລື ໝີ​ທີ່​ພ້ອມ​ໂດດ​ຄຸບ.<verse eid="PRO 28:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />ຜູ້ປົກຄອງ​ທີ່​ຂາດ​ຄວາມ​ເຂົ້າໃຈ​ກໍ​ຂູດຮີດ​ປະຊາຊົນ,</para>
  <para style="q2" vid="PRO 28:16">ແຕ່​ຜູ້​ທີ່​ກຽດຊັງ​ຜົນປະໂຫຍດ​ທີ່​ໄດ້​ມາ​ໂດຍ​ບໍ່​ຖືກຕ້ອງ​ຈະ​ໄດ້​ປົກຄອງ​ຍາວນານ.<verse eid="PRO 28:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />ຜູ້ໃດ​ທຸກ​ທໍລະມານ​ຍ້ອນ​ຄວາມ​ຜິດ​ຈາກ​ການ​ຂ້າ​ຄົນ</para>
  <para style="q2" vid="PRO 28:17">ຈະ​ຊອກຫາ​ບ່ອນ​ຫລົບ​ໄພ​ໃນ​ຂຸມ​ຝັງສົບ;</para>
  <para style="q2" vid="PRO 28:17">ຢ່າ​ໃຫ້​ຜູ້​ໃດ​ຖ່ວງ​ພວກເຂົາ​ໄວ້.<verse eid="PRO 28:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />ຄົນ​ທີ່​ດຳເນີນ​ຊີວິດ​ຢ່າງ​ບໍ່​ມີ​ຕຳໜິ​ຈະ​ໄດ້​ຮັບ​ຄວາມ​ປອດໄພ,</para>
  <para style="q2" vid="PRO 28:18">ແຕ່​ຄົນ​ທີ່​ຢູ່​ໃນ​ທາງ​ຄົດ​ໂກງ​ຈະ​ຕົກລົງ​ໄປ​ໃນ​ຂຸມ​ເລິກ.<verse eid="PRO 28:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />ຜູ້​ທີ່​ເຮັດວຽກ​ໄຖ​ດິນ​ຂອງ​ຕົນ​ຈະ​ມີ​ອາຫານ​ຢ່າງ​ອຸດົມ​ສົມບູນ,</para>
  <para style="q2" vid="PRO 28:19">ແຕ່​ຄົນ​ທີ່​ມີ​ແຕ່​ໃຝ່ຝັນ​ກໍ​ຈະ​ມີ​ຄວາມ​ທຸກຍາກ.<verse eid="PRO 28:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />ຄົນ​ສັດຊື່​ຈະ​ໄດ້​ຮັບ​ພຣະພອນ​ຢ່າງ​ລົ້ນເຫລືອ,</para>
  <para style="q2" vid="PRO 28:20">ແຕ່​ຄົນ​ທີ່​ຢາກ​ຮັ່ງມີ​ທາງ​ລັດ​ກໍ​ຈະ​ໜີ​ບໍ່​ພົ້ນໂທດ.<verse eid="PRO 28:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />ຄວາມ​ລໍາອຽງ​ເປັນ​ສິ່ງ​ທີ່​ບໍ່​ດີ</para>
  <para style="q2" vid="PRO 28:21">ແຕ່​ກໍ​ຍັງ​ມີ​ຄົນ​ເຮັດ​ຜິດ​ເພື່ອ​ແລກ​ກັບ​ເຂົ້າຈີ່​ປ່ຽງ​ດຽວ.<verse eid="PRO 28:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />ຄົນ​ເຫັນ​ແກ່​ຕົວ​ກໍ​ຢາກ​ຮັ່ງມີ​ໄວ</para>
  <para style="q2" vid="PRO 28:22">ແລະ ຄວາມ​ທຸກຍາກ​ລໍ​ຖ້າ​ພວກເຂົາ​ໂດຍ​ທີ່​ບໍ່​ຮູ້​ໂຕ.<verse eid="PRO 28:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />ຜູ້​ທີ່​ຕິຕຽນ​ຄົນ​ແບບ​ເຊິ່ງ​ໜ້າ​ຈະ​ໄດ້​ຮັບ​ການ​ຊົມເຊີຍ​ໃນ​ບັ້ນປາຍ</para>
  <para style="q2" vid="PRO 28:23">ຫລາຍ​ກວ່າ​ຜູ້​ທີ່​ເວົ້າ​ປະຈົບ​ປະແຈງ.<verse eid="PRO 28:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />ລູກ​ທີ່​ປຸ້ນ​ພໍ່ ຫລື ແມ່​ຂອງ​ຕົນ</para>
  <para style="q2" vid="PRO 28:24">ແລະ ເວົ້າ​ວ່າ, “ມັນ​ບໍ່​ຜິດ”,</para>
  <para style="q2" vid="PRO 28:24">ກໍ​ເປັນ​ໝູ່ເພື່ອນ​ກັບ​ຄົນ​ຂີ້ລັກ.<verse eid="PRO 28:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />ຄົນ​ເຫັນແກ່ຕົວ​ກໍ​ເຮັດ​ໃຫ້​ເກີດ​ການ​ຜິດຖຽງກັນ,</para>
  <para style="q2" vid="PRO 28:25">ແຕ່​ຜູ້​ທີ່​ໄວ້ວາງໃຈ​ໃນ​ພຣະເຈົ້າ​ຢາເວ​ຈະ​ຈະເລີນ​ຮຸ່ງເຮືອງ.<verse eid="PRO 28:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />ຜູ້​ທີ່​ໄວ້ວາງໃຈ​ໃນ​ຕົນເອງ​ກໍ​ເປັນ​ຄົນ​ໂງ່ຈ້າ,</para>
  <para style="q2" vid="PRO 28:26">ແຕ່​ຜູ້​ທີ່​ດຳເນີນ​ຕາມ​ຄົນ​ມີ​ປັນຍາ​ຈະ​ໄດ້​ຮັບ​ການ​ປົກປ້ອງ​ໃຫ້​ປອດໄພ.<verse eid="PRO 28:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />ຜູ້​ທີ່​ເອົາ​ໃຫ້​ຄົນ​ທຸກຍາກ​ຈະ​ບໍ່​ຂັດສົນ,</para>
  <para style="q2" vid="PRO 28:27">ແຕ່​ຜູ້​ທີ່​ເມີນເສີຍ​ຕໍ່​ພວກເຂົາ​ຈະ​ຖືກ​ສາບແຊ່ງ​ຢ່າງ​ຫລວງຫລາຍ.<verse eid="PRO 28:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />ເມື່ອ​ຄົນ​ຊົ່ວຮ້າຍ​ຂຶ້ນ​ມີ​ອຳນາດ, ປະຊາຊົນ​ກໍ​ພາກັນ​ໄປ​ຫລົບລີ້;</para>
  <para style="q2" vid="PRO 28:28">ແຕ່​ເມື່ອ​ຄົນ​ຊົ່ວຮ້າຍ​ຈິບຫາຍ​ໄປ, ຄົນ​ຊອບທຳ​ກໍ​ຈະເລີນ​ຮຸ່ງເຮືອງ.<verse eid="PRO 28:28" /></para>
  <para style="b" />
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />ຜູ້​ທີ່​ຖືກ​ຕັກເຕືອນ​ຫລາຍ​ເທື່ອ​ແຕ່​ຍັງ​ດື້ດ້ານ</para>
  <para style="q2" vid="PRO 29:1">ຈະ​ຖືກ​ທໍາລາຍ​ທັນທີ​ໂດຍ​ບໍ່​ມີ​ທາງ​ແກ້ໄຂ.<verse eid="PRO 29:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />ເມື່ອ​ຄົນ​ຊອບທຳ​ປົກຄອງ, ປະຊາຊົນ​ກໍ​ຊື່ນຊົມຍິນດີ;</para>
  <para style="q2" vid="PRO 29:2">ເມື່ອ​ຄົນ​ຊົ່ວຮ້າຍ​ຂຶ້ນ​ປົກຄອງ, ປະຊາຊົນ​ກໍ​ຮ້ອງ​ຄວນຄາງ.<verse eid="PRO 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />ລູກ​ທີ່​ຮັກ​ປັນຍາ​ເຮັດ​ໃຫ້​ພໍ່​ຂອງ​ຕົນ​ມີ​ຄວາມ​ສຸກ,</para>
  <para style="q2" vid="PRO 29:3">ແຕ່​ຄົນ​ທີ່​ຄົບ​ກັບ​ໂສເພນີ​ກໍ​ຜານ​ຊັບສົມບັດ​ຂອງ​ຕົນ.<verse eid="PRO 29:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />ກະສັດ​ເຮັດໃຫ້​ປະເທດຊາດ​ໝັ້ນຄົງ​ດ້ວຍ​ຄວາມ​ຍຸຕິທຳ,</para>
  <para style="q2" vid="PRO 29:4">ແຕ່​ກະສັດ​ທີ່​ໂລບ​ສິນບົນ<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">ຫລື ໃຫ້​ສິນ​ບົນ</char></note> ກໍ​ທຳລາຍ​ປະເທດ​ຊາດ​ໃຫ້​ຫລົ້ມຈົມ​ລົງ.<verse eid="PRO 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />ຜູ້​ທີ່​ປະຈົບ​ປະແຈງ​ເພື່ອນບ້ານ​ຂອງ​ຕົນ</para>
  <para style="q2" vid="PRO 29:5">ກໍ​ຫ້າງ​ແຮ້ວ​ໃສ່​ຕີນ​ຂອງ​ຕົນເອງ.<note caller="+" style="f"><char style="fr" closed="false">29:5 </char><char style="ft" closed="false">ຫລື ຂອງ​ເຂົາ</char></note><verse eid="PRO 29:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />ຄົນ​ເຮັດ​ຊົ່ວ​ກໍ​ຖືກ​ບ້ວງແຮ້ວ​ເພາະ​ບາບກຳ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 29:6">ແຕ່​ຄົນ​ຊອບທຳ​ຮ້ອງໂຮ​ຢ່າງ​ມີ​ຄວາມ​ສຸກ ແລະ ດ້ວຍ​ຄວາມ​ດີໃຈ.<verse eid="PRO 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />ຄົນ​ຊອບທຳ​ກໍ​ເປັນ​ຫວງ​ນໍາ​ຄວາມ​ຍຸຕິທຳ​ເພື່ອ​ຄົນ​ທຸກຍາກ,</para>
  <para style="q2" vid="PRO 29:7">ແຕ່​ຄົນ​ຊົ່ວຮ້າຍ​ບໍ່​ມີ​ຄວາມ​ກັງວົນ​ເລີຍ.<verse eid="PRO 29:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />ຄົນ​ມັກ​ເຢາະເຍີ້ຍ​ເຮັດ​ໃຫ້​ບ້ານ​ເມືອງ​ວຸ້ນວາຍ,</para>
  <para style="q2" vid="PRO 29:8">ແຕ່​ຄົນ​ມີ​ປັນຍາ​ເຮັດ​ໃຫ້​ຄວາມ​ໃຈຮ້າຍ​ສະຫງົບ​ລົງ.<verse eid="PRO 29:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />ຖ້າ​ຄົນ​ມີ​ປັນຍາ​ໄປ​ຂຶ້ນ​ສານ​ກັບ​ຄົນ​ໂງ່ຈ້າ,</para>
  <para style="q2" vid="PRO 29:9">ຄົນ​ໂງ່ຈ້າ​ກໍ​ສະແດງ​ຄວາມ​ໂມໂຫ, ເວົ້າ​ເຢາະເຢີ້ຍ ແລະ ບໍ່​ມີ​ຄວາມ​ສະຫງົບສຸກ.<verse eid="PRO 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />ຄົນ​ກະຫາຍ​ເລືອດ​ກຽດຊັງ​ຄົນ​ສັດຊື່</para>
  <para style="q2" vid="PRO 29:10">ແລະ ຊອກ​ຫາ​ທາງ​ຂ້າ​ຜູ້​ທີ່​ທ່ຽງທຳ.<verse eid="PRO 29:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />ຄົນ​ໂງ່ຈ້າ​ກໍ​ລະບາຍ​ຄວາມ​ໂມໂຫ​ຂອງ​ຕົນ,</para>
  <para style="q2" vid="PRO 29:11">ແຕ່​ຄົນ​ມີ​ປັນຍາ​ນໍາ​ເອົາ​ຄວາມ​ສະຫງົບ​ມາ​ໃນ​ທີ່​ສຸດ.<verse eid="PRO 29:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />ຖ້າ​ຜູ້ປົກຄອງ​ຟັງ​ຄວາມ​ຕົວະ,</para>
  <para style="q2" vid="PRO 29:12">ຂ້າລາຊະການ​ທັງໝົດ​ຂອງ​ເພິ່ນ​ຈະ​ກາຍເປັນ​ຄົນ​ຊົ່ວຮ້າຍ​ໄປ​ນໍາ.<verse eid="PRO 29:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />ຄົນ​ທຸກຍາກ ແລະ ຜູ້​ຂົ່ມເຫັງ​ກໍ​ມີ​ສິ່ງ​ໜຶ່ງ​ຄືກັນ​ຄື:</para>
  <para style="q2" vid="PRO 29:13">ພຣະເຈົ້າ​ຢາເວ​ໃຫ້​ສາຍຕາ​ທີ່ເບິ່ງ​ເຫັນ​ແກ່​ພວກເຂົາ​ທັງສອງ.<verse eid="PRO 29:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />ຖ້າ​ກະສັດ​ຕັດສິນ​ຄວາມ​ຄົນ​ທຸກຍາກ​ຢ່າງ​ຍຸຕິທໍາ,</para>
  <para style="q2" vid="PRO 29:14">ບັນລັງ​ຂອງ​ເພິ່ນ​ກໍ​ຈະ​ໝັ້ນຄົງ​ຕະຫລອດໄປ.<verse eid="PRO 29:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />ໄມ້​ແສ້ ແລະ ຄຳ​ຕຳໜິ​ຕິຕຽນ​ເຮັດ​ໃຫ້​ເກີດ​ປັນຍາ,</para>
  <para style="q2" vid="PRO 29:15">ແຕ່​ເດັກນ້ອຍ​ທີ່​ບໍ່​ມີ​ລະບຽບ​ວິໄນ​ເຮັດ​ໃຫ້​ແມ່​ຂອງ​ຕົນ​ອັບອາຍ​ຂາຍໜ້າ.<verse eid="PRO 29:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />ເມື່ອ​ຄົນ​ຊົ່ວຮ້າຍ​ຈະເລີນ, ຄວາມ​ບາບ​ກໍ​ເພີ່ມ​ທະວີ​ຂຶ້ນ,</para>
  <para style="q2" vid="PRO 29:16">ແຕ່​ຄົນ​ຊອບທຳ​ຈະ​ເຫັນ​ຄວາມ​ຫລົ້ມຈົມ​ຂອງ​ພວກເຂົາ.<verse eid="PRO 29:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />ຈົ່ງ​ອົບຮົມ​ບົ່ມ​ສອນ​ລູກ​ຂອງ​ເຈົ້າ, ແລ້ວ​ພວກເຂົາ​ຈະ​ໃຫ້​ສັນຕິສຸກ​ແກ່​ເຈົ້າ;</para>
  <para style="q2" vid="PRO 29:17">ພວກເຂົາ​ຈະ​ໃຫ້​ຄວາມ​ຍິນດີ​ຕາມ​ທີ່​ເຈົ້າ​ປາຖະໜາ.<verse eid="PRO 29:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />ບ່ອນ​ທີ່​ບໍ່​ມີ​ນິມິດ, ປະຊາຊົນ​ກໍ​ປະ​ຖິ້ມ​ການ​ຄວບຄຸມ​ອາລົມ;</para>
  <para style="q2" vid="PRO 29:18">ແຕ່​ຄວາມ​ສຸກ​ເປັນ​ຂອງ​ຜູ້​ທີ່​ຍອມຮັບ​ຄຳສັ່ງສອນ​ແຫ່ງ​ປັນຍາ.<verse eid="PRO 29:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />ຄົນ​ຮັບໃຊ້​ຈະ​ໄດ້​ຮັບ​ການ​ອົບຮົມ​ບົ່ມ​ສອນ​ດ້ວຍ​ຄຳເວົ້າ​ຢ່າງ​ດຽວ​ບໍ່​ໄດ້.</para>
  <para style="q2" vid="PRO 29:19">ເຖິງແມ່ນວ່າ​ພວກເຂົາ​ເຂົ້າໃຈ, ແຕ່​ພວກເຂົາ​ຈະ​ບໍ່​ຍອມ​ເຮັດ​ຕາມ.<verse eid="PRO 29:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />ເຈົ້າ​ເຫັນ​ຄົນ​ທີ່​ມັກ​ເວົ້າ​ແບບ​ບໍ່​ຄິດ​ບໍ?</para>
  <para style="q2" vid="PRO 29:20">ຄົນ​ໂງ່ຈ້າ​ກໍ​ມີ​ຄວາມ​ຫວັງ​ຫລາຍກວ່າ​ພວກເຂົາ.<verse eid="PRO 29:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />ການ​ເຮັດ​ຕາມ​ໃຈ​ຄົນ​ຮັບໃຊ້​ຕັ້ງແຕ່​ຍັງ​ນ້ອຍ,</para>
  <para style="q2" vid="PRO 29:21">ລາວ​ຈະ​ກາຍ​ເປັນ​ຄົນ​ຈອງຫອງ.<note caller="+" style="f"><char style="fr" closed="false">29:21 </char><char style="ft" closed="false">ຫລື ເຂົາ​ຈະ​ກາຍເປັນ​ລູກ ຫລື ເຂົາ​ຈະ​ກາຍເປັນ​ຜູ້​ຮັບ​ມໍລະດົກ</char></note><verse eid="PRO 29:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />ຄົນ​ທີ່​ໃຈຮ້າຍ​ງ່າຍ​ກໍ​ເຮັດ​ໃຫ້​ເກີດ​ການ​ຜິດຖຽງ​ກັນ,</para>
  <para style="q2" vid="PRO 29:22">ແລະ ຄົນ​ໃຈ​ຮ້ອນ​ເຮັດ​ບາບ​ຢ່າງ​ຫລວງຫລາຍ.<verse eid="PRO 29:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />ການ​ໂອ້ອວດ​ເຮັດ​ໃຫ້​ຄົນ​ຕົກຕ່ຳ​ລົງ,</para>
  <para style="q2" vid="PRO 29:23">ແຕ່​ຜູ້​ທີ່​ມີ​ໃຈ​ຖ່ອມ​ຈະ​ໄດ້​ຮັບ​ກຽດ.<verse eid="PRO 29:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />ການ​ສົມຮູ້​ຮ່ວມ​ຄິດ​ກັບ​ຄົນ​ຂີ້ລັກ​ກໍ​ເປັນ​ສັດຕູ​ຕໍ່​ຕົນເອງ;</para>
  <para style="q2" vid="PRO 29:24">ພວກເຂົາ​ຕ້ອງ​ສາບານ ແຕ່​ບໍ່​ກ້າ​ເປັນ​ພະຍານ.<verse eid="PRO 29:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />ຄວາມ​ຢ້ານ​ຂອງ​ຄົນ​ຈະ​ເປັນ​ການ​ຫ້າງ​ແຮ້ວ,</para>
  <para style="q2" vid="PRO 29:25">ແຕ່​ຜູ້​ທີ່​ໄວ້ວາງໃຈ​ໃນ​ພຣະເຈົ້າ​ຢາເວ​ກໍ​ປອດໄພ.<verse eid="PRO 29:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />ຫລາຍ​ຄົນ​ເຂົ້າ​ຫາ​ຜູ້​ທີ່​ມີ​ອໍານາດ,</para>
  <para style="q2" vid="PRO 29:26">ແຕ່​ຄົນ​ໄດ້​ຮັບ​ຄວາມ​ຍຸຕິທຳ​ມາ​ຈາກ​ພຣະເຈົ້າ​ຢາເວ.<verse eid="PRO 29:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />ຄົນ​ຊອບທຳ​ກຽດຊັງ​ຄົນ​ບໍ່​ສັດຊື່;</para>
  <para style="q2" vid="PRO 29:27">ແຕ່​ຄົນ​ຊົ່ວຮ້າຍ​ກຽດຊັງ​ຄົນ​ທ່ຽງທໍາ.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="ms1">ຄຳສອນ​ຂອງ​ອາກູ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />ນີ້​ແມ່ນ​ຄຳສອນ​ຂອງ​ອາກູ​ລູກຊາຍ​ຂອງ​ຢາເກ ເປັນ​ຄຳເວົ້າ​ທີ່​ໄດ້​ຮັບ​ການ​ດົນໃຈ.<note caller="+" style="f"><char style="fr" closed="false">30:1 </char><char style="ft" closed="false">ຫລື ຄຳ​ສອນ​ຂອງ​ອາກູ​ບຸດ​ຢາເກ​ແຫ່ງ​ມັດສາ</char></note></para>
  <para style="q1" vid="PRO 30:1">ຊາຍ​ຄົນ​ນີ້​ທີ່​ເວົ້າ​ກັບ​ອິທີເອນ​ວ່າ:</para>
  <para style="b" vid="PRO 30:1" />
  <para style="q1" vid="PRO 30:1">“ຂ້າແດ່​ພຣະເຈົ້າ, ຂ້ານ້ອຍ​ອ່ອນ​ແຮງ​ຫລາຍ</para>
  <para style="q2" vid="PRO 30:1">ແຕ່​ຂ້ານ້ອຍ​ມີ​ໄຊຊະນະ​ໄດ້.<note caller="+" style="f"><char style="fr" closed="false">30:1 </char><char style="ft" closed="false">ໃນ​ພາສາ​ເຮັບເຣີ​ອາດ​ມີ​ຄວາມຫມາຍ​ອີກ​ຢ່າງ​ໜຶ່ງ​ວ່າ ລາວ​ເວົ້າ​ກັບ​ອີທຽນ ກັບ​ອີທຽນ ແລະ ກັບ​ອູກາເສ​ວ່າ ຫລື </char><char style="fqa" closed="false">ຂ້າແດ່​ພຣະເຈົ້າ ຂ້ານ້ອຍ​ອ່ອນ​ລ້າ ຂ້າແດ່​ພຣະເຈົ້າ ຂ້ານ້ອຍ​ອ່ອນ​ລ້າ ແລະ ອິດອ່ອນ​ເມື່ອຍ​ແຮງ</char></note><verse eid="PRO 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />ແນ່ນອນ​ວ່າ ຂ້ານ້ອຍ​ເປັນ​ພຽງ​ສັດ​ໂຕ​ໜຶ່ງ, ບໍ່​ແມ່ນ​ມະນຸດ;</para>
  <para style="q2" vid="PRO 30:2">ຂ້ານ້ອຍ​ຈຶ່ງ​ບໍ່​ມີ​ຄວາມ​ເຂົ້າໃຈ​ແບບ​ມະນຸດ.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />ຂ້ານ້ອຍ​ບໍ່​ໄດ້​ຮຽນຮູ້​ເລື່ອງ​ປັນຍາ,</para>
  <para style="q2" vid="PRO 30:3">ແລະ ບໍ່​ໄດ້​ຮູ້​ເຖິງ​ຄວາມ​ຮອບຮູ້​ຂອງ​ອົງ​ບໍລິສຸດ.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />ຜູ້ໃດ​ໄດ້​ຂຶ້ນ​ໄປ​ສະຫວັນ ແລະ ລົງ​ມາ​ຈາກ​ສະຫວັນ?</para>
  <para style="q2" vid="PRO 30:4">ຜູ້ໃດ​ແດ່​ຈັບ​ລົມ​ໄວ້​ໃນ​ມື?</para>
  <para style="q1" vid="PRO 30:4">ຜູ້ໃດ​ແດ່​ຫໍ່​ນ້ຳ​ໄວ້​ໃນ​ເສື້ອຄຸມ​ໄດ້?</para>
  <para style="q2" vid="PRO 30:4">ຜູ້ໃດ​ຕັ້ງ​ທີ່​ສຸດປາຍ​ຂອງ​ແຜ່ນດິນ​ໂລກ?</para>
  <para style="q1" vid="PRO 30:4">ເພິ່ນ​ຊື່​ຫຍັງ? ແລະ ລູກ​ຂອງ​ເພິ່ນ​ຊື່​ຫຍັງ?</para>
  <para style="q2" vid="PRO 30:4">ແນ່ນອນ​ວ່າ ເຈົ້າ​ຮູ້!<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />“ທຸກ​ຖ້ອຍຄໍາ​ຂອງ​ພຣະເຈົ້າ​ບໍ່​ມີ​ຕໍາໜິ;</para>
  <para style="q2" vid="PRO 30:5">ພຣະອົງ​ເປັນ​ໂລ່​ໃຫ້​ແກ່​ບັນດາ​ຜູ້​ທີ່​ລີ້ໄພ​ໃນ​ພຣະອົງ.<note caller="+" style="f"><char style="fr" closed="false">30:5 </char><char style="ft" closed="false">ເບິ່ງ <char style="xt">2ຊມອ 22:31-32</char> ແລະ <char style="xt">ພສສ 18:30-31</char></char></note><verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />ຢ່າ​ຕື່ມ​ຫຍັງ​ໃສ່​ຖ້ອຍຄໍາ​ຂອງ​ພຣະອົງ,</para>
  <para style="q2" vid="PRO 30:6">ບໍ່​ດັ່ງນັ້ນ ພຣະອົງ​ຈະ​ຕຳໜິ​ເຈົ້າ ແລະ ພິສູດ​ໃຫ້​ເຫັນ​ວ່າ​ເຈົ້າ​ເປັນ​ຄົນ​ຂີ້ຕົວະ.<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />“ມີ​ສອງ​ຢ່າງ​ທີ່​ຂ້ານ້ອຍ​ຂໍ​ຈາກ​ພຣະເຈົ້າ​ຢາເວ;</para>
  <para style="q2" vid="PRO 30:7">ຂໍ​ຢ່າ​ປະຕິເສດ​ກ່ອນ​ທີ່​ຂ້ານ້ອຍ​ຈະ​ຕາຍ​ໄປ​ຄື:<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />ຂໍ​ໃຫ້​ການ​ຫລອກລວງ ແລະ ຄວາມ​ຕົວະ​ຫ່າງ​ໄກ​ຈາກ​ຂ້ານ້ອຍ;</para>
  <para style="q2" vid="PRO 30:8">ຂໍ​ຢ່າ​ໃຫ້​ຂ້ານ້ອຍ​ທຸກຍາກ ຫລື ຮັ່ງມີ,</para>
  <para style="q2" vid="PRO 30:8">ແຕ່​ຂໍ​ໂຜດ​ໃຫ້​ອາຫານ​ປະຈຳວັນ​ແກ່​ຂ້ານ້ອຍ​ເທົ່ານັ້ນ.<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />ບໍ່​ດັ່ງນັ້ນ, ຂ້ານ້ອຍ​ອາດ​ຈະ​ມີ​ຫລາຍ​ເກີນໄປ ແລ້ວ​ປະຕິເສດ​ພຣະອົງ</para>
  <para style="q2" vid="PRO 30:9">ແລະ ເວົ້າ​ວ່າ, ‘ພຣະເຈົ້າ​ຢາເວ​ແມ່ນ​ຜູ້ໃດ?’</para>
  <para style="q1" vid="PRO 30:9">ຫລື ຂ້ານ້ອຍ​ອາດຈະ​ກາຍ​ເປັນ​ຄົນ​ທຸກຍາກ ແລ້ວ​ກາຍ​ເປັນ​ຄົນ​ຂີ້ລັກ,</para>
  <para style="q2" vid="PRO 30:9">ແລະ​ເຮັດ​ໃຫ້​ນາມ​ຊື່​ຂອງ​ພຣະເຈົ້າ​ຂອງ​ຂ້ານ້ອຍ​ເສື່ອມເສຍ.<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />“ຢ່າ​ເວົ້າ​ໃສ່ຮ້າຍ​ຄົນ​ຮັບໃຊ້​ໃຫ້​ນາຍ​ຂອງ​ພວກເຂົາ​ຟັງ,</para>
  <para style="q2" vid="PRO 30:10">ບໍ່ດັ່ງນັ້ນ ພວກເຂົາ​ຈະ​ສາບແຊ່ງ​ເຈົ້າ, ແລະ ເຈົ້າ​ຈະ​ຖືກ​ລົງໂທດ.<verse eid="PRO 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />“ມີ​ບາງ​ຄົນ​ສາບແຊ່ງ​ພໍ່​ຂອງ​ຕົນເອງ</para>
  <para style="q2" vid="PRO 30:11">ແລະ ບໍ່​ອວຍພອນ​ແມ່​ຂອງ​ຕົນ;<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />ບາງຄົນ​ຄິດ​ວ່າ​ຕົນ​ເອງ​ບໍລິສຸດ</para>
  <para style="q2" vid="PRO 30:12">ແລະ ຍັງ​ບໍ່​ໄດ້​ຮັບ​ການ​ຊຳລະ​ລ້າງ​ມົນທິນ​ຂອງ​ຕົນ;<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />ຄົນເຫລົ່ານັ້ນ​ມີ​ຕາ​ທີ່​ອວດອົງ​ຈອງຫອງ​ຕະຫລອດ,</para>
  <para style="q2" vid="PRO 30:13">ຄື​ຄົນ​ທີ່​ມີ​ສາຍຕາ​ມັກ​ໝິ່ນປະໝາດ​ຜູ້​ອື່ນ;<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />ບາງຄົນ​ແຂ້ວ​ຄື​ກັນ​ກັບ​ດາບ</para>
  <para style="q2" vid="PRO 30:14">ແລະ ບາງຄົນ​ປາກ​ຄົມ​ຄື​ກັນ​ກັບ​ມີດ</para>
  <para style="q1" vid="PRO 30:14">ເພື່ອ​ກືນ​ກິນ​ຄົນ​ທຸກຍາກ​ໄປ​ຈາກ​ແຜ່ນດິນ​ໂລກ</para>
  <para style="q2" vid="PRO 30:14">ແລະ ຄົນ​ຂັດສົນ​ອອກ​ຈາກ​ທ່າມກາງ​ມະນຸດ.<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />“ໂຕປີງ​ມີ​ລູກສາວ​ສອງ​ຄົນ</para>
  <para style="q2" vid="PRO 30:15">ພວກມັນ​ຮ້ອງ​ວ່າ ‘ເອົາມາ! ເອົາມາ!’</para>
  <para style="b" vid="PRO 30:15" />
  <para style="li1" vid="PRO 30:15">“ມີ​ສາມ​ສິ່ງ​ທີ່​ບໍ່​ເຄີຍ​ອີ່ມ​ຈັກ​ເທື່ອ,</para>
  <para style="li2" vid="PRO 30:15">ມີ​ສີ່​ສິ່ງ​ທີ່​ບໍ່​ເຄີຍ​ເວົ້າ​ວ່າ ‘ພໍ​ແລ້ວ!’ ຄື:<verse eid="PRO 30:15" /></para>
  <para style="li3">
    <verse number="16" style="v" sid="PRO 30:16" />ຂຸມ​ຝັງສົບ</para>
  <para style="li3" vid="PRO 30:16">ແລະ ມົດລູກ​ທີ່​ເປັນ​ໝັນ;</para>
  <para style="li3" vid="PRO 30:16">ດິນແດນ​ບໍ່​ເຄີຍ​ອີ່ມ​ນ້ຳ,</para>
  <para style="li3" vid="PRO 30:16">ແລະ ໄຟ, ທີ່​ບໍ່​ເຄີຍ​ເວົ້າ​ວ່າ ‘ພໍ​ແລ້ວ!’<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />“ຕາ​ທີ່​ເຢາະເຢີ້ຍ​ພໍ່,</para>
  <para style="q2" vid="PRO 30:17">ດູໜິ່ນ​ແມ່​ທີ່​ເຖົ້າ​ແກ່,</para>
  <para style="q1" vid="PRO 30:17">ຈະ​ຖືກ​ຝູງ​ກາ​ແຫ່ງ​ຮ່ອມພູ​ເຈາະ​ແກ່ນຕາ</para>
  <para style="q2" vid="PRO 30:17">ແລະ ຈະ​ຖືກ​ຝູງ​ແຮ້ງ​ກັດ​ກິນ.<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="18" style="v" sid="PRO 30:18" />“ມີ​ສາມ​ຢ່າງ​ທີ່​ເຮັດໃຫ້​ຂ້ອຍ​ອັດສະຈັນ​ໃຈ​ຫລາຍ​ທີ່​ສຸດ,</para>
  <para style="li2" vid="PRO 30:18">ມີ​ສີ່​ຢ່າງ​ທີ່​ຂ້ອຍ​ບໍ່​ເຂົ້າໃຈ​ຄື:<verse eid="PRO 30:18" /></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 30:19" />ການ​ບິນ​ຂອງ​ນົກອິນຊີ​ໃນ​ທ້ອງ​ຟ້າ,</para>
  <para style="li3" vid="PRO 30:19">ການ​ເລືອ​ຄານ​ຂອງ​ງູ​ເທິງ​ກ້ອນຫີນ,</para>
  <para style="li3" vid="PRO 30:19">ການ​ແລ່ນ​ຂອງ​ເຮືອ​ຢູ່​ໃນ​ທະເລ​ເລິກ,</para>
  <para style="li3" vid="PRO 30:19">ແລະ ຄວາມ​ຮັກ​ຂອງ​ຜູ້ຊາຍ​ກັບ​ຜູ້ຍິງ.<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />“ນີ້​ແມ່ນ​ການ​ປະພຶດ​ຂອງ​ຍິງ​ຫລິ້ນ​ຊູ້:</para>
  <para style="q2" vid="PRO 30:20">ນາງ​ກິນ​ແລ້ວ​ເຊັດ​ປາກ​ຂອງ​ຕົນ</para>
  <para style="q2" vid="PRO 30:20">ແລະ ເວົ້າ​ວ່າ, ‘ຂ້ອຍ​ບໍ່​ໄດ້​ເຮັດ​ຫຍັງ​ຜິດ’.<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="21" style="v" sid="PRO 30:21" />“ມີ​ສາມ​ຢ່າງ​ທີ່​ເຮັດ​ໃຫ້​ແຜ່ນດິນ​ໂລກ​ສັ່ນສະທ້ານ,</para>
  <para style="li2" vid="PRO 30:21">ມີ​ສີ່​ຢ່າງ​ທີ່​ແຜ່ນດິນ​ໂລກ​ຮັບ​ບໍ່​ໄດ້​ຄື:<verse eid="PRO 30:21" /></para>
  <para style="li3">
    <verse number="22" style="v" sid="PRO 30:22" />ຄົນ​ຮັບໃຊ້​ທີ່​ກາຍ​ເປັນ​ກະສັດ,</para>
  <para style="li3" vid="PRO 30:22">ຄົນ​ໂງ່ຈ້າ​ມີ​ອາຫານ​ກິນ​ຈົນ​ເຫລືອ​ເຟືອ,<verse eid="PRO 30:22" /></para>
  <para style="li3">
    <verse number="23" style="v" sid="PRO 30:23" />ຍິງ​ທີ່​ເປັນ​ຕາຊັງ​ໄດ້​ແຕ່ງງານ</para>
  <para style="li3" vid="PRO 30:23">ສາວໃຊ້​ທີ່​ຂຶ້ນ​ມາ​ແທນ​ທີ່​ນາຍຍິງ​ຂອງ​ຕົນ.<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="PRO 30:24" />“ມີ​ສີ່​ຢ່າງ​ໃນ​ແຜ່ນດິນ​ໂລກ​ທີ່​ມີ​ຂະໜາດ​ນ້ອຍ,</para>
  <para style="li2" vid="PRO 30:24">ແຕ່​ພວກມັນ​ສະຫລາດ​ທີ່​ສຸດ​ຄື:<verse eid="PRO 30:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="PRO 30:25" />ມົດ​ເປັນ​ສັດ​ທີ່​ມີ​ກຳລັງ​ນ້ອຍ,</para>
  <para style="li3" vid="PRO 30:25">ແຕ່​ພວກມັນ​ສະສົມ​ອາຫານ​ໄວ້​ໃນ​ລະດູ​ຮ້ອນ;<verse eid="PRO 30:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="PRO 30:26" />ຕຸ່ນ​ເປັນ​ສັດ​ທີ່​ບໍ່​ແຂງແຮງ,</para>
  <para style="li3" vid="PRO 30:26">ແຕ່​ພວກມັນ​ເຮັດ​ຮັງ​ເທິງ​ໂງ່ນຫີນ;<verse eid="PRO 30:26" /></para>
  <para style="li2">
    <verse number="27" style="v" sid="PRO 30:27" />ຕັກແຕນ​ບໍ່​ມີ​ກະສັດ,</para>
  <para style="li3" vid="PRO 30:27">ແຕ່​ພວກມັນ​ເຄື່ອນທີ່​ພ້ອມກັນ​ໄປ​ເປັນ​ແຖວ;<verse eid="PRO 30:27" /></para>
  <para style="li2">
    <verse number="28" style="v" sid="PRO 30:28" />ຂີ້ກ້ຽມ​ເອົາ​ມື​ຈັບ​ກໍ​ໄດ້,</para>
  <para style="li3" vid="PRO 30:28">ແຕ່​ມັນ​ກໍ​ມີ​ຫລາຍ​ໂຕ​ຢູ່​ໃນ​ວັງ​ຂອງ​ກະສັດ.<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="29" style="v" sid="PRO 30:29" />“ມີ​ສາມ​ສິ່ງ​ທີ່​ມີ​ຮູບຮ່າງ​ສະຫງ່າງາມ</para>
  <para style="li2" vid="PRO 30:29">ມີ​ສີ່​ສິ່ງ​ທີ່​ເຄື່ອນ​ໄຫວ​ຢ່າງ​ສະຫງ່າງາມ​ຄື:<verse eid="PRO 30:29" /></para>
  <para style="li3">
    <verse number="30" style="v" sid="PRO 30:30" />ສິງ, ເປັນ​ສັດ​ທີ່​ແຂງແຮງ​ກວ່າ​ໝູ່, ຄື​ຜູ້​ທີ່​ບໍ່​ຢ້ານ​ຫຍັງ​ເລີຍ;<verse eid="PRO 30:30" /></para>
  <para style="li3">
    <verse number="31" style="v" sid="PRO 30:31" />ໄກ່ໂອກ,</para>
  <para style="li3" vid="PRO 30:31">ແບ້ເຖິກ​ທີ່​ຍ່າງ​ວາງ​ມາດ,</para>
  <para style="li3" vid="PRO 30:31">ແລະ ກະສັດ​ທີ່​ມີ​ຄວາມ​ປອດໄພ​ຈາກ​ການ​ກະບົດ.<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />“ຖ້າ​ເຈົ້າ​ເຮັດ​ຕົນ​ເປັນ​ຄົນ​ໂງ່​ຈ້າ ແລະ ຍ້ອງຍໍ​ຕົນເອງ,</para>
  <para style="q2" vid="PRO 30:32">ຫລື ຖ້າ​ເຈົ້າ​ວາງແຜນ​ຊົ່ວ,</para>
  <para style="q2" vid="PRO 30:32">ຈົ່ງ​ເອົາ​ມື​ປິດ​ປາກ​ຂອງ​ເຈົ້າ​ໄວ້!<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />ເພາະ​ເມື່ອ​ກວນ​ນໍ້ານົມ​ກໍ​ໄດ້​ເນີຍ,</para>
  <para style="q2" vid="PRO 30:33">ຫລື ເມື່ອ​ຊົກ​ດັງ​ເລືອດ​ກໍ​ຈະ​ອອກ​ມາ,</para>
  <para style="q2" vid="PRO 30:33">ດັ່ງນັ້ນ, ການ​ຍົວະ​ໃຫ້​ໃຈຮ້າຍ​ກໍ​ເຮັດ​ໃຫ້​ຜິດຖຽງ​ກັນ”.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="ms1">ຄຳສອນ​ຂອງ​ກະສັດ​ເລມູເອນ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />ນີ້​ແມ່ນ​ຄຳສອນ​ຂອງ​ກະສັດ​ເລມູເອນ ເປັນ​ຖ້ອຍ​ຄຳ​ທີ່​ໄດ້​ຮັບ​ການ​ດົນໃຈ<note caller="+" style="f"><char style="fr" closed="false">31:1 </char><char style="ft" closed="false">ຫລື ເລມູເອນ​ແຫ່ງ​ມັດສາ</char></note> ທີ່​ແມ່​ຂອງ​ເພິ່ນ​ໄດ້​ສອນ​ເພິ່ນ​ໄວ້.<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />ຈົ່ງ​ຟັງ, ລູກ​ຂອງ​ແມ່! ຈົ່ງ​ຟັງ, ລູກ​ມາ​ຈາກ​ມົດລູກ​ຂອງ​ແມ່!</para>
  <para style="q2" vid="PRO 31:2">ຈົ່ງ​ຟັງ, ລູກ​ຂອງ​ແມ່, ລູກ​ຄື​ຄໍາຕອບ​ແຫ່ງ​ຄຳ​ອະທິຖານ​ຂອງ​ແມ່!<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />ຢ່າ​ໃຊ້​ເຫື່ອແຮງ​ກັບ​ບັນດາ​ແມ່ຍິງ,<note caller="+" style="f"><char style="fr" closed="false">31:3 </char><char style="ft" closed="false">ຫລື ຊັບສິນ</char></note></para>
  <para style="q2" vid="PRO 31:3">ຢ່າ​ເສຍ​ກຳລັງ​ໃຫ້​ແກ່​ຜູ້​ທີ່​ທຳລາຍ​ກະສັດ.<verse eid="PRO 31:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />ເລມູເອນ, ມັນ​ບໍ່​ເໝາະສົມ​ສຳລັບ​ກະສັດ</para>
  <para style="q2" vid="PRO 31:4">ມັນ​ບໍ່​ເໝາະສົມ​ທີ່​ກະສັດ​ຈະ​ດື່ມ​ເຫລົ້າ​ອະງຸ່ນ,</para>
  <para style="q2" vid="PRO 31:4">ມັນ​ບໍ່​ສົມຄວນ​ທີ່​ຜູ້ປົກຄອງ​ຈະ​ດື່ມ​ເບຍ,<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />ຢ້ານ​ວ່າ​ເມື່ອ​ພວກເຂົາ​ດື່ມ​ແລ້ວ ຈະ​ລືມ​ສິ່ງ​ທີ່​ກົດໝາຍ​ໄດ້​ກໍານົດ​ໄວ້,</para>
  <para style="q2" vid="PRO 31:5">ແລະ ຖອນ​ສິດ​ຂອງ​ຜູ້​ທີ່​ຖືກ​ກົດຂີ່​ທັງໝົດ.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />ເບຍ​ມີ​ໄວ້​ສໍາລັບ​ຄົນ​ທີ່​ກຳລັງ​ຈະ​ຈິບຫາຍ,</para>
  <para style="q2" vid="PRO 31:6">ເຫລົ້າ​ອະງຸ່ນ​ມີ​ໄວ້​ສໍາລັບ​ຄົນ​ທີ່​ມີ​ຄວາມ​ທຸກໃຈ!<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />ຈົ່ງ​ໃຫ້​ພວກເຂົາ​ດື່ມ ແລະ ລືມ​ຄວາມ​ທຸກຍາກ</para>
  <para style="q2" vid="PRO 31:7">ແລະ ບໍ່​ລະນຶກ​ເຖິງ​ຄວາມ​ທຸກ​ຂອງ​ຕົນ​ອີກ​ຕໍ່​ໄປ.<verse eid="PRO 31:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />ຈົ່ງ​ເວົ້າ​ແທນ​ຜູ້​ທີ່​ເວົ້າ​ແທນ​ຕົນເອງ​ບໍ່​ໄດ້,</para>
  <para style="q2" vid="PRO 31:8">ເພື່ອ​ສິດ​ຂອງ​ຜູ້​ທີ່​ຂັດສົນ​ທຸກຄົນ.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />ຈົ່ງ​ເວົ້າ​ແທນ​ພວກເຂົາ ແລະ ຕັດ​ສິນ​ຢ່າງ​ຍຸຕິທຳ;</para>
  <para style="q2" vid="PRO 31:9">ຈົ່ງ​ປົກປ້ອງ​ສິດ​ຕ່າງໆ​ຂອງ​ຄົນ​ທຸກຍາກ ແລະ ຄົນ​ຂັດສົນ.<verse eid="PRO 31:9" /></para>
  <para style="ms1">ບົດ​ສົ່ງ​ທ້າຍ: ລັກສະນະ​ຂອງ​ເມຍ​ທີ່​ດີ​ເລີດ<note caller="+" style="f"><char style="fr" closed="false">31:10 </char><char style="ft" closed="false">ຂໍ <char style="xt" link-href="PRO 31:10-31"><ref loc="PRO 31:10">10-31</ref></char> ໃນ​ພາສາ​ເຮັບເຣີ ແຕ່​ລະ​ຂໍ້​ຂຶ້ນ​ຕົ້ນ​ດ້ວຍ​ໂຕ​ອັກສອນ​ເຮັບເຣີ​ລຽງ​ຕາມ​ລຳ​ດັບ</char></note></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />ຜູ້​ໃດ​ຈະ​ພົບ​ເມຍ​ທີ່​ດີ​ເລີດ?</para>
  <para style="q2" vid="PRO 31:10">ນາງ​ມີ​ຄຸນຄ່າ​ຫລາຍ​ກວ່າ​ເພັດພອຍ.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />ຜົວ​ຂອງ​ນາງ​ໄວ້ໃຈ​ນາງ​ໄດ້​ທຸກ​ຢ່າງ</para>
  <para style="q2" vid="PRO 31:11">ແລະ ນາງ​ບໍ່​ຂາດ​ສິ່ງ​ທີ່​ມີ​ຄ່າ​ເລີຍ.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />ນາງ​ນຳ​ສິ່ງ​ທີ່​ດີ​ມາ​ໃຫ້​ລາວ, ບໍ່​ເຮັດ​ໃຫ້​ຜົວ​ເສຍຫາຍ,</para>
  <para style="q2" vid="PRO 31:12">ຕະຫລອດ​ຊົ່ວ​ຊີວິດ​ຂອງ​ນາງ.<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />ນາງ​ເລືອກ​ຂົນແກະ ແລະ ຜ້າ​ປ່ານ</para>
  <para style="q2" vid="PRO 31:13">ແລະ ເຮັດວຽກ​ດ້ວຍ​ມື​ຢ່າງ​ດຸໝັ່ນ.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />ນາງ​ເປັນ​ດັ່ງ​ເຮືອ​ຂອງ​ພໍ່ຄ້າ,</para>
  <para style="q2" vid="PRO 31:14">ທີ່​ບັນທຸກ​ອາຫານ​ຂອງ​ນາງ​ມາ​ຈາກ​ແດນ​ໄກ.<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />ນາງ​ຕື່ນ​ເຊົ້າ ໃນ​ຂະນະ​ທີ່​ຍັງ​ມືດ​ຢູ່;</para>
  <para style="q2" vid="PRO 31:15">ນາງ​ຈັດ​ຕຽມ​ອາຫານ​ສຳລັບ​ຄອບຄົວ​ຂອງ​ນາງ</para>
  <para style="q2" vid="PRO 31:15">ແລະ ແບ່ງ​ອາຫານ​ໃຫ້​ພວກ​ສາວ​ໃຊ້​ຂອງ​ນາງ.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />ນາງ​ອອກ​ໄປ​ເບິ່ງ​ທົ່ງນາ ແລະ ຊື້​ມັນ​ໄວ້;</para>
  <para style="q2" vid="PRO 31:16">ແລະ ນາງ​ເຮັດ​ສວນ​ອະງຸ່ນ​ດ້ວຍ​ເງິນ​ທີ່​ນາງ​ຫາ​ມາ​ໄດ້.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />ນາງ​ຕັ້ງໃຈ​ເຮັດວຽກ​ຂອງ​ນາງ​ຢ່າງ​ດຸໝັ່ນ;</para>
  <para style="q2" vid="PRO 31:17">ແຂນ​ຂອງ​ນາງ​ແຂງແຮງ​ເພື່ອ​ວຽກງານ​ຂອງ​ຕົນ.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />ນາງ​ເບິ່ງແຍງ​ການ​ຄ້າຂາຍ​ໃຫ້​ເກີດ​ຜົນ​ກໍາໄລ,</para>
  <para style="q2" vid="PRO 31:18">ແລະ ໃນ​ຕອນ​ກາງຄືນ​ຕະກຽງ​ຂອງ​ນາງ​ກໍ​ບໍ່​ດັບ.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />ມື​ຂອງ​ນາງ​ເຂັນຝ້າຍ ແລະ</para>
  <para style="q2" vid="PRO 31:19">ນິ້ວ​ຂອງ​ນາງ​ຕໍ່າຜ້າ​ຂອງ​ນາງ​ເອງ<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />ນາງ​ຍິນດີ​ຕ້ອນຮັບ​ຄົນ​ທຸກຍາກ</para>
  <para style="q2" vid="PRO 31:20">ແລະ ໃຫ້​ຄວາມ​ຊ່ວຍເຫລືອ​ແກ່​ຄົນ​ຂັດສົນ.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />ເມື່ອ​ຫິມະ​ຕົກ, ນາງ​ບໍ່​ມີ​ຄວາມ​ກັງວົນ​ກ່ຽວກັບ​ຄອບຄົວ​ຂອງ​ນາງ;</para>
  <para style="q2" vid="PRO 31:21">ເພາະ​ພວກເຂົາ​ທຸກຄົນ​ມີ​ເຄື່ອງນຸ່ງ​ຢ່າງ​ອົບອຸ່ນ.<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />ນາງ​ເຮັດ​ຜ້າປູ​ບ່ອນນອນ​ຂອງ​ນາງ​ເອງ;</para>
  <para style="q2" vid="PRO 31:22">ນາງ​ນຸ່ງ​ເຄື່ອງ​ທີ່​ເຮັດ​ດ້ວຍ​ຜ້າຝ້າຍລິນິນ​ເນື້ອລະອຽດ ແລະ ຜ້າ​ສີມ່ວງ.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />ຜົວ​ຂອງ​ນາງ​ໄດ້​ຮັບ​ຄວາມ​ເຄົາລົບ​ນັບຖື​ທີ່​ປະຕູ​ເມືອງ,</para>
  <para style="q2" vid="PRO 31:23">ບ່ອນ​ທີ່​ລາວ​ນັ່ງ​ຮ່ວມ​ກັບ​ບັນດາ​ຜູ້​ອາວຸໂສ​ຂອງ​ດິນແດນ.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />ນາງ​ໄດ້​ເຮັດ​ເສື້ອ​ຜ້າ​ລິນິນ​ໄວ້​ຂາຍ,</para>
  <para style="q2" vid="PRO 31:24">ແລະ ເຮັດ​ສາຍຮັດແອວ​ຂາຍ​ໃຫ້​ພໍ່ຄ້າ.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />ກໍາລັງ ແລະ ກຽດສັກສີ​ຄື​ເຄື່ອງນຸ່ງ​ຂອງ​ນາງ;</para>
  <para style="q2" vid="PRO 31:25">ນາງ​ຈຶ່ງ​ຫົວ​ຂວັນ​ຕໍ່​ອະນາຄົດ​ທີ່​ຈະ​ມາ​ເຖິງ.<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />ນາງ​ເວົ້າ​ດ້ວຍ​ປັນຍາ,</para>
  <para style="q2" vid="PRO 31:26">ແລະ ຄຳສັ່ງສອນ​ທີ່​ສັດຊື່​ຢູ່​ເທິງ​ລີ້ນ​ຂອງ​ນາງ.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />ນາງ​ເບິ່ງແຍງ​ວຽກງານ​ຕ່າງໆ​ໃນ​ຄອບຄົວ​ຂອງ​ຕົນ</para>
  <para style="q2" vid="PRO 31:27">ແລະ ບໍ່​ກິນ​ອາຫານ​ແຫ່ງ​ຄວາມ​ຂີ້ຄ້ານ.<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />ລູກ​ທັງຫລາຍ​ຂອງ​ນາງ​ລຸກ​ຢືນ​ຂຶ້ນ ແລະ ກ່າວ​ຍ້ອງຍໍ​ວ່າ ນາງ​ໄດ້​ຮັບ​ພຣະພອນ;</para>
  <para style="q2" vid="PRO 31:28">ຜົວ​ຂອງ​ນາງ, ກໍ​ກ່າວ​ຊົມເຊີຍ​ນາງ​ວ່າ:<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />“ແມ່ຍິງ​ຫລາຍຄົນ​ເຮັດ​ສິ່ງ​ທີ່​ດີ​ເລີດ,</para>
  <para style="q2" vid="PRO 31:29">ແຕ່​ເຈົ້າ​ເຮັດ​ສິ່ງ​ທີ່​ດີ​ເລີດ​ກວ່າ​ພວກເຂົາ​ທັງໝົດ”.<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />ສະເໜ່​ເປັນ​ສິ່ງ​ຫລອກລວງ, ແລະ ຄວາມ​ງາມ​ກໍ​ຢູ່​ພຽງ​ຊົ່ວຄາວ;</para>
  <para style="q2" vid="PRO 31:30">ແຕ່​ຍິງ​ທີ່​ຢຳເກງ​ພຣະເຈົ້າ​ຢາເວ​ຈະ​ຕ້ອງ​ໄດ້​ຮັບ​ການ​ຍ້ອງຍໍ.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />ຈົ່ງ​ໃຫ້​ກຽດ​ນາງ​ເພາະ​ທຸກສິ່ງ​ທີ່​ນາງ​ໄດ້​ເຮັດ,</para>
  <para style="q2" vid="PRO 31:31">ແລະ ໃຫ້​ຜົນງານ​ຂອງ​ນາງ​ເຮັດ​ໃຫ້​ນາງ​ໄດ້​ຮັບ​ການ​ຍ້ອງຍໍ​ທີ່​ປະຕູ​ເມືອງ.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>