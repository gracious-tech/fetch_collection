<usx version="3.0">
  <book code="JOL" style="id">- Biblica® Open Lao Contemporary Version</book>
  <para style="rem">Copyright © 2023, 2025 by Biblica, Inc.</para>
  <para style="h">ໂຢເອນ</para>
  <para style="toc1">ພຣະທຳໂຢເອນ</para>
  <para style="toc2">ໂຢເອນ</para>
  <para style="toc3">ຢອ</para>
  <para style="mt1">ພຣະທຳໂຢເອນ</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />ຖ້ອຍຄຳ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ ເຊິ່ງ​ມາ​ເຖິງ​ໂຢເອນ ລູກຊາຍ​ຂອງ​ເປທູເອນ.<verse eid="JOL 1:1" /></para>
  <para style="b" />
  <para style="s1">ການ​ບຸກລຸກ​ຂອງ​ຕັກແຕນ</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2" />ຈົ່ງ​ຕັ້ງໃຈ​ຟັງ, ພວກເຈົ້າ​ຜູ້ອາວຸໂສ​ທັງຫລາຍ;</para>
  <para style="q2" vid="JOL 1:2">ຈົ່ງ​ຟັງ​ໃຫ້​ດີ, ທຸກຄົນ​ທີ່​ອາໄສ​ຢູ່​ໃນ​ດິນແດນ​ນີ້.</para>
  <para style="q1" vid="JOL 1:2">ເຄີຍ​ມີ​ເຫດການ​ຢ່າງ​ນີ້​ເກີດ​ຂຶ້ນ​ໃນ​ສະໄໝ​ຂອງ​ພວກເຈົ້າ</para>
  <para style="q2" vid="JOL 1:2">ຫລື ໃນ​ສະໄໝ​ຂອງ​ບັນພະບຸລຸດ​ຂອງ​ພວກເຈົ້າ​ບໍ?<verse eid="JOL 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3" />ຈົ່ງ​ເລົ່າ​ເລື່ອງລາວ​ໃຫ້​ບັນດາ​ລູກ​ຂອງ​ພວກເຈົ້າ​ຟັງ,</para>
  <para style="q2" vid="JOL 1:3">ແລະ ໃຫ້​ບັນດາ​ລູກ​ຂອງ​ພວກເຈົ້າ​ເລົ່າ​ເລື່ອງລາວ​ໃຫ້​ບັນດາ​ລູກ​ຂອງ​ພວກເຂົາ​ຟັງ,</para>
  <para style="q2" vid="JOL 1:3">ແລະ ໃຫ້​ບັນດາ​ລູກຫລານ​ຂອງ​ພວກເຂົາ​ເລົ່າ​ເລື່ອງລາວ​ໃຫ້​ລຸ້ນ​ຕໍ່​ໄປ​ຟັງ.<verse eid="JOL 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4" />ຕັກແຕນ​ເປັນ​ຝູງ​ກິນ​ສິ່ງໃດ​ເຫລືອ​ໄວ້</para>
  <para style="q2" vid="JOL 1:4">ຕັກແຕນ​ໃຫຍ່​ກໍ​ມາ​ກິນ</para>
  <para style="q1" vid="JOL 1:4">ຕັກແຕນ​ໃຫຍ່​ກິນ​ສິ່ງໃດ​ເຫລືອ​ໄວ້</para>
  <para style="q2" vid="JOL 1:4">ຕັກແຕນ​ໜຸ່ມ​ກໍ​ມາ​ກິນ</para>
  <para style="q1" vid="JOL 1:4">ຕັກແຕນ​ໜຸ່ມ​ກິນ​ສິ່ງໃດ​ເຫລືອ​ໄວ້</para>
  <para style="q2" vid="JOL 1:4">ຕັກແຕນ​ອື່ນໆ<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">ໃນ​ພາສາ​ເຮັບເຣີ ຄຳ​ທັງ​ສີ່​ຄຳ​ທີ່​ໝາຍ​ເຖິງ​ຕັກແຕນ​ຊະນິດ​ຕ່າງໆ​ນີ້​ມີ​ຄວາມຫມາຍ​ບໍ່​ຊັດເຈນ</char></note>​ກໍ​ມາ​ກິນ.<verse eid="JOL 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5" />ຄົນ​ຂີ້ເມົາ, ຈົ່ງ​ຕື່ນ​ຂຶ້ນ ແລະ ຈົ່ງ​ຮ້ອງໄຫ້!</para>
  <para style="q2" vid="JOL 1:5">ນັກ​ດື່ມ​ເຫລົ້າອະງຸ່ນ​ທຸກ​ຄົນ​ເອີຍ, ຈົ່ງ​ໂອ່ຍຄາງ;</para>
  <para style="q1" vid="JOL 1:5">ຈົ່ງ​ໂອ່ຍຄາງ​ເພາະ​ເຫລົ້າອະງຸ່ນ​ໃໝ່,</para>
  <para style="q2" vid="JOL 1:5">ເພາະ​ມັນ​ຖືກ​ດຶງ​ເອົາ​ໄປ​ຈາກ​ຮິມສົບ​ຂອງ​ພວກເຈົ້າ​ແລ້ວ.<verse eid="JOL 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6" />ມີ​ຊົນຊາດ​ໜຶ່ງ​ໄດ້​ຮຸກຮານ​ດິນແດນ​ຂອງ​ເຮົາ,</para>
  <para style="q2" vid="JOL 1:6">ເປັນ​ກອງທັບ​ໃຫຍ່​ທີ່​ມີ​ຈຳນວນ​ນັບ​ບໍ່​ຖ້ວນ;</para>
  <para style="q1" vid="JOL 1:6">ແຂ້ວ​ຂອງ​ມັນ​ຄົມ​ເໝືອນດັ່ງ​ແຂ້ວ​ຂອງ​ໂຕ​ສິງ,</para>
  <para style="q2" vid="JOL 1:6">ມີ​ແຂ້ວ​ເໝືອນດັ່ງ​ແຂ້ວ​ຂອງ​ສິງ​ແມ່.<verse eid="JOL 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7" />ມັນ​ທຳລາຍ​ເຄືອອະງຸ່ນ​ຂອງ​ເຮົາ</para>
  <para style="q2" vid="JOL 1:7">ແລະ ທຳລາຍ​ຕົ້ນ​ໝາກເດື່ອ​ຂອງ​ເຮົາ.</para>
  <para style="q1" vid="JOL 1:7">ມັນ​ລອກ​ເປືອກ​ໄມ້​ອອກ</para>
  <para style="q2" vid="JOL 1:7">ແລະ ໂຍນ​ຖິ້ມ​ໄປ,</para>
  <para style="q2" vid="JOL 1:7">ເຫລືອ​ໄວ້​ແຕ່​ກ້ານ​ຂາວ.<verse eid="JOL 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8" />ຈົ່ງ​ຮ້ອງໄຫ້​ເໝືອນດັ່ງ​ສາວ​ບໍລິສຸດ​ນຸ່ງ​ເສື້ອ​ຜ້າກະສອບ</para>
  <para style="q2" vid="JOL 1:8">ເຊິ່ງ​ຄ່ຳຄວນ​ເຖິງ​ຄູ່ໝັ້ນ​ໃນ​ໄວ​ໜຸ່ມ​ຂອງ​ຕົນ.<verse eid="JOL 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9" />ເຄື່ອງ​ຖວາຍ​ພືດຜົນ​ບູຊາ ແລະ ເຄື່ອງດື່ມ​ບູຊາ</para>
  <para style="q2" vid="JOL 1:9">ຖືກ​ຕັດ​ຂາດ​ຈາກ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ.</para>
  <para style="q1" vid="JOL 1:9">ບັນດາ​ປະໂລຫິດ​ກຳລັງ​ໂສກເສົ້າ,</para>
  <para style="q2" vid="JOL 1:9">ບັນດາ​ຜູ້ຮັບໃຊ້​ທີ່​ຢູ່​ຕໍ່ໜ້າ​ພຣະເຈົ້າ​ຢາເວ.<verse eid="JOL 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10" />ທົ່ງນາ​ຖືກ​ທຳລາຍ,</para>
  <para style="q2" vid="JOL 1:10">ພື້ນດິນ​ແຫ້ງແລ້ງ;</para>
  <para style="q1" vid="JOL 1:10">ເມັດພືດ​ກໍ​ຖືກ​ທຳລາຍ,</para>
  <para style="q2" vid="JOL 1:10">ເຫລົ້າອະງຸ່ນ​ໃໝ່​ກໍ​ແຫ້ງ,</para>
  <para style="q2" vid="JOL 1:10">ບໍ່​ມີ​ນ້ຳມັນ​ໝາກກອກ.<verse eid="JOL 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11" />ຊາວນາ​ທັງຫລາຍ ຈົ່ງ​ສິ້ນ​ຫວັງ,</para>
  <para style="q2" vid="JOL 1:11">ຊາວສວນ​ອະງຸ່ນ​ທັງຫລາຍ ຈົ່ງ​ຮ້ອງໄຫ້;</para>
  <para style="q1" vid="JOL 1:11">ຈົ່ງ​ໂສກເສົ້າ​ເລື່ອງ​ເຂົ້າຫວີດ ແລະ ເຂົ້າບາເລ,</para>
  <para style="q2" vid="JOL 1:11">ເພາະ​ຜົນລະປູກ​ໃນ​ທົ່ງນາ​ໄດ້​ຖືກ​ທຳລາຍ.<verse eid="JOL 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12" />ເຄືອອະງຸ່ນ​ກໍ​ຫ່ຽວ​ແຫ້ງ</para>
  <para style="q2" vid="JOL 1:12">ແລະ ຕົ້ນ​ໝາກເດື່ອ​ກໍ​ແຫ້ງ​ຫ່ຽວ​ໄປ</para>
  <para style="q1" vid="JOL 1:12">ທັງ​ຕົ້ນ​ໝາກພິລາ, ຕົ້ນປາມ ແລະ ຕົ້ນ​ແອັບເປີ້ນ</para>
  <para style="q2" vid="JOL 1:12">ຕົ້ນໄມ້​ທັງໝົດ​ໃນ​ທົ່ງນາ​ກໍ​ຫ່ຽວ​ແຫ້ງ.</para>
  <para style="q1" vid="JOL 1:12">ຄວາມ​ຊື່ນຊົມຍິນດີ​ຂອງ​ຄົນ​ທັງຫລາຍ</para>
  <para style="q2" vid="JOL 1:12">ກໍ​ສູນສິ້ນ​ໄປ​ຢ່າງ​ແນ່ນອນ.<verse eid="JOL 1:12" /></para>
  <para style="s1">ຮຽກຮ້ອງ​ໃຫ້​ກັບໃຈ</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13" />ປະໂລຫິດ​ທັງຫລາຍ, ຈົ່ງ​ນຸ່ງ​ເສື້ອ​ຜ້າກະສອບ ແລະ ໄວ້​ທຸກ;</para>
  <para style="q2" vid="JOL 1:13">ພວກເຈົ້າ​ຜູ້​ທີ່​ຮັບໃຊ້​ຢູ່​ຕໍ່ໜ້າ​ແທ່ນບູຊາ, ຈົ່ງ​ຮ້ອງໄຫ້.</para>
  <para style="q1" vid="JOL 1:13">ຈົ່ງ​ມາ, ຈົ່ງ​ນຸ່ງ​ເສື້ອ​ຜ້າ​ກະສອບ​ໄວ້​ຕະຫລອດ​ຄືນ,</para>
  <para style="q2" vid="JOL 1:13">ພວກເຈົ້າ​ຜູ້​ທີ່​ຮັບໃຊ້​ຢູ່​ຕໍ່ໜ້າ​ພຣະເຈົ້າ​ຂອງ​ເຮົາ;</para>
  <para style="q1" vid="JOL 1:13">ເພາະ​ເຄື່ອງຖວາຍ​ພືດຜົນ​ເປັນ​ເມັດ ແລະ ເຄື່ອງດື່ມ​ບູຊາ</para>
  <para style="q2" vid="JOL 1:13">ກໍ​ຂາດ​ໄປ​ຈາກ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ​ຂອງ​ພວກເຈົ້າ​ແລ້ວ.<verse eid="JOL 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14" />ຈົ່ງ​ປະກາດ​ໃຫ້​ມີ​ການ​ຖືສິນ​ອົດ​ອາຫານ​ອັນ​ບໍລິສຸດ;</para>
  <para style="q2" vid="JOL 1:14">ຈົ່ງ​ເອີ້ນ​ປະຊຸມ​ອັນ​ສັກສິດ.</para>
  <para style="q1" vid="JOL 1:14">ຈົ່ງ​ເອີ້ນ​ບັນດາ​ຜູ້ອາວຸໂສ</para>
  <para style="q2" vid="JOL 1:14">ແລະ ທຸກຄົນ​ທີ່​ອາໄສ​ຢູ່​ໃນ​ແຜ່ນດິນ​ນັ້ນ</para>
  <para style="q1" vid="JOL 1:14">ໃຫ້​ມາ​ຍັງ​ວິຫານຂອງ​ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ​ຂອງ​ພວກເຈົ້າ,</para>
  <para style="q2" vid="JOL 1:14">ແລະ ຮ້ອງ​ຕໍ່​ພຣະເຈົ້າ​ຢາເວ.<verse eid="JOL 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15" />ເປັນ​ວັນ​ທີ່​ໜ້າ​ຢ້ານກົວ​ຫລາຍ!</para>
  <para style="q2" vid="JOL 1:15">ເພາະ​ວັນ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ໃກ້​ເຂົ້າ​ມາ​ແລ້ວ;</para>
  <para style="q2" vid="JOL 1:15">ວັນ​ນັ້ນ​ຈະ​ມາ​ເໝືອນ​ຄວາມ​ພິນາດ​ຈາກ​ອົງ​ຜູ້​ມີ​ລິດອຳນາດ​ຍິ່ງໃຫຍ່.<verse eid="JOL 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16" />ອາຫານ​ໄດ້​ຖືກ​ຕັດ​ອອກ​ໄປ</para>
  <para style="q2" vid="JOL 1:16">ຕໍ່ໜ້າ​ຕໍ່​ຕາ​ພວກເຮົາ​ແລ້ວ</para>
  <para style="q1" vid="JOL 1:16">ຄວາມ​ຊື່ນຊົມຍິນດີ ແລະ ຄວາມ​ຍິນດີ</para>
  <para style="q2" vid="JOL 1:16">ກໍ​ໄດ້​ສູນສິ້ນ​ໄປ​ຈາກ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ​ຂອງ​ພວກເຮົາ​ແລ້ວ​ບໍ່​ແມ່ນ​ບໍ?<verse eid="JOL 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17" />ເມັດພືດ​ຫ່ຽວແຫ້ງ</para>
  <para style="q2" vid="JOL 1:17">ຢູ່​ໃຕ້​ດິນ​ຕົມ.<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">ໃນ​ພາສາ​ເຮັບເຣີ​ຄຳ​ນີ້​ມີ​ຄວາມຫມາຍ​ບໍ່​ຊັດເຈນ</char></note></para>
  <para style="q1" vid="JOL 1:17">ໂຮງ​ເກັບ​ເຂົ້າ​ຢູ່​ໃນ​ສະພາບ​ຫັກພັງ,</para>
  <para style="q2" vid="JOL 1:17">ສາງ​ທັງຫລາຍ​ກໍ​ຫັກພັງ​ລົງ,</para>
  <para style="q2" vid="JOL 1:17">ເພາະ​ເມັດ​ເຂົ້າ​ຫ່ຽວແຫ້ງ​ໄປ​ໝົດ.<verse eid="JOL 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18" />ຝູງ​ງົວ​ກໍ​ຮ້ອງ​ຄວນ​ຄາງ!</para>
  <para style="q2" vid="JOL 1:18">ຝູງງົວ​ປ່ວງ​ໄປ​ມາ</para>
  <para style="q1" vid="JOL 1:18">ເພາະ​ສັດ​ເຫລົ່ານັ້ນ​ບໍ່​ມີ​ທົ່ງຫຍ້າ;</para>
  <para style="q2" vid="JOL 1:18">ແມ່ນ​ແຕ່​ຝູງ​ແກະ​ກໍ​ທຸກທໍລະມານ.<verse eid="JOL 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19" />ຂ້າແດ່​ພຣະເຈົ້າ​ຢາເວ ຂ້ານ້ອຍ​ຮ້ອງ​ຫາ​ພຣະອົງ</para>
  <para style="q2" vid="JOL 1:19">ເພາະ​ໄຟ​ໄດ້​ເຜົາຜານ​ທົ່ງຫຍ້າ​ທີ່​ໃນ​ຖິ່ນແຫ້ງແລ້ງກັນດານ</para>
  <para style="q2" vid="JOL 1:19">ແລະ ແປວໄຟ​ໄດ້​ໄໝ້​ເຜົາ​ຕົ້ນໄມ້​ໃນ​ທົ່ງນາ​ທັງໝົດ.<verse eid="JOL 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20" />ແມ່ນ​ແຕ່​ສັດປ່າ​ກໍ​ຄວນ​ຄາງ​ຫາ​ພຣະອົງ</para>
  <para style="q2" vid="JOL 1:20">ສາຍ​ນ້ຳ​ທັງຫລາຍ​ກໍ​ບົກ​ແຫ້ງ​ໄປ</para>
  <para style="q2" vid="JOL 1:20">ແລະ ໄຟ​ກໍ​ເຜົາໄໝ້​ທົ່ງຫຍ້າ​ໃນ​ຖິ່ນແຫ້ງແລ້ງກັນດານ.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s1">ກອງທັບ​ຕັກແຕນ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1" />ຈົ່ງ​ເປົ່າ​ແກ​ໃນ​ຊີໂອນ;</para>
  <para style="q2" vid="JOL 2:1">ໃຫ້​ສັນຍານ​ເຕືອນ​ທີ່​ເທິງ​ພູເຂົາ​ສັກສິດ​ຂອງ​ເຮົາ.</para>
  <para style="b" vid="JOL 2:1" />
  <para style="q1" vid="JOL 2:1">ທຸກຄົນ​ທີ່​ອາໄສ​ຢູ່​ໃນ​ດິນແດນ​ນີ້​ຈົ່ງ​ສັ່ນສະທ້ານ,</para>
  <para style="q2" vid="JOL 2:1">ເພາະ​ວັນ​ແຫ່ງ​ພຣະເຈົ້າ​ຢາເວ​ກຳລັງ​ມາ​ເຖິງ​ແລ້ວ.</para>
  <para style="q1" vid="JOL 2:1">ວັນ​ນັ້ນ​ໃກ້​ເຂົ້າ​ມາ​ແລ້ວ<verse eid="JOL 2:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="JOL 2:2" />ເປັນ​ວັນ​ແຫ່ງ​ຄວາມ​ມືດມິດ ແລະ ມືດມົວ​ຫລາຍ,</para>
  <para style="q2" vid="JOL 2:2">ເປັນ​ວັນ​ທີ່​ມີ​ເມກ​ຄຶ້ມ ແລະ ຄວາມ​ມືດ​ມິດ.</para>
  <para style="q1" vid="JOL 2:2">ເໝືອນ​ແສງ​ຕາເວັນ​ຂຶ້ນ​ໃນ​ຍາມ​ເຊົ້າ​ສາດ​ຊ່ອງ​ໄປ​ທົ່ວ​ພູເຂົາ</para>
  <para style="q2" vid="JOL 2:2">ກອງທັບ​ຂະໜາດ​ໃຫຍ່ ແລະ ຍິ່ງໃຫຍ່​ໄດ້​ມາ</para>
  <para style="q1" vid="JOL 2:2">ຢ່າງ​ທີ່​ບໍ່​ເຄີຍ​ມີ​ໃນ​ອະດີດ</para>
  <para style="q2" vid="JOL 2:2">ແລະ ຈະ​ບໍ່​ມີ​ອີກ​ເລີຍ​ໃນ​ອະນາຄົດ.<verse eid="JOL 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3" />ເບື້ອງ​ໜ້າ​ພວກມັນ​ມີ​ໄຟ​ທີ່​ເຜົາຜານ</para>
  <para style="q2" vid="JOL 2:3">ເບື້ອງ​ຫລັງ​ພວກມັນ​ມີ​ເປວໄຟ​ທີ່​ລຸກ​ໄໝ້.</para>
  <para style="q1" vid="JOL 2:3">ເບື້ອງ​ໜ້າ​ພວກມັນ​ມີ​ດິນແດນ​ທີ່​ງົດງາມ​ເໝືອນ​ກັບ​ສວນ​ເອເດນ,</para>
  <para style="q2" vid="JOL 2:3">ເບື້ອງ​ຫລັງ​ພວກມັນ​ເຫລືອ​ແຕ່​ຖິ່ນແຫ້ງແລ້ງກັນດານ</para>
  <para style="q2" vid="JOL 2:3">ບໍ່​ມີ​ສິ່ງໃດ​ທີ່​ຈະ​ໜີ​ພົ້ນ​ຈາກ​ພວກມັນ​ໄປ​ໄດ້.<verse eid="JOL 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4" />ພວກມັນ​ມີ​ລັກສະນະ​ຄ້າຍ​ຄື​ກັນ​ກັບ​ຝູງມ້າ</para>
  <para style="q2" vid="JOL 2:4">ພວກມັນ​ແລ່ນ​ມາ​ເໝືອນ​ກັບ​ຂະບວນ​ມ້າ​ຮົບ;<verse eid="JOL 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5" />ດ້ວຍ​ສຽງ​ດັງ​ເໝືອນ​ກັບ​ລົດຮົບ</para>
  <para style="q2" vid="JOL 2:5">ພວກມັນ​ແລ່ນ​ຢູ່​ເທິງ​ຍອດ​ພູເຂົາ,</para>
  <para style="q1" vid="JOL 2:5">ເໝືອນ​ກັບ​ສຽງ​ໄຟໄໝ້​ແຕກ ເຊິ່ງ​ເຜົາໄໝ້​ຕໍ​ໄມ້,</para>
  <para style="q2" vid="JOL 2:5">ແລະ ເໝືອນ​ກັບ​ກອງທັບ​ໃຫຍ່​ທີ່​ຍົກ​ທັບ​ຂຶ້ນ​ມາ​ສູ້ຮົບ.<verse eid="JOL 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6" />ເມື່ອ​ປະຊາຊາດ​ທັງຫລາຍ​ເຫັນ​ພວກມັນ​ແລ້ວ ກໍ​ທຸກທໍລະມານ;</para>
  <para style="q2" vid="JOL 2:6">ໃບໜ້າ​ຂອງ​ທຸກຄົນ​ຕ່າງ​ກໍ​ຈືດ​ໄປ.<verse eid="JOL 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7" />ພວກມັນ​ບຸກ​ເຂົ້າ​ມາ​ເໝືອນ​ກັບ​ນັກຮົບ;</para>
  <para style="q2" vid="JOL 2:7">ພວກມັນ​ປີນ​ກຳແພງ​ເໝືອນ​ກັບ​ທະຫານ.</para>
  <para style="q1" vid="JOL 2:7">ພວກມັນ​ເດີນ​ຂະບວນ​ເຂົ້າ​ມາ​ເປັນ​ແຖວ,</para>
  <para style="q2" vid="JOL 2:7">ບໍ່​ມີ​ແຕກ​ແຖວ​ເລີຍ.<verse eid="JOL 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8" />ພວກມັນ​ບໍ່​ບຽດ​ກັນ;</para>
  <para style="q2" vid="JOL 2:8">ແຕ່​ລະ​ໂຕ​ເດີນ​ຊື່​ໄປ​ຂ້າງ​ໜ້າ</para>
  <para style="q1" vid="JOL 2:8">ພວກມັນ​ບຸ​ຝ່າ​ເຄື່ອງ​ປ້ອງກັນ</para>
  <para style="q2" vid="JOL 2:8">ໂດຍ​ບໍ່​ແຕກ​ແຖວ.<verse eid="JOL 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9" />ພວກມັນ​ຟ້າວ​ບຸກ​ເຂົ້າ​ເມືອງ;</para>
  <para style="q2" vid="JOL 2:9">ພວກມັນ​ແລ່ນ​ໄປ​ຕາມ​ກຳແພງ.</para>
  <para style="q1" vid="JOL 2:9">ພວກມັນ​ປີນ​ເຂົ້າ​ໄປ​ໃນ​ເຮືອນ​ຕ່າງໆ.</para>
  <para style="q2" vid="JOL 2:9">ພວກມັນ​ເຂົ້າ​ໄປ​ທາງ​ປ່ອງຢ້ຽມ​ຄື​ກັບ​ຄົນຂີ້ລັກ.<verse eid="JOL 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10" />ແຜ່ນດິນໂລກ​ສັ່ນສະເທືອນ​ຕໍ່ໜ້າ​ພວກມັນ,</para>
  <para style="q2" vid="JOL 2:10">ຟ້າ​ສະຫວັນ​ກໍ​ສັ່ນສະທ້ານ,</para>
  <para style="q1" vid="JOL 2:10">ດວງ​ຕາເວັນ ແລະ ດວງ​ເດືອນ​ກໍ​ມືດ,</para>
  <para style="q2" vid="JOL 2:10">ດວງດາວ​ກໍ​ບໍ່​ສ່ອງ​ແສງ​ອີກ.<verse eid="JOL 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11" />ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ເປັ່ງ​ສຽງ​ຮ້ອງ​ດັງ​ກ້ອງ</para>
  <para style="q2" vid="JOL 2:11">ຢູ່​ທາງ​ໜ້າ​ຂອງ​ກອງທັບ​ຂອງ​ພຣະອົງ;</para>
  <para style="q1" vid="JOL 2:11">ກອງກຳລັງ​ຂອງ​ພຣະອົງ​ແມ່ນ​ມີ​ຈຳນວນ​ຫລວງຫລາຍ,</para>
  <para style="q2" vid="JOL 2:11">ແລະ ກອງທັບ​ທີ່​ເຊື່ອຟັງ​ຄຳສັ່ງ​ຂອງ​ພຣະອົງ​ກໍ​ຍິ່ງໃຫຍ່.</para>
  <para style="q1" vid="JOL 2:11">ວັນ​ແຫ່ງ​ພຣະເຈົ້າ​ຢາເວ​ກໍ​ຍິ່ງໃຫຍ່;</para>
  <para style="q2" vid="JOL 2:11">ແລະ ມັນ​ເປັນ​ຕາ​ຢ້ານ​ຫລາຍ.</para>
  <para style="q2" vid="JOL 2:11">ຜູ້ໃດ​ຈະ​ສາມາດ​ທົນ​ຢູ່​ໄດ້?<verse eid="JOL 2:11" /></para>
  <para style="s1">ຈົ່ງ​ຈີກ​ໃຈ​ຂອງ​ເຈົ້າ</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12" />ພຣະເຈົ້າ​ຢາເວ​ປະກາດ​ວ່າ</para>
  <para style="q2" vid="JOL 2:12">“ບັດນີ້ ຈົ່ງ​ກັບ​ມາ​ຫາ​ເຮົາ​ຢ່າງ​ສຸດ​ໃຈ</para>
  <para style="q2" vid="JOL 2:12">ດ້ວຍ​ການ​ຖືສິນ​ອົດອາຫານ, ຮ້ອງໄຫ້ ແລະ ຄ່ຳຄວນ”.<verse eid="JOL 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13" />ຈົ່ງ​ຈີກ​ຫົວໃຈ​ຂອງ​ເຈົ້າ</para>
  <para style="q2" vid="JOL 2:13">ແລະ ບໍ່​ແມ່ນ​ຈີກ​ເສື້ອ​ຜ້າ​ຂອງ​ເຈົ້າ.</para>
  <para style="q1" vid="JOL 2:13">ຈົ່ງ​ກັບ​ຄືນ​ມາ​ຫາ​ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ​ຂອງ​ເຈົ້າ.</para>
  <para style="q2" vid="JOL 2:13">ເພາະ​ພຣະອົງ​ເຕັມລົ້ນ​ດ້ວຍ​ພຣະຄຸນ ແລະ ຄວາມ​ເມດຕາ​ສົງສານ,</para>
  <para style="q1" vid="JOL 2:13">ບໍ່​ໃຈຮ້າຍ​ງ່າຍ ແລະ ເຕັມລົ້ນ​ດ້ວຍ​ຄວາມ​ຮັກ,</para>
  <para style="q2" vid="JOL 2:13">ແລະ ພຣະອົງ​ອົດ​ໃຈ​ບໍ່​ສົ່ງ​ໄພພິບັດ​ມາ.<verse eid="JOL 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14" />ຜູ້ໃດ​ຈະ​ຮູ້? ພຣະອົງ​ອາດ​ກັບ​ຫັນ​ມາ ແລະ ປ່ຽນໃຈ</para>
  <para style="q2" vid="JOL 2:14">ແລະ ປະ​ຄຳ​ອວຍພອນ</para>
  <para style="q1" vid="JOL 2:14">ຄື​ໃຫ້​ມີ​ເຄື່ອງຖວາຍ​ພືດຜົນ​ເປັນ​ເມັດ ແລະ ເຄື່ອງດື່ມ​ບູຊາ</para>
  <para style="q2" vid="JOL 2:14">ເພື່ອ​ຖວາຍ​ແກ່​ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ​ຂອງ​ເຈົ້າ.<verse eid="JOL 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15" />ຈົ່ງ​ເປົ່າ​ແກ​ໃນ​ຊີໂອນ,</para>
  <para style="q2" vid="JOL 2:15">ຈົ່ງ​ປະກາດ​ການ​ຖືສິນ​ອົດ​ອາຫານ​ອັນ​ບໍລິສຸດ,</para>
  <para style="q2" vid="JOL 2:15">ແລະ ເອີ້ນ​ປະຊຸມ​ອັນ​ບໍລິສຸດ​ສັກສິດ.<verse eid="JOL 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16" />ຈົ່ງ​ເຕົ້າໂຮມ​ປະຊາຊົນ,</para>
  <para style="q2" vid="JOL 2:16">ຊຳລະ​ທີ່​ປະຊຸມ​ໃຫ້​ບໍລິສຸດ;</para>
  <para style="q1" vid="JOL 2:16">ຈົ່ງ​ນຳ​ຜູ້ອາວຸໂສ​ມາ​ເຕົ້າໂຮມ​ກັນ,</para>
  <para style="q2" vid="JOL 2:16">ເຕົ້າໂຮມ​ເດັກນ້ອຍ,</para>
  <para style="q2" vid="JOL 2:16">ບັນດາ​ເດັກນ້ອຍ​ເຫລົ່ານັ້ນ​ທີ່​ຍັງ​ກິນ​ນົມ​ແມ່.</para>
  <para style="q1" vid="JOL 2:16">ໃຫ້​ເຈົ້າບ່າວ​ອອກ​ມາ​ຈາກ​ຫ້ອງ​ຂອງ​ຕົນ</para>
  <para style="q2" vid="JOL 2:16">ແລະ ໃຫ້​ເຈົ້າສາວ​ອອກ​ມາ​ຈາກ​ຫ້ອງ​ຂອງ​ຕົນ.<verse eid="JOL 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17" />ໃຫ້​ປະໂລຫິດ​ຜູ້​ທີ່​ຮັບໃຊ້​ຢູ່​ຕໍ່ໜ້າ​ພຣະເຈົ້າ​ຢາເວ,</para>
  <para style="q2" vid="JOL 2:17">ຮ້ອງໄຫ້​ຢູ່​ລະຫວ່າງ​ລະບຽງ​ວິຫານ​ກັບ​ແທ່ນບູຊາ.</para>
  <para style="q1" vid="JOL 2:17">ໃຫ້​ພວກເຂົາ​ເວົ້າ​ວ່າ, “ຂ້າແດ່​ພຣະເຈົ້າ​ຢາເວ ຂໍ​ໂຜດ​ໄວ້​ຊີວິດ​ຂອງ​ຄົນ​ພຣະອົງ​ດ້ວຍ.</para>
  <para style="q2" vid="JOL 2:17">ຂໍ​ຢ່າ​ເຮັດ​ໃຫ້​ມໍລະດົກ​ຂອງ​ພຣະອົງ​ເປັນ​ທີ່​ດູຖູກ.</para>
  <para style="q2" vid="JOL 2:17">ເປັນ​ຄຳ​ເຢາະເຢີ້ຍ​ໃນ​ທ່າມກາງ​ປະຊາຊາດ​ທັງຫລາຍ.</para>
  <para style="q1" vid="JOL 2:17">ເປັນ​ຫຍັງ​ພວກເຂົາ​ຈຶ່ງ​ເວົ້າ​ກັນ​ວ່າ,</para>
  <para style="q2" vid="JOL 2:17">‘ພຣະເຈົ້າ​ຂອງ​ພວກເຂົາ​ຢູ່​ໃສ?’ ”<verse eid="JOL 2:17" /></para>
  <para style="s1">ຄຳຕອບ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18" />ແລ້ວ​ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ຫຶງຫວງ​ດິນແດນ​ຂອງ​ພຣະອົງ</para>
  <para style="q2" vid="JOL 2:18">ແລະ ຈະ​ສົງສານ​ຄົນ​ຂອງ​ພຣະອົງ.<verse eid="JOL 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOL 2:19" />ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ຕອບ​ພວກເຂົາ<note caller="+" style="f"><char style="fr" closed="false">2:18,19 </char><char style="ft" closed="false">ຫລື </char><char style="fqa" closed="false">ພຣະເຈົ້າ​ຈະ​ຫຶງຫວງ ແລະ ຈະ​ສົງສານ <char style="fv">19</char> ພຣະເຈົ້າ​ຢາເວ​ຈະ​ຕອບ</char></note>​ວ່າ:</para>
  <para style="q1" vid="JOL 2:19">“ເຮົາ​ຈະ​ສົ່ງ​ເມັດພືດ, ເຫລົ້າອະງຸ່ນ​ໃໝ່ ແລະ ນ້ຳມັນ​ໝາກກອກ​ມາ​ໃຫ້</para>
  <para style="q2" vid="JOL 2:19">ພຽງພໍ​ທີ່​ຈະ​ເຮັດ​ໃຫ້​ເຈົ້າ​ອິ່ມໜຳ​ສຳລານ;</para>
  <para style="q1" vid="JOL 2:19">ເຮົາ​ຈະ​ບໍ່​ເຮັດ​ໃຫ້​ເຈົ້າ</para>
  <para style="q2" vid="JOL 2:19">ຕົກ​ເປັນ​ເປົ້າ​ຂອງ​ການ​ເຢາະເຢີ້ຍ​ຂອງ​ປະຊາຊາດ​ທັງຫລາຍ​ອີກ​ຕໍ່ໄປ<verse eid="JOL 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20" />“ເຮົາ​ຈະ​ຂັບໄລ່​ກອງທັບ​ມາ​ແຕ່​ພາກ​ເໜືອ​ໃຫ້​ໄປ​ໄກ​ຈາກ​ເຈົ້າ,</para>
  <para style="q2" vid="JOL 2:20">ເຮົາ​ຈະ​ຍູ້​ພວກມັນ​ເຂົ້າ​ໄປ​ໃນ​ແຜ່ນດິນ​ທີ່​ແຫ້ງແລ້ງ ແລະ ແຕກແຫງ;</para>
  <para style="q1" vid="JOL 2:20">ແຖວ​ດ້ານ​ຕາເວັນອອກ​ຂອງ​ພວກມັນ​ຈະ​ລົງ​ໄປ​ໃນ​ທະເລ​ຕາຍ</para>
  <para style="q2" vid="JOL 2:20">ແລະ ແຖວ​ດ້ານ​ຕາເວັນຕົກ​ຂອງ​ພວກມັນ​ຈະ​ລົງ​ໄປ​ໃນ​ທະເລ​ເມດິແຕຣາເນ.</para>
  <para style="q1" vid="JOL 2:20">ແລະ ກິ່ນເໝັນ​ຂອງ​ພວກມັນ​ກໍ​ຈະ​ພຸ່ງ​ຂຶ້ນ​ມາ;</para>
  <para style="q2" vid="JOL 2:20">ກິ່ນເໝັນ​ຂອງ​ພວກມັນ​ກໍ​ຈະ​ລອຍ​ຂຶ້ນ​ໄປ”.</para>
  <para style="b" vid="JOL 2:20" />
  <para style="q1" vid="JOL 2:20">ພຣະອົງ​ໄດ້​ເຮັດ​ສິ່ງ​ທີ່​ຍິ່ງໃຫຍ່​ຢ່າງ​ແນ່ນອນ!<verse eid="JOL 2:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="JOL 2:21" />ແຜ່ນດິນ​ແຫ່ງ​ຢູດາ, ຢ່າ​ຢ້ານ​ເລີຍ;</para>
  <para style="q2" vid="JOL 2:21">ຈົ່ງ​ຍິນດີ ແລະ ຊື່ນຊົມຍິນດີ.</para>
  <para style="q1" vid="JOL 2:21">ພຣະເຈົ້າ​ໄດ້​ເຮັດ​ສິ່ງ​ທີ່​ຍິ່ງໃຫຍ່​ຢ່າງ​ແນ່ນອນ!<verse eid="JOL 2:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOL 2:22" />ສັດ​ປ່າ​ທັງຫລາຍ ຢ່າ​ຢ້ານ​ເລີຍ</para>
  <para style="q2" vid="JOL 2:22">ເພາະ​ທົ່ງຫຍ້າ​ໃນ​ຖິ່ນແຫ້ງແລ້ງກັນດານ​ຈະ​ກັບ​ມາ​ຂຽວ​ຄືນ.</para>
  <para style="q1" vid="JOL 2:22">ຕົ້ນໄມ້​ທັງຫລາຍ​ຈະ​ອອກ​ຜົນ​ຂອງ​ມັນ;</para>
  <para style="q2" vid="JOL 2:22">ຕົ້ນ​ໝາກເດື່ອ ແລະ ເຄືອອະງຸ່ນ​ຈະ​ອອກ​ຜົນ​ຢ່າງ​ສົມບູນ.<verse eid="JOL 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23" />ປະຊາຊົນ​ແຫ່ງ​ຊີໂອນ, ຈົ່ງ​ຍິນດີ,</para>
  <para style="q2" vid="JOL 2:23">ຈົ່ງ​ຊື່ນຊົມຍິນດີ​ໃນ​ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ​ຂອງ​ເຈົ້າ,</para>
  <para style="q1" vid="JOL 2:23">ເພາະ​ພຣະອົງ​ໄດ້​ໃຫ້​ຝົນ​ລະດູ​ໃບໄມ້​ຫລົ່ນ​ໃຫ້​ແກ່​ເຈົ້າ</para>
  <para style="q2" vid="JOL 2:23">ເພາະ​ພຣະອົງ​ສັດຊື່.</para>
  <para style="q1" vid="JOL 2:23">ພຣະອົງ​ໄດ້​ສົ່ງ​ຝົນ​ຕົກ​ຢ່າງ​ອຸດົມສົມບູນ​ມາ​ໃຫ້​ເຈົ້າ,</para>
  <para style="q2" vid="JOL 2:23">ທັງ​ຝົນ​ລະດູ​ໃບ​ໄມ້​ຫລົ່ນ ແລະ ລະດູ​ໃບ​ໄມ້​ປົ່ງ​ເໝືອນ​ກັບ​ທີ່​ຜ່ານມາ.<verse eid="JOL 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24" />ລານ​ຟາດ​ເຂົ້າ​ຈະ​ມີ​ເຂົ້າ​ຈະ​ເຕັມ​ໄປ​ດ້ວຍ​ເຂົ້າ;</para>
  <para style="q2" vid="JOL 2:24">ຖັງ​ຈະ​ເຕັມ​ລົ້ນ​ດ້ວຍ​ເຫລົ້າອະງຸ່ນ​ໃໝ່ ແລະ ນ້ຳມັນ.<verse eid="JOL 2:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25" />“ເຮົາ​ຈະ​ຊົດເຊີຍ​ໃຫ້​ເຈົ້າ​ສຳລັບ​ຊ່ວງ​ປີ​ທີ່​ຕັກແຕນ​ໄດ້​ກັດ​ກິນ​ນັ້ນ</para>
  <para style="q2" vid="JOL 2:25">ທັງ​ຕັກແຕນ​ໃຫຍ່ ແລະ ຕັກແຕນ​ອ່ອນ,</para>
  <para style="q2" vid="JOL 2:25">ຕັກແຕນ​ໂຕ​ອື່ນໆ ແລະ ຝູງ​ຕັກແຕນ</para>
  <para style="q1" vid="JOL 2:25">ຄື​ກອງທັບ​ໃຫຍ່​ຂອງ​ເຮົາ​ທີ່​ເຮົາ​ໄດ້​ສົ່ງ​ມາ​ຍັງ​ເຈົ້າ.<verse eid="JOL 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26" />ເຈົ້າ​ຈະ​ມີ​ກິນ​ຢ່າງ​ເຫລືອ​ເຟືອ​ຈົນ​ອີ່ມໜຳສຳລານ</para>
  <para style="q2" vid="JOL 2:26">ແລະ ເຈົ້າ​ຈະ​ສັນລະເສີນ​ນາມ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ​ຂອງ​ເຈົ້າ,</para>
  <para style="q2" vid="JOL 2:26">ຜູ້​ທີ່​ກະທຳ​ການ​ອັດສະຈັນ​ຕ່າງໆ​ເພື່ອ​ເຈົ້າ;</para>
  <para style="q1" vid="JOL 2:26">ປະຊາຊົນ​ຂອງ​ເຮົາ​ຈະ​ບໍ່​ຕ້ອງ​ອັບອາຍ​ອີກ​ຕໍ່​ໄປ.<verse eid="JOL 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27" />ແລ້ວ​ເຈົ້າ​ຈະ​ຮູ້​ວ່າ​ເຮົາ​ຢູ່​ໃນ​ອິດສະຣາເອນ,</para>
  <para style="q2" vid="JOL 2:27">ເຮົາ​ຄື​ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ​ຂອງ​ເຈົ້າ,</para>
  <para style="q2" vid="JOL 2:27">ແລະ ບໍ່​ມີ​ພະ​ອື່ນ​ອີກ;</para>
  <para style="q1" vid="JOL 2:27">ປະຊາຊົນ​ຂອງ​ເຮົາ​ຈະ​ບໍ່​ຕ້ອງ​ອັບອາຍ​ອີກ​ຕໍ່​ໄປ.<verse eid="JOL 2:27" /></para>
  <para style="s1">ວັນ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28" />“ແລະ ຕໍ່ມາ​ພາຍຫລັງ,</para>
  <para style="q2" vid="JOL 2:28">ເຮົາ​ຈະ​ເທ​ພຣະວິນຍານ​ຂອງ​ເຮົາ​ລົງ​ເທິງ​ທຸກ​ຄົນ.</para>
  <para style="q1" vid="JOL 2:28">ລູກຊາຍ ແລະ ລູກສາວ​ຂອງ​ພວກເຈົ້າ​ຈະ​ທຳນວາຍ,</para>
  <para style="q2" vid="JOL 2:28">ບັນດາ​ຊາຍ​ເຖົ້າ​ຂອງ​ພວກເຈົ້າ​ຈະ​ຝັນ​ເຫັນ,</para>
  <para style="q2" vid="JOL 2:28">ບັນດາ​ຊາຍ​ໜຸ່ມ​ຂອງ​ພວກເຈົ້າ​ຈະ​ເຫັນ​ນິມິດ.<verse eid="JOL 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29" />ໃນ​ວັນ​ເຫລົ່ານັ້ນ, ເຮົາ​ຈະ​ເທ​ພຣະວິນຍານ​ຂອງ​ເຮົາ</para>
  <para style="q2" vid="JOL 2:29">ລົງ​ມາ​ເທິງ​ຜູ້ຮັບໃຊ້​ຂອງ​ເຮົາ, ທັງ​ຊາຍ ແລະ ຍິງ,<verse eid="JOL 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30" />ເຮົາ​ຈະ​ສະແດງ​ການ​ອັດສະຈັນ​ໃນ​ຟ້າ​ສະຫວັນ</para>
  <para style="q2" vid="JOL 2:30">ແລະ ເທິງ​ແຜ່ນດິນໂລກ,</para>
  <para style="q2" vid="JOL 2:30">ຈະ​ມີ​ເລືອດ ແລະ ມີ​ໄຟ​ກັບ​ຄວັນ​ໄຟ.<verse eid="JOL 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31" />ດວງຕາເວັນ​ຈະ​ຖືກ​ປ່ຽນ​ເປັນ​ຄວາມ​ມືດ</para>
  <para style="q2" vid="JOL 2:31">ແລະ ດວງ​ຈັນ​ຈະ​ກາຍເປັນ​ເລືອດ</para>
  <para style="q2" vid="JOL 2:31">ກ່ອນ​ວັນ​ອັນ​ຍິ່ງໃຫຍ່ ແລະ ໜ້າ​ຢ້ານ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ​ຈະ​ມາ​ເຖິງ.<verse eid="JOL 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32" />ແລະ ທຸກຄົນ​ທີ່​ຮ້ອງ</para>
  <para style="q2" vid="JOL 2:32">ອອກ​ນາມ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ ກໍ​ຈະ​ໄດ້​ຮັບ​ຄວາມພົ້ນ;</para>
  <para style="q1" vid="JOL 2:32">ເພາະ​ເທິງ​ພູເຂົາ​ຊີໂອນ ແລະ ໃນ​ເຢຣູຊາເລັມ</para>
  <para style="q2" vid="JOL 2:32">ຈະ​ມີ​ການ​ກອບກູ້​ຢູ່​ທີ່​ນັ້ນ,</para>
  <para style="q2" vid="JOL 2:32">ຕາມ​ທີ່​ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ກ່າວ​ໄວ້,</para>
  <para style="q1" vid="JOL 2:32">ແມ່ນ​ແຕ່​ໃນ​ທ່າມກາງ​ບັນດາ​ຜູ້​ລອດ​ຊີວິດ</para>
  <para style="q2" vid="JOL 2:32">ເຊິ່ງ​ພຣະເຈົ້າ​ຢາເວ​ໄດ້​ເອີ້ນ​ໄວ້.<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s1">ຊົນຊາດ​ທັງຫລາຍ​ຖືກ​ພິພາກສາ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1" />“ເມື່ອ​ເຖິງ​ວັນ​ເຫລົ່ານັ້ນ ແລະ ເວລາ​ນັ້ນ,</para>
  <para style="q2" vid="JOL 3:1">ເມື່ອ​ເຮົາ​ຟື້ນຟູ​ຄວາມ​ຈະເລີນ​ຮຸ່ງເຮືອງ​ຂອງ​ຢູດາ ແລະ ເຢຣູຊາເລັມ​ນັ້ນ,<verse eid="JOL 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2" />ເຮົາ​ຈະ​ເຕົ້າໂຮມ​ທຸກ​ຊົນຊາດ</para>
  <para style="q2" vid="JOL 3:2">ແລະ ນຳ​ພວກເຂົາ​ລົງ​ມາ​ທີ່​ຮ່ອມພູ​ເຢໂຮຊາຟັດ.<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">ເຢໂຮຊາຟັດ ແປ​ວ່າ​ພຣະເຈົ້າ​ຢາເວ​ພິພາກສາ ຄື​ກັນ​ກັບ​ຂໍ້ <char style="xt" link-href="JOL 3:12"><ref loc="JOL 3:12">12</ref></char></char></note></para>
  <para style="q1" vid="JOL 3:2">ເຮົາ​ຈະ​ດຳເນີນ​ຄະດີ​ພວກເຂົາ​ຢູ່​ທີ່​ນັ້ນ</para>
  <para style="q2" vid="JOL 3:2">ເລື່ອງ​ທີ່​ປະຊາຊົນ​ອິດສະຣາເອນ​ຂອງ​ເຮົາ​ໄດ້​ເຮັດ​ຕໍ່​ມໍລະດົກ​ຂອງ​ເຮົາ,</para>
  <para style="q1" vid="JOL 3:2">ເພາະ​ພວກເຂົາ​ໄດ້​ເຮັດ​ໃຫ້​ປະຊາຊົນ​ຂອງ​ເຮົາ​ແຕກ​ກະຈັດ​ກະຈາຍ​ໄປ​ໃນ​ທ່າມກາງ​ຊົນຊາດ​ຕ່າງໆ</para>
  <para style="q2" vid="JOL 3:2">ແລະ ແບ່ງ​ດິນແດນ​ຂອງ​ເຮົາ.<verse eid="JOL 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3" />ພວກເຂົາ​ໄດ້​ຈັບ​ສະຫລາກ​ແບ່ງ​ປະຊາຊົນ​ຂອງ​ເຮົາ.</para>
  <para style="q2" vid="JOL 3:3">ແລະ ເອົາ​ເດັກນ້ອຍ​ຜູ້​ຊາຍ​ໄປ​ແລກປ່ຽນ​ກັບ​ຍິງ​ໂສເພນີ​ມາ;</para>
  <para style="q2" vid="JOL 3:3">ພວກເຂົາ​ໄດ້​ຂາຍ​ເດັກນ້ອຍ​ຜູ້ຍິງ​ເພື່ອ​ຈະ​ໄດ້​ເຫລົ້າອະງຸ່ນ​ມາ​ດື່ມ.<verse eid="JOL 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />“ຕີເຣ ແລະ ຊີໂດນ​ກັບ​ດິນແດນ​ຟີລິດສະຕິນ​ທັງໝົດ ເຈົ້າ​ມີ​ສິ່ງ​ໃດ​ຕໍ່ສູ້​ເຮົາ? ເຈົ້າ​ກຳລັງ​ແກ້ແຄ້ນ​ເຮົາ​ໃນ​ສິ່ງ​ທີ່​ເຮົາ​ໄດ້​ເຮັດ​ນັ້ນ​ບໍ? ຖ້າ​ເຈົ້າ​ແກ້ແຄ້ນ​ເຮົາ, ເຮົາ​ກໍ​ຈະ​ໃຫ້​ສິ່ງ​ທີ່​ເຈົ້າ​ໄດ້​ເຮັດ​ໄວ້​ຕົກ​ຖືກ​ເຈົ້າ​ເອງ​ຢ່າງ​ໄວວາ ແລະ ທັນທີທັນໃດ. <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />ເພາະ​ເຈົ້າ​ໄດ້​ຢຶດ​ເອົາ​ເງິນ ແລະ ຄຳ​ຂອງ​ເຮົາ​ກັບ​ຊັບສົມບັດ​ອັນ​ລ້ຳຄ່າ​ຂອງ​ເຮົາ​ໄປ​ໄວ້​ທີ່​ວິຫານ​ຕ່າງໆ​ຂອງ​ເຈົ້າ.<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">ຫລື ວັງ</char></note> <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />ເຈົ້າ​ໄດ້​ຂາຍ​ຊາວ​ຢູດາ ແລະ ຊາວ​ເຢຣູຊາເລັມ​ໃຫ້​ແກ່​ຊາວ​ກຣີກ ເພື່ອ​ເຈົ້າ​ຈະ​ໄດ້​ສົ່ງ​ພວກເຂົາ​ໄປ​ໃຫ້​ໄກ​ຈາກ​ບ້ານເກີດ​ເມືອງ​ນອນ​ຂອງ​ພວກເຂົາ.<verse eid="JOL 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7" />“ເບິ່ງ​ແມ, ເຮົາ​ຈະ​ກະຕຸ້ນ​ພວກເຂົາ​ໃຫ້​ອອກ​ມາ​ຈາກ​ສະຖານທີ່​ຕ່າງໆ ທີ່​ເຈົ້າ​ໄດ້​ຂາຍ​ພວກເຂົາ​ໃຫ້ ແລະ ເຮົາ​ກໍ​ຈະ​ໃຫ້​ສິ່ງ​ທີ່​ເຈົ້າ​ໄດ້​ເຮັດ​ໄວ້​ນັ້ນ​ຕົກ​ຖືກ​ເຈົ້າ​ເອງ. <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />ເຮົາ​ຈະ​ຂາຍ​ບັນດາ​ລູກຊາຍ ແລະ ລູກສາວ​ຂອງ​ເຈົ້າ​ໃຫ້​ແກ່​ຊາວ​ຢູດາ. ແລ້ວ​ຊາວ​ຢູດາ​ຈະ​ຂາຍ​ພວກເຂົາ​ໃຫ້​ຊາວ​ເຊບາ, ເຊິ່ງ​ເປັນ​ຊົນຊາດ​ໜຶ່ງ​ທີ່​ຢູ່​ໄກ”. ພຣະເຈົ້າ​ໄດ້​ກ່າວ​ດັ່ງນັ້ນ.<verse eid="JOL 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9" />ຈົ່ງ​ປະກາດ​ໃນ​ທ່າມກາງ​ຊົນຊາດ​ທັງຫລາຍ​ວ່າ:</para>
  <para style="q2" vid="JOL 3:9">ຈົ່ງ​ຕຽມພ້ອມ​ສຳລັບ​ສູ້ຮົບ!</para>
  <para style="q1" vid="JOL 3:9">ຈົ່ງ​ປຸກ​ລະດົມ​ບັນດາ​ນັກຮົບ!</para>
  <para style="q2" vid="JOL 3:9">ໃຫ້​ບັນດາ​ນັກ​ຕໍ່ສູ້​ທຸກຄົນ​ເຂົ້າ​ມາ​ໃກ້ ແລະ ບຸກ​ໂຈມຕີ.<verse eid="JOL 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10" />ຈົ່ງ​ຕີ​ໝາກກະສົບໄຖ​ຂອງ​ເຈົ້າ​ໃຫ້​ເປັນ​ດາບ</para>
  <para style="q2" vid="JOL 3:10">ແລະ ຕີ​ກ່ຽວ​ຂອງ​ເຈົ້າ​ໃຫ້​ເປັນ​ຫອກ.</para>
  <para style="q1" vid="JOL 3:10">ໃຫ້​ຄົນ​ທີ່​ອ່ອນແອ​ເວົ້າ​ວ່າ,</para>
  <para style="q2" vid="JOL 3:10">“ຂ້ອຍ​ເຂັ້ມແຂງ!”<verse eid="JOL 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11" />ຈົ່ງ​ມາ​ໄວໆ, ຊົນຊາດ​ທັງຫລາຍ​ຈາກ​ທຸກ​ທີ່​ທຸກ​ບ່ອນ,</para>
  <para style="q2" vid="JOL 3:11">ແລະ ມາ​ປະຊຸມ​ກັນ​ຢູ່​ທີ່​ນັ້ນ.</para>
  <para style="b" vid="JOL 3:11" />
  <para style="q1" vid="JOL 3:11">ຂ້າແດ່​ພຣະເຈົ້າ​ຢາເວ! ຂໍ​ໂຜດ​ສົ່ງ​ນັກຮົບ​ຂອງ​ພຣະອົງ​ລົງ​ມາ!<verse eid="JOL 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12" />“ຈົ່ງ​ກະຕຸ້ນ​ປະຊາຊາດ​ທັງຫລາຍ</para>
  <para style="q2" vid="JOL 3:12">ໃຫ້​ບຸກ​ໜ້າ​ມາ​ທີ່​ຮ່ອມ​ພູ​ເຢໂຮຊາຟັດ,</para>
  <para style="q1" vid="JOL 3:12">ເພາະ​ເຮົາ​ຈະ​ນັ່ງ​ຢູ່​ທີ່​ນັ້ນ</para>
  <para style="q2" vid="JOL 3:12">ເພື່ອ​ຕັດສິນ​ປະຊາຊາດ​ທັງໝົດ​ທຸກ​ດ້ານ.<verse eid="JOL 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13" />ຈົ່ງ​ແກວ່ງ​ກ່ຽວ​ໄປ,</para>
  <para style="q2" vid="JOL 3:13">ເພາະ​ເຂົ້າ​ກໍ​ສຸກ​ພ້ອມ​ໃຫ້​ກ່ຽວ​ແລ້ວ.</para>
  <para style="q1" vid="JOL 3:13">ຈົ່ງ​ມາ, ມາ​ຢຽບ​ໝາກອະງຸ່ນ,</para>
  <para style="q2" vid="JOL 3:13">ເພາະ​ອ່າງ​ຢຽບ​ໝາກອະງຸ່ນ​ກໍ​ເຕັມ​ແລ້ວ</para>
  <para style="q2" vid="JOL 3:13">ແລະ ອ່າງ​ເກັບ​ນັ້ນ​ມີ​ເຫລົ້າອະງຸ່ນ​ເຕັມ​ຈົນ​ລົ້ນ</para>
  <para style="q1" vid="JOL 3:13">ຄວາມ​ຊົ່ວ​ຮ້າຍ​ຂອງ​ພວກເຂົາ​ກໍ​ມີ​ຫລວງຫລາຍ!”<verse eid="JOL 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14" />ມີ​ຄົນ​ຈຳນວນ​ຫລວງຫລາຍ</para>
  <para style="q2" vid="JOL 3:14">ຢູ່​ໃນ​ຮ່ອມພູ​ແຫ່ງ​ການ​ພິພາກສາ!</para>
  <para style="q1" vid="JOL 3:14">ເພາະ​ວັນ​ແຫ່ງ​ພຣະເຈົ້າ​ຢາເວ​ແມ່ນ​ໃກ້​ເຂົ້າ​ມາ​ແລ້ວ</para>
  <para style="q2" vid="JOL 3:14">ໃນ​ຮ່ອມພູ​ແຫ່ງ​ການ​ພິພາກສາ.<verse eid="JOL 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15" />ຕາເວັນ ແລະ ເດືອນ​ຈະ​ມືດ​ມິດ​ໄປ</para>
  <para style="q2" vid="JOL 3:15">ແລະ ດາວ​ຈະ​ບໍ່​ສ່ອງ​ແສງ.<verse eid="JOL 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16" />ພຣະເຈົ້າ​ຢາເວ​ຈະ​ເປັ່ງ​ສຽງ​ອອກ​ມາ​ຈາກ​ຊີໂອນ</para>
  <para style="q2" vid="JOL 3:16">ແລະ ເປັ່ງ​ສຽງ​ຟ້າຮ້ອງ​ອອກ​ມາ​ຈາກ​ເຢຣູຊາເລັມ;</para>
  <para style="q2" vid="JOL 3:16">ແຜ່ນດິນ​ໂລກ ແລະ ຟ້າ​ສະຫວັນ​ຈະ​ສັ່ນສະທ້ານ.</para>
  <para style="q1" vid="JOL 3:16">ແຕ່​ພຣະເຈົ້າ​ຢາເວ​ຈະ​ເປັນ​ບ່ອນ​ລີ້ໄພ​ສຳລັບ​ປະຊາຊົນ​ຂອງ​ພຣະອົງ,</para>
  <para style="q2" vid="JOL 3:16">ເປັນ​ທີ່ໝັ້ນ​ສຳລັບ​ປະຊາຊົນ​ອິດສະຣາເອນ.<verse eid="JOL 3:16" /></para>
  <para style="s1">ພອນ​ສຳລັບ​ປະຊາຊົນ​ຂອງ​ພຣະເຈົ້າ</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17" />“ແລ້ວ​ນັ້ນ​ເຈົ້າ​ກໍ​ຈະ​ຮູ້​ວ່າ, ເຮົາ​ຜູ້​ເປັນ​ພຣະເຈົ້າ​ຢາເວ ພຣະເຈົ້າ​ຂອງ​ພວກເຈົ້າ.</para>
  <para style="q2" vid="JOL 3:17">ສະຖິດ​ຢູ່​ໃນ​ຊີໂອນ, ພູເຂົາ​ສັກສິດ​ຂອງ​ເຮົາ.</para>
  <para style="q1" vid="JOL 3:17">ເຢຣູຊາເລັມ​ຈະ​ບໍລິສຸດ​ສັກສິດ;</para>
  <para style="q2" vid="JOL 3:17">ຄົນ​ຕ່າງຊາດ​ຈະ​ບໍ່​ມາ​ທຳລາຍ​ເຢຣູຊາເລັມ​ອີກ.<verse eid="JOL 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18" />“ໃນ​ວັນ​ນັ້ນ​ຈະ​ມີ​ນ້ຳ​ອະງຸ່ນ​ໃໝ່​ຍ້ອຍ​ຈາກ​ພູເຂົາ</para>
  <para style="q2" vid="JOL 3:18">ແລະ ມີ​ນ້ຳນົມ​ໄຫລ​ມາ​ຈາກ​ໂນນພູ;</para>
  <para style="q2" vid="JOL 3:18">ຫ້ວຍນ້ຳ​ທັງຫລາຍ​ຂອງ​ຢູດາ​ຈະ​ມີ​ນ້ຳ​ນອງ.</para>
  <para style="q1" vid="JOL 3:18">ນ້ຳພຸ​ຈະ​ໄຫລ​ອອກ​ມາ​ຈາກ​ວິຫານ​ຂອງ​ພຣະເຈົ້າ​ຢາເວ</para>
  <para style="q2" vid="JOL 3:18">ໃຫ້​ຄວາມ​ຊຸ່ມ​ຊື່ນ​ແກ່​ຮ່ອມພູ​ຕົ້ນກະຖິນ.<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">ຫລື ຮ່ອມພູ​ຊິດຕີມ</char></note><verse eid="JOL 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19" />ແຕ່​ເອຢິບ​ຈະ​ຮົກຮ້າງ,</para>
  <para style="q2" vid="JOL 3:19">ເອໂດມ​ກາຍເປັນ​ຖິ່ນແຫ້ງແລ້ງກັນດານ,</para>
  <para style="q1" vid="JOL 3:19">ເພາະ​ຄວາມ​ໂຫດຮ້າຍ​ທີ່​ໄດ້​ເຮັດ​ໄວ້​ກັບ​ຊາວ​ຢູດາ,</para>
  <para style="q2" vid="JOL 3:19">ພວກເຂົາ​ໄດ້​ເຮັດ​ໃຫ້​ຜູ້​ບໍລິສຸດ​ຕ້ອງ​ຫລັ່ງ​ເລືອດ​ໃນ​ດິນແດນ​ນັ້ນ.<verse eid="JOL 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20" />ຢູດາ ແລະ ເຢຣູຊາເລັມ​ຈະ​ມີ​ຄົນ​ອາໄສ​ຢູ່</para>
  <para style="q2" vid="JOL 3:20">ຕະຫລອດໄປ​ທຸກ​ຊົ່ວ​ອາຍຸ.<verse eid="JOL 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21" />ຄວາມ​ຜິດ​ທີ່​ພວກເຂົາ​ເຮັດ​ໃຫ້​ເລືອດ​ຕົກ​ທີ່​ເຮົາ​ບໍ່​ໄດ້​ອະໄພ​ໃຫ້​ນັ້ນ</para>
  <para style="q2" vid="JOL 3:21">ເຮົາ​ຈະ​ໃຫ້​ອະໄພ”.</para>
  <para style="b" vid="JOL 3:21" />
  <para style="qc" vid="JOL 3:21">ພຣະເຈົ້າ​ຢາເວ​ສະຖິດ​ຢູ່​ໃນ​ຊີໂອນ!<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>