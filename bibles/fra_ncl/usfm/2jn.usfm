\mt1 Deuxième Épître de Saint Jean  
\c 1
\ms1 Adresse (1-3), — Amour fraternel (4-6). Les faux docteurs (1-11). — Conclusion(12-13).  
\s1 Salutations  
\p
\v 1 \w L’Ancien|strong="G3588,G4245"\w* \w à l’élue|strong="G1588"\w* \w la Dame|lemma="κυρίᾳ" strong="G2959"\w*\f + \fr 1:1 \ft \+it L’Ancien\+it* : ce mot ne se rapporte pas seulement au grand âge de l’auteur : il indique surtout la fonction ou la dignité. Dans la langue de l’Église au premier siècle, il désignait un \+it prêtre\+it* ou \+it évêque\+it*. — \+it À l’élue\+it* (chrétienne) \+it Kyria\+it*, ou bien \+it à la dame Electa\+it* : il s’agit ici d’une église ou communauté chrétienne particulière personnifiée sous la figure d’une femme.\f* \w et|strong="G2532"\w* \w à|strong="G3588"\w* \w ses|strong="G0846"\w* \w enfants|strong="G5043"\w*, \w que|strong="G3739"\w* \w j|strong="G1473"\w*\w ’aime|strong="G0025"\w* \w dans|strong="G1722"\w* \w la vérité|strong="G0225"\w*, — \w et|strong="G2532"\w* \w non pas|strong="G3756"\w* \w moi|strong="G1473"\w* \w seulement|strong="G3441"\w*, \w mais|strong="G0235"\w* \w aussi|strong="G2532"\w* \w tous|strong="G3956"\w* \w ceux qui|strong="G3588"\w* \w ont connu|strong="G1097"\w* \w la|strong="G3588"\w* \w vérité|strong="G0225"\w*, —  
\v 2 \w en considération de|strong="G1223"\w* \w la|strong="G3588"\w* \w vérité|strong="G0225"\w* \w qui|strong="G3588"\w* \w demeure|strong="G3306"\w* \w en|strong="G3588,G1722"\w* \w nous|strong="G2249"\w*, \w et|strong="G2532"\w* \w qui|strong="G3588"\w* \w sera|strong="G2071"\w* \w éternellement|strong="G0165"\w* \w avec|strong="G3326"\w* \w nous|strong="G2257"\w* :  
\v 3 \w la grâce|strong="G5485"\w*, \w la miséricorde|strong="G1656"\w* \add et\add* \w la paix|strong="G1515"\w* \w seront|strong="G2071"\w* \w avec|strong="G3326"\w* \w nous|strong="G5216"\w* \w de la part de|strong="G3844"\w* \w Dieu|strong="G2316"\w* \w le Père|strong="G3962"\w* \w et|strong="G2532"\w* \w de la part de|strong="G3844"\w* \w Jésus|strong="G2424"\w*-\w Christ|strong="G5547"\w*, \w le|strong="G3588"\w* \w Fils|strong="G5207"\w* \w du|strong="G3588"\w* \w Père|strong="G3962"\w*, \w dans|strong="G1722"\w* \w la vérité|strong="G0225"\w* \w et|strong="G2532"\w* \w l’amour|strong="G0026"\w* !   
\s1 La vérité et l’amour  
\p
\v 4 J’ai eu \w bien|strong="G3029"\w* \w de la joie|strong="G5463"\w* \w de|strong="G3754"\w* \w rencontrer|strong="G2147"\w* \w de|strong="G1537,G3588"\w* \w tes|strong="G4771"\w* \w enfants|strong="G5043"\w* qui \w marchent|strong="G4043"\w* \w dans|strong="G1722"\w* \w la vérité|strong="G0225"\w*, \w selon|strong="G2531"\w* \w le commandement|strong="G1785"\w* \add que\add* \w nous avons reçu|strong="G2983"\w* \w du|strong="G3844,G3588"\w* \w Père|strong="G3962"\w*.  
\v 5 \w Et|strong="G2532"\w* \w maintenant|strong="G3568"\w* je \w te|strong="G4571"\w* \add le\add* \w demande|strong="G2065"\w*, \add ô\add* \w Dame|lemma="κυρίᾳ" strong="G2959"\w*, — \w non|strong="G3756"\w* \w comme si|strong="G5613"\w* je \w te|strong="G4771"\w* \w prescrivais|strong="G4671"\w* un \w commandement|strong="G1785"\w* \w nouveau|strong="G2537"\w* ; \w car|strong="G0235"\w* c’est \w celui que|strong="G3739"\w* \w nous avons reçu|strong="G1502"\w* \w dès|strong="G0575"\w* \w le commencement|strong="G0746"\w*, — \w aimons-nous|strong="G0025"\w* \w les uns les autres|strong="G0240"\w*.\x + \xo 1:5 \xt Cf. 1Jn 2,7.\x*  
\v 6 \w Or|strong="G2532"\w* \w l|strong="G3588"\w*\w ’amour|strong="G0026"\w* \w consiste|strong="G1510"\w* \w à|strong="G2443"\w* \w marcher|strong="G4043"\w* \w selon|strong="G2596"\w* \w ses|strong="G3588,G0846"\w* \w commandements|strong="G1785"\w* ; \w et|strong="G2532"\w*, \w c|strong="G3588"\w*’\w est|strong="G1510"\w* \add là\add* \w son commandement|strong="G1785"\w*, \w comme|strong="G2443"\w* \w vous l’avez appris|strong="G0191"\w* \w dès|strong="G0575"\w* \w le commencement|strong="G0746"\w*, \w de|strong="G2443"\w* \w marcher|strong="G4043"\w* \w dans|strong="G1722"\w* \add l’amour\add*.   
\p
\v 7 \w Car|strong="G3754"\w* \w plusieurs|strong="G4183"\w* \w séducteurs|strong="G4108"\w* \w ont paru|strong="G1831"\w* \w dans|strong="G1519"\w* \w le|strong="G3588"\w* \w monde|strong="G2889"\w* ; ils ne \w confessent|strong="G3670"\w* \w pas|strong="G3361"\w* \w Jésus|strong="G2424"\w* \add comme\add* \w Christ|strong="G5547"\w* \w venu|strong="G2064"\w* \w en|strong="G1722"\w* \w chair|strong="G4561"\w*\f + \fr 1:7 \ft \+it Comme Christ\+it*, comme le Messie, fils de Dieu, sauveur du monde ; ou bien, \+it ne confessent pas Jésus-Christ vent en chair\+it*.\f* : c’\w est|strong="G1510"\w* \w là|strong="G3778"\w* \w le|strong="G3588"\w* \w séducteur|strong="G4108"\w* \w et|strong="G2532"\w* \w l|strong="G35880"\w*\w ’antéchrist|strong="G0500"\w*.  
\v 8 \w Prenez garde à|strong="G0991"\w* \w vous-mêmes|strong="G1438"\w*, \w afin que|strong="G2443"\w* \w vous ne perdiez|strong="G0622"\w* \w pas|strong="G3361"\w* \w le fruit de|strong="G3739"\w* \w votre travail|strong="G2038"\w*\f + \fr 1:8 \ft \+it Votre travail moral\+it*, vos bonnes œuvres. D’après une autre leçon très autorisée, \+it de notre travail\+it*, des travaux de l’Apôtre au milieu d’eux.\f*, \w mais|strong="G0235"\w* \add que\add* \w vous receviez|strong="G0618"\w* \add une\add* \w pleine|strong="G4134"\w* \w récompense|strong="G3408"\w*.  
\v 9 \w Quiconque|strong="G3956,G3588"\w* \w va au-delà|strong="G4254"\w*\f + \fr 1:9 \ft \+it Va au-delà\+it*, quelques manuscrits, dont la Peshitta, ont : \+it transgresse\+it*.\f* \w et|strong="G2532"\w* ne \w demeure|strong="G3306"\w* \w pas|strong="G3361"\w* \w dans|strong="G1722"\w* \w la|strong="G3588"\w* \w doctrine|strong="G1322"\w* \w du|strong="G3588"\w* \w Christ|strong="G5547"\w*, ne \w possède|strong="G2192"\w* \w pas|strong="G3756"\w* \w Dieu|strong="G2316"\w* ; \w celui qui|strong="G3588"\w* \w demeure|strong="G3306"\w* \w dans|strong="G1722"\w* \w cette|strong="G3588"\w* \w doctrine|strong="G1322"\w* \w possède|strong="G2192"\w* \w et|strong="G2532"\w* \w le|strong="G3588"\w* \w Père|strong="G3962"\w* \w et|strong="G2532"\w* \w le|strong="G3588"\w* \w Fils|strong="G5207"\w*.  
\v 10 \w Si|strong="G1487"\w* \w quelqu’un|strong="G5100"\w* \w vient|strong="G2064"\w* \w à|strong="G4314"\w* \w vous|strong="G5209"\w* \w et|strong="G2532"\w* \w n’apporte|strong="G5342"\w* \w pas|strong="G3756"\w* \w cette|strong="G3778,G3588"\w* \w doctrine|strong="G1322"\w*, ne \w le|strong="G0846"\w* \w recevez|strong="G2983"\w* \w pas|strong="G3361"\w* \w dans|strong="G1519"\w* \add votre\add* \w maison|strong="G3614"\w*, \w et|strong="G2532"\w* ne \w lui|strong="G0846"\w* \w dites|strong="G3004"\w* \w pas|strong="G3361"\w* : \w Salut|strong="G5463"\w* !  
\v 11 \w Car|strong="G1063"\w* \add celui qui\add* \w lui|strong="G0846"\w* \w dit|strong="G3004"\w* : \w Salut|strong="G5463"\w* ! \w participe|strong="G2841"\w* \w à ses|strong="G0846,G3588"\w* \w œuvres|strong="G2041"\w* \w mauvaises|strong="G4190"\w*.   
\s1 Dernière remarques  
\p
\v 12 \w Quoique j’eusse|strong="G2192"\w* \w beaucoup|strong="G4183"\w* \add de choses\add* \w à vous|strong="G5213"\w* \w écrire|strong="G1125"\w*, je n’ai \w pas|strong="G3756"\w* \w voulu|strong="G1014"\w* \add le faire\add* \w avec|strong="G1223"\w* \w le papier|strong="G5489"\w* \w et|strong="G2532"\w* \w l’encre|strong="G3188"\w* ; \w mais|strong="G0235"\w* \w j’espère|strong="G1679"\w* \w aller|strong="G1094"\w* \w chez|strong="G4314"\w* \w vous|strong="G5209"\w* \w et|strong="G2532"\w* \w vous entretenir|strong="G2980"\w* \w de vive voix|strong="G4750,G3756,G4750"\w*, \w afin que|strong="G2443"\w* \w votre|strong="G3588,G2249"\w* \w joie|strong="G5479"\w* \w soit|strong="G1510"\w* \w parfaite|strong="G4137"\w*.   
\p
\v 13 \w Les|strong="G3588"\w* \w enfants|strong="G5043"\w* \w de|strong="G3588"\w* \w ta|strong="G0079"\w* \w sœur|strong="G4675"\w* \w l|strong="G3588"\w*’\w élue|strong="G1588"\w* \w te|strong="G4571"\w* \w saluent|strong="G0782"\w*.\f + \fr 1:13 \ft C’est-à-dire les fidèles de l’Église, élue de Dieu, d’où je t’écris, \ft \+it te saluent\+it*.\f*   