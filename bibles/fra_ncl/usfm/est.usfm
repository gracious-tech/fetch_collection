\p « \w Assuérus|strong="H0325"\w*, \w le|strong="H0559"\w* \w grand|strong="H1419"\w* \w roi|strong="H4428"\w*, \w aux|strong="H0559"\w* \w satrapes|strong="H0324"\w* \w et|strong="H4872"\w* \w aux|strong="H0559"\w* \w chefs|strong="H8269"\w* \w des|strong="H3068"\w* \w cent|strong="H3967"\w* vingt-sept \w provinces|strong="H4082"\w*, \w de|strong="H1121"\w* l’Inde \w à|strong="H0559"\w* l’Ethiopie, \w et|strong="H4872"\w* \w à|strong="H0559"\w* \w ceux|strong="H0582"\w* \w qui|strong="H0376"\w* \w ont|strong="H0001"\w* \w à|strong="H0559"\w* cœur \w nos|strong="H0947"\w* intérêts, \w salut|strong="H3444"\w* !   
