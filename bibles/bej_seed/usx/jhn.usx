<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Bella</book>
  <para style="h">Yuuhannaay</para>
  <para style="toc1">Yuuhannaay Wꞌinjiil</para>
  <para style="toc2">Yuuhannaay</para>
  <para style="mt">Yuuhannaay Wꞌinjiil</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">Yasuuꞌa Ukwaasanaay Ibhali Tuduniyaatii Dehaay Eeya</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />Ibhali hankaab iiktiina, baliin ibhali aree Ukwaasanaay geeb iifiina, ibhali aree Ukwaasana iiktiin. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />Ibhali hankaab Ukwaasanaay geeb iifiin.<verse eid="JHN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 1:3" />Bariisooh naatka daamta. Daamtaanaaka beet barooh anu naat han kadaamta. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />Bariiyooh umidhhan eefi. Been umidhhan aree oodehayi nuur iikti. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />Uunuur uthibniib buubiini. Laakiin uuthibin oonuur afhamaab kiiki.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />Beentooy Yuuhannaab iidni tak Ukwaasana diigwataab iiktiyi eeya. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />Baruuh been unuuri kehii iibidehi jillaay eeya. Aflaay kassaah uudehay tudiigwat maasiwtiit aamaneen ikatiin. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />Baruuh uukna oonuur kiiki. Unuurii dehaay iibidehi jillaay oobhaat yꞌaabi. <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />Usidki nuur been kasseeh tuduniyaatii dehaay yꞌiin oodehayi kehii talawiini.<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />Baruuh tuduniyaatiib iifi. Aree tuduniya bariisooh daamtaneek han, tuduniya barooh kanaat kitti. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />Baruuh whaashooh ooknaay eeya. Laakiin udehayuuh uukna barooh ashshaab kiikeen. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />Laakiin gwadi barooh yꞌashishniit haay aamaniyaan. Aflaay bareeh Ukwaasanaay ar haay ikatiini hag yhii. <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />Aan baraah takwaakw firaay wꞌaadami niyaamiit ikwasiyeeb tari takiit niyaatee ikatiin firaay kiikeen. Laakiin Ukwaasanaay faray ikatiin.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />Ibhali bashar ikeena, aree uun baruuh geeboon ikwiri. Hinin bariiyooh umatuun rhina, Gaalꞌooriib umatuun Ubaabaay eeyaab, nꞌimaatwa sidikwa ataabi.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />Yuuhanna bariiyooh bhaliiya. Baruuh winneet waawiyaayt, “Uun baruuh ani haay hadiidaab iiktiyeebu, ‘Baruuh anii harꞌii yꞌiini, laakiin aniika winkaabi. Een haay andiyeeb usabab aree baruuh ani faraay baakaay whankaay iifi.’ adi.” idi Yuuhanna. <verse eid="JHN 1:15" /><verse number="16" style="v" sid="JHN 1:16" />Bariiteeh tinꞌimaati guudtii hinin kassaan tibaraka taktaki harꞌii nimri. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Ukwaasana whag Muusaay geebii yhii hoon. Laakiin tinꞌimaawwa oosdikwa Yasuuꞌaab Umasiihi geebii haay yhii hoon. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Ukwaasana gaal han rhaab kiiki. Wꞌoor Gaalalaay Ukwaasana tꞌiiteeb masi aree Ubaabaay dar ikatiib, baruuh barooh isookin.<verse eid="JHN 1:18" /></para>
  <para style="s">Yuuhannaab Umoosanaayt Diigwat</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Iyahuudi suurkina Alguduseeb iifiin fagiiriyaab gwadibwa, Laawiibwa Yuuhannaay dehaay diigwatiyaaniit raatiyaana, “Baruuk aabwa?” idiin. <verse eid="JHN 1:19" /><verse number="20" style="v" sid="JHN 1:20" />Baruuh ifdhadh nuun tawaay kiiki, “Ani Umasiih kaaki.” idi.<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />Baraah barooh raatiyaana, “Aflaay aabwa? Baruuk Eelyaabwa?” idiin.</para>
  <para style="p" vid="JHN 1:21">Baruuh “Ani kaaki” idi.</para>
  <para style="p" vid="JHN 1:21">Baraah “Baruuk Unabiiwwa?” idiin.</para>
  <para style="p" vid="JHN 1:21">Baruuh “Abadan” idi.<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />Baraah aakhar, “Aabwa? Sooyaa hoon, baliib idiigwatiyaaneen bayiit sooyi niyad. Ugarooyook aabu tindiya?” idiin.<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />Yuuhanna unabi Isyaasiib ibhaliyee dehaay idgi, “Ani gaal umingaayiib waliikiiniinaay hissu, ‘Wꞌankwanaay dehaay usalal takwaakw kwaasna!’ indiinaay whiss akati.” idi.<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Oontꞌa Ifariisi diigwatiyaani diigwatkina gali barooh raatiyaana, <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />“Baruuk Umasiih bitkaayeek, Eelyaab bitkaayeek, Unabi bitkaayeek, aflaay naanhooy tinmiisa?” idiin.<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />Yuuhanna igwibi, “Ani yamee anmiis. Laakiin bareeyookna bitik gaal baraakna bitkaanneeb yakiini. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />Baruuh anii harꞌii yꞌiiniib ikati, ani bariiteeh tigidhꞌaati mhakwara afandiigee dehaay han kaꞌadgiran.” idi.<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />Tuun tuuna kastuuh Urduni bhari dar ooraaw tiifiit Beetaanyaay tiki. Yuuhanna been oomhiin oodehay iimis.<verse eid="JHN 1:28" /></para>
  <para style="s">Ukwaasanaay Whu</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Tooyin tumalya Yuuhanna Yasuuꞌaab barooh beeti yꞌee rhiyaayt, “Shibibna, Ukwaasanaay Whu tooy eefi, uun whu tuduniyaati danuub giigsiini! <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Uun baruuh ani haay hadiidaneeb ikati, ‘Anii harꞌii tak yꞌiini, laakiin aniika winkaabu, een haay andiyeeb usabab aree baruuh ani faraay baakaay iifi.’ adi. <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Ani uknaayu barooh kanaab kaaki. Laakiin baruuh Israaꞌiiliib oodehayi bitik atookakinaab iiktiyi jillaay ani yamee misee yꞌan.” idi Yuuhanna.<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />Malya Yuuhanna teen tibadeha sooya: “Aashuuk kwibheeriitiit hayꞌaatiit tibreetee nꞌati tikwee rhan aree bariiyooh kehii daayiin. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Ani barooh iiktiyeet toona masi kanaab kaaki. Laakiin barooh yamee iimsi jillaay aneeb diigwatiyaab Ukwaasana sooyiheeb, ‘Aashuuk tikwi yꞌiit kehii daayee rhitiniyeeb ootak, been baruuh Eeshuuk Imugaddasaayee iimis indiib ikati.’ idiheeb. <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Ani beet toona rhan, aree uun baruuh Ukwaasanaay Wꞌoor ikatiyeet toona badehiib akati.” idi.<verse eid="JHN 1:34" /></para>
  <para style="s">Yasuuꞌiib Ikwiriyaatay Yhankaaneeb</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Tooyin tooraaw Yuuhanna beentooy malu kwiriyaatayeeh geeb masi gadee, <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />Yasuuꞌaab hasamee rhiyanihoob, baruuh “Ukwaasanaay whu uun ikati!” idi.<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />Ikwiriyaatay imalu barooh bak diyee imaasiwnihoob, baraah Yasuuꞌaab iramna. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />Yasuuꞌa nakamiya, aree bareeh ramee rhiyanihoob raatiya, “Naan tehariwna?” idi.</para>
  <para style="p" vid="JHN 1:38">Baraah “Rabbi, naad kwarriya?” idiin. Iyahuudi bhaliyeeb Rabbi “Seedna” miyaadi.<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />Yasuuꞌa “Mꞌaanaat shibibna” idi.</para>
  <para style="p" vid="JHN 1:39">Aflaay baraah iramniit baruuh ikwiireeb oomhiin ishbibna, aree been oombꞌi bariiyooh geeb yꞌayimna. Been uudoor asir iifi.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Siimoon Bitrusi san Andaraawoos, baliib Yuuhannaay ibhali imaasiwniit Yasuuꞌaab iram imalooyeeb gaal iikti. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />Igidiyeesooh Andaraawoos Siimoon oosan imriit sooya, “Hinin Umasiih nimri.” idi. Tuun tukalma Umasiih miyaadi. <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />Malya barooh Yasuuꞌaab haay ibi.</para>
  <para style="p" vid="JHN 1:42">Yasuuꞌa Siimoon ishbibaayt, “Oosmook Siimoon Yuuhannaay oor iyadna, laakiin Siifaas ituusim tindiya.” idi. Bitruswa Siifaaswa mhallaah “Liilaaw” miyaadi.<verse eid="JHN 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Tooyin tumalya Yasuuꞌa Jaliil ookiik giig niyaamiya. Baruuh Fiilibus imriit, bariiyooh dehaay, “Ramaheeb” idi.<verse eid="JHN 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44" />Fiilibus Beetsaydaay iikti, Andaraawooswa Bitruswa han tumadiina Beetsaydaay ikwiirna. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />Fiilibus Naatnaaꞌeel imriit sooya, “Muusa, whaggi kitaabiib hooy kitbaab iiktiyeeb, inabiya han hooy kitbaab iiktiineeb beeb nimri. Baruuh Yasuuꞌaab Unaasiraayi, Yuusifiib wꞌoor ikati.” idi.<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Naatnaaꞌeel raatiya, “Naasiraay daayiina eetni han?” idi.</para>
  <para style="p" vid="JHN 1:46">Fiilibus “Mꞌaat shibiba!” idi.<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Yasuuꞌa Naatnaaꞌeel yꞌee rhiyanihoob, bariiyooh hadiidiya, “Sidki Israaꞌiilaayi naat han maagt baabariib tooy eefi.” idi.<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />Naatnaaꞌeel raatiya, “Kak tikteenaheeb?” idi.</para>
  <para style="p" vid="JHN 1:48">Yasuuꞌa “Fiilibus baawaliiki hook, utiini hindi whii sꞌee rhan hook.” idi.<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Naatnaaꞌeel “Seedna, baruuk Ukwaasanaay Oorwa! Baruuk Israaꞌiileeb Whadꞌa tikatiya.” idi.<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />Yasuuꞌa “Ani utiini hindi whii rhan hook adi akay baruuk aamanta han? Beenaatiika wawinkaana rhi tindiya.” idi. <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />Malya Yasuuꞌa, “Oosdik andi hookna, baraak taabri nigaltiit, Ukwaasanaay malak Wꞌaadami Oori kehii astiiwwa nꞌatiiwwa sakee rhi tiyadna.” idi.<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">Yasuuꞌa Eeyam Haab Ikwaas</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Tooyin tumhaya Jaliili haashiib Gaanaay doob iiktiin. Yasuuꞌiit tuundi beentooy tiifi. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />Yasuuꞌaawwa ikwiriyaatayaahwa han been idoobaani mhiin waliikamaa iifiin. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />Wha faayamiyanihoob, Yasuuꞌiit tuundi bariiyooh dehaay, “Baraah shaawti haab kiibariin.” tidi.<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />Yasuuꞌa “Yaa takatay, naan tindii, aniib uudoor masi yꞌaab kiiki.” idi.<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Yasuuꞌiit tuundi ishagaamanaayee dehaay, “Baruuh indiyeetookna toonaaka dꞌiina.” tidi.<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Iyahuudi diini tahaaraatiit aada iibriina, beet toonaatii dehaay aree asagwir aweeyi diwan yam toobamaab iifiin. Diwaanka sheeb litraab yꞌibik.<verse eid="JHN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 2:7" />Yasuuꞌa ishagaamanaayee dehaay, “Eedwan yam toobaana.” idi. Aflaay baraah eedwan iyafa ookiik yam itibna.<verse eid="JHN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 2:8" />Malya baruuh bareeh sooya, “Oontꞌa shalik yam hooy ahaanaat ootak tꞌaduuma abkaab hiina.” idi.</para>
  <para style="p" vid="JHN 2:8">Baraah han beet toona idꞌiin. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />Oontꞌa aayam haab ikeena, aree uutak tꞌaduuma abkaab eeyam dꞌamisiya. Baruuh wha keeya mhiinii eeyaneeb kiikan, laakiin ishagaamana beet toona iktiinna. Malya udooba waliikiyaayt, <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />“Uudehay gaalka wha udaayiib hankaab iyawna, aree malya yꞌamna gwꞌeetiit eelꞌanihoob wha iyameemaab iyawna. Laakiin baruuk oontꞌa hadiit wha udaayiib tidibiya.” idi.<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Yasuuꞌa teen timꞌuujisa Jaliileeb Gaanaay ikwaas. Beentooy umatuunooh rhisiya, aree ikwiriyaatayaah barooh haay aamaniyaan.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />Toon toonaati harꞌii, Yasuuꞌaawwa tuundeehwa, isanaayaahwa, ikwiriyaatayaahwa Kafarnaahuum ibeen. Baraah beentooy shalikt yina yhagitna.<verse eid="JHN 2:12" /></para>
  <para style="s">Yasuuꞌa Udiini Gaw Ibi</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Iyahuudi Whasamti Wꞌiid idwilihoob, Yasuuꞌa Algudus ookiik giigiya. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Beentooy Ukwaasanaay gawiib dehay shꞌaabwa, anootwa, kilaywa iidlib rhiya. Masi warib tarabeesaati kehii sꞌee mhallagaab iibdil rhiya. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Aflaay baruuh kwirbaaj lilee idꞌiit, kasseeh eeshꞌaawwa tꞌanoowwa Ukwaasanaay gawii mhaliya. Imhallaga iibdil eendee titarabeesa hooy bꞌoosiya idꞌi, aree eegrish hooy ibrir idꞌi. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Eekilay iidlib oodehayii dehaay, “Tooysii haay firꞌana! Baabiyu oogaw bꞌiishraay mhiin baakwaasna!” idi.<verse eid="JHN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 2:17" />Ikwiriyaatayaah uuktaab iideeb ibhali shꞌiyaan. Uuktaab “Ugawiyuuk reer tunꞌeetiit iiliwheeb indi.” indi.<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Malya Iyahuudi suurkina barooh raatiyaana, “Baruuk toon toona kastooh haay tikwasiyeet tehadꞌaayeetook dehoon akkadtiniyee dehaay, mꞌuujisaateet alaama naan rhistiniya hoon?” idiin.<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />Yasuuꞌa bareeyooh dehaay igwibi, “Oon Ukwaasanaay oogaw katꞌaana, aree ani mhayt yinaateeb masi iidꞌir andi.” idi.<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />Baraah “Oon oogawi dꞌuur fadhig tamuunwa asagwir hawla iyhi, aree baruuk barooh mhayt yinaateeb masi iidꞌir tindiya han?” idiiniit raatiyaan. <verse eid="JHN 2:20" /><verse number="21" style="v" sid="JHN 2:21" />Laakiin Yasuuꞌa haay hadiidiyeeb Ukwaasanaay oogaw barooh ooknaay ugaru iikti. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Aflaay baruuh tuyatii yakiyani harꞌii, ikwiriyaatayaah een baruuh diyaab iiktiyeeb ibhali shꞌiyaan. Malya baraah ooktaab aamaniyaana, aree Yasuuꞌa iideeb ibhali han aamaniyaan.<verse eid="JHN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Whasamti Wꞌiidiib Yasuuꞌa Alguduseeb iifiyi door, baruuh iikwisiyeet timꞌuujisa rhiyaan uudehay gwida barooh aamaniyaan. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Laakiin Yasuuꞌa bareeh kasseeh iktiin akay, bareeh ugarooyooh bareeyooh dehaay aamanaab kiiki. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Bareeh iginꞌaayeeb tiifiit toona iktiin akay, baruuh dehayiit badeha shanha kiiki.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">Yasuuꞌaawwa Niigoodiimooswa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Niigoodiimoos iidni tak Fariisi, Iyahuudi suurkinaayeeb gaal iiktiib iifi. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Baruuh Yasuuꞌii dehaay amas eeyaayt, “Seedna, baruuk Ukwaasana diigwataayook ikatiyi tak tikatiyeet toona nikteen. Ukwaasana geebook biihaayeek aree, timꞌuujisa baruuk tikwasiyeet ikwasi tak kiihaay.” idi.<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />Yasuuꞌa bariiyooh dehaay, “Oosdik andi hook, malya door faraay baakaay Ukwaasanaayt tehadꞌaayi rhiini tak kiihaay.” idi.<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />Niigoodiimoos raatiya, “Kak eegrim tak masi itfari? Shaawti na sidik toondeeti yaam shuumiit malya door itfari tak kiihaay.” idi.<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />Yasuuꞌa igwibi, “Oosdik andi hook, yameewwwa Ishuukeewwa baafiraay, Ukwaasanaayt tehadꞌaayi gaal han adgiriit kashuumiya. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Ubashar bashar fanri, laakiin Aashuuk shuuk ifeerna. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />Ani ‘Ibakii malya door titfariya’ andiyeeb ibhali shaawti baaꞌajjabsa. <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />Ubaraam toojha teharriiweetka beeti nanfi. Whissooh teemsiiwa, laakiin naaysooh yꞌaabu, tari naad eebi kitkana. Aflaay Ishuukee faraay oodehayi geeb han bak ikati.” Yasuuꞌa idi.<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />Niigoodiimoos raatiya, “Tuun kak tikati?” idi.<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />Yasuuꞌa igwibi, “Baruuk Israaꞌiili bitik win koojaabwa, teen teena kaꞌafhamta han? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Oosdik andi hook: hinin tinikteeniyi bhaliinay, aree tirhinayi soonay, laakiin masi bareesookna gaal han hineet tibadeha agbilaab kiiki. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Ani toobuuti kehii eefeent tinaateeb hadiidan, aree baraakna aamanaab kitteen. Tibreeteeb eefeent tinaateeb hadiidaniyeek, aflaay kak aamaniheeb tiyadna? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Teebri tak reewaab kiiki, tibreetee yꞌaab nuun. Baruuh aree Wꞌaadami Oor ikati.<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />Muusa umingaayiib asti yꞌabkeeb ukwakwariit, aflaay Wꞌaadami Oor han ibakii asti yakami indi. <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />Shaawti barooh aamaniiniibka, daayim midhhan imaar indi.<verse eid="JHN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16" />Ukwaasana tuduniya winneet areeyiini akay Gaalꞌoorooh yhii. Aflaay barooh aamaniiniibka iiyyi kiidi, laakiin daayim midhhan imaar indi. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />Ukwaasana Wꞌoorooh tuduniyaati kehii gaadiib iiktiyi jillaay diigwataab kiiki. Laakiin bariiyooh geebii tuduniya ishidhhiini jillaay diigwataabi. <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />Baliin Wꞌoor aamaneen hukwmami kiidiin. Laakiin baliin barooh aamanaab baakay suur akay hukwmamaaba. Usababu aree, baraah Ukwaasanaay Gaalꞌoor aamanaab kiikeen. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />Whukwim aree bak daayiini: Uunuur tuduniya eeya, uudehay laakiin igwababaahna amagayt, unuuriika oothibin areeyaan. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Tumaagnaay shagaameen baliin kassaah oonuur eeribna, tumaagti shagaayuuhna biilawayi jillaay, oonuur beeti kaꞌeeyaan. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Laakiin usidkii sakeen baliin, Ukwaasanaayt sinaakrooytiib daayaaneeb ishaga lawseeni jillaay, oonuur beeti yꞌeen.” idi.<verse eid="JHN 3:21" /></para>
  <para style="s">Yasuuꞌaawwa Yuuhannaabwa</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Malya Yasuuꞌaawwa ikwiriyaatayaahwa Yahuudaay whaash ibeen. Beentooy shalik door yhagitna, aree baruuh oodehay imis. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />Yuuhanna han Saaliim dawil mhiin Eenooneeb gwida yam iifiinayt, beentooy oodehay iimis. Uudehay bariiyooh dehaay yꞌiina, baruuh han oodehay iimis. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />(Tuun tuuna aree Yuuhanna oosjin shuumaab baakaay tiikti.) <verse eid="JHN 3:24" /><verse number="25" style="v" sid="JHN 3:25" />Yuuhannaayiib ikwiriyaatayee galibwa Yahuudiib gaalwa tutahaaraateet mishgweedhtiib imgwassaarna. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />Aflaay baraah Yuuhannaab ibeeniit, “Seedna, Urduni daraag uraawiib geebook iifiib, beeb baruuk daayiib dehaay tibideheeb, oontꞌa baruuh inmiis, aree uudehay kassaah barooh eebiin.” idiin.<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />Yuuhanna igwibi, “Ukwaasana hiiyyaab biikaayeena, gaal han naat kiimri. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Ani ‘Umasiih kaaki, laakiin ani bariiyooh suurii diigwatamaabu.’ adiyeet toona baraakna iknaayaakna badehiibaana. <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Udooba ikatiib tudooba ibariibu. Laakiin udoobaay araaw oodar gadiit eemsiiw, udoobaay hiss eemsiiwihoob winneet itmadhiidh. Aniit tifirha han oontꞌa bak timmiimeen. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Baruuh ibakii inwiin, ani laakiin ibakii andhiim.” idi.<verse eid="JHN 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />Mhakwaliisii tikwiiniib kasseesoohka winkaab ikati. Tubuutii ikatiib toobuut kinaamiini, toobuutiib eefeent tinaatee sakanaayiini. Laakiin tibreetee yꞌiiniib kasseesoohka winkaabi. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Baruuh toona turhiyaneetwa tꞌimaasiweetwa sooyiini. Masi gaal han tudiigwattooh kaꞌagbiliya. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Laakiin bariitooh tudiigwat agbiliiniibka, Ukwaasana sidkiib ikatiyeet toona rhisiini. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Ukwaasana Eeshuuk adad anu iniiwayt, Ukwaasana diigwataab ikatiyi, Ukwaasanaay bhali hadiidiini. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />Ubaaba Wꞌoorooh areeyiini, aree naatka bariiyeeh yꞌayeeb daasiya. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Wꞌoor aamaniiniibka umidhhan udaayim manri. Wꞌoor inriibka midhhan imaar kiidi. Laakiin Ukwaasanaay igadab bariiyooh kehii daayeen.<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">Yasuuꞌaawwa Takat Saamriitwa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Ifariisi Yasuuꞌa ansiramiya, Yuuhannaayiika gwidaka kwiriya inmiis diyee imaasiwna, <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />laakiin ikwiriyaatayaah iimisna nuun, Yasuuꞌa uukna gaal han misaab kiiki. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Aflaay Yasuuꞌa ibhali yꞌattiyoodiyaab imaasiwihoob, Yahuudaay giigiyaayt Jaliil beeti masi yꞌagar.<verse eid="JHN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 4:4" />Oontꞌa baruuh Saamiraay geebii hasamiyeet toonaati. <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />Aflaay baruuh Saamiraay tiifiit madiina Sookhaar iidneet iktim. Batuuh Yaaguub wꞌoorooh Yuusif hiiyyaab iiktiyeeb whaashii sagiit kitti. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Been whaashiib Yaaguubiit tuuri tiifi. Yasuuꞌa tꞌiibaabtii dayyariya aree tooreeti kwayaay nꞌati isꞌa. Been uudoor nabhoob iikti.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />Takat Saamiraayiit yami harawaay toori tikwtaay eeta. Yasuuꞌa batiiyooh dehaay, “Yam gwꞌasiiheeb.” idi. <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />Ikwiriyaatayaah mꞌariit dilibti iyiyni jillaay tumadiina bayaa iifiin.<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />Tutakat Tusaamiri bariiyooh dehaay, “Baruuk Yahuudiibwa, ani aree Saamriitu, kak yami gwꞌasti raattiniyaheeb?” tidi. Iyahuudi Isaamri kiiꞌamdawaalna.<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />Yasuuꞌa batiiyooh dehaay, “Ukwaasanaay oomyaaw tiktiineek aree batook eeyam raatiiniib aab ikatiyeet toona tiktiineek, barooh raattii aree baruuh ishidhhiin yam iyiw hooki.” idi.<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />Tutakat “Duuruun, baruuk dirkwaat kitbariya aree tuuri aree hoogaati. Een eeyam yꞌishidhhiin naad manriya? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Baruuk baaboon Yaaguubiika winkaabwa han? Baruuh toori yhii hoon, aree baruuh uukna batiisooh gwꞌiya. Yꞌaraahwa ureewuuhwa han bak idꞌiin.” tidi.<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />Yasuuꞌa batiiyooh dehaay, “Een eeyam gwꞌiiniibka masi ityiw indi, <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />laakiin ani aniiweeb eeyam gwꞌiiniibka shaawti door han ityiw kiidi. Aayam ani aniiweeb bariiyooh tehooyteeb thaw iikti iyadna, aree barooh umidhhan udaayim iyawna.” idi.<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />Tutakat bariiyooh dehaay, “Duuruun, een eeyam hiiyyaheeb, aflaay door han ityiw kaadi. Tooy han yami harawaay yꞌi kaadi.” tidi.<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />Yasuuꞌa batiiyooh dehaay, “Difii, utakook waliikiit agari mꞌayii” idi.<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />Tutakat “Ani tak kaabari” tidi.</para>
  <para style="p" vid="JHN 4:17">Yasuuꞌa batiiyooh dehaay, “Tak kaabari tindiyihoob sidkiituwii. <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />Batuuk suur ay doora tidꞌarii, uutak tꞌa tibariyeeb aree sidik takook kiiki. Sidik hadiidtaayii.” idi.<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />Tutakat “Duuruun, baruuk nabiib tikatiyeet toona rhani. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />Hoobaan oon oorbaay kehii Ukwaasana yꞌabidna. Laakiin baraak Iyahuudi Ukwaasana been oomhiin ibakii nꞌabdeeb Alguduseeb eefi tiyadna.” tidi.<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />Yasuuꞌa batiiyooh dehaay, “Yaa takatay, aamaniiheeb, damaan yꞌiini, uudehay oon oorbaay kehii ikatiyeek tari Alguduseeb Ubaaba yꞌibid kiidiin. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Baraak Isaamri sidik aab tꞌabidneeb kitkanna. Laakiin hinin Iyahuudi aab nꞌabdeeb nikteen. Umidhhan aree Iyahuudee yꞌiini. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Laakiin damaan yꞌiini aree suur akay tooy eefi. Uudehay ishuukeewwa usidkiiwwa Ubaaba yꞌibid iyadna. Aan baraah baruuh harriiweeb yꞌaabdi ikatiin. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Ukwaasana Shuuk ikati, aree bariiyaah yꞌaabdi ibakii ishuukeewwa usidkiiwwa barooh yꞌabidna.” idi.<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />Tutakat bariiyooh dehaay, “Umasiih yꞌiiniyeet toona akteen. Baruuh yꞌiiniyihoob naatka sooyi hoon indi.” tidi.<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />Malya Yasuuꞌa igwibi, “Uun batook infariid, ani barooh akati.” idi.<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Been oodoor Yasuuꞌiib ikwiriyaatay yꞌagarna, aree barooh tootakat bhaliisamee rhiyaanihoob isgaribna. Laakiin gaal han raataab kiiki, “Naan harriiwa?” diyaab kiiki. Tari “Batooh naanhooy bhaliisamtiniya?” diyaab kiiki.<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Malya tutakat iyami sarooh tꞌishaayt tumadiina tꞌagar. Beentooy oodehayii dehaay, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“Mꞌaana shibibna, tak kastooh toona ani weeraat iiktiyeet sooyiheeb. Uun baruuh Umasiih ikati?” tidi. <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />Aflaay uudehay tumadiina yꞌishniit Yasuuꞌaab beeti ibeen.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Been oodoor ikwiriyaatay barooh inꞌalna, “Seedna, mꞌariit naat tamaa!” idiin.<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />Laakiin baruuh bareeyooh dehaay, “Baraakna naat han hooy bitkaanneet mꞌari abari.” idi.<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />Malya ikwiriyaatay taktak raatiyaana, “Gaal mꞌariit dehaay haay yꞌaab ikati han?” idiin.<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />Yasuuꞌa bareeyooh dehaay, “Timꞌariitu, beeb aneeb diigwatiyaab harriiweet toonaati saktiiwwa, ushagaayooh faayistiiwwa tikati. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Baraak bhaliib tiyadna, ‘Fadhig tirga warib malya uuwaak ikati!’ tiyadna. Laakiin andi hookna: igwꞌadeekna nigilnaat tidirꞌa daayiib shibibna! Wharru oontꞌa uwaakii dehaay bashikwu. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Uutak uwookana ukiraayooh itkwis indi, aree umidhhan udaayimii dehaay wharru iidbil indi. Aflaay wꞌaadanaawwa uwookanaawwa hiddaab afirhi iyadna. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Aflaay ‘Gaal yꞌandi, weer inwiik.’ iyad ibhali sidik ikatiin. <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Bareek dehaay shagaamaab bitkaayneet dirꞌaati waakii dehaay afdig hookna. Wari ushaga wꞌakraab shagaamiyaana, aree baraak bareeyooh ushagaay rayiimtaana.” idi.<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />Tutakat “Ani weeraat iiktiyeet toona kastooh sooyiheeb.” tidi akay, beet tumadiinaatii gwida Saamiri Yasuuꞌii aamaniyaan. <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />Aflaay Isaamiri bariiyooh dehaay eeyaanihoob, barooh geeboohna soosꞌooyt hooy yhariwna. Yasuuꞌa han maloot yina beentooy isꞌa. <verse eid="JHN 4:40" /><verse number="41" style="v" sid="JHN 4:41" />Aree bariiyeeh ibhaliyi sabbii masi gwida dehay aamaniyaan.<verse eid="JHN 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 4:42" />Baraah tootakatii dehaay eeyaaniit, “Hinin oontꞌa aamanna, batuuk tidii akay kiiki, laakiin oontꞌa hinin iknaayaan nimaasiw, aree uun uutak sidik tuduniya Ishidhhiin ikatiyeet toona nikteen.” idiin.<verse eid="JHN 4:42" /></para>
  <para style="s">Yasuuꞌa Udaabti Oor Mheeliya</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Yasuuꞌa maloot yina beentooy yhagit harꞌii, yꞌish Jaliil ibi. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />Baruuh uukna, “Nabi whaashooh ooknaay kahamooysamiya.” idi. <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Baruuh Jaliil iktimihoob, Jaliileeb uudehay barooh yꞌashishna. Baraah wꞌiidii dehaay Algudus beeti giigaa iifiinayt, baruuh Whasamti Wꞌiidiib beentooy idꞌiyeet toona kastooh rhaa iifiin.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />Malya Yasuuꞌa Jaliiliib tiifiit Gaanaab beeti yꞌagar. Been oomhiin baruuh eeyam haab hooy ikwaaseebu. Aree beentooy Kafarnaahuumeeb wꞌooruuh lhaab iiktiyi hikwuumaati daabit iifi. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Uutak Yasuuꞌa Yahuudaay Jaliil beeti yꞌaabu miyaad imaasiwihoob, barooh ibaayt Kafarnaahuum geeb giigiit wꞌooriyooh mheelti hooy yhariw. Wꞌooruuh tooyat diwlaa iifi.<verse eid="JHN 4:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48" />Yasuuꞌa bariiyooh dehaay, “Mꞌuujisaatwa ajaayibwa rhi bitdiineek gaal han hookna aamani kiidi.” idi.<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />Uutak Yasuuꞌii dehaay, “Seedna, wꞌooru baayaay geebu yakaa.” idi.<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />Yasuuꞌa “Difaa, wꞌooruuk ikwaar indi!” idi.</para>
  <para style="p" vid="JHN 4:50">Uutak Yasuuꞌiib ibhali aamaniyaayt giigiya. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />Baruuh usalaliib ugawooh bayee, ikishiyaayaah yꞌashishniit wꞌoor dhhaniib iiktiyeet toona usakana sooyaan. <verse eid="JHN 4:51" /><verse number="52" style="v" sid="JHN 4:52" />Baruuh ikishiyaayee dehaay, “Wꞌoor naadoor shabhamiya?” idi. Baraah “Iru nabhoob iiktiyihoob yꞌabaaki hooy imhiin.” idiin.<verse eid="JHN 4:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 4:53" />Malya wꞌoori baaba been Yasuuꞌa bariiyooh dehaay, “Wꞌooruuk ikwaar indi.” diyaab iiktiyeet toosꞌa tookna tiiktiyeet toona ikan. Aflaay baruuhwa indhiwaayaahwa aamaniyaan.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />Yasuuꞌa Yahuudaay Jaliil beeti yꞌagareekka, tuun timꞌuujisa tꞌikwaaseet tumalya tiikti.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">Yasuuꞌa Tak Garbamaab Mheeliya</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Been oodoori harꞌii, Yasuuꞌa Iyahuudi wꞌiidii dehaay Algudus ibi. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />Beentooy Algudus tꞌanooti dheefa dawil mhiin yami hoodh iifi. Yꞌaraami bhaliyee Beet Hisda iidna. Baruuh ay wawin gawaayee kwalaalu. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Been oomhiin gwida lha dehay bꞌiina hamashayaawwa, garbamaawwa, amꞌadhdhaawwa iifiin. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />Doorka - doorka Wꞌankwanaay malak yꞌiit eeyam ifiidh. Aayam itfidhni harꞌii shuumi takka iibriyeet lhanaaytiika iinꞌir. <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />Been oomhiin tak gaal mhay tamuunwa asimhay hawla lhaab iifi. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />Yasuuꞌa ootak been oomhiin bꞌee rhiyanihoob, oon whaaliib gwida doora dꞌiyaab iiktiyeet toona ikan. Malya “Mheelamtiib harriiwa han?” idi.<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />Uutak uulha igwibi, “Seedna, aayam itfadhiinihoob aneeb istoobiib gaal han kaabari. Ani tooy yꞌee, anii suurii weer gaal tikwiya.” idi.<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />Yasuuꞌa bariiyooh dehaay, “Asti yakaa! Tumadhamtook yaksaat hiireera.” idi. <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />Uutak igidiyeesooh inꞌir aree tumadhamtooh yakisiyaayt hiireeriya.</para>
  <para style="p" vid="JHN 5:9">Beet tuuna hooy tiiktiyeeb uumbꞌi aree sabtu. <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />Aflaay Yahuudi suurkina ootak umheelamiyaanaay dehaay, “Amsi sabtu, tumadhamtiyook yaksiti ugaanuun yꞌanfi hook.” idiin.<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Uutak “Aneeb mheeliyaab uutak tumadhamti yaksiit andiifeet toona sooyiheeb.” idi.<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />Baraah ootak raatiyaana, “Een sooyanuuk uutak aabu?” idiin.<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />Yasuuꞌa beentooy oodehay igwidaanaay tehooyteeb kwidhiya akay, uutak umheelamiya been ootak aab iiktiyeeb igam.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />Malya Yasuuꞌa ootak Ukwaasanaay gawiib imriit bariiyooh dehaay, “Shibiba, baruuk masi tinꞌira. Toomaag singada tari weena amaagkaat dehook iikti tindi.” idi. <verse eid="JHN 5:14" /><verse number="15" style="v" sid="JHN 5:15" />Aflaay uutak Iyahuudi ibaayt, ootak barooh mheeliyaab Yasuuꞌaab ikatiyeet toona sooya.<verse eid="JHN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16" />Aflaay Yasuuꞌa toosab mheeliya akay, Iyahuudi barooh amaag waraatiib yhariwna. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />Yasuuꞌa bareeyooh dehaay, “Aniib Ubaaba oon oombꞌi diimaab shagaamiini, ani han shagaamani.” idi. <verse eid="JHN 5:17" /><verse number="18" style="v" sid="JHN 5:18" />Een ibhaliyi sabbii Iyahuudi sidik Yasuuꞌi madar yhariwna. Baruuh toosabti gaanuun ikitꞌeet toona kitti, laakiin Ukwaasana han barooh ooknaay ubaabaayt waliikiya. Ugarooyooh Ukwaasanaay geeb nadiir ikwasi.<verse eid="JHN 5:18" /></para>
  <para style="s">Wꞌooriit Hadꞌaayi</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Yasuuꞌa bareeyooh dehaay bak igwibi, “Oosdik andi hookna: Wꞌoor uukna naati dꞌuuy kaꞌadgiriya, Baabooh dꞌiyee rhiiniyeet toona toobhaat danꞌi. Ubaaba sakiiniyeet toona aree Wꞌoor han sakiini. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Ubaaba Wꞌoorooh areeyiini, baruuh daayiiniyeet toona aree kastooh rhisiini. Bareekna ajjabsiiniyi jillaay teen tinaateeka han wawinkaat barooh rhisi indi. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Ubaaba yꞌayaab yaksiit ishidhhiineet toonaatiit, Wꞌoor han ishidhhin indiyeeb bak midhhan iniiw. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Ubaaba uukna gaal han kahaakamiya. Laakiin whaakamti hag kassooh Wꞌoorooh hiiyyaabi. <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />Aflaay uudehay kassaah Ubaaba hamooysiiniib Wꞌoor han bak hamooysi iyadna. Wꞌoor baahamooysii, Ubaaba barooh ifdig han kahamooyisiya.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />Oosdik andi hookna: baliin aniib ibhali maasiwtiit beeb aneeb ifdig aamaneenka, umidhhan udaayim imaar iyadna. Baraah haakamami kiidiina, laakiin suur akay tooyatii umidhhan ookiik hasamiyaan. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Oosdik andi hookna: damaan yꞌiini aree oontꞌa suur akay yꞌaabu, yꞌaya Ukwaasanaay Oori hiss iimsaw iyadna. Baliin yꞌeemsiiw aree midhhan imaar iyadna. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Ubaaba uukna midhhani gwꞌad ikatiyeet toonaatiit, Wꞌoorooh han bak midhhani gwꞌad ikwaas.<verse eid="JHN 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 5:27" />Baruuh aree Wꞌaadami Oor ikatiyi sabbii, whaakamtiit hadꞌaayi barooh yhii. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />Toon toonaatiib baaꞌajjabsaana, kassaah yꞌayaab bariiyooh whiss hooy iimsaw iyadneeb uudoor yꞌaabi. <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />Baraah imiimashaayee itfirꞌa iyadna. Baliin daayiina shagaamaab yakiit midhhan imaar iyadna, baliin toomaag shagaamaab aree yakiit ituurib iyadna. <verse eid="JHN 5:29" /><verse number="30" style="v" sid="JHN 5:30" />Ani uknaayu naat han kaadꞌi. Ani tꞌeemsiiwi toobhaat haakamani, aree aniib whukwim adil ikati. Aflaay ani ugarooyu afirhistiib kaadꞌi, laakiin been aneeb diigwatiyaab harriiweet toona toobhaat sakani.” idi.<verse eid="JHN 5:30" /></para>
  <para style="s">Yasuuꞌiib Ikatiint Tibadeha</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />Yasuuꞌa “Ani uknaayu kehii abandeheek, aniit tibadeha sidkiina kiiꞌakeen. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Laakiin anii dehaay badehiib ikati weer eefi. Baruuh aniib ikwasiyeet tibadeha aree sidik ikatiineet toona akteen.<verse eid="JHN 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 5:33" />Baraak Yuuhannaab beeti diigwatkinaab tifdigna, baruuh aree oosdik bidehaabu.<verse eid="JHN 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 5:34" />Ani ibakii aadamiit badeha harriiweet toona kitti. Laakiin baraakna midhhan timeerni jillaay toon andi. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />Yuuhanna tulamba balooliit buubtiniit tꞌiiteebi. Aree baraakna middaat been oonuur haay afirhitiib tehariwna.<verse eid="JHN 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36" />Laakiin Yuuhannaayt tibadehaateeka han wawinkaat badeha abari. Ani sakaniyeet toona, been ushaga Baabu faaysiti jillaay hiiyyaayu ikatiyeebu, aree baruuh Ubaaba diigwataayu ikatiyeet toona rhisiini. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />Ubaaba aneeb diigwatiyaab han anii dehaay badehiib ikati. Baraak bariiyooh whiss maasiwaab han kitteena tari ifiireeh han rhaab kitteen. <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />Bariitooh tudiigwat han iginꞌaayeeb kitdibiina, aneeb diigwatiyaab han baraak haay kaꞌaamantaana. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Baraak eektab agriiteena, iktabeeb umidhhan udaayim timeerneeb hiisteena. Aan aaktab aree kassaah aniib hadiideen. <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />Laakiin baraak anii dehaay yꞌiit umidhhan timeerneet toona kitehariwna.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />Ani dehayi hamaad kaꞌagbilan. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />Laakiin ani baraak naa dehay tikatiineeb daayiib akteen hookna. Ukwaasanaay reer iginꞌaayeekna bitbariineet toona akteen. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Ani Baabiyu oosmii yꞌan, aree baraak aneeb agbilaab kitteena. Laakiin weer gaal ooknaay simii yꞌiiniyihoob, barooh agbili tiyadna. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Baraak taktak tehamidneet toona tehariwna. Laakiin been oodꞌooh Ukwaasana ikatiinaay hamaad rayiimteeneet toona kitehariwna. Aflaay kak aamanteenheeb?<verse eid="JHN 5:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45" />Ani Baabiyu suurii amgariimeeyookna baahiisaana. Muusaab baraakna sꞌayaamteeni gariimiyookna iikti indi. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Baraak Muusaab sidik aamanaab tiiktiineek, baruuh aniib kitbaabuuyt, aneeb han aamantiina. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Baraak baruuh kitbaab iiktiyeet toona aamanaab kitteena, ani andiyeet toona kak aamanteena?” idi Yasuuꞌa.<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">Yasuuꞌa Ay Alfa Dehay Tamisiya</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Oonaay harꞌii, Yasuuꞌa Jaliiliib oobhar Tiibaaryaas iidneeb beeti idif. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />Timꞌuujisa been oodehay eelhaab haay mheeliyaneet rhiyaan akay, barooh gwida dehay iramna. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Yasuuꞌa ribaab reewiyaayt ikwiriyaatayeeh geeb nꞌati isꞌa. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />Been oodoor Iyahuudi Whasamti Wꞌiid dawil iikti.<verse eid="JHN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 6:5" />Yasuuꞌa asti ishbibaayt gwida dehay barooh ookiik yꞌee rhiyanihoob, Fiilibus raatiya, “Een oodehay kasseeh haay tamsinayi hadhiib naad nimeer?” idi. <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />Yasuuꞌa een ibhali Fiilibusi jarrabti haay yhiriw nuun, kak weeri iideeb suur akay iktiin.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />Fiilibus “Gaalka hadhiyi firkaak marriyee dehaay, malu shi diinaar han kamhiyaan.” idi.<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />Bariiyeeh ikwiriyaatayee weer Siimoon Bitrusi san Andaraawoos hadiidiya, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“Tooy oor gaal ay shaꞌiiri hadhiiwwa malu aashoob dadiswa ibariib eefi. Laakiin een oodehay kasseeh sidik kamhiyaan.” idi.<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />Yasuuꞌa ikwiriyaatayee dehaay, “Oodehay nꞌati soosꞌana.” idi. Been oomhiin gwida siyaam iifi, aree uudehay kassaah nꞌati isꞌana. Baraah ay alfa da iiktiin. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Yasuuꞌa yhadhi yakisiyaayt Ukwaasana yhamid, malya oodehay beentooy iifiinaay dehaay yhadhi yꞌaadhidh. Yꞌaashu han bak iweer, uudehay kassaah aree gabiyaaneeb ookiik tamiyaan.<verse eid="JHN 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 6:12" />Kassaah gabiyaanihoob, baruuh ikwiriyaatayeeh dehaay, “Toodhikw dibilna, naat han bangiideet toonaati.” idi. <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Aflaay toodhikw kastooh ishaawawiiniit, tamna malu biileeb hooy toobiyaan. Tuun tuudhikw kastuuh aree ishaꞌiiri yꞌay hadhi uudehay tamiyaaniit isimhaneeba.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />Uudehay toon tumꞌuujisaatiit alaama Yasuuꞌa ikwaaseet rhiyaaniit harꞌii, “Uun baruuh sidik Unabi tuduniyaatii dehaay yꞌiini attiyoodiyaab ikati.” idiin. <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />Yasuuꞌa baraah yꞌiit barooh abkiit akruurii hadꞌaab iikwsiineet toona ikanaayt, masi uukna oorba reewiya.<verse eid="JHN 6:15" /></para>
  <para style="s">Yasuuꞌa Iyami Kehii Hiireeriya</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Whawaad eeyani door, ikwiriyaatayaah oobhar tikwiyaan. <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />Falluukaat yꞌamniit oobhar oodar ooraaw beeti Kafarnaahuum ookiik idifna. Bareeh hawaad dehaay iki. Yasuuꞌa aree bareeh masi dehaay yꞌaa kiihaay. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Winneet akra baraam eeyaayt, eeyam irgis. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Ikwiriyaatay ay tari asagwir kiiloomitra isiignihoob, Yasuuꞌaab iyami kehii hiireeree tufalluuka diwlee rhiyaani door irkwiin. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />Laakiin Yasuuꞌa bareeyooh dehaay, “Baarakwiina, uun aneebu!” idi. <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Baraah barooh tufalluuka reewistiib yhariwna, aree tufalluuka willa baraah iibiineeb oodar tiktim.<verse eid="JHN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Tooyin tumalya, iyami dar uraawiib yhigit uudehay falluukaat gaat beentooy tehiyeet toona rhiyaan. Yasuuꞌa aree ikwiriyaatayi geeb tufalluuka amaab biikaayeet toonaawwa, laakiin baraah oodꞌoohna giigiyaaneet toonaawwa rhiyaan. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Malya been Wꞌankwana yhamidaayt harꞌii uudehay yhadhi hooy tamiyaaneeb oomhiini daraag falluukaat gwadit Tiibaaryaasii eeyaan. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Uudehay Yasuuꞌa beentooy biihaayeet toona rhiyaan. Ikwiriyaatayeeh han rhaab kiikeen. Malya baliit tifalluuka yꞌamniit bariiyooh harawaay Kafarnaahuum ibeen.<verse eid="JHN 6:24" /></para>
  <para style="s">Yasuuꞌa Umidhhani Hadhi</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Barooh iyami dar uraawiib imriinihoob raatiyaana, “Seedna, nhoob tooy tiktima?” idiin.<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />Yasuuꞌa igwibi, “Oosdik andi hookna: baraakna aneeb haay tehariwneeb usabab mꞌuujisaat rhitaaneet toonaatii kiiki. Laakiin yhadhi gabtaaneeb ookiik tamtaani sabbii aneeb tehariwna. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Amaagt mꞌariitii dehaay baashagaamaana. Laakiin tumꞌari umidhhan udaayim tiniiwtookna batiiyooh dehaay shagaamaana. Ukwaasana Ubaaba gabbalamtiit tꞌalaamaatooh Wꞌaadami Oori kehii daasaabuuyt, tuun batuuh aree tumꞌari baruuh iyaaw hookna indiyeet tikati.” idi.<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Malya uudehay barooh raatiyaana, “Ukwaasana harriiweet toona nidꞌee dehaay ibakii naan nidꞌeet toonaatu?” idiin.<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />Yasuuꞌa igwibi, “Ukwaasana harriiweet tuuna bak teefi: baruuh dehookna ifdigeeb oongaal aamanaana.” idi.<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />Aflaay baraah barooh raatiyaana, “Shibibtiit aamannayi jillaay, aflaay baruuk naat mꞌuujisa iikwasi tindiya? Naan saki tindiya? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Hinin hoobaan umingaayiib mannaab tamiyaan. Uuktaab bak indi: ‘Baruuh bareeh tibreetee tameeni hadhi yhii.’ indi.” idiin.<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />Yasuuꞌa bareeyooh dehaay, “Oosdik andi hookna: tibreetee bareekna yhadhi hiiyyaab Muusaab kiiki, laakiin tibreetee usidki hadhi bareekna iniiw Baabu ikati. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Ukwaasanaay hadhi ikatiib, beeb tibreetee nꞌati yꞌiit tuduniya midhhan iniiwu.” idi.<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />Uudehay “Seedna, een yhadhi diimaab hiiyya hoon.” idiin.<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />Yasuuꞌa bareeh sooya, “Ani umidhhani hadhi akati. Baliin aneeb beeti yꞌeen door han itehirigw kiidiina, baliin aneeb aamaneen door han ityiw kiidiin. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Laakiin ani sooyaneetookna toonaatiit, baraak rhitaanheeb masi aamanaab kitteena. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Baabu iniiweetu tuuna kastuuh yꞌiheeb tindi, aneeb beeti yꞌiiniibka aree door han fidnaab giigsi kaadi. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />Ani tibreetee yꞌanihoob, ani aharriiweet toonaati saktii dehaay yꞌaab kaaki. Laakiin aneeb diigwatiyaab harriiweet toona atankwiikwi jillaay yꞌaabi. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />Aneeb diigwatiyaab hoosu harriiweet toona aree: baruuh hiiyyaayu ikatiyeeb kasseeh gaal han baakwidhsaayeet toonaati. Laakiin tꞌaakharaati bꞌi bareeh asti yaksi andi. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Baabu harriiweet toona: Wꞌoor shibibtiit barooh aamaniiniibka umidhhan udaayim imaar indi. Tꞌaakharaati bꞌi aree barooh asti yaksi andi.” idi.<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Yasuuꞌa “Yhadhi tibreetee nꞌati eeyaan aneeb akati.” diyaabuuyt, Iyahuudi Yasuuꞌii ashkiimiyaan. <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />Baraah “Uun baruuh Yasuuꞌaab Yuusifi oor kiiki han? Ubaabaawwa toondeewwa nikteeniyeek, aflaay baruuh ‘Tibreetee nꞌati yꞌan’ kak indi?” idiin.<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Yasuuꞌa igwibi, “Taktakee dehaay wꞌashkiimti singadna. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Baabu aneeb diigwatiyaab insiikweeb nuun, gaal han aneeb beeti wꞌaay kaꞌadgiriya. Barooh aree tꞌaakharaati bꞌi asti yaksi andi. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Tuun batuuh Inabiyaayi kitabeeb kataabtu: ‘Bareeh kasseeh Ukwaasana allami indi.’ diyaaba. Ubaaba sinaakriit bariisooh allamamiiniibka anii dehaay yꞌiini. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />Ukwaasanaay ikatiib beeb nuun, gaal han Ubaaba rhaab kiiki. Baruuh uubhaat Ubaaba rhaab ikati. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Oosdik andi hookna: aamaniiniibka umidhhan udaayim imaar indi. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Ani umidhhani hadhi akati. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Hoobaakna umingaayiib mannaab tamiyaana, laakiin iiyaan. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Laakiin hadhiib tibreetee nꞌati yꞌeen tooy eefeen. Een bareeh tamiiniib uutak iiyyi kiidi. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Tibreetee yꞌaab yhadhi idhhaniib aneeb akati. Een yhadhiyee tamiiniibka diimaab midhhan imaar indi. Aan yhadhi aniib ubasharu, aree barooh ani tuduniyaati midhhani jillaay iyaaw andi.” idi.<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />Malya Iyahuudi winneet taktak imgwassaarniit, “Uun uutak tamnayi jillaay ubasharooh kak iniiw hoon?” idiin.<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />Yasuuꞌa bareeyooh dehaay, “Oosdik andi hookna: Wꞌaadami Oori bashar tamiit ubooyooh gwꞌi bitdiineek, abiiyaakna midhhan imaar kitdiina. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />Baliin aniib ubashar tameenwa, aniib oobooy gwꞌeenwa umidhhan udaayim imaar iyadna. Tꞌaakharaati bꞌi aree ani bareeh asti yaksi andi. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Aniib ubashar sidkiit mꞌariitu, aree aniib uubooy sidki gwꞌastiibi. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Aniib ubashar tameenwa, aniib oobooy gwꞌeenwa baliin aniib ikweerna, ani han bareeyooh akwarri. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Ubaaba udhhani diigwatiyaheeb, ani han bariiyooh sabbii akwarri. Oontꞌaaneet aneeb tamiiniibka han bak anii sabbii ikwaar indi. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Aan yhadhi tibreetee tikwaaba. Hoobaakna mannaab tamiyaaniit iyaana, laakiin een yhadhi tamiiniibka diimaab ikwaar indi.” idi. <verse eid="JHN 6:58" /><verse number="59" style="v" sid="JHN 6:59" />Yasuuꞌa een ibhali hadiidiyanihoob, baruuh Iyahuudi diini gawiib Kafarnaahuumiib allami.<verse eid="JHN 6:59" /></para>
  <para style="s">Umidhhan Udaayimiit Kalma</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Gwida ikwiriyaatayeesooh barooh een diyee imaasiwna, “Uun akra tꞌaliimu, aaw barooh agbiliini?” idiin.<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />Yasuuꞌa ikwiriyaatayaah een ibhaliyee ashkiimiineet toona iktiin. Aflaay baruuh bareeyooh dehaay, “Aan baraah gallabeen hookna han? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />Wꞌaadami Oor suur hooy iifiyeeb oomhiin ookiik reewee rhiteeneek aree! <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />Aashuuk midhhan iyawna. Oodehayi taad naat han kiidꞌi. Ibhali ani dehookna hadiidaneeb shuuk ikatiina aree midhhan ikatiin. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Masi bareesookna gali aamanaab kiikeen.” idi. Yasuuꞌa baliib yꞌaamanaab baakay whankaay iktiin, barooh iitil iyad han iktiin. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />Malya Yasuuꞌa masi, “Ubaaba adgirsaab biikaayeeb ootak nuun, gaal han aneeb beeti yꞌiiniib kiihaay haay adiyeeb usabab aree bak ikati.” idi.<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Been udoorii gwida ikwiriyaatayeesooh fidnaab yꞌagarna aree shaawti barooh aram kiikeen.<verse eid="JHN 6:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67" />Yasuuꞌa itamna malu raatiya, “Baraak han giigi kitdiina, bak kiiki?” idi.<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />Siimoon Bitrus bariiyooh dehaay igwibi, “Wꞌankwanaay, aab beeti neebi? Baruuk umidhhan udaayimi bhali tibariya. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Oontꞌa aamannay, aree baruuk Ukwaasanaay Oongaal Umugaddas tikatiyeet toona nikteen.” idi.<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />Malya Yasuuꞌa igwibi, “Bareek itamna malu waasaayookna kaaki han? Laakiin bareesookna gaal oobliis ikati.” idi. <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />Yasuuꞌa tuuliyeeb, Yahuudaab Siimoon Wꞌiskaaryuuti ooru, baruuh itamna malooyeeb gaalu, malya Yasuuꞌaab itilaayt nuuniyaab iikti.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">Yasuuꞌaawwa Isanaayeehwa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Oonaay harꞌii, Yasuuꞌa Jaliiliib hiirareeriya. Laakiin Iyahuudi suurkina Yahuudaay iifiin barooh madar yhiriwnayt, Yahuudaay fidnaab giig niyaamiya. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Laakiin Iyahuudi wꞌiid Itikheemaati iidwilihoob, <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />Yasuuꞌiib isana bariiyooh dehaay, “Oon whaashii giigaat Yahuudaab bayaa. Aflaay ikwiriyaatayaak baruuk tikwasiyeet timꞌuujisa rheen. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Atookakinooyt yharriiw uutak, tishagaamiiniyi kiikwibis. Teen teena baruuk tikwasiyeet toona uudehay kassaah baꞌiktiin hook.” idiin. <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />Isanaayaah aakna han barooh aamanaab kiikeen.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />Aflaay Yasuuꞌa bareeyooh dehaay, “Aniib uudoor masi yꞌaab kiiki. Laakiin bareekna kassuuh uudoor dehookna ishboobi. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Kastuuh tuduniya kitrib hookna, laakiin bareeyaah isalala amag ikatiineet toona sooyaniyayt, baraah aneeb eeribna. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Baraak wꞌiid beena, ani iibi kaadi. Aniib uudoor masi yꞌaab kiiki.” idi. <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />Yasuuꞌa een ibhali idiit, Jaliileeb imhi.<verse eid="JHN 7:9" /></para>
  <para style="s">Yasuuꞌa Tikheemaati Iidiib</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Isanaayaah wꞌiid ibeeniit harꞌii, Yasuuꞌa han giigiya. Laakiin gwꞌagwuuyt giigaab kiiki, kwibasee giigiya. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />Iyahuudi wꞌiidiib barooh yhiriwna. Baraah “Been uutak naad eefi?” iidna.<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />Uudehay kassaah taktaki angwileeb bariiyooh hadiidiyaan. Gali “Uun baruuh daayi taku.” idiin.</para>
  <para style="p" vid="JHN 7:12">Wari aree “Abadan, baruuh oodehay tanliis.” idiin. <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Laakiin baraah Iyahuudi iriikwnayt, gaal han gwꞌagwuuyt bariiyooh hadiidaab kiiki.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Yasuuꞌa Ukwaasanaay gaw ibaayt allamiyihoob, aflaay wꞌiid mingidee dehaay tarabeema iifi. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />Iyahuudi winneet ajjabamiyaaniit raatiyaana, “Uun uutak agriiyaab baakaay kak naatka ikteen?” idiin.<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />Yasuuꞌa “Ani allamaniyeet tuuna, aneeb uknaayu tꞌaliim kiiki. Laakiin Ukwaasana aneeb diigwatiyaanaay tꞌaliimi. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Ukwaasana yharriiweet toonaati dꞌuuy harriiwka, ani allamaniyeet toona ani uknaayiitu tikatiyeeb tari Ukwaasanaay yꞌaat tikatiyeeb iikan indi. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Uutak ooknaayt hadꞌaayeetii hadiidiiniib ugarooyooh dehaay matuun isehariiw. Laakiin barooh diigwatiyaanaay matuun yharriiw sidkiibi. Bariiyooh naat han galat kiihaay. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Muusa whag yhii hookna, bak kiiki? Laakiin gaal han hookna whag sinaakiraab kiiki. Naanhooy anii madar tehariwna?” idi.<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />Uudehay igwibiina, “Barook jin hook eefeena, aaw bariiyeek madar harriiw?” idiin.<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />Yasuuꞌa bareeyooh dehaay, “Ani gaat mꞌuujisa akwaas, baraak kassaak aree ajjabamtaana. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Muusa yꞌareeyookna kwishuub sooyi hookna. Ukwishuubi sooti Muusaay kiiki, laakiin hoobaakna badooyaan. Aflaay baraak yꞌar toosab tikwashibna. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />Yꞌar toosab itkwashiibneek, Muusaay whag katꞌa kiiki. Aflaay ani toosab tak daayiib mheelanayt, baraak naanhooy hoosu tehaseena? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Shaawti tusaraad shibibtiit baahakimna, wꞌadlii aree hakimna.” idi.<verse eid="JHN 7:24" /></para>
  <para style="s">Uun Baruuh Umasiih Ikati?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Algudusi dehay gwadi, “Uun baruuh baraah madar yhariwneeb ootak kiiki han? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Shibibna! Baruuh oodehayi suurii hadiidiini, aree baraah bariiyooh kehii kalmaat han diyaab kiikeen! Uun baruuh sidik Umasiih ikatiyeet toona ikanna han? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Laakiin Umasiih yꞌiiniyeeb oodoor, baruuh naa mhiinii yꞌiiniyeeb gaal han iikan kiidi. Laakiin uun uutak keeya mhiinii yꞌiiniyeeb hinin kassaan nikteen.” idiin.<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />Malya Yasuuꞌa masi Ukwaasanaay gawiib tageega hissii, “Sidik aneeb tikteenna? Ani keeya mhiinii akatiyeeb tikteenna? Ani uknaayiitu hadꞌaayeetii tooy yꞌaab kaaki. Laakiin been aneeb diigwatiyaab sidkiibu. Baraakna barooh kitkanna, <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />laakiin ani bariisooh yꞌaabu aree baruuh diigwatiyaheeb akay, ani barooh akteen.” idi.<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />Malya barooh kwilaltiit abuuk yhariwna, laakiin bariiyuuh uudoor masi yꞌaab kiikuuyt, gaal han bariiyooh kehii wꞌayooh daasaab kiiki. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />Laakiin gwida dehay oomhiin iifiin barooh aamaniyaan. Baraah “Umasiih yꞌiiniyihoob, oon ootakiika gwidaakaat mꞌuujisa iikwasi indi han?” idiin.<verse eid="JHN 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />Ifariisi uudehay taktaki angwileeb Yasuuꞌiib hadiidiyaaneeb ibhali imaasiwna. Baraahwa ifagiiriya isuurkinaawwa barooh yꞌibikni jillaay kajar gwadib diigwatiyaan.<verse eid="JHN 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33" />Yasuuꞌa bareeyooh dehaay, “Ani shalik door geebookna daayi andi, malya aneeb diigwatiyaab beeb beeti giigi andi. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Baraak aneeb hiriw tiyadna, laakiin imaarheeb kitdiina. Ani eebiyeeb oomhiini mabay kaꞌadgirtaana.” idi.<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />Iyahuudi taktakee dehaay, “Baruuh naaysooh niyaami indiyayt, hinin barooh nimaar kindi? Yoonaaneet timadiina udehayuun hooy kwarriyeet beeti diftiit, Iyoonaani allami indi han? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />Baruuh ‘Hiriwheeb tiyadna, laakiin imaarheeb kitdiina. Ani eebiyeeb oomhiini mabay kaꞌadgirtaana.’ indiyihoob een naan haay isehariiw?” idiin.<verse eid="JHN 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />Been wꞌiidi bꞌi wꞌaakhareeb, aree baruuh hooy daayika bꞌi ikati. Yasuuꞌa asti yakiyaayt tageega hissii, “Yaweebka anii dehaay mꞌaanaat gwꞌaana! <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />Aneeb aamaniiniibka gwꞌaana! Uuktaab ‘Midhhan iyaw yami thaw bariisooh kwaaneen.’ diyaabi.” idi. <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Een ibhali barooh aamaneen uudehay malyaab imeerneeb Eeshuuk haay isehiriw. Yasuuꞌa umatuunii dehaay yakamaab kiikuuyt, been oodoor ookiik Aashuuk attiyeewiyaab kiikeen.<verse eid="JHN 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Yasuuꞌaab een ibhali diyee imaasiw oodehayii gwadi, “Uun uutak sidik Unabi ikati!” idiin.<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />Wari aree “Uun Umasiih ikati!” idiin.</para>
  <para style="p" vid="JHN 7:41">Laakiin wari “Umasiih Jaliilee kak yꞌiini!” idiin. <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Uuktaab “Umasiih Whadꞌa Daawidiit tidirriyaaytii yꞌiini, Daawid hooy ikwiireet tumadiina Beetlahameeb aree itfari.” diyaabi. <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Yasuuꞌi sabbii aree uudehay yꞌadhadhna. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Gwadi barooh abuuk yhariwna, laakiin gaal han wꞌayooh kehii daasaab kiiki.<verse eid="JHN 7:44" /></para>
  <para style="s">Iyahuudi Suurkinaayi Wꞌiimaani Naaw</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Ikajar ifagiiriya isuurkinaawwa Ifariisiiwwa beeti yꞌagarnihoob, baraah raatamamiyaana, “Naanhooy barooh haay yꞌaab kitteena?” ittiyoodaayna.<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />Ikajar igwibiina, “Oon ootakiit hadiidi tak han kiihaay!” idiin.<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />Ifariisi “Bareekna han itlis hookna han? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />Isuurkinaayee tari Ifariisiyee gaal han barooh aamaniya? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Uun uudehay Muusaay whag kiikanna, shaawti bareeh Ukwaasanaay wꞌaat kehii daayi indi.” idiin.<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />Ifariisiyeeb gaal Niigoodiimoos iidni beentooy iifi. Been uutak suur Yasuuꞌi rheesamtiib giigaabi. Baruuh irawee dehaay, <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“Hineeb whaggiib ibhaliyeeh baasinaakiir gaal han gwabab kinsꞌabik. Baruuh gwibbaab ikatiyeet toona nishabib.” idi.<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />Baraah igwibiina, “Baruuk han Jaliilee yꞌaabwa han? Eektab agriiya, nabiib Jaliilee yꞌiiniib biihaayeet toona iikan tindiya.” idiin.<verse eid="JHN 7:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53" />Malya gaalka ugawooh ookna ibi.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">Takat Haraam Sakee Tꞌabak</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />Yasuuꞌa laakiin oorba saytuun reewiya. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />Tooyin tooraaw karuumaab, Ukwaasanaay gaw beeti yꞌagar. Kassaah uudehay barooh ikwilalniit isꞌana, aree baruuh nꞌati isꞌat oodehay allamiya. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Whaggi koojaawwa Ifariisiiwwa takat jikuuniib imriiniit yꞌabikniit haay eeyaan. Batooh kasseeh oodehayi suurii isingadna. <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />Baraah Yasuuꞌii dehaay, “Seedna, toon tootakat jikuun sakee nꞌabik. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Hineeb whaggiib Muusa, ‘Bak tꞌiiteet tootakat tooyat ookiik rajamooyaana.’ diyaabi. Oontꞌa baruuk naan tindiya?” idiin. <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />Baraah een ibhali sharak Yasuuꞌiit sꞌabkooyt haay isehiriwna.</para>
  <para style="p" vid="JHN 8:6">Laakiin Yasuuꞌa nꞌati kuuramiyaayt tugiibalaaytiisooh whaashi kehii iktib. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />Baraah ingadniit barooh raatiyaanihoob, baruuh ikuuramtii ifidhadhaayt, “Bareesookna door han maagnaayt gwibbaab baakaay uutak, hankaab wꞌawi batooh haay baꞌiigid.” idi. <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />Malya Yasuuꞌa masi whaashi kehii kuuramiyaayt iktib.<verse eid="JHN 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 8:9" />Baraah een ibhali imaasiwnihoob, kassaah gaal gaalnaay giigiyaan. Yꞌeegrima yꞌadhamiinaayi hankaay ifrꞌana. Yasuuꞌa oodꞌooh imhi, tutakat han beentooy masi tingid. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />Yasuuꞌa ifidhadh ingadaayt batiiyooh dehaay, “Baraah naad ibeena? Batook atehimiini gaal kiihaay han?” idi.<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />Tutakat “Seednaay, gaal han kiihaay.” tidi.</para>
  <para style="p" vid="JHN 8:11">Yasuuꞌa “Aflaay daayiitu, ani han atehimi hook kaadi. Shaawti difii, weer door maagnaayt biishagaamii.” idi.<verse eid="JHN 8:11" /></para>
  <para style="s">Yasuuꞌa Tuduniyaati Nuur</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Yasuuꞌa masi Ifariisi infaraadiit, “Ani tuduniyaati nuuru, aneeb eetriimka midhhani nuur imaar indi, door han aree thibniib hiireeri kiidi.” idi.<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />Ifariisi bariiyooh dehaay, “Oontꞌa baruuk ugarooyook kehii badehaat tikwasiya, baruuk tindiyeet aree sidik kitti.” idiin.<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />Yasuuꞌa “Abadan, ani ugarooyu kehii badehaat akwasiyeek han, ani andiyeet tuuna sidiku. Ani hooy yꞌaab akatiyeeb oomhiin aree akteen, naaysooh eebiyeeb aree akteen. Baraak ani keeya mhiinii yꞌaab akatiyeeb tari nhooh eebiyeeb kitkanna. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Baraak wꞌaadami salalii oodehay tehakimna, ani laakiin gaal han haakami kaadi. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Laakiin ani bak weeri iideek, whukwimu sidik iikti. Ani oonaay oodꞌu kaaki, aneeb diigwatiyaab Ubaaba geebu eefi. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />Tuun batuuh bareek whaggiyookna kataabtu, malu badehi taafagsameenihoob, tibadeha sidik ikatiin. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Aflaay ani ugarooyu dehaay badehiib akati, Ubaaba aneeb diigwatiyaab han anii dehaay badehiib ikati.” idi.<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />Malya baraah barooh raatiyaana, “Baabuuk naad eefi?” idiin.</para>
  <para style="p" vid="JHN 8:19">Yasuuꞌa “Aneeb kitkanna, Baabu han kitkanna. Aneeb tiktiinneek, Baabu han tiktiinna.” idi.<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />Yasuuꞌa Ukwaasanaay gawiib allamee, umiyaawi sanduuk daasamaab iiktiyeeb ugawiib een ibhali kasseeh hadiidiya. Udooruuh masi yꞌaab kiikuuyt, gaal han barooh abkaab kiiki.<verse eid="JHN 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />Masi Yasuuꞌa bareeyooh dehaay, “Ani fidnaab giigi andi, aree baraak aneeb hiriw tiyadna, laakiin tumaagtiisookna iiyyi tiyadna. Ani eebiyeeb oomhiin baraak oogiig kaꞌadgirtaana.” idi.<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />Iyahuudi raatiyaana, “Baruuh eebiyeeb oomhiin hinin kinbi indi hoon. Een ibhali ugarooyooh madar haay isehariiw han?” idiin.<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />Yasuuꞌa “Baraakna toon tuduniya tooy whii teefeenaatiib tikatiina, ani laakiin mhakwaliisii yꞌaabi. Baraakna toon tuduniyaatii tikatiina, ani laakiin toon tuduniyaatii kaaki. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Toon toonaatii dehaay, ‘Tumaagtiisookna iiyyi tiyadna.’ adi hookna. Ani aab akatiyeeb aree aamantiina bitdiineek, tumaagtiisookna iiyyi tiyadna.” idi.<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />Baraah barooh raatiyaana, “Baruuk aabwa?” idiin.</para>
  <para style="p" vid="JHN 8:25">Yasuuꞌa “Suur idabaay sooyaneetookna toonaati. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />Ani gwidaana hookna andiyeet abari, gwidaana aree bareek haay atehimani. Aneeb diigwatiyaab laakiin sidkiibi. Ani bariisooh maasiwaab akatiyeet toona toobhaat oodehay sooyani.” idi.<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />Laakiin baraah baruuh Ubaabaay hadiidiyeet toona afhamaab kiikeen. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />Aflaay Yasuuꞌa bareeyooh dehaay, “Baraak Wꞌaadami Oor asti yaksiteenihoob, ani aab akatiyeeb iikan tiyadna. Malya aneeb uknaayiitu hadꞌaayeetii naat han baadꞌiyeet toona iikan tiyadna. Laakiin Ubaaba sooyiiniyeetu toona toobhaat andiyeet toona iikan tiyadna. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Aneeb diigwatiyaab geebu eefi. Ani diimaab barooh afirhistiniit toona sakani akay, baruuh han aneeb oodꞌu ishaayu kiiki.” idi. <verse eid="JHN 8:29" /><verse number="30" style="v" sid="JHN 8:30" />Gwida dehay Yasuuꞌa een ibhali diyee imaasiw, barooh aamaniyaan.<verse eid="JHN 8:30" /></para>
  <para style="s">Ibraahimi Ar</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Yasuuꞌa baliib barooh aamaniyaan Iyahuudee dehaay, “Aniib utꞌaliim tisnaakiirneek, sidik anii kwiriyaatay iikti tiyadna. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />Malya oosdik iikan tiyadna, uusdik aree iifdig hookna indi.” idi.<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />Baraah bariiyooh dehaay igwibiina, “Hinin Ibraahiimi ara, gaalnaay whii door han kishiyaamaab kinki. Aflaay ‘Itfidig tiyadna’ oomiyaad naan haay tisehariiwa?” idiin.<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />Yasuuꞌa bareeyooh dehaay, “Oosdik andi hookna: Maagnaayt gwanbiibka toomaagti kishiya ikati. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />Ukishiya diimaab eedhiweeb kadaaya, laakiin wꞌoor diimaab indhiwaayi oor ikati. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Wꞌoor fandiiguukna, sidik itfidig tiyadna. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Baraak Ibraahiimi ar tikatiineet toona akteen. Aniib utꞌaliim agbilaab kittaanayt, baraak aneeb madar tehariwna. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Ani Baabu rhisiyaneetu toonaatiib hadiidani, laakiin baraak han baabuukna sooyaneetookna toona shagaamteena.” idi.<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />Baraah “Baabuun Ibraahiimu,” idiin.</para>
  <para style="p" vid="JHN 8:39">Yasuuꞌa igwibi, “Sidik Ibraahiimi ar tiiktiineek, baabuukna iidꞌeet teena saktiina. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Laakiin ani Ukwaasanaay amaasiweeb usidki sabbii baraak aneeb madar tehariwna. Ibraahiim bak tꞌiiteena sakaab kiiki. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Baraak baabuukna uukna sakiiniyeet toona sakteena.” idi.</para>
  <para style="p" vid="JHN 8:41">Baraah “Hinin haraami ar kinki. Ubaaba oongaal hinin nibariyi Ukwaasana ookna ikati.” idiin.<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />Yasuuꞌa bareeyooh dehaay, “Ukwaasana sidik Baabookna iiktiyeek, aneeb areetiina. Ani Ukwaasana diigwatiyaheeb, oontꞌa aree tooy eefi. Ani uknaayiitu hadꞌaayeetii yꞌaab kaaki, laakiin baruuh diigwatiyaheeb.<verse eid="JHN 8:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 8:43" />Ani andiyeet toona naanhooy kaꞌafhamtaana? Tuun tuuna aree baraak aniit tudiigwatti maaswi bitehariiwneet toona rhistini. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Baraak baabiyeekna ar tikatiina, baabookna oobliis, baruuh yharriiweet toona aree saktiib tehariwna. Bariiyooh sidik kiihaay, baruuh whankaay madooru, door han usidki dar kiingad. Gwisir hadiidiiniyihoob, ibhaliyeeh eekna hadiidiini. Baruuh gwisreebuuyt, aree igwisri baaba ikati. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Laakiin ani oosdik andi hooknayt, baraak aamanaab kitteenaheeb. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Bareesookna aneeb maagnaayti gwabab isꞌabiik aabu? Ani oosdik andiyeek, naanhooy kaꞌaamantaanaheeb? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Ukwaasanaay yꞌaab ikatiib been Ukwaasanaay bhali isnaakiir. Laakiin baraak Ukwaasanaay kitteena. Oon usabbii aree baraak isniikar kitdiina.” idi.<verse eid="JHN 8:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />Iyahuudi barooh raatiyaana, “Baruuk Saamiriibwa, jin hook eefeen niyadeet toonaatiib sidkiib kinki han?” idiin.<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />Yasuuꞌa “Ani jin kaabari. Ani Baabu hamooysani, laakiin baraak aneeb kahamooysitaana. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Ani uknaayu dehaay matuun kaahariw. Laakiin beet toona harriiw gaal eefi. Aree baruuh ugaadi ikati. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Oosdik andi hookna: aniib ibhali isnaakiirka, door han tooyat rhi kiidi.” idi.<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />Malya baraah bariiyooh dehaay, “Oontꞌa barook jin hook eefeeneet toona daayiib nikan. Ibraahiim iya, inabiya han iiyaan. Laakiin bariiyeek ibhali isnaakiirka, tooyat dꞌamsi kiidi tindiya. <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />Baruuk baaboon Ibraahiimiika winkaabwa han? Baruuh iiya, inabiya han iiyaan. Baruuk ugarooyook aab hiistiniya?” idiin.<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />Yasuuꞌa igwibi, “Ani ugarooyu asꞌaliyeek, been umꞌalaayi takweet kiibari. Baabu beeb baraak Ukwaasanaayookna tiyadneeb, aneeb hamooysiineeb barooh ookna ikati. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Barooh door han kanaab kitteena, laakiin ani barooh akteen. Ani barooh kaakan iideek, shaawti bareek tꞌiiteeb gwisreeb iikti. Laakiin ani barooh akteen, ibhaliyeeh han asnaakiir. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />Baabuukna Ibraahiim aniib wꞌaayi damaan rhiyeet toona winneet hooy afirhaa iifi. Aflaay baruuh beet toona rhiyaayt afirhiya.” idi.<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Iyahuudi bariiyooh dehaay, “Baruuk ay tamuun hawla kitkitima, Ibraahiim kak rhita?” idiin.<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />Yasuuꞌa igwibi, “Oosdik andi hookna: Ibraahiim faraay baakaay ani iifi.” idi. <verse eid="JHN 8:58" /><verse number="59" style="v" sid="JHN 8:59" />Malya baraah barooh geediini jillaay aweeb tatafiyaan. Laakiin Yasuuꞌa ikwibasaayt, Ukwaasanaay gawii yꞌish giigiya.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">Yasuuꞌa Hamashay Tak Mheeliya</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Yasuuꞌa oodꞌooh hiireeree, tak ifrayeekka hamashay rhiya. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />Ikwiriyaatayaah barooh raatiyaana, “Seedna, aay danuub oon ootak hamashay akay isfarna? Barooh ooknaay danuub ikatiin han ifarooyeeba?” idiin.<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />Yasuuꞌa “Bariiyuuh whamashi bariiyeeh idanuub tari ifarooyi danuub naat han shaawaab kiiki. Ukwaasanaay akriri shaga bariiyooh rhameeni sabbii baruuh hamasheeyaabi. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Aflaay masi bꞌeebuuyt, beeb aneeb diigwatiyaanaay ishaga ibakii nidꞌeet toonaati. Whawaad ikatiyihoob, gaal han shagaamtiib kaꞌadgiriya. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Ani tuduniyaatiib ahayeeb ookiik, ani tuduniyaati nuur akati.” idi.<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Yasuuꞌa een ibhali idiit harꞌii, whaashiib siil tifiyaayt, eesiil whaashiib yhathik. Malya oothiin ootaki gwꞌadeeb idꞌi. <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />Malya Yasuuꞌa bariiyooh dehaay, “Difaat, Silwaami hoodhiib ifiireek shigwidha!” idi. Silwaam aree “Diigwatamaab” miyaadi. Aflaay uutak idifaayt ifiireeh ishigwidh, aflaay rhee yꞌagar.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />Ishawwaahwa baliin suur barooh nꞌalee rhiyaan uudehaywa raatiyaana, “Uun baruuh sꞌatiitka karaamaat iinꞌal ootak kiiki han?” idiin. <verse eid="JHN 9:8" /><verse number="9" style="v" sid="JHN 9:9" />Gwadi aree been baruuh unꞌaliiga ookna ikatiyeet toona hadiidiyaan.</para>
  <para style="p" vid="JHN 9:9">Wari aree “Barooh kiiki, laakiin barooh tꞌiiteebi.” idiin.</para>
  <para style="p" vid="JHN 9:9">Aflaay uutak uukna, “Ani been ootak akati.” idi.<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />Baraah barooh raatiyaana, “Oontꞌa baruuk kak rhitniya?” idiin.<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />Baruuh igwibi, “Uutak Yasuuꞌaab ittiyoodi thiin yhathikaayt, igwꞌadeeyi kehii idꞌi. Malya Silwaam ookiik difiit ifiiri ashangwiidheet toona sooyaheeb. Aflaay adifaayt willa ifiiri ashgwidhihoob irhiti adgiran.” idi.<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />Uudehay barooh raatiyaana, “Baruuh naad eefi?” idiin.</para>
  <para style="p" vid="JHN 9:12">Baruuh “Kaakan.” idi.<verse eid="JHN 9:12" /></para>
  <para style="s">Ifariisi Imheeltiib Raatiyaan</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Uudehay been ootak suur hamasheeya iifiib Ifariisi haay ibeen. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />Yasuuꞌa oothiin yhathikaayt been whamashay hooy mheeliyaneet tuuyin sabtu. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Aflaay Ifariisi ootak kak mheelamiyaayt rhiyaneeb masi raatiyaan. Uutak igwibi, “Igwꞌadeeyi kehii thiin idꞌi, ifiiri ashgwidh, oontꞌa aflaay irhiti adgiran.” idi.<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />Ifariisiyee gali, “Uutak oon ushaga daayaab Ukwaasanaay kiiki, toosabti gaanuun sinaakiraab kiiki.” idiin.</para>
  <para style="p" vid="JHN 9:16">Laakiin wari raatiyaana, “Tak maagnaaytikina kak bak tꞌiiteet mꞌuujisa ikwasi?” idiin. Aflaay baraah malu mhiin yꞌadhadhna.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />Ifariisi ootak masi raatiyaana, “Baruuk uutak whamashi hooy mheeliya hook tindiya, daayiitu, oon ootakiib naan tindiya?” idiin.</para>
  <para style="p" vid="JHN 9:17">Uutak igwibi, “Baruuh nabiibi.” idi.<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Iyahuudi ootaki farooyee dehaay diigwatiyaaneeb hadiit, uun uutak suur hamashay iiktiyeet toonaawwa, oontꞌa rhiiniyeet toonaawwa aamanaab kiikeen. <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />Baraah ootaki faru sakanaayaana, “Uun baruuh oorookna? Baruuh whamashi haay faraayu tiyadna. Aflaay baruuh oontꞌa kak rhiini?” idiin.<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />Ifaru “Baruuh ooroon ikatiyeet toona nikteen, whamashi aree haay faraay ikatiyeet toona nikteen. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />Laakiin oontꞌa baruuh kak irhiti adgiriyaneet toona kinkan. Whamashi aree aaw hooy mheeliyaneeb kinkan. Barooh raataana. Shaawti baruuh win taku, aree baruuh uukna infariid hookna.” idiin. <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />Ifarooyaah een ibhali haay iidneeb usabab, baraah Iyahuudii iriikwna. Iyahuudi Yasuuꞌa Umasiihu indiibka Iyahuudi diini gawii isaakw iyadneet toona oodehay suur sooyaaba. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Toona toonaati sabbii aree ifarooyaah, “Baruuh shaawti win taku, barooh raataana!” idiin.<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Ifariisi ootak whamashi haay faraay tꞌa han malya door waliikiyaaniit, “Oosdik hadiidtiniyeet toona Ukwaasanaay suurii halafooya! Uun uutak barook mheeliyaab amaag tak ikatiyeet toona nikteen.” idiin.<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />Uutak igwibi, “Baruuh amaag tak ikatiyeeb biikaayeeb ani kaakan. Gaana daayiib akteen: ani suur hamashayu oontꞌa aree rhani.” idi.<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />Malya baraah barooh raatiyaana, “Naan dehook idꞌi? Kak aree whamashi hooy mheeliya hook?” idiin.<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />Uutak igwibi, “Suur akay sooyan hookna, laakiin sinaakraab kitteena. Oontꞌa masi naan teemsiiwneet toona tehariwna? Baraak han tari bariiyeeh kwiriyaatay tikatiineet toona tehariwna han?” idi.<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Malya Ifariisi ootak neewiyaana, “Baruuk been ootaki kwiriyaataayi tikatiya, laakiin hinin Muusaay kwiriyaataya. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Ukwaasana Muusaab bhaliisamiyaneet toona nikteen. Been uutak laakiin keeya mhiinii yꞌaab ikatiyeeb han kinkan!” idiin.<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />Uutak “Tuun winneet girbaanaatu! Baraak baruuh keeya mhiinii ikatiyeeb kitkanna, laakiin aneeb whamashi hooy mheeliyaheeb! <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Ukwaasana amaag dehay biisinaakiireet toona nikteen. Baruuh oodehay barooh hamooyseenwa, baruuh yharriiweet toona faayseenwa isnaakiir. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Whamashi haay faraay tak mheelamiya iidneeb gaal han maasiwaab kiiki. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Uun uutak Ukwaasanaay yꞌaab biikaayeek, naat han iidꞌeet toona kaꞌadgiriya.” idi.<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />Baraah ootakii dehaay, “Baruuk maagnaaytiib faraaywa, oontꞌa aree hinin allamtiniya han?” idiin. Malya ootak Iyahuudi diini gawii iskwiin.<verse eid="JHN 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Yasuuꞌa Ifariisi oon ootak Iyahuudi diini gawii ifirꞌaneet toona imaasiwihoob, ootak imriit raatiya, “Wꞌaadami Oor aamantiniya?” idi.<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />Uutak “Seedna, baruuh aabu? Sooyaaheeb, aflaay barooh aamani andi.” idi.<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />Yasuuꞌa bariiyooh dehaay, “Baruuk suur akay barooh rhita, oontꞌa geebook hadiidiiniibi.” idi.<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Uutak “Wꞌankwanaay, aamanani.” idiit Yasuuꞌii dehaay asjidiya.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />Yasuuꞌa “Toon tuduniya haakamti jillaay yꞌaabuuyt, aflaay whamashay rhi indi, aree baliin suur rhiin aree hamasheeyi iyadna.” idi.<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />Beentooy Fariisi gwadi bariiyooh geeb iifiin, een ibhali imaasiwniit barooh raatiyaana, “Naan? Hinin hamashayaab han?” idiin.<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />Yasuuꞌa “Baraak hamashayaab tiiktiineek, maagtikina kitꞌakeena. Laakiin irhiti adgirnay tiyadna sabbii, masi baraak maagti kinaabaana.” idi.<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">Ushakwaawwa Ureewoohwa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />Yasuuꞌa “Oosdik andi hookna: tꞌanooti kaleeb udheefaay shuumaab baakaay uutak, laakiin weer darii shuumiiniib gwiharaabu aree maraayanaabi. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />Uutak udheefaay shuumiiniib baruuh tꞌanooti shakwa ikati. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Udheefaay gwꞌaadiiga bariiyooh dehaay udheefa fandiig, aree tꞌanu han bariiyooh whiss eemsiiwna. Baruuh tꞌanooteeh gaatka simiisooh waliikiit bateeh dabaamiini. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Baruuh tꞌanu isfarꞌihoob, bateeh suuriimiini, aree tꞌanu whissooh ikteennayt, bariiyooh harꞌii sakeen. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Laakiin tꞌanu weer taki harꞌii kasakiyaan. Oon barooh whissooh kiikannayt, bariisooh fidnaab dhaabeen.” idi.<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />Yasuuꞌa een eemtaal bareeh sooya. Laakiin baruuh naan haay isehiriweeb kanaab kiikeen.<verse eid="JHN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Aflaay Yasuuꞌa masi, “Oosdik andi hookna: ani tꞌanooti dheefa akati. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Anii hankaay yꞌaab baliin kassaah gwiharaawwa maraayanaawwa ikatiin. Laakiin tꞌanu bareeh sinaakraat kiikeen. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Ani udheefa akati, anii geebii shuumiiniibka iidhhan indi. Baruuh anii shuumi indi, aree anii itfirꞌa indi, aree mꞌariit imaar indi. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Ugwihara gwihartwa, madarwa, kwidhsitiiwwa harwee oobhaat yꞌiini. Baraak midhhan - timmiima midhhan timeerni jillaay ani yꞌaabi.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />Ani ushakwa udaayiib akati. Ushakwa udaayi tꞌanooti jillaay iyaayiibi. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />Ukiraayi tak shakwaab baakaaywa, tꞌanooti kina baakaaywa, bꞌashoot yꞌee rhiiniyihoob, tꞌanu ishtiit dhaabi iniin. Malya tubꞌashu tꞌanu tataftini, bateeh birirti danꞌi. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Ukiraay kina kiraayii shaakwaabuuyt tꞌanu ishtiit dhaabiini aree tꞌanooteeb kiihalag.<verse eid="JHN 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 10:14" />Ani fagar shakwa akati, tꞌanooti akteen, tꞌanooti han ikteennaheeb. <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />Oontꞌaaneet, Ubaaba aneeb ikteeniyeet toonaatiit, ani han Ubaaba akteen. Aree ani tꞌanooti jillaay ayaayi. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />Oon tꞌanooti kaleebiib baahaayiit anoot warit abari. Ibakii bateeh han haay yꞌi andi. Bataah han aniib whiss isniikar iyadna, aree beentooy gaal reewwa gaal shakwaawwa daayi iyadna. <verse eid="JHN 10:16" /><verse number="17" style="v" sid="JHN 10:17" />Ani umidhhanu aniiwayt, Baabu aneeb areeyiini. Malya aree masi agarti umidhhan nuunami andi. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Aniib umidhhan iniin gaal han kiihaay. Ani uknaayiitu fadaagt niyaatii aniiw. Ani barooh aniiwee dehaay hag abari, aree barooh aniinee dehaay han hag abari. Toon toonaati dꞌuuy aree Baabu waseeyaheeb.” idi.<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Tꞌa han masi een ibhaliyi sabbii Iyahuudi malu mhiin yꞌadhadhna. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Gwida bareesooh, “Jin hooy eefeen! Haalayu! Naanhooy tisnaakiirna?” idiin.<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />Laakiin wari aree, “Jin hooy eefeeni tak bak kahadiidiya! Aajin kak hamashay dehay rhiseen?” idiin.<verse eid="JHN 10:21" /></para>
  <para style="s">Iyahuudi Yasuuꞌaab Iribna</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Wiyaay door, udiini gawi iidiib Alguduseeb iidsamiin. <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />Suleemaaniib oogaw oowin iidneenaay Ukwaasanaay gawiib Yasuuꞌa hiireeri. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />Uudehay barooh ikwilalni immarraayniit raatiyaana, “Naadoor ookiik baruuk tisoogiim hoon? Oosdik unagweegwi sooyaa hoon, baruuk Umasiihwa?” idiin.<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />Yasuuꞌa “Ani suur akay sooyan hookna, laakiin aamanaab kitteen. Baabiyu oosmii sakaniyeet timꞌuujisa anii dehaay ibadehana. <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />Laakiin baraak aniit anu kitteenayt kaꞌaamantaana. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Aniit tꞌanu whissu isnaakiirna. Ani bateeh akteen, aree bataah eetriimnaheeb. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Ani bateeh umidhhan udaayim aniiw, door han aree kwidhi kiidiin. Aree gaal han bateeh hoosu tafi kiidi. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Baabu aneeb yhiiyyeet tuuna naatiika gwidaakaati. Bateeh Baabiyu wꞌayii taftiib gaal han kaꞌadgiriya. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Aneebwa Ubaabaawwa gala.” idi.<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Malya Iyahuudi masi barooh geediini jillaay aweeb tatafiyaan. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />Laakiin Yasuuꞌa bareeyooh dehaay, “Ubaabaay ikatiint gwidaat wawint mꞌuujisa rhisan hookna. Teen bateesooh keetaanaati sabbii geedteenheeb?” idi.<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />Baraah “Teen bateesooh gaanaati sabbii han kageedna hook. Laakiin ookfuuri sabbii geednay hook. Baruuk aadamiib oobhaatwa, laakiin ugarooyook Kwaasanaab tikwasiya!” idiin.<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />Yasuuꞌa “Whaggiyookna kataabtu, Ukwaasana ‘Baraakna kwaasanaabaana adi hookna.’ diyaabi. <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Aaktab diyaab ikatiineet toona diimaab sidik tikatiyeet toona nikteen. Ukwaasana aree been oodehay tudiigwattuuh tittiyeewaayeeb ‘kwaasanaab’ isim. <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />Aneeb Ubaaba waasiyaheeb, malya tuduniyaatii dehaay ifdigheeb. Aflaay baraak been kifuuru kak tiyadna? Ani Ukwaasanaay Ooru adiyeet toonaati sabbii han? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Aflaay Baabu sakiiniyeet teena baadꞌiyeek, baaꞌaamanaanaheeb. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />Laakiin bateeh sakaniyeek, baraak aneeb bitꞌaamanayneek han, timꞌuujisa aamanaana. Malya baraak Ubaaba aniib eefiyeet toonaawwa, ani Ubaabaay eefiyeet toonaawwa iikan tiyadna.” idi. <verse eid="JHN 10:38" /><verse number="39" style="v" sid="JHN 10:39" />Baraah masi tꞌa han Yasuuꞌi abuuk jarrabiyaan. Laakiin baruuh bareeyeeh yꞌayee ifrꞌa iyhi.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />Yasuuꞌa masi Urduni bhar ikitꞌa, been oomhiin Yuuhanna suur hooy iimseeb ookiik yꞌagar. Aree beentooy isꞌa. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />Gwida dehay bariiyooh dehaay eeyaaniit, “Yuuhanna mꞌuujisaat kwaasaab kiiki. Laakiin oon ootakiib iideenaaka kastuuh sidik tiki.” idiin. <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />Aree beentooy gwida dehay barooh aamaniyaan.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">Yasuuꞌa Lꞌaasir Ishidhhan</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Lꞌaasir iidni tak Beetaanyaay ikwiir lhaa iifi. Beetaanya Maryamwa tuukwa Maartaawwa hooy ikwiirneet gariyaati. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />Beet tishakwiin Yasuuꞌiib iragadaayi kehii tifif tidꞌiit malya tehamooteesooh tiysis batuuh Maryamtu. Uun Lꞌaasir uulhaab aree batiiyooh san iikti. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />Bariitaah taakwa Yasuuꞌii dehaay diigwatiyaaniit, “Wꞌankwanaay, wꞌaraawuuk wꞌareetiniyi lhaabi.” idiin.<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Yasuuꞌa toon imaasiwihoob, “Toon tulhanaay wꞌaakharuuh Lꞌaasiriit yat bitkaayeet toonaati. Tuun aree Ukwaasana matuun tiniiwi jillaay iikti tindi. Masi aree Ukwaasanaay Oor matuun imaar miyaadiib iikti tindi.” idi.<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />Yasuuꞌa Maartaawwa tukwaatoohwa, Lꞌaasirwa areeya. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Lꞌaasiriit tulhanaayti sakana imaasiwihoob, oomhiin baruuh iifiyeeb masi maloot yina hooy yhagit.<verse eid="JHN 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 11:7" />Malya ikwiriyaatayeeh dehaay, “Yakaana, Yahuudaab beeti nitꞌigir!” idi.<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />Baraah “Seedna, shalik doori hankaay uudehay beentooy rajamootiyook yhariwna. Baruuk beentooy mꞌageert niyaamtiniya han?” idiin.<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />Yasuuꞌa “Oombꞌi tamna maloot saaꞌaat hooy kiihaayna han? Aflaay oombꞌii hiireeriiniibka iigaf kiidi. Baruuh toon tuduniyaati nuur rhiini. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Laakiin baruuh whawaad hiireeriiniyihoob, thibintuuyt eetgiif.” idi.<verse eid="JHN 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 11:11" />Malya een ibhali idiit harꞌii, masi “Wꞌaraawuun Lꞌaasir nꞌariitiib dhibaabu, laakiin ani difiit isibꞌir andi.” idi.<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />Ikwiriyaatayaah igwibiina, “Wꞌankwanaay, baruuh diwiiniyeek, shabhami indi.” idiin. <verse eid="JHN 11:12" /><verse number="13" style="v" sid="JHN 11:13" />Yasuuꞌa Lꞌaasiriit tooyat mitiyaaya. Laakiin baraah sidkiit nꞌari hiisiyaan.<verse eid="JHN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14" />Aflaay malya Yasuuꞌa oosdik ugwꞌagwaab bareeh sooya, “Lꞌaasir ayaabu, <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />laakiin bareeyookna jillaay ani bariiyooh geeb daayaab baakaayeet toonaatiib afirhaabi. Aflaay baraak aamani tiyadna. Yakaana barooh niibi.” idi.<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Toomaas, “Utiita” iidni, ikwiriyaatay irawee dehaay, “Yakaana hinin han niidif, aflaay bariiyooh geeb niiyyi!” idi.<verse eid="JHN 11:16" /></para>
  <para style="s1">Yasuuꞌa Teekwa Allaayrahamooyiini</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Yasuuꞌa eeyanihoob, Lꞌaasir fadhigt yinaati suurii atoobsa yhagit. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />Beetaanya Algudusee mhay kiiloomitir kitꞌaki. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />Gwida Yahuudi dehay Maartaawwa Maryamii dehaay oosaniit yattiib allaayrahamooyiini jillaay yꞌaaba. <verse eid="JHN 11:19" /><verse number="20" style="v" sid="JHN 11:20" />Maarta Yasuuꞌiib wꞌaay timaasiwihoob, bariiyooh ashuushi jillaay tifirꞌa. Laakiin Maryam ugawiib timhi.<verse eid="JHN 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 11:21" />Maarta Yasuuꞌii dehaay, “Wꞌankwanaay, baruuk tooy tiifiyeek, usanuun yaayi kiidi! <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Laakiin oontꞌa han Ukwaasana raattiniyeenaaka iniiweetook toona akteen.” tidi.<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />Yasuuꞌa batiiyooh dehaay, “Usanuuk tooyat hooy iidhhan indi.” idi.<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />Batuuh “Baruuh tꞌaakharaatiit yin masi yaki indiyeet toona akteen.” tidi.<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />Yasuuꞌa batiiyooh dehaay, “Ani ooyaku, ani umidhhanu. Aneeb aamaneen baliin iyaayiineek han, iidhhan iyadna. <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />Baliin aneeb aamaniit eedhhaniin, door han iiyyi kiidiin. Toon toona aamantinii?” idi.<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />Maarta “Awooh han Wꞌankwanaay! Baruuk Umasiih tikatiyeet toona aamanani. Ukwaasanaay Oor oodehayii dehaay yꞌiiniib barook tikatiyeet toona aamanani.” tidi.<verse eid="JHN 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Maarta een ibhali tidiit harꞌii, tꞌagaraayt tookwa Maryam waliiktaayt haay titfal. Malya “Seedna tooy eefi, aree batiisook raatiini.” tidi. <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Maryam een ibhali timaasiwihoob, asti yaktaayt willa barooh ashuush tehariw. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />Oontꞌa Yasuuꞌa masi tugariya shuumaab kiiki, laakiin masi Maarta hooy tꞌashsheeb oomhiin iifi. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />Iyahuudi Maryami geeb ugawiib iifiin baliin, batooh allaayrahamootiib yꞌaa iifiin. Batooh ashshigee rhiyaanihoob, iramna. Baraah batuuh waawtii dehaay umiimash tiibiyeeb hiisiyaan.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />Maryam Yasuuꞌa iifiyeeb oomhiin tiktim, aree barooh rhita. Batuuh bariiyeeh iragadaayi whii dhibtaayt, “Wꞌankwanaay, baruuk tooy tiifiyeek, usanu yaayi kiidi!” tidi.<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Yasuuꞌa batooh waawee rhiya, masi uudehay batiiyooh geeb iifiin han kak waawiineeb rhiya. Barooh uginꞌuuh iribaayt winneet gadabiya. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />Yasuuꞌa “Barooh naad tibisna?” idi.</para>
  <para style="p" vid="JHN 11:34">Baraah “Wꞌankwanaay, mꞌaa shibiba” idiin.<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />Yasuuꞌa milootiya.<verse eid="JHN 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 11:36" />Malya Iyahuudi, “Kak barooh areeyaneeb shibibna!” idiin.<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Laakiin gwadi bareesooh, “Ootak whamashay rhisiya. Lꞌaasir tooyatii naanhooy habiyaab kiiki?” idiin.<verse eid="JHN 11:37" /></para>
  <para style="s1">Yasuuꞌa Lꞌaasir tuyatii Yaksiini</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />Yasuuꞌa masi tꞌa han winneet gadabiyaayt, umiimash ibi. Umiimashi dheefaay aweeb amar iikti iifi. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />Yasuuꞌa “Wꞌawi hooy giigsaana!” idi.</para>
  <para style="p" vid="JHN 11:39">Maarta ootak wꞌayaanaayt tuukwa “Wꞌankwanaay, baruuh itoobaaseekka fadhigt yina dꞌiyaabuuyt, dhimiyaayt hoon baraami tindi!” tidi.<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />Yasuuꞌa batiiyooh dehaay, “Batuuk aamantiniyeek Ukwaasanaay umatuun rhi tindii diyaayook kaaki han?” idi.<verse eid="JHN 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41" />Wꞌawi hooy giigisiyaan. Yasuuꞌa asti ishbibaayt, “Ahammiid hook Baabu, tisnaakirheeba. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Baruuk diimaab tisnaakiireetu toona akteen. Laakiin een ibhali tooy oon oodehayi jillaay adi. Shaawti baruuk diigwataayu tikatiyeet toona aamani iyadna.” idi.<verse eid="JHN 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43" />Yasuuꞌa een ibhali idiit harꞌii, win hissii, “Lꞌaasir, firꞌa mꞌaa!” idi. <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Uutak wꞌaya ifrꞌa eeya, iragadaayaahwa yꞌayaahwa kafani halakii amhakwiraaba, eefiir han halak kehii iifi.</para>
  <para style="p" vid="JHN 11:44">Yasuuꞌa “Ootak umiimashi halaka hooy giigsaana, aree bagiigi.” idi.<verse eid="JHN 11:44" /></para>
  <para style="s">Yasuuꞌi Madari Harawa</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Gwida dehay Maryami rheesamtiib yꞌaa iifiin, Yasuuꞌa idꞌiyeet toona rhiyaaniit barooh aamaniyaan. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Laakiin gwadi bareesooh Ifariisi ibeeniit Yasuuꞌa idꞌiyeet toona sooyaan. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />Malya Ifariisiiwwa ifagiiriya isuurkinaawwa Iyahuudi majlis waliikiyaaniit, “Kak niwari? Uun uutak ikwaaseet timꞌuujisa kasteeh shibibna! <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Barooh bak neeꞌisheek, kassuuh uudehay barooh aamani iyadna. Iroomaani yꞌiit udiiniyoon gawwa whaashoonwa katꞌi iyadna.” idiin.<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />Gaal bareesooh Kayaafaas iidna, been whawliib baruuh ufagiiri oowin iiktiib hadiidiya, “Baraak naat kitkanna! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Kassooh whaashi kwidhiika, oodehayi jillaay gaal takiit yat hanyiiseet toona kitkanna han?” idi.<verse eid="JHN 11:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 11:51" />Kayaafaas een ibhali uukna diyaab kiiki. Laakiin baruuh been whawil ufagiiri oowinnayt, Yasuuꞌa Iyahuudi dehayi jillaay iiyyi indiyeet toona iisrid. <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />Laakiin bareeh eebhat kiikeena, masi kassooh Ukwaasanaay dehay ibarar gaal garooy shaawawiyooyti jillaay ikati. <verse eid="JHN 11:52" /><verse number="53" style="v" sid="JHN 11:53" />Beet tooyintii fidnaab Iyahuudi suurkina bariiyeeh madar niyaamiyaan.<verse eid="JHN 11:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 11:54" />Aflaay Yasuuꞌa Yahuudaay bitik gwꞌagwuuyt hiireeraab kiiki. Laakiin idifaayt umingaay dawil mhiin, Afraayim iidneet tumadiina ibi. Beentooy aree ikwiriyaatayi geeb isꞌa.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />Whasamti iid iidwilihoob, gwida dehay wꞌiidi hankaay nhisuuyti jillaay whaash Algudus ibeen. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Baraah Yasuuꞌaab yhiriwna. Ukwaasanaay gawiib immarraayniit gaal uraawii dehaay, “Naan teekwinna? Baruuh sidik wꞌiidii dehaay yꞌi kiidi, bak kiiki?” idiin. <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />Laakiin ifagiiriya isuurkinaawwa Ifariisiiwwa amir hassiyaan. Yasuuꞌaab naad eefiyeeb marriibka beet toona ibakii sooyiiniyeet toonaati. Aflaay baraah bariiyooh abuuk yhariwna.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">Yasuuꞌa Beetaanyaay Imeeshimaat</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Whasamti Wꞌiidii asagwit yina hooy mhiyaat iiktiini door, Yasuuꞌa Beetaanyaab Lꞌaasiriib indhiwa ibi. Lꞌaasir ootak baruuh tooyatii ishidhhaneebi. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Baraah bariiyooh dehaay beentooy diraar isoomirna. Oodraar Maarta shagaamta. Lꞌaasir baliin tumꞌariitiit tarabeesaati kehii Yasuuꞌi geeb iistꞌa oodehayiib gaal iikti. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Malya Maryam shakwiintiit karoora winneet alyaat naradii shagaamamaat Yasuuꞌiib iragadaayi kehii tifif tidꞌi. Malya tehamooteesooh tiysis. Tushakwiinti baraam oogaw kassooh itib.<verse eid="JHN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4" />Yasuuꞌiib ikwiriyaatayee gaal Yahuuda Wꞌiskaaryuuti iidneeb, malya Yasuuꞌaab nuuni iid, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“Tuun tushakwiin mhay shi ashteeti mhallagaayeeb naanhooy dalaabt kitti? Imhallaga aree oodehay yꞌaniw naanhooy attiyeewiyaab kiikeen?” idi. <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />Baruuh een ibhali haay iideeb usabab, oodehay yꞌaniwnaayee dehaay nꞌakwmanaatiib kiiki. Laakiin baruuh gwiharaabuuyt bak iid. Imhallagaayeet nafi itfiyik, laakiin baruuh uukna batiisooh igwihar.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Laakiin Yasuuꞌa, “Batooh isha dꞌiya, tushakwiintiib mhiyaat toona aree ani atoobiiseet tooyintii dehaay danbiyeet toonaati. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Uudehay yꞌaniw diimaab geebookna daayi iyadna. Laakiin ani diimaab geebookna daayi kaadi.” idi.<verse eid="JHN 12:8" /></para>
  <para style="s">Ufagiiri Uuwin Lꞌaasiri Madar Yhariwna</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Gwida dehay Yasuuꞌa Beetaanyaay eefiyeet toona imaasiwna. Aflaay baraah beentooy ibeen. Yasuuꞌi sabab oobhaat kiiki, laakiin Yasuuꞌa tooyatii ishidhhaneeb Lꞌaasiri shibuub yhiriwna. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Aflaay ifagiiriya isuurkina Lꞌaasir han madar hooy niyaamiyaana, <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />bariiyooh sabbii aree gwida Yahuudi bareeh iribniit, Yasuuꞌaab aamaniyaan.<verse eid="JHN 12:11" /></para>
  <para style="s">Tinasraati Shuumti</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Tooyin tumalya gwida dehay Whasamti Wꞌiidii dehaay yꞌaab iiktiin, Yasuuꞌa Algudus beeti yꞌiini diyee imaasiwna. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />Baraah akaay biir yakisiyaaniit bariiyooh ashuushi jillaay ifrꞌana.</para>
  <para style="q1" vid="JHN 12:13">Baraah “Hoosaana! Hoosaana!</para>
  <para style="b" vid="JHN 12:13" />
  <para style="q1" vid="JHN 12:13">Wꞌankwanaay oosmii yꞌiiniib been baarakamaabu!</para>
  <para style="b" vid="JHN 12:13" />
  <para style="q1" vid="JHN 12:13">Israaꞌiileeb Whadꞌa baarakamaabu!” idiin.<verse eid="JHN 12:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="JHN 12:14" />Yasuuꞌa halkwiib imriit kehii yꞌam, uuktaab diyaab ikatiyeet toonaatiit,<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />“Yaa Sihiyooniit oot biirakwii!</para>
  <para style="q2" vid="JHN 12:15">Shibibii, whadꞌaayuuk</para>
  <para style="q2" vid="JHN 12:15">halkwi kehii amaa yꞌiini.” indi.<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />Been oodoor ikwiriyaatayaah een ibhali afhamaab kiikeen. Laakiin Yasuuꞌa umatuunii dehaay yakamiyanihoob, uuktaab bariiyooh diyaab iiktiyeet toona shꞌiyaan. Aree bariiyooh jillaay baraah dꞌiyaab ikatiineet toona shꞌiyaan.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Lꞌaasir umiimashii waliikiyaayt tooyatii yakisiyanihoob rhiyaan uudehay Yasuuꞌi geeb iifiin, toona tutikeet kastooh hadiidiyaan. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Been uudehay igwida aree beet tumꞌuujisa kwaasaabuuyt barooh yꞌashishna. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />Aflaay Ifariisi taktakee dehaay, “Shibibna, hinin ansirami kindi! Kassaah uudehay barooh eetriimna.” idiin.<verse eid="JHN 12:19" /></para>
  <para style="s">Yasuuꞌaab Tuyatooh Isrid</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Yoonaani gwadi wꞌiidi door yꞌibidni jillaay Algudus bayaa iifiin, been oodehayi bitik iifiin. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />Baraah Fiilibus ibeeniit, “Duuruun, Yasuuꞌi shibuub nhariw.” idiin. Fiilibus Jaliileeb teefeet Beetsaydaay iikti. <verse eid="JHN 12:21" /><verse number="22" style="v" sid="JHN 12:22" />Fiilibus giigiyaayt Andaraawoos toon toona sooya. Mhallaah aree giigiyaaniit Yasuuꞌaab sooyaan.<verse eid="JHN 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23" />Yasuuꞌa igwibi, “Wꞌaadami Oor umatuun hooy iiwin indiyeet tuusꞌa tꞌa yꞌaati. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Oosdik andi hookna: gamhi harrooyt habba whaashiib dhibeetiit iyyi bitdiiyeek, harrooyt habba akeetiit tingadi. Laakiin tiyaayyeek, gwidaat habba fanri. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Eeknaayi midhhan areeyeen baliin imaar kiidiin. Baliin toon tuduniyaatiib umidhhanoohna eerib umidhhan udaayim imaar iyadna. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Aneeb shagaamiiniibka ibakii eetriimheeb. Aflaay aniib ushagaamana han ani daayi andiyeeb oomhiin daayi indi. Baabu aree aneeb shagaamiiniibka areeyi indi.<verse eid="JHN 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />Oontꞌa uginꞌu gwirhaayeeb eefi, naan iyaad andi? Baabu, toon toosꞌa haay baamꞌaaheeb? Laakiin ani oon usabbii yꞌaabi. Shaawti toon igwirhaayeet toosꞌa ibakii haay hasami andi. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />Baabu, oosmook soowina!” idi.</para>
  <para style="p" vid="JHN 12:28">Malya tibreetee hiss hadiidiya, “Ani matuun haay yꞌan, aree toon masi iiwari andi.” idi. <verse eid="JHN 12:28" /><verse number="29" style="v" sid="JHN 12:29" />Uudehay beentooy iifiin whiss imaasiwna. Gwadi bareesooh, “Thiwtu” iidna, wari aree “Malak bariiyooh geeb hadiidiya!” idiin.<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />Laakiin Yasuuꞌa bareeyooh dehaay, “Uun whiss anii jillaay hadiidaab kiiki, laakiin bareeyookna jillaay hadiidiya. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Oontꞌa toon tuduniyaati haakamti door ikati. Oontꞌa toon tuduniyaati haakim fidnaab ituugid indi. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Ani tubuutii asti yakamaniyihoob, oodehay kasseeh aneeb beeti iisikw andi.” idi. <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />Baruuh een ibhali hooy lhamaa iideet tooyat haay mitiyaayi.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />Uudehay hadiidiyaana, “Whagguun Umasiih diimaab ikwaar indiyeet toona sooyiini hoon. Aflaay baruuk Wꞌaadami Oor ibakii asti yakami indi kak tindiya? Uun Wꞌaadami Oor aree aabu?” idiin.<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />Yasuuꞌa bareeyooh dehaay, “Uunuur masi shalik door geebookna daayi indi. Aflaay uuthibin dehookna akaab baakaay, unuuri door usalalookna soorarimna. Uthibniib sakiiniib nhooh eebiyeeb kiikan. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Oonuur masi tibariinihoob, bariiyooh aamanaana. Shaawti nuuri dehay iikti tiyadna.” idi. Een ibhali idiit harꞌii, Yasuuꞌa giigiyaayt bareesooh ugarooyooh ikwibis.<verse eid="JHN 12:36" /></para>
  <para style="s">Oodehayi Wꞌaamanti Naaw</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />Yasuuꞌa teen timꞌuujisa kasteeh suurii ikwaaseek han, baraah barooh aamanaab kiikeen. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />Aflaay Unabi Isyaas diyaab iiktiyeet tuuna sidik tiikti, “Yaa Wꞌankwanaay, tudiigwattoon aaw aamaniya? Wꞌankwana yꞌakrireeh aab rhisiya?” idi.<verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />Baraah Yasuuꞌiib wꞌaamanti adgiraab kiikeena, Isyaas han bak diyaabuuyt:<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />“Ukwaasana igwꞌadeehna hamasheesiya,</para>
  <para style="q2" vid="JHN 12:40">aree iginꞌaayeehna assiya,</para>
  <para style="q1" vid="JHN 12:40">shaawti igwꞌadaahna karhiyaana,</para>
  <para style="q2" vid="JHN 12:40">tari iginꞌaayaahna kaꞌafhamiyaana,</para>
  <para style="q2" vid="JHN 12:40">aflaay baraah anii dehaay agartiit mheelami kiidiin.” diyaabi.<verse eid="JHN 12:40" /></para>
  <para style="m">
    <verse number="41" style="v" sid="JHN 12:41" />Isyaas een ibhali haay iideeb usabab, Yasuuꞌiib umatuun rhiyaayt bariiyooh hadiidiya.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />Beenhoob han Iyahuudi suurkinaayee gwida barooh aamaniyaan. Laakiin Ifariisi sabbii wꞌiimaanoohna lawsaab kiikeen. Baraah Ifariisi Iyahuudi diini gawii ifarꞌaneet toona irkwiin. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />Baraah Ukwaasanaay hamaadiika dehayi hamaad areeyaan.<verse eid="JHN 12:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Malya Yasuuꞌa win hissii, “Aneeb aamaniiniib, aneeb oobhaat aamanaab kiiki, laakiin aneeb diigwatiyaab han aamaniini. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Aneeb rhiiniib, aneeb diigwatiyaab han rhiini. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Tuduniya oonuur tꞌiiteeb akay yꞌan. Aflaay aneeb aamaniiniib thibniib daayi kiidi.<verse eid="JHN 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 12:47" />Aniit tudiigwat maasiwtiit baaraamka, ani barooh haakami kaadi. Ani tuduniya haakamti jillaay yꞌaab kaaki, laakiin ashidhhiini jillaay yꞌaabi. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Baliin aneeb eerib, tudiigwattu agbilaab baakay aree bareeh gaal haakami indi. Ani hadiidaneet tikalma tꞌaakharaatiib bareeh gaadiyoohna iikti iyadna. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Uun baruuh sidiku, ani uknaayiitu hadꞌaayeetii hadiidaab kaaki. Laakiin Ubaaba aneeb diigwatiyaab sooyaneetu toona ibakii andiyeet toonaatu, hadiidaniyeet toonaati. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Bariiyaah ibhali aree umidhhan udaayim haay yꞌeeneet toona akteen. Ani andiyeet toona, Ubaaba sooyaa diyaayu ikatiyeet toonaati.” idi.<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">Yasuuꞌa Ikwiriyaatayeeh Ragada Ishaagwidh</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Oontꞌa Whasamti Wꞌiid lhayt iikti. Yasuuꞌa toon tuduniya ishtiit Ubaaba hooy iibiyeet tuusꞌa yꞌaat tiiktiyeet toona iktiin. Baliib barooh ooknaay iiktiin, toon tuduniyaatiib iifiin, diimaab areeya. Winneet ureerooh aree rhisiya.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />Yasuuꞌaawwa ikwiriyaatayaahwa diraari kehii isꞌana. Aree uubliis suur akay Yahuudaab Wꞌiskaaryuuti Siimooni oori ginꞌiib shuumaa iifi. Barooh Yasuuꞌi nuunti isookwin. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />Yasuuꞌa Ubaaba timmiima akrir hiiyyaab iiktiyeet toona iktiin. Baruuh Ukwaasanaay yꞌaab iiktiyeet toona iktiin, Ukwaasana eebiyeet toona han iktiin, <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />aflaay baruuh oodraar hooy yakiyaayt, ugamiisooh ifrꞌa, aree bashkiir ilbab. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Beenaay harꞌii, baruuh shalik yam tashiib idꞌiit ikwiriyaatayi ragada ishaagwidhaayt, ubashkiir ulabaab iiktiyeeb iyhaayt bareeh iragada dehaay balamisiya.<verse eid="JHN 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6" />Malya Yasuuꞌa Siimoon Bitrusii dehaay eeya. Bitrus “Wꞌankwanaay, aniib iragada iishgwidh tindiya han?” idi.<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />Yasuuꞌa bariiyooh dehaay, “Ani adanꞌiyeet toona oontꞌa kaꞌafhamta, laakiin malya afhami tindiya.” idi.<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />Bitrus “Abadan, aniib iragada iishgwidh kitdiya!” idi.</para>
  <para style="p" vid="JHN 13:8">Yasuuꞌa igwibi, “Iragadaayeek baashaagwiidheek, shaawti anii kwiriyaataayi iikti kitdiya.” idi.<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />Siimoon Bitrus, “Wꞌankwanaay, aflaay aniib iragada eebhat baashaagwiidha, laakiin aniib yꞌayeewwa ugirmaawwa han shaagwidha!” idi.<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />Yasuuꞌa “Uutak ishagwaadh iragadaayeeh eebhat shangwiidh, kassuuh ugarooyuuh nhas ikati. Aree baraakna nhasaana, gaal nuun.” idi. <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />Yasuuꞌa barooh tiltiit nuuni indiib ootak iktiinayt een ibhali hadiidiya, “Kassaakna nhasaana gaal nuun.” iid.<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />Yasuuꞌa bareeh iragada ishaagwidhaayt harꞌii, ugamiisooh ikwaayt oodraari kehii umhiinooh beeti yꞌagar. Bareeh raatiya, “Oontꞌa dehookna adꞌiyeet toona afhamtaana? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />Seednaab waliikteenheeb, Wꞌankwana waliikteenheeb, bak aree daayiib teefeena. Ani aree bak akati. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Ani Wꞌankwanaayuukna, Seednaayuukna, hallaay iragadaayeekna ashaagwidh. Baraak aree gaal uraawi ragada tishagwidhneet toonaati. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Toon toona ani sakaneet tꞌiiteena baraak han sakteeneet toona hookna aharriiw. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Oosdik andi hookna: ikishiya wꞌankwanaayiisoohka winkaab kiikeen. Udiigwatama han barooh diigwataanaayka winkaab kiiki. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Oontꞌa baraak teen teena tikteenna, bateeh haay shagaamteeneek baarakami tiyadna.<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />Ani kasseekna kaadi, ani waasaab akatiyeeb baliib akteen. Laakiin uuktaab ibakii sidik ikati, ‘Uutak timꞌariitu geebu tamiyaab ashoosamiyaheeb.’ indi.<verse eid="JHN 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 13:19" />Tuun tuuna baaꞌakaay ani oontꞌa sooyani hookna, aflaay tikatiyihoob, Ani Barooh akatiyeet toona aamani tiyadna. <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />Oosdik andi hookna: ani diigwataniyeeb agbiliiniibka, aneeb han agbiliini. Aneeb agbiliiniibka aree, aneeb diigwatiyaab han agbiliini.” idi.<verse eid="JHN 13:20" /></para>
  <para style="s">Yasuuꞌa Bitrusiit Titaali Isrid</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Yasuuꞌa een ibhali idiit harꞌii, winneet gwirhaayeeb daayaayt gwꞌagwuuyt hadiidiya, “Oosdik andi hookna: bareesookna gaal nuuniheeb indi.” idi.<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />Ikwiriyaatay taktakeeb nakamiyaana, aree aab isehiriweeb igamna. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Gaal ikwiriyaatayee Yasuuꞌa areeyaab iiktiyi, baruuh Yasuuꞌi daraag iistꞌa. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />Siimoon Bitrus barooh beeti tuuliyaayt, “Aab haay isehariiweeb barooh raata?” idi.<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />Uun ukwiriyaataayi Yasuuꞌaab beeti ikilasaayt, “Wꞌankwanaay, uun baruuh aabu?” idi.<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />Yasuuꞌa “Ani hadhiib gaal tulamtiib amistiit aniiweeb been barooh ikati.” idi. Malya hadhiib yakisiyaayt yꞌamis, aree barooh Yahuudaab Siimoon Wꞌiskaaryuuti oor yhii. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />Yahuuda willa yhadhi yakisiyanihoob, uubliis barooh shuumiya.</para>
  <para style="p" vid="JHN 13:27">Yasuuꞌa bariiyooh dehaay, “Toona iidꞌa tindiyeet willa dꞌiya!” idi. <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />Oodraari kehii iifiin aaraw een ibhali Yasuuꞌa bariiyooh dehaay iideeb gaal han afhamaab kiikeen. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Laakiin imhallaga Yahuudaay geeb iifiinayt, Yasuuꞌa barooh difiit wꞌiidii dehaay yhariwneet toona haay dilibti miyaay sooyaneeb hiisiyaan. Tari oodehay yꞌaniw naat iniiweet toona sooyaneeb hiisiyaan. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />Yahuuda yhadhi iyhaayt gaal door barraab ifrꞌa. Aree uudoor hawaadamaab iikti.<verse eid="JHN 13:30" /></para>
  <para style="s">Tiwasi Tigayiit</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Yahuuda ifirꞌat harꞌii, Yasuuꞌa “Oontꞌa Wꞌaadami Oori matuun lawi indi, aree Ukwaasanaay matuun bariiyooh lawi indi. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Ukwaasanaay matuun bariiyooh lawiiniyeek, Ukwaasana aree Wꞌaadami Oori matuun barooh ooknaay lawsi indi. Toon toona aree gaal door saki indi. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />Yꞌaraan, ani shalikt midda geebookna daayi andi. Baraak aneeb tehariwna, laakiin Iyahuudi sooyaneet toonaatiit, aflaay oontꞌa bareek sooyani: Ani eebiyeeb oomhiin baraak kitbeena.<verse eid="JHN 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 13:34" />Oontꞌa bareek gayiit wasi aniiw hookna: taktak areeyaana. Ani bareekna areeyaneet toonaatiit, aflaay baraakna han ibakii taktak areeyaana. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Baraak taktak areeteeneek, aflaay uudehay kassaah anii kwiriyaatay tikatiineet toona iikan iyadna.” idi.<verse eid="JHN 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Siimoon Bitrus barooh raatiya, “Wꞌankwanaay, naad iibi tindiya?” idi.</para>
  <para style="p" vid="JHN 13:36">Yasuuꞌa “Oontꞌa ani eebiyeeb oomhiin beeti aneeb teetriimeet toona kaꞌadgirta. Laakiin malya iitramheeb tindiya!” idi.<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />Bitrus raatiya, “Wꞌankwanaay, oontꞌa naanhooy kaaram hook? Ani bariiyook jillaay tooyatii dehaay amaaru.” idi.<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />Yasuuꞌa “Anii jillaay tooyat sidik dehaay amaarwa? Ani oosdik andi hook: baruuk uujiik baakuukillaayi mhay doora ittiwheeb tindiya.” idi.<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">Yasuuꞌa Ubaaba Eebiib Usalalu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />Yasuuꞌa bareeyooh dehaay, “Baahasiikna, Ukwaasana aamanaana, aneeb han aamanaana. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Baabiyu oogaw gwidaat gurfa hooy eefeen. Ani aree bareek mhiin dehookna isuumir andi. Bak biikaayeek aree ani kasooyan hookna. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Ani difiit mhiin dehookna asoomiiri harꞌii, agartiit aneeb beeti iyaay hookna andi. Shaawti ani eefiyeeb oomhiin iikti tiyadna. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />Ani iibi andiyeeb oomhiin istoobiib usalal baraak tikteenna.” idi.<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />Toomaas bariiyooh dehaay, “Wꞌankwanaay, baruuk naad teebiyeeb kinkan, aflaay been usalal kak nikteen?” idi.<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />Yasuuꞌa bariiyooh dehaay, “Ani usalalu, oosdiku, aree umidhhanu. Aneeb anu Ubaaba eebi gaal han kiihaay. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Baraak sidik aneeb tiktiinneek, Baabu han tiktiinna. Amseenee fidnaab barooh tikteenna aree rhaabaana.” idi.<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />Fiilibus “Wꞌankwanaay, Ubaaba rhisaa hoon, beet toona winneet nhariw.” idi.<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />Yasuuꞌa “Fiilibus bareek kasseekna gwimad door geebookna iifi, masi aneeb kanaab kitteena han? Aneeb rhiyaabka, Ubaaba han rhaab ikati. Aflaay naanhooy Ubaaba rhisaa hoon tindiya? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />Fiilibus, ani Ubaabaay eefiyeet toonaawwa, Ubaaba aniib eefiyeet toonaawwa aamanaab kitta han? Ibhali ani dehookna bhaliiyaneeb uknaayiisu yꞌaab kiikeen. Ubaaba aniib kwarriib been ooknaay shaga daayiini. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Ani Ubaabaay eefi, Ubaaba aniib eefi andiyihoob aamanaanheeb. Bak biikaayeek aree ani akwasiyeet timꞌuujisaati sabbii aamanaanheeb. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />Oosdik andi hookna: aneeb aamaneen baliin, ani adanꞌiyeet teena iidꞌi iyadna. Ani Ubaaba iibi andiyayt, baraah masi winnayt han iidꞌi iyadna. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />Aniib oosmii tehariwneenaaka dehookna iidꞌi andi. Aflaay Ubaabaay umatuun Wꞌoorii lawi indi. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Aniib oosmii naatka tehariwneek, ani iidꞌi andi.<verse eid="JHN 14:14" /></para>
  <para style="s">Eeshuuk Imugaddasaayi Waadiya</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />Baraak aneeb areeteeneek, aniit tiwasi tisnaakiirna. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />Ani Ubaaba raati andi. Baruuh aree weer shamaamiiga diimaab geebookna daayiiniib iyaaw hookna indi. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />Baruuh Ukwaasanaay oosdik lawseen Eeshuuk ikati. Tuduniya barooh rhi kitdi tari iikan kitdiyayt, barooh ishish kitdi. Laakiin baruuh geebookna eefi, aree hookna ikwaar indiyayt, barooh tikteenna. <verse eid="JHN 14:17" /><verse number="18" style="v" sid="JHN 14:18" />Ani giiganiyihoob, baraak oodꞌookna ituuꞌish kitdiina, ani agarti yꞌi hookna andi. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Shalikt middaati harꞌii, tuduniya shaawti rhiheeb kitdi. Laakiin ani dhhaniibu, baraak han iidhhan tiyadnayt, baraak rhiheeb tiyadna. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Been oombꞌi ani Baabiyu eefiyeet toonaawwa, baraak aniib teefeeneet toonaawwa iikan tiyadna. Oontꞌaaneet ani hookna eefi. <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" />Baliin aniit tiwasi gabbalamiit isnaakiir, aneeb areeyeen bareeh ikatiin. Baabu aneeb areeyeen baliib areeyi indi. Ani han bareeh areeyani, ugarooyu aree dehaay lawsi andi.” idi. <verse eid="JHN 14:21" /><verse number="22" style="v" sid="JHN 14:22" />Malya Yahuuda (Yahuudaab Wꞌiskaaryuuti kiiki) Yasuuꞌii dehaay, “Wꞌankwanaay, baruuk ugarooyook naanhooy hinee dehaay lawisitiib niyaamtiniya? Naanhooy tuduniyaatii dehaay lawsi kitdiya?” idi.<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />Yasuuꞌa bariiyooh dehaay, “Aneeb areeyiiniibka aniib utꞌaliim isnaakiir. Baabu barooh areeyi indi, Baabuuwwa aneebwa barooh beeti yꞌiit geeb nikwaar niyad. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Aneeb baaꞌareeyayka, aniib utꞌaliim han kiisinaakir. Utꞌaliim baraak timaasiwneeb aree aniib kiiki, laakiin Ubaaba aneeb diigwatiyaanaay ikati.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />Toon toona ani masi geebookna iifiyi door sooyan hookna. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Aashuuk Imugaddasa ishamaamiiga Ubaaba aniib oosmii iifdig indiyeeb, naatka allami hookna iyadna. Aree ani sooyaneetookna toona kastooh shꞌasi hookna iyadna. <verse eid="JHN 14:26" /><verse number="27" style="v" sid="JHN 14:27" />Mꞌasig geebookna anꞌiish, umꞌasig wꞌaniib aniiw hookna. Tuduniya tiniiweet toonaatiit iyaaw hookna kaadi. Baahasiikna, aree baarakwiina!<verse eid="JHN 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 14:28" />Baraakna aneeb, ‘Giigani, laakiin agarti yꞌi hookna andi.’ diyee timaasiwnaheeb. Ubaaba aniika winkaabuuyt, baraak aneeb areetiineek, ani Ubaaba beeti andiifeet toonaatiib afirhitiina. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Tuun tuuna akaat baakaay oontꞌa sooyan hookna. Shaawti batuuh tikatiyihoob, baraak aamani tiyadna. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Ani geebookna gwidaana hadiidi kaadi. Shaawti toon tuduniyaati haakim yꞌiini. Laakiin baruuh anii kehii akrir kiibari. <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />Ani Ubaaba areeyaniyeet toona tuduniya ibakii tikteen. Oon usabbii aree baruuh sooyiiniyeetu toona kastooh adanꞌi.” idi.</para>
  <para style="p" vid="JHN 14:31">Yasuuꞌa “Oontꞌa mꞌaana, giigni.” idi.<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">Yasuuꞌa Sidki Inabu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />Yasuuꞌa “Ani sidki inabu, Baabu aree dirꞌaat kinaabi. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Baruuh firaay baayaksay oolꞌiidka hoosu kantꞌi. Firaay haay yꞌiiniib oolꞌiidka inwiik, aflaay nhasiit gwida firaay haay yꞌiini. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Baraakna ani allamaneetookna toonaatii suur akay nhasaana. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Baraak aniib daayaana, ani han hookna daayi andi. Uulꞌiid uukna firaay haay kaꞌeeya, laakiin wꞌinabi hindiib daayiiniyeek, firaay haay yꞌiini. Baraak han bak aniib daayi bitdiineek, firaay haay yꞌi kitdiina.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />Ani wꞌinabu, baraak aree oolꞌiidaana. Baliin aniib daayeen, aree ani bareeyooh daayaniyeeb, gwida firaay haay yꞌi iyadna. Aneeb anu aree naat han tidꞌaneet toona kaꞌadgirtaana. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />Aniib baadaayayka, oolꞌiidiit atoogdiit balami indi. Baliin aalꞌid dibaltiit nꞌeetiib itoogiidna, beentooy aree itooliiwna. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Baraak aniib daateeneek, aniib ibhali aree hookna daayeeneek, aflaay toona tutehariwneet kastooh raati tiyadna, aree imaar tiyadna. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Baabiyu umatuun, baraak gwida firaay tidꞌanihoob lawiini. Toon tehayꞌaatii aree anii kwiriyaatay tikatiina.<verse eid="JHN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9" />Baabu aneeb areeyiini, ani han bak areeyani hookna. Aniib ooreeriib daayaana. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Ani Baabiiti tiwasi asnaakirayt ureeriyooh daayaneet toonaatiit, baraak aniit tiwasi tisnaakiirneek, aniib ooreeriib daayi tiyadna. <verse eid="JHN 15:10" /><verse number="11" style="v" sid="JHN 15:11" />Aniit tifirha diimaab geebookna daayeeni jillaay ani een ibhali sooyan hookna. Tifirhaataakna han timmiimaat ikatiin. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Taan bataah aniit tiwasi ikatiin: Ani areeyani hookna, baraak han taktak areeyaana. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />Tak yꞌaraweeyooh jillaay umidhhanooh iniiwihoob, oonaayka winka reer kiihaay. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Ani sooyaneet teena tidꞌaneek baraak arawi tikatiina. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Ishagaamana wꞌankwanaayuuhna danꞌiyeet toona kiikannayt, shaawti ishagaamana iyaad hookna kaadi. Ani Baabiisu amaasiweet toona kastooh sooyan hookna, shaawti yꞌaraw iyaad hookna andi. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Baraak aneeb haydaab kitteena. Laakiin ani bareek hayidayt difiit gwida firaay baanhiid haay eeteeni jillaay afdig hookna. Aflaay Ubaaba aniib oosmii tehariwneet toona kastooh iyaaw hookna indi. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Tuun batuuh aniit waseetu: taktak areeyaana.<verse eid="JHN 15:17" /></para>
  <para style="s">Uudehay ikwiriyaatay iribna</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />Uudehay eeribnuukna, baraah hankaab aneeb iribneet toona shꞌaana. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Baraak tuduniyaatiib tikatiineek, tuduniya tuknaatiit areeyi hookna tindi. Laakiin ani toon tuduniyaatii waasan hookna, batiiyeeh aree kitteena. Oon usabbii aree uudehay eeribna hookna. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Ani sooyaneet toona, ‘Ikishiya yꞌankwanaayeeka wawinkaab kiikeen.’ shꞌaana! Uudehay aneeb amaag weeraab ikatiineek, bareek han amaag waraayeen hookna. Aniib utꞌaliim isnaakiirneek, bareek han isnaakiirna hookna. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Laakiin baraah aneeb diigwatiyaab kiikanna aree baraak aniib tikatiineet toonaati sabbii, baraah toon toona kastooh sakeen. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Ani bareeyooh dehaay yꞌanayt bhaliisamaab baakaayeek, baraah maagti gwabab kiidꞌiin. Laakiin oontꞌa baraah tumaagtoohna afoomi kiidiin. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Aneeb inriibka Baabu han inriib. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Suur gaal han kwaasaab biikaayeet teena ani bareeyooh bitik kwaasaab baakaayeek, maagti gwabab iibriineet toona kitꞌatookkaan. Laakiin oontꞌa baraah ani adꞌiyeet timꞌuujisa rhiyaana, masi aree aneebwa Baaboowwa mhalleen iribna. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Laakiin whaggiyoohna kataabt tuuna ibakii tikatiyeet toonaatu: ‘Sabab anu iribnaheeb.’ indi uuktaab.<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />Oosdik Ukwaasanaay ikatiib Ubaabaay yꞌiiniib Ishamaamiiga Aashuuk yꞌiit lawseen. Ani bareeh Ubaabaay dehookna iifdig andi, aree baraah aniib hadiidi iyadna. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Baraakna han tibadootee geebu tiifiinayt, aniib hadiidi tiyadna.” idi.<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="s">Eeshuuk Imugaddasa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />Yasuuꞌa bareeh sooya, “Wꞌiimaanookna bitkwidhsayni jillaay, kastooh toon toona sooyan hookna. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Baraah udiini gawii iifirꞌa hookna iyadna. Damaan aree yꞌiini, bareekna indiirka Ukwaasanaay jillaay toon toona shagaamiiniyeeb hiisiini. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />Uudehay Ubaabaawwa aneebwa biikaanneet toonaatii, teen teena saki iyadna. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Laakiin ani toon toona sooyan hookna. Aflaay uudoor yꞌiit teen teena idꞌanihoob, ani sooyaneet toona baraak shꞌi tiyadna. Ani geebookna iifiyi sabbii, suur een sooyaayookna kaaki.<verse eid="JHN 16:4" /></para>
  <para style="s">Eeshuuk Imugaddasaayi Ushaga</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />Laakiin oontꞌa ani beeb aneeb diigwatiyaab beeti iibi andi. Masi aree naad iibi andiyeeb bareesookna gaal han, ‘Nhooh teebiya?’ diyaab kiiki. <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Oontꞌa teen teena sooyan hooknayt, iginꞌaayaakna gadab itabna. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Laakiin oosdik andi hookna: ani giiganiyeet tuuna dehookna hanyiis. Ani baagiigayeek, ishamaamiiga yꞌi hookna kiidi. Laakiin ani giiganiyeek, malya barooh dehookna diigwati andi. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />Aashuuk yꞌeenihoob, tuduniyaati dehay danuub ibariineet toona sooyi iyadna. Masi tooshbu sooyi iyadna, Ukwaasanaay hukwim han sooyi iyadna. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />Baraah aneeb aamanaab kiikeenayt, maagnaayt sakeena, <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />ani Ubaaba iibi andi, aree baraak shaawti rhiheeb kitdiinayt, baraah Ukwaasanaay wꞌadliib shhagwaaba, <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />aree oon tuduniyaati haakim suur akay haakamamaabuuyt, baraah whukwimiib shhagwaaba.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />Ani masi gwidaana andiyeetookna abari. Laakiin oontꞌa baraak afhamteenee dehaay gwidaata. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Laakiin Aashuuk yꞌeenihoob, Ukwaasanaay oosdik rhisi iyadna. Kassooh oosdik ookiik rhisi hookna iyadna. Baraah iknaayeet hadꞌaayeetii hadiidi kiidiin. Laakiin baraah toona tꞌeemsiiwneet hadiideena, teena harꞌook yꞌeent aree sooyi hookna iyadna. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Baraah ani andiyeet toona abkiit bareek sooyeenayt, aneeb matuun iyawnaheeb. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Baabu ibariyeet tuuna kastuuh aniitu. Oon usabbii aree Aashuuk ani aniiweet toona abkiit bareekna sooyeenayt een andi hookna.<verse eid="JHN 16:15" /></para>
  <para style="s">Tifirhaawwa Igadabwa</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />Shalik door shaawti rhi kitdiinaheeb, laakiin malya shalik doori harꞌii rhiheeb tiyadna.” idi.<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />Ikwiriyaatay gwadi taktak sakanaayaana, “Uun naa miyaad ikati? Shalik door rhi kindi indi, malya shalik doori harꞌii barooh rhi niyad indi. Baruuh masi, ‘Ani Ubaaba iibi andiyayt tuun tikati.’ indi. <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />‘Shalikt midda’ indiyeeb, naan haay isehariiw? Baruuh indiyeet toona kanaab kinki.” idiin.<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />Baraah naan raati iidneeb Yasuuꞌa iktiin. Aflaay bareeyooh dehaay, “Shalik door rhi kitdiinaheeb adi hookna, malya shalik doori harꞌii rhiheeb tiyadna adi hookna. Baraak taktak sakanaateeneet toon toona kitti han? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Oosdik andi hookna: baraak waawi tiyadna, milooti tiyadna. Laakiin uudehay afirhi iyadna, aree baraak gadabi tiyadna. Laakiin igadabaakna firhaat iikti iyadna. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Takat firaay danwiilihoob, udooruuh yꞌaabuuyt lhamtini. Laakiin wꞌoor itfariyihoob baruuh tuduniyaatiib faraay ikatiyi sabbii batuuh afirhitni aree tilhanayteeh teebdhiin. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Baraakna han bak tikatiina: oontꞌa gadabteena, laakiin malya masi rhi hookna andi, aree afirhi tiyadna. Baliit tifirha aree gaal han hookna iniinee dehaay kaꞌadgiriya. <verse eid="JHN 16:22" /><verse number="23" style="v" sid="JHN 16:23" />Been uumbꞌi yꞌiiniyihoob, baraak naat han raati kitdiinaheeb. Oosdik andi hookna: aniib oosmii Ubaabaay tehariwneet toona kastooh iyaaw hookna indi. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Oontꞌa ookiik baraak aniib oosmii naat han raataab kitteen. Raataana imaar tiyadna, aflaay tifirhaataakna timmiimi iyadna.” idi.<verse eid="JHN 16:24" /></para>
  <para style="s">Tuduniyaati Kehii Tinasra</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />Yasuuꞌa bareeh sooya, “Ani teen teena mitaalee sooyan hookna. Laakiin ani mitaalee baahadiidayi door yꞌi indi. Ubaabaay oosdik gwꞌagwuuyt sooyi hookna andi. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Been uumbꞌi yꞌiiniyihoob, aniib oosmii barooh raati tiyadna. Ani bareeyookna jillaay Ubaaba raati andi kaadi hookna. <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />Ubaaba uukna areeyiini hookna. Baraak aneeb areetaani sabbiiwwa, ani Ukwaasanaay yꞌaab akatiyeet toona aamantaani sabbiiwwa, baruuh han areeyiini hookna. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Awooh ani Ubaabaay yꞌaabu, aree tuduniyaatii dehaay yꞌan. Oontꞌa aree tuduniya ishtiit Ubaaba beeti itꞌigir andi.” idi.<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Malya ikwiriyaatayaah bariiyooh dehaay, “Oontꞌa baruuk gwꞌagwuuyt hadiidtiniya, mitaalee hadiidaab kitta. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Oontꞌa baruuk naatka tikteeniyeet toona nikan. Gaal naat raatiiniyeet toona kitehariwa. Tuun tuuna aree baruuk Ukwaasanaay yꞌaab tikatiyeet toona aamansitni hoon.” idiin.<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />Yasuuꞌa “Oontꞌa aamantaana han? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Damaan yꞌi hookna indi, suur akay aree yꞌaabu, kassaakna itbirir tiyadna. Gaalka whaashookna ookna iibi tiyadna. Baraakna aneeb oodꞌu iiyꞌishheeb tiyadna. Laakiin ani sidik oodꞌu kaaki, Ubaaba geebu eefi.<verse eid="JHN 16:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 16:33" />Ani bareek een haay andiyeetookna toona, aflaay aniib amshawwaaytiit mꞌasig imaar tiyadna. Tuduniya lhasi hookna tindi. Laakiin ariknaa! Ani tuduniya agrib!” idi.<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">Yasuuꞌa Ugarooyooh Dehaay Siileeliya</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Yasuuꞌa een ibhali idiit harꞌii, teebri ishbibaayt siileeliya:</para>
  <para style="pm" vid="JHN 17:1">“Baaba, tuusꞌa yꞌaatu, Wꞌoorook soowina, aflaay Wꞌoor han isoowiin hook. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />Baruuk barooh kassooh oodehayi kehii hadꞌaayeet tehiiyya. Aflaay baliib kasseeh baruuk barooh tehiiyyeeb aree bareeh umidhhan udaayim iniiw ikati. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />Umidhhan udaayim bariitook kanaant ikati. Ukwaasana usidkiib oongaal, masi ubaruuk diigwattaneeb Yasuuꞌaab Umasiihiit kanaant ikati. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Ani toobuuti kehii umatuunook rhisan. Ushaga baruuk aneeb tehiiyyeeb faaysan. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />Baaba, tuduniya daamaat baakaay geebook iibriyeeb umatuun tꞌiiteena, oontꞌa han suurook soowinaheeb.<verse eid="JHN 17:5" /></para>
  <para style="pm">
    <verse number="6" style="v" sid="JHN 17:6" />Tuduniyaatiib eefeen baliib baruuk aneeb tehiiyyeeb bareeh asookin hook. Baraah bariiyeeka, aree bareeh tehiiyyaheeb. Baraah ibhaliyeek isnaakirna. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Oontꞌa aree baraah kastooh toona baruuk tehiiyyeetu bariisook yꞌaat tikatiyeet toona ikteenna. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Ani baruuk tehiiyyeetu tudiigwat askatim, baraah han agbiliyaan. Ani sidik bariisook yꞌaab akatiyeet toona ikteenna. Baruuk diigwataayu tikatiyeet toona han aamaniyaan. <verse eid="JHN 17:8" /><verse number="9" style="v" sid="JHN 17:9" />Ani bareeyooh dehaay siileelani. Tuduniyaati dehayii dehaay kasiileelan, laakiin baliib baruuk tehiiyyeeyu dehaay siileelani. Baraah bariiyeek ikatiin. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />Abariyeena kastuuh bariitooktu, aree baruuk tibariyeena kastuuh aniiti. Aniib umatuun aree bareesooh lawiini. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Oontꞌa ani marook yꞌani, shaawti tuduniyaatiib daayi kaadi. Laakiin baraah tuduniyaatiib daayeen. Ubaaba Umugaddas! Oosmook wꞌakraab aneeb tehiiyyeenaay simii bareeh sꞌasiga. Aflaay baraah aniitwa bariitookwa gal ikatiin. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Ani bareeyooh geeb iifiyi door, oosmook wꞌakraab been oosim aneeb tehiiyyeenaay bareeh asꞌasig aree agwꞌad. Ootak ookwidh yhayid nuun bareeh gaal han hooy kwidhaab kiiki. Shaawti uuktaab sidik ikati.<verse eid="JHN 17:12" /></para>
  <para style="pm">
    <verse number="13" style="v" sid="JHN 17:13" />Oontꞌa ani yꞌani hook, aree een ibhali ani masi tuduniyaatiib haayee hadiidani. Aflaay baraah timmiimaat aniit firha iginꞌaayeeb ibariin ikatiin. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Tudiigwattook bareeh sooyan. Ani tuduniyaatii baakaayeet toonaatiit, baraah han tuduniyaatii kiikeenayt, uudehay bareeh iribna.<verse eid="JHN 17:14" /></para>
  <para style="pm">
    <verse number="15" style="v" sid="JHN 17:15" />Bareeh tuduniyaatii sifarꞌooyt hook kaahariw. Laakiin bareeh yꞌamag dehayii tisꞌasiigeet toona hook aharriiw. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Ani tuduniyaatii baakaayeet toonaatiit, baraah han tuduniyaatiib kiikeen. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Bareeh usidkii marook abika, ibhaliyaak sidika. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Baruuk aneeb tuduniya beeti tifdigeenaayt, ani han bareeh tuduniya beeti afandiig. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Bareeyooh jillaay aree ugarooyu nuunan. Aflaay baraah han sidik igarooyeehna barook nuuneen.<verse eid="JHN 17:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="JHN 17:20" />Bareeh eebhatni jillaay dehook kasiileelan. Laakiin baliib bareetoohna tudiigwat maasiwtiit aneeb aamaneen han dehaay siileelani. <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />Baraah gal ikatiini jillaay dehaay siileelani. Baaba! Baruuk aniib tehaya, ani bariiyook ahayeet toonaatiit, baraah han hoon daayeen ikatiin. Baraah gal ikatiin, shaawti uudehay aneeb baruuk diigwataayu tikatiyeet toona aamani iyadna. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Baruuk tehiiyyeeyu umatuun beeb ani bareeh ahii. Aflaay baraah aniitwa bariitookwa gal ikatiin. <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />Ani bareeyooh eefi aree baruuk aniib tehaya. Aflaay baraah han winneet gal ikatiin. Shaawti tuduniyaati dehay aneeb baruuk diigwataayu tikatiyeet toona iikan iyadna. Aneeb areetaneet toonaatiit bareeh han areetiniyeet toona iikan iyadna.<verse eid="JHN 17:23" /></para>
  <para style="pm">
    <verse number="24" style="v" sid="JHN 17:24" />Baaba, bareeh tehiiyyaheeb, ani daayaniyeeb oomhiin aree geebu daayeeneet toona aharriiw. Shaawti umatuun baruuk aneeb tehiiyyeeb, aniib umatuun rhi iyadna. Baruuk tuduniya kwaasaab baakaay areetaaheeb.<verse eid="JHN 17:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="JHN 17:25" />Ubaaba Uushbu! Tuduniya bitkaanuuk han, laakiin ani akteen hook. Baruuk diigwataayu tikatiyeet toona han baraah ikteenna. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Ani bareeh asookin hook, aree bak isuuririm andi. Shaawti anii dehaay tibariyeeb ooreer bareeyooh han daayiini. Aflaay ani han bareeyooh daayani.” idi.<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">Yasuuꞌiit Tꞌabuuki</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Yasuuꞌa toon toosileel idiit harꞌii, abaat Gadaruun iidneet ookiik ikwiriyaatayi geeb giigiya. Been oomhiin aree dirꞌaat tiifi, Yasuuꞌaawwa ikwiriyaatayaahwa batooh shuumiyaan. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />Gwida doora Yasuuꞌa ikwiriyaatayeeh geeb beentooy ammarriyaabuuyt, Yahuuda itoolana beet tudirꞌaati mhiin iktiin. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />Aflaay Yahuuda tudirꞌa shuumiya. Roomaani kajar gwadibwa, ifagiiriya isuurkinaawwa Ifariisiiwwa fidgaab iiktiini udiini gawi gwꞌaadiiga gwadibwa geeb iifiin. Baraah nꞌeeti sigwidwa, faanuusaabwa, gadhꞌiiwwa yaksaaba.<verse eid="JHN 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 18:4" />Yasuuꞌa toona dehaay iikti tiid kastooh whankaay iktiin. Aflaay bareeh beeti hantaayaayt, “Aab tehariwna?” idi.<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />Baraah “Yasuuꞌaab Unaasiraayi” idiin.</para>
  <para style="p" vid="JHN 18:5">Baruuh “Ani barooh akati.” idi. Yahuuda itoolana bareeyooh geeb beentooy ingid. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Yasuuꞌa “Ani barooh akati.” idiyihoob, baraah harꞌa yꞌagarniit whaashi kehii dhibiyaan.<verse eid="JHN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 18:7" />Yasuuꞌa masi bareeh raatiya, “Baraakna aab tehariwna?” idi.</para>
  <para style="p" vid="JHN 18:7">Baraah “Yasuuꞌaab Unaasiraayi” idiin.<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />Yasuuꞌa “Ani barooh akatiyeet toona sooyan hookna. Aneeb tehariwneek aflaay een eenda eeraw giigsaana.” idi. <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />Aflaay Yasuuꞌa diyaab iiktiyeet tuuna sidik tiiktiyi jillaay, baruuh een idi. Baruuh “Baaba! Een baruuk aneeb tehiiyyeeb gaal han hooy kwidhsaab kaaki.” diyaabi.<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />Siimoon Bitrus bꞌadhadh iibri aree barooh ilꞌibaayt ufagiiri oowinnaay kishiyaay wꞌangwiil umaygwadiib hooy ikitꞌa. Been ukishiya Malkhus iidna.<verse eid="JHN 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 18:11" />Yasuuꞌa Bitrusii dehaay, “Bꞌadhdhook umhiinooh shuumsa! Baabu hiiyyaayu ikatiyeeb tilhanayti kaas gwꞌi baadiyeeb hiistiniya han?” idi.<verse eid="JHN 18:11" /></para>
  <para style="s">Yasuuꞌa Hannaasi Suurii</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Malya Iroomaani kajar daabtiisoohnaawwa, Yahuudi gwꞌaadiigaawwa Yasuuꞌaab yꞌabikna, aree barooh yhaakwirna. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />Barooh hankaab Hannaas haay ibeen. Hannaas Kayaafaasi ham iikti, been whawil aree ufagiiri oowin akay iifi. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />Kayaafaas Iyahuudi suurkina waseeyaab been barooh ikati, baruuh “Uun uutak uungaal kasseeh oodehayi jillaay iyaayyeet tuuna hanyiis.” diyaabi.<verse eid="JHN 18:14" /></para>
  <para style="s">Bitrus Yasuuꞌaab Itwi</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Siimoon Bitruswa weer kwiriyaataayiiwwa Yasuuꞌaab iramna. Been ukwiriyaataayi uuraaw Ufagiiri uuwin barooh daayiib iktiin. Aflaay baruuh Yasuuꞌi geeb Ifagiiriyaayi suurkinaay gawi hoosh shuumiya. <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />Laakiin Bitrus udheefaayt mifrꞌatiib ingad. Malya ukwiriyaataayi uuraaw been ufagiiri uuwin iktiineeb harꞌa ifirꞌaayt, udheefaay tiifiit oot bhaliisamiya. Malya Bitrus shuumisiya.<verse eid="JHN 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 18:17" />Tꞌoor udheefaay tiifiit Bitrusii dehaay, “Baruuk been ootaki kwiriyaatayeeb gaalwa han?” tidi.</para>
  <para style="p" vid="JHN 18:17">Bitrus “Abadan, ani kaaki.” idi.<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Uudoor mikwꞌaraabuuyt ikishiyaawwa ikajarwa nꞌeet talawsaa kwilalti gadaaba, aree toonꞌi iifishna. Bitrus han bareeh ibaayt geeb ingadaayt toonꞌi ifish.<verse eid="JHN 18:18" /></para>
  <para style="s">Ifagiiriyaayi Suurkina Yasuuꞌaab Sakanaayiini</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Ufagiiri uuwin ikwiriyaataywa utꞌaliimiisoohwa Yasuuꞌaab sakanaaya.<verse eid="JHN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 18:20" />Yasuuꞌa “Ani diimaab oodehayi suurii hadiidan, aniib utꞌaliim kassuuh Iyahuudi diini gawiib iikti, tari Ukwaasanaay gawiib iikti. Aree uudehay kassaah beentooy itdibilna. Ani naat han kwibsaab kaaki. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Aflaay naanhooy raattiniyaheeb? Oodehay aneeb imaasiw raata. Ani sooyaneet toona bareeh raata, ani adiyeet toona baraah ikteenna.” idi.<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />Yasuuꞌa een ibhali idiyihoob, ikajaree gaal bariiyeeh eefiir iithꞌaayt, “Ufagiiri oowin kak bak tinfariida?” idi.<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />Yasuuꞌa bariiyooh dehaay, “Ani naat han maagnaayt diyaab akatiyeek, batuuh naan tikatiyeeb oodehay kasseeh tooy eefeen sooyaa. Laakiin ani adiyeet tuuna sidik tikatiyeek, naanhooy tithꞌaheeb?” idi. <verse eid="JHN 18:23" /><verse number="24" style="v" sid="JHN 18:24" />Hannaas masi barooh amhakwira Kayaafaas ufagiiri oowin istoob.<verse eid="JHN 18:24" /></para>
  <para style="s">Bitrus Masi Yasuuꞌaab Itwi</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Siimoon Bitrus masi beentooy ingid nꞌeet iifish. Aflaay dehay weer bariiyooh dehaay, “Baruuk been ootaki kwiriyaatayee gaal kittaa han?” idiin.</para>
  <para style="p" vid="JHN 18:25">Laakiin Bitrus itwi, “Abadan, ani kaaki.” idi.<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />Ufagiiri oowinnaay kishiyaayee gaal, Bitrus wꞌangwiil ikitꞌeeb ootaki ayaay tak iikti hadiidiya, “Tudirꞌaatiib bariiyooh geeb rhaayook kaaki han?” idi. <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />Bitrus masi itwi, “Abadan” idi. Gaal door uujiik kuukillaaya.<verse eid="JHN 18:27" /></para>
  <para style="s">Yasuuꞌa Biilaatoos Istoobna</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Fajir karuumaab Yasuuꞌaab Kayaafaasiib ugawii haay giigiyaaniit whaakimi gaw istoobna. Iyahuudi suurkina oogaw tehooy shuumaab kiikeen. Whasamti Wꞌiidiib mꞌariit tamiini jillaay, igarooyeehna sinhasooyt yhiriwna. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Aflaay Biilaatoos ifirꞌaayt bareeh raatiya, “Oon ootak naan atehimaabaana?” idi.<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />Baraah “Maagt gwibbaab biikaayeek tooy haay kaꞌeena hook.” idiin.<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />Biilaatoos “Aflaay baraak abiiyaakna haay difnaat whaggiisookna haakamaana.” idi.</para>
  <para style="p" vid="JHN 18:31">Iyahuudi igwibiina, “Hinin gaal han nideereet toona hag kinbari.” idiin. <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Tuun haay tiiktiyeeb usabab, Yasuuꞌiib ibhali sidik iiktiineet toonaatu, ibhali baruuh tuyattooh tuyaayi iideet mitiyaayihoob diyaab iiktiyeeba.<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />Biilaatoos oogaw yꞌagaraayt shuumiya, aree Yasuuꞌaab waliikiya. Malya “Baruuk Iyahuudi hadꞌaabwa han?” idi.<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />Yasuuꞌa “Tuun tuuraat bariisook tikati han tari wari anii naat sooyaan hook?” idi.<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />Biilaatoos bariiyooh dehaay, “Aneeb Yahuudiib hiistiniyaheeb han? Aan barook aneeb nuuneen uudehaywa ifagiiriya isuurkinaawwa bariiyeek dehaya. Naan gwibbaabwa?” idi.<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />Yasuuꞌa “Aniit tehadꞌaayi toon tuduniyaatiit kitti. Aniit tehadꞌaayi toon tuduniyaatiit tiiktiyeek, aniib yꞌaamanana Iyahuudi suurkina finaayiinka kiisꞌabiknaheeb. Abadan, aniit tehadꞌaayi tooyeet kitti.” idi.<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />Biilaatoos barooh raatiya, “Aflaay baruuk hadꞌaabwa han?” idi.</para>
  <para style="p" vid="JHN 18:37">Yasuuꞌa “Baruuk ani hadꞌaabu tindiya. Toon toonaati jillaay ani tuduniyaatiib faraayu, tuduniyaatiib yꞌaabu, oosdik whadiidti jillaay yꞌaabi. Sidkiib ikatiibka, aneeb isnaakiir.” idi.<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />Biilaatoos “Uusdik aree naanaatu?” idi. Malya Biilaatoos Iyahuudi beeti barraab ifirꞌaayt malya, “Oon ootak haay atehimaniyi sabab hooy karhan. <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />Laakiin tꞌaada baraak tibariineet, Whasamti Wꞌiidiibka diimaab abuukiib gaal dehookna afandiig. Iyahuudi hadꞌaay fiduug hoosu tehariwna?” idi.<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />Baraah tageega hissii waliikiyaana, “Abadan, oon kiiki! Baarabaas fidiga!” idiin. Baarabaas gwiharanaabi.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Malya Biilaatoos Yasuuꞌaab iyhaayt kwirbaajii ithabꞌa.<verse eid="JHN 19:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 19:2" />Ikajar dantamaat naweetee taaj idꞌiiniit ugirmaay kehii daasiyaan. Malya adaarhamaash halak barooh istookwna. <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />Malya bariiyooh dehaay eeyaaniit, “Dabaaywa, yaa Iyahuudi hadꞌa!” idiin. Masi barooh idwilniit eefiir ithꞌana.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />Biilaatoos oodehay masi ibaayt, “Shibibna, oon ootak haay atehimaniyi gwabab hooy miraab baakaayeet toona tikteenni jillaay, barooh tooy marookna haay yꞌi andi.” idi. <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />Aflaay Yasuuꞌa tinaweeti taajwa adaarhamaash halakwa kehii haayee ifirꞌa eeya. Biilaatoos oodehayii dehaay, “Shibibna! Uutak uun ikati.” idi.<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Ifagiiriya isuurkinaawwa oodiini gawi gwꞌaadiigaawwa Yasuuꞌaab rhiyaanihoob, tageegi hissii waliikiyaaniit, “Sallabaa! Sallabaa!” idiin.</para>
  <para style="p" vid="JHN 19:6">Biilaatoos bareeyooh dehaay, “Baraak ahaanaat malya sallabaana. Ani barooh gwabab hooy karhan.” idi.<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />Iyahuudi masi bhaliiyaana, “Baruuh Ukwaasanaay Oor massalamaabuuyt, hineeb whaggiib baruuh ibakii itoodiir.” idiin.<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />Biilaatoos een ibhali imaasiwihoob, masi winneet mirkwaay hooy daaya. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />Baruuh oogaw yꞌagaraayt Yasuuꞌaab raatiya, “Naa mhiinii yꞌaabwa?” idi. Yasuuꞌa laakiin naat diyaab kiiki. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />Biilaatoos bariiyooh dehaay, “Bhaliisamiheeb kitdiya han? Ani fiduugiitook hadꞌaayi abari, masi sallabtiyook han tehadꞌaayi abariyeet toona kana.” idi.<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />Yasuuꞌa bariiyooh dehaay, “Ukwaasana hiiyyaayookuuyt, baruuk anii kehii oobhaat hadꞌaayeet tibariya. Aflaay uutak aneeb barook nuuniyaab akrakaat maagnaayt ibari.” idi.<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Biilaatoos een imaasiwihoob, Yasuuꞌi fiduug ibsir. Laakiin Iyahuudi masi waliikiyaana, “Oon barooh fandiigeek, shaawti Ugaysari araaw iikti kitdiya! Hadꞌaab massalamiiniibka, Ugaysar ashoosamaabu!” idiin.<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />Biilaatoos een ibhali imaasiwihoob, Yasuuꞌaab haay ifirꞌaayt ugaadi kwirsiib nꞌati isꞌa. Been oomhiin aree, “Yꞌaweeyi kirra” iidna, Yꞌaraami bhaliiyee aree “Gabbaata” iidna. <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Beenhoob uudehir dawil iikti, Whasamti Wꞌiidi hankaay iikti.</para>
  <para style="p" vid="JHN 19:14">Biilaatoos Iyahuudee dehaay, “Whadꞌaayuukna uun ikati!” idi.<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />Baraah waliikiyaana, “Barooh diraa! Barooh diraa! Barooh sallabaa!” idiin.</para>
  <para style="p" vid="JHN 19:15">Biilaatoos “Whadꞌaayookna sallabtiib hoosu tehariwna han?” idi.</para>
  <para style="p" vid="JHN 19:15">Ifagiiriya isuurkina, “Whadꞌa oongaal hinin nibariyeeb Ugaysaru.” idiin.<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />Malya Biilaatoos Yasuuꞌaab sallabiini jillaay bareeh nuuniya.</para>
  <para style="s1" vid="JHN 19:16">Yasuuꞌa Sallabamiya</para>
  <para style="p" vid="JHN 19:16">Aflaay Yasuuꞌaab baraah kinaamiyaan. <verse eid="JHN 19:16" /><verse number="17" style="v" sid="JHN 19:17" />Baruuh saliibooh yaksaa ifirꞌa, “Kalhoob” iidni mhiin iktim. Yꞌaraami bhaliiyee “Goolgoota” iidna. <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Barooh beentooy sallabiyaan. Masi malu da dariibka aree tak gaal sallabiyaana, aree Yasuuꞌa eebtik iifi.<verse eid="JHN 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 19:19" />Biilaatoos bhaliib usaliibi kehii iktib, “Yasuuꞌa Unaasiraayi Iyahuudi hadꞌa” iid bhali kehii iktib. <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />Yasuuꞌa hooy sallabamiyaneeb uumhiin tumadiinaatii sagiib kiikuuyt, gwida dehay een ibhali agriiyaan. Baliin ikatab Yꞌaraami bhaliyeewwa, Laatiini bhaliyeewwa, Yoonaani bhaliyeewwa kataba. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />Ifagiiriya isuurkina Biilaatoosii dehaay, “Iyahuudi hadꞌa miyaad baakatiiba, laakiin ‘Uun uutak ani Iyahuudi hadꞌa akati idi’ miyaad kitiba!” idiin.<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />Biilaatoos igwibi, “Ani aktibeet toona, ani kitbaabi.” idi.<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Ikajar Yasuuꞌaab sallabiyaanihoob, yhalakaayeeh iyheeniit fadhig mhiin yꞌadhidhna. Gaalka whalakii fardaat iyheen. Uun whalak mhakwaliisii eedhoom ookiik gaal hayuud hayaadi.<verse eid="JHN 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 19:24" />Baraah taktakee dehaay, “Whalak binshatiit, shirfiit thꞌiit gaalnaay dehaay dhibiiniib baꞌiikti.” idiin.</para>
  <para style="p" vid="JHN 19:24">Tuun tuuna aree uuktaab diyaab iiktiyeet toona sidik tiikwsi.</para>
  <para style="q1" vid="JHN 19:24">Uuktaab “Baraah yhalakaayi ibtikeehna yꞌadhidhna,</para>
  <para style="q2" vid="JHN 19:24">aree kinaameeni jillaay shirfiit eegidna.” diyaabi.</para>
  <para style="m" vid="JHN 19:24">Aflaay ikajar beet toona idꞌiin.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />Yasuuꞌiib usaliibi dar tuundeewwa, tuduuraawwa, Maryam Kiloobaabiit tutakatwa, Maryam Majdaleenaabwa ingidna. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Yasuuꞌa toondeewwa ukwiriyaataayi wꞌareeyaab iiktiyeebwa beentooy gadee rhiya. Aflaay toondeetii dehaay, “Yaa takatay, wꞌooruuk uun ikati.” idi. <verse eid="JHN 19:26" /><verse number="27" style="v" sid="JHN 19:27" />Malya ukwiriyaataayii dehaay, “Batuuh deetookti.” idi. Been udoorii fidnaab, uun ukwiriyaataayi batooh haay giigiyaayt ugawooh haay ibi.<verse eid="JHN 19:27" /></para>
  <para style="s">Yasuuꞌiit Tooyat</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Yasuuꞌa oontꞌa naatka timmiimtaneet toona ikan. Aflaay uktaabi bhali sidik iiktiina, Yasuuꞌa “Ani yaweebi.” idi. <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />Beentooy rhasa ha ataab diwaan iifi. Aflaay asfoonjiib whaay tehooyteeb ishiyadhꞌaniit, been wꞌasfoonji hindiib yhakwirniit Yasuuꞌiib uyafiib yꞌabikna. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />Yasuuꞌa wha gwꞌiyaayt, “Faayamaabu!” idi. Malya ugirmaayooh kuurisiyaayt eeshuuk sallamiya.<verse eid="JHN 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Malya Iyahuudi suurkina eenda isallabamiyaani ragadaayi katꞌiti Biilaatoos raatiyaan. Masi tikinaaja usaliibii tikwisitiib hooy yhariwna. Baraah beet toona haay yhiriwneeb usabab, uumbꞌi jimꞌaatu tulhaytooh aree tageegaat sabtuuyt, tikinaaja tusabtiit yint usaliibi kehii yhigitneet toona hariwaab kiikeen. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Aflaay ikajar giigiyaaniit ootak whankaaneeb iragada katꞌiyaan. Malya ootak ooraaw Yasuuꞌi geeb sallabamiyaab iragada katꞌiyaan. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Laakiin baraah Yasuuꞌii dehaay eeyaanihoob, baruuh suur akay ayaa rhiyaan. Aflaay bariiyeeh iragada katꞌaab kiikeen. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Ikajareeb gaal Yasuuꞌiib itarab finaatii ikwit, gaal door aree booywa yamwa hooy ifaf. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />Uutak toon toona rhiyaab tibadehaateeh iyiw, taan tibadeha aree sidik iiktiin. Baruuh sidik hadiidiiniyeet toona ikteen. Aree baruuh tibadehaateeh iniiw shaawti baraak han aamaneen tikatiin. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Tuun tuuna aree ooktaabi bhali sidik tiikwsi. Uuktaab “Miitaattuuh gaat han itkitꞌa kitdi.” diyaabi. <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />Weer kitaab aree, “Baraah itilꞌaneeb beeb iishbib iyadna.” diyaabi.<verse eid="JHN 19:37" /></para>
  <para style="s">Yasuuꞌiit Tꞌatoobsooy</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Toon toonaati harꞌii, Yuusif tumadiina Raamaay iiktiib, Yasuuꞌiit tukinaaja Biilaatoos raatiya. Oontꞌa Yuusif Yasuuꞌi kwiriyaataayiibu, laakiin Iyahuudi iriikwuuyt wꞌiimaanooh iikwibis. Biilaatoos baruuh tukinaaja iniineet toona sooya. Aflaay Yuusif han idifaayt tukinaaja yakisiya. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Niigoodiimoos suur Yasuuꞌaab hawaad rheesamaab iiktiib, Yuusif iramaayt mhay tamuun kiiloot shakwiintiit haay eeya. Tishakwiintiib mirwa misikwtwa hooy amshawawiyaata. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Aanda mhallaahna Yasuuꞌiit tukinaaja yakisiyaaniit naaylooniib iksisna, aree shakwiint kehii ififna. Iyahuudiit aadaateeb tukinaajaati baas iitmarnihoob shakwiint kehii iififna, naaylooniib iiksisna. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />Been oomhiin Yasuuꞌa hooy itoodaareeb dirꞌaat tiifi. Beentooy aree gayi miimash gaal han hooy atoobsaab biikaayeeb iifi. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Beet tuuyin tusabti hankaay tiikti, been umiimash aree dawiluuyt, baraah Yasuuꞌaab beentooy daasiyaan.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">Umiimash Wharar</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Tehadti bꞌi karuumaab, masi thibnama door, Maryam Majdaleena umiimash tibi. Wꞌawi umiimashi kehii daasamaab aree yakamaa rhita. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Batuuh dhaabee Siimoon Bitruswa weer kwiriyaataayi Yasuuꞌa areeyaab iiktiyeebwa tibaayt soota. Batuuh “Wꞌankwana umiimashii yakisiyaana, aree naad daasiyaaneeb kinkan!” tidi.<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />Malya Bitruswa ukwiriyaataayi uuraawwa umiimash ibeen. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Baraah mhallaahna dhaabiina, laakiin ukwiriyaataayi uuraaw Bitrusiika dhaabanakaab iikti aree bariiyooh dabaay umiimash iiktim. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />Baruuh nꞌati hooy kuuramiyaayt ishbibihoob, unaaylooni halak beentooy rhiya. Laakiin umiimash tehooy shuumaab kiiki. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Bariiyooh harꞌii Siimoon Bitrus eeyaayt, umiimash shuumiya. Unaaylooni halak beentooy dhibaa rhiya. <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />Umandiil Yasuuꞌiib ugirmaay kehii iifiib han dhibaa rhiya. Laakiin unaaylooni halakii oodꞌooh tafaal akay rhiya. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Malya ukwiriyaataayi uuraaw umiimash hankaab iktim masi umiimash tehooy shuumiya. Baruuh rhiyaayt aamaniya. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />Baraah Yasuuꞌa ibakii tooyat hooy yakiiniyeet toona uktaabii masi afhamaab kiikeen.<verse eid="JHN 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 20:10" />Malya ikwiriyaatay igawaayeehna yꞌagarna.<verse eid="JHN 20:10" /></para>
  <para style="s">Yasuuꞌa Maryam Majdaleenaay Dehaay Lawiya</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />Maryam waawee umiimashii barraab tingad. Batuuh masi waawee, kuuramtaayt umiimash tishbib. <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />Batuuh beentooy malu malak eera halaka akway rhita. Imalak Yasuuꞌa hooy iifiyeeb oomhiin gaal ugirmaay geeb, ooraaw aree iragadaayi geeb sꞌee rhita.<verse eid="JHN 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 20:13" />Imalak batooh raatiyaana, “Yaa takatay, naanhooy waawtinii?” idiin.</para>
  <para style="p" vid="JHN 20:13">Batuuh “Baraah Wꞌankwanaayu yakisiyaana, aree naad daasiyaaneeb kanaat kaaki.” tidi. <verse eid="JHN 20:13" /><verse number="14" style="v" sid="JHN 20:14" />Malya batuuh nakamtanihoob, Yasuuꞌaab beentooy gadee rhita. Laakiin baruuh Yasuuꞌaab iiktiyeet toona kanaat kitti.<verse eid="JHN 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15" />Yasuuꞌa batooh raatiya, “Yaa takatay, naanhooy waawtinii? Aab harriiwii?” idi.</para>
  <para style="p" vid="JHN 20:15">Batuuh barooh dirꞌaat gwꞌaadiigaab hiistaayt, “Duuruun, barooh baruuk yaksaab tikatiyeek, naad daastaneeb sooyaaheeb, aree ani diftiit barooh imaar andi.” tidi.<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />Yasuuꞌa batiiyooh dehaay, “Maryam!” idi.</para>
  <para style="p" vid="JHN 20:16">Batuuh barooh beeti nakamtaayt Yꞌaraami bhaliiyee, “Rabbooni!” tidi. Yꞌaraami bhaliyeeb “Rabbooni!” seedna miyaadi.<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />Yasuuꞌa batiiyooh dehaay, “Hoosu biiꞌamꞌabaakii! Ani masi Ubaaba beeti agaar kaaki. Laakiin batuuk aniib isana bayiit ani Baaboowwa bareeyooh Ubaabaawwa, Ukwaasanaayoowwa Ukwaasanaayoohnaawwa ikatiib beeti atꞌagiir.” idi.<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />Aflaay Maryam Majdaleena giigtaayt ikwiriyaatay usakana soota: “Ani Wꞌankwana rhan!” tidi. Teen teena batooh sooyaneet aree bareeh soota.<verse eid="JHN 20:18" /></para>
  <para style="s">Yasuuꞌa Ikwiriyaatayeeh Dehaay Lawiya</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Beet tehadtiit himni, ikwiriyaatay assama gawaayeeb hiddaab idbalna. Baraah Iyahuudi iriikwna. Malya Yasuuꞌa eeyaayt bareeyooh bitik ingadaayt, “Mꞌasig geebookna badaayi!” idi. <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Yasuuꞌa een ibhali idiit harꞌii, yꞌayeehwa itarabeehwa bareeh rhisiya. Ikwiriyaatay Wꞌankwanaay irhitiib winneet afirhiyaan.<verse eid="JHN 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 20:21" />Yasuuꞌa masi bareeyooh dehaay, “Mꞌasig geebookna badaayi. Ubaaba aneeb diigwatiyaneet toonaatiit, ani han bareekna diigwatani.” idi. <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Malya baruuh bareeyooh kehii hamshuukiyaayt, “Eeshuuk Imugaddasa ahaana! <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />Baraak udehayiit maagnaay afooteeneek, afoomeen. Baraak bitꞌafooyayneek, kaꞌafoomiyaan.” idi.<verse eid="JHN 20:23" /></para>
  <para style="s">Yasuuꞌaawwa Toomaaswa</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Ikwiriyaatay itamna malooyeeb gaal Toomaas, “Utiita” iidna. Baruuh Yasuuꞌa eeyanihoob ikwiriyaatayi geeb kiihaay. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Aflaay ikwiriyaatay aaraw barooh sooyaana, “Wꞌankwana rhina!” idiin.</para>
  <para style="p" vid="JHN 20:25">Laakiin baruuh bareeyooh dehaay, “Ani imismaraayi mꞌat rhi baadiyeek, baliin imismaraayi mꞌati kehii giibalaaytu baadaasayeek, wꞌayu bariiyooh wꞌayi kehii baadaasayeek, aamani kaadi.” idi.<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />Asaramaati harꞌii masi ikwiriyaatay igawaayi tehooyteeb immarraayna, Toomaas han bareeyooh geeb iifi. Idheefa hakwar iiktiineek han, Yasuuꞌa eeyaayt bareeyooh bitik ingadaayt, “Mꞌasig geebookna badaayi.” idi. <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Malya baruuh Toomaasii dehaay, “Giibalaaytook tooy daasa, aniib yꞌayi aree shibiba, malya wꞌayook fidhidha aree aniib itarabi kehii daasa. Shaawti baaꞌeetehaka, aamana!” idi.<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />Toomaas bariiyooh dehaay, “Wꞌankwanaayuuwwa, Ukwaasanaayuuwwa!” idi.<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />Yasuuꞌa barooh sooya, “Aneeb rhitani jillaay aamanta han? Baliin aneeb rhaab baakaay aamaniyaan kak afirhaaba!” idi.<verse eid="JHN 20:29" /></para>
  <para style="s">Oon Ooktaabi Hadaf</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Ikwiriyaatayaah haayee Yasuuꞌa gwidaat mꞌuujisa ikwaas. Taan timꞌuujisa oon ooktaabiib katabt kiikeen. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Laakiin baraak aamanteeni jillaay taan bataah tooy katabta. Yasuuꞌa Umasiih ikatiyeet toonaawwa, Ukwaasanaay Oor ikatiyeet toonaawwa aamanteenihoob, bariiyooh oosmii umidhhan timeerna.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">Yasuuꞌa Asarama Kwiriyaatayee Dehaay Lawiya</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Oonaay harꞌii, Yasuuꞌa ikwiriyaatayeeh Tiibaaryaasi bhariib masi weer door dehaay lawiya. Tuun bak tiikti. <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Siimoon Bitruswa, Toomaas Utiita atoosmaabwa, Naatnaaꞌeel Jaliileeb teefeet Gaanaay iiktiibwa, Sabadi arwa, wari Yasuuꞌi kwiriyaatay maloobwa kassaah hiddaab iifiin. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />Siimoon Bitrus irawee dehaay, “Ani diftiit aashoob ibik andi.” idi. Baraah “Geebook niibi niyad.” idiin. Aflaay baraah bariiyooh geeb tufalluuka yꞌamniit giigiyaan. Laakiin been whawaad kassooh aashoob naat han aabkaab kiikeen.<verse eid="JHN 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4" />Fajir tuuyin talawtiyihoob, Yasuuꞌa iyami dariib ingad. Laakiin ikwiriyaatay baruuh Yasuuꞌaab iiktiyeet toona kanaab kiikeen.<verse eid="JHN 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 21:5" />Malya Yasuuꞌa bareeh raatiya, “Yaa yhankwila, naat aabkaab kitteena han?” idi.</para>
  <para style="p" vid="JHN 21:5">Baraah “Naat han aabkaab kinki.” idiin.<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />Baruuh bareeyooh dehaay, “Tushabakaatookna tufalluukaati maygwadii dehaay gidnaa, naat ibik tiyadna.” idi. Aflaay baraah tushabaka igidnihoob, gwida aashoob titabayt oosaakw adgiraab kiikeen.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />Ukwiriyaataayi Yasuuꞌa areeyaab iiktiyeeb Bitrusii dehaay, “Uun baruuh Wꞌankwana ikati!” idi. Siimoon Bitrus Wꞌankwana oomiyaad imaasiwihoob, whalak hoosooh firꞌaab iiktiyeeb ikwaayt iyameeb dhibiya. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />Ikwiriyaatay aaraw tufalluukaatiib iyami ginnaal beeti eeyaana, tushabaka aashoob tabaa sookwiin. Baraah uginnaalii sagiib kiikeenayt, sheeb mitraab eetiit masaafa whaashii iifiin. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Baraah ubhari ginnaal tikwiyaanihoob, balooliint dhhaliiti kehii aashoobwa hadhiibwa daasama rhiyaan.<verse eid="JHN 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 21:10" />Malya Yasuuꞌa bareeyooh dehaay, “Oontꞌa aabkaab tikatiineeb aashoob galib haay mꞌaana.” idi.<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />Siimoon Bitrus tufalluuka reewiyaayt, tushabaka barraab irhif. Batuuh wawin aashu ataabtu, sheebwa ay tamuunwa mhay aashoob iiktiin. Laakiin yꞌaashu gwidaab iiktiineek han tushabaka masi shatatamaat kitti. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />Yasuuꞌa bareeyooh dehaay, “Mꞌaanaat tamaana!” idi. Laakiin baruuh Wꞌankwana iiktiyeet toona ikannayt, baruuh aab iiktiyeet toona bareesooh gaal han barooh raataab kiiki. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Yasuuꞌa eeyaayt yhadhi yakisiyaayt bareeh yhii. Yꞌaashu han bak iweer. <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />Yasuuꞌa tooyat hooy yakiyaneekka, oontꞌa mhaya door ikwiriyaatayeeh dehaay lawiya.<verse eid="JHN 21:14" /></para>
  <para style="s">Yasuuꞌaawwa Bitruswa</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Baraah tamiyaani harꞌii, Yasuuꞌa Siimoon Bitrusii dehaay, “Siimoon Yuuhannaayi oor, een bareeh iraweeka aneeb daayiib areetniyaheeba?” idi.</para>
  <para style="p" vid="JHN 21:15">Baruuh “Awooh han Wꞌankwanaayu, ani areeyaniyeetook toona baruuk tikteena.” idi.</para>
  <para style="p" vid="JHN 21:15">Yasuuꞌa “Aniib yhu daayiib tamsaa.” idi.<verse eid="JHN 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16" />Yasuuꞌa malya door bariiyooh dehaay, “Siimoon Yuuhannaayi oor, sidik aneeb areetniyaheeba?” idi.</para>
  <para style="p" vid="JHN 21:16">Baruuh “Awooh han Wꞌankwanaayu, ani areeyaniyeetook toona baruuk tikteena.” idi.</para>
  <para style="p" vid="JHN 21:16">Yasuuꞌa “Aniib yꞌargina daayiib shaakwa.” idi.<verse eid="JHN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17" />Yasuuꞌa mhaya door bariiyooh dehaay, “Siimoon Yuuhannaayi oor, aneeb areetniyaheeba?” idi.</para>
  <para style="p" vid="JHN 21:17">Yasuuꞌa mhaya door bariiyooh dehaay, “Areetniyaheeba?” idiit raatiyani sabbii, Bitrus yhasi. Baruuh “Wꞌankwanaay, baruuk naatka tikteena, ani areeyaniyeetook toona tikteena!” idi.</para>
  <para style="p" vid="JHN 21:17">Yasuuꞌa bariiyooh dehaay, “Aniib yꞌargina tamsaa.” idi. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Yasuuꞌa “Oosdik andi hook: Adhamiib tiiktiyihoob, martiit tehiriwi mhiinka tiibiya. Laakiin eegrimamtiniyihoob, yꞌayeek iibrir tindiya, aree weer gaal laabibtiit hook bitehariiwi mhiin istuub hook indi.” idi. <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />Yasuuꞌa een ibhali haay iideet tuuna: Bitrus haay yaayi iideet tehayꞌaawwa, Ukwaasana matuun iniiweet toonaawwa tuuliya. Malya Yasuuꞌa bariiyooh dehaay, “Ramaheeb!” idi.<verse eid="JHN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Bitrus nakamiyanihoob, ukwiriyaataayi Yasuuꞌa areeyaab iiktiyeeb bareeyooh harꞌii sakee rhiya. Ukwiriyaataayi oodraari door Yasuuꞌaab beeti ikilasaayt, “Wꞌankwanaay aaw iitil hook indi?” idiib iikti. <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Bitrus barooh rhiyanihoob, Yasuuꞌaab raatiya, “Wꞌankwanaay, uun uutak aree kaku?” idi.<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />Yasuuꞌa igwibi, “Ani atꞌagiireeb ookiik barooh ishidhhin andiyeek, naan dehook iikti indi? Baruuk ibakii ramaheeb!” idi. <verse eid="JHN 21:22" /><verse number="23" style="v" sid="JHN 21:23" />Tuun tuuna Yasuuꞌiib ikwiriyaatayi bitik hadiidamta. Uun ukwiriyaataayi iiyyi kiidi ittiyoodaay. Laakiin Yasuuꞌa baruuh iiyyi kiidi diyaab kiiki. Yasuuꞌa “Ani atꞌagiireeb ookiik barooh ishidhhin andiyeek, naan dehook iikti indi?” idi.<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />Uun ukwiriyaataayi teen teena hadiidiyaabi. Baruuh teen bateeh han iktib. Baruuh diyaab ikatiyeet taana sidik ikatiineet toona nikteen.<verse eid="JHN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Yasuuꞌa gwidaat mꞌuujisa warit han ikwaas. Kastaah timꞌuujisa gaat gaanaatii itkatiibneek, kastuuh tuduniya kitab hooy ikatibneeb dehaay kiimriin.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>