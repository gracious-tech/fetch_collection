<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- Bella</book>
  <para style="h">Luugaay</para>
  <para style="toc1">Luugaay Wꞌinjiil</para>
  <para style="toc2">Luugaay</para>
  <para style="mt">Luugaay Wꞌinjiil</para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s1">Isuurdaba</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />Tiyoofilus Duuruunay!</para>
  <para style="p" vid="LUK 1:1">Gwida dehay Wꞌankwana geeboon ikwaaseeb eemtaal sootiib jarrabiyaan. <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />Baliin wꞌawwalii hadiriyaaniit toona tutikeet rhiyaan Ukwaasanaay ibhaliyi shagaamana sooyaaneeteen teena, baraah iktibna. <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />Aflaay Ani uknaayu tibadootee kasseeh een eemtaal daayiib ashibib. Yaa Tiyoofilus whamooysama, ani han een bareeh daayiit hayꞌaatii dehook akantiibeet toona niyaaman. <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />Aflaay teena tisoomamtaneet usidkooh isdil hook miyaadiib dehook akantiib.<verse eid="LUK 1:4" /></para>
  <para style="s">Yuuhannaab umoosanaayt timifray whankaay soomamta</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />Heeroodis Yahuudaay whaashi hadꞌa iiktiyeeb udamaaniib, Abiiyaayt tudirriyaaytii iikti fagiiri Sakariyaab iidni iifi. Tutakatuuh Iliisaabaat iidneet han Haaruuniit tudirriyaaytii tiikti. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />Aan baraah mhallaah Ukwaasanaay suurii daayiiba. Wꞌankwanaayt tiwaseewwa whagwa kasseeh winneet isniikarna. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />Laakiin Iliisaabaat giduudiitu, aree baraah mhallaah eegrimaabayt, ar kiibariin.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />Door gaal Sakariya ufagiiriit waajibtooh idꞌi, aree baruuh Ukwaasanaay suurii ifagiiramti shagaayooh shagaamiya. <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />Ifagiiriya iidꞌaneet tꞌaadaateeb, tugurꞌa bariiyooh dehaay dhibta. Baruuh Wꞌankwanaay oogaw beeti giigiit oolbaan iiliw iikti. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />Oolbaan hooy iiliwneet tuusꞌa eetanihoob, uudehay isiileeliin kassaah barraab siileeliin.<verse eid="LUK 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11" />Malya Wꞌankwanaay malak bariiyooh dehaay lawiya. Oolbaaniit karaamaati mhiini umaygwadiib gadee lawiya. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />Sakariya umalak rhiyanihoob, akra mirkwaay irkwi. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />Laakiin umalak bariiyooh dehaay, “Sakariya, baarakwiya! Tusiileeltuuk titmassaaw. Tutakatuuk Iliisaabaat nikwiitiit, oor ifaar tindi. Oon wꞌoor Yuuhannaab iisim tindiya. <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />Baruuh firhaatwa mimdheedhtwa dehook iikti indi. Baruuh itfariyeeb oodoor, gwida dehay han afirhi iyadna. <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />Baruuh Wꞌankwanaay suurii win tak iikti indi. Haab gwꞌi kiidi tari naat askirsitiniit gwꞌi kiidi. Toondeeti yaamiib haayee Eeshuuk Imugaddasa iitab indi. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />Yꞌisraaꞌiilaayi dehayiib gwidaab Wꞌankwana Ukwaasanaayoohna dehaay yꞌigir indi. <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />Baruuh Wꞌankwanaay suurii Eelyaay ishuukeewwa yꞌakrireewwa saki indi. Ibaaba yꞌareehna areesi indi. Ukwaasana baasinaakiir oodehay eeshbooneet fagarandi beeti yꞌigir indi. Wꞌankwanaay dehaay amar dehay iikwasi indi.” idi.<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />Sakariya umalak raatiya, “Aneebwa tutakatuuwwa eegrimaaba, een ibhali usidkooh kak akteen?” idi.<verse eid="LUK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19" />Umalak igwibi, “Ani Jibriili. Ukwaasanaay suurii angadi, aree barook anfariidi jillaaywa oon usakana udaayiib sootiyook jillaaywa diigwatamaabi. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />Baruuk aniib ibhali aamanaab kittaayayt, gilluusiib iikti tindiya, aree tuun tuuna tikatiyeeb hadiit whadiidti adgiri kitdiya. Baliin aniib ibhali udooriyooh sidik iikti iyadna.” idi.<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />Been oodoor uudehay Sakariyaab yhigitna. Baruuh Wꞌankwanaay ugawiib idleeleet toonaatiib ajjabamiin. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />Sakariya ifirꞌihoob, ibhaliyi hadiidti adgiriib akaab kiiki. Uudehay baruuh Ukwaasanaay ugawiib naat rhi rhaab ikatiyeet toona ikanna. Sakariya oodehayii dehaay wꞌayiisooh tuuli. Laakiin whadiidti adgiraab kiiki.<verse eid="LUK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23" />Wꞌankwanaay ugawiib ishagaamtiib damaneeh faayisiyanihoob, baruuh ugawooh ibi. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />Beenaay harꞌii tutakatuuh Iliisaabaat tinkwi. Batuuh ay tirga oogaw hasamaat kitti. <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />Batuuh “Wꞌankwana anii dehaay toon idꞌi. Een eembꞌi baruuh tudaayiinaaytooh rhisiyaheeb aree udehayiisu bitikii yꞌeeba hoosu giigisiya.” tidi.<verse eid="LUK 1:25" /></para>
  <para style="s">Yasuuꞌiit Toofrayti Sakana</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />Wꞌasagwira tirgiib, Ukwaasana umalak Jibriil Jaliileeb whaashiib tiifiit tumadiina Naasiraab beeti diigwatiya. <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />Daawidiit tudirriyaaytii iiktiib Yuusif iidni takii dehaay daasamaat aagirtii dehaay diigwatiya. Tꞌaagir Maryam iidna. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />Umalak Maryamii dehaay shuumiyaayt, “Kwatiituwii? Wꞌankwana geebook eefi. Batuuk winneet baarakamaatuwii.” idi.<verse eid="LUK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29" />Maryam umalaki bhaliyeeb winneet gwirhaamta, aree uun naa salaamti iiktiyeeb ajjabista. <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />Laakiin umalak batiiyooh dehaay, “Maryam, biirakwii! Ukwaasanaayt nꞌima timrii. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />Inaakw tindii aree oor ifaar tindii. Barooh Yasuuꞌaab iisim tindii. <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />Uun wꞌoor win tak iikti indi. Winneet Utageegaay Wꞌoor ituusim indi. Wꞌankwana Ukwaasana barooh whooba Daawidiit tehadꞌaayi iyaaw indi. <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />Malya baruuh diimaab Yaaguubiit tudirriyaayti kehii hadꞌaab iikti indi. Tehadꞌaayeetuuh door han ingid kitdi.” idi.<verse eid="LUK 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />Maryam umalakii dehaay, “Tuun kak iikti tindi, ani aagirt akatiyeek?” tidi.<verse eid="LUK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35" />Umalak igwibi, “Aashuuk Imugaddasa hook daayi iyadna. Winneet Utageegaay akrir kehook daayi iyadna. Aflaay been umugaddas batiisook itfariib Ukwaasanaay oor ituusim indi. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />Beet tꞌayaay takatuuk Iliisaabaat han tꞌeegrimaaytiyooh oor ifaar tindi. Beet suur giduudiit tittiyuud oontꞌa asagwir tirgaayi nakw tibari. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />Ukwaasana biikwaasiyeena kitehaay.” idi.<verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />Maryam tigwibi, “Ani Wꞌankwanaayt kishiyaati. Baruuk tindiyeet batiikti!” tidi. Malya umalak batooh yꞌish giigiya.<verse eid="LUK 1:38" /></para>
  <para style="s">Maryam Ilisaabaat Rheesamtini</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />Beenhoob Maryam timaraayt willa Yahuudaay irbaayi haashiib tiifiit madiina tibi. <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />Sakariyaay oogaw shuumtaayt Iliisaabaat shoobta. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />Iliisaabaat Maryamiit tusalaam timaasiwihoob, wꞌoor batiiyooh uyaamiib irgas. Aree Iliisaabaat Eeshuuk Imugaddasa titab. <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />Batuuh tageegi hissii Maryamii dehaay: “Batuuk timꞌateeb baarakamakaatuwii, uyaamiyook eefeeb unisrik han baarakamaabi. <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />Laakiin ani aabtuuyt, Wꞌankwanaayiitu tuundi eetniheeb? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />Batiiyook tusalaamti hiss willa amaasiwihoob, wꞌoor firhaatee uyaamiyu irgas. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />Wꞌankwana uwaadiyaayooh iitkwikw indiyeet toona aamantaayayt, batuuk baarakamaatuwii.” tidi.<verse eid="LUK 1:45" /></para>
  <para style="s">Maryamiit Hamaadiit Kaft</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />Maryam:</para>
  <para style="q1" vid="LUK 1:46">“Kassooh uginꞌiisu Wꞌankwana ahammiid.<verse eid="LUK 1:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47" />Ukwaasana Wꞌishidhhiinu sabbii aniib aashuuk afirheena,<verse eid="LUK 1:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48" />baruuh imshabiibheeb</para>
  <para style="q2" vid="LUK 1:48">aneeb tukishiyaatooh tumiskiin.</para>
  <para style="q1" vid="LUK 1:48">Oontꞌaanee fidnaab kassuuh uutaas tubaarakama waliikiheeb iyadna.<verse eid="LUK 1:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="LUK 1:49" />Ukwaasana Wꞌalya anii dehaay winnayt idꞌi,</para>
  <para style="q2" vid="LUK 1:49">aree uusmuuh mugaddas ikati.<verse eid="LUK 1:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50" />Tirhamaataah baliib barooh ireekw beeti,</para>
  <para style="q2" vid="LUK 1:50">taas taasii ikatimna.<verse eid="LUK 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51" />Wꞌankwana wꞌayiisooh akraanayt ikwaas.</para>
  <para style="q2" vid="LUK 1:51">Iginꞌaayeeb ookibir ibariib baliib ibrir idꞌi.<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />Yhadꞌa tehadꞌaayeeteesoohna tikwisiya,</para>
  <para style="q2" vid="LUK 1:52">laakiin imiskiina reewisiya,<verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />yhargwaab daayiinaytee gabisiya,</para>
  <para style="q2" vid="LUK 1:53">laakiin igabaab naat anu giigisiya.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54" />Ukishiyaayooh Israaꞌiil isham,</para>
  <para style="q2" vid="LUK 1:54">tirhama shꞌiya,<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />Ibraahiimwa, yꞌareeyooh dehaaywa diimaab</para>
  <para style="q" vid="LUK 1:55">idiyeet toonaatiit hoobeeyoon dehaay han diyaabi.” tidi.<verse eid="LUK 1:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />Maryam mhay tirga Iliisaabaati geeb tehagitaayt, malya ugawooh tꞌagar.<verse eid="LUK 1:56" /></para>
  <para style="s">Yuuhannaab Umoosanaayt Toofiray</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />Iliisaabaat ufraayuuh door eeyanihoob, oor tifri. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />Ishawwaahwa yꞌayaydaahwa Wꞌankwana batooh tirhamaateeh tigwidaat rhisiyaneet toona imaasiwna, aree baraah batiiyooh geeb winneet afirhiyaan.<verse eid="LUK 1:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59" />Baraah tooyin tꞌasimhaatiib unisriki kwishuubii dehaay eeyaan. Aree barooh ubaaba Sakariyaay dehaay iisimneet toona yhiriwna. <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />Laakiin bariituuh tuundi hadiidtaayt, “Abadan! Baruuh Yuuhannaab ituusim indi.” tidi.<verse eid="LUK 1:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61" />Baraah batiiyooh dehaay, “Udehayook bitik oon oosim atoosmaab gaal han kiihaay.” idiin.<verse eid="LUK 1:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 1:62" />Malya ubaaba Sakariyaab beeti mitiyaayaaniit, baruuh wꞌoorooh aab iisim indiyeet toona sakanaayaan. <verse eid="LUK 1:62" /><verse number="63" style="v" sid="LUK 1:63" />Baruuh kehii kantiibi lha raatiya. Malya baruuh, “Oosmooh Yuuhannaab ittiyoodi.” idiit iktib. Uudehay kassaah winneet ajjabamiyaan. <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />Malya Sakariyaab willa uyafuuh ingal, umiidalaab ifdag, aree whadiidti badooya. Aree Ukwaasana yhamid. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />Ishawaw kasseeh mirkwaay dehaay dhibiya. Kassooh Yahuudaay irbaayi haashiib uudehay teen teena kasteeh hadiidiyaan. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />Een ibhali iimsawka isgiribna aree raatiina, “Uun wꞌoor naan iikti indi?” iidna. Wꞌankwana bariiyooh geeb eefiyeet toona ikanna.<verse eid="LUK 1:66" /></para>
  <para style="s">Sakariyaayt Tookaf</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />Bariiyuuh ubaaba Sakariya Eeshuuk Imugaddasaayee itabaayt isrid:<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />“Whamaad Wꞌankwanaayu, Israaꞌiileeb Ukwaasana,</para>
  <para style="q2" vid="LUK 1:68">Baruuh eeyaayt udehayooh ishidhhan.<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />Baruuh midhhan iniiw akraab gaal</para>
  <para style="q2" vid="LUK 1:69">Daawidi dhiwaayeeb dehoon yakisiya.<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />Baruuh shꞌiika inabiyaayeeh imugaddasaayi geebii waadiyaayaabi.<verse eid="LUK 1:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71" />Yꞌashooyeesoon ishidhhin hoon indi,</para>
  <para style="q2" vid="LUK 1:71">kasseeh baliib iroobanaayeen yꞌayee ishidhhin hoon indi.<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />Baruuh hoobeen rhamaat arhamiya,</para>
  <para style="q2" vid="LUK 1:72">aree ugaladooh umugaddas shꞌiini.<verse eid="LUK 1:72" /></para>
  <para style="q2">
    <verse number="73" style="v" sid="LUK 1:73" />Baruuh hooboon Ibraahiimii dehaay halafooyaneet tehalafooy:<verse eid="LUK 1:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74" />Yꞌashooyeesoon yꞌayee ishidhhiineetoon toonaatu,</para>
  <para style="q2" vid="LUK 1:74">aree barooh mirkwaay anu shagaamnayeet toona ootaad dehaay iniiweetoon toonaati.<verse eid="LUK 1:74" /></para>
  <para style="q2">
    <verse number="75" style="v" sid="LUK 1:75" />Bariiyooh suurii diimaab kasseeh imbꞌeeyeen gadastiiwwa shibootiiwwa nikweer.<verse eid="LUK 1:75" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />Aree baruuk, yaa wꞌooruun, Winneet Utageegaay nabi ittiyuud tindiya,</para>
  <para style="q2" vid="LUK 1:76">baruuk Wꞌankwanaay dehaay usalal tisoomiiri jillaay, bariiyooh suurii giigi tindiya.<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />Bareeh idanuubaahna afoomeenihoob,</para>
  <para style="q2" vid="LUK 1:77">umidhhan imeerneet toona bariiyooh oodehay sooyi tindiya.<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />Ukwaasanaayuun gwidaat rhamaateebuuyt,</para>
  <para style="q2" vid="LUK 1:78">tuuyin tutalawtiniit tibreetee yꞌi hoon tindi.<verse eid="LUK 1:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79" />Baliib uthibniib ikweernaayi kehii talawtiniyi jillaaywa,</para>
  <para style="q2" vid="LUK 1:79">tuyattiit lꞌandalaatiib eefeen baliib dehaay talawiiniyi jillaaywa,</para>
  <para style="q1" vid="LUK 1:79">iragadaayeen umꞌasgi salal beeti mitiyaatiniyi jillaaywa yꞌi tindi.” idi.<verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />Unisrik Eeshuuk Imugaddasaayee iwin aree yꞌakir. Baruuh Yꞌisraaꞌiilaayee dehaay daayiib lawiyaneeb hadiit umingaayiib ikwiri.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s">Yasuuꞌiit toofiray</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />Baliit tiyinaateeb, Gaysar Agustus gaanuun hassiya, been Iroomaaniit Imbiraatooriyaayti haashiib kassooh oodehay idheegwneet toona sooya. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />Been oodehayi dhigwuuy wꞌawwali Kiiriiniyoos Suuriyaay haakim iiktiyeeb udamaaniib iikti. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />Uudehay gaalka tumadiinaatooh tuknaatiib itkitibni jillaay giigiyaan.<verse eid="LUK 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4" />Aflaay Yuusif han Daawidi dhiwaayiib iiktiyi sabbii, Jaliileeb whaashiib tiifiit Naasiraab iidneet tumadiinaatii giigiyaayt, Yahuudaay whaashiib tiifiit Daawidiit tumadiina Beetlaham ibi. <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />Baruuh Maryami geeb itkitibi jillaay beentooy ibi. Maryam bariiyooh dehaay daasamaatu aree nakwalaayti. <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />Baraah Beetlahameeb haayee, ufiraayuuh door eeya. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />Yꞌamnaayi gawiib mhiin kiihaay akay, batuuh wꞌoorooh usuurkina tifriit, halakiib tikwibis aree ureewiit daatiib bꞌasta.<verse eid="LUK 2:7" /></para>
  <para style="s">Yꞌanooteegaawwa Imalakwa</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />Been oomhiin tidirꞌa tidawilnaateeb tꞌanooteehna iishkwiin anooteega iifiin. Baraah whawaad tꞌanooteehna iigwꞌadna. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />Wꞌankwanaay umalak bareeyooh dehaay lawiya. Wꞌankwanaay umatuun bareeyooh kwayaay talawiya. Aree baraah winneet irkwiin. <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />Laakiin umalak bareeyooh dehaay, “Baarakwiina! Uudehay kassaah winneet haay afirheeni daayi sakana iyaaw hookna andi. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />Amsi Daawidiit tumadiinaatiib, ishidhhiin dehookna faraayi. Oon barooh ‘Umasiih Wꞌankwana’ iyadna. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />Tuun batuuh alaamaat dehookna iikti tindi: halakiib kwabaas nisrik reewiit daatiib bꞌiiniib timeerna.” idi.<verse eid="LUK 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13" />Gaalhoob umalaki geeb gwida tibreeti malak lawiyaaniit, baraah kassaah Ukwaasana yhamidna.<verse eid="LUK 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14" />Baraah “Umatuun Ukwaasana teebri titageegaateeb eefeenaay baꞌiikti,</para>
  <para style="q2" vid="LUK 2:14">aree umꞌasig tubuuti kehii eefeen baliib barooh afirhiseen udehayiib baꞌiikti.” idiin.<verse eid="LUK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />Imalak bareeh yꞌishniit teebri beeti yꞌagarnihoob, yꞌanooteega taktakee dehaay, “Beetlaham beeti niidif, aree beet toona tutikeet Wꞌankwana sooyaneetoon niishbib.” idiin.<verse eid="LUK 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16" />Aflaay baraah ashshigee eeyaaniit Maryamwa, Yuusifwa, unisrik ureewiit daatiib bꞌiibwa rhiyaan. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />Barooh rhiyaanihoob, umalak bareeh sooyaneet toona bareeyooh dehaay hadiidiyaan. <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />Aree baliin beet toona imaasiw kassaah yꞌanooteega bareeh sooyaaneet toonaatiib ajjabamiyaan. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />Laakiin Maryam teen teena kasteeh uginꞌiyooh tidꞌiit bateeyooh kwoonta. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />Yꞌanooteega umalak sooyaneet toonaatiit, kasteeh teena tirhiyaaneetwa tꞌimaasiwneetiiwwa dehaay Ukwaasana hamdeewwa tageegseewwa yꞌagarna.<verse eid="LUK 2:20" /></para>
  <para style="s">Yasuuꞌa Itoosaam</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />Tooyin tꞌasimhaatiib, bariiyooh ukwishuubi door eeyanihoob, baruuh Yasuuꞌaab itoosaam. Tuundi nikwaat baakaay umalak whankaay barooh simaab iiktiyeeb oosim itoosaam.<verse eid="LUK 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22" />Wꞌateharamti door eeyanihoob, Muusaay whaggiib teefeet toonaatiit, Yuusifwa Maryamwa Wꞌankwanaay dehaay suursiini jillaay barooh Algudus haay ibeen. <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />Wꞌankwanaay whaggiib kataabt toonaatiit, oofraayiib isuurkina irabaab kassaah Wꞌankwanaay dehaay waasamiin. <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />Aree Wꞌankwanaay whaggiib attiyoodiyaat toona sakiini jillaay, baraah han maloot kwibheeri tari maloot dabalooyaat hammamiyay karaamaat iifirꞌanee dehaay giigiyaan.<verse eid="LUK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25" />Beenhoob Simꞌoon iidni tak, Ukwaasana iriikw Alguduseeb iifi. Baruuh shibu taku aree Ukwaasana iriikw. Baruuh Israaꞌiil umidhhan timiireet toona yhigit aree Aashuuk Imugaddasa bariiyooh kehii iifiin. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />Wꞌankwana Umasiih baarhi iiyyi biidiyeet toona Aashuuk Imugaddasa oon ootakii dehaay lawsaaba. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />Aashuuk Imugaddasa hantaayisiyaaniit, baruuh udiini gawi hoosh ibi. Ifaru whag yhiriweet tꞌaada bariiyooh dehaay sakiini jillaay, wꞌoor Yasuuꞌaab udiini gaw beeti haay eeyaanihoob, <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />Siimoon barooh yꞌayeesooh yakisiyaayt, Ukwaasana yhamid, aree:<verse eid="LUK 2:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="LUK 2:29" />“Wꞌankwana Wꞌakra, baruuk waadiyaataneet toonaatiit,</para>
  <para style="q2" vid="LUK 2:29">oontꞌa ani ukishiyaayuuk asgaa ayaayi.<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />Aniib aagwꞌad umidhhanook rhiyaana,<verse eid="LUK 2:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31" />beet toona baruuk kassooh oodehayi suurii tisoomira,<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />baruuh Ijintiili usalal rhisiini nuuru,</para>
  <para style="q2" vid="LUK 2:32">aree udehayook Israaꞌiil matuun dehaay haay yꞌiini.” idi.<verse eid="LUK 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />Wꞌoori baabaawwa tuundeewwa bariiyooh tittiyoodaayt toonaatiib ajjabamiyaan. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />Malya Simꞌoon bareeh ideharaayt Maryamii dehaay, “Uun wꞌoor Israaꞌiileeb gwida dehay dhibsi indi aree gwidaab yaksi indi. Baruuh Ukwaasana diigwataab ikatiyeet toona rhistiniit alaama ikati, laakiin uudehay barooh eeribna. <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />Aflaay gwida dehayi ginꞌa eekwinneet tuuna lawi tindi. Aree batook han bꞌadhadh unfisook iikwit indi.” idi.<verse eid="LUK 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36" />Beentooy masi winneet eegrimt nabi Hannaab Fanuuꞌeeliit oot iidneet, Ashiiriit tugabiilaatii tiiktiit tiifi. Batuuh tidꞌareenaay harꞌii, asarama hawla utakiyooh geeb tikwiri. <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />Malya batuuh asimhay tamuunwa fadhig hawla tiiktiyeeb ookiik ibraatfaatkiit tiki. Batuuh Wꞌankwanaay oogaw door han hasamaat kitti. Laakiin whawaadwa oombꞌeewwa tꞌabid, baaskiittii aree siileelti. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />Beet tumidda bareeyooh dehaay eetaayt, Ukwaasana tehamid. Algudusi fiduug yhigit kassooh oodehayii dehaay wꞌoori sakana hadiidta.<verse eid="LUK 2:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />Yuusifwa Maryamwa kasteeh teena baliit Wꞌankwanaay whag yhiriweet idꞌiinihoob, baraah Jaliileeb tiifiit tumadiinaatoohna tookna Naasiraab beeti yꞌagarna. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />Wꞌooruuhna iwin aree yꞌakir. Baruuh fagarandiit itab, aree Ukwaasanaayt tinꞌima bariiyooh kehii iifiin.<verse eid="LUK 2:40" /></para>
  <para style="s">Wꞌoor Yasuuꞌa Wꞌankwanaay Ugawiib</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />Wꞌoor ifarooyaah hawilka Whasamti wꞌiidii dehaay Algudus haay iibiin. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />Yasuuꞌa tamna malu hawla iiktiyihoob, baraah diimaab sakiineet toonaatiit wꞌiidii dehaay insiin. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />Wꞌiidiit yina ingadni harꞌii, ifarooyaah itꞌigirneet midda, wꞌoor Yasuuꞌa Alguduseeb harꞌa imhi. Laakiin baraah beet toona kanaab kiikeen. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />Baruuh bareeh iitrameeb hiisee, baraah bꞌeeb iibaabiyaan. Malya baraah yꞌaydeehwa yꞌaraweeyoohna bitikwa barooh yhariwna. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />Barooh inawnihoob, baraah bariiyooh harawaay Algudus beeti yꞌagarna. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />Mhayt yinaati harꞌii barooh Wꞌankwanaay ugawi hooshiib imriina, ikoojaayi geeb sꞌeewwa bareeh sinaakireewwa naat raraateewwa imriin. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />Uudehay kassaah barooh imaasiw baliin bariitooh tufhamaatiibwa bariiteeh tigwabiiteebwa ajjabamiyaan. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />Ifarooyaah barooh rhiyaanihoob, baraah ajjabamiyaan. Tuundi bariiyooh dehaay, “Anaa wꞌooru! Naanhooy bak tiweera hoon? Baabuukwa aneebwa winneet nhariw hook, aree hasakaay daana.” tidi.<verse eid="LUK 2:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49" />Wꞌoor igwibi, “Naanhooy aneeb tehiriwnaheeb? Ani baabiyu ugawiib daayaniyeet toona kitkanna han?” idi.<verse eid="LUK 2:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 2:50" />Laakiin baruuh bareeyooh dehaay naan iideeb afhamaab kiikeen.<verse eid="LUK 2:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51" />Malya Yasuuꞌa bareeyooh geeb Naasiraab beeti yꞌagar aree bareeh isnaakir. Laakiin bariituuh tuundi teen teena kasteeh uginꞌiyooh tidbi. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />Yasuuꞌa ugarooywa tifagarandiiteewwa iwin. Ukwaasanaay rada rayiimiya aree oodehayi reer rayiimiya.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s">Yuuhanna Umoosana Usalal Isoomir</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />Iroomaani Gaysar Tiibaaryoos hadꞌaab iiktiyeekka whawil utamna ayyaay, Boontiyus Biilaatoos Yahuudaay haakim iikti. Heeroodis aree Jaliil yhakim, aree usanuuh Fiilibus Ituuriyaawwa Tiraakuunitooswa iidni hash yhakim. Liisaaniyaas aree Abiileena iidni haash yhakim.<verse eid="LUK 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 3:2" />Hannaanwa Kayaafaaswa ifagiiriyaayi suurkina iiktiini door, Ukwaasanaay ibhali Yuuhannaab Sakariyaay wꞌoorii dehaay umingaayiib eeyaan. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />Beenhoob baruuh kasseeh Urduni kwayaay iifiin yhash ibi. Baruuh oodehayii dehaay, “Ukwaasanaay dehaay tuubaana aree atoomaasna! Malya idanuubaakna afoomi iyadna. <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />Unabi Isyaasiib uktaabiib kataabt toonaatiit:</para>
  <para style="q1" vid="LUK 3:4">‘Umingaayiib waliikiini hiss gaal eefi,</para>
  <para style="q1" vid="LUK 3:4">Wꞌankwanaay dehaay usalal soomirna!</para>
  <para style="q2" vid="LUK 3:4">Tilagi fadhadht dehaay kwaasna!<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />Kastaah taarꞌu ibakii itoobiisneet toonaatu,</para>
  <para style="q2" vid="LUK 3:5">kassaah aarbaawwa ikanbilwa eetyiimneet toonaati.</para>
  <para style="q1" vid="LUK 3:5">Isalala yhalag itfadhiidhneet toonaatu,</para>
  <para style="q2" vid="LUK 3:5">tilagi tishingiraat ilamisneet toonaati.<verse eid="LUK 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6" />Aree Kassuuh uudehay Ukwaasanaay umidhhan rhi iyadna.’ indi.” idi.<verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />Yuuhanna bariiyooh atoomsooytii dehaay ifrꞌa oodehay igwidaanaay dehaay, “Yaa ikwakwaraayi ar, bareek beeti sakeen igadabee eedhab aaw sooya hookna? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />Tuubaana firaay lawsaana! Aree igarooyeekna dehaay, ‘Ibraahiim baaboon akay nibari.’ tiyadneeb baahiisaana. Oosdik andi hookna, Ukwaasana een yꞌaweeyee Ibraahiimi dehaay ar yaksitiib adgiriini. <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />Uufaas whindi gadami kehii suur akay daasamiya. Whindi daayiit samara haay baayꞌay, katꞌamiit nꞌeetiib ituugid indi.” idi.<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />Uudehay barooh raatiyaana, “Aflaay, kak saknay?” idiin.<verse eid="LUK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11" />Yuuhanna igwibi, “Uutak malu halaka ibari, ibaabariib whalakooh oongaal baꞌiyaaw! Mꞌariit ibari, ibaabariib baꞌiyaaw!” idi.<verse eid="LUK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12" />Itilbaat lakkatana han itoomisnee dehaay eeyaan. Baraah raatiyaana, “Seedna, hinin kak saknay?” idiin.<verse eid="LUK 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13" />Baruuh bareeyooh dehaay, “Titilba dehookna daamaat nuun gwidakaana baaꞌahaana.” idi.<verse eid="LUK 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14" />Malya kajar gali barooh raatiyaana, “Aree hinin kak saknay?” idiin.</para>
  <para style="p" vid="LUK 3:14">Yuuhanna igwibi, “Oodehay akruurii mhallagaab hooy baaꞌahaana! Tari gwisree baaꞌatehimaana! Imhallaga ititkwasiineeb haay ganaamaana!” idi.<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />Beenhoob uudehay Umasiihiib wꞌaay sꞌayaamiina, aree baraah kassaah igarooyeehna sakanaayiina, “Yuuhanna Umasiih akat yꞌiini han?” iidna. <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />Yuuhanna oodehay kassiyooh dehaay, “Ani iyamee anmiis hookna. Laakiin anii harꞌii yꞌiini, aniika akrakaabi. Ani tigidhꞌaateeh afandiigeet toona han kaꞌastehalan. Baruuh Eeshuuk Imugaddasaayeewwa nꞌeetiiwwa iimis hookna indi. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />Uun baruuh girbaalooh yaksaabu, wharru daayiib isinhis indi. Igamhooh ugeesaay daasi indi, wꞌagga aree baayaayt nꞌeetii iiliw indi.” idi. <verse eid="LUK 3:17" /><verse number="18" style="v" sid="LUK 3:18" />Yuuhanna oodehay usakana udaayiib sooyi, aree gwida wari salalaayee bareeyooh dehaay bhaliiyi.<verse eid="LUK 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 3:19" />Laakiin Yuuhanna whaakim Heeroodis idaanin. Baruuh bariiyooh dehaay, “Usaniitook takat Heeroodiyaas tiniineet tuuna shingiraanaati.” idi. Yuuhanna masi Heeroodis gwidaat maagnay warit han sakaab iiktiyeet toona sooya. <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />Malya Heeroodis Yuuhannaab usijniib idꞌiit, tumaagnaaytooh tusuureet gwidakaat maagnaay hooy ishaaw.<verse eid="LUK 3:20" /></para>
  <para style="s">Yasuuꞌa Itoomaas</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />Kassuuh uudehay itoomaasnihoob, Yasuuꞌa han itoomaas. Baruuh siileelee aree taabri ifdagna. <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />Aashuuk Imugaddasa kwibheeriit hayꞌaatii bariiyooh kehii tikwiyaan. Tibreetee hiss eeyaayt: “Wꞌooru winneet wꞌareeyaniyeeb barookwa. Ani winneet hook madhaadhu.” idi.<verse eid="LUK 3:22" /></para>
  <para style="s">Yasuuꞌiib Yhooba</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />Yasuuꞌa wꞌallamti badooyanihoob, wꞌimruuh mhay tamuun hawla iikti. Aflaay uudehay baruuh</para>
  <para style="li1" vid="LUK 3:23">Yuusif Haali oor iiktiyeeb hiisiyaan. <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />Haali Mataatiib, Mataat Laawiib, Laawi Malkiib, Malki Yanaayiib, Yanaa Yuusifiib, Yuusif Mataatayaasiib, <verse eid="LUK 3:24" /><verse number="25" style="v" sid="LUK 3:25" />Mataatayaas Aamuusiib, Aamuus Naahuumiib, Naahuum Hasliib, Hasli Nagaayiib, Nagaay Maaꞌaatiib, <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />Maaꞌaat Mataatayaasiib, Mataatayaas Shimꞌiib, Shimꞌi Yoosikiib, Yoosik Yoodaayiib, Yooda Yuuhannaayiib, <verse eid="LUK 3:26" /><verse number="27" style="v" sid="LUK 3:27" />Yuuhanna Reesaayiib, Reesa Saruubaabiliib, Saruubaabil Shaꞌaltiiꞌeeliib, Shaalaatyaal Neeriib, Neeri Malkiib, <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />Malki Addiiyiib, Addi Koosaamiib, Koosaam Ilmadaamiib, Ilmadaam Eeriib, <verse eid="LUK 3:28" /><verse number="29" style="v" sid="LUK 3:29" />Eer Jooshiwaayiib, Jooshiwa Alꞌaasariib, Alꞌaasar Yooriimiib, Yooriim Mataatiib, Mataat Laawiib, Laawi Shimꞌooniib, <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />Shimꞌoon Yahuudaayiib, Yahuuda Yuusifiib, Yuusif Yoonaamiib, Yoonaam Alyaagiimiib, Alyaagiim Malyaayiib, <verse eid="LUK 3:30" /><verse number="31" style="v" sid="LUK 3:31" />Malya Minnaaniib, Minnaan Mataataayiib, Mataata Naataaniib, Naataan Daawidiib, <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />Daawid Yassiib, Yassi Oobeediib, Oobeed Booꞌaasiib, Booꞌaas Salmooniib, Salmoon Naahshuuniib, <verse eid="LUK 3:32" /><verse number="33" style="v" sid="LUK 3:33" />Naahshuun Amiinadaabiib, Amiinadaab Admiib, Admi Raamiib, Raam Hasruuniib, Hasruun Faarasiib, Faaras Yahuudaayiib, <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />Yahuuda Yaaguubiib, Yaaguub Isehaagiib, Isehaag Ibraahiimiib, Ibraahiim Taaraahiib, Taaraah Naahuuriib, Naahuur Saruukiib, <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />Saruuk Raaꞌuuyiib, Raaꞌuu Faalikiib, Faalik Aabiriib, Aabir Shaalahiib, <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />Shaalah Geenaaniib, Geenaan Arfakshaadiib, Arfakshaad Saamiib, Saam Noohiib, Nooh Laamikiib, Laamik Mitooshaalihiib, <verse eid="LUK 3:36" /><verse number="37" style="v" sid="LUK 3:37" />Mitooshaalih Hanookhiib, Eenook Yaaridiib, Yaarid Maahaalaalꞌiiliib, Maahaalaalꞌiil Geenaaniib, <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />Geenaan Anooshiib, Anoosh Sheetiib, Sheet Aadamiib,</para>
  <para style="li1" vid="LUK 3:38">Aadam Ukwaasanaay ooru.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">Uubliis Yasuuꞌaab Jarrabiya</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />Yasuuꞌa Eeshuuk Imugaddasaayee tabaa Urduniit abaatii dehaay yꞌagar. Aashuuk barooh umingaay beeti salooliyaan. <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />Beentooy uubliis fadhig tamuunt yina barooh jarrabiya. Kastooh toon tumidda Yasuuꞌa mꞌariit tamaab kiiki. Aree baliit tiyina ingadnihoob, baruuh winneet yharagw.<verse eid="LUK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3" />Uubliis bariiyooh dehaay, “Ukwaasanaay Wꞌoor tikatiyeek, oon wꞌawi ‘Hadhiib akaa!’ diyaa!” idi.<verse eid="LUK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4" />Yasuuꞌa igwibi, “Tuun batuuh ooktaabiib kataabtu: ‘Wꞌaadami mꞌariit toobhaanaatii kiidhhan.’ diyaabu.” idi.<verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />Uubliis barooh tageegi mhiin beeti haay tageegiyaayt, kasteeh tubuutiit tehadꞌaayi baliit gaat damtalawtiib rhisiya. <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />Aree baruuh bariiyooh dehaay, “Kasseeh een yhasheet hadꞌaayeewwa matuunwa iyaaw hook andi. Tuun tuuna aneeb attiyeewiyaatu, aree batooh ani aharriiweebka aniiw. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />Aflaay aneeb anbiideek, tuun kastuuh bariitook iikti tindi.” idi.<verse eid="LUK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8" />Yasuuꞌa igwibi, “Tuun tuuna ooktaabiib kataabtu: ‘Wꞌankwana Ukwaasanaayook abida aree barooh oobhaat shagaama.’ indi.” idi.<verse eid="LUK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9" />Uubliis barooh Algudus haay ibaayt, Wꞌankwanaay ugawi mooyi kehii isingad. Baruuh “Ukwaasanaay Oor tikatiyeek, tooysii nꞌati faraa! <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />Tuun batuuh ooktaabiib kataabtu:</para>
  <para style="q1" vid="LUK 4:10">‘Ukwaasana imalakeeh</para>
  <para style="q2" vid="LUK 4:10">barook daayiib eegwꞌadiini jillaay waseeyiini.<verse eid="LUK 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LUK 4:11" />Baraah yꞌayeeyoohna kehii itfiyik hook iyadna, aflaay iragadaayeek awi han iithꞌa kiidi.’ diyaabu” idi.<verse eid="LUK 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12" />Laakiin Yasuuꞌa igwibi,</para>
  <para style="q" vid="LUK 4:12">“Uuktaab: ‘Wꞌankwana Ukwaasanaayook baajarrabaa!’ indi.” idi.<verse eid="LUK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />Uubliis kastooh toonaatii Yasuuꞌaab jarrabiyaayt faayisiyanihoob, baruuh weer door ookiik barooh yꞌish giigiya.<verse eid="LUK 4:13" /></para>
  <para style="s">Yasuuꞌa Naasiraay Itoorraab</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />Yasuuꞌa Ishuuki akriree Jaliil beeti yꞌagar. Bariiyuuh usakana kasseeh yhadabeeb itmassaaw. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />Yasuuꞌa oodehay Iyahuudi diini gawiib allamiya. Kassuuh uudehay barooh yhamidna.<verse eid="LUK 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />Yasuuꞌa Naasiraab tehooy hamaay iiktiyeet beeti eeya. Aree toona diimaab sakiyeet tꞌiiteena, toosab Iyahuudi diini gaw shuumiya. Aree baruuh agriiyi jillaay asti ingad. <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />Baruuh unabi Isyaasiib ooktaab ittiyeewaay. Yasuuꞌa ooktaab ingilaayt, oomhiin beet tuuna hooy kataabt tiiktiyeeb imri:<verse eid="LUK 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />“Wꞌankwanaay Aashuuk anii kehii eefeen.</para>
  <para style="q2" vid="LUK 4:18">Usakana udaayiib oodehay yhamraab</para>
  <para style="q2" vid="LUK 4:18">askatiimee dehaaywa,</para>
  <para style="q1" vid="LUK 4:18">wꞌabaak itfadiigeet toonaati sootii dehaaywa,</para>
  <para style="q2" vid="LUK 4:18">whamashay rhisaniyee dehaaywa,</para>
  <para style="q1" vid="LUK 4:18">yꞌatootraab asfadiigee dehaaywa Wꞌankwana diigwatiyaheeb.<verse eid="LUK 4:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19" />Aree Wꞌankwana udehayooh hooy agbiliiniyeeb whawil asookiinee dehaaywa, diigwatiyaheeb.” idi.<verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />Malya Yasuuꞌa ooktaab iksisaayt, ukhaddaam nuunsiyaayt isꞌa. Kassuuh uudehay Iyahuudi diini gawiib iifiin winneet barooh ishbibna.<verse eid="LUK 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 4:21" />Aree Yasuuꞌa bareeh infaraadiit, “Amsi oon uktaabiib timaasiwneet tuuna sidik tiki.” idi.<verse eid="LUK 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />Uudehay kassaah daayiinaayt bariiyooh hadiidiyaana, aree bariiyooh uyafii eeyaan tinꞌimaati bhaliyeeb ajjabamiyaan. Baraah raatiyaana, “Uun baruuh Yuusifi oor kiiki han?” idiin.<verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />Yasuuꞌa bareeyooh dehaay, “Baraak een eemtaal anii dehaay tiyadneet toona kaꞌeetehakan: ‘Whakiimay, ugarooyook mheelaa! Kafarnaahuumiib sakiya diyee nimaasiweet teena tooy tumadiinaatiyook sakaa!’ tiyadnaheeb.” idi.<verse eid="LUK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 4:24" />Yasuuꞌa masi, “Oosdik andi hookna, tumadiinaatiyooh agbilama nabi kiihaay. <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" />Oosdik andi hookna, unabi Eelyaay udamaaniib, Israaꞌiileeb gwidaat ibraatfaatki iifiin. Taabri mhay hawlaawwa asagwir tirgaawwa assamiyaanihoob, uubri kwidhiyaayt kassooh whaashiib akraat hargwi daata. <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />Unabi Eelya teen timꞌateeb gaanaatii dehaay han diigwatamaab kiiki. Laakiin Siidooni haashiib tumadiina Sirfaatiib tiifiit ibraatfaatki beeti diigwatamiya. <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />Unabi Alyashꞌaayiib udamaaniib, Israaꞌiileeb gwida dehay bhadh iibriin iifiin. Laakiin Nꞌuumaan Usuuriyaayi nuun gaal han bareesooh mheelamaab kiiki.” idi.<verse eid="LUK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28" />Iyahuudi diini gawiib iifiin uudehay kassaah een ibhali imaasiwnihoob, winneet yhaseen. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />Baraah yakiyaaniit Yasuuꞌaab tumadiinaatii iskwiin. Barooh ukanbuulii nꞌati iigidni jillaay, oorbaay mooyi kehii tiifiit tumadiina beeti haay reewiyaan. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />Laakiin Yasuuꞌa kassooh oodehayi bitikii sakiyaayt giigiya.<verse eid="LUK 4:30" /></para>
  <para style="s">Yasuuꞌaabwa Ootak Ijineeyaaywa</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />Malya Yasuuꞌa Kafarnaahuum iidneet Jaliileeb tiifiit tumadiina beeti hoogiya. Aree oodehay Toosab allamtiib badooya. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />Ibhaliyaah takweet iibriinayt, uudehay bariiyooh utꞌaliimiib winneet ajjabamiyaan.<verse eid="LUK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33" />Iyahuudi diini gawiib jin abkaab iiktiini tak iifi. Uutak tageegi hissii gagariya, <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />“Aah! Yasuuꞌa Unaasiraayi! Naan hoon harriiwa? Kwidhistiyoon dehaay yꞌaabwa han? Baruuk aab tikatiyeeb akteen hook, Ukwaasanaay Umugaddas Oongaal tikatiya!” idi.<verse eid="LUK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35" />Yasuuꞌa eejin idninaayt, “Tim akaat hooy firꞌaa!” idi. Malya aajin ootak kassooh oodehayi suurii dhibisiyaaniit, barooh adaayaab baakaay hooy ifirꞌana.<verse eid="LUK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36" />Uudehay kassaah ajjabamiyaaniit taktakee dehaay, “Aan naa bhaliiya? Baruuh eejin akrireewwa takweeteewwa isfarꞌa. ‘Firꞌana!’ indiyihoob, itfarꞌana.” idiin. <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />Yasuuꞌiib usakana kasseeh yhadabeeb iifiin yhasheeb ibrar.<verse eid="LUK 4:37" /></para>
  <para style="s">Yasuuꞌa Gwida Dehay Mheeliya</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />Yasuuꞌa Iyahuudi diini gawii giigiyaayt, Siimooniib oogaw shuumiya. Beenhoob Siimoon tehamtuuh akra abaaki tiibri, aree baraah Yasuuꞌa tootakat dehaay mheeliyeet toona raatiyaan. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />Aflaay Yasuuꞌa batiiyooh kuuramiyaayt yꞌabaaki idnin. Aree yꞌabaaki tutakatii ifirꞌana. Batuuh gaalhoob yaktaayt, bareeyooh dehaay shagaamta.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />Tuuyin dhibtiyihoob, kassuuh uudehay gwida jinsaayeet lhanay iibriin yꞌamshaayeehna haay eeyaan. Yasuuꞌa een bareeh gaalka yꞌayeeh kehii daasiyaayt, bareeh mheeliya. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />Gwida dehayii han jin hooy ifirꞌana. Aajin waliikiyaaniit, “Uun baruuk Ukwaasanaay Wꞌoorwa!” idiin. Laakiin aajin baruuh Umasiih iiktiyeet toona iktiinnayt, Yasuuꞌa eejin idaanin aree bareeh hadiidsaab kiiki.<verse eid="LUK 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />Tuuyin talawtanihoob, Yasuuꞌa mingaayama mhiin ibi. Kassuuh uudehay ifirꞌaniit, barooh yhariwna. Barooh imriinihoob, bareesooh oogiig habuuy jarrabiyaan. <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />Laakiin Yasuuꞌa bareeyooh dehaay, “Ani timadiina tirawteeb eefeen oodehay han Ukwaasanaayt tehadꞌaayeeti sakana udaayiib ibakii aniiweet toonaati. Ani toon toonaatii dehaay diigwatamaabi.” idi. <verse eid="LUK 4:43" /><verse number="44" style="v" sid="LUK 4:44" />Yasuuꞌa Yahuudaay whaashiib Iyahuudi diini gawaayeeb usakana udaayiib bhaliiya.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s">Yasuuꞌa Ikwiriyaatay Yꞌawwaleeb Waliikiini</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />Yint gaat Yasuuꞌa Ganeesaareeteeb iyami dar ingid. Uudehay Ukwaasanaay ibhali isniikarni jillaay barooh kwalala. <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />Yasuuꞌa iyami ginnaal yꞌaashoob aabki ishaab iiktiineet maloot falluuka rhiya. Baraah tishabakaateehna iishgwadhna. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />Yasuuꞌa falluukaat gaat Siimooniit tiiktiinaati kehii ingadaayt, “Tufalluukaatook iyami ginnaalii diiseet suurbeeti gwishisha!” idi. Malya Yasuuꞌa tufalluukaatiib isꞌat oodehay allamiya.<verse eid="LUK 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4" />Baruuh ibhaliyeeh faayisiyanihoob, Siimoonii dehaay, “Tufalluukaatook iyameet tehooy beeti gwishisha, aree tishabakaateekna iyameeb gidnaat aashoob aabikna!” idi.<verse eid="LUK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5" />Siimoon igwibi, “Wꞌankwanaay, oon oomhiin whawaad kassooh akraab shagaamna, aashooyaayt han abkaab kinki. Laakiin baruuk bak tindiyayt, tishabaka iigid andi.” idi.<verse eid="LUK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 5:6" />Baraah tishabakaateehna iyameeb igidnihoob, tishabakaataahna shatatamiyaaneeb hadiit gwida aashoob yꞌaabikna. <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />Aflaay baraah tufalluuka tooraawtiib iifiin yꞌaraweehna beeti ashshariyaaniit, yꞌeetiit bareeh eeshtiimneet toona hooy yhariwna. Aree baraah eeyaaniit, mhalliteehna tishabaka aayam miyaay yhiriwneeb hadiit winneet itibna.<verse eid="LUK 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8" />Siimoon Bitrus toon toona rhiyanihoob, Yasuuꞌiib iragadaayi whii dhibiyaayt, “Wꞌankwanaayu, hoosu giiga! Ani amaag taku.” idi. <verse eid="LUK 5:8" /><verse number="9" style="v" sid="LUK 5:9" />Siimoon Bitruswa, yꞌaashoob aabki igeeb iifiin kassaahwa baliin yꞌaabkaab iiktiineet yꞌaashooyeet guudtiib winneet ajjabamiyaan. <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />Aree Yaaguubwa Yuuhanna Sabadi arwa, Siimooniib ishariikiiwwa han winneet ajjabamiyaan.</para>
  <para style="p" vid="LUK 5:10">Malya Yasuuꞌa Siimoonii dehaay, “Baarakwiya! Amseenee fidnaab dehayi aabki iikti tindiya.” idi. <verse eid="LUK 5:10" /><verse number="11" style="v" sid="LUK 5:11" />Aflaay tifalluukaateehna iyami ginnaal beeti sookwiyaaniit, naatka ingadni idꞌiiniit barooh iramna.<verse eid="LUK 5:11" /></para>
  <para style="s">Yasuuꞌa Tak Bhadh Iibriib Mheeliya</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />Yasuuꞌa madiinaat gaanaatiib haayee, tak bhadh iibriib eeya. Uun uutak Yasuuꞌaab rhiyanihoob, ifiiree whaashi kehii dhibiyaayt, barooh inꞌal, “Wꞌankwanaay, sinhasaheeb, harriiweek baruuk sinhasooyti adgirtiniya.” idi.<verse eid="LUK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13" />Yasuuꞌa wꞌayooh ibriraayt, ootaki kehii daasiyaayt, “Aharriiw, nhas akaa!” idi. Igidiyeesooh uubhadh ootakii giigiya aree baruuh inꞌir.<verse eid="LUK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 5:14" />Malya Yasuuꞌa ootak waseeyaayt, “Toon toona tak han baasooya! Difaat ugarooyook ufagiiri rhisa. Tinꞌireet toona rhisitiniyi jillaay, iminhiseeyook dehaay been unabi Muusa sooyaab iiktiyeet tikaraama firꞌaa.” idi.<verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />Laakiin Yasuuꞌiib usakana winneet gwidakaana ibrar. Aflaay gwida dehay bariiyeeh ibhali isniikarni jillaaywa, tilhanayteesoohna mheelamiini jillaaywa eeyaan. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />Laakiin Yasuuꞌa diimaab bareesooh giigiyaayt, mingaayama mhiin ibaayt siileeliya.<verse eid="LUK 5:16" /></para>
  <para style="s">Yasuuꞌa Ootak Ubhadhiyaay Mheeliya</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />Yint gaat Yasuuꞌa oodehay allami. Ifariisiiwwa whaggi koojaawwa baliit Jaliilwa Yahuudaawwa Alguduseet tigariya kasteesoohwa yꞌaaba aree beentooy iistꞌana. Eelhaab mheeliyi jillaay Wꞌankwanaay yꞌakrir Yasuuꞌaab attiyeewiyaaba. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />Daab gali amꞌadhdha tak madhamti kehii fiyakee haay eeyaan. Ootak oogaw haay shuumiit, Yasuuꞌii suurii daasiineet toona jarrabiyaan. <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />Laakiin dehayiit guudti ishuumti adgirat iribnihoob, ootak ugawi mooy haay reewiyaan. Malya baruuh tumadhamtiyooh kehii haayee tukaaktii nꞌati hoogisiyaaniit, oodehayi bitik Yasuuꞌi suurii daasiyaan.<verse eid="LUK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 5:20" />Yasuuꞌa wꞌiimaanoohna rhiyanihoob, “Yaa takay! Tumaagtuuk afoomaati.” idi.<verse eid="LUK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21" />Ifariisiiwwa whaggi koojaawwa aakna kwoontiib badooyaana, “Uun ukifuuri bhali hadiidiini aabu? Ukwaasana oodꞌooh baakaay, weer adgiriit tumaagnaay afooyiini aabu?” idiin.<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />Yasuuꞌa baraah naan iikwinneeb iktiin aree raatiya, “Iginꞌiyookna naanhooy teen teena teekwinna? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />Naan laamakaatu: ‘Tumaagnaaytuuk afoomaati’ uumiyaad han ‘Yhaa! Asti gadaat, hiireera!’ uumiyaad? <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />Laakiin ani Wꞌaadami Oor tubuuti kehii tumaagnaay haay afooyaniyeet hadꞌaayi abari.” idi. Malya baruuh ootak wꞌamꞌadhdhaanaay dehaay, “Asti gadaa! Tumadhamtook yaksaat ugawook bayaa, andi hook” idi. <verse eid="LUK 5:24" /><verse number="25" style="v" sid="LUK 5:25" />Uutak igidiyeesooh bareeyooh suurii asti ingad. Toona tehooy bꞌaab iiktiyeet iyhaayt Ukwaasana hamdee ugawooh ibi. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />Kassuuh uudehay ajjabamiyaaniit Ukwaasana yhamidna. Baraah winneet mirkwaay itabniit, “Oon amsi akraat mꞌuujisa rhina!” idiin.<verse eid="LUK 5:26" /></para>
  <para style="s">Yasuuꞌa Laawiib Waliikiya</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />Oonaay harꞌii, Yasuuꞌa ifirꞌa aree umaktabiyooh iistꞌa Laawi iidni tilbaat lakkatanaab rhiya. Yasuuꞌa ootakii dehaay, “Ramaheeb!” idi. <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />Laawi yakiyaayt, naatka ingad idꞌiit barooh iram.<verse eid="LUK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29" />Malya Laawi ugawiyooh Yasuuꞌii dehaay aduumaat idꞌi. Aree gwida tilbaat lakkatanaawwa, waribwa bareeyooh geeb tamiin. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" />Laakiin Ifariisiiwwa Whaggi koojaawwa yhaseeniit, Yasuuꞌiib ikwiriyaatayee dehaay ashkiimiyaaniit, “Itilbaat lakkatanaayi geebwa, tumaagnaay sakeen oodehayi geebwa naanhooy tamteena aree gwꞌiteena?” idiin.<verse eid="LUK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31" />Yasuuꞌa bareeyooh dehaay, “Uudehay wꞌakra hakiimii dehaay kiishinhana, eelhaab nuun. <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />Ani eeshboob waliikaniyee dehaay yꞌaab kaaki, laakiin timaagnay sakeen tuubsaniyi jillaay yꞌaabi.” idi.<verse eid="LUK 5:32" /></para>
  <para style="s">Yasuuꞌa Tubaaskiitii Raatamamiya</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />Baraah Yasuuꞌii dehaay, “Yuuhannaay kwiriyaataywa, Ifariisi kwiriyaataywa, gwidaat baaskiiteena aree siileeleen. Laakiin bariiyaak ikwiriyaatay tameena aree gwꞌeen.” idiin.<verse eid="LUK 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34" />Yasuuꞌa igwibi, “Idoobsana udooba bareeyooh geeb haayee baaskiiteena han? <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />Laakiin udooba bareesooh yakamiiniyeet yint gaat daayi tindi. Baliit tiyinaateeb baraah baaskiiti iyadna.” idi.<verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />Yasuuꞌa bareeyooh dehaay een eemtaal hadiidiya:</para>
  <para style="p" vid="LUK 5:36">“Tak silhaayt gayi halakii firꞌatiit shꞌiiya halakiib kiihayid. Bak iwariyeek, whalak ugayi shatatamiini, aree whalak ugayiinaayt tusilhaay beeb ushꞌiiyaanaay kehii kitshiboob. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />Aree aat gayiit hamiit aateeb infiif gaal han kiihaay. Bak iwariyeek, tiyꞌa tigayiit tehawat thawseena, tiyꞌa eetfiifna aree tehawat dayꞌamtini. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />Laakiin tiyꞌa tigayiit ibakii gayiit hawattiib daameen. <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />Hamiit aat gwꞌiini tak tigayiit kiihariw, baruuh ‘Tehamiit daayikaata.’ indi.” idi.<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s">Tusabti Ankwana</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />Sabt gaat Yasuuꞌa harrooyt dirꞌaati bitik saki, aree ikwiriyaatayaah gangaraab ikitꞌaniit ishmitniitka tehabba tamiyaan. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />Fariisi gali bareeyooh dehaay, “Tusabtiib harramamaana naanhooy sakteena?” idiin.<verse eid="LUK 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3" />Yasuuꞌa bareeyooh dehaay igwibi, “Whadꞌa Daawidwa yꞌarawaahwa yharagwnihoob, baruuh sakiyaneet toona agriiyaab kitteena han? <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />Daawid Ukwaasanaay gaw shuumiyaayt, Ukwaasanaay dehaay farꞌa tikaraamaati hadhi tamiya. Baliib yhadhi ifagiiriya nuun wari katamiyaan. Aree yꞌaraweeh han naat yhii.” idi. <verse eid="LUK 6:4" /><verse number="5" style="v" sid="LUK 6:5" />Malya Yasuuꞌa bareeyooh dehaay, “Wꞌaadami Oor tusabti Ankwana ikati.” idi.<verse eid="LUK 6:5" /></para>
  <para style="s">Wꞌayi Adhaadh Iiktiyeeb Ootak</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />Sabt weet baruuh Iyahuudi diini gaw shuumiyaayt, oodehay allamiya. Been oomhiin wꞌayi umaykwa ayaab iiktiyi tak iifi. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />Ifariisiiwwa, whaggi koojaawwa Yasuuꞌaab haay atehimiini sabab yhiriwna. Aflaay baruuh ootak toosab mheeliini han kaamheeliya isdawilni igwꞌadna. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />Laakiin Yasuuꞌa baraah iikwinneet toona iktiin. Aree ootak wꞌayi ayaab iiktiyeenaay dehaay, “Yakaat kassooh oodehayi suurii asti gadaa!” idi. Aflaay uutak yakiyaayt, beentooy asti ingad.<verse eid="LUK 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9" />Malya Yasuuꞌa bareeyooh dehaay, “Raati hookna andi! Tusabtiib naan halaalu: tudaayiinaayti sakti han tumaagnaay? Gaalnaayt shidhhanooyt han kwidhistiib?” idi.<verse eid="LUK 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 6:10" />Baruuh kasseeh bareeyooh nakamiya, malya ootakii dehaay, “Wꞌayook fidhidha!” idi. Uutak bak idꞌi, aree wꞌayuuh winneet inꞌir. <verse eid="LUK 6:10" /><verse number="11" style="v" sid="LUK 6:11" />Laakiin baraah winneet yhaseeniit, Yasuuꞌaab kak iwariineeb taktaki geeb tarootsamiyaan.<verse eid="LUK 6:11" /></para>
  <para style="s">Ilinguumiya Itamna Malu</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />Baliit tiyinaateeb yint gaat Yasuuꞌa siileelti jillaay ribaab reewiyaayt, whawaad kassooh beentooy Ukwaasanaay dehaay siileeliya. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />Uumha mhiyanihoob, Ikwiriyaatayeeh waliikiyaayt, bareesooh tamna maloob waasiya. Bareeh ilinguumiya isim: <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />Siimoon tari Bitrus simaab iiktiyeebwa, Andaraawoos oosanwa, Yaaguubwa, Yuuhannaawwa, Fiilibuswa, Baartulamaawooswa, <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />Mattaawwa, Toomaaswa, Yaaguub Alfaaꞌiyoosi oorwa, Siimoon “Wꞌashꞌara” iidneebwa, <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />Yahuudaab Yaaguubiib oosanwa, Yahuudaab Wꞌiskaaryuuti malya ukhaayin ikeebwa, een bareeh isim.<verse eid="LUK 6:16" /></para>
  <para style="s">Yasuuꞌa Allamiini Aree Mheeliini</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />Yasuuꞌa bareeyooh geeb ikwibar eeyanihoob, gwida kwiriyaatayi geeb dangaltiib ingad. Gwida dehay kassooh Yahuudaaywa Algudusee yꞌaabwa, oobhari ginnaaliib iifiint timadiina Tiirooswa Siidooneewwa yꞌaabwa beentooy iifiin. <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />Baliin baraah barooh isniikarni jillaaywa, tilhanayteesoohna mheelamiini jillaaywa yꞌaaba. Baliib aajin hooy iifiineeb han mheelamiyaan. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />Bariisooh yꞌiin yꞌakrir bareeh kasseeh mheeliinayt, kassuuh uudehay bariiyooh itatehiti yhiriwna.<verse eid="LUK 6:19" /></para>
  <para style="s">Tifirhaawwa Igadabwa</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />Yasuuꞌa ikwiriyaatayeeh ishbibaayt:</para>
  <para style="q1" vid="LUK 6:20">“Libaabtaana, baraakna imiskiina,</para>
  <para style="q2" vid="LUK 6:20">Ukwaasanaayt tehadꞌaayi bareetookna tikati.<verse eid="LUK 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21" />Libaabtaana, baraakna oontꞌa yhargwa,</para>
  <para style="q2" vid="LUK 6:21">gabi tiyadna.</para>
  <para style="q1" vid="LUK 6:21">Libaabtaana, baraakna oontꞌa waaween,</para>
  <para style="q2" vid="LUK 6:21">iifiyad tiyadna.<verse eid="LUK 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LUK 6:22" />Libaabtaana, Wꞌaadami Oori sabbii uudehay</para>
  <para style="q2" vid="LUK 6:22">himaageen hookna,</para>
  <para style="q2" vid="LUK 6:22">itafilna hookna aree neeween hookna</para>
  <para style="q3" vid="LUK 6:22">wꞌamaag dehayiit eeribna hookna.<verse eid="LUK 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23" />Wꞌijruukna tibreeteeb gwidaabuuyt, beet tooyin afirhaana aree midhadhna. Bareeyaah yhooba suur inabiya bak weeraaba.<verse eid="LUK 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24" />Laakiin tidhikwna, baraakna oontꞌa igabaab!</para>
  <para style="q2" vid="LUK 6:24">Tuduniyaatiit nafirnaay wꞌijaarookna timriina.<verse eid="LUK 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25" />Tidhikwna, baraakna oontꞌa dꞌooramaab!</para>
  <para style="q2" vid="LUK 6:25">Baraakna itehirigw tiyadna.</para>
  <para style="q1" vid="LUK 6:25">Tidhikwna, baraakna oontꞌa yꞌeefiyiid!</para>
  <para style="q2" vid="LUK 6:25">nawwaatiit waawi tiyadna.<verse eid="LUK 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LUK 6:26" />Tidhikwna, kassaah uudehay daayiinayt hookna hadiideenihoob,</para>
  <para style="q2" vid="LUK 6:26">suur bareeyaah yhooba inabiya igwisreeb bak iweerna.” idi.<verse eid="LUK 6:26" /></para>
  <para style="s">Yꞌashooyeekna Areeyaana</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />Yasuuꞌa, “Laakiin baraakna uudehay aneeb yꞌisnaakiir andi hookna: Yꞌashooyeekna areeyaana! Baliib iroobanaayeekna daayiinaayt weerna. <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />Oodehay wꞌinꞌiitookna deharna. Baliib amaag hookna sakeen dehaay siileelaana. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />Gaal udaraagook oongaal inthꞌeek, ooraaw han hiiyya! Gaal sideeriyaaytook iniineek, gamiisook han baahabiya. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />Tak naat hook harriiwihoob, toona teharriiweet hiiyya! Gaal bariitookna iniineek, aguur hooy baahariiwa. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />Uudehay dehookna baꞌiidꞌiin tiyadneet toona, baraakna han dehaay dꞌiina.<verse eid="LUK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32" />Oodehay yꞌareeyeeneekna areeteeneek, naan rayiimteena? Yꞌamag da han yꞌareeyeeneehna areeyeen. <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />Oodehay daayiib iwariineekna daayiib tiwariineek, naan rayiimteena? Yꞌamag da han beet toona sakeen. <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />Oodehay ookwis hooy sꞌayaamteeneeb tisiisaliifneek, naan rayiimteena? Yꞌamag da han yꞌamag da isiisaliifna, timmiimaana itkwasiineet toona sꞌayaameen. <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />Laakiin yꞌashooyeekna areeyaana, daayiib weerna, siisalifna aree kwis baasꞌayaamaana. Malya wꞌijruukna guudi indi, aree Winneet Utageegaay ar iikti tiyadna. Baruuh baliib ibaahamiidaawwa yꞌamag daawwa dehaay nꞌakwmanaayiini. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />Baabuukna rahiim ikatiyeet toonaatiit, rahiimaab akeena.” idi.<verse eid="LUK 6:36" /></para>
  <para style="s">Eeraw Baahaakamaana!</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />Yasuuꞌa “Baahaakamaana, aree haakamami kitdiina. Baaꞌankiraana, aree ankirami kitdiina. Afooyaana, aree afoomi tiyadna. <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />Hiina, aree ittiyiw tiyadna. Daayi abaar, ataabna, hiddaab atyawawꞌaana, teetfiifna hiina, beet tuuna yꞌayeekna beeti ituufif tindi. Wꞌabaar itiyawneenaay dehookna abbarami tindi.” idi.<verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />Yasuuꞌa een ibhali bareeh mitaalee dehaay hadiidiya: “Hamashay tak gaal weer hamashay salooliini han? Baraah mhallaahna deelaay dhibi kiidiin han? <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" />Ukwiriyaataayi ukoojaayooh mhakwal kiiki. Laakiin daayiib allamamiiniibka, ukoojaayooh tꞌiiteeb iikti indi.<verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />Naanhooy tehakwa uraawiyook gwꞌadiib shanbiiba, bariiyook ugwꞌadiib itragiig ukwoolay karhita han? <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />Tari usaniyook dehaay, ‘Yaa oosan, ugwꞌadiisook tehakwa hook firꞌat yꞌani!’ kak tindiya, yaa uumshuush? Ugwꞌadiyook eefeeb ukwoolay rhaab baakaay!</para>
  <para style="p" vid="LUK 6:42">Awwal ukwoolay ugwꞌadiisook firꞌaa, malya daayiib rhitniyihoob, tehakwa usaniyook ugwꞌadii firꞌaa!” idi.<verse eid="LUK 6:42" /></para>
  <para style="s">Whindi Ufraayiisooh Itookkiin</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />Yasuuꞌa “Daayi hindi amaag firaay haay yꞌiini kiihaay. Amaag hindi aree daayi firaay haay yꞌiini kiihaay. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />Hindiibka ufiraaysooh itookkiin. Uudehay tinaweetee tiin kiimriina, tari wꞌadaarii inab kiimriin. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />Uutak udaayi, uginꞌiyooh dibiyaab ikatiyeet tudaayiinaaytii daayiina mhaliini. Uutak wꞌamaag, uginꞌiyooh dibiyaab ikatiyeet tumaagtii amaagnaayt mhaliini. Uuyaf uginꞌiib teefeet toona hadiidiini.” idi.<verse eid="LUK 6:45" /></para>
  <para style="s">Oogaw Uliilaawi Mooyiib Shagaamamaab</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />Malya Yasuuꞌa, “Naanhooy ‘Wꞌankwanaay! Wꞌankwanaay!’ tiyadnaheeb, ani ‘Sakaana!’ andiyeetookna kasaktaana? <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />Been anii dehaay yꞌeetiit aniib ibhali isnaakiir aree bareeh haay shagaamiiniib uutak, kak tꞌiiteeb ikatiyeeb, ani rhisi hookna andi. <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />Uun baruuh ootak oogaw indꞌiir tꞌiiteebi. Been baruuh hooga di ifrikaayt wꞌasaas liilaawi kehii idꞌi. Kwaan eeyanihoob, aayam been oogaw ithꞌana. Laakiin uugaw daayiib dꞌaaruuyt aayam barooh hankalsaab kiikeen. <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />Laakiin been aniib ibhali maasiwtiit, bareeh haay baashagaamay, whaashi kehii gaw asaas anu idꞌir ootak tꞌiiteebi. Uukwaan been oogaw ithꞌihoob, baruuh dhibiya aree winneet dayꞌamiya.” idi.<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">Yasuuꞌa Uroomaani daabti Shagaamana Mheeliini</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />Yasuuꞌa een ibhali kasseeh uudehay maaswee hadiidiyaayt faaysiyani harꞌii, baruuh Kafarnaahuum shuumiya. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />Dheeshi daabit Roomaani, winneet areeyi kishiya iifi. Baruuh lhiyaayt tooyat idwil. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />Uun udaabit, Yasuuꞌiib usakana imaasiwihoob, Yahuudi eegrima gwadib bariiyooh dehaay diigwatiya. Yasuuꞌa yꞌeetiit ukishiyaayooh mheeliyeet toona isehariw. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />Baraah Yasuuꞌii dehaay eeyaanihoob, barooh winneet inꞌalna, “Uun uutak sidik tushamaamtook astehaliini. <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />Baruuh udehayoon areeyiini, aree udiini gawoon idꞌir.” idiin. <verse eid="LUK 7:5" /><verse number="6" style="v" sid="LUK 7:6" />Aflaay Yasuuꞌa bareeyooh geeb giigiya.</para>
  <para style="p" vid="LUK 7:6">Baruuh ugawii sagiib kiiki. Udaabit yꞌaraweeh dehaay diigwatiyaayt, “Wꞌankwanaay, ugawu shuumtiniyeet toona kaꞌastehalanayt, ugarooyook baagallabaa! <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />Oon usabbii, ugarooyu barook haay anshiisheeb takwi hiiyyaab kaaki. Laakiin kalmaat diyaa, aree ukishiyaayu iinꞌir indi. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />Ani uknaayu hadꞌaayeeti whii eefi taku, anii whii han kajar eefeen. Oon barooh, ‘Difaa!’ andiyeek, indiif. Aree been barooh, ‘Mꞌaa!’ andiyeek, yꞌiini. Ukishiyaayu dehaay, ‘Toon sakaa!’ andiyeek, beet toona sakiini.” idi.<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />Yasuuꞌa een ibhali imaasiwihoob, bariiyooh winneet ajjabamiya. Oodehay harꞌii sakiinnaayee dehaay nakamiyaayt, baruuh “Ani andi hookna, Israaꞌiileeb han bak tꞌiiti win iimaan miraab kaaki.” idi. <verse eid="LUK 7:9" /><verse number="10" style="v" sid="LUK 7:10" />Malya aanda idiigwatamaab ugawii dehaay yꞌagarnihoob, ukishiya nꞌiraa imriin.<verse eid="LUK 7:10" /></para>
  <para style="s">Yasuuꞌa Ibraatfaatkiiti Oor Yakisiya</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />Tooyin tooraaw Yasuuꞌa Naayiin iidneet madiina ibi. Beenhoob ikwiriyaatayaahwa gwida dehaywa bariiyooh geeb giigiyaan. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />Tumadiinaati dheefa iktimihoob, aya tak atfayaykee eeya. Uun baruuh tundeetii dehaay gaalalaayu, aree batuuh ibraatfaatkiiti. Gwida dehay tumadiinaatii batiiyooh geeb iifiin. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />Wꞌankwana tutakat rhiyanihoob, batiiyooh dehaay nꞌakwmanaayaayt, “Biiwaawii!” idi.<verse eid="LUK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 7:14" />Malya baruuh suur ibaayt, tukinaaja kehii tiifiyeeb oonꞌaal shiishiya. Oonꞌaal yaksaab aanda ingadna. Yasuuꞌa “Yhaa whankwil, yakaa! Andi hook.” idi. <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />Wꞌoor wꞌaya asti isꞌa aree hadiidtiib badooya. Malya Yasuuꞌa wꞌoor toondi yhii.<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />Baraah akra mirkwaay itabniit Ukwaasana yhamidna. Baraah “Win nabi hoon lawiya. Ukwaasana udehayooh eeshtiimi jillaay yꞌaabi.” idiin. <verse eid="LUK 7:16" /><verse number="17" style="v" sid="LUK 7:17" />Uun Yasuuꞌiib usakana kastooh Yahuudaawwa, yhash oodar iifiinwa iktim.<verse eid="LUK 7:17" /></para>
  <para style="s">Yasuuꞌaawwa Yuuhannaab Umoosanaawwa</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />Yuuhannaay ikwiriyaatay teen teena kasteeh barooh sooyaan. Yuuhanna bareesooh maloob waliikiyaayt, <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />bareeh Wꞌankwana raatiini jillaay diigwatiya, “Baruuk beeb uyꞌiiniibwa han? Hana weer sꞌayaamnayeet toonaatu?” idi.<verse eid="LUK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20" />Aanda Yasuuꞌii dehaay eeyaanihoob, baraah “Yuuhanna Umoosana barook raatnayi jillaay diigwatiya hoon, ‘Baruuk uyꞌiiniibwa han, hana weer sꞌayaamnayeet toonaatu?’ idi hook.” idiin.<verse eid="LUK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21" />Beenhoob Yasuuꞌa gwida dehay lhaabwa, tilhanay iibriinwa, aajin abkaab iiktiineebwa mheeliya, aree gwida hamashaya rhisiya. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />Aflaay Yasuuꞌa Yuuhannaay idiigwatkinaayee dehaay, “Difnaat, Yuuhannaab toona turhitaaneetwa, tutimaasiwneetwa sooyaana. Yhamashaya rheena, igaaraabaya hiireereena, oobhadh ibariin eenhasna, yꞌangwilaya eemsiiwna, yꞌaya eedhhanna, usakana udaayi imiskiinaayee dehaay bhaliimiya. <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />Libaabiyaan baliin aniib eetehak baabariin.” idi.<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />Yuuhannaay idiigwatkina giigiyaani harꞌii, Yasuuꞌa oodehayii dehaay Yuuhannaayiib hadiidiya: “Umingaay tibeenihoob, naan rhitiib tehiriwna? Aggaab ubaraam nanfiyeeb rhaa miyaadiib tibeena han? <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />Bak biikaayeek, naan rhaa miyaadiib tibeena? Daawri halaka akwaay tak? Abadan, aanda alya halaka eetkwiinwa, igabaawwa, nafirnayteeb ikweerwa baliin siraayaateeb eefeen. <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />Laakiin naan rhaa miyaadiib giigtaana? Nabiib? Awooh, andi hookna, aree nabiika winkaabi. <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />Tuun batuuh uktaabiib kataabtu:</para>
  <para style="q1" vid="LUK 7:27">‘Ani udiigwatkinaayu suurook iifdig andi,</para>
  <para style="q2" vid="LUK 7:27">baruuh whankaay usalalook isuumir indi.’ diyaabi.<verse eid="LUK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 7:28" />Ani andi hookna, Yuuhannaayiika winkaab taamꞌa firaat kiikeen. Laakiin Ukwaasanaayt hadꞌaayeetiib uudiska Yuuhannaayiika winkaabi.” Yasuuꞌa idi.<verse eid="LUK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29" />Uudehay kassaah, itilbaat tamana han, een Yasuuꞌiib ibhali imaasiwnihoob, baraah Yuuhannaayiib yꞌayee atoomsaabayt, Ukwaasanaay usalal shiboot ikatiyeet toona ifidhadhna. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />Laakiin Ifariisiiwwa, whaggi koojaawwa Ukwaasana bareeh iknaayee dehaay iibriyeet tehalaagaay iribna. Yuuhannaab atoomsaab kiikeen.<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />Yasuuꞌa “Oon udamaani dehay, aab asnadiir? Kak tꞌiiteeba? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />Baraah usuugiib eestꞌi ar, aree gali eeraw waliikeen tꞌiiteeba:</para>
  <para style="q1" vid="LUK 7:32">‘Yhaana! Biilhooyt dehookna nithꞌa,</para>
  <para style="q2" vid="LUK 7:32">aree lagat tiribna.</para>
  <para style="q1" vid="LUK 7:32">Nawwaattiit kaft dehookna kafna,</para>
  <para style="q2" vid="LUK 7:32">aree waawat tiribna.’ iyadna.<verse eid="LUK 7:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="LUK 7:33" />Yuuhanna Umoosana mꞌariit tamaab baakaay, tari haab gwꞌaab baakaay eeya. Aree baraakna, ‘Oon jin hooy eefeen’ tiyadna. <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />Laakiin Wꞌaadami Oor tameewwa, gwꞌeewwa eeya, aree baraakna, ‘Uun tamana taku, haab gwꞌanaabu. Itilbaat tamanaawwa, baliib yꞌamag daawwa araweesamiini.’ tiyadna. <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />Laakiin tifagarandi kasseeh yꞌareesooh laween.” idi.<verse eid="LUK 7:35" /></para>
  <para style="s">Yasuuꞌa Takat Afooya</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />Tak Fariisi Yasuuꞌii dehaay diraariit aduuma idꞌi. Aflaay Yasuuꞌa Ufariisi gaw shuumiyaayt, tumꞌariiti tamtii dehaay isꞌa. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />Tumadiinaatiib amaagt takat tiifi. Tuun tutakat Yasuuꞌa Ufariisi gawiib mꞌariit tamiini miyaad timaasiwihoob, shakwiintiit karoora haay eeta. <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />Yasuuꞌii harꞌii iragadaayi geeb milootee tingad. Yasuuꞌiib iragada milootee mꞌasta. Malya iragada tehamooteesooh tiysis, iragada fꞌitaayt, shakwiint kehii tifif tidꞌi.<verse eid="LUK 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39" />Barooh waliikaab Ufariisi toon toona rhiyanihoob, ugarooyooh dehaay, “Uun baruuh nabiib iiktiyeek, tutakat tubarooh tatehitniit naa takat tikatiyeeb iktiin! Batuuh amaagti.” idi.<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />Yasuuꞌa bariiyooh dehaay igwibi, “Siimoon, naat iyaad hook andi.” idi.</para>
  <para style="p" vid="LUK 7:40">Siimoon “Diyaa, Seednaay!” idi.<verse eid="LUK 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41" />Yasuuꞌa bariiyooh dehaay, “Dikwkwaani kina iifi. Baruuh malu da deen iishik. Oongaalnaay geeb ay shi diinaar iibri, ooraawi geeb ay tamuun diinaar iibri. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />Laakiin baraah barooh haay ikwiisni mhallaga gaal han kiibari. Aflaay baruuh mhallee oodeen afooya. Oontꞌa een bareesooh naayuuh barooh winneet areeyiinikaabu?” idi.<verse eid="LUK 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43" />Siimoon igwibi, “Uutak tooslif tugwidakaat afoomiyaab winneet areeyiinikaab hiisani.” idi.</para>
  <para style="p" vid="LUK 7:43">Yasuuꞌa “Tikana.” idi.<verse eid="LUK 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44" />Malya Yasuuꞌa tutakatii dehaay nakamiyaayt, Siimoonii dehaay, “Toon tootakat rhitniya? Ani ugawook shuuman, baruuk yam iragadaayi haay iishigwidheeb han hiiyyaayu kitta. Laakiin batuuh timilooteesooh iragadaayi mꞌastaayt, tehamooteesooh tiysis. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />Baruuk aneeb gaalhoob han hoosu fꞌaab kitta. Laakiin tuun tutakat, oogaw shuumaneekka masi aniib iragadaayi fꞌatii door han gadaat kitti. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />Baruuk ugirmaayu dehaay saliit han dꞌiyaab kitta. Laakiin batuuh aniib iragadaayi kehii shakwiint tifif tidꞌi. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />Shaawti andi hook, batiituuh tuumaag tugwidaat afoomta, oon usabbii batuuh winneet areeta. Laakiin been shalikna afoomiiniib shalikna areeyiini.” idi.<verse eid="LUK 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48" />Malya Yasuuꞌa tutakatii dehaay, “Tumaagnaaytuuk afoomaati.” idi.<verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />Oomhiin iifiin yꞌamna aaraw taktakee dehaay, “Uun aabuuyt, tumaagnaay afooyiini?” idiin.<verse eid="LUK 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50" />Yasuuꞌa tutakatii dehaay, “Wꞌiimaanuuk ishidhhan hooki. Asgaa giigii!” idi.<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s">Iteeraay Mitaal</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />Beenaay harꞌii, Yasuuꞌa madiinaatwa gariyaatwa gaanaatii weet beeti iibaabiya. Oodehayii dehaay Ukwaasanaayt hadꞌaayeeti sakana udaayiib hadiidi. Ikwiriyaatay itamna malu bariiyooh geeb iifiin. <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />Aree mꞌat galit Yasuuꞌa jineewwa, lhanayteewwa mheelaab iiktiyeet han geeb iifiin. Taan bataah: Maryam Majdaleenaab iidneet suur Yasuuꞌa asarama jin hooy firꞌaab iiktiyeetwa, <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />Khuusaab, Heeroodisiib uwakiiliit takat Yoowannaatwa, Soosannaatwa, gwidaat waritwa iiktiin. Taan taamꞌa umaaliisoohna bareeh iishtamna.<verse eid="LUK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />Winneet gwida dehay gwidaat madiinaatee eeyaaniit immarraayna. Aree uudehay madiinaat madiinaatii Yasuuꞌii dehaay yꞌiina, baruuh een eemtaal hadiidiya: <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" />“Dirꞌaateega teeraayooh yꞌiidi jillaay ifirꞌa. Baruuh iteeraayooh iigideet midda, teera gwadi salaliib dhibiya. Baruuh eetamiya, aree aakilay eeyaaniit iteera aamiyaani idꞌiin. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />Weer teera liilaawi kehii dhibiya, been iteera fuutiitiyanihoob, yadhꞌuuyti naawii balamiya. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />Weer teera naweeti hooyteeb dhibiya. Laakiin tinawi geeb yakiyaaniit iskitni idirna. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />Weer teera aree daayi haashiib dhibiyaayt, yakiya. Harroob haay eeya, iteeraayka sheeb hadiit gwidaka firaay haay eeya.” idi.</para>
  <para style="p" vid="LUK 8:8">Yasuuꞌa een iidihoob, baruuh waliikiya, “Eemsiiw angwil ibariib been baꞌiimsaw.” idi.<verse eid="LUK 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />Ikwiriyaatayaah een eemtaal naan haay isehariiweeb barooh raatiyaan. <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />Yasuuꞌa “Baraakna Ukwaasanaayt tehadꞌaayeetiit tikwabasnay attiyeewiyaabaana. Laakiin eeraw mitaalee sooyani, aflaay</para>
  <para style="q1" vid="LUK 8:10">Aan baraah shibbee karhiyaana,</para>
  <para style="q2" vid="LUK 8:10">maaswee kaꞌafhamiyaan.<verse eid="LUK 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />Aan aamtaal oontꞌaaneet eefeen: Iteera Ukwaasanaay ibhaliiya. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />Iteera usalaliib dhibiyaab, baliin een ibhali eemsiiwna, aree malya uubliis dehaay yꞌiit ibhali iginꞌaayeesooh tafiiniyeeb oodehay ikati. Aflaay baraah aamaniit biidhhanni jillaay ibhali iginꞌaayeesooh tafiini. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />Iteera uliilaawi kehii dhibiyaab, baliin een ibhali eemsiiwnihoob afirhaa agbileena, laakiin gadam kiibariin. Baraah shalikt midda aamaneena, laakiin ijarrabamti door baraah fidnaab yakeen. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />Iteera tinaweeti bitik dhibiyaab, baliin een ibhali eemsiiwna, laakiin usalaliyoohna sakeeneet midda, udamaani gwirhaawwa, uumraaywa, tuduniyaatiit nafirnaywa bareeh isakitna. Aree baraah bashikw firaay haay kaꞌeeyaan. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />Laakiin iteera whaash udaayiinaay dhibiyaab, baliin een ibhali eemsiiwna aree daayi ginꞌa takwakwnaayeeb ideebna. Aan baraah amtaraamiit gwida firaay haay yꞌeen.” idi.<verse eid="LUK 8:15" /></para>
  <para style="s">Tulambaati Mitaal</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />Malya Yasuuꞌa, “Lambaat shidhhaniit, karooraati hooyteeb kwanbiis, tari nꞌaali whii daasiini gaal han kiihaay. Laakiin oogaw shuumeen uudehay oonuur rheeni jillaay tageega mhiin daasiini. <verse eid="LUK 8:16" /><verse number="17" style="v" sid="LUK 8:17" />Dhꞌimaana lawi baadiit naat han daayi kitdi. Aree kwabaasna ituukkin baadiit tari rhami baadiina han daayi kitdi. <verse eid="LUK 8:17" /><verse number="18" style="v" sid="LUK 8:18" />Shaawti een ibhali kak teemsiiwneeb daayiib gwꞌadna. Naat ibariibka gwidakaana ittiyiw indi, laakiin naat baabariibka beet ibariyeeb hiisiiniyeet tuuna han hooy giigi tindi.” idi.<verse eid="LUK 8:18" /></para>
  <para style="s">Yasuuꞌiit Toondeewwa Isanaawwa</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />Oontꞌa Yasuuꞌiit tuundeewwa isanaawwa barooh rhiini jillaay eeyaan. Laakiin dehayiit guudti sabbii bariiyooh ikatama adgiraab kiikeen. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />Gaal bariiyooh dehaay, “Deetuukwa isanaayaakwa barraab ingadiin, eerheek yhariwna.” idi.<verse eid="LUK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21" />Yasuuꞌa “Deetuuwwa aniib isanaawwa, baliib Ukwaasanaay ibhali sinaakirtiit haay shagaameen ikatiin.” idi.<verse eid="LUK 8:21" /></para>
  <para style="s">Yasuuꞌa Ubaraam Isingad</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />Yint gaat Yasuuꞌa ikwiriyaatayeeh dehaay, “Yakaana, ubhari dar ooraaw niibi!” idi. Aflaay baraah falluukaat yꞌamniit hantaayaan. <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />Baraah ubhariib iibaabee, Yasuuꞌa diwiya. Ubhariib gaalhoob akra baraam eeya. Tufalluuka yam titab, aree baraah akra bidhꞌiib daayaan.<verse eid="LUK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 8:24" />Ikwiriyaatay giigiyaaniit barooh isibꞌarna. Baraah “Seedna! Seedna! Aayam miyaayoon yhariwna.” idiin.</para>
  <para style="p" vid="LUK 8:24">Yasuuꞌa yakiyaayt ubaraamwa, eeyam yꞌitrigiswa idnin. Ubaraam ingad aree naatka hayaayta. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />Malya Yasuuꞌa ikwiriyaatayeeh raatiya, “Wꞌiimaanuukna keeya?” idi.</para>
  <para style="p" vid="LUK 8:25">Ikwiriyaatay winneet irkwiiniit ajjabamiyaan. Baraah gaal ooraaw raatiyaana, “Uun aabu? Ubaraamwa eeyamwa danniin, aree baraah barooh isnaakirna.” idiin.<verse eid="LUK 8:25" /></para>
  <para style="s">Yasuuꞌa Jin Abkaab Iiktiini Tak Mheeliya</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />Jaraasiin iidni haash Jaliili fiireeb eefeeb iyami dar ooraaw iktimna. <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />Yasuuꞌa tufalluukaatii tikwiyanihoob, tumadiinaatii tak jin abkaab iiktiini imꞌashaash. Uun uutak gwida daman halakaab akwaay kiiki, tari gawiib kwiraab kiiki. Laakiin imiimashaayi bitik ikwiir. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />Uutak Yasuuꞌaab rhiyanihoob, bariiyooh suurii dhaabiyaayt, winneet win hissii waliikiya, “Yasuuꞌa Ukwaasana Winneet Utageegaay Oor, naan hoosu harriiwa? Winneet atꞌajiir hook, baajasaayaheeb.” idi. <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />Yasuuꞌa ootakii itfarꞌaneet toona eejin sooyaabu. Aajin ootak gwida doora abkaaba. Aree barooh yꞌayeewwa iragadaawwa shinshilaatee imhakwaarna aree itigwꞌideek han, baruuh tishinshila katꞌi. Aree aajin barooh umingaay beeti salooliin.<verse eid="LUK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30" />Yasuuꞌa ootak raatiya, “Oosmook aab iyadna?” idi.</para>
  <para style="p" vid="LUK 8:30">Utakiib gwida jin shuumaabayt, baruuh “Oosmu ‘Gwidaab’ iyadnaheeb.” idi. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />Aan aajin Yasuuꞌaab doorka irmidniit inꞌalna, oodi shuumaana biidiyeet toona hooy yhariwna.<verse eid="LUK 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32" />Beentooy oorbaay kehii ikwiir gwida khansireet dirimt iifiin. Aajin ikhansireeb shuumiini jillaay wꞌidin iniiweet toona Yasuuꞌiib winneet yhariwna. Aree Yasuuꞌa bareeh wꞌidin yhii. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />Aajin ootakii ifirꞌanihoob, ikhansireeb shuumiyaan. Aree ikhansireet dirimt igidiyeesooh dhaabiyaaniit, oorbaay shidhꞌaayii igidehana aree whoodhiib tikwiyaaniit bareeh aayam iyheen.<verse eid="LUK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34" />Ikhansireega beet toona tutikeet rhiyaanihoob, willa tumadiinaawwa tidirꞌaawwa beeti dhaabiyaaniit usakana hadiidiyaan. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />Uudehay kassaah beet toona tutikeet rhiini jillaay ifirꞌana. Baraah Yasuuꞌii dehaay eeyaanihoob, ootak aajin hooy giigaa, Yasuuꞌiib iragadaayi geeb sꞌee, akwaay akay whaaluuh shibooba imriin. Aree baraah winneet irkwiin. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />Beet toona rhaa iifiin baliin, ootak aajin abkaab iiktiineeb kak inꞌireet toona oodehay sooyaan. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />Malya Jaraasiineeb whaashi dehay kassaah winneet mirkwaay hooy daayaabuuyt, baraah Yasuuꞌa hooy giigiyeet toona raatiyaan. Aflaay Yasuuꞌa tufalluuka yꞌamaayt giigiya.<verse eid="LUK 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 8:38" />Aajin hooy farꞌa iiktiineeb uutak Yasuuꞌiib winneet yhariw, “Geebook giigsaaheeb.” idi. Laakiin Yasuuꞌa iribaayt, bariiyooh dehaay, <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />“Ugawook beeti agara! Ukwaasana dehook sakiyaneet toona hadiida!” idi. Aflaay uutak Yasuuꞌa dehaay idꞌiyeet toona kastooh tumadiinaatii dehaay hadiidiya.<verse eid="LUK 8:39" /></para>
  <para style="s">Ayaat Ootwa Lhaat Takatwa</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />Oontꞌa Yasuuꞌa yꞌagarihoob, gwida dehay bariiyooh wꞌaay yhigitnayt, baraah barooh daayiib yꞌashishna. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />Malya Yaayiirus iidni tak Iyahuudi diini gawi suurkina eeya. Baruuh eeyaayt Yasuuꞌiib iragada suurii dhibiya, aree bariiyooh oogaw geeb iibiyeet toona winneet hooy yhariw. <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />Baruuh tamna malu hawla tiibriit gaalalaayt ootuuh amshaat tiifi.</para>
  <para style="p" vid="LUK 8:42">Yasuuꞌa usalaliib sakiyeet midda, uudehay igwida bariiyooh kehii tuusamiyaan. <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />Aree beentooy takat lhaat, tamna malu hawlaayeeka booy tiitfaf tiifi. Tuun batuuh kasseeh imhallagaayeeh hakiimaayi mheeliib giigsaati. Laakiin gaal han adgiraa batooh sinꞌiraab kiiki. <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />Tutakat Yasuuꞌi harꞌiisii eetaayt, bariiyooh whalakiit shinki tehita. Igidiyeesooh uubooy hooy ingad.<verse eid="LUK 8:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45" />Yasuuꞌa raatiya, “Aaw tehiyaheeb?” idi. Tak fidhadhat iribhoob, Bitrus “Seednaay, uudehay kwalaleeka aree hook tuusameen.” idi.<verse eid="LUK 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46" />Laakiin Yasuuꞌa, “Aadami gaal tehiyaheeb, yꞌakrir hoosu ifirꞌaneet toona hissiyan.” idi.<verse eid="LUK 8:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 8:47" />Malya tutakat tunaatuuh lawtaneet toona tikanihoob, idhee eetaayt, Yasuuꞌii suurii dhibta. Kassooh oodehayi suurii Yasuuꞌaab tehitaneet toona hadiidta. Aree kak igidiyeesooh tinꞌireet toona han hadiidta. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />Malya Yasuuꞌa tootakatii dehaay, “Yaa tꞌoorii, wꞌiimaanuuk mheeliya hooki, asgaa giigii!” idi.<verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />Yasuuꞌa masi bhaliiyee, Yaayiirus, Iyahuudi diini gawi suurkina iiktiinaay ugawii gaal eeya. Baruuh “Tꞌootuuk tiya. Seednaab shaawti baagallabaa!” idi.<verse eid="LUK 8:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50" />Yasuuꞌa een ibhali imaasiwihoob, Yaayiirusii dehaay, “Baarakwiya, aamana nuun! Tꞌootuuk iinꞌir tindi.” idi.<verse eid="LUK 8:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51" />Yasuuꞌa Yaayiirusiib oogaw iktimihoob, baruuh Bitruswa, Yuuhannaawwa, Yaaguubwa, tꞌooti baabaawwa, tꞌootiit deewwa nuun, gaal han geebooh shuumsaab kiiki. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />Beenhoob kassuuh uudehay tꞌoor waawiina aree nawwaatiin. Yasuuꞌa “Baawaawaana! Tꞌoor ayaat kitti, laakiin diwtini.” idi.<verse eid="LUK 8:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53" />Baraah bariiyooh ifaayidna. Tꞌoor ayaat tiiktiyeet toona kanaa iifiin. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />Laakiin Yasuuꞌa tꞌooti wꞌayi yꞌabikaayt “Tꞌootuunay, yakii!” idi. <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />Tꞌoor ishuukaah dehaay yꞌagarna, igidiyeesooh yakta. Malya Yasuuꞌa batooh naat mꞌariit iyawneet toona bareeh sooya. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />Tꞌooti faru winneet ajjabamiyaan. Laakiin Yasuuꞌa beet toona tutikeet gaal han biisooyayneet toona bareeh sooya.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">Yasuuꞌa Itamna Malu Diigwatiya</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />Yasuuꞌa itamna malu hiddaab waliikiyanihoob, bareeh kasseeh eejin haay iifarꞌaneetwa tilhanay haay mheeliini akrirwa hadꞌaayeetwa yhii. <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />Malya Ukwaasanaayt tehadꞌaayi sooyiini jillaaywa, eelhaab mheeliini jillaaywa bareeh diigwatiya. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />Yasuuꞌa bareeyooh dehaay, “Tꞌiibaabtii dehaay naat han baayaksaana! Kwoolay baayaksaana! Shantaat baayaksaana! Hadhiib baayaksaana! Mhallagaab baayaksaana! Halakaayeet shawaayt baayaksaana! <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />Beet tumadiinaatii giigteeneeb ookiik shuumteeni gawiibka fiinaana. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />Uudehay bareekna eeribneek, bareetooh tumadiinaatii giigteenihoob, iragadaayeesookna ifalfuut nifishna. Beet tuuna bareeyooh kehii badehaat tikati.” idi. <verse eid="LUK 9:5" /><verse number="6" style="v" sid="LUK 9:6" />Aflaay ikwiriyaatay gariyaat gaanaatii weet beeti ibeen. Usakana udaayiib oodehay sooyiina aree kasseeh imhiinan oodehay mheeliin.<verse eid="LUK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />Oontꞌa Heeroodis whaakim toona tutikeet kastooh imaasiw. Aree baruuh naat igam. Dehay gali, “Yuuhanna tuyatii yakiya.” iidna, <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />wari, “Unabi Eelya lawaab ikati.” iidna. Wari masi, “Inabiya ishꞌiiyaayee gaal tuyatii idhhan.” iidna. <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />Laakiin Heeroodis, “Yuuhannaab ani tꞌala akitꞌa, teen teena hooy eemsiiweeb uun aabu?” idi. Aree winneet bariiyooh irhiti yhariw.<verse eid="LUK 9:9" /></para>
  <para style="s">Yasuuꞌa Yꞌay Alfa Tamisiya</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />Ilinguumiya yꞌagarnihoob, toona tꞌidꞌiineet Yasuuꞌaab sooyaan. Malya baruuh bareeh geebooh iyhi. Aree baraah aakna “Beetsaydaab” iidneet madiina beeti giigiyaan. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />Laakiin uudehay beet toona ikannihoob, barooh iramna. Baruuh bareeh yꞌashish aree Ukwaasanaayt tehadꞌaayeetiib dehaay hadiidiya. Baliib oomheel yhiriw han mheeliya.<verse eid="LUK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12" />Tehimni tidwilihoob, itamna malu Yasuuꞌii dehaay eeyaaniit, “Hinin mingaayama mhiiniib neefi akay, oodehay igwidaab mꞌariitwa fiinaniiti mhiinwa imeerni jillaay tigariya yhadabeeb eefeentwa tidirꞌaawwa beeti giigsa.” idiin.<verse eid="LUK 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13" />Yasuuꞌa bareeyooh dehaay, “Baraakna bareeh tameeneet mꞌari hiina.” idi.</para>
  <para style="p" vid="LUK 9:13">Baraah igwibiina, “Ay hadhiiwwa, malu aashoowwa eebhat nibari. Oosuug dehaay giigiit, kassooh oodehayii dehaay mꞌariit niidlib bindiyeek!” idiin. <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />Been oomhiin ay alfa da iifiin.</para>
  <para style="p" vid="LUK 9:14">Laakiin Yasuuꞌa ikwiriyaatayeeh dehaay, “Oodehay ay tamuun yꞌeen jamꞌaabka kwaasnaat soosꞌana.” idi. <verse eid="LUK 9:14" /><verse number="15" style="v" sid="LUK 9:15" />Ikwiriyaatay beet toona sakiyaana, aree kasseeh isoosꞌana. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />Yasuuꞌa yhadhi yꞌaywa, yꞌaashu imaloowwa yakisiyaayt teebri ishbib. Yhadhi baarakiyaayt irfit. Malya bareeh ikwiriyaatay yhiit, oodehayii dehaay suurseeneet toona isehariw. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />Kassaah uudehay hooy tamiyaaniit gabiyaan. Malya ikwiriyaatay ugaafii tamna malu biili itibniit yakisiyaan.<verse eid="LUK 9:17" /></para>
  <para style="s">Uun Nabiika Winkaabu</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />Yasuuꞌa oodꞌooh siileeliyihoob, ikwiriyaatay bariiyooh geeb iifiin. Yasuuꞌa bareeh raatiya, “Uudehay aniib naan hadiideen?” idi.<verse eid="LUK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19" />Ikwiriyaatay igwibiina, “Uudehay gwadi, Yuuhannaab Umoosana iyadna hook. Wari Eelyaab iyadna hook. Masi wari, inabiya ishꞌiiyaayee gaal tuyatii dhhanaab ikati iyadna hook.” idiin.<verse eid="LUK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20" />Yasuuꞌa raatiya, “Baraakna aree kak tiyadna? Ani aabu tiyadna?” idi.</para>
  <para style="p" vid="LUK 9:20">Bitrus igwibi, “Baruuk Ukwaasanaay Umasiihwa.” idi.<verse eid="LUK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />Yasuuꞌa bareeh toon batooh gaal han biisooyayneet toona hooy yhariw.<verse eid="LUK 9:21" /></para>
  <para style="s">Yasuuꞌa Tuyatooh Hooy Hadiidiya</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 9:22" />Yasuuꞌa “Wꞌaadami Oor ibakii winneet gwidaana lhamiini. Aree ibakii yꞌeegrimaawwa, ifagiiriya isuurkinaawwa, whaggi koojaawwa barooh eeribna. Baruuh ibakii itoodiir, aree tooyin tumhaya dhhantiit yakiini.” idi.<verse eid="LUK 9:22" /></para>
  <para style="s">Yasuuꞌiit Toormaam</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23" />Malya Yasuuꞌa kassooh oodehayii dehaay, “Gaal aniit toormaam harriiweek, baruuh ibakii ugarooyooh ankiriini aree bꞌeebka usaliibooh yaksiini, malya eetriimheeb. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />Umidhhanooh dibuuy harriiwka, barooh itehisir indi. Laakiin anii jillaay unfisooh itehasiirka, barooh idaab indi. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />Wꞌaadami tuduniya kastooh marriyeek, laakiin unfisooh itehasiireek tari kwidhsiiniyeek naan rayiimiini? <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />Gaal aneebwa ibhaliyeesoowwa sankwꞌeek, Wꞌaadami Oor han umatuuniyoohwa Ubaabaay matuuniibwa, imalak imugaddasaayi matuuniibwa yꞌeeniyihoob, been bariisooh iisikwꞌa indi. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />Oosdik andi hookna, een tooy ingadiin oodehayii gali, Ukwaasanaayt tehadꞌaayi rheeneeb ookiik iiyyi kiidiin.” idi.<verse eid="LUK 9:27" /></para>
  <para style="s">Yasuuꞌiib Umatuun</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />Yasuuꞌa een hadiidiyaayt harꞌii asimhayt yina eetiit middaatiib, baruuh Bitruswa, Yuuhannaawwa, Yaaguubwa iyhaayt, siileeliyee dehaay oorba reewiya. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />Siileelee ifiiraah weet hayꞌa ikeen. Yhalakaayaah utalaw tꞌiiteeb eeraab ikeen. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />Laakiin Yasuuꞌaab malu da infiridna. Aan baraah Muusaabwa Eelyaawwa iiktiin. <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />Baraah daawriit hayꞌaatii lawiyaan. Yasuuꞌi geeb hadiidiyaan. Baraah bariituuh tooyat Alguduseeb iikti tiidnaatiib hadiidiyaan. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />Bitruswa yꞌarawaahwa akraat nꞌari hooy daata. Laakiin baraah daayiib ibꞌarnihoob, Yasuuꞌiib umatuunwa bariiyooh geeb ingid eenda imaloowwa rhiyaan. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />Aan aanda imalu Yasuuꞌii giigiineeb oodoor, Bitrus bariiyooh dehaay, “Seednaay! Oon oomhiin daanayeet tuuna daayiit kitti han? Mhay alleeka niidꞌir, gaal bariiyook dehaay, gaal Muusaay dehaay, gaal Eelyaay dehaay.” idi. (Baruuh naan hadiidiyeeb kiikan.)<verse eid="LUK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34" />Baruuh bhaliiyee, bꞌaluuk eeyaayt bareeh kasseeh ikwibis. Ikwiriyaatay ibꞌaluuk bareeh ikwibisi door irkwiin. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />Ibꞌaluukii hiss eeya, “Uun baruuh wꞌooru ani waasaab akatiyeebu, barooh sinaakirna!” idi. <verse eid="LUK 9:35" /><verse number="36" style="v" sid="LUK 9:36" />Uun whiss hadiidiyanihoob, ikwiriyaatay Yasuuꞌaab oodꞌooh haayee imriin. Ikwiriyaatay beet toona aakna ikwibisna. Beenhoob beet toona turihiyaaneet gaal han sooyaab kiikeen.<verse eid="LUK 9:36" /></para>
  <para style="s">Yasuuꞌa Oorii Jin Mhaliya</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />Oombꞌi ooraaw baraah oorbaay igidehanihoob, gwida dehay barooh yꞌashishna. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />Oodehayii tak gaal waliikiyaayt, “Seednaay! Winneet hook aharriiw, uun baruuh gaalꞌoor aniibu. Barooh shibiba! <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />Barooh jin hooy shuumaaba, aree baruuh gaalhoob aadhiini. Uuyaf hibibt eettiibeeb hadiit aajin barooh iragisna. Door han barooh baalhasi kiiꞌish. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />Ikwiriyaatayeek eejin ifirꞌaneet toona anꞌal, laakiin baraah adgiraab kiikeen.” idi.<verse eid="LUK 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41" />Yasuuꞌa “Yaa uutaas wꞌiimaan baabariin yꞌamag, ani naa door hadiit geebookna daayani? Naa door hadiit dehookna asbirani? Yhaa! Wꞌoorook tooy haay mꞌaa!” idi.<verse eid="LUK 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42" />Been oodoor wꞌoor yꞌee, aajin barooh whaashi kehii dhibisiyaaniit irgisna. Laakiin Yasuuꞌa eejin idnin, wꞌoor isinꞌiraayt ubaaba yhii. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />Kassaah uudehay Ukwaasanaay yꞌakrireeb winneet ajjabamiin.</para>
  <para style="p" vid="LUK 9:43">Uudehay Yasuuꞌa sakiyeet kasteeh tinaateeb ajjabamee, Yasuuꞌa ikwiriyaatayeeh dehaay, <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />“Ani andiyeetookna toona daayiib sinaakirna: Wꞌaadami Oor dehayi ayeeb nuunami indi.” idi. <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />Laakiin ikwiriyaatay tuuna naan tiiktiyeeb afhamaab kiikeen. Tuun batuuh bareesooh kwabaastu, aflaay beet toona baraah afhamaab kiikeen. Aree beet batooh barooh raatiineet toona irkwiin.<verse eid="LUK 9:45" /></para>
  <para style="s">Aaw Winkaabu?</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />Ikwiriyaatay bareesooh aaw winkaab iiktiyeeb imgwassaarna. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />Yasuuꞌa baraah iikwinneet toona iktiin. Dabalu oor udaraagooh isingad. <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />Malya baruuh bareeyooh dehaay, “Oon wꞌoor aniib oosmii agbiliiniib, aneeb han agbiliiniheeb. Aneeb agbiliiniib, aneeb diigwatiyaab han agbiliini. Oon usabbii, bareesookna uudiskaab hookna oowinkaabi.” idi.<verse eid="LUK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />Yuuhanna Yasuuꞌii dehaay, “Seednaay! Oosmiisook eejin iifirꞌa tak rhina. Laakiin baruuh hinee gaal kiikuuyt barooh nhabi.” idi.<verse eid="LUK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50" />Yasuuꞌa bareeyooh dehaay, “Barooh baahabiina! Bareekna baamoomiigka geebookna daayiini.” idi.<verse eid="LUK 9:50" /></para>
  <para style="s">Isaamri Yasuuꞌaab iribna</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />Baruuh teebri beeti hooy yakamiyeeb uudoor idwileet midda, Yasuuꞌa Algudus beeti giig niyaamiya. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />Yasuuꞌa gaw hooy naayyeeb dehaay isuumirni jillaay Saamiri dhiweet gariya beeti suurooh diigwatkinaab iifdig. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />Laakiin baruuh Algudus marii giigiyi sabbii, beentooy uudehay barooh ashshaab kiikeen. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />Ikwiriyaatay Yaaguubwa Yuuhannaawwa toon toona rhiyaanihoob, “Wꞌankwanaay! Bareeh kwidhsiti jillaay Ukwaasana tibreetee nꞌeet nꞌati fandiigeet toona raattiib hoon harriiwa han?” idiin. <verse eid="LUK 9:54" /><verse number="55" style="v" sid="LUK 9:55" />Laakiin Yasuuꞌa bareeyooh nakamiyaayt idaanin, <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />aree baruuh, “Wꞌaadami Oor oodehay danbiyee dehaay yꞌaabu nuun, oodehay kwidhsiiniyee dehaay yꞌaab kiiki.” idi. Malya baraah weet gariya beeti giigiyaan.<verse eid="LUK 9:56" /></para>
  <para style="s">Yasuuꞌiit Tꞌamoormooyti Taman</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />Baraah masi usalaliib sakee, tak gaal Yasuuꞌii dehaay, “Yaa Wꞌankwanaay! Teebiyi mhiinka beeti iitram hook andi.” idi.<verse eid="LUK 9:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58" />Yasuuꞌa igwibi, “Tibꞌashu deeb ibariina, aakilay tibreeteeb dhaabeen gawaab ibariin. Laakiin Wꞌaadami Oor ugirmaayooh hooy shuumsiiniyi mhiin kiibari.” idi.<verse eid="LUK 9:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59" />Yasuuꞌa tak weernaay dehaay, “Ramaheeb!” idi.</para>
  <para style="p" vid="LUK 9:59">Uutak Yasuuꞌii dehaay, “Wꞌankwanaay! Hankaab baabu anbiisee dehaay giigsaaheeb.” idi.<verse eid="LUK 9:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60" />Laakiin Yasuuꞌa bariiyooh dehaay, “Yꞌaya udehayoohna yꞌayaab aakna baꞌiibisna. Laakiin baruuk giigaat Ukwaasanaayt tehadꞌaayi oodehay sooyaa!” idi.<verse eid="LUK 9:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61" />Tak weer han Yasuuꞌii dehaay, “Wꞌankwanaay! Ani iitram hook andi. Laakiin ani dhiwaayi salaamiib diyat yꞌani.” idi.<verse eid="LUK 9:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62" />Yasuuꞌa “Wꞌayooh aduuyiib daasiit, harꞌa shanbiib uutak Ukwaasanaayt tehadꞌaayeeti shagaamtiib takweet kiibari.” idi.<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s">Yasuuꞌa Asarama Tamuunwa Malu Da Diigwatiini</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />Beenaay harꞌii Wꞌankwana asarama tamuunwa malu daawwa warib yhayid, maloob maloob ikwaasiit diigwatiya. Kasteeh baruuh iibi iideet timadiinaawwa imhiinanwa beeti suurooh diigwatiya. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />Yasuuꞌa bareeyooh dehaay, “Uuwaak gwidaabu, laakiin ishagaamana shalika. Toon toonaatii dehaay uwaaki Ankwana raataana, uwaakiit dirꞌaatooh shagaamanaab dehaay diigwatiiniyeet toona raataana. <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />Difna! Ikarayi bitik fadag yhooyeet afandiig hookna. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />Shantaat baayaksaana! Kiis baayaksaana! Gidhꞌaat baayaksaana! Aree usalaliib tak gaal han baashoobaana!<verse eid="LUK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 10:5" />Gaw shuumteenihoob, hankaab ‘Oon oogaw umꞌasig geeb badaayi.’ diina! <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />Umꞌasig areeyiini tak beentooy timeerneek, umꞌasguukna bariiyooh kehii daayiini. Bak biikaayeek, umꞌasguukna dehookna itꞌigir indi. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />Been ugawiib fiinaana! Baraah iyawneetookna toona tamaana aree gwꞌaana. Tꞌibariineetii hooy tamteena gwꞌiteena! Ushagaamana ukiraayooh astehaliini. Gaw gaalnaay weer beeti baahantaayaana!<verse eid="LUK 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 10:8" />Madiinaat shuumteenihoob, uudehay bareekna agbileeneek, toona suurookna daasamtiniit tamaana! <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />Oodehay eelhaab beentooy eefeen mheelaana aree bareeh sooyaana, ‘Ukwaasanaayt tehadꞌaayi dawiltooknaati.’ diina! <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" />Laakiin madiinaat shuumteenihoob, uudehay bareekna biiꞌagbilayneek, isalalaayeeb firꞌanaat, <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" />‘Tumadiinaatiyookna falfuut hineet tigidhꞌaateeb eefeeb han kehookna nifarꞌa. Laakiin baraakna Ukwaasanaayt tehadꞌaayi dawiltookna tikatiyeet toona kanna!’ diina! <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" />Oontꞌa andi hookna, whukwimiit tooyin Ukwaasana beet tumadiinaatiika Sadoom arhamiinikaab iikti tindi.” Yasuuꞌa idi.<verse eid="LUK 10:12" /></para>
  <para style="s">Tidhikwna!</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />Malyaab Yasuuꞌa “Tidhikwii yaa Koorasiin! Tidhikwii yaa Beetsayda! Bateeyookna ikeent timꞌuujisa, Tiirooswa Siidooneebwa akaat iiktiineek, udehayuuhna shꞌiika tuubiina. Baraah shiwaali halak iitkwiina aree igirmaayeehna kehii nꞌeetihaash geediin. <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />Whukwimiit tooyin, Ukwaasana bateesookka Tiirooswa Siidooneeb oodehay arhamiinikaab iikti indi. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />Aree batuuk Kafarnaahuum! Teebri beeti yakami tindii? Abadan, batuuk eedhoom beeti hoogi tindii.” idi.<verse eid="LUK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16" />Yasuuꞌa ikwiriyaatayeeh dehaay, “Bareeyeekna ibhali eemsiiw been, aniib ibhali han eemsiiw. Bareeyeekna ibhali baamaasiiw been, aniib ibhali han kiimaasiw. Aniib ibhali baamaasiiw uutak, aneeb diigwataanaay ibhali han kiimaasiw.” idi.<verse eid="LUK 10:16" /></para>
  <para style="s">Yꞌasarama Tamuunwa Imalooyeet Timꞌageer</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />Idiigwatkina yꞌasarama tamuunwa imalu afirhaa yꞌagarniit, “Wꞌankwanaay! Bariiyook oosmii aajin han isnaakirna hoon.” idiin.<verse eid="LUK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18" />Yasuuꞌa igwibi, “Oobliis tibreetee utalawiit dhibee rhan. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />Ikwakwaraawwa italꞌanooyaawwa haay eetteeni akrir ahii hookna, masi kasseeh yꞌashu haay tigaribneeb yꞌakrir ahii hookna. Naat han adaayi hookna kitdi. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />Aajin isnaakirna hooknayt baaꞌafirhaana. Laakiin ismaayaakna tibreeteeb katabayt afirhaana!” idi.<verse eid="LUK 10:20" /></para>
  <para style="s">Yasuuꞌa Afirhiya</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />Been oodoor Aashuuk Imugaddasa Yasuuꞌaab firhaat itibna. Yasuuꞌa “Baruuk teen teena ifagarandeewwa yꞌagriyaaneewwa tikwibisaayt, yꞌar idabalooyaayee dehaay lawsita akay, ahammiid hook, yaa Baaba, toobuutwa tibreeti Wꞌankwana.<verse eid="LUK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22" />Baabu naatka yhiiheeb. Wꞌoor aab ikatiyeeb ubaaba nuun gaal han kiikan. Ubaaba aree aab ikatiyeeb wꞌoor nuun gaal han kiikan. Laakiin wꞌoor ubaaba aab ikatiyeeb eeraw sootiib harriiw, aflaay baraah barooh iikan iyadna.” idi Yasuuꞌa.<verse eid="LUK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23" />Yasuuꞌa ikwiriyaatayeeh dehaay nakamiyaayt tarootsamiya, “Baraakna rhiteeneet toona rheen tiliili baliit libaabiyaan. <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />Andi hookna, gwida nabiyaawwa gwida hadꞌaawwa beet baraakna rhiteeneet toona rhitiib yhariwna. Laakiin beet batooh rhaab kiikeen. Baraakna timaasiwneet toona iimsawneet yhariwna. Laakiin maaswaab kiikeen.” idi.<verse eid="LUK 10:24" /></para>
  <para style="s">Usaamri Udaayiinaay Mitaal</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />Muusaay whaggi kooja gaal yakiyaayt, Yasuuꞌa naan indiyeeb iishbibee dehaay gaana raatiya. Baruuh “Seednaay! Umidhhan udaayim kwasaamaniyee dehaay ibakii naan adanꞌi?” idi.<verse eid="LUK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26" />Yasuuꞌa bariiyooh dehaay, “Ooktaabiib naan kataabtu? Baruuk aree een bareeh kak afhamtaa?” idi.<verse eid="LUK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27" />Uutak igwibi, “Uuktaab ‘Wꞌankwana Ukwaasanaayook kassooh uginꞌiisookwa, kassooh unfisiisookwa, kassooh utaadiisookwa, kassooh ugirmaayiisookwa areeya. Aree ushawwook ugarooyiitook areeya.’ indi.” idi.<verse eid="LUK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28" />Yasuuꞌa ootakii dehaay, “Daayiib tigwibiya, teen teena sakaa! Aree ikwaar tindiya.” idi.<verse eid="LUK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29" />Laakiin uutak baruuh hooy hadiidiyeet toona akteen miyaadiib, aflaay baruuh Yasuuꞌaab raatiya, “Aree aniib ushawaw aabu?” idi.<verse eid="LUK 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30" />Yasuuꞌa bariiyooh dehaay igwibi: “Tak Algudusee Ariihaab beeti giigee, gwihara hooy daayaaniit tꞌiibriyi hooy isaalibna. Ithaabꞌaniit tooyat iidwilihoob, yꞌishni giigiyaan. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />Beenhoob fagiiri been usalal ookna nꞌati saki. Uun ufagiiri ootak rhiyihoob, oodar ooraawii hasamiya. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />Oontꞌa weer tak Laawiib oomhiin eeyaayt barooh rhiyihoob, uun han oodar ooraawii hasamiya. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />Laakiin Saamiri iibaabee been ootaki mhiin eeya. Baruuh been ootak rhiyihoob, bariiyooh dehaay nꞌakwmanaaya. <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />Bariiyooh dehaay eeyaayt tꞌadilꞌiitooh dehaay yhakwir aree saliitwa haabwa kehii ifif. Malya ootak umeekooh isꞌamaayt fiinaniiti gaw haay ibi. Beentooy aree barooh daayiib iweer. <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />Oombꞌi ooraaw malu ashteeti diiti mhallaga mhaliyaayt tifiinaniiti gawi kina yhii. Malya baruuh, ‘Oon ootak daayiib weeraa! Aree bariiyooh dehaay gwidakaana kwansiyeek, ani atꞌagiirihoob ikwaas hook andi.’ idi.” idi.<verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />Yasuuꞌa ootakii dehaay, “Een bareeh imhayeeb, oon ootak igwihara isaalibneeb sidki shawwooh ikatiib keeyaab hiistiniya?” idi.<verse eid="LUK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37" />Whaggi kanaaniiga igwibi, “Ootak ubariiyooh dehaay nꞌakwmanaayaab ikati.” idi.</para>
  <para style="p" vid="LUK 10:37">Yasuuꞌa bariiyooh dehaay, “Difaat baruuh sakiyaneet toona tꞌiiteena sakaa!” idi.<verse eid="LUK 10:37" /></para>
  <para style="s">Maryamwa Maartaaywa Ugawiib</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />Wꞌankwanaawwa ikwiriyaatayaahwa iibaabee gariyaat gaanaatii dehaay eeyaan. Beentooy Maarta iidneet takat barooh ugawiyooh tehadar. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />Maarta kwaat Maryam iidneet tiibri. Maryam Wꞌankwanaay suurii tisꞌat ibhaliyeeh tisniikar. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />Laakiin Maarta ishaga ishagaamami kassuuh dehaay guudiya. Batuuh Yasuuꞌii dehaay eetaayt raatta, “Wꞌankwanaay! Tukwaatu ushanhiib oodꞌu daayaniyi jillaay tꞌish hoosu giigta. Batooh teeshtiimeetu toona sooyaa!” tidi.<verse eid="LUK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41" />Wꞌankwana igwibi, “Maarta! Maarta! Batuuk tehasikii, gwidaanaatiib amgwarhaatuwii. <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />Laakiin ateharriwaana gaat teefi. Maryam hayiskaana waasta, beet tuuna batiisooh yakami kitdi.” Yasuuꞌa idi.<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s">Toosileel</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />Yint gaat Yasuuꞌa mhiin gaalnaay siileeli. Baruuh faayisiyanihoob, ikwiriyaatayeesooh gaal bariiyooh dehaay, “Wꞌankwanaayuun, Yuuhanna ikwiriyaatayeeh allamiyeet tehayꞌaatiit, toosileel allamaa hoon!” idi.<verse eid="LUK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2" />Yasuuꞌa bareeyooh dehaay, “Siileelteenihoob,</para>
  <para style="q1" vid="LUK 11:2">Baabuun tibreeteeb eefeeb!</para>
  <para style="q1" vid="LUK 11:2">Uusmuuk mugaddas baꞌiikti,</para>
  <para style="q1" vid="LUK 11:2">tehadꞌaayeetuuk baꞌeeti! Baruuk harriiweet tibreeteeb teefeet toonaatiit, tubuutiib han batiikti.<verse eid="LUK 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3" />Bꞌeebka timꞌariitoon hiiyya hoon.<verse eid="LUK 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4" />Tumaagnaaytoon afooya,</para>
  <para style="q2" vid="LUK 11:4">hinin han toomaag iwariyoon oodehay afoonay,</para>
  <para style="q1" vid="LUK 11:4">aree jarrabamtiib baadꞌiya hoon.” idi.<verse eid="LUK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />Malya Yasuuꞌa bareeyooh dehaay, “Gaal bareesookna araaw ibariib, whawaadi tarabeeb wꞌaraawooh bayiit, ‘Wꞌaraawuunay! Mhay hadhi siisalifaheeb, <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />Araawu gaal iibaabtii eeyaheeb, barooh aniiweena naat han kaabari.’ tindiya. <verse eid="LUK 11:6" /><verse number="7" style="v" sid="LUK 11:7" />Malya uuraaw ugawiit hooytee kwinhiit, ‘Yhaa baagallabaheeb! Udheefa suur akay hakwaaru, yꞌari unꞌaaliib geebu diwaaba. Ani yakiit barook hadhiib aniiweetook toona kaꞌadgiran.’ indi. <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />Ani andi hookna, uun baruuh araawooh ikatiyeet toonaatii barooh yakiit yhadhi kiiyhi. Laakiin baruuh kassoohoob iraatamtiib sikwꞌaab kiikuuyt, barooh harriiweenaaka iniiw.<verse eid="LUK 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9" />Aflaay ani andi hookna: Raataana, aree beet toona ittiyiw tiyadna. Hariwna, aree imaar tiyadna. Udheefa kwilna aree baruuh dehookna itnigil indi. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />Raatiiniibka iniin. Harriiwka marri. Aree udheefa inkwiilka baruuh dehaay itnigil indi.<verse eid="LUK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11" />Bareekna ibaabeeb, wꞌooruuh hadhiib hooy harriiweek, aweeb iniiw keeyaabu? Aashoob hooy harriiweek, wꞌaashooy mhiin kwakwar iniiw han? <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />Tari baruuh kwihiib harriiweek, talꞌanoob iniiw han? <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />Aree bareekna tikatiineek, baraakna yꞌamag, yꞌareekna kak daayiina tiyawneeb tikteenna. Aflaay Baabuukna tibreeteeb eefi, oodehay barooh Eeshuuk Imugaddasa raateen kak winneet gwidaana iyaaw indi!” idi.<verse eid="LUK 11:13" /></para>
  <para style="s">Yasuuꞌaawwa Baꞌalsabuulwa</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />Yasuuꞌa gilluusi takii jin iifirꞌa. Aajin ifirꞌanihoob, uutak ugilluusi hadiidiya aree uudehay hooy ajjabamiyaan. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />Laakiin bareesooh gali, “Baruuh Baꞌalsabuul eejini hadꞌaay, eejin farꞌiini.” idiin. <verse eid="LUK 11:15" /><verse number="16" style="v" sid="LUK 11:16" />Wari aree, barooh jarrabtiib yhariwnayt, tibreetee alaamaat raatiyaan.<verse eid="LUK 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 11:17" />Laakiin Yasuuꞌa bareeyeeh iginꞌaayeeb tiifiit toona ikanaayt bareeyooh dehaay: “Tehadꞌaayi tuukna malu mhiin daatniit katꞌami tindi, uugaw malu mhiin itꞌadhiidh, dhibi indi. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />Oobliis uukna malu mhiin itꞌadhiidheek, kak tehadꞌaayeetuuh tingadi? Baraakna, ani eejin Baꞌalsabuulii mhaliini tiyadnayt, ani een andi. <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />Oontꞌa ani Baꞌalsabuulii eejin mhalaniyeek, bareeyookna harꞌii sakeen uudehay bareeh kak mhaleena? Aflaay malya, baraah gaadiyaayeekna iikti iyadna. <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />Laakiin ani Ukwaasanaay yꞌakriree eejin mhalaniyeek, aflaay Ukwaasanaayt tehadꞌaayi bareeyookna dehaay yꞌaati.<verse eid="LUK 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21" />Akra tak winneet gadhꞌamaab ugawooh ookna ingwꞌiidihoob, umraayuuh diimaab asgaabi. <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />Laakiin weer tak akrakaab, barooh thꞌatiit garriibihoob, igadhꞌi ibaruuh dehaay adehamaab iiktiyeeb hooy iniin, aree tiganiimi ishꞌadhdhiidh.<verse eid="LUK 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23" />Anii geeb baahaay uutak been, anii kehii eefi. Aree anii geeb oodehay baasimarriib uutak, baruuh itbariir.” idi.<verse eid="LUK 11:23" /></para>
  <para style="s">Eejneet Mꞌageer</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />Yasuuꞌa “Aajin wꞌaadamii itfarꞌanihoob, nageema mhiin hooy fiineeneeb yhariwna aree barooh kiimriin. Malya aajin, ‘Oogaw whooy nifirꞌeeb beeti nitꞌigir niyad.’ iyadna. <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />Aajin yꞌeenihoob, oogaw atimhigaa nhasaa aree shibooba imeerna. <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />Malya aajin giigeena, aree wari jin asaramaab bareesoohka winneet amagkaab geeboohna haay yꞌeen. Aree difiit beentooy ikweerna. Aakhir been uutak whaaluuh suureeka amaagkaab ikati.” idi.<verse eid="LUK 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />Yasuuꞌa een ibhali masi hadiidee, takat oodehayi bitikii waliiktaayt, “Barook tifriit kadhishtaat tuundi libaabta.” tidi.<verse eid="LUK 11:27" /></para>
  <para style="s">Sidik Libaabiyaan</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28" />Yasuuꞌa “Beet tuuna sidiku, laakiin baliin Ukwaasanaay ibhali maaswiit isnaakiir, libaabeenkaaba.” idi.<verse eid="LUK 11:28" /></para>
  <para style="s">Yuunisiit Tꞌalaama</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />Uudehay gwidakaab ikeeneet midda, Yasuuꞌa “Uun baruuh amaag taas ikati. Baraah mꞌuujisaateet alaama raateena, laakiin unabi Yuunisiit tꞌalaama nuun, weet alaama ittiyiw kitdiina. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />Unabi Yuunis Neenawaay oodehayii dehaay alaamaat iikti. Wꞌaadami Oor han ootaasii dehaay alaamaat iikti indi. <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />Oosꞌiidiit hadꞌa whukwimiit yintiib yakiit oon ootaasi dehay atehimi tindi. Batuuh tubuuti agiyaay eetaayt, Suleemaaniit tifagarandiiti bhali sinaakrooyt tehariw. Laakiin tooy Suleemaaniika winka gaal eefi. <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />Neenawaay uudehay han whukwimiit yint yakiit oon ootaas atehimi iyadna. Unabi Yuunis Ukwaasanaay ibhali bareeyooh dehaay hadiidiyanihoob, baraah tuubiyaan. Tooy laakiin Yuunisiika winka gaal eefi.” idi.<verse eid="LUK 11:32" /></para>
  <para style="s">Ugarooy Nuur</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />Yasuuꞌa, “Lambaat shidhhaniit kwanbiis tari diwaani whii daasiini gaal han kiihaay. Laakiin baruuh tageega mhiin daasiini. Aflaay oogaw shuumeen baliin rheenee dehaay adgireen. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />Tuliiliituuk ubashariitook lambaati. Tiliiliyaataak daayiit ikatiineek, kassuuh ugarooyuuk han nuur eettiib. Laakiin tiliiliyaataak amagt ikatiineek, ugarooyuuk han thibnamiini. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />Aflaay been uunuur hook eefeeb, thibin biikaayeet toona, daayiib shibiba. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />Shaawti kassuuh ugarooyuuk nuur eettiibeek, aree tarab han thibnamaab biikaayneek, baruuh winneet buubiini. Malyaab tulambaati nuur tꞌiiteena dehookna buubiini.” idi.<verse eid="LUK 11:36" /></para>
  <para style="s">Yasuuꞌa Ifariisiiwwa Whaggi Koojaawwa Atehimiini</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />Yasuuꞌa ibhali faayisiyanihoob, tak Fariisi bariiyooh dehaay mꞌariitiit aduumaat idꞌi. Aflaay Yasuuꞌa giigiyaayt timꞌariitii dehaay geeb isꞌa. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />Laakiin been Ufariisi Yasuuꞌaab timꞌariiti hankaay yꞌayeeh shigwidhaab baakaay rhiyanihoob, ajjabamiya.<verse eid="LUK 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 11:39" />Malya Wꞌankwana bariiyooh dehaay, “Oontꞌa baraakna Ifariisi ookaaswa tukoobaawwa tisarat tisinhiisna, laakiin tehooytaakna haamtiiwwa maagnaaytwa atabta. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />Baraakna uudehay yꞌafrii! Been tehooy idꞌiib, tisarat han dꞌiyaab kiiki han? <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />Laakiin tukoobaatiit hooyteeb teefeet toona imiskiina hiina. Aree naatka dehookna nhast iikti tindi.<verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />Tidhikwna baraakna Ifariisi! Timꞌadayaataakna ifeerneet tibuhaara tꞌiiteena inanꞌaaywa igirfaaywa kasteeh warit shakwiinaateewwa tutamnaat takwi Ukwaasanaay dehaay tifarꞌana. Laakiin oodehay titalisna aree Ukwaasana kaꞌareetaana. Oodehay irawee dehaay tishboobiineet toonaatu, aree adil tidꞌaneet toonaatu, masi Ukwaasanaay dehaay tutamnaat takwi tifarꞌaneet toonaati. <verse eid="LUK 11:42" /><verse number="43" style="v" sid="LUK 11:43" />Tidhikwna, baraakna Ifariisi! Iyahuudi diini gawiib timiisꞌanii tisuuriit areeteena. Isuugaayeeb daayiib salaamamteeneetwa hamooysamteeneetwa areeteena.<verse eid="LUK 11:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 11:44" />Tidhikwna, baraakna imiimasha tꞌalaama baabariib uudehay kanaab baakaay kehii hiireereeneeb tꞌiiteebaana.” idi Yasuuꞌa.<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />Whaggi koojaayee gaal bariiyooh dehaay igwibi, “Seednaay! Teen teena tindiyihoob, neewtiniya hoon.” idi.<verse eid="LUK 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46" />Yasuuꞌa “Baraakna whaggi kooja han, tidhikwna! Oodehay diga rabi tireebna, aree baraakna iknaayaakna bareetooh shamaamtiib gaat giibalaaytookna han kehii kadaastaana.<verse eid="LUK 11:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47" />Baraakna tidhikwna! Inabiyaayee dehaay miimashaab teedꞌirna, aree baliin bareeh hoobaakna daaraaba. <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />Aflaay hoobaakna igwibibneet toona agbilteena aree baraak iknaayaakna tibadehana. Baraah inabiya idaarna, aree baraakna imiimashaayeehna teedꞌirna. <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />Toon toonaatii, Ukwaasana tifagarandiiteesooh, ‘Ani bareeh nabiyaawwa, linguumaawwa dehaay diigwati andi. Baraah galib bareesooh idaar iyadna, aree warib amaag iiwari iyadna.’ idi. <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />Aflaay tuduniya badootaneekka ifaf kasseeh inabiyaayi booy, uun uutaas raatamami indi. <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />Haabiiliib ubooyiiwwa, beeb tikaraamaati mhiinwa Oomhiin Umugaddasi bitikwa itoodaar Sakariyaay ubooyiiwwa hadiit, oon ootaasi kehii eefi. Awooh, andi hookna, uun uutaas kastooh beet toona raatamami indi.<verse eid="LUK 11:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52" />Tidhikwna, baraakna whaggi kooja! Tukanaanti dheefaay umiftaha taftaana, laakiin iknaayaakna shuumaab kitteena. Aree baliib ishuumiin tehabiina.” idi.<verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />Yasuuꞌa beentooysii giigiyanihoob, Ifariisiiwwa whaggi koojaawwa winneet bariiyooh amꞌakuura badooyaaniit, barooh gwidaana raatiyaan. <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />Aflaay barooh naat diyee yꞌibikni jillaay bariiyeeh ibhali igwꞌadna.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">Oosdik Eegwsir Anuub</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />Been oodoor gwida alfa dehay idbalnihoob, baraah gal eeraw eetiyaan. Yasuuꞌa hankaab ikwiriyaatayeeh hadiidsamiya: “Ifariisi hamiirii digwagwna! Been baruuh mishuush ikati. <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />Kwabaasna lawi baadiit kitehaay, tari dhꞌimaana ituukkin baadiit kitehaay. <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />Ibhali uthibniib tiyadneeb, oombꞌi itmissiw iyadna. Ibhali taktakeeb yꞌangwileeb igawaayeet hooyteeb hadiidteeneeb, igawaayi mhakwal soomami iyadna.” idi.<verse eid="LUK 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />Yasuuꞌa “Ani andi hookna, yꞌarawaanay! Baliib ugaru dirtiit malya weenaati dꞌuuy baaꞌadgirayaab hooy baarakwiina. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />Laakiin ibakii aab tireekwneeb ani rhisi hookna andi: Ubashar dirtiit harꞌii, barook tunꞌeetiib haay ingiidi akrir ibariib beeb rikwiina. Awooh, barooh rikwiina, andi hookna. <verse eid="LUK 12:5" /><verse number="6" style="v" sid="LUK 12:6" />Ayt kilay maloot jineehiitee kiidilabna han? Laakiin Ukwaasana gaat han bateesooh kiibaadhin. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />Laakiin bareekna igirmaayeetaakna tehamu han kastaah atdhagwgwiyaata. Baarakwiina! Baraakna gwidaat kilayteeka alyakaabaana.<verse eid="LUK 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />Ani andi hookna, oodehayi suurii aniib ikatiyeet toona isookiinka, beeb Wꞌaadami Oor han Ukwaasanaay imalaki suurii barooh isuukin indi. <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />Laakiin oodehayi suurii aneeb ittawiib, Ukwaasanaay imalaki suurii Wꞌaadami Oor han barooh ittiw indi. <verse eid="LUK 12:9" /><verse number="10" style="v" sid="LUK 12:10" />Tak gaalka Wꞌaadami Oori kehii naat indiib, afoomi indi. Laakiin Eeshuuk Imugaddasaayee kanfiirka, afoomi kiidi.<verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />Iyahuudi diini gawaawwa isuurkinaawwa yhaakmaayi suuriiwwa bareekna haay yꞌeenihoob, baraakna kak igarooyookna teheebneeb tari naan iyaad tiyadneeb, baahasiikna. <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />Been oodoor naan iyaad tiyadneeb Aashuuk Imugaddasa allami hookna iyadna.” idi.<verse eid="LUK 12:12" /></para>
  <para style="s">Wꞌafrii tak Ugabaanaay Mitaal</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />Gaal oodehayi bitikii bariiyooh dehaay, “Seedna, usanu tikwasa yꞌandhiidheetu toona sooyaa.” idi.<verse eid="LUK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14" />Yasuuꞌa “Yhaa, aaw bareeyookna bitik gaadiib tari aadhdhiib ikwaaseheeb?” idi. <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />Malya oodehayii dehaay, “Digwagwna, baakaashna! Wꞌaadami midhhan gwida miraayi kinaamtii kiiki.” idi.<verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />Malya bareeh een eemtaal dehaay hadiidiya: “Gaba tak gaal iifi. Tudirꞌaatuuh gwida harru tifirꞌa. <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />Uun uutak uukna ikwin, ‘Naan adanꞌi? Oon wharru kassooh hooy adanbiyi mhiin kaabari.’ idi. <verse eid="LUK 12:17" /><verse number="18" style="v" sid="LUK 12:18" />Malya baruuh, ‘Bak saki andi, umikhsanu katꞌeetiit, weer winkaab iidꞌir andi. Aree kassooh wharrooyoowwa igadhꞌeewwa beentooy idaab andi. <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />Aree ugarooyu dehaay, “Ugarooyu, gwida hawla hadiit daasamaat gwidaat daayiinay tibariya. Rayhamaa! Tamaa! Gwꞌaa! Aree afirhaa!” iyaad andi.’ idi.<verse eid="LUK 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20" />Laakiin Ukwaasana bariiyooh dehaay, ‘Baruuk afrii takwa! Amsi whawaad aashuuk hook ittiyiw iyadna. Malya beet toona ugarooyook dehaay soomiraab tikatiyeet aayt iikti tindi?’ idi.<verse eid="LUK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21" />Uutak ugarooyooh dehaay teena danbiib, oontꞌaaneet iikti indi. Laakiin Ukwaasanaay geeb baruuh gaba tak kiiki.” idi.<verse eid="LUK 12:21" /></para>
  <para style="s">Baahasiikna</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />Yasuuꞌa ikwiriyaatayeeh dehaay: “Aflaay andi hookna, umidhhaniyookna dehaay baahasiikna! Naan tami tiyadneeb, tari igarooyeekna naan istuukw tiyadneeb, baahasiikna. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />Umidhhan tumꞌariitiika alyakaab ikati. Aree ugaru yhalakaayeeka takweetikaab ikati. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />Ikwiikwꞌay shibibna! Baraah kiiꞌadiina, tari kiiwikna, mikhsanaab tari geesaab kiibariin. Laakiin bareeh Ukwaasana tamsiini. Aflaay, baraakna ikwiikwꞌayeeka alyakaabaana! <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />Aaw bareesookna hansiikihoob, umidhhaniyooh gaat saaꞌa eeshiwi? <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />Teen teena tidabalooya tidꞌanee dehaay bitadgirayneek, aflaay naanhooy teena tirawtee dehaay tehasikna?” idi.<verse eid="LUK 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27" />Yasuuꞌa “Umingaayi hindi idaawriib shibibna kak yakeena. Baraah kashagaamiyaana tari igarooyeehna kiisitookwna. Masi ani andi hookna: Suleemaan kassooh ugibliisooh een yhindiyeet akwaay kiiki. <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />Aree uusyaam, amsi tubuuti kehii eefeeb, lhayt tunꞌeetiib itoogiid. Ukwaasana barooh bak istookwiyeek, aflaay bareekna ishalik iimaaniyay, kak gwidaana istuukw hookna indi! <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" />Naan tamteeneebwa naan gwꞌiteeneebwa uginꞌiyookna baadꞌiina. Beet toona hooy baahasiikna! <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />Uudehay diin baabariin kasteeh teen tinaati harꞌii dhaabeen. Laakiin Baabuukna bateeh tehariwneet toona ikteen. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />Laakiin tehadꞌaayeetooh hariwna! Taan taana han ittiyiw hookna iyadna.<verse eid="LUK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32" />Yaa ikwiriyaatay idabalooya, baarikwiina! Baabuukna tehadꞌaayi afirhaa iniiw hookna.” idi. <verse eid="LUK 12:32" /><verse number="33" style="v" sid="LUK 12:33" />Yasuuꞌa masi “Titibariina dilibnaat, imhallaga imiskiina hiina. Igarooyeekna dehaay baashꞌiit mhallagaayeet shanta dꞌiina, aree umraayookna tibreeteeb dibiina. Beentooy igwihara kiikitimna aree uusuus kiimig. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />Umraayuukna hooy eefiyeeb oomhiin, iginꞌuukna han hooy daayiini.” idi.<verse eid="LUK 12:34" /></para>
  <para style="s">Tigwꞌadaad</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />Yasuuꞌa, “Shagaamtii dehaay marnaat kweena, aree tilambaateekna baloolsaana. <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />Idoobeet aduumaatii itꞌagiir wꞌankwanaayoohna yhagit eenda tꞌiiteeb akeena. Aflaay baruuh yꞌeetiit udheefa inkwiilihoob, baraah willa bariiyooh dehaay inagilna. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />Wꞌankwanaayuuhna yꞌiiniyihoob bareeh bꞌaraa marriyeeb ikishiya baliin libaabiyaan. Oosdik andi hookna, baruuh shagaamtii dehaay itlibib indi. Bareeh tumꞌariitii dehaay soosꞌiit yhigit indi. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />Baruuh whawaadi tarabeeb tari teekwihi yꞌiiniyeek, amar akay marriyeeb ikishiya baliin libaabiyaan. <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" />Laakiin toon toona afhamaana: Ugawikina ugwihara yꞌiiniyeet toosꞌa ikteeniyeek, baruuh ugawooh kiisigwihar. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />Baraakna han ibakii marna! Wꞌaadami Oor bitsꞌayaamayneet saaꞌaatiib yꞌi indiyayt, marna!” idi.<verse eid="LUK 12:40" /></para>
  <para style="s">Uwakiil Wꞌamiin</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />Bitrus raatiya, “Wꞌankwanaay, baruuk een eemtaal hinee dehaay tindiya han, kassooh oodehay haay tisehariiwa?” idi.<verse eid="LUK 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42" />Yasuuꞌa igwibi, “Uwakiil usidkiiwwa ufagarwa aflaay aabu? Been bareeh timꞌari udooriyooh iniiwee dehaay wꞌankwanaayuuh ikishiyaayeeh kehii suurkinaab ikwasiyeeb aabu? <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />Wꞌankwanaayuuh itꞌagiirihoob, been toona sakee marriyeeb ukishiya been libaabiya. <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />Oosdik andi hookna, wꞌankwana oon ootak kassooh umraayooh isꞌibik indi. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />Laakiin uun ukishiya ugarooyooh dehaay, ‘Wꞌankwanaayu willa itꞌigir kiidi’ diit, malya baruuh ikishiyaawwa, tikishiyaawwa eethibꞌeek, tamiiniyeek, gwꞌiiniyeek, aree askiriiniyeek, <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />wꞌankwanaayuuh baruuh biisꞌayaamayeet saaꞌaatiib tari biikaani dooriib, yꞌi indi. Oon ukishiya katꞌiit iirfit indi, aree barooh ootkaal aagibi mhiin daasiini.<verse eid="LUK 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47" />Ukishiya wꞌankwanaayiitooh tuniya kanee dehaay amaar baakaay, tari baruuh harriiweet toona baadꞌiib, been baruuh akra kwirbaajii jasaami indi. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />Laakiin ukishiya wꞌankwanaayuuh harriiweet toona kanaab baakaay sakiiniib, aree jasaab astehaltiniina sakiiniib been baruuh shoof kwirbaajii jasaami indi. Gwidaana attiyeewiyaab ootakiika, gwidaana hooy itehirriw tindi. Beeb gwidaana sꞌabkaab ikatiineeb, gwidakaana raatamami indi.” idi.<verse eid="LUK 12:48" /></para>
  <para style="s">Mꞌasig Kiiki, laakiin Gwirhaaba</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />Yasuuꞌa “Ani toobuur nꞌeet hooy iidꞌa miyaadiib yꞌaabu, aree suur akay alaawt tiiktiyeet toona minniiman. <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />Laakiin ani ibakii atoomiis, aree beet tuuna faayamtiniyeeb hadiit winneet lhami andi. <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />Ani tubuuti kehii mꞌasig haay yꞌaniyeeb hiisteena han? Een kiikeen, laakiin oodehay khilaafiib adanꞌiyee dehaay yꞌaabu, andi hookna. <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />Amseenee fidnaab dhiwaab galneeb ay daayeen baraah gaal ooraawi kehii yakeen, mhay malooni kehii yakeen, aree maloob mhayni kehii yakeen. <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />Baraah itꞌadhiidhna, ubaaba wꞌoori kehii yakiini, aree wꞌoor ubaabaay kehii yakiini. Tuundi tꞌooti kehii yaktini, aree tꞌoor toondeeti kehii yaktini. Teham wꞌooriitooh takati kehii yaktini, wꞌooriit takat tehamtiyooh kehii yaktini.” idi.<verse eid="LUK 12:53" /></para>
  <para style="s">Tꞌalaama Afhamaana</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />Yasuuꞌa kassooh oodehayii dehaay: “Uyindhibii bꞌaluuk firꞌee rhiteenihoob, baraakna igidiyeesookna, ‘Biri yꞌiini,’ tiyadna, aree bak ikati. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />Oosꞌiidi baraam nanfiyihoob, baraakna ‘Nabꞌuuyt eetni’ tiyadna, aree bak tikati. <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />Baraakna uumshuush! Toobuutwa teebreewwa shibibtiit kak fassarteeneeb tikteenna. Laakiin oon amseeneeb udamaani fassarti kak kitkanna?<verse eid="LUK 12:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />Tushboonaayti sakti naanhooy ikanaayaakna kaꞌafhamtaana? <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />Ugariimiyook geeb tumhakama beeti giigtiniyeet midda, usalaliib barooh timꞌaddiileet toona winneet jarraba. Bak biikaayeek baruuh ugaadi beeti imoorhiif hook. Ugaadi aree udaabit beeti hassiini hook, aree udaabit usijniib ingiid hook. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />Andi hook, baruuk kasseeh imhallaga neekalt anu kwansiyeeb ookiik itfirꞌa kitdiya.” idi.<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s">Ukwaasanaay Dehaay Agarna!</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />Oontꞌa dehay gwadi beentooy iifiin. Biilaatoos idaareeb Jaliileeb uudehay beenhoob baraah Ukwaasanaay dehaay karaamaat iifirꞌaneet toona Yasuuꞌaab sooyaan. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />Yasuuꞌa bareeyooh dehaay, “Baraah bak lhamiyaanayt, aan Ijaliilaayi kasseeh Jaliileeb oodehay ooraawiika amagka danuub dꞌiyaab hiisteena han? <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />Kiikeen, andi hookna! Laakiin baraakna han Ukwaasanaay dehaay bitꞌagaarneek, bak kwidhi tiyadna. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />Tari itamna asimhay Silwaameeb tusiraayi kehii dhibtanihoob iyaan baliin, baraah kasseeh Alguduseeb ikweer oodehay iraweeka gwidaka gwabab iibriineeb hiisteena han? <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />Kiibariin, andi hookna. Laakiin baraakna han Ukwaasanaay dehaay bitꞌagaarneek, kassaakna bareetooh kwidhi tiyadna.” idi.<verse eid="LUK 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />Malya Yasuuꞌa een eemtaal hadiidiya: “Tak dirꞌaatiyooh tiini hindi yꞌadi. Aree whindiib Samaraat yhariw, laakiin naat han miraab kiiki. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />Aflaay baruuh udirꞌaateegaay dehaay, ‘Ani mhay hawla abari, oon ootiiniib firaay ahariw. Laakiin naat hooy miraab kaaki. Whindi wikaa! Whaashiib naanhooy mhiin anbiik?’ idi.<verse eid="LUK 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 13:8" />Udirꞌaateega igwibi, ‘Duuruun! Barooh hawil weer masi ishaa! Bariiyooh kwayaay iifrik andi aree yakistiniina hooy iidꞌi andi. <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />Whawil tꞌa yꞌiiniib daayi firaay farriyeek, ishboob! Biikaayeek, malya barooh wookaa.’ idi.” Yasuuꞌa idi.<verse eid="LUK 13:9" /></para>
  <para style="s">Yasuuꞌa Takat Toosab Mheeliya</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />Yasuuꞌa Yahuudi diini gaw gaalnaay toosab allami. <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />Been oomhiin tamna asimhay hawla jin lhasaab iiktiineet takat tiifi. Batuuh winneet agwaal ahaatu aree timifdheedh kaꞌadgirta. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />Yasuuꞌa batooh rhiyanihoob suurbeeti waliikiyaayt, “Yaa takatay! Tulhanaaytook hooy nꞌiraatuwii.” idi. <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />Malya batiiyooh kehii yꞌayeeh daasiyaayt, igidiyeesooh tutakat tifidhadh, aree Ukwaasana tehamid. <verse eid="LUK 13:13" /><verse number="14" style="v" sid="LUK 13:14" />Yasuuꞌa toosab mheelaabuuyt, Iyahuudi diini gawi suurkina winneet yhasi. Malya baruuh oodehayii dehaay, “Toosab nuun Asagwit yina hooy shagaamteeneet eefeen. Aflaay mꞌaana een eembꞌi hooy mheelamaana!” idi.<verse eid="LUK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15" />Wꞌankwana bariiyooh dehaay, “Baraakna uumshuush! Bareesookna gaalka toosab uyooyooh tari umeekooh gwꞌasiiniyee dehaay wꞌalafiit mhakwartii fidigtiit haay kagiigiya han? <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />Malya tuun tutakat, Ibraahiimiit oot, uubliis batooh tamna asimhay hawla yhakwir. Batooh hakwiraat toonaatii toosab titfadiigeet toona kitti han?” idi.<verse eid="LUK 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 13:17" />Yasuuꞌa een ibhali idiyihoob, kassaah yꞌashooyaah isikwꞌana. Laakiin baruuh iidꞌeet teena tꞌajaayib kasteeh rhiyaan uudehay afirhiyaan.<verse eid="LUK 13:17" /></para>
  <para style="s">Usinfaayt Habbaati Mitaal</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />Malya Yasuuꞌa raatiya, “Ukwaasanaayt tehadꞌaayi kak tꞌiiteetu? Batiiyooh geeb naan asnaddiir? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />Batuuh usinfaayt habba tꞌiiteeti. Tak batooh iyhaayt dirꞌaatiyooh yꞌadi. Batuuh yaktaayt hindiib tiki, aree aakilay kehii askiniyaan.” idi.<verse eid="LUK 13:19" /></para>
  <para style="s">Whamiiri Mitaal</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />Yasuuꞌa masi raatiya, “Ukwaasanaayt tehadꞌaayi naanaati geeb asnaddiir? <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />Batuuh takat hamiir yaksitaayt, winneet gwida bꞌuukiib tehathik. Malya kassuuh wꞌajiin yhamir. Beet batooh tꞌiiteeti.” idi.<verse eid="LUK 13:21" /></para>
  <para style="s">Udheefa Wꞌadeha</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />Malya Yasuuꞌa Algudus beeti sakee, timadiinaateebwa tigariyaateebwa oodehay allamiya. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />Tak gaal barooh raatiya, “Wꞌankwanaay! Shalik dehay midhhan imaar iyadna han?” idi.</para>
  <para style="p" vid="LUK 13:23">Yasuuꞌa bareeyooh dehaay, <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />“Udheefa wꞌadehalooyii shuumti jillaay winneet shagaamaana, andi hookna. Gwida dehay shuumtiib jarrabi iyadna, laakiin adgiri kiidiin. <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />Ugawikina gaalhoob yakeetiit udheefa hankwiiri harꞌii, baraakna barraab gadtiit udheefa teekwilna, aree ‘Duuruun, udheefa dehoon fidiga!’ tiyadna.</para>
  <para style="p" vid="LUK 13:25">Laakiin baruuh, ‘Kaakan hookna, tari naa mhiinii yꞌaabaana!’ iyaad indi.<verse eid="LUK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 13:26" />Been oodoor baraakna, ‘Geebook tamna aree gwꞌina, aree hineeb isalalaayeeb allamta.’ tiyadna.<verse eid="LUK 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27" />Laakiin baruuh igwaab indi, ‘Sidik kaakan hookna, tari naa mhiinii yꞌaabaana. Baraakna kassaakna tumaagnaayti sakana, hoosu sigiina!’ indi.<verse eid="LUK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 13:28" />Malya beentooy waawteena, aree lhamiit tikwileeteekna ishuuthithꞌa tiyadna. Ibraahiimwa, Isehaagwa, Yaaguubwa, kasseeh inabiyaawwa Ukwaasanaayt tehadꞌaayeetiib rhiteenihoob, laakiin baraakna fidnaab titoogiidna. <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />Uudehay uyintalawiiwwa, uyindhibiiwwa, oosꞌiidiiwwa, tugiblaatiiwwa yꞌi iyadna. Ukwaasanaayt tehadꞌaayeetiit aduuma hadri iyadna. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />Baliin oontꞌa wꞌagiyaay eefeen suurii daayi iyadna. Aree baliin oontꞌa suurii eefeen wꞌagiyaay daayi iyadna.” idi.<verse eid="LUK 13:30" /></para>
  <para style="s">Yasuuꞌa Algudus Areeya</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />Been oodoor Fariisi gali Yasuuꞌii dehaay eeyaaniit, bariiyooh dehaay, “Oon oomhiinii giiga aree weer haash bayaa! Heeroodis madareek harriiw.” idiin.<verse eid="LUK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32" />Yasuuꞌa igwibi, “Giigaanaat, beeb ubꞌashu sooyaana, ‘Ani eejin iifirꞌa andi, aree amseewwa lhaytwa oodehay mheeli andi, aree tooyin tumhaya faaysi andi.’ diina. <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />Laakiin ani amseewwa lhaytwa tooyin tooraawwa tꞌiibaab ibakii isuuririm andi. Algudusee barraab iyaayi nabi kiihaay!<verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />Yaa Algudus! Algudus, batuuk inabiya tidaarii aree idiigwatkina batiiyook dehaay diigwatamiyaab rajamootaayii. Wꞌambuuriyooh whii inisrikaayeeh tismarriit tooklaaytiit, ani diimaab udehayook asmarriyeet aharriiw, laakiin batuuk tiribii. <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />Oontꞌa ugawuukna mingaayama dehookna imhi. Andi hookna, baraakna ‘Wꞌankwanaay oosmii yꞌiiniib been baarakamaabu!’ tiyadneeb hadiit masi rhiheeb kitdiin.” idi.<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">Yasuuꞌa Lha Tak Mheeliya</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />Sabti bꞌi Yasuuꞌa mꞌariit tamiyee dehaay Fariisi suurkina gaalnaay gaw shuumiya. Kassaah oomhiin iifiin Yasuuꞌaab akraab igwaarirna. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />Beentooy iragada aamaab iiktiini tak Yasuuꞌii suurii ingad. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />Yasuuꞌa Ifariisiiwwa whaggi koojaawwa raatiya, “Tusabtiib imheelti halaal han kiiki?” idi. <verse eid="LUK 14:3" /><verse number="4" style="v" sid="LUK 14:4" />Laakiin baraah naat diyaab kiikeen. Aflaay Yasuuꞌa ootak yꞌabik, aree mheeliyaayt giigisiya.<verse eid="LUK 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 14:5" />Malya Yasuuꞌa bareeh raatiya, “Bareesookna gaal oor ibariyeek, wꞌooruuk tari uyooyuuk sabti bꞌi reetiib dhibiiniyeek, willa kitfirꞌa han?” idi.<verse eid="LUK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 14:6" />Laakiin baraah naat igamna.<verse eid="LUK 14:6" /></para>
  <para style="s">Yꞌamnaayeet Miisꞌaniit</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />Yasuuꞌa yꞌamna imhiinan idaayiib kak yhayidneeb rhiyanihoob, baruuh bareeyooh dehaay een eemtaal hadiidiya: <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />“Gaal doobeet aduumaatii dehaay waliikiiniyuuk, timiisꞌanii tehayiskaat baaꞌahaa. Gaal bariisookka winkaab han waliikamaab ikati. <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />Laakiin uutak bareekna mhalleekna waliikaab yꞌeetiit bariiyook dehaay, ‘Oon ootak umhiinook hiiyya!’ indi hook, been oodoor baruuk sikwꞌati tiniina. Weer mhiin shalik takweetikaab tiniina. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />Laakiin waliikamtiniyihoob, oomhiin ushalik takweetiib ahaa. Aflaay Uutak barook waliikaab yꞌeetiit bariiyook dehaay, ‘Wꞌaraawuun! Hayiska mhiin beeti hantaaya.’ iyaad hook indi. Been oodoor kasseeh yꞌamna irawi suurii hamooysami tindiya. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />Ugarooyooh tageegsiiniib been dhoomi indi, ugarooyooh dhoomsiiniib been aree tageegi indi.” idi.<verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />Malya Yasuuꞌa whadareeyooh dehaay, “Mhasiit, tari diraariit aduuma danꞌiyihoob, yꞌaraweek tari isanaayeek, tari yꞌayay deek, tari ishawweek igabaab baawaliika. Bak tiwariyeek, baraah han barook udoorooh waliikeen hook. Aflaay ushagaayook idaataneeb itkwis tindiya. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />Laakiin aduumaat danꞌiyihoob, oodehay yhamraabwa, yꞌamꞌadhdhaabwa, igarbamaabwa, yhamashayaawwa waliika! <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />Aree baarakami tindiya. Aan baraah barook ikweesneena kiibariin. Tooyin uudehay aashiboob tuyatii yakeenihoob, Ukwaasana ijir iyaaw hook indi.” idi.<verse eid="LUK 14:14" /></para>
  <para style="s">Tꞌaduuma Toowin</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />Baliin bariiyooh geeb timꞌari tamiin yꞌamnaayeeb gaal een imaasiwihoob, Yasuuꞌaay dehaay, “Uutak Ukwaasanaayt tehadꞌaayeetiib tꞌaduumaatiib tamiiniib been baarakamaabu!” idi.<verse eid="LUK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16" />Yasuuꞌa bariiyooh dehaay, “Tak gaal wint aduuma isoomir, aree gwida amna waliikiya. <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />Malya tꞌaduumaati door oodehay iwaliikamaab sooyi jillaay ukishiyaayooh diigwatiya. Baruuh ‘Mꞌaana, oontꞌa naatka amaartu!’ idi.<verse eid="LUK 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 14:18" />Laakiin baraah kassaah biibaayneet toona igwirhaayeehna hadiidiyaan. Wꞌawwali, ‘Ani haash adlib ayhee, oontꞌa ibakii bayiit iishbib andi, anaahook afooyaheeb!’ idi.<verse eid="LUK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 14:19" />Weer aree, ‘Tamin Yoob adlib ayhee, oontꞌa haay firꞌatiit bareeh jarrabi andi, aneeb afooyaheeb!’ idi.<verse eid="LUK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 14:20" />Weer han, ‘Ani gayii gaw gidaabuuyt, aflaay wꞌaay kaꞌadgiran.’ idi.<verse eid="LUK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21" />Ukishiya wꞌankwanaayooh dehaay yꞌagaraayt, tutiki sooya. Malya ugawikina winneet yhasaayt, ukishiyaayooh sooya, ‘Tumadiinaati salalaawwa eedooywa beeti willa firꞌaa! Oodehay yhamraabwa, yꞌamꞌadhdhaabwa, igarbamaabwa, yhamashayaawwa tooy haay mꞌaa!’ idi.<verse eid="LUK 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 14:22" />Ukishiya yꞌagaraayt, ‘Yaa wꞌankwana, baruuk sootaneet tuuna daamta. Laakiin masi tooy gwida dehayii dehaay harar mhiin eefi.’ idi.<verse eid="LUK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 14:23" />Malya wꞌankwana ukishiyaayooh dehaay, ‘Tumadiinaatii barraab firꞌaa! Aniib uugaw eettabiyeeb hadiit isalalaawwa idooyeewwa oodehay shuumsaa. <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />Ani andi hookna, baliin eenda iwaliikamaaneeb gaal han aniit timꞌari dꞌamsi kiidi.’ diyaabu.” idi.<verse eid="LUK 14:24" /></para>
  <para style="s">Yasuuꞌiit Turamaamti Taman</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />Yasuuꞌi geeb gwida dehay iibaabiin. Bareeyooh nakamiyaayt: <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />“Anii dehaay yꞌiiniib uutakka, Baaboohwa, deetoohwa, tutakatoohwa, yꞌareehwa, isanaayeehwa, tikwaateehwa biihimaagayeek, umidhhanooh ookna han biihimaagayeek, anii kwiriyaataayi kiiꞌaki. <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />Aree usaliibooh yaksiitka aneeb baaraam, anii kwiriyaataayi kiiꞌaki.<verse eid="LUK 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28" />Bareesookna gaal win siraayaati dꞌuur harriiweek, awwal baruuh nꞌati sꞌatiit utaman naan ikatiyeeb, mheen mhallaga oogaw dehaay faayseen ibariyeeb biibariyeeb kiishibib han? <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />Baruuh wꞌasaas daasiit oogawi faaysiti biiꞌadgirayeek, beet toona rhiiniibka bariiyooh iifiyad indi: <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />‘Uun uutak gawi dꞌuur badooyaayt, ifaayisti igwooy.’ iyaad indi.<verse eid="LUK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31" />Tari whadꞌa tamin alfa dheesh ishuukeeh haay yhanbiyeeb ibariib, whadꞌa ubarooh finaasamiiniib tagwuugw alfa ibariyeek, kak iiwari indi? Baruuh awwal nꞌati sꞌatiit ansiramiiniyeeb biikaayeeb kiishibib han? <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />Baruuh biiꞌadgirayeek, whadꞌa uuraaw masi usalaliib haayee, diigwatkinaab beeti fidigtiit mꞌasig hooy harriiw. <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />Aflaay oontꞌaaneet gaalka tutibariyi kastooh ishtiit aneeb biiraameek, anii kwiriyaataayi kiiꞌaki.” idi.<verse eid="LUK 14:33" /></para>
  <para style="s">Umiilak Oodꞌam Anuub</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />Yasuuꞌa, “Umiilak daayiibu, laakiin uudꞌaam hooy giigiiniyeek, kak uudꞌam masi dehaay itꞌagiir? <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />Baruuh whaashii dehaay daayiib kiiki. Wꞌandhooy dehaay han daayiib kiiki. Uudehay barraab eefifna.</para>
  <para style="p" vid="LUK 14:35">Eemsiiw angwil ibariibka, baꞌiimsaw!” idi.<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s">Wꞌargin Ukwidhaanaay Mitaal</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />Bꞌeeb gaal toomaag sakanaawwa itilbaat tamanaawwa kassaah Yasuuꞌiit sinaakrooytii dehaay immarraayna. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />Laakiin Ifariisiiwwa, whaggi koojaawwa iikwiyaaniit, “Uun uutak toomaag sakana anshiish aree bareeyooh geeb tamiini.” idiin.<verse eid="LUK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3" />Malya Yasuuꞌa bareeyooh dehaay een eemtaal hadiidiya: <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" />“Bareesookna gaal sheeb arginaab ibariyeek, aree gaal hooy kwidhiiniyeek, kak iwari? Yꞌashshadhig tamuunwa yꞌashshadhig umingaayiib ishtiit, ukwidhaab marriyeeb hadiit kiihariw han? <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />Aree baruuh wꞌargin marriyihoob, afirhiit wharkaayooh kehii daasiini. <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />Aree ugawooh eebi. Malya baruuh yꞌaraweehwa ishawweehwa waliikiit, ‘Ani wꞌarginu ukwidhaab amri!’ indi. <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />Ani andi hookna, oontꞌaaneet ashshadhig tamuunwa ashshadhig shibu dehay tuubaat baahariiwaayeeka, amaag sakanaab gaal tuubiiniyihoob, tibreeteeb tageegakaat firha ikatiin.<verse eid="LUK 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />Tari takat gaat tamin ashteeti mhallaga tibariit, gaal hooy kwidhistiniyihoob, kak saktini? Batuuh lambaat tishidhhiin aree oogaw teemhagi, aree marriyeeb hadiit winneet kitehariw han? <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />Aree batuuh marriyihoob, tꞌarawteehwa, tishawawteehwa waliikiit, ‘Mꞌaana! Gwadu afirhaana! Ugirshu ukwidhaab amri!’ tindi. <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />Oontꞌaaneet, ani andi hookna, amaag sakanaab gaal tuubiiniyihoob, Ukwaasanaay imalaki suurii bak firhaat ikatiin.” idi.<verse eid="LUK 15:10" /></para>
  <para style="s">Wꞌoor Ukwidhaanaay Mitaal</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />Malya Yasuuꞌa masi, “Malu ar iibri tak iifi. <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />Wꞌoor uudis ubaabaay dehaay, ‘Baab! Umraayii wꞌadhdhu hiiyyaheeb!’ idi. Aflaay uutak umraayooh mhalleeyooh dehaay yꞌadhidh.<verse eid="LUK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 15:13" />Shalik bꞌeeyi harꞌii wꞌoor uudis kassooh wꞌadhdhooh iyhaayt, sagi haash beeti iibaabiya. Aree beentooy hisaabooh dꞌiyaab kiikuuyt, imhallagaayeeh ilkik idꞌi. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />Baruuh imhallagaayeeh kwidhisiyaayt harꞌii, been whaash akraat hargwi hooy daata. Baruuh naat anu imhi. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />Aflaay baruuh giigiyaayt, been whaashi tak gaalnaay gwad shagaamiya. Uutak barooh ikhansir isigwꞌidi jillaay tudirꞌaatiyooh shagaasiisiya. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />Ikhansir tamiineet tumꞌari tamiyeet minniimiya. Laakiin barooh naat iyiw gaal han kiihaay.<verse eid="LUK 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17" />Malya ishuukeeyooh yꞌagaraayt, ‘Ani tooy hargwiit atoodiir. Baabiyu ishagaamana han gwidaat mꞌari tameen! <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />Ani yakiit baabiyu dehaay itꞌigir andi, aree bariiyooh dehaay: Baab! Ani Ukwaasanaay kehiiwwa bariiyook kehiiwwa amaag sakan. <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />Bariiyook oor attiyoodiyee dehaay kaꞌastehalan. Eenda ikiraaykinaayeek tꞌiiteeb gaal kwaasaheeb iyaad andi.’ idi. <verse eid="LUK 15:19" /><verse number="20" style="v" sid="LUK 15:20" />Aflaay baruuh yakiyaayt ubaabaay dehaay yꞌagar.</para>
  <para style="p" vid="LUK 15:20">Laakiin ubaaba barooh sagi mhiinii yꞌee rhiyanihoob, bariiyooh dehaay nꞌakwmanaaya. Baruuh wꞌoorooh beeti dhaabiyaayt, yhalabaayt hooy fꞌiya.<verse eid="LUK 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 15:21" />Wꞌoor ubaabaay dehaay, ‘Baab! Ani Ukwaasanaay kehiiwwa bariiyook kehiiwwa amaag sakan. Bariiyook oor attiyoodiyee dehaay kaꞌastehalan.’ idi.<verse eid="LUK 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22" />Laakiin ubaaba ikishiyaayeeh waliikiyaayt, ‘Ashshigaana! Daawri halak haay mꞌaanaat barooh sitookwna! Bariitooh tugiibalaaytiib khaatim dꞌiina! Gidhꞌaat aree shibna! <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />Dhha laga haay mꞌaanaat haridna. Yakaana aduumaat dꞌiit afirhinayeet toonaati. <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />Uun wꞌooru suur ayaa iifi, tꞌa laakiin idhhan! Suur kwidhaa iifi, tꞌa laakiin maraayu.’ idi. Aflaay baraah tꞌaduuma badooyaan.<verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />Beenhoob, wꞌoor uuwin tudirꞌaatiib iifi. Baruuh oogaw idwilihoob, baasinkoobwa hawaatwa imaasiw. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />Aflaay baruuh ikishiyaayeeb gaal waliikiyaayt, naan tiiktiyeeb barooh raatiya. <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />Ukishiya ‘Usanuuk asgaa yꞌaabuuyt, baabuuk ulaga oodhhaab hardaabi.’ idi.<verse eid="LUK 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28" />Wꞌoor usuurkina winneet gadabiya. Oogawi shuumti irib. Aflaay ubaaba oogaw shuumiyee dehaay winneet hooy yhariw. <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />Laakiin baruuh ubaabaay dehaay, ‘Shibiba! Ani kassoohoob ukishiyaayt dehook shagaamee masi han naat dehook ribaab kaaki. Laakiin baruuk yꞌaraweeyi geeb haay afirhiyeet nꞌaayt han hiiyyaayheeb kitta. <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />Laakiin uun wꞌooruuk umaalook kassooh mꞌateeb kwidhisiyaayt yꞌagarihoob, ulaga oodhhaab dehaay teharida.’ idi.<verse eid="LUK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31" />Ubaaba ‘Wꞌooruunay! Baruuk kassoohoob gwadu tehaya. Ani abariyeet tuuna kastuuh bariitook tikati. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />Laakiin hiddaab midhadhtiit afirhinayeet toonaati. Usanuuk suur ayaa iifi, tꞌa idhhan, kwidhaa iifi, tꞌa imri.’ idi.” Yasuuꞌa idi.<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">Uwakiil Ootkaal Aagib</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />Yasuuꞌa ikwiriyaatayeeh dehaay: “Gaba tak wakiil iibri iifi. Uwakiil bariiyooh oomraay kwidhisiya miyaadiib atehimamiya. <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />Aflaay uutak uwakiilooh waliikiyaayt, raatiya, ‘Aan ibhali bariiyook eemsiiweeb naanaata? Kassooh ushanhiyook hisaab haay mꞌaa! Baruuk shaawti anii wakiil kitꞌakaya.’ idi.<verse eid="LUK 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3" />Uwakiil ugarooyooh dehaay, ‘Oontꞌa kak saki andi? Ushanhikina ushanhii mhaliiniheeb. Ani toobuur afarriikee dehaay akrir kaabari, aree eenꞌaliyee dehaay asankwꞌi. <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />Ani saki andiyeet toona akteen. Tooy ushanhu eetniiwihoob, uudehay igawaayeehna shuumsiiteheeb itehidirheeb iyadna.’ idi.<verse eid="LUK 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5" />Aflaay baruuh Oodehay wꞌankwanaayuuh siisalfaab iiktiyeeb baliib gaal gaalnaay waliikiya. Baruuh wꞌawwaliib raatiya, ‘Wꞌankwanaayu naan inshiik hook?’ idi.<verse eid="LUK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6" />Uutak ‘Sheeb karoora saytuuni saliitiit inshiikeheeb.’ idi.</para>
  <para style="p" vid="LUK 16:6">Uwakiil ‘Tuwaragaatook abika, willa nꞌati sꞌaa, aree ay tamuun kitiba!’ idi.<verse eid="LUK 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7" />Malya baruuh umalya raatiya, ‘Aree barook naan inshiik hook?’ idi.</para>
  <para style="p" vid="LUK 16:7">Uutak ‘Alif ribꞌa gamhiib.’ idi.</para>
  <para style="p" vid="LUK 16:7">Uwakiil ‘Tuwaragaatook ahaat, asimhay shi kitiba!’ idi.<verse eid="LUK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8" />Ushanhikina uwakiilooh ootkaal aagib daayiib sakaabuuyt yhamid. Uun tuduniyaati dehay tehalaagayteehna tikwuukwiib oonuuri dehayiika fagarakaaba. <verse eid="LUK 16:8" /><verse number="9" style="v" sid="LUK 16:9" />Ani andi hookna, tuduniyaati miraayii araw dehookna dꞌiina! Aflaay baruuh giiginiyihoob, baraakna tikookanii tidaayimaateeb agbilami tiyadna.<verse eid="LUK 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 16:10" />Winneet shaliknaatii dehaay amiin ikatiibka, gwidaanaatii dehaay han amiin ikati. Winneet shaliknaatiib tikaal aagib ikatiibka, gwidaanaatiib han tikaal aagib ikati. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />Aflaay tuduniyaati miraayiib amiinaab bitkaayneek, oomraay usidkiinaay aaw aamaniini hookna? <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />Araweeyookna miraayiib amiinaab bitkaayneek, tibareetookna aaw iniiw hookna?<verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />Gaal kishiya malu ankwana kashagaamiya. Baruuh tari gaal areeyi indi, tari ooraaw aree iirib indi. Tari oongaal daayiib shagaamiini, ooraaw aree abaabiini. Ukwaasanaawwa imhallagaawwa mhalleehna hiddaab shagaamtiib kaꞌadgirtaana.” idi.<verse eid="LUK 16:13" /></para>
  <para style="s">Yasuuꞌa Iideeb Oomiyaad</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />Ifariisi, baliin oomraay areeyiin, beet toona kastooh imaasiwnihoob, Yasuuꞌiib ifaayidna. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />Yasuuꞌa bareeyooh dehaay, “Baraakna oodehayi suurii igarooyeekna daayiinaaytii laween tikwasiina, laakiin Ukwaasana iginꞌaayeekna ikteen. Oodehayi bitik winneet takweet tibariina, Ukwaasanaay suurii atoorbiina tikati. <verse eid="LUK 16:15" /><verse number="16" style="v" sid="LUK 16:16" />Yuuhanna umoosanaay udamaan ookiik, uudehay Muusaay whagwa, inabiyaayi kitabwa isniikarna. Been udamaanii, Ukwaasanaayt hadꞌaayeeti usakana udaayi bhaliimiyanihoob, gaalka shuumiyee dehaay winneet yhariw. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />Gaat nikwta whaggii ikwidhistiika, toobuutwa tibreeti kwidhisti laamakaabi.<verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />Tak takatooh fidigtiit, weet safiiniyeek, been baruuh jikuun ikwasi. Takat fiduugiit safiiniib uutak han jikuun ikwasi.” idi.<verse eid="LUK 16:18" /></para>
  <para style="s">Ootak Ugabaabwa Lꞌaasirwa</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />Yasuuꞌa, “Gaba tak winneet daawri halaka alyaab iitkwi iifi. Baruuh timꞌariitiib hooy daayiit tami. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />Oon ootaki dheefaay suurii tak miskiin Lꞌaasir iidneeb, ubashar kassuuh adilꞌiit ataab iiktiyeeb iifi. Oon ootak ugabaanaay gawi dheefa beeti haay eeyaan. <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />Uun baruuh ootak ugabaanaayt timꞌariitii dhibtiit toona tamiyeet yhiriw. Ubashar adilꞌiit ataabuuyt, aayas aree yꞌiit tꞌadilꞌi iilhisiin.<verse eid="LUK 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22" />Uun uutak umiskiin iyanihoob, imalak barooh yakisiyaaniit Ibraahiimi daraag daasiyaan. Malya uutak ugaba han iyaayt itoobaas. <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />Uutak toonꞌi daamiya. Akraab lhamaa asti iishbibihoob, Ibraahiim hooy sagii rhiya. Aree Lꞌaasir bariiyooh daraag rhiya. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />Aflaay baruuh Ibraahiimii dehaay, ‘Baabu Ibraahiim, arhamaaheeb! Lꞌaasir anii dehaay diigwata! Tugiibalaaytooh yameeb daasiit, umiidalaabu balꞌasi, ani toon tunꞌeetiib akra gwirhaayeeb eefi.’ idi.<verse eid="LUK 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25" />Laakiin Ibraahiim igwibi, ‘Wꞌooruun, baruuk tuduniyaatiib tidaayiinayteek tiyhaneet toona shꞌaa. Lꞌaasir aree beenhoob amagnayt iyhi. Laakiin amsi baruuh daayiib eefee, aree baruuk lhamtiniya. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />Aree kastooh toon toonaati geeb, hininwa bareekwa win deela ibitkeen daamaabi. Aflaay tooysii bareekna beeti giigtiib yhariw baliin kaꞌadgiriyaana, tari beentooysii hinin beeti whasamti gaal han kaꞌadgiriya.’ idi.<verse eid="LUK 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27" />Malya uutak ugaba, ‘Baab, aflaay winneet hook aharriiw, Lꞌaasir baabiyu oogawii dehaay diigwata! <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />Ani ay sana abari. Barooh bareeh beeti diigwata, winneet sooyiiniyeet toonaatu, aflaay baraah han oon wꞌadaabi mhiin beeti biiyꞌayneet toonaati.’ idi.<verse eid="LUK 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29" />Ibraahiim igwibi, ‘Isanaayaak Muusaabwa inabiya eerawwa ibariin. Bareeh baꞌisniikarna.’ idi.<verse eid="LUK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30" />Malya uutak ugaba, ‘Een kiikeen, Baabu Ibraahiim! Tak gaal oodehay wꞌayaanaay yakiit bareeh eebiyeek, baraah Ukwaasanaay dehaay itꞌigir iyadna.’ idi.<verse eid="LUK 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31" />Ibraahiim bariiyooh dehaay, ‘Baraah Muusaabwa inabiyaawwa biisinaakiirneek, aya tak gaal yakiit eebiyeek han, kiisinaakirna.’ idi.” Yasuuꞌa idi.<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">Idanuubwa, Wꞌiimaanwa, Tuwaajibwa</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />Yasuuꞌa ikwiriyaatayeeh dehaay, “Oodehay tumaagnaay isidꞌiint taana kassoohoob ibakii daayeen. Laakiin bariiyooh geebii timaagnay ikatiineeb unafar been idhikw! <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />Een bareeh idabalooya maagnaayti sakistiika, baruuh tꞌalaatiyooh riyaati awi hakwiriit, oobhariib dhibiiniyeek dehaay hanyiis. <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" />Aflaay igarooyeekna gwꞌadna.</para>
  <para style="p" vid="LUK 17:3">Usanuuk maagnaayt sakiiniyeek, barooh dinina, aree tuubiiniyeek barooh afooya! <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />Baruuh asarama doora oombꞌii kehook aglitiiniyeek, aree asarama doora dehook agartiit, ‘Tuuban!’ indiyuuk, barooh afooya.” idi.<verse eid="LUK 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />Ilinguumiya Wꞌankwanaay dehaay, “Wꞌiimaanoon shaawa!” idiin.<verse eid="LUK 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6" />Wꞌankwana igwibi, “Aan baraakna dabalu iimaan isinfaayt habbaati haddiib tibariineek, oon whindi ubidhdhigilii dehaay, ‘Fitaka! Oobhariib yakaa!’ tiyadneek, isnaakiir hookna.<verse eid="LUK 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />Gaal bareesookna tudirꞌaatiib shagaamiini kishiya tari tꞌanu dirmiiniib ibariyeek, baruuh tudirꞌaatii itꞌagiirihoob, bariiyooh dehaay, ‘Eetaneena! Mꞌaa shuumaa! Mꞌariit tamaa’ indi han? <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />Abadan een kiidi. Baruuh ukishiyaay dehaay, ‘Aniib oodraar soomira, uknaayuuk maraa, ani tamaniyeebwa gwꞌaniyeebwa ookiik hagitaheeb. Beenaay harꞌii, baruuk tamtiniya aree gwꞌitniya!’ indi. <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />Ukishiya toona tusoomamaab iiktiyeeb dꞌiyaabuuyt, baruuh barooh hammiid han? <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />Aflaay baraakna han bak tikatiina. Baraakna toona tusoomamaab tikatiineet kastooh daateenihoob, malya ‘Hinin takweet baabari kishiyaaba, tuwaajibtoon toobhaat nidꞌi.’ diina.” idi.<verse eid="LUK 17:10" /></para>
  <para style="s">Tamin Da Bhadhiyay</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />Yasuuꞌa Algudus beeti sakee, Saamiraabwa Jaliilwa eebtik yhiduudee hasamiya. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />Gariyaat gaat shuumiyaneeb oodoor, bhadh iibriin tamin da barooh yꞌashishniit isgiini ingadna. <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />Baraah tageega hissii, “Yaa Yasuuꞌa, Wꞌankwana! Arhamaa hoon!” idiin.<verse eid="LUK 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14" />Yasuuꞌa bareeh rhiyihoob, “Giigaana! Igarooyeekna ifagiiriya rhisaana!” idi. Aree giigiinihoob, baraah inhasna.<verse eid="LUK 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15" />Gaal bareesooh inꞌireet toona rhiyanihoob, tageegi hissii Ukwaasana hamdee yꞌagar. <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />Baruuh Yasuuꞌiib iragadaayi suurii dhibiyaayt, barooh yhamid. Been uutak aree Saamiriibi.<verse eid="LUK 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17" />Yasuuꞌa raatiya, “Aanda itamin kassaah inꞌirna? Aaraw yꞌashshadhig keeyaana? <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />Oon barooh ugirbaab baakaay, weer yꞌeetiit, Ukwaasana yhammiid kiihaay han?” idi. <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />Malya baruuh bariiyooh dehaay, “Yakaat giiga! Wꞌiimaanuuk mheeliya hook.” idi.<verse eid="LUK 17:19" /></para>
  <para style="s">Ukwaasanaayt Hadꞌaayeeti Wꞌaay</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />Fariisi gwadi, Ukwaasanaayt tehadꞌaayi naadoor eetniyeeb Yasuuꞌaab sakanaayaan. Baruuh igwibi, “Ukwaasanaayt tehadꞌaayi baraakna rhiteeneet hayꞌaatii kaꞌeeta. <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />Batuuh ‘Beetee, tuuntee’ iyadneena kitti. Ukwaasanaayt tehadꞌaayi tooy geebookna teefi.” idi.<verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />Malya ikwiriyaatayeeh dehaay, baruuh “Door yꞌi indi, baraakna Wꞌaadami Ooriit tiyinaateeb yint gaanaati rhiti minniimi tiyadna, laakiin batooh rhi kitdiina. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />Gal bareeyookna dehaay, ‘Beentooy shibibna! Tooy shibibna!’ iyadna. Baagiigaana aree bareeh baaraamna. <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />Teebri dar gaalnaay ooraaw ookiik talawiiniib utalawiit, Wꞌaadami Oori bꞌi han bak iikti indi. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />Laakiin baruuh awwal ibakii gwidaana lhamiiniyeet toonaatu aree uun uutaas barooh eeribneet toonaati.<verse eid="LUK 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26" />Noohiib udamaaniib tikeet toonaatiit, Wꞌaadami Oori damaaniib han bak iikti tindi. <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />Been udamaan Nooh falluukaat yꞌameeb hadiit, uudehay tamiina, gwꞌiina, aree iidꞌirna. Malya uukwaan eeyaayt bareeh kasseeh kwidhisiya.<verse eid="LUK 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28" />Tari Luutiib udamaaniib han, bak tꞌiiteena tiki. Uudehay tamiina, gwꞌiina, bꞌiishraayiina, yꞌiidna, aree gawaab iidꞌirna. <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />Laakiin tooyin Luut Sadoomee ifirꞌeeb, Ukwaasana tibreetee nꞌeetwa kwibriitwa dehaay isiisiyaam, aree oodehay kassooh idaar.<verse eid="LUK 17:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 17:30" />Wꞌaadami Oor lawiiniyeet tooyin, toon tꞌiiteena iikti tindi. <verse eid="LUK 17:30" /><verse number="31" style="v" sid="LUK 17:31" />Beet tooyin oogawi kehii eefi gaal, igadhꞌaah ugawiit hooyteeb eefeeneeb, nꞌati tikwiit ibakii bareeh kiiyhi. Tudirꞌaatiib daayiiniib naatii dehaay han ibakii harꞌa kiiꞌagar! <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />Luutiit tutakatii dehaay tikeet toona shꞌaana! <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" />Umidhhanooh ooknaay dibuuy jarrabiiniibka, umidhhan iitnaw indi, umidhhanooh eetniiw aree umidhhanooh idaab indi. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />Ani andi hookna, been whawaad maloobka gaal nꞌaaliib diwi iyadna. Uungaal yakami indi, aree uuraaw ituuꞌish indi. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />Maloot mꞌatka hiddaab gaat riyaatiib huugi iyadna, tuungaat yakami tindi, aree tuuraaw ituuꞌish tindi. <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />Malu da gaat dirꞌaatiib daayeena, uungaal yakami indi, aree uuraaw ituuꞌish indi.” idi.<verse eid="LUK 17:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37" />Ikwiriyaatay barooh raatiyaana, “Wꞌankwanaay, naamhiin iikti tindi?” idiin.</para>
  <para style="p" vid="LUK 17:37">Yasuuꞌa igwibi, “Tumisuusinnaay daatniyeeb oomhiin, bꞌanoob itdibil iyadna.” idi.<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s">Tꞌibraatfaatkiiwwa Ugaadi Mitaalwa</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />Malya Yasuuꞌa ikwiriyaatayeeh dehaay mitaal hadiidiya. Nigwooy baadi diimaab siileeleeneet toona bareeh sooya. <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />Baruuh “Madiinaat gaanaatiib Ukwaasana baaraakwi gaadi, oodehay baaꞌamshabiib iifi. <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />Beet tumadiinaatiib ibraatfaatkiit oon ugaadii dehaay yꞌeetiit, ‘Ugariimiyu kehii adli hukwim amarriyeet toona aharriiw’ tidi.<verse eid="LUK 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 18:4" />Ugaadi door gaal naat oodꞌuuy dehaay irib. Laakiin malya baruuh ugarooyooh dehaay, ‘Ani Ukwaasana baarakwiyeek han, tari oodehay baaꞌamshabiibeek han, <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />laakiin toon tutakat diimaab aneeb gallabtiniit, wꞌadil marriyeet toonaatiib iishtam andi. Aflaay batuuh girmaayt hawriik hoosu iikti kitdi.’ idi.” idi Yasuuꞌa.<verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />Wꞌankwana masi, “Ugaadi udaalim indiyeet toona sinaakirna. <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />Ukwaasana udehayooh iwaasamaab diima whawaadwa oombꞌeewwa barooh waliikeen baliib wꞌadlii haakamiiniyeet toona kitti han? Bareeh willa dehaay gwanbiyeet toona kitti han? <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />Ani andi hookna, uudoor yꞌiiniyihoob, baruuh willa bareeh wꞌadlii haakamiini. Laakiin Wꞌaadami Oor yꞌiiniyihoob, tubuutiib iimaan imaar indi?” idi.<verse eid="LUK 18:8" /></para>
  <para style="s">Ufariisiiwwa Utilbaat Tamanaaywa Mitaal</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />Dehay gali igarooyeehna oodehay iraweeka hayiskaab hiisiina, aree oodehay eeraw kasseeh abaabiin. Yasuuꞌa bareeyooh dehaay een eemtaal hadiidiya: <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />“Malu da Ukwaasanaay gawiib siileeltiib yhiriwnayt, asti reewiyaan. Uungaal Fariisiibu, uuraaw tilbaat tamnaabi. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" />Ufariisi yakiyaayt ugarooyooh dehaay bak idiit siileeliya, ‘Ukwaasanaayu, ahamid hook, ani oodehay eeraw tꞌiiteeb kaaki - igwiharanaawwa, toomaag sakanaawwa, ijakiinaawwa tꞌiiteeb kaaki. Tari oon utilbaat tamana tꞌiiteeb han kaaki. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />Ani malu doora tꞌasaramaatiib baaskiitani. Kastooh toona tꞌamarriyeetiib titamnaat takwi hooy mhalani.’ idi.<verse eid="LUK 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13" />Laakiin utilbaat tamana sagi mhiin ingadaayt siileeliya. Baruuh teebri beeti han nakamaab kiiki. Laakiin iginheeh ithꞌaayt, ‘Ani amaag sakan, Ukwaasanaay arhamaaheeb.’ idi.<verse eid="LUK 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 18:14" />Ani andi hookna: Uun uutak utilbaat tamana Ukwaasanaay suurii shibooba ugawooh ibi. Laakiin Ufariisi shiboobaab kiiki.</para>
  <para style="p" vid="LUK 18:14">Ugarooyooh tageegsiiniibka miskiinami indi, ugarooyooh miskiin ikwasiibka tageegi indi.” idi.<verse eid="LUK 18:14" /></para>
  <para style="s">Yasuuꞌa Yꞌar Idabalooya Baarakiya</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />Dehay gali inisrikaayeehna isidehirnee Yasuuꞌii dehaay haay eeyaan. Laakiin ikwiriyaatayaah een rhiyaanihoob, bareeh idninna. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />Yasuuꞌa yꞌar waliikiyaayt, “Yꞌar aneeb beeti suurbeena. Bareeh hassaana, baaꞌafiina! Een bareeh tꞌiiteeb Ukwaasanaayt tehadꞌaayi bareetooh tikati. <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />Oosdik andi hookna, Ukwaasanaayt tehadꞌaayi oon wꞌoor udabalu tꞌiiteena baaꞌashiishka, batooh door han shuumi kiidi.” idi.<verse eid="LUK 18:17" /></para>
  <para style="s">Whaakim Ugabaab</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />Haakim gaal Yasuuꞌaab raatiya, “Seedna udaayi! Umidhhan udaayim amarriyee dehaay ibakii naan sakaniyeet toonaatu?” idi.<verse eid="LUK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19" />Laakiin Yasuuꞌa, “Naanhooy ‘Udaayi’ tindiyaheeb? Ukwaasana oongaal nuun weer daayi kiihaay. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />Baruuk tiwasi tikteena: ‘Baajakiina, baadira, baagwihaara, gwisreet badeha baahadiida, baabookwa deetookwa haamooysa!’ iyadna.” idi.<verse eid="LUK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21" />Uutak, “Teen tiwasi kasteeh ani dabalu oor iiktiyi door haay shagaami.” idi.<verse eid="LUK 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22" />Yasuuꞌa een ibhali imaasiwihoob, bariiyooh dehaay, “Gaana masi hook nakwistu, kassooh oomraay itibariyeeb daalbaat, malyaab imhallaga oodehay imiskiina hiiyya! Aree baruuk tibreeteeb miraay imaar tindiya. Beenaay harꞌii mꞌaat aneeb ramaheeb!” idi.<verse eid="LUK 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 18:23" />Uutak een ibhali imaasiwihoob, winneet gaba takuuyt, akraab yhasi. <verse eid="LUK 18:23" /><verse number="24" style="v" sid="LUK 18:24" />Yasuuꞌa utakiit hasiyaay rhiyihoob, “Oodehay igabaab Ukwaasanaayt hadꞌaayeeti shuumti dehaay akraabu! <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />Uudehay igaba Ukwaasanaayt hadꞌaayeeti shuumtiika, kaam miilaltiit tilꞌiiti whassiti laamakaabu.” idi.<verse eid="LUK 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26" />Een ibhali imaasiw baliin raatiyaana, “Aflaay aaw adgiriit iidhhan indi?” idiin.<verse eid="LUK 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27" />Yasuuꞌa igwibi, “Uudehay biiꞌadgirayneet toona Ukwaasanaay geeb adgiramtini.” idi.<verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />Bitrus bariiyooh dehaay, “Hinin barook neetriimi jillaay niibriyeena kastooh ishaaba!” idi.<verse eid="LUK 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29" />Yasuuꞌa bareeyooh dehaay, “Oosdik andi hookna, tak gawooh, tari takatooh, tari isanaayeeh, tari ifarooyeeh, tari yꞌareeh Ukwaasanaayt hadꞌaayeeti jillaay inꞌiish, <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />oon udamaan oonaay gwidakaana imaar indi. Aree gayii yꞌiiniib udamaaniib umidhhan udaayim imaar indi.” idi.<verse eid="LUK 18:30" /></para>
  <para style="s">Yasuuꞌa Masi Tuyatooh Isrid</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />Malya Yasuuꞌa itamna malu eebhat iyhaayt bareeh sooya, “Oontꞌa Algudus beeti saknay, inabiya Wꞌaadami Ooriib iktibneet tuuna kastuuh iikti tindi. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />Baruuh Ijintiili ayeeb daasami indi. Baraah barooh haay kashi iyadna, barooh neewi iyadna, bariiyooh kehii tifi iyadna. <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />Malya barooh iithꞌa iyadna aree idaar iyadna. Laakiin tooyin tumhaya baruuh tuyatii yaki indi.” idi.<verse eid="LUK 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34" />Ikwiriyaatay een ibhali naat han hooy afhamaab kiikeen. Beet tuuna bareesooh kwabaastu, aree baraah baruuh naanaatiib hadiidiyeeb kanaab kiikeen.<verse eid="LUK 18:34" /></para>
  <para style="s">Yasuuꞌa Hamashay Tak Nꞌaliigaab Mheeliya</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />Yasuuꞌa Ariihaab iidneet madiina idwilihoob, tak hamashay usalali daraag iistꞌa oodehay iinꞌal iifi. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />Uun uutak gwida dehay hasamiinaayi hiss imaasiwihoob, baruuh naan tiiktiyeeb sakanaaya. <verse eid="LUK 18:36" /><verse number="37" style="v" sid="LUK 18:37" />Baraah barooh sooyaana, “Yasuuꞌa Unaasiraayi tooysii hasamiini.” idiin.<verse eid="LUK 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38" />Uutak tageega hissii waliikiya, “Yasuuꞌa, Daawidi Oor, arhamaaheeb!” idi.<verse eid="LUK 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39" />Uudehay Yasuuꞌaay suurii sakiin baliin, tim iiktiyeet toonaati jillaay barooh idninna. Laakiin baruuh winneet masi waliikiya, “Daawidi Oor, arhamaaheeb!” idi.<verse eid="LUK 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40" />Yasuuꞌa ingadaayt, been ootak haay yꞌeeneet toona galib sooya. Uutak idwilihoob, Yasuuꞌa barooh raatiya, <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />“Naan harriiwa? Naan dehook sakani?” idi.</para>
  <para style="p" vid="LUK 18:41">Uutak, “Wꞌankwanaay, ani rhaniyeet aharriiw.” idi.<verse eid="LUK 18:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42" />Yasuuꞌa bariiyooh dehaay, “Shibiba aree rhi tindiya! Wꞌiimaanuuk isinꞌir hook.” idi. <verse eid="LUK 18:42" /><verse number="43" style="v" sid="LUK 18:43" />Uutak igidiyeesooh rhiyaayt Yasuuꞌaab iram, aree Ukwaasana yhamid. Uudehay kassaah toona tutikeet rhiyaanihoob, baraah han Ukwaasana yhamidna.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">Yasuuꞌaawwa Utilbaat Tamanaawwa</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />Yasuuꞌa malya Ariihaab shuumiyaayt hasamiya. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />Been oomhiin itilbaat tamanaayi suurkina iikti, Sakkaa iidni tak, winneet gaba iifi. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />Baruuh Yasuuꞌa aab iiktiyeeb rhiyeet yhariw. Laakiin baruuh nakash taku aree uudehay gwidaabayt irhiti adgiraab kiiki. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />Aflaay baruuh oodehayi suurii dhaabiyaayt, been usalalii hasamiib Yasuuꞌiib irhiti jillaay hindiib reewiya.<verse eid="LUK 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5" />Yasuuꞌa been oomhiin iktimihoob, asti ishbibaayt bariiyooh dehaay, “Sakkaa Willa gideha! Ani amsi ibakii bariiyook ugawiib iignif andi.” idi. <verse eid="LUK 19:5" /><verse number="6" style="v" sid="LUK 19:6" />Aflaay Sakkaa winneet ashshigee igidehaayt, afirhaa barooh yꞌashish.<verse eid="LUK 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 19:7" />Beet toona rhiyaan uudehay kassaah iikwiyaaniit, “Danuubi taki geeb amnaab iiktiyi jillaay giigiya.” idiin.<verse eid="LUK 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8" />Laakiin Sakkaa ingadaayt, Wꞌankwanaay dehaay, “Wꞌankwanaay, shibiba! Ani oomraay wꞌabariyeeb itarab oodehay yhamraab aniiw, aree gaalnaay han gwisree mhallagaab ahaab akatiyeek, baliin imhallagaayeeh fadhig haddiina dehaay ikwaas andi.” idi.<verse eid="LUK 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9" />Yasuuꞌa bariiyooh dehaay, “Uun uutak han Ibraahiimi ooruuyt, amsi umidhhan oon oogawii dehaay yꞌaabi. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />Wꞌaadami Oor oodehay ikwidhaab hariwtiit ishidhhiini jillaay yꞌaabi.” idi.<verse eid="LUK 19:10" /></para>
  <para style="s">Ikishiya Itamni Mitaal</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />Baraah een ibhali sinaakiree, Yasuuꞌa bareeh mitaal dehaay hadiidiya. Baruuh Algudus idwilayt, uudehay Ukwaasanaayt tehadꞌaayi gaalhoob lawtiyeeb hiisiyaan. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />Yasuuꞌa “Amiir gaal sagi haash beeti iibaabiya. Baruuh beentooy hadꞌaab akeetiit malya itꞌigireet toona yhiriw. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />Aflaay baruuh ikishiyaayeesooh tamin waliikiyaayt, bareeh tamin dimꞌaraay mhallaga yhii. Baruuh bareeyooh dehaay, ‘Een imhallaga ani atꞌagiireeb hadiit haay tijirna.’ idi.<verse eid="LUK 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14" />Laakiin whaashiyuuh dehay barooh iribniit bariiyooh harꞌii diigwatkinaab ifdigna, ‘Uun uutak hadꞌaayoon ikatiyeet kinhariw.’ idiin.<verse eid="LUK 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15" />Baruuh hadꞌaab ikaayt yꞌagar. Malya baliib ikishiyaayeeh imhallaga hiiyyaab iiktiyeeb waliikisiyaayt, imhallagaayeehna naan haay rayiimiyaaneeb kanaant yhariw.<verse eid="LUK 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16" />Wꞌawwali eeyaayt, ‘Duuruun, ani imhallagaayeek tamin doora haddi mhallaga haay rayiiman.’ idi.<verse eid="LUK 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 19:17" />Whadꞌa ‘Daayiib tiweera, baruuk daayi kishiyaawwa! Shalik naatii usidkook rhista akay, tamint madiinaati waali iikti tindiya.’ idi.<verse eid="LUK 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18" />Ukishiya umalya eeyaayt, ‘Duuruun! Imhallagaayeek ay doora haddi mhallaga haay rayiiman.’ idi.<verse eid="LUK 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 19:19" />Whadꞌa ‘Baruuk han ayt madiinaati waali iikti tindiya.’ idi.<verse eid="LUK 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20" />Malya kishiya weer eeyaayt, ‘Duuruun! Imhallagaayaak tooy eefeen. Ani halakiit fardaatiib adbi. <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />Baruuk akra takwa akay, ani arkwi hook. Baruuk araawiitook harriiwa, abiiyeek teeraayaab bitkaayi harru tinwiika.’ idi.<verse eid="LUK 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22" />Whadꞌa bariiyooh dehaay, ‘Baruuk ukishiya wꞌamaag! Ibhaliyeek iknaayee haakami hook andi. Ani akra tak akatiyeet toona baruuk tiktiina, araawiitu aharriiweet toona tiktiina, teeraayaab baakaayeet dirꞌa anwiikeet toona tiktiina. <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />Aflaay aniib imhallaga naanhooy ubankiib daasaab kittaa? Shaawti ani itꞌigirihoob, imhallagaayi maksab hooy imiir.’ idi.<verse eid="LUK 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24" />Malya baruuh beentooy ingid oodehayii dehaay, ‘Barooh idimꞌaraay mhallaga hooy ahaanaat, imhallaga itamin ibariib ootak hiina!’ idi.<verse eid="LUK 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25" />Baraah ‘Duuruun! Laakiin baruuh tamin mhallaga ibari.’ idiin.<verse eid="LUK 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 19:26" />Whadꞌa igwibi, ‘Ani andi hookna, uutak wꞌibariib gwidaana ittiyiw indi, laakiin beeb naat baabariib, tuuna tꞌibariyeet han hooy yakami tindi. <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />Laakiin aniib yꞌashu baliib ani hadꞌaayoohna iiktiyeet toona iirib, bareeh tooy haay mꞌaana. Aree bareeh anii suurii daarna.’ idi.” Yasuuꞌa idi.<verse eid="LUK 19:27" /></para>
  <para style="s">Yasuuꞌa Algudus Ansiramaa Shuumiya</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />Yasuuꞌa een ibhali idiit harꞌii, bareeyooh suurii Algudus beeti asti hasamiya. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />Baruuh ukanbuul Isaytuuni Riba ittiyoodiinaay kehii iifiint timadiina Beetfaageewwa Beetaanyaawwa idwilhoob, Yasuuꞌa ikwiriyaatayee maloob diigwatiya. Bareeyooh dehaay, <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />“Beet tugariya suurookna teefeet beenaat, batooh shuumteenihoob, halkwiib hakwaar, oonaay suurii tak amaab biikaayeeb timeerna. Barooh fidignaat tooy haay mꞌaana! <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />Gaal raatiiniyuukna, ‘Naanhooy whalkwi tifadigna?’ indiyuukna, barooh sooyaana, ‘Wꞌankwana yhariw’ diina!” idi.<verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />Baliin ikwiriyaatay imalu giigiyaanihoob, Yasuuꞌa bareeh sooyaab iiktiyeet toonaatiit imriin. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />Baraah whalkwi fidgee, yꞌankwanaayaah eeyaaniit bareeh raatiyaana, “Whalkwi naanhooy tifadigna?” idiin.<verse eid="LUK 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34" />Ikwiriyaatay igwibiina, “Barooh Wꞌankwana dehaay ishinha.” idiin.<verse eid="LUK 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 19:35" />Malya whalkwi Yasuuꞌii dehaay haay eeyaaniit, yhalakaayeehna kehii daasiyaaniit, Yasuuꞌaab isꞌamna. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />Baruuh sakee, uudehay yhalakaayeehna usalaliib ibrirna.<verse eid="LUK 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37" />Yasuuꞌa Algudus idwili mhiin, oorba Saytuunii tikwiib usalaliib, kasteeh timꞌuujisa tirhiyaaneenaati sabbii Ikwiriyaatay kassaah tageega hisaayee Ukwaasana yhamidna:<verse eid="LUK 19:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LUK 19:38" />“Wꞌankwanaay simii yꞌiiniib whadꞌa been baarakamaabu!</para>
  <para style="b" vid="LUK 19:38" />
  <para style="q1" vid="LUK 19:38">Umꞌasig tibreeteeb aree umatuun Ukwaasanaayu.” iidna.<verse eid="LUK 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />Laakiin udehayiib Fariisi gali Yasuuꞌii dehaay, “Seedna, ikwiriyaatayeek dininaa.” idiin.<verse eid="LUK 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40" />Yasuuꞌa igwibi, “Ani andi hookna, aan baraah dineeneek han, yꞌawi waliiki iyadna.” idi.<verse eid="LUK 19:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />Yasuuꞌa Algudus idwilaayt, tumadiina rhiyihoob, batiiyooh dehaay waawiya. <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />Baruuh “Baabiya, batuuk han oon amsi umꞌasig haay eetniit toona toobhaat kanaat tiiktiyi! Laakiin beet tuuna hook kwabaasti. <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />Damaan yꞌi hook indi, yꞌashooyaak kirraab kehook kwililti shagaami iyadna, itkwilil hook iyadna, aree kasteeh tijhaatee assi hook iyadna. <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />Tubuuti kehii dhibsi hook iyadna, kasseeh udehayook ikirraayeek tehooyteeb eefeen idaar iyadna. Baraah taktaki kehii aweeb han kehook iiyꞌish kiidiin. Ukwaasana batook ishidhhin miyaadiib yꞌaab iiktiyeeb udamaan kanaat kittaayayt, beet tuuna iikti tindi.” idi.<verse eid="LUK 19:44" /></para>
  <para style="s">Yasuuꞌa Ukwaasanaay Ugawiib</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />Malya Yasuuꞌa udiini gaw shuumiyaayt, oodehay ibꞌiishraayiin mhaltiib badooya. <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />Yasuuꞌa, “Aan ibhali uktaabiib kataba, ‘Ugawu siileelti gawu, ibꞌiishraati mhiin kiiki.’ diyaabu, laakiin baraakna igwiharaay amar tikwaasna.” idi.<verse eid="LUK 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47" />Bꞌeebka Yasuuꞌa Ukwaasanaay gawiib allami. Ifagiiriya isuurkinaawwa, whaggi koojaawwa, oodehayi suurkinaawwa Yasuuꞌi madar yhariwna. <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />Uudehay kassaah barooh akraab isniikarneet yhiriwnayt, bariiyeeh imadar adgiraab kiikeen.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">Yasuuꞌiit Tehadꞌaayi Raatamta</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />Yint gaat Yasuuꞌa oodehay allami. Ukwaasanaay gawiib usakana udaayiib hadiidi. Ifagiiriya isuurkinaawwa, whaggi koojaawwa, oodehayi eegrimaawwa, bariiyooh dehaay eeyaaniit raatiyaana, <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />“Teen teena naat hadꞌaayeetii saktiniya? Sooyaa hoon! Aree toon tehadꞌaayi aaw yhii hook?” idiin.<verse eid="LUK 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3" />Yasuuꞌa bareeyooh dehaay, “Ani han bareekna gaana raati hookna andi, beet sooyaanheeb! <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />Yuuhannaab umaasi hag aaw yhii? Ukwaasana tibreeteeb eefeeb kiiki han, tari oodehayu?” idi.<verse eid="LUK 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />Baraah taktaki geeb bhaliiyaaniit, “Beet toona Yuuhannaab Ukwaasana yhii niyadee dehaay kaꞌadgirna. Een niyadeek, aflaay ‘Naanhooy aamanaab kitteena?’ iyaad hoon indi. <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />Laakiin ‘Barooh uudehay yhii’ niyadeek, uudehay Yuuhannaab unabiit aamaniinayt, baraah kassaah aweeyee geedi hoon iyadna.” idiin.<verse eid="LUK 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 20:7" />Aflaay baraah Yasuuꞌii dehaay, “Hinin Yuuhannaab umoosti hag yhiib kinkan.” idiin.<verse eid="LUK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8" />Yasuuꞌa bareeyooh dehaay, “Ani han naat hadꞌaayeetii teen teena sakaniyeeb sooyi hookna kaadi.” idi.<verse eid="LUK 20:8" /></para>
  <para style="s">Ikiraaykinaayi Mitaal</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />Yasuuꞌa oodehay een eemtaal dehaay hadiidiya: “Tak dirꞌaatooh yꞌadiit dirꞌaatkinaab galinee dehaay ikiri. Malya gwida daman yꞌish iibaabiya. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />Shaawti uwaaki door, baruuh tudirꞌaatiit firꞌaaytii naat iyawni jillaay kishiyaab gaal ikiraaykinaayee dehaay diigwatiya. Laakiin ikiraaykina barooh ithꞌaniit harar ayee giigisiyaan. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />Malya baruuh masi weer kishiya diigwatiya. Laakiin baraah oon han ithꞌaniit amaag iweerniit harar ayee giigisiyaan. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />Baruuh masi mhayaab diigwatiya. Aree baraah barooh wookiyaaniit barraab igidna.<verse eid="LUK 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13" />Malya tudirꞌaati ankwana, ‘Kak saki andi? Wꞌooru beeb wꞌareeyaniyeeb diigwati andi. Baraah kisib barooh hamooysi iyadna.’ idi.<verse eid="LUK 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14" />Laakiin ikiraaykina barooh rhiyaanihoob, gal eeraw infaraadna, ‘Uun baruuh ukwasaamana ikati. Barooh nidaar, malya tudirꞌa hinin kwasaami niyad.’ imsiyoodaayna. <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />Aflaay baraah barooh tudirꞌaatii barraab igidniit idirna.</para>
  <para style="p" vid="LUK 20:15">Malya tudirꞌaati ankwana yꞌiiniyihoob, bareeh naan iiwari indi? <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />Baruuh yꞌiit baliin ikiraaykina idaar indi. Malya tudirꞌa warib iyaaw indi.” idi.</para>
  <para style="p" vid="LUK 20:16">Uudehay een ibhali imaasiwnihoob, baraah “Tuun door han bitꞌakaayeet toonaati.” idiin.<verse eid="LUK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17" />Laakiin Yasuuꞌa bareeh ishbibaayt, “Aflaay iktabeeb katab ibhali naan isehariiwna:</para>
  <para style="q1" vid="LUK 20:17">Aaktab ‘Wꞌawi idꞌaariiga iribneeb,</para>
  <para style="q2" vid="LUK 20:17">oorkwini awi oogaw yaksiiniib iki.’ iyadna.<verse eid="LUK 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18" />Been wꞌawii kehii dhibiiniibka katꞌamiit firkak iikti indi. Laakiin uun wꞌawi kehii dhibiiniyeeb been huugami indi.” idi.<verse eid="LUK 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />Whaggi koojaawwa ifagiiriya isuurkinaawwa, aan aamtaal bareeyooh dehaay attiyoodiyaab iiktiineet toona ikannayt, willa barooh haay yꞌibikni salal yhariwna. Laakiin baraah oodehay irkwiin.<verse eid="LUK 20:19" /></para>
  <para style="s">Gaysarii Dehaay Tilbaati Kwisuuy</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20" />Baraah Yasuuꞌaab winneet igwꞌadna. Baraah jaasuusaab, daayi da massalamiin diigwatiyaan. Baraah Yasuuꞌaab bhaliyeeb abiktiit aflaay barooh Iroomaani haakim nuuntiib yhiriwna. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />Aflaay aan ijaasuusa barooh raatiyaana, “Seedna, baruuk oosdik hadiidtiniya aree allamtiniya, girad anu han Ukwaasanaay usalal usidkiib allamtiniyeet toona nikteen. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />Aflaay Gaysar Iroomaani titilba dehaay nifarꞌeet tuuna halaal han kitti?” idiin.<verse eid="LUK 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23" />Yasuuꞌa baraah een ibhali naan haay isehiriwneeb ikanaayt, bareeyooh dehaay, <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />“Oon udiinaar rhisaanaheeb! Aan aafiirwa, uusimwa aaya?” idi.<verse eid="LUK 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25" />Baraah “Gaysariiba.” idiin.</para>
  <para style="p" vid="LUK 20:25">Yasuuꞌa “Aflaay Gaysarii dehaay, Gaysariit toona hiina! Ukwaasanaay dehaay, Ukwaasanaayt toona hiina!” idi.<verse eid="LUK 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26" />Baraah oodehayi suurii barooh naat hadiidee hooy dhibsiini sharaki dꞌuuy adgiraab kiikeen. Baraah bariiyeeh ibhaliyi diguuyiib winneet ajjabamiyaaniit tim ikeen.<verse eid="LUK 20:26" /></para>
  <para style="s">Oodehay Wꞌayaanaay Yak</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />Sadduuki gali yak weer kiihaay iidna, Yasuuꞌii dehaay eeyaaniit raatiyaana, <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />“Seedna, hinin Muusa dehoon iktib, ‘Tak sanuuh dꞌiraab ar baabariib iyaayeek aree takat inꞌiisheek, sanuuh weer tootakat indꞌiir. Usaniyooh dehaay ar hooy fanri.’ idi. <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />Beentooy asarama sana iifiin. Gaal bareesooh takat idꞌir. Baruuh ar baabari iya. <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />Uusan umalya tootakat idꞌir, uun han firaay anu iya. <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />Masi uusan umhaya aree batooh idꞌir, uun han firaay anu iya. Isana yꞌasarama kassaah hooy imkattaamna. Gaal han firaay ishaab kiiki. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />Aakhir, tutakat han tiya. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />Uuyak daayiiniyihoob, yꞌasarama kassaah batooh idꞌirneek naayiitooh takat iikti tindi?” idiin.<verse eid="LUK 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34" />Yasuuꞌa bareeyooh dehaay igwibi, “Toon tuduniyaati dehay imdadꞌiirna. <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />Laakiin baliin gayii yꞌiiniib udamaaniib takweet imeerwa tuyatii yakeenwa kiiꞌamdadꞌaarna. <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />Baraah imalak tꞌiiteeba, shaawti iiyyi kiidiin. Baraah tuyatii yakaabayt, Ukwaasanaay ar ikatiin. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />Laakiin whindi udabalooy mitaaleeb, yꞌaya tuyatii yakeeneet toona Muusa han rhisiya. Baruuh Wꞌankwanaay dehaay, ‘Ibraahiimiib Ukwaasana, Isehaagiib Ukwaasana, Yaaguubiib Ukwaasana’ idiit waliikiya. <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />Baruuh oodehay yꞌayaanaayi Kwaasana kiiki. Laakiin idhhaniinaayi Kwaasana ikati. Bariiyooh dehaay kassaah dhhaniiba.” idi.<verse eid="LUK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39" />Whaggi kooja gali igwibiina, “Daayiib tidiya, Seednaay!” idiin. <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />Aree gaal han ashꞌaraa masi weena barooh raataab kiiki.<verse eid="LUK 20:40" /></para>
  <para style="s">Umasiih Aay Oor Ikati?</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />Malya Yasuuꞌa bareeh raatiya, “Umasiih kak Daawidi oor ittiyoodi? <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />Daawid uukna tehabayaati kitaabiib:</para>
  <para style="q1" vid="LUK 20:42">‘Wꞌankwana Wꞌankwanaayu dehaay diyaabu:</para>
  <para style="q2" vid="LUK 20:42">umaygwadu sꞌaa!<verse eid="LUK 20:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="LUK 20:43" />Yꞌashooyeek iragadaayeek whii</para>
  <para style="q2" vid="LUK 20:43">usiyaamiit eetameen akwasiyeeb ookiik.’ diyaabi.<verse eid="LUK 20:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />Daawid uukna barooh ‘Wꞌankwana’ waliikiiniyeek, aflaay baruuh kak oorooh ikati?” idi.<verse eid="LUK 20:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />Uudehay kassaah sinaakree, Yasuuꞌa ikwiriyaatayeeh dehaay, <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />“Whaggi kooja hooy digwagwna. Baraah gwimad halakaayee hiireereena, aree usuugiib salaamameeneet toona areeyeena, Iyahuudi diini gawaayeeb timiisꞌanii tidaayikaat yhariwna, aree tꞌaduumaateeb hamooysama mhiinan yhariwna. <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />Tꞌibraatfaatki italisna aree igawaayeehna eesliibna. Oodehayi rarhistiib toosileel isgwamiidna. Bak tꞌiiteeb aanda winneet jasaami iyadna.” idi.<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">Tꞌibraatfaatkiiti Miyaaw</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />Yasuuꞌa asti iishbibi door, gaba da gali Ukwaasanaay gawiib mhallagaab oomiyaawi sanduukiib tuusee rhiya. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />Baruuh masi miskiint ibraatfaatki, maloot neekala usanduukiib daasee rhiya. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />Yasuuꞌa “Oosdik andi hookna, tuun tꞌibraatfaatki tumiskiin kasseeh oodehay iraweeka gwidaka mhallaga daasta. <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />Aan baraah kassaah umraayiitoohna shawaayt ifirꞌana. Laakiin tuun batuuh tumiskiin tutiibriya kastooh tifirꞌa.” idi.<verse eid="LUK 21:4" /></para>
  <para style="s">Yasuuꞌa Ukwaasanaay Ugawi Katꞌamti Whankaay Hadiidiya</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />Gali bariiyeeh ikwiriyaatayee Ukwaasanaay uugaw kak daawri aweeyeewwa, Ukwaasanaay dehaay farꞌama miyaawiiwwa daawriimaab iiktiyeet toonaatiib hadiidiyaan. <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />Yasuuꞌa “Oontꞌa rhiteeneet tuuna, damaan yꞌi indi, gaal awi han uraawi kehii ituuꞌish kiidi. Baraah kassaah dhibi iyadna.” idi.<verse eid="LUK 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7" />Ikwiriyaatay raatiyaana, “Taan taana nhoob iikti iyadna? Taan bataah idwilneet toona naat alaama iikti tindi?” idiin.<verse eid="LUK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8" />Yasuuꞌa igwibi, “Digwagwna! Baaꞌatootaalna. Gwida aniib oosmii yꞌi iyadna, ‘Ani barooh akati.’ iyadna. Aree ‘Udamaan idwil.’ iyadna. Een bareeh baaramna! <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />Finaabwa rookaatwa teemsiiwnihoob, baarakwiina. Taan taana ibakii awwal ikatiin, laakiin igidiyeesooh tꞌaakhari iikti kitdi.” idi. <verse eid="LUK 21:9" /><verse number="10" style="v" sid="LUK 21:10" />Malya baruuh bareeyooh dehaay: “Dehay dehayi kehii fari iyadna, hadꞌaayi hadꞌaayeeti kehii fari tindi. <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />Beentooy akraat buutiit katatanaay iikti tindi, gwida mhiinan hargwiitwa lhanaytwa iikti iyadna. Tisrakwiinaawwa tibreetee wawint alaamaawwa daayi iyadna.<verse eid="LUK 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12" />Laakiin kastooh toonaati hankaay, uudehay ayeeb hookna iidꞌa iyadna, aree amaag waraayi hookna iyadna. Aniib oosmi sabbii aree Iyahuudi diini gawaawwa isijnaawwa beeti nuuni hookna iyadna. Yhadꞌaawwa Yhaakmaayi suuriiwwa haay yꞌi hookna iyadna. <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />Usakana Udaayiib sooteeni jillaay, tuun tuuna fursaatookna tikati. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />Laakiin baraakna whankaay igarooyeekna kak teheebneeb baahasiikna. <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />Ani bhaliibwa fagarandiitwa iyaaw hookna andi. Kassaah yꞌashooyaakna adgiriit imꞌikir hookna kiidiin tari imgwisir hookna kiidiin. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />Ifaroowwa isanaawwa, yꞌayay dehaywa, yꞌarawwa iidlib hookna iyadna, aree galib bareesookna idaar iyadna. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />Anii sabbii uudehay kassaah iirib hookna iyadna. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />Laakiin hamoot han ugirmaayiisookna dhibi kitdi. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />Akirnaat gadna, aree midhhan imaar tiyadna.” idi.<verse eid="LUK 21:19" /></para>
  <para style="s">Algudus Katꞌami Tindi</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />Malya Yasuuꞌa, “Algudus dheesh kwilalee rhiteenihoob, willa katꞌamiiniyeet toona iikan tiyadna. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />Been oodoor Yahuudaay daateeneek, eerba beeti dhaabaana! Tumadiinaatiib daateeneek, ishna giigaana! Barraab yhadabeeb daateeneek, tumadiina beeti baaꞌagaarna! <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />Uun ujasaay damaan iikti indiyeet toona iktabeeb kataabi. <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />Baliin eembꞌi tinakwalayaawwa, yꞌareet dꞌooranaawwa idhikwna! Beentooy whaashiib akra gwirha dhibi iyadna, aree oodehayi kehii Ukwaasanaay gadab daayi iyadna. <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />Baraah bꞌadhdhii ituudir iyadna, aree yꞌabuukiyeet kasseeh idehaya beeti galeelami iyadna. Ijintiili daman timmiimeeneeb hadiit Algudus Ijintiilee eetami tindi.<verse eid="LUK 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />Tuyintiibwa, tutrigtiibwa, yhayikweebwa alaamaat lawi iyadna. Tubuutiib idehaya diinanooyi iyadna, aree oobhar wꞌitragiiswa umoojiiwwa iraakw iyadna. <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />Tuduniyaati kehii iikti tindiit toonaati sabbii, uudehay bꞌiintii darwiiwi iyadna. Tibreeteeb eefeen yꞌakrir digami iyadna. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />Been oodoor baraah Wꞌaadami Oor ibꞌaluukiib akrirwa matuuntiiwwa yꞌee rhi iyadna. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />Laakiin taan taana badooyeeneeb oodoor, umidhhanuukna idwilayt asti gadna aree igirmaayeekna asti abiknaa!” idi.<verse eid="LUK 21:28" /></para>
  <para style="s">Utiini Hindi Mitaal</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />Yasuuꞌa bareeh een eemtaal sooya: “Utiini hindiiwwa, kasseeh yhindi eerawwa shibibna. <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />Whindi teerat yaksiiniyihoob, umhagaayi dawil ikatiyeet toona iknaayaakna tikteenna. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />Baraakna han oontꞌaaneet, teen teena akee rhiteenihoob, Ukwaasanaayt tehadꞌaayi dawit tikatiyeet toona kanna.<verse eid="LUK 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32" />Oosdik andi hookna, uun uutaas taan taana kastaah ikatiineeb hadiit iiyyi kiidiin. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />Tuubuutwa taabreewwa daayimaat kiikeena, laakiin aniib ibhali daayimaaba.” idi.<verse eid="LUK 21:33" /></para>
  <para style="s">Digwagwna!</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />Yasuuꞌa masi, “Digwagwna, iginꞌaayeekna nafirnayteebwa sakariibwa tuduniyaati hasakaaywa baadꞌiina. Een tidꞌaneek, been uumbꞌi gaalhoob usharakiit yꞌibik hookna indi. <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />Baruuh baliib kastooh tubuutiib ikweerni kehii yꞌi indi. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />Aflaay diima gwꞌadna, taan taana kastaah ikatiineet midda adgiriit teedhhaniini jillaay siileelaana. Aree adgiriit Wꞌaadami Oori suurii han tingadiina.” idi.<verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />Yasuuꞌa bꞌeebka Ukwaasanaay gawiib allami, hawaadka giigiit ukanbuul Oorba Saytuun ittiyoodiinaay kehii naayi. <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />Kassaah uudehay Ukwaasanaay ugawiib barooh isniikarnee dehaay fajir karuumaab yꞌiin.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s">Yahuuda Yasuuꞌaab Iidlibi Jillaay Agbiliya</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />Oontꞌa Ufatiiri Hadhiyi iid, Whasamti Wꞌiid iidni iidwil, <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />aree ifagiiriya isuurkinaawwa, whaggi koojaawwa, oodehay iriikwni sabbii masi Yasuuꞌaab haay idiirni salal yhiriwna. <verse eid="LUK 22:2" /><verse number="3" style="v" sid="LUK 22:3" />Malya Uubliis Yahuudaab, Wꞌiskaaryuuti iidneeb, shuumiya. Baruuh Yasuuꞌiib Ikwiriyaatay itamna malooyeeb gaal iikti. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />Yahuuda ifagiiriya isuurkinaawwa, Ukwaasanaay ugawi gwꞌaadiigaayi daabtaawwa ibaayt, Yasuuꞌaab kak iidlib iideeb bareeh hadiidsamiya. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />Baraah winneet afirhiyaaniit barooh mhallagaab iyiwnee dehaay taafagsamiyaan. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />Baruuh agbiliya, aree uudehay biihaayi door, Yasuuꞌaab bareeh haay nuuniyeet fursa igwꞌad.<verse eid="LUK 22:6" /></para>
  <para style="s">Oodraar Wꞌaakhareeb</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />Malya Ufatiiri Hadhiyi iidi bꞌi eeya, aree been oombꞌi Ubaaskaay wꞌiidi argin hooy itehirid. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />Aflaay Yasuuꞌa Bitruswa, Yuuhannaawwa diigwatiya, “Difnaat wꞌiidiit mꞌari tamnayee dehaay dehoon soomirna!” idi.<verse eid="LUK 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9" />Barooh raatiyaana, “Naa mhiin dehook nisoomiireet harriiwa?” idiin.<verse eid="LUK 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10" />Yasuuꞌa igwibi, “Algudus shuumteeni door, tak yami gidir itfayiik timeerna. Been baruuh shuumiiniyeeb oogaw beeti ramna. <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />Aree been oogawi kina beenaat, ‘Seedna raatiini hook: Ani ikwiriyaatayi geeb Whasamti Wꞌiidiit mꞌari hooy tami andiyeeb yꞌamnaayi gaw naad eefi? Indi hook.’ diina! <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />Baruuh oogawi mhakwal wint gurfa farrashamaat rhisi hookna indi. Been oomhiin soomirna!” idi.<verse eid="LUK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13" />Baraah idifna, aree Yasuuꞌa bareeh sooyaab iiktiyeet toonaatiit imriin. Aflaay baraah Whasamti Wꞌiidiit mꞌari beentooy isoomirna.<verse eid="LUK 22:13" /></para>
  <para style="s">Oodraar</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />Beet tuusꞌa tikayihoob, Yasuuꞌa ilinguumiyaayi geeb tumꞌariitii dehaay isꞌa. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />Aree Yasuuꞌa bareeyooh dehaay, “Ani oon Whasamti Wꞌiidiit mꞌari lhamaab baakaay geebookna tamiyeet winneet ahariw. <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />Ani andi hookna, Whasamti Wꞌiidiit mꞌari Ukwaasanaayt hadꞌaayeetiib tikatiyeeb ookiik, shaawti oonaay harꞌii batooh tami kaadi.” idi.<verse eid="LUK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17" />Kaas iyhaayt harꞌii, Ukwaasana yhamid. Malya, “Oon ookaas ahaanaat amꞌadhdhaadhna. <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />Ani andi hookna, Ukwaasanaayt tehadꞌaayi eetniyeeb ookiik, shaawti oon ookaas gwꞌi kaadi.” idi.<verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />Aree hadhiib yakisiyaayt, Ukwaasana yhamid. Malya yhadhi ikitꞌaayt bareeh nuuniya, “Uun baruuh ugarooyu bareekna ittiyeewiibu. Toon toona aniit shꞌaniiteeb dꞌiina!” idi.<verse eid="LUK 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 22:20" />Oontꞌaaneet Yasuuꞌa oodraari harꞌii kaas iyhaayt, “Uun uukaas aniib ubooyiib eefeeb ugalad ugayiibu, been baruuh bareeyookna jillaay eetfiif. <verse eid="LUK 22:20" /><verse number="21" style="v" sid="LUK 22:21" />Laakiin wꞌayi aneeb nuuni indiib, oontꞌa tumꞌariiti kehii geebu eefi. <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />Wꞌaadami Oor ibakii Ukwaasana indiyeet tehayꞌaatii iyaayi. Laakiin been uutak barooh nuuniiniib idhikw!” idi. <verse eid="LUK 22:22" /><verse number="23" style="v" sid="LUK 22:23" />Ikwiriyaatay aaw bareesooh een saki indiyeeb taktak sakanaayaan.<verse eid="LUK 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />Masi bareesooh aaw winkaab iiktiyeeb amgwasuura eebtik daaya. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />Yasuuꞌa bareeyooh dehaay, “Ijintiili hadꞌa udehayoohna kehii akrir ibariina, aree yhaakma igarooyeehna ‘Oodehayi araw!’ waliikeen. <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />Laakiin baraakna bareeh tꞌiiteeb kitteena. Bareesookna uuwinkaab oodiskaab tꞌiiteeb ikatiyeet toonaatu, aree usuurkina ibakii ukhaddaamiit ikati. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />Aaw winkaabu: Tumꞌariiti kehii sꞌaab han tari beeb wꞌakhdimiiniibu? Beeb tumꞌariiti kehii sꞌaab kiiki han? Laakiin ani bareeyookna geeb been ukhaddaamiit eefi. <verse eid="LUK 22:27" /><verse number="28" style="v" sid="LUK 22:28" />Baraakna aniib igwirha kasseeh geebu hassitaana. <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />Aneeb Baabu haay hukwimiyeet hadꞌaayi yhiiyyeetu tunaatiit, bareekna han haay tehakimneet hadꞌaayi iyaaw hookna andi. <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />Aniit tehadꞌaayeetiib geebu gwꞌi tiyadna, aree geebu tami tiyadna. Aree Israaꞌiileet tigabiila titamna malu tehakimni jillaay, hadꞌaayeeti kwirsiyaayi kehii iistꞌa tiyadna.” idi.<verse eid="LUK 22:30" /></para>
  <para style="s">Yasuuꞌiib Ikwiriyaatay Jarrabami Iyadna</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />Yasuuꞌa, “Siimoon, Siimoon, sinaakiraheeb! Wharru ibittaay waasiiniib udirꞌaatkinaayt uubliis bareekna gaalka jarrabiyeet toona raatiya. <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />Laakiin Siimoon, ani wꞌiimaanuuk ankiiree dehaay siileelan. Anii dehaay titꞌagiirihoob, isanaayeek ibakii sꞌakira.” idi.<verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />Laakiin baruuh igwibi, “Wꞌankwanaay! Ani geebook oosjin shuumaniyee dehaaywa, geebook ayaayee dehaaywa amaaru.” idi.<verse eid="LUK 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34" />Yasuuꞌa, “Ani andi hook, Bitrus, lhayt karuumaab uujiik baakuukillaayi, baruuk mhay doora ittiwheeb tindiya, ‘kaakan hook.’ iyaadeheeb tindiya.” idi.<verse eid="LUK 22:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />Malya Yasuuꞌa ikwiriyaatayeeh raatiya, “Ani bareekna mhallagaayeet shanta anu, tari iibaabtiit shanta anu, tari gidhꞌaat anu giigsaneeyookna door, naat han tinawna?” idi.</para>
  <para style="p" vid="LUK 22:35">Baraah “Kinki.” idiin.<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />Yasuuꞌa bareeyooh dehaay, “Laakiin oontꞌa mhallagaayeet shanta tibariineek yaksaana. Masi aree iibaabtiit shanta tibariineek yaksaana. Bꞌadhadh baabariibka tusideeriyaaytooh dilibtiit bꞌadhadh dilibti iniineet toonaati. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />Tuun tuuna iktabeeb kataabtu: ‘Baruuh maagtak ittiyoodi.’ diyaaba. Ani andi hookna, beet tuuna ibakii aniib tikatiyeet toonaati. Awooh, aniib kataabt tuuna willa sidik iikti tindi.” idi.<verse eid="LUK 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38" />Ikwiriyaatay, “Wꞌankwanaay! Tooy malu bꞌadhdha eefeen.” idiin.</para>
  <para style="p" vid="LUK 22:38">Yasuuꞌa igwibi, “Beet mhaati!” idi.<verse eid="LUK 22:38" /></para>
  <para style="s">Yasuuꞌa Siileeliya</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />Yasuuꞌa diimaab sakiyeet toonaatiit Oorba Saytuun beeti giigiya, aree ikwiriyaatayaah han barooh iramna. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />Beentooy iktimni door, Yasuuꞌa bareeyooh dehaay, “Jarrabamtiib bitdhibayni jillaay siileelaana!” idi. <verse eid="LUK 22:40" /><verse number="41" style="v" sid="LUK 22:41" />Malya Yasuuꞌa awii gaadiit masaafa bareesooh isgiit, ignafaayt siileeliya, <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />“Baab! Harriiweek oon ookaas hoosu ahaa! Laakiin ani aharriiweet tuuna bitꞌakaay. Baruuk harriiweet tuuna batiikti.” idi. <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />Tibreetee malak bariiyooh dehaay lawiya, aree barooh isꞌakir. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />Yasuuꞌa winneet lhamiya, aree akraat siileel siileeliya. Aree bariiyuuh uuduuf whaashi kehii ubooyiit thakwanaaytiit thathakwiya.<verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />Malya tusiileeltii yakiyaayt, ikwiriyaatay beeti yꞌagar. Bareeh gadabee gwooya, diwee imri. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />Baruuh bareeyooh dehaay, “Naanhooy diwteena? Jarrabamtiib bitdhibayni jillaay yakaana, siileelaana!” idi.<verse eid="LUK 22:46" /></para>
  <para style="s">Yasuuꞌiit Tꞌabuuki</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />Yasuuꞌa masi hadiidee gwida dehay eeyaan. Yahuuda iidni tak, itamna malooyeeb gaal iikti bareeh milhee eeya. Baruuh Yasuuꞌaab salaamti jillaay idwil. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />Laakiin Yasuuꞌa barooh raatiya, “Yahuuda, baruuk tusalaam Wꞌaadami Oor haay tintiil han?” idi.<verse eid="LUK 22:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49" />Ikwiriyaatay Yasuuꞌi geeb iifiin toona tꞌakaa tiid rhiyaanihoob, baraah “Wꞌankwanaay! Bꞌadhdhii kayasnay?” idiin. <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />Aree gaal bareesooh ufagiiri oowinnaay kishiya bꞌadhdhii ithꞌa, aree wꞌangwiil umaykwaab hooy ikitꞌa.<verse eid="LUK 22:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51" />Yasuuꞌa igwibi, “Oontꞌa gadna!” idiit, ootaki angwiil shiishiyaayt isinꞌir.<verse eid="LUK 22:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52" />Yasuuꞌa ifagiiriya isuurkinaawwa, Ukwaasanaay ugawi gwꞌaadiigaayi daabtaawwa, oodehayi eegrimaawwa, bariiyooh abuuki jillaay yꞌaab baliinee dehaay, “Naanhooy wꞌamaag takiit bꞌadhdhaawwa kwoolayaawwa yakistaaniit eetaanheeb? <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />Diimaab Ukwaasanaay gawiib geebookna iifi, aree bꞌeeb han ayeeb anii kehii daasaab kitteena. Laakiin tuuthibin tehankiimihoob, uun baruuh doorookna ikati.” idi.<verse eid="LUK 22:53" /></para>
  <para style="s">Bitrus Yasuuꞌaab Itwi</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />Malya Yasuuꞌaab yꞌabikniit fidnaab salooliyaana, aree ufagiiri oowinnaay gaw beeti haay giigiyaan. Bitrus han sagi mhiinii imooraam. <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />Laakiin baraah whooshiit hooyteeb nꞌeet ishidhhanniit hiddaab isꞌanihoob, Bitrus bareeyooh geeb isꞌa. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />Oot kishiyaat barooh beentooy tunꞌeeti midragi kwayaay sꞌee rhita. Malya barooh daayiib tishibibaayt, “Uun uutak Yasuuꞌi geeb iifi.” tidi.<verse eid="LUK 22:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57" />Laakiin Bitrus itwi, “Yaa takatay! Ani oon ootak ookna kaakan.” idi.<verse eid="LUK 22:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58" />Shalikt middaati harꞌii tak weer barooh rhiyaayt, “Baruuk han bareesooh gaalwa.” idi.</para>
  <para style="p" vid="LUK 22:58">Laakiin Bitrus, “Yaa takay, ani kaaki!” idi.<verse eid="LUK 22:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59" />Gaat saaꞌaati harꞌii tak weer akkadiya, “Uun baruuh sidik Yasuuꞌi geeb iifi. Baruuh han Jaliilee ikati.” idi.<verse eid="LUK 22:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60" />Bitrus “Yaa takay, baruuk naan tindiyeeb ani kaakan.” idi. Baruuh masi hadiidee, uujiik kuukillaayi. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />Wꞌankwana nakamiyaayt Bitrus beeti ishbib. Bitrus oon oodoor Wꞌankwana bariiyooh dehaay: “Lhayt fajir uujiik baakuukillaayi, mhay doora ittiwheeb tindiya.” diyaab iiktiyeeb ibhali shꞌiya. <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />Barraab ifirꞌat winneet waawiya.<verse eid="LUK 22:62" /></para>
  <para style="s">Igwꞌaadiiga Yasuuꞌaab Haay Kashiyaan</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />Yasuuꞌaab iigwꞌad aanda barooh haay kashiyaaniit ithabꞌana. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />Baraah bariiyeeh eegwꞌad yhakwirniit raatiyaana, “Sirida! Aaw ithꞌa hook?” idiin. <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />Aree barooh weena gwidaanaatii neewiyaan.<verse eid="LUK 22:65" /></para>
  <para style="s">Yasuuꞌa Biilaatooswa Heeroodisi Suuriiwwa Raatamamiya</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />Uumha mhiyihoob, oodehayi suurkinaayi majlis, kassaah ifagiiriya isuurkinaawwa whaggi koojaawwa immarraayna, aree Yasuuꞌaab bareeyooh suurii haay eeyaan. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />Baraah Yasuuꞌii dehaay, “Sooyaa hoon! Baruuk Umasiihwa?” idiin.</para>
  <para style="p" vid="LUK 22:67">Yasuuꞌa igwibi, “Een andiyuukna, baraakna aamaniheeb kitdiina, <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />aree ani raatiyuukna, baraakna kitgwibiina. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />Laakiin oon amseenee, Wꞌaadami Oor Ukwaasana Wꞌalyaanaay umaygwadiib iistꞌa indi.” idi.<verse eid="LUK 22:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70" />Baraah kassaah raatiyaana, “Aflaay baruuk Ukwaasanaay oorwa?” idiin.</para>
  <para style="p" vid="LUK 22:70">Yasuuꞌa “Daayiib tiyadna, ani barooh akati.” idi.<verse eid="LUK 22:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71" />Malya baraah, “Barooh ooknaay uyafii een nimaasiw, naanhooy wari badehi nhariw?” idiin.<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />Kassaah umajlisiib iifiin uudehay yakiyaaniit, Yasuuꞌaab whaakim Biilaatoos haay ibeen. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />Baraah Yasuuꞌaab atehimtiib badooyaaniit, “Oon barooh udehayoon amaag salal sꞌabkee nimri. Baruuh Iroomaani Gaysarii dehaay titilbaati kwisuuy imooriib. Aree baruuh, ‘Ani Umasiih, whadꞌa akati.’ indi.” idiin.<verse eid="LUK 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3" />Biilaatoos Yasuuꞌaab raatiya, “Baruuk Yahuudi hadꞌaabwa han?” idi.</para>
  <para style="p" vid="LUK 23:3">Yasuuꞌa igwibi, “Een baruuk tindiya.” idi.<verse eid="LUK 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4" />Biilaatoos ifagiiriya isuurkinaawwa, oodehay ugwidaanaay dehaaywa, “Oon ootak maagnaayt hooy karhan.” idi.<verse eid="LUK 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5" />Laakiin baraah kassaah hiddaab, “Uun baruuh utꞌaliimiisooh kassooh Yahuudaay oodehay yayakisiya. Baruuh Jaliilee badooyaayt tooy ookiik iktim.” idiin.<verse eid="LUK 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />Biilaatoos een ibhali imaasiwihoob, raatiya, “Uun uutak Jaliilee ikati han?” idi. <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />Baruuh Yasuuꞌa Heeroodis yhukwimeeb whaashii iiktiyeet toona ikanihoob, barooh Heeroodis beeti giigisiya. Heeroodis han been oodoor Alguduseeb iifi.<verse eid="LUK 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8" />Heeroodis Yasuuꞌaab rhiyihoob, shꞌiika barooh rhiyeet toona yhiriwayt winneet afirhiya. Yasuuꞌiib gwidaana maasiwaabu, aree barooh mꞌuujisaat dꞌiyee rhitiib yhariw. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />Heeroodis Yasuuꞌaab gwidaana raatiya. Laakiin Yasuuꞌa bariiyooh dehaay gwibiyaab kiiki. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />Ifagiiriya isuurkinaawwa, whaggi koojaawwa beentooy ingidna, aree barooh gwidaat maagnaaytii atehimiyaan. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />Malya Heeroodiswa ikajaraahwa Yasuuꞌaab haay kashiyaana, aree akraab amaag waraayaan. Barooh daawri halak istookwniit Biilaatoos beeti isꞌagirna. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />Biilaatooswa Heeroodiswa suur ashoob iiktiineek han, been oombꞌi araw ikeen.<verse eid="LUK 23:12" /></para>
  <para style="s">Yasuuꞌa Yat Yhakam</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />Biilaatoos ifagiiriya isuurkinaawwa, yhaakmaawwa oodehaywa waliikiyaayt, <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />bareeyooh dehaay, “Oon ootak oodehay amaag salal isꞌabiik miyaadiib haay eetaanheeb. Ani barooh suurookna raatan, laakiin barooh haay asꞌabiikeet maagnaay hooy miraab kaaki. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />Heeroodis han maagnaayt han hooy miraab kiikayt, barooh hinin beeti isꞌagir. Uun baruuh yat astehaltiniina dꞌiyaab kiiki. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />Shaawti barooh jasaayiit iifdig andi.” idi. <verse eid="LUK 23:16" /><verse number="17" style="v" sid="LUK 23:17" />Biilaatoos Wꞌiidi doorka bareeh abuukiib gaal dehaay iifdig.<verse eid="LUK 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18" />Laakiin uudehay kassaah tageega hissii, “Oon ootak diraa! Baarabaas dehoon fidiga!” idiin. <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />Uun Baaraabaas suur tumadiinaatiib iki finaay gaal diraabuuyt usijniib daamaabi.<verse eid="LUK 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20" />Biilaatoos masi bareeh infaraad. Yasuuꞌaab iifdigeet toona yhariw. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />Laakiin uudehay masi waliikiyaana, “Barooh sallabaa! Barooh sallabaa!” idiin.<verse eid="LUK 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22" />Biilaatoos bareeh mhay doora sakanaaya, “Uun uutak naa maagnaayt gwibbaabu? Baruuh haay itoodiireet maagnaay hooy miraab kaaki. Shaawti barooh jasaayiit malya iifdig andi.” idi.<verse eid="LUK 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23" />Laakiin baraah wawin hissaayee waliikiyaan. Baruuh sallabamiiniyeet toona yhariwna, aree baraah yhiriwneet tiki. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />Aflaay Biilaatoos baraah yhiriwneet toona sakiya. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />Baruuh been ootak rookaatiibwa madareebwa abaak usijniib iifiib, beeb baraah oofduug yhiriwneeb barooh dehaay ifdig. Aree Yasuuꞌaab baraah yhiriwneet toonaatiit bareeh nuuniya.<verse eid="LUK 23:25" /></para>
  <para style="s">Yasuuꞌa Sallabamiya</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />Ikajar Yasuuꞌaab fidnaab haay giigee, Siimoon iidni tak, Geerawaani haashii iiktiib yꞌabikna. Baruuh tudirꞌaatii itꞌigir. Ikajar oon ootak usaliibi hindi yaksiisiyaaniit, Yasuuꞌii harꞌii hiireerisiyaan. <verse eid="LUK 23:26" /><verse number="27" style="v" sid="LUK 23:27" />Gwida dehay barooh iramna. Gwidaat mꞌat han barooh waawiyaana, aree barooh nawwaatiyaan. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />Yasuuꞌa bateeyooh nakamiyaayt, “Alguduseet tꞌarit, anii dehaay biiwaawaana. Igarooyeekna dehaaywa yꞌareeyeekna dehaaywa waawaana. <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />Damaan yꞌi indi, uudehay ‘Taamꞌa tigiduudiya iyaamuuhna nikwaab biikaayneet, aangwaahna kwadhishaab biikaayneet baliit libaabiyaan!’ iyadna. <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />Been oodoor</para>
  <para style="q1" vid="LUK 23:30">baraah irbaayee dehaay, ‘Kehoon dhibaana!’ iyaad iyadna,</para>
  <para style="q2" vid="LUK 23:30">aree ikanbilee dehaay, ‘Kwibisna hoon!’ iyaad iyadna.<verse eid="LUK 23:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="LUK 23:31" />Uudehay teen teena whindi sootaay ikatiyihoob idꞌaneek, aflaay whindi balamiiniyihoob naan iikti tindi?” idi.<verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />Malu da warib, mhallaah maagnaayt sakaaba. Baraah han itoodiirnee dehaay Yasuuꞌi geeb galeelamiyaan. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />Baraah “Kalhoob” ittiyuud mhiin iktimnihoob, Yasuuꞌaab toomaag sakanaayi geeb beentooy sallabiyaan. Bareeh gaal bariiyooh umaygwadii dehaay, ooraaw bariiyooh utarhagwadii dehaay sallabiyaan.<verse eid="LUK 23:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 23:34" />Yasuuꞌa “Baab, bareeh afooya! Baraah naan sakeeneeb kiikanna.” idi. Aree ikajar gurꞌaat igidniit bariiyeeh yhalaka imꞌadhdhaadhna.<verse eid="LUK 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 23:35" />Uudehay beentooy ingadniit barooh iishbibna. Yhaakma bariiyooh faaydee, “Oodehay eeraw ishidhhan. Ukwaasanaay Umasiih Uwaasama ikatiyeek, tꞌa ugarooyooh baꞌishidhhin!” idiin.<verse eid="LUK 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36" />Ikajar han eeyaaniit barooh haay kashiyaan. Barooh haab beeti yꞌabikna. <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />Baraah “Baruuk Iyahuudi hadꞌa tikatiyeek, ugarooyook shidhhana!” idiin.<verse eid="LUK 23:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38" />Yasuuꞌi mhakwal laaftaat kataabtu: “Uun baruuh Iyahuudi hadꞌa ikati.” miyaad kataabi.<verse eid="LUK 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39" />Beentooy usaliibi kehii atishꞌigaab toomaag sakanaayee gaal barooh neewiya: “Baruuk Umasiih kittaa han? Ugarooyook shidhhana, hinin han shidhhana hoon!” idi.<verse eid="LUK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40" />Laakiin been uuraaw oon ootak idnin, “Baruuk Ukwaasana kitrikwiya? Baruuk han oon utakiit jasaamaab kittaa han? <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />Hinin maagnaay saknaayt jasaamnay, beet tumaagtuun astehaltiniyeeb ijasa nimeer. Laakiin uun uutak amaagna naat gwibbaab baakaay gwadoon jasaamiini.” idi.<verse eid="LUK 23:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42" />Malya baruuh Yasuuꞌii dehaay, “Yasuuꞌa, tehadꞌaayeetiyook hadꞌaab akiit eetniyihoob, shꞌaaheeb!” idi.<verse eid="LUK 23:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43" />Yasuuꞌa bariiyooh dehaay, “Oosdik andi hook, amsi geebu tujanna daayi tindiya.” idi.<verse eid="LUK 23:43" /></para>
  <para style="s">Yasuuꞌiit Tooyat</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />Oontꞌa nabhoob, gaalhoob kastuuh tuubuur thibinamta. Kassuuh uumbꞌi wꞌasir ookiik thibin iki. <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />Tuuyin thibnamta. Ukwaasanaay ugawiit sitaara malu mhiin tikitꞌa. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />Yasuuꞌa win hissii waliikiya, “Baab! Ani ishuuki yꞌayeeyook daasan.” idi. Een idiit malya iya.<verse eid="LUK 23:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47" />Iroomaani daabit toona tutikeet rhiyi door, Ukwaasana yhamid aree, “Uun baruuh sidik daayi tak akay iifi.” idi. <verse eid="LUK 23:47" /><verse number="48" style="v" sid="LUK 23:48" />Uudehay kassaah beet toona tutikeet iishbibni jillaay beentooy immarraayna. Malya beet toona rhiyaani harꞌii, baraah winneet gadabaa yꞌagarna. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />Laakiin baliin barooh iktiin kassaah, Jaliilee barooh iramt taamꞌa han hooy haayee, sagi mhiin ingadniit teen teena ishbibna.<verse eid="LUK 23:49" /></para>
  <para style="s">Yasuuꞌa Itoobaas</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50" />Oontꞌa beentooy Yuusif iidni tak, umajlisii gaal iiktiib iifi. Baruuh daayi taku aree sidki taki. <verse eid="LUK 23:50" /><verse number="51" style="v" sid="LUK 23:51" />Been baruuh umajlisi mikirwa baraah sakiineet toonaawwa agbilaab kiiki. Baruuh Yahuudaayt tumadiina Raamaay yꞌaabu aree Ukwaasanaayt tehadꞌaayi yhigit. <verse eid="LUK 23:51" /><verse number="52" style="v" sid="LUK 23:52" />Yuusif Biilaatoos ibaayt, Yasuuꞌiit tukinaaja hooy yhariw. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />Malya baruuh tukinaaja usaliibii tikwisiyaayt, nꞌakw halakiib ishaamim. Oonaay suurii gaal han hooy atoobsaab biikaayi mhiin, liilaawiib faraak miimashiib tukinaaja daasiya. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />Been uumbꞌi jimꞌaatu, aree tuusab badootiib diwlaa tiifi.<verse eid="LUK 23:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55" />Yasuuꞌi geeb Jaliilee yꞌaat taamꞌa baliit Yuusif iramniit umiimash rhiyaana aree tukinaaja kak daasamtaneeb rhiyaan. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />Malya bataah igawaayeehna yꞌagarniit daayiit shakwiina isoomirna. Laakiin Muusaay whag waseeyaab iiktiyeet toonaatiit, bataah toosab fiiniyaan.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">Ooyak</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />Tuhadti bꞌi karuumaab taamꞌa tishakwiina tisoomraat iiktiineet iyheeniit umiimash ibeen. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />Bataah wꞌawi umiimashii kwaaleela imriina, <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />laakiin oodi shuumiyaanihoob, bataah Wꞌankwana Yasuuꞌiit tukinaaja miraat kiikeen. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />Bataah beet toonaatiib kwoonee, gaalhoob malu da eera halaka talawiin akway bateeyooh daraag ingadna. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />Taamꞌat imhaniit ifiireesoohna whaashi kehii kuuramiyaan. Laakiin aanda bateeyooh dehaay, “Udhhaniib yꞌayaanaayi mhiin naanhooy tehariwna? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />Yasuuꞌa tooy kiihaay. Tuyatii yakamiya. Baruuh masi Jaliileeb geebookna iifiyi door sooyaneetookna toona shꞌaana! <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />Baruuh ‘Wꞌaadami Oor ibakii eenda yꞌamagnaayi ayeeb daasamiini, sallabamiini, aree tooyin tumhayaatiib masi dhhantiit yakiini.’ diyaabu.” idiin. <verse eid="LUK 24:7" /><verse number="8" style="v" sid="LUK 24:8" />Malya bataah Yasuuꞌiib ibhali shꞌiyaan.<verse eid="LUK 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 24:9" />Bataah umiimashii yꞌagarnihoob, kasteeh teen teena ilinguumiya itamna gwirwa, eerawwa sooyaan. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />Taan taamꞌa Maryam Majdaleenaabwa, Yoowannaatwa, Maryam Yaaguubiit toondeewwa, warit bateeyooh geeb iifiintwa teen teena ilinguumiya sooyaan. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />Laakiin baraah taamꞌa iidneeb ibhali hararfirid tꞌiiteena hiisiyaanayt, bateeh aamanaab kiikeen. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />Laakiin Bitrus yakiyaayt, umiimash beeti dhaabiya. Umiimashi kehii kuuramiyaayt nꞌati ishbib, aree ukafani halak nuun weena rhaab kiiki. Malya naan tikayeeb baruuh uukna ajjabamee giigiya.<verse eid="LUK 24:12" /></para>
  <para style="s">Yasuuꞌa Malu Kwiriyaatayee Dehaay Lawiya</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />Been oombꞌi malu ikwiriyaatayee Imwaas iidneet gariya iibiin. Batuuh Algudusee tamna gwir kiiloomitir tisiig. <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />Baraah kastooh toona tutikeenaatiib hadiidsamiin. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />Baraah teen tinaateeb hadiidsameewwa bhaliisameewwa, Yasuuꞌa uukna eeyaayt bareeh ukwayaay hiireersamiya. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />Laakiin baraah baruuh aab iiktiyeeb igamna.<verse eid="LUK 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17" />Yasuuꞌa bareeh raatiya, “Hiireertiini door, naanaatiib hadiidsamtaana?” idi.</para>
  <para style="p" vid="LUK 24:17">Baraah tim ikeeniit ingadna, aree ifiiraahna yhamaashna. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />Bareesooh Kilyoobaas iidni gaal, barooh raatiya, “Een eembꞌi Alguduseeb ikeent teena kanaab baakaay wꞌiibaabkina barook oobhaatwa?” idi.<verse eid="LUK 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19" />Yasuuꞌa raatiya, “Naa naata?” idi.</para>
  <para style="p" vid="LUK 24:19">Baraah igwibiina, “Yasuuꞌaab Unaasiraayii dehaay ikeent teena. Baruuh Ukwaasanaawwa kassooh oodehayi suurii idꞌiyeet tunaatiibwa, hadiidiyaneet tunaatiibwa, akrir iibri nabi iiktiyeet toona rhisiya. <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />Ifagiiriya isuurkinaawwa, isuurkinaayaanwa barooh yhakwirniit yat haakamiyaana, aree saliibi kehii idirna. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />Laakiin baruuh Israaꞌiil ishidhhin tak iiktiyeet toona minniimna. Laakiin tuun tuuna kastuuh tikayeekka amsi mhayaat yint tikati. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />Timꞌateesoon galit ajjabisiyaan hoon. Bataah karuumaab yakiyaaniit umiimash ibeen. <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />Laakiin Yasuuꞌiit tukinaaja miraat kiikeen. Bataah hinin beeti yꞌagarniit, baruuh dhhaniibi iid malak rhiyaaneet toona hadiidiyaan. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />Malya ijamꞌaayeesoon gali umiimash ibeena, aree taamꞌa diyaat iiktiineet toonaatiit imriin. Laakiin barooh rhaab kiikeen.” idiin.<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />Yasuuꞌa bareeyooh dehaay, “Naanhooy kaꞌafhamtaana? Inabiya iidneet toona kastooh kak diiseet aamanteena? <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />Umasiih teen teena haay lhameetiit malya umatuunooh shuumiiniyeet toona kitti han?” idi. <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />Malya Yasuuꞌa kasseeh iktabeeb bariiyooh kataabt toonaatiib bareeyooh dehaay fassariya. Muusaay badooyaayt, kassaah inabiya diyaab iiktiineet toona bareeyooh dehaay fassariya.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />Baraah iibiineet tugariya idwilnihoob, Yasuuꞌa sagika mhiin beeti iibaabi tak dehaay massalamiya. <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />Laakiin baraah winneet barooh inꞌalna, “Hawaad yꞌaabu. Amsi geeboon naaya!” idiin. Aflaay Yasuuꞌa bareeyooh geeb iignifi jillaay oogaw shuumiya.<verse eid="LUK 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 24:30" />Bareeyooh geeb mꞌariitii dehaay isꞌat harꞌii, Yasuuꞌa hadhiib yakisiya, aree yhamidaayt yhadhi ikitꞌa. Malya yhadhi bareeh yhii. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />Oontꞌa bareeh aagwꞌad ingalna, aree barooh ikanna. Laakiin baruuh gaalhoob hooy kwidhiya. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />Baraah taktak raatiyaana, “Oodoor baruuh usalaliib aaktab diyaab iiktiineet toona dehoon hadiidiyihoob, iginꞌaayaan baloolaab kiikeena han?” idiin.<verse eid="LUK 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33" />Baraah been oodoor yakiyaaniit Algudus beeti yꞌagarna. Iktimnihoob, ilinguumiya itamna gwirwa baliin bareeyooh geeb iifiinwa hiddaab ammariyaa imriin. <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />Aree baraah, “Tuun sidiku! Wꞌankwana yakiya, aree Siimoonii dehaay lawiya.” idiin. <verse eid="LUK 24:34" /><verse number="35" style="v" sid="LUK 24:35" />Malya aan imalu usalaliib dehaay tikeet toona hadiidiyaan. Wꞌankwana yhadhi ikitꞌihoob, baraah kak barooh ikanneet toona hadiidiyaan.<verse eid="LUK 24:35" /></para>
  <para style="s">Yasuuꞌa Ikwiriyaatayee Dehaay Lawiya</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />Ikwiriyaatay toona tutikeenaatiib masi hadiidee, Yasuuꞌa uukna bareeyooh bitik ingadaayt, “Mꞌasig geebookna badaayi.” idi.<verse eid="LUK 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37" />Bareeh akra mhiibwa miraakwaaywa hooy daaya. Malaaliinaay rhiyaaneeb hiisiyaan. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />Yasuuꞌa bareeyooh dehaay, “Naanhooy teemhana? Naanhooy eetehakteena? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />Ani aab akatiyeeb yꞌayi shibibna aree iragadaayi shibibna. Uun aneeb uknaayu akati! Tatehaanaateheeb shibibna. Aneeb barii rhiteeneeb tꞌiiteena, umalaaliinaay miitatwa basharwa kiibari.” idi.<verse eid="LUK 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40" />Baruuh een ibhali idiit harꞌii, yꞌayeehwa, iragadaayeehwa bareeh rhisiya. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />Baraah winneet afirhiyaana aree ajjabamiyaanayt, masi aamanaab kiikeen. Malya Yasuuꞌa bareeh raatiya, “Tooy naat tamamtiniina han tibariina?” idi. <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />Baraah aashooyt sha asalamaat barooh yhiin. <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />Yasuuꞌa batooh bareeyooh suurii yakisiyaayt tamiya.<verse eid="LUK 24:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />Baruuh bareeyooh dehaay, “Masi gwadookna iifiyi door, bak sooyan hookna: kastuuh tuuna aniib kataabt Muusaay whaggiibwa, Inabiyaayi kitabeebwa, tehabayaateeb attiyoodiyaat tuunaawwa ibakii tikati.” idi.<verse eid="LUK 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45" />Malya baruuh eektabi afhistiib bareeh isham. <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />Yasuuꞌa bareeyooh dehaay, “Tuun tuuna bak kataabtu: Umasiih lhami indi, aree tooyin tumhaya tuyatii yaki indi. <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />Aree kasseeh idehayaayee dehaay, Algudusee badooyiit, oosmiisooh tuubaatwa idanuubi afootiiwwa bhaliimi iyadna. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />Baraakna teen teena kasteeh badehiib dehaay tikatiina. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />Baabu waadiyaayaab ikatiyeet toona dehookna diigwati andi. Laakiin baraakna tibreetee akrir tittiyeewiineeb hadiit tumadiinaatiib daayaana!” idi.<verse eid="LUK 24:49" /></para>
  <para style="s">Yasuuꞌa Teebri Beeti Yakamiya</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />Yasuuꞌa ikwiriyaatayeeh Beetaanyaab ittiyoodi mhiin beeti imilhihoob, baruuh yꞌayeeh asti yꞌabikaayt bareeh baarakiya. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />Baruuh bareeh baarakiyeet midda, bareesooh giigiyaayt teebri beeti yakamiya. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />Malya ikwiriyaatayaah bariiyooh dehaay asjidiyaaniit winneet afirhaa Algudusee dehaay yꞌagarna. <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />Aree baraah kasseeh idamaneehna Ukwaasanaay ugawiib Ukwaasana hamdee hassiyaan.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>