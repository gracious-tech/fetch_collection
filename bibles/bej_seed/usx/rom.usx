<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Bella</book>
  <para style="h">Iroomaani</para>
  <para style="toc1">Iroomaani yꞌamanana eebiib ujawaab</para>
  <para style="toc2">Iroomaani</para>
  <para style="mt1">Iroomaani yꞌaamanana eebiib ujawaab</para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />Baawloos, Yasuuꞌaab Umasiihi kishiya, ulinguuma itoosaam, aree Ukwaasanaay Usakana Udaayiib sooti jillaay waasamiya. <verse eid="ROM 1:1" /><verse number="2" style="v" sid="ROM 1:2" />Ukwaasana shꞌiika inabiyaayeeh geebii waadiyaayaab iiktiyeeb Usakana Udaayiib, eektab imugaddasaayeeb kataabi. <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />Uun Usakana Udaayi bariiyooh Wꞌooriib hadiidiini. Wꞌaadamiit hayꞌaatiib baruuh Daawidiit dirriyaaytii ikati. <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />Eeshuuk Imugaddasaayi akriree tuyatii yakiyanihoob, baruuh Ukwaasanaay Oor ikatiyeet toona lawiya. Yasuuꞌa Umasiihi Wꞌankwanaayoon ikati. <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />Bariiyooh geebiiwwa bariiyooh oosmi jillaaywa, hinin nꞌimaatwa linguumamtiiwwa nimri. Aflaay kasseeh Ijintiili bitik uudehay aamaneetiit tuubeeni jillaay waliiknay. <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />Baraak han baliib Yasuuꞌaab Umasiihiib ikatiinaayi geeb waliikamaabaana.<verse eid="ROM 1:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />Roomaay eefeen kasseeh Ukwaasana areeyaab ikatiyeebwa, Ukwaasanaay dehay atoosmaabwa ookiik ani akantiib:</para>
  <para style="b" vid="ROM 1:7" />
  <para style="p" vid="ROM 1:7">Ukwaasana Baabiisoonwa Wꞌankwana Yasuuꞌaab Umasiihiiwwa, mꞌasigwa nꞌimaatwa miriina!<verse eid="ROM 1:7" /></para>
  <para style="s">Baawloos Roomaay Irhiti Yhariw</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />Hankaab, bareekna kasseeyookna jillaay, Yasuuꞌaab Umasiihiib oosmii Ukwaasanaayu ahammiid. Tuun tuuna aree wꞌiimaanuukna kasseeh tuduniyaati dehay iktimi sabbii tikati. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />Ani kassooh uginꞌiisu shagaamaniyeeb, Ukwaasana, Wꞌooriyooh Usakana Udaayiinaay hadiidaniyeeb, ani kak diimaab shꞌaniyeetookna toona baruuh badehiib ikati. <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />Ani kassooh oodoor siileelaniyihoob, shꞌani hookna. Aree oontꞌa aakhir Ukwaasanaayt niyaatii bareek beeti yꞌaniyi jillaay, usalal anii dehaay itnagiileet toonaatii dehaay siileelani.<verse eid="ROM 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 1:11" />Ani eerheekna winneet dehaay hayꞌaabi. Aflaay bareekna isꞌakiirt ishuukeet baraka haay yꞌani hookna. <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />Baraakwa aneebwa wꞌiimaaniisoon taktak nisꞌakiireet toona asehariiw. <verse eid="ROM 1:12" /><verse number="13" style="v" sid="ROM 1:13" />Isanaayaan, ani bareekna beeti wꞌaay gwida doora niyaamaneet toona kanaant asehariiw hookna. Laakiin beet toonaati dꞌuuyii naat gaat tꞌafiheeb. Ani yꞌeetiit hookna ibtikeekna samaraat iidꞌeet toona aharriiw, oodehay irawi geeb han bak adꞌi.<verse eid="ROM 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 1:14" />Kasseeh Iyoonaaniiwwa, Yoonaaniib baakaywa, ifagaraawwa yꞌafrayaawwa kasseeh isooti aniit waajib tikati. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />Oon usabbii aree aflaay bareek Roomaay eefeen han Usakana Udaayiinaay isooti winneet aharriiw.<verse eid="ROM 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />Ani Usakana Udaayiinaay sikwꞌiib kaabari. Baruuh aree oodehay yꞌaamaneen kasseeh ishidhhiin Ukwaasanaay akrir ikati. Hankaab Iyahuudee dehaay, malya aree Ijintiilee dehaay ikati. <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />Usakana Udaayiinaay aree, tuushbu Ukwaasanaay lawi tindi, tuushbu been wꞌiimaanii tikatiit, tibadootee wꞌagiya ookiik tikati. Batuuh uktaabiib bak kataabtu: “Uushbu wꞌiimaanii ikwaar indi.” diyaabi.<verse eid="ROM 1:17" /></para>
  <para style="s">Ukwaasanaay Igadab Wꞌaadami Kehii Daayeen</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />Ukwaasanaay igadab tibreetee kasseeh yꞌamag dehayi kehiiwwa toomaag sakanaayi kehiiwwa lawiyaan. Baliin baraah tumaagtiisoohna oosdik eetirna. <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />Ukwaasanaay atookakinaat tuuna bareeyooh dehaay gwꞌagwaat tikati. Beet tuuna aree Ukwaasana bareeyooh dehaay gwꞌagwaat ikwaasayt tikati. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />Ukwaasana tuduniya idꞌiyeekka, bariitaah taana tibaalawaya kastaah, yꞌakriraah idaayimaawwa, tehayꞌaatuuhwa daayiib lawiyaan. Baruuh idꞌiyeet toonaatii aree daayiib afhamamiyaan. Aflaay uudehay sabab kiibariin.<verse eid="ROM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 1:21" />Ukwaasana ikanneek han, barooh Ukwaasanaayt soowinaab kiikeena aree barooh hamdaab kiikeen. Laakiin tikwoonaniitaahna mishiit iiktiina, aree iginꞌaayaahna yꞌafraya yhadaalna. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />Igarooyeehna fagaraab hiisiineek han, baraah afreeyaana, <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />Ukwaasana Ubaayaayiib umatuun, dehay dꞌiyaab ikatiyi timsaleeb ibdilna. Wꞌaadami ubashariyaaywa, eekilaywa, tidhhaniyaawwa, ibuut ranfiifaawwa tꞌiiti timsaleeb ibdilna.<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />Shaawti Ukwaasana oon oodehay iginꞌaayaahna yhariwneet toomaag nuuniya. Baraah taktaki geeb tisiisakwꞌiina shagaameen. <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />Baraah Ukwaasanaay oosdik gwisreeb ibdilna. Ukwaasana yꞌabidneet toonaatiika, Ukwaasana dꞌiyaab ikatiyeena yꞌabidna. Baruuh diimaab itehammiid. Aamiin!<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />Oon usabbii, Ukwaasana bareeh sikwꞌiib rayiisiya. Timꞌataahna han oojkuun wꞌatlammidaab iribniit, taakna taktak rareewiyaan. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />Aanda han oontꞌaaneet sakiyaan. Baraah timꞌati jikuun wꞌatlammidaab yꞌishniit, aakna taktak rareewiyaan. Aanda eenda irawi geeb amaagna sakiyaana, aree baraah aakna tumaagtoohna astehaleeni jasa dehaay jasaamiyaan.<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />Masi aree, baraah Ukwaasanaayt kanaanti dibuuyiib shalikna han kwinaab kiikeenayt, Ukwaasana bareeh amag girma yhii. Aflaay baraah toona tubaakaay ikwasiin. <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />Baraah kastooh tumaagnaayti jinsa itabna. Maagnaaytwa, haamtiiwwa, fasaadwa itabna. Baraah gwidaat hasaadaawwa, madarwa, finaabwa, taaliitwa, maagniyaabwa itabna. Baraah yaandiinanaaba, <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />taktakeeb amaagna hadiideena, Ukwaasanaay roobanaaba, neewanaaba, kibriiba, tatageeganaaba, maagnaayti sakti salala kwooneena, aree ifarooyeehna kiisinaakirna. <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />Baraah dꞌam kiibariina, iimaan kiibariina, ginꞌaab kiibariina, rhamaat kiibariin. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />Baraah, Ukwaasanaay whag wꞌaadil ikteenna, teen teena sakeen uudehay tooyat astehaleeneet toona ikteenna. Laakiin baraah masi teen teena shagaameena, aree teen bateeh shagaameen eeraw han isꞌakiirna.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s">Ukwaasanaay Whukwim</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />Aflaay baruuk oodehay eeraw haakamiini been, gwabab kaabari tindiyee dehaay kaꞌadgirta. Eeraw haay haakamtiniyeet toona ugarooyook gwabab haay tisꞌabiika. Baruuk whaakamiini beet toona tookna tꞌiiteena saktiniya. <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />Oontꞌa Ukwaasanaay whukwim baliit teena shagaameen oodehayi kehii ikwasiyeeb sidik ikatiyeet toona nikteen. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />Aflaay baruuk wari dehay haakamtiniya, malya uknaayuuk teen teena teekna danꞌiyihoob, Ukwaasanaay whukwimii teedhhaniyeeb hiistiniya han? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />Tari bariitaah tidaayiinayti miraaywa, itarmuumaawwa oosbirwa, baruuk abaabtiniya han? Ukwaasanaayt tidaayiinay tituuba beeti istoobiineetook toona kitkana han?<verse eid="ROM 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 2:5" />Laakiin wꞌamaag niyaayookwa, uginꞌook utuubaab baakaaynaay sabbiiwwa, Ukwaasanaay whukwim wꞌaadil ikatiyeet tooyin, baruuk Ukwaasanaay igadabeet tuyintii dehaay ugarooyook dehaay gadab danbiya. <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />Ukwaasana gaalka toona tushagaamaab ikatiyeet iyaaw indi. <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />Tudaayiinaay soorarimti dꞌiitiit matuunwa, hamooyseewwa, daayim midhhanwa yhariw baliib, Ukwaasana bareeh daayim midhhan iyaaw indi. <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />Laakiin baliib igarooyeehna rayiisti oobhaat yhariw, aree oosdik ribtiit toomaag eetriim, Ukwaasana bareeyooh kehii gadabwa hasiyaaytwa iifif indi. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />Oodehay maagnaayt sakeen kasseeh, beentooy gwirhaabwa lhanaytwa dehaay iikti iyadna. Hankaab Iyahuudii dehaay iikti iyadna, malya Ijintiilee dehaay iikti iyadna. <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />Laakiin tudaayiinaay danꞌiibka matuunwa, hamooyseewwa, mꞌasigwa imaar indi. Hankaab Iyahuudi imaar iyadna, malya Ijintiili imaar iyadna. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />Ukwaasana giraadtiib karhisiya.<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />Baliin whag baabari maagnaayt sakiyaan kassaah, whag anu kwidhi iyadna. Baliin whaggi whii maagnaayt sakiyaan kassaah, whaggii haakamami iyadna. <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />Baliin whag eemsiiw Ukwaasanaay suurii shibu dehay ikatiin miyaad kiiki. Laakiin baliin whag isnaakiir shibu dehay ittiyuud iyadna. <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />Ijintiili whag baabariin whag hooy yharriiweet teena ilamadii shagaameen. Baraah hag biibariineek han, igarooyeehna dehaay hag ikatiin. <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />Baraah whag yharriiweet teena iginꞌaayeeb katab ikatiineet toon rhiseena, igirmaayaahna han badehiib dehaay ikatiin. Tikwoonaniitaahna door gaal bareeh atehimeena, aree door gaal bareeh yheebna. <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />Tuun tuuna aree Ukwaasana uudehay kwibsaab ikatiineet teena Yasuuꞌaab Umasiihi geebii haakami indiyeeb oombꞌi iikti tindi. Aniib Usakana Udaayi sooyiiniyeet toonaatiit iikti tindi. <verse eid="ROM 2:16" /><verse number="17" style="v" sid="ROM 2:17" />Aflaay baruuk ugarooyook Yahuudiib waliiktiniyeek, whaggii dehaay adehamtiniyeek, teetriimeek, Ukwaasanaay wꞌayaaysamtiib faalamtiniyeek, <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />baruuh yharriiweet toona kantiit tudaayiinaay hanyiideek, baruuk whag sooyaneet toona tidꞌiya. <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />Baruuk yhamashayaayi maalhi tikatiyeet toona akkadtiniyeek, uthibniib eefeen baliib nuur dehaay tikatiyeek, <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />imiskiinaayi mitiyaayani tikatiyeek, inisrikaayi allamani tikatiyeek, whaggiib akraat kanaantwa oosdikwa tibariyayt, <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />aflaay baruuk eeraw allamiiniib been, ugarooyook kaꞌallamta han? Baruuk toogwihar baagwiharna indiib been, uknaayuuk tingwhiira han? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />Baruuk uudehay biijakiinneet toonaati indiib been, uknaayuuk jankiina han? Baruuk isanama imooriib been, diini gawaayeeb tingwihiira han? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />Baruuk whaggii faalamiiniib been, whag kitꞌatiit Ukwaasanaay dehaay sikwꞌiib haay eetniya han? <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />Uuktaab bak indi: “Bariiyook sabbii Ukwaasanaay uusim Ijintiili bitik kifuur ikati.” indi.<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />Whaggii shagaamteeneek ukwishuub takweet ibari. Laakiin whag tikatꞌaneek, kwashab baakaayna tꞌiiteeb iikti tiyadna. <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />Baliin ikwashab baakay whag yharriiweet teena idꞌaneek, kwashaabna tꞌiiteeb ikatiineet toona kitti han? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />Uutak uukna kwashaab baakaay masi whag eetriim ittiw hookna indi. Baraak beet toona uktaabiib kataabt akay tibariina, kwashabaana, laakiin whag tikatꞌana.<verse eid="ROM 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 2:28" />Uutak tisaradtee oobhaat Yahuudiib ikatiyeek, uun baruuh Yahuudiib kiiki. Ukwishuub tisaradteewwa barraaywa aabhat Yahuudiib kiikwaasna. <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />Abadan, uutak Yahuudiib ikatiib, tehooytee Yahuudiib ikatiyeet toonaati. Ukwishuub aree ooginꞌi kwishuub Ishuukee ikatiib nuun, uktaabiib kataabt toona kitti. Been ootaki hamaad aree Ukwaasanaay ikati nuun oodehayii kiiki.<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />Aflaay Yahuudiib tikatiyeet tuuna beentooy naan rayiistini? Tari ukwishuubiib naa takwi teefi? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />Salaliibka gwidaana teefi! Naati suuriika, Ukwaasana ibhaliyeeh Iyahuudi ammaniya.<verse eid="ROM 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 3:3" />Gali diin biibariineek naanaatu? Bareeyuuhna wꞌiimaani naaw Ukwaasana tꞌamaana isooniiw han? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />Abadan bak kiiki! Ukwaasana ibakii sidkiibu, aree wꞌaadami gwisreebi. Uuktaab bak indi:</para>
  <para style="q1" vid="ROM 3:4">“Aflaay bhaliitiniyihoob ibakii usidkuuk akkadamiini,</para>
  <para style="q2" vid="ROM 3:4">aree haakamtiniyihoob ibakii tehalaagaaytook hooy ansiramtiniya.” indi.<verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />Laakiin tumaagtuun Ukwaasanaayt tooshbu winneet rhistiniyeek naan niyad? Been Ukwaasana igadabeeh kehoon danꞌi akay daalimu han? (Ani uudehay raatiiniyeeb ibhali hadiidan.) <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />Sidik kiiki! Beet tuuna bak tiiktiyeek, Ukwaasana kak tuduniya haakamiini? <verse eid="ROM 3:6" /><verse number="7" style="v" sid="ROM 3:7" />Gaal imgwasiir, “Aniit tuumaag Ukwaasanaay oosdik rhistiniyeek, masi aree umatuunuuh imeeshiwiyeek, shaawti aneeb wꞌamaag takiit naanhooy aglitseenheeb?” indi. <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />Aflaay hinin, “Maagt nidꞌeet toonaatu, beet tuuna daayiinaayt haay eetni.” naanhooy bak kindi? Dehay gali een ibhali diyaabu idiiniit atehimiyaanheeb, winneet neewiyaanheeb. Laakiin Ukwaasana aadilu aree bareeh han jasaayi indi.<verse eid="ROM 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />Shaawti naan niyad? Hinin Iyahuudi Ijintiileeka hayiskaaba niyad han? Abadan! Iyahuudiiwwa Ijintiiliiwwa kasseeh tuumaag abikaat tikatiyeet toona rhisna. <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />Tuun tuuna bak kataabtu:</para>
  <para style="q1" vid="ROM 3:10">“Beentooy shibu tak gaal han kiihaay.<verse eid="ROM 3:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="ROM 3:11" />Gaal han afhamiini kiihaay,</para>
  <para style="q2" vid="ROM 3:11">Ukwaasana harriiw gaal han kiihaay.<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />Baraah kassaah fidnaab yakiyaana,</para>
  <para style="q2" vid="ROM 3:12">hiddaab aree takweet baabariib ikeen.</para>
  <para style="q1" vid="ROM 3:12">Daayiinaayt sakiiniib kiihaay,</para>
  <para style="q2" vid="ROM 3:12">gaal han kiihaay.<verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />Iseebꞌaayaahna haakeen miimashaaba,</para>
  <para style="q2" vid="ROM 3:13">imiidalabaahna talasaab shagaameen.</para>
  <para style="q1" vid="ROM 3:13">Tꞌambalooyaataahna ukwakwari simiit sammooyeen.<verse eid="ROM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ROM 3:14" />Iyafaayaahna aatwa hamiinaaytwa ataba.<verse eid="ROM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />Iragadaayaahna booyi faafii dehaay ashshiganaaba.<verse eid="ROM 3:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16" />Eebiini mhiiniibka kwidhwa hasartwa ikatiina,<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />aree umꞌasgi salal kiikanna.<verse eid="ROM 3:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18" />Igwꞌadeeyoohna suurii Ukwaasanaay mirkwaay kiihaay.” diyaabu uuktaab.<verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />Oontꞌa whag diyaab ikatiyeet toona nikteen. Whag een bareeh whaggi whii eefeen bareeh sooyiini. Aflaay kassaah iyafa tim iikti iyadna. Aree kastuuh tuduniya Ukwaasanaay whukwimi whii daatni. <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />Shaawti whag yharriiweet toona dꞌiitiit Ukwaasanaay igwꞌadi suurii shibu dehay gaal han kiihaay. Laakiin whag danuub dꞌiyaab nikatiyeet toona mitiyaayiini.<verse eid="ROM 3:20" /></para>
  <para style="s">Wꞌiimaanii Tuushbu Tikati</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />Laakiin oontꞌa tuushbu Ukwaasanaay geebii lawta. Batuuh whaggiib kitehaay. Beet toona Muusaay Whagwa Inabiyaawwa bidehaaba. <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />Tuushbu Ukwaasanaay eetniit baliib kasseeh yꞌaamaneennee dehaay Yasuuꞌaab Umasiihiib wꞌaamantii tikati. Aflaay farig kiihaay, <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />kassaan maagnaayt dꞌiyaaba aree Ukwaasana iniiweeb umatuun kinkitim, <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />aree Ukwaasanaayt nꞌimaatee, balaashii shiboot nimri, Yasuuꞌaab Umasiihi sabbii idanuubeesoon nifdag. <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />Ukwaasana Yasuuꞌaab idanuubeet karaamaateeb ifrꞌa. Yasuuꞌa umidhhanooh karramamiyaneet toonaawwa, ubooyooh ififeet toonaawwa uudehay aamaneenihoob, Ukwaasanaay geeb ishboobiin. Tuun tuuna Ukwaasana aadil ikatiyeet toona rhistini. Suur hasamiyaab udamaaniib toomaag gwibbaab oodehay dehaay asbiriyaayt jasaayaab kiiki. <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />Baruuh toon toona tushbootooh oon udamaaniib haay rhisiyi jillaay idꞌi. Aflaay Ukwaasana baliib Yasuuꞌaab aamaneen agbiliiniyihoob, shibukinaab ikatiyeet toona rhisiini.<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />Shaawti aafaal naad eefeen? Kiihaayna han? Toon toonaati sabab naanaatu? Whag nisnaakiireet toonaatiib eefeen han? Abadan! Laakiin aafaal wꞌiimaaniib eefeen. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />Hinin wꞌaadami Ukwaasanaay geeb wꞌiimaanii ishboobi niyad, aree whag yharriiweet toonaati dꞌuuyii kiiki. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />Ukwaasana Iyahuudi Kwaasana oobhaat ikati han? Ijintiili Kwaasana kiiki han? Awooh, Ijintiili han Kwaasanaayoohna ikati. <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />Ukwaasana gaalu, aree baruuh ikwashab wꞌiimaanii agbiliini, ikwashab baakay han been wꞌiimaan ooknaay agbiliini. <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />Aflaay oon wꞌiimaanii whag takweet baabariib nikwasi han? Abadan bak kiiki! Hinin whag winneet nisꞌakiir.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s">Ibraahiimiib Wꞌiimaani Misaal</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />Aflaay hoobuun Ibraahiim toon tunaatiib naan imri niyad? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />Ibraahiim ishaga yꞌidꞌiyeenee Ukwaasanaay geeb agbilamaab iiktiyeek, naat gaat haay faalamiyeet iibri. Laakiin beet toona Ukwaasanaay suurii haay kafaalamiya. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />Uuktaab naan indi? Uuktaab “Ibraahiim Ukwaasana aamaniya, beet tuuna aree shiboot dehaay tehasab.” indi.<verse eid="ROM 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 4:4" />Oontꞌa tak gaal shagaamiiniyihoob, wꞌijaaruuh umiyaawiit dehaay kiihasab. Laakiin beet toona baruuh ishagaayiisooh miraab ikati. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />Laakiin uutak shagaamaab baakaay, yꞌamag dehay agbiliniib Ukwaasana aamaniiniib been, wꞌiimaanuuh shiboot dehaay itehassiib. <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />Wꞌaadami ubaarakamaab, naat han shagaamaab baakaay, Ukwaasana barooh shiboot dehaay yhasibeenaay bhaliiyanihoob, Daawid bak indi:<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />“Libaabiyaan baliin</para>
  <para style="q2" vid="ROM 4:7">tumaagtuuhna afoomtaneeb,</para>
  <para style="q2" vid="ROM 4:7">idanuubaahna yhateeneeb.<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />Wꞌankwana idanuubeeh door han dehaay biihasiibeeb</para>
  <para style="q2" vid="ROM 4:8">uutak libaabiya.” indi.<verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />Uun uulbaab ikwashabnee dehaay oobhaat ikati han? Tari ikwashab baakaaynee dehaay han ikati? Hinin Ibraahiimiib wꞌiimaan barooh shiboot dehaay yhasab niyad. <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />Beet tuuna naadoor tiki? Ibraahiim ikwishabeenaay harꞌii tiki han, tari hankaab tiki? Batuuh harꞌii akaat kitti, laakiin hankaab tiki. <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />Aree baruuh kwishuubiit alaama imri. Tꞌalaama Ibraahiim masi kwashaab baakaay wꞌiimaaniyooh sabbii imriyeet shibu rhistini. Aflaay bareeh han beet tuushbu dehaay titehasiibi jillaay, Ibraahiim oodehay yꞌaamaneen laakiin ikwashab baakay kasseeyooh hooba ikati. <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />Baruuh masi baliib ikwashab han hooboohna ikati. Baraah kwashab ikatiini sabbii oobhaat kiiki, laakiin hoobuun Ibraahiim kwashaab baakaay sakiyeeb wꞌiimaani mꞌataayee sakeeneek oobhaat baruuh hooboohna ikati.<verse eid="ROM 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />Ukwaasana Ibraahiimwa yꞌareehwa tuduniya bareeh iniiweet toona waadiyaayanihoob, Ibraahiim whag isniikari sabbii kiiki. Laakiin beet tuuna wꞌiimaanii eetniit tushbooti sabbii tikati. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />Ukwaasana waadiyaayaneet tuuna baliib whag isnaakiir attiyeewiyaat tiiktiyeek, shaawti wꞌiimaan takweet kiidꞌi, aree Ukwaasanaay uwaadiya mishiit iikti. <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />Whag gadab haay yꞌiiniyi sabbii, whag biihaayeek, whaggi raab han kadaaya. <verse eid="ROM 4:15" /><verse number="16" style="v" sid="ROM 4:16" />Aflaay uwaadiya wꞌiimaanii yꞌiini. Shaawti uwaadiya nꞌimaatii ikati, aree kasseeh Ibraahiimiib oofraay ittiyeewi miyaaw ikati. Baliib whag isnaakiir eebhat kiikeena, laakiin baliib Ibraahiimiit aamaneen han miyaaw dehaay ikati. Aflaay Ibraahiim kasseen hooboon ikati. <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />Uuktaab bak diyaabu, “Ani gwida dehayi baaba akwaas hook.” diyaabi. Ibraahiim aamaniyaneeb, been oodehay yꞌayaab ishidhhiin, aree teena tibaahaayi waliikiiniib Ukwaasanaay igwꞌadi suurii, Ibraahiim hooboon ikati.<verse eid="ROM 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 4:18" />Kassooh isꞌayaay naawi geeb, Ibraahiim isꞌayaay aamaniya, aree aflaay gwida dehayaayi hooba iki. Tuun batuuh bariiyooh bak attiyoodiyaatu, “Yꞌaraak yhaykweet guudi iyadna.” indi uuktaab. <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />Baruuh sheeb hawlaab iibriyeek han, wꞌiimaanuuh nꞌakwaab kiiki. Ugarooyuuh winneet inꞌakw, Saara han giduudiit tiki. <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />Laakiin Ibraahiim Ukwaasanaay uwaadiyaay eetehakaab kiiki. Baruuh wꞌiimaaniyooh yꞌakir aree Ukwaasana yhamid. <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />Ukwaasana waadiyaayaab iiktiyeet toona haay danꞌiyi akrir ibariyeet toona winneet yagganamiya. <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />Oon usabbii aree barooh beet tuuna shiboot dehaay tehasab. <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />Ibhali bariiyooh dehaay yhasab, barooh oobhaanaay dehaay katab kiikeen. <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />Laakiin hinin han dehoon kataba. Ukwaasana hinin aamannayeeb, been Yasuuꞌaab Wꞌankwanaayoon tuyatii yakisiyaab, shiboot dehoon yhisib indi. <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />Hineet tumaagnaayti jillaay baruuh tuyatii dehaay nuunamiya, aree hinin Ukwaasanaay geeb agbilamaab nikatiyi jillaay, baruuh tuyatii yakamiya.<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s">Umꞌasigwa Tifirhaawwa</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />Aflaay wꞌiimaanii Ukwaasanaay geeb agbilamna, aree Wꞌankwanaayoon Yasuuꞌaab Umasiihii Ukwaasanaay geeb mꞌasig nimri. <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />Oontꞌa nibariyeet teen tinꞌima baruuh wꞌiimaani salal isꞌabikaayt hoon nimri. Aree Ukwaasanaay umatuuni isꞌayaay afirhinay. <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />Bak oobhaat kiiki, laakiin igwirhaayeen han haay afirhinay. Uun usabab aree igwirha tarmuumaab haay yꞌeeneet toona nikteen. <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />Itarmuuma dab ikati, uudab aree sꞌayaab ikati. <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />Ukwaasana tirhamaateeh Eeshuuk Imugaddasaayee iginꞌaayeen kehii fifaabuuyt, isꞌaya hoon itkitꞌa kiidi. Baliin Eeshuuk Imugaddasa Ukwaasana yhii hoon.<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />Been oodoor hinin winneet nꞌakw niiktiyeeb, Umasiih daayi door eeyaayt hinin yꞌamag dehayi jillaay iiya. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />Shibu takii dehaay iyaayi gaal han kiihaay. Laakiin daayi taki jillaay tooyat harriiw kisib daayiini. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />Laakiin Ukwaasana tirhamaateeh teekna oontꞌaaneet rhisiini hoon. Hinin masi danuubi kina niiktiyihoob, Umasiih hinee jillaay iiya.<verse eid="ROM 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 5:9" />Oontꞌa bariiyooh ubooyi sabbii Ukwaasana agbiliya hoon. Aflaay bariiyooh geebii kak hadiit Ukwaasanaay igadabee needhhani! <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />Hinin Ukwaasana ashoosamaab niiktiyihoob, Wꞌooriitooh tuyatii bariiyooh geeb nimꞌaddaaleek, aflaay amꞌaddilaab nikatiyihoob aree bariiyooh umidhhanii kak hadiit needhhani! <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />Toon toona toobhaat kitti, laakiin Ukwaasanaay geeb Wꞌankwana Yasuuꞌaab Umasiihii han afirhinay. Bariiyooh sabbii oontꞌa amꞌaduulaab nimri.<verse eid="ROM 5:11" /></para>
  <para style="s">Aadamwa Umasiihwa</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />Tumaagnaay gaal takii tuduniya shuumtaneet toonaatiit, tuuyat han tumaagtii eeta. Aflaay kassaah maagnaayt idꞌiini sabbii, oontꞌaaneet tuuyat kasseeh oodehayii dehaay eeta. <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />Whag attiyeewiyaab biikaayi door, tuumaag tuduniyaatiib tiifi. Laakiin whag biihaayihoob, tuumaag whasaabiib daayaat kitti. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />Laakiin Aadamiib udamaanii, Muusaay udamaan ookiik tuuyat kasseeh oodehayi kehii hukwimta. Aadam idꞌiyeet toonaatiit, baliib tiwasi kitꞌatiit maagnaayt kwaasaab baakay han, tuuyat hukwimta. Aadam beeb gayii yꞌaa iid oongaal tꞌiiteebi.<verse eid="ROM 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15" />Laakiin Ukwaasanaay miyaaw tumaagnaay tꞌiiteeb kiiki. Gaal takiit maagtii gwida dehay iyaana, laakiin Ukwaasanaayt tinꞌima winneet gwidakaata. Ukwaasanaayt tinꞌimaawwa gaal takiit nꞌimaatee eeyaab uumiyaawwa, Yasuuꞌaab Umasiihii ikatiib, gwida dehayii dehaay eetfiifna. <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />Masi, Ukwaasanaay uumiyaaw gaal takiit maagnaaytiit firꞌaayt tꞌiiteeb kiiki: Gaat maagnaayti harꞌii ikeeb whukwim, gwabab isꞌabik. Laakiin uumiyaaw gwidaat maagnaayti harꞌii ikeeb gwababikina kiikwaas. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />Gaal takiit maagnaayti sabbii tuuyat been ootak oongaalnaay geebii hukwimta. Laakiin been ootak oongaal Yasuuꞌaab Umasiihii daamtaat tuuna kak winneet winkaat tikati! Baliin baraah Ukwaasanaayt tinꞌima tigwidaatwa, ootak oongaal Yasuuꞌaab Umasiihii ikatiib tushbooti miyaawwa imeer kassaah Umasiihi geebii akirtiit ikwaar iyadna. <verse eid="ROM 5:17" /><verse number="18" style="v" sid="ROM 5:18" />Aflaay malya gaat maagnaay kasseeh oodehay gwabab tisꞌabik. Gaat shibooti dꞌuuy han oodehay kasseeh bak fandiig, aree midhhan iniiw. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />Gaal taki akra girmaay sabbii gwida maagti kina ikeeneek, shaawti gaal takiit sinaakrooytii han gwida shibu dehay iikti iyadna.<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />Whag toomaag gaguudsiti jillaay yꞌaabi. Laakiin tuumaag guudtiniyeeb oomhiin, tinꞌima han winneet gwidakaat ikatiin. <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />Aflaay tuumaag tuyatiib tehankiimeet toonaatiit, tinꞌima han tushbootii yhakimna, aree umidhhan udaayim Wꞌankwanaayoon Yasuuꞌaab Umasiihi geebii haay yꞌeen.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s">Umidhhan Ugayiib</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />Aflaay naan niyad? Ukwaasanaayt tinꞌima guudeeni jillaay, tumaagti dꞌuuy nisoorariim han? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />Abadan bak kiiki! Hinin tumaagnaaytii dehaay niya, shaawti kak gwida doora batiiyooh nikweer? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />Tari hinin Yasuuꞌaab Umasiihii atoomsaab kassaan, bariitooh tuyatiib han geeb atoomsaab nikatiyeet toona kitkanna han? <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />Aflaay hinin nitoomaas, niyaayt bariiyooh geeb nitoobaas. Umasiih Ubaabaay umatuunii tooyat hooy yakamiyaneet toonaatiit, hinin han gayi midhhan nimeer nikati.<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />Hinin bariiyooh geeb oontꞌaaneet tuyatiyooh gal nikatiyeek, aflaay uyaktiyooh han gal geeb niikti niyad. <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />Hinin ishuukaan aakna bariiyooh geeb sallabamiyaaneet toona nikteen. Tumaagnaayti garu han fidnaab giigiya, shaawti door han tumaagnaayti kishiya niikti kindi. <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />Baliin yꞌayaab kassaah tumaagnaaytii ifdagneet toona nikteen.<verse eid="ROM 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 6:8" />Oontꞌa Umasiihi geeb ayaab nikatiyeek, bariiyooh geeb han nikwaar niyadeet toona aamannay. <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />Umasiih tooyat hooy yakamiyaneet toona nikteen. Baruuh masi iiyyi kiidi, tuuyat han shaawti barooh hikim kitdi. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />Baruuh iyaneet tuuyat kasseeh udehayiit maagnaayti jillaay gaalhoob iiya. Laakiin baruuh kwarriyeeb ookwiraay, baruuh Ukwaasanaay dehaay kwarri.<verse eid="ROM 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 6:11" />Baraak han oontꞌaaneet bak igarooyeekna maagnaaytii dehaay ayaat toonaatiit shibibna. Laakiin Ukwaasanaay dehaay Yasuuꞌaab Umasiihii dhhaniibaana.<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />Tumaagnaay ugarooyook kehii bitehakiimeet toonaati. Ugaru iyaayi. Aflaay ugaru yharriiweet toona baasinaakirna. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />Igarooyeekna daf idanuub baahiina, tumaagnaayti gadhꞌi tꞌiiteena baakwaasna. Laakiin baliib suur iyaaniit malya idhhan sakiyaaneet toonaatiit, igarooyeekna Ukwaasana hiina. Aflaay igarooyeekna daf tushbooti gadhꞌi tꞌiiteena barooh nuunaana. <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />Tumaagnaay shaawti ankwanaatookna iikti kitdi. Baraakna whaggi whii kitehaayna, laakiin tinꞌimaati whii teefeena.<verse eid="ROM 6:14" /></para>
  <para style="s">Tushbooti Kishiya</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />Aflaay naanaatu? Hinin whaggi whii kinhaay laakiin tinꞌimaati whii neefi akay maagnaayt shagaamnay han? Abadan bak kiiki! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />Igarooyeekna ikishiyaayeet tisnaakiirni jillaay gaal nuunteenihoob, been ibaraak tisnaakiirneenaay kishiya tikatiineet toona kitkanna han? Beet tooyat tistoobiit tumaagnaayti kishiya tikatiina, tari tooshbu tistoobiit tisinaakrooyti kishiya tikatiina. <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />Laakiin whamaad Ukwaasanaay ikati. Tumaagnaayti kishiya tiiktiineek han, utꞌaliimiit hayꞌa baraakna timriineet kasseeh iginꞌaayeesookna tisnaakirna. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />Baraak tumaagnaay hooy tifdagna, aree tushbooti kishiya tikeena.<verse eid="ROM 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 6:19" />Baraak iknaayaakna nꞌakw bashar tikatiineet toonaati sabbii, ani ubashariit hayꞌaatii hadiidani. Suur igarooyeekna daf tinajaasaawwa tumaagnaaywa, tumaagnaayti shagaamtiiwwa kishiya tikwaasneet toonaatiit, aflaay oontꞌa bareeh mugaddas salal tistoobiit tushbooti kishiya kwaasna. <verse eid="ROM 6:19" /><verse number="20" style="v" sid="ROM 6:20" />Tumaagnaayti kishiya tiiktiinihoob, tushbootii fadagamaa tiifiina. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />Teen teena oontꞌa hooy sikwꞌaab tikatiineet, been oodoor naan hooy rayiimtaana? Baliit taana tufirꞌaaytuuh yat tikati. <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />Laakiin oontꞌa tumaagnaaytii tifdagna, aree Ukwaasanaay kishiya tikeena. Urayi itimeerni mugaddas salal istoobi, aree tufirꞌaaytuuh umidhhan udaayim tikati. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />Tumaagnaayti kiraay yat ikati, laakiin Ukwaasanaay uumiyaaw Wꞌankwanaayoon Yasuuꞌaab Umasiihii nimeereeb umidhhan udaayim ikati.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s">Idoobee Irhisti</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />Isanaayaan, ani oodehay whag ikteeniini geeb hadiidani, wꞌaadami dhhaniib ikatiyihoob oobhaat whag bariiyooh kehii hadꞌaayeet ibariyeet toona baraak kitkanna han? <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />Masalan, whaggii dꞌaart takat utakuuh dhhaniib ikatiyeeb ookiik batooh aasaf kehii eefeen. Laakiin utakuuh iyaayihoob, batooh aasaf hooy itfadiigna. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />Aflaay batuuh utakuuh dhhaniib akay weer tak safamtiniyeek, jakiint tittiyoodi. Laakiin utakuuh yaaytiit weer tak safamtiniyeek, batuuh been whaggiib tibari, aree batuuh jakiint kitti.<verse eid="ROM 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 7:4" />Aflaay isanaayaan, baraak han Umasiihiib ugarooy geebii whaggii dehaay tiyaana. Weernaay han aree tikatiina, Umasiih tuyatii yakamiyaab, shaawti Ukwaasanaay dehaay daayiinaayt shagaameen nikati. <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />Hinin igarooyeen eebhatneeb niikwinihoob, whag tumaagnaayti dꞌuuy isehariw hoon. Baruuh igarooyeen daf kasseeh kishiyaab ikwaasiit tooyat istoob hoon. <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />Laakiin oontꞌa whag kiihakim hoon. Hinin oodehay yꞌayaab tꞌiiteeba, aree baruuh hini kehii akrir kiibari. Oontꞌa Eeshuuk sinaakriit gayi salalii Ukwaasana shagaamnayeet toona adgirnay, aree whag ikataab sinaakriit usalal ishꞌiiyaay ishagaamti kiiki.<verse eid="ROM 7:6" /></para>
  <para style="s">Oodehaywa Ukwaasanaay Whagwa</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />Aflaay naan niyad? Whag maagnaayt ikati han? Abadan kiiki! Tumaagnaay naan tiiktiyeeb whaggii akan nuun kaakan. Whag “Weer nafariit tikatiina baahariiwa!” diyaab biikaayeek, beet toonaati harawa iikan kaadi. <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />Laakiin tumaagnaay beet tuwaseetiib fursaat timriit, aniib uunfis yhiriweet teena kasteeh hoosu yayakista. Whag anu, tumaagnaay ayaat tiikti. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />Door gaal ani whag anu ikwiir. Laakiin tuwasi eetanihoob, tumaagnaay tidhhan aree ani aya. <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />Beet tuwasi anii dehaay umidhhan haay eetiit, sidik yat haay eeta. <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />Tumaagnaay tuwaseetiib fursaat timriit, aneeb titilheeb, aree tuwasi haay tidirheeb. <verse eid="ROM 7:11" /><verse number="12" style="v" sid="ROM 7:12" />Aflaay whag mugaddasu, tuwasi han mugaddastu, shiboonaaytu aree daayiinaayti.<verse eid="ROM 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 7:13" />Beet tuuna tudaayiit anii dehaay yat tiki han? Abadan kiiki! Laakiin beet tumaagnaay tumaagnaaytiit titookkiini jillaay, beet tudaayiinaaytii aneeb tidirheeb. Aflaay tumaagnaay winneet amaagt tikatiyeet toona tuwaseetii lawta.<verse eid="ROM 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />Whag ishuukeet hayꞌaatiib ikatiyeet toona nikteen. Laakiin ani adnibani taku, aree idanuubee dehaay dalaab kishiya akati. <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />Toona tusakaniyeet kaꞌafhaman, saktiib aharriiweet toona kasakan. Laakiin toona tꞌanriibeet sakani. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />Aflaay toona tubaahariiweet sakaniyeek, whag daayiib ikatiyeet toona agbilani. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />Oontꞌaaneet, shaawti beet toona sakiiniib aneeb kaaki. Laakiin tumaagnaay aniib teefeet bak saktini. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />Aniit tehooyteeb teefeena daayiit bitkaayeet toona akteen. Beet batuuh aniit maagnaaytiit hayꞌa tikati. Daayiinaayt adanꞌiyeet toona aharriiw, laakiin beet toonaati dꞌuuy kaꞌadgiran. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />Tudaayiinaay ani udꞌuuyooh aharriiweet kaadꞌi. Abadan, ani toomaag udꞌuuyooh baahariiweet adanꞌi. Beet toona aree diimaab adanꞌi. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />Oontꞌa ani toona udꞌuuyooh baahariiweet adanꞌiyeek, beet toona danꞌiib aneeb kaaki. Laakiin tumaagnaay aniib teefeet danꞌi.<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />Aflaay oon whag shagaamee amri: Ani tudaayiinaayti dꞌuuy aharriiwihoob, tumaagnaay beentooy geebu daatni. <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />Ani tehooyteesu Ukwaasanaay whaggiib afirhaabi. <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />Laakiin ugarooyu ooknaay weer hag shagaamee rhani. Uun whag Ugirmaayu niyaamiiniyeeb whag finaasamiini. Beet tuuna tumaagnaayti haggi abuuki tikwasiheeb aree aniit tehooyteeb shagaamtini. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />Ani kak gadabi taku! Oon tuyati garooy aaw ishidhhinheeb indi? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />Whamaad Ukwaasanaayu, Wꞌankwanaayoon Yasuuꞌaab Umasiihii ikati!</para>
  <para style="p" vid="ROM 7:25">Aflaay ani uknaayu uginꞌiisu Ukwaasanaay whaggi kishiya akati. Laakiin tumaagnaaytiit hayꞌaatiib, tumaagnaayti haggi kishiya akati.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s">Umidhhan Ishuukee Ikatiib</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />Aflaay oontꞌa Yasuuꞌaab Umasiihiib ikatiin baliib gwababi sꞌabuuk kiihaay. <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />Aashuuk Imugaddasa Yasuuꞌaab Umasiihii yꞌiiniib umidhhan iyaaw hookna iyadna, aree tumaagnaaywa tuyatiiwwa isfidig hookna iyadna. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />Muusaay whag beet toonaati dꞌuuy kaꞌadgiriya. Wꞌaadamiit hayꞌa nꞌakwtuuyt, whag oobhaanaay ishagaamtii dehaay taad kiibari. Laakiin whag dꞌiyaab biikaayeet toona Ukwaasana idꞌi. Oon usabbii, Ukwaasana danuub dꞌiyaab wꞌaadamiit Wꞌoorooh ookna idanuubeet karaama iiktiyi jillaay diigwatiya. <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />Whag yharriiweet tuushbu timmiima hoon tikatiyi jillaay, hinin Aashuuk yhariwneet toonaatii nikweer nuun, wꞌaadamiit hayꞌa harriiweet toona kitti.<verse eid="ROM 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 8:5" />Baliin tumaagnaaytiit hayꞌaatii ikweer, iginꞌaayaahna beet tehayꞌa harriiweet toonaatiib daayeen. Laakiin Ishuukeet hayꞌaatii ikweer, iginꞌaayaahna Aashuuk yhariwneet toonaatiib daayeen. <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />Idanuubi dehayi ginꞌa tooyat istoobiina, laakiin iginꞌa Aashuuk aabkaab ikatiineeb midhhanwa mꞌasigwa ikatiin. <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />Idanuubi ginꞌa Ukwaasana ashoosamiini. Ukwaasanaay whag kiisinaakir, whag yharriiweet toona han kiidꞌi. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />Baliin tumaagnaaytiit hayꞌa abkaat ikatiineeb Ukwaasana kaꞌafirhisiyaan.<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />Baraak tumaagnaaytiit hayꞌaatii amꞌabkaab kitteena, laakiin Aashuuk aabkaayeekna aree Ukwaasanaay Aashuuk hookna ikweerna. Umasiihiib Aashuuk hooy biikwariineebka, Umasiihiib iikti kiidi. <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />Laakiin Umasiih hookna eefiyeek, tumaagnaayti sabbii igarooyuukna ayaab ikati. Laakiin tushbooti sabbii, ishuukaakna masi dhhaniib ikatiin. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />Ukwaasana Yasuuꞌaab tuyatii yakisiya, oontꞌa Ukwaasanaay Aashuuk hookna ikweerna. Aflaay Umasiihi tuyatii yakisiyaab Ukwaasana, wꞌaadamiit hayꞌaatookna masi ishidhhin indi. Ukwaasana beet toona bareeyookna eefeen Ishuukeesooh saki indi.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />Aflaay isanaayaan, hinin waajibt nibari. Laakiin batuuh tumaagnaaytiit hayꞌa hoon harriiweet toonaatii nikweereet toona kitti. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />Tumaagnaaytiit hayꞌa hookna harriiweet toonaatiit tikweerneek, iiyyi tiyadna. Laakiin Ishuukeet shamaamtii baraak ugarooy wꞌamaag shaga tisingiidneek, ikwaar tiyadna. <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />Baliin Ukwaasanaay Shuukee atmalalhaab Ukwaasanaay ar ikatiin. <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />Ukwaasana hiiyyaayookna ikatiyeeb Aashuuk kishiyaab kiikwaasna hookna aree kiisirakwna hookna. Laakiin Aashuuk Ukwaasanaay ar ikwasiin hookna, aree Ishuuki akriree Ukwaasana waliiknay, “Baaba, Baaba” niyad. <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />Aashuuk aakna hineeb ishuuki geeb, hinin Ukwaasanaay ar nikatiyeet toona ibadehana. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />Oontꞌa hinin areeh nikatiyeek, udehayooh iniiweet tibaraka kinaami niyad. Hinin masi Umasiihi geeb, Ukwaasana bariiyooh dehaay daasaab ikatiyeet toona han kinaami niyad. Umasiihiib igwirha geeb shaaraknayeek, umatuunooh han geeb shaaraknay.<verse eid="ROM 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />Oontꞌa nibariyeeb igwirha, umatuun hoon lawi indiinaay geeb nisnadiireek, igwirha naatikina kiikeen. <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />Ukwaasana dꞌiyaab ikatiyeena kastaah Ukwaasanaay yꞌar laweeneet toona winneet sꞌayaameen. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />Ukwaasana dꞌiyaab ikatiyeena diinanooyaana, aree bateeh tiknaati hayadaay kiiki. Ukwaasana bak iweer, laakiin masi sꞌayaab iifi. <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />Ukwaasana idꞌiyeet taana taakna bꞌeeb gaal ikishiyaamti hooy fidagtiit suusi iyadna, aree umatuuniit hirriyaay Ukwaasanaay yꞌareet tikatiit beeti yꞌi iyadna.<verse eid="ROM 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 8:22" />Ukwaasana idꞌiyeena kastaah ufiraayiit lhanayteet, oon udamaan ookiik lhameeneet toona nikteen. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />Laakiin bateeh oodꞌoohna kiikeena, hinin Ishuuki awwal firaay ibariin han tehooyteesoon gagarnay. Ukwaasana areeh ikwasiyeetoon toona nhagit, aree igarooyaan itfadiigneet toona nhagit. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />Hinin oon isꞌayaay nidhhan. Laakiin isꞌaya ulawiini sꞌayaab kiiki. Suur ibariyeena sꞌayaamiiniib aabu? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />Laakiin hinin masi binbariiyeena sꞌayaamnayeek, asbireetiit nhagit.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />Oontꞌaaneet, hinin ootaad kinbariyayt, Aashuuk Imugaddasa eeshtiimna hoon. Hinin naanaati jillaay siilalnayeeb kinkan. Laakiin Aashuuk Imugaddasa baahadiidamiit hayꞌaatii dehoon siileeleen. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />Ukwaasana iginꞌaayeen teefeet toona ikteen. Aashuuk yhariwneet toona han ikteen. Aashuuk han Ukwaasana yharriiweet toonaatiit, hinin yꞌaamanaayee dehaay siileeleen.<verse eid="ROM 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />Ukwaasana baliib ibarooh areeyeen oodehay eeshtiimi jillaay shagaamiiniyeet toona nikteen. Baruuh bareeyooh dehaay ikatiint teena kasteeh daayiinaayt haay yꞌiiniyi jillaay ikwasi. Baruuh beet toona bariiyooh ishagaay dehaay waasamaab oodehayii dehaay danꞌi. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />Ukwaasana udehayooh whankaay iktiin, aree Wꞌoorooh tꞌiiteeb iiktiini jillaay waasiya. Aflaay Wꞌooruuh gwida wari sanaayeebwa kwaateebwa iikti indi aree baruuh wꞌoor usuurkina iikti indi. <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />Ukwaasana bareeh suur waasaabuuyt, bareeh han waliikiya. Baliib ibaruuh waliikiyaneeb, bareeh han agbiliya. Baliib ibaruuh agbiliyaneeb, bareeh han isoowin.<verse eid="ROM 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />Aflaay kasteeh teen tinaateeb naan nigweebeet toonaatu? Ukwaasana geeboon daayiiniyeek, aaw weer adgiriit kehoon daayi indi? <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />Wꞌoorooh ookna han ishaab kiiki, laakiin kasseeyoon jillaay barooh karaamaateeb ifrꞌa. Aflaay hinin han, wꞌooriyooh geeb, kak winneet gwidaana iyaaw hoon kiidi han? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />Baliib Ukwaasana waasaab ikatiyeeb aaw atehimi indi? Baraah gwabab biibariineet toona Ukwaasana uukna sooyiini. <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />Aflaay bareeh gariimiib ikwasi aabu? Yasuuꞌaab Umasiih, wꞌayaab, beenaatiika gwidakaana aree beeb tuyatii yakamiyaab, Ukwaasanaay umaygwadiib eefeeb, bariiyooh geeb hinee dehaay ashfꞌiiniib kiiki han? <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />Umasiihiib ooreer aaw hooy ishiishamiidh hoon? Igwirha tari uumaag tari wꞌamaag wara, tari tehargwi tari iraboob tari ibidhꞌi tari bꞌadhadh han? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />Tuun batuuh uktaabiib kataabtu:</para>
  <para style="q1" vid="ROM 8:36">“Bariiyook jillaay hinin kassooh oombꞌi nimoosꞌi.</para>
  <para style="q2" vid="ROM 8:36">Wharuudi arginiit ishbibna hoon.” indi.<verse eid="ROM 8:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37" />Abadan, kasteeh teen tinaateeb hinin barooh areeyaan baliin bariisooh timmiimaat nasra nibari.<verse eid="ROM 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ROM 8:38" />Ukwaasanaay reerii naat han door ishiishimidh hoon bitdiyeet toona winneet akteen. Yat tari midhhan, malak tari jin, amseeneeb udamaaniib tari gayii yꞌiiniib udamaaniib, tari ikatiin akrir han Ukwaasanaay reerii ishiishimidh hoon kiidiin. <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />Tibreeteeb asti eefeen akrirwa, tari tubuutiib nꞌati eefeen akrirwa, tari kastaah Ukwaasana kwaasaab ikatiyeet taanaawwa han, door han adgiriit Ukwaasanaay reerii ishiishimidh hoon kiidiin. Been uureer Yasuuꞌaab Umasiih Wꞌankwanaayoon lawi indi.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s">Ukwaasanaawwa Udehayoohwa</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />Ani Umasiihiib oosdik bhaliisamani hookna, gwisir kahadiidan. Aashuuk Imugaddasa uginꞌu yhakimna, aree gwisir baahadiidayeet toona baraah anii dehaay badehiiba. <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />Aniit tehooy winneet gadabaata, aree uginꞌu lhasiiniheeb. <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />Baliib ubasharoowwa ubooyoowwa ikatiin udehayu jillaay, ani uknaayu Umasiihii kitꞌatiit atooꞌitaab iiktiyeet toona minniiman. <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />Baraah Israaꞌiili dehay ikatiin. Ukwaasana bareeh areeh ikwaasiit umatuunooh dehaay lawisiya. Bareeh galad geeb idꞌi, whag yhiit aree sidik ibaadaat ibariin ikwaas. Bareeh gwidaat daayiinay dehaay waadiyaaya. <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />Bareesooh Yꞌibriyaayi hooba eeyaan. Umasiihi han wꞌaadamiit hayꞌaatiib bareesooh eeya. Masi aree, baruuh kasseeyooh Kwaasana daayim baarakamaab ikati. Aamiin.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />Ani Ukwaasanaay ibhali dhibiyaan kaadi. Laakiin kassaah Israaꞌiileeb uudehay Ukwaasanaay sidki dehay kiikeen. <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />Ibraahiimiib uutaas kassaah han Ukwaasanaay ar kiikeen. Ukwaasana Ibraahiimii dehaay, “Ani geebook adꞌiyeeb ootaasi waadiya Isehaagii imaar tindiya.” idi. <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />Uun aree bak miyaad ikati: yꞌar yꞌitfariin kassaah Ukwaasanaay ar kiikeena, laakiin uwaadiyaay firaay Ibraahiimi ar ikatiin. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />Uun Ukwaasanaay uwaadiya bak bhaliimiya: “Oodoor uwaadiyaamaanaay ani itꞌigir andi, aree Saara oor ifaar tindi.” diyaabi.<verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />Oon oobhaat kiiki, laakiin Ribeekaay yꞌar imalu han gaal baaba ibariina aree baruuh hooboon Isehaag ikati. <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />Masi itiita faray baakaay tari daayiina tari amaagna baadꞌi, Ukwaasana harriiweet tuuna hayadaay iikti tindi. <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />Beet tuuna shagaay kitti, laakiin been uwaliikiini iikwasi indi. Batuuh soomamta, “Wꞌoor uuwin been oodisnaay whii shagaami indi.” idi.<verse eid="ROM 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 9:13" />Tuun batuuh uktaabiib bak kataabtu: “Yaaguub areeyan, laakiin Iisaaw arib.” diyaabi.<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />Aflaay naan niyad? Ukwaasana daalimu han? Abadan kiiki! <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />Baruuh Muusaay dehaay,</para>
  <para style="q1" vid="ROM 9:15">“Ani rhamaat dehaay abariyeeb, beeb arhami andi,</para>
  <para style="q2" vid="ROM 9:15">aree nꞌakwmanaatiib dehaay abariyeeb beeb dehaay nꞌakwmanaayani.” indi.<verse eid="ROM 9:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="ROM 9:16" />Aflaay wꞌaadami harriiweet toona kitti tari wꞌaadami shagaay tikatiina kitti. Laakiin Ukwaasanaayt rhamaatee tikati. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />Uuktaab Farꞌuunii dehaay: “Toon toonaati jillaay ani yaksan hook, ani yꞌakriri kehook lawsi andi, aree uusmu kastooh toobuuti kehii itbirir indi.” indi. <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />Shaawti Ukwaasana arhamtiib harriiweeb beeb arhamiini, amaagniyaastiib harriiweeb han amaagniyaasiini.<verse eid="ROM 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />Gaal bareesookna: “Aflaay Ukwaasana naanhooy masi imooyi hoon? Baruuh harriiweet toona aaw inriib?” iyaadeheeb indi. <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />Laakiin yaa wꞌaadami, Ukwaasanaay dehaay ibhali gwanbiib baruuk aab tikatiya? Uudiwaan ootak ishagaamiyaab raatiit, “Naanhooy bak tidꞌiyaheeb?” indi han? <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />Uutak oodiwaan shagaamiiniib whaash harriiweet hayꞌa ikwasiyeet toona kaꞌadgiriya han? Gaal haash hathiktiit malu diwan ikwasi, gaal waasamaat manaasabaatii dehaay ikwasi, ooraaw aree kassoohoob haay kashagaamiya han?<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />Aree Ukwaasana ikwasiyeet tuuna han sidik bak tikati. Baruuh igadabeeh rhisiiniyeet toona harriiw, aree yꞌakrireeh isookiin. Laakiin baliib bariiyeeh igadab iyay aree imtariim. Bareeh ukwidhii dehaay soomraab ikati. <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />Baruuh masi umatuunooh oowin lawistiib harriiw. Hinin bariiteeh tirhama niyay aree umatuunooh kehoon ifif idꞌi, umatuunooh niyayi jillaay aree isoomir hoon. <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />Hinin han baruuh waliikiyaneeb oodehayii nikati, Iyahuudi bitikii oobhaat kiiki. Laakiin kasseeh Ijintiili bitikii waliikiya hoon. <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />Hoosiyaay uktaabiib baruuh bak indi:</para>
  <para style="q1" vid="ROM 9:25">“Oodehay aniib baakay ani waliiki andi, ‘Udehayu’ iyaad andi.</para>
  <para style="q2" vid="ROM 9:25">Oodehay ani areeyaab baakaayeeb aree, ‘Ureerkinaayi’ iyaad andi.<verse eid="ROM 9:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="ROM 9:26" />Masi, tuun batuuh iikti tindi, baraah ‘Baraak anii dehay kitteena’ hooy ittiyoodaayneeb oomhiin,</para>
  <para style="q2" vid="ROM 9:26">beentooy baraah, ‘Ukwaasana Udhhaniinaay ar.’ waliikami iyadna.” idi.<verse eid="ROM 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 9:27" />Isyaas Israaꞌiiliib oodehayi haaliib bak hadiidiya:</para>
  <para style="q1" vid="ROM 9:27">“Yꞌisraaꞌiilaayi dehayi adad ubhari issii haddiib iiktiineek han,</para>
  <para style="q2" vid="ROM 9:27">bareesooh winneet shalik baagi uubhaat iidhhan indi.<verse eid="ROM 9:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ROM 9:28" />Wꞌankwana winneet waliiki indi,</para>
  <para style="q2" vid="ROM 9:28">ibhaliyaah tubuuti kehii willa iikti iyadna, aree aakhar bhaliib iikti iyadna.” idi.<verse eid="ROM 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ROM 9:29" />Toon han suur Isyaas diyaabu:</para>
  <para style="q1" vid="ROM 9:29">“Wꞌankwana Wꞌalya</para>
  <para style="q2" vid="ROM 9:29">taas gal hoon simhaab biikaayeek,</para>
  <para style="q1" vid="ROM 9:29">Sadoom tꞌiiteeb niikti,</para>
  <para style="q2" vid="ROM 9:29">Gamooraab tꞌiiteeb niikti.” diyaabi.<verse eid="ROM 9:29" /></para>
  <para style="s">Israaꞌiileeb Wꞌaamanti Naaw</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />Aflaay naan niyad? Ijintiili tooshbu dꞌiyaab baakaay shiboot wꞌiimaanii imriin. <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />Laakiin Israaꞌiil tushbooti hag idꞌiin baliin, tooshbu miraab kiikeen. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />Aflaay kak ikeena? Baraah tooshbu wꞌiimaanii dꞌiyaab kiikeena, laakiin ishagaayoohna dehaay adehamiyaan. Shaawti baraah igafna, “Wꞌawi igoofanaay” kehii igafna. <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />Uuktaab bak indi:</para>
  <para style="q1" vid="ROM 9:33">“Shibibna, Ani wꞌawi oodehay goofiiniib, Sihiyooni kehii bꞌani,</para>
  <para style="q2" vid="ROM 9:33">aree uliilaaw bareeh dhibsiiniib, barooh aamaniiniib uutak door han iiskwꞌa kiidi.” indi.<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />Isanaayaan, Ukwaasana udehayu Yꞌisraaꞌiili ishidhhiineet toona kassooh uginꞌiisu aharriiw aree beet toonaati jillaay Ukwaasanaay dehaay siileelani. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />Baraah Ukwaasana areeyeeneet toona akteen, laakiin baraah beet toona kak idꞌaneeb kiikanna. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />Baraah Ukwaasanaay eetniit tooshbu kiikanna. Baraah Ukwaasanaay geeb agbilamaab ikatiini jillaay, eeknaayi salali dꞌuuy jarrabiyaan. Ukwaasanaayt tushbooti salalii sakaab kiikeen. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />Umasiih whaggi agiya ikati, aflaay baliin yꞌaamaneen kassaah beentooy shiboot imaar iyadna.<verse eid="ROM 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />Muusa tooshbu whaggii tikatiit bak awsifiini: “Uutak teen teena danꞌiib bateesooh ikwaar indi.” indi. <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />Laakiin tuushbu wꞌiimaanii tikatiinaatiib uuktaab bak indi: “Uginꞌiisook, ‘Teebri aaw reewi indi?’ baadiya. (Beet tuuna aree Umasiih tibreetee nꞌati tikwsitiib tikati.) <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />Tari ‘Aaw nꞌati tehooy tikwi indi?’ baadiya.” indi. (Beet tuuna aree Umasiih tuyatii yakisitiib ikati.) <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />Laakiin uuktaab bak indi: “Ukwaasanaayt diigwat tidwil hook. Uyafiyook teefi, aree uginꞌiyook teefi.” indi. Beet wꞌiimaaniit diigwat tookna hinin bhaliinay. <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />Tudiigwat bak tindi: Yasuuꞌa Wꞌankwana ikatiyeet toona fidhadhtiit uginꞌiisook aamantiniyeek, aree Ukwaasana barooh tuyatii yakisiyaneet toona aamantiniyeek, iidhhan tindiya. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />Uginꞌiisook aamantiniya, aree agbilamtiniya, aree uyafiisook titfadhiidha aree midhhan marriya. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />Uuktaab bak indi: “Barooh aamaniiniibka door han iiskwꞌa kiidi.” indi. <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />Iyahuudiiwwa Ijintiiliiwwa farig kiibariin. Been Wꞌankwana uungaal kasseeh Ankwanaayoohna ikati, aree barooh waliikameen kasseeh winneet baarakiini. <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />Uuktaab “Wꞌankwanaay oosmii waliikeen baliin kassaah midhhan imaar iyadna.” indi.<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />Aflaay barooh ookna aamanaab baakaay uudehay kak barooh waliikeen? Aree barooh ookna maaswaab biikaayneek kak aamaneen? Aree tak gaal bareeh bhaliisamaab baakaay, baraah kak eemsiiwna? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />Bareeh gaal dehaay diigwatamaab biikaayeek aree kak bhaliiyeena? Uuktaab bak indi: “Baliin usakana udaayiib haay yꞌeen kak iragadaayaahna daawriiba!” indi.<verse eid="ROM 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 10:16" />Laakiin usakana udaayiib agbiliyaan Yꞌisraaꞌiili kasseeh kiikeen. Unabi Isyaas bak indi: “Yaa Wꞌankwanaay, tudiigwattoon aaw aamaniya?” indi. <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />Aflaay tudiigwatti maaswii wꞌiimaan yꞌiini, aree Umasiihi bhaliyee tudiigwat titmassiiw. <verse eid="ROM 10:17" /><verse number="18" style="v" sid="ROM 10:18" />Laakiin ani raatani: Baraah maaswaab kiikeen han? Sidiku baraah imaasiwna. Uuktaab bak indi:</para>
  <para style="q1" vid="ROM 10:18">“Bareeh whissuuhna toobuut kastooh iktim,</para>
  <para style="q2" vid="ROM 10:18">tikalmaataahna tuduniyaati agiya iktimna.” indi.<verse eid="ROM 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />Ani masi raatani: Yꞌisraaꞌiili afhamaab kiikeen han? Awwal, Muusa bak indi,</para>
  <para style="q1" vid="ROM 10:19">“Baliib oodehay baakay isehisid hookna andi,</para>
  <para style="q2" vid="ROM 10:19">tufhama baabariin oodehayii isehis hookna andi.” indi.<verse eid="ROM 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />Isyaas gwꞌagwuuyt hadiidiya,</para>
  <para style="q1" vid="ROM 10:20">“Aneeb hariwaab baakay uudehay baliin imriinheeb.</para>
  <para style="q2" vid="ROM 10:20">Anii raataab baakay oodehay baliib ani uknaayu dehaay lawan.” idi.<verse eid="ROM 10:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />Laakiin Israaꞌiili dehayiib hadiidiyanihoob, baruuh,</para>
  <para style="q1" vid="ROM 10:21">“Kassooh oombꞌi oogwimad</para>
  <para style="q2" vid="ROM 10:21">oodehay ibaasinaakiir ani wꞌayu dehaay abrir, aree baraah tisnaakirooy iribna.” idi.<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s">Israaꞌiili Baagi</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />Aflaay ani raatani: Ukwaasana een oodehay irib han? Abadan! Ani uknaayu Israaꞌiiliib akati, Ibraahiimiit dirriyaaytii akati, Binyaamiiniit tugabiilaatii akati. <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />Ukwaasana whankaay waasaab ikatiyeeb udehayooh ribaab kiiki. Uuktaab Eelyaay uktaabiib diyaab ikatiyeet toona kanaab kitteena han? Eelya Israaꞌiili dehayi kehii Ukwaasana ashkiimiya: <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />“Yaa Wꞌankwanaay, baraah inabiyaayeek idaarna, aree tikaraamaati mhiinan katꞌiyaan. Ani uubhaat oodꞌu amhi, aree baraah anii madar yhariwna.” idi. <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />Ukwaasana aree bariiyooh dehaay naan igwibi? Ukwaasana “Asarama alfa da Baꞌalii dehaay kuuramaab baakay aneeb uknaayu dehaay adbi.” idi. <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />Aflaay oontꞌa han, Ukwaasana tinꞌimaateesooh waasaab ikatiyi baagi eefi. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />Ukwaasanaayt tinꞌimaatee nuun, baraah shagaamaab ikatiini shagaay kiiki. Ukwaasana oodehay ishagaayiisoohna waasaab iiktiyeek, shaawti tinꞌimaataah sidik nꞌimaat kiiꞌattiyoodaayna.<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />Aflaay naanaatu? Israaꞌiili dehay toona baraah yhiriwneet miraab kiikeen. Ukwaasana waasaab ikatiyeeb shalik dehay aabhat imriin. Uudehay aaraw Ukwaasanaayt tuwaliik sinaakraab kiikeen. <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />Tuun batuuh uktaabiib kataabtu:</para>
  <para style="q1" vid="ROM 11:8">“Ukwaasana bareeh iginꞌaawwa igirmaawwa assiya.</para>
  <para style="q2" vid="ROM 11:8">Oon amsi ookiik baraah karhiyaana tari kiimaasiwna.” indi uuktaab.<verse eid="ROM 11:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="ROM 11:9" />Daawid han indi: “Baraah tumꞌariituuhna sharakwa tooliitwa hooy batiikti!</para>
  <para style="q2" vid="ROM 11:9">Goofamiit ijasa yꞌastehaleeneeb jasaameen baꞌiiktiin.<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />Tiliiliyaataahna thibnamiit shaawti rheen biikaayna,</para>
  <para style="q2" vid="ROM 11:10">ingꞌaayaahna diimaab agwalaab baꞌiiktiin.” diyaabi.<verse eid="ROM 11:10" /></para>
  <para style="s">Ijintiili Midhhan Imaar Iyadna</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />Ani masi raatani: Iyahuudi igafnihoob, dhibiyaaniit kwidhiyaan han? Abadan, bareeh tumaagtiyoohna sabbii, Israaꞌiileeb tugiira yayakisti jillaay, umidhhan Ijintiili imriin. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />Laakiin Iyahuudiit maagnaay tuduniyaatii dehaay miraay ikatiyeek, tehasartaahna aree Ijintiilee dehaay miraay ikatiin. Aflaay Iyahuudi kassaah timmiimeeneek, kak gwidaka miraay iikti indi!<verse eid="ROM 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />Ani bareek Ijintiili bhaliisamani. Ani Ijintiilee dehaay linguumaabu aree oon ishagaayiisu habnami andi. <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />Ani udehayu ooknaay tugiira yayakseetiit wꞌiimaan yhariw iikwasi andi, aree galib hooy ishidhhin andi. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />Bareeyuuhna uuraab tuduniyaati geeb amꞌaduulaab ikwasiyeek, aflaay baraah agbilameenihoob, aya dehay tuyatii eedhhaniin tꞌiiteena iikti tindi. <verse eid="ROM 11:15" /><verse number="16" style="v" sid="ROM 11:16" />Wꞌajiini tarab awwal firꞌaaytiit karaama mugaddasaat ikatiyeek, aflaay kassuuh wꞌajiin mugaddas ikati. Ugadam mugaddas ikatiyeek, aalꞌid han mugaddasaab ikatiin.<verse eid="ROM 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 11:17" />Saytuuni lꞌid gali katꞌamiyaaneek, malaali saytuuni lꞌid hooy imshawwaayniit eelꞌid irawi geeb hiddaab yakiyaan. Baraak Ijintiili been umalaali saytuuni lꞌiid tꞌiiteebaana, oontꞌa Iyahuudi geeb hiddaab wꞌiimaaniyookna gadam tisꞌakiirna. <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />Aflaay baliin eelꞌid haay faalamaana. Bak sakteeneek, toon toona shibibna: Baraak ugadam kitsꞌakirna, laakiin ugadam isꞌakiir hookna. <verse eid="ROM 11:18" /><verse number="19" style="v" sid="ROM 11:19" />Malya baruuk, “Aalꞌid katꞌamaaba, aflaay ani mhiin imaar andi.” tindiya. <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />Beet tuuna sidiku. Baraah aamanaab kiikeenayt katꞌamiyaana, aree baruuk wꞌiimaanii hayaayta. Atoorbiib baaꞌakaa, laakiin rikwiya. <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />Ukwaasana eelꞌid yꞌasliya han ishaab biikaayeek, barook kak inꞌiish hook?<verse eid="ROM 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22" />Aflaay Ukwaasana kak daayiibwa akraabwa ikatiyeet toona iginꞌookna hooy dꞌiya: Idhibiyaan baliib dehaay ankiir, laakiin beet bariitooh tudaayiinaay tisoorariimeek, baruuh bariiyook dehaay daayiibi. Bak biikaayeek, baruuk han itkitꞌa tindiya. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />Iyahuudi wꞌiimaani naawoohna eeyꞌishneek, baraah oomhiin suur iifiineeb daasami iyadna. Ukwaasana beet toonaati dꞌuuy adgiriini. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />Baraak Ijintiili umalaaliib yakiiniib Isaytuuni hindi ikatꞌamaab, malya suur baakaayna, adaay Saytuuni hindiib imshawawiib tꞌiiteebaana. Iyahuudi oon whindi wꞌadaay tꞌiiteeba. Aree een eelꞌid ikatꞌamaab whindiyoohna ooknaay dehaay wꞌaguur Ukwaasanaay dehaay winneet laamaanaati.<verse eid="ROM 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />Isanaayaan, aflaay infiiseekna bittageegsayni jillaay, toon toona tukwabaas tikteeniineet toona aseharriiw hookna. Israaꞌiileeb oodehayi amaagniya diimaab iikti kiidi, laakiin Ijintiili adad timmiima Ukwaasanaay dehaay yꞌeeneeb ookiik oobhaat iikti indi. <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />Shaawti kastuuh Israaꞌiil iidhhan iyadna. Tuun aree uktaabiib bak kataabtu:</para>
  <para style="q1" vid="ROM 11:26">“Wꞌishidhhiin Sihiyoonee yꞌi indi,</para>
  <para style="q2" vid="ROM 11:26">Yaaguubiit dirriyaaytii aree yꞌamag dehay kasseeh giigsi indi.<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />Ani bareeyooh geeb oon ugalad iidꞌa andi</para>
  <para style="q2" vid="ROM 11:27">tumaagtoohna afooyi andi.” indi uuktaab.<verse eid="ROM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28" />Baraah Usakana Udaayiib iribnayt, bareek Ijintiili jillaay Iyahuudi Ukwaasanaay ashu ikatiin. Laakiin Ukwaasana bareeh waasaabu aree bareeyooh yhoobaayi geeb galad dꞌiyaabuuyt, bareeh masi areeyiini. <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />Ukwaasanaay miyaawwa tibarakaataahwa kiibilalna. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />Baraak Ijintiili suur Ukwaasana sinaakraab kitteena. Laakiin oontꞌa Iyahuudi sinaakraab kiikeenayt, oontꞌa baraak Ukwaasanaayt rhama timriina. <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />Oontꞌaaneet, baraak timriineet tirhamaati sabbii, Iyahuudi oontꞌa Ukwaasana sinaakraab kiikeen. Shaawti baraah han oontꞌa Ukwaasanaayt rhama imeer ikatiin. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />Ukwaasana oodehay kasseeh tisnaakrooyti naawi abuuki ikwaas. Shaawti bareeh kasseeh rhamaat iniiw ikati.<verse eid="ROM 11:32" /></para>
  <para style="s">Ukwaasana Hamidna</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />Ukwaasanaay miraay kak gwidaab ikati! Tifagarandiitaahwa tukanaantuuhwa kak gwidaat ikatiin!</para>
  <para style="q2" vid="ROM 11:33">Bariiyooh oomkir aaw adgiriit fassariini?</para>
  <para style="q2" vid="ROM 11:33">Bariiyeeh isalala aaw adgiriit afhamiini? <verse eid="ROM 11:33" /><verse number="34" style="v" sid="ROM 11:34" />Uuktaab bak indi:</para>
  <para style="q1" vid="ROM 11:34">“Wꞌankwanaay oognꞌa aaw ikteen?</para>
  <para style="q2" vid="ROM 11:34">Barooh aaw nasehaat iniiwee dehaay adgiriini?<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />Ukwaasana naat hiiyya gaal han kiihaay,</para>
  <para style="q2" vid="ROM 11:35">aflaay Ukwaasana bariiyooh dehaay kwansiyeena kitehaay.” indi uuktaab.<verse eid="ROM 11:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="ROM 11:36" />Kasteeh teena baruuh dꞌiyaabu, aree kastaah taana bariiyooh geebii ikatiina, aree kastaah taana bariiyooh dehaay itꞌagiirna.</para>
  <para style="q2" vid="ROM 11:36">Umatuun diimaab bariiyooh baꞌiikti! Aamiin.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s">Umasiih Gayi Midhhan Haay Yꞌiini</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />Aflaay isanaayaan, Ukwaasanaayt rhamaati sabbii, igarooyeekna umidhhaniit karaamaateeb tifarꞌaneet toona sooyani hookna. Taan bataah Ukwaasanaay dehaay mugaddasaat ikatiina aree Ukwaasana afirhiseen. Uun baruuh Ukwaasana haay tꞌabidni sidki salal ikati. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />Oon tuduniyaati dehay tꞌiiteeb baaꞌakeena, laakiin Ukwaasana usalal whaay teekwinneeb bagayyari. Malya Ukwaasana dꞌuuy hookna harriiweet toonaawwa tudaayiinaay barooh afirhistiniitwa timmiima iikan tiyadna.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />Ani attiyeewiyaab akatiyeet tinꞌimaati sabbii, bareekna kasseekna andi hookna: Ugarooyook hallaay tehayeeb whaaliisookka hayiskaab baahiisa. Laakiin ugarooyook daayiib hooy kwina. Ukwaasana hiiyyaayook ikatiyi wꞌiimaani abaariit hayꞌaatii hakima. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />Hinin kassaan gaal garooy tehooyteeb gwidaana nibari, kastaah taan taana gaatka shagaab ibariin. <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />Oontꞌaaneet hinin gwidaab nikatiyeek han, Umasiihiib amshawwaaytiit bariiyooh geeb gaal garu nikati. Gaal garooyt hooyteeb teefeet toonaatiit, hinin kassaan taktakeeb nimeeshiwi. <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />Ukwaasana hiiyyaayoon ikatiyeet tinꞌimaatiit hayꞌaatii hinin gwida miyaaw nibari. Wꞌaadami miyaaw siruud ikatiyeek, aflaay baruuh wꞌiimaaniyooh haddiina sarriideet toonaati. <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />Shagaamtiib ikatiyeek, bashagaami, allamtiib ikatiyeek, baꞌallami. <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />Sꞌakrooyt tikatiyeek, baꞌisꞌikir, weer shanha dehayi miyaaw ikatiyeek, fadaag ayii baꞌiyaaw. Suurkinaamtiib ikatiyeek, daayiib shagaamiit basuurkinaami. Rhamaati rhisti ikatiyeek, afirhaa baꞌarhami.<verse eid="ROM 12:8" /></para>
  <para style="s">Ooreer</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />Uureer ibakii usidkii ikatiyeet toonaati. Toomaag ribna, tudaayiinaaytiib kaleewamaana. <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />Isanaayeet taktak areeyaana. Oodehay eeraw igarooyeekna mhakwal hamooysaana. <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />Akraab shagaamaana, hasraab baaꞌakeena. Wꞌankwana kassooh uginꞌiisookna daayiib shagaamaana. <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />Isꞌayaay afirhaana, igwirhaayeeb tarmuumaab dꞌiina, aree kassooh oodoor siileelaana. <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />Ukwaasanaay dehay shanhatiyaat ibariin umraayookna adhidhna. Igirbaab hadarna.<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />Amaag iwariineekna baliib deharna! Deharna aree baaꞌatna. <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />Baliib yꞌafirhaana geeb afirhaana, baliib iwaaweenni geeb waawaana. <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />Gaal uraawi geeb shiboobnaat kwiriina. Kibir baadꞌiina, laakiin oodehay imiskiina araweesamaana. Igarooyeekna fagaraab baahiisaana!<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />Toomaag aree weet maagtii baakwasiina. Digwagwna! Kasseeh oodehayi suurii daayiina dꞌiina. <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />Kasseeh oodehayi geeb mꞌasgiib tikweerni jillaay, kastooh tꞌadgirteena dꞌiina! <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />Yaa yꞌarawaan, illaat baakwiseena, laakiin Ukwaasana gadabiit bajasaayi. Tuun batuuh uktaabiib kataabtu: “Tꞌilla aniita, ani itkwis andi.” indi Wꞌankwana.<verse eid="ROM 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 12:20" />Laakiin uuktaab bak han indi:</para>
  <para style="q1" vid="ROM 12:20">“Wꞌashooyuuk hargwaab ikatiyeek tamsaa,</para>
  <para style="q2" vid="ROM 12:20">yaweeb ikatiineek yam gwꞌasaa.</para>
  <para style="q1" vid="ROM 12:20">Een tiwariyeek, balooleent dhhaliiti koom bariiyooh kehii tififa.” indi.<verse eid="ROM 12:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 12:21" />Tuumaag bitgariib hookna, laakiin toomaag daayiinaaytii giribna.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s">Isuurkinaayeet Sinaakrooy</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />Ukwaasana yaksaab biikaayeet hikwuuma tingadiit kitehaayayt, gaalka ibakii whaashiib eefeent tehikwuuma isnaakiireet toonaati. Tehikwuuma tꞌeefeent Ukwaasana dꞌiyaabi. <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />Tehikwuuma tꞌeefeent imooriibka, Ukwaasana sooyaab ikatiyeet toona han ribaab ikati. Baliin bak sakeen igarooyeehna kehii hukwim iikwasi iyadna. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />Uudehay tidaayiinay sakeen yhaakmaayee biirakwiineet toonaati. Laakiin uudehay timaagnay sakeen aabhat yhaakmaayee ireekwna. Yhaakmaayi mirkwaay anu kwarriyeet toona harriiwa? Aflaay daayiinaayt dꞌiya aree baraah hamooysi hook iyadna. <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />Baraah Ukwaasanaay kishiyaaba. Aree bariitook daayiinaaytiib shagaameen. Laakiin amaagna saktiniyeek, bareeh rikwiya. Baraah oodehay haay jasaayeeneet hadꞌaayi ibariin. Baraah Ukwaasanaay kishiyaaba, aree bariiyeeh wakiila ikatiina, toomaag sakeen oodehay jasaayeen. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />Aflaay yhaakma ibakii tisnaakiirneet toonaati. Jasaab jasaayeeni sabbii oobhaat kiiki, laakiin bareetooh tisnaakrooy daayiit tikatiyeet toona uginꞌuuk han sooyiini hook. <verse eid="ROM 13:5" /><verse number="6" style="v" sid="ROM 13:6" />Oon usabbii aree tilbaat tikweesna. Yhaakma Ukwaasanaay kishiyaabayt, kasseeh idamaneehna hukwimiib hasseena. <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />Gaalka toona hook harriiweet hiiyya: Tilbaat hook titeharriiweek, titilba kwisiya. Jamruuk hook iteharriiweek, ijamruukook kwisiya. Hamooyseeb hook iteharriiweek, aflaay hamooysa. Hamaad hook iteharriiweek, aflaay oodehay hamida.<verse eid="ROM 13:7" /></para>
  <para style="s">Taktakee Dehaay Tuwaajib</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />Udeenook diimaab kwisiya. Taktakeeb ooreeri deen oobhaat soorarimna. Oodehay eeraw areeyiiniibka Ukwaasana sinaakraab ikati. <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />Tiwasi “Baajikina, baadira, baagwihara, araawiitookna baahariiwa,” iyadna. Taan tiwaseewwa taaraw kastaahwa, “Ushawawook ugarooyiitook areeyaa.” tindiit gaat wasi ikatiin. <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />Uureer ushawwooh kaꞌadaaya. Aflaay uureer whaggi timmiisti ikati.<verse eid="ROM 13:10" /></para>
  <para style="s">Ukwaasanaay Unuuriib Kwiriina</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />Toon toona aree dꞌiina, oon udamaan wꞌeefeeb afhamaana. Tinꞌariitiisookna bꞌarna, tuusꞌa shaawti yꞌaati. Awwal aamannaneet tuyintiika Oontꞌa umidhhanuun dawilkaab ikati. <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />Whawaad shaawti idwil, uumbꞌi aflaay yꞌaabi. Shaawti uthibni shaga singadnaat, unuuri gadhꞌi gadhꞌamaana. <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />Oodehay oombꞌii nuuriib ikweerneet, daayiib saknayeet toonaati. Jikuuniib tari askirtiib baayakaana, amaag yaf baadꞌiina tari baaneewsamaana. Baaꞌamgwashshaashna tari baahaasadsamaana. <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />Laakiin igarooyeekna Wꞌankwana Yasuuꞌaab Umasiihi sitookwna. Tumaagnaaytiit hayꞌaatookna baaramna, aree batuuh hookna harriiweet toona baadꞌiina!<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s">Taktak Hamooysaana</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />Wꞌiimaanuuh nꞌakw ikatiyeeb baliib agbilaana, bareeh halaagaaytiib amgwasaartiit baahaakamaana. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />Dehay gali wꞌiimaanuuhna naatka tamsiiniyeeb hiiseen. Laakiin wari dehay, wꞌiimaanuuhna nꞌakw ikatiyeeb, khadaar oobhaat tameen. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />Uutak naatka tamiiniib, beeb naatka baatamii ootak ibakii biiꞌabaabayeet toonaati. Naatka baatamii uutak aree ootak naatka tamiiniib ibakii gwabab biisꞌabiikeet toonaati. Ukwaasana barooh agbiliya. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />Weer taki kishiya haakamiini baruuk aabwa? Baruuh ooknaay kishiya yaksiini tari dhibsiini. Wꞌankwana barooh yaksiiniyeet toona adgiriini.<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />Tak gaal bꞌeeb gaal uraawiika hayiskaab hiisiini, aree tak weer kasseeh eembꞌi gal tꞌiiteeb hiisiini. Gaalka ibhaliyeeh eekna dehaay ingadiyeet toonaati. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />Been bꞌeeb gaal isehaayiis, baruuh beet toona Wꞌankwanaay dehaay danꞌi. Toosha tamiiniib uutak, Ukwaasana yhammiidayt, toosha Wꞌankwanaay dehaay tamiini. Naati tamti han inriib uutak, Ukwaasana yhammiid aree beet toona Wꞌankwanaay dehaay danꞌi. <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />Hinin igarooyeen iknaayee dehaay kinkwiri, igarooyeen iknaayee dehaay iyaayi hoon kiihaay. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />Hinin nikweereek, Wꞌankwanaay dehaay nikweer. Niyaayeek aree Wꞌankwanaay dehaay niyaayi. Aflaay needhhaniyeek tari niyaayeek, Wꞌankwanaay nikati.<verse eid="ROM 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 14:9" />Oon usabbii, Umasiih iyaayt malya idhhan. Shaawti baruuh idhhaniibwa yꞌayaabwa kasseeh Ankwanaayoohna ikati. <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />Aflaay baruuk usanook naanhooy haakamtiniya? Tari usanook naanhooy abaabtiniya? Hinin kassaan Ukwaasanaay whukwimi kwirsi suurii ningid niyad. <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />Tuun batuuh uktaabiib kataabtu:</para>
  <para style="q1" vid="ROM 14:11">“Wꞌankwana ‘Ani umidhhaniisu halafooyaabu,</para>
  <para style="q1" vid="ROM 14:11">Uudehay kassaah anii suurii kuurami iyadna,</para>
  <para style="q2" vid="ROM 14:11">kassaah imiidalab aree Ukwaasanaay dehaay itfidhidh iyadna.’ indi.” diyaabi.<verse eid="ROM 14:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />Aflaay hinin kassaan gaalka Ukwaasanaay suurii ugarooyooh haasabi indi.<verse eid="ROM 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />Shaawti taktaki whaakamti nisingid. Usaniyook salal tingiifna tari maagtiib dhibsitniina baadꞌiya. <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />Wꞌankwana Yasuuꞌa winneet rhisiyaheeb. Mꞌariit tuukna nhas baakaayt bitehaayeet toona ani winneet aamanani. Laakiin tak gaal naat gaat nhast biihiisayeek, aflaay beet batuuh bariiyooh dehaay nhast kitti. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />Usanuuk baruuk tamtaneet toonaati sabbii lhamiiniyeek, aflaay reer ibtikeekna daayi kiidi. Tumꞌariitiisook usanook baakwidhsaa. Umasiih bariiyooh jillaay ayaabi. <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />Baruuk daayiinaayt hiistiniyeet toona amaagna hooy baahadiidsa. <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />Ukwaasanaayt tehadꞌaayi mꞌariiti tamtiiwwa gwꞌitiiwwa kiiki. Laakiin batuuh Aashuuk Imugaddasa iyawneet shibootwa, mꞌasigwa firhaatwa tikati. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />Oon usalalii Umasiih shagaamiiniibka, Ukwaasana afirhisiini aree uudehay barooh hamooyseen.<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />Shaawti hinin mꞌasigwa taktakeet sꞌakrooywa ikwasi shaga nidꞌeet toonaati. <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />Ukwaasanaay ishaga tumꞌariiti jillaay baakwidhsaana. Tumꞌari kastuuh nhastu, laakiin weer tak tisoogiif mꞌariiti tamti daayiib kiiki. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />Shaat bittamayeet tuuna tari haab bitgwꞌayeet tuuna hayiskaatu, tari weena usanook dhibsitniina baadꞌiya.<verse eid="ROM 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 14:22" />Shaawti teen tinaateeb aamantiniyeet toona barook uknaayookwa Ukwaasanaawwa ibtikeekna dibiya. Uutak daayiit hiisiiniyeet toonaatiib ugarooyooh gwabab baasꞌabiik been libaabiya. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />Laakiin uutak tamiiniyihoob eetehak danꞌiib gwababi kina ikati. Bariiyuuh itamti wꞌiimaanii kiiki. Wꞌiimaanii yꞌaat baakaayt tuuna aree kastuuh maagnaayt tikati.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />Hinin wꞌiimaaniib yꞌakraab, baliib wꞌiimaanuuhna nꞌakw ikatiyeeb dehaay asbirnayeet toonaati. Igarooyeen afirhisnayeet toona kitti laakiin bareeh afirhisnayeet toonaati. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />Kassaan gaalka ishawweetooh daayiinaaytiib neekwineet toonaati aree bareeh afirhistiniina dꞌiitiit neeshtiimeet toonaati. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />Umasiih ugarooyooh afirhisaab kiiki. Laakiin tuun batuuh uktaabiib kataabtu: “Baliin barook neeween oodehayi neew anii kehii dhibiya.” indi. <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />Tuuna suur kataabt kastuuh hini allamti jillaay kataabti. Aflaay tarmuumaaywa eektabi sꞌakrooytiiwwa sꞌayaab nimeer.<verse eid="ROM 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 15:5" />Ukwaasana itarmuumaawwa tisꞌakrooywa iniiw. Yasuuꞌaab Umasiih ramtiit, taktaki geeb mꞌasgiib tikweerni jillaay Ukwaasana eeshtamiyeetookna toonaatii dehaay siileelani. <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />Aflaay baraak gaal ginꞌiiwwa gaal yafiiwwa Ukwaasana hamidna, Wꞌankwanaayoon Yasuuꞌaab Umasiihi Baaba hamidna.<verse eid="ROM 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />Umasiihi agbiliya hookna, aflaay baraakna han ibakii taktak agbilaana. Malya oontꞌaaneet Ukwaasana tehamidna. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />Ani andi hookna: Umasiih, Ukwaasaay sidik rhisiyi jillaay Iyahuudi shagaamana iki. Ukwaasana Iyahuudi hooba waadiyaayaneeb iwaadiya idꞌiyeet toona bareeh rhisiya. <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />Aflaay Ijintiili Ukwaasana tirhamaatiyeeh sabbii yhamid ikatiin. Tuun batuuh uktaabiib kataabtu:</para>
  <para style="q1" vid="ROM 15:9">“Aflaay Ijintiili bitik ani ihimid hooka andi.</para>
  <para style="q2" vid="ROM 15:9">Bariiyook hamaadiit shiila iyaad andi.” diyaabi.<verse eid="ROM 15:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10" />Masi uuktaab,</para>
  <para style="q1" vid="ROM 15:10">“Yaa Ijintiili, Ukwaasanaay oodehayi geeb afirhaana!” diyaabi.<verse eid="ROM 15:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />Masi uuktaab,</para>
  <para style="q1" vid="ROM 15:11">“Yaa Ijintiili kassaakna, Wꞌankwana hamidna,</para>
  <para style="q2" vid="ROM 15:11">aree baraak idehaya kassaakna, bariiyooh hamaadiit shiila diina.” diyaabi.<verse eid="ROM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />Masi Isyaas,</para>
  <para style="q1" vid="ROM 15:12">“Yassii taasii gaal lawi indi,</para>
  <para style="q2" vid="ROM 15:12">baruuh yakiit idehayaayi kehii yhikim indi.</para>
  <para style="q1" vid="ROM 15:12">Ijintiili barooh sꞌayaami iyadna.” diyaabi.<verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />Isꞌayaay Ukwaasana baraak aamanteeni been firhaatwa mꞌasigwa baꞌiyaaw hookna. Aree Eeshuuk Imugaddasaayi akrir sꞌayaab baꞌiitibna hookna.<verse eid="ROM 15:13" /></para>
  <para style="s">Baawloos Ijintiilee dehaay diigwatamiya</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />Isanaayaan, baraak abiiyaakna gwidaat daayiinaaytwa, timmiimaat kanaantwa, taktaki isootiiwwa adgirteeneet toona ani uknaayu akteen. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />Shalikt nikwtaateeb winneet gwꞌagwuuyt dehookna aktib, Ukwaasana hiiyyaayu ikatiyeet tinꞌimaati sabbii, aree bateeh masi shꞌastiyookna aharriiw. <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />Ani Ijintiilee dehaay shagaamiiniib, Yasuuꞌaab Umasiihi shagaamana akatiyi sabbii, ufagiiriit waajibt Ukwaasanaay Usakana Udaayiib bhaliiyani. Aflaay Ijintiili Ukwaasana agbiliiniyeet karaama ikatiin. Aashuuk Imugaddasa bareeh sinhastiit Ukwaasana agbiliiniyeeb ikwasiin.<verse eid="ROM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 15:17" />Ani Yasuuꞌaab Umasiihiib akatiyi sabbii, Ukwaasana daayiib shagaamaniyeet toona adgirani. Aflaay ushagaayiisu winneet habnamani. <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />Yasuuꞌa Umasiihi aneeb isidꞌiyeeb ushaga oobhaanaay hadiidi andi. Umasiihi anii geebii idꞌiyeeb ushagaay, Ijintiili Ukwaasana isnaakirna. Baruuh toon toona bhaliiyeewwa ushagaaywa ikwaas. <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />Baruuh toon toona alaamaati akrireewwa mꞌuujisaateewwa ikwaas, aree Eeshuuk Imugaddasaayee ikwaas. Aflaay Algudusee Illiirikuum ookiik kassooh usalaliib, ani Umasiihi Usakana Udaayiib winneet bhaliiyan. <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />Umasiih hooy biiꞌatookkaani hasheeb Usakana Udaayiinaay isooti ani diimaab ahariw. Aflaay ani weer tak dꞌiyaab ikatiyi asaasi kehii baadꞌiireet toona ahariw. <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />Uuktaab bak indi:</para>
  <para style="q1" vid="ROM 15:21">“Bariiyooh usakana soomamaab baakay baliin barooh rhi iyadna,</para>
  <para style="q2" vid="ROM 15:21">aree baliin barooh maaswaab baakay afhami iyadna.” indi.<verse eid="ROM 15:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="ROM 15:22" />Oon usabbii aree ani diimaab bareekna beeti wꞌaayiit fursa miraab kaaki.<verse eid="ROM 15:22" /></para>
  <para style="s">Baawloos Roomaab Beeti Giig Niyaamiya</para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 15:23" />Laakiin oontꞌa ani een yhasheeb ushagaayu faaysan. Gwida hawlaayeeka aree yꞌeetiit rheesamtiyookna winneet ahariw. <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />Ani Isbaanyaab beeti iibaabt niyaamaniyihoob, toon toona shagaamtiib amankiir. Aflaay ani hasamee rheesamtiyookna aharriiw. Beentooy tꞌiibaabtiib shamaamt hookna aharriiw, aree tꞌaraweetookna winneet hooy afirhan. <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />Oontꞌa laakiin Algudus iibi andi, aree beentooy Ukwaasanaay dehay shagaami andi. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />Magadoonyaawwa Akhaaꞌiyaayt tikaniisaawwa Ukwaasanaay dehayi bitik Alguduseeb eefeen imiskiinaayee dehaay naat ifarꞌaneet toonaatiib winneet afirhaaba. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />Baraah toon toona idꞌanee dehaay winneet afirhaaba, aree sidik bareeh eeshtamiineet tuuna waajibtoohna tikati. Iyahuudi ishuukeet barakaateehna Ijintiili geeb yꞌadhidhnayt, Ijintiili han Iyahuudi igarooyeehna dehaay ishtanhaneet teena yꞌadhidhneet tuuna waajibtoohna tikati. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />Aflaay ani oon ushaga faaysiit, bareeyooh dehaay farꞌamaab imhallaga sallamaniyi harꞌii, Isbaanyaab beeti iibaabiit usalaliib rheesami hookna andi. <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />Ani bareekna beeti yꞌaniyihoob, Umasiihiit baraka gwidaat haay yꞌaniyeet toona akteen.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />Isanaayaan, Wꞌankwanaayoon Yasuuꞌaab Umasiihiiwwa Eeshuuki reeriiwwa winneet hookna aharriiw. Aflaay anaahookna anii geeb siileelaana aree anii jillaay Ukwaasanaay dehaay siileelaana. <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />Ani Yahuudaay eefeen oodehay yꞌaamanaab baakaynee ansiigi jillaay siileelaana. Ukwaasanaay dehay beentooy Alguduseeb eefeen aree aniib ushaga agbileeni jillaay siileelaana, <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />aflaay Ukwaasana indiyeek, ani afirhaa yꞌani hookna, aree hiddaab bareeyookna geeb afirhaa fiini andi. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />Umꞌasig iniiw Ukwaasana, kasseekna geebookna badaayi. Aamiin.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s">Shoobtiib</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />Kanakhiryaay tukaniisaatiit shagaamana tukwaatoon Fuuba daayiit takat tikatiyeet toona waseeyani hookna. <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />Batooh Ukwaasanaay udehayiit, Wꞌankwanaay oosmii ashishna. Batuuh hookna harriiweet tushamaam shamna. Batuuh suur aneebwa waribwa han tisham hoon.<verse eid="ROM 16:2" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="3" style="v" sid="ROM 16:3" />Biriskillaawwa Akiilaawwa tooshbu salaamaana. Bataah anii geeb Yasuuꞌaab Umasiih shagaameen. <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />Bataah anii jillaay umidhhanoohna bidhꞌishiyaan. Aneeb oobhaat kaaki laakiin kastaah Ijintiileet kaniisi bateeh winneet yhamidna.<verse eid="ROM 16:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="ROM 16:5" />Bateeyooh ugawiib teefeet tukaniisi han tooshbu salaamaana.</para>
  <para style="li1" vid="ROM 16:5">Whamadhꞌaayu Abaynituus been Aasiyaay whaashiib Umasiihii awwal aamaniyaab tooshbu salaamaana.<verse eid="ROM 16:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="ROM 16:6" />Beet winneet dehookna shagaamtaat Maryam tooshbu salaamaana.<verse eid="ROM 16:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="ROM 16:7" />Andarooniikuswa Juunyaaswa aniib yꞌayayda usijniib geebu iifiin, tooshbu salaamaana. Baraah ilinguumanaayi geeb ingadiina, aree baraah anii hankaay Umasiihiib iifiin.<verse eid="ROM 16:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="ROM 16:8" />Ambiliyaatuus ani Wꞌankwanaay oosmii areeyaneeb beeb tooshbu salaamaana.<verse eid="ROM 16:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="ROM 16:9" />Uurbaanuus Umasiihi geeboon shagaamiiniib, tooshbu salaamaana. Whamadhꞌaayu Istaakhiis han tooshbu salaamaana.<verse eid="ROM 16:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="ROM 16:10" />Abeellas Umasiihiib jarrabamiyaayt aamanamiyaab beeb tooshbu salaamaana.</para>
  <para style="li1" vid="ROM 16:10">Baliib Ariistoobloosi dhiwa ikatiin tooshbu salaamaana.<verse eid="ROM 16:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="ROM 16:11" />Heeroodiyoon wꞌayaaytaku tooshbu salaamaana. Naarsiisoosi dhiwa ikatiin baliib Wꞌankwanaay eefeen tooshbu salaamaana.<verse eid="ROM 16:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="ROM 16:12" />Tiriifeenaawwa Tiraayfoosaawwa tooshbu salaamaana. Baliit taamꞌa Wꞌankwana akraab shagaamiyaan.</para>
  <para style="li1" vid="ROM 16:12">Tꞌaraawtoon Barsiis tooshbu salaamaana. Tuun batuuh han Wꞌankwana akraab shagaamta, tooshbu salaamaana.<verse eid="ROM 16:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="ROM 16:13" />Ruufuus Wꞌankwanaay ishagaay dehaay waasamaab, tooshbu salaamaana. Bariitooh toondi aneeb han deetu akay tiifiit beet tooshbu salaamaana.<verse eid="ROM 16:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="ROM 16:14" />Asiinkiriitooswa, Fileegoonwa, Harmaaswa, Baatroobaaswa, Harmeeswa isana bareeyooh geeb eefeenwa, tooshbu salaamaana.<verse eid="ROM 16:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="ROM 16:15" />Filoolgooswa, Juuliyaawwa, Neeruuswa tukwaatoohwa, Oolimbaaswa kasseeh Ukwaasanaay oodehay bareeyooh geeb eefeenwa, tooshbu salaamaana.<verse eid="ROM 16:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="ROM 16:16" />Mugaddast salaam taktak salaamaana.</para>
  <para style="li1" vid="ROM 16:16">Umasiihiit kaniisi kastaah tooshbu salaameen hookna.<verse eid="ROM 16:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />Isanaayaan, baliib ibtikeekna adhidh shagaameen, usalaliyookna goofiyaat ikatiin gwꞌadna. Baraah utꞌaliim wꞌallamamaab tikatiineeb imnafi shaga daayeen. Een bareeh hooy sigiina andi hookna. <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />Bak tꞌiiteeb uudehay Wꞌankwanaayoon Yasuuꞌaab Umasiihi kashagaamiyaan. Laakiin tꞌeeteehna teekna shagaameen. Nafit kalmaateewwa sꞌaaryootiiwwa oodehay eenhas eetilna. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />Baraakna Ukwaasana tisnaakiirneet toona kassaah uudehay imaasiwna. Aflaay ani winneet hookna afirhaabi. Laakiin tudaayiinaaytiib daayiib fagaramteeneet toona hookna aharriiw. Teena tꞌamag aree hooy tiseegneet toona hookna aharriiw.<verse eid="ROM 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 16:20" />Umꞌasig iniiw Ukwaasana, oobliis iragadaayeekna whii willa katꞌi indi.</para>
  <para style="p" vid="ROM 16:20">Wꞌankwanaayoon Yasuuꞌiit tinꞌima geebookna badaayiin.<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />Tiimooti, geebu shagaamiiniib, tooshbu salaamiini hookna. Luukiyuuswa, Yaasoonwa, Soosibaatarwa aniib yꞌayayda han tooshbu salaameen hookna.<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />Ani Tartiyoos oon ujawaab dehookna akantiib, Wꞌankwanaay oosmii tooshbu salaamani hookna.<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />Gaayoos, aneebwa tukaniisi kastoohwa yhadar hoon. Baruuh tooshbu salaamiini hookna.</para>
  <para style="p" vid="ROM 16:23">Tumadiinaati dehayi shagaay mudiir ikatiib Araastuuswa, usanuun Kuwaartuuswa tooshbu salaameen hookna. <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />Wꞌankwanaayoon Yasuuꞌaab Umasiihiit tinꞌima kasseekna geebookna badaayiin. Aamiin.<verse eid="ROM 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />Aflaay Ukwaasana winuuyt, barooh nhamid. Ani bhaliiyaniyeeb Yasuuꞌaab Umasiihiib Usakana Udaayiinaayt hayꞌaatiib, baruuh wꞌiimaanookna isꞌakiir, aree suur shꞌiika kwabaast toona oontꞌa lawsiini. <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />Laakiin oontꞌa Ukwaasana Udaayim sooyaneeb inabiyaayi kitab lawisiyaan. Aflaay kassaah idehaya aamaniit barooh isnaakiirna.<verse eid="ROM 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27" />Ukwaasana ufagar oongaalnaay dehaay, umatuun diimaab Yasuuꞌaab Umasiihi geebii baꞌiikti! Aamiin.<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>