<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id" />
  <para style="rem">Final Version</para>
  <para style="h">Ibraayiib</para>
  <para style="toc1">Yꞌibri eebiib ujawaab</para>
  <para style="toc2">Ibraayiib</para>
  <para style="mt1">Yꞌibri eebiib ujawaab</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">Imalakeeka tageegakaab Wꞌoor</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Shꞌiiya door Ukwaasana hoobeen inabiyaayi geebii gwida doora gwida salalaayee bhaliisamiya. <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />Laakiin teen tiyinaateeb baruuh hinin Wꞌooriisooh bhaliisamiini hoon. Aree barooh naatka sꞌabkaabu, aree bariiyooh geebii tuduniya idꞌi. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Wꞌoor Ukwaasanaay umatuun rhisiini, aree baruuh Ukwaasana ookna tꞌiiteebi. Kastaah taana barooh ooknaay ibhaliyi akriree diimaab daayeen. Baruuh toomaag atehariyaayt harꞌii, Wꞌalyaanaay umaygwadii dehaay tibreeteeb nꞌati isꞌa. <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />Aflaay baruuh imalakeeka winneet tageegakaab iki. Uusim baruuh kwasaamaab ikatiyi han imalaki simaayeeka tageegaakaabi.<verse eid="HEB 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />Ukwaasana imalakeeyooh dehaay gaal han,</para>
  <para style="q1" vid="HEB 1:5">“Baruuk ooru tikatiya,</para>
  <para style="q2" vid="HEB 1:5">amsi ani baabook akati.” diyaab kiiki.</para>
  <para style="m" vid="HEB 1:5">Tari masi</para>
  <para style="q1" vid="HEB 1:5">“Ani barooh baabooh iikti andi,</para>
  <para style="q2" vid="HEB 1:5">aree baruuh han ooru iikti indi.” diyaab kiiki.<verse eid="HEB 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />Masi aree, Ukwaasana wꞌoorooh usuurkina tuduniyaatiib haay eeyanihoob, baruuh,</para>
  <para style="q1" vid="HEB 1:6">“Ukwaasanaay imalak kassaah ibakii barooh yꞌabidna.” idi.<verse eid="HEB 1:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7" />Baruuh imalakeeb hadiidiiniyihoob, baruuh,</para>
  <para style="q1" vid="HEB 1:7">“Ukwaasana imalakeeh baraam ikwasi,</para>
  <para style="q2" vid="HEB 1:7">ikishiyaayeeh nꞌeeti balool ikwasi.” idi.<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Laakiin baruuh Wꞌooriib hadiidiiniyihoob, baruuh,</para>
  <para style="q1" vid="HEB 1:8">“Tehadꞌaayeetuuk, yaa Ukwaasanaay, daayimtwa kassoohoobwa iikti tindi,</para>
  <para style="q2" vid="HEB 1:8">aree udehayook kehii wꞌadlii hikim tindiya.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />Baruuk tooshbu areeta aree toomaag tiriba,</para>
  <para style="q2" vid="HEB 1:9">shaawti Ukwaasana, Ukwaasanaayuuk yꞌaraweeyook mhakwal idꞌi hook,</para>
  <para style="q2" vid="HEB 1:9">tifirhaati saliitii ishaamit hook.” idi.<verse eid="HEB 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />Baruuh masi,</para>
  <para style="q1" vid="HEB 1:10">“Yaa Wꞌankwanaay, ibadootiib, baruuk tubuuti asaas tidꞌiya,</para>
  <para style="q2" vid="HEB 1:10">aree taabri bariiyeek yꞌayi shagaay daamiyaan.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Bataah kwidhi iyadna, baruuk daayi tindiya,</para>
  <para style="q2" vid="HEB 1:11">bataah kastaah yhalakaayeet iishꞌi iyadna.<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />Baruuk bateeh whalakiit iiksis tindiya,</para>
  <para style="q2" vid="HEB 1:12">bataah whalakiit gayyarami iyadna.</para>
  <para style="q1" vid="HEB 1:12">Laakiin baruuk diimaab uknaayook tꞌiiteeb tikatiya,</para>
  <para style="q2" vid="HEB 1:12">aree yhawlaayaak iinhad kiidiin.” idi.<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Ukwaasana imalakeeh gaalnaay dehaay han,</para>
  <para style="q2" vid="HEB 1:13">“Yꞌashooyeek iragadaayeek whii</para>
  <para style="q1" vid="HEB 1:13">eetamtiniit madhamt akwasiyeeb ookiik,</para>
  <para style="q2" vid="HEB 1:13">baruuk aniib umaygwadii dehaay sꞌaa.” diyaab kiiki.<verse eid="HEB 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />Imalak kassaah shuuk Ukwaasana shagaameena, baraah baliib umidhhan kwasaameen eeshtiimni jillaay Ukwaasana diigwataab kiiki han?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">Umidhhan oowin</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Hinin toona tumaasiwaab nikatiyeet ibakii daayiib neegwꞌadiyeet toonaati. Aflaay fidnaab nitrifif kindi. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Imalak bhaliiyaaneet tudiigwat sidik tikatiyeek, shaawti batooh uuraab tari tisnaakrooyti naaw jasaab ikwasiin. <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />Oon umidhhan oowin neebdhiineek, kak fooriit nitfarꞌi? Uun umidhhan hankaab Wꞌankwanaay soomamiya, aree barooh imaasiw baliinee dehoon akkadamiya. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Ukwaasana ajaayibtwa gwidaat mꞌuujisaatwa ikwaasiit, Eeshuuk Imugaddasa han baruuh yharriiweet tunaatiit gagiigsiini. Aree toon toona alaamaatee badehaat ikwaas.<verse eid="HEB 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Ukwaasana tuduniya harꞌook eetniit oontꞌa hooy bhaliinayeeti kehii imalak hadꞌaab kwaasaab kiiki. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Laakiin mhiin eefi gaal badehaat hooy kwaasaab ikatiyeeb:</para>
  <para style="q1" vid="HEB 2:6">“Uutak baruuk hooy tinkwiineeb aabu?</para>
  <para style="q2" vid="HEB 2:6">Wꞌaadami oor naanhooy bak timshabiiba?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Baruuk barooh shalik door imalakeeka diskaab tikwaasa,</para>
  <para style="q2" vid="HEB 2:7">barooh matuunwa hamooysami taajwa kehii tidꞌiya,<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />aree naatka bariiyeeh iragadaayi whii tidꞌiya.” idi.</para>
  <para style="m" vid="HEB 2:8">Naatka bariiyeeh iragadaayi whii idꞌiyihoob, Ukwaasana oon bariiyooh whii dꞌiyaab biikaayeena ishaab kiiki. Laakiin oon amsi kasteeh teena bariiyooh whii haayee karhina. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />Laakiin hinin Yasuuꞌaab rhinay, baruuh imalakeeka shalik door diskaab akay daamiya, oontꞌa baruuh matuunwa hamooysami taajwa kehii daasamiya. Baruuh gwirhaayeet yat itoodaar akay, aflaay baruuh Ukwaasanaayt tinꞌimaatee kasseeh oodehayi jillaay tooyat dꞌamsiiniib ikati.<verse eid="HEB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10" />Naatka Ukwaasanaayt tikati, aree kastaah taana bariiyeeh yꞌakriree daamaata. Aflaay Ukwaasana, Yasuuꞌaab ikwaasiit igwirhaayee timmiimaab ikwaasihoob, daayiinaayt idꞌi. Yasuuꞌa Ukwaasanaay ar gwidaab matuun beeti haay yꞌeetiit ishidhhiin, aree bareeh umatuunooh imꞌadhiidh. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />Baruuh oodehay tumaagtii isinhiis, baruuhwa baliin yꞌinhaswa kassaah gaal Baaba ibariin. Aflaay Yasuuꞌa bareeh isanaayi indiyeek han sikwꞌaab kiiki. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />Baruuh Ukwaasanaay dehaay,</para>
  <para style="q1" vid="HEB 2:12">“Oosmook isanaayi sooyi andi,</para>
  <para style="q2" vid="HEB 2:12">oodehay igwidaanaayi bitik whamaadook kafi andi.” idi.<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Aree baruuh masi,</para>
  <para style="q1" vid="HEB 2:13">“Ani barook aamani andi.” idi.</para>
  <para style="m" vid="HEB 2:13">Aree baruuh masi,</para>
  <para style="q1" vid="HEB 2:13">“Ani Ukwaasana hiiyyaayu ikatiyeeb yꞌari geeb tooy eefi.” idi.<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Yꞌar basharwa booywa ibariini sabbii, baruuh han bareeh tꞌiiteeb aadamiib iki. Shaawti tuyatii aree baruuh tooyati akrir ibariib barooh katꞌi indi. Been tuyati akrir ibari aree oobliis ikati. <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />Baliib tooyati mirkwaayii kassooh umidhhanoohna kishiyaamiyaan, baruuh kasseeh isfadiig. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Sidik baruuh eeshtiimeeb imalak kiikeena, laakiin Ibraahiimiib ootaas ikatiin. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Oon usabbii baruuh kasteeh tehayꞌaatee isanaayeeh tꞌiiteeb ikati. Bareeyooh dehaay rhamaat ibariib ikatiyi jillaaywa, sidki win fagiiri Ukwaasana shagaamiiniib ikatiyi jillaaywa daamiya. Aflaay udehayiit timaagnay afoomeent ikatiin. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Baruuh uukna jarrabamiyanihoob lhamiya akay, oontꞌa baruuh baliib ijarrabameen eeshtiimeet toona adgiriini.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">Yasuuꞌa Muusaayka winkaabu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Shaawti Isanaayaan imugaddasa, Ukwaasana waliikaab ikatiyeeb, Yasuuꞌiib kwinna. Baruuh oon hinin nitfadhiidheeb wꞌiimaaniib, win fagiiriiwwa linguumaawwa ikati. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />Muusa kassooh Ukwaasanaay ugawiib amiin iiktiyeet toonaatiit, baruuh oon ushagaay dꞌuuyii dehaay waasiyaab oongaalnaay amiin iikti. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Ugawi dꞌaariiga oogaw ooknaayka winkaat takwi ibariyeet toonaatiit, Yasuuꞌa Muusaayka winneet hamooysamakaab akay imri. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Gawka gaalnaay dꞌaar ikati, laakiin Ukwaasana kasteeh tinaati dꞌaariiga ikati. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Muusa kassooh Ukwaasanaay ugawiib amiin shagaamana iikti. Harꞌook iikti tindiit toonaatiib badehaat tiikti <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Laakiin Umasiih aree Ukwaasanaay ugawiib wꞌooriit amiin ikati. Toona tisꞌayaamnayeeti jillaay akra ginꞌiiwwa ashꞌareetiitwa ningadiyeek, hinin bariiyooh oogaw nikati.<verse eid="HEB 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Aflaay Aashuuk Imugaddasa iyadneet toonaatiit:</para>
  <para style="q1" vid="HEB 3:7">“Amsi, Ukwaasanaay whiss teemsiiwneek,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />iginꞌaayeekna baasꞌakiirna</para>
  <para style="q1" vid="HEB 3:8">wꞌamgwashuushaay saktaaneet toonaatiit,</para>
  <para style="q2" vid="HEB 3:8">umingaayiib ijarrabamti door tidꞌiineet toona,<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />beentooy hoobaakna jarrabiyaanheeb aree idigwnaheeb</para>
  <para style="q2" vid="HEB 3:9">aree fadhig tamuun hawlaayeeb ani adꞌiyeet toona rhiyaan.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />Oon usabbii been ootaasi geeb ani hasaayu,</para>
  <para style="q2" vid="HEB 3:10">aree malya ani ‘Bareeh diimaab iginꞌaayaahna diimaab kwidheena,</para>
  <para style="q2" vid="HEB 3:10">aree aniib isalala kanaab kiikeen.’ adi.<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Aflaay ani tehasiyaaytii halafooyan,</para>
  <para style="q2" vid="HEB 3:11">‘Baraah aniit tifiinanii shuumi kiidiin.’ adi.” idiin Aashuuk Imugaddasa.<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Isanaayaan, gaal han hookna maagnaayt biidꞌiyeet toona gwꞌadna, Ukwaasana udhhaniinaay fidinti yakeen aamanaab baakay ginꞌa hookna biidaayayni jillaay gwꞌadna. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Laakiin bꞌeebka taktak sꞌakirna, oon amsi tittiyoodiit kalma teefiyeeb ookiik taktak sꞌakirna, aflaay gaal han hookna akraat maagnaaytiib ituutil kiidi. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Hinin whankaay niibriyeeb wꞌakra ginꞌi wꞌagiya ookiik nꞌabkeek, hinin kassaan Umasiihiib shaarakaab nikati. <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />Uuktaab bak indi:</para>
  <para style="q1" vid="HEB 3:15">“Amsi, bariiyooh whiss teemsiiwneek,</para>
  <para style="q2" vid="HEB 3:15">wꞌamgwashuushaay saktaaneet toonaatiit,</para>
  <para style="q1" vid="HEB 3:15">iginꞌaayeekna baasꞌakiirna.” indi.<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Baliin Ukwaasanaay whiss imaasiwniit imgwashaash aayga iiktiina? Baliin baraah kassaah Muusa Masree haay ifirꞌat imilheeb kiikeena han? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Aree baruuh fadhig tamuun hawla aab imhasaay? Baliin danuub idꞌiiniit igarooyaahna umingaayiib dhadhibyaaneeb kiikeena han? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Aree Ukwaasana tifiinaniiteeh door han biishamayneeb idiit dehaay halafooyaneeb, baliib tisnaakirooy irib nuun aayga ikatiin? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Baraah aamanaab kiikeenayt, aflaay tifiinaniiti whaashiib ishuumti adgiraab biikaayneet toona rhina.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Shaawti, bariiteeh tifiinaniiti shuumti waadiya masi eefiyeek, aflaay nitdagwiigweet toonaatu, beet toona gaal han hookna biihagiil. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Usakana Udaayi han dehoon bhaliimiya, baraah han imaasiwna. Laakiin baraah imaasiwneet tudiigwat takweet hiiyyaab kiikeen. Imaasiwnihoob, batooh wꞌiimaani geeb agbilaab kiikeen. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Aflaay hinin yꞌaamanaab baliit tifiinanii Ukwaasana waadiyaayaab ikatiyeet shuumnay. Ukwaasana bak diyaabu,</para>
  <para style="q1" vid="HEB 4:3">“Aflaay ani hasaayuuytii halafooyan,</para>
  <para style="q2" vid="HEB 4:3">‘Baraah aniit tifiinanii door han shuumi kiidiin.’ adi.” diyaabi.</para>
  <para style="m" vid="HEB 4:3">Aree tuduniya daamtaneekka ushagaayuuh faayamiya. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Baruuh mhiin gaal tooyin tꞌasaramaatiib een ibhali hadiidiya: “Aree tooyin tꞌasaramaatiib Ukwaasana kassooh ushagaayiisooh fiiniya.” idi. <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />Aree baruuh masi toon toona hadiidiya, “Baraah aniit tifiinanii shuumi kiidiin.” idi.<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />Gali baliit tifiinanii shuumi iyadneet tuuna masi daatni. Baliin hankaab Usakana Udaayiib imaasiw sinaakraab kiikeenayt, tifiinanii shuumaab kiikeen. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Shaawti Ukwaasana masi weet yint idꞌiit “Amsi” iisim. Malya gwida doori harꞌii Daawidi miidalaabii bhaliiya, suur attiyoodiyaat toonaatiit:</para>
  <para style="q1" vid="HEB 4:7">“Amsi, bariiyooh whiss teemsiiwneek, iginꞌaayeekna baasꞌakiirna.” idi.<verse eid="HEB 4:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 4:8" />Jooshiwa bareeh fiinaniit hiiyyaab iiktiyeek, Ukwaasana masi weet yintiib kahadiidiya. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Malya beentooy Ukwaasanaay udehayiit fiinaniiteet yint Toosab tikati. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Ukwaasanaayt tifiinaniiti shuumiiniibka, baruuh ushagaayooh ooknaay han fiiniini. Ukwaasana han ushagaayiisooh bak fiiniya. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Shaawti baliit tifiinaniiti shuumtii dehaay shagaamanayeet toonaati. Aflaay baliib tisinaakrooy iribniit dhibiyaan tꞌiiteena gaal han hoon dhibi kiidi.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Ukwaasanaay ibhali dhhaniiba aree diimaab eefeena, baraah malu ginnali bꞌadhdhiika hasikaaba. Baraah eenfiswa eeshuukwa han yꞌadhidhna, eebꞌiiwwa tumiigꞌoolwa yꞌadhidhna, iginꞌiit kwoonaniiwwa tiniyaawwa han yꞌadhidhna. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Ukwaasanaay igwꞌadee dhꞌimaana naat han kitehaay. Bariiyeeh igwꞌadi suurii naatka rhamtini aree lawtini, aree hinin barooh oosdik soonayeet toonaati.<verse eid="HEB 4:13" /></para>
  <para style="s1">Yasuuꞌa ifagiiriyaayi hadꞌa oowin</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Shaawti tageega win fagiiri tibreeteeb sakaab nibari, Yasuuꞌaab Ukwaasanaay Wꞌoor, hinin nitfadhiidheeb wꞌiimaan daayiib nꞌabikeet toonaati. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Win fagiiri hineeb inꞌakwiyeeb nꞌakwmanaatiib dehoon baabariib kinbari. Laakiin hinin gaal nibari kasseeh isalalaayee jarrabamiyaab, hinin han bak jarrabamna, laakiin baruuh maagnaayt gwibbaab kiiki. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Tinꞌimaateet hadꞌaayi akra ginꞌii nidawleet toonaati. Aflaay rhamaat nimeer nikati aree tishanhayti door nꞌimaat nimeer nikati.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Win fagiiriika oodehayi bitikii waasamiini, aree baruuh Ukwaasanaay ikatiin tehalaagay tankwiikwi jillaay waasamiini, baruuh miyaaw iniiw aree idanuubi jillaay karramamiini. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />Baruuh uukna han nꞌakwuuyt, baruuh oodehay yꞌagimwa ikwidheenwa baliinee dehaay nꞌakwmanaayiiniyeet toona adgiriini. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Oon usabbii aree baruuh ooknaay danuubi jillaay karramamiini, oodehay irawi danuubi jillaay han karramamiini.<verse eid="HEB 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 5:4" />Oon whamooysiti gaal han uukna kiimri. Haaruun iifiyeet toonaatiit, baruuh ibakii Ukwaasanaay waliikamaab ikati. <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />Aflaay Umasiih han win fagiiri haay iiktiyeeb umatuun baruuh uukna miraab kiiki. Laakiin Ukwaasana bariiyooh dehaay,</para>
  <para style="q1" vid="HEB 5:5">“Baruuk anii Oorwa,</para>
  <para style="q2" vid="HEB 5:5">amsi ani Baabook akati.” idi.<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />Aree mhiin weernaay baruuh,</para>
  <para style="q1" vid="HEB 5:6">“Baruuk daayim fagiiri tikatiya,</para>
  <para style="q2" vid="HEB 5:6">Malkisaadikiit takwi tꞌiiteena iikti tindiya.” idi.<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Yasuuꞌiib eembꞌi tubuuti kehii iifiyi door, baruuh Ukwaasana ubarooh tooyatii ishidhhiinaay dehaay siileeliya aree tageega hissii waawiya aree milootiya, aree baruuh Ukwaasanaay raakwanaabuuyt, Ukwaasana barooh imaasiw. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Baruuh oor iiktiyeek han, baruuh tilhanay tilhamaab iiktiyeenaatee tisnaakrooy allamamiya, <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />aree gaalhoob timmiimiyanihoob, kasseeh ibarooh isnaakiirnee dehaay baruuh umidhhan udaayimi gwꞌad dehaay iki <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />aree Ukwaasana barooh win fagiiri Malkisaadikiit takwi iiktim ikwaas.<verse eid="HEB 5:10" /></para>
  <para style="s">Wꞌiimaanii fidnaab oogiig hooy digwagwna</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Toon tunaatiib gwidaana niyadeet teefi, laakiin baraak willa kaꞌafhamtaanayt, toon batooh ifassartiyuuh akraabi. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Oon oodoor baraak koojaab tiiktiineet toonaatu, laakiin Ukwaasanaay ibhaliyi sidik lalaamsiiniib gaal tehariwna. Baraak aat shanha tikatiina, akraat mꞌari kitti. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Aatee kwarriibka, masi nisrik ikati, tushbooti allamtiib naat han kiikan. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Laakiin timꞌari tꞌakraat oodehay iwawinnaayeet tikati, baraah tudaayiinaaywa toomaagwa taktakee wawaaseeni jillaay igarooyeehna isookiinna.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Aflaay oon utꞌaliim ilaamaab Umasiihiib ikatiib ishti dꞌiinaat, hayiska tꞌaliimiib yakaana. Suur allamamnaneeb ituubti asaas ishaga tooyat istoobiinaaywa Ukwaasanaay wꞌiimaaniibwa masi hadiidnayeet toona kitti. <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />Aree tꞌatoomsooyti sootiiwwa, yꞌayi dadaastiiwwa, yꞌayaani yaktiibwa, whukwim udaayimiibwa hadiidnayeet toona kitti. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Aree Ukwaasana wꞌidin iniiweek, hinin bak sakni niyad.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Baliin wꞌiimaanoohna yꞌishni idꞌiin malya kak masi agarti haay yꞌeena? Baraah tibreeti miyaaw dꞌamisiyaaniit, Eeshuuk Imugaddasa yꞌadhadhna, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />baraah Ukwaasanaay ibhaliyeet daayiinaayt dꞌamisiyaana, aree harꞌook yꞌiiniib udamaani akrireet daayiinaayt dꞌamisiyaan. <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />Baraah wꞌiimaanoohna yꞌishni idꞌiina, bareeh masi ituubsiti adgiramtiniina kitti. Baraah masi Ukwaasanaay Wꞌoor sallabiyaaniit barooh oodehayi suurii sikwꞌiib daaseen. <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />Whaash aabreet bariiyooh kehii iyaamiib oobrii yamee gwꞌiiniib, aree baliib whaashiib yꞌeed yꞌaadana harroob rayiisiiniib Ukwaasanaayt tibaraka iniin. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Laakiin whaash naweetwa adaarwa yaksiiniib takweet kiibari, aree atooꞌitaab ikatiyeena itrakwkwi. Wꞌagiyaay baruuh ituuliw indi.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Yꞌarawaan, hinin bak hadiidnayeek han, bareeyookna whaaliib akiidaat nibari, daayiinayt sakteena aree baliit taana umidhhan imooriimna. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Ukwaasana daalim kiiki, baruuh ushagaayookna iibdhan kiidi, baraak barooh areetaaneeb ooreer han iibdhan kiidi. Baraak bariiyooh oodehay tishamna, aree bareetooh tushamaam tisoorariimna. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Isꞌayaayookna sidik tikwasiini jillaay, kassaakna oon ushaga ookna wꞌagiya ookiik tisoorariimneet toona hookna nhariw. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />Hasra dehay tikatiineet toona hookna kinhariw. Laakiin baliib wꞌiimaaniiwwa utarmuumaaywa toona tuwaadiyaamaat kwasaameen tꞌiiteeb tikatiineet toonaati.<verse eid="HEB 6:12" /></para>
  <para style="s1">Ukwaasana Uwaadiya Usidkiib</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Ukwaasana Ibraahiimii dehaay waadiyaab idꞌiyihoob, baruuh toona waadiyaayaab ikatiyeet tankwiikweet toona halafooya. Barooh ooknaayka aree winkaab gaal han biihaayeet toonaati sabbii, baruuh halafooyanihoob oosmiisooh halafooya. <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />Baruuh “Ani sidik barook baaraki hook andi, aree gwida firaay iyaaw hook andi.” idi. <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Aree Ibraahiim utarmuumaay yhagit harꞌii, malya toona dehaay waadiyaamaat imri.<verse eid="HEB 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16" />Uudehay bareeh iknaayeeka winkaanaay halafooyeena, aree tehalafooy toona tꞌattiyoodiyaat akkadtini, aree kassooh wꞌamgwasuura tisingiid. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Ukwaasana baliib toona tuwaadiyaamaat kwasaameen, baruuh whadafooh biibadiileet toona winneet akkadtiib yhariw. Baruuh beet batooh halafooytii akkadiya. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />Ukwaasana toon toona haay idꞌiyeeb usabab, maloot na baabidaalaat Ukwaasana hooy biigwaasiireet eefeen. Aree bataah uwaadiyaawwa tehalafooywa ikatiin. Hinin bariiyooh geeb umꞌasig nimeer, toon toona aree isꞌaya wꞌattiyeewiyaab nikatiyeeb daayiib nꞌabikihoob nimeer. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />Oon isꞌaya aree eenfis tisꞌakiirna akay nibari, baruuh akraabwa amiinwa ikati. Baruuh oomhiin umugaddasiit tehooywa tusitaaraati gidehiiwwa shuumiini. <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />Yasuuꞌa been hini hankaay giigiyaab, hini badal shuumiya. Baruuh daayim win fagiiri iki, Malkisaadikiit takwi iktim.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">Ufagiiri Malkisaadik</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Uun Malkisaadik Saalimi hadꞌaawwa Ukwaasana Utageegaanaay fagiiri iikti. Baruuh Ibraahiim yhadꞌaayeet migreebtii agaree imriit barooh idehar. <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />Ibraahiim aree kassooh oomraayiisooh tutamnaat takwi barooh yhii. Uusmuuh “Tushbooti hadꞌa” miyaadu, malya masi, “Saalimi hadꞌa” umꞌasgi hadꞌa miyaadi. <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Baabaawwa deetwa anu, ayaayt anu, imbꞌeeyi badooti tari umidhhani agiya anu, Ukwaasanaay Wꞌoor tꞌiiti daayim fagiiri ikati.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Baruuh kak win iiktiyeeb shibiba: hoobuun wꞌatookkina Ibraahiim han toona tusaalbaab iiktiyeetii tutamnaat takwi barooh yhii. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Oontꞌa Laawiib uutaas fagiiriyaab ikatiin, tutamnaat takwi oodehayii lakkateeneet toona whag hooy yharriiw. Beet tuuna aree isanaayaahna Ibraahiimi taas ikatiineek han, bareeh tutamnaat takwi hooy lakkateen. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Uun uutak Malkisaadik laakiin Laawiib utaasii kiiki, baruuh masi tutamnaat takwi Ibraahiimii iyhi aree baruuh Ukwaasanaay uwaadiya ibariib Ibraahiim idehar. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Aree uuwinka oodiskaab baarakiiniyeet toona eetehak hooy kiihaay. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Ifagiiriyaayeet tehalaagaaytiib, tutamnaat takwi oodehay yꞌiyaayiinaayee lakkatamtini. Laakiin Malkisaadik beeb dhhaniibu attiyoodiyaab, tutamnaat takwi bariisooh lakkatamtini. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Laawi tutamnaat takwi lakkatiiniib, tutamnaatooh Ibraahiimi geebii kwisiyaab ikati gaal indiyeet toona han adgiriini. <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />Malkisaadik Ibraahiim imriyihoob, Laawi masi Hoobooh Ibraahiimi garooy iifi, baruuh masi faraay kiiki.<verse eid="HEB 7:10" /></para>
  <para style="s">Yasuuꞌa Malkisaadik tꞌiiteebu</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Laawiib ufagiiriimtii sabbii Israaꞌiiliib uudehay whag ittiyeewaayna. Oontꞌa Laawiib ufagiiriimti shagaay timmiimaab iiktiyeek, weer fagiiri harawa daayi kiidi. Gaal Malkisaadikiit takwi ikatiib Haaruuniit takwi kiiki. <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Ufagiiriimti badala ikatiyihoob, whag han ibakii itbadiil. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Taan taana hooy attiyoodiyaat ikatiineeb been weet gabiilaatii ikati, aree beet tugabiilaatii gaal han tikaraamaati mhiiniib shagaamaab kiiki. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Wꞌankwanaayuun Yahuudaay taasii ikatiyeet toona atookakinaatu, aree Muusa ifagiiriyaayeeb hadiidiyanihoob, beet tugabiilaatiib naat diyaab kiiki. <verse eid="HEB 7:14" /><verse number="15" style="v" sid="HEB 7:15" />Aree Malkisaadik tꞌiiti weer fagiiri lawiiniyeek, hinin diyaab nikatiyeet tuuna atookakinkaat tikati. <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />Baruuh ugadamiyooh asaasi sabbii fagiiriib akaab kiiki, laakiin baruuh umidhhani akrir wꞌagiya baabariinaay asaasi sabbii fagiiriib iki. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Uuktaab indi:</para>
  <para style="q1" vid="HEB 7:17">“Baruuk daayim fagiiri tikatiya,</para>
  <para style="q2" vid="HEB 7:17">Malkisaadikiit takwi tikatiya.” indi.<verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />Wꞌamir usuuri nꞌakwwa nafꞌaat baabariibwa ikatiyi sabbii itooꞌaash. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />Muusaay whag timmiimaana kwaasaab kiiki. Oontꞌa laakiin daayika sꞌaya attiyeewiyaabuuyt Ukwaasana nidawil.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />Tuun tuuna halafooyt anu kitti, wari han halafooyt anu fagiiriyaab ikeena, <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />laakiin baruuh halafooytii fagiiriib ikayihoob, Ukwaasana bariiyooh dehaay:</para>
  <para style="q1" vid="HEB 7:21">“Wꞌankwana halafooyaabu,</para>
  <para style="q2" vid="HEB 7:21">aree ibhaliyeeh iibdil kiidi: baruuh ‘Baruuk daayim fagiiri tikatiya.’ diyaabi.” idi.<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />Toon tehalafooyti sabbii, Yasuuꞌa hayiska galadi daamin iki.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />Oontꞌa baliin ifagiiriya tꞌiiteeb gwida eefeena, laakiin bareeh tuuyat tꞌafiit ushagaayoohna soorarmaab kiikeen. <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />Laakiin Yasuuꞌa diimaab dhhaniibuuyt, baruuh daayim fagiiri ikati. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Shaawti bariiyooh geebii Ukwaasanaay dehaay yꞌeen, baruuh diimaab bareeh ishidhhiineet toona adgiriini. Baruuh diimaab bareeyooh dehaay Ukwaasana hadiidsamiiniyi jillaay kwarri.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />Bak tꞌiiti win fagiiri hinin nharweet toona faaysiini. Baruuh mugadasu, yaay anuubu, nhasu, tumaagtikinaayee tafaalu, aree tibreeteeb asti tageegaabi. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Ifagiiriya iwawin eeraw tꞌiiteeb kiiki, baruuh bꞌeebka karaamti farꞌiti kiihariw, hankaab ooknaay danuubi jillaay, malya oodehay irawi danuubi jillaay tikaraama farꞌiti kiihariw. Baruuh ugarooyooh gaalhoob nuuniyanihoob, kasseeh oodehayi danuubi jillaay karramamiya. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Whag oodehay eenꞌakw wawin fagiiriya ikwasi, laakiin tehalafooy whaggi harꞌii eetaayt, Wꞌoor diimaab timmiima win fagiiri iki.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">Ugalad Ugayiinaay Ufagiiri Oowin</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Hinin hooy bhaliinayeet tuuna baku: Hinin bak tꞌiiti win fagiiri nibari, baruuh tibreeteeb Wꞌalyaanaayt tehadꞌaayeeti maygwadiib nꞌati sꞌaabi. <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />Baruuh win fagiiriit Oomhiin Winneet Umugaddasiib shagaamiini. Wꞌankwana dꞌiraab ikatiyeet sidkiit kheemaatiib ufagiiriit shagaamiini. Tukheema dehayi ayee dꞌaart kitti.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />Win fagiiriika miyaawwa karaamaatwa fanrꞌi jillaay daamaabi. Aflaay uun han ibakii naat iniiweet toonaati. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Baruuh tubuutiib iifiyeek, fagiiriib kiiꞌaki. Suur akay aree whag sooyaneeb oomiyaaw iyaw dehay eefeen. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Ishaga ifagiiriya shagaameeneeb tibreeteeb eefeeb ishagaay kitꞌaneewwa lꞌandalaawwa tꞌiiteebi. Muusa tukheemaati dꞌuur idwilihoob, toon toona akraab soomamiya, “Shibiba, oorbaay kehii dehook lawiyaant teena tꞌiiteena saktiniya.” idi. <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Laakiin oontꞌa, Yasuuꞌa bareeyooh ushagaayka tageegaka fagiiriyaayi shaga ittiyeewaay. Ukwaasanaawwa udehayoohwa eebtik idꞌiyeeb ugalad daayikaabi. Uun ugalad daayika asaasi kehii daamaabuuyt daayikaab ikati.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />Been ugalad whankaaneeb amaagna hooy akaat bitkaayeek, bariiyooh oomhiin weer galadi harawa kadaaya. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Laakiin Ukwaasana oodehayi geeb gwihaab imriit,</para>
  <para style="q1" vid="HEB 8:8">“Daman yꞌeena, indi Wꞌankwana,</para>
  <para style="q2" vid="HEB 8:8">ani Israaꞌiileeb oodehayi geebwa</para>
  <para style="q1" vid="HEB 8:8">Yahuudaay oodehayi geebwa</para>
  <para style="q2" vid="HEB 8:8">gayi galad iikwasi andi.<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />Baruuh ugalad</para>
  <para style="q2" vid="HEB 8:9">bareeyooh yhoobaayi geeb adꞌiyeeb tꞌiiteeb kiiki</para>
  <para style="q1" vid="HEB 8:9">ani bareeh yꞌayi abikaayt</para>
  <para style="q2" vid="HEB 8:9">Masree asfarꞌihoob,</para>
  <para style="q1" vid="HEB 8:9">baraah aniib ugalad ikitꞌana</para>
  <para style="q2" vid="HEB 8:9">aree bareesooh fidnaab yakan.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Ani Israaꞌiileeb oodehayi geeb akwasiyeeb ugalad oon ikati</para>
  <para style="q2" vid="HEB 8:10">been udoori harꞌii, indi Wꞌankwana.</para>
  <para style="q1" vid="HEB 8:10">Aniib whag bareeyeehna igirmaayeeb daasi andi</para>
  <para style="q2" vid="HEB 8:10">aree bareeyeehna iginꞌaayeeb iiktib andi.</para>
  <para style="q1" vid="HEB 8:10">Ani Ukwaasanaayoohna iikti andi,</para>
  <para style="q2" vid="HEB 8:10">aree baraah anii dehay iikti iyadna.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Gaal tak han ushawwooh allami kiidi,</para>
  <para style="q2" vid="HEB 8:11">tari tak usaniyooh dehaay, ‘Wꞌankwana kana’ iyaad kiidi,</para>
  <para style="q1" vid="HEB 8:11">baraah kassaah aneeb iikan iyadnayt,</para>
  <para style="q2" vid="HEB 8:11">baraah oodisnaay oowin ookiik aneeb iikan iyadna.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Bareetooh toomaag afooyi andi</para>
  <para style="q2" vid="HEB 8:12">aree tumaagtoohna shaawti shꞌi kaadi.” idi.<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />Baruuh ugaladooh “Ugayiib” isim, been ugalad whankaaneeb shꞌiiyaab ikwaas. Tuuna tushꞌiiyaat eegrimamiit willa kwidhi tindi.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">Tꞌibaada tibreeteebwa tubuutiibwa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Oontꞌa ugalad whankaani ibaadaati gaanuun ibari, tubuuti kehii mugaddas mhiin han ibari. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />Tukheema tꞌatam. Tugurfa tꞌawwaliinaatiib lambaati mꞌabakaawwa, tutarabeesaawwa Ukwaasanaay dehaay ittiyeewiin yhadhiiwwa iifiin. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />Tusitaara tumalyaati harꞌii gaw Oomhiin Winneet Umugaddas ittiyoodi iifi. <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />Tehooyteeb dimꞌaraayt firꞌati mhiin libaani kwaraarsiti jillaaywa ugaladi sanduukwa kassaah dimꞌaraay assamaaba. Mannaab tiibriit dimꞌaraayt karoora hooy tiifi, Haaruuniit tukwoolay kadheet tiibri, aree billi awi ugalad kehii kataab iiktiyi iifiin. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />Usanduuki mhakwal Umatuuni karoobiim iifiina, aree yꞌambiraahna usanduuki kehii barara. Been oomhiin idanuub hooy afoomiin. Laakiin oontꞌa teen teena kasteeh ifassarti kaꞌadgirna.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />Naatka oontꞌaaneet takwaakw tiiktiyihoob, ifagiiriya oogaw barraab iifiib diimaab iidꞌaneeb ishagaayoohna shagaamiini jillaay shuumiyaan. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />Laakiin ufagiiri uuwin oogaw tehooyteeb shuumiya. Aree baruuh beet toona whawliib gaal door oobhaat saki, aree booy geebooh itfiyik, beentooy baruuh ugarooyooh jillaaywa uudehay gamaamtii kwaasaab iiktiineeb idanuubi jillaaywa karramami. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Aashuuk Imugaddasa tukheema tꞌawwaliit masi teefiyeeb ookiik, Uumhiin Winneet Umugaddas nagaal biikaayeet toona daayiib rhisiin. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />Tuun tuuna oontꞌaaneeb udoori sooti ikati. Uumiyaawwa tikaraama tꞌattiyeewiyaatwa oodehay iyꞌibidnaayi ginꞌa isinhisneet toona adgiraab kiikeen. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />Baraah tamtiibwa gwꞌatiibwa oobhaat ikeeniit, gwidaat manasabaati shagwadh ikeen. Aan baraah barraab ikati gaanuun gayi nidaam ikatiyeeb ookiik daayiin.<verse eid="HEB 9:10" /></para>
  <para style="s">Umasiihiib Uubooy</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Umasiih suur akay tooy iifiint tidaayiinayti win fagiiriit eeyanihoob, tukheema toowinwa winneet timmiimaatwa dehay dꞌiraab biikaayeenaati geebii giigiya. Beet tuuna aree toon tuduniyaatii gaat kitti. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />Baruuh yaati booywa lagaayi booyiiwwa shuumaab kiiki. Laakiin baruuh Oomhiin Winneet Umugaddas baruuh gaalhoob ooknaay booyii shuumiya, baruuh umidhhan udaayim dehoon imri. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Teeyaawwa iyooyi booywa, lagaay nꞌeetihaashwa nhas baakay oodehayi kehii safamiya. Aflaay baraah tisaradtee nhas iiktiin. <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />Tuun tuuna sidik tikayihoob, Umasiihiib uubooy kak gwidakaana iitkwikw indi! Baruuh Eeshuuk idaayimaayee ugarooyooh ookna timmiimaat karaama Ukwaasanaay dehaay ifrꞌa. Bariiyuuh uubooy hineeb iginꞌa tooyat istoobiint tiwaraatee isinhiis. Aflaay hinin Ukwaasana udhhaniib shagaamnayeet toona adgirnay.<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />Oon usabbii, Umasiih ugalad ugayiinaay bitkeemanaab ikati. Baliin iwaliikameen tikwasa tidaayima suur waadiyaamaat imaar iyadna. Oontꞌa ugalad whankaaneenaay whii tikeet tumaagtii bareeh isfadiigi jillaay baruuh karaamaateeb itoodaar.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />Gaal yaaytiit wasiiyeet inꞌiishihoob, beet toona idꞌiib uutak ayaab ikatiyeet toona ibakii akkadtini. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Uutak dhhaniib ikatiyihoob tuwasiiyi takweet kitbari, laakiin baruuh iyaayihoob takweet tibari. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Tuun tuuna aree ugalad whankaani booy anu takweeteeb daamaab biikaayeet toona rhistini. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Muusa oodehay kasseeh whaggiit tiwasi kasteeh sooyanihoob, baruuh lagaay booy yami geeb hiddaab iyhi, aree adarooya hamoowwa hindi lꞌiidwa iyhaayt, malya baruuh whaggi kitaabwa kasseeh oodehayi kehiiwwa safiya. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />Baruuh “Uun baruuh ugaladi booyu, Ukwaasana barooh tisnaakiirneet toon sooyi hookna.” idi. <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Oontꞌaaneet, tukheemaawwa batiiteeh timanasabaateeb daameent teena kasteehwa, baruuh oobooy kehii safiya. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Whag aree naatka booyii ateharamtiniyeet toona yharriiw, aree oobooy baafiif afoob kadaaya.<verse eid="HEB 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Baliit taana tibreeti gadami kitꞌani ibariin beet tehayꞌaatii eenhasiineet toonaati. Laakiin taana tibreeteeb eefeent taakna han daayikaat karaama yhariwna. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />Umasiih Mugaddas Mhiin oodehayi ayee shagaamamaab shuumaab kiiki, been uumhiin aree oomhiin usidkiinaay kitꞌani ikati. Baruuh teebri teekna shuumiya, aree oontꞌa hini jillaay Ukwaasanaay suurii lawiini. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Iyahuudi fagiiri uuwin Oomhiin Winneet Umugaddas hawilka reewi booyii eebi. Laakiin Umasiih gwida doora ugarooyooh iniiwi jillaay kiibi. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />Malya Umasiih tuduniya akhligamtaneekka gwida doora lhamiiniyeet toonaati. Oontꞌa laakiin udamaani wꞌagiyaay gaalhoob lawiya, ugarooyooh karaamaat kwaastiit toomaag giigsiiniyi jillaay lawiya. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Wꞌaadami gaalhoob ibakii iyaayi, aree beenaay harꞌii haakamamiini. <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />Umasiih han gwida dehayiit maagnaay gaalhoob giigsiiniyi jillaay karaamaat iki. Baruuh malya door lawi indi, maagnaayt haay giigsiiniyee dehaay kiiki. Laakiin baliib barooh yhagit midhhan dehaay haay yꞌiiniyi jillaay lawi indi.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Whag teena tidaayiit harꞌook yꞌeent tꞌiiteeb oobhaat ikati nuun bateeh teekna kiikeen. Oon usabbii aree, whawil hawli harꞌii itramiidt, tikaraama taakna baliib Ukwaasanaayt ibaadaatee dehaay yꞌeen timmiimaab kiikwaasna. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Beet tuuna tiiktiyeek, bareeh uumiyaaw hooy ingideet toona kitti han? Uudehay iyꞌabid kassaah gaalhoob nhas iiktiina, aree idanuubeesoohna gwabab kahissiyaan. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Laakiin baliit tikaraama hawilka idanuub shꞌaseen. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Eeshꞌaawwa tiyaati booywa idanuub giigseeneet toona kaꞌadgiriyaan.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />Shaawti Umasiih tuduniya eeyanihoob, baruuh:</para>
  <para style="q1" vid="HEB 10:5">“Baruuk tikaraamaawwa oomiyaawwa kitehariwa,</para>
  <para style="q2" vid="HEB 10:5">laakiin anii dehaay garoob tisoomira.<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />Baruuk atoolwaat karaamaawwa, idanuubeet karaamaawwa</para>
  <para style="q2" vid="HEB 10:6">haay radaayaab kitta.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Malya ani ‘Ani tooy eefi, tuun ooktaabiib aniib kataabtu</para>
  <para style="q2" vid="HEB 10:7">yaa Ukwaasanaay, baruuk harriiweet toona sakaniyi jillaay ani yꞌaabi.’ adi.” idi.<verse eid="HEB 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />Baruuh hankaab, “Tikaraamaawwa uumiyaawwa, atoolwaat karaamaawwa idanuubeet karaamaawwa baruuk hariwaab kitta, bareeh han haay radaayaab kitta.” idi. (Whag laakiin beet tuuna daamtiyeet yhiriw). <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />Malya baruuh, “Ani tooy eefi, baruuk harriiweet toona sakaniyi jillaay ani yꞌaabi.” idi. Baruuh toona tusuuriit daasiya idꞌiit tumalya itkwikw. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Aree been wharawaay, Yasuuꞌaab Umasiihiib ugarooyt karaamaati geebii hinin mugaddasaab niki.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />Bꞌeebka ifagiiriya kassaah udiiniit waajibtoohna itakwikwna. Aree doorka doorka baraah baliit tikaraama teekna karramamiina, laakiin taan tikaraama idanuubi giigsiti kaꞌadgiriyaan. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Laakiin Umasiih ugarooyooh ookna diimaab idanuubeet karaama ikwaas. Baruuh Ukwaasanaay maygwadii dehaay nꞌati isꞌa. <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />Been udoorii aree baruuh yꞌashooyaah bariiyeeh iragadaayi whii daameeneet toona hangiit. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Baruuh gat karaamaatee aree mugaddasaab ikeen baliib diimaab timmiimaab ikwaas.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />Aashuuk Imugaddasa han toon toona dehoon ibadehana. Baruuh hankaab:<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“Uun baruuh ugalad ani bareeyooh geeb iikwasi andiyeeb ikati</para>
  <para style="q2" vid="HEB 10:16">been udoori harꞌii, indi Wꞌankwana.</para>
  <para style="q1" vid="HEB 10:16">Aniib whag bareeyeehna iginꞌaayeeb daasi andi,</para>
  <para style="q2" vid="HEB 10:16">aree bareeyeehna igirmaayi kehii iiktib andi.” indi.<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />Malya baruuh masi:</para>
  <para style="q1" vid="HEB 10:17">“Idanuubeehwa yꞌamag shagaayeehwa</para>
  <para style="q2" vid="HEB 10:17">shaawti shꞌi kaadi.” indi.<verse eid="HEB 10:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 10:18" />Aree baliit taana afoomeenihoob, shaawti danuubeet karaama daayi kiidiin.<verse eid="HEB 10:18" /></para>
  <para style="s">Fagaramaana digwagwna</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Aflaay isanaayaan, Yasuuꞌiib ubooyii Oomhiin Winneet Umugaddas ishuumtiib akra ginꞌa hooy nibariyeek, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />baruuh gayi salalwa midhhani salalwa tusitaaraati geebii dehoon ingal, been baruuh aree, Yasuuꞌiib ugaru ikati. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />Ukwaasanaay ugawiib win fagiiri nibari. <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />Aflaay nhas ginꞌiiwwa sidki iimaaniiwwa Ukwaasana beeti nidawleet toonaati. Tumaagtii nhas ikatiin ginꞌaayeewwa nhas yamee shagwaadh garooywa Ukwaasana beeti nidawleet toonaati. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Ukwaasana uwaadiyaayooh kaleewiiniyeet toona aamannay akay, hinin nitfadhiidheeb isꞌaya daayiib nꞌabkeet toonaati. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Aree taktak nimshabiibeet toonaatu, taktak shamtiit ooreerwa tudaayiinaayti dꞌuuywa rhisnayeet toonaati. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />Hiddaab nimmarriyeet toona ishna baadꞌiina, gwadi bak sakeena, laakiin taktak nisꞌakiireet toonaatu, aree Wꞌankwanaayt tuuyin han tidiwileet toona rhiteena.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Usidkiit kanaant nimriyi harꞌii, masi kanee danuub nidꞌeek, idanuubi jillaay karaamaat daayi kiidiin. <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />Laakiin whukwimiit tooyinti sꞌayaamtiiwwa Ukwaasanaay yꞌashu tami tindiit toonꞌi tꞌakraanaati mirkwaaywa toobhaat tikati. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Muusaay whag iribka rhamaat anu iiya. Beet tuuna aree maloob tari mhay badehi ibidehanihoob tiikti. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Aflaay baliin Ukwaasanaay Wꞌoor abaabeen kak gwidakaana winneet jasaameeneeb hiisteena? Ukwaasanaay ugalad bareeh tumaagtii isinhas aaw isirhiis? Eeshuuk tinꞌimaateeb aaw neewiini? Baraah ujasa wꞌastehaleeneeb kak amaagkaab iikti indiyeeb uginꞌookna hooy dꞌiina! <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Bak diyaab ikatiib hinin nikteen, baruuh “Ani illaati andi, hooy itkwis andi.” diyaabi. Baruuh masi, “Wꞌankwana udehayooh haakami indi.” diyaabi. <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />Ukwaasana udhhaniinaay yꞌayeeb idhibti winneet mirkwaay tibariina ikati.<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Yasuuꞌaab hooy tikanneeb baliib eebꞌi yhankaaneeb shꞌaana, eembꞌi igwirha hooy timtaraamneeb, tilhanay hooy lhamtaaneeb shꞌaana. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />Door gaal oodehayi suurii neewamtaana aree amaag titweeraayna. Door weer baliib bak itweeraayni geeb daraag daraagii tingadna. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Baliib usijniib iifiinnee dehaay nꞌakwmanaataana, igadhꞌeeyook maraamamti afirhaa agbiltaana, baraakna iknaayaakna daayikaabwa daayimwa miraay tibreeteeb tiibriineet toona tiktiinnayt, agbiltaana.<verse eid="HEB 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 10:35" />Aflaay oon Wꞌankwanaay wꞌaamanti fidnaab baagiidna. Baruuh win miyaaw haay yꞌi indiyeet toona shꞌaana. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Daayi sabir oontꞌa tehariwna, malya aree Ukwaasana harriiweet toonaati dꞌuuy tisoorariimna. Aflaay kastooh baruuh waadiyaayaab ikatiyeet iyaay tiyadna. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Uuktaab indi,</para>
  <para style="q1" vid="HEB 10:37">“Oontꞌa shalikt middaatiib, been uyꞌiiniib yꞌi indi aree iidleel kiidi.<verse eid="HEB 10:37" /></para>
  <para style="q2">
    <verse number="38" style="v" sid="HEB 10:38" />Laakiin aniib uushbu uungaal, wꞌiimaanii iidhhan indi.</para>
  <para style="q1" vid="HEB 10:38">Aree bareeh gaal han hooy itꞌagiireek,</para>
  <para style="q2" vid="HEB 10:38">ani bariiyooh geeb afirhi kaadi.” indi.<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Laakiin hinin agartiit kwidheen dehay kinki, laakiin aamaniit eedhhaniin nikati.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">Wꞌiimaan</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Teena tisꞌayaamnayeet sidik ikatiinihoob, teena irhitiyooh binꞌadgirayeet sidik ikatiinihoob, oontꞌa wꞌiimaan sidik daayiini. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Udamaan ishꞌiiyaay iifiin uudehay wꞌiimaaniisoohna daayi faal rayiimiyaan.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />Tuduniya Ukwaasanaay bhaliiyee daamaat tikatiyeet toona wꞌiimaanii nikteen. Aflaay tuuna oontꞌa rhamtiniit lawaat baakaaynaatii daamaati.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />Wꞌiimaanii Haabiil Ukwaasanaay dehaay Gaabiiliika hayiskaat karaama ifirꞌa. Baruuh wꞌiimaanii shibu tak attiyoodiyaabu, Ukwaasana baruuh ifirꞌeet toona daayiib haay bhaliiya. Aree baruuh ayaab ikatiyeek han, wꞌiimaanii masi hadiidiini.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />Wꞌiimaanii Akhnookh toon tuduniyaatii yakamiya, aflaay baruuh tooyat dꞌamsaab kiiki. Ukwaasana barooh asti nuunamaabuuyt, gaal han barooh miraab kiiki. Baruuh whankaay yakamaab baakaay baruuh Ukwaasana afirhisaab udehayiib gaal ikati attiyoodiyaabi. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Wꞌiimaan anu Ukwaasana gaal han kaꞌafirhisiya. Ukwaasanaay dehaay yꞌiiniibka, Ukwaasana eefiyeet toonaawwa ibarooh yhariw baliib ijir iniiweet toonaawwa ibakii aamaneen.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />Nooh teena harꞌook iiktiin wꞌiimaanii akraab sooya. Baruuh Ukwaasanaay mirkwaayii indhiwaayeeh ishidhhiini jillaay tufalluuka shagaamiya. Baruuh wꞌiimaaniisooh tuduniya haakamiya aree wꞌiimaanii eetniit tooshbu kwasaamiiniib iki.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />Ibraahiim tikwasa hooy kwasaamiyaneeb oomhiin beeti wꞌiimaanii waliikamamiya. Baruuh naad iibiyeeb biikaaneek han Ukwaasanaay ibhali isnaakir aree giigiya. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Baruuh wꞌiimaanii ugawooh uwaadiyaay haashiib idꞌir, girba takiit girba haashiib ikwiir. Baruuh kheemaateeb ikwiri, Isehaagwa Yaaguubwa han baki idꞌiin, baraah been uwaadiya ookna bariiyooh geeb kwasaamiyaan. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Ibraahiim tumadiina yꞌasaas tiibriit yhigit. Tumadiinaati khattatanaawwa dꞌaariigaawwa Ukwaasana ikati.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />Ibraahiim eegrim taku, Saara giduudiit tiiktiyeek han, baruuh wꞌiimaanii baabaab iikti. Ukwaasana barooh sidki tak uwaadiya faaysaab ikatiyeet toona iishbib. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Aflaay oon ootak oongaal wꞌayaab ikatiinaay gwida taas yhayikwi haddiib, tꞌabaati issi tꞌiiteeb gwida hooy eeyaan.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />Aan uudehay kassaah iiyaaneeb ookiik masi wꞌiimaanii ikwiirna. Baraah teena tiwaadiyaamaat miraab kiikeena, laakiin teen teena teebhat rhiyaaniit sagi mhiinii yꞌashishna. Baraah girba dehay tubuuti kehii hasiibiib iiktiineet toona ifidhadhna. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Uudehay bak tꞌiiteet teena hadiidiin, baraah iknaayi haash yhariwneet toona rhistini. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Baraah ishaab iiktiineeb whaashiib iikwinneek, masi itꞌigirneet toona adgiriin. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Laakiin baraah daayika haash itibreeteenaay dehaay hayꞌiib iibriin. Shaawti Ukwaasana bareeh Ankwanaayoohna ittiyoodiyeet toonaatiib kiisikwꞌa. Ukwaasana bareeyooh dehaay madiinaat soomraabi.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />Ukwaasana barooh jarrabiyanihoob, Ibraahiim wꞌiimaanii Isehaag karaamaateeb ifirꞌa. Ibraahiim Ukwaasanaay waadiya attiyeewiyaab wꞌoorooh ungaalalaay karaamaateeb iifirꞌeet toona idwil. <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />Ukwaasana bariiyooh dehaay, “Oofraay ani dehook waadiyaayaab akatiyeeb Isehaagii yꞌi iyadna.” idi. <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />Ibraahiim Ukwaasana yꞌayaani yaksiti adgiriiniyeet toona aamaniya. Toon tꞌiiteena aree sidik tiki, Isehaag tuyatii bariiyooh dehaay yꞌagar eeya.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />Isehaag wꞌiimaanii Yaaguubwa Iisaawwa harꞌook iikti damaanii dehaay idehar.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />Yaaguub tooyat iidwilihoob, wꞌiimaanii Yuusifiib yꞌar kasseeh idehar, kwoolaytiyooh kehii adehamiyaayt Ukwaasana yꞌabid.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />Yuusif tooyat iidwilihoob, Israaꞌiili dehay Masree itfarꞌaneet toona wꞌiimaanii hadiidiya. Baruuh masi timiitatteeh bareeyooh geeb yakseeneet toona sooya.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Muusaay ifaru baruuh ifrayeenaay harꞌii mhay tirgaayi oor iiktiyihoob wꞌiimaanii iikwibisna, baraah wꞌoor mada oor biikaayeet toona iktiinna. Baraah whadꞌaayt takwi biisinaakiirneet toona rikwiyaab kiikeen.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />Muusa iwinihoob, Farꞌuuniit tꞌooti oor ittiyoodiyeet toona, wꞌiimaanii irib. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Baruuh shalik dooreet danuubeet nafirnayteeka, Ukwaasanaay oodehayi geeb amaag itweeriyeet toona yhayid. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Baruuh Masreeb oomraay wꞌalyaab kassiisoohka, Umasiihi jillaay ooneew isehaayis. Baruuh aree harꞌook imiireeb wꞌijir iishbib. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />Baruuh Masir wꞌiimaanii yꞌish, whadꞌaay gadab rikwiyaab kiiki. Baruuh Ukwaasana ubaarhamay rhiyaneek han, agaar kiiki. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Baruuh wꞌiimaanii Whasamti Wꞌiid idꞌiit ubooyi safti sooya. Aflaay Israaꞌiileeb yꞌar isuurkina umalak ukwidhsanaay atoodiraab kiikeen.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />Wꞌiimaanii aree uudehay Oobhar Wꞌadaru balama haashiit hasamiyaan. Laakiin Imasri hasamtiib jarrabiyaanihoob, bareeh aayam iyheen.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />Wꞌiimaanii aree Ariihaayt teheeta uudehay asaramaat yina ikwilalniit sakiyaanihoob dhadhibiyaan.<verse eid="HEB 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31" />Wꞌiimaanii aree tujakiin Rahab baliin Ukwaasana sinaakraab baakay oodehayi geeb atoodiraat kitti. Batuuh jaasuusaab tehadar.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />Naan masi weena andi? Gidꞌoonwa, Baaraakwa, Saamsoonwa, Yaftaahwa, Daawidwa, Saamuuꞌeelwa inabiyaawwa, een bareeh hooy ibhaliiti daman dehaay kaabari. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />Baraah wꞌiimaanii tehadꞌaayi yꞌabikna, wꞌadil yhakimna, aree toona tuwaadiyaamaat imriin. Baraah yhadhaayi yafa assiyaan. <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />Baraah akraat nꞌeet daasiyaaniit, bꞌadhdhiit yattii idhhanna. Baraah nꞌakw iiktiina, laakiin malya yꞌakirna. Baraah tuthꞌaaytiib yꞌakirna, aree yꞌashu igirbaanee dehaay ansiramiyaan. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Taamꞌat yꞌayaydaahna yꞌayaab yꞌagarna dehaay eeyaan, baraah masi tooyat hooy yakiyaan. Aaraw jasaamiyaana aree oofduug iribna. Aflaay baraah daayika yak masi imeer ikatiin. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Gwadi amaag itweeraayniit itoothꞌana, wari aree shinshilaatee imhakwaarniit oosjin daamiyaan. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Baraah geedamiyaana, minshaarii malu mhiin itkatꞌana, aree bꞌadhadhii itoodaarna. Baraah anootwa yaati hakooyeebwa giigiyaana, imeethibꞌana, yharagwna, aree amaag itweeraayna. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />Tuduniya bareeh takweet hiiyyaat kitti. Baraah umingaayiibwa irbaayeebwa hawriikiyaana, aree amaraayeebwa whaashiib deelaayeebwa daayaan.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />Baraah kassaah wꞌiimaaniyoohna jillaay daayi faal faalamiyaan. Laakiin bareesooh gaal han beet toona tuwaadiyaamaat miraab kiiki. <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />Ukwaasana daayiina dehoon kwinaabu, aflaay baraah hini geeb hiddaab oobhaat timmiimaab ikatiin.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">Ukwaasana yꞌareeh adab isidꞌi</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Aflaay hinin bak tꞌiiti gwida dehayiit badehaat geeboon nibariyihoob, teena tigoofiya ikatiint neegideet toonaati. Idanuub hinin winneet aabkaab han nifadigeet toonaati. Hinin daayi dhab amgaruubaab suuroon lawiiniib nidꞌeet toonaati. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />Tiliiliyaateen Yasuuꞌaab daayiib haay nishabbeet toonaatu, aree hineeb wꞌiimaan ibadootii wꞌagiya ookiik bariiyooh kehii adehamiini. Bariiyooh suurii iifiint tifirhaati sabbii baruuh usaliib imtaraam, usaliibi kehii tooyat han hooy sikwꞌaab kiiki. Oontꞌa baruuh Ukwaasanaayt tehadꞌaayeeti maygwadiib isꞌa. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />Baruuh idanuubi kinaayee imtaraameeb wꞌamaag wara uginꞌookna hooy dꞌiina, aflaay baraakna isꞌaya kitꞌatiit igwuuy kitdiina.<verse eid="HEB 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />Idanuubi kehii timꞌaliignihoob, ubooyookna teefifneeb ookiik amdeeriyaab kitteena. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Tisꞌakrooyti bhali bareekna yꞌareet dehookna bhaliimiyaan tibaadhinna:</para>
  <para style="q1" vid="HEB 12:5">Ukwaasana “Wꞌooruun, Wꞌankwana sooyiiniyeet toona sinaakira,</para>
  <para style="q2" vid="HEB 12:5">aree baruuh danniinihoob isꞌaya baakitꞌa.<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Wꞌankwana areeyaab ikatiyeeb ikwiriyaatay ishiishboobi akay, bariiyooh oor iikti indiib kasseeh danniin.” diyaabi.<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />Baraak ikwiriyaatayeet igwirha amtaraamna, Ukwaasana bareek yꞌareeh tꞌiiteena shanbiib hookna. Oor ubaaba biidaniineeb eefi han? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Kasseeh bariiyeeh yꞌareet baraak han adab bitdꞌiineek, sidki ar iikti kitdiina, laakiin haraami ar iikti tiyadna. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Hinin kassaan aadami baabaab nibari, baraah iidnanna hoon aree hinin bareeh nisniikar. Shaawti ishuukeeyoon Baaba udhhaniib daayiib nisnaakiireet toona kitti han? <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Baabaan shalik door ookiik baraah daayiinaayt isehariwniit idaaninna hoon. Laakiin Ukwaasana hinin iknaayeet daayiinaayti jillaay eedniin hoon, aflaay barooh tꞌiiteeb mugaddasaab nikati. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Hinin nimeedniinihoob been oodoor lhastini hoon. Laakiin malya been idinni imeednaan uudehay shibootwa mꞌasgi firaaywa dehaay ikati.<verse eid="HEB 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Shaawti yꞌayeekna igwooyaab asti aabikna, aree igwanbiyeekna eenꞌakw sꞌakirna. <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />Fadhadh salalaayeeb sakaana, aflaay ugaraab ragad ankwali kiidi, laakiin baruuh iinꞌir indi.<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Kasseeh oodehayi geeb mꞌasgiib kwiriina, aree mugaddasaab tikatiineet toonaati. Gaddastiib anu gaal han Wꞌankwana rhi kiidi. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Ukwaasanaayt tinꞌimaatee fidinti bitꞌagaarni jillaay digwagwna. Hamiit fuuti wintiit gwida gwirha tikwasiit tꞌiiteeb bitꞌakaayneet toonaati. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />Jikuuniib bitdhaabayneet toonaatu, tari Iisaaw tꞌiiti keefri bitꞌakaayneet toonaati. Baruuh wꞌoor usuurkina imiireet tikwasa gaat mhasayti jillaay idlib. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Beenaay harꞌii, baruuh ubaabaayt baraka yhariweet toona baraak tikteenna. Laakiin baruuh itoorraab. Baruuh milootiyaayt tibaraka yhariweek han, ituubtii dehaay winneet idleel.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Baraak ribaab tatehamiiniib, nꞌeetii eetliiwnaay dehaay yꞌaab kitteena. Laakiin thibinwa, laabuuswa, baraamwa, <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />dꞌaay thiwtii dehaaywa, whissi kwinhitii dehaaywa, yꞌaab kitteena. Uudehay whiss imaasiwnihoob, weet kalma biimaasiiwneet toona hooy yhariwna. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Baraah ibhali, “Reew han oon oorba tatehiiniyeek, ibakii geedami indi.” attiyoodiyaab sinaakraab kiikeen. <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Tuuna tirhamtaat winneet mirkwaay tiibriitu, Muusa “Ani mirkwaayii katatani.” idi.<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />Laakiin baraak oorba Sihiyoon eetaana, Algudus tibreeteet Ukwaasana udhhaniinaayt tumadiina eetaana. Baraak gwida alfa malak firhaati majlisaayeeb eefeen dehaay eetaana. <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />Yꞌar isuurkinaayeet kaniisaatiib eetaana, bareeh ismaayaahna tibreeteeb kataba. Baraak Ukwaasana oodehay kasseeh hankiimnaay dehaay eetaana. Oodehay eeshbooni shuuk itimmiimaanee dehaay eetaana. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />Yasuuꞌaab ugalad ugayiinaay bitkeemanaay dehaay eetaana. Haabiiliib ubooyiika hayiska bhali hadiidiiniib oobooy wꞌafaafnaay dehaay eetaana.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Oon whadiidiiniib aree ibhaliyeeh bitriibneet toonaatu, digwagwna. Been tubuuti kehii bareeh akraab sooyaab tisnaakrooy iribnihoob, baraah dhhanaab biikaayneek, aflaay hinin beeb tibreetee akraab sooyiiniyoon fidinaab hooy nitꞌagiireek, kak eedhhaniin niikti niyad? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />Been oodoor bariiyuuh whiss toobuut katatisiya, oontꞌa laakiin baruuh waadiyaab waadiyaaya. Baruuh “Masi door gaal toobuut toobhaat katatsi kaadi, laakiin teebri han katatsi andi.” idi. <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Tikalma “Masi door gaal” iyadt, taana tidaamaat katati iyadna, aree hantaayi iyadneet toona, tikalma rhiseen. Aflaay taana tibaakatataya daayi iyadna.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />Shaawti hinin katati baadiit hadꞌaayi nimeer akay, nhamdeet toonaatu, aree Ukwaasana radaasiini hamooysitiiwwa mirkwaayiiwwa nꞌabideet toonaati. <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />Ukwaasanaayuun toonꞌi tutamtiniit tꞌiiteebi.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">Ukwaasanaayt tifirha</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Sanaayeetwa kwaateetwa taktakeeb wꞌareeti soorarimna. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Igirbaani wꞌamnaasti baabaadhiinna, een iweer gwadi kanaab baakay imalak amnaasiyaan. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Abiiyaakna beentooy tiifiit toonaatiit, whabsiib eefeen baliib shꞌaana. Tilhanay ugarooyookna ooknaay haay hissiyaab toonaatiit, yꞌamag atweeriyaab baliib han shꞌaana.<verse eid="HEB 13:3" /></para>
  <para style="s">Idꞌareeb amaanaat dꞌiina!</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />Eedꞌar hamooysaana, idꞌareeb gaal ooraawi geeb amiinaab akeena. Jikuuniibwa faddaadamtiibwa yakeen baliib Ukwaasana sidik haakami indi. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />Ishuukeekna imhallaga baaꞌareesaana, toona tutibariineet haay ganaamaana. Ukwaasana,</para>
  <para style="q1" vid="HEB 13:5">“Ani iiyꞌish hookna kaadi,</para>
  <para style="q2" vid="HEB 13:5">ani iibdhan hookna kaadi.” diyaabi.<verse eid="HEB 13:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 13:6" />Aflaay hinin winneet akra ginꞌii,</para>
  <para style="q1" vid="HEB 13:6">“Wꞌankwana shamaamiigaayu ikati, ani iraakw kaadi.</para>
  <para style="q2" vid="HEB 13:6">Uudehay anii dehaay naan daayeena?” niyad.<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Ukwaasanaay ibhali dehookna bhaliiyaan isuurkinaayeekna shꞌaana. Baraah ikwiirneeb ookwiraay shibibna, baraah iibriineeb wꞌiimaan tꞌiiteeb dꞌiina. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Yasuuꞌa Umasiih oontꞌaaneet iroowwa amseewwa diimaawwa, gaalu kagayyaramiya.<verse eid="HEB 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 13:9" />Kasseeh ijinsaayi girba tꞌaliimii atootaaltiit fidnaab baayakaana. Iginꞌaayaan tinꞌima miriitiit yꞌakirneet tuuna daayiitu, aduumaateet mꞌariitii kiiki. Teen timꞌariya tameen baliin takweet kiidꞌiin. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />Hinin karaamaat firꞌati mhiin nibari, ifagiiriya udiini gawiib shagaameen teen tikaraama geeboon haay tameeni hag kiibariin.<verse eid="HEB 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 13:11" />Ufagiiri uuwin ureewi booy Oomhiin Winneet Umugaddas ookiik itfayiik, maagti giigsiti jillaay aree karaamaat mhaliini. Laakiin ureewi garu umꞌaskari fidnaab itooliiwna. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Aflaay Yasuuꞌa han ubooyooh ooknaay oodehay isinhiisi jillaay tumadiinaati dheefaay barraab lhamiya. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Aflaay hinin han barooh umꞌaskarii barraab niibi, bariiyooh wꞌeeb geeb niitkwi. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Hinin tooy diimaab timtariimt madiina kinbari. Laakiin harꞌook eetniit tumadiina nhariw.<verse eid="HEB 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15" />Shaawti hinin Yasuuꞌi geebii diimaab Ukwaasanaay dehaay hamaadiit karaama nifarꞌeet toonaati. Been whamaad uyafii ikatiib, baruuh Wꞌankwana ikatiyeet toona rhisiini. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Tudaayiinaayti dꞌuuy baabaadhiinna, taktak shamna. Taan taana Ukwaasana afirhiseent karaama ikatiin.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Isuurkinaayeekna sinaakirna, tehadꞌaayeetoohna ramna. Baraah fiinaniit anu bareek eegwꞌadiina, ibakii aree hisaab iyawna. Baraah ishagaayoohna firhaatee idꞌani jillaay sinaakirna, bitsinaakiirneek gadabiit shagaami iyadna. Beet tuuna bareek iishtam hookna kitdi.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Hinin dehoon siileelaana. Hinin sidik nhast niya nibariyeet toona nikteen aree kassoohoob hamooysamaa nikweereet toona nhariw. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Aflaay ani bareekna beeti atꞌagiiri jillaay, ani uknaayu siileelteeneet toona hookna aharriiw.<verse eid="HEB 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Ukwaasana umꞌasgi, ugalad udaayimi booyii Wꞌankwanaayoon Yasuuꞌaab tooyatii ishidhhan, been tꞌanooti shaakwana, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />baruuh yharriiweet toona tidꞌanihoob, tudaayiinaay kastooh barayiisi hookna. Yasuuꞌa Umasiihi geebii, umatuun diimaab bariiyooh ikatiyeeb, barooh afirhistiniit toona hoon shagaamiiniib baꞌiikti. Aamiin.<verse eid="HEB 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Isanaayaan, toon tisꞌakrooytiit diigwat tarmuumaay tisnaakiirneet toona hookna aharriiw. Oon ujawaabiib shalikna dehookna kitbaabi.<verse eid="HEB 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 13:23" />Usanuun Tiimooti han ifdageet toona tikteeniineet toonaati. Baruuh willa yꞌiiniyeek, bariiyooh geeb yꞌeetiit rheesami hookna indi.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Isuurkinaayeekna kasseeh salaamaana, Ukwaasanaay oodehay han salaamaana. Baliin Itaalyaay eefeen tishboonay salaameen hookna.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Ukwaasanaayt tinꞌima kasseeyookna geeb badaayiin.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>