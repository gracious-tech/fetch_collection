<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Bella</book>
  <para style="h">Mattaay</para>
  <para style="toc1">Mattaay Injiil</para>
  <para style="toc2">Mattaay</para>
  <para style="mt">Mattaay Injiil</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Yasuuꞌii yhooba</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Aan baraah Yasuuꞌa Umasiihi Daawidi oor, Ibraahiimi oor ikatiina:<verse eid="MAT 1:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2" />Ibraahiim Isehaag ifri,</para>
  <para style="li2" vid="MAT 1:2">Isehaag Yaaguub ifri,</para>
  <para style="li2" vid="MAT 1:2">Yaaguub Yahuudaabwa isanaawwa ifri,<verse eid="MAT 1:2" /></para>
  <para style="li2">
    <verse number="3" style="v" sid="MAT 1:3" />Yahuuda Faaraswa Saarahaawwa tuundi Taamaar tiiktiyeeb ifri.</para>
  <para style="li2" vid="MAT 1:3">Faaras Hasruun ifri,</para>
  <para style="li2" vid="MAT 1:3">Hasruun Raam ifri,<verse eid="MAT 1:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="MAT 1:4" />Raam Amiinadaab ifri,</para>
  <para style="li2" vid="MAT 1:4">Amiinadaab Naahshuun ifri,</para>
  <para style="li2" vid="MAT 1:4">Naahshuun Salmoon ifri,<verse eid="MAT 1:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="MAT 1:5" />Salmoon Booꞌaas tuundi Raahab tiiktiyeeb ifri,</para>
  <para style="li2" vid="MAT 1:5">Booꞌaas Oobeed tuundi Raaꞌuut tiiktiyeeb ifri,</para>
  <para style="li2" vid="MAT 1:5">Oobeed Yassiib ifri,<verse eid="MAT 1:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="MAT 1:6" />aree Yassi whadꞌa Daawid ifri.</para>
  <para style="b" vid="MAT 1:6" />
  <para style="li1" vid="MAT 1:6">Daawid Suleemaan tuundi Uuriyaay takat tiiktiyeeb ifri,<verse eid="MAT 1:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="MAT 1:7" />Suleemaan Rahabꞌaam ifri,</para>
  <para style="li2" vid="MAT 1:7">Rahabꞌaam Abiiyaab ifri,</para>
  <para style="li2" vid="MAT 1:7">Abiiya Aasaab ifri,<verse eid="MAT 1:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="MAT 1:8" />Aasa Yahooshaafaat ifri,</para>
  <para style="li2" vid="MAT 1:8">Yahooshaafaat Yahooraam ifri.</para>
  <para style="li2" vid="MAT 1:8">Yahooraam Ussiyaab ifri,<verse eid="MAT 1:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="MAT 1:9" />Ussiya Yootaam ifri,</para>
  <para style="li2" vid="MAT 1:9">Yootaam Aahaas ifri,</para>
  <para style="li2" vid="MAT 1:9">Aahaas Hasagiyaab ifri,<verse eid="MAT 1:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="MAT 1:10" />Hasagiya Manassaab ifri,</para>
  <para style="li2" vid="MAT 1:10">Manassa Aamoon ifri,</para>
  <para style="li2" vid="MAT 1:10">Aamoon Yooshiyaab ifri,<verse eid="MAT 1:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="MAT 1:11" />aree Yooshiya Baabilyooneeb hasiibiib iiktiyi door Yakooniyaawwa isanaawwa ifri.<verse eid="MAT 1:11" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="12" style="v" sid="MAT 1:12" />Baabilyooneeb hasiibiib iiktiyeenaay harꞌii:</para>
  <para style="li2" vid="MAT 1:12">Yakooniya Shaꞌaltiiꞌeel ifri,</para>
  <para style="li2" vid="MAT 1:12">aree Shaꞌaltiiꞌeel Saruubaabil ifri.<verse eid="MAT 1:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="MAT 1:13" />Saruubaabil Abiiyahuud ifri,</para>
  <para style="li2" vid="MAT 1:13">Abiiyahuud Alyaagiim ifri,</para>
  <para style="li2" vid="MAT 1:13">Alyaagiim Aasoor ifri,<verse eid="MAT 1:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="MAT 1:14" />Aasoor Saaduug ifri,</para>
  <para style="li2" vid="MAT 1:14">Saaduug Akiim ifri,</para>
  <para style="li2" vid="MAT 1:14">Akiim Alyuud ifri,<verse eid="MAT 1:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="MAT 1:15" />Alyuud Alꞌasaar ifri,</para>
  <para style="li2" vid="MAT 1:15">Alꞌasaar Mattaan ifri,</para>
  <para style="li2" vid="MAT 1:15">Mattaan Yaaguub ifri,<verse eid="MAT 1:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="MAT 1:16" />aree Yaaguub Yuusif ifri,</para>
  <para style="li2" vid="MAT 1:16">Yuusif Maryami taku, Yasuuꞌa Umasiih ittiyoodi batiiyooh itfari.<verse eid="MAT 1:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Ibraahiimii Daawid ookiik tamna fadhig taas iiktiina, Daawidii Baabilyooni whasiibamti ookiik aree tamna fadhig taas iiktiin. Whasiibamtii Umasiih ookiik han tamna fadhig taas iiktiin.<verse eid="MAT 1:17" /></para>
  <para style="s">Yasuuꞌiit timifiray</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Tuun tuuna Umasiih Yasuuꞌa kak ifirayeeb sootni: tuundi Maryam Yuusif tiidꞌari jillaay daasamta. Laakiin baraah taktak baakatiim, batuuh Eeshuuk Imugaddasaayee oor ifaar tiideet toona tikan. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yuusif utakuuh shibu takuuyt, batooh oodehayi suurii isiisikwꞌeet toona hariwaab kiiki, kwibistiit fadag niyaami.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Baruuh toon imkireenaay harꞌii, Wꞌankwanaay malak hawsooteeb bariiyooh dehaay lawiyaayt, “Yaa Yuusif Daawidi oor, Maryam takatook tikwasiyeet toona baarakwiya. Batooh Aashuuk Imugaddasa sinakwaaba. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Batuuh oor ifaar tindi, aree baruuk wꞌoor Yasuuꞌaab sima. Baruuh udehayooh idanuubeesoohna ishidhhin indi.” idi.<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Wꞌankwana unabi isiisoodeet tuuna kastuuh sidik iikti tindi: <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“Tꞌaagir nikwiitiit oor ifaar tindi, aree wꞌoor Immaanweel iisim iyadna.” diyaabi. Immaanweel “Ukwaasana geeboon eefi.” miyaadi.<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Yuusif ibꞌarihoob, Wꞌankwanaay umalak barooh sooyaneet toona idꞌi, aree Maryam takatooh ikwaasiit oogaw haay ibi. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Laakiin batuuh wꞌoor tifriyeeb ookiik batiiyooh geeb diwaab kiiki. Aree barooh Yasuuꞌaab isim.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Imajuuseet diyaara</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Yasuuꞌa Beetlaham Yahuudaay ifrayeenaay harꞌii, whadꞌa Heeroodisiib udamaaniib, Majuusi gali uyintalawii Algudus beeti eeyaaniit, Heeroodis raatiyaan. <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />Baraah “Iyahuudi hadꞌa ikatiyi jillaay faraay wꞌoor keeya? Whayuukwooh uyintalawiib rhina, aree hinin barooh nꞌabidi jillaay yꞌaaba.” idiin. <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />Whadꞌa Heeroodis een ibhali imaasiwihoob winneet gadabiya. Alguduseeb iifiin uudehay kassaah han bariiyooh geeb yhaseen. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Heeroodis ifagiiriya isuurkinaawwa whaggi koojaawwa kasseeh hiddaab waliikiyaayt raatiya, “Umasiih naad itfir indi?” idi. <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Baraah “Beetlaham Yahuudaay itfir indi.” idiin. Suur toon toona unabi kitbaabu:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“Batuuk Beetlaham, Yahuudaay whaashiib teefeet, Yahuudaay yhadꞌaayeeka dhibakaat kittaayii, batiisook aree hadꞌa yꞌiini. Been baruuh udehayu Israaꞌiili shakwa iikti indi.” diyaabi.<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Malya Heeroodis Imajuusi diiseet waliikiyaayt, whayuukw naadoor ikayeeb bareeh raatiya. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Bareeh Beetlaham beeti ifdigaayt, “Difnaat wꞌoor daayiib hariwna. Barooh willa timeernihoob, sooyaanheeb, aflaay ani han bayiit barooh ibid andi.” idi.<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Baraah whadꞌaay bhali imaasiwniit harꞌii, usalaloohna isoorarimna. Aree uyintalawiib rhiyaaneeb whayuukw, been wꞌoor iifiyeeb oomhiin iktimeeb hadiit bareeyooh suurii sakiya. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Baraah whayuukw rhiyaanihoob, winneet afirhiyaan. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Baraah oogaw shuumee, wꞌoor toondi Maryami geeb rhiyaana, aree kuuramiyaaniit barooh yꞌabidna. Malya tishantaateehna ifdigniit wꞌoor dimꞌaraawwa, libaanwa, mirwa miyaaw yhiin. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Baraah hawsooteeb Heeroodis beeti biikiraafneet toona soomamiyaan. Aree weer salalii whaashoohna beeti yꞌagarna.<verse eid="MAT 2:12" /></para>
  <para style="s">Masir beeti eedhab</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Baraah giigiyaanihoob, Wꞌankwanaay malak hawsooteeb Yuusifii dehaay lawiyaayt, “Yakaa, wꞌoorwa toondeewwa yaksaat Masir beeti foora. Ani sooyaniyook ookiik beentooy hagita. Heeroodis wꞌoori madar niyaamiini akay, barooh harriiw.” idi. <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Aflaay baruuh yakiyaayt, wꞌoorwa toondeewwa whawaadi door Masir beeti haay idif. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Heeroodis iyaneeb ookiik aree beentooy isꞌa. Aflaay Wꞌankwana unabi miidalaabii diyaab iiktiyeet tuuna sidik tiikti, “Wꞌooru Masree waliikan.” diyaabi. <verse eid="MAT 2:15" /><verse number="16" style="v" sid="MAT 2:16" />Heeroodis Imajuusi itilneet toona ikanihoob, gadabiyaayt Beetlahamwa yhadabeeyoohwa iifiin yꞌar malu hawlaawwa eedhoomwa iiktiin kassaah itoodiirneet toona amir hassiya. Beet toona baruuh Imajuusee kanaa iifi. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Malya unabi Irmiyaay miidalaabii attiyoodiyaat tuuna sidik tiki:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“Raamaay hiss itmassaaw,</para>
  <para style="q2" vid="MAT 2:18">waawtiiwwa akra gadabtiiwwa hiss,</para>
  <para style="q1" vid="MAT 2:18">Raaheel yꞌareeyooh jillaay waawtini,</para>
  <para style="q2" vid="MAT 2:18">aree baraah ayaabayt,</para>
  <para style="q1" vid="MAT 2:18">wꞌallaayrahamoomti tinriib.” diyaabi.<verse eid="MAT 2:18" /></para>
  <para style="s1">Naasiraab beeti timꞌageer</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Heeroodis iyaayt harꞌii, Wꞌankwanaay malak Yuusifii dehaay hawsooteeb Masreeb lawiya. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />Umalak “Yakaa, wꞌoorwa toondeewwa yaksaat Israaꞌiileeb whaash beeti giigaa. Baliin wꞌoori madar yhiriw, oontꞌa ayaaba.” idi.<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Aflaay Yuusif yakiya, wꞌoorwa toondeewwa iyhaayt Israaꞌiileeb whaash beeti giigiya. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Laakiin Yuusif Arkhiilaawoos ubaaba Heeroodisi mhiin hadꞌaab Yahuudaay iikti indiyeet toona imaasiwihoob, beentooy oogiig irkwi. Baruuh hawsooteeb soomamiyaayt, Jaliileeb whaash beeti yꞌagar. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Aree baruuh giigiyaayt Naasiraab iidneet madiinaatiib ikwiri. Aflaay inabiyaayi miidalaabii attiyoodiyaat tuuna sidik tiikti, “Baruuh Naasiraayi ittiyuud indi.” diyaaba inabiya.<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Yuuhanna umoosana usalal isoomiir</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Baliit tiyinaateeb Yuuhanna umoosana eeyaayt, Yahuudaay umingaayiib allamiya. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />Baruuh “Tuubaana, tibreeteet hadꞌaayi dawiltu.” iid. <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Yuuhanna unabi Isyaas haay hadiidaab iiktiyeebu, baruuh:</para>
  <para style="q1" vid="MAT 3:3">“Umingaayiib waliikiini hiss gaal eefi,</para>
  <para style="q1" vid="MAT 3:3">‘Wꞌankwanaay dehaay salal soomirna, tilagi fadhadht kwaasna.’ diyaabu.” idi.<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Yuuhanna kaami hamooyee shagaamama halaka ikwi, habaab ilbab, aree yaaweetwa awitwa tamiya. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Uudehay Alguduseewwa, kastooh Yahuudaaywa, kassooh Wꞌurduni haashiiwwa barooh beeti iibiin. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Uudehay idanuubeehna ifidhadhna, aree Urduni bhariib barooh itoomaasna.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Laakiin baruuh gwida Fariisiiwwa Sadduukiiwwa baruuh iimseeb oomhiin yꞌee rhiyanihoob, bareeyooh dehaay, “Yaa ikwakwaraayi ar, bareek beeti sakeen igadabee eedhab aaw sooya hookna? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Tuubaana firaay lawsaana! <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Aree igarooyeekna dehaay, ‘Ibraahiim baaboon akay nibari.’ tiyadneeb baahiisaana. Oosdik andi hookna, Ukwaasana een yꞌaweeyee Ibraahiimi dehaay ar yakisitiib adgiriini. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Uufaas whindi gadami kehii suur akay daasamiya. Whindi daayiit samara baafariibka, katꞌamiit nꞌeetiib ituugid indi.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />Ani tuubteeni jillaay yamee anmiis hookna. Laakiin anii harꞌii aniika akrakaab yꞌi indi. Ani barooh tigidhꞌaateeh atfayiikee dehaay han kaꞌadgiran. Baruuh Eeshuuk Imugaddasaayeewwa nꞌeetiiwwa iimis hookna indi. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Uun baruuh girbaalooh yaksaabu, wharru daayiib isinhis indi. Igamhooh ugeesaay daasi indi, wꞌagga aree baayaayt nꞌeetii iiliw indi.” idi.<verse eid="MAT 3:12" /></para>
  <para style="s">Yasuuꞌa itoomiis</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Aflaay Yasuuꞌa Yuuhannaab itoomiisi jillaay Jaliilee Urdun beeti eeya. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Laakiin Yuuhanna barooh bhaliisamiya, “Ani barook atoomiiseet toona aharriiw, baruuk aree anii dehaay eetniya?” idi.<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Yasuuꞌa “Aflaay oontꞌa bak batiikti. Bak aree kastooh Ukwaasana yharriiweet toona niiwari.” idi. Yuuhanna han agbiliya.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Yasuuꞌa itoomaasihoob, willa iyamee asti yakiya. Been oodoor taabri ifdagna, aree Ukwaasanaay Eeshuuk kwibheeriitiit hayꞌaatii tikweewwa bariiyooh kehii talaweewwa rhiya. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Malya hiss tibireetee, “Uun baruuh wꞌooru ani areeyaniyeebu, barooh ani winneet geeb afirhaabu.” idi.<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Uubliis Yasuuꞌaab jarrabiya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Aflaay Yasuuꞌa oobliisii jarrabamiyi jillaay, Aashuuk barooh umingaay beeti imilhana. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Fadhig tamuun hawadwa fadhig tamuun bꞌeewwa baaskiitiyanihoob, Yasuuꞌa yharagw. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Uubliis bariiyooh dehaay eeyaayt, “Baruuk Ukwaasanaay Oor tikatiyeek, een yꞌawi hadhiib akeena diyaat sooyaa.” idi.<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Yasuuꞌa igwibi, “Tuun kataabtu: ‘Wꞌaadami mꞌariit toobhaanaatii kiikwiri, laakiin Ukwaasanaay yafii yꞌeen ibhali yharriiw.’ diyaabu.” idi.<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Malya uubliis barooh tumadiina tumugaddas beeti istoob aree Ukwaasanaay ugawi mooyi kehii isingad. <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />Uubliis “Aflaay baruuk Ukwaasanaay Oor tikatiyeek, nꞌati faraa. Tuun batuuh kataabtu:</para>
  <para style="q1" vid="MAT 4:6">‘Baruuh imalakeeh bariisook waseeyi indi,</para>
  <para style="q2" vid="MAT 4:6">baraah yꞌayeeyoohna asti yꞌibik hook iyadna. Aflaay iragadaayaak aweeb imuuthꞌa kiidiin.’ diyaabu.” idi uubliis.<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yasuuꞌa bariiyooh dehaay igwibi, “Tuun han kataabtu: ‘Wꞌankwana Ukwaasanaayook baajarrabaa!’ diyaabu.” idi.<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Masi uubliis barooh winneet tageega riba beeti haay ibaayt, kasteeh tuduniyaatiit tehadꞌaayeewwa imatuuneehwa barooh rhisiya. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Uubliis “Nꞌati kuuramiit aneeb anbiideek, teen bateeh kasteeh iyaaw hook andi.” idi.<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yasuuꞌa “Hoosu giigaa, baruuk uubliis! Tuun batuuh kataabtu: ‘Wꞌankwana Ukwaasanaayook abida, barooh oobhaat shagaama.’ diyaabi.” idi.<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Malya uubliis barooh yꞌish giigiya, aree malak bariiyooh dehaay eeyaaniit barooh ishamna.<verse eid="MAT 4:11" /></para>
  <para style="s">Yasuuꞌa Jaliileeb ishanhooh badooya</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Yuuhanna oosjin daamiya diyee imaasiwihoob, Yasuuꞌa Jaliil beeti yꞌagar. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Baruuh Naasiraab yꞌisht Kafarnaahuum ibaayt hooy ikwiri. Been oomhiin Sabaluunwa Naftaaliiwwa haashiib iikti bhar oodar iifi. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Tuun batuuh aree unabi Isyaas diyaab iiktiyeet toona sidik tiikwsi. <verse eid="MAT 4:14" /><verse number="15" style="v" sid="MAT 4:15" />Unabi Isyaas, “Sabaluuni haashiiwwa Naftaali haashiiwwa,</para>
  <para style="q2" vid="MAT 4:15">oobhar eebiib usalal, Urduni daraag,</para>
  <para style="q2" vid="MAT 4:15">Jaliil Ijintiili haash!<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Uudehay thibniib ikweer</para>
  <para style="q2" vid="MAT 4:16">win nuur rhiyaan.</para>
  <para style="q1" vid="MAT 4:16">Tuyati lꞌandalaay haashiib ikweer baliib,</para>
  <para style="q2" vid="MAT 4:16">nuur dehaay talawiya.” diyaabi.<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Been oodoori harꞌii Yasuuꞌa bhaliitiib badooya, “Tuubaana, tibreeteet hadꞌaayi dawiltu.” idi.<verse eid="MAT 4:17" /></para>
  <para style="s">Yasuuꞌa ikwiriyaatay yhankaaneeb waliikiya</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Yasuuꞌa Jaliili bhari dar hiireeree, malu sana Siimoon Bitrus atoosmaabwa oosan Andaraawooswa rhiya. Baraah aashoob aabkiiba, shabakaatoohna ubhariib iigidna. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yasuuꞌa “Mꞌaana ramnaheeb, dehayi aabki iikwasi hookna andi.” idi. <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Baraah igidiyeesooh tishabakaateehna yꞌishna idꞌiiniit barooh iramna.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Baruuh beentooysii sakee, wari sana maloob rhiya. Baraah Yaaguub Sabadi oorwa oosan Yuuhannaawwa iiktiin. Baraah falluukaatiib ubaabuuhna Sabdi geeb haayee, tishabakaateehna isuumirna. Yasuuꞌa bareeh waliikiya. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Baraah willa tufalluukaawwa ubaabaawwa yꞌishniit barooh iramna.<verse eid="MAT 4:22" /></para>
  <para style="s">Yasuuꞌa oodehay eelhaab mheeliya</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yasuuꞌa kastooh Jaliileeb hiirareeriya, Iyahuudi diini gawaayeeb allamiya. Tehadꞌaayeeti sakana udaayiib bhaliiya, oodehay igwalyaamaabwa eelhaabwa kasseeh mheeliya. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Yasuuꞌiib usakana kassuuh Suuriyaay ibrar. Uudehay aree abaakiibwa lhanaytwa iibriin kasseeh bariiyooh dehaay haay eeyaan. Baliib lhanayt iibriinwa, jin hooy iifiineebwa, oodhib iibriinwa, yꞌamꞌadhdhaabwa Yasuuꞌa kasseeh mheeliya. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Jaliilee gwida dehay barooh iramna. Timadiina titaminwa, Alguduseewwa, Yahuudaaywa, Urduni dar ooraaw iifiib whaashiiwwa barooh iramna.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Yasuuꞌa oorba reewiyaayt allamiya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Oontꞌa oodehay igwidaab rhiyanihoob, Yasuuꞌa oorba reewiyaayt nꞌati isꞌa. Ikwiriyaatayaah dehaay eeyaan. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Baruuh bareeh allamtiib badooya:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“Libaabiyaan baliin ishuukee aniw,</para>
  <para style="q2" vid="MAT 5:3">tibreeteet hadꞌaayi bareetooh tikati.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Libaabiyaan baliin iwaaween,</para>
  <para style="q2" vid="MAT 5:4">Ukwaasana bareeh shaawti isꞌiikakir indi.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Libaabiyaan baliin imiskiina, baraah toobuut kwasaami iyadna.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Libaabiyaan baliin tushbootii dehaay yꞌitehariigwwa yꞌityawiinwa,</para>
  <para style="q2" vid="MAT 5:6">baraah gabi iyadna.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Libaabiyaan baliin yꞌarhameen,</para>
  <para style="q2" vid="MAT 5:7">baraah rhamaat imaar iyadna.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Libaabiyaan baliin iginꞌaayaahna nhas ikatiineeb,</para>
  <para style="q2" vid="MAT 5:8">baraah Ukwaasana rhi iyadna.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Libaabiyaan baliin mꞌasig ikwasiin,</para>
  <para style="q2" vid="MAT 5:9">Ukwaasanaay ar ituusim iyadna.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Libaabiyaan baliin tushbooti jillaay amaag itweeriin,</para>
  <para style="q2" vid="MAT 5:10">tibreeteet hadꞌaayi bareetooh iikti tindi.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />Libaabtaana baraak, ani sabii, uudehay neeween hookna, amaag iwariin hookna, kastooh toomaag kehookna iyadna. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Midhadhna, afirhaana, win halageen tibreeteeb tibariina. Inabiya suurookna iifiin han bak bareetookna amaag itweeraayna.<verse eid="MAT 5:12" /></para>
  <para style="s">Miilakwa nuurwa</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Baraak whaashi miilakaana. Laakiin umiilak udꞌamooh eetniiweek, malya kak miilak dꞌamiini? Shaawti naat kaꞌanfꞌiya, itoogiid uudehay eeteen.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />Baraakna tuduniyaati nuur tikatiina. Madiinaat ribaay kehii teefeet kitkwibas. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Uudehay lambaat baloolsiit biilii whii kadaasiyaan. Laakiin tageega mhiin daaseena, aree kasseeh oodehay ugawiib daayeen yꞌastini. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Baraak han bak, unuurookna oodehayi suurii buubsaana. Baraah tushbootookna rheen ikatiina, aree Baabookna tibreeteeb eefeeb yhamidna.” idi Yasuuꞌa.<verse eid="MAT 5:16" /></para>
  <para style="s">Muusaay whag</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Yasuuꞌa “Ani Muusaay whagwa inabiyaayi kitabwa anꞌiishi jillaay yꞌaab baahiisaana. Bareeh anꞌiishi jillaay yꞌaab kaaki, laakiin bareeh sidik akwasiyi jillaay yꞌaabi. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Oosdik andi hookna, tuubuutwa taabreewwa kwidheeneeb ookiik, gaal harif han hooy kwidhi kiidi. Gaat galamiit nikwta han hooy kwidhi kitdi. Naatka timmiimtiniyeeb ookiik whaggii naat han kwidhi kitdi. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Teen tiwasi gaat han kantꞌi uutak, wari dehay bak idꞌaneet toona allamiiniibka, tibreeteet hadꞌaayeetiib oodiskaab ituusim indi. Laakiin teen tiwasi haay shagaamiiniib malya aree allamiiniib tibreeteet hadꞌaayeetiib oowin ituusim indi. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Ani andi hookna: tushbootuukna Ifariisiiwwa whaggi koojaawwa hasamti bitdiiyeek, sidik tibreeteet hadꞌaayi shuumi kitdiina.<verse eid="MAT 5:20" /></para>
  <para style="s">Imadar</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Shꞌiiya door oodehay, ‘Baadirna, dehay indiirka haakamami indi.’ diyee timaasiwna. <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Ani andi hookna: oosan sabab anu imhasiibka, haakamami indi. Masi usanii dehaay ‘Baruuk amaagwa’ indiibka, umajlisi suurii waliikami indi. Laakiin ‘Baruuk afraywa’ indiibka, toonꞌi jahannam daayi indi. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Baruuk Wꞌankwanaayt karaama fanrꞌihoob, usanuuk naat gaat kehook ibariyeet toona shꞌaa! <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />Tufirꞌatook tikaraamaati mhiini suurii daasaa. Hankaab difaat usanook afoosamaa, malya mꞌaat tufirꞌatook hiiyya. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />Ugariimiyook tumhakama istoobiyook, willa geeb tugadiyeetook tikwikwa. Masi bariiyooh geeb haayee usalaliib tikwikwa, tari baruuh ugaadi isꞌibik hook indi. Ugaadi aree udaabit nuuni hook indi. Aflaay oosjin han daaseen hook. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Oosdik andi hook: baruuk kasseeh imhallaga neekalt anu kwansiyeeb ookiik itfirꞌa kitdiya.<verse eid="MAT 5:26" /></para>
  <para style="s">Uujkuun</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Baraak suur oodehay, ‘Baajakiinna’ diyee timaasiwna. <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Laakiin ani andi hookna: takat hasiit liiliitii shanbiibka, uginꞌiib jiknaab ikatiyi hasaabu. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Ugwꞌaduuk umaygwadi maagt saksiiniyuuk, hook firꞌaat siisagti gidaa! Kassuuh ugarooyuuk jahannamiib itoogiideet toonaatiika, tarabeemti dehook hanyiis. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Wꞌayuuk umaygwadi maagt saksiiniyuuk, hook kitꞌaat siisagti gidaa! Kassuuh ugarooyuuk nꞌeetiib itoogiideet toonaatiika, tarabeemti dehook hanyiis.<verse eid="MAT 5:30" /></para>
  <para style="s">Ifadag</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />Baraak oodehay, ‘Takatooh fandiig uutakka, fadageet shahaada ibakii iniiw.’ diyee timaasiwna. <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Laakiin ani andi hookna: takatooh amaanaati naawi sabbii nuun, weer sabbii fandiig uutakka, batooh jakiint ikwaasi hasaabu. Takat fiduugiit indꞌiir uutakka, jikuun daayaabu.<verse eid="MAT 5:32" /></para>
  <para style="s">Halafooyt</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Baraak oodehay shꞌiiya door ‘Tehalafooy baakitꞌana, laakiin Wꞌankwanaay halafooteenhoob dehaay daayaana.’ diyee timaasiwna. <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Laakiin ani andi hookna: aslan baahalafooyaana, tibreetee han baahalafooyaana, bataah Ukwaasanaayt hadꞌaayeetii mhiin ikatiin. <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />Tari tubuutii baahalafooyaana, batuuh Ukwaasanaay ragada kehii daasameen. Tari Algudusee baahalafooyaana, batuuh Whadꞌa Oowinnaaytu. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Igirmaayiisookna baahalafooyaana, hamoot gaat hadalt tari eeraat han tidꞌaneet toona kaꞌadgirtaana. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Aflaay, ‘Daayiitu tari amaagtu’ diina, weena tiyadneek maagtii iiktiin iyadna.<verse eid="MAT 5:37" /></para>
  <para style="s">Wꞌillaatti</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Baraak oodehay ‘Tuliili liiliit, tookwiri kwireet’ diyee timaasiwna. <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Laakiin ani andi hookna: maag tak baaꞌamootaara. Udaraag umaygwadiib hook inthꞌi ootak, udaraag ooraaw han dehaay naksaa. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Ugamiisook hook hariwtiit tumhakama istoobiyuuk, tusideeriyaaytook han dehaay isha dꞌiyaa. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Gaal akriree saaꞌaat sagi mhiin hiireerisiiniyuuk, maloot saaꞌaateet masaafa geeb giigaa. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Naat hook harriiw ootak hiiyya, silift hook yharriiw ootak aree baaꞌagiira.<verse eid="MAT 5:42" /></para>
  <para style="s">Yꞌashooyeekna areeyaana</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />Baraak suur oodehay, ‘Ushawawook areeya, wꞌashooyook riba.’ diyee timaasiwna. <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Laakiin ani andi hookna: yꞌashooyeekna areeyaana, wꞌinꞌiitookna deharna, wꞌinriibookna dehaay shiboobna. Toomaag iweeryookna aree dehaay siileelaana. <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Shaawti Baabiyeekna ar tibreeteeb tikatiina. Baruuh oodehay wꞌamaagwa udaayiibwa kasseeh tooyin dehaay talawsiini. Maag dehaywa shibi dehaywa kasseeh aree oobri dehaay bireesiini. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Oodehay wꞌareeyiiniyookna areeteeneek, naan rayiimi tiyadna? Tilbaat tamana han bak kasakiyaana han? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Isanaayeekna eebhat aree salaamteeneek, oodehay iraweeka naan gwilakabaana? Uudehay oodiin baabari han bak kiidꞌiin han? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Baabuukna tibreeteeb eefi timmiimaabu, baraak han timmiimaana.” idi Yasuuꞌa.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Yꞌaniw hiina</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Yasuuꞌa “Tudaayiinaayti shagaayookna oodehayi suurii baadꞌiina! Digwagwna oodehay baarhamaana. Een tiwariineek, Baabookna tibreeteeb eefeenaay ijir imaar kitdiina. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Aflaay oodehay yꞌaniw tiniiwihoob, oodehay tageegsi baasooyaa! Uudehay wharaay ar Iyahuudi diini gawiibwa isalalaayeebwa idꞌaneet toona, baraah dehayi hamooysiti yhariwna. Oosdik andi hookna: baraah wꞌijroohna timmiima ahaaba. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Laakiin baruuk oodehay yꞌaniw tiniiwihoob, wꞌayuuk umaykwaab iniiweet toona, wꞌayook utalhaab baasookiina! <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Shaawti umiyaawook kwibisa. Malya Baabuukna toona tukwabaas rhiiniib, ijir iyaaw hook indi.<verse eid="MAT 6:4" /></para>
  <para style="s">Toosileel</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Sileeltiniyihoob, oodehay wharaay ar tꞌiiteeb baaꞌakaa! Baraah Iyahuudi diini gawiib gadee siileeltiib areeyeena, isalalaayi rikwinaayeeb oodehayi rhamti yhariwna. Oosdik andi hookna: baraah wꞌijroohna timmiima ahaaba. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Laakiin baruuk siileeltiniyihoob, ugawook shuumaa, udheefa assaat Baabiyookna dehaay siileelaa! Baruuh baalawayu. Malya Baabuukna toona tukwabaas rhiiniib, ijir iyaaw hook indi. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Aree siileelteenihoob, Ijintiileet baajawaana. Baraah igwida bhaliiyeesoohna itmassiiwneeb hiiseen. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Baraak bareeh tꞌiiteeb baaꞌakeena, Baabuukna baraakna baaraatamay toona tehariwneet ikteen.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />Bak aree siileelteeneet toonaatu:</para>
  <para style="q1" vid="MAT 6:9">Baabuun tibreeteeb eefeeb,</para>
  <para style="q1" vid="MAT 6:9">uusmuuk hamooysamaab baꞌiikti,<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Tehadꞌaayeetuuk baꞌeeti,</para>
  <para style="q" vid="MAT 6:10">baruuk harriiweet tuuna tubuutiib batiikti, tibreeteeb tꞌiiteenaayt,<verse eid="MAT 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MAT 6:11" />amsi oombꞌi yhadhiyeen hiiyya hoon.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Tumaagnaaytoon afooyaa hoon,</para>
  <para style="q2" vid="MAT 6:12">hinin han toomaag hoon sakeen afoona.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Jarrabamtiib baashuumsaa hoon,</para>
  <para style="q1" vid="MAT 6:13">laakiin wꞌamaag oongaal hooy shidhhana hoon.<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Uudehay toomaag hookna idꞌanihoob afooteeneek, Baabuukna tibreeteeb eefi han afooyiini hookna. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Laakiin udehayiit maagnaay bitꞌafooyayneek, Baabuukna han tumaagnaaytookna afooyi hookna kiidi.<verse eid="MAT 6:15" /></para>
  <para style="s">Tubaaski</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Baraak baaskiiteenihoob, wharaay ar idꞌaneet tunaatiit hamash fiireeb baaꞌakeena. Baraah oodehay tubaaskiitoohna rhistiib yhariwna akay eefiir hamashooyaab ikwasiin. Oosdik andi hookna: baraah wꞌijroohna timmiima ahaaba. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Laakiin baraak baaskiiteenihoob, tehamooteekna lꞌasaana, ifiireekna aree shigwidhna. <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />Aflaay baraak baaskiitiib tikatiineet toona uudehay iikan kiidiin. Laakiin Baabookna Oongaalnaay dehaay baaskiitaana. Baabuukna ubaalaway, aree Baabuukna toona tukwabaas rhiiniib, ijir iyaaw hookna indi.<verse eid="MAT 6:18" /></para>
  <para style="s">Oomraay tibreeteeb</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Igarooyeekna dehaay tubuutiib miraay baadibiina, dꞌoobwa buutwa tamtini. Gwihara aree kitꞌatiit eegwihariin. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Laakiin baraak miraay tibreeteeb dehookna dibiina. Beentooy dꞌoobwa buutwa katamiyaana, gwihara han kitꞌatiit kiigwiharna. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Umraayuukna daayiiniyeeb oomhiin, iginꞌaayaakna han daayeen. <verse eid="MAT 6:21" /><verse number="22" style="v" sid="MAT 6:22" />Tuliili ugarooyt lambaatu. Tiliiliyaataakna daayiit ikatiineek, kassuuh ugarooyuukna nuur iittab indi. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Laakiin tiliiliyaataakna amagt ikatiineek, kassuuh ugarooyuukna thibin iittab indi. Shaawti uunuur geebookna thibin ikatiyeek, been uuthibin kak win ikati! <verse eid="MAT 6:23" /><verse number="24" style="v" sid="MAT 6:24" />Gaal kishiya malu ankwana kashagaamiya. Baruuh tari gaal areeyi indi, tari ooraaw aree iirib indi. Tari oongaal daayiib shagaamiini, ooraaw aree abaabiini. Ukwaasanaawwa imhallagaawwa mhalleehna hiddaab shagaamtiib kaꞌadgirtaana.<verse eid="MAT 6:24" /></para>
  <para style="s">Baahasiikna</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Oontꞌaaneet ani andi hookna: ukwiraayiisookna baahasiikna, naan tamteeneeb tari gwꞌiteeneeb tari igarooyeekna naan teetkwiineeb baahasiikna. Umidhhan tumꞌariitiika daayikaab kiiki han? Ugaru aree yhalakaayeeka daayikaab kiiki han? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Eekilay tibreeteeb dhaabeen shibibna, baraah kateeraayaana, kiiwikna, tari geesaay harroob kiidibilna, masi Baabuukna tibreeteeb eefi bareeh tamsiini. Baraakna bareesoohka alyakaab kitteena han? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Aaw bareesookna hansiikihoob umidhhaniyooh saaꞌaat gaat eeshiwi? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />Aree halakaayee naanhooy tehasikna? Umingaayi hindi idaawriib shibibna kak yakeena. Baraah kashagaamiyaana tari igarooyeehna kiisitookwna. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Masi ani andi hookna: Suleemaan kassooh ugibliisooh een yhindiyeet akwaay kiiki. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Ukwaasana umingaayi siyaam bak istookwiyeek, amsi tooy haayee, tulhaytooh nꞌeetiib itoogiideek, baruuh bareek daayikaab istuukw hookna kiidi han? Wooh baraakna ishalik iimaani! <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Shaawti baahasiikna, ‘Naan tamnay? Tari naan gwꞌinay? Tari naan neetkwi?’ baadiina. <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Uudehay diin baabariin kasteeh teen tinaati harꞌii dhaabeen. Baabuukna tibreeteeb eefi aree bareeh tehariwneet toona ikteen. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Laakiin hankaab bariitooh tehadꞌaayi hariwna, bariitooh tooshbu hariwna. Teen teena kasteeh aree imaar tiyadna. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Aflaay lhayt iikti tindiit toona haay baahasiikna, batuuh tuukna tehisik tindi. Bꞌeebka ooknaay gwirha mhaab ibari.” idi Yasuuꞌa.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Oodehay uraawi haakamti</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Yasuuꞌa “Baahaakamaana, tari baraak han haakamamteena. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Oodehay ooraaw haakamteeneet tehayꞌaatiit, baraak han oontꞌaaneet haakamami tiyadna. Wꞌabaar haay tiyawneeb, haay ittiyiw tiyadna.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />Naanhooy tehakwa uraawiyook ugwꞌadiib shanbiiba, bariiyook ugwꞌadiib itragiig ukwoolay karhita han? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Baruuk usaniyook dehaay, ‘Tehakwa hook firꞌat.’ kak tindiya? Barook kassooh oodoor ukwoolay ugwꞌadiyook itragiigeek? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Baruuk haraay oorwa, hankaab ukwoolay ugwꞌadiisook firꞌaat malya daayiib rhitniyihoob, tehakwa usaniyook ugwꞌadii firꞌaa.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />Wꞌankwanaayt mugaddasna eeyas baahiina. Ijawharaayeekna ikhansir baahiina. Een tiwariineek, baraah bareeh iragadaayi whii eeteena, malya bareeyookna nakameetiit katꞌi hookna iyadna.<verse eid="MAT 7:6" /></para>
  <para style="s">Raataana, hariwna, kadhawsaana</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Raataana, aree beet toona ittiyiw tiyadna. Hariwna, aree imaar tiyadna. Udheefa kwilna aree baruuh dehookna itnigil indi. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Raatiiniibka iniin. Harriiwka marri. Aree udheefa inkwiilka baruuh dehaay itnigil indi.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />Bareesookna wꞌooruuh hadhiib raatiiniyihoob, aweeb iniiw aabu? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Tari aashoob raatiiniyihoob, kwakwar iniiw aabu? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Aree bareekna tikatiineek, baraakna yꞌamag, yꞌareekna kak daayiina tiyawneeb tikteenna. Aflaay Baabuukna tibreeteeb eefi, oodehay barooh daayiinayt raateen kak winneet gwidaana iyaaw indi! <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Aflaay kastooh tunaatiibka, uudehay dehookna dꞌuuy hooy tehariwneet toona, baraak han dehaay dꞌiina. Uun aree Muusaay whagwa inabiyaayi tꞌaliimwa kassooh ikati.<verse eid="MAT 7:12" /></para>
  <para style="s">Udheefa umarꞌaawwa wꞌadehaawwa</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Udheefa wꞌadehaanaay shuumaana. Udheefa umarꞌalooy toonꞌi istoobi salalu, aree gwida dehay haay hasameen. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Laakiin udheefa uudis adeha salal umidhhan istoobiibu, aree shalik dehay aabhat barooh imeerna.<verse eid="MAT 7:14" /></para>
  <para style="s">Whindiiwwa ifraayuuswa</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Gwisri nabiyaayee digwagwna. Baraah ganay tꞌiiteeb akay yꞌeen hookna, laakiin baraah tehooytee kwakwaraaba. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Bareeh ishanhiisoohna iikan tiyadna. Uudehay naweetee inab lakkateen han? Tari kitirii tiin lakkatamiini han? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Oontꞌaaneet whindi udaayi daayi firaay fanri, laakiin whindi wꞌamaag amaag firaay fanri. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Whindi udaayi amaag firaay kiifiri. Whindi wꞌamaag aree daayi firaay kiifiri. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Whindi daayi firaay baafariib ugadamii kitꞌatiit nꞌeetiib itoogiid. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Aflaay bareeh han ishanhiisoohna iikan tiyadna.<verse eid="MAT 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />Anii dehaay ‘Wꞌankwana, Wꞌankwana,’ indiibka kassaah tibreeteet hadꞌaayi shuumi kiidiin. Laakiin Baabu tibreeteeb eefi harriiweet toona sakiiniib uubhaat shuumi indi. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Been oombꞌi gwida dehay, ‘Wꞌankwana, Wꞌankwana, bariiyook oosmii Ukwaasanaay ibhali soona, bariiyook oosmii eejin nifarꞌa, bariiyook oosmii aree gwidaat mꞌuujisa nikwaas.’ iyadnaheeb. <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Malya ani bareeh oosdik sooyani, ‘Kaakan hookna hoosu giigaana, baraak maagti kinaabaana.’ andi.<verse eid="MAT 7:23" /></para>
  <para style="s">Idꞌaariiga ifagaraawwa yꞌafrayaawwa</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Een aniib ibhali eemsiiw kassaah, malya na haay shagaameen, ootak ufagar ugawooh liilaawi kehii idꞌir tꞌiiteeba. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Uubri iyaamiit uukwaan asti eeya, ubaraam oogaw infiyihoob, uugaw liilaawi kehii daamaabuuyt dhibaab kiiki. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Laakiin aniib ibhali maasiwtiit malya na haay baashagaamayka, ootak wꞌafrii ugawooh isseeteeb idꞌir tꞌiiteeba. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Uubri iyaamihoob, uukwaan asti eeya, ubaraam oogaw infiyihoob, uugaw winneet dhibiyaayt itirhaagw.” idi Yasuuꞌa.<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Yasuuꞌa teen teena idiit faayisiyanihoob, uudehay bariiyooh wꞌallamtiib ajjabamiyaan. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Baruuh tehadꞌaayi ibariib gaal tꞌiiteena teen teena allami akay, aree whaggi koojaayeehna tꞌiiteeb kiiki.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Yasuuꞌa tak bhadh iibriib mheeliya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Yasuuꞌa oorbaay darii nꞌati tikwiyanihoob, gwida dehay barooh imooraamna. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Tak bhadh iibriib bariiyooh dehaay eeyaayt whii ignaf malya, “Wꞌankwanaay, sinhasaheeb, harriiweek sinhasooyti adgirtiniya.” idi.<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Yasuuꞌa wꞌayooh ibriraayt ootaki kehii daasiyaayt, “Aharriiw, nhas akaa!” idi. Igidiyeesooh uubhadh ootakii giigiya aree baruuh inꞌir <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Malya Yasuuꞌa ootakii dehaay, “Toon toona tak han baasooyaa, laakiin ugarooyook ufagiiri rhisaa, aree Muusa sooyaab iiktiyeeb oomiyaaw firꞌa. Malya baraah baruuk tinꞌireet toona iikan iyadna.” idi.<verse eid="MAT 8:4" /></para>
  <para style="s">Yasuuꞌa Roomaani daabti kishiya mheeliya</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Yasuuꞌa Kafarnaahuum shuumiyanihoob, Roomaani daabit dehaay eeyaayt, shamaamt hooy yhariw, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />“Seedna, ukishiyaayu amꞌadhdhaabu, ugawiib bꞌiini aree winneet lhaabu.” idi. <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Yasuuꞌa bariiyooh dehaay, “Ani diftiit barooh mheeli andi.” idi.<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Udaabit “Wꞌankwanaay, baruuk aniib ugawiib ishuumti kaꞌastehalan. Laakiin gaat kalma diyaa, shaawti ukishiyaayu iinꞌir indi. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Ani uknaayu hadꞌaayeeti whii shagaamani taku, aree kajar anii whii shagaameen abari. Oon barooh sooyiit ‘Difaa!’ andiyeek indiif. Been barooh aree ‘Mꞌaa’ andiyeek yꞌiini. Ukishiyaayu ‘Toon sakaa!’ andiyeek sakiini.” idi.<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Yasuuꞌa een ibhali imaasiwihoob, ajjabamiyaayt barooh iitram oodehayii dehaay, “Oosdik andi hookna: Israaꞌiileeb bak win iimaan iibriib gaal han miraab kaaki. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Toon toona aree andi hookna: gwida dehay uyintalawiiwwa uyindhibiiwwa yꞌi iyadna, Ibraahiimi geeb iistꞌa iyadna, Isehaagi geebwa, Yaaguubi geebwa, tibreeteet hadꞌaayeetiib firhiib iistꞌa iyadna. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Laakiin tehadꞌaayi shuumeen ikatiin baliin barraab uthibniib ituugid iyadna. Beentooy waawi iyadna, lhamiit tikwileeteehna ishuuthithꞌa iyadna.” idi.<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Malya Yasuuꞌa udaabtii dehaay, “Difaa! Oontꞌaaneet baruuk aamantaneet tunaatiit iikti tindi.” idi. Aree ukishiyaayuuh beet toosꞌa tookna inꞌir.<verse eid="MAT 8:13" /></para>
  <para style="s">Yasuuꞌa gwida dehay mheeliya</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Yasuuꞌa Bitrusiib oogaw eeyanihoob, Bitrus tehamtuuh abaakiyaa nꞌaaliib bꞌee rhiya.<verse eid="MAT 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 8:15" />Yasuuꞌa batooh wꞌayi yꞌabikihoob, yꞌabaaki hooy giigiyaan. Batuuh asti yaktaayt bareeh shagaamta.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Whawaad eeyanihoob, gwida dehay jin hooy iifiineeb bariiyooh dehaay haay eeyaan. Baruuh eejin kalmaatii hooy ifirꞌat, aree kasseeh eelhaab mheeliya. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Tuun tuuna Unabi Isyaasi geebii hadiidamaat toona sidik tiikwsi:</para>
  <para style="q1" vid="MAT 8:17">“Baruuh udehayoon eelhaab isikw iyhi,</para>
  <para style="q2" vid="MAT 8:17">aree tilhanayteen ifyak” diyaabi.<verse eid="MAT 8:17" /></para>
  <para style="s">Uudehay Yasuuꞌi harꞌii sakti yhariwna</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Yasuuꞌa oodehay igwidaab udarooh rhiyanihoob, oobhar oodar ooraaw beeti ikatꞌaneet toona sooya. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Malya haggi kooja gaal bariiyooh dehaay eeyaayt, “Seedna, baruuk teebiyi mhiinka iitram hook andi.” idi.<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Yasuuꞌa igwibi, “Tibꞌashu deeb ibariina, aakilay tibreeteeb dhaabeen gawaab ibariin. Laakiin Wꞌaadami Oor ugirmaayooh hooy shuumsiiniyi mhiin kiibari.” idi.<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Weer kwiriyaataayi bariiyooh dehaay, “Wꞌankwanaay, hankaab diftiit baabu ayaabuuyt iibis andi, wꞌidin hiiyyaheeb.” idi.<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Laakiin Yasuuꞌa bariiyooh dehaay, “Ramaheeb, yꞌaya udehayoohna yꞌayaab aakna baꞌiibisna.” idi.<verse eid="MAT 8:22" /></para>
  <para style="s">Yasuuꞌa ubaraam isingad</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Malya tufalluuka yꞌam, ikwiriyaatayaah han iramna. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Gaalhoob akra baraam oobhariib eeya. Aflaay uumooj tufalluuka oomamiya. Laakiin Yasuuꞌa diwi. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Ikwiriyaatay giigiyaaniit barooh isibꞌarna, “Wꞌankwana, shidhhana hoon! Aayam iyaay hoon iyadna.” idiin.<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Yasuuꞌa igwibi, “Baraak ishalik iimaani, naanhooy tirkwiina?” idi. Malya asti yakiyaayt ubaraamwa oomoojwa idaanin shaawti baraah ingadna.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Uudehay ajjabamiyaaniit raatiyaana, “Uun kak eefi taku? Ubaraamwa uumoojwa han barooh isnaakiirna!” idiin.<verse eid="MAT 8:27" /></para>
  <para style="s">Yasuuꞌa malu da jin hooy ifrꞌa</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Baruuh oobhar oodar ooraaw Gadareeni haash iktimihoob, malu da jin hooy iifiineeb miimashaayee yꞌee barooh imriin. Baraah winneet ribshaayt iikwsiinayt, uudehay gaal han been usalalii kasakiyaan. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Aanda aadhiyaaniit, “Ukwaasanaay Oor, naan hoon harriiwa? Uudoor wꞌattiyoodiyaab yꞌaab baakaay tooy hini lhastii dehaay eeta han?” idiin.<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Bareesooh sagi mhiin gwida khansir ikwiir iifiin. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Aajin Yasuuꞌaab inꞌalna, “Iifirꞌa hoon tindiyeek, ikhansir shuumsaa hoon.” idiin.<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Baruuh bareeyooh dehaay, “Difna” idi. Aajin ifirꞌaniit ikhansireeb shuumiyaan. Ikhansir kassaah oorbaay nꞌati dhaabiyaaniit ubhariib dhibiyaan, malya iiyaan. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Baliin ikhansir iishkwiin aanda dhaabiyaaniit tumadiina ibeen. Kastooh toona aree oodehay sooyaan. Aajin hooy iifiineeb eenda han naan dehaay tikayeeb kastooh oodehay sooyaan. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Malya kastuuh tumadiinaati dehay ifirꞌaniit Yasuuꞌi ashuush yhariwna. Aree barooh rhiyaanihoob, whaashiisoohna giigiiniyeet toona bariiyooh yhariwna.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Yasuuꞌa tak garbamaab mheelya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Yasuuꞌa falluukaati kehii yꞌamt, oobhar ikitꞌa aree tumadiinaatooh tookna eeya. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Daab gali amꞌadhdha tak bꞌadhiib bꞌee bariiyooh dehaay haay eeyaan. Yasuuꞌa bareeh wꞌiimaanoohna rhiyanihoob, ootak ugarbamaanaay dehaay, “Wꞌooruun baahasiika! Timaagnaytaak afoomaata.” idi.<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Malya whaggi kooja gwadi igarooyeehna dehaay, “Uun uutak kifuuri bhali hadiidiini!” idiin.<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Yasuuꞌa baraah iikwinneet toona iktiinayt, “Naanhooy iginꞌaayeekna maagt teekwinna? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Naan laamakaatu ‘Tumaagnaaytuuk afoomaatu’ uumiyaad laamakaabu han, tari ‘Yakaat difaa!’ uumiyaad laamakaabu? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Laakiin Wꞌaadami Oor tubuuti kehii timaagnay haay afooyiiniyeet hadꞌaayi ibariyeet toona shaawti tikteenna.” idi. Malya ootak ugarbamaanaay dehaay, “Yakaa! Umbꞌadhook yaksaat ugawook bayaa!” idi. <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Uutak yakiyaayt ugawooh ibi. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Uudehay igwida toon toona rhiyaanihoob, baraah irkwiin. Ukwaasana bak tꞌiiteet hadꞌaayi oodehay yhiiyyeet toonaati sabbii yhamidna.<verse eid="MAT 9:8" /></para>
  <para style="s">Yasuuꞌa Mattaab waliikiya</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Yasuuꞌa beentooysii giigiyanihoob, Mattaab iidni tak tilbaat lakkatanaab maktabiyooh sꞌee rhiya. Baruuh bariiyooh dehaay, “Ramaheeb!” idi. Matta asti yakiyaayt barooh iram.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Yasuuꞌa Mattaay ugawiib mꞌariit tamee, gwida tilbaat lakkatanaawwa, maagti dehaywa, eeyaaniit bariiyooh geeb tamiyaan. Ikwiriyaatayaah han geeb tamiyaan. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Ifariisi toon toona rhiyaanihoob, ikwiriyaatay sakanaayaana, “Ukoojaayuukna naanhooy itilbaat lakkatanaawwa maagti dehayi geebwa mꞌariit tamiini?” idiin.<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Yasuuꞌa een ibhali imaasiwihoob, “Uudehay udalha hakiimii dehaay kiishinhana, eelhaab nuun. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Difnaat een ibhali naamiyaad ikatiineeb afhamaana, ‘Ani rhamaat aharriiw, karaamaat kaahariw.’ idi. Maagti dehayi waliikti jillaay yꞌaabu nuun, oodehay eeshboonaayi waliikti jillaay yꞌaab kaaki.” idi.<verse eid="MAT 9:13" /></para>
  <para style="s">Yasuuꞌa tubaaskiitii raatamamiya</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Malya Yuuhannaay ikwiriyaatay eeyaaniit Yasuuꞌaab raatiyaana, “Hininwa Ifariisiiwwa baaskiitnay, laakiin ikwiriyaatayaak kak kabaaskiitiyaan?” idiin.<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yasuuꞌa igwibi, “Udoobaay yꞌamna baruuh geeb masi haayee kak gadabeen? Bareeh udooba hooy yakamiiniyi door yꞌi indi. Malya baaskiiti iyadna.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />Gayi halaki kehii shꞌiiyaat silhaayt hanyiid tak kiihaay. Tusilhaay whalak katꞌitni, uumhiin ushataat winkaab ikati. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Tak aat gayiit, hamiit aateeb kiishaaw. Een tiwariyeek, tehawat thawtini, tiyꞌa han eetfiifna, tehawata han katꞌameen. Laakiin aat gayiit, gayiit hawatiib danꞌiyihoob, mhallaahna itdabiina.” idi.<verse eid="MAT 9:17" /></para>
  <para style="s">Ayaat ootwa lhaat takatwa</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Yasuuꞌa een ibhali diyee, daabit gaal dehaay eeyaayt bariiyooh whii ignaf, “Tꞌootu hallaay tiya. Laakiin mꞌaat wꞌayook kehii daasaa, batuuh shaawti iidhhan tindi.” idi. <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Yasuuꞌa yakiyaayt bariiyooh geeb giigiya, aree ikwiriyaatayaah han iramna.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Been oodoor takat tamna malu hawlaayeeka booy tiitfaf eetaayt, bariiyooh harꞌii tingad. Malya bariiyooh whalakiit shinki tehita. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Batuuh ugarooyooh dehaay, “Ani bariiyooh whalak ookna tehaniyeek iinꞌir andi.” tidi.<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Yasuuꞌa batiiyooh nakamiyaayt, “Tꞌootuun biihasiiki! Wꞌiimaanuuk mheeliya hook.” idi. Tutakat shaawti been oodoor ookna tinꞌir.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Yasuuꞌa udaabti gaw shuumiyanihoob, gwida dehay waawiinwa nawwaatiinwa imri. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Yasuuꞌa oodehayii dehaay, “Baraak hooy giigaana, tꞌoor ayaat kitti diwtini.” idi. Laakiin uudehay ifaayidna. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Uudehay ugawii ifirꞌanihoob, baruuh shuumiyaayt tꞌooti ayi yꞌabikihoob, batuuh asti yakta. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Uun usakana kassooh whaashiib ibrar.<verse eid="MAT 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yasuuꞌa beentooysii giigiyanihoob, malu hamashaya da barooh imooraamniit waliikiyaana, “Daawidi Oor, dehoon nꞌakwmanaaya.” idiin.<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Yasuuꞌa oogaw shuumiyanihoob, aanda yhamashaya bariiyooh dehaay eeyaan. Baruuh bareeh raatiya, “Ani toon toona sakaniyeet toona aamanteena?” idi.</para>
  <para style="p" vid="MAT 9:28">Baraah “Awooh Wꞌankwanaay.” idiin.<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Malya Yasuuꞌa bareeyeehna eegwꞌad tehiyaayt, “Baraak aamantaanayt, tuun batiikti.” idi. <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Aanda shaawti rhiyaan. Yasuuꞌa bareeh winneet sooya, “Toon toona gaal han baasooyaana.” idi. <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Laakiin baraah giigiyaaniit oon usakana ubariiyooh kassooh whaashiib ibrirna.<verse eid="MAT 9:31" /></para>
  <para style="s">Yasuuꞌa tak gilluusiib mheeliya</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Baraah itfirꞌanihoob, tak jin hooy iifiineeb gilluusiib bariiyooh dehaay haay eeyaan. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Yasuuꞌa ootak eejin hooy ifirꞌihoob, shaawti hadiidiya. Uudehay igwida winneet ajjabamiyaaniit, “Israaꞌiileeb toon toona tꞌiiteet door han akaat kitti.” idiin.<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Laakiin Ifariisi, “Baruuh ijini hadꞌaayee, eejin mhaliini.” idiin.<verse eid="MAT 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yasuuꞌa kasteeh tigariyaateebwa timadiinaateebwa hiireeriyaayt, Iyahuudi diini gawaayeeb allami. Tehadꞌaayeeti usakana udaayiib bhaliiyi, aree oodehay tilhanaywa igwirhaawwa iibriin kasseeh mheeli. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Yasuuꞌa oodehay igwidaab rhiyanihoob, winneet dehaay nꞌakwmanaaya. Bareeh nꞌati taar hooy daayaabu, aree shamaamt kiibariina, ooreew ishakwa baabariib tꞌiiteeb akay rhiyaneet toonaatii dehaay nꞌakwmanaaya. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Malya baruuh ikwiriyaatayeeh dehaay, “Uuwaak gwidaabu, laakiin ishagaamana shalika. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Toon toonaatii dehaay uwaaki Ankwana raataana, uwaakiit dirꞌaatooh shagaamanaab dehaay diigwatiiniyeet toona raataana.” idi.<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Yasuuꞌa itamna malu diigwatiya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Yasuuꞌa ikwiriyaatayeeh itamna malu waliikiyaayt, eejin haay isfarꞌaneet hadꞌaayi bareeh yhii. Tilhanaywa igwalyaawwa kasseeh haay mheeleeneet hadꞌaayi yhii.<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />Aan baraah ilinguuma itamna malooyi sima ikatiina: hankaab Siimoon, Bitrus atoosmaabwa oosan Andaraawooswa, Yaaguub Sabadi oorwa, oosan Yuuhannaawwa, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Fiilibuswa, Baartulamaawooswa, Toomaaswa, Mattaab utilbaat lakkatanaawwa, Yaaguub Alfaaꞌiyoosi oorwa, Taddaawooswa, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Siimoon Ufaariswa, Yahuuda Iskaaryuuti barooh itilwa iiktiin.<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Een itamna malu Yasuuꞌa een ibhali sooyaayt giigisiya, “Ijintiili bitik baahiireeraana, tari Saamiraayeet madiina han baashuumaana. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Laakiin Israaꞌiileeb yꞌargina ikwidhaab beena. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Giigteenihoob, toon tudiigwat bhaliiyaana, ‘Tibreeteet hadꞌaayi dawiltu.’ diina! <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Oodehay eelhaab mheelaana, yꞌayaab shidhhanna, oobhadh ibariin sinhasna, eejin firꞌana. Balaashii tiyheena akay baraak han balaashii hiina. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Ijiibaayeekna dimꞌaraab geebookna baayaksaana, ashteet baayaksaana, tari baloob baayaksaana. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Tꞌiibaabtii dehaay shantaat baayaksaana, tari malu halaka baayaksaana, gidhꞌaat baayaksaana, kwoolay baayaksaana. Ishagaamana teena tiyhariwneet imeerneet toonaati.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />Madiinaat tari dhiwaab shuumteenihoob, beentooy takweet ibari tak hariwna, giigteeneeb ookiik aree bariiyooh ugawiib sꞌana. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Oogaw shuumteenihoob, dabaay salaamaana. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Uugaw astehaliiniyeek umꞌasguukna kehii badaayi. Biiꞌastehalayeek, umꞌasguukna dehookna itꞌagiir ikati. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Daayiib baaꞌashiishookna ootak, tari ibhalyeekna baasinaakiir ootak, oogaw tari tumadiina hooy giigteenihoob, iragadaayeekna falfuut dehaay nifꞌana. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Oosdik andi hookna: whukwim ikatiyeet tooyin beet tumadiinaatiika Sadoomwa Gamooraaywa uudehay laamaka jasa dehaay iikti indi.<verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Ani bareek yꞌargina ikarayi bitik eefeen tꞌiiteeb akay giigsani hookna. Aflaay ikwakwaraayeet nabꞌa ginꞌaayeeb akeena, aree ikwibheeriyaayeet asgaab akeena.<verse eid="MAT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17" />Udehayii digwagwna, baraah whaashi suurkina nuuni hookna iyadna. Iyahuudi diini gawaayeeb aree iithibꞌa hookna iyadna. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Anii sabbii yhaakmaawwa yhadꞌaayi suuriiwwa haay yꞌi hookna iyadna. Bareehwa Ijintiiliiwwa kehii badehiib tikatiini jillaay haay yꞌi hookna iyadna. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Laakiin baraah yꞌabikneeyookna oodoor baraak naan tiyadneeb tari kak tiyadneeb haay baahasiikna. Been oodoor naan tiyadneeb ittiyiw tiyadna. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Been oodoor yhadiideen bareek kitteena. Laakiin Baabiyaakna Aashuuk hadiideen.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />Been oodoor uusan usanooh isoodiir, ubaaba wꞌoorooh, yꞌar ibaaba ashoosami iyadna, malya isuudir iyadna. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Anii sabbii uudehay kassaah iirib hookna iyadna. Laakiin wꞌagiya ookiik akirti ingadiib uutak iidhhan indi. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Mhiin gaalnaay amaag iwariinuukna weer haash beeti dhaabaana. Oosdik andi hookna: Wꞌaadami Oor baayꞌi baraak Israaꞌiileet timadiinaati bitik whiireerti faaysi kitdiina.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Ukwiriyaataayi ukoojaayiisoohka fagarkaab kiiki. Ukishiya han wꞌankwanaayiisoohka fagarkaab kiiki. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Ukwiriyaataayi ukoojaayooh nadiir ikatiyeet tuuna mhatni. Ukishiya han wꞌankwanaayooh nadiir ikatiyeet tuuna mhatni. Ugawi weeli Baꞌalsabuul ittiyoodiyeek, aree indhiwaayaah kina kak amaagkaab ituusim iyadna!<verse eid="MAT 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />Aflaay bareeh baarakwiina. Kwabaasna baalawayt kitehaay, tari dhꞌimaana atookkaani baadiit kitehaay. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Ani uthibniib sooyaniyeetookna toona, baraak oombꞌi bhaliiyaana. Yꞌangwileeyookna hadiidamtiniit toona igawaayi kehii sooyaana. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Baliib ubashar eedir baarakwiina, baraah ubashar eedirna nuun eeshuuk kiidirna. Laakiin Oongaal ubasharwa eeshuukwa mhalleeh toonꞌi danꞌiib rikwiina. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Malu kilay dabalooyaab malu girshaayee itdaliibna. Laakiin Baabuukna biihariiweek, gaal han bareesooh whaashi kehii dhibi kiidi. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Igirmaayiitaakna tehamu han taakna atdhagwgwiyaata. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Aflaay baarakwiina, baraak gwida kilayeeka alyakaabaana.<verse eid="MAT 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />Udehayi suurii aniib bhaliiyiiniibka, ani tibreeteeb Baabiyu suurii haay bhaliiyi andi. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Laakiin udehayi suurii aneeb ittawiibka, ani han Baabiyu suurii tibreeteeb barooh ittiw andi.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Ani toobuuti kehii mꞌasig akwasiyi jillaay yꞌaab baahiisaana. Ani mꞌasig akwasiyi jillaay yꞌaab kaaki. Laakiin bꞌadhdhi jillaay yꞌaabi. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Ani khilaaf akwasiyi jillaay yꞌaabu,</para>
  <para style="q1" vid="MAT 10:35">wꞌoorwa ubaabaawwa,</para>
  <para style="q2" vid="MAT 10:35">tꞌoorwa toondeewwa,</para>
  <para style="q1" vid="MAT 10:35">tudoobaawwa tehamtoohwa, eebtik khilaaf akwasiyi jillaay yꞌaabi.<verse eid="MAT 10:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36" />Ootak yꞌayaydaah ashoosami iyadna.<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />Baabooh tari deetooh aniika gwidakaab areeyiiniibka, anii geeb takweet kiibari. Wꞌoorooh tari tꞌootooh aniika gwidaka reer areeyiiniibka, anii geeb takweet kiibari. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Aree usaliibooh yakseetiit aneeb baaraam uutakka, anii geeb takweet kiibari. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Umidhhanooh manriibka kwidhsi indi, anii jillaay umidhhanooh kwidhsiiniibka aree midhhan imaar indi.<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />Bareek agbiliiniibka aneeb han agbiliini. Aneeb agbiliiniib aree aneeb diigwatiyaab han barooh agbiliini. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Unabi nabiib ikatiyi sabbii anshiishka, unabii ijir imaar indi. Ootak ooshboob shibooti jillaay anshiishka, shibu takii ijir imaar indi. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Een bareeh idabalooyaayeeb gaal, anii kwiriyaataayi ikatiyi sabbii lꞌa yameet kwibbaayi han gwꞌasiiniib, oosdik andi hookna, baruuh wꞌijrooh iitnaw kiidi.” idi.<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Yasuuꞌaawwa Yuuhannaay imoosanaawwa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Yasuuꞌa ikwiriyaatayeeh itamna malu sooyaayt harꞌii, beentooysii giigiya. Aree Jaliileet madiinaateeb allamiyi jillaay giigiya.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Yuuhanna Umasiih iidꞌeet toona imaasiwihoob, ikwiriyaatayeeh diigwatiya. <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />Yuuhanna barooh sakanaatiib isehariw, “Baruuk uyꞌiiniibwa han weer nhagit?” idi.<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Yasuuꞌa dehaay idgi, “Agarnaat toona turhitaaneetwa tutimaasiwneetwa Yuuhannaab sooyaana. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Yhamashaya rheena, igarbama hiireereena, oobhadh ibariin eenꞌirna. Yꞌangwilaya eemsiiwna, yꞌaya eedhhaniina, aree usakana udaayi oodehay imiskiinaayee dehaay bhaliimiini. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Libaabiyaan baliin aniib eetehak baabariin.” idi.<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Yuuhannaay idiigwatkina giigiyaani harꞌii, Yasuuꞌa oodehayii dehaay Yuuhannaayiib hadiidiya: “Umingaay tibeenihoob, naan rhitiib tehiriwna? Aggaab ubaraam nanfiyeeb rhaa miyaadiib tibeena han? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Bak biikaayeek, naan rhitiini jillaay giigtaana? Daawri halaka akwaay tak? Abadan, baliin daawri halaka eetkwiin yhadꞌaayi gawaayeeb eefeen. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Laakiin naan rhitiini jillaay giigtaana? Nabiib? Awooh, oosdik andi hookna, nabiika winkaabi. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Tuun batuuh uktaabiib kataabtu: ‘Ani udiigwatkinaayu suurook iifdig andi. Baruuh whankaay usalalook isuumir indi.’ diyaabi.<verse eid="MAT 11:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Oosdik andi hookna: baliib taamꞌat firaat ikatiineeb eebtik, Yuuhannaab umoosanaayka winkaab lawaab kiiki. Tibreeteet hadꞌaayeetiib hooy uudiska, bariisoohka winkaabi. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Yuuhanna umoosanaay idamanee amsi ookiik, tibreeteet hadꞌaayi akriree tinwiin, aree ribshaayti dehay batooh akruurii abuuk yhariwna. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Yuuhannaab ookiik aree kassaah inabiyaawwa Muusaay whagwa tehadꞌaayeetiib hadiidiyaan. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Baraak batooh agbiltiib tehariwneek, Eelya yꞌiini attiyoodiyaab been baruuh Yuuhannaab ikati. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Yꞌangwil ibariibka maasiwna!<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />Oon udamaani dehay naanaati geeb asnadiir? Baraah inisrika isuugaayeeb sꞌatiit eeraw waliikeen tꞌiiteeba.<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />Baraah ‘Hinin biilhooyt dehookna nithꞌa,</para>
  <para style="q2" vid="MAT 11:17">aree baraakna hawaayaab kitteena.</para>
  <para style="q1" vid="MAT 11:17">Hinin dehookna nawwaatna,</para>
  <para style="q2" vid="MAT 11:17">aree baraakna gadabaab kitteena.’ iyadna.<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />Yuuhanna eeyanihoob, tamaab kiiki, gwꞌaab han kiiki. Baraah aree ‘Baruuh jin ibari.’ idiin. <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Wꞌaadami Oor tameewwa gwꞌeewwa eeya. Baraah aree ‘Baruuh tamanaabu, sakraanu, tilbaat tamanaawwa maag dehaywa araweesamiini.’ idiin. Laakiin tifagarandi taakna ishagaayiisoohna oosdik rhiseen.” idi Yasuuꞌa.<verse eid="MAT 11:19" /></para>
  <para style="s">Timadiina tuubaat baakayt idhikwna</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Malya Yasuuꞌa timꞌuujisa hooy iikwsiyeeb yhash neewiya. Een yhash udehayuuhna tuubaab kiikeenayt, Yasuuꞌa, <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“Tidhikwii yaa Koorasiin! Tidhikwii yaa Beetsayda! Bateeyookna ikeent timꞌuujisa, Tiirooswa Siidooneebwa akaat iiktiineek, udehayuuhna shꞌiika tuubiina. Baraah shiwaali halak iitkwiina aree igirmaayeehna kehii nꞌeetihaash geediin. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Laakiin ani andi hookna: whukwimiit tooyin bareesookka Tiirooswa Siidoonii dehaaywa laamakaat iikti tindi. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Aree batuuk, yaa Kafarnaahuum, teebri beeti tafami tindii han? Abadan, eedhoom ookiik hoogi tindii. Timꞌuujisa batiiyook ikeent Sadoomeeb akaat iiktiineek, oon amsi ookiik masi daayiin. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Laakiin ani andi hookna: whukwimiit tooyin batiisookka Sadoomee dehaay laamakaat iikti tindi.” idi Yasuuꞌa.<verse eid="MAT 11:24" /></para>
  <para style="s">Yasuuꞌa Wꞌankwanaay dehaay siileeliya</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Been oodoor Yasuuꞌa, “Baruuk teen teena ifagarandeewwa yꞌagriyaaneewwa tikwibisaayt, yꞌar idabalooyaayee dehaay lawsita akay, ahammiid hook, yaa Baaba, toobuutwa tibreeti Wꞌankwana. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Awooh, yaa Baaba, tuun tuuna barook afirhistini.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />Baabu naatka yhiiheeb. Wꞌoor aab ikatiyeeb ubaaba nuun gaal han kiikan. Ubaaba aree aab ikatiyeeb wꞌoor nuun gaal han kiikan. Laakiin wꞌoor ubaaba aab ikatiyeeb eeraw sootiib harriiw, aflaay baraah barooh iikan iyadna.” idi Yasuuꞌa.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />“Baraak igwooyaabwa digaana yaksaabwa kassaak mꞌaanaheeb, aree fiinaniit iyaaw hookna andi. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Anii whasaal ahaana, malya anii kanna, ani nꞌakwu, nhas ginꞌiibu, aree infiseeyookna dehaay fiinaniit imaar tiyadna. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Aniib whasaal laamaabu, aree aniib irabi shoof ikati.” idi Yasuuꞌa.<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Tusabti Ankwana</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Been oodoor Yasuuꞌa toosab harrooyt dirꞌaati bitik hiireeri. Ikwiriyaatayaah hargwaa iifiinayt gangaraab kitꞌatiitka tamiin. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Ifariisi toon toona rhiyaanihoob, bariiyooh dehaay, “Shibiba! Ikwiriyaatayaak toosab harramamaana sakeen.” idiin.<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Yasuuꞌa igwibi, “Daawidwa yꞌarawaahwa yharagwnihoob idꞌiineet toona agriiyaab kitteena han? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Baruuh Ukwaasanaay oogaw shuumiya. Baruuhwa yꞌarawaahwa Ukwaasanaay dehaay farꞌa tikaraamaati hadhi tamiyaan. Een yhadhi baraah tamiyaaneeb ifagiiriya aabhat tamiina, bareeyooh dehaay halaal kiikeen. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Tari ifagiiriya toosabka Ukwaasanaay ugawiib tusabti hag ikatꞌaneet toona Muusaay whaggiib agriiyaab kitteena han? Laakiin baraah nhas kiikeena han? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Ani andi hookna: Ukwaasanaay ugawiika tooy winkaab teefi. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Aan ibhali naan iiktiineeb tiktiinneek, ‘Ani rhamaat aharriiw, karaamaat kiikeen.’ oonhas kittiweena. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Wꞌaadami Oor tusabti Ankwana ikati.” idi.<verse eid="MAT 12:8" /></para>
  <para style="s">Yasuuꞌa toosab mheeliya</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Been whaashii difee, Iyahuudi diini gawoohna shuumiya. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Beentooy tak wꞌayi adhaadh iiktiyeeb iifi. Baraah Yasuuꞌaab haay atehimiini sabab yhiriwna, baraah barooh raatiyaana, “Tusabtiib imheelti halaalu?” idiin.<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Yasuuꞌa bareeyooh dehaay, “Gaal bareesookna argin iibriyeek, aree tusabtiib deelaay dhibiiniyeek, wꞌargin udeelaay sikwiit kiifirꞌa han? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Wꞌaadami wꞌarginiika alyakaab kiiki han? Aflaay toosab tudaayiinaayti shaga halaal ikati.” idi.<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Malya Yasuuꞌa ootak infaraad, “Wꞌayook fidhidha.” idi. Uutak wꞌayooh ifidhidh, shaawti wꞌayi itkwakw aree ooraaw tꞌiiteeb iki. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Laakiin Ifariisi giigiyaaniit barooh haay iidirneet hayꞌaatiib tarootsamiyaan.<verse eid="MAT 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Laakiin Yasuuꞌa baraah niyaamiineet toona ikanayt, been oomhiin hooy giigiya. Gwida dehay barooh iramna, aree kasseeh eelhaab mheeliya. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Yasuuꞌa baruuh aab iiktiyeeb weer dehay biisooyayneet toona bareeh sooya. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Tuun tuuna unabi Isyaasi geebii attiyoodiyaat toona sidik tiikwsi: <verse eid="MAT 12:17" /><verse number="18" style="v" sid="MAT 12:18" />“Baruuh ukishiyaayu ani waasaab akatiyeebu,</para>
  <para style="q2" vid="MAT 12:18">ani areeyaab akatiyeebu, ani geeb madhaadh akatiyeebu.</para>
  <para style="q1" vid="MAT 12:18">Ishuuki bariiyooh daasi andi,</para>
  <para style="q2" vid="MAT 12:18">aree baruuh yhash kasseeh adil iyaaw indi.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Baruuh itehis kiidi, tari waliiki kiidi.</para>
  <para style="q2" vid="MAT 12:19">Bariiyooh whiss gaal han isalalaayeeb iimsaw kiidi.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Baruuh wꞌadil ansiriiniyeeb ookiik,</para>
  <para style="q2" vid="MAT 12:20">agwal agga han iikitꞌa kiidi,</para>
  <para style="q1" vid="MAT 12:20">iiyyi tindiit lamba han iidir kiidi.<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />Idehaya bariiyooh oosim sꞌayaami iyadna.” idi Yasuuꞌa.<verse eid="MAT 12:21" /></para>
  <para style="s">Yasuuꞌaawwa Baꞌalsabuulwa</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Malya baraah tak jin hooy iifiineeb hamashaywa gilluusiibwa iiktiib Yasuuꞌii dehaay haay eeyaan. Yasuuꞌa barooh mheeliya, shaawti uutak inꞌir, hadiidiya, aree rhiya. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Kassaah uudehay ajjabamiyaaniit, “Uun baruuh Daawidi Oor ikati?” idiin.<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Laakiin Ifariisi een ibhali imaasiwnihoob, baraah “Uun baruuh ijini hadꞌa Baꞌalsabuul ibari nuun eejin kiifirꞌa.” idiin.<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Laakiin Yasuuꞌa baraah iikwinneet toona iktiinayt, bareeyooh dehaay, “Tehadꞌaayi tuukna malu mhiin adhadhtiit udehayuuh taktak finaayeeneeb, katꞌamtini. Tumadiina tari indhiwa aakna malu mhiin itꞌadhiidh shaawti yaki kiidiin. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Uubliis oobliis finaayiiniyeek, baruuh ooknaay kehii itꞌadhiidh. Aflaay tehadꞌaayeetuuh kak tingadi? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Aree ani Baꞌalsabuulii eejin mhalaniyeek, bareeyookna harꞌii sakeen uudehay bareeh kak mhaleena? Aflaay malya, baraah gaadiyaayeekna iikti iyadna. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Laakiin ani Ukwaasanaay Ishuukee eejin mhalaniyeek, aflaay Ukwaasanaayt tehadꞌaayi bareeyookna dehaay yꞌaati.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />Tari masi, akra taki gaw shuumiit igadhꞌeeh iniin aabu? Hankaab ootak wꞌakraab yꞌayi yhiikwar biidiyeek, igadhꞌi miyaay kaꞌadgiriya. Barooh yhankwiireek, malya oogaw ingwihiir.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />Anii geeb baahaay uutak been, anii kehii eefi. Aree anii geeb oodehay baasimarriib uutak, baruuh itbariir.” idi. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Toon toona bak sooyani hookna, tumaagnaaywa ookfuurwa uudehay afoomi iyadna. Laakiin Ishuukee kanfiir afoomi kiidi. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Wꞌaadami Oori kehii amag bhaliib indiibka afoomi indi. Laakiin Eeshuuk Imugaddasaayi kehii amag bhaliib indiibka, oon udamaaniib ikatiyeek, tari harꞌook yꞌiiniib udamaaniib, afoomi kiidi.<verse eid="MAT 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />“Whindi shiishboobna, aree ufraayuuh ishbuub indi. Tari whindi migna, aree ufraayuuh iitmag indi. Whindi ufraayiisooh itookkiin. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Baraak ikwakwaraayi firaay, kak daayiina tiyadna? Uuginꞌa ataab ikatiyeet toona uuyaf hadiidiini. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Uutak udaayi, tehooyteeb dabaayt tushbootii daayiina haay yꞌiini. Uutak wꞌamaag aree tehooyteeb dabaayt toomaagtii maagt haay yꞌiini. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Laakiin ani andi hookna: uudehay yꞌamag bhali hadiidaab ikatiineeb kasseeh whukwimiit tooyin dehaay haasabami iyadna. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Baraak ibhaliiyeesookna shibootikina iikti tiyadna, ibhaliiyeesookna aree hukwimami iikti tiyadna.” idi.<verse eid="MAT 12:37" /></para>
  <para style="s">Ifariisi alaamaat yhariwna</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Malya Fariisi galwa whaggi koojaawwa bariiyooh dehaay, “Seedna, bariisook mꞌuujisaateet alaama nhariw.” idiin.<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Baruuh “Amaag dehaywa wꞌiimaan baabariinwa alaamaat raateen! Laakiin unabi Yuunisiit tꞌalaama nuun weena soomami kitdi. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Yuunis win aashooy fꞌiib mhay hawadwa mhay bꞌeewwa yhagit. Aflaay Wꞌaadami Oor han mhay hawadwa mhay bꞌeewwa toobuuti ginꞌiib daayi indi. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Neenawaay uudehay han whukwimiit yint yakiit oon ootaas atehimi iyadna. Unabi Yuunis Ukwaasanaay ibhali bareeyooh dehaay hadiidiyanihoob, baraah tuubiyaan. Tooy laakiin Yuunisiika winka gaal eefi. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Oosꞌiidiit hadꞌa whukwimiit yintiib yakiit oon ootaas atehimi tindi. Batuuh tubuuti agiyaay eetaayt, Suleemaaniit tifagarandiiti bhali sinaakrooyt tehariw. Laakiin tooy Suleemaaniika winka gaal eefi.<verse eid="MAT 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />Aajin wꞌaadamii itfarꞌanihoob, nageema mhiin hooy fiineeneeb yhariwna aree barooh kiimriin. Malya aajin, ‘Oogaw whooy nifirꞌeeb beeti nitꞌigir niyad.’ iyadna. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Malya aajin, ‘Oogaw suur hooy giignaneeb beeti nitꞌigir niyad.’ idiin. Aajin yꞌeenihoob, oogaw atimhigaa nhasaa, nigiyaa aree shibooba imeerna. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Aflaay aajin giigiyaaniit wari jin asaramaab bareesoohka amagkaab haay eeyaan. Oogaw aree shuumiyaaniit beentooy ikwiriin. Been uutak aree whaaluuh suureeka amaagkaab iikti. Aan uudehay yꞌamag han bak iikti iyadna.” idi.<verse eid="MAT 12:45" /></para>
  <para style="s">Yasuuꞌiit toondeewwa isanaawwa</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Yasuuꞌa masi oodehay bhaliisamee, tuundeehwa isanaayaahwa eeyaaniit barraab ingadna. Barooh tarootsamiineet yhariwna. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Oodehayii gaal barooh sooya, “Deetuukwa isanaayaakwa barraab ingadiina, tarootsamtiyook yhariwna.” idi.<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Yasuuꞌa ootakii dehaay, “Deetu aabtu? Isanaayi aree aayga ikatiina?” idi. <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Malya Yasuuꞌa ikwiriyaatayeeh beeti tuuliyaayt, “Deetuuwwa isanaayaawwa aan ikatiin. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Baabu tibreeteeb eefeeb harriiweet toona danꞌiibka sanoowwa, kwaatoowwa, deetoowwa ikatiin.” idi.<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Tudirꞌaati mitaal</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Beet tooyin tookna, Yasuuꞌa ugawii ifirꞌat ubhari daraag isꞌa. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Winneet gwida dehay barooh ikwilalni immarraayna aree baruuh falluukaat yꞌam aree batiiyooh kehii isꞌa. Uudehay aaraw kassaah iyami dariib ingadna. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Malya Yasuuꞌa oodehay gwidaana mitaalee sooya, “Dirꞌaatkina teeraayooh iigidee dehaay giigiya. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Baruuh iteera teeraayee, habbaat gat salaliib dhibiyaan. Aree aakilay eeyaaniit aamiyaani idꞌiin. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Habbaat warit awi hooy iifiyi mhiin dhibiyaan. Aree oomhiin gwida haash hooy kiihaay. Whaash hoogaab kiikayt tehabba willa yakta. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Laakiin tuuyin tifirꞌihoob, tifuuti gadam kitbari akay balamtaayt tilaw. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Teera weer naweeti bitik dhibiya, aree yakiyanihoob tinawi iskitni idirna. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Laakiin shalikt habba daayi haashiib dhibiyaaniit, sheeb doora harroob haay eeyaan. Aree weer asagwir tamuun doora iikti, aree weer mhay tamuun doora iikti. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Angwil ibariib, baꞌiimsaw.” idi.<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Ikwiriyaatay bariiyooh dehaay eeyaaniit raatiyaana, “Oodehay naanhooy mitaalee tinfariida?” idiin.<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Yasuuꞌa igwibi, “Tibreeteet hadꞌaayeetiib kwabaast tunaatiit kanaant, bareekna attiyeewiyaatu. Laakiin bareeh attiyeewiyaat kitti. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Ibariibka gwidaana ittiyiw indi, gwidaana aree imaar indi. Naat baabariibka aree, tuuna baruuh ibariyeet hooy giigi tindi. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Oon usabbii aree bareeh mitaalee anfariid. Baraah ishabibneek han, karhiyaan. Eemsiiwneek han, kiisinaakirna tari kaꞌafhamiyaan.<verse eid="MAT 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />Unabi Isyaas bareeyoohna isrideet tuuna iikti tindi:</para>
  <para style="q1" vid="MAT 13:14">‘Baraak diimaab teemsiiwna laakiin door han kaꞌafhamtaana.</para>
  <para style="q2" vid="MAT 13:14">Baraak diimaab tishabibna laakiin door han karhitaana.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Oon oodehayi ginꞌa yꞌakirna,</para>
  <para style="q2" vid="MAT 13:15">yꞌangwileehna dhadhibisiyaana,</para>
  <para style="q2" vid="MAT 13:15">aree igwꞌadeehna assiyaan.</para>
  <para style="q1" vid="MAT 13:15">Bak biikaayeek, igwꞌadeesoohna rhiin iiktiin,</para>
  <para style="q2" vid="MAT 13:15">yꞌangwileesoohna eemsiiw iiktiin.</para>
  <para style="q2" vid="MAT 13:15">Iginꞌaayee afhamiin iiktiin.</para>
  <para style="q1" vid="MAT 13:15">Aree aneeb beeti itꞌigirneek ani bareeh mheeli.’ idi.<verse eid="MAT 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Laakiin bareekna igwꞌadaakna rheena, aree yꞌangwilaakna eemsiiwnayt, libaabtaana. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Ani oosdik andi hookna: baraak rhitaaneet toona gwida nabiyaawwa shibu dehaywa rhitiib yhariwna. Laakiin rhaab kiikeena, aree baraak timaasiwneet toona yhariwna laakiin maasiwaab kiikeen.<verse eid="MAT 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />Baraak aflaay iteeraayanaay mitaal sinaakirna: <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Tehadꞌaayeetiit diigwat maasiwtiit baaꞌafhamay, maagti kina dehaay yꞌeetiit uginꞌiib teeraamaat toona hooy tafiini. Uun aree iteera usalaliib dhibiyaab ikati. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Uutak wꞌawii mhiin dhibtaat tehabba nuunamiiniib, baruuh Ukwaasanaay bhali maasiwtiit gaal door afirhaa nuunamiini. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Laakiin baruuh gadam kiibari akay shalik door oobhaat hangiit. Ukwaasanaay ibhaliyi sabbii gwirha tari amaag wara yꞌiiniyihoob, baruuh willa fidinti dhibiini. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Uutak tinaweeteeb dhibiyaab iteera nuunamiiniib, baruuh Ukwaasanaay ibhali eemsiiw. Laakiin tuduniyaati gwirhaawwa, oomraayi reerwa barooh isakitna aree naat samaraat kiidꞌi. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Laakiin uutak iteera daayi haashiib dhibiyaanaay nuunamiiniib, baruuh Ukwaasanaay ibhali maasiwtiit afhamiini. Baruuh harroob haay yꞌiini, sheeb, asagwir tamuun tari mhay tamuun doora gwidakaab ikati.” idi.<verse eid="MAT 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yasuuꞌa bareeh wari mitaal sooya, “Tibreeteet hadꞌaayi ootak daayi haashiib teeraayaab tꞌiiteeti. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Laakiin baraah gaalka diwee, barooh yꞌashooyaah eeyaaniit igamhi bitik adaar teeraayaaniit giigiyaan. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Igamhi yakiyaayt girmaab ifirꞌihoob, wꞌadaar han lawiya.<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />Udirꞌaatkinaay ishagaamana bariiyooh dehaay eeyaaniit, ‘Duuruun, tudirꞌaatiyook daayi teera teeraayaab kitta han? Wꞌadaar aflaay naa mhiinii eeya?’ idiin.<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />Baruuh ‘Toon toona wꞌashooyu iweer.’ idi.</para>
  <para style="p" vid="MAT 13:28">Ishagaamana barooh raatiyaana, ‘Hinin diftiit wꞌadaar fataktiib hoon harriiwa?’ idiin.<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />Baruuh ‘Abadan, baraak wꞌadaar fatakee, igamhi geeb fatakteena. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Ishna dꞌiina oowaak ookiik mhallaahna hiddaab bayakiin. Been oodoor iwookana sooyi andi, Hankaab wꞌadaar wiknaat gaal mhiin hakwirnaat liwna! Malya igamhi dibilnaat ugiisaay daasaana iyaad andi.’ diyaabu udirꞌaatkina.” idi Yasuuꞌa.<verse eid="MAT 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yasuuꞌa bareeh wari mitaal dehaay hadiidiya, “Tibreeteet hadꞌaayi isinfaayt habba tak yakisiyaayt dirꞌaatiyooh teeraayaneet tꞌiiteeti. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Batuuh kasteeh tehabbaateeka diskaat tikatiyeek han, tinwiinihoob laakiin tudirꞌaati hindiyeeka winkaat tikati. Aflaay aakilay tibreeteeb dhaabeen yꞌeetiit ilꞌiidaayeeb naayi iyadna.” idi.<verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Yasuuꞌa aree masi wari mitaal bareeyooh dehaay hadiidiya, “Takat hamiir yaksitaayt gwida bꞌuuk hooy tishaaw, aree kassooh wꞌajiin tisehamir. Tibreeteet hadꞌaayi batooh tꞌiiteeti.<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yasuuꞌa kasteeh teen teena mitaalee bareeyooh dehaay hadiidiya. Mitaal anu bareeh naat han sooyaab kiiki. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Aflaay unabi geebii hadiidamaat tuuna sidik tiikti:</para>
  <para style="q1" vid="MAT 13:35">‘Uyafu mitaalee iingil andi,</para>
  <para style="q2" vid="MAT 13:35">tuduniya daamtaneekka kwabast teena hadiidi andi.’ diyaabu.” idi Yasuuꞌa.<verse eid="MAT 13:35" /></para>
  <para style="s">Yasuuꞌa wꞌadaari mitaal fassariya</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Malya Yasuuꞌa oodehay hooy giigiyaayt, oogaw shuumiya. Ikwiriyaatayaah bariiyooh dehaay eeyaaniit, “Tudirꞌaatiib eefeeb wꞌadaari mitaal sooyaa hoon.” idiin.<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Yasuuꞌa “Iteera udaayiib teeraayaab uutak Wꞌaadami Oor ikati. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Tudirꞌa tuduniya tikati, aree iteera udaayi tehadꞌaayeeti ar ikatiin. Wꞌadaar aree wꞌamaag dehayi ar ikatiin. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Wꞌashu been wꞌadaar teeraayaab aree oobliis ikati. Uuwaak aree udamaani agiya ikati, iwookana aree imalak ikatiin.<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />Wꞌadaar fatakeetiit nꞌeetiib itooliiwnaayt, aflaay been udamaani agiyaay bak iikti tindi. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Wꞌaadami Oor imalakeeh diigwatiini, aree baraah baliib toomaagwa igwirhaawwa isidꞌiin kasseeh, tehadꞌaayeetiisooh wꞌadaariit fataki iyadna. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Imalak een bareeh akraat nꞌeetiib iigid iyadna. Baraah waawi iyadna, igirmaayeehna toobuut haay iithꞌa iyadna. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Malya uudehay aashbu Baabiitoohna tehadꞌaayeetiib tooyin tꞌiiteena talawi iyadna. Angwil ibariib, baꞌiimsaw.<verse eid="MAT 13:43" /></para>
  <para style="s">Kwabaas miraayi mitaal</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />Tibreeteet hadꞌaayi dirꞌaatiib kwabaas miraay tꞌiiteeti. Tak batooh manriyihoob, masi kwanbiiska afirhaa giigiini. Malya kassooh oomraay danliibka beet tudirꞌa dilibti iniin.<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />Masi, tibreeteet hadꞌaayi alya jawhar harriiw tijaar tꞌiiteeti. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Baruuh alya taman manriyihoob, diftiit ibariiyeenaaka kastooh danliibka jawhar iniin.<verse eid="MAT 13:46" /></para>
  <para style="s">Tushabakaati mitaal</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Masi tꞌa han, tibreeteet hadꞌaayi tushabaka yameeb atoogidaat kasseeh yꞌaashooyi jinsa tꞌanbiik tꞌiiteeti. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Batuuh titabihoob, yꞌaashoob aabki ifirꞌaniit iyami dar daasiyaan. Malya baraah isꞌaniit yꞌaashu idaayiib hooy waasiyaaniit biilii daasiyaan. Laakiin yꞌaashu yꞌamag fidnaab hooy geediyaan. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Tuun wꞌaakhar damaaniib bak iikti indi. Imalak yꞌeetiit oodehay yꞌamag eeshboobnaayee wawaasi iyadna. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Malya bareeh winneet akraat nꞌeetiib iigid iyadna. Beentooy baraah waawi iyadna, igirmaayeehna toobuut haay iithꞌa iyadna.<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Baraak teen teena kasteeh afhamtaana?” idi Yasuuꞌa.</para>
  <para style="p" vid="MAT 13:51">Baraah “Awooh.” idiin.<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Yasuuꞌa bareeyooh dehaay, “Aflaay whaggi kooja kassaah tibreeteet hadꞌaayi soomamiyaana, ugawi kina umikhsaniisooh gayi miraaywa shꞌiiya miraaywa mhaliiniib tꞌiiteena tikatiyeet toona soomamiyaan.” idi.<verse eid="MAT 13:52" /></para>
  <para style="s">Naasiraay uudehay Yasuuꞌaab iribna</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Yasuuꞌa een eemtaal faaysiyanihoob, been umhiinii giigiya. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Baruuh whaashiitooh tumadiina eeyaayt, oodehay Iyahuudi diini gawiib allamtiib badooya. Baraah aree winneet ajjabamiyaan. Baraah “Uun uutak teen tifagarandiiwwa timꞌuujisaati akrirwa keeya mhiin imri? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Uun baruuh unajjaari oor kiiki han? Toondi Maryam kiidiin han? Yaaguubwa Yuusifwa Siimoonwa Yahuudaawwa sanaayeeh kiikeena han? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Taakwa kastaah geeboon kiihaayna han? Teen teena kasteeh uun uutak keeya mhiinii haay eeya?” idiin. <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Aflaay baraah barooh iribna.</para>
  <para style="p" vid="MAT 13:57">Laakiin Yasuuꞌa bareeyooh dehaay, “Unabi whaashiitooh tumadiinaatiibwa ugawooh ooknaaywa oobhaat whamooysiti kiimri.” idi.<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Baraah wꞌiimaan biibariini sabbii, Yasuuꞌa gwidaat mꞌuujisa kwaasaab kiiki.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Yuuhannaab umoosanaayt tooyat</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Been oodoor whaakim Heeroodis Yasuuꞌiib usakana imaasiw. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Baruuh oodehay igeebooh iifiinnee dehaay, “Uun baruuh Yuuhannaab Umoosana ikati. Baruuh tuyatii yakiya! Toon tunaatii aree timꞌuujisaati akrir bariiyooh geeb shagaameen.” idi.<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Heeroodis oontꞌa Yuuhannaab yꞌabik, yhaakwir aree oosjin idꞌi. Baruuh Yuuhanna oosjin haay iidꞌeeb usabab Heeroodiyaas usanooh Fiilibusiit tootakati sabab iikti. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Yuuhanna bariiyooh dehaay, “Saniitook tootakati jikuun dehook halaal kiiki.” diyaabi. <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Heeroodis Yuuhannaay madar yhariw, laakiin oodehay irkwi. Uudehay Yuuhannaab nabiib hiisiin.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Heeroodisiit toofraytiit yinti wꞌiid iikti akay, Heeroodiyaasiit oot bareeyooh dehaay tilag. Heeroodis aree winneet afirhista. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Baruuh tꞌoor teharriiweet toona kastooh iniiweet toona halafooya. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Batuuh toondi timkaraayt, “Toon tukoobaatiib Yuuhannaab umoosanaay ugirma hiiyyaheeb.” tidi. <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Whadꞌa winneet gadabiya laakiin tehalafooytiyooh sabbiiwwa, udiraari kehii iifiin yꞌiibaabkinaayi sabbiiwwa, baruuh tꞌoor teharriiweet tuuna ibakii tikatiyeet toona sooya. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Yuuhannaayt tꞌala usijniib ikitꞌana. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Malya Yuuhannaayiib ugirma koobaatiib haay eeyaaniit tꞌoor yhiin. Tꞌoor toondi ookiik tukoobaatiib tifiyak. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Yuuhannaay ikwiriyaatay eeyaaniit tukinaaja yaksiyaaniit ibisna. Malya baraah giigiyaaniit Yasuuꞌaab sooyaan.<verse eid="MAT 14:12" /></para>
  <para style="s">Yasuuꞌa ay alfa dehay mꞌariit tamisiya</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Yasuuꞌa toona tutikeet imaasiwihoob, falluukaat yꞌamaayt oodꞌooh nigiya mhiin ibi. Uudehay toon toona imaasiwnihoob, timadiinaatee ragadaayee barooh iramna. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Yasuuꞌa tufalluukaatii tikwiyanihoob, gwida dehay rhiya. Bareeh dehaay nꞌakwmanaayaayt udehayoohna eelhaab dehaay mheeliya.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Whawaad idwilihoob aree, ikwiriyaatayaah bariiyooh dehaay eeyaaniit, “Uun whaash mingaayamaabu, aree hawaad yꞌaabi. Oodehay fidnaab giigsaa, shaawti indhiwaayeehna bayiit mꞌariitoohna baꞌiidlibna.” idiin.<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Yasuuꞌa “Uudehay giigtiib shanha kiikeen. Baraak bareeh mꞌariit tamsaana.” idi.<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Baraah “Hinin tooy ay hadhiiwwa maloot aashooyaytwa nibari.” idiin.<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Yasuuꞌa “Bareeh tooy haay mꞌaanaheeb.” idi. <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Yasuuꞌa oodehay oosiyaami kehii isoosꞌa. Malya yhadhi yꞌaywa yꞌaashu imaloowwa iyhaayt teebri nakamiya. Ukwaasana yhamid aree yhadhi katꞌiya. Malya bareeh ikwiriyaatay nuunisiya, ikwiriyaatay aree oodehay yhiin. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Uudehay kassaah gabiyaaneeb ookiik tamiyaan. Aree ikwiriyaatay yhadhiyi firkakeet toodhikw tamna malu biileeb hooy toobiyaan. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Been uudehay timꞌari tamiyaan ay alfa da iiktiin. Mꞌatwa nisrikaabwa han geeb iifiin.<verse eid="MAT 14:21" /></para>
  <para style="s">Yasuuꞌa iyami kehii hiireeriya</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Malya Yasuuꞌa willa ikwiriyaatayeeh tufalluuka isooꞌamaayt eeyam oodar ooraaw ookiik bariiyooh suurii giigisiya. Aree baruuh oodehay igwidaab ibrir. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Oodehay giigisiyaayt harꞌii, baruuh siileelti jillaay ribaab reewiya. Whawaad eeyanihoob, beentooy oodꞌooh iifi. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Laakiin tufalluuka suur akay whaashii tisgi. Aree ubaraam batooh imꞌikirayt, uumooj batooh iithꞌa.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Fajir karuumaab Yasuuꞌa iyami kehii hiireeree bareeyooh dehaay eeya. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Ikwiriyaatay barooh iyami kehii hiireeree rhiyaanihoob, winneet irkwiina, “Tuun whiinaaytu.” idiiniit, mirkwaayii aadhiyaan.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Laakiin Yasuuꞌa willa bareeyooh dehaay, “Ariknaa, uun aneebu! Baarakwiina.” idi.<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Bitrus “Wꞌankwanaay, uun barook tikatiyeek iyameeb yꞌi hook andi sooyaaheeb.” idi.<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Yasuuꞌa bariiyooh dehaay, “Mꞌaa!” idi.</para>
  <para style="p" vid="MAT 14:29">Malya Bitrus tufalluukaatii yakiyaayt iyami kehii hiireeree Yasuuꞌaab beeti ibi. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Laakiin baruuh ubaraam rhiyanihoob, irkwiit aayam barooh miyaay yhariwna, baruuh aadhiya, “Wꞌankwana, shidhhanaheeb!” idi.<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Yasuuꞌa willa iktimayt bariiyooh wꞌayi yꞌabik, “Baruuk ishalik iimaaniyaay, naanhooy eetehaktiniya?” idi.<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Baraah tufalluuka yꞌamnihoob, ubaraam ingad. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Malya baliin tufalluukaatiib iifiin barooh yꞌabidna aree, “Baruuk sidik Ukwaasanaay Oor tikatiya.” idiin.<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Baraah oobhar ikitꞌanihoob, Ganneesaareetiib tikwiyaan. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Been whaashi dehay Yasuuꞌaab ikannihoob, yhash oodar iifiin kasseeh diigwataat dehaay ifdigna. Uudehay kasseeh udehayoohna eelhaab bariiyooh dehaay haay eeyaan. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Uudehay barooh inꞌalna, “Uudehay aalha whalakiitook shinki batehiin.” idiin. Bariiyooh whalak tehiyaan aree kassaah inꞌirna.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Nhaswa nhas baakaaywa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Fariisi galwa whaggi koojaawwa Yasuuꞌaab raatiini jillaay Algudusee eeyaan. <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />Baraah “Ikwiriyaatayaak hoobeeteen tꞌaada naanhooy katꞌeena? Baraah tumꞌariiti hankaay yꞌayeehna kiishigwidhna!” idiin. <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Yasuuꞌa “Tꞌaadaateeyookna jillaay baraak naanhooy Ukwaasanaayt tiwasi tikatꞌana? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Ukwaasana ‘Baabookwa deetookwa hamooysa. Baabooh tari deetooh inꞌiitka ituudir indi.’ diyaabi. <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Laakiin tak ubaaba tari tundeetii dehaay, ‘Anii manriyeet tushamaam Ukwaasanaay dehaay attiyeewiya miyaaw ikati.’ baraak tiyadna. <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Baraak uun uutak ubaabaawwa toondeewwa biihamooysayeet toona tehariwna. Baraak tꞌaadaateeyookna jillaay Ukwaasanaay ibhali khaalafteena. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Baraak wharaay dehay! Unabi Isyaas bareeyookna iisridihoob sidkiibu: <verse eid="MAT 15:7" /><verse number="8" style="v" sid="MAT 15:8" />‘Aan baraah iyafaayeesoohna aneeb yhamidna. Laakiin iginꞌaayaahna anii winneet sagiiba. <verse eid="MAT 15:8" /><verse number="9" style="v" sid="MAT 15:9" />Baraah nafꞌaat baabariint ibaada yꞌabidnaheeb. Allameena laakiin dehayiit aada allameen.’ diyaabi.” idi.<verse eid="MAT 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Yasuuꞌa oodehay barooh beeti waliikiyaayt, “Sinaakirna malya afhamaana. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Wꞌaadami yaf shuumtiniit tuuna barooh kayiwaashiista. Laakiin uyafii eetniit tuuna beet yiwaashiistini.” idi.<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Malya ikwiriyaatay Yasuuꞌii dehaay eeyaaniit “Ifariisi een ibhali imaasiwnihoob yhaseeneet toona tikana?” idiin. <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Yasuuꞌa “Yhindi Baabu tibreeteeb eefi adiyaab biikaayeeb igadamaayee fatakami iyadna. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Bareeh ishna dꞌiina, baraah hamashayaaba aree hamashayaab salooleen. Tak hamashay weer hamashay salooliiniyeek, mhallaahna deelaay dhibi iyadna.” idi. <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Bitrus aree “Eemtaal dehoon fassara.” idi. <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Yasuuꞌa bareeh raatiya, “Baraak masi afhamaab kitteena han? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Ooyaf shuumtiniit tuuna kastuuh oofꞌi teebiyeet toona karhitaana han? Malya aree ugarooy titfarꞌeet toona karhitaana han? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Laakiin taana uyafii yꞌeent uginꞌii yꞌeena, aree taan bataah wꞌaadami nhas baakaay ikwasiin. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Uginꞌii titfarꞌi tuuna maagti kwoonti ikati, madarwa, jikuunwa, mꞌateeb hawriiktiibwa, gwihartwa, gwisreet badehaatwa, gwisirwa, neewwa ikatiin. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Taan bataah aree wꞌaadami nhas baakaay ikwasiin. Laakiin yꞌayi baashagwiidh mꞌariiti tamti wꞌaadami nhas baakaay kitkwaas.” idi.<verse eid="MAT 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yasuuꞌa been whaash hooy giigiyaayt, Tiirooswa Siidoonwa haash ibi. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Takat Kanꞌaaniit been whaashii waawee bariiyooh dehaay eetaayt, “Wꞌankwana Daawidi Oor, anii dehaay nꞌakwmanaaya. Tꞌootu winneet amag jin hooy eefeen.” tidi.<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Yasuuꞌa kalmaat han diyaab kiiki. Aflaay ikwiriyaatayaah dehaay eeyaaniit, “Tootakat giigsa, harꞌoon waawi tindi.” idiin. <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Yasuuꞌa “Ani Israaꞌiileeb wꞌargin ukwidhaab oobhaanaay dehaay diigwatamaabu.” idi. <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Tutakat eetaayt bariiyooh suurii tignaf, “Wꞌankwana, awayaheeb!” tidi. <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Yasuuꞌa “Inisrikaayi hadhi yaksiit iyasee dehaay uugaad daayiina kitti.” idi. <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Batuuh “Awooh Wꞌankwanaay, laakiin aayas han yꞌankwanaayeet taawlaatii dhibeen ifirkak tameen.” tidi. <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Malya Yasuuꞌa “Yhayi! Batuuk akra iimaan tibarii! Batuuk harriiweet tuuna iikti tindi.” idi. Aflaay beet toosꞌa tookna tꞌootuuh mheelamta.<verse eid="MAT 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yasuuꞌa beentooysii giigiyaayt, Jaliileeb ubharii giigiya. Malya ribaab reewiyaayt nꞌati isꞌa. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Barooh gwida dehay dehaay eeyaana, yꞌankwalanaawwa, yhamashayaawwa, igaraabayaawwa, igilluusiyaawwa, gwida waribwa, haay eeyaaniit bariiyeeh iragadaayi whii bꞌasiyaan. Aree baruuh bareeh mheeliya. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Igilluusiya hadiidiyaana, igaraabaya inꞌirna, yꞌankwaliin daayiib hiireeriyaana, aree yhamashaya rhiyaan. Uudehay toon toona rhiyaanihoob ajjabamiyaana aree Israaꞌiileeb Ukwaasana yhamidna.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Yasuuꞌa ikwiriyaatayeeh marooh waliikiyaayt, “Ani oon oodehay dehaay nꞌakwmanaayani, baraah suur akay mhayt yiina geebu ibariina aree naat han tamaab kiikeen. Ani bareeh hargwaa giigsi kaadi tari baraah usalaliib dhibi iyadna.” idi. <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Ikwiriyaatayaah igwibiina, “Oon umingaayiib oodehay kassooh mheen hadhi naad nimeer?” idiin. <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Yasuuꞌa bareeh raatiya, “Naaka hadhi tibariina?” idi. Baraah “Asarama hadhiiwwa shalik dadis aashoowwa nibari.” idiin. <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Yasuuꞌa uudehay whaashiib nꞌati eesitꞌaneet toona sooya. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Malya baruuh yhadhi yꞌasaramaawwa yꞌaashoowwa iyhaayt, Ukwaasana yhamidayt harꞌii, bareeh katꞌiya. Malya ikwiriyaatayeeh yhii, aree ikwiriyaatay oodehay yhiin. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Baraah kassaah tamiyaaniit gabiyaan. Malya ikwiriyaatay biileeb yakisiyaaniit toodhikw yhadhiyi firkak asarama biili hooy toobiyaan. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Timꞌari tamiyaan uudehay fadhig alfa iiktiina, aree mꞌatwa nisrikaabwa geeb iifiin. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Yasuuꞌa oodehay giigisiyaayt harꞌii, tufalluuka yꞌamaayt Majdaani haash ibi.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Alaamaati harawa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Fariisiiwwa Sadduukiiwwa Yasuuꞌii dehaay eeyaaniit barooh jarrabtiib yhariwna. Baraah tibreetee alaamaati rhisti hooy yhariwna.<verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />Yasuuꞌa igwibi, “Tuuyin oodhib danwiilihoob ‘Tuuyin adaroot tikatiyeek uujaw ishbuub indi.’ tiyadna. <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Fajir aree ‘Teebri adruur hooy eefi thibnamaata akay amsi biri yaami indi.’ tiyadna. Baraak teebri shibibtiit naan iikti tindiyeeb gidtiit tikteenna. Laakiin idamaneet alaama fassari kitdiina. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Amaag dehaywa wꞌiimaan baabariinwa alaamaat raateen! Laakiin unabi Yuunisiit tꞌalaama nuun weena soomami kitdi.” idiit Yasuuꞌa yꞌish giigiya.<verse eid="MAT 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Baraah oobhar ikitꞌanihoob, ikwiriyaatay yhadhiyi yaksiti ibaadhinna. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yasuuꞌa bareeyooh dehaay, “Digwagwna, igarooyeekna gwꞌadna, Ifariisiiwwa Isadduukiiwwa hamiir hooy sifanna.” idi.<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Baraah toon toona taktak haay sakanaayaana, “Tuun tuuna hadhiib yaksaab kinki akay tikati.” idiin.<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Yasuuꞌa ibhaliyeehna iktiinayt, bareeh raatiya, “Baraak ishalik iimaani, yhadhiyi naawiib naanhooy taktak sakanaateena? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Masi afhamaab kitteena han? Yhadhi yꞌay, ay alfa dehay tamiyaaneeb kashꞌitaana han? Aree naaka biili toobamaab tidbilneeb kashꞌitaana han? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Tari yhadhi yꞌasarama fadhig alfa dehayiib aree? Naaka biili toobamaab tidbilna? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Baraak kak kaꞌafhamtaana? Ani hadhiyeeb dehookna hadiidaab kaaki. Laakiin Ifariisiiwwa Sadduukiiwwa hamiirii sifanna. <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Malya baruuh whamiir yhadhiyeeb daamiiniinaay gwꞌadaadtiib hadiidaab biikaayeet toona baraah ikanna. Laakiin Ifariisiiwwa Sadduukiiwwa tꞌaliimii sifanna miyaad iiktiyeet toona ikanna.” idi Yasuuꞌa.<verse eid="MAT 16:12" /></para>
  <para style="s">Yasuuꞌa aabu?</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Yasuuꞌa Gaysariyaab Filiibusi haashiib eeyanihoob, ikwiriyaatayeeh raatiya, “Uudehay Wꞌaadami Oor aabu iyadna?” idi.<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Baraah igwibiina, “Gwadi Yuuhanna umoosana iyadna, wari Eelyaab iyadna, masi wari Irmiyaab tari inabiyaayee gaalu iyadna.” idiin.<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Yasuuꞌa “Baraak aree? Ani aabu tiyadna?” idi.<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Siimoon Bitrus igwibi, “Baruuk Umasiih tikatiya, Ukwaasana udhhaniinaay Oor.” idi.<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Yasuuꞌa bariiyooh dehaay, “Siimoon Yuunisi oor, baruuk baarakamaabwa, tuun tuuna dehayii dehook lawaat kitti. Laakiin Baabu tibreeteeb eefi dehook lawisiya. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Ani andi hook Bitrus baruuk liilaawwa, oon uliilaawi kehii aree tukaniisaatu iidꞌir andi, tuuyat tuukna han batooh iigrib kitdi. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Tibreeteet hadꞌaayeeti imiftaha iyaaw hook andi. Baruuk tubuutiib hankwiireet tuuna, tibreeteeb han itehikwir tindi. Tubuutiib fandiigeet tuuna aree tibreeteeb han itfidig tindi.” idi. <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Aflaay Yasuuꞌa ikwiriyaatayeeh baruuh Umasiih ikatiyeet toona dehay biisooyayneet toona sooya.<verse eid="MAT 16:20" /></para>
  <para style="s">Yasuuꞌa tuyatooh hadiidiya</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Been oodoori harꞌii, Yasuuꞌa Algudus bayiit yꞌeegrimaawwa, ifagiiriya isuurkinaawwa, whaggi koojaayi ayeebwa gwidaat lhanay ibakii lhami indiyeet toona, ikwiriyaatayeeh sooya. Ibakii itoodiireet toonaawwa, tooyin tumhayaatiib laakiin dhhantiit yakiiniyeet toonaawwa sooya.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Bitrus barooh haay itfalaayt dinneeb badooya, “Abadan Wꞌankwana! Tuun iikti kitdi!” idi.<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Yasuuꞌa bariiyooh nakamiyaayt, “Yaa uubliis, hoosu sigiya! Baruuk usalaliib iigifheeb tindiya. Baruuk Ukwaasanaayt tinaateeb kitkwina, laakiin udehayiit tinaateeb tinkwiina.” idi.<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Malya Yasuuꞌa ikwiriyaatayeeh dehaay, “Anii harꞌii gaal han yꞌiiniyeek, ugarooyooh ibakii ankiriini aree usaliibooh ibakii yaksiini, malya eetriimheeb. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Umidhhanooh dibuuy harriiwka, umidhhan kwidhsi indi. Laakiin anii jillaay umidhhanooh kwidhsiiniibka, umidhhan imaar indi. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Tak kastooh tuduniya manriyeek, laakiin infiseeh eetniiweek, naan daayiina imaar indi? Tari uutak infiseeh naanaatiib bandiil? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Wꞌaadami Oor Baabiyooh umatuuniib, imalakeeyooh geeb yꞌi indi. Malya nafarka toona tidꞌiyaab ikatiyeet ijir dehaay iyaaw indi. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Ani oosdik andi hookna: gwadi tooy ingadiin eefeena, Wꞌaadami Oor tehadꞌaayeetiyooh yꞌee rhaab baakaay tooyat dꞌamsi kiidiin.” idi.<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Yasuuꞌiib umatuun usidkiib</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Asagwit yinaati harꞌii Yasuuꞌa Bitruswa, Yaaguubwa oosan Yuuhannaawwa geebooh giigisiya. Malya bareeh eekna tageega riba beeti haay reewiya. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Baruuh beentooy ikwiriyaatayi suurii ibdal. Aafiir tuyintiit talawiyaana, aree yhalakaayaah utalawiit eeraab iiktiin. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Malya beentooy bareeyooh suurii Muusaawwa Eelyaawwa Yasuuꞌaab bhaliisamee dehaay lawiyaan.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Bitrus Yasuuꞌii dehaay, “Wꞌankwanaay, hinin tooy daanayeet tuuna daayiiti. Baruuk harriiweek, ani mhay gawa iidꞌir andi. Gaal bariiyook dehaay, gaal Muusaay dehaay, aree weer Eelyaay dehaay iidꞌir andi.” idi.<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Baruuh masi hadiidee, eera bꞌaluuk bareeyooh kehii daaya. Aree ibꞌaluukii hiss itmassaaw, “Uun baruuh Wꞌooru ani areeyaniyeebu, ani bariiyooh geeb winneet afirhaabi. Barooh sinaakirna!” iid.<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Ikwiriyaatay een imaasiwnihoob, ifiiree nꞌati whaashiib dhibiyaaniit irkwiin. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Laakiin Yasuuꞌa eeyaayt bareeh tehiya, “Asti gadna, baarakwiina.” idi. <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Baraah asti ishbibnihoob, Yasuuꞌaab nuun weer gaal han rhaab kiikeen.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Baraah oorbaay gidehee, Yasuuꞌa bareeh sooya, “Toona turhitaaneet Wꞌaadami Oor tuyatii yakiiniyeeb ookiik gaal han baasooyaana.” idi.<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Ikwiriyaatay barooh raatiyaana, “Aflaay whaggi kooja Eelya ibakii hankaab yꞌiini naanhooy iyadna?” idiin.<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Yasuuꞌa “Eelya sidik whankaay yꞌiini, aree baruuh naatka isuumir indi. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Laakiin ani andi hookna: Eelya suur akay eeya laakiin baraah kanaab kiikeen. Baraah yhiriwneena kastooh hooy sakiyaan. Wꞌaadami Oor han bak tꞌiiteena hooy saki iyadna, aree bareeyeehna yꞌayeeb lhami indi.” idi. <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Malya ikwiriyaatay baruuh Yuuhannaab umoosanaay hadiidiyeet toona afhamiyaan.<verse eid="MAT 17:13" /></para>
  <para style="s">Yasuuꞌa oor jin hooy iifiineeb mheeliya</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Baraah oodehay igwidaab beeti eeyaanihoob, tak gaal Yasuuꞌaab idwilaayt bariiyooh suurii ignaf. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />Uutak “Wꞌankwanaay, wꞌooru dehaay nꞌakwmanaaya, barooh jin abkaaba aree winneet gwirhaayeeb eefi. Baruuh diimaab tunꞌeetiib dhibiini tari iyameeb dhibiini. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Barooh ikwiriyaatayeek dehaay haay yꞌan, laakiin barooh imheelti adgiraab kiikeen.” idi.<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yasuuꞌa “Baraak wꞌiimaan baabariinwa, wꞌamaag dehaywa, ani naadoor ookiik geebookna iistꞌa andi? Ani naadoor ookiik geebookna daayi andi? Wꞌoor tooy haay mꞌaana.” idi. <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yasuuꞌa eejin idnin, aree baraah wꞌoorii ifirꞌana. Aree beet tumiddaatii wꞌoor mheelamiya.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Malya ikwiriyaatay Yasuuꞌii dehaay eeyaaniit, barooh oodꞌooh bhaliisamiyaana, “Eejin hooy imhalti naanhooy adgiraab kinki?” idiin.<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Yasuuꞌa “Baraak winneet shalik iimaan tibariinayt adgiraab kitteen. Oosdik andi hookna: Shalik iimaan isinfaayt habbaati haddiib tiibriineek, oon oorba ‘Tooysii hantaayaat beentooy bayaa!’ tiidneek, uurba hantaayi. Bareekna dehookna akraana kitehaay. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Laakiin tuun tuuna siileeltiiwwa baaskiitiiwwa nuun tikatiina kitti.” idi.<verse eid="MAT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Baraah Jaliil beeti hiddaab eeyaanihoob, Yasuuꞌa bareeyooh dehaay, “Wꞌaadami Oor dehayi ayeeb nuunami indi. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Baraah barooh iidir iyadna, aree tooyin tumhaya tooyat hooy yakami indi.” idi. Aree ikwiriyaatay winneet gadabiyaan.<verse eid="MAT 17:23" /></para>
  <para style="s">Udiini gawiib titilba</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Yasuuꞌaawwa ikwiriyaatayaahwa Kafarnaahuum iktimnihoob, udiini gawi tilbaat lakkatana Bitrusii dehaay eeyaaniit, “Ukoojaayuukna, Ukwaasanaay ugawiit tilba kwansi han?” idiin.<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Bitrus “Awooh titilba kwansi.” idi.</para>
  <para style="p" vid="MAT 17:25">Bitrus oogaw shuumiyanihoob, Yasuuꞌa hankaab hadiidiya, “Siimoon, naan tinkwiina? Tubuuti hadꞌa tuwaajibwa titilbaawwa aay iyayna? Yꞌareesoohna iyayna han weer dehayii iyayna?” idi.<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Bitrus “Weer dehayii iyayna.” idi.</para>
  <para style="p" vid="MAT 17:26">Yasuuꞌa bariiyooh dehaay, “Aflaay yꞌaraahna titilba kiifirꞌana. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Laakiin aflaay bareeh nisehasiyeet toona kinhariw. Baruuk oobhar bayaat sinnaarook gidaa! Wꞌaashu hankaab tꞌanbiikeeb ooyaf haaksaa aree fadhig girsha imaar tindiya. Eegrish yaksaat bareeh hiiyya, aniit titilbaawwa tubariitookwa haay kwisiya.” idi Yasuuꞌa.<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Aaw winkaabu?</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Been oodoor ikwiriyaatay Yasuuꞌii dehaay eeyaaniit raatiyaana, “Tibreeteet hadꞌaayeetiib uuwinkaab aabu?” idiin.<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Yasuuꞌa dis oor waliikiyaayt, bareeyooh bitik isingad. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Malya baruuh “Oosdik andi hookna, baraak gayyarameetiit yꞌar idadis tꞌiiteeb iikti bitdiineek, tibreeteet hadꞌaayi door han shuumi kitdiina. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Shaawti oon wꞌooriit ugarooyooh isoodiiska, tibreeteet hadꞌaayeetiib oowinkaab ikati.<verse eid="MAT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5" />Aree oon wꞌoor oodis tꞌiiteeb aniib oosmii daayiib anshiishka, aneeb han daayiib anshiishheeb. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Laakiin een bareeh idabalooya aneeb aamaneen gaal maagnaayt isidꞌiibka, barooh bidhdhigil riyaati awi tꞌalaatiyooh hakwirtiit ubhariit hooytiib uudhib dehaay hanyiis.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />Oodehay maagnaayt isidꞌiint tinaati sabbii, tuduniya iidhikw tindi. Taan taana ibakii yꞌeena, laakiin bariisooh yꞌeeneeb uutak idhikw. <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Wꞌayuuk tari uragaduuk maagnaayt saksiiniyuuk, hook kitꞌaat fidna gidaa. Baruuk malu ayi tari malu ragada barii toonꞌi tudaayimtiib tꞌatoogidooytiika, garbamaa tari katꞌamaa umidhhan udaayim ishuumti dehook hanyiis. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Ugwꞌaduuk maagnaayt saksiiniyuuk, hook firꞌaat fidna gidaa. Malu gwꞌadaayee toonꞌi jahannamiib tꞌatoogidooytiika, gaal gwꞌadii umidhhan ishuumti dehook hanyiis.<verse eid="MAT 18:9" /></para>
  <para style="s">Wꞌargin ukwidhaanaay mitaal</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Een bareeh idabalooya baaꞌabaabaana. Ani andi hookna: imalakaahna tibreeteeb eefeena, aree diimaab Baabu tibreeteeb eefeenaay eefiir rheen.<verse eid="MAT 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 18:11" />Wꞌaadami Oor toona tukwidhaat ismariyi jillaay yꞌaabi. <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />Naan hiisteena? Tak sheeb arginaab ibariyeek, aree gaal kwidhiiniyeek, yꞌashshadhig tamuunwa yꞌashshadhig oorbaay kehii ishti dꞌiit, oongaal ukwidhaab kiihariw han? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Ani oosdik andi hookna: oon wꞌargin manriyeek, yꞌashshadhig tamuunwa yꞌashshadhig geeb iifiinneeka, been wꞌargin oongaalnaay afirhakaab iikti indi. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Oontꞌaaneet Baabuukna tibreeteeb eefi een bareeh idabalooya gaal han hooy kwidhsiiniyeet kiihariw.<verse eid="MAT 18:14" /></para>
  <para style="s">Uusan maagnaayt hookna sakiiniib</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Sanuuk maagnaayt hook sakiiniyeek, giigaat igalateeh rhisa. Aree mhallaakna tehalaagaay tikwikwna. Baruuh isnaakiiruuk, usanook dehaay ansiramta. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Laakiin baruuh biisinaakiiruuk, tak gaal tari maloob warib geebook yaksa, halaagaaytka maloob tari mhay nafaraayeet badehaatee tikati. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Baruuh ibadehi inriibeek, tukaniisi sooyaa. Tukaniiseeti bhali han tisnaakirooy inriibeek, barooh oodiin baabariib tari utilbaat lakkatanaayt shibiba.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />Ani oosdik andi hookna: baraak tubuutiib tehankwiirneet tuuna, tibreeteeb han itehikwir tindi. Baraak tubuutiib tifadigneet tuuna, tibreeteeb han itfidig tindi.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />Masi gwidaana sooyi hookna andi: maloob bareesookna tubuutiib naat gaanaatiib taafagsameetiit raatteeneek, Baabu tibreeteeb eefi dehookna iitkwikw indi. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Aniib oosmii maloob tari mhay gaal mhiin hiddaab yꞌeeneek, beentooy ani bareeyooh geeb eefi.” idi.<verse eid="MAT 18:20" /></para>
  <para style="s">Ukishiya wꞌakra manaayi</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Malya Bitrus Yasuuꞌii dehaay eeyaayt, “Wꞌankwanaay, usanu maagnaayt hoosu sakiiniyeek, naaka doora afooyani? Asarama doora hadiit?” idi.<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yasuuꞌa “Ani andi hooka, asarama doora kiikeena, laakiin asarama tamuunwa asarama doora.<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />Shaawti tibreeteet hadꞌaayi, whadꞌa ikishiyaayeeh haasabsamtiib yharriiw tꞌiiteeti. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Baruuh beet toonaati tikwuukw badooyanihoob, barooh gwida milyoona mhallagaab iishik tak dehaay haay eeyaan. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Baruuh baliib imhallagaayi kwisuuy adgiraab kiiki. Imhallagaayi ankwana baruuhwa tutakatuuhwa, yꞌaraahwa, kassuuh umraayuuhwa dilabtiit, uudeen haay itkwasiyi jillaay sooya.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />Ukishiya whadꞌaay suurii dhibiyaayt, ‘Diiseet hoosu sakaa, imhallagaayeek kasseeh ikwaas hook andi.’ idiit barooh yꞌajar.<verse eid="MAT 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 18:27" />Ukishiyaay ankwana dehaay nꞌakw manaayaayt, oodeen afooyaayt barooh ifdig idꞌi.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />Laakiin been ukishiya ifirꞌihoob, weer kishiya barooh sheeb diinaar inshiik imri. Barooh tꞌala yꞌabikayt iskit, ‘Imhallagaayi kwisiyaheeb!’ idi.<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />Uun ukishiya wꞌaraawuuh bariiyooh whii ignafayt barooh yꞌajar, ‘Diiseet hoosu sakaa, ikwaas hook andi.’ idi.<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />Laakiin baruuh irib. Idifayt kasseeh imhallaga ikwisiyeeb ookiik oon ootak sijin shuumisiya. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Ikishiya aaraw uun ukishiya sakiyaneet toona rhiyaanihoob, winneet yhaseeniit wꞌankwanaayoohna toona tutikeet kastooh sooyaan.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />Malya wꞌankwana ukishiya waliikiyaayt, ‘Baruuk wꞌamaag kishiya, baruuk tꞌajarheeb akay kassooh oodeen afooyan hook. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Aflaay ani han barook afooyaneet toonaatiit, baruuk han ukishiya wꞌaraawook dehaay nꞌakwmanaaya.’ idi. <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Ukishiyaay ankwana yhasaayt barooh jasaamiyi jillaay oosjin istoob, malya kasseeh imhallaga ikwiiseeb ookiik oosjin idꞌi.<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Usanook uginꞌiisook afooyi bitdiiyeek, Baabu tibreeteeb eefi han kasseekna bak iiwari hookna indi.” idi Yasuuꞌa.<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Ifadag</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Yasuuꞌa teen teena idiit harꞌii, Jaliilee giigiyaayt, Urduni bhar oodar ooraaw iifiib Yahuudaay whaash ibi. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Gwida dehay barooh iramna, aree baruuh bareeh beentooy mheeliya.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Fariisi gwadi jarrabiini jillaay bariiyooh dehaay eeyaan. Baraah barooh raatiyaana, “Uutak takatooh ikati sababiika fandiigeet tuuna halaalu?” idiin.<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Yasuuꞌa “Ukhaalig whankaay kwaabwa rabaabwa akhligiyaneet toona baraak agriiyaab kitteena han? <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Malya Ukhaalig, ‘Oon usabbii uutak ifarooyeeh ishti dꞌiit, takatiyooh geeb gaal ikati, mhallaahna aree hiddaab gaal bashar ikatiin.’ diyaabi. <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Aflaay baraah maloob kiikeena, laakiin gal ikatiin. Shaawti Ukwaasana shaawawiyaab ikatiyeet toona, wꞌaadami biisehaggiil.” idi.<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Baraah raatiyaana, “Aflaay unabi Muusa: tak takatooh fandiigihoob, fadageet waragt iniiwka giigsiini naanhooy diyaabu?” idiin.<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Yasuuꞌa igwibi, “Bareek iginꞌaayaakna akraabayt Muusa ifadag dehookna ajjasiya. Laakiin whankaay bak kiiki. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Ani andi hookna: tootakat tootkaal aagib nuun weer sabbii fidigtiit takat weet indꞌiir uutak jiknaab ikati.” idi.<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Ikwiriyaatay bariiyooh dehaay, “Aflaay ootakwa tootakatwa eebtik bak tikatiyeek, shaawti idꞌari naaw hanyiis.” idiin.<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Yasuuꞌa igwibi, “Laakiin baliib Ukwaasana hiiyyaab ikatiyeeb nuun, een ibhali uudehay kassaah kaꞌagbiliyaan. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Uudehay gwadi eedꞌar kaꞌadgiriyaana, baraah kooteeb akay faraya. Gwadi aree dehay wari kooteeyaaba. Aree wari eedꞌar tibreeteet hadꞌaayeeti jillaay kiidꞌirna. Teen bateeh agbiliiniib uutak, toon toona basaki.” idi.<verse eid="MAT 19:12" /></para>
  <para style="s">Yasuuꞌa yꞌar idabalooya idehar</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Malya uudehay Yasuuꞌii dehaay dabalooya ar haay eeyaaniit, bareeyooh kehii yꞌayeeh daaseetiit baarakiiniyeet toona isehariwna. Laakiin ikwiriyaatay oon oodehay bareeh haay eeyaan idaaninna.<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />Yasuuꞌa “Yꞌar idabalooya haay mꞌaanaheeb, baaꞌafiina! Tibreeteet hadꞌaayi een bareetooh tikati.” idi. <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Baruuh bareeyooh kehii yꞌayeeh daasiyaayt harꞌii, beentooysii giigiya.<verse eid="MAT 19:15" /></para>
  <para style="s">Adhami oor gabaab</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Oontꞌa tak Yasuuꞌii dehaay eeyaayt, “Seedna, umidhhan udaayim amanriyi jillaay ibakii naan daayiina sakaniyeet toonaatu?” idi.<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Yasuuꞌa bariiyooh dehaay, “Naanhooy daayiinaayt raattiniyaheeb? Udaayi Oongaal oobhaat ikati. Umidhhani shuumti harriiweek, tiwasi sinaakira.” idi.<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Uutak “Tiwasi keeyaanta?” idi.</para>
  <para style="p" vid="MAT 19:18">Yasuuꞌa “Baadiira, baajakiina, baagwihara, gwisreet badeha baabideha, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />Ifarooyeek hamooysa, ushawawook ugarooyiitook areeya” idi.<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Wꞌoor wꞌadhami, “Teen teena kasteeh sakan, masi weena naan nakwisu.” idi.<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yasuuꞌa “Winneet timmiimi tindiyeek, tibariiyeenaaka dilibaat imiskiina hiiyya. Aree tibreeteeb miraay imaar tindiya. Malya mꞌaat, ramaheeb.” idi.<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Wꞌoor wꞌadhami een ibhali imaasiwihoob, baruuh gwida miraay iibri akay, gadabaa fidnaab giigiya.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Malya Yasuuꞌa ikwiriyaatayee dehaay, “Ani oosdik andi hookna: tibreeteet hadꞌaayi gaba taki ishuumti akraanaati. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Masi andi hookna; gaba tak Ukwaasanaayt hadꞌaayeeti ishuumtiika, kaam ibraatiit tilꞌiitii ishuumsiti laamakaabi.” idi.<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Ikwiriyaatay toon toona imaasiwnihoob, winneet ajjabamiyaaniit, “Aflaay aaw iidhhan indi?” idiin.<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yasuuꞌa bareeyooh nakamiyaayt, “Naat gat Ukwaasana baakaay uudehay biiꞌadgirayneet eefeena, laakiin Ukwaasanaay dehaay naatka laamaati.” idi.<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Bitrus bariiyooh dehaay igwibi, “Hinin naatka ningad nidꞌiit barook niram. Aree hinin beentooy naan dehoon iikti tindi?” idi.<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yasuuꞌa bareeyooh dehaay, “Ani oosdik andi hookna: Wꞌaadami Oor umatuuniit tehadꞌaayeetiyooh eesitꞌihoob taan taana masi gayiimi iyadna. Baraak aneeb iram han tamna maloot hadꞌaayeeteeb iistꞌa tiyadna. Tigabiila titamna malu Israaꞌiileet hikimi tiyadna. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Igawaayeeh tari isanaayeeh tari tikwaateeh tari baabooh tari deetooh tari areeh tari dirꞌaateeh, anii jillaay yꞌish uudehay kassaah sheeb haddiina gwidakaat ittiyiw iyadna. Aree umidhhan udaayim kwasaami iyadna. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Laakiin gwida awwal iifiin, wꞌagiya iikti iyadna. Aree gwida wꞌagiyaay iifiin, awwal iikti iyadna.” idi.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Wꞌinabiit dirꞌaati shagaamanaayi mitaal</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Tibreeteet hadꞌaayi, whaashikina karuumaab yakeetiit tudirꞌaatiyooh shagaameen shagaamanaab harriiw ootak, tꞌiiteeti. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Baruuh bareeh oombꞌi diinaar kiraay iniiweet toona taafagsamiyaayt, shagaamiini jillaay barooh tudirꞌaatooh istoob.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />Fajir tuusꞌa ashshadhig baruuh ifirꞌa, aree warib shagaab anu usuugi mhiin ingid rhiya. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Uutak bareeh infaraad, “Baraak han difnaat aniit tudirꞌaatiib shagaamaana, toona tꞌastehalteeneet aree iyaaw hookna andi.” idi. <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Aflaay baraah giigiyaan.</para>
  <para style="p" vid="MAT 20:5">Aree baruuh masi toosꞌa tutamna malyaawwa tumhayaawwa ifirꞌa, aree tꞌa han beet toona tookna sakiya. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Himniit toosꞌa tꞌayya ifirꞌa, masi warib oodar gadee rhiya. Baruuh bareeh raatiya, “Kassooh oombꞌi shagaab anu tooy naanhooy tingadiina?” idi.<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />Baraah “Gaal han shagaasiisaayoon kiiki akay ningadi.” idiin.</para>
  <para style="p" vid="MAT 20:7">Baruuh bareeyooh dehaay, “Baraak han difnaat aniit tudirꞌaatiib shagaamaana.” idi.<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Whawaad eeyanihoob, tudirꞌaatikina uwakiiliyooh dehaay, “Ishagaamana waliika aree ukiraayoohna kwisiya, wꞌaakhar shagaamiyaanaay badooya malya whankaaneeb ookiik kwisiya.” idi.<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />Ishagaamana toosꞌa tꞌayyaatiib shagaamiyaan eeyaaniit gaalka gaal diinaar imhallagaayeehna iyheen. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Aflaay hankaab shagaamiyaan eeyaanihoob, gwidaka mhallaga iyayneeb hiisiyaan. Laakiin baraah han gaalka eeraw tꞌiiti ijaar ikwiseen. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Baraah imhallaga iyheenihoob, shaawti udirꞌaatikinaay kehii ashkiimiyaan. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />Baraah “Aan aanda aakhar shagaamiyaan gaat saaꞌa toobhaat shagaamiyaan. Laakiin baruuk bareeh hineet tikwisiya. Hinin ishaga rabeemna, tooyin nitoodaar.” idiin.<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />Laakiin baruuh gaal oobhaanaay dehaay igwibi, “Wꞌaraawuun, ani adlimaayook kaaki. Baruuk gaal diinaarii ishagaamti taafagaab kitta han? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Baruuk imhallagaayeek ahaat difaa! Ootak aakhar shagaamiyaab han barook aniiweeb imhallaga aniiweet toona aharriiw. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Imhallagaayeesi toona teharriiweet sakaniyeet toona kitti han? Tari ani baakaash akatiyeet toonaati sabbii baruuk haasadtiniyaheeb han?” idi.<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />Yasuuꞌa “Aflaay wꞌagiyaay iifiib awwal iikti indi, awwal iifiib aree wꞌagiyaay iikti indi.” idi.<verse eid="MAT 20:16" /></para>
  <para style="s">Yasuuꞌa masi tuyatooh hooy hadiidiya</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Oontꞌa Yasuuꞌa Algudus beeti giigiyeet midda, ikwiriyaatay itamna malu haay itfalayt, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Hinin asti Algudus beeti niibi niyad, Wꞌaadami Oor aree ifagiiriya isuurkinaawwa, whaggi koojaawwa nuuni iyadna. Baraah barooh yat haakami iyadna. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Aree baraah barooh ijintiili nuuni iyadna, aree ijintiili barooh haay kashi iyadna, iithꞌa iyadna, malya sallabi iyadna. Laakiin tooyin tumhaya tooyat hooy yaki indi.” idi.<verse eid="MAT 20:19" /></para>
  <para style="s">Tuundi hooy tehariw</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Malya Sabadiib yꞌareet tuundi yꞌareeyooh geeb Yasuuꞌii dehaay eetaayt, bariiyooh whii tignaf. Bariiyooh naat tehariw.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Yasuuꞌa “Naan harriiwii?” idi.</para>
  <para style="p" vid="MAT 20:21">Batuuh “Tehadꞌaayeetiyook een yꞌari imalu gaal umaygwadook ooraaw aree utarhagwadiyook dehaay tisoosꞌeet toona waadiyaayaheeb.” tidi.<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Yasuuꞌa bareeyooh dehaay, “Naan raatteeneeb baraak kitkanna, ani gwꞌi andiyeeb ookaas igwꞌiti adgirteena han?” idi.</para>
  <para style="p" vid="MAT 20:22">Baraah “Adgirnay” idiin.<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Yasuuꞌa bareeyooh dehaay, “Baraak sidik aniib ookaas hooy gwꞌi tiyadna. Laakiin aniib umaygwad tari utarhagwadii dehaay imiisꞌa aneeb kaaki wꞌiniiw. Aan imhiinan Baabu dehaay soomraab ikatiyeeb baliineeb ikatiin.” idi.<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Ikwiriyaatay itamin toon toona imaasiwnihoob, isana imalooyee yhaseen. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Yasuuꞌa bareeh hiddaab waliikiyaayt, “Ijintiili haakma bareeyooh kehii ankwanaab ikatiineet toona yhariwna, aree idaabtaayaahna iwawin bareeyooh kehii hadꞌaameeneet toona baraak tikteenna. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Baraak bak kitteena. Bareekna gaal hookna irawi kehii matuun harriiweek, ibakii eeraw shagaamiini. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Suurii daamtiib harriiwka, ibakii eeraw shagaamiini. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Wꞌaadami Oor akhdimamiiniyee dehaay yꞌaab kiiki, laakiin akhdimiiniyee dehaay yꞌaabi. Aree gwidaana jillaay umidhhanooh iniiwee dehaay yꞌaabi.” idi.<verse eid="MAT 20:28" /></para>
  <para style="s">Yasuuꞌa malu da hamashayaab mheeliya</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Yasuuꞌaawwa ikwiriyaatayaahwa Ariihaay giigeeneet midda, gwida dehay bareeh iramna. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Malu da hamashaya usalali dar iistꞌana, Yasuuꞌa hasamiini diyee imaasiwnihoob, baraah waliikiyaana, “Wꞌankwana, Daawidi Oor, dehoon nꞌakwmanaaya!” idiin.<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Uudehay igwida bareeh idaaninna, aree tim ikatiineet toona sooyaan. Laakiin baraah masi tageegisiyaani waliikiyaaniit, “Wꞌankwana, Daawidi Oor, dehoon nꞌakwmanaaya!” idiin.<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Yasuuꞌa ingadaayt bareeh waliikiya, “Naan dehookna sakaniyeet toona tehariwna?” idi.<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Baraah “Wꞌankwanaay, rhinayeet toona nhariw.” idiin.<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Yasuuꞌa bareeh dehaay nꞌakwmanaayaayt eegwꞌad tehiya. Aanda willa aagwꞌad rhiyaaniit, barooh iramna.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Yasuuꞌa Algudus ansiramaa shuumiya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Baraah Algudus idwilnihoob, Isaytuuni Ribaay kehii tiifiit Beetfaagiib eeyaan. Yasuuꞌa malu kwiriyaatay diigwatiyaayt, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />bareeyooh dehaay, “Suurookna teefeet tugariya beena, aree beentooy gaalhoob meekt hakwaart imaar tiyadna. Beet toomeek halkwiib aree geeb hakwaaru. Bareeh fidignaat tooy haay mꞌaanaheeb. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Gaal han naat indiyuukna, Wꞌankwana yhariw eefiyeet toona sooyaana, aree baruuh bareeh willa giigsi indi.” idi.<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Tuun tuuna unabi geebii attiyoodiyaat toona sidik tiikwsi: <verse eid="MAT 21:4" /><verse number="5" style="v" sid="MAT 21:5" />“Sihiyooniit ootii dehaay,</para>
  <para style="q2" vid="MAT 21:5">Shibibii, whadꞌaayuuk yꞌiini hook,</para>
  <para style="q1" vid="MAT 21:5">utarmuuma meeki kehii amaa yꞌiini,</para>
  <para style="q2" vid="MAT 21:5">halkwiib meeki oori kehii yꞌiini.” idi.<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Ikwiriyaatay giigiyaana, aree Yasuuꞌa sooyaneet toona idꞌiin. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Baraah toomeekwa whalkwiiwwa haay eeyaana, aree yhalakaayeehna kehii daasiyaan. Yasuuꞌa aree kehii yꞌam. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Winneet gwida dehay yhalakaayeehna usalaliib ibrirna. Wari aree yhindiyee lꞌid katꞌiyaaniit, usalaliib ibrirna. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Bariiyooh suurii giigiyaan uudehay igwidaabwa, baliin barooh iitramwa waliikiyaana,</para>
  <para style="q1" vid="MAT 21:9">“Hoosaana, Daawidi Oor! Wꞌankwanaay simii eeyaab baarakamaabu! Hoosaana itageegeeb!” iidna.<verse eid="MAT 21:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Yasuuꞌa Algudus shuumiyanihoob, tumadiina kastuuh winneet tirgasayt raatiyaana, “Uun aabu?” idiin.<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Uudehay igwida igwibiina, “Uun baruuh Yasuuꞌaab ikati, Jaliileeb teefeet Naasiraay ikatiib unabi.” idiin.<verse eid="MAT 21:11" /></para>
  <para style="s">Yasuuꞌa udiini gawiib</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Yasuuꞌa Ukwaasanaay oogaw shuumiyaayt, oodehay beentooy bꞌiishraayiin kasseeh iskwi. Aree baliin mhallaga iibdil eendeet titarabeesaawwa, tikwibheeriya iidlib eendeet tikanabaawwa bꞌoosiya idꞌi. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Yasuuꞌa bareeyooh dehaay, “Tuun tuuna kataabtu, ‘Aniib uugaw siileelti gaw ittiyoodi.’ diyaabu uuktaab. Laakiin baraakna igwiharaayi amar tikwasiina.” idi.<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Yhamashayaawwa yꞌankwalanaawwa Ukwaasanaay gawiib bariiyooh dehaay eeyaana, aree baruuh bareeh mheeliya. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Laakiin ifagiiriya isuurkinaawwa, whaggi koojaawwa teen teena tꞌajiibi baruuh idꞌiyeet rhiyaana, aree yꞌar Ukwaasanaay ugawiit hooyteeb waliikee, “Hoosaana Daawidi Oorii dehaay” diyee rhiyaanihoob, baraah haagamiyaan.<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />Baraah “Aan yꞌar iyadneet toona teemsiiwa?” idiiniit barooh raatiyaan.</para>
  <para style="p" vid="MAT 21:16">Yasuuꞌa “Awooh eemsiiw. Ooktaab agriiyaab kitteena han?</para>
  <para style="q1" vid="MAT 21:16">Uuktaab ‘Yꞌarwa inisrikaayi yafaayee</para>
  <para style="q2" vid="MAT 21:16">hamaadiit kaft tisoomira.’ diyaabi.” idi.<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Malya Yasuuꞌa bareeh yꞌish giigiyaayt, tumadiina Beetaanyaab ibi. Aree whawaad beentooy naaya.<verse eid="MAT 21:17" /></para>
  <para style="s">Yasuuꞌa tiini hindi yꞌat</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Fajir karuumaab Yasuuꞌa tumadiina agaree yharagw. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Usalaliib tiini hindi rhiya. Been whindi laakiin teerat nuun naat han hooy miraab kiiki. Malya whindii dehaay, “Shaawti door han firaay baayaksaa!” idi. Whindi willa balamiya.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Ikwiriyaatay toon toona rhiyaanihoob, ajjabamiyaaniit, “Utiini hindi kak willa bak balamiya?” idiin.<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yasuuꞌa igwibi, “Ani oosdik andi hookna: iimaan tibariineek, malya aree eetehak bitbariineek, baraak tidꞌaneet tuuna oon ootiini hindii dehaay tikeet toonaati dꞌuuy oobhaat kiiki. Laakiin baraak oon oorbaay dehaay, ‘Difaat oon ubhariib dhibaa!’ tiyadneek, baruuh saki indi. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Baraak aamanteeneek, siileelteenihoob raatteeneet toona kastooh imaar tiyadna.” idi.<verse eid="MAT 21:22" /></para>
  <para style="s">Yasuuꞌa tehadꞌaayeetooh raatamamiya</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yasuuꞌa Ukwaasanaay oogaw shuumiyaayt allamee, ifagiiriya isuurkinaawwa oodehayi eegrimaawwa bariiyooh dehaay eeyaaniit, “Teen teena aayt hadꞌaayeetii saktiniya? Aaw aree toon tehadꞌaayi yhii hook?” idiin.<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yasuuꞌa igwibi, “Ani han gaana raati hookna andi. Een tigweebneek, ani han aayt hadꞌaayeetii teen teena akwasiyeeb sooyi hookna andi. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Yuuhanna umoosana umaasiit tehadꞌaayi aay dehaay eeta? Tibreetee yꞌaatu han tari dehayii yꞌaatu?” idi.</para>
  <para style="p" vid="MAT 21:25">Baraah toon toona ibtikeehna haay infaraadniit, “Tuun batuuh tibreetee niyadeek, baruuh masi raati hoon indi, ‘Naanhooy aree aamanaab kitteena?’ iyaad hoon indi. <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Laakiin ‘Dehayii yꞌaatu’ niyadeek aree, oodehay nireekw. Baraah kassaah Yuuhannaab unabiit iyayna.” idiin.<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Aflaay baraah Yasuuꞌii dehaay, “Hinin kinkan.” idiin.</para>
  <para style="p" vid="MAT 21:27">Malya baruuh “Ani han teen teena aayt hadꞌaayeetii akwasiyeeb sooyi hookna kaadi.” idi.<verse eid="MAT 21:27" /></para>
  <para style="s">Yꞌar imalooyi mitaal</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Yasuuꞌa “Baraak naan hiisteena? Tak malu ar iibri iifi. Wꞌoor usuurkina ibaayt, ‘Wꞌooru, amsi giigaat tudirꞌaatiib shagaama.’ idi.<verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />Wꞌoor ‘Ani shagaami kaadi.’ idi. Malya laakiin baruuh ibhaliyeeh hooy yꞌagaraayt giigiya.<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />Malya ubaaba wꞌoor ooraaw ibaayt oon han oontꞌaaneet sooya. Wꞌoor ‘Iidif andi, baaba.’ idi. Laakiin baruuh difaab kiiki.<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />Een yꞌar mhalleesoohna ubaaba yhiriweet toona naayuuh idꞌi?” idi Yasuuꞌa.</para>
  <para style="p" vid="MAT 21:31">Baraah “Usuurkina idꞌi” idiin.</para>
  <para style="p" vid="MAT 21:31">Yasuuꞌa bareeyooh dehaay, “Ani oosdik andi hookna: itilbaat lakkatanaawwa, tijakiinaawwa bareeyookna hankaay Ukwaasanaayt tehadꞌaayi shuumi iyadna. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Yuuhanna usalal eeshibooneeb rhisti jillaay eeya hookna. Aree baraak barooh aamanaab kitteena. Laakiin itilbaat lakkatanaawwa tijakiinaawwa aamaniyaan. Toon toona han rhitaani harꞌii, tuubaab kitteena, aamanaab kitteena.” idi.<verse eid="MAT 21:32" /></para>
  <para style="s">Kiraaykinaayi mitaal</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Yasuuꞌa “Wari mitaal sinaakirna. Tak dirꞌaati kina inab adiyaab iifi. Tudirꞌa heetaat hooy ikwilil idꞌir, reet wha hooy iidꞌeet ifrik, aree gwꞌaadiigaayi gaw idꞌir. Malya tudirꞌa dirꞌaatkinee dehaay ikiriit iibaabiya. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Uwaaki door idwilihoob, ishagaamanaayeeh been tudirꞌa hooy kiriyaab iiktiyeeb ishagaamanaayee dehaay diigwatiyaayt, wꞌinabii wꞌadhdhooh yakseeneet toona sooya.<verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />Ikiraaykina laakiin bariiyeeh ishagaamana ikwilalniit, gaal ithabꞌana, weer idirna, umhaya aree geediyaan. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Malya masi suureeka gwidaka shagaamana bareeyooh dehaay diigwatiya. Ikiraaykina een han bak baliineeka amaagkaab iweerna. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Kasseeyooh wꞌagiyaay, wꞌoorooh bareeh beeti diigwatiya. Baruuh ‘Wꞌooru hamooysi iyadna.’ idi.<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />Laakiin ikiraaykina wꞌoor rhiyaanihoob, baraah taktakee dehaay, ‘Uun baruuh ukwasaamiiniib ikati, yakaana barooh niidir aree tikwasaateeh niyaay.’ idiin. <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Aflaay barooh yꞌabikna, aree tudirꞌaati kwayaay igidniit idirna.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />Malya tudirꞌaati kina eeyanihoob, een ikiraaykina naan iiwari indi?” idi Yasuuꞌa.<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Baraah “Baruuh een ikiraaykina maagt yat iidri indi. Aree tudirꞌa wari dehayii dehaay ikaar indi, aree baraah uwaaki door barooh wharrooy wꞌadhdhooh iyaaw iyadna.” idiin.<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yasuuꞌa bareeyooh dehaay, “Iktabeeb agriiyaab kitteena han? Aaktab:</para>
  <para style="q1" vid="MAT 21:42">‘Wꞌawi idꞌaariiga iribneeb,</para>
  <para style="q2" vid="MAT 21:42">urikwni awi udaayikaab ikati.</para>
  <para style="q1" vid="MAT 21:42">Wꞌankwana toon toona idꞌi,</para>
  <para style="q2" vid="MAT 21:42">aree hineeb igwꞌadeeb ajiibiit tikati!’ diyaabi.<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />Aflaay ani andi hookna: Ukwaasanaayt hadꞌaayi hookna giigi tindi, aree baliib batiisooh samaraat mhaleen oodehay ittiyiw tindi. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Oon wꞌawii kehii dhibiiniibka, katꞌamiit firkak iikti indi. Laakiin uun wꞌawi kehii dhibiiniyeebka, huugami indi.” idi.<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Ifagiiriya isuurkinaawwa Ifariisiiwwa Yasuuꞌiib eemtaal imaasiwnihoob, baruuh eemtaal bareeh haay isehiriweet toona ikanna. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Yasuuꞌaab haay yꞌibikni salal yhariwna. Laakiin uudehay barooh nabiib hiisiinayt, baraah oodehay igwidaab irkwiin.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Idoobi diraari mitaal</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yasuuꞌa masi bareeh mitaalee bhaliisamiya. <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />Baruuh “Tibreeteet hadꞌaayi: whadꞌa wꞌooriyeeh doobeeb diraar isoomiir tꞌiiteeti. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Baruuh oodehay tꞌaduumaatii dehaay waliikamaab waliikti jillaay ikishiyaayeeh diigwatiya. Laakiin uudehay wꞌaay iribna.<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />Malya baruuh gal wari kishiya istoobiit, ‘Been oodehay ani waliikaab akatiyeeb sooyaana, oodiraar asoomir. Yoobwa dhha shꞌaayeewwa harada, aree naatka takwaakwtu. Idoobeet aduumaatii dehaay mꞌaana!’ diina.<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />Laakiin uudehay sinaakiraab kiikeena, aree giigiyaan. Gali dirꞌaateehna ibeena, aaraw shanhoohna ibeen. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Ibaagi bariiyeeh ikishiya yꞌabikna, amaag iweerniit idaarna. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Whadꞌa winneet yhasi. Ikajareeh diigwatiyaayt, baliin imadoora idaar, aree tumadiinaatoohna iliw idꞌi.<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />Malya ikishiyaayeeh dehaay, ‘Idoobeet aduuma amaartu, laakiin baliin ani waliikaneeb wꞌaay kaꞌastehaliyaan. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Isalalaayi rikwnaayeeb sakaanaat timeerni nafarka tꞌaduumaatii dehaay waliikaana.’ idi. <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Aflaay ikishiya isalala ibeeniit, oodehay yꞌimiirneeb kasseeh idbilna. Wꞌamaagwa udaayiibwa kasseeh haay eeyaaniit, idoobi gaw amnaab itibna.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />Laakiin whadꞌa yꞌamnaayi shibuubii dehaay eeyanihoob, beentooy doobi halaka akwaay baakaay tak rhiya. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Whadꞌa ootakii dehaay, ‘Wꞌaraawuun, tooy doobi halaka akwaay baakaay kak eeta?’ idi. Uutak tim iki.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />Malya whadꞌa oodehay ishagaamana bhaliisamiya, ‘Ootak yꞌayeehwa iragadaahwa hakwirna, aree barraab uthibniib gidna. Baruuh beentooy waawi indi, aree ugirmaayooh toobuut haay iithꞌa indi.’ idi.<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />Gwida waliikamaaba, laakiin shalik waasamaaba.” idi.<verse eid="MAT 22:14" /></para>
  <para style="s">Gaysarii dehaay tilbaati mhalti</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Aflaay Ifariisi giigiyaaniit, barooh bhaliyeeb haay isꞌibikni sharakiib shagaamiyaan. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Baraah ikwiriyaatayeehna Yasuuꞌii dehaay ifdigna, Heeroodisaayi han geeb iifiin. Baraah “Seedna, baruuk Ukwaasanaay usalal sidik allamtiniyeet toona nikteen. Uudehay aaraw naan eekwinneeb hooy kitehalaaga. Oodehay aaraw aayga ikatiineeb haay kashagaamta. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Aflaay sooyaa hoon, irꞌayaak naanaata? Iroomaani Gaysar titilba dehaay nifarꞌeet tuuna daayiit han kitti? Sooyaa hoon.” idiin.<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Laakiin Yasuuꞌa baraah niyaamiineet tumaagnaay ikan, aree bareeyooh dehaay, “Baraak yharay ar, naanhooy sharakiib tikwsitiib jarrabteenheeb? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Imhallaga titilba haay tikweesneeb haay mꞌaana.” idi. Baraah diinaar dehaay haay eeyaan. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Yasuuꞌa bareeh raatiya, “Aan aay fiira? Aree uun aay simu?” idi.<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Baraah “Gaysariiba.” idiin.</para>
  <para style="p" vid="MAT 22:21">Aflaay baruuh bareeyooh dehaay, “Gaysar, Gaysariit toona hiina, Ukwaasana aree Ukwaasanaayt toona hiina.” idi.<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Baraah een imaasiwnihoob, winneet ajjabamiyaan. Aflaay barooh yꞌishniit fidnaab giigiyaan.<verse eid="MAT 22:22" /></para>
  <para style="s">Ooyakiit yinti dꞌar</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Beet tooyin Sadduuki ooyak haay baaꞌaamanaya, Yasuuꞌaab raattii dehaay eeyaan. <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Baraah “Seedna, Muusa sooyi hoon, ‘Tak firaay anu iyaayyeek, usanuuh bariitooh tootakat ibakii indꞌiir, aree bariiyooh dehaay firaay fanri.’ diyaabi. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Oontꞌa asarama sana geeboon iifiin. Usuurkina idꞌirayt iiya, baruuh ar kiibari akay, tootakatooh usanuuh idꞌir. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Oosan umalya han tuun tuuna dehaay tiikti, umhayaay wꞌasarama ookiik aree tuun tuuna tiikti. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Malya batuuh tiya. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Aflaay ooyaki bꞌi toon tootakat kassaah idꞌirneet aayt takat iikti tindi?” idiin.<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yasuuꞌa bareeyooh dehaay, “Baraak aglitaabaana, baraak eektab kitkanna, tari Ukwaasanaay akrir kitkanna. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Ooyaki bꞌi kiidꞌirna tari kiisidꞌirna, baraah tibreeteeb imalak tꞌiiteeb ikatiin. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Laakiin yꞌayaani uyaktiib, Ukwaasana sooyaneetookna toona agriiyaab kitteena han? <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />Ukwaasana ‘Ani Ibraahiimiib Ukwaasana akati, Isehaagi Ukwaasana, Yaaguubi Ukwaasana.’ diyaabi. Baruuh oodehay yꞌayaanaayi Ukwaasana kiiki, laakiin oodehay idhhaniinaayi Ukwaasana ikati.” idi Yasuuꞌa.<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Uudehay igwida een imaasiwnihoob, bariiyooh wꞌallamtiib ajjabamiyaan.<verse eid="MAT 22:33" /></para>
  <para style="s">Tiwasi hooy toowinkaat</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Laakiin Ifariisi Yasuuꞌa Isadduuki dinsiyaneet toona imaasiwnihoob, hiddaab immarraayna. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Gaal bareesooh, whaggi kooja iiktiib, toon toona raatiyaayt jarrabiya. <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />Baruuh “Seedna, Muusaay whaggiib keetaat wasi winkaat tikati” idi.<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Yasuuꞌa bariiyooh dehaay, “Wꞌankwana Ukwaasanaayook kassooh uginꞌiisook, kasseeh infiseesook, kassooh ugirmaayiisook, areeyaa! <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Tuun batuuh tiwasi tehankaaneetu aree toowinkaat tikati. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Tumalya batooh tꞌiiteetu; ushawwook ugarooyiitook areeyaa. <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Kassuuh whagwa inabiyaawwa teen tiwasi timalooteeb hakwara.” idi.<verse eid="MAT 22:40" /></para>
  <para style="s">Umasiih aay ooru?</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Ifariisi hiddaab ammarariya iifiineet midda, Yasuuꞌa bareeh raatiya, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“Baraak Umasiihiib naan teekwinna? Baruuh aay ooru?” idi.</para>
  <para style="p" vid="MAT 22:42">Baraah “Umasiih Daawidi Oor ikati.” idiin.<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Yasuuꞌa bareeyooh dehaay, “Aflaay Daawid Eeshuuk Imugaddasaayee bhaliiyihoob, barooh ‘Wꞌankwana’ naanhooy waliiki? Baruuh indi,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />‘Wꞌankwana aniib Wꞌankwanaay dehaay:</para>
  <para style="q2" vid="MAT 22:44">yꞌashooyeek iragadaayeek whii</para>
  <para style="q1" vid="MAT 22:44">akwasiyeeb ookiik,</para>
  <para style="q2" vid="MAT 22:44">aniib umaygwadii dehaay sꞌaa!’ idi.<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Aflaay Daawid barooh, ‘Wꞌankwana’ waliikiyeek, baruuh kak oorooh ikati?” idi Yasuuꞌa. <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Gaal han adgiriit bariiyooh dehaay kalmaat gwibiyaab kiiki. Aree beet tooyintii gaal han ashꞌaraa masi weena barooh raataab kiiki.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Yasuuꞌa Ifariisiiwwa whaggi koojaawwa winneet sooya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Malya Yasuuꞌa oodehay igwidaabwa ikwiriyaatayeehwa dehaay, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“Ifariisiiwwa whaggi kooja Muusaay ukwirsi kehii thatheen. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Aflaay baraak ibakii bareeh sinaakirna, aree baraah sooyeeneet toona kastooh dꞌiina. Laakiin baraah idꞌaneet toona baadꞌiina, toona baraah bhaliiyeeneet aakna haay kashagaamiyaan. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Baraah akra rabi haakwirtiit oodehayi harkaayi kehii daaseen. Laakiin baraah aakna irabi hantaaysiti jillaay, giibalaaytoohna han kehii daastiib kiihariwna.<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />Baraah sakeeneet toona kastooh oodehayi rhistiib sakeen. Baraah sanduuk iktabeet aaya hooy idꞌaneeb shagaameena, yꞌayeehwa igirmaayeehwa kehii eetkwiina, aree yhalaka isgwamiidna. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Baraah whamooysiti mhiin tꞌaduumaateeb areeyeena, aree Iyahuudi diini gawaayeeb tidaayiit miisꞌanii areeyeen. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Isuugi mhiinaneeb salaamameeneet areeyeena, ‘Seedna, Seedna’ ittiyoodiineet areeyeen.<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />Laakiin baraak ‘Seedna’ waliikami kitdiina. Baraak gaal Ankwana tibariina, kassaak aree sanaabaana. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Tubuuti kehii gaal han, ‘Baaba’ baadiina. Baraak gaal Baaba tibariina, aree baruuh tibreeteeb eefi. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Gaal han bareek, ‘Seedna’ iyaad hookna kiidi. Baraak gaal Seedna tibariina, aree baruuh Umasiih ikati. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Hookna uuwinkaab, eeraw shagaamiiniib iikti indi. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Ugarooyooh tageegsiiniib been dhoomi indi, ugarooyooh dhoomsiiniib been aree tageegi indi.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Baraak whaggi koojaawwa Ifariisiiwwa, tidhikwna, baraak yharay ar! Baraak tibreeteet hadꞌaayi oodehayi fiireeb assitaana. Baraak iknaayaakna shuumi kitdiina, baliib ishuumti yhariw aree baraak tehabiina. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Tidhikwna baraak whaggi koojaawwa Ifariisiiwwa, baraak yharay ar! Tꞌibraatfaatkiyaati gawa shuumteena, aree oodehayi rhistiib toosileel tisgwamiidna. Shaawti baraak winneet amaag jasaami tiyadna.<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />Tidhikwna whaggi koojaawwa Ifariisiiwwa, baraak yharay ar! Oobhari kehiiwwa toobuuti kehiiwwa iibaabteena, gaal tak udiinooh sibadlooyti jillaay sakteena. Baruuh gaal ikatiyihoob aree malu doora tunꞌeeti oor bareek tꞌiiteeb tikwasiina.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Tidhikwna baraak yhamashayaayi maalhiiga! Gaal Ukwaasanaay gawii halafooyiiniyeek, naat kitti miyaadi. Laakiin gaal udiini gawi dimꞌaraay halafooyiiniyeek, baruuh tehalafooytiisooh itꞌabiik. <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Baraak yhamashaya yꞌafraya! Keeya winkaabu: idimꞌara han Ukwaasanaay uugaw idimꞌara mugaddas ikwasiib? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Baraak masi, ‘Tikaraamaati mhiinii gaal han halafooyiiniyeek, naat kitti miyaadi. Laakiin bariiyooh kehii eefeent tikaraamaatee halafooyiiniyeek, tehalafooytiisooh itꞌabiik.’ tiyadna. <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Baraak aanda yhamashaya! Keeya winkaabu: uumyaaw han tari tikaraamaati mhiin oomyaaw mugaddas ikwasiib? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Shaawti been tikaraamaati mhiinii halafooyiiniib, tikaraamaati mhiinii halafooyiini, aree bariiyooh kehii teefeet toona kastooh haay halafooyiini. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Aree Ukwaasanaay ugawii halafooyiiniib, bariisooh halafooyiini, aree Ukwaasana tehooyteeb kwarriib han haay halafooyiini. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Aree tibreetee halafooyiiniib, Ukwaasanaayt tehadꞌaayi han haay halafooyiini, aree batiiyooh kehii eestꞌi han haay halafooyiini.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Tidhikwna baraak whaggi koojaawwa Ifariisiiwwa, baraak yharay ar! Baraak buuhaaraateekna; inaanꞌaawwa, tikasbaraawwa, ikammuunwa, een bareeh titamnaat takwi hooy tiyawna. Laakiin daayikaana whaggiib tiribna; wꞌadilwa, tirhamaawwa, wꞌiimaanwa, tiribna. Een bareeh haay shagaamtiineet toonaatu, eeraw han bitꞌiishneet toonaati. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Baraak yhamashayaayi maalhiiga! Iyamee itiifa tifarꞌana, laakiin kaam tikwatꞌana.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Tidhikwna whaggi koojaawwa Ifariisiiwwa, baraak yharay ar! Baraak tikwibbaaywa ooshhaanwa tisarad tisinhiisna. Laakiin tehooyteeb aree maagtwa akuushwa ataba. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Ifariisi yhamashaya! Hankaab tikwibbaaywa ooshhaaniit tehooy sinhasna, malya tisarat iinhas iyadna.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Tidhikwna whaggi koojaawwa Ifariisiiwwa, baraak yharay ar! Baraak eeraama miimash tusaraat daawriit tikatiyeeb, laakiin tehooy aya dehayiit miitatwa nhas baakayt teenaawwa, ataab umiimash tꞌiiteebaana. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Oontꞌaaneet, tisarattee oodehayii dehaay tishboobiina, laakiin tehooytaakna haraabwa maagtwa atabta.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Tidhikwna whaggi koojaawwa Ifariisiiwwa, baraak yharay ar! Baraak inabiyaayee dehaay miimashaab teedꞌirna, aree shibu dehayi miimasha daawrariisteena. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Aree baraak ‘Hoobeeyeen idamaneeb kwiraab niiktiyeek, inabiya daartiit booy kinfif.’ tiyadna. <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Aflaay ugarooyookna kehii tibadehana, baraak baliib inabiya idaar areehna tikatiina. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Aflaay hoobaakna badooyaaneet toomaag soorarimna!<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />Baraak ikwakwara, ikwakwaraayi ar! Toonꞌeeti ishuumti baraak kak hooy ifuur tiyadna? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Shaawti, ani nabiyaawwa, fagarandaawwa, whaggi koojaawwa, dehookna afandiig. Gal bareesooh baraak idaar tiyadna, sallabi tiyadna. Warib aree Iyahuudi diini gawaayeeb iithibꞌa tiyadna, aree madiinaat madiinaatii bareeh isaakw tiyadna. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Shaawti oodehay eeshbooni booy tubuuti kehii ifaf kassuuh kehookna daayi indi. Eeshbooni booy; Haabiilii Sakariyaab Barakhiyaay oor baraak Ukwaasanaay oogawwa tikaraamaati mhiinwa eebtik tidirneeb hadiit ifaf uubooy kehookna eefi. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Ani oosdik andi hookna, kastuuh tuun tuuna oon udamaani dehayi kehii daayi tindi.” idi.<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Yasuuꞌa “Yaa Algudus! Algudus, batuuk inabiya tidaarii aree idiigwatkina batiiyook dehaay diigwatamiyaab rajamootaayii. Wꞌambuuriyooh whii inisrikaayeeh tismarriit tookilaaytiit, ani diimaab udehayook asmarriyeet aharriiw, laakiin batuuk tiribii. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Shibibna, Oontꞌa ugawuukna mingaayama dehookna imhi. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Andi hookna, baraakna ‘Wꞌankwanaay oosmii yꞌiiniib been baarakamaabu!’ tiyadneeb hadiit masi rhiheeb kitdiin.” idi.<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Tuduniyaati agiyaayt alaama</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Yasuuꞌa Ukwaasanaay gawii giigiyaayt usalaliib hiireeree, ikwiriyaatayaah bariiyooh dehaay eeyaaniit, udiini gaw abniimaab iiktiyeeb eebna shibuub hooy yhariwna. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Yasuuꞌa raatiya, “Teen teena kasteeh rhiteena? Oosdik andi hookna: tooy awi gaal han uraawi kehii ituuꞌish kiidi; yꞌawi kassaah nꞌati dhadhibi iyadna.” idi.<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Yasuuꞌa oorba Saytuuni kehii iisitꞌihoob, ikwiriyaatay oodꞌooh dehaay eeyaaniit, “Sooyaa hoon, tuun tuuna nhoob iikti tindi? Bariiyook wꞌaayiib naat alaama iikti iyadna? Tuduniyaati agiya aree?” idiin.<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yasuuꞌa igwibi, “Gaal han biitil hookna, gwꞌadna. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Aniib oosmii gwida yꞌi iyadna, ‘Ani Umasiih akati.’ iyadna, aree gwidaab eetilna. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Baraak finaabwa finaay sakanaawwa iimsaw tiyadna. Laakiin baahasiikna, taan taana ibakii ikatiin. Laakiin tuduniyaati agiya masi yꞌiini. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Haashka haash weer imuuthꞌa indi, whadꞌaaka whadꞌa ooraaw iithꞌa indi. Hargwiitwa, buutiit mibꞌeestwa iikti iyadna. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Taan taana kastaah oofraayiit tilhanayti hankaay badooyeen ikatiin.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />Malya bareek haakamamiit titoodiirni jillaay nuuni hookna iyadna. Aree anii sabii kassaah uudehay iirib hookna iyadna. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Been oodoor gwida dehay wꞌiimaanii itꞌigir iyadna, baraah taktak suugi iyadna, aree taktak iirib iyadna. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Aree gwida gwisri nabiya lawi iyadna, aree gwida dehay iitlis iyadna. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Tuumaag gwidaat tikatiyi sabbii, gwida dehay ooreer hooy lalꞌi iyadna. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Laakiin wꞌagiya ookiik akraa ingadiibka iidhhan indi. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Uun tehadꞌaayeeti usakana udaayi kastooh tuduniyaatiib hadiidami indi, kasseeh yhasheeb aree badehaat iikti indi. Malya tuduniyaati agiya iikti indi.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Yint gaat shingiraana Unabi Daanꞌeel haay hadiidiyeet rhi tiyadna. Batuuh oomhiin umugaddasiib iikti tindi, (oodehay agriisaana afhisaana!) <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Malya baliin Yahuudaay eefeen ibakii eerba ookiik ifooriin. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Ugawiyooh kehii daayiiniib uutak, naati miyaayi jillaay nꞌati biitikwayeet toonaati. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Tidirꞌaateeb daayiiniib halakaayi harawaay baaꞌagaarna. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Baliin eembꞌi tinakwalayaawwa, yꞌareet dꞌooranaawwa idhikwna. <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Idhabaakna oowiyaay door tari sabtiit yint biiꞌakaayni jillaay siileelaana. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Malya been oodoor akra gwirha iikti iyadna. Baliin igwirha tuduniya akhligamtaneekka oontꞌa ookiik bareeh tꞌiiti gwirha daayaab kiikeen. Masi harꞌook han iikti kiidiin. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Laakiin Ukwaasana suur akay baliit tiyina isnakwis; baruuh sinakwisaab biikaayeek aree, gaal han kiidhhan. Baruuh udehayooh iwaasamaayi jillaay tiyina isnikwis indi. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Beenhoob gaal han, ‘Shibibna, Umasiih tooy eefi!’ Tari ‘Baruuh beentooy eefi!’ indiyuukna, baaꞌaamanaana. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Gwisri masiihiyaawwa gwisri nabiyaawwa lawi iyadna. Baraah wawint alaama iikwsi iyadna, adgireeneek, oodehay kasseeh iwaasamaab ikatiineek han iitil iyadna. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Aflaay shibibna, tuun tuuna akaat baakaay whankaay sooyan hookna.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />Shaawti gaal han sooyiiniyuukna, ‘Baruuh beentooy umingaayiib eefi.’ indiyuukna, baafirꞌana. Tari ‘Baruuh uun ikati, ugawiit tehooyteeb eefi.’ indiyuukna, baaꞌaamanaana. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Utalaw oomhii talawiiniib uyindhib han yꞌasiini. Wꞌaadami Oori wꞌaay han bak iikti indi. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Misuusinnaayt daatiniyeeb oomhiin ikwiikwꞌay kehii kwimeen.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Baliit teeyina, baliin igwirhaayi harꞌii,</para>
  <para style="q1" vid="MAT 24:29">tuuyin thibnami tindi,</para>
  <para style="q2" vid="MAT 24:29">aree tuutrig unuurooh buubsi kitdi.</para>
  <para style="q1" vid="MAT 24:29">Yhayikw tibreetee dhadhibi iyadna.</para>
  <para style="q2" vid="MAT 24:29">Tibreeteeb eefeent taana digami iyadna.<verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />Beet tooyin Wꞌaadami Ooriit alaama tibreeteeb lawi tindi. Kastaah tubuutiit gabiila gadabi iyadna. Baraah Wꞌaadami Oor tibreetee bꞌaluukiib akrirwa matuunwa barii yꞌee rhi iyadna. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Uudꞌa uuwin fuufami indi, aree baruuh tubuutiit teejha tifadhig ookiik imalakeeh iifdig indi. Baraah bariiyooh oodehay iwaasama tuduniyaati agiya gaalnaay ooraaw ookiik iidbil iyadna. <verse eid="MAT 24:31" /><verse number="32" style="v" sid="MAT 24:32" />Oon udaris aree utiini hindii kanna: utiini hindi lꞌiid nꞌakw ikati, aree taarat itfarꞌaneek, tehibi dawilt tikatiyeet toona kanna. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Baraakna han taan taana akee rhiteenihoob, uudoor dawilu, udheefa katim ikatiyeet toona kanna! <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Ani oosdik andi hookna: uun uutaas taan taana ikatiineeb ookiik iiyyi kiidiin. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Tuubuutwa taabreewwa iyaayiina, laakiin aniib ibhali door han iiyyi kiidiin.<verse eid="MAT 24:35" /></para>
  <para style="s">Uumbꞌeewwa tuusꞌaawwa atookakinaab kiikeen</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />Been uumbꞌi tari tuusꞌa naadoor iikti tindiyeeb imalak itibreeteeb kiikanna, Wꞌoor han kiikan. Laakiin Ubaaba uubhaat ikteen. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Noohiib udamaaniib tiifiit tunaatiit, aflaay Wꞌaadami Oori wꞌaayiib han bak iikti tindi. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Nooh falluukaat yꞌameeb hadiit, ukwaani hankaay iifiin eembꞌi, uudehay tamiina, gwꞌiina, iidꞌirna aree isidꞌirna. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Bareeh kasseeh uukwaan eeyaayt iyhaneeb ookiik, naan iikti tiideeb kanaab kiikeen. Beet tuuna aree Wꞌaadami Oor yꞌiiniyeeb oodoor bak iikti tindi. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Malu da tudirꞌaatiib daayeen, gaal yakami indi, uuraaw aree ituuꞌish indi. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Maloot mꞌat hiddaab harroob riyaatiib huugi iyadna, gaat yakami tindi, tuuraaw aree ituuꞌish tindi.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />Aflaay Wꞌankwanaayuukna naadoor yꞌiiniyeeb kitkannayt, baraak gwꞌadna. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Laakiin toon toona afhamaana: ugawikina whawaadiib ugwihara toosꞌa keetaat yꞌiiniyeeb ikteeniyeek, gwꞌadee naayiini. Malya ugawooh kiisigwihar. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Aflaay Wꞌaadami Oor baraak bitsꞌayaamayni door han yꞌiini akay, ibakii marna.<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Aflaay ukishiya wꞌiimaan ibariibwa ufagarwa aabu? Uun baruuh ukishiya wꞌankwana ugawiyeeh kishiya eeraw sꞌabiktiit, timꞌari udooriyooh dehaay iniiw ikati. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Been wꞌankwanaayuuh itꞌagiirihoob, bak sakee marriyeeb ukishiya, daayiina dehaay iikti tindi. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Ani oosdik andi hookna: wꞌankwanaayuuh barooh umraayooh kassooh barooh isꞌibik indi. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Laakiin ukishiya amaag ikatiyeek, aree ugarooyooh dehaay, ‘Aniib wꞌankwana idleeli, willa itꞌigir kiidi.’ indiyeek, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />aree malya baruuh ikishiya yꞌaraweeh eethibꞌeek, yhaab gwꞌanaayi geeb tamiiniyeekwa gwꞌiiniyeekwa, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />been ukishiyaay ankwana baruuh biisꞌayaamayi door yꞌiini. Aree baruuh biikaaneet saaꞌaatiib yꞌiini. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Baruuh ukishiya katꞌiit riftat iikwasi indi. Malya barooh yharay ari geeb daasi indi. Beentooy aree baruuh waawi indi, ugirmaayooh toobuut haay iithꞌa indi.” idi Yasuuꞌa.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Tamint aagiraati mitaal</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Yasuuꞌa “Beet tooyin tibreeteet hadꞌaayi, baliit lambaateehna yakisiyaaniit udooba yꞌishishni jillaay ifirꞌat tꞌaagira titamin tꞌiiteena iikti tindi. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Bataah ayt afreeyaana, aree ayt fagaraamiyaan. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Tꞌaagira tꞌafreeyaant lambaateehna yakisiyaana laakiin saliit naat han geeboohna yaksaat kiikeen. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Laakiin tꞌaagira tifagaramiyaant saliit karooraateeb yakisiyaana, tilambaateehna han geeb yakisiyaan. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Udooba yꞌee idleel, aree bataah kastaah hanꞌaariyaaniit diwiyaan.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />Whawaadi tarabeeb tageegsiyaani waliikiyaana, ‘Udooba uun ikati! Mꞌaana barooh ashishna!’ idiin.<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />Tꞌaagira kastaah ibꞌarniit tilambaateehna isoomirna. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Tꞌaagira tꞌafreeyaant tifagarnaatee dehaay, ‘Usaliitookna naat hooy hiina hoon, tilambaataan iiyaan.’ idiin.<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />Tꞌaagira tifagaramiyaant, ‘Abadan, hininwa bateekwa kasteen kamhiyaan hoon. Shaawti usaliit eedliib baliib beenaat naat igarooyeekna dehaay dilibna.’ idiin.<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />Laakiin bataah saliiti dalabii dehaay giigiinihoob, udooba eeya. Tꞌaagira tꞌamart udiraariit aduuma ookiik barooh iramna. Malya udheefa assamiya.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />Malya taaraw han eeyaaniit, ‘Seedna, Seedna, udheefa dehoon nigila!’ idiin.<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />Baruuh ‘Oosdik andi hookna: ani kaakan hookna.’ idi.<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Aflaay oombꞌi tari toosꞌa kitkanna akay daayiib gwꞌadna.” idi Yasuuꞌa.<verse eid="MAT 25:13" /></para>
  <para style="s">Mhay kishiyaayi mitaal</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Yasuuꞌa “Masi batuuh ootak wꞌiibaabiiniib tꞌiiteeti. Baruuh ikishiyaayeeh waliikiyaayt, igadhꞌeeh bareeh dehaay aamaniya. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Ikishiyaayeeb gaal ay mhallaga ashteetiib nuuniya. Weer aree maloob nuuniya, umhaya gaal nuuniya. Baruuh gaalka toona tꞌadgiriiniyeet nuuniyaayt, malya tꞌiibaabtooh isoorarim. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Uutak ay mhallaga ashteetiib nuunamiya igidiyeesooh giigiya. Malya imhallagaayeeh daasiyaayt shagaamiya, masi ay mhallaga aree rayiimiya. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Ukishiya imhallaga imalu nuunamiyaab han masi maloob rayiimiya. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Laakiin uutak gaal ashteeti mhallaga nuunamiyaab naat anu giigiya. Baruuh deelaab whaashiib ifrikayt, wꞌankwanaayeeh imhallaga hooy dhꞌishiya.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />Gwimad damaani harꞌii, een ikishiyaayi ankwana yꞌagar eeyaayt bareeh haasabiya. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Uutak yꞌay mhallaga nuunamiyaab, ay mhallaga warib haay eeyaayt, ‘Duuruun, baruuk ay mhallaga nuuntaaheeb. Shibiba, ani ay mhallaga warib rayiiman.’ idi.<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />Bariiyuuh wꞌankwana igwibi, ‘Daayiib tiweera, baruuk daayi kishiya iimaan tibariya. Baruuk shalik naateeb aamanan hook, shaawti gwidaana isꞌibik hook andi. Mꞌaa aree wꞌankwanaayook geeb afirhaa!’ idi.<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />Uutak malu mhallagaayi han eeyaayt, ‘Wꞌankwanaay, baruuk malu mhallagaayeeb aamantaaheeb, shibiba, ani maloob warib rayiiman.’ idi.<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />Bariiyuuh wꞌankwana igwibi, ‘Daayiib tiweera, baruuk daayi kishiya iimaan tibariya. Baruuk shalik naateeb aamanan hook, shaawti gwidaana isꞌibik hook andi. Mꞌaa aree wꞌankwanaayook geeb afirhaa!’ idi.<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />Malya uutak gaal imhallagaayee nuunamiyaab eeyaayt, ‘Wꞌankwanaay, baruuk akra tak tikatiyeet toona akteen, baruuk teeraayaab bitkaayeet dirꞌaati waak harriiwa, birraab bitkaayi teera danbiileet harriiwa. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Aflaay arkwiit barraab afirꞌa, aree imhallagaayeek whaashiib abis. Shibiba, aan aree bariiyeeka.’ idi.<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />Bariiyuuh wꞌankwana igwibi, ‘Baruuk amaagwa, hasra kishiyaawwa! Aflaay ani teeraayaab baakaayeet dirꞌa anwiikeet toona tikana, aree sibidaab baakaayi teeraay harroob adanbiileet toona tikana? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Aflaay daayiitu, aniib imhallaga ubanki kinaayi geeb daasaa. Ani atꞌagiirihoob, imhallagaayi maksab iyaay andi.<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />Oon barooh imhallaga hooy ahaanaat, itamin mhallaga ibariib hiina. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Uutak wꞌibari, gwidakaana ittiyiw indi, aree gwidaana ibariib iikti indi. Naat baabariib aree, tuuna baruuh ibariyeet han hooy giigi tindi. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Been ukishiya tutakweet baabari uthibniib gidna. Baruuh beentooy waawi indi, aree ugirmaayiisooh toobuut iithꞌa indi.’ idi.<verse eid="MAT 25:30" /></para>
  <para style="s">Tꞌanoowwa teeyaawwa</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Wꞌaadami Oor umatuuniisooh yꞌiiniyihoob, imalak kassaah geeb yꞌeen. Baruuh tibreeti matuuniib tehadꞌaayeetiyooh iistꞌa indi. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Uudehay kassaah bariiyooh suurii itdibil iyadna. Ushakwa tꞌanu tiyaatee wawaasiiniib tꞌiiteena, baruuh han oodehay gaal uraawiika wawaasi indi. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Baruuh tꞌanu umaygwadiyooh daasi indi, aree teeya utarhagwadiyooh daasi indi.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />Malya whadꞌa bariiyooh umaygwadiib eefeen baliinee dehaay, ‘Mꞌaana, aniib Ubaaba baarakaab ikatiyeeb baliin, tikwasaateekna ahaana. Tuduniya akhligamtaneekka tehadꞌaayi dehookna amaarti. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Ani aharagw, aree baraak tamiyeet mꞌari tehiinaheeb, ani aywi, aree baraak naat yam gwꞌastaanaheeb. Ani girbaab iikti, aree baraak tehooyteekna shuumsitaanaheeb. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Ani halakaab ashinha, aree baraak tistookwnaheeb, ani lhan, aree baraak timshabaabnaheeb. Ani sijniib iifi, aree baraak usijniib eetaanaheeb.’ indi.<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />Malya uudehay aashbu bariiyooh dehaay igwaab iyadna, ‘Wꞌankwanaay, hinin barook naadoor hargwaa rhinaayt hook tamisna hook? Tari baruuk yam yaweeb akay nhoob gwꞌasna hook? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Hinin barook naadoor girbaab akay tehooyteen shuumisna hook? Tari halakaab shinhaa nhoob nistookw hook? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Nhoob barook lhaa rhina hook? Tari nhoob aree usijneeb rhinaayt hook malya eena hook?’ iyadna.<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />Whadꞌa bareeyooh dehaay igwaab indi, ‘Ani oosdik andi hookna: een isanaayi idabalooyaayeeb gaalnaay dehaay naat tidꞌaneek, anii dehaay han dꞌiyaabaana.’ indi.<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />Malya baruuh een bariiyooh utarhagwadiib eefeen baliinee dehaay, ‘Hoosu sigiina, baraak atooꞌitaabaana, oobliiswa imalakeeyoohwa dehaay atoomraat toonꞌi tudaayim shuumaana. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Ani aharagw, aree baraak mꞌariit naat han tamsaayi kitteena. Ani aywi, aree baraak yam naat han gwꞌasaayi kitteena. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ani girbaa iifi, aree baraak tehooyteekna shuumsaayi kitteena. Ani halakaab ashinha, baraak halakaab sitookwaayi kitteena. Ani lhaa iifi, aree sijniib iifi, aree baraak amshabbaayi kitteena.’ indi.<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />Baraah han bariiyooh dehaay igwaab iyadna, ‘Wꞌankwanaay, hinin nhoob barook hargwaa tari yawee rhina hook? Tari baruuk halakaab shinhaa tari lhaa, tari sijniib haayee, nhoob rhinaayt hook amshabbaayeek kinki?’ iyadna.<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />Baruuh han ‘Ani oosdik andi hookna, een bareeh idabalooya gaalnaay dehaay han dꞌiyaab bitkaayneet toona, anii dehaay han kitdꞌiina.’ indi.<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />Malya baraah ujasa udaayim iibi iyadna, laakiin uudehay aashbu umidhhan udaayim iibi iyadna.” idi Yasuuꞌa.<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Yasuuꞌi madari harawa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Yasuuꞌa teen teena kasteeh hadiidiyaayt faayisiyanihoob, ikwiriyaatayeeh dehaay, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Whasamti Wꞌiid maloot yina dehaay mhiyaat ikatiineet toona tikteenna. Wꞌaadami Oor aree nuunamiit sallabami indi.” idi.<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Malya ifagiiriya isuurkinaawwa oodehayi eegrimaawwa, ufagiiri oowin Kayaafaas iidneeb bariiyooh oomhiin immararaayna, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />aree baraah Yasuuꞌaab taaliiti salalii abiktiit haay iidirneet hayꞌaatiib imkirna. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Baraah “Laakiin wꞌiidiit tooyin kitti, tari beentooy oodehayi bitik finaab iikti indi.” idiin.<verse eid="MAT 26:5" /></para>
  <para style="s">Yasuuꞌa Beetaanyaay imeeshimaat</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Yasuuꞌa Beetaanyaay Siimoon ubhadhiyaayi gawiib iifiyihoob, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />takat winneet alyaat shakwiint karooraatiib yaksitaayt, Yasuuꞌa mꞌariitiib kuurama, batuuh tishakwiin bariiyooh ugirmaay kehii tifif tidꞌi.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Ikwiriyaatay toon toona rhiyaanihoob yhaseeniit raatiyaana, “Naanhooy bak titehasiira?” idiin. <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Baraah “Tuun tishakwiin alya tamaniib dilibtiit malya imhallaga oodehay yhamraab ittiyiwneet toonaati.” idiin.<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Yasuuꞌa toon toona iktiin, aree ikwiriyaatay bhaliisamiya, “Toon tootakat naanhooy gallabteena? Batuuh daayiina ani kehii tidꞌi. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Uudehay yhamra diimaab geebookna daayi iyadna, laakiin aneeb diimaab imaarheeb kitdiina. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Batuuh tishakwiin aniib ubashari kehii tififihoob, aneeb tꞌatoobsooytii dehaay tisoomiiri jillaay tidꞌi. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Ani oosdik andi hookna, kastooh toon tuduniyaatiib usakana udaayi hooy hadiidamiiniyi mhiinka, batuuh tidꞌiyeet tuuna han hadiidami tindi, aree batuuh haay shꞌami iyadna.” idi.<verse eid="MAT 26:13" /></para>
  <para style="s">Yahuuda Yasuuꞌi nuunti gabbalamiya</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Beenhoob ikwiriyaatay tamna malooyeeb gaal Yahuuda Wꞌiskaaryuuti iidneeb, ifagiiriya isuurkina ibaayt <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />raatiya, “Barooh nuunaniyuukna naan iyaawheeb tiyadna?” idi. Aflaay ifagiiriya isuurkina mhay tamuun ashteeti mhallaga idhigwiiniit barooh yhiin. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Been udoorii Yahuuda Yasuuꞌaab haay nuuniyeet fursa igwꞌad.<verse eid="MAT 26:16" /></para>
  <para style="s">Wꞌankwanaay diraar</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Ufatiiri hadhiyi wꞌiidiit tooyin tꞌawwaliinaatiib, ikwiriyaatay Yasuuꞌii dehaay eeyaaniit raatiyaana, “Whasamti Wꞌiidiit timꞌari naad dehook nisoomiireet hoon harriiwa?” idiin.<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Yasuuꞌa igwibi, “Tumadiina difnaat tak gaal sooyaana, ‘Seedna diyaabu, uwaadiyaay door yꞌaabi. Whasamti Wꞌiid ikwiriyaatayi geeb ugawiyook tami andi.’ diina.” idi. <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Aflaay ikwiriyaatay Yasuuꞌa mitiyaayaneet toona idꞌiina, aree Whasamti Wꞌiid isoomirna.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Whawaad eeyanihoob, Yasuuꞌa itamna malooyi geeb mꞌariiti kehii isꞌa. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Baraah timꞌari tamee, baruuh “Ani oosdik andi hookna, gaal bareesookna iitilheeb indi.” idi.<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Baraah winneet gadabiyaaniit gaal uraawi harꞌii bariiyooh dehaay, “Aneeb nꞌalla kaaki! Wꞌankwanaay?” idiin.<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Yasuuꞌa “Tudaatiib anii geeb tamiiniib been baruuh iitilheeb indi. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Wꞌaadami Oor bariiyooh kataabt tunaatiit oontꞌa iiyyi indi. Laakiin idhikw uutak Wꞌaadami Oor intiil! Baruuh faraay biikaayeek dehaay tehiyis.” idi.<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Malya Yahuuda, Yasuuꞌa iitil iiktiib, “Nꞌalla aneeb kaaki! Seedna?” idi.</para>
  <para style="p" vid="MAT 26:25">Yasuuꞌa “Awooh han barook tikatiya. Baruuk abiiyaak tidiya.” idi.<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Baraah tamee, Yasuuꞌa hadhiib yakisiya aree yhamidaayt harꞌii, yhadhi ikitꞌa aree ikwiriyaatayeeh yhii. Malya “Yaksaanaat tamaana, uun baruuh aniib ugaru ikati.” idi.<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Malya baruuh kaas yaksiyaayt, yhamid aree bareeh yhii. Malya “Kassaakna hooy gwꞌaana! <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Uun baruuh aniib oobooy ikati. Oon bariisooh Wꞌankwana bareeyookna geeb galad danꞌi. Gwida dehay idanuubaahna afoomeeni jillaay uun uubooy eetfiif. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Ani andi hookna, Baabiitu Tehadꞌaayeetiib geebookna gayi ha gwꞌaniyeeb ookiik, shaawti masi oon wha gwꞌi kaadi.” idi.<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Malya baraah shiilaat Wꞌankwanaay dehaay idiiniit, oorba Saytuun reewiyaan.<verse eid="MAT 26:30" /></para>
  <para style="s">Yasuuꞌa Siimoon Bitrusii wꞌankirti isrid</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Malya Yasuuꞌa bareeyooh dehaay, “Oon whawaad amsi kassaakna hoosu fidnaab dhaabteena, aree iiyꞌishheeb tiyadna.</para>
  <para style="q1" vid="MAT 26:31">Uuktaab: ‘Ushakwa idaar andi,</para>
  <para style="q2" vid="MAT 26:31">tꞌanoowwa taayaawwa aree itbirir iyadna.’ diyaabi.<verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />Laakiin ani tooyat hooy yakaniyi harꞌii, Jaliil ookiik suurookna saki andi.” idi.<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Bitrus “Baraah kassaah hook ifooriineek han, ani ifuur kaadi.” idi.<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Yasuuꞌa “Ani oosdik andi hooka, oon whawaad uujiik baakuukillaayi akay baruuk mhay doora ittiwheeb tindiya.” idi.<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Laakiin Bitrus “Ani geebook atoodiireek han, ittiw hook kaadi.” idi. Aree ikwiriyaatay aaraw han kassaah bak idiin.<verse eid="MAT 26:35" /></para>
  <para style="s">Yasuuꞌa Gitseemaaneeb siileeliya</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Malya Yasuuꞌa ikwiriyaatayeeh geeb Gitseemaani iidni mhiin giigiyaayt bareeyooh dehaay, “Tooy sꞌana, ani beentooy diftiit siileeli andi.” idi. <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Baruuh Bitruswa Sabadiib yꞌar imaloowwa iyhaayt geebooh haay giigiya. Malya baruuh gadabwa hasiyaaytwa hooy daayaan. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Malya Yasuuꞌa bareeyooh dehaay, “Aniib uunfis tooyat idwil, winneet hasiyaayt itab. Baraak tooy sꞌanaat, geebu gwꞌadna.” idi.<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Yasuuꞌa dabaloot masaafa suurbeeti hiireeriyaayt, ifiiree whaashiib dhibiyaayt siileeliya, “Baabu, tuun tuuna tikatiyeek, oon ookaas hoosu nuunama. Laakiin ani aharriiweet tuuna kitꞌaki, baruuk harriiweet tikati.” idi.<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Malya yꞌagaraayt, ikwiriyaatayeeh dehaay eeya aree bareeh diwee rhiya. Baruuh Bitrusii dehaay, “Yhaana baraak gaat saaꞌaat geebu iigwꞌad kitdiina han? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Baraak gwꞌadna, jarrabamtiib bitdaayayni jillaay siileelaana. Aashuuk yhariwna, laakiin ugaru inꞌakw.” idi.<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Yasuuꞌa malya door fidnaab giigiyaayt siileeliya, “Baabu, tuun tuuna tikatiyeek uun uukaas hoosu bagiigi. Biikaayeek aree gwꞌi andi, baruuk harriiweet tuuna batiikti.” idi.<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Yasuuꞌa yꞌagar eeyanihoob, bareeh nariit eegwꞌad aabkaatuuyt, masi diwee rhiya. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Aflaay baruuh bareeh masi door weer yꞌish giigiyaayt, mhaya door siileeliya, tꞌa han beet toona idi.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Malya Yasuuꞌa ikwiriyaatayeeb yꞌagaraayt, “Baraak masi diwteena, fiinteena han? Shibibna, tuusꞌa dawiltu, Wꞌaadami Oor aree maagti dehayi ayeeb nuunami indi. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Yakaana! Giigni. Shaawti aneeb iidlib indiib uutak yꞌaabi.” idi.<verse eid="MAT 26:46" /></para>
  <para style="s">Yasuuꞌa yꞌabak</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Yasuuꞌa masi bhaliiyee, itamna malooyeeb gaal iiktiib Yahuuda eeya. Gwida dehay gadhꞌamaab bꞌadhadhaawwa kwoolayaawwa iibriin bariiyooh geeb iifiin. Bareeh ifagiiriya isuurkinaawwa oodehayi eegrimaawwa diigwataaba. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Oontꞌa uutak utoolana alaamaat bareeh imsꞌabaak, “Ani salaamaniyeeb ootak barooh ikati, abiknaa.” idi. <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Baruuh igidiyeesooh Yasuuꞌaab beeti ibi. Yahuuda “Seedna, dabaaywa!” idiit hooy yhalab.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yasuuꞌa “Wꞌaraawuun, toona dehaay yꞌaab tikatiyeet weera.” idi.</para>
  <para style="p" vid="MAT 26:50">Malya baraah eeyaaniit Yasuuꞌaab yꞌabikniit yhaakwirna. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Been oodoor Yasuuꞌiib yꞌarawee gaal bꞌadhdhooh iktim aree ilꞌib. Aree ufagiiri oowinnaay kishiyaay angwiil ithꞌa ikitꞌa.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Yasuuꞌa bariiyooh dehaay, “Bꞌadhdhook umhiinooh shuumsa! Bꞌadhadh eelꞌibiin baliin kassaah bꞌadhdhii ituudir iyadna. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Ani Baabiyu uwaliikti baaꞌadgiraayeeb hiisteena han? Baruuh anii dehaay tamna malu malaki dheesha gaal door fandiig. <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Laakiin uuktaab kak sidik ikati? Baruuh ibakii tuun tuuna bak tikatiyeet toona sooyiini.” idi.<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Been oodoor Yasuuꞌa oodehay igwidaanaay dehaay, “Ani amgwashuushaab suuriimani han? Baraak bꞌadhdhaabwa kwoolayaawwa tiyheeniit anii abuuki jillaay eetaaneek? Ani kassooh oodoor Ukwaasanaay ugawiit angaraatiib allami, laakiin abkaayiheeb kitteena. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Laakiin tuun tuuna aree kastuuh inabiya iktibneeb ikatabi bhali sidik tikwasi.” idi. Malya kassaah ikwiriyaatay barooh yꞌishni idꞌiiniit ifoorna.<verse eid="MAT 26:56" /></para>
  <para style="s">Yasuuꞌa yꞌeegrimaayi suurii</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Uudehay Yasuuꞌaab yꞌabikniit Kayaafaas, ufagiiri oowin iiktiib istoobna. Whaggi koojaawwa yꞌeegrimaawwa beentooy ammarariyaaba. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Laakiin Bitrus ikwayaay barooh imooraam, ufagiiri oowinnaay gawi hoosh ookiik imooraam. Baruuh shuumiyaayt igwꞌaadiigaayi geeb isꞌa aree toona tutiiktiit sinaakrooyt yhiriw.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Kassaah ifagiiriya isuurkinaawwa kassuuh Iyahuudi majliswa gwisreet badeha Yasuuꞌaab haay iidirneet yhariwna. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Laakiin gwida gwisri badehi eeyaaneek han, naat han miraab kiikeen.</para>
  <para style="p" vid="MAT 26:60">Aakhar malu badehi eeyaaniit, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />“Uun uutak ‘Ani Ukwaasanaay udiini gaw katꞌani, malya mhayt yinaateeb andꞌiir.’ idi.” idiin.<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Ufagiiri uuwin yakiyaayt Yasuuꞌii dehaay, “Baruuk hadiidi kitdiya han? Aan aanda iyadneet tibadeha kehook ibadehaneet naanaata?” idi. <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Laakiin Yasuuꞌa bhaliiyaab kiiki. Ufagiiri uuwin bariiyooh dehaay, “Ukwaasana Udhhaniinaay simii halafoosani hooka, baruuk Umasiih Ukwaasanaay Oor tikatiyeek sooyaa hoon.” idi.<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Yasuuꞌa “Awooh, een baruuk tindiya. Laakiin ani kasseekna dehaay andi: harꞌook yꞌiiniib udamaaniib Wꞌaadami Oor Oongaal Wꞌalyaanaay umaygwadiib sꞌee rhi tiyadna. Barooh bꞌaluukiib tibreetee yꞌee rhi tiyadna.” idi. <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />Malya ufagiiri uuwin yhalakaayeeh shatatiyaayt, “Baruuh kifuuri bhali hadiidiini! Wari badehi naanhooy nhariw? Shibibna, oontꞌa baraak ukifuuri bhali timaasiwna. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Baraak naan teekwinna?” idi.</para>
  <para style="p" vid="MAT 26:66">Baraah “Baruuh tooyat astehaliini.” idiin.<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Malya baraah Yasuuꞌiib ifiireeb tifiyaana, yꞌayeehna itaamikwniit ithabꞌana. Aaraw aree idarag ithabꞌana. <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />Malya baraah “Umasiih, dehoon sirida, aaw ithꞌa hook?” idiin.<verse eid="MAT 26:68" /></para>
  <para style="s">Bitrus Yasuuꞌa itwi</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Oontꞌa Bitrus whooshiib barraab iistꞌa, oot kishiyaat bariiyooh dehaay eetaayt, “Baruuk han Yasuuꞌi geeb Jaliileeb tiifiya.” tidi.<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Laakiin baruuh kasseeh bareeyooh suurii itwi, “Naan tindiyeeb ani kaakan.” idi.<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Malya baruuh udheefa beeti hiireeriya. Beentooy oot weet barooh rhitaayt oodehayii dehaay beentooy, “Uun baruuh han Yasuuꞌaab Unaasiraayi geeb iifi.” tidi.<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Baruuh tꞌa han masi itwi, halafooyaayt, “Oon ootak ani kaakan!” idi.<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Shalik doori harꞌii, uudehay beentooy ingid Bitrus ookiik sakiyaaniit, “Baruuk sidik bareesooh gaal tikatiya, ibhaliyaak bak mitiyaayeen.” idiin.<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Malya Bitrus ugarooyooh yꞌat aree bareeyooh dehaay halafooyaayt, “Oon ootak ani kaakan!” idi.</para>
  <para style="p" vid="MAT 26:74">Been oodoor willa uujiik kuukillaaya. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Malya Bitrus Yasuuꞌiib ibhali, “Uujiik baakuukillaayi baruuk mhay doora ittiwheeb tindiya.” diyaab iiktiyeeb ibhali shꞌiya. Malya baruuh barraab ifirꞌa aree winneet waawiya.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Yahuuda ishuukees iskit</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Fajir karuumaab ifagiiriya isuurkinaawwa oodehayi eegrimaawwa kassaah eeyaaniit immakakaarna, aree Yasuuꞌi madar niyaamiyaan. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Baraah Yasuuꞌaab yhaakwirniit Biilaatoos whaakim haay ibeeniit nuuniyaan.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Yahuuda Yasuuꞌaab nuuniyaab, baruuh Yasuuꞌaab igwabab isꞌabikneet toona imaasiwihoob, tuubiyaayt imhallaga mhay tamuun ashteetiib iiktiin ifagiiriya isuurkinaawwa yꞌeegrimaawwa dehaay yꞌagir. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Baruuh “Ani maagnaayt sakan, nhas booy atil.” idi.</para>
  <para style="p" vid="MAT 27:4">Baraah “Beet tuuna tꞌa naanaatu? Abiiyeek tikteena.” idiin.<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Aflaay Yahuuda imhallaga Ukwaasanaay gawi tehooyteeb igidaayt yꞌish giigiya. Malya baruuh giigiyaayt ugarooyooh iskit.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Ifagiiriya isuurkina imhallaga yakisiyaaniit “Een ubooyi mhallaga udiini gawi miraayi tehooyteeb idaasti hag kiiki.” idiin. <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Malya een imhallaga, oodehay igirbaani miimashaayi mhiin ikatiini jillaay, oothiin haathkiit dirꞌa haay dilbi miyaay imkirna. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Toon tunaati sabbii aree oon amsi ookiik Ubooyi Haash ittiyoodi. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Aflaay unabi Irmiya diyaab iiktiyeeb ibhali sidik iiktiina, “Baraah imhallaga imhay tamuun iyheen, Israaꞌiileeb uudehay bariiyooh dehaay kwisuuy agbilyaaneeb, imhallaga ikatiina, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />aree baraah een imhallaga suur Wꞌankwana anii dehaay diyaab ikatiyeet tunaatiit, oothiin haathkiit dirꞌa haay idlibna.” diyaabi.<verse eid="MAT 27:10" /></para>
  <para style="s">Yasuuꞌa Biilaatoosi suurii</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Beenhoob Yasuuꞌa whaakimi suurii isingadna. Whaakim aree barooh raatiya, “Baruuk Iyahuudi hadꞌaawwa han?” idi.</para>
  <para style="p" vid="MAT 27:11">Yasuuꞌa “Awooh, baruuk tindiyeeb akati.” idi.<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Ifagiiriya isuurkinaawwa yꞌeegrimaawwa atehimiyaanihoob, baruuh naat diyaab kiiki. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Malya Biilaatoos bariiyooh dehaay, “Aan baraah kehook ibadehaneet tibadeha kitmaasiwa han?” idi. <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Laakiin Yasuuꞌa naat han diyaab kiiki. Aree whaakim winneet ajjabamiya.<verse eid="MAT 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Oontꞌa whaakim aadaat iibri, wꞌiidi doorka abuukiib gaal uudehay waasiiniyiibka iifdig. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Been oodoor atookkina amaag tak abuukiib Baarabaas iidneeb iibriin. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Aflaay uudehay igwida immararaayna, Biilaatoos bareeh raatiya, “Keeyaab dehookna fiduug hoosu tehariwna? Baarabaas han Yasuuꞌaab beeb Umasiih ittiyoodiib?” idi. <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Biilaatoos baraah Yasuuꞌa hasaadaateeb haay yꞌaa barooh nuunaab iiktiineet toona iktiin.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Biilaatoos ugaadiit taawlaatiib iistꞌa, tutakatuuh toon tudiigwat dehaay tifdig, “Been ootak oonhas naat baaweera! Ani amsi bariiyooh sabbii amagt hawsa hawsooyan.” tidi.<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Laakiin ifagiiriya isuurkinaawwa yꞌeegrimaawwa oodehay igwidaab bhaliisamiyaaniit, Baarabaas fidigtiit Yasuuꞌi madar hooy yhariwna.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Biilaatoos “Een bareeh mhalleesoohna keeyaab dehookna fiduug hoosu tehariwna?” idi.</para>
  <para style="p" vid="MAT 27:21">Baraah “Baarabaas!” idiin.<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Biilaatoos “Shaawti Yasuuꞌa beeb Umasiih ittiyoodiib, kak awari?” idiit raatiya.</para>
  <para style="p" vid="MAT 27:22">Baraah kassaah “Barooh sallabaa!” idiin.<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Biilaatoos “Naanhooy? Baruuh amaagna naan gwibbaabu?” idi.</para>
  <para style="p" vid="MAT 27:23">Laakiin baraah tageegsiyaani waliikiyaana, “Barooh sallabaa!” idiin.<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Biilaatoos shaawti naan iiwiriyeeb igamihoob, uudehay winneet yhaseena aree jawiyaan. Baruuh yam yakisiyaayt oodehayi suurii yꞌayeeh ishaagwidh, “Ani oon ootaki booyii nhasu, baraak haay raatamamteena!” idi.<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Kassaah uudehay bhaliiyaana, “Bariiyuuh uubooy hini kehii badaayi, aree yꞌareeyoon kehii badaayi!” idiin.<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Malya baruuh bareeyooh dehaay Baarabaas ifdig. Laakiin Yasuuꞌaab kwirbaajii ishoothꞌa, aree barooh sallabiini jillaay nuuniya.<verse eid="MAT 27:26" /></para>
  <para style="s">Ikajar Yasuuꞌa haay kashiyaan</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Malya whaakimi kajar Yasuuꞌaab whaakimi gaw haay shuumiyaaniit, kassaah kehii idbalna. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Malya barooh yhalaka hooy ifirꞌaniit, adaarhamaash halak istookwna. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Malya ikajar kwiluuliit naweetee idꞌiiniit Yasuuꞌiib ugirmaay kehii daasiyaan. Kwoolay wꞌayiib idꞌiiniit bariiyooh suurii ignafniitka haay kashiyaan. Malya baraah “Iyahuudi hadꞌa, dabaaywa?” idiin. <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Ikajar Yasuuꞌi kehii tifiyaana, ukwoolay hooy iyheeniit haay ithꞌana, doorka ugirma haay ithꞌana. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Ikajar barooh haay kashiyaani harꞌii, whalak hooy giigisiyaaniit barooh ugamiisooh kehii idꞌiin. Malya sallabiini jillaay haay giigiyaan.<verse eid="MAT 27:31" /></para>
  <para style="s">Yasuuꞌa sallabamiya</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Baraah itfirꞌanihoob, Geerawaanee iikti tak bareeh imꞌashaash. Barooh Siimoon iidna, ootak ginuuf aduuyii usaliib isfayikna. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Malya baraah Goolgoota iidni mhiin eeyaan. Goolgoota, girmaayt miitaat miyaadi. <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Beentooy baraah Yasuuꞌa haab gwꞌamiiniib yhiin, aree wha hamiinaayt hooy shaawaaba. Laakiin baruuh dꞌamisiyaayt ugwꞌiti irib. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Malya ikajar Yasuuꞌaab sallabiyaani harꞌii, bariiyeeh yhalaka gurꞌaat igidniit imꞌadhdhaadhna. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Malya baraah nꞌati isꞌaniit beentooy barooh igwꞌadna. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Yasuuꞌiib ugirmaay kehii bak iktibna: Uun baruuh Yasuuꞌaab Iyahuudi hadꞌa ikatiibi. <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Bariiyooh geeb malu gwihara sallabiyaana, gaal umaygwadii dehaay weer aree utarhagwadii dehaay sallabiyaan. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Uudehay yhasamiin barooh neewiyaana, kashaatiib igirmaayeehna iigidna. <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />Baraah “Baruuk Ukwaasanaay ugawi katꞌiti harriiwa, mhayt yinaateeb tindꞌiira, ugarooyook shidhhana! Ukwaasanaay Oor tikatiyeek usaliibii nꞌati tikwaa!” idiin.<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Ifagiiriya isuurkinaawwa, whaggi koojaawwa, yꞌeegrimaawwa barooh haay kashiyaan. <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />Baraah “Baruuh oodehay eeraw ishidhhan, laakiin ugarooyooh ishidhhin kiidi! Baruuh Israaꞌiili Hadꞌa ikati! Oontꞌa usaliibii batikwi! Malya hinin barooh aamani niyad. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Baruuh Ukwaasana aamaniini, Ukwaasana oontꞌa barooh harriiweek baꞌishidhhin, baruuh ‘Ani Ukwaasanaay Ooru.’ iid.” idiin. <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Igwihara bariiyooh geeb sallabamiyaan han bak barooh amaag iidna.<verse eid="MAT 27:44" /></para>
  <para style="s">Yasuuꞌiit tooyat</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Nabhoob, gaalhoob kastuuh tuubuur thibinamta. Kassuuh uumbꞌi wꞌasir ookiik thibin iki. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Himniit tuusꞌa mhayt tikayihoob, Yasuuꞌa tageega hissii aadhiya, “Eelooy, Eelooy, lamaa shagabtani.” idi. Aan ibhali “Ukwaasanaayu, Ukwaasanaayu, naanhooy tꞌishaheeb?” miyaadi.<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Shalik dehay beentooy ingid beet toona imaasiwnihoob, “Baruuh Eelyaab waliikiini.” idiin.<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />Igidiyeesooh bareesooh gaal dhaabiyaayt asfoonjiib imri. Baruuh wꞌasfoonji haab hamiib itib, hindiib yhakwir. Malya Yasuuꞌa gwꞌiyi jillaay iyiw. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Uudehay aaraw “Oontꞌa barooh ookna isha dꞌiya, Eelya yꞌeetiit ishidhhiineek niishbib!” idiin.<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Yasuuꞌa win hissii masi waliikiyanihoob, ishuukeeh sallamiya.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Been oodoor whalak Ukwaasanaay ugawiib salaaw mhakwaliisii eedhoom ookiik malu mhiin ishtat. Tuubuut katatta, iliilaw katꞌamiyaan. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Imiimasha katꞌamiyaaniit ingalna, gwida mugaddasa dehayi garu suur ayaab iiktiin, yakiyaaniit idhhanna. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Yasuuꞌiit tooyati yakti harꞌii, baraah imiimashaayee ifirꞌana. Malya tumadiina tumugaddas ibeena, aree gwida dehayii dehaay lawiyaan. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Udaabitwa ikajar geeb iifiinwa Yasuuꞌaab iigwꞌad baliin, tubuuti idhti rhiyaan. Kastooh toona tutikeet rhiyaanihoob irkwiiniit ajjabamiyaana, “Sidik uun baruuh Ukwaasanaay Ooru!” idiin.<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Gwidaat mꞌat beentooy iifiint, sagi mhiinii iishbibna. Bataah Jaliilee Yasuuꞌaab iramna, baruuh yhirweet teena tikwuukw yhiriwna. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Bateeh Maryam Majdaleena hooy tiifi, Maryam Yaaguubwa Yuusifiit tuundeewwa, Sabadiib yꞌareet tuundeewwa, taan bataah iifiin.<verse eid="MAT 27:56" /></para>
  <para style="s">Yasuuꞌiit Tꞌatoobsooy</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Whawaad idwilihoob, gaba tak Raamaay iiktiib Yuusif iidneeb beentooy eeya. Baruuh uukna Yasuuꞌi kwiriya iikti. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Baruuh Biilaatoos ibaayt, Yasuuꞌiit tukinaaja hooy yhariw. Biilaatoos tukinaaja Yuusif iyawneet toona sooya. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yuusif tukinaaja yakisiya, nhas halakiib ishaamim. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Malya barooh gayi miimashooh ooknaay, liilaawi bitik firkaab iiktiyeeb, bariiyooh daasiya. Umiimashi dheefaay aree win awi kehii kwaaleelisiyaayt hooy giigiya. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Maryam Majdaleenaawwa Maryam tuuraawwa umiimashi gidehii iistꞌana.<verse eid="MAT 27:61" /></para>
  <para style="s">Ikajar umiimash igwꞌadna</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Tooyin tumalya sabtu, ifagiiriya isuurkinaawwa Ifariisiiwwa Biilaatoos ibeen. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Baraah “Seedna, baruuh masi dhhaniib iiktiyi door been wharaay tak, ‘Mhayt yinaati harꞌii, masi yaki andi.’ diyaabi. <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Aflaay baruuk umiimash mhayt yina ookiik daayiib sigwꞌada. Bariiyaah ikwiriyaatay yꞌeetiit tukinaaja biigwihaarna, malya oodehay sooyiit, ‘Baruuh tooyat hooy idhhan’ iyaad iyadna. Aan aagwisir yꞌaakhar ikatiin aree eegwisir iraweeka amagkaab ikatiin.” idiin.<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Biilaatoos “Gwꞌadna, difnaat umiimash baraak tehariwneet tehayꞌaatii sigwꞌadna.” idi. <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Baraah umiimash aweeb kehii idꞌiiniit daayiib assiyaana, aree kajar isigwꞌadna.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Tooyat hooy ooyak</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Tusabti harꞌii, tꞌasaramaatiit yint tehankaaneet fajir karuumaab, Maryam Majdaleenaawwa Maryam tuuraawwa umiimash iishbibni jillaay giigiyaan. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Gaal door beentooy tuubuut winneet katatta. Wꞌankwanaay malak tibreetee tikwiyaay eeyaayt, umiimash shuumiya. Wꞌawi harꞌa kwaaleelisiyaayt kehii isꞌa. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Baruuh utalaw tꞌiiteebu, yhalakaayaah aree ibꞌaluukiit eeraaba. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Ikajar igwꞌaadiiga winneet barooh irkwiina, idhiyaaniit aya da tꞌiiteeb iiktiin. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Umalak timꞌatee dehaay, “Biirakwiina, bataak Yasuuꞌaab isallabamiyaab tehariwneet toona akteen. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Baruuh tooy kiihaay, baruuh suur diyaab iiktiyeet tunaatiit yakamiya. Mꞌaanaat baruuh hooy daasamaab iiktiyeeb oomhiin shibibna. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Aflaay willa difnaat ikwiriyaatayeeh sooyaana, ‘Baruuh tooyat hooy yakiya, suurookna aree Jaliil ookiik saki indi. Beentooy barooh rhi tiyadna.’ diina. Oontꞌa sooyan hookna.” idi. <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Shaawti taamꞌat umiimashii isgiini sakiyaana, irkwiina laakiin firhaat itabna. Malya dhaabiyaaniit ikwiriyaatay sootiib yhariwna. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Gaal door Yasuuꞌa bateeh imriit, “Shoob” idi. Bataah bariiyooh dehaay eeyaana, iragada yꞌabikniit barooh yꞌabidna. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Yasuuꞌa bateeh infaraad, “Biirakwiina! Difnaat aniib isana Jaliil eebiineet toona sooyaana! Beentooy baraah rhiheeb iyadna.” idi.<verse eid="MAT 28:10" /></para>
  <para style="s">Ikajareet badeha</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Taamꞌat masi usalaliib sakee, igwꞌaadiigaayee gwadi tumadiina ibeeniit toona turhiyaaneet ifagiiriya isuurkina naatka sooyaan. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Ifagiiriya isuurkina yꞌeegrimaayi geeb immararaayniit mikir imkirna. Ikajar gwida mhallaga balsaat yhiin. <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />Baraah ikajaree dehaay, “Baraak bak diina ‘Ikwiriyaatayaah whawaad eeyaaniit hinin diwee barooh igwiharna.’ diina. <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Aan ibhali whaakim ikatimneek, hinin barooh agbilisnay, aree bareek igwirhaayee iifrꞌa hookna indi.” idiin. <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Aflaay ikajar imhallaga iyheena, aree toona baraah soomamiyaaneet idꞌiin. Aree aan ibhali Iyahuudi bitik oon amsi ookiik hadiidameen.<verse eid="MAT 28:15" /></para>
  <para style="s">Yasuuꞌa ikwiriyaatayee dehaay lawiya</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Malya ikwiriyaatay itamna malu Jaliil ibeena, Yasuuꞌa beena diyaab iiktiyeeb oorba ibeen. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Baraah barooh rhiyaanihoob, barooh yꞌabidna, gwadi laakiin eetehakiyaan. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Malya Yasuuꞌa dehaay eeyaayt, “Kastuuh tehadꞌaayi toobuutwa tibreeteebwa teefeet aneeb attiyeewiyaatu. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Shaawti difnaat kasseeh yhasheeb gwida kwiriyaatay dꞌiina. Bareeh Ubaabaawwa, Wꞌoorwa, Eeshuuk Imugaddasaayeewwa simii misna. <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Ani sooyaneetookna toona aree kastooh bareeh allamaana. Ani han sidik diimaab geebookna eefi, tuduniyaati agiya ookna ookiik geebookna eefi.” idi.<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>