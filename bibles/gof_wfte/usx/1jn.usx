<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">1 ዮሃንሳ ኪታ</para>
  <para style="toc1">1 ዮሃንሳ ኪታ</para>
  <para style="toc3">1 ዮሀ</para>
  <para style="toc2">1 ዮሃንሳ</para>
  <para style="mt1">ዮሃንስ ፃፍዳ</para>
  <para style="mt2">ኮይሮ ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ሀዋርያ ዮሃንስ ፃፍዳ ኮይሮ ኪታይ፥ ናምኡ አይፈ ቆፋታ ኦይኬስ።</para>
  <para style="ipi">1. ኪታ ናባበይሳት ፆሳራነ እያ ናኣ የሱስ ክርስቶሳራ እስፈተ ዳና መላ ምንናሳ።</para>
  <para style="ipi">2. እስፈተ ይስያ ዎርዶ ትምርተፈ ሃካና መላ ኤንታ አኬክሳናሳ።</para>
  <para style="ip">ሄ ዎደ ደንድዳ ዎርዶ ትምርተይ፥ “ፆሳይ በንቶና አያና አላመ መስ። ሀ በንትያ አላምያነ ኑ አሳተ ፆሲ መቦና ግሾ ኢታ። ቃስ ሀ በንትያ አላመይነ ኑ አሳተይ ኑ አያና ቆሀናዉነ ቱንሳናዉ ዳንዳኤና” ያግድ ታማርሶሶና። ሄሳ ጉሳይ፥</para>
  <para style="ipi">1. የሱሲ አሰ ግድድ ይቤና ጉሱ፤</para>
  <para style="ipi">2. እስ አስ ባ አያና ቱንሶና ደእሸ ባ አሾን ናጋራ ኦናዉ ዳንዳኤስ ጉሱ።</para>
  <para style="ip">ሄሳ ግሾ፥ ዮሃንስ ባ ኪታን፥ የሱሲ አሰ ግድድ ይዳይሳ ካድያ ኦንካ ፆሳ ናአ ግደና (<char style="xt"><ref loc="1JN 4:2-3">4:2-3</ref></char>)። ቃስ ፆሳፈ የለትዳ ኦንካ ኡባ ዎደ ናጋራን ዴና (<char style="xt"><ref loc="1JN 3:6">3:6</ref></char>) ያግድ ፃፍስ።</para>
  <para style="ip">ዎርዶ አስታማረት፥ “አቶተ ጉስ፥ ሀ ሳአ ዱሳስ ኡንኤተፈ ከይድ የዳ ግድድ ደኦ” ያጎሶና። ሄሳ ቦላ ጉጅድ፥ “ኢታነ ሎኦ ሻክድ ኦይከ ግድን፥ ቃስ ሀራ አስ ሲቆ ግድን፥ አቶተራ አይብ ጋሄተካ ባዋ” ያጎሶና።</para>
  <para style="ip">ሀ ኪታ ፃፈይ ሄ ትምርትያ ፓልቅድ፥ “የሱስ ክርስቶሲ ፖሎ አሰ። የሱሳ አማነይሳትነ ፆሰ ሲቀይሳት ኡባይ ባንታ ግዶን እሶይ እሱዋራ ሲቀታናዉ በሴስ” ያግድ ኦድስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ደኦ እምያ ቃላ (<char style="ior"><ref loc="1JN 1:1-4">1:1-4</ref></char>)</para>
  <para style="io1">ፖኦነ ማ (<char style="ior"><ref loc="1JN 1:5-2:6">1:5—2:6</ref></char>)</para>
  <para style="io1">ኦራ ኪታ (<char style="ior"><ref loc="1JN 2:7-17">2:7-17</ref></char>)</para>
  <para style="io1">ክርስቶሳ ሞርከነ ፆሳ ናይታ (<char style="ior"><ref loc="1JN 2:18-3:10">2:18—3:10</ref></char>)</para>
  <para style="io1">ፆሳ ሲቆነ ኑ ሲቆ (<char style="ior"><ref loc="1JN 3:11-4:21">3:11—4:21</ref></char>)</para>
  <para style="io1">አላመ ፆንያ አማኖ (<char style="ior"><ref loc="1JN 5:1-21">5:1-21</ref></char>)</para>
  <chapter number="1" style="c" sid="1JN 1"/>
  <para style="s1">ደኦ ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1"/>ኑኒ ኮይሮፐ ዶምድ ደእያ፥ ኑ ሀይን ስእዳ፥ ኑ ፄልዳ፥ አይፈን በእዳ፥ ኑ ኩሸን ቦችዳ ደኦ ቃላባ ህንተዉ ፃፎስ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="JHN 1:1">ዮሀ 1:1</ref>.</char></note> <verse eid="1JN 1:1"/><verse number="2" style="v" sid="1JN 1:2"/>ሄ ደኦይ ቆንጭን፥ ኑኒ እያ በእድ፥ እያባ ማርካቶስ። አዋ ማታን ደእያ ኑስ ቆንጭዳ፥ መርና ደኡዋባ ህንተዉ አዋጆስ።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JHN 1:14">ዮሀ 1:14</ref>.</char></note> <verse eid="1JN 1:2"/><verse number="3" style="v" sid="1JN 1:3"/>ኑራ ህንተዉ እስፈተ ዳና መላ ኑኒ በእዳይሳነ ስእዳይሳ ህንተዉ ኦዶስ። ህንተዉ ኑራ እስፈተ ደእያ ግሾ፥ አዋራነ እያ ናኣ የሱስ ክርስቶሳራ እስፈተ ደኤስ። <verse eid="1JN 1:3"/><verse number="4" style="v" sid="1JN 1:4"/>ኑ ኡፋይሳይ ፖሎ ግዳና መላ ሄሳ ህንተዉ ፃፎስ።<verse eid="1JN 1:4"/></para>
  <para style="s1">ፆሳይ ፖኦ</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5"/>ኑኒ ደኦ ግድዳ እያፐ ስእድ፥ ህንተዉ ኦድያ ኪታይ ሀይሳ፦ “ፆሳይ ፖኦ፤ እያን ም ባዋ” ያገይሳ። <verse eid="1JN 1:5"/><verse number="6" style="v" sid="1JN 1:6"/>ኑስ እያራ እስፈተ ደኤስ ያግሸ ማን ደእኮ፥ ኑ ኦዳንነ ኑ ኦሱዋን ዎርዶቶስ። <verse eid="1JN 1:6"/><verse number="7" style="v" sid="1JN 1:7"/>ሽን ፖኦን እ ደኤይሳዳ፥ ኑካ ፖኦን ደእኮ፥ ኑስ ዎል ግዶን እስፈተ ደኤስ። እያ ናኣ፥ የሱሳ ሱይ ናጋራ ኡባፈ ኑና ጌሼስ።<verse eid="1JN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8"/>ኑኒ፥ ኑናን ናጋር ባዋ ጊኮ ኑ ኑና ጭሞስ፤ ኑናን ቱም ባዋ። <verse eid="1JN 1:8"/><verse number="9" style="v" sid="1JN 1:9"/>ሽን ፆሳስ ኑ ናጋራ ፓፅኮ፥ እ ኑ ናጋራ አቶ ጋናዉነ ኑ ቆሆ ኦሶ ኡባፈ ኑና ጌሻናዉ፥ አማነትዳይሳነ ቱማ። <verse eid="1JN 1:9"/><verse number="10" style="v" sid="1JN 1:10"/>ኑኒ ናጋራ ኦቦኮ ጊኮ ፆሳ ዎርዳንቾ ከሶስ፤ እያ ቃላይካ ኑናን ዴና።<verse eid="1JN 1:10"/></para>
  <chapter eid="1JN 1"/>
  <chapter number="2" style="c" sid="1JN 2"/>
  <para style="s1">ክርስቶስ ኑስ ጋናቴስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1"/>ታ ናይቶ፥ ናጋራ ህንተ ኦና መላ ታኒ ሀይሳ ህንተዉ ፃፋይስ። ሽን ኦንካ ናጋራ ኦኮ አዋ ማታን ኑስ ጋናትያ ፅሎይ፥ የሱስ ክርስቶሲ፥ ደኤስ። <verse eid="1JN 2:1"/><verse number="2" style="v" sid="1JN 2:2"/>ኑ ናጋራይ ክርስቶሳ ባጋራ አቶ ጌተቴስ። እ ኑ ናጋራ ፃላላስ ግዶናሽን፥ አሳ ኡባ ናጋራስ ያርሸትስ።<verse eid="1JN 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3"/>ኑኒ ፆሳ ኪታ ናግኮ፥ ስይ ባይናሽን፥ ቱማ ኑ እያ ኤሮስ። <verse eid="1JN 2:3"/><verse number="4" style="v" sid="1JN 2:4"/>ኦንካ፥ “ታኒ እያ ኤራይስ” ያግሸ፥ እያ ኪታ ናጎና እፅኮ ሄ ኡራይ ዎርዳንቾ፤ ቱማተ እያን ባዋ። <verse eid="1JN 2:4"/><verse number="5" style="v" sid="1JN 2:5"/>ሽን እያ ቃላስ ኑ ኪተትያባ ግድኮ ሄ ኡራይ ፆሳ ሲቅያ ሲቆይ ፖሎ ግዴስ። ኑኒ ፆሳን ደኤይሳስ ሄስ ባዉ ቱማ ማርካ። <verse eid="1JN 2:5"/><verse number="6" style="v" sid="1JN 2:6"/>ታኒ፥ “ፆሳን ደአይስ” ግያ ኦንካ ክርስቶስ ደእዳይሳዳ ዳናዉ በሴስ።<verse eid="1JN 2:6"/></para>
  <para style="s1">ኦራ ኪታ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7"/>ታ ሲቆ እሻቶ፥ ታኒ ህንተዉ ኮይሮፐ ደእያ ጋልአ ኪታ ፃፋይስፐ አትሽን፥ ኦራ ኪታ ፃፍከ። እካ ህንተ ስእዳ ሄ ጋልአ ኪታ።<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሀ 13:34</ref>.</char></note> <verse eid="1JN 2:7"/><verse number="8" style="v" sid="1JN 2:8"/>ግድኮካ፥ ክርስቶሳንነ ህንተናን ቱማ ግድድ ደእያ፥ ኦራ ኪታ ፃፋይስ። ማይ ክችን፥ ሀእ ቱማ ፖኦይ ፖኤስ።<verse eid="1JN 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9"/>“ፖኦን ደአይስ” ግሸ ባ እሻ እፅያ ኦንካ፥ ሀእካ ማን ደኤስ። <verse eid="1JN 2:9"/><verse number="10" style="v" sid="1JN 2:10"/>ባ እሻ ዶስያ ኦንካ ፖኦን ደኤስ። ሄ ኡራን ሀራ አስ ብያባይ ባዋ። <verse eid="1JN 2:10"/><verse number="11" style="v" sid="1JN 2:11"/>ሽን ባ እሻ እፅያ ኦንካ ማን ደኤስ፤ ማን ሄመቴስ። ማይ እያ አይፍያ ቆቅስዳ ግሾ አዉ ብያኮ ኤረና።<verse eid="1JN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12"/>ታ ናይቶ፥ ክርስቶሳ ሱን ባጋራ ህንተ ናጋራይ አቶ ጌተትዳ ግሾ ታኒ ህንተዉ ፃፋይስ። <verse eid="1JN 2:12"/><verse number="13" style="v" sid="1JN 2:13"/>አዋቶ፥ ኮይሮፐ ደእያ፥ እያ ህንተ ኤርዳ ግሾ ህንተዉ ፃፋይስ። ያላጋቶ፥ ፃላህያ ህንተ ፆንዳ ግሾ ህንተዉ ፃፋይስ። <verse eid="1JN 2:13"/><verse number="14" style="v" sid="1JN 2:14"/>ጉ ናይቶ፥ ፆሳ ህንተ ኤርዳ ግሾ ህንተዉ ፃፋይስ። አዋቶ፥ ኮይሮፐ ደእያ እያ ህንተ ኤርዳ ግሾ ህንተዉ ፃፋይስ። ያላጋቶ፥ ህንተ ምኖ ግድያ ግሾ፥ ፆሳ ቃላይ ህንተናን ደእያ ግሾነ ፃላህያ ህንተ ፆንዳ ግሾ ህንተዉ ፃፋይስ።<verse eid="1JN 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15"/>አላመ ዎይኮ አላመን ደእያባ ዶሶፕተ። አላምያ ዶስያ ኦንካ ፆሳ ዶሰና። <verse eid="1JN 2:15"/><verse number="16" style="v" sid="1JN 2:16"/>አላመን ደእያ ኡባባይ፥ አሾ አሞተ፥ አይፈን በእድ አሞትያባይነ ሚሸን ጬቀተ አላመባፐ አትሽን፥ ፆሳፈ ግደና። <verse eid="1JN 2:16"/><verse number="17" style="v" sid="1JN 2:17"/>አላመይነ አላመን አስ አሞትያ ኡባይ አና፥ ሽን ፆሳ ሸነ ፖልያ ኦንካ መርናዉ ዳና።<verse eid="1JN 2:17"/></para>
  <para style="s1">ክርስቶሳራ ኤቀትያ ሞርክያ</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18"/>ታ ናይቶ፥ ዎድያ ዉርሰይ ማታትስ። ክርስቶሳ ሞርከይ ስንፈ ያናይሳ ህንተ ስእዳይሳዳ ሀር አቶሽን፥ ሀእካ እያ ሞርከት ዳሮት ደንድዶሶና። ሄሳ ግሾ፥ ዎድያ ዉርሰይ ማታትዳይሳ ኑኒ ሄሳን ኤሮስ። <verse eid="1JN 2:18"/><verse number="19" style="v" sid="1JN 2:19"/>ሄ ሞርከት ኑ ባጋ ግዶና ግሾ ኑ ግዶፈ ከይዶሶና። ኤንቲ ኑ ባጋ ግድያኮ ኑ ግዶን ደአና፥ ሽን ኤንታፈ ኦንካ ኑ ባጋ ግዶናይስ ኤረታና መላ ኑ ግዶፈ ከይዶሶና።<verse eid="1JN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20"/>ሽን ክርስቶስ ህንተ ቦላ ጌሻ አያና ጉስስ፤ ቃስ ህንተ ኡባይ ቱማ ኤሬታ። <verse eid="1JN 2:20"/><verse number="21" style="v" sid="1JN 2:21"/>ቱማ ህንተ ኤርያ ግሾነ ቱማን አይባ ዎርዶይ ባይናይሳ ህንተ ኤርያ ግሾ፥ ታኒ ህንተዉ ፃፋይስፐ አትሽን፥ ቱማ ህንተ ኤሮና ግሾ ግደና።<verse eid="1JN 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22"/>የሱሲ፥ ፆሳይ ዶርዳይሳ ግደና ግድ ካድያ አሳፐ ሀር ዎርዳንቾይ ኦኔ? ሄሳ መላ አስ ክርስቶሳ ሞርከ። እ ናኣ ካድኮ አዋካ ካዴስ። <verse eid="1JN 2:22"/><verse number="23" style="v" sid="1JN 2:23"/>ናኣ ካድያ ኦደስካ አዋይ ባዋ፤ ቃስ ናኣስ ማርካትያ ኦደስካ አዋይ ደኤስ።<verse eid="1JN 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24"/>ሄሳ ግሾ፥ ኮይሮ ህንተ ስእዳ ቃላ ህንተ ዎዛናን ምንድ ናግተ። ኮይሮ ስእዳይሳ ህንተ ናግኮ ህንተዉ ናአራነ አዋራ እስፈተ ዳና። <verse eid="1JN 2:24"/><verse number="25" style="v" sid="1JN 2:25"/>ናአይ ኑስ መርና ደኡዋ እማና ግድ ቃላ ገልስ።<verse eid="1JN 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26"/>ህንተና ባለያ አሳ ግሾ ታኒ ሀይሳ ህንተዉ ፃፋስ። <verse eid="1JN 2:26"/><verse number="27" style="v" sid="1JN 2:27"/>ሽን ክርስቶስ ህንተ ቦላ ባ ጌሻ አያና ጉስስ። ጌሻ አያናይ ህንተናን ደእያ ግሾ ኦንካ ህንተና ታማርሶ ኮሸና። እያ ጌሻ አያናይ ህንተና ቱማ ታማርሰስፐ አትሽን፥ ዎርዶ ግደና። ጌሻ አያናይ ህንተና ታማርስዳይሳዳ ክርስቶሳን ደእተ።<verse eid="1JN 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28"/>ህዛ፥ ታ ናይቶ፥ እ ቆንጭያ ዎደ ኑኒ ያሽ ባይናነ እያ ዩሳ ጋላስ እያ ስንን ኑ ዬላን ቆሰቶና መላ እያን ደእተ። <verse eid="1JN 2:28"/><verse number="29" style="v" sid="1JN 2:29"/>ክርስቶስ ፅሎ ግደይሳ ህንተ ኤርኮ ፅሎ ኦያ ኡባይ ፆሳ ናአ ግደይሳ ኤርተ።<verse eid="1JN 2:29"/></para>
  <chapter eid="1JN 2"/>
  <chapter number="3" style="c" sid="1JN 3"/>
  <para style="s1">ፆሳ ናይታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1"/>ኑኒ ፆሳ ናይታ ጌተትድ ፄገታና መላ ፆሳይ ኑና አይ መላ ዶስዳኮ በእተ። ኑኒ ቱማካ ፆሳ ናይታ። ሀ አላመይ ፆሳ ኤሮና ግሾ ኑናካ ኤረና።<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="JHN 1:12">ዮሀ 1:12</ref>.</char></note> <verse eid="1JN 3:1"/><verse number="2" style="v" sid="1JN 3:2"/>ታ ሲቆ እሻቶ፥ ሀእ ኑኒ ፆሳ ናይታ፤ ኑኒ አይ ሀናኔኮ ቡሮ ኤረትቤና። ሽን ክርስቶስ ቆንጭያ ዎደ ኑኒ እያ ዳናናይሳ ኤሮስ። እ ቱማ ደኤይሳ ኑኒ በአና። <verse eid="1JN 3:2"/><verse number="3" style="v" sid="1JN 3:3"/>ክርስቶሳ በአና ግድ ኡፋይሳን ናግያ ኦንካ፥ ክርስቶስ ጌሽ ግድዳይሳዳ ባና ጌሼስ።<verse eid="1JN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4"/>ናጋር ህገ መን ግድያ ግሾ ናጋራ ኦያ ኡባይ ፆሳ ህገ መንስ። <verse eid="1JN 3:4"/><verse number="5" style="v" sid="1JN 3:5"/>ክርስቶስ አሳ ናጋራ ይሳናዉ ቆንጭዳይሳ ህንተ ኤሬታ፤ እያን ናጋር ባዋ።<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="JHN 1:29">ዮሀ 1:29</ref>.</char></note> <verse eid="1JN 3:5"/><verse number="6" style="v" sid="1JN 3:6"/>ክርስቶሳን ደእያ ኦንካ ናጋራን ዴና። ቃስ ናጋራን ደእያ ኦንካ እያ በእቤና ዎይኮ ኤርቤና።<verse eid="1JN 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7"/>ታ ናይቶ፥ ህንተና ኦንካ ባለፎ። ክርስቶስ ፅሎ ግድዳይሳዳ ፅሎ ኦያ ኦንካ ፅሎ። <verse eid="1JN 3:7"/><verse number="8" style="v" sid="1JN 3:8"/>ፃላሄይ ኮይሮፐ ናጋራ ኦዳ ግሾ ናጋራ ኡባ ዎደ ኦያ ኦንካ ፃላሄ ዳቦ። ሄሳ ግሾ፥ ፆሳ ናአይ ፃላሄ ኦሶ ይሳናዉ ቆንጭስ። <verse eid="1JN 3:8"/><verse number="9" style="v" sid="1JN 3:9"/>ፆሳ ናአ ግድያ ኦንካ ፆሳ አያናይ እያን ደእያ ግሾ፥ እ ኡባ ዎደ ናጋራን ዴና። ፆሳይ እያ አዋ ግድያ ግሾ ናጋራን ዴና። <verse eid="1JN 3:9"/><verse number="10" style="v" sid="1JN 3:10"/>ፆሳ ናይታ ግዶንነ ፃላሄ ናይታ ግዶን ደእያ ዱማተይ ሄሳን ኤረቴስ፤ ፅሎ ኦና አስ ዎይኮ ባ እሻ ዶሶና አስ ፆሳ ናአ ግደና።<verse eid="1JN 3:10"/></para>
  <para style="s1">እሶይ እሱዋ ዶስተ</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11"/>ኮይሮፐ ህንተ ስእዳ ኪታይ፥ “እሶይ እሱዋ ዶሳናዉ በሴስ” ግያ ኪታ።<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሀ 13:34</ref>.</char></note> <verse eid="1JN 3:11"/><verse number="12" style="v" sid="1JN 3:12"/>ኑኒ ቃየላ መላ ግዳናዉ በሰና። ቃየላ ፃላሄ ዳቦ ግድድ ባ እሻ ዎስ። እ ባ እሻ አይስ ዎዴ? እያ ኦሶይ ኢታ ግድዳ ግሾነ እያ እሻ ኦሶይ ሎኦ ግድዳ ግሾ ዎስ።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="GEN 4:8">መ 4:8</ref>.</char></note><verse eid="1JN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13"/>ታ እሻቶ፥ ሀ አላምያ አሳይ ህንተና እፅኮ ማላለቶፍተ። <verse eid="1JN 3:13"/><verse number="14" style="v" sid="1JN 3:14"/>ኑኒ ኑ እሻታ ሲቅያ ግሾ፥ ሀይቆፐ ደኦ ፕንዳይሳ ኤሮስ። ባ እሻ ዶሶና ኦንካ ሀይቆ ኩያን ደኤስ።<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="JHN 5:24">ዮሀ 5:24</ref>.</char></note> <verse eid="1JN 3:14"/><verse number="15" style="v" sid="1JN 3:15"/>ባ እሻ እፅያ ኦንካ ሸምፖ ዎስ። ቃስ ሸምፖ ዎያ ኦደስካ መርና ደኦይ ባይናይሳ ህንተ ኤሬታ። <verse eid="1JN 3:15"/><verse number="16" style="v" sid="1JN 3:16"/>ክርስቶስ ባ ሸምፑዋ ኑ ግሾ አድ እምዳይሳን ሲቆይ አይበኮ ኑኒ ኤርዳ። ኑካ ኑ እሻታ ግሾ ኑ ሸምፑዋ አድ እማናዉ በሴስ። <verse eid="1JN 3:16"/><verse number="17" style="v" sid="1JN 3:17"/>ሽን ዱረ ግድዳ ኦንካ መቶታንቹዋ በእሸ፥ እያዉ ቃቶና እፅኮ ባ ዎዛናን ፆሳ ሲቆይ ደኤስ ጋናዉ ዋንድ ዳንዳኢ? <verse eid="1JN 3:17"/><verse number="18" style="v" sid="1JN 3:18"/>ታ ናይቶ፥ ኑኒ ኦሶንነ ቱማተን ኑ ሲቁዋ ቆንጭሳናዉ በሴስፐ አትሽን፥ ጮ ኦዳ ፃላላን ዎይኮ ዶና ፃላላን ሲቀታናዉ በሰና።<verse eid="1JN 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19"/>ኑኒ እሶይ እሱዋ ሲቅኮ፥ ኑ ቱማ ባጋ ግደይሳ ኤሮስ፤ ሄሳስ ፆሳ ስንን ዬላቶኮ። <verse eid="1JN 3:19"/><verse number="20" style="v" sid="1JN 3:20"/>ኑ ዎዛናይ ኑ ቦላ ፕርድያባ ግድኮ፥ ፆሳይ ኑ ዎዛናፐ ግታ ግደይሳ ኤሮስ፤ እ ኡባባ ኤሬስ።<verse eid="1JN 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 3:21"/>ታ ሲቆ እሻቶ፥ ኑ ዎዛናይ ኑ ቦላ ፕርዶናባ ግድኮ ኑኒ ፆሳ ስንን ያዮኮ። <verse eid="1JN 3:21"/><verse number="22" style="v" sid="1JN 3:22"/>ኑኒ እያ ኪታ ናግያ ግሾነ እያ ኡፋይስያባ ኦያ ግሾ ዎስያባ ኡባ እያፐ ኤኮስ። <verse eid="1JN 3:22"/><verse number="23" style="v" sid="1JN 3:23"/>ክርስቶስ ኑና ኪትዳይሳዳ ፆሳ ናኣ የሱስ ክርስቶሳ ሱንን አማናናዳነ እሶይ እሱዋ ሲቃናዳ ፆሳይ ኑና ኪትስ።<note caller="-" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሀ 13:34</ref>፤ <ref loc="JHN 15:12">15:12</ref>፥ <ref loc="JHN 15:17">17</ref>.</char></note> <verse eid="1JN 3:23"/><verse number="24" style="v" sid="1JN 3:24"/>ፆሳ ኪታ ናግያ ኦንካ ፆሳን ደኤስ፤ ፆሳይካ እያን ደኤስ። ፆሳይ ኑስ እምዳ ጌሻ አያና ባጋራ እ ኑናን ደኤይሳ ኤሮስ።<verse eid="1JN 3:24"/></para>
  <chapter eid="1JN 3"/>
  <chapter number="4" style="c" sid="1JN 4"/>
  <para style="s1">አያናታ ሻክድ ኤርተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1"/>ታ ሲቆ እሻቶ፥ አያናታ ኡባ አማኖፕተ፥ ሽን ኤንቲ ፆሳፈ ይዳኮ ፓጭድ በእተ። አይስ ጊኮ፥ ዳሮ ዎርዶ ናበት አላመን ደንድዶሶና። <verse eid="1JN 4:1"/><verse number="2" style="v" sid="1JN 4:2"/>ፆሳ አያና ግደይሳ ህንተ ሀይሳን ኤራና፤ “የሱስ ክርስቶሲ አሰ ግድድ ይዳይሳ ማርካታይስ” ግያ አያና ኡባይ ፆሳፈ ዬስ። <verse eid="1JN 4:2"/><verse number="3" style="v" sid="1JN 4:3"/>ክርስቶስ አሰ ግድድ ይዳይሳ አማናይስ ጎና አያና ኡባይ ፆሳፈ ግደና። ሄስ ክርስቶሳ እፅያ አያና። ህንተ ሄ አያናይ ያናይሳ ካሰ ስእደታ፤ እ ሀር አቶሽን ሀእካ አላመን ደኤስ።<verse eid="1JN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4"/>ታ ናይቶ፥ ህንተ ፆሳሳ። ህንተ ግዶን ደእያ ጌሻ አያናይ አላመን ደእያ አያናፐ ዳሮ ዎልቃማ ግድያ ግሾ ዎርዳንቾ ናበታ ህንተ ፆንደታ። <verse eid="1JN 4:4"/><verse number="5" style="v" sid="1JN 4:5"/>ኤንቲ ሀ አላምያ አሰ ግድያ ግሾ፥ ሀ አላምያባ ኦዶሶና፤ ሀ አላምያ አሳይ ኤንታ ኦዳ ስኦሶና። <verse eid="1JN 4:5"/><verse number="6" style="v" sid="1JN 4:6"/>ኑኒ ፆሳፈ የለትዳ፤ ፆሳ ኤርያ ኦንካ ኑና ስኤስ። ፆሳ ኤሮና ኦንካ ኑና ስኤና። ኑኒ ቱማ አያናነ ዎርዶ አያና ሄሳን ሻኮስ።<verse eid="1JN 4:6"/></para>
  <para style="s1">ፆሳይ ሲቆ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7"/>ታ ሲቆ እሻቶ፥ ሲቆይ ፆሳፈ ያ ግሾ፥ አነ እሶይ እሱዋራ ሲቀቶስ። ሲቅያ ኦንካ ፆሳ ናአ፤ እ ፆሳ ኤሬስ። <verse eid="1JN 4:7"/><verse number="8" style="v" sid="1JN 4:8"/>ፆሳይ ሲቆ ግድያ ግሾ ሲቆና ኦንካ ፆሳ ኤረና። <verse eid="1JN 4:8"/><verse number="9" style="v" sid="1JN 4:9"/>ኑኒ ክርስቶሳ ባጋራ ደኡዋ ደማና መላ ፆሳይ ባ እስ ናኣ ሀ አላምያ ኪትስ። ፆሳይ ኑና ባ ሲቁዋ ሄሳን በስስ። <verse eid="1JN 4:9"/><verse number="10" style="v" sid="1JN 4:10"/>ቱማ ሲቆ ጉሳይ ሀይሳ፦ ኑኒ ፆሳ ሲቅዳ ግሾ ግዶናሽን፥ ፆሳይ ኑና ሲቅዳ ግሾነ ኑ ናጋራፐ ኑና ማራናዉ ባ ናኣ ኪትዳ ግሾሳ።<verse eid="1JN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11"/>ታ ሲቆ እሻቶ፥ ፆሳይ ኑና ሀይሳዳ ሲቅኮ፥ ኑካ እሶይ እሱዋ ሲቃናዉ በሴስ። <verse eid="1JN 4:11"/><verse number="12" style="v" sid="1JN 4:12"/>ፆሳ በእዳይ ኦንካ ባዋ። ኑኒ እሶይ እሱዋ ሲቅኮ ፆሳይ ኑናን ደኤስ፤ እያ ሲቆይካ ኑናን ፖሎ ግዴስ።<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="JHN 1:18">ዮሀ 1:18</ref>.</char></note><verse eid="1JN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13"/>ፆሳይ ባ ጌሻ አያና ኑስ እምዳ ግሾ፥ ኑኒ ፆሳን ደኤይሳነ እካ ኑናን ደኤይሳ ኤሮስ። <verse eid="1JN 4:13"/><verse number="14" style="v" sid="1JN 4:14"/>አዋይ ባ ናኣ፥ ሀ አላምያ አሸይሳ ግዳና መላ ኪትዳይሳ ኑኒ በእድ ማርካቶስ። <verse eid="1JN 4:14"/><verse number="15" style="v" sid="1JN 4:15"/>የሱሲ ፆሳ ናኣ ግደይሳ ማርካትያ ኦደንካ ፆሳይ ደኤስ፤ እካ ፆሳን ደኤስ። <verse eid="1JN 4:15"/><verse number="16" style="v" sid="1JN 4:16"/>ፆሳይ ኑና ሲቀይሳ ኑኒ ኤሮስነ አማኖስ።</para>
  <para style="p" vid="1JN 4:16">ፆሳይ ሲቆ። ሲቆን ደእያ ኦንካ ፆሳን ደኤስ፤ ፆሳይካ እያን ደኤስ። <verse eid="1JN 4:16"/><verse number="17" style="v" sid="1JN 4:17"/>ኑ ደኦይ ሀ አላምያን ክርስቶስ ደእዳይሳ መላ ግድያ ግሾ፥ ፕርዳ ጋላስ ያዮና እያ ስን ሺቃናዉ እያ ሲቆይ ኑናን ፖሎ ግዴስ። <verse eid="1JN 4:17"/><verse number="18" style="v" sid="1JN 4:18"/>ሲቆን ያሽ ባዋ፥ ቱማ ሲቆይ ያሽ ከስ ሆሌስ። ያሽነ ፕርድ እስፈ ብያ ግሾ፥ ያይያ ኡራ ሲቆይ ፖሎ ግደና።<verse eid="1JN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19"/>ፆሳይ ኮይሮ ኑና ሲቅዳ ግሾ ኑ ሲቆስ። <verse eid="1JN 4:19"/><verse number="20" style="v" sid="1JN 4:20"/>ኦንካ፥ “ፆሳ ሲቃይስ” ግሸ ባ እሻ እፅኮ፥ እ ዎርዳንቾ። አይስ ጊኮ፥ በእያ ባ እሻ ሲቆና ኦንካ በእቦና ፆሳ ሲቃናዉ ዋንድ ዳንዳኢ? <verse eid="1JN 4:20"/><verse number="21" style="v" sid="1JN 4:21"/>ክርስቶስ ኑስ እምዳ ኪታይ ሀይሳ፤ “ፆሳ ሲቅያ ኦንካ ባ እሻ ሲቃናዉ በሴስ” ያገይሳ።<verse eid="1JN 4:21"/></para>
  <chapter eid="1JN 4"/>
  <chapter number="5" style="c" sid="1JN 5"/>
  <para style="s1">አላምያ ፆኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1"/>የሱሳ፥ እ ክርስቶሳ ያግድ፥ አማንያ ኦንካ ፆሳ ናአ። አዋ ሲቅያ ኦንካ እያ ናኣካ ሲቄስ። <verse eid="1JN 5:1"/><verse number="2" style="v" sid="1JN 5:2"/>ኑኒ ፆሳ ሲቅያ ግሾነ እያ ኪታ ናግያ ግሾ ፆሳ ናይታ ሲቀይሳ ኤሮስ። <verse eid="1JN 5:2"/><verse number="3" style="v" sid="1JN 5:3"/>ኑኒ ፆሳ ሲቅኮ፥ እያ ኪታታ ናጎስ። እያ ኪታት ዴፆ ግዶኮና።<note caller="-" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="JHN 14:15">ዮሀ 14:15</ref>.</char></note> <verse eid="1JN 5:3"/><verse number="4" style="v" sid="1JN 5:4"/>አይስ ጊኮ፥ ፆሳ ናአ ግድያ ኦንካ ሀ አላምያ ፆናናዉ ዳንዳኤስ። ኑኒ ሀ አላምያ ፆናናይ ኑ አማኑዋና። <verse eid="1JN 5:4"/><verse number="5" style="v" sid="1JN 5:5"/>አላምያ ፆናናዉ ዳንዳኤይ ኦኔ? የሱሲ ፆሳ ናኣ ግደይሳ አማንያ አሳ ፃላል ፆናና።<verse eid="1JN 5:5"/></para>
  <para style="s1">ክርስቶስ ኦኔ?</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6"/>የሱስ ክርስቶሲ ሃ ፅንቃትያራነ ባ ሀይቁዋ ሱራ ይስ። እ፥ ሃራነ ሱራ ይስፐ አትሽን፥ ሃ ፃላላራ ይቤና። ጌሻ አያናይ ቱማ ግድያ ግሾ፥ ሄስ ቱማ ግደይሳ ማርካቴስ። <verse eid="1JN 5:6"/><verse number="7" style="v" sid="1JN 5:7"/>ሄ ማርካት ደኦሶና። <verse eid="1JN 5:7"/><verse number="8" style="v" sid="1JN 5:8"/>ሄሳት፥ ጌሻ አያና፥ ሃነ ሱ። ሀ ሄታ ማርካተይ እስኖ። <verse eid="1JN 5:8"/><verse number="9" style="v" sid="1JN 5:9"/>ኑ አሳይ ማርካተይሳ አማኖስ። ሽን ፆሳ ማርካተይ አሳይሳፈ ዳሮ አስ። ፆሳይ ባ ናኣስ ማርካትዳ ማርካተይ ሀይሳ። <verse eid="1JN 5:9"/><verse number="10" style="v" sid="1JN 5:10"/>ፆሳ ናኣ አማንያ ኡራ ዎዛናን ሀ ማርካተይ ደኤስ። ፆሳ አማኖና ኦንካ ፆሳይ ባ ናኣስ ማርካትዳ ማርካተ አማንቦና ግሾ፥ ፆሳ ዎርዳንቾ ኦስ።<verse eid="1JN 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 5:11"/>ህዛ፥ ማርካተይ ሀይሳ፤ ፆሳይ ኑስ መርና ደኦ እሚስ፤ ሄ ደኦይካ እያ ናአን ደኤስ ያገይሳ።<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="JHN 3:36">ዮሀ 3:36</ref>.</char></note> <verse eid="1JN 5:11"/><verse number="12" style="v" sid="1JN 5:12"/>ፆሳ ናአይ ደእያ ኦደስካ ደኦይ ደኤስ። ፆሳ ናአይ ባይና ኦደስካ ደኦይ ባዋ።<verse eid="1JN 5:12"/></para>
  <para style="s1">መርና ደኦ</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13"/>ፆሳ ናአን አማንያ ህንተዉ መርና ደኦይ ደኤይሳ ህንተ ኤራና መላ ሀይሳ ህንተዉ ፃፋስ። <verse eid="1JN 5:13"/><verse number="14" style="v" sid="1JN 5:14"/>ፆሳ ሸንያዳ አይብባካ እያ ዎስኮ፥ እ ስኤይሳ ኑኒ ኤርያ ግሾ እያን አማነቶስ። <verse eid="1JN 5:14"/><verse number="15" style="v" sid="1JN 5:15"/>ኑኒ ዎስያ ኡባ እ ስኤይሳ ኤርኮ፥ ኑኒ ዎስያባ እ እማናይሳ ኤሮስ።<verse eid="1JN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16"/>ኦንካ ባ እሻይ ሀይቆ በሶና ናጋራ ኦሽን በእኮ፥ ፆሳ እያዉ ዎሳናዉ በሴስ። ሀይቆ በሶና ናጋራ ኦዳይሳታስ ፆሳይ ደኦ እማና። ሀይቆ በሲያ ናጋር ደኤስ። ታኒ ህንተና ሄሳስ ፆሳ ዎስተ ጊከ። <verse eid="1JN 5:16"/><verse number="17" style="v" sid="1JN 5:17"/>ኢታ ኦሶ ኡባይ ናጋራ፥ ሽን ሀይቆ በሶና ናጋር ደኤስ።<verse eid="1JN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18"/>ፆሳ ናአይ እያ ናግያ ግሾ፥ ፆሳ ናአ ግድዳ ኦንካ ናጋራን ኡባ ዎደ ደኦናይሳ ኑኒ ኤሮስ። ፃላሄይ እያ ቆሀናዉ ዳንዳኤና። <verse eid="1JN 5:18"/><verse number="19" style="v" sid="1JN 5:19"/>ኑኒ ፆሳሳ ግደይሳነ ሀ ኩመ አላመይ ፃላሄን ሃረተይሳ ኤሮስ።<verse eid="1JN 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20"/>ኑኒ ቱማ ፆሳ ኤራናዳ ፆሳ ናአይ ይዳይሳነ ኑስ አኬካ እምዳይሳ ኤሮስ። ኑኒ እያ ናአ፥ የሱስ ክርስቶሳ ባጋራ ቱማ ፆሳን ደኦስ። የሱሲ ቱማ ፆሳነ መርና ደኡዋ።<verse eid="1JN 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21"/>ታ ናይቶ፥ ኤቃታፐ ህንተ ሃክተ።<verse eid="1JN 5:21"/></para>
  <chapter eid="1JN 5"/>
</usx>
