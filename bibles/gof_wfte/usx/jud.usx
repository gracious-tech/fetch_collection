<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ይሁዳ ኪታ</para>
  <para style="toc1">ይሁዳ ኪታ</para>
  <para style="toc3">ይሁ</para>
  <para style="toc2">ይሁዳ</para>
  <para style="mt">ይሁድ ፃፍዳ ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ይሁዳ ኪታይ ፃፈትዳይ፥ አማኖና ደእሸ አማንያ አስ ዳንድ ዎርዶ ትምርተ ላልያ አሳታፐ አማንያ አሳይ ናገታና መላ አኬክሳናሳ። ሀ ቃን ኪታይ ባ ግዶን ኦይክዳ ቆፋታን ናምአን ጰፅሮሳ ኪታ ዳኔስ። ሀ ኪታ ፃፈይ፥ “አማንያ አሳስ እስቶሆነ ዉርሰ ጋካናዉ እመትዳ አማኑዋስ ኦለትተ” ያግድ ናባብያ አሳ ምንድ ቆፍሴስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ሳሮ (1-2)</para>
  <para style="io1">ዎርዶ አስታማረታነ ኤንታ ኩንደ (3-16)</para>
  <para style="io1">አማኖ ምንድ ናጋና መላ እመትዳ ዞረ (17-23)</para>
  <para style="io1">ጋላታነ ዎሳ (24-25)</para>
  <chapter number="1" style="c" sid="JUD 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1"/>ታኒ ይሁድ፥ የሱስ ክርስቶሳ አይለይ፥ ያይቆባ እሻይ፥</para>
  <para style="p" vid="JUD 1:1">ፆሳይ ፄግዳይሳታስ፥ ፆሳ አዋይ ዶሰይሳታስነ የሱስ ክርስቶሳን ናገትዳይሳታስ ሀ ዳብዳብያ ፃፋይስ።<note caller="-" style="x"><char style="xo" closed="false">1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቶ 13:55</ref>፤ <ref loc="MRK 6:3">ማር 6:3</ref>.</char></note><verse eid="JUD 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2"/>ማሮተ፥ ሳሮተነ ሲቆይ ህንተዉ ኩሞ።<verse eid="JUD 1:2"/></para>
  <para style="s1">ዎርዶ አስታማረታ</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3"/>ታ ሲቆ እሻቶ፥ ኑኒ እስፈ ሻከትያ አቶተባ ህንተዉ ፃፋናዉ ታኒ ዳሮ አሞታስ። ሽን አማንያ አሳስ እስቶሆነ ዉርሰ ጋካናዉ እመትዳ አማኑዋስ ኦለታና መላ ህንተና ዞራሸ ፃፋናይስ ታዉ ኮሽያባ ግድስ። <verse eid="JUD 1:3"/><verse number="4" style="v" sid="JUD 1:4"/>ኤንታ ፕርዳይ በንፐ ፃፈትድ ኡትዳ፥ እስ እስ አሳት ኦንካ ኤሮና ህንተ ግዶ ገልዶሶና። ኤንቲ ፆሳ ኤሮናይሳታ፥ ኑ ፆሳ አ ኬሀተ ላይማታናዉ ጎኤትያ ኦገ ኦድ ኤኮሶና። ባ ፃላላ ካዎ ግድዳ፥ ኑ ጎዳ የሱስ ክርስቶሳ ካዶሶና።<verse eid="JUD 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5"/>ሽን ህንተ ሀ ኡባ ኤርያባ ግድኮካ፥ ጎዳይ እስራኤለ አሳ ግብፀ ቢታፈ ዋት ከስዳኮ፥ ቃስ ጉየፐ አማኖናይሳታ ይስዳይሳ ታ ህንተና አኬክሳናዉ ኮያይስ።<note caller="-" style="x"><char style="xo" closed="false">5 </char><char style="xt" closed="false"><ref loc="EXO 12:51">ከሳ 12:51</ref>፤ <ref loc="NUM 14:29-30">ታይቦ 14:29-30</ref>.</char></note> <verse eid="JUD 1:5"/><verse number="6" style="v" sid="JUD 1:6"/>ባንታ ደእያሱዋ አግድ፥ ባንታዉ እመትዳ ማታ ናግቦና ኪታንቾታ፥ ግታ ፕርዳ ጋላሳይ ጋካናዉ ፆሳይ ኤንታ ማፐ ጋርሳን መርና ሳንላታን ቃች ዎስ። <verse eid="JUD 1:6"/><verse number="7" style="v" sid="JUD 1:7"/>ሄሳዳ፥ ሶዶመነ ጋሞራ አሳይነ ኤንታ ማታን ደእያ ካታማታን ደእያ አሳይ ላይማትዶሶና፤ ላይማተራ ጋሄትያ ቱናተ ኦዶሶና። ኤንቲ መርና ታማን ፕርደታናይሳታስ ሌምሶ ግድዶሶና።<note caller="-" style="x"><char style="xo" closed="false">7 </char><char style="xt" closed="false"><ref loc="GEN 19:1-24">መ 19:1-24</ref>.</char></note><verse eid="JUD 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8"/>ሄሳዳካ፥ ሀ አሙሀንቾት ባንታ አሳተ ቱንሶሶና፤ ማታ አዋታ ካኦሶና፤ ሳሎ መተታ ጫዮሶና። <verse eid="JUD 1:8"/><verse number="9" style="v" sid="JUD 1:9"/>ሽን ኪታንቾታ ሀላቃይ ምካኤል ሙሰ አሃስ ፃላሄራ ፓላምዳ ዎደ፥ “ጎዳይ ነና ሴሮ” ያግስፐ አትሽን፥ እያ ቦላ ጫሻ ቃላ ኦድድ ሞታናዉ ኮይቤና።<note caller="-" style="x"><char style="xo" closed="false">9 </char><char style="xt" closed="false"><ref loc="DAN 10:13">ዳነ 10:13</ref>፥ <ref loc="DAN 10:21">21</ref>፤ <ref loc="DAN 12:1">12:1</ref>፤ <ref loc="REV 12:7">ቆን 12:7</ref>፤ <ref loc="DEU 34:6">ዛረ 34:6</ref>፤ <ref loc="ZEC 3:2">ዛካ 3:2</ref>.</char></note> <verse eid="JUD 1:9"/><verse number="10" style="v" sid="JUD 1:10"/>ሽን ሀ አሳት ባንታዉ ኤሮናባ ኡባ ጫዮሶና፤ ቃስ ኤንቲ ዎዛን ባይና መሄዳ መን ኤርያ ኤራይ፥ እ ኤንታና ይሳና። <verse eid="JUD 1:10"/><verse number="11" style="v" sid="JUD 1:11"/>ኤንታና አየ! ኤንቲ ቃየላ ኦግያን ብዶሶና። ሚሸ ኮይድ ባላማ ባላን ኩንድዶሶና። ቆረ ጌተትያ አደይ ፆሳ ቦላ ደንድዳይሳዳ ኤንቲ ፆሳ ቦላ ደንድድ ይዶሶና።<note caller="-" style="x"><char style="xo" closed="false">11 </char><char style="xt" closed="false"><ref loc="GEN 4:3-8">መ 4:3-8</ref>፤ <ref loc="NUM 22:1-35">ታይቦ 22:1-35</ref>፤ <ref loc="NUM 16:1-35">16:1-35</ref>.</char></note><verse eid="JUD 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JUD 1:12"/>ሀ አሳት፥ ህንተ ሲቆ ግብራ ምያ በሳን ህንተራ ኡትያ ዎደ ዬል ባይና ካዉሻታ። ኤንቲ ባንታና ፃላላ ሄመይሳታ። ኤንቲ ጫርኮይ ኤፍያ እር ባይና ሻራ መላ። ቃስ አይፈ ዎደን አይፈ አይፎና፥ ፃጶራ ሾደትድ፥ ናምኡ ቶሆ መልዳ ም መላ። <verse eid="JUD 1:12"/><verse number="13" style="v" sid="JUD 1:13"/>ኤንቲ ሀንቀትዳ አባ ዙልያ መላ ባንታ ፖኩዋ ጎፖንተይሳታ። ኤንቲ መርናዉ ሳካና ማይ ናግያ ቶይላትያ ፆልንቶታ።<verse eid="JUD 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14"/>አዳመፐ ዶምድ፥ ላፑን የለታ ግድዳ ሄኖከይ፥ ሀ አሳታባ ትንብተ ኦድሸ፥ “ሄኮ፥ ጎዳይ፥ ባ ዳሮ ሙኩሉ ጌሻታራ ያና።<note caller="-" style="x"><char style="xo" closed="false">14 </char><char style="xt" closed="false"><ref loc="GEN 5:18">መ 5:18</ref>፥ <ref loc="GEN 5:21-24">21-24</ref>.</char></note> <verse eid="JUD 1:14"/><verse number="15" style="v" sid="JUD 1:15"/>አሳ ኡባ ፕርዳና፤ ጌላታ ኡባ ኤንቲ ኦዳ ኢታ ኦሶ ኡባ ግሾነ ማካላተን ኤንቲ ፆሳ ቦላ ኦደትዳ ኢታ ኦዳ ኡባ ግሾ ፕርዳና” ያግስ። <verse eid="JUD 1:15"/><verse number="16" style="v" sid="JUD 1:16"/>ሄ አሳት ኡባ ዎደ ዙዙመይሳታነ ኦዳ ኮየይሳታ። ቃስ ባንታ ኢታ አሙዋ ካሎሶና፤ ባንታናን ጬቆሶናነ ባንታና ጎእያባ ደማናዉ ሀራታ ሳቦሶና።<verse eid="JUD 1:16"/></para>
  <para style="s1">ዉርሰ ዞረ</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17"/>ሽን ታ እሻቶ፥ ኑ ጎዳ የሱስ ክርስቶሳ ሀዋረት ካሰ ህንተዉ ኦድዳ ቃላ አኬክተ። <verse eid="JUD 1:17"/><verse number="18" style="v" sid="JUD 1:18"/>ኤንቲ፥ “ዉርሰ ዎድያን፥ ባንታ አሙዋ ካልድ ቶቸይሳት ያና” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">18 </char><char style="xt" closed="false"><ref loc="2PE 3:3">2 ጰፅ 3:3</ref>.</char></note> <verse eid="JUD 1:18"/><verse number="19" style="v" sid="JUD 1:19"/>ሄ አሳት አሳ ግዶን ሻሄተ መይሳታ፥ ባንታ አሾ አሙዋስ ሃረተይሳታነ ጌሻ አያናይ ባይናይሳታ።<verse eid="JUD 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JUD 1:20"/>ሽን ታ እሻቶ፥ ጌሽ ግድዳ ህንተ አማኑዋን ህንተና ድቻናዉ ምንተ፤ ቃስ ጌሻ አያና ዎልቃን ዎስተ። <verse eid="JUD 1:20"/><verse number="21" style="v" sid="JUD 1:21"/>ህንተና መርና ደኡዋኮ ጋያ ኑ ጎዳ የሱስ ክርስቶሳ ማሮተ ናግሸ ህንተና ፆሳ ሲቁዋን ናግተ።<verse eid="JUD 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22"/>ስይ ደእያ አሳስ ቃትተ። <verse eid="JUD 1:22"/><verse number="23" style="v" sid="JUD 1:23"/>እስ እስ አሳታ ታማፐ ከስ ኤክተ። ቃስ ኢታ አሞን ቱንዳ ኤንታ ማኡዋ እፅሸ ሀራታስ ያሻን ቃትተ።<verse eid="JUD 1:23"/></para>
  <para style="s1">ጋላታ ዎሳ</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24"/>ህንተ ኩንዶና መላ ናጋናዉ ቦረይ ባይናይሳታነ ግታ ኡፋይሳን ኩምዳይሳታ ኦድ ባ ቦንቹዋ ስንን ህንተና ሺሻናዉ ዳንዳእያ፥ <verse eid="JUD 1:24"/><verse number="25" style="v" sid="JUD 1:25"/>ኑና አሽያ እስ ፆሳስ፥ ኑ ጎዳ የሱስ ክርስቶሳ ባጋራ ቦንቾይ፥ ግታተ፥ ዎልቅነ ማት፥ ካሰካ፥ ሀእካ፥ መርናዉካ እያዉ ግዶ። አምንእ።<verse eid="JUD 1:25"/></para>
  <chapter eid="JUD 1"/>
</usx>
