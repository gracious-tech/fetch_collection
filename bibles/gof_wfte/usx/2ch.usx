<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2CH" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">2 ታርከ ማፃፋ</para>
  <para style="toc1">2 ታርከ ማፃፋ</para>
  <para style="toc3">2 ታር</para>
  <para style="toc2">2 ታርከ</para>
  <para style="mt">2 ታርከ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">2 ታርከ ማፃፋይ ፃፈትዳይ፥ ጫሞ ግድዳ ካሰ ኤንታ ዱሳ ቆንጭሳናዉ ግዶናሽን፥ ባንታ ቢታን ዎፑ ግድ ዳናዉ ኤንታው ደእያ ኮሻ በሳናሳ። ሄሳዳካ ዳሮ ኦገራ ቆሄትድ ደእያ ድኦፐ ስምዳ፥ እስራኤለ አሳ አማኑዋ ደንናነ ፆሲ ኤንታዉ ገልዳ ኡፋይሳ ቃላ በሳናሳ።</para>
  <para style="ip">2 ታርከ ማፃፋይ ናምኡ ክፍለን ሻከቴስ።</para>
  <para style="ipi">1. ሸምፖ 1-9 ጋካናዉ ደእያ ክፍለይ ካዎ ሶሎሞነ ካዎተ ዎድያ ኦዴስ። ሄ ዎደይ እስራኤለ ቢታን ሳሮይ፥ ዎልቅ፥ ድችነ ቦንቾይ ደእያ ዎደ። ሄ ዎደይ ፆሲ ጎይነትያ ቱማ ጎይኖ በሳይ ዎይኮ ፆሳ ኬይ ኬፀትዳ ዎደነ አንጀትዳ ዎደ (ሸም 2-7)።</para>
  <para style="ipi">2. ሸምፖ 10-36 ጋካናዉ ደእያ ክፍለይ ካዎይ ሶሎሞነይ ሀይቅዳፐ ጉየ ይሁዳን ካዎትዳ ካዎታነ ካዎተይ ሻከትዳይሳ ኦዴስ። ይሁዳ ካዎተይ አያና ደኦን ዳቡርዳነ ፆነትዳ ዎደ ባንታ ደኡዋን ምንድ ደእዳ ካዎትነ ኤንቲ ቢታ ቦላ ኤህዳ ላመይ ሀ ክፍልያን ቆንጭድ በንቴስ። ሄ ካዎታፐ ጉት፥ ካዋ አሳ (ሸም 14-15)፤ ካዋ እዮሳፈፃ (ሸም 17፥ 19-20)፤ ካዋ እዮኣሳ (ሸም 24)፤ ካዋ ህዝቅያሳ (ሸም 29-32)፤ ካዋ እዮስያሳ (ሸም 34-35)።</para>
  <para style="ip">2 ታርከ ማፃፋይ ሎኦ ካዎታ ታርከ ፃላላ ግዶናሽን፥ ይሁዳ አሳ ድኦስ ጋዳ ኢታ ካዎታካ በሴስ። ሄ ኢታ ካዎታ ጋሶን ክ.የ.ስ. 586 ላይን የሩሳላመይ ይስ፤ ፆሳ ኬይካ ላለትስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ሶሎሞነ ጭንጫተነ ዱረርተ (<char style="ior"><ref loc="2CH 1:1-17">1:1-17</ref></char>)</para>
  <para style="io1">ፆሳ ኬ ኬፀተነ አንጀተ (<char style="ior"><ref loc="2CH 2:1-7:22">2:1—7:22</ref></char>)</para>
  <para style="io1">ሶሎሞነ ዎድያነ እያ ሀይቁዋ (<char style="ior"><ref loc="2CH 8:1-9:31">8:1—9:31</ref></char>)</para>
  <para style="io1">ፑደሀ ባጋ ኮቻታ ማካላተ (<char style="ior"><ref loc="2CH 10:1-19">10:1-19</ref></char>)</para>
  <para style="io1">ይሁዳ ካዎታ (<char style="ior"><ref loc="2CH 11:1-28:27">11:1—28:27</ref></char>)</para>
  <para style="io1">ካዋ ህዝቅያሳነ አሶረ ኦላ (<char style="ior"><ref loc="2CH 29:1-32:33">29:1—32:33</ref></char>)</para>
  <para style="io1">ካዋ ምናሰነ አሞነ ካዋ (<char style="ior"><ref loc="2CH 33:1-25">33:1-25</ref></char>)</para>
  <para style="io1">ህገ ማፃፋይ በንትስ (<char style="ior"><ref loc="2CH 34:1-35:27">34:1—35:27</ref></char>)</para>
  <para style="io1">ዉርሰ ይሁዳ ካዎታ (<char style="ior"><ref loc="2CH 36:1-16">36:1-16</ref></char>)</para>
  <para style="io1">የሩሳላመ ላለተነ አይሁደታ ስሙዋ (<char style="ior"><ref loc="2CH 36:17-23">36:17-23</ref></char>)</para>
  <chapter number="1" style="c" sid="2CH 1"/>
  <para style="s1">ሶሎሞነይ ጭንጫተስ ዎስስ</para>
  <para style="r">(<ref loc="1KI 3:1-15">1 ካዎ 3:1-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 1:1"/>ጎዳይ እያ ፆሳይ እያራ ደእያ ግሾነ እያ ዳሮ ግታይዳ ግሾ ዳዊታ ናአይ ካዎይ ሶሎሞነይ ባ ካዎተ ምንስ።<verse eid="2CH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 1:2"/>ሶሎሞነይ እስራኤለ ኡባ፥ ሻላቃታ፥ ማቶ ሀላቃታ፥ ዳናታ፥ እስራኤለ አሳ ካለያ ኡባነ ሶ አሳ ሀላቃታ ፄግድ ሺሽስ። <verse eid="2CH 1:2"/><verse number="3" style="v" sid="2CH 1:3"/>ሄሳፈ ጉየ፥ ሶሎሞነይነ ሺቅዳ አሳ ኡባይ ጋባኦናን ደእያ ቃ ጎይኖ በሳ ብዶሶና። ጎዳ አይለይ ሙሰይ መላ ቢታን ኦዳ ዱንካነይ ያን ደኤስ። <verse eid="2CH 1:3"/><verse number="4" style="v" sid="2CH 1:4"/>ካሰ ዳዊቲ ታቦትያስ የሩሳላመን ዱንካነ ቶክድ፥ ቅርያት-ይኣርመፐ እ ጊግስድ ዎዳ በሳ ኤህስ። <verse eid="2CH 1:4"/><verse number="5" style="v" sid="2CH 1:5"/>ሁራ ናኣ ኡረ ናአይ ባፃልኤል ናሰ ብራታፐ ኦዳ ያርሾ በሳይ፥ ጋባኦናን ጎዳ ዱንካንያ ስንን ደኤስ። ሶሎሞነይነ ሺቅዳ አሳይ ጎዳስ ያን ጎይንዶሶና። <verse eid="2CH 1:5"/><verse number="6" style="v" sid="2CH 1:6"/>ሶሎሞነይ ዱንካንያ ስንን ደእያ ናሰ ብራታፐ ኦሰትዳ ያርሾ በሳኮ፥ ጎዳ ስን ብድ፥ እስ ሙኩሉ ፁሳ ያርሾ ያርሽስ።<verse eid="2CH 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 1:7"/>ሄ ጋላስ ቃማ ፆሳይ ሶሎሞነስ ቆንጭድ፥ “ታ ነዉ አይ እማና መላ ኮያይ?” ያግስ።<verse eid="2CH 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 1:8"/>ሶሎሞነይ፥ “ነ ታ አዋ ዳዊታ ግታ ሲቆን ዶሳዳሳ፤ ታና እያ በሳን ካዎዳሳ። <verse eid="2CH 1:8"/><verse number="9" style="v" sid="2CH 1:9"/>አቤት ጎዳዉ፥ ፆሳዉ፥ ነ ታ አዋ ዳዊታስ ካሰ ግዳ ቃላይ ፖለቶ። ነ ታና ሳአን ደእያ ባናዳ ዳርዳ አሳ ቦላ ካዎዳ ግሾ፥ <verse eid="2CH 1:9"/><verse number="10" style="v" sid="2CH 1:10"/>ታ ሀ አሳ ካለና መላ ታዉ ጭንጫተነ አኬካ እማ። ሄስ ሀኖና እፅኮ፥ ሀ ግታ አሳ ኦን አይሳናዉ ዳንዳኢ?” ያግስ።<verse eid="2CH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 1:11"/>ፆሳይ ሶሎሞነኮ፥ “ነ ዱረተ ዎይኮ ሻሎ ደማናዉ ዎይኮ ቦንቸታናዉ ዎይኮ ነ ሞርከት ሀይቃና መላ ዎይኮ ነ ላይይ አዱቃና መላ ኦይቾናሽን ታ ነና ካዎዳ ታ አሳ አይሳናዉ ጭንጫተነ አኬካ ኦይችዳ ግሾ፥ <verse eid="2CH 1:11"/><verse number="12" style="v" sid="2CH 1:12"/>ነዉ ጭንጫተነ አኬካ እማና። ቃስ ኔፐ ካሰ ደእዳ ካዎታስ ዎይኮ ኔፐ ጉየ ደንዳና ካዎታስ ባይና ዱረተ፥ ሻሎነ ቦንቾ ነዉ እማና” ያግስ።<verse eid="2CH 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 1:13"/>ሶሎሞነይ ዱንካነይ ጋባኦናን ደእያ፥ ቃ ጎይኖ በሳፈ ስሚድ፥ የሩሳላመ ብድ እስራኤለ ቦላ ካዎትስ።<verse eid="2CH 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 1:14"/>ሶሎሞነይ ፓራ ጋረታነ ፓራታ ሺሽስ። እያዉ እስ ሙኩሉነ ኦይዱ ፄቱ ፓራ ጋረትነ ታማነ ናምኡ ሙኩሉ ፓራት ደኦሶና። እ ኤንታ ፓራ ጋረታ ካታማታንነ ባራ የሩሳላመን ዎስ። <verse eid="2CH 1:14"/><verse number="15" style="v" sid="2CH 1:15"/>ካዎይ ዎርቃይነ ብራይ የሩሳላመን ሹቻዳ ዶረታናዳ፥ ጋን ቦቢ ድጭያ መላ ዝጋ ም ዳራና መላ ኦስ። <verse eid="2CH 1:15"/><verse number="16" style="v" sid="2CH 1:16"/>ሶሎሞነ ፓራት ግብፀፈነ ቃወ ቢታፈ ይዶሶና። ካዋ ዛልአንቾት ኤንታ ቃወፐ ሚሸን ሻምድ ኤሆሶና። <verse eid="2CH 1:16"/><verse number="17" style="v" sid="2CH 1:17"/>ኤንቲ እስ እስ ፓራ ጋርያ ኡሱፑን ፄቱ ብራ ሳንትመን፥ እስ እስ ፓራ እስ ፄታነ እሻታሙ ብራ ሳንትመን ግብፀፈ ሻምድ፥ ህተታ ካዎታ ኡባስነ ሶረ ካዎታስ ባይዞሶና።<verse eid="2CH 1:17"/></para>
  <chapter eid="2CH 1"/>
  <chapter number="2" style="c" sid="2CH 2"/>
  <para style="s1">ፆሳ ኬ ኬፃናዉ ጊገተ</para>
  <para style="r">(<ref loc="1KI 5:1-18">1 ካዎ 5:1-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 2:1"/>ሶሎሞነይ ጎዳ ሱንስ ኬነ ባዉ ጋ ኬፃናዉ ሀልችስ። <verse eid="2CH 2:1"/><verse number="2" style="v" sid="2CH 2:2"/>ሶሎሞነይ ቶሆስ ላፑን ታሙ ሙኩሉ አሳነ ገዘ ቢታን ሹቹ ቆአናዉ ሆስፑን ታሙ ሙኩሉ አሳ ዶርስ። ቃስ ኤንታ ዎችያ ሄ ሙኩሉነ ኡሱፑን ፄቱ አሳታ ኤንታ ቦላ ሹምስ።<verse eid="2CH 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 2:3"/>ሶሎሞነይ ፅሮሳ ካዋ ክራማስ ኪታ ኪትድ፥ “ታ አዋይ ዳዊቲ ባ ጋ ኬፃና መላ ኔኒ ዝጋ የድዳይሳዳ ታዉካ የዳ። <verse eid="2CH 2:3"/><verse number="4" style="v" sid="2CH 2:4"/>ሄኮ፥ ሀእ ታ ጎዳ፥ ታ ፆሳ ሱንስ ኬ ኬፃናዉ ሀናይስ። ታ ያን ሳዎ ቶንኩ ግያ እፃነ ጩይሳናዉ፥ ኡባ ዎደ ጎዳ ስንን ኡይ ዎናዉነ ዎንታነ ኦማርስ፥ ሳምባታ ጋላሳን፥ አጌን ፄርያ ዎደነ ጎዳ ኑ ፆሳ ባኣለ ጋላሳታን ፁሳ ያርሾ ያርሻናዉ፥ ፆሳ ኬ ዱማያና። እስራኤለ አሳይ መርናዉ ኦና መላ ኪተትዳ ኦሶት ሀይሳታ።<verse eid="2CH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 2:5"/>“ኑ ፆሳይ ሀራ ፆሳታ ኡባፈ ግታ ግድያ ግሾ፥ ታ ኬፃናዉ ሀንያ ፆሳ ኬይ ግታ። <verse eid="2CH 2:5"/><verse number="6" style="v" sid="2CH 2:6"/>ሽን እያዉ ኬ ኬፃናዉ ዳንዳኤይ ኦኔ? ሳሎፐ ቃ ሳሎይ እያዉ ግደና! ያትን፥ ታ እያ ስንን እፃነ ጩይሳናዉነ ታ እያዉ ኬ ኬፃናዉ ኦኔ?<verse eid="2CH 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 2:7"/>“ህዛ አሌቆ ኦሶ፥ ዎርቃ፥ ብራ፥ ናሰነ ብራታ ሴርስያ ኦሱዋነ ዞኦ ማኡዋ፥ ኦቻ ቴራ ዳንያ ማኡዋነ ካሎሰ ማኡዋ ጊግስያ ኤራተ ደእያ አሰ ታዉ የዳ። ታ አዋይ ዳዊቲ ይሁዳንነ የሩሳላመን ደእያ ኩሸ ሂላንቾታ ዶር ዎስ፤ እ ኤንታራ እስፈ ኦና። <verse eid="2CH 2:7"/><verse number="8" style="v" sid="2CH 2:8"/>ልባኖሰን ደእያ ነ አሳት ም ዋት ቃንፅያኮ ኤረይሳ ታ ኤራይስ። ሄሳ ግሾ፥ ኔኒ ታዉ ልባኖሰፐ ዝጋ፥ ፂዳነ ፃይ ም የዳ። ታ አሳት ነ አሳታራ ግድድ፥ <verse eid="2CH 2:8"/><verse number="9" style="v" sid="2CH 2:9"/>ዳሮ ም ጊግሳና። ታኒ ኬፅያ ፆሳ ኬይ ግታነ ማላልስያባ። <verse eid="2CH 2:9"/><verse number="10" style="v" sid="2CH 2:10"/>ም ቃንፅያ ነ አይለታ ታኒ ላታሙ ሙኩሉ ኩንታለ ግስተነ ላታሙ ሙኩሉ ኩንታለ ባንጋ፥ ኦይዱ ፄቱ ሙኩሉ ልትሮ ዎይነነ ኦይዱ ፄቱ ሙኩሉ ልትሮ ሻማሆ ዛይተ እማና” ያግስ።<verse eid="2CH 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 2:11"/>ፅሮሳ ካዎይ ክራም ሶሎሞነኮ ዳብዳበ የድሸ፥</para>
  <para style="b" vid="2CH 2:11"/>
  <para style="pi" vid="2CH 2:11">“ጎዳይ ባ አሳ ዶስያ ግሾ፥ እ ነና ኤንታ ቦላ ካዎስ።”<verse eid="2CH 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 2:12"/>ክራም ጉጅድ፥ “ፆሳ ኬነ ባዉ ጋ ኬፃና መላ ጭንጫ፥ አኬካነ ሂላ ናኣ ካዋ ዳዊታስ እምዳ፥ ሳሎ ሳኣ መዳ ጎዳይ፥ እስራኤለ ፆሳይ ጋላተቶ።<verse eid="2CH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 2:13"/>“ታኒ ክራም-አብ ጌተትያ ሂላንቾነ አኬካ አድያ ነዉ የዳስ። <verse eid="2CH 2:13"/><verse number="14" style="v" sid="2CH 2:14"/>እያ አይያ ዳነ ኮቸ፤ እያ አዋይ ፅሮሳ ቢታ አሳ። እ ዎርቃ፥ ብራ፥ ናሰ ብራታ፥ ብራታ፥ ሹቹነ ም ኦያ አስ፤ ኦቻ ቴራ ዳንያ ማኦ፥ ካሎሰ ማኦ፥ ዞኦ ማኦነ ሊኖ ማኦ ጊግስያ ኦሶ ኤሬስ። እ ዱማ ዱማ አሌቆታ ከስድ፥ ኦደይሳዳ ኡባ ኦናዉ ዳንዳኤስ። እ ኩሸ ሂላን ሎህዳ ነ አሳራነ ካሰ ነ አዋ፥ ዳዊታስ ኦዳ አሳራ እያ ኦስሳ። <verse eid="2CH 2:14"/><verse number="15" style="v" sid="2CH 2:15"/>ህዛ ነ ታ ጎዳይ እማና ግዳ ግስትያነ ባንጋ፥ ዛይትያነ ዎይንያ የዳ። <verse eid="2CH 2:15"/><verse number="16" style="v" sid="2CH 2:16"/>ኔኒ ልባኖሰፐ ኮይዳ ም ኑ ቃንፅድ ቃችድ፥ አባ ቦላራ ቶከትድ፥ ኔኮ ዮጰ ባናዳ ኦና። ያፐ ኔኒ የሩሳላመ ጋካናዉ ኤፍሳና” ያግስ።<verse eid="2CH 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 2:17"/>እያ አዋይ ዳዊቲ ካሰ ታይብዳይሳዳ፥ ሶሎሞነይ እስራኤለ ቢታን ደእያ ካረ ቢታ አሳ ኡባ ታይብስ። ኤንቲ ፄታነ እሻታማነ ሄ ሙኩሉነ ኡሱፑን ፄታ ግድዶሶና። <verse eid="2CH 2:17"/><verse number="18" style="v" sid="2CH 2:18"/>ሶሎሞነይ ሄ አሳፐ ላፑን ታሙ ሙኩሉ አሳ ቶሆስ፥ ሆስፑን ታሙ ሙኩሉ አሳ ገዘ ቢታን ሹቻ ቆአናዉ ዶርስ፤ ኤንታ ዎቻናው ሄ ሙኩሉነ ኡሱፑን ፄቱ አሳ ሹምስ።<verse eid="2CH 2:18"/></para>
  <chapter eid="2CH 2"/>
  <chapter number="3" style="c" sid="2CH 3"/>
  <para style="s1">ሶሎሞነይ ፆሳ ኬ ኬፁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 3:1"/>ሶሎሞነ አዋይ ዳዊቲ ፆሳ ኬይ ኬፀታና በሳ ሞረ ደርያን የሩሳላመን ጊግስስ። ሄ በሳይ ጎዳይ ዳዊታስ ቆንጭዳ ያቡሰ አድያ ኦርና ዉዱማ። <verse eid="2CH 3:1"/><verse number="2" style="v" sid="2CH 3:2"/>ሶሎሞነይ ባ ካዎትዳ ኦይዳን ላይን፥ ናምአን አጌናን ፆሳ ኬ ኬፃናዉ ዶምስ።<verse eid="2CH 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 3:3"/>ሶሎሞነይ ፆሳ ኬ ኬፃናዉ ባስዳ ባሱዋ አዱሳተይ ኡሱፑን ታሙ ዋ፤ ጎምፓይ ላታሙ ዋ። <verse eid="2CH 3:3"/><verse number="4" style="v" sid="2CH 3:4"/>ፆሳ ኬ ገልያ በሳን ደእያ ባራንዳ ጎምፓይ ፆሳ ኬ ጎምፓዳ ላታሙ ዋ፤ አዱሳተይ ላታሙ ዋ። <verse eid="2CH 3:4"/><verse number="5" style="v" sid="2CH 3:5"/>ፐንገ ጎዳ ፂዳ ፃላላን ልጭድ ካምስ፤ ጌሻ ዎርቃን ትይስ፤ ዛምባ ምስለነ ሳንላታ ምስለን አሌቅስስ። <verse eid="2CH 3:5"/><verse number="6" style="v" sid="2CH 3:6"/>ፆሳ ኬ አልኦ ሹቻን አሌቅስስ፤ እ አሌቅስዳ ዎርቃይ ፓርዋይማ ቢታፈ ይዳ ዎርቃ። <verse eid="2CH 3:6"/><verse number="7" style="v" sid="2CH 3:7"/>ጎዳታ፥ ቱቀታ፥ ጎባነታነ ፐንገታ ዎርቃን ትይስ፤ ጎዳ ቦላ ክሩበ ምስለ መስ።<verse eid="2CH 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 3:8"/>ሶሎሞነይ ኡባፈ ጌሻ በሳ ኬፅስ። ሄ በሳ አዱሳተ ፆሳ ኬ ጎምፓዳ ላታሙ ዋ፤ ጎምፓይ ላታሙ ዋ። ሄ በሳ ጎዳ ላታሙ ሙኩሉ ክሎ ግራመ ሙሩቶ ዎርቃን ትይስ። <verse eid="2CH 3:8"/><verse number="9" style="v" sid="2CH 3:9"/>ኤንቲ ጎኤትዳ ምስማረይ እቻሹ ፄታነ ላፑን ታሙ ግራመ ዎርቃፈ መትስ። ፖቀን ደእያ ክፍለታካ ዎርቃን ትይስ።<verse eid="2CH 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 3:10"/>ሶሎሞነይ ኡባፈ ጌሻ በሳን ናምኡ ክሩበ ምስለታ ጊግስድ ዎርቃን ትይስ። <verse eid="2CH 3:10"/><verse number="11" style="v" sid="2CH 3:11"/>ሄ ክሩበታ ቀፈይ ምጨትድ፥ ላታሙ ዋ፤ ኮይሮ ክሩብያ ኮይሮ ቀፈይ እቻሹ ዋ ግድድ፥ ፆሳ ኬ ጎዳ ቦቼስ፤ ናምአን ቀፈይ እቻሹ ዋ ግድድ፥ ሀራ ክሩብያ ቀፍያ ቦቼስ። <verse eid="2CH 3:11"/><verse number="12" style="v" sid="2CH 3:12"/>ናምአን ክሩብያ ኮይሮ ቀፈይ እቻሹ ዋ ግድድ፥ ፆሳ ኬ ጎዳ ቦቼስ፤ ናምአን ቀፈይ እቻሹ ዋ ግድድ፥ ኮይሮ ክሩብያ ቀፍያ ቦቼስ። <verse eid="2CH 3:12"/><verse number="13" style="v" sid="2CH 3:13"/>ሀ ናምኡ ክሩበታ ቀፈይ ምጨትድ፥ ላታሙ ዋ ግድስ፤ ኤንቲ ባንታ ሶምኡዋ ጌሻ በሳኮ ዛሪድ፥ ባንታ ቶሆን ኤቅዶሶና።<verse eid="2CH 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 3:14"/>ሶሎሞነይ ካሎሰ ማኡዋ፥ ኦቻ ቴራ ዳንያ ማኡዋፐነ፥ ዞኦ ማኡዋፐ ሊኖፐ ዳደትዳ ማኡዋፐ ማጋራጆ ኦድ፥ እያ ቦላ ክሩበታ ምስለ መስ።<verse eid="2CH 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 3:15"/>ሶሎሞነይ ፆሳ ኬ ስንን እሱዋ እሱዋ አዱሳተይ ሀስታማነ እቻሹ ዋ ግድዳ ናምኡ ቱሳታ ኦስስድ፥ ኤንታ ሁጰን እቻሹ ዋ ጉምቦታ ዎስ። <verse eid="2CH 3:15"/><verse number="16" style="v" sid="2CH 3:16"/>ቃስ ሳንላታ ግተዳ መስድ፥ ቱሳታ ሁጰን ዎስ፤ ፄቱ ኦሮማነ ቴራ ምስለታ መስድ፥ ሳንላታ ቦላ ዎስ። <verse eid="2CH 3:16"/><verse number="17" style="v" sid="2CH 3:17"/>ቱሳታፐ እሱዋ ፆሳ ኬ ስንን ኡሻቻ ባጋራ፥ ናምአንዋ ቃስ ሀድርሳ ባጋራ ኤስስ። ኡሻቻ ባጋራ ደእያ ቱሳ ያክና ሱንድ፥ ሀድርሳ ባጋራ ደእያ ቱሳ ቦኤዛ ሱንስ።<verse eid="2CH 3:17"/></para>
  <chapter eid="2CH 3"/>
  <chapter number="4" style="c" sid="2CH 4"/>
  <para style="s1">ፆሳ ኬ ሚሸታ</para>
  <para style="r">(<ref loc="1KI 7:23-51">1 ካዎ 7:23-51</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 4:1"/>ሄሳፈ ጉየ፥ ሶሎሞነይ አዱሳተ ላታሙ ዋ፥ ጎምፓይ ላታሙ ዋ፥ ቃተይ ታሙ ዋ ግድያ ያርሾ በሳ ናሰ ብራታፐ ኦስስስ።<verse eid="2CH 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 4:2"/>ቃስ ናሰ ብራታ ሴርስድ፥ ዶናይ ያ ጋፃፐ ሀ ጋፃ ጋካናዉ ታሙ ዋ፥ አዱሳተይ እቻሹ ዋነ ዩሾይ ሀስታሙ ዋ ግድያ አባ ሳነ መስስ። <verse eid="2CH 4:2"/><verse number="3" style="v" sid="2CH 4:3"/>አባ ሳነ ዶናን ካረ ባጋራ ዩይ አድ፥ እያራ ኦይከትድ መትዳ ምስለት ደኦሶና፤ ሄ ምስለት ናምኡ ማራን ደእያ ቦራታ ምስለታ።<verse eid="2CH 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 4:4"/>ሄ አባ ሳነ ናሰ ብራታፐ መትዳ ታማነ ናምኡ ቦራታ ምስለታስ ዞኩዋን ኡትስ። ቦራታፐ ሄት ፑደሀ ባጋ፥ ሄት ዉሎሀ ባጋ፥ ሄት ዱገሀ ባጋ፥ ሄት ቃስ ዶሎሀ ባጋ ስሚድ ፄልያባ ዳኖሶና። አባ ሳነ ኤንታ ቦላ ኡትስ፤ ኤንታስ ጉየ ባጋይ ግዶኮ ስም ኡትስ። <verse eid="2CH 4:4"/><verse number="5" style="v" sid="2CH 4:5"/>አባ ሳነይ እስ ታካ መላ ኦርደ፤ እያ ዶናይ ዋንጫ ዶና መላ፤ ሱፈ ጪሽ ዳኔስ። ሄ አባ ሳነይ ኡሱፑን ታሙ ሙኩሉ ልትሮ ግድያ ሃ ኦይከይሳ።<verse eid="2CH 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 4:6"/>ሶሎሞነይ ሜጨትያ ታሙ ከረታ፤ ኦስስድ፥ እቻሻ ኡሻቻ ጋርሳ ባጋራ፥ እቻሻ ሀድርሳ ባጋራ ዎስ። ኤንታን ፁሳ ያርሾ አሾይ ሜጨቴስ፤ ሽን አባ ሳነ ሃን ካህነት ሜጨቶሶና።<verse eid="2CH 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 4:7"/>ሄሳፈ ጉየ፥ ሶሎሞነይ ኤንታዉ እመትዳ ሀልቹዋዳ ፆምፐ ዎያ ታሙ ኮጫታ ዎርቃፈ ኦድ፥ እቻሻ ኡሻቻ ባጋራ፥ እቻሻ ሀድርሳ ባጋራ ፆሳ ኬን ዎስ። <verse eid="2CH 4:7"/><verse number="8" style="v" sid="2CH 4:8"/>ታሙ ፃርጴዛታ ኦድ፥ እቻሻ ኡሻቻ ባጋራ፥ እቻሻ ሀድርሳ ባጋራ ፆሳ ኬ ግዶን ዎስ። ቃስ ፄቱ ድስተታ ዎርቃፈ ኦስ። <verse eid="2CH 4:8"/><verse number="9" style="v" sid="2CH 4:9"/>ሶሎሞነይ ካህነታስ ግዶ ዳባባ፥ ካረ ባጋ ግታ ዳባባ ጊግስስ፤ ዳባባስ ፐንገታ ጊግስድ፥ ፐንገታ ናሰ ብራታን ላንፅስ። <verse eid="2CH 4:9"/><verse number="10" style="v" sid="2CH 4:10"/>አባ ሳንያ ፆሳ ኬፈ ጋርሳን ዶሎሀ ባጋን ዎስ።<verse eid="2CH 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 4:11"/>ክራም ከረታ፥ አካፋታነ ፃሮታ መስ፤ ክራም ካዋ ሶሎሞነስ ፆሳ ኬን ኦሶ ኦድ ፖልስ። <verse eid="2CH 4:11"/><verse number="12" style="v" sid="2CH 4:12"/>እ ኦዳ ኦሶትካ ናምኡ ቱሳታ፥ ቱሳታ ሁጰን ዎያ ሳነ መላ ናምኡ ጉምቦታ፥ ቱሳታ ቦላ ደእያ ናምኡ ጉምቦታ አሌቅስያ ናምኡ ግተ ዳንያ ሳንላታ፥ <verse eid="2CH 4:12"/><verse number="13" style="v" sid="2CH 4:13"/>እስ እስ ቱቅያ ቦላ ናምኡ ማራን ናሰ ብራታፐ ኦሰትዳ እስ እስ ፄቱ ኦሮማነ ቴራ ምስለታ፥ ኩመ ኦይዱ ፄቱ ኦሮማነ ቴራ ምስለታ፥ <verse eid="2CH 4:13"/><verse number="14" style="v" sid="2CH 4:14"/>ኦይደታነ ኦይደታ ቦላ ኡትያ ሜቻ ታሙ ከረታ፥ <verse eid="2CH 4:14"/><verse number="15" style="v" sid="2CH 4:15"/>አባ ሳነይነ እያፐ ጋርሳን ደእያ ታማነ ናምኡ ቦራ ምስለታ፥ <verse eid="2CH 4:15"/><verse number="16" style="v" sid="2CH 4:16"/>ከረታ፥ አካፋታ፥ ቃጰታነ ሀራ ሚሸታ ኡባ።</para>
  <para style="p" vid="2CH 4:16">ክራም-አብ ካዋ ሶሎሞነስ ፆሳ ኬ ኦሱዋስ መዳ ሀ ሚሸታ ኡባ ጌሻ ናሰ ብራታፐ መስ። <verse eid="2CH 4:16"/><verse number="17" style="v" sid="2CH 4:17"/>ካዎይ ሶሎሞነይ ሱኮታፐነ ፃሬዳፐ ግዶን፥ ዮርዳኖሰ ደንባን ደእያ ናሰ ብራታ ሼሽያ በሳን ሀ ኡባ ኦስስስ። <verse eid="2CH 4:17"/><verse number="18" style="v" sid="2CH 4:18"/>ናሰፐ መትዳ ሀ ሚሸ ኡባይ ዳሮ ግድዳ ግሾ፥ አይ መላ ዴፅያኮ ልከይ ኤረትቤና።<verse eid="2CH 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 4:19"/>ሶሎሞነይ ፆሳ ኬን ደእያ ሚሸታ ኡባ ዎርቃፈ ኦስስስ። ሄስካ ዎርቃፈ ኦሰትዳ ያርሾ በሳ፥ ጎዳ ስንን ዎያ ኡይይ ኡትያ ፃርጴዛ፥ <verse eid="2CH 4:19"/><verse number="20" style="v" sid="2CH 4:20"/>ዎጋ መላ ኡባፈ ጌሻ በሳ ስንን ፖአና መላ ፆምፐ ዎያ ዎርቃ ኮጫ፥ ዎርቃ ፆምፐታ፥ <verse eid="2CH 4:20"/><verse number="21" style="v" sid="2CH 4:21"/>ዋላህ ባይና ዎርቃፈ ኦሰትዳ ጪሻ ምስለታ፥ ፆምፐታነ ቃጰታ፥ <verse eid="2CH 4:21"/><verse number="22" style="v" sid="2CH 4:22"/>ፆምፐ ቶይስያባታ፥ ፃሮታ፥ እፃነ ጩይስያባታነ ታማ ኤክያ ቃጰታ። ሀ ሚሸት ኡባይ ጌሻ ዎርቃፈ ኦሰትዶሶና። ፆሳ ኬስ ካረ ባጋ ፐንገታነ ኡባፈ ጌሻ በሳ ገልያ ፐንገታ ዎርቃን ትይስ።<verse eid="2CH 4:22"/></para>
  <chapter eid="2CH 4"/>
  <chapter number="5" style="c" sid="2CH 5"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 5:1"/>ሶሎሞነይ ፆሳ ኬ ኦሶ ኡባ ፖልዳፐ ጉየ እያ አዋይ ዳዊቲ ጎዳስ ዱማይድ ዎዳ ብራ፥ ዎርቃነ ሀራ ሚሸታ ኡባ ኤህድ፥ ፆሳ ኬ ቡቁራ ምንጅያ በሳን ዎስ።<verse eid="2CH 5:1"/></para>
  <para style="s1">ታቦተይ ፆሳ ኬ ገልስ</para>
  <para style="r">(<ref loc="1KI 8:1-9">1 ካዎ 8:1-9</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 5:2"/>ሄሳፈ ጉየ፥ ካዎይ ሶሎሞነይ ጎዳ ቃላ ጫቆ ታቦትያ ዳዊታ ካታማ ግድዳ ፅዮነፐ ኤሀና መላ እስራኤለ ጭማታ፥ እስራኤለ ኮቻታነ ሶ አሳ ሀላቃታ የሩሳላመ ሺሽስ። <verse eid="2CH 5:2"/><verse number="3" style="v" sid="2CH 5:3"/>እስራኤለ አሳ ኡባይ ላፑን አጌናን፥ ሻቃራ ባለይ ቦንቸትያ ዎደ ካዋኮ ሺቅዶሶና። <verse eid="2CH 5:3"/><verse number="4" style="v" sid="2CH 5:4"/>እስራኤለ ጭማት ኡባይ ጋክን፥ ሌወት ታቦትያ ደንዶሶና። <verse eid="2CH 5:4"/><verse number="5" style="v" sid="2CH 5:5"/>ሌወትነ ካህነት ታቦትያ፥ ዱንካንያነ እያ ግዶን ደእያ ጌሻ ሚሸታ ኡባ ቶክድ ኤህዶሶና። <verse eid="2CH 5:5"/><verse number="6" style="v" sid="2CH 5:6"/>ካዎይ ሶሎሞነይነ እያራ ደእያ እስራኤለ ማባራ ኡባይ ታቦትያ ስንን ሺቅድ፥ ታይባናዉ ዳንዳኤቶና ዳሮ ዶርሰነ መሄ ያርሽዶሶና።<verse eid="2CH 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 5:7"/>ካህነት ጫቆ ታቦተይ ፆሳ ኬ ኡባፈ ጌሻ በሳ ኤህድ፥ ክሩበታ ምስለታ ቀፈታፐ ጋርሳራ ዎዶሶና። <verse eid="2CH 5:7"/><verse number="8" style="v" sid="2CH 5:8"/>ምጨትድ ኡትዳ ክሩበታ ቀፈት ታቦትያነ ታቦትያ ቶክያ ካሶታ ካምዶሶና። <verse eid="2CH 5:8"/><verse number="9" style="v" sid="2CH 5:9"/>ካሶት ዳሮ አዱሰ ግድያ ግሾ፥ ኤንታ ፄራይ ኡባፈ ጌሻ በሳ ስንን ደእያ ጌሻ በሳን ኤቅዳ አስ በአናዉ ዳንዳኤስ፤ ሽን ጌሻ በሳፈ ካረራ በንተና። ኤንቲ ሀች ጋካናዉ ሄ በሳን ደኦሶና። <verse eid="2CH 5:9"/><verse number="10" style="v" sid="2CH 5:10"/>እስራኤለ አሳይ ግብፀ ቢታፈ ከይዳ ዎደ ጎዳይ ኤንታራ ጫቅዳ ኮሬባ ዙማን ሙሰይ ዎዳ ናምኡ ሎቸ ሹቻታፐ አትሽን፥ ታቦትያ ግዶን ሀራባይ ባዋ።<verse eid="2CH 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 5:11"/>ሄ በሳን ደእያ ካህነት ኡባይ ባንታ ኦያ በሳን በሳን ሻከቶና ደእሸ ባንታና ጎዳስ ዱማይዶሶና። <verse eid="2CH 5:11"/><verse number="12" style="v" sid="2CH 5:12"/>ማዝሙረ ዛማርያ ሌወት ኡባይ፥ አሳፍ፥ ሄማንነ ኤዶታፐ፥ ኤንታ ናይትነ ኤንታ ዳቦት ሊኖ ጌተትያ ማኦ ማእዶሶና። ሄ ማኡዋ ማእድ፥ ዳላ፥ ዲነ ማስንቆ ኦይክድ፥ ያርሾ በሳፈ ዶሎሀ ባጋራ ኤቅዶሶና። <verse eid="2CH 5:12"/><verse number="13" style="v" sid="2CH 5:13"/>ፄታነ ላታሙ ካህነት ሞይዘ ፑናናዉ ኤንታራ ኤቅዶሶና። ኤንቲ ኡባይ ሞይዘ ፑንሸ፥ ዳላ ቃሸ፥ ዲ ዲፅሸነ ሀራ ሚሸታ ካእሸ፥</para>
  <para style="q1" vid="2CH 5:13">“ጎዳይ ኬሀ!</para>
  <para style="q2" vid="2CH 5:13">እያ ሲቆይ መርናሳ”</para>
  <para style="m" vid="2CH 5:13">ያግድ ጎዳ ሳቦሶና።<verse eid="2CH 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 5:14"/>ጎዳ ቦንቾይ ፆሳ ኬ ኩምዳ ግሾ፥ ሻራ ጋሶን ካህነት ባንታ ኦሱዋ ኦናዉ ዳንዳእቦኮና።<verse eid="2CH 5:14"/></para>
  <chapter eid="2CH 5"/>
  <chapter number="6" style="c" sid="2CH 6"/>
  <para style="s1">ሶሎሞነ ሃሳያ</para>
  <para style="r">(<ref loc="1KI 8:12-21">1 ካዎ 8:12-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 6:1"/>ሶሎሞነይ፥ “አቤት ጎዳዉ፥ ‘ታ ማ ሻራን ዳና’ ያጋዳሳ። <verse eid="2CH 6:1"/><verse number="2" style="v" sid="2CH 6:2"/>ሽን ታኒ ኔኒ ያን መርናዉ ዳና ሎኦ ኬ ነዉ ኬፃስ” ያግስ።<verse eid="2CH 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 6:3"/>እስራኤለ ሺቆይ ያን ኤቅዳሽን፥ ካዎይ ኤንታኮ ስሚድ፥ ኤንታ ሀይሳዳ ያግድ አንጅስ፤ <verse eid="2CH 6:3"/><verse number="4" style="v" sid="2CH 6:4"/>“ጎዳይ እስራኤለ ፆሳይ ጋላተቶ! ታ አዋ ዳዊታስ ባ ዶናን ኦድዳ ኡፋይሳ ቃላ ባ ኩሸን ፖልስ። ሄ እ ኦድዳ ኡፋይሳይ፥ <verse eid="2CH 6:4"/><verse number="5" style="v" sid="2CH 6:5"/>‘ታኒ ታ አሳ እስራኤለ ግብፀፈ ከሳዳ ኤህዳ ዎደፐ ዶምን፥ ታ ሱንይ እያን ፄገታና መላ ታዉ ኬ ኬፃናዉ እስራኤለ ኮቻታ ግዶን አይ ካታማካ ዶራብከ፤ ዎይኮ እ ታ አሳ እስራኤለ ካለና መላ ኦናካ ዶራብከ። <verse eid="2CH 6:5"/><verse number="6" style="v" sid="2CH 6:6"/>ሽን ሀእ ታ ሱንይ የሩሳላመን ፄገታና መላ ታኒ የሩሳላመ ዶራስ፤ ቃስ ታ አሳ እስራኤለ ካለና መላ ዳዊታ ዶራስ።’<verse eid="2CH 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 6:7"/>“ታ አዋይ ዳዊቲ ጎዳ እስራኤለ ፆሳ ሱንስ ኬ ኬፃናዉ ባ ዎዛናን ቆፕስ። <verse eid="2CH 6:7"/><verse number="8" style="v" sid="2CH 6:8"/>ሽን ጎዳይ ታ አዋ ዳዊታኮ፥ ‘ኔኒ ታ ሱንስ ኬ ኬፃናዉ ነ ዎዛናን ቆፕዳ ግሾ ሎኦ ኦዳሳ። <verse eid="2CH 6:8"/><verse number="9" style="v" sid="2CH 6:9"/>ግዶሽን፥ ታዉ ኬ ኬፃናይ ነና ግዳካ፤ ታ ሱንስ ኬ ኬፃናይ ነ ጉልባታፐ ከያና ነ ናኣ።’<verse eid="2CH 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 6:10"/>“ጎዳይ ባ ግዳ ኡፋይሳ ቃላ ፖልስ። ጎዳይ ካሰ እምዳ ኡፋይሳዳ ታኒ ታ አዋ ዳዊታ በሳን ካዎታዳ እስራኤለ ካዎተ አራታን ኡታስ። ቃስ ጎዳ እስራኤለ ፆሳ ሱንስ ኬ ኬፃስ። <verse eid="2CH 6:10"/><verse number="11" style="v" sid="2CH 6:11"/>ጎዳይ እስራኤለራ ጫቅዳ ጫቆይ ፃፈትዳ ሎቸ ሹቻት ደእያ ታቦትያ እያ ግዶን ዎስ” ያግስ።<verse eid="2CH 6:11"/></para>
  <para style="s1">ሶሎሞነ ዎሳ</para>
  <para style="r">(<ref loc="1KI 8:22-53">1 ካዎ 8:22-53</ref>)</para>
  <para style="p">
    <verse number="12-13" style="v" sid="2CH 6:12-13"/>ሶሎሞነይ አዱሳተይ እቻሹ ዋ፥ ጎምፓይ እቻሹ ዋነ ቃተይ ሄ ዋ ግድዳ ማድራከ ናሰ ብራታፐ ኦድ ዳባባ ግዶን ዎስ። ሶሎሞነይ ጎዳ ያርሾ በሳ ስንን፥ እስራኤለ ማባራይ ደእያ በሳን ኤቅድ፥ ባ ኩሽያ ምጭድ እስራኤለ ሺቁዋ ስንን ጉልባትስ። <verse eid="2CH 6:12-13"/><verse number="14" style="v" sid="2CH 6:14"/>እ ሀይሳዳ ያግድ ዎስስ፦</para>
  <para style="p" vid="2CH 6:14">“አቤት ጎዳዉ፥ እስራኤለ ፆሳዉ፥ ሳሎን ዎይኮ ሳአን ነ መላ ፆሲ ባዋ። ኔኒ ነ ኡፋይሳ ቃላ ናጋሳ፤ ባንታ ኩመ ዎዛናፐ ነ ስንን ሄመትዳ ነ አይለታ መርና ሲቁዋን ዶሳዳሳ። <verse eid="2CH 6:14"/><verse number="15" style="v" sid="2CH 6:15"/>ነ አይልያ፥ ታ አዋ ዳዊታስ ኔኒ ኦና ጋዳ ኦድዳ ቃላ ናጋዳሳ። ኔኒ ካሰ ነ ዶናን ኦድዳይሳ ነ ኩሸን ሀች ፖላዳሳ። <verse eid="2CH 6:15"/><verse number="16" style="v" sid="2CH 6:16"/>አቤት ጎዳዉ፥ እስራኤለ ፆሳዉ ኔኒ ነ አይልያ፥ ታ አዋ ዳዊታስ፥ ‘ኔኒ ታ ስንን ሄመትዳይሳዳ ነ ናይትካ ታ ህግያን ሄመታናዉ ባንታ ኦግያ ናግኮ፥ እስራኤለ አራታን ኡትያ አሰ ያካ’ ያግዳ ቃላ ፖላ። <verse eid="2CH 6:16"/><verse number="17" style="v" sid="2CH 6:17"/>አቤት ጎዳዉ፥ እስራኤለ ፆሳዉ፥ ኔኒ ነ አይልያ ዳዊታስ ኦድዳ ነ ኡፋይሳ ቃላይ ፖለቶ።<verse eid="2CH 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 6:18"/>“ሽን ፆሲ ቱማ፥ አሳራ ሳአን ደእዬ? ሄኮ፥ ሳሎይ፥ ኡባፈ ቃ ሳሎይ ነና ኦይካናዉ ዳንዳኤና። ያትን፥ ሀ ታ ኬፅዳ ኬይ ነዉ አይ መላ ጉፃንደሻ! <verse eid="2CH 6:18"/><verse number="19" style="v" sid="2CH 6:19"/>ግዶሽን፥ አቤት ጎዳዉ፥ ታ ፆሳዉ፥ ታ ዎሳ፥ ነ አይልያ ዎሳነ ፄሳ ስአ። ታኒ ነ አይለይ ነ ስንን ዎስያ ዎሳነ ዋሱዋ ስአ። <verse eid="2CH 6:19"/><verse number="20" style="v" sid="2CH 6:20"/>ኔኒ፥ ‘ታ ሱንይ ሄ በሳን ፄገታና’ ግዳ ሀ ፆሳ ኬኮ፥ ነ አይፈይ ቃማ ጋላስ ፄሎ። ታኒ ነ አይለይ ሀ ኬኮ ስማዳ ዎስያ ዎሳ ስአ። <verse eid="2CH 6:20"/><verse number="21" style="v" sid="2CH 6:21"/>ታኒ ነ አይለይነ ነ አሳይ እስራኤለይ ሀ ነ ኬኮ ስሚድ ዎስያ ዎሳ ስአ። ነ ደእያ በሳን ሳሎን ስአዳ ኑስ አቶ ያጋ።<verse eid="2CH 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 6:22"/>“እስ አስ ባ ሾሩዋ ቆህድ አካይ ግን፥ እያ ጫቀናዉ ሀ ነ ኬ ኤህን፥ እያ ግዶን ደእያ ያርሾ በሳ ስንን እ ጫቅኮ፥ <verse eid="2CH 6:22"/><verse number="23" style="v" sid="2CH 6:23"/>ኔኒ ሳሎን ስአዳ ኦ። ነ አይለታ ግዶን ፕርዳ። ቆህዳ ኡራ ቦላ ፕርዳዳ፥ እ ኦዳባ እያ ቦላ ዛራ፤ ፅሉዋ ፆንሳዳ እያዉ እያ ፅሎተዳ ዛራ።<verse eid="2CH 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 6:24"/>“ነ አሳይ እስራኤለይ ነ ቦላ ናጋራ ኦድ፥ ሞርከን ፆነትድ፥ ኔኮ ስሚድ፥ ነ ሱን ፄግድ፥ ሀ ኬን ነና ዎስኮ፥ <verse eid="2CH 6:24"/><verse number="25" style="v" sid="2CH 6:25"/>ነ ሳሎን ስአ። ነ አሳ እስራኤለ ናጋራ አቶ ያጋ፤ ነ ካሰ ኤንታዉነ ኤንታ ማይዛታስ እምዳ ቢታ ኤንታ ዛራ።<verse eid="2CH 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 6:26"/>“ነ አሳይ ነ ቦላ ናጋራ ኦን፥ ሳሎይ ጎርደትኮ፥ እር ቡኮና እፅን፥ ኤንቲ ሀ በሳ ስሚድ፥ ዎስኮ ነ ኤንታ ኡንኤዳ ግሾ፥ ነ ሱን ፄግድ፥ ባንታ ናጋራፐ ስምኮ፥ <verse eid="2CH 6:26"/><verse number="27" style="v" sid="2CH 6:27"/>ነ ሳሎን ስአ። ነ አይለታ ናጋራ፥ ነ አሳ እስራኤለ ናጋራ አቶ ያጋ። ኤንቲ ሄመታናዉ በሲያ ሎኦ ኦግያ ኤንታ ታማርሳ፤ ኔኒ ነ አሳስ እምዳ ቢታን እራ ቡክሳ።<verse eid="2CH 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2CH 6:28"/>“ቢታ ቦላ ኮሽ ዎይኮ ቦሽ ዎይኮ ሌገይ ዎይኮ ቦለይ ዎይኮ ጎንዶይ ይስን ዎይኮ ሞርከይ ኤንታ ካታማታ ተቅን ዎይኮ ዮይ ዎይኮ ሀርገይ ይን፥ <verse eid="2CH 6:28"/><verse number="29" style="v" sid="2CH 6:29"/>ነ አሳ እስራኤለፐ ኦንካ ዎይኮ ነ አሳ ኡባይ ነና ዎስኮ፥ አይ አስካ ባ ዎዛናን ኡንኤትያባነ አዛንያባ ኤርድ፥ ሀ ፆሳ ኬኮ ስሚድ፥ ባ ኩሽያ ምጭኮ፥ <verse eid="2CH 6:29"/><verse number="30" style="v" sid="2CH 6:30"/>ነ ደእያ በሳን ሳሎን ስአ። ኤንታ ናጋራ አቶ ያጋ፤ ኤንታዉ ኦ። ኔኒ አሳ ዎዛና ኤረይሳዳ አሳ ኡባስ እያ ኦሱዋዳ ኦሱዋዳ እማ። አሳ ኡባ ዎዛና ኤረይ ነ ፃላላ። <verse eid="2CH 6:30"/><verse number="31" style="v" sid="2CH 6:31"/>ሄስካ ነ ኑ ማይዛታስ እምዳ ቢታን ባንታ ደኦ ላይ ኡባን ነዉ ያያና መላነ ነ ኦግያን ሄመታና መላሳ።<verse eid="2CH 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 6:32"/>“እስራኤለ ግዶና ሀራ ቢታ አስ ነ ግታ ሱን ግሾነ ኔኒ ነ አሳስ ኦዳ ማላልስያ ኦሶታ ግሾ ሃሆ ቢታፈ ይድ፥ ሀ ፆሳ ኬኮ ስሚድ ዎስኮ፥ <verse eid="2CH 6:32"/><verse number="33" style="v" sid="2CH 6:33"/>ነ ደእያ በሳን ሳሎን ስአ። ሀራ ቢታ አሳይ ኦይችያባ ኡባ ኦ። ሀ አላምያን ደእያ አሳ ኡባይ ነ ሱን ኤራናዳነ ነ አሰ ግድዳ እስራኤለዳ ነዉ ያያናዳ ታ ኬፅዳ ሀ ኬይ ነ ጎይነትያ በሲ ግደይሳ ኤንቲ ኤራናዳ ሀራ ቢታ አሳይ ነና ዎስያባ ኡባ ኦ።<verse eid="2CH 6:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2CH 6:34"/>“ኤንቲ ባንታ ሞርከታ ኦላና መላ ነ ኪትያ ዎደ ነ ዶርዳ ሀ ካታማኮነ ታ ነ ሱን ግሾ ኬፅዳ ሀ ኬኮ ስሚድ ነና ዎስኮ፥ <verse eid="2CH 6:34"/><verse number="35" style="v" sid="2CH 6:35"/>ኤንታ ዎሳነ ኤንታ ኦይሻ ሳሎን ስአ፤ ኤንታ ኦይሻ ዛራ።<verse eid="2CH 6:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="2CH 6:36"/>“ናጋራ ኦና አስ ባይና ግሾ ነ አሰ ግድዳ እስራኤለይ ናጋራ ኦድ ነና ቆህኮ ኔኒ ሸነታዳ ሞርከታስ አ እምን ሞርከት ኤንታ ድእድ ሃሆ ዎይኮ ማታ ቢታ ኤንታ ኤፍን፥ <verse eid="2CH 6:36"/><verse number="37" style="v" sid="2CH 6:37"/>ኤንቲ ሄ ድኤትዳ ቢታን ደእሸ ባንታ ዎዛናን ናጋራፐ ስምኮ፥ ‘ኑኒ ናጋራ ኦዳ፤ ኑኒ ቆህዳ፤ ኑኒ ኢታባ ሀንዳ’ ያግድ ነና ዎስኮ፥ <verse eid="2CH 6:37"/><verse number="38" style="v" sid="2CH 6:38"/>ባንታና ድእድ ኤፍዳ ሞርከታ ቢታን ደእሸ ኤንቲ ባንታ ኩመ ዎዛናንነ ኩመ ቆፋን ኔኮ ስምኮ፥ ኔኒ ኤንታ ማይዛታስ እምዳ ቢታኮ፥ ኔኒ ዶርዳ ካታማኮነ ታኒ ነ ሱን ግሾ ኬፅዳ ኬኮ ስሚድ ነና ዎስኮ፥ <verse eid="2CH 6:38"/><verse number="39" style="v" sid="2CH 6:39"/>ኤንታ ዎሳነ ኦይሻ ነ ደእያ በሳን ሳሎን ስአ፤ ኤንታዉ ፕርዳ፤ ኤንታ ናጋራ አቶ” ያጋ።<verse eid="2CH 6:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="2CH 6:40"/>“አቤት ታ ፆሳዉ፥ ሀ በሳን ዎስያ ዎሳ ነ አይፈይ ፄሎ፤ ነ ሀይይ ስኦ።<verse eid="2CH 6:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="2CH 6:41"/>“አቤት ጎዳዉ፥ ፆሳዉ፥ ደንዳ፤</para>
  <para style="q2" vid="2CH 6:41">ዎልቃማ ነ ታቦትያራ ነ ሸምፖ በሳ ገላ።</para>
  <para style="q1" vid="2CH 6:41">አቤት ጎዳዉ፥ ፆሳዉ፥ ነ ካህነት አቶተ ኤኮ፤</para>
  <para style="q2" vid="2CH 6:41">ነ ጌሻ አሳት ነ ኬሀተን ኡፋይቶ።<verse eid="2CH 6:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="2CH 6:42"/>አቤት ጎዳዉ፥ ፆሳዉ፥ ኔኒ ትይዳ ካዋ አጎፋ፤</para>
  <para style="q2" vid="2CH 6:42">ነ አይልያ ዳዊታስ</para>
  <para style="q2" vid="2CH 6:42">ነ ጫቅዳ መርና ሲቁዋ ቆፓ”<note caller="-" style="x"><char style="xo" closed="false">6:42 </char><char style="xt" closed="false"><ref loc="PSA 132:8-10">ማዝ 132:8-10</ref>.</char></note> ያግስ።<verse eid="2CH 6:42"/></para>
  <chapter eid="2CH 6"/>
  <chapter number="7" style="c" sid="2CH 7"/>
  <para style="s1">ፆሳ ኬ አንጅሱዋ</para>
  <para style="r">(<ref loc="1KI 8:62-66">1 ካዎ 8:62-66</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 7:1"/>ሶሎሞነይ ዎሳ ፖልዳ ዎደ ሳሎፐ ታም ዎድ ፁሳ ያርሹዋነ ሀራ ያርሹዋ ምስ። ጎዳ ቦንቾይ ፆሳ ኬ ኩምስ። <verse eid="2CH 7:1"/><verse number="2" style="v" sid="2CH 7:2"/>ጎዳ ቦንቾይ ፆሳ ኬ ኩምዳ ግሾ ካህነት ፆሳ ኬ ገላናዉ ዳንዳእቦኮና። <verse eid="2CH 7:2"/><verse number="3" style="v" sid="2CH 7:3"/>እስራኤለ አሳ ኡባይ ታም ሳሎፐ ዎሽንነ ጎዳ ቦንቾይ ፆሳ ኬ ኩምሽን በእዳ ዎደ ባንታ ሶምኡዋ ሳአ ጋድ ጎይንዶሶና።</para>
  <para style="q1" vid="2CH 7:3">“ጎዳይ ኬሀ!</para>
  <para style="q2" vid="2CH 7:3">እያ ሲቆይ መርናሳ”</para>
  <para style="m" vid="2CH 7:3">ያግድ ጎዳ ጋላትዶሶና።<verse eid="2CH 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 7:4"/>ካዎይነ አሳ ኡባይ ጎዳ ስንን ያርሾ ያርሽዶሶና። <verse eid="2CH 7:4"/><verse number="5" style="v" sid="2CH 7:5"/>ካዎይ ሶሎሞነይ ላታማነ ናምኡ ሙኩሉ ኮርማታነ ፄታነ ላታሙ ሙኩሉ ዶርሳታ ያርሽስ። ሄሳዳ ኦድ፥ ካዎይነ አሳ ኡባይ ፆሳ ኬ ጎዳስ ዱማይዶሶና። <verse eid="2CH 7:5"/><verse number="6" style="v" sid="2CH 7:6"/>ካህነት ባንታዉ ጊግዳ በሳን ኤቅን፥ ሌወት ካዎይ ዳዊቲ ጎዳ ሳባናዉ ካሰ ኦዳ ማዝሙረ የፅያ ሚሸታ ኦይክድ ኤንታ ስንን ኤቅድ፥ “እያ ሲቆይ መርናሳ” ያግድ የፅሸ ጎዳ ጋላትዶሶና። ካህነት ሌወታ ስንን ኤቅድ ሞይዘ ፑንን እስራኤለ አሳ ኡባይ ኤቅስ።<verse eid="2CH 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 7:7"/>ሶሎሞነይ ፆሳ ኬ ስንን ደእያ ግዶ ዳባባ ዱማይስ። ሄ በሳን ፁሳ ያርሾነ እስፈተ ያርሹዋፈ ሞዋ ያርሽስ። እ ሄሳ ኦዳይ፥ ጎዳ ስንን ደእያ ናሰ ብራታፐ ኦሰትዳ ያርሾ በሳይ፥ ፁሳ ያርሹዋ፥ ካ ያርሹዋነ እስፈተ ያርሹዋፈ ሞዋ ያርሻናዉ ጉፅዳ ግሾሳ።<verse eid="2CH 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 7:8"/>ሄ ዎደ ሶሎሞነይነ እስራኤለ አሳ ኡባይ ላፑን ጋላስ ባኣለ ቦንችዶሶና። እስራኤለ አሳይ ሀማታፐ ብድ ግብፀ ሻፋ ጋካናዉ ደእያ ዳሮ አሳይ ሄ በሳን ሺቅዶሶና። <verse eid="2CH 7:8"/><verse number="9" style="v" sid="2CH 7:9"/>አሳይ ያርሾ በሳ አንጅስያ ባኣለ ላፑን ጋላስ ቃስ ሻቃራ ባኣለ ሀራ ላፑን ጋላስ ቦንችዶሶና። ሆስፑን ጋላስ ዉርሰ ሺቆ ሺቅዶሶና። <verse eid="2CH 7:9"/><verse number="10" style="v" sid="2CH 7:10"/>ሶሎሞነይ ላፑን አጌናን፥ ላታማነ ሄን ጋላሳን አሳ ሞይዝስ። አሳይ፥ ጎዳይ ዳዊታስ፥ ሶሎሞነስነ ባ አሳ እስራኤለስ ኦዳ ኬሀተን ኡፋይትሸ ባ ሶ ሶ ብዶሶና።<verse eid="2CH 7:10"/></para>
  <para style="s1">ፆሳይ ሶሎሞነስ ቆንጭስ</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 7:11"/>ሶሎሞነይ ፆሳ ኬነ ካዎ ጋ ኬፅድ ዉርስስ። ሶሎሞነይ ፆሳ ኬንነ ባ ጋን ኦናዉ ባ ዎዛናን ቆፕዳባ ኡባ ፖልስ። <verse eid="2CH 7:11"/><verse number="12" style="v" sid="2CH 7:12"/>ጎዳይ ሶሎሞነስ ቃማ ቆንጭድ፥ “ታኒ ነ ዎሳ ስአስ፤ ታኒ ሀ ፆሳ ኬ ያርሾ በሲ ግዳና መላ ዶራስ። <verse eid="2CH 7:12"/><verse number="13" style="v" sid="2CH 7:13"/>እር ቡኮና መላ ታ ሳሉዋ ጎርድያ ዎደ ዎይኮ ካ ማና መላ ቦለ ኪትያ ዎደ ዎይኮ ታ አሳ ቦላ ጋዶ የድያ ዎደ <verse eid="2CH 7:13"/><verse number="14" style="v" sid="2CH 7:14"/>ታ ሱንን ፄገትዳ ታ አሳይ ባንታ አሳተ ካዉሽድ ዎስኮ፥ ታና ኮይኮ፥ ባንታ ኢታ ኦግያፐ ስምኮ፥ ታ ሳሎን ኤንታ ዎሳ ስአና፤ ኤንታ ናጋራ አቶ ጋና፤ ኤንታ ቢታ ፓና። <verse eid="2CH 7:14"/><verse number="15" style="v" sid="2CH 7:15"/>ሀእ ሀ በሳን ዎሰትያ ዎሳ ታ አይፈይ ፄላና፤ ታ ሀይይ ስአና። <verse eid="2CH 7:15"/><verse number="16" style="v" sid="2CH 7:16"/>ሀእ ታ ሱንይ መርናዉ እያን ዳና መላ ሀ ኬ ዶራስነ ጌሻስ። ታ አይፈይነ ታ ዎዛናይ ኡባ ዎደ ሀ ኬን ዳና።<verse eid="2CH 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 7:17"/>“ነ አዋይ ዳዊቲ ኦዳይሳዳ ኔኒ ታ ስንን ሄመትኮ፥ ታ ኪታ ኡባ ኦኮ፥ ታ ዎጋነ ታ ህግያ ናግኮ፥ <verse eid="2CH 7:17"/><verse number="18" style="v" sid="2CH 7:18"/>ታኒ ነ አዋ ዳዊታራ፥ ‘ነ ኮቻፈ እስራኤለ ቦላ ካዎ ግድያ አስ ያካ’ ያጋዳ ጫቅዳይሳዳ ነ አራታ ምንዳ ኤሳና።<verse eid="2CH 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 7:19"/>“ሽን ህንተ ታና አግድ ታ ህንተዉ እምዳ ዎጋነ ህግያ አግኮ፥ ሀራ ፆሳታ ጎይንኮነ ኤንታዉ ኦኮ፥ <verse eid="2CH 7:19"/><verse number="20" style="v" sid="2CH 7:20"/>ታኒ ካሰ ህንተዉ እምዳ ቢታፈ ህንተና ቆላና፤ ታ ሱንስ ዱማይዳ ሀ ኬካ አጋጋና። ታ ሀ ኬ ካዎተ ኡባ ግዶን ሚቻስነ ቀልቅሰስ ኦና። <verse eid="2CH 7:20"/><verse number="21" style="v" sid="2CH 7:21"/>ሀ ፆሳ ኬይ ዳሮ ማላልስያባ ግድኮካ፥ እያ ማታራ አያ ኡባይ ማላለትድ፥ ‘ጎዳይ ሀ ቢታነ ሀ ፆሳ ኬ አይስ ሀይሳዳ ኦዴ?’ ” ያጋና። <verse eid="2CH 7:21"/><verse number="22" style="v" sid="2CH 7:22"/>አሳይ ዛሪድ፥ “ሀይሳ ኡባ ኤንታ ቦላ ኤህዳይ፥ ኤንታና ግብፀፈ ከስዳ ኤንታ ማይዛታ ፆሳ አግድ ሀራ ፆሳታ ካልዳ ግሾነ ኤንታ ጎይንዳ ግሾሳ” ያጋና።<verse eid="2CH 7:22"/></para>
  <chapter eid="2CH 7"/>
  <chapter number="8" style="c" sid="2CH 8"/>
  <para style="s1">ሶሎሞነይ ኦዳ ሀራ ኦሶታ</para>
  <para style="r">(<ref loc="1KI 9:10-28">1 ካዎ 9:10-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 8:1"/>ሶሎሞነይ ፆሳ ኬነ ባዉ ጋ ኬፅዳ ላታማን ላይ ዉርሰን፥ <verse eid="2CH 8:1"/><verse number="2" style="v" sid="2CH 8:2"/>ካዎይ ክራም እምዳ ካታማታ ሶሎሞነይ ዛር ኬፅድ እስራኤለ አሳ ሄ ካታማታን ዎስ።<verse eid="2CH 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 8:3"/>ሶሎሞነይ ሀማታነ ሱባ ጌተትያ ቢታ ብድ ኦይክስ። <verse eid="2CH 8:3"/><verse number="4" style="v" sid="2CH 8:4"/>ያትድ መላ ቢታን ደእያ ታድሞራ ካታማነ ሻሎ ምንጅያ ካታማታ ሀማታ ቢታን ኬፅስ። <verse eid="2CH 8:4"/><verse number="5" style="v" sid="2CH 8:5"/>ሄሳዳካ፥ ሶሎሞነይ ቆሞ ቤት-ሆሮናነ ጋርሳ ቤት-ሆሮና ጌተትያ ካታማታ ዛሪድ ኬፅስ። ሄ ካታማት ድርስ፥ ፐንገይነ ኮበይ ደእያ ድረትድ ኡትዳ ካታማታ። <verse eid="2CH 8:5"/><verse number="6" style="v" sid="2CH 8:6"/>ባላታ ካታማ፥ ቡቁራ ምንጅያ ካታማታ ኡባ፥ ባ ፓራታነ ፓራ ጋረታ ዎያ ካታማታ ኡባነ እ ኬፃናዉ አሞትዳ ኡባ የሩሳላመን፥ ልባኖሰንነ ባ ሃርያ ቢታ ኡባን ኬፅስ።<verse eid="2CH 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 8:7"/>እስራኤለ ግዶናሽን ሀራ ቢታ አሳታፐ አትዳ ህተታ፥ አሞረታ፥ ፓርዘታ፥ ህወታነ ያቡሰታ፥ <verse eid="2CH 8:7"/><verse number="8" style="v" sid="2CH 8:8"/>እስራኤለ አሳይ ዉርስድ ይሶና አግዳ አሳ ዎልቃ ኦሶ ኦና መላ ሶሎሞነይ ዶርስ፤ ሀች ጋካናዉ ኤንቲ ኦሶና። <verse eid="2CH 8:8"/><verse number="9" style="v" sid="2CH 8:9"/>ሽን ሶሎሞነይ እስራኤለ አሳፐ ኦናካ አይለ ኦድ ኦስስቤና። ኤንቲ እያ ኦላንቾታ፥ ቶራ ሞጮናታ፥ ፓራ ጋረ ላገይሳታ ሀላቃታነ ፓራ አሳታ ግድድ ኦዶሶና። <verse eid="2CH 8:9"/><verse number="10" style="v" sid="2CH 8:10"/>ኤንታ ግዶፈ ናምኡ ፄታነ እሻታሙ አሳት ካዋ ሶሎሞነ ኦሱዋ አዋተን ኦስሶሶና።<verse eid="2CH 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 8:11"/>ሶሎሞነይ፥ “ጎዳ ታቦተይ ገልዳ በሳይ ጌሽ ግድያ ግሾ፥ ታ ማችያ፥ ፋሮና ናእያ፥ እስራኤለ ካዋ ዳዊታ ጋን ዳናዉ በሱኩ” ያግድ፥ ግብፀ ካዋ ናእዉ ዳዊታ ካታማፐ ደንድ እዉ ኬፀትዳ ኬን ዎስ።<verse eid="2CH 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 8:12"/>ሶሎሞነይ ሄ ዎደ ፆሳ ኬ ስንን ጎዳስ ኬፅዳ ያርሾ በሳን ፁሳ ያርሾ ጎዳስ ያርሽስ። <verse eid="2CH 8:12"/><verse number="13" style="v" sid="2CH 8:13"/>ሙሰ ህገይ ኪተይሳዳ ጋላስ ጋላስ ፁሳ ያርሾ ያርሼስ። ሶሎሞነይ ሳምባታ ጋላሳን፥ አጌና ፄሮንነ ላይን ሄ ቶሆ ቦንቸትያ ባለታን፥ ሄስካ ኡይ ባለን፥ ሳምንታ ባለንነ ሻቃራ ባለን ጎዳስ ያርሾ ያርሼስ።<verse eid="2CH 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 8:14"/>እያ አዋይ ዳዊቲ ካሰ ኪትዳይሳዳ ካህነታ ኤንታ ኦሶን ኦሶን ሻክድ ሹምስ፤ ጋላስ ጋላስ ማዝሙረን ሳባና መላነ ካህነታ ማዳና መላ ሌወታ ሻክድ ሹምስ። ፆሳ አስ ግድዳ ዳዊቲ ኪትዳይሳዳ ፐንገ ናግያ አሳታ እስ እስ ፐንግያ ናጋና መላ ሹምስ። <verse eid="2CH 8:14"/><verse number="15" style="v" sid="2CH 8:15"/>ሄሳዳካ፥ ካሰ ዳዊቲ ቡቁራ ምንጅያ በሳነ ሀራ አላለታባ ካህነታነ ሌወታ ኪትዳይሳዳ እሶይካ አቶና ኡባይ ፖለትስ።<verse eid="2CH 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 8:16"/>ሶሎሞነይ ቆፕዳ ኦሶ ኡባይ ኦሰትድ ዉርስ፤ ፆሳ ኬይ ባሰትዳ ዎድያፐ ዶምድ ፖለታና ጋካናዉ ኦሶ ኡባይ ሎኦ ኦሰትስ።<verse eid="2CH 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 8:17"/>ሄ ዎደ ካዎይ ሶሎሞነይ ኤዶመ ቢታን ዞኦ አባ ዶናን ደእያ ኤፅዮን-ጋብራነ ኤሎታ ብስ። <verse eid="2CH 8:17"/><verse number="18" style="v" sid="2CH 8:18"/>ካዎይ ክራም ማርካበታነ ማርካብያ ላጎን ሎህዳ አሳታ ሶሎሞነስ የድስ። ኤንቲ ሶሎሞነ አሳታራ እስፈ ኦፍራ ቢታ ብድ ያፐ 15,000 ክሎ ግራመ ዎርቃ ካዋ ሶሎሞነስ ኤህዶሶና።<verse eid="2CH 8:18"/></para>
  <chapter eid="2CH 8"/>
  <chapter number="9" style="c" sid="2CH 9"/>
  <para style="s1">ሳባ ካውዉ</para>
  <para style="r">(<ref loc="1KI 10:1-13">1 ካዎ 10:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 9:1"/>ሳባ ካውያ ሶሎሞነ ዎርያ ስአዳ፥ ሰመንከን እያ ፓጫናዉ ሳዎ፥ ዳሮ ዎርቃነ አልኦ ሹቹ ጫነትዳ ዳሮ ግማለራ፥ ዳሮ አዣባን የሩሳላመ ባሱ። ባ ዎዛናን ደእያባ ኡባ ሶሎሞነስ ኦዳሱ። <verse eid="2CH 9:1"/><verse number="2" style="v" sid="2CH 9:2"/>ሶሎሞነይ እያ ኦይችዳባ ኡባስ ዛሮ እሚስ፤ እ እዉ ብርሾና እያፐ ጌምድ አትዳባይ አይብካ ባዋ። <verse eid="2CH 9:2"/><verse number="3" style="v" sid="2CH 9:3"/>ሳባ ካውያ ሶሎሞነ ጭንጫተ፥ እ ኬፅዳ ጋዋ፥ <verse eid="2CH 9:3"/><verse number="4" style="v" sid="2CH 9:4"/>እያ ጋይታን ሺቅያ ካ፥ እያ ሞርናት ኡትያ ኡተ፥ እያ ኦሳንቾት ኦያ ኦሱዋነ ማእያ ማኡዋ፥ እያ ኡሻ ትግያ አሳት ማእያ ማኡዋነ ጎዳ ኬን እ ያርሽያ ፁሳ ያርሹዋ በእዳ ዎደ እ ዎዛናይ ዳሮ ማላለትስ።<verse eid="2CH 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 9:5"/>እያ ካዋኮ፥ “ነባነ ነ ጭንጫተ ታኒ ታ ቢታን ደአሸ ስእዳይስ ቱማ። <verse eid="2CH 9:5"/><verse number="6" style="v" sid="2CH 9:6"/>ሽን ታ ያዳ ታ አይፈን በአና ጋካናዉ ኤንቲ ታዉ ኦድዳባ አማናብከ። ነ ጭንጫተ ግታተስ ባጋካ ታዉ ኦድቦኮና፤ ታ ስእዳይሳፈ ነ ዳሮ ግታታሳ። <verse eid="2CH 9:6"/><verse number="7" style="v" sid="2CH 9:7"/>ኡባ ዎደ ነ ስንን ኤቅድ ነ ጭንጫተ ስእያ ነ አሳትነ ነ ሞርናት አይ መላ አንጀትዶና! <verse eid="2CH 9:7"/><verse number="8" style="v" sid="2CH 9:8"/>ነናን ኡፋይትድ፥ ነና ባ ካዎተ አራታን ኡትስዳ ጎዳይ ነ ፆሳይ ጋላተቶ! ነ ፆሳይ እስራኤለ ሲቅዳ ግሾነ መርናዉ ምን ኤሳናዉ ኮይዳ ግሾ ኔኒ ሱረ ፕርዳነ ፅሎተ ኦና መላ እ ነና ኤንታ ቦላ ካዎ ኦስ” ያጋሱ።<verse eid="2CH 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 9:9"/>ካውያ ኦይዱ ሙኩሉ ክሎ ግራመ ዎርቃ፥ ዳሮ ሳዎነ አልኦ ሹቹ ካዋ ሶሎሞነስ እማሱ፤ ሳባ ካውያ ካዋ ሶሎሞነስ እምዳ ሽቱዋ መላ ሽቶይ ባዋ።<verse eid="2CH 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 9:10"/>ቃስ ኦፍራፐ ዎርቃ ኤህዳ ክራማነ ሶሎሞነ አሳት ያፐ ሰንዳለ ምነ አልኦ ሹቹ ኤህዶሶና። <verse eid="2CH 9:10"/><verse number="11" style="v" sid="2CH 9:11"/>ካዎይ ሳንዳለ ም ፆሳ ኬስነ ካዎ ጋስ ደ መናዉ፥ ሄሳዳካ ዛማረታስ ማስንቆነ ዲ ኦናዉ ጎኤትስ። ሄሳ መላ የ ሚሸት ሃይሳፈ ካሴ ይሁዳ ቢታን በንትቤና።<verse eid="2CH 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 9:12"/>ካዎይ ሶሎሞነይ ሳባ ካውያ ኮይዳባነ ኦይችዳባ ኡባ እዉ እሚስ። እያ፥ እያዉ ኤህዳይሳፈ አድ እዉ እሚስ። ሄሳፈ ጉየ፥ ሳባ ካውያ ባ አዣባራ ደንዳዳ ባ ቢታ ስማሱ።<verse eid="2CH 9:12"/></para>
  <para style="s1">ሶሎሞነ አቁዋ</para>
  <para style="r">(<ref loc="1KI 10:14-25">1 ካዎ 10:14-25</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 9:13"/>ሶሎሞነይ ላይን ላይን ኤክያ ዎርቃይ ላታማነ ሄ ሙኩሉ ክሎ ግራመ። <verse eid="2CH 9:13"/><verse number="14" style="v" sid="2CH 9:14"/>ሄስካ ዛልአንቾታፐ ኤክያ ቃራፃ፥ አራበ ቢታ ካዎታፐነ እስራኤለ ቢታን ሃረይሳታፐ ኤክያ ዎርቃነ ብራ ጉጆናሽና። <verse eid="2CH 9:14"/><verse number="15" style="v" sid="2CH 9:15"/>ካዎይ ሶሎሞነይ እስ እስ ጎንዳለይ ላፑን ክሎ ግራመ ግድያ ናምኡ ፄቱ ዎጋ ጎንዳለታ ዎርቃፈ ኦስስስ። <verse eid="2CH 9:15"/><verse number="16" style="v" sid="2CH 9:16"/>እሶይ እሶይ ሄ ክሎ ግራመ ግድያ ሄ ፄቱ ጉ ጎንዳለታ ዎርቃፈ ኦስስስ። ካዎይ ሄ ጎንዳለታ “ልባኖሰ ዎራ” ጌተትያ ካዎ ጋን ዎስ።<verse eid="2CH 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 9:17"/>ካዎይ ዳንጋርሳ ዛለፐ እስ ግታ አራታ ኦስስድ ዋላህ ባይና ዎርቃን ላንፅስ። <verse eid="2CH 9:17"/><verse number="18" style="v" sid="2CH 9:18"/>አራታይ ደእያ በሳ ከያናዉ የያ ኡሱፑን ደት ደኦሶና። አራታራ ኦይከትድ ኡትዳ ዎርቃፈ ኦሰትዳ ቶሆ የያ በሲ ደኤስ። አራታስ ናምኡ ባጋራ ኩሸ ሸምፕስያ ዘምፖት ደኦሶና፤ ሄ ዘምፖታ ማታራ ያ ባጋንነ ሀ ባጋን ኤቅዳ እስ እስ ጋሞ ምስለይ ደኤስ። <verse eid="2CH 9:18"/><verse number="19" style="v" sid="2CH 9:19"/>ሄ አራታይ ደእያ በሳ ከይያ ኡሱፑን ደታ ቦላ ያ ባጋራነ ሀ ባጋራ ኤቅዳ ታማነ ናምኡ ጋሞ ምስለት ደኦሶና። ሄሳ መላ አራት ሀራ ካዎተን አዉንካ ኦሰትቤና።<verse eid="2CH 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 9:20"/>ካዎይ ሶሎሞነይ ኡሹ ኡያ ሚሸ ኡባይ ዎርቃፈ ኦሰትስ፤ “ልባኖሰ ዎራ” ጌተትያ ካዎ ጋን ደእያ ሚሸ ኡባይ ዋላህ ባይና ዎርቃፈ ኦሰትስ። ሶሎሞነ ዎደ ብር ዳርዳ ግሾ ታይቦን ገለና። <verse eid="2CH 9:20"/><verse number="21" style="v" sid="2CH 9:21"/>ካዋስ ክራማ አሳት ላግያ ዛልኤ ማርካበታ ደኦሶና። ሄ ማርካበት ዎርቃነ ብራ፥ ዳንጋርሳ ዛለ፥ ቃረታነ ገለሾታ ጫንድ ሄ ላይፈ እስ ቶሆ ኤሆሶና።<verse eid="2CH 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 9:22"/>ካዎይ ሶሎሞነይ ዱረተንነ ጭንጫተን ሳአን ደእያ ካዎታ ኡባፈ አስ። <verse eid="2CH 9:22"/><verse number="23" style="v" sid="2CH 9:23"/>ሳአን ደእያ ካዎት ኡባይ ፆሳይ እያ ዎዛናን ዎዳ ጭንጫተ ስአናዉ ኮዮሶና። <verse eid="2CH 9:23"/><verse number="24" style="v" sid="2CH 9:24"/>ላይን ላይን እያኮ ያ ኡባይ እያዉ ዎርቃነ ብራ፥ ማኦታ፥ ኦላ ሚሸ፥ ሽቶ፥ ፓራነ ባቁሎታ እሞታ ኤሆሶና።<verse eid="2CH 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 9:25"/>ሶሎሞነ ፓራታስነ ጋረታስ ኦይዱ ሙኩሉ ዛዳሎት ደኤስ፤ ታማነ ናምኡ ሙኩሉ ፓራ አሳት ደኦሶና። ሶሎሞነይ ሄሳታ ዱማ ዱማ ካታማታንነ የሩሳላመን ዎስ። <verse eid="2CH 9:25"/><verse number="26" style="v" sid="2CH 9:26"/>ሶሎሞነይ ኤፍራፂሳ ሻፋፐ ዶምድ፥ ፍልስፄመ ቢታነ ግብፀ ዛዋ ጋካናዉ ደእያ ካዎታ ኡባ ሃርስ። <verse eid="2CH 9:26"/><verse number="27" style="v" sid="2CH 9:27"/>ካዎይ የሩሳላመን ብር ሹቻዳ ኬለታናዳ ዝጋ ም ይሁዳ ዙማታ ፃጶን ድጭያ ቦባዳ ዳራና መላ ኦስ። <verse eid="2CH 9:27"/><verse number="28" style="v" sid="2CH 9:28"/>ሶሎሞነይ ፓራታ ግብፀፈነ ሀራ ቢታ ኡባፈ ኤህሴስ።<verse eid="2CH 9:28"/></para>
  <para style="s1">ሶሎሞነ ሀይቁዋ</para>
  <para style="r">(<ref loc="1KI 11:41-43">1 ካዎ 11:41-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 9:29"/>ኮይሮፐ ዉርሰ ጋካናዉ ሶሎሞነ ታርከይ ናብያ ናታና ታርከ ማፃፋን፥ ሴሎ አድያ ናብያ አክያ ማፃፋንነ ናባፃ ናኣ እዮርባማ ዎደ ጋካናዉ ደእያ ናብያ እዶ ቆንጨ ማፃፋን ፃፈትስ ግደኔ? <verse eid="2CH 9:29"/><verse number="30" style="v" sid="2CH 9:30"/>ሶሎሞነይ እስራኤለ ቦላ የሩሳላመን ኦይታሙ ላይ ካዎትስ። <verse eid="2CH 9:30"/><verse number="31" style="v" sid="2CH 9:31"/>ሄሳፈ ጉየ፥ ሶሎሞነይ ሀይቅድ ባ ማይዛታን ጋሄትስ፤ ባ አዋ ዳዊታ ካታማን ሞገትስ። እያ ናአይ ሮብኣም እያ በሳን ካዎትስ።<verse eid="2CH 9:31"/></para>
  <chapter eid="2CH 9"/>
  <chapter number="10" style="c" sid="2CH 10"/>
  <para style="s1">እስራኤለት ኦሮብኣማ ቦላ ማካልዶሶና</para>
  <para style="r">(<ref loc="1KI 12:1-20">1 ካዎ 12:1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 10:1"/>እስራኤለ አሳ ኡባይ ኦሮብኣማ ካዎያናዉ ሴከማ ብዳ ግሾ እካ ያ ብስ። <verse eid="2CH 10:1"/><verse number="2" style="v" sid="2CH 10:2"/>ናባፃ ናአይ እዮርባም ካዋ ሶሎሞነፐ ባቃትድ ግብፀን ደኤይስ፥ ሄሳ ስእዳ ዎደ ግብፀፈ ይስ። <verse eid="2CH 10:2"/><verse number="3" style="v" sid="2CH 10:3"/>እስራኤለ አሳ ኡባይ እዮርባማስ ኪትድ ፄግስን፥ እነ ሺቅዳ እስራኤለ አሳ ኡባይ ሮብኣማኮ ብድ፥ <verse eid="2CH 10:3"/><verse number="4" style="v" sid="2CH 10:4"/>“ነ አዋይ ኑና ዴፆ ቃምባራ ቶስስ፤ ሽን ሀእ እ ኑና ኦስስያ ዎልቃማ ኦሱዋነ ዴፆ ቃምባራ ኑስ ካዉሽሳ፤ ያትኮ፥ ኑ ነዉ ሃረታና” ያግዶሶና።<verse eid="2CH 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 10:5"/>ሮብኣም፥ “ሄን ጋላስ ስሚድ፥ ታኮ ዪተ” ያግስ። አሳይ ስሚድ ብዶሶና።<verse eid="2CH 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 10:6"/>ሄሳፈ ጉየ፥ ካዎይ ሮብኣም እያ አዋይ ሶሎሞነይ ፓፃ ደእያ ዎደ ሶሎሞነ ዞርዳ ጭማታ፥ “ሀ አሳስ ዎይጋዳ ዛራ ጌቲ?” ያግድ ኤንታና ዞረ ኦይችስ።<verse eid="2CH 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 10:7"/>ጭማት ሮብኣማኮ፥ “ነ ሀ አሳስ ኬህኮ፥ ኤንታ ኡፋይስኮነ ኤንታዉ ሎኦ ቃላ ዛርኮ ኤንቲ ኡባ ዎደ ነዉ ሃረታና” ያግዶሶና።<verse eid="2CH 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 10:8"/>ሽን ሮብኣም ጭማት ዞርዳ ዞርያ አግድ እያራ ድጭድ፥ እያራ ኦያ ያላጋታ ዞረ ኦይችስ። <verse eid="2CH 10:8"/><verse number="9" style="v" sid="2CH 10:9"/>እ ኤንታኮ፥ “ህንተ ታና ዞርያባይ አይቤ? ‘ነ አዋይ ኑና ቶስዳ ዴፆ ቃምባራ ኑስ ካዉሽሳ’ ግያ ሀ አሳስ ዎይጋዳ ዛሮ?” ያግድ ኦይችስ።<verse eid="2CH 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 10:10"/>እያ ላገት ዛሪድ፥ “ ‘ነ አዋይ ኑና ዴፆ ቃምባራ ቶስስ፤ ሽን ነ ኑስ ካዉሻርክ’ ግያ አሳስ፥ ‘ታ ግልአ ብራይ ታ አዋ ፄሳፈ ኦርደ። <verse eid="2CH 10:10"/><verse number="11" style="v" sid="2CH 10:11"/>ታ አዋይ ህንተና ዴፆ ቃምባራ ቶስስ፤ ሽን ታ እያፐ አዳ ዴፀና። ታ አዋይ ህንተና ልሶን ዋስ፤ ሽን ታ ህንተና ኮርነዳ ዱክያ ልሶን ዋና’ ያጋዳ ዛራ” ያግዶሶና።<verse eid="2CH 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 10:12"/>ካዎይ፥ “ሄ ጋላሳፐ ጉየ ስሚድ ታኮ ዪተ” ግዳይሳዳ እዮርባምነ አሳይ ስሚድ ይዶሶና። <verse eid="2CH 10:12"/><verse number="13" style="v" sid="2CH 10:13"/>ካዎይ ሮብኣም ጭማት ዞርዳ ዞርያ አግድ ኤንታዉ ኢታ ዛሮ ዛርስ። <verse eid="2CH 10:13"/><verse number="14" style="v" sid="2CH 10:14"/>እያ ላገት ዞርዳ ዞርያ ካልድ፥ “ታ አዋይ ህንተና ቃምባራ ቶስስ፤ ሽን ታኒ እያፐ አዳ ዴፀና። ታ አዋይ ህንተና ልሶን ዋስ፤ ሽን ታኒ ህንተና ኮርነዳ ዱክያ ልሶን ዋና” ያግድ ዛርስ። <verse eid="2CH 10:14"/><verse number="15" style="v" sid="2CH 10:15"/>ጎዳይ ሴሎ አድያ ናብያ አክያ ባጋራ ናባፃ ናኣ እዮርባማስ ኦድዳ ቃላይ ፖለታና መላ ፆሳፈ ሀንዳ ግሾ ካዎይ አሳይ ገይሳ ስኦና እፅስ።<verse eid="2CH 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 10:16"/>እስራኤለ አሳ ኡባይ ካዎይ ኤንቲ ገይሳ ስኦና እፅዳይሳ በእድ ካዋኮ፥ “ዳዊታፐ ኑና ጋክያባይ አይቤ? እሰየ ናኣፐ ኑኒ ላታናባይ ባዋ! እስራኤለ አሳዉ፥ ህንተ ሶ ሶ ቢተ! ዳዊታ፥ ኔኒ ነ ኬ ናጋ!” ያግዶሶና። ሄሳ ግሾ፥ እስራኤለ አሳይ ባንታ ሶ ሶ ብዶሶና። <verse eid="2CH 10:16"/><verse number="17" style="v" sid="2CH 10:17"/>ሽን ሮብኣም ይሁዳ ቢታን ደእያ እስራኤለ አሳ ቦላ ካዎትስ።<verse eid="2CH 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 10:18"/>ካዎይ ሮብኣም ባ ኦሳንቾታ ሀላቃ አዶራማ እስራኤለ አሳኮ ኪትስ፤ ኤንቲ እያ ሹቻን ጫድድ ዎዶሶና። ሄ ዎደ ካዎይ ሮብኣም ባ ፓራ ጋረን ኡትድ የሩሳላመ ባቃትስ። <verse eid="2CH 10:18"/><verse number="19" style="v" sid="2CH 10:19"/>ሄ ዎደፐ ዶምድ ሀች ጋካናዉ ታሙ እስራኤለ ዛረት ዳዊታ ኮቻፈ ካዎትዳ ካዎታ ቦላ ማካልዶሶና።<verse eid="2CH 10:19"/></para>
  <chapter eid="2CH 10"/>
  <chapter number="11" style="c" sid="2CH 11"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 11:1"/>ሮብኣም የሩሳላመ ካታማ ጋክዳ ዎደ እስራኤለ ቢታ አሳራ ኦለትድ ካዎተ ባዉ ዛራና መላ ይሁዳፐነ ብንያመ ኮቻፈ ዶረትዳ 180,000 ኦላንቾታ ሺሽስ። <verse eid="2CH 11:1"/><verse number="2" style="v" sid="2CH 11:2"/>ሽን ጎዳ ቃላይ ፆሳ አስ ግድዳ ሻማያኮ ይስ። <verse eid="2CH 11:2"/><verse number="3" style="v" sid="2CH 11:3"/>“ሶሎሞነ ናኣ፥ ይሁዳ ካዋ ሮብኣማ፥ ይሁዳንነ ብንያመን ደእያ እስራኤለ አሳ ኡባ ሀይሳዳ ያጋ፤ <verse eid="2CH 11:3"/><verse number="4" style="v" sid="2CH 11:4"/>‘ህንተ እሻ ግድዳ እስራኤለታራ ኦለታናዉ ቦፕተ። ሄሳ ታኒ ኦዳ ግሾ ህንተ ኡባይ ህንተ ሶ ሶ ስምተ’ ያጌስ” ያጋ። ኤንቲ ጎዳ ቃላ ስእድ እዮርባማ ኦላናዉ በይሳ አግድ ስምዶሶና።<verse eid="2CH 11:4"/></para>
  <para style="s1">ሮብኣማ ሚፃታ</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 11:5"/>ሮብኣም የሩሳላመን ኡትድ ሀይሳፈ ካልድ ፃፈትዳ ይሁዳነ ብንያመ ካታማታን ሚፃታ ኬፅስ። <verse eid="2CH 11:5"/><verse number="6" style="v" sid="2CH 11:6"/>ሄ ካታማት ቤተለመ፥ ኤፃማ፥ ተቁሄ፥ <verse eid="2CH 11:6"/><verse number="7" style="v" sid="2CH 11:7"/>ቤት-ፁራ፥ ሶኮ፥ አዱላማ፥ <verse eid="2CH 11:7"/><verse number="8" style="v" sid="2CH 11:8"/>ጌተ፥ ማሬሳ፥ ዚፋ፥ <verse eid="2CH 11:8"/><verse number="9" style="v" sid="2CH 11:9"/>አዶራይማ፥ ላክሶ፥ አዜቃ፥ <verse eid="2CH 11:9"/><verse number="10" style="v" sid="2CH 11:10"/>ፆርአ፥ ኤሎናነ ከብሮና። <verse eid="2CH 11:10"/><verse number="11" style="v" sid="2CH 11:11"/>ሮብኣም ካታማታ ምንድ ኤንታዉ ሀላቃታ ሹምስ፤ ካ፥ ዛይተነ ዎይነ ኡሻ ያን ዎስ። <verse eid="2CH 11:11"/><verse number="12" style="v" sid="2CH 11:12"/>ሄ ኬፀትዳ ካታማታ ኡባን ጎንዳለነ ቶራ ዎስ፤ ያትድ ኤንታ ዳሮ ምንስ። ሄሳዳ ኦድ ይሁዳነ ብንያመ ሃርስ።<verse eid="2CH 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 11:13"/>እስራኤለ ኡባን ደእያ ካህነትነ ሌወት ኡባይ ባንታ ደእያ በሳፈ ሮብኣማኮ ይዶሶና። <verse eid="2CH 11:13"/><verse number="14" style="v" sid="2CH 11:14"/>ሌወት ባንታ ሄን ቢታነ ባንታ ሻሉዋ አግድ ይሁዳነ የሩሳላመ ይዶሶና። ኤንቲ ካህነ ግድድ ጎዳስ ኦና መላ እዮርባምነ እያ ናይት ድግዶሶና። <verse eid="2CH 11:14"/><verse number="15" style="v" sid="2CH 11:15"/>እዮርባም ቃ ጎይኖ በሳንነ እ ኤስዳ ዴሸነ ማራ ምስለታስ ኦያ ሀራ ካህነታ ሹምስ። <verse eid="2CH 11:15"/><verse number="16" style="v" sid="2CH 11:16"/>እስራኤለ ፆሳ ባንታ ዎዛናፐ ጎይናናዉ ኮይዳይሳት ጎዳስ ባንታ አዋታ ፆሳስ ያርሾ ያርሻናዉ ኩመ እስራኤለፐ ሌወታ ካልድ የሩሳላመ ይዶሶና። <verse eid="2CH 11:16"/><verse number="17" style="v" sid="2CH 11:17"/>ኤንታ ዩሳይ ይሁዳ ካዎተ ምንስ፤ ኤንቲ ሄ ላይ ኩመ ሶሎሞነ ናኣ ሮብኣማ ማድዶሶና። ኤንቲ ካዋ ዳዊታ ኦግያነ ካዋ ሶሎሞነ ኦግያ ካልድ፥ ሄ ላይ ሳሮ ደእዶሶና።<verse eid="2CH 11:17"/></para>
  <para style="s1">ሮብኣማ ሶ አሳ</para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 11:18"/>ሮብኣም ማህላቶ ጌተትያ ማቾ ኤክስ። ማህላት አዋይ ዳዊታ ናኣ ያርሞታ፤ እ አይያ እሰየ ናኣ ኤልያባ ናእዉ አብካሎ። <verse eid="2CH 11:18"/><verse number="19" style="v" sid="2CH 11:19"/>ማህላታ ኦሮብኣመስ የኡሳ፥ ሳማረነ ዛሃማ ጌተትያ አደ ናይታ የላሱ። <verse eid="2CH 11:19"/><verse number="20" style="v" sid="2CH 11:20"/>ሄሳፈ ጉየ፥ አበሰሎመ ናእዉ ማእኮ ኤክስ፤ ማእካ አብያ፥ አታያ፥ ዚዛነ ሳሎምታ ጌተትያ አደ ናይታ የላሱ። <verse eid="2CH 11:20"/><verse number="21" style="v" sid="2CH 11:21"/>ሮብኣም ባ ማቸታፐ ባ ላገታፐ አድ አበሰሎመ ናእዉ ማእኮ ዶስስ። እያዉ ታማነ ሆስፑን ማቸትነ ኡሱፑን ታሙ ላገት ደኦሶና። እ ላታማነ ሆስፑን አደ ናይታነ ኡሱፑን ታሙ ማጫ ናይታ የልስ። <verse eid="2CH 11:21"/><verse number="22" style="v" sid="2CH 11:22"/>ሮብኣም ማእክ ናኣ አብያ ባ በሳን ካዎያናዉ ቆፕዳ ግሾ እያ እሻታ ቦላ እያ ሀላቃ ኦድ ሹምስ። <verse eid="2CH 11:22"/><verse number="23" style="v" sid="2CH 11:23"/>ሮብኣም ጭንጭድ ባ አደ ናይታ ይሁዳን፥ ብንያመ ቢታንነ ግምበትዳ ካታማታን ሻክ ሻክ ሹምስ፤ ኤንታዉ ዳሮ ካነ ዳሮ ማቾ ደምስ።<verse eid="2CH 11:23"/></para>
  <chapter eid="2CH 11"/>
  <chapter number="12" style="c" sid="2CH 12"/>
  <para style="s1">ሽሻቅ የሩሳላመ ቦላ ደንድስ</para>
  <para style="r">(<ref loc="1KI 14:25-28">1 ካዎ 14:25-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 12:1"/>ሮብኣማ ካዎተይ ምንድ ኤቅዳ ዎደ እነ እስራኤለ አሳ ኡባይ ጎዳ ህግያ አጋግዶሶና። <verse eid="2CH 12:1"/><verse number="2" style="v" sid="2CH 12:2"/>ኤንቲ ጎዳስ አማነቶና እፅዳ ግሾ ሮብኣም ካዎትዳ እቻሻን ላይን ግብፀ ካዎይ ሽሻቅ የሩሳላመ ቦላ ደንድስ። <verse eid="2CH 12:2"/><verse number="3" style="v" sid="2CH 12:3"/>እያዉ እስ ሙኩሉነ ናምኡ ፄቱ ፓራ ጋረት፥ ኡሱፑን ታሙ ሙኩሉ ፓራ አሳትነ ታይቦይ ባይና ሊበ፥ ሱካነ ቶጰ ኦላንቾት ደኦሶና። <verse eid="2CH 12:3"/><verse number="4" style="v" sid="2CH 12:4"/>ካዎይ ሽሻቅ ግምበትዳ ይሁዳ ካታማታ ኦይክድ የሩሳላመ ጋካናዉ ይስ።<verse eid="2CH 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 12:5"/>ሄሳፈ ጉየ፥ ናበይ ሻማየይ ሮብኣማነ ሽሻቃ ያይድ የሩሳላመን ሺቅድ ደእያ ይሁዳ ሀላቃታኮ ይድ፥ “ጎዳይ፥ ‘ህንተ ታና አግዳ ግሾ፥ ታ ህንተና ሽሻቃ ኩሸን የጋስ’ ” ያግስ።<verse eid="2CH 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 12:6"/>እስራኤለ ሀላቃትነ ካዎይ ሮብኣም፥ ባንታና ካዉሽድ፥ “ጎዳይ ፅሎ” ያግዶሶና።<verse eid="2CH 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 12:7"/>ኤንቲ ባንታና ካዉሽዳይሳ ጎዳይ በእዳ ዎደ ሻማያኮ ሀይሳዳ ያግስ፤ “ኤንቲ ባንታና ካዉሽዳ ግሾ ታ ኤንታ ይስከ፤ ታ ኤንታ አሻና። ታ ሀንቆይ ሽሻቃ ባጋራ የሩሳላመ ቦላ ጉከና። <verse eid="2CH 12:7"/><verse number="8" style="v" sid="2CH 12:8"/>ግዶሽን፥ ታዉ ሃረተይሳንነ ሀራ ካዎታስ ሃረተይሳን ደእያ ዱማተ ኤንቲ ኤራና መላ ሽሻቃስ ሃረታና” ያግስ።<verse eid="2CH 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 12:9"/>ግብፀ ካዎይ ሽሻቅ የሩሳላመ ኦልድ፥ ፆሳ ኬንነ ካዎ ጋን ደእያ ሻሎ ኡባ ኤክስ። ሶሎሞነይ ዎርቃፈ ኦስስዳ ጎንዳለታ ቦንቅስ። <verse eid="2CH 12:9"/><verse number="10" style="v" sid="2CH 12:10"/>እ ኤፍዳ ዎርቃ ጎንዳለታ ግሾ ካዎይ ሮብኣም ናሰ ብራታፐ ሀራ ጎንዳለታ ኦስስድ ካዎ ጋ ፐንገ ናገይሳታ ሀላቃታ ኩሸን ዎስ። <verse eid="2CH 12:10"/><verse number="11" style="v" sid="2CH 12:11"/>ካዎይ ፆሳ ኬ ገልያ ዎደ ኡባን ፐንግያ ናገይሳት ሄ ጎንዳለታ ኦይክድ እያ ካሎሶና። ካዎይ ስምኮ ኤንቲ ዛሪድ ናገይሳታ ኬን ዎሶና። <verse eid="2CH 12:11"/><verse number="12" style="v" sid="2CH 12:12"/>ሮብኣም ባና ካዉሽዳ ግሾ እ ዮና መላ ጎዳ ሀንቆይ እያፐ ስምስ። ይሁዳ ቢታ ኡባን ቃስ ሳእ እንጀትስ።<verse eid="2CH 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 12:13"/>ካዎይ ሮብኣም ባና ምንድ የሩሳላመን ካዎትስ፤ ሮብኣም ካዎትዳ ዎደ እያዉ ላይ ኦይታማነ እስኖ። ጎዳይ ባ ሱንይ ያን ፄገታና መላ እስራኤለ ቢታ ኡባን ዶርዳ፥ የሩሳላመን ታማነ ላፑን ላይ ካዎትስ። ሮብኣማ አይያ አሞነ ማጫስ ናእሞ። <verse eid="2CH 12:13"/><verse number="14" style="v" sid="2CH 12:14"/>ሮብኣም ጎዳ ዎዛናፐ ጎይናናዉ ኮይቦና ግሾ ኢታባ ኦስ።<verse eid="2CH 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 12:15"/>ሮብኣም ባ ካዎተ ዎድያን ኦዳባይ ኮይሮፐ ዉርሰ ጋካናዉነ እያ የለታ ማራይ፥ ናብያ ሻማያ ታርከ ማፃፋንነ ቆንጨ በእያ እዶ ታርከ ማፃፋን ፃፈትስ ግደኔ? ሮብኣም ነ እዮርባም ኡባ ዎደ ኦለትሸ ደእዶሶና። <verse eid="2CH 12:15"/><verse number="16" style="v" sid="2CH 12:16"/>ሮብኣም ሀይቅድ ባ ማይዛታ ጋክስ፤ እ ዳዊታ ካታማን ሞገትስ። እያ በሳን እያ ናአይ አብይ ካዎትስ።<verse eid="2CH 12:16"/></para>
  <chapter eid="2CH 12"/>
  <chapter number="13" style="c" sid="2CH 13"/>
  <para style="s1">ይሁዳ ካዋ አብያ</para>
  <para style="r">(<ref loc="1KI 15:1-8">1 ካዎ 15:1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 13:1"/>ካዎይ እዮርባም ካዎትዳ ታማነ ሆስፑን ላይን አብይ ይሁዳን ካዎትስ። <verse eid="2CH 13:1"/><verse number="2" style="v" sid="2CH 13:2"/>አብይ የሩሳላመን ሄ ላይ ካዎትስ። እያ አየ ሱንይ ምካዮ፤ እያ ግብአ አድያ ኡርኤላ ናአ።</para>
  <para style="p" vid="2CH 13:2">አብይነ እዮርባም ኦለትሸ ደእዶሶና። <verse eid="2CH 13:2"/><verse number="3" style="v" sid="2CH 13:3"/>አብይ ዶረትዳ ኦይዱ ፄቱ ሙኩሉ ምኖ ኦላንቾታ ኤክድ ኦላስ ከይስ። እዮርባም ዶረትዳ ሆስፑን ፄቱ ሙኩሉ ምኖ ኦላንቾታ ኤክድ አብያራ ኦለታናዉ ከይስ።<verse eid="2CH 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 13:4"/>ሄሳፈ ጉየ፥ አብይ ደረይ ዳርያ ኤፍሬማ ቢታን ደእያ ፃማራይማ ደርያ ሁጰን ኤቅድ፥ ሀይሳዳ ያግስ፤ “ነኖ፥ እዮርባማ፥ ህንተኖ፥ እስራኤለ አሳዉ፥ ኡባይ ታ ግያባ ስእተ! <verse eid="2CH 13:4"/><verse number="5" style="v" sid="2CH 13:5"/>ጎዳይ እስራኤለ ፆሳይ ዳዊታነ እያ ኮቻይ እስራኤለ ቦላ መርናዉ ካዎታና መላ ዳዊታራ ማፅነን ጫቅዳይሳ ኤረከትዬ? <verse eid="2CH 13:5"/><verse number="6" style="v" sid="2CH 13:6"/>ግዶሽን፥ ዳዊታ ናኣ ሶሎሞነ አይለይ፥ ናባፃ ናአይ እዮርባም ደንድድ ባ ጎዳ ቦላ ማካልስ። <verse eid="2CH 13:6"/><verse number="7" style="v" sid="2CH 13:7"/>ሮብኣም ዮጋ፥ ኤር ባይናይሳነ ኤንታራ ኤቀታናዉ ዳንዳኦና ዎደ ፓና ላፋ አሳት እዮርባማኮ ሺቅድ ሶሎሞነ ናኣ ሮብኣማ ቦላ ደንድዶሶና።<verse eid="2CH 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 13:8"/>“ጎዳይ ዳዊታ ኮቻስ እምዳ ካዎተራ ህንተ ኤቀታናዉ ቆፔታ። ህንተ ሄሳ ቆፕዳይ ህንተ ዳሮ ግድያ ግሾነ ፆሳታ ግዳና መላ እዮርባም ዎርቃፈ መዳ ማራት ህንተራ ደእያ ግሾሳ። <verse eid="2CH 13:8"/><verse number="9" style="v" sid="2CH 13:9"/>ጎዳስ ኦያ አሮና ኮቸ ግድዳ ኦያ ካህነታነ ሌወታ ህንተ የደደታ። ሀራ ቢታ አሳይ ኦይሳዳ ህንተዉ ሀራ ካህነታ ሹምደታ። ባና ዱማያናዉ እስ ዎፋኖነ ላፑን ማራዘ ኤክድ ያ ኦናካ ዎርዶ ፆሳታስ ካህነ ኦድ ሹማታ።<verse eid="2CH 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 13:10"/>“ግዶሽን፥ ኑስ ጎዳይ ኑ ፆሳ፤ ኑኒ እያ አግቦኮ። ካህነ ግድድ ኦያ አሮና ኮቻት ኑስ ደኦሶና፤ ሌወት ኤንታ ማዶሶና። <verse eid="2CH 13:10"/><verse number="11" style="v" sid="2CH 13:11"/>ኤንቲ ኡባ ጋላስ ዎንታነ ኦማርስ ጎዳስ ፁሳ ያርሾ ያርሾሶናነ ሳውያ እፃነ ጩይሶሶና። ጎዳ ስንን ዎያ ኡይ ጌሻ ፃርጴዛ ቦላ ዎሶና። ኦማርስ ኦማርስ ፆምፐ ዎያ ኮጫ ቦላ ታማ ኦይሶና። ኑኒ ጎዳ ኑ ፆሳ ኪታ ናጎስ፤ ሽን ህንተ እያ አግደታ። <verse eid="2CH 13:11"/><verse number="12" style="v" sid="2CH 13:12"/>ፆሳይ ኑራ ደኤስ፤ እ ኑና ካለስ። ኦላ ሞይዘ ፑንያ እያ ካህነት ኑራ ደኦሶና፤ ኑኒ ህንተራ ኦላ ዶማናዉ ሞይዘ ፑናና። እስራኤለ አሳዉ፥ ጎዳራ ህንተ አዋታ ፆሳራ ኦለቶፍተ! ህንተ እያ ፆናናዉ ዳንዳኤከታ” ያግስ።<verse eid="2CH 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 13:13"/>ሄ ዎደ እዮርባም ባ ኦላንቾታፐ እስ ጩጋ ኤንታፈ ጉየራ ዙግድ ናጋና መላ የድስ። አትዳ እስራኤለ ኦላንቾት ይሁዳ ኦላንቾታ ስንን ደእያ ዎደ ዙግድ ናግያ ኦላንቾት ኤንታፈ ጉየራ ደኦሶና። <verse eid="2CH 13:13"/><verse number="14" style="v" sid="2CH 13:14"/>ይሁዳ ኦላንቾት ጉየ ስሚድ ፄልያ ዎደ ኤንታ ኦላናዉ ይዳይሳት ጉየራነ ስንራ ደኤይሳ በእዳ ዎደ ጎዳኮ ዋስዶሶና፤ ካህነት ሞይዘ ፑንዶሶና። <verse eid="2CH 13:14"/><verse number="15" style="v" sid="2CH 13:15"/>ይሁዳ ኦላንቾት ኦላ ዋሶ ዋስዳ ዎደ ጎዳይ እዮርባማነ እስራኤለ አሳ ኡባ አብያ ስንንነ ይሁዳ ስንን ፆንስ። <verse eid="2CH 13:15"/><verse number="16" style="v" sid="2CH 13:16"/>እስራኤለ ኦላንቾት ይሁዳ ኦላንቾታ ስንፈ ባቃትን ፆሳይ ኤንታ ይሁዳ ኦላንቾታ ኩሸን አድ እሚስ። <verse eid="2CH 13:16"/><verse number="17" style="v" sid="2CH 13:17"/>አብይነ እያ ኦላንቾት ኤንታ ዲፍ ኦድ ዉርስዶሶና። ሄ ኦላን 500,000 ዶረትዳ እስራኤለ ኦላንቾት ሀይቅዶሶና። <verse eid="2CH 13:17"/><verse number="18" style="v" sid="2CH 13:18"/>እስራኤለ አሳይ ሄ ዎደ ፆነትዶሶና፤ ይሁዳ አሳይ ጎዳን ባንታ አዋታ ፆሳን አማነትዳ ግሾ ኤንታ ፆንዶሶና።<verse eid="2CH 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 13:19"/>አብይ እዮርባማ የደድ እያፐ ቤተለ፥ ይሻናነ ኤፍሮና ኤንታ ጉታታራ ኦይክስ። <verse eid="2CH 13:19"/><verse number="20" style="v" sid="2CH 13:20"/>አብይ ደእዳ ላይን እዮርባም ስሚድ ምንቤና። ጎዳይ እዮርባማ ሾጭን ሀይቅስ።<verse eid="2CH 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 13:21"/>ግዶሽን፥ አብይ ምን ምን ብስ። አብይ ታማነ ኦይዱ ማቾ ኤክድ ላታማነ ናምኡ አደ ናይታነ ታማነ ኡሱፑን ማጫ ናይታ የልስ። <verse eid="2CH 13:21"/><verse number="22" style="v" sid="2CH 13:22"/>አትዳ አብይ ታርከይ፥ እ ኦዳባይነ እ ኦድዳባይ ናብያ እዶ ታርከ ማፃፋን ፃፈትስ።<verse eid="2CH 13:22"/></para>
  <chapter eid="2CH 13"/>
  <chapter number="14" style="c" sid="2CH 14"/>
  <para style="s1">ይሁዳ ካዋ አሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 14:1"/>አብይ ሀይቅድ ባ ማይዛታ ጋክስ፤ እ ዳዊታ ካታማን ሞገትስ። እያ በሳን እያ ናአይ አስ ካዎትስ። እ ካዎትዳ ዎደ ቢታይ ታሙ ላይ ዎፑ ግድ ደእስ።<verse eid="2CH 14:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 14:2"/>አስ ጎዳ ባ ፆሳ ስንን ሎኦባነ ሱረባ ኦስ። <verse eid="2CH 14:2"/><verse number="3" style="v" sid="2CH 14:3"/>አስ አላጋ ፆሳታስ ያርሽያ በሳታነ ቃ ጎይኖ በሳታ ይስስ። ጎይናናዉ ሹቻፈ ኦሰትዳ ቱሳታ መንረስ። አሼራ ጌተትያ ፆሳ ምስለታ ቃንፀረድ የግስ። <verse eid="2CH 14:3"/><verse number="4" style="v" sid="2CH 14:4"/>ይሁዳ አሳይ ጎዳ ባንታ አዋታ ፆሳ ኮያና መላ፥ እያ ህግያነ እያ ዎጋ ናጋና መላ አስ ኪትስ። <verse eid="2CH 14:4"/><verse number="5" style="v" sid="2CH 14:5"/>ቃ ጎይኖ በሳታነ እፃነ ጩይስያ በሳታ ይሁዳ ካታማታፐ ይስዳ ግሾ እያ ካዎተ ላይን ቢታይ ዎፑ ግድ ደእስ። <verse eid="2CH 14:5"/><verse number="6" style="v" sid="2CH 14:6"/>ካዎይ አስ ይሁዳ ካታማታስ ሚፃታ ኬፅስ። ጎዳይ እያ ሸምፕስዳ ግሾ ቢታይ ሸምፕስ፤ እያ ላይን እያራ ኦንካ ኦለትቤና።<verse eid="2CH 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 14:7"/>አስ ይሁዳ አሳኮ፥ “አነ ኑኒ ሀ ካታማታ ኤሶስ፤ ኤንታ ዩሾን ሚፃታ ኬፆስ፤ አዱሳ ሻኮ፥ ፐንገታነ ጎርደታ ጊግሶስ። ኑኒ ጎዳ ኑ ፆሳ ኮይዳ ግሾ ቢታይ ሀእካ ኑባ። ኑኒ እያ ኮይዳ፤ እ ኑስ ኡባ ባጋራ ሸምፖ እሚስ” ያግስ። ሄሳ ግሾ፥ ኤንቲ ካታማታ ኬፅድ ፖልዶሶና።<verse eid="2CH 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 14:8"/>አሳስ ይሁዳ ኮቻፈ ዎጋ ጎንዳለታነ ቶራታ ዳንጭዳ ሄ ፄቱ ሙኩሉ ኦላንቾት ደኦሶና። ብንያመ ኮቻፈ ጉ ጎንዳለታ ዳንጭዳነ ዶንገን ዱከይሳት ናምኡ ፄታነ ሆስፑን ታሙ ሙኩሉ ኦላንቾት ደኦሶና። ሄሳት ኡባይ ምኖ ኦላንቾታ።<verse eid="2CH 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 14:9"/>ዛራሀ ጌተትያ እስ ቶጰ አደይ እስ ምሎነ ኦላንቾታነ ሄ ፄቱ ፓራ ጋረታ ኤክድ ይሁዳ ኦላናዉ ይድ ማርሳ ጋክስ። <verse eid="2CH 14:9"/><verse number="10" style="v" sid="2CH 14:10"/>አስ እያራ ኦለታናዉ ከይድ ባ ኦላንቾታ ማርሳ ማታን ደእያ ፃፋታ ዛንጋራን ሳልፕስስ። <verse eid="2CH 14:10"/><verse number="11" style="v" sid="2CH 14:11"/>አስ ጎዳ ባ ፆሳ ሀይሳዳ ያግድ ዎስስ፤ “አቤት ጎዳዉ፥ ዎልቅ ባይና ኦላንቾታ ዎልቃማ ኦላንቾታፐ አሸይ ነ መል ባዋ። አቤት ጎዳዉ፥ ኑ ፆሳዉ፥ ኑኒ ነናን አማነትድ፥ ሀ ዎልቃማ ኦላንቾታራ ኦለታናዉ ነ ሱንን ይዳ ግሾ ነ ኑና ማዳ። አቤት ጎዳዉ፥ ነ ኑ ፆሳ፤ ነና አስ ፆነና” ያግስ።<verse eid="2CH 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 14:12"/>ጎዳይ ቶጰ ኦላንቾታ አሳ ስንንነ ይሁዳ ኦላንቾታ ስንን ሾጭን ቶጰ ኦላንቾት ባቃትዶሶና። <verse eid="2CH 14:12"/><verse number="13" style="v" sid="2CH 14:13"/>አስነ እያራ ደእያ አሳይ ኤንታ ገራራ ጋካናዉ የደዶሶና። ቶጰ ኦላንቾታፐ ዳሮይ ሀይቅዳ ግሾ ኤንቲ ስሚድ ምናናዉነ ኦለታናዉ ዳንዳእቦኮና። ሄሳዳ ሀንድ፥ ቶጰ ኦላንቾት ጎዳንነ እያ ኦላንቾታን ፆነትዶሶና። ካዋ አሳ ኦላንቾት ዳሮ ድኦ ድእዶሶና። <verse eid="2CH 14:13"/><verse number="14" style="v" sid="2CH 14:14"/>ሄ ሄራን ደእያ አሳይ ጎዳይ ኦዳባ በእድ ዳሮ ዳጋምስ። አሳ ኦላንቾት ገራራ ዩሹዋን ደእያ ካታማታ ኡባ ቦንቅድ ይስዶሶና። <verse eid="2CH 14:14"/><verse number="15" style="v" sid="2CH 14:15"/>ቃስ መሄ ሞታ ኦልድ፥ ዳሮ ዶርሳነ ግማለታ ድእድ፥ የሩሳላመ ስምዶሶና።<verse eid="2CH 14:15"/></para>
  <chapter eid="2CH 14"/>
  <chapter number="15" style="c" sid="2CH 15"/>
  <para style="s1">ካዎይ አስ ኤህዳ ላመ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 15:1"/>ኦዴዳ ናኣ አዛርያሳ ቦላ ፆሳ አያናይ ዎስ። <verse eid="2CH 15:1"/><verse number="2" style="v" sid="2CH 15:2"/>ካዋ አሳራ ጋሄታናዉ አዛርያስ ብድ፥ “አሳ፥ ይሁዳ አሳዉነ ብንያመ አሳዉ ስእተ! ህንተ ጎዳራ ግድኮ እካ ህንተራ ግዳና። ህንተ እያ ኮይኮ እ ህንተዉ በንታና፤ ሽን ህንተ እያ አግኮ እ ህንተና አጋና። <verse eid="2CH 15:2"/><verse number="3" style="v" sid="2CH 15:3"/>እስራኤለ አሳይ ቱማ ፆሲ ባይና፥ ታማርስያ ካህነይነ ህገይ ባይና ዳሮ ዎደ ደእዶሶና። <verse eid="2CH 15:3"/><verse number="4" style="v" sid="2CH 15:4"/>ሽን ባንታና መቶይ ጋክዳ ዎደ ኤንቲ ጎዳኮ፥ እስራኤለ ፆሳኮ ስሚድ እያ ኮይን እ ኤንታዉ በንትስ። <verse eid="2CH 15:4"/><verse number="5" style="v" sid="2CH 15:5"/>ሄ ዎደ ቢታን ደእያ አሳ ኡባይ ዳጋማን ደእያ ግሾ ሳሮተን ከይድ ገልያ ኦንካ ባዋ። <verse eid="2CH 15:5"/><verse number="6" style="v" sid="2CH 15:6"/>ፆሳይ ኤንታ ዱማ ዱማ መቶን የግዳ ግሾ ደረይ ደርያ፥ ካታማይ ካታማ ኡንኤስ። <verse eid="2CH 15:6"/><verse number="7" style="v" sid="2CH 15:7"/>ግዶሽን፥ ህንተ፥ ህንተ ኦሱዋስ ዎይቶይ ደእያ ግሾ ምንተ፤ ጉየ ጎፕተ!” ያግስ።<verse eid="2CH 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 15:8"/>ካዎይ አስ ሀ ቃላነ ኦዴዳ ናአይ ናበይ አዛርያስ ኦድዳ ቃላ ስእዳ ዎደ ምንስ። አስ ይሁዳነ ብንያመ ቢታ ኡባፈነ እ ኦይክዳ ደረይ ዳርያ ኤፍሬማ ቢታን ደእያ እፀትዳ ኤቃ ምስለታ ይስስ። ፆሳ ኬ ስንን ደእያ ጎዳ ያርሾ በሳ ኦራስ።<verse eid="2CH 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 15:9"/>እያ ጎዳይ ፆሳይ እያራ ደኤይሳ በእዳ ግሾ ዳሮ አሳይ እስራኤለፐ እያኮ ይዶሶና። ይሁዳ አሳነ ብንያመ አሳ ኡባ፥ ኤንታራ ደእያ ኤፍሬማ ኮቻታ፥ ምናሰ ኮቻታነ ስሞና ኮቻታ አስ ሺሽስ። <verse eid="2CH 15:9"/><verse number="10" style="v" sid="2CH 15:10"/>አስ ካዎትዳ ታማነ እቻሻን ላይን፥ ሄን አጌናን አሳይ የሩሳላመን ሺቅዶሶና። <verse eid="2CH 15:10"/><verse number="11" style="v" sid="2CH 15:11"/>ሄ ጋላስ ኤንቲ ድእድ ኤህዳባፐ ላፑን ፄቱ ኮርማታነ ላፑን ሙኩሉ ዶርሳታ ጎዳስ ያርሽዶሶና። <verse eid="2CH 15:11"/><verse number="12" style="v" sid="2CH 15:12"/>ጎዳ ባንታ አዋታ ፆሳ ባንታ ኩመ ዎዛናንነ ባንታ ኩመ ሸምፑዋን ኮያናዉ ጫቅዶሶና። <verse eid="2CH 15:12"/><verse number="13" style="v" sid="2CH 15:13"/>ጎዳ እስራኤለ ፆሳ ኮዮና አስ፥ ናአ ግድን ጭም፥ አደ ግድን ማጭ ሀይቆ። <verse eid="2CH 15:13"/><verse number="14" style="v" sid="2CH 15:14"/>ሄሳ ግታ ዋሶን፥ እልልሳን፥ ሞይዘንነ ዛየን ባንታ ጎዳስ ጫቅዶሶና። <verse eid="2CH 15:14"/><verse number="15" style="v" sid="2CH 15:15"/>ይሁዳ አሳ ኡባይ ባንታ ኩመ ዎዛናን ሀ ጫቁዋ ጫቅዳ ግሾ ኡፋይትዶሶና። ጎዳ ኤንቲ ምንድ ኮይን እ ኤንታዉ በንትስ። ጎዳይ ኤንታዉ ኡባ ባጋራ ዎፓ እሚስ።<verse eid="2CH 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 15:16"/>ቃስ፥ ካዎይ አስ ባ አዋ አይያ ማእካ አሼራ ጌተትያ ማጫ ፆሴ ኤቃ ምስለ ኦዳ ግሾ ካዋ አይዉ ጌተትያ ቦንቹዋፈ እዮ ድግስ። አስ ሄ ኤቃ ምስልያ ቃንፀረድ ቀድሮና ዛንጋራን ፁግስ። <verse eid="2CH 15:16"/><verse number="17" style="v" sid="2CH 15:17"/>ቃ ጎይኖ በሳታ እስራኤለ ቢታፈ ይሶና እፅኮካ አስ ባ ደእዳ ላይ ኡባን ጎዳስ አማነትዳ አስ ግድድ ደእስ። <verse eid="2CH 15:17"/><verse number="18" style="v" sid="2CH 15:18"/>እነ እያ አዋይ ጎዳስ ዱማይዳ ብራ፥ ዎርቃነ ሀራ ሚሸታ ኤህድ ፆሳ ኬን ዎስ። <verse eid="2CH 15:18"/><verse number="19" style="v" sid="2CH 15:19"/>አስ ካዎትዳ ሀስታማነ እቻሻን ላይ ጋካናዉ ኦል ባዋ።<verse eid="2CH 15:19"/></para>
  <chapter eid="2CH 15"/>
  <chapter number="16" style="c" sid="2CH 16"/>
  <para style="s1">ካዋ አሳ ዉርሰ ላይታ</para>
  <para style="r">(<ref loc="1KI 15:16-22">1 ካዎ 15:16-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 16:1"/>አስ ካዎትዳ ሀስታማነ ኡሱፑን ላይን እስራኤለ ካዎይ ባኦስ ይሁዳ ቦላ ደንድስ። ይሁዳ ካዋ አሳኮ ኦንካ ገሎና መላነ ከዮና መላ ተቃናዉ ራማን ሚፃ ኬፅስ። <verse eid="2CH 16:1"/><verse number="2" style="v" sid="2CH 16:2"/>ካዎይ አስ ፆሳ ኬንነ ባ ካዎ ጋን ደእያ ቡቁራ ምንጅያ ኬፈ ዎርቃነ ብራ ኤክድ ዳማስቆን ደእያ ሶረ ካዋ ዎልደ-አዳራስ ሀይሳዳ ያግድ የድስ። <verse eid="2CH 16:2"/><verse number="3" style="v" sid="2CH 16:3"/>“ካሰ ታ አዋራነ ነ አዋራ ጫቅዳይሳዳ ታራነ ኔራ ጫቆስ። ሄኮ፥ ታ ነዉ ብራነ ዎርቃ የዳስ። እስራኤለ ካዎይ ባኦስ ባ ኦላንቾታ ታ ቢታፈ ከሳና መላ ነ ካሰ እያራ ጫቅዳ ጫቁዋ ላላ” ያግስ።<verse eid="2CH 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 16:4"/>ካዎይ ዎልደ-አዳር፥ አስ ግዳይሳ ኤክድ ባ ቶራ ሞጮናታ እስራኤለ ኦላና መላ የድስ። ኤንቲ እዮና፥ ዳነነ አቤል-ማይማ ጌተትያ ካታማታነ ንፍታለመ ቢታን ደእያ ቡቁራ ምንጅያ ካታማታ ኡባ ፆንዶሶና። <verse eid="2CH 16:4"/><verse number="5" style="v" sid="2CH 16:5"/>ባኦስ ሄሳ ስእድ ራማን ኦያ ሚፃ አጋግስ።<verse eid="2CH 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 16:6"/>ካዎይ አስ ይሁዳ አሳ ኡባ ሺሽስ፤ አሳይ ባኦስ ካሰ ያን ጎኤትያ ሹቻነ ም ራማፐ ኤክድ ግብአነ ምፅጳ ካታማታን ሚፃ ኬፅስ።<verse eid="2CH 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 16:7"/>ሄ ዎደ ቆንጨ በእያ አናን ይሁዳ ካዋ አሳኮ ይድ፥ “ኔኒ ሶረ ካዋን አማነታዳ፥ ጎዳን ነ ፆሳን፥ አማነታቦና ግሾ ሶረ ካዋ ኦላንቾት ነ ኩሸፐ ከስ ኤክዶሶና። <verse eid="2CH 16:7"/><verse number="8" style="v" sid="2CH 16:8"/>ቶጰነ ሊበ አሳት ዳሮ ፓራ ጋረትነ ፓራት ደእያ ዳሮ ኦላንቾታ ግዶኮናዬ? ሽን ኔኒ ጎዳን አማነትዳ ግሾ ጎዳይ ኤንታ ነ ኩሸን አድ እሚስ። <verse eid="2CH 16:8"/><verse number="9" style="v" sid="2CH 16:9"/>ባ ኩመ ዎዛናን ጎዳን አማነትያ አስ ምንናዉ ጎዳ አይፈይ ሳኣ ኡባ ፄሌስ። ኔኒ ኤያተ ኦሶ ኦዳ ግሾ ህዛፐ ኦል ኔፐ ሻከተና” ያግስ።<verse eid="2CH 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 16:10"/>አስ ቆንጨ በእያ ኡራ ቦላ ዳሮ ሀንቀትዳ ግሾ እያ ሳንላታን ቃችድ ቃሾ ኬን የግስ። አስ ሄ ዎደ እስ እስ አሳታ ዳሮ ኡንኤስ።<verse eid="2CH 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 16:11"/>ሄኮ፥ አስ ኦዳባይ ኮይሮፐ ዉርሰ ጋካናዉ ይሁዳ ካዎታነ እስራኤለ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2CH 16:11"/><verse number="12" style="v" sid="2CH 16:12"/>አስ ካዎትዳ ሀስታማነ ኡዱፉን ላይን ቶሆ ሳከትስ፤ ሳሆይ ዳርኮካ፥ እ አክመታ ኮይስፐ አትሽን፥ ጎዳ ኮይቤና። <verse eid="2CH 16:12"/><verse number="13" style="v" sid="2CH 16:13"/>አስ ካዎትዳ ኦይታማነ እስን ላይን ሀይቅድ ባ ማይዛታ ጋክስ። <verse eid="2CH 16:13"/><verse number="14" style="v" sid="2CH 16:14"/>ኤንቲ እያ ዳዊታ ካታማን ዛላ ዎጭድ ከስዳ ዱፎን ሞግዶሶና። እያ አሀ ዱማ ዱማ ሽቶን ትየትዳ አርሳ ቦላ ዎዶሶና። ኤንቲ እያ ቦንቹዋስ ዳሮ ም ዶር ኤድ ዬክዶሶና።<verse eid="2CH 16:14"/></para>
  <chapter eid="2CH 16"/>
  <chapter number="17" style="c" sid="2CH 17"/>
  <para style="s1">ይሁዳ ካዋ እዮሳፈፃ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 17:1"/>አሳ ናአይ እዮሳፈፅ ባ አዋ በሳን ካዎትስ፤ እዮሳፈፅ እስራኤለ ኦላናዉ ባና ጊግስስ። <verse eid="2CH 17:1"/><verse number="2" style="v" sid="2CH 17:2"/>ሚፅ ኦሰትዳ ይሁዳ ካታማታን ኦላንቾታ ዎስ፤ ይሁዳ ቢታንነ እያ አዋይ አስ ኦልድ ኦይክዳ ኤፍሬማ ቢታን ኦላንቾታ ዎስ።<verse eid="2CH 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 17:3"/>እዮሳፈፅ፥ እያ አዋይ ዳዊቲ ኮይሮ ሄመትዳ ኦግያን ሄመትዳ ግሾነ ባኣለ ኤቃ ጎይኖና እፅዳ ግሾ ጎዳይ እያ አንጅስ። <verse eid="2CH 17:3"/><verse number="4" style="v" sid="2CH 17:4"/>እዮሳፈፅ ባ አዋ ኦገን ሄመትድ ጎዳ ኪታ ፖልስ። እስራኤለ ካዎት ኦዳ ኢታ ኦሶታ ኦቤና። <verse eid="2CH 17:4"/><verse number="5" style="v" sid="2CH 17:5"/>ጎዳይ እያ ይሁዳ ካዎተን ምንድ ኤስስ። ይሁዳ አሳ ኡባይ እያዉ እሞታ ኤህዶሶና፤ እ ዳሮ ዱረትስነ ቦንቸትስ። <verse eid="2CH 17:5"/><verse number="6" style="v" sid="2CH 17:6"/>እዮሳፈፅ ጎዳስ ኩመ ዎዛናን ኦያ አስ። ቃ ጎይኖ በሳታነ አሼራ ጌተትያ ፆሰ ኤቃ ምስለታ ይሁዳ ቢታፈ ይስስ።<verse eid="2CH 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 17:7"/>እዮሳፈፅ ካዎትዳ ሄን ላይን ይሁዳ ካታማታን ታማርሳና መላ ባ ሞርናታ በንሃላ፥ አብድዩ፥ ዛካርያሳ፥ ናትናኤላነ ምክያሳ የድስ። <verse eid="2CH 17:7"/><verse number="8" style="v" sid="2CH 17:8"/>ኤንታራ ጉ ሌወታ ሻማያ፥ ናታና፥ ዛባዳ፥ አሳሄላ፥ ሳምራሞታ፥ ዮናታና፥ አዶንያሳ፥ ፆባነ ፆባዶና የድስ፤ ቃስ ኤንታራ ካህነታ ኤልሳማናነ እዮራማ የድስ። <verse eid="2CH 17:8"/><verse number="9" style="v" sid="2CH 17:9"/>ኤንቲ ጎዳ ህገ ማፃፋ ኤክድ ይሁዳ ቢታን ደእያ ካታማታ ኡባ ብድ ያን አሳ ታማርስዶሶና።<verse eid="2CH 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 17:10"/>ይሁዳ ዩሾን ደእያ ካዎተታ ኡባ ጎዳይ ያሽስን፥ ኤንቲ እዮሳፈፃራ ኦለትቦኮና። <verse eid="2CH 17:10"/><verse number="11" style="v" sid="2CH 17:11"/>ፍልስፄመፐ ጉ አሳት እዮሳፈፃስ እሞታነ ብራ ጊራ ኤህዶሶና፤ አራባት እያዉ ላፑን ሙኩሉነ ላፑን ፄቱ ዶርሳ ኡርገታነ ላፑን ሙኩሉነ ላፑን ፄቱ ኮለታ ኤህዶሶና። <verse eid="2CH 17:11"/><verse number="12" style="v" sid="2CH 17:12"/>እዮሳፈፅ ምን ምን ብስ። ይሁዳን ሚፃታነ ሻሎ ምንጅያ ካታማታ ኬፅስ። <verse eid="2CH 17:12"/><verse number="13" style="v" sid="2CH 17:13"/>ይሁዳ ካታማታን ዳሮባ ምንጅስ።</para>
  <para style="p" vid="2CH 17:13">የሩሳላመን እያዉ ምኖ ኦላንቾት ደኦሶና። <verse eid="2CH 17:13"/><verse number="14" style="v" sid="2CH 17:14"/>ኤንቲ ባንታ አዋታ ሶ አሳን አሳን ሀይሳፈ ካልድ ፃፈትዶሶና። ይሁዳ ኮቻፈ ሻላቃይ አድና፤ እያራ ሄ ፄቱ ሙኩሉ ምኖ ኦላንቾት ደኦሶና።<verse eid="2CH 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 17:15"/>አድና ካልድ ደእያ ሀላቃይ ዮሃና፤ እያራ ናምኡ ፄታነ ሆስፑን ታሙ ሙኩሉ ምኖ ኦላንቾት ደኦሶና።<verse eid="2CH 17:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 17:16"/>ጎዳስ ባ ሸነን ባና ዱማይዳ ዝክራ ናአይ አማሳይ እያ ካልድ ደእያ ሄን ሀላቃ፤ እያራ ናምኡ ፄቱ ሙኩሉ ምኖ ኦላንቾት ደኦሶና።<verse eid="2CH 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 17:17"/>ብንያመ ኮቻፈ ሀላቃይ ምኖ ኦላንቹዋ ኤልያዳ፤ እያራ ዶንገነ ጎንዳለ ኦይክያ ናምኡ ፄቱ ሙኩሉ ኦላንቾት ደኦሶና።<verse eid="2CH 17:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 17:18"/>ኤልያዳ ካልድ ደእያ ሀላቃይ ዮዛባታ፤ እያራ ኦላ ባናዉ ዳንጭዳ እስ ፄታነ ሆስፑን ታሙ ሙኩሉ ኦላንቾት ደኦሶና።<verse eid="2CH 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 17:19"/>ሀይሳቲ ካዋስ የሩሳላመን ኦዳይሳታ፤ ሀይሳቲ ይሁዳን ግምበትዳ ካታማታን ደእያ ካዎይ ዎዳ ኦላንቾታፐ ሀራ።<verse eid="2CH 17:19"/></para>
  <chapter eid="2CH 17"/>
  <chapter number="18" style="c" sid="2CH 18"/>
  <para style="s1">ምክያስ አካባስ ኦድዳ ትንብተ</para>
  <para style="r">(<ref loc="1KI 22:1-28">1 ካዎ 22:1-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 18:1"/>እዮሳፈፅ ዳሮ ዱረተነ ቦንቾ ደምዳፐ ጉየ አካባራ ቦሎትስ። <verse eid="2CH 18:1"/><verse number="2" style="v" sid="2CH 18:2"/>ጉ ላይፈ ጉየ እዮሳፈፅ አካባ በአናዉ ሳማረ ብስ። አካብ እያዉነ እያራ ደእያ አሳስ ዳሮ ዶርስነ ቦሩ ሹክስ። ያትድ እዮሳፈፃ ጋላዳን ደእያ ራሞታ ኦላናዉ ባራ ባና መላ ማቅስ። <verse eid="2CH 18:2"/><verse number="3" style="v" sid="2CH 18:3"/>እስራኤለ ካዎይ አካብ ይሁዳ ካዋ እዮሳፈፃኮ፥ “ጋላዳን ደእያ ራሞታ ኦላናዉ ታራ ባኔ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2CH 18:3">እዮሳፈፅ፥ “ኤ፥ ታ ኔራ ባና፤ ታ ኦላንቾት ነ ኦላንቾታ፤ ኑ ኔራ ባና” ያግስ። <verse eid="2CH 18:3"/><verse number="4" style="v" sid="2CH 18:4"/>እዮሳፈፅ እስራኤለ ካዋኮ፥ “ግዶሽን፥ ነ ኮይሮታዳ ጎዳ ኦይቻ” ያግስ።<verse eid="2CH 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 18:5"/>እስራኤለ ካዎይ ኦይዱ ፄቱ ናበታ ሺሽድ፥ “ታ ጋላዳን ደእያ ራሞታ ኦላናዉ ቦየ ቦፖ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2CH 18:5">ኤንቲ፥ “ባ፤ ፆሳይ ነ ኩሸን አድ እማና” ያግዶሶና።<verse eid="2CH 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 18:6"/>ሽን እዮሳፈፅ፥ “ኑ ጎዳ ኦይቻናዉ ዳንዳእያ ሀራ ናበይ ሀይሳን ባዌ?” ያግስ።<verse eid="2CH 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 18:7"/>እስራኤለ ካዎይ እዮሳፈፃኮ፥ “ኑ እያ ባጋራ ጎዳ ኦይቻናዉ ዳንዳእያ ሀራ ናበይ ይምላ ናአይ ምክያስ ደኤስ። ሽን እ ኡባ ዎደ ታዉ ኢታባ ኦዴስፐ አትሽን፥ ሎኦባ ኦድ ኤሮና ግሾ ታ እያ ዶስከ” ያግስ።</para>
  <para style="p" vid="2CH 18:7">እዮሳፈፅ፥ “ካዎይ ሀይሳዳ ጋናዉ በሰና” ያግስ።<verse eid="2CH 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 18:8"/>እስራኤለ ካዎይ ባ ሞርናታፐ እሱዋ ፄግድ፥ “ይምላ ናኣ ምክያሳ ኤለ ኤካዳ ያ” ያግስ።<verse eid="2CH 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 18:9"/>እስራኤለ ካዎይነ ይሁዳ ካዎይ እዮሳፈፅ ካዎ ማኦ ማእድ፥ ሳማረ ካታማ ገልያ ፐንገን ባንታ አራታን ኡትን ናበት ኡባይ ኤንታ ስንን ትንብተ ኦዶሶና። <verse eid="2CH 18:9"/><verse number="10" style="v" sid="2CH 18:10"/>ኤንታፈ እሶይ፥ ክንአና ናአይ ሰደቅያስ ብራታፐ ካጨታ ጊግስድ አካባኮ፥ “ጎዳይ፥ ‘ሶረት ያና ጋካናዉ ነ ኤንታ ሀ ካጨታን ቃይጫና’ ያጌስ” ያግስ።<verse eid="2CH 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 18:11"/>ሀራ ናበት ኡባይ፥ “ጎዳይ ራሞታ ነ ኩሸን አድ እማና ግሾ ባ፤ ኦላዳ ፆና” ያግዶሶና።<verse eid="2CH 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 18:12"/>ምክያሳ ፄጋናዉ ኪተትድ ብዳ ኡራይ፥ “ሄኮ፥ ሀራ ናበት ኡባይ እስ ዶና ግድድ ካዎይ ፆናናይሳ ኦድዶሶና። ነ ኦዳይካ ኤንታ ኦዳ መላ ግዶ፤ ሎኦባ ኦዳ” ያግስ።<verse eid="2CH 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 18:13"/>ሽን ምክያስ፥ “ደኦ ጎዳይ ኤርያ መላ፥ ፆሳይ ታዉ ቆንጭስዳባ ኦዳና” ያግስ።<verse eid="2CH 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 18:14"/>ምክያስ ካዋኮ ይዳ ዎደ ካዎይ፥ “ምክያሳ ኑኒ ጋላዳን ደእያ ራሞታ ኦላናዉ ቢኖየ ቦፕኖ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2CH 18:14">ምክያስ ካዋኮ፥ “ኤንቲ ነ ኩሸን አድ እመታና ግሾ ባዳ ኦላ” ያግስ።<verse eid="2CH 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 18:15"/>ካዎይ፥ “ጎዳ ሱንን ቱማ ኦዳ፤ ሀራባ ታዉ ኦዶና መላ ታኒ ነና አፑን ቶሆ ጫቅሶ” ያግስ።<verse eid="2CH 18:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 18:16"/>ምክያስ፥ “ታ እስራኤለ ኦላንቾት ኡባይ ሄንንቾይ ባይና ዶርሳዳ ደርያ ቦላ ላለትዳይሳ በአስ። ጎዳይ፥ ‘ሀይሳታ ካለያ አስ ባዋ፤ ኤንቲ ኡባይ ባንታ ሶ ሶ ሳሮ ቦ’ ያጌስ” ያግስ።<verse eid="2CH 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 18:17"/>እስራኤለ ካዎይ እዮሳፈፃኮ፥ “እ ታዉ ኢታፐ አትሽን፥ ሎኦ ኦድ ኤረና ጋዳ ታኒ ነዉ ኦዳብክና?” ያግስ።<verse eid="2CH 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 18:18"/>ምክያስ ጉጅድ ሀይሳዳ ያግስ፤ “ሀእ፥ ጎዳይ ግያባ ስአ! ጎዳይ ባ አራታን ኡትን ሳሎ ኦላንቾት እያ ኡሻቻ ባጋንነ እያ ሀድርሳ ባጋን ኤቅዳይሳታ በአስ። <verse eid="2CH 18:18"/><verse number="19" style="v" sid="2CH 18:19"/>ጎዳይ፥ ‘እስራኤለ ካዎይ አካብ ጋላዳን ደእያ ራሞታ ብድ ያን ሀይቃናዳ እያ ባለናይ ኦኔ?’ ” ያግስ።</para>
  <para style="p" vid="2CH 18:19">እሶይ፥ “ሀይሳዳ ግያ ዎደ ሀንኮይ ሄሳዳ” ግስ።<verse eid="2CH 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 18:20"/>ዉርሰን እስ አያን ከይድ ጎዳ ስንን ኤቅድ፥ “ታኒ እያ ባለና” ያግስ።</para>
  <para style="p" vid="2CH 18:20">ጎዳይ፥ “ዋታዳ ባለኔ?” ያግስ።<verse eid="2CH 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 18:21"/>አያናይ፥ “ታ ባዳ፥ እያ ናበታ ኡባ ዶናን ዎርዶ አያና ግዳና” ያግስ።</para>
  <para style="p" vid="2CH 18:21">ጎዳይ፥ “ኤ፥ ነ እያ ባለና፤ ነዉ ሀናና፤ ባዳ ባለ” ያግስ።<verse eid="2CH 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 18:22"/>ምክያስ፥ “ሄኮ፥ ጎዳይ ነና ይሳናዉ ቆፕዳ ግሾ ነ ናበታ ዶናን ዎርዶ አያና ዎስ” ያግስ።<verse eid="2CH 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 18:23"/>ክንአና ናአይ ሰደቅያስ ሺቅድ፥ ምክያሳ ባቅድ፥ “ጎዳ አያናይ ታና አግድ ነዉ ኦዳናዉ አዉራ አዴ?” ያግስ።<verse eid="2CH 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 18:24"/>ምክያስ፥ “ሄኮ፥ ነ ቆሰታናዉ ቆልአ ገልያ ዎደ ሄሳ ደማና” ያግስ።<verse eid="2CH 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 18:25"/>እስራኤለ ካዎይ ባ ኦላንቾታፐ እሱዋ ፄግድ፥ “ምክያሳ ኦይካ ኤፋዳ ካታማ ሃርያ አሞነስነ ታ ናኣ እዮኣሳስ እማ። <verse eid="2CH 18:25"/><verse number="26" style="v" sid="2CH 18:26"/>ካዎይ ኤንታኮ፥ ‘ሀ አድያ ቃሾ ኬን የግተ፤ ታ ሳሮ ስማና ጋካናዉ ጉ ኡይፈነ ሃፈ አትሽን፥ ሀራባ አይባካ እያዉ እሞፕተ’ ” ያግድ ኪትስ።<verse eid="2CH 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 18:27"/>ምክያስ፥ “ቱማ፥ ነ ሳሮ ስማናባ ግድኮ፥ ጎዳይ ታዉ ኦድቤና። ቃስ፥ አሳዉ፥ ታ ኦድያባ አኬክተ” ያግስ።<verse eid="2CH 18:27"/></para>
  <para style="s1">አካባ ሀይቁዋ</para>
  <para style="r">(<ref loc="1KI 22:29-35">1 ካዎ 22:29-35</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="2CH 18:28"/>ሄሳፈ ጉየ፥ እስራኤለ ካዎይነ ይሁዳ ካዎይ እዮሳፈፅ ጋላዳን ደእያ ራሞታ ብዶሶና። <verse eid="2CH 18:28"/><verse number="29" style="v" sid="2CH 18:29"/>እስራኤለ ካዎይ እዮሳፈፃኮ፥ “ታኒ ታ ማኡዋ ላማዳ ሀራ አስ ዳናዳ ኦላ ገላና፤ ሽን ኔኒ ነ ካዎ ማኡዋ ማአ” ያግስ። እስራኤለ ካዎይ ባ ማኡዋ ላምድ ሀራ አስ ዳንድ ኦላ ገልስ።<verse eid="2CH 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2CH 18:30"/>ሶረ ካዎይ ባ ፓራ ጋረታ ኪትያ አሳታኮ፥ “ግታ ግድን ጉ፥ ሀራ ኦደራካ ኦለቶፍተ፤ እስራኤለ ካዋ ፃላላ ኮይድ ዎተ” ያግድ ኪትስ።<verse eid="2CH 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 18:31"/>ፓራ ጋረታ ኪተይሳት እዮሳፈፃ በእዳ ዎደ፥ “ሀይስ እስራኤለ ካዋ” ያግድ እያራ ኦለታናዉ ስምዶሶና። እዮሳፈፅ ዋስን ጎዳይ እያ ማድድ ኤንታ ኩሸፐ አሽስ። <verse eid="2CH 18:31"/><verse number="32" style="v" sid="2CH 18:32"/>ፓራ ጋረታ ኪተይሳት እ እስራኤለ ካዋ ግዶናይሳ በእድ እያ ጎደይሳ አጋግዶሶና።<verse eid="2CH 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="2CH 18:33"/>እስ ኡራይ ጮ ባ ዶንግያ ዱክያ ዎደ እስራኤለ ካዋ ኦላ ማኦይ ጋሄትያ ሀሽያን ጫድስ። ካዎይ ባ ጋርያ ላግያ አድያኮ፥ “ጋርያ ጉየ ዛራዳ ታና ኦላ ግዶፈ ከሳ፤ ታኒ ኢታ ጫቸ ጫደታስ” ያግስ። <verse eid="2CH 18:33"/><verse number="34" style="v" sid="2CH 18:34"/>ኦላይ ጎብያ ዎደ እስራኤለ ካዎይ አካብ ባ ፓራ ጋርያ ግዶን ዘምፕድ፥ ኦማርስ ጋካናዉ ሶረታ ስንን ጋምእስ። አው ዉልያ ዎደ እ ሀይቅስ።<verse eid="2CH 18:34"/></para>
  <chapter eid="2CH 18"/>
  <chapter number="19" style="c" sid="2CH 19"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 19:1"/>ሄሳፈ ጉየ፥ ካዎይ እዮሳፈፅ የሩሳላመን ደእያ ባ ጋ ሳሮ ስምስ። <verse eid="2CH 19:1"/><verse number="2" style="v" sid="2CH 19:2"/>ቆንጨ በእያ፥ አናና ናአይ እዩይ ካዋ እዮሳፈፃራ ጋሄታናዉ ከይድ፥ “ኔኒ ኢታታ ማዳናዉ ዎይኮ ጎዳ እፀይሳታ ዶሳናው በሲ? ሄሳ ግሾ፥ ጎዳ ሀንቆይ ነ ቦላ ይስ። <verse eid="2CH 19:2"/><verse number="3" style="v" sid="2CH 19:3"/>ግዶሽን፥ አሼራ ኤቃ ምስለታ ቢታፈ ድግዳ ግሾነ ፆሳ ኮያናዉ ነ ዎዛና ጊግስዳ ግሾ ኔኒ ሎኦባ ኦዳሳ” ያግስ።<verse eid="2CH 19:3"/></para>
  <para style="s1">እዮሳፈፅ ዳይናታ ሹምስ</para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 19:4"/>እዮሳፈፅ የሩሳላመን ደእስ። በርሳበፐ ዶምድ ደረይ ዳርያ ኤፍሬማ ቢታ ጋካናዉ አሳ ግዶን ዩይድ፥ ጎዳኮ፥ ኤንታ አዋታ ፆሳኮ ኤንታ ዛርስ። <verse eid="2CH 19:4"/><verse number="5" style="v" sid="2CH 19:5"/>ይሁዳ ቢታን ደእያ ግምበትዳ ካታማታ ኡባን ዳይናታ ሹምስ። <verse eid="2CH 19:5"/><verse number="6" style="v" sid="2CH 19:6"/>ኤንታኮ፥ “ህንተ ፕርደይ አሳሳ ግዶናሽን፥ ህንተ ፕርድያ ዎደ ጎዳይ ህንተራ ደእያ ግሾ ህንተ ፕርድያ ዎደ ናገትተ። <verse eid="2CH 19:6"/><verse number="7" style="v" sid="2CH 19:7"/>ሀእካ ጎዳስ ያይተ፤ ጎዳ ኑ ፆሳ ማታን ናቆይ፥ ሶምኦ ፄልድ ማደይነ ዎፈ ኤኮይ ባይና ግሾ አኬክድ ፕርድተ” ያግስ።<verse eid="2CH 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 19:8"/>ቃስ፥ ጎዳ ህግያ ፖልሳና መላነ አሳ ግዶን ደንድያ ሞቱዋ ፕርዳና መላ ሌወታፐ፥ ካህነታፐነ እስራኤለ አሳ ሶ ሀላቃታፐ ጉ አሳታ እዮሳፈፅ የሩሳላመን ሹምስ። <verse eid="2CH 19:8"/><verse number="9" style="v" sid="2CH 19:9"/>እዮሳፈፅ ኤንታ ሀይሳዳ ያግድ ኪትስ፤ “ጎዳስ ያሻን፥ አማነተንነ ኩመ ዎዛናን ኦተ። <verse eid="2CH 19:9"/><verse number="10" style="v" sid="2CH 19:10"/>ባንታ ካታማን ደእያ ህንተ እሻት ሸምፖ ዎን፥ ህገ ዎይኮ ኪታ ዎይኮ አዋጆ መንን ህንተኮ ዪኮ፥ ኤንቲ ጎዳ ስንን ባላ ግዶናዳ፥ እያ ሀንቆይ ህንተ ቦላነ ህንተ እሻታ ቦላ ዮናዳ ኤንታ ሴርተ። ህንተ ኤንታ ሴርኮ ህንተ ህንተ ሁጰን ባላ ግደከታ። <verse eid="2CH 19:10"/><verse number="11" style="v" sid="2CH 19:11"/>ጎዳባ ግድዳ ኡባን ካህነታ ሀላቃ አማረ፤ ካዎባ ግድዳ ኡባን ይሁዳ ኮቻስ ሀላቃ ግድዳ እስማኤላ ናኣ ዛባዳ ሹማስ። ሌወት ህንተ ቦላ ሀላቃ ግዳና። ህንተ ምንድ ኦተ፤ ሱረባ ኦይሳራ ጎዳይ ግዶ” ያግስ።<verse eid="2CH 19:11"/></para>
  <chapter eid="2CH 19"/>
  <chapter number="20" style="c" sid="2CH 20"/>
  <para style="s1">ሞአበነ አሞነ ፆነተ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 20:1"/>ሄሳፈ ጉየ፥ ሞአበትነ አሞነት ማኡናት እዮሳፈፃ ቦላ ደንድዶሶና። <verse eid="2CH 20:1"/><verse number="2" style="v" sid="2CH 20:2"/>ጉ አሳት እዮሳፈፃኮ ይድ፥ “ማፅነ አባፈ ሄፍንን ደእያ ኤዶመፐ ዳሮ ኦላንቾት ነና ኦላናዉ ይዶሶና። ኤንቲ ሀሳሶን-ታማራን ደኦሶና” ያግድ ኦድዶሶና። (ሀሳሶን-ታማር ኤንጋዳስ ሀራ ሱን።)<verse eid="2CH 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 20:3"/>እዮሳፈፅ ያይዳ ግሾ ጎዳ ኦይቻናዉ ቆፋ ቃችስ፤ ይሁዳ ቢታ ኡባን ፆማ አዋጅስ። <verse eid="2CH 20:3"/><verse number="4" style="v" sid="2CH 20:4"/>ይሁዳ አሳ ኡባይ ጎዳፐ ማዶ ኮያናዉ ሺቅዶሶና፤ ኤንቲ ጎዳፐ ማዶ ኮያናዉ ይሁዳ ካታማ ኡባፈ ይዶሶና።<verse eid="2CH 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 20:5"/>እዮሳፈፅ፥ ይሁዳነ የሩሳላመ ሺቁዋ ግዶን፥ ፆሳ ኬን ደእያ ኦራ ዳባባ ስንን ኤቅስ። <verse eid="2CH 20:5"/><verse number="6" style="v" sid="2CH 20:6"/>ባ ቃላ ቁ ኦድ፥ “አቤት ጎዳዉ፥ ኑ አዋታ ፆሳዉ፥ ሳሎን ደእያ ፆሳይ ነና ግድኪ? ሳአን ደእያ ካዎተታ ኡባ ሃረይ ነና። ግታተነ ዎልቅ ነ ኩሸን ደእያ ግሾ ኔራ ኤቀታናዉ ዳንዳኤይ ባዋ። <verse eid="2CH 20:6"/><verse number="7" style="v" sid="2CH 20:7"/>አቤት ኑ ፆሳዉ፥ ካሰ ሀ ቢታን ደእያ አሳ፥ እስራኤለ ስንፈ የደዳ ነ ላግያ አብራሃመ ዘረስ መርናዉ እምዳይ ነና ግድኪ? <verse eid="2CH 20:7"/><verse number="8" style="v" sid="2CH 20:8"/>ኤንቲ ሀ ቢታን ደእዶሶና፤ ያን ነ ሱንስ ኬ ኬፅድ፥ <verse eid="2CH 20:8"/><verse number="9" style="v" sid="2CH 20:9"/>‘ኑ ቦላ ኢታ መቶይ ዎይኮ ኦል ዎይኮ ጋዶይ ዎይኮ ኮሽ ጋክኮ፥ ነ ሱንይ ደእያ ነ ኬ ስንንነ ነ ስንን ኤቅድ፥ ኑ መቱዋን ኔኮ ዋሳና። ነ ኑ ዋሱዋ ስአዳ ኑና አሻና’ ያግዶሶና።<verse eid="2CH 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 20:10"/>“ሄኮ፥ ሀእካ፥ እስራኤለ አሳይ ግብፀፈ ከይዳ ዎደ፥ ኤንታ ቢታ ኦሎና መላ ኦዳ ኤንታ ይሶና መላ ድግዳ አሞነት፥ ሞአበትነ ሳይረት ሀ ቢታን ደኦሶና። <verse eid="2CH 20:10"/><verse number="11" style="v" sid="2CH 20:11"/>ኑ ኦዶባስ ኤንቲ ኑስ ዛርዳባ በአ። ነ ኑስ እምዳ ላታ ቢታፈ ኤንቲ ኑና የደናዉ ይዶሶና። <verse eid="2CH 20:11"/><verse number="12" style="v" sid="2CH 20:12"/>አቤት ኑ ፆሳዉ፥ ነ ኤንታ ፕርድኪ? ኑና ኦላናዉ ይዳ ሀ ዳሮ ኦላንቾታራ ኦለታናዉ ኑስ ዎልቅ ባዋ። ኑኒ ኦናባ ኤሮኮ፤ ሽን ኑ አይፈት ነና ፄሎሶና” ያግስ።<verse eid="2CH 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 20:13"/>ይሁዳ አሳ ኡባይ ባንታ ናይታራነ ባንታ ማቸታራ ሺቅድ ጎዳ ስንን ኤቅዶሶና።<verse eid="2CH 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 20:14"/>ሄ ዎደ ዛካርያሳ ናአይ ያሀዝኤል ሺቁዋ ግዶን ኤቅዳሽን ጎዳ አያናይ እያ ቦላ ዎስ። ዛካርያስ ባናያ ናአ፤ ባናይ ይኤላ ናአ፤ ይኤል ማታና ናአ፤ ማታን ሌወ ኮቸነ አሳፋ ያራ። <verse eid="2CH 20:14"/><verse number="15" style="v" sid="2CH 20:15"/>ጎዳ አያናይ ያሀዝኤላ ቦላ ዎን፥ “ካዋዉ እዮሳፈፃ፥ ይሁዳንነ የሩሳላመን ደእያ አሳዉ፥ ኡባይ ስእተ! ጎዳይ ህንተና ያጌስ። ‘ሀ ዳሮ ኦላንቾታ ጋሶን ያዮፍተነ ዳጋሞፕተ። ኦላይ ህንተባ ግዶናሽን ፆሳባ። <verse eid="2CH 20:15"/><verse number="16" style="v" sid="2CH 20:16"/>ዎንቶ ኤንታ ቦላ ከይድ ፂፃ ጌተትያ በሳ ፑደ ከይሽን ይሩኤላ መላ ቢታን ደእያ ዛንጋራ ዉርሰን ህንተ ኤንታ ደማና። <verse eid="2CH 20:16"/><verse number="17" style="v" sid="2CH 20:17"/>ሀ ኦላ ኦለተይ ህንተና ግደከታ። ይሁዳነ የሩሳላመ አሳዉ፥ ህንተ በሳ በሳ ኦይክድ ምንድ ኤቅተ። ጎዳይ ህንተና አሽያ አሹዋ በእተ። ያዮፍተ፤ ዳጋሞፍተ፤ ዎንቶ ኤንታ ቦላ ከይተ፤ ጎዳይ ህንተራ ግዳና’ ” ያግስ።<verse eid="2CH 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 20:18"/>እዮሳፈፅ ሶምኦ ሳአ ጋድ ጎይንስ፤ ይሁዳ አሳ ኡባይ የሩሳላመን ደእያ አሳ ኡባይ ጎዳ ስንን ኩንድድ ጎይንዶሶና። <verse eid="2CH 20:18"/><verse number="19" style="v" sid="2CH 20:19"/>ቃሃታነ ቆረ ኮቻፈ ጉ ሌወት ኤቅድ ባንታ ቃላ ቁ ኦድ፥ ጎዳ እስራኤለ ፆሳ ጋላትዶሶና።<verse eid="2CH 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 20:20"/>ኤንቲ ዎንታ ጉራ ደንድድ ተቁሄ መላ ቢታ ብዶሶና። ኤንቲ ከይዳ ዎደ እዮሳፈፅ ደንድ፥ “ይሁዳንነ የሩሳላመን ደእያ አሳዉ ታኒ ገይሳ ስእተ። ጎዳን፥ ህንተ ፆሳን አማነትተ፤ ህንተ ምናና፤ ናበታ አማንተ ኡባይ ህንተዉ እንጀታና” ያግስ። <verse eid="2CH 20:20"/><verse number="21" style="v" sid="2CH 20:21"/>እዮሳፈፅ አሳራ ዞረትዳፐ ጉየ፥</para>
  <para style="q1" vid="2CH 20:21">“ጎዳ ጋላትተ፥</para>
  <para style="q2" vid="2CH 20:21">እያ ሲቆይ መርናሳ” ያግድ የፅሸነ እያ ጌሻ ቦንቹዋ ሳቢሸ ኦላንቾታ ስንራ ብያ አሳታ ሹምስ።<verse eid="2CH 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 20:22"/>ኤንቲ ማዝሙረ የነ ጋላታ ዶምዳ ዎደ ይሁዳ ኦላናዉ ይዳ አሞነታ ቦላ፥ ሞአበታ ቦላነ ሳይረታ ቦላ ጎዳይ ዳጋማ የድስ። <verse eid="2CH 20:22"/><verse number="23" style="v" sid="2CH 20:23"/>አሞነትነ ሞአበት ሳይረታ ቦላ ደንድድ፥ ኤንታ ኩመ ይስዶሶና። ኤንቲ ሳይረታ ይስዳፐ ጉየ ባንታ ግዶን እሶይ እሱዋ ይስዶሶና። <verse eid="2CH 20:23"/><verse number="24" style="v" sid="2CH 20:24"/>ይሁዳ አሳይ መላ ቢታን ደእያ ኦላንቾታ በአናዉ ይዳ ዎደ ባንታ ሞርከት ደእያ በሳ በእዶሶና። ኤንታ አሀይ ቢታን ዝንእዳይሳ ደምዶሶና፤ ኤንታፈ እስ አስካ ከስ ኤክቤና።<verse eid="2CH 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 20:25"/>ሄሳፈ ጉየ፥ እዮሳፈፅነ እያ አሳይ ድኦ ኤካናዉ ብድ ሽንቀ፥ ኦላ ሚሸ፥ ማኦታነ ሀራ አልኦ ሚሸታ ደምዶሶና። ሽን ድኦ ኡባ ኤፋናዉ ዳንዳእቦኮና፤ ድእዳባይ ዳሮ ግድዳ ግሾ ሺሻናዉ ሄ ጋላስ ኤክስ። <verse eid="2CH 20:25"/><verse number="26" style="v" sid="2CH 20:26"/>ኤንቲ ኦይዳን ጋላሳን ባራካ ዛንጋራን ሺቅድ ጎዳ ጋላትዶሶና። ሄሳ ግሾ ሄ በሳ “አንጆ ዛንጋራ” ያግድ ሱንዶሶና።<verse eid="2CH 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 20:27"/>ሄሳፈ ጉየ፥ ይሁዳ አሳይነ የሩሳላመ አሳ ኡባይ እዮሳፈፅ ካለን፥ ኡፋይሳን የሩሳላመ ስምዶሶና። <verse eid="2CH 20:27"/><verse number="28" style="v" sid="2CH 20:28"/>ኤንቲ የሩሳላመ ጋክድ ዲራ፥ ማስንቆራነ ዛየራ ፆሳ ኬ ገልዶሶና።<verse eid="2CH 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 20:29"/>እስራኤለ ሞርከታ ጎዳይ ኦልዳይሳ ቢታን ደእያ ካዎተት ኡባይ ስእዳ ዎደ ያይዶሶና። <verse eid="2CH 20:29"/><verse number="30" style="v" sid="2CH 20:30"/>ያትድ ፆሳይ እዮሳፈፃስ ኡባ ባጋራ ሸምፖ እምዳ ግሾ እያ ካዎተይ ሳሮተ ደምስ።<verse eid="2CH 20:30"/></para>
  <para style="s1">እዮሳፈፃ ዉርሰ</para>
  <para style="r">(<ref loc="1KI 22:41-50">1 ካዎ 22:41-50</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 20:31"/>እዮሳፈፅ ይሁዳን ካዎትያ ዎደ እያ ላይ ሀስታማነ እቻሻ፤ እ የሩሳላመን ላታማነ እቻሹ ላይ ካዎትስ። እያ አይያ ሽልሀ ናእዉ አዙቦ። <verse eid="2CH 20:31"/><verse number="32" style="v" sid="2CH 20:32"/>እዮሳፈፅ ባ አዋ አሳ ኦግያን ሄመትስ፤ እ ሄ ኦግያፐ ሀድርስ ኡሻች ግቤና፤ ጎዳ ስንን ሱረባ ኦስ። <verse eid="2CH 20:32"/><verse number="33" style="v" sid="2CH 20:33"/>ግዶሽን፥ ቃ ጎይኖ በሳታ ይስቤና፤ አሳይ ቡሮ ባ ኩመ ዎዛናን ባንታ አዋታ ፆሳኮ ስምቤና።<verse eid="2CH 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2CH 20:34"/>እዮሳፈፅ ኦዳባይ ኮይሮፐ ዉርሰ ጋካናዉ እስራኤለ ካዎታ ታርከ ማፃፋን፥ ሀናና ናኣ እዩ ታርከ ማፃፋን ፃፈትስ።<verse eid="2CH 20:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="2CH 20:35"/>እስ ዎደ ይሁዳ ካዎይ እዮሳፈፅ ኢታባ ኦዳ እስራኤለ ካዋ አካዝያሳራ እስፈተ ኦስ። <verse eid="2CH 20:35"/><verse number="36" style="v" sid="2CH 20:36"/>ናምአይ ዛልኤ ማርካበ መናዉ ዞረትዶሶና፤ ኤፅዮን-ጋብራን ማርካበታ መዶሶና። <verse eid="2CH 20:36"/><verse number="37" style="v" sid="2CH 20:37"/>ግዶሽን ማሬሳ አደይ ዶዳ ናአይ አላዛር፥ “ኔኒ አካዝያሳራ እስፈተ መዳ ግሾ ነ ኦዳባ ጎዳይ ይሳና” ያግድ እዮሳፈፃ ቦላ ትንብተ ኦድስ። ሄሳ ግሾ፥ ማርካበት መቅዶሶና፤ ኤንቲ ዛልኤ ኦሱዋ ኦናዉ ዳንዳእቦኮና።<verse eid="2CH 20:37"/></para>
  <chapter eid="2CH 20"/>
  <chapter number="21" style="c" sid="2CH 21"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 21:1"/>ሄሳፈ ጉየ፥ እዮሳፈፅ ሀይቅድ ባ ማይዛታራ ጋሄትስ። ዳዊታ ካታማን ባ ማይዛታ ዱፎን ሞገትስ። እያ በሳን እያ ናአይ እዮራም ካዎትስ።<verse eid="2CH 21:1"/></para>
  <para style="s1">ይሁዳ ካዋ እዮራማ</para>
  <para style="r">(<ref loc="2KI 8:17-24">2 ካዎ 8:17-24</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 21:2"/>እዮራማ እሻት አዛርያሳ፥ ይኤላ፥ ዛካርያሳ፥ አ ዛርያሳ፥ ምካኤላነ ሳፋፃ፤ ሀይሳቲ ይሁዳ ካዋ እዮሳፈፃ ናይታ። <verse eid="2CH 21:2"/><verse number="3" style="v" sid="2CH 21:3"/>ኤንታ አዋይ እዮሳፈፅ ኤንታዉ ዳሮ ብራ፥ ዎርቃ፥ አልኦ ሚሸነ ግምበትዳ ካታማታ እሚስ። ሽን እዮራም እያዉ ባይራ ናአ ግድያ ግሾ ካዎተ እያዉ እሚስ። <verse eid="2CH 21:3"/><verse number="4" style="v" sid="2CH 21:4"/>እዮራም ባ አዋ ካዎተ ኤክድ ምንዳ ዎደ ባ እሻታ ኡባነ እስ እስ እስራኤለ ሀላቃታ ማሻን ዎስ።<verse eid="2CH 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 21:5"/>እዮራም ካዎትያ ዎደ እያዉ ላይ ሀስታማነ ናምአ፤ የሩሳላመን ሆስፑን ላይ ካዎትስ። <verse eid="2CH 21:5"/><verse number="6" style="v" sid="2CH 21:6"/>እዮራም አካባ ናእዉ ኤክዳ ግሾ አካባ ሶ አሳይ ሄመትዳይሳዳ ካሰ እስራኤለ ካዎታ ኦግያን ሄመትስ፤ ጎዳ ስንን ኢታባ ኦስ። <verse eid="2CH 21:6"/><verse number="7" style="v" sid="2CH 21:7"/>ግዶሽን፥ ጎዳይ ካሰ ዳዊታራ ጫቅዳ ጫቁዋ ግሾ ዳዊታ ኮቻ ይሳናዉ ኮይቤና። ዳዊታ ኮቻይ መርናዉ ካዎታና መላ ጎዳይ እያዉ ጫቅስ።<verse eid="2CH 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 21:8"/>እዮራማ ካዎተ ላይን፥ ኤዶመ አሳይ ይሁዳ ካዋ ቦላ ማካልድ ባንታዉ ካዎ ካዎዶሶና። <verse eid="2CH 21:8"/><verse number="9" style="v" sid="2CH 21:9"/>ሄሳ ግሾ፥ እዮራም ቶራ ሞጮናታነ ፓራ ጋረታ ኤክድ ኤዶመ ኦላናዉ ብስ። ኤዶመ አሳይ እያነ እያ ፓራ ጋረታ ሀላቃታ ኦልዶሶና። ሽን እዮራምነ እያ አሳይ ቃማ ደንድድ ባቃትዶሶና። <verse eid="2CH 21:9"/><verse number="10" style="v" sid="2CH 21:10"/>ሄ ዎደፐ ዶምድ ሀች ጋካናዉ ኤዶመ አሳይ ይሁዳ አሳስ ሃረትቦኮና። እዮራም ጎዳ፥ ባ አዋታ ፆሳ አግዳ ግሾ ልብና አሳይ ሄ ዎደ ይሁዳ ካዋ ቦላ ማካልዶሶና።<verse eid="2CH 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 21:11"/>እዮራም ይሁዳ ገዘ ቢታን ቃ ጎይኖ በሳታ ጊግስስ፤ የሩሳላመን አሳ ላይማታና መላ ኦስ፤ ይሁዳ አሳካ ባለስ። <verse eid="2CH 21:11"/><verse number="12" style="v" sid="2CH 21:12"/>ናበይ ኤልያስ እዮራማስ ዳብዳበ ሀይሳዳ ያግድ ፃፍስ፤ “ጎዳይ፥ ነ አዋ ዳዊታ ፆሳይ፥ ‘ኔኒ ነ አዋ እዮሳፈፃ ዎይኮ ይሁዳ ካዋ አሳ ኦግያን ሄመታናይሳ አጋዳ፥ <verse eid="2CH 21:12"/><verse number="13" style="v" sid="2CH 21:13"/>እስራኤለ ካዎታ ኦግያን ሄመታዳሳ። አካባ ሶ አሳይ ኦዳይሳዳ ይሁዳንነ የሩሳላመን ደእያ አሳይ ኤቃ ጎይናና መላ ኦዳሳ። ቃስ ኔፐ ሎእያ፥ ነ አዋ ሶ አሳ፥ ነ እሻታ ዎዳሳ። <verse eid="2CH 21:13"/><verse number="14" style="v" sid="2CH 21:14"/>ሄሳ ግሾ፥ ጎዳይ ነ አሳ፥ ነ ናይታ፥ ነ ማቸታነ ነዉ ደእያ ኡባ ዎልቃማ ጋዶን ሾጫና። <verse eid="2CH 21:14"/><verse number="15" style="v" sid="2CH 21:15"/>ነና ማራጨ ሀርገይ ኦይክን፥ ማራጨይ ካረ ከያና ጋካናዉ ነ ኢታ ሳከታና።’ ”<verse eid="2CH 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 21:16"/>ጎዳይ ፍልስፄመታነ ቶጰ ማታን ደእያ አራበታ እዮራማ ኦላና መላ ደንስ። <verse eid="2CH 21:16"/><verse number="17" style="v" sid="2CH 21:17"/>ኤንቲ ይሁዳ ቦላ ደንድድ ካዎ ጋን ደእያ ሚሸ ኡባ፥ ካዋ አደ ናይታነ እያ ማቸታ ድእዶሶና። ቃስ፥ እያ ናይታ ኡባፈ ካሎ ግድዳ አካዝያሳፐ<note caller="+" style="f"><char style="fr" closed="false">21:17 </char><char style="fq" closed="false">አካዝያሳ፦ </char><char style="ft" closed="false">እያ እብራወ ሱንይ እዮኣሳ ጌተቴስ።</char></note> አትሽን፥ ሀራ እስ ናእካ አትቤና።<verse eid="2CH 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 21:18"/>ሄሳፈ ጉየ፥ ጎዳይ ፓፃናዉ ዳንዳኦና ማራጨ ሀርገን እዮራማ ሾጭስ። <verse eid="2CH 21:18"/><verse number="19" style="v" sid="2CH 21:19"/>ናምኡ ላይ ግዶን ሀርገይ እያ ቦላ ጎብስ፤ እያ ማራጨይ ካረ ከይስ፤ እ ኢታ ሳከትድ ሀይቅስ። እያ ሞግያ ዎደ አሳይ ካሰ ማይዛታስ ኦዳይሳዳ እያ ቦንቾስ ም ዶርድ ታማ ኤቦኮና።<verse eid="2CH 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 21:20"/>እዮራም ካዎትያ ዎደ እያዉ ላይ ሀስታማነ ናምአ፤ እ የሩሳላመን ሆስፑን ላይ ካዎትስ። እ ሀይቅያ ዎደ ኦንካ አዛንቤና። እዮራም ዳዊታ ካታማን ሞገትስፐ አትሽን፥ ካዎታ ዱፎን ሞገትቤና።<verse eid="2CH 21:20"/></para>
  <chapter eid="2CH 21"/>
  <chapter number="22" style="c" sid="2CH 22"/>
  <para style="s1">ይሁዳ ካዋ አካዝያሳ</para>
  <para style="r">(<ref loc="1KI 8:25-29">1 ካዎ 8:25-29</ref>፤ <ref loc="1KI 9:21-28">9:21-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 22:1"/>አራበታራ ይዳ ፓንጋት፥ እዮራማ ባይራ ናይታ ኡባ ዎዳ ግሾ የሩሳላመ አሳይ እዮራማ ናኣ፥ ኡባፈ ካሉዋ፥ አካዝያሳ እያ በሳን ካዎዶሶና። ሄሳ ግሾ፥ እዮራማ ናአይ አካዝያስ ኤንታ ቦላ ካዎ ግድስ። <verse eid="2CH 22:1"/><verse number="2" style="v" sid="2CH 22:2"/>አካዝያስ ካዎትያ ዎደ እያዉ ላይ ላታማነ ናምአ።<note caller="+" style="f"><char style="fr" closed="false">22:2</char><char style="fq" closed="false">ላታማነ ናምአ፦ </char><char style="ft" closed="false">እያዉ ላይ ላታማነ ናምአ ዎይኮ ኦይታማነ ናምአ (2 ካዎ 8:26 ፄላ)።</char></note> እ የሩሳላመን እስ ላይ ካዎትስ፤ እያ አይያ ጎቶላ፥ ዛንብራ ናኣ ናአ።<verse eid="2CH 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 22:3"/>አካዝያስ ኢታተን ባናዳ እያ አይያ ዞርዳ ግሾ እ አካባ ሶ አሳ ኦግያን ሄመትስ። <verse eid="2CH 22:3"/><verse number="4" style="v" sid="2CH 22:4"/>እያ አዋይ ሀይቅዳፐ ጉየ አካባ ሶ አሳይ እያ ዞርያ ግሾ ያና ጋካናዉ አካባ ሶ አሳዳ እካ ጎዳ ስንን ኢታባ ኦስ። <verse eid="2CH 22:4"/><verse number="5" style="v" sid="2CH 22:5"/>አካዝያስ አካባ ሶ አሳ ዞርያ ካልድ፥ አካባ ናኣ፥ እስራኤለ ካዋ እዮራማራ እስፈ ሶረ ካዋ አዛሄላ ኦላናዉ ጋላዳን ደእያ ራሞታ ብስ። ያን ሶረ አሳት እዮራማ ጫድዶሶና። <verse eid="2CH 22:5"/><verse number="6" style="v" sid="2CH 22:6"/>እዮራም፥ ሶረ ካዋ አዛሄላራ ኦለትዳ ኦላን ጫደትዳ ግሾ ፓፃናዉ እዝራኤለ ብስ። እዮራማ ናአይ፥ ይሁዳ ካዎይ፥ አካዝያስ፥ ጫደትዳ አካባ ናኣ እዮራማ፥ ኦይቻናዉ እዝራኤለ ብስ።<verse eid="2CH 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 22:7"/>አካዝያስ እዮራማ ኦይቻናዉ ብዳ ቡሳ፥ ፆሳይ አካዝያሳስ ሀይቆ ጋሶ ኦስ። አካዝያስ እዮራማ ሶ ጋክዳ ዎደ አካባ ኮቻ ይሳና መላ ጎዳይ ዶርዳ፥ ናምሳ ናኣ እዩ፥ ሞካናዉ ናምአይ ከይዶሶና። <verse eid="2CH 22:7"/><verse number="8" style="v" sid="2CH 22:8"/>እዩይ አካባ ኮቻ ቦላ ፕርዳ ፖልያ ዎደ ይሁዳ ሀላቃታነ አካዝያሳ ማድያ እያ ዳቦታ ናይታ ደምድ ዎስ። <verse eid="2CH 22:8"/><verse number="9" style="v" sid="2CH 22:9"/>እዩይ አካዝያሳ ኮይሽን ሳማረን ቆሰትድ ደእያ በሳፈ እዩ አሳት ደምድ እያኮ ኤህድ ዎዶሶና። “ባ ኩመ ዎዛናን ጎዳ ኮይዳ እዮሳፈፃ ናአ” ያግድ ሞግዶሶና።</para>
  <para style="p" vid="2CH 22:9">ሄሳ ግሾ፥ አካዝያሳ ሶ አሳፐ ካዎታናዉ ዳንዳእያ አስ ኦንካ አትቤና።<verse eid="2CH 22:9"/></para>
  <para style="s1">ጎቶሎነ እዮኣሳ</para>
  <para style="r">(<ref loc="2KI 11:1-3">2 ካዎ 11:1-3</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 22:10"/>አካዝያሳ አይያ ጎቶላ ባ ናአይ ሀይቅዳይሳ ስእዳ ዎደ ደንዳዳ ይሁዳ ካዋ ኮቸ ኡባ ይሳሱ። <verse eid="2CH 22:10"/><verse number="11" style="v" sid="2CH 22:11"/>ሽን ካዋ እዮራማ ናእያ ዮሳቤታ ሀይቃናዉ ደእያ ካዎ ናይታ ግዶፈ አካዝያሳ ናኣ እዮኣሳ ካይሳዳ ኤካሱ። እያነ እያ ድችያሮ ቆልአን ቆሳሱ። ሄሳዳ ኦዳ ጎቶላ ዎናዳ ካዋ እዮራማ ናእያ አካዝያሳ ምችያ ካህንያ ዮዳሄ ማችያ ዮሳቤታ እያ ቆሳሱ። <verse eid="2CH 22:11"/><verse number="12" style="v" sid="2CH 22:12"/>ጎቶላ ሃርያ ዎደ ኡባን ናአይ ኤንታ ማታን ፆሳ ኬን ኡሱፑን ላይ ቆሰትድ ደእስ።<verse eid="2CH 22:12"/></para>
  <chapter eid="2CH 22"/>
  <chapter number="23" style="c" sid="2CH 23"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 23:1"/>ላፑን ላይን ዮዳሄይ ምንድ ማቶ ሀላቃታ ይሮሃማ ናኣ አዛርያሳ፥ ይሆና ናኣ ይስማኤላ፥ ኦቤዳ ናኣ አዛርያሳ፥ አዳያ ናኣ ማእሰያነ ዝክራ ናኣ ኤልሳፋፃ ሺሽድ ኤንታራ ጫቅስ። <verse eid="2CH 23:1"/><verse number="2" style="v" sid="2CH 23:2"/>ኤንቲ ይሁዳ ኡባ ብድ ያን ደእያ ሌወታነ እስራኤለ ያራታ ሀላቃታ ኡባ ኤክድ የሩሳላመ ይዶሶና።<verse eid="2CH 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 23:3"/>ሄ ሺቅዳ አሳ ኡባይ ፆሳ ኬን ካዉዋራ ጫቅዶሶና። ዮዳሄይ፥ “ካዋ ናኣ ሀይሳ በእተ! ጎዳይ ካሰ ዳዊታ ኮቻስ ቃላ ገልዳይሳዳ እ ካዎቶ። <verse eid="2CH 23:3"/><verse number="4" style="v" sid="2CH 23:4"/>ህንተ ኦናዉ በሲያባይ ሀይሳ፤ ሳምባታ ጋላስ ፆሳ ኬ ገልያ ካህነታፐነ ሌወታፐ ስኮይ ፐንግያ ናግተ። <verse eid="2CH 23:4"/><verse number="5" style="v" sid="2CH 23:5"/>ቃስ ስኮይ ካዎ ጋ ናግተ፤ ስኮይ ቃስ ባሶ ፐንግያ ናግተ። አሳ ኡባይ ፆሳ ኬ ዳባባን ሺቆ። <verse eid="2CH 23:5"/><verse number="6" style="v" sid="2CH 23:6"/>ኦያ ካህነታፐነ ሌወታፐ አትሽን፥ ኦንካ ፆሳ ኬ ገሎፖ። ኤንቲ ጌሽ ግድያ ግሾ ገሎና፤ ሽን ሀራ አሳ ኡባይ ጎዳ ኪታ ናግሸ ፆሳ ኬፈ ካረራ ደኦ።<verse eid="2CH 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 23:7"/>“ሌወት ኦላ ሚሸ ባንታ ኩሸን ኩሸን ኦይክድ ካዋ ግዶይድ እ ከይያ ዎደነ ገልያ ዎደ እያራ ግዶ። ፆሳ ኬ ገልያ ኦንካ ሀይቆ” ያግስ።<verse eid="2CH 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 23:8"/>ሌወትነ ይሁዳ አሳ ኡባይ ካህነይ ዮዳሄይ ኪትዳ ኡባ ኦዶሶና። ካህነይ ዮዳሄይ ኦሶፐ ከያናዉ በሲያ ሌወታ ከስድ የድቦና ግሾ፥ እሶይ እሶይ ሳምባታ ጋላስ ኦሶ ገለይሳታነ ኦሶፐ ከይያ ባ አሳ ኤክስ። <verse eid="2CH 23:8"/><verse number="9" style="v" sid="2CH 23:9"/>ካህነይ ዮዳሄይ ፆሳ ኬን ደእያ፥ ካዋ ዳዊታ ቶራ፥ ግታነ ጉ ጎንዳለታ ቶራ ሞጮናታስ እሚስ። <verse eid="2CH 23:9"/><verse number="10" style="v" sid="2CH 23:10"/>ካህነይ ዮዳሄይ አሳ ኡባይ ኦላ ሚሸ ባ ኩሸን ኩሸን ኦይክድ ፆሳ ኬ ዱገሀፐ ፑደሀ ጋካናዉ ያርሾ በሳ ማታንነ ፆሳ ኬ ማታን ካዋ ዩሾን ኤቃናዳ ኦስ። <verse eid="2CH 23:10"/><verse number="11" style="v" sid="2CH 23:11"/>ዮዳሄ ካዋ ናኣ እዮኣሳ ካረ ከስድ፥ እያ ሁጰን ካላቻ ዎስ፤ ካዎታ ህገ ማፃፋ እያዉ እምድ ካዎይስ። ዮዳሄይነ እያ ናይት እዮኣሳ ትይድ፥ “ካዎይ ብራታ ቱሱ ግዶ” ያግዶሶና።<verse eid="2CH 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 23:12"/>አሳይ የፅሸነ ካዋ ሳቢሸ ኡፋይተይሳ ጎቶላ ስእዳ ዎደ አሳኮ ፆሳ ኬ ባሱ። <verse eid="2CH 23:12"/><verse number="13" style="v" sid="2CH 23:13"/>ካዎይ ፐንገን ቱሳ ማታን ኤቅዳይሳ በአሱ። ሀላቃትነ ዛየ ፑነይሳት ካዋ ማታን ደኦሶና፤ ይሁዳ አሳ ኡባይ ኡፋይትሸ ዛየ ፑኖሶና፤ ማዝሙረ የፀይሳት ስን አድ ባንታ የ ሚሸን ጋላቶሶና። ጎቶላ ባ ማኡዋ ፔዳ፥ “ሀይስ ጌላተ! ሀይስ ጌላተ!” ያጋዳ ዋሳሱ።<verse eid="2CH 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 23:14"/>ካህነይ ዮዳሄይ ቶራ ሞጮናታኮ፥ “ጎቶላ ፆሳ ኬን ዎፕተ፤ እዮ ሳልፕያ ግዶራ አድ ካረ ከስተ፤ እዮ አሻናዉ ኮይያ አስ ደእኮ ዎተ!” ያግስ። <verse eid="2CH 23:14"/><verse number="15" style="v" sid="2CH 23:15"/>ሄሳ ግሾ፥ ኤንቲ እዮ ኦይክድ ካዎ ጋ ኤፍድ ፓራ ፐንገን እዮ ዎዶሶና።<verse eid="2CH 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 23:16"/>ካህነይ ዮዳሄይ ባ ሁጰን፥ አሳ ኡባይነ ካዎይ፥ ጎዳ አስ ግዳናዉ ጫቅዶሶና። <verse eid="2CH 23:16"/><verse number="17" style="v" sid="2CH 23:17"/>ሄ ዎደ አሳ ኡባይ ባኣለ ኤቃ ኬ ብድ፥ ኬ ላልድ፤ ያርሾ በሳታነ ምስለታ ትንቸረዶሶና። ማታና ጌተትያ ባኣላ ካህንያ ያርሾ በሳታ ስንን ዎዶሶና።<verse eid="2CH 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 23:18"/>ዮዳሄይ ካህነታነ ሌወታ ፆሳ ኬ ኦሱዋስ ሀላቃ ኦድ ሹምስ። ኤንታ ኦሶይ ሙሰ ህግያን ፃፈትዳይሳዳነ ካዎይ ዳዊቲ ኦድዳይሳዳ ያርሾ ያርሻናይሳ። ቃስ ካዎይ ዳዊቲ ኦድዳይሳዳ ማዝሙረ የፅሸ ቦንቻናይሳ። <verse eid="2CH 23:18"/><verse number="19" style="v" sid="2CH 23:19"/>ህግያን ፃፈትዳይሳዳ ቱና አስ ገሎና መላ ዮዳሄይ ፆሳ ኬ ፐንገን ናገይሳታ ዎስ።<verse eid="2CH 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 23:20"/>ዮዳሄይ ቶራ ሞጮናታ፥ ግታ አሳታ፥ ደርያ ሃረይሳታነ ሄ ቢታ አሳ ኡባ ኤክድ ካዋ ፆሳ ኬፈ ዱገ ኤህስ። ቆሞ ባጋ ፐንገራ ካዎ ጋ ገልድ ካዋ አራታ ቦላ ኡትስዶሶና። <verse eid="2CH 23:20"/><verse number="21" style="v" sid="2CH 23:21"/>ይሁዳ አሳ ኡባይ ኡፋይትስ። ጎቶላ ማሻን ሀይቅዳፐ ጉየ ካታማይ ዎፑ ግስ።<verse eid="2CH 23:21"/></para>
  <chapter eid="2CH 23"/>
  <chapter number="24" style="c" sid="2CH 24"/>
  <para style="s1">ይሁዳ ካዋ እዮኣሳ</para>
  <para style="r">(<ref loc="1KI 12:1-16">1 ካዎ 12:1-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 24:1"/>እዮኣስ ካዎትያ ዎደ እያዉ ላይ ላፑና፤ እ የሩሳላመን ኦይታሙ ላይ ካዎትስ። እያ አየ ሱንይ ሳቦ፤ እያ በርሳበ ማጫስ። <verse eid="2CH 24:1"/><verse number="2" style="v" sid="2CH 24:2"/>ካህነይ ዮዳሄይ ደእዳ ላይ ኡባን እዮኣስ ጎዳ ስንን ሱረባ ኦስ። <verse eid="2CH 24:2"/><verse number="3" style="v" sid="2CH 24:3"/>ዮዳሄይ ካዋ እዮኣሳስ ናምኡ ማቾ እምን ኤንቲ እያዉ አደ ናይታነ ማጫ ናይታ የልዶሶና።<verse eid="2CH 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 24:4"/>ጉ ዎደፐ ጉየ እዮኣስ ፆሳ ኬ ኦራናዉ ቆፕስ። <verse eid="2CH 24:4"/><verse number="5" style="v" sid="2CH 24:5"/>እዮኣስ ካህነታነ ሌወታ ሺሽድ፥ “ይሁዳ ብድ ህንተ ፆሳ ኬ ላይን ላይን ኦራናዉ እስራኤለ ኡባፈ ሚሸ ሺሽተ፤ ሄሳ ሀእ ኤለስድ ኦተ” ያግስ። ሽን ሌወት ኤለስድ ኦቦኮና። <verse eid="2CH 24:5"/><verse number="6" style="v" sid="2CH 24:6"/>ሄሳ ግሾ፥ ካዎይ ካህነ ሀላቃ ዮዳሄ ፄግድ፥ “ጎዳ አይለይ ሙሰይነ የሩሳላመ አሳይ ፆሳ ዱንካንያ ኦሱዋስ ከሳና መላ ኪትዳ ጊራ የሩሳላመፐነ ይሁዳፐ ሺሻና መላ ሌወታ አይስ ኪታብኪ?” ያግስ። <verse eid="2CH 24:6"/><verse number="7" style="v" sid="2CH 24:7"/>ሄ ዎደ ኢታ ማጫሰ ጎቶላ ናይት ፆሳ ኬ መንዶሶና። ኤንቲ ጎዳ ኬን ደእያ ጌሻ ሚሸ ኡባ ኤክድ ባኣለ ጎይናናዉ ጎኤትዶሶና።<verse eid="2CH 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 24:8"/>ካዎይ ሌወታ ኪትን፥ ኤንቲ ሳፅነ ጊግስድ፥ ፆሳ ኬ ፐንግያፈ ካረ ባጋራ ዎሶና። <verse eid="2CH 24:8"/><verse number="9" style="v" sid="2CH 24:9"/>ፆሳ አይለይ ሙሰይ መላ ቢታን ደእሸ፥ እስራኤለ አሳፐ ሺሻና መላ ኪትዳ ጊራ ጎዳስ ኤሀና መላ ይሁዳንነ የሩሳላመን ሌወት አዋጅዶሶና። <verse eid="2CH 24:9"/><verse number="10" style="v" sid="2CH 24:10"/>ሀላቃትነ አሳ ኡባይ ኡፋይትድ ሳፅነይ ኩማና ጋካናዉ ጊራ የግዶሶና። <verse eid="2CH 24:10"/><verse number="11" style="v" sid="2CH 24:11"/>ሳፅነይ ሌወታ ባጋራ ካዎ ሞርናታኮ ጋክን ሳፅንያ ግዶን ዳሮ ሚሸይ ዳጋየትዳይሳ በእዳ ዎደ ኡባን ካዎ ፃፈይነ ካህነ ሀላቃይ ይድ ሳፅንያፐ ሚሸ ከስድ ሳፅንያ በሳን ዛር ዎሶና። ኤንቲ ኡባ ዎደ ሄሳ ኦድ ዳሮ ሚሸ ዳጋይዶሶና።<verse eid="2CH 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 24:12"/>ሄ ሚሽያ ካዎይነ ዮዳሄይ ፆሳ ኬ ኦሱዋ ኦና መላ ሹመትዳ አሳታስ እሞሶና። ኤንቲ ፆሳ ኬ ኦራናዉ ሹቹ ማሰይሳታ፥ አናፀታ፥ ብራታነ ናሰ ብራታ ኦሳንቾታ ቃፃርዶሶና። <verse eid="2CH 24:12"/><verse number="13" style="v" sid="2CH 24:13"/>ኦሳንቾት ፆሳ ኬ ምን ኦድ ካሰይሳዳ ኦራዶሶና። <verse eid="2CH 24:13"/><verse number="14" style="v" sid="2CH 24:14"/>ፆሳ ኬ ኦራ ኦሶይ ዉርዳ ዎደ ፓላህዳ ዎርቃነ ብራ ካዋኮነ ዮዳሄኮ ኤህዶሶና። ኤንቲ ሄ ዎርቃነ ብራ ፆሳ ኬ ጋ ኦሱዋስ ጎኤትያ ሚሸታ፥ ፁሳ ያርሾስ ሀንያ ሳነታነ ሀራ ዱማ ዱማ ሚሸታ ኦዶሶና።</para>
  <para style="p" vid="2CH 24:14">ዮዳሄይ ደእዳ ላይን ኡባን ፆሳ ኬን ፁሳ ያርሾይ ያርሸቴስ።<verse eid="2CH 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 24:15"/>ዮዳሄይ ዳሮ ጭምድ ሀይቅስ፤ እ ሀይቅያ ዎደ እያዉ ላይ ፄታነ ሀስታማ። <verse eid="2CH 24:15"/><verse number="16" style="v" sid="2CH 24:16"/>ዮዳሄይ እስራኤለን ፆሳስነ ፆሳ ኬስ ሎኦባ ኦዳ ግሾ ዳዊታ ካታማን ካዎታ ዱፎን እያ ሞግዶሶና።<verse eid="2CH 24:16"/></para>
  <para style="s1">እዮኣሳ ኢታተ</para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 24:17"/>ዮዳሄይ ሀይቅዳፐ ጉየ ይሁዳ ሀላቃት ይድ ካዋ ስንን ጉፋንዶሶና፤ ካዎይ ኤንታ ኦይሻ ስእስ። <verse eid="2CH 24:17"/><verse number="18" style="v" sid="2CH 24:18"/>ኤንቲ ጎዳ ባንታ ማይዛታ ፆሳ ኬ አግድ፥ አሼር ምስለታነ ኤቃታ ጎይንዶሶና። ኤንቲ ቆሁዋ ግሾ ይሁዳ ቦላነ የሩሳላመ ቦላ ጎዳ ሀንቆይ ዎስ። <verse eid="2CH 24:18"/><verse number="19" style="v" sid="2CH 24:19"/>ኤንታ ዛራና መላ ጎዳይ ናበታ ኤንታኮ ኪትስ። ናበት ኤንታዉ ማርካትዶሶና፤ ሽን ኤንቲ ስኦና እፅዶሶና።<verse eid="2CH 24:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 24:20"/>ሄሳፈ ጉየ፥ ካህንያ ዮዳሄ ናኣ ዛካርያሳ ቦላ ፆሳ አያናይ ዎን ዛካርያስ አሳ ስንን ኤቅድ፥ “ፆሳይ፥ ‘ህንተ ጎዳ ኪታ አይስ መንቲ? ሄስ ህንተዉ ኢታ። ህንተ ጎዳ አግዳ ግሾ እካ ህንተና አግስ’ ” ያጌስ። <verse eid="2CH 24:20"/><verse number="21" style="v" sid="2CH 24:21"/>ኤንቲ እያ ቦላ ማቀትዶሶና። ካዎይ ኤንታ ኪትን፥ ፆሳ ኬ ዳባባን፥ እያ ሹቻን ጫድድ ዎዶሶና። <verse eid="2CH 24:21"/><verse number="22" style="v" sid="2CH 24:22"/>ካዎይ እዮኣስ ዛካርያሳ አዋይ ዮዳሄይ እያዉ ኦዳ ኬሀተ ሀሳዮና አግድ እያ ናኣ ዛካርያሳ ዎስስ። ዛካርያስ ሀይቅሸ፥ “ጎዳይ ሀይሳ በኦ፤ እ ሀሎ ከዮ” ያግስ።<verse eid="2CH 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 24:23"/>ላይ ላመን፥ ሶረ ኦላንቾት እዮኣሳ ኦላናዉ ይዶሶና። ይሁዳነ የሩሳላመ ኦልድ ሀላቃታ ኡባ ዎድ፥ ድኡዋ ኤክድ ዳማስቆን ደእያ ባንታ ካዋስ የድዶሶና። <verse eid="2CH 24:23"/><verse number="24" style="v" sid="2CH 24:24"/>ሶረ ኦላንቾት ታይቦን ጉ፤ ሽን ይሁዳ አሳይ ጎዳ ባንታ አዋታ ፆሳ አግዳ ግሾ፥ ጎዳይ ዳሮ ግድዳ ኤንታ ኦላንቾታ ሶረ ኦላንቾታ ኩሸን አድ እሚስ። ኤንቲ ሀይሳዳ ኦድ እዮኣሳ ቦላ ፕርድዶሶና።<verse eid="2CH 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 24:25"/>ሶረ ኦላንቾት እያፐ ሻከትያ ዎደ እዮኣስ ዳሮ ማዱንፅድ ደኤስ። ካህንያ ዮዳሄ ናኣ ሱ ግሾ እያ ሹማት እያ ቦላ ማቀትድ፥ እ ባ ሂፃን ዝንእዳሽን ዎዶሶና። እ ሀይቅን ዳዊታ ካታማን ሞግዶሶና፤ ሽን ካዎታ ዱፎን እያ ሞግቦኮና። <verse eid="2CH 24:25"/><verse number="26" style="v" sid="2CH 24:26"/>እዮኣሳ ቦላ ማቀትዳይሳት አሞነ ማጫሰ ስማት ናኣ ዛባዳነ ሞአበ ማጫሰ ስማርት ናኣ ዮዛባታ። <verse eid="2CH 24:26"/><verse number="27" style="v" sid="2CH 24:27"/>ሄኮ፥ እዮኣሳ አደ ናይታ ታርከይ፥ እያዉ ኦደትዳ ትንብተይነ እ ፆሳ ኬ ኦራዳባይ ካዎታ ታርከ ማፃፋን ፃፈትድ ደኤስ። እዮኣስ ሀይቅን እያ በሳን እያ ናአይ አማስያስ ካዎትስ።<verse eid="2CH 24:27"/></para>
  <chapter eid="2CH 24"/>
  <chapter number="25" style="c" sid="2CH 25"/>
  <para style="s1">ይሁዳ ካዋ አማስያሳ</para>
  <para style="r">(<ref loc="2KI 14:2-6">2 ካዎ 14:2-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 25:1"/>አማስያስ ካዎትያ ዎደ እያዉ ላይ ላታማነ እቻሻ፤ እ የሩሳላመን ላታማነ ኡዱፉን ላይ ካዎትስ። እያ አየ ሱንይ ዮኣዶ፤ እያ የሩሳላመ ማጫስ። <verse eid="2CH 25:1"/><verse number="2" style="v" sid="2CH 25:2"/>አማስያስ ጎዳ ስንን ሱረባ ኦስ፤ ግዶሽን፥ ኩመ ዎዛናፐ ግደና። <verse eid="2CH 25:2"/><verse number="3" style="v" sid="2CH 25:3"/>አማስያስ ካዎተ ምንዳፐ ጉየ ባ አዋ ዎዳ አሳታ ዎስ። <verse eid="2CH 25:3"/><verse number="4" style="v" sid="2CH 25:4"/>ግዶሽን፥ ኤንታ ናይታ ዎቤና። ኤንታ ናይታ ዎና አግዳ ጋሶይ፥ ጎዳይ፥ ሙሰ ህገ ማፃፋን ኪትዳይሳዳ፥ “ናይት ኦዳ ናጋራ ግሾ አዋታ ዎናዉ በሰና፤ አዋት ኦዳ ናጋራ ግሾ ናይታ ዎናዉ በሰና። አስ ኡባይ ባ ኦዳ ናጋራን ናጋራን ሀይቃናዉ በሴስ” ያግዳ ግሾሳ።<verse eid="2CH 25:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 25:5"/>አማስያስ ይሁዳ አሳ ሺሽድ ባንታ አዋታ ኬን ኬን ሻላቃታነ ማቶ ሀላቃታ ሹምስ። እ ላታሙ ላይነ እያፐ ቦላ ግድዳ ይሁዳ ኮቻታነ ብንያመ ኮቻታ ኡባ ታይብድ ጎንዳለነ ቶራ ኦይክድ ኦላስ ጊግዳ ሄ ፄቱ ሙኩሉ ዶረትዳ አሳታ ደምስ። <verse eid="2CH 25:5"/><verse number="6" style="v" sid="2CH 25:6"/>እስራኤለፐ እስ ፄቱ ሙኩሉ ምኖ አሳታ ሄ ሙኩሉነ ኦይዱ ፄቱ ክሎ ግራመ ብራን አማስያስ ሻምስ። <verse eid="2CH 25:6"/><verse number="7" style="v" sid="2CH 25:7"/>ሽን እስ ፆሳ አስ እያኮ ይድ፥ “ካዋዉ፥ ጎዳይ እስራኤለራነ ኤፍሬማራ ዶና ግሾ፥ እስራኤለ ኦላንቾት ኔራ ቦፖ። <verse eid="2CH 25:7"/><verse number="8" style="v" sid="2CH 25:8"/>ኤንቲ ታና ምንና ጋዳ ነ ቆፕኮ፥ ፆኖይነ ፆነተ ፆሳባ ግድያ ግሾ ፆሳይ ነና ነ ሞርከታ ስንን ካዉሻና። ግዶሽን፥ ነ ፃላላ ባ፤ ምናዳ ኦለታ” ያግስ።<verse eid="2CH 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 25:9"/>አማስያስ ፆሳ አድያኮ፥ “ታኒ እስራኤለ ኦላንቾታስ ቃንፅዳ ብራይ ኡባይ ዋናኔ?” ያግስ።</para>
  <para style="p" vid="2CH 25:9">ፆሳ አደይ፥ “ጎዳይ ነዉ ሄሳፈ አድ እማናዉ ዳንዳኤስ” ያግስ። <verse eid="2CH 25:9"/><verse number="10" style="v" sid="2CH 25:10"/>ሄሳ ግሾ፥ አማስያስ ኤፍሬማፐ ይዳ ኦላንቾት ባንታ ሶ ሶ ባና መላ ኦስ። ኤንቲ ይሁዳ አሳ ቦላ ዳሮ ሀንቀትሸ ባንታ ሶ ሶ ስምዶሶና።<verse eid="2CH 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 25:11"/>ሄሳፈ ጉየ፥ አማስያስ ባና ምንድ፥ ባ ኦላንቾታ ካለድ፥ ማፅነ ዛንጋራ ብን እያ ኦላንቾት ሳይረፐ ታሙ ሙኩሉ አሳ ዎዶሶና። <verse eid="2CH 25:11"/><verse number="12" style="v" sid="2CH 25:12"/>ሀራ ታሙ ሙኩሉ ኦላንቾታ ፓፃ ድእድ፥ ኤንታ አፎ ዶና ኤፍድ፥ አፉዋን ዱገ ሆልን፥ ጋርሳን ደእያ ሹቻን አሳ ኡባይ መቀረትድ ዉርዶሶና። <verse eid="2CH 25:12"/><verse number="13" style="v" sid="2CH 25:13"/>ሽን ሄ ዎደ አማስያስ ባራ ኦላስ ቦና መላ ጉየ ዛርዳ እስራኤለ ኦላንቾት ሳማረፐ ቤት-ሆሮና ጋካናዉ ደእያ ይሁዳ ካታማታ ኦልዶሶና። ኤንቲ ይሁዳ አሳፐ ሄ ሙኩሉ ዎድ ዳሮ ድኦ ኤክዶሶና።<verse eid="2CH 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 25:14"/>አማስያስ ኤዶመታ ዎድ ስምያ ዎደ ኤንታ ኤቃታ ኤክድ ይስ። ኤንታ ፆሰ ኦ ኤስድ ኤንታ ጎይንስ፤ እፃነ ጩይስስ። <verse eid="2CH 25:14"/><verse number="15" style="v" sid="2CH 25:15"/>ጎዳ ሀንቆይ አማስያሳ ቦላ ኤፅን፥ ጎዳይ አማስያሳኮ ናበ ኪትስ። ሄ ናበይ ብድ፥ “ባንታ አሳ ነ ኩሸፐ አሻናዉ ዳንዳእቦና ፆሳታ አይስ ዞረ ኦይቻዲ?” ያግስ።<verse eid="2CH 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 25:16"/>ናበይ ቡሮ ኦዳ ቦላ ደእሽን ካዎይ፥ “ነና ካዎ ዞርያ አስ ኦዳይ ኦኔ? ስእ ጋ! ነ አይስ ሀይቃናዉ ኮያይ?” ያግስ።</para>
  <para style="p" vid="2CH 25:16">ናበይ ኦዳ ኤስድ፥ “ነ ሀይሳ ኦዳ ግሾነ ታ ዞርያ ስኦና እፅዳ ግሾ ፆሳይ ነና ይሳናዉ ቆፕዳይሳ ሀእ ኤራስ” ያግስ።<verse eid="2CH 25:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 25:17"/>ሄሳፈ ጉየ፥ ይሁዳ ካዎይ አማስያስ ባና ዞርያ አሳታራ ዞረትድ፥ እስራኤለ ካዋ እዩ ናኣ ናኣ፥ እዮአካዛ ናኣ፥ እዮኣሳኮ አሰ ኪትድ፥ “ሃያ፤ አነ ናምአይ ኦላ ጋሄቶስ” ያግድ ማንድስ።<verse eid="2CH 25:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 25:18"/>እስራኤለ ካዎይ እዮኣስ ይሁዳ ካዋ አማስያሳኮ ሀይሳዳ ያግስ፤ “ልባኖሰን ደእያ ክንቾተይ ልባኖሰን ደእያ ዝጋኮ ኪታ የድድ፥ ‘ነ ናእዉ ታ ናኣስ እማ’ ያግስ። ሽን ልባኖሰን ደእያ እስ ዶእ ያራ አሸ ክንቾትያ የስ። <verse eid="2CH 25:18"/><verse number="19" style="v" sid="2CH 25:19"/>‘ታኒ ኤዶመ ፆናስ’ ጋዳ ነ ዎዛናን ኦቶሮን ኩማዳሳ። ሽን ሀእ ነ ሶን ዎፑ ጋዳ ኡታ፤ ነ ቦላነ ይሁዳ ቦላ መቶነ ዮ ኤሀናዉ አይስ ደንይ?” ያግድ ዛርስ።<verse eid="2CH 25:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 25:20"/>ሽን አማስያስ ስኦና እፅስ። ኤንቲ ኤዶመ ፆሳታ ጎይንዳ ግሾ ፆሳይ ኤንታ፥ ኤንታ ሞርከታ ኩሸን አድ እማናዉ ኮይስ። <verse eid="2CH 25:20"/><verse number="21" style="v" sid="2CH 25:21"/>ሄሳ ግሾ፥ እስራኤለ ካዎይ እዮኣስ ኦላናዉ ከይን እነ ይሁዳ ካዎይ አማስያስ ይሁዳን ደእያ ቤት-ሳሜሳን ኦላ ጋሄትዶሶና። <verse eid="2CH 25:21"/><verse number="22" style="v" sid="2CH 25:22"/>ይሁዳ አሳይ ፆነትዶሶና፤ ይሁዳ አሳ ኡባይ ባቃትድ ባንታ ሶ ሶ ብዶሶና። <verse eid="2CH 25:22"/><verse number="23" style="v" sid="2CH 25:23"/>ካዎይ እዮኣስ አካዝያሳ ናኣ ናኣ፥ እዮኣሳ ናኣ፥ ይሁዳ ካዋ አማስያሳ ቤት-ሳሜሳን ድእድ፥ የሩሳላመ ኤህስ። ኤፍሬማ ድርሳ ፐንግያፈ ብድ ማዛነ ፐንግያ ጋካናዉ ደእያ ኦይዱ ፄቱ ዋ ግድያ የሩሳላመ ድርሳ ግምብያ ላልስ። <verse eid="2CH 25:23"/><verse number="24" style="v" sid="2CH 25:24"/>ፆሳ ኬን ደእያ ዎርቃነ ብራ ኡባ፥ ኦቤድ-ኤዶመይ ናግያ ሚሽያነ ካዎ ጋን ደእያ ሚሽያ ኡባ ኤክስ፤ ቃስ ኦይ ኦድ ኦይክዳ አሳታ ኤክድ ሳማረ ስምስ።<verse eid="2CH 25:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 25:25"/>እዮአካዛ ናአይ፥ እስራኤለ ካዎይ እዮኣስ ሀይቅዳፐ ጉየ እዮኣሳ ናአይ፥ ይሁዳ ካዎይ አማስያስ ታማነ እቻሹ ላይ ደእስ። <verse eid="2CH 25:25"/><verse number="26" style="v" sid="2CH 25:26"/>አማስያስ ኦዳባ ኡባይ ኮይሮፐ ዉርሰ ጋካናዉ ይሁዳ ካዎታነ እስራኤለ ካዎታ ታርከ ማፃፋን ፃፈትድ ደኤስ ግደኔ? <verse eid="2CH 25:26"/><verse number="27" style="v" sid="2CH 25:27"/>አማስያስ ጎዳ ካሎ አግዳፐ ጉየ ኤንቲ እያ ቦላ የሩሳላመን ማቀትዶሶና። እ ላክሶ ባቃትስ። ሽን ኤንቲ እያ ጌዶ አሰ ኪትን ኤንቲ እያ ያን ዎዶሶና። <verse eid="2CH 25:27"/><verse number="28" style="v" sid="2CH 25:28"/>እያ አሀ ፓራን ጫን ኤህድ፥ ዳዊታ ካታማን እያ ማይዛታራ ሞግዶሶና።<verse eid="2CH 25:28"/></para>
  <chapter eid="2CH 25"/>
  <chapter number="26" style="c" sid="2CH 26"/>
  <para style="s1">ይሁዳ ካዋ ኦዝያና</para>
  <para style="r">(<ref loc="2KI 14:21-22">2 ካዎ 14:21-22</ref>፤ <ref loc="2KI 15:1-7">15:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 26:1"/>ሄሳፈ ጉየ፥ ይሁዳ አሳ ኡባይ ታማነ ኡሱፑን ላይ ግድዳ ኦዝያና እያ አዋ አማስያሳ በሳን ካዎዶሶና። <verse eid="2CH 26:1"/><verse number="2" style="v" sid="2CH 26:2"/>እያ አዋይ አማስያስ ሀይቅዳፐ ጉየ እ ኤሎታ ካታማ ዛር ኬፅስ።<verse eid="2CH 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 26:3"/>ኦዝያን ካዎትያ ዎደ እያዉ ላይ ታማነ ኡሱፑና፤ እ የሩሳላመን እሻታማነ ናምኡ ላይ ካዎትስ። እያ አየ ሱንይ ይኮሎ፤ እያ የሩሳላመ ማጫስ። <verse eid="2CH 26:3"/><verse number="4" style="v" sid="2CH 26:4"/>እያ አዋይ አማስያስ ኦዳይሳዳ እካ ጎዳ ስንን ሱረባ ኦስ። <verse eid="2CH 26:4"/><verse number="5" style="v" sid="2CH 26:5"/>ፆሳስ ያሽ ታማርስዳ ዛካርያሳ ዎደ እ ፆሳስ አማነትድ ኦስ። ጎዳ እ ኮይዳ ዎደ ኡባን ፆሳይ እያ አንጅስ።<verse eid="2CH 26:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 26:6"/>ኦዝያን ፍልስፄመታራ ኦለታናዉ ከይድ ጋተ ካታማነ እያ ሄራ፥ ያብና ካታማነ እያ ሄራነ አሽዶዳ ካታማነ እያ ሄራ ላልስ። ያትድ አሽዶዳ ካታማ ማታንነ ፍልስፄመ ግዶን ካታማታ ኬፅስ። <verse eid="2CH 26:6"/><verse number="7" style="v" sid="2CH 26:7"/>ፆሳይ ኦዝያናስ ፍልስፄመታ፥ ጉርባላን ደእያ አራበታነ ማኡነታ ቦላ ፆኖ እሚስ። <verse eid="2CH 26:7"/><verse number="8" style="v" sid="2CH 26:8"/>አሞነት ኦዝያናስ ጊርዶሶና። ኦዝያን ዳሮ ምንዳ ግሾ እያ ሱንይ ግብፀ ዛዋ ጋካናዉ ከይስ።<verse eid="2CH 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 26:9"/>ኦዝያን ማዛነ ፐንግያ ማታን፥ ዛንጋራ ፐንግያ ማታንነ ድርሳ ማዛንያ ማታን አዱሳ ግምበ ሻኮታ ኤስድ፥ የሩሳላመ ባሱዋ ምንስ። <verse eid="2CH 26:9"/><verse number="10" style="v" sid="2CH 26:10"/>እያዉ ዙማ ፃጶንነ ደንባን ዳሮ መሄይ ደእያ ግሾ ሄ በሳታን አዱሳ ግምበ ሻኮታ ግምብድ ዳሮ ሃ ኦላታ ቦክስ። እ ጎሸ ዶስያ ግሾ ደረ ቦላነ አራዳ ቢታን እያዉ ዳሮ ጎሻንቾትነ ዎይነይ ቶከይሳት ደኦሶና።<verse eid="2CH 26:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 26:11"/>ኦዝያናስ ኦላስ ጊግዳ ዳሮ ኦላንቾት ደኦሶና። ኦላንቾታ ፃፈይ ይኤልነ ሀላቃይ ማእሰይ ኦላንቾታ ሱን ማዝጋበን ፃፍዶሶና። ኤንታ ሀላቃይ ሀናና። <verse eid="2CH 26:11"/><verse number="12" style="v" sid="2CH 26:12"/>ባንታ አዋታ ሶ አሳ ቦላ ሀላቃትያ ምኖ አሳት ናምኡ ሙኩሉነ ኡሱፑን ፄታ። <verse eid="2CH 26:12"/><verse number="13" style="v" sid="2CH 26:13"/>ካዋ ሞርከታራ ኦለትድ፥ ባንታ ኩመ ዎልቃን ካዋ ማዳናዉ ከይያ ሄ ፄታነ ላፑን ሙኩሉነ እቻሹ ፄቱ ኦላንቾት ኤንታ ጋርሳን ደኦሶና። <verse eid="2CH 26:13"/><verse number="14" style="v" sid="2CH 26:14"/>ኦዝያን ኦላንቾታ ኡባስ ጎንዳለ፥ ቶራ፥ ብራታ ባርኔፃ፥ ትራን ማእያ ፁሩረ፥ ዶንገነ ያምባርሻ ሹቹ ጊግስስ። <verse eid="2CH 26:14"/><verse number="15" style="v" sid="2CH 26:15"/>ኦዝያን የሩሳላመን ደእያ ሂላንቾት ዎችያ አዱሳ ግምበ ሻኮታነ ካታማ ድርሳ ግምበ ማዛነታ ቦላ ዶንገ ዱክያ ሚሸታነ ግታ ግታ ሹቻታ ፕፅርድ ሆልያ ሚሸታ ኦስስስ። ፆሳይ እያ ማድን እ ዳሮ ምንስ፤ እያ ሱንይ ኡባ በሳን ከይስ።<verse eid="2CH 26:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 26:16"/>ሽን ኦዝያን ምንዳ ዎደ ኦቶርትስ፤ ኦቶሮይ እያ ኩንደስ ጋስ። ኦዝያን ጎዳ ባ ፆሳ አማነቶና እፅድ እፃነ ጩይስያ በሳን እፃነ ጩይሳናዉ ፆሳ ኬ ገልስ። <verse eid="2CH 26:16"/><verse number="17" style="v" sid="2CH 26:17"/>ካህነይ አዛርያስነ ምኖ ግድዳ ሆስፑን ታሙ ጎዳ ካህነት እያ ካልድ ገልዶሶና። <verse eid="2CH 26:17"/><verse number="18" style="v" sid="2CH 26:18"/>ካህነት እያኮ፥ “ኦዝያና፥ ኔኒ ጎዳስ እፃነ ጩይሳናዉ በሳካ። እፃነ ጩይሳናዉ በሰይ፥ ጌይድ ደእያ አሮና ኮቸ ግድዳ ካህነት ፃላላ። ሀ ጌሻ በሳፈ ከያ! ኔኒ ጎዳ ፆሳ ቦላ ናጋራ ኦዳሳ፤ ኔኒ እያፐ ቦንቾ ደማካ” ያግዶሶና።<verse eid="2CH 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 26:19"/>ግዶሽን፥ እፃነ ጩይሳናዉ ባ ኩሸን እፃነ ጩይስያ ሚሸ ኦይክድ ደእሸ ሀንቀትስ። ኦዝያን ካህነታ ሀንቀትሸ ፆሳ ኬን እፃነ ጩይስያ በሳ ማታን ካህነታ ስንን ኤቅዳሽን፥ እያ ሶምኦን ባሮ ሀርገይ በንትስ። <verse eid="2CH 26:19"/><verse number="20" style="v" sid="2CH 26:20"/>ካህነ ሀላቃይ አዛርያስነ ሀራ ካህነት ኡባይ እያ ፄልያ ዎደ እያ ሶምኦን ባሮ ሀርገይ በንትዳይሳ በእድ፥ ኤለስድ እያ ፆሳ ኬፈ ከስዶሶና። እካ ጎዳይ እያ ሴርዳይሳ ኤርዳ ግሾ ኤለስድ ያፐ ከይድ ብስ። <verse eid="2CH 26:20"/><verse number="21" style="v" sid="2CH 26:21"/>ካዎይ ኦዝያን ሀይቃና ጋካናዉ ሄ ሀርግያራ ደእስ፤ ፆሳ ኬ ገሎና መላ ድገትስ። ሄ ሀርግያ ጋሶን ዱማ ኬን ባርካ ደእስ። ሄ ዎደ እያ ናአይ እዮአታም፥ ካዎ ጋ አዋተን ኦይክድ ቢታ ሃሬስ።<verse eid="2CH 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 26:22"/>ካዎይ ኦዝያን ኦዳ ሀራባ ኡባ ኮይሮፐ ዉርሰ ጋካናዉ አሞፀ ናአይ፥ ናበይ እሳያስ ፃፍስ። <verse eid="2CH 26:22"/><verse number="23" style="v" sid="2CH 26:23"/>ኦዝያን ሀይቅድ ባ ማይዛታ ጋክስ። አሳይ እያ፥ “ባሮ ሀርገን ኦይከትዳይሳ” ያግድ፥ ካዎታ ዱፉዋ ማታን ሞግዶሶና። እ ሀይቅን እያ በሳን እያ ናአይ እዮአታም ካዎትስ።<verse eid="2CH 26:23"/></para>
  <chapter eid="2CH 26"/>
  <chapter number="27" style="c" sid="2CH 27"/>
  <para style="s1">ይሁዳ ካዋ እዮአታማ</para>
  <para style="r">(<ref loc="2KI 15:32-38">2 ካዎ 15:32-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 27:1"/>እዮአታም ካዎትያ ዎደ እያዉ ላይ ላታማነ እቻሻ፤ እ የሩሳላመን ታማነ ኡሱፑን ላይ ካዎትስ። እያ አየ ሱንይ ያሩሾ፤ እያ ሳዶቃ ናአ። <verse eid="2CH 27:1"/><verse number="2" style="v" sid="2CH 27:2"/>እያ አዋይ ኦዝያን ኦዳይሳዳ እዮአታም ጎዳ ስንን ሱረባ ኦስ። እያ አዋይ ፆሳ ኬ ገልዳይሳዳ እ ገልበና፤ ግዶሽን፥ አሳይ ናጋራ ኦሶ አግቤና።<verse eid="2CH 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 27:3"/>እዮአታም ፆሳ ኬ ገልያ ቆሞ ፐንግያ ዛሪድ ኦስ፤ የሩሳላመ ኦፌላ ደርያ ቦላ ዳሮ ኦሶ ኦስ። <verse eid="2CH 27:3"/><verse number="4" style="v" sid="2CH 27:4"/>ደረይ ዳርያ ይሁዳ ቢታን ካታማታ ኬፅስ፤ ዎር ዳርያ ዙማ ቦላ ሚፃነ አዱሳ ግምበ ሻኮታ ግምብስ።<verse eid="2CH 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 27:5"/>እዮአታም አሞነ ካዉዋራ ኦለትድ ፆንስ። አሞነት ሄ ላይ ሄ ሙኩሉነ ኦይዱ ፄቱ ክሎ ግራመ ብራ፥ ታሙ ሙኩሉ ኩንታለ ግድያ ግስተነ ታሙ ሙኩሉ ኩንታለ ግድያ ባንጋ እያዉ ጊርዶሶና። አሞነት ናምአን ላይነ ሄን ላይ ሄሳዳ እያዉ ጊርዶሶና። <verse eid="2CH 27:5"/><verse number="6" style="v" sid="2CH 27:6"/>እዮአታም ጎዳ ባ ፆሳ ስንን ሱረ ሄመትዳ ግሾ ዳሮ ምንስ።<verse eid="2CH 27:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 27:7"/>እዮአታማ ዎደ ኦሰትዳ ኦሶት፥ እ ኦለትዳ ኦላይነ እ ኦዳባ ኡባይ እስራኤለ ካዎታነ ይሁዳ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2CH 27:7"/><verse number="8" style="v" sid="2CH 27:8"/>እዮአታም ካዎትያ ዎደ እያዉ ላይ ላታማነ እቻሻ፤ እ የሩሳላመን ታማነ ኡሱፑን ላይ ካዎትስ። <verse eid="2CH 27:8"/><verse number="9" style="v" sid="2CH 27:9"/>እዮአታም ሀይቅድ ባ ማይዛታ ጋክስ። ኤንቲ እያ ዳዊታ ካታማን ሞግዶሶና። እያ በሳን እያ ናአይ አካዝ ካዎትስ።<verse eid="2CH 27:9"/></para>
  <chapter eid="2CH 27"/>
  <chapter number="28" style="c" sid="2CH 28"/>
  <para style="s1">ይሁዳ ካዋ አካዛ</para>
  <para style="r">(<ref loc="2KI 16:1-5">2 ካዎ 16:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 28:1"/>አካዝ ካዎትያ ዎደ እያዉ ላይ ላታማ፤ እ የሩሳላመን ታማነ ኡሱፑን ላይ ካዎትስ። አካዝ ባ ማይዛይ ዳዊቲ ሱረባ ኦዳይሳዳ ጎዳ ስንን ሱረባ ኦቤና፤ <verse eid="2CH 28:1"/><verse number="2" style="v" sid="2CH 28:2"/>እ ካሰ ደእዳ እስራኤለ ካዎታ ኦግያን ሄመትስ። ጉጅድ፥ ባኣለ ኤቃ ጎይናናዉ ምስለታ መስ። <verse eid="2CH 28:2"/><verse number="3" style="v" sid="2CH 28:3"/>ህኖማ ዛንጋራን እፃነ ጩይስስ፤ ጎዳይ እስራኤለ አሳ ስንፈ ጎድድ ከስዳ አሳ፥ እፀትዳ ኦግያ ካልድ ባ አደ ናይታ ታማን ፁግድ ኤቃስ ያርሽስ። <verse eid="2CH 28:3"/><verse number="4" style="v" sid="2CH 28:4"/>አካዝ ቃ ጎይኖ በሳታን፥ ደረ ሁጰነ ም ኩያ ጋርሳን ያርሾ ያርሽስነ እፃነ ጩይስስ።<verse eid="2CH 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 28:5"/>ሄሳ ግሾ፥ ጎዳይ እያ ፆሳይ እያ ሶረ ካዋ ኩሸን አድ እሚስ። ኤንቲ እያ ፆንድ፥ እያ አሳፐ ዳሮታ ድእድ፥ ዳማስቆ ኤፍዶሶና። ቃስ፥ ጎዳይ እያ እስራኤለ ካዋ ኩሸን አድ እምን፥ ካዎይ ኢታ ሾች ሾጭስ። <verse eid="2CH 28:5"/><verse number="6" style="v" sid="2CH 28:6"/>ይሁዳ አሳይ ጎዳ፥ ባንታ ማይዛታ ፆሳ አግዳ ግሾ ራማላ ናአይ ፓቁሄይ ይሁዳ ኦላንቾታፐ እስ ፄታነ ላታሙ ሙኩሉ ምኖ አሳታ እስ ጋላስ ዎስ። <verse eid="2CH 28:6"/><verse number="7" style="v" sid="2CH 28:7"/>ኤፍሬማ ኮቸ ግድዳ ምኖ ኦላንቾይ ዝክር፥ ካዋ ናኣ ማእሰያ፥ ካዎ ጋ ሹማ አዝርቃማነ ካዋ ካልድ ደእያ ኤልቃና ዎስ። <verse eid="2CH 28:7"/><verse number="8" style="v" sid="2CH 28:8"/>እስራኤለ አሳይ ባንታ ዳቦታፐ ናምኡ ፄቱ ሙኩሉ ማጫሳ፥ አደ ናይታነ ማጫ ናይታ ድእዶሶና፤ ኤንቲ ዳሮ ድኡዋ ኤክድ ሳማረ ብዶሶና።<verse eid="2CH 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 28:9"/>ጎዳ ናበይ ኦዴዳ ጌተትያ አደይ ሳማረን ደኤስ። ኦዴድ ሳማረ ብያ ኦላንቾታራ ጋሄታናዉ ከይድ፥ “ጎዳይ፥ ህንተ አዋታ ፆሳይ ይሁዳ ሀንቀትዳ ግሾ ህንተ ኩሸን አድ እሚስ። ሽን ህንተ ኤንታ ሳሎ ጋክዳ ሀንቆን ዎደታ። <verse eid="2CH 28:9"/><verse number="10" style="v" sid="2CH 28:10"/>ሄስ ግዶና እፅን ይሁዳነ የሩሳላመ ማጫነ አድያ ህንተ አይለ ኦናዉ ቆፔታ። ያትን፥ ህንተ ኤንታዳ ሀንድ ጎዳ፥ ህንተ ፆሳ ቦላ ናጋራ ኦደታ ግደከቲ? <verse eid="2CH 28:10"/><verse number="11" style="v" sid="2CH 28:11"/>ሀእ ታ ህንተዉ ኦደይሳ ስእተ። ጎዳ ሀንቆይ ህንተ ቦላ ዎዳ ግሾ ህንተ ድእድ፥ ቃችዳ ህንተ ዳቦታ የድተ” ያግስ።<verse eid="2CH 28:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 28:12"/>ሄሳፈ ጉየ፥ ኤፍሬማ ኮቻ ሀላቃታፐ ዮሃናና ናአይ አዛርያስ፥ ማሽልሞታ ናአይ ባራክ፥ ሳሎማ ናአይ ይዝቃነ ሀድላያ ናአይ አማስ ኦላፐ ስምዳይሳታ ቦላ ደንድዶሶና። <verse eid="2CH 28:12"/><verse number="13" style="v" sid="2CH 28:13"/>ኤንቲ “ሄ ድኤትዳ አሳታ ኑኮ ኤሆፕተ! ካሰ ኑኒ ጎዳ ቦላ ኦዳ ናጋራነ ናቁዋ ቦላ ሀራ ጉጄታ። ኮይሮካ ኑ ናጋራይ ዳሮ ግድያ ግሾ እስራኤለ ቦላ ጎዳ ሀንቆይ ዎስ” ያግዶሶና።<verse eid="2CH 28:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 28:14"/>ሄሳ ግሾ፥ ኦላንቾት ድኤትዳ አሳታነ ሚሽያ ሀላቃታ ስንንነ ደሪያ ስንን እምዶሶና። <verse eid="2CH 28:14"/><verse number="15" style="v" sid="2CH 28:15"/>ሱንይ ሀይሳፈ ቆሞን ፃፈትዳ አሳት ደንድ ኤቅድ፥ ድኤትዳ አሳ ኤክዶሶና። ኤንታ ግዶን ካሎ ደኤይሳታስ ድኡዋፐ ማኦነ ጫማ እምዶሶና። ኤንታ ሙዝዶሶናነ ኡሽዶሶና፤ ኤንታ ማዱን ቦላ ዛይተ ትይዶሶና። ዳቡርዳይሳታ ሀረ ቶግስድ ኤንታ እሻታኮ ዛምብ ደእያ እያርኮ ካታማ ኤፍዶሶና። ሄሳፈ ጉየ፥ ኤንቲ ሳማረ ስምዶሶና።<verse eid="2CH 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 28:16"/>ሄ ዎደ ካዎይ አካዝ አሶረ ካዎይ ባና ማዳና መላ ኪታ የድስ። <verse eid="2CH 28:16"/><verse number="17" style="v" sid="2CH 28:17"/>ኤዶመ አሳት ናምአን ይሁዳ ቦላ ደንድድ፥ ዳሮ አሳ ድእድ ኤፍዶሶና። <verse eid="2CH 28:17"/><verse number="18" style="v" sid="2CH 28:18"/>ፍልስፄመት ዙማ ፃጶንነ ይሁዳ ጋን፥ ነገበ መላ ቢታን ደእያ ካታማታ ኦልድ ቤት-ሳሜሳ፥ ኤሎና፥ ጋደሮታ፥ ሶኮ፥ ትምና፥ ግምዞነ ኤንታ ሄራን ደእያ ጉታታ ኦይክድ ያን ደእዶሶና። <verse eid="2CH 28:18"/><verse number="19" style="v" sid="2CH 28:19"/>ይሁዳ ካዎይ አካዝ ይሁዳ አሳ ናጋራ ኦስስዳ ግሾነ ጎዳስ አማነትቦና ግሾ ጎዳይ ይሁዳ ካዉሽስ። <verse eid="2CH 28:19"/><verse number="20" style="v" sid="2CH 28:20"/>አሶረ ካዎይ ተልገልተልፈልሶር አካዛኮ ይድ እያ መቶ በስስፐ አትሽን፥ ማድቤና። <verse eid="2CH 28:20"/><verse number="21" style="v" sid="2CH 28:21"/>አካዝ ፆሳ ኬፈ፥ ካዎ ጋፐነ ሀላቃታፐ ዳሮባ ኤክድ፥ አሶረ ካዋስ እሚስ። ሽን ሄስ እያ አይኮካ ማድቤና።<verse eid="2CH 28:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 28:22"/>ካዎይ አካዝ ኡንኤትዳ ዎደ ጎዳስ አማነቶና እፅድ መቶ ቦላ መቶ ጉጅስ። <verse eid="2CH 28:22"/><verse number="23" style="v" sid="2CH 28:23"/>ባና ፆንዳ ዳማስቆ ፆሳታስ ያርሽሸ፥ “ሶረ ካዎታ ፆሳት ኤንታ ማድዳ ግሾ ታናካ ኤንቲ ማዳና መላ ታኒ ኤንታዉ ያርሻና” ያግስ። ሽን ሄ ፆሳት እያዉነ እስራኤለ አሳ ኡባስ ዮ ኤህዶሶና። <verse eid="2CH 28:23"/><verse number="24" style="v" sid="2CH 28:24"/>አካዝ ፆሳ ኬ ሚሸታ ኡባ ሺሽድ ትንቸረስ። ፆሳ ኬ ፐንገታ ጎርድስ። የሩሳላመን ዱማ ዱማ በሳን ባዉ ያርሾ በሲ ኬፅስ። <verse eid="2CH 28:24"/><verse number="25" style="v" sid="2CH 28:25"/>አካዝ ሀራ ፆሳታስ እፃነ ጩይሳናዉ ይሁዳን ደእያ ካታማታ ኡባን ቃ ጎይኖ በሳታ መስ። ያትድ ጎዳ፥ ባ አዋታ ፆሳ ሀንቀስ።<verse eid="2CH 28:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 28:26"/>ሄኮ፥ አካዛ ዎደን ኦሰትዳ ሀራ ኦሶት ኮይሮፐ ዉርሰ ጋካናዉ ይሁዳ ካዎታነ እስራኤለ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2CH 28:26"/><verse number="27" style="v" sid="2CH 28:27"/>አካዝ ሀይቅድ፥ ባ ማይዛታ ጋክስ። የሩሳላመ ካታማን እያ ሞግዶሶና፤ ሽን እያ እስራኤለ ካዎታ ዱፉዋን ሞግቦኮና። እያ በሳን እያ ናአይ ህዝቅያስ ካዎትስ።<verse eid="2CH 28:27"/></para>
  <chapter eid="2CH 28"/>
  <chapter number="29" style="c" sid="2CH 29"/>
  <para style="s1">ይሁዳ ካዋ ህዝቅያሳ</para>
  <para style="r">(<ref loc="2KI 18:1-3">2 ካዎ 18:1-3</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 29:1"/>ህዝቅያስ ካዎትያ ዎደ እያዉ ላይ ላታማነ እቻሻ፤ እ የሩሳላመን ላታማነ ኡዱፉን ላይ ካዎትስ። እያ አየ ሱንይ አቡ፤ እያ ዛካርያሳ ናአ። <verse eid="2CH 29:1"/><verse number="2" style="v" sid="2CH 29:2"/>እያ ማይዛይ ዳዊቲ ኦዳይሳዳ ህዝቅያስ ጎዳ ስንን ሱረባ ኦስ።<verse eid="2CH 29:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 29:3"/>ህዝቅያስ ባ ካዎትዳ ኮይሮ ላይን፥ ኮይሮ አጌናን፥ ፆሳ ኬ ፐንገታ ዶይድ ኦራስ። <verse eid="2CH 29:3"/><verse number="4" style="v" sid="2CH 29:4"/>ካህነታነ ሌወታ ፆሳ ኬ ዶሎሀ ባጋራ ደእያ ዳባባን ሺሽስ። <verse eid="2CH 29:4"/><verse number="5" style="v" sid="2CH 29:5"/>ኤንታኮ፥ “ሌወቶ፥ ታ ኦደይሳ ስእተ! ህንተናተ ጌሽተ፤ ጎዳ ህንተ አዋታ ፆሳ ኬ ጌሽተ፤ ፆሳ ኬ ቱንስያባ ኡባ ድግተ። <verse eid="2CH 29:5"/><verse number="6" style="v" sid="2CH 29:6"/>ኑ አዋት አማነትቦኮና፤ ጎዳ፥ ኑ ፆሳ ስንን ኢታባ ኦዶሶና። ኤንቲ ጎዳ አግድ፥ ጎዳይ ደእያ በሳፈ ባንታ ሶምኦ ሀራ ሶ ዛሪድ፥ እያዉ ባንታ ዞኩዋ ዛርዶሶና። <verse eid="2CH 29:6"/><verse number="7" style="v" sid="2CH 29:7"/>ቃስ፥ ኤንቲ ፆሳ ኬ ፐንገታ ጎርድዶሶና፤ ፆምፐታ ቶይስዶሶና። ፆሳ ኬን እስራኤለ ፆሳስ እፃነ ጩይስቦኮና ዎይኮ ፁሳ ያርሾ ያርሽቦኮና። <verse eid="2CH 29:7"/><verse number="8" style="v" sid="2CH 29:8"/>ሄሳ ግሾ፥ ጎዳ ሀንቆይ ይሁዳ ቦላነ የሩሳላመ ቦላ ዎስ። ህንተ፥ ህንተ አይፈን በኤይሳዳ ጎዳይ ኤንታ ቦላ ያሽ፥ ዳጋማነ ህርጋ የድስ። <verse eid="2CH 29:8"/><verse number="9" style="v" sid="2CH 29:9"/>ሄሳ ጋሶን፥ ኑ አዋት ማሻን ሀይቅዶሶና፤ ኑ ናይትነ ኑ ማቸት ድኤትዶሶና። <verse eid="2CH 29:9"/><verse number="10" style="v" sid="2CH 29:10"/>ጎዳ ሀንቆይ ኑ ቦላፈ ክቻና መላ ታኒ ጎዳራ፥ እስራኤለ ፆሳራ ጫቃናዉ ታ ዎዛናን ቆፓስ። <verse eid="2CH 29:10"/><verse number="11" style="v" sid="2CH 29:11"/>ታ ናይቶ፥ ህንተ ጎዳ ስንን ኤቃና መላ፥ እያዉ ኦና መላ፥ እያ ኦሳንቾ ግዳና መላነ እፃነ ጩይሳና መላ ጎዳይ ህንተና ዶርዳ ግሾ ቀል ጎፕተ” ያግስ።<verse eid="2CH 29:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 29:12"/>ሄ በሳን ደእያ ሌወት ሀይሳፈ ካልድ ፃፈትዳይሳታ።</para>
  <para style="p" vid="2CH 29:12">ቃሃታ ያራፐ አማሳያ ናኣ ማሃታነ አዛርያሳ ናኣ እዩኤላ።</para>
  <para style="p" vid="2CH 29:12">ማራራ ያራፐ አብዳ ናኣ ቂሳነ ይሀልኤላ ናኣ አዛርያሳ።</para>
  <para style="p" vid="2CH 29:12">ገድሶና ያራፐ ዚማ ናኣ እዮአክናነ ዮኣሀ ናኣ ኤደና።<verse eid="2CH 29:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 29:13"/>ኤልፃፋና ያራፐ ሽምራነ ኡዝኤላ።</para>
  <para style="p" vid="2CH 29:13">አሳፋ ያራፐ ዛካርያሳነ ማታና።<verse eid="2CH 29:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 29:14"/>አማና ያራፐ ይኤላነ ሳመአ።</para>
  <para style="p" vid="2CH 29:14">ኤዶታመ ያራፐ ሻማያነ ኡዝኤላ።<verse eid="2CH 29:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 29:15"/>ኤንቲ ባንታ ዳቦታ ሺሽድ ባንታና ጌሽዳፐ ጉየ ካዎይ ኤንታ ኪትዳይሳዳ ጎዳ ህግያዳ ፆሳ ኬ ጌሾ ዶምዶሶና። <verse eid="2CH 29:15"/><verse number="16" style="v" sid="2CH 29:16"/>ሄሳ ግሾ፥ ካህነት ጎዳ ኬ ጌሻናዉ ገልዶሶና፤ ፆሳ ኬ ግዶን ደእያ ቱናባ ኡባ ከስድ፥ ፆሳ ኬ ዳባባ ኤህዶሶና። ያትን ሌወት ኤክድ ቀድሮና ዛንጋራን ሆልዶሶና። <verse eid="2CH 29:16"/><verse number="17" style="v" sid="2CH 29:17"/>ኤንቲ ኮይሮ አጌናን፥ ኮይሮ ጋላስ ፆሳ ኬ ጌሾ ዶምዶሶና፤ ሄ አጌናን ሆስፑን ጋላስ ባራንዳ ጋክዶሶና። ሀራ ሆስፑን ጋላስ ፆሳ ኬ ጎይኖስ ጊግስዶሶና። ኮይሮ አጌናን ታማነ ኡሱፑን ጋላስ ኤንቲ ኦሱዋ ፖልዶሶና።<verse eid="2CH 29:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 29:18"/>ሌወት ካዋ ህዝቅያሳኮ ገልድ፥ “ኑኒ ፆሳ ኬ፥ ፁሳ ያርሾ በሳነ ያርሾ በሳን ጎኤትያ ሚሸ ኡባ፥ ጎዳ ስንን ዎያ ኡይ ፃርጴዛነ ሄ ፃርጴዛን ደእያ ሚሸታ ኡባ ጌሽዳ። <verse eid="2CH 29:18"/><verse number="19" style="v" sid="2CH 29:19"/>ካዎይ አካዝ ካዎትድ ደእያ ዎደ ፆሳስ አማነቶና እፅድ ኤፍዳ ሚሸ ኡባ ኑ ዛሪድ ጌሽዳ። ሄኮ፥ ኑ ጌሽዳ ሚሸ ኡባይ ጎዳ ያርሾ በሳ ስንን ደኤስ” ያግዶሶና።<verse eid="2CH 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 29:20"/>ካዎይ ህዝቅያስ ዎንተ ጋላስ ዎንታ ጉራ ደንድድ ካታማ ሀላቃታ ሺሽድ፥ ኤንታራ እስፈ ፆሳ ኬ ብስ። <verse eid="2CH 29:20"/><verse number="21" style="v" sid="2CH 29:21"/>ኤንቲ ካዎተ ግሾ፥ ፆሳ ኬ ግሾነ ይሁዳ አሳ ግሾ፥ ላፑን ኮርማታ፥ ላፑን ማራዘታ፥ ላፑን ዶርሳ ኡርገታነ ላፑን ኮለታ ናጋራ ያርሾስ ኤህዶሶና። አሮና ኮቸ ግድያ ካህነት፥ ጎዳ ያርሾ በሳን ሀይሳታ ያርሻና መላ ካዎይ ኪትስ። <verse eid="2CH 29:21"/><verse number="22" style="v" sid="2CH 29:22"/>ካህነት ኮርማታ ሹክድ ሱ ያርሾ በሳ ቦላ ርጭዶሶና። ማራዘታ ሹክድ ሱ ያርሾ በሳ ቦላ ርጭዶሶና። ዶርሳ ኡርገታ ሹክድ ሱ ያርሾ በሳ ቦላ ርጭዶሶና። <verse eid="2CH 29:22"/><verse number="23" style="v" sid="2CH 29:23"/>ናጋራ ያርሾስ ሀንያ ኮለታ ካዋ ስንነ አሳ ስን ኤህዶሶና፤ ኤንቲ ኡባይ ባንታ ኩሽያ ዴሻታ ቦላ ዎዶሶና። <verse eid="2CH 29:23"/><verse number="24" style="v" sid="2CH 29:24"/>ካዎይ ፁሳ ያርሾነ ናጋራ ያርሾ ያርሻና መላ ኤንታ ኪትዳ ግሾ ካህነት ዴሻታ ሹክድ እስራኤለ አሳ ኡባ ናጋራይ አቶ ጌተታና መላ ኤንታ ሱ ያርሾ በሳን ያርሽዶሶና።<verse eid="2CH 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 29:25"/>ጎዳይ ካዋስ ቆንጨ በእያ ጋደነ ናብያ ናታና ባጋራ ካዋ ዳዊቲ ኪትዳ ኪታ ህዝቅያስ ካልድ፥ ሌወታ፥ ዳላ፥ ዲነ ማስንቆ ኦይድ ፆሳ ኬን ኤስስ። <verse eid="2CH 29:25"/><verse number="26" style="v" sid="2CH 29:26"/>ሌወት ዳዊቲ ጎኤትያ የ ሚሸታ ኦይክን፥ ካህነት ዛየ ኦይክድ ኤቅዶሶና። <verse eid="2CH 29:26"/><verse number="27" style="v" sid="2CH 29:27"/>ኤንቲ ፁሳ ያርሾ ያርሻና መላ ህዝቅያስ ኪትስ። ፁሳ ያርሾይ ያርሸትያ ዎደ ዛየይነ እስራኤለ ካዋ ዳዊታ የ ሚሸታን ጎዳስ የ ዶመቴስ። <verse eid="2CH 29:27"/><verse number="28" style="v" sid="2CH 29:28"/>ፁሳ ያርሾይ ፖለታና ጋካናዉ ሺቆ ኡባይ ጎዳ ጎይኔስ፤ የፀይሳት የፆሶና፤ ዛየ ፑነይሳት ፑኖሶና። <verse eid="2CH 29:28"/><verse number="29" style="v" sid="2CH 29:29"/>ካህነት ያርሹዋ ፖልዳ ዎደ ካዎይነ እያራ ደእያ አሳ ኡባይ ጉልባትድ ጎይንዶሶና። <verse eid="2CH 29:29"/><verse number="30" style="v" sid="2CH 29:30"/>ካዎይ ዳዊቲነ ቆንጨ በእያ አሳፍ ፃፍዳ ጋላታ ማዝሙረ ጎዳስ የፃና መላ ካዎይ ህዝቅያስነ ሀላቃት ሌወታ ኪትዶሶና፤ ኤንቲ ኡባይ ኡፋይሳን ጋላትሸ ጉልባትድ ጎይንዶሶና።<verse eid="2CH 29:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 29:31"/>ሄሳፈ ጉየ፥ ህዝቅያስ፥ “ሀእ ህንተ ህንተና ጎዳስ ዱማይደታ። ያርሾነ ጋላታ ያርሾ ፆሳ ኬ ኤህተ” ያግስ። ሺቅዳ አሳይ ያርሾነ ጋላታ ያርሾ ኤህዶሶና፤ ዎዛን ዶስዳ አሳይ ፁሳ ያርሾ ኤህዶሶና። <verse eid="2CH 29:31"/><verse number="32" style="v" sid="2CH 29:32"/>ሄ ሺቅዳ አሳይ ኤህዳ ፁሳ ያርሾ ታይቦይ ላፑን ታሙ ኮርማታ፥ ፄቱ ማራዘታነ ናምኡ ፄቱ ዶርሳ ኡርገታ፤ ሄ ኡባይ ጎዳስ ፁሳ ያርሾ። <verse eid="2CH 29:32"/><verse number="33" style="v" sid="2CH 29:33"/>እስፈተ ያርሾስ ኡሱፑን ፄቱ ኮርማታነ ሄ ሙኩሉ ዶርሳት ሺቅዶሶና። <verse eid="2CH 29:33"/><verse number="34" style="v" sid="2CH 29:34"/>ግዶሽን፥ ፁሳ ያርሾ ኡባ ሹክድ፥ ጋልባ ቃራናዉ ደእያ ካህነት ታይቦን ጉ ግድያ ግሾ ኦሶይ ዉራና ጋካናዉነ ሀራ ካህነት ባንታና ጌሻና ጋካናዉ ኤንታ ዳቦ ግድዳ ሌወት ማድዶሶና። ባንታና ጌሾን ሌወት ካህነታፐ አድ አማነቶሶና። <verse eid="2CH 29:34"/><verse number="35" style="v" sid="2CH 29:35"/>ፁሳ ያርሾራ ሺቅያ እስፈተ ያርሹዋ፥ ሞዋነ ኡሻ ያርሹዋ ጉጅያ ዎደ ፁሳ ያርሾይ ዳሮ።</para>
  <para style="p" vid="2CH 29:35">ሄሳዳ ሀንድ ፆሳ ኬ ኦሶይ ዛሪድ ዶምስ። <verse eid="2CH 29:35"/><verse number="36" style="v" sid="2CH 29:36"/>ህዝቅያስነ አሳ ኡባይ ኦሱዋ ኤለስድ ፖላና መላ ፆሳይ ኤንታ ማድዳ ግሾ ዳሮ ኡፋይትዶሶና።<verse eid="2CH 29:36"/></para>
  <chapter eid="2CH 29"/>
  <chapter number="30" style="c" sid="2CH 30"/>
  <para style="s1">ፓስካ ባኣለ ቦንቾ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 30:1"/>ህዝቅያስ ጎዳ እስራኤለ ፆሳ ፓስካ ባኣለ ቦንቻናዉ የሩሳላመን ደእያ ፆሳ ኬ እስራኤለ አሳይነ ይሁዳ አሳይ ያና መላ ኪትስ። ቃስ፥ ኤፍሬማ አሳስነ ምናሰ አሳስ ዳብዳበ ፃፍስ። <verse eid="2CH 30:1"/><verse number="2" style="v" sid="2CH 30:2"/>ካዎይ፥ ሀላቃትነ የሩሳላመን ሺቅዳ አሳ ኡባይ ፓስካ ባኣለ ናምአን አጌናን ቦንቻናዉ ቆፋ ቃችዶሶና። <verse eid="2CH 30:2"/><verse number="3" style="v" sid="2CH 30:3"/>ግድያ ካህነት ባንታና ጌሽቦና ግሾነ ዳሮ አሳይ የሩሳላመን ሺቅቦና ግሾ አሳይ ፓስካ እያ ዎደን ቦንቻናዉ ዳንዳእቦኮና። <verse eid="2CH 30:3"/><verse number="4" style="v" sid="2CH 30:4"/>ሄ ቆፋይ ካዋነ ሺቅዳ አሳ ኡፋይስስ። <verse eid="2CH 30:4"/><verse number="5" style="v" sid="2CH 30:5"/>ሄሳ ግሾ፥ ጎዳ እስራኤለ ፆሳ ፓስካ የሩሳላመን ቦንቻናዉ በርሳበፐ ዶምድ ዳነ ጋካናዉ ደእያ እስራኤለ አሳ ኡባይ ያና መላ አዋጃናዉ ቆፋ ቃችዶሶና። ሀ ፓስካ ባልያ ካሰ ህግያን ፃፈትዳይሳዳ ዳሮ አስ ቦንችቤና።<verse eid="2CH 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 30:6"/>ካዎይ ኪታን፥ ኪተትዳይሳት፥ ካዋነ ሹማታ ዳብዳብያ ኤክድ እስራኤለነ ይሁዳ ኡባ ብዶሶና።</para>
  <para style="p" vid="2CH 30:6">ዳብዳበይ ሀይሳዳ ያጌስ፤ “እስራኤለ አሳዉ፥ አሶረ ካዋ ኩሸፐ አትዳ ህንተኮ ስማና መላ ህንተካ ጎዳኮ፥ አብራሃመ፥ ይሳቃነ እስራኤለ ፆሳኮ ስምተ! <verse eid="2CH 30:6"/><verse number="7" style="v" sid="2CH 30:7"/>ህንተ ካሰ በእዳይሳዳ ኤንታ ቦረስ አድ እማና ጋካናዉ ባንታ ጎዳስ፥ ባንታ አዋታ ፆሳስ አማነትቦና ህንተ አዋታዳነ ህንተ እሻታዳ ሀኖፕተ። <verse eid="2CH 30:7"/><verse number="8" style="v" sid="2CH 30:8"/>ህንተ ጎዳስ ኪተትተ፤ ካሰ ህንተ አዋታዳ ስእሸ እፃስ ጎፕተ! ህንተናተ ፆሳስ እምተ። ጎዳይ መርናዉ ጌሽዳ ፆሳ ኬ ዪተ። ጎዳ ሀንቆይ ህንተፈ ስማና መላ ጎዳ ህንተ ፆሳ ጎይንተ። <verse eid="2CH 30:8"/><verse number="9" style="v" sid="2CH 30:9"/>ህንተ ጎዳኮ ስምኮ ህንተ እሻትነ ህንተ ናይት ባንታና ድእዳይሳታ ስንን ማሮታ ደምድ ሀ ቢታ ስማና። ጎዳይ ህንተ ፆሳይ ቃተይሳነ ማረይሳ ግድያ ግሾ ህንተ እያኮ ስምኮ ባ ሶምኡዋ ህንተፈ ቆሰና” ያግስ።<verse eid="2CH 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 30:10"/>ኪተትዳይሳት ኤፍሬማነ ምናሰ ቢታ ካንድ ዛብሎና ቢታ ጋካናዉ ካታማፐ ካታማ ብዶሶና። ሽን ሄ ካታማታን ደእያ አሳይ ኤንታ ካድ ኤንታ ቦላ ሚጭዶሶና። <verse eid="2CH 30:10"/><verse number="11" style="v" sid="2CH 30:11"/>ግዶሽን፥ አሴራፐ፥ ምናሰፐነ ዛብሎና ጉ አሳት ባንታና ካዉሽድ የሩሳላመ ይዶሶና። <verse eid="2CH 30:11"/><verse number="12" style="v" sid="2CH 30:12"/>ካዎይነ ካዋ ሹማት ጎዳ ቃላ ማራን ኪትዳይሳ ፖላናዉ እስ ዎዛናን ግዳና መላ ፆሳ ኩሸይ ይሁዳ ቦላ ደኤስ።<verse eid="2CH 30:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 30:13"/>ናምአን አጌናን ኡይ ባኣለ ቦንቻናዉ ዳሮ አስ የሩሳላመን ሺቅስ። <verse eid="2CH 30:13"/><verse number="14" style="v" sid="2CH 30:14"/>ኤንቲ ደንድድ፥ የሩሳላመን ደእያ ያርሾ በሳታ ላልድ፥ እፃነ ጩይስያ ሚሸ ኡባ ድግድ፥ ቀድሮና ዛንጋራን የግዶሶና። <verse eid="2CH 30:14"/><verse number="15" style="v" sid="2CH 30:15"/>ናምአን አጌናን፥ ታማነ ኦይዳን ጋላሳን ፓስካ ዶርሳ ሹክዶሶና። ባንታና ጌሽቦና ካህነትነ ሌወት ዬላትድ፥ ባንታና ጌሽዶሶና፤ ፁሳ ያርሾ ፆሳ ኬ ኤህዶሶና። <verse eid="2CH 30:15"/><verse number="16" style="v" sid="2CH 30:16"/>ፆሳ አስ ግድዳ ሙሰ ዎጋዳ ፆሳ ኬ ግዶን ባንታ በሳን በሳን ኤቅዶሶና፤ ካህነት ሌወታ ኩሸፐ ኤክዳ ሱ ርጭዶሶና።<verse eid="2CH 30:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 30:17"/>አሳ ግዶፈ ዳሮት ባንታና ጌሽቦና ግሾነ ዶርሳታ ሹኮና መላ ድገትዳ ግሾ ሌወት ኤንታዉ ፓስካ ዶርሳታ ሹክዶሶና። <verse eid="2CH 30:17"/><verse number="18" style="v" sid="2CH 30:18"/>ኤፍሬማፐ፥ ምናሰፐ፥ ይሳኮራፐነ ዛብሎና ኮቻፈ ዳሮ አሳይ ህገይ ኪተይሳዳ ባንታና ጌሽቦናባ ግድኮካ ፓስካ ባኣለ ግብራ ምዶሶና። ግዶሽን፥ ካዎይ ህዝቅያስ፥ “አቤት ኬሀ ጎዳዉ፥ <verse eid="2CH 30:18"/><verse number="19" style="v" sid="2CH 30:19"/>ህገይ ኪተይሳዳ ሀይሳቲ ባንታና ጌሾናባ ግድኮካ ኤንቲ ነና ጎዳ፥ ባንታ አዋታ ፆሳ ኮያናዉ ባንታ ዎዛና ጊግስዳ ግሾ ነ ኤንታዉ አቶ ያጋ” ያግድ ዎስስ። <verse eid="2CH 30:19"/><verse number="20" style="v" sid="2CH 30:20"/>ጎዳይ ህዝቅያሳ ዎሳ ስእድ ኤንታዉ አቶ ግስ።<verse eid="2CH 30:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 30:21"/>የሩሳላመን ሺቅዳ እስራኤለ አሳይ ላፑን ጋላስ ኩመ ኡይ ባልያ ግታ ኡፋይሳን ቦንችዶሶና። ሌወትነ ካህነት የ ሚሸን የፅሸ ጋላስ ጋላስ ጎዳ ጋላቶሶና። <verse eid="2CH 30:21"/><verse number="22" style="v" sid="2CH 30:22"/>ህዝቅያስ ጎዳ ጎይኖ ዎጋ ካለሶን ኤረትዳ ሌወታ ምንስ።</para>
  <para style="p" vid="2CH 30:22">አሳ ኡባይ እስፈተ ያርሾ ያርሽሸ፥ ጎዳ ባንታ አዋታ ፆሳ ጋላትሸ፥ ምሸነ ኡይሸ ባኣለ ላፑን ጋላስ ቦንችዶሶና። <verse eid="2CH 30:22"/><verse number="23" style="v" sid="2CH 30:23"/>ሺቆይ ሀራ ላፑን ጋላስ ጉጅድ ባኣለ ቦንቻናዉ ዞረ ቃችድ ላፑን ጋላስ ኡፋይትድ ቦንችዶሶና። <verse eid="2CH 30:23"/><verse number="24" style="v" sid="2CH 30:24"/>ይሁዳ ካዎይ ህዝቅያስ ያርሾ ያርሻናዉ እስ ሙኩሉ ኮርማታ፥ ላፑን ሙኩሉ ዶርሳታነ ዴሻታ አሳስ እሚስ፤ ቃስ ሀላቃት እስ ሙኩሉ ኮርማታነ ታሙ ሙኩሉ ዶርሳታ አሳስ እምዶሶና፤ ዳሮ ካህነት ባንታና ጌሽዶሶና። <verse eid="2CH 30:24"/><verse number="25" style="v" sid="2CH 30:25"/>ይሁዳ አሳይ፥ ካህነት፥ ሌወት፥ እስራኤለፐ ይዳ አሳይ፥ ባኣለ ቦንቻናዉ ይዳ በተ አሳይነ ይሁዳ ቢታን ደእዳ አሳ ኡባይ ኡፋይትዶሶና። <verse eid="2CH 30:25"/><verse number="26" style="v" sid="2CH 30:26"/>ዳዊታ ናኣ፥ እስራኤለ ካዋ ሶሎሞነ ዎድያፐ ዶምን ሀች ጋካናዉ የሩሳላመን ሄሳ መላ ባለይ ቦንቸትድ ኤሮና ግሾ የሩሳላመን አሳይ ዳሮ ኡፋይትዶሶና። <verse eid="2CH 30:26"/><verse number="27" style="v" sid="2CH 30:27"/>ካህነትነ ሌወት ደንድድ፥ ጎዳይ አሳ አንጃና መላ ዎስን ፆሳይ ሳሎን፥ ባ ደእያ ጌሻ በሳን ኤንታ ዎሳ ስእስ።<verse eid="2CH 30:27"/></para>
  <chapter eid="2CH 30"/>
  <chapter number="31" style="c" sid="2CH 31"/>
  <para style="s1">ህዝቅያስ ጎይኖ ዎጋ ኦራስ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 31:1"/>ባለይ ፖለትዳ ዎደ ሄ በሳን ደእያ እስራኤለ ኡባይ ይሁዳ ካታማታ ብድ ኤቃ ሹቻታ ትንቸረዶሶና፤ አሼራ ኤቃ ምስለታ ቃንፀረዶሶና። ይሁዳን፥ ብንያመን ኤፍሬማንነ ምናሰ ቢታን ደእያ ቃ ጎይኖ በሳታነ ያርሾ በሳታ ላልዶሶና። ኤንቲ ሄ ኡባ ይስዳፐ ጉየ እስራኤለ አሳ ኡባይ ባንታ ካታማነ ባንታ ሶ ሶ ስምዶሶና።<verse eid="2CH 31:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 31:2"/>ህዝቅያስ ካህነታነ ሌወታ ኤንታ ኦሶ ማራን ጩጋን ጩጋን ሻክድ ኤስስ። ኤንቲ ፁሳ ያርሾነ እስፈተ ያርሾ ጎዳስ ያርሻና መላነ ፆሳ ኬ ፐንገን ጎዳ ጋላታናነ ሳባና መላ ኦስ። <verse eid="2CH 31:2"/><verse number="3" style="v" sid="2CH 31:3"/>ጎዳ ህግያን ፃፈትዳይሳዳ ዎንታነ ኦማርስ ፁሳ ያርሾነ ሳምባታን፥ አጌና ፄሮንነ ሀራ ባኣለ ጋላሳታን ሺቅያ ያርሹዋስ ኮሽያ መሄታ ካዎይ ባፐ እሜስ።<verse eid="2CH 31:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 31:4"/>ጎዳ ህግያን ፃፈትዳይሳዳ ካህነትነ ሌወት ባንታ ኩመ ዎድያ ጎዳ ኦሶስ ፔሻና መላ ኤንታዉ በሲያባ እማና መላ የሩሳላመ አሳ ካዎይ ኪትስ። <verse eid="2CH 31:4"/><verse number="5" style="v" sid="2CH 31:5"/>እስራኤለ አሳይ ካዋ ኪታ ስእዳ ዎደ ካፈ፥ ዎይነ ኡሻፈ፥ ዛይትያፐ፥ ኤሳፈነ ጋደን ካፅዳባፐ ባይራ ጎዳስ እምዶሶና፤ ባንታዉ ደእያባ ኡባፈ አስራታ ከስዶሶና። <verse eid="2CH 31:5"/><verse number="6" style="v" sid="2CH 31:6"/>ይሁዳ ካታማታን ደእያ እስራኤለ አሳይነ ይሁዳ አሳይ ባንታ መሄታፐ፥ ዶርሳታፐ አስራታ እምዶሶና፤ ጎዳ፥ ባንታ ፆሳስ፥ ዱማይድ ዎዳባ ኤህድ ዶርዶሶና። <verse eid="2CH 31:6"/><verse number="7" style="v" sid="2CH 31:7"/>ኤንቲ ሄን አጌናን ኤሆ ዶምድ ላፑን አጌናን ፖልዶሶና። <verse eid="2CH 31:7"/><verse number="8" style="v" sid="2CH 31:8"/>ህዝቅያስነ ሀላቃት ዶረትዳይሳ ይድ በእዳ ዎደ ኤንቲ ጎዳነ ጎዳ አስ ግድዳ እስራኤለ አንጅዶሶና።<verse eid="2CH 31:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 31:9"/>ህዝቅያስ ዶረትዳ እሞታባ ካህነታነ ሌወታ ኦይችስ።<verse eid="2CH 31:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 31:10"/>ሳዶቃ ያራ ግድዳ ካህነ ሀላቃይ አዛርያስ፥ “ባንታ እሙዋ ፆሳ ኬ ኤሆ ዶምን ኑ ምድ ካልዳ። ጎዳይ ባ አሳ አንጅዳ ግሾ ዳሮ ፓላህስ” ያግስ።<verse eid="2CH 31:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 31:11"/>ህዝቅያስ ፆሳ ኬን ምንጃ ክፍለታ ጊግሳና መላ ኪትን አሳይ ጊግስዶሶና። <verse eid="2CH 31:11"/><verse number="12" style="v" sid="2CH 31:12"/>አስራታ፥ ባይራባነ ዱማትዳ እሞታታ አማነተን ክፍለታ ገልስዶሶና። ሌወ ግድዳ ኮናነይ ምንጃ ኬ ቦላ ዋና ግድድ ሹመትስ። እያ እሻይ ሳመእ እያዉ ናምአን ግድድ ሹመትስ። <verse eid="2CH 31:12"/><verse number="13" style="v" sid="2CH 31:13"/>ካዎይ ህዝቅያስነ ካህነ ሀላቃይ አዛርያስ ሹምን ኮናነፐነ ሳመአፐ ጋርሳራ ኦያ ሌወት፥ ይኤላ፥ አዛዛ፥ ናሃታ፥ አሳሄላ፥ ያርሞታ፥ ዮዛባታ፥ ኤልኤላ፥ ይስማካ፥ ማሃታነ ባናያ። <verse eid="2CH 31:13"/><verse number="14" style="v" sid="2CH 31:14"/>ዶሎሀ ባጋ ፐንግያ ናገይሳታ ሀላቃይ ሌወይ፥ ይምና ናአይ፥ ቆረይ፥ አሳይ ዶሳን ፆሳስ ኤህዳ እሙዋ ኤካናዉነ ግሻናዉ ሹመትስ። <verse eid="2CH 31:14"/><verse number="15" style="v" sid="2CH 31:15"/>ካህነት ደእያ ካታማታን ግታፐ ጉ ጋካናዉ ደእያ ባንታ እሻታስ አማነትድ፥ ኤንታ ኦሱዋዳ ኦሱዋዳ ሻክድ እማና መላ ኤደን፥ ምንያምን፥ እያሱይ፥ ሻማኤይ፥ አማረይነ ሳካን ቆረፐ ጋርሳራ ሹመትዶሶና። <verse eid="2CH 31:15"/><verse number="16" style="v" sid="2CH 31:16"/>ባንታ ጩጋን ጩጋን ባንታ ኦሱዋ ጋላስ ጋላስ ፆሳ ኬን ኦይሳታስ ላይ፥ ሄነ እያፐ ቦላ ግድዳ አደ ኡባስ ኤንታ ግሹዋ ሻክድ እምዶሶና። <verse eid="2CH 31:16"/><verse number="17" style="v" sid="2CH 31:17"/>ባንታ አዋታ ሶ አሳን አሳን ታይበትዳ ካህነታስነ ላይ፥ ላታማነ እያፐ ቦላ ግድዳ ሌወታስ ባንታ ኦሱዋዳ ኦሱዋዳ ባንታ ጩጋን ጩጋን ደኤይሳታስ ግሽዶሶና። <verse eid="2CH 31:17"/><verse number="18" style="v" sid="2CH 31:18"/>ኤንቲ አማነትድ ባንታና ጌሽዳ ግሾ ኤንቲ ባንታ የለታ ማራን ታይበትያ ዎደ ባንታ ናይታራነ ማቸታራ እስፈ ፃፈትዶሶና። <verse eid="2CH 31:18"/><verse number="19" style="v" sid="2CH 31:19"/>ባንታ ካታማታ ዩሾን ደእያ ሄን ጋደታን ዎይኮ ሀራ ካታማታን ደእያ ካህነ ግድዳ አሮና ሼሻስ፥ ኤንታ ግዶን ደእያ አደ ኡባስነ ሌወታ የለታ ማዝጋበን ፃፈትዳይሳታስ ካ ግሻናዉ ሹመትዶሶና።<verse eid="2CH 31:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 31:20"/>ካዎይ ህዝቅያስ ጎዳ ባ ፆሳ ስንን ሎኦ፥ ሱረነ ቱማ ግድዳባ ይሁዳ ቢታ ኡባን ኦስ። <verse eid="2CH 31:20"/><verse number="21" style="v" sid="2CH 31:21"/>ህዝቅያስ ፆሳ ኬስ ኦዳ ኦሶ ኡባን፥ ፆሳ ህግያነ ዎጋ ናግድ ፆሳ ባ ኩመ ዎዛናን ኮይዳ ግሾ እያዉ ኡባይ እንጀትስ።<verse eid="2CH 31:21"/></para>
  <chapter eid="2CH 31"/>
  <chapter number="32" style="c" sid="2CH 32"/>
  <para style="s1">ሳናክሬም የሩሳላመ ቦላ ደንድስ</para>
  <para style="r">(<ref loc="2KI 18:13-17">2 ካዎ 18:13-17</ref>፤ <ref loc="2KI 19:14-19">19:14-19</ref>፥ <ref loc="2KI 19:35-37">35-37</ref>፤ <ref loc="ISA 36:1-22">እሳ 36:1-22</ref>፤ <ref loc="ISA 37:8-38">37:8-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 32:1"/>ካዎይ ህዝቅያስ አማነተን ጎዳስ ኦዳፐ ጉየ አሶረ ካዎይ ሳናክሬም ይሁዳ ቢታ ቦላ ደንድስ፤ ፆንድ ባዉ ኤካናዉ ቆፕድ ግምበትዳ ካታማታ ተቅስ።<verse eid="2CH 32:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 32:2"/>ሳናክሬም የሩሳላመ ኦላናዉ ይዳይሳ ህዝቅያስ በእዳ ዎደ፥ <verse eid="2CH 32:2"/><verse number="3" style="v" sid="2CH 32:3"/>ካታማፐ ካረራ ጎግያ ፑልቶ ሃታ ተቃናዉ ባ ሹማታነ ቶራ ሞጮናታ ዞረ ኦይችስ፤ ኤንቲ እያ ማድዶሶና። <verse eid="2CH 32:3"/><verse number="4" style="v" sid="2CH 32:4"/>ዳሮ አሳይ ሺቅድ፥ “አሶረ ካዎት ይድ አይስ ሃ ደማኔ?” ያግድ ፑልቶታነ ጎግያ ሃታ ተቅዶሶና።<verse eid="2CH 32:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 32:5"/>ሄሳፈ ጉየ፥ ህዝቅያስ ምን ኦድ፥ ላለትዳ ድርሳ ግምበ ኡባ ዛሪድ ግምብስ፤ እያ ቦላ አዱሳ ሻኮ ሻክስ። ሄ ድርሳ ግምብያፈ ካረ ባጋራ ሀራ ድርሳ ግምበ ግምብስ። ዳዊታ ካታማን ደእያ ሚሎ ጌተትያ በሳ ምንስ፤ ዳሮ ኦላ ሚሸነ ጎንዳለ ጊግስስ።<verse eid="2CH 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 32:6"/>ኦላ ሀላቃታ አሳ ቦላ ሹምስ፤ ኤንታ ኡባ ካታማ ፐንግያ ማታን ደእያ ዳባባን ሺሽድ፥ <verse eid="2CH 32:6"/><verse number="7" style="v" sid="2CH 32:7"/>“ምንተ፤ ገንጭተ፤ ኑራ ደኤይስ ኤንታራ ደኤይሳፈ አያ ግሾ አሶረ ካዋነ እያ ኦላንቾታ በእድ ያዮፍተ፥ ዳጋሞፕተ። <verse eid="2CH 32:7"/><verse number="8" style="v" sid="2CH 32:8"/>እያራ አሳ ዎልቅ ደኤስ፤ ሽን ኑራ ጎዳይ ኑ ፆሳይ ኑና ማዳናዉነ ኑስ ኦለታናዉ ደኤስ” ያግድ ኤንታ ምንስ። ይሁዳ ካዎይ ህዝቅያስ ኦዳን አሳይ ምነትስ።<verse eid="2CH 32:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 32:9"/>ሄሳፈ ጉየ፥ አሶረ ካዎይ ሳናክሬም ባ ኦላንቾታራ ላክሶ ካታማ ተቅድ ደእሽን፥ ይሁዳ ካዋ ህዝቅያሳኮነ የሩሳላመን ደእያ ይሁዳ አሳ ኡባኮ ባ ሹማታ ኪትስ። <verse eid="2CH 32:9"/><verse number="10" style="v" sid="2CH 32:10"/>አሶረ ካዎይ ሳናክሬም፥ “ተቀትዳ የሩሳላመ ካታማን ህንተ ኦናን አማነትድ ኡትደቲ? <verse eid="2CH 32:10"/><verse number="11" style="v" sid="2CH 32:11"/>ህዝቅያስ፥ ‘ጎዳይ፥ ኑ ፆሳይ ኑና፥ አሶረ ካዋ ኩሸፐ አሻና’ ያግድ ጭምድ ህንተና ኮሻንነ ሳሞን ዎናዉ ሀኔስ። <verse eid="2CH 32:11"/><verse number="12" style="v" sid="2CH 32:12"/>ቃ ጎይኖ በሳታነ ያርሾ በሳታ ድግድ፥ ይሁዳነ የሩሳላመ አሳ፥ ‘እስ ያርሾ በሳ ስንን ጎይንተ፤ ያርሹዋ እያ ቦላ ፁግተ’ ያገይ ህዝቅያሳ ግደኔ?<verse eid="2CH 32:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 32:13"/>“ታነ ታ አዋት ሀራ ካዎተታ ቦላ ኦዳባ ህንተ ኤረከቲ? ኤንታ ፆሳት ባንታ ቢታ ታ ኩሸፐ አሻናዉ ዳንዳእዶና? <verse eid="2CH 32:13"/><verse number="14" style="v" sid="2CH 32:14"/>ታ አዋት ይስዳ ሀ ካዎተታ ፆሳታ ኡባ ግዶን ባ አሳ ታ ኩሸፐ አሻናዉ ዳንዳእዳይ ኦኔ? ያትን፥ ህንተ ፆሳይ ህንተና ታ ኩሸፐ ዋት አሻናዉ ዳንዳኢ? <verse eid="2CH 32:14"/><verse number="15" style="v" sid="2CH 32:15"/>ህዛ ህዝቅያስ ህንተና ባለፎ ዎይኮ ሄሳዳ ጭሞፎ። ህንተ ህዝቅያሳ አማኖፕተ። እያ አሳ ታ ኩሸፐ ዎይኮ ታ አዋታ ኩሸፐ አሻናዉ ዳንዳእዳ ሀራ ቢታ ፆሳት ዎይኮ ካዎተታ ፆሳት ባዋ። ያትን፥ ሄስ ህንተ ፆሳይ ህንተና ታ ኩሸፐ አሻናዉ ዋንድ ዳንዳኢ?” ያግዶሶና።<verse eid="2CH 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 32:16"/>ሳናክሬማ ሹማት ጎዳ ፆሳ ቦላነ እያ አይልያ ህዝቅያሳ ቦላ ሀራ ዳሮባ ሃሳይዶሶና። <verse eid="2CH 32:16"/><verse number="17" style="v" sid="2CH 32:17"/>ሳናክሬም ጎዳ እስራኤለ ፆሳ ጫይድ፥ “ሳአ ቦላ ደእያ ካዎተታ ፆሳት ባንታ አሳ ታ ኩሸፐ አሾናይሳዳ ህዝቅያሳ ፆሳይካ ባ አሳ ታ ኩሸፐ አሻናዉ ዳንዳኤና” ያግድ ዳብዳበ ፃፍስ። <verse eid="2CH 32:17"/><verse number="18" style="v" sid="2CH 32:18"/>ሳናክሬማ ሹማት ካታማ ኦይካናዉ ኮይድ፥ ድርሳ ግምበ ቦላ ኡትዳ የሩሳላመ አሳ ያሽሳናዉነ ዳጋንናዉ ባንታ ቃላ ቁ ኦድ፥ እብራወ ዶናን ኤንታ ቦላ ዋስዶሶና። <verse eid="2CH 32:18"/><verse number="19" style="v" sid="2CH 32:19"/>አሳ ኩሸን ኦሰትዳ፥ ሀ ሳአን ደእያ ሀራ ካዎተታ ፆሳታ ቦላ ኦደትዳይሳዳ የሩሳላመ ፆሳ ቦላካ ኦደትዶሶና።<verse eid="2CH 32:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 32:20"/>ካዎይ ህዝቅያስነ አሞፀ ናአይ፥ ናበይ እሳያስ ሄሳ ግሾ ዎሳን ሳሎ ፆሳኮ ፑደ ዋስዶሶና። <verse eid="2CH 32:20"/><verse number="21" style="v" sid="2CH 32:21"/>ፆሳይ ባ ኪታንቹዋ ኪትድ አሶረ ኦላንቾታነ ቶራ ሞጮናታ ይስስ። ሄሳ ግሾ፥ አሶረ ካዎይ ካዉይድ፥ ባ ቢታ ስምስ፤ እ ባ ፆሳ ኬ ገልዳ ዎደ እያ ናይት እያ ሄ በሳን ማሻን ዎዶሶና።<verse eid="2CH 32:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 32:22"/>ሄሳዳ ኦድ፥ ጎዳይ ህዝቅያሳነ የሩሳላመ አሳ አሶረ ካዋ ሳናክሬማ ኩሸፐነ ሀራ ሞርከታ ኩሸፐ አሽስ፤ ኤንታ ሾሮ ቢታታ ኡባፈ ኤንታ ሸምፕስስ። <verse eid="2CH 32:22"/><verse number="23" style="v" sid="2CH 32:23"/>ዳሮ አሳይ ጎዳስ እሞታ፥ ይሁዳ ካዋ ህዝቅያሳስ አልኦ ሚሸ ኤህዶሶና። ሄ ዎደፐ ዶምድ ካዎተ ኡባይ ህዝቅያሳ ዳሮ ቦንችዶሶና።<verse eid="2CH 32:23"/></para>
  <para style="s1">ህዝቅያሳ ኦቶሩዋነ እያ ሀይቁዋ</para>
  <para style="r">(<ref loc="2KI 20:1-3">2 ካዎ 20:1-3</ref>፥ <ref loc="2KI 20:12-19">12-19</ref>፤ <ref loc="ISA 38:1-3">እሳ 38:1-3</ref>፤ <ref loc="ISA 39:1-8">39:1-8</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 32:24"/>ሄ ዎደ ህዝቅያስ ሀርግድ፥ ሀይቃናዉ ማትድ ጎዳ ዎስስ። ጎዳይ ዎሰትድ እያ ፓናዉ ማላ እሚስ። <verse eid="2CH 32:24"/><verse number="25" style="v" sid="2CH 32:25"/>ሽን ህዝቅያስ ኦቶርትዳ ግሾ ጎዳይ እያዉ ኬህዳ ኬሀስ በሲያ ዛሮ እምቤና። ሄሳ ጋሶን፥ እያ ቦላ፥ ይሁዳ ቦላነ የሩሳላመ ቦላ ጎዳ ሀንቆይ ይስ። <verse eid="2CH 32:25"/><verse number="26" style="v" sid="2CH 32:26"/>ግዶሽን፥ ዉርሰን ህዝቅያስ ባ ኦቶሩዋ አግድ የሩሳላመ አሳታራ ባናተ ካዉሽስ። ህዝቅያስ ካዎ ግድድ ደእያ ዎደ ጎዳ ሀንቆይ ኤንታ ቦላ ይቤና።<verse eid="2CH 32:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 32:27"/>ህዝቅያሳስ ዳሮ ዱረተነ ቦንቾይ ደኤስ። ህዝቅያስ ባ ብራ፥ ዎርቃ፥ አልኦ ሹቻ፥ ሳዎ፥ ጎንዳለነ ሀራ አልኦ ሚሸ ኡባ ምንጅያ ኬ ኬፅስ። <verse eid="2CH 32:27"/><verse number="28" style="v" sid="2CH 32:28"/>ካ፥ ዎይነ ኡሻነ ዛይተ ዎያ ኬ ኬፅስ። መሄ ዳራነ ዶርስነ ዴሽ ኤቅያ ግርበ ኦስ። <verse eid="2CH 32:28"/><verse number="29" style="v" sid="2CH 32:29"/>ፆሳይ እያዉ ዳሮ አቆ እምዳ ግሾ ባዉ ካታማታ ኬፅስ፤ ዳሮ ዶርሰነ መሄ ሺሽስ። <verse eid="2CH 32:29"/><verse number="30" style="v" sid="2CH 32:30"/>ቆሞ ባጋን ደእያ ግዮነ ፑልቶ ሃ ዜርድ፥ ሃይ ዉሎሀ ባጋን ደእያ ዳዊታ ካታማኮ ዱገ ጎጋና መላ ኦዳይ ህዝቅያሳ። ህዝቅያስ ኦዳባ ኡባን እንጀትዳ አስ። <verse eid="2CH 32:30"/><verse number="31" style="v" sid="2CH 32:31"/>ሽን ይሁዳ ቢታን ሀንዳ ማላልስያ ኦሶታባ ኦይቻናዉ ባብሎነፐ ኪተትዳ አሳት ህዝቅያሳኮ ይዳ ዎደ ጎዳይ እያ ፓጫናዉነ እያ ዎዛናን ደእያባ ኤራናዉ እያ የድ በስስ።<verse eid="2CH 32:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 32:32"/>ህዝቅያስ ኦዳ ሀራባይነ እያ ኬሀተይ አሞፀ ናኣ፥ ናብያ እሳያሳ ቆንጨ ማፃፋንነ ይሁዳነ እስራኤለ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2CH 32:32"/><verse number="33" style="v" sid="2CH 32:33"/>ህዝቅያስ ሀይቅድ፥ ባ ማይዛታን ጋሄትን ቆሞ ባጋራ ደእያ ዳዊታ ኮቻታ ዱፎን እያ ሞግዶሶና። እ ሀይቅን፥ ይሁዳ አሳይነ የሩሳላመ አሳይ እያ ቦንችዶሶና። እያ በሳን እያ ናአይ ምናሰይ ካዎትስ።<verse eid="2CH 32:33"/></para>
  <chapter eid="2CH 32"/>
  <chapter number="33" style="c" sid="2CH 33"/>
  <para style="s1">ይሁዳ ካዋ ምናሰ</para>
  <para style="r">(<ref loc="2KI 21:1-9">2 ካዎ 21:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 33:1"/>ምናሰይ ካዎትያ ዎደ እያዉ ላይ ታማነ ናምአ፤ እ የሩሳላመን እሻታማነ እቻሹ ላይ ካዎትስ። <verse eid="2CH 33:1"/><verse number="2" style="v" sid="2CH 33:2"/>ጎዳይ እስራኤለ አሳ ስንፈ ጎድድ ከስዳ አሳ፥ እፀትዳ ኦግያ ካልድ ጎዳ ስንን ኢታባ ኦስ። <verse eid="2CH 33:2"/><verse number="3" style="v" sid="2CH 33:3"/>ምናሰይ ባ አዋይ ህዝቅያስ ላልዳ፥ ቃ ጎይኖ በሳታ ዛሪድ ኬፅስ። ባኣለ ያርሾ በሳታነ አሼራ ጌተትያ ኤቃ ምስለታ መስ፤ ሳሎ ፆልንቶታ ጎይንስ፤ ኤንታዉ ጉፋንስ። <verse eid="2CH 33:3"/><verse number="4" style="v" sid="2CH 33:4"/>ጎዳይ፥ “ታ ሱንይ መርናዉ የሩሳላመን ዳና” ያግድ ዎዳ ፆሳ ኬን ምናሰይ ሀራ ፆሳታስ ያርሾ በሲ ጊግስስ። <verse eid="2CH 33:4"/><verse number="5" style="v" sid="2CH 33:5"/>ፆሳ ኬን ደእያ ናምኡ ዳባባታን ሳሎ ፆልንቶት ጎይነትያ ያርሾ በሲ ጊግስስ። <verse eid="2CH 33:5"/><verse number="6" style="v" sid="2CH 33:6"/>ህኖማ ዛንጋራን ባ አደ ናይታ ታማን ፁግድ ያርሽስ። እ ብታነ ሙሩኖ ኦስ፤ ማሮስ፤ ሞይትለነ ቱና አያና ዞረ ኦይችስ። ጎዳ ስንን ዳሮ ኢታባ ኦድ ፆሳ ይሎይስ።<verse eid="2CH 33:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 33:7"/>ባ ኦዳ ኤቃ ምስልያ ኤፍድ ፆሳ ኬን ኤስስ። ሄ ፆሳ ኬይ፥ ፆሳይ ዳዊታስነ እያ ናኣ ሶሎሞነስ፥ “እስራኤለ ዛረ ኡባ ግዶፈ ታኒ ዶርዳ ፆሳ ኬንነ የሩሳላመን ታ ሱን መርናዉ ፄግሳና። <verse eid="2CH 33:7"/><verse number="8" style="v" sid="2CH 33:8"/>ሙሰ ባጋራ ታ እስራኤለ አሳ ኪትዳ ኪታ፥ ህግያነ ዎጋ ኡባ ኤንቲ ናግኮ፥ ታኒ ኤንታ ማይዛታስ እምዳ ቢታፈ ኤንታ ሾድከ” ያግስ። <verse eid="2CH 33:8"/><verse number="9" style="v" sid="2CH 33:9"/>ሽን ምናሰይ ይሁዳ አሳነ የሩሳላመ አሳ ባለድ፥ ጎዳይ እስራኤለ አሳ ስንፈ ይስዳ ሀራ ካዎተታፐ አያ ኢታ ኦና መላ ኦስ።<verse eid="2CH 33:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 33:10"/>ጎዳይ ምናሰስነ እያ አሳስ ኦድስ፤ ሽን ኤንቲ እያ ስኦና እፅዶሶና። <verse eid="2CH 33:10"/><verse number="11" style="v" sid="2CH 33:11"/>ሄሳ ግሾ፥ ጎዳይ አሶረ ኦላንቾታ ኤንታ ቦላ ደንስ። ኤንቲ ምናሰ ስን ዳፎ አድ ኦይክዶሶና፤ ናሰ ብራታ ሳንላታን ቃችድ፥ ባብሎነ ኤፍዶሶና። <verse eid="2CH 33:11"/><verse number="12" style="v" sid="2CH 33:12"/>ምናሰይ ኡንኤትዳ ዎደ ጎዳ ባ ፆሳ ማዶ ዎስስ፤ ባ አዋታ ፆሳ ስንን ባናተ ዳሮ ካዉሽስ። <verse eid="2CH 33:12"/><verse number="13" style="v" sid="2CH 33:13"/>ፆሳይ ምናሰ ዎሳ ስእስ፤ የሩሳላመ ስሚድ ዛሪድ ካዎታና መላ ኦስ። ጎዳይ ቱማ ፆሲ ግደይሳ ምናሰይ ሄሳን ኤርስ።<verse eid="2CH 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 33:14"/>ሄሳፈ ጉየ፥ ምናሰይ ግዮነ ፑልቱዋ ማታን ደእያ በሳፈ ዶምድ ኦፌላ ደርያራ ካንድ ሞሎ ፐንገ ጋካናዉ ካረ ባጋራ ሀራ ድርሳ ግምበ ግምብስ። ሄ ግምበይ ዳዊታ ካታማፐ ዶሎሀ ባጋራ ደእያ ዛንጋራን ደኤስ። ይሁዳ ካታማታ ኡባን ቶራ ሞጮናታ ዎስ።<verse eid="2CH 33:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 33:15"/>አላጋ ፆሳታነ ኤቃ ምስለታ ፆሳ ኬፈ ድግስ፤ ፆሳ ኬይ ደእያ ዙማ ቦላነ የሩሳላመን ደእያ ያርሾ በሳታ ላልድ ሄ ካታማፐ ካረ ከስድ የግስ። <verse eid="2CH 33:15"/><verse number="16" style="v" sid="2CH 33:16"/>ምናሰይ ጎዳ ያርሾ በሲ ኦራድ እስፈተ ያርሾነ ጋላታ ያርሾ ያን ያርሽስ። ይሁዳ አሳይ ጎዳ እስራኤለ ፆሳ ጎይናና መላ ኪትስ። <verse eid="2CH 33:16"/><verse number="17" style="v" sid="2CH 33:17"/>አሳይ ቃ ጎይኖ በሳታን ያርሾ ያርሸይሳ አጎና እፅኮካ፥ ኤንቲ ያርሸይ ጎዳ ባንታ ፆሳ ፃላላሳ።<verse eid="2CH 33:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 33:18"/>ምናሰ ኦዳ ሀራባይ፥ ባ ፆሳ ዎስዳ ዎሳይነ ጎዳ እስራኤለ ፆሳ ሱንን ናበት እያዉ ኦድዳ ቃላይ እስራኤለ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2CH 33:18"/><verse number="19" style="v" sid="2CH 33:19"/>ሄኮ፥ ምናሰ ዎሳይነ ፆሳይ እያዉ ዛርዳ ዛሮይ፥ እ ኦዳ ናጋራይነ ምናሰይ ባና ካዉሻናፐ ስን ኦዳ ቃ ጎይኖ በሳታባይ፥ አሼር ኤቃ ምስለታባይነ ኤቃታባ ኡባይ ናበታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2CH 33:19"/><verse number="20" style="v" sid="2CH 33:20"/>ምናሰይ ሀይቅድ ባ ማይዛታ ጋክስ፤ እያ ካዎ ጋን ሞግዶሶና። እያ በሳን እያ ናአይ አሞፀይ ካዎትስ።<verse eid="2CH 33:20"/></para>
  <para style="s1">ይሁዳ ካዋ አሞፀ</para>
  <para style="r">(<ref loc="2KI 21:19-26">2 ካዎ 21:19-26</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 33:21"/>አሞፀይ ካዎትያ ዎደ እያዉ ላይ ላታማነ ናምአ፤ እ የሩሳላመን ናምኡ ላይ ካዎትስ። <verse eid="2CH 33:21"/><verse number="22" style="v" sid="2CH 33:22"/>እያ አዋይ ምናሰይ ኦዳይሳዳ እካ ጎዳ ስንን ኢታባ ኦስ። እያ አዋይ ምናሰይ ጎይንዳ ኤቃታ ጎይንስ፤ ኤንታዉ ያርሽስ። <verse eid="2CH 33:22"/><verse number="23" style="v" sid="2CH 33:23"/>ሽን እያ አዋይ ምናሰይ ባናተ ካዉሽዳይሳዳ እ ባናተ ጎዳ ስንን ካዉሽቤና፤ አሞፀይ ጉጅ ጉጅ ናጋራ ኦስ።<verse eid="2CH 33:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 33:24"/>አሞፀ ሹማት እያ ቦላ ማቀትድ፥ ካዎ ጋን እያ ዎዶሶና። <verse eid="2CH 33:24"/><verse number="25" style="v" sid="2CH 33:25"/>ይሁዳ አሳይ ካዋ አሞፀ ቦላ ማቀትዳ ኡባ ዎድ፥ አሞፀ በሳን እያ ናኣ እዮስያሳ ካዎዶሶና።<verse eid="2CH 33:25"/></para>
  <chapter eid="2CH 33"/>
  <chapter number="34" style="c" sid="2CH 34"/>
  <para style="s1">ይሁዳ ካዋ እዮስያሳ</para>
  <para style="r">(<ref loc="2KI 22:1-2">2 ካዎ 22:1-2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 34:1"/>እዮስያስ ካዎትያ ዎደ እያዉ ላይ ሆስፑና፤ እ የሩሳላመን ሀስታማነ እስ ላይ ካዎትስ። <verse eid="2CH 34:1"/><verse number="2" style="v" sid="2CH 34:2"/>እዮስያስ ጎዳ ስንን ሱረባ ኦስ፤ ኡሻች ሀድርስ ጎና ባ ማይዛ ዳዊታ ኦገን ሄመትስ።<verse eid="2CH 34:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 34:3"/>እ ካዎትዳ ሆስፑን ላይን ቡሮ ዮጋ ደእሸ ባ ማይዛ ዳዊታ ፆሳ ኮይስ። እ ካዎትዳ ታማነ ናምአን ላይን ይሁዳንነ የሩሳላመን ደእያ ቃ ጎይኖ በሳታ፥ አሼራ ኤቃ ምስለታ፥ ማስድ ጊግስዳ ኤቃታነ ሴርስድ ኦዳ ምስለታ ይስስ። <verse eid="2CH 34:3"/><verse number="4" style="v" sid="2CH 34:4"/>እያ ኪታን፥ ባኣለ ያርሾ በሳታ ላልዶሶና፤ ኤንታፈ ቦላራ ደእያ እፃነ ጩይስያ ሚሸታ ትንችዶሶና። አሼራ ኤቃ ምስለታ፥ ማስድ ጊግስዳ ኤቃታነ ሴርስድ ኦዳ ምስለታ ጋጭድ ለ ከስዶሶና፤ ሄ ልያ ኤንታ ጎይንያ አሳታ ዱፎን ላልዶሶና። <verse eid="2CH 34:4"/><verse number="5" style="v" sid="2CH 34:5"/>እዮስያስ ኤንታ ካህነታ መቀ ሄ ያርሾ በሳታ ቦላ ፁግስ፤ ያትድ፥ ይሁዳነ የሩሳላመ ጌሽስ።<verse eid="2CH 34:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 34:6"/>ምናሰ፥ ኤፍሬማነ ስሞና ቢታፈ ብድ ንፍታለመ ቢታ ጋካናዉ ደእያ ካታማታነ ላለትዳ በሳታ ኡባ ሄሳዳ ኦድ ጌሽስ። <verse eid="2CH 34:6"/><verse number="7" style="v" sid="2CH 34:7"/>እዮስያስ ያርሾ በሳታ ላልስ፤ አሼራ ኤቃ ምስለታነ ሀራ ኤቃ ምስለታ ትንቸረስ፤ እስራኤለን ደእያ እፃነ ጩይስያ በሳታ ቃንፀረስ። ሄሳፈ ጉየ፥ እዮስያስ የሩሳላመ ስምስ።<verse eid="2CH 34:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 34:8"/>እዮስያስ ካዎትዳ ታማነ ሆስፑን ላይን ቢታነ ፆሳ ኬ ጌሽዳፐ ጉየ፥ ፆሳ ኬ ኦራና መላ አፃላ ናኣ ሳፋና፥ የሩሳላመ ካታማ ሃርያ ማእሰያነ እዮአካዛ ናኣ ዋና ፃፍያ እዮአክና ኪትስ።<verse eid="2CH 34:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 34:9"/>ኤንቲ ካህነ ሀላቃ ካልቅያሳኮ ብዶሶና። ፐንገ ናግያ ሌወት ምናሰፐ፥ ኤፍሬማፐ፥ አትዳ እስራኤለ አሳ ኡባፈ ይሁዳፐ፥ ብንያመፐነ የሩሳላመን ደእያ አሳፐ ካሰ ሺሽድ ፆሳ ኬ ኤህዳ ሚሽያ ካልቀስ እምዶሶና። <verse eid="2CH 34:9"/><verse number="10" style="v" sid="2CH 34:10"/>ኤንቲ ፆሳ ኬ ኦራያ ሀላቃታስ እምን ኤንቲ ፆሳ ኬ ኦራናዳነ ዛሪድ ኬፃና መላ ኦሳንቾታስ እምዶሶና። <verse eid="2CH 34:10"/><verse number="11" style="v" sid="2CH 34:11"/>ይሁዳ ካዎት ላልዳ ፆሳ ኬ ሎይናዉ ምነ ማሰትዳ ሹቹ ሻማና መላ አናፀታስነ ግምበይሳታስ ሚሸ እምዶሶና።<verse eid="2CH 34:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 34:12"/>አሳይ አማነትድ ኦሱዋ ፖልዶሶና። ኤንታ ቦላ ሹመትዳ ኦይዱ ሌወት፥ ማራራ ያራፐ ያሃታነ አብድዩ፥ ቃሃታ ያራፐ ማሱላማነ ዛካርያሳ። የ ሚሸ ካእ ኤርያ ሌወት ኡባይ፥ <verse eid="2CH 34:12"/><verse number="13" style="v" sid="2CH 34:13"/>ዎልቃ ኦሶ ኦያ አሳታ ቦላነ ዱማ ዱማ ኦሶ ኦይሳታ ቦላ ሹመትዶሶና። ቃስ ሀራ ሌወት ፃፈ፥ ሀላቃነ ፐንገ ናገይሳታ ግድዶሶና።<verse eid="2CH 34:13"/></para>
  <para style="s1">ህገ ማፃፋይ በንትስ</para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 34:14"/>ኤንቲ ፆሳ ኬ ይዳ ሚሽያ ከስያ ዎደ ካህነይ ካልቀይ ጎዳይ ሙሰ ባጋራ እምዳ ህገ ማፃፋ ደምስ። <verse eid="2CH 34:14"/><verse number="15" style="v" sid="2CH 34:15"/>ካልቀይ ዋና ፃፍያ ሳፋናኮ፥ “ታኒ ፆሳ ኬፈ ህገ ማፃፋ ደማስ” ያግስ። ሄ ማፃፋ ሳፋናስ እሚስ።<verse eid="2CH 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 34:16"/>ሳፋን ማፃፋ ካዋኮ ኤፍድ፥ “ነ ሹማት ነ ኪታ ኡባ ኦዶሶና። <verse eid="2CH 34:16"/><verse number="17" style="v" sid="2CH 34:17"/>ፆሳ ኬን ደእያ ሚሽያ ኤክድ፥ ኦሱዋ ካልያ ሀላቃታስነ ኦያ አሳስ እምዶሶና” ያግስ። <verse eid="2CH 34:17"/><verse number="18" style="v" sid="2CH 34:18"/>ዋና ፃፈይ ሳፋን ካዋኮ፥ “ካህነይ ካልቀይ ታዉ ማፃፋ እሚስ” ያግድ ማፃፋ ካዋ ስንን ናባብስ።<verse eid="2CH 34:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 34:19"/>ካዎይ ህገ ቃላ ስእዳ ዎደ አዛንድ ባ ማኡዋ ፔስ። <verse eid="2CH 34:19"/><verse number="20" style="v" sid="2CH 34:20"/>ካዎይ፥ ካልቀ፥ ሳፋና ናኣ አክቃማ፥ ምክያሳ ናኣ አብዶና፥ ዋና ፃፍያ ሳፋናነ ካዎ ሹማ አሳያ ሀይሳዳ ያግድ ኪትስ፤ <verse eid="2CH 34:20"/><verse number="21" style="v" sid="2CH 34:21"/>“ብድ ታ ግሾነ እስራኤለንነ ይሁዳን አትዳ አሳታ ግሾ ሀ በንትዳ ማፃፋን ፃፈትዳባ ጎዳ ኦይችተ። ሀ ማፃፋን ፃፈትዳ ኡባ ኦናዉ ኑ ማይዛት ጎዳ ቃላ ናግቦና ግሾ ጎዳይ ኑ ቦላ ባ ሀንቁዋ ጉስስ” ያግስ።<verse eid="2CH 34:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 34:22"/>ካልቀይነ ካዎይ ኪትዳ አሳት ፆሳ ኬን ማኦ ናግያ ሀስራ ናአ፥ ትቁዋ ናአ፥ ሰለማ ማቾ ግድዳ ሁልዳ ጌተትያ ናበኮ ብድ እዮ ኦይችዶሶና። እያ የሩሳላመን ናምአን ካታማን ደአዉሱ።<verse eid="2CH 34:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 34:23"/>ሁልዳ ኤንታኮ፥ “ጎዳይ እስራኤለ ፆሳይ፥ ‘ህንተና ታኮ ኪትዳ ኡራስ ሀይሳዳ ያግድ ኦድተ’ ያጋሱ። <verse eid="2CH 34:23"/><verse number="24" style="v" sid="2CH 34:24"/>ጎዳይ ሀይሳዳ ያጌስ፤ ‘ይሁዳ ካዋ ስንን ናባበትዳ ማፃፋን ፃፈትዳ ኢታ ባደ ኡባ ሀ በሳን ደእያ አሳ ቦላ ኤሀና ሀናይስ። <verse eid="2CH 34:24"/><verse number="25" style="v" sid="2CH 34:25"/>ኤንቲ ታና አግድ ሀራ ፆሳታስ እፃነ ጩይስዶሶና፤ ኤንቲ ባንታ ኩሸን ኦዳባን ታና ሀንቀዶሶና። ሄሳ ግሾ፥ ታ ሀንቆይ ሀ በሳን ትገታና፤ ተቀተና።’ <verse eid="2CH 34:25"/><verse number="26" style="v" sid="2CH 34:26"/>ጎዳ ኦይቻናዉ ህንተና ኪትዳ ይሁዳ ካዋኮ፥ ‘ጎዳይ እስራኤለ ፆሳይ ኔኒ ስእዳ ቃላባ ሀይሳዳ ያጌስ፤ <verse eid="2CH 34:26"/><verse number="27" style="v" sid="2CH 34:27"/>ሀ በሳንነ ሀ በሳን ደእያ አሳ ቦላ ፆሳይ ኦደትዳባ ኔኒ ስእዳ ዎደ ነ ዎዛናይ ቦሸትን፥ ታ ስንን ነናተ ካዉሽዳ ግሾነ ነ ማኡዋ ፔዳ ታ ስንን ዬክዳ ግሾ ታኒ ነ ዎሳ ስአስ። <verse eid="2CH 34:27"/><verse number="28" style="v" sid="2CH 34:28"/>ሄኮ፥ ታ ነና ነ ማይዛታ ጋና፤ ነ ሳሮ ሞገታና። ታ ሀ በሳንነ ሀ በሳን ደእያ አሳ ቦላ ኤሀና ኢታባ ነ አይፈይ በኤና’ ያግተ” ያጋሱ።</para>
  <para style="p" vid="2CH 34:28">ኤንቲ ብድ ሀ ቃላ ካዋስ ኦድዶሶና።<verse eid="2CH 34:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 34:29"/>ሄሳፈ ጉየ፥ ካዎይ እዮስያስ ይሁዳ ጭማታነ የሩሳላመ ጭማታ ኡባ ሺሽስ። <verse eid="2CH 34:29"/><verse number="30" style="v" sid="2CH 34:30"/>ካዎይ ፆሳ ኬ ከይስ፤ ይሁዳ አሳይ፥ የሩሳላመ አሳይ፥ ካህነትነ ሌወት፥ ጉፈ ግታ ጋካናዉ ኡባይ እያራ እስፈ ከይዶሶና። ፆሳ ኬን በንትዳ ጫቆ ማፃፋ ቃላ ኡባ ካዎይ ኤንታዉ ናባብስ። <verse eid="2CH 34:30"/><verse number="31" style="v" sid="2CH 34:31"/>ካዎይ ባ በሳን ኤቅድ፥ ጎዳ ኦገን ሄመታናዉነ እያ ህግያ፥ እያ ዎጋነ እያ ኪታ ባ ኩመ ዎዛናንነ ባ ኩመ ሸምፑዋን ናጋናዉ፥ ቃስ ሀ ማፃፋን ፃፈትዳ ጫቁዋ ኦናዉ ጎዳ ስንን ጫቅስ። <verse eid="2CH 34:31"/><verse number="32" style="v" sid="2CH 34:32"/>የሩሳላመንነ ብንያመን ደእያ አሳ ኡባይ ኤቅድ ጫቃና መላ ኦስ፤ የሩሳላመን ደእያ አሳይ ፆሳ፥ ባንታ ማይዛታ ፆሳ ጫቆይ ገይሳዳ ኦዶሶና።<verse eid="2CH 34:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="2CH 34:33"/>እዮስያስ እስራኤለ ዛዋን ደእያ እፀትዳባ ኡባ ድግስ። እስራኤለን ደእያ ኡባይ ጎዳ፥ ባንታ ፆሳ ጎይናና መላ ኦስ። እዮስያስ ደእዳ ላይ ኡባን ኤንቲ ጎዳ፥ ባንታ ማይዛታ ፆሳ ካሎ አግቦኮና።<verse eid="2CH 34:33"/></para>
  <chapter eid="2CH 34"/>
  <chapter number="35" style="c" sid="2CH 35"/>
  <para style="s1">እዮስያስ ፓስካ ባኣለ ቦንችስ</para>
  <para style="r">(<ref loc="2KI 23:21-23">2 ካዎ 23:21-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 35:1"/>እዮስያስ የሩሳላመን ጎዳ ፓስካ ባኣለ ቦንችስ። ኮይሮ አጌናን ታማነ ኦይዳን ጋላስ ፓስካ ዶርሳ ሹክዶሶና። <verse eid="2CH 35:1"/><verse number="2" style="v" sid="2CH 35:2"/>እዮስያስ ካህነታ ኦሶን ሹምድ፥ ኤንታ ፆሳ ኬ ኦሶን ምንስ። <verse eid="2CH 35:2"/><verse number="3" style="v" sid="2CH 35:3"/>ባንታና ጎዳስ ዱማይዳ፥ እስራኤለ ኡባ ታማርስያ ሌወታ ሀይሳዳ ያግስ፤ “ጌሻ ታቦትያ ዳዊታ ናአይ፥ እስራኤለ ካዎይ ሶሎሞነይ ኬፅዳ ፆሳ ኬን ዎተ። ህዛፐ ጉየ ታቦትያ ህንተ ሀሸን ቶካናዉ ኮሸና። ሀእ ጎዳስ፥ ህንተ ፆሳስነ፥ እያ አሳ እስራኤለስ ኦተ። <verse eid="2CH 35:3"/><verse number="4" style="v" sid="2CH 35:4"/>እስራኤለ ካዎይ ዳዊቲነ እያ ናአይ ሶሎሞነይ ፃፍዳይሳዳ ህንተ ጩጋን ጩጋንነ ህንተ ሶ አሳን አሳን ህንተና ጊግስተ። <verse eid="2CH 35:4"/><verse number="5" style="v" sid="2CH 35:5"/>ሌወት ህንተ ዳቦታ፥ እስራኤለ ኮቻታ ማዳናዉ ህንተ ያራን ያራን ፆሳ ኬን ኤቅተ። <verse eid="2CH 35:5"/><verse number="6" style="v" sid="2CH 35:6"/>ጎዳይ ሙሰ ባጋራ ኦድዳ ቃላ እስራኤለ አሳይ፥ ህንተ ዳቦት ናጋና መላ ግግስተ፤ ህንተካ ህንተናተ ጌሽተ ፓስካ ዶርሳ ሹክተ” ያግስ።<verse eid="2CH 35:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 35:7"/>እዮስያስ ሄ በሳን ደእያ አሳስ፥ ፓስካ ያርሾ ግዳና መላ 30,000 ዶርሰነ ዴሸ እሚስ፤ ቃስ 3,000 ኮርማታ እሚስ። ሄ ኡባ ካዎይ ባ ሻሉዋፐ እሚስ። <verse eid="2CH 35:7"/><verse number="8" style="v" sid="2CH 35:8"/>ካዎ ሹማት ባንታ ሸነን አሳስ፥ ካህነታስነ ሌወታስ ያርሾ መሄ እምዶሶና። ፆሳ ኬ ሀላቃት ካልቀይ፥ ዛካርያስነ ይኤል ፓስካ ያርሾስ ግድያ ናምኡ ሙኩሉነ ኡሱፑን ፄቱ ማራዘታ፥ ሄ ፄቱ ኮርማታ እምዶሶና። <verse eid="2CH 35:8"/><verse number="9" style="v" sid="2CH 35:9"/>ሌወታ ሀላቃት ኮናነይነ እያ እሻት፥ ሻማየይነ ናትናኤል፥ ቃስ ሀሻብ፥ ይኤልነ ዮዛባት ፓስካ ያርሾስ ሀንያ እቻሹ ሙኩሉ ማራዘታነ ኮለታ፥ እቻሹ ፄቱ ኮርማታ እምዶሶና።<verse eid="2CH 35:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 35:10"/>ፓስካ ባልያስ ኡባባይ ጊግስ፤ ካዋ ኪታን፥ ካህነት ባንታ በሳን በሳን፥ ሌወት ባንታ ጩጋን ጩጋን ኤቅዶሶና። <verse eid="2CH 35:10"/><verse number="11" style="v" sid="2CH 35:11"/>ፓስካ ዶርሳት ሹከትዶሶና፤ ሌወት ጋልባ ቃርዶሶና፤ ካህነት ሱ ያርሾ በሳ ቦላ ርጮሶና። <verse eid="2CH 35:11"/><verse number="12" style="v" sid="2CH 35:12"/>ሙሰ ማፃፋን ፃፈትዳይሳዳ አሳይ ጎዳስ ያርሻና መላ ፁሳ ያርሾስ ጊግዳ ዶርሳታ አሹዋ ሌወት ባንታ ሶ አሳን አሳን ሻከትድ ኡትዳ እስራኤለ ያራታስ እምዶሶና፤ ኮርማታካ ሄሳዳ ኦዶሶና። <verse eid="2CH 35:12"/><verse number="13" style="v" sid="2CH 35:13"/>ሌወት ዎጋይ ኪተይሳዳ ሹከትዳ ፓስካ ዶርሳ አሹዋ ታማን ጫጭዶሶና፤ ጌሻ ያርሾታ ፃሮን፥ ኦቶንነ ድስተን ዶይስድ፥ እስራኤለ አሳ ኡባስ ኤሶን ሻክድ ሻክድ እምዶሶና።<verse eid="2CH 35:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 35:14"/>ሄሳፈ ጉየ፥ ሌወት ባንታዉነ አሮና ኮቸ ግድዳ ካህነታስ ፓስካ ያርሾ ጊግስዶሶና። ሄሳ ኤንቲ ኦዳይ፥ ካህነት ፁሳ ያርሾነ ሞዋ ያርሽሸ ቃማ ጋካናዉ ኦያ ግሾሳ። <verse eid="2CH 35:14"/><verse number="15" style="v" sid="2CH 35:15"/>ዳዊቲ፥ አሳፍ፥ ሄማንነ ካዋ ናበይ ኤድታም ካሰ ኪትዳይሳዳ አሳፋ ያራት፥ ማዝሙረ የፀይሳት ባንታ በሳን ደኦሶና። ፐንገ ናገይሳት ባንታ በሳን ደኦሶና። ኤንታ ዳቦት፥ ሌወት ኤንታዉ ጊግስዳ ግሾ ኤንቲ ባንታ ኦሱዋ አግቦኮና።<verse eid="2CH 35:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 35:16"/>ጎዳስ ኦያ ኦሶ ኡባይ፥ ፓስካ ባኣለ ቦንቾይነ ፁሳ ያርሾይ፥ ካዎይ እዮስያስ ኪትዳይሳዳ ሀንድ ሄ ጋላስ ጊግስ። <verse eid="2CH 35:16"/><verse number="17" style="v" sid="2CH 35:17"/>ያን ሺቅዳ እስራኤለ አሳይ ሄ ጋላስ ፓስካ ባልያ ቦንችዶሶና፤ ኤንቲ ኡይ ባኣለ ላፑን ጋላስ ቦንችዶሶና። <verse eid="2CH 35:17"/><verse number="18" style="v" sid="2CH 35:18"/>ናብያ ሳሜላ ዎድያፐ ዶምን፥ ሄሳ መላ ፓስካ ባለይ እስራኤለን ቦንቸትቤና። እዮስያስ፥ ካህነት፥ ሌወት፥ ይሁዳ አሳይ፥ እስራኤለ አሳይነ የሩሳላመ አሳይ ቦንችዳይሳዳ ፓስካ ባኣለ ካሰ እስራኤለ ካዎታፐ ቦንችዳ እሶይካ ባዋ። <verse eid="2CH 35:18"/><verse number="19" style="v" sid="2CH 35:19"/>ፓስካ ባለይ እዮስያስ ካዎትዳ ታማነ ሆስፑን ላይን ቦንቸትስ።<verse eid="2CH 35:19"/></para>
  <para style="s1">እዮስያሳ ዉርሰ</para>
  <para style="r">(<ref loc="2KI 23:28-30">2 ካዎ 23:28-30</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 35:20"/>እዮስያስ ፆሳ ኬ ጊግስዳፐ ጉየ ግብፀ ካዎይ ናኮይ ኤፍራፂሳ ሻፋ ማታን ደእያ ካርካምሻን ኦለታናዉ ብስ። እዮስያስ እያ ተቃናዉ ከይስ። <verse eid="2CH 35:20"/><verse number="21" style="v" sid="2CH 35:21"/>ሽን ናኮይ እዮስያሳኮ አሰ ኪትድ፥ “ይሁዳ ካዋዉ፥ ታናነ ነና ካችያባይ አይቤ? ታኒ ይዳይ ታ ሞርከታ ኦላናሳፈ አትሽን፥ ነና ኦላናሳ ግደና። ታ ሞርከታ ታኒ ኤሶን ኦላናዳ ፆሳይ ታና ኪትስ። ፆሳይ ነና ይሶናዳ ታራ ደእያ ፆሳራ ኤቀተይሳ አጋ” ያግስ።<verse eid="2CH 35:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 35:22"/>ግዶሽን፥ እዮስያስ ጎዳይ ናኮ ባጋራ ኦድዳይሳ ስኦናነ ጉየ ስሞና እፅስ። ባ ካዎ ማኡዋ ላምድ ማግዶ ደንባን ኦለታናዉ ብስ።<verse eid="2CH 35:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 35:23"/>ዶንገን ዱከይሳት ካዋ እዮስያሳ ጫድን፥ ካዎይ ባ አይለታኮ፥ “ታኒ ኢታ ጫደትዳ ግሾ ታና ኦላ ግዶፈ ከስተ” ያግስ። <verse eid="2CH 35:23"/><verse number="24" style="v" sid="2CH 35:24"/>እዮስያሳ ፓራ ጋርያፐ ዎስድ፥ እያ ፓራ ጋርያን ዎድ፥ እያ የሩሳላመ ኤህዶሶና። እ ያን ሀይቅድ ባ ማይዛታ ዱፎን ሞገትስ። ይሁዳ አሳይነ የሩሳላመ አሳ ኡባይ እያዉ ዬክዶሶና።<verse eid="2CH 35:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 35:25"/>ናበይ ኤርምያስ እዮስያሳስ ዘለልስ ከስድ ፃፍስ። ዘሌልድ ዬክያ ማጫሳይነ አደ ኡባይ ሀች ጋካናዉ እዮስያሳስ ቆፖሶና። ሄ ዘለልሳይ እስራኤለ ዬሆ ዘለልሳ ማፃፋን ፃፈትስ።<verse eid="2CH 35:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 35:26"/>እዮስያስ ኦዳ ሀራባይ፥ ጎዳ ህገን ማፃፋን ፃፈትዳይሳ መላ እ ኦዳ ሎኦ ኦሶይነ <verse eid="2CH 35:26"/><verse number="27" style="v" sid="2CH 35:27"/>ኮይሮፐ ዉርሰ ጋካናዉ እ ኦዳ ኡባይ፥ ሄኮ፥ እስራኤለ ካዎታነ ይሁዳ ካዎታ ታርከ ማፃፋን ፃፈትስ።<verse eid="2CH 35:27"/></para>
  <chapter eid="2CH 35"/>
  <chapter number="36" style="c" sid="2CH 36"/>
  <para style="s1">ይሁዳ ካዋ እዮአካዛ</para>
  <para style="r">(<ref loc="2KI 23:30-35">2 ካዎ 23:30-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 36:1"/>ሄ ቢታ አሳይ እዮስያሳ ናኣ እዮአካዛ ዶርድ እያ አዋ በሳን የሩሳላመን ካዎዶሶና። <verse eid="2CH 36:1"/><verse number="2" style="v" sid="2CH 36:2"/>እዮአካዝ ካዎትያ ዎደ እያዉ ላይ ላታማነ ሄ፤ እ የሩሳላመን ሄ አጌና ካዎትስ። <verse eid="2CH 36:2"/><verse number="3" style="v" sid="2CH 36:3"/>ግብፀ ካዎይ እዮአካዛ ካዎተፈ ዎስ፤ ሄ ሙኩሉነ ኦይዱ ፄቱ ክሎ ግራመ ብራነ ሀስታማነ ኦይዱ ክሎ ግራመ ዎርቃ ይሁዳ አሳይ ጊራና መላ ኦስ። <verse eid="2CH 36:3"/><verse number="4" style="v" sid="2CH 36:4"/>ግብፀ ካዎይ፥ ናኮይ፥ እዮአካዛ እሻ ኤልያቄመ ይሁዳ ቦላነ የሩሳላመ ቦላ ካዎድ እያ ሱን እዮአቄማ ያግድ ላምስ። ያትድ እዮአቄማ እሻ እዮአካዛ ግብፀ ኤፍስ።<verse eid="2CH 36:4"/></para>
  <para style="s1">ይሁዳ ካዋ እዮአቄማ</para>
  <para style="r">(<ref loc="2KI 23:36-24:7">2 ካዎ 23:36—24:7</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 36:5"/>እዮአቄም ካዎትያ ዎደ እያዉ ላይ ላታማነ እቻሻ፤ እ የሩሳላመን ታማነ እስ ላይ ካዎትስ። ባ ጎዳ ፆሳ ስንን ኢታባ ኦስ። <verse eid="2CH 36:5"/><verse number="6" style="v" sid="2CH 36:6"/>ባብሎነ ካዎይ ናቡካዳናፆር እያ ኦልድ፥ ባብሎነ ኤፋናዉ ናሰ ብራታ ሳንላታን ቃችስ። <verse eid="2CH 36:6"/><verse number="7" style="v" sid="2CH 36:7"/>ቃስ ናቡካዳናፆር ፆሳ ኬ ሚሽያ ኤክድ ባብሎነ ኤፍድ፥ ባ ካዎ ጋን ዎስ።<verse eid="2CH 36:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 36:8"/>እዮአቄም ኦዳ ሀራባይ፥ ኦዳ ቱናባይነ ኦዳ ኢታባ ኡባይ፥ ሄኮ፥ እስራኤለ ካዎታነ ይሁዳ ካዎታ ታርከ ማፃፋን ፃፈትስ። እ ሀይቅን፥ እያ በሳን እያ ናአይ ዮአክን ካዎትስ።<verse eid="2CH 36:8"/></para>
  <para style="s1">ይሁዳ ካዋ ዮአክና</para>
  <para style="r">(<ref loc="2KI 24:8-17">2 ካዎ 24:8-17</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 36:9"/>ዮአክን ካዎትያ ዎደ እያዉ ላይ ሆስፑና፤ እ የሩሳላመን ሄ አጌናነ ታሙ ጋላስ ካዎትስ። እ ጎዳ ስንን ኢታባ ኦስ። <verse eid="2CH 36:9"/><verse number="10" style="v" sid="2CH 36:10"/>ላይ ላመን፥ ካዎይ ናቡካዳናፆር አሰ ኪትድ፥ ዮአክናነ ፆሳ ኬን ደእያ አልኦ ሚሸታ እያራ እስፈ ባብሎነ ኤህስ። ያትድ እያ አዋ እሻ ሰደቅያሳ ይሁዳነ የሩሳላመ ቦላ ካዎስ።<verse eid="2CH 36:10"/></para>
  <para style="s1">ይሁዳ ካዋ ሰደቅያሳ</para>
  <para style="r">(<ref loc="2KI 24:18-20">2 ካዎ 24:18-20</ref>፤ <ref loc="JER 52:1-3">ኤርም 52:1-3</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 36:11"/>ሰደቅያስ ካዎትያ ዎደ እያዉ ላይ ላታማነ እስኖ፤ እ የሩሳላመን ታማነ እስ ላይ ካዎትስ። <verse eid="2CH 36:11"/><verse number="12" style="v" sid="2CH 36:12"/>ባ ጎዳ ፆሳ ስንን ኢታባ ኦስ፤ ቃስ ጎዳ ቃላ ኦድያ ናብያ ኤርምያሳ ስንን ባና ካዉሽቤና።<verse eid="2CH 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 36:13"/>ሰደቅያስ፥ አማነታና መላ ባና ፆሳ ሱንን ጫቅስዳ ናቡካዳናፆራ ቦላ ማካልስ። ጎዳ፥ እስራኤለ ፆሳኮ ስሞና እፅስ፤ ባ ዎዛና ፆሳ ቦላ ምንስ። <verse eid="2CH 36:13"/><verse number="14" style="v" sid="2CH 36:14"/>ቃስ፥ ይሁዳ አሳይነ ኤንታ ካለያ ካህነት፥ አማነቶና እፅዶሶና። ኤንቲ ሀራ ካዎተት ኦያ እፀትዳ ኦሶታ ካልድ፥ ጎዳይ የሩሳላመን ጌሽዳ ፆሳ ኬ ቱንስዶሶና።<verse eid="2CH 36:14"/></para>
  <para style="s1">የሩሳላመ ኩንደ</para>
  <para style="r">(<ref loc="2KI 25:1-21">2 ካዎ 25:1-21</ref>፤ <ref loc="JER 52:3-11">ኤርም 52:3-11</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 36:15"/>ጎዳይ፥ ኤንታ ማይዛታ ፆሳይ ባ አሳስነ ባ ኬስ ቃትያ ግሾ፥ ባ ናበታ ኤንታዉ ዛር ዛር ኪትስ። <verse eid="2CH 36:15"/><verse number="16" style="v" sid="2CH 36:16"/>ሽን ጎዳ ሀንቆይ ኤንታ ቦላ ዎና ጋካናዉነ ኤንቲ ከስ ኤክያሶ ያና ጋካናዉ ፆሳ ኪታንቾታ ቀልቅስዶሶና፤ እያ ቃላ ካዶሶና፤ ናበታ ቦላ ሚጭዶሶና። <verse eid="2CH 36:16"/><verse number="17" style="v" sid="2CH 36:17"/>ሄሳ ግሾ፥ ጎዳይ ካልዳወታ ካዋ ኤንታ ቦላ ደንን፥ እ ኤንታ ያላጋ አደታ ፆሳ ኬን ማሻን ዎስ። እ ያላጋ አደታስ ዎይኮ ጌላኦታስ ዎይኮ ጭማታስ ዎይኮ ጬጋታስ ቃቶና ዉርስስ። ፆሳይ ኤንታ ኡባ ናቡካዳናፆራ ኩሸን አድ እሚስ። <verse eid="2CH 36:17"/><verse number="18" style="v" sid="2CH 36:18"/>ባብሎነ ካዎይ ፆሳ ኬን ደእያ ሚሸታ ኡባ፥ ግታነ ጉ፥ ፆሳ ኬን ደእያ ቡቁራ፥ ካዎ ቡቁራነ እያ ሞርናታ ቡቁራ ኡባ ኤክድ ባብሎነ ኤፍስ። <verse eid="2CH 36:18"/><verse number="19" style="v" sid="2CH 36:19"/>ኤንቲ ፆሳ ኬ ታማን ፁግድ፥ የሩሳላመ ግምበ ድርሳ ላልዶሶና። ካዎ ጋዋ ታማን ፁግድ፥ ያን ደእያ አልኦ ሚሸ ኡባ ይስዶሶና።<verse eid="2CH 36:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 36:20"/>ማሻፈ አትዳይሳታ ካዎይ ድእድ ባብሎነ ኤፍስ። ፋርሰ ካዎተይ ደንዳና ጋካናዉ ኤንቲ እያዉነ እያ ናይታስ አይለ ግድዶሶና። <verse eid="2CH 36:20"/><verse number="21" style="v" sid="2CH 36:21"/>ጎዳይ ናብያ ኤርምያሳ ባጋራ ኦድዳ ቃላይ ፖለትስ። ዉርሰን ቢታይ ላፑን ታሙ ላይ አስ ባይና በሲ ግድድ ሸምፕስ። ቢታይ ሳምባታ ሸምፖ ደምስ።<verse eid="2CH 36:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 36:22"/>ፋርሰ ካዎይ ቅሮስ ካዎትዳ ኮይሮ ላይን ናብያ ኤርምያሳ ባጋራ ጎዳይ ኦድዳይሳ ፖልስ። ፋርሰ ካዎይ ቅሮስ ባ ካዎተን ኡባን ሀይሳዳ ያግድ አዋጃና መላነ ፃፍድ ዎና መላ ጎዳይ እያ አያና ደንስ። <verse eid="2CH 36:22"/><verse number="23" style="v" sid="2CH 36:23"/>ፋርሰ ካዎይ ቅሮስ፥ “ጎዳይ፥ ሳሎ ፆሳይ ሀ ሳኣ ካዎተታ ኡባ ታዉ እሚስ። ቃስ ይሁዳን ደእያ የሩሳላመን ታ እያዉ ፆሳ ኬ ኬፃና መላ ታና ሹምስ። ፆሳ አስ ግድዳ ኦንካ ያ ቦ። ጎዳይ እያ ፆሳይ እያራ ግዶ” ያግስ።<verse eid="2CH 36:23"/></para>
  <chapter eid="2CH 36"/>
</usx>
