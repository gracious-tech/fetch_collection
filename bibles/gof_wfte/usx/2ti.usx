<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">2 ፅሞትዮሳ ኪታ</para>
  <para style="toc1">2 ፅሞትዮሳ ኪታ</para>
  <para style="toc3">2 ፅሞ</para>
  <para style="toc2">2 ፅሞትዮሳ</para>
  <para style="mt1">ጳዉሎስ ፅሞትዮሳስ</para>
  <para style="mt2">ፃፍዳ ናምአን ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ጳዉሎስ ፅሞትዮሳስ ፃፍዳ ናምአን ኪታይ፥ ጳዉሎሳራ እስፈ ኦያነ ጳዉሎሳ ማታን ማድያ ናአተ፥ ፅሞትዮሳ ዞርዳ ዞርያ ኦይክስ። ሄ ዞርያ አይፈ ቆፋይ፥ “ገንጫን ምናናዉ በሴስ” ግያ ዞረ። ፅሞትዮስ ዞረነ ምን ቃላ ኤክዳይ፥ የሱስ ክርስቶሳባ ቱማ ማርካታና መላ፥ ዎንገላ ቃላነ ጋልአ ጫቆ ትምርትያ ምንድ ኦይካና መላነ መቶይነ እፆይ ዳርኮካ ታማርሶንነ ዎንገላ ሳባኮን ምናና መላሳ።</para>
  <para style="ip">ፅሞትዮስ፥ ሀዳነ ኤያተ ፓላማፐ ሃካና መላ እያዉ ዱማ ምኖ ዞረይ እመትስ። ሄሳ መላ ኦዳይ አሰ ይሰስፐ አትሽን አይኮካ ማደና።</para>
  <para style="ip">ሄ ኡባን ፅሞትዮስ አኬካናዉ በሲያባይ፥ ጳዉሎሳ ሀኖታነ እያ ዱሳ፤ ሄስካ፥ እያ አማኑዋ፥ እያ ገንጫ፥ እያ ሲቁዋ፥ እያ ዳንዳኣነ እያ ጋክዳ መቱዋ ሌምሶ ኦድ ካላናይሳ። ጳዉሎስ ሀ ኪታ ፃፍዳይ፥ እ ባ ዎ ኦንግድ ሀይቆስ ጊገትዳ ዎደና።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ገሎ ቆፋ (<char style="ior"><ref loc="2TI 1:1-2">1:1-2</ref></char>)</para>
  <para style="io1">ጎዳን ዬላቶፓ (<char style="ior"><ref loc="2TI 1:3-18">1:3-18</ref></char>)</para>
  <para style="io1">አማንያ ክርስቶሳ ዎታዳረ ግዳ (<char style="ior"><ref loc="2TI 2:1-26">2:1-26</ref></char>)</para>
  <para style="io1">ዉርሰ ዎደን አሳይ አይ ዳናነ (<char style="ior"><ref loc="2TI 3:1-9">3:1-9</ref></char>)</para>
  <para style="io1">አማነታዳ ደአ (<char style="ior"><ref loc="2TI 3:10-4:8">3:10—4:8</ref></char>)</para>
  <para style="io1">ሳሮነ አንጆ (<char style="ior"><ref loc="2TI 4:19-22">4:19-22</ref></char>)</para>
  <chapter number="1" style="c" sid="2TI 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1"/>ፆሳ ሸነን፥ የሱስ ክርስቶሳን በንትዳ ደኦ ኡፋይሳ ማርካታናዉ የሱስ ክርስቶሳ ሀዋረ ግድዳ ጳዉሎሳፐ፥ <verse eid="2TI 1:1"/><verse number="2" style="v" sid="2TI 1:2"/>ታ ዶስያ ናኣ ፅሞትዮሳስ ኪተትዳ ኪታ።</para>
  <para style="p" vid="2TI 1:2">ፆሳ አዋፐነ ኑ ጎዳ ክርስቶስ የሱሳፐ አ ኬሀተይ፥ ማሮተይነ ሳሮተይ ነዉ ግዶ።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሀዋ 16:1</ref>.</char></note><verse eid="2TI 1:2"/></para>
  <para style="s1">ፅሞትዮሳስ እመትዳ ዞረ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3"/>ታኒ፥ ታ ዎሳን ቃማነ ጋላስ ነና ቆፓይስ። ታኒ ዎስያ ዎደ ታ ማይዛታ ፆሳነ ታኒ ሎኦ ካሀን ሀጋዝያ ፆሳ ነ ግሾ ጋላታይስ። <verse eid="2TI 1:3"/><verse number="4" style="v" sid="2TI 1:4"/>ታኒ ነ አፉ ቆፓይስ፤ ነና በአዳ ኡፋይታናዉ ዳሮ ላሞታይስ።<verse eid="2TI 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TI 1:5"/>ቃስ ነዉ ደእያ ቱማ አማኑዋ ኤራይስ። ሄ አማኖይ በን ነ ዎጋ አየ ሎይድንነ ነ አየ ኤዉንቅን ደእያ አማኑዋ መላ።<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሀዋ 16:1</ref>.</char></note> <verse eid="2TI 1:5"/><verse number="6" style="v" sid="2TI 1:6"/>ሄሳ ግሾ፥ ታኒ ታ ኩሽያ ነ ቦላ ዎዳ ዎደ ፆሳይ ነዉ እምዳ እሞታ ኔኒ ዛራ ኤና መላ አኬክሳይስ። <verse eid="2TI 1:6"/><verse number="7" style="v" sid="2TI 1:7"/>አይስ ጊኮ፥ ፆሳይ ኑስ ዎልቃ፥ ሲቆነ ኑ ሁጰ ሃርያ አያና እሚስፐ አትሽን፥ ያሻ አያና እምቤና።<verse eid="2TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8"/>ህዛ፥ ኑ ጎዳስ ማርካታናዉ ዬላቶፓ፤ ቃስ እያ ግሾ ቃሸትዳ ታናንካ ዬላቶፓ። ሽን ፆሳይ ነዉ እምያ ዎልቃን ዎንገላ ግሾ፥ ታራ መቶ ኤካ። <verse eid="2TI 1:8"/><verse number="9" style="v" sid="2TI 1:9"/>ፆሳይ ባ ሸነንነ ባ አ ኬሀተን ኑና አሽድ፥ ባ ጌሻ ደረ ኦናዉ ኑና ዶርስፐ አትሽን፥ ኑኒ ኦዳ ኦሱዋ ግሾ ግደና። ሀ አ ኬሀተ ክርስቶስ የሱሳ ባጋራ መርና ዎደታፔ ስን ኑስ እሚስ። <verse eid="2TI 1:9"/><verse number="10" style="v" sid="2TI 1:10"/>ሀእ ሀ አ ኬሀተይ ኑና አሽያ ክርስቶስ የሱሳ ዩሳን ቆንጭስ። እ ሀይቆ ዎልቃ ይስድ፥ ዎንገላ ባጋራ ዮና ደኦ ኑስ ቆንጭስስ።<verse eid="2TI 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11"/>ታኒ ዎንገላ ሳባከ፥ ሀዋረነ አስታማረ ግዳና መላ ፆሳይ ታና ዶርስ።<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="1TI 2:7">1 ፅሞ 2:7</ref>.</char></note> <verse eid="2TI 1:11"/><verse number="12" style="v" sid="2TI 1:12"/>ታኒ ሄሳ ግሾ ሀ መቱዋ ኤካይስ፤ ሽን ታ አማነይ ኦነኮ ኤርያ ግሾ ዬላትከ። ታዉ እመትዳ ሀዳራ ሄ ጋላሳይ ጋካናዉ እ ናጋናዉ ዳንዳኤይሳ ኤራይስ።<verse eid="2TI 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13"/>ታኒ ነና ታማርስዳ ቱማ ቃላ ሌምሶ ኦ ኦይካዳ ክርስቶስ የሱሳ ባጋራ ኑባ ግድዳ አማኑዋንነ ሲቁዋን ደአ። <verse eid="2TI 1:13"/><verse number="14" style="v" sid="2TI 1:14"/>ኑ ግዶን ደእያ ጌሻ አያና ዎልቃን ነዉ እመትዳ ሎኦ ሀዳራ ናጋ።<verse eid="2TI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15"/>ኢሰ ቢታን ደእያ ኡባይ ታፐ ሃክዳይሳ ኤራሳ፤ ኤንታ ግዶን ፍገሉስነ ሄርሞገኔስ ደኦሶና።<verse eid="2TI 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 1:16"/>አነስፎር ታና ዳሮ ዎደ ምንዳ ግሾ ጎዳይ እያ ሶ አሳስ ቃቶ። ታኒ ቃሾ ኬን ደእያ ዎደ እ ታናን ዬላትቤና። <verse eid="2TI 1:16"/><verse number="17" style="v" sid="2TI 1:17"/>ሄሳ ቦላ እ ሮመ ካታማ ይዳ ዎደ ታና ምን ኮይድ ደምስ። <verse eid="2TI 1:17"/><verse number="18" style="v" sid="2TI 1:18"/>ዉርሰ ጋላሳን ጎዳይ እያዉ ቃታና መላ ታኒ ጎዳ ዎሳይስ። ኤፈሶና ካታማን እ ታና አይ መላ ማድዳኮ ነ ሎይ ኤራሳ።<verse eid="2TI 1:18"/></para>
  <chapter eid="2TI 1"/>
  <chapter number="2" style="c" sid="2TI 2"/>
  <para style="s1">የሱስ ክርስቶሳን ምና</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1"/>ህዛ፥ ታ ናአዉ፥ ክርስቶስ የሱሳን ደእያ ማሮተን ምና። <verse eid="2TI 2:1"/><verse number="2" style="v" sid="2TI 2:2"/>ዳሮ ማርካታ ስንን ታኒ ነና ታማርስዳ ትምርትያ፥ ሀራታ ታማርሳናዉ ዳንዳእያ አማነትዳ አሳስ ሀዳራ እማ።<verse eid="2TI 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3"/>የሱስ ክርስቶሳስ አማንያ ዎታዳረ ግዳዳ ታራ መቶ ኤካ። <verse eid="2TI 2:3"/><verse number="4" style="v" sid="2TI 2:4"/>ኦላ ዎታዳረይ ባ ቶራ ሞጮና ኡፋይሳናዉ ጊገቴስፐ አትሽን፥ ሀራ ኦሶን ባና ፔሸና። <verse eid="2TI 2:4"/><verse number="5" style="v" sid="2TI 2:5"/>ሄሳዳካ፥ ጋደ ዎፅያ ኦንካ በሲያ ኦገራ ጋደቶና እፅኮ ዎይቶ ኤከና። <verse eid="2TI 2:5"/><verse number="6" style="v" sid="2TI 2:6"/>ጎሻን ዳቡርያ ጎሻንቾይ ባ ዳቡራ አይፍያፐ ምያ ኮይሮ አስ ግዳናዉ በሴስ። <verse eid="2TI 2:6"/><verse number="7" style="v" sid="2TI 2:7"/>ነ አኬካና መላ ጎዳይ ነና ማዳና ግሾ፥ ታ ነዉ ኦድዳባ ነ ዎዛናን ናጋ።<verse eid="2TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8"/>ታኒ ማርካትያ ዎንገላ መላ ሀይቆፐ ደንድዳ፥ ዳዊታ ኮቸ ግድዳ የሱስ ክርስቶሳ ቆፓ። <verse eid="2TI 2:8"/><verse number="9" style="v" sid="2TI 2:9"/>ታኒ ዎንገላ ኦድያ ግሾ፥ ኢታባ ኦዳ አሳዳ፥ ቃሸታዳ መቶ ኤካይስ። ሽን ፆሳ ቃላይ ቃሸተና። <verse eid="2TI 2:9"/><verse number="10" style="v" sid="2TI 2:10"/>ሄሳ ግሾ፥ ፆሳይ ዶርዳ አሳት ክርስቶስ የሱሳን ደእያ አቶተ መርና ቦንቹዋራ ኤካና መላ ኤንታ ግሾ ኡባባን ዋየታይስ።<verse eid="2TI 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11"/>ሀይሳዳ ግያ ቱማ ቃል ደኤስ፤</para>
  <para style="q1" vid="2TI 2:11">“ኑኒ እያራ ሀይቅዳባ ግድኮ፥</para>
  <para style="q2" vid="2TI 2:11">እያራ እስፈ ደአና።<verse eid="2TI 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12"/>ኑኒ ገንጭኮ፥</para>
  <para style="q2" vid="2TI 2:12">እያራ እስፈ ካዎታና።</para>
  <para style="q1" vid="2TI 2:12">ኑኒ እያ ካድኮ፥</para>
  <para style="q2" vid="2TI 2:12">እ ኑና ካዳና።<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="MAT 10:33">ማቶ 10:33</ref>፤ <ref loc="LUK 12:9">ሉቃ 12:9</ref>.</char></note><verse eid="2TI 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13"/>ኑኒ አማነቶና እፅኮ፥</para>
  <para style="q2" vid="2TI 2:13">እ አማነትዳይሳ ግድድ ዳና።</para>
  <para style="q1" vid="2TI 2:13">አይስ ጊኮ፥ እ ባና</para>
  <para style="q2" vid="2TI 2:13">ካዳናዉ ዳንዳኤና” ያጌስ።<verse eid="2TI 2:13"/></para>
  <para style="s1">ምኖ ኦሳንቾ</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14"/>ኔኒ ኤንታ ሀይሳ አኬክሳ፤ ኤንቲ ቃላታ ጋሶን ፓላሞና መላ፥ ጎዳ ስንን ኤንታ ዞራ። ሄስ ስኤይሳታ ይሰስፐ አትሽን፥ አይኮካ ማደና። <verse eid="2TI 2:14"/><verse number="15" style="v" sid="2TI 2:15"/>ኔኒ ቱማ ቃላ ሱረተን ታማርሰይሳነ ዬላዮና ኦሳንቾ ግዳዳ፥ ፆሳይ ናሽያ አሳዳ፥ ነናተ እያዉ እማናዉ ምና። <verse eid="2TI 2:15"/><verse number="16" style="v" sid="2TI 2:16"/>ሽን ሀ አላምያስ እንጀትያ ጎኦና ኦዳፐ ባቃታ። ሄሳ መላ ኦዳይ አሰ ፆሳፈ ሃሴስ። <verse eid="2TI 2:16"/><verse number="17" style="v" sid="2TI 2:17"/>ሄሳ መላ ኦዳይ አሳተ ምድግያ ፓፆና ዎይዛዝረ ማዱን መላ። ሄሳ መላ ኦዳ ኦደተይሳታ ግዶፈ ሄመነዮስነ ፍልፆስ ደኦሶና። <verse eid="2TI 2:17"/><verse number="18" style="v" sid="2TI 2:18"/>ሀ አሳት ቱማ ኦግያ አግድ፥ “ሀይቅዳ አሳይ ሀይቆፐ በን ደንድዶሶና” ያግድ ጉ አሳታ አማኑዋ ይስዶሶና።<verse eid="2TI 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 2:19"/>ግዶሽን፥ ፆሳይ ምኖ ዛላ ሂፅዳ ግሾ ቃፃናዉ ዳንዳኤና። እያ ቦላ፥ “ጎዳይ ባ አሳ ኤሬስ። ጎዳ ሱን ፄግያ ኦንካ ኢታ ኦሶፐ ሃኮ” ግያ ቃላይ ፃፈትስ።<note caller="-" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="NUM 16:5">ታይቦ 16:5</ref>.</char></note><verse eid="2TI 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20"/>እስ ግታ ኬን ዎርቃፈ ዎይኮ ብራፐ ኦሰትዳ ሚሸታ ፃላላ ግዶናሽን፥ ምፈ ዎይኮ ኡርቃፈ ኦሰትዳ ሚሸትካ ደኦሶና። ሄሳታፐ ባጋት ቦንቾ ኦሶስ፥ ቃስ ባጋት ቶሸትያ ኦሶስ ፔኦሶና። <verse eid="2TI 2:20"/><verse number="21" style="v" sid="2TI 2:21"/>ሄሳ ግሾ፥ ኦንካ ኢታ ኡባ አግኮነ ባና ጌሽኮ፥ ቦንቾ ኦሶ ኦያ ሚሸ ግዳና። ኤንታ ደኦይ ጌሽነ ጎዳ ኡፋይስያባ፥ ቃስ ኤንቲ ሎኦ ኦሶ ኡባ ኦናዉ ዳንዳኤይሳታ ግዳና።<verse eid="2TI 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22"/>ናአተ ኢታ አሙዋፐ ባቃታ። ጌሻ ዎዛናን ጎዳ ፄግያ አሳታራ እስፈ፥ ፅሎተ፥ አማኑዋ፥ ሲቆነ ሳሮተ ካላ።<verse eid="2TI 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2TI 2:23"/>ሽን ኦሽ መይሳ ኤራዳ ኤያተነ ሀዳ ግድዳ ፓላማፐ ሃካ። <verse eid="2TI 2:23"/><verse number="24" style="v" sid="2TI 2:24"/>ጎዳ ኦሳንቾይ አሳ ኡባስ ኬሀ፥ ሎኦ ታማርሰይሳነ ዳንዳአንቾ ግዳናዉ በሴስፐ አትሽን፥ ኦየታናዉ በሰና። <verse eid="2TI 2:24"/><verse number="25" style="v" sid="2TI 2:25"/>እ ባራ ኤቀተይሳታ አሽከተን ሴረይሳ ግዳናዉ በሴስ። ኤንቲ ባንታ ናጋራፐ ስሚድ ቱማ ኤራናዳ ፆሳይ ኦነኮ ኦን ኤር። <verse eid="2TI 2:25"/><verse number="26" style="v" sid="2TI 2:26"/>ኤንቲ ባንታ ዎዛናኮ ስሚድ ባ ሸንያ ኦና መላ ኤንታ ኦይክዳ ፃላሄ ፅህያፐ ከስ ኤካና።<verse eid="2TI 2:26"/></para>
  <chapter eid="2TI 2"/>
  <chapter number="3" style="c" sid="2TI 3"/>
  <para style="s1">ዎደ ዉርሰ ማላታታ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1"/>ዉርሰ ጋላሳን ኡንኤያ ዎደይ ያናይሳ ኤራ። <verse eid="2TI 3:1"/><verse number="2" style="v" sid="2TI 3:2"/>አሳይ ባንታና ዶሰይሳታ፥ ሚሸ ሲቀይሳታ፥ ጬቀተይሳታ፥ ኦቶረይሳታ፥ ጫየይሳታ፥ ባንታና የልዳይሳታስ ኪተቶናይስታ፥ ጋላቶናይስታ፥ ጌሻተ ባይናይሳታ፥ <verse eid="2TI 3:2"/><verse number="3" style="v" sid="2TI 3:3"/>ሲቆይ ባይናይሳታ፥ ማሮተ ኤሮናይሳታ፥ ዝግረይሳታ፥ ባንታና ሃሮናይሳታ፥ ዎዛና ምኖታ፥ ሎኦ ዶሶናይሳታ፥ <verse eid="2TI 3:3"/><verse number="4" style="v" sid="2TI 3:4"/>ሞርኬስ አድ እመይሳታ፥ ቆፍ ባይናይሳታ፥ ኦቶሮን ሱገተይሳታ፥ ፆሳፈ አድ አሾ ኡፋይሳናዉ ዶሰይሳታ ግዳና። <verse eid="2TI 3:4"/><verse number="5" style="v" sid="2TI 3:5"/>ኤንቲ አማንያ ዳኖሶናፐ አትሽን፥ አማኖ ዎልቃ ካዶሶና፤ ኔኒ ሄሳ መላ አሳታፐ ባቃታ።<verse eid="2TI 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6"/>ኤንታፈ እሶት እሶት አሳ ኬ ገልድ ናጋራን ኦይከትዳይሳታነ ዱማ ዱማ አሞን ሱገትያ ዳቡራንቾ ማጫሳታ ቦላ ጎዳቶሶና። <verse eid="2TI 3:6"/><verse number="7" style="v" sid="2TI 3:7"/>ሄ ማጫሳት ኡባ ዎደ ታማሮሶናሽን፥ ቱማ ኤራናዉ ዳንዳኦኮና። <verse eid="2TI 3:7"/><verse number="8" style="v" sid="2TI 3:8"/>ያነስነ ያምባሬስ ሙሰራ ኤቀትዳይሳዳ ሀ አሳት ጉገይ ኦናይሳታነ አማኖን ኩንድዳ አሳታ ግድያ ግሾ ቱማራ ኤቀቶሶና።<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="EXO 7:11">ከሳ 7:11</ref>.</char></note> <verse eid="2TI 3:8"/><verse number="9" style="v" sid="2TI 3:9"/>ሽን ያነሳነ ያምባሬሳ ኤያተይ ቆንጭዳይሳዳ ኤንታ ኤያተይካ አሳ ኡባ ስንን ቆንጫና ግሾ ኤንታዉ ሀነና።<verse eid="2TI 3:9"/></para>
  <para style="s1">ዉርሰ ዞረ</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10"/>ሽን ኔኒ ታ ትምርትያ፥ ታ ዱሳ፥ ታ ቆፋ፥ ታ አማኑዋ፥ ታ ዳንዳኣ፥ ታ ሲቁዋ፥ ታ ገንጫ፥ <verse eid="2TI 3:10"/><verse number="11" style="v" sid="2TI 3:11"/>ታ ጎደተነ ታ መቱዋ ኤራሳ። አንፆከ፥ እቆንዮነን፥ ልስፅራ ካታማታን ታና ጋክዳባነ ታኒ ዳንዳእዳ መቱዋ ኤራሳ፤ ጎዳይ ታና ሄ ኡባፈ አሽስ።<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">ሀዋ 13:14-52</ref>፤ <ref loc="ACT 14:1-20">14:1-20</ref>.</char></note> <verse eid="2TI 3:11"/><verse number="12" style="v" sid="2TI 3:12"/>ክርስቶስ የሱሳን ፆሳ ኡፋይስያ ደኦ ዳናዉ ኮይያ ኡባይ ጎደታና። <verse eid="2TI 3:12"/><verse number="13" style="v" sid="2TI 3:13"/>ኢታ አሳትነ ባለይሳት ባንታዉ ባለትሸነ ሀራታ ባለሸ ካሰፐ ኢት ኢት ባና።<verse eid="2TI 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 3:14"/>ሽን ነ ታማርዳ ቱማንነ ነ አማንዳ አማኑዋን ኤቃ። ነ ኦደፈ ታማርዳኮ ኤራሳ። <verse eid="2TI 3:14"/><verse number="15" style="v" sid="2TI 3:15"/>ኔኒ ነ ናአተፈ ዶማዳ ክርስቶሳ የሱሳ አማናዳ፥ አቶተ ደምያ ጭንጫተ እማናዉ ዳንዳእያ ጌሻ ማፃፋታ ኤራዳሳ። <verse eid="2TI 3:15"/><verse number="16" style="v" sid="2TI 3:16"/>ጌሻ ማፃፋ ኡባይ ፆሳፈ እመትዳ ቃላ። ሄ ማፃፋይ ቱማ ታማርሳናዉ፥ ባልዳይሳታ ሴራናዉ፥ ሱርሳናዉነ ፅሎተ ዱሳስ ኮሽያ ዞረ እማናዉ ማዴስ። <verse eid="2TI 3:16"/><verse number="17" style="v" sid="2TI 3:17"/>ፆሳ አስ ፖሎነ ሎኦ ኦሶ ኡባ ኦናዉ ጊግዳይሳ ግዳና መላ ማዴስ።<verse eid="2TI 3:17"/></para>
  <para style="b"/>
  <chapter eid="2TI 3"/>
  <chapter number="4" style="c" sid="2TI 4"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1"/>ታኒ ነና ፆሳ ስንንነ፥ ካዎ ግድድ ሃራናዉ ቆንጭያ ዎደ ፓፃታነ ሀይቅዳይሳታ ፕርዳናዉ ደእያ ክርስቶስ የሱሳ ስንን ዞራይስ። <verse eid="2TI 4:1"/><verse number="2" style="v" sid="2TI 4:2"/>ቃላ ኦዳ፤ ዎደይ እንጀትን እንጀቶና እፅን ምናዳ ኦዳ። ዳሮ ዳንዳአንነ ታማርሶን አሳ ዞራ ሴራነ ደን። <verse eid="2TI 4:2"/><verse number="3" style="v" sid="2TI 4:3"/>አሳይ ቱማ ትምርትያ ስኦና እፅያ ዎደይ ያና። ኤንቲ ባንታ አሙዋ ካልድ፥ ባንታዉ ስአናዉ ኡፋይስያባ ኦድያ አስታማረታ ሺሾሶና። <verse eid="2TI 4:3"/><verse number="4" style="v" sid="2TI 4:4"/>ኤንቲ ቱማ ትምርትያ አግድ፥ ቱማ ግዶና ኦዳ ስአናዉ ባንታ ሀይ ዛሮሶና። <verse eid="2TI 4:4"/><verse number="5" style="v" sid="2TI 4:5"/>ሽን ኔኒ ኡባባን ነና ሃራ። መቶ ዳንዳአ። ዎንገላ ማርካተ ኦሱዋ ኦ። ነዉ እመትዳ ፆሳ ኦሶ ኡባ ፖላ።<verse eid="2TI 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6"/>ታኒ ያርሸትያ ዎደይ ጋክስ፤ ሀ አላምያ አጋዳ ብያ ዎደይ ማትስ። <verse eid="2TI 4:6"/><verse number="7" style="v" sid="2TI 4:7"/>ታኒ ሎኦ ኦላ ኦለታስ፤ ታ ጋድያ ዎፃዳ ዉርሳስ፤ አማኑዋ ናጋስ። <verse eid="2TI 4:7"/><verse number="8" style="v" sid="2TI 4:8"/>ስንፈ ፅሎተ ካላቻይ<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="fq" closed="false">ፅሎተ ካላቻይ፦ </char><char style="ft" closed="false">ፅሎተ ደኦ ግሾ፥ ታ ኤካና ካላቻ። ፅሎተ ታዉ ካላቻ ኦድ እሜስ ጉሱ።</char></note> ታና ናጌስ። ሄሳ ፅሎ ፕርዳ ፕርድያ ጎዳይ ሄ ጋላስ ታዉ እማና። ሄሳ ታ ፃላላስ ግዶናሽን፥ እያ ቆንጨ አሞትያ ኡባስ እማና።<verse eid="2TI 4:8"/></para>
  <para style="s1">ጳዉሎሳ ቡዞ ቆፋ</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9"/>ኤለሳ ያዳ ታና በአ። <verse eid="2TI 4:9"/><verse number="10" style="v" sid="2TI 4:10"/>ዴማስ ሀእ አላምያ ዶስድ፥ ታና አግድ፥ ተሰሎንቀ ካታማ ብስ። ቀርቅስ ጋላትያ ቢታ፥ ቃስ ትቶይ ድልማፀ ቢታ ብስ።<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="COL 4:14">ቆላ 4:14</ref>፤ <ref loc="PHM 1:24">ፍልሞ 24</ref>፤ <ref loc="2CO 8:23">2 ቆሮ 8:23</ref>፤ <ref loc="GAL 2:3">ጋላ 2:3</ref>፤ <ref loc="TIT 1:4">ትቶ 1:4</ref>.</char></note> <verse eid="2TI 4:10"/><verse number="11" style="v" sid="2TI 4:11"/>ሉቃሳ ፃላል ታራ ደኤስ። ማርቆስ ፆሳ ኦሶን ታና ማዳናዉ ዳንዳእያ ግሾ፥ ኔራ ኤካዳ ያ።<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="COL 4:14">ቆላ 4:14</ref>፤ <ref loc="PHM 1:24">ፍልሞ 24</ref>፤ <ref loc="ACT 12:12">ሀዋ 12:12</ref>፥ <ref loc="ACT 12:25">25</ref>፤ <ref loc="ACT 13:13">13:13</ref>፤ <ref loc="ACT 15:37-39">15:37-39</ref>፤ <ref loc="COL 4:10">ቆላ 4:10</ref>.</char></note> <verse eid="2TI 4:11"/><verse number="12" style="v" sid="2TI 4:12"/>ታኒ ትክቆሳ ኤፈሶና ካታማ ኪታስ።<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሀዋ 20:4</ref>፤ <ref loc="EPH 6:21-22">ኤፈ 6:21-22</ref>፤ <ref loc="COL 4:7-8">ቆላ 4:7-8</ref>.</char></note> <verse eid="2TI 4:12"/><verse number="13" style="v" sid="2TI 4:13"/>ኔኒ ያሸ፥ ፅሮኣዳ ካታማን ካርፖሳ ማታን አጋዳ ይዳ ታ ኮትያነ ማፃፋታ ታዉ ኤካዳ ያ። ኡባካ ጋልባን ፃፈትዳ ማፃፋታ ኤኮና ዮፓ።<verse eid="2TI 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14"/>ብራታ ቆፅያ እስክንድረይ ታና ዳሮ ቆህስ፤ ጎዳይ እያ ኦሱዋዳ እያዉ ዛራና።<note caller="-" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="1TI 1:20">1 ፅሞ 1:20</ref>፤ <ref loc="PSA 62:12">ማዝ 62:12</ref>፤ <ref loc="ROM 2:6">ሮመ 2:6</ref>.</char></note> <verse eid="2TI 4:14"/><verse number="15" style="v" sid="2TI 4:15"/>እ ኑ ትምርትያ ዳሮ እፅያ ግሾ እያፐ ነና ናጋ።<verse eid="2TI 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16"/>ኮይሮ ታ ሞተትያ ዎደ ኡባይ አግድ ብዶሶናፐ አትሽን፥ ኦንካ ታና ማድቤና። ፆሳይ ሄ ናቁዋ ኤንታዉ ታይቦፖ። <verse eid="2TI 4:16"/><verse number="17" style="v" sid="2TI 4:17"/>ሽን ታኒ ኩመ ኪታ አይሁደ ግዶና አሳ ኡባስ ማርካትን፥ ኤንቲ ስአና መላ ጎዳይ ታ ማታን ኤቅድ ታዉ ዎልቃ እሚስ። ቃስ ኮሻትዳ ጋሞዳ ዶና ዶይዳ ሀይቁዋፐ ታና አሽስ። <verse eid="2TI 4:17"/><verse number="18" style="v" sid="2TI 4:18"/>ጎዳይ ታና ኢታ ኡባፈ አሽድ ባ ሳሎ ካዎተ ሳሮን ኤፋና። እያዉ መርናፐ መርና ጋካናዉ ቦንቾይ ግዶ። አምንእ።<verse eid="2TI 4:18"/></para>
  <para style="s1">ሳሮ</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19"/>ጵርስቅላስ፥ አቅላስነ አነስፎራ ሶ አሳስ ታ ሳሮዋ ኦዳ።<note caller="-" style="x"><char style="xo" closed="false">4:19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">ሀዋ 18:2</ref>፤ <ref loc="2TI 1:16-17">2 ፅሞ 1:16-17</ref>.</char></note> <verse eid="2TI 4:19"/><verse number="20" style="v" sid="2TI 4:20"/>ኤራስፆስ ቆሮንቶሳ ካታማን አትስ። ፅሮፍሞስ ሀርገትዳ ግሾ፥ ምልፀ ካታማን አጋስ።<note caller="-" style="x"><char style="xo" closed="false">4:20 </char><char style="xt" closed="false"><ref loc="ACT 19:22">ሀዋ 19:22</ref>፤ <ref loc="ROM 16:23">ሮመ 16:23</ref>፤ <ref loc="ACT 20:4">ሀዋ 20:4</ref>፤ <ref loc="ACT 21:29">21:29</ref>.</char></note> <verse eid="2TI 4:20"/><verse number="21" style="v" sid="2TI 4:21"/>ባልጎይ ገላናፐ ስን ኤለሳዳ ያ።</para>
  <para style="p" vid="2TI 4:21">ኤዉቡሉስ፥ ጱዴስ፥ ልኑስ፥ ቅላደይነ ሀራ አማንያ አሳት ኡባይ ነና ሳሮ ጎሶና።<verse eid="2TI 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22"/>ጎዳይ የሱስ ክርስቶሲ ነ አያናራ ግዶ።</para>
  <para style="p" vid="2TI 4:22">ፆሳ ማሮተይ ህንተ ኡባራ ግዶ።<verse eid="2TI 4:22"/></para>
  <chapter eid="2TI 4"/>
</usx>
