<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">መተ ማፃፋ</para>
  <para style="toc1">መተ ማፃፋ</para>
  <para style="toc3">መ</para>
  <para style="toc2">መተ</para>
  <para style="mt">መተ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">መተ ማፃፋይ፥ ሳሎ ሳአ መተ፥ አሳ መተ፥ ኤኮ ገሎባ፥ ናጋራባ፥ ዶና ቡቀተባነ እስራኤለ አሳ ዶመ ኦዴስ። መተ ማፃፋይ ናምኡ አይፈ ክፍለታን ሻከቴስ።</para>
  <para style="ipi">1. ሸምፖ 1—11 ጋካናዉ ደእያ ክፍለይ፥ አዳመፐ አብራሃመ ጋካናዉ ደእያ አሳ ዘረ ዶመ ታርከ ቆንጭሴስ። ሀ ክፍልያን፥ ሳሎ ሳአ መተ፥ አሳ መተ (ሸም 1—2)። አዳመነ ሄዋን ኪተተ እፆ፥ ናጋራ ጋሶን ባደነ ሀይቆይ አሳ ኮቸ ኡባ ቦላ ዩሳ (ሸም 3)። ቃየላነ አበላ ታርከነ አሳ የለተ (ሸም 4—5)። ኖሄ አማነተ፥ አሳ ኢታተነ ዮ ሃ (ሸም 6—10)። ባብሎነ ግምበ፥ ዶና ቡቀተነ አሳ ላለተ (ሸም 11) በሲያ ታርከ ፓድድ ኦዴስ።</para>
  <para style="ipi">2. ሸምፖ 12—50 ጋካናዉ ደእያ ክፍለይ፥ እስራኤለ ኮይሮ አዋታ ታርከ ኦዴስ፤ ኤንታ ግዶፈ ፆሳስ ኪተተን ኤረትዳ አብራሃመ ዶረተ፥ ካልድ እያ ናአ ይሳቃ፥ እያ ናአ ናአ ግድዳ ያይቆባነ ታማነ ናምኡ ያይቆባ ናይታ ታርከ ቆንጭሴስ። ሀ ታማነ ናምኡ ያይቆባ ናይት፥ ታማነ ናምኡ እስራኤለ ኮቻስ ዶመ ግድዳ ማይዛታ። ሀ ታማነ ናምኡ እስራኤለ ናይታ ግዶፈ ዮሰፋ ታርከይ ሀ ማፃፋን ዳሮ ኦደትዳ ታርከ።</para>
  <para style="ip">ሀ ማፃፋይ፥ አሳ ዘረ ታርከ ኦድያባ ግድኮካ ኡባፈ አድ ፆሲ ኦዳ እያ ግታ ኦሱዋ ፓድድ በሴስ። እ ባ አሳስ እምዳ ኡፋይሳ ቃላይ፥ ፆሳይ ባ አሳስ መርናዉ ቆፐይሳ በሴስ። ማፃፋይ ጋፃፐ ጋፃ ጋካናዉ ናጋራ ፕርደይ፥ ባ አሳ ካለይ፥ ኤንታ ማደይነ ኤንታ ታርክያ ጊግሰይ ፆሰ ግደይሳ በሴስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">መተ ታርከ (<char style="ior"><ref loc="GEN 1:1-2:3">1:1—2:3</ref></char>)</para>
  <para style="io1">አዳመነ ሄዋኖ (<char style="ior"><ref loc="GEN 2:4-25">2:4-25</ref></char>)</para>
  <para style="io1">ናጋር አላመ ገሉዋ (<char style="ior"><ref loc="GEN 3:1-24">3:1-24</ref></char>)</para>
  <para style="io1">ናጋር አላመን ዳየ (<char style="ior"><ref loc="GEN 4:1-6:8">4:1—6:8</ref></char>)</para>
  <para style="io1">ኖሄነ ዮ ሃ ታርከ (<char style="ior"><ref loc="GEN 6:9-9:29">6:9—9:29</ref></char>)</para>
  <para style="io1">ባብሎነ ግምብያነ አሳ ላለተ (<char style="ior"><ref loc="GEN 11:1-9">11:1-9</ref></char>)</para>
  <para style="io1">ሴማ የለታ ሱሳ (<char style="ior"><ref loc="GEN 11:10-32">11:10-32</ref></char>)</para>
  <para style="io1">አብራሃመ ፄገተነ ዱሳ (<char style="ior"><ref loc="GEN 12:1-25:11">12:1—25:11</ref></char>)</para>
  <para style="io1">እስማኤላ የለተ (<char style="ior"><ref loc="GEN 25:12-18">25:12-18</ref></char>)</para>
  <para style="io1">ያይቆባ የለተ (<char style="ior"><ref loc="GEN 25:19-35:29">25:19—35:29</ref></char>)</para>
  <para style="io1">ኤሳዌ የለተ (<char style="ior"><ref loc="GEN 36:1-43">36:1-43</ref></char>)</para>
  <para style="io1">ዮሰፋነ እያ እሻታ (<char style="ior"><ref loc="GEN 37:1-45:28">37:1—45:28</ref></char>)</para>
  <para style="io1">እስራኤለ አሳይ ግብፀ ቢታን (<char style="ior"><ref loc="GEN 46:1-50:26">46:1—50:26</ref></char>)</para>
  <chapter number="1" style="c" sid="GEN 1"/>
  <para style="s1">መተባ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1"/>ፆሳይ ኮይሮ ሳሎታነ ሳአ መስ። <verse eid="GEN 1:1"/><verse number="2" style="v" sid="GEN 1:2"/>ሄ ዎደ ሳእ ጊጎናነ አይብካ ባይና መላ ደኤስ። ም ቢታ ማእዳ ዎልቃማ ሃታ ቦላ ደኤስ። ፆሳ አያናይ ሃፈ ቦላራ ቃፄስ።<verse eid="GEN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 1:3"/>ሄሳፈ ጉየ፥ ፆሳይ፥ “ፖኦይ ሀኖ” ያግን፥ ፖኦይ ሀንስ። <verse eid="GEN 1:3"/><verse number="4" style="v" sid="GEN 1:4"/>ፖኦይ ሎኦ ግድዳይሳ ፆሳይ በእስ፤ ፖኡዋ ማፐ ሻክስ። <verse eid="GEN 1:4"/><verse number="5" style="v" sid="GEN 1:5"/>ፆሳይ ፖኡዋ፥ “ጋላስ” ግድ ሱንስ፤ ቃስ ማ “ቃማ” ግድ ሱንስ። ሳእ ቃምስ ዎንትስ፤ ሄስ ኮይሮ ጋላስ።<verse eid="GEN 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6"/>ሄሳፈ ጉየ፥ ፆሳይ፥ “ቦላራ ደእያ ሃ ጋርሳን ደእያ ሃፈ ሻክያ ሳሎ ጉፋንይ ሀኖ” ያግን ሀንስ። <verse eid="GEN 1:6"/><verse number="7" style="v" sid="GEN 1:7"/>ፆሳይ ሳሎ ጉፋን ጊግስድ፥ ሳሎ ጉፋንፈ ቦላራ ደእያ ሃ ጋርሳን ደእያ ሃፈ ሻክስ። <verse eid="GEN 1:7"/><verse number="8" style="v" sid="GEN 1:8"/>ፆሳይ ሄ ጉፋንዋ፥ “ሳሎ” ግድ ሱንስ። ሳእ ቃምስ፤ ዎንትስ፤ ሄስ ናምአን ጋላሳ።<verse eid="GEN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9"/>ሄሳፈ ጉየ፥ ፆሳይ፥ “መላ በሳይ ቆንጫናዳ ሳሎፐ ጋርሳን ደእያ ሃ ኡባይ እስ በሲ ሺቆ” ያግን ሀንስ። <verse eid="GEN 1:9"/><verse number="10" style="v" sid="GEN 1:10"/>ፆሳይ ሄ መላ በሳ፥ “ቢታ” ግድ ሱንስ፤ ቃስ እስ በሳን ሺቅዳ ሃ፥ “አባ” ግድ ሱንስ። ያትድ፥ ፆሳይ ሄስ ሎኦ ግድዳይሳ በእስ። <verse eid="GEN 1:10"/><verse number="11" style="v" sid="GEN 1:11"/>ሄሳፈ ጉየ፥ ፆሳይ፥ “ቢታይ ም ማታ ዶልሶ፤ ዘረ አይፈይ ደእያ ካነ ዘረ አይፈይ ግዶን ደእያ ም ዶሎ” ያግስ፤ ሄሳዳካ ሀንስ። <verse eid="GEN 1:11"/><verse number="12" style="v" sid="GEN 1:12"/>ቢታይ ም ማታ እያ ቆሞን ቆሞን ዶልስስ። ፆሳይ ሄስ ሎኦ ግድዳይሳ በእስ። <verse eid="GEN 1:12"/><verse number="13" style="v" sid="GEN 1:13"/>ሳእ ቃምስ ዎንትስ፤ ሄስ ሄን ጋላስ።<verse eid="GEN 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14"/>ሄሳፈ ጉየ፥ ፆሳይ፥ “ጋላሳ ቃማፈ ሻካናዉ ፖኦት ሳሎን ሀኖ። ኤንቲ ቃማ፥ ጋላሳ፥ ዎደነ ላይ ኤርሳናዉ ማላ ግዶ። <verse eid="GEN 1:14"/><verse number="15" style="v" sid="GEN 1:15"/>ቢታ ቦላ ፖአና መላ ኤንቲ ሳሎ ጉፋንን ሀኖ” ያግስ፤ ሄሳዳካ ሀንስ። <verse eid="GEN 1:15"/><verse number="16" style="v" sid="GEN 1:16"/>ፆሳይ ናምኡ ግታ ፖኦታ መስ። አዊ ጋላስ፥ አጌን ቃማ ፖአና መላ ኦስ። ሄሳዳካ ፆልንቶታ መስ። <verse eid="GEN 1:16"/><verse number="17" style="v" sid="GEN 1:17"/>ፆሳይ ኤንቲ ሀ ሳአ ቦላ ፖአና መላ ሳሎን ዎስ። <verse eid="GEN 1:17"/><verse number="18" style="v" sid="GEN 1:18"/>ሄስ፥ ጋላስነ ቃማ ሃራና መላነ ፖኦ ማፐ ሻካና መላሳ። ፆሳይ ሄስ ሎኦ ግድዳይሳ በእስ። <verse eid="GEN 1:18"/><verse number="19" style="v" sid="GEN 1:19"/>ሳእ ቃምስ ዎንትስ፤ ሄስ ኦይዳን ጋላስ።<verse eid="GEN 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20"/>ሄሳፈ ጉየ፥ ፆሳይ፥ “ደኦይ ደእያ ዱማ ዱማ መተት ሃን ዳሮ፤ ካፎትካ ሳአፐ ቦላራ፥ ሳሎ ጉፋንፈ ጋርሳን ፕራ” ያግስ። <verse eid="GEN 1:20"/><verse number="21" style="v" sid="GEN 1:21"/>ያትድ ፆሳይ አባን ደእያ ግታ ዶአታ፥ ሃ ግዶን ዎፅ ቃፅያ መተታ ኡባነ ፓልያ ካፎታ ኡባ እያ ቆሞን ቆሞን መስ። ፆሳይ ሄስ ሎኦ ግድዳይሳ በእስ። <verse eid="GEN 1:21"/><verse number="22" style="v" sid="GEN 1:22"/>ፆሳይ ኤንታ፥ “የለትተ፥ ዳርተ፥ አባ ኩምተ፥ ካፎት ቢታ ቦላ ዳሮ” ያግድ አንጅስ። <verse eid="GEN 1:22"/><verse number="23" style="v" sid="GEN 1:23"/>ሳእ ቃምስ ዎንትስ፤ ሄስ እቻሻን ጋላስ።<verse eid="GEN 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24"/>ሄሳፈ ጉየ፥ ፆሳይ፥ “ደኦይ ደእያ መተት ኤንታ ቆሞን ቆሞን፥ መሄታ፥ ሳአራ ጎሸትያ መተታነ ዶአታ ኤንታ ቆሞን ቆሞን ቢታይ ከሶ” ያግን ሀንስ። <verse eid="GEN 1:24"/><verse number="25" style="v" sid="GEN 1:25"/>ሄሳዳ ኦድ ኤንታ ኡባ መስ። ፆሳይ ሄስ ሎኦ ግድዳይሳ በእስ።<verse eid="GEN 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 1:26"/>ሄሳፈ ስምን፥ ፆሳይ፥ “አሰ ኑና ዳንስድ አነ መኦስ። ኤንቲ አባ ሞሉዋ፥ ሳሎ ካፎታ፥ ቢታ ቦላ ዎፅ ቃፅያ መተ ኡባ ሃሮ” ያግስ። <verse eid="GEN 1:26"/><verse number="27" style="v" sid="GEN 1:27"/>ሄሳዳ ፆሳይ አሰ ባና ዳንስድ መስ። እ አሰ ፆሰ ዳንስድ መስ፤ ኤንታ አደነ ማጫስ ኦድ መስ።<verse eid="GEN 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 1:28"/>ፆሳይ ኤንታና፥ “የለትተ፥ ዳርተ፥ ሳአ ኩምተ፤ ሃርተ። አባ ሞሎ፥ ሳሎ ካፎታነ ቢታ ቦላ ዎፅ ቃፅያ፥ ደኦይ ደእያ መተ ኡባ ሃርተ” ያግድ አንጅስ።<verse eid="GEN 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 1:29"/>ሄሳፈ ጉየ፥ ፆሳይ፥ “ታኒ ቢታ ኡባ ቦላ ዘረ አይፈይ ደእያ ካ ኡባነ ዘረ አይፈይ ግዶን ደእያ ም ኡባ ህንተዉ እማስ፤ ሄስ ህንተዉ ካ ግዶ። <verse eid="GEN 1:29"/><verse number="30" style="v" sid="GEN 1:30"/>ቃስካ ሀ ሳአን ደእያ መሄነ ዶአ ኡባስ፥ ሳሎ ካፎ ኡባስነ ሳአራ ጎሸትያ መተ ኡባስ ምያባ ግዳና መላ፥ ጭልኦ ምነ ማታ እማስ” ያግስ፤ ሄሳዳካ ሀንስ። <verse eid="GEN 1:30"/><verse number="31" style="v" sid="GEN 1:31"/>ፆሳይ ባ መዳ ኡባባካ ፄልያ ዎደ ዳሮ ሎኦ ግድዳይሳ በእስ። ሳእ ቃምስ፤ ዎንትስ፤ ሄስ ኡሱፑን ጋላስ።<verse eid="GEN 1:31"/></para>
  <chapter eid="GEN 1"/>
  <chapter number="2" style="c" sid="GEN 2"/>
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1"/>ሳሎትነ ሳእ ኤንታን ደእያባ ኡባባይ ሀይሳዳ መትድ ፖለትስ። <verse eid="GEN 2:1"/><verse number="2" style="v" sid="GEN 2:2"/>ፆሳይ ባ ኦሱዋ ፖልድ፥ ላፑን ጋላሳን ሸምፕስ። <verse eid="GEN 2:2"/><verse number="3" style="v" sid="GEN 2:3"/>ፆሳይ ላፑን ጋላሳን ባ ኦያ ኦሱዋ ኦንግድ ሸምፕዳ ግሾ ሄ ጋላሳ አንጅስ፤ ጋላሳታፐ ዱማይስ። <verse eid="GEN 2:3"/><verse number="4" style="v" sid="GEN 2:4"/>ሳሎትነ ሳእ ሄሳዳ ሀን መትስ።</para>
  <para style="s1" vid="GEN 2:4">አዳመነ ሄዋኖ</para>
  <para style="p" vid="GEN 2:4">ጎዳ ፆሳይ ሳአነ ሳሎታ መዳ ዎደ፥ <verse eid="GEN 2:4"/><verse number="5" style="v" sid="GEN 2:5"/>ሳአ ቦላ እር ቡክቦና ግሾነ ኦያ አስ ባይና ግሾ ምነ ማት ዶልቤና፤ አጭያባይካ ባዋ። <verse eid="GEN 2:5"/><verse number="6" style="v" sid="GEN 2:6"/>ግዶሽን፥ ሳአፐ ሃ ፑልትድ፥ ቢታ ኡባ ላክሴስ። <verse eid="GEN 2:6"/><verse number="7" style="v" sid="GEN 2:7"/>ሄሳፈ ጉየ፥ ጎዳ ፆሳይ ቢታ ባናፐ አሰ<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="fq" closed="false">አሰ፦ </char><char style="ft" closed="false">አሰ ገይስ እብራወ ዶናን “አዳመ” ጌተቴስ። “አዳመ” ጉሳይ “ቢታ” ጉሱ።</char></note> መድ እያ ሲራ ደኦ ሸምፖ ፑንድ ገልስስ። ያትን፥ ሄ አደይ ደኦራ ደእያ አሰ ግድስ።<verse eid="GEN 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8"/>ጎዳ ፆሳይ ዶሎሀ ባጋራ ኤደነ ጋናተ ጊግስስ፤ ያን ባ መዳ አድያ ዎስ። <verse eid="GEN 2:8"/><verse number="9" style="v" sid="GEN 2:9"/>ጎዳ ፆሳይ ፄላናዉ ሎእያ፥ ማናዉካ ማልእያ ኡባ ቆሞ ም ቢታፈ ዶልስስ። ጋናተ ግዶን ደኦ እምያነ ሎኦነ ኢታ ኤርስያ ናምኡ ምታ ዎስ።<verse eid="GEN 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10"/>ጋናተ ኡሽያ ሻፋ ሃይ ኤደነፐ ጎጌስ። ሄ ሻፋይ ኤደነፐ ከይድ ኦይዱ ሻፉ ከይድ ሻከቴስ። <verse eid="GEN 2:10"/><verse number="11" style="v" sid="GEN 2:11"/>ኮይሮ ሻፋ ሱንይ ፍሶነ። ፍሶነይ ዎርቀይ ደእያ ሀውላ ቢታ ቦላ ጎጌስ። <verse eid="GEN 2:11"/><verse number="12" style="v" sid="GEN 2:12"/>ሄ ቢታ ዎርቀይ ጌሻ ዎርቃ። ቃስ አልኦ ሽቶይነ ሹች ያን ደኤስ። <verse eid="GEN 2:12"/><verse number="13" style="v" sid="GEN 2:13"/>ናምአን ሻፋ ሱንይ ግዮነ። ግዮነይ ቶጰ ቢታ<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="fq" closed="false">ቶጰ ቢታ፦ </char><char style="ft" closed="false">በን ቶጰ ቢታይ ሀእ ደእያ ሱዳነፐነ ቶጰፈ ባጋ ኤኬስ።</char></note> ዩሹዋን ጎጌስ። <verse eid="GEN 2:13"/><verse number="14" style="v" sid="GEN 2:14"/>ሄን ሻፋ ሱንይ ፀግሮሳ። ፀግሮስ አሶረፐ ዶሎሀ ባጋራ ጎጌስ። ቃስ ኦይዳን ሻፋይ ኤፍራፂሳ።<verse eid="GEN 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15"/>ጎዳ ፆሳይ አስ ኤደነ ጋናተ ኦና መላነ ናጋና መላ እያ ኤፍድ ያን ዎስ። <verse eid="GEN 2:15"/><verse number="16" style="v" sid="GEN 2:16"/>ጎዳ ፆሳይ አሰ፥ “ጋናተ ም ቴራ ኡባፈ ኔኒ ማናዉ ዳንዳኣሳ። <verse eid="GEN 2:16"/><verse number="17" style="v" sid="GEN 2:17"/>ሽን ሎኦነ ኢታ ኤርስያ ም አይፍያፐ ሞፓ። አይስ ጊኮ፥ ኔኒ እያፐ ምዳ ጋላስ ቱማ ሀይቃና” ያግድ ኪትስ።<verse eid="GEN 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18"/>ሄሳፈ ጉየ፥ ጎዳ ፆሳይ፥ “አደይ ባርካ ደኤይስ ሎኦ ግደና። ታኒ እያ ማዳና መላ እያዉ እንጀትያ ላገ መና” ያግስ።<verse eid="GEN 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 2:19"/>ጎዳ ፆሳይ መሄታ፥ ዶአታነ ሳሎ ካፎታ ኡባ ቢታፈ መስ። ያትድ፥ ኤንታ ዎይግድ ሱንነኮ በአናዉ አዳመኮ ኤህን፥ አዳመይ ደኦይ ደእያ መተ ኡባ ሱንዳ ሱንይ ኤንታ ሱን ግድድ አትስ። <verse eid="GEN 2:19"/><verse number="20" style="v" sid="GEN 2:20"/>ሄሳዳካ፥ አዳመይ መሄታ፥ ሳሎ ካፎታነ ባዞ ዶአታ ኡባ ሱንስ። ሽን አዳመስ እንጀትያነ እያ ማድያ ላገይ በንትቤና።<verse eid="GEN 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 2:21"/>ሄሳ ግሾ፥ ጎዳ ፆሳይ አዳመ ዎልቃማ ስኮን የግስ። እ ስኮ ሀይቅዳሽን እያ ምየ መቀፈ እሱዋ ኤክድ፥ ሄ በሳ አሾን ኩንስ። <verse eid="GEN 2:21"/><verse number="22" style="v" sid="GEN 2:22"/>ጎዳ ፆሳይ አዳመፐ ኤክዳ መቀ ማጫ ኦድ መስ፤ ያትድ እዮ እያኮ ኤህስ። <verse eid="GEN 2:22"/><verse number="23" style="v" sid="GEN 2:23"/>አዳመይ፥ “ሀ መቀያ ታ መቀፈ፥ ሀ አሽያ ታ አሾፐ ኤከትዳሮ። እያ አደፈ ኤከትዳ ግሾ ማጫ<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="fq" closed="false">ማጫ፦ </char><char style="ft" closed="false">እብራወ ዶናን ማጫ ገይሳራነ አደ ገይሳራ ናምአይ እስኖ። እብራወን “አደ” ገይስ “እሽ” ጌተቴስ፤ “ማጫ” ገይስ “እሻ” ጌተቴስ።</char></note> ጌተቶ” ያግስ። <verse eid="GEN 2:23"/><verse number="24" style="v" sid="GEN 2:24"/>ሄሳ ግሾ አስ ባ አዋነ ባ አይዉ አግድ፥ ባ ማቸራ እስፈ ደኤስ፤ ናምአይ እስ አስ ግዶሶና። <verse eid="GEN 2:24"/><verse number="25" style="v" sid="GEN 2:25"/>አዳመይነ ሄዋና ናምአይካ ፅረ ካሎ ደኦሶና፤ ሽን እሶይ እሱዋስ ዬላቶኮና።<verse eid="GEN 2:25"/></para>
  <chapter eid="GEN 2"/>
  <chapter number="3" style="c" sid="GEN 3"/>
  <para style="s1">አሳ ኪተተ እፆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1"/>ሾሽ ጎዳ ፆሳይ መዳ ዶአ ኡባፈ አዳ ገናንቾ። እስ ጋላስ ሾሽ ማጫስዉ፥ “ፆሳይ ቱማ ህንተና፥ ‘ጋናትያን ደእያ ም አይፈ ኡባፈ ሞፕተ’ ግዴ?” ያግድ ኦይችስ።<verse eid="GEN 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2"/>ማጫስያ ሾሻኮ፥ “አካይ፥ ፆሳይ ሄሳዳ ግቤና፤ ኑኒ ጋናተ ግዶን ደእያ ምታ አይፈ ማናዉ ዳንዳኦስ። <verse eid="GEN 3:2"/><verse number="3" style="v" sid="GEN 3:3"/>ሽን ፆሳይ ኑና፥ ‘ጋናተ ግዶን ደእያ ም አይፈ ሞፕተ፥ ቦቾፍተ፤ እፅኮ ህንተ ሀይቃና’ ግስ” ያጋሱ።<verse eid="GEN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4"/>ሾሻይ ማጫስዉ፥ “ህንተ አይኮካ ሀይቀከታ። <verse eid="GEN 3:4"/><verse number="5" style="v" sid="GEN 3:5"/>ፆሳይ ሄሳ ግዳይ፥ ሄ ም አይፍያ ህንተ ሚኮ አኬካ ደምድ ሎኦነ ኢታ ፆሳዳ ህንተ ኤራናይሳ እ ኤርያ ግሾሳ” ያግስ።<verse eid="GEN 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6"/>ማጫስያ ም አይፈይ ማናዉ ማልኤይሳ፥ በአናዉ ሎኤይሳነ፥ ጭንጫተ ደማናዉ አሞያባ ግደይሳ በአሱ። ሄ ም አይፍያፐ ኤካዳ ማሱ። ቃስ ባ አዝናስካ እምን እካ ምስ።<verse eid="GEN 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 3:7"/>ኤንቲ ም ስሚድ፥ ናምአይካ አኬካ ደምዶሶና። ኤንቲ ፅረ ካሎ ደኤይሳ ኤርዶሶና። ሄሳ ግሾ ባላሰ ም ሀይ ስክድ ዳንጭዶሶና።<verse eid="GEN 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8"/>ሳእ ኦማርስዳ ዎደ ጋናተ ግዶን ጎዳ ፆሳይ ሄመትሽን እያ ግርሳ አዳመይነ እያ ማችያ ስእዶሶና። ኤንቲ ጋናተ ም ግዶን ጎዳ ፆሳፈ ቆሰትዶሶና። <verse eid="GEN 3:8"/><verse number="9" style="v" sid="GEN 3:9"/>ሽን ጎዳ ፆሳይ አዳመ ፄግድ፥ “አዳመ፥ አዉን ደአይ?” ያግስ።<verse eid="GEN 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10"/>አዳመይ፥ “ጋናተ ግዶን ነ ግርሳ ስአዳ ታኒ ካሎ ደእያ ግሾ ያያዳ ቆሰታስ” ያግስ።<verse eid="GEN 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11"/>ጎዳ ፆሳይ፥ “ኔኒ ካሎ ደኤይሳ ነዉ ኦድዳይ ኦኔ? ታኒ ነና ሞፓ ግዳ ም አይፈፐ ማድዬ?” ያግድ ኦይችስ።<verse eid="GEN 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12"/>አዳመይ፥ “ታራ ዳና መላ ኔኒ እምዳ ማጫስያ ሄ ም አይፍያፐ ታዉ እምን ማስ” ያግስ።<verse eid="GEN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13"/>ጎዳ ፆሳይ፥ ማጫስዉ፥ “ኔኒ ሄሳ አይስ ኦዲ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="GEN 3:13">ማጫስያ፥ “ታና ሾሻይ ጭምን ማስ” ያጋሱ።<verse eid="GEN 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14"/>ጎዳ ፆሳይ ሾሻ፥ “ኔኒ ሀይሳ ኦዳ ግሾ፥ መሄፐነ ዶአ ኡባፈ አዳ ባደትዳባ ግዳ። ኔኒ ነ ኡሎን ቢታራ ጎሸታና፤ ነ ደኦ ላይ ኡባን ባና ላጫና። <verse eid="GEN 3:14"/><verse number="15" style="v" sid="GEN 3:15"/>ታኒ፥ ነ ግዶንነ ማጫሰ ግዶን፥ ነ ሼሻ ግዶንነ እ ሼሻ ግዶን ሞርከተ ዎና። እ ነ ሁጵያ ቆፃና፥ ነካ እያ ግንድያ ዱካና” ያግስ።<verse eid="GEN 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16"/>ማጫስዉ ጎዳ ፆሳይ፥ “ነ ቃንትዳ አጌናን ዳሮ ኡንኤታና። ኔኒ ዎልቃማ ዋየን ናአ የላና። ግዶሽን፥ ኔኒ ነ አዝናራ ዳናዉ አሞታና፤ እ ነና ሃራና” ያግስ።<verse eid="GEN 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17"/>ጎዳ ፆሳይ አዳመኮ፥ “ኔኒ ነ ማቸ ኦዳ ስእዳ ግሾነ ታኒ ነና ሞፓ ግዳ ም አይፍያፐ ኔኒ ምዳ ግሾ፥ ቢታይ ነ ጋሶን ባደትዳይሳ ግዶ። ኔኒ ነ ደኦ ላይ ኡባን ግታ ዳቡርሳን ቢታ ኦዳ ማና። <verse eid="GEN 3:17"/><verse number="18" style="v" sid="GEN 3:18"/>ቢታይ ነዉ አጉንነ ሀርመ ዶልሳና፤ ኔኒ ቢታፈ ዶልድ ካፅያባ ማና። <verse eid="GEN 3:18"/><verse number="19" style="v" sid="GEN 3:19"/>ኔኒ ነ መትዳ ቢታ ስማና ጋካናዉ ዳቡራን ጫዋታዳ ኦዳ ነ ካ ማና። ኔኒ ቢታፈ መትዳ ግሾ ቢታ ስማና” ያግስ።<verse eid="GEN 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20"/>አዳመይ ባ ማችዉ ደኦይ ደእያ አሳ ኡባስ አዮ ግድያ ግሾ ሄዋኖ<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="fq" closed="false">ሄዋኖ፦ </char><char style="ft" closed="false">ሀ ሱን ብርሸይ “ደእያሮ” ጉሱ።</char></note> ግድ ሱንስ።<verse eid="GEN 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 3:21"/>ጎዳ ፆሳይ አዳመነ እያ ማችዉ እተ ጊግስድ ማይዝስ።<verse eid="GEN 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22"/>ጎዳ ፆሳይ፥ “ህዛ አስ ሎኦነ ኢታ ኤሮን ኑፐ እሱዋዳ ግድስ። ኤንቲ ባንታ ኩሽያ የድድ፥ ደኦ እምያ ም አይፍያፐ ኤክድ ሞና መላነ መርናዉ ደኦን ዶና መላ ተቀታናዉ ኮሼስ” ያግስ። <verse eid="GEN 3:22"/><verse number="23" style="v" sid="GEN 3:23"/>ሄሳ ግሾ፥ ኤንቲ ባንታ መትዳ ቢታ ኦና መላ ጎዳ ፆሳይ ኤደነ ጋናተፐ ኤንታ ከስስ። <verse eid="GEN 3:23"/><verse number="24" style="v" sid="GEN 3:24"/>ያትድ፥ ደኦ እምያ ምኮ ኤፍያ ኦግያ ናጋና መላ ክሩቤላ ጌተትያ ደኦ መተታነ ሽረት ሽረት ዎያ ታማ ላጮ ማሸ ኤደነ ጋናተፐ ዶሎሀ ባጋራ ዎስ።<verse eid="GEN 3:24"/></para>
  <chapter eid="GEN 3"/>
  <chapter number="4" style="c" sid="GEN 4"/>
  <para style="s1">ቃየላነ አበላ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1"/>አዳመይ ባ ማቸ ሄዋንራ አቅስ። እያ ቃንታዳ አደ ናአ የላሱ። “ጎዳይ ታና ማድን አደ ናአ ደማስ” ጋዳ ቃየላ ጋዳ ሱንሱ። <verse eid="GEN 4:1"/><verse number="2" style="v" sid="GEN 4:2"/>እያ እሻ አበላ የላሱ። አበል ዶርሰ ሄሜስ ቃስ ቃየል ቢታ ኦስ። <verse eid="GEN 4:2"/><verse number="3" style="v" sid="GEN 4:3"/>ኡንደና ዎደፐ ጉየ፥ ቃየል ባ ጋደን ካፅዳ ካፈ ጎዳስ ያርሾ ያርሽስ። <verse eid="GEN 4:3"/><verse number="4" style="v" sid="GEN 4:4"/>ሽን አበል ባ ዶርሳ ዉድያ ግዶን ባይራ የለትዳይሳ ሹክድ እያ አሹዋፐ ሞ ባጋ ያርሽስ። ጎዳይ አበላነ እያ ያርሹዋ ኤክስ። <verse eid="GEN 4:4"/><verse number="5" style="v" sid="GEN 4:5"/>ሽን ቃየላነ እያ ያርሹዋ ኤክቤና። ሄሳ ግሾ፥ ቃየል ዳሮ ይሎትስ፤ እያ ሶምኦይ ምስ።<verse eid="GEN 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 4:6"/>ጎዳይ ቃየላኮ፥ “አይስ ይሎታይ? ነ ሶምኦይ አይስ ምዴ? <verse eid="GEN 4:6"/><verse number="7" style="v" sid="GEN 4:7"/>ኔኒ ሎኦ ኦዳባ ግድያኮ፥ ነ ሶምኦይ ፓሽካ ግደኔ? ሽን ኔኒ ሎኦ ኦና እፅኮ፥ ናጋር ዶአዳ ነ ፐንገን ናጌስ። እ ነና ሃራናዉ ኮዬስ፥ ሽን ኔኒ እያ ፆናናዉ በሴስ” ያግስ።<verse eid="GEN 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8"/>ሄሳፈ ጉየ፥ ቃየል ባ እሻ አበላኮ፥ “አነ ደምባ በሲ ቦስ” ያግስ። ኤንቲ ደምባን ደእሽን፥ ቃየል ባ እሻ አበላ ቦላ ደንድድ እያ ዎስ።<verse eid="GEN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9"/>ጎዳይ ቃየላ፥ “ነ እሻይ አበል አዉኔ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="GEN 4:9">ቃየል ዛሪድ፥ “ታኒ ኤርከ፤ ታ እሻ ናገይ ታነዬ?” ያግስ።<verse eid="GEN 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10"/>ጎዳይ ቃየላ፥ “ሀይሳ አይስ ኦዲ? ሄኮ፥ ነ እሻ ሱይ ቢታፈ ታኮ ፅሎ ፕርዳስ ዋሴስ። <verse eid="GEN 4:10"/><verse number="11" style="v" sid="GEN 4:11"/>ኔኒ ባደትዳባ ግድያ ግሾ ቢታ ዛራዳ ኦናዉ ዳንዳአካ። ነ እሻ ዎዳሳ እያ ሱካ ቢታን ጉሳዳሳ። <verse eid="GEN 4:11"/><verse number="12" style="v" sid="GEN 4:12"/>ኔኒ ኦንካ ቢታይ ነዉ አይፈና፤ በተ አሳዳ ኔኒ ሳአ ቦላ ቶይላታዳ ዳቡራና” ያግስ።<verse eid="GEN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13"/>ቃየል ጎዳኮ፥ “ነ ታ ቦላ ፕርድዳ ፕርዳይ ታ ዎልቃፈ ቦላ። <verse eid="GEN 4:13"/><verse number="14" style="v" sid="GEN 4:14"/>ኔኒ ታና ሀች ቢታፈ የደሳ፤ ነ ስንፈካ ሃሳሳ። በተ አሳዳ ታኒ ሳአ ቦላ ዳቡራና፤ ታና ደምያ ኦንካ ዎና” ያግስ።<verse eid="GEN 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15"/>ጎዳይ እያ፥ “ነና ኦንካ ዎና፤ ዎኮ፥ ታኒ ላፑን ቶሆ ሀሎ ከያና” ያግስ። ሄሳ ግሾ፥ እያ ደምያ ኦንካ ዎና መላ ጎዳይ እያ ቦላ ናግሶ ማላ ዎስ። <verse eid="GEN 4:15"/><verse number="16" style="v" sid="GEN 4:16"/>ቃየል ጎዳ ስንፈ ከይድ፥ ኤደነ ባጋፈ ዶሎሀ ባጋን ደእያ ኖዳ፥<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="fq" closed="false">ኖዳ </char><char style="ft" closed="false">ቶይላትድ ዳቡርያ በሲ</char></note> ቢታን ደእስ።<verse eid="GEN 4:16"/></para>
  <para style="s1">ቃየላነ እያ የለታ</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17"/>ቃየል ባ ማቸራ አቅስ፤ እያ ቃንታዳ ሄኖከ የላሱ። ሄ ዎደ ቃየል ካታማ ኬፅድ፥ ሄ ካታማ ባ ናኣ ሱንን “ሄኖከ” ግድ ሱንስ። <verse eid="GEN 4:17"/><verse number="18" style="v" sid="GEN 4:18"/>ሄኖከይ ጋይዳ የልስ። ጋይድ ማኤላ የልስ። ማኤል ማቱሳኤላ የልስ። ማቱሳኤል ላመሀ የልስ።<verse eid="GEN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 4:19"/>ላመህ አዶነ ሲሎ ጌተትያ ናምኡ ማቾ ኤክስ። <verse eid="GEN 4:19"/><verse number="20" style="v" sid="GEN 4:20"/>አዳ ያባላ የላሱ። ያባል መሄ ሃርያነ ዱንካነን ደእያ አሳታ አዋ። <verse eid="GEN 4:20"/><verse number="21" style="v" sid="GEN 4:21"/>እያ እሻ ሱንይ ዩባላ። ዩባል ቃስ ዲ ዲፀይሳታነ ሱሱልኤ ፑንያ አሳታ ኡባ አዋ። <verse eid="GEN 4:21"/><verse number="22" style="v" sid="GEN 4:22"/>ሲላ ቃስ ቱባልቃይና ጌተትያ ናኣ የላሱ። ቱባልቃይን ናሰ ብራታፐነ ብራታፐ ዱማ ዱማ ሚሸታ ቆፀይሳታ አዋ። ቱባልቃይና ምችያ ናእሞ።<verse eid="GEN 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23"/>እስ ጋላስ ላመህ ባ ማቸታ፥ “አደ፥ ሲለ፥ ስእተ፤ ታ ማቸቶ፥ ታኒ ኦድያባ ሀይዝተ። እስ ፓን አደይ ታና ደችድ ማዱንፅስዳ ግሾ፥ ታኒ እያ ዎስ። <verse eid="GEN 4:23"/><verse number="24" style="v" sid="GEN 4:24"/>ቃየላ ሃሉዋ ከያናው ላፑን ኩሸ ኮሽኮ፥ ላመሀ ሃሉዋ ከያናው ላፑን ታማነ ላፑን ኩሸ ኮሼስ” ያግስ።<verse eid="GEN 4:24"/></para>
  <para style="s1">ሴታነ ሄኖሳ</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25"/>አዳመ ማችያ ሀራ አደ ናኣ የላሱ። ያታዳ፥ “ቃየል ዎዳ አበላ ግሾ ፆሳይ ታዉ ሀራ ናአ እሚስ” ጋዳ እያ ሴታ<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="fq" closed="false">ሴታ፦ </char><char style="ft" closed="false">እብራወ ዶናን ሀ ሱን ብርሸይ “እሚስ” ጉሱ።</char></note> ጋዳ ሱንሱ። <verse eid="GEN 4:25"/><verse number="26" style="v" sid="GEN 4:26"/>ሴት አደ ናአ የልድ እያ “ሄኖሳ” ግድ ሱንስ። አሳይ ጎዳ ሱን ፄግድ ጎይኖ ዶምዳይ ሄ ዎደ።<verse eid="GEN 4:26"/></para>
  <chapter eid="GEN 4"/>
  <chapter number="5" style="c" sid="GEN 5"/>
  <para style="s1">አዳመነ እያ የለታ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1"/>አዳመ የለተይ ሀይሳፈ ካልድ ፃፈትዳይሳ። ፆሳይ አሰ መዳ ጋላስ ባና ዳንስድ መስ። <verse eid="GEN 5:1"/><verse number="2" style="v" sid="GEN 5:2"/>እ አደነ ማጫስ ኦ መድ ኤንታ አንጅስ። ኤንታ መድ አሰ (አዳመ) ግድ ሱንስ።<verse eid="GEN 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 5:3"/>አዳመይ 130 ላይ ደእድ፥ ባና ዳንያ አደ ናአ የልድ እያ “ሴታ” ግድ ሱንስ። <verse eid="GEN 5:3"/><verse number="4" style="v" sid="GEN 5:4"/>አዳመይ ሴታ የልዳፐ ጉየ 800 ላይ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ። <verse eid="GEN 5:4"/><verse number="5" style="v" sid="GEN 5:5"/>አዳመይ 930 ላይ ደእድ ሀይቅስ።<verse eid="GEN 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6"/>ሴት 105 ላይ ደእድ ሄኖሳ የልስ። <verse eid="GEN 5:6"/><verse number="7" style="v" sid="GEN 5:7"/>ሴት ሄኖሳ የልዳፐ ጉየ፥ 807 ላይ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ። <verse eid="GEN 5:7"/><verse number="8" style="v" sid="GEN 5:8"/>ሴት 912 ላይ ደእድ ሀይቅስ።<verse eid="GEN 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9"/>ሄኖስ 90 ላይ ደእድ፥ ቃይናና የልስ። <verse eid="GEN 5:9"/><verse number="10" style="v" sid="GEN 5:10"/>ሄኖስ ቃይናና የልዳፐ ጉየ፥ 815 ላይ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ። <verse eid="GEN 5:10"/><verse number="11" style="v" sid="GEN 5:11"/>ሄኖስ 905 ላይ ደእድ ሀይቅስ።<verse eid="GEN 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12"/>ቃይናን 70 ላይ ደእድ፥ ማላልኤላ የልስ። <verse eid="GEN 5:12"/><verse number="13" style="v" sid="GEN 5:13"/>ቃይናን ማላልኤላ የልዳፐ ጉየ፥ 840 ላይ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ። <verse eid="GEN 5:13"/><verse number="14" style="v" sid="GEN 5:14"/>ቃይናን 910 ላይ ደእድ ሀይቅስ።<verse eid="GEN 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15"/>ማላልኤል 65 ላይ ደእድ፥ ያረዳ የልስ። <verse eid="GEN 5:15"/><verse number="16" style="v" sid="GEN 5:16"/>ማላልኤል ያረዳ የልዳፐ ጉየ፥ 830 ላይ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ። <verse eid="GEN 5:16"/><verse number="17" style="v" sid="GEN 5:17"/>ማላልኤል 895 ላይ ደእድ ሀይቅስ።<verse eid="GEN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18"/>ያረድ 162 ላይ ደእድ፥ ሄኖከ የልስ። <verse eid="GEN 5:18"/><verse number="19" style="v" sid="GEN 5:19"/>ያረድ ሄኖከ የልዳፐ ጉየ፥ 800 ላይ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ። <verse eid="GEN 5:19"/><verse number="20" style="v" sid="GEN 5:20"/>ያረድ 962 ላይ ደእድ ሀይቅስ።<verse eid="GEN 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21"/>ሄኖከይ 65 ላይ ደእድ፥ ማቱሳላ የልስ። <verse eid="GEN 5:21"/><verse number="22" style="v" sid="GEN 5:22"/>ማቱሳላ የልዳፐ ጉየ፥ ሄኖከይ 300 ላይ ፆሰ ኡፋይስያ ደኦ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ። <verse eid="GEN 5:22"/><verse number="23" style="v" sid="GEN 5:23"/>ሄኖከይ 365 ላይ ደእስ። <verse eid="GEN 5:23"/><verse number="24" style="v" sid="GEN 5:24"/>ፆሲ እያ ባኮ ኤክዳ ግሾ ስሚድ በንትቤና።<verse eid="GEN 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25"/>ማቱሳል 187 ላይ ደእድ፥ ላመሀ የልስ። <verse eid="GEN 5:25"/><verse number="26" style="v" sid="GEN 5:26"/>ማቱሳል ላመሀ የልዳፐ ጉየ፥ 782 ላይ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ። <verse eid="GEN 5:26"/><verse number="27" style="v" sid="GEN 5:27"/>ማቱሳል 969 ላይ ደእድ ሀይቅስ።<verse eid="GEN 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28"/>ላመህ 182 ላይ ደእድ፥ አደ ናአ የልስ። <verse eid="GEN 5:28"/><verse number="29" style="v" sid="GEN 5:29"/>ያትድ፥ “ሀ ናአይ ጎዳይ ባድዳ ቢታ ቦላ ሀ ዳቡራ ኦሶ ኡባፈ ኑና ሸምፕሳና” ግድ እያ ኖሄ<note caller="+" style="f"><char style="fr" closed="false">5:29 </char><char style="fq" closed="false">ኖሄ፦ </char><char style="ft" closed="false">እብራወ ዶናን ኖሄ ጌተትያ ሱንስ ብርሸይ “ሸምፖ” ጉሱ።</char></note> ግድ ሱንስ። <verse eid="GEN 5:29"/><verse number="30" style="v" sid="GEN 5:30"/>ላመህ ኖሄ የልዳፐ ጉየ፥ 595 ላይ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ። <verse eid="GEN 5:30"/><verse number="31" style="v" sid="GEN 5:31"/>ላመህ 777 ላይ ደእድ ሀይቅስ።<verse eid="GEN 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32"/>ኖሄይ 500 ላይ ደእ ስሚድ ሄ አደ ናይታ ሴማ፥ ካማነ ያፈታ የልስ።<verse eid="GEN 5:32"/></para>
  <chapter eid="GEN 5"/>
  <chapter number="6" style="c" sid="GEN 6"/>
  <para style="s1">አሳ ኢታተ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1"/>አሳይ ሳአ ቦላ ዳርዳ ዎደ ኤንታዉ ማጫ ናይት የለትዶሶና። <verse eid="GEN 6:1"/><verse number="2" style="v" sid="GEN 6:2"/>“ፆሳ ናይታ” ጌተትያ መተት ሄ ማጫ ናይት ማላ ሎኦ ግደይሳ በእድ ኤንታፈ ባንታዉ ዶርዳይሳታ ማችዶሶና። <verse eid="GEN 6:2"/><verse number="3" style="v" sid="GEN 6:3"/>ጎዳይ፥ “አሳስ ደኦ እምያ ታ አያናይ አሳን መርናዉ ዴና። አስ ሀይቀይሳ ግድያ ግሾ፥ ህዛፐ እያ ላይይ እስ ፄታነ ላታማ ግዳና” ያግስ። <verse eid="GEN 6:3"/><verse number="4" style="v" sid="GEN 6:4"/>ሄ ዎደነ ሄሳፈ ጉየ፥ ፆሳ ናይት አሳ ማጫ ናይታ ኤክን፥ ናይት የለትዳ ዎደ፥ ዎጋ አዱሳ አሳት ሳአ ቦላ ደእዶሶና። ኤንቲ በን ዎደ ኦላስ ምኖነ ኤረትዳ አሳታ።<verse eid="GEN 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5"/>ጎዳይ ሄ ዎደ ሳአ ቦላ ደእያ አሳ ኢታተ ዳርዳይሳነ ኤንታ ዎዛናይ ኡባ ዎደ ቆፕያባይ ኢታ ፃላላ ግድዳይሳ <verse eid="GEN 6:5"/><verse number="6" style="v" sid="GEN 6:6"/>በእድ፥ አሰ ሀ ሳአ ቦላ መዳይሳን አዛንስ፤ ባ ዎዛናን ዳሮ ቂሮትስ። <verse eid="GEN 6:6"/><verse number="7" style="v" sid="GEN 6:7"/>ታኒ አሰ አይስ መድና ጋዳ ቂሮታስ። ሄሳ ግሾ፥ ጎዳይ፥ “ታኒ መዳ አሰ፥ መሄ፥ ዶአ፥ ሳአራ ጎሸትያ መተታነ ሳሎ ካፎታ ሳአ ቦላፈ ይሳና” ያግስ። <verse eid="GEN 6:7"/><verse number="8" style="v" sid="GEN 6:8"/>ሽን ኖሄይ ጎዳ ስንን ሳባ ደምስ።<verse eid="GEN 6:8"/></para>
  <para style="s1">ኖሄ</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9"/>ኖሄ ታርከይ ሀይሳፈ ካልድ ፃፈትዳይሳ። ኖሄይ ባ ዎደ ደእያ አሳ ግዶፈ ፆሳ ኡፋይስያነ ሱረ አስ። <verse eid="GEN 6:9"/><verse number="10" style="v" sid="GEN 6:10"/>ኖሄይ ሴማ፥ ካማነ ያፈታ ጌተትያ ሄ አደ ናይታ የልስ።<verse eid="GEN 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 6:11"/>ሄ ዎደ ቢታይ ኩመ ፆሳ ስንን ቱንስ፤ ቢታ ኡባይ ጌላተን ኩምስ። <verse eid="GEN 6:11"/><verse number="12" style="v" sid="GEN 6:12"/>ፆሳይ ሀ ቢታ ፄልያ ዎደ ሳአን ደእያ አሳ ኡባይ ባንታ ኦግያ ቱንስድ ደኤይሳ በእስ።<verse eid="GEN 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 6:13"/>ሄሳ ግሾ፥ ፆሳይ ኖሄ ሀይሳዳ ያግድ ኪትስ፤ “ታኒ አሳ ኡባ ይሳና ሀናይስ። ኤንታ ጋሶን ቢታይ ጌላተን ኩምዳ ግሾ፥ አሰ ቢታፈ ይሳና። <verse eid="GEN 6:13"/><verse number="14" style="v" sid="GEN 6:14"/>ሄሳ ግሾ፥ ምኖ ምፈ ነዉ ማርካበ ኬፃ። ሄ ማርካብያ ግዶን ዳሮ ቆልአታ ከሳ። ያታዳ ሶራነ ካረራ ማደ መላባን ሜሻ። <figure style="fig" alt="The Ark of Noha" file="CO00628B.tif" size="span" ref="6:14">ኖሄ ማርካበያ</figure> <verse eid="GEN 6:14"/><verse number="15" style="v" sid="GEN 6:15"/>ማርካብያ ሀይሳዳ ያታዳ ኬፃ፤ አዱሳተ 300 ዋ፥ ጎምፓ 50 ዋ፥ ጌሳ 30 ዋ ኦ። <verse eid="GEN 6:15"/><verse number="16" style="v" sid="GEN 6:16"/>ማርካብያስ ካራ መ፤ ካራፐነ ጎዳፐ ግዶን እስ ዋ ግድያ በሲ ዶያ አጋ። ፐንግያ ማርካብያስ ምየ ባጋራ ከሳ፤ ማርካብያ ሄ ፖቀ ከሳዳ ኬፃ።<verse eid="GEN 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 6:17"/>“ታኒ ሳሎፐ ጋርሳን ሸምፖራ ደእያ መተ ኡባ ይሳናዉ ዮ ሃ የዳዳ ሀ ሳኣ ቦላ ደእያባ ኡባ ይሳና። <verse eid="GEN 6:17"/><verse number="18" style="v" sid="GEN 6:18"/>ሽን ታኒ ታ ጫቁዋ ኔራ ጫቃና። ኔኒ፥ ነ ማችዉ፥ ነ አደ ናይታነ ኤንታ ማቸታ ኤካዳ ማርካብያ ግዶ ገላ። <verse eid="GEN 6:18"/><verse number="19" style="v" sid="GEN 6:19"/>ኤንቲ ኔራ ደኦን ዳና መላ፥ ደኦይ ደእያ መተ ኡባፈ ቆሞን ቆሞን አደነ ማጫ ናምአ ናምአ ኦዳ፥ ማርካብያ ግዶ ገልሳ። <verse eid="GEN 6:19"/><verse number="20" style="v" sid="GEN 6:20"/>ዱማ ዱማ ቆሞ ካፎታፐ፥ ዱማ ዱማ ቆሞ መሄታፐነ ሳአራ ጎሸትያ ዱማ ዱማ ቆሞ መተ ኡባፈ ናምአ ናምአ ግድድ ደኦን ዳና መላ ኔኮ ዮ። <verse eid="GEN 6:20"/><verse number="21" style="v" sid="GEN 6:21"/>ቃስ ህንተነ ዶአት ማናዉ ዱማ ዱማ ቆሞ ምያ ካ ኤፋዳ፥ ማርካብያ ግዶን ቆላ” ያግስ።<verse eid="GEN 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 6:22"/>ኖሄይ ኡባባካ ፆሳይ ኪትዳይሳዳ ኦስ።<verse eid="GEN 6:22"/></para>
  <chapter eid="GEN 6"/>
  <chapter number="7" style="c" sid="GEN 7"/>
  <para style="s1">ዮ ሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1"/>ሄሳፈ ጉየ ጎዳይ ኖሄ ሀይሳዳ ያግስ፤ “ኔኒ ነ ሶ አሳ ኡባራ ማርካብያ ግዶ ገላ። ሀ ዎድያ የለተ ግዶን ታ ሸንያ ፖልዳይ ነ ፃላላ ግድዳይሳ በአስ። <verse eid="GEN 7:1"/><verse number="2" style="v" sid="GEN 7:2"/>ኔኒ ቱና ግዶና መሄነ ዶአ ኡባፈ እያ ቆሞፈ ቆሞፈ አደነ ማጫ ላፑን ላፑን፥ ቱና መሄነ ዶአ ኡባፈ እያ ቆሞፈ ቆሞፈ እስ አደነ እስ ማጫ ገልሳ። <verse eid="GEN 7:2"/><verse number="3" style="v" sid="GEN 7:3"/>ቃስ ሳሎ ካፎታፐ እያ ቆሞፈ ቆሞፈ አደነ ማጫ ላፑን ላፑን ኦዳ፥ ቢታ ኡባ ቦላ ዱማ ዱማ ኮቻይ ደኦን ዳና መላ ኔራ ኤካዳ ገላ። <verse eid="GEN 7:3"/><verse number="4" style="v" sid="GEN 7:4"/>ላፑን ጋላሳፐ ጉየ፥ ታኒ ኦይታሙ ጋላስነ ኦይታሙ ቃማ ሀ ሳኣ ቦላ እራ ቡክሳና። ያታዳ ታኒ መዳ መተ ኡባ ቢታ ቦላፈ ቁቻና” ያግስ።<verse eid="GEN 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 7:5"/>ያትን ኖሄይ ጎዳይ እያ ኪትዳ ኡባባ ኦስ።<verse eid="GEN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6"/>ዮ ሃይ ሀ ሳኣ ቦላ ይዳ ዎደ ኖሄስ ላይ ኡሱፑን ፄታ። <verse eid="GEN 7:6"/><verse number="7" style="v" sid="GEN 7:7"/>ኖሄይ፥ እያ አደ ናይት፥ እያ ማችያነ እያ ናይታ ማቸት ዮ ሃፈ አታናዉ ማርካብያ ግዶ ገልዶሶና። <verse eid="GEN 7:7"/><verse number="8" style="v" sid="GEN 7:8"/>ቱና ግዶና መሄፐነ ዶአፐ፥ ቱና መሄፐነ ዶአፐ ካፎታፐነ ቢታራ ጎሸተይሳታ ኡባፈ <verse eid="GEN 7:8"/><verse number="9" style="v" sid="GEN 7:9"/>ፆሳይ ኖሄ ኪትዳይሳዳ አደነ ማጫስ ናምአ ናምአ ግድድ፥ ኖሄኮ ማርካብያ ግዶ ገልዶሶና። <verse eid="GEN 7:9"/><verse number="10" style="v" sid="GEN 7:10"/>ላፑን ጋላሳፐ ጉየ፥ ዮ ሃይ ሀ ሳአ ቦላ ይስ።<verse eid="GEN 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11"/>ኖሄይ ኡሱፑን ፄቱ ላይ ደእን፥ ናምአን አጌናን፥ ታማነ ላፑን ጋላሳን፥ ቢታ ግዶን ደእያ ግታ ጪሙዋ ፑልቶ ኡባይ ቅ አግስ። ሳሎን ደእያ ሃ ማስኮተት ዶየትዶሶና። <verse eid="GEN 7:11"/><verse number="12" style="v" sid="GEN 7:12"/>እራይ ሀ ሳኣ ቦላ ኦይታሙ ጋላስነ ኦይታሙ ቃማ ቡክስ። <verse eid="GEN 7:12"/><verse number="13" style="v" sid="GEN 7:13"/>እር ቡካ ዶምዳ ጋላስ ኖሄይነ እያ ማችያ፥ እያ አደ ናይት፥ ሴም፥ ካምነ ያፈት፥ እያ ናይታ ሄታ ማቸት እስፈ ማርካብያ ግዶ ገልዶሶና። <verse eid="GEN 7:13"/><verse number="14" style="v" sid="GEN 7:14"/>ዶአ ኡባፈ ባ ቆሞን ቆሞን፥ መሄ ኡባፈ ባ ቆሞን ቆሞን፥ ቢታራ ጎሸትያ ኡባፈ ባ ቆሞን ቆሞን፥ ካፎ ኡባፈ ባ ቆሞን ቆሞን ኤንታራ እስፈ ገልዶሶና። <verse eid="GEN 7:14"/><verse number="15" style="v" sid="GEN 7:15"/>ሸምፖራ ደኤይሳት ኡባይ ናምአ ናምአ ግድድ ኖሄኮ ማርካብያን ገልዶሶና። <verse eid="GEN 7:15"/><verse number="16" style="v" sid="GEN 7:16"/>ፆሳይ ኖሄ ኪትዳይሳዳ፥ መተ ኡባፈ አደነ ማጫ ግድድ ማርካብያ ግዶ ገልን ኖሄፐ ጉየራ ጎዳይ ማርካብያ ፐንግያ ጎርድስ።<verse eid="GEN 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17"/>ዮ ሃይ ኦይታሙ ጋላስ ሳአ ቦላ ቡክሸ ደእስ። ሃይ ዳርድ ማርካብያ ቢታፈ ፑደ ደንስ። <verse eid="GEN 7:17"/><verse number="18" style="v" sid="GEN 7:18"/>ሃይ ቢታ ቦላ ኬህ ዳርን፥ ማርካበይ ሃ ቦላ ቶከትስ። <verse eid="GEN 7:18"/><verse number="19" style="v" sid="GEN 7:19"/>ሳሎፐ ጋርሳን ደእያ ዙማት ኡባይ ምተታና ጋካናስ ሃይ ሳአ ቦላ ኬህ ዳርስ። <verse eid="GEN 7:19"/><verse number="20" style="v" sid="GEN 7:20"/>ሃይ ዙማታ ፄራፐ አድ፥ ታማነ እቻሹ ዋ ጋካናስ ድጭስ። <verse eid="GEN 7:20"/><verse number="21" style="v" sid="GEN 7:21"/>ያትን ሳአ ቦላ ዎፅ ቃፅያ መተት ኡባይ፥ ካፎት፥ መሄይ፥ ዶእነ፥ አስ ኡባይ ሀይቅስ። <verse eid="GEN 7:21"/><verse number="22" style="v" sid="GEN 7:22"/>ቢታ ቦላ ደእያ ባ ሲራ ደኦ ሸምፖ ሸምፕያ ኡባይካ ሀይቅስ። <verse eid="GEN 7:22"/><verse number="23" style="v" sid="GEN 7:23"/>ሳአ ቦላ ደኦይ ደእያ ኡባይ፥ አሳይ፥ መሄይ፥ ዶአይነ ሳሎ ካፎት ኡባይካ ሳአፐ ቁሸትዶሶና። ኖሄይነ እያራ ማርካብያ ግዶን ደኤይሳታ ፃላል አትዶሶና። <verse eid="GEN 7:23"/><verse number="24" style="v" sid="GEN 7:24"/>ሄ ሃይ ፓጮና ፄታነ እሻታሙ ጋላስ ሳአ ቦላ ጋምእስ።<verse eid="GEN 7:24"/></para>
  <chapter eid="GEN 7"/>
  <chapter number="8" style="c" sid="GEN 8"/>
  <para style="s1">ዮ ሃ ዎ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1"/>ሽን ፆሳይ ኖሄ፥ እያራ ማርካብያ ግዶን ደእያ ዶአ ኡባነ መሄ ኡባ ቆፕድ ሳአ ቦላ ጫርኮ ጫርክስን ሄ ሃይ ዎ ዎ ብስ። <verse eid="GEN 8:1"/><verse number="2" style="v" sid="GEN 8:2"/>ቃስ ቢታ ግዶን ደእያ ጪሙዋ ፑልቶይነ ሳሎን ደእያ ሃ ማስኮተት ጎርደትዶሶና፤ እራይካ ሳሎን ተቀትስ። <verse eid="GEN 8:2"/><verse number="3" style="v" sid="GEN 8:3"/>ያንን፥ ሃይ ፄታነ እሻታሙ ጋላስ ጋካናዉ ዎ ዎ ብስ። <verse eid="GEN 8:3"/><verse number="4" style="v" sid="GEN 8:4"/>ሃይ ዎን ላፑን አጌናን፥ ታማነ ላፑን ጋላሳን ማርካበይ አራራተ ዙማታ ቦላ ኡትስ። <verse eid="GEN 8:4"/><verse number="5" style="v" sid="GEN 8:5"/>ሃይ ታማን አጌና ጋካናዉ ዎ ዎ ብስ። ታማን አጌናስ ኮይሮ ጋላስ ዙማታ ፄራት በንትዶሶና።<verse eid="GEN 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6"/>ኦይታሙ ጋላሳፐ ጉየ፥ ኖሄይ ባ ኬፅዳ ማርካብያ ማስኮትያ <verse eid="GEN 8:6"/><verse number="7" style="v" sid="GEN 8:7"/>ዶይድ እስ ቁሮ ካረ የድን ቁሮይ ሃይ ቢታ ቦላፈ መላና ጋካናስ፥ ያነ ሃነ ፕራሸ ጋምእስ። <verse eid="GEN 8:7"/><verse number="8" style="v" sid="GEN 8:8"/>ቃስ ኖሄይ ሃይ ቢታ ቦላፈ ዎ ዉርዳኮ በአናዉ እስ ሆለ ካረ የድስ። <verse eid="GEN 8:8"/><verse number="9" style="v" sid="GEN 8:9"/>ሽን ሄ ሆልያ ሃይ ቢታ ኡባ ቦላ ሀእካ ደእያ ግሾ፥ ሸምፕያ በሲ ደማቡኩ። ሄሳ ግሾ ስማዳ፥ ማርካብያኮ ይን፥ ኖሄይ ባ ኩሽያ የድድ፥ ባኮ ማርካብያ ግዶ ኤክስ።<verse eid="GEN 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 8:10"/>ሄሳፈ ጉየ፥ ላፑን ጋላስ ጋምእድ፥ ሆልዉ ዛሪድ የድስ። <verse eid="GEN 8:10"/><verse number="11" style="v" sid="GEN 8:11"/>ሄ ሆልያ ሳእ ኦማርስያ ዎደ እያኮ ስማዳ ያሸ ሻማሆ አጫፐ ዱዳ እርፃ ሀይ ባ ዶናን ሳፃ ኤካዳ ያሱ። ያትን፥ ሃይ ቢታ ቦላፈ ዎዳይሳ ኖሄይ ኤርስ። <verse eid="GEN 8:11"/><verse number="12" style="v" sid="GEN 8:12"/>ቃስ ኖሄይ ሀራ ላፑን ጋላስ ጋምእድ፥ ሄ ሆልዉ ዛሪድ የድስ። ሽን ሄ ሆልያ እያኮ ስማዳ ያቡኩ።<verse eid="GEN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13"/>ኖሄይ ኡሱፑን ፄታነ እስ ላይ ደእን፥ ኮይሮ አጌናን ኮይሮ ጋላስ፥ ሃይ ቢታ ቦላፈ ፅዝእስ። ኖሄይ ማርካብያ ካማ ቃር ፄልድ፥ ቢታይ ፅዝእዳይሳ በእስ። <verse eid="GEN 8:13"/><verse number="14" style="v" sid="GEN 8:14"/>ናምአን አጌናን ላታማነ ላፑን ጋላሳን፥ ቢታይ ኩመ መልስ።<verse eid="GEN 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15"/>ፆሳይ ሄ ዎደ ኖሄ ሀይሳዳ ያግድ ኪትስ፤ <verse eid="GEN 8:15"/><verse number="16" style="v" sid="GEN 8:16"/>“ኔኒ፥ ነ ማችዉ፥ ነ አደ ናይታነ ነ ናይታ ማቸታ ኤካዳ ማርካብያ ግዶፈ ከያ። <verse eid="GEN 8:16"/><verse number="17" style="v" sid="GEN 8:17"/>ኤንቲ የለትድ፥ ዳራና መላ ደኦይ ደእያ መተ ኡባፈ ኔራ ደኤይሳታ ካፎታ፥ መሄታ፥ ዶአታነ ቢታራ ጎሸትያ ኡባ ኔራ ከሳ” ያግስ። <verse eid="GEN 8:17"/><verse number="18" style="v" sid="GEN 8:18"/>ያትን ኖሄይ ባ አደ ናይታራ፥ ባ ማቸራነ ባ ናይታ ማቸታራ ማርካብያ ግዶፈ ከይስ። <verse eid="GEN 8:18"/><verse number="19" style="v" sid="GEN 8:19"/>ያንን፥ መሄይነ ዶአይ፥ ሳአራ ጎሸትያ መተይ፥ ካፎይነ ሳአ ቦላ ዎፅ ቃፅያባ ኡባይ ባ ቆሙዋን ቆሙዋን ማርካብያ ግዶፈ ከይዶሶና።<verse eid="GEN 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20"/>ሄሳፈ ጉየ፥ ኖሄይ ጎዳስ ያርሾ በሲ ግምብድ ቱና ግዶና መሄነ ዶአ ኡባፈ፥ ቱና ግዶና ካፎ ኡባፈ ኤክድ፥ ጊግስዳ በሳን ያርሾ ኦድ ፁግስ። <verse eid="GEN 8:20"/><verse number="21" style="v" sid="GEN 8:21"/>ያትን፥ ጎዳይ ሄ ያርሹዋ ፔኑዋ ስንግድ፥ ባ ዎዛናን ሀይሳዳ ያግስ፤ “ናአተፈ ዶምድ አስ ዎዛናን ቆፕያባ ኡባይ ኢታ ግድኮካ ታኒ አሳ ቆሆ ግሾ ጋዳ ናምአን ሀ ሳኣ ባድከ። ቃስ ታኒ ሀእ ኦዳይሳዳ ደኦይ ደእያ መተ ኡባ ናምአን ይስከ። <verse eid="GEN 8:21"/><verse number="22" style="v" sid="GEN 8:22"/>ሀ ቢታይ ደእዳ ዎደ ኡባን፥ ዘርያ ዎደይነ ጫክያ ዎደይ፥ ሜጎይነ ሆምበይ፥ ቦነይነ ባልጎይ፥ ጋላስነ ቃም ኡባ ዎደ ዳና” ያግስ።<verse eid="GEN 8:22"/></para>
  <chapter eid="GEN 8"/>
  <chapter number="9" style="c" sid="GEN 9"/>
  <para style="s1">ፆሳይ ኖሄራ ጫቅዳ ጫቁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1"/>ፆሳይ ኖሄነ እያ አደ ናይታ ሀይሳዳ ያግድ አንጅስ፤ “የለትተ፥ ዳርተ፥ ሳአ ኡባ ኩምተ። <verse eid="GEN 9:1"/><verse number="2" style="v" sid="GEN 9:2"/>ሳኣ ዶአት፥ ሳሎ ካፎት፥ ቢታን ዎፅ ቃፅያባይነ አባን ደእያ ሞሎት ኡባይ ህንተዉ ያሻንነ ዳጋማን ደኦ። ኤንቲ ህንተዉ ሃረቶ። <verse eid="GEN 9:2"/><verse number="3" style="v" sid="GEN 9:3"/>ታኒ ዶልያ ዱማ ዱማ ጭልኦባታ ህንተዉ እምዳይሳዳ፥ ደኦይ ደእያ ዎፅ ቃፅያ መተ ኡባይ ህንተዉ ካ ግዳና መላ እማስ። <verse eid="GEN 9:3"/><verse number="4" style="v" sid="GEN 9:4"/>ሽን ሸምፖይ ግዶን ደእያ ግሾ ሱ እያ ግዶን ደእያ አሾ ሞፕተ። <verse eid="GEN 9:4"/><verse number="5" style="v" sid="GEN 9:5"/>ኦንካ ሸምፖ ዎዳይ ፕርደታና። ቃስ አሳ ሱ ጉስያ ዶአካ ሀይቆን ፕርዳና። <verse eid="GEN 9:5"/><verse number="6" style="v" sid="GEN 9:6"/>ፆሳይ አሰ ባና ዳንስድ መዳ ግሾ፥ አሳ ሱ ጉስያ ኦና ግድኮካ እያ ሱይካ አሳ ኩሸን ጉካና። <verse eid="GEN 9:6"/><verse number="7" style="v" sid="GEN 9:7"/>ህንተ የለትተ፥ ዳርተ፥ ህንተ ሼሻይካ ሳአ ቦላ ዳሮ” ያግስ።<verse eid="GEN 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8"/>ሄሳፈ ጉየ፥ ፆሳይ ኖሄነ እያራ ደእያ እያ አደ ናይታ ሀይሳዳ ያግስ፤ <verse eid="GEN 9:8"/><verse number="9" style="v" sid="GEN 9:9"/>“ህዛ፥ ታኒ ታ ጫቁዋ ህንተራ፥ ህንተ ሼሻራነ ደኦይ ደእያ መተ ኡባራ ጫቃይስ። <verse eid="GEN 9:9"/><verse number="10" style="v" sid="GEN 9:10"/>ታኒ ታ ጫቁዋ ካፎታራ፥ መህያራ፥ ሳአ ዶአ ኡባራነ፥ ማርካብያፐ ህንተራ ከይዳ፥ ደኦይ ደእያ መተ ኡባራ ጫቃይስ። <verse eid="GEN 9:10"/><verse number="11" style="v" sid="GEN 9:11"/>ታኒ ህንተራ ጫቅዳይሳ መላ ህዛፐ ደኦይ ደእያ መተት ዮ ሃን ዮኮና፤ ሀ ሳኣካ ዛር ዮ ሃ ይሰና” ያግስ።<verse eid="GEN 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 9:12"/>ቃስካ ፆሳይ፥ “ታኒ ታፐነ ህንተፈ፥ ደኦይ ደእያ መተ ኡባፈ ግዶን ጫቅያ ጫቁዋ ማላይ ሀይሳ፤ <verse eid="GEN 9:12"/><verse number="13" style="v" sid="GEN 9:13"/>ታኒ ታ ዙላ ሻራን ኤሳስ። እ ታፐነ ሳአ ቦላ ደእያ መተ ግዶን ደእያ ጫቁዋስ ማላ ግዳና። <verse eid="GEN 9:13"/><verse number="14" style="v" sid="GEN 9:14"/>ታ ሳሉዋ ሻራ ማይዝዳ ዎደነ ሻራን ዙል ኤቅዳ ዎደ፥ <verse eid="GEN 9:14"/><verse number="15" style="v" sid="GEN 9:15"/>ታፐነ ህንተፈ ግዶን፥ ደኦይ ደእያ ዱማ ዱማ መተ ኡባፈ ግዶን ጫቅዳ ታ ጫቁዋ አኬካና። ደኦይ ደእያ መተ ኡባ ይሳናዉ ህዛፐ ጉየ ዮ ሃ ዬና። <verse eid="GEN 9:15"/><verse number="16" style="v" sid="GEN 9:16"/>ዙል ሻራን ኤቅዳ ዎደ ታ እያ በአዳ ታፐነ ሳአ ቦላ ደእያ ዱማ ዱማ መተ ኡባፈ ግዶን ጫቅዳ መርና ጫቁዋ አኬካና” ያግስ።<verse eid="GEN 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 9:17"/>ፆሳይ ኖሄ፥ “ታኒ ታፐነ ሳአ ቦላ ደኦይ ደእያባ ኡባፈ ግዶን ጫቅዳ ጫቁዋ ማላይ ሀይሳ” ያግስ።<verse eid="GEN 9:17"/></para>
  <para style="s1">ኖሄነ እያ ናይታ</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18"/>ማርካብያፐ ከይዳ ኖሄ አደ ናይት ሴማ፥ ካማነ ያፈታ፤ ካም ካናነ አዋ። <verse eid="GEN 9:18"/><verse number="19" style="v" sid="GEN 9:19"/>ሀ ሄት ኖሄ ናይታ፤ ሳአ ኡባን ደእያ አሳይ ኤንታፈ የለትዶሶና።<verse eid="GEN 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20"/>ኖሄይ ጎሻንቾ፤ እ ዎይነ ቶከን ኮይሮ አስ። <verse eid="GEN 9:20"/><verse number="21" style="v" sid="GEN 9:21"/>እስ ጋላስ ኖሄይ ሄ ዎይንያፐ ኡይድ ማትድ ባ ዱንካንያ ግዶን ፅረ ካሎ ዝንእስ። <verse eid="GEN 9:21"/><verse number="22" style="v" sid="GEN 9:22"/>ካናነ አዋ ካም ባ አዋ ካሉዋ በእድ፥ ካረ ከይድ፥ ባ ናምኡ እሻታስ ኦድስ። <verse eid="GEN 9:22"/><verse number="23" style="v" sid="GEN 9:23"/>ሽን ሴምነ ያፈት አፍላ ኤክድ፥ ናምአይካ ባንታ ሀሽያራ ሀሽያራ ጋ ኦይክድ፥ ጉየ ጉ ሄመት ገልድ፥ ባንታ አዋ ካሉዋ ካምዶሶና። ኤንቲ ባንታ አዋ ካሉዋ በኦና መላ ባንታ አይፍያ ሀራሶ ዛርዶሶና።<verse eid="GEN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 9:24"/>ኖሄይ ማይ አን፥ ባርክድ፥ እያ ካሎ ናአይ ኦዳባ ኤርስ። <verse eid="GEN 9:24"/><verse number="25" style="v" sid="GEN 9:25"/>ኖሄይ እያኮ፥</para>
  <para style="q1" vid="GEN 9:25">“ካናነይ ባደትዳባ ግዶ!</para>
  <para style="q2" vid="GEN 9:25">እ ባ እሻታስ ዉርሰ አይለ ግዶ”</para>
  <para style="m" vid="GEN 9:25">ያግስ።<verse eid="GEN 9:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 9:26"/>ቃስካ ኖሄይ፥</para>
  <para style="q1" vid="GEN 9:26">“ጎዳይ፥ ሴማ ፆሳይ ጋላተቶ!</para>
  <para style="q2" vid="GEN 9:26">ካናነይ ሴማ አይለ ግዶ፤<verse eid="GEN 9:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 9:27"/>ፆሳይ ያፈታ ቢታ አሶ።</para>
  <para style="q2" vid="GEN 9:27">ያፈታ ሼሻይ ሴማ ሼሻራ ዎላ ደኦና፤</para>
  <para style="q2" vid="GEN 9:27">ካናነይ ያፈታ አይለ ግዶ” ያግስ።<verse eid="GEN 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28"/>ዮ ሃፈ ጉየ፥ ኖሄይ ሄ ፄታነ እሻታሙ ላይ ደእስ። <verse eid="GEN 9:28"/><verse number="29" style="v" sid="GEN 9:29"/>ኖሄይ ኡዱፉን ፄታነ እሻታሙ ላይ ደእድ ሀይቅስ።<verse eid="GEN 9:29"/></para>
  <chapter eid="GEN 9"/>
  <chapter number="10" style="c" sid="GEN 10"/>
  <para style="s1">ኖሄ ሼሻ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1"/>ኖሄ ናይታ፥ ሴማ፥ ካማነ ያፈታ የለተይ ሀይሳፈ ካልድ ፃፈትዳይሳ። ዮ ሃፈ ጉየ፥ ኤንታዉ አደ ናይት የለትዶሶና።<verse eid="GEN 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 10:2"/>ያፈታ አደ ናይት፥ ጎመራ፥ ማጎገ፥ ማዳያ፥ ያዋና፥ ቱባላ፥ ሞሳሀነ ትራሳ።<verse eid="GEN 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 10:3"/>ጎመራ አደ ናይት፥ አስካናዛ፥ እርፋታነ ቶጋርማ።<verse eid="GEN 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 10:4"/>ያዋና አደ ናይት፥ ኤልሻ፥ ታርሰሳ፥ ክፅማነ ሮዳ።<verse eid="GEN 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 10:5"/>ሀይሳቲ ዩሾይ አባን ተቀትዳ ቢታን ደእያ ያፈታ ሼሻታስ ማይዛታ። ኤንቲ ባንታ ቢታን ቢታን፥ ባንታ ዶናን ዶናንነ ባንታ ካዎተን ካዎተን ሻከትድ ደእያ ደረታ።<verse eid="GEN 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 10:6"/>ካማ አደ ናይት፥ ኩሻ፥ ግብፀ፥ ሊበነ ካናነ።<verse eid="GEN 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 10:7"/>ኩሻ አደ ናይት፥ ሳባ፥ ሀውላ፥ ሳብታ፥ ራእማነ ሳብታካ።</para>
  <para style="p" vid="GEN 10:7">ራእመ አደ ናይት፤ ሳባነ ደዳና።<verse eid="GEN 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 10:8"/>ኩሽ ናምሩደ የልስ፤ ናምሩደይ ሀ ሳአን ኮይሮ ዎልቃማ ኦላንቾ ግድስ። <verse eid="GEN 10:8"/><verse number="9" style="v" sid="GEN 10:9"/>ጎዳ ማደን ዎልቃማ ሻንካንቾ ግድስ። አሳይ፥ “ናምሩደዳ ጎዳይ ነና ዎልቃማ ሻንካንቾ ከሶ” ግድ አንጀይ ሄሳ ግሾሳ። <verse eid="GEN 10:9"/><verse number="10" style="v" sid="GEN 10:10"/>እያ ካዎተስ ኮይሮ ካታማት ሳናኦራ<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="fq" closed="false">ሳናኦራ፦ </char><char style="ft" closed="false">ዎይኮ ባብሎነ</char></note> ቢታን ደእያ ባብሎነ፥ ኤረካ፥ አርካዳነ ካልነ። <verse eid="GEN 10:10"/><verse number="11" style="v" sid="GEN 10:11"/>እ ሄ ቢታፈ አሶረ ብድ፥ ናናወ፥ ረሆቦታነ ካላሀ ኬፅስ። <verse eid="GEN 10:11"/><verse number="12" style="v" sid="GEN 10:12"/>ቃስ ናናወፐነ ካላሀ ካታማፐ ግዶን ረሴና ኬፅስ።<verse eid="GEN 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 10:13"/>ምፅራይም፥ ሉደታ፥ አናምመታ፥ ላሀበታ፥ ናፍቱሄታ፥ <verse eid="GEN 10:13"/><verse number="14" style="v" sid="GEN 10:14"/>ፓትሮሳታነ ፍልስፄመ ኮቻ የልዳ ካስሉሄማታነ ቃፍቶረታ ማይዛ። <verse eid="GEN 10:14"/><verse number="15" style="v" sid="GEN 10:15"/>ካናነይ ባ ባይራ ናአ ስዶናነ ሄታ የልስ። <verse eid="GEN 10:15"/><verse number="16" style="v" sid="GEN 10:16"/>ቃስ ካናነ ሼሻት ያቡሰታ፥ አሞረታ፥ ገርገሰታ፥ <verse eid="GEN 10:16"/><verse number="17" style="v" sid="GEN 10:17"/>ህወታ፥ አርከታ፥ ሲናታ፥ <verse eid="GEN 10:17"/><verse number="18" style="v" sid="GEN 10:18"/>አርዋደታ፥ ፃማራታነ ሀማታታ የልስ። ሄሳፈ ጉየ፥ ካናነ ሼሻት ዱማ ዱማ በሲ ላለትዶሶና። <verse eid="GEN 10:18"/><verse number="19" style="v" sid="GEN 10:19"/>ካናነ ቢታ ዛዋይ ስዶናፐ ዶምድ፥ ጋራራነ ጋዛራ ጋክድ፥ ሶዶመነ ጋሞራ፥ አዳማነ ፃቦይማ ብድ፥ ላሻአ ጋክ ኤቅስ። <verse eid="GEN 10:19"/><verse number="20" style="v" sid="GEN 10:20"/>ሀይሳቲ ካማ ሼሻታ፤ ኤንታዉ ዱማ ዱማ ዶን፥ ዱማ ዱማ ቢትነ ዱማ ዱማ ካዎተ ደኤስ።<verse eid="GEN 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21"/>ሴማስ ናይት የለትዶሶና። እ ያፈታስ ባይራ እሻነ ኤቦራ ናይታ ኡባስ ማይዛ። <verse eid="GEN 10:21"/><verse number="22" style="v" sid="GEN 10:22"/>ሴማ አደ ናይት፥ ኤላማ፥ አሶረ፥ አርፋክሳደ፥ ሉደነ አራመ።<verse eid="GEN 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 10:23"/>አራመ አደ ናይት፥ ኡፃ፥ ሁላ፥ ገተራነ ማሸካ።<verse eid="GEN 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 10:24"/>አርፋክሳድ ሳላ የልስ። ሳል ኤቦራ የልስ።<verse eid="GEN 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 10:25"/>ኤቦራስ ናምኡ አደ ናይት የለትዶሶና። ሳአን ደእያ አሳይ እያ ዎደ ሻከትዳ ግሾ እሱዋ ፐለጋ<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="fq" closed="false">ፐለጋ፦ </char><char style="ft" closed="false">እብራወ ዶናን ሀ ሱን ብርሸይ “ሻከተ” ጉሱ።</char></note> ግድ ሱንስ። እያ እሻ ሱንይ ዮቅፃና።<verse eid="GEN 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 10:26"/>ዮቅፃና ሼሻት ሀይሳታ። ኤንትካ አልሞዳዳ፥ ሳለፋ፥ ሀሰርሞታ፥ ያራሀ፥ <verse eid="GEN 10:26"/><verse number="27" style="v" sid="GEN 10:27"/>ሀዶራማ፥ ኡዛላ፥ ድቅላ፥ <verse eid="GEN 10:27"/><verse number="28" style="v" sid="GEN 10:28"/>ኦባላ፥ አብማላ፥ ሳባ፥ <verse eid="GEN 10:28"/><verse number="29" style="v" sid="GEN 10:29"/>ኦፍራ፥ ሀውላነ ዮባባ። ሀይሳቲ ኡባይ ዮቅፃና ሼሻታ።<verse eid="GEN 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 10:30"/>ኤንቲ ደእዳ ሄራይ ሜሳፐ ብድ ዶሎሀ ባጋራ ደእያ ደረይ ዳርያ ሳፋራ ቢታ ጋኬስ። <verse eid="GEN 10:30"/><verse number="31" style="v" sid="GEN 10:31"/>ሀይሳቲ ኡባይ ሴማ ሼሻታ፤ ኤንታዉ ዱማ ዱማ ዶን፥ ዱማ ዱማ ቢትነ ዱማ ዱማ ካዎተ ደኤስ።<verse eid="GEN 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32"/>ሀይሳቲ ኡባይ ባንታ ሼሻን ሼሻንነ ባንታ ካዎተን ካዎተን ፃፈትዳ ኖሄ ናይታ። ዮ ሃፈ ጉየ ካዎተት ሀይሳታፐ ሳአ ኡባ ላለትዶሶና።<verse eid="GEN 10:32"/></para>
  <chapter eid="GEN 10"/>
  <chapter number="11" style="c" sid="GEN 11"/>
  <para style="s1">ባብሎነ ግምበ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1"/>ሳአ ቦላ ደእያ አስ ኡባይ ኮይሮ እስ ዶናን ኦደቴስ። <verse eid="GEN 11:1"/><verse number="2" style="v" sid="GEN 11:2"/>ኤንቲ ዶሎሀ ባጋፈ ደንድድ ብዳ ዎደ ሳናኦራ ቢታን ደምባ በሲ ደምድ ያን ኡትዶሶና።<verse eid="GEN 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 11:3"/>ኤንቲ እሶይ እሱዋኮ፥ “ሃ ዪተ፥ ፁበ መድ፥ ምናና መላ ታማን ፁጎስ” ያግዶሶና። ኤንቲ ሹቻ ግሾ ፁበ፥ ኡርቃ ግሾ ማደ መላባ፥ <verse eid="GEN 11:3"/><verse number="4" style="v" sid="GEN 11:4"/>ኤክድ፥ “ሃ ዪተ፥ ኑ ሱን ፄግሳናዉነ ቃስ ኑኒ ሀ ሳአ ቦላ ላለቶና አታና መላ እስ ግታ ካታማነ ፄራይ ሳሎ ጋክያ ፖቀ ኬፆስ” ያግዶሶና።<verse eid="GEN 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5"/>ሽን ጎዳይ አሳት ኬፅዳ ግታ ካታማነ ፖቅያ በአናዉ ዱገ ዎስ። <verse eid="GEN 11:5"/><verse number="6" style="v" sid="GEN 11:6"/>ጎዳይ ሀይሳዳ ያግስ፤ “ሄኮ፥ ኤንቲ እስ አስ፤ ኤንቲ ኡባይካ እስ ዶናን ኦደትዶሶና። ኤንቲ ሀእ ሀይሳ ኦናዉ ዶምዶሶና። ኤንቲ ባንታዉ ኦናዉ ሀልችዳባ ፖሎና አጎኮና። <verse eid="GEN 11:6"/><verse number="7" style="v" sid="GEN 11:7"/>ያንያ ግሾ፥ ሃይተ፤ ዱገ ዎድ ኤንቲ እሶይ ሃሳይያ ዶና እሶይ ኤሮና መላ ኤንታ ዶና ዱማዮስ” ያግስ። <verse eid="GEN 11:7"/><verse number="8" style="v" sid="GEN 11:8"/>ጎዳይ ኤንታ ሄሳፈ ሳአ ኡባ ቦላ ላልን፥ ኤንቲ ካታማ ኬፀይሳ አጋግዶሶና። <verse eid="GEN 11:8"/><verse number="9" style="v" sid="GEN 11:9"/>ጎዳይ ሳአን ደእያ አሳ ዶና ያን ቡቅዳ ግሾ ሄ ካታማ ሱንይ ባብሎነ<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="fq" closed="false">ባብሎነ፦ </char><char style="ft" closed="false">እብራወ ዶናን ሀ ሱን ብርሸይ “ዋላከትስ” ጉሱ</char></note> ጌተትስ። ጎዳይ ኤንታ ሄሳፈ ሳአ ኡባ ቦላ ላልስ።<verse eid="GEN 11:9"/></para>
  <para style="s1">ሴማ የለተ</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10"/>ሴማ የለተይ ሀይሳፈ ካልድ ፃፈትዳይሳ፤ ዮ ሃፈ ጉየ፥ ናምኡ ላይ ግድን፥ ሴማስ ላይ ፄታ ግድዳ ዎደ፥ ሴም አርፋክሳደ የልስ። <verse eid="GEN 11:10"/><verse number="11" style="v" sid="GEN 11:11"/>ሴም አርፋክሳደ የልዳፐ ጉየ፥ እቻሹ ፄቱ ላይ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ።<verse eid="GEN 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12"/>አርፋክሳድ 35 ላይ ደእድ፥ ሳላሀ የልስ። <verse eid="GEN 11:12"/><verse number="13" style="v" sid="GEN 11:13"/>አርፋክሳድ ሳላ የልዳፐ ጉየ፥ 403 ላይ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ።<verse eid="GEN 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14"/>ሳል 30 ላይ ደእድ፥ ኤቦራ የልስ። <verse eid="GEN 11:14"/><verse number="15" style="v" sid="GEN 11:15"/>ሳል ኤቦራ የልዳፐ ጉየ፥ 403 ላይ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ።<verse eid="GEN 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16"/>ኤቦሪ 34 ላይ ደእድ፥ ፐለጋ የልስ። <verse eid="GEN 11:16"/><verse number="17" style="v" sid="GEN 11:17"/>ኤቦሪ ፐለጋ የልዳፐ ጉየ፥ 430 ላይ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ።<verse eid="GEN 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18"/>ፐለግ 30 ላይ ደእድ፥ ራአ የልስ። <verse eid="GEN 11:18"/><verse number="19" style="v" sid="GEN 11:19"/>ፐለግ ራአ የልዳፐ ጉየ 209 ላይ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ።<verse eid="GEN 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20"/>ራእ 32 ላይ ደእድ፥ ሳሩጋ የልስ። <verse eid="GEN 11:20"/><verse number="21" style="v" sid="GEN 11:21"/>ራእ ሳሩጋ የልዳፐ ጉየ፥ 207 ላይ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ።<verse eid="GEN 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22"/>ሳሩግ 30 ላይ ደእድ፥ ናኮራ የልስ። <verse eid="GEN 11:22"/><verse number="23" style="v" sid="GEN 11:23"/>ሳሩግ ናኮራ የልዳፐ ጉየ፥ 200 ላይ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ።<verse eid="GEN 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24"/>ናኮር 29 ላይ ደእድ፥ ታራ የልስ። <verse eid="GEN 11:24"/><verse number="25" style="v" sid="GEN 11:25"/>ናኮር ታራ የልዳፐ ጉየ፥ 119 ላይ ደእስ። ሀራ አደ ናይታነ ማጫ ናይታ የልስ።<verse eid="GEN 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26"/>ታር 70 ላይ ደእድ፥ አብራመ፥ ናኮራነ ሃራነ የልስ።<verse eid="GEN 11:26"/></para>
  <para style="s1">ታራ የለተ</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27"/>ታራ የለተይ ሀይሳፈ ካልድ ፃፈትዳይሳ፤ ታሪ አብራመ፥ ናኮራነ ሃራነ የልስ። ያትን ሀራን ሎፀ የልስ። <verse eid="GEN 11:27"/><verse number="28" style="v" sid="GEN 11:28"/>ሀራን ባ አዋይ ታሪ ፓፃ ደእሽን፥ ባ የለትዳ ካልዳወታ ቢታን፥ ግታ ኡረ ካታማን ሀይቅስ። <verse eid="GEN 11:28"/><verse number="29" style="v" sid="GEN 11:29"/>አብራመይነ ናኮረይ ናምአይካ ማችዶሶና። አብራመ ማቸ ሱንይ ሶራ። ቃስ ናኮራ ማቸ ሱንይ ምልኮ። ምልካ ሃራና ናእዉ፤ ሃራነይ ምልካነ ዮስካ አዋ። <verse eid="GEN 11:29"/><verse number="30" style="v" sid="GEN 11:30"/>ሶራ ማይን ግድዳ ግሾ እዉ ናእ ባዋ።<verse eid="GEN 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31"/>ታር ባ ናኣ አብራመ፥ ባ ናኣ ሃራነ ናኣ ሎፀነ፥ ባ ናኣ አብራመ ማችዉ ሶራ ኤክድ፥ ካናነ ቢታ ባናዉ ካልዳወታ ካታማ ኡረፐ ደንድስ። ሽን ኤንቲ ካራነ ካታማ ጋክድ ያን ኡትዶሶና። <verse eid="GEN 11:31"/><verse number="32" style="v" sid="GEN 11:32"/>ታር 205 ላይ ደእድ ካራነን ሀይቅስ።<verse eid="GEN 11:32"/></para>
  <chapter eid="GEN 11"/>
  <chapter number="12" style="c" sid="GEN 12"/>
  <para style="s1">አብራመ ፄገተ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1"/>ጎዳይ አብራመኮ፥ “ነ ቢታፈ፥ ነ ደርያፐ፥ ነ ሶ አሳፐ፥ ሻከታዳ ታ ነና በሲያ ቢታ ባ። <verse eid="GEN 12:1"/><verse number="2" style="v" sid="GEN 12:2"/>ታ ነና ዎልቃማ ደረ ኦና፥ ነና ታ አንጃና ነ ሱን ግታ ከሳና፤ ነ ሀራታስ አንጆ ግዳና። <verse eid="GEN 12:2"/><verse number="3" style="v" sid="GEN 12:3"/>ታኒ ነና አንጀይሳታ አንጃና፤ ነና ባደይሳታ ባዳና፥ ቢታ ቦላ ደእያ ደረ ኡባይ ነ ጋሶራ አንጀታና” ያግስ።<verse eid="GEN 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4"/>ሄሳ ግሾ፥ አብራመይ ፆሳይ እያ ኪትዳይሳዳ ከይስ። ሎፀይ እያራ እስፈ ብስ። አብራመይ ካራነፐ ከይያ ዎደ እያዉ ላይ ላፑን ታማነ እቻሻ። <verse eid="GEN 12:4"/><verse number="5" style="v" sid="GEN 12:5"/>አብራመይ ባ ማችዉ ሶራ፥ ባ እሻ ናአ ሎፀ፥ ካራነን ደእሸ ሺሽዳ ሻሉዋነ ባ አይለታ ኡባ ኤክድ ካናነ ቢታ ብድ ጋክዶሶና። <verse eid="GEN 12:5"/><verse number="6" style="v" sid="GEN 12:6"/>አብራመይ ሴከማን ደእያ ሞረ ጌተትያ ግታ ምኮ ጋካናዉ ካንድ ብስ። ሄ ዎደ ካናነ አሳት ሄ ቢታን ደኦሶና። <verse eid="GEN 12:6"/><verse number="7" style="v" sid="GEN 12:7"/>ፆሳይ አብራመስ ያን ቆንጭድ፥ “ሀ ቢታ ታኒ ነ ሼሻስ እማና” ያግስ። እካ ባ ቆንጭዳ ጎዳስ ሄ በሳን ያርሾ በሲ ጊግስስ። <verse eid="GEN 12:7"/><verse number="8" style="v" sid="GEN 12:8"/>ሄ በሳፈ ደንድድ ቤተለፐ ዶሎሀ ባጋራ ደእያ ዙማኮ ብስ። ያን ቤተለ ዉሎሀ ባጋን፥ ጋየ ዶሎሀ ባጋን አግድ፥ ባ ዱንካንያ ቶክስ፤ ያን ጎዳስ ያርሾ በሲ ጊግስድ ጎዳ ሱን ፄግስ። <verse eid="GEN 12:8"/><verse number="9" style="v" sid="GEN 12:9"/>ሄሳፈ ጉየ፥ አብራመይ በሳፈ በሰ አሸ ነገበ ጋክስ።<verse eid="GEN 12:9"/></para>
  <para style="s1">አብራመይ ግብፀ ቢታን</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10"/>ሄ ዎደ ካናነ ቢታን ኮሽ ከይስ። ኮሻይ ምንዳ ግሾ ጉ ዎደ ያን ዳናዉ አብራመይ ግብፀ ቢታ ብስ። <verse eid="GEN 12:10"/><verse number="11" style="v" sid="GEN 12:11"/>ግብፀ ገላናዉ ማትያ ዎደ አብራመይ ባ ማቸ ሶራኮ፥ “ኔኒ ማላ ሎኦ ግደይሳ ታኒ ኤራይስ፤ <verse eid="GEN 12:11"/><verse number="12" style="v" sid="GEN 12:12"/>ግብፀ አሳት ነና በእድ፥ ‘ሀና እያ ማችዉ’ ያግድ ታና ዎድ ነና አጋጋና። <verse eid="GEN 12:12"/><verse number="13" style="v" sid="GEN 12:13"/>ሄሳ ግሾ፥ ነ ግሾ ግድ ታዉ ሎኦባ ኦና መላነ ታ ሸምፕያ አታና መላ ‘ታ እያዉ ምቾ’ ያጋ” ያግስ። <verse eid="GEN 12:13"/><verse number="14" style="v" sid="GEN 12:14"/>አብራመይ ግብፀ ቢታ ጋክዳ መላ ግብፀ አሳት ሶራ ማላ ሎኦ ማጫስ ግዶይሳ በእዶሶና። <verse eid="GEN 12:14"/><verse number="15" style="v" sid="GEN 12:15"/>ግብፀ ፓሮና ሞርናት እዮ በእድ ዳሮ ናሽድ ካዋ ፋሮናስ ኦድዶሶና፥ እዮካ ካዋ ስን ኤፍዶሶና። <verse eid="GEN 12:15"/><verse number="16" style="v" sid="GEN 12:16"/>እ ጋሶን ካዎይ አብራመ ቦንችድ ሞክስ። ጉጅድካ ዶርሳታ፥ ሚዛታ፥ ሀረታ፥ ግማለታ፥ አደ አይለታነ ማጫ አይለታ እያዉ እሚስ። <verse eid="GEN 12:16"/><verse number="17" style="v" sid="GEN 12:17"/>ሽን ጎዳይ አብራመ ማቸ ሶራ ጋሶን ግብፀ ካዋነ እያ ኬ ጋዶ ሀርገን ሾጭስ። <verse eid="GEN 12:17"/><verse number="18" style="v" sid="GEN 12:18"/>ሄሳፈ ጉየ፥ ካዎይ አብራመ ፄግስድ፥ “ነ ታ ቦላ ኦዳባይ ሀይስ አይቤ? እያ ነ ማቾ ግደይሳ አይስ ታዉ ኦዳብኪ? <verse eid="GEN 12:18"/><verse number="19" style="v" sid="GEN 12:19"/>አይስ ታ ምቾ ጋዳ ዎርዶታዲ? ታ እዮ ማቾ ኦዳ ኤካስ፥ ሽን አትስ፤ ነ ማችያ ሀናሹ ኤካ ባ” ያግስ። <verse eid="GEN 12:19"/><verse number="20" style="v" sid="GEN 12:20"/>ሄሳፈ ጉየ፥ አብራመነ እያ ማችዉ እያዉ ደእያባ ኡባራ ከስ የዳና መላ ካዎይ ባ አሳታ ኪትስ።<verse eid="GEN 12:20"/></para>
  <chapter eid="GEN 12"/>
  <chapter number="13" style="c" sid="GEN 13"/>
  <para style="s1">አብራመነ ሎፀ ሻከተ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1"/>አብራመይ ባአ ማቺው ሶራነ ባዉ ደእያባ ኡባ ኤክድ ግብፀፈ ነገበ መላ ቢታ ብስ። ሎፀይካ እያራ ዎላ ብስ። <verse eid="GEN 13:1"/><verse number="2" style="v" sid="GEN 13:2"/>አብራመይ ሄ ዎደ መሄን፥ ብራንነ ዎርቃን ዳሮ ዱረትስ።<verse eid="GEN 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 13:3"/>አብራመይ ናገበፐ ደንድድ በሳፈ በሰ አሸ ቤተለ ጋካናዉ ብስ። ቤተለፐነ ጋየፐ ግዶን እ ኮይሮ ዱንካንያ ቶክዳ በሳነ <verse eid="GEN 13:3"/><verse number="4" style="v" sid="GEN 13:4"/>ጎዳስ ካሰ ያርሾ ያርሽዳ በሳ ጋክድ፥ ያን አብራመይ ጎዳ ሱን ፄግስ።<verse eid="GEN 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5"/>አብራመራ ዎላ ሄመትያ ሎፀስካ ዳሮ ዶርሳት፥ ዴሻት፥ መሄት፥ ሶ አሳትነ አይለት ደኦሶና። <verse eid="GEN 13:5"/><verse number="6" style="v" sid="GEN 13:6"/>ሄ ዎደ አብራመስነ ሎፀስ ዳሮ መሄይ ደእያ ግሾ ኤንቲ ባንታ መሄታ ሄምያ በሳይ ፁምስ። <verse eid="GEN 13:6"/><verse number="7" style="v" sid="GEN 13:7"/>ሄሳ ግሾ፥ አብራመ መሄታ ሄመይሳታ ግዶንነ ሎፀ መሄታ ሄመይሳታ ግዶን ካች ከይስ። ሄ ዎደ ካናነ አሳትነ ፓርዘ አሳት ሄ ቢታን ደኦሶና።<verse eid="GEN 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8"/>ሄሳ ግሾ፥ አብራመይ ሎፀኮ፥ “ኑኒ እሻንታ ግድያ ግሾ ኑ ግዶን ዎይኮ ኑ መሄታ ሄመይሳታ ግዶን ካች ዳናዉ በሰና። <verse eid="GEN 13:8"/><verse number="9" style="v" sid="GEN 13:9"/>ቢታይ ዳልጋ ግድያ ግሾ ኑ ዎልፐ ሻከታና። ነ ሀድርሳ ባጋ ቢኮ ታኒ ኡሻቻ ባጋ ባና፤ ኔኒ ኡሻቻ ባጋ ቢኮ ታኒ ሀድርሳ ባጋ ባና” ያግስ። <verse eid="GEN 13:9"/><verse number="10" style="v" sid="GEN 13:10"/>ሎፀይ ቢታ ዩይ አድ ፄልያ ዎደ ዮርዳኖሰ ዛንጋራይ፥ ጎዳ ጋናትያዳ ዎይኮ ዞኣረ ባጋራ ደእያ ግብፀ ቢታ መላ ሃ ኩምዳይሳ በእስ። ሄስካ፥ ሀንዳይ ጎዳይ ሶዶመነ ጋሞራ ጌተትያ ካታማታ ይሳናፐ ስን። <verse eid="GEN 13:10"/><verse number="11" style="v" sid="GEN 13:11"/>ሄሳ ግሾ፥ ሎፀይ ዮርዳኖሰ ዛንጋራ ኡባ ባዉ ዶርድ ዶሎሀ ባጋ ብስ። ሄሳዳ ሀንድ እሶይ እሱዋፈ ሻከትዶሶና። <verse eid="GEN 13:11"/><verse number="12" style="v" sid="GEN 13:12"/>አብራመይ ካናነ ቢታን ደእስ። ሽን ሎፀይ ዛንጋራን ደእያ ካታማታ ግዱዋን ሶዶመ ማታን ባ ዱንካንያ ቶክስ። <verse eid="GEN 13:12"/><verse number="13" style="v" sid="GEN 13:13"/>ሄ ዎደ ሶዶመ አሳይ ዳሮ ኢታነ ጎዳ ስንን ናጋራንቾታ። <verse eid="GEN 13:13"/><verse number="14" style="v" sid="GEN 13:14"/>ሎፀይ አብራመፐ ሻከትዳፐ ጉየ፥ ጎዳይ አብራመኮ፥ “ነ ደእያ በሳፈ ፑደ ቁ ጋዳ ፑደሀ ባጋነ ዱገሀ ባጋ፥ ዶሎሀ ባጋነ ዉሎሀ ባጋ የዳ ፄላ። <verse eid="GEN 13:14"/><verse number="15" style="v" sid="GEN 13:15"/>ሄ ኔኒ በእያ ቢታ ኡባ ታኒ መርናዉ ነዉነ ነ ሼሻስ እማና። <verse eid="GEN 13:15"/><verse number="16" style="v" sid="GEN 13:16"/>ታኒ ነ ሼሻ ቢታ ባናዳ ዳርሳና። ኦንካ ቢታ ባና ታይባናዉ ዳንዳኦናይሳዳ ነ ሼሻይካ ታይበተና። <verse eid="GEN 13:16"/><verse number="17" style="v" sid="GEN 13:17"/>ታኒ ሀ ቢታ ነዉ እማና ግሾ ደንዳዳ ቢታ አዱሳተንነ ዳልጋተን ስመረታ።” <verse eid="GEN 13:17"/><verse number="18" style="v" sid="GEN 13:18"/>ሄሳ ግሾ፥ አብራመይ ባ ዱንካንያ ሾድድ ከብሮናን ደእያ ማምረ ግታ ምታ ማታን ደአናዉ ብስ። ያን ጎዳስ ያርሾ በሲ ጊግስስ።<verse eid="GEN 13:18"/></para>
  <chapter eid="GEN 13"/>
  <chapter number="14" style="c" sid="GEN 14"/>
  <para style="s1">አብራመይ ሎፀ ዎስሰ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1"/>ሳናኦራ ካዎይ አምራፌል፥ ኤልሳረ ካዎይ አርዮክ፥ ኤላማ ካዎይ ኮሎዶጎሞርነ ጎይማ ካዎይ ትዳለይ ኦይዱ ካዎተት ዎላ፥ <verse eid="GEN 14:1"/><verse number="2" style="v" sid="GEN 14:2"/>እቻሹ ካዎተታራ፥ ሶዶመ ካዋ በራራ፥ ጋሞራ ካዋ በርሳራ፥ አዳማ ካዋ ሰንአበራ፥ ፅቦይማ ካዋ ሳምባራነ ዞኣራ ጌተትያ ቤላ ካዉዋራ ኦለታናዉ ደንድዶሶና። <verse eid="GEN 14:2"/><verse number="3" style="v" sid="GEN 14:3"/>ሀ እቻሹ ካዎተት እስፈ ሺቅድ ማፅነ አባ ጌተትያ ስድማ ዛንጋራን ባንታ ቶራ ሺሽዶሶና። <verse eid="GEN 14:3"/><verse number="4" style="v" sid="GEN 14:4"/>ሀ ካዎተት ታማነ ናምኡ ላይ ኮሎዶጎሞራስ ሃረትዶሶና ሽን ታማነ ሄን ላይን እያዉ ኪተቶና እፅዶሶና። <verse eid="GEN 14:4"/><verse number="5" style="v" sid="GEN 14:5"/>ታማነ ኦይዳን ላይን ኮሎዶጎሞርነ እያራ ቶቢዳ ካዎተት ባንታ ኦላንቾታ ኤክ ብድ ራፋይመታ አስታሮተን ደእያ ቃርናይማን፥ ዙዛይተታ ሃማን፥ ኤምመታ ሳወን ደእያ ቅራታይማን፤ <verse eid="GEN 14:5"/><verse number="6" style="v" sid="GEN 14:6"/>ቃስ ሆራ ቢታ አሳታካ ደረይ ዳርያ ሳይረ ቢታን ኦል ፆንድ፥ መላ ቢታ ማታን ደእያ ኤልፋራና ጌተትያ በሳ ጋካናዉ ጎድዶሶና። <verse eid="GEN 14:6"/><verse number="7" style="v" sid="GEN 14:7"/>ያፐ ስሚድ፥ ቃደሳ ጌተትያ አይን ምስፓታ ይዶሶና። አማለቃታ ቢታ ኡባነ ሀዛዞን ታማረን ደእያ አሞረታ ቢታ ኦል ፆንድ ኦይክዶሶና።<verse eid="GEN 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8"/>ሄሳፈ ጉየ፥ ሶዶመ ካዎይ፥ ጋሞራ ካዎይ፥ አዳማ ካዎይ፥ ዘቦይማ ካዎይ፥ ዞኣረ ጌተትያ ቤላ ካዎይ ደንድድ ስድማ ዛንጋራን ኦላስ ጊግዶሶና። <verse eid="GEN 14:8"/><verse number="9" style="v" sid="GEN 14:9"/>ሀ እቻሹ ካዎተት፥ ኤላማ ካዋራ፥ ጎይማ ካዋራ፥ ሳናኦራ ካዋራነ ኤልሳረ ካዋራ ሀ ኦይዱ ካዎተታራ ኦለትዶሶና። <verse eid="GEN 14:9"/><verse number="10" style="v" sid="GEN 14:10"/>ሄ ዎደ ስድማ ዛንጋራን ማደዳ ኦይክያባት ደእያ ኦላት ደኦሶና። ሶዶመ ካዎይነ ጋሞራ ካዎት ኦላፐ አታናዉ ባቃትሸ ሄ ኦላን ዉልዶሶና። ሽን ሀንኮ ሄ ካዎተት ዙማኮ ባቃትድ አትዶሶና። <verse eid="GEN 14:10"/><verse number="11" style="v" sid="GEN 14:11"/>ኦይዱ ካዎተት ሶዶመንነ ጋሞራን ደእያባ ኡባ ሀር አቶሽን፥ ኤንታ ካካ ቦንቅድ ኤፍዶሶና። <verse eid="GEN 14:11"/><verse number="12" style="v" sid="GEN 14:12"/>አብራመ እሻ ናአይ ሎፀይ ሶዶመን ደእያ አስ ግድያ ግሾ እካ ባዉ ደእያባ ኡባራ ድኤትስ።<verse eid="GEN 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13"/>ሄሳፈ ጉየ፥ ድኤት ብዳ አሳፐ ከስ ኤክዳ እስ አስ ይድ ሀንዳባ ኡባ እብራወ አድያ አብራሃመስ ኦድስ። ሄ ዎደ አብራመይ አሞረ አድያ ማምረ ግታ ምታ ማታን ደኤስ። ማምረይነ እያ እሻት አስኮልነ አኔር ኦላ ዛራናዉ አብራመራ ጫቅድ ኡትዶሶና። <verse eid="GEN 14:13"/><verse number="14" style="v" sid="GEN 14:14"/>አብራመይ ባ እሻ ናአይ ድኤትዳይሳ ስእዳ ዎደ ባ ሶን የለት ድጭድ ሎህዳ 318 ቶራንቾታ ኤክድ ኤንታ ገዶ ካልድ ዳነ ካታማ ጋካናዉ ብስ። <verse eid="GEN 14:14"/><verse number="15" style="v" sid="GEN 14:15"/>እ ባራ ኤክ ብዳ ቶራንቾታ ቃማ ጩጋን ጩጋን ሻክድ ሞርከታ ኦልድ ፆንስ። ዳማስቆፈ ፑደሀ ባጋራ ደእያ ሆበ ጌተትያ በሲ ጋካናዉ ጎድስ። <verse eid="GEN 14:15"/><verse number="16" style="v" sid="GEN 14:16"/>ያትድ ደኤትዳባ ኡባ፥ ባ እሻ ናአ ሎፀነ እያዉ ደእያባ ኡባ፥ ማጫሳነ ሀራ አሳታ ዎስስ ኤክስ።<verse eid="GEN 14:16"/></para>
  <para style="s1">ማልከፃደቃነ አብራመ</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17"/>አብራመይ ኮሎዶጎሞርነ እያራ ቶቢዳ ካዎታ ፆንድ ስምያ ዎደ ሶዶመ ካዎይ፥ ካዎታ ዛንጋራ ጌተትያ ሳወ ዛንጋራን እያ ሞካናዉ ከይስ።<verse eid="GEN 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 14:18"/>ኡባፈ ቃ ፆሳ ካህነይ፥ ሳሌማ ካዎይ ማልከፃደቅ ኡይነ ዎይነ ኤክድ ይስ። <verse eid="GEN 14:18"/><verse number="19" style="v" sid="GEN 14:19"/>እ ሀይሳዳ አብራመ አንጅስ፤</para>
  <para style="q1" vid="GEN 14:19">“ሳሎነ ሳአ መዳ፥</para>
  <para style="q2" vid="GEN 14:19">ኡባፈ ቃ ፆሳይ ነና አንጆ።<verse eid="GEN 14:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 14:20"/>ነ ሞርከታ ነ ኩሸን አድ እምዳ፥</para>
  <para style="q2" vid="GEN 14:20">ኡባፈ ቃ ፆሳይ ጋላተቶ” ያግድ አንጅስ።</para>
  <para style="m" vid="GEN 14:20">አብራመይ ባ ደምዳባ ኡባፈ አስራታ ከስድ ማልከፃደቃስ እሚስ።<verse eid="GEN 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21"/>ሶዶመ ካዎይ አብራመኮ፥ “ሻሉዋ ነ ኤካዳ፥ አሳ ታዉ እማ” ያግስ።<verse eid="GEN 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22"/>ሽን አብራመይ ሶዶመ ካዋኮ፥ “ታኒ ጎዳስ፥ ሳሉዋነ ሳአ መዳ ኡባፈ ቃ ፆሳስ ታ ኩሽያ ደንስ። <verse eid="GEN 14:22"/><verse number="23" style="v" sid="GEN 14:23"/>ኔኒ፥ ‘አብራመ ዱረ ኦዳይ ታና ጎናዳ’ ሀር አቶሽን ክረ ዎይኮ ጫማ ዎዶሮካ ኤክከ። <verse eid="GEN 14:23"/><verse number="24" style="v" sid="GEN 14:24"/>ታ አሳት ምዳይሳፈ አትሽን ታ አይብባካ ኤክከ። ቃስ ታራ ብዳ አኔር፥ አስኮልነ ማምረይ ባንታና ጋክያባ ኤኮ” ያግስ።<verse eid="GEN 14:24"/></para>
  <chapter eid="GEN 14"/>
  <chapter number="15" style="c" sid="GEN 15"/>
  <para style="s1">ፆሳይ አብራመራ ጫቅዳ ጫቁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1"/>ሄሳፈ ጉየ፥ ጎዳይ አብራመስ አሙሆን ቆንጭድ፥</para>
  <para style="q1" vid="GEN 15:1">“አብራመ ባቦፋ፥ ታኒ ነዉ ጎንዳለ፥</para>
  <para style="q2" vid="GEN 15:1">ነ ዎይቶይ ግታ” ያግስ።<verse eid="GEN 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2"/>ሽን አብራመይ፥ “አቤት ኡባ ሃርያ ጎዳዉ፥ ኔኒ እምያ ዎይቶይ ታዉ አይሴ? ታዉ የሎይ ባዋ፤ ቡሮ ታና ላታናይ ዳማስቆ ኤልአዛራ ግደኔ? <verse eid="GEN 15:2"/><verse number="3" style="v" sid="GEN 15:3"/>አብራመይ፥ ኔኒ ታዉ የሎ እማቦና ግሾ ታ ኬን ደእያ ታ አይለይ ታና ላታና” ያግስ።<verse eid="GEN 15:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4"/>ጎዳይ እያኮ፥ “ሀ አይለይ ነና ላተና፥ ሽን ነ ጉልባታፐ ከያና ነ ናአይ ነና ላታና” ያግስ። <verse eid="GEN 15:4"/><verse number="5" style="v" sid="GEN 15:5"/>ያግ ስሚድ እያ ካረ ከስድ፥ “ፑደ ሳሎ ፄላ፥ ኔኒ ፆልንቶታ ፓይዳናዉ ዳንዳእኮ ፓይዳ፥ ህዛ ነ ሼሻይካ ሄሳዳ ግዳና” ያግስ።<verse eid="GEN 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6"/>አብራመይ ጎዳ አማንስ፤ ጎዳይ እያዉ ሄሳ ፅሎተ ኦድ ኤክስ።<verse eid="GEN 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7"/>ቃስካ ጎዳይ እያኮ፥ “ኔኒ ሀ ቢታ ላታና መላ ካልዳወታ ቢታፈ ኡረ ካታማፐ ነና ከስዳ ጎዳይ ታና” ያግስ።<verse eid="GEN 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8"/>ሽን አብራመይ እያኮ፥ “አቤት ኡባ ሃርያ ጎዳዉ ሀ ቢታ ታ ላታናይሳ አይብን ኤሮ?” ያግስ።<verse eid="GEN 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9"/>ጎዳይ እያኮ፥ “ሄ ላይ ግድዳ እስ ኡስ፥ እስ ዴሽ፥ እስ ዶርሰነ ሄሳዳካ ሆለነ ጎርለ ታዉ ኤካዳ ያ” ያግስ። <verse eid="GEN 15:9"/><verse number="10" style="v" sid="GEN 15:10"/>አብራመይ ሄሳታ ኡባ ፆሳስ ኤህድ ካፎት አትሽን፥ ሀራታ ቃንፅድ ናምኡ ከስ ሻክድ እሱዋ እሱዋ ግናን ዎስ። <verse eid="GEN 15:10"/><verse number="11" style="v" sid="GEN 15:11"/>አንኮት ሄ አሹዋ ማናዉ ቦላፈ ዎዶሶና፤ ሽን አብራመይ ኤንታ ጎድስ።<verse eid="GEN 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12"/>አው ዉላና ሀንያ ዎደ አብራመ ዎልቃማ ስኮይ ሾጭ የግስ። ዳጋንያ ዎልቃማ ም እያ ቦላ ዎስ። <verse eid="GEN 15:12"/><verse number="13" style="v" sid="GEN 15:13"/>ጎዳይ አብራመኮ፥ “ነ ሼሻይ አላጋ ቢታን በተ አስ ግድድ ዳናይሳ ሎይዳ ኤራ፤ ኤንቲ አይለተን ኦይዱ ፄቱ ላይ ናቀት ሃረታና። <verse eid="GEN 15:13"/><verse number="14" style="v" sid="GEN 15:14"/>ሽን ኤንታና አይለተን ሃርያ ደርያ ታ ፕርዳና፤ ኤንቲ ሄ ቢታፈ ከይሸ ዳሮ ሻሎ ኤክድ ከያና። <verse eid="GEN 15:14"/><verse number="15" style="v" sid="GEN 15:15"/>ነና ግድኮ፥ ኔኒ ነ ማይዛታኮ ሳሮተን ባና። ኔኒ ዳሮ ጭማዳ ሞገታና። <verse eid="GEN 15:15"/><verse number="16" style="v" sid="GEN 15:16"/>ነ ሼሻይ ቡሮ ኦይዳን የለተን ሀ ቢታ ስማና። አይስ ጊኮ፥ አሞረታ ናጋራይ ፕርደታና ልክያ ቡሮ ጋክቤና” ያግስ።<verse eid="GEN 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17"/>አው ዉልን ሳእ ማ ልንፅ ግን፥ ጮጨ ታማ ጩይነ ታማ ላጮይ በንትድ ሻከትዳ አሹዋ ግዶራ አስ። <verse eid="GEN 15:17"/><verse number="18" style="v" sid="GEN 15:18"/>ሄ ጋላስ ጎዳይ አብራመስ፥ “ግብፀ ሻፋፐ ዶምድ ኤፍራፂሳ ሻፋ ጋካናዉ ደእያ ቢታ ኡባ ታኒ ነ ሼሻስ እማና። <verse eid="GEN 15:18"/><verse number="19" style="v" sid="GEN 15:19"/>ሄ ቢታይ ቄናታ ቢታ፥ ቀነዛታ ቢታ፥ ቃድሞነታ ቢታ፥ <verse eid="GEN 15:19"/><verse number="20" style="v" sid="GEN 15:20"/>ህተታ ቢታ፥ ፓርዘታ ቢታ፥ ራፋይመታ ቢታ፥ <verse eid="GEN 15:20"/><verse number="21" style="v" sid="GEN 15:21"/>አሞረታ ቢታ፥ ካናነታ ቢታ፥ ገርገሰታ ቢታነ ያቡሰታ ቢታ” ያግድ ጫቅስ።<verse eid="GEN 15:21"/></para>
  <chapter eid="GEN 15"/>
  <chapter number="16" style="c" sid="GEN 16"/>
  <para style="s1">አጋሮነ እስማኤላ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1"/>አብራመ ማችያ ሶራ እያዉ ናአ የላቡኩ። ሽን እዉ ግብፀፈ ይዳ አጋሮ ጌተትያ ጋንዶይ ደአዉሱ። <verse eid="GEN 16:1"/><verse number="2" style="v" sid="GEN 16:2"/>ሶራ አብራመኮ፥ “ታኒ ናአ የሎና መላ ጎዳይ ታና የሎ ድግስ። ኔኒ ባዳ ታ አይለራ አቃ፤ ታኒ እ ባጋራ ናአ ደማነኮነ ኦን ኤር” ያጋሱ። አብራመይ እ ቆፋ ኤክስ። <verse eid="GEN 16:2"/><verse number="3" style="v" sid="GEN 16:3"/>አብራመይ ካናነ ቢታን ታሙ ላይ ደእዳፐ ጉየ፥ እያ ማችያ ሶራ ግብፀፈ ይዳ ባ አይልዉ አጋሮ ባ አዝናስ ማቾ ኦዳ እማሱ። <verse eid="GEN 16:3"/><verse number="4" style="v" sid="GEN 16:4"/>አብራመይ አጋሮ ኤክስ፥ እያካ ቃንታሱ። እያ ባዉ ቃንትዳይሳ ኤርዳ ዎደ ባ ጎዳትዉ ካሱ።<verse eid="GEN 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 16:5"/>ሶራ አብራመኮ፥ “ሀ ቆሁዋስ ታና ጋዳይ ነና፤ ታኒ ታ አይልዉ ነዉ እምን፥ እያ ቃንትድይሳ በአዳ ታና ካዉሱ። ነባነ ታባ ጎዳይ ፕርዶ” ያጋሱ።<verse eid="GEN 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6"/>አብራመይ ሶራኮ፥ “ሀኖ በአ ነ አይልዉ እያ ነ ኩሸና፤ ነና ሎእዳባ ኦ” ያግስ። ሄሳፈ ጉየ፥ ሶራ አጋሮ ኡንኤን ያፐ ከያዳ ባቃታሱ።<verse eid="GEN 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7"/>ጎዳ ኪታንቾይ አጋሮ መላ ቢታን፥ ፑልቶ ሃ ማታን ደምስ፤ ሄ ፑልቶይ ሹራ ቢታ ኤፍያ ኦግያ ማታን ደኤስ። <verse eid="GEN 16:7"/><verse number="8" style="v" sid="GEN 16:8"/>ኪታንቾይ አጋሮ፥ “ሶራ አይለተ፥ አጋረ፥ አዉፐ ያዲ? አዉ ባይ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="GEN 16:8">አጋራ ዛራዳ፥ “ታኒ ታ ጎዳተ ሶራፐ ባቃታስ” ያጋሱ።<verse eid="GEN 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9"/>ጎዳ ኪታንቾይ ኢኮ፥ “ነ ጎዳተኮ ስማ ባዳ እዉ ሃረታ” ያግድ ኦድስ። <verse eid="GEN 16:9"/><verse number="10" style="v" sid="GEN 16:10"/>ጉጅድካ ጎዳ ኪታንቾይ ኢኮ፥ “ነ የለተ ኦንካ ታይባናዉ ዳንዳኦናዳ ኦዳ ዳርሳና” ያግስ። <verse eid="GEN 16:10"/><verse number="11" style="v" sid="GEN 16:11"/>ቃስካ ጎዳ ኪታንቾይ እዮ፥</para>
  <para style="b" vid="GEN 16:11"/>
  <para style="q1" vid="GEN 16:11">“ሄኮ ኔኒ ቃንታዳሳ፥</para>
  <para style="q2" vid="GEN 16:11">ኔኒ አደ ናአ የላና።</para>
  <para style="q1" vid="GEN 16:11">ፆሳይ ነ ዋሱዋ ስእዳ ግሾ</para>
  <para style="q2" vid="GEN 16:11">እያ ኔኒ እስማኤላ<note caller="+" style="f"><char style="fr" closed="false">16:11 </char><char style="fq" closed="false">እስማኤላ፦ </char><char style="ft" closed="false">እብራወ ዶናን “ፆሳይ ስኤስ” ጉሱ።</char></note> ጋዳ ሱንና<verse eid="GEN 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 16:12"/>እ ባዞ ሀረ መላ ግዳና፥</para>
  <para style="q2" vid="GEN 16:12">እ ባ ቀስያ አሳ ኡባ ቦላ ደንና፥</para>
  <para style="q2" vid="GEN 16:12">ቃስ አሳ ኡባይካ ባንታ ቀስያ እያ ቦላ ደንና።</para>
  <para style="q1" vid="GEN 16:12">እ ባ እሻታ ኡባራ እፆን ደአና”</para>
  <para style="m" vid="GEN 16:12">ያግስ።<verse eid="GEN 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13"/>አጋራ ባራ ኦደትዳ ጎዳ፥ “ኔኒ ታና በእያ ፆሳ” ያጋዳ ፄጋሱ። “ታኒ ታና በኤይሳ በአስ” ያጋሱ። <verse eid="GEN 16:13"/><verse number="14" style="v" sid="GEN 16:14"/>ሄሳፈ ደንዶይሳን ሄ ፑልቶ ሃይ፥ “ታና በእያ ደኦ ፆሳ ፑልቱዋ” ጌተትድ ፄገትስ። ሄ ሃ ፑልቶይ ቃደሳፐነ ባሬዳፐ ግዶን ደኤስ። <verse eid="GEN 16:14"/><verse number="15" style="v" sid="GEN 16:15"/>አጋራ አብራመስ አደ ናአ የላሱ፤ አብራመይ የለትዳ ናአ እስማኤላ ግድ ሱንስ። <verse eid="GEN 16:15"/><verse number="16" style="v" sid="GEN 16:16"/>አጋራ አብራመስ እስማኤላ የልያ ዎደ አብራመስ ላይ ሆስፑን ታማነ ኡሱፑና።<verse eid="GEN 16:16"/></para>
  <chapter eid="GEN 16"/>
  <chapter number="17" style="c" sid="GEN 17"/>
  <para style="s1">ቃፃሮይ ቃላ ጫቁዋስ ማላ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1"/>አብራመስ ላይ ኡዱፉን ታማነ ኡዱፉና ግድያ ዎደ፥ ጎዳይ እያዉ ቆንጭድ፥ “ታኒ ኡባ ዳንዳእያ ፆሳ፥ ታዉ ኪተታ፥ ታ ስንን ፖሎ ግዳ። <verse eid="GEN 17:1"/><verse number="2" style="v" sid="GEN 17:2"/>ታ ግዶንነ ነ ግዶን ደእያ ጫቁዋ ታ ምንና፤ ታኒ ነ ዘረ ታይባናዉ ዳንዳኤቶናዳ ኦና” ያግስ። <verse eid="GEN 17:2"/><verse number="3" style="v" sid="GEN 17:3"/>አብራመይ ባ ሶምኡዋራ ሳአን ዱገ ጉፋንን ፆሳይ እያኮ፥ <verse eid="GEN 17:3"/><verse number="4" style="v" sid="GEN 17:4"/>“ሄኮ ታ ነዉ ጫቅያ ጫቆይ ሀይሳ፤ ነ ዳሮ ካዎተታስ አዋ ግዳና። <verse eid="GEN 17:4"/><verse number="5" style="v" sid="GEN 17:5"/>ታ ነና ዳሮ ካዎተታስ አዋ ኦና ግሾ ህዛፐ ነ ሱንይ አብራመ<note caller="+" style="f"><char style="fr" closed="false">17:5 </char><char style="fq" closed="false">አብራመ፦ </char><char style="ft" closed="false">እብራወ ዶናን አብራመ ጉሳይ ቦንቸትዳ አዋ ጉሱ።</char></note> ግድ ፄገተና፥ ሽን ነ ሱንይ አብራሃመ<note caller="+" style="f"><char style="fr" closed="false">17:5 </char><char style="fq" closed="false">አብራሃመ፦ </char><char style="ft" closed="false">እብራወ ዶናን አብራሃመ ጉሳይ ዳሮ ደርያስ ዎይኮ ካዎተታስ አዋ ጉሱ።</char></note> ግድ ፄገታና። <verse eid="GEN 17:5"/><verse number="6" style="v" sid="GEN 17:6"/>ታኒ ነ የለተ ዳርሳና፥ ታ ነና ዳሮ ደረ ከሳና፥ ካዎት ኔፐ ከያና። <verse eid="GEN 17:6"/><verse number="7" style="v" sid="GEN 17:7"/>ታኒ ነዉነ ኔፐ ጉየን ነ ሼሻስ ፆሰ ግዳና መላ መርና ጫቁዋ ታ ግዶንነ ነ ግዶን፥ ኔፐ ጉየራ ያ ነ ሼሻ ግዱዋን፥ የለተፈ የለተ ጋካናስ ታ ጫቃስ። <verse eid="GEN 17:7"/><verse number="8" style="v" sid="GEN 17:8"/>ኔኒ ሀእ በተ ግዳዳ ደእያ ካናነ ቢታ ኡባ ነዉነ ኔፐ ጉየራ ያ ነ ሼሻስ መርና ላታ ግዳና መላ ነዉ እማና፤ ቃስ ታኒ ኤንታ ፆሳ ግዳና” ያግስ።<verse eid="GEN 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9"/>ቃስካ ፆሳይ አብራሃመ፥ “ነና ግድኮ ታ ጫቁዋ ናጋ፤ ነካ ኔፐ ጉየራ ያ ነ ሼሻት፥ የለተፈ የለተ ጋካናዉ ናግተ። <verse eid="GEN 17:9"/><verse number="10" style="v" sid="GEN 17:10"/>ታ ግዱዋንነ ነ ግዱዋን፥ ኔፐ ጉየራ ያ ነ ሼሻ ግዶን ህንተ ናጋና ጫቆይ ሀይሳ፤ ህንተ ግዱዋን ደእያ አደ ኡባይ ቃፃረቶ። <verse eid="GEN 17:10"/><verse number="11" style="v" sid="GEN 17:11"/>ህንተ አደተ ኮሁዋ ዶካልተ፤ ሄስ ታ ግዶንነ ህንተ ግዶን ደእያ ጫቁዋስ ማላ ግዳና። <verse eid="GEN 17:11"/><verse number="12" style="v" sid="GEN 17:12"/>ህዛፐ ያና የለተን አደ ናይት ኡባይ የለትዳ ሆስፑን ጋላሳን ቃፃረቶ። ነ ሶን የለትዳይሳታ ግድን፥ ዎይኮ አላጋፐ ሚሸን ሻመትዳ አይለታ ግድን፥ ነ ዘረፈ ግዶናይሳታ ዶካላ። <verse eid="GEN 17:12"/><verse number="13" style="v" sid="GEN 17:13"/>ነ ሶን የለትዳይሳታ ግድን ዎይኮ ሚሸን ሻመትዳይሳት ቃፃረታናዉ በሴስ። ሀይሳን ህንተ አሹዋን ደእያ ታ ጫቆይ መርና ጫቆ ግዳና። <verse eid="GEN 17:13"/><verse number="14" style="v" sid="GEN 17:14"/>ኦንካ ቃፃረቶና ደእያ አደ አስ ኡባይ ታ ጫቁዋ መንዳ ግሾ ባ አሳፐ ዱፆ” ያግስ።<verse eid="GEN 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15"/>ፆሳይ አብራሃመኮ፥ “ህዛፐ ነ ማቸ ሱንይ ሶራ ግድ ፄገቶፎ፤ ሀችፈ ዶምድ እ ሱንይ ሳራ ጌተቶ። <verse eid="GEN 17:15"/><verse number="16" style="v" sid="GEN 17:16"/>ታኒ እዮ አንጃና፤ ታኒ ኢፐ ነዉ አደ ናአ እማና። ታኒ እዮ አንጃና ግሾ እያ ካዎተታስ አዮ ግዳና፤ ደርያ ካዎት ኢፐ ከያና” ያግስ።<verse eid="GEN 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17"/>አብራሃመይ ባ ሶምኡዋራ ሳአን ጉፋንድ፥ “ሀይ አሳዉ፥ ፄቱ ላይ አስ ናአ የላኔ? ኡዱፉን ታሙ ላይ ግድዳ ሳርካ ናአ የላኔ?” ያግድ ባ ዎዛናን ሚጭስ። <verse eid="GEN 17:17"/><verse number="18" style="v" sid="GEN 17:18"/>አብራሃመይ ፆሳኮ፥ “እስማኤል ታና ላታና መላ ነ እያ አንጃርክ” ያግስ።<verse eid="GEN 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19"/>ሽን ፆሳይ፥ “አካይ፥ ነ ማችያ ሳራ ነዉ አደ ናአ የላና፥ ኔኒ እያ ይሳቃ<note caller="+" style="f"><char style="fr" closed="false">17:19 </char><char style="fq" closed="false">ይሳቃ፦ </char><char style="ft" closed="false">ሀ ሱን ብርሸይ “እ ሚጬስ” ጉሱ</char></note> ጋዳ ሱንና። ታኒ እያፐ ጉየራ ያ እያ ዘረስ መርና ጫቆ ግዳና መላ እያራ ታ ጫቁዋ ጫቃና። <verse eid="GEN 17:19"/><verse number="20" style="v" sid="GEN 17:20"/>እስማኤላባ ነ ታና ኦይችዳ ኦይሻ ስአስ። ታኒ እያካ አንጃና። ታ እያ አይፍሳና፥ እያ የለተ ሎይ ዳርሳና። እ ታማነ ናምኡ ሃረይሳታስ አዋ ግዳና። ታኒ እያ ግታ ካዎተ ከሳና። <verse eid="GEN 17:20"/><verse number="21" style="v" sid="GEN 17:21"/>ሽን ታ ጫቁዋ ዎንቶ ላይ ሀኖደ ሳራ ነዉ የልያ ናአ ይሳቃራ ጫቃና” ያግስ። <verse eid="GEN 17:21"/><verse number="22" style="v" sid="GEN 17:22"/>ፆሳይ አብራሃመራ ኦደትድ ኦንግዳፐ ጉየ እያፐ ሻከትድ ፑደ ብስ።<verse eid="GEN 17:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23"/>ሄ ጋላስ አብራሃመይ ባ ናአ እስማኤላ፥ ባ ሶን የለትዳይሳታነ ባ ሚሸን ሻምዳይሳታ፥ ባ ሶን ደእያ አደ አሳ ኡባ ፆሳይ እያ ኪትዳይሳዳ ቃፃርስ <verse eid="GEN 17:23"/><verse number="24" style="v" sid="GEN 17:24"/>አብራሃመይ ቃፃረትያ ዎደ እያዉ ላይ ኡዱፉን ታማነ ኡዱፉና። <verse eid="GEN 17:24"/><verse number="25" style="v" sid="GEN 17:25"/>እያ ናአይ እስማኤል ቃፃረትያ ዎደ ታማነ ሄ ላይ ናአ። <verse eid="GEN 17:25"/><verse number="26" style="v" sid="GEN 17:26"/>አብራሃመይነ እያ ናአ እስማኤል ናምአትካ ሄ ጋላስ ቃፃረትዶሶና። <verse eid="GEN 17:26"/><verse number="27" style="v" sid="GEN 17:27"/>አብራሃመ ሶን ደእያ አደ ኡባይ፥ እያ ሶን የለትዳይሳትነ ሚሸን ሻመትዳይሳት ኡባይ እያራ ቃፃረትዶሶና።<verse eid="GEN 17:27"/></para>
  <chapter eid="GEN 17"/>
  <chapter number="18" style="c" sid="GEN 18"/>
  <para style="s1">ሄ እማታ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1"/>አብራሃመይ ማምረ ግታ ምታ ጋርሳን ባ ዱንካንያ ፐንገን ሴታ ጋላስ ኡትዳሽን ጎዳይ እያዉ ቆንጭስ። <verse eid="GEN 18:1"/><verse number="2" style="v" sid="GEN 18:2"/>አብራሃመይ ቁ ግድ ፄልያ ዎደ እያ ማታን ኤቅዳ ሄ አሳታ በእስ። እ ኤንታ በእድ ኤንታራ ጋሄታናዉ ባ ዱንካንያ ፐንገፈ ደንድድ ኤንታኮ ዎፅ ብድ ኤንታ ስንን ዝግስ። <verse eid="GEN 18:2"/><verse number="3" style="v" sid="GEN 18:3"/>ያን ስሚድ፥ “አቤት ታ ጎዳዉ፥ ታ ነ ስንን ሳባ ደምዳባ ግድኮ ታና ነ አይልያ አጋዳ አፋ። <verse eid="GEN 18:3"/><verse number="4" style="v" sid="GEN 18:4"/>ጉ ሃ ዪኮ ህንተ ቶሆይ ሜጨትኮ ሀ ም ኩያን ሸምፕ ኤክተ። <verse eid="GEN 18:4"/><verse number="5" style="v" sid="GEN 18:5"/>ህንተ ታኮ ህንተ አይልያኮ ይዳ ግሾ ፃልድ ህንተ ብያ በሲ ባና መላ ታኒ ህንተዉ ምያባ ኤሀና” ያግስ።</para>
  <para style="p" vid="GEN 18:5">ኤንትካ፥ “ዳሮ ሎኦ፥ ነ ግዳይሳዳ ኦ” ያግዶሶና።<verse eid="GEN 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6"/>አብራሃመይ ኤለስድ ሳርኮ ዱንካንያ ግዶ ገልድ፥ “ኤለሳዳ ሄ ጋባተ ሎኦ ለ ኤካ ሙኑቃዳ ኡይ ኡካ” ያግስ። <verse eid="GEN 18:6"/><verse number="7" style="v" sid="GEN 18:7"/>አብራሃመይ ቃስ ባ መሄታ ግዶ ዎፅ ብድ ሎኦ ቡልዱቡልዳ ማራ ዶርድ ባ እስ አይልያስ እምን እ ኤለስድ ሹክድ ጊግስስ። <verse eid="GEN 18:7"/><verse number="8" style="v" sid="GEN 18:8"/>ያትድ አብራሃመይ መቃ ማነ ጊግስዳ ማራ አሹዋ እማታ ስን አስ፤ ኤንቲ ምሽን እ ም ጋርሳን ኤንታ ማታን ኤቅስ።<verse eid="GEN 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9"/>ኤንቲ አብራሃመኮ፥ “ነ ማችያ ሳራ አዉኔ?” ያግድ ኦይችዶሶና።</para>
  <para style="p" vid="GEN 18:9">እካ፥ “ህን ዱንካንያ ግዶና” ያግስ።<verse eid="GEN 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10"/>ጎዳይ እያኮ፥ “ዎንቶ ላይ ሀኖደ ቱማ ታ ኔኮ ስማና፤ ነ ማችያ ሳራ አደ ናአ የላና” ያግስ።</para>
  <para style="p" vid="GEN 18:10">ሳራ ሄ ዎደ እያፐ ጉየ ባጋራ ደእያ ዱንካንያ ፐንገን ኤቃዳ ሄሳ ስአዉሱ። <verse eid="GEN 18:10"/><verse number="11" style="v" sid="GEN 18:11"/>አብራሃመይነ ሳር ባንታ ላይን ዳሮ ጭምዶሶና። ሳራ ናአ የልያ ዎደፐ አሱ። <verse eid="GEN 18:11"/><verse number="12" style="v" sid="GEN 18:12"/>ሄሳ ግሾ፥ ሳራ ባ ዎዛናን፥ “ታንነ ታ ጎዳይ ናምአይካ ጭምዳፐ ጉየ ዋንድ ሀ ኡፋይሳይ ሀናኔ?” ያጋዳ ሚጫሱ።<verse eid="GEN 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13"/>ጎዳይ አብራሃመኮ፥ “ ‘ታኒ ጭምዳፐ ጉየ ናአ የላነ’ ጋዳ ሳራ አይስ ሚጫይ? <verse eid="GEN 18:13"/><verse number="14" style="v" sid="GEN 18:14"/>ጎዳስ ዳንዳኤቶናባይ ቱማ ደእዬ? ታ ነዉ ግዳይሳዳ ዎንቶ ላይ ሀኖደ ታ ስማዳ ያና፤ ሄ ዎደ ሳራ አደ ናአ የላና” ያግስ።<verse eid="GEN 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15"/>ሳራ ያሸትዳ ግሾ፥ “ታኒ ሚጫብከ” ጋዳ ላሀሱ።</para>
  <para style="p" vid="GEN 18:15">ሽን እ፥ “ነ ቱማ ሚጫዳሳ” ያግስ።<verse eid="GEN 18:15"/></para>
  <para style="s1">አብራሃመይ ሶዶመስ ጋናትስ</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16"/>አሳት ባናዉ ደንድሸ ሶዶመ ዱገ ፄልዶሶና። አብራሃመይ ኤንታና ሞይዛናዉ ኤንታራ ከይስ። <verse eid="GEN 18:16"/><verse number="17" style="v" sid="GEN 18:17"/>ፆሳይ እያኮ፥ “ታ ኦናዉ ሀንያባ አብራሃመፐ ቆሳነዬ? <verse eid="GEN 18:17"/><verse number="18" style="v" sid="GEN 18:18"/>አብራሃመይ ቱማ ግታነ ዎልቃማ ካዎተ ግዳና። ሀ ቢታ ካዎተት ኡባይ እያን አንጀታና። <verse eid="GEN 18:18"/><verse number="19" style="v" sid="GEN 18:19"/>ፅሎተነ ሱረ ፕርዳ ኦድ ጎዳ ኦግያ ናጋና መላ ባ ናይታነ እያፐ ጉየራ ያ ባ ሶ አሳ ዞራና መላ ታኒ እያ ዶራስ። ሄስካ፥ ፆሳይ አብራሃመስ እማና ግዳ ኡፋይሳ ፖላናሳ” ያግስ።<verse eid="GEN 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20"/>ጎዳይ አብራሃመኮ፥ “ሶዶመ ቦላነ ጋሞራ ቦላ ዋስያ ዋሶይ ዳርስ፤ ኤንታ ናጋራይካ ዳሮ ዴፅስ። <verse eid="GEN 18:20"/><verse number="21" style="v" sid="GEN 18:21"/>ሄሳ ግሾ፥ ኤንታ ኦሶይ ኤንታ ዋሱዋ መለኮ በአናዉ ታኒ ዱገ ዎና፤ ቃስ ሄሳ መላ ኢታ ግዶናኮ ሻካ ኤራና” ያግስ።<verse eid="GEN 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22"/>ሄሳፈ ጉየ፥ ናምኡ አሳት ሶዶመኮ ስሚድ ብዶሶና፥ ሽን አብራሃመይ ጎዳ ስንን ኤቅዳሱዋን ደኤስ። <verse eid="GEN 18:22"/><verse number="23" style="v" sid="GEN 18:23"/>አብራሃመይ ጎዳኮ ሺቅድ፥ “ቱማ ኔኒ ፅሎታ ኢታታራ እስፈ ይሳኔ? <verse eid="GEN 18:23"/><verse number="24" style="v" sid="GEN 18:24"/>ሄ ካታመን እሻታሙ ፅሎ አሳት ደእኮ ነ ይሳኔ? ያን ደእያ እሻታሙ ፅሎ አሳታ ግሾ ሄ ካታማ አሽኪ? <verse eid="GEN 18:24"/><verse number="25" style="v" sid="GEN 18:25"/>ሄሳ መላ ኦሶይ ኔፐ ሃኮ፤ ፅሉዋ ኢታራ ዎል ጋዳ ዎይስ፥ ፅሉዋነ ኢታ እስ አይፍያን ፄለይስ ኔፐ ሃኮ። ሀ ቢታ ኡባ ፕርድያ ኔኒ ፅሎ ፕርድኪ?” ያግስ።<verse eid="GEN 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26"/>ጎዳይ፥ “ታ ሶዶመን እሻታሙ ፅሎታ ደምያኮ ሄ በሳ ኡባ ኤንታ ግሾ ጋዳ አሻና” ያግስ።<verse eid="GEN 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27"/>አብራሃመይ ዛሪድ፥ “ታኒ ቢታነ ብዶ ግዳዳ ታ ጎዳራ ኦደታናዉ ምነታክቻስ፤ <verse eid="GEN 18:27"/><verse number="28" style="v" sid="GEN 18:28"/>እሻታሙ ፅሎታፐ እቻሻት ፓጭኮቺ? ኔኒ ሄ እቻሻታ ግሾ ጋዳ ሄ ካታማ ኡባ ይሳነዬ?” ያግስ።</para>
  <para style="p" vid="GEN 18:28">ጎዳይ፥ “ታኒ ኦይታማነ እቻሹ ፅሎታ ደምኮ ሄ ካታማ ይስከ” ያግስ።<verse eid="GEN 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29"/>አብራሃመይ ዛሪድ፥ “ያን ኦይታሙ ፃላል ደእኮቺ?” ያግስ።</para>
  <para style="p" vid="GEN 18:29">እካ፥ “ኦይታማታ ግሾ ጋዳ ሄ ካታማ ይስከ” ያግስ።<verse eid="GEN 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30"/>ቃስካ አብራሃመይ ዛሪድ፥ “ሀይ ታ ጎዳዉ፥ ታና ሀንቀቶፋ፥ ታኒ ጉጃዳካ ኦደታና። ሀስታሙ ፃላል ደእኮቺ?” ያግስ።</para>
  <para style="p" vid="GEN 18:30">ጎዳይ ዛሪድ፥ “ታኒ ያን ሀስታሙ ደምኮ ይስከ” ያግስ።<verse eid="GEN 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31"/>አብራሃመይ፥ “ታኒ ጎዳራ ኦደታናዉ ምነታክቻስ፤ ኦን ኤር ያን ላታሙ ፃላል ደእኮች” ያግስ።</para>
  <para style="p" vid="GEN 18:31">ጎዳይካ፥ “ሄ ላታማታ ግሾ ጋዳ ይስከ” ያግስ።<verse eid="GEN 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32"/>አብራሃመይ ቃስካ፥ “ሀይ ታ ጎዳዉ፥ ታና ሀንቀቶፋ ታ እስ ቶሆ ኦደታና፥ ያን ታሙ ፃላላ ደምኮቺ?” ያግስ።</para>
  <para style="p" vid="GEN 18:32">እካ፥ “ታማታ ግሾ ጋዳ ታኒ ሄ ካታማ ይስከ” ያግስ።<verse eid="GEN 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33"/>ጎዳይ አብራሃመራ ኦደትድ ኦንግዳፐ ጉየ ብስ፤ አብራሃመይካ ባ ሶ ስምስ።<verse eid="GEN 18:33"/></para>
  <chapter eid="GEN 18"/>
  <chapter number="19" style="c" sid="GEN 19"/>
  <para style="s1">ሶዶመነ ጋሞራ ዩዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1"/>ናምኡ ኪታንቾት ኦማርስሽን ሶዶመ ካታማ ጋክዶሶና። ሄ ዎደ ሎፀይ ሄ ካታማ ፐንገን ኡትስ። ሎፀይ ኤንታ በእድ ሞካናዉ ደንድድ ኤንታኮ ብስ። ባ ሶምኡዋ ሳአ ጋድ ኤንታዉ ዝግስ። <verse eid="GEN 19:1"/><verse number="2" style="v" sid="GEN 19:2"/>እ ኤንታኮ፥ “ታ ጎዳቶ፥ ህንተ አይልያ ሶ ገለርከት፥ ህንተ ቶሁዋ ሜጨትድ ቃማ ሀይሳን አቅተ፤ ዎንታ ጉራ ህንተ ብያ በሲ ቢተ” ያግስ።</para>
  <para style="p" vid="GEN 19:2">ኤንቲ፥ “አካይ፥ ኑኒ ሀ ካታማ ዳባባን አቃና” ያግድ ዛርዶሶና።<verse eid="GEN 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3"/>ሽን እ ኤንታ ምን ዎስዳ ግሾ ብድ እያ ሶ ገልዶሶና። እ ኤንታዉ ኡይ ኡክድ አን ምዶሶና። <verse eid="GEN 19:3"/><verse number="4" style="v" sid="GEN 19:4"/>ኤንቲ ዝንአና ሀንሽን ሶዶመ ካታማ አደ አሳ ኡባይ ናአተነ ዶን እሶይካ አቶና ይድ ኬ ዩይ አዶሶና። <verse eid="GEN 19:4"/><verse number="5" style="v" sid="GEN 19:5"/>ኤንቲ ሎፀ ፄግድ፥ “ሀች ኦማርስ ነ ሶ ገልዳ አደ አሳት አዉን ደኦና? ኑኒ ኤንታራ ጋሄታና መላ ኤንታ ኑኮ ካረ ከሳ” ያግዶሶና። <verse eid="GEN 19:5"/><verse number="6" style="v" sid="GEN 19:6"/>ያትን ሎፀይ ኤንታራ ኦደታናዉ ካረ ከይሸ ፐንግያ ጉየራ ጎርድድ፥ <verse eid="GEN 19:6"/><verse number="7" style="v" sid="GEN 19:7"/>ኤንታኮ፥ “ታ ዳቦቶ፥ ሀያና ሀ ኢታ ኦሱዋ ኦፍተ። <verse eid="GEN 19:7"/><verse number="8" style="v" sid="GEN 19:8"/>ታዉ አደ ኤሮና ናምኡ ጌላኦት ደኦሶና። ታኒ ኤንታ ህንተዉ ካረ ከስኮ ህንተ ኮይዳባ ኦተ። ሽን ሀይሳቲ ታ እማ ግድያ ግሾ ታ ካራፐ ጋርሳን ደኦሶና፤ ሀ አሳታ ቦላ አይብባካ ኦፍተ” ያግስ።<verse eid="GEN 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9"/>አሳት፥ “ኑ ስንፈ ገደ ክቻ” ያግዶሶና። ቃስ፥ “ሀ አደይ ባዉ በተ አስ ሽን፥ ኑ ቦላ ፕርዳናዉ ኮዬስ? ኑኒ ኤንታ ቦላ ኦናዉ ኮይዳ ኢታፐ አድ ነ ቦላ ኦና” ያግዶሶና። ኤንቲ ሎፀ ጉየ ሱግ የግድ ፐንግያ መንናዉ ሺቅዶሶና። <verse eid="GEN 19:9"/><verse number="10" style="v" sid="GEN 19:10"/>ሽን ናምኡ አሳት ባንታ ኩሽያ ካረ የድድ ሎፀ ሶ ጎች ገልስድ ፐንግያ ጎርድዶሶና። <verse eid="GEN 19:10"/><verse number="11" style="v" sid="GEN 19:11"/>ሄሳፈ ጉየ፥ ኤንቲ ኬ ፐንገይ ደእያሱዋ ደሞና መላ ጉፈ ግታ ጋካናዉ ቆቅስዶሶና።<verse eid="GEN 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12"/>ሄ ናምኡ አሳት ሎፀኮ፥ “ነዉ ሀይሳን አደ ናእ ዎይኮ ማጫ ናእ፥ ነ ማጫ ናይታ ኦይችዳይ ዎይኮ ሀራ ዳቦይ ሀ ካታማን ደኢ? ደእኮ ኤንታና ሀይሳፈ ከሳ። <verse eid="GEN 19:12"/><verse number="13" style="v" sid="GEN 19:13"/>አይስ ጊኮ፥ ኑ ሀ ካታማ ይሳናዉ ሀኖስ። ኤንታ ቦላ ዋስያ ዋሶይ ጎዳ ስንን ግታ ግድያ ግሾ ሀ ካታማ ይሳና መላ ጎዳይ ኑና ኪትስ” ያግዶሶና።<verse eid="GEN 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14"/>ያትን ሎፀይ ባ ማጫ ናይታ ኦይችዳይሳታኮ ብድ፥ “ጎዳይ፥ ሀ ካታማ ይሳና ሀንያ ግሾ ኤለስድ ሀ በሳፈ ከይተ” ያግስ። ሽን እያ ማጫ ናይታ ኦይችዳይሳት እ ቀልቅሴስ ግድ ቆፕዶሶና።<verse eid="GEN 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15"/>ሳእ ዎንታናዉ ጎንተይ ዞእያ ዎደ ሄ ኪታንቾት ሎፀኮ፥ “ደንዳ፥ ነ ማችዉነ ሀይሳን ደእያ ነ ናምኡ ናይታ ኤካዳ ኤለሳዳ ከያ። አካይ ጊኮ፥ ሀ ካታማይ ፕርደትያ ዎደ ነካ ያሳ” ያግ ድርግስዶሶና። <verse eid="GEN 19:15"/><verse number="16" style="v" sid="GEN 19:16"/>ሽን ሎፀይ ከያናዉ ጋምእን፥ ጎዳይ እያዉ ቃትዳ ግሾ፥ ሄ ኪታንቾት እያ ኩሽያ፥ እያ ማቸ ኩሽያነ ናምኡ ናይታ ኩሽያ ኦይክድ ሄ ካታማፐ ከስዶሶና። <verse eid="GEN 19:16"/><verse number="17" style="v" sid="GEN 19:17"/>ኪታንቾት ኤንታ ከስዳ መላ ሄ ኪታንቾታፐ እሶይ፥ “ህንተ ሸምፑዋ ኤክድ ባቃትተ! ጉየ ፄሎፍተ! ሀ ሄራን አዉንካ ኤቆፍተ! ህንተ ዮና መላ ዙማኮ ባቃትተ” ያግስ።<verse eid="GEN 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18"/>ሽን ሎፀይ ኤንታኮ፥ “ሀይ ታ ጎዳቶ፥ ያጎፕተ። <verse eid="GEN 19:18"/><verse number="19" style="v" sid="GEN 19:19"/>ታኒ ህንተ አይለይ ህንተ ስንን ሳባ ደምዳ ግሾ ታና አሻናዉ ታዉ ዳሮ ቃትደታ። ሽን ታኒ ዙማኮ ባቃታናዉ ዳንዳእከ፤ ሀ ዮይ ጋክድ ታና ይሳና። <verse eid="GEN 19:19"/><verse number="20" style="v" sid="GEN 19:20"/>ሄኮ፥ ሀይሳን እስ ካታም ደኤስ፤ ያ ዎፅድ ባናዉ ማታነ ጉ ካታማ። ታ ሸምፑዋ አሻናዉ ታ ያ ባቃቶ? እ ዳሮ ጉ ካታማ ግደኔ?” ያግስ።<verse eid="GEN 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21"/>ኪታንቾይ፥ “ሎኦ! ታኒ ነ ዎሳ ኤካስ፤ ሄ ነ ኦድዳ ካታማ ይስከ። <verse eid="GEN 19:21"/><verse number="22" style="v" sid="GEN 19:22"/>ሄ ካታማኮ ኤለሳዳ ባቃታ፤ ነ ያ ጋካናዉ ታ አይብባካ ኦከ” ያግስ። ሄሳ ግሾ፥ ሄ ካታማ ሱንይ ዞኣረ<note caller="+" style="f"><char style="fr" closed="false">19:22 </char><char style="fq" closed="false">ዞኣረ፦ </char><char style="ft" closed="false">ጉሳይ “ጉ” ጉሱ።</char></note> ጌተትስ።<verse eid="GEN 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23"/>ሎፀይ ዞኣረ ጋክያ ዎደ ቡሮ ፃልቀይ ጫረስ። <verse eid="GEN 19:23"/><verse number="24" style="v" sid="GEN 19:24"/>ጎዳይ ሄ ዎደ ሳሎፐ ታማነ ፁግያ ዲነ ሶዶመ ቦላነ ጋሞራ ቦላ ቡክስስ። <verse eid="GEN 19:24"/><verse number="25" style="v" sid="GEN 19:25"/>ሄሳዳ ኦድ ጎዳይ ሄ ካታማታ፥ ሄራ ኡባ፥ ካታማታን ደእያባ ኡባ ሄ ቢታን ደእያ ምነ ማታ ይስስ። <verse eid="GEN 19:25"/><verse number="26" style="v" sid="GEN 19:26"/>ሽን ሎፀ ማችያ ጉየ ስማ ፄላዳ ማፅነ ሹቹ ግዳሱ።<verse eid="GEN 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27"/>ዎንተ ጋላስ ዎንታ ጉራ አብራሃመይ ደንድድ ካሰ እ ጎዳ ስንን ኤቅዳ በሳ ብስ። <verse eid="GEN 19:27"/><verse number="28" style="v" sid="GEN 19:28"/>እ ሶዶመነ ጋሞራ፥ ሄ ሄራን ደእያ ቢታ ኡባ ዱገ ፄልያ ዎደ ፁሳ ታማዳ ጩያይ ቢታፈ ደንደይሳ በእስ።<verse eid="GEN 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 19:29"/>ፆሳይ ሄ ሄራን ደእያ ካታማታ ይስያ ዎደ አብራሃመ ቆፕድ፥ ሎፀይ ደእያ ካታማታ ይስድ፥ ሎፀ ዮፐ አሽስ።<verse eid="GEN 19:29"/></para>
  <para style="s1">ሎፀነ እያ ማጫ ናይታ</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30"/>ሎፀይ ዞኣረን ዳናዉ ያሸትዳ ግሾ፥ ያፐ ደንድድ ባ ማጫ ናይታ ናምአታራ ዙማ ቦላ ከይስ። ያን ጎንጎሎ ግዶን ባ ናምኡ ማጫ ናይታራ ደእስ። <verse eid="GEN 19:30"/><verse number="31" style="v" sid="GEN 19:31"/>እስ ጋላስ ባይራ ናእያ ባ ካሎ ምቸኮ፥ “ኑ አዋይ ጭምስ፥ ቢታ ኡባን ደእያ ዎጋ ኑራ አቃናዉ እስ አደይ ሀይሳን ባዋ። <verse eid="GEN 19:31"/><verse number="32" style="v" sid="GEN 19:32"/>ያንያ ግሾ፥ ሃያ! ኑ አዋ ኡሹ ኡሽድ፥ እያራ አቅድ፥ ኑ አዋፐ ኑስ ኮቸ አሾስ” ያጋሱ።<verse eid="GEN 19:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 19:33"/>ሄ ዎደ ቃማ ባንታ አዋ ኡሹ ኡሽዶሶና። ባይራ ናእያ ገላዳ እያራ አቃሱ። እያ እያራ አቅያ ዎደነ ደንድያ ዎደ እ ኤርቤና።<verse eid="GEN 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34"/>ዎንተ ዎደ ባይርያ ካልዉ፥ “ዝነ ቃማ ታኒ ታ አዋራ አቃስ፤ ሀች ቃማካ እያ ኡሹ ኡሽኮ፥ ነካ ገላዳ እያራ አቃ። ያትድ ኑኒ ኑ አዋፐ ኮቸ አሾስ” ያጋሱ። <verse eid="GEN 19:34"/><verse number="35" style="v" sid="GEN 19:35"/>ሄ ዎደ ቃማ ባንታ አዋ ኡሹ ኡሽዶሶና። ካሎ ናእያ ገላዳ እያራ አቃሱ። ሀእካ እያ እያራ አቅያ ዎደነ ደንድያ ዎደ እ ኤርቤና።<verse eid="GEN 19:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 19:36"/>ያትድ ሎፀ ማጫ ናይት ናምአይ ባንታ አዋፐ ቃንትዶሶና። <verse eid="GEN 19:36"/><verse number="37" style="v" sid="GEN 19:37"/>ባይርያ አደ ናአ የላሱ፤ እያ ሱን ሞአበ<note caller="+" style="f"><char style="fr" closed="false">19:37 </char><char style="fq" closed="false">ሞአበ፦ </char><char style="ft" closed="false">እብራወ ዶናን ሀ ሱን ብርሸይ “ታ አዋፐ” ጉሱ።</char></note> ጋዳ ሱንሱ። እ ሀች ጋካናዉ ሞአበታ ማይዛ። <verse eid="GEN 19:37"/><verse number="38" style="v" sid="GEN 19:38"/>ካልያካ አደ ናአ የላሱ፤ እያ ሱን በንኣማ<note caller="+" style="f"><char style="fr" closed="false">19:38 </char><char style="fq" closed="false">በንኣማ፦ </char><char style="ft" closed="false">ሀ ሱንይ “ታ አሳታ ዎይኮ ታ ዳቦታ ናኣ” ጉሱ።</char></note> ጋዳ ሱንሱ። እ ሀች ጋካናዉ አሞነታ ማይዛ።<verse eid="GEN 19:38"/></para>
  <chapter eid="GEN 19"/>
  <chapter number="20" style="c" sid="GEN 20"/>
  <para style="s1">አብራሃመነ አብመለከ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1"/>አብራሃመይ ማምረፐ ደንድድ ነገበ መላ ቢታ ሄራ ብድ ቃደሳፐነ ሹራ ቢታታስ ግዱዋን ደእስ። ገራራንካ ጉ ዎደ ጋምእስ። <verse eid="GEN 20:1"/><verse number="2" style="v" sid="GEN 20:2"/>ያን ደእሸ አብራሃመይ ባ ማችዉ ሳሮ፥ “እያ ታ ምችዉ” ያግዳ ግሾ፥ ገራራ ካዎይ አብመለከይ ኪትድ ሳሮ ባኮ ኤፍስ። <verse eid="GEN 20:2"/><verse number="3" style="v" sid="GEN 20:3"/>ሽን ፆሳይ እስ ቃማ አሙሆን አብመለከኮ ይድ፥ “ኔኒ ኤህዳ ማጫሰ ጋሶን ሀይቃሳ፥ እያ አዝናራ ደአዉሱ” ያግስ።<verse eid="GEN 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4"/>ሀኖሽን፥ አብመለከይ እዮ ቦችቤና። እ፥ “ጎዳዉ፥ ኔኒ ታናነ ታ ደረይ ቆሆና ደእሽን ጮ ይሳነዬ? <verse eid="GEN 20:4"/><verse number="5" style="v" sid="GEN 20:5"/>እ፥ ‘እያ፥ ታ ምቾ’ ግቤኔ? ቃስ እያካ፥ ‘እ፥ ታ እሻ’ ጋብኬ? ታኒ ታ ዎዛና ፅሎተንነ ታ ኩሸ ጌሻተን ሀይሳ ኦስ” ያግስ።<verse eid="GEN 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6"/>ፆሳይ አሙሆን እያኮ፥ “ኤ፥ ኔኒ ነ ዎዛና ፅሎተን ኦዳይሳ ታ ኤራይስ። ሄሳ ግሾ፥ ኔኒ እዮ ቦቾናዳነ ታ ስንን ናጋራ ኦናዳ ነና ታኒ ተቃስ። <verse eid="GEN 20:6"/><verse number="7" style="v" sid="GEN 20:7"/>ሀእ ሀ አድያ ማችዉ ዛራ። እ ናበ ግድያ ግሾ፥ ነዉ ፆሳ ዎስኮ ነ አታና። ሽን እዮ ዛሮና እፅኮ፥ ኔንነ ነዉ ደእያባ ኡባይ ሀይቃናይሳ ኤራ” ያግስ።<verse eid="GEN 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8"/>አብመለከይ ዎንተ ጋላስ ዳሮ ጉራ ባ ሞርናታ ባኮ ፄግስ። ሄ ሀንዳባ ኡባ ኤንታዉ ኦድን ኤንቲ ዳሮ ባብዶሶና። <verse eid="GEN 20:8"/><verse number="9" style="v" sid="GEN 20:9"/>ያትን አብመለከይ አብራሃመ ፄግድ፥ “ኔኒ አይብባ ኑ ቦላ ኦዲ? ነ ታ ቦላነ ታ ካዎተ ቦላ ሀይሳ መላ ቆሆ ኤሀናዉ ታ ነዉ አይ ኢታባ ኦድና? ኔኒ ታ ቦላ ኦሰታናዉ በሶናባ ኦዳሳ” ያግስ። <verse eid="GEN 20:9"/><verse number="10" style="v" sid="GEN 20:10"/>ቃስ አብመለከይ አብራሃመ፥ “ኔኒ ሀይሳ አይስ ኦዲ?” ያግድ ኦይችስ።<verse eid="GEN 20:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11"/>አብራሃመይ ዛሪድ፥ “ ‘ሀ በሳን ፆሳስ ያሸትያ አስ ባይና ግሾነ ቃስ ታ ማቸ ጋሶን ኤንቲ ታና ዎና’ ጋዳ ቆፕዳ ግሾሳ። <verse eid="GEN 20:11"/><verse number="12" style="v" sid="GEN 20:12"/>ሄሳ ቦላ እያ ቱማካ ታ ምቾ፤ እያ ታ አዋ ናአፐ አትሽን ታ አየ ናአ ግዱኩ፥ ያንያ ግሾ፥ እያ ታ ማቾ ግዳሱ። <verse eid="GEN 20:12"/><verse number="13" style="v" sid="GEN 20:13"/>ፆሳይ ታና ታ አዋ ኬፈ ከስዳ ዎደ ታኒ ኢኮ፥ ‘ኔኒ ብዳ ቢታ ኡባን ነ ታዉ ኦና ኬሀተይ ሀይሳ፤ “እ ታ እሻ” ጋዳ’ ኦዳ ያጋስ” ያግስ።<verse eid="GEN 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14"/>ሄሳፈ ጉየ፥ አብመለከይ ዶርሰ፥ መሄ፥ ማጫ አይለታነ አደ አይለታ ከስድ አብራሃመስ እሚስ፤ እያ ማችዉ ሳሮ እያዉ ዛርስ። <verse eid="GEN 20:14"/><verse number="15" style="v" sid="GEN 20:15"/>አብመለከይ አብራሃመኮ፥ “ሄኮ፥ ታ ቢታይ ሀይስሽ ነና ሎኦሶን ደአ” ያግስ።<verse eid="GEN 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 20:16"/>ሳርኮ፥ “ታኒ ነ እሻስ እስ ሙኩሉ ብራ ሳንትመ<note caller="+" style="f"><char style="fr" closed="false">20:16 </char><char style="fq" closed="false">እስ ሙኩሉ ብራ ሳንትመ፦ </char><char style="ft" closed="false">ሄስ ታማነ እስን ክሎ ግራመ ዴፅያ ዋላህ ባይና ብራ።</char></note> እማይስ። ሄስ ኔራ ደእያ ኡባ ስንን ኔኒ ፅሎ ግደይሳነ አይብ ኢታባካ ኦናይሳ ኤርሰይሳ ግዶ” ያግስ። <verse eid="GEN 20:16"/><verse number="17-18" style="v" sid="GEN 20:17-18"/>ጎዳይ አብራሃመ ማቸ ሳር ጋሶን አብመለከ ኬ ኡባ ማይንስዳ ግሾ አብራሃመይ ፆሳ ዎስን፥ አብመለከይ፥ እያ ማችያነ እያ ማጫ አይለት ናአ የላና መላ ፆሳይ ኤንታ ፓስ።<verse eid="GEN 20:17-18"/></para>
  <chapter eid="GEN 20"/>
  <chapter number="21" style="c" sid="GEN 21"/>
  <para style="s1">ይሳቃ የለተ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1"/>ጎዳይ ባ ኦድዳይሳዳ ሳሮ አንጅስ፤ ባ ገልዳ ቃላካ ፖልስ። <verse eid="GEN 21:1"/><verse number="2" style="v" sid="GEN 21:2"/>ሳራ ቃንታዳ ፆሳይ ግዳ ዎደይ ጋክን ጭምዳ አብራሃመስ አደ ናአ የላሱ። <verse eid="GEN 21:2"/><verse number="3" style="v" sid="GEN 21:3"/>አብራሃመይ ሳራ የልዳ ናአ ሱን ይሳቃ ግድ ሱንስ። <verse eid="GEN 21:3"/><verse number="4" style="v" sid="GEN 21:4"/>አብራሃመይ ባ ናአ ይሳቃ ፆሳይ ኪትዳይሳዳ የለትዳ ሆስፑን ጋላሳን ቃፃርስ። <verse eid="GEN 21:4"/><verse number="5" style="v" sid="GEN 21:5"/>እያ ናአ ይሳቅ የለትያ ዎደ፥ አብራሃመስ ላይ ፄታ። <verse eid="GEN 21:5"/><verse number="6" style="v" sid="GEN 21:6"/>ሳራ፥ “ፆሳይ ታዉ ሚቸ እሚስ፤ ቃስ ሀይሳ ስእያ ኡባይ ታራ ሚጫና” ያጋሱ። <verse eid="GEN 21:6"/><verse number="7" style="v" sid="GEN 21:7"/>ቃስካ ሳራ፥ “ሳራ አብራሃመስ ናአ የላዳ ንና ግዳይ ኦኔ? ግድኮካ ታኒ ሀእ እያዉ እ ጭምዳ ዎደ ናአ የላስ” ያጋሱ።<note caller="+" style="f"><char style="fr" closed="false">21:7 </char><char style="fq" closed="false">ሚቸ፦ </char><char style="ft" closed="false">“ይሳቃ” ጉሳይ “እ ሚጬስ” ጉሱ።</char></note><verse eid="GEN 21:7"/></para>
  <para style="s1">እስማኤላነ አጋር ጎደተ</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8"/>ጉ ናአይ ድጭድ፤ ን ዱስ፤ አብራሃመይ ይሳቅ ን ዱዳ ጋላስ ዎልቃማ ግብራ ጊግስስ። <verse eid="GEN 21:8"/><verse number="9" style="v" sid="GEN 21:9"/>ሽን ግብፀፈ ይዳ አጋራ አብራሃመስ የልዳ ናአይ ይሳቃ ቶችሽን ሳራ በአሱ። <verse eid="GEN 21:9"/><verse number="10" style="v" sid="GEN 21:10"/>ሳራ አብራሃመኮ፥ “ሀ አይለ ናአይ ታ ናአ ይሳቃራ ኡባካ ላቶና ግሾ፥ ጋንድዉነ እ ናኣ ከሳዳ ጎዳ” ያጋሱ።<verse eid="GEN 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 21:11"/>ሄ ኦዳይ ባ ናአ ቦችያ ግሾ፥ አብራሃመይ ዳሮ መቶትስ። <verse eid="GEN 21:11"/><verse number="12" style="v" sid="GEN 21:12"/>ሽን ፆሳይ አብራሃመ፥ “ነ ኮቻይ ይሳቃ ባጋራ ፄገታና ግሾ ነ ናኣስነ ነ አይሌስ ዳሮ መቶቶፓ፤ ሳራ ነዉ ኦድያባ ኡባ ስአ። <verse eid="GEN 21:12"/><verse number="13" style="v" sid="GEN 21:13"/>ቃስ እካ ነ ኮቸ ግድያ ግሾ አይለ ናአ ታኒ ግታ ደረ ኦና” ያግስ።<verse eid="GEN 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14"/>ዎንታ ጉራ አብራሃመይ ደንድድ ጉ ካነ ኮዳን ሃ ኩንድ፥ አጋሮ ቶስድ፥ እ ናአ እዮ እድንድ ከስ ጎድስ። እያ ባዳ፥ በርሳበ መላ ቢታን ዳቡራሱ። <verse eid="GEN 21:14"/><verse number="15-16" style="v" sid="GEN 21:15-16"/>ሃይ ኮዳፈ ዉርዳ ዎደ እያ፥ “ናአይ ሀይቅሽን፥ ኡታዳ በእከ” ጋዳ፥ ናአ እስ ቡረ ጋርሳን የጋዳ፥ ናምኡ ፄቱ ዋ ግደይሳ መላ ባዳ ኡታ አጋሱ። ያን ኡታዳ፥ ባ ቃላ ቁ ኦዳ ዬካሱ።<verse eid="GEN 21:15-16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17"/>ፆሳይ ናአ ዋሱዋ ስእስ። ፆሳ ኪታንቾይ አጋሮ ሳሎፐ ፄግድ፥ “አጋረ፥ ዋናዲ? ፆሳይ ናአ ዬሁዋ ስእዳ ግሾ ባቦፋ፤ <verse eid="GEN 21:17"/><verse number="18" style="v" sid="GEN 21:18"/>ዳንዳ ኤቃዳ፥ ናአ ደንዳ ነ ኩሽያን ኦይካ፤ ታኒ እያ ግታ ደረ ኦና” ያግስ። <verse eid="GEN 21:18"/><verse number="19" style="v" sid="GEN 21:19"/>ፆሳይ እዮ ሃ ኦላ በስን፥ ባዳ ኮዳን ሃ ኩንዳ ናኣ ኡሻሱ። <verse eid="GEN 21:19"/><verse number="20" style="v" sid="GEN 21:20"/>ናአይ ድጭያ ዎደ ኡባን ፆሳይ እያራ ግድስ። እ መላ ቢታን ደእድ፥ ዶንገን ዱክያ አሰ ግድስ። <verse eid="GEN 21:20"/><verse number="21" style="v" sid="GEN 21:21"/>እ ፓራና መላ ቢታን ደእሽን፥ እያ አይያ ግብፀፈ እያዉ ማቾ እማሱ።<verse eid="GEN 21:21"/></para>
  <para style="s1">ሳሮተ ጫቆ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22"/>ሄ ዎደ፥ አብመለከይ፥ ባ ቶራ ሞጮና ፍኮላራ አብራሃመኮ ብድ፥ “ኔኒ ኦያባ ኡባን ፆሳይ ኔራ ደኤስ። <verse eid="GEN 21:22"/><verse number="23" style="v" sid="GEN 21:23"/>ኔኒ ታ ቦላ ዎይኮ ታ ናይታ ቦላ ዎይኮ ታ ዘረ ቦላ ጭማዳ ገነ ኦና መላ፥ ሀእ ሀይሳን፥ ፆሳ ስንን ታዉ ጫቃ። ታኒ ነዉ ኬህዳይሳዳ፥ ኔንካ ታስነ ኔኒ በተተን ደእዳ ሀ ቢቴስ ኬሀ” ያግስ።<verse eid="GEN 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24"/>አብራሃመይ፥ “ታኒ ጫቃይስ” ያግስ።<verse eid="GEN 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25"/>ሄ ዎደ፥ አብራሃመይ፥ አብመለከ አይለት ኤክዳ ሃ ኦላባ አብመለከስ ማጋንስ። <verse eid="GEN 21:25"/><verse number="26" style="v" sid="GEN 21:26"/>ሽን አብመለከይ፥ “ሄሳ ኦን ኦዳኮ ታኒ ኤርከ። ኔንካ ቃስ ታዉ ኦዳባካ፤ ታኒ ሀች ጋካናዉ ሄሳ ስአብከ” ያግስ።<verse eid="GEN 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27"/>ሄሳፈ ጉየ፥ አብራሃመይ ዶርሳታነ ሚዛታ ኤህድ፥ አብመለከስ እምን፥ ኤንቲ ናምአይ ጫቅዶሶና። <verse eid="GEN 21:27"/><verse number="28" style="v" sid="GEN 21:28"/>አብራሃመይ ላፑን ኡዞ ዶርሳታ ዉድያፐ ሻክስ፤ <verse eid="GEN 21:28"/><verse number="29" style="v" sid="GEN 21:29"/>አብመለከይ አብራሃመ፥ “ሀ ኔኒ ዱማ ሻካ ዎዳ ላፑን ኡዞ ዶርሳታ አይስ ሻካዲ?” ያግድ ኦይችስ።<verse eid="GEN 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30"/>አብራሃመይ፥ “ታኒ ሀ ሃ ኦላ ቦክዳይሳስ ማርካ ግዳና መላ፥ ሀ ላፑን ኡዞ ዶርሳታ ታፐ ኤካ” ያግስ።<verse eid="GEN 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 21:31"/>ሄሳን ሄ ናምኡ አሳት ጫቅዳ ግሾ፥ ሄ በሳይ ባርሳበ (ጫቆ ሃ ኦላ ዎይኮ ላፑን ሃ ኦላ)።<verse eid="GEN 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 21:32"/>በርሳበን ጫቁዋ ጫቅዳፐ ጉየ፥ አብመለከይነ እያ ቶራ ሞጮናይ ፍኮል ደንድድ፥ ፍልስፄመ ቢታ ስምዶሶና። <verse eid="GEN 21:32"/><verse number="33" style="v" sid="GEN 21:33"/>አብራሃመይ ባርሳበን ታማርሲክ ጌተትያ ም ቶክስ። ሄሳን ጎዳ፥ መርና ፆሳ ፄግድ እያዉ ጎይንስ። <verse eid="GEN 21:33"/><verse number="34" style="v" sid="GEN 21:34"/>አብራሃመይ ፍልስፄመ ቢታን ዳሮ ዎደ ደእስ።<verse eid="GEN 21:34"/></para>
  <chapter eid="GEN 21"/>
  <chapter number="22" style="c" sid="GEN 22"/>
  <para style="s1">አብራሃመ ፓጨተ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1"/>ሄሳፈ ጉየ፥ ፆሳይ አብራሃመ ፓጭስ፤ እ እያ፥ “አብራሃመ” ያግድ ፄግስ።</para>
  <para style="p" vid="GEN 22:1">እ፥ “ዬ” ግድ ኮይስ።<verse eid="GEN 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2"/>ፆሳይ፥ “ኔኒ ዶስያ ነ እስ ናአ ይሳቃ ኤካዳ፥ ሞርያ ቢታ ባ። ያን ታኒ ነና በሲያ እስ ደረ ቦላ እያ ፁሳ ያርሾ ኦዳ ታዉ ያርሻ” ያግስ።<verse eid="GEN 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3"/>ዎንተ ጋላስ አብራሃመይ ጉራ ደንድድ፥ ባ ሀርያ ጫንስ። ባ አይለታፐ ናምአታነ ባ ናአ ይሳቃ ባራ ኤክድ፥ ፁሳ ያርሹዋስ ግድያ ም ቀር ኤክድ፥ ፆሲ እያ በሲያ በሲ ባናዉ ደንድስ። <verse eid="GEN 22:3"/><verse number="4" style="v" sid="GEN 22:4"/>ሄን ጋላስ አብራሃመይ ቁ ግድ፥ ሄ በሳ ሃሆራ በእስ። <verse eid="GEN 22:4"/><verse number="5" style="v" sid="GEN 22:5"/>አብራሃመይ ባ አይለታ፥ “ህንተ ሀርያራ ሀይሳን ደእሽተ። ታራ ታ ናኣራ ያ ብድ ፆሰ ጎይንድ፥ ህንተኮ ስማና” ያግስ።<verse eid="GEN 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6"/>አብራሃመይ ያርሹዋ ም ደንድ፥ ባ ናአ ይሳቃ ቶስስ። እ ባዉ ታማነ ማሸ ኦይክስ። ኤንቲ ናምአይ እስፈ ብሽን፤ <verse eid="GEN 22:6"/><verse number="7" style="v" sid="GEN 22:7"/>ይሳቅ ባ አዋ አብራሃመ፥ “ታ አዋዉ” ያግስ።</para>
  <para style="p" vid="GEN 22:7">አብራሃመይ፥ “ዬ፥ ታ ናአዉ” ያግስ።</para>
  <para style="p" vid="GEN 22:7">ይሳቅ፥ “ታማይነ ምይ ሀይስሽ፤ ሽን ፁሳ ያርሾ ኡርገ ዶርሳይ አዉኔ?” ያግስ።<verse eid="GEN 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8"/>ያትን አብራሃመይ፥ “ታ ናአዉ፥ ፁሳ ያርሾ ኡርገ ዶርሳ ፆሳይ ባዉ እማና” ያግስ። ያግን ኤንቲ ናምአይ እስፈ ብዶሶና።<verse eid="GEN 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9"/>ኤንቲ ፆሳይ እያዉ ኦድዳ በሳ ጋክዳ ዎደ፥ አብራሃመይ ያን ያርሾ በሲ ጊግስድ፥ ም ሂፅስ። ባ ናአ ይሳቃ ቃችድ፥ ሄ ም ቦላ ዝንእስስ። <verse eid="GEN 22:9"/><verse number="10" style="v" sid="GEN 22:10"/>አብራሃመይ ባ ናአ ሹካናዉ ባ ኩሽያ የድድ ማሸ ኤክስ። <verse eid="GEN 22:10"/><verse number="11" style="v" sid="GEN 22:11"/>ሽን ጎዳ ኪታንቾይ ሳሎፐ፥ “አብራሃመ፥ አብራሃመ” ያግድ ፄግስ። እ፥ “ዬ” ያግድ ኮይስ።<verse eid="GEN 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12"/>ኪታንቾይ፥ “ናአ ቦላ ነ ኩሽያ ዎፋ፤ እያ አይብባካ ኦፋ። ኔኒ ነ እስ ናኣ ታና ድጎና ግሾ፥ ኔኒ ፆሳስ ያየይሳ ታኒ ኤራይስ” ያግስ።<verse eid="GEN 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13"/>አብራሃመይ ቁ ግድ ፄልስ፤ ሄኮ ካጨይ ቱራን ቃፀትዳ እስ ዶርስ ደኤይሳ በእስ። አብራሃመይ ብድ ሄ ዶርሳ ኤክድ፥ ባ ናአ በሳን ፁሳ ያርሾ ኦድ ያርሽስ። <verse eid="GEN 22:13"/><verse number="14" style="v" sid="GEN 22:14"/>ሄሳ ግሾ፥ አብራሃመይ፥ “ጎዳይ እማና” ግድ ሄ በሳ ሱንስ። ሀች ጋካናስ ሄስ፥ “ጎዳ ዙማ ቦላ እመታና” ጌተቴስ።<verse eid="GEN 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15"/>ጎዳ ኪታንቾይ ሳሉዋፐ ናምአን አብራሃመ ፄግድ፥ <verse eid="GEN 22:15"/><verse number="16" style="v" sid="GEN 22:16"/>“ታኒ ጎዳይ፥ ሀይሳዳ ጋዳ ታኒ ታ ሁጰን ነዉ ጫቃይስ፤ ኔኒ ሀይሳ ኦዳ ግሾነ ነ እስ ናኣ ታና ድጎና ግሾ፥ <verse eid="GEN 22:16"/><verse number="17" style="v" sid="GEN 22:17"/>ታኒ ነና ቱማ አንጃና። ነ ዘረ ታኒ ሳሎ ፆልንቶ መላነ አባ ጋፃን ደእያ ሻፈ መላ ኦና። ነ ዘረት ባንታ ሞርከታ ካታማታ ላታና። <verse eid="GEN 22:17"/><verse number="18" style="v" sid="GEN 22:18"/>ኔኒ ታዉ ኪተትዳ ግሾ፥ ሀ ሳአ ካዎተት ኡባይ ነ ዘረ ባጋራ አንጀታና” ያግስ።<verse eid="GEN 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19"/>ሄሳፈ ጉየ፥ አብራሃመይ ባ አይለታኮ ጉየ ስምን፥ ኤንቲ ኡባይ እስፈ ደንድድ ባርሳበ ብዶሶና። አብራሃመይ ባርሳበን ደእስ።<verse eid="GEN 22:19"/></para>
  <para style="s1">ናኮራነ እያ ናይታ</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20"/>ሄሳፈ ጉየ፥ አብራሃመስ፥ “ምልካ ነ እሻ ናኮራስ ናይታ የላሱ፤ <verse eid="GEN 22:20"/><verse number="21" style="v" sid="GEN 22:21"/>ኤንትካ ባይራይ ኡፃ፤ ኡፃ እሻት ቡዛ፥ <verse eid="GEN 22:21"/><verse number="22" style="v" sid="GEN 22:22"/>አራመ አዋ ቃሜላ፥ ከሳዳ፥ ሃዞ፥ ፕልዳሻ፥ ይድላፋነ ባቱኤላ ጌተቶሶና” ያግስ።<verse eid="GEN 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 22:23"/>ሀ ሆስፑን ናይታ ምልካ አብራሃመ እሻ ናኮራስ የላሱ። ባቱኤል እርብቃ የልስ። <verse eid="GEN 22:23"/><verse number="24" style="v" sid="GEN 22:24"/>ረኡማ ጌተትያ እያ ናምአን ማጫስያ ቃስ ፀባ፥ ጋሃማ፥ ታሀሳነ ማካ የላሱ።<verse eid="GEN 22:24"/></para>
  <chapter eid="GEN 22"/>
  <chapter number="23" style="c" sid="GEN 23"/>
  <para style="s1">ሳር ሀይቁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1"/>ሳራ ፄታነ ላታማነ ላፑን ላይ ደአሱ። <verse eid="GEN 23:1"/><verse number="2" style="v" sid="GEN 23:2"/>ሄሳፈ ጉየ፥ እያ ካናነ ቢታን ደእያ ቅርያት-አርባ (ከብሮና) ካታማን ሀይቃሱ። አብራሃመይ ሳርስ ዬክስነ ካዮትስ።<verse eid="GEN 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3"/>ዬክ ስሚድ፥ አብራሃመይ ባ ማቸ አሀ ማታፐ ደንድድ ብድ፥ ህተታ ሀይሳዳ ያግስ፤ <verse eid="GEN 23:3"/><verse number="4" style="v" sid="GEN 23:4"/>“ታኒ ህንተ ግዶን እማ፤ ታ ማቸ አሀ ሞጋናዉ ታዉ ህንተ ጋድያፐ ዱፎ በሲ ባይዘርከት” ያግስ።<verse eid="GEN 23:4"/></para>
  <para style="p">
    <verse number="5-6" style="v" sid="GEN 23:5-6"/>ህተት አብራሃመ፥ “ጎዳዉ፥ ኑኒ ኦደይሳ ስአ፤ ኔኒ ኑ ግዶን ዎልቃማ ሀላቃ፤ ኔኒ ነ ማቸ አሀ ኑ ዱፉዋፐ ነና ሎእዳሶን ሞጋ፤ ኔኒ ነ ማቸ አሀ ሞጋናዉ ባ ዱፉዋ ኦንካ ነና ድገና” ያግ ዛርዶሶና።<verse eid="GEN 23:5-6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7"/>አብራሃመይ ደንድ ኤቅድ፥ ህተታ ስንን ዝግስ። <verse eid="GEN 23:7"/><verse number="8-9" style="v" sid="GEN 23:8-9"/>እ ኤንታኮ፥ “ህንተ ታና፥ ‘ነ ማቸ አሀ ሞጋ’ ጊኮ፥ ታኒ ግያባ ስእተ። ዞሃራ ናአ ኤፍሮናስ እያ ጋድያ ጋፃን ደእያ ማክፌላ ጌተትያ ጎንጎሉዋ ታ ዱፎ ኦናዉ ባይዛና መላ ኩመ ጋተን ኑና ዛልእሰርከት” ያግስ።<verse eid="GEN 23:8-9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10"/>ህተ አድያ ኤፍሮን ሄ ዎደ ካታማ ፐንገን ሺቅዳ ባ አሳ ግዶን ኡትስ። ህተት ኡባይ ስእሽን፥ አብራሃመኮ ያግስ፤ <verse eid="GEN 23:10"/><verse number="11" style="v" sid="GEN 23:11"/>“ሄሳዳ ግደና፤ ታ ጎዳዉ፥ ታ ኦደይሳ ስአ፤ ታኒ ጋድያካ እያ ግዶን ደእያ ጎንጎሉዋካ ነዉ እማይስ፤ ታኒ ነዉ እያ ታ አሳ ስንን እማይስ፤ ኔኒ ነ ማቸ አሀ ሞጋ” ያግስ።<verse eid="GEN 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12"/>አብራሃመይ ሄ ቢታ አሳ ስንን ዛር ዝግድ፥ <verse eid="GEN 23:12"/><verse number="13" style="v" sid="GEN 23:13"/>አሳይ ስእሽን ኤፍሮና፥ “ታ ኦደይሳ ስአርክ! ታኒ ሄ ጋድያ ጋተ ቃንፃና፤ ኔኒ ታፐ ኤካርክ። ሄሳን ታኒ ታ ማቸ አሀ ሞጋና” ያግስ።<verse eid="GEN 23:13"/></para>
  <para style="p">
    <verse number="14-15" style="v" sid="GEN 23:14-15"/>ኤፍሮን አብራሃመኮ ዛሪድ፥ “ታ ጎዳዉ፥ ታኒ ኦደይሳ ስአ፤ ጋደይ ኦይዱ ፄቱ ብራ ሳንትመ<note caller="+" style="f"><char style="fr" closed="false">23:14-15 </char><char style="fq" closed="false">ኦይዱ ፄቱ ብራ ሳንትመ፦ </char><char style="ft" closed="false">ሀይስ ኦይዱ ክሎ ግራመነ ባጋ ዴፅያ ዋላህ ባይና ብራ።</char></note> ከሳና፤ ሽን ሄስ ነ ግዶንነ ታ ግዶን አይብካ ግደና፤ ነ ማቸ አሀ ሞጋ” ያግስ። <verse eid="GEN 23:14-15"/><verse number="16" style="v" sid="GEN 23:16"/>አብራሃመይ ህተት ስእሽን፥ ኤፍሮን ግዳ ጋትያ ኤክስ፤ ሄ ዎደ ሚሸን ኦይዱ ፄቱ ብራ ሳንትመ ኤፍሮናስ እሚስ።<verse eid="GEN 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17"/>ያት ስሚድ፥ ማምረ ካታማ ማታን ማክፌላን ደእያ ኤፍሮና ጋደይ፥ ያን ደእያ ጎንጎሎይነ ሄ ጋድያን ደእያ ም ኡባይ፥ <verse eid="GEN 23:17"/><verse number="18" style="v" sid="GEN 23:18"/>ካታማ ፐንገን ሺቅዳ ህተታ ኡባ ስንን ዎጋ አብራሃመ ጋደ ግድስ።<verse eid="GEN 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 23:19"/>ሄሳፈ ጉየ፥ አብራሃመይ ባ ማችዉ ሳራ ካናነ ቢታን (ከብሮና) ጌተትያ ማምረ ካታማ ማታን ደእያ ማክፌላ ጌተትያ ጋደ ጎንጎሉዋን ሞግስ። <verse eid="GEN 23:19"/><verse number="20" style="v" sid="GEN 23:20"/>ሄሳ ግሾ፥ ሄ ጋደይነ ያን ደእያ ጎንጎሎይ ህተታ ስንን ህግያን አብራሃመስ ዱፎ ግድስ።<verse eid="GEN 23:20"/></para>
  <chapter eid="GEN 23"/>
  <chapter number="24" style="c" sid="GEN 24"/>
  <para style="s1">ይሳቅ ማቾ ኤኩዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1"/>አብራሃመይ ዳሮ ጭምስ። ጎዳይ እያ ኡባባንካ አንጅስ። <verse eid="GEN 24:1"/><verse number="2" style="v" sid="GEN 24:2"/>አብራሃመይ ባ አይልያ፥ ባ ሶ አሳ ኡባስ ሀላቃትያ፥ ባ አቆ ኡባ ቦላ ሱንትዳይሳ ሀይሳዳ ያግስ፥ “ነ ኩሽያን ታ ጉልባታ ኦይካ፤ <verse eid="GEN 24:2"/><verse number="3" style="v" sid="GEN 24:3"/>ታኒ ኤንታ ግዶን ደእዳ ካናነታ ማጫ ናይታፐ ታ ናኣስ ማቾ ኦይቾና መላ፥ ጎዳን፥ ሳሎነ ሳአ ፆሳ ሱንን ታኒ ነና ጫቅሳይስ፤ <verse eid="GEN 24:3"/><verse number="4" style="v" sid="GEN 24:4"/>ሽን ኔኒ ታ የለትዳ ቢታ፥ ታ ዳቦታኮ ባዳ፥ ታ ናአ ይሳቃስ ማቾ ኦይቻ” ያግስ።<verse eid="GEN 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5"/>እያ አይለይ፥ “ሄ ማጫስያ ታራ ያናዉ ዶሶና እፅኮ፥ ነ ናአ ኔኒ ይዳ ቢታ ጉየ ኤፎ?” ያግድ ኦይችስ።<verse eid="GEN 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6"/>አብራሃመይ፥ “ታ ናአ አይ ጋሶንካ ያ ኤፎናዳ ነና ኤራ! <verse eid="GEN 24:6"/><verse number="7" style="v" sid="GEN 24:7"/>ጎዳይ፥ ሳሉዋ ፆሳይ፥ ታና ታ አዋ ሶፐነ ታ የለትዳ ቢታፈ ከስዳይስ ታዉ፥ ‘ነ ዘረስ ታኒ ሀ ቢታ እማና’ ያግድ ጫቅዳይስ፥ ኔኒ ታ ናኣስ ያፐ ማቾ ደማና መላ፥ እ ባ ኪታንቹዋ ኔፐ ስን ኪታና። <verse eid="GEN 24:7"/><verse number="8" style="v" sid="GEN 24:8"/>ሄ ማጫስያ ኔራ ያናዉ ዶሶና እፅኮ፥ ሀ ታኒ ነና ጫቅስዳ ጫቆይ ነዉ ጎመ ግደና፤ ሽን ታ ናአ ያ ኡባካ ኤፎፓ” ያግስ። <verse eid="GEN 24:8"/><verse number="9" style="v" sid="GEN 24:9"/>አይለይ ባ ጎዳ አብራሃመ ጉልባታ ኦይክስ፤ ሄ ኦዳስ ጫቅስ።<verse eid="GEN 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10"/>ሄሳፈ ጉየ፥ አይለይ ባ ጎዳ ግማለታፐ ታማ ኤክድ፥ ባ ጎዳ ሚሽያፐካ ሙሩታ ሙሩታ ኤክ ብድ ማሰጰፆመ ቢታን ናኮራ ካታማ ጋክስ። <verse eid="GEN 24:10"/><verse number="11" style="v" sid="GEN 24:11"/>ኦማርስ፥ ማጫስ ሃ ትካናዉ ያ ዎደ፥ ካታማፐ ጋፃን ሃ ኦላ ማታን ባ ግማለታ ጉልባትስስ።<verse eid="GEN 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 24:12"/>እ ዎስሸ፥ “ጎዳዉ፥ ታ ጎዳ አብራሃመ ፆሳዉ፥ ሀች ታኒ ቆፓዳ ይዳይሳ ታዉ ጊግሳ፤ ቃስ ታ ጎዳ አብራሃመስ ኬሀባ ኦ። <verse eid="GEN 24:12"/><verse number="13" style="v" sid="GEN 24:13"/>ሄኮ፥ ታኒ ሀ ሃ ፑልቱዋ ማታን ኤቃይስ፤ ሀ ካታማ ማጫ ናይት ሃ ትካናዉ ሃ ዮሶና። <verse eid="GEN 24:13"/><verse number="14" style="v" sid="GEN 24:14"/>ታኒ፥ ‘አነ ኦቱዋ ዝቅ ኦዳ ታና ሃ ኡሻ’ ግያ ዎደ፥ እያ፥ ‘ሄኮ ኡያ፤ ቃስ ነ ግማለታ ታኒ ኡሻና’ ግያራ፥ ህና ነ አይልያ ይሳቃስ ኔኒ ዶርዳሮ ግዶ፤ ኔኒ ታ ጎዳስ ኬሀባ ኦዳይሳ ታኒ ሄሳን ኤራና” ያግስ።<verse eid="GEN 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15"/>ቡሮ እ ዎሳ ዛሮና ደእሽን፥ እርብቃ ሃ ኦቶ ቶካዳ ፑቱ ጋሱ። እያ ባቱኤላ ናአ፥ ባቱኤል ምልካ ናአ፥ ምልካ አብራሃመ እሻ ናኮራ ማችዉ። <verse eid="GEN 24:15"/><verse number="16" style="v" sid="GEN 24:16"/>እርብቂ ዳሮ የገልስን አደ ኤሮና ጌላኦ። ፑልቱዋ ዱገ ዎዳ፥ ባ ኦቱዋ ኩንዳ ባናዉ ደንዳሱ። <verse eid="GEN 24:16"/><verse number="17" style="v" sid="GEN 24:17"/>ያንን፥ ሄ አይለይ ኢኮ ዎፅ ብድ እዮ፥ “ነ ታና ጉ ሃ ኡሻርክ” ያግስ።<verse eid="GEN 24:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18"/>እያ፥ “ኤሮ ታ ጎዳዉ፥ ኡያ” ያጋሱ። ኤለሳዳ ኦቱዋ ባ ሀሸፐ ዎዳ፥ ገድ ኦ ኦይካዳ እያ ኡሻሱ። <verse eid="GEN 24:18"/><verse number="19" style="v" sid="GEN 24:19"/>እያ ኡሽዳፐ ጉየ፥ “ነ ግማለትካ አላና ጋካናዉ ታኒ ኤንታዉ ሃ ዱቃና” ያጋሱ። <verse eid="GEN 24:19"/><verse number="20" style="v" sid="GEN 24:20"/>አትዳ ሃ ኤለሳዳ ጎንጌን ትጋዳ፥ ሀራ ሃ ዱቃናዉ ኦላ ዎፃሱ፤ ግማለት ኡባይ አላና ጋካናስ፥ ሃ ኦላፈ ዱቃ ዱቃ ኤሀዳ ጎንገን ትጋዳ ኡሻሱ። <verse eid="GEN 24:20"/><verse number="21" style="v" sid="GEN 24:21"/>እ ቆፕድ ይዳ ቆፋ ጎዳይ እንጀይሸ ደእያኮነ ኤራናዉ አደይ ስእ ግድ እዮ ፄሌስ።<verse eid="GEN 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22"/>ግማለት ሃ ኡይ ስምን፥ አደይ እቻሹ ግራመ ባጋ ሲን አያ ዎርቃ ፄታነ ታሙ ግራመ ግድያ ናምኡ ዎርቃ ሳጋዮታ ጊግስስ። <verse eid="GEN 24:22"/><verse number="23" style="v" sid="GEN 24:23"/>እዮ፥ “ኔኒ ኦደ ናኤ? አነ ታዉ ኦዳ፤ ነ አዋ ሶን ኑስ አቅያ በሲ ዳኔ?” ያግስ።<verse eid="GEN 24:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24"/>እያ፥ “ታኒ ባቱኤላ ናአ፤ ባቱኤል ምልካ ናኮራስ የልዳ ናአ። <verse eid="GEN 24:24"/><verse number="25" style="v" sid="GEN 24:25"/>ኑ ሶን ግድያ ካለይነ ሀርቆይ ደኤስ፤ ቃስ ህንተ አቃናዉ በሲ ደኤስ” ያጋሱ።<verse eid="GEN 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26"/>አደይ ጉልባትድ ጎዳ ጎይንድ፥ <verse eid="GEN 24:26"/><verse number="27" style="v" sid="GEN 24:27"/>ሀይሳዳ ያግስ፤ “ታ ጎዳስ ኬሄይሳነ አማነተይሳ አግቦና ጎዳይ፥ ታ ጎዳ አብራሃመ ፆሳይ ጋላተቶ፤ ታኒ ይሽን፥ ጎዳይ ታና ታ ጎዳ ዳቦታ ሶ ካለስ” ያግስ።<verse eid="GEN 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28"/>ናእያ ዎፃ ባዳ፥ ባ አየ ሶን ደእያ አሳስ ሀንዳባ ኦዳሱ። <verse eid="GEN 24:28"/><verse number="29" style="v" sid="GEN 24:29"/>እርብቃስ ላባ ጌተትያ እሺ ደኤስ። ላቢ ካረ ከይድ ሃ ፑልቱዋ ማታን ደእያ አድያኮ ዎፅስ። <verse eid="GEN 24:29"/><verse number="30" style="v" sid="GEN 24:30"/>ሲ ዎርቃነ ባ ምቸ ኩሸን ደእያ ሳጋዮታ በእዳ ዎደ እርብቃ አደይ ባና ግዶይሳ ኦድን ስእዳ ዎደ፥ ከይድ አድያኮ ብስ። አደይካ ግማለታራ ፑልቱዋ ማታን ኤቅዳይሳ ደምስ። <verse eid="GEN 24:30"/><verse number="31" style="v" sid="GEN 24:31"/>እያኮ፥ “ጎዳይ ነና አንጅዳይሶ፥ ሃያ፥ ኔኒ ካረን አይስ ኤቃዲ? ታኒ ነዉ ኬነ ግማለታስካ በሰ ጊግሳስ” ያግስ።<verse eid="GEN 24:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32"/>ያትን አደይ ሶ ገልስ። ላቢ ግማለታ ጫና ብልድ፥ ካለነ ለ ግማለታስ እማስ። ቶሆ ሜጫናዉ እያስነ እያራ ደእያ አሳስ ሃ ኤህስ። <verse eid="GEN 24:32"/><verse number="33" style="v" sid="GEN 24:33"/>ካ እያ ስን አስ። ሽን፥ “ታኒ ታና ኤህዳባ ህንተዉ ኦዶና ደአሸ ካ ሚከ” ያግስ።</para>
  <para style="p" vid="GEN 24:33">ላቢ፥ “ያኮ ኦዳ” ያግስ።<verse eid="GEN 24:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34"/>ሄሳ ግሾ፥ እ፥ “ታኒ አብራሃመ አይልያ። <verse eid="GEN 24:34"/><verse number="35" style="v" sid="GEN 24:35"/>ጎዳይ ታ ጎዳ ዳሮ አንጅዳ ግሾ እ ዱረትስ። ዶርሰ፥ ሚዝ፥ ብራ፥ ዎርቃ፥ አደ አይለታ፥ ማጫ አይለታ፥ ግማለታነ ሀረታ እያዉ እሚስ። <verse eid="GEN 24:35"/><verse number="36" style="v" sid="GEN 24:36"/>ታ ጎዳ ማችያ ሳራ ባ ጭማተ ላይን እያዉ አደ ናአ የላሱ። ያትን እ ባዉ ደእያባ ኡባ እያዉ እሚስ። <verse eid="GEN 24:36"/><verse number="37" style="v" sid="GEN 24:37"/>ታ ጎዳይ ታና ሀይሳዳ ጫቅስስ፥ ‘ታኒ ደእያ ካናነ ቢታ ማጫ ናይታፐ ታ ናኣስ ማቾ ኦይቾፋ። <verse eid="GEN 24:37"/><verse number="38" style="v" sid="GEN 24:38"/>ሽን ታ አዋ አሳኮ፥ ታ ዳቦታኮ ባዳ ታ ናኣስ ማቾ ኦይቻ’ ያግስ። <verse eid="GEN 24:38"/><verse number="39" style="v" sid="GEN 24:39"/>ታኒ ታ ጎዳ፥ ‘ናእያ ታራ ያናዉ ዶሶና እፅኮች?’ ያጋዳ ኦይቻስ። <verse eid="GEN 24:39"/><verse number="40" style="v" sid="GEN 24:40"/>እካ፥ ታኒ እያ ስንን ኪተትዳ ጎዳይ ባ ኪታንቹዋ ኪታና፤ ኔኒ ታ ናኣስ ታ አዋ አሳፐ፥ ታ ኮቻፈ ማቾ ደማና መላ፥ ነ በይሳካ እንጀያና። <verse eid="GEN 24:40"/><verse number="41" style="v" sid="GEN 24:41"/>ኔኒ ታ ኮቻታኮ ብን፥ ኤንቲ ነዉ እዮ እሞና እፅኮ፥ ሄ ዎደ ነዉ ጫቆይ ጎመ ግደና” ያግስ።<verse eid="GEN 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42"/>“ታኒ ሀች ሄ ፑልቱዋኮ ያ ዎደ ያጋስ፤ ‘ጎዳዉ፥ ታ ጎዳ አብራሃመ ፆሳዉ፥ ነ ሸነ ግድኮ፥ ታኒ ብያ አላልያ ጊግሳ። <verse eid="GEN 24:42"/><verse number="43" style="v" sid="GEN 24:43"/>ሄኮ፥ ታኒ ሀ ፑልቱዋ ማታን ኤቃይስ፤ ጌላኦ እስንያ ሃ ትካናዉ ዪኮ፥ ታኒ እዮ፥ ታና ነ ኦቱዋፐ ጉ ሃ ኡሻርክ’ ያጋና። <verse eid="GEN 24:43"/><verse number="44" style="v" sid="GEN 24:44"/>እያ፥ ‘ኤሮ ኡያ፥ ቃስ ነ ግማለታስካ ታኒ ሃ ዱቃና’ ግያራ፥ ጎዳይ ታ ጎዳ ናኣስ ዶርዳሮ ግዶ” ያጋስ።<verse eid="GEN 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 24:45"/>“ታኒ ታ ዎዛናን ዎሰይሳ ዛሮና ደእሽን፥ እርብቃ ባ ኦቱዋ ቶካዳ፥ ፑቱ ጋሱ፤ ፑልቱዋ ዱገ ዎዳ ሃ ዱቃሱ፤ ታኒ እዮ፥ ‘ታና ሃ ኡሻርክ’ ያጋስ።<verse eid="GEN 24:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 24:46"/>“ያግን እያ ኤለሳዳ ባ ሀሽያፐ ኦቱዋ ዎዳ፥ ‘ሄኮ ኡያ፤ ቃስ ታኒ ነ ግማለታ ኡሻና’ ያጋሱ። ያትን ታኒ ኡያስ፤ ቃስ ታ ግማለታ እያ ኡሻሱ።<verse eid="GEN 24:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="GEN 24:47"/>“ታኒ እዮ፥ ‘ኔኒ ኦደ ናኤ?’ ያጋስ።</para>
  <para style="p" vid="GEN 24:47">“እያ ዛራዳ፥ ‘ታኒ ባቱኤላ ናኣ፤ ባቱኤል፥ ምልካ ናኮራስ የልዳ ናአ’ ያጋሱ። ታኒ ዎርቃ እ ሲን፥ ሳጋዮታ እ ኩሸን አስ። <verse eid="GEN 24:47"/><verse number="48" style="v" sid="GEN 24:48"/>ሄሳፈ ጉየ፥ ታኒ ጉልባታዳ፥ ጎዳስ ጎይናስ። ታኒ ጎዳ፥ ታ ጎዳ አብራሃመ ፆሳ፥ ታ ጎዳ እሻ ናአ ናእዉ እያ ናኣስ ኤካናዉ ታና ልከ ኦግያ ካለዳይሳስ ጋላታይስ። <verse eid="GEN 24:48"/><verse number="49" style="v" sid="GEN 24:49"/>ሀእካ ህንተ ታ ጎዳስ ኬሀናባነ አማነታናባ ግድኮ፥ ታዉ ኦድተ፤ ግዶና እፅኮካ ኦድተ፤ ሄሳፈ ጉየ፥ ታኒ ሀናናባ ኤራና” ያግስ።<verse eid="GEN 24:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50"/>ላብነ ባቱኤል ዛሪድ ያግዶሶና፤ “ሀ ኦዳይ ጎዳፐ ይስ፤ ኑኒ ነዉ ያ ሃ ጋናዉ ዳንዳኦኮ። <verse eid="GEN 24:50"/><verse number="51" style="v" sid="GEN 24:51"/>እርብቆ ሀኖ በአ፤ ኤካዳ ባ፤ ጎዳይ ግዳይሳዳ ነ ጎዳ ናኣስ ማቾ ግዶ” ያግዶሶና።<verse eid="GEN 24:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 24:52"/>አብራሃመ አይለይ ኤንቲ ግያባ ስእዳ ዎደ፥ ሳአን ጉልባትድ ጎዳስ ጎይንስ። <verse eid="GEN 24:52"/><verse number="53" style="v" sid="GEN 24:53"/>አይለይ ብራ አሌቆ፥ ዎርቃ አሌቆነ ማኦ ከስድ እርብቃስ እሚስ። ቃስ አልኦ ሚሸታ እ እሻስነ እ አየስ እሚስ።<verse eid="GEN 24:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="GEN 24:54"/>ሄሳፈ ጉየ፥ እነ እያራ ደኤይሳት ምዶሶና ኡይዶሶና፤ ያን አቅዶሶና። ኤንቲ ጉራ ደንድን፥ እ፥ “ታና ታ ጎዳኮ የድተ” ያግስ።<verse eid="GEN 24:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55"/>ያትን እ እሻይነ እ አይያ፥ “ናእያ እስ ታሙ ጋላሳ መላ ኑራ ታኮ፥ ሄሳፈ ጉየ እያ ባና” ያግዶሶና።<verse eid="GEN 24:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56"/>ሽን እ፥ “ጎዳይ ታ ይዳይሳ እንጀይን፥ ህንተ ታና ጋምእሶፕተ። ታኒ ታ ጎዳኮ ባና መላ ታና ሞይዝተ” ያግስ።<verse eid="GEN 24:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57"/>ኤንቲ፥ “ናእዉ ፄግድ አነ እዮ ኦይቾስ” ያግዶሶና። <verse eid="GEN 24:57"/><verse number="58" style="v" sid="GEN 24:58"/>እርብቃ ፄግድ፥ “ሀ አድያራ ባኔ?” ያግድ ኦይችዶሶና።</para>
  <para style="p" vid="GEN 24:58">እያ፥ “ኤ፤ ታኒ ባና” ያጋሱ።<verse eid="GEN 24:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59"/>ያንን፥ ኤንቲ ባንታ ምችዉ እርብቃ፥ እዮ ድችዳሮ፥ አብራሃመ አይልያነ እያ አሳታ ሞይዝዶሶና። <verse eid="GEN 24:59"/><verse number="60" style="v" sid="GEN 24:60"/>ኤንቲ እርብቃ፥</para>
  <para style="q1" vid="GEN 24:60">“ኑ ምቸ እርብቀ፥</para>
  <para style="q2" vid="GEN 24:60">ሙኩሉፐ ሙኩሉ ጋካናዉ ዳራ፤</para>
  <para style="q2" vid="GEN 24:60">ነ ኮቻይ ባንታ ሞርከታ ካታማታ ላቶ”</para>
  <para style="m" vid="GEN 24:60">ያግድ አንጅዶሶና። <verse eid="GEN 24:60"/><verse number="61" style="v" sid="GEN 24:61"/>ሄሳፈ ጉየ፥ እርብቅነ እ ማጫ አይለት ደንድድ፥ ግማለታ ቶግድ፥ አድያራ ብዶሶና። ያትን አይለይ እርብቃ ኤክድ ብስ።<verse eid="GEN 24:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62"/>ሄ ዎደ ይሳቅ፥ “ታና በእያ ደኦ ፆሳ ፑልቱዋ” ጌተትያ ፑልቱዋ ማታ ብድ፥ ነገበ መላ ቢታን ደኤስ። <verse eid="GEN 24:62"/><verse number="63" style="v" sid="GEN 24:63"/>እስ ጋላስ ኦማርስ ይሳቅ ባ ዎዛናን ቆፕሸ ደምባ ከይድ ዩዬስ፤ እ ቁ ግድ ፄልያ ዎደ፥ ግማለት የይሳታ በእስ። <verse eid="GEN 24:63"/><verse number="64" style="v" sid="GEN 24:64"/>እርብቃካ ቁ ጋዳ ፄልያ ዎደ፥ ይሳቃ በአሱ፤ ግማለታፐ ዎሱ። <verse eid="GEN 24:64"/><verse number="65" style="v" sid="GEN 24:65"/>አብራሃመ አይልያኮ፥ “ሀ ኑራ ጋሄታናዉ ደምባራ ያ አደይ ኦኔ?” ያጋሱ።</para>
  <para style="p" vid="GEN 24:65">አይለይ፥ “እ፥ ታ ጎዳ” ያግስ። እያ ባ ላፃና ኤካዳ ጉሉንታሱ።<verse eid="GEN 24:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66"/>ቃስ አይለይ ባ ኦዳባ ኡባ ይሳቃስ ኦድስ። <verse eid="GEN 24:66"/><verse number="67" style="v" sid="GEN 24:67"/>ይሳቅ እርብቃ ባ አየ ሳራ ዱንካንያ ግዶ ኤፍስ። እዮ ማችስ፤ እያካ እያዉ ማቾ ግዳሱ። እ እዮ ዶስስ፤ ባ አየ ካዩዋ ዎስ።<verse eid="GEN 24:67"/></para>
  <chapter eid="GEN 24"/>
  <chapter number="25" style="c" sid="GEN 25"/>
  <para style="s1">አብራሃመ ሀይቁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1"/>አብራሃመይ ኬፁራ ጌተትያ ሀራ ማቾ ኤክስ። <verse eid="GEN 25:1"/><verse number="2" style="v" sid="GEN 25:2"/>እያ ዝምራና፥ ዮቅሳና፥ ማዳነ፥ ምድያመ፥ ያስቦቃነ ስዋ እያዉ የላሱ።<verse eid="GEN 25:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 25:3"/>ዮቅሳን ሳባነ ደዳና የልስ። ደዳን አሾረታ፥ ለፁሰታነ ለኡማታ የልስ።<verse eid="GEN 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 25:4"/>ምድያመ ናይት ገፈራ፥ ኤፈራ፥ ሄኖሀ፥ አብዳነ ኤልዳ። ሀይሳቲ ኡባይ ኬፁራ ሼሻታ።<verse eid="GEN 25:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5"/>አብራሃመይ ባባ ኡባ ይሳቃ ላትስስ። <verse eid="GEN 25:5"/><verse number="6" style="v" sid="GEN 25:6"/>ሽን እ ፓፃ ደእሸ፥ ሀራ ማቸታፐ የልዳ ናይታ ባዉ ደእያባፐ ዎይትስ። ባ ናአ ይሳቃፐ ኤንታ ሻክድ፥ ዶሎሀ ባጋ ቢታ የድስ።<verse eid="GEN 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7"/>አብራሃመይ ኩመ እስ ፄታነ ላፑን ታማነ እቻሹ ላይ ደእስ። <verse eid="GEN 25:7"/><verse number="8" style="v" sid="GEN 25:8"/>አብራሃመይ ዳሮ ዎደ ደእድ፥ ሎኦ ጭምድ፥ ሀይቅድ ባ ማይዛታን ጋሄትስ። <verse eid="GEN 25:8"/><verse number="9" style="v" sid="GEN 25:9"/>እያ ናይት ይሳቅነ እስማኤል እያ ማክፌላ ጌተትያ ጎንጎሎ ዱፉዋን ሞግዶሶና፤ ሄ ጎንጎሎይ ማምረ ማታን፥ ህተ አድያ ፆሃራ ናአ ኤፍሮና ጋድያን ደኤስ። <verse eid="GEN 25:9"/><verse number="10" style="v" sid="GEN 25:10"/>ሄስ አብራሃመይ ህተታፐ ሻምዳ ጋድያ። አብራሃመይ ባ ማችያ ሳራ ሞገትዳ ዱፉዋን ሞገትስ። <verse eid="GEN 25:10"/><verse number="11" style="v" sid="GEN 25:11"/>አብራሃመይ ሀይቅዳፐ ጉየ፥ ፆሳይ እያ ናአ ይሳቃ አንጅስ። ሄ ዎደ ይሳቅ፥ ቤር-ላይ-ሮእ (ታና በእያ ደኦ ፆሳ ፑልቶ) ጌተትያ ፑልቱዋ ማታን ደኤስ።<verse eid="GEN 25:11"/></para>
  <para style="s1">እስማኤላነ እያ ናይታ</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12"/>ሳራ አይልያ፥ ግብፀፈ ይዳ አጋራ፥ አብራሃመስ የልዳ ናአ እስማኤላ የለተይ ሀይሳፈ ካልድ ፃፈትዳይሳ። <verse eid="GEN 25:12"/><verse number="13" style="v" sid="GEN 25:13"/>እስማኤላ ናይት ባንታ ሱንንነ ባንታ የለታ ማራን ሀይሳታ፤ ኤንትካ፥ ናባዮታ፥ ቀዳረ፥ አድቤላ፥ ምብሳማ፥ <verse eid="GEN 25:13"/><verse number="14" style="v" sid="GEN 25:14"/>ምስማ፥ ዱማ፥ ማሳ፥ <verse eid="GEN 25:14"/><verse number="15" style="v" sid="GEN 25:15"/>ኩዳነ፥ ቴማ፥ እፁራ፥ ናፍሳነ ቀድማ። <verse eid="GEN 25:15"/><verse number="16" style="v" sid="GEN 25:16"/>እስማኤላ ናይት ሀይሳታ፤ ኤንታ ሱንይ ኤንታ ሞንነ ደእያ በሳን ሀይሳ። ኤንቲ ባንታ ያራንካ ታማነ ናምኡ ሀላቃታ። <verse eid="GEN 25:16"/><verse number="17" style="v" sid="GEN 25:17"/>እስማኤል ኩመ ፄታነ ሀስታማነ ላፑን ላይ ደእድ፥ ሀይቅድ ባ ማይዛታን ጋሄትስ። <verse eid="GEN 25:17"/><verse number="18" style="v" sid="GEN 25:18"/>እስማኤላ ኮቸት ግብፀፈ ዶሎሀ ባጋን ደእያ ሀውላፐነ ሱራፐ ግዱዋን፥ አሶረ ኤፍያ ኦግያ ማታን ደእዶሶና። ኤንቲ ባንታ እሻታ ኡባራ ሞርከተን ደእዶሶና።<verse eid="GEN 25:18"/></para>
  <para style="s1">ያይቆባነ ኤሳዌ</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19"/>አብራሃመ ናአ ይሳቃ የለተይ ሀይሳፈ ካልድ ፃፈትዳይሳ፤ አብራሃመይ ይሳቃ የልስ። <verse eid="GEN 25:19"/><verse number="20" style="v" sid="GEN 25:20"/>ይሳቃስ ላይ ኦይታማ ግድን፥ እርብቃ ኤክስ፤ እያ ማሰጰፆመን ደእያ አራመ አድያ ባቱኤላ ናእዉነ ላባ ምችዉ። <verse eid="GEN 25:20"/><verse number="21" style="v" sid="GEN 25:21"/>ይሳቅ ባ ማችያ ማይን ግድዳ ግሾ፥ እዉ ጎዳ ዎስስ፤ ጎዳይ እያ ዎሳ ስእስ። ያትን እያ ማችያ እርብቃ ቃንታሱ። <verse eid="GEN 25:21"/><verse number="22" style="v" sid="GEN 25:22"/>ሽን እ ኡሎን ደእያ ናይት መንተ ግድ ኡትድ፥ እሶይ እሱዋራ ሱገትዶሶና፤ እያ፥ “ሀይስ ታዉ አይስ ሀኒ?” ያጋሱ። ሄሳ ግሾ፥ ጎዳ ኦይቻናዉ ባሱ።<verse eid="GEN 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23"/>ጎዳይ እዮ፥ “ነ ኡሎን ናምኡ ካዎተ ደኤስ፤ ቃስ ነ ግዶን ደእያ ናምኡ ደረ አሳት እሶይ እሱዋፈ ሻከታና፤ እስ ደረ አሳት ሀንኮታፐ ምናና፤ ቃስ ባይራይ ካሉዋስ ኪተታና” ያግስ።<verse eid="GEN 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24"/>እው የሎ ዎደይ ጋክን፥ እ ኡሎን መንተ አደ ናይት ደኦሶና። <verse eid="GEN 25:24"/><verse number="25" style="v" sid="GEN 25:25"/>ኮይሮ የለትዳይስ አርሰ፤ እያ ቦላ ኡባ እክሰይ ማእስ፤ ሄሳ ግሾ፥ ኤንቲ እያ ኤሳዌ (እክሳማ) ግድ ሱንዶሶና። <verse eid="GEN 25:25"/><verse number="26" style="v" sid="GEN 25:26"/>ሄሳፈ ጉየ፥ እያ እሻይ የለትስ። እ ባ ኩሽያን ኤሳዌ ግንድያ ኦይክድ ከይስ፥ ሄሳ ግሾ፥ እያ ያይቆባ (ግንደ ኦይከይሳ) ግድ ሱንዶሶና። እርብቃ ኤንታ የልዳ ዎደ ይሳቃስ ኡሱፑን ታሙ ላይ ግድስ።<verse eid="GEN 25:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27"/>ናይት ድጭዶሶና፤ ኤሳዌይ ሻንካ ሂላ ኤርያ ባዞ አሰ ግድስ። ሽን ያይቆብ ዱንካነን ደእያ ዎፓ አሰ ግድስ። <verse eid="GEN 25:27"/><verse number="28" style="v" sid="GEN 25:28"/>ይሳቅ ኤሳዌ ዶስስ፤ አይስ ጊኮ፥ እ ሻንካተይሳፈ ማናዉ ዶሴስ፤ ሽን እርብቃ ያይቆባ ዶሳዉሱ።<verse eid="GEN 25:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29"/>እስ ዎደ ያይቆብ ዎፀ ካሽን፥ ኤሳዌይ ኮሽ ዎን ባዞፈ ይስ። <verse eid="GEN 25:29"/><verse number="30" style="v" sid="GEN 25:30"/>ኤሳዌይ ያይቆባ፥ “ታና ሀ ዞኦ ዎፅያፐ ሙዛ፥ ታና ኮሽ ዎስ” ያግስ። (ሄሳ ግሾ፥ ቃስ እያ ሱንይ ኤዶመ (ዞኦ) ጌተትስ)።<verse eid="GEN 25:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31"/>ያይቆብ እያ፥ “ኮይሮ ታዉ ነ ባይራተ ባይዛ” ያግስ።<verse eid="GEN 25:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32"/>ያትን ኤሳዌይ፥ “ሄኮ፥ ታኒ ሀይቃና ሀናይስ፥ ሀ ባይራተይ ታና አይ ማዲ?” ያግስ።<verse eid="GEN 25:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33"/>ያይቆብ ዛሪድ፥ “አነ ታዉ ኮይሮ ጫቃ” ያግስ። እ ጫቅስ፥ ባ ባይራተ ያይቆባስ ባይዝስ። <verse eid="GEN 25:33"/><verse number="34" style="v" sid="GEN 25:34"/>ያይቆብ ኤሳዌስ ኡይነ ምስረ ዎፀ እምን ምስ ኡይስ። ሄሳፈ ጉየ ደንድድ ብስ። ኤሳዌይ ባ ባይራተ ሀይሳዳ ካስ።<verse eid="GEN 25:34"/></para>
  <chapter eid="GEN 25"/>
  <chapter number="26" style="c" sid="GEN 26"/>
  <para style="s1">ይሳቃነ አብመለከ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1"/>ሄ ቢታን ካሰ አብራሃመ ዎደ ከይዳ ኮሻፐ ሀራ ኮሽ ከይስ። ያንን፥ ይሳቅ ፍልስፄመ ካዋ አብመለከኮ ገራራ ብስ። <verse eid="GEN 26:1"/><verse number="2" style="v" sid="GEN 26:2"/>ጎዳይ ይሳቃስ ቆንጭድ “ግብፀ ቢታ ዱገ ቦፓ፥ ታኒ ነዉ ኦድዳ ቢታን ደአ። <verse eid="GEN 26:2"/><verse number="3" style="v" sid="GEN 26:3"/>ሀ ቢታን ጉ ዎድያ ጋምኣሻ፥ ታኒ ኔራ ግዳና፥ ነና አንጃና። ሀ ቢታ ኡባ ታኒ ነዉነ ነ ሼሻስ እማና። ታኒ ነ አዋ አብራሃመስ ጫቅዳ ጫቁዋ ፖላና። <verse eid="GEN 26:3"/><verse number="4" style="v" sid="GEN 26:4"/>ነ ሼሻ ሳሎ ፆልንቶዳ ዳርሳና፥ ሀ ቢታ ኡባ ታኒ ኤንታዉ እማና። ሳአ ካዎተት ኡባይ ነ ሼሻ ባጋራ አንጀታና። <verse eid="GEN 26:4"/><verse number="5" style="v" sid="GEN 26:5"/>ሄስካ፥ አብራሃመይ ታ ቃላ ስእድ፥ ታ አዋጆታ፥ ታ ኪታታነ ታ ህገታ ናግዳ ግሾሳ” ያግስ። <verse eid="GEN 26:5"/><verse number="6" style="v" sid="GEN 26:6"/>ሄሳ ግሾ፥ ይሳቅ ገራራን ደእስ።<verse eid="GEN 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 26:7"/>ሄ ቢታ አሳይ እርብቃባ ደንድ፥ “ሀና ነዉ አይቤ?” ግድ ይሳቃ ኦይችዶሶና።</para>
  <para style="p" vid="GEN 26:7">እ፥ “ሀና ታዉ ምቾ” ያግስ። ሄሳ እ ግዳይ፥ እርብቃ ዳሮ ማላ ሎኦ ግድያ ግሾ፥ “እያ ታ ማቾ ጊኮ፥ ሀ አሳይ እ ጋሶን ታና ዎና” ያግ ቆፕድ ባብስ።<verse eid="GEN 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 26:8"/>ይሳቅ ያን ዳሮ ዎደ ደእዳፐ ጉየ፥ ፍልስፄመ ካዎይ አብመለከይ ማስኮተራ ዱገ ፄልያደ፥ ይሳቅ ባ ማቸ እርብቃራ ካእሽን በእስ። <verse eid="GEN 26:8"/><verse number="9" style="v" sid="GEN 26:9"/>ሄሳ ግሾ፥ አብመለከይ ይሳቃ ፄግስድ፥ “ሄኮ፥ እያ ነ ማቾ፤ ኔኒ አይስ እያ ታ ምቾ ጋዲ?” ግድ ኦይችስ።</para>
  <para style="p" vid="GEN 26:9">ይሳቅ፥ “እያ ታ ማቾ ጊኮ፥ አሳይ ታና እ ጋሶን ዎና ጋዳ ጋስ” ያግስ።<verse eid="GEN 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10"/>አብመለከይ፥ “ሀይስ ኔኒ ኑ ቦላ ኦዳባይ አይቤ? ታ አሳፐ እስ አስ ነ ማቸራ አቅስ ሽን አትስ፥ ኔኒ ኑ ቦላ ጎመ ኤሀዳሳ ሽን” ያግስ። <verse eid="GEN 26:10"/><verse number="11" style="v" sid="GEN 26:11"/>ሄሳ ግሾ፥ አብመለከይ ባ አሳ፥ “ሀ ኡራ ዎይኮ እያ ማችዉ ቦችያ ኦንካ ቱማ ሀይቃና” ያግድ ኪትስ።<verse eid="GEN 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12"/>ይሳቅ ሄ ቢታን ካ ዘርድ፥ ጎዳይ እያ አንጅዳ ግሾ ሄ ላይን ፄቱ ኩሸ ኤክስ። <verse eid="GEN 26:12"/><verse number="13" style="v" sid="GEN 26:13"/>እ ዱረተን ኤረታና ጋካናስ ዳሮ ዱረትሸ ብስ። <verse eid="GEN 26:13"/><verse number="14" style="v" sid="GEN 26:14"/>ይሳቃስ ዶርሳ ዉደይ፥ ሚዛ ዉደይነ አይለት አድ ዳርዳ ግሾ፥ ፍልስፄመ አሳት እያ ቃናትዶሶና። <verse eid="GEN 26:14"/><verse number="15" style="v" sid="GEN 26:15"/>ሄሳ ግሾ፥ እያ አዋ አብራሃመ ዎደ እያ አዋ አይለት ቦክዳ ሃ ኦላ ኡባ ፍልስፄመት ቢታ ኡሽድ ኩንዶሶና።<verse eid="GEN 26:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16"/>ሄ ዎደ አብመለከይ ይሳቃኮ፥ “ኔኒ ኑፐ አዳ ምንዳ ግሾ ኑ ማታፐ ባ” ያግስ። <verse eid="GEN 26:16"/><verse number="17" style="v" sid="GEN 26:17"/>ይሳቅ ሄሳፈ ደንድድ፥ ገራራ ዛንጋራ ብድ ዱንካነ ቶክድ ያን ደእስ። <verse eid="GEN 26:17"/><verse number="18" style="v" sid="GEN 26:18"/>ይሳቅ ባ አዋ አብራሃመ ዎደ ቦከትዳ ሃ ኦላታ፥ አብራሃመይ ሀይቅዳፐ ጉየ፥ ፍልስፄመት ኩንዳይሳታ ዛር ቦክ ከስድ፥ እያ አዋይ ሱንዳ ሱንን ፄግስ።<verse eid="GEN 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19"/>ይሳቃ አይለት ሄ ዛንጋራን ሃ ኦላ ቦክድ ያን ሎኦ ፑልቶ ሃ ደምዶሶና። <verse eid="GEN 26:19"/><verse number="20" style="v" sid="GEN 26:20"/>ሽን ገራራ ሄንንቾት ይሳቃ ሄንንቾታራ፥ “ሃይ ኑባ” ያግድ ኦየትዶሶና። ኤንቲ ፓላመትዳ ግሾ፥ ይሳቅ ሄ ሃ ኦላ “ኤሴቃ”<note caller="+" style="f"><char style="fr" closed="false">26:20 </char><char style="ft" closed="false">ኤሴቃ ጉሳይ እብራወ ዶናን ፓላማ ጉሱ።</char></note> ግድ ሱንስ።<verse eid="GEN 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 26:21"/>ሄሳፈ ጉየ፥ ኤንቲ ሀራ ሃ ኦላ ቦክዶሶና። ሽን ኤንቲ ሄ ሃ ኦላ ጌዶንካ ኦየትዶሶና። ሄሳ ግሾ፥ ይሳቅ ሄ ሃ ኦላ “ሲፅና”<note caller="+" style="f"><char style="fr" closed="false">26:21 </char><char style="ft" closed="false">ሲፅና ጉሳይ እብራወ ዶናን ሞርከተ ጉሱ።</char></note> ግድ ሱንስ። <verse eid="GEN 26:21"/><verse number="22" style="v" sid="GEN 26:22"/>ሄሳፈ ጉ ስን ሺቅድ ሀራ ሃ ኦላ ቦክስስ። እያ ጋሶን ኦንካ ኦየትቦና ግሾ፥ “ፆሳይ ሀእ ኑስ ዳልግስስ ኑኒ ሀ ቢታን ዳራና” ግድ ሄ በሳ ረሆቦታ<note caller="+" style="f"><char style="fr" closed="false">26:22 </char><char style="ft" closed="false">እብራወ ዶናን ሀ ቃላ ብርሸይ ዳልጋ በሲ ጉሱ።</char></note> ግድ ሱንስ።<verse eid="GEN 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23"/>ሄሳፈ ደንድድ ፑደ በርሳበ ከይስ። <verse eid="GEN 26:23"/><verse number="24" style="v" sid="GEN 26:24"/>ሄ ብዳ ጋላስ ቃማ ጎዳይ እያዉ ቆንጭድ፥ “ታኒ ነ አዋ አብራሃመ ፆሳ፥ ታኒ ኔራ ደእያ ግሾ፥ ባቦፋ። ታ አይልያ አብራሃመ ግሾ ታኒ ነና አንጃና፥ ነ ሼሻካ ዳርሳና” ያግስ። <verse eid="GEN 26:24"/><verse number="25" style="v" sid="GEN 26:25"/>ይሳቅ ያን ያርሾ በሲ ጊግስድ ጎዳ ሱን ፄግስ። ያን እ ባ ዱንካንያ ቶክስ፥ እያ አይለት ያን ሃ ኦላ ቦክዶሶና።<verse eid="GEN 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26"/>ሄሳፈ ጉየ፥ አብመለከይ ባና ዞርያ አሁዛነ ቶራ ሞጮና ፍኮላ ኤክድ፥ ገራራፐ ይሳቃኮ ይስ። <verse eid="GEN 26:26"/><verse number="27" style="v" sid="GEN 26:27"/>ይሳቅ ኤንታኮ፥ “ህንተ ካሰ ታና እፅድ፥ ህንተ ቢታፈ ከስ የድቤከቲ? ሀእ ታኮ አይ ኤካናዉ ይደቲ?” ያግስ።<verse eid="GEN 26:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28"/>ኤንቲ፥ “ጎዳይ ኔራ ደኤይሳ ኑኒ ጌሽ ኤርዳ። ሄሳ ግሾ፥ ሳሮተ ጫቆይ ኑ ግዶንነ ነ ግዶን ዳናዉ ኮሼስ። <verse eid="GEN 26:28"/><verse number="29" style="v" sid="GEN 26:29"/>ኑኒ ነና ቦችቦኮ፥ ነዉ ኬሀተ ፃላላ ኦድ፥ ነና ሳሮተን ሞይዝድ የድዳ። ሄሳዳካ ኔኒ ኑ ቦላ ኢታባ ኦና መላ፥ አነ ኔራ ጫቆስ። ቱማካ ሀእ ነና ጎዳይ አንጅስ” ያግዶሶና። <verse eid="GEN 26:29"/><verse number="30" style="v" sid="GEN 26:30"/>ሄ ዎደ ይሳቅ ኤንታዉ ግብራ ጊግስን ምዶሶና፥ ኡይዶሶና። <verse eid="GEN 26:30"/><verse number="31" style="v" sid="GEN 26:31"/>ዎንተ ጋላስ ዎንታ ጉራ ደንድድ ኤንቲ እሶይ እሱዋራ ጫቅዶሶና። ይሳቅ ኤንታ ሞይዝን፥ ኤንቲ ሳሮ ሻከትድ ብዶሶና።<verse eid="GEN 26:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32"/>ሄ ጋላስ ይሳቃ አይለት ይድ፥ “ኑኒ ሃ ደምዳ” ያግድ ባንታ ቦክዳ ሃ ኦላባ እያዉ ኦድዶሶና። <verse eid="GEN 26:32"/><verse number="33" style="v" sid="GEN 26:33"/>እ ሄ ሃ ኦላ ሳበ (ጫቆ) ግድ ሱንስ። ሄሳ ግሾ፥ ሄ ካታማ ሱንይ ሀች ጋካናስ በርሳበ (ጫቆ ሃ ኦላ) ጌተቴስ።<verse eid="GEN 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34"/>ኤሳዌስ ላይ ኦይታማ ግድዳ ዎደ ህተ አድያ ብኤራ ናእዉ ዮድቶነ ህተ አድያ ኤሎና ናእዉ ባሰማቶ ማችስ። <verse eid="GEN 26:34"/><verse number="35" style="v" sid="GEN 26:35"/>ኤንቲ ይሳቃነ እርብቃ አዛንሸ ደእዶሶና።<verse eid="GEN 26:35"/></para>
  <chapter eid="GEN 26"/>
  <chapter number="27" style="c" sid="GEN 27"/>
  <para style="s1">ያይቆብ ይሳቃ አንጁዋ ኤክሽን</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1"/>ይሳቅ ጭምን እያ አይፈይ ፄሎ እፅዳ ዎደ ባ ባይራ ናአ ኤሳዌ ፄግድ፥ “ታ ናአዉ” ያግስ።</para>
  <para style="p" vid="GEN 27:1">እካ፥ “ዬ” ግድ ኮይስ።<verse eid="GEN 27:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2"/>ይሳቅ፥ “ሄኮ፥ ሀእ ታኒ ጭማስ፥ ታኒ አዉደ ሀይቃነኮ ኤርከ። <verse eid="GEN 27:2"/><verse number="3" style="v" sid="GEN 27:3"/>ያንያ ግሾ፥ ሀእ ነ ሻንካ ዶንግያ ኤካዳ ባዞ ባዳ ዶአ ሻንካታዳ አሾ ኤካዳ ያ። <verse eid="GEN 27:3"/><verse number="4" style="v" sid="GEN 27:4"/>ማልኦ ካ ታ ዶሰይሳ ኦ ካዳ ታዉ ኤሀ። ታኒ ሀይቃናፐ ስን ማ ስማዳ ነና አንጃና” ያግስ።<verse eid="GEN 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5"/>ይሳቅ ባ ናአ ኤሳዌስ ኦድያ ዎደ እርብቃ ስአዉሱ። ኤሳዌይ ዶአ ሻንካትድ ኤሀናዉ ባዞ ብዳፐ ጉየ፥ <verse eid="GEN 27:5"/><verse number="6" style="v" sid="GEN 27:6"/>እርብቃ ባ ናአ ያይቆባ፥ “ነ አዋይ ነ እሻ ኤሳዌ፥ <verse eid="GEN 27:6"/><verse number="7" style="v" sid="GEN 27:7"/>‘ዶአ ሻንካታ ኤሀዳ ታዉ ማልኦ ካ ታ ማናዉ ካ። ታኒ ሀይቃናፐ ስን ማ ስማዳ ጎዳ ስንን ነና አንጃና’ ያግሽን ታኒ ስአስ። <verse eid="GEN 27:7"/><verse number="8" style="v" sid="GEN 27:8"/>ታ ናአዉ፥ ሀእ ታኒ ነዉ ኦደይሳ ሎይ ስአ። <verse eid="GEN 27:8"/><verse number="9" style="v" sid="GEN 27:9"/>ዉድያ ግዶ ባዳ ናምኡ ሞ ዴሻ ማራታ ታዉ ኤካዳ ያ። ታኒ ነ አዋስ ማልኦ ካ እ ዶሰይሳዳ ኦዳ ካና። <verse eid="GEN 27:9"/><verse number="10" style="v" sid="GEN 27:10"/>ነ አዋይ ሀይቃናፐ ስን ምድ ነና አንጃና መላ እያዉ አ” ያጋሱ።<verse eid="GEN 27:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11"/>ሽን ያይቆብ ባ አይዉ፥ “ታ እሻ ኤሳዌ ቦላ እክሰይ ደኤስ ሽን ታ ቦላይ ሊቆ። <verse eid="GEN 27:11"/><verse number="12" style="v" sid="GEN 27:12"/>ታ አዋይ ታና ኦይክ በእድ ታኒ እያ ጭምዳባ ዳንኮ፥ ታኒ አንጁዋ ግሾ ባደ ታ ቦላ ኤሀናይሳ ኤርኪ?” ያግስ።<verse eid="GEN 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13"/>እያ አይያ፥ “ታ ናአዉ፥ ሄ ባደይ ታና ጋኮ። ታኒ ነዉ ኦደይሳ ኦ፥ ባዳ ዴሻ ማራታ ታዉ ኤካዳ ያ” ያጋሱ።<verse eid="GEN 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 27:14"/>ኤህድ ባ አየስ እምን እያ አይያ ማልኦ ካ እያ አዋይ ዶሰይሳዳ ኦዳ ካሱ። <verse eid="GEN 27:14"/><verse number="15" style="v" sid="GEN 27:15"/>ሄሳፈ ጉየ፥ እርብቃ ባይራ ናአ ኤሳዌ ማኦ ሎኡዋ ኤሀዳ ያይቆባ ማይዛሱ። <verse eid="GEN 27:15"/><verse number="16" style="v" sid="GEN 27:16"/>ቃስ ሄ ዴሻታ እትያ እያ ኩሽያነ እያ ሊቆ ቆያ ማይዛሱ። <verse eid="GEN 27:16"/><verse number="17" style="v" sid="GEN 27:17"/>ባ ካዳ ማልኦ ካነ ኡይ ባ ናአ ያይቆባስ እማሱ።<verse eid="GEN 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18"/>ያትን፥ እ ባ አዋኮ ገልድ፥ “ታ አዋዉ” ያግስ።</para>
  <para style="p" vid="GEN 27:18">እካ፥ “ዬ፥ ታ ናአዉ፥ ኔኒ ኦኔ?” ያግስ።<verse eid="GEN 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19"/>ያይቆብ ባ አዋ፥ “ታኒ ነ ባይራ ናአ ኤሳዌ። ኔኒ ታና ኪትዳይሳዳ ታኒ ኦስ፤ ሀእ ደንዳ ኡታዳ፥ ታኒ ሻንካታ ኤህዳይሳፈ ማዳ፥ ታና አንጃ” ያግስ።<verse eid="GEN 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20"/>ይሳቅ ባ ናአ፥ “ታ ናአዉ፥ ዋታ ኤለሳዳ ደማዲ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="GEN 27:20">ያይቆብ፥ “ጎዳይ፥ ነ ፆሳይ ታዉ ጊግስስ” ያግስ።<verse eid="GEN 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21"/>ይሳቅ ያይቆባ፥ “ታ ናአዉ፥ ኔኒ ቱማ ታ ናአ ኤሳዌኮ ታ ነና ኦይካ በአና አነ ሀ ሺቃ” ያግስ። <verse eid="GEN 27:21"/><verse number="22" style="v" sid="GEN 27:22"/>ያይቆብ ባ አዋኮ ሺቅን ኦይክ በእድ፥ “ነ ቃላይ ያይቆባ ቃላ ሽን ኩሸይ ኤሳዌ ኩሽያ ዳኔስ” ያግስ። <verse eid="GEN 27:22"/><verse number="23" style="v" sid="GEN 27:23"/>እያ ኩሸይ እያ እሻ ኤሳዌ ኩሽያዳ እክሰራ ደእያ ግሾ፥ ሻክድ ኤርቦና እያ አንጅስ። <verse eid="GEN 27:23"/><verse number="24" style="v" sid="GEN 27:24"/>እያ፥ “ቱማ ኔኒ ታ ናአ ኤሳዌ?” ያግድ ዛር ኦይችስ።</para>
  <para style="p" vid="GEN 27:24">እካ፥ “ኤ፥ ታና” ያግስ።<verse eid="GEN 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25"/>ያትን እ፥ “ታ ናአዉ፥ ታኒ ነ ሻንካታ ኤህዳባፐ ማዳ ነና አንጃና መላ አነ ሀ አ” ያግስ። ያይቆብ አን ምስ፥ ቃስ እያዉ ዎይነ ኤህን ኡይስ።<verse eid="GEN 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 27:26"/>ሄሳፈ ጉየ፥ እያ አዋ ይሳቅ፥ “ታ ናአዉ፥ ሀ ሺቃዳ ታና ዬራ” ያግስ።<verse eid="GEN 27:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 27:27"/>ያይቆብ ሺቅድ እያ ዬርስ። ይሳቅ እያ ማኡዋ ስንግ ስእድ፥</para>
  <para style="b" vid="GEN 27:27"/>
  <para style="q1" vid="GEN 27:27">“ታ ናአ ፔኖይ</para>
  <para style="q2" vid="GEN 27:27">ጎዳይ አንጅዳ ጎሻዳ ሳዌስ።<verse eid="GEN 27:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="GEN 27:28"/>ፆሳይ ሳሎ አካነ ሳአ ሽጫ፥</para>
  <para style="q2" vid="GEN 27:28">ካነ ዎይነ ዳርስድ ነዉ እሞ።<verse eid="GEN 27:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="GEN 27:29"/>ካዎተት ነዉ ሃረቶ፥</para>
  <para style="q2" vid="GEN 27:29">አሳይ ነዉ ጉልባቶ።</para>
  <para style="q1" vid="GEN 27:29">ኔኒ ነ እሻታስ ጎዳ ግዳ፥</para>
  <para style="q2" vid="GEN 27:29">ነ አየ ሼሻት ነዉ ጉልባቶ።</para>
  <para style="q1" vid="GEN 27:29">ነና ባደይሳት ባደትዳባ ግዶ፥</para>
  <para style="q2" vid="GEN 27:29">ነና አንጀይሳት አንጀትዳባ ግዶ” ያግድ አንጅስ።<verse eid="GEN 27:29"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30"/>ይሳቅ ያይቆባ አንጅድ ኦንግዳፐ ጉየ፥ ያይቆብ ባ አዋ ስንፈ ቡሮ ከይያ ዎደ ኤሳዌይ ሻንካፈ ፑቱ ግስ። <verse eid="GEN 27:30"/><verse number="31" style="v" sid="GEN 27:31"/>እካ ቃስ ማልኦ ካ ካድ ባ አዋስ አድ፥ “ታ አዋዉ፥ ዳንዳ ኡታዳ ታ ሻንካትዳባፐ ማ፥ ያታዳ ታና አንጃ” ያግስ።<verse eid="GEN 27:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32"/>ይሳቅ፥ “ነ ኦኔ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="GEN 27:32">እካ፥ “ታኒ ነ ባይራ ናአ ኤሳዌ” ያግስ።<verse eid="GEN 27:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33"/>ይሳቅ ዳጋምድ ኮኮርሸ፥ “ያትን ዶአ ሻንካትዳይሳፈ ታዉ አዳይ ኦኔ? ታኒ ሀእ ኔኒ ያና ስንን ማዳ፥ እያ አንጃስ። እካ ቱማ አንጀትዳይሳ ግዳና” ያግስ።<verse eid="GEN 27:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34"/>ኤሳዌይ ባ አዋ ቃላ ስእዳ ዎደ ባ ቃላ ቁ ኦድ፥ ዳሮ ኢታ ዬሆ ዬክሸ፥ “ታ አዋዉ፥ ታናካ አንጃ” ያግስ።<verse eid="GEN 27:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35"/>ሽን እ፥ “ነ እሻይ ጭምድ ነ አንጁዋ ኤክ ድግስ” ያግስ።<verse eid="GEN 27:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36"/>ኤሳዌይ፥ “እ ኤርድ ያይቆባ (ጭመይሳ) ግድ ሱንትስ። እ ታና ጭምሽን ሀይስ ናምአን፥ ካሰ ታ ባይራተ ኤክስ፥ ሀእ ቃስ ታ አንጁዋ ኤክስ” ያግስ። ያትን፥ “ኔኒ ታዉ አንጁዋፈ አይኮካ አሻብኪ?” ያግድ ኦይችስ።<verse eid="GEN 27:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37"/>ይሳቅ ኤሳዌ፥ “ታኒ እያ ነዉ ጎዳ ኦስ። እያ እሻታ ኡባታካ እያዉ አይለ ኦስ። ቃስ ታኒ ካንነ ዎይነን እያ ምንስ። ያትን፥ ታ ናአዉ፥ ነዉ ታ አይ ኦ?” ያግስ።<verse eid="GEN 27:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38"/>ኤሳዌይ ባ አዋ፥ “ታ አዋዉ፥ ነዉ እስ አንጆ ፃላል ደኢ? ታ አዋዉ፥ ታናካ ቃስ አንጃ” ያግስ። ሄሳፈ ጉየ፥ ኤሳዌይ ባ ቃላ ቁ ኦድ ዬክስ።<verse eid="GEN 27:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39"/>እያ አዋ ይሳቅ ዛሪድ፥</para>
  <para style="b" vid="GEN 27:39"/>
  <para style="q1" vid="GEN 27:39">“ነ ደእያ በሳይ ሀ ሳአ ዱረተፈ ሃሆ፥</para>
  <para style="q2" vid="GEN 27:39">ሳሎ አክካ ነዉ ዎና።<verse eid="GEN 27:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="GEN 27:40"/>ኔኒ ነ ማሻን አቃና፥</para>
  <para style="q2" vid="GEN 27:40">ነ እሻስ ሃረታና።</para>
  <para style="q1" vid="GEN 27:40">ሽን ኔኒ እያራ ኤቀትያ ዎደ</para>
  <para style="q2" vid="GEN 27:40">እያ ቃምባራ ነ ጋናፈ ሆላና” ያግስ።<verse eid="GEN 27:40"/></para>
  <para style="s1">ይሳቅ ያይቆባ ላባኮ የዱዋ</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41"/>ያይቆባ እያ አዋይ አንጅዳ ግሾ፥ ኤሳዌይ ባ ኡሎን እያ ሞርክስ። እ ባ ዎዛናን፥ “ታ አዋይ ሀይቃናዉ ማትስ። እ ሀይቅዳ መላ ታ እሻ ያይቆባ ዎና” ያግስ።<verse eid="GEN 27:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42"/>ሽን እርብቃ ሄ ባ ባይራ ናአ ኤሳዌ ቃላ ስእዳ ግሾ፥ ባ ካሎ ናአ ያይቆባ ፄግሳ ኤሀዳ፥ “ነ እሻ ኤሳዌይ ነና ዎድ ሃሉዋ ከሳናዉ ሀልቼስ። <verse eid="GEN 27:42"/><verse number="43" style="v" sid="GEN 27:43"/>ሀያና ታ ናአዉ፥ ታኒ ነዉ ኦደይሳ ኦ። ደንዳዳ ካራነን ደእያ ታ እሻ ላባኮ ባቃታ። <verse eid="GEN 27:43"/><verse number="44" style="v" sid="GEN 27:44"/>ነ እሻ ሀንቆይ እርፃና ጋካናዉ ጉ ዎደ እያራ ደኣሻ። <verse eid="GEN 27:44"/><verse number="45" style="v" sid="GEN 27:45"/>ነ እሻ ይሎይ ዎያ ዎደነ ኔኒ እያ ቦላ ኦዳባ እ ዶግያ ዎደ ታኒ ኪታዳ ነና ኤሀና። ታኒ እስ ጋላስ ህንተ ናምኣፈካ መላ አታናዉ ኮይከ” ያጋሱ።<verse eid="GEN 27:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46"/>ሄሳፈ ጉየ፥ እርብቃ ይሳቃኮ፥ “ኤሳዌይ ኤክዳ ህተታ ማጫ ናይታ ጋሶን ታኒ ታ ደኡዋ ሻተታስ። ቃስ ያይቆብካ ሀይሳ ህተታ ማጫ ናይታፐ ማቾ ኤክኮ፥ ታዉ ሀይቆይ ሎኦ” ያጋሱ።<verse eid="GEN 27:46"/></para>
  <chapter eid="GEN 27"/>
  <chapter number="28" style="c" sid="GEN 28"/>
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1"/>ሄሳ ግሾ፥ ይሳቅ ያይቆባ ፄግድ፥ “ካናነ ቢታ ማጫ ናይታፐ ማቾ ኤኮፋ። <verse eid="GEN 28:1"/><verse number="2" style="v" sid="GEN 28:2"/>ደንዳዳ ነ አየ አዋ ባቱኤላኮ ማሰጰፆመ ቢታ ባዳ ያፐ ነ አየ እሻ ላባ ማጫ ናይታፐ ማቾ ኤካ። <verse eid="GEN 28:2"/><verse number="3" style="v" sid="GEN 28:3"/>ኡባ ዳንዳእያ ፆሳይ ነና አንጆ፥ እ ነዉ ናይታ እሞ፥ ዳሮ ደረ ግዳና ጋካናስ እ ነና ዳርሶ። <verse eid="GEN 28:3"/><verse number="4" style="v" sid="GEN 28:4"/>ኔኒ ሀእ በተተን ኡትዳ ሀ ቢታ ነባ ኦና መላ ነዉነ ነ ሼሻስ ፆሳይ አብራሃመ አንጁዋ እሞ” ያግ አንጅድ ኪትስ። <verse eid="GEN 28:4"/><verse number="5" style="v" sid="GEN 28:5"/>ያግድ ይሳቅ ያይቆባ የድስ። ያይቆብ ማሰጰፆመ ቢታ ላባኮ ብስ። ላቢ ያይቆባነ ኤሳዌ አየ እርብቃ እሻነ አራመ አድያ ባቱኤላ ናአ።<verse eid="GEN 28:5"/></para>
  <para style="s1">ኤሳዌይ ሀራ ማቾ ኤኩዋ</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6"/>ይሳቅ ያይቆባ አንጅድ ማሰጰፆመ ቢታፈ ማቾ ኤካና መላ እያ የድዳይሳ፥ እ ያይቆባ አንጅዳ ዎደ፥ “ካናነ ማጫስ ኤኮፋ” ግድ ኪትዳይሳነ፥ <verse eid="GEN 28:6"/><verse number="7" style="v" sid="GEN 28:7"/>ያይቆብ ባ አዋስነ ባ አየስ ኪተትድ ማሰጰፆመ ቢታ ብዳይሳ፥ ኤሳዌይ ኤርስ። <verse eid="GEN 28:7"/><verse number="8" style="v" sid="GEN 28:8"/>ኤሳዌይ ሄሳን ካናነ ቢታ ማጫስ ባ አዋ ይሳቅ አይ መላ እፅያኮ ኤርስ። <verse eid="GEN 28:8"/><verse number="9" style="v" sid="GEN 28:9"/>ሄሳ ግሾ፥ ኤሳዌይ አብራሃመ ናአ እስማኤላኮ ብድ፥ እያ ናእዉ ማህላቶ፥ ነባዮታ ምችዉ፥ ባ ማቸታ ቦላ ጉጅድ ኤክስ።<verse eid="GEN 28:9"/></para>
  <para style="s1">ያይቆብ ቤተለን አሙሆ በኡዋ</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10"/>ያይቆብ በርሳበፐ ካራነ ባናዉ ከይስ። <verse eid="GEN 28:10"/><verse number="11" style="v" sid="GEN 28:11"/>እ፥ እስ በሲ ጋክያ ዎደ አው ዉልን፥ ቃማ ያን አቅስ። ሄ በሳን ደእያ ሹቻታፐ እሱዋ ቦርኮትድ ሄ በሳን ስክስ። <verse eid="GEN 28:11"/><verse number="12" style="v" sid="GEN 28:12"/>እ አሙሆ አሙህድ ኮዶ እሶይ ሳአን ኤቅን ፄራይ ሳሎ ጋክዳይሳነ፥ ፆሳ ኪታንቾት እያ ቦላራ ፑደ ከየይሳታነ ዱገ ዎይሳታ በእስ። <verse eid="GEN 28:12"/><verse number="13" style="v" sid="GEN 28:13"/>ሄ ኮዱዋስ ፄራን ጎዳይ ኤቅድ፥ “ታኒ ጎዳ፥ ነ አዋ አብራሃመ ፆሳ፥ ይሳቃ ፆሳ፥ ሀ ኔኒ ዝንእዳ ቢታ ነዉነ ነ ሼሻስ እማና። <verse eid="GEN 28:13"/><verse number="14" style="v" sid="GEN 28:14"/>ነ ሼሻ ሳአ ሻፈዳ ዳርሳና። ኔኒ ዶሎሀ ባጋ፥ ዉሎሀ ባጋ፥ ፑደሀ ባጋነ ዱገሀ ባጋ ዳልጋና። ቢታ ቦላ ደእያ አሳ ኡባይ ነ ባጋራነ ነ ሼሻ ባጋራ አንጀታና። <verse eid="GEN 28:14"/><verse number="15" style="v" sid="GEN 28:15"/>ታኒ ኔራ ደአይስ። ኔኒ ብያ በሳ ኡባን ታኒ ነና ናጋና። ታኒ ነና ሀ ቢታ ጉየ ዛራዳ ኤሀና። ታኒ ነዉ ኦና ግዳይሳ ፖላና፥ ነና አግከ” ያግስ።<verse eid="GEN 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16"/>ያይቆብ ስኮፈ ባርክድ፥ “ታ ኤራብከፈ አትሽን፥ ቱማ ጎዳይ ሀ በሳን ደኤስ” ያግስ። <verse eid="GEN 28:16"/><verse number="17" style="v" sid="GEN 28:17"/>እ ባብድ፥ “ሀ በሳይ ዋን ያሽ! ሀ በሳይ ፆሳ ኬፈ አትሽን፥ ሀራሶ ግደና። ሀይስ ሳሎ ፐንገ” ያግስ።<verse eid="GEN 28:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18"/>ዎንተ ጋላስ ዎንታ ጉራ ያይቆብ ደንድድ፥ ፆሳስ ዱማያናዉ ባ ቦርኮትዳ ሹቻ ኤክድ ቱሳ ኤስድ እያ ቦላ ዛይተ ትግስ። <verse eid="GEN 28:18"/><verse number="19" style="v" sid="GEN 28:19"/>ያይቆብ ሄ በሳ ቤተለ (ፆሳ ኬ) ግድ ፄግስ። ሽን ሄ ካታማይ ሄሳፈ ካሰ ሎዛ ጌተቴስ።<verse eid="GEN 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 28:20"/>ያይቆብ፥ “ታ ብያ ኦግያን ነ ታና ናግኮ፥ ታዉ ካነ ማኦ እምኮ፥ <verse eid="GEN 28:20"/><verse number="21" style="v" sid="GEN 28:21"/>ነ ታና ታ አዋ ሶ ሳሮ ዛርኮ፥ ነ ታ ፆሳ ግዳና። <verse eid="GEN 28:21"/><verse number="22" style="v" sid="GEN 28:22"/>ታኒ ዱማያናዉ ቱሳ ኤስዳ ሀ ሹቻይ ፆሳ ኬ ግዳና። ቱማ ኔኒ ታዉ እምያባ ኡባፈ ታማፈ እሱዋ ነዉ እማና” ያግድ ፆሳስ ጫቅስ።<verse eid="GEN 28:22"/></para>
  <chapter eid="GEN 28"/>
  <chapter number="29" style="c" sid="GEN 29"/>
  <para style="s1">ያይቆብ ላባ ሶ ጋከ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1"/>ሄሳፈ ጉየ፥ ያይቆብ ደንድድ፥ ብድ ዶሎሀ ባጋ አሳ ቢታ ጋክስ። <verse eid="GEN 29:1"/><verse number="2" style="v" sid="GEN 29:2"/>ያንካ ደምባ በሳን ሃ ኦላ ደምስ። ሄ ዶርሳ ዉደት ሄ ሃ ኦላ ማታን ደኦሶና። ዉደ ኡባይ ሃ ኡየይ ሄ ኦላፈ። ሄ ሃ ኦላ ዶና ጎርድያ ሹቻይ ግታ። <verse eid="GEN 29:2"/><verse number="3" style="v" sid="GEN 29:3"/>ዶርሳ ዉደ ኡባይ ያ ሺቅኮ፥ ዉድያ ሄመይሳት ሃ ኦላ ዶናፐ ሄ ሹቻ ጎንዶርስድ ዉድያ ሃ ኡሾሶና። ኡሽ ስሚድ ሄ ሹቻ ኦላ ዶናን ዛር ዎሶና።<verse eid="GEN 29:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4"/>ያይቆብ ኤንታኮ፥ “ህንተ አዉፐ ይደቲ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="GEN 29:4">ኤንትካ፥ “ኑኒ ካራነፐ ይዳ” ያግዶሶና።<verse eid="GEN 29:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5"/>እ፥ “ናኮራ ናአ ናኣ ላባ ኤሬቲ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="GEN 29:5">“ኤ፥ እያ ኤሮስ” ያግዶሶና።<verse eid="GEN 29:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6"/>ያይቆብ ኤንታ፥ “እ ሎኦ ደኢ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="GEN 29:6">“ኤ፥ ሎኦ፥ እያ ናእዉ ራሄሎ ዶርሳታ ላጋዳ ያሮ ህን በአ” ያግዶሶና።<verse eid="GEN 29:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7"/>ያይቆብ ኤንታኮ፥ “ሄኮ፥ ሀእ አው ቃን ደኤስ። ዉደ መሄይ ሶ ስምያ ዎደይ ቡሮ ጋክቤና፥ ዶርሳ ኡሽ ኤፍድ ሄምተ” ያግስ።<verse eid="GEN 29:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8"/>ሽን ኤንቲ፥ “ዉደ ኡባይ ሺቅን ሹቻ ሃ ኦላ ዶናፐ ጎንዶርሳና ጋካናስ ኑ ኡሻናዉ ዳንዳኦኮ። ሄሳፈ ጉየ፥ ሹቻ ጎንዶርስድ ዶርሳታ ኡሻና” ያግዶሶና።<verse eid="GEN 29:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9"/>እ ቡሮ ኦድሽን፥ ላባ ናእያ ራሄላ ዶርሳታ ሄምያ ግሾ፥ ባ አዋ ዶርሳታ ላጋ ኤካዳ ጋካሱ። <verse eid="GEN 29:9"/><verse number="10" style="v" sid="GEN 29:10"/>ያይቆብ ባ አየ እሻ ላባ ናእዉ ራሄሎ ላባ ዶርሳታ ላጋዳ ያሮ በእዳ ዎደ ብድ ኦላ ዶናፐ ሹቻ ጎንዶርስድ ዶርሳታ ሃ ኡሽስ። <verse eid="GEN 29:10"/><verse number="11" style="v" sid="GEN 29:11"/>ያይቆብ ራሄሎ ዬርድ፥ ኡፋይሳን ባ ቃላ ቁ ኦድ ዬክስ። <verse eid="GEN 29:11"/><verse number="12" style="v" sid="GEN 29:12"/>ያይቆብ፥ “ታኒ ነ አዋ ምቸ እርብቃ ናአ” ያግድ እዉ ኦድስ። ሄሳ ግሾ፥ እያ ዎፃ ባዳ ባ አዋስ ኦዳሱ።<verse eid="GEN 29:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 29:13"/>ላቢ ባ ምቸ ናአ ያይቆባ ዩሳ ስእዳ መላ ሞካናዉ ዎፅድ ብስ። እያ እድም ዬርድ ባ ሶ ኤፍስ። ያን ያይቆብ ሀንዳባ ኡባ ላባስ ኦድስ።<verse eid="GEN 29:13"/></para>
  <para style="s1">ያይቆብ ላባ ናይታ ማችስ</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 29:14"/>ላቢ እያ፥ “ኔኒ ቱማ ታ አሾነ ታ ሱ” ያግስ። ያይቆብ እያራ እስ አጌና ኩመ ኡትስ። <verse eid="GEN 29:14"/><verse number="15" style="v" sid="GEN 29:15"/>ሄሳፈ ጉየ፥ ላቢ ያይቆባ፥ “ኔኒ ታዉ ዳቦ ግድዳ ግሾ፥ ታዉ መላ ጮ ኦነዬ? አነ ታ ነዉ አይ ቃንፃናዉ ኮሽያኮ ታዉ ኦዳ” ያግስ። <verse eid="GEN 29:15"/><verse number="16" style="v" sid="GEN 29:16"/>ላባስ ናምኡ ማጫ ናይት ደኦሶና። ባይረ ሱንይ ልያ፥ ካልያ ቃስ ራሄሎ ጌተታዉሱ። <verse eid="GEN 29:16"/><verse number="17" style="v" sid="GEN 29:17"/>ልያ አይፈራ ጩጫ፥ ሽን ራሄላ የገልስነ ማላ ሎኦ።<verse eid="GEN 29:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 29:18"/>ያይቆብ ራሄሎ ዶስድ፥ “ታኒ ነ ካሎ ናኤ ራሄል ግሾ ነዉ ላፑን ላይ ኦና” ያግስ።<verse eid="GEN 29:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19"/>ላቢ፥ “እዮ ሀራ አሳስ እማናፐ ነዉ እሞይ ሎኦ፥ ነ ታራ ሀይሳን ደአ” ያግስ። <verse eid="GEN 29:19"/><verse number="20" style="v" sid="GEN 29:20"/>ሄሳ ግሾ፥ ያይቆብ ራሄሎ ኤካናዉ ላፑን ላይ ኦስ። ሽን እ እዮ ዳሮ ዶስያ ግሾ፥ እያዉ ጉ ጋላስ ዳንስ።<verse eid="GEN 29:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21"/>ሄሳፈ ጉየ፥ ያይቆብ፥ “ታ ማችዉ ታዉ እማ፥ ታ ላይይ ዉርስ ታኒ እዮ ኤካናዉ ኮያይስ” ያግስ። <verse eid="GEN 29:21"/><verse number="22" style="v" sid="GEN 29:22"/>ሄሳ ግሾ፥ ላቢ አሳ ኡባ ፄግድ ያጋኖ ከስስ። <verse eid="GEN 29:22"/><verse number="23" style="v" sid="GEN 29:23"/>ሽን ሳእ ቃምን ላቢ ባ ናእዉ ልያ ኤፍድ ያይቆባስ እሚስ። ያይቆብ እዮ ኤክስ። <verse eid="GEN 29:23"/><verse number="24" style="v" sid="GEN 29:24"/>ቃስ ላቢ ባ አይልዉ ዛላፋ ባ ናኤ ልያስ አይለ ኦድ እሚስ።<verse eid="GEN 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 29:25"/>ሳእ ዎንትን እ ፄልያ ዎደ ሄኮ ልያ። ያይቆብ፥ “ሀይስ ኔኒ ታ ቦላ ኦዳይስ አይቤ? ታኒ ነዉ ኦዳይ ራሄል ግሾሳ ግደነዬ? ታና አይስ ጭማድ” ያግስ።<verse eid="GEN 29:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26"/>ላቢ እያኮ፥ “ኑ ቢታን ባይሪያ ደእሽን ካልዉ አዝናስ እመይስ ዎጋ ግደና። <verse eid="GEN 29:26"/><verse number="27" style="v" sid="GEN 29:27"/>ምሽራተን ኢራ ሳምንታ ኦንግኮ፥ ቃስ ካልውካ ታኒ ነዉ እማና። ሄሳፈ ጉየ፥ ሀራ ላፑን ላይ ታዉ ኦሳ” ያግስ።<verse eid="GEN 29:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28"/>ያይቆብ ኦዳ ማእድ ሳምንታ ኢራ ኦንግስ። ሄሳፈ ጉየ፥ ላቢ ባ ናእዉ ራሄሎ እያዉ እሚስ። <verse eid="GEN 29:28"/><verse number="29" style="v" sid="GEN 29:29"/>ቃስ ላቢ ባ አይልዉ ባሎ ባ ናኤ ራሄልስ አይለ ኦድ እሚስ። <verse eid="GEN 29:29"/><verse number="30" style="v" sid="GEN 29:30"/>ያይቆብ ራሄሎካ ኤክስ። ራሄሎ ልያፐ አድ ዶስስ። ሀራ ላፑን ላይ ላባስ ኦስ።<verse eid="GEN 29:30"/></para>
  <para style="s1">ያይቆባነ እያ ናይታ</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31"/>ጎዳይ ልያ ራሄል ዶሰታቦናሮ በእድ፥ እዉ የሎ ኡሉዋ ዶይስ። ሽን ራሄላ ናአ የሎና ጋምአሱ። <verse eid="GEN 29:31"/><verse number="32" style="v" sid="GEN 29:32"/>ልያ ቃንታዳ አደ ናአ የላሱ። እያ፥ “ጎዳይ ታ መቱዋ በእስ፥ ሀእ ታና ታ አዝናይ ዶሳና” ጋዳ ሄ ናአ ሮቤላ<note caller="+" style="f"><char style="fr" closed="false">29:32 </char><char style="fq" closed="false">ሮቤላ፦ እብራወ ዶናን ሀ ሱን ብርሸይ “ሀሹ፥ አደ ናአ” ዎይኮ “ታ መቱዋ በእስ” ጉሱ።</char></note> ጋዳ ሱንሱ።<verse eid="GEN 29:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 29:33"/>እያ ናምአን ቃንታዳ አደ ናአ የላሱ። እያ፥ “ጎዳይ ታኒ ዶሰታቦናይሳ በእዳ ግሾ፥ ታዉ ሀይሳካ ጉጅስ” ጋዳ ስሞና<note caller="+" style="f"><char style="fr" closed="false">29:33 </char><char style="fq" closed="false">ስሞና፦ </char><char style="ft" closed="false">ሀ ሱን ብርሸይ እብራወ ዶናን “ስእስ” ጉሱ።</char></note> ጋዳ ሱንሱ።<verse eid="GEN 29:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 29:34"/>እያ ሄን ቃንታዳ አደ ናአ የላሱ። እያ፥ “ታኒ እያዉ ሄ አደ ናይታ የልዳ ግሾ፥ ታ አዝናይ ሀእ ታራ ሲቆን ዋፀታና” ጋዳ እያ ሌወ<note caller="+" style="f"><char style="fr" closed="false">29:34 </char><char style="fq" closed="false">ሌወ፦ </char><char style="ft" closed="false">ሀ ሱን ብርሸይ “ዋፀታና” ጉሱ።</char></note> ጋዳ ሱንሱ።<verse eid="GEN 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 29:35"/>እያ ሀራ ቃንታዳ አደ ናአ የላሱ። እያ፥ “ሀእ ታኒ ጎዳ ጋላታና” ጋዳ እያ ሱን ይሁዳ<note caller="+" style="f"><char style="fr" closed="false">29:35 </char><char style="fq" closed="false">ይሁዳ፦ </char><char style="ft" closed="false">እብራወ ዶናን ሀ ሱንይ “ጋላታ” ጉሱ።</char></note> ጋዳ ሱንሱ። ሄሳፈ ጉየ፥ የሎ ኤቃሱ።<verse eid="GEN 29:35"/></para>
  <chapter eid="GEN 29"/>
  <chapter number="30" style="c" sid="GEN 30"/>
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1"/>ራሄላ ያይቆባስ ናይታ የሎናይሳ በአዳ ባ ምችዉ ቃናታሱ። ሄሳ ግሾ፥ ያይቆባ፥ “ታዉ ናአ እማ፥ እፅኮ ታኒ ሀይቃና” ያጋሱ።<verse eid="GEN 30:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2"/>ያይቆብ ራሄሎ ሀንቀትድ፥ “ታና ነዉ የሎ እማናዉ ዎይኮ ድጋናዉ ፆሰ ጋድዬ?” ያግስ።<verse eid="GEN 30:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3"/>እያ፥ “ታ ጋንድዉ ባሎ ህኖ በአ። እያ ታ ግሾ የላና መላ ኔኒ ኢራ አቃ፥ ያንኮ፥ ታኒ እ ባጋራ ናአ ደማና” ያጋሱ። <verse eid="GEN 30:3"/><verse number="4" style="v" sid="GEN 30:4"/>ባ ጋንድዉ ባሎ ማቾ ኦድ ኤካና መላ እያዉ እማሱ። <verse eid="GEN 30:4"/><verse number="5" style="v" sid="GEN 30:5"/>ባላ ቃንታዳ አደ ናአ ያይቆባስ የላሱ። <verse eid="GEN 30:5"/><verse number="6" style="v" sid="GEN 30:6"/>ያትን ራሄላ፥ “ፆሳይ ታዉ ፕርድስ፥ ታ ዎሳካ ስእድ ታዉ አደ ናአ እሚስ” ያጋዳ ሄ ናአ ዳነ<note caller="+" style="f"><char style="fr" closed="false">30:6 </char><char style="ft" closed="false">ሀ ሱን ብርሸይ እብራወ ዶናን “ፕርድስ” ጉሱ።</char></note> ጋዳ ሱንሱ።<verse eid="GEN 30:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 30:7"/>ራሄል ጋንድያ ባላ ቃንታዳ ያይቆባስ ናምአን አደ ናአ የላሱ። <verse eid="GEN 30:7"/><verse number="8" style="v" sid="GEN 30:8"/>ራሄላ፥ “ታኒ ታ ምቸራ ዎልቃማ ባፀ ባፀታዳ ፆናስ” ያጋዳ ሄ ናአ ንፍታለመ<note caller="+" style="f"><char style="fr" closed="false">30:8 </char><char style="ft" closed="false">ንፍታለመ ጌተትያ ሱን ብርሸይ “ባፀ” ጉሱ።</char></note> ጋዳ ሱንሱ።<verse eid="GEN 30:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9"/>ልያ የሎ ኤቅዳይሳ በአዳ፥ ባ ጋንድያ ዛላፋ ያይቆባስ ማቾ ኦዳ እማሱ። <verse eid="GEN 30:9"/><verse number="10" style="v" sid="GEN 30:10"/>ልያ ጋንድያ ዛላፋ አደ ናአ ያይቆባስ የላሱ። <verse eid="GEN 30:10"/><verse number="11" style="v" sid="GEN 30:11"/>ልያ፥ “ላ ሀይስ አይብ ሎኦ ቃደ!” ያጋዳ፥ ሄ ናአ ጋደ<note caller="+" style="f"><char style="fr" closed="false">30:11 </char><char style="ft" closed="false">ጋደ ጉሳይ “ሎኦ ቃዳ” ጉሱ።</char></note> ጋዳ ሱንሱ።<verse eid="GEN 30:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 30:12"/>ልያ ጋንድያ ዛላፋ ያይቆባስ ናምአን አደ ናአ የላሱ። <verse eid="GEN 30:12"/><verse number="13" style="v" sid="GEN 30:13"/>ልያ፥ “ታና ዳሮ ኡፋይሴስ፤ ማጫስ ኡባይ ታና ኡፋይትያሮ ጋና” ጋዳ ሄ ናአ አሴራ<note caller="+" style="f"><char style="fr" closed="false">30:13 </char><char style="ft" closed="false">አሴራ ጌተትያ ሱን ብርሸይ “ኡፋይስ” ጉሱ።</char></note> ጋዳ ሱንሱ።<verse eid="GEN 30:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14"/>ግስተ ጫክያ አጌናን ሮቤል ጋደ ብድ እንኮያ ም አይፈ ደምድ ባ አየ ልያስ ኤክድ ይስ። ራሄላ ልያኮ፥ “ነ ናአይ ኤህዳ እንኮያ ም አይፍያፐ ታዉ እማ” ያጋሱ።<verse eid="GEN 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15"/>ሽን ልያ፥ “ታ አዝና ኔኒ ዎልቃን ኤክዳይስ ግዶና እፅን ሀእ ቃስ ታ ናአ እንኮያ ሚ አይፍያ ኤካኔ?” ያጋሱ።</para>
  <para style="p" vid="GEN 30:15">ራሄላ፥ “ነ ናአ እንኮያ ታዉ እምኮ፥ ያይቆብ ሀች ቃማ ኔራ አቆ” ያጋሱ።<verse eid="GEN 30:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16"/>ሄ ጋላስ ኦማርስ ያይቆብ ባዞፈ ያ ዎደ ልያ እያ ሞካናዉ ከያዳ፥ “ኔኒ ታራ አቃናዉ ኮሼስ፤ ታኒ ታ ናአ እንኮያ አይፈያን ነና ሻማስ” ያጋሱ። ሄሳ ግሾ፥ እ ሄ ቃማ ኢራ አቅስ።<verse eid="GEN 30:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17"/>ፆሳይ ልያ ዎሳ ስእስ። እያ ቃንታዳ እቻሻን አደ ናአ ያይቆባስ የላሱ። <verse eid="GEN 30:17"/><verse number="18" style="v" sid="GEN 30:18"/>ልያ፥ “ታኒ ታ አይልዉ ታ አዝናስ እምዳ ግሾ፥ ፆሳይ ሄሳ ታዉ ቃንፅስ” ያጋዳ ሄ ናአ ይሳኮራ<note caller="+" style="f"><char style="fr" closed="false">30:18 </char><char style="ft" closed="false">ይሳኮራ ጌተትያ ሱን ብርሸይ “ዳሞዘ” ዎይኮ “ዎይቶ” ጉሱ።</char></note> ጋዳ ሱንሱ።<verse eid="GEN 30:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 30:19"/>ልያ ሀራ ቃንታዳ ኡሱፑን አደ ናአ ያይቆባስ የላሱ። <verse eid="GEN 30:19"/><verse number="20" style="v" sid="GEN 30:20"/>ልያ፥ “ፆሲ ታዉ አልኦ እሞታ እሚስ። ታኒ ታ አዝናስ ኡሱፑን አደ ናይታ የልዳ ግሾ፥ ሀእ እ ታና ቦንቻና” ያጋዳ ሄ ናአ ዛብሎና<note caller="+" style="f"><char style="fr" closed="false">30:20 </char><char style="ft" closed="false">ሀ ሱን ብርሸይ “ቦንቾ” ጉሱ።</char></note> ጋዳ ሱንሱ። <verse eid="GEN 30:20"/><verse number="21" style="v" sid="GEN 30:21"/>ሄሳፈ ጉየ፥ እስ ማጫ ናአ የላሱ፥ እዮ ዲና ጋዳ ሱንሱ።<verse eid="GEN 30:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22"/>ፆሳይ ራሄሎ ቆፕስ። እ ዎሳ ስእድ እ የሎ ኡሉዋ ዶይስ። <verse eid="GEN 30:22"/><verse number="23" style="v" sid="GEN 30:23"/>እያ ቃንታዳ አደ ናአ የላሱ፤ “ፆሳይ ታ ዬላ ቃርስ። <verse eid="GEN 30:23"/><verse number="24" style="v" sid="GEN 30:24"/>ጎዳይ ታዉ ሀራ አደ ናአካ ጉጆ” ያጋዳ ሄ ናአ ዮሰፋ<note caller="+" style="f"><char style="fr" closed="false">30:24 </char><char style="ft" closed="false">ሀ ሱን ብርሸይ “ታዉ ጉጆ” ዎይኮ “ታፐ ቃርስ” ጉሱ።</char></note> ጋዳ ሱንሱ።<verse eid="GEN 30:24"/></para>
  <para style="s1">ያይቆባነ ላባ</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25"/>ራሄላ ዮሰፋ የልዳፐ ጉየ፥ ያይቆብ፥ “ታኒ ታ አዋ ቢታ ስማዳ ባና ታና ሞይዛ። <verse eid="GEN 30:25"/><verse number="26" style="v" sid="GEN 30:26"/>ታኒ ኤንታ ግሾ ነዉ ኦዳ ታ ማቸታነ ታ ናይታ እማ። ታኒ ባና፥ ታኒ ነዉ አይ መላ ኦሶ ኦዳኮ ኔኒ ኤራሳ” ያግስ።<verse eid="GEN 30:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27"/>ሽን ላቢ እያኮ፥ “ታኒ ነዉ እስባ ኦዳይስ፥ ጎዳይ ነ ጋሶን ታና አንጅዳይሳ ታኒ ታ ፆሳፈ ኤራስ። <verse eid="GEN 30:27"/><verse number="28" style="v" sid="GEN 30:28"/>ነ ዳሞዝያ ታዉ ኦዳ፥ ታኒ ነዉ ቃንፃና” ያግስ።<verse eid="GEN 30:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29"/>ያይቆብ፥ “ታኒ ነዉ ዋታ ኦዳኮ፥ ነ መሄትካ ዋን የለትዳኮ ኔኒ ኤራሳ። <verse eid="GEN 30:29"/><verse number="30" style="v" sid="GEN 30:30"/>ታኒ ያናፐ ካሰ ነዉ ደእያ ጉይ ሀእ ሎይ ዳርስ። ጎዳይ ነና ታኒ አዳ በሳ ኡባን አንጅስ። ሽን ሀእ፥ ታኒ ታ ሶ አሳስ ኦና ዎደ” ያግስ።<verse eid="GEN 30:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31"/>ላቢ፥ “ያትን ታኒ ነዉ አይ እሞ?” ያግድ እያ ኦይችስ።</para>
  <para style="p" vid="GEN 30:31">ያይቆብ፥ “ታዉ አይኮካ እሞፋ፥ ኔኒ ታዉ እስባ ኦና ግድኮ፥ ታኒ ነ ዉድያ ሀእካ ሄማናነ ናጋና። <verse eid="GEN 30:31"/><verse number="32" style="v" sid="GEN 30:32"/>ታኒ ሀች ነ ዉደ ኡባ ግዶራ አና። ሄሳን ነ ዶርሳታፐ ዋንጩዋ ዎይኮ ጋዛ፥ ካሬ ማራዘታ ኡባ፥ ዴሻፐ ጋዛነ ዋንጮ ኡባ ታኒ ሻካና፥ ኤንቲ ታ ዳሞዘ ግዶ። <verse eid="GEN 30:32"/><verse number="33" style="v" sid="GEN 30:33"/>ሄሳ ግሾ፥ ታ ፅሎተይ ነ ታዉ ቃንፅዳ ዳሞዝያ በአናዉ ያ ዎደ ታዉ ማርካታና። ታ ዴሻፐ ጋዛ ዎይኮ ፑንጫረ ግዶናባይ ዎይኮ ካሬ ግዶና አይ ዶርሳት ታ ማታን በንትኮ፥ ካይሶተትዳዳ ታይባ” ያግስ።<verse eid="GEN 30:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34"/>ላቢ፥ “ኤሮ፥ ኔኒ ግዳይሳዳ ግዶ” ያግስ። <verse eid="GEN 30:34"/><verse number="35" style="v" sid="GEN 30:35"/>ሽን ሄ ጋላሳን ላቢ ካላደ ዎይኮ ጋዛ ግድዳ ኮሌ ኡባ፥ ዋንጮ ዎይኮ ጋዛ ግድዳ ማጫ ዴሻ ኡባ፥ ቦ ዋንጮ ዴሻታነ ካሬ ዋንጮ ዶርሳታ ኡባ ከስድ ባ አደ ናይታ ሄንስ። <verse eid="GEN 30:35"/><verse number="36" style="v" sid="GEN 30:36"/>ያትድ ሄ ዉድያ ሄ ጋላሳ ኦግያ ያይቆባፐ ሃስድ ኤፍስ። ሽን ያይቆብ አትዳ ላባ ዉድያ ሄምስ።<verse eid="GEN 30:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37"/>ያይቆብ ኦንጋፍረፐ፥ ባርኤፈኔ ላዉዘ ምፈ ፃምአ ከስድ፥ ፖቁዋ ፖቅድ ግዶ ቦ ባጋ ቃርድ ሽሎይስ። <verse eid="GEN 30:37"/><verse number="38" style="v" sid="GEN 30:38"/>ዉደይ ሃ ኡያናዉ ያ ዎደ ጎንገን ዉድያ ስንን ፖቅዳ ፃምአ ዎስ። ብራይስ ከይዳይሳት ሃ ኡያናዉ ይድ፥ <verse eid="GEN 30:38"/><verse number="39" style="v" sid="GEN 30:39"/>ሄ ፃምአታ ስንን ብራይሰቶሶና። ሄ ብራይስዳይሳት ካላደ፥ ዋንጮነ ጋዛ ማራታ የልዶሶና። <verse eid="GEN 30:39"/><verse number="40" style="v" sid="GEN 30:40"/>ያይቆብ ዴሻ ማራታነ ዶርሳ ዉድያፐ ሻክድ ዱማ ዎስ። አትዳ ዉድያ ካላደነ ካሬ ግድያ ላባ መህያኮ ዛሪድ ኤስስ። ያትድ ላባ ዉድያራ ጋና ባ ዉድያ ዱማይድ ዳርስስ።<verse eid="GEN 30:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 30:41"/>ዉድያፐ ጎባ ማጫት ብራይሳስ ከይያ ዎደ ሄ ፃምአታ ማታን ብራይሰታና መላ ያይቆብ ሄ ፃምአታ ሃ ጎንገን መሄታ ስንን ዎስ። <verse eid="GEN 30:41"/><verse number="42" style="v" sid="GEN 30:42"/>ሽን መሄት ላፋ ግድኮ ኤንታ ስንን ፃምአ ዎና። ሄሳ ግሾ፥ ላፋ መሄት ላባባ ግድን ጎባት ያይቆባባ ግድዶሶና። <verse eid="GEN 30:42"/><verse number="43" style="v" sid="GEN 30:43"/>ሄሳዳ ኦድ ያይቆብ ዳሮ ዱረትድ፥ ዳሮ ዉድያ፥ ማጫ አይለታነ አደ አይለታ፥ ዳሮ ግማለታነ ሀረታ ሃርስ።<verse eid="GEN 30:43"/></para>
  <chapter eid="GEN 30"/>
  <chapter number="31" style="c" sid="GEN 31"/>
  <para style="s1">ያይቆብ ላባፐ ባቃቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1"/>ላባ አደ ናይት፥ “ያይቆብ ኑ አዋባ ኡባ ኤክድግስ። ሀ ሻሎ ኡባ ኑ አዋባፐ ደምስ” ያግሽን ያይቆብ ስእስ። <verse eid="GEN 31:1"/><verse number="2" style="v" sid="GEN 31:2"/>ያይቆብ ላባ ሶምኦይ እያዉ ካሰ መላ ግዶናይሳ በእስ።<verse eid="GEN 31:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 31:3"/>ሄ ዎደ ጎዳይ ያይቆባ፥ “ኔኒ ነ አዋታ ቢታ፥ ነ ዳቦታኮ ጉየ ስማ። ታኒ ኔራ ግዳና” ያግስ።<verse eid="GEN 31:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4"/>ያይቆብ ራሄሎነ ልያ ባ ዉደይ ሄመትያ በሳ ያና መላ ኪትድ ፄግስስ። <verse eid="GEN 31:4"/><verse number="5" style="v" sid="GEN 31:5"/>እ ኤንታኮ፥ “ህንተ አዋ ሶምኦይ ታዉ ካሰ መላ ግዶናይሳ ታኒ በአይስ። ሽን ታ አዋ ፆሳይ ታራ ደኤስ። <verse eid="GEN 31:5"/><verse number="6" style="v" sid="GEN 31:6"/>ታኒ ታ ኩመ ዎልቃን ህንተ አዋስ ኦዳይሳ ህንተ ኤሬታ። <verse eid="GEN 31:6"/><verse number="7" style="v" sid="GEN 31:7"/>ሽን ህንተ አዋይ ታና ጭምድ፥ ታ ዳሞዝያ ታሙ ቶሆ ላምስ። ግድኮካ ፆሳይ ታና እ ቆሆናዳ ድግስ። <verse eid="GEN 31:7"/><verse number="8" style="v" sid="GEN 31:8"/>እ፥ ‘ፑንጫረት ነ ዳሞዘ ግዶ’ ግን ዉደ ኡባይ ፑንጫረ የልስ። ቃስ እ፥ ‘ካላደት ነ ዳሞዘ ግዶ’ ግን ዉደ ኡባይ ካላደ የልስ። <verse eid="GEN 31:8"/><verse number="9" style="v" sid="GEN 31:9"/>ፆሳይ ሄሳን ህንተ አዋ መህያ ዎ ኤክድ ታዉ እሚስ።<verse eid="GEN 31:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10"/>“መሄት ብራይሳስ ከይያ አጌናን ታኒ እስ አሙሆ አሙሀስ። ሄ አሙሁዋን ታኒ ፄልያ ዎደ መህያ ብራይስያ ዴሻ ኡርገት ካላደ፥ ፑንጫረነ ጋዛ። <verse eid="GEN 31:10"/><verse number="11" style="v" sid="GEN 31:11"/>ፆሳ ኪታንቾይ አሙሆን ታና፥ ‘ያይቆባ’ ያግስ። ታኒ፥ ‘ዬ’ ጋዳ ኮያስ። <verse eid="GEN 31:11"/><verse number="12" style="v" sid="GEN 31:12"/>እካ፥ ‘ቁ ጋዳ መህያ ብራይስያ ዴሻ ኡርገ ኡባ ካላደ፥ ፑንጫረነ ጋዛ በአ። ላቢ ነ ቦላ ኦያባ ኡባ ታኒ በእዳ ግሾ ሄሳ ኦስ። <verse eid="GEN 31:12"/><verse number="13" style="v" sid="GEN 31:13"/>ኔኒ ኤስዳ ሹቻ ዛይተ ትያዳ ታዉ ጫቅዳ ቤተለ ፆሳይ ታና። ሀእ ደንዳዳ ሀ ቢታፈ ከያ። ጉየ ነ የለትዳ ቢታ ስማ’ ግስ” ያግስ።<verse eid="GEN 31:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14"/>ሄሳፈ ጉየ፥ ራሄልራነ ልያራ “ኑ አዋባፐ ኑና ጋክያባይ አይቤ? <verse eid="GEN 31:14"/><verse number="15" style="v" sid="GEN 31:15"/>እ ኑና አላጋዳ ፄሌስ ግደኔ? እ ኑና ባይዝ ኤክስ። ባይዝ ኤክዳባ ኡባ ምድ ይስስ። <verse eid="GEN 31:15"/><verse number="16" style="v" sid="GEN 31:16"/>ፆሳይ ኑ አዋፐ ዎ ኤክዳ ሻሎ ኡባይ ቱማካ ኑባነ ኑ ናይታባ። ሄሳ ግሾ፥ ፆሳይ ነዉ ኦድዳባ ኡባ ኦ” ያግ ዛርዶሶና።<verse eid="GEN 31:16"/></para>
  <para style="p">
    <verse number="17-18" style="v" sid="GEN 31:17-18"/>ያይቆብ ካናነ ቢታን ደእያ ባ አዋ ይሳቃኮ ባናዉ ደንድስ። እ ባ ናይታነ ባ ማቸታ ግማለ ቶግስስ። ዉደ ኡባ ላግድ፥ ማሰጰፆመን ደእሸ ሺሽዳ ሻሎ ኡባ ኤክድ ብስ። <verse eid="GEN 31:17-18"/><verse number="19" style="v" sid="GEN 31:19"/>ላቢ ባ ዶርሳታ እክስያ ቃንፃናዉ ብዳሽን፥ ራሄላ ባ አዋ ሶ ኤቃ ምስለታ ካይሶታሱ። <verse eid="GEN 31:19"/><verse number="20" style="v" sid="GEN 31:20"/>ቃስ ያይቆብ አራመ አድያ ላባስ ባ ቡሳ ኦዶና እፅድ ጭምስ። <verse eid="GEN 31:20"/><verse number="21" style="v" sid="GEN 31:21"/>እ ባዉ ደእያባ ኡባ ኤክድ ኤለስድ ኤፍራፂሳ ሻፋ ፕንድ፥ ደረይ ዳርያ ጋላዳ ቢታ ብስ።<verse eid="GEN 31:21"/></para>
  <para style="s1">ላቢ ያይቆባ ካልድ ቡሳ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22"/>ሄ ጋላሳፐ ጉየ፥ ያይቆቢ ባቃትድ ብዳይሳ ላቢ ስእስ። <verse eid="GEN 31:22"/><verse number="23" style="v" sid="GEN 31:23"/>ባ ዳቦታ ባራ ኤክድ፥ ላፑን ጋላሳ ኦገ ያይቆባ ጌዶ ካልድ ደረይ ዳርያ ጋላዳ ቢታን እያ ጋክስ። <verse eid="GEN 31:23"/><verse number="24" style="v" sid="GEN 31:24"/>ሄ ዎደ ፆሳይ ቃማ ሶረ ላባኮ አሙሆን ቆንጭድ፥ “ኔኒ ያይቆባ ቦላ ኢታባ ግድን ሎኦባ፥ አይብባካ ኦደትኮ ነና ኤራ” ያግስ። <verse eid="GEN 31:24"/><verse number="25" style="v" sid="GEN 31:25"/>ላቢ ጋክያ ዎደ ያይቆብ ደረይ ዳርያ ጋላዳ ቢታን ዱንካነ ቶክድ ኡትስ። ላብካ ዳቦታራ ያን ዱንካንዶሶና።<verse eid="GEN 31:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 31:26"/>ሄሳፈ ጉየ፥ ላቢ ያይቆባ፥ “ኔኒ ሀይሳዳ ታና አይስ ጭማዲ? ታ ማጫ ናይታካ ኦላን ድኤትዳባዳ አይስ ላጋ ከሳዲ? <verse eid="GEN 31:26"/><verse number="27" style="v" sid="GEN 31:27"/>ኔኒ አይስ ቆሳን ታፐ ከሳ ኤካዳ ታና ጭማዲ? ታኒ ነና ኡፋይሳንነ የን፥ ካራቦንነ ዲን ሞይዛና መላ አይስ ታዉ ኦዳብኪ? <verse eid="GEN 31:27"/><verse number="28" style="v" sid="GEN 31:28"/>ኔኒ ሀር አቶሽን፥ ታ ናይታ ናይታነ ታ ማጫ ናይታ ታኒ ዬራ ኤኮና መላ ድጋዳሳ። ኔኒ ኢታ ኦዳሳ። <verse eid="GEN 31:28"/><verse number="29" style="v" sid="GEN 31:29"/>ታኒ ነና ገናናዉ ታዉ ዎልቅ ደኤስ ሽን ነ አዋ ፆሳይ ዝነ ቃማ ታኮ፥ ‘ያይቆባ ቦላ ኢታባ ግድን ሎኦባ አይብባካ ኦደቶናዳ ነና ኤራ’ ያግድ ታዉ ኦድስ። <verse eid="GEN 31:29"/><verse number="30" style="v" sid="GEN 31:30"/>ሀእ ኔኒ ነ አዋ ሶ ባናዉ ዳሮ ላሞትዳ ግሾ ከያዳሳ። ሽን ታ ሶ ኤቃ ምስለታ አይስ ካይሶታዲ?” ያግስ።<verse eid="GEN 31:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31"/>ያይቆብ ላባ፥ “ኔኒ ነ ናይታ ታፐ ዎልቃን ዎስሳ ኤካነኮነ ጋዳ ቆፕዳ ግሾ ያያዳ ሀይሳዳ ኦስ። <verse eid="GEN 31:31"/><verse number="32" style="v" sid="GEN 31:32"/>ሽን ነ ሶ ኤቃ ምስለታ ኤክዳ አስ ኦናካ ኔኒ ደምኮ፥ ሄ ኡራይ ሀይቆ። ኑ ዳቦታ ስንን ነባ ግድዳባ ኡባ ኮያዳ ኤካ” ያግስ። ያይቆብ ራሄላ ባ አዋ ሶ ኤቃ ምስለታ ካይሶትዳይሳ ኤርቤና።<verse eid="GEN 31:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33"/>ሄሳ ግሾ፥ ላቢ ያይቆባ ዱንካንያ ግዶ፥ ልያ ዱንካንያ ግዶነ ናምኡ አይለታ ዱንካንያ ግዶ ገልድ ኮይስ። ሽን አይኮካ ደምቤና። ልያ ዱንካንያፐ ከይድ፥ ራሄል ዱንካንያ ገልስ። <verse eid="GEN 31:33"/><verse number="34" style="v" sid="GEN 31:34"/>ራሄላ ሶ ኤቃ ምስለታ ኤካዳ ግማለ ኮራ ጋርሳን ቆሳዳ እያ ቦላ ኡታሱ። ላቢ ዱንካንያን ደእያባ ኡባ ፕልግድ ኮይስ። ሽን አይኮካ ደምቤና። <verse eid="GEN 31:34"/><verse number="35" style="v" sid="GEN 31:35"/>ራሄላ ባ አዋ፥ “ታ ጎዳዉ፥ ታና ሀንቀቶፋ። ታኒ ነዉ ደንዳ ኤቃናዉ ዳንዳእከ፥ ታ ኩሸ መቶራ ደአይስ” ያጋሱ። እ ኮይድ ሶ ኤቃ ምስለታ ደምቤና።<verse eid="GEN 31:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 31:36"/>ያይቆብ ይሎትድ ላባኮ፥ “ታኒ አይ ኢሳድና? ሀይሳ ኔኒ ታና ካላናዉ ታ አይ ቆሆ ኦድና? <verse eid="GEN 31:36"/><verse number="37" style="v" sid="GEN 31:37"/>ሀእ ኔኒ ታ ሚሸ ኡባ ፕልጋዳ ኮያዳሳ። ነ ሶ ኤቃ ምስለታፐ አይ ደማዲ? ኤንቲ ኑ ናምአ ግዶን ፕርዳና መላ ነ ዳቦታ ስንንነ ታ ዳቦታ ስንን ሀይሳን ዎ።<verse eid="GEN 31:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 31:38"/>“ታኒ ኔራ ላታሙ ላይ ኩመ ደአስ። ነ ዶርሳትነ ዴሻት አዉጫይቦኮና ዎይኮ ነ ዉድያፐ እሱዋካ ቆታዳ ማብከ። <verse eid="GEN 31:38"/><verse number="39" style="v" sid="GEN 31:39"/>ዶእ ምዳ ጋዉፃካ ታ ነዉ ኤሀ ኤርከ፤ ታኒ ታፐ ጭጋይስ። ጋላስ ዎይኮ ቃማ ካይሶተትዳይሳታ ቃንፅሳሳ። <verse eid="GEN 31:39"/><verse number="40" style="v" sid="GEN 31:40"/>ጋላሳ ሱላን፥ ቃማ ሜጎን ታኒ ቆሄታስ። ማራ ስኮ ስካ ኤርከ። <verse eid="GEN 31:40"/><verse number="41" style="v" sid="GEN 31:41"/>ታኒ ሀይሳዳ ሀናዳ ነ ሶን ላታሙ ላይ ደአስ። ታማነ ኦይዱ ላይ ነ ናምኡ ማጫ ናይታ ግሾ፥ ኡሱፑን ላይ ነ መህያ ግሾ ነዉ ኦስ። ሽን ኔኒ ታ ዳሞዝያ ታሙ ቶሆ ላማዳሳ። <verse eid="GEN 31:41"/><verse number="42" style="v" sid="GEN 31:42"/>ታ አዋ ፆሳይ፥ አብራሃመ ፆሳይ፥ ይሳቃ ፆሳይ ታራ ግዶናባ ግድያኮ፥ ስይ ባይና ኔኒ ታና መላ ኩሸ ከሳ የዳዳሳ። ሽን ፆሳይ ታ መቱዋነ ታ ዳቡርሳ በእድ ዝነ ቃማ ነና ሀንቅስ” ያግስ።<verse eid="GEN 31:42"/></para>
  <para style="s1">ያይቆባነ ላባ ጫቁዋ</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43"/>ላቢ ዛሪድ ያይቆባ፥ “ማጫሳት ታ ማጫ ናይታ፥ ኤንታ ናይት ታ ናይታ፥ ሀ መሄይካ ታ መህያ፥ ኔኒ በእያ ኡባይ ታባ። ሀች ሀ ማጫ ናይታ ቦላነ ኤንታ ናይታ ቦላ አይ ኦናዉ ዳንዳአይና? <verse eid="GEN 31:43"/><verse number="44" style="v" sid="GEN 31:44"/>አነ ሃያ፥ ኔራነ ታራ ዎላ አነ ጫቆስ። ሄስ ነ ግዶንነ ታ ግዶን ማርካ ግዶ” ያግስ።<verse eid="GEN 31:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45"/>ሄሳ ግሾ፥ ያይቆብ እስ ሹቹ ኤክድ ቱሳ ኤስስ። <verse eid="GEN 31:45"/><verse number="46" style="v" sid="GEN 31:46"/>ባ ዳቦታ፥ “ሹቹ ሺሽተ” ያግስ። ኤንቲ ሹቹ ሺሽድ ኬልዶሶና። ሄ ኬላ ማታን ካ ምዶሶና። <verse eid="GEN 31:46"/><verse number="47" style="v" sid="GEN 31:47"/>ላቢ ሄ ኬላ፥ ይጋር-ሳሀዱታ<note caller="+" style="f"><char style="fr" closed="false">31:47 </char><char style="fq" closed="false">ይጋር-ሳሀዱታ፦ </char><char style="ft" closed="false">አራምከ ዶናን “ማርካ ኬላ” ጉሱ።</char></note> ግድ ሱንስ። ያይቆብ ቃስ እያ ጋላዳ<note caller="+" style="f"><char style="fr" closed="false">31:47 </char><char style="fq" closed="false">ጋላዳ፦ </char><char style="ft" closed="false">እብራወ ዶናን “ማርካ ኬላ” ጉሱ።</char></note> ግድ ሱንስ። <verse eid="GEN 31:47"/><verse number="48" style="v" sid="GEN 31:48"/>ላቢ፥ “ሀ ኬላይ ኔፐነ ታፐ ግዶን ሀች ማርካ” ያግስ። ሄሳ ግሾ፥ እያ ሱንይ ጋላዳ ጌተትስ።<verse eid="GEN 31:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="GEN 31:49"/>ላቢ፥ “ኑኒ እሶይ እሱዋፈ ሃክድ ደእያ በሳን ጎዳይ ነናነ ታና ናጎ” ግድ ሄ በሳ ምፅጳ<note caller="+" style="f"><char style="fr" closed="false">31:49 </char><char style="fq" closed="false">ምፅጳ፦ </char><char style="ft" closed="false">እብራወ ዶና ናጎ በሲ ጉሱ።</char></note> ግድ ሱንስ። <verse eid="GEN 31:49"/><verse number="50" style="v" sid="GEN 31:50"/>ላቢ፥ “ኔኒ ታ ማጫ ናይታ ናቅኮ፥ ዎይኮ ኔኒ ታ ማጫ ናይታ ቦላ ሀራ ማቾ ነ ኤክኮ፥ ታ ኤሮና እፅኮካ ነ ግዶንነ ታ ግዶን ፆሳይ ማርካ ግደይሳ አኬካ” ያግስ።<verse eid="GEN 31:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 31:51"/>ላቢ ቃስካ፥ “ኬለትዳ ሹቻይነ ታኒ ነ ግዶንነ ታ ግዶን ኤስዳ ሹቻ ቱሳይ ሀይስሽ። <verse eid="GEN 31:51"/><verse number="52" style="v" sid="GEN 31:52"/>ታኒ ሀ ኬላፐ ነና ገናናዉ ኔኮ ካንናዳ፥ ነካ ታና ገናናዉ ሀ ኬላፐነ ሀ ሹቻ ቱሳፈ ሀ አናዳ ሀ ኬላይነ ሀ ሹቻ ቱሳይ ማርካ። <verse eid="GEN 31:52"/><verse number="53" style="v" sid="GEN 31:53"/>አብራሃመ ፆሳይ፥ ናኮራ ፆሳይ፥ ኤንታ አዋ ፆሳይ፥ ኑ ግዶን ፕርዶ” ያግስ። ያይቆብ ባ አዋ ይሳቃ ፆሳ ሱንን ጫቅስ። <verse eid="GEN 31:53"/><verse number="54" style="v" sid="GEN 31:54"/>ያይቆብ ዙማ ቦላ ያርሾ ያርሽስ። ባ ዳቦታ ካ ማናዉ ፄግስ። ኤንቲ ምድ ዙማ ቦላ አቅዶሶና።<verse eid="GEN 31:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 31:55"/>ዎንተ ጋላስ ጉራ ላቢ ደንድድ ባ ናይታ ናይታነ ባ ማጫ ናይታ አንጅድ፥ ዬርድ ባ ሶ ስምስ።<verse eid="GEN 31:55"/></para>
  <chapter eid="GEN 31"/>
  <chapter number="32" style="c" sid="GEN 32"/>
  <para style="s1">ያይቆባነ ኤሳዌ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1"/>ያይቆብ ደንድድ ባ ኦግያ ብሽን ፆሳ ኪታንቾት እያራ ጋሄትዶሶና። <verse eid="GEN 32:1"/><verse number="2" style="v" sid="GEN 32:2"/>ያይቆብ ኤንታ በእዳ ዎደ “ሀይሳቲ ፆሳ ኦላንቾታ” ያግድ፥ ሄ በሳ ማሀናይማ (ናምኡ ጉታ) ግድ ሱንስ።<verse eid="GEN 32:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3"/>ያይቆብ ኤዶመ ቢታን ሳይረ ግያ በሳን ደእያ ባ እሻ ኤሳዌኮ ኪታ ባፐ ስን ኪትስ። <verse eid="GEN 32:3"/><verse number="4" style="v" sid="GEN 32:4"/>እ ኤንታ፥ “ህንተ ታ ጎዳ ኤሳዌስ ጋናባይ ሀይሳ፥ ‘ታኒ ነ አይለይ ያይቆብ ሀእ ጋካናው ላባ ማታን ጋምአስ። <verse eid="GEN 32:4"/><verse number="5" style="v" sid="GEN 32:5"/>ታዉ ሚዝ፥ ሀረይ፥ ዶርስነ ዴሽ፥ አደ አይለትነ ማጫ አይለት ደኦሶና። ሀእ ታኒ ሀ ኪታ ታ ጎዳ ስንን ሳባ ደማንድናሻ ጋዳ ኪታስ ያግስ’ ያግተ” ያግድ ኪትስ።<verse eid="GEN 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6"/>ኪተትዳይሳት ያይቆባኮ ስሚድ፥ “ኑኒ ነ እሻ ኤሳዌኮ ብዳ። እካ ቃስ ኔራ ጋሄታናዉ ዬስ። እያራ ኦይዱ ፄቱ አሳይ ደኦሶና” ያግዶሶና።<verse eid="GEN 32:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 32:7"/>ያይቆብ ዳሮ ባብድ ባራ ደእያ አሳ ናምኡ ጩጋን ሻክስ። ባ ዶርሳ፥ ዴሻ፥ ሚዛነ ግማለታ ናምኡ ጩጋን ሻክስ። <verse eid="GEN 32:7"/><verse number="8" style="v" sid="GEN 32:8"/>እ፥ “ኤሳዌይ ይድ እስ ጩጋ ኦልያባ ግድኮ፥ አትዳ ጩጋይ ከስ ኤካና” ግድ ቆፕስ።<verse eid="GEN 32:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9"/>ሄ ዎደ ያይቆብ ሀይሳዳ ያግድ ዎስስ፥ “አቤት ጎዳዉ፥ ታ አዋ አብራሃመ ፆሳዉ፥ ታ አዋ ይሳቃ ፆሳዉ፥ ታና፥ ‘ነ ቢታ፥ ነ ዳቦታኮ ስማ፥ ታኒ ነዉ ሎኦባ ኦና ግዳይሶ፥ ታና ስአርክ’፥ <verse eid="GEN 32:9"/><verse number="10" style="v" sid="GEN 32:10"/>ኔኒ ነ አይልያስ ኬህዳባስነ አማነተ ኡባስ ታኒ በሶና አስ። ታኒ ዮርዳኖሰ ሻፋ ፕንያ ዎደ ታዉ እስ ፃምአ ፃላል ደኤስ፤ ሽን ሀእ ታኒ ናምኡ ጩጋ ጎዳ ግዳስ። <verse eid="GEN 32:10"/><verse number="11" style="v" sid="GEN 32:11"/>ታኒ ነና ዎሳይስ ታ እሻ ኤሳዌ ኩሸፐ ታና አሻ። እ ይድ፥ ታናነ አየታ ኤንታ ናይታራ ይሶና አገና ጋዳ ያያይስ። <verse eid="GEN 32:11"/><verse number="12" style="v" sid="GEN 32:12"/>ሽን ኔኒ ታና፥ ‘ታኒ ነዉ ቱማ ሎኦባ ኦና። ታኒ ነ ሼሻ ታይባናዉ ዳንዳኤቶና አባ ሻፈዳ ኦና’ ግዳይሳ ቆፓ” ያግስ።<verse eid="GEN 32:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13"/>ሄ ጋላስ ቃማ እ ያን አቅስ። ባዉ ደእያባ ኡባፈ ባ እሻ ኤሳዌስ እማናባ ቆርድ ከስስ። <verse eid="GEN 32:13"/><verse number="14-15" style="v" sid="GEN 32:14-15"/>እ፥ ናምኡ ፄቱ ማጫ ዴሻታነ ላታሙ ዴሻ ማራዘታ፥ ናምኡ ፄቱ ማጫ ዶርሳታነ ላታሙ ዶርሳ ማራዘታ፥ ሀስታሙ ንያ ግማለታ ኤንታ ማራታራ፥ ኦይታሙ ማጫ ሚዛታ፥ ታሙ ኮርማ ቦራታ፥ ላታሙ ማጫ ሀረታነ ታሙ አደ ሀረታ ቆርድ ከስስ። <verse eid="GEN 32:14-15"/><verse number="16" style="v" sid="GEN 32:16"/>ሄሳታ ዉደን ዉደን ሻክድ ባ አይለታስ እምድ፥ “ታፐ ስን ብድ ዉድያ ዉድያፐ ሃሆን ሃሆን ላግተ” ያግስ።<verse eid="GEN 32:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17"/>ስንን ካለይሳ፥ “ታ እሻይ ኤሳዌይ ኔራ ጋሄትድ፥ ‘ኔኒ ኦደሴ? ኔኒ አዉ ባይ? ነ ስንን ደእያ መሄ ኡባይ ኦደባዬ?’ ያግድ ኦይችኮ፥ <verse eid="GEN 32:17"/><verse number="18" style="v" sid="GEN 32:18"/>ነ እያኮ፥ ‘ሀይሳቲ ነ አይልያ ያይቆባሳ፥ እ ታ ጎዳ ኤሳዌስ እማናዉ የድዳይሳታ። እካ ኑፐ ጉየራ ዬስ’ ያጋ” ያግድ ኪትስ።<verse eid="GEN 32:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 32:19"/>ቃስ ናምአንዋ፥ ሄንዋነ ዉድያ ካልያ ሀራታ ኡባ፥ “ህንተ ኤሳዌራ ጋሄትያ ዎደ ሀይሳዳ ጌታ፤ <verse eid="GEN 32:19"/><verse number="20" style="v" sid="GEN 32:20"/>‘ነ አይልያ ያይቆብ ኑፐ ጉየራ ዬስ’ ጎና አጎፍተ” ያግድ ኪትስ። እ፥ “ታኒ እማናዉ ስን የድዳይሳን እያ እርፅሳና። ኦን ኤር ሄሳፈ ጉየ፥ ታኒ እያራ ጋሄትያ ዎደ እ ታና ሞክ ኤካና” ያግድ ቆፕስ። <verse eid="GEN 32:20"/><verse number="21" style="v" sid="GEN 32:21"/>ሄሳ ግሾ፥ ባ እማናባ ባፐ ስን የድስ። ሽን እ ባ ሁጰን ሄ ጋላስ ቃማ ያን አቅስ።<verse eid="GEN 32:21"/></para>
  <para style="s1">ያይቆብ ፆሳራ ባፀቱዋ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22"/>ሄ ቃማ ያይቆብ ደንድድ፥ ባ ናምኡ ማቸታ፥ ባ ናምኡ አይለታ፥ ባ ናይታ ታማነ እሶታ ኤክድ፥ ያቦቃ ሻፋ ፕንስ። <verse eid="GEN 32:22"/><verse number="23" style="v" sid="GEN 32:23"/>እ ኤንታ ሻፋ ፕን ስሚድ ባዉ ደእያባ ኡባ ፕንድ የድስ። <verse eid="GEN 32:23"/><verse number="24" style="v" sid="GEN 32:24"/>ሽን ያይቆብ ባርካ ጉየ አትስ።</para>
  <para style="p" vid="GEN 32:24">ሄ ዎደ እስ አስ ሳእ ዎንታና ጋካናስ እያራ ባፀትሸ አቅስ። <verse eid="GEN 32:24"/><verse number="25" style="v" sid="GEN 32:25"/>ሄ ኡራይ እያ ፆናናዉ ዳንዳኦናይሳ በእዳ ዎደ ያይቆባስ ቡልፅያ መቀ ቦችን፥ እያ ቡልፀይ ከሱዋፐ ከይስ። <verse eid="GEN 32:25"/><verse number="26" style="v" sid="GEN 32:26"/>ያትን ኡራይ እያ፥ “ሳእ ዎንታና ሀንያ ግሾ፥ ታና የዳ” ያግስ።</para>
  <para style="p" vid="GEN 32:26">ሽን ያይቆብ፥ “ኔኒ ታና አንጆና ነና የድከ” ያግስ።<verse eid="GEN 32:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27"/>ኡራይ፥ “ነ ሱንይ ኦኔ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="GEN 32:27">እ ዛሪድ፥ “ያይቆባ” ያግስ።<verse eid="GEN 32:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28"/>ኡራይ፥ “ኔኒ ፆሳራነ አሳራ ባፀታዳ ፆንዳ ግሾ፥ ህዛፐ ነ ሱንይ ያይቆባ ጌተቶፎ፥ እስራኤለ (ፆሳራ ባፀትስ) ጌተቶ” ያግስ።<verse eid="GEN 32:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29"/>ያይቆብ ኡራ፥ “ነ ሱንይ ኦኔ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="GEN 32:29">ሽን ኡራይ፥ “ኔኒ ታ ሱን አይስ ኦይቻይ?” ያግድ እያ አንጅስ።<verse eid="GEN 32:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30"/>ሄሳ ግሾ፥ ያይቆብ፥ “ታኒ ፆሳ ሶምኦን በአስ ሽን ፓፃ ደአይስ” ያግድ፥ ሄ በሳ ጵንኤላ (ፆሳ ሶምኦ) ግድ ሱንስ። <verse eid="GEN 32:30"/><verse number="31" style="v" sid="GEN 32:31"/>እ ጵንኤላፐ ደንድያ ዎደ እያ ቦላ ፃልቀይ ዶልስ። እያ ቡልፀ ከሳይ ሳክያ ግሾ ዶጌስ። <verse eid="GEN 32:31"/><verse number="32" style="v" sid="GEN 32:32"/>ያይቆባ ቡልፀይ ዎድረ አሹዋ ማታን ቦሸትዳ ግሾ፥ እስራኤለ አሳይ መሄስ ቡልፀ አሾ ሀች ጋካናዉ ሞኮና።<verse eid="GEN 32:32"/></para>
  <chapter eid="GEN 32"/>
  <chapter number="33" style="c" sid="GEN 33"/>
  <para style="s1">ያይቆብ ኤሳዌራ ጋሄተ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1"/>ያይቆብ ቁ ግድ ፄልያ ዎደ ኤሳዌይ ባ ኦይዱ ፄቱ አሳራ የይሳ በእስ። ሄሳ ግሾ፥ ናይታ ልያስ፥ ራሄልስነ ናምኡ አይለታስ ሻክ እሚስ። <verse eid="GEN 33:1"/><verse number="2" style="v" sid="GEN 33:2"/>አይለታነ ኤንታ ናይታ ስንን፥ ልያነ እ ናይታ ኤንታ ጌዶን፥ ራሄሎነ ዮሰፋ ዉርሰን ዎስ። <verse eid="GEN 33:2"/><verse number="3" style="v" sid="GEN 33:3"/>ሽን እ ባዉ ስን አድ ባ እሻኮ ማትሸ ሳአ ጋክ ጋክ ላፑንቶሆ ዝግስ።<verse eid="GEN 33:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 33:4"/>ሽን ኤሳዌይ እያራ ጋሄታናዉ ዎፅ ይድ እያ ቆያ ቆምድ ዬርስ። ናምአይካ ዬክዶሶና። <verse eid="GEN 33:4"/><verse number="5" style="v" sid="GEN 33:5"/>ኤሳዌይ ቁ ግድ ፄልድ ማጫሳታነ ናይታ በእድ፥ “ሀ ኔራ ደኤይሳት ኦናንቴ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="GEN 33:5">ያይቆብ፥ “ታ ጎዳዉ፥ ሀይሳቲ ፆሳይ ነ አይልያስ ባ ኬሀተን እምዳ ናይታ” ያግስ። <verse eid="GEN 33:5"/><verse number="6" style="v" sid="GEN 33:6"/>አይለት ባንታ ናይታራ ሺቅድ እያዉ ዝግዶሶና። <verse eid="GEN 33:6"/><verse number="7" style="v" sid="GEN 33:7"/>ካልድ ልያራነ እ ናይታራ ይድ ዝግዶሶና። ዉርሰን ዮሰፋራነ ራሄልራ ይድ ዝግዶሶና።<verse eid="GEN 33:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8"/>ኤሳዌይ፥ “ሀ ስንን ብሸ ታራ ጋሄትዳ ዉደይ ኡባይ አይቤ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="GEN 33:8">ያይቆብ፥ “ታ ጎዳዉ፥ ሄስ ታኒ ነ ስንን ሳባ ደማናዉ የድዳይሳታ” ያግስ።<verse eid="GEN 33:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9"/>ሽን ኤሳዌይ፥ “ታ እሻዉ፥ ታዉ ግድያ ሻሎይ ደኤስ፥ ነባይ ነዉ ግዶ” ያግስ።<verse eid="GEN 33:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10"/>ያይቆብ፥ “ሀያና፥ ሀእ ታኒ ነ ስንን ሳባ ደምዳባ ግድኮ፥ ሀ ታኒ እመይሳ ኤካ። ኔኒ ታና ሞካ ኤክዳ ግሾ፥ ታ ነ ሶምኡዋ በኤይስ ፆሳ ሶምኦ በኤይሳ መላ። <verse eid="GEN 33:10"/><verse number="11" style="v" sid="GEN 33:11"/>ታኒ ነዉ ኤህዳ ሀ እሞታ ኤካ። ፆሳይ ታዉ ኬህ እምዳ ግሾ ኩምስ” ያግስ። ያይቆብ ዎስድ አጎና እፅዳ ግሾ፥ ኤሳዌይ እያ እሞታ ኤክስ።<verse eid="GEN 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12"/>ኤሳዌይ፥ “አነ የ፥ ታኒ ኔራ እስፈ ባና” ያግስ።<verse eid="GEN 33:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13"/>ሽን ያይቆብ፥ “ታ ጎዳዉ፥ ናይት ሹጎ ግደይሳ ኤራሳ። ቃስ ታኒ ጋሎ ማራታ ንያ ዶርሳታነ ሚዛ ናጋናዉ ኮሼስ። አሳይ ኤንታ ሀር አቶሽን፥ እስ ጋላስ ምን ላግኮ፥ መሄ ኡባይ ሀይቃና። <verse eid="GEN 33:13"/><verse number="14" style="v" sid="GEN 33:14"/>ሄሳ ግሾ፥ ታ ጎዳዉ፥ ነ አይለታፐ ስንታዳ ባ። ታኒ ሳይረን ታ ጎዳ ጋካናስ፥ ታ ስንን ደእያ መህያነ ናይታ ሄመ መላ ሎዳን ካላዳ ታ ጎዳ ታኒ ኤዶመን ጋካና” ያግስ።<verse eid="GEN 33:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15"/>ኤሳዌይ፥ “ያንኮ፥ ታኒ ታ አሳፐ ጉራ ነዉ አሾ” ያግስ።</para>
  <para style="p" vid="GEN 33:15">ሽን ያይቆብ፥ “ኮሸና፤ ታኒ ታ ጎዳ ስንን ሳበትዳይስ ታዉ ግዳና” ያግስ።<verse eid="GEN 33:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16"/>ሄሳ ግሾ፥ ኤሳዌይ ሄ ጋላስ ኦገን ዎድ ሳይረ ስምስ። <verse eid="GEN 33:16"/><verse number="17" style="v" sid="GEN 33:17"/>ሽን ያይቆብ ሱኮታ ብስ። ያን ባዉ ኬ ኬፅስ፥ ባ መሄታስ ሻቃራ ሻቃርስ። ሄሳ ግሾ፥ ሄ በሳ ሱኮታ (ኩያ ዎይኮ ጋባ) ግድ ሱንስ።<verse eid="GEN 33:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18"/>ያይቆብ ማሰጰፆመፐ ስሚድ ካናነ ቢታን ደእያ ሴከማ ካታማ ሳሮን ጋክስ። እ ሄ ካታማስ ስን ባጋራ ዱንካነ ቶክድ ኡትስ። <verse eid="GEN 33:18"/><verse number="19" style="v" sid="GEN 33:19"/>ባ ዱንካንያ ቶክዲ ኡትዳ ጋድያ ሴከማ አዋ ሀሞራ ናይታፐ እስ ፄቱ ብራ ሳንትመን ሻምስ። <verse eid="GEN 33:19"/><verse number="20" style="v" sid="GEN 33:20"/>ያን ያርሾ በሲ ጊግስድ፥ “ጎዳ፥ እስራኤለ ፆሳ” ግድ ሱንስ።<verse eid="GEN 33:20"/></para>
  <chapter eid="GEN 33"/>
  <chapter number="34" style="c" sid="GEN 34"/>
  <para style="s1">ሴከማነ ዲና</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1"/>ልያ ያይቆባስ የልዳ ናእያ ዲና፥ ሄ ዎደ ካናነ ማጫሳታ በአናዉ ከያሱ። <verse eid="GEN 34:1"/><verse number="2" style="v" sid="GEN 34:2"/>ሄ ቢታ ሃርያ ህወ አድያ ሀሞራ ናአ ሴከም እዮ በእድ፥ ዳፍድ ኢስስ። <verse eid="GEN 34:2"/><verse number="3" style="v" sid="GEN 34:3"/>እያ ዎዛናይ ያይቆባ ናእዉ ዲናስ ቃትስ። እ እዉ ምሸትዳ ግሾ ሎኦ ቃላራ እዮ ኦድስስ። <verse eid="GEN 34:3"/><verse number="4" style="v" sid="GEN 34:4"/>ሴከም ባ አዋ ሀሞራ፥ “ታዉ ሀ ናእዉ ማቾ ኦይቻርክ” ያግስ።<verse eid="GEN 34:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5"/>ያይቆብ ባ ናእዉ፥ ዲና፥ አዝን ዳፍዳይሳ ስእዳ ዎደ እያ አደ ናይት መሄራ ባዞን ደኦሶና። ሄሳ ግሾ፥ ኤንቲ ያና ጋካናስ ስእ ግስ።<verse eid="GEN 34:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 34:6"/>ሄሳፈ ጉየ፥ ሴከማ አዋ ሀሞር ያይቆባ ኦድሳናዉ ይስ። <verse eid="GEN 34:6"/><verse number="7" style="v" sid="GEN 34:7"/>ያይቆባ አደ ናይት ባዞፈ ይድ ሄሳ ስእዶሶና። ኤንቲ ሴከም ያይቆባ ናእዉ ዳፍድ፥ ኢስድ እስራኤለ ዬላይዳ ግሾ ዳሮ ይሎትዶሶና።<verse eid="GEN 34:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 34:8"/>ሽን ሀሞር ኤንታኮ፥ “ታ ናአይ ሴከም ህንተ ናኤስ ዳሮ ምሸቴስ፥ ሀያና እዮ እያዉ ማቾ እመርከት። <verse eid="GEN 34:8"/><verse number="9" style="v" sid="GEN 34:9"/>ኑራ ኤከትተነ ገለትተ፥ ህንተ ማጫ ናይታ ኑስ እምተ፥ ኑ ማጫ ናይታካ ህንተዉ ኤክተ። <verse eid="GEN 34:9"/><verse number="10" style="v" sid="GEN 34:10"/>ህንተ ኑ ግዶን ዳናዉ ዳንዳኤታ። ቢታይ ዳሮ ዳልጋ፥ እያ ኦድ ዛልእድ ህንተዉ አቆ ደማናዉ ዳንዳኤታ” ያግስ።<verse eid="GEN 34:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11"/>ሄ ዎደ ሴከም ዲና አዋነ እ እሻታ፥ “ታኒ ህንተ ስንን ሳበትኮ፥ ህንተ ኮይያባ አይብባ ግድኮካ እማና። <verse eid="GEN 34:11"/><verse number="12" style="v" sid="GEN 34:12"/>ህንተ ምሽራ ናኤስ እሞታነ ኮይታ ህንተ ኮይዳ መላ ታና ኦይችተ። ታኒ ህንተ ታና ኦይችዳባ ኡባ እማና። ሽን ታኒ ማቻናዉ ናእዉ ታዉ እመርከት” ያግስ።<verse eid="GEN 34:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13"/>ባንታ ምችዉ ዲና ሴከም ቱንስዳ ግሾ፥ ያይቆባ አደ ናይት ሴከማስነ እያ አዋ ሀሞራስ ዎርዶትዶሶና። <verse eid="GEN 34:13"/><verse number="14" style="v" sid="GEN 34:14"/>ኤንታኮ፥ “ኑኒ ሄሳ መላ ፓላባ ኦናዉ ዳንዳኦኮ፥ ኑኒ ኑ ምችዉ ቃፃረትቦና አሳስ እሞኮ፥ ሄስ ኑና ካዉሽያባ። <verse eid="GEN 34:14"/><verse number="15" style="v" sid="GEN 34:15"/>ህንተ ኑስ እስባ ኤሮ ጊኮ ኑ ህንተዉ ኤሮ ጋና። ሄስካ፥ ህንተ ቢታ አደ አሳ ኡባይ ቃፃረትድ ኑዳ ሀንኮ፥ <verse eid="GEN 34:15"/><verse number="16" style="v" sid="GEN 34:16"/>ኑኒ ኑ ማጫ ናይታ ህንተዉ እማናዉ ኤሮ ጋና። ህንተ ማጫ ናይታካ ኑስ ኤካና። ኑኒ ህንተ ግዶን ደእድ ህንተራ እስ አሰ ግዳና። <verse eid="GEN 34:16"/><verse number="17" style="v" sid="GEN 34:17"/>ሽን ህንተ ቃፃረታናዉ ኤሮ ጎና እፅኮ፥ ኑኒ ኑ ምችዉ ኤክ ባና” ያግዶሶና።<verse eid="GEN 34:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18"/>ያትን ሀ ኤንቲ ግዳባይ ሀሞራስነ እያ ናአ ሴከማስ ሎኦ ዳንስ። <verse eid="GEN 34:18"/><verse number="19" style="v" sid="GEN 34:19"/>ሄ ፓንይ ባ አዋ ኬን ደእያ ኡባፈ አድ ቦንቸትዳ ግሾ ኮይዳባ ኦናዉ እያዉ ማት ደኤስ። ያይቆባ ናእዉ ዳሮ ዶስዳ ግሾ፥ ኤንቲ ግዳባ ኦናዉ ጉየ ግቤና። <verse eid="GEN 34:19"/><verse number="20" style="v" sid="GEN 34:20"/>ሄ ዎደ ሀሞርነ እያ ናአይ ሴከም ባንታ ካታማ ዳባባ ብድ፥ ባንታ ካታማ አሳስ ሀይሳዳ ያግድ ኦድዶሶና። <verse eid="GEN 34:20"/><verse number="21" style="v" sid="GEN 34:21"/>“ሀ አሳት ኑራ ስጋ ደኦሶና። ቢታይ ዳሮ ዳልጋ ግድያ ግሾ ኤንቲ ሀ ቢታን ጎዮ ዛልኦ። ኤንታ ማጫ ናይታካ ኑኒ ኤካና፥ ኤንትካ ኑ ማጫ ናይታ ኤኮና። <verse eid="GEN 34:21"/><verse number="22" style="v" sid="GEN 34:22"/>ሽን ኑራ ኤንቲ እስ አሳዳ ደአናዉ ኑኒ እስባ ኤሮ ጋናዉ ኮሼስ። ሄስካ፥ ኤንቲ ቃፃረትዳይሳዳ ኑ አደ አሳ ኡባይ ቃፃረታናይሳ። <verse eid="GEN 34:22"/><verse number="23" style="v" sid="GEN 34:23"/>ኑኒ ሄሳዳ ኦኮ፥ ኤንታ መሄይነ፥ ኤንታ አቆ ኡባይ ኑባ ግደኔ? ሄሳ ግሾ፥ አነ ኑኒ ኤንቲ ገይሳ ኤሮ ጎስ። ኤንትካ ኑ ግዶን ደአና” ያግዶሶና።<verse eid="GEN 34:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 34:24"/>ካታማ ዳባባ ሺቅዳ አሳት ኡባይ ሀሞራስነ እያ ናአ ሴከማስ፥ “ኤሮ” ግዶሶና። ያትን ሄ ካታማ አደ አሳት ኡባይ ቃፃረትዶሶና።<verse eid="GEN 34:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25"/>ሄን ጋላስ፥ ኤንቲ ኡባይ ባንታ ቃፃራ ማዱን ሳከትሽን፥ ያይቆባ አደ ናይታፐ ናምአይ፥ ዲና እሻት፥ ስሞናራነ ሌወራ ባንታ ማሻ ኤክድ ኦንካ ኤሮና ካታማ ገልድ አደ አሳ ኡባ ዎዶሶና። <verse eid="GEN 34:25"/><verse number="26" style="v" sid="GEN 34:26"/>ሀሞራነ እያ ናአ ሴከማ ማሻን ዎድ፥ ባንታ ምችዉ ዲና ሴከማ ኬፈ ኤክ ብዶሶና። <verse eid="GEN 34:26"/><verse number="27" style="v" sid="GEN 34:27"/>ያይቆባ ሀራ አደ ናይት አሀታ ቦላ ገልድ ባንታ ምችዉ ዲና ቱንስዳ ካታማ ኡባ ቦንቅዶሶና። <verse eid="GEN 34:27"/><verse number="28" style="v" sid="GEN 34:28"/>ኤንታ ዶርሳ ዉድያ፥ ሚዛ ዉድያ፥ ሀርያ፥ ካታማ ግዶን ደእያባነ ጋፃን ደእያባ ኡባ ኤክዶሶና። <verse eid="GEN 34:28"/><verse number="29" style="v" sid="GEN 34:29"/>ኤንታ ኬን ደእያ አቁዋ ኡባ፥ ኤንታ ናይታ ኡባነ ማጫሳታ ኡባ ድእዶሶና።<verse eid="GEN 34:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30"/>ያይቆብ ስሞናነ ሌወ፥ “ህንተ ታ ቦላ ግታ መቶ ኤህደታ። ሀ ቢታን ደእያ ካናነትነ ፓርዘት ታና እፃና። ኑኒ ታይቦን ጉ፥ ኤንቲ እስፈ ግድድ ታ ቦላ ደንድኮ፥ ታንነ ታ ሶ አሳይ ያና” ያግስ።<verse eid="GEN 34:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31"/>ሽን ኤንቲ፥ “ያትን፥ እ ኑ ምችዉ ላይማ ማጫሳዳ ኦናዉ በሲ?” ያግዶሶና።<verse eid="GEN 34:31"/></para>
  <chapter eid="GEN 34"/>
  <chapter number="35" style="c" sid="GEN 35"/>
  <para style="s1">ያይቆብ ቤተለ ስሙዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1"/>ሄሳፈ ጉየ፥ ፆሳይ ያይቆባ፥ “ደንዳዳ ፑደ ቤተለ ከያዳ ያን ደአ። ኔኒ ነ እሻ ኤሳዌፐ ባቃትዳ ዎደ ነዉ ቆንጭዳ ፆሳስ ያን ያርሾ በሲ ጊግሳ” ያግስ።<verse eid="GEN 35:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2"/>ሄሳ ግሾ፥ ያይቆብ ባ ሶ አሳነ እያራ ደኤይሳታ ኡባ፥ “ህንተ ግዶን ደእያ አላጋ ፆሳታ ድግተ። ህንተና ጌሽተ፥ ህንተ ማኡዋ ላምተ። <verse eid="GEN 35:2"/><verse number="3" style="v" sid="GEN 35:3"/>ሀይሳፈ ደንድድ ፑደ ቤተለ ቦስ። ታ መቱዋ ጋላስ ታዉ ስእዳ፥ ታኒ ብዳ በሳ ኡባን ታራ ግድዳ ፆሳስ ታኒ ያን ያርሾ በሲ ጊግሳና” ያግስ። <verse eid="GEN 35:3"/><verse number="4" style="v" sid="GEN 35:4"/>ኤንቲ ባንታዉ ደእያ አላጋ ፆሳታ ኡባነ ባንታ ሀይን አዳ ዎርቃታ ኡባ ከስድ ያይቆባስ እምዶሶና። ያይቆብ ሄሳታ ሴከማን ደእያ ዎላ ጋርሳን ሞግስ።<verse eid="GEN 35:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 35:5"/>ሄሳፈ ጉየ፥ ያይቆብነ እያ አደ ናይት ደንድድ ብያደ ኤንታ ዩሹዋን ደእያ አሳ ቦላ ፆሳ ያሻይ ዎዳ ግሾ ኤንታና ካልድ ኦይካናዉ ኦንካ ዳንዳእቤና።<verse eid="GEN 35:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 35:6"/>ያይቆብነ እያራ ደእያ አሳ ኡባይ ካናነ ቢታን ደእያ ቤተለ ጌተትያ ሎዛ ጋክዶሶና። <verse eid="GEN 35:6"/><verse number="7" style="v" sid="GEN 35:7"/>ያን እ ያርሾ በሲ ጊግስስ። እ ሄ በሳ ኤል-ቤተለ (ቤተለ ፆሳ) ግድ ሱንስ። እ ባ እሻፐ ባቃትድ ብያ ዎደ ፆሳይ እያዉ ቆንጭዳይ ሄ በሳና።<verse eid="GEN 35:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 35:8"/>እርብቃ ድችያ ድቦራ ያን ሀይቃሱ። ቤተለፐ ጋርሳራ ደእያ ዎላ ጋርሳን እያ ሞገታሱ። ሄሳ ግሾ፥ ሄ ም ሱንይ አሎን-ባኩተ (ዬሆ ዎላ) ጌተትስ።<verse eid="GEN 35:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9"/>ያይቆብ ማሰጰፆመፐ ስምዳፐ ጉየ፥ ፆሳይ እያዉ ዛር ቆንጭድ እያ አንጅስ። <verse eid="GEN 35:9"/><verse number="10" style="v" sid="GEN 35:10"/>ፆሳይ፥ “ነ ሱንይ ያይቆባ። ሽን ህዛፐ ኔኒ ያይቆባ ጌተታካ፥ ነ ሱንይ እስራኤለ ጌተታና” ያግድ እያ “እስራኤለ” ግድ ሱንስ።<verse eid="GEN 35:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 35:11"/>ቃስ ፆሳይ ያይቆባ፥ “ታኒ ኡባ ዳንዳእያ ፆሳ። ኔኒ የለታ፥ ዳራ። ደረይነ ካዎተት ኔፐ ከዮ። ካዎትካ ነ ጉልባታፐ ከዮ። <verse eid="GEN 35:11"/><verse number="12" style="v" sid="GEN 35:12"/>ታኒ አብራሃመስነ ይሳቃስ እምዳ ቢታ፥ ነዉ እማና። ኔፐ ጉየ ታኒ ሀ ቢታ ነ ሼሻስ እማና” ያግስ። <verse eid="GEN 35:12"/><verse number="13" style="v" sid="GEN 35:13"/>ፆሳይ እያራ ኦደትዳ በሳፈ ፑደ ከይስ።<verse eid="GEN 35:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 35:14"/>ያይቆብ ፆሳይ እያራ ኦደትዳ በሳን ቆፍስያ ሹቻ ማላ ኤስድ እያ ቦላ ዎይንያነ ዛይተ ትግስ። <verse eid="GEN 35:14"/><verse number="15" style="v" sid="GEN 35:15"/>ያይቆብ ፆሳይ እያራ ኦደትዳ በሳ “ቤተለ” ግድ ሱንስ።<verse eid="GEN 35:15"/></para>
  <para style="s1">ራሄል ሀይቁዋ</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16"/>ኤንቲ ሄሳፈ ጉየ፥ ቤተለፐ ደንድድ ብዶሶና። ኤንቲ ኤፍራታ ጋካናዉ ጉ አትሽን፥ ራሄሎ እቀ ኦይክን ዳሮ ዋየታሱ። <verse eid="GEN 35:16"/><verse number="17" style="v" sid="GEN 35:17"/>እቀይ እዮ ዋይስዳ ዎደ እዮ የልስያራ፥ “ባቦፋ፤ ሀይስካ አደ ናአ” ያጋሱ። <verse eid="GEN 35:17"/><verse number="18" style="v" sid="GEN 35:18"/>ሽን እያ ሀይቆስ ማታዳ ሸምፖይ ከያና ሀንሽን፥ ባ ናአ በኖና (መቶ ናአ) ጋዳ ሱንሱ። ሽን እያ አዋይ ብንያመ (ታ ኡሻቻ) ግድ ሱንስ።<verse eid="GEN 35:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19"/>ሄሳፈ ጉየ፥ ራሄላ ሀይቃ አጋሱ። ቤተለመ ጌተትያ ኤፍራታ ኤፍያ ኦግያ ጋፃን ሞገታሱ። <verse eid="GEN 35:19"/><verse number="20" style="v" sid="GEN 35:20"/>ያይቆብ እ ዱፉዋ ቦላ ሀዉልተ ሹቹ ኤስስ። ሄ ሀዉልተይ ሀች ጋካናዉካ ራሄል ዱፉዋ ኤርሴስ።<verse eid="GEN 35:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 35:21"/>እስራኤለይ ሄሳፈ ደንድድ ኤደራ ግምብያፈ ሄፍንን ባ ዱንካንያ ቶክስ። <verse eid="GEN 35:21"/><verse number="22" style="v" sid="GEN 35:22"/>እስራኤለይ ሄ ቢታን ደእሽን፥ ሮቤል ባ አዋስ የልዳ አይለ ባልራ አቅስ። እስራኤለይ ሄ ኦዳ ስእስ።</para>
  <para style="p" vid="GEN 35:22">ያይቆባ አደ ናይት ታማነ ናምአ። <verse eid="GEN 35:22"/><verse number="23" style="v" sid="GEN 35:23"/>ልያ ናይት ያይቆባ ባይራ ናአ ሮቤላ፥ ስሞና፥ ሌወ፥ ይሁዳ፥ ይሳኮራነ ዛብሎና። <verse eid="GEN 35:23"/><verse number="24" style="v" sid="GEN 35:24"/>ራሄል አደ ናይት ዮሰፋነ ብንያመ። <verse eid="GEN 35:24"/><verse number="25" style="v" sid="GEN 35:25"/>ራሄል አይለ ባል አደ ናይት ዳነነ ንፍታለመ። <verse eid="GEN 35:25"/><verse number="26" style="v" sid="GEN 35:26"/>ልያ አይለ ዛላፋ አደ ናይት ጋደነ አሴራ። ሀ ናይት ያይቆባስ ማሰጰፆመን የለትዳ አደ ናይታ።<verse eid="GEN 35:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27"/>ያይቆብ ከብሮና ጌተትያ ቅርያት-አርባ ማታን ማምረን ደእያ ባ አዋ ይሳቃ ሶ ብስ። ሄ በሳይ ካሰ አብራሃመይነ ይሳቅ ደእዳ በሳ። <verse eid="GEN 35:27"/><verse number="28" style="v" sid="GEN 35:28"/>ይሳቅ ፄታነ ሆስፑን ታሙ ላይ ደእስ። <verse eid="GEN 35:28"/><verse number="29" style="v" sid="GEN 35:29"/>እ ዳሮ ዎድያ ደእድ ሎኦ ጭምድ፥ ሀይቅድ ባ ማይዛታን ጋሄትስ። እያ ናይት ኤሳዌይነ ያይቆብ እያ ሞግዶሶና።<verse eid="GEN 35:29"/></para>
  <chapter eid="GEN 35"/>
  <chapter number="36" style="c" sid="GEN 36"/>
  <para style="s1">ኤሳዌነ እያ የለተ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1"/>ኤዶመ ጌተትያ ኤሳዌ የለተይ ሀይሳፈ ካልድ ፃፈትዳይሳ፤ <verse eid="GEN 36:1"/><verse number="2" style="v" sid="GEN 36:2"/>ኤሳዌይ ካናነ ቢታ ማጫ ናይታፐ ባዉ ማቾታ ኤክስ። ኤንትካ ህተ አድያ ኤሎና ናእዉ አዶ፥ ህወ አድያ ፅባኦና ናአይ አን የልዳ ኦሆልባሞነ <verse eid="GEN 36:2"/><verse number="3" style="v" sid="GEN 36:3"/>እስማኤላ ናእዉ፥ ነባዮታ ምችዉ ባሰማቶ። <verse eid="GEN 36:3"/><verse number="4" style="v" sid="GEN 36:4"/>አዳ ኤሳዌስ ኤልፋዛ የላሱ። ባሰማታ ራጉኤላ የላሱ። <verse eid="GEN 36:4"/><verse number="5" style="v" sid="GEN 36:5"/>ኦሆልባማ የኡሳ፥ ያእላማነ ቆረ የላሱ። ካናነ ቢታን ኤሳዌስ የለትዳ አደ ናይት ሀይሳታ።<verse eid="GEN 36:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 36:6"/>ኤሳዌይ ባ ማቸታ፥ ባ አደ ናይታነ ማጫ ናይታ፥ ባ ሶ አሳ ኡባ፥ ባ ሚዛነ ባ ሀራ መሄ ኡባ ካናነ ቢታን ሃርዳባ ኡባ ኤክድ ባ እሻ ያይቆባፐ ሃክድ ሀራ ቢታ ብስ። <verse eid="GEN 36:6"/><verse number="7" style="v" sid="GEN 36:7"/>ኤንታ ሻሎይ ዳርዳ ግሾ፥ ኤንቲ እስፈ ዳናዉ ዳንዳእቦኮና። ኤንታ መሄይ ዳርዳ ግሾ፥ ኤንቲ ደእያ ቢታይ ኤንታ ናምኣስ ግዶና እፅስ።<verse eid="GEN 36:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 36:8"/>ያንን፥ ኤዶመ ጌተትያ ኤሳዌይ ደረይ ዳርያ ሳይረ ቢታን ደእስ።<verse eid="GEN 36:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9"/>ደረይ ዳርያ ሳይረ ቢታን ደእዳ ኤዶመታ ማይዛ ኤሳዌ የለተይ ሀይሳፈ ካልድ ፃፈትዳይሳ፤ <verse eid="GEN 36:9"/><verse number="10" style="v" sid="GEN 36:10"/>ኤሳዌ አደ ናይታ ሱንይ፥ ኤሳዌ ማቸ አድ ናኣ ኤልፋዛነ ኤሳዌ ማቸ ባሰማት ናአ ራጉኤላ።<verse eid="GEN 36:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 36:11"/>ኤልፋዛ ናይት ተማና፥ ኦማራ፥ ፃፋ፥ ጋእታማነ ቀነዛ። <verse eid="GEN 36:11"/><verse number="12" style="v" sid="GEN 36:12"/>ቃስ ትምናአ ኤሳዌ ናአ ኤልፋዛስ አይለ። እያ ኤልፋዛስ አማለቃ የላሱ። ሀይሳቲ ኤሳዌ ማቸ አድ ናኣ ናይታ።<verse eid="GEN 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 36:13"/>ራጉኤላ አደ ናይት ናሃታ፥ ዛራ፥ ሻማነ ሚዛ። ሀይሳቲ ኤሳዌ ማቸ ባሰማት ናአ ናይታ።<verse eid="GEN 36:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 36:14"/>ፅባኦና ናአይ አን የልዳ ኦሆልባማ አደ ናይት ሀይሳታ፤ ኤንትካ የኡሳ፥ ያእላማነ ቆረ።<verse eid="GEN 36:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15"/>ኤሳዌ የለታ ሀላቃት ሀይሳፈ ካልድ ፃፈትዳይሳታ፤ ኤሳዌስ ባይራ ናአ ኤልፋዛ አደ ናይት፥ ሀላቃ ግድዳይሳት ተማና፥ ኦማራ፥ ፃፋ፥ ቃናዛ፥ <verse eid="GEN 36:15"/><verse number="16" style="v" sid="GEN 36:16"/>ቆረ፥ ጋእታማነ አማለቃ፤ ኤዶመ ቢታን ኤልፋዝ የልዳ ሀላቃት ሀይሳታ፤ ሄሳት ኡባይ አድ ናኣ ናይታ።<verse eid="GEN 36:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 36:17"/>ኤሳዌ ናአ ራጉኤላ አደ ናይት፥ ሀላቃ ግድዳይሳት ናሃታ፥ ዛራሀ፥ ሻማነ ሚዛ፤ ኤዶመ ቢታን ራጉኤል የልዳ ሀላቃት ሀይሳታ፤ ኤንቲ ኤሳዌ ማቸ ባሰማት ናአ ናይታ።<verse eid="GEN 36:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 36:18"/>ኤሳዌ ማቸ ኦሆልባም አደ ናይት፥ ሀላቃ ግድዳይሳት የኡሳ፥ ያእላማነ ቆረ፤ ኤንቲ አና ናኤ፥ ኤሳዌ ማቸ ኦሆልባምፐ የለትዳ ሀላቃታ።<verse eid="GEN 36:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 36:19"/>ኤዶመ ጌተትያ ኤሳዌ አደ ናይት ሀይሳታ፤ ኤንታ ሀላቃትካ ሀይሳታ።<verse eid="GEN 36:19"/></para>
  <para style="s1">ሳይረ የለተ</para>
  <para style="r">(<ref loc="1CH 1:38-42">1 ታር 1:38-42</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20"/>ኤዶመ ቢታን ደእያ ሆራ ሳይረ አደ ናይት ሀይሳፈ ካልድ ፃፈትዳይሳታ፤ ሄሳትካ ሎፃና፥ ሾባላ፥ ፅባኦና፥ አና፥ <verse eid="GEN 36:20"/><verse number="21" style="v" sid="GEN 36:21"/>ድሶና፥ ኤፀራነ ድሳና፤ ሄሳት፥ ኤዶመ ቢታን ደእያ ሳይረ አደ ናይት፥ ሆራታ ሀላቃታ።<verse eid="GEN 36:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 36:22"/>ሎፃና አደ ናይት ሆራነ ሄማማ፤ ሎፃና ምችያ ትምናኦ።<verse eid="GEN 36:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 36:23"/>ሶባላ አደ ናይት አልዋ፥ ማናሆታ፥ ኤባላ፥ ስፋነ ኦናማ።<verse eid="GEN 36:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 36:24"/>ፅባኦና አደ ናይት አያነ አና፤ ሀይስ አን መላ ቢታን ባ አዋ ፅባኦና ሀረታ ሄምሸ ብልቦ ሃ ፑልቱዋ ደምዳይሳ።<verse eid="GEN 36:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 36:25"/>አና ናአይ ድሶና፤ ናእያ ቃስ ኦሆልባሞ።<verse eid="GEN 36:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 36:26"/>ድሶና አደ ናይት ሄምዳና፥ ኤስባና፥ ይትራናነ ካራና።<verse eid="GEN 36:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 36:27"/>ኤፀራ አደ ናይት ብልሃና፥ ዛዋናነ አቃና።<verse eid="GEN 36:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 36:28"/>ድሳና አደ ናይት ኡፃነ አራና።<verse eid="GEN 36:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 36:29"/>ሆራታ ሀላቃት ሀይሳታ፤ ሎፃና፥ ሾባላ፥ ፅባኦና፥ አና፥ <verse eid="GEN 36:29"/><verse number="30" style="v" sid="GEN 36:30"/>ድሶና፥ ኤፀራነ ድሳና። ሀይሳቲ ሳይረ ቢታን ባንታ ያራን ያራን ሻከትዳ ሆራታ ሀላቃታ።<verse eid="GEN 36:30"/></para>
  <para style="s1">ኤዶመ አይሰይሳታ</para>
  <para style="r">(<ref loc="1CH 1:43-54">1 ታር 1:43-54</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31"/>እስራኤለን ካዎይ ካዎታናፐ ካሰ ኤዶመ ቢታን ካዎትዳ ካዎት ሀይሳፈ ካልድ ፃፈትዳይሳታ።<verse eid="GEN 36:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 36:32"/>ብኦራ ናአይ ባላቅ ኤዶመን ካዎትስ፤ እያ ካታማ ሱንይ ድናባ ጌተቴስ።<verse eid="GEN 36:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 36:33"/>ባላቅ ሀይቅን፥ ባሶራ አደይ ዛራ ናአይ ዮባብ እያ በሳን ካዎትስ።<verse eid="GEN 36:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 36:34"/>ዮባብ ሀይቅን፥ ተማና አደይ ሁሳም ካዎትስ።<verse eid="GEN 36:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 36:35"/>ሁሳም ሀይቅን፥ ባዳዳ ናአይ ሀዳድ፥ ምድያመታ ሞአበ ቢታን ፆንዳይስ ካዎትስ፤ እያ ካታማ ሱንይ አዊታ ጌተትስ።<verse eid="GEN 36:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 36:36"/>ሀዳድ ሀይቅን፥ ማስሬቃ አደይ ሳምል ካዎትስ።<verse eid="GEN 36:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 36:37"/>ሳምል ሀይቅን፥ ሻፋ ማታን ደእያ ረሆቦታ አደይ ሳኡሊ ካዎትስ።<verse eid="GEN 36:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 36:38"/>ሳኡሊ ሀይቅን፥ አክቦራ ናአይ ባአል-ሀናን ካዎትስ።<verse eid="GEN 36:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 36:39"/>አክቦራ ናአ ባአል-ሀናን ሀይቅን፥ ሀዳድ ካዎትስ፤ እያ ካታማ ሱንይ ፓኡ ጌተቴስ፤ እያ ማችያ መዛሃባ ናእያ ማፅሬዳ የልዳ ማሄፃቤሎ ጌተታዉሱ።<verse eid="GEN 36:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40"/>ኤሳዌ የለታ ሀላቃት ባንታ ያራን ያራን፥ ባንታ በሳን በሳን ባንታ ሱንን ሱንን ሀይሳታ፤ ትምና፥ አልዋ፥ የተታ፥ <verse eid="GEN 36:40"/><verse number="41" style="v" sid="GEN 36:41"/>ኦሆልባማ፥ ኤላ፥ ፕኖና፥ <verse eid="GEN 36:41"/><verse number="42" style="v" sid="GEN 36:42"/>ቃናዛ፥ ተማና፥ ምብሳራ፥ <verse eid="GEN 36:42"/><verse number="43" style="v" sid="GEN 36:43"/>ማግደላነ እራማ። ሀይሳቲ ባንታ አይስያ ቢታን፥ ባንታ ደእያሱዋን ደእያሱዋን ኤዶመ ሀላቃታ። ሀይስ ኤሳዌይ፥ ኤዶመታ አዋ።<verse eid="GEN 36:43"/></para>
  <chapter eid="GEN 36"/>
  <chapter number="37" style="c" sid="GEN 37"/>
  <para style="s1">ዮሰፋነ እያ እሻታ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1"/>ያይቆብ እያ አዋይ ይሳቅ ደእዳ ካናነ ቢታን ደእስ።<verse eid="GEN 37:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 37:2"/>ያይቆባ የለተ ታርከይ ሀይሳፈ ካልድ ፃፈትዳይሳ።</para>
  <para style="p" vid="GEN 37:2">ዮሰፍ ታማነ ላፑን ላይ ናአ ግድዳ ዎደ ባ አዋ ማቸታፐ፥ ባልፐነ ዝልፓፈ የለትዳ ባ እሻታራ መሄ ሄሜስ። እ ባ አዋስ ባ እሻት ኦዳ ኢታባታ ኦዴስ።<verse eid="GEN 37:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3"/>እስራኤለይ ዮሰፋ ጭምድ የልዳ ግሾ፥ ባ ሀራ አደ ናይታ ኡባፈ አድ ዶሴስ። ሄሳ ግሾ፥ እያዉ አሌቀትዳ ማኦ ጊግስስ። <verse eid="GEN 37:3"/><verse number="4" style="v" sid="GEN 37:4"/>እያ እሻት ኤንታ አዋይ እያ ኤንታፈ አድ ዶሰይሳ በእዳ ዎደ እያ እፅዶሶና። ማልኦ ቃላካ እያኮ ኦደታናዉ ዳንዳእቦኮና።<verse eid="GEN 37:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5"/>እስ ዎደ ዮሰፍ አሙሆ አሙህድ፥ ባ እሻታስ ኦድን ኤንቲ እያ ካሰይሳፈ አድ እፅዶሶና። <verse eid="GEN 37:5"/><verse number="6" style="v" sid="GEN 37:6"/>እ ኤንታኮ፥ “ታኒ አሙህዳ አሙሁዋ ስእተ። <verse eid="GEN 37:6"/><verse number="7" style="v" sid="GEN 37:7"/>ኑኒ ጋደን ግስተ ምርቅሽን ታ ምርቀይ ደንድድ ሉለ ኤቅስ። ህንተ ምርቀት ዩይ አድ ታ ምርቅያስ ዝግዶሶና” ያግስ።<verse eid="GEN 37:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8"/>እያ እሻት፥ “ኔኒ ኑ ቦላ ካዎታዳ ኑና ሃራናዉ ቆፓይ?” ያግድ ኦይችዶሶና። ኤንቲ እያ አሙሁዋ ግሾነ እያ ኦዳ ግሾ፥ ካሰይሳፈ አድ እፅዶሶና።<verse eid="GEN 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9"/>ቃስካ ዮሰፍ ሀራ አሙሆ አሙህድ ባ እሻታስ ኦድስ። “ሄኮ፥ ታኒ ሀራ አሙሆካ አሙሀስ። ሄ አሙሁዋን አው፥ አጌንነ ታማነ እስ ፆልንቶት ታዉ ዝጎሶና” ያግስ።<verse eid="GEN 37:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10"/>ባ እሻታስ ኦድዳ አሙሁዋ ባ አዋስ ኦድዳ ዎደ እያ አዋይ፥ “ሀይስ ዋንዳ አሙሆ? ቱማ ታኒ፥ ነ አያነ ነ እሻት ይድ፥ ነ ስንን ዝጋነዬ?” ያግድ ሀንቀትስ። <verse eid="GEN 37:10"/><verse number="11" style="v" sid="GEN 37:11"/>እያ እሻት እያ ቃናትዶሶና፥ ሽን እያ አዋይ ሄ ኦዳ ባ ዎዛናን ዎስ።<verse eid="GEN 37:11"/></para>
  <para style="s1">ዮሰፋ ባይዘተ</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12"/>እስ ጋላስ እያ እሻት ሴከማን ባንታ አዋ መሄታ ሄማናዉ ብዶሶና። <verse eid="GEN 37:12"/><verse number="13" style="v" sid="GEN 37:13"/>እስራኤለይ ዮሰፋ፥ “ነ እሻት ሴከማን መሄታ ሄመይሳ ኤራሳ። ሃያ፥ ታኒ ነና ኤንታኮ ኪታና” ያግስ።</para>
  <para style="p" vid="GEN 37:13">ዮሰፍካ፥ “ኤሮ” ያግስ።<verse eid="GEN 37:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14"/>እ እያኮ፥ “ባዳ ነ እሻትነ መሄይ ሳሮ ግደይሳ በአዳ ኤንታባ ታዉ ያዳ ኦዳ” ያግድ ዮሰፋ ከብሮና ዛንጋራፐ ኪትስ።</para>
  <para style="p" vid="GEN 37:14">ዮሰፍ ኪተትድ ሴከማ ብስ። <verse eid="GEN 37:14"/><verse number="15" style="v" sid="GEN 37:15"/>ያን ደምባ በሳን ኤንታ ኮሻን ያ ሃ ስመረትሽን፥ እስ አስ እያ ደምድ፥ “ላ ናአዉ፥ አይ ኮያይ?” ያግድ ኦይችስ።<verse eid="GEN 37:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16"/>እ፥ “ታ እሻታ ኮያይስ፤ ኤንቲ መህያ ሄምያ በሳ በእዳኮ፥ ሀያና ታዉ ኦዳርኪ” ያግስ።<verse eid="GEN 37:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17"/>ኡራይ፥ “ሀይሳፈ ብዶሶና፤ ኤንቲ፥ ‘ኑኒ ዶታነ ባና’ ግሽን ስአስ” ያግስ። ሄሳ ግሾ፥ ዮሰፍ ባ እሻታ ጌዶ ካል ብድ፥ ኤንታ ዶታነን ደምስ።<verse eid="GEN 37:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 37:18"/>ሽን እ ሃሆን ደእሽን፥ ኤንቲ እያ በእዶሶና። እ ኤንታኮ ጋኮና ደእሽን፥ ኤንቲ እያ ዎናዉ ማቀትዶሶና። <verse eid="GEN 37:18"/><verse number="19" style="v" sid="GEN 37:19"/>ኤንቲ እሶይ እሱዋኮ፥ “ህን በእተ፥ አሙሁዋ ጎዳይ ዬስ። <verse eid="GEN 37:19"/><verse number="20" style="v" sid="GEN 37:20"/>ሃይተ፥ እያ ዎድ፥ ሀ ኦላታፐ እሱዋን የጎስ። ሄሳፈ ጉየ፥ ‘ዶእ እያ ምስ’ ያጋና። ያትድ፥ እያ አሙሁዋ ዉርሰ በአና” ያግዶሶና።<verse eid="GEN 37:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21"/>ሮቤል ሄሳ ስእዳ ዎደ፥ ኤንታ ኩሸፐ እያ አሻናዉ ኮይድ፥ “እያ ዎኮ፤ <verse eid="GEN 37:21"/><verse number="22" style="v" sid="GEN 37:22"/>እያ ዎናፐ መላ ቢታን ደእያ ሀ ኦላን የግተ፤ እያ ቦላ ኩሸ ዎፍተ” ያግስ። ሮቤል ሄሳ ግዳይ፥ እያ ኤንታ ኩሸፐ አሽድ ጉየ አዋኮ ዛራናሳ።<verse eid="GEN 37:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 37:23"/>ዮሰፍ ባ እሻታኮ ጋክዳ ዎደ እ ማእዳ አሌቀትዳ ማኡዋ እያፐ ቃር ኤክዶሶና። <verse eid="GEN 37:23"/><verse number="24" style="v" sid="GEN 37:24"/>እያ ኤፍድ ሃ ባይና መላ ኦላን የግዶሶና።<verse eid="GEN 37:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25"/>ኤንቲ ካ ምሽን ሀሳዮና እስማኤላ አሳት ጋላዳፐ ግብፀ ብሽን፥ ቁ ግድ በእዶሶና። ኤንቲ ባንታ ግማለታ ቦላ ሳዉዋ፥ ማድያነ ካርብያ ጫንዶሶና።<verse eid="GEN 37:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 37:26"/>ይሁድ ባ እሻታ፥ “ኑኒ ኑ እሻ ዎድ፥ እያ ሱ ቆትኮ ኑና አይ ማዳኔ? <verse eid="GEN 37:26"/><verse number="27" style="v" sid="GEN 37:27"/>ሃይተ፥ እያ እስማኤላ አሳስ ባይዞስ። እ ኑ እሻ፥ ኑ ሱነ ኑ አሾ ግድያ ግሾ እያ ቦላ ኑ ኩሽያ ዎኮ” ያግስ። እያ እሻት እያ ኦዳ ማእዶሶና። <verse eid="GEN 37:27"/><verse number="28" style="v" sid="GEN 37:28"/>ሄሳ ግሾ፥ ምድያመ ቢታ ዛልአንቾት ያራ አሽን፥ እያ እሻት ዮሰፋ ኦላፈ ከስድ፥ እስማኤላ አሳታስ ላታሙ ብራ ሳንትመን ባይዝዶሶና። ኤንቲ ዮሰፋ ግብፀ ቢታ ኤፍዶሶና።<verse eid="GEN 37:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29"/>ሮቤል ኦላኮ ስሚድ፥ ዮሰፍ ያን ባይናይሳ በእዳ ዎደ፥ አዛንድ ባ ማኡዋ ዳክስ። <verse eid="GEN 37:29"/><verse number="30" style="v" sid="GEN 37:30"/>እ ጉየ ባ እሻታኮ ብድ፥ “ናአይ ያን ባዋ፤ ህዛ፥ ታኒ አይ ሀኖሻ?” ያግስ።<verse eid="GEN 37:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31"/>ኤንቲ ዮሰፋ ማኡዋ ኤክድ፥ እስ ዴሸ ሹክድ፥ ሄ ሱን ናቅዶሶና። <verse eid="GEN 37:31"/><verse number="32" style="v" sid="GEN 37:32"/>አሌቀትዳ እያ ማኡዋ ባንታ አዋኮ ኤፍድ “ኑኒ ሀይሳ ደምዳ፤ ሀይስ ነ ናአ ማኡዋኮነ አነ በአ” ያግዶሶና።<verse eid="GEN 37:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33"/>ያይቆብ ማኡዋ ኤርድ፥ “ሀይስ ታ ናኣ ማኡዋ፤ ታ ናኣ ዶእ ምስ። ዮሰፍ ቱማካ ዛዘትስ” ያግስ።<verse eid="GEN 37:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 37:34"/>ያይቆብ አዛንድ፥ ባ ማኡዋ ፔስ። ካዮ ማኦ ማእድ፥ ባ ናኣስ ዳሮ ጋላስ ዬክስ። <verse eid="GEN 37:34"/><verse number="35" style="v" sid="GEN 37:35"/>እያ አደ ናይትነ ማጫ ናይት ኡባይ እያ ምንናዉ ይዶሶና። ሽን እ ምነቶና እፅድ፥ “አካይ፥ ታኒ ዬሆይ ዬሆሽን ዱፎ ገላና” ያግድ፥ ዮሰፋስ ዬክስ።<verse eid="GEN 37:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36"/>ሄ ዎደ ምድያመ ቢታ አሳት ዮሰፋ፥ ግብፀ ካዋ ሞርናታነ ካዋ ናገይሳታ ሀላቃ ግድዳ ጶፅፋራስ ባይዝዶሶና።<verse eid="GEN 37:36"/></para>
  <chapter eid="GEN 37"/>
  <chapter number="38" style="c" sid="GEN 38"/>
  <para style="s1">ይሁዳነ ትማሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1"/>ሄ ዎደ ይሁድ ባ እሻታፐ ሻከትድ፥ አዱላማ ካታማን ደእያ ህራ ጌተትያ ኡራራ ዳናዉ ብስ። <verse eid="GEN 38:1"/><verse number="2" style="v" sid="GEN 38:2"/>ያን ይሁድ ሹአ ጌተትያ ካናነ ኡራ ናእዉ ማችስ። <verse eid="GEN 38:2"/><verse number="3" style="v" sid="GEN 38:3"/>እያ ይሁዳስ ቃንታዳ አደ ናአ የላሱ። እ ሄ ናአ ኤራ ግድ ሱንስ። <verse eid="GEN 38:3"/><verse number="4" style="v" sid="GEN 38:4"/>ቃስካ ቃንታዳ አደ ናአ የላሱ። እያ ሄ ናአ ኦናና ጋዳ ሱንሱ። <verse eid="GEN 38:4"/><verse number="5" style="v" sid="GEN 38:5"/>ዛራዳካ ሀራ አደ ናአ የላሱ። እያ ሄ ናኣ ሴላ ጋዳ ሱንሱ። ሄ ናአይ የለትያ ዎደ ይሁድ አክዚባ ቢታና።<verse eid="GEN 38:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6"/>ይሁድ ባ ባይራ ናአ ኤራስ ትማሮ ጌተትያ ማቾ እሚስ። <verse eid="GEN 38:6"/><verse number="7" style="v" sid="GEN 38:7"/>ይሁዳ ባይራ ናአይ፥ ኤር፥ ጎዳ ስንን ኢታ አስ ግድያ ግሾ፥ ጎዳይ እያ ዎስ።<verse eid="GEN 38:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 38:8"/>ይሁድ ኦናናኮ፥ “ዎጋይ ነና ኪተይሳ መላ ነ እሻ ማቸራ አቃ። ነ እሻስ ናአ የላዳ እያ ሱን ፄግሳ” ያግስ። <verse eid="GEN 38:8"/><verse number="9" style="v" sid="GEN 38:9"/>ሽን ኦናን የለታና ናይት እያባ ግዶናይሳ ኤርዳ ግሾ፥ ባ እሻ ማቸራ አቅያ ዎደ ባ እሻስ ናእ የለቶና መላ ባ አቱን ሳአን ጉሴስ። <verse eid="GEN 38:9"/><verse number="10" style="v" sid="GEN 38:10"/>እ ኦዳባይ ጎዳ ስንን ኢታባ ግድዳ ግሾ፥ ጎዳይ እያካ ዎስ።<verse eid="GEN 38:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 38:11"/>ሄሳፈ ጉየ፥ ይሁድ ባ ናኣ ማችዉ ትማሮ፥ “ታ ናአይ ሴል ድጫና ጋካናስ ነ አዋ ሶ ባዳ፥ አምኤተን ደኣሻ” ያግስ። ሄሳ እ ግዳይ፥ እካ ባ እሻታዳ ሀይቃነኮነ ግድ ህርግዳ ግሾሳ። ሄሳ ግሾ፥ ትማራ ባዳ ባ አዋ ሶን ደአሱ።<verse eid="GEN 38:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12"/>ዳሮ ዎደፐ ጉየ፥ ይሁዳ ማችያ፥ ሹአ ናእያ ሀይቃሱ። ይሁድ ባ ካዮ ዎድያ ኦንግድ፥ ባ ዶርሳታ እክስያ ሜድያ አሳታኮ ትምና ጌተትያ በሲ ባ ላግያ አዱላማ አድያ ህረራ ብስ።<verse eid="GEN 38:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 38:13"/>አሳይ ትማሮ፥ “ሄኮ፥ ነ አዝና አዋይ ይሁድ፥ ባ ዶርሳታ እክስያ ሜዳናዉ ትምና ቤስ” ያግድ ኦድዶሶና። <verse eid="GEN 38:13"/><verse number="14" style="v" sid="GEN 38:14"/>እያ ባ አምኤተ ማኡዋ ላማዳ፥ ባና ባለናዉ ሻሸ ኤካዳ ጉሉንታሱ። ያታዳ፥ ትምና ኤፍያ ኦግያ ዶናን ደእያ ኤናይመ ካታማ ጋፃን ኡታሱ። ሄሳ እያ ኦዳይስ፥ ሴል ድጭድ ጋክንካ እያዉ ማቾ ግዳዳ እመቶናይሳ እያ ኤርዳ ግሾሳ።<verse eid="GEN 38:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15"/>እያ ባ ሶምኡዋ ጉሉንትዳ ግሾ፥ ይሁድ እዮ በእዳ ዎደ፥ ላይማ ማጫስ ግድ ቆፕስ። <verse eid="GEN 38:15"/><verse number="16" style="v" sid="GEN 38:16"/>ባ ናኣ ማችዉ ግደይሳ ኤሮና ደእሸ፥ ኦግያ ጋፃ ኢኮ ሺቅድ “ታራ አቃኔ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="GEN 38:16">እያ፥ “ታኒ ኔራ አቅኮ፥ ነ ታዉ አይ እማኔ?” ጋዳ ኦይቻሱ።<verse eid="GEN 38:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17"/>እ፥ “ታኒ ታ መህያፐ እስ ኮለ ነዉ የዳና” ያግስ።</para>
  <para style="p" vid="GEN 38:17">እያ፥ “ኔኒ ሄሳ ታዉ የዳና ጋካናስ አይ ኦይኔ?” ያጋሱ።<verse eid="GEN 38:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18"/>እ፥ “አይ ኦይ?” ያግስ።</para>
  <para style="p" vid="GEN 38:18">እያ፥ “ነ ማታምያ እያ ጎሹዋራነ ነ ኩሽያን ደእያ ፃምአ ኦይ” ያጋሱ። እ ሄሳታ እምድ፥ ኢራ አቅስ፤ እያካ ቃንታሱ። <verse eid="GEN 38:18"/><verse number="19" style="v" sid="GEN 38:19"/>እያ ሄሳፈ ደንዳዳ ብዳፐ ጉየ፥ ባ ጉሉን ቃራዳ፥ ባ አምኤተ ማኡዋ ማአሱ።<verse eid="GEN 38:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20"/>ይሁድ ባ ኦይዳባ ሄ ማጫሴፐ ዛር ኤካናዉ ዴሻ ባ ላግያ ህራ ቦላ እዉ የድስ። ሽን እ እዮ ደምቤና። <verse eid="GEN 38:20"/><verse number="21" style="v" sid="GEN 38:21"/>እ ሄ ቢታ አሳኮ፥ “ኤናይመ ካታማን፥ ኦገ ዶናን ኡትዳ ላይማ ማጫስያ አዉኔ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="GEN 38:21">አሳይ፥ “ላይማ ማጫስ ሀይሳን ኡባካ ባዋ” ያግዶሶና።<verse eid="GEN 38:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22"/>እ ይሁዳኮ ስሚድ፥ “ ‘ታኒ እዮ ደማብከ፤ ሄሳ ቦላካ ሄ ቢታ አሳይ፥ ላይማ ማጫስ ሀይሳን ኡባካ ባዋ’ ያግዶሶና” ያግስ።<verse eid="GEN 38:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23"/>ይሁድ፥ “ባ ኦይክዳይሳ ባዉ ኤኮ፥ አቶ ጊኮ፥ አስ ኑና ሚጫና። ህዛ ታኒ እዉ ዴሸ የዳስ ሽን ኔኒ እዮ ደማባካ” ያግስ።<verse eid="GEN 38:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24"/>ሄ አጌና ግድሽን አሳይ፥ “ነ ናኣ ማጫስያ ትማራ ላይማታዳ ቃንታሱ” ያግድ ይሁዳስ ኦድዶሶና።</para>
  <para style="p" vid="GEN 38:24">ይሁድ፥ “እዮ ካረ ከስድ ታማን ፁግተ” ያግስ።<verse eid="GEN 38:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25"/>እዮ ካረ ከስያ ዎደ፥ “ታኒ ቃንትዳይ ሀ ሚሸታ ጎዳሳ። ሀ ማታመይነ ፃምአይ ኦደባየኮ ኤራናዉ ዳንዳእኮ ኤራ” ጋዳ ባ አዝና አዋካ ኪታሱ።<verse eid="GEN 38:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26"/>ይሁድ ሄ ሚሸታ ኤርድ፥ “ታኒ ታ ናኣ ሴላስ እዮ እማቦና ግሾ፥ ታፐ እያ ፅሎ” ያግስ። ሄሳፈ ጉየ፥ እ ኢራ ዛሪድ አቅቤና።<verse eid="GEN 38:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27"/>እዉ የሎ ቃም ጋክያ ዎደ፥ እ ኡሎን መንተ ናይት ደኤይስ ኤረትስ። <verse eid="GEN 38:27"/><verse number="28" style="v" sid="GEN 38:28"/>እያ ማረትሽን፥ ኤንታፈ እሶይ ባ ኩሽያ ከስን የልስያራ፥ “ሀይስ ኮይሮ ከይስ” ጋናዉ ዞኦ ቃጭና ኤካዳ እያ ኩሸን ቃቻሱ። <verse eid="GEN 38:28"/><verse number="29" style="v" sid="GEN 38:29"/>ሽን እ ባ ኩሽያ ጉየ ኤክዳ ዎደ፥ እያ እሻይ ከይን እያ፥ “ኔኒ ዋናዳ ፖርፁ ጋዳ ከያዲ?” ያጋሱ። ሄሳ ግሾ፥ ፓረሳ (ፖርፁ ግስ) ጋዳ ሱንሱ። <verse eid="GEN 38:29"/><verse number="30" style="v" sid="GEN 38:30"/>ሄሳፈ ጉየ፥ እያ ኩሸን ዞኦ ቃጭን ደእያ እያ እሻይ የለትስ። እያ ሱንይ ዛራ (ዞኦ) ጌተትስ።<verse eid="GEN 38:30"/></para>
  <chapter eid="GEN 38"/>
  <chapter number="39" style="c" sid="GEN 39"/>
  <para style="s1">ዮሰፋነ ጶፅፋራ ማችዉ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1"/>እስማኤላ አሳት ዮሰፋ ግብፀ ቢታ ኤፍዶሶና። ግብፀ ካዋ ሞርናታፐ እሱዋስ፥ ካዋ ናገይሳታ ሀላቃስ ዮሰፋ ባይዝዶሶና።<verse eid="GEN 39:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 39:2"/>ጎዳይ ዮሰፋራ ደእያ ግሾ፥ እ ኦያባ ኡባ እያዉ እንጀይስ። ያትን፥ ባ ግብፀ ጎዳ ሶን ደእስ። <verse eid="GEN 39:2"/><verse number="3" style="v" sid="GEN 39:3"/>ጎዳይ እያራ ደኤይሳነ እ ኦያባ ኡባ እያዉ እንጀይዳይሳ ጶፅፋር በእዳ ዎደ፥ <verse eid="GEN 39:3"/><verse number="4" style="v" sid="GEN 39:4"/>ዮሰፋ ዶስስ፥ ባዉ ማታ ኦሳንቾ ኦስ። ጶፅፋር እያ ባ ኬ ቦላነ ባዉ ደእያባ ኡባ ቦላ ሹምስ። <verse eid="GEN 39:4"/><verse number="5" style="v" sid="GEN 39:5"/>ሄ ዎደፐ ዶምድ፥ ጎዳይ ግብፀ ኡራ ኬ ዮሰፋ ግሾ አንጅስ። ጎዳ አንጆይ ጶፅፋራ ሶንነ እያ ጋደን ደእያባ ኡባ ቦላ ዎስ። <verse eid="GEN 39:5"/><verse number="6" style="v" sid="GEN 39:6"/>ሄሳ ግሾ፥ እ ምያ ካፈ አትሽን፥ ባዉ ደእያ ሀራባ ኡባ ዮሰፋ ኩሸን ሼስ።</para>
  <para style="p" vid="GEN 39:6">ዮሰፍ የገልስነ ማላ ሎኦ አስ። <verse eid="GEN 39:6"/><verse number="7" style="v" sid="GEN 39:7"/>ጉ ዎደፐ ጉየ፥ እያ ጎዳ ማችያ ዮሰፋ በአዳ፥ “ሃያ፥ ታራ ዝንአ” ያጋሱ።<verse eid="GEN 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 39:8"/>ሽን እ እፅድ፥ ኢኮ፥ “በአ፥ ታ ጎዳይ፥ ባዉ ደእያባ ኡባ ታ ኩሸን የግዳ ግሾ፥ ባ ሶን ደእያባስ አይኮካ ህርገና። <verse eid="GEN 39:8"/><verse number="9" style="v" sid="GEN 39:9"/>ሀ ሶን ታፐ አይ ኦንካ ባዋ። ኔኒ እያ ማቾ ግድያ ግሾ፥ ኔፐ አትሽን፥ ሀራ፥ እ ታዉ እሞናባይ ባዋ። ያትን፥ ታኒ ዋታዳ ሀይሳ መላ ዳሮ ኢታባ ሀናዳ ፆሳ ቦላ ናጋራ ኦ?” ያግስ። <verse eid="GEN 39:9"/><verse number="10" style="v" sid="GEN 39:10"/>እያ ሄ ኦዳ ዎንታ ዎንታ ዮሰፋስ ኦድንካ፥ እ ኢራ አቆና ይኮ እ ማታ ሺቆና እፅስ።<verse eid="GEN 39:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11"/>ሽን እስ ጋላስ እ ባ ኦሶ ኦናዉ ሶ ገልያ ዎደ፥ ሶ አይለታፐ ኦንካ ሶን ባዋ። <verse eid="GEN 39:11"/><verse number="12" style="v" sid="GEN 39:12"/>እያ ዮሰፋ አፍላ ኦይካዳ፥ “ታራ ዝንአ” ያጋሱ። ሽን እ ባ አፍላ እ ኩሽያን የግ አግድ፥ ሶፐ ካረ ዎፅ ከይስ።<verse eid="GEN 39:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 39:13"/>ዮሰፍ ባ አፍላ እ ኩሽያን የግ አግድ፥ ሶፐ ካረ ዎፅ ከይዳይሳ እያ በእዳ ዎደ፥ <verse eid="GEN 39:13"/><verse number="14" style="v" sid="GEN 39:14"/>ባ ሶ አይለታ ፄጋዳ፥ “ሄኮ፥ ታ አዝናይ ኤህዳ ሀ እብራወ ኡራይ ታና ካዉሻናዉ ኦይክስ። እ ታና ኢሳናዉ ታ ደእያሱዋ ገልስ፥ ሽን ታኒ ዋሳስ። <verse eid="GEN 39:14"/><verse number="15" style="v" sid="GEN 39:15"/>ያትን፥ እ ባ አፍላ ታ ማታን የግ አግድ፥ ሶፐ ካረ ዎፅድ ከይስ” ያጋሱ።<verse eid="GEN 39:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16"/>እ አዝናይ ሶ ያና ጋካናስ እያ ዮሰፋ አፍላ ባ ማታን ዎሱ። <verse eid="GEN 39:16"/><verse number="17" style="v" sid="GEN 39:17"/>እ ይን፥ እያዉ ሀይሳዳ ጋዳ ኦዳሱ፤ “ሀይስ ነ ኤህዳ እብራወ አይለይ ታና ኢሳናዉ ታኮ ገልስ። <verse eid="GEN 39:17"/><verse number="18" style="v" sid="GEN 39:18"/>ሽን ታኒ ዋስን፥ ባ አፍላ ታ ማታን የግ አግድ፥ ሶፐ ካረ ዎፅ ከይስ” ያጋሱ።<verse eid="GEN 39:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19"/>እያ ጎዳይ ሀንዳባ ስእዳ ዎደ ዳሮ ይሎትስ። <verse eid="GEN 39:19"/><verse number="20" style="v" sid="GEN 39:20"/>እያ ጎዳይ ዮሰፋ ኤፍድ፥ ካዋ ቃሾ አሳይ ደእያ ቃሾ ኬን የግስ።<verse eid="GEN 39:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 39:21"/>ሽን ዮሰፍ ቃሾ ኬን ደእያ ዎደ፥ ጎዳይ እያራ ደኤስ። ባ ኬሀተ እያዉ ዳርስድ፥ ቃሾ ኬ ካፑዋ ስንን እያዉ ሳባ እሚስ። <verse eid="GEN 39:21"/><verse number="22" style="v" sid="GEN 39:22"/>ያንን፥ ቃሾ ኬ ካፖይ ቃሾ አሳ ኡባ ዮሰፋ ኩሸን የግስ። ያን ኦሰትያባ ኡባስ አዋተ እሚስ። <verse eid="GEN 39:22"/><verse number="23" style="v" sid="GEN 39:23"/>ጎዳይ ዮሰፋራ ግድድ፥ እ ኦያባ ኡባ እያዉ እንጀይዳ ግሾ፥ ቃሾ ኬ ካፖይ ዮሰፋ ኩሸን ደእያባስ አይኮካ ህርገና።<verse eid="GEN 39:23"/></para>
  <chapter eid="GEN 39"/>
  <chapter number="40" style="c" sid="GEN 40"/>
  <para style="s1">ዮሰፍ አሙሆ ብለ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1"/>ጉ ዎደፐ ጉየ፥ ግብፀ ካዋ ኡሻ ካፖይነ ካ ካፖይ ባንታ ጎዳ፥ ግብፀ ካዋ ናቅዶሶና። <verse eid="GEN 40:1"/><verse number="2" style="v" sid="GEN 40:2"/>ካዎይ ሄ ናምኡ ካፖታ ቦላ ዳሮ ይሎትድ፥ <verse eid="GEN 40:2"/><verse number="3" style="v" sid="GEN 40:3"/>ዮሰፍ ቃሸትዳ፥ ቃሾ ኬ ናገይሳታ ካፑዋ ሶን ኤንታ ቃችስ። <verse eid="GEN 40:3"/><verse number="4" style="v" sid="GEN 40:4"/>ናገይሰታ ሀላቃይ ኤንታ ዮሰፋስ ሼስ፥ እካ ኤንታዉ ኪተቴስ። ኤንቲ ቃሾ ኬን ዳሮ ዎደ ኡትዶሶና።<verse eid="GEN 40:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 40:5"/>ግብፀ ካዋ ኡሻ ካፖይነ ካ ካፖይ፥ ቃሾ ኬን ደእሸ ናምአይካ እስ ቃማ ዱማ ዱማ አሙሆ አሙህዶሶና። ሄ አሙሆታስ ዱማ ዱማ ብርሸይ ደኤስ። <verse eid="GEN 40:5"/><verse number="6" style="v" sid="GEN 40:6"/>ዮሰፍ ዎንታ ኤንታኮ ገልያ ዎደ ኤንቲ አዛንድ ኡትዳሽን በእስ። <verse eid="GEN 40:6"/><verse number="7" style="v" sid="GEN 40:7"/>እ ኤንታና፥ “ሀች ህንተ ሶምኦይ አይስ ምዴ?” ያግድ ኦይችስ።<verse eid="GEN 40:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8"/>ኤንቲ፥ “ኑ ናምአይካ አሙሆ አሙህዳ፥ ሽን ኑስ ብርሽያ አስ ይስ” ያግዶሶና።</para>
  <para style="p" vid="GEN 40:8">ዮሰፍ ኤንታኮ፥ “አሙሆ ብርሽያ ኤራተይ ፆሳባ ግደነዬ? አነ ህንተ አሙሁዋ ታዉ ኦድተ” ያግስ።<verse eid="GEN 40:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9"/>ያትን ኡሻ ካፖይ ባ አሙሁዋ ዮሰፋስ ኦድስ፤ “ታኒ ታ አሙሆን እስ ዎይነ ታ ስንን በአስ። <verse eid="GEN 40:9"/><verse number="10" style="v" sid="GEN 40:10"/>ሄ ዎይንያስ ሄ ታሸት ደኦሶና። እ ሀይፅድ፥ ጪይ ስሚድ ቴርስ። <verse eid="GEN 40:10"/><verse number="11" style="v" sid="GEN 40:11"/>ካዎ ዋንጭ ታ ኩሸን ደኤስ። ታኒ ዎይነ ቴራ ኤካዳ እያን ጉምአዳ፥ ሄ ዋንጫ ካዋ ኩሸን ዎስ” ያግስ።<verse eid="GEN 40:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12"/>ዮሰፍ፥ “ሀ አሙሁዋ ብርሸይ ሀይሳ፤ ሄ ታሸት ሄ ጋላሳታ። <verse eid="GEN 40:12"/><verse number="13" style="v" sid="GEN 40:13"/>ሄ ጋላሳታ ግዶን ካዎይ ነና ቃሾፐ ብላና። እ ነና ካሰ ሹማተኮ ዛራና። ካሰ ኔኒ ኡሻ ካፖ ግዳዳ ኦይሳዳ ኔኒ ካዋ ዋንጫ እያ ኩሽያን ዎና። <verse eid="GEN 40:13"/><verse number="14" style="v" sid="GEN 40:14"/>ሽን ነዉ ሳእ ሎእዳ ዎደ ታና ዶጎፓ፤ ታዉ ኬሀ። ታባ ካዋስ ኦዳዳ፥ ሀ ቃሾ ኬፈ ታና ከስሳ። <verse eid="GEN 40:14"/><verse number="15" style="v" sid="GEN 40:15"/>ታና እብራወ ቢታፈ ዎልቃን ኤህዶሶና። ሀር አቶሽን፥ ሀይሳን ታና ቃሾስ ጋያባ አይብባካ ኦብከ” ያግስ።<verse eid="GEN 40:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16"/>ካ ካፖይ ዮሰፍ አሙሁዋ ሎይድ ብርሽዳይሳ በእዳ ዎደ ዮሰፋኮ፥ “ታኒ አሙህዳ አሙሆይ ሀይሳ፤ ታ ሁጰን ሄ ጋባተ ኡይ ደኤስ፤ <verse eid="GEN 40:16"/><verse number="17" style="v" sid="GEN 40:17"/>ቦላ ባጋ ጋባትያን ግብፀ ካዋስ ዱማ ዱማ ካ ቆሞፈ ኡከትዳ ኡይይ ደኤስ። ሽን ካፎት ሄ ታ ሁጰን ደእያ ጋባትያፐ ሞሶና” ያግስ።<verse eid="GEN 40:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18"/>ዮሰፍ፥ “ሄ አሙሁዋ ብርሸይ ሀይሳ፤ ሄ ጋባተት ሄ ጋላሳታ። <verse eid="GEN 40:18"/><verse number="19" style="v" sid="GEN 40:19"/>ሄ ጋላሳ ግዶን ካዎይ ነና ቃሾፐ ብላና። ነ ቆያ ቃንፅስድ ምን ካቅሳና፤ ነ አሹዋካ ካፎይ ማና” ያግስ።<verse eid="GEN 40:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20"/>ሄን ጋላሳን ግብፀ ካዎይ ባ የለትዳ ጋላሳን ባ ሞርናታ ኡባስ ግብራ ጊግስስ። ኡሻ ካፑዋነ ካ ካፑዋ ብል ኤህድ ባ አሳ ስንን ኤስስ። <verse eid="GEN 40:20"/><verse number="21" style="v" sid="GEN 40:21"/>ኡሻ ካፑዋ እያ ሹማተኮ ዛርን፥ እ ካዋ ኩሽያን ዋንጫ ዎስ። <verse eid="GEN 40:21"/><verse number="22" style="v" sid="GEN 40:22"/>ሽን ካዎይ ካ ካፑዋ ካቅስስ። ኡባይካ ዮሰፍ ኤንታ አሙሁዋ ብርሽዳይሳዳ ሀንስ። <verse eid="GEN 40:22"/><verse number="23" style="v" sid="GEN 40:23"/>ሽን ኡሻ ካፖይ ዮሰፋ ሀሳዮና ዶግ አግስ።<verse eid="GEN 40:23"/></para>
  <chapter eid="GEN 40"/>
  <chapter number="41" style="c" sid="GEN 41"/>
  <para style="s1">ግብፀ ካዋ አሙሆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1"/>ናምኡ ላይፈ ጉየ፥ ግብፀ ካዎይ አሙሆ አሙህስ። ሄ አሙሁዋን እ ናይለ ሻፋ ጋፃን ኤቅስ። <verse eid="GEN 41:1"/><verse number="2" style="v" sid="GEN 41:2"/>ላፑን ኦርደነ ሞ ሚዛት ናይለ ሻፋፐ ከይድ፥ ማታ ምሽን በእስ። <verse eid="GEN 41:2"/><verse number="3" style="v" sid="GEN 41:3"/>ኤንታፈ ካልድ፥ ሀራ ላፑን ግልቃ ሚዛት ናይለ ሻፋፐ ከይድ፥ ሻፋ ጋፃን ደእያ ሀራ ሚዛታ ማታን ኤቅዶሶና። <verse eid="GEN 41:3"/><verse number="4" style="v" sid="GEN 41:4"/>ሄ ግልቃ ሚዛት ላፑን ኦርደነ ሞ ሚዛታ ምትዶሶና። ሄሳፈ ጉየ፥ ካዎይ ባርክስ።<verse eid="GEN 41:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 41:5"/>እ ዛር ስክድ፥ ሀራ አሙሆካ አሙህስ። ላፑን ሎኦነ ሙሩታ ሞርኤት እስ ማቃ ቦላ ከይዶሶና። <verse eid="GEN 41:5"/><verse number="6" style="v" sid="GEN 41:6"/>ኤንታፈ ካልድ፥ ሌኦነ ዶሎሀ ባጋ ጫርኮን ሹልዳ ሀራ ላፑን ሞርኤት ከይዶሶና። <verse eid="GEN 41:6"/><verse number="7" style="v" sid="GEN 41:7"/>ሄ ሌእዳ ሞርኤት ሎኦነ ሙሩታ ሞርኤታ ምትዶሶና። ሄሳፈ ጉየ፥ ካዎይ ባርክድ አሙሆ ግደይሳ ኤርስ። <verse eid="GEN 41:7"/><verse number="8" style="v" sid="GEN 41:8"/>ሳአይ ዎንትን ስኮፈ እ ደንድያ ዎደ እያ ዎዛናይ ያርክስ። ሄሳ ግሾ፥ ግብፀን ደእያ ብታንቾታነ ኤራንቾታ ኡባ ካዎይ ፄግስድ ኤንታዉ ባ አሙሁዋ ኦድስ። ሽን እያዉ ሄ አሙሁዋ ብርሽያ አስ ይስ።<verse eid="GEN 41:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9"/>ኡሻ ካፖይ ሄ ዎደ ግብፀ ካዋኮ፥ “ታኒ ታ ናቁዋ ሀች ሀሳያይስ። <verse eid="GEN 41:9"/><verse number="10" style="v" sid="GEN 41:10"/>እስ ዎደ ካዎይ ባ አይለታ ሀንቀትድ፥ ታናነ ካ ካፑዋ ቃሾ ኬን የግስ። <verse eid="GEN 41:10"/><verse number="11" style="v" sid="GEN 41:11"/>ያን ደእሸ ኑ ናምአት አሙሆ አሙህዳ። ሄ አሙሆታስ ዱማ ዱማ ብርሸይ ደኤስ። <verse eid="GEN 41:11"/><verse number="12" style="v" sid="GEN 41:12"/>ሄ ዎደ ናገይሳታ ካፑዋ አይለይ፥ እብራወ ፓንይ፥ ኑራ ቃሾን ደኤስ። ኑኒ ኑ አሙሁዋ እያዉ ኦድን፥ እ ኑስ ሁጰን ሁጰን አሙሁዋ ብልስ። <verse eid="GEN 41:12"/><verse number="13" style="v" sid="GEN 41:13"/>ያንን፥ ሄ ሀኖት እ ኑስ ብልዳይሳዳ ሀንዶሶና። ሄስ አይበ ጊኮ፥ ታኒ ታ ሹማተኮ ስማስ፥ ሀንኮይ ካቀትስ” ያግስ።<verse eid="GEN 41:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14"/>ያትን፥ ግብፀ ካዎይ ዮሰፋ ፄግስስ። ኤንቲ እያ ቃሾ ኬፈ ኤለስድ ኤህዶሶና። እ ሜደትድ ባ ማኡዋ ላምድ፥ ካዋኮ ገልስ። <verse eid="GEN 41:14"/><verse number="15" style="v" sid="GEN 41:15"/>ካዎይ ዮሰፋ፥ “ታኒ አሙሆ አሙሀስ፥ ሽን ታዉ እስ አስካ ብላናዉ ዳንዳእቤና። ታኒ፥ ነ አሙሆ ብላናዉ ዳንዳኤይሳ ስአስ” ያግስ።<verse eid="GEN 41:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16"/>ዮሰፍ፥ “ታኒ ሄሳ ዳንዳእከ፥ ሽን ፆሳይ ካዋስ ሎኦነ ልከ ብርሸ እማና” ያግስ።<verse eid="GEN 41:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17"/>ካዎይ፥ “ታኒ ታ አሙሆራ ናይለ ሻፋ ጋፃን ኤቅዳሽን፥ <verse eid="GEN 41:17"/><verse number="18" style="v" sid="GEN 41:18"/>ላፑን ኦርደነ ሞ ሚዛት ናይለ ሻፋፐ ከይድ፥ ማታ ሞሶና። <verse eid="GEN 41:18"/><verse number="19" style="v" sid="GEN 41:19"/>ኤንታፈ ካልድ፥ ሀራ ላፑን ግልቃነ ላፍዳ ሚዛት ከይዶሶና። ታኒ ሄሳ መላ ግልቃ ሚዝ ግብፀ ቢታን ኡባካ በአ ኤርከ። <verse eid="GEN 41:19"/><verse number="20" style="v" sid="GEN 41:20"/>ሄ ግልቃነ ላፍዳ ሚዛት ኮይሮ ከይዳ ላፑን ሞ ሚዛታ ምትዶሶና። <verse eid="GEN 41:20"/><verse number="21" style="v" sid="GEN 41:21"/>ሽን ኤንታ ምትዳፐ ጉየ ካሰይሳዳ ግልቅ ኡትዳ ግሾ፥ ኤንቲ ምትዳባ ኦንካ ኤራናዉ ዳንዳእቤና። ሄሳፈ ጉየ ታኒ ባርካስ።<verse eid="GEN 41:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 41:22"/>“ታኒ ታ አሙሁዋን ቃስ ላፑን ሎኦነ ሙሩታ ሞርኤት እስ ማቃ ቦላ ከይዳይሳታ በአስ። <verse eid="GEN 41:22"/><verse number="23" style="v" sid="GEN 41:23"/>ኤንታፈ ካልድ፥ ሌኦነ ዶሎሀ ባጋ ጫርኩዋን ሹልዳ ሀራ ላፑን ሞርኤት ከይዶሶና። <verse eid="GEN 41:23"/><verse number="24" style="v" sid="GEN 41:24"/>ሄ ሌእዳ ሞርኤት ላፑን ሎኦ ሞርኤታ ምዶሶና። ታኒ ሀ አሙሁዋ ብታንቾታስ ኦዳስ፥ ሽን ታዉ አሙሁዋ ብርሽያ አስ በንትቤና” ያግስ።<verse eid="GEN 41:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25"/>ሄሳፈ ጉየ ዮሰፍ ግብፀ ካዋኮ፥ “ካዋ አሙሆታ ብርሸይ እስኖ። ፆሳይ ባ ኦና ሀንያባ ካዋስ ቆንጭስስ። <verse eid="GEN 41:25"/><verse number="26" style="v" sid="GEN 41:26"/>ሄ ላፑን ሎኦ ሚዛት ላፑን ላይታ፥ ቃስ ላፑን ሎኦ ሞርኤት ላፑን ላይታ፥ ሀ አሙሆታ ብርሸይ እስኖ። <verse eid="GEN 41:26"/><verse number="27" style="v" sid="GEN 41:27"/>ሄ ላፑን ግልቃነ ላፍዳ ሚዛት ላፑን ላይታ፥ ቃስ ዶሎሀ ባጋ ጫርኩዋን ሹልዳ፥ ሌኦ ላፑን ሞርኤት ላፑን ኮሻ ላይታ።<verse eid="GEN 41:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 41:28"/>“ታኒ ካዋስ ኦድዳይሳዳካ፥ ፆሳይ ባ ኦና ሀንያባ ካዋ በስስ። <verse eid="GEN 41:28"/><verse number="29" style="v" sid="GEN 41:29"/>ላፑን ዳሮ ካሎ ላይት ግብፀ ቢታ ኡባን ያና። <verse eid="GEN 41:29"/><verse number="30" style="v" sid="GEN 41:30"/>ሽን ሄሳፈ ጉየ፥ ላፑን ኮሻ ላይት ካልድ ያና። ሄ ዎደ ግብፀ ካሎይ ኡባይ ዶገታና፥ ኮሽ ቢታ ጫጫና። <verse eid="GEN 41:30"/><verse number="31" style="v" sid="GEN 41:31"/>ኮሻይ ዳሮ ኢታ ግድያ ግሾ ሄ ቢታ ካሎይ ዶገትድ አታና። <verse eid="GEN 41:31"/><verse number="32" style="v" sid="GEN 41:32"/>ናምኡ ኦግያን ካዋስ ሄ አሙሆይ በንትዳይ ፆሳይ ባ ቆፕዳባ ኦናዉ ቃንፅዳ ግሾሳ። ሄሳ ፆሳይ ማታ ዎደን ኦና።<verse eid="GEN 41:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33"/>“ሀእ ህዛ፥ ኔኒ ኤራንቾነ ጭንጫ አስ ኮያዳ ግብፀ ቢታን ሹማ። <verse eid="GEN 41:33"/><verse number="34" style="v" sid="GEN 41:34"/>ላፑን ካሎ ላይን ካፅያ ካፈ እቻሹ ኩሽያፐ እሱዋ ሺሻና አሳታ ሹማ። <verse eid="GEN 41:34"/><verse number="35" style="v" sid="GEN 41:35"/>ኤንቲ ያ ካሎ ላይን ካ ሺሽድ፥ ባንታ አዋተን ካታማን ካታማን ምንጅድ ዎና መላ ኪታ። <verse eid="GEN 41:35"/><verse number="36" style="v" sid="GEN 41:36"/>ቢታይ ኮሻን ዮና መላ ሀ ካይ ግብፀ ቢታን ላፑን ላይን ደንዳና ኮሻስ ምንጀትድ ደኦ” ያግስ።<verse eid="GEN 41:36"/></para>
  <para style="s1">ዮሰፍ ግብፀ ቢታን ሹመተ</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37"/>ያትን ሄ ኦዳይ ግብፀ ካዋስነ እያ ሞርናታስ ሎኦ ግድድ በንትስ። <verse eid="GEN 41:37"/><verse number="38" style="v" sid="GEN 41:38"/>ሄሳ ግሾ፥ ካዎይ ኤንታኮ፥ “ዮሰፋፐ አያ ሀራ ፆሳ አያናራ ደእያ አስ ደማናዉ ዳንዳኦኮ” ያግስ።<verse eid="GEN 41:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 41:39"/>ሄሳፈ ጉየ፥ ካዎይ ዮሰፋ፥ “ፆሳይ ሀይሳ ኡባ ነና ኤርስዳ ግሾ፥ ነ መላ ኤራንቾይነ ጭንጫ አስ ኦንካ ባዋ። <verse eid="GEN 41:39"/><verse number="40" style="v" sid="GEN 41:40"/>ታኒ ነና ታ ቢታን ሹማስ። ታ አሳ ኡባይ ነዉ ኪተታና። ታፐ ሀር ኔፐ አያ ኦንካ ባዋ። <verse eid="GEN 41:40"/><verse number="41" style="v" sid="GEN 41:41"/>ሄኮ፥ ታኒ ነና ግብፀ ቢታ ኡባ ቦላ ሹማስ” ያግስ። <verse eid="GEN 41:41"/><verse number="42" style="v" sid="GEN 41:42"/>ሄሳፈ ጉየ፥ ካዎይ ባ ፓራምያ ምግዱዋ ባ ብራያፈ ከስድ፥ ዮሰፋ ብራን አስ። ቦንቾ ማኦነ ቆ ዎርቃ እያ ማይዝስ። <verse eid="GEN 41:42"/><verse number="43" style="v" sid="GEN 41:43"/>ካዎይ ባ ናምአን ፓራ ጋርያ ዮሰፋ ቶግስስ። ቦንቾ ዎታዳረይ፥ “ዝግተ! ዝግተ!” ያግሸ እያፐ ስንራ ሄመቴስ። ሄሳዳ ኦድ፥ ካዎይ እያ ግብፀ ቢታ ኡባ ቦላ ሹምስ።<verse eid="GEN 41:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="GEN 41:44"/>ሄሳፈ ጉየ፥ ካዎይ ዮሰፋ፥ “ታኒ ካዎ ግድኮካ ነ ኪቶና ኦንካ ግብፀ ቢታ ኡባን ባ ኩሽያ ዎይኮ ባ ቶሁዋ ቃፆፎ” ያግስ። <verse eid="GEN 41:44"/><verse number="45" style="v" sid="GEN 41:45"/>ካዎይ ዮሰፋ፥ “ፃፍናት-ፓእና” ግድ ሱንስ። እ እያዉ ኦና ካታማ ካህንያ ጶፅፋራ ናእዉ አስናቶ ማቾ እሚስ። ያንን፥ ዮሰፍ ግብፀ ቢታ ኡባ ቦላ ማታ ኤክስ።<verse eid="GEN 41:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 41:46"/>ዮሰፍ ግብፀ ካዋስ ኦሶ ኦይክያ ዎደ፥ እያዉ ላይ ሀስታማ። ዮሰፍ ካዋ ስንፈ ከይድ፥ ግብፀ ቢታ ኡባ ግዶን ሄመትስ። <verse eid="GEN 41:46"/><verse number="47" style="v" sid="GEN 41:47"/>ሄ ላፑን ካሎ ላይን ቢታን ዳሮ ካ ካፅስ። <verse eid="GEN 41:47"/><verse number="48" style="v" sid="GEN 41:48"/>ዮሰፍ ግብፀ ቢታን ሄ ላፑን ካሎ ላይ ካ ኡባ ሺሽድ፥ ካታማታን ምንጅስ። እስ እስ ካታማ ዩሹዋን ደእያ ጋድያፐ ካ ኡባ ሄ ካታማታን ሺሽስ። <verse eid="GEN 41:48"/><verse number="49" style="v" sid="GEN 41:49"/>ዮሰፍ አባ ሻፍያ መላ ዳሮ ካ ሺሽስ። ካ ዳሮተፈ ደንዶይሳን ማካናዉ ዳንዳኤትቦና ግሾ፥ ማክ ማክ ቆለይሳ አጋግስ።<verse eid="GEN 41:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50"/>ኮሻ ላይ ያናፐ ስን፥ ኦና ካታማ ካህነ ጶፅፋራ ናኤ አስናትፐ ዮሰፍ ናምኡ አደ ናይታ የልስ። <verse eid="GEN 41:50"/><verse number="51" style="v" sid="GEN 41:51"/>ዮሰፍ ባ ባይራ ናኣ ሱን፥ “ፆሳይ ታና ታ መቱዋነ ታ አዋ ሶ አሳ ኡባ ዶግስስ” ግድ ምናሰ<note caller="+" style="f"><char style="fr" closed="false">41:51 </char><char style="fq" closed="false">ምናሰ፦ </char><char style="ft" closed="false">እብራወ ዶናን ሀ ሱን ብርሸይ “ዶግሴስ” ጉሱ።</char></note> ግድ ሱንስ። <verse eid="GEN 41:51"/><verse number="52" style="v" sid="GEN 41:52"/>ናምአን ናኣ ሱንካ፥ “ፆሳይ ታ መቶትዳ ቢታን ታዉ ናአ እሚስ” ግድ ኤፍሬማ<note caller="+" style="f"><char style="fr" closed="false">41:52 </char><char style="fq" closed="false">ኤፍሬማ፦ </char><char style="ft" closed="false">እብራወ ዶናን ሀ ሱን ብርሸይ “ናአ እሜስ” ጉሱ።</char></note> ግድ ሱንስ።<verse eid="GEN 41:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53"/>ግብፀ ቢታን ደእያ ሄ ላፑን ካሎ ላይት አዶሶና። <verse eid="GEN 41:53"/><verse number="54" style="v" sid="GEN 41:54"/>ዮሰፍ ኦድዳይሳዳ ላፑን ኮሻ ላይት ካል ይዶሶና። ሀራ ቢታ ኡባን ኮሽ ከይስ፥ ሽን ግብፀ ቢታ ኡባን ካይ ደኤስ። <verse eid="GEN 41:54"/><verse number="55" style="v" sid="GEN 41:55"/>ግብፀ ቢታይ ኡባይ ኮሻትዳ ዎደ፥ አሳይ ካስ ካዋኮ ዋስዶሶና። ካዎይ ግብፀ አሳ ኡባ፥ “ዮሰፋኮ ብድ፥ እ ኦደይሳ ኦተ” ያግድ ኪትስ።<verse eid="GEN 41:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 41:56"/>ኮሻይ ግብፀ ቢታ ኡባ ጋክዳ ዎደ፥ ዮሰፍ ካ ምንጅዳ ሻለታ ኡባ ዶይድ፥ ካ ግብፀ አሳስ ባይዝስ። <verse eid="GEN 41:56"/><verse number="57" style="v" sid="GEN 41:57"/>ቢታ ኡባን ኮሽ ሱልዳ ግሾ፥ ሳአን ደእያ አሳ ኡባይ ካ ዮሰፋፐ ሻማናዉ ግብፀ ይዶሶና።<verse eid="GEN 41:57"/></para>
  <chapter eid="GEN 41"/>
  <chapter number="42" style="c" sid="GEN 42"/>
  <para style="s1">ዮሰፋ እሻት ግብፀ ቢታን</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1"/>ያይቆብ ግብፀን ካ ደኤይሳ ስእዳ ዎደ ባ አደ ናይታ፥ “ህንተ እሶይ እሱዋ አይስ ፄሌቲ? <verse eid="GEN 42:1"/><verse number="2" style="v" sid="GEN 42:2"/>ግብፀን ካ ደኤይሳ ታኒ ስአስ፤ ያ ብድ፥ ኑኒ ሀይቆና መላ ጉ ካ ሻምተ” ያግስ። <verse eid="GEN 42:2"/><verse number="3" style="v" sid="GEN 42:3"/>ያትን፥ ዮሰፋ እሻት ታማት ካ ሻማናዉ ግብፀ ብዶሶና። <verse eid="GEN 42:3"/><verse number="4" style="v" sid="GEN 42:4"/>ሽን ያይቆብ እ ቆሄታና ግድ ህርግዳ ግሾ ዮሰፋ እሻ ብንያመ እያ እሻታራ የድቤና። <verse eid="GEN 42:4"/><verse number="5" style="v" sid="GEN 42:5"/>ካናነ ቢታን ዎልቃማ ኮሽ ደእያ ግሾ፥ ካ ሻማናዉ በይሳታራ እስራኤለ አደ ናይት ግብፀ ገልዶሶና።<verse eid="GEN 42:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6"/>ሄ ዎደ ዮሰፍ ሄ ቢታ አይስያ ግሾ ቢታን ደእያ አሳ ኡባስ ካ ባይዜስ። ሄሳ ግሾ፥ ዮሰፋ እሻት ያ ጋክዳ ዎደ ባንታ ሶምኡዋ ሳአ ጋድ እያዉ ዝግዶሶና። <verse eid="GEN 42:6"/><verse number="7" style="v" sid="GEN 42:7"/>ዮሰፍ ባ እሻታ በእዳ መላካ ኤር አግስ። ሽን እ ኤንታ ኤሮና አሳዳ ሀንድ፤ ኤንታኮ፥ “ህንተ አዉፐ ይደት?” ያግድ ኦይችስ።</para>
  <para style="p" vid="GEN 42:7">ኤንቲ፥ “ካ ሻማናዉ፥ ካናነ ቢታፈ ይዳ” ያግዶሶና።<verse eid="GEN 42:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8"/>ዮሰፍ ባ እሻታ ኤርስ፥ ሽን ኤንቲ እያ ኤርቦኮና። <verse eid="GEN 42:8"/><verse number="9" style="v" sid="GEN 42:9"/>ዮሰፍ ኤንታባ አሙህዳ ባ አሙሁዋ አኬክድ ኤንታኮ፥ “ህንተ ዎቻናዉ ይዳ አስ፥ ህንተ ኑ ቢታን ናጎይ ለፕያ ባጋይ አዉነኮ በአናዉ ይደታ” ያግስ።<verse eid="GEN 42:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10"/>ኤንቲ፥ “አካይ፥ ኑ ጎዳዉ፥ ኑኒ ዎቻናዉ ይዳ አስ ግዶኮ። ኑኒ ነ አይለት ካ ሻማናዉ ይዳ። <verse eid="GEN 42:10"/><verse number="11" style="v" sid="GEN 42:11"/>ኑኒ ኡባይካ እስ አዋ ናይታ። ኑኒ ነ አይለት አማነትያ አስ” ያግዶሶና።<verse eid="GEN 42:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12"/>ዮሰፍ ኤንታኮ፥ “አካይ፥ ህንተ ኑ ቢታን ናጎይ ለፕያ ባጋይ አዉነኮ በአናዉ ይደታ” ያግስ።<verse eid="GEN 42:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13"/>ሽን ኤንቲ፥ “ኑኒ ነ አይለት ካናነ ቢታን ደእያ እስ ኡራ ናይታ፤ ኑኒ ታማነ ናምኡ እሻንታ። ዉርሰ ካሎይ ሀእ ኑ አዋራ ሶን ደኤስ፥ እሶይ ሀይቅስ” ያግዶሶና።<verse eid="GEN 42:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14"/>ዮሰፍ ኤንታኮ፥ “ታኒ ህንተዉ ኦድዳይሳዳ ህንተ ቢታ ዎቸይሳታ። <verse eid="GEN 42:14"/><verse number="15" style="v" sid="GEN 42:15"/>ህንተ ፓጨታናይስ ሀይሳና፤ ቱማ ካዎይ ሀይቆ፥ ህንተ ዉርሰ ካሎ እሻይ ሀይሳ ዮና እፅኮ፥ ህንተ ሀ በሳፈ ቤከታ። <verse eid="GEN 42:15"/><verse number="16" style="v" sid="GEN 42:16"/>ህንተ ኦደይስ ቱማ ግደይሳ ፓጫናዉ፥ ህንተፈ እሱዋ ኪትተ። እ ህንተ እሻ ኤክድ ዮ፥ አትዳይሳት ቃሾ ኬን ጋምኤታ። ሄስ ሃኖና፥ ካዎይ ሀይቆ፥ ህንተ ቢታ ዎቸይሳታ” ያግስ። <verse eid="GEN 42:16"/><verse number="17" style="v" sid="GEN 42:17"/>ኤንታና ሄ ጋላስ ቃሾ ኬን ቃችስ።<verse eid="GEN 42:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18"/>ሄን ጋላሳን ዮሰፍ ኤንታኮ፥ “ታኒ ፆሰ ያይያ አስ። ያንያ ግሾ፥ ህንተ እስባ ኦኮ ህንተ ሸምፑዋ አሻና። <verse eid="GEN 42:18"/><verse number="19" style="v" sid="GEN 42:19"/>ህንተ ቱማካ አማነትያ አሰ ግድኮ፥ ህንተ እሻታፐ እሶይ ሀይሳን ቃሾ ኬን ደኦ፤ አትዳይሳት ኮሻትያ ህንተ ሶ አሳስ ካ ኤፍተ፤ <verse eid="GEN 42:19"/><verse number="20" style="v" sid="GEN 42:20"/>ሽን ህንተ ዉርሰ እሻ ታኮ ኤህኮ፥ ህንተ ቃላይ ቱማታና፤ ህንተካ ሀይቆና አታና” ያግስ።</para>
  <para style="p" vid="GEN 42:20">ኤንትካ እያ ኦዳ ኤሮ ግድ ኤክዶሶና።<verse eid="GEN 42:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 42:21"/>ኤንቲ እሶይ እሱዋኮ፥ “ቱማ ኑኒ ኑ እሻስ ኦዳባይ ኑና ካኤስ። እ ባ ሸምፑዋስ ዋትዋትድ ዎስያ ዎደ ኑኒ ስእሸ እፅዳ። ሄሳ ግሾ፥ ሀ ዋየይ ኑና ጋክስ” ያግዶሶና።<verse eid="GEN 42:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22"/>ሮቤል፥ “ታኒ ህንተና፥ ናኣ ቦላ ናጋራ ኦፍተ ጋዳ ኦዳስ፥ ሽን ህንተ ስኦና እፅደታ። ሀእ እያ ሱይ ኑና አቼስ” ያግስ። <verse eid="GEN 42:22"/><verse number="23" style="v" sid="GEN 42:23"/>ዮሰፍ ኤንታራ ቱርጁማነን ኦደትያ ግሾ ኤንቲ ግያባ እ ኤረይሳ ኤንቲ አኬክቦኮና፤ <verse eid="GEN 42:23"/><verse number="24" style="v" sid="GEN 42:24"/>እ ኤንታፈ ሀራሶ ብድ ዬክስ። ሽን ዛር ኤንታኮ ይድ፥ ኤንታዉ ጉጅድካ ኦድስ። እ ስሞና ኤንታ ግዶፈ ከስድ ኤንቲ በእሽን ቃችስ።<verse eid="GEN 42:24"/></para>
  <para style="s1">ዮሰፋ እሻት ካናነ ስሙዋ</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25"/>ዮሰፍ ባ አይለታ፥ “ካ ኤንታ ኦጎሩዋን ኩንተ፤ ኤንታ ሚሽያካ ዛሪድ፥ ኤንታ ኦጎሩዋን ኦጎሩዋን የግተ። ኤንታዉ ኦገስ ሽንቀካ እምተ” ያግድ ኪትስ። <verse eid="GEN 42:25"/><verse number="26" style="v" sid="GEN 42:26"/>ኤንቲ እ ግዳይሳዳ ኦዳፐ ጉየ፥ ዮሰፋ እሻት ካ ባንታ ሀረታ ቦላ ጫንድ ብዶሶና።<verse eid="GEN 42:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 42:27"/>ኤንቲ ቃማ አቅያ በሳን ኤንታፈ እሶይ ባ ሀርያስ ካፈ የጋናዉ ባ ኦጎሩዋ ብልድ፥ ሄ ኦጎሩዋ ዶናን ደእያ ባ ሚሽያ ደምስ። <verse eid="GEN 42:27"/><verse number="28" style="v" sid="GEN 42:28"/>እ ባ እሻታኮ፥ “ታ ሚሸይ ታዉ ስምስ፤ ቱማ ሀይሳ በእተ፤ ታ ኦጎሩዋን ደኤስ” ያግስ።</para>
  <para style="p" vid="GEN 42:28">ኤንቲ ዳጋምድ ኮኮርሸ፥ እሶይ እሱዋኮ ስሚድ፥ “ፆሳይ ኑ ቦላ ኦዳባይ ሀይስ አይቤ?” ያግዶሶና።<verse eid="GEN 42:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29"/>ኤንቲ ካናነ ቢታን ደእያ ባንታ አዋ ያይቆባኮ ይድ፥ ባንታና ጋክዳባ ኡባ እያዉ ኦድዶሶና። <verse eid="GEN 42:29"/><verse number="30" style="v" sid="GEN 42:30"/>ኤንቲ እያኮ፥ “ሄ ቢታ ሃርያ ኡራይ፥ ኑና ሄ ቢታ ዎችያ አሳዳ ኦድ ኑ ቦላ ይሎትድ ኦደትስ። <verse eid="GEN 42:30"/><verse number="31" style="v" sid="GEN 42:31"/>ሽን ኑኒ እያኮ፥ ‘ኑኒ አማነትያ አስ፥ ቢታ ዎቸይሳታ ግዶኮ። <verse eid="GEN 42:31"/><verse number="32" style="v" sid="GEN 42:32"/>ኑኒ ታማነ ናምኡ እሻንት እስ አዋ ናይታ። እሶይ ሀይቅስ፤ ዉርሰ ካሎይ ካናነ ቢታን ሀእ ኑ አዋራ ደኤስ’ ያግዳ። <verse eid="GEN 42:32"/><verse number="33" style="v" sid="GEN 42:33"/>ያትን ሄ ቢታ ሃርያ ኡራይ ኑና፥ ‘ህንተ አማነትያ አሰ ግደይሳ ታኒ ኤራና መላ ህንተ እሻታፐ እሱዋ ሀይሳን ታ ማታን አግድ፥ ኮሻትያ ህንተ ሶ አሳስ ካ ኤክድ ቢተ። <verse eid="GEN 42:33"/><verse number="34" style="v" sid="GEN 42:34"/>ህንተ ቢታ ዎቸይሳታ ግዶና፥ አማነትያ አስ ግደይሳ ታኒ ኤራና መላ፥ ህንተ ዉርሰ እሻ ታኮ ኤክድ ዪተ። ያትኮ፥ ታኒ ሀን አትዳ ህንተ እሻ ህንተዉ ዛራዳ እማና። ህንተካ ሀ ቢታን ደእድ ዛልአናዉ ዳንዳኤታ’ ” ያግዶሶና።<verse eid="GEN 42:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35"/>ኤንቲ ባንታ ኦጎሩዋፐ ካ ቆልሸ፥ ባንታ ኦጎሩዋን ኦጎሩዋን ባንታ ሚሽያ ቃሹዋራ ኡትዳይሳ ደምዶሶና። ኤንትነ ኤንታ አዋይ ሄ ቃሹዋራ ደእያ ሚሽያ በእድ ያይዶሶና። <verse eid="GEN 42:35"/><verse number="36" style="v" sid="GEN 42:36"/>ኤንታ አዋ ያይቆብ ኤንታኮ፥ “ህንተ ታና ታ ናይታፐ መላ አሽደታ። ዮሰፍ ባዋ፥ ስሞን ባዋ፥ ሀእ ቃስ ብንያመ ኤፋናዉ ኮዬታ። ኡባባይ ታዉ ዞኮ ዛርስ” ያግስ።<verse eid="GEN 42:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37"/>ሄሳፈ ጉየ፥ ሮቤል ባ አዋኮ፥ “ታኒ ብንያመ ነዉ ዛራዳ ኤሆና እፅኮ፥ ታ አደ ናይታ ናምኣካ ዎ። ታና አማነታዳ እያ ታ ኩሸን የጋ፤ ታኒ እያ ዛራዳ ኤሀና” ያግስ።<verse eid="GEN 42:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38"/>ሽን ያይቆብ ኤንታኮ፥ “ታ ናአይ ህንተራ ቤና፤ እያ እሻይ ሀይቅን፥ አትዳይ እያ ፃላላ። ህንተ ኤፍሽን፥ ኦገን ኢታባይ እያ ጋክኮ፥ ህንተ ታ ጭማተ አፉ ሙዝሸ ታ ሀይቁዋ ማታየታ” ያግስ።<verse eid="GEN 42:38"/></para>
  <chapter eid="GEN 42"/>
  <chapter number="43" style="c" sid="GEN 43"/>
  <para style="s1">ዮሰፋ እሻት ናምአን ግብፀን</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1"/>ካናነ ቢታን ኮሻይ ሀእካ ካሰይሳፈ አድ ዎልቃምስ። <verse eid="GEN 43:1"/><verse number="2" style="v" sid="GEN 43:2"/>ያንን፥ ኤንቲ ግብፀፈ ኤህዳ ካ ኡባ ምድ ኦንግን፥ ኤንታ አዋይ፥ “ቃስካ ግብፀ ብድ ኑስ ጉ ካ ሻምተ” ያግስ።<verse eid="GEN 43:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3"/>ሽን ይሁድ፥ “ሄ ኡራይ ኑና፥ ‘ህንተ እሻይ ህንተራ ዮና እፅኮ፥ ታ ሶምኡዋ ዛር በኤከታ’ ያግድ ምንድ ኦድስ። <verse eid="GEN 43:3"/><verse number="4" style="v" sid="GEN 43:4"/>ኔኒ ኑ እሻ ኑራ የድኮ፥ ኑኒ ግብፀ ብድ ነዉ ካ ሻማና። <verse eid="GEN 43:4"/><verse number="5" style="v" sid="GEN 43:5"/>ሽን ሄ ኡራይ፥ ‘ህንተ እሻይ ህንተራ ዮና እፅኮ ህንተ ታ ሶምኡዋ ዛር በኤከታ’ ” ያግዳ ግሾ፥ ኔኒ እያ የዶናባ ግድኮ ኑኒ ቦኮ።<verse eid="GEN 43:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6"/>ያትን እስራኤለይ፥ “ህንተ፥ ‘ኑስ ሀራ እሽ ደኤስ’ ግድ ኦድድ ሀ መቱዋ ታ ቦላ አይስ ኤህደቲ?” ያግስ።<verse eid="GEN 43:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7"/>ኤንቲ ዛሪድ፥ “ሄ ኡራይ ኑባነ ኑ ሶ አሳባ ምንድ ኦይችስ። እ ኑኮ፥ ‘ህንተ አዋይ ፓፃ ደኢ? ህንተዉ ሀራ እሽ ደኢ?’ ያግድ ኦይችስ። ኑኒ እ ኦይችዳይሳ እያዉ ዛርዳ። እ ኑና፥ ‘ህንተ እሻ ኤክ ዪተ’ ጋናባ ኑ አዉደ ኤርዶ?” ያግዶሶና።<verse eid="GEN 43:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8"/>ይሁድ ባ አዋ እስራኤለኮ፥ “ኑኒ፥ ኔንነ ኑ ናይት ኮሻን ሀይቃናፐ ናኣ ታራ የዳ፥ ኑኒ ባና። <verse eid="GEN 43:8"/><verse number="9" style="v" sid="GEN 43:9"/>ናአ ታ ዋሰተን እማ፤ እያባ ታና ኦይቻ። ታኒ እያ ነዉ ሳሮ ዛራዳ ኤሆና እፅኮ፥ ታ ደኦ ኡባን ነ ባደይ ታና ጋኮ። <verse eid="GEN 43:9"/><verse number="10" style="v" sid="GEN 43:10"/>ኑ ጋምኦናባ ግድያኮ፥ ሀኖደ ናምአን ያ ስማና ሽን” ያግስ።<verse eid="GEN 43:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11"/>ኤንታ አዋይ እስራኤለይ፥ “ሄሳ ግድኮ ሃረይሳስ ኩሸ ገንያባ፥ ሀ ቢታን ካፅያባ ኡባፈ ሎኦባ ዶርተ። ሄስካ፥ ቅባተ፥ ሽቶ፥ ዱማ ዱማ ሳዎ፥ ኤስነ፥ ኦቾሎነ ህንተ ኦጎሩዋን የግድ፥ ኤክድ ቢተ። <verse eid="GEN 43:11"/><verse number="12" style="v" sid="GEN 43:12"/>ህንተ ኦጎሩዋ ዶናን ስምዳ ሚሸይ ባለትዳባ ግዳናዉ ዳንዳእያ ግሾ፥ ሚሽያ ናምኡ ኩሸ ኦድ ኤክ ቢተ። <verse eid="GEN 43:12"/><verse number="13" style="v" sid="GEN 43:13"/>ህንተ እሻ ኤክድ፥ ሄ ኡራኮ ኤለስድ ጉየ ቢተ። <verse eid="GEN 43:13"/><verse number="14" style="v" sid="GEN 43:14"/>እ ሀንኮ ህንተ እሻነ ብንያመ ህንተራ የዳና መላ ኡባ ዳንዳእያ ፆሳይ ሄ ኡራይ ህንተዉ ቃታናዳ ኦ። ታና ግድኮ፥ ታ ናይታፐ መላ አትኮካ አታስ” ያግስ።<verse eid="GEN 43:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15"/>ሄሳ ግሾ፥ እሻንት ዎላ ባንታ እምያባታ፥ ናምኡ ኩሸ ሚሽያነ ብንያመ ባንታራ ኤክድ ብዶሶና። ኤንቲ ግብፀ ጋክድ፥ ዮሰፋ ስን ሺቅዶሶና። <verse eid="GEN 43:15"/><verse number="16" style="v" sid="GEN 43:16"/>ዮሰፍ ብንያመ ኤንታራ በእዳ ዎደ ባ ኬ ካፑዋኮ፥ “ሀ አሳታ ታ ሶ ኤካዳ ባ። እስ መሄ ሹካዳ ጊግሳ፤ ኤንቲ ካ ታራ ማና” ያግድ ኪትስ።<verse eid="GEN 43:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 43:17"/>ያትን ካፖይ፥ ዮሰፍ ኪትዳይሳዳ ሄ አሳታ እያ ሶ ኤፍስ። <verse eid="GEN 43:17"/><verse number="18" style="v" sid="GEN 43:18"/>ኤንቲ ዮሰፋ ሶ ብሸ፥ ያይድ፥ “ኤንቲ ኑና ሀይሳ ኤህዳይ ኮይሮ ኑ ኦጎሩዋን ስምዳ ሚሽያ ግሾ ግዶና አገና። ኤንቲ ኑና ቆህድ አይለተን ሃሮናነ ኑ ሀረታ ኤኮና አጎኮና” ያግ ህርግዶሶና።<verse eid="GEN 43:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 43:19"/>ሄሳ ግሾ፥ ኤንቲ ዮሰፋ ሶ ፐንገ ጋክድ፥ ኬ ካፑዋ ኦድስዶሶና። <verse eid="GEN 43:19"/><verse number="20" style="v" sid="GEN 43:20"/>“ጎዳዉ፥ ኑኒ ኮይሮ ካ ሻማናዉ ሀይሳ ይዳ። <verse eid="GEN 43:20"/><verse number="21" style="v" sid="GEN 43:21"/>ጉየ ስምሸ ኑኒ ቃማ አቅያ በሳን ኦጎሩዋ ብልያ ዎደ ሁጰን ሁጰን ኑ ሚሸይ ፓጮና ኑ ኦጎሩዋን ደኤይሳ ደምዳ። ሄኮ፥ ኑኒ ሄ ሚሽያ ጉየ ኤክ ይዳ። <verse eid="GEN 43:21"/><verse number="22" style="v" sid="GEN 43:22"/>ሀእ ኑኒ ካ ሻማናዉ ሀራ ሚሸ ኦይክ ይዳ። ኑ ሚሽያ ኑ ኦጎሩዋን ኦን የግዳኮ ኤሮኮ” ያግዶሶና።<verse eid="GEN 43:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23"/>እ ዛሪድ፥ “አይኮይ ባዋ፥ ያዮፍተ፤ ህንተ ፆሳይ፥ ህንተ አዋ ፆሳይ፥ ህንተ ኦጎሩዋን ህንተዉ ሚሸ እሚስ። ታኒ ህንተ ጭግዳ ሚሽያ ኩመ ኤካስ” ያግስ። ሄሳፈ ጉየ፥ ስሞና ኤንታኮ ከስስ።<verse eid="GEN 43:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24"/>ሄ ኡራይ ሄ አሳታ ዮሰፋ ሶ ኤፍድ፥ ኤንታ ቶሁዋስ ሃ ኤህን፥ ኤንቲ ሜጨትዶሶና። ኤንታ ሀረታስካ ምያባ የግስ። <verse eid="GEN 43:24"/><verse number="25" style="v" sid="GEN 43:25"/>ኤንቲ ዮሰፋራ ካ ማናይሳ ስእዳ ግሾ ባንታ እማናባታ ዮሰፋስ ጊግስዶሶና።<verse eid="GEN 43:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 43:26"/>ዮሰፍ ባ ሶ ገልዳ ዎደ ኤንቲ ኤህዳ ባንታ እምያባታ እያዉ እምድ፥ እያ ስንን ሳአ ጋክድ ዝግዶሶና። <verse eid="GEN 43:26"/><verse number="27" style="v" sid="GEN 43:27"/>እ ኤንታ ሳሮተ ኦይች ስሚድ፥ “ህንተ ታዉ ኦድዳ ህንተ ጭምዳ አዋይ ሎኦ ደኢ? ሀእካ እ ፓፃ ደኢ?” ያግስ።<verse eid="GEN 43:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28"/>ኤንቲ፥ “ኤ፥ ነ አይለይ፥ ኑ አዋይ ፓፃ ደኤስ፤ እ ሎኦ” ያግድ፥ ሆክድ እያዉ ዝግዶሶና።<verse eid="GEN 43:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29"/>እ ባ አየ ናኣ ብንያመ በእዳ ዎደ ኤንታኮ፥ “ህንተ ኦድዳ ዉርሰ ህንተ እሻይ ሀይሴ?” ያግስ። ብንያመ፥ “ታ ናአዉ፥ ነና ፆሳይ አንጆ” ያግስ። <verse eid="GEN 43:29"/><verse number="30" style="v" sid="GEN 43:30"/>ዮሰፍ፥ እያ እሻባይ እያዉ ጎምፓን ሴልዳ ግሾ፥ ኤለስድ፥ ቆልአ ገልድ ያን ዬክስ።<verse eid="GEN 43:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 43:31"/>እ ባ ሶምኡዋ ሜጨትዳፐ ጉየ ከይድ ባና ምንድ፥ ካ አና መላ ኪትስ።<verse eid="GEN 43:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 43:32"/>ኤንቲ ዮሰፋስ ዱማ፥ እያ እሻታስ ዱማ አዶሶና። ግብፀ አሳይ እብራወ አሳታራ እስፈ መይስ ባንታና ካዉሽያባ ኦ ፄልያ ግሾ እያራ ምያ ግብፀ አሳታስ ዱማ አዶሶና። <verse eid="GEN 43:32"/><verse number="33" style="v" sid="GEN 43:33"/>ኤንቲ ዮሰፋ ስንን ባይራይ ባ ባይራተን፥ ካሎይ ባ ካሎተን ማራን ኡትዶሶና። ኤንቲ እሶይ እሱዋ ፄልድ፥ ኤንታ ዋትድ ኡትስዳኮ በእድ ማላለትዶሶና። <verse eid="GEN 43:33"/><verse number="34" style="v" sid="GEN 43:34"/>ዮሰፋ ጋይታፐ ኤንታዉ ቁም ግሸቴስ፥ ሽን ብንያመስ ሀራታፐ አድ እቻሹ ኩሸ እሚስ። ያንድ፥ ኤንቲ ዮሰፋራ ምድ ኡይድ ኡፋይትዶሶና።<verse eid="GEN 43:34"/></para>
  <chapter eid="GEN 43"/>
  <chapter number="44" style="c" sid="GEN 44"/>
  <para style="s1">ይዳ ዋንጫ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1"/>ዮሰፍ ባ ኬ ካፑዋ፥ “ኔኒ ሀ አሳት ቶካናዉ ደንዳእዳ ኬና ኤንታ ኦጎሩዋን ካ ኩን። ኤንታ ኡባ ሚሽያ ኤንታ ኦጎሩዋ ዶናን ዶናን የጋ። <verse eid="GEN 44:1"/><verse number="2" style="v" sid="GEN 44:2"/>ያታዳ ዉርሰ ካሉዋ ኦጎሩዋ ዶናን ታ ብራ ዋንጫነ እ ሻማናዉ ኤህዳ ሚሽያ የጋ” ያግድ ኪትስ። እ ዮሰፍ ግዳይሳዳ ኦስ።<verse eid="GEN 44:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 44:3"/>ሳእ ዎንትን ሄ አሳት ባንታ ሀረታ ኤክድ ባናዉ ደንድዶሶና። <verse eid="GEN 44:3"/><verse number="4" style="v" sid="GEN 44:4"/>ኤንቲ ሄ ካታማፐ ከይድ ሃክ ቦና ደእሽን፥ ዮሰፍ ባ ኬ ካፑዋኮ፥ “ሀ አሳታ ጌዶ ካላ። ኔኒ ኤንታ ጋክዳ ዎደ ኤንታኮ፥ ‘ህንተ አይስ ኬሀ ኢታን ዛርደቲ? <verse eid="GEN 44:4"/><verse number="5" style="v" sid="GEN 44:5"/>ሀይስ ታ ጎዳይ ኡየይሳነ ፁራባ ደምያ ዋንጫ ግደይሳ ኤረከቲ? አይስ ካይሶትደቲ? ሀይስ ህንተ ኦዳባይ ዳሮ ኢታባ’ ያጋ” ያግስ።<verse eid="GEN 44:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6"/>ያትን እ ኤንታ ጌዶ ካል ጋክድ፥ ሄ ግዳይሳዳካ ኤንታዉ ኦድስ። <verse eid="GEN 44:6"/><verse number="7" style="v" sid="GEN 44:7"/>ሽን ኤንቲ፥ “ጎዳዉ ሀይሳ መላባ አይስ ኦደታይ? ሄሳ መላባ ኦሶይ ኑፐ ነ አይለታፐ ሃኮ። <verse eid="GEN 44:7"/><verse number="8" style="v" sid="GEN 44:8"/>ኑኒ ሀር አቶሽን፥ ኑ ኦጎሩዋ ዶናፐ ደምዳ ሚሽያ ካናነ ቢታፈ ጉየ ዛሪድ ነዉ ኤህዳይሳ ኤራሳ። ነ ጎዳ ኬፈ ኑኒ ዎርቃ ዎይኮ ብራ ዋት ካይሶታኔ? <verse eid="GEN 44:8"/><verse number="9" style="v" sid="GEN 44:9"/>ነ አይለታ ግዶን ሄ ዋንጫይ በንትዳ ኡራይ ሀይቆ። ቃስ አትዳ ኑካ ኑ ጎዳስ አይለ ግዳና” ያግዶሶና።<verse eid="GEN 44:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10"/>እ ኤንታኮ፥ “ሄሳ ግድኮ ሎኦ፥ ህንተ ግዳይሳዳ ሀኖ። ዋንጫ ኤክዳ ኦንካ ታ አይለ ግዳና፤ አትዳይሳት ሳሮን ቤታ” ያግስ።<verse eid="GEN 44:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 44:11"/>ሄሳፈ ጉየ፥ ኤንቲ ኤለስድ ባንታ ኦጎሩዋ ኦጎሩዋ ሳአን ዎድ ብልዶሶና። <verse eid="GEN 44:11"/><verse number="12" style="v" sid="GEN 44:12"/>ሄ ካፖይ ኡባፈ ባይራ ኦጎሩዋፐ ዶምድ ዉርሰ ካሉዋይሳ ጋካናስ ኮይድ፥ ሄ ዋንጫ ብንያመ ኦጎሩዋፐ ደምስ። <verse eid="GEN 44:12"/><verse number="13" style="v" sid="GEN 44:13"/>ሄሳን ኤንቲ አዛንድ፥ ባንታ ማኡዋ ፔዶሶና። ባንታ ኦጎሩዋ ሀረታ ቦላ ጫንድ፥ ጉየ ካታማ ስምዶሶና።<verse eid="GEN 44:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14"/>ይሁድ ባ እሻታራ ዮሰፋኮ ገልያ ዎደ ዮሰፍ ሶን ደኤስ፤ ኤንቲ እያ ስንን ሳአን ጉፋንዶሶና። <verse eid="GEN 44:14"/><verse number="15" style="v" sid="GEN 44:15"/>ዮሰፍ ኤንታኮ፥ “ህንተ አይብ ፓላባ ኦደቲ? ታ መላ አስ ፁራባ ደማናዉ ዳንዳኤይሳ ህንተ ኤረከትዬ?” ያግስ።<verse eid="GEN 44:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16"/>ይሁድ፥ “ታ ጎዳስ ኑኒ አይ ጋኔ? ኑኒ አይ ኦደትያባይ ደኢ? ኑ ፅሎተ ኑኒ ዋት በሳኔ? ፆሳይ ነ አይለታ ናቁዋ ቆንጭስስ። ህዛ ኑኒካ ሄ ዋንጫይ በንትዳ ኡራይካ ታ ጎዳስ አይለ ግድዳ” ያግስ።<verse eid="GEN 44:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17"/>ሽን ዮሰፍ፥ “ሄሳ መላባ ኦናይስ ታፐ ሃኮ፤ ታ ዋንጫይ እያፐ በንትዳ ኡራ ፃላል ታ አይለ ግዳና። ሀንኮ ህንተ ህንተ አዋኮ ጉየ ሳሮ ስምተ” ያግስ።<verse eid="GEN 44:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18"/>ይሁድ እያኮ ሺቅድ “ታ ጎዳዉ፥ ኔኒ ካዋ መላ ግድኮካ ታኒ ኔራ ኦደታናዉ ነና ዎሳይስ። ታና ነ አይልያ ሀንቀቶፋ። <verse eid="GEN 44:18"/><verse number="19" style="v" sid="GEN 44:19"/>ኔኒ ታ ጎዳይ ኑና ነ አይለታ፥ ‘ህንተዉ አው ዎይኮ እሽ ደኢ?’ ጋዳ ኦይቻዳሳ። <verse eid="GEN 44:19"/><verse number="20" style="v" sid="GEN 44:20"/>ኑኒካ፥ ‘ኑስ ጭምዳ አዋይ ደኤስ። እ ጭማተን የልዳ ካሎ ናአይካ ደኤስ። ሄ ናኣ እሻይ ሀይቅስ፥ ባ አየን እስኖ፥ እያ አዋይ እያ ዳሮ ዶሴስ’ ያግዳ።<verse eid="GEN 44:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 44:21"/>“ኔኒ ኑኮ፥ ‘ታኒ እያ በአና መላ ታዉ ኤህተ’ ያጋዳሳ። <verse eid="GEN 44:21"/><verse number="22" style="v" sid="GEN 44:22"/>ያትን ኑኒ፥ ‘ሄ ናአይ ባ አዋፐ ሻከታናዉ ዳንዳኤና፤ ሻከትኮ እያ አዋይ ሀይቃና’ ያግዳ። <verse eid="GEN 44:22"/><verse number="23" style="v" sid="GEN 44:23"/>ሽን ኔኒ፥ ‘ህንተ ካሎ እሻይ ህንተራ ዮና እፅኮ፥ ታ አይፍያ ዛር በኤከታ’ ያጋዳሳ። <verse eid="GEN 44:23"/><verse number="24" style="v" sid="GEN 44:24"/>ኑኒ ኑ አዋኮ ስሚድ ብዳ ዎደ ነ ግዳይሳ እያዉ ኦድዳ።<verse eid="GEN 44:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 44:25"/>“ኑ አዋይ፥ ‘ጉየ ብድ ጉ ካ ሻምተ’ ያግን፥ <verse eid="GEN 44:25"/><verse number="26" style="v" sid="GEN 44:26"/>ኑኒ እያኮ፥ ‘ኑ ካሎ እሻይ ኑራ ቦና እፅኮ፥ ኡራ አይፍያ በአናዉ ዳንዳኦኮ። ኑ ካሎ እሻይ ኑራ ብያባ ግድኮ፥ ኑኒ ያ ባና’ ያግዳ።<verse eid="GEN 44:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 44:27"/>“ያትን ኑ አዋይ ኑና፥ ‘ታ ማችያ ራሄላ ታዉ ናምኡ አደ ናይታ የልዳይሳ ህንተ ኤሬታ። <verse eid="GEN 44:27"/><verse number="28" style="v" sid="GEN 44:28"/>ኤንታፈ እሶይ ታፐ ሻከትድ ብን፥ እያ ዶእ ሞና አገና ያጋስ። ሀች ጋካናዉ ታኒ እያ በአብከ። <verse eid="GEN 44:28"/><verse number="29" style="v" sid="GEN 44:29"/>ሀይሳ ቃስ ታፐ ህንተ ሻክ ኤፍን፥ ኢታባይ እያ ጋክኮ፥ ህንተ ታና ታ ጭማተን አፉ ሙዝሸ ታ ሀይቁዋ ማታየታ’ ” ያግስ።<verse eid="GEN 44:29"/></para>
  <para style="p">
    <verse number="30-31" style="v" sid="GEN 44:30-31"/>“ሄሳ ግሾ፥ ሀእ ታኒ ጉየ ታ አዋኮ ብያ ዎደ ብንያመይ ታራ ባናዉ በሴስ። ታ አዋይ ናኣ ሸምፖፈ ዶስያ ግሾ፥ ናአይ ኑራ ባይናይሳ በእኮ ሀይቃና። ኑኒ ነ አይለት ኑ አዋ ጭማተ አፉን ዱፎ ገልሶስ። <verse eid="GEN 44:30-31"/><verse number="32" style="v" sid="GEN 44:32"/>ታኒ ነ አይለይ ናኣ ታ ዋሰተን ኤካስ። ቃስ፥ ‘ታ አዋዉ፥ ታኒ እያ ነዉ ሳሮ ዛራዳ ኤሆና እፅኮ ታ ደኡዋ ኡባን ነ ባደይ ታና ጋኮ’ ያጋስ።<verse eid="GEN 44:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 44:33"/>“ያንያ ግሾ፥ ታኒ ነ አይለይ ናኣ ግሾ አይለታዳ ሀይሳን አታና ናአይ ባ እሻታራ ጉየ ስሞ። <verse eid="GEN 44:33"/><verse number="34" style="v" sid="GEN 44:34"/>ናአይ ባይና ታኒ ዋናዳ ጉየ ታ አዋኮ ስማኔ? ታና ታ አዋይ ሴለታና ሴላ በሶፎ” ያግስ።<verse eid="GEN 44:34"/></para>
  <chapter eid="GEN 44"/>
  <chapter number="45" style="c" sid="GEN 45"/>
  <para style="s1">ዮሰፍ ባና ቆንጭሰ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1"/>ሄ ዎደ ዮሰፍ ባ አይለታ ስንን ገንጫናዉ ዳንዳእቦና ግሾ፥ “አሳ ኡባ ታ ስንፈ ከስተ” ያግድ ዋስስ። ሄሳ ግሾ፥ ዮሰፍ ባ እሻታስ ባና ኤርስዳ ዎደ እያራ ኦንካ አላግ ባዋ። <verse eid="GEN 45:1"/><verse number="2" style="v" sid="GEN 45:2"/>እ ባ ቃላ ቁ ኦድ፥ ግብፀት እያ ስአና ጋካናዉ ዬክስ፤ ካዋ ሶ አሳይካ ሄ ዎርያ ስእዶሶና።<verse eid="GEN 45:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 45:3"/>ዮሰፍ ባ እሻታኮ፥ “ታኒ ዮሰፋባይ። ታ አዋይ ሀኖ ጋካናስ ፓፃ ደኢ?” ያግድ ኦይችስ። ሽን እያ እሻት ዳሮ ዳጋምዳ ግሾ፥ እያዉ አይኮካ ዛራናዉ ዳንዳእቦኮና።<verse eid="GEN 45:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 45:4"/>ያንን፥ ዮሰፍ ባ እሻታኮ፥ “ታኮ ሃ ሺቅተ” ያግስ። ኤንቲ እያኮ ሺቅን እ ኤንታ፥ “ታኒ ህንተ ታና ግብፀ ቢታ ባይዝዳ ህንተ እሻ ዮሰፋ። <verse eid="GEN 45:4"/><verse number="5" style="v" sid="GEN 45:5"/>ሀእ ህንተ ታና ባይዝዳ ግሾ፥ ቂሮቶፍተነ ህንተና ባዶፍተ። አይስ ጊኮ፥ ፆሳይ ታና ህንተፈ ስን ኪትዳይ አሳ ሸምፖ አሻናሳ። <verse eid="GEN 45:5"/><verse number="6" style="v" sid="GEN 45:6"/>ሀ ቢታ ኮሽ ገልን ሀይስ ናምአን ላይ። አስ ጎዮና ዎይኮ ጫኮና ሀራ እቻሹ ላይት ቡሮ ደኦሶና። <verse eid="GEN 45:6"/><verse number="7" style="v" sid="GEN 45:7"/>ሽን ታኒ ሳአን ህንተ ሼሻነ ህንተና ማላልስያ ኦገን አሻና መላ ፆሳይ ታና ህንተፈ ስን ኪትስ። <verse eid="GEN 45:7"/><verse number="8" style="v" sid="GEN 45:8"/>ሄሳ ግሾ፥ ታና ሀ በሳ ኪትዳይ ፆሳፈ አትሽን፥ ህንተና ግደከታ። እ ታና ግብፀ ካዋስ ዞርያ አዋ፥ እያ አቆ ኡባ ቦላ ጎዳነ ግብፀ ቢታ ሃርያ አስ ኦስ።<verse eid="GEN 45:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 45:9"/>“ሀእ ኤለስድ ጉየ ታ አዋኮ ብድ እያኮ፥ ነ ናአይ ዮሰፍ ሀይሳዳ ያጌስ ጊተ፤ ‘ፆሳይ ታና ግብፀ ቢታ ኡባ ቦላ ጎዳ ከስስ፤ ኔኒ ጋምኦና ታኮ ሃያ። <verse eid="GEN 45:9"/><verse number="10" style="v" sid="GEN 45:10"/>ነ ናይታ፥ ነ ናይታ ናይታ፥ ነ ዶርሳ፥ ነ ዴሻ፥ ነ መህያነ ነዉ ደእያባ ኡባ ኤካዳ ሃያ፤ ታ ማታን ጌሳመ ቢታን ደኣሳ። <verse eid="GEN 45:10"/><verse number="11" style="v" sid="GEN 45:11"/>ቡሮ እቻሹ ኮሻ ላይት አትዶሶና። ነና፥ ነ ሶ አሳነ ነ መህያ ኮሽ ቆሆና መላ ታኒ ነና ሙዛና’ ” ያግስ።<verse eid="GEN 45:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12"/>ቃስካ ዮሰፍ ኤንታኮ፥ “ህንተካ፥ ታ እሻ ብንያመይካ፥ ሀ ህንተራ ኦደተይ ቱማ ታና ዮሰፋ ግደይሳ ህንተ አይፍያን በእደታ። <verse eid="GEN 45:12"/><verse number="13" style="v" sid="GEN 45:13"/>ታዉ ግብፀ ቢታን ደእያ ግታ ቦንቹዋነ ህንተ በእዳባ ኡባ ታ አዋስ ኦድተ። ታ አዋካ ኤለስድ ሃ ኤክድ ዪተ” ያግስ።<verse eid="GEN 45:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14"/>ዮሰፋራ ብንያመራ ናምአይ ዎሉ ቆምድ ዬክዶሶና <verse eid="GEN 45:14"/><verse number="15" style="v" sid="GEN 45:15"/>ዮሰፍ ዬክሸ ባ እሻታ ኡባ ዬርስ። ሄሳፈ ጉየ፥ እያ እሻት እያራ ኦደትዶሶና።<verse eid="GEN 45:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16"/>ዮሰፋ እሻታ ዩሳ ዎረይ ካዎ ኬ ጋክዳ ዎደ ካዎይነ እያ ሞርናት ኡፋይትዶሶና። <verse eid="GEN 45:16"/><verse number="17" style="v" sid="GEN 45:17"/>ካዎይ ዮሰፋኮ፥ “ኔኒ ነ እሻታኮ ያጋ፤ ህንተ ሀረታ ጫንድ፥ ካናነ ቢታ ስምተ። <verse eid="GEN 45:17"/><verse number="18" style="v" sid="GEN 45:18"/>ህንተ አዋነ ህንተ ሶ አሳ ኤክድ፥ ጉየ ታኮ ሃ ዪተ። ታኒ ህንተዉ ግብፀ ቢታን ኡባፈ ሎእያ በሳ እምኮ፥ ሄ ቢታ ሞዋ ህንተ ካሻና። <verse eid="GEN 45:18"/><verse number="19" style="v" sid="GEN 45:19"/>ቃስካ፥ ባንታ ናይታ፥ ባንታ ማቸታነ ባንታ አዋ ኤሀናዉ ግብፀፈ ግታ ፓራ ጋረ ኤክ ባና መላ ኤንታ ኪታ። <verse eid="GEN 45:19"/><verse number="20" style="v" sid="GEN 45:20"/>ግብፀ ቢታን ደእያ ኡባፈ አድ ሎእያባይ ኤንታሳ ግድያ ግሾ፥ ባንታ አግድ ያ አቁዋስ ቆፖና መላ ኤንታዉ ኦዳ” ያግስ።<verse eid="GEN 45:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21"/>ያትን እስራኤለ አደ ናይት ካዎይ ግዳይሳዳ ኦዶሶና። ዮሰፍ ካዎይ ኪትዳይሳዳ ግታ ፓራ ጋረታነ ኦገስ ሽንቀካ ኤንታዉ እሚስ። <verse eid="GEN 45:21"/><verse number="22" style="v" sid="GEN 45:22"/>ኤንታ ኡባስ ሁጰን ሁጰን ኦራ ማኦ እሚስ። ሽን ብንያመስ ታማነ ኡሱፑን ክሎ ግራመ ዴፅያ ብራነ እቻሹ ኩመ ማኦ እሚስ። <verse eid="GEN 45:22"/><verse number="23" style="v" sid="GEN 45:23"/>እ ባ አዋስ ግብፀን ደእያባፐ ሎእያባ ኡባ ታሙ አደ ሀረን ጫንድ፥ ቃስ ኦገስ ካ፥ ኡይነ ሀራ ካ ታሙ ማጫ ሀረታን ጫንድ የድስ። <verse eid="GEN 45:23"/><verse number="24" style="v" sid="GEN 45:24"/>ያትድ፥ ዮሰፍ ባ እሻታ ሞይዝሸ፥ ኤንታኮ፥ “ኦግያን ብሸ ኦየቶፍተ” ያግስ።<verse eid="GEN 45:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25"/>ኤንቲ ግብፀፈ ደንድድ፥ ካናነ ቢታን ደእያ ባንታ አዋ ያይቆባኮ ስምዶሶና። <verse eid="GEN 45:25"/><verse number="26" style="v" sid="GEN 45:26"/>ኤንቲ ያይቆባኮ፥ “ዮሰፍ ፓፃ ደኤስ። እ ሄሳፈ አድ ግብፀ ቢታ ኡባ ሃሬስ” ያግዶሶና። ያይቆብ ዳጋምድ፥ ዎዛና ይዳ ግሾ፥ ኤንቲ ግያባ አማንበና። <verse eid="GEN 45:26"/><verse number="27" style="v" sid="GEN 45:27"/>ሽን ኤንቲ ዮሰፍ ኤንታዉ ኦድዳባ ኡባ እያዉ ኦድን፥ ቃስካ እያ ኤክ ያና መላ እ የድዳ ግታ ፓራ ጋረታ እ በእን እያዉ ሸምፖይ ስምስ። <verse eid="GEN 45:27"/><verse number="28" style="v" sid="GEN 45:28"/>እስራኤለይ፥ “ህዛ ታ አማነታስ። ታ ናኣ ዮሰፍ ሀኖ ጋካናስ ፓፃ ደኤስ። ታ ሀይቃናፐ ስን ባዳ እያ በአና” ያግስ።<verse eid="GEN 45:28"/></para>
  <chapter eid="GEN 45"/>
  <chapter number="46" style="c" sid="GEN 46"/>
  <para style="s1">ያይቆብ ግብፀ ቡሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1"/>እስራኤለይ ባዉ ደእያባ ኡባ ኤክድ፥ በርሳበ ጋክዳ ዎደ ባ አዋ ይሳቃ ፆሳስ ያርሾ ያርሽስ። <verse eid="GEN 46:1"/><verse number="2" style="v" sid="GEN 46:2"/>ፆሳይ ቃማ እስራኤለስ ቆንጭድ፥ “ያይቆባ፥ ያይቆባ” ያግስ።</para>
  <para style="p" vid="GEN 46:2">እካ፥ “ሄኮ፥ አበ ጎዳዉ” ግድ ኮይስ።<verse eid="GEN 46:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3"/>ፆሳይ እያኮ፥ “ታኒ ፆሳ፥ ነ አዋ ፆሳ፤ ኔኒ ግብፀ ባናዉ ባቦፋ። ታ ነ ሼሻ ያን ግታ ደረ ከሳና። <verse eid="GEN 46:3"/><verse number="4" style="v" sid="GEN 46:4"/>ታኒ ኔራ እስፈ ግብፀ ባና፤ ታኒ ነ ሼሻ ያፐ ከሳዳ ሃ ኤሀና። ነ ሀይቅያ ዎደ ዮሰፍ ነ አይፍያ ኦይካና” ያግስ።<verse eid="GEN 46:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5"/>ሄሳፈ ጉየ፥ ያይቆብ በርሳበፐ ደንድስ። እስራኤለ አደ ናይት ባንታ አዋ ያይቆባ፥ ባንታ ናይታነ ባንታ ማቸታ ግብፀ ካዎይ ኤንታዉ የድዳ ግታ ፓራ ጋረ ቦላ ኡትስድ ኤፍዶሶና። <verse eid="GEN 46:5"/><verse number="6" style="v" sid="GEN 46:6"/>ኤንቲ ካናነ ቢታን ሃርዳ ሃሩዋነ መሄ ኡባ ኤክ ብዶሶና። ያይቆብ ባ ሶ አሳ ኡባ ኤክድ ግብፀ ብስ። <verse eid="GEN 46:6"/><verse number="7" style="v" sid="GEN 46:7"/>እ ባ ሶ አሳ ኡባ፤ አደ ናይታነ ባ አደ ናይታ ናይታ፥ ባ ማጫ ናይታነ ባ ማጫ ናይታ ናይታ፥ ኡባ ባራ ኤክድ ግብፀ ብስ።<verse eid="GEN 46:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8"/>እስራኤለራ ግብፀ ቢታ ብዳ እያ ናይታ ሱንይ ሀይሳፈ ካልድ ፃፈትዳይሳ።</para>
  <para style="p" vid="GEN 46:8">ያይቆባ ባይራ ናአይ ሮቤላ፤ <verse eid="GEN 46:8"/><verse number="9" style="v" sid="GEN 46:9"/>ሮቤላ አደ ናይት ሀኖካ፥ ፓላ፥ ሄስሮናነ ካርማ። <verse eid="GEN 46:9"/><verse number="10" style="v" sid="GEN 46:10"/>ስሞና አደ ናይት ያሙኤላ፥ ያምና፥ ኦሀዳ፥ ያክና፥ ፆሃራነ ካናነ ማጫሴፐ የልዳ ሳኡላ። <verse eid="GEN 46:10"/><verse number="11" style="v" sid="GEN 46:11"/>ሌወ አደ ናይት ገድሶና፥ ቃሀታነ መራራ። <verse eid="GEN 46:11"/><verse number="12" style="v" sid="GEN 46:12"/>ይሁዳ አደ ናይት ኤራ፥ ኦናና፥ ሴላ፥ ፓረሳነ ዛራ። ሽን ኤርነ ኦናን ካናነ ቢታን ሀይቅዶሶና። ፓረሳ አደ ናይት ሄስሮናነ ሀሙላ። <verse eid="GEN 46:12"/><verse number="13" style="v" sid="GEN 46:13"/>ይሳኮራ አደ ናይት ቶላ፥ ፑአ፥ ዮባነ ሽምሮና። <verse eid="GEN 46:13"/><verse number="14" style="v" sid="GEN 46:14"/>ዛብሎና አደ ናይት ሳረዳ፥ ኤሎናነ ያህላላ። <verse eid="GEN 46:14"/><verse number="15" style="v" sid="GEN 46:15"/>ሀ አደ ናይትነ ማጫ ናእያ ዲና፥ ልያ ማሰጰፆመ ቢታን ያይቆባስ የልዳይሳታ። ዲና ጉጅን እያ ናይትነ ናይታ ናይት ኩመ ሀስታማነ ሄ።<verse eid="GEN 46:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 46:16"/>ጋደ አደ ናይት ፃፎና፥ ሀገ፥ ሹና፥ ኤፅቦና፥ ኤር፥ አሮዳነ አርኤላ። <verse eid="GEN 46:16"/><verse number="17" style="v" sid="GEN 46:17"/>አሴራ አደ ናይት ይምና፥ የሱዋ፥ ይስዋነ በርአ። ኤንታ ምችያ ሳራሆ። በርአ አደ ናይት ሄቤራነ ማልክኤላ። <verse eid="GEN 46:17"/><verse number="18" style="v" sid="GEN 46:18"/>ሀይሳቲ ላቢ ባ ናኤ ልያስ እምዳ ዛላፋ ያይቆባስ የልዳ ናይታ። ኤንቲ ኩመ ታማነ ኡሱፑና።<verse eid="GEN 46:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 46:19"/>ያይቆባ ማቸ ራሄል አደ ናይት ዮሰፋነ ብንያመ። <verse eid="GEN 46:19"/><verse number="20" style="v" sid="GEN 46:20"/>ኦና ካታማ ካህነ ጶፅፋራ ናእያ አስናታ ዮሰፋስ ግብፀን ምናሰነ ኤፍሬማ የላሱ። <verse eid="GEN 46:20"/><verse number="21" style="v" sid="GEN 46:21"/>ብንያመ ናይት ቤላ፥ በከራ፥ አስቤላ፥ ጌራ፥ ናማነ፥ ኤሀ፥ ኦሮሻ፥ ሙፍማ፥ ሁፍማነ አራዳ። <verse eid="GEN 46:21"/><verse number="22" style="v" sid="GEN 46:22"/>ሀይሳቲ ያይቆባስ የለትዳ ራሄል አደ ናይታ። ኤንቲ ኩመ ታማነ ኦይዳ።<verse eid="GEN 46:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 46:23"/>ዳነ አደ ናአይ ሁሽማ። <verse eid="GEN 46:23"/><verse number="24" style="v" sid="GEN 46:24"/>ንፍታለመ አደ ናይት ያህፄላ፥ ጉና፥ የፀራነ ሽለመ። <verse eid="GEN 46:24"/><verse number="25" style="v" sid="GEN 46:25"/>ሀይሳቲ ላፑናት ላቢ ባ ናኤ ራሄልስ እምዳ ባል ያይቆባስ የልዳ ናይታነ ናይታ ናይታ።<verse eid="GEN 46:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26"/>ያይቆባራ ግብፀ ብዳ፥ እያ ጉልባታፐ ከይዳ ናይት፥ እያ ናይታ ማቸታ ጉጆና ኡሱፑን ታማነ ኡሱፑና። <verse eid="GEN 46:26"/><verse number="27" style="v" sid="GEN 46:27"/>ግብፀን ዮሰፋስ የለትዳ ናምኡ ናይታ ጉጅኮ፥ ግብፀ ብዳ ያይቆባ ሶ አሳይ ኩመ ላፑን ታማ።<verse eid="GEN 46:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28"/>ጌሳመ ቢታን ባንታና ሞካና መላ ያይቆብ ይሁዳ ባፐ ስን ዮሰፋኮ ኪትስ። ኤንቲ ያ ጋክያ ዎደ፥ <verse eid="GEN 46:28"/><verse number="29" style="v" sid="GEN 46:29"/>ዮሰፍ ባ ፓራ ጋርያ ጊግስድ፥ ባ አዋ እስራኤለራ ጋሄታናዉ ጌሳመ ብስ። ዮሰፍ ባ አዋ ደምዳ መላ እያ ቆያን ፃፀትድ ዳሮ ዎደ ዬክስ።<verse eid="GEN 46:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 46:30"/>እስራኤለይ ዮሰፋኮ፥ “ኔኒ ፓፃ ደእሽን፥ ታኒ ነ አይፍያ በእዳ ግሾ፥ ህዛ ታኒ ሀይቅኮካ አይኮይ ባዋ” ያግስ።<verse eid="GEN 46:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31"/>ሄሳፈ ጉየ፥ ዮሰፍ ባ እሻታነ ባ አዋ ሶ አሳታኮ፥ “ታኒ ግብፀ ካዋኮ ባዳ እያኮ፥ ‘ካናነ ቢታን ደእያ ታ እሻትነ ታ አዋ ሶ አሳይ ታኮ ይዶሶና። <verse eid="GEN 46:31"/><verse number="32" style="v" sid="GEN 46:32"/>ኤንቲ መሄ ሃረይሳታ፥ ኤንቲ ባንታራ ባንታ ዶርሳ፥ ባንታ ዴሻ፥ መህያነ ባንታዉ ደእያባ ኡባ ኤክድ ይዶሶና’ ያጋና። <verse eid="GEN 46:32"/><verse number="33" style="v" sid="GEN 46:33"/>ካዎይ ህንተና ፄግስድ፥ ‘ህንተ ኦሶይ አይቤ?’ ግድ ኦይችኮ፥ <verse eid="GEN 46:33"/><verse number="34" style="v" sid="GEN 46:34"/>ህንተ እያኮ፥ ‘ኑኒ ነ አይለት ናአተፈ ዶምድ ኑ አዋታዳ መሄ ሄሞስ’ ያግተ። ዶርሰ ሃርያ አስ ግብፀ አሳን ካትዳባ ግድያ ግሾ፥ እ ህንተ ጌሳመ ቢታን ዳና መላ ኦና” ያግስ።<verse eid="GEN 46:34"/></para>
  <chapter eid="GEN 46"/>
  <chapter number="47" style="c" sid="GEN 47"/>
  <para style="p">
    <verse number="1-2" style="v" sid="GEN 47:1-2"/>ዮሰፍ ባ እሻታፐ እቻሻታ ዶርድ ግብፀ ካዋኮ ገልድ ሀይሳዳ ያግስ፤ “ታ አዋይነ ታ እሻት፥ ባንታ ዶርሳ፥ ባንታ ዴሻ፥ ባንታ መህያነ ባንታዉ ደእያባ ኡባ ኤክድ ካናነ ቢታፈ ይድ፥ ሀእ ጌሳመን ደኦሶና” ያግስ።<verse eid="GEN 47:1-2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 47:3"/>ካዎይ ሄ እሻታኮ፥ “ህንተ ኦሶይ አይቤ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="GEN 47:3">ኤንቲ ካዋኮ፥ “ኑኒ ነ አይለት ኑ አዋታዳ ዶርሰ ሃርያ አሳታ” ያግድ ዛርዶሶና። <verse eid="GEN 47:3"/><verse number="4" style="v" sid="GEN 47:4"/>ቃስካ ኤንቲ እያኮ፥ “ካናነ ቢታን ኮሽ ከይዳ ግሾነ ኑ መህያስ ምያባይ ይዳ ግሾ፥ ኑኒ ሀይሳን ዳናዉ ይዳ። ሀያና ኑና ነ አይለታ ጌሳመ ቢታን ደኦ ጋርክ” ያግዶሶና።<verse eid="GEN 47:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 47:5"/>ካዎይ ዮሰፋኮ፥ “ነ አዋይነ ነ እሻት ኔኮ ይዶሶና። <verse eid="GEN 47:5"/><verse number="6" style="v" sid="GEN 47:6"/>ህዛ ግብፀ ቢታይ ነ ኩሸና። ሀ ቢታን ኡባፈ አድ ሎእያ በሳን ነ አዋነ ነ እሻታ ዎ፤ ኤንቲ ጌሳመ ቢታን ደኦና። ኤንታ ግዶፈ ዱማ ቃራተ ደኤይሳት ደእኮ፥ ሄሳታ ታ መህያ ቦላ ሹማ” ያግስ።<verse eid="GEN 47:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7"/>ሄሳፈ ጉየ፥ ዮሰፍ ባ አዋ ያይቆባ ገልስድ፥ ካዋ ስን አስ። ያይቆብ ግብፀ ካዋ አንጅዳፐ ጉየ፥ <verse eid="GEN 47:7"/><verse number="8" style="v" sid="GEN 47:8"/>ካዎይ ያይቆባ፥ “ነዉ አፑን ላይ?” ያግድ ኦይችስ።<verse eid="GEN 47:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9"/>ያይቆብ ካዋኮ፥ “ታኒ ዳቡርሳን ደእዳ ላይይ ፄታነ ሀስታማ። ታ ላይይ በን ታ አዋት ዳቡርሳን ደእዳ ላይፈ ጉነ መቶይ ዳርዳ ላይ” ያግስ። <verse eid="GEN 47:9"/><verse number="10" style="v" sid="GEN 47:10"/>ሄሳፈ ጉየ፥ ያይቆብ ካዋ አንጅድ፥ እያ ስንፈ ካረ ከይስ።<verse eid="GEN 47:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 47:11"/>ዮሰፍ ካዎይ ኪትዳይሳዳ ባ አዋነ ባ እሻታ ግብፀ ቢታን ራምሰ ካታማ ማታን ደእያ ኡባፈ አዳ አራዳ ቢታን ኤንታ ዎስ። <verse eid="GEN 47:11"/><verse number="12" style="v" sid="GEN 47:12"/>ዮሰፍ ባ አዋስ፥ ባ እሻታስነ ባራ ደእያ ኡባስ ኤንታ ናይታ ታይቡዋዳ ካ እሚስ።<verse eid="GEN 47:12"/></para>
  <para style="s1">ግብፀ ኮሻ</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13"/>ቢታ ኡባን ኮሽ ሱልዳ ግሾ ቢታን ኡባን ካ ባዋ፤ ግብፀይነ ካናነ ቢታይ ቆሄትዶሶና። <verse eid="GEN 47:13"/><verse number="14" style="v" sid="GEN 47:14"/>ዮሰፍ ግብፀ ካ ባይዝድ፥ ግብፀንነ ካናነ ቢታታን ደእያ ሚሽያ ኡባ ሺሽድ ግብፀ ካዋ ኬ ገልስስ። <verse eid="GEN 47:14"/><verse number="15" style="v" sid="GEN 47:15"/>ግብፀ ሚሸይነ ካናነ ሚሸይ ዉርዳ ዎደ ግብፀ አሳ ኡባይ ዮሰፋኮ ይድ “ኑስ ካ እማ። ኑ ሚሸይ ዉርዳ ግሾ ኑኒ ነ ስንን አይስ ኮሻን ሀይቃኔ?” ያግዶሶና።<verse eid="GEN 47:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16"/>ዮሰፍ ኤንታኮ፥ “ህንተ መህያ ኤክ ዪተ። ህንተ ሚሸይ ዉርዳባ ግድኮ፥ ታኒ ካ ህንተ መህያራ ላማና” ያግስ። <verse eid="GEN 47:16"/><verse number="17" style="v" sid="GEN 47:17"/>ሄሳ ግሾ፥ ኤንቲ ባንታ መህያ ዮሰፋስ ኤህዶሶና። ዮሰፍ ኤንታ ፓራ፥ ዶርሳ፥ ዴሻ፥ ሚዛነ ሀርያ ካራ ላምስ። እ ሄ ላይ ኤንታ መህያ ኡባራ ካ ላምድ፥ ኤንታ ሙዝድ ሻችስ።<verse eid="GEN 47:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18"/>ኤንቲ ካልያ ላይን እያኮ ይድ “ኑኒ ኑ ጎዳፐ ቆስያባይ ባዋ፤ ኑ ሚሸይ ኡባይ ዉርስ። ኑ መህያካ ነዉ እም ድግዳ። ኑ ቦላፈነ ኑ ጋድያፐ አትሽን፥ ኑ ጎዳስ እማናባይ ሀራባይ ባዋ። <verse eid="GEN 47:18"/><verse number="19" style="v" sid="GEN 47:19"/>ኑኒ ነ በእሽን አይስ ኮሻን ሀይቃኔ? ኑ ጋደይካ አይስ ዪ? ኑናካ ኑ ጋድያካ ሻማዳ ኑስ ካ እማ። ኑኒ ካዋስ አይለታና፥ ኑ ጋደይካ እያባ ግዶ። ኑኒ ሀይቆና አታና መላ ኑ ጋደይካ ኦፆና መላ ዘረ ኑስ እማ” ያግዶሶና።<verse eid="GEN 47:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20"/>ዮሰፍ ግብፀ ቢታ ኡባ ካዋስ ሻምስ። ኮሽ ሱልን፥ ግብፀ አሳይ ኡንኤትድ ባንታ ጋድያ ባይዝን ጋደይ ካዉዋባ ግድስ። <verse eid="GEN 47:20"/><verse number="21" style="v" sid="GEN 47:21"/>ዮሰፍ አሳ ኡባ ግብፀስ ሀ ጋፃፐ ህን ጋፃ ጋካናስ ካዋስ አይለ ኦስ። <verse eid="GEN 47:21"/><verse number="22" style="v" sid="GEN 47:22"/>ሽን ካዎይ ካህነታስ ካ እምያ ግሾ ዮሰፍ ኤንታ ጋድያ ሻምቤና። ሄሳ ግሾ፥ ባንታ ጋድያ ባይዝቦኮና።<verse eid="GEN 47:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 47:23"/>ዮሰፍ አሳኮ፥ “ህዛ ሀች ታኒ ህንተናነ ህንተ ጋድያ ካዋስ ሻምዳ ግሾ፥ ዘረ ኤፍድ ህንተ ጋደን ዘርተ። <verse eid="GEN 47:23"/><verse number="24" style="v" sid="GEN 47:24"/>ሽን ካ ሺሽያ ዎደ አይፍዳባፐ እቻሹ ኩሽያፐ እስ ኩሽያ ካዋስ እምተ። አትዳ ኦይዱ ኩሸይ ህንተ ጋድያስ ዘረ፥ ህንተዉነ ህንተ ሶ አሳስ ካ ግዶ” ያግስ።<verse eid="GEN 47:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25"/>ኤንቲ፥ “ኔኒ ኑና አሻዳሳ። ኑ ጎዳ ስንን ኑኒ ሳበትኮ፥ ኑኒ ካዋስ አይለታና” ያግዶሶና። <verse eid="GEN 47:25"/><verse number="26" style="v" sid="GEN 47:26"/>ሄሳ ግሾ፥ ዮሰፍ ግብፀ ቢታን አይፍዳባፐ እቻሹ ኩሽያፐ እሱዋ ካዋስ እመይሳ ህገ ከስስ። ሄ ዎጋይካ ሀች ጋካና ኤቅድ ደኤስ። ካህነታ ጋድያፐ አትሽን፥ ሀር ኡባይ ካዉዋባ ግድስ።<verse eid="GEN 47:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27"/>እስራኤለት ግብፀ ቢታን ጌሳመ ግያ በሳን ደእዶሶና። ኤንቲ ያን ዱረትዶሶና፤ የለት ዳርዶሶና።<verse eid="GEN 47:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 47:28"/>ያይቆብ ግብፀ ቢታን ታማነ ላፑን ላይ ደእስ። ያይቆብ ደእዳ ላይይ ፄታነ ኦይታማነ ላፑና። <verse eid="GEN 47:28"/><verse number="29" style="v" sid="GEN 47:29"/>እስራኤለስ ሀይቅያ ዎደይ ማታትን፥ ባ ናኣ ዮሰፋ ፄግስድ ሀይሳዳ ያግስ፤ “ታኒ ነ ስንን ሳበትዳባ ግድኮ፥ ነ ኩሽያ ታ ሸምፑዋ ቦላ ዎ። ኔኒ ታዉ ምሸትያባ ግድኮ ታና ግብፀን ሞግከ ጋዳ ታዉ ጫቃ። <verse eid="GEN 47:29"/><verse number="30" style="v" sid="GEN 47:30"/>ሽን ታኒ ሀይቅያ ዎደ ታና ግብፀፈ ኤፋዳ፥ ታ ማይዛት ሞገትዳሱዋን ሞጋ” ያግስ።</para>
  <para style="p" vid="GEN 47:30">ዮሰፍ፥ “ታኒ፥ ነና ነ ግዳይሳዳ ኦና” ያግስ።<verse eid="GEN 47:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31"/>ያይቆብ እያኮ፥ “አነ ታዉ ጫቃ” ያግስ። ዮሰፍ እያዉ ጫቅስ። ሄሳፈ ጉየ፥ እስራኤለይ ባ ጉፍያ ቦላ ካትድ ፆሳ ጎይንስ።<verse eid="GEN 47:31"/></para>
  <chapter eid="GEN 47"/>
  <chapter number="48" style="c" sid="GEN 48"/>
  <para style="s1">ምናሰነ ኤፍሬማ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1"/>ሄሳፈ ጉየ፥ አሳይ፥ “ነ አዋይ ሳከቴስ” ያግድ ዮሰፋስ ኦድዶሶና። እ ባ ናምኡ አደ ናይታ ምናሰነ ኤፍሬማ ኤክድ ባ አዋ በአናዉ ብስ። <verse eid="GEN 48:1"/><verse number="2" style="v" sid="GEN 48:2"/>ያይቆብ፥ እያ ናአይ ዮሰፍ ይዳይሳ ስእዳ ዎደ፥ እስራኤለይ ባና ምንድ ሂፃን ኡትስ።<verse eid="GEN 48:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 48:3"/>ያይቆብ ዮሰፋ፥ “ኡባ ዳንዳእያ ፆሳይ ካናነ ቢታን ሎዛ ካታማን ታዉ ቆንጭድ፥ ታና አንጅስ። <verse eid="GEN 48:3"/><verse number="4" style="v" sid="GEN 48:4"/>እ ታና፥ ‘ታኒ ነ የለተ ዳርሳና፥ ነና ዳሮ ደረ ኦና። ሀ ቢታ ታኒ ኔፐ ጉየ፥ ነ ሼሻስ መርና ላታ ኦዳ እማና’ ” ያግስ።<verse eid="GEN 48:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5"/>“ህዛ፥ ነ ናምኡ አደ ናይት፥ ታኒ ኔኮ ሃ ያናፐ ስን ግብፀን ነዉ የለትዳይሳት ታባ። ኤፍሬመይነ ምናሰይ ታዉ ሮቤላ መላነ ስሞና መላ። <verse eid="GEN 48:5"/><verse number="6" style="v" sid="GEN 48:6"/>ኤንታፈ ጉየ የለታናይሳት ነባ ግዶ። ኤንቲ ላታና ቢታይ ኤፍሬማ ሱንንነ ምናሰ ሱንን ግዶ። <verse eid="GEN 48:6"/><verse number="7" style="v" sid="GEN 48:7"/>ታኒ ማሰጰፆመፐ ስምሽን፥ ኤፍራታ ጋካናዉ ጉ አትሽን፥ ራሄላ ካናነ ቢታን ሀይቃሱ። ታኒ እዮ ቤተለመ ጌተትያ ኤፍራታ ኤፍያ ኦግያ ጋፃን ሞጋስ” ያግስ።<verse eid="GEN 48:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8"/>እስራኤለይ ዮሰፋ አደ ናይታ ናምአታ በእዳ ዎደ፥ “ሀይሳቲ ኦናንቴ?” ያግድ ኦይችስ።<verse eid="GEN 48:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9"/>ዮሰፍ ባ አዋኮ፥ “ሀይሳቲ ፆሳይ ታዉ ሀ ቢታን እምዳ ናይታ” ያግስ።</para>
  <para style="p" vid="GEN 48:9">ያትን እስራኤለይ፥ “ታኒ ኤንታ አንጃና መላ፥ ኤንታ ታኮ ሃ ሺሻ” ያግስ።<verse eid="GEN 48:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 48:10"/>እስራኤለይ ጭምን እያ አይፈይ እፅዳ ግሾ፥ ፄላናዉ ዳንዳኤና። ሄሳ ግሾ፥ ዮሰፍ ባ አደ ናይታ እያኮ ሺሽን፥ ያይቆብ ኤንታ እድምድ ዬርስ። <verse eid="GEN 48:10"/><verse number="11" style="v" sid="GEN 48:11"/>እስራኤለይ ዮሰፋ፥ “ታኒ ነ አይፍያ በአና ጋዳ ቆፓብከ፥ ሽን ፆሳይ ሄኮ ነ ናይታካ ታና በስስ” ያግስ። <verse eid="GEN 48:11"/><verse number="12" style="v" sid="GEN 48:12"/>ዮሰፍ ባ ናይታ ያይቆባ ጉልባታፐ ደንድ፥ ባ ሶምኡዋ ሳአ ጋድ ዝግስ።<verse eid="GEN 48:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 48:13"/>ዮሰፍ ባ ናምኡ አደ ናይታ፥ ኤፍሬማ እስራኤለስ ሀድርሳ ባጋራ፥ ምናሰ እስራኤለስ ኡሻቻ ባጋራ ኤስስ። <verse eid="GEN 48:13"/><verse number="14" style="v" sid="GEN 48:14"/>እስራኤለይ ባ ኩሽያ ባርባፅድ ኤፍሬም ካሎ ግድኮካ፥ ባ ኡሻቻ ኩሽያ ሁጰን ዎስ። ምናሰይ ባይራ ግድኮካ፥ እስራኤለይ ባ ሀድርሳ ኩሽያ ምናሰ ሁጰን ዎስ።<verse eid="GEN 48:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 48:15"/>ሄሳፈ ጉየ፥ ያይቆብ ዮሰፋ ሀይሳዳ ያግድ አንጅስ፤</para>
  <para style="q1" vid="GEN 48:15">“ታ አዋት አብራሃመይነ ይሳቅ፥</para>
  <para style="q2" vid="GEN 48:15">እያ ስንን ደእዳ ፆሳይ፥</para>
  <para style="q2" vid="GEN 48:15">ታ ደኦ ኡባን ሀች ጋካናዉ ታና ሄምዳ ፆሳይ ነና አንጆ።<verse eid="GEN 48:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 48:16"/>ኢታባ ኡባፈ ታና አሽዳ፥</para>
  <para style="q2" vid="GEN 48:16">እያ ኪታንቾይ፥ ሀ ናይታ ናጎ።</para>
  <para style="q1" vid="GEN 48:16">ታ ሱንይነ፥</para>
  <para style="q2" vid="GEN 48:16">ታ አዋታ አብራሃመ ይሳቃ ሱንይ ኤንታን ፄገቶ።</para>
  <para style="q1" vid="GEN 48:16">ኤንቲ ሳአ ቦላ ዳሮ”</para>
  <para style="q2" vid="GEN 48:16">ያግድ አንጅስ።<verse eid="GEN 48:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17"/>ዮሰፍ ባ አዋይ ባ ኡሻቻ ኩሽያ ኤፍሬማ ሁጰን ዎዳይሳ በእዳ ዎደ ዶስቤና። ሄሳ ግሾ፥ ኤፍሬማ ሁጵያፐ ደንድ፥ ምናሰ ሁጰን ዎናዉ ባ አዋ ኩሽያ ኦይክስ። <verse eid="GEN 48:17"/><verse number="18" style="v" sid="GEN 48:18"/>ዮሰፍ፥ “ታ አዋዉ፥ ሄሳ ግደና። ባይራይ ሀይሳ ነ ኡሻቻ ኩሽያ እያ ቦላ ዎ” ያግስ።<verse eid="GEN 48:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19"/>ሽን እያ አዋይ እፅድ፥ “ታ ኤራይስ፥ ታ ናአዉ፥ ታ ኤራይስ። ምናሰይካ ግታ ደረ ግዳና፥ ሽን እያ ካሎ እሻይ እያፐ አድ ግታታና። እያ ሼሻይካ ዳሮ ግታ ካዎተ ግዳና” ያግስ።<verse eid="GEN 48:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 48:20"/>እ ሄ ጋላስ ኤንታ አንጅሸ፥</para>
  <para style="q1" vid="GEN 48:20">“እስራኤለት አንጆ አንጅያ ዎደ፥</para>
  <para style="q2" vid="GEN 48:20">‘ፆሳይ ህንተና ኤፍሬማዳነ ምናሰዳ ኦ’</para>
  <para style="q2" vid="GEN 48:20">ያግድ ህንተ ሱንን አንጃና” ያግስ።</para>
  <para style="m" vid="GEN 48:20">ያትድ ኤፍሬማ ምናሰፐ ስንይስ።<verse eid="GEN 48:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21"/>ሄሳፈ ጉየ፥ እስራኤለይ ዮሰፋ፥ “ታኒ ሀይቃናዉ ማታስ፥ ሽን ፆሳይ ህንተራ ደኤስ። እ ህንተ አዋታ ቢታ ህንተና ጉየ ዛራና። <verse eid="GEN 48:21"/><verse number="22" style="v" sid="GEN 48:22"/>ታኒ አሞረታፐ ታ ማሻንነ ታ ዶንገን ኤክዳ ቢታ፥ ነ እሻታራ ነ ሻከታዳ ኤክያ ቢታ ቦላ ነዉ ጉጃዳ እማስ” ያግስ።<verse eid="GEN 48:22"/></para>
  <chapter eid="GEN 48"/>
  <chapter number="49" style="c" sid="GEN 49"/>
  <para style="s1">ያይቆብ ባ ናይታ አንጁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1"/>ሄሳፈ ጉየ፥ ያይቆብ ባ አደ ናይታ ፄግድ፥ “ስንፈ ሀናናባ ታኒ ህንተዉ ኦዳና መላ ሀ ሺቅተ” ያግስ።<verse eid="GEN 49:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2"/>“ህንተኖ ያይቆባ ናይቶ፥</para>
  <para style="q2" vid="GEN 49:2">እስፈ ሺቅድ ስእተ፤</para>
  <para style="q2" vid="GEN 49:2">ህንተ አዋይ እስራኤለይ ኦደይሳ ሀይዝተ።<verse eid="GEN 49:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3"/>“ሮቤላ፥ ታ ባይራ ናአዉ፥</para>
  <para style="q2" vid="GEN 49:3">ኔኒ ታ ዎልቃ፤ ታ ምኖተስ ኮይሩዋ፤</para>
  <para style="q2" vid="GEN 49:3">ኔኒ ቦንቾንካ ዎልቃንካ ኡባፈ አሳ።<verse eid="GEN 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4"/>ኔኒ ሃ መላ፥ ኤቅዳሶን ደአካ፤</para>
  <para style="q2" vid="GEN 49:4">ነ እሻታ ቦላ ባይራተ ነዉ በሰና።</para>
  <para style="q1" vid="GEN 49:4">ኔኒ ነ አዋ ሂፃን ከያዳሳ፤</para>
  <para style="q2" vid="GEN 49:4">ነ አዋ አርሳ ቱንሳዳሳ።<verse eid="GEN 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5"/>“ስሞንነ ሌወይ እሻታ፤</para>
  <para style="q2" vid="GEN 49:5">ኤንቲ ባንታ ማሻ ማካላተስ ደንሶና።<verse eid="GEN 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6"/>ኤንቲ ባንታ ሀንቁዋን አደ ዎዶሶና፥</para>
  <para style="q2" vid="GEN 49:6">ባንታ አሙዋ ኩንናዉ ቦራታ ጋድያ ቃንፅዶሶና።</para>
  <para style="q1" vid="GEN 49:6">ያንያ ግሾ፥ ታኒ ኤንታ ዞረታን ገልከ፤</para>
  <para style="q2" vid="GEN 49:6">ኤንታ ሺቁዋንካ ኡትከ።<verse eid="GEN 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7"/>ኤንታ ዎልቃማ ሀንቆይ</para>
  <para style="q2" vid="GEN 49:7">ኤንታ ዎዛና ኢታተይ ባደትዳባ ግዶ።</para>
  <para style="q1" vid="GEN 49:7">ታኒ፥ ኤንታ ያይቆባ አሳ ግዶን ላላና።</para>
  <para style="q2" vid="GEN 49:7">እስራኤለ ቢታን ርጫና።<verse eid="GEN 49:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8"/>“ይሁዳ፥<note caller="+" style="f"><char style="fr" closed="false">49:8 </char><char style="fq" closed="false">ይሁዳ፦ </char><char style="ft" closed="false">ይሁዳ ጉሳይ እብራወ ዶናን ጋላታ ጉሱ።</char></note> ነ እሻት ነና ጋላታና፤</para>
  <para style="q1" vid="GEN 49:8">ነ ኩሸይ ነ ሞርከታ ቆ ኦይካና፤</para>
  <para style="q2" vid="GEN 49:8">ነ አዋ ናይት ነዉ ሆክድ ዝጋና።<verse eid="GEN 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9"/>ይሁዳ፥ ኔኒ ዎዳላ ጋሞ፤</para>
  <para style="q2" vid="GEN 49:9">ታ ናአዉ፥ ኔኒ ሻንካፈ ዎ ስሚድ፥</para>
  <para style="q2" vid="GEN 49:9">ጮጎትድ ዝንእዳ ጋሞ መላ።</para>
  <para style="q2" vid="GEN 49:9">ነና ቦቻናዉ ዳንዳኤይ ባዋ።<verse eid="GEN 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10"/>መርናዉ ሃረይስ ያና ጋካናዉ</para>
  <para style="q2" vid="GEN 49:10">ካዎተ ፃምአይ፥</para>
  <para style="q2" vid="GEN 49:10">ይሁዳ ኩሸፐ ከየና፤</para>
  <para style="q2" vid="GEN 49:10">ካዎተት እያዉ ኪተታና።<verse eid="GEN 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11"/>እ ባ ሀርያ ዎይነ ቦላ፥</para>
  <para style="q2" vid="GEN 49:11">ባ ሀረ ማራ ዶረትዳ ዎይነ ቦላ ቃቻና፤</para>
  <para style="q2" vid="GEN 49:11">እ ባ ማኡዋ ሱ ዳንያ ዎይነ ኡሻን ሜጫና።<verse eid="GEN 49:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12"/>እያ አይፈይ ዎይነ ኡሻፈ አድ ዱልካና፤</para>
  <para style="q2" vid="GEN 49:12">እያ አቻይ ፃማታፐ አድ ቦፃና።<verse eid="GEN 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13"/>“ዛብሎን አባ ዶናን ዳና፤</para>
  <para style="q2" vid="GEN 49:13">እ አባ ዶናን ማርካበት ኤቅያ በሲ ግዳና፤</para>
  <para style="q2" vid="GEN 49:13">እያ ዛዋይ ስዶና ጋካና።<verse eid="GEN 49:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14"/>“ይሳኮር ምኖ ሀረ መላ፥</para>
  <para style="q2" vid="GEN 49:14">ጫናታ ግዶን ዝንኤስ።<verse eid="GEN 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15"/>ሽን እ ባ ሸምፕያ በሳይ ሎኦ ግደይሳነ</para>
  <para style="q2" vid="GEN 49:15">ባ ቢታይ ኡፋይሰይሳ ግደይሳ በእያ ዎደ፥</para>
  <para style="q2" vid="GEN 49:15">ጫና ቶካናዉ ባ ሀሽያ ዝቅ ኦድ፥</para>
  <para style="q2" vid="GEN 49:15">አይለተ ኦሶ ኦና።<verse eid="GEN 49:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16"/>“ዳነይ<note caller="+" style="f"><char style="fr" closed="false">49:16 </char><char style="fq" closed="false">ዳነ፦ </char><char style="ft" closed="false">ዳነ ጉሳይ እብራወ ዶናን ፕርዳ ጉሱ።</char></note> እስራኤለ ዘረፈ እሱዋ ግድያ ባ አሳ ቦላ ፕርዳና።<verse eid="GEN 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17"/>ዳነይ ኦገ ጋፃን ደእያ ሾሻ መላ፥</para>
  <para style="q1" vid="GEN 49:17">ፓራ ሹቁልያ ዱክድ፥</para>
  <para style="q2" vid="GEN 49:17">ፓራ ቶግዳይሳ ጉየ የግያ ጎፐ መላ።<verse eid="GEN 49:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18"/>“አቤት ጎዳዉ፥ ታኒ ነ አሹዋ ናጋይስ።<verse eid="GEN 49:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19"/>“ጋደ፥ ቦንቀይሳት ቆሀና፤</para>
  <para style="q2" vid="GEN 49:19">ሽን እ ኤንታ ጌዶ ካልድ ኦይካና።<verse eid="GEN 49:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20"/>“አሴራ ቢታይ ኦርደ፤</para>
  <para style="q2" vid="GEN 49:20">እ ካዎታስ ሎኦ ካ እማና።<verse eid="GEN 49:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21"/>“ንፍታለመይ ቃሸቶና የዳ ደእያ፥</para>
  <para style="q2" vid="GEN 49:21">ሎኦ ማራታ የልያ ገንኤ መላ።<verse eid="GEN 49:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22"/>“ዮሰፍ ሃ ማታን ቶከትድ፥</para>
  <para style="q2" vid="GEN 49:22">ደረ ቦላ ዛእዳ፥ አይፈይ ኩምዳ ዎይነ መላ።<verse eid="GEN 49:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23"/>ዶንገን ዱከይሳት እያ ቦላ ደንዳና፤</para>
  <para style="q2" vid="GEN 49:23">ባንታ ዶንግያን ዱክሸ እያ ጎዳና።<verse eid="GEN 49:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24"/>ሽን ያይቆባ ፆሳ ዎልቃን፥</para>
  <para style="q2" vid="GEN 49:24">እስራኤለ ሄንንቹዋ ናጉዋን፥</para>
  <para style="q2" vid="GEN 49:24">እያ ዶንገይ ምኖ፥ እያ ቀሰይ ፃላ ግዳና።<verse eid="GEN 49:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25"/>ነ አዋ ፆሳይ ነና ማዳና።</para>
  <para style="q1" vid="GEN 49:25">ኡባ ዳንዳእያ ፆሳይ፥</para>
  <para style="q1" vid="GEN 49:25">ቦላ ሳሎ አንጁዋን፥</para>
  <para style="q1" vid="GEN 49:25">ጋርሳ ጪሙዋ አንጁዋን፥</para>
  <para style="q2" vid="GEN 49:25">መሄንካ የሎንካ ነና አንጃና።<verse eid="GEN 49:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26"/>ነ አዋ አንጆይ በንፐ ምንድ ደእያ ዙማታ አንጁዋፈካ፥</para>
  <para style="q2" vid="GEN 49:26">መርናዉ ደእያ ደረታፐ በንትያ ኡፋይስያ አንጁዋፈካ አስ።</para>
  <para style="q1" vid="GEN 49:26">ሀይስ ኡባይ ዮሰፋ ሁጰን፥</para>
  <para style="q2" vid="GEN 49:26">ባ እሻታ ግዶን ካፖ ግደይሳ ሊጰን ሸምፖ።<verse eid="GEN 49:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27"/>“ብንያመይ ቦንቅያ ሱመ፤</para>
  <para style="q2" vid="GEN 49:27">ባ ኦልዳባ ዎንታ ሜስ፤</para>
  <para style="q2" vid="GEN 49:27">ባ ድእዳባ ኦማርስ ሻኬስ” ያግስ።<verse eid="GEN 49:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28"/>ሀይሳቲ ታማነ ናምኡ እስራኤለ ሼሻታ። ኤንታ አዋይ ኤንታ ሁጰን ሁጰን ኤንታዉ በሲያ አንጁዋ አንጅሸ ኤንታኮ ግዳባይ ሀይሳ።<verse eid="GEN 49:28"/></para>
  <para style="s1">ያይቆባ ሀይቁዋ</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29"/>ሄሳፈ ጉየ፥ እ ኤንታ ሀይሳዳ ያግድ ኪትስ፤ “ታኒ ታ ማይዛታን ጋሄታና ሀናይስ። ታና ህተ አድያ ኤፍሮና ጋደን ደእያ ጎንጎሉዋን ታ አዋታ ማታን ሞግተ። <verse eid="GEN 49:29"/><verse number="30" style="v" sid="GEN 49:30"/>ሄስካ፥ ካናነ ቢታን፥ ማምረ ማታን ደእያ፥ ማክፌላን ደእያ ጎንጎሉዋ። ሄ ጎንጎሎይ አብራሃመይ ሞጎስ ህተ አድያ ኤፍሮናፐ እያ ጋድያራ ሻምዳ ዱፉዋ። <verse eid="GEN 49:30"/><verse number="31" style="v" sid="GEN 49:31"/>አብራሃመይነ እያ ማችያ ሳራ፥ ይሳቅነ እያ ማችያ እርብቃ ያን ሞገትዶሶና። ታኒ ቃስ ልያካ ያን ሞጋስ። <verse eid="GEN 49:31"/><verse number="32" style="v" sid="GEN 49:32"/>ሄ ጋደይነ እያን ደእያ ጎንጎሎይ ህተታፐ ሻመትዳይሳ። ታና ያን ሞግተ” ያግስ።<verse eid="GEN 49:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33"/>ያይቆብ፥ ባ ናይታ ኪታ ኦንግዳፐ ጉየ ባ ቶሁዋ ባ ሂፃን ሺሽ ኤክድ፥ ባ ማይዛታን ጋሄትስ።<verse eid="GEN 49:33"/></para>
  <chapter eid="GEN 49"/>
  <chapter number="50" style="c" sid="GEN 50"/>
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1"/>ዮሰፍ ባ አዋ አሀ ቦላ ኩንድድ፥ ዬርሸ እያዉ ዬክስ። <verse eid="GEN 50:1"/><verse number="2" style="v" sid="GEN 50:2"/>ሄሳፈ ጉየ፥ ዮሰፍ ለ ሺሽያ ባ ኦሳንቾታ፥ ባ አዋ እስራኤለ አሀ ሽቶ ትይድ መልሳና መላ ኪትስ። ኤንቲ ትይድ መልስዶሶና። <verse eid="GEN 50:2"/><verse number="3" style="v" sid="GEN 50:3"/>ሽቶ ትሻ ዎጋይ ኦይታሙ ጋላስ ኩመ ኤኬስ። ግብፀ አሳት እያዉ ላፑን ታሙ ጋላስ ዬክዶሶና።<verse eid="GEN 50:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4"/>ዬሆ ጋላሳት አዳ ዎደ፥ ዮሰፍ ግብፀ ካዋ ኦሳንቾታ፥ “ታኒ ህንተ ስንን ሳባ ደምዳባ ግድኮ፥ ታዉ ካዋስ ሀይሳዳ ያግድ ኦድተ። <verse eid="GEN 50:4"/><verse number="5" style="v" sid="GEN 50:5"/>‘ታ አዋይ ታና እስ ጫቆ ጫቅስስ። ታኒ ሀይቃናዉ ማታስ። ታኒ ታ ሁጰን ካናነ ቢታን ቦክዳ ጎንጎሎ ዱፉዋን ታና ሞጋ’ ያግስ። ሄሳ ግሾ፥ ‘ሀእ ታኒ ያ ባዳ ታ አዋ ሞጋዳ ስማና መላ ታና የዳርክ’ ያግተ” ያግስ።<verse eid="GEN 50:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6"/>ያትን ካዎይ፥ “እ ነና ጫቅስዳይሳዳ ባዳ ነ አዋ ሞጋ” ያግስ።<verse eid="GEN 50:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7"/>ያትን ዮሰፍ ባ አዋ ሞጋናዉ ብስ። ካዋ ሞርናት ኡባይ፥ ካዋ ኬንነ ግብፀን ደእያ ግታ አሳት ኡባይ ዮሰፋ ካልድ ብዶሶና። <verse eid="GEN 50:7"/><verse number="8" style="v" sid="GEN 50:8"/>ዮሰፋ ሶ አሳ ኡባይ፥ እያ እሻትነ እያ አዋ ሶ አሳት ዮሰፋራ ብዶሶና። ኤንታ ዮጋ ናይት፥ ኤንታ ዶርሳት፥ ኤንታ ዴሻትነ ኤንታ ሚዛ ዉድያ ፃላል ጌሳመን አትስ። <verse eid="GEN 50:8"/><verse number="9" style="v" sid="GEN 50:9"/>ፓራ ጋረትነ ቶጋት እያራ ብዶሶና። እያ ካልድ ብዳ አሳይ ዳሮ።<verse eid="GEN 50:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10"/>ኤንቲ ዮርዳኖሰ ሻፋ ማታን ደእያ አፃደ ጌተትያ ዉዱማ ጋክድ፥ ባንታ ቃላ ቁ ኦድ፥ ዘሌልድ ዬክዶሶና። ያን ዮሰፍ ባ አዋ ዬሁዋን ላፑን ጋላስ ኡትስ። <verse eid="GEN 50:10"/><verse number="11" style="v" sid="GEN 50:11"/>ሄ ቢታን ደእያ ካናነ አሳት አፃደ ዉዱማን ሄ ዬሁዋ በእዳ ዎደ፥ “ግብፀት አይብ ይባታ ዬሆ ዬኮና?” ያግዶሶና። ሄሳ ግሾ፥ ዮርዳኖሰ ማታን ደእያ ሄ በሳይ አቤል-ምፅራማ (ግብፀታ ዬሆ) ጌተትስ።<verse eid="GEN 50:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12"/>ያይቆባ ናይት ኤንታ አዋይ ኤንታ ኪትዳይሳዳ ኦዶሶና። <verse eid="GEN 50:12"/><verse number="13" style="v" sid="GEN 50:13"/>ኤንቲ እያ አሀ ካናነ ቢታ ኤፍድ፥ ማምረፐ ኡሻቻ ባጋን ደእያ ማክፌላ ጎንጎሉዋን ሞግዶሶና። ሄስካ፥ አብራሃመይ ህተ አድያ ኤፍሮናፐ ሞጎስ ሻምዳ ጋድያ። <verse eid="GEN 50:13"/><verse number="14" style="v" sid="GEN 50:14"/>ዮሰፍ ባ አዋ ሞግዳፐ ጉየ፥ ባ እሻታራነ እያ አዋ ሞጋናዉ እያራ ብዳ ሀራ አሳታ ኡባታራ ግብፀ ስምስ።<verse eid="GEN 50:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15"/>ባንታ አዋይ ሀይቅዳፐ ጉየ፥ ዮሰፋ እሻት ባንታ ግዶን፥ “ኑኒ እያዉ ኦዳ ኢታባ ኡባስ ዮሰፍ ኑና ባ ኡሎን ሞርክድ ሀሎ ከያናዉ ኮይኮ ኑኒ ዋናኔ?” ያግዶሶና። <verse eid="GEN 50:15"/><verse number="16" style="v" sid="GEN 50:16"/>ሄሳ ግሾ፥ ዮሰፋኮ ያግድ ኪታ ኪትዶሶና፤ “ነ አዋይ ሀይቃናፐ ስን ኑኮ፥ <verse eid="GEN 50:16"/><verse number="17" style="v" sid="GEN 50:17"/>‘ኔኒ፥ ነ እሻታ ናጋራነ ኤንታ ኢታ ናቁዋ ሀያና አቶ ያጋ ያግስ ግድ ኦድተ’ ያግስ። ሄሳ ግሾ፥ ሀእ ሀያና፥ ኑ ናጋራ፥ ነ አዋ ፆሳ አይለታ ናቁዋ አቶ ያጋ” ያግዶሶና። ዮሰፍ ሄሳ ስእድ ዬክስ።<verse eid="GEN 50:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18"/>ሄሳፈ ጉየ፥ እያ እሻት ባንታ ሁጰን እያኮ ይድ፥ እያ ስንን ጉፋንድ፥ “ኑኒ፥ ነ አይለታ” ያግዶሶና።<verse eid="GEN 50:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19"/>ሽን ዮሰፍ ኤንታኮ፥ “ባቦፍተ፥ ታና ህንተዉ ፆሳ ግደትዬ? <verse eid="GEN 50:19"/><verse number="20" style="v" sid="GEN 50:20"/>ህንተ ታዉ ኢታ ኦደታ፥ ሽን ሀእ ዳሮ አሳይ ሀይቆና አታና መላ ፆሳይ ሀይሳ ሎኦተስ ኦስ። <verse eid="GEN 50:20"/><verse number="21" style="v" sid="GEN 50:21"/>ሄሳ ግሾ፥ ህዛ ባቦፍተ። ታኒ ህንተናነ ህንተ ናይታ ሙዛና” ያግድ፥ ኤንታ ምንድ ሎኦ ቃላ ሀሳይስ።<verse eid="GEN 50:21"/></para>
  <para style="s1">ዮሰፋ ሀይቁዋ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22"/>ዮሰፍ፥ እያዉ ላይ ፄታነ ታማ ግዳና ጋካናስ ባ አዋ ሶ አሳራ ግብፀን ደእስ። <verse eid="GEN 50:22"/><verse number="23" style="v" sid="GEN 50:23"/>ኤፍሬማ ናይታነ፥ ኤንታ ናይታ ናይታ በእስ። ቃስ ምናሰ ናኣ ማክራ ናይታ፥ ባ ናይታ ኦስ።<verse eid="GEN 50:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 50:24"/>ሄሳፈ ጉየ፥ ዮሰፍ ባ እሻታ፥ “ታኒ ሀይቃናዉ ማታስ፥ ሽን ፆሳይ ህንተና ማዳናዉ ፆሞሳና። እ ህንተና ሀ ቢታፈ ከስድ፥ አብራሃመስ፥ ይሳቃስነ ያይቆባስ እማና ግድ ጫቅዳ ቢታ ኤፋና” ያግስ። <verse eid="GEN 50:24"/><verse number="25" style="v" sid="GEN 50:25"/>ዮሰፍ እስራኤለ ናይታ፥ “ፆሳይ ህንተና ማዳናዉ ፆሞስያ ዎደ፥ ህንተ ታ መቀ ሀ ቢታፈ ኤክድ ቢተ” ያግድ ጫቅስስ።<verse eid="GEN 50:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 50:26"/>ዮሰፍ ፄታነ ታሙ ላይ ደእድ ሀይቅን፥ ሽቱዋን እያ አሀ ትይድ መልስዳፐ ጉየ፥ ግብፀ ቢታን ሳፅነን ዎዶሶና።<verse eid="GEN 50:26"/></para>
  <chapter eid="GEN 50"/>
</usx>
